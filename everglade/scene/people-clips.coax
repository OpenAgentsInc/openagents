// Body 0 is the male skeleton, 1 the female; they share the clips' rotations.
people_rig :: (d: [] People, female: bool) -> SkinRig {
  if female {
    return SkinRig.{joints = PEOPLE_JOINTS, clips = PEOPLE_CLIPS, parent = d[0].parent[..], rest = d[0].rest_f[..], bind = d[0].bind_f[..],
                    duration = d[0].duration[..], distance = d[0].distance[..], track_t = d[0].track_t[..],
                    track_r = d[0].track_r[..], keys_t = d[0].keys_t_f[..], keys_r = d[0].keys_r[..]};
  }
  return SkinRig.{joints = PEOPLE_JOINTS, clips = PEOPLE_CLIPS, parent = d[0].parent[..], rest = d[0].rest_m[..], bind = d[0].bind_m[..],
                  duration = d[0].duration[..], distance = d[0].distance[..], track_t = d[0].track_t[..],
                  track_r = d[0].track_r[..], keys_t = d[0].keys_t_m[..], keys_r = d[0].keys_r[..]};
}
