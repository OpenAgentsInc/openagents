// Everglade II's admin mode, the room's side (everglade/client/admin.coax): X lines from
// a seat, taken only by a room on this machine. rm_admin_local turns them on, and only for a room
// started with --dev (the API's local stand-in) and listening on 127.0.0.1 (room-host.c; Cloud Run's
// PORT binds 0.0.0.0, and production has no --dev). Every other room drops every X line unread, so
// a crafted one to production does nothing. The one exception is a moderator's command (#13302,
// coax/web/room/room-mod.coax): "X " and a moderation record, taken by any room from a seat whose
// signed ticket has the moderator bit, and logged.
//   X heal            your Hit Points full, up from 0 too
//   X god 0|1         nothing takes your Hit Points (they are put back full each tick)
//   X ko 0|1          KNOCK OUT: the guard you drop stays at 1 HP, Unconscious (SRD p.17)
//   X at XMM ZMM YAW  your seat placed at (x, z) metres x 1000, facing YAW milliradians (room-tick.c)
//   X guard kill|reset|off|on   the path guard falls; a new one now; none until on (everglade/server/guard.coax)
//   X class KIND      the seat sits again as srd-CLASS or srd-CLASS-L (the CLASSES and LEVEL menus)
//   coax test --library coax/web/room/room.coax --steps 4000000000 --only "e2 admin"

RmE2Admin :: struct {
  local: bool;                                  // rm_admin_local: --dev on 127.0.0.1
  heard: int; dropped: int;                     // X lines taken, and dropped by a room that isn't local
  // each room's seats by bit (small: checks copy the whole server): god mode, KNOCK OUT, a teleport due
  god: [EG_ROOMS] int; ko: [EG_ROOMS] int; warp: [EG_ROOMS] int;
  warp_x: [EG_ROOMS] f32; warp_z: [EG_ROOMS] f32; warp_yaw: [EG_ROOMS] f32;   // the room's last teleport asked (one admin at a time)
  guard_off: [EG_ROOMS] bool;
}

// The host says how it was started; true when admin lines are taken.
rm_admin_local :: (v: [] RmServer, address: string) -> bool #export_c #effects(all) {
  v[0].adm.local = e2_admin_allowed(v[0].dev.on, address);
  return v[0].adm.local;
}
e2_admin_allowed :: (dev: bool, address: string) -> bool { return dev && address == "127.0.0.1"; }

// A seat's X line (room-everglade.coax eg_heard), read with everglade-wire.coax wire_read_admin.
e2_admin_heard :: (v: [] RmServer, k: int, seat_id: SeatId, text: string) {
  s := seat_id.value;
  // a moderator's command (#13302): any room takes it, from a seat whose signed ticket has the moderator bit (coax/web/room/room-mod.coax)
  if rm_mod_line(text) { rm_mod_heard(v, k, seat_id, text); return; }
  if !v[0].adm.local || s < 0 || s >= EG_SEATS { v[0].adm.dropped += 1; return; }
  v[0].adm.heard += 1;
  bit := 1 << s;
  rd: [1] WireRd; rd[0] = wire_rd(text, 1);
  line := wire_read_admin(text, rd[..]);
  if !rd[0].ok { return; }
  verb := line.verb; arg := line.arg;
  b := v[0].eg[k].rules[0].b[..]; c := b[0].c[EGB_SEAT + s..<EGB_SEAT + s + 1];
  if verb == WIRE_X_HEAL { c[0].hp = c[0].hp_max; c[0].dead = false; c[0].stable = false; c[0].death_ok = 0; c[0].death_fail = 0; if (c[0].cond & RS_UNCONSCIOUS) != 0 { c[0].cond -= RS_UNCONSCIOUS; } return; }
  if verb == WIRE_X_GOD { v[0].adm.god[k] = ifx arg == "1" then v[0].adm.god[k] | bit else v[0].adm.god[k] & (65535 - bit); return; }
  if verb == WIRE_X_KO { v[0].adm.ko[k] = ifx arg == "1" then v[0].adm.ko[k] | bit else v[0].adm.ko[k] & (65535 - bit); return; }
  if verb == WIRE_X_AT {
    x := line.x; z := line.z; yaw := line.yaw;
    if x < -400000 || x > 400000 || z < -600000 || z > 100000 || yaw < -7000 || yaw > 7000 { return; }
    v[0].adm.warp[k] = bit; v[0].adm.warp_x[k] = f32(x) / 1000; v[0].adm.warp_z[k] = f32(z) / 1000; v[0].adm.warp_yaw[k] = f32(yaw) / 1000;
    return;
  }
  // the CLASSES and LEVEL menus: the seat sits again as that SRD class and level (srd-CLASS or
  // srd-CLASS-L, as a hello says it), even when its ticket's checkpoint holds its later hellos
  if verb == WIRE_X_CLASS { if egb_klass_of(arg) >= EGB_CL0 { eg_seat_kind(v, k, seat_id, arg); } return; }
  if verb == WIRE_X_GUARD {
    g := v[0].eg[k].guard[..]; r := v[0].eg[k].rules[..];
    if arg == "kill" { if g[0].q >= 0 && r[0].beasts[g[0].q].id == g[0].id { b[0].c[EGB_BEAST0 + g[0].q].hp = 0; } return; }
    if arg == "reset" || arg == "off" {
      if g[0].q >= 0 && r[0].beasts[g[0].q].id == g[0].id { egb_beast_gone(r, g[0].q); }
      g[0].q = -1; g[0].state = E2G_NONE; g[0].foe = -1; g[0].hp = 0; g[0].down_at = -1;
      v[0].adm.guard_off[k] = arg == "off";
      return;
    }
    if arg == "on" { v[0].adm.guard_off[k] = false; g[0].down_at = -1; return; }
  }
}
// Before the guard's tick: a guard switched off doesn't come back.
e2_admin_before :: (v: [] RmServer, k: int) {
  if !v[0].adm.local || !v[0].adm.guard_off[k] { return; }
  g := v[0].eg[k].guard[..]; if g[0].q < 0 { g[0].down_at = v[0].eg[k].tick; }
}
// After the rules' step, before the guard's fall is told: god mode's Hit Points, KNOCK OUT's guard.
e2_admin_after :: (v: [] RmServer, k: int) {
  if !v[0].adm.local { return; }
  b := v[0].eg[k].rules[0].b[..];
  for s: 0..<EG_SEATS {
    if (v[0].adm.god[k] & (1 << s)) == 0 || !v[0].eg[k].seat[s].live { continue; }
    c := b[0].c[EGB_SEAT + s..<EGB_SEAT + s + 1];
    c[0].hp = c[0].hp_max; c[0].dead = false; if (c[0].cond & RS_UNCONSCIOUS) != 0 { c[0].cond -= RS_UNCONSCIOUS; }
  }
  g := v[0].eg[k].guard[0];
  if g.q >= 0 && g.foe >= 0 && g.foe < EG_SEATS && (v[0].adm.ko[k] & (1 << g.foe)) != 0 {
    c := b[0].c[EGB_BEAST0 + g.q..<EGB_BEAST0 + g.q + 1];
    if c[0].hp <= 0 { c[0].hp = 1; c[0].dead = false; c[0].cond = c[0].cond | RS_UNCONSCIOUS; }
  }
}
// The host's tick (room-tick.c everglade2_room_tick): a teleport asked for seat s, taken once, into out (x, z, yaw).
rm_e2_admin_warp :: (v: [] RmServer, k: int, s_id: SeatId, out: [] f32) -> bool #export_c #effects(all) {
  s := s_id.value;
  if rm_mod_warp(v, k, s, out) { return true; }   // a moderator's move, in any room (coax/web/room/room-mod.coax, #13302)
  if !v[0].adm.local || k < 0 || k >= EG_ROOMS || s < 0 || s >= EG_SEATS || out.count < 3 { return false; }
  if v[0].adm.warp[k] != (1 << s) { return false; }
  v[0].adm.warp[k] = 0;
  out[0] = v[0].adm.warp_x[k]; out[1] = v[0].adm.warp_z[k]; out[2] = v[0].adm.warp_yaw[k];
  return true;
}

#test "e2 admin: only a --dev room on 127.0.0.1 takes admin lines" {
  #assert e2_admin_allowed(true, "127.0.0.1");
  for address: [5] string.["0.0.0.0", "localhost", "::", "10.0.0.2", ""] { #assert !e2_admin_allowed(true, address); }
  #assert !e2_admin_allowed(false, "127.0.0.1") && !e2_admin_allowed(false, "0.0.0.0");
}
#test "e2 admin: production's room refuses every admin line; a local room takes them" #steps 4000000000 #traversal 1073741824 {
  for local: 0..<2 {
    v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
    if local == 1 { v[0].dev.on = true; }
    #assert rm_admin_local(v[..], ifx local == 1 then "127.0.0.1" else "0.0.0.0") == (local == 1);
    #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-admin HTTP/1.1\r\n\r\n") == 0;
    k := eg_room_at(v[..], v[0].conns[0].relay);
    rm_heard(v[..], 0, "H 5 ranger.0.0.0 srd-fighter 0 -");
    eg_test_tick(v[..], k);
    #assert v[0].eg[k].guard[0].q >= 0;
    c := v[0].eg[k].rules[0].b[0].c[EGB_SEAT..<EGB_SEAT + 1]; c[0].hp = 1;
    for line: [6] string.["X heal", "X god 1", "X ko 1", "X at 5000 -40000 0", "X guard off", "X class srd-ranger-3"] { rm_heard(v[..], 0, line); }
    out: [3] f32;
    if local == 0 {
      #assert c[0].hp == 1 && v[0].adm.god[k] == 0 && v[0].adm.ko[k] == 0 && !v[0].adm.guard_off[k];
      #assert !rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, out[..]) && v[0].eg[k].guard[0].q >= 0 && v[0].adm.heard == 0 && v[0].adm.dropped == 6;
      #assert v[0].eg[k].rules[0].klass[0] == EGB_CL0 + FB_CL_FIGHTER;
    } else {
      #assert c[0].hp == c[0].hp_max && v[0].adm.god[k] == 1 && v[0].adm.ko[k] == 1 && v[0].adm.guard_off[k] && v[0].adm.heard == 6;
      #assert v[0].eg[k].rules[0].klass[0] == EGB_CL0 + FB_CL_RANGER && v[0].eg[k].rules[0].b[0].c[EGB_SEAT].level == 3;   // the CLASSES menu
      #assert rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, out[..]) && out[0] == 5 && out[1] == -40 && !rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, out[..]);
      #assert v[0].eg[k].guard[0].q < 0;
      for t: 0..<3 { eg_test_tick(v[..], k); }
      #assert v[0].eg[k].guard[0].q < 0;   // off: no new guard
      rm_heard(v[..], 0, "X guard on"); eg_test_tick(v[..], k); #assert v[0].eg[k].guard[0].q >= 0;
      c[0].hp = 1; eg_test_tick(v[..], k); #assert c[0].hp == c[0].hp_max;   // god
    }
  }
}
