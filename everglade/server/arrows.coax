// Everglade II's arrows, the room's (#13157): a Ranger's Attack looses a real arrow, and the room
// flies it. The flight is the engine's (metaverse-engine/action/archery.coax, bow.coax), the Longbow the game's
// (everglade/longbow.coax) and this zone's ground and bodies everglade/shared/archery.coax's, which the page
// predicts with too (everglade/client/arrows.coax). What crosses the socket and how far
// back the room rewinds are metaverse-engine/net/projectile.coax and rewind.coax, any realm's.
//
// A page that looses says the launch (F SEQ ...) just before the Attack's own request (C, the same SEQ).
// The room keeps the launch for that request. When the request passes the checks every cast passes
// (eg_e2_cast: the slot, the cooldown, the reach) and the archer can act, the room looses the arrow:
// from the page's hand when that is within E2AR_HAND_SLACK of where the room has the archer, else from
// the hand the room reckons; at the page's aim and draw; and from the moment the page was drawing
// (VIEW), no more than NET_REWIND_AGE_MS back. The ticks it missed are flown at once, each against the
// monsters where they stood at that tick (NetPast), so what the archer's page showed is what the room
// judges. Then it flies a tick at a time with the world. Every page in view hears it by id (a), the
// archer's with its request's number, and hears its end (d): stuck in the ground, or in a body. The
// arrow that reaches a monster or the guard is the SRD Attack with the Longbow on it (everglade2-
// rules.coax), rolled then: a hit ends in it and the harm is told as any cast's, a miss flies on.
// An Attack with no launch before it (a page from before arrows) is the cast it was: at its aim, at once.
//   coax/bin/coax test --library coax/web/room/room.coax --only "e2 arrows"

E2A_LEAD :: 64;             // ticks before the first arrow's tick the arrows' clock starts, so a rewound launch is after 0
// One arrow's room: its id (0 none), its archer's seat and the Attack's slot on the wire.
// On the Archery Range (#13507): where it left, how its archer shot it (range/score.coax RG_FOOT, RG_HORSE,
// RG_DRAGON) and whether its archer stood on the range's ground, so a miss there is counted too.
E2ArrowTag :: struct { id: int; seat: int = -1; slot: int; from: [3] f32; mode: int; range: bool; }
E2Arrows :: struct {
  ar: [1] arch.Archer;                    // its arrows: each one's owner is its archer's seat
  tag: [bow.ARROWS] E2ArrowTag;
  past: [1] NetPast;                      // where the monsters and the guard stood, tick by tick
  epoch: int;                             // the tick the arrows' clock counts from (set when the first of a flight is loosed; below 0 in a young room)
  next: int;                              // the last id given
  loosed: int; hits: int; misses: int; stuck: int; gone: int; rewound_ms: int;   // what the checks read
  marks: int;                             // arrows stuck in the Archery Range's faces (#13507)
  cast_back: int; casts_back: int;        // ticks back the last cast was judged, and casts judged back at all (#13289)
  near: [1] E2ArNear;                     // the trunks and rocks round where an arrow last asked (#13166)
}
// The planting every Everglade II room steps its seats among (room-world.c's, handed over by
// rm_e2_land): an arrow flies among the same trunks and rocks. A room without one (the checks) has the
// glade's own trees and rocks and the camp's props.
e2a_land :: (v: [] RmServer) -> E2ArLand {
  g := v[0].e2land;
  if g.count == 0 || !g[0].done { return E2ArLand.{}; }
  land := e2ar_land(g[0].items[..], g[0].kinds[..], g[0].first[..], true);
  land.still = g[0].still[..];   // the land's standing things, kept (everglade/shared/move.coax E2Still, #13384)
  return land;
}
// room-world.c's planting (world2_prepare), which the seats' steps walk among: the arrows' too.
rm_e2_land :: (v: [] RmServer, g: [] E2MoveGround) #export_c #effects(all) { v[0].e2land = g; }
e2a_room :: (v: [] RmServer, k: int) -> [] E2Arrows { return v[0].eg[k].arrows[..]; }
// The arrows' clock at a tick (s): small numbers, so an f32 holds a 30th of a second exactly enough.
e2a_clock :: (a: [] E2Arrows, tick: int) -> f32 { return f32(tick - a[0].epoch) / f32(EG_HZ); }
e2a_flying :: (a: [] E2Arrows) -> int { n := 0; for i: 0..<bow.ARROWS { if a[0].ar[0].arrows[0].a[i].state == bow.ARROW_FLYING { n += 1; } } return n; }

// F: a page's launch, kept for the Attack's request of the same number.
e2_arrow_heard :: (v: [] RmServer, k: int, seat_id: SeatId, text: string) { seat := seat_id.value;
  l := net_loose_read(text);
  if !l.ok { return; }
  v[0].eg[k].seat[seat].loose = l;
}
// This tick's bodies written down: every monster that stands, the guard, and every placed player
// (#13289: every body that can be hit is in the past, so a cast is judged where its page drew them).
E2A_SEAT0 :: E2AR_BODIES;   // seat s's body in the past: after the creatures'
E2A_FAM0 :: E2A_SEAT0 + EG_ZONE_SEATS;   // and seat s's familiar (a Wizard's, a Druid's Wild Companion) after the seats'
// Owner seat s's familiar as the rules have it: its creature when it is out (as its row is written, familiar.coax e2_familiars_rows), else -1.
e2a_familiar :: (v: [] RmServer, k: int, s: int) -> int {
  r := v[0].eg[k].rules[..];
  if !r[0].familiar_ready || s < 0 || s >= eg_cap(v, k) || !v[0].eg[k].seat[s].live || !v[0].eg[k].seat[s].placed { return -1; }
  f := r[0].familiar[s].me; c := r[0].b[0].c[f];
  return ifx c.dead || c.hp <= 0 || e2_familiar_form(c.familiar_form) < 0 then -1 else f;
}
e2a_remember :: (v: [] RmServer, k: int) {
  a := e2a_room(v, k); t := v[0].eg[k].tick; ms := e2mo_room(v, k);
  net_past_begin(a[0].past[..], t);
  for m: 0..<E2M_N { if e2mo_up(v, k, m) { net_past_put(a[0].past[..], m, ms[0].mon[m].x, ms[0].mon[m].z); } }
  if e2mo_up(v, k, E2M_PATROL) { net_past_put(a[0].past[..], E2AR_GUARD, ms[0].mon[E2M_PATROL].x, ms[0].mon[E2M_PATROL].z); }
  for s: 0..<eg_cap(v, k) {
    if v[0].eg[k].seat[s].live && v[0].eg[k].seat[s].placed { net_past_put(a[0].past[..], E2A_SEAT0 + s, v[0].eg[k].seat[s].pose.x, v[0].eg[k].seat[s].pose.z); }
    f := e2a_familiar(v, k, s);
    if f >= 0 { r := v[0].eg[k].rules[..]; net_past_put(a[0].past[..], E2A_FAM0 + s, egb_cell_m(r[0].b[0].c[f].x), egb_cell_z(r, r[0].b[0].c[f].y)); }
  }
}
// Where body b stood at tick `at` when the past holds it standing then, else where it is now (x, z).
e2a_stood :: (v: [] RmServer, k: int, b: int, at: int, x: f32, z: f32) -> [2] f32 {
  if at >= v[0].eg[k].tick { return [2] f32.[x, z]; }
  p := net_past_at(e2a_room(v, k)[0].past[..], b, at, 0);
  return ifx p.up then [2] f32.[p.x, p.z] else [2] f32.[x, z];
}
// The bodies as they stood at `tick` (from the past; a tick it doesn't hold: none).
e2a_bodies :: (v: [] RmServer, k: int, tick: int, out: [] arch.ArcheryBody) -> int {
  a := e2a_room(v, k); n := 0;
  for b: 0..<E2AR_BODIES {
    at := net_past_at(a[0].past[..], b, tick, 0);
    if !at.up || n >= out.count { continue; }
    out[n] = ifx b == E2AR_GUARD then e2ar_guard(at.x, at.z) else e2ar_monster(b, e2mo_room(v, k)[0].mon[b].kind, at.x, at.z);
    n += 1;
  }
  return n;
}
// The rules' creature for body b now (-1: it no longer stands).
e2a_creature :: (v: [] RmServer, k: int, b: int) -> int {
  if b == E2AR_GUARD { return e2_guard_creature(v, k); }
  if b < 0 || b >= E2M_N || !e2mo_up(v, k, b) { return -1; }
  return egb0(v, k) + e2mo_room(v, k)[0].mon[b].q;
}
e2a_say_end :: (v: [] RmServer, k: int, id: int, kind: int, at: [3] f32, dir: [3] f32, body: int) {
  out: [160] u8;
  n := net_shot_end_write(NetShotEnd.{tick = v[0].eg[k].tick, id = id, kind = kind, at = at, dir = dir, body = body}, out[..]);
  if n > 0 { e2ar_say(v, k, cast(string) out[0..<n], at[0], at[2]); }
}
// The Attack's request with a launch kept for it: loosed. False when no launch is kept for `seq` (the
// cast goes on as it was) ; the checks every cast passes are the caller's (eg_e2_cast).
e2_arrow_loose :: (v: [] RmServer, k: int, seat_id: SeatId, slot: int, seq: int) -> bool { seat := seat_id.value;
  st := v[0].eg[k].seat[seat..<seat + 1]; a := e2a_room(v, k); t := v[0].eg[k].tick;
  l := st[0].loose;
  if !l.ok || l.seq != seq { return false; }
  st[0].loose = NetLoose.{};
  if e2a_flying(a) == 0 { a[0].epoch = t - E2A_LEAD; for i: 0..<bow.ARROWS { a[0].ar[0].arrows[0].a[i] = bow.Arrow.{}; a[0].tag[i] = E2ArrowTag.{}; } }
  if a[0].ar[0].targets[0].n == 0 { e2ar_range_targets(a[0].ar[..]); }   // the Archery Range's faces (#13507)
  me := st[0].pose;
  // from a saddle (riding.coax): the hand is the saddle's height higher and may be the mount's length from its middle
  ride := e2rd_lift(v, k, seat);
  hand := e2ar_hand(me.x, me.z, l.to); if ride.on { hand[1] += ride.up; }
  from := ifx (ifx ride.on then e2ar_launch_ok_from(l.from, me.x, me.z, ride.up, ride.reach) else e2ar_launch_ok(l.from, me.x, me.z)) then l.from else hand;
  strength := ifx l.strength < 0 then 0.0f32 else ifx l.strength > 1 then 1.0f32 else l.strength;
  // the moment the page was drawing, inside the bound: how long ago the arrow left
  now_ms := t * 1000 / EG_HZ;
  back := net_rewind(now_ms, net_loose_view(now_ms, l.view_ms), 0);
  age := ifx l.view_ms > 0 then back.age_ms else 0;
  now := e2a_clock(a, t);
  i := bow.arrow_loose(a[0].ar[0].arrows[..], seat, from, bow.arrow_launch(from, l.to, strength), now - f32(age) / 1000, -1, strength);
  a[0].next += 1; a[0].tag[i] = E2ArrowTag.{id = a[0].next, seat = seat, slot = slot, from = from, mode = e2a_range_mode(v, k, seat), range = e2_range_ground(me.x, me.z, 2)};
  a[0].loosed += 1; a[0].rewound_ms = age;
  out: [200] u8;
  n := net_shot_write(NetShot.{tick = t, id = a[0].next, seat = seat, seq = seq, from = from, vel = a[0].ar[0].arrows[0].a[i].vel, strength = strength, age_ms = age}, out[..]);
  if n > 0 { e2ar_say(v, k, cast(string) out[0..<n], me.x, me.z); }
  // the ticks it missed, each against the bodies as they stood then
  ticks := net_rewind_ticks(age, EG_HZ);
  for q: 0..<ticks { e2a_fly(v, k, t - ticks + 1 + q); }
  return true;
}
// Every flying arrow flown to tick `tick`'s moment, against the bodies as they stood at it.
e2a_fly :: (v: [] RmServer, k: int, tick: int) {
  a := e2a_room(v, k); ar := a[0].ar[..]; now := e2a_clock(a, tick);
  bodies: [E2AR_BODIES] arch.ArcheryBody; nb := e2a_bodies(v, k, tick, bodies[..]);
  f: [1] arch.ArrowFlight;
  while e2ar_fly(ar[0].arrows[..], f[..], now, e2a_land(v), a[0].near[..]) {
    i := f[0].i; tag := a[0].tag[i];
    l := arch.archery_land(ar, f[0], bodies[0..<nb], tag.seat);
    if l.kind == arch.LAND_NONE { continue; }
    // in one of the Archery Range's faces (#13507): stuck there, the face named, its points the archer's
    if l.kind == arch.LAND_MARK {
      a[0].marks += 1;
      e2a_empty(v, k, tag);
      e2a_range_told(v, k, tag, l.mark, rg_points(l.off, ar[0].targets[0].face[l.mark].radius), l.at);
      e2a_say_end(v, k, tag.id, NET_SHOT_STUCK, l.at, ar[0].arrows[0].a[i].dir, l.mark);
      ar[0].arrows[0].a[i] = bow.Arrow.{}; a[0].tag[i] = E2ArrowTag.{};
      continue;
    }
    if l.kind == arch.LAND_BODY {
      c := bodies[0]; for q: 0..<nb { if bodies[q].id == l.body { c = bodies[q]; } }
      if e2a_strike(v, k, tag, l.body) {
        a[0].hits += 1;
        arch.archery_body(ar, f[0], l, true);
        e2a_say_end(v, k, tag.id, NET_SHOT_BODY, c.at, ar[0].arrows[0].a[i].dir, l.body);
        ar[0].arrows[0].a[i] = bow.Arrow.{}; a[0].tag[i] = E2ArrowTag.{};
      } else { a[0].misses += 1; arch.archery_body(ar, f[0], l, false); }   // a miss flies on past it
      continue;
    }
    // stuck in the ground: the Attack met no one
    a[0].stuck += 1;
    e2a_empty(v, k, tag);
    if tag.range { e2a_range_told(v, k, tag, -1, 0, ar[0].arrows[0].a[i].at); }   // a miss on the range
    e2a_say_end(v, k, tag.id, NET_SHOT_STUCK, ar[0].arrows[0].a[i].at, ar[0].arrows[0].a[i].dir, -1);
    ar[0].arrows[0].a[i] = bow.Arrow.{}; a[0].tag[i] = E2ArrowTag.{};
  }
  // one that has flown too long is let go, and the pages told
  for i: 0..<bow.ARROWS {
    w := ar[0].arrows[0].a[i];
    if w.state != bow.ARROW_FLYING || now - w.t0 <= f32(bow.ARROW_LONG) { continue; }
    a[0].gone += 1;
    e2a_empty(v, k, a[0].tag[i]);
    if a[0].tag[i].range { e2a_range_told(v, k, a[0].tag[i], -1, 0, bow.arrow_pos(w, now - w.t0)); }
    e2a_say_end(v, k, a[0].tag[i].id, NET_SHOT_GONE, bow.arrow_pos(w, now - w.t0), bow.arrow_dir(w, now - w.t0), -1);
    ar[0].arrows[0].a[i] = bow.Arrow.{}; a[0].tag[i] = E2ArrowTag.{};
  }
}
// The archer's rules for its Attack, when its seat still holds that class's slot: (rules, seat, class).
e2a_archer_ok :: (v: [] RmServer, k: int, tag: E2ArrowTag) -> bool {
  if tag.seat < 0 || tag.seat >= eg_cap(v, k) || !v[0].eg[k].seat[tag.seat].live { return false; }
  r := v[0].eg[k].rules[..];
  return xk_entry_held(r[0].klass[tag.seat] - EGB_CL0, r[0].b[0].c[EGB_SEAT + tag.seat].level, tag.slot, r[0].b[0].c[EGB_SEAT + tag.seat].ranged).ok;
}
// A loosed arrow's Attack, rolled as it lands. Its Action was the turn's it was loosed in (the seat's
// pace took it then, eg_e2_cast), so the rules open that Action for it, and the turn the seat is in now
// keeps its own as it stands.
e2a_attack :: (r: [] EgBattle, s: int, slot: int, x: int, y: int, foe: int) -> bool {
  seat := r[0].seat[s..<s + 1]; was := seat[0].turn.action;
  done := e2r_press(r[0].b[..], seat, r[0].klass[s] - EGB_CL0, slot, x, y, foe, XP_ACTION);
  seat[0].turn.action = was;
  return done;
}
// An arrow reached body b: the SRD Attack on it, rolled now (everglade/shared/cast-rules.coax). Whether it hit.
e2a_strike :: (v: [] RmServer, k: int, tag: E2ArrowTag, b: int) -> bool {
  foe := e2a_creature(v, k, b);
  if foe < 0 || !e2a_archer_ok(v, k, tag) { return false; }
  r := v[0].eg[k].rules[..]; s := tag.seat; me := v[0].eg[k].seat[s].pose;
  hp := r[0].b[0].c[foe].hp;
  done := e2a_attack(r, s, tag.slot, egb_sq(me.x), egb_z_cell(r, me.z), foe);
  if !done { return false; }
  if b == E2AR_GUARD { e2_guard_struck(v, k, s, hp); } else { e2_monster_struck(v, k, s, foe, hp); }
  e2_kit_tell(v, k, SeatId.{value = s}, false);
  return r[0].b[0].c[foe].hp < hp;
}
// An arrow met no one: the Attack is spent on the air, as a cast aimed at nothing is.
e2a_empty :: (v: [] RmServer, k: int, tag: E2ArrowTag) {
  if !e2a_archer_ok(v, k, tag) { return; }
  r := v[0].eg[k].rules[..]; s := tag.seat; me := v[0].eg[k].seat[s].pose;
  _ := e2a_attack(r, s, tag.slot, egb_sq(me.x), egb_z_cell(r, me.z), -1);
  e2_kit_tell(v, k, SeatId.{value = s}, false);
}
// ---- the Archery Range (#13507): its faces are the arrows' targets (e2ar_range_targets), and each
// arrow of a seat's on the range is scored into that seat's tally and told to it alone (range-wire.coax)
// How seat s shoots now: on foot, from horseback or from dragonback.
e2a_range_mode :: (v: [] RmServer, k: int, s: int) -> int {
  if !e2rd_lift(v, k, s).on { return RG_FOOT; }
  r := e2rd_room(v, k); m := e2r_of(r[0], s);
  return ifx m >= 0 && r[0].kind[m] == MK_DRAGON then RG_DRAGON else RG_HORSE;
}
// Arrow `tag` landed at `at`, in face `face` for `points` (-1 and 0: a miss): into its archer's tally, and told it.
e2a_range_told :: (v: [] RmServer, k: int, tag: E2ArrowTag, face: int, points: int, at: [3] f32) {
  s := tag.seat;
  if s < 0 || s >= eg_cap(v, k) || !v[0].eg[k].seat[s].live || tag.id <= 0 { return; }
  dx := at[0] - tag.from[0]; dz := at[2] - tag.from[2]; d := sqrt(dx * dx + dz * dz) * 100 + 0.5;
  cm := ifx !(d >= 0) then 0 else ifx d > f32(EGR_FAR_CM) then EGR_FAR_CM else cast(int) d;
  e := EgrArrow.{ok = true, id = tag.id, mode = tag.mode, cm = cm, points = ifx face >= 0 then points else 0, face = ifx face >= 0 && points > 0 then face else -1};
  st := v[0].eg[k].seat[s..<s + 1];
  egr_take(st[0].range[..], e, f32(v[0].eg[k].tick) / f32(EG_HZ));
  b: [64] u8; n := egr_put(b[..], e);
  eg_event_only(v, k, cast(string) b[0..<n], s);
  _ := ri_range_shot(v, k, SeatId.{value = s}, rg_shot(e.mode, f32(e.cm) / 100, e.points), st[0].range[0].run);   // and on its character's record (#13519)
}
// Seat s asks to clear its tally (E kind 23): cleared, and told so; standing on the range, it goes
// back to the line too (#13519), off any mount it rides, where it arrived (layout.coax rg_arrive).
e2a_range_reset :: (v: [] RmServer, k: int, seat_id: SeatId, u: WireUse) { s := seat_id.value;
  if !egr_reset_read(u) { eg_refuse(v, k, seat_id, u.seq, "no"); return; }
  st := v[0].eg[k].seat[s..<s + 1];
  if u.seq <= st[0].range_last { return; }
  st[0].range_last = u.seq;
  e := EgrArrow.{ok = true}; egr_take(st[0].range[..], e, 0);
  b: [64] u8; n := egr_put(b[..], e);
  eg_event_only(v, k, cast(string) b[0..<n], s);
  _ := ri_range_shot(v, k, seat_id, RG_SHOT_CLEAR, 0);   // the record's lasting tally too (#13519)
  if e2a_range_here(v, k, s) {
    if e2r_of(e2rd_room(v, k)[0], s) >= 0 { left := e2r_leave(e2rd_room(v, k), s, v[0].eg[k].tick); }
    a := rg_arrive(); e2a_range_go(v, k, s, a[0], a[1], f32(RG_ARRIVE_FACE));
  }
}
// Whether seat s stands on the range's ground, placed and free to move.
e2a_range_here :: (v: [] RmServer, k: int, s: int) -> bool {
  st := v[0].eg[k].seat[s];
  return st.live && st.placed && rg_lends(st.pose.x, st.pose.z) && e2rd_free(v, k, s);
}
e2a_range_go :: (v: [] RmServer, k: int, s: int, x: f32, z: f32, face: f32) {
  st := v[0].eg[k].seat[s..<s + 1]; st[0].range_go = true; st[0].range_to = [3] f32.[x, z, face];
}
// Seat s asks to shoot another way (E kind 24, #13519), by riding's own rules: on foot, it gets down
// (e2ml_dismount: a flier in the air lands first); from horseback or dragonback, off whatever else it
// rides and onto the range's horse or dragon, stepped up to it from its side wherever on the range it
// stands. Answered as riding answers (e ride), MOUNT the mount it was about.
e2a_range_ride :: (v: [] RmServer, k: int, seat_id: SeatId, u: WireUse) { s := seat_id.value;
  mode := egr_ride_read(u);
  if mode < 0 { eg_refuse(v, k, seat_id, u.seq, "no"); return; }
  st := v[0].eg[k].seat[s..<s + 1];
  if u.seq <= st[0].range_last { return; }
  st[0].range_last = u.seq;
  r := e2rd_room(v, k); tick := v[0].eg[k].tick; mine := e2r_of(r[0], s);
  code := E2R_HELD; mount := mine;
  if e2a_range_here(v, k, s) {
    if mode == RG_FOOT {
      g := v[0].e2land; none: [6] f32;
      code = ifx mine < 0 then E2R_OK else ifx g.count > 0 && g[0].done then e2ml_dismount(r, s, true, tick, g[0].still[..], g[0].items[..], g[0].kinds[..], g[0].first[..], true) else e2r_dismount(r, s, true, tick, none[..], 0);
      if code == E2R_ALOFT { code = e2r_land(r, s); }
    } else {
      mount = ifx mode == RG_HORSE then E2ML_RANGE_HORSE else E2ML_RANGE_DRAGON;
      if mine == mount { code = E2R_OK; }
      else if mount >= r[0].n || r[0].m[mount].state != MOUNT_FREE { code = ifx mount >= r[0].n then E2R_NONE else E2R_TAKEN; }
      else if mine >= 0 && mount_aloft(r[0].m[mine]) { code = E2R_ALOFT; }
      else {
        if mine >= 0 { left := e2r_leave(r, s, tick); }
        h := r[0].m[mount]; side := 1.2f32;   // at its side, inside its reach (mount-rules.coax)
        x := h.x + side * cos(h.face); z := h.z - side * sin(h.face);
        code = e2r_mount(r, s, mount, x, z, true, tick);
        if code == E2R_OK { e2a_range_go(v, k, s, x, z, h.face); }
      }
    }
  }
  b: [48] u8; n := egm_answer_put(b[..], EgmAnswer.{seq = u.seq, code = code, mount = mount});
  eg_event_only(v, k, cast(string) b[0..<n], s);
}
// The host's step (admin.coax rm_e2_admin_warp): seat s's move on the range, taken once, into out (x, z, facing).
e2a_range_go_take :: (v: [] RmServer, k: int, s: int, out: [] f32) -> bool {
  if k < 0 || k >= EG_ROOMS || s < 0 || s >= eg_cap(v, k) || out.count < 3 || !v[0].eg[k].seat[s].range_go { return false; }
  st := v[0].eg[k].seat[s..<s + 1]; st[0].range_go = false;
  if !st[0].live || !st[0].placed { return false; }
  for i: 0..<3 { out[i] = st[0].range_to[i]; }
  return true;
}
// Each tick: every seat that stands where the range lends a Longbow (layout.coax rg_lends) holds one as
// its ranged weapon in the rules, and the one it had is kept for it; off the range it has its own again.
// A Ranger's own is a Longbow: nothing changes for it.
e2a_range_lend :: (v: [] RmServer, k: int) {
  r := v[0].eg[k].rules[..];
  for s: 0..<eg_cap(v, k) {
    st := v[0].eg[k].seat[s..<s + 1];
    if !st[0].live || !r[0].live[s] { st[0].range_own = -2; continue; }
    c := r[0].b[0].c[EGB_SEAT + s..<EGB_SEAT + s + 1];
    if st[0].placed && rg_lends(st[0].pose.x, st[0].pose.z) {
      if c[0].ranged != W_LONGBOW { st[0].range_own = c[0].ranged; c[0].ranged = W_LONGBOW; }
    } else if st[0].range_own != -2 {
      if c[0].ranged == W_LONGBOW { c[0].ranged = st[0].range_own; }
      st[0].range_own = -2;
    }
  }
}

// The tick (after the monsters have moved): this tick's bodies are written down, then every arrow flies to it.
e2_arrows_tick :: (v: [] RmServer, k: int) {
  e2a_range_lend(v, k);   // the Archery Range's Longbow, lent and given back (#13519)
  e2a_remember(v, k);
  a := e2a_room(v, k);
  if e2a_flying(a) == 0 { return; }   // (epoch may be below 0: a room younger than E2A_LEAD ticks)
  e2a_fly(v, k, v[0].eg[k].tick);
}

// A check's Ranger in an Everglade II room of its own, standing on the path at (0, -40).
e2at_room :: (v: [] RmServer, code: string) -> int {
  rm_init(v); rm_clock(v, 0, 1762190000000);
  path: [128] u8; n := wire_put(path[..], 0, "GET /api/room/relay/everglade/"); n = wire_put(path[..], n, code); n = wire_put(path[..], n, " HTTP/1.1\r\n\r\n");
  if rm_join(v, 0, cast(string) path[0..<n]) != 0 { return -1; }
  k := eg_room_at(v, v[0].conns[0].relay);
  rm_heard(v, 0, "H 6 ranger.0.0.0 srd-ranger 0 -");
  eg_test_tick(v, k);
  e2mt_at(v, k, 0, -40);
  return k;
}
// The Ranger's Attack on the wire: the Longbow's shot (class-kit.coax xk_bar).
e2at_attack :: () -> int {
  bar: [XC_SLOTS] FbAb; n := xk_bar(FB_CL_RANGER, bar[..]);
  for i: 0..<n { if bar[i].kind == FB_ATTACK { return xk_wire(FB_CL_RANGER, bar[i]); } }
  return -1;
}
// The launch and the Attack's request a page sends: from the hand toward `to`, drawn at tick `view`.
e2at_shoot :: (v: [] RmServer, k: int, seq: int, to: [3] f32, view_tick: int) {
  me := v[0].eg[k].seat[0].pose; b: [160] u8;
  from := e2ar_hand(me.x, me.z, to);
  n := net_loose_write(NetLoose.{seq = seq, from = from, to = to, strength = 1, view_ms = view_tick * 1000 / EG_HZ}, b[..]);
  rm_heard(v, 0, cast(string) b[0..<n]);
  n = wire_put_cast(b[..], 0, WireCast.{seq = seq, slot = e2at_attack(), ax = me.x, ay = 1, az = me.z - 5});
  rm_heard(v, 0, cast(string) b[0..<n]);
}
#test "e2 arrows: a Ranger's loose is an arrow the room flies; the page hears it by id and where it stuck" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2at_room(v[..], "pair-e2-arrows"); #assert k >= 0;
  a := v[0].eg[k].arrows[..]; out: [262144] u8;
  for q: 0..<10 { e2mt_tick(v[..], k); }
  _ := e2rt_heard(v[..], 0, out[..]);
  to := [3] f32.[0.5, e2_height(0.5, -62), -62];
  e2at_shoot(v[..], k, 1000001, to, v[0].eg[k].tick);
  #assert a[0].loosed == 1 && e2a_flying(a) == 1 && a[0].rewound_ms == 0;
  heard := e2rt_heard(v[..], 0, out[..]);
  // its id, the archer's seat and request, where it left and how fast (metaverse-engine/net/projectile.coax a)
  got: NetShot; i := 0;
  while i < heard.count { e := i; while e < heard.count && heard[e] != '|' && heard[e] != '\n' { e += 1; } if heard[i] == 'a' { got = net_shot_read(heard[i..<e]); } i = e + 1; }
  #assert got.ok && got.id == 1 && got.seat == 0 && got.seq == 1000001 && got.vel[2] < -20 && got.age_ms == 0;
  stuck := false; ended: NetShotEnd; ticks := 0;
  while !stuck && ticks < EG_HZ * 4 {
    e2mt_tick(v[..], k); ticks += 1;
    heard = e2rt_heard(v[..], 0, out[..]); i = 0;
    while i < heard.count { e := i; while e < heard.count && heard[e] != '|' && heard[e] != '\n' { e += 1; } if heard[i] == 'd' { w := net_shot_end_read(heard[i..<e]); if w.ok { ended = w; stuck = true; } } i = e + 1; }
  }
  #assert a[0].hits == 0 && a[0].gone == 0 && a[0].misses == 0;
  #assert stuck && ended.id == 1 && ended.kind == NET_SHOT_STUCK && ended.body == -1 && ticks > 8 && a[0].stuck == 1 && e2a_flying(a) == 0;
  #assert abs(ended.at[0] - to[0]) < 1.5 && abs(ended.at[2] - to[2]) < 8 && ended.dir[1] < 0;
  // the next Attack with no launch before it is the cast it was: no arrow
  for q: 0..<XP_BEAT { e2mt_tick(v[..], k); }
  b: [96] u8; n := wire_put_cast(b[..], 0, WireCast.{seq = 1000002, slot = e2at_attack(), ax = 0, ay = 1, az = -45});
  rm_heard(v[..], 0, cast(string) b[0..<n]);
  e2mt_tick(v[..], k); h2 := e2rt_heard(v[..], 0, out[..]);   // a cast is told with the tick's frame
  #assert a[0].loosed == 1 && eg_test_has(h2, "e cast");
  // a launch whose request is refused (the cooldown) looses nothing, and is not kept for a later one
  e2at_shoot(v[..], k, 1000003, to, v[0].eg[k].tick);
  #assert a[0].loosed == 1 && eg_test_has(e2rt_heard(v[..], 0, out[..]), "r 1000003");
}
#test "e2 arrows: on the Archery Range the room scores every arrow: one in a face is stuck there by name, a miss counts, and the tally clears on asking (#13507)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2at_room(v[..], "pair-e2-range"); #assert k >= 0;
  a := v[0].eg[k].arrows[..]; out: [262144] u8; st := v[0].eg[k].seat[0..<1];
  at := rg_arrive(); e2mt_at(v[..], k, at[0], at[1]);
  for q: 0..<10 { e2mt_tick(v[..], k); }
  _ := e2rt_heard(v[..], 0, out[..]);
  // at the 10 m gold, from the line
  f0 := rg_target(0, e2_height(rg_piece_at(0)[0], rg_piece_at(0)[1]));
  e2at_shoot(v[..], k, 1000001, [3] f32.[f0.x, f0.y + 0.15, f0.z], v[0].eg[k].tick);
  #assert a[0].loosed == 1 && a[0].tag[0].range && a[0].tag[0].mode == RG_FOOT;
  ended: NetShotEnd; told := false; ticks := 0;
  while !ended.ok && ticks < EG_HZ * 3 {
    e2mt_tick(v[..], k); ticks += 1;
    heard := e2rt_heard(v[..], 0, out[..]); i := 0;
    while i < heard.count { e := i; while e < heard.count && heard[e] != '|' && heard[e] != '\n' { e += 1; } if heard[i] == 'd' { ended = net_shot_end_read(heard[i..<e]); } i = e + 1; }
    told = eg_test_has(heard, "e range 1 0 ");   // told with the tick that ended it: arrow 1, on foot
  }
  sc := st[0].range[0]; p := sc.last_points;
  #assert ended.ok && ended.kind == NET_SHOT_STUCK && ended.body == 0 && abs(ended.at[2] - f0.z) < 0.3 && a[0].marks == 1 && a[0].hits == 0;
  #assert rg_sum(sc, RG_FOOT, -1).shots == 1;
  #assert p >= 5;
  #assert abs(sc.last_distance - sqrt((f0.x - at[0]) * (f0.x - at[0]) + (f0.z - at[1]) * (f0.z - at[1]))) < 1.5;   // from the hand to where it struck
  #assert rg_sum(sc, -1, -1).points == p;
  #assert told;
  // into the turf short of the butts: a miss, counted
  for q: 0..<XP_BEAT + 2 { e2mt_tick(v[..], k); }
  _ = e2rt_heard(v[..], 0, out[..]);
  e2at_shoot(v[..], k, 1000002, [3] f32.[at[0] + 3, e2_height(at[0] + 3, at[1] - 6), at[1] - 6], v[0].eg[k].tick);
  for q: 0..<EG_HZ * 2 { e2mt_tick(v[..], k); }
  t := rg_sum(st[0].range[0], -1, -1); #assert a[0].loosed == 2 && t.shots == 2 && t.hits == 1 && st[0].range[0].last_points == 0;
  // cleared on asking, and told so; the same ask again is heard once
  b: [32] u8; n := wire_put_use(b[..], 0, egr_reset_ask(5));
  rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert eg_test_has(e2rt_heard(v[..], 0, out[..]), "e range 0 0 0 0 -1") && rg_sum(st[0].range[0], -1, -1).shots == 0 && st[0].range_last == 5;
  rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k); #assert !eg_test_has(e2rt_heard(v[..], 0, out[..]), "e range");
}
#test "e2 arrows: on the Archery Range a fresh Druid holds the range's Longbow: its Attack looses an arrow the room scores; off the range it is its own again; RESET takes it back to the line (#13519)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-lent HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay); rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-druid 0 -"); eg_test_tick(v[..], k);
  a := v[0].eg[k].arrows[..]; out: [262144] u8; st := v[0].eg[k].seat[0..<1]; r := v[0].eg[k].rules[..];
  c := r[0].b[0].c[EGB_SEAT..<EGB_SEAT + 1]; own := c[0].ranged;
  #assert r[0].klass[0] - EGB_CL0 == FB_CL_DRUID && c[0].level == 1 && own != W_LONGBOW;
  slot := xk_wire(FB_CL_DRUID, xk_attack_of(FB_CL_DRUID)); #assert !xk_entry_at(FB_CL_DRUID, 1, slot).ok;
  // on the path: nothing lent, and its Attack is not on its bar
  e2mt_at(v[..], k, 0, -40); for q: 0..<4 { e2mt_tick(v[..], k); }
  #assert c[0].ranged == own && st[0].range_own == -2;
  // behind the line: the range's Longbow, its own kept
  at := rg_arrive(); e2mt_at(v[..], k, at[0], at[1]);
  for q: 0..<10 { e2mt_tick(v[..], k); }
  #assert c[0].ranged == W_LONGBOW && st[0].range_own == own;
  _ := e2rt_heard(v[..], 0, out[..]);
  f0 := rg_target(0, e2_height(rg_piece_at(0)[0], rg_piece_at(0)[1])); to := [3] f32.[f0.x, f0.y + 0.15, f0.z];
  me := st[0].pose; b: [160] u8;
  n := net_loose_write(NetLoose.{seq = 1000001, from = e2ar_hand(me.x, me.z, to), to = to, strength = 1, view_ms = v[0].eg[k].tick * 1000 / EG_HZ}, b[..]);
  rm_heard(v[..], 0, cast(string) b[0..<n]);
  n = wire_put_cast(b[..], 0, WireCast.{seq = 1000001, slot = slot, ax = me.x, ay = 1, az = me.z - 5}); rm_heard(v[..], 0, cast(string) b[0..<n]);
  #assert a[0].loosed == 1 && a[0].tag[0].range && a[0].tag[0].mode == RG_FOOT;
  for q: 0..<EG_HZ * 3 { e2mt_tick(v[..], k); }
  #assert rg_sum(st[0].range[0], -1, -1).shots == 1 && a[0].marks == 1 && st[0].range[0].last_points >= 5;
  // RESET: the tally cleared, and back to the line from wherever on the range
  e2mt_at(v[..], k, at[0] + 12, at[1] - 20); for q: 0..<2 { e2mt_tick(v[..], k); }
  n = wire_put_use(b[..], 0, egr_reset_ask(5)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert rg_sum(st[0].range[0], -1, -1).shots == 0 && st[0].range_go;
  w: [3] f32; #assert rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, w[..]) && w[0] == at[0] && w[1] == at[1] && w[2] == f32(RG_ARRIVE_FACE) && !st[0].range_go;
  #assert !rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, w[..]);   // once
  // off the range: RESET clears the tally but moves no one, and the Longbow goes back
  e2mt_at(v[..], k, 0, -40); for q: 0..<2 { e2mt_tick(v[..], k); }
  #assert c[0].ranged == own && st[0].range_own == -2;
  n = wire_put_use(b[..], 0, egr_reset_ask(6)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert !st[0].range_go && st[0].range_last == 6;
  // and its Attack is refused there, as before the range: not on a level-1 Druid's bar
  for q: 0..<XP_BEAT + 2 { e2mt_tick(v[..], k); }
  _ = e2rt_heard(v[..], 0, out[..]);
  n = wire_put_cast(b[..], 0, WireCast.{seq = 1000002, slot = slot, ax = 0, ay = 1, az = -42}); rm_heard(v[..], 0, cast(string) b[0..<n]);
  #assert a[0].loosed == 1 && eg_test_has(e2rt_heard(v[..], 0, out[..]), "r 1000002 slot");
}
#test "e2 arrows: on the Archery Range FOOT, HORSE and DRAGON are riding's own asks: onto the range's horse or dragon from anywhere on it, and down again; off the range, refused (#13519)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2at_room(v[..], "pair-e2-range-ride"); #assert k >= 0;
  st := v[0].eg[k].seat[0..<1]; out: [262144] u8; b: [64] u8; w: [3] f32;
  at := rg_arrive(); e2mt_at(v[..], k, at[0], at[1]); for q: 0..<6 { e2mt_tick(v[..], k); }
  r := e2rd_room(v[..], k);
  #assert r[0].kind[E2ML_RANGE_HORSE] == MK_HORSE && r[0].kind[E2ML_RANGE_DRAGON] == MK_DRAGON;
  _ := e2rt_heard(v[..], 0, out[..]);
  // HORSE from the line, 5 m from it: up from its side, and the host steps the seat there
  n := wire_put_use(b[..], 0, egr_ride_ask(7000001, RG_HORSE)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert e2r_of(r[0], 0) == E2ML_RANGE_HORSE && eg_test_has(e2rt_heard(v[..], 0, out[..]), "e ride 7000001 0 2");
  h := r[0].m[E2ML_RANGE_HORSE];
  #assert rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, w[..]) && mount_near(Mount.{on = true, x = h.x, z = h.z, face = h.face}, mk_tune(MK_HORSE), w[0], w[1]);
  e2mt_at(v[..], k, w[0], w[1]);
  seq := 1; for q: 0..<25 { e2rd_test_input(v[..], 0, seq, 0, 0, 0); seq += 1; e2rd_test_tick(v[..], k); }   // its inputs carry it into the saddle
  #assert r[0].m[E2ML_RANGE_HORSE].state == MOUNT_RIDDEN && e2a_range_mode(v[..], k, 0) == RG_HORSE;
  // DRAGON from the saddle: off the horse at once and onto the dragon
  n = wire_put_use(b[..], 0, egr_ride_ask(7000002, RG_DRAGON)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert e2r_of(r[0], 0) == E2ML_RANGE_DRAGON && r[0].m[E2ML_RANGE_HORSE].state == MOUNT_FREE && eg_test_has(e2rt_heard(v[..], 0, out[..]), "e ride 7000002 0 3");
  #assert rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, w[..]); e2mt_at(v[..], k, w[0], w[1]);
  for q: 0..<60 { e2rd_test_input(v[..], 0, seq, 0, 0, 0); seq += 1; e2rd_test_tick(v[..], k); }
  #assert r[0].m[E2ML_RANGE_DRAGON].state == MOUNT_RIDDEN && e2a_range_mode(v[..], k, 0) == RG_DRAGON;
  // the same ask again is heard once; FOOT gets down by riding's rule
  rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k); #assert !eg_test_has(e2rt_heard(v[..], 0, out[..]), "e ride 7000002");
  n = wire_put_use(b[..], 0, egr_ride_ask(7000003, RG_FOOT)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert eg_test_has(e2rt_heard(v[..], 0, out[..]), "e ride 7000003 0 3");
  for q: 0..<60 { e2rd_test_input(v[..], 0, seq, 0, 0, 0); seq += 1; e2rd_test_tick(v[..], k); }
  #assert e2r_of(r[0], 0) < 0 && e2a_range_mode(v[..], k, 0) == RG_FOOT;
  // on foot already: FOOT is done, nothing to do
  n = wire_put_use(b[..], 0, egr_ride_ask(7000004, RG_FOOT)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert eg_test_has(e2rt_heard(v[..], 0, out[..]), "e ride 7000004 0 -1");
  // off the range nothing moves: held (E2R_HELD); a mode that is none is refused
  e2mt_at(v[..], k, 0, -40); for q: 0..<2 { e2mt_tick(v[..], k); } _ = e2rt_heard(v[..], 0, out[..]);
  n = wire_put_use(b[..], 0, egr_ride_ask(7000005, RG_HORSE)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert e2r_of(r[0], 0) < 0 && eg_test_has(e2rt_heard(v[..], 0, out[..]), "e ride 7000005 2 -1") && !rm_e2_admin_warp(v[..], k, SeatId.{value = 0}, w[..]);
  n = wire_put_use(b[..], 0, egr_ride_ask(7000006, 3)); rm_heard(v[..], 0, cast(string) b[0..<n]); e2mt_tick(v[..], k);
  #assert eg_test_has(e2rt_heard(v[..], 0, out[..]), "r 7000006 no");
}
#test "e2 arrows: the Archery Range's tally lasts on the character's record: each arrow a claim, RESET's clear one, and a seat sat again takes it back and is told it (#13519)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2at_room(v[..], "pair-e2-range-lasts"); #assert k >= 0;
  st: [1] RiStore; seat := v[0].eg[k].seat[0..<1]; out: [262144] u8;
  c := ri_open(v[..], k, 0, "p-a", 1); #assert c >= 0 && ri_seat(v[..], k, 0) == c;   // a check's room has no ticket: its character sits by hand
  seat[0].full = false;   // its page took its snapshot (input.coax: an input past it)
  ri_test_drain(v[..], st[..]); e2mt_tick(v[..], k); #assert v[0].itm.c[c].synced && v[0].itm.c[c].ranged && !char_ranged(v[0].itm.c[c].rec);
  at := rg_arrive(); f := rg_target(0, 0);
  // two arrows land: a 10 and a miss, each told, each a claim
  e2a_range_told(v[..], k, E2ArrowTag.{id = 1, seat = 0, from = [3] f32.[at[0], 1, at[1]], mode = RG_FOOT, range = true}, 0, 10, [3] f32.[f.x, f.y, f.z]);
  e2a_range_told(v[..], k, E2ArrowTag.{id = 2, seat = 0, from = [3] f32.[at[0], 1, at[1]], mode = RG_HORSE, range = true}, -1, 0, [3] f32.[at[0], 0, at[1] - 30]);
  #assert rg_sum(seat[0].range[0], -1, -1).shots == 2 && rm_items_pending(v[..]) == 2;
  ri_test_drain(v[..], st[..]);
  w := v[0].itm.c[c].rec;
  #assert char_ranged(w) && w.range[0] == 1 && rg_sum(rg_tally_score(w.range[..], CHAR_RANGE), -1, -1).shots == 2 && rg_sum(rg_tally_score(w.range[..], CHAR_RANGE), RG_FOOT, -1).points == 10;
  // the seat leaves and sits again: its new seat's tally is the record's, and its page hears it whole
  ri_left(v[..], k, SeatId.{value = 0}); seat[0].range[0] = RgScore.{};
  c = ri_open(v[..], k, 0, "p-a", 1); _ := e2rt_heard(v[..], 0, out[..]);
  #assert c >= 0 && !v[0].itm.c[c].ranged && rm_items_pending(v[..]) == 1;
  ri_test_drain(v[..], st[..]); #assert v[0].itm.c[c].synced && !v[0].itm.c[c].ranged;   // read, and taken at the seat's next tick once its page has its snapshot
  seat[0].full = true; e2mt_tick(v[..], k); #assert !v[0].itm.c[c].ranged; seat[0].full = false;
  told := false; for q: 0..<4 { e2mt_tick(v[..], k); if eg_test_has(e2rt_heard(v[..], 0, out[..]), "e tally 1 0 0 0 0 1 1 10 1 0 ") { told = true; } }   // once its snapshot is out
  #assert v[0].itm.c[c].ranged && char_ranged(v[0].itm.c[c].rec) && told && !seat[0].full;
  #assert rg_sum(seat[0].range[0], -1, -1).shots == 2 && seat[0].range[0].best_run == 1 && rg_sum(seat[0].range[0], RG_HORSE, 2).shots == 1;
  // RESET clears it on the record too, which is v1's bytes again
  b: [32] u8; n := wire_put_use(b[..], 0, egr_reset_ask(9)); rm_heard(v[..], 0, cast(string) b[0..<n]);
  ri_test_drain(v[..], st[..]); #assert !char_ranged(v[0].itm.c[c].rec) && rg_sum(seat[0].range[0], -1, -1).shots == 0;
  o: [CHAR_BODY] u8; #assert char_write(v[0].itm.c[c].rec, o[..])[0..<6] == "{\"v\":1";
}
#test "e2 arrows: the room flies a loose from the moment its page was drawing, inside the bound, and it meets a monster where it stood then" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2at_room(v[..], "pair-e2-rewind"); #assert k >= 0;
  a := v[0].eg[k].arrows[..]; ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..]; out: [262144] u8;
  for q: 0..<6 { e2mt_tick(v[..], k); }
  v[0].eg[k].tick += 600;   // an older room: a moment 300 ticks back is after its start
  // a wolf stands 4 m down the path; the room's rules make every Attack hit and none kill
  m := 0; mo := ms[0].mon[m..<m + 1]; foe := EGB_BEAST0 + mo[0].q;
  b[0].c[foe].ac = 1; b[0].c[foe].hp = 500; b[0].c[foe].hp_max = 500;
  for q: 0..<8 { mo[0].x = 0; mo[0].z = -44; mo[0].state = E2M_IDLE; mo[0].foe = -1; e2a_remember(v[..], k); v[0].eg[k].tick += 1; }
  // then, for the room's last two ticks, it is 6 m aside: the archer's page, drawing five ticks back,
  // still saw it on the path when it loosed, and the arrow (4 m at 42 m/s: 3 ticks) reached it then
  for q: 0..<2 { mo[0].x = 6; e2a_remember(v[..], k); v[0].eg[k].tick += 1; }
  v[0].eg[k].tick -= 1;
  t := v[0].eg[k].tick; _ := e2rt_heard(v[..], 0, out[..]);
  chest := e2ar_monster(m, 0, 0, -44).at;
  e2at_shoot(v[..], k, 1000001, chest, t - 5);
  #assert a[0].loosed == 1 && a[0].rewound_ms == t * 1000 / EG_HZ - (t - 5) * 1000 / EG_HZ && a[0].rewound_ms >= 166 && a[0].rewound_ms <= 167;
  // judged in the ticks flown at once, against the wolf where it stood then
  #assert a[0].hits == 1 && b[0].c[foe].hp < 500 && e2a_flying(a) == 0;
  heard := e2rt_heard(v[..], 0, out[..]);
  #assert eg_test_has(heard, "d ") && !eg_test_has(heard, "e mon ");
  e2mt_tick(v[..], k); heard = e2rt_heard(v[..], 0, out[..]);   // the blow at it is an e entry of the tick's frame
  #assert eg_test_has(heard, "e mon ");
  // the same shot with no rewind (its page drew the present): the wolf is aside, and the arrow flies past
  v[0].eg[k].tick += XP_BEAT; e2a_remember(v[..], k); hp := b[0].c[foe].hp;
  e2at_shoot(v[..], k, 1000004, chest, v[0].eg[k].tick);
  for q: 0..<6 { v[0].eg[k].tick += 1; e2a_remember(v[..], k); e2a_fly(v[..], k, v[0].eg[k].tick); }
  #assert a[0].loosed == 2 && a[0].rewound_ms == 0 && a[0].hits == 1 && b[0].c[foe].hp == hp;
  // a page that claims a moment far in the past is taken at the bound
  v[0].eg[k].tick += XP_BEAT; e2a_remember(v[..], k);
  e2at_shoot(v[..], k, 1000002, [3] f32.[-8, e2_height(-8, -60), -60], v[0].eg[k].tick - 300);
  #assert a[0].loosed == 3 && a[0].rewound_ms == NET_REWIND_AGE_MS;
  // and one from the future, or from nowhere near the archer, flies from now, from the room's own hand
  v[0].eg[k].tick += XP_BEAT; e2a_remember(v[..], k);
  far: [160] u8; n := net_loose_write(NetLoose.{seq = 1000003, from = [3] f32.[40, 2, -90], to = [3] f32.[-8, 0, -60], strength = 1, view_ms = (v[0].eg[k].tick + 90) * 1000 / EG_HZ}, far[..]);
  rm_heard(v[..], 0, cast(string) far[0..<n]);
  n = wire_put_cast(far[..], 0, WireCast.{seq = 1000003, slot = e2at_attack(), ax = 0, ay = 1, az = -45}); rm_heard(v[..], 0, cast(string) far[0..<n]);
  #assert a[0].loosed == 4 && a[0].rewound_ms == 0;
  w: bow.Arrow; for i: 0..<bow.ARROWS { if a[0].tag[i].id == 4 { w = a[0].ar[0].arrows[0].a[i]; } }
  #assert e2ar_launch_ok(w.from, 0, -40);
}

#test "e2 arrows: a forged launch is refused whole, field by field, and one refused keeps nothing for its Attack (#13289)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2at_room(v[..], "pair-e2-forged"); #assert k >= 0;
  a := v[0].eg[k].arrows[..]; out: [262144] u8;
  for q: 0..<6 { e2mt_tick(v[..], k); }
  // F SEQ FX FY FZ TX TY TZ STRENGTH VIEW, each field past its bound in turn, then too few and too many
  bad := [12] string.[
    "F 0 0 1450 -40000 0 0 -60000 800 1",              // no number
    "F -4 0 1450 -40000 0 0 -60000 800 1",
    "F 7 2000001 1450 -40000 0 0 -60000 800 1",        // a hand out of the world, each axis
    "F 7 0 -2000001 -40000 0 0 -60000 800 1",
    "F 7 0 1450 2000001 0 0 -60000 800 1",
    "F 7 0 1450 -40000 -2000001 0 -60000 800 1",       // an aim out of the world, each axis
    "F 7 0 1450 -40000 0 2000001 -60000 800 1",
    "F 7 0 1450 -40000 0 0 -2000001 800 1",
    "F 7 0 1450 -40000 0 0 -60000 1001 1",             // more than a full draw, and less than none
    "F 7 0 1450 -40000 0 0 -60000 -1 1",
    "F 7 0 1450 -40000 0 0 -60000 800 -5",             // a view before time
    "F 7 0 1450 -40000 0 0 -60000 800"];               // a field short
  for q: 0..<bad.count { rm_heard(v[..], 0, bad[q]); #assert !v[0].eg[k].seat[0].loose.ok; }
  rm_heard(v[..], 0, "F 7 0 1450 -40000 0 0 -60000 800 1 9"); #assert !v[0].eg[k].seat[0].loose.ok;   // a field over
  rm_heard(v[..], 0, "F 7 0 x -40000 0 0 -60000 800 1"); #assert !v[0].eg[k].seat[0].loose.ok;       // not a number
  // the Attack that follows is the cast it was before arrows: no arrow is loosed
  b: [96] u8; n := wire_put_cast(b[..], 0, WireCast.{seq = 7, slot = e2at_attack(), ax = 0, ay = 1, az = -45});
  rm_heard(v[..], 0, cast(string) b[0..<n]);
  #assert a[0].loosed == 0 && !eg_test_has(e2rt_heard(v[..], 0, out[..]), "a ");
  // one inside every bound is kept; aimed at the hand itself (no line to fly) it still flies, with a speed that is a number
  v[0].eg[k].tick += XP_BEAT; e2a_remember(v[..], k);
  me := v[0].eg[k].seat[0].pose; hand := e2ar_hand(me.x, me.z, [3] f32.[0, 0, -60]);
  fb: [160] u8; fn := net_loose_write(NetLoose.{seq = 8, from = hand, to = hand, strength = 1, view_ms = v[0].eg[k].tick * 1000 / EG_HZ}, fb[..]);
  rm_heard(v[..], 0, cast(string) fb[0..<fn]); #assert v[0].eg[k].seat[0].loose.ok;
  n = wire_put_cast(b[..], 0, WireCast.{seq = 8, slot = e2at_attack(), ax = 0, ay = 1, az = -45}); rm_heard(v[..], 0, cast(string) b[0..<n]);
  #assert a[0].loosed == 1;
  w: bow.Arrow; for i: 0..<bow.ARROWS { if a[0].tag[i].id == 1 { w = a[0].ar[0].arrows[0].a[i]; } }
  #assert w.vel[0] == w.vel[0] && w.vel[1] == w.vel[1] && w.vel[2] == w.vel[2] && abs(w.vel[1]) < 100;
}
// A check's Fighter's Attack on the wire (class-kit.coax xk_bar).
e2ct_attack :: () -> int {
  bar: [XC_SLOTS] FbAb; n := xk_bar(FB_CL_FIGHTER, bar[..]);
  for i: 0..<n { if bar[i].kind == FB_ATTACK { return xk_wire(FB_CL_FIGHTER, bar[i]); } }
  return -1;
}
e2ct_swing :: (v: [] RmServer, seq: int, ax: f32, az: f32, view_tick: int) {
  b: [96] u8; n := wire_put_cast(b[..], 0, WireCast.{seq = seq, slot = e2ct_attack(), ax = ax, ay = 1, az = az, view = ifx view_tick > 0 then view_tick * 1000 / EG_HZ else 0});
  rm_heard(v, 0, cast(string) b[0..<n]);
}
#test "e2 casts: a swing is judged where its page drew the wolf, inside the arrows' bound; with no view, or at a wolf that is down now, it is judged now (#13289)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-swing"); #assert k >= 0;
  a := v[0].eg[k].arrows[..]; ms := v[0].eg[k].monsters[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..]; out: [262144] u8;
  for q: 0..<6 { e2mt_tick(v[..], k); }
  v[0].eg[k].tick += 600;
  e2mt_at(v[..], k, 0, -42);
  // a wolf stands one square down the path from the Fighter; every Attack hits and none kills
  m := 0; mo := ms[0].mon[m..<m + 1]; foe := egb0(v[..], k) + mo[0].q; wz := -42 - f32(EGB_SQ);
  b[0].c[foe].ac = 1; b[0].c[foe].hp = 500; b[0].c[foe].hp_max = 500;
  for q: 0..<8 {
    mo[0].x = 0; mo[0].z = wz; mo[0].state = E2M_IDLE; mo[0].foe = -1;
    b[0].c[foe].x = egb_sq(0); b[0].c[foe].y = egb_z_cell(r, wz);
    e2a_remember(v[..], k); v[0].eg[k].tick += 1;
  }
  // for the room's last two ticks it is 9 m aside: out of a sword's reach now
  for q: 0..<2 { mo[0].x = 9; b[0].c[foe].x = egb_sq(9); e2a_remember(v[..], k); v[0].eg[k].tick += 1; }
  v[0].eg[k].tick -= 1;
  t := v[0].eg[k].tick; _ := e2rt_heard(v[..], 0, out[..]);
  // every placed player is in the past too, the swinger among them
  seat_was := net_past_at(a[0].past[..], E2A_SEAT0, t, 0);
  #assert seat_was.up && seat_was.x == 0 && seat_was.z == -42 && E2A_FAM0 == E2A_SEAT0 + EG_ZONE_SEATS && E2A_FAM0 + EG_ZONE_SEATS <= NET_PAST_BODIES;
  #assert e2_monster_target(v[..], k, 0, wz) == -1 && e2_monster_target_at(v[..], k, 0, wz, t - 5) == foe;
  // its page, drawing five ticks back, swung at it on the path: the swing lands, and the wolf is where it is now after
  e2ct_swing(v[..], 1000001, 0, wz, t - 5);
  #assert a[0].cast_back == 5 && a[0].casts_back == 1 && b[0].c[foe].hp < 500 && !eg_test_has(e2rt_heard(v[..], 0, out[..]), "r 1000001");
  #assert b[0].c[foe].x == egb_sq(9) && b[0].c[foe].y == egb_z_cell(r, wz) && b[0].c[EGB_SEAT].x == egb_sq(0);
  // the same swing with no view is judged now: no wolf is there
  v[0].eg[k].tick += XP_BEAT; e2a_remember(v[..], k); hp := b[0].c[foe].hp;
  e2ct_swing(v[..], 1000002, 0, wz, 0);
  #assert a[0].cast_back == 0 && a[0].casts_back == 1 && b[0].c[foe].hp == hp;
  // a view from far in the past is taken at the bound, where the wolf was already aside; one from the future is now
  v[0].eg[k].tick += XP_BEAT; e2a_remember(v[..], k);
  e2ct_swing(v[..], 1000003, 0, wz, v[0].eg[k].tick - 300);
  #assert a[0].cast_back == net_rewind_ticks(NET_REWIND_AGE_MS, EG_HZ) && b[0].c[foe].hp == hp;
  v[0].eg[k].tick += XP_BEAT; e2a_remember(v[..], k);
  e2ct_swing(v[..], 1000004, 0, wz, v[0].eg[k].tick + 90);
  #assert a[0].cast_back == 0 && b[0].c[foe].hp == hp;
  // a wolf that is down now cannot be hit, wherever its page drew it
  for q: 0..<8 { mo[0].x = 0; b[0].c[foe].x = egb_sq(0); v[0].eg[k].tick += 1; e2a_remember(v[..], k); }
  b[0].c[foe].hp = 0; b[0].c[foe].dead = true;
  #assert e2_monster_target_at(v[..], k, 0, wz, v[0].eg[k].tick - 3) == -1;
  e2ct_swing(v[..], 1000005, 0, wz, v[0].eg[k].tick - 3);
  #assert b[0].c[foe].hp == 0 && b[0].c[foe].x == egb_sq(0);
}

// One trial of the latency check below: a wolf runs across the Fighter's front at 8 m/s; the page draws it
// `lag` ticks back and swings the tick it sees it in the square in front; the swing reaches the room `up` ticks
// later. Whether the room's swing reached the wolf (the wolf has the swinger down as one who struck at it, hit or miss).
e2ct_trial :: (v: [] RmServer, k: int, seq: int, start: f32, lag: int, up: int, view: bool, out: [] u8) -> bool {
  _ := e2rt_heard(v, 0, out);   // the seat's socket reads what the room said (a refusal waits in the relay's queue)
  a := v[0].eg[k].arrows[..]; ms := v[0].eg[k].monsters[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  mo := ms[0].mon[0..<1]; foe := egb0(v, k) + mo[0].q; wz := -42 - f32(EGB_SQ);
  v[0].eg[k].tick += XP_BEAT + NET_REWIND_TICKS;
  rm_clock(v, v[0].eg[k].tick * 1000 / EG_HZ, 1762190000000 + v[0].eg[k].tick * 1000 / EG_HZ);   // the room's clock goes on with its ticks (the relay's rate limit reads it)
  xs: [48] f32; seen := -1;
  for q: 0..<48 {
    x := start + f32(q) * 8.0 / f32(EG_HZ); xs[q] = x;
    mo[0].x = x; mo[0].z = wz; mo[0].state = E2M_IDLE; mo[0].foe = -1; slot_set_clear(mo[0].hurt_by[..]);
    b[0].c[foe].x = egb_sq(x); b[0].c[foe].y = egb_z_cell(r, wz); b[0].c[foe].hp = 500; b[0].c[foe].dead = false;
    v[0].eg[k].tick += 1; e2a_remember(v, k);
    // the page's picture this tick is the wolf `lag` ticks ago
    if seen < 0 && q >= lag && egb_sq(xs[q - lag]) == egb_sq(0) { seen = q; }
    if seen >= 0 && q == seen + up {
      e2ct_swing(v, seq, xs[seen - lag], wz, ifx view then v[0].eg[k].tick - up - lag else 0);
      return slot_set_has(mo[0].hurt_by[..], 0);
    }
  }
  return false;
}
#test "e2 casts: at 120 ms and 2% loss a swing that lands on the swinger's screen reaches the wolf in the room in 95 of 100 trials at least; judged at the present it does not (#13289)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-trials"); #assert k >= 0;
  ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..];
  for q: 0..<6 { e2mt_tick(v[..], k); }
  v[0].eg[k].tick += 600;
  e2mt_at(v[..], k, 0, -42);
  b[0].c[egb0(v[..], k) + ms[0].mon[0].q].ac = 1; b[0].c[egb0(v[..], k) + ms[0].mon[0].q].hp_max = 500;
  // 120 ms round trip: 60 ms up (2 ticks); the others drawn a jitter buffer behind (100 ms and the
  // 60 ms down: 5 ticks). 2% of swings lose their packet and come a resend later (8 ticks more).
  out: [262144] u8;
  landed := 0; now := 0; trials := 100; seed := 12345;
  for i: 0..<trials {
    seed = (seed * 1103515 + 12345) % 2147483;
    start := -2.5f32 - f32(seed % 1000) / 1000 * f32(EGB_SQ);     // where on a square's width the run starts
    late := ifx i % 50 == 49 then 8 else 0;
    if e2ct_trial(v[..], k, 2000000 + 2 * i, start, 5, 2 + late, true, out[..]) { landed += 1; }       // (a seat's requests are numbered upward)
    if e2ct_trial(v[..], k, 2000001 + 2 * i, start, 5, 2 + late, false, out[..]) { now += 1; }
  }
  #assert landed * 100 >= trials * 95;
  // judged at the present the wolf has run on: the same swings reach it in fewer than half the trials
  #assert now * 100 < trials * 50;
}

// An arrow's word (a, d: metaverse-engine/net/projectile.coax) to every placed seat within EG_VIEW m of (x, z).
e2ar_say :: (v: [] RmServer, k: int, text: string, x: f32, z: f32) {
  room := v[0].eg[k..<k + 1];
  for o: 0..<room[0].seat.count {
    st := room[0].seat[o..<o + 1];
    if !st[0].live || !st[0].placed || st[0].conn < 0 || e2mo_dist(st[0].pose.x, st[0].pose.z, x, z) > f32(EG_VIEW) { continue; }
    rl_queue(v, room[0].relay, st[0].conn, -1, text, "");
  }
}
