  w5 := egb_hero_of(EGB_WARLOCK, 5); d5 := egb_hero_of(EGB_DRUID, 5);
  #assert w5.level == 5 && w5.rebuke && d5.level == 5 && !d5.rebuke && d5.hp_max == rs_druid("Player", 0, 5).hp_max;
  #assert egb_hero_of(EGB_DRUID, 1).level == 1 && egb_hero_of(EGB_DRUID, 1).hp_max == rs_druid("Player", 0, 1).hp_max && egb_hero_of(EGB_WARLOCK, 1).level == 1;
  bb := egb_hero_of(EGB_CL0, 2);
  #assert bb.klass == RS_BARBARIAN && bb.level == 2 && bb.team == 0 && d.team == 0 && w.team == 0 && w5.team == 0 && d5.team == 0;
  #assert w5.agonizing == SP_ELDRITCH_BLAST && egb_hero_of(EGB_CL0 + FB_CL_FIGHTER, 2).team == 0;
  f := egb_hero_of(EGB_CL0 + FB_CL_FIGHTER, 2);
  #assert f.level == 2 && f.hp_max == fb_cl_hero(FB_CL_FIGHTER, "Player", 0, 2).hp_max;
  #assert egb_has(0) && egb_has(FB_EG_SLOTS - 1) && !egb_has(FB_EG_SLOTS) && !egb_has(-1);
  #assert egb_has(FB_WL0) && egb_has(FB_WL0 + FB_WL_SLOTS - 1) && !egb_has(FB_WL0 - 1) && !egb_has(FB_WL0 + FB_WL_SLOTS);
  #assert egb_has(FB_CL0) && egb_has(FB_CL0 + FB_CL_N - 1) && !egb_has(FB_CL0 - 1) && !egb_has(FB_CL0 + FB_CL_N);
  r: [1] EgBattle; egb_start(r[..], 1);
  #assert egb_entry(r[..], FB_WL0).sp == SP_ELDRITCH_BLAST && egb_entry(r[..], FB_WL0 + 1).sp == SP_FIREBALL;
  #assert egb_entry(r[..], 0).kind == r[0].bar[0].kind && egb_entry(r[..], 0).sp == r[0].bar[0].sp && egb_entry(r[..], 3).sp == r[0].bar[3].sp;
  #assert egb_entry(r[..], FB_CL0).kind == r[0].cbar[0].kind && egb_entry(r[..], FB_CL0).sp == r[0].cbar[0].sp && egb_entry(r[..], FB_CL0 + FB_CL_N - 1).sp == r[0].cbar[FB_CL_N - 1].sp;
  #assert egb_entry(r[..], FB_CL0 + 2).sp == r[0].cbar[2].sp && egb_entry(r[..], FB_CL0 + 2).kind == r[0].cbar[2].kind;
  #assert egb_helps(FbAb.{tg = FB_ALLY}) && egb_helps(FbAb.{tg = FB_ALLIES}) && egb_helps(FbAb.{tg = FB_SELF});
  #assert !egb_helps(FbAb.{kind = FB_ATTACK, tg = FB_FOE}) && !egb_helps(fb_spell(SP_FIREBALL, 3, FB_POINT));
  #assert egb_helps(fb_spell(SP_CURE_WOUNDS, 1, FB_FOE)) && !egb_helps(FbAb.{kind = FB_ATTACK, sp = SP_CURE_WOUNDS, tg = FB_FOE});
}
#test "battle: a fresh room, a seat sat and left, its familiar's creature kept, and where a seat stands" #steps 4000000000 {
  r: [1] EgBattle;
  none: [8] f32;
  #assert egb_events(r[..], none[..]) == 0;   // not started: nothing
  egb_join(r[..], 0, 0, 0, EGB_DRUID, 0); egb_place(r[..], 0, 0, 0); egb_step(r[..], 1); egb_leave(r[..], 0);
  #assert !r[0].live[0] && r[0].b[0].n == 0 && r[0].b[0].clock == 0;   // nothing before it starts
  egb_start(r[..], 5);
  b := r[0].b[..];
  #assert r[0].started && r[0].next_id == 1 && !r[0].familiar_ready && b[0].n == EGB_SEATS + EGB_BEASTS && b[0].who == -1;
  // the dice: the seed's, then each creature's initiative as it is added
  ref: [1] RsBattle; ref[0].dice[0].state = cast(u64) 5 * 7919 + 3; _ := rs_set_world(ref[..], RS_EVERGLADE_WORLD);
  for q: 0..<EGB_SEATS + EGB_BEASTS {
    o := ifx q < EGB_SEATS then fb_everglade_hero("Player", 0) else rs_monster(MON_WOLF, "Wolf", EGB_BEAST_TEAM);
    o.hp = 0; o.dead = true; _ = rs_add(ref[..], o, EGB_AWAY, EGB_AWAY);
  }
  rs_begin(ref[..]);
  #assert b[0].dice[0].state == ref[0].dice[0].state && b[0].c[0].turn_at == ref[0].c[0].turn_at && b[0].c[EGB_BEAST0 + 7].turn_at == ref[0].c[EGB_BEAST0 + 7].turn_at;
  #assert b[0].walk == RS_WALK_RATE && b[0].walk == ref[0].walk;
  #assert b[0].c[0].dead && b[0].c[EGB_SEATS - 1].dead && b[0].c[EGB_BEAST0].dead && b[0].c[EGB_BEAST0 + EGB_BEASTS - 1].dead;
  #assert b[0].c[0].x == EGB_AWAY && b[0].c[EGB_BEAST0].team == EGB_BEAST_TEAM && b[0].c[EGB_BEAST0].hp == 0 && b[0].c[0].hp == 0;
  #assert r[0].seat[3].me == 3 && r[0].seat[EGB_SEATS - 1].me == EGB_SEATS - 1 && r[0].klass[2] == 0 && !r[0].live[0] && !r[0].live[EGB_SEATS - 1];
  #assert r[0].seen == b[0].book[0].seq && r[0].bar[0].sp == SP_EG_METEOR_SWARM;
  #assert r[0].wbar[0].sp == SP_ELDRITCH_BLAST && r[0].cbar[0].kind == fb_cl_ability(0).kind && r[0].cbar[FB_CL_N - 1].sp == fb_cl_ability(FB_CL_N - 1).sp;
  for k: 0..<RS_ZONES { #assert !b[0].zone[k].on; }
  #assert b[0].truth_zones == 0;
  // the familiars: one creature a seat, after the rest, once
  egb_reset_familiar(r[..], 0);   // none yet: nothing
  egb_enable_familiars(r[..]);
  #assert r[0].familiar_ready && b[0].n == EGB_SEATS * 2 + EGB_BEASTS && r[0].familiar[0].me == EGB_SEATS + EGB_BEASTS && r[0].familiar[EGB_SEATS - 1].me == b[0].n - 1;
  #assert b[0].c[r[0].familiar[0].me].familiar_owner == 1 && b[0].c[b[0].n - 1].familiar_owner == EGB_SEATS && b[0].c[b[0].n - 1].dead && b[0].c[b[0].n - 1].x == -1 && b[0].c[b[0].n - 1].y == -1;
  egb_enable_familiars(r[..]);
  #assert b[0].n == EGB_SEATS * 2 + EGB_BEASTS;
  // a seat sits: its class, a fresh character, where it stands
  b[0].clock = 4; b[0].c[2].turn_at = 9; b[0].c[2].round_at = 3; b[0].c[1].turn_at = 1;
  egb_join(r[..], 2, f32(EGB_X0) + 1.53, f32(EGB_X0) + 4.6, EGB_CL0 + FB_CL_FIGHTER, 3);
  #assert r[0].live[2] && r[0].klass[2] == EGB_CL0 + FB_CL_FIGHTER && b[0].c[2].level == 3 && !b[0].c[2].dead && b[0].c[2].hp == b[0].c[2].hp_max;
  #assert b[0].c[2].turn_at == 9 && b[0].c[2].round_at == 3 && b[0].c[2].x == 1 && b[0].c[2].y == 355 && r[0].seat[2].me == 2;
  egb_join(r[..], 1, 0, 0, EGB_WARLOCK, 5);
  #assert b[0].c[1].turn_at == 4 && b[0].c[1].level == 17 && r[0].klass[1] == EGB_WARLOCK;   // the turn no earlier than now; the Warlock's own level
  r[0].seat[4].open = true;
  b[0].c[4].conc = SP_CONJURE_ANIMALS;
  b[0].c[EGB_BEAST0 + 9] = rs_monster(MON_WOLF, "Wolf", EGB_BEAST_TEAM); r[0].beasts[9] = EgBeast.{id = 30, tag = 30, by = 4, spell = SP_CONJURE_ANIMALS};
  egb_join(r[..], 4, 0, 0, EGB_CL0, 3);
  #assert b[0].c[4].level == 3 && b[0].c[4].klass == RS_BARBARIAN && !r[0].seat[4].open && r[0].beasts[9].id == 0;   // the last player's summons end with it
  egb_join(r[..], 3, 0, 0, 99, 4);
  #assert r[0].klass[3] == EGB_DRUID && b[0].c[3].hp_max == fb_everglade_hero("Player", 0).hp_max;
  egb_join(r[..], -1, 0, 0, EGB_WARLOCK, 0); egb_join(r[..], EGB_SEATS, 0, 0, EGB_WARLOCK, 0);
  #assert !r[0].live[0];
  egb_place(r[..], 2, f32(EGB_X0) + 4.6, f32(EGB_X0) + 1.53);
  #assert b[0].c[2].x == 3 && b[0].c[2].y == 353;
  egb_place(r[..], 0, 0, 0); egb_place(r[..], -1, 0, 0); egb_place(r[..], EGB_SEATS, 0, 0);
  #assert b[0].c[0].x == EGB_AWAY;
  egb_join(r[..], 0, 0, 0, EGB_DRUID, 0);
  egb_place(r[..], 0, f32(EGB_X0) + 4.6, f32(EGB_X0) + 1.53);
  #assert b[0].c[0].x == 3 && b[0].c[0].y == 353;
  egb_join(r[..], EGB_SEATS - 1, 0, 0, EGB_DRUID, 0);
  egb_place(r[..], EGB_SEATS - 1, f32(EGB_X0) + 4.6, f32(EGB_X0) + 1.53);
  #assert b[0].c[EGB_SEATS - 1].x == 3;
  egb_leave(r[..], 0); egb_leave(r[..], EGB_SEATS - 1);
  #assert !r[0].live[0] && b[0].c[0].x == EGB_AWAY && !r[0].live[EGB_SEATS - 1];
  // a seat leaves: away, its familiar retired
  f := r[0].familiar[2].me;
  b[0].c[f].dead = false; b[0].c[f].hp = 3; b[0].c[f].x = 5;
  r[0].familiar[2].open = true;
  egb_leave(r[..], 2);
  #assert !r[0].live[2] && b[0].c[2].x == EGB_AWAY && b[0].c[2].y == EGB_AWAY && !r[0].familiar[2].open && r[0].familiar[2].me == f && b[0].c[f].dead;
  egb_leave(r[..], 2); egb_leave(r[..], -1); egb_leave(r[..], EGB_SEATS);
  #assert r[0].live[1] && r[0].live[3];
  // a seat taken again: its familiar retired too
  b[0].c[r[0].familiar[1].me].dead = false; r[0].familiar[1].open = true;
  egb_join(r[..], 1, 0, 0, EGB_DRUID, 0);
  #assert !r[0].familiar[1].open && b[0].c[r[0].familiar[1].me].dead;
}
#test "battle: no room for the familiars, no familiars" {
