#authority;
#load "tests/battle-fixture.coax" #test;   // its checks' helpers, kept out of its mutants
// Everglade II's battle in a room (#13346): who the room's combatants are, where they stand on the
// grid, and the room's step of aethyr's SRD battle (rules/srd/battle.coax). It decides combat,
// so it is #authority and every procedure here has a check that runs it. It loads only its checks'
// helpers: the room loads it beside the rules (coax/web/room/room.coax); coax/web/room/battle-check.coax
// loads it alone with them for its checks and its mutants.
//
// The layout: seat s is creature EGB_SEAT + s; summoned creature q (a guard on patrol, a monster of
// the wild) is creature EGB_BEAST0 + q; each seat's familiar takes one creature after those
// (egb_enable_familiars). Who an event names goes on the wire as a TGT code (spec 3.6): a seat 1000 +
// s, a creature 2000 + its id. The grid: 5-foot squares from (EGB_X0, EGB_X0) metres, EGB_SIDE a side,
// and EGB_Z_SHIFT more squares south for Everglade II's land below the old origin.
//
// It replaces v1's everglade5e-room-rules.coax for the room. v1's townsfolk, its raid and forge
// orders, Finger of Death's risen Zombies and a summoned pack's chase took no part in an Everglade II
// room and are not here (docs/decisions/0005-production-room-runs-everglade-ii.md).

EGB_SEATS :: 16;
EGB_SEAT :: 0;                                // seat s is creature s (here written s alone)
EGB_BEASTS :: 96;                             // creatures at once: guards and monsters
EGB_BEAST0 :: EGB_SEATS;                      // creature q is creature EGB_BEAST0 + q
EGB_EV_FLOATS :: 8;                           // kind, spell, by, to, amount, damage, x, z (metres)
EGB_TGT_SEAT :: 1000;
EGB_TGT_BEAST :: 2000;
EGB_SQ :: 1.524;                              // a 5-foot square, in metres
EGB_X0 :: -110.0;                             // the grid's corner (square 0, 0), in metres
EGB_SIDE :: 145;                              // squares a side
EGB_Z_SHIFT :: 352;                           // squares south of the old origin, through the -640 m terrain edge
EGB_NEVER :: -100000000;                      // a beast's clock before its first blow, Dash or shot: 100 seconds before the battle began, in ticks
EGB_AWAY :: -1000;                            // the square of one who isn't here
EGB_DRUID :: 0; EGB_WARLOCK :: 1; EGB_CL0 :: 2;   // a seat's class: the druid, the Warlock, then Character Create's (EGB_CL0 + FB_CL_*)
EGB_FORM_WOLF :: 1;                           // a monster's form (everglade/server/creatures.coax E2M_FORM)
EGB_BEAST_TEAM :: 2;                          // neither the players' (0) nor the town's (1): all can hurt it
EGB_RUN :: 9.0;                               // m/s a beast runs
EGB_REACH :: 1.8;                             // m: a bite's 5 feet, from middle to middle
EGB_SHOOT_FROM_FT :: 35;                      // feet from which a patrolling guard shoots rather than Dashes (past 30)

// A creature of the room's: its id while on (0 off; 2000 + id names it), its last id (kept for the
// events that tell of it after it goes), the seat that made it (-1 none), its spell and form, where
// it is (metres; y the ground's, the host's), where it is sent and whom it is set on (a creature, -1
// none), and its patrol's clocks (the battle's): its last blow, Dash and ranged attack.
EgBeast :: struct {
  id: int; tag: int;
  by: int; spell: int; form: int;
  x: f32; y: f32; z: f32; yaw: f32; moving: bool; grounded: bool;
  goal_x: f32; goal_z: f32; foe: int = -1;
  bite_at: int;                               // ticks of the battle's clock, as the three below
  swing: int = EGB_NEVER; dash_at: int = EGB_NEVER; shot_at: int = EGB_NEVER;
  patrol: bool;                               // a patrolling guard (everglade/server/guard.coax): its room walks it, egb_patrol_turn strikes
  wild: bool;                                 // a monster (everglade/server/creatures.coax): its room moves it and strikes for it
}
EgBattle :: struct {
  b: [1] RsBattle;
  z_shift: int;
  seat: [EGB_SEATS] FbSeat;
  live: [EGB_SEATS] bool;
  familiar: [EGB_SEATS] FbSeat;
  familiar_ready: bool;
  bar: [FB_EG_SLOTS] FbAb;
  wbar: [FB_WL_SLOTS] FbAb;                   // the Warlock's bar: slots FB_WL0 + k
  cbar: [FB_CL_N] FbAb;                       // Character Create's classes' abilities: slots FB_CL0 + class
  klass: [EGB_SEATS] int;
  beasts: [EGB_BEASTS] EgBeast;
  seen: int;
  started: bool;
  pvp: bool;                                  // the realm's pvp row (room-control.coax): harm reaches other players too
  next_id: int;                               // the next creature's id (everglade/server/guard.coax, creatures.coax)
}

// ---- the grid
egb_sq :: (m: f32) -> int #effects(all) { return cast(int) floor((m - f32(EGB_X0)) / f32(EGB_SQ)); }
egb_cell_m :: (q: int) -> f32 #effects(all) { return f32(EGB_X0) + (f32(q) + 0.5) * f32(EGB_SQ); }
egb_z_cell :: (r: [] EgBattle, z: f32) -> int #effects(all) { return egb_sq(z) + r[0].z_shift; }
egb_cell_z :: (r: [] EgBattle, y: int) -> f32 #effects(all) { return egb_cell_m(y - r[0].z_shift); }

// ---- who a TGT code names
// A creature's TGT code: a seat's 1000 + s, a creature's 2000 + its last id, -1 for none.
egb_tgt :: (r: [] EgBattle, i: int) -> int #effects(all) {
  if i >= 0 && i < EGB_SEATS { return EGB_TGT_SEAT + i; }
  if i >= EGB_BEAST0 && i < EGB_BEAST0 + EGB_BEASTS { t := r[0].beasts[i - EGB_BEAST0].tag; return ifx t > 0 then EGB_TGT_BEAST + t else -1; }
  return -1;
}
// The creature a TGT code names (a seat, or a creature on now), -1 for none.
egb_of_tgt :: (r: [] EgBattle, t: int) -> int #effects(all) {
  if t >= EGB_TGT_SEAT && t < EGB_TGT_SEAT + EGB_SEATS { return t - EGB_TGT_SEAT; }
  if t <= EGB_TGT_BEAST { return -1; }
  for q: 0..<EGB_BEASTS { if r[0].beasts[q].id == t - EGB_TGT_BEAST { return EGB_BEAST0 + q; } }
  return -1;
}

// ---- the classes and bars
egb_klass_ok :: (klass: int) -> int #effects(all) { return ifx klass < EGB_CL0 + FB_CL_N then rs_max(klass, EGB_DRUID) else EGB_DRUID; }
// The class the hello's KIND names: "warlock" the Warlock, a Character Create class's kind its class,
// else the druid.
egb_klass_of :: (kind: string) -> int #effects(all) {
  if kind == "warlock" { return EGB_WARLOCK; }
  c := fb_cl_of_kind(kind);
  return ifx c >= 0 then EGB_CL0 + c else EGB_DRUID;
}
// Class klass's character at `level` (0: Everglade's own druid and level 17 Warlock; a Character
// Create class is the SRD class at that level, at least 1).
egb_hero_of :: (klass: int, level: int) -> RsCreature #effects(all) {
  if klass >= EGB_CL0 { return fb_cl_hero(klass - EGB_CL0, "Player", 0, level); }
  if level <= 0 { return ifx klass == EGB_WARLOCK then fb_warlock_hero("Player", 0) else fb_everglade_hero("Player", 0); }
  if klass == EGB_WARLOCK { c := rs_warlock("Player", 0, level, SP_ELDRITCH_BLAST); c.rebuke = true; return c; }
  return rs_druid("Player", 0, level);
}
// Whether bar slot k has an entry: the druid's bar (0 to FB_EG_SLOTS - 1), the Warlock's (FB_WL0 on),
// Character Create's (FB_CL0 on).
egb_has :: (k: int) -> bool #effects(all) { return (k >= 0 && k < FB_EG_SLOTS) || (k >= FB_WL0 && k < FB_WL0 + FB_WL_SLOTS) || (k >= FB_CL0 && k < FB_CL0 + FB_CL_N); }
// Bar slot k's entry; egb_has(k) first.
egb_entry :: (r: [] EgBattle, k: int) -> FbAb #effects(all) { return ifx k >= FB_CL0 then r[0].cbar[k - FB_CL0] else ifx k >= FB_WL0 then r[0].wbar[k - FB_WL0] else r[0].bar[k]; }
// Whether ability a heals or helps (and so reaches other players), else it only harms.
egb_helps :: (a: FbAb) -> bool #effects(all) {
  if a.tg == FB_ALLY || a.tg == FB_ALLIES || a.tg == FB_SELF { return true; }
  if a.kind != FB_SPELL { return false; }
  s := rs_spell(a.sp);
  for q: 0..<s.step_n { if s.steps[q].kind == RS_S_HEAL { return true; } }
  return false;
}

// ---- the room's battle
// A new room's battle: every seat empty, every creature off, the grid Everglade II's.
egb_start :: (r: [] EgBattle, seed: int) #effects(all) {
  b := r[0].b[..];
  b[0].n = 0; b[0].clock = 0; b[0].w = EGB_SIDE;   // who's turn: none (rs_begin)
  b[0].h = EGB_SIDE + EGB_Z_SHIFT;
  _ := rs_set_world(b, RS_EVERGLADE_WORLD);   // every declared deviation: world-profile.coax
  for k: 0..<RS_ZONES { b[0].zone[k].on = false; }
  b[0].truth_zones = 0;
  b[0].dice[0].state = cast(u64) seed * 7919 + 3;
  for s: 0..<EGB_SEATS {
    o := fb_everglade_hero("Player", 0);
    o.hp = 0; o.dead = true;
    _ = rs_add(b, o, EGB_AWAY, EGB_AWAY);
    r[0].live[s] = false;
  }
  for q: 0..<EGB_BEASTS {
    o := rs_monster(MON_WOLF, "Wolf", EGB_BEAST_TEAM);
    o.hp = 0; o.dead = true;
    _ = rs_add(b, o, EGB_AWAY, EGB_AWAY);
    r[0].beasts[q] = EgBeast.{};
  }
  rs_begin(b);
  for s: 0..<EGB_SEATS { r[0].seat[s] = FbSeat.{me = s}; }
  _ = fb_everglade(r[0].bar[..]);
  _ = fb_warlock_bar(r[0].wbar[..]);
  _ = fb_cl_bar(r[0].cbar[..]);
  for s: 0..<EGB_SEATS { r[0].klass[s] = 0; }
  r[0].seen = b[0].book[0].seq;
  r[0].started = true;
  r[0].next_id = 1;
  r[0].familiar_ready = false;
  r[0].z_shift = EGB_Z_SHIFT;
}
// One stable creature for each seat's familiar, after the rest; once.
egb_enable_familiars :: (r: [] EgBattle) #effects(all) {
  if r[0].familiar_ready { return; }
  b := r[0].b[..];
  if b[0].n + EGB_SEATS > b[0].c.count { return; }
  for s: 0..<EGB_SEATS {
    f := b[0].n;
    b[0].c[f] = RsCreature.{dead = true, familiar_owner = s + 1, x = -1, y = -1};
    b[0].n += 1;
    r[0].familiar[s] = FbSeat.{me = f};
  }
  r[0].familiar_ready = true;
}
egb_reset_familiar :: (r: [] EgBattle, s: int) #effects(all) {
  if !r[0].familiar_ready { return; }
  f := r[0].familiar[s].me;
  rs_familiar_retire(r[0].b[..], f);
  r[0].familiar[s] = FbSeat.{me = f};
}
// Seat s's Wild Companion (bar slot `slot`) in form `form` at square (x, y): whether it came.
egb_wild_companion :: (r: [] EgBattle, s: int, slot: int, form: int, x: int, y: int) -> bool #effects(all) {
  if !r[0].familiar_ready || s < 0 || s >= EGB_SEATS || !r[0].live[s] { return false; }
  b := r[0].b[..]; seat := r[0].seat[s..<s + 1];
  if !seat[0].open { return false; }
  fb_seat_in(b, seat);
  ok := rs_wild_companion(b, s, slot, form, x, y);
  fb_seat_out(b, seat);
  return ok;
}
// A player sits at seat s as class klass at `level` (a Character Create class: 1 to 6, its hello's
// srd-CLASS-LEVEL, #13046; else 0), at (x, z): a fresh character, full Hit Points.
egb_join :: (r: [] EgBattle, s: int, x: f32, z: f32, klass: int, level: int) #effects(all) {
  if !r[0].started || s < 0 || s >= EGB_SEATS { return; }
  b := r[0].b[..];
  i := s;
  t := b[0].c[i].turn_at; ro := b[0].c[i].round_at;
  egb_reset_familiar(r, s);
  r[0].klass[s] = egb_klass_ok(klass);
  b[0].c[i] = egb_hero_of(r[0].klass[s], ifx r[0].klass[s] >= EGB_CL0 then level else 0);
  b[0].c[i].turn_at = rs_max(t, b[0].clock); b[0].c[i].round_at = ro;
  b[0].c[i].x = egb_sq(x); b[0].c[i].y = egb_z_cell(r, z);
  r[0].seat[s] = FbSeat.{me = i};
  r[0].live[s] = true;
  // the seat's last player's spells end with the new one (its Concentration is the new caster's)
  egb_beasts_check(r);
}
// The player at seat s left the battle. What it concentrates on stays until the spell would end
// (spec 6.3), or until someone else takes the seat: leaving is not lethal damage.
egb_leave :: (r: [] EgBattle, s: int) #effects(all) {
  if !r[0].started || s < 0 || s >= EGB_SEATS || !r[0].live[s] { return; }
  b := r[0].b[..];
  i := s;
  b[0].c[i].x = EGB_AWAY; b[0].c[i].y = EGB_AWAY;
  r[0].live[s] = false;
  egb_reset_familiar(r, s);
}
// Where seat s stands now (metres).
egb_place :: (r: [] EgBattle, s: int, x: f32, z: f32) #effects(all) {
  if !r[0].started || s < 0 || s >= EGB_SEATS || !r[0].live[s] { return; }
  i := s;
  r[0].b[0].c[i].x = egb_sq(x); r[0].b[0].c[i].y = egb_z_cell(r, z);
}
// The room's clock on to `clock` (seconds): the engine's tick, each seat's and familiar's step, each
// creature's turn when due (a patrolling guard's strikes in it), then whatever ended goes. (v1's bar
// zones never start in an Everglade II room: its casts are everglade/shared/cast-rules.coax's, #13346.)
// `clock` is the room's time in the battle's ticks (rs_secs, RS_TICKS a second): whole numbers, so
// a room up for a month steps as exactly as a new one (#13287).
egb_step :: (r: [] EgBattle, clock: int) #effects(all) {
  if !r[0].started { return; }
  b := r[0].b[..];
  dt := clock - b[0].clock;
  if dt <= 0 { return; }
  rs_tick_ticks(b, dt);
  for s: 0..<EGB_SEATS {
    if !r[0].live[s] { continue; }
    fb_seat_step(b, r[0].seat[s..<s + 1]);
    if r[0].familiar_ready { fb_seat_step(b, r[0].familiar[s..<s + 1]); }
  }
  // each creature read in place, not copied whole, every tick
  for q: 0..<EGB_BEASTS {
    i := EGB_BEAST0 + q;
    if r[0].beasts[q].id == 0 || b[0].c[i].dead || b[0].c[i].turn_at > b[0].clock { continue; }
    rs_start_turn(b, i);   // its turn: whose (b[0].who) until it ends
    if r[0].beasts[q].patrol { egb_patrol_turn(r, q); }
    rs_end_turn(b, i);
  }
  egb_beasts_check(r);
}
// A patrolling guard's turn (everglade/server/guard.coax walks it): an Attack action at the creature it
// is set on, its own stat block's weapon through the shared attack (Extra Attack's blows with it), once
// the room has brought it within reach. It never chooses a foe: the room sets one only on a creature
// that harmed it. `swing` keeps the battle's clock of its last blow, which the room tells the pages.
egb_patrol_turn :: (r: [] EgBattle, q: int) #effects(all) {
  bt := r[0].beasts[q..<q + 1]; b := r[0].b[..]; i := EGB_BEAST0 + q;
  foe := bt[0].foe;
  if foe < 0 { return; }
  if foe >= b[0].n || b[0].c[foe].dead || b[0].c[foe].hp <= 0 || b[0].c[foe].x == EGB_AWAY { bt[0].foe = -1; return; }
  // a Fighter's: Second Wind below half its Hit Points, and its Action Surge for a second Attack
  // action while the foe still stands (a stat block without them does neither)
  if b[0].c[i].hp * 2 < b[0].c[i].hp_max { _ := rs_second_wind(b, i); }
  // out of reach: far off, his ranged weapon (its Attack action; none, none shot); nearer, the Dash
  // action to close (the room runs him faster while it lasts: everglade/server/guard.coax E2G_DASH)
  if rs_feet_to(b, i, foe) > rs_weapon(b[0].c[i].weapon).reach_ft {
    if rs_feet_to(b, i, foe) >= EGB_SHOOT_FROM_FT && rs_shoot(b, i, foe) { bt[0].shot_at = b[0].clock; return; }
    if rs_dash(b, i) { bt[0].dash_at = b[0].clock; }
    return;
  }
  was := b[0].turn.action;
  _ := rs_attack_action(b, i, foe);
  if rs_up(b[0].c[foe]) && rs_action_surge(b, i) { _ = rs_attack_action(b, i, foe); }
  if b[0].turn.action && !was { bt[0].swing = b[0].clock; }
}
// Creature q is gone: off the list, its creature dead and away.
egb_beast_gone :: (r: [] EgBattle, q: int) #effects(all) {
  r[0].beasts[q].id = 0;
  i := EGB_BEAST0 + q;
  b := r[0].b[..];
  b[0].c[i].dead = true; b[0].c[i].hp = 0; b[0].c[i].x = EGB_AWAY; b[0].c[i].y = EGB_AWAY;
}
// A creature at 0 Hit Points goes, and so does one a seat summoned whose Concentration on its spell
// ended. A guard on patrol and a monster are the room's: only their Hit Points end them.
egb_beasts_check :: (r: [] EgBattle) #effects(all) {
  b := r[0].b[..];
  for q: 0..<EGB_BEASTS {
    if r[0].beasts[q].id == 0 { continue; }   // read in place: most are off
    bt := r[0].beasts[q];
    i := EGB_BEAST0 + q;
    held := bt.patrol || bt.wild || b[0].c[rs_max(bt.by, 0)].conc == bt.spell;
    if b[0].c[i].dead || b[0].c[i].hp <= 0 || !held { egb_beast_gone(r, q); }
  }
}
// Seat s ends what bar slot k holds up: its concentration, when that is k's spell. Whether it did.
egb_end :: (r: [] EgBattle, s: int, k: int) -> bool #effects(all) {
  if !r[0].started || s < 0 || s >= EGB_SEATS || !r[0].live[s] || !egb_has(k) { return false; }
  b := r[0].b[..];
  i := s;
  a := egb_entry(r, k);
  if a.kind != FB_SPELL || b[0].c[i].conc < 0 || b[0].c[i].conc != a.sp { return false; }
  rs_end_concentration(b, i, " (ended)");
  egb_beasts_check(r);
  return true;
}
// Damage the world dealt (a guard's blade, a fall): to the creature TGT code `who` names, by the one
// `by` names (one that names nobody: the creature itself), so the hit event names who struck.
egb_hurt :: (r: [] EgBattle, who: int, amount: int, by: int) #effects(all) {
  hits := [1] EgbDamage.[EgbDamage.{who = egb_of_tgt(r, who), by = egb_of_tgt(r, by), amount = amount}];
  switch egb_damage_many(r[0].b[..], hits[..]) { case none {} case some(applied) {} }
}
EgbDamage :: struct { who: int; by: int; amount: int; }
// The world's damage in one undo scope: a batch that names a target it can't hurt (none, or no
// damage) is refused whole, before any of it lands. One that names no striker is its own.
egb_damage_many :: (b: [] RsBattle, hits: [] const EgbDamage) -> bool? #effects(all) {
  // refused before the undo scope opens: a room calls this every tick, mostly with nothing to deal
  for hit: hits { if hit.who < 0 || hit.who >= b[0].n || hit.amount <= 0 { return null; } }
  #transaction {
    for hit: hits {
      by := ifx hit.by >= 0 && hit.by < b[0].n then hit.by else hit.who;
      rs_world_damage(b, by, hit.who, hit.amount);
    }
  }
  return some(true);
}
// ---- what the room reads
// Seat s: hp, max, temp, conditions (the engine's, and its effects' as EGB_C_* bits), dead (0 or 1),
// concentration's spell (-1), then the seconds left on what holds it longest and that spell (-1 none).
EGB_OUT_FLOATS :: 8;
// The engine's effects as condition bits, after Everglade's WC_SLOWED (everglade-wire.coax WC_HALTED...).
EGB_C_HALTED :: 131072;     // Command's Halt: it doesn't move and takes no action
EGB_C_BANED :: 262144; EGB_C_BLESSED :: 524288; EGB_C_FAITH :: 1048576; EGB_C_ENFEEBLED :: 2097152; EGB_C_HEXED :: 4194304;
egb_seat_out :: (r: [] EgBattle, s: int, out: [] f32) #effects(all) {
  if s < 0 || s >= EGB_SEATS || out.count < EGB_OUT_FLOATS { return; }
  b := r[0].b[..]; i := s;
  out[0] = f32(b[0].c[i].hp); out[1] = f32(b[0].c[i].hp_max); out[2] = f32(b[0].c[i].temp); out[3] = f32(b[0].c[i].cond | egb_effect_bits(b, i));
  out[4] = ifx b[0].c[i].dead then 1.0f32 else 0.0f32; out[5] = f32(b[0].c[i].conc);
  sp: [1] int;
  out[6] = egb_hold_left(b, i, sp[..]); out[7] = f32(sp[0]);
}
// Creature i's effects as EGB_C_* bits.
egb_effect_bits :: (b: [] RsBattle, i: int) -> int #effects(all) {
  n := 0;
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k].kind;
    if e == EF_HALT { n = n | EGB_C_HALTED; }
    if e == EF_BANE { n = n | EGB_C_BANED; }
    if e == EF_BLESS { n = n | EGB_C_BLESSED; }
    if e == EF_FAITH { n = n | EGB_C_FAITH; }
    if e == EF_ENFEEBLED { n = n | EGB_C_ENFEEBLED; }
    if e == EF_HEX { n = n | EGB_C_HEXED; }
  }
  return n;
}
// The seconds left on what holds creature i longest, its spell into sp[0] (-1, 0 s none): what stops
// it first (Command's Halt, Hold Person's paralysis), else a curse (Bane, Ray of Enfeeblement, Hex),
// else a blessing (Bless, Shield of Faith).
egb_hold_left :: (b: [] RsBattle, i: int, sp: [] int) -> f32 #effects(all) {
  sp[0] = -1;
  best := 0; rank := 1;
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k];
    if e.until <= b[0].clock { continue; }
    rk := egb_hold_rank(e);
    left := e.until - b[0].clock;
    if rk > rank || (rk == rank && left > best) { rank = rk; best = left; sp[0] = e.spell; }
  }
  return rs_ticks_s(best);
}
// How an effect ranks for egb_hold_left: 3 what stops it, 2 a curse, 1 a blessing, 0 none shown.
egb_hold_rank :: (e: RsEffect) -> int #effects(all) {
  if e.kind == EF_HALT || (e.kind == EF_COND && (e.cond & (RS_PARALYZED | RS_RESTRAINED | RS_STUNNED)) != 0) { return 3; }
  if e.kind == EF_BANE || e.kind == EF_ENFEEBLED || e.kind == EF_HEX { return 2; }
  if e.kind == EF_BLESS || e.kind == EF_FAITH { return 1; }
  return 0;
}
// Creature q: its id (0 when off), then into out: x, y, z (metres), yaw, hp, max, the seat that made
// it, its form, 1 while it runs, 1 once its y is the ground's.
EGB_BEAST_FLOATS :: 10;
egb_beast :: (r: [] EgBattle, q: int, out: [] f32) -> int #effects(all) {
  if q < 0 || q >= EGB_BEASTS || r[0].beasts[q].id == 0 || out.count < EGB_BEAST_FLOATS { return 0; }
  bt := r[0].beasts[q];
  c := r[0].b[0].c[EGB_BEAST0 + q];
  out[0] = bt.x; out[1] = bt.y; out[2] = bt.z; out[3] = bt.yaw; out[4] = f32(c.hp); out[5] = f32(c.hp_max);
  out[6] = f32(bt.by); out[7] = f32(bt.form); out[8] = ifx bt.moving then 1.0f32 else 0.0f32; out[9] = ifx bt.grounded then 1.0f32 else 0.0f32;
  return bt.id;
}
// The ground's height under creature q (the host's world knows it).
egb_beast_ground :: (r: [] EgBattle, q: int, y: f32) #effects(all) {
  if q < 0 || q >= EGB_BEASTS || r[0].beasts[q].id == 0 { return; }
  r[0].beasts[q].y = y; r[0].beasts[q].grounded = true;
}
// The engine's events since the last call, oldest first, EGB_EV_FLOATS each (kind RS_EV_*, spell, by
// and to as TGT codes, amount, damage type, the square's x and z in metres): how many fit.
egb_events :: (r: [] EgBattle, out: [] f32) -> int #effects(all) {
  if !r[0].started { return 0; }
  b := r[0].b[..];
  unread := rs_min(b[0].book[0].seq - r[0].seen, RS_EVENTS);
  r[0].seen = b[0].book[0].seq;
  n := 0;
  q := unread - 1;
  while q >= 0 {
    e := rs_recent_at(b[0].book[..], q);
    q -= 1;
    if (n + 1) * EGB_EV_FLOATS > out.count { continue; }
    o := n * EGB_EV_FLOATS;
    out[o] = f32(e.kind); out[o + 1] = f32(e.spell); out[o + 2] = f32(egb_tgt(r, e.by)); out[o + 3] = f32(egb_tgt(r, e.to));
    out[o + 4] = f32(e.amount); out[o + 5] = f32(e.damage);
    out[o + 6] = egb_cell_m(e.x); out[o + 7] = egb_cell_z(r, e.y);
    n += 1;
  }
  return n;
}

// ---- checks
#test "battle: the grid's squares, Everglade II's shift south, and the TGT codes both ways" #steps 4000000000 {
  #assert egb_sq(f32(EGB_X0)) == 0 && egb_sq(f32(EGB_X0) - 0.01) == -1 && egb_sq(f32(EGB_X0) + 1.52) == 0 && egb_sq(f32(EGB_X0) + 1.53) == 1;
  #assert egb_sq(f32(EGB_X0) + 4.6) == 3;
  #assert abs(egb_cell_m(0) - (f32(EGB_X0) + 0.762)) < 0.0001 && abs(egb_cell_m(3) - (f32(EGB_X0) + 5.334)) < 0.0001;
  r: [1] EgBattle; egb_start(r[..], 1);
  #assert r[0].z_shift == 352 && r[0].b[0].h == EGB_SIDE + 352 && r[0].b[0].w == EGB_SIDE;
  #assert egb_z_cell(r[..], f32(EGB_X0) + 1.53) == 353 && abs(egb_cell_z(r[..], 355) - egb_cell_m(3)) < 0.0001;
  #assert egb_tgt(r[..], 0) == 1000 && egb_tgt(r[..], 15) == 1015 && egb_tgt(r[..], -1) == -1;
  #assert egb_tgt(r[..], EGB_BEAST0) == -1;   // never on: no last id
  r[0].beasts[1].tag = 1;
  #assert egb_tgt(r[..], EGB_BEAST0 + 1) == 2001;
  r[0].beasts[0].tag = 7; r[0].beasts[EGB_BEASTS - 1].tag = 3;
  #assert egb_tgt(r[..], EGB_BEAST0) == 2007 && egb_tgt(r[..], EGB_BEAST0 + EGB_BEASTS - 1) == 2003 && egb_tgt(r[..], EGB_BEAST0 + EGB_BEASTS) == -1;
  #assert egb_of_tgt(r[..], 1000) == 0 && egb_of_tgt(r[..], 1015) == 15 && egb_of_tgt(r[..], 999) == -1 && egb_of_tgt(r[..], 1016) == -1;
  #assert egb_of_tgt(r[..], 2007) == -1;   // its last id, but off now
  r[0].beasts[5].id = 9; r[0].beasts[EGB_BEASTS - 1].id = 4;
  #assert egb_of_tgt(r[..], 2009) == EGB_BEAST0 + 5 && egb_of_tgt(r[..], 2004) == EGB_BEAST0 + EGB_BEASTS - 1 && egb_of_tgt(r[..], 2010) == -1;
  r[0].beasts[6].id = 0;
  #assert egb_of_tgt(r[..], 2000) == -1;   // not an empty creature's 0
  r[0].beasts[0].id = 1;
  #assert egb_of_tgt(r[..], 2001) == EGB_BEAST0;
}
#test "battle: a seat's class and character from its hello, and the bars' slots" #steps 4000000000 {
  #assert egb_klass_of("warlock") == EGB_WARLOCK && egb_klass_of("druid") == EGB_DRUID && egb_klass_of("") == EGB_DRUID;
  #assert egb_klass_of("srd-fighter") == EGB_CL0 + FB_CL_FIGHTER && egb_klass_of("srd-barbarian") == EGB_CL0 && egb_klass_of("srd-wizard-3") == EGB_CL0 + FB_CL_WIZARD;
  #assert egb_klass_ok(EGB_WARLOCK) == EGB_WARLOCK && egb_klass_ok(-5) == EGB_DRUID && egb_klass_ok(EGB_CL0) == EGB_CL0;
  #assert egb_klass_ok(-1) == EGB_DRUID && egb_klass_ok(EGB_CL0 + FB_CL_N) == EGB_DRUID && egb_klass_ok(EGB_CL0 + FB_CL_N - 1) == EGB_CL0 + FB_CL_N - 1 && egb_klass_ok(EGB_WARLOCK) == EGB_WARLOCK;
  d := egb_hero_of(EGB_DRUID, 0); w := egb_hero_of(EGB_WARLOCK, 0);
