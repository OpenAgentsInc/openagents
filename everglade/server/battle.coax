  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  b[0].clock = 30; b[0].who = 5; b[0].zone[0].on = true; b[0].zone[RS_ZONES - 1].on = true; b[0].truth_zones = 2; b[0].w = 3; b[0].h = 4;
  r[0].beasts[0].id = 4; r[0].beasts[EGB_BEASTS - 1].id = 2; r[0].klass[0] = 5; r[0].klass[EGB_SEATS - 1] = 3; r[0].live[EGB_SEATS - 1] = true;
  r[0].next_id = 9; r[0].seen = -4; r[0].z_shift = 1; r[0].seat[0].me = 40; r[0].seat[EGB_SEATS - 1].me = 41; r[0].bar[0].sp = -2; r[0].wbar[0].sp = -2; r[0].cbar[0].sp = -2;
  egb_start(r[..], 1);
  #assert b[0].clock == 0 && b[0].who == -1 && !b[0].zone[0].on && !b[0].zone[RS_ZONES - 1].on && b[0].truth_zones == 0 && b[0].w == EGB_SIDE && b[0].h == EGB_SIDE + EGB_Z_SHIFT;
  #assert r[0].beasts[0].id == 0 && r[0].beasts[EGB_BEASTS - 1].id == 0 && r[0].klass[0] == 0 && r[0].klass[EGB_SEATS - 1] == 0 && !r[0].live[0] && !r[0].live[EGB_SEATS - 1];
  #assert r[0].next_id == 1 && r[0].seen == b[0].book[0].seq && r[0].z_shift == EGB_Z_SHIFT && r[0].seat[0].me == 0 && r[0].seat[EGB_SEATS - 1].me == EGB_SEATS - 1;
  #assert r[0].bar[0].sp == SP_EG_METEOR_SWARM && r[0].wbar[0].sp == SP_ELDRITCH_BLAST && r[0].cbar[0].sp == fb_cl_ability(0).sp && !r[0].familiar_ready && b[0].n == EGB_SEATS + EGB_BEASTS;
  #assert !b[0].c[0].dead || b[0].c[0].hp == 0;
  #assert b[0].c[0].dead && b[0].c[0].x == EGB_AWAY && b[0].c[0].y == EGB_AWAY && b[0].c[0].team == 0;
  q := EGB_BEAST0 + EGB_BEASTS - 1;
  #assert b[0].c[q].x == EGB_AWAY && b[0].c[q].y == EGB_AWAY && b[0].c[q].hp_max == rs_monster(MON_WOLF, "Wolf", 2).hp_max && b[0].c[q].team == EGB_BEAST_TEAM;
  #assert b[0].c[EGB_SEATS - 1].y == EGB_AWAY && b[0].c[EGB_SEATS - 1].x == EGB_AWAY;
}
#test "battle: what goes at a check: a dead or downed creature, and a summoned one whose Concentration ended" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  // 0: a guard; 1: a monster; 2: seat 0's summons on its spell; 3: on another spell; 4: no seat's (seat 0's
  // spell held); 5: a guard at 0 Hit Points; 6: a monster dead; 7: off
  for q: 0..<7 { b[0].c[EGB_BEAST0 + q] = rs_monster(MON_WOLF, "Wolf", EGB_BEAST_TEAM); r[0].beasts[q] = EgBeast.{id = q + 1, tag = q + 1, by = -1, spell = -1}; }
  b[0].c[EGB_BEAST0 + 1].hp = 1;   // 1 Hit Point: still up
  r[0].beasts[0].patrol = true; r[0].beasts[1].wild = true; r[0].beasts[5].patrol = true; r[0].beasts[6].wild = true;
  r[0].beasts[2].by = 0; r[0].beasts[2].spell = SP_CONJURE_ANIMALS; r[0].beasts[3].by = 0; r[0].beasts[3].spell = SP_BLESS;
  r[0].beasts[4].spell = SP_CONJURE_ANIMALS;
  b[0].c[0].conc = SP_CONJURE_ANIMALS;
  b[0].c[EGB_BEAST0 + 5].hp = 0; b[0].c[EGB_BEAST0 + 6].dead = true;
  egb_beasts_check(r[..]);
  #assert r[0].beasts[0].id == 1 && r[0].beasts[1].id == 2 && r[0].beasts[2].id == 3 && r[0].beasts[3].id == 0 && r[0].beasts[4].id == 5;
  #assert r[0].beasts[5].id == 0 && r[0].beasts[6].id == 0 && r[0].beasts[3].tag == 4;
  c := b[0].c[EGB_BEAST0 + 3];
  #assert c.dead && c.hp == 0 && c.x == EGB_AWAY && c.y == EGB_AWAY && !b[0].c[EGB_BEAST0 + 2].dead && b[0].c[EGB_BEAST0 + 2].hp > 0;
  // the summoner's Concentration ends: its creatures go; the room's stay
  b[0].c[0].conc = -1;
  egb_beasts_check(r[..]);
  #assert r[0].beasts[2].id == 0 && r[0].beasts[4].id == 0 && r[0].beasts[0].id == 1 && r[0].beasts[1].id == 2;
  egb_beast_gone(r[..], 1);
  #assert r[0].beasts[1].id == 0 && r[0].beasts[1].tag == 2 && b[0].c[EGB_BEAST0 + 1].dead && b[0].c[EGB_BEAST0 + 1].hp == 0 && b[0].c[EGB_BEAST0 + 1].x == EGB_AWAY && b[0].c[EGB_BEAST0 + 1].y == EGB_AWAY;
}
#test "battle: a seat ends the spell it concentrates on, from its bar" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  k := FB_WL0 + 2;   // a Warlock bar spell's slot
  sp := r[0].wbar[2].sp;
  #assert r[0].wbar[2].kind == FB_SPELL;
  b[0].c[0].conc = sp; b[0].c[0].conc_until = 60;
  b[0].c[EGB_BEAST0] = rs_monster(MON_WOLF, "Wolf", EGB_BEAST_TEAM); r[0].beasts[0] = EgBeast.{id = 1, tag = 1, by = 0, spell = sp};
  #assert !egb_end(r[..], 0, k + 1) && b[0].c[0].conc == sp;   // another spell's
  #assert !egb_end(r[..], 0, FB_EG_SLOTS) && !egb_end(r[..], -1, k) && !egb_end(r[..], EGB_SEATS, k) && !egb_end(r[..], 1, k);
  #assert b[0].c[0].conc == sp && r[0].beasts[0].id == 1;
  #assert egb_end(r[..], 0, k) && b[0].c[0].conc == -1 && r[0].beasts[0].id == 0;
  #assert !egb_end(r[..], 0, k);   // nothing held now
  // an Attack slot, though its sp matches
  b[0].c[0].conc = r[0].cbar[FB_CL_FIGHTER].sp;
  #assert r[0].cbar[FB_CL_FIGHTER].kind != FB_SPELL && !egb_end(r[..], 0, FB_CL0 + FB_CL_FIGHTER) && b[0].c[0].conc == r[0].cbar[FB_CL_FIGHTER].sp;
  b[0].c[0].conc = -1; r[0].wbar[2].sp = -1;
  #assert !egb_end(r[..], 0, k);   // conc -1 never matches a spell of -1
  b[0].c[0].conc = 0; r[0].wbar[2].sp = 0;
  #assert egb_end(r[..], 0, k) && b[0].c[0].conc == -1;   // spell 0 is a spell
  s: [1] EgBattle;
  #assert !egb_end(s[..], 0, k);   // not started
}
#test "battle: the world's damage names who struck, and a refused batch keeps nothing" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  egb_join(r[..], 1, 3, 0, EGB_CL0 + FB_CL_FIGHTER, 3);
  egb_join(r[..], 2, 6, 0, EGB_CL0 + FB_CL_FIGHTER, 3);
  hp := b[0].c[0].hp; seq := b[0].book[0].seq;
  egb_hurt(r[..], 1000, 0, 1001); egb_hurt(r[..], 1000, -2, 1001); egb_hurt(r[..], 999, 2, 1001); egb_hurt(r[..], 2001, 2, 1001);
  #assert b[0].c[0].hp == hp && b[0].book[0].seq == seq;
  egb_hurt(r[..], 1000, 1, 1001);
  #assert b[0].c[0].hp == hp - 1;
  out: [8 * RS_EVENTS] f32;
  _ := egb_events(r[..], out[..]);
  // to 0 Hit Points: the event names who struck
  egb_hurt(r[..], 1000, hp - 1, 1001);
  n := egb_events(r[..], out[..]);
  #assert b[0].c[0].hp == 0 && egb_test_down(out[..], n, 1001, 1000);
  egb_hurt(r[..], 1002, 500, 5);   // by nobody: the creature itself
  n = egb_events(r[..], out[..]);
  #assert b[0].c[2].hp == 0 && egb_test_down(out[..], n, 1002, 1002) && !egb_test_down(out[..], n, 1001, 1002);
  s: [1] EgBattle;
  egb_hurt(s[..], 1000, 2, 1001);
  #assert s[0].b[0].n == 0;
  // a batch: the second hit refused, the first undone
  hp1 := b[0].c[1].hp;
  bad := [2] EgbDamage.[EgbDamage.{who = 1, by = 0, amount = 2}, EgbDamage.{who = b[0].n, by = 0, amount = 2}];
  switch egb_damage_many(b, bad[..]) { case none {} case some(x) { #assert false; } }
  #assert b[0].c[1].hp == hp1;
  for w: [3] int.[-1, 1, 1] {
    one := [2] EgbDamage.[EgbDamage.{who = 1, by = 0, amount = 1}, EgbDamage.{who = w, by = 0, amount = ifx w < 0 then 1 else 0}];
    switch egb_damage_many(b, one[..]) { case none {} case some(x) { #assert false; } }
    #assert b[0].c[1].hp == hp1;
  }
  neg := [1] EgbDamage.[EgbDamage.{who = 1, by = 0, amount = -1}];
  switch egb_damage_many(b, neg[..]) { case none {} case some(x) { #assert false; } }
  #assert b[0].c[1].hp == hp1;
  ok := [2] EgbDamage.[EgbDamage.{who = 1, by = b[0].n, amount = 1}, EgbDamage.{who = 1, by = -1, amount = 1}];
  switch egb_damage_many(b, ok[..]) { case none { #assert false; } case some(x) { #assert x; } }
  #assert b[0].c[1].hp == hp1 - 2;
  _ = egb_events(r[..], out[..]);
  for by: [2] int.[-1, 99999] {
    b[0].c[1].hp = 1;
    down := [1] EgbDamage.[EgbDamage.{who = 1, by = ifx by > 0 then b[0].n else by, amount = 5}];
    switch egb_damage_many(b, down[..]) { case none { #assert false; } case some(x) {} }
    n = egb_events(r[..], out[..]);
    #assert egb_test_down(out[..], n, 1001, 1001);
  }
  b[0].c[1].hp = 1; b[0].c[1].dead = false;
  by0 := [1] EgbDamage.[EgbDamage.{who = 1, by = 0, amount = 5}];
  switch egb_damage_many(b, by0[..]) { case none { #assert false; } case some(x) {} }
  n = egb_events(r[..], out[..]);
  #assert egb_test_down(out[..], n, 1000, 1001);
  // bludgeoning, never a critical hit, no spell's
  egb_join(r[..], 3, 9, 0, EGB_CL0 + FB_CL_FIGHTER, 3);
  b[0].c[3].hp = 1; b[0].c[3].hp_max = 30;
  _ = egb_events(r[..], out[..]);
  egb_hurt(r[..], 1003, 3, 1001);
  n = egb_events(r[..], out[..]);
  spell_ok := false;
  for q: 0..<n { if out[q * 8] == f32(RS_EV_DOWN) && out[q * 8 + 1] == -1 { spell_ok = true; } }
  #assert b[0].c[3].hp == 0 && !b[0].c[3].dead && b[0].c[3].death_fail == 0 && spell_ok;
  egb_hurt(r[..], 1003, 1, 1001);
  #assert b[0].c[3].death_fail == 1;
  last := [1] EgbDamage.[EgbDamage.{who = b[0].n - 1, by = b[0].n - 1, amount = 1}];
  b[0].c[b[0].n - 1].hp = 5; b[0].c[b[0].n - 1].hp_max = 5; b[0].c[b[0].n - 1].dead = false;
  switch egb_damage_many(b, last[..]) { case none { #assert false; } case some(x) {} }
  #assert b[0].c[b[0].n - 1].hp == 4;
}
#test "battle: what a seat shows: its Hit Points, conditions, effects as bits and what holds it longest" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  out: [EGB_OUT_FLOATS] f32;
  for q: 0..<EGB_OUT_FLOATS { out[q] = -7; }
  egb_seat_out(r[..], -1, out[..]); egb_seat_out(r[..], EGB_SEATS, out[..]); egb_seat_out(r[..], 0, out[0..<EGB_OUT_FLOATS - 1]);
  #assert out[0] == -7 && out[EGB_OUT_FLOATS - 2] == -7;
  b[0].c[0].hp = 7; b[0].c[0].hp_max = 21; b[0].c[0].temp = 4; b[0].c[0].cond = RS_PRONE; b[0].c[0].conc = SP_BLESS;
  egb_seat_out(r[..], 0, out[..]);
  #assert out[0] == 7 && out[1] == 21 && out[2] == 4 && out[3] == f32(RS_PRONE) && out[4] == 0 && out[5] == f32(SP_BLESS) && out[6] == 0 && out[7] == -1;
  b[0].c[EGB_SEATS - 1].dead = true; b[0].c[EGB_SEATS - 1].hp = 0; b[0].c[EGB_SEATS - 1].hp_max = 9;
  egb_seat_out(r[..], EGB_SEATS - 1, out[..]);
  #assert out[0] == 0 && out[1] == 9 && out[4] == 1;
  // each effect's bit, one at a time
  kinds := [7] int.[EF_HALT, EF_BANE, EF_BLESS, EF_FAITH, EF_ENFEEBLED, EF_HEX, EF_WEAK];
  bits := [7] int.[EGB_C_HALTED, EGB_C_BANED, EGB_C_BLESSED, EGB_C_FAITH, EGB_C_ENFEEBLED, EGB_C_HEXED, 0];
  for q: 0..<7 {
    b[0].c[0].eff[RS_EFFECTS - 1] = RsEffect.{kind = kinds[q], until = 100};
    #assert egb_effect_bits(b, 0) == bits[q];
    b[0].c[0].eff[RS_EFFECTS - 1] = RsEffect.{};
  }
  #assert egb_effect_bits(b, 0) == 0;
  b[0].c[0].eff[0] = RsEffect.{kind = EF_BANE, until = 100}; b[0].c[0].eff[1] = RsEffect.{kind = EF_HEX, until = 100};
  #assert egb_effect_bits(b, 0) == EGB_C_BANED | EGB_C_HEXED;
  b[0].c[0].cond = RS_PRONE;
  egb_seat_out(r[..], 0, out[..]);
  #assert out[3] == f32(RS_PRONE | EGB_C_BANED | EGB_C_HEXED);
  for k: 0..<RS_EFFECTS { b[0].c[0].eff[k] = RsEffect.{}; }
}
#test "battle: what holds a creature longest: what stops it, then a curse, then a blessing" #steps 4000000000 {
  b: [1] RsBattle; rs_room(b[..]); b[0].n = 1; b[0].clock = rs_secs(10);
  sp: [1] int;
  #assert egb_hold_left(b[..], 0, sp[..]) == 0 && sp[0] == -1;
  #assert egb_hold_rank(RsEffect.{kind = EF_HALT}) == 3 && egb_hold_rank(RsEffect.{kind = EF_COND, cond = RS_STUNNED}) == 3 && egb_hold_rank(RsEffect.{kind = EF_COND, cond = RS_PARALYZED}) == 3;
  #assert egb_hold_rank(RsEffect.{kind = EF_COND, cond = RS_RESTRAINED | RS_PRONE}) == 3 && egb_hold_rank(RsEffect.{kind = EF_COND, cond = RS_BLINDED}) == 0 && egb_hold_rank(RsEffect.{kind = EF_COND}) == 0;
  #assert egb_hold_rank(RsEffect.{kind = EF_BANE}) == 2 && egb_hold_rank(RsEffect.{kind = EF_ENFEEBLED}) == 2 && egb_hold_rank(RsEffect.{kind = EF_HEX}) == 2;
  #assert egb_hold_rank(RsEffect.{kind = EF_BLESS}) == 1 && egb_hold_rank(RsEffect.{kind = EF_FAITH}) == 1 && egb_hold_rank(RsEffect.{kind = EF_WEAK}) == 0 && egb_hold_rank(RsEffect.{kind = EF_NONE}) == 0;
  #assert egb_hold_rank(RsEffect.{kind = EF_HALT, cond = RS_BLINDED}) == 3 && egb_hold_rank(RsEffect.{kind = EF_BANE, cond = RS_STUNNED}) == 2;
  e := b[0].c[0].eff[..];
  e[0] = RsEffect.{kind = EF_BLESS, spell = 13, until = 10500000};   // first in the list
  #assert egb_hold_left(b[..], 0, sp[..]) == 0.5 && sp[0] == 13;
  e[0] = RsEffect.{kind = EF_HEX, spell = 14, until = 10000000};      // a curse over now
  e[1] = RsEffect.{kind = EF_NONE, spell = 15, until = 50000000};     // nothing, however long
  #assert egb_hold_left(b[..], 0, sp[..]) == 0 && sp[0] == -1;
  e[1] = RsEffect.{};
  e[0] = RsEffect.{kind = EF_BLESS, spell = 1, until = 10000000};   // over now
  e[1] = RsEffect.{kind = EF_WEAK, spell = 2, until = 50000000};    // not one it shows
  e[2] = RsEffect.{kind = EF_COND, cond = RS_PRONE, spell = 3, until = 50000000};
  #assert egb_hold_left(b[..], 0, sp[..]) == 0 && sp[0] == -1;
  e[3] = RsEffect.{kind = EF_FAITH, spell = 4, until = 13000000};
  #assert egb_hold_left(b[..], 0, sp[..]) == 3 && sp[0] == 4;
  e[4] = RsEffect.{kind = EF_BLESS, spell = 5, until = 15000000};
  e[5] = RsEffect.{kind = EF_BLESS, spell = 6, until = 15000000};   // as long: the first kept
  #assert egb_hold_left(b[..], 0, sp[..]) == 5 && sp[0] == 5;
  e[0] = RsEffect.{kind = EF_FAITH, spell = 7, until = 14000000};   // shorter, after a longer: not taken
  e[4] = RsEffect.{kind = EF_BLESS, spell = 5, until = 12000000};
  #assert egb_hold_left(b[..], 0, sp[..]) == 5 && sp[0] == 6;
  e[1] = RsEffect.{kind = EF_HEX, spell = 8, until = 11000000};     // a curse outranks a longer blessing
  #assert egb_hold_left(b[..], 0, sp[..]) == 1 && sp[0] == 8;
  e[1] = RsEffect.{};
  for q: [3] int.[EF_BANE, EF_ENFEEBLED, EF_HEX] {
    e[5] = RsEffect.{kind = q, spell = 9, until = 12000000};
    #assert egb_hold_left(b[..], 0, sp[..]) == 2 && sp[0] == 9;
  }
  e[5] = RsEffect.{kind = EF_HEX, spell = 9, until = 10500000};   // first a curse, then a longer blessing: the curse kept
  #assert egb_hold_left(b[..], 0, sp[..]) == 0.5 && sp[0] == 9;
  e[2] = RsEffect.{kind = EF_COND, cond = RS_PRONE | RS_STUNNED, spell = 10, until = 10500000};   // what stops it outranks them all
  e[5] = RsEffect.{kind = EF_HEX, spell = 9, until = 20000000};
  #assert egb_hold_left(b[..], 0, sp[..]) == 0.5 && sp[0] == 10;
  for c: [2] int.[RS_PARALYZED, RS_RESTRAINED] {
    e[2] = RsEffect.{kind = EF_COND, cond = c, spell = 11, until = 10250000};
    #assert egb_hold_left(b[..], 0, sp[..]) == 0.25 && sp[0] == 11;
  }
  e[2] = RsEffect.{kind = EF_HALT, spell = 12, until = 10750000};
  #assert egb_hold_left(b[..], 0, sp[..]) == 0.75 && sp[0] == 12;
}
#test "battle: a creature as the room reads it, and the ground under it" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  out: [EGB_BEAST_FLOATS] f32;
  for q: 0..<EGB_BEAST_FLOATS { out[q] = -7; }
  #assert egb_beast(r[..], 0, out[..]) == 0 && egb_beast(r[..], -1, out[..]) == 0 && egb_beast(r[..], EGB_BEASTS, out[..]) == 0 && out[0] == -7;
  q := EGB_BEASTS - 1;
  b[0].c[EGB_BEAST0 + q] = rs_monster(MON_WOLF, "Wolf", EGB_BEAST_TEAM); b[0].c[EGB_BEAST0 + q].hp = 6;
  r[0].beasts[q] = EgBeast.{id = 12, tag = 12, by = 3, form = EGB_FORM_WOLF, x = 1.5, y = 2.5, z = -3.5, yaw = 0.25, moving = true};
  #assert egb_beast(r[..], q, out[0..<EGB_BEAST_FLOATS - 1]) == 0 && out[0] == -7;
  #assert egb_beast(r[..], q, out[..]) == 12;
  #assert out[0] == 1.5 && out[1] == 2.5 && out[2] == -3.5 && out[3] == 0.25 && out[4] == 6 && out[5] == f32(b[0].c[EGB_BEAST0 + q].hp_max) && out[6] == 3 && out[7] == 1 && out[8] == 1 && out[9] == 0;
  r[0].beasts[0] = EgBeast.{id = 3, tag = 3, x = 7};
  #assert egb_beast(r[..], 0, out[..]) == 3 && out[0] == 7;
  egb_beast_ground(r[..], 0, 2);
  #assert r[0].beasts[0].grounded && r[0].beasts[0].y == 2;
  r[0].beasts[0] = EgBeast.{};
  egb_beast_ground(r[..], q, 4.5); egb_beast_ground(r[..], 0, 9); egb_beast_ground(r[..], -1, 9); egb_beast_ground(r[..], EGB_BEASTS, 9);
  r[0].beasts[q].moving = false;
  #assert egb_beast(r[..], q, out[..]) == 12 && out[1] == 4.5 && out[8] == 0 && out[9] == 1 && !r[0].beasts[0].grounded && r[0].beasts[0].y == 0;
}
#test "battle: the engine's events, oldest first, as many as fit, each read once" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  out: [8 * RS_EVENTS] f32;
  _ := egb_events(r[..], out[..]);
  r[0].beasts[2].tag = 5;
  for q: 0..<3 { _ = rs_emit(b[0].book[..], RsEvent.{kind = q + 1, spell = 10 + q, by = 0, to = EGB_BEAST0 + 2, amount = 20 + q, damage = 30 + q, x = q, y = 352 + q}); }
  small: [17] f32;
  #assert egb_events(r[..], small[..]) == 2 && small[0] == 1 && small[8] == 2 && small[16] == 0;
  #assert small[1] == 10 && small[2] == 1000 && small[3] == 2005 && small[4] == 20 && small[5] == 30 && small[6] == egb_cell_m(0) && small[7] == egb_cell_m(0);
  #assert small[9] == 11 && small[14] == egb_cell_m(1) && small[15] == egb_cell_m(1);
  #assert egb_events(r[..], out[..]) == 0;   // read: the third didn't fit and is gone too
  for q: 0..<RS_EVENTS + 5 { _ = rs_emit(b[0].book[..], RsEvent.{kind = 1, amount = q}); }
  #assert egb_events(r[..], out[..]) == RS_EVENTS && out[4] == 5 && out[(RS_EVENTS - 1) * 8 + 4] == f32(RS_EVENTS + 4);
  _ = rs_emit(b[0].book[..], RsEvent.{kind = 2, amount = 77});
  #assert egb_events(r[..], out[..]) == 1 && out[4] == 77;
}
#test "battle: the room's step: its clock, the seats' and familiars' turns, a creature's turn when due" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  egb_step(r[..], 0); egb_step(r[..], -1);
  #assert b[0].clock == 0;
  // a seat's turn opens on its beat; a seat not here, none
  #assert !r[0].seat[0].open;
  egb_step(r[..], b[0].c[0].turn_at + 100000);
  #assert r[0].seat[0].open && !r[0].seat[1].open && b[0].clock > 0;
  // a creature takes its turn when due, not before: a guard set on seat 0, beside it
  x := b[0].c[0].x; y := b[0].c[0].y;
  b[0].c[0].hp = 300; b[0].c[0].hp_max = 300;
  egb_test_guard(r[..], 0, 0, x, y + 1);
  egb_step(r[..], b[0].clock);   // no time on: no turn
  #assert r[0].beasts[0].swing == EGB_NEVER;
  was := b[0].clock; egb_step(r[..], was + 1);   // one tick on is time on: its turn is taken
  #assert b[0].clock == was + 1;
  t0 := r[0].beasts[0].swing;
  #assert t0 == b[0].clock;
  egb_step(r[..], b[0].c[EGB_BEAST0].turn_at);   // its next turn: a fresh Attack action
  #assert r[0].beasts[0].swing > t0;
  r[0].beasts[0].id = 0;
  // the last seat's and the last creature's turns too
  egb_join(r[..], EGB_SEATS - 1, 0, 0, EGB_DRUID, 0);
  egb_step(r[..], b[0].c[EGB_SEATS - 1].turn_at + 10000);
  #assert r[0].seat[EGB_SEATS - 1].open;
  egb_test_guard(r[..], EGB_BEASTS - 1, 0, x - 1, y + 1);
  egb_step(r[..], b[0].clock + 10000);
  #assert r[0].beasts[EGB_BEASTS - 1].swing == b[0].clock;
  r[0].beasts[EGB_BEASTS - 1].id = 0;
  egb_test_guard(r[..], 3, 0, x + 1, y);
  b[0].c[EGB_BEAST0 + 3].turn_at = b[0].clock + rs_secs(5);
  egb_step(r[..], b[0].clock + 50000);
  #assert r[0].beasts[3].swing == EGB_NEVER && b[0].who == -1;
  t := b[0].c[EGB_BEAST0 + 3].turn_at;
  while b[0].clock < t { egb_step(r[..], b[0].clock + 250000); }
  #assert b[0].who == -1 && r[0].beasts[3].swing >= t;
  // a creature not a guard on patrol takes its turn but strikes no one
  egb_test_guard(r[..], 4, 0, x - 1, y); r[0].beasts[4].patrol = false; r[0].beasts[4].wild = true;
  egb_test_guard(r[..], 5, 0, x, y + 1); b[0].c[EGB_BEAST0 + 5].dead = true; b[0].c[EGB_BEAST0 + 5].hp = 0;
  egb_test_guard(r[..], 6, 0, x, y - 1); r[0].beasts[6].id = 0;
  egb_step(r[..], b[0].clock + 10000);
  #assert r[0].beasts[4].swing == EGB_NEVER && b[0].c[EGB_BEAST0 + 4].turn_at > b[0].clock && r[0].beasts[6].swing == EGB_NEVER && b[0].c[EGB_BEAST0 + 6].turn_at <= b[0].clock;
  #assert r[0].beasts[5].id == 0;   // dead: gone at the step's check
  // the familiar's turn opens too, once it's on the field
  f := r[0].familiar[0].me;
  b[0].c[f] = rs_monster(MON_CAT, "Cat", 0);
  b[0].c[f].familiar_owner = 1; b[0].c[f].x = x; b[0].c[f].y = y + 2; b[0].c[f].turn_at = b[0].clock;
  egb_step(r[..], b[0].clock + 10000);
  #assert r[0].familiar[0].open;
  s: [1] EgBattle;
  egb_step(s[..], 5);
  #assert s[0].b[0].clock == 0;
}
#test "battle: a guard's turn: his blade within reach, Dash or his bow beyond it, Second Wind when hurt, never a foe of his own" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  b[0].dice[0].fixed = true;
  x := b[0].c[0].x; y := b[0].c[0].y;
  g := EGB_BEAST0;
  // no foe: nothing
  egb_test_guard(r[..], 0, -1, x + 1, y);
  b[0].who = g; rs_start_turn(b, g); egb_patrol_turn(r[..], 0);
  #assert r[0].beasts[0].swing == EGB_NEVER && r[0].beasts[0].foe == -1 && !b[0].turn.action;
  rs_end_turn(b, g); b[0].who = -1;
  // a foe gone: forgotten
  b[0].c[1].x = x + 3; b[0].c[1].y = y;
  b[0].c[b[0].n] = rs_monster(MON_WOLF, "Wolf", EGB_BEAST_TEAM); b[0].c[b[0].n].x = x + 2; b[0].c[b[0].n].y = y;   // past the battle's creatures
  for bad: 0..<4 {
    egb_test_guard(r[..], 0, ifx bad == 0 then b[0].n else 1, x + 1, y);
    if bad == 1 { b[0].c[1].dead = true; } else if bad == 2 { b[0].c[1].dead = false; b[0].c[1].hp = 0; } else if bad == 3 { b[0].c[1].hp = 5; b[0].c[1].x = EGB_AWAY; }
    egb_test_turn(r[..], 0);
    #assert r[0].beasts[0].foe == -1 && r[0].beasts[0].swing == EGB_NEVER;
  }
  b[0].c[1].dead = false; b[0].c[1].hp = 5; b[0].c[1].x = x + 3; b[0].c[1].y = y;
  egb_test_guard(r[..], 0, 1, x + 2, y);
  egb_test_turn(r[..], 0);
  #assert r[0].beasts[0].foe == 1;   // a foe standing: kept
  // within reach: his Attack action, and the clock of it
  b[0].c[0].hp = 300; b[0].c[0].hp_max = 300;
  hp := b[0].c[0].hp;
  egb_test_guard(r[..], 0, 0, x + 1, y);
  b[0].clock += 1;
  b[0].who = g; rs_start_turn(b, g); egb_patrol_turn(r[..], 0);
  #assert r[0].beasts[0].swing == b[0].clock && b[0].turn.action && b[0].c[0].hp < hp;
  rs_end_turn(b, g); b[0].who = -1;
  // his action spent already: no new blow told
  egb_test_guard(r[..], 0, 0, x + 1, y);
  b[0].who = g; rs_start_turn(b, g); b[0].turn.action = true; egb_patrol_turn(r[..], 0); rs_end_turn(b, g); b[0].who = -1;
  #assert r[0].beasts[0].swing == EGB_NEVER;
  // 10 feet off: the Dash action to close
  egb_test_guard(r[..], 0, 0, x + 2, y);
  b[0].clock += 1;
  egb_test_turn(r[..], 0);
  #assert r[0].beasts[0].dash_at == b[0].clock && r[0].beasts[0].shot_at == EGB_NEVER && r[0].beasts[0].swing == EGB_NEVER;
  // 30 feet off: still a Dash; past it, his Longbow
  egb_test_guard(r[..], 0, 0, x + 6, y);
  egb_test_turn(r[..], 0);
  #assert r[0].beasts[0].dash_at == b[0].clock && r[0].beasts[0].shot_at == EGB_NEVER;
  egb_test_guard(r[..], 0, 0, x + 7, y);
  b[0].clock += 1;
  egb_test_turn(r[..], 0);
  #assert r[0].beasts[0].shot_at == b[0].clock && r[0].beasts[0].dash_at == EGB_NEVER;
  // no bow: a Dash, however far
  egb_test_guard(r[..], 0, 0, x + 7, y); b[0].c[g].ranged = -1;
  egb_test_turn(r[..], 0);
  #assert r[0].beasts[0].shot_at == EGB_NEVER && r[0].beasts[0].dash_at == b[0].clock;
  // a Dash spent already: nothing told
  egb_test_guard(r[..], 0, 0, x + 2, y);
  b[0].who = g; rs_start_turn(b, g); b[0].turn.action = true; b[0].turn.bonus = true; egb_patrol_turn(r[..], 0); rs_end_turn(b, g); b[0].who = -1;
  #assert r[0].beasts[0].dash_at == EGB_NEVER;
  // below half his Hit Points: Second Wind first; at half, not
  egb_test_guard(r[..], 0, 0, x + 1, y); b[0].c[g].hp = 41;
  b[0].who = g; rs_start_turn(b, g); egb_patrol_turn(r[..], 0);
  #assert b[0].c[g].hp > 41 && b[0].turn.bonus;
  rs_end_turn(b, g); b[0].who = -1;
  egb_test_guard(r[..], 0, 0, x + 1, y); b[0].c[g].hp = 42;
  b[0].who = g; rs_start_turn(b, g); egb_patrol_turn(r[..], 0);
  #assert b[0].c[g].hp == 42 && !b[0].turn.bonus;
  rs_end_turn(b, g); b[0].who = -1;
}
#test "battle: Action Surge for a second Attack action while the foe stands" #steps 4000000000 {
  r: [1] EgBattle; egb_test_battle(r[..]);
  b := r[0].b[..];
  b[0].dice[0].fixed = true;
  x := b[0].c[0].x; y := b[0].c[0].y;
  g := EGB_BEAST0;
  b[0].c[0].hp = 300; b[0].c[0].hp_max = 300;
  egb_test_guard(r[..], 0, 0, x + 1, y);
  surges := b[0].c[g].uses[RS_USE_SURGE];
  egb_test_turn(r[..], 0);
  #assert surges > 0 && b[0].c[g].uses[RS_USE_SURGE] == surges - 1;
  // a foe down after the first: no second
  egb_test_guard(r[..], 0, 0, x + 1, y);
  b[0].c[0].hp = 1;
  surges = b[0].c[g].uses[RS_USE_SURGE];
  egb_test_turn(r[..], 0);
  #assert b[0].c[g].uses[RS_USE_SURGE] == surges && b[0].c[0].hp <= 0;
}
#test "battle: a seat's Wild Companion, only while its turn is open" #steps 4000000000 {
  r: [1] EgBattle; egb_start(r[..], 1);
  egb_join(r[..], 0, 0, 0, EGB_CL0 + FB_CL_DRUID, 2);
  b := r[0].b[..];
  x := b[0].c[0].x; y := b[0].c[0].y; m := RS_FAMILIAR_FORMS[0];
  egb_step(r[..], b[0].c[0].turn_at + 100000);
  #assert r[0].seat[0].open && !egb_wild_companion(r[..], 0, 0, m, x + 1, y);   // no familiars on
  egb_enable_familiars(r[..]);
  r[0].seat[0].open = false;
  #assert !egb_wild_companion(r[..], 0, 0, m, x + 1, y);
  egb_step(r[..], b[0].c[0].turn_at + 100000);
  #assert r[0].seat[0].open;
  #assert !egb_wild_companion(r[..], -1, 0, m, x + 1, y) && !egb_wild_companion(r[..], EGB_SEATS, 0, m, x + 1, y) && !egb_wild_companion(r[..], 1, 0, m, x + 1, y);
  who := b[0].who;
  #assert egb_wild_companion(r[..], 0, 0, m, x + 1, y) && b[0].who == who && rs_familiar_of(b, 0) >= 0 && r[0].seat[0].turn.action;
  #assert !egb_wild_companion(r[..], 0, 0, m, x + 1, y);   // its action spent
  l := EGB_SEATS - 1;
  egb_join(r[..], l, 3, 0, EGB_CL0 + FB_CL_DRUID, 2);
  egb_step(r[..], b[0].c[l].turn_at + 100000);
  #assert r[0].seat[l].open && egb_wild_companion(r[..], l, 0, m, b[0].c[l].x + 1, b[0].c[l].y + 1) && rs_familiar_of(b, l) >= 0;
}
