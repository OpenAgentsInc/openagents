// Everglade's room: a seat's casts, taken or refused, their sight and their targets.
// Moved from coax/web/room/room-everglade.coax (#13267), which loads it.
// Everglade's casts (#13058; docs/dnd/everglade-combat-profile.md, #13284). The room takes one when the
// slot is on the seat's class's kit at its level (class-kit.coax: the ability's content number), the
// seat's turn has the parts of it the ability takes (everglade/shared/cast-pace.coax: one Action, one
// Bonus Action and one slot spell a 1.5 s turn, which opens on its first press; the page sweeps the icon
// for the same time), and its aim is a number within the ability's reach of where the room has the seat
// (EG_E2_CAST_SLACK m more, for the steps not yet stepped). Every press is paid by the shared rules. An
// ability at one creature strikes the one the aim is on; an area that can harm takes every creature in
// its shape round the aimed point but the caster's team. Shared execution must commit before every page
// within EG_VIEW hears e cast SS SLOT AX AY AZ SEED, the caster's too, at once.
EG_E2_GAP :: XP_FREE_GAP;   // ticks between presses that take no part of a turn (0.5 s), and a familiar's touch
EG_E2_CAST_SLACK :: 3.0;   // m
eg_e2_cast :: (v: [] RmServer, k: int, seat_id: SeatId, wc: WireCast) { seat := seat_id.value;
  st := v[0].eg[k].seat[seat..<seat + 1];
  e := xk_entry_at(v[0].eg[k].rules[0].klass[seat] - EGB_CL0, v[0].eg[k].rules[0].b[0].c[EGB_SEAT + seat].level, wc.slot);   // its level's bar (#13046)
  if !e.ok { eg_refuse(v, k, seat_id, wc.seq, "slot"); return; }
  if !(wc.ax == wc.ax) || !(wc.az == wc.az) || !(wc.ay == wc.ay) || abs(wc.ay) > 1000 { eg_refuse(v, k, seat_id, wc.seq, cr_word(CR_AIM)); return; }
  t := v[0].eg[k].tick;
  // its turn: the parts the ability takes (its Ability record's) must be unspent, or the turn's beat over
  rec := rs_ability(e.ab.kind, e.ab.sp); parts := xp_parts(rec, e.ab.lvl);
  if xp_wait(st[0].pace, parts, t, XP_LATE) > 0 { eg_refuse(v, k, seat_id, wc.seq, cr_word(CR_COOLDOWN)); return; }
  open := xp_opens(st[0].pace, parts, t, XP_LATE);
  me := st[0].pose; dx := wc.ax - me.x; dz := wc.az - me.z;
  reach := ifx e.aim.kind == XC_AIM_SELF then 0.0f32 else e.aim.reach;
  if dx * dx + dz * dz > (reach + f32(EG_E2_CAST_SLACK)) * (reach + f32(EG_E2_CAST_SLACK)) { eg_refuse(v, k, seat_id, wc.seq, cr_word(CR_RANGE)); return; }
  r:=v[0].eg[k].rules[..];
  // a bow's Attack with its launch said: an arrow the room flies; its Attack is rolled when it reaches
  // a body or the ground (everglade/server/arrows.coax). The cast is told now, as any: the archer's loose.
  if e.ab.kind == FB_ATTACK && xc_kit(r[0].klass[seat] - EGB_CL0) == XC_KIT_BOW && st[0].loose.ok {
    kept := st[0].loose.seq == wc.seq && rs_can_act(r[0].b[0].c[EGB_SEAT + seat]);
    if !kept { st[0].loose = NetLoose.{}; }
    if kept && e2_arrow_loose(v, k, seat_id, wc.slot, wc.seq) {
      // the loose takes the turn's Action now; the Attack it pays for is rolled when the arrow lands
      st[0].pace = xp_took(st[0].pace, parts, XP_ACTION, 0, t, XP_LATE);
      st[0].last_cast = t; v[0].eg[k].e2_casts += 1;
      ev: [128] u8;
      en := wire_put_cast_e(ev[..], 0, WireCastE.{ss = seat, slot = wc.slot, ax = wc.ax, ay = wc.ay, az = wc.az, seed = 1 + (v[0].eg[k].seed + t * 31 + seat * 977 + wc.slot * 7) % 999983});
      eg_event(v, k, cast(string) ev[0..<en], me.x, me.z, false);
      return;
    }
  }
  revive:=e.ab.kind==FB_SPELL && e.ab.sp==SP_REVIVIFY;
  // its line of sight (#13262): v1's rule (room-casts.coax rm_eg_sights), a cast on yourself needs none
  if e.ab.tg != FB_SELF && !revive && !e2_cast_sight(v, k, me, wc.ax, wc.az) { eg_refuse(v, k, seat_id, wc.seq, cr_word(CR_SIGHT)); return; }
  // aimed at the path's guard or a monster, a harmful cast is at it (everglade/server/guard.coax,
  // everglade/server/creatures.coax): the shared rules' strike
  // an area that can harm names no one: it is cast at the aimed point, and whoever stands in it is struck
  area := e2r_area(xk_rules(r[0].klass[seat]-EGB_CL0,e.ab));
  gfoe := ifx revive || area || egb_helps(e.ab) then -1 else e2_guard_target(v, k, wc.ax, wc.az);
  foe := ifx gfoe >= 0 || revive || area || egb_helps(e.ab) then gfoe else e2_monster_target(v, k, wc.ax, wc.az);
  foe_hp := ifx foe >= 0 then r[0].b[0].c[foe].hp else 0;
  before: [EGB_BEASTS] int; for q: 0..<EGB_BEASTS { before[q] = r[0].b[0].c[EGB_BEAST0 + q].hp; }
  done:=ifx revive then e2r_request(r[0].b[..],r[0].seat[seat..<seat+1],r[0].klass[seat]-EGB_CL0,wc.slot,null,eg_e2_corpse(v,k,seat),open)
    else e2r_press(r[0].b[..],r[0].seat[seat..<seat+1],r[0].klass[seat]-EGB_CL0,wc.slot,egb_sq(wc.ax),egb_z_cell(r,wc.az),foe,open);
  if !done { eg_refuse(v,k,seat_id,wc.seq,cr_word(CR_NO)); return; }
  if gfoe >= 0 { e2_guard_struck(v, k, seat, foe_hp); }
  else if foe >= 0 { e2_monster_struck(v, k, seat, foe, foe_hp); }
  else if area { e2_area_struck(v, k, seat, before[..]); }
  // what the cast left of its reagents and of the seat's turn
  xr_keep(st[0].stock[..],r[0].b[0].c[EGB_SEAT+seat].materials[..]);
  turn := r[0].seat[seat].turn;
  st[0].pace = xp_took(st[0].pace, parts, xp_spent(turn.action, turn.bonus, turn.slot_spent), rec.gives, t, XP_LATE);
  st[0].last_cast = t;
  v[0].eg[k].e2_casts += 1;
  e2_kit_tell(v, k, seat_id, false);   // what the cast spent, at once
  b: [128] u8;
  n := wire_put_cast_e(b[..], 0, WireCastE.{ss = seat, slot = wc.slot, ax = wc.ax, ay = wc.ay, az = wc.az, seed = 1 + (v[0].eg[k].seed + t * 31 + seat * 977 + wc.slot * 7) % 999983});
  eg_event(v, k, cast(string) b[0..<n], me.x, me.z, false);
}
// An area's cast is done: every guard or monster it harmed (its Hit Points fell below `before`) was struck
// by seat s, as one a single cast named is (everglade/server/guard.coax, creatures.coax).
e2_area_struck :: (v: [] RmServer, k: int, s: int, before: [] const int) {
  r := v[0].eg[k].rules[..]; g := v[0].eg[k].guard[0];
  for q: 0..<EGB_BEASTS {
    i := EGB_BEAST0 + q;
    if r[0].beasts[q].id == 0 || r[0].b[0].c[i].hp >= before[q] { continue; }
    if g.q == q { e2_guard_struck(v, k, s, before[q]); } else { e2_monster_struck(v, k, s, i, before[q]); }
  }
}
// Whether a caster with feet at `me` sees the aim (ax, az) (#13262): v1's line (everglade-cast-sight.coax
// cr_sight) from CR_EYE over the caster's land to EG_E2_SIGHT_UP over the aim's, ending CR_SHORT short,
// and an aim within CR_NEAR always seen. What blocks it is what stops an arrow (#13166): the trunks and
// rocks the walker meets (everglade/shared/archery.coax e2ar_in), from the room's planting. A piece lower
// than CR_LOW where the line meets it (a low rock) doesn't block, nor does the land (a bolt clears a rise).
EG_E2_SIGHT_UP :: 1.0;     // m over the aim's land the line ends: a body's chest (the page's aim is its own y + 1)
EG_E2_SIGHT_STEP :: 0.05;  // m between the points asked along the line: under a trunk's radius
e2_cast_sight :: (v: [] RmServer, k: int, me: EgPose, ax: f32, az: f32) -> bool {
  dx := ax - me.x; dz := az - me.z; flat := sqrt(dx * dx + dz * dz);
  if !(flat == flat) || flat <= f32(CR_NEAR) { return true; }
  ey := e2_height(me.x, me.z) + f32(CR_EYE); ty := e2_height(ax, az) + f32(EG_E2_SIGHT_UP);
  span := sqrt(flat * flat + (ty - ey) * (ty - ey));
  far := span - f32(CR_SHORT);
  if far <= 0 { return true; }
  land := e2a_land(v); near := v[0].eg[k].arrows[0].near[..];
  n := cast(int) (far / f32(EG_E2_SIGHT_STEP));
  for i: 1..<n + 2 {
    t := ifx i > n then far / span else f32(i) * f32(EG_E2_SIGHT_STEP) / span;
    x := me.x + dx * t; y := ey + (ty - ey) * t; z := me.z + dz * t;
    if e2ar_in(land, near, x, y, z) != E2AR_WOOD { continue; }
    if e2ar_in(land, near, x, e2_height(x, z) + f32(CR_LOW), z) == E2AR_WOOD { return false; }
  }
  return true;
}
// Revivify's creature: the nearest dead player within Touch whom neither seat has blocked. The
// shared rules judge the death's timing, reach and cover (rules/srd/revivify.coax).
eg_e2_corpse :: (v: [] RmServer, k: int, s: int) -> int {
  room:=v[0].eg[k..<k+1]; rules:=room[0].rules[..]; b:=rules[0].b[..];
  best:=1.524f32*1.524f32*2; target:=-1;
  for j:0..<EG_SEATS {
    if j==s || !room[0].seat[j].live || !room[0].seat[j].placed || !rules[0].live[j] { continue; }
    if (room[0].im[0].blocks[s] & (1 << j))!=0 || (room[0].im[0].blocks[j] & (1 << s))!=0 { continue; }
    if !b[0].c[EGB_SEAT+j].dead { continue; }
    d:=e2_aid_distance(room[0].seat[s].pose,room[0].seat[j].pose);
    if d<=best && (target<0 || d<best) { best=d; target=j; }
  }
  return ifx target<0 then -1 else EGB_SEAT+target;
}
