// What Everglade II's guard and monsters did, or had done to them (#13276): e entries of the D frame.
// Where each stands, its state and its Hit Points are its row's (everglade-wire.coax WK_GUARD,
// WK_MONSTER). The one codec both sides load: the room writes the entries (guard.coax, creatures.coax)
// and the page reads them (everglade/client/net.coax). Profile proto/verse/everglade2-combat-v2.json,
// doc docs/protocol/everglade-guard-monsters-v2.md; its check runs these functions:
//   coax/web/tool.sh coax/web/room/combat-profile.coax proto/verse/everglade2-combat-v2.json
// Whole numbers a space apart (everglade-wire.coax wire_int). A place is cm. Ticks are the room's.
//   e guard TICK KIND SEAT AMOUNT                      a blow: KIND 1 at him, 2 his at SEAT, 4 his critical,
//                                                      5 his arrow, 6 its critical
//   e mon TICK KIND M SEAT AMOUNT [FX FZ TX TZ FLY_MS] a monster's event: KIND 1 its blow at SEAT, 2 a blow
//                                                      at it, 3 an arrow loosed (with its flight), 4 it fell
// TICK may be ahead of the frame's: the guard's turn is told when the rules take it, each blow at its moment.
// A reader takes an entry whole or not at all (ok false): a field missing, extra or out of range.
//   coax/bin/coax test everglade/server/creature-wire.coax
#load "../shared/everglade-wire.coax";

EGC_MONS :: WIRE_MONS;   // the monsters the entries name at most (creatures.coax E2M_N, everglade/client/net.coax E2N_MONS)
EGC_GUARD_E :: "e guard"; EGC_MON_E :: "e mon";
EGC_SEATS :: 64;    // a SEAT or FOE is below this, or -1 for none
EGC_GUARD_HIT :: 1; EGC_GUARD_BLOW :: 2; EGC_GUARD_CRIT :: 4; EGC_GUARD_SHOT :: 5; EGC_GUARD_SHOT_CRIT :: 6;
EGC_MON_BLOW :: 1; EGC_MON_HIT :: 2; EGC_MON_LOOSED :: 3; EGC_MON_FELL :: 4;

EgcGuardHit :: struct { ok: bool; tick: int; kind: int; seat: int; amount: int; }
EgcMonHit :: struct { ok: bool; tick: int; kind: int; m: int; seat: int; amount: int; fx: int; fz: int; tx: int; tz: int; fly: int; }

egc_seat_ok :: (s: int) -> bool { return s >= -1 && s < EGC_SEATS; }
// Whether an e entry is one of these: told on the reliable class, with the outcomes' room and outside the cue budget.
egc_kept :: (t: string) -> bool { return wire_is(t, EGC_MON_E) || wire_is(t, EGC_GUARD_E); }

// ---- e guard
egc_guard_hit_put :: (out: [] u8, h: EgcGuardHit) -> int {
  return wire_int(out, wire_int(out, wire_int(out, wire_int(out, wire_put(out, 0, EGC_GUARD_E), h.tick), h.kind), h.seat), h.amount);
}
egc_guard_hit_read :: (t: string) -> EgcGuardHit {
  if !wire_is(t, EGC_GUARD_E) { return EgcGuardHit.{}; }
  rd := [1] WireRd.[wire_rd(t, EGC_GUARD_E.count)];
  h: EgcGuardHit;
  h.tick = wire_num(t, rd[..]); h.kind = wire_num(t, rd[..]); h.seat = wire_num(t, rd[..]); h.amount = wire_num(t, rd[..]);
  h.ok = rd[0].ok && !wire_more(t, rd[..]) && h.tick >= 0 && h.kind >= EGC_GUARD_HIT && h.kind <= EGC_GUARD_SHOT_CRIT && h.kind != 3 &&
    egc_seat_ok(h.seat) && h.amount >= 0 && h.amount <= 999;
  return h;
}

// ---- e mon
egc_mon_hit_put :: (out: [] u8, h: EgcMonHit) -> int {
  n := wire_int(out, wire_int(out, wire_int(out, wire_int(out, wire_put(out, 0, EGC_MON_E), h.tick), h.kind), h.m), h.seat);
  n = wire_int(out, n, h.amount);
  if h.kind != EGC_MON_LOOSED { return n; }
  n = wire_int(out, wire_int(out, n, h.fx), h.fz);
  n = wire_int(out, wire_int(out, n, h.tx), h.tz);
  return wire_int(out, n, h.fly);
}
egc_mon_hit_read :: (t: string) -> EgcMonHit {
  if !wire_is(t, EGC_MON_E) { return EgcMonHit.{}; }
  rd := [1] WireRd.[wire_rd(t, EGC_MON_E.count)];
  h: EgcMonHit;
  h.tick = wire_num(t, rd[..]); h.kind = wire_num(t, rd[..]); h.m = wire_num(t, rd[..]); h.seat = wire_num(t, rd[..]); h.amount = wire_num(t, rd[..]);
  if h.kind == EGC_MON_LOOSED {
    h.fx = wire_num(t, rd[..]); h.fz = wire_num(t, rd[..]); h.tx = wire_num(t, rd[..]); h.tz = wire_num(t, rd[..]); h.fly = wire_num(t, rd[..]);
    if h.fly < 0 || h.fly > 5000 { return EgcMonHit.{}; }
  }
  h.ok = rd[0].ok && !wire_more(t, rd[..]) && h.tick >= 0 && h.kind >= EGC_MON_BLOW && h.kind <= EGC_MON_FELL && h.m >= 0 && h.m < EGC_MONS &&
    egc_seat_ok(h.seat) && h.amount >= 0 && h.amount <= 999;
  return h;
}

#test "creature wire: each entry written reads back, and a bad one is refused whole" {
  b: [256] u8;
  n := egc_guard_hit_put(b[..], EgcGuardHit.{tick = 90, kind = EGC_GUARD_HIT, seat = 2, amount = 5});
  #assert cast(string) b[0..<n] == "e guard 90 1 2 5" && egc_guard_hit_read("e guard 90 1 2 5").amount == 5 && egc_guard_hit_read("e guard 90 1 2 5").tick == 90;
  for bad: [7] string.["e guard 90 3 2 5", "e guard 90 7 2 5", "e guard 90 1 2 1000", "e guard 90 1 -2 5", "e guard 90 1 2", "e guard 90 1 2 5 0", "e mon 90 1 2 5"] { #assert !egc_guard_hit_read(bad).ok; }
  n = egc_mon_hit_put(b[..], EgcMonHit.{tick = 90, kind = EGC_MON_LOOSED, m = 10, seat = 0, amount = 0, fx = 500, fz = -30000, tx = 520, tz = -31000, fly = 700});
  #assert cast(string) b[0..<n] == "e mon 90 3 10 0 0 500 -30000 520 -31000 700";
  h := egc_mon_hit_read(cast(string) b[0..<n]); #assert h.ok && h.tz == -31000 && h.fly == 700 && h.m == 10;
  n = egc_mon_hit_put(b[..], EgcMonHit.{tick = 90, kind = EGC_MON_HIT, m = 3, seat = -1, amount = 4, fly = 9});
  #assert cast(string) b[0..<n] == "e mon 90 2 3 -1 4" && egc_mon_hit_read("e mon 90 2 3 -1 4").ok;
  for bad: [7] string.["e mon 90 5 3 0 4", "e mon 90 3 10 0 0 500 -30000 520 -31000 5001", "e mon 90 3 10 0 0 500 -30000 520 -31000", "e mon 90 2 3 -1 4 1", "e mon 90 2 12 -1 4", "e mon 90 2 3 -1 1000", "e guard 90 2 3 -1"] {
    #assert !egc_mon_hit_read(bad).ok;
  }
  // an entry of the reliable class: never a cue the budget may drop (everglade/server/seats.coax eg_event_who)
  #assert egc_kept("e mon 90 2 3 -1 4") && egc_kept("e guard 90 1 2 5") && !egc_kept("e hit 1001 2003 7 3") && !egc_kept("e monk 1") && !egc_kept("e guards 1") && !egc_kept("e mon");
}
