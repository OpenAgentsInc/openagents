// Everglade II's monsters: three packs of Wolves in the woods along the middle of the path and a camp of
// four Goblin Warriors at the clearing's near edge (verse/everglade2/camp.coax), each a creature of the
// room's battle with its SRD 5.2.1 stat block (aethyr/rules/srd/monsters.coax MON_WOLF, MON_GOBLIN_WARRIOR).
// The room moves them on its own tick, so every page sees the same monsters; their blows are the shared
// rules' strikes (stat-attack.coax rs_stat_strike: the Wolf's Bite with Pack Tactics and its Prone rider,
// the Goblin's Scimitar and Shortbow, each with the extra die on Advantage) and their Hit Points are the
// battle's, which a player's cast takes through the shared rules (everglade2-rules.coax e2r_use_at_on).
//
// A monster at home notices a player within E2M_NOTICE m whom it can see (the host world's line of sight,
// rm_eg_sights), and its whole group (the pack, the camp) comes. A wolf runs in, circles its quarry while
// its bite readies and closes from its own side of the pack; a goblin closes with its Scimitar, and an
// archer looses from its perch and uses Nimble Escape (a Disengage) to step back from anyone who closes
// on it. Every blow shows a tell first: E2M_TELL_* seconds of its swing or draw. An arrow flies before it
// lands and misses a player who stepped out of its way. Past its leash a monster runs home untouchable,
// whole again when it gets there. Nothing spawns, chases or shoots in the glade (z above E2M_SAFE_Z): a
// player there is no one's quarry, and the leash takes a monster back before the glade's edge. A felled
// monster gives its SRD XP, split among the players who hurt it (room-events.coax ev_award), lies
// E2M_CORPSE_S, and a new one stands at home E2M_RESPAWN_S after it fell, once no player is near enough
// to see it appear.
//   h2 TICK N [M LIFE KIND STATE X Z YAW HP MAX ACT ACT_TICK FOE]...   the monsters within EG_VIEW m (cm, mrad;
//                                         ACT 1 a blow, 2 a shot, its tell from ACT_TICK; FOE a seat or -1)
//   h3 TICK KIND M SEAT AMOUNT [FX FZ TX TZ FLY_MS]   KIND 1 its blow or arrow at SEAT (AMOUNT 0 a miss),
//                                         2 SEAT's harm at it (0 a miss), 3 an arrow loosed (cm, its flight), 4 it fell
// The pages draw them (apps/openagents-web/everglade2-monsters.coax).

E2M_WOLF :: 0; E2M_GOBLIN :: 1;
E2M_N :: 12;                // 8 wolves (packs of 3, 2 and 3) and the camp's 4 goblins
E2M_GROUPS :: 4;            // the three packs, then the camp
E2M_IDLE :: 0; E2M_CHASE :: 1; E2M_RETURN :: 2; E2M_DEAD :: 3; E2M_GONE :: 4; E2M_ESCAPE :: 5;
E2M_ACT_BLOW :: 1; E2M_ACT_SHOT :: 2;
E2M_SAFE_Z :: -55.0;        // north of this the glade's safe ground: no quarry, no monster
E2M_LEASH_Z :: -70.0;       // a monster turns home before it comes this far north
E2M_NOTICE :: [2] f32.[15, 18];       // m: a wolf, a goblin notices you
E2M_LEASH :: [2] f32.[40, 30];        // m from home past which it lets you go
E2M_RUN :: [2] f32.[9.0, 5.5];        // m/s: a Wolf's 40 feet, a Goblin's 30 (everglade5e-beasts.coax E5RR_RUN)
E2M_CIRCLE :: 3.2;          // m/s a wolf circles its quarry while its bite readies
E2M_RING :: 2.6;            // m out it circles
E2M_REACH :: 1.9;           // m middle to middle: a blow's 5 feet (E5RR_REACH, a little slack)
E2M_TELL_BLOW :: [2] f32.[0.45, 0.6]; // s of a blow's swing before it lands
E2M_TELL_SHOT :: 0.6;       // s an archer draws
E2M_ARROW :: 30.0;          // m/s an arrow flies (verse/experimental-hostiles.coax hostile_shot_speed)
E2M_BOW :: 24.38;           // m: the Shortbow's 80 feet
E2M_BOW_MIN :: 4.0;         // m: nearer than this an archer steps back (Nimble Escape) rather than shoot
E2M_ESCAPE_S :: 1.4;        // s it steps back
E2M_AIM :: 1.6;             // m: a cast aimed this near a monster is aimed at it
E2M_CORPSE_S :: 8.0;        // s a fallen monster lies
E2M_RESPAWN_S :: 180.0;     // s from its fall to the next at home
E2M_RESPAWN_DEV_S :: 25.0;  // in a --dev room (room-dev.coax), so a check can see it
E2M_UNSEEN :: 45.0;         // m: no player this near its home when one appears
E2M_XP :: [2] int.[50, 50]; // SRD XP: Wolf (CR 1/4) 50, Goblin Warrior (CR 1/4) 50
E2M_SHOTS :: 8;
E2M_FORM :: 1;              // its form in the rules' list (E5RR_FORM_WOLF): never a raider's

E2Mon :: struct {
  q: int = -1; id: int;      // its beast slot in the rules (-1 none) and its id
  life: int;                 // each new one a new life: the pages fade it in
  kind: int; group: int; archer: bool;
  state: int = E2M_GONE;
  x: f32; z: f32; yaw: f32; hx: f32; hz: f32; hyaw: f32;
  foe: int = -1;             // the seat it fights
  act: int; act_t: int;      // its blow or shot under way (E2M_ACT_*) and the tick it began; 0 none
  ready: int;                // the tick its next blow may begin
  orbit: f32; spin: f32 = 1; // where round its quarry a wolf circles, and which way
  escape_t: int;             // the tick its Nimble Escape ends
  down_t: int = -100000;     // the tick it fell
  hurt_by: int;              // the seats that hurt it (one bit each): its XP's share
  hit_t: int = -100000; hit_seat: int = -1;   // when it last struck at a player, and whom (the guard's word)
  ray: int = -1; ray_seat: int = -1; seen: bool;   // this tick's line-of-sight question (rm_eg_sights)
}
E2Shot :: struct { live: bool; m: int; seat: int; tx: f32; tz: f32; land: int; }
E2Monsters :: struct { mon: [E2M_N] E2Mon; shots: [E2M_SHOTS] E2Shot; started: bool; }

e2mo_kind :: (m: int) -> int { return ifx m < 8 then E2M_WOLF else E2M_GOBLIN; }
e2mo_group :: (m: int) -> int { return ifx m < 3 then 0 else ifx m < 5 then 1 else ifx m < 8 then 2 else 3; }
// Monster m's home: a pack's in the woods 7 to 9 m off the path's middle; the camp's two by the fire and
// its two archers on their perches.
e2mo_home :: (m: int) -> [3] f32 {
  if m >= 8 {
    j := m - 8;
    if j >= 2 { p := e2_camp_perch(j - 2); return [3] f32.[p[0], p[1], e5rr_heading(e2_road_x(p[1]) - p[0], 0)]; }
    x := e2_camp_x() + ifx j == 0 then -1.4f32 else 1.5f32; z := E2_CAMP_Z + ifx j == 0 then 0.9f32 else -0.7f32;
    return [3] f32.[x, z, e5rr_heading(e2_camp_x() - x, E2_CAMP_Z - z)];
  }
  g := e2mo_group(m); first := ifx g == 0 then 0 else ifx g == 1 then 3 else 5; j := m - first;
  z0 := ifx g == 0 then -175.0f32 else ifx g == 1 then -245.0f32 else -315.0f32;
  side := ifx g == 1 then -1.0f32 else 1.0f32;
  z := z0 + f32(j) * 2.4 - 2.4;
  x := e2_road_x(z) + side * (7.2 + f32(j % 2) * 1.6);
  return [3] f32.[x, z, e5rr_heading(e2_road_x(z) - x, 0)];
}
e2mo_rules_creature :: (kind: int) -> RsCreature {
  return ifx kind == E2M_WOLF then rs_monster(MON_WOLF, "Wolf", E5RR_BEAST_TEAM) else rs_monster(MON_GOBLIN_WARRIOR, "Goblin Warrior", E5RR_BEAST_TEAM);
}
e2mo_block :: (kind: int) -> int { return ifx kind == E2M_WOLF then MON_WOLF else MON_GOBLIN_WARRIOR; }
// Its block's melee attack (the Bite, the Scimitar) and its ranged one (the Shortbow; the Wolf none).
e2mo_melee :: (kind: int) -> RsStatAttack {
  a := rs_monster_action(e2mo_block(kind));
  for q: 0..<a.n { if a.attacks[q].range_ft == 0 { return a.attacks[q]; } }
  return a.attacks[0];
}
e2mo_ranged :: (kind: int) -> RsStatAttack {
  a := rs_monster_action(e2mo_block(kind));
  for q: 0..<a.n { if a.attacks[q].range_ft > 0 { return a.attacks[q]; } }
  return RsStatAttack.{};
}

e2mo_room :: (v: [] RmServer, k: int) -> [] E2Monsters { return v[0].eg[k].monsters[..]; }
e2mo_safe :: (x: f32, z: f32) -> bool { return z > f32(E2M_SAFE_Z); }
// Seat s as a monster's quarry: placed, alive and up, and out of the glade.
e2mo_quarry :: (v: [] RmServer, k: int, s: int) -> bool {
  if s < 0 || s >= EG_SEATS { return false; }
  st := v[0].eg[k].seat[s..<s + 1]; r := v[0].eg[k].rules[..];
  if !st[0].live || !st[0].placed || !r[0].live[s] { return false; }
  c := r[0].b[0].c[E5RR_SEAT + s..<E5RR_SEAT + s + 1];
  return !c[0].dead && c[0].hp > 0 && !e2mo_safe(st[0].pose.x, st[0].pose.z);
}
e2mo_dist :: (ax: f32, az: f32, bx: f32, bz: f32) -> f32 { dx := ax - bx; dz := az - bz; return sqrt(dx * dx + dz * dz); }
e2mo_hz :: (s: f32) -> int { return cast(int)(s * f32(EG_HZ) + 0.5); }

// Monster m stands at home, whole: a new creature of the battle on the rules' first free beast.
e2mo_spawn :: (v: [] RmServer, k: int, m: int) -> bool {
  r := v[0].eg[k].rules[..]; b := r[0].b[..]; mo := e2mo_room(v, k)[0].mon[m..<m + 1];
  q := -1; for o: 0..<E5RR_BEASTS { if q < 0 && r[0].beasts[o].id == 0 && r[0].beasts[o].forge_id == 0 { q = o; } }
  if q < 0 { return false; }
  h := e2mo_home(m); kind := e2mo_kind(m);
  i := E5RR_BEAST0 + q;
  c := e2mo_rules_creature(kind);
  c.x = e5r_sq(h[0]); c.y = e5rr_z_cell(r, h[1]); c.turn_at = b[0].clock + 0.1; c.round_at = b[0].clock;
  b[0].c[i] = c;
  id := r[0].next_id; r[0].next_id += 1;
  r[0].beasts[q] = E5rBeast.{id = id, tag = id, by = -1, spell = -1, form = E2M_FORM, wild = true, x = h[0], z = h[1], yaw = h[2], goal_x = h[0], goal_z = h[1]};
  life := mo[0].life + 1;
  mo[0] = E2Mon.{q = q, id = id, life = life, kind = kind, group = e2mo_group(m), archer = m >= 10, state = E2M_IDLE,
                 x = h[0], z = h[1], yaw = h[2], hx = h[0], hz = h[1], hyaw = h[2], spin = ifx m % 2 == 0 then 1.0f32 else -1.0f32};
  return true;
}
e2mo_creature :: (mo: E2Mon) -> int { return ifx mo.q < 0 then -1 else E5RR_BEAST0 + mo.q; }
// Whether monster m is up in the battle (its slot still its own).
e2mo_up :: (v: [] RmServer, k: int, m: int) -> bool {
  mo := e2mo_room(v, k)[0].mon[m..<m + 1];
  if mo[0].q < 0 || mo[0].state == E2M_DEAD || mo[0].state == E2M_GONE { return false; }
  q := mo[0].q; bt := v[0].eg[k].rules[0].beasts[q..<q + 1]; c := v[0].eg[k].rules[0].b[0].c[E5RR_BEAST0 + q..<E5RR_BEAST0 + q + 1];
  return bt[0].wild && bt[0].id == mo[0].id && !c[0].dead && c[0].hp > 0;
}

// A step of dt toward (tx, tz) at speed, stopping `stop` short, never north past the leash line nor
// where no one stands but the woods' edge. The distance moved.
e2mo_move :: (mo: [] E2Mon, tx: f32, tz: f32, speed: f32, dt: f32, stop: f32) -> f32 {
  dx := tx - mo[0].x; dz := tz - mo[0].z; d := sqrt(dx * dx + dz * dz);
  if d <= stop + 0.001 { return 0; }
  st := speed * dt; if st > d - stop { st = d - stop; }
  nx := mo[0].x + dx / d * st; nz := mo[0].z + dz / d * st;
  if nz > f32(E2M_LEASH_Z) + 4 && nz > mo[0].z { return 0; }
  mo[0].x = nx; mo[0].z = nz;
  return st;
}
// The yaw stays within a half turn of 0: a wolf circling its quarry turns one way lap after lap, and a
// yaw that grew with each lap would pass what the pages take in an h2 row (everglade2-net.coax).
e2mo_wrap :: (a: f32) -> f32 { d := a; while d > 3.14159265 { d -= 6.2831853; } while d < -3.14159265 { d += 6.2831853; } return d; }
e2mo_turn :: (yaw: f32, goal: f32, rate: f32, dt: f32) -> f32 {
  d := e2mo_wrap(goal - yaw);
  m := rate * dt; return e2mo_wrap(yaw + (ifx d > m then m else ifx d < -m then -m else d));
}
// Its group takes up seat s (the pack, the camp all come).
e2mo_rouse :: (v: [] RmServer, k: int, group: int, s: int) {
  ms := e2mo_room(v, k);
  for m: 0..<E2M_N {
    mo := ms[0].mon[m..<m + 1];
    if mo[0].group != group || mo[0].state != E2M_IDLE { continue; }
    mo[0].state = E2M_CHASE; mo[0].foe = s;
    p := v[0].eg[k].seat[s].pose;
    mo[0].orbit = e5rr_heading(mo[0].x - p.x, mo[0].z - p.z);
  }
}
e2mo_home_again :: (mo: [] E2Mon) { mo[0].state = E2M_RETURN; mo[0].foe = -1; mo[0].act = 0; }

// ---- the tick (before the rules' step): spawns, notices, chases, blows and arrows
e2_monsters_tick :: (v: [] RmServer, k: int) {
  if !v[0].eg[k].e2 { return; }
  ms := e2mo_room(v, k); r := v[0].eg[k].rules[..]; b := r[0].b[..];
  t := v[0].eg[k].tick; dt := 1.0f32 / f32(EG_HZ);
  respawn := e2mo_hz(ifx v[0].dev.on then f32(E2M_RESPAWN_DEV_S) else f32(E2M_RESPAWN_S));
  for m: 0..<E2M_N {
    mo := ms[0].mon[m..<m + 1];
    if mo[0].state == E2M_GONE {
      if ms[0].started && t - mo[0].down_t < respawn { continue; }
      h := e2mo_home(m);
      if ms[0].started && e2mo_seen(v, k, h[0], h[1]) { continue; }   // never appears before a player's eyes
      _ := e2mo_spawn(v, k, m); continue;
    }
    if mo[0].state == E2M_DEAD {
      if t - mo[0].down_t >= e2mo_hz(f32(E2M_CORPSE_S)) { mo[0].state = E2M_GONE; mo[0].q = -1; }
      continue;
    }
    // its slot taken by another creature (a check, the rules' own placing): gone, back in time
    if mo[0].q < 0 || !r[0].beasts[mo[0].q].wild || r[0].beasts[mo[0].q].id != mo[0].id { mo[0].state = E2M_GONE; mo[0].q = -1; mo[0].down_t = t; continue; }
    e2mo_step(v, k, m, t, dt);
    bt := r[0].beasts[mo[0].q..<mo[0].q + 1]; i := E5RR_BEAST0 + mo[0].q;
    bt[0].x = mo[0].x; bt[0].z = mo[0].z; bt[0].yaw = mo[0].yaw;
    b[0].c[i].x = e5r_sq(mo[0].x); b[0].c[i].y = e5rr_z_cell(r, mo[0].z);
  }
  ms[0].started = true;
  e2mo_arrows(v, k, t);
}
// Whether a placed player stands within E2M_UNSEEN m of (x, z).
e2mo_seen :: (v: [] RmServer, k: int, x: f32, z: f32) -> bool {
  for s: 0..<EG_SEATS {
    st := v[0].eg[k].seat[s..<s + 1];
    if st[0].live && st[0].placed && e2mo_dist(st[0].pose.x, st[0].pose.z, x, z) < f32(E2M_UNSEEN) { return true; }
  }
  return false;
}
e2mo_step :: (v: [] RmServer, k: int, m: int, t: int, dt: f32) {
  ms := e2mo_room(v, k); mo := ms[0].mon[m..<m + 1]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  kind := mo[0].kind; i := e2mo_creature(mo[0]);
  run := f32(E2M_RUN[kind]);
  if mo[0].state == E2M_IDLE {
    // home: it faces the way it stands, and wakes for the one its line of sight found last tick
    if mo[0].seen && mo[0].ray_seat >= 0 && e2mo_quarry(v, k, mo[0].ray_seat) { e2mo_rouse(v, k, mo[0].group, mo[0].ray_seat); }
    mo[0].seen = false;
    if mo[0].state == E2M_IDLE { mo[0].yaw = e2mo_turn(mo[0].yaw, mo[0].hyaw, 2, dt); return; }
  }
  if mo[0].state == E2M_RETURN {
    went := e2mo_move(mo, mo[0].hx, mo[0].hz, run, dt, 0);
    if went > 0 { mo[0].yaw = e2mo_turn(mo[0].yaw, e5rr_heading(mo[0].hx - mo[0].x, mo[0].hz - mo[0].z), 8, dt); }
    if e2mo_dist(mo[0].x, mo[0].z, mo[0].hx, mo[0].hz) < 0.05 {
      // whole again at home, as an MMO's monster is: its Hit Points and its conditions
      b[0].c[i].hp = b[0].c[i].hp_max; b[0].c[i].cond = 0; b[0].c[i].temp = 0;
      mo[0].state = E2M_IDLE; mo[0].hurt_by = 0; mo[0].act = 0;
    }
    return;
  }
  foe := mo[0].foe;
  if !e2mo_quarry(v, k, foe) {
    // its quarry fell, left or fled into the glade: another of the group's still fighting, else home
    foe = -1;
    for o: 0..<E2M_N { other := ms[0].mon[o]; if o != m && other.group == mo[0].group && other.state == E2M_CHASE && e2mo_quarry(v, k, other.foe) { foe = other.foe; } }
    if foe < 0 { e2mo_home_again(mo); return; }
    mo[0].foe = foe;
  }
  p := v[0].eg[k].seat[foe].pose;
  gap := e2mo_dist(mo[0].x, mo[0].z, p.x, p.z);
  if e2mo_dist(mo[0].x, mo[0].z, mo[0].hx, mo[0].hz) > f32(E2M_LEASH[kind]) || e2mo_dist(p.x, p.z, mo[0].hx, mo[0].hz) > f32(E2M_LEASH[kind]) + 6 || mo[0].z > f32(E2M_LEASH_Z) {
    e2mo_home_again(mo); return;
  }
  face := e5rr_heading(p.x - mo[0].x, p.z - mo[0].z);
  // a blow or a shot under way: it stands to it, facing its quarry, until its tell is out
  if mo[0].act != 0 {
    mo[0].yaw = e2mo_turn(mo[0].yaw, face, 10, dt);
    tell := ifx mo[0].act == E2M_ACT_SHOT then f32(E2M_TELL_SHOT) else f32(E2M_TELL_BLOW[kind]);
    if t - mo[0].act_t < e2mo_hz(tell) { return; }
    if mo[0].act == E2M_ACT_BLOW {
      if gap <= f32(E2M_REACH) + 0.6 { e2mo_blow(v, k, m, foe); }
      else { e2mo_tell(v, k, 1, m, foe, 0, mo[0].x, mo[0].z); }   // it swung at where you were
    } else { e2mo_loose(v, k, m, foe); }
    mo[0].act = 0; mo[0].ready = t + e2mo_hz(rs_beat(b));
    return;
  }
  if mo[0].state == E2M_ESCAPE {
    // Nimble Escape: a Disengage, back from the one who closed on it
    ax := mo[0].x - p.x; az := mo[0].z - p.z; l := sqrt(ax * ax + az * az) + 0.001;
    _ := e2mo_move(mo, mo[0].x + ax / l * 3, mo[0].z + az / l * 3, run, dt, 0);
    mo[0].yaw = e2mo_turn(mo[0].yaw, face, 10, dt);
    if t >= mo[0].escape_t { mo[0].state = E2M_CHASE; }
    return;
  }
  ready := t >= mo[0].ready && rs_can_act(b[0].c[i]);
  if mo[0].archer {
    if gap < f32(E2M_BOW_MIN) && ready {
      mo[0].state = E2M_ESCAPE; mo[0].escape_t = t + e2mo_hz(f32(E2M_ESCAPE_S)); mo[0].ready = t + e2mo_hz(0.3); return;
    }
    if gap <= f32(E2M_BOW) {
      mo[0].yaw = e2mo_turn(mo[0].yaw, face, 8, dt);
      if ready && mo[0].seen { mo[0].act = E2M_ACT_SHOT; mo[0].act_t = t; }
      return;
    }
    _ := e2mo_move(mo, p.x, p.z, run, dt, f32(E2M_BOW) - 2);
    mo[0].yaw = e2mo_turn(mo[0].yaw, face, 8, dt);
    return;
  }
  if kind == E2M_WOLF {
    // the pack circles its quarry, each wolf round its own side, and closes when its bite is ready
    mo[0].orbit += mo[0].spin * f32(E2M_CIRCLE) / f32(E2M_RING) * dt;
    near := ifx ready then 1.2f32 else f32(E2M_RING);
    tx := p.x + sin(mo[0].orbit) * near; tz := p.z + cos(mo[0].orbit) * near;
    speed := ifx gap > f32(E2M_RING) + 1.5 || ready then run else f32(E2M_CIRCLE);
    went := e2mo_move(mo, tx, tz, speed, dt, 0.1);
    mo[0].yaw = e2mo_turn(mo[0].yaw, ifx ready || went < 0.01 then face else e5rr_heading(tx - mo[0].x, tz - mo[0].z), 10, dt);
  } else {
    _ := e2mo_move(mo, p.x, p.z, run, dt, f32(E2M_REACH) * 0.75);
    mo[0].yaw = e2mo_turn(mo[0].yaw, face, 8, dt);
  }
  if ready && gap <= f32(E2M_REACH) { mo[0].act = E2M_ACT_BLOW; mo[0].act_t = t; }
}
// Monster m's blow lands now on seat s: its block's melee attack through the shared strike.
e2mo_blow :: (v: [] RmServer, k: int, m: int, s: int) {
  mo := e2mo_room(v, k)[0].mon[m..<m + 1]; b := v[0].eg[k].rules[0].b[..];
  j := E5RR_SEAT + s; was := b[0].c[j].hp;
  _ := e2mo_strike(b, e2mo_creature(mo[0]), j, e2mo_melee(mo[0].kind), 1);
  mo[0].hit_t = v[0].eg[k].tick; mo[0].hit_seat = s;
  e2mo_tell(v, k, 1, m, s, rs_max(was - b[0].c[j].hp, 0), mo[0].x, mo[0].z);
}
// One attack of creature i at j outside any turn (everglade5e-beasts.coax e5b_strike): whoever's turn
// is running keeps its own turn state.
e2mo_strike :: (b: [] RsBattle, i: int, j: int, a: RsStatAttack, mode: int) -> bool {
  kept := b[0].turn;
  hit := rs_stat_strike(b, i, j, a, mode);
  b[0].turn = kept;
  return hit;
}
// An archer looses at seat s, aimed where s stands: in the air for its flight, landing on the tick after.
e2mo_loose :: (v: [] RmServer, k: int, m: int, s: int) {
  ms := e2mo_room(v, k); mo := ms[0].mon[m]; t := v[0].eg[k].tick;
  p := v[0].eg[k].seat[s].pose;
  q := -1; for o: 0..<E2M_SHOTS { if q < 0 && !ms[0].shots[o].live { q = o; } }
  if q < 0 { return; }
  fly := e2mo_dist(mo.x, mo.z, p.x, p.z) / f32(E2M_ARROW);
  ms[0].shots[q] = E2Shot.{live = true, m = m, seat = s, tx = p.x, tz = p.z, land = t + rs_max(e2mo_hz(fly), 1)};
  ms[0].mon[m].hit_t = t; ms[0].mon[m].hit_seat = s;
  out: [160] u8;
  n := wire_int(out[..], wire_int(out[..], wire_int(out[..], wire_int(out[..], wire_put(out[..], 0, "h3"), t), 3), m), s);
  n = wire_int(out[..], n, 0);
  n = wire_int(out[..], wire_int(out[..], n, cast(int) floor(mo.x * 100 + 0.5)), cast(int) floor(mo.z * 100 + 0.5));
  n = wire_int(out[..], wire_int(out[..], n, cast(int) floor(p.x * 100 + 0.5)), cast(int) floor(p.z * 100 + 0.5));
  n = wire_int(out[..], n, cast(int) floor(fly * 1000 + 0.5));
  e2mo_say(v, k, cast(string) out[0..<n], mo.x, mo.z);
}
// The arrows that land this tick: one at a player still within a metre of where it was aimed is the
// Shortbow's attack roll; one stepped out of, a miss.
e2mo_arrows :: (v: [] RmServer, k: int, t: int) {
  ms := e2mo_room(v, k); b := v[0].eg[k].rules[0].b[..];
  for q: 0..<E2M_SHOTS {
    sh := ms[0].shots[q..<q + 1];
    if !sh[0].live || t < sh[0].land { continue; }
    sh[0].live = false;
    mo := ms[0].mon[sh[0].m]; s := sh[0].seat;
    if !e2mo_up(v, k, sh[0].m) { continue; }
    p := v[0].eg[k].seat[s].pose;
    if !e2mo_quarry(v, k, s) || e2mo_dist(p.x, p.z, sh[0].tx, sh[0].tz) > 1.0 { e2mo_tell(v, k, 1, sh[0].m, s, 0, mo.x, mo.z); continue; }
    j := E5RR_SEAT + s; was := b[0].c[j].hp;
    _ := e2mo_strike(b, e2mo_creature(mo), j, e2mo_ranged(mo.kind), 2);
    e2mo_tell(v, k, 1, sh[0].m, s, rs_max(was - b[0].c[j].hp, 0), mo.x, mo.z);
  }
}

// ---- after the rules' step: the fallen
e2_monsters_after :: (v: [] RmServer, k: int) {
  if !v[0].eg[k].e2 { return; }
  ms := e2mo_room(v, k); r := v[0].eg[k].rules[..]; b := r[0].b[..]; t := v[0].eg[k].tick;
  for m: 0..<E2M_N {
    mo := ms[0].mon[m..<m + 1];
    if mo[0].q < 0 || mo[0].state == E2M_DEAD || mo[0].state == E2M_GONE { continue; }
    i := E5RR_BEAST0 + mo[0].q; id := r[0].beasts[mo[0].q].id;
    if id == mo[0].id && !b[0].c[i].dead && b[0].c[i].hp > 0 { continue; }
    if id == mo[0].id { e5b_gone(b, r[0].beasts[..], E5RR_BEAST0, mo[0].q); }
    mo[0].state = E2M_DEAD; mo[0].down_t = t; mo[0].act = 0; mo[0].foe = -1;
    e2mo_tell(v, k, 4, m, -1, 0, mo[0].x, mo[0].z);
    // its SRD XP, split evenly among the seats that hurt it
    n := 0; for s: 0..<EG_SEATS { if (mo[0].hurt_by & (1 << s)) != 0 && v[0].eg[k].seat[s].live { n += 1; } }
    if n > 0 { for s: 0..<EG_SEATS { if (mo[0].hurt_by & (1 << s)) != 0 && v[0].eg[k].seat[s].live { ev_award(v, k, SeatId.{value = s}, rs_max(E2M_XP[mo[0].kind] / n, 1)); } } }
  }
}

// ---- the players' harm
// A seat's cast at a monster: the creature it harms, when aimed within E2M_AIM m of one standing and not
// on its way home (-1 none).
e2_monster_target :: (v: [] RmServer, k: int, ax: f32, az: f32) -> int {
  if !v[0].eg[k].e2 { return -1; }
  ms := e2mo_room(v, k); best := f32(E2M_AIM); got := -1;
  for m: 0..<E2M_N {
    mo := ms[0].mon[m];
    if !e2mo_up(v, k, m) || mo.state == E2M_RETURN { continue; }
    d := e2mo_dist(ax, az, mo.x, mo.z);
    if d <= best { best = d; got = E5RR_BEAST0 + mo.q; }
  }
  return got;
}
// Seat s's cast at creature i (a monster's, hp_before its Hit Points before): its group turns on s, and
// the harm or the miss is told.
e2_monster_struck :: (v: [] RmServer, k: int, s: int, i: int, hp_before: int) {
  ms := e2mo_room(v, k);
  for m: 0..<E2M_N {
    mo := ms[0].mon[m..<m + 1];
    if mo[0].q < 0 || E5RR_BEAST0 + mo[0].q != i { continue; }
    hp := v[0].eg[k].rules[0].b[0].c[i].hp;
    mo[0].hurt_by = mo[0].hurt_by | (1 << s);
    if mo[0].state == E2M_IDLE && e2mo_quarry(v, k, s) { e2mo_rouse(v, k, mo[0].group, s); }
    e2mo_tell(v, k, 2, m, s, rs_max(hp_before - hp, 0), mo[0].x, mo[0].z);
    return;
  }
}
// For the path's guard: the creature of a monster that struck at a player standing within `reach` m of
// (x, z) in the last ten seconds and is still fighting (-1 none), and where it is.
e2_monster_assailant :: (v: [] RmServer, k: int, x: f32, z: f32, reach: f32) -> int {
  if !v[0].eg[k].e2 { return -1; }
  ms := e2mo_room(v, k); t := v[0].eg[k].tick; best := reach * 3; got := -1;
  for m: 0..<E2M_N {
    mo := ms[0].mon[m];
    if !e2mo_up(v, k, m) || mo.state == E2M_RETURN || t - mo.hit_t > EG_HZ * 10 || mo.hit_seat < 0 { continue; }
    p := v[0].eg[k].seat[mo.hit_seat].pose;
    if e2mo_dist(p.x, p.z, x, z) > reach { continue; }
    d := e2mo_dist(mo.x, mo.z, x, z);
    if d < best { best = d; got = E5RR_BEAST0 + mo.q; }
  }
  return got;
}
// The guard's blow at creature i (a monster's) took `amount` Hit Points (0 a miss): told as a harm at it
// from no seat (-1), so the pages mark it and play its hurt.
e2_monster_guarded :: (v: [] RmServer, k: int, i: int, amount: int) { e2_monster_guarded_at(v, k, v[0].eg[k].tick, i, amount); }
e2_monster_guarded_at :: (v: [] RmServer, k: int, tick: int, i: int, amount: int) {
  ms := e2mo_room(v, k);
  for m: 0..<E2M_N {
    mo := ms[0].mon[m..<m + 1];
    if mo[0].q >= 0 && E5RR_BEAST0 + mo[0].q == i { e2mo_tell_at(v, k, tick, 2, m, -1, amount, mo[0].x, mo[0].z); return; }
  }
}
e2_monster_at :: (v: [] RmServer, k: int, i: int) -> [2] f32 {
  ms := e2mo_room(v, k);
  for m: 0..<E2M_N { mo := ms[0].mon[m]; if mo.q >= 0 && E5RR_BEAST0 + mo.q == i { return [2] f32.[mo.x, mo.z]; } }
  return [2] f32.[0, 0];
}

// ---- line of sight (the host's world answers: room-casts.coax rm_eg_sights)
// This tick's questions from `first` on: a monster at home whose nearest quarry is within its notice,
// and an archer about to draw. How many in all.
e2_monster_sights :: (v: [] RmServer, k: int, first: int) -> int {
  if !v[0].eg[k].e2 { return first; }
  ms := e2mo_room(v, k); next := first;
  for m: 0..<E2M_N {
    mo := ms[0].mon[m..<m + 1];
    mo[0].ray = -1;
    if !e2mo_up(v, k, m) { continue; }
    s := -1;
    if mo[0].state == E2M_IDLE {
      best := f32(E2M_NOTICE[mo[0].kind]) + 0.001;
      for o: 0..<EG_SEATS {
        if !e2mo_quarry(v, k, o) { continue; }
        p := v[0].eg[k].seat[o].pose; d := e2mo_dist(p.x, p.z, mo[0].x, mo[0].z);
        if d < best { best = d; s = o; }
      }
    } else if mo[0].archer && mo[0].state == E2M_CHASE { s = mo[0].foe; }
    if s < 0 { mo[0].seen = false; continue; }
    mo[0].ray = next; mo[0].ray_seat = s; next += 1;
  }
  return next;
}
e2_monster_ray :: (v: [] RmServer, k: int, q: int, out: [] f32) -> bool {
  if !v[0].eg[k].e2 { return false; }
  ms := e2mo_room(v, k);
  for m: 0..<E2M_N {
    mo := ms[0].mon[m];
    if mo.ray != q || mo.ray_seat < 0 { continue; }
    p := v[0].eg[k].seat[mo.ray_seat].pose;
    out[0] = mo.x; out[1] = p.y + 0.9; out[2] = mo.z; out[3] = p.x; out[4] = p.y + 1.1; out[5] = p.z;
    return true;
  }
  return false;
}
e2_monster_seen :: (v: [] RmServer, k: int, q: int, clear: bool) {
  if !v[0].eg[k].e2 { return; }
  ms := e2mo_room(v, k);
  for m: 0..<E2M_N { if ms[0].mon[m].ray == q { ms[0].mon[m].seen = clear; } }
}

// ---- what the pages hear
// An event to every placed seat within EG_VIEW m of (x, z).
e2mo_say :: (v: [] RmServer, k: int, text: string, x: f32, z: f32) {
  room := v[0].eg[k..<k + 1];
  for o: 0..<EG_SEATS {
    st := room[0].seat[o..<o + 1];
    if !st[0].live || !st[0].placed || st[0].conn < 0 || e2mo_dist(st[0].pose.x, st[0].pose.z, x, z) > f32(EG_VIEW) { continue; }
    rl_queue(v, room[0].relay, st[0].conn, -1, text, "");
  }
}
e2mo_tell :: (v: [] RmServer, k: int, kind: int, m: int, s: int, amount: int, x: f32, z: f32) { e2mo_tell_at(v, k, v[0].eg[k].tick, kind, m, s, amount, x, z); }
e2mo_tell_at :: (v: [] RmServer, k: int, tick: int, kind: int, m: int, s: int, amount: int, x: f32, z: f32) {
  out: [96] u8;
  n := wire_int(out[..], wire_int(out[..], wire_int(out[..], wire_int(out[..], wire_put(out[..], 0, "h3"), tick), kind), m), s);
  n = wire_int(out[..], n, amount);
  e2mo_say(v, k, cast(string) out[0..<n], x, z);
}
// The monsters within EG_VIEW m of seat s: each tick they change, and once a second when they don't.
e2_monsters_snapshot :: (v: [] RmServer, k: int, s: int) {
  room := v[0].eg[k..<k + 1]; st := room[0].seat[s..<s + 1]; ms := room[0].monsters[..];
  row: [1600] u8; n := 0; count := 0;
  for m: 0..<E2M_N {
    mo := ms[0].mon[m];
    if mo.state == E2M_GONE || e2mo_dist(st[0].pose.x, st[0].pose.z, mo.x, mo.z) > f32(EG_VIEW) { continue; }
    hp := 0; max := 1;
    if mo.q >= 0 && mo.state != E2M_DEAD { i := E5RR_BEAST0 + mo.q; hp = room[0].rules[0].b[0].c[i].hp; max = room[0].rules[0].b[0].c[i].hp_max; }
    n = wire_int(row[..], wire_int(row[..], wire_int(row[..], wire_int(row[..], n, m), mo.life), mo.kind), mo.state);
    n = wire_int(row[..], wire_int(row[..], n, cast(int) floor(mo.x * 100 + 0.5)), cast(int) floor(mo.z * 100 + 0.5));
    n = wire_int(row[..], wire_int(row[..], wire_int(row[..], n, cast(int) floor(mo.yaw * 1000 + 0.5)), hp), max);
    n = wire_int(row[..], wire_int(row[..], wire_int(row[..], n, mo.act), ifx mo.act != 0 then mo.act_t else (ifx mo.state == E2M_DEAD then mo.down_t else 0)), mo.foe);
    count += 1;
  }
  hash := eg_hash(cast(string) row[0..<n]) + count * 7919;
  if st[0].monster_hash == hash && room[0].tick - st[0].monster_sent < EG_HZ { return; }
  st[0].monster_hash = hash; st[0].monster_sent = room[0].tick;
  out: [1700] u8;
  q := wire_int(out[..], wire_int(out[..], wire_put(out[..], 0, "h2"), room[0].tick), count);
  q = wire_put(out[..], q, cast(string) row[0..<n]);
  rl_queue(v, room[0].relay, st[0].conn, -1, cast(string) out[0..<q], "");
}

// ---- checks
e2mt_room :: (v: [] RmServer, code: string) -> int {
  rm_init(v); rm_clock(v, 0, 1762190000000);
  path: [128] u8; n := wire_put(path[..], 0, "GET /api/room/relay/everglade/"); n = wire_put(path[..], n, code); n = wire_put(path[..], n, " HTTP/1.1\r\n\r\n");
  if rm_join(v, 0, cast(string) path[0..<n]) != 0 { return -1; }
  k := eg_room_at(v, v[0].conns[0].relay);
  rm_heard(v, 0, "H 5 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v, k);
  return k;
}
// A check's tick with every line of sight answered `clear`.
e2mt_tick :: (v: [] RmServer, k: int) { rc_test_tick(v, k, true); }
e2mt_at :: (v: [] RmServer, k: int, x: f32, z: f32) { v[0].eg[k].seat[0].pose.x = x; v[0].eg[k].seat[0].pose.z = z; e5rr_place(v[0].eg[k].rules[..], 0, x, z); }
e2mt_count :: (v: [] RmServer, k: int, states: int) -> int {
  n := 0; for m: 0..<E2M_N { if (states & (1 << v[0].eg[k].monsters[0].mon[m].state)) != 0 { n += 1; } } return n;
}

#test "e2 monsters: the packs and the camp stand at home in the woods and the clearing, none in the glade" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-monsters"); #assert k >= 0;
  ms := v[0].eg[k].monsters[..];
  for q: 0..<3 { e2mt_tick(v[..], k); }
  wolves := 0; goblins := 0;
  for m: 0..<E2M_N {
    mo := ms[0].mon[m];
    #assert mo.state == E2M_IDLE && mo.q >= 0 && e2mo_up(v[..], k, m);
    #assert mo.z < f32(E2M_LEASH_Z) - 40 && e2_may_stand(mo.x, mo.z);
    c := v[0].eg[k].rules[0].b[0].c[E5RR_BEAST0 + mo.q];
    if mo.kind == E2M_WOLF { wolves += 1; #assert c.hp == 11 && c.ac == 12 && e2_road_dist(mo.x, mo.z) > 6; }
    else { goblins += 1; #assert c.hp == 10 && c.ac == 15 && e2_clearing(mo.x, mo.z) > 0.5; }
  }
  #assert wolves == 8 && goblins == 4;
  #assert e2mo_melee(E2M_WOLF).name == "Bite" && e2mo_melee(E2M_GOBLIN).name == "Scimitar" && e2mo_ranged(E2M_GOBLIN).name == "Shortbow";
  // the archers stand higher than the fire
  #assert e2_height(ms[0].mon[10].x, ms[0].mon[10].z) >= e2_height(e2_camp_x(), E2_CAMP_Z) - 0.05;
}
#test "e2 monsters: the safe glade holds no quarry; a wolf notices you near, and its pack chases and bites" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-wolves"); #assert k >= 0;
  ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..];
  b[0].c[E5RR_SEAT].hp = 200; b[0].c[E5RR_SEAT].hp_max = 200; b[0].c[E5RR_SEAT].ac = 5;
  // in the glade nothing stirs, nor asks to see you
  for q: 0..<EG_HZ * 3 { e2mt_at(v[..], k, 0, -10); e2mt_tick(v[..], k); }
  #assert e2mt_count(v[..], k, 1 << E2M_IDLE) == E2M_N && e2_monster_sights(v[..], k, 0) == 0;
  #assert !e2mo_quarry(v[..], k, 0);
  // 20 m from the first pack: no one notices
  w := ms[0].mon[0]; px := e2_road_x(w.z - 20); pz := w.z - 20;
  for q: 0..<EG_HZ { e2mt_at(v[..], k, px, pz); e2mt_tick(v[..], k); }
  #assert ms[0].mon[0].state == E2M_IDLE;
  // 10 m: the pack comes, all three, and bites
  px = e2_road_x(w.z - 8); pz = w.z - 8;
  bit := false; most := 0;
  for q: 0..<EG_HZ * 8 {
    e2mt_at(v[..], k, px, pz); e2mt_tick(v[..], k);
    n := 0; for m: 0..<3 { if ms[0].mon[m].state == E2M_CHASE { n += 1; } } if n > most { most = n; }
    if b[0].c[E5RR_SEAT].hp < 200 { bit = true; }
  }
  #assert most == 3 && bit;
  for m: 3..<E2M_N { #assert ms[0].mon[m].state == E2M_IDLE; }
  // they circle you, round their own sides
  a0 := e5rr_heading(ms[0].mon[0].x - px, ms[0].mon[0].z - pz); a1 := e5rr_heading(ms[0].mon[1].x - px, ms[0].mon[1].z - pz);
  #assert abs(a0 - a1) > 0.2 && e2mo_dist(ms[0].mon[0].x, ms[0].mon[0].z, px, pz) < 4;
}
#test "e2 monsters: a pack circling its quarry lap after lap keeps every yaw within a half turn" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-laps"); #assert k >= 0;
  ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..];
  b[0].c[E5RR_SEAT].hp = 20000; b[0].c[E5RR_SEAT].hp_max = 20000; b[0].c[E5RR_SEAT].ac = 30;
  w := ms[0].mon[0]; px := e2_road_x(w.z - 8); pz := w.z - 8;
  chased := false; lap: f32 = 0; was := ms[0].mon[0].orbit;
  for q: 0..<EG_HZ * 30 {
    e2mt_at(v[..], k, px, pz); e2mt_tick(v[..], k);
    if ms[0].mon[0].state == E2M_CHASE { chased = true; lap += abs(ms[0].mon[0].orbit - was); }
    was = ms[0].mon[0].orbit;
    for m: 0..<E2M_N { #assert abs(ms[0].mon[m].yaw) <= 3.1416; }
  }
  #assert chased && lap > 12.6;   // two laps and more round you
  #assert e2mo_wrap(7.5) < 3.1416 && e2mo_wrap(-7.5) > -3.1416 && abs(e2mo_turn(3.1, -3.1, 10, 0.1) + 3.1) < 0.001;
}
#test "e2 monsters: the leash takes the pack home before the glade and makes it whole there" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-leash"); #assert k >= 0;
  ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..];
  b[0].c[E5RR_SEAT].hp = 500; b[0].c[E5RR_SEAT].hp_max = 500;
  w := ms[0].mon[0]; z := w.z - 8;
  for q: 0..<EG_HZ { e2mt_at(v[..], k, e2_road_x(z), z); e2mt_tick(v[..], k); }
  #assert ms[0].mon[0].state == E2M_CHASE;
  i := E5RR_BEAST0 + ms[0].mon[0].q; b[0].c[i].hp = 4;
  // you run north up the path toward the glade at a jog: they let you go before it
  went := false; north: f32 = -1000;
  for q: 0..<EG_HZ * 40 {
    z += f32(E2_RUN_SPEED) / f32(EG_HZ); if z > -30 { z = -30; }
    e2mt_at(v[..], k, e2_road_x(z), z); e2mt_tick(v[..], k);
    for m: 0..<3 { if ms[0].mon[m].z > north { north = ms[0].mon[m].z; } if ms[0].mon[m].state == E2M_RETURN { went = true; } }
  }
  #assert went && north < f32(E2M_LEASH_Z) + 4.5;
  for m: 0..<3 { #assert ms[0].mon[m].state == E2M_IDLE && e2mo_dist(ms[0].mon[m].x, ms[0].mon[m].z, ms[0].mon[m].hx, ms[0].mon[m].hz) < 0.1; }
  #assert b[0].c[i].hp == b[0].c[i].hp_max;
}
#test "e2 monsters: a goblin archer looses an arrow that flies before it lands; a step aside makes it miss" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-camp"); #assert k >= 0;
  ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..];
  b[0].c[E5RR_SEAT].hp = 500; b[0].c[E5RR_SEAT].hp_max = 500; b[0].c[E5RR_SEAT].ac = 1;
  a := ms[0].mon[10]; px := a.x + 12; pz := a.z + 3;
  out: [262144] u8; _ := e2rt_heard(v[..], 0, out[..]);
  loosed := false; flying := false; hit := false;
  for q: 0..<EG_HZ * 6 {
    e2mt_at(v[..], k, px, pz); e2mt_tick(v[..], k);
    for o: 0..<E2M_SHOTS { if ms[0].shots[o].live && ms[0].shots[o].m == 10 { flying = true; } }
    heard := e2rt_heard(v[..], 0, out[..]);
    if eg_test_has(heard, "h3 ") { loosed = loosed || ms[0].mon[10].hit_t > 0; }
    if b[0].c[E5RR_SEAT].hp < 500 { hit = true; }
  }
  #assert loosed && flying && hit;
  // the next: you step two metres aside while it flies, and it misses
  hp := b[0].c[E5RR_SEAT].hp; stepped := false; dodged := false;
  for q: 0..<EG_HZ * 6 {
    live := false; for o: 0..<E2M_SHOTS { if ms[0].shots[o].live { live = true; } }
    if live && !stepped { stepped = true; px += 2.5; }
    e2mt_at(v[..], k, px, pz); e2mt_tick(v[..], k);
    if stepped && !live { dodged = true; break; }
  }
  #assert stepped && dodged;
  // a player who closes on an archer makes it step back (Nimble Escape)
  esc := false; for q: 0..<EG_HZ * 4 { e2mt_at(v[..], k, ms[0].mon[10].x + 2, ms[0].mon[10].z); e2mt_tick(v[..], k); if ms[0].mon[10].state == E2M_ESCAPE { esc = true; } }
  #assert esc && b[0].c[E5RR_SEAT].hp <= hp;
}
#test "e2 monsters: a player's harm turns the group on them; the fallen give their XP, lie, and come back unseen" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-fall"); #assert k >= 0;
  v[0].dev.on = true;
  ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..];
  b[0].c[E5RR_SEAT].hp = 500; b[0].c[E5RR_SEAT].hp_max = 500;
  w := ms[0].mon[3]; e2mt_at(v[..], k, e2_road_x(w.z), w.z - 25); e2mt_tick(v[..], k);
  i := E5RR_BEAST0 + w.q;
  #assert e2_monster_target(v[..], k, w.x + 0.5, w.z) == i && e2_monster_target(v[..], k, w.x + 3, w.z) == -1;
  hp := b[0].c[i].hp; b[0].c[i].hp = 0; b[0].c[i].dead = true;
  e2_monster_struck(v[..], k, 0, i, hp);
  #assert ms[0].mon[3].state == E2M_CHASE && ms[0].mon[4].state == E2M_CHASE && ms[0].mon[3].foe == 0;
  xp := v[0].ev[k].xp[0];
  for q: 0..<2 { e2mt_tick(v[..], k); }
  #assert ms[0].mon[3].state == E2M_DEAD;
  #assert v[0].ev[k].xp[0] > xp;
  life := ms[0].mon[3].life;
  for q: 0..<e2mo_hz(f32(E2M_CORPSE_S)) + 2 { e2mt_tick(v[..], k); }
  #assert ms[0].mon[3].state == E2M_GONE;
  // standing near its home it stays gone; away, it comes back whole, a new life
  for q: 0..<e2mo_hz(f32(E2M_RESPAWN_DEV_S)) { e2mt_at(v[..], k, ms[0].mon[3].hx, ms[0].mon[3].hz - 20); e2mt_tick(v[..], k); }
  #assert ms[0].mon[3].state == E2M_GONE;
  for q: 0..<3 { e2mt_at(v[..], k, 0, -10); e2mt_tick(v[..], k); }
  #assert ms[0].mon[3].state == E2M_IDLE && ms[0].mon[3].life == life + 1 && e2mo_up(v[..], k, 3);
  // the guard's word: a monster that struck at a player near him
  #assert e2_monster_assailant(v[..], k, 0, -10, 8) == -1;
}

#test "e2 monsters: the path's guard goes for a wolf that bites a player near him, and strikes it" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2mt_room(v[..], "pair-e2-guarded"); #assert k >= 0;
  ms := v[0].eg[k].monsters[..]; b := v[0].eg[k].rules[0].b[..]; g := v[0].eg[k].guard[..];
  b[0].c[E5RR_SEAT].hp = 500; b[0].c[E5RR_SEAT].hp_max = 500;
  for q: 0..<3 { e2mt_tick(v[..], k); }
  #assert g[0].q >= 0;
  w := ms[0].mon[0]; pz := w.hz - 4; px := e2_road_x(pz);
  e2mt_at(v[..], k, px, pz);
  // the guard a few steps off on the path, and the wolf's bite at the player just landed
  g[0].x = e2_road_x(pz - 6); g[0].z = pz - 6;
  e2mo_rouse(v[..], k, ms[0].mon[0].group, 0);
  ms[0].mon[0].hit_t = v[0].eg[k].tick; ms[0].mon[0].hit_seat = 0;
  i := E5RR_BEAST0 + ms[0].mon[0].q; before := g[0].swing_tick;
  e2mt_tick(v[..], k);
  #assert g[0].beast == i && g[0].foe == -1 && g[0].state == E2G_FIGHTING;
  for q: 0..<EG_HZ * 8 { e2mt_at(v[..], k, px, pz); e2mt_tick(v[..], k); if g[0].swing_tick != before { break; } }
  #assert g[0].swing_tick != before;
  // far from any player struck, he lets it be: no monster is his foe of its own
  #assert e2_monster_assailant(v[..], k, px + 60, pz, f32(E2G_DEFEND)) == -1;
}
