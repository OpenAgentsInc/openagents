}

#test "e2 familiar: borrowed senses spend the owner's Bonus Action and expire" #steps 4000000000 {
  v:[1]RmServer;
  k:=e2rt_room(v[..],"srd-druid-2");
  #assert k>=0;
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..]; f:=rs_familiar_of(b,0);
  egb_step(r,b[0].c[0].turn_at+100000);
  rm_heard(v[..],0,"M1 1 8 0"); rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead;
  rm_heard(v[..],0,"M7 2"); rc_test_tick(v[..],k,true);
  #assert r[0].seat[0].turn.bonus && rs_familiar_observer(b,0)==f;
  out:[16384]u8;
  got:=e2rt_heard(v[..],0,out[..]);
  #assert eg_test_has(got,"m7 2") && eg_test_has(got,"m8 2");
  b[0].c[f].cond|=RS_DEAFENED;
