// Everglade II familiar requests and snapshots on the shared room battle.
#test "e2 familiar: room checks geometry and spends one saved Wild Companion use" #steps 4000000000 {
  v:[1]RmServer; rm_init(v[..]); rm_clock(v[..],0,1762190000000);
  path:="GET /api/room/relay/everglade/pair-e2-familiar HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..],0,path)==0 && rm_join(v[..],1,path)==1;
  k:=eg_room_at(v[..],v[0].conns[0].relay);
  rm_heard(v[..],0,"H 5 ranger.0.0.0 srd-druid-2 0 -");
  rm_heard(v[..],1,"H 5 ranger.0.0.0 srd-fighter 0 -");
  for q:0..<3 { eg_test_tick(v[..],k); }
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..];
  f:=rs_familiar_of(b,0); #assert f>=EGB_BEAST0+EGB_BEASTS && b[0].c[f].dead;
  #assert b[0].c[0].companion && v[0].eg[k].seat[0].placed;
  egb_step(r,b[0].c[0].turn_at+0.1);

  #assert r[0].seat[0].open;
  uses:=b[0].c[0].uses[RS_USE_WILD];
  rm_heard(v[..],0,"M1 1 8 0");
  rc_test_tick(v[..],k,false);
  #assert b[0].c[f].dead && b[0].c[0].uses[RS_USE_WILD]==uses;
  rm_heard(v[..],1,"M1 1 0 0");
  rm_heard(v[..],0,"M1 2 8 0");
  #assert v[0].eg[k].seat[0].familiar.pending==2;
  rc_test_tick(v[..],k,true);
  #assert rs_up(b[0].c[f]) && b[0].c[f].familiar_form==MON_OWL && b[0].c[f].familiar_spirit==RS_FAMILIAR_FEY;
  #assert b[0].c[0].uses[RS_USE_WILD]==uses-1 && r[0].seat[0].turn.action;
  #assert b[0].c[rs_familiar_of(b,1)].dead;
  out:[16384]u8; wire:[128]u8;
  prefix:=wire_int(wire[..],wire_put(wire[..],0,"m2"),v[0].eg[k].tick);
  n:=wire_put(wire[..],prefix," 1 0 8 ");
  ack:=false; seen_owner:=false; seen_peer:=false;
  while true {
    got:=rm_relay_next(v[..]); if got==0 { break; }
    frame:=cast(string)v[0].rout[0..<got];
    if eg_test_has(frame,"m1 2 8") && v[0].rto[0] { ack=true; }
    if !eg_test_has(frame,cast(string)wire[0..<n]) { continue; }
    if v[0].rto[0] { seen_owner=true; }
    if v[0].rto[1] { seen_peer=true; }
  }
  #assert ack && seen_owner && seen_peer;
  v[0].eg[k].im[0].blocks[1]=1;
  rm_heard(v[..],0,"M1 2 0 0");
  rc_test_tick(v[..],k,true);
  prefix=wire_int(wire[..],wire_put(wire[..],0,"m2"),v[0].eg[k].tick);
  n=wire_put(wire[..],prefix," 0");
  #assert eg_test_has(e2rt_heard(v[..],1,out[..]),cast(string)wire[0..<n]);
  #assert b[0].c[f].familiar_form==MON_OWL && b[0].c[0].uses[RS_USE_WILD]==uses-1;
  egb_step(r,b[0].c[f].turn_at+0.1);
  #assert r[0].familiar[0].open;
  b[0].c[0].long_rest.phase=3;
  #assert rs_long_rest_apply(b,0) && b[0].c[f].dead;
  rc_test_tick(v[..],k,true);
  prefix=wire_int(wire[..],wire_put(wire[..],0,"m2"),v[0].eg[k].tick);
  n=wire_put(wire[..],prefix," 0");
  #assert eg_test_has(e2rt_heard(v[..],0,out[..]),cast(string)wire[0..<n]);
}

#test "e2 familiar: Wizard ritual continues on saved turns and pays only on room placement" #steps 4000000000 {
  v:[1]RmServer; rm_init(v[..]); rm_clock(v[..],0,1762190000000);
  #assert rm_join(v[..],0,"GET /api/room/relay/everglade/pair-e2-wizard HTTP/1.1\r\n\r\n")==0;
  k:=eg_room_at(v[..],v[0].conns[0].relay);
  rm_heard(v[..],0,"H 5 ranger.0.0.0 srd-wizard 0 -");
  for q:0..<3 { eg_test_tick(v[..],k); }
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..]; f:=rs_familiar_of(b,0);
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M3 1 8 0 2");
  rc_test_tick(v[..],k,true);
  #assert b[0].c[0].rite==SP_FIND_FAMILIAR && b[0].c[0].rite_until-b[0].clock==4200;
  #assert b[0].c[f].dead && b[0].c[0].materials[0].count==1 && r[0].seat[0].turn.action;
  egb_step(r,b[0].c[0].turn_at+0.1);
  #assert b[0].c[0].rite_owed;
  rc_test_tick(v[..],k,true);
  #assert !b[0].c[0].rite_owed && r[0].seat[0].turn.action;
  egb_step(r,b[0].c[0].rite_until+0.1);
  slots:=b[0].c[0].slots[1];
  rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead && b[0].c[f].familiar_form==MON_OWL && b[0].c[f].familiar_spirit==2;
  #assert b[0].c[0].rite<0;
  #assert b[0].c[0].materials[0].count==0;
  #assert b[0].c[0].slots[1]==slots;
  out:[16384]u8;
  #assert eg_test_has(e2rt_heard(v[..],0,out[..]),"m3 1 2");
}

#test "e2 familiar: Wizard prepared cast pays only after clear completion" #steps 4000000000 {
  v:[1]RmServer; rm_init(v[..]); rm_clock(v[..],0,1762190000000);
  #assert rm_join(v[..],0,"GET /api/room/relay/everglade/pair-e2-prepared HTTP/1.1\r\n\r\n")==0;
  k:=eg_room_at(v[..],v[0].conns[0].relay);
  rm_heard(v[..],0,"H 5 ranger.0.0.0 srd-wizard 0 -");
  for q:0..<3 { eg_test_tick(v[..],k); }
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..]; f:=rs_familiar_of(b,0);
  out:[16384]u8;
  for seq:1..<3 {
    egb_step(r,b[0].c[0].turn_at+0.1);
    wire:[64]u8;
    n:=wire_put(wire[..],wire_int(wire[..],wire_put(wire[..],0,"M3"),seq)," 8 1 3");
    rm_heard(v[..],0,cast(string)wire[0..<n]);
    rc_test_tick(v[..],k,true);
    #assert b[0].c[0].rite==SP_FIND_FAMILIAR && abs(b[0].c[0].rite_until-b[0].clock-3600)<0.01;
    #assert b[0].c[0].materials[0].count==1 && b[0].c[f].dead;
    egb_step(r,b[0].c[0].rite_until+0.1);
    slots:=b[0].c[0].slots[1];
    rc_test_tick(v[..],k,seq==2);
    #assert b[0].c[0].rite<0;
    response:=e2rt_heard(v[..],0,out[..]);
    if seq==1 {
      #assert eg_test_has(response,"m3 1 3");
      #assert b[0].c[f].dead && b[0].c[0].materials[0].count==1 && b[0].c[0].slots[1]==slots;
    } else {
      #assert eg_test_has(response,"m3 2 2");
      #assert !b[0].c[f].dead && b[0].c[f].familiar_spirit==RS_FAMILIAR_FIEND;
      #assert b[0].c[0].materials[0].count==0 && b[0].c[0].slots[1]==slots-1;
    }
  }
}

E2Familiar :: struct {
  last:int; pending:int; active:int; wizard:bool; spirit:int; order:int;
  form:int; slot:int; target:int; ray:int=-1; x:int; y:int; clear:bool;
}
// ---- the familiar frames: the room's one reader and writers (proto/verse/everglade-familiar*-v1.json and
// everglade-find-familiar-v1.json; coax/web/tool.sh coax/web/room/familiar-profile.coax PROFILE checks them)
// A request's order: 0 a summons (M1, or the Wizard's M3), 1 to 3 the lifecycle's (M4), then step (M5),
// cure (M6) and senses (M7).
E2_FAMILIAR_POCKET :: 1; E2_FAMILIAR_RECALL :: 2; E2_FAMILIAR_RELEASE :: 3;
E2_FAMILIAR_STEP :: 4; E2_FAMILIAR_CURE :: 5; E2_FAMILIAR_SENSES :: 6;
// m3's status, and m8's mode: whose senses the owner has.
E2_WIZARD_CASTING :: 1; E2_WIZARD_COMPLETE :: 2; E2_WIZARD_INTERRUPTED :: 3;
E2_SENSE_OWNER :: 0; E2_SENSE_SIGHT :: 1; E2_SENSE_SIGHT_HEARING :: 2;
// The refusal's reason: r SEQ familiar.
E2_FAMILIAR_REFUSED :: "familiar";
// A request as read: ok false when it is no familiar request or a field is missing, extra or bad.
// choice is M1 and M3's FORM, M4's ORDER and M6's SEAT; slot is M1 and M3's SLOT; spirit M3's SPIRIT.
E2FamiliarAsk :: struct { ok:bool; wizard:bool; lifecycle:bool; touch:bool; step:bool; sense:bool; seq:int; choice:int; slot:int; spirit:int; }
e2_familiar_read :: (text:string)->E2FamiliarAsk {
  wizard:=wire_is(text,"M3");
  step:=wire_is(text,"M5");
  touch:=wire_is(text,"M6");
  sense:=wire_is(text,"M7");
  lifecycle:=wire_is(text,"M4") || step || touch || sense;
  if !wizard && !lifecycle && !wire_is(text,"M1") { return E2FamiliarAsk.{}; }
  rd:=[1]WireRd.[wire_rd(text,2)];
  seq:=wire_num(text,rd[..]); choice:=ifx sense then E2_FAMILIAR_SENSES else ifx step then E2_FAMILIAR_STEP else wire_num(text,rd[..]);
  slot:=ifx lifecycle then 0 else wire_num(text,rd[..]);
  spirit:=ifx wizard then wire_num(text,rd[..]) else RS_FAMILIAR_FEY;
  ok:=rd[0].ok && !wire_more(text,rd[..]) && seq>0;
  return E2FamiliarAsk.{ok=ok,wizard=wizard,lifecycle=lifecycle,touch=touch,step=step,sense=sense,seq=seq,choice=choice,slot=slot,spirit=spirit};
}
// The success reply to request seq of order: m1 SEQ FORM, m4 SEQ ORDER, m5 SEQ, m6 SEQ or m7 SEQ.
e2_familiar_put_done :: (out:[]u8,order:int,seq:int,form:int)->int {
  kind:=ifx order==E2_FAMILIAR_SENSES then "m7" else ifx order==E2_FAMILIAR_CURE then "m6" else ifx order==E2_FAMILIAR_STEP then "m5" else ifx order>0 then "m4" else "m1";
  n:=wire_int(out,wire_put(out,0,kind),seq);
  if order<E2_FAMILIAR_STEP { n=wire_int(out,n,ifx order>0 then order else form); }
  return n;
}
// m3 SEQ STATUS, m8 MODE.
e2_familiar_put_status :: (out:[]u8,seq:int,status:int)->int { return wire_int(out,wire_int(out,wire_put(out,0,"m3"),seq),status); }
e2_familiar_put_sense :: (out:[]u8,mode:int)->int { return wire_int(out,wire_put(out,0,"m8"),mode); }
// m2 TICK COUNT [OWNER FORM X Z HP MAX]...: one row appended at at, then the frame round count rows.
e2_familiar_put_row :: (rows:[]u8,at:int,owner:int,form:int,x:int,z:int,hp:int,hp_max:int)->int {
  size:=wire_int(rows,wire_int(rows,wire_int(rows,at,owner),form),x);
  return wire_int(rows,wire_int(rows,wire_int(rows,size,z),hp),hp_max);
}
e2_familiar_put_rows :: (out:[]u8,tick:int,count:int,rows:string)->int {
  return wire_put(out,wire_int(out,wire_int(out,wire_put(out,0,"m2"),tick),count),rows);
}

e2_familiar_ask :: (v:[]RmServer,k:int,id:SeatId,text:string) {
  ask:=e2_familiar_read(text);
  if !ask.ok { return; }
  wizard:=ask.wizard; lifecycle:=ask.lifecycle; touch:=ask.touch; step:=ask.step; sense:=ask.sense;
  seq:=ask.seq; choice:=ask.choice; slot:=ask.slot; spirit:=ask.spirit;
  req:=v[0].eg[k].seat[id.value].familiar;
  if seq<=req.last { return; }
  req.last=seq;
  valid:=ifx touch then choice>=0 && choice<EG_SEATS else ifx lifecycle then step || sense || (choice>=E2_FAMILIAR_POCKET && choice<=E2_FAMILIAR_RELEASE) else choice>=0 && choice<RS_FAMILIAR_FORMS.count && slot>=0 && slot<=9 &&
    spirit>=RS_FAMILIAR_FEY && spirit<=RS_FAMILIAR_FIEND;
  if req.pending>0 || req.active>0 || !valid {
    eg_refuse(v,k,id,seq,E2_FAMILIAR_REFUSED);
  } else {
    req.pending=seq; req.wizard=wizard; req.order=ifx touch then E2_FAMILIAR_CURE else ifx lifecycle then choice else 0;
    req.target=choice;
    req.form=choice; req.slot=slot; req.spirit=spirit;
  }
  v[0].eg[k].seat[id.value].familiar=req;
}
// At most one Reaction per room creature. Each candidate gets its own
// sight query from the attacker to the familiar's departure square.
E2StepReactions :: struct { n:int; choice:[EGB_BEASTS]RsOpportunityChoice; }

e2_familiar_heal_target :: (v:[]RmServer,k:int,s:int,target:int)->bool {
  room:=v[0].eg[k..<k+1]; rules:=room[0].rules[..]; b:=rules[0].b[..];
  if !room[0].seat[target].live || !room[0].seat[target].placed || !rules[0].live[target] { return false; }
  if (room[0].im[0].blocks[s]&(1<<target))!=0 || (room[0].im[0].blocks[target]&(1<<s))!=0 { return false; }
  c:=b[0].c[EGB_SEAT+target..<EGB_SEAT+target+1];
  return !c[0].dead && c[0].hp<c[0].hp_max;
}

e2_familiar_sights :: (v:[]RmServer,k:int,first:int)->int {
  room:=v[0].eg[k..<k+1]; b:=room[0].rules[0].b[..]; next:=first;
  for s:0..<EG_SEATS {
    st:=room[0].seat[s..<s+1]; req:=st[0].familiar;
    if req.pending<=0 && req.active<=0 { continue; }
    req.ray=-1; req.clear=false;
    actor:=EGB_SEAT+s;
    if req.order==5 {
      f:=room[0].rules[0].familiar[s].me;
      if st[0].placed && room[0].rules[0].live[s] && e2_familiar_heal_target(v,k,s,req.target) &&
        rs_familiar_touch_ready(b,actor,SP_CURE_WOUNDS,f) && rs_feet_to(b,f,EGB_SEAT+req.target)<=5 {
        req.ray=next; next+=1;
      }
      st[0].familiar=req; continue;
    }
    if req.order==4 {
      f:=room[0].rules[0].familiar[s].me;
      reactions:=room[0].familiar_reactions[s..<s+1]; reactions[0].n=0;
      if st[0].placed && room[0].rules[0].live[s] && room[0].rules[0].familiar[s].open && !b[0].c[f].dead {
        angle:=st[0].pose.yaw;
        req.x=b[0].c[f].x+int(floor(sin(angle)+0.5));
        req.y=b[0].c[f].y+int(floor(cos(angle)+0.5));
        req.ray=next;
        // no creature of Everglade II takes an Opportunity Attack at a familiar's Step: v1's raiders and
        // forge orders did, and they are gone (#13346)
        next+=1+reactions[0].n;
      }
      st[0].familiar=req; continue;
    }
    place:=ifx req.order>0 then req.order==2 else ifx req.wizard then req.active>0 && rs_rite_due_now(b,actor,SP_FIND_FAMILIAR) else b[0].c[actor].companion;
    if st[0].live && st[0].placed && room[0].rules[0].live[s] && place {
      familiar:=room[0].rules[0].familiar[s].me;
      if req.wizard && b[0].c[familiar].hp>0 { req.clear=true; st[0].familiar=req; continue; }
      for step:0..<8 {
        angle:=st[0].pose.yaw+f32(step)*0.7853982;
        x:=b[0].c[actor].x+int(floor(sin(angle)+0.5));
        y:=b[0].c[actor].y+int(floor(cos(angle)+0.5));
        if !rs_familiar_destination(b,actor,x,y,2) { continue; }
        req.x=x; req.y=y; req.ray=next; next+=1; break;
      }
    }
    st[0].familiar=req;
  }
  return next;
}
e2_familiar_ray :: (v:[]RmServer,k:int,q:int,out:[]f32)->bool {
  seats:=v[0].eg[k].seat[..]; rules:=v[0].eg[k].rules[..];
  for s:0..<EG_SEATS {
    req:=seats[s].familiar;
    if req.ray<0 || (req.pending<=0 && req.active<=0) { continue; }
    if req.order==4 && q>req.ray {
      reactions:=v[0].eg[k].familiar_reactions[s..<s+1];
      index:=q-req.ray-1;
      if index>=reactions[0].n { continue; }
      b:=rules[0].b[..]; f:=rules[0].familiar[s].me;
      i:=reactions[0].choice[index].actor;
      out[0]=egb_cell_m(b[0].c[i].x); out[1]=0; out[2]=egb_cell_z(rules,b[0].c[i].y);
      out[3]=egb_cell_m(b[0].c[f].x); out[4]=0; out[5]=egb_cell_z(rules,b[0].c[f].y);
      return true;
    }
    if req.ray!=q { continue; }
    p:=seats[s].pose;
    out[0]=p.x; out[1]=p.y; out[2]=p.z;
    if req.order==4 || req.order==5 {
      f:=v[0].eg[k].rules[0].familiar[s].me; b:=v[0].eg[k].rules[0].b[..];
      out[0]=egb_cell_m(b[0].c[f].x);
      out[1]=0;
      out[2]=egb_cell_z(rules,b[0].c[f].y);
    }
    if req.order==5 {
      target:=seats[req.target].pose;
      out[3]=target.x; out[4]=out[1]; out[5]=target.z;
      return true;
    }
    out[3]=egb_cell_m(req.x); out[4]=out[1];
    out[5]=egb_cell_z(rules,req.y);
    return true;
  }
  return false;
}
e2_familiar_seen :: (v:[]RmServer,k:int,q:int,clear:bool) {
  for s:0..<EG_SEATS {
    st:=v[0].eg[k].seat[s..<s+1];
    req:=st[0].familiar;
    if req.ray<0 || (req.pending<=0 && req.active<=0) { continue; }
    if req.ray==q { st[0].familiar.clear=clear; return; }
    if req.order==4 && q>req.ray {
      reactions:=v[0].eg[k].familiar_reactions[s..<s+1];
      index:=q-req.ray-1;
      if index<reactions[0].n { reactions[0].choice[index].seen=clear; return; }
    }
  }
}
// Status one begins the cast, two completes it, and three ends it without payment.
e2_wizard_status :: (v:[]RmServer,k:int,s:int,seq:int,status:int) {
  out:[64]u8;
  n:=e2_familiar_put_status(out[..],seq,status);
  rl_queue(v,v[0].eg[k].relay,v[0].eg[k].seat[s].conn,-1,cast(string)out[0..<n],"");
}
e2_wizard_cast :: (v:[]RmServer,k:int,s:int,admitted:bool) {
  room:=v[0].eg[k..<k+1]; st:=room[0].seat[s..<s+1]; req:=st[0].familiar;
  b:=room[0].rules[0].b[..]; seat:=room[0].rules[0].seat[s..<s+1]; actor:=seat[0].me;
  if req.active==0 {
    ok:=false;
    if admitted && st[0].placed && room[0].rules[0].live[s] && seat[0].open && b[0].c[actor].klass==RS_WIZARD {
      fb_seat_in(b,seat);
      ok=ifx req.slot==0 then rs_ritual_begin(b,actor,SP_FIND_FAMILIAR) else rs_familiar_begin(b,actor,req.slot);
      fb_seat_out(b,seat);
    }
    if ok {
      req.active=req.pending; req.pending=0; st[0].familiar=req;
      e2_wizard_status(v,k,s,req.active,E2_WIZARD_CASTING);
    } else {
      st[0].familiar=E2Familiar.{last=req.last};
      eg_refuse(v,k,SeatId.{value=s},req.pending,E2_FAMILIAR_REFUSED);
    }
    return;
  }
  if b[0].c[actor].rite!=SP_FIND_FAMILIAR {
    st[0].familiar=E2Familiar.{last=req.last}; e2_wizard_status(v,k,s,req.active,E2_WIZARD_INTERRUPTED); return;
  }
  if !admitted || !seat[0].open || !b[0].c[actor].rite_owed { return; }
  fb_seat_in(b,seat);
  if rs_rite_due_now(b,actor,SP_FIND_FAMILIAR) {
    ok:=req.clear && rs_familiar_finish(b,actor,RS_FAMILIAR_FORMS[req.form],req.spirit,req.x,req.y);
    if ok { st[0].familiar_incense_used=true; }
    else { rs_rite_fail(b,actor," (completion refused)"); }
    st[0].familiar=E2Familiar.{last=req.last};
    e2_wizard_status(v,k,s,req.active,ifx ok then E2_WIZARD_COMPLETE else E2_WIZARD_INTERRUPTED);
  } else { _:=rs_ritual_continue(b,actor); }
  fb_seat_out(b,seat);
}

e2_familiar_lifecycle :: (r:[]EgBattle,s:int,req:E2Familiar)->bool {
  if !r[0].familiar_ready || !r[0].live[s] { return false; }
  seat:=r[0].seat[s..<s+1];
  if !seat[0].open { return false; }
  b:=r[0].b[..]; actor:=seat[0].me;
  fb_seat_in(b,seat);
  ok:=ifx req.order==E2_FAMILIAR_RECALL then req.clear && rs_familiar_return(b,actor,req.x,req.y)
    else rs_familiar_dismiss(b,actor,req.order==E2_FAMILIAR_RELEASE);
  fb_seat_out(b,seat);
  return ok;
}

e2_familiar_step :: (r:[]EgBattle,s:int,req:E2Familiar,reactions:[]E2StepReactions)->bool {
  if !req.clear || !r[0].familiar_ready || !r[0].live[s] { return false; }
  b:=r[0].b[..]; seat:=r[0].familiar[s..<s+1];
  if !seat[0].open { return false; }
  fb_seat_in(b,seat);
  ok:=rs_familiar_command_step(b,EGB_SEAT+s,false,req.x,req.y,reactions[0].choice[0..<reactions[0].n]);
  fb_seat_out(b,seat);
  return ok;
}

e2_familiar_heal :: (v:[]RmServer,k:int,s:int,req:E2Familiar)->bool {
  room:=v[0].eg[k..<k+1]; r:=room[0].rules[..]; b:=r[0].b[..]; seat:=r[0].seat[s..<s+1];
  actor:=EGB_SEAT+s;
  if !req.clear || !r[0].live[s] || !seat[0].open || !e2_familiar_heal_target(v,k,s,req.target) ||
    room[0].tick-room[0].seat[s].last_cast<EG_E2_GAP || b[0].c[actor].klass!=RS_DRUID { return false; }
  fb_seat_in(b,seat);
  ok:=rs_familiar_touch(b,actor,SP_CURE_WOUNDS,1,EGB_SEAT+req.target);
  fb_seat_out(b,seat);
  if ok {
    room[0].seat[s].last_cast=room[0].tick; room[0].e2_casts+=1;
    e2_kit_tell(v,k,SeatId.{value=s},false);
  }
  return ok;
}

e2_familiar_sense :: (r:[]EgBattle,s:int)->bool {
  if !r[0].familiar_ready || !r[0].live[s] { return false; }
  b:=r[0].b[..]; seat:=r[0].seat[s..<s+1];
  if !seat[0].open { return false; }
  fb_seat_in(b,seat);
  ok:=rs_familiar_borrow_senses(b,seat[0].me);
  fb_seat_out(b,seat);
  return ok;
}
e2_familiar_sense_state :: (v:[]RmServer,k:int,s:int) {
  room:=v[0].eg[k..<k+1]; st:=room[0].seat[s..<s+1]; b:=room[0].rules[0].b[..];
  owner:=EGB_SEAT+s;
  f:=rs_familiar_observer(b,owner);
  mode:=ifx f==owner then E2_SENSE_OWNER else ifx rs_has(b[0].c[f],RS_DEAFENED) then E2_SENSE_SIGHT else E2_SENSE_SIGHT_HEARING;
  if mode==st[0].familiar_sense_sent && room[0].tick%EG_HZ!=0 { return; }
  st[0].familiar_sense_sent=mode;
  out:[32]u8;
  n:=e2_familiar_put_sense(out[..],mode);
  rl_queue(v,room[0].relay,st[0].conn,-1,cast(string)out[0..<n],"");
}

e2_familiar_commit :: (v:[]RmServer,k:int) {
  room:=v[0].eg[k..<k+1];
  for s:0..<EG_SEATS {
    st:=room[0].seat[s..<s+1]; req:=st[0].familiar;
    if (req.pending<=0 && req.active<=0) || !st[0].live || st[0].conn<0 { continue; }
    id:=SeatId.{value=s};
    admitted:=!eg_travel_drops(v,k,id) && !rm_checkpoint_paused(v,k) && ck_can_play(v,k,id);
    if req.wizard { e2_wizard_cast(v,k,s,admitted); continue; }
    st[0].familiar=E2Familiar.{last=req.last};
    ok:=false;
    if admitted && st[0].placed && req.order==E2_FAMILIAR_SENSES {
      ok=e2_familiar_sense(room[0].rules[..],s);
    } else if admitted && st[0].placed && req.order==E2_FAMILIAR_CURE {
      ok=e2_familiar_heal(v,k,s,req);
    } else if admitted && st[0].placed && req.order==E2_FAMILIAR_STEP {
      ok=e2_familiar_step(room[0].rules[..],s,req,room[0].familiar_reactions[s..<s+1]);
    } else if admitted && st[0].placed && req.order>0 {
      ok=e2_familiar_lifecycle(room[0].rules[..],s,req);
    } else if admitted && req.clear && req.order==0 {
      ok=egb_wild_companion(room[0].rules[..],s,req.slot,RS_FAMILIAR_FORMS[req.form],req.x,req.y);
    }
    if !ok { eg_refuse(v,k,id,req.pending,E2_FAMILIAR_REFUSED); continue; }
    out:[64]u8;
    n:=e2_familiar_put_done(out[..],req.order,req.pending,req.form);
    rl_queue(v,room[0].relay,st[0].conn,-1,cast(string)out[0..<n],"");
  }
}

// A complete, filtered list. Periodic refresh covers an output queue that
// dropped a changed snapshot while the seat was behind.
e2_familiar_snapshot :: (v:[]RmServer,k:int,s:int) {
  room:=v[0].eg[k..<k+1]; rules:=room[0].rules[..]; b:=rules[0].b[..];
  if !rules[0].familiar_ready { return; }
  st:=room[0].seat[s..<s+1];
  rows:[960]u8; size:=0; count:=0;
  for owner:0..<EG_SEATS {
    if !room[0].seat[owner].live || !room[0].seat[owner].placed { continue; }
    if (room[0].im[0].blocks[s]&(1<<owner))!=0 || (room[0].im[0].blocks[owner]&(1<<s))!=0 { continue; }
    f:=rules[0].familiar[owner].me; c:=b[0].c[f..<f+1];
    if c[0].dead || c[0].hp<=0 { continue; }
    form:=-1;
    for q:0..<RS_FAMILIAR_FORMS.count { if c[0].familiar_form==RS_FAMILIAR_FORMS[q] { form=q; } }
    if form<0 { continue; }
    x:=int(egb_cell_m(c[0].x)*1000);
    z:=int(egb_cell_z(rules,c[0].y)*1000);
    size=e2_familiar_put_row(rows[..],size,owner,form,x,z,c[0].hp,c[0].hp_max);
    count+=1;
  }
  hash:=eg_hash(cast(string)rows[0..<size]);
  if st[0].familiar_hash==hash && room[0].tick-st[0].familiar_sent<EG_HZ { return; }
  st[0].familiar_hash=hash; st[0].familiar_sent=room[0].tick;
  out:[1024]u8;
  n:=e2_familiar_put_rows(out[..],room[0].tick,count,cast(string)rows[0..<size]);
  rl_queue(v,room[0].relay,st[0].conn,-1,cast(string)out[0..<n],"");
}

#test "e2 familiar: pocket recall and release use the owner's saved action" #steps 4000000000 {
  v:[1]RmServer; rm_init(v[..]); rm_clock(v[..],0,1762190000000);
  #assert rm_join(v[..],0,"GET /api/room/relay/everglade/pair-e2-lifecycle HTTP/1.1\r\n\r\n")==0;
  k:=eg_room_at(v[..],v[0].conns[0].relay);
  rm_heard(v[..],0,"H 5 ranger.0.0.0 srd-druid-2 0 -");
  for q:0..<3 { eg_test_tick(v[..],k); }
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..]; f:=rs_familiar_of(b,0);
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M1 1 8 0"); rc_test_tick(v[..],k,true);
  hp:=b[0].c[f].hp;
  #assert hp>0 && !b[0].c[f].dead;
  rm_heard(v[..],0,"M4 2 1"); rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead;
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M4 3 1"); rc_test_tick(v[..],k,true);
  #assert b[0].c[f].dead && b[0].c[f].hp==hp && r[0].seat[0].turn.action;
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M4 4 2"); rc_test_tick(v[..],k,false);
  #assert b[0].c[f].dead && !r[0].seat[0].turn.action;
  rm_heard(v[..],0,"M4 5 2"); rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead && b[0].c[f].hp==hp && r[0].seat[0].turn.action;
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M4 5 3"); rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead && !r[0].seat[0].turn.action;
  rm_heard(v[..],0,"M4 6 3"); rc_test_tick(v[..],k,true);
  #assert b[0].c[f].dead && b[0].c[f].hp==0 && r[0].seat[0].turn.action;
  out:[16384]u8;
  #assert eg_test_has(e2rt_heard(v[..],0,out[..]),"m4 6 3");
}

#test "e2 familiar: Step uses the familiar's saved movement and world clearance in the distant clearing" #steps 4000000000 {
  v:[1]RmServer; rm_init(v[..]); rm_clock(v[..],0,1762190000000);
  #assert rm_join(v[..],0,"GET /api/room/relay/everglade/pair-e2-step HTTP/1.1\r\n\r\n")==0;
  k:=eg_room_at(v[..],v[0].conns[0].relay);
  rm_heard(v[..],0,"H 5 ranger.0.0.0 srd-druid-2 0 -");
  for q:0..<3 { eg_test_tick(v[..],k); }
  rm_eg_moved(v[..],k,SeatId.{value=0},0,0,0,-470,0,0,0,0,1,0,0);
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..]; f:=rs_familiar_of(b,0);
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M1 1 8 0"); rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead;
  #assert b[0].c[f].y>=0 && b[0].c[f].y<b[0].h;
  egb_step(r,b[0].c[f].turn_at+0.1);
  x:=b[0].c[f].x; y:=b[0].c[f].y;
  owner_turn:=r[0].seat[0].turn;
  rm_heard(v[..],0,"M5 2"); rc_test_tick(v[..],k,false);
  #assert b[0].c[f].x==x && b[0].c[f].y==y && !r[0].familiar[0].turn.moved;
  rm_heard(v[..],0,"M5 3");
  rays:=rm_eg_sights(v[..],k); ray:[6]f32;
  #assert rays>0 && rm_eg_sight(v[..],k,rays-1,ray[..]);
  #assert abs(ray[2]+470)<3 && abs(ray[5]+470)<4;
  rc_test_tick(v[..],k,true);
  #assert rs_feet(x,y,b[0].c[f].x,b[0].c[f].y)==RS_SQUARE && r[0].familiar[0].turn.moved;
  #assert r[0].seat[0].turn.action==owner_turn.action && r[0].seat[0].turn.moved==owner_turn.moved;
  moved:=false; visible:=false;
  while true {
    got:=rm_relay_next(v[..]); if got==0 { break; }
    if !v[0].rto[0] { continue; }
    frame:=cast(string)v[0].rout[0..<got];
    if frame=="m5 3" { moved=true; }
    if !wire_is(frame,"m2") { continue; }
    rd:=[1]WireRd.[wire_rd(frame,2)];
    tick:=wire_num(frame,rd[..]); rows:=wire_num(frame,rd[..]);
    if tick!=v[0].eg[k].tick || rows!=1 { continue; }
    for q:0..<3 { _:=wire_num(frame,rd[..]); }   // owner, form and X
    z:=wire_num(frame,rd[..]);
    visible=rd[0].ok && z< -466000 && z> -474000;
  }
  #assert moved && visible;
}


#test "e2 familiar: Cure Wounds uses familiar contact and the owner's spell slot" #steps 4000000000 {
  v:[1]RmServer; rm_init(v[..]); rm_clock(v[..],0,1762190000000);
  path:="GET /api/room/relay/everglade/pair-e2-familiar-heal HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..],0,path)==0 && rm_join(v[..],1,path)==1;
  rm_heard(v[..],0,"H 5 ranger.0.0.0 srd-druid-2 0 -");
  rm_heard(v[..],1,"H 5 ranger.0.0.0 srd-fighter 0 -");
  k:=eg_room_at(v[..],v[0].conns[0].relay);
  for q:0..<3 { eg_test_tick(v[..],k); }
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..]; f:=rs_familiar_of(b,0);
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M1 1 8 0"); rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead && rs_spell_ready(b[0].c[0],SP_CURE_WOUNDS);
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_eg_moved(v[..],k,SeatId.{value=1},0,12,0,0,0,0,0,0,1,0,0);
  rs_place(b,f,b[0].c[1].x-1,b[0].c[1].y);
  b[0].c[1].hp=1;
  slots:=b[0].c[0].slots[1];
  rm_heard(v[..],0,"M6 2 1"); rc_test_tick(v[..],k,false);
  #assert b[0].c[1].hp==1 && b[0].c[0].slots[1]==slots && !b[0].c[f].reacted && !r[0].seat[0].turn.action;
  rm_heard(v[..],0,"M6 3 1"); rc_test_tick(v[..],k,true);
  #assert b[0].c[1].hp>1 && b[0].c[0].slots[1]==slots-1 && b[0].c[f].reacted && r[0].seat[0].turn.action;
  out:[16384]u8;
  #assert eg_test_has(e2rt_heard(v[..],0,out[..]),"m6 3");
}

#test "e2 familiar: borrowed senses spend the owner's Bonus Action and expire" #steps 4000000000 {
  v:[1]RmServer;
  k:=e2rt_room(v[..],"srd-druid-2");
  #assert k>=0;
  r:=v[0].eg[k].rules[..]; b:=r[0].b[..]; f:=rs_familiar_of(b,0);
  egb_step(r,b[0].c[0].turn_at+0.1);
  rm_heard(v[..],0,"M1 1 8 0"); rc_test_tick(v[..],k,true);
  #assert !b[0].c[f].dead;
  rm_heard(v[..],0,"M7 2"); rc_test_tick(v[..],k,true);
  #assert r[0].seat[0].turn.bonus && rs_familiar_observer(b,0)==f;
  out:[16384]u8;
  got:=e2rt_heard(v[..],0,out[..]);
  #assert eg_test_has(got,"m7 2") && eg_test_has(got,"m8 2");
  b[0].c[f].cond|=RS_DEAFENED;
  rc_test_tick(v[..],k,true);
  #assert eg_test_has(e2rt_heard(v[..],0,out[..]),"m8 1");
  egb_step(r,b[0].c[0].turn_at+0.1);
  rc_test_tick(v[..],k,true);
  #assert rs_familiar_observer(b,0)==0 && eg_test_has(e2rt_heard(v[..],0,out[..]),"m8 0");
}
