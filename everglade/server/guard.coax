// Everglade II's path guard: one guard of the room's battle (the SRD 5.2.1 Fighter at level 10,
// rules/srd/npcs.coax rs_path_guard: AC 19, HP 84, two Longsword attacks at +8 for 1d8 + 4, Second
// Wind and Action Surge) who walks the forest path from the glade to the clearing and back.
// The room walks him on its own tick, so every page sees him where the room has him; the rules' turn
// strikes (everglade5e-room-rules.coax egb_patrol_turn) once the room has brought him within reach of the
// player who harmed him, and fights them until they drop, flee past his leash, or leave him be. He never
// harms first. A player in his way stops him; one who keeps standing
// there is stepped round, and no step of his ever ends inside a player's body.
// The room tells the pages his state (g2, each tick he changes and once a second when he doesn't) and
// each blow (g3: AMOUNT 0 a miss; each of his turn's attacks is its own, E2G_BLOW_S apart) through the
// creature frames' codec, creature-wire.coax (proto/verse/everglade2-combat-v2.json).
// The pages draw him a jitter buffer behind, as they draw each other (everglade/client/guard.coax).
// His Dash is Everglade's (everglade/dash.coax): his run times eg_dash_rate from when he takes it.
#load "../dash.coax";
#load "creature-wire.coax";   // e guard: the one codec the page reads his blows with (#13246, #13276)

E2G_WALK :: 1.4;            // m/s: a calm walk (the page's gait walks under 2.2 m/s, everglade/scene/bodies.coax BD_RUN_FROM)
E2G_CHASE :: E2_RUN_SPEED; // m/s: after the one who struck him, a run as fast as yours (everglade/shared/move.coax)
E2G_REACH_FT :: 5;          // his Longsword's reach (feet), measured as the rules measure an Opportunity Attack
E2G_NEAR :: 24;             // trunks round him, for his steering (room-tick.c E2G_NEAR_C)
E2G_TURN :: 1.6;            // rad/s he turns at the path's ends: half round in two seconds
E2G_STEER :: 2.6;           // rad/s he turns as the path bends
E2G_REST_S :: 1.5;          // s he stands at an end before he turns
E2G_Z0 :: -18.0;            // the path's glade end (z): Everglade II's named guard post
#load "../../verse/everglade2/points.coax";
#test "the guard's beat starts at Everglade II's named guard post (#13078)" { p := e2_point("guard-post"); #assert p.found && p.z == f32(E2G_Z0) && p.x == 0; }
E2G_Z1 :: -455.0;           // its clearing end (E2_CLEAR_Z -470 + 15)
E2G_AHEAD :: 1.5;           // m he looks ahead along the path
E2G_BODY :: 0.35;           // m: his capsule's radius (everglade/shared/move.coax e2m_guard_body)
E2G_CLEAR :: 0.8;           // m: no step of his ends nearer a player's middle than this
E2G_BLOCK :: 1.7;           // m: a player this near ahead of him stops him
E2G_SIDE_S :: 1.6;          // s stopped before he steps round
E2G_SIDE :: 1.3;            // m to the side he steps round
E2G_SIDE_V :: 0.7;          // m/s he moves across
E2G_REACH :: 1.5;           // m from the one he fights: within his Longsword's 5 feet (the steering service rings him inside it, E2G_NAV reach)
E2G_LEASH :: 28.0;          // m from where he was struck past which he lets them go
E2G_CALM_S :: 15.0;         // s without a blow either way after which he goes back to his walk
E2G_RESPAWN_S :: 20.0;      // s from his fall to the next guard
E2G_AIM :: 1.6;
E2G_DEFEND :: 12.0;         // m: a monster that strikes a player this near him is his foe             // m: a cast aimed this near him is aimed at him
E2G_BLOW_S :: 0.7;          // s between his turn's attacks as the pages see and hear them
E2G_FORM :: 21;             // E5RR_FORM_RAID + RS_NPC_GUARD: the guard's look
// How he fights, on the engine's steering service (aethyr/ai/steer.coax, docs/verse/navigation.md):
// after his foe at a run, aimed where they will be; round them within his reach once there, changing
// his side every few seconds; never deeper into a player than E2G_CLEAR; round what he can't stand on.
// His leash is his own (E2G_LEASH from where he was struck, then his walk), so the service's is off.
E2G_NAV :: NavTune.{speed = 3.6, home_speed = 1.4, body = 0.35, reach = 1.1, ring = 0.85, circle = 1.2, turn_s = 3.5, lead = 0.8, leash = 100000, replan = 0.5, span = 16, cell = 0.5};
E2G_SEAT_BODY :: 0.45;      // m: a player as a body to him, so his middle stays E2G_CLEAR (0.35 + 0.45) from theirs
E2G_WALKING :: 0; E2G_STANDING :: 1; E2G_FIGHTING :: 2; E2G_DOWN :: 3; E2G_NONE :: 4;

E2Guard :: struct {
  q: int = -1; id: int;      // his beast slot in the rules (-1 none) and its id
  life: int;                 // each guard a new life: the pages fade a new one in
  told_life: int;            // the life his row last said (e2_guard_row)
  state: int = E2G_NONE;
  x: f32; z: f32; yaw: f32;
  dir: f32 = -1;             // -1 toward the clearing, 1 toward the glade
  off: f32; off_to: f32;     // his step to the side of the path, and where it is going
  rest: f32;                 // s left standing at an end
  turning: bool;             // at an end, turning round
  stopped: f32;              // s stopped by a player in his way
  clear_s: f32;              // s since a player last stood in his way
  foe: int = -1; struck_x: f32; struck_z: f32; calm: f32;
  beast: int = -1;           // the monster's creature he fights for a player near him (everglade/server/creatures.coax), -1 none
  down_at: int = -1;         // the tick he fell (-1 standing)
  hp: int; foe_hp: int;      // his Hit Points last tick, and his foe's before the rules' step
  swing: int = EGB_NEVER; swing_tick: int = -1;
  seq: int;                  // the battle's log read to (its seq): his attacks are told from it
  blows: int;                // the attacks of his last turn that struck at someone
  dealt: [4] int;            // and the damage of each (0 a miss)
  nav: [1] NavAgent;         // his steering in a fight (aethyr/ai/steer.coax)
  nav_on: int = -1;          // whom it steers after: a seat, E2G_NAV_BEAST + a monster's creature, -1 none
  win: [1] NavWindow;        // his planning window
  near: [E2G_NEAR * 3] f32; near_n: int;   // the trunks round him this tick (room-world.c world2_near)
  foe_x: f32; foe_z: f32; foe_seen: bool;  // his foe last tick: leaving his reach draws his Opportunity Attack
  opportunity: int;          // Opportunity Attacks he has made (checks)
}
E2G_NAV_BEAST :: 1000;

e2g_wrap :: (a: f32) -> f32 { r := a; while r > 3.14159265 { r -= 6.2831853; } while r < -3.14159265 { r += 6.2831853; } return r; }
e2g_turn :: (yaw: f32, goal: f32, rate: f32, dt: f32) -> f32 {
  d := e2g_wrap(goal - yaw); m := rate * dt;
  return e2g_wrap(yaw + (ifx d > m then m else ifx d < -m then -m else d));
}
e2g_seat_near :: (v: [] RmServer, k: int, x: f32, z: f32, r: f32) -> bool {
  for s: 0..<EG_SEATS {
    st := v[0].eg[k].seat[s..<s + 1];
    if !st[0].live || !st[0].placed { continue; }
    dx := st[0].pose.x - x; dz := st[0].pose.z - z;
    if dx * dx + dz * dz < r * r { return true; }
  }
  return false;
}
// The nearest player in his way along `yaw`: ahead within E2G_BLOCK m and within E2G_LANE m of his
// line. The side it stands on (-1 left, 1 right), 0 none.
E2G_LANE :: 0.9;
e2g_blocker :: (v: [] RmServer, k: int, g: E2Guard, yaw: f32) -> f32 {
  fx := sin(yaw); fz := cos(yaw); best := f32(E2G_BLOCK); side: f32 = 0;
  for s: 0..<EG_SEATS {
    st := v[0].eg[k].seat[s..<s + 1];
    if !st[0].live || !st[0].placed { continue; }
    dx := st[0].pose.x - g.x; dz := st[0].pose.z - g.z;
    a := dx * fx + dz * fz; l := dx * fz - dz * fx;
    if a <= 0.1 || a >= best || abs(l) >= f32(E2G_LANE) { continue; }
    best = a; side = ifx l > 0 then 1.0f32 else -1.0f32;
  }
  return side;
}
// A new guard at the glade's end of the path (or the clearing's when someone stands at the glade's),
// walking toward the other: his creature the rules' first free beast.
e2g_spawn :: (v: [] RmServer, k: int) -> bool {
  r := v[0].eg[k].rules[..]; b := r[0].b[..]; g := v[0].eg[k].guard[..];
  z := f32(E2G_Z0); dir: f32 = -1;
  if e2g_seat_near(v, k, e2_road_x(z), z, 2.5) { z = f32(E2G_Z1); dir = 1; }
  x := e2_road_x(z);
  if e2g_seat_near(v, k, x, z, 2.5) { return false; }
  q := -1; for o: 0..<EGB_BEASTS { if q < 0 && r[0].beasts[o].id == 0 { q = o; } }
  if q < 0 { return false; }
  i := EGB_BEAST0 + q;
  c := rs_path_guard("Guard", 1);
  c.x = egb_sq(x); c.y = egb_z_cell(r, z); c.turn_at = b[0].clock + 100000; c.round_at = b[0].clock;
  b[0].c[i] = c;
  id := r[0].next_id; r[0].next_id += 1;
  yaw := e2_heading(e2_road_x(z + dir * f32(E2G_AHEAD)) - x, dir * f32(E2G_AHEAD));
  r[0].beasts[q] = EgBeast.{id = id, tag = id, by = -1, spell = -1, form = E2G_FORM, patrol = true, x = x, z = z, yaw = yaw, goal_x = x, goal_z = z};
  life := g[0].life + 1;
  g[0] = E2Guard.{q = q, id = id, life = life, state = E2G_WALKING, x = x, z = z, yaw = yaw, dir = dir, hp = c.hp, seq = b[0].book[0].seq};
  return true;
}

// One step of dt toward (tx, tz) at speed, never ending nearer a player than E2G_CLEAR or where no one
// may stand. The distance moved.
e2g_move :: (v: [] RmServer, k: int, g: [] E2Guard, tx: f32, tz: f32, speed: f32, dt: f32, stop: f32) -> f32 {
  dx := tx - g[0].x; dz := tz - g[0].z; d := sqrt(dx * dx + dz * dz);
  if d <= stop + 0.001 { return 0; }
  st := speed * dt; if st > d - stop { st = d - stop; }
  nx := g[0].x + dx / d * st; nz := g[0].z + dz / d * st;
  if !e2_may_stand(nx, nz) || e2g_seat_near(v, k, nx, nz, f32(E2G_CLEAR)) { return 0; }
  g[0].x = nx; g[0].z = nz;
  return st;
}

// His foe leaving his reach since last tick (measured from where he stands, as the rules measure it):
// his Opportunity Attack with his Longsword, the shared rules' (rules/srd/opportunity-attack.coax),
// when he still has his Reaction and sees them.
e2g_opportunity :: (v: [] RmServer, k: int, g: [] E2Guard, foe: int) {
  st := v[0].eg[k].seat[foe]; b := v[0].eg[k].rules[0].b[..]; i := EGB_BEAST0 + g[0].q; me := EGB_SEAT + foe;
  was := g[0].foe_seen;
  g[0].foe_seen = true; px := g[0].foe_x; pz := g[0].foe_z; g[0].foe_x = st.pose.x; g[0].foe_z = st.pose.z;
  if !was { return; }
  dx := px - g[0].x; dz := pz - g[0].z; ex := st.pose.x - g[0].x; ez := st.pose.z - g[0].z;
  q := RsOpportunityMove.{measured = true, from_feet = sqrt(dx * dx + dz * dz) / 0.3048, to_feet = sqrt(ex * ex + ez * ez) / 0.3048,
                          reach = E2G_REACH_FT, melee = true, movement = true, seen = !rs_has(b[0].c[i], RS_BLINDED) && !rs_has(b[0].c[me], RS_INVISIBLE)};
  if !rs_opportunity_trigger(b, i, me, q) { return; }
  // the rules measure on their squares: his and theirs where he stands and where they were
  egb_place(v[0].eg[k].rules[..], foe, px, pz);
  r := rs_opportunity_attack(b, i, me, b[0].c[i].weapon, q);
  egb_place(v[0].eg[k].rules[..], foe, st.pose.x, st.pose.z);
  if r.admitted { g[0].opportunity += 1; v[0].eg[k].rules[0].beasts[g[0].q].swing = b[0].clock; e2g_blows(v, k, i); }   // told now: a blow of his Longsword
}
// The trunks round the guard this tick, from the room's world (room-tick.c, room-world.c world2_near):
// (x, z, radius) each. A room with no world (a check) hands none.
rm_e2_guard_near :: (v: [] RmServer, k: int, near: [] f32) #export_c #effects(all) {
  if k < 0 || k >= EG_ROOMS || !v[0].eg[k].live { return; }
  g := v[0].eg[k].guard[..]; n := rs_min(near.count / 3, E2G_NEAR);
  for i: 0..<n * 3 { g[0].near[i] = near[i]; }
  g[0].near_n = n;
}

// His walk along the path: on toward the end he walks to, round any player in his way, then a rest and
// a slow turn at the end.
e2g_walk :: (v: [] RmServer, k: int, dt: f32) {
  g := v[0].eg[k].guard[..];
  if g[0].rest > 0 || g[0].turning {
    g[0].state = E2G_STANDING;
    if g[0].rest > 0 { g[0].rest -= dt; if g[0].rest <= 0 { g[0].turning = true; g[0].dir = -g[0].dir; } return; }
    goal := e2_heading(e2_road_x(g[0].z + g[0].dir * f32(E2G_AHEAD)) - g[0].x, g[0].dir * f32(E2G_AHEAD));
    g[0].yaw = e2g_turn(g[0].yaw, goal, f32(E2G_TURN), dt);
    if abs(e2g_wrap(goal - g[0].yaw)) < 0.02 { g[0].turning = false; }
    return;
  }
  end := ifx g[0].dir < 0 then f32(E2G_Z1) else f32(E2G_Z0);
  if (g[0].dir < 0 && g[0].z <= end) || (g[0].dir > 0 && g[0].z >= end) { g[0].rest = f32(E2G_REST_S); g[0].off_to = 0; g[0].state = E2G_STANDING; return; }
  // the side step: out while a player keeps him stopped, back once the way has been clear a while
  path := e2_heading(e2_road_x(g[0].z + g[0].dir * f32(E2G_AHEAD)) - e2_road_x(g[0].z), g[0].dir * f32(E2G_AHEAD));
  side := e2g_blocker(v, k, g[0], path);
  if side != 0 { g[0].stopped += dt; g[0].clear_s = 0; } else { g[0].stopped = 0; g[0].clear_s += dt; }
  if side != 0 && g[0].stopped > f32(E2G_SIDE_S) && abs(g[0].off_to) < 0.01 {
    want := side * -f32(E2G_SIDE) + g[0].off;
    if !e2_may_stand(e2_road_x(g[0].z) + want, g[0].z) { want = g[0].off + side * f32(E2G_SIDE); }
    g[0].off_to = want;
  }
  if g[0].clear_s > 2.5 { g[0].off_to = 0; }
  if side != 0 {
    // stopped: he waits, then steps to the side, across only, facing on along the path
    g[0].state = E2G_STANDING;
    if g[0].stopped <= f32(E2G_SIDE_S) { return; }
    if e2g_move(v, k, g, e2_road_x(g[0].z) + g[0].off_to, g[0].z, f32(E2G_SIDE_V), dt, 0) > 0 { g[0].off = g[0].x - e2_road_x(g[0].z); }
    g[0].yaw = e2g_turn(g[0].yaw, path, f32(E2G_STEER), dt);
    return;
  }
  across := g[0].off_to - g[0].off; m := f32(E2G_SIDE_V) * dt;
  g[0].off += ifx across > m then m else ifx across < -m then -m else across;
  tz := g[0].z + g[0].dir * f32(E2G_AHEAD); tx := e2_road_x(tz) + g[0].off;
  moved := e2g_move(v, k, g, tx, tz, f32(E2G_WALK), dt, 0);
  g[0].state = ifx moved > 0 then E2G_WALKING else E2G_STANDING;
  if moved > 0 { g[0].yaw = e2g_turn(g[0].yaw, e2_heading(tx - g[0].x, tz - g[0].z), f32(E2G_STEER), dt); }
}

// One tick of his fight with `on` (a seat, or E2G_NAV_BEAST + a monster's creature) standing at
// (tx, tz), on the steering service: his window filled from where one may stand (everglade/shared/move.coax
// e2_may_stand), the players as bodies, and the room's slide (e2m_keep) the last word on his step.
// He runs as fast as your run (E2G_CHASE), faster while he has taken the Dash action; he draws to the
// side the one he fights faces away from (nav_facing, their yaw); the trunks and rocks round him
// (g[0].near, room-world.c world2_near) are bodies to him as the players are.
e2g_fight :: (v: [] RmServer, k: int, g: [] E2Guard, on: int, tx: f32, tz: f32, tyaw: f32, dt: f32) {
  a := g[0].nav[..]; t := E2G_NAV;
  bt := v[0].eg[k].rules[0].beasts[g[0].q]; clock := v[0].eg[k].rules[0].b[0].clock;
  t.speed = f32(E2G_CHASE) * eg_dash_rate(rs_ticks_s(clock - bt.dash_at), f32(v[0].eg[k].rules[0].b[0].c[EGB_BEAST0 + g[0].q].speed));
  if g[0].nav_on != on {
    a[0] = nav_agent(g[0].x, g[0].z, g[0].life * 31 + on);
    a[0].face_x = sin(g[0].yaw); a[0].face_z = cos(g[0].yaw);
    g[0].nav_on = on;
  }
  a[0].x = g[0].x; a[0].z = g[0].z; a[0].home_x = g[0].x; a[0].home_z = g[0].z;   // no service leash: his is E2G_LEASH
  nav_facing(a, sin(tyaw), cos(tyaw));
  if nav_think(a, t, tx, tz, dt) {
    if nav_wants_window(a[0]) {
      w := g[0].win[..];
      nav_window_place(w, t, a[0]);
      // his window is the room's navigation cells where it holds them (everglade/server/nav.coax, #13281): the ground a
      // creature stands on, clear of every trunk and rock; where it holds none, where one may stand
      if e2nv_awake(v, k, g[0].x, g[0].z) { filled := nav_cells_window(v[0].nav[0].pages[..], w); }
      else { for c: 0..<nav_window_cells(w) { p := nav_window_spot(w, c); w[0].walk[c] = e2_may_stand(p[0], p[1]); } }
      nav_plan(a, t, w);
    } else { nav_direct(a, t); }
  }
  bodies: [(EG_SEATS + E2G_NEAR) * 3] f32; n := 0;
  for q: 0..<g[0].near_n { for j: 0..<3 { bodies[n * 3 + j] = g[0].near[q * 3 + j]; } n += 1; }
  for s: 0..<EG_SEATS {
    st := v[0].eg[k].seat[s..<s + 1];
    if !st[0].live || !st[0].placed { continue; }
    bodies[n * 3] = st[0].pose.x; bodies[n * 3 + 1] = st[0].pose.z; bodies[n * 3 + 2] = f32(E2G_SEAT_BODY); n += 1;
  }
  // his swing under way (the rules' turn, its blows told E2G_BLOW_S apart): he stands to it
  busy := g[0].swing_tick >= 0 && v[0].eg[k].tick - g[0].swing_tick < cast(int)(f32(E2G_BLOW_S) * f32(EG_HZ));
  step := nav_move(a, t, busy, dt, bodies[0..<n * 3], -1);
  spot := e2m_keep(step.x, step.z, g[0].x, g[0].z);
  nav_moved(a, step, spot.x, spot.z);
  g[0].x = spot.x; g[0].z = spot.z;
  g[0].yaw = e2g_turn(g[0].yaw, e2_heading(step.face_x, step.face_z), f32(E2G_STEER) * 2, dt);
  g[0].state = E2G_FIGHTING; g[0].rest = 0; g[0].turning = false;
  // back on his walk he takes up the path from the nearest point on it
  g[0].off = g[0].x - e2_road_x(g[0].z); g[0].off_to = 0;
}

// The room's tick, before the rules step: a new guard when due, his walk or his chase, and his body's
// square in the battle. The foe's Hit Points are kept to tell his blows.
e2_guard_tick :: (v: [] RmServer, k: int) {
  g := v[0].eg[k].guard[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  dt := 1.0f32 / f32(EG_HZ); t := v[0].eg[k].tick;
  if g[0].q < 0 {
    if g[0].down_at >= 0 && t - g[0].down_at < cast(int)(f32(E2G_RESPAWN_S) * f32(EG_HZ)) { return; }
    if !e2g_spawn(v, k) { return; }
  }
  q := g[0].q; i := EGB_BEAST0 + q; bt := r[0].beasts[q..<q + 1];
  // his slot taken by another creature (a check or the rules' own placing): he is gone, back in time
  if !bt[0].patrol || bt[0].id != g[0].id {
    g[0].q = -1; g[0].state = E2G_NONE; g[0].foe = -1; g[0].down_at = t; return;
  }
  foe := g[0].foe;
  // whom he fights: a placed seat still standing and in reach of his leash
  if foe >= 0 {
    st := v[0].eg[k].seat[foe..<foe + 1]; c := b[0].c[EGB_SEAT + foe..<EGB_SEAT + foe + 1];
    dx := st[0].pose.x - g[0].struck_x; dz := st[0].pose.z - g[0].struck_z;
    g[0].calm += dt;
    if !st[0].live || !st[0].placed || c[0].dead || c[0].hp <= 0 || dx * dx + dz * dz > f32(E2G_LEASH * E2G_LEASH) || g[0].calm > f32(E2G_CALM_S) { foe = -1; }
  }
  g[0].foe = foe;
  // a monster that struck a player near him: he goes for it, while it stands within his leash
  beast := g[0].beast;
  if foe >= 0 { beast = -1; }
  else {
    if beast >= 0 {
      at := e2_monster_at(v, k, beast);
      bx := at[0] - g[0].struck_x; bz := at[1] - g[0].struck_z;
      if b[0].c[beast].dead || b[0].c[beast].hp <= 0 || b[0].c[beast].x == EGB_AWAY || bx * bx + bz * bz > f32(E2G_LEASH * E2G_LEASH) { beast = -1; }
    }
    if beast < 0 {
      beast = e2_monster_assailant(v, k, g[0].x, g[0].z, f32(E2G_DEFEND));
      if beast >= 0 { g[0].struck_x = g[0].x; g[0].struck_z = g[0].z; }
    }
  }
  g[0].beast = beast;
  bt[0].foe = ifx foe >= 0 then EGB_SEAT + foe else beast;
  g[0].foe_hp = ifx foe >= 0 then b[0].c[EGB_SEAT + foe].hp else ifx beast >= 0 then b[0].c[beast].hp else 0;
  if foe < 0 && beast >= 0 {
    at := e2_monster_at(v, k, beast);
    e2g_fight(v, k, g, E2G_NAV_BEAST + beast, at[0], at[1], r[0].beasts[beast - EGB_BEAST0].yaw, dt);
  } else if foe >= 0 {
    e2g_opportunity(v, k, g, foe);
    st := v[0].eg[k].seat[foe];
    e2g_fight(v, k, g, foe, st.pose.x, st.pose.z, st.pose.yaw, dt);
  } else {
    g[0].nav_on = -1;
    e2g_walk(v, k, dt);
  }
  if foe < 0 { g[0].foe_seen = false; }
  bt[0].x = g[0].x; bt[0].z = g[0].z; bt[0].yaw = g[0].yaw; bt[0].moving = g[0].state != E2G_STANDING;
  b[0].c[i].x = egb_sq(g[0].x); b[0].c[i].y = egb_z_cell(r, g[0].z);
}
// After the rules' step: his blows told, his hurts told, his fall.
e2_guard_after :: (v: [] RmServer, k: int) {
  g := v[0].eg[k].guard[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  if g[0].q < 0 { return; }
  q := g[0].q; i := EGB_BEAST0 + q; bt := r[0].beasts[q..<q + 1][0];
  if bt.patrol && bt.id == g[0].id && bt.swing != g[0].swing {
    g[0].swing = bt.swing; g[0].swing_tick = v[0].eg[k].tick; g[0].calm = 0;
  }
  if bt.patrol && bt.id == g[0].id && bt.shot_at > EGB_NEVER && bt.shot_at >= b[0].clock { g[0].calm = 0; }   // a shot of his keeps the fight on, as a blow does
  e2g_blows(v, k, i);
  hp := ifx bt.id == g[0].id then b[0].c[i].hp else 0;
  if hp < g[0].hp { e2g_tell(v, k, 1, g[0].foe, g[0].hp - hp); }
  g[0].hp = hp;
  if bt.id != g[0].id || b[0].c[i].dead || hp <= 0 {
    if bt.id == g[0].id { egb_beast_gone(r, q); }
    g[0].q = -1; g[0].state = E2G_DOWN; g[0].down_at = v[0].eg[k].tick; g[0].foe = -1; g[0].hp = 0;
  }
}
// His attacks since the log was last read, each told on its own, E2G_BLOW_S apart: whom it struck at
// (a seat, or a monster through everglade/server/creatures.coax) and the damage it did (0 a miss).
e2g_blows :: (v: [] RmServer, k: int, i: int) {
  g := v[0].eg[k].guard[..]; b := v[0].eg[k].rules[0].b[..];
  fresh := rs_min(b[0].book[0].seq - g[0].seq, b[0].book[0].count); g[0].seq = b[0].book[0].seq;
  if fresh <= 0 { return; }
  n := 0; to := -1; amount := 0; crit := false;
  // his turn's attacks this step were his Longbow's when he shot this step (egb_patrol_turn)
  bt := v[0].eg[k].rules[0].beasts[g[0].q]; shot := bt.shot_at > EGB_NEVER && bt.shot_at >= b[0].clock;
  for e: 0..<fresh + 1 {
    // the last pass tells the attack still open
    kind := 0; by := -1; at := -1; dealt := 0; kind_of := 0;
    if e < fresh {
      x := (b[0].book[0].head + b[0].book[0].count - fresh + e) % RS_EVENTS;
      kind = b[0].book[0].ev[x].kind; by = b[0].book[0].ev[x].by; at = b[0].book[0].ev[x].to; dealt = b[0].book[0].ev[x].amount; kind_of = b[0].book[0].ev[x].damage;
    }
    if by == i && kind == RS_EV_DAMAGE && at == to { amount += dealt; continue; }
    if to >= 0 && (e == fresh || (by == i && (kind == RS_EV_ATTACK || kind == RS_EV_MISS))) {
      tick := v[0].eg[k].tick + cast(int)(f32(n) * f32(E2G_BLOW_S) * f32(EG_HZ));
      // a critical hit at a seat is told as KIND 4, so its page shows it as one
      if to >= EGB_SEAT && to < EGB_SEAT + EG_SEATS { e2g_tell_at(v, k, tick, ifx shot then (ifx crit && amount > 0 then 6 else 5) else (ifx crit && amount > 0 then 4 else 2), to - EGB_SEAT, amount); }
      else { e2_monster_guarded_at(v, k, tick, to, amount); }
      if n < 4 { g[0].dealt[n] = amount; }
      n += 1; to = -1; amount = 0; crit = false;
    }
    if by == i && (kind == RS_EV_ATTACK || kind == RS_EV_MISS) { to = at; amount = 0; crit = kind == RS_EV_ATTACK && kind_of == 1; }
  }
  if n > 0 { g[0].blows = n; }
}
// A seat's cast at the guard: the creature it harms, when it is aimed within E2G_AIM m of him (-1 none).
e2_guard_target :: (v: [] RmServer, k: int, ax: f32, az: f32) -> int {
  g := v[0].eg[k].guard[0];
  if g.q < 0 || g.state == E2G_DOWN { return -1; }
  dx := ax - g.x; dz := az - g.z;
  return ifx dx * dx + dz * dz <= f32(E2G_AIM * E2G_AIM) then EGB_BEAST0 + g.q else -1;
}
// Seat s harmed him (or tried): he turns on them; a cast that took no Hit Points is told as a miss.
e2_guard_struck :: (v: [] RmServer, k: int, s: int, hp_before: int) {
  g := v[0].eg[k].guard[..];
  if g[0].q < 0 { return; }
  if g[0].foe != s { g[0].struck_x = g[0].x; g[0].struck_z = g[0].z; }
  g[0].foe = s; g[0].calm = 0;
  if v[0].eg[k].rules[0].b[0].c[EGB_BEAST0 + g[0].q].hp >= hp_before { e2g_tell(v, k, 1, s, 0); }
}
e2g_tell :: (v: [] RmServer, k: int, kind: int, s: int, amount: int) { e2g_tell_at(v, k, v[0].eg[k].tick, kind, s, amount); }
e2g_tell_at :: (v: [] RmServer, k: int, tick: int, kind: int, s: int, amount: int) {
  g := v[0].eg[k].guard[0];
  out: [64] u8;
  n := egc_guard_hit_put(out[..], EgcGuardHit.{tick = tick, kind = kind, seat = s, amount = amount});
  // to the seats near him, and to the one it names wherever it is: an e entry of the reliable class (#13276)
  eg_event_to(v, k, cast(string) out[0..<n], g.x, g.z, false, s);
}
// His row into the tick's table (everglade/server/send.coax eg_table; everglade-wire.coax WK_GUARD):
// none while there is no guard, and the next one is a new life.
e2_guard_row :: (v: [] RmServer, k: int) {
  room := v[0].eg[k..<k + 1]; g := room[0].guard[..]; h := room[0].hist[..];
  if g[0].state == E2G_NONE { return; }
  hp := 0; max := 0;
  if g[0].q >= 0 { hp = room[0].rules[0].b[0].c[EGB_BEAST0 + g[0].q].hp; max = room[0].rules[0].b[0].c[EGB_BEAST0 + g[0].q].hp_max; }
  if g[0].told_life != g[0].life { wire_hist_born(h, EG_SLOT_GUARD); g[0].told_life = g[0].life; }
  wire_hist_put(h, EG_SLOT_GUARD, WireS.{id = WIRE_ID_MADE + WIRE_GUARD_EID, kind = WK_GUARD, x = g[0].x, z = g[0].z, yaw = e2g_wrap(g[0].yaw),
    g = g[0].state, hp = hp, max = max, owner = ifx g[0].foe >= 0 then WIRE_TGT_SEAT + g[0].foe else -1, t0 = g[0].swing_tick}, wire_rel(WK_GUARD), false, true);
}
// Where his body stands for the movement step (room-world.c world2_step): false when there is none.
rm_e2_guard_body :: (v: [] RmServer, k: int, out: [] f32) -> bool #export_c #effects(all) {
  if k < 0 || k >= EG_ROOMS || !v[0].eg[k].live || out.count < 2 { return false; }
  g := v[0].eg[k].guard[0];
  if g.q < 0 { return false; }
  out[0] = g.x; out[1] = g.z;
  return true;
}

// ---- checks
// A check's seat 0 at (x, z): where the room has it, and its square in the battle.
e2gt_at :: (v: [] RmServer, k: int, x: f32, z: f32) { v[0].eg[k].seat[0].pose.x = x; v[0].eg[k].seat[0].pose.z = z; egb_place(v[0].eg[k].rules[..], 0, x, z); }
#test "e2 guard: he walks the path at a walk, turns slowly at its end and walks back" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  g := v[0].eg[k].guard[..];

  #assert g[0].q >= 0;
  #assert g[0].state == E2G_WALKING;
  #assert abs(g[0].z - f32(E2G_Z0)) < 0.1;
  #assert g[0].dir < 0;
  #assert v[0].eg[k].rules[0].beasts[g[0].q].patrol && v[0].eg[k].rules[0].b[0].c[EGB_BEAST0 + g[0].q].hp == 84;
  z0 := g[0].z;
  for q: 0..<EG_HZ * 10 { eg_test_tick(v[..], k); }
  went := z0 - g[0].z;
  #assert went > 13.0;
  #assert went < 14.1;
  #assert abs(g[0].x - e2_road_x(g[0].z)) < 0.2 && e2_may_stand(g[0].x, g[0].z);
  // at the clearing's end: he stands, turns no faster than E2G_TURN, then walks back up
  v[0].eg[k].guard[0].z = f32(E2G_Z1) + 0.5; v[0].eg[k].guard[0].x = e2_road_x(f32(E2G_Z1) + 0.5);
  yaw := g[0].yaw; most: f32 = 0; turned := false;
  for q: 0..<EG_HZ * 6 {
    eg_test_tick(v[..], k);
    d := abs(e2g_wrap(g[0].yaw - yaw)); if d > most { most = d; } yaw = g[0].yaw;
    if g[0].dir > 0 && g[0].state == E2G_WALKING { turned = true; }
  }
  #assert turned && most <= f32(E2G_STEER) / f32(EG_HZ) + 0.001 && g[0].z > f32(E2G_Z1);
}
#test "e2 guard: a player in his way stops him, and one who stays is stepped round, never walked into" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-way HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  g := v[0].eg[k].guard[..];
  for q: 0..<EG_HZ * 4 { eg_test_tick(v[..], k); }
  // you stand on the path 1.2 m ahead of him
  pz := g[0].z - 1.2; px := e2_road_x(pz);
  near: f32 = 100; stood := 0;
  for q: 0..<EG_HZ * 12 {
    e2gt_at(v[..], k, px, pz);
    eg_test_tick(v[..], k);
    dx := g[0].x - px; dz := g[0].z - pz; d := sqrt(dx * dx + dz * dz); if d < near { near = d; }
    if g[0].state == E2G_STANDING { stood += 1; }
  }

  #assert stood > EG_HZ;
  #assert near >= f32(E2G_CLEAR) - 0.001;
  #assert g[0].z < pz - 1;
}
#test "e2 guard: struck, he fights back with his Longsword; he keeps on you until you drop, falls and comes back" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-fight HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  g := v[0].eg[k].guard[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  me := EGB_SEAT; b[0].c[me].hp = 400; b[0].c[me].hp_max = 400;
  // he doesn't strike first: you beside him, untouched
  for q: 0..<EG_HZ * 3 { e2gt_at(v[..], k, g[0].x + 0.9, g[0].z); eg_test_tick(v[..], k); }
  #assert b[0].c[me].hp == 400 && g[0].foe < 0 && g[0].swing_tick < 0;
  #assert e2_guard_target(v[..], k, g[0].x + 0.5, g[0].z) == EGB_BEAST0 + g[0].q && e2_guard_target(v[..], k, g[0].x + 3, g[0].z) == -1;
  e2_guard_struck(v[..], k, 0, b[0].c[EGB_BEAST0 + g[0].q].hp + 1);
  out: [262144] u8; _ := e2rt_heard(v[..], 0, out[..]);
  swung := false; told := false; state := false;
  // you stand where you struck him from; he stays on you and strikes
  px := g[0].x + 0.9; pz := g[0].z;
  for q: 0..<EG_HZ * 8 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); if g[0].swing_tick >= 0 { swung = true; }
    heard := e2rt_heard(v[..], 0, out[..]); if eg_test_has(heard, "e guard ") { told = true; }
    // his row, in the tick's table and so in your frame: his state, his Hit Points and you as his foe
    w := wire_test_row(v[0].eg[k].hist[..], EG_SLOT_GUARD, v[0].eg[k].hist[0].now);
    if w.kind == WK_GUARD && cast(int) v[0].eg[k].hist[0].last[EG_SLOT_GUARD] == WIRE_ID_MADE + WIRE_GUARD_EID + 1 && w.g == E2G_FIGHTING && w.owner == WIRE_TGT_SEAT && w.max > 0 && w.hp > 0 { state = true; }
  }
  #assert swung && g[0].state == E2G_FIGHTING && told && state;
  // you at the Hit Points one blow could take: he keeps on you; dropped, he lets you be
  b[0].c[me].hp = 7; for q: 0..<3 { eg_test_tick(v[..], k); }
  #assert g[0].foe == 0 && g[0].state == E2G_FIGHTING;
  b[0].c[me].hp = 0; for q: 0..<3 { eg_test_tick(v[..], k); }
  #assert g[0].foe < 0;
  // he falls: down, gone from the battle, and a new life after E2G_RESPAWN_S
  life := g[0].life; b[0].c[EGB_BEAST0 + g[0].q].hp = 0; eg_test_tick(v[..], k);
  #assert g[0].q < 0 && g[0].state == E2G_DOWN;
  e2gt_at(v[..], k, 0, 0);
  for q: 0..<cast(int)(f32(E2G_RESPAWN_S) * f32(EG_HZ)) + 2 { eg_test_tick(v[..], k); }
  #assert g[0].q >= 0 && g[0].life == life + 1 && g[0].state == E2G_WALKING;
}
#test "e2 guard: in a fight he circles you within his reach on the steering service, never inside you" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-circle HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  g := v[0].eg[k].guard[..]; b := v[0].eg[k].rules[0].b[..];
  me := EGB_SEAT; b[0].c[me].hp = 900; b[0].c[me].hp_max = 900;
  px := g[0].x + 1.0; pz := g[0].z;
  e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[EGB_BEAST0 + g[0].q].hp + 1);
  out: [262144] u8;
  ux: f32 = 0; uz: f32 = 0; round_most: f32 = 1; least: f32 = 100; most: f32 = 0;
  for q: 0..<EG_HZ * 6 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]);
    dx := g[0].x - px; dz := g[0].z - pz; d := sqrt(dx * dx + dz * dz);
    if d < least { least = d; }
    if q == EG_HZ { ux = dx / d; uz = dz / d; }
    if q > EG_HZ { if d > most { most = d; } if ux * dx / d + uz * dz / d < round_most { round_most = ux * dx / d + uz * dz / d; } }
  }
  #assert g[0].state == E2G_FIGHTING && g[0].foe == 0;
  #assert least >= f32(E2G_CLEAR) - 0.001 && most <= f32(E2G_REACH) + 0.05;
  #assert round_most < 0.7;   // he went over 45 degrees round you in those five seconds
}
#test "e2 guard: a cast aimed at him from the bar is the shared rules' strike at him, and he turns on its caster" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-cast HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-druid 0 -");
  eg_test_tick(v[..], k);
  g := v[0].eg[k].guard[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  for q: 0..<EG_HZ { e2gt_at(v[..], k, g[0].x - 3, g[0].z + 8); eg_test_tick(v[..], k); }
  b[0].c[EGB_BEAST0 + g[0].q].ac = 1;
  out: [262144] u8; _ := e2rt_heard(v[..], 0, out[..]);
  eg_e2_cast(v[..], k, SeatId.{value = 0}, WireCast.{seq = 1, slot = xk_slot(FB_CL_DRUID, 1), ax = g[0].x, az = g[0].z});
  heard := e2rt_heard(v[..], 0, out[..]);
  #assert !eg_test_has(heard, "r 1 slot");
  #assert !eg_test_has(heard, cr_word(CR_RANGE));
  #assert !eg_test_has(heard, cr_word(CR_COOLDOWN));
  #assert !eg_test_has(heard, cr_word(CR_AIM));
  #assert !eg_test_has(heard, "r 1 ");
  #assert g[0].foe == 0;
}
#test "e2 guard: an SRD level 10 Fighter: AC 19, 84 Hit Points, a +8 Longsword for 1d8 + 4, two attacks a turn and four with Action Surge" #steps 4000000000 #traversal 1073741824 {
  c := rs_path_guard("Guard", 1);
  #assert c.hp_max == 84 && c.ac >= 18 && c.level == 10 && rs_proficiency(c.level) == 4 && c.score[RS_STR] == 18 && rs_mod(c.score[RS_CON]) == 2;
  #assert rs_weapon_attack(c, c.weapon) == 8 && rs_weapon(c.weapon).dice == 1 && rs_weapon(c.weapon).sides == 8 && rs_mod(c.score[RS_STR]) == 4;
  #assert c.extra_attack == 1 && c.uses[RS_USE_WIND] > 0 && c.uses[RS_USE_SURGE] == 1;
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-fighter HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  g := v[0].eg[k].guard[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  me := EGB_SEAT; b[0].c[me].hp = 900; b[0].c[me].hp_max = 900;
  #assert b[0].c[EGB_BEAST0 + g[0].q].hp == 84 && b[0].c[EGB_BEAST0 + g[0].q].ac == 19;
  e2gt_at(v[..], k, g[0].x + 0.9, g[0].z); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[EGB_BEAST0 + g[0].q].hp + 1);
  turns: [3] int; n := 0; seen := g[0].swing_tick; out: [262144] u8;
  for q: 0..<EG_HZ * 30 {
    e2gt_at(v[..], k, g[0].x + 0.9, g[0].z); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]);
    if g[0].swing_tick != seen && n < 3 {
      seen = g[0].swing_tick; turns[n] = g[0].blows; n += 1;
      for a: 0..<rs_min(g[0].blows, 4) { #assert g[0].dealt[a] == 0 || (g[0].dealt[a] >= 5 && g[0].dealt[a] <= 20); }
    }
  }
  // his first turn surges (two Attack actions, four attacks), then two a turn
  #assert n == 3 && turns[0] == 4 && turns[1] == 2 && turns[2] == 2;
}
// The e guard entries a page heard: how many, and the last one's KIND, SEAT and AMOUNT.
e2gt_g3 :: (heard: string) -> [4] int {
  r: [4] int; i := 0;
  while i + 8 <= heard.count {
    if heard[i..<i + 8] == "e guard " && (i == 0 || heard[i - 1] == ';' || heard[i - 1] == ' ') {
      w: [4] int; f := 0; j := i + 8; neg := false; cur := 0; any := false;
      while j < heard.count && heard[j] != '\n' && f < 4 {
        ch := heard[j];
        if ch == '-' { neg = true; } else if ch >= '0' && ch <= '9' { cur = cur * 10 + cast(int)(ch - '0'); any = true; }
        else if ch == ' ' { if any { w[f] = ifx neg then -cur else cur; f += 1; } cur = 0; neg = false; any = false; }
        else { break; }
        j += 1;
      }
      if any && f < 4 { w[f] = ifx neg then -cur else cur; f += 1; }
      if f == 4 { r[0] += 1; r[1] = w[1]; r[2] = w[2]; r[3] = w[3]; }
      i = j;
    } else { i += 1; }
  }
  return r;
}
// A fight's start for the checks: seat 0 joined as a Fighter with Hit Points to spare, at (x, z), having
// struck him.
e2gt_fight :: (v: [] RmServer, path: string) -> int {
  rm_init(v); rm_clock(v, 0, 1762190000000);
  #assert rm_join(v, 0, path) == 0;
  k := eg_room_at(v, v[0].conns[0].relay);
  rm_heard(v, 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v, k);
  b := v[0].eg[k].rules[0].b[..];
  b[0].c[EGB_SEAT].hp = 900; b[0].c[EGB_SEAT].hp_max = 900;
  return k;
}
#test "e2 guard: he closes on a player running from him at full speed" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-chase HTTP/1.1\r\n\r\n");
  g := v[0].eg[k].guard[..]; b := v[0].eg[k].rules[0].b[..];
  // you 6 m down the path from him, strike him, and run on down it at your full run
  pz := g[0].z - 6; e2gt_at(v[..], k, e2_road_x(pz), pz); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[EGB_BEAST0 + g[0].q].hp + 1);
  near: f32 = 100; most: f32 = 0; out: [262144] u8;
  // 4.8 s: you are then 26 m from where you struck him, inside his leash
  for q: 0..<cast(int)(f32(EG_HZ) * 4.8) {
    pz -= f32(E2_RUN_SPEED) / f32(EG_HZ);
    e2gt_at(v[..], k, e2_road_x(pz), pz);
    x0 := g[0].x; z0 := g[0].z;
    eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]);
    sx := g[0].x - x0; sz := g[0].z - z0; st := sqrt(sx * sx + sz * sz); if st > most { most = st; }
    dx := g[0].x - e2_road_x(pz); dz := g[0].z - pz; d := sqrt(dx * dx + dz * dz); if q > EG_HZ && d < near { near = d; }
  }
  #assert g[0].foe == 0 && g[0].state == E2G_FIGHTING;
  #assert near <= f32(E2G_REACH) + 0.2;                                     // he caught you up
  #assert most <= f32(E2G_CHASE) * eg_dash_rate(0.5, 30) / f32(EG_HZ) + 0.001;     // never faster than his Dash at its peak
  #assert v[0].eg[k].rules[0].beasts[g[0].q].dash_at > 0;                  // he took the Dash action to do it
}
#test "e2 guard: in reach he keeps you there, and follows your sidesteps" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-circle HTTP/1.1\r\n\r\n");
  g := v[0].eg[k].guard[..]; b := v[0].eg[k].rules[0].b[..];
  pz := g[0].z - 1.6; px := e2_road_x(pz); e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[EGB_BEAST0 + g[0].q].hp + 1);
  out: [262144] u8;
  for q: 0..<EG_HZ { e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  for q: 0..<EG_HZ * 2 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]);
    dx := g[0].x - px; dz := g[0].z - pz; d := sqrt(dx * dx + dz * dz);
    #assert d <= f32(E2G_REACH) && d >= f32(E2G_CLEAR) - 0.001;           // in his reach, never in you
    #assert rs_feet_to(b, EGB_BEAST0 + g[0].q, EGB_SEAT) <= 5;          // as the rules have it
  }
  // you sidestep 1.5 m across: he follows and has you in reach again within a second
  for q: 0..<EG_HZ / 2 { px += 3.0 / f32(EG_HZ); e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  for q: 0..<EG_HZ { e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  dx := g[0].x - px; dz := g[0].z - pz; #assert sqrt(dx * dx + dz * dz) <= f32(E2G_REACH);
}
#test "e2 guard: leaving his reach draws his Opportunity Attack; far off he shoots his Longbow" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-reach HTTP/1.1\r\n\r\n");
  g := v[0].eg[k].guard[..]; b := v[0].eg[k].rules[0].b[..]; i := EGB_BEAST0 + g[0].q;
  #assert b[0].c[i].ranged == W_LONGBOW;
  pz := g[0].z - 1.2; px := e2_road_x(pz); e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[i].hp + 1);
  out: [262144] u8;
  // wait for his turn to pass so his Reaction is his again, then step out of his reach
  for q: 0..<EG_HZ * 2 { e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  b[0].c[i].reacted = false;
  dx := px - g[0].x; dz := pz - g[0].z; d := sqrt(dx * dx + dz * dz);
  px = g[0].x + dx / d * 2.4; pz = g[0].z + dz / d * 2.4;
  before := b[0].c[EGB_SEAT].hp;
  e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
  #assert g[0].opportunity == 1 && b[0].c[i].reacted;
  // the blow told to your page is the Hit Points it took (its number over your head: one, that much)
  told := e2gt_g3(e2rt_heard(v[..], 0, out[..]));
  #assert told[0] == 1 && told[2] == 0 && told[3] == before - b[0].c[EGB_SEAT].hp && (told[1] == 2 || told[1] == 4);
  // you far down the path: he shoots rather than only running
  pz = g[0].z - 18; px = e2_road_x(pz);
  shot := false; arrow := false;
  for q: 0..<EG_HZ * 3 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
    t3 := e2gt_g3(e2rt_heard(v[..], 0, out[..])); if t3[0] > 0 && (t3[1] == 5 || t3[1] == 6) { arrow = true; }
    if v[0].eg[k].rules[0].beasts[g[0].q].shot_at > 0 { shot = true; }
  }
  #assert shot && arrow;   // and your page is told it was his arrow
}
