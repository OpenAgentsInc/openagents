// Everglade II's path guard, as the pages hear of him. He is the room's creature of the patrol behavior
// (#13293, #13427): his creature, template, spawn, troop and beat are rows of the content tables, and his
// walk, his fight, whom he fights (his threat list) and his steering are the creature runtime's
// (everglade/server/creatures.coax, "the patrol behavior"). A room whose tables have no patrol has no
// guard. His blows are the rules' turn (everglade/server/battle.coax egb_patrol_turn): the SRD 5.2.1
// Fighter at level 10 (rules/srd/npcs.coax rs_path_guard: AC 19, HP 84, two Longsword attacks at +8 for
// 1d8 + 4, Second Wind and Action Surge, a Longbow far off).
//
// This file holds no walk and no fight. It tells the pages his state (his row, WK_GUARD, each tick he
// changes and once a second when he doesn't) and each blow (`e guard`: AMOUNT 0 a miss; each of his
// turn's attacks is its own, E2G_BLOW_S apart) through the creature frames' codec, creature-wire.coax
// (proto/verse/everglade2-combat-v2.json), and answers whether a cast is aimed at him.
// The pages draw him a jitter buffer behind, as they draw each other (everglade/client/guard.coax).
#load "creature-wire.coax";   // e guard: the one codec the page reads his blows with (#13246, #13276)
#load "../world/points.coax";

E2G_AIM :: 1.6;             // m: a cast aimed this near him is aimed at him
E2G_BLOW_S :: E2M_SWING_S;  // s between his turn's attacks as the pages see and hear them: as long as he stands to his swing
E2G_WALKING :: 0; E2G_STANDING :: 1; E2G_FIGHTING :: 2; E2G_DOWN :: 3; E2G_NONE :: 4;   // his row's G

// What was last told of him.
E2Guard :: struct {
  life: int;                 // the life his blows and hurts are read for
  told_life: int;            // the life his row last said (e2_guard_row)
  hp: int;                   // his Hit Points last tick
  foe: int = -1;             // the seat he fought last tick: a hurt of his names it
  seq: int;                  // the battle's log read to (its seq): his attacks are told from it
  blows: int;                // the attacks of his last turn that struck at someone
  dealt: [4] int;            // and the damage of each (0 a miss)
}
// His state as his row says it.
e2_guard_state :: (v: [] RmServer, k: int) -> int {
  mo := e2_patrol(v, k)[0];
  if mo.state == E2M_GONE { return E2G_NONE; }
  if mo.state == E2M_DEAD { return E2G_DOWN; }
  if mo.state == E2M_CHASE { return E2G_FIGHTING; }
  return ifx mo.moved then E2G_WALKING else E2G_STANDING;
}
// After the rules' step and the runtime's (e2_monsters_after): his blows told, his hurts told.
e2_guard_after :: (v: [] RmServer, k: int) {
  g := v[0].eg[k].guard[..]; mo := e2_patrol(v, k)[0]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  if mo.q < 0 || mo.state == E2M_GONE { return; }
  fell := mo.state == E2M_DEAD;
  if fell && mo.down_t != v[0].eg[k].tick { return; }   // told on the tick he fell; his creature's place may be another's after
  i := egb0(v, k) + mo.q;
  if g[0].life != mo.life { g[0].life = mo.life; g[0].hp = b[0].c[i].hp; g[0].seq = b[0].book[0].seq; g[0].foe = -1; }
  e2_guard_blows(v, k);
  hp := ifx fell then 0 else b[0].c[i].hp;
  if hp < g[0].hp { e2g_tell(v, k, 1, g[0].foe, g[0].hp - hp); }
  g[0].hp = hp; g[0].foe = e2_patrol_foe(v, k);
}
// His attacks since the log was last read, each told on its own, E2G_BLOW_S apart: whom it struck at
// (a seat, or a monster through everglade/server/creatures.coax) and the damage it did (0 a miss).
e2_guard_blows :: (v: [] RmServer, k: int) {
  g := v[0].eg[k].guard[..]; b := v[0].eg[k].rules[0].b[..]; mo := e2_patrol(v, k)[0];
  if mo.q < 0 { return; }
  i := egb0(v, k) + mo.q;
  if g[0].life != mo.life { g[0].life = mo.life; g[0].hp = b[0].c[i].hp; g[0].seq = b[0].book[0].seq; g[0].foe = -1; }
  fresh := rs_min(b[0].book[0].seq - g[0].seq, b[0].book[0].count); g[0].seq = b[0].book[0].seq;
  if fresh <= 0 { return; }
  n := 0; to := -1; amount := 0; crit := false;
  // his turn's attacks this step were his Longbow's when he shot this step (egb_patrol_turn)
  bt := v[0].eg[k].rules[0].beasts[mo.q]; shot := bt.shot_at > EGB_NEVER && bt.shot_at >= b[0].clock;
  for e: 0..<fresh + 1 {
    // the last pass tells the attack still open
    kind := 0; by := -1; at := -1; dealt := 0; kind_of := 0;
    if e < fresh {
      x := (b[0].book[0].head + b[0].book[0].count - fresh + e) % RS_EVENTS;
      kind = b[0].book[0].ev[x].kind; by = b[0].book[0].ev[x].by.value; at = b[0].book[0].ev[x].to.value; dealt = b[0].book[0].ev[x].amount; kind_of = b[0].book[0].ev[x].damage;
    }
    if by == i && kind == RS_EV_DAMAGE && at == to { amount += dealt; continue; }
    if to >= 0 && (e == fresh || (by == i && (kind == RS_EV_ATTACK || kind == RS_EV_MISS))) {
      tick := v[0].eg[k].tick + cast(int)(f32(n) * f32(E2G_BLOW_S) * f32(EG_HZ));
      // a critical hit at a seat is told as KIND 4, so its page shows it as one
      if to >= EGB_SEAT && to < EGB_SEAT + eg_cap(v, k) { e2g_tell_at(v, k, tick, ifx shot then (ifx crit && amount > 0 then 6 else 5) else (ifx crit && amount > 0 then 4 else 2), to - EGB_SEAT, amount); }
      else { e2_monster_guarded_at(v, k, tick, to, amount); }
      if n < 4 { g[0].dealt[n] = amount; }
      n += 1; to = -1; amount = 0; crit = false;
    }
    if by == i && (kind == RS_EV_ATTACK || kind == RS_EV_MISS) { to = at; amount = 0; crit = kind == RS_EV_ATTACK && kind_of == 1; }
  }
  if n > 0 { g[0].blows = n; }
}
// A seat's cast at the guard: the creature it harms, when it is aimed within E2G_AIM m of him (-1 none).
e2_guard_target :: (v: [] RmServer, k: int, ax: f32, az: f32) -> int { return e2_guard_target_at(v, k, ax, az, v[0].eg[k].tick); }
// The same, with the guard where he stood at tick `at` (the caster's page's view, #13289).
e2_guard_target_at :: (v: [] RmServer, k: int, ax: f32, az: f32, at: int) -> int {
  mo := e2_patrol(v, k)[0];
  if !e2mo_up(v, k, E2M_PATROL) { return -1; }
  was := e2a_stood(v, k, E2AR_GUARD, at, mo.x, mo.z);
  dx := ax - was[0]; dz := az - was[1];
  return ifx dx * dx + dz * dz <= f32(E2G_AIM * E2G_AIM) then egb0(v, k) + mo.q else -1;
}
// The rules' creature the guard is, while he stands (-1 none), and the rules' beast (-1 none).
e2_guard_creature :: (v: [] RmServer, k: int) -> int { return ifx e2mo_up(v, k, E2M_PATROL) then egb0(v, k) + e2_patrol(v, k)[0].q else -1; }
e2_guard_beast :: (v: [] RmServer, k: int) -> int { mo := e2_patrol(v, k)[0]; return ifx mo.state == E2M_GONE then -1 else mo.q; }
// Seat s harmed him (or tried; hp_before his Hit Points before): the runtime puts them on his threat
// list, and a cast that took no Hit Points is told as a miss.
e2_guard_struck :: (v: [] RmServer, k: int, s: int, hp_before: int) {
  i := e2_guard_creature(v, k);
  if i < 0 { return; }
  hp := v[0].eg[k].rules[0].b[0].c[i].hp;
  e2_patrol_struck(v, k, s, rs_max(hp_before - hp, 0));
  if hp >= hp_before { e2g_tell(v, k, 1, s, 0); }
}
e2g_tell :: (v: [] RmServer, k: int, kind: int, s: int, amount: int) { e2g_tell_at(v, k, v[0].eg[k].tick, kind, s, amount); }
e2g_tell_at :: (v: [] RmServer, k: int, tick: int, kind: int, s: int, amount: int) {
  mo := e2_patrol(v, k)[0];
  out: [64] u8;
  n := egc_guard_hit_put(out[..], EgcGuardHit.{tick = tick, kind = kind, seat = s, amount = amount});
  // to the seats near him, and to the one it names wherever it is: an e entry of the reliable class (#13276)
  eg_event_to(v, k, cast(string) out[0..<n], mo.x, mo.z, false, s);
}
// His row into the tick's table (everglade/server/send.coax eg_table; everglade-wire.coax WK_GUARD):
// none while there is no guard, and the next one is a new life.
e2_guard_row :: (v: [] RmServer, k: int) {
  room := v[0].eg[k..<k + 1]; g := room[0].guard[..]; h := room[0].hist[..]; mo := e2_patrol(v, k)[0];
  state := e2_guard_state(v, k);
  if state == E2G_NONE { return; }
  hp := 0; max := 0;
  if mo.q >= 0 && state != E2G_DOWN { hp = room[0].rules[0].b[0].c[egb0(v, k) + mo.q].hp; max = room[0].rules[0].b[0].c[egb0(v, k) + mo.q].hp_max; }
  if g[0].told_life != mo.life { wire_hist_born(h, EG_SLOT_GUARD); g[0].told_life = mo.life; }
  foe := e2_patrol_foe(v, k);
  wire_hist_put(h, EG_SLOT_GUARD, WireS.{id = WIRE_ID_MADE + WIRE_GUARD_EID, kind = WK_GUARD, x = mo.x, z = mo.z, yaw = e2mo_wrap(mo.yaw),
    g = state, hp = hp, max = max, owner = ifx foe >= 0 then WIRE_TGT_SEAT + foe else -1, t0 = mo.swing_t}, wire_rel(WK_GUARD), false, true);
}
// Where his body stands for the movement step (room-world.c world2_step): false when there is none.
rm_e2_guard_body :: (v: [] RmServer, k: int, out: [] f32) -> bool #export_c #effects(all) {
  if k < 0 || k >= EG_ROOMS || !v[0].eg[k].live || out.count < 2 { return false; }
  if !e2mo_up(v, k, E2M_PATROL) { return false; }
  mo := e2_patrol(v, k)[0];
  out[0] = mo.x; out[1] = mo.z;
  return true;
}

// ---- checks
#test "the guard's beat starts at Everglade II's named guard post (#13078, #13427)" {
  p := e2_point("guard-post"); v: [1] RmServer; rm_init(v[..]); z := v[0].zoo[..];
  #assert p.found && z[0].beat_n == 24 && z[0].beat[0].z == p.z && z[0].beat[0].x == 3.47 && z[0].row[E2M_PATROL].z == p.z && z[0].beat[0].rest == 2 && z[0].beat[23].rest == 2 && z[0].beat[1].rest == 0;
  // every point of it is on the road, and the last is at the clearing's edge
  for q: 0..<z[0].beat_n { #assert abs(z[0].beat[q].x - e2_road_x(z[0].beat[q].z)) < 0.02 && e2_may_stand(z[0].beat[q].x, z[0].beat[q].z); if q > 0 { #assert z[0].beat[q].z < z[0].beat[q - 1].z; } }
  #assert z[0].beat[23].z == E2_CLEAR_Z + 15;
}
// A check's seat 0 at (x, z): where the room has it, and its square in the battle.
e2gt_at :: (v: [] RmServer, k: int, x: f32, z: f32) { v[0].eg[k].seat[0].pose.x = x; v[0].eg[k].seat[0].pose.z = z; egb_place(v[0].eg[k].rules[..], 0, x, z); }
// The guard's creature in a check's room.
e2gt_i :: (v: [] RmServer, k: int) -> int { return EGB_BEAST0 + e2_patrol(v, k)[0].q; }
#test "e2 guard: he walks his beat at a walk, point to point; at its end he stands, turns slowly and walks back" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  mo := e2_patrol(v[..], k); zo := v[0].zoo[..];
  #assert mo[0].q >= 0 && mo[0].state == E2M_IDLE && e2mo_up(v[..], k, E2M_PATROL) && e2_guard_state(v[..], k) == E2G_STANDING;
  #assert abs(mo[0].z - zo[0].beat[0].z) < 0.1 && abs(mo[0].x - zo[0].beat[0].x) < 0.1;
  #assert v[0].eg[k].rules[0].beasts[mo[0].q].patrol && !v[0].eg[k].rules[0].beasts[mo[0].q].wild && v[0].eg[k].rules[0].b[0].c[e2gt_i(v[..], k)].hp == 84;
  // he stands his post's two seconds, then walks: in ten seconds, eight at 1.4 m/s
  z0 := mo[0].z; walked := 0; most: f32 = 0;
  for q: 0..<EG_HZ * 10 {
    x0 := mo[0].x; zz := mo[0].z; eg_test_tick(v[..], k);
    st := e2mo_dist(mo[0].x, mo[0].z, x0, zz); if st > most { most = st; }
    if e2_guard_state(v[..], k) == E2G_WALKING { walked += 1; }
  }
  went := z0 - mo[0].z;
  #assert went > 9.5 && went < 11.3 && walked > EG_HZ * 7 && most <= f32(E2M_WALK) / f32(EG_HZ) + 0.001;
  #assert mo[0].beat == 1 && mo[0].beat_dir == 1 && e2_may_stand(mo[0].x, mo[0].z) && e2_road_dist(mo[0].x, mo[0].z) < 2.5;
  #assert v[0].eg[k].rules[0].beasts[mo[0].q].moving;
  // near the clearing's end of it: he comes to the last point, stands, turns no faster than E2M_STEER, and walks back up
  last := zo[0].beat[zo[0].beat_n - 1];
  e2gt_at(v[..], k, last.x + 6, last.z + 20);
  mo[0].x = last.x; mo[0].z = last.z + 3; mo[0].beat = zo[0].beat_n - 1; mo[0].beat_dir = 1;
  yaw := mo[0].yaw; turn_most: f32 = 0; stood := 0; back := false;
  for q: 0..<EG_HZ * 12 {
    eg_test_tick(v[..], k);
    d := abs(e2mo_wrap(mo[0].yaw - yaw)); if d > turn_most { turn_most = d; } yaw = mo[0].yaw;
    if e2_guard_state(v[..], k) == E2G_STANDING { stood += 1; }
    if mo[0].beat_dir < 0 && e2_guard_state(v[..], k) == E2G_WALKING { back = true; }
  }
  #assert back && stood >= EG_HZ * 2 && turn_most <= f32(E2M_STEER) / f32(EG_HZ) + 0.001 && mo[0].beat == zo[0].beat_n - 2 && mo[0].z > last.z + 1.5;
}
#test "e2 guard: a player in his way is gone round, never walked into; with no beat he stands at his troop's point" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-way HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  mo := e2_patrol(v[..], k);
  for q: 0..<EG_HZ * 4 { eg_test_tick(v[..], k); }
  // you stand on his line, 2 m ahead of him
  zo := v[0].zoo[..]; p := zo[0].beat[mo[0].beat]; d0 := e2mo_dist(mo[0].x, mo[0].z, p.x, p.z);
  px := mo[0].x + (p.x - mo[0].x) / d0 * 2; pz := mo[0].z + (p.z - mo[0].z) / d0 * 2;
  near: f32 = 100;
  for q: 0..<EG_HZ * 12 {
    e2gt_at(v[..], k, px, pz);
    eg_test_tick(v[..], k);
    d := e2mo_dist(mo[0].x, mo[0].z, px, pz); if d < near { near = d; }
  }
  #assert near >= f32(E2M_CLEAR) - 0.001 && near < 1.6;
  #assert mo[0].z < pz - 3 && mo[0].state == E2M_IDLE;
  // tables with a patrol and no beat: he stands at his troop's point, and walks back to it when moved off
  o: [CT_BODY] u8; d: [1] ContentDoc;
  cut := ec_sub(EC_SHIPPED, "1|11|14|2\n", "1|10|14|2\n", o[..]);
  #assert ct_read(d[..], cut) && e2zoo_load(v[..], d[..]) && zo[0].beat_n == 23;
  e2zoo_shipped(v[..]); zo[0].beat_n = 0;
  row := e2mo_row(v[..], E2M_PATROL); e2gt_at(v[..], k, row.x + 5, row.z + 5);
  mo[0].x = row.x; mo[0].z = row.z - 4; mo[0].rest = 0;
  for q: 0..<EG_HZ * 6 { eg_test_tick(v[..], k); }
  #assert e2mo_dist(mo[0].x, mo[0].z, row.x, row.z) <= f32(E2M_BEAT_NEAR) + 0.01 && e2_guard_state(v[..], k) == E2G_STANDING;
}
#test "e2 guard: struck, he fights back with his Longsword; he keeps on you until you drop, falls and comes back unseen" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-fight HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v[..], k);
  mo := e2_patrol(v[..], k); r := v[0].eg[k].rules[..]; b := r[0].b[..];
  me := EGB_SEAT; b[0].c[me].hp = 400; b[0].c[me].hp_max = 400;
  // he doesn't strike first: you beside him, untouched
  for q: 0..<EG_HZ * 3 { e2gt_at(v[..], k, mo[0].x + 0.9, mo[0].z); eg_test_tick(v[..], k); }
  #assert b[0].c[me].hp == 400 && e2_patrol_foe(v[..], k) < 0 && mo[0].swing_t < 0 && mo[0].threat_n == 0;
  #assert e2_guard_target(v[..], k, mo[0].x + 0.5, mo[0].z) == e2gt_i(v[..], k) && e2_guard_target(v[..], k, mo[0].x + 3, mo[0].z) == -1 && e2_guard_creature(v[..], k) == e2gt_i(v[..], k) && e2_guard_beast(v[..], k) == mo[0].q;
  e2_guard_struck(v[..], k, 0, b[0].c[e2gt_i(v[..], k)].hp + 1);
  #assert e2th_of(mo[0], 0) == 1 && mo[0].state == E2M_CHASE;   // a miss is 1 of a threat
  out: [262144] u8; _ := e2rt_heard(v[..], 0, out[..]);
  swung := false; told := false; state := false;
  // you stand where you struck him from; he stays on you and strikes
  px := mo[0].x + 0.9; pz := mo[0].z;
  for q: 0..<EG_HZ * 8 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); if mo[0].swing_t >= 0 { swung = true; }
    heard := e2rt_heard(v[..], 0, out[..]); if eg_test_has(heard, "e guard ") { told = true; }
    // his row, in the tick's table and so in your frame: his state, his Hit Points and you as his foe
    w := wire_test_row(v[0].eg[k].hist[..], EG_SLOT_GUARD, v[0].eg[k].hist[0].now);
    if w.kind == WK_GUARD && cast(int) v[0].eg[k].hist[0].last[EG_SLOT_GUARD] == WIRE_ID_MADE + WIRE_GUARD_EID + 1 && w.g == E2G_FIGHTING && w.owner == WIRE_TGT_SEAT && w.max > 0 && w.hp > 0 && w.t0 == mo[0].swing_t { state = true; }
  }
  #assert swung && e2_guard_state(v[..], k) == E2G_FIGHTING && told && state;
  // you at the Hit Points one blow could take: he keeps on you; dropped, he lets you be and takes up his beat
  b[0].c[me].hp = 7; for q: 0..<3 { eg_test_tick(v[..], k); }
  #assert e2_patrol_foe(v[..], k) == 0 && mo[0].state == E2M_CHASE;
  b[0].c[me].hp = 0; for q: 0..<3 { eg_test_tick(v[..], k); }
  #assert e2_patrol_foe(v[..], k) < 0 && mo[0].state == E2M_IDLE && mo[0].threat_n == 0;
  // he falls: down, gone from the battle, his row says so, and you get no XP for him
  xp := v[0].ev[k].xp[0];
  _ = slot_set_put(mo[0].hurt_by[..], 0, true);
  life := mo[0].life; b[0].c[e2gt_i(v[..], k)].hp = 0; eg_test_tick(v[..], k);
  #assert mo[0].state == E2M_DEAD && e2_guard_state(v[..], k) == E2G_DOWN && !e2mo_up(v[..], k, E2M_PATROL) && e2_guard_creature(v[..], k) == -1 && v[0].ev[k].xp[0] == xp;
  w := wire_test_row(v[0].eg[k].hist[..], EG_SLOT_GUARD, v[0].eg[k].hist[0].now); #assert w.kind == WK_GUARD && w.g == E2G_DOWN && w.hp == 0;
  body: [2] f32; #assert !rm_e2_guard_body(v[..], k, body[..]);
  // his troop's respawn after: a new life at the first point of his beat no player is near (you by the second and third: the fourth)
  e2gt_at(v[..], k, e2_road_x(-50), -50);
  for q: 0..<cast(int)(e2mo_row(v[..], E2M_PATROL).respawn * f32(EG_HZ)) + 2 { eg_test_tick(v[..], k); }
  zo := v[0].zoo[..];
  #assert mo[0].q >= 0 && mo[0].life == life + 1 && mo[0].state == E2M_IDLE && e2mo_dist(mo[0].x, mo[0].z, e2_road_x(-50), -50) >= f32(E2M_UNSEEN) - 2 && mo[0].z < -90 && mo[0].z > -100;
  #assert rm_e2_guard_body(v[..], k, body[..]) && body[0] == mo[0].x && body[1] == mo[0].z && v[0].eg[k].guard[0].hp == 84 && zo[0].beat[4].z == -97;
}
// A fight's start for the checks: seat 0 joined as a Fighter with Hit Points to spare.
e2gt_fight :: (v: [] RmServer, path: string) -> int {
  rm_init(v); rm_clock(v, 0, 1762190000000);
  #assert rm_join(v, 0, path) == 0;
  k := eg_room_at(v, v[0].conns[0].relay);
  rm_heard(v, 0, "H 6 ranger.0.0.0 srd-fighter 0 -");
  eg_test_tick(v, k);
  b := v[0].eg[k].rules[0].b[..];
  b[0].c[EGB_SEAT].hp = 900; b[0].c[EGB_SEAT].hp_max = 900;
  return k;
}
#test "e2 guard: in a fight he closes to within his reach on the room's cells and keeps you there, never inside you, and follows your sidesteps" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-circle HTTP/1.1\r\n\r\n");
  mo := e2_patrol(v[..], k); b := v[0].eg[k].rules[0].b[..];
  pz := mo[0].z - 3.5; px := e2_road_x(pz); e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[e2gt_i(v[..], k)].hp + 1);
  out: [262144] u8;
  for q: 0..<EG_HZ * 2 { e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  for q: 0..<EG_HZ * 2 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]);
    d := e2mo_dist(mo[0].x, mo[0].z, px, pz);
    #assert d <= f32(E2M_STAND) + 0.05 && d >= f32(E2M_CLEAR) - 0.001;   // in his reach, never in you
    #assert rs_feet_to(b, e2gt_i(v[..], k), EGB_SEAT) <= 5;               // as the rules have it
  }
  #assert mo[0].state == E2M_CHASE && e2_patrol_foe(v[..], k) == 0 && e2_guard_state(v[..], k) == E2G_FIGHTING;
  // you sidestep 1.5 m across: he follows and has you in reach again within a second
  for q: 0..<EG_HZ / 2 { px += 3.0 / f32(EG_HZ); e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  for q: 0..<EG_HZ { e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  #assert e2mo_dist(mo[0].x, mo[0].z, px, pz) <= f32(E2M_STAND) + 0.05;
}
#test "e2 guard: a cast aimed at him from the bar is the shared rules' strike at him, and he turns on its caster" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-guard-cast HTTP/1.1\r\n\r\n") == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 srd-druid 0 -");
  eg_test_tick(v[..], k);
  mo := e2_patrol(v[..], k); r := v[0].eg[k].rules[..]; b := r[0].b[..];
  for q: 0..<EG_HZ { e2gt_at(v[..], k, mo[0].x - 3, mo[0].z + 8); eg_test_tick(v[..], k); }
  b[0].c[e2gt_i(v[..], k)].ac = 1;
  out: [262144] u8; _ := e2rt_heard(v[..], 0, out[..]);
  eg_e2_cast(v[..], k, SeatId.{value = 0}, WireCast.{seq = 1, slot = xk_slot(FB_CL_DRUID, 1), ax = mo[0].x, az = mo[0].z});
  heard := e2rt_heard(v[..], 0, out[..]);
  #assert !eg_test_has(heard, "r 1 slot");
  #assert !eg_test_has(heard, cr_word(CR_RANGE));
  #assert !eg_test_has(heard, cr_word(CR_COOLDOWN));
  #assert !eg_test_has(heard, cr_word(CR_AIM));
  #assert !eg_test_has(heard, "r 1 ");
  #assert e2_patrol_foe(v[..], k) == 0 && mo[0].threat_n == 1 && mo[0].threat[0].seat == 0;
}
#test "e2 guard: an SRD level 10 Fighter: AC 19, 84 Hit Points, a +8 Longsword for 1d8 + 4, two attacks a turn and four with Action Surge" #steps 4000000000 #traversal 1073741824 {
  c := rs_path_guard("Guard", 1);
  #assert c.hp_max == 84 && c.ac >= 18 && c.level == 10 && rs_proficiency(c.level) == 4 && c.score[RS_STR] == 18 && rs_mod(c.score[RS_CON]) == 2;
  #assert rs_weapon_attack(c, c.weapon) == 8 && rs_weapon(c.weapon).dice == 1 && rs_weapon(c.weapon).sides == 8 && rs_mod(c.score[RS_STR]) == 4;
  #assert c.rank[RS_RK_EXTRA_ATTACK] == 1 && c.uses[RS_USE_WIND] > 0 && c.uses[RS_USE_SURGE] == 1;
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-fighter HTTP/1.1\r\n\r\n");
  mo := e2_patrol(v[..], k); g := v[0].eg[k].guard[..]; r := v[0].eg[k].rules[..]; b := r[0].b[..];
  #assert b[0].c[e2gt_i(v[..], k)].hp == 84 && b[0].c[e2gt_i(v[..], k)].ac == 19;
  e2gt_at(v[..], k, mo[0].x + 1.1, mo[0].z); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[e2gt_i(v[..], k)].hp + 1);
  turns: [3] int; n := 0; seen := mo[0].swing_t; out: [262144] u8; px := mo[0].x + 1.1; pz := mo[0].z;
  for q: 0..<EG_HZ * 30 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]);
    if mo[0].swing_t != seen && n < 3 {
      seen = mo[0].swing_t; turns[n] = g[0].blows; n += 1;
      for a: 0..<rs_min(g[0].blows, 4) { #assert g[0].dealt[a] == 0 || (g[0].dealt[a] >= 5 && g[0].dealt[a] <= 20); }
    }
  }
  // his first turn surges (two Attack actions, four attacks), then two a turn
  #assert n == 3 && turns[0] == 4 && turns[1] == 2 && turns[2] == 2;
}
// The e guard entries a page heard: how many, and the last one's KIND, SEAT and AMOUNT.
e2gt_g3 :: (heard: string) -> [4] int {
  r: [4] int; i := 0;
  while i + 8 <= heard.count {
    if heard[i..<i + 8] == "e guard " && (i == 0 || heard[i - 1] == ';' || heard[i - 1] == ' ') {
      w: [4] int; f := 0; j := i + 8; neg := false; cur := 0; any := false;
      while j < heard.count && heard[j] != '\n' && f < 4 {
        ch := heard[j];
        if ch == '-' { neg = true; } else if ch >= '0' && ch <= '9' { cur = cur * 10 + cast(int)(ch - '0'); any = true; }
        else if ch == ' ' { if any { w[f] = ifx neg then -cur else cur; f += 1; } cur = 0; neg = false; any = false; }
        else { break; }
        j += 1;
      }
      if any && f < 4 { w[f] = ifx neg then -cur else cur; f += 1; }
      if f == 4 { r[0] += 1; r[1] = w[1]; r[2] = w[2]; r[3] = w[3]; }
      i = j;
    } else { i += 1; }
  }
  return r;
}
#test "e2 guard: he closes on a player running from him at full speed, and lets them go past his leash" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-chase HTTP/1.1\r\n\r\n");
  mo := e2_patrol(v[..], k); b := v[0].eg[k].rules[0].b[..];
  for q: 0..<EG_HZ * 3 { eg_test_tick(v[..], k); }
  // you 6 m down the path from him, strike him, and run on down it at your full run
  pz := mo[0].z - 6; e2gt_at(v[..], k, e2_road_x(pz), pz); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[e2gt_i(v[..], k)].hp + 1);
  x0 := mo[0].x; z0 := mo[0].z;
  near: f32 = 100; most: f32 = 0; out: [262144] u8;
  // 4.8 s: you are then 26 m from where you struck him, inside his leash
  for q: 0..<cast(int)(f32(EG_HZ) * 4.8) {
    pz -= f32(E2_RUN_SPEED) / f32(EG_HZ);
    e2gt_at(v[..], k, e2_road_x(pz), pz);
    sx := mo[0].x; sz := mo[0].z;
    eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]);
    st := e2mo_dist(mo[0].x, mo[0].z, sx, sz); if st > most { most = st; }
    d := e2mo_dist(mo[0].x, mo[0].z, e2_road_x(pz), pz); if q > EG_HZ && d < near { near = d; }
  }
  #assert e2_patrol_foe(v[..], k) == 0 && mo[0].state == E2M_CHASE && mo[0].hx == x0 && mo[0].hz == z0;
  #assert near <= 1.7;                                                         // he caught you up
  #assert most <= e2mo_tpl(v[..], mo[0]).run * eg_dash_rate(0.5, 30) / f32(EG_HZ) + 0.001 && e2mo_tpl(v[..], mo[0]).run == f32(E2_RUN_SPEED);   // never faster than his Dash at its peak; his run is yours
  #assert v[0].eg[k].rules[0].beasts[mo[0].q].dash_at > 0;                     // he took the Dash action to do it
  // on past his leash (28 m from where the fight began): he lets you go, and walks his beat
  for q: 0..<EG_HZ * 2 { pz -= f32(E2_RUN_SPEED) / f32(EG_HZ); e2gt_at(v[..], k, e2_road_x(pz), pz); eg_test_tick(v[..], k); }
  #assert e2mo_dist(e2_road_x(pz), pz, x0, z0) > e2mo_tpl(v[..], mo[0]).leash && mo[0].state == E2M_IDLE && mo[0].threat_n == 0 && e2_patrol_foe(v[..], k) < 0;
}
#test "e2 guard: leaving his reach draws his Opportunity Attack; far off he shoots his Longbow" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-reach HTTP/1.1\r\n\r\n");
  mo := e2_patrol(v[..], k); b := v[0].eg[k].rules[0].b[..]; i := e2gt_i(v[..], k);
  #assert b[0].c[i].ranged == W_LONGBOW;
  pz := mo[0].z - 1.2; px := e2_road_x(pz); e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
  e2_guard_struck(v[..], k, 0, b[0].c[i].hp + 1);
  out: [262144] u8;
  // wait for his turn to pass so his Reaction is his again, then step out of his reach
  for q: 0..<EG_HZ * 2 { e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k); _ := e2rt_heard(v[..], 0, out[..]); }
  b[0].c[i].reacted = false;
  d := e2mo_dist(px, pz, mo[0].x, mo[0].z);
  px = mo[0].x + (px - mo[0].x) / d * 2.4; pz = mo[0].z + (pz - mo[0].z) / d * 2.4;
  before := b[0].c[EGB_SEAT].hp;
  e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
  #assert mo[0].opportunity == 1 && b[0].c[i].reacted;
  // the blow told to your page is the Hit Points it took (its number over your head: one, that much)
  told := e2gt_g3(e2rt_heard(v[..], 0, out[..]));
  #assert told[0] == 1 && told[2] == 0 && told[3] == before - b[0].c[EGB_SEAT].hp && (told[1] == 2 || told[1] == 4);
  // you far down the path: he shoots rather than only running
  pz = mo[0].z - 18; px = e2_road_x(pz);
  shot := false; arrow := false;
  for q: 0..<EG_HZ * 3 {
    e2gt_at(v[..], k, px, pz); eg_test_tick(v[..], k);
    t3 := e2gt_g3(e2rt_heard(v[..], 0, out[..])); if t3[0] > 0 && (t3[1] == 5 || t3[1] == 6) { arrow = true; }
    if v[0].eg[k].rules[0].beasts[mo[0].q].shot_at > 0 { shot = true; }
  }
  #assert shot && arrow;   // and your page is told it was his arrow
}
#test "e2 guard: whom he fights is the top of his threat list, as every creature's: more harm pulls him, and fifteen seconds with no blow end it (#13427)" #steps 4000000000 #traversal 1073741824 {
  v: [1] RmServer; k := e2gt_fight(v[..], "GET /api/room/relay/everglade/pair-e2-guard-threat HTTP/1.1\r\n\r\n");
  #assert rm_join(v[..], 1, "GET /api/room/relay/everglade/pair-e2-guard-threat HTTP/1.1\r\n\r\n") == 1;
  rm_heard(v[..], 1, "H 6 ranger.0.0.0 srd-cleric 0 -"); eg_test_tick(v[..], k);
  mo := e2_patrol(v[..], k); b := v[0].eg[k].rules[0].b[..]; i := e2gt_i(v[..], k);
  for s: 0..<2 { b[0].c[EGB_SEAT + s].hp = 5000; b[0].c[EGB_SEAT + s].hp_max = 5000; b[0].c[EGB_SEAT + s].ac = 30; }
  b[0].c[i].hp_max = 5000; b[0].c[i].hp = 5000;
  ax := mo[0].x + 3; az := mo[0].z; bx := mo[0].x - 3; bz := mo[0].z;
  e2mt_seat_at(v[..], k, 0, ax, az); e2mt_seat_at(v[..], k, 1, bx, bz); eg_test_tick(v[..], k);
  // seat 0 takes 10 of his Hit Points: he fights seat 0
  b[0].c[i].hp = 4990; e2_guard_struck(v[..], k, 0, 5000);
  e2mt_seat_at(v[..], k, 0, ax, az); e2mt_seat_at(v[..], k, 1, bx, bz); eg_test_tick(v[..], k);
  #assert e2th_of(mo[0], 0) == 10 && e2_patrol_foe(v[..], k) == 0 && v[0].eg[k].rules[0].beasts[mo[0].q].foe == EGB_SEAT;
  // seat 1's 10 is level, not enough; 1 more makes 110 percent and pulls him
  b[0].c[i].hp = 4980; e2_guard_struck(v[..], k, 1, 4990);
  e2mt_seat_at(v[..], k, 0, ax, az); e2mt_seat_at(v[..], k, 1, bx, bz); eg_test_tick(v[..], k);
  #assert e2_patrol_foe(v[..], k) == 0;
  e2_guard_struck(v[..], k, 1, 4980);
  e2mt_seat_at(v[..], k, 0, ax, az); e2mt_seat_at(v[..], k, 1, bx, bz); eg_test_tick(v[..], k);
  #assert e2th_of(mo[0], 1) == 11 && e2_patrol_foe(v[..], k) == 1 && v[0].eg[k].rules[0].beasts[mo[0].q].foe == EGB_SEAT + 1;
  // seat 1 falls: the next on his list
  b[0].c[EGB_SEAT + 1].hp = 0;
  e2mt_seat_at(v[..], k, 0, ax, az); eg_test_tick(v[..], k);
  #assert e2_patrol_foe(v[..], k) == 0;
  // no blow either way for E2M_CALM_S: he lets it be (his blows miss AC 30 but are blows: hold him off them)
  calm := false;
  for q: 0..<e2mo_hz(f32(E2M_CALM_S)) + 3 {
    mo[0].swing_t = -1; b[0].c[i].turn_at = b[0].clock + 100000;
    e2mt_seat_at(v[..], k, 0, ax, az); eg_test_tick(v[..], k);
    if mo[0].state == E2M_IDLE { calm = true; break; }
    #assert q < e2mo_hz(f32(E2M_CALM_S)) + 2;
  }
  #assert calm && mo[0].threat_n == 0 && v[0].eg[k].rules[0].beasts[mo[0].q].foe == -1;
}
