// Everglade v1's town in the room: the host's world steps it (room-world.c world_town). v1 only;
// it leaves the default room with v1 (#13267, #13269). Moved from coax/web/room/room-everglade.coax.
// ---- the town: the host's world steps it between rm_eg_begin and rm_eg_end (room-world.c world_town)

// Whether room k is new since the world last heard (its town starts whole: world_fresh).
rm_eg_fresh :: (v: [] RmServer, k: int) -> bool #export_c #effects(all) {
  if !rm_eg_live(v, k) || !v[0].eg[k].fresh { return false; }
  v[0].eg[k].fresh = false;
  return true;
}
// Seat s for the world: X Y Z LIVE HP MAX COND (everglade-watch.coax EG_ROOM_SEAT_FLOATS; LIVE 2 just sat).
rm_eg_seat_town :: (v: [] RmServer, k: int, s_id: SeatId, out: [] f32) #export_c #effects(all) { s := s_id.value;
  if out.count < 7 { return; }
  for q: 0..<7 { out[q] = 0; }
  if !rm_eg_seat_live(v, k, s_id) || !v[0].eg[k].seat[s].placed { return; }
  o: [E5RR_OUT_FLOATS] f32;
  e5rr_seat_out(v[0].eg[k].rules[..], s, o[..]);
  p := v[0].eg[k].seat[s].pose;
  out[0] = p.x; out[1] = p.y; out[2] = p.z; out[3] = ifx v[0].eg[k].seat[s].fresh then 2.0f32 else 1.0f32;   // 2: new
  v[0].eg[k].seat[s].fresh = false;
  out[4] = ifx o[4] > 0.5 then 0.0f32 else o[0]; out[5] = o[1]; out[6] = o[3];
}
// The people where the world has them (E5R_FOLK_FLOATS each, n of them), for the rules.
rm_eg_people :: (v: [] RmServer, k: int, folk: [] f32, n: int) #export_c #effects(all) { if rm_eg_live(v, k) { e5rr_people(v[0].eg[k].rules[..], folk, n); } }
// Person j in the rules now, for the world: HP TEMP BY (the seat that last harmed them, -1) COND
// (the conditions the rules hold them in: their holds in the world follow them).
rm_eg_folk_hp :: (v: [] RmServer, k: int, j: int, out: [] f32) -> bool #export_c #effects(all) {
  if !rm_eg_live(v, k) || j < 0 || j >= E5R_FOLK || out.count < 4 { return false; }
  o: [E5RR_OUT_FLOATS] f32;
  e5rr_folk_out(v[0].eg[k].rules[..], j, o[..]);
  out[0] = o[0]; out[1] = o[2]; out[2] = f32(v[0].eg[k].folk_by[j]); out[3] = o[3];
  return true;
}
// The crimes since the world last heard: q's BY X Z, while q < the count.
rm_eg_crimes :: (v: [] RmServer, k: int) -> int #export_c #effects(all) { return ifx rm_eg_live(v, k) then v[0].eg[k].crime_n else 0; }
rm_eg_crime :: (v: [] RmServer, k: int, q: int, out: [] f32) #export_c #effects(all) {
  if !rm_eg_live(v, k) || q < 0 || q >= v[0].eg[k].crime_n || out.count < 3 { return; }
  c := v[0].eg[k].crimes[q];
  out[0] = f32(c.by); out[1] = c.x; out[2] = c.z;
}
rm_eg_crimes_heard :: (v: [] RmServer, k: int) #export_c #effects(all) { if rm_eg_live(v, k) { v[0].eg[k].crime_n = 0; } }
// The doors and talks since the world last heard: q's KIND * 1000000 + SEAT * 1000 + ID + 1 (eg_use_code).
eg_use_code :: (kind: int, seat_id: SeatId, id: int) -> int { seat := seat_id.value; return kind * 1000000 + seat * 1000 + id + 1; }
rm_eg_use_asks :: (v: [] RmServer, k: int) -> int #export_c #effects(all) { return ifx rm_eg_live(v, k) then v[0].eg[k].use_ask_n else 0; }
rm_eg_use_ask :: (v: [] RmServer, k: int, q: int) -> int #export_c #effects(all) {
  if !rm_eg_live(v, k) || q < 0 || q >= v[0].eg[k].use_ask_n { return -1; }
  return v[0].eg[k].use_ask[q];
}
rm_eg_use_asks_heard :: (v: [] RmServer, k: int) #export_c #effects(all) { if rm_eg_live(v, k) { v[0].eg[k].use_ask_n = 0; } }
// The n-th rowboat as the world has it (room-world.c world_boat: x y z yaw rower oars float).
rm_eg_boat :: (v: [] RmServer, k: int, n: int, b: [] f32) #export_c #effects(all) {
  if !rm_eg_live(v, k) || n < 0 || n >= EG_BOATS || b.count < 7 { return; }
  rm := v[0].eg[k..<k + 1];
  rm[0].boat_on[n] = true; rm[0].boat_x[n] = b[0]; rm[0].boat_y[n] = b[1]; rm[0].boat_z[n] = b[2]; rm[0].boat_yaw[n] = b[3];
  rm[0].boat_by[n] = cast(int) b[4]; rm[0].boat_oar[n] = ifx b[5] < 0 then -1 else cast(int) (b[5] * 1000); rm[0].boat_i[n] = cast(int) b[6];
}
// The world's complete sparse record, or an empty span when the record was restored or released.
rm_eg_tree :: (v: [] RmServer, k: int, q: int, b: [] f32) #export_c #effects(all) {
  if !rm_eg_live(v, k) || q < 1 || q >= WIRE_TREES { return; }
  if b.count == 0 { v[0].eg[k].tree_on[q] = false; return; }
  if !forest_valid(b) { return; }
  if !v[0].eg[k].tree_on[q] || v[0].eg[k].tree[q].clip != cast(int) b[0] { wire_hist_born(v[0].eg[k].hist[..], EG_SLOT_TREE + q); }
  v[0].eg[k].tree[q] = WireS.{id = FOREST_EID + q, kind = WK_TREE, clip = cast(int) b[0], x = b[1], y = b[2], z = b[3], g = cast(int) b[4],
    p1 = cast(int) floor(b[5] * 1000 + 0.5), p2 = cast(int) floor(b[6] * 1000 + 0.5),
    t0 = cast(int) floor(b[7] * 1000 + 0.5), dur = cast(int) floor(b[8] * 1000 + 0.5),
    hp = cast(int) floor(b[9] * 1000 + 0.5), max = cast(int) floor(b[10] * 1000 + 0.5), temp = cast(int) floor(b[11] * 1000 + 0.5),
    cond = cast(int) b[12], owner = cast(int) b[13], carry = b[14], form = cast(int) floor(b[15] * 1000 + 0.5)};
  v[0].eg[k].tree_on[q] = true;
}
rm_eg_doors :: (v: [] RmServer, k: int, w: int, bits: int) #export_c #effects(all) { if rm_eg_live(v, k) && w >= 0 && w < WIRE_DOOR_WORDS { v[0].eg[k].doors[w] = bits; } }
rm_eg_gates :: (v: [] RmServer, k: int, shut: int) #export_c #effects(all) { if rm_eg_live(v, k) { v[0].eg[k].gates = ifx shut > 0 then shut else 0; } }   // its bits: shut, and the leaves burnt or alight (everglade-fire.coax fi_gates_bits)
// The strikes since the world last heard: q's BY SLOT FX FY FZ AX AY AZ SEED.
rm_eg_strikes :: (v: [] RmServer, k: int) -> int #export_c #effects(all) { return ifx rm_eg_live(v, k) then v[0].eg[k].strike_n else 0; }
rm_eg_strike :: (v: [] RmServer, k: int, q: int, out: [] f32) #export_c #effects(all) {
  if !rm_eg_live(v, k) || q < 0 || q >= v[0].eg[k].strike_n || out.count < 10 { return; }
  c := v[0].eg[k].strikes[q];
  out[0] = f32(c.by); out[1] = f32(c.slot); out[2] = c.fx; out[3] = c.fy; out[4] = c.fz; out[5] = c.ax; out[6] = c.ay; out[7] = c.az; out[8] = f32(c.seed);
  out[9]=f32(ifx c.source>=0 then c.source else ifx c.by>=0 then c.by else EFFECT_HOUSE);
}
rm_eg_strikes_heard :: (v: [] RmServer, k: int) #export_c #effects(all) { if rm_eg_live(v, k) { v[0].eg[k].strike_n = 0; } }
// Whether a rebuild was asked for since the world last heard.
rm_eg_rebuild :: (v: [] RmServer, k: int) -> bool #export_c #effects(all) {
  if !rm_eg_live(v, k) || !v[0].eg[k].rebuild { return false; }
  v[0].eg[k].rebuild = false;
  return true;
}
// Piece `piece` broke (KIND 1, thrown at A B C m/s) or caught or went out (KIND 2, A 1 alight) in the
// world, standing at (x, z): every page hears it, near or far, for every page's town is the same.
// KIND 3: a Repair stood structure `piece` up (everglade-repair.coax RP_*: a group, or a placed thing
// past CR_REPAIR_PLACED0), its pieces whole (rm_eg_piece_up, from the host first). KIND 4 and 5: placed thing
// `piece` caught or went out (A 1 alight), or burnt through and broke apart (everglade-placed-fire.coax).
rm_eg_piece :: (v: [] RmServer, k: int, kind: int, piece: int, a: f32, b: f32, c: f32, x: f32, z: f32) #export_c #effects(all) {
  if !rm_eg_live(v, k) || piece < 0 { return; }
  e: [96] u8; n := 0;
  if kind == 3 {
    q := piece - CR_REPAIR_PLACED0;
    if q >= 0 && q < CR_PLACED_MAX { v[0].eg[k].placed_burn[q] = false; v[0].eg[k].placed_gone[q] = false; }
    n = wire_int(e[..], wire_put(e[..], 0, "e mend"), piece);
    eg_event(v, k, cast(string) e[0..<n], x, z, true);
    return;
  }
  if kind == 4 || kind == 5 {
    if piece >= CR_PLACED_MAX { return; }
    if kind == 4 { v[0].eg[k].placed_burn[piece] = a > 0.5; } else { v[0].eg[k].placed_gone[piece] = true; v[0].eg[k].placed_burn[piece] = false; }
    n = eg_put_placed(e[..], kind, piece, a > 0.5);
    eg_event(v, k, cast(string) e[0..<n], x, z, true);
    return;
  }
  if piece >= EG_PIECES { return; }
  if kind == 1 {
    v[0].eg[k].broken[piece] = true; v[0].eg[k].burning[piece] = false;
    e5rd_wall_broke(v[0].eg[k].rules[..], x, z);   // a palisade post down opens a raid's breach (#12747)
    n = eg_put_break(e[..], piece, a, b, c);
  } else {
    v[0].eg[k].burning[piece] = a > 0.5;
    n = eg_put_burn(e[..], piece, a > 0.5);
  }
  eg_event(v, k, cast(string) e[0..<n], x, z, true);
}
// Piece i stands whole again (a Repair): late pages hear nothing of it.
rm_eg_piece_up :: (v: [] RmServer, k: int, i: int) #export_c #effects(all) {
  if !rm_eg_live(v, k) || i < 0 || i >= EG_PIECES { return; }
  v[0].eg[k].broken[i] = false; v[0].eg[k].burning[i] = false;
}
// The realm's placed things changed (the host laid a new world): what burnt of the old list is forgotten.
rm_eg_placed_reset :: (v: [] RmServer) #export_c #effects(all) {
  for k: 0..<EG_ROOMS { for q: 0..<CR_PLACED_MAX { v[0].eg[k].placed_burn[q] = false; v[0].eg[k].placed_gone[q] = false; } }
}
// e pburn I ON, or e pgone I: placed thing I alight or out, or burnt through.
eg_put_placed :: (e: [] u8, kind: int, i: int, on: bool) -> int {
  if kind == 5 { return wire_int(e, wire_put(e, 0, "e pgone"), i); }
  return wire_int(e, wire_int(e, wire_put(e, 0, "e pburn"), i), ifx on then 1 else 0);
}
eg_put_break :: (e: [] u8, piece: int, a: f32, b: f32, c: f32) -> int {
  n := wire_put(e, 0, "e break"); n = wire_int(e, n, piece); n = wire_m(e, n, a); n = wire_m(e, n, b); n = wire_m(e, n, c);
  return n;
}
eg_put_burn :: (e: [] u8, piece: int, on: bool) -> int {
  n := wire_put(e, 0, "e burn"); n = wire_int(e, n, piece); n = wire_int(e, n, ifx on then 1 else 0);
  return n;
}
// What all the watch's blows took from seat s this tick, and who dealt them
// (a watch actor, -1 none). The producer supplies a whole-tick aggregate once
// per seat; a repeated report replaces that snapshot, never adds a new hit.
rm_eg_hurt :: (v: [] RmServer, k: int, s_id: SeatId, amount: int, by: int) #export_c #effects(all) { s := s_id.value;
  if !rm_eg_seat_live(v, k, s_id) { return; }
  _ := hb_put(v[0].eg[k].hurts[..],s,amount,by);
}
// Person i as pages hear them (X Z YAW CLIP MODE HP SHOWN CASTING KIND FOE), and seat s's WANTED level.
// A new mode starts its clock (T0), a new spell its own.
rm_eg_folk :: (v: [] RmServer, k: int, i: int, at: [] f32) #export_c #effects(all) {
  if !rm_eg_live(v, k) || i < 0 || i >= E5R_FOLK || at.count < 7 { return; }
  // the first 7 floats (X Y Z YAW MODE CLIP OUTDOORS) are the person; the cast's three (SINCE KIND
  // FOE) may be missing: not casting
  full: [EG_FOLK_FLOATS] f32;
  full[7] = -1; full[9] = -1;
  for q: 0..<(ifx at.count < EG_FOLK_FLOATS then at.count else EG_FOLK_FLOATS) { full[q] = at[q]; }
  e := v[0].eg[k..<k + 1];
  fo := i * EG_FOLK_FLOATS;
  mode := cast(int) full[4];
  if mode != e[0].folk_mode[i] || e[0].folk_since[i] == 0 { e[0].folk_mode[i] = mode; e[0].folk_since[i] = ifx e[0].tick < 1 then 1 else e[0].tick; }
  was := e[0].folk[fo + 7];
  if full[7] >= 0 && (was < 0 || full[7] < was || e[0].folk_cast[i] == 0) {
    c := e[0].tick - cast(int) (full[7] * f32(EG_HZ));
    e[0].folk_cast[i] = ifx c < 1 then 1 else c;
  }
  for q: 0..<EG_FOLK_FLOATS { e[0].folk[fo + q] = full[q]; }
  e[0].folk_on = true;
}
// A watch spell that left its caster's hands (everglade-watch.coax everglade_room_missile, the floats
// KIND CASTER FOE AX AY AZ BX BY BZ FLIGHT LIFE): `e wm KIND CASTER FOE AX AY AZ BX BY BZ FLIGHT LIFE`
// (metres in cm, seconds in ms) to the pages near its caster, and to the seat it is for wherever it is.
rm_eg_missile :: (v: [] RmServer, k: int, m: [] f32) #export_c #effects(all) {
  if !rm_eg_live(v, k) || m.count < 11 { return; }
  b: [160] u8;
  n := wire_put(b[..], 0, "e wm");
  for q: 0..<3 { n = wire_int(b[..], n, cast(int) m[q]); }
  for q: 3..<9 { n = wire_m(b[..], n, m[q]); }
  n = wire_int(b[..], n, cast(int) (m[9] * 1000)); n = wire_int(b[..], n, cast(int) (m[10] * 1000));
  foe := cast(int) m[2];
  eg_event_who(v, k, cast(string) b[0..<n], m[3], m[5], false, ifx foe >= 0 && foe < EG_SEATS then 1 << foe else 0);
}
rm_eg_held :: (v: [] RmServer, k: int, s_id: SeatId, bits: int) #export_c #effects(all) { s := s_id.value; if rm_eg_seat_live(v, k, s_id) { v[0].eg[k].seat[s].wcond = bits; } }
// Seat s's watch effect by cause (WE_*): its seconds left, 0 none. A new one, or one cast again (more
// left than last tick's), starts now (T0) and lasts what is left (DUR, ticks).
rm_eg_held_left :: (v: [] RmServer, k: int, s_id: SeatId, cause: int, left: f32) #export_c #effects(all) { s := s_id.value;
  if !rm_eg_seat_live(v, k, s_id) || cause < 0 || cause >= WE_WATCH { return; }
  cd_clock_note(v[0].eg[k].seat[s].fx[cause..<cause + 1], left, v[0].eg[k].tick, WIRE_HZ);
}
// Whether seat s is to be held by a scripted Hold Person (room-control.coax "hold"), once: the host
// lays the watch's hold on it in the world (room-tick.c everglade_town, room-world.c world_hold).
rm_eg_hold_take :: (v: [] RmServer, k: int, s_id: SeatId) -> bool #export_c #effects(all) { s := s_id.value;
  if !rm_eg_seat_live(v, k, s_id) || !v[0].eg[k].seat[s].hold_due { return false; }
  v[0].eg[k].seat[s].hold_due = false;
  return true;
}
// Seat s moved in one jump this tick (room-world.c world_cut_take: placed, teleported, into or out of a
// boat): its next row is a WARP, so no page draws it between (#12835).
rm_eg_cut :: (v: [] RmServer, k: int, s_id: SeatId) #export_c #effects(all) { s := s_id.value; if rm_eg_seat_live(v, k, s_id) { v[0].eg[k].seat[s].cut = true; } }
// The rowboat seat s is to be put beside (room-control.coax "place", #12861), once: -1 none. The host
// puts it there in the world (room-tick.c everglade_town, room-world.c world_place_boat).
rm_eg_place_take :: (v: [] RmServer, k: int, s_id: SeatId) -> int #export_c #effects(all) { s := s_id.value;
  if !rm_eg_seat_live(v, k, s_id) || v[0].eg[k].seat[s].place_due <= 0 { return -1; }
  b := v[0].eg[k].seat[s].place_due - 1;
  v[0].eg[k].seat[s].place_due = 0;
  return b;
}
// Whether room k's dice are fixed (room-control.coax "dice fixed"): the host fixes its world's alike.
rm_eg_dice_fixed :: (v: [] RmServer, k: int) -> bool #export_c #effects(all) { return rm_eg_live(v, k) && v[0].eg[k].rules[0].b[0].dice[0].fixed; }
rm_eg_wanted :: (v: [] RmServer, k: int, s_id: SeatId, level: int) #export_c #effects(all) { s := s_id.value; if rm_eg_seat_live(v, k, s_id) { v[0].eg[k].wanted[s] = level; } }
// The WANTED level seat s comes back with (rv_join, #12794), once: the host lays it on the world's town
// when the town first steps the seat. 0 none.
rm_eg_want_take :: (v: [] RmServer, k: int, s_id: SeatId) -> int #export_c #effects(all) { s := s_id.value;
  if !rm_eg_seat_live(v, k, s_id) { return 0; }
  w := v[0].eg[k].seat[s].want_seed;
  v[0].eg[k].seat[s].want_seed = 0;
  return w;
}
