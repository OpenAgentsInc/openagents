// The previous wire's frames (#13398): the one codec for what a room writes a seat on WIRE_MIN in
// place of what WIRE_VERSION changed, and for what such a page says. The room's hooks are
// wire-prev.coax, which says the rule; the profile is proto/verse/everglade-wire-prev-v6.json, held to
// this file by
//   coax/web/tool.sh coax/web/room/wire-prev-profile.coax proto/verse/everglade-wire-prev-v6.json
// Wire 6 under wire 7 (#13276 made Everglade II's familiars rows, their requests and the Healer's
// Kit's E kinds, and the room's answers e entries of D: familiar-wire.coax). A wire 6 page reads and
// writes these frames instead:
//   M1 SEQ FORM SLOT, M3 SEQ FORM SLOT SPIRIT, M4 SEQ ORDER, M5 SEQ, M6 SEQ SEAT, M7 SEQ   its requests
//   U1 SEQ                                       the Healer's Kit's ask (kit-wire.coax)
//   m1 SEQ FORM, m4 SEQ ORDER, m5 SEQ, m6 SEQ, m7 SEQ   this wire's e fam entry, by its order
//   m3 SEQ STATUS                                this wire's e fam-cast entry
//   u1 SEQ LEFT                                  this wire's e kit entry (kit-wire.coax)
//   m2 TICK COUNT [OWNER FORM X Z HP MAX]...     the familiars the seat may see, whole each time (X Z mm)
//   m8 MODE                                      whose senses the seat has: this wire's familiar row's G
// The frames' own profiles are proto/verse/everglade-familiar*-v1.json, everglade-find-familiar-v1.json
// and everglade-healers-kit-v1.json (coax/web/room/familiar-profile.coax runs these functions on them).
// A reader takes a frame whole or not at all (ok false): a field missing, extra or out of range.
//   coax/bin/coax test everglade/server/wire-prev-wire.coax
#load "familiar-wire.coax";
#load "kit-wire.coax";

WPREV_SERVES :: 6;   // the wire version these writers speak
WPREV_UNDER :: 7;    // the WIRE_VERSION they were written under: a room of any other version fails its checks

// What the old wire's writers keep for a seat: the familiars' list and the senses' mode it last heard.
WprevSeat :: struct { familiar_hash: int; familiar_sent: int; sense_sent: int; }

// ---- the wire 6 familiar frames: one reader, and the writers
// A request's order: 0 a summons (M1, or the Wizard's M3), 1 to 3 the lifecycle's (M4), then step (M5),
// cure (M6) and senses (M7). spirit is given for M1, which names none (the rules' fey).
WPREV_FEY :: 1;
e2_familiar_read :: (text:string)->E2FamiliarAsk {
  wizard:=wire_is(text,"M3");
  step:=wire_is(text,"M5");
  touch:=wire_is(text,"M6");
  sense:=wire_is(text,"M7");
  lifecycle:=wire_is(text,"M4") || step || touch || sense;
  if !wizard && !lifecycle && !wire_is(text,"M1") { return E2FamiliarAsk.{}; }
  rd:=[1]WireRd.[wire_rd(text,2)];
  seq:=wire_num(text,rd[..]); choice:=ifx sense then E2_FAMILIAR_SENSES else ifx step then E2_FAMILIAR_STEP else wire_num(text,rd[..]);
  slot:=ifx lifecycle then 0 else wire_num(text,rd[..]);
  spirit:=ifx wizard then wire_num(text,rd[..]) else WPREV_FEY;
  ok:=rd[0].ok && !wire_more(text,rd[..]) && seq>0;
  return E2FamiliarAsk.{ok=ok,wizard=wizard,lifecycle=lifecycle,touch=touch,step=step,sense=sense,seq=seq,choice=choice,slot=slot,spirit=spirit};
}
// The success reply to request seq of order: m1 SEQ FORM, m4 SEQ ORDER, m5 SEQ, m6 SEQ or m7 SEQ.
e2_familiar_put_done :: (out:[]u8,order:int,seq:int,form:int)->int {
  kind:=ifx order==E2_FAMILIAR_SENSES then "m7" else ifx order==E2_FAMILIAR_CURE then "m6" else ifx order==E2_FAMILIAR_STEP then "m5" else ifx order>0 then "m4" else "m1";
  n:=wire_int(out,wire_put(out,0,kind),seq);
  if order<E2_FAMILIAR_STEP { n=wire_int(out,n,ifx order>0 then order else form); }
  return n;
}
// m3 SEQ STATUS, m8 MODE.
e2_familiar_put_status :: (out:[]u8,seq:int,status:int)->int { return wire_int(out,wire_int(out,wire_put(out,0,"m3"),seq),status); }
e2_familiar_put_sense :: (out:[]u8,mode:int)->int { return wire_int(out,wire_put(out,0,"m8"),mode); }
// m2 TICK COUNT [OWNER FORM X Z HP MAX]...: one row appended at at, then the frame round count rows.
e2_familiar_put_row :: (rows:[]u8,at:int,owner:int,form:int,x:int,z:int,hp:int,hp_max:int)->int {
  size:=wire_int(rows,wire_int(rows,wire_int(rows,at,owner),form),x);
  return wire_int(rows,wire_int(rows,wire_int(rows,size,z),hp),hp_max);
}
e2_familiar_put_rows :: (out:[]u8,tick:int,count:int,rows:string)->int {
  return wire_put(out,wire_int(out,wire_int(out,wire_put(out,0,"m2"),tick),count),rows);
}


// ---- between the wires
// A D entry of this wire as the old wire's frame: its length in out, 0 when the old wire said it as
// the same entry (or the entry is malformed: it stays as it is).
wprev_entry_put :: (out: [] u8, entry: string) -> int {
  d := egf_done_read(entry);
  if d.ok { return e2_familiar_put_done(out, d.order, d.seq, d.form); }
  c := egf_cast_read(entry);
  if c.ok { return e2_familiar_put_status(out, c.seq, c.status); }
  k := egf_kit_used(entry);
  if k.ok { return egk_used_put(out, k.seq, k.left); }
  return 0;
}
// A frame the old page says as the E (use) it is on this wire: kind 0 when it is none of them, or malformed.
wprev_use_read :: (text: string) -> WireUse {
  a := e2_familiar_read(text);
  if a.ok { return egf_use_of(a); }
  seq := egk_ask_read(text);
  if seq > 0 { return egf_kit_use(seq); }
  return WireUse.{};
}

wpw_said :: (b: [] u8, entry: string) -> string { return cast(string) b[0..<wprev_entry_put(b, entry)]; }
#test "previous wire: each answer of this wire is the old frame, and each old request the use it is on this wire" {
  b: [64] u8;
  #assert wpw_said(b[..], "e fam 4000001 0 8") == "m1 4000001 8" && wpw_said(b[..], "e fam 9 2 0") == "m4 9 2" && wpw_said(b[..], "e fam 10 4 0") == "m5 10";
  #assert wpw_said(b[..], "e fam 11 5 0") == "m6 11" && wpw_said(b[..], "e fam 12 6 0") == "m7 12" && wpw_said(b[..], "e fam-cast 7 2") == "m3 7 2" && wpw_said(b[..], "e kit 3000001 9") == "u1 3000001 9";
  for same: [7] string.["e hit 1001 2003 7 3", "e mon 90 2 3 -1 4", "e fam 3 7 0", "e fam-cast 1 4", "e kit 7 10", "e family 1", "s 1 0 7 1"] { #assert wprev_entry_put(b[..], same) == 0; }
  u := wprev_use_read("M1 4000001 8 2"); #assert u.seq == 4000001 && u.kind == WE_FAM_SUMMON && u.id == 208;
  u = wprev_use_read("M3 7 8 1 3"); #assert u.kind == WE_FAM_RITE && u.id == 30108 && u.seq == 7;
  u = wprev_use_read("M4 9 2"); #assert u.kind == WE_FAM_ORDER && u.id == 2;
  u = wprev_use_read("M5 10"); #assert u.kind == WE_FAM_STEP && u.id == 0 && u.seq == 10;
  u = wprev_use_read("M6 11 15"); #assert u.kind == WE_FAM_CURE && u.id == 15;
  u = wprev_use_read("M7 12"); #assert u.kind == WE_FAM_SENSES && u.id == 0;
  u = wprev_use_read("U1 3000001"); #assert u.kind == WE_KIT && u.seq == 3000001 && u.id == 0;
  for bad: [8] string.["M1", "M1 0 8 0", "M4 9", "M5 10 1", "M2 1 1", "U1 0", "U1 1 2", "E 1 9 8"] { #assert wprev_use_read(bad).kind == 0; }
  // the old request read, written as this wire's use and read by this wire's reader, is the same ask
  a := e2_familiar_read("M3 7 8 1 3"); r := egf_use_read(wprev_use_read("M3 7 8 1 3"), WPREV_FEY);
  #assert a.ok && r.ok && a.wizard == r.wizard && a.seq == r.seq && a.choice == r.choice && a.slot == r.slot && a.spirit == r.spirit && a.lifecycle == r.lifecycle;
  #assert WPREV_FEY == 1;
}
