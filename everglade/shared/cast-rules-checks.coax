#load "cast-rules.coax";

#test "Everglade II shared casting heals and retains real class resources and spent Reactions" {
  b:[1] RsBattle; b[0].w=16; b[0].h=16; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_FIGHTER,"Fighter",0,1),4,4);
  seats:[1] FbSeat; seats[0].me=0; b[0].c[0].hp=1; b[0].c[0].reacted=true;
  #assert e2r_use(b[..],seats[..],FB_CL_FIGHTER,xk_slot(FB_CL_FIGHTER,0));
  #assert b[0].c[0].hp>1 && b[0].c[0].reacted && seats[0].turn.bonus;
}

#test "Everglade II shared casting refuses speech incapacity and foreign slots without refilling budgets" {
  b:[1] RsBattle; b[0].w=16; b[0].h=16; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_WIZARD,"Wizard",0,1),4,4);
  seats:[1] FbSeat; seats[0].me=0; seats[0].turn.action=true;
  b[0].c[0].slots[1]=0; b[0].c[0].speech_blocked=true;
  #assert !e2r_use(b[..],seats[..],FB_CL_WIZARD,xk_slot(FB_CL_WIZARD,0));
  #assert b[0].c[0].slots[1]==0 && seats[0].turn.action && !seats[0].open;
  b[0].c[0].speech_blocked=false; b[0].c[0].hp=0;
  #assert !e2r_use(b[..],seats[..],FB_CL_WIZARD,xk_slot(FB_CL_WIZARD,0));
  b[0].c[0].hp=1;
  #assert !e2r_use(b[..],seats[..],FB_CL_WIZARD,xk_slot(FB_CL_FIGHTER,0));
  #assert !e2r_use(b[..],seats[..],-1,0);
  seats[0].me=-1; #assert !e2r_use(b[..],seats[..],FB_CL_WIZARD,xk_slot(FB_CL_WIZARD,0));
}

#test "Everglade II offensive casts pay shared costs but do not affect another creature" {
  b:[1] RsBattle; b[0].w=16; b[0].h=16; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_BARD,"Bard",0,1),4,4);
  _=rs_add(b[..],rs_guard("Bystander",1),5,4);
  seats:[1] FbSeat; seats[0].me=0;
  #assert e2r_use(b[..],seats[..],FB_CL_BARD,xk_slot(FB_CL_BARD,2));
  #assert b[0].c[0].slots[1]==b[0].c[0].slots_max[1]-1 && seats[0].turn.action;
  #assert b[0].c[1].hp==b[0].c[1].hp_max && b[0].c[0].hp==b[0].c[0].hp_max;
  #assert b[0].who==0 && !b[0].turn.action;
}

#test "Everglade II empty attacks spend one Action while saving another actor and movement history" {
  b:[1] RsBattle; b[0].w=12; b[0].h=12; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_FIGHTER,"Fighter",0,1),3,3);
  _=rs_add(b[..],rs_guard("Other",1),4,3);
  b[0].who=1; b[0].turn.bonus=true;
  seats:[1] FbSeat; seats[0].me=0; seats[0].turn.action=true;
  seats[0].turn.move_left=3; seats[0].turn.move_debt=2; seats[0].turn.quickened=true;
  #assert e2r_use(b[..],seats[..],FB_CL_FIGHTER,xk_slot(FB_CL_FIGHTER,1));
  #assert seats[0].open && seats[0].turn.action && seats[0].turn.move_left==3;
  #assert seats[0].turn.move_debt==2 && seats[0].turn.quickened;
  #assert b[0].who==1 && b[0].turn.bonus && !b[0].turn.action;
  #assert b[0].c[1].hp==b[0].c[1].hp_max;
  seats[0].me=b[0].n;
  #assert !e2r_use(b[..],seats[..],FB_CL_FIGHTER,xk_slot(FB_CL_FIGHTER,1));
}

#test "Everglade II shared spells include real self healing and cantrips with zero slot cost" {
  b:[1] RsBattle; b[0].w=12; b[0].h=12; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_BARD,"Bard",0,1),3,3);
  seats:[1] FbSeat; seats[0].me=0; b[0].c[0].hp=1;
  #assert e2r_use(b[..],seats[..],FB_CL_BARD,xk_slot(FB_CL_BARD,1));
  #assert b[0].c[0].hp>1 && seats[0].turn.bonus && seats[0].open;
  slots:=b[0].c[0].slots_max[1];
  #assert e2r_use(b[..],seats[..],FB_CL_BARD,xk_slot(FB_CL_BARD,0));
  #assert b[0].c[0].slots[1]==slots && seats[0].turn.action && !seats[0].turn.slot_spent;
}

#test "Everglade II dispatch refuses unknown features and a second empty swing without a profile refill" {
  b:[1] RsBattle; b[0].w=12; b[0].h=12; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_FIGHTER,"Fighter",0,1),3,3); rs_start_turn(b[..],0);
  #assert !e2r_dispatch(b[..],0,FbAb.{kind=-1});
  a:=fb_feature(FB_ATTACK,"Attack","attack");
  #assert e2r_dispatch(b[..],0,a) && b[0].turn.action;
  #assert !e2r_dispatch(b[..],0,a);
}

#test "Everglade II refuses an unregistered live backing record and uses the first available legal slot" {
  b:[1] RsBattle; b[0].w=12; b[0].h=12; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_BARD,"Bard",0,3),3,3);
  // The backing span is larger than logical n. A live unused record is not
  // an admitted actor, regardless of what remains in reusable storage.
  b[0].c[1]=fb_cl_hero(FB_CL_FIGHTER,"Unused",0,1);
  seats:[1] FbSeat; seats[0].me=b[0].n;
  #assert !e2r_use(b[..],seats[..],FB_CL_FIGHTER,xk_slot(FB_CL_FIGHTER,0));
  seats[0].me=0; b[0].c[0].slots_max[1]=0;
  #assert e2r_use(b[..],seats[..],FB_CL_BARD,xk_slot(FB_CL_BARD,2));
  #assert b[0].c[0].slots[1]==0 && b[0].c[0].slots[2]==b[0].c[0].slots_max[2]-1;
}

#test "Everglade II takes a slot only from the seat's own level's bar" #steps 2000000000 {
  bar:[XC_SLOTS] FbAb; n:=xk_bar_at(FB_CL_FIGHTER,2,bar[..]); surge:=-1;
  for i:0..<n { if bar[i].kind==FB_SURGE { surge=xk_wire(FB_CL_FIGHTER,bar[i]); } }
  b:[1] RsBattle; b[0].w=12; b[0].h=12; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_FIGHTER,"Fighter",0,1),3,3);
  seats:[1] FbSeat; seats[0].me=0;
  #assert surge>=0 && !e2r_use(b[..],seats[..],FB_CL_FIGHTER,surge) && !seats[0].open;
  b[0].c[0]=fb_cl_hero(FB_CL_FIGHTER,"Fighter",0,2); b[0].c[0].x=3; b[0].c[0].y=3;
  left:=b[0].c[0].uses[RS_USE_SURGE];
  #assert left>0 && e2r_use(b[..],seats[..],FB_CL_FIGHTER,surge) && b[0].c[0].uses[RS_USE_SURGE]==left-1;
}

#test "Everglade II's level 2 to 6 features that pick no creature go through the shared rules" #steps 2000000000 {
  // Action Surge gives the Action back; a Monk's Flurry at the air spends Focus and the Bonus Action
  b:[1] RsBattle; b[0].w=12; b[0].h=12; _w:=rs_set_world(b[..],RS_EVERGLADE_WORLD);
  _:=rs_add(b[..],fb_cl_hero(FB_CL_FIGHTER,"Fighter",0,2),3,3); rs_start_turn(b[..],0);
  #assert e2r_dispatch(b[..],0,fb_feature(FB_ATTACK,"Attack","attack")) && b[0].turn.action;
  surge:=b[0].c[0].uses[RS_USE_SURGE];
  #assert e2r_dispatch(b[..],0,fb_feature(FB_SURGE,"ACTION SURGE","action-surge")) && b[0].c[0].uses[RS_USE_SURGE]==surge-1 && !b[0].turn.action;
  // with the Action free, the Surge's is that one; with no use left, refused and nothing spent
  b[0].c[0].uses[RS_USE_SURGE]=1;
  #assert e2r_dispatch(b[..],0,fb_feature(FB_SURGE,"ACTION SURGE","action-surge")) && !b[0].turn.action && b[0].c[0].uses[RS_USE_SURGE]==0;
  b[0].c[0].uses[RS_USE_SURGE]=0; #assert !e2r_dispatch(b[..],0,fb_feature(FB_SURGE,"ACTION SURGE","action-surge")) && !b[0].turn.action;
  m:[1] RsBattle; m[0].w=12; m[0].h=12;
  _=rs_add(m[..],fb_cl_hero(FB_CL_MONK,"Monk",0,3),3,3); rs_start_turn(m[..],0);
  f:=m[0].c[0].focus; #assert f>0;
  #assert e2r_dispatch(m[..],0,fb_feature(FB_FLURRY,"FLURRY OF BLOWS","flurry-of-blows")) && m[0].c[0].focus==f-1 && m[0].turn.bonus;
  #assert !e2r_dispatch(m[..],0,fb_feature(FB_FLURRY,"FLURRY OF BLOWS","flurry-of-blows")) && m[0].c[0].focus==f-1;
  m[0].turn.bonus=false; m[0].c[0].focus=1;
  #assert e2r_dispatch(m[..],0,fb_feature(FB_FLURRY,"FLURRY OF BLOWS","flurry-of-blows")) && m[0].c[0].focus==0;
  m[0].turn.bonus=false;
  #assert !e2r_dispatch(m[..],0,fb_feature(FB_FLURRY,"FLURRY OF BLOWS","flurry-of-blows")) && !m[0].turn.bonus;
  m[0].c[0].focus=1; m[0].c[0].hp=0;
  #assert !e2r_dispatch(m[..],0,fb_feature(FB_FLURRY,"FLURRY OF BLOWS","flurry-of-blows")) && m[0].c[0].focus==1;
  // a Reckless Attack swings at the air as an Attack does; Bardic Inspiration needs someone else
  r:[1] RsBattle; r[0].w=12; r[0].h=12;
  _=rs_add(r[..],fb_cl_hero(FB_CL_BARBARIAN,"Barbarian",0,2),3,3); rs_start_turn(r[..],0);
  #assert e2r_dispatch(r[..],0,fb_feature(FB_RECKLESS,"RECKLESS ATTACK","reckless-attack")) && r[0].turn.action;
  #assert !e2r_dispatch(r[..],0,fb_feature(FB_RECKLESS,"RECKLESS ATTACK","reckless-attack"));
  #assert !e2r_dispatch(r[..],0,fb_feature(FB_INSPIRE,"BARDIC INSPIRATION","bardic-inspiration"));
  // Land's Aid round a level 3 Druid harms no player (one team) and heals the Druid
  d:[1] RsBattle; d[0].w=12; d[0].h=12; d[0].dice[0].fixed=true;
  _=rs_add(d[..],fb_cl_hero(FB_CL_DRUID,"Druid",0,3),3,3); _=rs_add(d[..],fb_cl_hero(FB_CL_FIGHTER,"Other",0,1),4,3); rs_start_turn(d[..],0);
  d[0].c[0].hp=2; other:=d[0].c[1].hp; wild:=d[0].c[0].uses[RS_USE_WILD];
  #assert d[0].c[0].lands_aid && e2r_dispatch(d[..],0,fb_feature(FB_LANDS,"LAND'S AID","lands-aid"));
  #assert d[0].c[0].hp>2 && d[0].c[1].hp==other && d[0].c[0].uses[RS_USE_WILD]==wild-1;
}

#test "Everglade II's features round the caster, never round another seat, and the Surge's Action is the Surge's" #steps 2000000000 {
  // a Druid seated second, another player far off first: Land's Aid comes round the Druid
  d:[1] RsBattle; d[0].w=16; d[0].h=16; d[0].dice[0].fixed=true;
  _:=rs_add(d[..],fb_cl_hero(FB_CL_FIGHTER,"Other",0,1),14,14); _=rs_add(d[..],fb_cl_hero(FB_CL_DRUID,"Druid",0,3),2,2); rs_start_turn(d[..],1);
  d[0].c[1].hp=2;
  #assert e2r_dispatch(d[..],1,fb_feature(FB_LANDS,"LAND'S AID","lands-aid")) && d[0].c[1].hp>2;
  // a Cleric that somehow holds an Action Surge use: Turn Undead still has its own Action
  c:[1] RsBattle; c[0].w=12; c[0].h=12;
  _=rs_add(c[..],fb_cl_hero(FB_CL_CLERIC,"Cleric",0,2),3,3); rs_start_turn(c[..],0); c[0].c[0].uses[RS_USE_SURGE]=1;
  #assert e2r_dispatch(c[..],0,fb_feature(FB_TURN,"TURN UNDEAD","turn-undead")) && c[0].turn.action;
}

#test "Everglade II's self spells are cast on the caster, and Produce Flame comes to hand first" #steps 2000000000 {
  w:[1] RsBattle; w[0].w=12; w[0].h=12;
  _:=rs_add(w[..],fb_cl_hero(FB_CL_WIZARD,"Wizard",0,1),3,3); rs_start_turn(w[..],0);
  #assert w[0].c[0].temp==0 && e2r_dispatch(w[..],0,fb_spell(SP_FALSE_LIFE,1,FB_SELF)) && w[0].c[0].temp>0;
  flame:=fb_spell(SP_FLAME_HURL,0,FB_FOE); flame.conjure=true;
  d:[1] RsBattle; d[0].w=12; d[0].h=12;
  _=rs_add(d[..],fb_cl_hero(FB_CL_DRUID,"Druid",0,1),3,3); rs_start_turn(d[..],0);
  #assert e2r_dispatch(d[..],0,flame) && d[0].c[0].flame_until>d[0].clock && d[0].turn.bonus && d[0].turn.action;
  // with the Bonus Action spent and no flame in hand, refused
  e:[1] RsBattle; e[0].w=12; e[0].h=12;
  _=rs_add(e[..],fb_cl_hero(FB_CL_DRUID,"Druid",0,1),3,3); rs_start_turn(e[..],0); e[0].turn.bonus=true;
  #assert !e2r_dispatch(e[..],0,flame) && !e[0].turn.action;
}
