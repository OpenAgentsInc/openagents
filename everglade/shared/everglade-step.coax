// Everglade's movement step, the controller's half: its own unit with the controller (the
// controller's names stay out of the page's unit). The page's face and the room server both call
// the step in this order, every step, on the same input, so both put you in the same place:
//   w := everglade_move_world(...)          the world where you stand   (everglade-move.coax)
//   p  = eg_step_begin(p, input, w, dt)     the throw, your input, the ice and the pace, low gravity
//   b0 := eg_step_body(p)
//   p  = eg_step_advance(p, w, bodies, walls, floors, frame)   the rowboat's seat, or the controller's advance
//   b  := everglade_move_after(s, w, b0, eg_step_body(p), dt)   lifts, currents, the city's edge, the clip's speed
//   p  = eg_step_put(p, b)
// docs/verse/2026-11-03-everglade-multiplayer-spec.md section 3.1 (the shared movement module), #12706.
// The unit carries metaverse-engine/move/player.coax's C surface too (the faces' verse_player_*), in place of
// player.coax's own unit, so the controller is in one unit.
#module "everglade.step";
#load "../../metaverse-engine/move/player.coax";
#load "../../metaverse-engine/move/walk.coax" as walk;
#load "../../metaverse-engine/physics/collide.coax" as scaled_collision;
#load "../../metaverse-engine/physics/query.coax" as hull_query;
#load "everglade-move-types.coax";
#load "../../metaverse-engine/action/sprint.coax" as sprint;   // the engine's sprint, for the Dash checks
#load "../../metaverse-engine/core/math.coax" as link_math;
#load "../../metaverse-engine/physics/collision-profiles.coax" as link_collision;
#load "../../verse/ocarina/locomotion.coax" as link_motion;

eg_step_body :: (p: walk.Body) -> EgBody #export_c #effects(reads, writes, traps) {
  return EgBody.{x = p.pos.x, y = p.pos.y, z = p.pos.z, px = p.prev_pos.x, py = p.prev_pos.y, pz = p.prev_pos.z,
                 vx = p.vel.x, vy = p.vel.y, vz = p.vel.z, ground = p.on_ground, air = p.act == walk.Act.airborne,
                 show_vx = p.vel.x, show_vz = p.vel.z};
}
eg_step_put :: (p0: walk.Body, b: EgBody) -> walk.Body #export_c #effects(reads, writes, traps) {
  p := p0;
  p.pos = walk.Vec3.{x = b.x, y = b.y, z = b.z}; p.prev_pos = walk.Vec3.{x = b.px, y = b.py, z = b.pz};
  p.vel = walk.Vec3.{x = b.vx, y = b.vy, z = b.vz}; p.on_ground = b.ground;
  if b.air { p.act = walk.Act.airborne; }
  return p;
}
// The complete profile travels with each input and its replay, not an unreplicated local impulse.
eg_step_world :: (w0:EgMoveWorld,input:EgMoveIn)->EgMoveWorld #export_c #effects(all) {
 w:=w0;w.link_flags=input.link_flags;w.link_yaw=input.theta;
 if w.busy || w.still {w.link_flags&=288;}if w.aboard {w.link_flags=0;}return w;
}
// book:begin shared-step
// Before the advance: a blast's throw into your velocity; held or busy, no input of yours; your input;
// prone or caught, still; the pace and grip; the camera's yaw; a fork's low gravity while you're up.
eg_step_begin :: (p0: walk.Body, input: EgMoveIn, w: EgMoveWorld, dt: f32) -> walk.Body #export_c #effects(reads, writes, traps) {
  p := p0;
  if w.kx != 0 || w.ky != 0 || w.kz != 0 {
    p.vel.x += w.kx; p.vel.z += w.kz;
    if w.ky > 0 { p.vel.y = ifx w.ky > p.vel.y then w.ky else p.vel.y; p.on_ground = false; }
  }
  if w.busy || w.still { p = walk.body_input(p, 0, 0, 0, 0, false, false, p.yaw); }
  else { p = walk.body_input(p, input.key_x, input.key_y, input.pad_x, input.pad_y, input.run, input.jump && w.jump_ok, p.yaw); }
  if (w.link_flags & 512) != 0 && !w.busy && !w.still { p.key_x = 0; p.key_y = 1; p.pad_x = 0; p.pad_y = 0; p.run = true; }
  p.pace = w.pace; p.grip = w.grip;
  p.yaw = input.theta;   // the view's yaw from the wire: the step's input
  if (w.link_flags&32)!=0 {p.pace*=link_motion.ocl_input_pace(p.key_x,p.key_y,p.pad_x,p.pad_y);}
  if (w.link_flags&128)!=0 {
    p.face=input.theta;
    if p.on_ground && p.jumps.waiting>0 {p.vel.x= -link_math.math_sin(input.theta)*link_motion.OCL_FLIP_SPEED;p.vel.z= -link_math.math_cos(input.theta)*link_motion.OCL_FLIP_SPEED;p.vel.y=link_motion.ocl_launch(link_motion.OCL_FLIP_HEIGHT,16*link_motion.OCL_FLIP_GRAVITY);p.on_ground=false;p.jumps.waiting=0;}
    else if p.on_ground {p.key_x=0;p.key_y=0;}
  }
  if !p.on_ground { p.vel.y += w.low_grav * dt; }
  return p;
}
// book:end shared-step
// The advance: in a rowboat you sit where it seats you; else the controller among the world's bodies
// (the city's and the rowboats' hulls), walls and floors. Over the fountain's lip only its column
// stands in your way, so you stand on the lip.
eg_step_advance :: (p0: walk.Body, w: EgMoveWorld, bodies: [] f32, walls: [] f32, floors: [] f32, frame: f32) -> walk.Body #export_c #effects(reads, writes, traps) {
  return eg_step_advance_among(p0, w, bodies, walls, floors, floors[0..<0], frame);
}
// The same among hulls too (metaverse-engine/physics/query.coax): Everglade II's rocks, each its mesh's own shape.
eg_step_advance_among :: (p0: walk.Body, w: EgMoveWorld, bodies: [] f32, walls: [] f32, floors: [] f32, hulls: [] f32, frame: f32) -> walk.Body #export_c #effects(reads, writes, traps) {
  p := p0;
  if w.aboard {
    p.pos.x = w.seat_x; p.pos.z = w.seat_z; p.prev_pos = p.pos;
    p.vel.x = 0; p.vel.z = 0;
    p.face = w.seat_yaw; p.prev_face = w.seat_yaw;
    return p;
  }
  if !w.deck && bodies.count >= 7 && p.pos.y > 0.6 { bodies[4] = 1.9; bodies[6] = 0.62; }
  if (w.link_flags&32)!=0 {
    profile:=link_collision.collision_profile_lookup("ocarina-lab");
    world:=walk.World.{bodies=bodies,walls=walls,floors=floors,hulls=hulls,collision=profile.profile,locomotion=link_motion.ocl_locomotion(link_motion.OCL_WALK_SPEED,link_motion.OCL_RUN_SPEED,(w.link_flags&128)!=0,(w.link_flags&256)!=0,(w.link_flags&64)!=0)};
    p=walk.body_advance_in(world,p,frame);
    if (w.link_flags&128)!=0 {p.face=w.link_yaw;if p.on_ground {p.vel.x=0;p.vel.z=0;}}
    if (w.link_flags&64)!=0 {p.face=w.link_yaw-walk.PI;}
    return p;
  }
  if (w.link_flags & 512) != 0 {
    profile := link_collision.collision_profile_lookup("everglade");
    world := walk.World.{bodies = bodies, walls = walls, floors = floors, hulls = hulls, collision = profile.profile};
    // Stay within the realm's admitted maximum travel per fixed collision step.
    world.locomotion.run_speed = 9.2;
    return walk.body_advance_in(world, p, frame);
  }
  return walk.body_advance_among_hulls(p, frame, bodies, walls, floors, hulls, "everglade");
}
// The wire's CARRY (seconds, a tenth of a millisecond: the server's leftover cut down to its tenth) as
// the controller's leftover, nanoseconds. The room's 1/30 s step leaves the 1/64 s controller one of
// fifteen leftovers, a fifteenth of its step apart, each a few ns over its fifteenth (the step is
// 33333335 ns); one, 13541690 ns, is 25 ns over what makes the next step run three of the controller's
// steps, not two. Cut to 13.5 ms it ran two: the page's re-run fell a controller step (12 cm at a run)
// short of the server every half second, and the server's next word pulled you on. So the cut leftover
// is put back on the nearest fifteenth (rounded up, under the true one by the few ns), when it is near
// one; else taken as it came.
EG_ROOM_CARRY_GRID :: 15;
eg_step_carry_ns :: (carry: f32) -> int #export_c #effects(reads, writes, traps) {
  if !(carry == carry) { return 0; }
  ns := cast(int) floor(f64(carry) * 1.0e9 + 0.5);
  g := f64(LOOP_STEP_NS) / f64(EG_ROOM_CARRY_GRID);
  mid := f64(ns) + 50000.0;   // the middle of the tenth it was cut to
  j := floor(mid / g + 0.5);
  on := ifx j < 0.5 then 0 else cast(int) floor(j * g) + 1;
  if abs(f64(on) - mid) <= 60000.0 { ns = on; }
  return ifx ns < 0 then 0 else ifx ns >= LOOP_STEP_NS then LOOP_STEP_NS - 1 else ns;
}
// The controller's leftover step time, seconds (the wire's CARRY).
eg_step_carry :: (p: walk.Body) -> f32 #export_c #effects(reads, writes, traps) { return f32(p.clock.carry_ns) / 1.0e9; }
// You as the room server has you after an input (the wire's p entry for your seat): the start the
// page re-runs its later inputs from. jump: that input's jump, held or not, as the server's controller
// last saw it, with no press waiting: a re-run of the press after it jumps as the server did. (The
// page's own jump, still held from a later input, would make the re-run's press no rise, so the re-run
// would drop you back to the ground and the server's next word would throw you up again.) The act
// follows the ground: on it you stand until the re-run's step says how you move.
eg_step_set :: (p0: walk.Body, x: f32, y: f32, z: f32, yaw: f32, vx: f32, vy: f32, vz: f32, ground: bool, carry: f32, jump: bool) -> walk.Body #export_c #effects(reads, writes, traps) {
  p := p0;
  // where the last fixed step began moves with you, so the feet drawn between the two (walk_feet, by the
  // leftover) stay where they were when the server agrees; set on you, a word on the input the page
  // just stepped (nothing to re-run) moved the drawn feet by up to a controller step (12 cm at a run)
  p.prev_pos = walk.Vec3.{x = p0.prev_pos.x + x - p0.pos.x, y = p0.prev_pos.y + y - p0.pos.y, z = p0.prev_pos.z + z - p0.pos.z};
  p.pos = walk.Vec3.{x = x, y = y, z = z};
  p.vel = walk.Vec3.{x = vx, y = vy, z = vz}; p.on_ground = ground;
  p.face = yaw; p.prev_face = yaw;
  p.jumps.held = jump; p.jumps.waiting = 0; p.jump_held = jump;
  if !ground { p.act = walk.Act.airborne; }
  else if p.act == walk.Act.airborne { p.act = walk.Act.idle; }
  p.clock.carry_ns = eg_step_carry_ns(carry);
  return p;
}

// Where you are drawn in a room this frame: `from` the feet where the last room step left you
// (eg_step_feet) and p the next step as this frame's input will make it, `ahead` (0 to 1) of that
// step's time gone. Drawing toward the next step, not between the last two, puts a key on screen the
// next frame rather than up to a step later (#13167); only the sent steps move you. Each end is the controller's feet (eg_step_feet), not its raw position: the 1/64 s
// controller runs two or three of its steps in each 1/30 s room step, so its raw position moves 31 or
// 47 ms a step and a draw between those stutters (every few steps the body runs on and jumps back);
// its feet, between its last two steps by its leftover time, move 33 ms each step.
eg_step_feet :: (p: walk.Body) -> walk.Vec3 #export_c #effects(reads, writes, traps) { return walk.body_feet(p); }
eg_step_drawn :: (from: walk.Vec3, p: walk.Body, ahead: f32) -> walk.Vec3 #export_c #effects(reads, writes, traps) {
  a := ifx ahead > 0 then (ifx ahead < 1 then ahead else 1.0f32) else 0.0f32;
  to := walk.body_feet(p);
  return walk.Vec3.{x = from.x + (to.x - from.x) * a, y = from.y + (to.y - from.y) * a, z = from.z + (to.z - from.z) * a};
}

// ---- tests: the room step as the page and the server run it (1/30 s, the wire's rate)
//   coax/bin/coax test everglade/shared/everglade-step.coax --only "step:"

EG_TEST_STEP :: 1.0 / 30.0;
eg_test_world :: () -> EgMoveWorld #effects(reads, writes, traps) { w: EgMoveWorld; return w; }
// One room step of input (ahead key_y, jump) on p, the page's and the server's order.
eg_test_step :: (p0: walk.Body, key_y: f32, jump: bool) -> walk.Body #effects(reads, writes, traps) {
  w := eg_test_world();
  none: [1] f32;
  p := eg_step_begin(p0, EgMoveIn.{key_y = key_y, run = true, jump = jump}, w, f32(EG_TEST_STEP));
  p = eg_step_advance(p, w, none[0..<0], none[0..<0], none[0..<0], f32(EG_TEST_STEP));
  return p;
}

#test "step: a jump while running lands, and the run's walk comes back (the air pose ends)" {
  p := walk.body_place(0, 0, 0, 0);
  for k: 0..<20 { p = eg_test_step(p, 1, false); }
  #assert p.on_ground && p.act == walk.Act.running;
  p = eg_test_step(p, 1, true);
  #assert !p.on_ground && p.act == walk.Act.airborne;
  // held through the air: it jumps once
  up := 0; landed := -1;
  for k: 0..<60 {
    p = eg_test_step(p, 1, k < 5);
    if p.act == walk.Act.airborne { up += 1; } else if landed < 0 { landed = k; }
  }
  #assert landed > 5 && landed < 40;               // a jump's flight, about half a second
  #assert p.on_ground && p.act == walk.Act.running && p.pos.y < 0.01;
  // let go of the keys: you stand
  for k: 0..<30 { p = eg_test_step(p, 0, false); }
  #assert p.act == walk.Act.idle;
}

#test "step: the server's word mid-jump: the re-run jumps as the server did, not from the page's held key" {
  // the server stepped input 1 (the press) and the page has stepped inputs 1..4, the key still down
  start := walk.body_place(0, 0, 0, 0);
  for k: 0..<10 { start = eg_test_step(start, 1, false); }
  page := start;
  for k: 0..<4 { page = eg_test_step(page, 1, true); }
  server := eg_test_step(start, 1, true);
  #assert !server.on_ground;
  // the word on input 1: you start again there and re-run inputs 2..4
  again := eg_step_set(page, server.pos.x, server.pos.y, server.pos.z, server.face, server.vel.x, server.vel.y, server.vel.z,
                       server.on_ground, eg_step_carry(server), true);
  for k: 0..<3 { again = eg_test_step(again, 1, true); }
  #assert abs(again.pos.y - page.pos.y) < 0.01 && !again.on_ground && again.act == walk.Act.airborne;
  // the word on the input before the press (ground, key up): the re-run of the press jumps
  before := eg_step_set(page, start.pos.x, start.pos.y, start.pos.z, start.face, start.vel.x, start.vel.y, start.vel.z,
                        start.on_ground, eg_step_carry(start), false);
  #assert before.act != walk.Act.airborne;
  for k: 0..<4 { before = eg_test_step(before, 1, true); }
  #assert abs(before.pos.y - page.pos.y) < 0.01 && before.act == walk.Act.airborne;
  // and landed, the word says ground: no air pose is kept
  landed := eg_step_set(page, 1, 0, 1, 0, 0, 0, 6, true, 0, false);
  #assert landed.act != walk.Act.airborne && landed.on_ground;
}

#test "step: drawn between room steps, a steady run moves the same each frame (no 31/47 ms stutter)" {
  p := walk.body_place(0, 0, 0, 0);
  for k: 0..<30 { p = eg_test_step(p, 1, false); }
  // 60 Hz frames: a room step every second frame, drawn at ahead 0 and 0.5
  last := eg_step_feet(p);
  from := last;
  least := 1000.0f32; most := 0.0f32;
  raw_least := 1000.0f32; raw_most := 0.0f32;
  for k: 0..<24 {
    was := p.pos;
    from = eg_step_feet(p);
    p = eg_test_step(p, 1, false);
    raw := sqrt((p.pos.x - was.x) * (p.pos.x - was.x) + (p.pos.z - was.z) * (p.pos.z - was.z));
    raw_least = walk.lo(raw_least, raw); raw_most = walk.hi(raw_most, raw);
    for half: 0..<2 {
      d := eg_step_drawn(from, p, f32(half) * 0.5);
      gap := sqrt((d.x - last.x) * (d.x - last.x) + (d.z - last.z) * (d.z - last.z));
      if k > 0 || half > 0 { least = walk.lo(least, gap); most = walk.hi(most, gap); }
      last = d;
    }
  }
  // the controller's raw position moves two or three of its steps a room step
  #assert raw_most > raw_least * 1.4;
  // drawn, each frame moves the same to a millimetre
  #assert least > 0.05 && most - least < 0.001;
}

#test "step: the server's word through the wire's tenth of a millisecond: every re-run steps as the server did" {
  // the server's seat from its placing (leftover 0), a steady run; at each of 45 steps the page starts
  // again from the server's word as the wire carries it and both step the next input
  server := walk.body_place(0, 0, 0, 0);
  worst := 0.0f32;
  for k: 0..<45 {
    server = eg_test_step(server, 1, false);
    tenths := server.clock.carry_ns / 100000;   // room-world.c's CARRY, tenths of a ms
    page := eg_step_set(server, server.pos.x, server.pos.y, server.pos.z, server.face, server.vel.x, server.vel.y, server.vel.z,
                        server.on_ground, f32(tenths) / 10000.0, false);
    #assert abs(f64(page.clock.carry_ns - server.clock.carry_ns)) < 100;
    a := eg_test_step(server, 1, false); b := eg_test_step(page, 1, false);
    worst = walk.hi(worst, abs(a.pos.z - b.pos.z) + abs(a.pos.x - b.pos.x));
  }
  #assert worst < 0.001;
  #assert eg_step_carry_ns(0) == 0 && eg_step_carry_ns(0.0071) == 7100000;   // off the fifteenths: as it came
}

#test "step: the server's word on the input just stepped (nothing to re-run) leaves the drawn feet where they were" {
  p := walk.body_place(0, 0, 0, 0);
  for k: 0..<20 { p = eg_test_step(p, 1, false); }
  before := eg_step_feet(p);
  same := eg_step_set(p, p.pos.x, p.pos.y, p.pos.z, p.face, p.vel.x, p.vel.y, p.vel.z, p.on_ground, f32(p.clock.carry_ns / 100000) / 10000.0, false);
  after := eg_step_feet(same);
  #assert abs(after.x - before.x) + abs(after.z - before.z) < 0.002;
}

#test "step: Link uses Lab launch and source speeds on both prediction and room replay" {
 p:=walk.body_place(0,0,0,0);none:[1]f32;w:=eg_step_world(EgMoveWorld.{},EgMoveIn.{link_flags=32,key_y=1,theta=0});
 for k:0..<64 {p=eg_step_begin(p,EgMoveIn.{link_flags=32,key_y=1,theta=0},w,1.0f32/64);p=eg_step_advance(p,w,none[0..<0],none[0..<0],none[0..<0],1.0f32/64);}
 #assert p.pos.z< -0.58 && p.pos.z> -0.7;
 p=walk.body_place(0,0,0,0);peak:f32=0;w=eg_step_world(EgMoveWorld.{},EgMoveIn.{link_flags=288,jump=true});
 for k:0..<100 {p=eg_step_begin(p,EgMoveIn.{link_flags=288,jump=k==0},w,1.0f32/64);p=eg_step_advance(p,w,none[0..<0],none[0..<0],none[0..<0],1.0f32/64);peak=walk.hi(peak,p.pos.y);}
 #assert peak>0.66 && peak<0.71 && p.on_ground;
}

#test "step: Link backflip launches at source speed and keeps captured facing across camera input" {
 p:=walk.body_place(0,0,0,0);i:=EgMoveIn.{key_y=1,jump=true,link_flags=160,theta=0.7};w:=eg_step_world(EgMoveWorld.{},i);p=eg_step_begin(p,i,w,1.0f32/64);
 #assert !p.on_ground && sqrt(p.vel.x*p.vel.x+p.vel.z*p.vel.z)>6.79999 && sqrt(p.vel.x*p.vel.x+p.vel.z*p.vel.z)<6.80001 && p.vel.y>2.9 && p.face==0.7;
 none:[1]f32;for k:0..<32 {p=eg_step_advance(p,w,none[0..<0],none[0..<0],none[0..<0],1.0f32/64);}#assert p.on_ground && p.face==0.7 && p.vel.x==0 && p.vel.z==0;
}

#test "experimental dash runs forward faster and cannot pass a wall" {
  empty: [1] f32; walls := [6] f32.[-3, 0, 2, 3, 3, 2.2];
  normal := walk.body_place(0, 0, 0, 0); dash := normal;
  i := EgMoveIn.{key_y = 1, run = true, theta = walk.PI}; di := EgMoveIn.{key_y = 1, run = true, theta = walk.PI, link_flags = 512};
  w := eg_step_world(EgMoveWorld.{}, i); dw := eg_step_world(EgMoveWorld.{}, di);
  for k: 0..<40 {
    normal = eg_step_advance(eg_step_begin(normal, i, w, 1.0f32 / 64), w, empty[0..<0], empty[0..<0], empty[0..<0], 1.0f32 / 64);
    dash = eg_step_advance(eg_step_begin(dash, di, dw, 1.0f32 / 64), dw, empty[0..<0], empty[0..<0], empty[0..<0], 1.0f32 / 64);
  }
  #assert dash.pos.z > normal.pos.z + 0.5;
  dash = walk.body_place(0, 0, 0, 0);
  for k: 0..<64 { dash = eg_step_advance(eg_step_begin(dash, di, dw, 1.0f32 / 64), dw, empty[0..<0], walls[..], empty[0..<0], 1.0f32 / 64); }
  #assert dash.pos.z > 1 && dash.pos.z < 2 && dash.collision_refusals == 0;
}

// A step at a pace scale, for Everglade's Dash (everglade/dash.coax on metaverse-engine/action/sprint.coax), through the controller as
// fivelab-face.c steps it: the sprint's pace is the scale, on link flag 512. Speed 30: 9.144 m over a 7.5 m/s run.
eg_test_scaled_step :: (p: walk.Body, i: EgMoveIn, w: EgMoveWorld, walls: [] f32, scale: f32) -> walk.Body #effects(all) {
  empty: [1] f32; f := 1.0f32 / 64;
  return eg_step_advance_jump(eg_step_begin(p, i, w, f), w, empty[0..<0], walls, empty[0..<0], f, scale, EgJump.{});
}
#test "Everglade's Dash sprints 30 feet past a run in its 1.8 s, stops at a wall and ends on time" #steps 2000000000 {
  none: [1] f32;
  i := EgMoveIn.{key_y = 1, run = true, theta = walk.PI}; di := EgMoveIn.{key_y = 1, run = true, theta = walk.PI, link_flags = 512};
  w := eg_step_world(EgMoveWorld.{}, i); dw := eg_step_world(EgMoveWorld.{}, di);
  run := walk.body_place(0, 0, 0, 0);
  for k: 0..<64 { run = eg_test_scaled_step(run, i, w, none[0..<0], 1); }   // already running, 7.5 m/s
  dash := run; start := run.pos.z; peak: f32 = 0; g := sprint.sprint_gain(9.144, 7.5);
  for k: 0..<128 {   // two seconds: the sprint's 1.8 and a little after
    run = eg_test_scaled_step(run, i, w, none[0..<0], 1);
    dash = eg_test_scaled_step(dash, di, dw, none[0..<0], sprint.sprint_rate(f32(k) / 64, g));
    if dash.vel.z > peak { peak = dash.vel.z; }
    #assert dash.collision_status == scaled_collision.CollideStatus.ok;
  }
  // 30 feet (9.14 m) more than the run in the same two seconds, less the moment it takes to speed up
  #assert dash.pos.z - run.pos.z > 8.6 && dash.pos.z - run.pos.z < 9.3 && run.pos.z - start > 14.9;
  #assert peak > 13.5 && peak < 14.4;   // about twice the run at its peak
  #assert abs(dash.vel.z - run.vel.z) < 0.05 && sprint.sprint_shape(f32(sprint.SPRINT_SECONDS)) == 0;   // and back to the run when it ends
  // a wall 6 m ahead: the sprint stops at it, every step admitted
  wall := [6] f32.[-3, 0, 6, 3, 3, 6.4];
  p := walk.body_place(0, 0, 0, 0);
  for k: 0..<128 {
    p = eg_test_scaled_step(p, di, dw, wall[..], sprint.sprint_rate(f32(k) / 64, g));
    #assert p.collision_status == scaled_collision.CollideStatus.ok && p.pos.z < 6;
  }
  #assert p.pos.z > 5.3 && p.collision_refusals == 0;
}

// Experimental combat's proportional walking rate. This is an opt-in native
// surface; the ordinary shared/replayed controller export remains unchanged.
eg_step_advance_scaled :: (p0:walk.Body,w:EgMoveWorld,bodies:[]f32,walls:[]f32,floors:[]f32,frame:f32,scale:f32)->walk.Body #export_c #effects(reads,writes,traps) {
  return eg_step_advance_jump(p0,w,bodies,walls,floors,frame,scale,EgJump.{});
}
eg_step_advance_jump :: (p0:walk.Body,w:EgMoveWorld,bodies:[]f32,walls:[]f32,floors:[]f32,frame:f32,scale:f32,jump:EgJump)->walk.Body #export_c #effects(reads,writes,traps) {
  p:=p0;
  if jump.mode==EG_JUMP_DENIED { p.jumps.waiting=0; }
  shaped:=jump.mode==EG_JUMP_HIGH || jump.mode==EG_JUMP_LONG;
  // a Dash's sprint (link flag 512, metaverse-engine/action/sprint.coax) always takes the scaled path: its pace is
  // the scale, the sprint over the run, in as many collision steps as it needs
  if scale==1 && !shaped && (w.link_flags&512)==0 { return eg_step_advance(p,w,bodies,walls,floors,frame); }
  if !walk.finite(scale) || scale<0 || w.aboard || (w.link_flags&32)!=0 {
    return walk.body_collision_report(p0,scaled_collision.CollideResult.{status=scaled_collision.CollideStatus.bad_profile});
  }
  if scale==0 { p.vel.x=0; p.vel.z=0; }
  profile:=link_collision.collision_profile_lookup("everglade");
  world:=walk.World.{bodies=bodies,walls=walls,floors=floors,collision=profile.profile};
  if !w.deck && bodies.count>=7 && p.pos.y>0.6 { bodies[4]=1.9; bodies[6]=0.62; }
  world.locomotion.walk_speed*=scale; world.locomotion.run_speed*=scale;
  if shaped && walk.body_counts(p,frame)>0 {
    launch:=p.on_ground && p.jumps.waiting>0;
    if jump.mode==EG_JUMP_HIGH {
      world.locomotion.jump_speed=sqrt(2*world.locomotion.gravity*jump.height);
      world.locomotion.walk_speed=0;
      world.locomotion.run_speed=0;
      p.vel.x=0; p.vel.z=0;
    } else if scale>0 {
      // Match the horizontal allowance to the ordinary jump's flight time.
      speed:=jump.span*world.locomotion.gravity/(2*world.locomotion.jump_speed);
      world.locomotion.walk_speed=speed;
      world.locomotion.run_speed=speed;
      if launch {
        direction:=walk.body_wish(p);
        p.vel.x=direction.x*speed;
        p.vel.z=direction.z*speed;
      }
    }
  }
  return walk.body_advance_scaled_in(world,p,frame);
}
#test "combat walking rate speeds and slows actual motion while keeping the same controller clock" {
  w:=EgMoveWorld.{deck=true}; empty:[1]f32;
  base:=walk.body_input(walk.body_place(0,0,0,0),0,1,0,0,true,false,f32(walk.PI)); fast:=base; slow:=base;
  for i:0..<64 {
    base=eg_step_advance_scaled(base,w,empty[0..<0],empty[0..<0],empty[0..<0],f32(walk.STEP),1);
    fast=eg_step_advance_scaled(fast,w,empty[0..<0],empty[0..<0],empty[0..<0],f32(walk.STEP),2);
    slow=eg_step_advance_scaled(slow,w,empty[0..<0],empty[0..<0],empty[0..<0],f32(walk.STEP),0.5);
  }
  #assert fast.pos.z>base.pos.z*f32(1.7) && slow.pos.z<base.pos.z*f32(0.6);
  #assert base.clock.ticks==64 && fast.clock.ticks==64 && slow.clock.ticks==64;
  #assert fast.collision_status==scaled_collision.CollideStatus.ok;
}

#test "combat walking rate refuses unsupported profiles and stops horizontal motion at zero" {
  p:=walk.body_input(walk.body_place(0,0,0,0),0,1,0,0,true,false,f32(walk.PI)); p.vel.z=7.5;
  empty:[1]f32; zero:f32=0;
  for mode:0..<5 {
    w:=EgMoveWorld.{deck=true}; rate:f32=2;
    if mode==0 { rate= -1; } if mode==1 { rate=zero/zero; } if mode==2 { rate=1/zero; }
    if mode==3 { w.aboard=true; } if mode==4 { w.link_flags=32; }
    q:=eg_step_advance_scaled(p,w,empty[0..<0],empty[0..<0],empty[0..<0],f32(walk.STEP),rate);
    #assert q.collision_status==scaled_collision.CollideStatus.bad_profile && q.pos.z==p.pos.z && q.clock.ticks==p.clock.ticks;
  }
  w:=EgMoveWorld.{deck=true}; q:=eg_step_advance_scaled(p,w,empty[0..<0],empty[0..<0],empty[0..<0],f32(walk.STEP),0);
  #assert q.vel.z==0 && q.pos.z==p.pos.z && q.clock.ticks==1;
}

// Same dead zone and world input gates as the actual controller. Consumers
// pair this intent with admitted body displacement; it is not movement itself.
eg_step_motion_intent :: (input:EgMoveIn,w:EgMoveWorld)->EgMotionIntent #export_c #effects(reads,writes,traps) {
  if w.busy || w.still || w.aboard { return EgMotionIntent.{}; }
  pad:=sqrt(input.pad_x*input.pad_x+input.pad_y*input.pad_y);
  return EgMotionIntent.{walk=input.key_x!=0 || input.key_y!=0 || pad>f32(walk.DEAD_ZONE) || (w.link_flags&512)!=0,jump=input.jump && w.jump_ok};
}
#test "controller motion intent shares the analog dead zone and denied input gates" {
  w:EgMoveWorld; input:=EgMoveIn.{pad_y=0.1}; #assert !eg_step_motion_intent(input,w).walk;
  input.pad_y=f32(walk.DEAD_ZONE); #assert !eg_step_motion_intent(input,w).walk;
  input.pad_y=f32(walk.DEAD_ZONE)+f32(0.01); #assert eg_step_motion_intent(input,w).walk;
  input=EgMoveIn.{jump=true}; #assert eg_step_motion_intent(input,w).jump;
  w.jump_ok=false; #assert !eg_step_motion_intent(input,w).jump;
  w.link_flags=512; #assert eg_step_motion_intent(input,w).walk;
  w.busy=true; #assert !eg_step_motion_intent(input,w).walk && !eg_step_motion_intent(input,w).jump;
  w.busy=false; w.still=true; #assert !eg_step_motion_intent(input,w).walk;
  w.still=false; w.aboard=true; #assert !eg_step_motion_intent(input,w).walk;
}


// First aid must reach past the same capsule bodies and hulls that stop the player: a hull stops the
// line when some part of it is inside every one of the hull's faces.
eg_contact_clear_among :: (bodies:[] f32,hulls:[] f32,fx:f32,fy:f32,fz:f32,tx:f32,ty:f32,tz:f32)->bool #export_c #effects(all) {
  if !eg_contact_clear(bodies,fx,fy,fz,tx,ty,tz) { return false; }
  from:=walk.v3(fx,fy+0.8,fz); along:=walk.v3(tx-fx,ty-fy,tz-fz); at:=0;
  while at<hulls.count {
    k:=hull_query.query_hull(hulls,at); if !k.ok { break; } at=k.next;
    t0:=0.0f32; t1:=1.0f32;
    for i:0..<k.faces {
      o:=k.at+hull_query.QUERY_HULL_HEAD+i*hull_query.QUERY_HULL_FACE;
      a:=hulls[o]*from.x+hulls[o+1]*from.y+hulls[o+2]*from.z-hulls[o+3]; b:=hulls[o]*along.x+hulls[o+1]*along.y+hulls[o+2]*along.z;
      if abs(b)<0.000001 { if a>0 { t0=2; } continue; }
      t:= -a/b; if b<0 { if t>t0 { t0=t; } } else { if t<t1 { t1=t; } }
    }
    if t0<=t1 { return false; }
  }
  return true;
}
eg_contact_clear :: (bodies:[] f32,fx:f32,fy:f32,fz:f32,tx:f32,ty:f32,tz:f32)->bool #export_c #effects(all) {
  from:=walk.v3(fx,fy+0.8,fz);
  to:=walk.v3(tx,ty+0.8,tz);
  for i:0..<bodies.count/7 {
    j:=i*7;
    a:=walk.v3(bodies[j],bodies[j+1],bodies[j+2]);
    b:=walk.v3(bodies[j+3],bodies[j+4],bodies[j+5]);
    pair:=walk.closest(from,to,a,b);
    d:=walk.sub(pair.p,pair.q);
    if walk.dot(d,d)<bodies[j+6]*bodies[j+6] { return false; }
  }
  return true;
}

#test "Everglade II first aid contact stops at a rock's hull, and goes over a low one" {
  h:[hull_query.QUERY_HULL_HEAD+6*hull_query.QUERY_HULL_FACE] f32; e:=hull_query.query_test_wedge(h[..],0,0); #assert e==h.count;
  none:[1] f32;
  #assert !eg_contact_clear_among(none[0..<0],h[..],-2,-0.5,0,2,-0.5,0);     // through it at 0.3 m
  #assert eg_contact_clear_among(none[0..<0],h[..],-2,-0.5,1.5,2,-0.5,1.5);  // past it
  #assert eg_contact_clear_among(none[0..<0],h[..],-2,0.2,0,2,0.2,0);        // over it, 1 m up
  #assert !eg_contact_clear_among(none[0..<0],h[..],-2,-0.5,0,0,-0.5,0);     // to its middle
  trunk:=[7]f32.[0,0.3,0,0,1.6,0,0.25];
  #assert !eg_contact_clear_among(trunk[..],h[0..<0],-0.6,0,0,0.6,0,0);
}
#test "Everglade II first aid contact stops at trunks and rocks" {
  trunk:=[7]f32.[0,0.3,0,0,1.6,0,0.25];
  #assert !eg_contact_clear(trunk[..],-0.6,0,0,0.6,0,0);
  #assert eg_contact_clear(trunk[..],-0.6,0,0.4,0.6,0,0.4);
  rock:=[7]f32.[-0.5,0.9,0,0.5,0.9,0,0.35];
  #assert !eg_contact_clear(rock[..],0,0,-0.6,0,0,0.6);
  #assert eg_contact_clear(rock[..],0,1,-0.6,0,1,0.6);
}

#test "SRD jump envelopes reach their physical height and length through the fixed controller" {
  w:=EgMoveWorld.{deck=true}; empty:[1]f32;
  for mode:EG_JUMP_DENIED..<EG_JUMP_LONG+1 {
    p:=walk.body_place(0,0,0,0);
    jump:=EgJump.{mode=mode,height=0.9144,span=2.4384};
    peak:=0.0f32;
    for tick:0..<64 {
      input:=EgMoveIn.{jump=tick==0,key_y=1};
      p=eg_step_begin(p,input,w,f32(walk.STEP));
      p=eg_step_advance_jump(p,w,empty[0..<0],empty[0..<0],empty[0..<0],f32(walk.STEP),1,jump);
      peak=walk.hi(peak,p.pos.y);
      if p.on_ground { break; }
    }
    if mode==EG_JUMP_DENIED { #assert peak==0; }
    if mode==EG_JUMP_HIGH { #assert peak>0.84 && peak<0.92 && p.pos.z==0 && p.on_ground; }
    if mode==EG_JUMP_LONG { #assert peak>1 && abs(p.pos.z)>2.25 && abs(p.pos.z)<2.55 && p.on_ground; }
    #assert p.collision_refusals==0;
  }
}
