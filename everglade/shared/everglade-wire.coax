// Everglade's wire: the frames between a player's page (everglade-net.coax) and the room server that
// owns the shared world (coax/web/room/, GitHub #12705; docs/metaverse/2026-11-03-everglade-multiplayer-spec.md
// section 3.6). One file both sides #load, so the contract is checked code, not prose. It depends on
// nothing else. Version 3: one replication model for every entity (#12783).
//
// The server is the authority (owner, 2026-11-03). A page sends intents: its input every step, its
// casts, its interactions, a rebuild. The server steps every seat with the shared movement step
// (everglade-move.coax, everglade-step.coax) on that input, rolls everything, and sends the state.
// A page predicts only its own movement, with the same step on the same input.
//
// Text frames over the relay's WebSocket, /api/room/relay/everglade/CODE. Fields are separated by one
// space; numbers are whole: cm, cm/s, centiradians (an input's THETA in 0.1 mrad), ms; a stick or key -100 to 100. A page's frame is
// at most 1024 bytes, a server's at most 3800.
//
// Page to server:
//   P ENGINE RULES CONTENT         the build this page is (WIRE_PINS), just before its hello (#12839)
//   H 6 LOOK CLASS FLAGS NAME      hello, after y: look ("ranger.SKIN.DYE.TRIM"), class ("druid"), FLAGS
//                                  (1 touch, 2 logged in, 8 reads packed rows: WIRE_HELLO_PACKED), the name shown ("-" none)
//   I SEQ KX KY PX PY THETA B HEARD  one step's input (everglade-move-types.coax EgMoveIn), every step at
//                                  30 Hz, idle ones too: the keys and the stick (-100 to 100, along the
//                                  camera), the camera's yaw in 0.1 mrad (WIRE_FINE), B bits (1 run, 2 jump, 4 dive); HEARD the
//                                  last state tick the page heard whole (WireMirror), 0 none
//   C SEQ SLOT AX AY AZ TGT [MODE [VIEW]]  MODE the spell's mode (0 none); VIEW the moment the page drew the
//                                  others at, ms of the room's ticks as an arrow's F says it: the room judges
//                                  the cast there, inside lag compensation's bound (#13289)
//   C SEQ SLOT AX AY AZ TGT        a cast: the bar slot, the aim, the target (-1 none; 0-999 a watch actor,
//                                  1000 + SS a seat, 2000 + EID a creature)
//   E SEQ KIND ID                  interact: KIND 1 talk to townsperson ID, 2 a door, 3 a boat, 4 a quest
//                                  board, 5 end what bar slot ID holds up (its concentration), 6 talk to
//                                  dialogue ID, 7 wear item ID, 8 empty equipment slot ID
//   R SEQ                          ask for the rebuild
//   L SEQ                          Everglade's whole-heal rest (an Everglade II room refuses it: r SEQ rest)
//   V LOOK KIND                    Change character: your seat sits again as this look and class
//   X VERB [ARG] | X at XMM ZMM YAW  a local room's admin lines (everglade/server/admin.coax); no other room reads them
//   K PID PID ...                  the players you block, WIRE_BLOCKS at most, the whole list each time
//                                  ("K -" none): the room sends you nothing of them (#12789)
//   t MS                           a clock ping
//   T SEQ CODE                     go to the instance CODE of this realm (#12850, coax/web/room/room-travel.coax)
//   O N                            the page heard N outcomes, fewer than an o said: the room sends the town again
//                                  from the start, then e town (#12902)
//   A X Y Z YAW                    where you stand as you sit again after a lost room (cm, centiradians), just
//                                  before the hello: an Everglade II room puts you there when it is no farther
//                                  from where it last saved you than you could have run since (#13057)
// Server to page (the relay's own first: y SS N T, j SS, l SS, t MS T):
//   W TICK HZ SEED DAY WEATHER BUDGET  the world header, after y, and again to everyone when the weather
//                                  turns (#12709): the tick now, the tick rate, the room's seed, ms into the
//                                  server's day (WIRE_DAY_MS long) at TICK, the weather state the server
//                                  runs now plus 1 (WEATHER_*; 0 none: the page keeps its own sky), and the
//                                  bytes of state a seat is sent a tick at most (WIRE_BUDGET)
//   D TICK ACK F PART E;E;...      state at TICK; ACK the last I SEQ of yours stepped; F bits: 1 the page
//                                  forgets every entity first (a snapshot), 2 more of this tick follows,
//                                  4 out of band: a WebTransport seat's outcomes on a reliable stream, read
//                                  for their entries only (coax/web/room/room-wt.coax, #13176);
//                                  PART counts this tick's frames from 0; entries a ';' apart:
//     s ID BACK MASK V V ...       an entity's state (the replication model below)
//     SBITS                        the same row bit-packed (#13165), to a page whose hello set WIRE_HELLO_PACKED:
//                                  ID, BACK, MASK and each field's change in WIRE_B64's characters, after the S
//     x ID                         an entity gone, or out of your view
//     n SS ID LOOK CLASS FLAGS NAME  who a seat is ("-" none yet)
//     e cast SS SLOT AX AY AZ SEED a cast the server took: every page plays it from SEED
//     e hit WHO BY AMT KIND        damage (WHO and BY as TGT codes)
//     e mon TICK KIND M SEAT AMOUNT [FX FZ TX TZ FLY_MS] | e guard TICK KIND SEAT AMOUNT   what a monster
//                                  or the guard did or took (everglade/server/creature-wire.coax, #13276)
//     e heal WHO AMT | e die WHO | e break PIECE IX IY IZ | e burn PIECE ON | e rebuild | e edit VERSION
//     e stop SS SLOT WHY          a cast the server took ended before its strike (WHY: range, sight, gone,
//                                  held, dead, left: everglade-cast-rules.coax, #12790); pages drop its strike
//     w SS LEVEL                   a seat's WANTED level
//     e xp SS AMOUNT | e level SS LEVEL  XP a seat earned, its level gone up (aimed at that seat)
//     e quest SS QUEST STAGE | e item SS ITEM KIND SLOT | e coin SS COIN | e say SS DIALOGUE | e loot SS KIND
//                                  what seat SS's character has, the server's record of it (wire_put_own below)
//     e rc ID K AX AY AZ SEED [FX FY FZ] | e wm KIND CASTER FOE AX AY AZ BX BY BZ FLIGHT LIFE  a raid
//                                  creature's cast, a guard's spell in flight
//     e mend CODE | e pburn I ON | e pgone I  a Repair stood up; a placed thing alight or out, burnt through
//     g KIND PHASE ... CAP [PLAYERS [FRONT TOWN CAPC CAPT]] | v SS LEVEL XP CAP LO HI [REST]  the raid, your level
//     e town                       the town's pieces sent again from the start have all come: what the page has
//                                  broken, burning or gone that they didn't name stands again (#12902)
//     k RATE USED DROPPED EVERY    your link, once a second, to a page that reads packed rows (#13178)
//     o N                          the outcomes (WIRE_OUTCOMES) the room has sent this seat, this entry's
//                                  frame's among them: a page that heard fewer missed a frame and says O
//   r SEQ REASON                   an intent of yours refused (a cast: everglade-cast-rules.coax CR_WORDS; R: breaking;
//                                  T: full, room, ticket, busy)
//   g CODE                         your T was taken: leave this room and join the instance CODE (#12850)
//
// The replication model (#12783). Every entity the server replicates (players, townsfolk, creatures,
// zones, walls, effects) is a row of WIRE_SF whole fields (WS_*), and every row goes out the same way:
//   - each tick the server fills a table of every entity's row (WireHist, WIRE_BASES ticks kept);
//   - for each seat, a row is sent as a delta against the newest row of it the page acknowledged (HEARD
//     names a tick whose every part came: everything sent that tick is the page's), BACK ticks back, with
//     MASK's fields only, each new less base; BACK 0 is absolute (against zeros), when the page holds no
//     row of it WIRE_BASES ticks back or newer;
//   - a row equal to its base is not sent; one sent and not yet acknowledged waits WIRE_RESEND ticks;
//   - the rest are ordered by priority, which grows each tick by the entity's weight over its distance
//     (wire_rel), and written in that order until the seat's budget of WIRE_BUDGET bytes a tick is spent;
//     what is left waits with its priority kept. Your own player goes first, every tick, budget or not;
//   - an entity gone is sent as x until a tick that held the x is acknowledged.
// The page keeps every entity's last WIRE_BASES rows (WireMirror), decodes each row against its base,
// and draws every remote entity from one interpolation buffer (everglade-net.coax).

#load "everglade-forest-profile.coax";
#load "../../metaverse-engine/net/text-frame.coax";   // the frames' words and numbers, written and read (#13270)
#load "../../metaverse-engine/net/replication.coax";
#load "../../metaverse-engine/net/row.coax";
#load "../../metaverse-engine/net/spawn.coax";    // reliable spawn and despawn (#13178)
#load "../../metaverse-engine/net/budget.coax";   // priority and the order rows go in (#13178)
#load "wire-table.coax";   // the binary wire: one table of every frame and entry, and its one encoder (#13278)

WIRE_F_OOB :: 4;      // a D's F bit: out of band, a WebTransport seat's outcomes on a reliable stream (coax/web/room/room-wt.coax)
WIRE_VERSION :: 7;   // 7: familiars are rows, their answers and the Healer's Kit's e entries, their requests E kinds (#13276, #13245); 6: Everglade II's monsters and guard are rows, their blows e entries (#13276); 5: authoritative forest rows; 4: I's THETA in 0.1 mrad (WIRE_FINE)
WIRE_REFUSE_VERSION :: "version";   // r 0 version: the room speaks another WIRE_VERSION than the hello's (the page reloads)
WIRE_REFUSE_ELSEWHERE :: "elsewhere";   // r 0 elsewhere: a newer seat ticket has your character, in another tab or room (#12834); the page stops rejoining
WIRE_REFUSE_RESTARTING :: "restarting";   // r 0 restarting: the room drains before a release (#12797); the page joins again at once, on another shard
// The oldest wire the room still speaks (#13398): the wire production's page speaks (WIRE_LIVE), and
// never newer than the version before this one. A release moves its rooms before its page, and a page
// a player has open is the last release's, so a room seats a hello on any version from WIRE_MIN to
// WIRE_VERSION and writes that page what it reads: everglade/server/wire-prev.coax holds those
// writers, for every version from WIRE_MIN up (the room's checks fail when it is not written for
// them). A page speaks WIRE_VERSION alone.
// WIRE_LIVE is the wire of the page production serves. Raise it in the first change after a
// production release, and delete the writers for the versions below it then. A wire raised twice
// between releases keeps both older versions' writers: lowering nothing here is the whole rule.
// coax/remote/check.sh e2 ("e2 prev-wire") holds it to production's own commit on every head.
WIRE_LIVE :: 5;
WIRE_MIN :: ifx WIRE_LIVE < WIRE_VERSION - 1 then WIRE_LIVE else WIRE_VERSION - 1;
// The build a page and a room are, beside the wire (#12839, metaverse-engine/session/compat.coax): one encounter
// never mixes two engines, two rule sets or two worlds. Raise WIRE_ENGINE when the shared movement or
// world step changes what a page predicts, WIRE_RULES when the room's rules (everglade5e-room-rules.coax,
// everglade-cast-rules.coax) change what a cast or a hit does, and WIRE_CONTENT when the world the page
// draws (the city, its pieces, its people) changes. A page says them in P before its hello; a page
// from before P is WIRE_PINS_FIRST's build. A room refuses a hello whose build differs ("r 0 version":
// the page reloads into the new one).
WIRE_ENGINE :: 1; WIRE_RULES :: 1; WIRE_CONTENT :: 1;
// The content registry's hash WIRE_CONTENT was sealed with (#13286, everglade/model/content-ids.coax
// CONTENT_HASH): the content pin covers every ability, spell, creature template, item kind and spawn
// number. When the registry changes, its checks fail here until this is the new hash; raise
// WIRE_CONTENT with it when a page and a room on either side of the change must not meet (a row
// retired or re-meant; a row only added needs no new pin: an older build never sends it).
WIRE_CONTENT_IDS :: 55127017896882;
WirePins :: struct #persisted { engine: int = WIRE_ENGINE; rules: int = WIRE_RULES; content: int = WIRE_CONTENT; }
WIRE_PINS_FIRST :: WirePins.{engine = 1, rules = 1, content = 1};
// The content pin of a build whose content tables are at revision `rev` (#13381; aethyr-content-v1,
// everglade/content/everglade.content): the tables' revision, under WIRE_CONTENT, so a page and a room
// with other tables never meet, and nor do two builds on either side of a WIRE_CONTENT raise. A build
// with no tables (rev 0: a room started without them) says WIRE_CONTENT alone. Revision 1 under
// WIRE_CONTENT 1 is 1, the pin every build before this said.
WIRE_CONTENT_REVS :: 1000000;   // revisions under one WIRE_CONTENT
wire_content_pin :: (rev: int) -> int { return ifx rev < 1 || rev >= WIRE_CONTENT_REVS then WIRE_CONTENT else (WIRE_CONTENT - 1) * WIRE_CONTENT_REVS + rev; }
// This build's pins with its tables at revision `rev`.
wire_pins_at :: (rev: int) -> WirePins { p := WirePins.{}; p.content = wire_content_pin(rev); return p; }
#test "the content pin is the tables' revision under WIRE_CONTENT; no tables is WIRE_CONTENT alone" {
  #assert wire_content_pin(0) == WIRE_CONTENT && wire_content_pin(-3) == WIRE_CONTENT && wire_content_pin(WIRE_CONTENT_REVS) == WIRE_CONTENT;
  #assert wire_content_pin(1) == (WIRE_CONTENT - 1) * WIRE_CONTENT_REVS + 1 && wire_content_pin(2) == wire_content_pin(1) + 1 && wire_content_pin(2) != wire_content_pin(1);
  p := wire_pins_at(7); q := WirePins.{};
  #assert p.engine == q.engine && p.rules == q.rules && p.content == wire_content_pin(7) && wire_pins_at(0).content == q.content;
}
WIRE_FRAME :: 1024;        // a page's frame at most
WIRE_SERVER_FRAME :: 3800; // a server's
// A heading's units a radian on I's THETA (#12718): 0.1 mrad, where centiradians were 5 mrad
// off at worst, which a walk keeps as a sideways drift of up to 5 mm a metre from where you face.
WIRE_FINE :: 10000;
WIRE_HZ :: 30; WIRE_AWAY_MS :: 3000;             // the tick, and a page's steps
// A room's players at most (#13263): the room's EG_SEATS and RELAY_SEATS are this (room.coax's check);
// the API's ROOM_SEATS and verse.room_max() say it again. The 17th is placed in another room.
WIRE_SEATS :: 16;
// the sky the server runs (#12709): its day, 48 minutes (metaverse/style-preset.coax STYLE_CYCLE_SECONDS),
// and the weather's schedule seed (everglade.coax EG_WEATHER_SEED), on the temperate climate
WIRE_DAY_MS :: 2880000; WIRE_WEATHER_SEED :: 0xe7e5;
// what an entity is (its row's KIND): a player, a townsperson or guard, else a creature, zone or effect
WK_PLAYER :: 0; WK_FOLK :: 1;
WK_PACK :: 10;             // Conjure Animals' pack: its middle; F 1 while it runs
WK_FROG :: 11;             // a townsperson Polymorph took: P1 their index
WK_BEAST :: 12;            // a summoned beast: P1 the form
// Everglade II's creatures that stand in the world (#13276; everglade/server/creatures.coax, guard.coax).
// Each declares its row's fields once, in WIRE_KIND_FIELDS below; delta, acknowledgement, priority,
// the link budget, interest and the block list are the row layer's, as every row's are.
WK_MONSTER :: 13;          // a wolf or a goblin: G its state (E2M_*), CLIP its act under way (E2M_ACT_*, 0 none), T0 the tick that
                           // act began (the tick it fell, when dead; 0 none), OWNER its foe as a TGT code (-1 none), P1 its index
                           // (0 to WIRE_MONS - 1), P2 its kind (0 a wolf, 1 a goblin), HP and MAX the battle's
WK_GUARD :: 14;            // the path's guard: G his state (E2G_*), T0 the tick of his last swing (-1 none), OWNER his foe, HP and MAX
WK_FAMILIAR :: 15;         // a familiar (#13276): OWNER its owner as a TGT code, P1 its form (the index into rules/srd RS_FAMILIAR_FORMS), HP and MAX,
                           // G whose senses its owner has (0 their own, 1 its sight, 2 its sight and hearing). One a seat; pocketed, released or dead it has no row
WIRE_FAM_EID :: 970200;    // owner seat S's familiar's row id: WIRE_ID_MADE + WIRE_FAM_EID + S
WK_MOUNT :: 16;            // a mount (#13268; everglade/server/riding.coax): G its state (metaverse-engine/action/mount.coax MOUNT_*), CLIP its gait,
                           // T0 the tick its mounting or dismounting began, OWNER its rider as a TGT code (-1 nobody), P1 its kind
                           // (everglade/shared/mount-kinds.coax MK_*), P2 its feet's height over the ground in centimetres (a flier's, a jump's).
                           // Its velocity is its speed along its heading (backing: against it) and its feet's speed up
WIRE_MOUNTS :: 4;          // the mounts a zone holds (everglade/shared/mount-rules.coax E2R_MOUNTS)
WIRE_MOUNT_EID :: 970300;  // mount M's row id: WIRE_ID_MADE + WIRE_MOUNT_EID + M
WIRE_MONS :: 12;           // the monsters a room holds at most
WIRE_MON_EID :: 970000;    // monster M's row id: WIRE_ID_MADE + WIRE_MON_EID + M
WIRE_GUARD_EID :: 970100;  // the guard's row id: WIRE_ID_MADE + WIRE_GUARD_EID
WK_STONE :: 20;            // a Wall of Stone: its middle, its way (YAW along it); HP and P1 its two panels' hit points, P2 its length
WK_TENTACLES :: 21;        // Black Tentacles' square: its middle; P2 its side
WK_THORNS :: 22;           // a Wall of Thorns: its middle, its way; P2 its length
WK_LINE :: 23;             // a wall of wind or fire: P1 the ability (AB_*), P2 its length
WK_ZONE :: 24;             // a lingering zone (Moonbeam, Sleet Storm, Fog Cloud...): P1 the ability, P2 its radius
WK_DOORS :: 31;            // the town's doors the room has open: one row always, P1 doors 0 to 30, P2 31 to 61 (a bit each; WIRE_DOOR_WORD)
WIRE_DOOR_WORD :: 31; WIRE_DOOR_WORDS :: 2;
WIRE_DOORS_EID :: 960000;   // the doors row's id: WIRE_ID_MADE + WIRE_DOORS_EID
WK_BOAT :: 25;             // a rowboat (#12861): one row each always; OWNER the seat that rows it (-1 moored), P1 its float (river.coax), P2 the oars' stroke in thousandths (-1 shipped)
WIRE_BOAT_EID :: 961000;   // the n-th boat row's id: WIRE_ID_MADE + WIRE_BOAT_EID + n
WK_TREE :: FOREST_KIND;             // authoritative forest state (everglade-session-v7.json forest.fields)
WIRE_TREE_EID :: FOREST_EID - WIRE_ID_MADE; WIRE_TREES :: FOREST_RECORDS;
WK_EFFECT :: 30;           // a condition, buff or hold that lasts: OWNER the TGT code it is on, P1 the slot or ability, P2 its WC_* bit, T0 and DUR
// an effect's cause (WK_EFFECT's P1) for the watch's spells on a player (everglade-status.coax ST_*)
WE_HOLD_PERSON :: 0; WE_EARTHBIND :: 1; WE_RAY_OF_FROST :: 2; WE_WATCH :: 3;
WE_BIT :: [WE_WATCH] int.[WC_PARALYZED, WC_BOUND, WC_SLOWED];   // the WC_* bit each holds
WIRE_TGT_SEAT :: 1000;     // an OWNER that is a seat's player: 1000 + SS
// a player's G bits
WG_GROUND :: 1; WG_SWIM :: 2; WG_BOAT :: 4; WG_DEAD :: 8; WG_AWAY :: 16;   // AWAY: nothing heard from that seat's page for WIRE_AWAY_MS
// a player's COND bits: the SRD's conditions (rules/srd/engine.coax RS_*: 256 Paralyzed is Hold
// Person's hold), and Everglade's own past them
WC_PARALYZED :: 256; WC_PETRIFIED :: 512; WC_PRONE :: 2048; WC_RESTRAINED :: 4096; WC_STUNNED :: 8192; WC_UNCONSCIOUS :: 16384;
WC_SLOWED :: 65536;        // Ray of Frost's slow (the watch's casters)
WC_BOUND :: 8388608;       // Earthbind's hold on the ground (the watch's casters): no rising, no flying
// the SRD engine's effects on a creature, as the room sends them (everglade5e-room-rules.coax E5RR_C_*: #12771)
WC_HALTED :: 131072;       // Command's Halt: it doesn't move and takes no action
WC_BANED :: 262144; WC_BLESSED :: 524288; WC_FAITH :: 1048576; WC_ENFEEBLED :: 2097152; WC_HEXED :: 4194304;
WC_STOPPED :: WC_PARALYZED | WC_PETRIFIED | WC_RESTRAINED | WC_STUNNED | WC_UNCONSCIOUS | WC_HALTED;   // can't move
// an input's B bits
WB_RUN :: 1; WB_JUMP :: 2; WB_DIVE :: 4; WB_RISE :: 8; WB_SINK :: 16;   // (rise, sink: Levitate's keys held)
// an interaction's KIND
WE_TALK :: 1; WE_DOOR :: 2; WE_BOAT :: 3; WE_BOARD :: 4; WE_END :: 5;
// Everglade II's familiar and Healer's Kit (#13276, #13245; everglade/server/familiar-wire.coax packs and reads each ID):
// summon a companion, begin the Wizard's Find Familiar, pocket recall or release it, step it, have it deliver Cure Wounds,
// borrow its senses; use the kit on the nearest dying ally
WE_FAM_SUMMON :: 9; WE_FAM_RITE :: 10; WE_FAM_ORDER :: 11; WE_FAM_STEP :: 12; WE_FAM_CURE :: 13; WE_FAM_SENSES :: 14; WE_KIT :: 15;
// Riding (#13268; everglade/server/mount-wire.coax): mount the mount ID, get down (ID 0), bring a flier down (ID 0)
WE_MOUNT :: 20; WE_DISMOUNT :: 21; WE_LAND :: 22;
WE_RANGE_RESET :: 23;   // the Archery Range: clear your tally (everglade/server/range-wire.coax, #13507)
WE_SAY :: 6; WE_WEAR :: 7; WE_BARE :: 8;   // Everglade II (#13291, #13292): talk to dialogue ID (the content tables'), wear item ID, empty equipment slot ID

WireIn :: struct #persisted { seq: int; kx: int; ky: int; px: int; py: int; theta: f32; b: int; heard: int; }   // theta goes in WIRE_FINE units (0.1 mrad)
WireCast :: struct #persisted { seq: int; slot: int; ax: f32; ay: f32; az: f32; tgt: int = -1; mode: int; view: int = 0; }   // mode: the spell's (wire_mode), 0 sent as nothing unless a view follows; view: the moment the page drew the others at (#13289), 0 sent as nothing
WireUse :: struct #persisted { seq: int; kind: int; id: int; }
// The borrowed codec boundary remains available to existing callers. Active
// page/room hellos use WireHelloValue, which owns every byte of its fields.
WireHello :: struct { version: int = WIRE_VERSION; look: string; kind: string; flags: int; name: string; }
WireHelloValue :: struct #persisted {
  version: int = WIRE_VERSION; flags: int; ok: bool;
  look: [WIRE_FRAME] u8; look_n: int;
  kind: [WIRE_FRAME] u8; kind_n: int;
  name: [WIRE_FRAME] u8; name_n: int;
}
#test "owned hello fields survive reuse of the packet and keep the published wire bytes" {
  packet:[WIRE_FRAME]u8;
  n:=wire_put_hello(packet[..],0,WireHello.{look="ranger.2.1.0",kind="druid",flags=2,name="Ash Wood"});
  rd:=[1]WireRd.[wire_rd(cast(string)packet[0..<n],1)];
  value:=wire_read_hello_value(cast(string)packet[0..<n],rd[..]);
  for i:0..<n {packet[i]=0;}
  #assert value.ok && rd[0].ok && value.look_n==12 && value.kind_n==5 && value.name_n==8;
  out:[WIRE_FRAME]u8;m:=wire_put_hello_value(out[..],0,value);
  #assert cast(string)out[0..<m]=="H 7 ranger.2.1.0 druid 2 Ash Wood";
  huge:[WIRE_FRAME+1]u8;rd[0]=wire_rd(cast(string)huge[..],1);
  #assert !wire_read_hello_value(cast(string)huge[..],rd[..]).ok && !rd[0].ok;
}
wire_hello_value :: (h: WireHello) -> WireHelloValue {
  v:WireHelloValue;v.version=h.version;v.flags=h.flags;
  if h.look.count>WIRE_FRAME || h.kind.count>WIRE_FRAME || h.name.count>WIRE_FRAME {return v;}
  v.ok=true;v.look_n=h.look.count;v.kind_n=h.kind.count;v.name_n=h.name.count;
  for ch,i:h.look {v.look[i]=ch;}for ch,i:h.kind {v.kind[i]=ch;}for ch,i:h.name {v.name[i]=ch;}
  return v;
}
wire_read_hello_value :: (t:string,r:[]WireRd)->WireHelloValue {
  if t.count>WIRE_FRAME {r[0].ok=false;return WireHelloValue.{};}
  value:=wire_hello_value(wire_read_hello(t,r));value.ok=value.ok && r[0].ok;
  return value;
}
wire_put_hello_value :: (out:[]u8,at:int,value:WireHelloValue)->int {
  v:=value;
  if !v.ok {return at;}
  return wire_put_hello(out,at,WireHello.{version=v.version,look=cast(string)v.look[0..<v.look_n],kind=cast(string)v.kind[0..<v.kind_n],flags=v.flags,name=cast(string)v.name[0..<v.name_n]});
}
WireWorld :: struct { tick: int; hz: int = WIRE_HZ; seed: int; day: int; weather: int; budget: int = WIRE_BUDGET; }
WireN :: struct { ss: int; id: string; look: string; kind: string; flags: int; name: string; }
WireCastE :: struct { ss: int; slot: int; ax: f32; ay: f32; az: f32; seed: int; mode: int; }
WireHit :: struct { who: int; by: int; amt: int; kind: int; }

// ---- writing

wire_cm :: (v: f32) -> int { if !(v == v) || v > 1.0e7 || v < -1.0e7 { return 0; } return cast(int) floor(v * 100 + 0.5); }
wire_m :: (out: [] u8, at: int, v: f32) -> int { return wire_int(out, at, wire_cm(v)); }
// An angle in centiradians, wrapped to -pi..pi.
wire_cyaw :: (a: f32) -> int {
  w := a;
  if w == w && w < 1.0e6 && w > -1.0e6 { w = a - 6.2831853 * floor((a + 3.14159265) / 6.2831853); } else { w = 0; }
  return wire_cm(w);
}
wire_yaw :: (out: [] u8, at: int, a: f32) -> int { return wire_int(out, at, wire_cyaw(a)); }
wire_wrap :: (a: f32) -> f32 {
  if a == a && a < 1.0e6 && a > -1.0e6 { return a - 6.2831853 * floor((a + 3.14159265) / 6.2831853); }
  return 0;
}
// A heading in WIRE_FINE units, wrapped to -pi..pi.
wire_fine :: (a: f32) -> int { return cast(int) floor(wire_wrap(a) * f32(WIRE_FINE) + 0.5); }
// A stick or key, -1 to 1, as -100 to 100; and back.
wire_axis :: (v: f32) -> int { if !(v == v) { return 0; } return cast(int) floor(clamp_wire(v, -1, 1) * 100 + 0.5); }
clamp_wire :: (v: f32, lo_: f32, hi_: f32) -> f32 { return ifx v < lo_ then lo_ else ifx v > hi_ then hi_ else v; }

wire_put_hello :: (out: [] u8, at: int, h: WireHello) -> int {
  n := wire_int(out, wire_put(out, at, "H"), h.version);
  n = wire_text(out, n, h.look); n = wire_text(out, n, h.kind); n = wire_int(out, n, h.flags); n = wire_name(out, n, h.name);
  return n;
}
wire_put_pins :: (out: [] u8, at: int, p: WirePins) -> int {
  return wire_int(out, wire_int(out, wire_int(out, wire_put(out, at, "P"), p.engine), p.rules), p.content);
}
wire_put_in :: (out: [] u8, at: int, i: WireIn) -> int {
  n := wire_put(out, at, "I");
  n = wire_int(out, n, i.seq); n = wire_int(out, n, i.kx); n = wire_int(out, n, i.ky); n = wire_int(out, n, i.px); n = wire_int(out, n, i.py);
  n = wire_int(out, n, wire_fine(i.theta)); n = wire_int(out, n, i.b); n = wire_int(out, n, i.heard);   // the heading to 0.1 mrad: a room steps where its page did (#12718)
  return n;
}
wire_put_cast :: (out: [] u8, at: int, c: WireCast) -> int {
  n := wire_put(out, at, "C");
  n = wire_int(out, n, c.seq); n = wire_int(out, n, c.slot);
  n = wire_m(out, n, c.ax); n = wire_m(out, n, c.ay); n = wire_m(out, n, c.az); n = wire_int(out, n, c.tgt);
  if c.mode != 0 || c.view > 0 { n = wire_int(out, n, c.mode); }
  if c.view > 0 { n = wire_int(out, n, c.view % 1000000000); }
  return n;
}
wire_put_use :: (out: [] u8, at: int, u: WireUse) -> int {
  n := wire_put(out, at, "E");
  n = wire_int(out, n, u.seq); n = wire_int(out, n, u.kind); n = wire_int(out, n, u.id);
  return n;
}
wire_put_rebuild :: (out: [] u8, at: int, seq: int) -> int { return wire_int(out, wire_put(out, at, "R"), seq); }
// L SEQ: a Long Rest, in a room only between raids and out of combat (coax/web/room/room-everglade.coax eg_heard_rest).
wire_put_rest :: (out: [] u8, at: int, seq: int) -> int { return wire_int(out, wire_put(out, at, "L"), seq); }
// Z SEQ REQ: an Everglade II rest request (#13046, everglade/server/rest.coax): REQ 1 Short Rest,
// 2 sleep, 3 watch, 4 spend one Hit Die, 5 end (rules/srd/rest-control.coax RS_REST_*). The room
// decides from the body it steps; the page's word that it stands still is never asked for.
WireRestAsk :: struct { seq: int; req: int; }
wire_put_rest_ask :: (out: [] u8, at: int, a: WireRestAsk) -> int { return wire_int(out, wire_int(out, wire_put(out, at, "Z"), a.seq), a.req); }
wire_read_rest_ask :: (t: string, r: [] WireRd) -> WireRestAsk { a: WireRestAsk; a.seq = wire_num(t, r); a.req = wire_num(t, r); return a; }
// z SEQ CODE DICE: your rest as the room's rules hold it, to your seat only: SEQ the request it answers
// (0 a change the rules' clock made), CODE (WIRE_REST_*) and the Hit Dice left.
WIRE_REST_NONE :: 0; WIRE_REST_SHORT :: 1; WIRE_REST_CHOOSE :: 2; WIRE_REST_SLEEP :: 3; WIRE_REST_WATCH :: 4;
WIRE_REST_EXERT :: 5; WIRE_REST_BROKEN :: 6; WIRE_REST_DUE :: 7; WIRE_REST_CODES :: 8;
WireRestState :: struct { seq: int; code: int; dice: int; }
wire_put_rest_state :: (out: [] u8, at: int, z: WireRestState) -> int { return wire_int(out, wire_int(out, wire_int(out, wire_put(out, at, "z"), z.seq), z.code), z.dice); }
wire_read_rest_state :: (t: string, r: [] WireRd) -> WireRestState { z: WireRestState; z.seq = wire_num(t, r); z.code = wire_num(t, r); z.dice = wire_num(t, r); return z; }
#test "Z asks the room for a rest and z answers with the rules' state" {
  b: [64] u8; n := wire_put_rest_ask(b[..], 0, WireRestAsk.{seq = 41, req = 2}); #assert cast(string) b[0..<n] == "Z 41 2";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 1); a := wire_read_rest_ask(cast(string) b[0..<n], r[..]); #assert r[0].ok && a.seq == 41 && a.req == 2;
  n = wire_put_rest_state(b[..], 0, WireRestState.{seq = 0, code = WIRE_REST_SLEEP, dice = 3}); #assert cast(string) b[0..<n] == "z 0 3 3";
  r[0] = wire_rd(cast(string) b[0..<n], 1); z := wire_read_rest_state(cast(string) b[0..<n], r[..]); #assert r[0].ok && z.code == 3 && z.dice == 3;
  r[0] = wire_rd("z 4 1", 1); short := wire_read_rest_state("z 4 1", r[..]); #assert !r[0].ok;
}
// b N V ...: your bar as the room's rules hold it, to your seat only (#13046, Everglade II): for each
// of the N slots of your class's bar at your level, in its order (class-kit.coax xk_bar_at), V is
// (LEFT + 1) * 2 + ON: LEFT what it has left to count (fivebar.coax fb_left: slots at its level,
// uses, Rages, Focus; -1 nothing), at most WIRE_KIT_MOST; ON 1 while its own effect holds (a Rage,
// Wild Shape's form). Sent when it changes, and on every new socket.
WIRE_KIT :: 24; WIRE_KIT_MOST :: 99;
WireKit :: struct { n: int; v: [WIRE_KIT] int; }
wire_kit_v :: (left: int, on: bool) -> int { l := ifx left < -1 then -1 else ifx left > WIRE_KIT_MOST then WIRE_KIT_MOST else left; return (l + 1) * 2 + (ifx on then 1 else 0); }
wire_put_kit :: (out: [] u8, at: int, k: WireKit) -> int {
  n := wire_int(out, wire_put(out, at, "b"), k.n);
  for i: 0..<k.n { n = wire_int(out, n, k.v[i]); }
  return n;
}
wire_read_kit :: (t: string, r: [] WireRd) -> WireKit {
  k: WireKit; k.n = wire_num(t, r);
  if k.n < 0 || k.n > WIRE_KIT { r[0].ok = false; k.n = 0; return k; }
  for i: 0..<k.n { k.v[i] = wire_num(t, r); if k.v[i] < 0 || k.v[i] > (WIRE_KIT_MOST + 1) * 2 + 1 { r[0].ok = false; } }
  return k;
}
#test "b says your bar's counts and effects, slot by slot" {
  k: WireKit; k.n = 3; k.v[0] = wire_kit_v(-1, false); k.v[1] = wire_kit_v(2, true); k.v[2] = wire_kit_v(500, false);
  b: [128] u8; n := wire_put_kit(b[..], 0, k); #assert cast(string) b[0..<n] == "b 3 0 7 200";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 1); back := wire_read_kit(cast(string) b[0..<n], r[..]);
  #assert r[0].ok && back.n == 3 && back.v[1] == 7 && back.v[2] == 200;
  r[0] = wire_rd("b 2 4", 1); _x := wire_read_kit("b 2 4", r[..]); #assert !r[0].ok;
  r[0] = wire_rd("b 30 1", 1); _y := wire_read_kit("b 30 1", r[..]); #assert !r[0].ok;
  r[0] = wire_rd("b 1 202", 1); _z := wire_read_kit("b 1 202", r[..]); #assert !r[0].ok;
}
// K PID PID ...: the players you block, the whole list each time ("K -": none). The room never sends
// you them (coax/web/room/room-interest.coax, #12789). Start with wire_put_blocks, then a wire_text per id.
WIRE_BLOCKS :: 32;
wire_put_blocks :: (out: [] u8, at: int) -> int { return wire_put(out, at, "K"); }
wire_put_world :: (out: [] u8, at: int, w: WireWorld) -> int {
  n := wire_put(out, at, "W");
  n = wire_int(out, n, w.tick); n = wire_int(out, n, w.hz); n = wire_int(out, n, w.seed); n = wire_int(out, n, w.day); n = wire_int(out, n, w.weather);
  return wire_int(out, n, w.budget);
}
// The state's header, "D TICK ACK F PART "; its entries follow, wire_sep between them.
wire_sep :: (out: [] u8, at: int) -> int { return wire_put(out, at, ";"); }
wire_put_n :: (out: [] u8, at: int, w: WireN) -> int {
  n := wire_put(out, at, "n");
  n = wire_int(out, n, w.ss); n = wire_text(out, n, w.id); n = wire_text(out, n, w.look); n = wire_text(out, n, w.kind);
  n = wire_int(out, n, w.flags); n = wire_name(out, n, w.name);
  return n;
}
wire_put_x :: (out: [] u8, at: int, id: int) -> int { return wire_int(out, wire_put(out, at, "x"), id); }
wire_put_cast_e :: (out: [] u8, at: int, c: WireCastE) -> int {
  n := wire_put(out, at, "e cast");
  n = wire_int(out, n, c.ss); n = wire_int(out, n, c.slot); n = wire_m(out, n, c.ax); n = wire_m(out, n, c.ay); n = wire_m(out, n, c.az);
  n = wire_int(out, n, c.seed);
  if c.mode != 0 { n = wire_int(out, n, c.mode); }
  return n;
}
wire_put_hit :: (out: [] u8, at: int, h: WireHit) -> int {
  n := wire_put(out, at, "e hit");
  n = wire_int(out, n, h.who); n = wire_int(out, n, h.by); n = wire_int(out, n, h.amt); n = wire_int(out, n, h.kind);
  return n;
}
wire_put_heal :: (out: [] u8, at: int, who: int, amt: int) -> int { return wire_int(out, wire_int(out, wire_put(out, at, "e heal"), who), amt); }
wire_put_die :: (out: [] u8, at: int, who: int) -> int { return wire_int(out, wire_put(out, at, "e die"), who); }
wire_put_stop :: (out: [] u8, at: int, ss: int, slot: int, why: string) -> int { return wire_text(out, wire_int(out, wire_int(out, wire_put(out, at, "e stop"), ss), slot), why); }
wire_put_break :: (out: [] u8, at: int, pc: int, ix: f32, iy: f32, iz: f32) -> int {
  n := wire_int(out, wire_put(out, at, "e break"), pc);
  return wire_m(out, wire_m(out, wire_m(out, n, ix), iy), iz);
}
wire_put_burn :: (out: [] u8, at: int, pc: int, on: bool) -> int { return wire_int(out, wire_int(out, wire_put(out, at, "e burn"), pc), ifx on then 1 else 0); }
wire_put_rebuilt :: (out: [] u8, at: int) -> int { return wire_put(out, at, "e rebuild"); }
// The e entries that change the town for good (a page that misses one is wrong until the room sends the
// town again), as against cues, shown and gone (#12836, #12902).
WIRE_OUTCOMES :: [8] string.["break", "burn", "mend", "pgone", "pburn", "rebuild", "edit", "town"];
wire_outcome :: (t: string) -> bool {
  if t.count < 3 || t[0] != 'e' || t[1] != ' ' { return false; }
  j := 2; while j < t.count && t[j] != ' ' { j += 1; }
  for i: 0..<WIRE_OUTCOMES.count { if cast(string) t[2..<j] == WIRE_OUTCOMES[i] { return true; } }
  return false;
}
wire_put_town :: (out: [] u8, at: int) -> int { return wire_put(out, at, "e town"); }
wire_put_outcomes :: (out: [] u8, at: int, n: int) -> int { return wire_int(out, wire_put(out, at, "o"), n); }
wire_put_missed :: (out: [] u8, at: int, n: int) -> int { return wire_int(out, wire_put(out, at, "O"), n); }
// k RATE USED DROPPED EVERY: your link (#13178), once a second, to a page that reads packed rows: the
// bytes of rows a second it may be sent now, those it was sent and the rows that waited for want of
// them in the last second, and one tick in how many its rows go (1 every tick; more while it lags)
WireLink :: struct { rate: int; used: int; dropped: int; every: int; }
wire_put_link :: (out: [] u8, at: int, l: WireLink) -> int { return wire_int(out, wire_int(out, wire_int(out, wire_int(out, wire_put(out, at, "k"), l.rate), l.used), l.dropped), l.every); }
wire_read_link :: (t: string, r: [] WireRd) -> WireLink { l: WireLink; l.rate = wire_num(t, r); l.used = wire_num(t, r); l.dropped = wire_num(t, r); l.every = wire_num(t, r); return l; }
#test "k says a seat's link: its rate, the bytes and rows of the last second, and its spacing" {
  b: [64] u8; n := wire_put_link(b[..], 0, WireLink.{rate = 15000, used = 4210, dropped = 3, every = 2});
  #assert cast(string) b[0..<n] == "k 15000 4210 3 2";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 1);
  l := wire_read_link(cast(string) b[0..<n], r[..]);
  #assert r[0].ok && l.rate == 15000 && l.used == 4210 && l.dropped == 3 && l.every == 2;
}
// A X Y Z YAW: where you stand as you sit again (#13057).
WireAt :: struct { x: f32; y: f32; z: f32; yaw: f32; }
wire_put_at :: (out: [] u8, at: int, p: WireAt) -> int { return wire_yaw(out, wire_m(out, wire_m(out, wire_m(out, wire_put(out, at, "A"), p.x), p.y), p.z), p.yaw); }
wire_read_at :: (t: string, r: [] WireRd) -> WireAt { p: WireAt; p.x = wire_f(t, r); p.y = wire_f(t, r); p.z = wire_f(t, r); p.yaw = wire_f(t, r); return p; }
#test "A says where you stand as you sit again, in cm and centiradians" {
  b: [64] u8; n := wire_put_at(b[..], 0, WireAt.{x = 12.345, y = -0.5, z = -120.004, yaw = 3.5});
  #assert cast(string) b[0..<n] == "A 1235 -50 -12000 -278";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 1); p := wire_read_at(cast(string) b[0..<n], r[..]);
  #assert r[0].ok && abs(p.x - 12.35) < 0.001 && abs(p.z + 120.0) < 0.001 && abs(p.yaw + 2.78) < 0.001;
}
wire_put_rested :: (out: [] u8, at: int, seat: int) -> int { return wire_int(out, wire_put(out, at, "e rest"), seat); }
wire_put_edit :: (out: [] u8, at: int, version: int) -> int { return wire_int(out, wire_put(out, at, "e edit"), version); }
wire_put_wanted :: (out: [] u8, at: int, ss: int, level: int) -> int { return wire_int(out, wire_int(out, wire_put(out, at, "w"), ss), level); }
wire_put_go :: (out: [] u8, at: int, code: string) -> int { return wire_put(out, wire_put(out, at, "g "), code); }
wire_put_travel :: (out: [] u8, at: int, seq: int, code: string) -> int { return wire_text(out, wire_int(out, wire_put(out, at, "T"), seq), code); }
wire_put_refused :: (out: [] u8, at: int, seq: int, reason: string) -> int { return wire_text(out, wire_int(out, wire_put(out, at, "r"), seq), reason); }

// ---- the session's other frames (#13364): a writer and a reader each, so the room and the page
// share them and everglade-session-v7.json pins them. A reader starts past its head (wire_rd(t, 4)
// for "e xp", 1 for "V") and leaves ok unset on a missing or bad field.

// e xp SS AMOUNT: XP seat SS earned; e level SS LEVEL: its class's level went up
// (everglade/server/progress.coax ev_award). Both are aimed at that seat.
WireGain :: struct { ss: int; v: int; }
wire_put_xp :: (out: [] u8, at: int, g: WireGain) -> int { return wire_int(out, wire_int(out, wire_put(out, at, "e xp"), g.ss), g.v); }
wire_put_level :: (out: [] u8, at: int, g: WireGain) -> int { return wire_int(out, wire_int(out, wire_put(out, at, "e level"), g.ss), g.v); }
wire_read_gain :: (t: string, r: [] WireRd) -> WireGain { g: WireGain; g.ss = wire_num(t, r); g.v = wire_num(t, r); return g; }
// What seat SS's character has: the server's record of it (everglade/model/character.coax), aimed at
// that seat when it sits and when it changes (coax/web/room/room-items.coax; #13291, #13292). A page
// shows these and keeps no state of its own for them.
//   e quest SS QUEST STAGE      a quest's stage (content IDs, everglade/model/content.coax)
//   e item SS ITEM KIND SLOT    an item in the bag: its content kind and where it is worn (0 not worn, 1 to
//                               10 the record's slots in order); KIND 0: the item is gone
//   e coin SS COIN              the coin it holds
//   e say SS DIALOGUE           the dialogue line it was just told
//   e loot SS KIND              an item of this kind just dropped for it (its e item follows)
WireOwn :: struct { ss: int; a: int; b: int; c: int; }
WIRE_OWN :: [5] string.["e quest", "e item", "e coin", "e say", "e loot"];
WIRE_OWN_FIELDS :: [5] int.[2, 3, 1, 1, 1];   // the numbers after SS
WO_QUEST :: 0; WO_ITEM :: 1; WO_COIN :: 2; WO_SAY :: 3; WO_LOOT :: 4;
wire_put_own :: (out: [] u8, at: int, what: int, o: WireOwn) -> int {
  f := [3] int.[o.a, o.b, o.c];
  n := wire_int(out, wire_put(out, at, WIRE_OWN[what]), o.ss);
  for i: 0..<WIRE_OWN_FIELDS[what] { n = wire_int(out, n, f[i]); }
  return n;
}
// Which of them t is (-1 none), and its numbers (r after the head).
wire_own :: (t: string) -> int {
  for i: 0..<5 { if wire_is(t, WIRE_OWN[i]) { return i; } }
  return -1;
}
wire_read_own :: (t: string, r: [] WireRd, what: int) -> WireOwn {
  o: WireOwn; f: [3] int;
  o.ss = wire_num(t, r);
  for i: 0..<WIRE_OWN_FIELDS[what] { f[i] = wire_num(t, r); }
  o.a = f[0]; o.b = f[1]; o.c = f[2];
  return o;
}
#test "e quest, e item, e coin, e say, e loot: written and read back; a missing field is refused" {
  b: [64] u8; r: [1] WireRd;
  n := wire_put_own(b[..], 0, WO_QUEST, WireOwn.{ss = 3, a = 1, b = 8}); t := cast(string) b[0..<n];
  #assert t == "e quest 3 1 8" && wire_own(t) == WO_QUEST; r[0] = wire_rd(t, 7); q := wire_read_own(t, r[..], WO_QUEST); #assert r[0].ok && q.ss == 3 && q.a == 1 && q.b == 8 && q.c == 0;
  n = wire_put_own(b[..], 0, WO_ITEM, WireOwn.{ss = 2, a = 4107, b = 3, c = 2}); t = cast(string) b[0..<n];
  #assert t == "e item 2 4107 3 2" && wire_own(t) == WO_ITEM; r[0] = wire_rd(t, 6); im := wire_read_own(t, r[..], WO_ITEM); #assert r[0].ok && im.ss == 2 && im.a == 4107 && im.b == 3 && im.c == 2;
  n = wire_put_own(b[..], 0, WO_COIN, WireOwn.{ss = 0, a = 1250}); t = cast(string) b[0..<n]; #assert t == "e coin 0 1250" && wire_own(t) == WO_COIN;
  n = wire_put_own(b[..], 0, WO_SAY, WireOwn.{ss = 15, a = 2}); t = cast(string) b[0..<n]; #assert t == "e say 15 2" && wire_own(t) == WO_SAY;
  n = wire_put_own(b[..], 0, WO_LOOT, WireOwn.{ss = 1, a = 3}); t = cast(string) b[0..<n]; #assert t == "e loot 1 3" && wire_own(t) == WO_LOOT;
  r[0] = wire_rd(t, 6); l := wire_read_own(t, r[..], WO_LOOT); #assert r[0].ok && l.ss == 1 && l.a == 3;
  t = "e item 2 4107 3"; r[0] = wire_rd(t, 6); im = wire_read_own(t, r[..], WO_ITEM); #assert !r[0].ok;
  t = "e quest 3 1"; r[0] = wire_rd(t, 7); q = wire_read_own(t, r[..], WO_QUEST); #assert !r[0].ok;
  #assert wire_own("e xp 3 70") == -1 && wire_own("e questx 1 1 1") == -1 && wire_own("") == -1;
}
// w SS LEVEL: a seat's WANTED level (wire_put_wanted above).
WireWanted :: struct { ss: int; level: int; }
wire_read_wanted :: (t: string, r: [] WireRd) -> WireWanted { w: WireWanted; w.ss = wire_num(t, r); w.level = wire_num(t, r); return w; }
// L SEQ: Everglade's whole-heal rest (wire_put_rest above); an Everglade II room refuses it.
wire_read_rest :: (t: string, r: [] WireRd) -> int { return wire_num(t, r); }
// e rc ID K AX AY AZ SEED [FX FY FZ]: a raid creature's cast (made entity ID): the Warlock's slot K, or
// a hero's from EGE_K_HERO0 on, aimed at A (cm), played from SEED; F, when said, where it leaves the
// caster's hands (#12862).
WireRc :: struct { id: int; k: int; ax: f32; ay: f32; az: f32; seed: int; from: bool; fx: f32; fy: f32; fz: f32; }
wire_put_rc :: (out: [] u8, at: int, c: WireRc) -> int {
  n := wire_int(out, wire_int(out, wire_put(out, at, "e rc"), c.id), c.k);
  n = wire_int(out, wire_m(out, wire_m(out, wire_m(out, n, c.ax), c.ay), c.az), c.seed);
  if c.from { n = wire_m(out, wire_m(out, wire_m(out, n, c.fx), c.fy), c.fz); }
  return n;
}
wire_read_rc :: (t: string, r: [] WireRd) -> WireRc {
  c: WireRc;
  c.id = wire_num(t, r); c.k = wire_num(t, r); c.ax = wire_f(t, r); c.ay = wire_f(t, r); c.az = wire_f(t, r); c.seed = wire_num(t, r);
  if wire_more(t, r) { c.fx = wire_f(t, r); c.fy = wire_f(t, r); c.fz = wire_f(t, r); c.from = r[0].ok; }
  return c;
}
// e wm KIND CASTER FOE AX AY AZ BX BY BZ FLIGHT LIFE: a guard's spell leaves their hands at A for B
// (cm), flying FLIGHT ms and lasting LIFE ms (everglade-watch.coax watch_net_missile).
WireWm :: struct { kind: int; caster: int; foe: int; ax: f32; ay: f32; az: f32; bx: f32; by: f32; bz: f32; flight: int; life: int; }
wire_put_wm :: (out: [] u8, at: int, w: WireWm) -> int {
  n := wire_int(out, wire_int(out, wire_int(out, wire_put(out, at, "e wm"), w.kind), w.caster), w.foe);
  n = wire_m(out, wire_m(out, wire_m(out, n, w.ax), w.ay), w.az);
  n = wire_m(out, wire_m(out, wire_m(out, n, w.bx), w.by), w.bz);
  return wire_int(out, wire_int(out, n, w.flight), w.life);
}
wire_read_wm :: (t: string, r: [] WireRd) -> WireWm {
  w: WireWm;
  w.kind = wire_num(t, r); w.caster = wire_num(t, r); w.foe = wire_num(t, r);
  w.ax = wire_f(t, r); w.ay = wire_f(t, r); w.az = wire_f(t, r); w.bx = wire_f(t, r); w.by = wire_f(t, r); w.bz = wire_f(t, r);
  w.flight = wire_num(t, r); w.life = wire_num(t, r);
  return w;
}
// e mend CODE: a Repair stood CODE's pieces up (everglade-repair.coax). e pburn I ON: an admin's
// placed thing I alight (1) or out (0); e pgone I: it burnt through (everglade-placed-fire.coax).
// Outcomes all three (WIRE_OUTCOMES).
WirePlaced :: struct { i: int; on: int; }
wire_put_mend :: (out: [] u8, at: int, code: int) -> int { return wire_int(out, wire_put(out, at, "e mend"), code); }
wire_put_pburn :: (out: [] u8, at: int, p: WirePlaced) -> int { return wire_int(out, wire_int(out, wire_put(out, at, "e pburn"), p.i), p.on); }
wire_put_pgone :: (out: [] u8, at: int, i: int) -> int { return wire_int(out, wire_put(out, at, "e pgone"), i); }
wire_read_mend :: (t: string, r: [] WireRd) -> int { return wire_num(t, r); }
wire_read_pburn :: (t: string, r: [] WireRd) -> WirePlaced { p: WirePlaced; p.i = wire_num(t, r); p.on = wire_num(t, r); return p; }
wire_read_pgone :: (t: string, r: [] WireRd) -> int { return wire_num(t, r); }
// g KIND PHASE WAVE WAVES SECS LEFT STANDING SLAIN SQUARE WARDS ARCH OUTCOME FOLK LEVELS CAP [PLAYERS
// [FRONT TOWN CAPC CAPT]]: a raid's state, a D entry (the g CODE frame is wire_put_go's). PLAYERS and
// the siege's four (#12860) are said by newer rooms only.
WireRaid :: struct {
  kind: int; phase: int; wave: int; waves: int; secs: int; left: int; standing: int; slain: int; square: int;
  wards: int; arch: int; outcome: int; folk: int; levels: int; cap: int;
  players_said: bool; players: int;
  siege: bool; front: int; town: int; cap_c: int; cap_t: int;
}
wire_put_raid :: (out: [] u8, at: int, g: WireRaid) -> int {
  n := wire_int(out, wire_int(out, wire_int(out, wire_int(out, wire_int(out, wire_put(out, at, "g"), g.kind), g.phase), g.wave), g.waves), g.secs);
  n = wire_int(out, wire_int(out, wire_int(out, wire_int(out, wire_int(out, n, g.left), g.standing), g.slain), g.square), g.wards);
  n = wire_int(out, wire_int(out, wire_int(out, wire_int(out, wire_int(out, n, g.arch), g.outcome), g.folk), g.levels), g.cap);
  if !g.players_said && !g.siege { return n; }
  n = wire_int(out, n, g.players);
  if !g.siege { return n; }
  return wire_int(out, wire_int(out, wire_int(out, wire_int(out, n, g.front), g.town), g.cap_c), g.cap_t);
}
wire_read_raid :: (t: string, r: [] WireRd) -> WireRaid {
  g: WireRaid;
  g.kind = wire_num(t, r); g.phase = wire_num(t, r); g.wave = wire_num(t, r); g.waves = wire_num(t, r); g.secs = wire_num(t, r);
  g.left = wire_num(t, r); g.standing = wire_num(t, r); g.slain = wire_num(t, r); g.square = wire_num(t, r); g.wards = wire_num(t, r);
  g.arch = wire_num(t, r); g.outcome = wire_num(t, r); g.folk = wire_num(t, r); g.levels = wire_num(t, r); g.cap = wire_num(t, r);
  if wire_more(t, r) { g.players = wire_num(t, r); g.players_said = r[0].ok; }
  if wire_more(t, r) { g.front = wire_num(t, r); g.town = wire_num(t, r); g.cap_c = wire_num(t, r); g.cap_t = wire_num(t, r); g.siege = r[0].ok; }
  return g;
}
// v SS LEVEL XP CAP LO HI [REST]: your level and XP, a D entry to your seat: the XP cap and the level's
// band LO..HI; REST 1 while the room holds you resting (everglade-rest.coax), said by newer rooms.
WireYou :: struct { ss: int; level: int; xp: int; cap: int; lo: int; hi: int; rest_said: bool; rest: int; }
wire_put_you :: (out: [] u8, at: int, y: WireYou) -> int {
  n := wire_int(out, wire_int(out, wire_int(out, wire_put(out, at, "v"), y.ss), y.level), y.xp);
  n = wire_int(out, wire_int(out, wire_int(out, n, y.cap), y.lo), y.hi);
  return ifx y.rest_said then wire_int(out, n, y.rest) else n;
}
wire_read_you :: (t: string, r: [] WireRd) -> WireYou {
  y: WireYou;
  y.ss = wire_num(t, r); y.level = wire_num(t, r); y.xp = wire_num(t, r); y.cap = wire_num(t, r); y.lo = wire_num(t, r); y.hi = wire_num(t, r);
  if wire_more(t, r) { y.rest = wire_num(t, r); y.rest_said = r[0].ok; }
  return y;
}
// V LOOK KIND: Change character (everglade/client/net.coax e2n_change): your seat sits again as this look
// and class (everglade/server/input.coax eg_heard_change).
WireChange :: struct { look: string; kind: string; }
wire_put_change :: (out: [] u8, at: int, c: WireChange) -> int { return wire_text(out, wire_text(out, wire_put(out, at, "V"), c.look), c.kind); }
wire_read_change :: (t: string, r: [] WireRd) -> WireChange { c: WireChange; c.look = wire_word(t, r); c.kind = wire_word(t, r); return c; }
// X VERB [ARG] | X at XMM ZMM YAW: a local room's admin lines (everglade/server/admin.coax), from
// everglade/client/admin.coax. at: metres and radians x 1000; every other verb one word or none.
WIRE_X_HEAL :: "heal"; WIRE_X_GOD :: "god"; WIRE_X_KO :: "ko"; WIRE_X_AT :: "at"; WIRE_X_GUARD :: "guard"; WIRE_X_CLASS :: "class";
WireAdmin :: struct { verb: string; arg: string; x: int; z: int; yaw: int; }
wire_put_admin :: (out: [] u8, at: int, a: WireAdmin) -> int {
  n := wire_text(out, wire_put(out, at, "X"), a.verb);
  if a.verb == WIRE_X_AT { return wire_int(out, wire_int(out, wire_int(out, n, a.x), a.z), a.yaw); }
  return ifx a.arg.count > 0 then wire_text(out, n, a.arg) else n;
}
wire_read_admin :: (t: string, r: [] WireRd) -> WireAdmin {
  a: WireAdmin;
  a.verb = wire_word(t, r);
  if a.verb == WIRE_X_AT { a.x = wire_num(t, r); a.z = wire_num(t, r); a.yaw = wire_num(t, r); return a; }
  if wire_more(t, r) { a.arg = wire_word(t, r); }
  return a;
}
// K PID PID ...: the players a page blocks (wire_put_blocks above); "K -" none. At most WIRE_BLOCKS.
WireBlocks :: struct { n: int; id: [WIRE_BLOCKS] string; }
wire_read_blocks :: (t: string, r: [] WireRd) -> WireBlocks {
  b: WireBlocks;
  while b.n < WIRE_BLOCKS && wire_more(t, r) {
    w := wire_word(t, r);
    if w.count > 0 { b.id[b.n] = w; b.n += 1; }
  }
  return b;
}
#test "e xp, e level, w and L: written and read back; a missing field is refused" {
  b: [64] u8; n := wire_put_xp(b[..], 0, WireGain.{ss = 3, v = 70}); #assert cast(string) b[0..<n] == "e xp 3 70";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 4); g := wire_read_gain(cast(string) b[0..<n], r[..]); #assert r[0].ok && g.ss == 3 && g.v == 70;
  n = wire_put_level(b[..], 0, WireGain.{ss = 2, v = 4}); #assert cast(string) b[0..<n] == "e level 2 4";
  r[0] = wire_rd(cast(string) b[0..<n], 7); g = wire_read_gain(cast(string) b[0..<n], r[..]); #assert r[0].ok && g.ss == 2 && g.v == 4;
  r[0] = wire_rd("e xp 3", 4); _a := wire_read_gain("e xp 3", r[..]); #assert !r[0].ok;
  n = wire_put_wanted(b[..], 0, 5, 2); r[0] = wire_rd(cast(string) b[0..<n], 1); w := wire_read_wanted(cast(string) b[0..<n], r[..]); #assert r[0].ok && w.ss == 5 && w.level == 2;
  r[0] = wire_rd("w 5 x", 1); _b := wire_read_wanted("w 5 x", r[..]); #assert !r[0].ok;
  n = wire_put_rest(b[..], 0, 9); r[0] = wire_rd(cast(string) b[0..<n], 1); #assert wire_read_rest(cast(string) b[0..<n], r[..]) == 9 && r[0].ok;
}
#test "e rc and e wm: aims in cm, the hands' place only when said" {
  b: [128] u8; n := wire_put_rc(b[..], 0, WireRc.{id = 9, k = 0, ax = 4, ay = 1.5, az = 7, seed = 12345});
  #assert cast(string) b[0..<n] == "e rc 9 0 400 150 700 12345";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 4); c := wire_read_rc(cast(string) b[0..<n], r[..]); #assert r[0].ok && !c.from && c.id == 9 && c.seed == 12345 && c.ay == 1.5;
  n = wire_put_rc(b[..], 0, WireRc.{id = 77, k = 0, ax = 4, ay = 1.5, az = 7, seed = 12345, from = true, fx = 9, fy = 1.5, fz = 7});
  #assert cast(string) b[0..<n] == "e rc 77 0 400 150 700 12345 900 150 700";
  r[0] = wire_rd(cast(string) b[0..<n], 4); c = wire_read_rc(cast(string) b[0..<n], r[..]); #assert r[0].ok && c.from && c.fx == 9;
  r[0] = wire_rd("e rc 77 0 400 150 700 12345 900", 4); _a := wire_read_rc("e rc 77 0 400 150 700 12345 900", r[..]); #assert !r[0].ok;
  n = wire_put_wm(b[..], 0, WireWm.{kind = 2, caster = 5, foe = 1, ax = 1, ay = 2, az = -3, bx = 4, by = 0.5, bz = 6, flight = 800, life = 1200});
  #assert cast(string) b[0..<n] == "e wm 2 5 1 100 200 -300 400 50 600 800 1200";
  r[0] = wire_rd(cast(string) b[0..<n], 4); w := wire_read_wm(cast(string) b[0..<n], r[..]); #assert r[0].ok && w.caster == 5 && w.az == -3 && w.by == 0.5 && w.life == 1200;
  r[0] = wire_rd("e wm 2 5 1 100 200 -300 400 50 600 800", 4); _b := wire_read_wm("e wm 2 5 1 100 200 -300 400 50 600 800", r[..]); #assert !r[0].ok;
}
#test "e mend, e pburn, e pgone: the outcomes of placed things" {
  b: [64] u8; n := wire_put_mend(b[..], 0, 12); #assert cast(string) b[0..<n] == "e mend 12" && wire_outcome(cast(string) b[0..<n]);
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 6); #assert wire_read_mend(cast(string) b[0..<n], r[..]) == 12 && r[0].ok;
  n = wire_put_pburn(b[..], 0, WirePlaced.{i = 3, on = 1}); #assert cast(string) b[0..<n] == "e pburn 3 1" && wire_outcome(cast(string) b[0..<n]);
  r[0] = wire_rd(cast(string) b[0..<n], 7); p := wire_read_pburn(cast(string) b[0..<n], r[..]); #assert r[0].ok && p.i == 3 && p.on == 1;
  n = wire_put_pgone(b[..], 0, 4); #assert cast(string) b[0..<n] == "e pgone 4" && wire_outcome(cast(string) b[0..<n]);
  r[0] = wire_rd(cast(string) b[0..<n], 7); #assert wire_read_pgone(cast(string) b[0..<n], r[..]) == 4 && r[0].ok;
  r[0] = wire_rd("e pburn 3", 7); _a := wire_read_pburn("e pburn 3", r[..]); #assert !r[0].ok;
}
#test "g and v: the raid's state and your level, their later fields only when said" {
  b: [160] u8; g := WireRaid.{kind = 1, phase = 2, wave = 3, waves = 5, secs = 40, left = 6, standing = 7, slain = 8, square = 9, wards = 2, arch = 1, outcome = 0, folk = 11, levels = 1, cap = 6};
  n := wire_put_raid(b[..], 0, g); #assert cast(string) b[0..<n] == "g 1 2 3 5 40 6 7 8 9 2 1 0 11 1 6";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 1); back := wire_read_raid(cast(string) b[0..<n], r[..]); #assert r[0].ok && back.cap == 6 && back.folk == 11 && !back.players_said && !back.siege;
  g.players_said = true; g.players = 4; g.siege = true; g.front = 500; g.town = 2; g.cap_c = 1; g.cap_t = 3;
  n = wire_put_raid(b[..], 0, g); #assert cast(string) b[0..<n] == "g 1 2 3 5 40 6 7 8 9 2 1 0 11 1 6 4 500 2 1 3";
  r[0] = wire_rd(cast(string) b[0..<n], 1); back = wire_read_raid(cast(string) b[0..<n], r[..]); #assert r[0].ok && back.players == 4 && back.siege && back.front == 500 && back.cap_t == 3;
  r[0] = wire_rd("g 1 2 3", 1); _a := wire_read_raid("g 1 2 3", r[..]); #assert !r[0].ok;
  n = wire_put_you(b[..], 0, WireYou.{ss = 2, level = 3, xp = 900, cap = 2700, lo = 900, hi = 2700}); #assert cast(string) b[0..<n] == "v 2 3 900 2700 900 2700";
  n = wire_put_you(b[..], 0, WireYou.{ss = 2, level = 3, xp = 900, cap = 2700, lo = 900, hi = 2700, rest_said = true, rest = 1}); #assert cast(string) b[0..<n] == "v 2 3 900 2700 900 2700 1";
  r[0] = wire_rd(cast(string) b[0..<n], 1); y := wire_read_you(cast(string) b[0..<n], r[..]); #assert r[0].ok && y.rest_said && y.rest == 1 && y.xp == 900;
  r[0] = wire_rd("v 2 3 900", 1); _b := wire_read_you("v 2 3 900", r[..]); #assert !r[0].ok;
}
#test "V, X and K: Change character, the admin lines and your blocks" {
  b: [96] u8; n := wire_put_change(b[..], 0, WireChange.{look = "ranger.1.2.3", kind = "srd-fighter-6"}); #assert cast(string) b[0..<n] == "V ranger.1.2.3 srd-fighter-6";
  r: [1] WireRd; r[0] = wire_rd(cast(string) b[0..<n], 1); c := wire_read_change(cast(string) b[0..<n], r[..]); #assert r[0].ok && c.look == "ranger.1.2.3" && c.kind == "srd-fighter-6";
  r[0] = wire_rd("V ranger.1.2.3", 1); _a := wire_read_change("V ranger.1.2.3", r[..]); #assert !r[0].ok;
  n = wire_put_admin(b[..], 0, WireAdmin.{verb = WIRE_X_AT, x = 5000, z = -40000, yaw = 0}); #assert cast(string) b[0..<n] == "X at 5000 -40000 0";
  r[0] = wire_rd(cast(string) b[0..<n], 1); a := wire_read_admin(cast(string) b[0..<n], r[..]); #assert r[0].ok && a.verb == "at" && a.z == -40000;
  n = wire_put_admin(b[..], 0, WireAdmin.{verb = WIRE_X_GUARD, arg = "off"}); #assert cast(string) b[0..<n] == "X guard off";
  n = wire_put_admin(b[..], 0, WireAdmin.{verb = WIRE_X_HEAL}); #assert cast(string) b[0..<n] == "X heal";
  r[0] = wire_rd(cast(string) b[0..<n], 1); a = wire_read_admin(cast(string) b[0..<n], r[..]); #assert r[0].ok && a.verb == "heal" && a.arg.count == 0;
  r[0] = wire_rd("X at 5000 x 0", 1); _b := wire_read_admin("X at 5000 x 0", r[..]); #assert !r[0].ok;
  r[0] = wire_rd("K p-aa p-bb", 1); k := wire_read_blocks("K p-aa p-bb", r[..]); #assert r[0].ok && k.n == 2 && k.id[1] == "p-bb";
  r[0] = wire_rd("K -", 1); k = wire_read_blocks("K -", r[..]); #assert r[0].ok && k.n == 0;
}

// ---- reading (bounded: a missing or bad field sets ok false)

wire_f :: (t: string, r: [] WireRd) -> f32 { return f32(wire_num(t, r)) / 100; }

wire_read_hello :: (t: string, r: [] WireRd) -> WireHello {
  h: WireHello;
  h.version = wire_num(t, r);
  h.look = wire_word(t, r); h.kind = wire_word(t, r); h.flags = wire_num(t, r); h.name = wire_rest(t, r);
  return h;
}
wire_read_pins :: (t: string, r: [] WireRd) -> WirePins {
  p: WirePins;
  p.engine = wire_num(t, r); p.rules = wire_num(t, r); p.content = wire_num(t, r);
  return p;
}
wire_read_in :: (t: string, r: [] WireRd) -> WireIn {
  i: WireIn;
  i.seq = wire_num(t, r); i.kx = wire_num(t, r); i.ky = wire_num(t, r); i.px = wire_num(t, r); i.py = wire_num(t, r);
  i.theta = f32(wire_num(t, r)) / f32(WIRE_FINE); i.b = wire_num(t, r); i.heard = wire_num(t, r);
  return i;
}
wire_read_cast :: (t: string, r: [] WireRd) -> WireCast {
  c: WireCast;
  c.seq = wire_num(t, r); c.slot = wire_num(t, r);
  c.ax = wire_f(t, r); c.ay = wire_f(t, r); c.az = wire_f(t, r); c.tgt = wire_num(t, r);
  if wire_more(t, r) { c.mode = wire_num(t, r); }
  if wire_more(t, r) { c.view = wire_num(t, r); if c.view < 0 { r[0].ok = false; } }
  return c;
}
wire_read_use :: (t: string, r: [] WireRd) -> WireUse {
  u: WireUse;
  u.seq = wire_num(t, r); u.kind = wire_num(t, r); u.id = wire_num(t, r);
  return u;
}
wire_read_world :: (t: string, r: [] WireRd) -> WireWorld {
  w: WireWorld;
  w.tick = wire_num(t, r); w.hz = wire_num(t, r); w.seed = wire_num(t, r); w.day = wire_num(t, r); w.weather = wire_num(t, r);
  w.budget = wire_num(t, r);
  return w;
}
// The state's header; r is left at its entries.
wire_read_n :: (t: string, r: [] WireRd) -> WireN {
  w: WireN;
  w.ss = wire_num(t, r); w.id = wire_word(t, r); w.look = wire_word(t, r); w.kind = wire_word(t, r); w.flags = wire_num(t, r); w.name = wire_rest(t, r);
  return w;
}
wire_read_cast_e :: (t: string, r: [] WireRd) -> WireCastE {
  c: WireCastE;
  c.ss = wire_num(t, r); c.slot = wire_num(t, r); c.ax = wire_f(t, r); c.ay = wire_f(t, r); c.az = wire_f(t, r); c.seed = wire_num(t, r);
  if wire_more(t, r) { c.mode = wire_num(t, r); }
  return c;
}
wire_read_hit :: (t: string, r: [] WireRd) -> WireHit {
  h: WireHit;
  h.who = wire_num(t, r); h.by = wire_num(t, r); h.amt = wire_num(t, r); h.kind = wire_num(t, r);
  return h;
}
// A state's entries: how many there are past the header (at `from`), and the k-th, ';' apart.
wire_entries :: (t: string, from: int) -> int {
  i := from;
  while i < t.count && t[i] == ' ' { i += 1; }
  if i >= t.count { return 0; }
  n := 1;
  for q: i..<t.count { if t[q] == ';' { n += 1; } }
  return n;
}
wire_entry :: (t: string, from: int, k: int) -> string {
  i := from;
  while i < t.count && t[i] == ' ' { i += 1; }
  at := 0;
  while at < k && i < t.count { if t[i] == ';' { at += 1; } i += 1; }
  if at < k { return t[t.count..<t.count]; }
  e := i;
  while e < t.count && t[e] != ';' { e += 1; }
  return t[i..<e];
}

// ---- the replication model (#12783): rows, their deltas, the page's mirror, a seat's sends

WIRE_SF :: 23;                // a row's fields
WS_KIND :: 0; WS_X :: 1; WS_Y :: 2; WS_Z :: 3; WS_YAW :: 4; WS_VX :: 5; WS_VY :: 6; WS_VZ :: 7;
WS_G :: 8; WS_CLIP :: 9; WS_HP :: 10; WS_MAX :: 11; WS_COND :: 12; WS_OWNER :: 13; WS_P1 :: 14; WS_P2 :: 15;
WS_TEMP :: 16; WS_FORM :: 17; WS_CARRY :: 18; WS_T0 :: 19; WS_DUR :: 20;
// LIFE: which life of its id this is (wire_hist_put counts them; an id gone a tick and back is a new
// one, never drawn between the two). WARP: its jumps in this life (a teleport, a respawn), each drawn
// where it lands, never between.
WS_LIFE :: 21; WS_WARP :: 22;
WIRE_WARP_M :: 3.0;           // m: a move this far in one tick is a jump (WARP), not a walk
// entity ids: a seat SS, a townsperson WIRE_ID_FOLK + I, what the server made WIRE_ID_MADE + EID
WIRE_ID_FOLK :: 100000; WIRE_ID_MADE :: 200000;
WIRE_SLOTS :: FOREST_SLOTS;   // original 256 plus the forest's separate sparse slots (#12940)
// A zone's table (#13275): a zone seats up to WIRE_ZONE_SEATS (docs/decisions/0003-150-a-zone.md). Seats past the
// first WIRE_SEATS have their rows after the last slot of the layout above, so a room of WIRE_SEATS
// has the slots it always had. A table holds WireHist.slots of them: WIRE_SLOTS unless its zone says more.
// After those seats' rows come their familiars' (a seat's familiar is a row, #13276): wire_fam_slot.
WIRE_ZONE_SEATS :: 150; WIRE_ZMORE :: WIRE_ZONE_SEATS - WIRE_SEATS; WIRE_ZSLOTS :: WIRE_SLOTS + WIRE_ZMORE * 2;
#test "a page's mirror holds every slot of a zone" { #assert WIRE_MIRROR == WIRE_ZSLOTS; }
WIRE_BASES :: 16;             // ticks back a base may be; a page keeps each entity's last WIRE_BASES rows
WIRE_ACKS :: 32;              // ticks of sends a seat remembers for HEARD, a bit each
WIRE_RESEND :: 10;            // ticks a row or an x sent and not yet acknowledged waits before it goes again
WIRE_BUDGET :: 1000;          // bytes of rows a seat is sent a tick at most (30 KB/s); its own player's row and the x's on top
// The removals' own allowance (#12836): x's go from WIRE_LIFE_BUDGET bytes a tick, outside WIRE_BUDGET.
// An x past it waits for the next tick, and the slot's next entity waits behind it, so a page never
// holds a new entity's row before the x of the one it replaces. An x is about 9 bytes: 26 a tick.
WIRE_LIFE_BUDGET :: 240;
// The age bound (#12836): a visible entity whose row changed and has waited WIRE_MAX_AGE ticks goes
// ahead of the priority order, the oldest first, from WIRE_AGED_BUDGET bytes a tick of its own (not
// the ordinary budget's). A row is about 30 to 60 bytes, so at least 6 aged rows go a tick, and none
// of a seat's WIRE_SLOTS waits past WIRE_MAX_AGE + WIRE_SLOTS / 6 ticks (about 3.8 s) while the seat
// keeps up; a seat behind (budget 0) is sent none (#12837 owns its recovery).
WIRE_MAX_AGE :: 30;
WIRE_AGED_BUDGET :: 400;
WIRE_NEAR :: 10.0;            // m: an entity this far off gains half the priority it would at your feet
WIRE_MIRROR :: FOREST_SLOTS + (150 - 16) * 2;  // entities a page holds: a zone's slots (WIRE_ZSLOTS below; a check holds the two together)
WIRE_ROW :: 320;              // a row's bytes at most

// A row by name. Players: G bits (WG_*), CLIP the controller's act, HP MAX TEMP COND FORM, CARRY the
// controller's leftover step time (s). Townsfolk: G their mode, CLIP their clip, HP, P1 their index, Y how
// high over their feet they are. Creatures and zones: G their flags (1 while it runs; a raider's level in
// bits 8 and up), HP, OWNER the seat, P1 P2 as WK_* says. Effects (WK_EFFECT): OWNER, P1, P2, T0, DUR.
WireS :: struct {
  id: int; kind: int; x: f32; y: f32; z: f32; yaw: f32; vx: f32; vy: f32; vz: f32;
  g: int; clip: int; hp: int; max: int; cond: int; owner: int = -1; p1: int; p2: int; temp: int; form: int; carry: f32; t0: int; dur: int; life: int; warp: int;
}
WireSHead :: struct { id: int; back: int; }

wire_s32 :: (v: int) -> s32 { return cast(s32) (ifx v > 2000000000 then 2000000000 else ifx v < -2000000000 then -2000000000 else v); }
// A row's fields, whole (cm, cm/s, centiradians, tenths of a ms).
wire_s_pack :: (e: WireS, f: [] s32) {
  f[WS_KIND] = wire_s32(e.kind);
  f[WS_X] = wire_s32(wire_cm(e.x)); f[WS_Y] = wire_s32(wire_cm(e.y)); f[WS_Z] = wire_s32(wire_cm(e.z)); f[WS_YAW] = wire_s32(wire_cyaw(e.yaw));
  f[WS_VX] = wire_s32(wire_cm(e.vx)); f[WS_VY] = wire_s32(wire_cm(e.vy)); f[WS_VZ] = wire_s32(wire_cm(e.vz));
  f[WS_G] = wire_s32(e.g); f[WS_CLIP] = wire_s32(e.clip); f[WS_HP] = wire_s32(e.hp); f[WS_MAX] = wire_s32(e.max); f[WS_COND] = wire_s32(e.cond);
  f[WS_OWNER] = wire_s32(e.owner); f[WS_P1] = wire_s32(e.p1); f[WS_P2] = wire_s32(e.p2); f[WS_TEMP] = wire_s32(e.temp); f[WS_FORM] = wire_s32(e.form);
  f[WS_CARRY] = wire_s32(ifx e.carry == e.carry && e.carry < 100 && e.carry > -100 then cast(int) floor(e.carry * 10000 + 0.5) else 0);
  f[WS_T0] = wire_s32(e.t0); f[WS_DUR] = wire_s32(e.dur); f[WS_LIFE] = wire_s32(e.life); f[WS_WARP] = wire_s32(e.warp);
}
wire_s_unpack :: (id: int, f: [] s32) -> WireS {
  return WireS.{id = id, kind = cast(int) f[WS_KIND], x = f32(cast(int) f[WS_X]) / 100, y = f32(cast(int) f[WS_Y]) / 100, z = f32(cast(int) f[WS_Z]) / 100,
                yaw = f32(cast(int) f[WS_YAW]) / 100, vx = f32(cast(int) f[WS_VX]) / 100, vy = f32(cast(int) f[WS_VY]) / 100, vz = f32(cast(int) f[WS_VZ]) / 100,
                g = cast(int) f[WS_G], clip = cast(int) f[WS_CLIP], hp = cast(int) f[WS_HP], max = cast(int) f[WS_MAX], cond = cast(int) f[WS_COND],
                owner = cast(int) f[WS_OWNER], p1 = cast(int) f[WS_P1], p2 = cast(int) f[WS_P2], temp = cast(int) f[WS_TEMP], form = cast(int) f[WS_FORM],
                carry = f32(cast(int) f[WS_CARRY]) / 10000, t0 = cast(int) f[WS_T0], dur = cast(int) f[WS_DUR], life = cast(int) f[WS_LIFE], warp = cast(int) f[WS_WARP]};
}
// "s ID BACK MASK V V ...": the row `now` as a delta against `base` (BACK ticks back; zeros with BACK 0).
wire_put_s :: (out: [] u8, at: int, id: int, back: int, base: [] s32, now: [] s32) -> int {
  return wire_put_s_fields(out,at,id,back,base,now,(1<<WIRE_SF)-1);
}
wire_put_s_fields :: (out:[]u8,at:int,id:int,back:int,base:[]s32,now:[]s32,allowed:int)->int {
  d:=net_row_delta(WIRE_SF,allowed,base,now);
  if !d.ok {return at;}
  mask:=d.mask;
  n := wire_int(out, wire_put(out, at, "s"), id);
  n = wire_int(out, n, back); n = wire_int(out, n, mask);
  for q: 0..<WIRE_SF { if (mask & (1 << q)) != 0 { n = wire_int(out, n, cast(int) now[q] - cast(int) base[q]); } }
  return n;
}

// ---- packed rows (#13165): the same row, base and fields as "s", bit-packed. The fields are already
// quantized (cm, cm/s, centiradians, tenths of a ms), so a field's change is a small whole number: zig-
// zagged (0, -1, 1, -2 ... to 0, 1, 2, 3 ...) and written in groups of WIRE_PACK_GROUP bits, each with a
// bit after it saying whether another follows. A walker's step is 10 bits, not 3 or 4 characters and a
// space. The bits go six to a character of WIRE_B64 (URL-safe base64: no ';', '|', ' ' or newline, so the
// D frame and the relay's '|' joins carry it as text). A room sends them only to a page whose hello says
// it reads them (WIRE_HELLO_PACKED); any other page gets "s" rows, and a page reads both.
WIRE_HELLO_PACKED :: 8;
// A hello's FLAGS bit: its page reads and writes binary frames from here on (wire-table.coax, #13278).
WIRE_HELLO_BINARY :: WT_HELLO_BINARY;
WIRE_B64 :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
WIRE_PACK_ID :: 5; WIRE_PACK_GROUP :: 4; WIRE_PACK_BACK :: 4;   // bits: an id's group, a change's group, BACK (WIRE_BASES 16)
// MASK in two levels: which of five runs of fields changed (KIND to YAW, the velocity, G to COND, OWNER
// to FORM, CARRY to WARP), then each changed run's own bits; a walker's is 18 bits, not 23.
WIRE_PACK_RUNS :: 5; WIRE_PACK_RUN_AT :: [6] int.[0, 5, 8, 13, 18, WIRE_SF];
wire_bits_put_mask :: (w: [] WireBits, out: [] u8, mask: int) {
  runs := 0;
  for g: 0..<WIRE_PACK_RUNS { a := WIRE_PACK_RUN_AT[g]; k := WIRE_PACK_RUN_AT[g + 1] - a; if ((mask >> a) & ((1 << k) - 1)) != 0 { runs |= 1 << g; } }
  wire_bits_put(w, out, runs, WIRE_PACK_RUNS);
  for g: 0..<WIRE_PACK_RUNS { if (runs & (1 << g)) != 0 { a := WIRE_PACK_RUN_AT[g]; k := WIRE_PACK_RUN_AT[g + 1] - a; wire_bits_put(w, out, (mask >> a) & ((1 << k) - 1), k); } }
}
wire_bits_get_mask :: (w: [] WireBits, t: string) -> int {
  runs := wire_bits_get(w, t, WIRE_PACK_RUNS); mask := 0;
  for g: 0..<WIRE_PACK_RUNS {
    if (runs & (1 << g)) == 0 { continue; }
    a := WIRE_PACK_RUN_AT[g]; k := WIRE_PACK_RUN_AT[g + 1] - a; b := wire_bits_get(w, t, k);
    if b == 0 { w[0].ok = false; }   // a run said changed with none of its fields: not a row this writes
    mask |= b << a;
  }
  return mask;
}
WireBits :: struct { at: int; acc: int; n: int; ok: bool = true; }   // where in the text, the bits in hand and how many
wire_bits_put :: (w: [] WireBits, out: [] u8, v: int, k: int) {
  for i: 0..<k {
    w[0].acc = w[0].acc * 2 + ((v >> (k - 1 - i)) & 1); w[0].n += 1;
    if w[0].n == 6 { if w[0].at < out.count { out[w[0].at] = WIRE_B64[w[0].acc]; } else { w[0].ok = false; } w[0].at += 1; w[0].acc = 0; w[0].n = 0; }
  }
}
// v (0 or more) in groups of g bits, the lowest first, each followed by 1 if another comes
wire_bits_put_u :: (w: [] WireBits, out: [] u8, v: int, g: int) {
  x := ifx v < 0 then 0 else v; more := true;
  while more { wire_bits_put(w, out, x & ((1 << g) - 1), g); x = x >> g; more = x != 0; wire_bits_put(w, out, ifx more then 1 else 0, 1); }
}
wire_bits_flush :: (w: [] WireBits, out: [] u8) { if w[0].n > 0 { wire_bits_put(w, out, 0, 6 - w[0].n); } }
wire_zig :: (v: int) -> int { return ifx v >= 0 then v * 2 else -v * 2 - 1; }
wire_unzig :: (z: int) -> int { return ifx z % 2 == 0 then z / 2 else -(z + 1) / 2; }
wire_b64_value :: (c: u8) -> int {
  if c >= 'A' && c <= 'Z' { return cast(int) (c - 'A'); } if c >= 'a' && c <= 'z' { return cast(int) (c - 'a') + 26; }
  if c >= '0' && c <= '9' { return cast(int) (c - '0') + 52; } if c == '-' { return 62; } if c == '_' { return 63; }
  return -1;
}
wire_bits_get :: (w: [] WireBits, t: string, k: int) -> int {
  v := 0;
  for i: 0..<k {
    if w[0].n == 0 {
      c := ifx w[0].at < t.count then wire_b64_value(t[w[0].at]) else -1;
      if c < 0 { w[0].ok = false; return 0; }
      w[0].acc = c; w[0].n = 6; w[0].at += 1;
    }
    w[0].n -= 1; v = v * 2 + ((w[0].acc >> w[0].n) & 1);
  }
  return v;
}
wire_bits_get_u :: (w: [] WireBits, t: string, g: int) -> int {
  v := 0; shift := 0;
  while w[0].ok {
    if shift > 40 { w[0].ok = false; return 0; }   // past any field's change (a row's fields are 32 bits)
    v += wire_bits_get(w, t, g) << shift; shift += g;
    if wire_bits_get(w, t, 1) == 0 { break; }
  }
  return v;
}
// "SBITS": the row `now` against `base` (BACK ticks back; zeros with BACK 0), its `allowed` fields only.
wire_put_s_packed :: (out: [] u8, at: int, id: int, back: int, base: [] s32, now: [] s32, allowed: int) -> int {
  d := net_row_delta(WIRE_SF, allowed, base, now);
  if !d.ok || id < 0 || back < 0 || back >= WIRE_BASES || at + 1 > out.count { return at; }
  out[at] = 'S';
  w: [1] WireBits; w[0].at = at + 1;
  wire_bits_put_u(w[..], out, id, WIRE_PACK_ID);
  wire_bits_put(w[..], out, back, WIRE_PACK_BACK);
  wire_bits_put_mask(w[..], out, d.mask);
  for q: 0..<WIRE_SF { if (d.mask & (1 << q)) != 0 { wire_bits_put_u(w[..], out, wire_zig(cast(int) now[q] - cast(int) base[q]), WIRE_PACK_GROUP); } }
  wire_bits_flush(w[..], out);
  return ifx w[0].ok then w[0].at else at;
}
// A row as it came, either way: its id, its BACK, its MASK and each masked field's change.
WireRowIn :: struct { ok: bool; id: int; back: int; mask: int; d: [WIRE_SF] int; }
wire_read_row :: (t: string) -> WireRowIn {
  o: WireRowIn;
  if t.count < 2 { return o; }
  if t[0] == 's' {
    if t.count < 3 || t[1] != ' ' { return o; }
    r: [1] WireRd; r[0] = wire_rd(t, 1);
    h := wire_read_s_head(t, r[..]);
    o.id = h.id; o.back = h.back; o.mask = wire_num(t, r[..]);
    if !r[0].ok || o.mask < 0 || o.mask >= (1 << WIRE_SF) { return WireRowIn.{}; }
    for q: 0..<WIRE_SF { if (o.mask & (1 << q)) != 0 { o.d[q] = wire_num(t, r[..]); } }
    if !r[0].ok || wire_more(t, r[..]) { return WireRowIn.{}; }
    o.ok = true; return o;
  }
  if t[0] != 'S' { return o; }
  w: [1] WireBits; w[0].at = 1;
  o.id = wire_bits_get_u(w[..], t, WIRE_PACK_ID); o.back = wire_bits_get(w[..], t, WIRE_PACK_BACK); o.mask = wire_bits_get_mask(w[..], t);
  for q: 0..<WIRE_SF { if (o.mask & (1 << q)) != 0 { o.d[q] = wire_unzig(wire_bits_get_u(w[..], t, WIRE_PACK_GROUP)); } }
  // every character read, and the last one's spare bits zero
  if !w[0].ok || w[0].at != t.count || (w[0].acc & ((1 << w[0].n) - 1)) != 0 || o.id < 0 || o.back >= WIRE_BASES { return WireRowIn.{}; }
  o.ok = true; return o;
}
wire_read_s_head :: (t: string, r: [] WireRd) -> WireSHead {
  h: WireSHead;
  h.id = wire_num(t, r); h.back = wire_num(t, r);
  if h.id < 0 || h.back < 0 || h.back >= WIRE_BASES { r[0].ok = false; }
  return h;
}
// The rest of a row, its fields onto base into out.
wire_read_s_body :: (t: string, r: [] WireRd, base: [] s32, out: [] s32) {
  mask := wire_num(t, r);
  if mask < 0 || mask >= (1 << WIRE_SF) { r[0].ok = false; return; }
  for q: 0..<WIRE_SF {
    v := cast(int) base[q];
    if (mask & (1 << q)) != 0 { v += wire_num(t, r); }
    out[q] = wire_s32(v);
  }
  if wire_more(t, r) { r[0].ok = false; }
}

// ---- the page's side: what it holds of each entity

WireMEnt :: struct { live: bool; id: int; n: int; at: int; tick: [WIRE_BASES] int; f: [WIRE_BASES * WIRE_SF] s32; }
WireMirror :: struct {
  ents: [WIRE_MIRROR] WireMEnt;
  tick: int; part: int; whole: bool;   // the tick whose parts are coming, the part due next, all came and read so far
  heard: int;                          // the newest tick heard whole: I's HEARD
  bad: int;                            // rows it couldn't read (a base it doesn't hold)
  cleared: int;                        // snapshots
}
wire_mirror_find :: (m: [] WireMirror, id: int) -> int {
  for e: 0..<WIRE_MIRROR { if m[0].ents[e].live && m[0].ents[e].id == id { return e; } }
  return -1;
}
// A D's header: its part in order, or the tick isn't whole; a snapshot's first part forgets everything.
// True when it did.
// Everything the page held of the server's rows, forgotten: a new seat's are a new snapshot.
wire_mirror_forget :: (m: [] WireMirror) {
  for e: 0..<WIRE_MIRROR { m[0].ents[e].live = false; }
  m[0].heard = 0; m[0].tick = 0; m[0].part = 0; m[0].whole = false;
}
wire_mirror_d :: (m: [] WireMirror, d: WireD) -> bool {
  cleared := false;
  if (d.f & WIRE_F_OOB) != 0 { return false; }   // out of band (coax/web/room/room-wt.coax): its entries only, no part of a tick
  if d.part == 0 {
    m[0].tick = d.tick; m[0].whole = true;
    if (d.f & 1) != 0 { for e: 0..<WIRE_MIRROR { m[0].ents[e].live = false; } m[0].cleared += 1; cleared = true; }
  } else if d.tick != m[0].tick || d.part != m[0].part { m[0].tick = d.tick; m[0].whole = false; }
  m[0].part = d.part + 1;
  return cleared;
}
// After a D's entries: its tick is heard once its last part came, every part in order and read.
wire_mirror_end :: (m: [] WireMirror, d: WireD) {
  if (d.f & WIRE_F_OOB) != 0 { return; }
  if net_snapshot_received(m[0].heard,d.tick,m[0].tick,m[0].whole,(d.f&2)==0) {m[0].heard=d.tick;}
}
// A row ("s ...") at tick: its entity's place in the mirror, its newest row now this one; -1 unread.
// (an "s" or a packed "S")
wire_mirror_s :: (m: [] WireMirror, tick: int, t: string) -> int {
  h := wire_read_row(t);
  if !h.ok { m[0].whole = false; m[0].bad += 1; return -1; }
  e := wire_mirror_find(m, h.id);
  base: [WIRE_SF] s32;
  if h.back > 0 {
    // against the row it had BACK ticks ago
    q := -1;
    if e >= 0 { for j: 0..<m[0].ents[e].n { if m[0].ents[e].tick[j] == tick - h.back { q = j; } } }
    if q < 0 { m[0].whole = false; m[0].bad += 1; return -1; }
    for f: 0..<WIRE_SF { base[f] = m[0].ents[e].f[q * WIRE_SF + f]; }
  }
  row: [WIRE_SF] s32;
  for q: 0..<WIRE_SF { row[q] = wire_s32(cast(int) base[q] + (ifx (h.mask & (1 << q)) != 0 then h.d[q] else 0)); }
  if e < 0 {
    for j: 0..<WIRE_MIRROR { if !m[0].ents[j].live { e = j; break; } }
    if e < 0 { m[0].whole = false; m[0].bad += 1; return -1; }
    m[0].ents[e].live = true; m[0].ents[e].id = h.id; m[0].ents[e].n = 0; m[0].ents[e].at = 0;
  }
  en := m[0].ents[e..<e + 1];
  // the ring: its newest replaced when this tick's came again, else the oldest goes
  j := en[0].at;
  newest := (en[0].at + WIRE_BASES - 1) % WIRE_BASES;
  if en[0].n > 0 && en[0].tick[newest] == tick { j = newest; }
  else { en[0].at = (en[0].at + 1) % WIRE_BASES; if en[0].n < WIRE_BASES { en[0].n += 1; } }
  en[0].tick[j] = tick;
  for f: 0..<WIRE_SF { en[0].f[j * WIRE_SF + f] = row[f]; }
  return e;
}
wire_mirror_x :: (m: [] WireMirror, id: int) -> int {
  e := wire_mirror_find(m, id);
  if e >= 0 { m[0].ents[e].live = false; }
  return e;
}
// Entity e's newest row, by name.
wire_mirror_get :: (m: [] WireMirror, e: int) -> WireS {
  if e < 0 || e >= WIRE_MIRROR || !m[0].ents[e].live || m[0].ents[e].n == 0 { return WireS.{id = -1}; }
  j := (m[0].ents[e].at + WIRE_BASES - 1) % WIRE_BASES;
  return wire_s_unpack(m[0].ents[e].id, m[0].ents[e].f[j * WIRE_SF..<j * WIRE_SF + WIRE_SF]);
}
// The newest row of entity id (WireS id -1: none held).
wire_mirror_of :: (m: [] WireMirror, id: int) -> WireS { return wire_mirror_get(m, wire_mirror_find(m, id)); }
// One whole D frame for a check's mirror: its rows and x's read in; the frame's header, or tick -1.
wire_mirror_frame :: (m: [] WireMirror, t: string) -> WireD {
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  if t.count < 2 || t[0] != 'D' { return WireD.{tick = -1}; }
  d := wire_read_d(t, r[..]);
  if !r[0].ok { return WireD.{tick = -1}; }
  _ := wire_mirror_d(m, d);
  from := r[0].at;
  for k: 0..<wire_entries(t, from) {
    en := wire_entry(t, from, k);
    if (en.count > 2 && en[0] == 's' && en[1] == ' ') || (en.count > 1 && en[0] == 'S') { _2 := wire_mirror_s(m, d.tick, en); }
    else if en.count > 2 && en[0] == 'x' && en[1] == ' ' { rx: [1] WireRd; rx[0] = wire_rd(en, 1); id := wire_num(en, rx[..]); if rx[0].ok { _3 := wire_mirror_x(m, id); } }
  }
  wire_mirror_end(m, d);
  return d;
}

// ---- the server's side: a room's table of rows, and what each seat holds

// The room's rows, tick by tick (WIRE_BASES ticks of them): what every seat's rows are cut from.
WireHist :: struct {
  tick: [WIRE_BASES] int;                       // the tick each place in the ring holds
  id: [WIRE_BASES * WIRE_ZSLOTS] s32;            // each slot's entity then: its id + 1, 0 none
  f: [WIRE_BASES * WIRE_ZSLOTS * WIRE_SF] s32;
  // now's: where each is (m), its weight, and whether every seat hears it however far (a player)
  x: [WIRE_ZSLOTS] f32; y: [WIRE_ZSLOTS] f32; z: [WIRE_ZSLOTS] f32; w: [WIRE_ZSLOTS] f32; all: [WIRE_ZSLOTS] bool;
  life: [WIRE_ZSLOTS] s32 #counter; warp: [WIRE_ZSLOTS] s32 #counter;   // each slot's entity's LIFE and WARP now (wire_count_next only, #12927)
  // the next row of each slot is a new life (born: a new player in the seat, its id the same) or a
  // jump (cut: a teleport, a placing, a seat into or out of a boat, however short), as its world says (#12835)
  born: [WIRE_ZSLOTS] bool; cut: [WIRE_ZSLOTS] bool;
  last: [WIRE_ZSLOTS] s32;    // id + 1 of the entity the slot last held, kept through ticks it held none
  now: int;
  // a seat's frame's work lists (wire_seat_frame_look), kept here so no seat's send clears 25 KB of them each tick (#13278)
  sc_cand: [WIRE_ZSLOTS] int; sc_spawn: [WIRE_ZSLOTS] int; sc_mine: [WIRE_ZSLOTS] int; sc_order: [WIRE_ZSLOTS] int;
  slots: int = WIRE_SLOTS;   // the slots this table holds (WIRE_ZSLOTS at most): the layout's, and a zone's seats past WIRE_SEATS after them (#13275)
}
// LIFE and WARP run from 1 to WIRE_LIFE_MAX - 1 and then from 1 again: never 0 (no life yet), never
// past what a row's field holds (wire_s32), so they never stick at its clamp. A page only asks whether
// a row's LIFE or WARP is the one it holds, and a slot counts at most one a tick, so a number comes
// back in one slot only after WIRE_LIFE_MAX - 1 of them: over two years of a new life every tick. As
// metaverse-engine/core/entity.coax retires a slot before its generation would wrap, nothing here repeats while a
// page could still hold the number it repeats. The step is the named add_sat, so a debug and a release
// room count the same (#12927).
WIRE_LIFE_MAX :: 2000000000;
// The slot of seat s's row in a zone's table, and the seat whose row slot q holds (-1: not a seat's): the
// first WIRE_SEATS seats have the layout's first slots, the rest come after its last (WIRE_ZSLOTS, #13275).
wire_seat_slot :: (s: int) -> int { return ifx s < WIRE_SEATS then s else WIRE_SLOTS + s - WIRE_SEATS; }
// The slot of the familiar of a seat past WIRE_SEATS (the first WIRE_SEATS seats' have the layout's: seat.coax EG_SLOT_FAM).
wire_fam_slot :: (s: int) -> int { return WIRE_SLOTS + WIRE_ZMORE + s - WIRE_SEATS; }
wire_slot_seat :: (q: int) -> int { if q < 0 || q >= WIRE_SLOTS + WIRE_ZMORE { return -1; } if q < WIRE_SEATS { return q; } return ifx q >= WIRE_SLOTS then q - WIRE_SLOTS + WIRE_SEATS else -1; }
wire_count_next :: (c: int) -> int { n := add_sat(ifx c < 0 then 0 else c % WIRE_LIFE_MAX, 1); return ifx n >= WIRE_LIFE_MAX then 1 else n; }
// The table's lives begin at numbers of this room's own (#12835): a room made again, in this process
// or after a restart, never starts its slots' lives where an earlier room's were, so a page that
// rejoins never takes a new entity for the one it held (their ids and slots may be the same: the
// rules count their ids from 1 in each room). scope: what makes this room's numbers its own (the
// room's wall-clock start and its relay room); each slot's from it by a Park-Miller step.
wire_hist_scope :: (h: [] WireHist, scope: int) {
  a := (ifx scope < 0 then -scope else scope) % 2147483647;
  for q: 0..<WIRE_ZSLOTS {
    a = ((a + q * 7919 + 1) % 2147483647) * 48271 % 2147483647;
    h[0].life[q] = cast(s32) (a % (WIRE_LIFE_MAX - 1)); h[0].warp[q] = 0; h[0].last[q] = 0;
  }
}
// What the rules made (a creature, a pack, a frog, a wall, a zone) has an id of its own for all its
// life (the rules count them up and never give one twice in a room): a new id in the slot is a new
// life, the same id is the same life, though it was out of the table a tick (its ground unknown).
// Players and the town's people keep the tick-to-tick rule: their ids are their seats and indexes,
// so one gone a tick and back may be someone else, and a new player says so (wire_hist_born).
wire_made :: (kind: int) -> bool { return kind == WK_PACK || kind == WK_FROG || kind == WK_BEAST || (kind >= WK_STONE && kind <= WK_ZONE); }
// Slot q's next row begins a new life of its entity, though the id and the slot are the same (#12835).
wire_hist_born :: (h: [] WireHist, q: int) { if q >= 0 && q < WIRE_ZSLOTS { h[0].born[q] = true; } }
// Slot q's next row is a jump (WARP), however short: a page draws nothing between it and the last (#12835).
wire_hist_cut :: (h: [] WireHist, q: int) { if q >= 0 && q < WIRE_ZSLOTS { h[0].cut[q] = true; } }
// A new tick's table: empty until wire_hist_put fills it.
wire_hist_begin :: (h: [] WireHist, tick: int) {
  row := tick % WIRE_BASES;
  h[0].tick[row] = tick; h[0].now = tick;
  for q: 0..<h[0].slots { h[0].id[row * WIRE_ZSLOTS + q] = 0; }
}
// Entity e in slot q this tick, weighing w (wire_rel), heard by every seat however far (all). One
// whose velocity the world doesn't keep (moved) has it from where it was last tick, to 0.1 m/s, so a
// steady walker's stays the same row to row.
wire_hist_put :: (h: [] WireHist, q: int, e: WireS, w: f32, all: bool, moved: bool) {
  if q < 0 || q >= h[0].slots || e.id < 0 { return; }
  now := h[0].now; row := now % WIRE_BASES;
  m := e;
  // the same entity as last tick, or a new life of its id; and in one tick a walk, or a jump
  was := (now - 1 + WIRE_BASES) % WIRE_BASES;
  same := now > 0 && h[0].tick[was] == now - 1 && cast(int) h[0].id[was * WIRE_ZSLOTS + q] == e.id + 1;
  // the rules' own: the same life while the id is (wire_made); its velocity still only tick to tick
  life_same := ifx wire_made(e.kind) then cast(int) h[0].last[q] == e.id + 1 else same;
  dx := e.x - h[0].x[q]; dy := e.y - h[0].y[q]; dz := e.z - h[0].z[q];
  jump := life_same && (h[0].cut[q] || dx * dx + dy * dy + dz * dz > WIRE_WARP_M * WIRE_WARP_M);
  if !life_same || h[0].born[q] { same = false; jump = false; h[0].life[q] = cast(s32) wire_count_next(cast(int) h[0].life[q]); h[0].warp[q] = 0; }
  else if jump { same = false; h[0].warp[q] = cast(s32) wire_count_next(cast(int) h[0].warp[q]); }
  m.life = cast(int) h[0].life[q]; m.warp = cast(int) h[0].warp[q];
  h[0].born[q] = false; h[0].cut[q] = false;
  if moved && same && !jump {
    m.vx = wire_tenth(dx * f32(WIRE_HZ)); m.vy = wire_tenth(dy * f32(WIRE_HZ)); m.vz = wire_tenth(dz * f32(WIRE_HZ));
  }
  a := (row * WIRE_ZSLOTS + q) * WIRE_SF;
  wire_s_pack(m, h[0].f[a..<a + WIRE_SF]); wire_kind_keep(m.kind, h[0].f[a..<a + WIRE_SF]);
  h[0].id[row * WIRE_ZSLOTS + q] = wire_s32(e.id + 1); h[0].last[q] = wire_s32(e.id + 1);
  h[0].x[q] = e.x; h[0].y[q] = e.y; h[0].z[q] = e.z; h[0].w[q] = w; h[0].all[q] = all;
}
wire_tenth :: (v: f32) -> f32 { if v != v || v > 1000 || v < -1000 { return 0; } return f32(cast(int) floor(v * 10 + 0.5)) / 10; }
// Where in f slot q's row at tick t starts, when the table still holds it for that entity (id + 1); -1 not.
wire_hist_at :: (h: [] WireHist, t: int, q: int, id1: int) -> int {
  if t <= 0 || t > h[0].now || h[0].now - t >= WIRE_BASES { return -1; }
  row := t % WIRE_BASES;
  if h[0].tick[row] != t || cast(int) h[0].id[row * WIRE_ZSLOTS + q] != id1 { return -1; }
  return (row * WIRE_ZSLOTS + q) * WIRE_SF;
}
wire_rows_same :: (f: [] s32, a: int, b: int) -> bool {
  return wire_rows_same_fields(f,a,b,(1<<WIRE_SF)-1);
}
wire_rows_same_fields :: (f:[]s32,a:int,b:int,allowed:int)->bool {
  d:=net_row_delta(WIRE_SF,allowed,f[a..<a+WIRE_SF],f[b..<b+WIRE_SF]);
  return d.ok && d.mask==0;
}
// An entity's weight in priority, by its kind: players most, then creatures, zones and effects, townsfolk.
wire_rel :: (kind: int) -> f32 {
  if kind == WK_PLAYER { return 4; }
  if kind == WK_FOLK { return 1.5; }
  if kind == WK_BEAST || kind == WK_PACK || kind == WK_FROG || kind == WK_MONSTER || kind == WK_GUARD || kind == WK_FAMILIAR || kind == WK_MOUNT { return 3; }
  return 2;
}
// The one table of what each kind's row carries (#13276): a field outside its kind's mask is never
// written, so it never costs a byte or reaches a page. LIFE and WARP are the row layer's own, in every
// row. A kind from before the table (0 here) writes every field, as it always did.
WIRE_POSE :: (1 << WS_KIND) | (1 << WS_X) | (1 << WS_Y) | (1 << WS_Z) | (1 << WS_YAW) | (1 << WS_VX) | (1 << WS_VY) | (1 << WS_VZ) | (1 << WS_LIFE) | (1 << WS_WARP);
WIRE_KIND_MONSTER :: WIRE_POSE | (1 << WS_G) | (1 << WS_CLIP) | (1 << WS_HP) | (1 << WS_MAX) | (1 << WS_OWNER) | (1 << WS_P1) | (1 << WS_P2) | (1 << WS_T0);
WIRE_KIND_GUARD :: WIRE_POSE | (1 << WS_G) | (1 << WS_HP) | (1 << WS_MAX) | (1 << WS_OWNER) | (1 << WS_T0);
WIRE_KIND_FAMILIAR :: WIRE_POSE | (1 << WS_G) | (1 << WS_HP) | (1 << WS_MAX) | (1 << WS_OWNER) | (1 << WS_P1);
WIRE_KIND_MOUNT :: WIRE_POSE | (1 << WS_G) | (1 << WS_CLIP) | (1 << WS_OWNER) | (1 << WS_P1) | (1 << WS_P2) | (1 << WS_T0);
wire_kind_fields :: (kind: int) -> int {
  if kind == WK_MONSTER { return WIRE_KIND_MONSTER; }
  if kind == WK_GUARD { return WIRE_KIND_GUARD; }
  if kind == WK_FAMILIAR { return WIRE_KIND_FAMILIAR; }
  if kind == WK_MOUNT { return WIRE_KIND_MOUNT; }
  return (1 << WIRE_SF) - 1;
}
// A packed row keeps only its kind's fields: the others are as an empty row has them (OWNER -1, the rest 0).
wire_kind_keep :: (kind: int, f: [] s32) {
  m := wire_kind_fields(kind);
  if m == (1 << WIRE_SF) - 1 { return; }
  z: [WIRE_SF] s32;
  wire_s_pack(WireS.{}, z[..]);
  for q: 0..<WIRE_SF { if (m & (1 << q)) == 0 { f[q] = z[q]; } }
}
#test "wire (#13276): a kind's row carries its declared fields and no other" {
  all := WireS.{id = WIRE_ID_MADE + WIRE_MON_EID + 3, kind = WK_MONSTER, x = 1, y = 2, z = 3, yaw = 0.5, vx = 1, vy = 1, vz = 1, g = 1, clip = 2, hp = 7, max = 11, cond = 9, owner = WIRE_TGT_SEAT + 2,
                p1 = 3, p2 = 1, temp = 4, form = 5, carry = 0.5, t0 = 90, dur = 30};
  f: [WIRE_SF] s32;
  wire_s_pack(all, f[..]); wire_kind_keep(all.kind, f[..]);
  m := wire_s_unpack(all.id, f[..]);
  #assert m.id == all.id && m.kind == WK_MONSTER && m.x == 1 && m.z == 3 && m.g == 1 && m.clip == 2 && m.hp == 7 && m.max == 11 && m.owner == WIRE_TGT_SEAT + 2 && m.p1 == 3 && m.p2 == 1 && m.t0 == 90;
  #assert m.cond == 0 && m.temp == 0 && m.form == 0 && m.carry == 0 && m.dur == 0;
  all.kind = WK_GUARD;
  wire_s_pack(all, f[..]); wire_kind_keep(all.kind, f[..]);
  g := wire_s_unpack(all.id, f[..]);
  #assert g.kind == WK_GUARD && g.g == 1 && g.hp == 7 && g.owner == WIRE_TGT_SEAT + 2 && g.t0 == 90 && g.clip == 0 && g.p1 == 0 && g.p2 == 0 && g.cond == 0 && g.dur == 0;
  // a kind from before the table keeps every field
  all.kind = WK_BEAST;
  wire_s_pack(all, f[..]); wire_kind_keep(all.kind, f[..]);
  b := wire_s_unpack(all.id, f[..]); #assert b.cond == 9 && b.dur == 30 && b.form == 5 && b.clip == 2;
  #assert wire_kind_fields(WK_PLAYER) == (1 << WIRE_SF) - 1 && (WIRE_KIND_GUARD & (1 << WS_CLIP)) == 0 && (WIRE_KIND_MONSTER & (1 << WS_COND)) == 0;
  #assert wire_rel(WK_MONSTER) == 3 && wire_rel(WK_GUARD) == 3 && WIRE_MON_EID + WIRE_MONS <= WIRE_GUARD_EID;
  // a familiar's row: its place, its owner, its form, its Hit Points and whose senses; no act, no template, no times
  all.kind = WK_FAMILIAR; all.id = WIRE_ID_MADE + WIRE_FAM_EID + 2;
  wire_s_pack(all, f[..]); wire_kind_keep(all.kind, f[..]);
  fam := wire_s_unpack(all.id, f[..]);
  #assert fam.kind == WK_FAMILIAR && fam.x == 1 && fam.z == 3 && fam.g == 1 && fam.hp == 7 && fam.max == 11 && fam.owner == WIRE_TGT_SEAT + 2 && fam.p1 == 3;
  #assert fam.clip == 0 && fam.p2 == 0 && fam.t0 == 0 && fam.cond == 0 && fam.dur == 0 && fam.temp == 0;
  #assert wire_rel(WK_FAMILIAR) == 3 && WIRE_GUARD_EID < WIRE_FAM_EID && (WIRE_KIND_FAMILIAR & (1 << WS_T0)) == 0;
  all.id = WIRE_ID_MADE + WIRE_MON_EID + 3;
  // the table writes it so: a monster's row in the tick's table holds no COND, whatever it was handed
  h: [1] WireHist; all.kind = WK_MONSTER;
  wire_hist_begin(h[..], 1); wire_hist_put(h[..], 448, all, wire_rel(WK_MONSTER), false, true);
  #assert wire_test_row(h[..], 448, 1).cond == 0 && wire_test_row(h[..], 448, 1).hp == 7 && wire_test_row(h[..], 448, 1).life == 1;
}

// What one seat's page holds, as far as the server knows (all zeros: nothing; the C server's memory starts so).
WireSeat :: struct {
  allowed:[WIRE_ZSLOTS]int;wanted:[WIRE_ZSLOTS]int; // explicit last-sent and current recipient fields
  held: [WIRE_ZSLOTS] s32;     // id + 1 of what the page holds in each slot, 0 nothing
  base: [WIRE_ZSLOTS] int;     // the tick of the newest row of it the page acknowledged, 0 none
  sent: [WIRE_ZSLOTS] int;     // bit t % WIRE_ACKS: a row of it went out at tick t
  last: [WIRE_ZSLOTS] int;     // the tick its last row went out
  gone: [WIRE_ZSLOTS] s32;     // id + 1 of what is to go (x), until a tick that held the x is acknowledged
  gone_t: [WIRE_ZSLOTS] int;   // the tick that x last went out, 0 not yet
  // The slot's earlier x, still unacknowledged when the entity after it left too (#12900); the slot's
  // next row waits until it is acknowledged, so a slot never owes more than these two.
  gone2: [WIRE_ZSLOTS] s32; gone2_t: [WIRE_ZSLOTS] int;
  acc: [WIRE_ZSLOTS] f32;      // priority, gained each tick something is left to send
  since: [WIRE_ZSLOTS] int;    // the tick its row began waiting to go (changed, not yet sent), 0 none
  heard: int;                 // the newest tick acknowledged
  bytes: int;                 // this tick's rows' bytes (its own player's and the aged in them), for vitals
  left: int;                  // rows this tick left for a later one (the budget spent)
  aged: int;                  // rows this tick that went for their age (WIRE_MAX_AGE), and all of them so far
  aged_all: int;
  oldest: int;                // ticks the oldest row still waiting has waited, after this tick
  spaced: int;                // rows held back for their tier (wire_every), all so far
  packed: bool;               // its page reads packed rows (WIRE_HELLO_PACKED): its rows go as S (kept through wire_seat_reset)
  // its page reads binary frames (WIRE_HELLO_BINARY, #13278): its frame's rows are written as the table's runs
  // and its x's as the table's entries, each entry after its length (wire-table.coax); kept through wire_seat_reset
  bin: bool;
  rows: int;                  // rows written into this tick's frame
  // its updates are datagrams that can pass the reliable stream (a WebTransport seat, #13176): an
  // unacknowledged spawn's updates wait (metaverse-engine/net/spawn.coax); false, one ordered stream (kept through wire_seat_reset)
  datagrams: bool;
  rel: int;                   // this tick's frame's reliable lane: its first bytes (the x's and the spawns)
  spawn_wait: int;            // spawns this tick left for a later one (the budget spent), not dropped
}
// The codec retains its packed arrays; shared lifecycle decisions operate on one recipient/row.
wire_replica :: (st: [] WireSeat,q:int)->NetReplica {
  return NetReplica.{held=cast(int)st[0].held[q],base=st[0].base[q],sent=st[0].sent[q],last=st[0].last[q],
    gone=cast(int)st[0].gone[q],gone_t=st[0].gone_t[q],gone2=cast(int)st[0].gone2[q],gone2_t=st[0].gone2_t[q],
    priority=st[0].acc[q],since=st[0].since[q]};
}
wire_replica_set :: (st:[]WireSeat,q:int,r:NetReplica) {
  st[0].held[q]=wire_s32(r.held);st[0].base[q]=r.base;st[0].sent[q]=r.sent;st[0].last[q]=r.last;
  st[0].gone[q]=wire_s32(r.gone);st[0].gone_t[q]=r.gone_t;st[0].gone2[q]=wire_s32(r.gone2);st[0].gone2_t[q]=r.gone2_t;
  st[0].acc[q]=r.priority;st[0].since[q]=r.since;
}
wire_seat_reset :: (st: [] WireSeat) {
  for q:0..<WIRE_ZSLOTS {st[0].allowed[q]=0;st[0].wanted[q]=0;}
  for q: 0..<WIRE_ZSLOTS { st[0].held[q] = 0; st[0].base[q] = 0; st[0].sent[q] = 0; st[0].last[q] = 0; st[0].gone[q] = 0; st[0].gone_t[q] = 0; st[0].gone2[q] = 0; st[0].gone2_t[q] = 0; st[0].acc[q] = 0; st[0].since[q] = 0; }
  st[0].heard = 0; st[0].bytes = 0; st[0].left = 0; st[0].aged = 0; st[0].oldest = 0;
}
// The page heard tick `heard` whole (I's HEARD): what went out that tick is its own.
wire_seat_ack :: (st: [] WireSeat, h: [] WireHist, heard: int) {
  if !net_replica_ack_allowed(heard,st[0].heard,h[0].now,WIRE_ACKS) { return; }
  st[0].heard = heard;
  for q: 0..<h[0].slots {
    if st[0].sent[q]!=0 || st[0].gone[q]!=0 || st[0].gone2[q]!=0 {
      wire_replica_set(st,q,net_replica_ack(wire_replica(st,q),heard,WIRE_ACKS));
    }
  }
}
// Slot q's row now into out at `at`, against the newest row the page acknowledged when the table
// still has it; the seat notes it went out.
wire_seat_put :: (st: [] WireSeat, h: [] WireHist, q: int, out: [] u8, at: int) -> int {
  now := h[0].now; row := now % WIRE_BASES;
  id1 := cast(int) h[0].id[row * WIRE_ZSLOTS + q];
  if st[0].allowed[q]!=st[0].wanted[q] {
    wire_replica_set(st,q,net_replica_fields(wire_replica(st,q),st[0].allowed[q],st[0].wanted[q]));
  }
  cur := (row * WIRE_ZSLOTS + q) * WIRE_SF;
  b := ifx cast(int) st[0].held[q] == id1 then wire_hist_at(h, st[0].base[q], q, id1) else -1;
  zero: [WIRE_SF] s32;
  back := ifx b >= 0 then now - st[0].base[q] else 0;
  base := ifx b >= 0 then h[0].f[b..<b + WIRE_SF] else zero[..];
  n := at;
  if st[0].bin {
    // the row's bits, to a whole byte: one row of a run (wire-table.coax)
    d := net_row_delta(WIRE_SF, st[0].wanted[q], base, h[0].f[cur..<cur + WIRE_SF]);
    if d.ok && id1 > 0 && back >= 0 && back < WIRE_BASES {
      w: [1] WtW; w[0] = wt_w(at);
      wt_row_put(w[..], out, id1 - 1, back, d.mask, base, h[0].f[cur..<cur + WIRE_SF]); wt_put_pad(w[..], out);
      if w[0].ok { n = wt_end(w[..]); }
    }
  } else if st[0].packed { n = wire_put_s_packed(out, at, id1 - 1, back, base, h[0].f[cur..<cur + WIRE_SF], st[0].wanted[q]); }
  else { n = wire_put_s_fields(out, at, id1 - 1, back, base, h[0].f[cur..<cur + WIRE_SF], st[0].wanted[q]); }
  wire_replica_set(st,q,net_replica_sent(wire_replica(st,q),id1,now,WIRE_ACKS));
  st[0].allowed[q]=st[0].wanted[q];
  return n;
}
// How often an entity's row goes, in ticks (#13165): by its distance over its weight (wire_rel), so a
// player counts half as far as a zone and a townsperson a third farther. Within WIRE_EVERY_NEAR m of
// weighed distance every tick (30 Hz), within WIRE_EVERY_MID every second (15 Hz), past it every third
// (10 Hz): a third is a 100 ms step, inside the page's least interpolation delay (everglade/client/net-core.coax).
WIRE_EVERY_NEAR :: 24.0; WIRE_EVERY_MID :: 60.0;
// the fields a far row may wait on: where it is and how it moves (X Y Z YAW, the velocity, CARRY)
WIRE_MOTION :: (1 << WS_X) | (1 << WS_Y) | (1 << WS_Z) | (1 << WS_YAW) | (1 << WS_VX) | (1 << WS_VY) | (1 << WS_VZ) | (1 << WS_CARRY);
wire_every :: (d2: f32, w: f32) -> int {
  d := sqrt(ifx d2 > 0 then d2 else 0.0f32) * 2 / (ifx w > 0.5 then w else 0.5f32);
  return ifx d < f32(WIRE_EVERY_NEAR) then 1 else ifx d < f32(WIRE_EVERY_MID) then 2 else 3;
}
// Seat st's rows for this tick (h's newest) into out, ';' apart as D's entries: the x's it owes, its
// own player's row (slot me), then the rest by priority until `budget` bytes of rows are spent. Who
// sits at (px, pz) hears what is within `view` m, and every entity marked all. The bytes written.
wire_seat_frame :: (st: [] WireSeat, h: [] WireHist, me: int, px: f32, pz: f32, view: f32, budget: int, out: [] u8) -> int {
  row := h[0].now % WIRE_BASES;
  pick: [WIRE_ZSLOTS] f32;
  for q: 0..<h[0].slots {
    dx := h[0].x[q] - px; dz := h[0].z[q] - pz;
    pick[q] = ifx h[0].id[row * WIRE_ZSLOTS + q] != 0 && (h[0].all[q] || dx * dx + dz * dz <= view * view) then 0.0f32 else -1.0f32;
  }
  return wire_seat_frame_in(st, h, me, px, pz, pick[..], budget, out);
}
// The same, with what the seat may hear already picked (coax/web/room/room-interest.coax, #12789):
// pick[q] below 0, slot q isn't for this seat; WIRE_PICK_OWN and up, it goes with your own player,
// budget or not (your own effects); WIRE_PICK_ROOM and up, it gains that much priority more a tick
// (the room-wide ones: Darian, the ward stones, zones).
WIRE_PICK_OWN :: 4.0; WIRE_PICK_ROOM :: 2.0;
wire_seat_frame_in :: (st: [] WireSeat, h: [] WireHist, me: int, px: f32, pz: f32, pick: [] f32, budget: int, out: [] u8) -> int {
  fields:[WIRE_ZSLOTS]int;for q:0..<WIRE_ZSLOTS {fields[q]=(1<<WIRE_SF)-1;}
  return wire_seat_frame_fields(st,h,me,px,pz,pick,fields[..],budget,out);
}
wire_seat_frame_fields :: (st:[]WireSeat,h:[]WireHist,me:int,px:f32,pz:f32,pick:[]f32,fields:[]int,budget:int,out:[]u8)->int {
  none: [1] int;
  return wire_seat_frame_look(st, h, me, px, pz, pick, fields, WireLook.{}, none[0..<0], budget, out);
}
// What a seat's client says it looks at (#13178): its camera's forward on the ground (0, 0 not said:
// everything counts as in view). Each slot's combat with the seat (metaverse-engine/net/budget.coax
// NET_COMBAT_*) comes beside it, -1 or missing none.
WireLook :: struct { fx: f32; fz: f32; }
// The same, with the seat's view and each slot's combat weighing what waits (metaverse-engine/net/budget.coax
// net_priority). The frame is two lanes, the reliable first: the x's the seat owes and the spawns
// (metaverse-engine/net/spawn.coax: a row of an entity whose spawn the page hasn't acknowledged, absolute,
// carrying its identity); st's rel holds that lane's bytes, the start of out. Then the updates: its
// own player's row, what is on it, those that waited WIRE_MAX_AGE ticks, and the rest by priority.
// On a seat whose updates are datagrams (st's datagrams), nothing of an unacknowledged spawn goes but
// the spawn again, every WIRE_RESEND ticks; on one ordered stream (a WebSocket) a changed row of it
// goes at once, as a spawn. Spawns and updates share `budget`, spawns first; on a tick with no budget
// (behind, or a tick the link skips) only the x's, its own row and what is on it go, and the rest
// wait with their priority and age, never queued.
// The lesser of a row's budget and what out still holds: a row is noted sent only when it is written.
WIRE_TRY_MISSES :: 16;   // rows in a row that did not fit a seat's budget before the rest wait unwritten (wire_seat_frame_look)
wire_fit :: (budget: int, left: int) -> int { return ifx budget < left then budget else left; }
// A seat's frame being written (wire_seat_frame_look): its bytes so far and its rows. Text: entries ';'
// apart. Binary (#13278): each entry after its length, as a D holds them (wire-table.coax); rows next to
// each other go into one run, begun with two bytes kept for its length and closed when another entry
// follows, the frame ends, or it would pass WIRE_RUN bytes (so a D's parts can be cut between runs).
WIRE_RUN :: 1024;
WireOut :: struct { n: int; bin: bool; run: int; rows: int; }
// What out still holds for a row: a text row's separator, or a run's first three bytes, kept back.
wire_out_room :: (wo: [] WireOut, out: [] u8) -> int { return out.count - wo[0].n - (ifx wo[0].bin then 4 else 1); }
wire_out_close :: (wo: [] WireOut, out: [] u8) {
  if wo[0].run < 0 { return; }
  size := wo[0].n - (wo[0].run + 2);
  out[wo[0].run] = cast(u8) (128 + size / 256); out[wo[0].run + 1] = cast(u8) (size % 256);
  wo[0].run = -1;
}
// One row's bytes (wire_seat_put's) into the frame.
wire_out_row :: (wo: [] WireOut, out: [] u8, row: string) {
  if row.count == 0 { return; }
  n := wo[0].n;
  if !wo[0].bin {
    if n > 0 { n = wire_sep(out, n); }
  } else {
    if wo[0].run >= 0 && n - (wo[0].run + 2) + row.count > WIRE_RUN { wire_out_close(wo, out); }
    if wo[0].run < 0 { wo[0].run = n; out[n + 2] = cast(u8) (WT_BIN + WT_ROWS); n += 3; }
  }
  for i: 0..<row.count { out[n + i] = row[i]; }
  wo[0].n = n + row.count; wo[0].rows += 1;
}
// An x's bytes in the frame, its separator or length among them (e: scratch).
wire_out_x_size :: (wo: [] WireOut, e: [] u8, id: int) -> int {
  if !wo[0].bin { return wire_put_x(e, 0, id) + 1; }
  w: [1] WtW; w[0] = wt_w(0); wt_put_u(w[..], e, id, 8);
  return wt_end(w[..]) + 2;
}
wire_out_x :: (wo: [] WireOut, out: [] u8, id: int) {
  n := wo[0].n;
  if !wo[0].bin {
    if n > 0 { n = wire_sep(out, n); }
    wo[0].n = wire_put_x(out, n, id);
    return;
  }
  wire_out_close(wo, out);
  out[n + 1] = cast(u8) (WT_BIN + WT_X);
  w: [1] WtW; w[0] = wt_w(n + 2); wt_put_u(w[..], out, id, 8);
  end := wt_end(w[..]);
  out[n] = cast(u8) (end - (n + 1));
  wo[0].n = end;
}
wire_seat_frame_look :: (st:[]WireSeat,h:[]WireHist,me:int,px:f32,pz:f32,pick:[]f32,fields:[]int,look:WireLook,combat:[]int,budget:int,out:[]u8)->int {
  now := h[0].now; row := now % WIRE_BASES;
  e: [WIRE_ROW] u8;
  wo: [1] WireOut; wo[0].bin = st[0].bin; wo[0].run = -1;
  life := 0;   // this tick's x bytes (WIRE_LIFE_BUDGET)
  cand := h[0].sc_cand[..]; cn := 0;
  spawn := h[0].sc_spawn[..]; sn := 0;
  mine := h[0].sc_mine[..]; mn := 0;
  ordered := !st[0].datagrams;
  for q: 0..<h[0].slots {
    id1 := cast(int) h[0].id[row * WIRE_ZSLOTS + q];
    // a slot that holds nothing and that this seat holds, was sent and is owed nothing of: nothing to do
    // (most of a zone's 780 slots for most of its 150 seats, #13278)
    if id1 == 0 && st[0].held[q] == 0 && st[0].sent[q] == 0 && st[0].gone[q] == 0 && st[0].gone2[q] == 0 { st[0].since[q] = 0; continue; }
    if id1!=0 || st[0].held[q]!=0 {st[0].wanted[q]=ifx q<fields.count then fields[q] else 0;}
    dx := h[0].x[q] - px; dz := h[0].z[q] - pz; d2 := dx * dx + dz * dz;
    pk := ifx q < pick.count then pick[q] else -1.0f32;
    seen := id1 != 0 && st[0].wanted[q]!=0 && (q == me || pk >= 0);
    if st[0].held[q]!=0 || st[0].sent[q]!=0 {
      wire_replica_set(st,q,net_replica_observe(wire_replica(st,q),id1,seen,now,WIRE_ACKS));
    }
    // the despawns owed, on the reliable lane, again until a tick that held them is acknowledged
    if net_despawn_due(cast(int) st[0].gone2[q], st[0].gone2_t[q], now, WIRE_RESEND) {
      m := wire_out_x_size(wo[..], e[..], cast(int) st[0].gone2[q] - 1);
      if life + m <= WIRE_LIFE_BUDGET && wo[0].n + m < out.count {
        wire_out_x(wo[..], out, cast(int) st[0].gone2[q] - 1);
        st[0].gone2_t[q] = now; life += m;
      }
    }
    if net_despawn_due(cast(int) st[0].gone[q], st[0].gone_t[q], now, WIRE_RESEND) {
      m := wire_out_x_size(wo[..], e[..], cast(int) st[0].gone[q] - 1);
      if life + m <= WIRE_LIFE_BUDGET && wo[0].n + m < out.count {
        wire_out_x(wo[..], out, cast(int) st[0].gone[q] - 1);
        st[0].gone_t[q] = now; life += m;
      }
    }
    if !seen || q == me { st[0].since[q] = 0; continue; }
    r := wire_replica(st,q);
    if !net_replica_ready(r) { continue; }
    cur := (row * WIRE_ZSLOTS + q) * WIRE_SF;
    // the page has it as it is now: nothing to send
    if cast(int) st[0].held[q] == id1 && st[0].allowed[q]==st[0].wanted[q] {
      b := wire_hist_at(h, st[0].base[q], q, id1);
      if b >= 0 && wire_rows_same_fields(h[0].f[..],b,cur,st[0].wanted[q]) { st[0].acc[q] = 0; st[0].since[q] = 0; continue; }
      // sent as it is now and on its way: it waits for the page's word
      l := wire_hist_at(h, st[0].last[q], q, id1);
      if l >= 0 && now - st[0].last[q] < WIRE_RESEND && wire_rows_same_fields(h[0].f[..],l,cur,st[0].wanted[q]) { continue; }
    }
    // an unacknowledged spawn on datagrams: only the spawn again, each WIRE_RESEND ticks
    if !net_row_may_go(r, id1, now, WIRE_RESEND, ordered) { if st[0].since[q] == 0 { st[0].since[q] = now; } continue; }
    if pk >= f32(WIRE_PICK_OWN) { mine[mn] = q; mn += 1; continue; }
    is_spawn := net_spawn_row(r, id1) || st[0].allowed[q] != st[0].wanted[q];
    // a far one the page holds, whose only change since its last row is where it is and how it moves,
    // goes less often (#13165): it waits out its tier's ticks since that row. Anything else (its HP, a
    // condition, a fire, its clip, a new life) goes at once. Its age still counts toward WIRE_MAX_AGE,
    // and its next row goes against what the page acknowledged.
    if !is_spawn && cast(int) st[0].held[q] == id1 && st[0].last[q] > 0 && now - st[0].last[q] < wire_every(d2, h[0].w[q]) {
      l := wire_hist_at(h, st[0].last[q], q, id1);
      if l >= 0 && (net_row_delta(WIRE_SF, (1 << WIRE_SF) - 1, h[0].f[l..<l + WIRE_SF], h[0].f[cur..<cur + WIRE_SF]).mask & (((1 << WIRE_SF) - 1) ^ WIRE_MOTION)) == 0 {
        if st[0].since[q] == 0 { st[0].since[q] = now; }
        st[0].spaced += 1; continue;
      }
    }
    vx := f32(cast(int) h[0].f[cur + WS_VX]) / 100; vz := f32(cast(int) h[0].f[cur + WS_VZ]) / 100;
    st[0].acc[q] += net_priority(NetPrio.{weight = h[0].w[q], d2 = d2, view = net_in_view(look.fx, look.fz, dx, dz),
                                          combat = ifx q < combat.count && combat[q] > 0 then combat[q] else 0,
                                          speed = sqrt(vx * vx + vz * vz), age = ifx st[0].last[q] > 0 then now - st[0].last[q] else 0})
                    + (ifx pk >= f32(WIRE_PICK_ROOM) then pk else 0.0f32);
    if st[0].since[q] == 0 { st[0].since[q] = now; }
    if is_spawn { spawn[sn] = q; sn += 1; } else { cand[cn] = q; cn += 1; }
  }
  wrote := 0; spent := 0; left := 0; oldest := 0;
  st[0].spawn_wait = 0;
  // the reliable lane: the spawns. Your own player's (and what is on you) whatever the budget, then
  // the others', the aged first, from the budget; one that doesn't fit waits with its age
  own_live := me >= 0 && me < h[0].slots && st[0].wanted[me]!=0 && h[0].id[row * WIRE_ZSLOTS + me] != 0 && net_replica_ready(wire_replica(st,me));
  own_spawn := own_live && net_spawn_row(wire_replica(st,me), cast(int) h[0].id[row * WIRE_ZSLOTS + me]);
  if own_spawn {
    m := wire_seat_put(st, h, me, e[..], 0); wire_out_row(wo[..], out, cast(string) e[0..<m]); wrote += m;
  }
  for c: 0..<mn {
    q := mine[c];
    if !net_spawn_row(wire_replica(st,q), cast(int) h[0].id[row * WIRE_ZSLOTS + q]) { continue; }
    m := wire_seat_put_try(st, h, q, e[..], wire_out_room(wo[..], out));   // (never noted sent when out can't hold it)
    if m <= 0 || m > wire_out_room(wo[..], out) { continue; }
    wire_out_row(wo[..], out, cast(string) e[0..<m]); wrote += m;
  }
  order := h[0].sc_order[..];
  room := WIRE_AGED_BUDGET;   // the aged rows' own bytes, spawns' and updates' alike
  st[0].aged = 0;
  if budget > 0 && sn > 0 {
    sa := net_order(st[0].acc[..], st[0].since[..], spawn[..], sn, now, WIRE_MAX_AGE, order[..]);
    for c: 0..<sn {
      q := order[c];
      m := ifx c < sa then wire_seat_put_try(st, h, q, e[..], wire_fit(room, wire_out_room(wo[..], out))) else 0;
      if m > 0 { room -= m; st[0].aged += 1; }
      else { m = wire_seat_put_try(st, h, q, e[..], wire_fit(budget - spent, wire_out_room(wo[..], out))); spent += m; }
      if m <= 0 || m > wire_out_room(wo[..], out) { st[0].spawn_wait += 1; if now - st[0].since[q] > oldest { oldest = now - st[0].since[q]; } continue; }
      wire_out_row(wo[..], out, cast(string) e[0..<m]); wrote += m;
    }
  } else {
    st[0].spawn_wait = sn;
    for c: 0..<sn { if now - st[0].since[spawn[c]] > oldest { oldest = now - st[0].since[spawn[c]]; } }
  }
  wire_out_close(wo[..], out);   // (the reliable lane ends on an entry's edge)
  st[0].rel = wo[0].n;
  // the updates: your own player first, every tick: its row with the ACK is where your page re-runs from
  if own_live && !own_spawn {
    m := wire_seat_put(st, h, me, e[..], 0); wire_out_row(wo[..], out, cast(string) e[0..<m]); wrote += m;
  }
  // then what is on you (your effects), budget or not
  for c: 0..<mn {
    q := mine[c];
    if st[0].last[q] == now { continue; }   // gone as a spawn
    m := wire_seat_put_try(st, h, q, e[..], wire_out_room(wo[..], out));
    if m <= 0 || m > wire_out_room(wo[..], out) { continue; }
    wire_out_row(wo[..], out, cast(string) e[0..<m]); wrote += m;
  }
  // those that waited WIRE_MAX_AGE ticks, the oldest first, from their own bytes; then the rest by
  // priority, as long as each fits what the spawns, your own row and what is on you left of the budget
  pre := wrote - spent - (WIRE_AGED_BUDGET - room);
  aged := ifx budget > 0 then net_order(st[0].acc[..], st[0].since[..], cand[..], cn, now, WIRE_MAX_AGE, order[..]) else 0;
  if budget > 0 {
    for c: 0..<aged {
      m := wire_seat_put_try(st, h, order[c], e[..], wire_fit(room, wire_out_room(wo[..], out)));
      if m <= 0 || m > wire_out_room(wo[..], out) { continue; }
      wire_out_row(wo[..], out, cast(string) e[0..<m]); wrote += m; room -= m; st[0].aged += 1;
    }
    st[0].aged_all += st[0].aged;
  }
  // A row is written to learn whether it fits. In a crowd most of a seat's rows don't (150 players in
  // one place: 135 rows waiting on 500 bytes), so once WIRE_TRY_MISSES in a row did not fit, the rest
  // wait unwritten: they are lower in priority, and the bytes left are too few (#13275).
  misses := 0;
  for c: 0..<cn {
    q := ifx budget > 0 then order[c] else cand[c];
    if st[0].last[q] == now { continue; }   // gone for its age
    m := ifx misses >= WIRE_TRY_MISSES then 0 else wire_seat_put_try(st, h, q, e[..], wire_fit(budget - pre - spent, wire_out_room(wo[..], out)));
    if m <= 0 || m > wire_out_room(wo[..], out) { misses += 1; left += 1; if now - st[0].since[q] > oldest { oldest = now - st[0].since[q]; } continue; }
    misses = 0;
    wire_out_row(wo[..], out, cast(string) e[0..<m]); wrote += m; spent += m;
  }
  wire_out_close(wo[..], out);
  st[0].bytes = wrote; st[0].left = left; st[0].oldest = oldest; st[0].rows = wo[0].rows;
  return wo[0].n;
}
// Slot q's row into e, if it is at most `room` bytes (and so sent): its bytes, else 0 and nothing noted.
wire_seat_put_try :: (st: [] WireSeat, h: [] WireHist, q: int, e: [] u8, room: int) -> int {
  if room <= 0 { return 0; }
  // written as it would go, then noted only when it fits
  was_held := st[0].held[q]; was_base := st[0].base[q]; was_sent := st[0].sent[q]; was_last := st[0].last[q];
  was_gone := st[0].gone[q]; was_gone_t := st[0].gone_t[q]; was_acc := st[0].acc[q]; was_since := st[0].since[q];
  was_allowed:=st[0].allowed[q];
  m := wire_seat_put(st, h, q, e, 0);
  if m <= room { return m; }
  st[0].held[q] = was_held; st[0].base[q] = was_base; st[0].sent[q] = was_sent; st[0].last[q] = was_last;
  st[0].gone[q] = was_gone; st[0].gone_t[q] = was_gone_t; st[0].acc[q] = was_acc; st[0].since[q] = was_since;
  st[0].allowed[q]=was_allowed;
  return 0;
}

// ---- checks of the model

// A check's entity in slot q of the table's tick, weighed by its kind; a player heard however far.
wire_test_put :: (h: [] WireHist, q: int, e: WireS) { wire_hist_put(h, q, e, wire_rel(e.kind), e.kind == WK_PLAYER, false); }
// Seat st's frame at h's tick into mirror m (a frame of one part), when `lose` is false; the bytes.
wire_test_send :: (st: [] WireSeat, h: [] WireHist, m: [] WireMirror, me: int, budget: int, lose: bool, full: bool) -> int {
  buf: [8192] u8;
  n := wire_put_d(buf[..], 0, WireD.{tick = h[0].now, ack = 0, f = ifx full then 1 else 0, part = 0});
  m0 := n;
  n += wire_seat_frame(st, h, me, 0, 0, 120, budget, buf[n..<buf.count]);
  if !lose { _ := wire_mirror_frame(m, cast(string) buf[0..<n]); }
  return n - m0;
}

#test "wire (#13178): spawns lead the frame on the reliable lane; on datagrams an unheard spawn's updates wait and it goes again each WIRE_RESEND ticks" {
  pick: [WIRE_ZSLOTS] f32; buf: [4096] u8;
  for dg: 0..<2 {
    h: [1] WireHist; st: [1] WireSeat; st[0].datagrams = dg == 1;
    for q: 0..<WIRE_ZSLOTS { pick[q] = -1; }
    pick[20] = 0; pick[21] = 0;
    sent: [16] bool;
    for t: 1..<16 {
      wire_hist_begin(h[..], t);
      wire_test_put(h[..], 20, WireS.{id = WIRE_ID_FOLK + 1, kind = WK_FOLK, x = 3, z = f32(t) * 0.1, clip = 1, p1 = 1});
      if t >= 3 { wire_test_put(h[..], 21, WireS.{id = WIRE_ID_FOLK + 2, kind = WK_FOLK, x = 4, z = 1, clip = 1, p1 = 2}); }
      if t == 14 { wire_seat_ack(st[..], h[..], 11); }   // the page heard tick 11 whole
      n := wire_seat_frame_in(st[..], h[..], -1, 0, 0, pick[..], 1000, buf[..]);
      sent[t] = st[0].last[20] == t;
      if t == 3 { #assert st[0].last[21] == 3 && st[0].rel > 0; }   // a new one: its spawn, on the reliable lane
      if t < 14 { #assert st[0].rel == n; }   // nothing heard yet: every row is a spawn
      if t == 15 { #assert sent[t]; #assert st[0].rel < n; u := ifx st[0].rel == 0 then 0 else st[0].rel + 1; #assert cast(string) buf[u..<u + 8] == "s 100001"; }   // heard: an update after the lane
    }
    if dg == 1 {
      // the spawn at 1, again at 11, then (11 heard at 14) updates
      #assert sent[1] && !sent[2] && !sent[10] && sent[11] && !sent[12] && !sent[13] && sent[14] && sent[15];
    } else {
      for t: 1..<16 { #assert sent[t]; }   // one ordered stream: each change goes, as a spawn until heard
    }
  }
}
#test "wire (#12845): recipient field changes reset baselines and a refused row retains its earlier send state" {
  h:[1]WireHist;st:[1]WireSeat;m:[1]WireMirror;
  pick:[WIRE_ZSLOTS]f32;fields:[WIRE_ZSLOTS]int;
  for q:0..<WIRE_ZSLOTS {pick[q]=-1;}
  pick[4]=1;fields[4]=(1<<WIRE_SF)-1;
  buf:[4096]u8;row:=WireS.{id=9,x=5,z=7,hp=8,max=11,life=1};
  wire_hist_begin(h[..],1);wire_test_put(h[..],4,row);
  n:=wire_put_d(buf[..],0,WireD.{tick=1});
  n+=wire_seat_frame_fields(st[..],h[..],-1,0,0,pick[..],fields[..],1000,buf[n..<buf.count]);
  d:=wire_mirror_frame(m[..],cast(string)buf[0..<n]);#assert wire_mirror_of(m[..],9).x==5;
  wire_seat_ack(st[..],h[..],1);#assert st[0].base[4]==1;
  wire_hist_begin(h[..],2);wire_test_put(h[..],4,row);fields[4]=(1<<WS_HP)|(1<<WS_MAX);
  n=wire_put_d(buf[..],0,WireD.{tick=2});
  n+=wire_seat_frame_fields(st[..],h[..],-1,0,0,pick[..],fields[..],1000,buf[n..<buf.count]);
  d=wire_mirror_frame(m[..],cast(string)buf[0..<n]);e:=wire_mirror_of(m[..],9);
  #assert e.hp==8 && e.max==11 && e.x==0 && e.z==0 && st[0].base[4]==0;
  wire_seat_ack(st[..],h[..],2);#assert st[0].base[4]==2;
  wire_hist_begin(h[..],3);wire_test_put(h[..],4,row);fields[4]=(1<<WIRE_SF)-1;
  n=wire_seat_frame_fields(st[..],h[..],-1,0,0,pick[..],fields[..],1,buf[..]);
  #assert n==0 && st[0].base[4]==2 && st[0].allowed[4]==((1<<WS_HP)|(1<<WS_MAX));
  n=wire_put_d(buf[..],0,WireD.{tick=3});
  n+=wire_seat_frame_fields(st[..],h[..],-1,0,0,pick[..],fields[..],1000,buf[n..<buf.count]);
  d=wire_mirror_frame(m[..],cast(string)buf[0..<n]);e=wire_mirror_of(m[..],9);
  #assert e.x==5 && e.z==7 && e.hp==8 && st[0].base[4]==0;
}

#test "wire: a row goes out absolute, then as a delta of only what changed against what the page acknowledged; it reads back exactly" {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  // tick 1: a townsperson and a wolf, both new to the page: absolute rows
  wire_hist_begin(h[..], 1);
  wire_test_put(h[..], 20, WireS.{id = WIRE_ID_FOLK + 4, kind = WK_FOLK, x = 12.34, z = -56.78, yaw = 1.5, vx = 1.2, g = 0, clip = 1, hp = 9, p1 = 4});
  wire_test_put(h[..], 40, WireS.{id = WIRE_ID_MADE + 7, kind = WK_BEAST, x = 3, y = 0.5, z = 4, hp = 11, max = 11, owner = 2, p1 = 1, g = 1});
  buf: [4096] u8;
  n := wire_seat_frame(st[..], h[..], -1, 0, 0, 120, WIRE_BUDGET, buf[..]);
  t := cast(string) buf[0..<n];
  // the wolf first: nearer and heavier; the townsperson's OWNER is WireS's -1
  #assert t == "s 200007 0 2125071 12 300 50 400 1 11 11 2 1 1;s 100004 0 2123323 1 1234 -5678 150 120 1 9 -1 4 1";
  d := WireD.{tick = 1};
  _ := wire_mirror_d(m[..], d);
  for k: 0..<wire_entries(t, 0) { _2 := wire_mirror_s(m[..], 1, wire_entry(t, 0, k)); }
  wire_mirror_end(m[..], d);
  #assert m[0].heard == 1 && m[0].bad == 0;
  f := wire_mirror_of(m[..], WIRE_ID_FOLK + 4);
  #assert f.kind == WK_FOLK && f.x == 12.34 && f.z == -56.78 && f.clip == 1 && f.hp == 9 && f.p1 == 4 && f.vx == 1.2 && f.yaw == 1.5;
  #assert wire_mirror_of(m[..], WIRE_ID_MADE + 7).owner == 2;
  // ticks 2 to 4: the page said it heard tick 1; the townsperson walked 4 cm and the wolf stands. The
  // townsperson, 58 m off, goes every third tick (wire_every, #13165): nothing at 2 or 3; at 4 one short
  // row, against tick 1's, its x alone; the wolf not at all
  wire_seat_ack(st[..], h[..], 1);
  for tk: 2..<5 {
    wire_hist_begin(h[..], tk);
    wire_test_put(h[..], 20, WireS.{id = WIRE_ID_FOLK + 4, kind = WK_FOLK, x = 12.38, z = -56.78, yaw = 1.5, vx = 1.2, g = 0, clip = 1, hp = 9, p1 = 4});
    wire_test_put(h[..], 40, WireS.{id = WIRE_ID_MADE + 7, kind = WK_BEAST, x = 3, y = 0.5, z = 4, hp = 11, max = 11, owner = 2, p1 = 1, g = 1});
    n = wire_seat_frame(st[..], h[..], -1, 0, 0, 120, WIRE_BUDGET, buf[..]);
    t = cast(string) buf[0..<n];
    #assert (tk < 4 && t == "") || (tk == 4 && t == "s 100004 3 2 4");
  }
  #assert wire_mirror_s(m[..], 4, t) >= 0 && wire_mirror_of(m[..], WIRE_ID_FOLK + 4).x == 12.38 && wire_mirror_of(m[..], WIRE_ID_FOLK + 4).hp == 9;
  // a row against a base the page doesn't hold is refused, and the tick isn't heard
  _3 := wire_mirror_d(m[..], WireD.{tick = 5});
  #assert wire_mirror_s(m[..], 5, "s 100004 2 2 4") < 0 && m[0].bad == 1;   // against tick 3's: never heard
  wire_mirror_end(m[..], WireD.{tick = 5});
  #assert m[0].heard == 1;
  // bad rows: a short one, a mask past the fields, extra fields
  r: [1] WireRd;
  base: [WIRE_SF] s32; out: [WIRE_SF] s32;
  tt := "s 5 0 3 100"; r[0] = wire_rd(tt, 1); _4 := wire_read_s_head(tt, r[..]); wire_read_s_body(tt, r[..], base[..], out[..]);
  #assert !r[0].ok;
  tt = "s 5 0 8388608 1"; r[0] = wire_rd(tt, 1); _5 := wire_read_s_head(tt, r[..]); wire_read_s_body(tt, r[..], base[..], out[..]);
  #assert !r[0].ok;
  tt = "s 5 0 2 7 8"; r[0] = wire_rd(tt, 1); _6 := wire_read_s_head(tt, r[..]); wire_read_s_body(tt, r[..], base[..], out[..]);
  #assert !r[0].ok;
  tt = "s 5 99 2 7"; r[0] = wire_rd(tt, 1); _7 := wire_read_s_head(tt, r[..]);
  #assert !r[0].ok;
}

#test "wire (#13165): a packed row reads back as its text row does, in under half the bytes, and a damaged one is refused" {
  base: [WIRE_SF] s32; now: [WIRE_SF] s32; zero: [WIRE_SF] s32;
  wire_s_pack(WireS.{id = 3, kind = WK_PLAYER, x = 12.34, y = 0.02, z = -56.78, yaw = 1.5, vx = 4.2, vz = -1.1, g = 1, clip = 2, hp = 40, max = 44, carry = 0.0137, life = 912345678, warp = 2}, base[..]);
  wire_s_pack(WireS.{id = 3, kind = WK_PLAYER, x = 12.48, y = 0.02, z = -56.82, yaw = 1.53, vx = 4.2, vz = -1.2, g = 1, clip = 2, hp = 40, max = 44, carry = 0.0249, life = 912345678, warp = 2}, now[..]);
  all := (1 << WIRE_SF) - 1;
  tb: [WIRE_ROW] u8; pb: [WIRE_ROW] u8;
  for c: 0..<4 {
    b := ifx c % 2 == 0 then base[..] else zero[..]; back := ifx c % 2 == 0 then 3 else 0; id := ifx c < 2 then 3 else WIRE_ID_MADE + WIRE_TREE_EID + 77;
    tn := wire_put_s_fields(tb[..], 0, id, back, b, now[..], all); pn := wire_put_s_packed(pb[..], 0, id, back, b, now[..], all);
    t := wire_read_row(cast(string) tb[0..<tn]); p := wire_read_row(cast(string) pb[0..<pn]);
    #assert t.ok && p.ok && pb[0] == 'S' && p.id == id && p.back == back && p.mask == t.mask;
    for q: 0..<WIRE_SF { #assert p.d[q] == t.d[q]; }
    for i: 1..<pn { #assert wire_b64_value(pb[i]) >= 0; }   // nothing the frame or the relay splits on
    if c == 0 { #assert pn * 2 < tn; }                       // a walker's delta: under half
  }
  // into a mirror: the same row either way, against the base it holds
  m: [1] WireMirror; d := WireD.{tick = 1};
  _ := wire_mirror_d(m[..], d);
  n := wire_put_s_packed(pb[..], 0, 3, 0, zero[..], base[..], all);
  #assert wire_mirror_s(m[..], 1, cast(string) pb[0..<n]) >= 0;
  n = wire_put_s_packed(pb[..], 0, 3, 1, base[..], now[..], all);
  #assert wire_mirror_s(m[..], 2, cast(string) pb[0..<n]) >= 0;
  w := wire_mirror_of(m[..], 3);
  #assert w.x == 12.48 && w.z == -56.82 && w.yaw == 1.53 && w.vz == -1.2 && w.hp == 40 && w.life == 912345678 && m[0].bad == 0;
  // damaged: a character out of the alphabet, one short, one over, a spare bit set, a BACK past the bases
  n = wire_put_s_packed(pb[..], 0, 3, 1, base[..], now[..], all);
  good := cast(string) pb[0..<n];
  #assert wire_read_row(good).ok;
  pb[3] = ';'; #assert !wire_read_row(good).ok;
  n = wire_put_s_packed(pb[..], 0, 3, 1, base[..], now[..], all);
  #assert !wire_read_row(cast(string) pb[0..<n - 1]).ok;
  pb[n] = 'A'; #assert !wire_read_row(cast(string) pb[0..<n + 1]).ok;
  #assert !wire_read_row("S").ok && !wire_read_row("S____________").ok && !wire_read_row("S AAAA").ok && !wire_read_row("qAAAA").ok;
  #assert wire_put_s_packed(pb[..], 0, 3, WIRE_BASES, base[..], now[..], all) == 0;
  for v: -70000..<70000 { if v % 97 == 0 || (v > -40 && v < 40) { #assert wire_unzig(wire_zig(v)) == v; } }
}

#test "wire (#13165): a seat that reads packed rows gets them, and every row still reads back true; near rows go every tick, far ones every second or third" #steps 2000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror; tx: [1] WireSeat; mx: [1] WireMirror;
  st[0].packed = true;
  // players 5 m, 40 m and 100 m off, and a townsperson 100 m off (wire_rel: a player counts half as far, a townsperson a third farther)
  ids := [4] int.[1, 2, 3, WIRE_ID_FOLK + 3]; slot := [4] int.[1, 2, 3, 20]; dist := [4] f32.[5, 40, 100, 100]; every := [4] int.[1, 1, 2, 3];
  got: [4] int; bytes := 0; text := 0;
  for t: 1..<91 {
    wire_hist_begin(h[..], t);
    wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
    // (at tick 50 the far townsperson is hurt: that goes at once, whatever its tier)
    for i: 0..<4 { wire_test_put(h[..], slot[i], WireS.{id = ids[i], kind = ifx i == 3 then WK_FOLK else WK_PLAYER, x = dist[i], z = f32(t) * 0.14, vz = 4.2, clip = 1, hp = ifx i == 3 && t >= 50 then 20 else 30, max = 30}); }
    wire_seat_ack(st[..], h[..], m[0].heard); wire_seat_ack(tx[..], h[..], mx[0].heard);
    bytes += wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, false, t == 1);
    text += wire_test_send(tx[..], h[..], mx[..], 0, WIRE_BUDGET, false, t == 1);
    for i: 0..<4 {
      if st[0].last[slot[i]] == t { got[i] += 1; }
      if i == 3 && t == 50 { #assert st[0].last[slot[i]] == 50 && wire_mirror_of(m[..], ids[i]).hp == 20; }
      #assert wire_every(dist[i] * dist[i], wire_rel(ifx i == 3 then WK_FOLK else WK_PLAYER)) == every[i];
      // what the page holds, either way, is never more than its tier behind
      w := wire_mirror_of(m[..], ids[i]); v := wire_mirror_of(mx[..], ids[i]);
      #assert w.id == ids[i] && f32(t) * 0.14 - w.z < 0.14 * f32(every[i] - 1) + 0.006 && v.id == ids[i] && abs(v.z - w.z) < 0.006;
    }
  }
  #assert m[0].bad == 0 && mx[0].bad == 0 && got[0] == 90 && got[1] == 90 && got[2] == 45 && got[3] >= 30 && got[3] <= 31 && st[0].spaced >= 100;
  #assert bytes * 3 < text * 2;   // the same rows packed: under two thirds of the bytes, the separators and own row included
  #assert wire_every(0, 4) == 1 && wire_every(47 * 47, 4) == 1 && wire_every(49 * 49, 4) == 2 && wire_every(121 * 121, 4) == 3 && wire_every(17 * 17, 1.5) == 1 && wire_every(19 * 19, 1.5) == 2;
}

#test "wire: a frame lost on the way leaves its tick unheard; the server keeps the older base, and every row still reads back true" #steps 2000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  // three walkers and a still one; every 4th frame lost, every 3rd tick the page's word comes
  seed := 7;
  for t: 1..<121 {
    wire_hist_begin(h[..], t);
    for q: 0..<3 { wire_test_put(h[..], q, WireS.{id = q, kind = WK_PLAYER, x = f32(t) * 0.11 * f32(q + 1), z = f32(q), hp = 50 - t / 10, max = 50}); }
    wire_test_put(h[..], 9, WireS.{id = WIRE_ID_FOLK, kind = WK_FOLK, x = 5, z = 5, hp = 4});
    if t % 3 == 0 { wire_seat_ack(st[..], h[..], m[0].heard); }
    _ := wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, t % 4 == 2, t == 1);
    // what the page holds is what the server has, for every frame it heard
    if t % 4 != 2 {
      for q: 0..<3 {
        w := wire_mirror_of(m[..], q);
        #assert w.id == q && abs(w.x - f32(t) * 0.11 * f32(q + 1)) < 0.006 && w.hp == 50 - t / 10;
      }
      #assert wire_mirror_of(m[..], WIRE_ID_FOLK).hp == 4;
    }
  }
  #assert m[0].bad == 0 && m[0].heard >= 117;
}

#test "wire: under the budget the nearest go first; the far ones' priority grows until they go too; your own row always goes" #steps 2000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  // 40 townsfolk walking, from 2 m to 80 m off; a budget that holds about 8 rows a tick
  heard: [40] int; last_heard: [40] int;
  for t: 1..<91 {
    wire_hist_begin(h[..], t);
    wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
    for i: 0..<40 { wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_FOLK + i, kind = WK_FOLK, x = 2 + f32(i) * 2, z = f32(t) * 0.04, vz = 1.2, clip = 1, p1 = i}); }
    wire_seat_ack(st[..], h[..], m[0].heard);
    before := m[0].heard;
    n := wire_test_send(st[..], h[..], m[..], 0, 160, false, t == 1);
    #assert st[0].bytes <= 160 + 40 + WIRE_AGED_BUDGET;   // the budget, your own row and the aged on top
    #assert wire_mirror_of(m[..], 0).id == 0;
    for i: 0..<40 {
      w := wire_mirror_of(m[..], WIRE_ID_FOLK + i);
      if w.id >= 0 && abs(w.z - f32(t) * 0.04) < 0.006 { heard[i] += 1; last_heard[i] = t; }
    }
  }
  // the nearest heard most often, the farthest less, and none starved
  #assert heard[0] > heard[39] * 2 && heard[39] >= 3;
  for i: 0..<40 { #assert last_heard[i] >= 70; }
}

#test "wire: removals go from their own allowance, the rest the next tick, and a slot's new entity never reaches the page before the x of the one it replaces (#12836)" #steps 2000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  // 60 creatures the page holds, then each replaced in its slot by another at once
  wire_hist_begin(h[..], 1);
  wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
  for i: 0..<60 { wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_MADE + i, kind = WK_BEAST, x = 2 + f32(i) * 0.5, z = 3, hp = 5, max = 5, g = 1}); }
  _ := wire_test_send(st[..], h[..], m[..], 0, 8000, false, true);
  for i: 0..<60 { #assert wire_mirror_of(m[..], WIRE_ID_MADE + i).id >= 0; }
  done_at := 0;
  for t: 2..<12 {
    wire_hist_begin(h[..], t);
    wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
    for i: 0..<60 { wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_MADE + 1000 + i, kind = WK_BEAST, x = 2 + f32(i) * 0.5, z = 3, hp = 5, max = 5, g = 1}); }
    wire_seat_ack(st[..], h[..], m[0].heard);
    gone_before := 0;
    for i: 0..<60 { if wire_mirror_of(m[..], WIRE_ID_MADE + i).id < 0 { gone_before += 1; } }
    _2 := wire_test_send(st[..], h[..], m[..], 0, 8000, false, false);
    gone := 0; all := true;
    for i: 0..<60 {
      old := wire_mirror_of(m[..], WIRE_ID_MADE + i).id >= 0; new := wire_mirror_of(m[..], WIRE_ID_MADE + 1000 + i).id >= 0;
      #assert !(old && new);   // never both: the new one waits behind the x
      if !old { gone += 1; }
      if !new { all = false; }
    }
    // an x is "x 200007", 9 bytes with its separator: at most WIRE_LIFE_BUDGET / 9 a tick
    #assert gone - gone_before <= WIRE_LIFE_BUDGET / 9;
    if all && done_at == 0 { done_at = t; }
  }
  // the 60 x's take 3 ticks of the allowance (26 a tick); every new one is held by then
  #assert done_at >= 4 && done_at <= 5;
}

// A slot's entity leaves while the x of the one before it is still unacknowledged (#12900): both x's
// are owed, and neither is overwritten by the other.
#test "wire: a slot reused and left again before its earlier x is acknowledged still owes both x's (#12900)" #steps 2000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  me := WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10};
  a := WIRE_ID_MADE + 7; b := WIRE_ID_MADE + 8; c := WIRE_ID_MADE + 9;
  // tick 1: A in slot 20, and the page holds it
  wire_hist_begin(h[..], 1); wire_test_put(h[..], 0, me);
  wire_test_put(h[..], 20, WireS.{id = a, kind = WK_BEAST, x = 2, z = 3, hp = 5, max = 5});
  _ := wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, false, true);
  wire_seat_ack(st[..], h[..], m[0].heard);
  #assert wire_mirror_of(m[..], a).id == a;
  // tick 2: A leaves; the frame with its x is lost
  wire_hist_begin(h[..], 2); wire_test_put(h[..], 0, me);
  _2 := wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, true, false);
  // tick 3: B takes slot 20 and reaches the page
  wire_hist_begin(h[..], 3); wire_test_put(h[..], 0, me);
  wire_test_put(h[..], 20, WireS.{id = b, kind = WK_BEAST, x = 2, z = 3, hp = 5, max = 5});
  _3 := wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, false, false);
  wire_seat_ack(st[..], h[..], m[0].heard);
  // tick 4: B leaves before A's x is acknowledged; from tick 5 C wants the slot
  for t: 4..<40 {
    wire_hist_begin(h[..], t); wire_test_put(h[..], 0, me);
    if t >= 5 { wire_test_put(h[..], 20, WireS.{id = c, kind = WK_BEAST, x = 2, z = 3, hp = 5, max = 5}); }
    _4 := wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, false, false);
    wire_seat_ack(st[..], h[..], m[0].heard);
  }
  #assert wire_mirror_of(m[..], a).id == -1;   // A's x was not lost
  #assert wire_mirror_of(m[..], b).id == -1;
  #assert wire_mirror_of(m[..], c).id == c;
}

// A seat throttled to 64 kbit/s (267 bytes a tick at 30 a second) and then released, as the room sends
// to it (#12837): its frames wait in a socket queue the page reads at that rate, and while more than
// 4096 bytes wait (room-everglade.coax EG_BEHIND) its budget is 0 (its own row and the x's only).
WIRE_TEST_QN :: 64; WIRE_TEST_QB :: 4096;   // the throttle check's socket queue: frames, and bytes a frame
#test "wire: a seat throttled to 64 kbit/s keeps its queue bounded, and once released its page holds every entity as it is within a second (#12837)" #steps 6000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  qb: [WIRE_TEST_QN * WIRE_TEST_QB] u8; ql: [WIRE_TEST_QN] int; qh := 0; qn := 0; queued := 0; allow := 0;
  most := 0; recovered := -1;
  for t: 1..<241 {
    rate := ifx t > 30 && t <= 180 then 267 else 1000000;
    wire_hist_begin(h[..], t);
    wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
    for i: 0..<40 { wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_FOLK + i, kind = WK_FOLK, x = 2 + f32(i) * 2, z = f32(t) * 0.04, vz = 1.2, clip = 1, p1 = i}); }
    wire_seat_ack(st[..], h[..], m[0].heard);
    // this tick's frame into the queue's tail (the budget 0 while behind)
    if qn < WIRE_TEST_QN {
      at := ((qh + qn) % WIRE_TEST_QN) * WIRE_TEST_QB;
      b := qb[at..<at + WIRE_TEST_QB];
      n := wire_put_d(b, 0, WireD.{tick = t, ack = 0, f = ifx t == 1 then 1 else 0, part = 0});
      n += wire_seat_frame(st[..], h[..], 0, 0, 0, 120, ifx queued > 4096 then 0 else WIRE_BUDGET, b[n..<WIRE_TEST_QB]);
      ql[(qh + qn) % WIRE_TEST_QN] = n; qn += 1; queued += n;
    }
    if queued > most { most = queued; }
    // the page reads rate bytes a tick, whole frames in order
    allow += rate;
    while qn > 0 && ql[qh] <= allow {
      at := qh * WIRE_TEST_QB;
      _ := wire_mirror_frame(m[..], cast(string) qb[at..<at + ql[qh]]);
      allow -= ql[qh]; queued -= ql[qh]; qh = (qh + 1) % WIRE_TEST_QN; qn -= 1;
    }
    if qn == 0 && allow > rate { allow = rate; }
    // released: the first tick the page holds every walker where it is now, or as near as its tier's
    // spacing leaves it (wire_every, #13165)
    if t > 180 && recovered < 0 {
      ok := true;
      for i: 0..<40 {
        w := wire_mirror_of(m[..], WIRE_ID_FOLK + i); d := 2 + f32(i) * 2;
        if w.id < 0 || abs(w.z - f32(t) * 0.04) > 0.04 * f32(wire_every(d * d, wire_rel(WK_FOLK)) - 1) + 0.006 { ok = false; }
      }
      if ok { recovered = t - 180; }
    }
  }
  // throttled: the queue never past the behind line and a frame; released: whole within 30 ticks (1 s)
  #assert most <= 4096 + WIRE_TEST_QB;
  #assert recovered >= 0 && recovered <= 30;
}

#test "wire: a changed row waits at most WIRE_MAX_AGE ticks before it goes for its age, from bytes of its own; a seat behind is sent none (#12836)" #steps 2000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  // 60 townsfolk walking, from 2 m to 90 m off, with a budget of about 2 rows a tick: the far ones'
  // priority alone would leave them waiting seconds
  waited: [60] int; worst := 0; most := 0;
  for t: 1..<151 {
    wire_hist_begin(h[..], t);
    wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
    for i: 0..<60 { wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_FOLK + i, kind = WK_FOLK, x = 2 + f32(i) * 1.5, z = f32(t) * 0.04, vz = 1.2, clip = 1, p1 = i}); }
    wire_seat_ack(st[..], h[..], m[0].heard);
    _ := wire_test_send(st[..], h[..], m[..], 0, 60, false, t == 1);
    #assert st[0].oldest <= WIRE_MAX_AGE + WIRE_SLOTS / 6;
    if st[0].oldest > worst { worst = st[0].oldest; }
    for i: 0..<60 {
      w := wire_mirror_of(m[..], WIRE_ID_FOLK + i);
      if w.id >= 0 && abs(w.z - f32(t) * 0.04) < 0.006 { waited[i] = 0; } else { waited[i] += 1; }
      if waited[i] > most { most = waited[i]; }
    }
  }
  #assert st[0].aged_all > 0 && worst >= WIRE_MAX_AGE;
  // the 60 at once as they first all come of age (about 7 aged rows a tick of 30 to 60 bytes): 38 ticks
  #assert most <= WIRE_MAX_AGE + 60 / 6 && most > WIRE_MAX_AGE;
  // behind (budget 0): nothing for its age either
  wire_hist_begin(h[..], 151);
  for i: 0..<60 { wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_FOLK + i, kind = WK_FOLK, x = 2 + f32(i) * 2, z = 9, p1 = i}); }
  _2 := wire_test_send(st[..], h[..], m[..], 0, 0, false, false);
  #assert st[0].aged == 0;
}

#test "wire: an effect on you from another player goes the tick it starts and each tick it changes, past a spent budget and while behind (#12836)" #steps 2000000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  // 60 townsfolk walking near you fill a budget of about 2 rows a tick; seat 3, 40 m off, holds you
  // from tick 20 (Hold Person: its DUR counts down each tick); the room's pick has it on you (WIRE_PICK_OWN)
  pick: [WIRE_ZSLOTS] f32;
  buf: [8192] u8;
  for t: 1..<91 {
    wire_hist_begin(h[..], t);
    wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
    wire_test_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 40, hp = 10, max = 10});
    for i: 0..<60 { wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_FOLK + i, kind = WK_FOLK, x = 2 + f32(i) * 0.2, z = f32(t) * 0.04, vz = 1.2, clip = 1, p1 = i}); }
    if t >= 20 { wire_test_put(h[..], 90, WireS.{id = WIRE_ID_MADE + 7, kind = WK_EFFECT, owner = WIRE_TGT_SEAT, p1 = 4, p2 = 2, t0 = 20, dur = 200 - t}); }
    row := t % WIRE_BASES;
    for q: 0..<h[0].slots { pick[q] = ifx h[0].id[row * WIRE_ZSLOTS + q] == 0 then -1.0f32 else (ifx q == 90 then f32(WIRE_PICK_OWN) else 0.0f32); }
    wire_seat_ack(st[..], h[..], m[0].heard);
    n := wire_put_d(buf[..], 0, WireD.{tick = t, ack = 0, f = ifx t == 1 then 1 else 0, part = 0});
    // behind from tick 50 to 60: a budget of 0
    n += wire_seat_frame_in(st[..], h[..], 0, 0, 0, pick[..], ifx t >= 50 && t < 60 then 0 else 60, buf[n..<buf.count]);
    _ := wire_mirror_frame(m[..], cast(string) buf[0..<n]);
    if t >= 20 {
      w := wire_mirror_of(m[..], WIRE_ID_MADE + 7);
      #assert w.id == WIRE_ID_MADE + 7 && w.dur == 200 - t && w.t0 == 20 && w.p1 == 4;
    }
  }
}

#test "wire: what goes is sent as x until a tick that held it is heard; a part missing leaves the tick unheard; a snapshot forgets everything first" {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  wire_hist_begin(h[..], 1);
  wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER});
  wire_test_put(h[..], 50, WireS.{id = WIRE_ID_MADE + 3, kind = WK_ZONE, x = 1, z = 1, p1 = 2, p2 = 400});
  _ := wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, false, true);
  #assert wire_mirror_of(m[..], WIRE_ID_MADE + 3).p2 == 400;
  // tick 2: the zone ends; its x is lost on the way, and goes again WIRE_RESEND ticks on
  wire_hist_begin(h[..], 2); wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER});
  buf: [1024] u8;
  n := wire_seat_frame(st[..], h[..], 0, 0, 0, 120, WIRE_BUDGET, buf[..]);
  #assert cast(string) buf[0..<n] == "x 200003;s 0 0 2105344 -1 1";   // nothing acknowledged: absolute (OWNER -1 past zeros)
  for t: 3..<12 { wire_hist_begin(h[..], t); wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER}); n = wire_seat_frame(st[..], h[..], 0, 0, 0, 120, WIRE_BUDGET, buf[..]); #assert buf[0] == 's'; }
  wire_hist_begin(h[..], 12); wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER});
  _2 := wire_test_send(st[..], h[..], m[..], 0, WIRE_BUDGET, false, false);
  #assert wire_mirror_of(m[..], WIRE_ID_MADE + 3).id == -1 && st[0].gone[50] != 0;
  wire_seat_ack(st[..], h[..], 12);
  #assert st[0].gone[50] == 0;
  // a tick in two parts with the first lost: not heard; both: heard
  _3 := wire_mirror_d(m[..], WireD.{tick = 20, f = 2, part = 1}); wire_mirror_end(m[..], WireD.{tick = 20, f = 2, part = 1});
  _4 := wire_mirror_d(m[..], WireD.{tick = 20, part = 2}); wire_mirror_end(m[..], WireD.{tick = 20, part = 2});
  #assert m[0].heard == 12;
  _5 := wire_mirror_d(m[..], WireD.{tick = 21, f = 2, part = 0}); wire_mirror_end(m[..], WireD.{tick = 21, f = 2, part = 0});
  #assert m[0].heard == 12;
  _6 := wire_mirror_d(m[..], WireD.{tick = 21, part = 1}); wire_mirror_end(m[..], WireD.{tick = 21, part = 1});
  #assert m[0].heard == 21;
  #assert wire_mirror_of(m[..], 0).id == 0 && wire_mirror_d(m[..], WireD.{tick = 22, f = 1, part = 0}) && wire_mirror_of(m[..], 0).id == -1;
}

#test "wire: every frame and entry reads back as it was written; a short or bad one is refused" {
  buf: [WIRE_SERVER_FRAME] u8;
  // a page's
  n := wire_put_in(buf[..], 0, WireIn.{seq = 12, kx = -100, ky = 100, px = 0, py = 35, theta = 3.0, b = WB_RUN | WB_JUMP, heard = 880});
  t := cast(string) buf[0..<n];
  #assert t == "I 12 -100 100 0 35 30000 3 880";
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  i := wire_read_in(t, r[..]);
  #assert r[0].ok && i.seq == 12 && i.kx == -100 && i.py == 35 && abs(i.theta - 3.0) < 0.00001 && i.b == 3 && i.heard == 880;
  #assert wire_axis(0.354) == 35 && wire_axis(-2) == -100;
  n = wire_put_hello(buf[..], 0, WireHello.{look = "ranger.2.1.0", kind = "druid", flags = 2, name = "Ash Wood;x"});
  t = cast(string) buf[0..<n];
  #assert t == "H 7 ranger.2.1.0 druid 2 Ash Woodx";
  r[0] = wire_rd(t, 1);
  h := wire_read_hello(t, r[..]);
  #assert r[0].ok && h.version == WIRE_VERSION && h.look == "ranger.2.1.0" && h.flags == 2 && h.name == "Ash Woodx";
  // the build before the hello: this source's own unless told
  n = wire_put_pins(buf[..], 0, WirePins.{}); t = cast(string) buf[0..<n];
  #assert t == "P 1 1 1";
  n = wire_put_pins(buf[..], 0, WirePins.{engine = 3, rules = 12, content = 7}); t = cast(string) buf[0..<n];
  r[0] = wire_rd(t, 1);
  pp := wire_read_pins(t, r[..]);
  #assert t == "P 3 12 7" && r[0].ok && pp.engine == 3 && pp.rules == 12 && pp.content == 7;
  r[0] = wire_rd("P 3 12", 1); _p := wire_read_pins("P 3 12", r[..]); #assert !r[0].ok;
  n = wire_put_cast(buf[..], 0, WireCast.{seq = 13, slot = 32, ax = 5, ay = 0, az = 6}); t = cast(string) buf[0..<n];
  #assert t == "C 13 32 500 0 600 -1";
  // a spell's mode goes last, and only when it has one; the reader takes it, or 0 when none
  rc: [1] WireRd; rc[0] = wire_rd(t, 1);
  #assert wire_read_cast(t, rc[..]).mode == 0 && rc[0].ok;
  n = wire_put_cast(buf[..], 0, WireCast.{seq = 13, slot = 29, ax = 5, ay = 0, az = 6, mode = 2}); t = cast(string) buf[0..<n];
  rc[0] = wire_rd(t, 1);
  wm := wire_read_cast(t, rc[..]);
  #assert t == "C 13 29 500 0 600 -1 2" && rc[0].ok && wm.mode == 2 && wm.tgt == -1;
  n = wire_put_cast_e(buf[..], 0, WireCastE.{ss = 3, slot = 25, ax = 1, ay = 0, az = 2, seed = 1, mode = 4}); t = cast(string) buf[0..<n];
  rc[0] = wire_rd(t, 6);
  #assert t == "e cast 3 25 100 0 200 1 4" && wire_read_cast_e(t, rc[..]).mode == 4 && rc[0].ok;
  n = wire_put_use(buf[..], 0, WireUse.{seq = 14, kind = WE_END, id = 32}); t = cast(string) buf[0..<n];
  r[0] = wire_rd(t, 1);
  u := wire_read_use(t, r[..]);
  #assert t == "E 14 5 32" && r[0].ok && u.kind == WE_END && u.id == 32;
  // the server's: a state with every kind of entry
  n = wire_put_d(buf[..], 0, WireD.{tick = 900, ack = 12, f = 1, part = 0});
  row: [WIRE_SF] s32; zero: [WIRE_SF] s32;
  wire_s_pack(WireS.{id = 3, kind = WK_PLAYER, x = -10.5, y = 0.25, z = 20.75, yaw = 7.0, vx = 6, vy = -1, vz = -0.5, g = WG_GROUND, clip = 2, hp = 57, max = 57, cond = 2048, owner = 3, carry = 0.0123}, row[..]);
  n = wire_put_s(buf[..], n, 3, 0, zero[..], row[..]);
  n = wire_sep(buf[..], n); n = wire_put_n(buf[..], n, WireN.{ss = 3, id = "", look = "ranger.0.0.0", kind = "druid", flags = 0, name = "Ash Wood"});
  n = wire_sep(buf[..], n); n = wire_put_x(buf[..], n, WIRE_ID_MADE + 39);
  n = wire_sep(buf[..], n); n = wire_put_cast_e(buf[..], n, WireCastE.{ss = 3, slot = 0, ax = 20, ay = 0, az = -15, seed = 77123});
  n = wire_sep(buf[..], n); n = wire_put_hit(buf[..], n, WireHit.{who = 1003, by = 1001, amt = 12, kind = 3});
  n = wire_sep(buf[..], n); n = wire_put_rebuilt(buf[..], n);
  t = cast(string) buf[0..<n];
  r[0] = wire_rd(t, 1);
  d := wire_read_d(t, r[..]);
  #assert r[0].ok && d.tick == 900 && d.ack == 12 && d.f == 1 && d.part == 0 && wire_entries(t, r[0].at) == 6;
  at := r[0].at;
  e := wire_entry(t, at, 0);
  r[0] = wire_rd(e, 1); hd := wire_read_s_head(e, r[..]); back: [WIRE_SF] s32; wire_read_s_body(e, r[..], zero[..], back[..]);
  p := wire_s_unpack(hd.id, back[..]);
  #assert r[0].ok && p.id == 3 && p.x == -10.5 && p.vy == -1 && p.g == WG_GROUND && p.cond == 2048 && abs(p.carry - 0.0123) < 0.00001 && p.yaw > 0.71 && p.yaw < 0.73;
  e = wire_entry(t, at, 1);
  r[0] = wire_rd(e, 1); nn := wire_read_n(e, r[..]);
  #assert r[0].ok && nn.ss == 3 && nn.id == "" && nn.look == "ranger.0.0.0" && nn.name == "Ash Wood";
  #assert wire_entry(t, at, 2) == "x 200039";
  e = wire_entry(t, at, 3);
  #assert wire_is(e, "e cast");
  r[0] = wire_rd(e, 6); ce := wire_read_cast_e(e, r[..]);
  #assert r[0].ok && ce.seed == 77123 && ce.az == -15;
  e = wire_entry(t, at, 4);
  r[0] = wire_rd(e, 5); hit := wire_read_hit(e, r[..]);
  #assert wire_is(e, "e hit") && r[0].ok && hit.who == 1003 && hit.amt == 12;
  #assert wire_entry(t, at, 5) == "e rebuild" && wire_entry(t, at, 6) == "";
  n = wire_put_world(buf[..], 0, WireWorld.{tick = 900, seed = 41, day = 3600000, weather = 2}); t = cast(string) buf[0..<n];
  r[0] = wire_rd(t, 1); w := wire_read_world(t, r[..]);
  #assert t == "W 900 30 41 3600000 2 1000" && r[0].ok && w.hz == 30 && w.budget == WIRE_BUDGET;
  n = wire_put_refused(buf[..], 0, 13, "range"); t = cast(string) buf[0..<n];
  #assert t == "r 13 range";
  // short, and a letter in a number
  t = "D 3 1 0";
  r[0] = wire_rd(t, 1); _ := wire_read_d(t, r[..]);
  #assert !r[0].ok;
  t = "I 1z";
  r[0] = wire_rd(t, 1); _3 := wire_num(t, r[..]);
  #assert !r[0].ok;
}

wire_test_row :: (h: [] WireHist, q: int, t: int) -> WireS {
  a := ((t % WIRE_BASES) * WIRE_ZSLOTS + q) * WIRE_SF;
  return wire_s_unpack(0, h[0].f[a..<a + WIRE_SF]);
}
#test "wire: an id gone a tick and back is a new LIFE; a jump of more than WIRE_WARP_M in a tick is a WARP, its velocity none" {
  h: [1] WireHist;
  f := WIRE_ID_FOLK + 9;
  wire_hist_begin(h[..], 1); wire_hist_put(h[..], 7, WireS.{id = f, kind = WK_FOLK, x = 1}, 3, false, true);
  wire_hist_begin(h[..], 2); wire_hist_put(h[..], 7, WireS.{id = f, kind = WK_FOLK, x = 1.1}, 3, false, true);
  #assert wire_test_row(h[..], 7, 1).life == 1 && wire_test_row(h[..], 7, 2).life == 1 && wire_test_row(h[..], 7, 2).warp == 0 && wire_test_row(h[..], 7, 2).vx == 3;
  // tick 3: gone; tick 4: the same id again, a new life
  wire_hist_begin(h[..], 3);
  wire_hist_begin(h[..], 4); wire_hist_put(h[..], 7, WireS.{id = f, kind = WK_FOLK, x = 1.1}, 3, false, true);
  #assert wire_test_row(h[..], 7, 4).life == 2 && wire_test_row(h[..], 7, 4).warp == 0 && wire_test_row(h[..], 7, 4).vx == 0;
  // tick 5: 10 m on in a tick: a jump, drawn where it lands
  wire_hist_begin(h[..], 5); wire_hist_put(h[..], 7, WireS.{id = f, kind = WK_FOLK, x = 11.1}, 3, false, true);
  #assert wire_test_row(h[..], 7, 5).life == 2 && wire_test_row(h[..], 7, 5).warp == 1 && wire_test_row(h[..], 7, 5).vx == 0;
  // a different id in the slot is its own entity, a life of its own
  wire_hist_begin(h[..], 6); wire_hist_put(h[..], 7, WireS.{id = f + 1, kind = WK_FOLK, x = 11.1}, 3, false, true);
  #assert wire_test_row(h[..], 7, 6).life == 3 && wire_test_row(h[..], 7, 6).warp == 0;
}
#test "wire: what the rules made keeps its LIFE while its id is the slot's, through a tick out of the table (#12835)" {
  h: [1] WireHist;
  b := WIRE_ID_MADE + 9;
  wire_hist_begin(h[..], 1); wire_hist_put(h[..], 7, WireS.{id = b, kind = WK_BEAST, x = 1}, 3, false, true);
  wire_hist_begin(h[..], 2);   // its ground unknown a tick
  wire_hist_begin(h[..], 3); wire_hist_put(h[..], 7, WireS.{id = b, kind = WK_BEAST, x = 1.1}, 3, false, true);
  #assert wire_test_row(h[..], 7, 1).life == 1 && wire_test_row(h[..], 7, 3).life == 1 && wire_test_row(h[..], 7, 3).warp == 0 && wire_test_row(h[..], 7, 3).vx == 0;
  // a jump after the gap is still a WARP of that life
  wire_hist_begin(h[..], 4);
  wire_hist_begin(h[..], 5); wire_hist_put(h[..], 7, WireS.{id = b, kind = WK_BEAST, x = 9}, 3, false, true);
  #assert wire_test_row(h[..], 7, 5).life == 1 && wire_test_row(h[..], 7, 5).warp == 1;
  // the next creature in the slot (a new id) is a new life, gap or none; a zone the same
  wire_hist_begin(h[..], 6); wire_hist_put(h[..], 7, WireS.{id = b + 1, kind = WK_BEAST, x = 9}, 3, false, true);
  #assert wire_test_row(h[..], 7, 6).life == 2 && wire_test_row(h[..], 7, 6).warp == 0;
  wire_hist_begin(h[..], 7); wire_hist_put(h[..], 8, WireS.{id = b + 2, kind = WK_ZONE, x = 2}, 2, false, false);
  wire_hist_begin(h[..], 8);
  wire_hist_begin(h[..], 9); wire_hist_put(h[..], 8, WireS.{id = b + 2, kind = WK_ZONE, x = 2}, 2, false, false);
  #assert wire_test_row(h[..], 8, 7).life == 1 && wire_test_row(h[..], 8, 9).life == 1;
}
#test "wire: nearly full counters go on from 1, never 0 or the field's clamp; a room's lives are its own (#12835)" {
  #assert wire_count_next(0) == 1 && wire_count_next(41) == 42;
  #assert wire_count_next(WIRE_LIFE_MAX - 2) == WIRE_LIFE_MAX - 1 && wire_count_next(WIRE_LIFE_MAX - 1) == 1;
  #assert WIRE_LIFE_MAX - 1 < 2000000000 + 1 && wire_s32(WIRE_LIFE_MAX - 1) == cast(s32) (WIRE_LIFE_MAX - 1);
  // a slot whose LIFE and WARP are at their last: the next of each is 1, and the page sees it as new
  h: [1] WireHist;
  h[0].life[3] = cast(s32) (WIRE_LIFE_MAX - 2);
  wire_hist_begin(h[..], 1); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 1}, 4, true, true);
  #assert wire_test_row(h[..], 3, 1).life == WIRE_LIFE_MAX - 1;
  h[0].warp[3] = cast(s32) (WIRE_LIFE_MAX - 1);
  wire_hist_begin(h[..], 2); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 9}, 4, true, true);
  #assert wire_test_row(h[..], 3, 2).life == WIRE_LIFE_MAX - 1 && wire_test_row(h[..], 3, 2).warp == 1;
  wire_hist_born(h[..], 3);
  wire_hist_begin(h[..], 3); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 9}, 4, true, true);
  #assert wire_test_row(h[..], 3, 3).life == 1 && wire_test_row(h[..], 3, 3).warp == 0;
  // the same slot and id in a room made again (a restart): a different LIFE, in every slot
  a: [1] WireHist; c: [1] WireHist;
  wire_hist_scope(a[..], 1793859327655 + 5 * 7919); wire_hist_scope(c[..], 1793859400000 + 5 * 7919);
  differ := 0;
  for q: 0..<WIRE_SLOTS { if a[0].life[q] != c[0].life[q] { differ += 1; } #assert a[0].life[q] >= 0 && cast(int) a[0].life[q] < WIRE_LIFE_MAX - 1; }
  #assert differ == WIRE_SLOTS;
  wire_hist_begin(a[..], 1); wire_hist_put(a[..], 2, WireS.{id = 2, kind = WK_PLAYER, x = 1}, 4, true, true);
  wire_hist_begin(c[..], 1); wire_hist_put(c[..], 2, WireS.{id = 2, kind = WK_PLAYER, x = 1}, 4, true, true);
  #assert wire_test_row(a[..], 2, 1).life != wire_test_row(c[..], 2, 1).life && wire_test_row(a[..], 2, 1).life > 0;
}
#test "wire: a removal of a past life never takes the new one (#12835)" {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror;
  // tick 1: player 4 in view; the page holds it
  wire_hist_begin(h[..], 1); wire_test_put(h[..], 4, WireS.{id = 4, kind = WK_PLAYER, x = 1});
  _ := wire_test_send(st[..], h[..], m[..], -1, WIRE_BUDGET, false, true);
  wire_seat_ack(st[..], h[..], 1);
  life1 := wire_mirror_of(m[..], 4).life;
  // tick 2: it left; its x is lost on the way
  wire_hist_begin(h[..], 2);
  _ = wire_test_send(st[..], h[..], m[..], -1, WIRE_BUDGET, true, false);
  #assert st[0].gone[4] == 5 && wire_mirror_of(m[..], 4).id == 4;
  // tick 3: a new player sits in seat 4: its row goes, and the x owed for the last one does not
  wire_hist_born(h[..], 4);
  wire_hist_begin(h[..], 3); wire_test_put(h[..], 4, WireS.{id = 4, kind = WK_PLAYER, x = 30});
  _ = wire_test_send(st[..], h[..], m[..], -1, WIRE_BUDGET, false, false);
  w := wire_mirror_of(m[..], 4);
  #assert st[0].gone[4] == 0 && w.id == 4 && w.x == 30 && w.life != life1;
  // and no x for it comes after, however long the page is quiet
  for t: 4..<4 + 2 * WIRE_RESEND {
    wire_hist_begin(h[..], t); wire_test_put(h[..], 4, WireS.{id = 4, kind = WK_PLAYER, x = 30});
    _ = wire_test_send(st[..], h[..], m[..], -1, WIRE_BUDGET, false, false);
  }
  #assert wire_mirror_of(m[..], 4).id == 4 && wire_mirror_of(m[..], 4).life == w.life;
  // a removal that did reach the page before the new life's row: the row makes it again, new
  wire_hist_begin(h[..], 30);
  _ = wire_test_send(st[..], h[..], m[..], -1, WIRE_BUDGET, false, false);
  #assert wire_mirror_of(m[..], 4).id == -1;
  wire_hist_born(h[..], 4);
  wire_hist_begin(h[..], 31); wire_test_put(h[..], 4, WireS.{id = 4, kind = WK_PLAYER, x = 2});
  _ = wire_test_send(st[..], h[..], m[..], -1, WIRE_BUDGET, false, false);
  #assert wire_mirror_of(m[..], 4).x == 2 && wire_mirror_of(m[..], 4).life != w.life;
}
#test "wire: the world's word makes a new LIFE with the same id and slot, and a WARP of a short jump; each once (#12835)" {
  h: [1] WireHist;
  wire_hist_begin(h[..], 1); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 1}, 4, true, true);
  // tick 2: another player sits in seat 3 within the tick: a new life, though id and slot are the same
  wire_hist_born(h[..], 3);
  wire_hist_begin(h[..], 2); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 1.1}, 4, true, true);
  #assert wire_test_row(h[..], 3, 1).life == 1 && wire_test_row(h[..], 3, 2).life == 2 && wire_test_row(h[..], 3, 2).warp == 0 && wire_test_row(h[..], 3, 2).vx == 0;
  // tick 3: a walk (no word), the same life, its velocity from the move
  wire_hist_begin(h[..], 3); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 1.2}, 4, true, true);
  #assert wire_test_row(h[..], 3, 3).life == 2 && wire_test_row(h[..], 3, 3).warp == 0 && wire_test_row(h[..], 3, 3).vx == 3;
  // tick 4: into a boat 1.5 m off (cut): a WARP below WIRE_WARP_M, no velocity drawn through it
  wire_hist_cut(h[..], 3);
  wire_hist_begin(h[..], 4); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 2.7}, 4, true, true);
  #assert wire_test_row(h[..], 3, 4).life == 2 && wire_test_row(h[..], 3, 4).warp == 1 && wire_test_row(h[..], 3, 4).vx == 0;
  // tick 5: the word was used: a walk again
  wire_hist_begin(h[..], 5); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 2.8}, 4, true, true);
  #assert wire_test_row(h[..], 3, 5).life == 2 && wire_test_row(h[..], 3, 5).warp == 1 && wire_test_row(h[..], 3, 5).vx == 3;
  // both words in one tick: the new life wins, its WARP 0
  wire_hist_born(h[..], 3); wire_hist_cut(h[..], 3);
  wire_hist_begin(h[..], 6); wire_hist_put(h[..], 3, WireS.{id = 3, kind = WK_PLAYER, x = 2.8}, 4, true, true);
  #assert wire_test_row(h[..], 3, 6).life == 3 && wire_test_row(h[..], 3, 6).warp == 0;
}
#test "wire: an input's heading goes to 0.1 mrad (#12718)" {
  buf: [WIRE_FRAME] u8;
  n := wire_put_in(buf[..], 0, WireIn.{seq = 3, ky = 100, theta = 1.23456, b = 0, heard = 7});
  t := cast(string) buf[0..<n];
  #assert t == "I 3 0 100 0 0 12346 0 7";
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  i := wire_read_in(t, r[..]);
  #assert r[0].ok && abs(i.theta - 1.2346) < 0.00002 && i.heard == 7;
  // wrapped to -pi..pi
  n = wire_put_in(buf[..], 0, WireIn.{seq = 4, theta = 6.2831853 + 0.5});
  #assert cast(string) buf[0..<n] == "I 4 0 0 0 0 5000 0 0";
}

// ---- the binary wire's table against these writers (#13278)

// A writer's text is written as its row in the table says: it turns into its binary frame, not into
// the table's catch-all, and comes back byte for byte.
wire_test_tabled :: (t: string) -> bool {
  b: [4200] u8; tabled: [1] bool;
  n := wt_bin_told(t, b[..], tabled[..]);
  return n > 0 && tabled[0] && wt_test_round(t, 0);
}
#test "binary wire: the table's row layout is this file's, and every writer here writes what its row says" {
  #assert WT_SF == WIRE_SF && WT_BASES == WIRE_BASES && WT_RUNS == WIRE_PACK_RUNS && WT_BACK_BITS == WIRE_PACK_BACK && WT_D_G == WIRE_PACK_GROUP && WT_B64 == WIRE_B64;
  for g: 0..<WT_RUNS + 1 { #assert WT_RUN_AT[g] == WIRE_PACK_RUN_AT[g]; }
  #assert WT_ROW_FIELDS[WS_X] == "x@cm" && WT_ROW_FIELDS[WS_YAW] == "yaw@crad" && WT_ROW_FIELDS[WS_CARRY] == "carry@0.1ms" && WT_ROW_FIELDS[WS_WARP] == "warp" && WT_ROW_FIELDS[WS_OWNER] == "owner@target";
  b: [512] u8; n := 0;
  n = wire_put_hello(b[..], 0, WireHello.{look = "ranger.2.1.0", kind = "druid", flags = 10, name = "Ash Wood"}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_hello(b[..], 0, WireHello.{look = "", kind = "", flags = 0, name = ""}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_pins(b[..], 0, WirePins.{}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_in(b[..], 0, WireIn.{seq = 41, ky = 100, theta = -1.5708, b = 1, heard = 900}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_cast(b[..], 0, WireCast.{seq = 42, slot = 2, ax = 4, ay = 1.5, az = -7}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_cast(b[..], 0, WireCast.{seq = 42, slot = 2, ax = 4, ay = 1.5, az = -7, tgt = 2003, mode = 3}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_cast(b[..], 0, WireCast.{seq = 42, slot = 2, ax = 4, ay = 1.5, az = -7, tgt = 2003, view = 30000}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_use(b[..], 0, WireUse.{seq = 43, kind = WE_MOUNT, id = 1}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_rebuild(b[..], 0, 44); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_rest(b[..], 0, 45); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_rest_ask(b[..], 0, WireRestAsk.{seq = 41, req = 2}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_rest_state(b[..], 0, WireRestState.{seq = 0, code = WIRE_REST_SLEEP, dice = 3}); #assert wire_test_tabled(cast(string) b[0..<n]);
  k: WireKit; k.n = 3; k.v[1] = wire_kit_v(2, true);
  n = wire_put_kit(b[..], 0, k); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_text(b[..], wire_text(b[..], wire_put_blocks(b[..], 0), "p-aa"), "p-bb"); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_text(b[..], wire_put_blocks(b[..], 0), ""); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_world(b[..], 0, WireWorld.{tick = 900, seed = 12345, day = 600000, weather = 2}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_n(b[..], 0, WireN.{ss = 3, id = "p-aa", look = "ranger.2.1.0", kind = "druid", flags = 2, name = "Ash Wood"}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_n(b[..], 0, WireN.{ss = 149, id = "-", look = "ranger.0.0.0", kind = "druid", flags = 0, name = "-"}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_x(b[..], 0, WIRE_ID_MADE + WIRE_MOUNT_EID + 1); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_cast_e(b[..], 0, WireCastE.{ss = 3, slot = 2, ax = 4, ay = 1.5, az = -7, seed = 12345}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_cast_e(b[..], 0, WireCastE.{ss = 3, slot = 2, ax = 4, ay = 1.5, az = -7, seed = 12345, mode = 2}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_hit(b[..], 0, WireHit.{who = 1002, by = 2970003, amt = 7, kind = 1}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_heal(b[..], 0, 1002, 5); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_die(b[..], 0, 1002); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_stop(b[..], 0, 3, 2, "range"); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_break(b[..], 0, 12, 4, 1.5, -7); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_burn(b[..], 0, 12, true); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_rebuilt(b[..], 0); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_town(b[..], 0); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_outcomes(b[..], 0, 4); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_missed(b[..], 0, 3); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_link(b[..], 0, WireLink.{rate = 15000, used = 4210, dropped = 3, every = 2}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_at(b[..], 0, WireAt.{x = 12.345, y = -0.5, z = -120.004, yaw = 3.5}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_rested(b[..], 0, 3); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_edit(b[..], 0, 4); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_wanted(b[..], 0, 5, 2); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_go(b[..], 0, "pair-e2-7"); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_travel(b[..], 0, 46, "pair-e2-7"); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_refused(b[..], 0, 12, "range"); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_xp(b[..], 0, WireGain.{ss = 3, v = 70}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_level(b[..], 0, WireGain.{ss = 2, v = 4}); #assert wire_test_tabled(cast(string) b[0..<n]);
  for what: 0..<5 { n = wire_put_own(b[..], 0, what, WireOwn.{ss = 2, a = 4107, b = 3, c = 2}); #assert wire_test_tabled(cast(string) b[0..<n]); }
  n = wire_put_rc(b[..], 0, WireRc.{id = 9, ax = 4, ay = 1.5, az = 7, seed = 12345}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_rc(b[..], 0, WireRc.{id = 77, ax = 4, ay = 1.5, az = 7, seed = 12345, from = true, fx = 9, fy = 1.5, fz = 7}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_wm(b[..], 0, WireWm.{kind = 2, caster = 5, foe = 1, ax = 1, ay = 2, az = -3, bx = 4, by = 0.5, bz = 6, flight = 800, life = 1200}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_mend(b[..], 0, 12); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_pburn(b[..], 0, WirePlaced.{i = 3, on = 1}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_pgone(b[..], 0, 4); #assert wire_test_tabled(cast(string) b[0..<n]);
  g := WireRaid.{kind = 1, phase = 2, wave = 3, waves = 5, secs = 40, left = 6, standing = 7, slain = 8, square = 9, wards = 2, arch = 1, folk = 11, levels = 1, cap = 6};
  n = wire_put_raid(b[..], 0, g); #assert wire_test_tabled(cast(string) b[0..<n]);
  g.players_said = true; g.players = 4; n = wire_put_raid(b[..], 0, g); #assert wire_test_tabled(cast(string) b[0..<n]);
  g.siege = true; g.front = 500; n = wire_put_raid(b[..], 0, g); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_you(b[..], 0, WireYou.{ss = 2, level = 3, xp = 900, cap = 2700, lo = 900, hi = 2700}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_you(b[..], 0, WireYou.{ss = 2, level = 3, xp = 900, cap = 2700, lo = 900, hi = 2700, rest_said = true, rest = 1}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_change(b[..], 0, WireChange.{look = "ranger.1.2.3", kind = "srd-fighter-6"}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_admin(b[..], 0, WireAdmin.{verb = WIRE_X_AT, x = 5000, z = -40000, yaw = 0}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_admin(b[..], 0, WireAdmin.{verb = WIRE_X_GUARD, arg = "off"}); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_admin(b[..], 0, WireAdmin.{verb = WIRE_X_HEAL}); #assert wire_test_tabled(cast(string) b[0..<n]);
  // rows, plain and packed, and a whole D of them
  base: [WIRE_SF] s32; now: [WIRE_SF] s32;
  wire_s_pack(WireS.{id = 7, kind = WK_PLAYER, x = 12.34, y = 1, z = -56.78, yaw = 1.5, vx = 3.2, hp = 20, max = 20, life = 5, carry = 0.0123}, now[..]);
  n = wire_put_s(b[..], 0, 7, 0, base[..], now[..]); #assert wire_test_tabled(cast(string) b[0..<n]);
  n = wire_put_s_packed(b[..], 0, WIRE_ID_MADE + WIRE_MON_EID + 3, 5, base[..], now[..], (1 << WIRE_SF) - 1); #assert n > 0 && wire_test_tabled(cast(string) b[0..<n]);
  row := wt_row_of_text(cast(string) b[0..<n]); back := wire_read_row(cast(string) b[0..<n]);
  #assert row.ok && back.ok && row.id == back.id && row.back == back.back && row.mask == back.mask;
  for q: 0..<WIRE_SF { #assert row.d[q] == back.d[q]; }
  d: [512] u8; m := wire_put_d(d[..], 0, WireD.{tick = 900, ack = 41, f = 2, part = 1});
  for i: 0..<n { d[m + i] = b[i]; } m += n; m = wire_sep(d[..], m); for i: 0..<n { d[m + i] = b[i]; } m += n;
  m = wire_put_x(d[..], wire_sep(d[..], m), 7);
  #assert wire_test_tabled(cast(string) d[0..<m]);
  bin: [512] u8; bn := wt_bin(cast(string) d[0..<m], bin[..]); #assert bn > 0 && bn * 4 < m * 3;   // under three quarters of the text
}
// Seat st's frame at h's tick as a binary D into mirror m, read back through the table's text; the frame's bytes.
wire_test_send_bin :: (st: [] WireSeat, h: [] WireHist, m: [] WireMirror, me: int, budget: int, full: bool, kinds: [] int) -> int {
  buf: [65536] u8; text: [131072] u8;
  st[0].bin = true;
  n := wt_d_put(buf[..], 0, h[0].now, 0, ifx full then 1 else 0, 0);
  m0 := n;
  n += wire_seat_frame(st, h, me, 0, 0, 120, budget, buf[n..<buf.count]);
  // every entry is whole, and is a run of rows or an x
  at := m0;
  while at < n {
    e := wt_ent(cast(string) buf[0..<n], at);
    if !e.ok { return -1; }
    k := wt_kind(cast(string) buf[e.a..<e.b]);
    if k != WT_ROWS && k != WT_X { return -1; }
    if k == WT_ROWS && e.b - e.a > WIRE_RUN + 1 { return -1; }
    if kinds.count > 1 { kinds[ifx k == WT_ROWS then 0 else 1] += 1; }
    at = e.b;
  }
  tn := wt_text(cast(string) buf[0..<n], text[..]);
  if tn < 0 { return -1; }
  d := wire_mirror_frame(m, cast(string) text[0..<tn]);
  return ifx d.tick == h[0].now then n - m0 else -1;
}
#test "binary wire: a seat's frame as runs of rows and x entries reads back as its rows, in runs cut at WIRE_RUN" #steps 400000000 {
  h: [1] WireHist; st: [1] WireSeat; m: [1] WireMirror; kinds: [2] int;
  // 120 players near the seat's own: a snapshot of them is several runs
  wire_hist_begin(h[..], 1);
  for q: 0..<120 { wire_test_put(h[..], q, WireS.{id = q, kind = WK_PLAYER, x = f32(q % 12) * 2.5, y = 1, z = f32(q / 12) * 2.5, yaw = 0.25 * f32(q % 7), hp = 20 + q, max = 150, owner = q}); }
  b := wire_test_send_bin(st[..], h[..], m[..], 0, 1000000, true, kinds[..]);
  #assert b > 0 && kinds[0] >= 2 && kinds[1] == 0 && st[0].rows == 120 && m[0].bad == 0;
  for q: 0..<120 { e := wire_mirror_of(m[..], q); #assert e.id == q && e.hp == 20 + q && e.max == 150 && e.owner == q && abs(e.x - f32(q % 12) * 2.5) < 0.006 && abs(e.z - f32(q / 12) * 2.5) < 0.006; }
  // the page heard it: the next tick's rows are deltas against it, a fraction of the bytes
  wire_seat_ack(st[..], h[..], 1);
  wire_hist_begin(h[..], 2);
  for q: 0..<120 { wire_test_put(h[..], q, WireS.{id = q, kind = WK_PLAYER, x = f32(q % 12) * 2.5 + 0.1, y = 1, z = f32(q / 12) * 2.5, yaw = 0.25 * f32(q % 7), hp = 20 + q, max = 150, owner = q}); }
  b2 := wire_test_send_bin(st[..], h[..], m[..], 0, 1000000, false, kinds[..]);
  #assert b2 > 0 && b2 * 3 < b && m[0].bad == 0 && abs(wire_mirror_of(m[..], 77).x - (f32(77 % 12) * 2.5 + 0.1)) < 0.006;
  // ten of them go: each is an x entry, and the page drops it
  wire_seat_ack(st[..], h[..], 2);
  wire_hist_begin(h[..], 3);
  for q: 0..<110 { wire_test_put(h[..], q, WireS.{id = q, kind = WK_PLAYER, x = f32(q % 12) * 2.5 + 0.1, y = 1, z = f32(q / 12) * 2.5, yaw = 0.25 * f32(q % 7), hp = 20 + q, max = 150, owner = q}); }
  kinds[0] = 0; kinds[1] = 0;
  b3 := wire_test_send_bin(st[..], h[..], m[..], 0, 1000000, false, kinds[..]);
  #assert b3 > 0 && kinds[1] == 10 && wire_mirror_of(m[..], 115).id == -1 && wire_mirror_of(m[..], 109).id == 109;
  // the same three ticks to a text page that reads packed rows cost more bytes
  ht: [1] WireHist; tt: [1] WireSeat; mt: [1] WireMirror; tt[0].packed = true;
  wire_hist_begin(ht[..], 1);
  for q: 0..<120 { wire_test_put(ht[..], q, WireS.{id = q, kind = WK_PLAYER, x = f32(q % 12) * 2.5, y = 1, z = f32(q / 12) * 2.5, yaw = 0.25 * f32(q % 7), hp = 20 + q, max = 150, owner = q}); }
  t1 := wire_test_send(tt[..], ht[..], mt[..], 0, 1000000, false, true);
  #assert t1 > b && b * 100 < t1 * 85;   // at least 15% under the packed text
}
