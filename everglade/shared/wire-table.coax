  WtKind.{head = "V", spec = "look:w kind:w", who = WT_PAGE, ex = "V ranger.1.2.3 srd-fighter-6", note = "Change character"},
  WtKind.{head = "X", spec = "verb:w *arg:t", who = WT_PAGE, ex = "X at 5000 -40000 0", note = "a local room's admin line"},
  WtKind.{head = "K", spec = "*pid:w", who = WT_PAGE, ex = "K p-aa p-bb", note = "the players you block"},
  WtKind.{head = "T", spec = "seq:u7@seq code:w", who = WT_PAGE, ex = "T 46 pair-e2-7", note = "go to the instance CODE"},
  WtKind.{head = "O", spec = "n:u7", who = WT_PAGE, ex = "O 3", note = "the page heard fewer outcomes than an o said"},
