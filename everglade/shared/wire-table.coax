  WtKind.{head = "d", spec = "tick:u7@tick id:u7@id kind:u2 x:i8@mm y:i8@mm z:i8@mm dx:i8@thousandths dy:i8@thousandths dz:i8@thousandths body:i7@id", who = WT_ENTRY, ex = "d 930 7 1 5000 0 -9000 0 -1000 0 -1", note = "a projectile ended"},
