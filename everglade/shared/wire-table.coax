// Everglade's binary wire, version 8 (#13278): one table of every frame and entry, and the one
// encoder and decoder that read it. Profile proto/verse/everglade-session-v8.json and its golden
// bytes are written from this table (coax/web/room/wire8-profile.coax); doc
// docs/protocol/everglade-session-v8.md.
//
// A frame is a WebSocket binary message (or a WebTransport datagram or stream record): one opcode
// byte, 128 + the kind's row in WT below, then the kind's fields as bits, the highest bit first,
// padded with zero bits to a whole byte. No text frame starts with a byte of 128 or more, so a
// reader tells the two wires apart by a frame's first byte.
//
// Every field is a whole number in the unit the table names (cm, cm/s, centiradians, 0.1 mrad, ms,
// ticks): the same numbers wire 7 wrote in decimal, so the room decides from the same values and a
// page's prediction runs on the same inputs. The table states each field's unit and its bits.
//   uG   a whole number, 0 or more: groups of G bits, the lowest first, each followed by one bit
//        that says whether another group follows
//   iG   a whole number of either sign: zig-zagged (0, -1, 1, -2 ... as 0, 1, 2, 3 ...), then as uG
//   bG   G bits, 0 to 2^G - 1
//   w    a word: its length as u5, zero bits to the next whole byte, then its bytes
//   n    a name, a record's last field, spaces kept: as a word
//   t    a number or a word: one bit (0 a number, as i7; 1 a word), then it
//   ?    one bit: 1 when the fields after it are said, 0 when the record ends here
//   *F   the rest of the record is F again and again: their count as u4, then each
// The state frame D is its header (tick, ack, flags, part), zero bits to a whole byte, then its
// entries, each its length (one byte under 128, else two: 128 + the high bits, then the low byte)
// and its bytes, which are a frame of their own (an opcode and fields). Rows go as one entry, a
// run: for each row a 1 bit and the row, then a 0 bit.
// A row: its entity's id as u8, BACK as b4, the mask of the fields that changed in two levels
// (which of five runs of fields changed, then each changed run's own bits), then each changed
// field's change as i4. The fields and their units are WT_ROW_FIELDS.
//
// Wire 7's text is the other form of the same table: wt_bin turns a text frame into its binary
// frame and wt_text turns it back, byte for byte, for any text at all (a frame the table has no
// row for, or one that is not written as its row says, goes as WT_ANY: its words, or its bytes).
// A room serves a page on wire 7 through these two (everglade/server/wire-prev.coax).
//   coax/bin/coax test everglade/shared/wire-table.coax

WT_VERSION :: 8;    // the wire version these frames are (everglade-wire.coax WIRE_VERSION, once the room and the pages speak it)
WT_BIN :: 128;      // a binary frame's first byte is its opcode: WT_BIN + its kind
WT_SF :: 23;        // a row's fields (everglade-wire.coax WIRE_SF)
WT_BASES :: 16;     // BACK is under this (WIRE_BASES)
WT_RUNS :: 5; WT_RUN_AT :: [6] int.[0, 5, 8, 13, 18, WT_SF];   // the mask's runs of fields (WIRE_PACK_RUN_AT)
WT_ID_G :: 8; WT_D_G :: 4; WT_BACK_BITS :: 4;   // a row's id's groups, a change's groups, BACK's bits
WT_INT_DIGITS :: 15;   // a number the table carries has at most this many digits; a longer one goes as a word
WT_B64 :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

// Who writes a kind: the room as a frame, the room as an entry of D, a page.
WT_ROOM :: 1; WT_ENTRY :: 2; WT_PAGE :: 3;
WtKind :: struct { head: string; spec: string; who: int; ex: string; note: string; }

// The kinds a writer or reader names in code. A kind's number is its row and never changes; a kind
// that goes keeps its row.
WT_ANY :: 0; WT_D :: 1; WT_ROWS :: 2; WT_ROW :: 3; WT_X :: 4; WT_W :: 5; WT_R :: 6; WT_N :: 10; WT_WANTED :: 11;
WT_LINK :: 14; WT_OUTCOMES :: 15; WT_P :: 47; WT_H :: 48; WT_I :: 49; WT_J1 :: 50; WT_C :: 51; WT_E :: 52;
WT_KINDS :: 63;
WT :: [WT_KINDS] WtKind.[
  WtKind.{head = "", spec = "", who = 0, ex = "q 1 two -3", note = "a frame the table has no row for: one bit, 0 its words (their count as u4, each as t), 1 its bytes as a word"},
  WtKind.{head = "D", spec = "tick:u7@tick ack:u7@seq f:b3@bits part:u3", who = WT_ROOM, ex = "D 900 41 0 0 x 7;o 3", note = "state at TICK; ACK the last input stepped; F 1 a snapshot, 2 more of this tick follows, 4 out of band; then the entries"},
  WtKind.{head = "S", spec = "", who = WT_ENTRY, ex = "SBQCEIA", note = "a run of rows (wire 7: one S entry each)"},
  WtKind.{head = "s", spec = "", who = WT_ENTRY, ex = "s 5 0 3 2 -40", note = "one row, as wire 7's plain s wrote it: the same bits as a row of a run"},
  WtKind.{head = "x", spec = "id:u8@id", who = WT_ENTRY, ex = "x 1170301", note = "an entity gone, or out of your view"},
  WtKind.{head = "W", spec = "tick:u7@tick hz:u6@hz seed:i8 day:u8@ms weather:u3 budget:u7@bytes", who = WT_ROOM, ex = "W 900 30 12345 600000 2 1000", note = "the world header"},
  WtKind.{head = "r", spec = "seq:u7@seq reason:w", who = WT_ROOM, ex = "r 12 range", note = "an intent refused"},
  WtKind.{head = "g", spec = "code:w", who = WT_ROOM, ex = "g pair-e2-7", note = "your travel was taken: join the instance CODE"},
  WtKind.{head = "z", spec = "seq:u7@seq code:u4 dice:u4", who = WT_ROOM, ex = "z 0 3 3", note = "your rest as the rules hold it"},
  WtKind.{head = "b", spec = "n:u5 *v:u4", who = WT_ROOM, ex = "b 3 0 7 200", note = "your bar's counts and effects, slot by slot"},
  WtKind.{head = "n", spec = "ss:u8@seat id:w look:w kind:w flags:u4@bits name:n", who = WT_ENTRY, ex = "n 3 p-aa ranger.2.1.0 druid 2 Ash Wood", note = "who a seat is"},
  WtKind.{head = "w", spec = "ss:u8@seat level:u3", who = WT_ENTRY, ex = "w 5 2", note = "a seat's WANTED level"},
  WtKind.{head = "v", spec = "ss:u8@seat level:u5 xp:u8@xp cap:u8@xp lo:u8@xp hi:u8@xp ? rest:u1", who = WT_ENTRY, ex = "v 2 3 900 2700 900 2700 1", note = "your level and XP"},
  WtKind.{head = "g", spec = "kind:i3 phase:i3 wave:i4 waves:i4 secs:i6@s left:i5 standing:i5 slain:i5 square:i5 wards:i3 arch:i3 outcome:i3 folk:i5 levels:i4 cap:i4 ? players:i5 ? front:i7@cm town:i4 capc:i4 capt:i4", who = WT_ENTRY, ex = "g 1 2 3 5 40 6 7 8 9 2 1 0 11 1 6 4 500 2 1 3", note = "a raid's state"},
  WtKind.{head = "k", spec = "rate:u8@bytes/s used:u8@bytes/s dropped:u5@rows every:u2@ticks", who = WT_ENTRY, ex = "k 15000 4210 3 2", note = "your link, once a second"},
  WtKind.{head = "o", spec = "n:u7", who = WT_ENTRY, ex = "o 4", note = "the outcomes the room has sent this seat"},
  WtKind.{head = "e cast", spec = "ss:u8@seat slot:u4 ax:i8@cm ay:i8@cm az:i8@cm seed:i8 ? mode:u4", who = WT_ENTRY, ex = "e cast 3 2 400 150 -700 12345", note = "a cast the room took"},
  WtKind.{head = "e hit", spec = "who:i7@target by:i7@target amt:i6@hp kind:i4", who = WT_ENTRY, ex = "e hit 1002 2970003 7 1", note = "damage"},
  WtKind.{head = "e heal", spec = "who:i7@target amt:i6@hp", who = WT_ENTRY, ex = "e heal 1002 5", note = "healing"},
  WtKind.{head = "e die", spec = "who:i7@target", who = WT_ENTRY, ex = "e die 1002", note = "a death"},
  WtKind.{head = "e break", spec = "pc:i7 ix:i8@cm iy:i8@cm iz:i8@cm", who = WT_ENTRY, ex = "e break 12 400 150 -700", note = "a piece of the town broken"},
  WtKind.{head = "e burn", spec = "pc:i7 on:u1", who = WT_ENTRY, ex = "e burn 12 1", note = "a piece alight or out"},
  WtKind.{head = "e rebuild", spec = "", who = WT_ENTRY, ex = "e rebuild", note = "the town rebuilt"},
  WtKind.{head = "e edit", spec = "version:u7", who = WT_ENTRY, ex = "e edit 4", note = "the city's edits at VERSION"},
  WtKind.{head = "e stop", spec = "ss:u8@seat slot:u4 why:w", who = WT_ENTRY, ex = "e stop 3 2 range", note = "a cast ended before its strike"},
  WtKind.{head = "e xp", spec = "ss:u8@seat amount:i7@xp", who = WT_ENTRY, ex = "e xp 3 70", note = "XP a seat earned"},
  WtKind.{head = "e level", spec = "ss:u8@seat level:u5", who = WT_ENTRY, ex = "e level 2 4", note = "a seat's level went up"},
  WtKind.{head = "e quest", spec = "ss:u8@seat quest:u7@id stage:u5", who = WT_ENTRY, ex = "e quest 3 1 8", note = "a quest's stage"},
  WtKind.{head = "e item", spec = "ss:u8@seat item:u8@id kind:u7@id slot:u4", who = WT_ENTRY, ex = "e item 2 4107 3 2", note = "an item in the bag"},
  WtKind.{head = "e coin", spec = "ss:u8@seat coin:i8", who = WT_ENTRY, ex = "e coin 0 1250", note = "the coin a seat holds"},
  WtKind.{head = "e say", spec = "ss:u8@seat dialogue:u7@id", who = WT_ENTRY, ex = "e say 15 2", note = "a dialogue line told"},
  WtKind.{head = "e loot", spec = "ss:u8@seat kind:u7@id", who = WT_ENTRY, ex = "e loot 1 3", note = "an item dropped for a seat"},
  WtKind.{head = "e rc", spec = "id:u8@id k:u4 ax:i8@cm ay:i8@cm az:i8@cm seed:i8 ? fx:i8@cm fy:i8@cm fz:i8@cm", who = WT_ENTRY, ex = "e rc 77 0 400 150 700 12345 900 150 700", note = "a raid creature's cast"},
  WtKind.{head = "e wm", spec = "kind:u4 caster:i7 foe:i7 ax:i8@cm ay:i8@cm az:i8@cm bx:i8@cm by:i8@cm bz:i8@cm flight:u8@ms life:u8@ms", who = WT_ENTRY, ex = "e wm 2 5 1 100 200 -300 400 50 600 800 1200", note = "a guard's spell in flight"},
  WtKind.{head = "e mend", spec = "code:i7", who = WT_ENTRY, ex = "e mend 12", note = "a Repair stood pieces up"},
  WtKind.{head = "e pburn", spec = "i:u7 on:u1", who = WT_ENTRY, ex = "e pburn 3 1", note = "a placed thing alight or out"},
  WtKind.{head = "e pgone", spec = "i:u7", who = WT_ENTRY, ex = "e pgone 4", note = "a placed thing burnt through"},
  WtKind.{head = "e town", spec = "", who = WT_ENTRY, ex = "e town", note = "the town's pieces sent again have all come"},
  WtKind.{head = "e rest", spec = "seat:u8@seat", who = WT_ENTRY, ex = "e rest 3", note = "a seat rested"},
  WtKind.{head = "e mon", spec = "tick:u7@tick kind:u3 m:u4 seat:i6@seat amount:u6@hp ? fx:i8@cm fz:i8@cm tx:i8@cm tz:i8@cm fly:u8@ms", who = WT_ENTRY, ex = "e mon 90 3 10 0 0 500 -30000 520 -31000 700", note = "what a monster did or took"},
