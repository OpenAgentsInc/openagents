// Housewright (game): Everglade's five house tiers and the stages each is built in
// (everglade/docs/housewright-profession-spec.md, section 6), as staged-build parts of the engine
// (metaverse-engine/world/build-site.coax). Each tier is authored in its own frame: the front, where you go in,
// faces +z, the ground is y 0 and the house's middle is (0, 0). A zone places a tier at a
// BuildingFrame; Everglade Experimental's showcase (verse/experimental-terrain.coax exp_showcase)
// stands every tier at every stage in a row. The timber house is the player's home's Medieval
// Village MegaKit house (everglade/world/home.coax) on a stone sill.
#module "everglade.housewright";
#load "../../metaverse-engine/world/build-site.coax" as bs;
#load "../../metaverse-engine/world/building.coax" as building;
#load "../../metaverse-engine/world/build-work.coax" as bw;

HW_TIERS :: 5;
HW_LEANTO :: 0;
HW_HUT :: 1;
HW_COTTAGE :: 2;
HW_TIMBER :: 3;
HW_STONE :: 4;
HW_STAGES :: [5]int.[3,4,7,5,5];
hw_stages :: (tier:int)->int {return HW_STAGES[tier];}
// The first of a tier's stages among all of them (the label table's order).
hw_stage_base :: (tier:int)->int {n:=0;for t:0..<tier {n+=HW_STAGES[t];}return n;}
// What you read at a house frozen at a stage.
HW_LABELS :: [24]string.[
 "Branch lean-to, 1 of 3: uprights and ridge pole","Branch lean-to, 2 of 3: branches laid","Branch lean-to, 3 of 3: covered with boughs",
 "Woven hut, 1 of 4: posts set","Woven hut, 2 of 4: walls woven","Woven hut, 3 of 4: roof poles lashed","Woven hut, 4 of 4: thatched",
 "Wattle-and-daub cottage, 1 of 7: ditch dug","Wattle-and-daub cottage, 2 of 7: foundation laid","Wattle-and-daub cottage, 3 of 7: frame raised",
 "Wattle-and-daub cottage, 4 of 7: wattle woven","Wattle-and-daub cottage, 5 of 7: walls daubed","Wattle-and-daub cottage, 6 of 7: roof thatched",
 "Wattle-and-daub cottage, 7 of 7: hearth and floor laid",
 "Timber house, 1 of 5: stone sill laid","Timber house, 2 of 5: frame raised and pegged","Timber house, 3 of 5: roof framed",
 "Timber house, 4 of 5: walls boarded","Timber house, 5 of 5: roofed and fitted",
 "Stone cottage, 1 of 5: footings laid","Stone cottage, 2 of 5: walls to the sills","Stone cottage, 3 of 5: walls and gables raised",
 "Stone cottage, 4 of 5: roof timbers and chimney","Stone cottage, 5 of 5: thatched and the door hung"];
hw_label :: (tier:int,stage:int)->string {return HW_LABELS[hw_stage_base(tier)+stage-1];}
// How far each tier reaches from its middle: to its sides (x) and to its front and back (z).
HW_REACH :: [5][3]f32.[[3]f32.[3.05,1.1,1.25],[3]f32.[2.65,1.95,1.95],[3]f32.[2.45,2.75,3.25],[3]f32.[2.8,2.85,2.85],[3]f32.[3.75,3.1,3.1]];
// Where you stand just outside a tier's doorway and just inside it (the lean-to has none: you crawl
// under its open front).
hw_door_out :: (tier:int)->[2]f32 {d:=[5][2]f32.[[2]f32.[0,2.2],[2]f32.[0,2.5],[2]f32.[0,3.3],[2]f32.[-1,2.9],[2]f32.[-0.8,3.3]];return d[tier];}
hw_door_in :: (tier:int)->[2]f32 {d:=[5][2]f32.[[2]f32.[0,0.9],[2]f32.[0,0.2],[2]f32.[0,0.9],[2]f32.[-1,1.0],[2]f32.[-0.8,1.0]];return d[tier];}

// The Medieval Village MegaKit pieces the timber house is built of.
HW_KIT :: [10]string.["Floor_WoodDark","Wall_WoodWear_Door_Flat","DoorFrame_Flat_WoodDark","Door_1_Flat","Wall_WoodWear_Window_Wide_Flat","Window_Wide_Flat1","Wall_WoodWear_Straight","Window_Wide_Flat2","Roof_RoundTiles_4x4","Roof_Front_Wood4"];

// The parts: tier, then the engine's row (stage, form, material, x0, y0, z0, x1, y1, z1, t, a).
// Forms: 0 pole, 1 beam, 2 wall, 3 ring, 4 shed, 5 gable, 6 cone, 7 slab, 8 trench, 9 stones,
// 10 gable end, 11 kit. Materials: 0 bark, 1 timber, 2 withy, 3 daub, 4 fieldstone, 5 ashlar,
// 6 reed, 7 leaf, 8 earth, 9 flagstone, 10 plank, 11 hide.
HW_PARTS :: 146;
HW_ROWS :: [HW_PARTS][12]f32.[
