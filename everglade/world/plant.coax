// Everglade v2's planting (docs/verse/everglade2.md): which Stylized Nature kit pieces stand where
// in the woods round the path and the clearing, as a pure function of the land
// (everglade/world/forest.coax). The pack tool (metaverse/tools/assets/everglade2_pack.coax) packs
// the pieces named here; the page (everglade/client/client.coax) plants them at load and
// draws the ones in view. The glade's own composition stays in the glade's pack mesh.
#load "forest.coax";
#load "meadow.coax";   // the open meadow's understory, shared with the druid's field

// The kit: the pack's templates, in this order. Trees have three levels of detail (0 whole, 1 two of the
// crown's cards in three and a plain trunk, 2 one card in three: the same cards in the same places,
// so a tree keeps its shape as it thins); the rest one.
E2_KITS :: 36;
E2_KIT_NAME :: [36] string.["CommonTree_1","CommonTree_2","CommonTree_3","CommonTree_4","CommonTree_5",
 "Birch_1","Birch_2","Birch_3","Birch_4","Birch_5","Pine_1","Pine_2","Pine_3","Pine_4","Pine_5",
 "Bush_Common","Bush_Common_Flowers","Bush_Long_1","Fern_1","Fern_2",
 "Rock_Medium_1","Rock_Medium_2","Rock_Medium_3","Rock_Big_1","Rock_Big_2",
 "Flower_3_Group","Flower_2_Group","Flower_4_Group","Mushroom_Common","Plant_1","Plant_3","Clover_1","Pebble_Round_1",
 "Grass_Common_Short","Grass_Wide_Short","Grass_Wispy_Short"];
E2_TREES :: 15;          // kits 0 to 14 are trees
E2_GRASS :: 33;          // kits 33 to 35 are the glade's grass, as tufts
E2_LODS :: 3;
// How far each kit reaches (metres: past E2_FAR_START of it the kit thins out by rank, everglade/client/client.coax
// e2_piece_shown), and where a tree's levels of detail start.
E2_KIT_FAR :: [36] f32.[165,165,165,165,165,165,165,165,165,165,165,165,165,165,165,
 95,95,95,80,80, 110,110,110,240,240, 45,45,45,26,45,55,40,26, 42,42,42];
E2_LOD1 :: 32.0; E2_LOD2 :: 52.0;   // past these a tree draws its level 1, then 2 (cross-faded: everglade/client/client.coax e2_piece_looks)
E2_CELL :: 16.0;         // metres a planting cell
E2_CELLS_X :: 27; E2_CELLS_Z :: 46;
E2_CELL_X0 :: -200.0; E2_CELL_Z0 :: 80.0;   // the first cell's west and north... south edge: cells run to -z
E2_ITEMS :: 170000;      // the most kit pieces planted
E2_ITEM_FLOATS :: 8;     // x y z yaw, vertical scale, horizontal scale, red*65280+green*255 (bytes), blue (+2: grass)

// Rows j0 to j1 of the woods planted alone, for the checks below: the pieces, the trees, the trees
// close beside the path, and the pieces out of place (on the path; a tree on the road or in the
// clearing). The whole planting is 71,384 pieces and takes a native check 6 s on an idle host, 30 to
// 40 s on a busy one, of the 120 s one check may run, so each check plants a band of rows (#13392).
e2_plant_tally :: (j0:int,j1:int)->[4]int {
 f:[E2_ITEMS*E2_ITEM_FLOATS]f32;k:[E2_ITEMS]u8;first:[E2_CELLS_X*E2_CELLS_Z+1]int;
 n:=e2_plant_rows(f[..],k[..],first[..],e2_rows(j0,j1));t:=[4]int.[n,0,0,0];
 if first[E2_CELLS_X*E2_CELLS_Z]!=n || first[j0*E2_CELLS_X]!=0 {t[3]+=1;}
 for i:0..<n {x:=f[i*8];z:=f[i*8+2];if e2_path(x,z)>0.35 {t[3]+=1;}
  if int(k[i])<E2_TREES {t[1]+=1;if !((e2_road_dist(x,z)>2.5 || z>9) && e2_clearing(x,z)<0.5) {t[3]+=1;}
   if e2_road_dist(x,z)<9 && z< -60 && z>E2_CLEAR_Z+E2_CLEAR_R {t[2]+=1;}}}
 return t;
}
// Six bands hold the whole land's claim: more than 6 x 3,400 = 20,400 pieces and 6 x 1,400 = 8,400
// trees, more than 200 trees close beside the path (rows 16 to 31), and fewer pieces than fit
// (6 x 28,000 < E2_ITEMS).
#test "the woods are planted, dense beside the path, none on it or in the clearing" #steps 4000000000 {
 t:=e2_plant_tally(16,24);#assert t[0]>3400 && t[0]<28000 && t[1]>1400 && t[2]>100 && t[3]==0;
 #assert 6*28000<E2_ITEMS;
}
#test "the woods are planted: rows 24 to 31, dense beside the path" #steps 4000000000 {
 t:=e2_plant_tally(24,32);#assert t[0]>3400 && t[0]<28000 && t[1]>1400 && t[2]>100 && t[3]==0;
}
#test "the woods are planted: rows 0 to 7" #steps 4000000000 {
 t:=e2_plant_tally(0,8);#assert t[0]>3400 && t[0]<28000 && t[1]>1400 && t[3]==0;
}
#test "the woods are planted: rows 8 to 15" #steps 4000000000 {
 t:=e2_plant_tally(8,16);#assert t[0]>3400 && t[0]<28000 && t[1]>1400 && t[3]==0;
}
#test "the woods are planted: rows 32 to 39" #steps 4000000000 {
 t:=e2_plant_tally(32,40);#assert t[0]>3400 && t[0]<28000 && t[1]>1400 && t[3]==0;
}
#test "the woods are planted: rows 40 to 45" #steps 4000000000 {
 t:=e2_plant_tally(40,E2_CELLS_Z);#assert t[0]>3400 && t[0]<28000 && t[1]>1400 && t[3]==0;
}
#test "rows planted alone are the whole planting's rows, and every row is the whole planting" {
 // one cell's pieces by e2_plant_cell are what a band holds for it, and the mask of every row is e2_plant's
 #assert e2_rows(0,E2_CELLS_Z)==E2_ROWS_ALL && e2_rows(4,6)==48 && e2_rows(7,7)==0;
 f:[2000*E2_ITEM_FLOATS]f32;k:[2000]u8;first:[E2_CELLS_X*E2_CELLS_Z+1]int;
 n:=e2_plant_rows(f[..],k[..],first[..],e2_rows(23,24));#assert n>1000 && first[23*E2_CELLS_X]==0 && first[24*E2_CELLS_X]==n && first[E2_CELLS_X*E2_CELLS_Z]==n;
 a:[157*E2_ITEM_FLOATS]f32;ak:[157]u8;m:=e2_plant_cell(a[..],ak[..],0,13,23);c:=23*E2_CELLS_X+13;
 #assert m>0 && first[c+1]-first[c]==m;
 for q:0..<m {#assert ak[q]==k[first[c]+q];for w:0..<E2_ITEM_FLOATS {#assert f32_bits(a[q*E2_ITEM_FLOATS+w])==f32_bits(f[(first[c]+q)*E2_ITEM_FLOATS+w]);}}
}
e2_tint :: (out:[]f32,o:int,r:f32,g:f32,b:f32) {out[o+6]=floor(r*255+0.5)*256+floor(g*255+0.5);out[o+7]=b;}
e2_put :: (out:[]f32,kinds:[]u8,n:int,kit:int,x:f32,y:f32,z:f32,yaw:f32,sv:f32,sh:f32,c:[3]f32)->int {
 if n>=E2_ITEMS {return n;}
 o:=n*E2_ITEM_FLOATS;out[o]=x;out[o+1]=y;out[o+2]=z;out[o+3]=yaw;out[o+4]=sv;out[o+5]=sh;e2_tint(out,o,c[0],c[1],c[2]);kinds[n]=cast(u8)kit;return n+1;
}
// A cell's west x and north z.
e2_cell_x :: (i:int)->f32 {return f32(E2_CELL_X0)+f32(i)*f32(E2_CELL);}
e2_cell_z :: (j:int)->f32 {return f32(E2_CELL_Z0)-f32(j)*f32(E2_CELL);}
// Every cell's pieces, cell by cell (first[c] the first of cell c = j * E2_CELLS_X + i); the count.
e2_plant :: (out:[]f32,kinds:[]u8,first:[]int)->int {return e2_plant_rows(out,kinds,first,E2_ROWS_ALL);}
// The same with only the rows of cells in `rows` planted (bit j: row j); every other cell is empty.
// A check plants the rows it stands in (#13392).
E2_ROWS_ALL :: 0x3FFFFFFFFFFF;           // E2_CELLS_Z rows
e2_rows :: (j0:int,j1:int)->u64 {m:u64=0;for j:j0..<j1 {m=m|(cast(u64)1<<cast(u64)j);}return m;}
e2_plant_rows :: (out:[]f32,kinds:[]u8,first:[]int,rows:u64)->int {
 n:=0;
 for j:0..<E2_CELLS_Z {for i:0..<E2_CELLS_X {c:=j*E2_CELLS_X+i;first[c]=n;if ((rows>>cast(u64)j)&1)!=0 {n=e2_plant_cell(out,kinds,n,i,j);}}}
 first[E2_CELLS_X*E2_CELLS_Z]=n;return n;
}
// ---- the planting baked into the pack (docs/verse/fast-loads.md, #13150)
// e2_plant takes 1.8 s of a page's first frame, so build.sh plants once and writes the answer into
// the pack's catalog as P lines (metaverse/tools/assets/everglade2_plant.coax): base64 of a record of
// "E2P1", the count, the cells, then first[] (u32 each), the pieces' floats (their bits, u32 each)
// and their kinds (a byte each), little-endian. A page reads it back (e2p_from_catalog) and checks a
// few cells against e2_plant_cell (e2p_agrees) before it takes it; else it plants as it did.
#load "../../coax/lib/text/base64.coax";
E2P_MAGIC :: 0x31503245;                 // "E2P1"
E2P_CELLS :: E2_CELLS_X*E2_CELLS_Z;
E2P_HEAD :: 12;
E2P_LINE :: 3072;                        // bytes a P line carries
e2p_size :: (n:int)->int {return E2P_HEAD+4*(E2P_CELLS+1)+n*(4*E2_ITEM_FLOATS+1);}
// The record's byte at b.
e2p_byte :: (items:[]f32,kinds:[]u8,first:[]int,n:int,b:int)->u8 {
 kat:=E2P_HEAD+4*(E2P_CELLS+1)+n*4*E2_ITEM_FLOATS;
 if b>=kat {return kinds[b-kat];}
 w:=b/4;v:u32=0;
 if w==0 {v=cast(u32)E2P_MAGIC;} else if w==1 {v=cast(u32)n;} else if w==2 {v=cast(u32)E2P_CELLS;}
 else if w<3+E2P_CELLS+1 {v=cast(u32)first[w-3];} else {v=f32_bits(items[w-3-(E2P_CELLS+1)]);}
 return cast,trunc(u8)(v>>cast(u32)(8*(b%4)));
}
// The planting as P lines into out: the length, or -1 when out is too small.
e2p_lines :: (items:[]f32,kinds:[]u8,first:[]int,n:int,out:[]u8)->int {
 size:=e2p_size(n);at:=0;r:=0;chunk:[E2P_LINE]u8;
 while r<size {
  e:=ifx r+E2P_LINE<size then r+E2P_LINE else size;
  for b:r..<e {chunk[b-r]=e2p_byte(items,kinds,first,n,b);}
  if at+2+b64_encoded_size(e-r)+1>out.count {return -1;}
  out[at]='P';out[at+1]=' ';at+=2;
  at+=b64_encode(cast(string)chunk[0..<e-r],out[at..<out.count]);out[at]='\n';at+=1;r=e;
 }
 return at;
}
// The planting back out of a catalog's P lines into items, kinds and first: the count, 0 with no
// lines, -1 refused (a bad line, magic, count, cell count, length or an unordered first[]).
e2p_from_catalog :: (text:string,items:[]f32,kinds:[]u8,first:[]int)->int {
 at:=0;n:=-1;size:=0;word:u32=0;p:=0;chunk:[E2P_LINE+4]u8;kat:=0;
 lut:[256]int;for i:0..<256 {lut[i]=-1;}for i:0..<64 {lut[cast(int)B64_CHARS[i]]=i;}
 while p<text.count {
  e:=p;while e<text.count && text[e]!='\n' {e+=1;}
  if e-p>2 && text[p]=='P' && text[p+1]==' ' {
   if b64_decoded_max(e-p-2)>chunk.count {return -1;}
   m:=e2p_b64(text[p+2..<e],lut[..],chunk[..]);if m<0 {return -1;}
   q:=0;
   while q<m {
    // whole words past the header: a cell's start or a float, four bytes at once
    if n>=0 && at%4==0 && q+4<=m && at+4<=kat && at>=E2P_HEAD {
     v:=cast(u32)chunk[q]|(cast(u32)chunk[q+1]<<8)|(cast(u32)chunk[q+2]<<16)|(cast(u32)chunk[q+3]<<24);w:=at/4;
     if w<3+E2P_CELLS+1 {first[w-3]=cast(int)v;} else {items[w-3-(E2P_CELLS+1)]=f32_from_bits(v);}
     at+=4;q+=4;continue;}
    c:=chunk[q];q+=1;if n>=0 && at>=size {return -1;}
    if n>=0 && at>=kat {kinds[at-kat]=c;at+=1;continue;}
    word=word|(cast(u32)c<<cast(u32)(8*(at%4)));
    if at%4==3 {w:=at/4;
     if w==0 {if word!=cast(u32)E2P_MAGIC {return -1;}}
     else if w==1 {if word>cast(u32)E2_ITEMS || cast(int)word>items.count/E2_ITEM_FLOATS || cast(int)word>kinds.count {return -1;}n=cast(int)word;size=e2p_size(n);kat=size-n;}
     else if w==2 {if word!=cast(u32)E2P_CELLS || first.count<E2P_CELLS+1 {return -1;}}
     else if w<3+E2P_CELLS+1 {first[w-3]=cast(int)word;}
     else {items[w-3-(E2P_CELLS+1)]=f32_from_bits(word);}
     word=0;}
    at+=1;
   }
  }
  p=e+1;
 }
 if at==0 {return 0;}
 if n<0 || at!=size || first[0]!=0 || first[E2P_CELLS]!=n {return -1;}
 for c:0..<E2P_CELLS {if first[c+1]<first[c] {return -1;}}
 return n;
}
// A P line's base64 into out by the table lut (each character's value, -1 for none): the length,
// or -1. Four characters at a time, as e2p_lines writes them; '=' only at the line's end.
e2p_b64 :: (t:string,lut:[]int,out:[]u8)->int {
 if t.count%4!=0 {return -1;}
 n:=0;i:=0;
 while i<t.count {
  pad:=0;if i+4==t.count {if t[i+3]=='=' {pad=1;if t[i+2]=='=' {pad=2;}}}
  a:=lut[cast(int)t[i]];b:=lut[cast(int)t[i+1]];c:=ifx pad==2 then 0 else lut[cast(int)t[i+2]];d:=ifx pad>=1 then 0 else lut[cast(int)t[i+3]];
  if a<0 || b<0 || c<0 || d<0 || n+3-pad>out.count {return -1;}
  v:=(a<<18)|(b<<12)|(c<<6)|d;
  out[n]=cast(u8)((v>>16)&255);if pad<2 {out[n+1]=cast(u8)((v>>8)&255);}if pad<1 {out[n+2]=cast(u8)(v&255);}
  n+=3-pad;i+=4;
 }
 return n;
}
#test "a P line's base64 reads as the library's does" {
 lut:[256]int;for i:0..<256 {lut[i]=-1;}for i:0..<64 {lut[cast(int)B64_CHARS[i]]=i;}
 all:[256]u8;text:[344]u8;back:[256]u8;for i:0..<256 {all[i]=cast(u8)i;}
 for ln:[5]int.[0,1,2,3,256] {k:=b64_encode(cast(string)all[0..<ln],text[..]);#assert e2p_b64(cast(string)text[0..<k],lut[..],back[..])==ln;for i:0..<ln {#assert back[i]==all[i];}}
 #assert e2p_b64("Zg=a",lut[..],back[..])== -1 && e2p_b64("Zm9",lut[..],back[..])== -1 && e2p_b64("Zm9!",lut[..],back[..])== -1 && e2p_b64("Zm9v",lut[..],back[0..<2])== -1;
}
// Do these cells of a planting hold what e2_plant_cell plants there, bit for bit? The spawn's cell
// and seven spread over the woods: 8 of the 1,242, 1.5 ms each in a page.
E2P_SPOT :: [8][2]int.[[2]int.[12,5],[2]int.[4,4],[2]int.[22,4],[2]int.[4,40],[2]int.[22,40],[2]int.[13,23],[2]int.[6,31],[2]int.[20,12]];
e2p_agrees :: (items:[]f32,kinds:[]u8,first:[]int,n:int)->bool {
 for spot:E2P_SPOT {
  c:=spot[1]*E2_CELLS_X+spot[0];a:=first[c];b:=first[c+1];
  if a<0 || b<a || b>n || b-a>157 {return false;}
  out:[157*E2_ITEM_FLOATS]f32;k:[157]u8;
  m:=e2_plant_cell(out[..],k[..],0,spot[0],spot[1]);
  if m!=b-a {return false;}
  for q:0..<m {if k[q]!=kinds[a+q] {return false;}
   for w:0..<E2_ITEM_FLOATS {if f32_bits(out[q*E2_ITEM_FLOATS+w])!=f32_bits(items[(a+q)*E2_ITEM_FLOATS+w]) {return false;}}}
 }
 return true;
}
E2PCheck :: struct {
 a:[E2_ITEMS*E2_ITEM_FLOATS]f32;ak:[E2_ITEMS]u8;af:[E2P_CELLS+1]int;
 b:[E2_ITEMS*E2_ITEM_FLOATS]f32;bk:[E2_ITEMS]u8;bf:[E2P_CELLS+1]int;
 lines:[8000000]u8;
}
#test "the planting baked into P lines reads back as e2_plant plants it, byte for byte" #steps 8000000000 {
 // the six rows the spot check reads (E2P_SPOT), 9,500 pieces: the record's layout, its lines and the
 // spot check are the same for any planting, and the whole one is 6 s of a busy host's 120 (#13392).
 // The build writes the whole planting (metaverse/tools/assets/everglade2_plant.coax) and a page holds it to e2p_agrees.
 t:[1]E2PCheck;rows:u64=0;for spot:E2P_SPOT {rows=rows|e2_rows(spot[1],spot[1]+1);}
 n:=e2_plant_rows(t[0].a[..],t[0].ak[..],t[0].af[..],rows);#assert n>8000;
 // the lines among a catalog's others
 text:="C glade/environment 9 12 250 100 8 0\nG AAAA\n";o:=text.count;for i:0..<o {t[0].lines[i]=text[i];}
 ln:=e2p_lines(t[0].a[..],t[0].ak[..],t[0].af[..],n,t[0].lines[o..<t[0].lines.count]);#assert ln>e2p_size(n);
 all:=cast(string)t[0].lines[0..<o+ln];
 m:=e2p_from_catalog(all,t[0].b[..],t[0].bk[..],t[0].bf[..]);#assert m==n;
 for i:0..<n*E2_ITEM_FLOATS {#assert f32_bits(t[0].a[i])==f32_bits(t[0].b[i]);}
 for i:0..<n {#assert t[0].ak[i]==t[0].bk[i];}
 for c:0..<E2P_CELLS+1 {#assert t[0].af[c]==t[0].bf[c];}
 #assert e2p_agrees(t[0].b[..],t[0].bk[..],t[0].bf[..],m);
 #assert e2p_from_catalog(text,t[0].b[..],t[0].bk[..],t[0].bf[..])==0;
 // a planting that is not this one: a moved tree in the spawn's cell, or a kind, is refused by the spot check
 full:=0;
 for spot:E2P_SPOT {c:=spot[1]*E2_CELLS_X+spot[0];f:=t[0].bf[c];if t[0].bf[c+1]==f {continue;}full+=1;
  t[0].b[f*E2_ITEM_FLOATS+1]+=0.001;#assert !e2p_agrees(t[0].b[..],t[0].bk[..],t[0].bf[..],m);t[0].b[f*E2_ITEM_FLOATS+1]=t[0].a[f*E2_ITEM_FLOATS+1];
  t[0].bk[f]+=1;#assert !e2p_agrees(t[0].b[..],t[0].bk[..],t[0].bf[..],m);t[0].bk[f]-=1;}
 #assert full>=7;
 #assert e2p_agrees(t[0].b[..],t[0].bk[..],t[0].bf[..],m);
 // a damaged record is refused: a short one, a wrong magic, a bad character
 #assert e2p_from_catalog(cast(string)t[0].lines[0..<o+ln-4100],t[0].b[..],t[0].bk[..],t[0].bf[..])== -1;
 c0:=t[0].lines[o+2];t[0].lines[o+2]='A';#assert e2p_from_catalog(all,t[0].b[..],t[0].bk[..],t[0].bf[..])== -1;t[0].lines[o+2]=c0;
 c1:=t[0].lines[o+10];t[0].lines[o+10]='!';#assert e2p_from_catalog(all,t[0].b[..],t[0].bk[..],t[0].bf[..])== -1;t[0].lines[o+10]=c1;
 #assert e2p_from_catalog(all,t[0].b[..],t[0].bk[..],t[0].bf[..])==n;
}
E2_TREE_STEP :: 2.6;
e2_plant_cell :: (out:[]f32,kinds:[]u8,n0:int,i:int,j:int)->int {
 n:=n0;x0:=e2_cell_x(i);z0:=e2_cell_z(j);cs:=f32(E2_CELL);seed:=f32(i*131+j*977);
 // trees on a jittered grid
 steps:=int(cs/f32(E2_TREE_STEP));
 for a:0..<steps {for b:0..<steps {
  h:=seed+f32(a*7+b*13);
  x:=x0+(f32(a)+0.15+0.7*cg_hash(h,1))*f32(E2_TREE_STEP);z:=z0-(f32(b)+0.15+0.7*cg_hash(h,2))*f32(E2_TREE_STEP);
  if x<E2_WEST+4 || x>E2_EAST-4 || z<E2_FAR+4 || z>E2_BACK-4 {continue;}
  f:=e2_forest(x,z);if cg_hash(h,3)>f*0.97 {continue;}
  rd:=e2_road_dist(x,z);if (rd<2.6 && z<9) || e2_path(x,z)>0.05 || e2_clearing(x,z)>0.3 {continue;}
  au:=e2_autumn(x,z);r:=cg_hash(h,4);v:=int(cg_hash(h,5)*4.999);big:=1.0f32+0.35f32*cg_ramp(10,30,rd);
  sz:=cg_hash(h,6);yaw:=cg_hash(h,7)*6.283;stretch:=1+cg_hash(h,8)*0.3;
  kit:=0;c:=[3]f32.[0.50,0.80,0.10];s:f32=1;
  greens:=[4][3]f32.[[3]f32.[0.50,0.80,0.10],[3]f32.[0.42,0.72,0.12],[3]f32.[0.58,0.82,0.14],[3]f32.[0.36,0.66,0.10]];
  golds:=[5][3]f32.[[3]f32.[1.0,0.22,0.025],[3]f32.[1.0,0.55,0.09],[3]f32.[1.0,0.72,0.18],[3]f32.[1.0,0.65,0.12],[3]f32.[1.0,0.30,0.035]];
  pines:=[3][3]f32.[[3]f32.[0.20,0.45,0.12],[3]f32.[0.26,0.52,0.14],[3]f32.[0.16,0.40,0.11]];
  pick:=int(cg_hash(h,9)*3.999);
  if au>0.5 {
   if r<0.5 {kit=5+v;c=golds[int(cg_hash(h,9)*4.999)];s=0.38+sz*0.24;}
   else if r<0.85 {kit=v;c=golds[1+int(cg_hash(h,9)*2.999)];s=0.55+sz*0.35;}
   else {kit=10+v;c=pines[pick%3];s=0.6+sz*0.45;}
  } else {
   if r<0.5 {kit=v;c=greens[pick];s=0.55+sz*0.35;}
   else if r<0.8 {kit=10+v;c=pines[pick%3];s=0.6+sz*0.45;}
   else {kit=5+v;c=ifx cg_hash(h,10)<0.35 then golds[2] else [3]f32.[0.62,0.82,0.18];s=0.38+sz*0.24;}
  }
  s=s*big;
  n=e2_put(out,kinds,n,kit,x,e2_height(x,z)-0.08,z,yaw,s*stretch,s,c);
 }}
 // the understory: flowers, ferns, bushes, rocks, mushrooms and plants
 for q:0..<120 {
  h:=seed*1.37+f32(q)*3.1+0.5;
  x:=x0+cg_hash(h,11)*cs;z:=z0-cg_hash(h,12)*cs;
  if x<E2_WEST+2 || x>E2_EAST-2 || z<E2_FAR+2 || z>E2_BACK-2 {continue;}
  o:=e2_wooded(x,z);if o<0.2 || e2_path(x,z)>0.3 {continue;}
  rd:=e2_road_dist(x,z);f:=e2_forest(x,z);cl:=e2_clearing(x,z);au:=e2_autumn(x,z);
  verge:=rd>1.6 && rd<6 && cl<0.5;
  p:=ifx verge then 0.95f32 else ifx cl>0.5 then f32(E2_MEADOW_DENSITY) else ifx f>0.2 then (ifx rd<35 then 0.8f32 else 0.15f32) else 0.12f32;
  if cg_hash(h,13)>p {continue;}
  r:=cg_hash(h,14);sz:=cg_hash(h,15);yaw:=cg_hash(h,16)*6.283;y:=e2_height(x,z);
  green:=[3]f32.[0.36,0.80,0.08];fern:=ifx cg_hash(h,17)<0.5 then [3]f32.[0.32,0.65,0.045] else [3]f32.[0.23,0.53,0.035];
  orange:=ifx cg_hash(h,17)<0.5 then [3]f32.[1,0.30,0.03] else [3]f32.[1,0.44,0.05];
  rock:=[3]f32.[0.60+0.08*cg_hash(h,18),0.62+0.06*cg_hash(h,18),0.50];
  bush:=ifx au>0.6 && cg_hash(h,19)<0.5 then [3]f32.[0.70,0.62,0.10] else [3]f32.[0.35,0.78,0.055];
  if cl>0.5 {   // open meadow: the shared meadow's understory (meadow.coax)
   pk:=e2_meadow_pick(h,au);n=e2_put(out,kinds,n,pk.kit,x,y-pk.sink,z,yaw,pk.sv,pk.sh,pk.tint);
   continue;
  }
  if verge {
   if r<0.28 {k:=25+int(cg_hash(h,20)*2.999);s:=0.12+sz*0.13;n=e2_put(out,kinds,n,k,x,y,z,yaw,s,s,[3]f32.[0.4,0.75,0.05]);}
   else if r<0.42 {s:=0.22+sz*0.2;n=e2_put(out,kinds,n,18+int(cg_hash(h,20)*1.999),x,y,z,yaw,s,s,fern);}
   else if r<0.55 {s:=0.5+sz*0.4;n=e2_put(out,kinds,n,15+int(cg_hash(h,20)*2.999),x,y,z,yaw,s,s,bush);}
   else if r<0.66 {s:=0.3+sz*0.25;n=e2_put(out,kinds,n,29+int(cg_hash(h,20)*1.999),x,y,z,yaw,s,s,ifx au>0.4 then orange else green);}
   else if r<0.76 {s:=0.2+sz*0.3;n=e2_put(out,kinds,n,ifx cg_hash(h,20)<0.5 then 32 else 20,x,y-0.08*s,z,yaw,s,s,rock);}
   else if r<0.87 {s:=0.5+sz*0.35;n=e2_put(out,kinds,n,28,x,y,z,yaw,s*0.75,s,[3]f32.[1,1,1]);}
   else {s:=0.3+sz*0.3;n=e2_put(out,kinds,n,31,x,y,z,yaw,s,s,green);}
   continue;
  }
  if r<0.36 {s:=0.25+sz*0.25;n=e2_put(out,kinds,n,18+int(cg_hash(h,20)*1.999),x,y,z,yaw,s,s,fern);}
  else if r<0.58 {s:=0.55+sz*0.5;n=e2_put(out,kinds,n,15+int(cg_hash(h,20)*2.999),x,y,z,yaw,s,s,bush);}
  else if r<0.72 {s:=0.3+sz*0.5;n=e2_put(out,kinds,n,20+int(cg_hash(h,20)*2.999),x,y-0.1*s,z,yaw,s,s,rock);}
  else if r<0.80 {s:=0.5+sz*0.35;n=e2_put(out,kinds,n,28,x,y,z,yaw,s*0.75,s,[3]f32.[1,1,1]);}
  else if r<0.90 {s:=0.3+sz*0.3;n=e2_put(out,kinds,n,31,x,y,z,yaw,s,s,green);}
  else {s:=0.3+sz*0.25;n=e2_put(out,kinds,n,29+int(cg_hash(h,20)*1.999),x,y,z,yaw,s,s,ifx au>0.4 then orange else green);}
 }
 // (the grass is the field's: everglade/world/field.coax, placed on the GPU)
 // now and then a boulder in the woods
 bh:=seed*0.71+0.3;
 if cg_hash(bh,21)<0.3 {x:=x0+cg_hash(bh,22)*cs;z:=z0-cg_hash(bh,23)*cs;
  if e2_forest(x,z)>0.3 && e2_road_dist(x,z)>6 && e2_path(x,z)<0.05 && x>E2_WEST+4 && x<E2_EAST-4 && z>E2_FAR+4 && z<E2_BACK-4 {s:=0.5+cg_hash(bh,24)*0.7;
   n=e2_put(out,kinds,n,23+int(cg_hash(bh,25)*1.999),x,e2_height(x,z)-0.2*s,z,cg_hash(bh,26)*6.283,s,s,[3]f32.[0.58,0.60,0.48]);}}
 return n;
}
