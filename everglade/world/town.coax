// Everglade's town (game): the city clearing's 16 plots (everglade/docs/housewright-profession-spec.md,
// section 8) and a town built on them, house by house, for the town shot and as the first fixture of
// many build sites at once. The plots and sites are the engine's (metaverse-engine/world/plots.coax); the
// houses are Housewright's tiers (housewright.coax); where the grid stands is the zone's (Everglade
// II's city clearing, or Everglade Experimental's stand-in meadow, verse/experimental-terrain.coax
// exp_town).
//
// The town plan: each plot's owner, its tier and the workday its work starts. Small houses start
// first and finish fast; the cottages, timber houses and stone cottages start later and take their
// own 3, 5 and 10 workdays, so houses rise one after another at their own pace. Rows 1 and 2 face
// south and rows 3 and 4 north, onto the lane between them, a street.
#module "everglade.town";
#load "../../metaverse-engine/world/plots.coax" as plots;
#load "../../metaverse-engine/world/building.coax" as building;
#load "housewright.coax" as hw;

TOWN_N :: 4;          // plots a side: 16 in all (spec section 8)
TOWN_SIZE :: 10.0f32;    // a plot's side, metres
TOWN_PITCH :: 12.0f32;   // centre to centre: a 2 m lane between plots
TOWN_PLOTS :: 16;
// The grid at a zone's centre, at the spec's size; town_grid_sized for a stand-in with less room.
town_grid :: (x:f32,z:f32)->plots.PlotGrid {return town_grid_sized(x,z,TOWN_SIZE,TOWN_PITCH);}
town_grid_sized :: (x:f32,z:f32,size:f32,pitch:f32)->plots.PlotGrid {return plots.PlotGrid.{x=x,z=z,n=TOWN_N,size=size,pitch=pitch};}
// The smallest plot every tier fits: the stone cottage's width, 7.5 m.
TOWN_LEAST_SIZE :: 7.6f32;

TOWN_TIER :: [16]int.[2,1,3,4, 0,2,4,2, 3,2,1,0, 4,3,2,1];
TOWN_START_DAY :: [16]f32.[1.2,0.5,2.6,3.0, 0.1,1.6,3.6,2.0, 3.1,2.4,0.9,0.3, 4.2,2.8,1.0,1.3];
TOWN_NAMES :: [16]string.["Aldric Fenwood","Brin Ashdown","Cora Mossvale","Dain Hollis","Edda Thorne","Finn Barrow","Greta Lark","Hob Wetherby",
 "Isla Reed","Jory Cask","Kell Amberly","Lysa Marsh","Mara Quill","Niall Stone","Orla Brook","Pell Haddon"];
TOWN_FOUNDER :: 5;    // the plot the founder shot claims

// A plot's house frame: its centre, its front onto the street.
town_frame :: (g:plots.PlotGrid,id:int)->building.BuildingFrame {
 c:=plots.pl_centre(g,id);return building.BuildingFrame.{x=c[0],z=c[1],turn=ifx id/g.n<g.n/2 then 0 else 2};
}
// The plan's site on a plot, its work starting `t0` seconds into world time.
town_site :: (g:plots.PlotGrid,id:int,t0:f32)->plots.PlotSite {
 t:=TOWN_TIER[id];return plots.PlotSite.{tier=t,stages=hw.hw_stages(t),start=t0+TOWN_START_DAY[id]*hw.HW_WORKDAY_S,work=hw.hw_work_s(t),turn=town_frame(g,id).turn};
}
// The whole town on a book: every plot claimed by its owner (player id + 1), and every house's site
// placed, its work starting from `t0`.
town_book :: (g:plots.PlotGrid,t0:f32)->plots.PlotBook {
 b:[1]plots.PlotBook;b[0]=plots.pl_book(g);
 for i:0..<TOWN_PLOTS {ok:=plots.pl_claim(b[..],i,i+1,TOWN_NAMES[i]);ok=plots.pl_site(b[..],i,i+1,town_site(g,i,t0));}
 return b[0];
}

#test "the town claims 16 plots and places 16 houses, small ones first, all finished by day 15" {
 g:=town_grid(34,-114);b:[1]plots.PlotBook;b[0]=town_book(g,0);
 #assert b[0].refused==0 && plots.pl_count(g)==TOWN_PLOTS && plots.pl_owner_name(b[..],TOWN_FOUNDER)=="Finn Barrow";
 // every tier's houses start no earlier than the tier below's first
 for i:0..<TOWN_PLOTS {for j:0..<TOWN_PLOTS {if TOWN_TIER[i]<TOWN_TIER[j] {#assert b[0].site[i].start<b[0].site[j].start+1200*1.5;}}}
 first:=b[0].site[0].start;for i:0..<TOWN_PLOTS {if b[0].site[i].start<first {first=b[0].site[i].start;}}
 #assert TOWN_TIER[4]==hw.HW_LEANTO && b[0].site[4].start==first;
 done:=plots.pl_all_done(b[..]);#assert done>13*1200 && done<=15*1200;
 // half way there's a town rising: some houses finished, some building, some not begun
 fin:=0;mid:=0;none:=0;for i:0..<TOWN_PLOTS {p:=plots.pl_progress(b[0].site[i],3.4*1200);if p==f32(b[0].site[i].stages) {fin+=1;}else if p>0 {mid+=1;}else {none+=1;}}
 #assert fin>=3 && mid>=5 && none>=1;
}
#test "every house fits its plot, with room round it at the spec's size, its front on the street" {
 for v:0..<2 {g:=ifx v==0 then town_grid(0,0) else town_grid_sized(0,0,TOWN_LEAST_SIZE,TOWN_LEAST_SIZE+1);room:=ifx v==0 then 0.8f32 else 0.0f32;h:=g.size*0.5;
  for i:0..<TOWN_PLOTS {f:=town_frame(g,i);r:=hw.HW_REACH[TOWN_TIER[i]];c:=plots.pl_centre(g,i);
   for k:0..<4 {x:=ifx k%2==0 then -r[0] else r[0];z:=ifx k<2 then -r[2] else r[1];p:=building.building_point(f,x,z);#assert abs(p[0]-c[0])<h-room && abs(p[1]-c[1])<h-room;}
   d:=building.building_point(f,0,5);#assert (i/4<2) == (d[1]>c[1]);}}
 for t:0..<hw.HW_TIERS {r:=hw.HW_REACH[t];#assert r[0]<TOWN_LEAST_SIZE*0.5 && r[1]<TOWN_LEAST_SIZE*0.5 && r[2]<TOWN_LEAST_SIZE*0.5;}
}
