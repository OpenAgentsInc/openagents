  _ := rs_aura_set(b[0].c[0..<0+1], EF_HALVED, 0); b[0].c[0].cond|=RS_PRONE; #assert zone_move_scale(s[..])==f32(0.75);
  b[0].c[0].cond|=RS_GRAPPLED; #assert zone_move_scale(s[..])==0;
