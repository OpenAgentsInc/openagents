#test "experimental monster departure resolves one player Reaction before publishing a lethal move" {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_FIGHTER,0);
  b:=s[0].xc[0].b[..]; h:=s[0].creator[0].hostiles[..];
  b[0].dice[0].fixed=true; b[0].c[1].hp=1; b[0].c[1].ac=10;
  h[0].enemies[0].x=0; h[0].enemies[0].z=1.5;
  proposed:=h[0].enemies[0]; proposed.z=1.6; proposed.moving=true;
  xc_monster_move(s[..],0,proposed);
  #assert h[0].enemies[0].z==f32(1.5) && h[0].enemies[0].dead && b[0].c[1].hp==0 && b[0].c[0].reacted;
  #assert !s[0].xc[0].seat[0].turn.action && !s[0].xc[0].npc_seat[0].turn.action;
}
#test "experimental monster departure survives a miss while a second mover cannot spend the player's Reaction again" {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_FIGHTER,0);
  b:=s[0].xc[0].b[..]; h:=s[0].creator[0].hostiles[..]; b[0].dice[0].fixed=true;
  for foe:0..<2 {
    h[0].enemies[foe].x=0; h[0].enemies[foe].z=1.5; b[0].c[foe+1].ac=30;
    proposed:=h[0].enemies[foe]; proposed.z=1.6; proposed.moving=true;
    rolls:=b[0].dice[0].rolled; xc_monster_move(s[..],foe,proposed);
    #assert h[0].enemies[foe].z==f32(1.6) && b[0].c[0].reacted;
    #assert b[0].dice[0].rolled==rolls+(ifx foe==0 then 1 else 0);
  }
}

#test "experimental monster departure reads the moving seat's Disengage and ordinary visibility" {
  for mode:0..<4 {
    s:[1] EgZone; xc_test_lab(s[..],FB_CL_FIGHTER,0);
    b:=s[0].xc[0].b[..]; h:=s[0].creator[0].hostiles[..]; b[0].dice[0].fixed=true; b[0].c[1].ac=10;
    h[0].enemies[0].x=0; h[0].enemies[0].z=1.5;
    if mode==0 { s[0].xc[0].npc_seat[0].turn.disengaged=true; }
    if mode==1 { s[0].xc[0].seat[0].turn.disengaged=true; }
    if mode==2 { b[0].c[0].cond|=RS_BLINDED; }
    if mode==3 { b[0].c[1].cond|=RS_INVISIBLE; }
    proposed:=h[0].enemies[0]; proposed.z=1.6; proposed.moving=true;
    xc_monster_move(s[..],0,proposed);
    #assert b[0].c[0].reacted==(mode==1) && h[0].enemies[0].z==f32(1.6);
  }
}
#test "experimental monster departure can choose an Unarmed Strike while the player holds a ranged weapon" {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_FIGHTER,0);
  b:=s[0].xc[0].b[..]; h:=s[0].creator[0].hostiles[..]; b[0].dice[0].fixed=true;
  b[0].c[0].weapon=W_LONGBOW; b[0].c[1].ac=10; b[0].c[1].hp=100;
  h[0].enemies[0].x=0; h[0].enemies[0].z=1.5;
  proposed:=h[0].enemies[0]; proposed.z=1.6; proposed.moving=true;
  xc_monster_move(s[..],0,proposed);
  #assert b[0].c[0].reacted && rs_saw(b,0,"Unarmed Strike") && b[0].c[1].hp<100;
}
