  #assert abs(long_body.x-3.1-running.span)<0.0001 && x[0].seat[0].turn.move_left==0 && x[0].seat[0].turn.move_feet==2;
  b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
