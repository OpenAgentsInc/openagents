  // dungeon and one is outside, in the blast but off the aim's assist cone.
  foes[0].enemies[0].x=-40.5; foes[0].enemies[0].z=-47.5;
  foes[0].enemies[1].x=-37.5; foes[0].enemies[1].z=-42.5;
