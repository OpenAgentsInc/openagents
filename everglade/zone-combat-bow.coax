  for i:1..<3 {
    b[0].c[i]=rs_monster(MON_GOBLIN_WARRIOR,"Goblin",1);
    b[0].c[i].hp=100; b[0].c[i].hp_max=100;
  }
  slot:=-1;
  for j:0..<x[0].bar_n { if x[0].bar[j].kind==FB_SPELL && x[0].bar[j].sp==SP_FIREBALL { slot=j; } }
  #assert slot>=0;
  aim:=xc_aim(s[..],x[0].bar[slot]);
  #assert aim.reach==6;
  origin_z:=-40-f32(4)*f32(XC_SQ);
  #assert !xdungeon.dg_sight(-40.5,-40,-40.5,-47.5) && xdungeon.dg_sight(-40.5,origin_z,-40.5,-47.5);
  #assert xdungeon.dg_sight(-40.5,-40,-37.5,-42.5) && !xdungeon.dg_sight(-40.5,origin_z,-37.5,-42.5);
  #assert xc_use_on(s[..],slot,-2);
  #assert b[0].c[1].hp<100 && b[0].c[2].hp==100;
}

