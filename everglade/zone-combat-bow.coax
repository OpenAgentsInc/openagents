  high:=zone_jump_plan(s[..],ground,EgMotionIntent.{jump=true},true);
  #assert high.mode==EG_JUMP_HIGH && high.feet==3 && !x[0].seat[0].turn.moved;
  body:=zone_keep_body(s[..],ground,EgBody.{x=1,y=0.1,vy=6});
  #assert body.y>0 && body.x==0 && x[0].seat[0].turn.moved && x[0].jump_run==0;
  b[0].c[0].cond|=RS_PRONE;
  #assert zone_jump_plan(s[..],ground,intent,true).mode==EG_JUMP_DENIED;
}

