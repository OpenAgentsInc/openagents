#test "experimental physical opportunity respects Disengage ordinary sight and Addle" {
  for mode:0..<4 {
    s:[1] EgZone; xc_test_lab(s[..],FB_CL_BARBARIAN,0);
    b:=s[0].xc[0].b[..]; cr:=s[0].creator[..]; h:=cr[0].hostiles[..];
    b[0].dice[0].fixed=true; b[0].c[0].hp=100; b[0].c[0].ac=10;
    cr[0].player_x=0; cr[0].player_y=0; cr[0].player_z=0;
    h[0].enemies[0].x=0; h[0].enemies[0].z=1.5;
    if mode==0 { s[0].xc[0].seat[0].turn.disengaged=true; }
    if mode==1 { b[0].c[0].cond|=RS_INVISIBLE; }
    if mode==2 { b[0].c[1].cond|=RS_BLINDED; }
    if mode==3 { b[0].c[1].eff = rs_state_put(b[0].c[1].eff, EF_ADDLED, true); }
    body:=zone_keep_body(s[..],EgBody.{},EgBody.{z= -0.1});
    #assert body.z==f32(-0.1) && b[0].c[0].hp==100 && !b[0].c[1].reacted;
  }
}
