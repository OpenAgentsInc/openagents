  xc_set_class(x,FB_CL_WIZARD);
  xc_set_class(x,FB_CL_PALADIN);
  #assert b[0].c[0].materials[1].count==0;
  slots:=b[0].c[0].slots[1];
  s[0].creator[0].clock=8;
  #assert !xc_use(s[..],slot) && b[0].c[0].slots[1]==slots;
}
#test "experimental combat: a clicked monster in reach takes a cone spell; out of reach or fallen it is let go (#13038)" #steps 2000000000 {
  c: [1] EgZone; xc_test_lab(c[..], FB_CL_CLERIC, 0);
  x := c[0].xc[..]; g := c[0].creator[0].hostiles[..]; flame := x[0].bar[0];
  g[0].enemies[0].x = 0; g[0].enemies[0].z = 4;      // nearer, dead ahead
  g[0].enemies[1].x = 1; g[0].enemies[1].z = 9;      // the one you clicked
  #assert xc_aim(c[..], flame).foe == 0;
  x[0].picked = 1; #assert xc_pick_live(c[..], 18.288);
  c[0].creator[0].clock = 5;
  #assert xc_use(c[..], 0) && x[0].target == 1;
  g[0].enemies[1].z = 40; #assert !xc_pick_live(c[..], 18.288);
  g[0].enemies[1].z = 9; g[0].enemies[1].dead = true; #assert !xc_pick_live(c[..], 18.288) && x[0].picked == -1;
  // no camera yet: a click picks nothing and lets the pick go
  x[0].picked = 0; #assert !xc_pick_at(c[..], 600, 400) && x[0].picked == -1;
}
