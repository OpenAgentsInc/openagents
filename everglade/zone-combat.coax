  h[0].enemies[0].x=0; h[0].enemies[0].z=1; h[0].enemies[0].swing=0.34;
  b[0].dice[0].fixed=true; b[0].c[0].ac=10; b[0].c[0].hp=20; b[0].c[0].hp_max=30; b[0].c[0].temp=14;
  b[0].c[0].turn_at=0; b[0].c[1].turn_at=0;
  before := h[0].dice[0].state;
  u: [104] f32; out: [1] f32;
  _ := zone_frame(s[..],out[..],u[..],1280,720,1,0.05,false);
  #assert h[0].shared && h[0].contacts[0].count==0 && h[0].dice[0].state==before;
  #assert b[0].c[0].hp==20 && b[0].c[0].temp==2 && h[0].hp==20 && h[0].temp==2;
}

