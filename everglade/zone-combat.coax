  b[0].c[0].slots[1]=0; b[0].c[0].reacted=true; b[0].c[0].speech_blocked=true;
  x[0].seat[0].open=true; x[0].seat[0].turn.bonus=true; x[0].seat[0].turn.slot_spent=true;
  #assert !xc_use_on(s[..],2,-2);
  #assert b[0].c[0].slots[1]==0 && x[0].seat[0].turn.bonus && x[0].seat[0].turn.slot_spent;
  b[0].c[0].speech_blocked=false;
  #assert xc_use_on(s[..],2,-2) && b[0].c[0].hp>1 && b[0].c[0].reacted;
  #assert b[0].c[0].slots[1]==b[0].c[0].slots_max[1]-1;
}

#test "experimental combat: a spell slot's corner steps its slot level and the cast spends that slot (#13038)" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  x := s[0].xc[..]; xc_set_level(x, 3); x[0].seen = true; x[0].k = 1; x[0].w = 1200; x[0].h = 800;
  ray := 2; #assert x[0].bar[ray].sp == SP_RAY_OF_SICKNESS && x[0].bar[ray].lvl == 1;
  levels: [9] int; #assert fb_cast_levels(x[0].b[0].c[0], x[0].bar[ray], levels[..]) == 2 && levels[0] == 1 && levels[1] == 2;
  r := cc.eg_box4(xc_slot(x, ray));
  for want: [3] int.[2, 1, 2] {
    #assert xc_pointer(s[..], r.x1 - 3, r.y0 + 3, 0, 4) && xc_pointer(s[..], r.x1 - 3, r.y0 + 3, 2, 4);
    #assert x[0].bar[ray].lvl == want && x[0].casts == 0;
  }
  // a cantrip and a one-level spell show no corner, and their corner casts as usual
  #assert fb_cast_levels(x[0].b[0].c[0], x[0].bar[0], levels[..]) == 0;
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 6;
  s[0].creator[0].clock = 5;
  #assert xc_use(s[..], ray);
  // Experimental presses refill slots first (its world's RS_UNLIMITED_PRESS), so the chosen level is the one spent
  #assert x[0].whiffs == 0 && x[0].b[0].c[0].slots[1] == x[0].b[0].c[0].slots_max[1] && x[0].b[0].c[0].slots[2] == x[0].b[0].c[0].slots_max[2] - 1;
}
#test "experimental combat: Hex's bottom strip picks its ability, and an option it can't take spends nothing (#13038)" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WARLOCK, 0);
  x := s[0].xc[..]; x[0].seen = true; x[0].k = 1; x[0].w = 1200; x[0].h = 800;
  hex := 2; #assert x[0].bar[hex].sp == SP_HEX && fb_option_n(SP_HEX) == 6;
  r := cc.eg_box4(xc_slot(x, hex));
  #assert xc_pointer(s[..], r.x0 + 3, r.y1 - 3, 0, 5) && xc_pointer(s[..], r.x0 + 3, r.y1 - 3, 2, 5);
  #assert x[0].bar[hex].opt == 1 && x[0].casts == 0 && fb_option_label(SP_HEX, 1) == "DEX";
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 6;
  b := x[0].b[..]; was := b[0].c[0];
  x[0].bar[hex].opt = 7; s[0].creator[0].clock = 5;
  #assert !xc_use(s[..], hex);
  #assert b[0].c[0].slots[1] == was.slots[1] && b[0].c[0].conc == was.conc && !rs_effect(b[0].c[1], EF_HEX);
  x[0].bar[hex].opt = 1;
  #assert xc_use(s[..], hex) && b[0].c[0].slots[1] == b[0].c[0].slots_max[1] - 1;
  cursed := false; for e: b[0].c[1].eff { if e.kind == EF_HEX && e.cond == RS_DEX { cursed = true; } }
  #assert cursed;
}
