  #assert xdungeon.dg_sight(-40.5,-40,-37.5,-42.5) && !xdungeon.dg_sight(-40.5,origin_z,-37.5,-42.5);
  #assert xc_use_on(s[..],slot,-2);
  #assert b[0].c[1].hp<100 && b[0].c[2].hp==100;
}

