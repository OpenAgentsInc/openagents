  x[0].k=1; x[0].w=1100; x[0].h=840; x[0].seen=true;
  k:=xc_slot_of(x,XC_FAMILIAR); #assert k>=0;
  r:=cc.eg_box4(xc_slot(x, k));
  px:=r.x0+26; py:=r.y0+26;
  cr[0].clock=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert xc_press(s[..],k);
  f:=rs_familiar_of(b,0); hp:=b[0].c[f].hp; init:=b[0].c[f].initiative;
  #assert xc_choose(s[..],k,r.x0+6,r.y0+6) && x[0].familiar_order==XC_FAMILIAR_POCKET;
  #assert !xc_use_on(s[..],k,-2) && rs_up(b[0].c[f]);
  for stage:0..<3 {
    cr[0].clock+=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
    if stage==1 { cr[0].player_x+=2*f32(XC_SQ); }
    if stage==2 { #assert xc_choose(s[..],k,r.x0+6,r.y0+6) && x[0].familiar_order==XC_FAMILIAR_RELEASE; }
    #assert xc_pointer(s[..],px,py,0,7) && xc_pointer(s[..],px,py,2,7);
    #assert x[0].seat[0].turn.action && b[0].c[f].initiative==init;
    #assert rs_up(b[0].c[f])==(stage==1) && b[0].c[f].hp==(ifx stage==2 then 0 else hp);
    if stage==1 { #assert x[0].familiar_x==cr[0].player_x && x[0].familiar_seat[0].me==f; }
  }
  #assert x[0].familiar_order==XC_FAMILIAR_CAST;
}

#test "Experimental familiar Step command spends the familiar's movement on its own seat" #steps 100000000 {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_DRUID,0);
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..];
  x[0].level=2; xc_set_class(x,FB_CL_DRUID);
  k:=xc_slot_of(x,XC_FAMILIAR); #assert k>=0;
  cr[0].clock=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert xc_press(s[..],k);
  f:=rs_familiar_of(b,0);
  x[0].familiar_order=XC_FAMILIAR_STEP;
  before:=x[0].familiar_z;
  #assert !xc_use_on(s[..],k,-2);
  b[0].clock=b[0].c[f].turn_at; xc_hostile_contacts(s[..]);
  cr[0].clock=4;
  #assert xc_press(s[..],k) && x[0].familiar_z==before+f32(XC_SQ);
  #assert x[0].familiar_seat[0].turn.moved && !x[0].seat[0].turn.moved;
  goblin:=cr[0].hostiles[0].enemies[3..<4];
  goblin[0].x=f32(XC_SQ); goblin[0].z=before;
  b[0].dice[0].fixed=true;
  prior:=x[0].familiar_z; cr[0].clock=6;
  #assert !xc_press(s[..],k) && b[0].c[4].reacted && b[0].c[f].dead;
  #assert x[0].familiar_z==prior;
}

#test "Experimental familiar Touch routes a clicked foe through the familiar and spends its Reaction" #steps 100000000 {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_WIZARD,0);
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..];
  summon:=xc_slot_of(x,XC_FAMILIAR);
  cr[0].clock=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert xc_press(s[..],summon);
  b[0].clock=b[0].c[0].rite_until;
  fb_seat_step(b,x[0].seat[..]); xc_rite_step(s[..]);
  f:=rs_familiar_of(b,0); #assert f>=0;
  k:=1; #assert x[0].bar[k].sp==SP_CHILL_TOUCH;
  x[0].k=1; x[0].w=1100; x[0].h=840; x[0].seen=true;
  r:=cc.eg_box4(xc_slot(x, k));
  #assert xc_choose(s[..],k,r.x0+6,r.y1-6) && x[0].familiar_touch;
  x[0].familiar_z=4*f32(XC_SQ);
  foe:=cr[0].hostiles[0].enemies[3..<4];
  foe[0].x=0; foe[0].z=5*f32(XC_SQ);
  x[0].picked=3;
  b[0].dice[0].fixed=true;
  b[0].c[4].ac=5; hp:=b[0].c[4].hp;
  cr[0].clock=4; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  x[0].picked=-1;
  #assert !xc_press(s[..],k) && !b[0].c[f].reacted && !x[0].seat[0].turn.action;
  x[0].picked=3; foe[0].z=6*f32(XC_SQ);
  #assert !xc_press(s[..],k) && !b[0].c[f].reacted && !x[0].seat[0].turn.action;
  foe[0].z=5*f32(XC_SQ);
  px:=r.x0+26; py:=r.y0+26;
  #assert xc_pointer(s[..],px,py,0,7) && xc_pointer(s[..],px,py,2,7);
  #assert b[0].c[4].hp==hp-5 && b[0].c[f].reacted && x[0].seat[0].turn.action;
  #assert !b[0].c[0].reacted;
  cr[0].clock=6; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert !xc_press(s[..],k) && b[0].c[4].hp==hp-5 && !x[0].seat[0].turn.action;
}

#test "Experimental Wizard can switch to the prepared one-hour familiar cast" #steps 100000000 {
  for level:1..<7 {
    hero:[1]RsCreature; hero[0]=rs_wizard("Wizard",0,level);
    fb_wizard_familiar_preset(hero[..],1);
    #assert rs_spell_ready(hero[0],SP_FIND_FAMILIAR);
    #assert hero[0].spells.prepared==rs_prepared_limit(RS_WIZARD,level);
    #assert hero[0].spells.cantrips==rs_cantrip_limit(RS_WIZARD,level);
    #assert !rs_wizard_key_bit(hero[0],hero[0].spells.selected,RS_KEY_MAGE_ARMOR);
  }
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_WIZARD,0);
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..];
  #assert rs_spell_ready(b[0].c[0],SP_FIND_FAMILIAR);
  #assert b[0].c[0].spells.prepared==rs_prepared_limit(RS_WIZARD,1);
  x[0].k=1; x[0].w=1100; x[0].h=840; x[0].seen=true;
  k:=xc_slot_of(x,XC_FAMILIAR); r:=cc.eg_box4(xc_slot(x, k));
  #assert xc_choose(s[..],k,r.x1-6,r.y0+6) && x[0].bar[k].lvl==1;
  #assert xc_choose(s[..],k,r.x1-6,r.y1-6);
  cr[0].clock=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  slots:=b[0].c[0].slots[1];
  #assert xc_press(s[..],k) && b[0].c[0].rite_until-b[0].clock==3600;
  #assert b[0].c[0].slots[1]==slots && x[0].familiar_incense==1;
  rs_end_concentration(b,0,"");
  #assert b[0].c[0].slots[1]==slots && x[0].familiar_incense==1;
  cr[0].clock=4; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert xc_press(s[..],k);
  #assert xc_choose(s[..],k,r.x1-6,r.y0+6) && x[0].bar[k].lvl==0;
  b[0].clock=b[0].c[0].rite_until;
  fb_seat_step(b,x[0].seat[..]); xc_rite_step(s[..]);
  #assert b[0].c[0].slots[1]==slots-1 && x[0].familiar_incense==0;
  f:=rs_familiar_of(b,0);
  #assert f>=0 && b[0].c[f].celestial && b[0].c[0].rite==-1;
}

#test "Experimental familiar senses use its camera and spatial audio until the owner turn" #steps 100000000 {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_DRUID,0);
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..];
  x[0].level=2; xc_set_class(x,FB_CL_DRUID);
  k:=xc_slot_of(x,XC_FAMILIAR);
  cr[0].clock=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert xc_press(s[..],k);
  f:=rs_familiar_of(b,0); x[0].familiar_x=5; xc_sync_world(s[..]);
  x[0].familiar_order=XC_FAMILIAR_SENSE;
  cr[0].clock=4;
  #assert xc_press(s[..],k) && x[0].seat[0].turn.bonus;
  u:[104]f32; u[16]=99;
  #assert xc_familiar_view(s[..],u[..]) && u[16]==5 && cr[0].player_x==0;
  #assert u[18]==x[0].familiar_z && abs(u[65]-60*f32(XC_SQ)/5)<0.001;
  audio:=s[0].experimental_audio[..]; audio[0].n=0;
  xc_cue(s[..],"hit",1,5,x[0].familiar_z,1);
  #assert exsound.xs_word(exsound.xs_text(audio),2)=="0.000";
  b[0].c[f].cond=RS_BLINDED|RS_DEAFENED;
  u[16]=99; #assert !xc_familiar_view(s[..],u[..]) && u[16]==99 && u[65]==0;
  audio[0].n=0; xc_cue(s[..],"hit",1,5,x[0].familiar_z,1);
  #assert exsound.xs_word(exsound.xs_text(audio),2)!="0.000";
  b[0].c[f].cond=0;
  b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert !xc_familiar_view(s[..],u[..]) && u[16]==99 && u[65]==0;
}

#test "Experimental familiar badge can choose and summon the Owl" #steps 100000000 {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_DRUID,0);
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..];
  x[0].level=2; xc_set_class(x,FB_CL_DRUID);
  x[0].k=1; x[0].w=1100; x[0].h=840;
  k:=xc_slot_of(x,XC_FAMILIAR); r:=cc.eg_box4(xc_slot(x, k));
  for n:0..<8 { #assert xc_choose(s[..],k,r.x0+6,r.y1-6); }
  cr[0].clock=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  #assert xc_press(s[..],k);
  f:=rs_familiar_of(b,0);
  #assert f>=0 && b[0].c[f].familiar_form==MON_OWL && rs_familiar_darkvision(b[0].c[f])==120;
  cc.catalog(cr,"C glade/environment 9 12 250 100 8 0\nC glade/familiar8 50 240 248 100 0 0\n");
  draw:[24]f32;
  #assert xc_familiar_draw(s[..],draw[..],0)==1;
  #assert s[0].bodies[0].draws[0]==50 && s[0].bodies[0].draws[1]==240 && draw[0]==x[0].familiar_x && draw[2]==x[0].familiar_z;
  rs_familiar_retire(b,f);
  #assert xc_familiar_draw(s[..],draw[..],0)==0;
}

xc_familiar_draw :: (s:[] EgZone,out:[]f32,n:int)->int {
  x:=s[0].xc[..]; c:=s[0].creator[..]; b:=x[0].b[..];
  if !x[0].started || n>=s[0].bodies[0].draws.count/4 || (n+1)*24>out.count { return n; }
  f:=rs_familiar_of(b,0);
  if f<0 || !rs_up(b[0].c[f]) || b[0].c[0].familiar_sensing && rs_familiar_observer(b,0)==f { return n; }
  fx:=x[0].familiar_x; fz:=x[0].familiar_z;
  if !xdungeon.dg_sight(c[0].player_x,c[0].player_z,fx,fz) { return n; }
  for i:0..<RS_FAMILIAR_FORMS.count {
    if RS_FAMILIAR_FORMS[i]!=b[0].c[f].familiar_form || c[0].familiar_count[i]<=0 { continue; }
    cc.familiar_record(out,n,c[0].familiar_word[i],fx,meadow_y(fx,fz),fz,c[0].player_face);
    d:=s[0].bodies[0].draws[..];
    d[n*4]=cast(u32)c[0].familiar_first[i]; d[n*4+1]=cast(u32)c[0].familiar_count[i];
    d[n*4+2]=cast(u32)n; d[n*4+3]=1;
    s[0].bodies[0].draw_n=n+1;
    return n+1;
  }
  return n;
}

#test "Experimental Zone of Truth stays at the cast point after player travel" {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_PALADIN,0);
  x:=s[0].xc[..]; xc_set_level(x,5);
  cr:=s[0].creator[..]; b:=x[0].b[..];
  slot:=-1;
  for i:0..<x[0].bar_n { if x[0].bar[i].sp==SP_ZONE_OF_TRUTH { slot=i; } }
  #assert slot>=0;
  cr[0].clock=5;
  #assert xc_use(s[..],slot);
  zone:=b[0].zone[0];
  #assert zone.on && zone.spell==SP_ZONE_OF_TRUTH;
  cr[0].player_x=f32(XC_SQ)*5;
  xc_sync_world(s[..]);
  #assert b[0].zone[0].cx==zone.cx-5 && b[0].zone[0].cy==zone.cy;
  events:=b[0].book[0].seq;
  cr[0].hostiles[0].enemies[0].x=f32(zone.cx-XC_MID)*f32(XC_SQ);
  cr[0].hostiles[0].enemies[0].z=f32(zone.cy-XC_MID)*f32(XC_SQ);
  xc_sync_world(s[..]);
  #assert b[0].book[0].seq==events+1;
  save:=rs_recent(b[0].book[0],0);
  #assert save.kind==RS_EV_SAVE && save.spell==SP_ZONE_OF_TRUTH && save.to==1;
  xc_sync_world(s[..]);
  #assert b[0].book[0].seq==events+1;
}

#test "Experimental Revivify restores a nearby corpse and keeps the diamond spent after a preset change" {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_CLERIC,0);
  x:=s[0].xc[..]; xc_set_level(x,5);
  cr:=s[0].creator[..]; b:=x[0].b[..];
  k:=-1;
  for i:0..<x[0].bar_n { if x[0].bar[i].sp==SP_REVIVIFY { k=i; } }
  #assert k>=0;
  cr[0].clock=5;
  e:=cr[0].hostiles[0].enemies[0..<1];
  e[0].x=cr[0].player_x; e[0].z=cr[0].player_z+3;
  rs_damage(b,0,1,b[0].c[1].hp,RS_FORCE,false,-1);
  e[0].dead=true;
  slots:=b[0].c[0].slots[3];
  #assert !xc_use(s[..],k);
  #assert b[0].c[0].slots[3]==slots && b[0].c[0].materials[1].count==1 && e[0].dead;
  e[0].z=cr[0].player_z+1;
  #assert xc_use(s[..],k);
  #assert !e[0].dead && !b[0].c[1].dead && b[0].c[1].hp==1 && b[0].c[0].slots[3]==slots-1;
  xc_set_class(x,FB_CL_WIZARD); xc_set_class(x,FB_CL_CLERIC);
  #assert b[0].c[0].materials[1].count==0;
}
