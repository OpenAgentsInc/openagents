#test "Experimental rest controls require actual settled observations and refuse active movement or strikes" #steps 2000000000 {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_WIZARD,0); x:=s[0].xc[..]; b:=x[0].b[..];
  #assert b[0].rest_auto && !xc_rest_request(s[..],RS_REST_SLEEP);
  body:=EgBody.{ground=true}; zone_rest_motion(s[..],body,body,false,false);
  for busy:0..<7 {
    if busy==0 { s[0].held=HOLD_W; } if busy==1 { s[0].stick_on=true; }
    if busy==2 { s[0].creator[0].airborne=true; } if busy==3 { s[0].creator[0].moving=true; }
    if busy==4 { s[0].creator[0].walk.on=true; } if busy==5 { x[0].pend=0; }
    if busy==6 { sprint.sprint_start(x[0].dash[..],s[0].creator[0].clock,0,1); }
    #assert !xc_rest_request(s[..],RS_REST_SLEEP) && b[0].c[0].long_rest.phase==0;
    s[0].held=0; s[0].stick_on=false; s[0].creator[0].airborne=false; s[0].creator[0].moving=false;
    s[0].creator[0].walk.on=false; x[0].pend = -1; sprint.sprint_stop(x[0].dash[..]);
  }
  #assert xc_rest_request(s[..],RS_REST_SLEEP) && rs_sleeping(b[0].c[0]) && zone_move_scale(s[..])==0;
  #assert xc_rest_request(s[..],RS_REST_WATCH) && !rs_sleeping(b[0].c[0]) && b[0].c[0].long_rest.mode==2;
  s[0].held=HOLD_W;
  #assert xc_rest_request(s[..],RS_REST_END) && b[0].c[0].long_rest.phase==0;
}
// A finger on the class menus (everglade/hud/class-bar.coax): your portrait, the portrait menu's row
// for item id where there is one, then (req >= 0) its menu's row for that rest request. True when
// every press was taken.
xc_side_tap :: (s:[] EgZone,id:int,req:int)->bool {
  x:=s[0].xc[..]; g:=xc_side_geo(s); if eg_side_find(g,id)<0 { return false; }
  if x[0].side.menu!=id {
    bx:=(g.anchor.x0+g.anchor.x1)/2; by:=(g.anchor.y0+g.anchor.y1)/2;
    if !xc_pointer(s,bx,by,0,1) || !xc_pointer(s,bx,by,2,1) { return false; }
    if x[0].side.menu==EG_SIDE_ROOT {
      f0:=xc_facts(s); rr:[EG_MENU_ROWS]int; mr:=eg_menu_rows(f0,EG_SIDE_ROOT,rr[..]); root:=eg_menu_of(f0,g,EG_SIDE_ROOT);
      for r:0..<mr { if rr[r]==EG_DO_OPEN+id { rb:=cc.hud_menu_row(root,r); rx:=(rb.x0+rb.x1)/2; ry:=(rb.y0+rb.y1)/2; if !xc_pointer(s,rx,ry,0,1) || !xc_pointer(s,rx,ry,2,1) { return false; } } }
    }
    if x[0].side.menu!=id { return false; }
  }
  if req<0 { return true; }
  f:=xc_facts(s); rows:[EG_MENU_ROWS]int; m:=eg_menu_rows(f,id,rows[..]); menu:=eg_menu_of(f,xc_side_geo(s),id);
  for r:0..<m { if rows[r]>=EG_DO_REST && f.rest[rows[r]-EG_DO_REST]==req {
    rb:=cc.hud_menu_row(menu,r); rx:=(rb.x0+rb.x1)/2; ry:=(rb.y0+rb.y1)/2;
    return xc_pointer(s,rx,ry,0,1) && xc_pointer(s,rx,ry,2,1); } }
  return false;
}
#test "Experimental's picker and bar keep apart on a phone either way up and on a desktop; nothing is a button over the bar, and REST hangs under your portrait" #steps 2000000000 {
  for v:0..<3 {
    s:[1] EgZone; xc_test_lab(s[..],FB_CL_WIZARD,0); x:=s[0].xc[..];
    x[0].seen=true; x[0].open=true; x[0].k=ifx v==2 then 1.0f32 else 3.0f32;
    x[0].w=ifx v==0 then 1170.0f32 else ifx v==1 then 2532.0f32 else 1920.0f32;
    x[0].h=ifx v==0 then 2532.0f32 else ifx v==1 then 1170.0f32 else 1080.0f32;
    lay:=xc_layout(s[..]); pb:=cm_pick_panel(lay.pick); top:=xc_bar_top(x);
    #assert x[0].bar_n>0 && lay.side.n==1 && lay.side.ids[0]==EG_SIDE_REST && pb.x1<=x[0].w && pb.y1<=top;
    #assert v!=0 || pb.y0>=XC_PORTRAIT_FOOT*x[0].k;   // under the portrait on a phone held upright
    for i:0..<x[0].bar_n { r:=cc.eg_box4(xc_slot(x, i)); #assert r.x0>=0 && r.x1<=x[0].w && (r.y0>=pb.y1 || r.x0>=pb.x1); }
    // shut, the class menus draw nothing; a press on your portrait hangs REST's menu under it, on the page and over the bar
    out:[20000]f32; nt:[] cc.UitTrace; f:=xc_facts(s[..]); #assert eg_side_draw(nt,f,lay.side,x[0].side,out[..],0)==0;
    a:=lay.side.anchor; #assert a.x1<=x[0].w && a.y0>=0 && a.y1<top;
    #assert xc_side_tap(s[..],EG_SIDE_REST,-1) && x[0].side.menu==EG_SIDE_REST;
    m:=eg_menu_of(f,lay.side,EG_SIDE_REST).panel; #assert m.y0>=a.y1 && m.y1<=top && m.x0>=0 && m.x1<=x[0].w;
    #assert eg_side_draw(nt,f,lay.side,x[0].side,out[..],0)>0;
    #assert xc_pointer(s[..],2,x[0].h*0.6,0,1) && x[0].side.menu<0;   // a press elsewhere shuts it
    if v<2 { c:=cm_pick_box(lay.pick,CM_CLASS,0); l:=cm_pick_box(lay.pick,CM_LEVEL,1); #assert c.y1-c.y0>=44*x[0].k-0.01 && l.x1-l.x0>=44*x[0].k-0.01; }
  }
}
