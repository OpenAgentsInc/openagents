#test "experimental walking scale exposes class Speed and condition changes without the terrain pace clamp" {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_MONK,0);
  s[0].xc[0].level=6; xc_set_class(s[0].xc[..],FB_CL_MONK);
  b:=s[0].xc[0].b[..]; #assert b[0].c[0].speed==45 && zone_move_scale(s[..])==f32(1.5);
  b[0].c[0].halved_until=60; #assert zone_move_scale(s[..])==f32(22)/30;
  b[0].c[0].halved_until=0; b[0].c[0].cond|=RS_PRONE; #assert zone_move_scale(s[..])==f32(0.75);
  b[0].c[0].cond|=RS_GRAPPLED; #assert zone_move_scale(s[..])==0;
}
xc_check_ai_rate :: (speed:int)->bool {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_FIGHTER,0);
  b:=s[0].xc[0].b[..]; h:=s[0].creator[0].hostiles[..]; b[0].c[1].speed=speed;
  h[0].enemies[0].x=4; h[0].enemies[0].z=0;
  xc_hostile_tick(s[..],0.05);
  dx:=h[0].enemies[0].x-4; dz:=h[0].enemies[0].z;
  return abs(sqrt(dx*dx+dz*dz)-f32(0.12)*f32(speed)/30)<f32(0.0001);
}
#test "experimental walking scale changes actual AI distance at half base Speed" { #assert xc_check_ai_rate(15); }
#test "experimental walking scale retains actual AI distance at base Speed" { #assert xc_check_ai_rate(30); }
#test "experimental walking scale changes actual AI distance at twice base Speed" { #assert xc_check_ai_rate(60); }

#test "experimental rest activity uses admitted own motion rather than attempts or passive displacement" {
  s:[1] EgZone; xc_test_lab(s[..],FB_CL_FIGHTER,0); b:=s[0].xc[0].b[..];
  #assert rs_short_rest_begin(b,0);
  origin:=EgBody.{ground=true}; body:=origin;
  zone_rest_motion(s[..],origin,body,true,true); #assert b[0].c[0].rest.phase==1;
  body.x=1; zone_rest_motion(s[..],origin,body,false,false); #assert b[0].c[0].rest.phase==1;
  zone_rest_motion(s[..],origin,body,true,false); #assert b[0].c[0].rest.phase==0;
  #assert rs_short_rest_begin(b,0); body=origin; body.y=1; body.ground=false;
  zone_rest_motion(s[..],origin,body,false,false); #assert b[0].c[0].rest.phase==1;
  zone_rest_motion(s[..],origin,body,false,true); #assert b[0].c[0].rest.phase==0;
}
