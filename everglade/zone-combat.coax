  k:=xc_slot_of(x,XC_FAMILIAR); #assert k>=0;
  cr[0].clock=2; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  wild:=b[0].c[0].uses[RS_USE_WILD];
  #assert xc_press(s[..],k);
  f:=rs_familiar_of(b,0);
  #assert f>=0 && rs_up(b[0].c[f]) && b[0].c[f].familiar_form==MON_CAT;
  #assert b[0].c[0].uses[RS_USE_WILD]==wild-1;
  b[0].c[f].reacted=true;
  b[0].clock=b[0].c[f].turn_at;
  xc_hostile_contacts(s[..]);
  #assert x[0].familiar_seat[0].open && !b[0].c[f].reacted;
  wx:=x[0].familiar_x; wz:=x[0].familiar_z;
  cr[0].player_x+=f32(XC_SQ);
  xc_sync_world(s[..]);
  #assert b[0].c[f].x==xc_square(wx-cr[0].player_x) && b[0].c[f].y==xc_square(wz-cr[0].player_z);

  xc_set_class(x,FB_CL_WIZARD);
  #assert b[0].c[f].dead;
  spell:=xc_slot_of(x,XC_FAMILIAR); #assert spell>=0;
  cr[0].clock=4; b[0].clock=b[0].c[0].turn_at; fb_seat_step(b,x[0].seat[..]);
  slots:=b[0].c[0].slots[1];
  #assert xc_press(s[..],spell) && b[0].c[0].rite==SP_FIND_FAMILIAR;
  #assert b[0].c[0].rite_until-b[0].clock==4200 && x[0].familiar_incense==1;
  b[0].clock=b[0].c[0].turn_at;
  fb_seat_step(b,x[0].seat[..]); xc_rite_step(s[..]);
  #assert b[0].c[0].rite==SP_FIND_FAMILIAR && !b[0].c[0].rite_owed && x[0].seat[0].turn.action;
  b[0].clock=b[0].c[0].rite_until;
  fb_seat_step(b,x[0].seat[..]); xc_rite_step(s[..]);
  #assert rs_up(b[0].c[f]) && b[0].c[0].rite==-1 && b[0].c[0].slots[1]==slots;
  #assert x[0].familiar_incense==0;
  xc_set_class(x,FB_CL_DRUID); xc_set_class(x,FB_CL_WIZARD);
  #assert b[0].c[0].materials[0].count==0;
}

#test "Experimental familiar lifecycle controls dismiss, recall and release on the owner's turn" #steps 100000000 {
