// Everglade Experimental's combat (#13025): your class's level 1–6 kit on the hotbar, keys 1 to 9,
// against the Bestiary monsters that hunt you (verse/experimental-hostiles.coax), and CLASSES, a
// column under the ANIMATIONS browser that sets your class and reloads the bar.
//
// Every roll is the SRD 5e engine's (aethyr/rules/srd/), through the hotbar layer Everglade 5E
// plays on (fivebar.coax: fb_cl_hero, fb_cl_ability, fb_seat_use). You are creature 0, the engine's
// selected-level hero of your class; the village and dungeon bodies map to creatures 1 through
// XC_FOES by stable index. The page
// rolls offline, as Experimental runs: there is no room. Before each use the monsters stand on the
// engine's squares as they stand round you in metres (one square 5 feet, 1.524 m), so its reach
// and ranges are the world's.
//
// Slot 1 is the class's ability from Character Create (#13024): its picture and card are
// realms/everglade/hotbar/cl-*. The rest is the supported class kit through the selected level,
// with abilities that work without an ally and pictures and cards from
// realms/5e-mmo/hotbar/. As on Everglade's bar, nothing runs out: every slot and use comes back for
// each press. One second passes between presses (XC_COOL).
//
// Aim: everything goes the way you face (xc_aim): bolts fly straight ahead, blows strike ahead of
// you, and nothing behind or beside you is picked for you. A heal is yours: what it heals is added
// through the same shared Hit Points and Temporary Hit Points as hostile attacks.
//
// Weapons: a melee class holds its weapon in the right hand (xc_kit; charactercreator.coax
// held_weapon). A blow with it is an Aethyr action (aethyr/action/, #12993): the swing's clip is its
// definition, timed in fixed 1/64 s ticks, with a sensor window round the swing's impact. Each tick
// of that window the blade's actual pose (the swing clip's baked hands through the same weapon matrix
// that draws it, sampled within the tick) sweeps the monsters' hurt capsules; the first accepted
// contact is the monster the SRD Attack resolves against, once per swing however the frames fall
// (xc_swing_step). A swing whose window closes on no one swings at the air. Before the bake is ready
// (and in checks) the blade follows a declared fallback arc ahead of you and the fallback is counted.
//
// A monster at 0 Hit Points dies: it stops, a puff of dust rises, and it sinks into the ground over
// XC_SINK seconds (charactercreator.coax scene).
//
// The monsters are SRD 5.2.1 stat blocks (aethyr/rules/srd/monsters.coax, #13034), under the
// Bestiary's names: the imp is an Imp, the gremlin (the Puglin) a Goblin Warrior, the Puglin Brute
// an Ogre, the Imp Fiend a Quasit and the Puglin Warlord a Hill Giant. A body's contact is its
// block's attack Action (stat-multiattack.coax): the Hill Giant's two attacks, the Goblin's Shortbow,
// the Ogre's Javelin and the Giant's Trash Lob when you stand past melee reach; a Goblin leaving your
// reach takes Nimble Escape's Disengage.
//   coax/bin/coax test --library apps/openagents-web/fivelab.coax --only "experimental combat"
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "shared/fivebar.coax";
#load "../aethyr/walk-substep-policy.coax" as xtravel;
#load "../aethyr/rules/srd/press-budget.coax";
#load "shared/class-kit.coax";   // the class kits, their aim and sounds, shared with Everglade II and its room (#13058)
#load "client/class-look.coax";  // their looks, the spells' colours and the bar's boxes, shared with Everglade II
#load "client/class-feel.coax";   // every action's feel and the SRD conditions as a bearing (docs/verse/action-pipeline.md, #13072)
#load "client/cast-pose.coax";   // a cast's body clip and the bow's aim pose, shared with Everglade II
#load "client/class-menu.coax";  // the CLASSES column, shared with Everglade II's local admin mode
#load "dash.coax";   // Everglade's Dash (game): the SRD Dash spent as the engine's sprint
#load "../aethyr/action/sprint.coax" as sprint;   // the sprint (engine): its pace and steering
#load "../verse/experimental-terrain.coax" as xmeadow;
#load "../verse/experimental-village.coax" as xvillage;   // its walls, for what a plate's sight crosses
#load "../aethyr/action/action.coax" as act;
#load "../aethyr/action/sensor.coax" as sense;
#load "../aethyr/query.coax" as aq;
#load "../aethyr/cam/attention.coax" as attn;   // the cone spell's monster is the shared attention answer (#12994)
#load "../aethyr/cam/mouselook.coax" as xlook;   // the mouselook camera, whose reticle is the bow's
#load "../aethyr/action/floats.coax" as fl;   // the numbers over whoever a blow struck, shared with Everglade II (#13104)
#load "../aethyr/action/react.coax" as react;   // hit stops and the presentation queue (#13027)
#load "../aethyr/action/target.coax" as tg;   // static targets an arrow strikes: any zone may stand some (the Archery Range does)
#load "../aethyr/world/props.coax" as wprops;   // a zone's own standing things' boxes (the Creator keeps them)
#load "../aethyr/action/bow.coax" as bow;
#load "../aethyr/action/archery.coax" as arch;   // the archer: the sight line, the flight, what an arrow meets (engine)
#load "longbow.coax";   // Everglade's Longbow: where the arrow leaves, its sounds and dust (game)
#load "../aethyr/cam/reticle.coax" as reticle;   // the one centred reticle, shared with the mouselook camera       // the draw and the arrows, yours and the Goblins' (docs/verse/bow-combat.md)

XC_FOES :: hostile.HS_N;      // the village's six and the dungeon's (verse/experimental-hostiles.coax)
XC_SIDE :: 48; XC_MID :: 24;   // the engine's grid round you, squares (73 m a side)
XC_AWAY :: -1000;
XC_SQ :: 1.524;
XC_SINK :: 2.4;                // seconds a fallen monster takes to sink away
XC_PLAYER_MAX :: 44;           // legacy body-only fixture HP; live HP is the selected class's shared state
// the CLASSES column, CSS px: its header, its rows, the gap above it
XC_HEAD :: CM_HEAD; XC_ROW :: CM_ROW; XC_ROWS_TOP :: CM_ROWS_TOP; XC_GAP :: CM_GAP;   // class-menu.coax

XC_FAMILIAR :: 29;
XC_BREATH :: 31;   // the dragon's Fire Breath while you ride it (everglade/zone-ride.coax zone_breath_slot): the dragon's, not your class's, so never in the bar's saved order
XC_FAMILIAR_CAST :: 0; XC_FAMILIAR_POCKET :: 1; XC_FAMILIAR_RELEASE :: 2; XC_FAMILIAR_STEP :: 3; XC_FAMILIAR_SENSE :: 4;
XcCombat :: struct {
  sight: [XC_FOES] cc.HudSight; sight_at: f32 = -1;   // each foe's plate's share shown while its body shows (xc_sight_shows), fading
  plates: [1] cc.HudPlates;                   // the frame's plates over bodies (xc_frame: aethyr/ui/hud-plates.coax)
  familiar_order:int; familiar_touch:bool;
  familiar_x:f32; familiar_z:f32; familiar_seat:[1]FbSeat;
  dragon_seat:[1]FbSeat;   // the red dragon you ride, once it has joined the battle (everglade/zone-ride.coax zone_dragon_join)
  familiar_incense:int=1; // one Lab supply, carried across preset changes
  protection_water_used:bool;
  revivify_diamond_used:bool; // one Lab diamond, carried across preset changes
  truth_x:[RS_ZONES]f32; truth_z:[RS_ZONES]f32;
  truth_inside:[XC_FOES+2]int;
  objects:[XC_OBJECTS]XcObject;
  started: bool; klass: int = 11; level: int = 1;
  rest_seen:bool; rest_settled:bool; rest_refused:bool;
  jump:EgJump; jump_run:f32; jump_x:f32; jump_z:f32;
  wild_old:int; wild_new:int;
  dash: [1] sprint.Sprint;   // a Dash's sprint (aethyr/action/sprint.coax), begun from the pipeline's yes (xc_use_ab)
  wave: aa.AreaAim; wave_y: f32; wave_until: f32 = -1;   // Thunderwave's cube where it opened (aethyr/action/area-aim.coax), at your height then
  bar: [XC_SLOTS] FbAb; bar_n: int;
  order: [12] [XC_SLOTS] int; order_n: [12] int;
  arranging: bool; order_dirty: bool; drag_x: f32; drag_y: f32;
  b: [1] RsBattle; seat: [1] FbSeat;
  target: int = -1;                 // the monster struck at last (0 to 5), -1 none: its Hit Points over the bar
  picked: int = -1;                 // the monster you clicked (#13038): single-target spells go to it while it stands in reach
  cool_at: f32 = -100;              // when the last press was
  used: int = -1;                   // the slot pressed last
  u: [36] f32; w: f32; h: f32; k: f32; seen: bool;   // the last frame's camera and screen
  compact: bool; more: bool;         // an upright phone (zone_compact): the bar is one row with MORE, and whether MORE has the rest open (xc_slot)
  open: bool = true;                // the CLASSES column is open
  top: f32;                         // its top, device px
  pick_hover: CmHit;                // the picker's button under the pointer (class-menu.coax cm_pick_hit)
  side: EgSideState;                // the class menus' open one and hover (everglade/hud/class-bar.coax)
  me_trail: [1] cc.HudTrail; me_max: int;      // your health bar's fill and damage trail (aethyr/ui/hud-style.coax), and the maximum it was stepped for
  foe_trail: [XC_FOES] cc.HudTrail;            // each monster's: its plate's, and your target's frame's
  vig: [1] cc.HudVignette;                     // the screen's red edges: a blow's flash, the pulse when you are low (everglade/hud/parts.coax eg_vignette)
  target_shown: f32;                           // 0 to 1: how far your target's frame has faded in
  hover: int = -1;                  // the bar's slot under the pointer
  down: int = -100; down_x: f32; down_y: f32; down_id: int;
  media: [16384] u8; media_n: int;   // the bar's pictures for the host (coaxial_media)
  floats: [1] fl.Floats;   // the shared numbers (aethyr/action/floats.coax): the queue and the count shown and suppressed live inside
  casts: int; landed: int; kills: int; refused: int; last_dmg: int;   // for the checks (zone_probe 900+)
  whiffs: int;                      // bolts that flew to their range and blows that met no one
  releasing: bool;                  // an arrow or a swung blow landing: it resolves though you fell first (#13120)
  fizzle: int = -1; fizzle_at: f32 = -100;   // the slot whose spell found no one ahead, and when (its icon flashes)
  deeds: [1] DeedBar;   // the bar's asks and the rules' answers (aethyr/action/deed.coax, docs/verse/action-pipeline.md, #13072)
  seeded: bool;                     // the dice mixed with the clock at the first press, so each visit rolls its own
  knockout: bool;                   // KNOCK OUT: your melee blows leave a monster at 1 HP and Unconscious (SRD p.17)
  pend: int = -1;                   // a blow swinging: its slot (xc_swing_step), -1 none
  swing_def: act.ActionDef; swing: act.ActionInstance; swing_tick: int = -1;   // its action and the last tick sensed
  swing_struck: bool; swing_next: int = 1; ledger: sense.HitLedger;
  contacts: int; fallbacks: int; exhausted: int;   // accepted blade contacts; ticks sensed on the fallback arc; ticks refused as too much work
  blade_step: f32;                  // the largest blade-end move in one tick so far, metres (zone_probe 933, mm)
  lock: attn.AttnState;             // your target, held through attention (xc_lock_step): target is its answer
  stops: react.Stops;               // hit stops in force: a struck monster pauses, and a monster that strikes you
  npc_seat: [XC_FOES] FbSeat;
  seen_hits: int;                   // the monsters' landed blows already given their hit stop
  shields: int;                     // Shield Reactions cast for you (their sound and barrier played)
  guard_in: [XC_FOES] bool;         // each monster inside your Spirit Guardians' Emanation last frame
  hit_at: f32 = -100; hit_x: f32; hit_z: f32;   // when a monster's blow or shot last struck you, and where it stood (everglade/hud/numbers.coax eg_struck_from)
  told: int = -1; told_at: f32 = -100; told_ok: bool;   // a check's slot and when: its frame flashes green (passed) or red
  studied: [XC_FOES] bool;          // Study recalled it: its AC shows on the target line
  calm: [XC_FOES] bool;             // Influence: it complied and stands down until you harm it
  glide_x: f32; glide_z: f32; glide_until: f32 = -1;   // a readied move carrying you to (glide_x, glide_z)
  // the bow (docs/verse/bow-combat.md): the engine's archer (aethyr/action/archery.coax): your draw,
  // every arrow in the air or stuck (yours and the monsters'), the zone's static targets, a finger
  // drawing on the bow's slot and the counts of your own arrows; then each monster shot's arrow (its
  // pool slot + 1, 0 none) and what the rules said of yours
  ar: [1] arch.Archer;
  shot_arrow: [hostile.HS_SHOTS] int;
  dr: XcDruid;                      // the druid's grove (zone-shapechange.coax), off elsewhere
  own_kit: bool;                    // the page has one class of its own and no CLASSES picker (the Archery Range)
  bow_hits: int; bow_misses: int; bow_far: int;
}
XC_TICK :: 64.0;           // aethyr/loop.coax: ticks a second
XC_BLADE_R :: 0.12;        // m: a blade's sensor radius
XC_BLADE_TIP :: [5]f32.[1.0,1.25,0.9,0.6,0.6];   // m from the weapon's origin to its tip (CC_KITS order; the bow never swings)
XC_WINDOW :: 6;            // ticks the sensor is open either side of the swing's impact

// Each body kind's block (verse/experimental-dungeon.coax DG_KIND_* order) and the world's name for it.
XC_FOE_BLOCK :: [5] int.[MON_IMP, MON_GOBLIN_WARRIOR, MON_OGRE, MON_QUASIT, MON_HILL_GIANT];
XC_FOE_TITLE :: [5] string.["Imp", "Gremlin", "Puglin Brute", "Imp Fiend", "Puglin Warlord"];
xc_foe :: (kind: int) -> RsCreature {
  k := ifx kind >= 0 && kind < XC_FOE_BLOCK.count then kind else xdungeon.DG_KIND_GREMLIN;
  return rs_monster(XC_FOE_BLOCK[k], XC_FOE_TITLE[k], 1);
}
XC_FOE_NAMES :: [5] string.["IMP", "GREMLIN", "PUGLIN BRUTE", "IMP FIEND", "PUGLIN WARLORD"];
xc_set_level :: (x: [] XcCombat, level: int) {
  if level < 1 || level > 6 { return; }
  x[0].level = level;
  xc_set_class(x, x[0].klass);
}
xc_order_bar :: (x: [] XcCombat) {
  c := x[0].klass;
  for i: 0..<x[0].bar_n {
    if x[0].bar[i].kind == XC_BREATH { continue; }
    id := xc_id(x[0].bar[i]); found := false;
    for j: 0..<x[0].order_n[c] { if x[0].order[c][j] == id { found = true; } }
    if !found && x[0].order_n[c] < XC_SLOTS { x[0].order[c][x[0].order_n[c]] = id; x[0].order_n[c] += 1; }
  }
  // Sort visible abilities by the full remembered order, including unavailable levels.
  for i: 0..<x[0].bar_n {
    for j: i + 1..<x[0].bar_n {
      pi := XC_SLOTS; pj := XC_SLOTS;
      for q: 0..<x[0].order_n[c] {
        if x[0].order[c][q] == xc_id(x[0].bar[i]) { pi = q; }
        if x[0].order[c][q] == xc_id(x[0].bar[j]) { pj = q; }
      }
      if pj < pi { a := x[0].bar[i]; x[0].bar[i] = x[0].bar[j]; x[0].bar[j] = a; }
    }
  }
}
xc_swap :: (x: [] XcCombat, from: int, to: int) {
  if from < 0 || to < 0 || from >= x[0].bar_n || to >= x[0].bar_n || from == to { return; }
  if x[0].bar[from].kind == XC_BREATH || x[0].bar[to].kind == XC_BREATH { return; }
  c := x[0].klass; a := x[0].bar[from]; b := x[0].bar[to];
  for j: 0..<x[0].order_n[c] {
    if x[0].order[c][j] == xc_id(a) { x[0].order[c][j] = xc_id(b); }
    else if x[0].order[c][j] == xc_id(b) { x[0].order[c][j] = xc_id(a); }
  }
  x[0].bar[from] = b; x[0].bar[to] = a; x[0].order_dirty = true;
  x[0].used = -1; x[0].fizzle = -1;
}
// The host's realm-specific hotbar save (action/message 12).
xc_order_save :: (x: [] XcCombat, out: [] u8) -> int {
  n := put(out, 0, "xc-bar 1\n");
  for c: 0..<FB_CL_N {
    for j: 0..<x[0].order_n[c] { n = put_int(out, n, x[0].order[c][j]); n = put(out, n, " "); }
    n = put(out, n, "\n");
  }
  return ifx n < out.count then n else 0;
}
xc_order_load :: (x: [] XcCombat, text: string) -> bool {
  head := "xc-bar 1\n";
  if text.count < head.count || text[0..<head.count] != head { return false; }
  order: [12] [XC_SLOTS] int; counts: [12] int; c := 0; at := head.count;
  while at < text.count && c < FB_CL_N {
    if text[at] == '\n' { c += 1; at += 1; continue; }
    id := 0; digits := 0;
    while at < text.count && text[at] >= '0' && text[at] <= '9' {
      if digits >= 6 { return false; }
      id = id * 10 + cast(int) text[at] - '0'; digits += 1; at += 1;
    }
    if digits == 0 || at >= text.count || text[at] != ' ' || id >= (FB_ROAR + 1) * 10000 || counts[c] >= XC_SLOTS { return false; }
    for i: 0..<counts[c] { if order[c][i] == id { return false; } }
    order[c][counts[c]] = id; counts[c] += 1; at += 1;
  }
  if c != FB_CL_N || at != text.count { return false; }
  x[0].order = order; x[0].order_n = counts; x[0].order_dirty = false;
  if x[0].started { xc_order_bar(x); }
  return true;
}

// The battle, once: you and the six monsters, off the grid until a press places them.
xc_start :: (x: [] XcCombat, klass: int) {
  if x[0].started { return; }
  b := x[0].b[..];
  rs_reset(b);
  b[0].w = XC_SIDE; b[0].h = XC_SIDE;
  world_selected := rs_set_world(b,RS_EVERGLADE_WORLD);   // every declared deviation: world-profile.coax
  rest_scheduled := rs_rest_schedule_enable(b);
  b[0].dice[0].state = cast(u64) 13025 * 7919 + 3;
  _ := rs_add(b, fb_cl_hero(klass, "You", 0, 1), XC_MID, XC_MID);
  for i: 0..<XC_FOES { _ = rs_add(b, xc_foe(hostile.hostile_kind(i)), XC_AWAY, XC_AWAY); }
  rs_begin(b);
  for i: 0..<XC_FOES { x[0].npc_seat[i]=FbSeat.{me=i+1}; }
  x[0].started = true;
  xc_objects_start(x);
  xc_set_class(x, klass);
}
// You become class c at the selected level. The monsters keep their wounds.
xc_set_class :: (x: [] XcCombat, c: int) {
  if c < 0 || c >= FB_CL_N { return; }
  if !x[0].started { xc_start(x, c); return; }
  b := x[0].b[..];
  t := b[0].c[0].turn_at; ro := b[0].c[0].round_at;
  same_druid:=c==FB_CL_DRUID && b[0].c[0].klass==RS_DRUID && b[0].c[0].level==x[0].level;
  known:=b[0].c[0].wild_known; swap:=b[0].c[0].wild_swap;
  rs_end_concentration(b,0," (class preset changed)");
  rs_release_turned(b,0);
  f:=rs_familiar_of(b,0);
  if f>=0 && (c!=x[0].klass || b[0].c[0].level!=x[0].level) { rs_familiar_retire(b,f); }
  b[0].c[0] = fb_cl_hero(c, "You", 0, x[0].level);
  if c==FB_CL_WIZARD { fb_wizard_familiar_preset(b[0].c[0..<1],x[0].familiar_incense); }
  if c==FB_CL_PALADIN { fb_paladin_protection_preset(b[0].c[0..<1],x[0].protection_water_used); }
  if c==FB_CL_CLERIC { fb_cleric_revivify_preset(b[0].c[0..<1],x[0].revivify_diamond_used); }
  if same_druid { b[0].c[0].wild_known=known; b[0].c[0].wild_swap=swap; }
  b[0].c[0].turn_at = t; b[0].c[0].round_at = ro;
  rs_place(b, 0, XC_MID, XC_MID);
  x[0].seat[0] = FbSeat.{me = 0};
  x[0].jump_run=0; x[0].wild_old=0; x[0].wild_new=0; x[0].familiar_order=XC_FAMILIAR_CAST; x[0].familiar_touch=false;
  x[0].klass = c;
  x[0].bar_n = xc_actions(x[0].bar[..], xc_bar_level(c, x[0].level, x[0].bar[..]), b[0].c[0]);
  xc_order_bar(x); x[0].arranging = false;
  if x[0].dr.on { xd_bar(x); }
  x[0].used = -1; x[0].hover = -1; x[0].pend = -1;
}
// The actions every creature has (#13040), after the class kit: Hide, Grapple, Shove, Ready, and
// Search/Study/Influence on one slot; then a Ritual when the hero has a ritual spell (pp.104-105).
// Ready's spell is the kit's first action spell at a creature, its slot level the kit's.
XC_ACTIONS :: [5] int.[FB_HIDE, FB_GRAPPLE, FB_SHOVE, FB_READY, FB_SKILL];
XC_ACTION_NAME :: [5] string.["Hide", "Grapple", "Shove", "Ready", "Search"];
XC_ACTION_ART :: [5] string.["hide", "grapple", "shove", "ready", "search"];
xc_actions :: (bar: [] FbAb, n: int, hero: RsCreature) -> int {
  held := -1; held_lvl := 0;
  for i: 0..<n { a := bar[i]; if held < 0 && a.kind == FB_SPELL && a.tg == FB_FOE && rs_spell(a.sp).cast_time == RS_T_ACTION { held = a.sp; held_lvl = a.lvl; } }
  m := n;
  for q: 0..<5 { if m < bar.count { bar[m] = fb_feature(XC_ACTIONS[q], XC_ACTION_NAME[q], XC_ACTION_ART[q]); if q == 0 || q == 3 { bar[m].tg = FB_SELF; } if q == 3 { bar[m].sp = held; bar[m].lvl = held_lvl; } m += 1; } }
  rite := fb_ritual_spell(hero);
  if rite >= 0 && m < bar.count { bar[m] = fb_feature(FB_RITUAL, "Ritual", "ritual"); bar[m].sp = rite; bar[m].tg = FB_SELF; m += 1; }
  if (hero.companion || hero.klass==RS_WIZARD) && m<bar.count {
    bar[m]=fb_feature(XC_FAMILIAR,ifx hero.companion then "Wild Companion" else "Find Familiar","ritual");
    bar[m].tg=FB_SELF; bar[m].opt=0; m+=1;
  }
  return m;
}
// A monster's kind's Area of Knowledge (p.188) for Study: the Imp and Quasit are Fiends (Religion),
// the Goblin Fey (Arcana), the Ogre and Hill Giant Giants (History), in XC_FOE_BLOCK's order.
XC_FOE_LORE :: [5] int.[SK_RELIGION, SK_ARCANA, SK_HISTORY, SK_RELIGION, SK_HISTORY];
// A monster's square round you: the nearest whole square to where it stands, off the grid when far.
xc_square :: (d: f32) -> int {
  q := cast(int) floor(d / f32(XC_SQ) + 0.5);
  return ifx q <= -XC_MID || q >= XC_MID then XC_AWAY else XC_MID + q;
}
// What kind of aim ability a takes, and its reach in metres (class-kit.coax xc_aim_for), for the weapon you hold.
xc_aim_kind :: (s: [] EgZone, a: FbAb) -> XcAim { return xc_aim_for(a, s[0].xc[0].b[0].c[0].weapon); }
// A single-target spell's monster: Aethyr's attention query (aethyr/cam/attention.coax) for an action
// target within reach in a 30 degree cone ahead, the nearest first (angle-weighted), ties by id. The
// SRD still decides what the spell does; this only says at whom. -1 when none.
xc_attend :: (s: [] EgZone, fx: f32, fz: f32, reach: f32) -> int {
  cr := s[0].creator[..]; h := cr[0].hostiles[..];
  y := xmeadow.exp_height(cr[0].player_x, cr[0].player_z) + 1.2;
  // the living monsters in reach you can see (not through a dungeon wall), within the shared
  // answer's ATTN_CANDIDATES
  ts: [attn.ATTN_CANDIDATES] attn.AttnTarget; tn := 0;
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    dx := e.x - cr[0].player_x; dz := e.z - cr[0].player_z;
    if e.dead || dx * dx + dz * dz > (reach + 1) * (reach + 1) || tn >= ts.count || !hostile.hostile_sees(e, cr[0].player_x, cr[0].player_z) { continue; }
    ts[tn] = attn.AttnTarget.{id = i, gen = 1, caps = attn.ATTN_ACTION, at = asp.world_point(e.x, y, e.z), radius = 0, valid = true}; tn += 1;
  }
  q := attn.AttnQuery.{origin = asp.world_point(cr[0].player_x, y, cr[0].player_z), forward = asp.world_point(fx, 0, fz), need = attn.ATTN_ACTION, acquire = reach, acquire_cos = 0.9659};
  c: aq.Colliders; c.ground = -1000;   // the meadow fight has no walls between you and a monster
  return attn.attn_step(attn.AttnState.{}, q, ts[0..<tn], c, 0, false, false).target;
}
// Your target: the monster you struck at, held by Aethyr's attention (lock-on capability). Nothing is
// acquired for you (acquire 0): it is set only by a strike, kept within 24 m all round you for at least
// the hold, kept through a second of being out of reach (the grace), and released at once when it falls.
XC_LOCK_HOLD :: 16; XC_LOCK_GRACE :: 64;
xc_lock_query :: (s: [] EgZone) -> attn.AttnQuery {
  cr := s[0].creator[..]; y := xmeadow.exp_height(cr[0].player_x, cr[0].player_z) + 1.2;
  return attn.AttnQuery.{origin = asp.world_point(cr[0].player_x, y, cr[0].player_z), forward = asp.world_point(sin(cr[0].player_face), 0, cos(cr[0].player_face)),
    need = attn.ATTN_LOCK, acquire = 0, retain = 24, acquire_cos = 1, retain_cos = -1, rise = 6, hold = XC_LOCK_HOLD, grace = XC_LOCK_GRACE};
}
// The living monsters within the hold's reach, the held one first, up to the shared answer's
// ATTN_CANDIDATES; how many.
xc_lock_targets :: (s: [] EgZone, out: [] attn.AttnTarget) -> int {
  cr := s[0].creator[..]; h := cr[0].hostiles[..]; held := s[0].xc[0].lock.target; n := 0;
  for pass: 0..<2 { for i: 0..<XC_FOES {
    if (pass == 0) != (i == held) { continue; }
    e := h[0].enemies[i];
    dx := e.x - cr[0].player_x; dz := e.z - cr[0].player_z;
    if n >= out.count || (pass == 1 && (e.dead || dx * dx + dz * dz > 25 * 25)) { continue; }   // the held one always, so its range and fall are judged
    out[n] = attn.AttnTarget.{id = i, gen = 1, caps = attn.ATTN_LOCK | attn.ATTN_ACTION, at = asp.world_point(e.x, xmeadow.exp_height(e.x, e.z) + 1.2, e.z), radius = 0.35, valid = !e.dead}; n += 1;
  } }
  return n;
}
// Lock onto monster foe now (a strike at it).
xc_lock_on :: (s: [] EgZone, foe: int) {
  x := s[0].xc[..]; now := xc_tick(s[0].creator[0].clock);
  if foe < 0 || foe >= XC_FOES { return; }
  if x[0].lock.target != foe { x[0].lock = attn.AttnState.{target = foe, gen = 1, since = now, seen = now, reason = attn.AttnReason.acquired}; }
  else { x[0].lock.seen = now; }
  x[0].target = foe;
}
// One step of the held target at the creator clock's tick.
xc_lock_step :: (s: [] EgZone) {
  x := s[0].xc[..];
  if x[0].lock.target < 0 { x[0].target = -1; return; }
  ts: [attn.ATTN_CANDIDATES] attn.AttnTarget; tn := xc_lock_targets(s, ts[..]);
  c: aq.Colliders; c.ground = -1000;   // the meadow fight has no walls between you and a monster
  x[0].lock = attn.attn_step(x[0].lock, xc_lock_query(s), ts[0..<tn], c, xc_tick(s[0].creator[0].clock), false, false);
  x[0].target = x[0].lock.target;
}
// Hit stops (aethyr/action/react.coax): a blow that lands pauses the struck monster for its profile's
// ticks, and a monster whose blow lands on you pauses itself. Only those actors are held; the world, the
// other monsters and you go on. Actor 0 is you, 1 to 6 the monsters.
XC_STOP_STRUCK :: 5; XC_STOP_STRIKER :: 4;
xc_stop_hit :: (s: [] EgZone, foe: int, kinds: u32) {
  x := s[0].xc[..]; cr := s[0].creator[..]; e := cr[0].hostiles[0].enemies[foe];
  dx := cr[0].player_x - e.x; dz := cr[0].player_z - e.z; l := sqrt(dx * dx + dz * dz);
  toward := ifx l > 0.0001 then asp.world_point(dx / l, 0, dz / l) else asp.world_point(0, 0, 1);
  a := react.AttackAttrs.{kinds = kinds, stop = react.HitStop.{ticks = XC_STOP_STRUCK, scope = react.StopScope.target}};
  r := react.react_decide(a, react.TargetResponse.{}, asp.world_point(e.face_x, 0, e.face_z), toward, 1);
  x[0].stops = react.react_stop_add(x[0].stops, r, 0, 1 + foe, xc_tick(cr[0].clock));
}
xc_stop_striker :: (s: [] EgZone, foe: int) {
  x := s[0].xc[..]; cr := s[0].creator[..];
  claw := react.AttackAttrs.{kinds = react.DMG_SLASH, stop = react.HitStop.{ticks = XC_STOP_STRIKER, scope = react.StopScope.source}};
  r := react.react_decide(claw, react.TargetResponse.{}, asp.world_point(sin(cr[0].player_face),0,cos(cr[0].player_face)),asp.world_point(0,0,1),1);
  x[0].stops = react.react_stop_add(x[0].stops,r,1+foe,0,xc_tick(cr[0].clock));
}
xc_stops_step :: (s: [] EgZone) {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..]; now := xc_tick(cr[0].clock);
  if h[0].hits > x[0].seen_hits && h[0].last >= 0 && h[0].last < XC_FOES {
    xc_stop_striker(s,h[0].last);
  }
  x[0].seen_hits = h[0].hits;
  x[0].stops = react.react_stop_expire(x[0].stops, now);
  for i: 0..<XC_FOES { h[0].enemies[i].stopped = !h[0].enemies[i].dead && react.react_held(x[0].stops, 1 + i, now); }
}
// Ability a's aim from where you stand and face: its kind, its reach, your forward and its monster.
xc_aim :: (s: [] EgZone, a: FbAb) -> XcAim {
  cr := s[0].creator[..]; h := cr[0].hostiles[..];
  m := xd_reach(s, a, xc_aim_kind(s, a));
  m.fx = sin(cr[0].player_face); m.fz = cos(cr[0].player_face);   // aethyr/walk.coax: you face atan2(x, z)
  if m.kind == XC_AIM_SELF { return m; }
  best := 1e9f32;
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    if e.dead { continue; }
    dx := e.x - cr[0].player_x; dz := e.z - cr[0].player_z;
    along := dx * m.fx + dz * m.fz; side := abs(dx * m.fz - dz * m.fx); d := sqrt(dx * dx + dz * dz);
    hit := false;
    if m.kind == XC_AIM_BOLT { hit = along > 0 && along <= m.reach + f32(XC_BODY) && (side <= f32(XC_BODY) || side <= along * f32(XC_ASSIST)); }
    else if m.kind == XC_AIM_MELEE { hit = d <= m.reach && along >= d * 0.7071; }
    else if m.kind == XC_AIM_AREA { hit = d <= hi(m.reach, 1) && along >= d * 0.9659; }   // an area's point: 30 degrees
    key := ifx m.kind == XC_AIM_BOLT then along else d;
    if hit && key < best && hostile.hostile_sees(e, cr[0].player_x, cr[0].player_z) { best = key; m.foe = i; }   // not through a wall
  }
  if m.kind == XC_AIM_CONE { m.foe = xc_attend(s, m.fx, m.fz, hi(m.reach, 1)); }
  if m.kind == XC_AIM_AREA {
    sp := rs_spell(a.sp);
    // a cube from you is set ahead of you; a placed area lands on that monster, or 6 m on
    m.reach = ifx sp.area == RS_A_CUBE_SELF then f32(sp.area_ft) * f32(XC_FT) else ifx m.foe >= 0 then best else lo(m.reach, 6);
    m.foe = -1;
  }
  return m;
}

// Keep the sphere at its original world point while the grid follows the hero.
xc_truth_project :: (s:[] EgZone,new_zones:int) {
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..];
  if b[0].truth_zones==0 { return; }
  sq:=f32(XC_SQ);
  for k:0..<RS_ZONES {
    bit:=1<<k;
    if (b[0].truth_zones&bit)==0 { continue; }
    z:=b[0].zone[k..<k+1];
    fresh:=(new_zones&bit)!=0;
    if fresh {
      x[0].truth_x[k]=cr[0].player_x+f32(z[0].cx-XC_MID)*sq;
      x[0].truth_z[k]=cr[0].player_z+f32(z[0].cy-XC_MID)*sq;
    }
    dx:=XC_MID+cast(int)floor((x[0].truth_x[k]-cr[0].player_x)/sq+0.5)-z[0].cx;
    dz:=XC_MID+cast(int)floor((x[0].truth_z[k]-cr[0].player_z)/sq+0.5)-z[0].cy;
    z[0].cx+=dx; z[0].x0+=dx; z[0].x1+=dx;
    z[0].cy+=dz; z[0].y0+=dz; z[0].y1+=dz;
    for i:0..<b[0].n {
      if b[0].c[i].x!=XC_AWAY && rs_truth_inside(b,i,k) {
        if !fresh && (x[0].truth_inside[i]&bit)==0 { rs_truth_cross(b,i,k); }
        x[0].truth_inside[i]|=bit;
      } else { x[0].truth_inside[i]=rs_clear(x[0].truth_inside[i],bit); }
    }
  }
}
// Restore the world's coordinate frame after a facing-relative cube, so other
// ongoing areas and later combat steps continue to use world-aligned squares.
xc_sync_world :: (s: [] EgZone) {
  b := s[0].xc[0].b[..]; cr := s[0].creator[..];
  rs_place(b,0,XC_MID,XC_MID);
  for i: 0..<XC_FOES {
    e := cr[0].hostiles[0].enemies[i];
    qx := xc_square(e.x-cr[0].player_x); qz := xc_square(e.z-cr[0].player_z);
    if e.dead || qx == XC_AWAY || qz == XC_AWAY { qx = XC_AWAY; qz = XC_AWAY; }
    rs_place(b, i+1, qx, qz);
  }
  xc_familiar_project(s,0,1);
  xc_truth_project(s,0);
}
xc_familiar_project :: (s:[] EgZone,fx:f32,fz:f32) {
  x:=s[0].xc[..]; b:=x[0].b[..];
  f:=rs_familiar_of(b,0);
  if f<0 || !rs_up(b[0].c[f]) { return; }
  dx:=x[0].familiar_x-s[0].creator[0].player_x;
  dz:=x[0].familiar_z-s[0].creator[0].player_z;
  gx:=xc_square(dx*fz-dz*fx); gz:=xc_square(dx*fx+dz*fz);
  if gx==XC_AWAY || gz==XC_AWAY { rs_place(b,f,XC_AWAY,XC_AWAY); }
  else { rs_place(b,f,gx,gz); }
}
// The AI produces candidate bodies locally. Publish each only after a selected
// player opportunity has resolved; the real mover's seat is the active turn.
xc_monster_move :: (s:[] EgZone,foe:int,proposed:hostile.Enemy) {
  x:=s[0].xc[..]; if !x[0].started || foe<0 || foe>=XC_FOES { return; }
  b:=x[0].b[..]; cr:=s[0].creator[..]; h:=cr[0].hostiles[..]; old:=h[0].enemies[foe];
  if xc_object_blocked(s,proposed.x,proposed.z,0.3*proposed.scale) { return; }
  moving:=proposed.moving && (old.x!=proposed.x || old.z!=proposed.z);
  if moving {
    xc_sync_world(s);
    weapon:=b[0].c[0].weapon; wp:=rs_weapon(weapon);
    if wp.range_ft>wp.reach_ft && !wp.both { weapon=W_UNARMED; wp=rs_weapon(weapon); }
    py:=xmeadow.exp_height(cr[0].player_x,cr[0].player_z)+cr[0].player_y;
    dx:=old.x-cr[0].player_x; dz:=old.z-cr[0].player_z; dy:=xmeadow.exp_height(old.x,old.z)-py;
    tx:=proposed.x-cr[0].player_x; tz:=proposed.z-cr[0].player_z; ty:=xmeadow.exp_height(proposed.x,proposed.z)-py;
    q:=RsOpportunityMove.{measured=true,from_feet=sqrt(dx*dx+dy*dy+dz*dz)/f32(XC_SQ)*5,to_feet=sqrt(tx*tx+ty*ty+tz*tz)/f32(XC_SQ)*5,
      reach=wp.reach_ft,melee=true,movement=true,seen=!rs_has(b[0].c[0],RS_BLINDED) && !rs_has(b[0].c[foe+1],RS_INVISIBLE) && hostile.hostile_sees(old,cr[0].player_x,cr[0].player_z)};
    fb_seat_in(b,x[0].npc_seat[foe..<foe+1]);
    // a Goblin leaving your reach takes Nimble Escape's Disengage, its Bonus Action
    if rs_opportunity_trigger(b,0,foe+1,q) && rs_trait(b[0].c[foe+1],RS_TRAIT_NIMBLE) { _ := rs_disengage_use(b,foe+1,RS_DISENGAGE_NIMBLE); }
    if rs_opportunity_trigger(b,0,foe+1,q) {
      before:=b[0].c[foe+1].hp;
      result:=rs_opportunity_attack(b,0,foe+1,weapon,q);
      lost:=before-rs_max(b[0].c[foe+1].hp,0);
      if result.admitted && lost>0 {
        x[0].calm[foe]=false; x[0].landed+=1; x[0].last_dmg=lost; _ := cc.eg_numbers_amount(x[0].floats[..], 0, old.x, meadow_y(old.x, old.z) + 1.9, old.z, cr[0].clock, false, false, false, lost);
        snd:=xc_sound(xc_attack(),x[0].klass); xc_cue(s,snd.hit,0.55,old.x,old.z,snd.rate);
        if rs_up(b[0].c[foe+1]) { xc_stop_hit(s,foe,react.DMG_SLASH); xc_voice(s,foe,false); } else { xc_voice(s,foe,true); }
      }
    }
    // a readied response (#13040) answers the first monster that moves: the attack or the held spell
    // at it when it is in reach or range (refused, still held, when not), or a move straight away
    // from it, up to your Speed, that carries you there
    k:=rs_ready_at(b[0].c[0]);
    if k>=0 && rs_ready_triggered(b,0,foe+1) {
      e:=b[0].c[0].eff[k]; before:=b[0].c[foe+1].hp; answered:=false;
      if rs_ready_response(e)==RD_MOVE {
        sx:=-rs_sign(b[0].c[foe+1].x-XC_MID); sz:=-rs_sign(b[0].c[foe+1].y-XC_MID);
        if sx==0 && sz==0 { sz=-1; }
        xs:[12] int; ys:[12] int; m:=rs_min(rs_walk_speed(b,0)/5,12);
        for sq:0..<m { xs[sq]=XC_MID+sx*(sq+1); ys[sq]=XC_MID+sz*(sq+1); }
        moved:=rs_ready_move(b,0,foe+1,xs[0..<m],ys[0..<m]);
        if moved>0 { x[0].glide_x=cr[0].player_x+f32(sx*moved)*f32(XC_SQ); x[0].glide_z=cr[0].player_z+f32(sz*moved)*f32(XC_SQ); x[0].glide_until=cr[0].clock+1.0; }
        rs_place(b,0,XC_MID,XC_MID);
      } else if rs_ready_response(e)==RD_SPELL { answered=rs_ready_spell(b,0,foe+1,b[0].c[foe+1].x,b[0].c[foe+1].y,foe+1); }
      else { answered=rs_ready_attack(b,0,foe+1); }
      lost:=before-rs_max(b[0].c[foe+1].hp,0);
      if lost>0 { x[0].calm[foe]=false; x[0].landed+=1; x[0].last_dmg=lost; _ := cc.eg_numbers_amount(x[0].floats[..], 0, old.x, meadow_y(old.x, old.z) + 1.9, old.z, cr[0].clock, false, false, false, lost); xc_voice(s,foe,!rs_up(b[0].c[foe+1])); }
      else if answered { _ := cc.eg_numbers_word(x[0].floats[..], 0, old.x, meadow_y(old.x, old.z) + 1.9, old.z, cr[0].clock, "MISS", false); }
    }
    fb_seat_out(b,x[0].npc_seat[foe..<foe+1]);
  }
  next:=proposed;
  if !rs_can_move(b[0].c[foe+1]) || rs_walk_speed(b,foe+1)<=0 { next.x=old.x; next.z=old.z; next.moving=false; }
  h[0].enemies[foe]=next;
  observed:=rs_rest_observe_motion(b,foe+1,moving && (next.x!=old.x || next.z!=old.z),false,!moving);
  xc_sync_permission(s,foe); xc_sync_vitals(s);
}
// Spirit Guardians (p.164): a monster saves when it enters your Emanation or the Emanation enters its
// space, whoever moved (its end-of-turn save comes from its own turn, fb_seat_step). Once a turn.
xc_guardians_step :: (s:[] EgZone) {
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..]; h:=cr[0].hostiles[..];
  if !x[0].started { return; }
  on:=b[0].c[0].conc==SP_SPIRIT_GUARDIANS;
  for foe:0..<XC_FOES {
    e:=h[0].enemies[foe];
    dx:=e.x-cr[0].player_x; dz:=e.z-cr[0].player_z;
    inside:=on && !e.dead && sqrt(dx*dx+dz*dz)/f32(XC_SQ)*5<=15;
    if inside && !x[0].guard_in[foe] {
      xc_sync_world(s);
      before:=b[0].c[foe+1].hp;
      fb_seat_in(b,x[0].npc_seat[foe..<foe+1]); rs_guardians(b,foe+1); fb_seat_out(b,x[0].npc_seat[foe..<foe+1]);
      lost:=before-rs_max(b[0].c[foe+1].hp,0);
      if lost>0 {
        snd:=xc_spell_sound(SP_SPIRIT_GUARDIANS); x[0].landed+=1; x[0].last_dmg=lost;
        _ := cc.eg_numbers_amount(x[0].floats[..], 0, e.x, meadow_y(e.x, e.z) + 1.9, e.z, cr[0].clock, false, false, false, lost); xc_cue(s,snd.hit,0.55,e.x,e.z,snd.rate);
        xc_voice(s,foe,!rs_up(b[0].c[foe+1]));
      }
      xc_sync_permission(s,foe);
    }
    x[0].guard_in[foe]=inside;
  }
}
xc_hostile_tick :: (s:[] EgZone,dt:f32) {
  h:=s[0].creator[0].hostiles[..]; cr:=s[0].creator[..];
  xc_sync_world(s);
  fastest:f32=0; limit:f32=0.15;
  for i:0..<XC_FOES {
    rate:=rs_locomotion_scale(s[0].xc[0].b[..],i+1); if rate>fastest { fastest=rate; }
    radius:=h[0].enemies[i].scale; if radius>0 && radius<1 && radius*f32(0.15)<limit { limit=radius*f32(0.15); }
  }
  parts:=xtravel.walk_travel_parts(fastest*f32(2.4),dt,limit);
  if parts==0 { xc_guardians_step(s); return; }
  time:=h[0].time;
  for part:0..<parts {
    proposed:[1]hostile.Hostiles; proposed[0]=h[0];
    for i:0..<XC_FOES { proposed[0].enemies[i].walk_scale=rs_locomotion_scale(s[0].xc[0].b[..],i+1); }
    hostile.hostile_tick(proposed[..],cr[0].player_x,cr[0].player_y,cr[0].player_z,dt/f32(parts));
    h[0].time=proposed[0].time; h[0].contacts[0]=proposed[0].contacts[0]; h[0].shots=proposed[0].shots;   // the shots loosed and landed
    for foe:0..<XC_FOES { xc_monster_move(s,foe,proposed[0].enemies[foe]); }
  }
  h[0].time=time+dt;
  xc_guardians_step(s);
}
// Controller locomotion proposes a physical position; current creature/body
// positions remain authoritative until this returns. Teleports synchronize their
// origin separately in zone_walk and never pass their displacement here.
xc_depart :: (s:[] EgZone,origin:EgBody,proposed:EgBody)->bool {
  x:=s[0].xc[..]; if !x[0].started { return true; }
  b:=x[0].b[..]; cr:=s[0].creator[..]; h:=cr[0].hostiles[..];
  if !rs_can_move(b[0].c[0]) || rs_walk_speed(b,0)<=0 { return false; }
  px:=cr[0].player_x; py0:=cr[0].player_y; pz:=cr[0].player_z;
  cr[0].player_x=origin.x; cr[0].player_y=origin.y; cr[0].player_z=origin.z;
  xc_sync_world(s);
  fb_seat_in(b,x[0].seat[..]);
  py:=xmeadow.exp_height(cr[0].player_x,cr[0].player_z)+cr[0].player_y;
  next_y:=xmeadow.exp_height(proposed.x,proposed.z)+proposed.y;
  for foe:0..<XC_FOES {
    e:=h[0].enemies[foe]; if e.dead { continue; }
    a:=xc_hostile_attack(e.kind);
    dx:=e.x-cr[0].player_x; dz:=e.z-cr[0].player_z; ey:=xmeadow.exp_height(e.x,e.z);
    dy:=ey-py; tx:=e.x-proposed.x; tz:=e.z-proposed.z; ty:=ey-next_y;
    before:=sqrt(dx*dx+dy*dy+dz*dz)/f32(XC_SQ)*5;
    after:=sqrt(tx*tx+ty*ty+tz*tz)/f32(XC_SQ)*5;
    seen:=!rs_has(b[0].c[foe+1],RS_BLINDED) && !rs_has(b[0].c[0],RS_INVISIBLE) && hostile.hostile_sees(e,cr[0].player_x,cr[0].player_z);
    q:=RsOpportunityMove.{measured=true,from_feet=before,to_feet=after,reach=a.reach+rs_space_feet(b[0].c[foe+1]),melee=true,seen=seen,movement=true};
    if !rs_stat_attack_valid(a) || !rs_opportunity_trigger(b,foe+1,0,q) { continue; }
    hp_before:=b[0].c[0].hp+b[0].c[0].temp; seq:=b[0].book[0].seq;
    result:=rs_stat_opportunity(b,foe+1,0,a,q);
    xc_hostile_result(s,foe,hp_before,seq,result.admitted);
    if !rs_can_move(b[0].c[0]) || rs_walk_speed(b,0)<=0 { break; }
  }
  fb_seat_out(b,x[0].seat[..]);
  cr[0].player_x=px; cr[0].player_y=py0; cr[0].player_z=pz;
  xc_sync_vitals(s); xc_sync_permissions(s);
  return rs_can_move(b[0].c[0]) && rs_walk_speed(b,0)>0;
}
// The bodies publish contact intent; the shared battle owns all outcomes. A kind's attack Action is
// its block's; its Opportunity Attack the block's first melee record.
xc_hostile_action :: (kind: int) -> RsStatAction {
  if kind<0 || kind>=XC_FOE_BLOCK.count { return RsStatAction.{}; }
  return rs_monster_action(XC_FOE_BLOCK[kind]);
}
xc_hostile_attack :: (kind: int) -> RsStatAttack {
  m := xc_hostile_action(kind); k := rs_stat_melee_pick(m);
  return ifx k >= 0 then m.attacks[k] else RsStatAttack.{};
}
xc_sync_vitals :: (s: [] EgZone) {
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  if !s[0].xc[0].started { return; }
  if h[0].hp>0 && b[0].c[0].hp==0 { h[0].died_at=h[0].time; }
  if !h[0].shared { for i: 0..<XC_FOES { if h[0].enemies[i].dead { b[0].c[i+1].hp=0; b[0].c[i+1].dead=true; } } }
  h[0].shared=true; h[0].hp=b[0].c[0].hp; h[0].max_hp=b[0].c[0].hp_max;
  h[0].temp=b[0].c[0].temp; h[0].player_dead=b[0].c[0].dead;
}
// Shared damage/hit presentation for Action contacts and opportunity Reactions.
xc_hostile_result :: (s:[] EgZone,foe:int,before:int,seq:int,accepted:bool) {
  x:=s[0].xc[..]; b:=x[0].b[..]; cr:=s[0].creator[..]; h:=cr[0].hostiles[..];
    lost := before-b[0].c[0].hp-b[0].c[0].temp;
    landed := false;
    for k: 0..<rs_min(b[0].book[0].seq-seq,RS_EVENTS) {
      event := rs_recent(b[0].book[0],k);
      if event.kind==RS_EV_ATTACK && event.by==foe+1 && event.to==0 { landed=true; }
    }
    // Shield (p.161), cast as your Reaction to the blow: its own sound and barrier
    for k: 0..<rs_min(b[0].book[0].seq-seq,RS_EVENTS) {
      event := rs_recent(b[0].book[0],k);
      if event.kind==RS_EV_CAST && event.spell==SP_SHIELD && event.by==0 {
        shield := fb_spell(SP_SHIELD,1,FB_SELF); xc_cast_sound(s,shield); xc_look(s,shield,-1,cr[0].player_x,cr[0].player_z); x[0].shields+=1;
      }
    }
    if accepted && landed { h[0].hits+=1; h[0].last=foe; xc_stop_striker(s,foe); x[0].seen_hits=h[0].hits;
      x[0].hit_at=cr[0].clock; x[0].hit_x=h[0].enemies[foe].x; x[0].hit_z=h[0].enemies[foe].z; }
    if accepted && lost>0 {
      _ := cc.eg_numbers_amount(h[0].taken[..],0,cr[0].player_x,cr[0].player_y+2.1,cr[0].player_z,h[0].time,true,false,false,lost);
    }
}
// The monsters' shots as you see and hear them (#13066): each flies from the hand that loosed it
// (FXR_SHAFT, an arrow, for a Goblin's Shortbow; FXR_STONE, a rock, for the Ogre and the Hill Giant)
// to where you stood, arriving when hostile_fly resolves it, with a release sound at the shooter.
// One that hits strikes you with an impact; one that misses flies on past and away.
xc_shots_step :: (s: [] EgZone) {
  cr := s[0].creator[..]; h := cr[0].hostiles[..]; now := cr[0].clock;
  for k: 0..<hostile.HS_SHOTS {
    q := h[0].shots[k..<k+1];
    if q[0].state == hostile.HS_FREE { continue; }
    arrow := q[0].kind == xdungeon.DG_KIND_GREMLIN;
    recipe := ifx arrow then FXR_SHAFT else FXR_STONE;
    big := ifx arrow then 1.0f32 else ifx q[0].kind == xdungeon.DG_KIND_BOSS then 1.8f32 else 1.2f32;
    from := fxp_v(q[0].fx, q[0].fy, q[0].fz); to := fxp_v(q[0].tx, q[0].ty, q[0].tz);
    if !q[0].shown {
      q[0].shown = true;
      left := q[0].fly - (h[0].time - q[0].t0); if left < 0.05 { left = 0.05; }
      // an arrow is the shared bow's (aethyr/action/bow.coax): it arcs to where you stood, arriving
      // as hostile_fly resolves it; a rock is the effect
      if arrow {
        f3 := [3] f32.[q[0].fx, q[0].fy, q[0].fz]; t3 := [3] f32.[q[0].tx, q[0].ty, q[0].tz];
        s[0].xc[0].shot_arrow[k] = 1 + bow.arrow_loose(s[0].xc[0].ar[0].arrows[..], 1 + q[0].foe, f3, bow.arrow_timed_velocity(f3, t3, left), now, -2, 1);
      } else { fx_start_at(s, recipe, now, from, to, fxp_v(1, 1, 1), big, left); }
      xc_cue(s, ifx arrow then eg_bow_other_cue().name else "hurl", eg_bow_other_cue().gain, q[0].fx, q[0].fz, ifx arrow then 1.0f32 else 1 / sqrt(big));
    }
    if q[0].state != hostile.HS_LANDED || q[0].ended { continue; }
    q[0].ended = true;
    if q[0].hit {
      fx_start_at(s, ifx arrow then FXR_HIT else FXR_DUST, now, from, to, fxp_v(0.8, 0.7, 0.55), ifx arrow then 0.7f32 else big, 1);
      xc_cue(s, ifx arrow then "arrow-flesh" else "rock-hit", 0.7, q[0].tx, q[0].tz, 1);
      // the arrow ends in you
      ai := s[0].xc[0].shot_arrow[k] - 1;
      if arrow && ai >= 0 && s[0].xc[0].ar[0].arrows[0].a[ai].state == bow.ARROW_FLYING {
        seg := bow.arrow_segment(s[0].xc[0].ar[0].arrows[..], ai, now);
        if seg.count > 0 { bow.arrow_stop(s[0].xc[0].ar[0].arrows[..], ai, seg, 1, true); } else { s[0].xc[0].ar[0].arrows[0].a[ai].state = bow.ARROW_HIT; }
      }
      continue;
    }
    // an arrow that misses flies on along its own arc until it meets the ground (xc_bow_step)
    if arrow { xc_bow_cue(s, eg_bow_by_cue(), q[0].tx, q[0].tz); continue; }
    // a miss: on past you the way it flew, down to the ground (an arrow 12 m on, a rock 4)
    dx := q[0].tx - q[0].fx; dz := q[0].tz - q[0].fz; d := sqrt(dx * dx + dz * dz); if d < 0.01 { d = 0.01; }
    on := ifx arrow then 12.0f32 else 4.0f32;
    ex := q[0].tx + dx / d * on; ez := q[0].tz + dz / d * on; ey := meadow_y(ex, ez) + 0.1;
    sx := ex - q[0].tx; sy := ey - q[0].ty; sz := ez - q[0].tz;
    fly := sqrt(sx * sx + sy * sy + sz * sz) / hostile.hostile_shot_speed(q[0].kind);
    fx_start_at(s, recipe, now, to, fxp_v(ex, ey, ez), fxp_v(1, 1, 1), big, fly);
    xc_cue(s, ifx arrow then "arrow-whiz" else "rock-hit", ifx arrow then 0.55f32 else 0.4f32, ifx arrow then q[0].tx else ex, ifx arrow then q[0].tz else ez, 1);
  }
}
xc_hostile_contacts :: (s: [] EgZone) {
  x := s[0].xc[..]; b := x[0].b[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  xc_sync_world(s);
  // Quiet actors take turns too: repeat saves do not depend on reaching you.
  f:=x[0].familiar_seat[0].me;
  if f>0 {
    fb_seat_step(b,x[0].familiar_seat[..]);
    if b[0].c[f].hp==0 { x[0].familiar_order=XC_FAMILIAR_CAST; }
  }
  for i: 0..<XC_FOES { fb_seat_step(b,x[0].npc_seat[i..<i+1]); }
  if x[0].dragon_seat[0].me > 0 { fb_seat_step(b,x[0].dragon_seat[..]); }   // its turns: Burning ticks, the breath recharges
  while h[0].contacts[0].count>0 {
    foe := hostile.hc_take(h[0].contacts[..]);
    // a shot that arrives with no Action to spend, or at no one, flies on past (hostile_shot_result)
    if foe<0 || foe>=XC_FOES || !rs_up(b[0].c[0]) || h[0].enemies[foe].dead || !x[0].npc_seat[foe].open { if foe>=0 && foe<XC_FOES { hostile.hostile_shot_result(h,foe,false); } continue; }
    before := b[0].c[0].hp+b[0].c[0].temp; seq := b[0].book[0].seq; hits := h[0].hits;
    fb_seat_in(b,x[0].npc_seat[foe..<foe+1]);
    accepted := rs_stat_multiattack(b,foe+1,0,xc_hostile_action(h[0].enemies[foe].kind));
    fb_seat_out(b,x[0].npc_seat[foe..<foe+1]);
    xc_hostile_result(s,foe,before,seq,accepted);
    hostile.hostile_shot_result(h,foe,h[0].hits>hits);
  }
  xc_sync_vitals(s);
}
// Project shared movement/action permissions independently into the body AI.
// A Stunned actor can move; a Restrained actor can still take an action.
xc_sync_permission :: (s:[] EgZone,i:int) {
  b:=s[0].xc[0].b[..]; h:=s[0].creator[0].hostiles[..];
  if i<0 || i>=XC_FOES || i+1>=b[0].n { return; }
    c := b[0].c[i+1];
    if c.dead && !h[0].enemies[i].dead {
      h[0].enemies[i].dead=true; h[0].enemies[i].died=s[0].creator[0].clock;
      h[0].enemies[i].moving=false; h[0].enemies[i].swing = -1;
      s[0].xc[0].kills+=1;
      if s[0].xc[0].target==i { s[0].xc[0].target = -1; }
    }
    h[0].enemies[i].held = !rs_can_move(c) || rs_walk_speed(b,i+1)<=0;
    h[0].enemies[i].inactive = !rs_can_act(c) || s[0].xc[0].calm[i];   // Influence: it stands down
    if s[0].xc[0].calm[i] { h[0].enemies[i].held = true; }
    // Retire a pending attack immediately, including between body ticks.
    if h[0].enemies[i].inactive { h[0].enemies[i].swing = -1; h[0].enemies[i].struck = false; }
}
// Grappled (p.181): the monster you hold comes along as you walk, kept within your reach. A wall
// it can't be dragged through parts you, and the grapple lapses (grapple.coax), as it does when
// you are Incapacitated.
xc_grapple_step :: (s: [] EgZone) {
  x := s[0].xc[..]; b := x[0].b[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  g := b[0].c[0].grappling;
  if !x[0].started || g < 1 || g > XC_FOES { return; }
  e := h[0].enemies[g - 1..<g];
  dx := e[0].x - cr[0].player_x; dz := e[0].z - cr[0].player_z; d := sqrt(dx * dx + dz * dz); keep := f32(XC_REACH) * 0.8;
  if d > keep {
    nx := cr[0].player_x + dx * keep / d; nz := cr[0].player_z + dz * keep / d;
    if !xc_blocked(s,nx,nz) { e[0].x = nx; e[0].z = nz; }
  }
  xc_sync_world(s); rs_grapple_lapse(b, 0); xc_sync_permission(s, g - 1);
}
// Place the familiar in an open neighboring square, preferring the facing
// direction. The same world coordinates are projected back into the grid.
xc_familiar_arrive :: (s:[] EgZone,a:FbAb,timed:bool,recall:bool)->bool {
  x:=s[0].xc[..]; b:=x[0].b[..]; cr := s[0].creator[..];
  xc_sync_world(s);
  form:=RS_FAMILIAR_FORMS[a.opt%RS_FAMILIAR_FORMS.count];
  spirit:=RS_FAMILIAR_FEY+a.opt/RS_FAMILIAR_FORMS.count;
  f:=rs_familiar_of(b,0);
  reform:=!recall && f>=0 && b[0].c[f].hp>0;
  for step:0..<8 {
    theta:=cr[0].player_face+f32(step)*0.7853982;
    dx:=cast(int) floor(sin(theta)+0.5); dz:=cast(int) floor(cos(theta)+0.5);
    px:=cr[0].player_x+f32(dx)*f32(XC_SQ); pz:=cr[0].player_z+f32(dz)*f32(XC_SQ);
    gx:=XC_MID+dx; gz:=XC_MID+dz;
    if !reform && (xc_blocked(s,px,pz) || !xdungeon.dg_sight(cr[0].player_x,cr[0].player_z,px,pz) || !rs_familiar_destination(b,0,gx,gz,2)) { continue; }
    ok:=ifx recall then rs_familiar_return(b,0,gx,gz) else ifx timed then rs_familiar_finish(b,0,form,spirit,gx,gz) else rs_wild_companion(b,0,a.lvl,form,gx,gz);
    if !ok { return false; }
    if !reform {
      x[0].familiar_x=px; x[0].familiar_z=pz;
      x[0].familiar_seat[0]=FbSeat.{me=rs_familiar_of(b,0)};
    }
    if timed { x[0].familiar_incense=b[0].c[0].materials[0].count; }
    return true;
  }
  return false;
}
// Orders walk a square in the direction the owner faces. Hostile stat-block
// reactions happen before the step, just as for the owner's departure.
xc_familiar_step :: (s:[] EgZone)->bool {
  x:=s[0].xc[..]; b:=x[0].b[..];
  xc_sync_world(s);
  f:=rs_familiar_command_actor(b,0,false);
  if f<0 || b[0].c[f].x==XC_AWAY { return false; }
  cr:=s[0].creator[..];
  dx:=cast(int) floor(sin(cr[0].player_face)+0.5); dz:=cast(int) floor(cos(cr[0].player_face)+0.5);
  px:=x[0].familiar_x+f32(dx)*f32(XC_SQ); pz:=x[0].familiar_z+f32(dz)*f32(XC_SQ);
  gx:=b[0].c[f].x+dx; gz:=b[0].c[f].y+dz;
  if xc_blocked(s,px,pz) || !xdungeon.dg_sight(x[0].familiar_x,x[0].familiar_z,px,pz) || !rs_step_ready(b,f,gx,gz) { return false; }
  for foe:0..<XC_FOES {
    e:=cr[0].hostiles[0].enemies[foe];
    if e.dead || b[0].c[foe+1].x==XC_AWAY { continue; }
    seen:=!rs_has(b[0].c[foe+1],RS_BLINDED) && !rs_has(b[0].c[f],RS_INVISIBLE) && hostile.hostile_sees(e,x[0].familiar_x,x[0].familiar_z);
    q:=RsOpportunityMove.{x=gx,y=gz,seen=seen,movement=true};
    _:=rs_stat_opportunity(b,foe+1,f,xc_hostile_attack(e.kind),q);
    if !rs_step_ready(b,f,gx,gz) { return false; }
  }
  if !rs_step_to(b,f,gx,gz) { return false; }
  x[0].familiar_x=px; x[0].familiar_z=pz;
  return true;
}

xc_familiar_press :: (s:[] EgZone,k:int,a:FbAb)->bool {
  x:=s[0].xc[..]; b:=x[0].b[..];
  order:=x[0].familiar_order;
  seat:=ifx order==XC_FAMILIAR_STEP then x[0].familiar_seat[..] else x[0].seat[..];
  if !seat[0].open { return false; }
  fb_seat_in(b,seat);
  f:=rs_familiar_of(b,0);
  ok:=false;
  if order==XC_FAMILIAR_STEP { ok=xc_familiar_step(s); }
  else if order==XC_FAMILIAR_SENSE { ok=rs_familiar_borrow_senses(b,0); }
  else if order==XC_FAMILIAR_RELEASE { ok=rs_familiar_dismiss(b,0,true); }
  else if order==XC_FAMILIAR_POCKET {
    if f>=0 && b[0].c[f].dead { ok=xc_familiar_arrive(s,a,false,true); }
    else { ok=rs_familiar_dismiss(b,0,false); }
  } else if b[0].c[0].companion { ok=xc_familiar_arrive(s,a,false,false); }
  else if a.lvl==0 { ok=rs_ritual_begin(b,0,SP_FIND_FAMILIAR); }
  else { ok=rs_familiar_begin(b,0,a.lvl); }
  if ok && order==XC_FAMILIAR_RELEASE { x[0].familiar_order=XC_FAMILIAR_CAST; }
  fb_seat_out(b,seat);
  if ok { x[0].used=k; x[0].casts+=1; x[0].cool_at=s[0].creator[0].clock; }
  else { x[0].refused+=1; }
  return ok;
}

// A Ritual under way keeps going: each turn that owes its Magic action takes it (p.104), so the rite
// fails only when you can't act; the turn its ten minutes are up, that action casts the spell.
xc_rite_step :: (s: [] EgZone) {
  x := s[0].xc[..]; b := x[0].b[..];
  if !x[0].started || b[0].c[0].rite < 0 || !b[0].c[0].rite_owed || !x[0].seat[0].open { return; }
  fb_seat_in(b, x[0].seat[..]);
  if b[0].c[0].rite==SP_FIND_FAMILIAR {
    if rs_rite_due_now(b,0,SP_FIND_FAMILIAR) {
      k:=xc_slot_of(x,XC_FAMILIAR);
      if k>=0 { _:=xc_familiar_arrive(s,x[0].bar[k],true,false); }
    } else { _:=rs_ritual_continue(b,0); }
  } else { _:=fb_ritual(b,0,b[0].c[0].rite); }
  fb_seat_out(b, x[0].seat[..]);
}
// A readied move carries you where the engine stepped you, over 0.6 s, stopping at a wall.
xc_glide_step :: (s: [] EgZone) {
  x := s[0].xc[..]; cr := s[0].creator[..];
  if x[0].glide_until < 0 { return; }
  dx := x[0].glide_x - cr[0].player_x; dz := x[0].glide_z - cr[0].player_z; d := sqrt(dx * dx + dz * dz);
  step := 0.25f32;
  if d < step || cr[0].clock > x[0].glide_until { x[0].glide_until = -1; if d >= step { return; } }
  nx := ifx d < step then x[0].glide_x else cr[0].player_x + dx / d * step; nz := ifx d < step then x[0].glide_z else cr[0].player_z + dz / d * step;
  if xc_blocked(s,nx,nz) { x[0].glide_until = -1; return; }
  s[0].put_on = true; s[0].put_x = nx; s[0].put_y = cr[0].player_y; s[0].put_z = nz; s[0].put_face = cr[0].player_face;
  cr[0].player_x = nx; cr[0].player_z = nz;
}
xc_sync_permissions :: (s: [] EgZone) {
  for i:0..<XC_FOES { xc_sync_permission(s,i); }
}
xc_touch_spell :: (a:FbAb)->bool {
  if a.kind!=FB_SPELL { return false; }
  key:=rs_component_key(a.sp);
  return key>=0 && RS_SPELL_KEYS[key].range_kind==SRD_RANGE_TOUCH;
}
// Press slot k: the engine resolves it at what it aims at (xc_aim). True when it was used. Sets what the
// world shows: the look (xc_look), the numbers and the fallen.
// The bow in a zone (xc_has_bow, xc_bow_begin, xc_bow_loose, xc_bow_step, xc_crosshair): everglade/zone-bow.coax.
// ---- Dash as a sprint: the engine's (aethyr/action/sprint.coax) at Everglade's distance
// (everglade/dash.coax), begun when the pipeline accepts an action whose feel moves `dash`
// (class-feel.coax xf_feel, aethyr/action/deed.coax deed_show). Here it is only wired in: a frame
// after your step (fivelab.coax zone_you) hands it your keys or thumb, your stride follows it
// (charactercreator.coax experimental_figure), and its dust is the glade's puff.
xc_sprint_frame :: (s: [] EgZone) {
  x := s[0].xc[..]; cr := s[0].creator[..]; now := cr[0].clock; h := s[0].held;
  puff := eg_dash_frame(x[0].dash[..], now, cr[0].yaw, axis(h, HOLD_D, HOLD_A), axis(h, HOLD_W, HOLD_S), s[0].stick_on, s[0].stick_px, s[0].stick_py, !cr[0].airborne, cr[0].hostiles[0].hp <= 0);
  cr[0].stride = x[0].dash[0].stride;
  if puff {
    p := eg_dash_dust(x[0].dash[0], now, cr[0].player_x, cr[0].player_z); y := meadow_y(p[0], p[1]) + 0.15;
    fx_start_at(s, FXR_DUST, now, fxp_v(p[0], y, p[1]), fxp_v(p[0], y, p[1]), fxp_v(0.62, 0.55, 0.44), 0.6, 0.6);
  }
}
xc_press :: (s: [] EgZone, k: int) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  if !cr[0].experimental || cr[0].walk.on || !x[0].started || k < 0 || k >= x[0].bar_n { return false; }
  xc_sync_vitals(s);
  if x[0].bar[k].kind == XC_BREATH { return zone_breath_key(s); }   // the dragon's own action, on its own Recharge
  now := cr[0].clock;
  if now - x[0].cool_at < f32(XC_COOL) || h[0].hp <= 0 { x[0].refused += 1; return false; }
  xc_strike_due(s);
  a := x[0].bar[k];
  b := x[0].b[..];
  // ask first (#13072): your conditions (rs_bearing) must let you act and the ability declares its
  // feel (class-feel.coax); a no greys the slot, and nothing swings, draws, sounds or shines
  asked := deed_tick(now);
  seq := deed_ask(x[0].deeds[..], k, asked, rs_bearing(b[0].c[0]), xf_feel(x[0].klass, a));
  if seq == 0 { x[0].refused += 1; return false; }
  // a Ranger's Attack is the bow: a press draws and looses itself at full draw (xc_bow_begin)
  if a.kind == FB_ATTACK && xc_kit(x[0].klass) == XC_KIT_BOW { drawn := xc_bow_begin(s, true); _ := deed_answer(x[0].deeds[..], seq, drawn, asked, 0); return drawn; }
  if !x[0].seeded { x[0].seeded = true; b[0].dice[0].state = b[0].dice[0].state ^ (cast(u64) (now * 1000003) * 2654435761); }
  // a blow with a weapon in hand is an action: it swings first and lands where the blade meets a monster
  kit := xc_kit(x[0].klass);
  if kit >= 0 && !(x[0].familiar_touch && xc_touch_spell(a)) && xc_aim_kind(s, a).kind == XC_AIM_MELEE {
    // the rules take the blow (its action is there to spend) before it swings; it lands on contact
    if !fb_ready(b, 0, a) { _ := deed_answer(x[0].deeds[..], seq, false, asked, 0); x[0].refused += 1; return false; }
    _ := deed_answer(x[0].deeds[..], seq, true, asked, 0);
    clip := cp_blow_clip(kit, true);   // a two-hander's owned cleave (cast-pose.coax, shared with Everglade II)
    cr[0].weapon = kit; cr[0].swing_clip = clip; cr[0].swing_at = now;
    tick := xc_tick(now);
    x[0].swing_def = xc_swing_def(s, clip);
    x[0].swing = act.action_begin(x[0].swing_def, clip, x[0].swing_next, 0, 1, tick, 1, 1);
    x[0].swing_next += 1; x[0].swing_tick = tick - 1; x[0].swing_struck = false;
    x[0].pend = k;
    x[0].cool_at = now; x[0].used = k;
    xc_cast_sound(s, a);   // the whoosh as the swing starts; the blow's hit when it lands (xc_use)
    return true;
  }
  ok := xc_use(s, k);   // the local rules resolve it first, then it presents (xc_use_ab)
  _ := deed_answer(x[0].deeds[..], seq, ok, asked, 0);
  return ok;
}
// The fixed tick a creator clock time falls in.
xc_tick :: (t: f32) -> int { return cast(int) floor(f64(t) * f64(XC_TICK)); }
// A swing's action: the clip's length in ticks and its sensor window round the impact (bd_blow), the
// impact itself an event. Its ID is the clip's, version 1.
xc_swing_def :: (s: [] EgZone, clip: int) -> act.ActionDef {
  d: act.ActionDef; d.id = 1000 + clip; d.version = 1; d.clip = clip;
  d.length = act.action_ticks_of_seconds(f64(figs.bd_seconds(clip)));
  if d.length < 1 { d.length = 1; }
  hit := cast(int) floor(f64(figs.bd_blow(s[0].bodies[..], s[0].creator[0].female, clip)) * f64(d.length) + 0.5);
  open := hit - XC_WINDOW; shut := hit + XC_WINDOW;
  if open < 0 { open = 0; } if shut > d.length { shut = d.length; } if hit > shut { hit = shut; }
  d.events[0] = act.ActionEvent.{kind = act.ActionEventKind.window_open, tick = open};
  d.events[1] = act.ActionEvent.{kind = act.ActionEventKind.impact, tick = hit};
  d.events[2] = act.ActionEvent.{kind = act.ActionEventKind.window_close, tick = shut};
  d.event_n = 3;
  return d;
}
// The blow pressed earlier: its action stepped tick by tick to now, each sensing tick sweeping the
// blade (each frame, and before a press). Its slot lands on the first monster the blade meets.
xc_strike_due :: (s: [] EgZone) { xc_swing_step(s, xc_tick(s[0].creator[0].clock)); }
xc_swing_step :: (s: [] EgZone, now: int) {
  x := s[0].xc[..];
  if x[0].pend < 0 { return; }
  d := x[0].swing_def;
  top := ifx now > x[0].swing.start + d.length then x[0].swing.start + d.length else now;
  for t: x[0].swing_tick + 1..<top + 1 {
    st := act.action_advance(d, x[0].swing, t);
    x[0].swing = st.inst; x[0].swing_tick = t;
    if st.sensing && !x[0].swing_struck { xc_sense(s, t); }   // a blow already swung lands though you fell (#13120)
    closed := false;
    for e: 0..<st.n { if st.events[e].kind == act.ActionEventKind.window_close { closed = true; } }
    if (closed || st.finished) && !x[0].swing_struck {
      // the window closed on no one: the blow swings at the air (no roll, no damage)
      x[0].swing_struck = true;
      xc_whiff(s, x[0].pend);
    }
    if st.finished || x[0].swing.phase != act.ActionPhase.running {
      x[0].ledger = sense.sensor_ledger_retire(x[0].ledger, x[0].swing.id);
      x[0].pend = -1; return;
    }
  }
}
// The blade at time t (creator seconds): the swing clip's baked hand pose, between its frames, through
// the weapon matrix that draws it. Not ready (no bake): the fallback arc, flagged.
XcBlade :: struct { pose: sense.SensorPose; fallback: bool; }
xc_blade :: (s: [] EgZone, t: f32) -> XcBlade {
  cr := s[0].creator[..]; b := s[0].bodies[..];
  k := cr[0].weapon; clip := cr[0].swing_clip;
  if k < 0 || k >= cc.CC_KITS { k = 0; }
  y := xmeadow.exp_height(cr[0].player_x, cr[0].player_z) + cr[0].player_y;
  dur := figs.bd_seconds(clip);
  if !b[0].ready || clip < 0 || dur <= 0 {
    // the fallback: a blade from the shoulder sweeping 2 radians right to left ahead of you across the window
    d := s[0].xc[0].swing_def; ft := 0.5f32;
    if d.event_n == 3 && d.events[2].tick > d.events[0].tick {
      ft = (t * f32(XC_TICK) - f32(s[0].xc[0].swing.start) - f32(d.events[0].tick)) / f32(d.events[2].tick - d.events[0].tick);
      ft = ifx ft < 0 then 0 else ifx ft > 1 then 1 else ft;
    }
    ang := cr[0].player_face + 1.0 - 2.0 * ft;
    reach := XC_BLADE_TIP[k] + 0.45;
    base := asp.world_point(cr[0].player_x + sin(ang) * 0.3, y + 1.2, cr[0].player_z + cos(ang) * 0.3);
    tip := asp.world_point(cr[0].player_x + sin(ang) * reach, y + 1.2, cr[0].player_z + cos(ang) * reach);
    return XcBlade.{pose = sense.SensorPose.{a = base, b = tip}, fallback = true};
  }
  n := figs.bd_frames(clip);
  u := (t - cr[0].swing_at) / dur * f32(n) - 0.5;
  if u < 0 { u = 0; } if u > f32(n - 1) { u = f32(n - 1); }
  f0 := cast(int) floor(u); f1 := ifx f0 + 1 < n then f0 + 1 else f0; mix := u - f32(f0);
  r0 := f32(figs.bd_row(cr[0].female, clip, f0)); r1 := f32(figs.bd_row(cr[0].female, clip, f1));
  o := ifx cr[0].female then 3 else 0;
  hr := figs.bd_hand(b, r0, r1, mix, false); hand := [3]f32.[b[0].hand_at[o], b[0].hand_at[o + 1], b[0].hand_at[o + 2]];
  at := [3]f32.[cr[0].player_x, y, cr[0].player_z];
  w := ifx cc.CC_KIT_TWO[k] then cc.two_hand_matrix(hr, figs.bd_hand(b, r0, r1, mix, true), hand, [3]f32.[b[0].hand_at[6 + o], b[0].hand_at[7 + o], b[0].hand_at[8 + o]], k, cr[0].player_face, at)
    else cc.weapon_matrix(hr, hand, k, cr[0].player_face, at);
  l := XC_BLADE_TIP[k] / cc.CC_KIT_SCALE[k];
  base := asp.world_point(w[0], w[1], w[2]);
  tip := asp.world_point(w[0] + w[6] * l, w[1] + w[7] * l, w[2] + w[8] * l);
  return XcBlade.{pose = sense.SensorPose.{a = base, b = tip}};
}
// Sense tick t: sample the blade across the tick finely enough for the sensor's motion profile, sweep
// the living monsters' hurt capsules, and land the slot on the first accepted contact.
xc_sense :: (s: [] EgZone, t: int) {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  t0 := f32(f64(t) / f64(XC_TICK)); t1 := f32(f64(t + 1) / f64(XC_TICK));
  p := xc_blade(s, t0); q := xc_blade(s, t1);
  if p.fallback { x[0].fallbacks += 1; }
  mv := sense.sensor_len(p.pose.b, q.pose.b); if sense.sensor_len(p.pose.a, q.pose.a) > mv { mv = sense.sensor_len(p.pose.a, q.pose.a); }
  if mv > x[0].blade_step { x[0].blade_step = mv; }
  n := sense.sensor_samples_needed(p.pose, q.pose, f32(XC_BLADE_R));
  if n > sense.SENSOR_SAMPLES { x[0].exhausted += 1; return; }
  // the chord understates a turning blade: add samples until no end moves more than the radius between two
  sw: sense.SensorSweep;
  for guard: 0..<sense.SENSOR_SAMPLES {
    sw.n = n; worst := 0.0f32;
    for i: 0..<n { sw.poses[i] = xc_blade(s, t0 + (t1 - t0) * f32(i) / f32(n - 1)).pose; }
    for i: 1..<n { a := sense.sensor_len(sw.poses[i - 1].a, sw.poses[i].a); b := sense.sensor_len(sw.poses[i - 1].b, sw.poses[i].b); if a > worst { worst = a; } if b > worst { worst = b; } }
    if worst <= f32(XC_BLADE_R) { break; }
    if n >= sense.SENSOR_SAMPLES { x[0].exhausted += 1; return; }
    n = n + 1 + cast(int) floor(f32(n - 1) * (worst / f32(XC_BLADE_R) - 1));
    if n > sense.SENSOR_SAMPLES { n = sense.SENSOR_SAMPLES; }
  }
  // the living monsters within a blade's reach, nearest first past the sensor's SENSOR_TARGETS
  hurt: [sense.SENSOR_TARGETS] sense.HurtCapsule; hn := 0;
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    dx := e.x - cr[0].player_x; dz := e.z - cr[0].player_z;
    if e.dead || dx * dx + dz * dz > 8 * 8 || hn >= hurt.count { continue; }
    hurt[hn] = sense.HurtCapsule.{id = 1 + i, gen = 1, team = 2, feet = asp.world_point(e.x, xmeadow.exp_height(e.x, e.z) - 0.1, e.z), height = 1.7 * e.scale, radius = 0.35 * e.scale, alive = true}; hn += 1;
  }
  y := xmeadow.exp_height(cr[0].player_x, cr[0].player_z) + cr[0].player_y;
  origin := asp.world_point(cr[0].player_x, y + 1.2, cr[0].player_z);
  open: aq.Colliders; open.ground_enabled = false;
  r := sense.sensor_resolve(x[0].swing_def, x[0].swing, t, 1, 1, origin, sw, f32(XC_BLADE_R), hurt[0..<hn], open, x[0].ledger);
  if r.status == sense.SensorStatus.exhausted { x[0].exhausted += 1; return; }
  x[0].ledger = r.ledger;
  for c: 0..<r.n {
    if r.contacts[c].status != sense.ContactStatus.hit || x[0].swing_struck { continue; }
    // the SRD Attack is one creature's: the first accepted contact is it
    x[0].swing_struck = true; x[0].contacts += 1;
    x[0].releasing = true; _ := xc_use_on(s, x[0].pend, r.contacts[c].target - 1); x[0].releasing = false;   // swung, it lands though you fell since
  }
}
// A blow that met no one: the turn is spent swinging at the air.
xc_whiff :: (s: [] EgZone, k: int) {
  x := s[0].xc[..]; cr := s[0].creator[..];
  a := x[0].bar[k]; m := xc_aim_kind(s, a);
  fx := sin(cr[0].player_face); fz := cos(cr[0].player_face);
  x[0].casts += 1; x[0].whiffs += 1;
  xc_look(s, a, -1, cr[0].player_x + fx * m.reach, cr[0].player_z + fz * m.reach);
}
// One cue heard where it happens: softer the farther it is, panned the way the camera faces.
xc_cue :: (s: [] EgZone, name: string, gain: f32, x: f32, z: f32, rate: f32) {
  if name.count == 0 { return; }
  cr := s[0].creator[..];
  xc:=s[0].xc[..]; b:=xc[0].b[..];
  f:=rs_familiar_observer(b,0);
  borrowed:=f>0 && !rs_has(b[0].c[f],RS_DEAFENED);
  if !borrowed && b[0].n>0 && rs_has(b[0].c[0],RS_DEAFENED) { return; }
  dx := x - (ifx borrowed then xc[0].familiar_x else cr[0].player_x);
  dz := z - (ifx borrowed then xc[0].familiar_z else cr[0].player_z);
  d := sqrt(dx * dx + dz * dz);
  pan := 0.0f32;
  if d > 0.5 { pan = (dx * cos(cr[0].yaw) - dz * sin(cr[0].yaw)) / d * 0.7; }
  exsound.experimental_sound_play(s[0].experimental_audio[..], name, gain / (1 + d / 10), pan, rate);
}
// A monster's voice when it is hurt or dies: the imp shrieks, the gremlin snarls; the bigger
// they are, the deeper (the Warlord's a growl).
xc_voice :: (s: [] EgZone, i: int, died: bool) {
  e := s[0].creator[0].hostiles[0].enemies[i];
  imp := xdungeon.dg_kind_mesh(e.kind) == 0;
  name := ifx imp then (ifx died then "imp-death" else "imp-hurt") else (ifx died then "gremlin-death" else "gremlin-hurt");
  xc_cue(s, name, (ifx died then 0.6f32 else 0.5f32) * (ifx e.scale > 2 then 1.3f32 else 1.0f32), e.x, e.z, 1 / sqrt(e.scale));
}
xc_cast_sound :: (s: [] EgZone, a: FbAb) {
  cr := s[0].creator[..]; d := xc_sound(a, s[0].xc[0].klass);
  xc_cue(s, d.start, 0.55, cr[0].player_x, cr[0].player_z, d.rate);
  xc_cue(s, d.layer, 0.32, cr[0].player_x, cr[0].player_z, d.rate);
}
// Slot k used now: the engine resolves it at what it aims at (xc_aim). True when it was used.
xc_use :: (s: [] EgZone, k: int) -> bool { return xc_use_on(s, k, -2); }
// Whether the monster you clicked still stands within reach metres and in sight; a fallen one is let go.
xc_pick_live :: (s: [] EgZone, reach: f32) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..]; p := x[0].picked;
  if p < 0 || p >= XC_FOES { return false; }
  e := cr[0].hostiles[0].enemies[p];
  if e.dead { x[0].picked = -1; return false; }
  dx := e.x - cr[0].player_x; dz := e.z - cr[0].player_z;
  return dx * dx + dz * dz <= (reach + 1) * (reach + 1) && hostile.hostile_sees(e, cr[0].player_x, cr[0].player_z);
}
// A spell slot's choices (#13038), in the bar's own style: its slot level in the top right corner and
// its option along the bottom edge. A tap there steps to the next choice instead of casting; the
// engine refuses a choice it can't take, spending nothing.
XC_BADGE :: 18.0;   // CSS px: the corner's tap square, and the bottom strip's height
xc_choose :: (s: [] EgZone, i: int, px: f32, py: f32) -> bool {
  x := s[0].xc[..]; k := x[0].k;
  if i < 0 || i >= x[0].bar_n { return false; }
  r := cc.eg_box4(xc_slot(x, i)); a := x[0].bar[i..<i + 1];
  if a[0].kind==XC_FAMILIAR {
    if px<=r.x0+f32(XC_BADGE)*k && py<=r.y0+f32(XC_BADGE)*k {
      f:=rs_familiar_of(x[0].b[..],0);
      if f>=0 && x[0].b[0].c[f].hp>0 {
        n:=ifx x[0].b[0].c[f].dead then 3 else 5;
        x[0].familiar_order=(x[0].familiar_order+1)%n;
      }
      return true;
    }
    if py>=r.y1-f32(XC_BADGE)*k {
      count:=RS_FAMILIAR_FORMS.count;
      if !x[0].b[0].c[0].companion && px>=r.x1-24*k { a[0].opt=(a[0].opt+count)%(3*count); }
      else { a[0].opt=a[0].opt/count*count+(a[0].opt+1)%count; }
      return true;
    }
    if px>=r.x1-f32(XC_BADGE)*k && py<=r.y0+f32(XC_BADGE)*k {
      a[0].lvl=1-a[0].lvl; return true;
    }
    return false;
  }
  if xc_touch_spell(a[0]) && py>=r.y1-f32(XC_BADGE)*k {
    b:=x[0].b[..]; f:=rs_familiar_of(b,0);
    if x[0].familiar_touch || (f>=0 && rs_up(b[0].c[f])) {
      x[0].familiar_touch=!x[0].familiar_touch;
      return true;
    }
  }
  if a[0].kind==FB_WILD && py>=r.y1-f32(XC_BADGE)*k {
    c:=x[0].b[0].c[0];
    a[0].opt=xc_wild_next(rs_wild_mask(c),fb_wild_form(c,a[0].opt));
    return true;
  }
  if fb_ab_option_n(a[0])==0 && a[0].kind!=FB_SPELL { return false; }
  levels: [9] int; n := ifx a[0].kind == FB_SPELL then fb_cast_levels(x[0].b[0].c[0], a[0], levels[..]) else 0;
  if n > 1 && px >= r.x1 - f32(XC_BADGE) * k && py <= r.y0 + f32(XC_BADGE) * k {
    next := levels[0];
    for q: 0..<n - 1 { if levels[q] == a[0].lvl { next = levels[q + 1]; } }
    a[0].lvl = next; return true;
  }
  m := fb_ab_option_n(a[0]);
  if m > 0 && py >= r.y1 - f32(XC_BADGE) * k { a[0].opt = (rs_max(a[0].opt, 0) + 1) % m; return true; }
  return false;
}
// Click the monster under the pointer to pick it (true); a click on nothing lets the pick go.
xc_pick_at :: (s: [] EgZone, px: f32, py: f32) -> bool {
  x := s[0].xc[..]; hs := s[0].creator[0].hostiles[..]; k := x[0].k;
  best := -1; bd := 30 * k * 30 * k;
  for i: 0..<XC_FOES {
    e := hs[0].enemies[i];
    if e.dead { continue; }
    p := xc_proj(x, e.x, meadow_y(e.x, e.z) + 0.8, e.z);
    d := (p.x - px) * (p.x - px) + (p.y - py) * (p.y - py);
    if p.ok && d < bd { bd = d; best = i; }
  }
  x[0].picked = best;
  if best >= 0 { xc_lock_on(s, best); }
  return best >= 0;
}
// Slot k used now against monster on (a blade's contact), or at what it aims at when on is -2.
xc_use_on :: (s: [] EgZone, k: int, on: int) -> bool { return xc_use_ab(s, k, s[0].xc[0].bar[k], on); }
// Ability a, from slot k, used now (xc_use_on), or an arrow's Attack (FB_SHOOT) on the monster it reached.
xc_use_ab :: (s: [] EgZone, k: int, a0: FbAb, on: int) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  now := cr[0].clock;
  a := a0;
  b := x[0].b[..];
  if a.kind==XC_FAMILIAR { return xc_familiar_press(s,k,a); }
  via:=x[0].familiar_touch && xc_touch_spell(a);
  if via && !x[0].seat[0].open { x[0].refused+=1; return false; }
  b[0].c[0].knockout = x[0].knockout;
  px := cr[0].player_x; pz := cr[0].player_z;
  // what it aims at: ahead of you, by its kind (xc_aim); nothing is picked for you behind or beside you
  aim := xc_aim(s, a);
  if on >= -1 { aim.foe = on; }
  // your choices (#13038): a spell at a creature takes only the one aimed at, with the slot's option;
  // a clicked monster in reach and sight is that creature for a spell with no projectile
  if a.kind == FB_SPELL && a.tg == FB_FOE && rs_spell(a.sp).area == RS_A_NONE && a.opt < 0 { a.opt = 0; }
  if on == -2 && aim.kind == XC_AIM_CONE && xc_pick_live(s, aim.reach) { aim.foe = x[0].picked; }
  if via {
    aim.foe=ifx a.tg==FB_FOE then (ifx on==-2 then x[0].picked else on) else -1;
    if a.tg==FB_FOE && (aim.foe<0 || aim.foe>=XC_FOES || h[0].enemies[aim.foe].dead) {
      x[0].refused+=1; return false;
    }
  }
  foe := aim.foe;
  snd := xc_sound(a, x[0].klass);
  swung := !via && xc_kit(x[0].klass) >= 0 && aim.kind == XC_AIM_MELEE;   // its whoosh played at the press (xc_press)
  if !via && aim.kind == XC_AIM_CONE && foe < 0 { x[0].fizzle = k; x[0].fizzle_at = now; x[0].refused += 1; return false; }   // no one ahead: the icon fizzles, silent (refused plays nothing, #13072)
  if !via && (aim.kind == XC_AIM_BOLT || aim.kind == XC_AIM_MELEE) && foe < 0 {
    if aim.kind==XC_AIM_BOLT && a.kind==FB_SPELL && rs_object_spell(a.sp) {
      object:=xc_object_pick(s,aim.fx,aim.fz,aim.reach);
      if object>=0 {return xc_use_object(s,k,a,object);}
    }
    // the bolt flies on to its range and fizzles; the blow swings at the air. No roll, no damage.
    x[0].cool_at = now; x[0].used = k; x[0].casts += 1; x[0].whiffs += 1;
    xc_look(s, a, -1, px + aim.fx * aim.reach, pz + aim.fz * aim.reach);
    if !swung { xc_cast_sound(s, a); }
    if aim.kind == XC_AIM_BOLT { xc_cue(s, snd.miss, 0.45, px + aim.fx * aim.reach, pz + aim.fz * aim.reach, 1); }
    return true;
  }
  // Self-originating cubes use a grid aligned with your facing, so diagonal
  // casts cover the same width on both sides as casts along a world axis.
  facing_cube := a.kind == FB_SPELL && rs_spell(a.sp).area == RS_A_CUBE_SELF;
  if b[0].truth_zones!=0 { xc_sync_world(s); }
  // Revivify (p. 159) touches the nearest fallen monster; the shared rules judge its death and reach
  corpse:=-1;
  if !via && a.kind==FB_SPELL && a.sp==SP_REVIVIFY {
    best:=0.0f32;
    for i:0..<XC_FOES {
      e:=h[0].enemies[i]; dx:=e.x-px; dz:=e.z-pz; d:=dx*dx+dz*dz;
      if e.dead && (corpse<0 || d<best) { corpse=i; best=d; }
    }
    if corpse<0 { x[0].refused+=1; return false; }
  }
  // the monsters on the engine's squares round you
  rs_place(b, 0, XC_MID, XC_MID);
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    j := 1 + i;
    if e.dead && i!=corpse { rs_place(b, j, XC_AWAY, XC_AWAY); continue; }
    dx := e.x - px; dz := e.z - pz;
    qx := xc_square(ifx facing_cube then dx * aim.fz - dz * aim.fx else dx);
    qz := xc_square(ifx facing_cube then dx * aim.fx + dz * aim.fz else dz);
    if qx == XC_AWAY || qz == XC_AWAY { qx = XC_AWAY; qz = XC_AWAY; }
    rs_place(b, j, qx, qz);
  }
  xc_familiar_project(s,ifx facing_cube then aim.fx else 0,ifx facing_cube then aim.fz else 1);
  // an arrow's monster stands on the engine's line at its true distance, so the Longbow's ranges
  // (150/600 ft, one square 5 feet) are the world's even past the grid round you
  if a.kind == FB_SHOOT && foe >= 0 && foe < XC_FOES { rs_place(b, 1 + foe, XC_MID + xc_bow_squares(s, foe), XC_MID); }
  // Explicit world cost profile, not a new turn or component/access waiver.
  me := b[0].c[0..<1];
  saved_budget:=rs_press_budget(me[0],x[0].seat[0].turn);
  was_open:=x[0].seat[0].open;
  press_turn:[1] RsTurn; press_turn[0]=x[0].seat[0].turn;
  if !via { _:=rs_press_prepare(me,press_turn[..],b[0].press); }
  x[0].seat[0].turn=press_turn[0];
  hp_before := me[0].hp; temp_before := me[0].temp;
  x[0].seat[0].open = true;
  before: [XC_FOES] int; bx: [XC_FOES] int; bz: [XC_FOES] int;
  for i: 0..<XC_FOES { before[i] = b[0].c[1 + i].hp; bx[i] = b[0].c[1+i].x; bz[i] = b[0].c[1+i].y; }
  tx := XC_MID; ty := XC_MID;
  if facing_cube { ty = XC_MID + 3; }
  else if foe >= 0 { tx = b[0].c[1 + foe].x; ty = b[0].c[1 + foe].y; }
  else if aim.kind == XC_AIM_AREA { tx = XC_MID + cast(int) floor(aim.fx * aim.reach / f32(XC_SQ) + 0.5); ty = XC_MID + cast(int) floor(aim.fz * aim.reach / f32(XC_SQ) + 0.5); }
  // the walls as cover facts for this press only (aethyr/rules/srd/cover.coax): a monster on the grid
  // with no line to you is behind Total Cover; with none seeing you, you are behind it from all (Hide)
  rs_cover_clear(b); unseen := true;
  for i: 0..<XC_FOES { if !h[0].enemies[i].dead && b[0].c[1 + i].x != XC_AWAY && hostile.hostile_sees(h[0].enemies[i], px, pz) { unseen = false; } }
  if unseen && !via { _ := rs_cover_put(b, -1, 0, RS_COVER_TOTAL); }
  for i: 0..<XC_FOES { if !h[0].enemies[i].dead && b[0].c[1 + i].x != XC_AWAY && !hostile.hostile_sees(h[0].enemies[i], px, pz) { _ := rs_cover_put(b, 0, 1 + i, RS_COVER_TOTAL); } }
  if corpse>=0 && !xdungeon.dg_sight(px,pz,h[0].enemies[corpse].x,h[0].enemies[corpse].z) { _:=rs_cover_put(b,0,1+corpse,RS_COVER_TOTAL); }
  // an area cast at a point reads its cover from that point (p.15): a wall between it and a monster
  if a.kind == FB_SPELL && rs_area_from_point(rs_spell(a.sp)) {
    ox := px + f32(tx - XC_MID) * f32(XC_SQ); oz := pz + f32(ty - XC_MID) * f32(XC_SQ);
    for i: 0..<XC_FOES { if !h[0].enemies[i].dead && b[0].c[1 + i].x != XC_AWAY && !hostile.hostile_sees(h[0].enemies[i], ox, oz) { _ := rs_cover_put(b, RS_COVER_ORIGIN, 1 + i, RS_COVER_TOTAL); } }
  }
  // The borrowed viewpoint needs its own wall fact for a selected creature.
  if !via && a.kind==FB_SPELL && foe>=0 {
    f:=rs_familiar_observer(b,0);
    if f!=0 && !xdungeon.dg_sight(x[0].familiar_x,x[0].familiar_z,h[0].enemies[foe].x,h[0].enemies[foe].z) {
      _:=rs_cover_put(b,f,1+foe,RS_COVER_TOTAL);
    }
  }
  old_truth:=b[0].truth_zones;
  if facing_cube { b[0].truth_zones=0; }
  ok := false;
  if via {
    f:=rs_familiar_of(b,0);
    target:=foe+1;
    if f>=0 && b[0].c[f].x!=XC_AWAY && b[0].c[target].x!=XC_AWAY {
      dx:=ifx foe>=0 then h[0].enemies[foe].x else px;
      dz:=ifx foe>=0 then h[0].enemies[foe].z else pz;
      if !xdungeon.dg_sight(x[0].familiar_x,x[0].familiar_z,dx,dz) { _:=rs_cover_put(b,f,target,RS_COVER_TOTAL); }
      fb_seat_in(b,x[0].seat[..]);
      ok=rs_familiar_touch(b,0,a.sp,a.lvl,target);
      fb_seat_out(b,x[0].seat[..]);
    }
  } else if a.kind == FB_SKILL {
    lore := ifx foe >= 0 then XC_FOE_LORE[rs_min(hostile.hostile_kind(foe), 4)] else SK_ARCANA;
    r := fb_seat_skill(b, x[0].seat[..], a, ifx foe >= 0 then 1 + foe else -1, lore);
    ok = r.accepted;
    if ok { x[0].told = k; x[0].told_at = now; x[0].told_ok = r.passed; }
    if ok && r.passed && foe >= 0 { if rs_max(a.opt, 0) == 1 { x[0].studied[foe] = true; } else { x[0].calm[foe] = true; } }
  } else if a.kind == FB_BREATH && x[0].dr.on { ok = xd_breathe(s); }
  else {
    up := ifx x[0].releasing then rs_release_stand(b, 0) else RsReleased.{};   // released before you fell, it lands (aethyr/rules/srd/released.coax)
    ok = fb_seat_use(b, x[0].seat[..], a, ifx foe >= 0 then 1 + foe else -1, tx, ty, ifx corpse>=0 then 1+corpse else 0);
    rs_release_fall(b, 0, up);
  }
  if facing_cube { b[0].truth_zones=old_truth; }
  if ok && a.kind==FB_SPELL && a.sp==SP_ZONE_OF_TRUTH { xc_truth_project(s,rs_clear(b[0].truth_zones,old_truth)); }
  if ok && a.kind==FB_SPELL && a.sp==SP_PROTECTION_GOOD_EVIL { x[0].protection_water_used=true; }
  if corpse>=0 {
    e:=h[0].enemies[corpse..<corpse+1];
    if ok { x[0].revivify_diamond_used=true; e[0].dead=false; e[0].moving=false; e[0].swing=-1; }
    else { rs_place(b,1+corpse,XC_AWAY,XC_AWAY); }
  }
  rs_cover_clear(b);
  gain := rs_max(b[0].c[0].hp-hp_before,0);
  temp_gain := rs_max(b[0].c[0].temp-temp_before,0);
  xc_sync_vitals(s);
  if !ok {
    press_turn[0]=x[0].seat[0].turn; rs_press_restore(me,press_turn[..],saved_budget);
    x[0].seat[0].turn=press_turn[0]; x[0].seat[0].open=was_open;
    if facing_cube { xc_sync_world(s); } x[0].refused += 1;
    if a.kind == FB_HIDE { _ := cc.eg_numbers_word(x[0].floats[..], 0, px, meadow_y(px, pz) + cr[0].player_y + 2.1, pz, now, ifx unseen then "ALREADY HIDDEN" else "IN SIGHT", false); }
    return false;
  }
  if a.kind == FB_SPELL && a.sp == SP_THUNDERWAVE {
    x[0].wave = aa.area_face(xk_spell_area(SP_THUNDERWAVE), px, pz, cr[0].player_face); x[0].wave_y = cr[0].player_y; x[0].wave_until = now + 1.4;
  }
  // presented from the yes (aethyr/action/deed.coax deed_show): an action whose feel moves `dash` sprints
  if deed_show(xf_feel(x[0].klass, a), DeedResult.effect).move == DeedMove.dash {
    sprint.sprint_start(x[0].dash[..], now, cr[0].player_face, eg_dash_gain(f32(b[0].c[0].speed)));
  }
  x[0].cool_at = now; x[0].used = k; x[0].casts += 1;
  xd_after(s, a);
  if foe >= 0 { xc_lock_on(s, foe); }   // the one struck at: your target, its Hit Points over the bar
  if gain > 0 {
    _ := cc.eg_numbers_amount(x[0].floats[..], 0, px, meadow_y(px, pz) + cr[0].player_y + 2.1, pz, now, false, true, false, gain);
  }
  if temp_gain>0 { l: [1] RsLine; rs_add_int(l[..],temp_gain); rs_add_text(l[..]," TEMP HP"); _ := cc.eg_numbers_word(x[0].floats[..], 0, px, cr[0].player_y+2.1, pz, now, cast(string)l[0].buf[0..<l[0].n], true); }
  if a.kind != FB_SHOOT { xc_look(s, a, foe, px + aim.fx * aim.reach, pz + aim.fz * aim.reach); }
  if !swung { xc_cast_sound(s, a); }
  if a.kind == FB_HIDE || a.kind == FB_READY {
    _ := cc.eg_numbers_word(x[0].floats[..], 0, px, cr[0].player_y + 2.1, pz, now, ifx a.kind == FB_READY then "READY" else ifx rs_hidden_at(b[0].c[0]) >= 0 then "HIDDEN" else "SPOTTED", true);
  }
  if (a.kind == FB_GRAPPLE || a.kind == FB_SHOVE) && foe >= 0 {
    held := ifx a.kind == FB_GRAPPLE then b[0].c[0].grappling == 1 + foe else rs_has(b[0].c[1 + foe], RS_PRONE);
    _ := cc.eg_numbers_word(x[0].floats[..], 0, h[0].enemies[foe].x, meadow_y(h[0].enemies[foe].x, h[0].enemies[foe].z) + 2.4, h[0].enemies[foe].z, now, ifx !held then "RESISTS" else ifx a.kind == FB_GRAPPLE then "GRAPPLED" else "PRONE", false);
  }
  // what it did to each monster: the numbers, and the fallen
  struck := false;
  for i: 0..<XC_FOES {
    c := b[0].c[1 + i];
    e := h[0].enemies[i..<i + 1];
    // Copy a successful Thunderwave push back out of the battle grid. Sweep
    // small increments against the world's obstacles instead of teleporting.
    if !facing_cube && !c.dead && !e[0].dead && bx[i] != XC_AWAY && (c.x != bx[i] || c.y != bz[i]) {
      // Shove's push (and any grid move a press made): swept square by square, stopping at a wall
      dx := f32(c.x - bx[i]) * f32(XC_SQ) / 10; dz := f32(c.y - bz[i]) * f32(XC_SQ) / 10;
      for step: 0..<10 { nx := e[0].x + dx; nz := e[0].z + dz; if xc_blocked(s,nx,nz) { break; } e[0].x = nx; e[0].z = nz; }
    }
    if facing_cube && !c.dead && !e[0].dead {
      gx := c.x - bx[i]; gz := c.y - bz[i];
      dist := hi(abs(f32(gx)), abs(f32(gz))) * f32(XC_SQ);
      if dist > 0 {
        lx := f32(gx); lz := f32(gz); length := sqrt(lx*lx + lz*lz);
        dx := (lx*aim.fz + lz*aim.fx) / length * dist / 20;
        dz := (-lx*aim.fx + lz*aim.fz) / length * dist / 20;
        for step: 0..<20 {
          nx := e[0].x + dx; nz := e[0].z + dz;
          if xc_blocked(s,nx,nz) { break; }
          e[0].x = nx; e[0].z = nz;
        }
      }
    }
    if xc_harmed(s, i, before[i], ifx swung then react.DMG_SLASH else ifx a.kind == FB_SHOOT then react.DMG_PIERCE else cast(u32) 0, snd.hit, snd.rate, now) { struck = true; }
  }
  xc_sync_permissions(s);
  if facing_cube { xc_sync_world(s); }
  // attacked from wherever you stand, hit or missed, the one aimed at wakes and comes after you
  if foe >= 0 && foe < XC_FOES && aim.kind != XC_AIM_AREA && aim.kind != XC_AIM_SELF { hostile.hostile_provoke(h, foe); }
  if !struck && foe >= 0 && aim.kind != XC_AIM_AREA { xc_cue(s, snd.miss, 0.45, h[0].enemies[foe].x, h[0].enemies[foe].z, 1); _ := cc.eg_numbers_word(x[0].floats[..], 0, h[0].enemies[foe].x, meadow_y(h[0].enemies[foe].x, h[0].enemies[foe].z) + 1.9, h[0].enemies[foe].z, now, "MISS", false); }
  return true;
}
// What a blow, a spell or a dragon's breath did to monster i, which had `before` Hit Points: the
// number rising off it, its flinch (a hit-stop of react's `kinds`), the hit's sound and its voice;
// at 0 Hit Points it falls, cries out and dust puffs up. True when it lost any.
xc_harmed :: (s: [] EgZone, i: int, before: int, kinds: u32, hit: string, rate: f32, now: f32) -> bool {
  x := s[0].xc[..]; h := s[0].creator[0].hostiles[..]; c := x[0].b[0].c[1 + i]; e := h[0].enemies[i..<i + 1];
  lost := before - rs_max(c.hp, 0);
  if lost > 0 { x[0].calm[i] = false; hostile.hostile_provoke(h, i); }   // harmed, it fights again, and comes after you
  if lost > 0 { x[0].landed += 1; x[0].last_dmg = lost; _ := cc.eg_numbers_amount(x[0].floats[..], 0, e[0].x, meadow_y(e[0].x, e[0].z) + 1.9, e[0].z, now, false, false, false, lost);
    if !c.dead && c.hp > 0 { xc_stop_hit(s, i, kinds); }
    xc_cue(s, hit, 0.55, e[0].x, e[0].z, rate);
    if !c.dead && c.hp > 0 { xc_voice(s, i, false); }
    if rs_knocked_out(c) { _ = cc.eg_numbers_word(x[0].floats[..], 0, e[0].x, meadow_y(e[0].x, e[0].z) + 2.4, e[0].z, now, "KNOCKED OUT", false); } }
  if !e[0].dead && (c.dead || c.hp <= 0) {
    e[0].dead = true; e[0].died = now; e[0].moving = false; e[0].swing = -1;
    x[0].kills += 1; xc_voice(s, i, true);
    if x[0].target == i { x[0].target = -1; x[0].lock = attn.AttnState.{}; }
    fx_start_at(s, FXR_DUST, now, fxp_v(e[0].x, 0.2, e[0].z), fxp_v(e[0].x, 0.2, e[0].z), fxp_v(0.6, 0.5, 0.4), 1.2, 1.2);
  }
  return lost > 0;
}
// One of the glade's effects (aethyr/fx/puff.coax), on the creator's clock.
fx_start_at :: (s: [] EgZone, recipe: int, now: f32, from: FxV, to: FxV, col: FxV, big: f32, reach: f32) {
  c := FxCause.{recipe = recipe, seed = now * 13.7 + f32(recipe), t0 = now, from = from, to = to, col = col, big = big, reach = reach};
  _ := fxp_start(s[0].puffs[..], c, now);
}
// A slot's look: Everglade's recipes for its spells and features (everglade-classes.coax cl_look).
xc_look :: (s: [] EgZone, a: FbAb, foe: int, ax: f32, az: f32) {
  cr := s[0].creator[..]; h := cr[0].hostiles[..];
  at := fxp_v(ax, cr[0].player_y + 1.0, az);   // where it is aimed: ahead of you (a bolt's full range when it hits no one)
  if foe >= 0 { at = fxp_v(h[0].enemies[foe].x, 0.8, h[0].enemies[foe].z); }
  l := xc_look_of(a, cr[0].player_x, cr[0].player_y, cr[0].player_z, cr[0].player_face, at);
  fx_start_at(s, l.recipe, cr[0].clock, l.from, l.to, l.col, 1, l.reach);
  if l.glimmer { fx_start_at(s, FXR_GLIMMER, cr[0].clock, l.from, l.to, l.col, 1, 1); }
}

// ---- the screen: where a point in the world falls (charactercreator.coax camera's uniforms)
XcAt :: struct { x: f32; y: f32; ok: bool; }
// Whether a body standing at (bx, foot, bz), tall m, shows from the camera: the engine's visibility
// service (aethyr/visibility.coax, through aethyr/ui/hud-sight.coax) with the meadow's heights under the
// line and the village's, castle's and dungeon's walls near it as boxes.
// The walls near the line from the eye to (bx, bz), lifted to world heights, and the meadow under it.
XcSightIn :: struct { eye: [3] f32; near: [1] xvillage.EvNear; land: [cc.HUD_SIGHT_LAND] f32; nl: int; }
xc_sight_in :: (x: [] XcCombat, bx: f32, foot: f32, bz: f32, tall: f32, o: [] XcSightIn) {
  u := x[0].u[..]; o[0].eye = [3] f32.[u[16], u[17], u[18]];
  dx := bx - u[16]; dz := bz - u[18]; mx := (u[16] + bx) * 0.5; mz := (u[18] + bz) * 0.5;
  xvillage.ev_near_radius(o[0].near[..], mx, mz, 0.5 * sqrt(dx * dx + dz * dz) + 1, true);
  g := xmeadow.exp_height(mx, mz);
  for w: 0..<o[0].near[0].wall_n { q := w * 6; o[0].near[0].walls[q + 1] += g; o[0].near[0].walls[q + 4] += g; }
  o[0].nl = cc.hud_sight_land_n(o[0].eye, bx, foot, bz, tall); if o[0].nl > cc.HUD_SIGHT_LAND { o[0].nl = cc.HUD_SIGHT_LAND; }
  for k: 0..<o[0].nl { p := cc.hud_sight_land_at(o[0].eye, bx, foot, bz, tall, k); o[0].land[k] = meadow_y(p[0], p[1]); }
}
xc_sight_shows :: (x: [] XcCombat, bx: f32, foot: f32, bz: f32, tall: f32) -> bool {
  i: [1] XcSightIn; xc_sight_in(x, bx, foot, bz, tall, i[..]);
  return cc.hud_sight_shows(i[0].eye, bx, foot, bz, tall, i[0].land[..], i[0].nl, i[0].near[0].walls[0..<i[0].near[0].wall_n * 6], i[0].land[0..<0], i[0].land[0..<0]);
}
xc_sight_step :: (x: [] XcCombat, h: cc.HudSight, bx: f32, foot: f32, bz: f32, tall: f32, dt: f32) -> cc.HudSight {
  i: [1] XcSightIn; xc_sight_in(x, bx, foot, bz, tall, i[..]);
  return cc.hud_sight_after(h, i[0].eye, bx, foot, bz, tall, i[0].land[..], i[0].nl, i[0].near[0].walls[0..<i[0].near[0].wall_n * 6], i[0].land[0..<0], i[0].land[0..<0], dt);
}
#test "experimental: a foe behind a village wall has no plate's sight; one in the open has" #steps 400000000 {
  x: [1] XcCombat;
  // in the open at the spawn: shows
  x[0].u[16] = 0; x[0].u[17] = meadow_y(0, 0) + 1.8; x[0].u[18] = 0;
  #assert xc_sight_shows(x[..], 0, meadow_y(0, 10), 10, 1.7);
  // the first wall near the village's houses: the eye 8 m before its thin side, the foe 2 m past it
  near: [1] xvillage.EvNear; xvillage.ev_near_radius(near[..], -18, -23, 4, true); #assert near[0].wall_n > 0;
  w := near[0].walls; g := xmeadow.exp_height(-18, -23);
  found := false;
  for i: 0..<near[0].wall_n {
    o := i * 6; if w[o + 4] - w[o + 1] < 2.5 { continue; }
    cx := (w[o] + w[o + 3]) * 0.5; cz := (w[o + 2] + w[o + 5]) * 0.5; thin_x := w[o + 3] - w[o] < w[o + 5] - w[o + 2];
    if thin_x && w[o + 5] - w[o + 2] < 3 { continue; } if !thin_x && w[o + 3] - w[o] < 3 { continue; }
    ex := ifx thin_x then w[o] - 8 else cx; ez := ifx thin_x then cz else w[o + 2] - 8;
    bx := ifx thin_x then w[o + 3] + 2 else cx; bz := ifx thin_x then cz else w[o + 5] + 2;
    x[0].u[16] = ex; x[0].u[17] = g + w[o + 1] + 1.2; x[0].u[18] = ez;
    #assert !xc_sight_shows(x[..], bx, g + w[o + 1], bz, 1.7);
    found = true; break;
  }
  #assert found;
}
xc_proj :: (x: [] XcCombat, wx: f32, wy: f32, wz: f32) -> XcAt {
  u := x[0].u[..];
  dx := wx - u[16]; dy := wy - u[17]; dz := wz - u[18];
  z := dx * u[20] + dy * u[21] + dz * u[22];
  if z < 0.2 { return XcAt.{}; }
  r := dx * u[24] + dy * u[25] + dz * u[26];
  up := dx * u[28] + dy * u[29] + dz * u[30];
  return XcAt.{x = u[23] + u[19] * r / z, y = u[27] - u[19] * up / z, ok = true};
}
// The camera xc_proj projects through, as the shared plates take it (aethyr/ui/hud-plates.coax).
xc_plate_view :: (x: [] XcCombat, w: f32, h: f32) -> cc.HudPlateView {
  u := x[0].u[..];
  return cc.HudPlateView.{eye = [3] f32.[u[16], u[17], u[18]], fwd = [3] f32.[u[20], u[21], u[22]], right = [3] f32.[u[24], u[25], u[26]],
                          up = [3] f32.[u[28], u[29], u[30]], focal = u[19], cx = u[23], cy = u[27], w = w, h = h};
}
// The column's height, CSS px: its header, and when open its twelve rows.
xc_wild_next :: (mask:int,after:int)->int {
  for k:1..<MON_N { form:=(after+k)%MON_N; if (mask&(1<<form))!=0 { return form; } }
  return after;
}
xc_wild_choice :: (mask:int,choice:int)->int {
  if (mask&(1<<choice))!=0 { return choice; }
  return xc_wild_next(mask,0);
}
xc_wild_options :: (x:[]XcCombat)->[2]int {
  c:=x[0].b[0].c[0]; known:=rs_wild_mask(c);
  eligible:=rs_wild_default(c)|RS_WILD_CAT;
  return [2]int.[xc_wild_choice(known,x[0].wild_old),xc_wild_choice(eligible-known,x[0].wild_new)];
}
// The wild-shape row's button i (class-menu.coax CM_WILD): 0 the next known form, 1 the next new one, 2 REPLACE.
xc_wild_pick :: (x:[]XcCombat,i:int)->bool {
  c:=x[0].b[0].c[0..<1];
  if !c[0].wild_swap { return false; }
  choice:=xc_wild_options(x);
  known:=rs_wild_mask(c[0]); eligible:=rs_wild_default(c[0])|RS_WILD_CAT;
  if i==0 { x[0].wild_old=xc_wild_next(known,choice[0]); return true; }
  if i==1 { x[0].wild_new=xc_wild_next(eligible-known,choice[1]); return true; }
  if i!=2 { return false; }
  if rs_wild_swap(c,choice[0],choice[1]) {
    slot:=xc_slot_of(x,FB_WILD);
    if slot>=0 { x[0].bar[slot].opt=choice[1]; }
    x[0].wild_old=0; x[0].wild_new=0;
  }
  return true;
}

xc_rest_request :: (s:[] EgZone,request:int)->bool {
  x:=s[0].xc[..]; cr:=s[0].creator[..];
  if !cr[0].experimental || !x[0].started { return false; }
  settled:=x[0].rest_seen && x[0].rest_settled && !cr[0].airborne && !cr[0].moving && !cr[0].walk.on &&
    x[0].pend<0 && !sprint.sprint_on(x[0].dash[0],cr[0].clock) && (s[0].held & (HOLD_W|HOLD_A|HOLD_S|HOLD_D|HOLD_JUMP))==0 && !s[0].stick_on;
  ok:=rs_rest_control(x[0].b[..],0,request,settled);
  x[0].rest_refused=!ok; xc_sync_permissions(s); xc_sync_vitals(s); return ok;
}
xc_rest_label :: (c:RsCreature)->string {
  if c.long_rest.phase==2 { return "REST INTERRUPTED"; }
  if c.long_rest.phase==1 {
    if c.long_rest.mode==1 { return "REST: SLEEPING"; }
    if c.long_rest.mode==3 { return "REST: EXERTION"; }
    return "REST: WATCHING";
  }
  if c.rest.phase==1 { return "SHORT REST"; }
  if c.rest.phase==2 { return "SHORT REST: CHOOSE HIT DICE"; }
  return "REST";
}
XC_REST_REQUESTS :: [5]int.[RS_REST_SHORT,RS_REST_SLEEP,RS_REST_WATCH,RS_REST_DIE,RS_REST_END];
// ---- Experimental on Everglade's class menus (everglade/hud/class-bar.coax, #13092, #13147): REST's
// choices in the menu your portrait opens, as every Everglade zone has them; nothing of it is a button
// over the bar. The picker (class-menu.coax cm_pick) keeps CLASSES and LEVEL. The rest choices follow
// how your rest stands, as Everglade II's room offers them. K turns knocking out on and off (xc_key).
xc_rest_choices :: (c:RsCreature,out:[]int)->int {
  if c.long_rest.phase==2 { out[0]=RS_REST_SLEEP; out[1]=RS_REST_WATCH; out[2]=RS_REST_END; return 3; }
  if c.long_rest.phase==1 { out[0]=ifx c.long_rest.mode==1 then RS_REST_WATCH else RS_REST_SLEEP; out[1]=RS_REST_END; return 2; }
  if c.rest.phase==2 { out[0]=RS_REST_DIE; out[1]=RS_REST_END; return 2; }
  if c.rest.phase==1 { out[0]=RS_REST_END; return 1; }
  out[0]=RS_REST_SHORT; out[1]=RS_REST_SLEEP; return 2;
}
xc_facts :: (s:[] EgZone)->EgBarFacts {
  x:=s[0].xc[..]; cr:=s[0].creator[..]; f:EgBarFacts;
  if !cr[0].experimental || !x[0].started { return f; }
  c:=x[0].b[0].c[0];
  if c.hp>0 { f.rest_n=xc_rest_choices(c,f.rest[..]); }
  f.resting=c.long_rest.phase==1 || c.long_rest.phase==2 || c.rest.phase>0;
  f.rest_say=ifx x[0].rest_refused then "REST UNAVAILABLE" else ifx f.resting then xc_rest_label(c) else "";
  return f;
}
// ---- the bar on an upright phone (everglade/zone-touch.coax zone_compact, #13189): one row. The slots
// that fit it, less one, stand in it, and the last place is MORE, which opens the rest in rows over it
// and shuts them again. Everywhere else the bar is as it was (class-look.coax xc_slot_at).
// The slots in the row before MORE; all of them when they fit (no MORE).
xc_more_n :: (x: [] XcCombat) -> int {
  if !x[0].compact { return x[0].bar_n; }
  per := xc_slot_row(x[0].w, x[0].k); return ifx x[0].bar_n <= per then x[0].bar_n else per - 1;
}
xc_has_more :: (x: [] XcCombat) -> bool { return xc_more_n(x) < x[0].bar_n; }
// A slot behind MORE while it is shut: under the screen, never drawn or pressed.
xc_slot_hidden :: (x: [] XcCombat, i: int) -> bool { return xc_has_more(x) && i >= xc_more_n(x) && !x[0].more; }
// MORE's place: the row's last.
xc_more_box :: (x: [] XcCombat) -> [4] f32 { m := xc_more_n(x); return xc_slot_at(m + 1, m, x[0].w, x[0].h, x[0].k); }
// Slot i, device px: x0, y0, x1, y1.
xc_slot :: (x: [] XcCombat, i: int) -> [4] f32 {
  w := x[0].w; h := x[0].h; k := x[0].k; m := xc_more_n(x);
  if m >= x[0].bar_n { return xc_slot_at(x[0].bar_n, i, w, h, k); }
  per := m + 1;
  if i < m { return xc_slot_at(per, i, w, h, k); }
  if !x[0].more { r := xc_slot_at(per, m, w, h, k); return [4] f32.[r[0], h + 1000 * k, r[2], h + 1000 * k + r[3] - r[1]]; }
  j := i - m; row := j / per; count := rs_min(per, x[0].bar_n - m - row * per);
  return xc_slot_at(count, j % per, w, h - f32(row + 1) * f32(XC_STEP) * k, k);
}
#test "an upright phone's bar is one row: the slots that fit less one, then MORE, which opens the rest over it" #steps 400000000 {
  x: [1] XcCombat; x[0].bar_n = 9; x[0].w = 390 * 3; x[0].h = 844 * 3; x[0].k = 3;
  #assert !xc_has_more(x[..]) && xc_slot(x[..], 8)[1] > xc_slot(x[..], 0)[1];   // not compact: two rows, the first over, as before
  x[0].compact = true;
  #assert xc_more_n(x[..]) == 5 && xc_has_more(x[..]);
  for i: 0..<5 { #assert xc_slot(x[..], i)[1] == xc_slot(x[..], 0)[1] && !xc_slot_hidden(x[..], i) && xc_slot(x[..], i)[2] <= xc_more_box(x[..])[0]; }
  for i: 5..<9 { #assert xc_slot_hidden(x[..], i) && xc_slot(x[..], i)[1] > x[0].h; }
  #assert xc_bar_top(x[..]) == xc_slot(x[..], 0)[1] && xc_more_box(x[..])[1] == xc_slot(x[..], 0)[1] && xc_more_box(x[..])[2] <= x[0].w;
  x[0].more = true;
  for i: 5..<9 { r := xc_slot(x[..], i); #assert !xc_slot_hidden(x[..], i) && r[3] <= xc_slot(x[..], 0)[1] && r[0] >= 0 && r[2] <= x[0].w; }
  // a bar that fits has no MORE
  x[0].bar_n = 6; #assert !xc_has_more(x[..]) && xc_slot(x[..], 5)[1] == xc_slot(x[..], 0)[1];
}
// The bar's top (its highest slot's), device px.
xc_bar_top ::(x:[]XcCombat)->f32 { top:=x[0].h; for i:0..<x[0].bar_n { r:=cc.eg_box4(xc_slot(x, i)); if r.y0<top { top=r.y0; } } return top; }
xc_side_geo :: (s:[] EgZone)->EgSideGeo { return xc_layout(s).side; }
// What a menu row asks: a rest choice goes to the rules (xc_rest_request).
xc_side_act :: (s:[] EgZone,f:EgBarFacts,act:int) {
  j:=act-EG_DO_REST; if j>=0 && j<f.rest_n { _:=xc_rest_request(s,f.rest[j]); }
}
// Your portrait plate's box, top right (xc_portrait): a press on it opens the class menus.
xc_portrait_box :: (x:[]XcCombat)->cc.HudPrim { wide:=f32(cc.EG_PORTRAIT_W); return cc.eg_portrait_box(x[0].w-(wide+16)*x[0].k,14*x[0].k,wide,x[0].k); }
XC_PORTRAIT_FOOT :: 124.0;   // CSS px: the portrait plate's foot, its slot gems and conditions under it (xc_portrait)
// Where the picker and the class menus sit. The picker: top left beside your portrait where the page
// is wide enough, under it on a phone held upright; it keeps over the bar. The menus hang under your
// portrait, down to the bar at most; where one would cover the picker, the picker steps aside while it
// is up (xc_pick_hidden).
// cover: what the open class menu and its tip take (empty when shut)
XcLayout :: struct { pick: CmPick; side: EgSideGeo; cover: cc.HudPrim; }
xc_layout :: (s:[] EgZone)->XcLayout {
  x:=s[0].xc[..]; cr:=s[0].creator[..]; w:=x[0].w; h:=x[0].h; k:=x[0].k;
  lay:XcLayout; bar:=xc_bar_top(x);
  if !x[0].dr.on { sf:=xc_facts(s); lay.side=eg_side_geo(sf,w,h,k,xc_portrait_box(x),bar-8*k); lay.cover=eg_menu_cover(sf,lay.side,x[0].side); }   // the druid's own bar has no class menus
  beside:=w-(f32(cc.EG_PORTRAIT_W)+16)*k-24*k; room:=beside>=320*k;
  wide:=ifx room then beside else w-24*k; if wide>460*k { wide=460*k; }
  y0:=ifx room then 20*k else (XC_PORTRAIT_FOOT+8)*k;
  wild:=x[0].b[0].c[0].wild_swap; open:=x[0].open;
  if cr[0].dev_animations && !cr[0].preview_collapsed {
    // the developer's ANIMATIONS list has the top: the picker at the foot of the page
    p:=cm_pick(12*k,0,wide,h-20*k,open,wild,w,h,k); lay.pick=cm_pick(12*k,h-20*k-cm_pick_height(p),wide,h-20*k,open,wild,w,h,k);
    return lay;
  }
  if cr[0].dev_animations && y0<(52+f32(XC_GAP))*k { y0=(52+f32(XC_GAP))*k; }   // under its header
  // over the bar: clear of its emblem and class line where the picker reaches the bar's middle
  lx:=w; rx:=0.0f32; for i:0..<x[0].bar_n { sb:=cc.eg_box4(xc_slot(x, i)); if sb.x0<lx { lx=sb.x0; } if sb.x1>rx { rx=sb.x1; } }
  bfoot:=ifx 12*k+wide>(lx+rx)*0.5-40*k then bar-38*k else bar-14*k;
  lay.pick=cm_pick(12*k,y0,wide,bfoot,open,wild,w,h,k);
  return lay;
}
// A slot's card, device px (empty with none): over the slot under the pointer, clear of the bar's
// emblem.
xc_card_box :: (x:[]XcCombat,lay:XcLayout)->cc.Box {
  if x[0].arranging || x[0].hover<0 || x[0].hover>=x[0].bar_n || x[0].bar[x[0].hover].kind==XC_BREATH { return cc.Box.{}; }
  k:=x[0].k; w:=x[0].w; r:=cc.eg_box4(xc_slot(x, x[0].hover));
  cw:=358*k; ch:=171*k; cx:=(r.x0+r.x1)/2;
  if cx-cw/2<12*k { cx=12*k+cw/2; }
  if cx+cw/2>w-12*k { cx=w-12*k-cw/2; }
  y1:=r.y0-30*k; et:=xc_bar_top(x)-38*k; if et<y1 { y1=et; }
  return cc.Box.{x0=cx-cw/2,y0=y1-ch,x1=cx+cw/2,y1=y1};
}
// The picker steps aside while a slot's card covers it, or a class menu or its tip does.
// A page with one class of its own shows no CLASSES picker: the druid's grove, the Archery Range.
xc_own_kit :: (x:[]XcCombat)->bool { return x[0].dr.on || x[0].own_kit; }
xc_pick_hidden :: (x:[]XcCombat,lay:XcLayout)->bool {
  c:=xc_card_box(x,lay); pb:=cm_pick_panel(lay.pick);
  if c.x1>c.x0 && c.x0<pb.x1 && c.x1>pb.x0 && c.y0<pb.y1 && c.y1>pb.y0 { return true; }
  return cc.eg_meets(lay.cover,cc.hud_box(pb.x0,pb.y0,pb.x1,pb.y1));
}
xc_pick :: (s:[] EgZone)->CmPick { return xc_layout(s).pick; }
// The coordinates and the FPS plaque (charactercreator.coax coord_draw, everglade/hud/parts.coax eg_fps),
// bottom right: over the bar's tray, its emblem and class line where a narrow page brings them under
// it, and left out while a class menu or its tip is up over that corner.
xc_corner :: (s:[] EgZone,lay:XcLayout,out:[]f32,at:int)->int {
  x:=s[0].xc[..]; cr:=s[0].creator[..]; k:=x[0].k; w:=x[0].w; h:=x[0].h;
  if x[0].compact && !s[0].lines { cr[0].gfx_box=cc.Box.{}; return at; }   // an upright phone: the world, unless ?net asks for them (#13189)
  top:=h+1000; cx0:=w-240*k;
  lx:=w; rx:=0.0f32;
  for i:0..<x[0].bar_n { sr:=cc.eg_box4(xc_slot(x, i)); if sr.x0<lx { lx=sr.x0; } if sr.x1>rx { rx=sr.x1; } if sr.x1+19*k>cx0 && sr.y0-14*k<top { top=sr.y0-14*k; } }
  // the emblem over the bar's middle and the class and target line beside it
  if top<h+1000 && cx0<(lx+rx)*0.5+200*k { et:=xc_bar_top(x)-42*k; if et<top { top=et; } }
  if cc.eg_meets(lay.cover,cc.hud_box(cx0,top-40*k,w,h)) { return at; }
  fh:=ifx top+7*k<h then top+7*k else h;
  c:=xc_card_box(x,lay); if c.x1>c.x0 && c.x1>cx0 && c.y1>fh-52*k && c.y0<fh { return at; }   // a slot's card is up over the corner
  n:=cc.coord_draw(cr[0],out,at,w,fh,k);
  gb:[1]cc.Box;n=cc.eg_fps_gfx(cr[0].ui,cr[0].fps[0],cast(string)cr[0].gfx[0..<cr[0].gfx_n],out,n,w,fh,k,gb[..]);cr[0].gfx_box=gb[0];   // the graphics tier beside it (everglade/zone.coax zone_quality_frame)
  return n;
}
xc_in :: (r: cc.Box, px: f32, py: f32) -> bool { return px >= r.x0 && px <= r.x1 && py >= r.y0 && py <= r.y1; }
xc_text_w :: (t: string, cap: f32) -> f32 {
  em := cc.sans_em(cap); w := 0.0f32;
  for i: 0..<t.count { c := cast(int) t[i]; if c >= 32 && c <= 126 { w += f32(cc.EG_BODY_WIDTH[c - 32]) / f32(cc.EG_FONT_UPM) * em; } }
  return w;
}
// A slot's words along its top or its bottom edge, centred, made smaller until they fit inside it.
xc_fit_cap :: (t: string, cap: f32, room: f32) -> f32 { w := cc.face_width(t, cap, cc.HUD_FACE_BODY); return ifx w > room && w > 0 then cap * room / w else cap; }
// ui and parent: the layout trace and the slot's place in it (#13076), or empty and cc.UIT_NONE.
xc_caption :: (ui: [] cc.UitTrace, parent: int, out: [] f32, at: int, t: string, r: cc.Box, top: bool, cap: f32, ink: Ink, k: f32) -> int {
  room := r.x1 - r.x0 - 6 * k; c := xc_fit_cap(t, cap, room); w := cc.face_width(t, c, cc.HUD_FACE_BODY);
  return cc.ttext(ui, parent, out, at, t, (r.x0 + r.x1 - w) * 0.5, ifx top then r.y0 + 4 * k + c else r.y1 - 4 * k, c, ink, "");
}

// An area's outline and guides on the meadow (aethyr/action/area-aim.coax area_aim_point), lifted by
// y, each piece drawn while both its ends are before the camera.
xc_area_draw :: (x: [] XcCombat, a: aa.AreaAim, y: f32, out: [] f32, at: int, k: f32, glow: f32) -> int {
  n := at; last: XcAt;
  for p: 0..<aa.area_aim_points(a) {
    w := aa.area_aim_point(a, p);
    q := xc_proj(x, w[0], meadow_y(w[0], w[1]) + y + 0.08, w[1]);
    g := ifx aa.area_aim_guide(p) then 0.55f32 else 1.0f32;
    if aa.area_aim_joined(a, p) && q.ok && last.ok { n = xc_line(out, n, last.x, last.y, q.x, q.y, (ifx aa.area_aim_guide(p) then 1.1f32 else 3.0f32) * k, 0.35 * glow * g, 0.80 * glow * g, glow * g); }
    last = q;
  }
  return n;
}
// The same look angles apply at the familiar's eye. Only view and lighting
// uniforms change; the player and familiar keep their own world positions.
xc_familiar_view :: (s:[] EgZone,u:[]f32)->bool {
  x:=s[0].xc[..]; b:=x[0].b[..]; f:=rs_familiar_observer(b,0);
  if u.count>65 { u[65]=0; }
  if f==0 || rs_has(b[0].c[f],RS_BLINDED) { return false; }
  px:=x[0].familiar_x; pz:=x[0].familiar_z;
  u[16]=px; u[17]=meadow_y(px,pz)+0.28; u[18]=pz;
  if u.count>65 { u[65]=f32(rs_familiar_darkvision(b[0].c[f]))*f32(XC_SQ)/5; }
  if u.count>=104 {
    for i:68..<104 { u[i]=0; }
    cc.dungeon_light(s[0].creator[..],u,px,pz);
  }
  return true;
}
// ---- the frame: after Character Create's (cc.frame), in Experimental
// The health bars' trails, a frame (aethyr/ui/hud-style.coax hud_trail_step): yours, and each
// monster's (its plate's and, when it is your target, its frame's). Your bar is set anew, not eased,
// when your maximum changes (another class, another level).
xc_trails_step :: (s: [] EgZone, dt: f32) {
  x := s[0].xc[..]; hs := s[0].creator[0].hostiles[0];
  mine := ifx hs.max_hp > 0 then f32(ifx hs.hp < 0 then 0 else hs.hp) / f32(hs.max_hp) else 0.0f32;
  if x[0].me_max != hs.max_hp { x[0].me_max = hs.max_hp; cc.hud_trail_snap(x[0].me_trail[..], mine); x[0].vig[0].on = false; }   // a new maximum is no blow
  cc.hud_trail_step(x[0].me_trail[..], mine, dt);
  cc.hud_vignette_step(x[0].vig[..], mine, dt);
  for i: 0..<XC_FOES { c := x[0].b[0].c[1 + i]; cc.hud_trail_step(x[0].foe_trail[i..<i + 1], f32(rs_max(c.hp, 0)) / f32(rs_max(c.hp_max, 1)), dt); }
}
// Whether you are in a fight: a monster is awake and after you.
xc_fighting :: (s: [] EgZone) -> bool {
  hs := s[0].creator[0].hostiles[0];
  for i: 0..<XC_FOES { e := hs.enemies[i]; if e.awake && !e.dead && !e.returning { return true; } }
  return false;
}
// Your portrait plate, top right (the CLASSES column has the left): your class, its level, your
// Hit Points with their damage trail, your AC and spell slots, as the rules hold them for you. Its
// ring glows while you fight and brightens under the pointer (a press opens the class menus).
xc_portrait :: (s: [] EgZone, out: [] f32, at: int, w: f32, k: f32) -> int {
  x := s[0].xc[..]; hs := s[0].creator[0].hostiles[0]; me := x[0].b[0].c[0];
  p: cc.EgPortrait; nb: [32] u8; p.klass = cc.eg_title(nb[..], XC_CL_UP[x[0].klass]); p.name = p.klass; p.level = x[0].level;
  p.max = hs.max_hp; p.hp = ifx hs.hp < 0 then 0 else hs.hp; p.temp = hs.temp; p.ac = me.ac;
  for lv: 0..<10 { p.slot_max[lv] = me.slots_max[lv]; p.slot_left[lv] = me.slots[lv]; }
  if x[0].me_trail[0].on { p.fill = x[0].me_trail[0].fill; p.trail = x[0].me_trail[0].trail; }
  if xc_fighting(s) { p.combat = 0.5 + 0.5 * sin(s[0].creator[0].clock * 3.93); }   // a pulse every 1.6 s
  p.lit = x[0].side.side_hover >= 0 || x[0].side.menu >= 0;
  p.conds = xc_facts(s).rest_say;   // how your rest stands ("SHORT REST", "REST: SLEEPING"), under the plate
  wide := f32(cc.EG_PORTRAIT_W);
  return cc.eg_portrait(s[0].creator[0].ui, out, at, w - (wide + 16) * k, 14 * k, wide, k, p, 1);
}
XC_TARGET_W :: 300.0;   // CSS px: your target's frame
// Where your target's frame stands (empty: no room, and the line beside the bar's emblem names it
// instead): left of your portrait, facing it, where the picker leaves room; else under your portrait.
// Never over the picker, an open class menu, or the bar.
xc_target_box :: (s: [] EgZone, lay: XcLayout) -> cc.HudPrim {
  x := s[0].xc[..]; k := x[0].k; w := x[0].w; wide := f32(XC_TARGET_W) * k; me := xc_portrait_box(x);
  pb := cm_pick_panel(lay.pick); pick := cc.hud_box(pb.x0, pb.y0, pb.x1, pb.y1);
  if xc_own_kit(x) || xc_pick_hidden(x, lay) { pick = cc.HudPrim.{}; }
  beside := cc.hud_box(me.x0 - 12 * k - wide, me.y0, me.x0 - 12 * k, me.y1);
  under := cc.hud_box(me.x1 - wide, (XC_PORTRAIT_FOOT + 6) * k, me.x1, (XC_PORTRAIT_FOOT + 6 + 76) * k);
  for b: [2] cc.HudPrim.[beside, under] {
    grown := cc.hud_box(b.x0 - 8 * k, b.y0, b.x1, b.y1 + 34 * k);   // its conditions' line under it
    if b.x0 < 12 * k || b.y1 + 34 * k > xc_bar_top(x) - 60 * k || cc.eg_meets(grown, pick) || cc.eg_meets(grown, lay.cover) { continue; }
    return b;
  }
  return cc.HudPrim.{};
}
// Your target's frame (everglade/hud/parts.coax eg_portrait, mirrored and red): its name, its Hit
// Points with their damage trail, its AC once you have studied it, and what holds it. It fades in
// over a fifth of a second and is gone with the target.
xc_target_frame :: (s: [] EgZone, lay: XcLayout, out: [] f32, at: int, dt: f32) -> int {
  x := s[0].xc[..]; hs := s[0].creator[0].hostiles[0]; t := x[0].target; k := x[0].k;
  b := xc_target_box(s, lay);
  if t < 0 || t >= XC_FOES || hs.enemies[t].dead || !(b.x1 > b.x0) { x[0].target_shown = 0; return at; }
  x[0].target_shown += (ifx dt > 0 then dt else 0.0f32) / 0.18; if x[0].target_shown > 1 { x[0].target_shown = 1; }
  c := x[0].b[0].c[1 + t]; p: cc.EgPortrait; nb: [32] u8;
  p.name = cc.eg_title(nb[..], XC_FOE_NAMES[hs.enemies[t].kind]); p.foe = true; p.mirror = true;
  p.hp = rs_max(c.hp, 0); p.max = c.hp_max; if x[0].studied[t] { p.ac = c.ac; }
  for lv: 0..<10 { p.slot_left[lv] = -1; }
  if rs_has(c, RS_UNCONSCIOUS) { p.conds = "UNCONSCIOUS"; }
  tr := x[0].foe_trail[t]; if tr.on { p.fill = tr.fill; p.trail = tr.trail; }
  return cc.eg_portrait(s[0].creator[0].ui, out, at, b.x0, b.y0, f32(XC_TARGET_W), k, p, x[0].target_shown);
}
xc_frame :: (s: [] EgZone, out: [] f32, at: int, u: [] f32, w: f32, h: f32, k: f32, dt: f32) -> int {
  x := s[0].xc[..]; cr := s[0].creator[..]; hs := cr[0].hostiles[..];
  n := at;
  xc_start(x, x[0].klass);
  x[0].w = w; x[0].h = h; x[0].k = k; x[0].seen = true;
  x[0].compact = zone_compact(s); if !xc_has_more(x) { x[0].more = false; }
  now := cr[0].clock;
  cr[0].weapon = ifx x[0].started then xc_kit(x[0].klass) else -1;
  cc.eg_numbers_frame(x[0].floats[..]); cc.eg_numbers_frame(hs[0].taken[..]);   // the frame's numbers handed on: yours and those over you
  if dt > 0 && dt < 1 { rs_tick(x[0].b[..], ifx dt > 0.25 then 0.25 else dt); fb_seat_step(x[0].b[..], x[0].seat[..]); }
  xd_frame(s, dt);
  xc_objects_tick(s);
  xc_rite_step(s); xc_glide_step(s);
  xc_hostile_contacts(s);
  xc_shots_step(s);
  observing:=xc_familiar_view(s,u);
  for i: 0..<36 { x[0].u[i] = ifx i < u.count then u[i] else 0; }
  xc_bow_step(s, dt);
  xc_trails_step(s,dt);
  n = cc.eg_vignette(out, n, x[0].vig[0], w, h);   // the red edges first, under the rest of the HUD
  n = xc_crosshair(s, out, n, w, h, k);
  n = xd_hud(s, out, n, k);
  if observing { n=cc.ttext(cr[0].ui,cc.UIT_NONE,out,n,"FAMILIAR SIGHT",w/2-60*k,24*k,10*k,ink_col(k,0.55,0.9,1),""); }
  n=xc_portrait(s,out,n,w,k);
  n=xc_target_frame(s,xc_layout(s),out,n,dt);
  n=cc.combat_overlay(cr[0],out,u,n,w,k);
  // a blow that struck you from off screen points toward its striker (everglade/hud/numbers.coax)
  hp:=xc_proj(x,x[0].hit_x,meadow_y(x[0].hit_x,x[0].hit_z)+1.0,x[0].hit_z);
  if x[0].seen && !(hp.ok && hp.x>0 && hp.x<w && hp.y>0 && hp.y<h) {
    hdx:=x[0].hit_x-cr[0].player_x; hdz:=x[0].hit_z-cr[0].player_z;
    n=cc.eg_struck_from(out,n,hdx*x[0].u[24]+hdz*x[0].u[26],hdx*x[0].u[20]+hdz*x[0].u[22],now-x[0].hit_at,w,h,k);
  }
  xc_strike_due(s);
  xc_lock_step(s);
  xc_stops_step(s);
  // Refresh both permissions after shared expiry, independently of body hit stop.
  xc_sync_permissions(s);
  xc_grapple_step(s);
  // the picker (CLASSES, LEVEL, a wild-shape swap): top left, or under your portrait on a phone (xc_pick);
  // under ANIMATIONS for a developer (its rows give it room: cc dev_visible)
  lay := xc_layout(s); pick := lay.pick; pick_box := cm_pick_panel(pick);
  x[0].top = pick.y0;
  cr[0].dev_below = cm_pick_height(pick) / k + f32(XC_GAP);
  if u.count > 54 {
    // gpu/character-glade.coax: the ANIMATIONS panel ends over the picker (u[52]); the picker draws its own panel (u[53], u[54] off)
    u[52] = ifx cr[0].dev_animations && !cr[0].preview_collapsed then cr[0].dev_below * k else 0;
    u[53] = 0; u[54] = 0;
  }
  head := ink_col(k, 0.95, 0.9, 0.7);
  wild_words := [3]string.["", "", "REPLACE"];
  if pick.wild { choice:=xc_wild_options(x); wild_words[0]=rs_monster_block(choice[0]).name; wild_words[1]=rs_monster_block(choice[1]).name; }
  ui := cr[0].ui; cc.uit_part(ui, "class-menu");   // the layout trace, when the overlap check attaches one (#13076)
  if !xc_own_kit(x) && !xc_pick_hidden(x, lay) { n = cm_pick_draw(ui, out, n, pick, x[0].klass, x[0].level, x[0].pick_hover, "REPLACE ONE KNOWN FORM", wild_words); }   // the druid keeps to its own bar   // class-menu.coax
  // Hover the Thunderwave slot to preview its current footprint. A cast keeps
  // its footprint at the place and direction where it was released.
  wave_preview := x[0].hover >= 0 && x[0].hover < x[0].bar_n && !x[0].arranging && x[0].bar[x[0].hover].kind == FB_SPELL && x[0].bar[x[0].hover].sp == SP_THUNDERWAVE;
  wave_on := wave_preview || now < x[0].wave_until;
  wave := x[0].wave; wave_y := x[0].wave_y;
  if wave_preview { wave=aa.area_face(xk_spell_area(SP_THUNDERWAVE),cr[0].player_x,cr[0].player_z,cr[0].player_face); wave_y=cr[0].player_y; }
  if wave_on { n=xc_area_draw(x,wave,wave_y,out,n,k,ifx wave_preview then 0.8 else 1.0); }
  // the plates over bodies, Everglade's shared ones (aethyr/ui/hud-plates.coax places them,
  // everglade/hud/parts.coax eg_plates draws them): the crates', the monsters' (your target's in gold)
  // and your familiar's; a monster's while its body shows (xc_sight_shows), fading in and out
  sight_dt := ifx x[0].sight_at < 0 then 1.0f32 else ifx now - x[0].sight_at > 0.1 then 0.1f32 else ifx now < x[0].sight_at then 0.0f32 else now - x[0].sight_at;
  x[0].sight_at = now;
  view_x:=ifx observing then x[0].familiar_x else cr[0].player_x;
  view_z:=ifx observing then x[0].familiar_z else cr[0].player_z;
  pl := x[0].plates[..]; view := xc_plate_view(x, w, h);
  cc.hud_plates_begin(pl); pl[0].far = 0;   // no fade with distance: a monster's plate shows within what sees you (30 m)
  cc.hud_plates_keep_out(pl, pick_box.x0 - 40 * k, pick_box.y0 - 20 * k, pick_box.x1 + 40 * k, pick_box.y1 + 20 * k);   // not over the picker
  if xc_objects_ready(s) {
    for i:0..<XC_OBJECTS {
      o:=x[0].objects[i].rules[0];if o.destroyed {continue;}
      pos:=XC_OBJECT_POS[i];
      label:=ifx o.burning then "BURNING CRATE" else "SUPPLY CRATE";
      q:=cc.hud_plates_add(pl,pos[0],xmeadow.exp_height(pos[0],pos[1])+1.25,pos[1],label,f32(o.hp)/f32(rs_object_hp(o.size,o.resilient)),true,false,1);
      cc.hud_plates_ink(pl,q,1,0.78,0.35);
    }
  }
  for i: 0..<XC_FOES {
    e := hs[0].enemies[i];
    c := x[0].b[0].c[1 + i];
    if e.dead { continue; }
    dx := e.x - view_x; dz := e.z - view_z;
    if dx * dx + dz * dz > 30 * 30 || !hostile.hostile_sees(e, view_x, view_z) { x[0].sight[i] = cc.hud_sight_gone(); continue; }
    // the name and its health bar ride one settled answer, fading over 0.15 s
    x[0].sight[i] = xc_sight_step(x, x[0].sight[i], e.x, meadow_y(e.x, e.z), e.z, 1.7, sight_dt);
    on := i == x[0].target || (wave_on && aa.area_aim_contains(wave,e.x,e.z));
    nb: [32] u8;
    q := cc.hud_plates_add(pl, e.x, meadow_y(e.x, e.z) + 1.55, e.z, cc.eg_title(nb[..], XC_FOE_NAMES[e.kind]), f32(rs_max(c.hp, 0)) / f32(rs_max(c.hp_max, 1)), true, on, x[0].sight[i].share);
    tr := x[0].foe_trail[i]; if tr.on { cc.hud_plates_trail(pl, q, tr.fill, tr.trail); }   // its bar eases, and a blow leaves its trail
  }
  familiar:=rs_familiar_of(x[0].b[..],0);
  fx:=x[0].familiar_x; fz:=x[0].familiar_z;
  if !observing && familiar>=0 && rs_up(x[0].b[0].c[familiar]) && xdungeon.dg_sight(cr[0].player_x,cr[0].player_z,fx,fz) {
    fc:=x[0].b[0].c[familiar];
    cc.hud_plates_push(pl,fx,meadow_y(fx,fz)+0.75,fz,rs_monster_block(fc.familiar_form).name,f32(rs_max(fc.hp,0))/f32(rs_max(fc.hp_max,1)),false,false,1);
  }
  n = cc.eg_plates(out, n, pl, view, k, 0);
  // the numbers rising off whoever took them
  for q: 0..<fl.FLOATS {
    l := cc.eg_numbers_look(x[0].floats[..], q, now);
    if !l.ok { continue; }
    f := x[0].floats[0].items[q];
    p := xc_proj(x, l.x, l.y, l.z);
    // a target's points show wherever they are on screen, however far (eg_numbers_always); a creature's only while it shows
    if !p.ok || (!cc.eg_numbers_always(x[0].floats[..], q) && !xc_sight_shows(x, f.x, meadow_y(f.x, f.z), f.z, 1.6)) { continue; }
    n = cc.eg_numbers_draw(out, n, x[0].floats[..], q, l, p.x, p.y, k);
  }
  // the bar: its iron round the pictures (everglade/hud/parts.coax), each slot's key over its picture; your class and your target over it
  // on an upright phone the slots behind MORE are left out while it is shut, MORE is the row's last,
  // and there is no emblem: your portrait names your class (#13189)
  // MORE's rest, open, is a tray of its own over the row
  mn := xc_more_n(x); slots: [(XC_SLOTS + 1) * 4] f32; sn := 0;
  for i: 0..<mn { q := xc_slot(x, i); for c: 0..<4 { slots[sn * 4 + c] = q[c]; } sn += 1; }
  if xc_has_more(x) { q := xc_more_box(x); for c: 0..<4 { slots[sn * 4 + c] = q[c]; } sn += 1; }
  tray := cc.uit_next(ui);   // the tray's place in the layout trace: its slots follow it (eg_bar_slot_at)
  n = cc.eg_bar_frame(ui, out, n, slots[..], sn, k, ifx x[0].compact then cast(u8) 0 else XC_CL_UP[x[0].klass][0], 1);
  drawer := cc.UIT_NONE;
  if xc_has_more(x) && x[0].more {
    dn := 0; for i: mn..<x[0].bar_n { q := xc_slot(x, i); for c: 0..<4 { slots[dn * 4 + c] = q[c]; } dn += 1; }
    drawer = cc.uit_next(ui); n = cc.eg_bar_frame(ui, out, n, slots[..], dn, k, 0, 1);
  }
  if xc_has_more(x) {
    mb := cc.eg_box4(xc_more_box(x)); word := ifx x[0].more then "LESS" else "MORE";
    // a raised plate in its slot, as the page's other buttons (zone-touch.coax zt_button), lit while it is open
    ml: [1] cc.HudList; mw: [1] cc.HudWords; mw[0].ui = ui; mw[0].parent = cc.eg_bar_slot_at(ui, tray, mn);
    cc.hud_button(ml[..], cc.eg_tokens(), cc.hud_box(mb.x0 + 2 * k, mb.y0 + 2 * k, mb.x1 - 2 * k, mb.y1 - 2 * k), k, x[0].more);
    cc.hud_word(mw[..], word, (mb.x0 + mb.x1) * 0.5, (mb.y0 + mb.y1) * 0.5 + 4.5 * k, 9 * k, cc.HUD_TEXT_TITLE, true);
    n = cc.hud_draw(out, n, ml[..], mw[..], 1, k);
  }
  m := 0;
  for i: 0..<x[0].bar_n {
    if xc_slot_hidden(x, i) { continue; }
    r := cc.eg_box4(xc_slot(x, i));
    a := x[0].bar[i]; art := xc_art(a, i);
    slot := ifx i < mn then cc.eg_bar_slot_at(ui, tray, i) else cc.eg_bar_slot_at(ui, drawer, i - mn);
    m = put(x[0].media[..], m, "image "); m = put(x[0].media[..], m, xc_url(art)); m = put(x[0].media[..], m, art);
    m = put(x[0].media[..], m, ifx k > 1.4 then "-128.jpg " else "-72.jpg ");
    m = xc_box_text(x[0].media[..], m, r); m = put(x[0].media[..], m, "\n");
    left := f32(XC_COOL) - (now - x[0].cool_at);
    // the dragon's breath sweeps on its own: spent, the time to its next Recharge roll
    if a.kind == XC_BREATH { left = zone_breath_wait(s); }
    // the wait as a sweep on the picture (everglade/hud/parts.coax eg_slot_sweep)
    if left > 0 {
      share := ifx a.kind == XC_BREATH then left else left / f32(XC_COOL);
      sb := [4] f32.[r.x0, r.y0, r.x1, r.y1]; n = cc.eg_slot_sweep(out, n, sb[..], share, k);
    }
    // refused, or held by your conditions: the slot greys (#13072), no words
    grey := deed_look(x[0].deeds[0], i, deed_tick(now), 0).grey; held := deed_bar_dim(rs_bearing(x[0].b[0].c[0])); if held > grey { grey = held; }
    if grey > 0 {
      m = put(x[0].media[..], m, "over "); m = put(x[0].media[..], m, xc_url(art)); m = put(x[0].media[..], m, art);
      m = put(x[0].media[..], m, ifx k > 1.4 then "-128.jpg " else "-72.jpg ");
      m = xc_box_text(x[0].media[..], m, r); m = put(x[0].media[..], m, " "); m = put_int(x[0].media[..], m, cast(int) (100 - 65 * grey)); m = put(x[0].media[..], m, " 0 1000\n");
    }
    if a.kind == XC_BREATH { n = cc.ttext(ui, slot, out, n, "F", r.x0 + 4 * k, r.y0 + 13 * k, 9 * k, ink_col(k, 0.98, 0.95, 0.85), "key"); }
    else if i < 9 && xc_draw_slot_key(i,art) {key: [2] u8; key[0] = cast(u8) (49 + i);
     n = cc.ttext(ui, slot, out, n, cast(string) key[0..<1], r.x0 + 4 * k, r.y0 + 13 * k, 9 * k, ink_col(k, 0.98, 0.95, 0.85), "key");}
    if i == x[0].used && left > 0 { n = xc_line(out, n, r.x0, r.y1 + 4 * k, r.x1, r.y1 + 4 * k, 1.5 * k, 1, 0.8, 0.4); }
    // its choices: the slot level it casts at (when it has more than one) and its option
    levels: [9] int;
    if a.kind == FB_SPELL && fb_cast_levels(x[0].b[0].c[0], a, levels[..]) > 1 {
      lv: [2] u8; lv[0] = cast(u8) (48 + a.lvl);
      n = cc.ttext(ui, slot, out, n, cast(string) lv[0..<1], r.x1 - 10 * k, r.y0 + 13 * k, 9 * k, ink_col(k, 1, 0.82, 0.35), "slot level");
    }
    // its words, one line along its top and one along its bottom, each fitted inside the slot
    if xc_touch_spell(a) && (x[0].familiar_touch || (familiar>=0 && rs_up(x[0].b[0].c[familiar]))) {
      n=xc_caption(ui,slot,out,n,ifx x[0].familiar_touch then "Familiar" else "Hand",r,false,7*k,head,k);
    }
    if a.kind==XC_FAMILIAR {
      count:=RS_FAMILIAR_FORMS.count; druid:=x[0].b[0].c[0].companion;
      cb:[48]u8; cn:=0; for ch: rs_monster_block(RS_FAMILIAR_FORMS[a.opt%count]).name { if cn < 32 { cb[cn]=ch; cn+=1; } }
      if !druid { spirit:=[3]string.["Fey","Celestial","Fiend"]; for ch: " · " { cb[cn]=ch; cn+=1; } for ch: spirit[a.opt/count] { cb[cn]=ch; cn+=1; } }
      n=xc_caption(ui,slot,out,n,cast(string)cb[0..<cn],r,false,7*k,head,k);
      top:=ifx a.lvl>0 then "Spell slot" else ifx druid then "Wild Shape" else "Ritual";
      if familiar>=0 && x[0].b[0].c[familiar].hp>0 {
        top=ifx x[0].familiar_order==XC_FAMILIAR_SENSE then "Sense"
          else ifx x[0].familiar_order==XC_FAMILIAR_STEP then "Step"
          else ifx x[0].familiar_order==XC_FAMILIAR_RELEASE then "Release"
          else ifx x[0].familiar_order==XC_FAMILIAR_CAST then "Cast"
          else ifx x[0].b[0].c[familiar].dead then "Recall" else "Pocket";
      }
      n=xc_caption(ui,slot,out,n,top,r,true,7*k,head,k);
    }
    if a.kind==FB_WILD {
      form:=fb_wild_form(x[0].b[0].c[0],a.opt);
      label:=ifx form==MON_RIDING_HORSE then "Horse" else ifx form==MON_BLACK_BEAR then "Bear" else rs_monster_block(form).name;
      n=xc_caption(ui,slot,out,n,label,r,false,7*k,head,k);
    }
    if fb_ab_option_n(a) > 0 {
      n = xc_caption(ui, slot, out, n, fb_ab_option_label(a, rs_max(a.opt, 0)), r, false, 8 * k, ink_col(k, 1, 0.82, 0.35), k);
    }
    // a Ritual under way: a gold frame, its ten minutes filling along the bottom edge (pp.104-105)
    me := x[0].b[0].c[0];
    if (a.kind==FB_RITUAL && me.rite==a.sp) || (a.kind==XC_FAMILIAR && me.rite==SP_FIND_FAMILIAR) {
      seconds:=ifx a.kind!=XC_FAMILIAR then RS_RITE_SECONDS else ifx me.familiar_slot>0 then RS_FIND_FAMILIAR_SECONDS else RS_FIND_FAMILIAR_SECONDS+RS_RITE_SECONDS;
      done:=1-(me.rite_until-x[0].b[0].clock)/f32(seconds); if done>1 { done=1; }
      n = cc.eg_outline(out, n, r, 2 * k, 1, 0.8, 0.35);
      n = xc_line(out, n, r.x0, r.y1 - 2 * k, r.x0 + (r.x1 - r.x0) * done, r.y1 - 2 * k, 3 * k, 1, 0.8, 0.35);
    }
    // a Ready held: its frame gold until it answers or your next turn starts
    if a.kind == FB_READY && rs_ready_at(me) >= 0 { n = cc.eg_outline(out, n, r, 2 * k, 1, 0.8, 0.35); }
  }
  // The picked-up icon follows the pointer, as in the original Everglade bar.
  if x[0].arranging && x[0].down >= 0 && x[0].down < x[0].bar_n {
    a := x[0].bar[x[0].down]; art := xc_art(a, 1);
    r := cc.Box.{x0 = x[0].drag_x - 26 * k, y0 = x[0].drag_y - 26 * k,
                x1 = x[0].drag_x + 26 * k, y1 = x[0].drag_y + 26 * k};
    m = put(x[0].media[..], m, "over "); m = put(x[0].media[..], m, xc_url(art)); m = put(x[0].media[..], m, art);
    m = put(x[0].media[..], m, ifx k > 1.4 then "-128.jpg " else "-72.jpg ");
    m = xc_box_text(x[0].media[..], m, r); m = put(x[0].media[..], m, "\n");
  }
  // a spell that found no one ahead: its icon flashes red a moment (no words)
  if x[0].fizzle >= 0 && x[0].fizzle < x[0].bar_n && now - x[0].fizzle_at < 0.45 {
    r := cc.eg_box4(xc_slot(x, x[0].fizzle)); g := 1 - (now - x[0].fizzle_at) / 0.45; wd := 2.5 * k;
    n = xc_line(out, n, r.x0, r.y0, r.x1, r.y0, wd, 0.95 * g, 0.2 * g, 0.15 * g); n = xc_line(out, n, r.x0, r.y1, r.x1, r.y1, wd, 0.95 * g, 0.2 * g, 0.15 * g);
    n = xc_line(out, n, r.x0, r.y0, r.x0, r.y1, wd, 0.95 * g, 0.2 * g, 0.15 * g); n = xc_line(out, n, r.x1, r.y0, r.x1, r.y1, wd, 0.95 * g, 0.2 * g, 0.15 * g);
    n = xc_line(out, n, r.x0 + 8 * k, r.y0 + 8 * k, r.x1 - 8 * k, r.y1 - 8 * k, wd, 0.95 * g, 0.2 * g, 0.15 * g);
  }
  // a check's result on its icon: the frame flashes green when it passed, red when it failed
  if x[0].told >= 0 && x[0].told < x[0].bar_n && now - x[0].told_at < 0.6 {
    g := 1 - (now - x[0].told_at) / 0.6;
    n = cc.eg_outline(out, n, cc.eg_box4(xc_slot(x, x[0].told)), 2.5 * k, ifx x[0].told_ok then 0.3 * g else 0.95 * g, ifx x[0].told_ok then 0.9 * g else 0.2 * g, 0.2 * g);
  }
  if x[0].arranging && x[0].hover >= 0 && x[0].hover < x[0].bar_n {
    r := cc.eg_box4(xc_slot(x, x[0].hover));
    n = xc_line(out, n, r.x0, r.y0, r.x1, r.y0, 3 * k, 1, 0.8, 0.4);
    n = xc_line(out, n, r.x0, r.y1, r.x1, r.y1, 3 * k, 1, 0.8, 0.4);
  }
  if !x[0].arranging && x[0].hover >= 0 && x[0].hover < x[0].bar_n && x[0].bar[x[0].hover].kind != XC_BREATH {
    a := x[0].bar[x[0].hover];
    card := xc_card_box(x, lay);
    cc.uit_add(ui, cc.UIT_NONE, cc.UIT_PANEL, card.x0, card.y0, card.x1, card.y1, "card");
    m = put(x[0].media[..], m, "over "); m = put(x[0].media[..], m, xc_url(a.art)); m = put(x[0].media[..], m, a.art);
    m = put(x[0].media[..], m, "-card-2x.jpg "); m = xc_box_text(x[0].media[..], m, card); m = put(x[0].media[..], m, "\n");
  }
  x[0].media_n = m;
  if x[0].bar_n > 0 && !x[0].compact {   // on an upright phone your portrait names your class, and your target's frame it
    r0 := cc.eg_box4(xc_slot(x, 0));
    line: [64] u8; ln := put(line[..], 0, XC_CL_UP[x[0].klass]);
    // your target is in its frame by your portrait; where the page has no room for one, on this line
    t := x[0].target; framed := xc_target_box(s, lay); framed_on := framed.x1 > framed.x0;
    if t >= 0 && !hs[0].enemies[t].dead && !framed_on {
      c := x[0].b[0].c[1 + t];
      ln = put(line[..], ln, "  ·  "); ln = put(line[..], ln, XC_FOE_NAMES[hs[0].enemies[t].kind]); ln = put(line[..], ln, " ");
      ln = put_int(line[..], ln, rs_max(c.hp, 0)); ln = put(line[..], ln, " / "); ln = put_int(line[..], ln, c.hp_max); ln = put(line[..], ln, " HP");
      if rs_has(c, RS_UNCONSCIOUS) { ln = put(line[..], ln, "  ·  UNCONSCIOUS"); }
      if x[0].studied[t] { ln = put(line[..], ln, "  ·  AC "); ln = put_int(line[..], ln, c.ac); }
    }
    tl := cast(string) line[0..<ln];
    // beside the bar's emblem (everglade/hud/parts.coax eg_bar_frame), not under it
    lx := ifx x[0].bar_n > 0 then cc.eg_box4(xc_slot(x, 0)).x0 else 0.0f32; rx := lx;
    for i: 0..<x[0].bar_n { sb := cc.eg_box4(xc_slot(x, i)); if sb.x0 < lx { lx = sb.x0; } if sb.x1 > rx { rx = sb.x1; } }
    n = cc.ttext(ui, cc.UIT_NONE, out, n, tl, (lx + rx) / 2 + 24 * k, r0.y0 - 12 * k, 10 * k, ink_col(k, 0.95, 0.9, 0.7), "class and target");
  }
  // the class menus under your portrait: REST's, and a tip (everglade/hud/class-bar.coax)
  sf := xc_facts(s); sg := lay.side;
  n = eg_side_draw(ui, sf, sg, x[0].side, out, n);
  n = xc_corner(s, lay, out, n);
  // the effects: the frame's puffs for the host to draw (fivelab-fx.wgsl)
  pf := s[0].puffs[..];
  fxp_begin(pf, now, fxp_v(u[16], u[17], u[18]));
  fxp_emit_all(pf, now);
  xc_bow_puffs(s, pf);
  _ := fxp_close(pf);
  return n;
}
xc_box_text :: (buf: [] u8, at: int, r: cc.Box) -> int {
  m := put_int(buf, at, cast(int) r.x0); m = put(buf, m, " "); m = put_int(buf, m, cast(int) r.y0); m = put(buf, m, " ");
  m = put_int(buf, m, cast(int) r.x1); m = put(buf, m, " "); return put_int(buf, m, cast(int) r.y1);
}
ink_col :: (k: f32, r: f32, g: f32, b: f32) -> Ink { return cc.ink(k, r, g, b); }
meadow_y :: (x: f32, z: f32) -> f32 { return xmeadow.exp_height(x, z); }
xc_line :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, wide: f32, r: f32, g: f32, b: f32) -> int {
  if cc.lit(out, n, ax, ay, bx, by, wide, 1, 0, r, g, b, 0) { return n + 6; }
  return n;
}

// ---- input
// Keys 1 to N press the bar's slots.
xc_key :: (s: [] EgZone, key: int) -> bool {
  x := s[0].xc[..];
  if key == -1 && xc_bow_cancel(s) { return true; }   // Escape lets the draw down
  if key == 'k' || key == 'K' { x[0].knockout = !x[0].knockout; return true; }   // SRD p.17: your melee blows knock out instead of killing
  if key >= '1' && key <= '9' { i := key - '1'; if xd_aim(s, i) { x[0].dr.breath_key = key; return true; } if i < x[0].bar_n { _ := xc_press(s, i); return true; } }
  return false;
}
// The column and the bar are pressed; a click (no drag) on a monster makes it your target. False
// leaves the pointer to Character Create (the camera, the ANIMATIONS browser).
xc_pointer :: (s: [] EgZone, px: f32, py: f32, phase: int, id: int) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..];
  if !x[0].seen || cr[0].walk.on { return false; }
  k := x[0].k;
  // MORE (an upright phone): a press opens the rest of the bar over it, or shuts it
  if xc_has_more(x) {
    if phase == 0 && xc_in(cc.eg_box4(xc_more_box(x)), px, py) { x[0].more = !x[0].more; x[0].down = -5; x[0].down_id = id; x[0].hover = -1; return true; }
    if phase != 0 && x[0].down == -5 && id == x[0].down_id { if phase >= 2 { x[0].down = -100; } return true; }
  }
  over := -1;
  for i: 0..<x[0].bar_n { if xc_in(cc.eg_box4(xc_slot(x, i)), px, py) { over = i; } }
  x[0].hover = over;
  // a finger leaves no hover behind: the slot's card is up only while it is held, and never over
  // the bow's slot, whose hold is the draw (the card would cover your aim on an upright phone, #13152)
  if cr[0].ml[0].touch && (phase >= 2 || x[0].ar[0].touch == id || (over >= 0 && x[0].bar[over].kind == FB_ATTACK && xc_kit(x[0].klass) == XC_KIT_BOW)) { x[0].hover = -1; }
  lay := xc_layout(s); pick := lay.pick;
  in_col := !xc_own_kit(x) && !xc_pick_hidden(x, lay) && cm_in(cm_pick_panel(pick), px, py);
  x[0].pick_hover = ifx in_col then cm_pick_hit(pick, px, py) else CmHit.{};
  // the class menus first: your portrait opens them, a row acts on the press (everglade/hud/class-bar.coax)
  if x[0].ar[0].touch != id {
    sf := xc_facts(s); sp := eg_side_press(sf, lay.side, x[0].side, px, py, ifx phase == 0 then 0 else 1);
    x[0].side = sp.st;
    if sp.taken {
      if sp.act != 0 { xc_side_act(s, sf, sp.act); } else if sp.st.menu == EG_SIDE_REST { x[0].rest_refused = false; }
      x[0].down = -4; x[0].down_id = id; return true;
    }
    if phase != 0 && x[0].down == -4 && id == x[0].down_id { if phase >= 2 { x[0].down = -100; } return true; }
  }
  // a finger (or a click) held on the bow's slot draws; dragging aims (the camera turns), lifting
  // looses, and a tap draws on to full and looses itself (aethyr/action/archery.coax archer_touch)
  bt := arch.archer_touch(x[0].ar[..], id, phase, px, py, k, cr[0].clock);
  if bt.kind == arch.TOUCH_AIM { cr[0].yaw += bt.yaw; cr[0].pitch = cc.cc_clamp(cr[0].pitch + bt.pitch, -1.2, 1.2); return true; }
  if bt.kind == arch.TOUCH_CANCEL { _ := xc_bow_cancel(s); return true; }
  if bt.kind == arch.TOUCH_LOOSE { _ := xc_bow_loose(s); return true; }
  if bt.kind == arch.TOUCH_TAP { return true; }
  if phase == 0 && over >= 0 && !s[0].shift && x[0].bar[over].kind == FB_ATTACK && xc_kit(x[0].klass) == XC_KIT_BOW {
    if xc_bow_begin(s, false) { arch.archer_touch_down(x[0].ar[..], id, px, py, cr[0].clock); }
    return true;
  }
  if over < 0 && x[0].dr.breath_touch != id && xd_pointer(s, px, py, phase, id) { return true; }   // a phone's thumbs in the grove
  // Fire Breath: a finger held on its slot aims, lifting it breathes (zone-shapechange.coax)
  if x[0].dr.breath_touch == id && (phase == 2 || phase == 3) { x[0].dr.breath_touch = -100; if phase == 3 { sh_aim_cancel(x[0].dr.sh[..]); x[0].dr.breath_slot = -1; } else { _ := xd_release(s); } return true; }
  if phase == 0 && over >= 0 && !s[0].shift && xd_aim(s, over) { x[0].dr.breath_touch = id; return true; }
  if phase == 0 {
    x[0].down = -100; x[0].down_x = px; x[0].down_y = py; x[0].down_id = id;
    if over >= 0 { x[0].down = over; x[0].arranging = s[0].shift; x[0].drag_x = px; x[0].drag_y = py; return true; }
    if in_col { x[0].down = -2; return true; }
    x[0].down = -3;   // the world: a click or the camera's drag
    return false;
  }
  if phase == 2 && id == x[0].down_id {
    d := x[0].down; x[0].down = -100;
    if d >= 0 {
      if x[0].arranging { xc_swap(x, d, over); x[0].arranging = false; }
      else if d == over && !xc_choose(s, d, px, py) { _ := xc_press(s, d); }
      if d == over && xc_has_more(x) && d >= xc_more_n(x) { x[0].more = false; }   // a slot from behind MORE: it shuts again
      return true;
    }
    if d == -3 && abs(px - x[0].down_x) + abs(py - x[0].down_y) < 6 * k { return xc_pick_at(s, px, py); }
    if d == -2 {
      if in_col {
        h := cm_pick_hit(pick, px, py);   // class-menu.coax
        if h.kind == CM_WILD { _ := xc_wild_pick(x, h.index); }
        else if h.kind == CM_LEVEL { xc_set_level(x, h.index); }
        else if h.kind == CM_TOGGLE { x[0].open = !x[0].open; }
        else if h.kind == CM_CLASS { xc_set_class(x, h.index); }
      }
      return true;
    }
    return false;
  }
  if phase == 3 && id == x[0].down_id { x[0].down = -100; x[0].arranging = false; return true; }
  if phase == 1 && x[0].arranging && id == x[0].down_id { x[0].drag_x = px; x[0].drag_y = py; }
  return x[0].down >= 0 || x[0].down == -2;
}
// What the checks read (zone_probe 900 on).
xc_probe :: (s: [] EgZone, f: int) -> int {
  x := s[0].xc[..]; hs := s[0].creator[0].hostiles[..];
  if f == 900 { return x[0].klass; }
  // 999 the Attack slot; 1000 + 4i + k monster i's x and z (centimetres), awake (1) and returning (2), and
  // how far it stands from home (centimetres)
  if f == 999 { return xc_slot_of(x, FB_ATTACK); }
  if f >= 1000 && f < 1000 + 4 * XC_FOES {
    e := hs[0].enemies[(f - 1000) / 4]; k := (f - 1000) % 4;
    if k == 0 { return cast(int) (e.x * 100); } if k == 1 { return cast(int) (e.z * 100); }
    if k == 2 { return (ifx e.awake then 1 else 0) + (ifx e.returning then 2 else 0); }
    hx := e.x - e.home_x; hz := e.z - e.home_z; return cast(int) (sqrt(hx * hx + hz * hz) * 100);
  }
  if f == 901 { return x[0].bar_n; }
  if f == 902 { return x[0].casts; }
  if f == 903 { return x[0].landed; }
  if f == 904 { return x[0].kills; }
  if f == 905 { return x[0].target; }
  if f == 906 { return x[0].refused; }
  if f == 909 { return x[0].whiffs; }
  if f == 916 { return s[0].creator[0].weapon; }
  if f == 917 { return x[0].pend; }
  if f == 918 { return x[0].contacts; }
  if f == 919 { return x[0].fallbacks; }
  if f == 932 { return x[0].exhausted; }
  if f == 933 { return cast(int) (x[0].blade_step * 1000); }
  if f == 934 { return x[0].floats[0].shown; }
  if f == 935 { return x[0].floats[0].suppressed; }
  if f == 936 { return x[0].stops.n; }
  if f == 937 { return cast(int)(s[0].creator[0].player_y*1000); }
  if f >= 990 && f < 996 { return ifx hs[0].enemies[f - 990].stopped then 1 else 0; }
  if f == 907 { return x[0].last_dmg; }
  if f == 908 { return hs[0].hp; }
  if f >= 910 && f < 916 { return ifx x[0].started then x[0].b[0].c[1 + f - 910].hp else -1; }
  if f >= 920 && f < 932 {
    i := (f - 920) / 2; e := hs[0].enemies[i];
    p := xc_proj(x, e.x, meadow_y(e.x, e.z) + 0.8, e.z);
    if !p.ok { return -1; }
    return cast(int) (ifx (f - 920) % 2 == 0 then p.x else p.y);
  }
  if f >= 940 && f < 946 { return ifx hs[0].enemies[f - 940].dead then 1 else 0; }
  if f >= 950 && f < 962 { b := cm_pick_box(xc_pick(s), CM_CLASS, f - 950); return cast(int) ((b.y0 + b.y1) / 2); }
  if f >= 970 && f < 976 { r := cc.eg_box4(xc_slot(x, f - 970)); return cast(int) ((r.x0 + r.x1) / 2); }
  if f == 976 { r := cc.eg_box4(xc_slot(x, 0)); return cast(int) ((r.y0 + r.y1) / 2); }
  if f >= 980 && f < 986 { return cast(int) (x[0].bar[f - 980].sp); }
  // the bow: shots loosed, that hit, missed, stuck in the world, struck past normal range; the draw's
  // aim (per mille) and whether drawing; arrows in the air and stuck; where the crosshair is
  if f == 1000 { return x[0].ar[0].shots; }
  if f == 1001 { return x[0].bow_hits; }
  if f == 1002 { return x[0].bow_misses; }
  if f == 1003 { return x[0].ar[0].stuck; }
  if f == 1004 { return x[0].bow_far; }
  if f == 1005 { return cast(int) (bow.bow_aim(x[0].ar[0].draw[0]) * 1000); }
  if f == 1006 { return ifx x[0].ar[0].draw[0].on then 1 else 0; }
  if f == 1007 || f == 1008 { m := 0; for i: 0..<bow.ARROWS { if x[0].ar[0].arrows[0].a[i].state == ifx f == 1007 then bow.ARROW_FLYING else bow.ARROW_STUCK { m += 1; } } return m; }
  if f >= 1011 && f < 1017 {   // the newest arrow: where it left (1011-1013) and stopped (1014-1016), centimetres
    m := -1; for i: 0..<bow.ARROWS { if x[0].ar[0].arrows[0].a[i].state != bow.ARROW_FREE && (m < 0 || x[0].ar[0].arrows[0].a[i].t0 > x[0].ar[0].arrows[0].a[m].t0) { m = i; } }
    if m < 0 { return -99999; }
    a := x[0].ar[0].arrows[0].a[m]; v := ifx f < 1014 then a.from[f - 1011] else a.at[f - 1014];
    return cast(int) (v * 100);
  }
  if f == 1017 { m := -1; for i: 0..<bow.ARROWS { if x[0].ar[0].arrows[0].a[i].state != bow.ARROW_FREE && (m < 0 || x[0].ar[0].arrows[0].a[i].t0 > x[0].ar[0].arrows[0].a[m].t0) { m = i; } } return ifx m < 0 then -2 else x[0].ar[0].arrows[0].a[m].aim; }
  if f == 1018 { return xc_bow_point(s).foe; }
  if f >= 1019 && f < 1022 { return cast(int) (xc_bow_point(s).at[f - 1019] * 100); }
  if f >= 1030 && f < 1048 { e := hs[0].enemies[(f - 1030) / 3]; c := (f - 1030) % 3; return cast(int) (100 * (ifx c == 0 then e.x else ifx c == 1 then meadow_y(e.x, e.z) else e.z)); }
  if f >= 2000 && f < 2361 { s[0].creator[0].orbit = f32(f - 2000) * 3.14159265 / 180; return 1; }   // a check turns the camera round you
  if f == 1009 { return cast(int) x[0].u[23]; }
  if f == 1010 { return cast(int) x[0].u[27]; }
  return -1;
}

#test "the class icon already carries its key and other slots draw theirs" {
 bar:[XC_SLOTS]FbAb;for c:0..<FB_CL_N {n:=xc_bar(c,bar[..]);#assert !xc_draw_slot_key(0,bar[0].art);for i:1..<n {#assert xc_draw_slot_key(i,bar[i].art);}}
 #assert xc_draw_slot_key(0,"attack") && xc_draw_slot_key(1,"cl-second-wind");
}
#test "experimental combat: every class's level 1 bar holds its Character Create ability first, each slot with its picture" #steps 400000000 {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N {
    n := xc_bar(c, bar[..]);
    #assert n >= 1 && n <= XC_SLOTS;
    #assert bar[0].kind == fb_cl_ability(c).kind && bar[0].name == fb_cl_ability(c).name && xc_url(bar[0].art) == XC_EG_URL;
    for i: 0..<n { #assert bar[i].art.count > 0; if i > 0 { #assert xc_url(bar[i].art) == XC_MMO_URL; } }
  }
  #assert xc_bar(FB_CL_WIZARD, bar[..]) == 5 && bar[0].sp == SP_FIRE_BOLT;
  #assert xc_bar(FB_CL_FIGHTER, bar[..]) == 2 && bar[1].kind == FB_ATTACK;
}
#test "experimental combat: a Wizard's Fire Bolt and a Fighter's Attack fell a monster, which then lies still" #steps 2000000000 {
  for pass: 0..<2 {
    s: [1] EgZone;
    zone_enter(s[..], "url=http://localhost/worlds/everglade-experimental\n");
    cr := s[0].creator[..]; h := cr[0].hostiles[..];
    h[0].ready = true; h[0].hp = XC_PLAYER_MAX; for i: 0..<XC_FOES { h[0].enemies[i].swing = -1; }
    x := s[0].xc[..];
    xc_start(x, ifx pass == 0 then FB_CL_WIZARD else FB_CL_FIGHTER);
    xc_set_class(x, ifx pass == 0 then FB_CL_WIZARD else FB_CL_FIGHTER);
    // one gremlin (a Goblin Warrior; the Imp is immune to Fire) just ahead of you (in reach of a sword), the rest far off
    cr[0].player_x = 0; cr[0].player_z = 0;
    for i: 0..<XC_FOES { h[0].enemies[i].x = 60; h[0].enemies[i].z = 60 + f32(i) * 3; }
    h[0].enemies[3].x = 0; h[0].enemies[3].z = 1.2; cr[0].player_face = 0;   // ahead of you (you face +z)
    slot := ifx pass == 0 then 0 else 1;   // Fire Bolt is slot 1; the Fighter's Attack slot 2
    #assert (pass == 0 && x[0].bar[0].sp == SP_FIRE_BOLT) || (pass == 1 && x[0].bar[1].kind == FB_ATTACK);
    tries := 0;
    while !h[0].enemies[3].dead && tries < 60 {
      cr[0].clock += 1.1; h[0].hp = XC_PLAYER_MAX;
      _ := xc_press(s[..], slot); tries += 1;
    }
    #assert h[0].enemies[3].dead && x[0].kills == 1 && x[0].landed >= 1 && x[0].casts >= 1;
    #assert x[0].b[0].c[4].hp <= 0 && x[0].target == -1;
    // the felled gremlin is out of the fight: the next press finds no one in reach for a sword, and no one is hurt
    for i: 0..<XC_FOES { if i == 3 { continue; } #assert x[0].b[0].c[1 + i].hp == x[0].b[0].c[1 + i].hp_max; }
  }
}

#test "experimental combat: with KNOCK OUT on, a Fighter's blow leaves a monster at 1 HP, Unconscious and still; off, it kills" #steps 2000000000 {
  for pass: 0..<2 {
    s: [1] EgZone; xc_test_lab(s[..], FB_CL_FIGHTER, 0);
    cr := s[0].creator[..]; h := cr[0].hostiles[..]; x := s[0].xc[..];
    h[0].enemies[3].x = 0; h[0].enemies[3].z = 1.2;   // a gremlin (a Goblin Warrior) just ahead
    x[0].b[0].c[4].hp = 1;
    // the KNOCK OUT toggle (the sixth box under REST) sets this
    if pass == 0 { x[0].knockout = true; }
    tries := 0;
    while x[0].landed == 0 && tries < 60 { cr[0].clock += 1.1; h[0].hp = XC_PLAYER_MAX; _ := xc_press(s[..], 1); tries += 1; }
    c := x[0].b[0].c[4];
    if pass == 0 {
      #assert c.hp == 1 && !c.dead && rs_knocked_out(c) && rs_has(c, RS_UNCONSCIOUS) && !h[0].enemies[3].dead && x[0].kills == 0;
      #assert h[0].enemies[3].held && h[0].enemies[3].inactive && x[0].target == 3;
    } else {
      #assert c.dead && h[0].enemies[3].dead && x[0].kills == 1;
    }
  }
}

#test "experimental combat: Hide needs cover, Grapple holds and drags, Shove knocks Prone, Ready answers a move" #steps 2000000000 {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N { for level: 1..<7 {
    hero := fb_cl_hero(c, "You", 0, level); n := xc_bar_level(c, level, bar[..]);
    #assert xc_actions(bar[..], n, hero) == n + 5 + (ifx fb_ritual_spell(hero) >= 0 then 1 else 0) + (ifx hero.companion || hero.klass==RS_WIZARD then 1 else 0) && n + 7 <= XC_SLOTS;
  } }
  for pass: 0..<3 {
    s: [1] EgZone; xc_test_lab(s[..], FB_CL_FIGHTER, 0);
    cr := s[0].creator[..]; h := cr[0].hostiles[..]; x := s[0].xc[..]; b := x[0].b[..];
    b[0].dice[0].fixed = true; b[0].c[4].ac = 5; b[0].c[4].hp = 100; b[0].c[4].hp_max = 100;
    slot: [4] int;
    for q: 0..<4 { slot[q] = -1; for i: 0..<x[0].bar_n { if x[0].bar[i].kind == XC_ACTIONS[q] { slot[q] = i; } } #assert slot[q] >= 0 && x[0].bar[slot[q]].art == XC_ACTION_ART[q]; }
    h[0].enemies[3].x = 0; h[0].enemies[3].z = 1.5;   // a gremlin (a Goblin Warrior) just ahead
    cr[0].clock += 1.1;
    if pass == 0 {
      #assert !xc_press(s[..], slot[0]) && rs_hidden_at(b[0].c[0]) < 0 && !x[0].seat[0].turn.action;   // it sees you
      #assert xc_press(s[..], slot[1]) && b[0].c[0].grappling == 4 && rs_has(b[0].c[4], RS_GRAPPLED);
      xc_sync_permissions(s[..]); #assert h[0].enemies[3].held;
      cr[0].player_z = -3; xc_grapple_step(s[..]);
      #assert h[0].enemies[3].z < 0 && h[0].enemies[3].z > -3 && b[0].c[0].grappling == 4;   // dragged along
      b[0].c[0].cond |= RS_STUNNED;
      xc_grapple_step(s[..]); #assert b[0].c[0].grappling == -1 && !rs_has(b[0].c[4], RS_GRAPPLED) && !h[0].enemies[3].held;
    } else if pass == 1 {
      #assert xc_press(s[..], slot[2]) && rs_has(b[0].c[4], RS_PRONE) && b[0].c[0].grappling == -1;
    } else {
      #assert xc_press(s[..], slot[3]) && rs_ready_at(b[0].c[0]) >= 0 && !b[0].c[0].reacted;
      proposed := h[0].enemies[3]; proposed.z = 1.4; proposed.moving = true;
      xc_monster_move(s[..], 3, proposed);
      #assert b[0].c[0].reacted && b[0].c[4].hp < 100 && rs_ready_at(b[0].c[0]) < 0;
    }
  }
}

xc_slot_of :: (x: [] XcCombat, kind: int) -> int { for i: 0..<x[0].bar_n { if x[0].bar[i].kind == kind { return i; } } return -1; }
#test "experimental combat: Shove's push moves it 5 feet away (#13040, #13038)" #steps 2000000000 {
  // Shove's push (p.181): the strip's second option moves it 5 feet straight away, through the world
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_FIGHTER, 0);
  cr := s[0].creator[..]; h := cr[0].hostiles[..]; x := s[0].xc[..]; b := x[0].b[..];
  b[0].dice[0].fixed = true; b[0].c[4].hp = 100; b[0].c[4].hp_max = 100;
  h[0].enemies[3].x = 0; h[0].enemies[3].z = 1.5; cr[0].clock += 1.1;
  sh := xc_slot_of(x, FB_SHOVE); #assert sh >= 0 && fb_ab_option_n(x[0].bar[sh]) == 2 && fb_ab_option_label(x[0].bar[sh], 1) == "PUSH";
  x[0].k = 1; x[0].w = 1200; x[0].h = 800; r := cc.eg_box4(xc_slot(x, sh)); #assert xc_choose(s[..], sh, r.x0 + 3, r.y1 - 3) && x[0].bar[sh].opt == 1;
  #assert xc_press(s[..], sh) && h[0].enemies[3].z > 2.9 && h[0].enemies[3].z < 3.1 && !rs_has(b[0].c[4], RS_PRONE);
}
#test "experimental combat: a readied move carries you 30 feet away (#13040, #13038)" #steps 2000000000 {
  // Ready a move: the gremlin steps, and you are carried 30 feet straight away from it
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_FIGHTER, 0);
  cr := s[0].creator[..]; h := cr[0].hostiles[..]; x := s[0].xc[..]; b := x[0].b[..];
  h[0].enemies[3].x = 0; h[0].enemies[3].z = 4.5; cr[0].clock += 1.1;
  rd := xc_slot_of(x, FB_READY); x[0].bar[rd].opt = 1;
  #assert xc_press(s[..], rd) && rs_ready_response(b[0].c[0].eff[rs_ready_at(b[0].c[0])]) == RD_MOVE;
  proposed := h[0].enemies[3]; proposed.z = 4.2; proposed.moving = true; xc_monster_move(s[..], 3, proposed);
  #assert b[0].c[0].reacted && rs_ready_at(b[0].c[0]) < 0 && x[0].glide_until > 0 && x[0].glide_z < -8.5;
  for f: 0..<60 { xc_glide_step(s[..]); }
  #assert cr[0].player_z < -8.5 && cr[0].player_z > -9.5 && s[0].put_on && x[0].glide_until < 0;
}
#test "experimental combat: a readied spell answers a monster that moves in range (#13040, #13038)" #steps 2000000000 {
  // Ready a spell: a Wizard holds Fire Bolt and lets it go at the monster that moves in range
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  cr := s[0].creator[..]; h := cr[0].hostiles[..]; x := s[0].xc[..]; b := x[0].b[..];
  b[0].dice[0].fixed = true; b[0].c[4].ac = 1; b[0].c[4].hp = 100; b[0].c[4].hp_max = 100;
  h[0].enemies[3].x = 0; h[0].enemies[3].z = 9; cr[0].clock += 1.1;
  rd := xc_slot_of(x, FB_READY); #assert x[0].bar[rd].sp == SP_FIRE_BOLT; x[0].bar[rd].opt = 2;
  #assert xc_press(s[..], rd) && b[0].c[0].conc == SP_FIRE_BOLT;
  proposed := h[0].enemies[3]; proposed.z = 8.5; proposed.moving = true; xc_monster_move(s[..], 3, proposed);
  #assert b[0].c[0].reacted && b[0].c[4].hp < 100 && rs_ready_at(b[0].c[0]) < 0;
}
#test "experimental combat: Search, Study and Influence take their checks (#13040, #13038)" #steps 2000000000 {
  // Search, Study and Influence: each takes the check; Study recalls its AC, Influence calms it
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_BARD, 0);
  cr := s[0].creator[..]; h := cr[0].hostiles[..]; x := s[0].xc[..]; b := x[0].b[..];
  h[0].enemies[0].x = 0; h[0].enemies[0].z = 1.5; cr[0].clock += 1.1;
  sk := xc_slot_of(x, FB_SKILL); #assert sk >= 0 && fb_ab_option_label(x[0].bar[sk], 2) == "INFLUENCE";
  #assert xc_press(s[..], sk) && x[0].told == sk;   // Search needs no one
  b[0].dice[0].fixed = true; b[0].c[0].score[RS_INT] = 30; b[0].c[0].score[RS_CHA] = 30;
  cr[0].clock += 1.1; x[0].bar[sk].opt = 1; #assert xc_press(s[..], sk) && x[0].told_ok && x[0].studied[0];
  cr[0].clock += 1.1; x[0].bar[sk].opt = 2; #assert xc_press(s[..], sk) && x[0].told_ok && x[0].calm[0];
  xc_sync_permission(s[..], 0); #assert h[0].enemies[0].inactive && h[0].enemies[0].held;
  b[0].c[0].score[RS_CHA] = 1; x[0].calm[0] = false; cr[0].clock += 1.1;
  #assert xc_press(s[..], sk) && !x[0].told_ok && !x[0].calm[0];
  cr[0].clock += 1.1; #assert !xc_press(s[..], sk);   // failed: 24 hours before urging it the same way
}
#test "experimental combat: a Ritual runs ten minutes and casts with no slot (#13040, #13038)" #steps 2000000000 {
  // a Ritual: the Druid's Speak with Animals, kept going each turn, cast with no slot after ten minutes
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_DRUID, 0);
  cr := s[0].creator[..]; x := s[0].xc[..]; b := x[0].b[..];
  rt := xc_slot_of(x, FB_RITUAL); #assert rt >= 0 && x[0].bar[rt].sp == SP_SPEAK_WITH_ANIMALS;
  cr[0].clock += 1.1; slots := b[0].c[0].slots;
  #assert xc_press(s[..], rt) && b[0].c[0].rite == SP_SPEAK_WITH_ANIMALS;
  b[0].clock = b[0].c[0].turn_at;
  for t: 0..<400 { b[0].clock += 1.5; fb_seat_step(b, x[0].seat[..]); xc_rite_step(s[..]); #assert (b[0].c[0].rite == SP_SPEAK_WITH_ANIMALS) == (t < 399); }
  #assert b[0].c[0].slots[1] == slots[1];

}
// A fresh fight for the aim checks: class c, you at the origin facing +z (or `face`), every monster
// far away except those the check places.
xc_test_lab :: (s: [] EgZone, c: int, face: f32) {
  zone_enter(s, "url=http://localhost/worlds/everglade-experimental\n");
  cr := s[0].creator[..]; h := cr[0].hostiles[..];
  h[0].ready = true; h[0].hp = XC_PLAYER_MAX; h[0].safe_r = 0; h[0].calm_until = -1;   // the checks place you and the monsters themselves
  for i: 0..<XC_FOES { h[0].enemies[i].swing = -1; h[0].enemies[i].x = 70 + f32(i) * 3; h[0].enemies[i].z = -70; }
  xc_start(s[0].xc[..], c); xc_set_class(s[0].xc[..], c);
  cr[0].player_x = 0; cr[0].player_z = 0; cr[0].player_face = face;
}
xc_hp_sum :: (s: [] EgZone) -> int { t := 0; for i: 0..<XC_FOES { t += s[0].xc[0].b[0].c[1 + i].hp; } return t; }
#test "experimental combat: a bolt flies the way you face; one behind you is never hit, one ahead is, and a miss does no damage" #steps 2000000000 {
  // behind you (you face +z, the imp 8 m at -z), fifty Fire Bolts: none touch it
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = -8;
  hp := xc_hp_sum(s[..]);
  for i: 0..<50 { s[0].creator[0].clock += 1.1; #assert xc_press(s[..], 0); }
  #assert xc_hp_sum(s[..]) == hp && s[0].xc[0].whiffs == 50 && s[0].xc[0].landed == 0 && s[0].xc[0].target == -1;
  // beside you, out of the 5 degree help: never hit either
  h[0].enemies[0].x = 6; h[0].enemies[0].z = 6;
  for i: 0..<20 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 0); }
  #assert xc_hp_sum(s[..]) == hp;
  // past Fire Bolt's 120 feet (36.6 m) straight ahead: it fizzles short of it
  h[0].enemies[0].x = 0; h[0].enemies[0].z = 40;
  for i: 0..<20 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 0); }
  #assert xc_hp_sum(s[..]) == hp;
  // turn round to face it, or put it ahead a little off the line (within 5 degrees): it is struck at
  h[0].enemies[0].x = 0.9; h[0].enemies[0].z = 20;   // 2.6 degrees off
  m := xc_aim(s[..], s[0].xc[0].bar[0]); #assert m.kind == XC_AIM_BOLT && m.foe == 0 && abs(m.reach - 36.576) < 0.01;
  h[0].enemies[0].x = 0; h[0].enemies[0].z = -8; s[0].creator[0].player_face = 3.14159265;
  m = xc_aim(s[..], s[0].xc[0].bar[0]); #assert m.foe == 0;
  // the first monster on the line is the one struck, not one behind it
  h[0].enemies[1].x = 0; h[0].enemies[1].z = -4;
  m = xc_aim(s[..], s[0].xc[0].bar[0]); #assert m.foe == 1;
  h[0].enemies[1].z = -70;
  // the Imp is immune to Fire: the gremlin (a Goblin Warrior) takes the bolt that lands
  h[0].enemies[0].z = -70; h[0].enemies[3].x = 0; h[0].enemies[3].z = -8;
  landed := 0; tries := 0;
  while s[0].xc[0].landed == 0 && tries < 40 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 0); tries += 1; }
  #assert s[0].xc[0].landed == 1 && xc_hp_sum(s[..]) < hp && s[0].xc[0].target == 3;
}
#test "experimental combat: a blow strikes ahead within reach and nothing behind is picked" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_FIGHTER, 0);
  h := s[0].creator[0].hostiles[..]; bar := s[0].xc[0].bar[1];   // Attack (a longsword: a blow)
  #assert xc_aim_kind(s[..], bar).kind == XC_AIM_MELEE;
  h[0].enemies[0].x = 0; h[0].enemies[0].z = -1.2;   // right behind you
  hp := xc_hp_sum(s[..]);
  for i: 0..<30 { s[0].creator[0].clock += 1.1; _ := xc_press(s[..], 1); }
  #assert xc_hp_sum(s[..]) == hp && s[0].xc[0].landed == 0;
  h[0].enemies[0].x = 1.0; h[0].enemies[0].z = 1.0;   // 45 degrees ahead, in reach
  #assert xc_aim(s[..], bar).foe == 0;
  h[0].enemies[0].x = 0; h[0].enemies[0].z = 3.5;     // ahead but out of reach
  #assert xc_aim(s[..], bar).foe == -1;
  #assert xc_aim_kind(s[..], s[0].xc[0].bar[0]).kind == XC_AIM_SELF;
}
#test "experimental combat: a save spell takes the cone ahead and nothing outside is picked" #steps 2000000000 {
  // Sacred Flame: the nearest in range within 30 degrees ahead, or nothing (its icon fizzles, no turn spent)
  c: [1] EgZone; xc_test_lab(c[..], FB_CL_CLERIC, 0);
  g := c[0].creator[0].hostiles[..]; flame := c[0].xc[0].bar[0];
  #assert xc_aim_kind(c[..], flame).kind == XC_AIM_CONE;
  g[0].enemies[0].x = 4; g[0].enemies[0].z = 4;      // 45 degrees off: outside the cone
  c[0].creator[0].clock = 5;
  #assert !xc_press(c[..], 0) && c[0].xc[0].fizzle == 0 && c[0].xc[0].casts == 0;
  g[0].enemies[0].x = 1; g[0].enemies[0].z = 8;      // 7 degrees off: inside
  #assert xc_aim(c[..], flame).foe == 0;
}
#test "experimental combat: Thunderwave's cube follows the facing direction" #steps 2000000000 {
  // Thunderwave's cube is set ahead of you; Second Wind is yours
  w: [1] EgZone; xc_test_lab(w[..], FB_CL_WIZARD, 1.5707963);
  tw := xc_aim(w[..], w[0].xc[0].bar[4]); #assert tw.kind == XC_AIM_AREA && tw.fx > 0.99 && abs(tw.reach - 4.572) < 0.01;
}
#test "experimental combat: a melee class holds its weapon, and a blow lands where its blade meets a monster, not at the press" #steps 2000000000 {
  #assert xc_kit(FB_CL_BARBARIAN) == 0 && cc.CC_KIT_TWO[0] && xc_kit(FB_CL_FIGHTER) == 1 && xc_kit(FB_CL_PALADIN) == 2;
  #assert xc_kit(FB_CL_RANGER) == XC_KIT_BOW && xc_kit(FB_CL_ROGUE) == 3 && xc_kit(FB_CL_MONK) == -1 && xc_kit(FB_CL_WIZARD) == -1 && xc_kit(FB_CL_CLERIC) == -1;
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_PALADIN, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 1.2;   // just ahead, in reach
  hp := xc_hp_sum(s[..]);
  tries := 0;
  while s[0].xc[0].landed == 0 && tries < 40 {
    s[0].creator[0].clock += 1.1 + figs.bd_seconds(figs.BD_SLASH);   // past the cooldown, which starts when the last blow landed
    #assert xc_press(s[..], 1);
    // the swing has begun (the slash clip, an action), the blow not yet landed: no one is hurt at the press
    #assert s[0].xc[0].pend == 1 && s[0].creator[0].swing_clip == figs.BD_SLASH && s[0].creator[0].swing_at == s[0].creator[0].clock;
    #assert s[0].xc[0].swing.phase == act.ActionPhase.running && act.action_admit(s[0].xc[0].swing_def) == act.ActionStatus.ok;
    #assert xc_hp_sum(s[..]) == hp || tries > 0;
    // through the swing it lands, once
    c0 := s[0].xc[0].contacts;
    s[0].creator[0].clock += figs.bd_seconds(figs.BD_SLASH) + 0.05; xc_strike_due(s[..]);
    #assert s[0].xc[0].pend == -1 && s[0].xc[0].contacts == c0 + 1;
    s[0].creator[0].clock -= figs.bd_seconds(figs.BD_SLASH) + 0.05;
    tries += 1;
  }
  #assert s[0].xc[0].landed == 1 && xc_hp_sum(s[..]) < hp && s[0].xc[0].fallbacks > 0;
}
#test "experimental combat: two-handed weapons use the owned cleave's impact timing" #steps 2000000000 {
  // the Barbarian's greataxe and the Fighter's greatsword swing the owned two-handed cleave, its impact the action's
  t: [1] EgZone; xc_test_lab(t[..], FB_CL_BARBARIAN, 0); t[0].creator[0].clock = 5;
  #assert xc_press(t[..], 1) && t[0].creator[0].swing_clip == figs.BD_OWN + figs.TWOHAND_AXE_CLEAVE && t[0].creator[0].weapon == 0;
  d := t[0].xc[0].swing_def;
  #assert d.events[1].kind == act.ActionEventKind.impact && d.events[1].tick == cast(int) floor(f64(figs.BD_OWN_IMPACT) * f64(d.length) + 0.5);
  #assert d.length == act.action_ticks_of_seconds(f64(figs.bd_seconds(figs.BD_OWN + figs.TWOHAND_AXE_CLEAVE)));
  xc_test_lab(t[..], FB_CL_FIGHTER, 0); t[0].creator[0].clock = 9; t[0].xc[0].pend = -1;
  #assert xc_press(t[..], 1) && t[0].creator[0].swing_clip == figs.BD_OWN + figs.TWOHAND_SWORD_CLEAVE && t[0].creator[0].weapon == 1;
}
#test "experimental combat: a caster's spell resolves without a weapon swing" #steps 2000000000 {
  // a caster's spell resolves at once, with no swing
  w: [1] EgZone; xc_test_lab(w[..], FB_CL_WIZARD, 0); w[0].creator[0].clock = 5;
  #assert xc_press(w[..], 0) && w[0].xc[0].pend == -1 && w[0].creator[0].swing_clip == -1;
}

#test "experimental combat level progression" {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N {
    for level: 1..<7 {
      n := xc_bar_level(c, level, bar[..]);
      #assert n > 0 && n <= XC_SLOTS;
      #assert bar[0].kind == fb_cl_ability(c).kind;
      hero := fb_cl_hero(c, "You", 0, level);
      for i: 0..<n { if bar[i].kind == FB_SPELL { #assert rs_spell_ready(hero, bar[i].sp); } }
    }
  }
  n1 := xc_bar_level(FB_CL_WIZARD, 1, bar[..]);
  for i: 0..<n1 { #assert bar[i].sp != SP_SCORCHING_RAY && bar[i].sp != SP_FIREBALL; }
  n3 := xc_bar_level(FB_CL_WIZARD, 3, bar[..]); found := false;
  for i: 0..<n3 { if bar[i].sp == SP_SCORCHING_RAY { found = true; } #assert bar[i].sp != SP_FIREBALL; }
  #assert found;
  n5 := xc_bar_level(FB_CL_WIZARD, 5, bar[..]); found = false;
  for i: 0..<n5 { if bar[i].sp == SP_FIREBALL { found = true; } }
  #assert found;
  n2 := xc_bar_level(FB_CL_FIGHTER, 2, bar[..]); found = false;
  for i: 0..<n2 { if bar[i].kind == FB_SURGE { found = true; } }
  #assert found;
}

#test "experimental combat changing level preserves class and monsters" {
  x: [1] XcCombat; xc_start(x[..], FB_CL_FIGHTER);
  x[0].b[0].c[1].hp = 3;
  xc_set_level(x[..], 5);
  #assert x[0].klass == FB_CL_FIGHTER && x[0].level == 5 && x[0].b[0].c[0].level == 5;
  #assert x[0].b[0].c[1].hp == 3;
  xc_set_level(x[..], 7);
  #assert x[0].level == 5;
  xc_set_class(x[..], FB_CL_WIZARD);
  #assert x[0].level == 5 && x[0].b[0].c[0].level == 5;
}

#test "experimental combat level selector and multirow hotbar" {
  s: [1] EgZone; xc_start(s[0].xc[..], FB_CL_WIZARD);
  x := s[0].xc[..]; x[0].seen = true; x[0].k = 1; x[0].w = 1200; x[0].h = 800;
  l := cm_pick_box(xc_pick(s[..]), CM_LEVEL, 3);
  #assert xc_pointer(s[..], (l.x0 + l.x1) / 2, (l.y0 + l.y1) / 2, 0, 1);
  #assert xc_pointer(s[..], (l.x0 + l.x1) / 2, (l.y0 + l.y1) / 2, 2, 1);
  #assert x[0].level == 3 && x[0].b[0].c[0].level == 3;
  x[0].bar_n = 12;
  a := cc.eg_box4(xc_slot(x, 0)); b := cc.eg_box4(xc_slot(x, 9));
  #assert a.y0 < b.y0 && a.x0 >= 0 && b.x1 <= x[0].w;
  x[0].open = false; l = cm_pick_box(xc_pick(s[..]), CM_LEVEL, 6);
  #assert xc_pointer(s[..], (l.x0 + l.x1) / 2, (l.y0 + l.y1) / 2, 0, 1);
  #assert xc_pointer(s[..], (l.x0 + l.x1) / 2, (l.y0 + l.y1) / 2, 2, 1);
  #assert x[0].level == 6;
}

#test "experimental combat shift drag swaps keys without casting and cancels safely" {
  s: [1] EgZone; s[0].creator[0].experimental = true; xc_start(s[0].xc[..], FB_CL_WIZARD);
  x := s[0].xc[..]; x[0].seen = true; x[0].k = 1; x[0].w = 1200; x[0].h = 800;
  a := cc.eg_box4(xc_slot(x, 0)); b := cc.eg_box4(xc_slot(x, 1)); first := x[0].bar[0].sp; second := x[0].bar[1].sp;
  s[0].shift = true;
  #assert xc_pointer(s[..], a.x0 + 3, a.y0 + 3, 0, 7);
  #assert xc_pointer(s[..], b.x0 + 3, b.y0 + 3, 1, 7);
  #assert xc_pointer(s[..], b.x0 + 3, b.y0 + 3, 2, 7);
  #assert x[0].bar[0].sp == second && x[0].bar[1].sp == first && x[0].casts == 0;
  #assert xc_art(x[0].bar[1], 1) == rs_spell(first).id && xc_draw_slot_key(1, xc_art(x[0].bar[1], 1));
  #assert xc_pointer(s[..], a.x0 + 3, a.y0 + 3, 0, 8);
  #assert xc_pointer(s[..], 600, 200, 2, 8);
  #assert x[0].bar[0].sp == second && x[0].casts == 0;
  #assert xc_pointer(s[..], a.x0 + 3, a.y0 + 3, 0, 9);
  #assert xc_pointer(s[..], b.x0 + 3, b.y0 + 3, 3, 9);
  #assert x[0].bar[0].sp == second && x[0].casts == 0;
  xc_set_level(x, 5); xc_set_level(x, 1);
  #assert x[0].bar[0].sp == second && x[0].bar[1].sp == first;
}

#test "experimental combat hotbar arrangement survives a reload" {
  x: [1] XcCombat; xc_start(x[..], FB_CL_WIZARD); xc_swap(x[..], 0, 1);
  first := x[0].bar[0].sp; second := x[0].bar[1].sp;
  text: [4096] u8; n := xc_order_save(x[..], text[..]); #assert n > 0;
  y: [1] XcCombat; #assert xc_order_load(y[..], cast(string) text[0..<n]);
  xc_start(y[..], FB_CL_WIZARD);
  #assert y[0].bar[0].sp == first && y[0].bar[1].sp == second;
  #assert !xc_order_load(y[..], "xc-bar 1\n999999\n");
  #assert y[0].bar[0].sp == first;
}

#test "experimental combat stores swaps through the host" {
  // one Lab at a time: the message and the bar it sets are kept, then the first Lab goes
  msg: [OUTBOX_CAP] u8; n := 0; sp := 0;
  { s: [1] EgZone; s[0].creator[0].on = true; s[0].creator[0].experimental = true;
    xc_start(s[0].xc[..], FB_CL_WIZARD); xc_swap(s[0].xc[..], 0, 1);
    #assert zone_action(s[..]) == 12 && s[0].out_n > 0;
    n = s[0].out_n; for i: 0..<n { msg[i] = s[0].outbox[i]; } sp = s[0].xc[0].bar[0].sp; }
  t: [1] EgZone; _ := zone_message(t[..], 12, cast(string) msg[0..<n]);
  xc_start(t[0].xc[..], FB_CL_WIZARD);
  #assert t[0].xc[0].bar[0].sp == sp;
}
// One Fighter swing at a monster ahead, the frames dt apart (alternating with dt2): the accepted contacts.
xc_test_swing :: (dt: f32, dt2: f32, foe_z: f32) -> int {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_PALADIN, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0.2; h[0].enemies[0].z = foe_z; h[0].enemies[1].x = -0.3; h[0].enemies[1].z = foe_z;
  s[0].creator[0].clock = 3;
  if !xc_press(s[..], 1) { return -1; }
  i := 0;
  while s[0].xc[0].pend >= 0 && i < 2000 { s[0].creator[0].clock += ifx i % 2 == 0 then dt else dt2; xc_strike_due(s[..]); i += 1; }
  return s[0].xc[0].contacts * 100 + s[0].xc[0].whiffs;
}
#test "experimental combat: one swing makes one contact at 30, 60 and 144 FPS" #steps 2000000000 {
  #assert xc_test_swing(1.0 / 30, 1.0 / 30, 1.2) == 100;
  #assert xc_test_swing(1.0 / 60, 1.0 / 60, 1.2) == 100;
  #assert xc_test_swing(1.0 / 144, 1.0 / 144, 1.2) == 100;
}
#test "experimental combat: one swing makes one contact over uneven frames and a stall; out of reach it whiffs" #steps 2000000000 {
  #assert xc_test_swing(0.004, 0.051, 1.2) == 100;
  #assert xc_test_swing(2.0, 2.0, 1.2) == 100;      // the whole swing in one frame: caught up tick by tick
  #assert xc_test_swing(1.0 / 60, 1.0 / 60, 3.5) == 1;   // out of the blade's reach: the air
}

#test "experimental Dash sprints its Speed past the run, steers, and ends after its time" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_BARBARIAN, 0.5); cr := s[0].creator[..]; x := s[0].xc[..];
  base := zone_move_scale(s[..]); speed := x[0].b[0].c[0].speed;
  dash := -1; for i: 0..<x[0].bar_n { if x[0].bar[i].kind == FB_DASH { dash = i; } }
  #assert dash >= 0 && xc_press(s[..], dash) && sprint.sprint_on(x[0].dash[0], cr[0].clock);
  input := zone_move_in(s[..]);
  #assert input.key_y == 1 && input.key_x == 0 && input.run && input.link_flags & 512 != 0;
  #assert zone_move_world(s[..], 0, 0).link_flags & 512 != 0;
  #assert abs(input.theta - (0.5 - 3.14159265)) < 0.001;
  // a sixtieth of a second at a time: the run's metres the sprint adds (7.5 m/s at your Speed's scale)
  extra: f32 = 0; peak: f32 = 0; dt := 1.0f32 / 60;
  for k: 0..<120 {
    rate := zone_move_scale(s[..]); extra += 7.5 * (rate - base) * dt; if rate > peak { peak = rate; }
    cr[0].clock += dt; xc_sprint_frame(s[..]);
  }
  // the SRD's extra movement, your Speed in feet as metres, at about twice the run at its peak
  #assert abs(extra - f32(speed) * 0.3048) < 0.15 && peak > base * 1.85 && peak < base * 1.95;
  // ended after its 1.8 s: your own keys again, at your run
  #assert !sprint.sprint_on(x[0].dash[0], cr[0].clock) && zone_move_scale(s[..]) == base && cr[0].stride > 1;
  input = zone_move_in(s[..]); #assert input.link_flags & 512 == 0 && input.key_y == 0;
  // steered: D held while it runs turns it to your right, a little at a time
  cr[0].clock += 1; cr[0].yaw = 0; #assert xc_press(s[..], dash);
  face := x[0].dash[0].face; s[0].held = HOLD_D;
  for k: 0..<6 { cr[0].clock += dt; xc_sprint_frame(s[..]); }
  #assert x[0].dash[0].face != face && abs(x[0].dash[0].face - face) <= 6 * dt * f32(sprint.SPRINT_TURN) + 0.001;
  #assert abs(zone_move_in(s[..]).theta - (x[0].dash[0].face - 3.14159265)) < 0.001;
  // down, it carries you no more
  s[0].held = 0; cr[0].hostiles[0].hp = 0; xc_sprint_frame(s[..]); #assert !sprint.sprint_on(x[0].dash[0], cr[0].clock) && zone_move_in(s[..]).link_flags & 512 == 0;
}
#test "experimental Dash kicks up dust behind you as it runs" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_ROGUE, 0); cr := s[0].creator[..]; x := s[0].xc[..];
  dash := -1; for i: 0..<x[0].bar_n { if x[0].bar[i].kind == FB_DASH { dash = i; } }
  fxp_clear(s[0].puffs[..]); #assert dash >= 0 && xc_press(s[..], dash);
  // standing still here, each puff joins the last (fxp_start's merge); on the move each is its own
  before := s[0].puffs[0].started + s[0].puffs[0].merged;
  for k: 0..<30 { cr[0].clock += 1.0f32 / 60; xc_sprint_frame(s[..]); }
  #assert s[0].puffs[0].started + s[0].puffs[0].merged - before >= 4;
}

#test "no two abilities a class has at once share a cast sound, at every level 1 to 6, and every sound exists" {
  bar: [XC_SLOTS] FbAb;
  for c: 0..<FB_CL_N {
    for level: 1..<7 {
      n := xc_bar_level(c, level, bar[..]);
      for i: 0..<n {
        d := xc_sound(bar[i], c);
        #assert d.start.count > 0 && d.rate >= 0.5 && d.rate <= 2;
        for name: [4] string.[d.start, d.layer, d.hit, d.miss] {
          if name.count > 0 { #assert exsound.sfx_id(name) >= 0 || exsound.xsfx_id(name) >= 0; }
        }
        for j: 0..<i { #assert xc_sound(bar[j], c).start != d.start; }
      }
    }
  }
  // the ones the owner named sound as asked
  #assert xc_spell_sound(SP_FIRE_BOLT).start == "fire-cast" && xc_spell_sound(SP_FIRE_BOLT).hit == "fire-hit";
  #assert xc_spell_sound(SP_RAY_OF_FROST).start == "frost-cast" && xc_spell_sound(SP_ELDRITCH_BLAST).rate < 1;
  #assert xc_spell_sound(SP_SACRED_FLAME).start == "choir" && xc_spell_sound(SP_GUIDING_BOLT).start == "radiant";
  #assert xc_spell_sound(SP_THUNDERWAVE).layer == "thunder" && xc_spell_sound(SP_VICIOUS_MOCKERY).start == "psychic-cast";
  #assert xc_spell_sound(SP_CURE_WOUNDS).start == "heal" && xc_spell_sound(SP_FIRE_BOLT).miss == "fizzle";
  axe := xc_sound(xc_attack(), FB_CL_BARBARIAN); sword := xc_sound(xc_attack(), FB_CL_PALADIN); great := xc_sound(xc_attack(), FB_CL_FIGHTER);
  #assert axe.start == "swing-heavy" && axe.hit == "hit-heavy" && axe.rate < great.rate && sword.start == "swing" && sword.hit == "hit";
  rage: FbAb; rage.kind = FB_RAGE; second: FbAb; second.kind = FB_SECOND;
  #assert xc_sound(rage, FB_CL_BARBARIAN).start == "rage-roar" && xc_sound(second, FB_CL_FIGHTER).start == "second-wind";
}

// One diagonal facing of Thunderwave's forward cube. A check each (#13115): one check made all four
// Labs, 92,437,704 traversal visits, 69% of the limit on its own.
xc_thunderwave_diagonal :: (turn: int) -> bool #effects(all) {
  s: [1] EgZone; face := 0.78539816 + f32(turn)*1.5707963; xc_test_lab(s[..], FB_CL_WIZARD, face);
  h := s[0].creator[0].hostiles[..]; fx := sin(face); fz := cos(face); rx := fz; rz := -fx;
  // Three creatures in a broad fan ahead, one at the shoulder, and one safely behind.
  h[0].enemies[0].x = fx*2; h[0].enemies[0].z = fz*2;
  h[0].enemies[1].x = fx*2+rx*1.2; h[0].enemies[1].z = fz*2+rz*1.2;
  h[0].enemies[2].x = fx*2-rx*1.2; h[0].enemies[2].z = fz*2-rz*1.2;
  h[0].enemies[3].x = rx*1.2; h[0].enemies[3].z = rz*1.2;
  h[0].enemies[4].x = -fx*2; h[0].enemies[4].z = -fz*2;
  s[0].creator[0].clock = 10; #assert xc_press(s[..], 4);
  for i: 0..<4 { #assert s[0].xc[0].b[0].c[i+1].hp < s[0].xc[0].b[0].c[i+1].hp_max; }
  #assert s[0].xc[0].b[0].c[5].hp == s[0].xc[0].b[0].c[5].hp_max;
  #assert s[0].xc[0].b[0].c[5].x == xc_square(h[0].enemies[4].x) && s[0].xc[0].b[0].c[5].y == xc_square(h[0].enemies[4].z);
  return true;
}
#test "experimental Thunderwave hits the whole forward cube at diagonal facings (1 of 4)" #steps 2000000000 { #assert xc_thunderwave_diagonal(0); }
#test "experimental Thunderwave hits the whole forward cube at diagonal facings (2 of 4)" #steps 2000000000 { #assert xc_thunderwave_diagonal(1); }
#test "experimental Thunderwave hits the whole forward cube at diagonal facings (3 of 4)" #steps 2000000000 { #assert xc_thunderwave_diagonal(2); }
#test "experimental Thunderwave hits the whole forward cube at diagonal facings (4 of 4)" #steps 2000000000 { #assert xc_thunderwave_diagonal(3); }

#test "experimental Thunderwave pushes a creature that fails its save in the scene" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  h := s[0].creator[0].hostiles[..]; b := s[0].xc[0].b[..];
  b[0].c[1].score[RS_CON] = 1; pushed := false;
  for attempt: 0..<12 {
    h[0].enemies[0].x = 0; h[0].enemies[0].z = 2; h[0].enemies[0].dead = false;
    b[0].c[1].hp = b[0].c[1].hp_max; b[0].c[1].dead = false;
    s[0].creator[0].clock += 1.1; #assert xc_press(s[..], 4);
    if h[0].enemies[0].z > 2.1 { pushed = true; break; }
  }
  #assert pushed;
}

#test "experimental Thunderwave area outline matches every grid square it can hit" {
  s: [1] EgZone; xc_start(s[0].xc[..], FB_CL_WIZARD);
  for turn: 0..<4 {
    face := f32(turn)*0.78539816; wave := aa.area_face(xk_spell_area(SP_THUNDERWAVE), 4, -6, face);
    b := s[0].xc[0].b[..]; z := rs_area(b, 0, rs_spell(SP_THUNDERWAVE), XC_MID, XC_MID+3);
    for side: -4..<5 { for forward: -3..<6 {
      wx := wave.x + f32(side)*f32(XC_SQ)*wave.fz + f32(forward)*f32(XC_SQ)*wave.fx;
      wz := wave.z - f32(side)*f32(XC_SQ)*wave.fx + f32(forward)*f32(XC_SQ)*wave.fz;
      #assert aa.area_aim_contains(wave, wx, wz) == rs_inside(z, XC_MID+side, XC_MID+forward);
    } }
  }
}

#test "experimental Thunderwave shows its cast area and keeps it at the cast position" {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WIZARD, 0.78539816);
  s[0].creator[0].clock = 4; #assert xc_press(s[..], 4);
  #assert s[0].xc[0].wave_until > 4 && s[0].xc[0].wave.x == 0 && s[0].xc[0].wave.z == 0;
  #assert abs(s[0].xc[0].wave.fx - sin(0.78539816f32)) < 0.001;
  s[0].creator[0].player_x = 10; #assert s[0].xc[0].wave.x == 0;
}
#test "experimental combat: your target is held by attention, never picked for you, kept through the grace and dropped when it falls" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WIZARD, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 6; h[0].enemies[1].x = 0.5; h[0].enemies[1].z = 3;
  // a monster near and ahead is not your target until you strike at it
  s[0].creator[0].clock = 2; xc_lock_step(s[..]); #assert s[0].xc[0].target == -1;
  xc_lock_on(s[..], 0); xc_lock_step(s[..]);
  #assert s[0].xc[0].target == 0 && s[0].xc[0].lock.reason == attn.AttnReason.kept && s[0].xc[0].lock.runner == -1;
  // behind you and 20 m off: still yours
  h[0].enemies[0].z = -20; s[0].creator[0].clock += 0.5; xc_lock_step(s[..]); #assert s[0].xc[0].target == 0;
  // past 24 m: held through the second's grace, then let go, and the near one is not taken instead
  h[0].enemies[0].z = -30; s[0].creator[0].clock += 0.5; xc_lock_step(s[..]);
  #assert s[0].xc[0].target == 0 && s[0].xc[0].lock.reason == attn.AttnReason.out_of_range;
  s[0].creator[0].clock += 0.3; xc_lock_step(s[..]); #assert s[0].xc[0].target == 0;    // 51 ticks lost: within the grace
  s[0].creator[0].clock += 0.2; xc_lock_step(s[..]); #assert s[0].xc[0].target == -1;   // 64: let go
  // back in reach after the release: nothing is acquired for you
  h[0].enemies[0].z = 4; s[0].creator[0].clock += 0.1; xc_lock_step(s[..]); #assert s[0].xc[0].target == -1;
  // a fallen target is dropped at once, with no grace
  xc_lock_on(s[..], 1); xc_lock_step(s[..]); #assert s[0].xc[0].target == 1;
  h[0].enemies[1].dead = true; s[0].creator[0].clock += 1.0 / 64; xc_lock_step(s[..]);
  #assert s[0].xc[0].target == -1 && s[0].xc[0].lock.reason == attn.AttnReason.invalid;
}
#test "experimental combat: a landed blow holds the struck monster for its hit stop, a monster's landed blow holds it, and nothing else pauses" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_PALADIN, 0);
  h := s[0].creator[0].hostiles[..]; h[0].enemies[0].x = 0; h[0].enemies[0].z = 1.2;
  hp := xc_hp_sum(s[..]); tries := 0; stopped := false;
  while xc_hp_sum(s[..]) == hp && tries < 40 {
    s[0].creator[0].clock += 1.1; #assert xc_press(s[..], 1);
    for f: 0..<60 { s[0].creator[0].clock += 1.0 / 60; xc_strike_due(s[..]); xc_stops_step(s[..]); if h[0].enemies[0].stopped { stopped = true; break; } }
    tries += 1;
  }
  // struck and alive: it is held, for XC_STOP_STRUCK ticks, and the other monsters are not
  if s[0].xc[0].b[0].c[1].hp > 0 {
    #assert stopped && s[0].xc[0].stops.n == 1 && s[0].xc[0].target == 0;
    for i: 1..<XC_FOES { #assert !h[0].enemies[i].stopped; }
    s[0].creator[0].clock += f32(XC_STOP_STRUCK + 1) / 64; xc_stops_step(s[..]);
    #assert !h[0].enemies[0].stopped && s[0].xc[0].stops.n == 0;
  }
  // a monster's blow that lands on you holds that monster (the striker) for XC_STOP_STRIKER ticks
  h[0].last = 3; h[0].hits += 1; xc_stops_step(s[..]);
  #assert h[0].enemies[3].stopped && !h[0].enemies[0].stopped;
  s[0].creator[0].clock += f32(XC_STOP_STRIKER) / 64; xc_stops_step(s[..]); #assert !h[0].enemies[3].stopped;
  // the same landed blow is given its stop once
  xc_stops_step(s[..]); #assert !h[0].enemies[3].stopped && s[0].xc[0].stops.n == 0;
}
#test "experimental combat: numbers go through the presentation queue, capped a source a frame and counted" {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_WIZARD, 0); x := s[0].xc[..];
  for i: 0..<10 { _ := cc.eg_numbers_amount(x[0].floats[..], 0, f32(i), meadow_y(f32(i), 0) + 1.9, 0, 1, false, false, false, 3 + i); }
  fs := x[0].floats[0];
  #assert fs.shown == fs.per_source && fs.suppressed == 10 - fs.per_source;
  // another source has its own share; the next frame starts empty
  was := fs.suppressed;
  _ := cc.eg_numbers_word(x[0].floats[..], 4, 0, meadow_y(0, 0) + 1.9, 0, 1, "MISS", false); #assert x[0].floats[0].shown == fs.per_source + 1;
  cc.eg_numbers_frame(x[0].floats[..]);
  _ = cc.eg_numbers_amount(x[0].floats[..], 0, 0, meadow_y(0, 0) + 1.9, 0, 2, false, false, false, 7); #assert x[0].floats[0].shown == fs.per_source + 2 && x[0].floats[0].suppressed == was;
}

#test "experimental combat: Stunned hostiles can move but cannot attack and restraint preserves separate action permission" {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_WIZARD,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  h[0].enemies[0].swing=0.34;
  #assert rs_put_effect(b,1,RsEffect.{kind=EF_COND,cond=RS_STUNNED,by=0,spell=-1,until=60,save=-1});
  xc_sync_permissions(s[..]);
  #assert !h[0].enemies[0].held && h[0].enemies[0].inactive && h[0].enemies[0].swing<0;
  for i: 1..<XC_FOES { h[0].enemies[i].dead=true; }
  h[0].enemies[0].x=4; h[0].enemies[0].z=0;
  hostile.hostile_tick(h,0,0,0,0.05);
  #assert h[0].enemies[0].moving && h[0].enemies[0].x<4 && h[0].hits==0;
  rs_drop_effect(b,1,0);
  #assert rs_put_effect(b,1,RsEffect.{kind=EF_COND,cond=RS_RESTRAINED,by=0,spell=-1,until=60,save=-1});
  xc_sync_permissions(s[..]);
  #assert h[0].enemies[0].held && !h[0].enemies[0].inactive && h[0].enemies[0].swing<0;
  rs_drop_effect(b,1,0); xc_sync_permissions(s[..]);
  #assert !h[0].enemies[0].held && !h[0].enemies[0].inactive;
}

#test "experimental combat: each body kind fights as its SRD stat block" {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_FIGHTER,0);
  b := s[0].xc[0].b[..];
  for i: 0..<XC_FOES {
    k := hostile.hostile_kind(i); c := b[0].c[i+1]; blk := rs_monster_block(XC_FOE_BLOCK[k]);
    #assert c.ac==blk.ac && c.hp_max==blk.hp && rs_size(c)==blk.size && c.klass==RS_MONSTER && c.immune==blk.immune && c.speed==blk.speed;
    #assert cast(string)c.name[0..<c.name_n]==XC_FOE_TITLE[k] && hostile.hostile_blow(k).hp==blk.hp && hostile.hostile_blow(k).ac==blk.ac;
  }
  #assert xc_hostile_action(xdungeon.DG_KIND_BOSS).count==2 && !rs_stat_action_valid(xc_hostile_action(5)) && !rs_stat_action_valid(xc_hostile_action(-1));
  #assert xc_hostile_attack(xdungeon.DG_KIND_GREMLIN).name=="Scimitar" && xc_hostile_attack(xdungeon.DG_KIND_BOSS).name=="Tree Club";
  #assert xc_foe(9).ac==15 && hostile.hostile_shot(xdungeon.DG_KIND_IMP)==0 && hostile.hostile_shot(xdungeon.DG_KIND_GREMLIN)>24;
}

// ---- the bow's checks (docs/verse/bow-combat.md)
// A Ranger at the spawn facing +z, the camera behind and above, looking along `fwd`.
xc_test_bow :: (s: [] EgZone, fwd: [3] f32) {
  xc_test_lab(s, FB_CL_RANGER, 0);
  x := s[0].xc[..]; cr := s[0].creator[..];
  cr[0].yaw = -3.14159265; cr[0].clock = 10;
  x[0].seen = true; x[0].u[16] = 0; x[0].u[17] = meadow_y(0, 0) + 2.0; x[0].u[18] = -2.5;
  x[0].u[20] = fwd[0]; x[0].u[21] = fwd[1]; x[0].u[22] = fwd[2]; x[0].u[23] = 640; x[0].u[27] = 345;
}
xc_test_fly :: (s: [] EgZone, seconds: f32) {
  for k: 0..<cast(int) (seconds * 60) { s[0].creator[0].clock += 1.0 / 60; xc_bow_step(s, 1.0 / 60); }
}
#test "experimental combat: a Ranger holds the longbow, its Attack is a shot, and Fighters keep their blades" {
  #assert xc_kit(FB_CL_RANGER) == XC_KIT_BOW && cc.CC_KIT_MESH[XC_KIT_BOW] == 4 && !cc.CC_KIT_TWO[XC_KIT_BOW] && xc_kit(FB_CL_ROGUE) == 3 && xc_kit(FB_CL_FIGHTER) == 1;
  #assert rs_weapon(W_LONGBOW).dice == 1 && rs_weapon(W_LONGBOW).sides == 8 && rs_weapon(W_LONGBOW).range_ft == 150 && rs_weapon(W_LONGBOW).long_ft == 600;
  { s: [1] EgZone; xc_test_bow(s[..], [3] f32.[0, -0.05, 1]);
  #assert xc_has_bow(s[..]) && s[0].xc[0].b[0].c[0].ranged == W_LONGBOW;
  // a key's press draws and looses itself at full draw
  slot := xc_slot_of(s[0].xc[..], FB_ATTACK); #assert slot >= 0 && xc_press(s[..], slot) && s[0].xc[0].ar[0].draw[0].on && s[0].xc[0].ar[0].draw[0].self_loose;
  xc_test_fly(s[..], 0.5); #assert s[0].xc[0].ar[0].shots == 0 && s[0].creator[0].aim > 0.9;
  xc_test_fly(s[..], 0.4); #assert s[0].xc[0].ar[0].shots == 1 && !s[0].xc[0].ar[0].draw[0].on; }
  t: [1] EgZone;   // after the first Lab is gone: two at once is most of the check's value slots xc_test_lab(t[..], FB_CL_FIGHTER, 0); #assert !xc_has_bow(t[..]) && !xc_bow_begin(t[..], false);
}
#test "experimental combat: held and let go at a Goblin, the arrow arcs to it and the Longbow's 1d8 + Dex lands" #steps 800000000 {
  s: [1] EgZone; xc_test_bow(s[..], [3] f32.[0, -0.04, 1]);
  x := s[0].xc[..]; h := s[0].creator[0].hostiles[..]; b := x[0].b[..];
  g := 3; h[0].enemies[g].x = 0; h[0].enemies[g].z = 20; b[0].c[1 + g].ac = 1; before := b[0].c[1 + g].hp; b[0].c[1 + g].hp = 40; b[0].c[1 + g].hp_max = 40;
  #assert xc_bow_begin(s[..], false) && !x[0].ar[0].draw[0].self_loose;
  xc_test_fly(s[..], 1.0); #assert s[0].creator[0].aim == 1 && xc_bow_pace(s[..]) < 0.5;
  aim := xc_bow_point(s[..]); #assert aim.foe == g;
  #assert xc_bow_loose(s[..]) && x[0].ar[0].shots == 1;
  // in the air: above the straight line from the hand, then on the Goblin
  xc_test_fly(s[..], 0.25);
  a := x[0].ar[0].arrows[0].a[0]; #assert a.state == bow.ARROW_FLYING && a.aim == g;
  xc_test_fly(s[..], 1.0);
  lost := 40 - b[0].c[1 + g].hp;
  #assert x[0].bow_hits == 1 && x[0].bow_misses == 0 && lost >= 1 + 3 && lost <= 16 + 3 && x[0].ar[0].arrows[0].hits == 1 && x[0].bow_far == 0;
  #assert before > 0;
}
#test "experimental combat: a miss is shown and flies on past; a shot past 150 feet is the Longbow's long range" #steps 800000000 {
  s: [1] EgZone; xc_test_bow(s[..], [3] f32.[0, -0.02, 1]);
  x := s[0].xc[..]; h := s[0].creator[0].hostiles[..]; b := x[0].b[..];
  g := 3; h[0].enemies[g].x = 0; h[0].enemies[g].z = 18; b[0].c[1 + g].ac = 60;
  #assert xc_bow_begin(s[..], false); xc_test_fly(s[..], 1.0); #assert xc_bow_loose(s[..]);
  xc_test_fly(s[..], 1.0);
  #assert x[0].bow_misses == 1 && x[0].bow_hits == 0 && x[0].ar[0].arrows[0].a[0].passed == g && x[0].refused == 0;
  shown := false; for i: 0..<fl.FLOATS { if x[0].floats[0].items[i].on && fl.floats_text(x[0].floats[..], i) == "miss" { shown = true; } } #assert shown;
  // 60 m off (197 feet): past the normal range, so the roll is at Disadvantage (battle.coax rs_strike)
  h[0].enemies[g].z = 60; b[0].c[1 + g].ac = 1; x[0].cool_at = -100;
  #assert xc_bow_squares(s[..], g) == 39;
  #assert xc_bow_strike(s[..], g) || x[0].bow_misses == 2;
  #assert x[0].bow_far == 1;
}
#test "experimental combat: an arrow into the ground sticks, then fades; a short draw falls short; Escape looses nothing" #steps 800000000 {
  s: [1] EgZone; xc_test_bow(s[..], [3] f32.[0, -0.45, 0.89]);
  x := s[0].xc[..];
  #assert xc_bow_begin(s[..], false); xc_test_fly(s[..], 1.0); #assert xc_bow_loose(s[..]);
  xc_test_fly(s[..], 1.5);
  a := x[0].ar[0].arrows[0].a[0]; #assert a.state == bow.ARROW_STUCK && x[0].ar[0].stuck == 1 && abs(a.at[1] - meadow_y(a.at[0], a.at[2])) < 0.3;
  full := a.at[2];
  xc_test_fly(s[..], f32(bow.ARROW_STAY) - 1.6); #assert bow.arrow_alpha(x[0].ar[0].arrows[0].a[0], s[0].creator[0].clock) == 1;
  xc_test_fly(s[..], f32(bow.ARROW_FADE) + 1.7); #assert x[0].ar[0].arrows[0].a[0].state == bow.ARROW_FREE;
  // looking level, a full draw carries far; a tenth of a second's draw comes down within a few metres
  x[0].u[21] = 0; x[0].u[22] = 1; x[0].cool_at = -100;
  #assert xc_bow_begin(s[..], false); xc_test_fly(s[..], 0.05); #assert xc_bow_loose(s[..]);
  xc_test_fly(s[..], 2.0);
  short := x[0].ar[0].arrows[0].a[0]; #assert short.state == bow.ARROW_STUCK && short.at[2] < 14 && short.strength < 0.3 && full > 0;
  x[0].cool_at = -100; #assert xc_bow_begin(s[..], false) && xc_key(s[..], -1) && !x[0].ar[0].draw[0].on && x[0].ar[0].draw[0].cancelled == 1;
  xc_test_fly(s[..], 1.0); #assert x[0].ar[0].shots == 2 && s[0].creator[0].aim == 0;
}
#test "experimental combat: a Goblin shoots from past its reach and a Hill Giant's contact is two attacks" #steps 400000000 {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_BARBARIAN,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].dice[0].fixed=true; b[0].c[0].ac=10; b[0].c[0].hp=100; b[0].c[0].hp_max=100; b[0].c[0].temp=0;
  // the gremlin (enemy 3) 10 m off, awake and in sight: its swing is a Shortbow shot
  g := 3; h[0].enemies[g].kind=xdungeon.DG_KIND_GREMLIN; h[0].enemies[g].x=0; h[0].enemies[g].z=10;
  h[0].enemies[g].awake=true; h[0].enemies[g].cool=0; b[0].c[g+1].turn_at=0;
  xc_sync_vitals(s[..]);
  hostile.hostile_tick(h,0,0,0,0.05);
  #assert h[0].enemies[g].shot && h[0].enemies[g].swing==0 && !h[0].enemies[g].moving;
  // its draw is its tell: the arrow leaves the bow at HS_DRAW and flies 30 m/s, so the hit waits for it
  for k: 0..<12 { hostile.hostile_tick(h,0,0,0,0.05); }
  #assert h[0].contacts[0].count==0 && h[0].shots[0].state==hostile.HS_FLYING;
  // the arrow is the shared bow's (aethyr/action/bow.coax), arcing to where you stood
  xc_shots_step(s[..]); #assert h[0].shots[0].shown && fxp_live(s[0].puffs[..])==0 && s[0].xc[0].shot_arrow[0]>0 && s[0].xc[0].ar[0].arrows[0].a[s[0].xc[0].shot_arrow[0]-1].state==bow.ARROW_FLYING;
  for k: 0..<8 { hostile.hostile_tick(h,0,0,0,0.05); }
  #assert h[0].contacts[0].count==1 && h[0].shots[0].state==hostile.HS_LANDING;
  xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==95 && h[0].hits==1;   // 1d6 + 2 Piercing
  #assert h[0].shots[0].state==hostile.HS_LANDED && h[0].shots[0].hit;
  xc_shots_step(s[..]); #assert h[0].shots[0].ended && fxp_live(s[0].puffs[..])==1 && s[0].xc[0].ar[0].arrows[0].a[s[0].xc[0].shot_arrow[0]-1].state==bow.ARROW_HIT;
  hostile.hostile_tick(h,0,0,0,0.05); #assert h[0].shots[0].state==hostile.HS_FREE;
  // (through the world's own tick, the next check)
  // the Hill Giant 2 m off: Tree Club twice, and you are knocked Prone
  boss := -1; for i: 0..<XC_FOES { if hostile.hostile_kind(i)==xdungeon.DG_KIND_BOSS { boss=i; } }
  #assert boss>=0;
  h[0].enemies[g].z= -70; h[0].enemies[boss].kind=xdungeon.DG_KIND_BOSS; h[0].enemies[boss].x=0; h[0].enemies[boss].z=2;
  b[0].c[boss+1].turn_at=0;
  #assert hostile.hc_offer(h[0].contacts[..],boss); xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==61 && rs_has(b[0].c[0],RS_PRONE) && h[0].hits==2;   // 3d8 + 5 twice
}
// Its own check: each monster step far from you gathers the walls afresh, and the two halves
// together came near the traversal budget.
#test "experimental combat: a Goblin's shot is kept through the world's own tick" #steps 400000000 {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_BARBARIAN,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].dice[0].fixed=true; b[0].c[0].ac=10; b[0].c[0].hp=100; b[0].c[0].hp_max=100; b[0].c[0].temp=0;
  g := 3; h[0].enemies[g].kind=xdungeon.DG_KIND_GREMLIN; h[0].enemies[g].x=0; h[0].enemies[g].z=10;
  h[0].enemies[g].awake=true; h[0].enemies[g].cool=0; b[0].c[g+1].turn_at=0;
  xc_sync_vitals(s[..]);
  // through the world's own tick (the bodies proposed, then moved): the shot is kept
  h[0].enemies[g].swing= -1;
  for k: 0..<14 { xc_hostile_tick(s[..],0.05); }
  kept := false; for k: 0..<hostile.HS_SHOTS { if h[0].shots[k].state!=hostile.HS_FREE { kept=true; } }
  #assert kept;
}
// The Hill Giant beside you kills you now (its Tree Club through the shared contact, fixed dice).
xc_test_killed :: (s: [] EgZone) {
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  boss := -1; for i: 0..<XC_FOES { if hostile.hostile_kind(i)==xdungeon.DG_KIND_BOSS { boss=i; } }
  b[0].dice[0].fixed=true; b[0].c[0].ac=1; b[0].c[0].hp=3; b[0].c[0].temp=0; xc_sync_vitals(s);
  h[0].enemies[boss].kind=xdungeon.DG_KIND_BOSS; h[0].enemies[boss].x=0; h[0].enemies[boss].z= -2; b[0].c[boss+1].turn_at=0;
  if hostile.hc_offer(h[0].contacts[..],boss) { xc_hostile_contacts(s); }
}
#test "experimental combat: an arrow loosed before a monster kills you still lands, harms and kills (#13120)" #steps 800000000 {
  s: [1] EgZone; xc_test_bow(s[..], [3] f32.[0, -0.04, 1]);
  x := s[0].xc[..]; h := s[0].creator[0].hostiles[..]; b := x[0].b[..];
  g := 3; h[0].enemies[g].x = 0; h[0].enemies[g].z = 20; b[0].c[1 + g].ac = 1; b[0].c[1 + g].hp = 1;
  #assert xc_bow_begin(s[..], false); xc_test_fly(s[..], 1.0);
  #assert xc_bow_point(s[..]).foe == g && xc_bow_loose(s[..]);
  xc_test_fly(s[..], 0.1); #assert x[0].ar[0].arrows[0].a[0].state == bow.ARROW_FLYING;
  // while it flies, you die
  xc_test_killed(s[..]);
  #assert b[0].c[0].hp == 0 && h[0].hp <= 0 && !rs_can_act(b[0].c[0]);
  kills := x[0].kills;
  xc_test_fly(s[..], 1.0);
  // it reached the Goblin: the Longbow's roll, its damage and the kill, the same as if you stood
  #assert x[0].bow_hits == 1 && x[0].bow_misses == 0 && x[0].ar[0].arrows[0].hits == 1;
  #assert b[0].c[1 + g].hp <= 0 && h[0].enemies[g].dead && x[0].kills == kills + 1;
  // and you are still down: no new draw
  #assert b[0].c[0].hp == 0 && !rs_can_act(b[0].c[0]) && h[0].hp <= 0;
  x[0].cool_at = -100; #assert !xc_press(s[..], xc_slot_of(x, FB_ATTACK)) && !x[0].ar[0].draw[0].on;
}
#test "experimental combat: a blow already swung lands though a monster kills you first; down, nothing new swings (#13120)" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..], FB_CL_PALADIN, 0);
  x := s[0].xc[..]; h := s[0].creator[0].hostiles[..]; b := x[0].b[..];
  h[0].enemies[0].x = 0.2; h[0].enemies[0].z = 1.2; b[0].c[1].ac = 1; b[0].c[1].hp = 30; b[0].c[1].hp_max = 30;
  s[0].creator[0].clock = 3;
  #assert xc_press(s[..], 1) && x[0].pend == 1 && x[0].contacts == 0;
  xc_test_killed(s[..]);
  #assert b[0].c[0].hp == 0 && h[0].hp <= 0;
  i := 0; while x[0].pend >= 0 && i < 2000 { s[0].creator[0].clock += 1.0 / 60; xc_strike_due(s[..]); i += 1; }
  #assert x[0].contacts == 1 && b[0].c[1].hp < 30 && x[0].landed >= 1;
  #assert b[0].c[0].hp == 0 && !rs_can_act(b[0].c[0]);
  s[0].creator[0].clock += 5; refused := x[0].refused;
  #assert !xc_press(s[..], 1) && x[0].refused == refused + 1 && x[0].pend == -1;
}

#test "experimental combat: physical contact uses shared class AC, defenses, temporary HP and the saved player turn" {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_BARBARIAN,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].dice[0].fixed=true; b[0].c[0].ac=10; b[0].c[0].hp=20; b[0].c[0].hp_max=30; b[0].c[0].temp=14;
  h[0].enemies[0].x=0; h[0].enemies[0].z=1; h[0].enemies[0].kind=xdungeon.DG_KIND_IMP;
  b[0].c[1].turn_at=0;
  xc_sync_vitals(s[..]);
  #assert h[0].shared && hostile.hc_offer(h[0].contacts[..],0);
  kept := b[0].turn; seat := s[0].xc[0].seat[0].turn;
  xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==20 && b[0].c[0].temp==2 && h[0].hp==20 && h[0].temp==2;   // Sting: 6 Piercing + 6 Poison
  #assert h[0].contacts[0].count==0 && h[0].hits==1;
  #assert b[0].turn.action==kept.action && s[0].xc[0].seat[0].turn.action==seat.action;
  // A second contact before the actor's next turn cannot obtain another Action.
  rolls := b[0].dice[0].rolled;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].dice[0].rolled==rolls && h[0].hits==1;
  b[0].clock=1.5; b[0].c[0].temp=0; b[0].c[0].resist=1<<RS_PIERCING;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==11 && h[0].hp==11 && h[0].hits==2;   // 3 Piercing + 6 Poison
  b[0].clock=3; b[0].c[0].ac=30; rolls=b[0].dice[0].rolled;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==11 && b[0].dice[0].rolled==rolls+1 && h[0].hits==2;
  #assert !rs_stat_attack_valid(xc_hostile_attack(-1)) && !rs_stat_attack_valid(xc_hostile_attack(5));
  b[0].clock=4.5; b[0].c[0].ac=10; b[0].c[0].immune=1<<RS_POISON;
  #assert hostile.hc_offer(h[0].contacts[..],0); xc_hostile_contacts(s[..]);
  #assert b[0].c[0].hp==8 && h[0].hits==3;   // 3 Piercing, no Poison
}

#test "experimental combat: the Imp is a Fiend for Divine Smite; the Gremlin and Puglins are not" {
  #assert xc_foe(xdungeon.DG_KIND_IMP).fiend && xc_foe(xdungeon.DG_KIND_FIEND).fiend;
