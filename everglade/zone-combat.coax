#test "experimental combat: a monster that walks into a Cleric's Spirit Guardians saves once as it enters" #steps 2000000000 {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_CLERIC,0); xc_set_level(s[0].xc[..],5);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..]; x := s[0].xc[..];
  b[0].dice[0].fixed=true;
  k := -1; for i: 0..<x[0].bar_n { if x[0].bar[i].kind == FB_SPELL && x[0].bar[i].sp == SP_SPIRIT_GUARDIANS { k = i; } }
  #assert k >= 0 && xc_use(s[..],k) && b[0].c[0].conc == SP_SPIRIT_GUARDIANS;
  h[0].enemies[0].x=0; h[0].enemies[0].z=9; h[0].enemies[0].kind=xdungeon.DG_KIND_BRUTE;   // 30 feet off
  b[0].c[1].hp = 60; b[0].c[1].hp_max = 60;
  xc_guardians_step(s[..]); #assert b[0].c[1].hp == 60 && !x[0].guard_in[0];
  h[0].enemies[0].z=3;   // about 10 feet: inside the 15-foot Emanation
  xc_guardians_step(s[..]); lost := 60 - b[0].c[1].hp;
  #assert x[0].guard_in[0] && (lost == 12 || lost == 6);   // 3d8 Radiant, or half on a success
  xc_guardians_step(s[..]); #assert 60 - b[0].c[1].hp == lost;   // still inside: no second save
}

// Every spell on class c's bar at every selector level 1-6, used at a monster just ahead: it resolves
// through the shared engine and plays its own cast sound. Divine Smite needs a melee hit first.
xc_play_kit :: (c: int) {
  s: [1] EgZone; xc_test_lab(s[..],c,0);
  for level: 1..<7 {
    // Each level is a separate preset trial with its initial supplies.
    s[0].xc[0].protection_water_used=false; s[0].xc[0].revivify_diamond_used=false;
    xc_set_level(s[0].xc[..],level);
    x := s[0].xc[..]; b := x[0].b[..]; h := s[0].creator[0].hostiles[..];
    for k: 0..<x[0].bar_n {
      a := x[0].bar[k]; if a.kind != FB_SPELL { continue; }
      h[0].enemies[0].x=0; h[0].enemies[0].z=1.2; h[0].enemies[0].dead=false; b[0].c[1].dead=false; b[0].c[1].hp=500; b[0].c[1].hp_max=500;
      // a fresh monster and caster each press: the last spell's records and slots do not carry over
      rs_end_concentration(b,0,""); for q: 0..<RS_EFFECTS { b[0].c[1].eff[q] = RsEffect.{}; } b[0].c[1].cond = 0;
      for q: 0..<10 { b[0].c[0].slots[q] = b[0].c[0].slots_max[q]; }
      s[0].creator[0].clock += 2; s[0].experimental_audio[0].n = 0;
      // Revivify's monster has just fallen in combat, within Touch
      if a.sp==SP_REVIVIFY { h[0].enemies[0].z=1; rs_damage(b,0,1,b[0].c[1].hp,RS_FORCE,false,-1); h[0].enemies[0].dead=true; }
      ok := xc_use(s[..],k);
      #assert ok == (a.sp != SP_DIVINE_SMITE);
      if ok {
        want := xc_spell_sound(a.sp).start; text := exsound.xs_text(s[0].experimental_audio[..]);
        #assert text.count >= want.count && text[0..<want.count] == want;
      }
    }
  }
}
#test "experimental combat: Bard and Cleric kits' spells resolve and sound at levels 1-6" #steps 4000000000 { xc_play_kit(FB_CL_BARD); xc_play_kit(FB_CL_CLERIC); }
#test "experimental combat: Druid and Paladin kits' spells resolve and sound at levels 1-6" #steps 4000000000 { xc_play_kit(FB_CL_DRUID); xc_play_kit(FB_CL_PALADIN); }
#test "experimental combat: Ranger and Sorcerer kits' spells resolve and sound at levels 1-6" #steps 4000000000 { xc_play_kit(FB_CL_RANGER); xc_play_kit(FB_CL_SORCERER); }
#test "experimental combat: Warlock and Wizard kits' spells resolve and sound at levels 1-6" #steps 4000000000 { xc_play_kit(FB_CL_WARLOCK); xc_play_kit(FB_CL_WIZARD); }

#test "experimental combat: accepted and refused casts preserve actual HP and temporary HP rather than synthetic healing" {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_WIZARD,0);
  b := s[0].xc[0].b[..]; h := s[0].creator[0].hostiles[..];
  b[0].c[0].hp=3; b[0].c[0].temp=7; xc_sync_vitals(s[..]);
  h[0].enemies[0].x=0; h[0].enemies[0].z=4; s[0].creator[0].clock=2;
  #assert xc_press(s[..],0);
  #assert b[0].c[0].hp==3 && b[0].c[0].temp==7 && h[0].hp==3 && h[0].temp==7;
  #assert !xc_press(s[..],0) && b[0].c[0].hp==3 && b[0].c[0].temp==7;
}

#test "experimental combat: quiet NPC turns repeat their saves without physical contact" {
  s: [1] EgZone; xc_test_lab(s[..],FB_CL_WIZARD,0);
  b := s[0].xc[0].b[..]; b[0].dice[0].fixed=true;
  b[0].c[1].turn_at=0; b[0].c[1].round_at=0; b[0].c[1].score[RS_WIS]=30;
  #assert rs_put_effect(b,1,RsEffect.{kind=EF_COND,cond=RS_PARALYZED,by=0,spell=-1,until=60,save=RS_WIS,dc=13});
  xc_hostile_contacts(s[..]); #assert rs_has(b[0].c[1],RS_PARALYZED);
  b[0].clock=1.5; xc_hostile_contacts(s[..]); xc_sync_permissions(s[..]);
  #assert !rs_has(b[0].c[1],RS_PARALYZED) && !s[0].creator[0].hostiles[0].enemies[0].held;
}

#test "experimental combat: healing caps at class HP and False Life never becomes ordinary healing" {
