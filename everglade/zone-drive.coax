// An Everglade zone's wiring for the agent driver (aethyr/agent/drive.coax, GitHub #13095):
// what it lists (you, the imps, gremlins and puglins by their slot in the hostiles' list, so an id
// stays the same while that creature lives, and the horses and dragons by their mount slot), and
// how its world operations turn into a player's input: walking is the keys' forward along the way drv_steer says, a use presses the bar's slot
// as 1 to 9 would (experimental-combat.coax xc_press, a deed the local rules answer), and a mount
// presses E beside the horse or dragon (zone-ride.coax zone_mount_key).
// zone.coax loads this after experimental-combat.coax. The Drive lives in the face (zone_drive_attach),
// not in the zone, so its checks stay inside the compile-time value budget;
// with none attached (the checks) every call here does nothing.

FD_FACE_IDS :: [7] string.["butt-10m", "butt-20m", "butt-30m", "butt-50m", "butt-70m", "sky-14m", "sky-20m"];   // rg_piece order (everglade/range/place.coax)
fd_on :: (s: [] EgZone) -> bool { return s[0].creator[0].experimental && s[0].you_on; }
// The face's Drive, given once at start.
zone_drive_attach :: (s: [] EgZone, d: [] Drive) #export_c #effects(all) { d[0] = Drive.{}; s[0].drive = d; }
// The frame's entities and the bar's slots, after the frame is drawn.
fd_frame :: (s: [] EgZone) {
  if s[0].drive.count == 0 { return; }
  d := s[0].drive; x := s[0].xc[..];
  drv_frame(d, x[0].w, x[0].h, x[0].k, false);
  if !d[0].on || !fd_on(s) { return; }
  h := s[0].creator[0].hostiles[..]; b := x[0].b[..];
  drv_add(d, DRV_PLAYER, "you", -1, FB_CL_NAME[ifx x[0].klass >= 0 && x[0].klass < 12 then x[0].klass else 3], s[0].you_x, s[0].you_y, s[0].you_z, h[0].hp, h[0].max_hp, h[0].hp <= 0);
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    if e.inactive || 1 + i >= b[0].n { continue; }
    k := hostile.hostile_kind(i); name := XC_FOE_NAMES[ifx k >= 0 && k < XC_FOE_NAMES.count then k else 1];
    c := b[0].c[1 + i];
    drv_add(d, DRV_MONSTER, name, i, name, e.x, s[0].you_y, e.z, c.hp, c.hp_max, e.dead);
  }
  m := s[0].creator[0].mounts[..];
  for k: 0..<m[0].n {
    if !m[0].mounts[k].on { continue; }
    dragon := m[0].kind[k] == egm.EG_DRAGON;
    drv_add(d, DRV_MOUNT, ifx dragon then "dragon" else "horse", k, ifx dragon then "Dragon" else "Horse", m[0].mounts[k].x, s[0].you_y, m[0].mounts[k].z, -1, -1, false);
  }
  // the Archery Range's faces (apps/openagents-web/archery-range.coax): its butts by their distance downrange, its sky faces by their height
  if s[0].creator[0].range_on {
    ft := x[0].ar[0].targets[0];
    for i: 0..<ft.n { if i < FD_FACE_IDS.count { f := ft.face[i]; drv_add(d, DRV_OBJECT, FD_FACE_IDS[i], i, FD_FACE_IDS[i], f.x, f.y, f.z, -1, -1, false); } }
  }
  t := drv_trace(d);
  if t.count == 0 || !x[0].started { return; }
  uit_part(t, "bar");
  for i: 0..<x[0].bar_n { r := xc_slot_at(x[0].bar_n, i, x[0].w, x[0].h, x[0].k); uit_add(t, UIT_NONE, UIT_BUTTON, r[0], r[1], r[2], r[3], x[0].bar[i].name); }
}
// The input a world operation makes this frame, in place of the keys' (ok false: none going). A use
// near and facing its target presses the slot it names.
FdIn :: struct { ok: bool; in: EgMoveIn; }
fd_move_in :: (s: [] EgZone) -> FdIn {
  if s[0].drive.count == 0 { return FdIn.{}; }
  d := s[0].drive;
  if !d[0].on || d[0].status != DRV_GOING || !fd_on(s) { return FdIn.{}; }
  st := drv_steer(d, s[0].you_x, s[0].you_z, s[0].you_face, s[0].creator[0].clock);
  if st.press { fd_press(s); return FdIn.{}; }
  if !st.go { return FdIn.{}; }
  // forward goes along -(sin theta, cos theta): theta is the heading turned half round
  return FdIn.{ok = true, in = EgMoveIn.{key_y = 1, run = st.dist > 6, theta = figs.wrap_angle(figs.atan2(st.dx, st.dz) + 3.14159265)}};
}
fd_press :: (s: [] EgZone) {
  d := s[0].drive; x := s[0].xc[..];
  if d[0].op == DRV_RIDE { drv_pressed(d, zone_mount_key(s), "E (mount)"); return; }   // zone-ride.coax: the key a player presses
  names: [256] u8; nn := 0;
  for i: 0..<x[0].bar_n {
    if drv_ability_is(d, x[0].bar[i].name, i + 1) { drv_pressed(d, xc_press(s, i), x[0].bar[i].name); return; }
    nn = drv_put_s(names[..], nn, ifx i == 0 then ": " else ", "); nn = drv_put_s(names[..], nn, x[0].bar[i].name);
  }
  if x[0].bar_n == 0 { nn = drv_put_s(names[..], 0, ": the bar is empty"); }
  drv_no_ability(d, cast(string) names[0..<nn]);
}
// A driver's command (host message 700): the answer goes back through coaxial_drive_out.
fd_message :: (s: [] EgZone, t: string) { if s[0].drive.count > 0 { _ := drv_command(s[0].drive, t, s[0].creator[0].clock); } }
zone_drive_out :: (s: [] EgZone) -> [] u8 #export_c #effects(all) { return ifx s[0].drive.count > 0 then s[0].drive[0].out[0..<s[0].drive[0].out_n] else s[0].outbox[0..<0]; }
#test "the driver does nothing until the face attaches one, then answers" {
  s: [1] EgZone; fd_message(s[..], "tree"); #assert zone_drive_out(s[..]).count == 0 && !fd_move_in(s[..]).ok;
  d: [1] Drive; zone_drive_attach(s[..], d[..]);
  fd_message(s[..], "status"); #assert cast(string) zone_drive_out(s[..]) == "none: idle" && d[0].on;
  fd_message(s[..], "walk-to imp-0"); #assert cast(string) zone_drive_out(s[..]) == "no entity imp-0 in the tree";
}
