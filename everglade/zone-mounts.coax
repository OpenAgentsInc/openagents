// Everglade's horse and red dragon standing in a zone (everglade/docs/mounts-spec.md), game-wide:
// Everglade Experimental and the Archery Range ride through this one file. It places one white horse
// and one red dragon where the zone says, hands Everglade's mounts (everglade/mounts.coax, on
// Aethyr's aethyr/action/mount.coax) the zone's ground and the boxes its walker collides with, takes
// E and the rider's keys (xh_key, xh_ride_keys), and draws the prompt (xh_prompt_draw). A zone only
// passes its keys in and plays the yes it is handed (the footfall, the dust).
//
// A fragment of charactercreator.coax's module (it loads this; the Creator holds the mounts, the
// ground and the zone's boxes). Its checks run with that file's:
//   coax/bin/coax test --library apps/openagents-web/charactercreator.coax --only "mounts"

// The white horse: just ahead and right of where you appear (you face +Z), clear of every box (the
// spawn's safe radius only calms monsters), facing the open meadow past spawn (67 m clear at a gallop).
XH_HORSE_X :: 4.0;
XH_HORSE_Z :: 6.0;
XH_HORSE_FACE :: -2.16;
// The red dragon: ahead and to your left, in the open (6 m clear all round for its wings), facing back
// past spawn toward the village and the castle, the way it takes off over them.
XH_DRAGON_X :: 17.0;
XH_DRAGON_Z :: 18.0;
XH_DRAGON_FACE :: 3.0;

// Places the zone's horse, then its dragon, once the pack has each one's frames: where the Creator
// says they wait (Experimental's XH_* places, or a zone's own: xh_stand).
xh_place :: (s: []Creator) {
  m := s[0].mounts[..];
  if s[0].field && !s[0].mounts_stood { return; }   // the open field has no mounts but a zone's own: none stands there unseen
  if m[0].n == 0 && egm.eg_mounts_ready(m[0]) { _ := egm.eg_mount_add(m, s[0].horse_x, s[0].horse_z, s[0].horse_face); }
  if m[0].n == 1 && egm.eg_dragon_ready(m[0]) {
    _ := egm.eg_dragon_add(m, s[0].dragon_x, s[0].dragon_z, s[0].dragon_face, meadow.exp_height(s[0].dragon_x, s[0].dragon_z));
  }
}
// A zone's own places for the horse and the dragon: they wait there from now on (set before you
// ride; mounts already placed move there).
xh_stand :: (s: []Creator, hx: f32, hz: f32, hface: f32, dx: f32, dz: f32, dface: f32) {
  s[0].horse_x = hx; s[0].horse_z = hz; s[0].horse_face = hface; s[0].dragon_x = dx; s[0].dragon_z = dz; s[0].dragon_face = dface;
  s[0].mounts_stood = true;
  if s[0].mounts[0].riding < 0 { s[0].mounts[0].n = 0; }
  xh_place(s);
}
// The zone's dragon, -1 before it is placed.
xh_dragon :: (s: []Creator) -> int { for k: 0..<s[0].mounts[0].n { if s[0].mounts[0].kind[k] == egm.EG_DRAGON { return k; } } return -1; }
// The boxes the walker collides with round (x, z), for the horse (verse/experimental-village.coax
// ev_near: the castle, the village, the props, the dungeon); the count. The open field has none of
// those: only the zone's own standing things (aethyr/world/props.coax), as every zone has.
xh_walls :: (s: []Creator, x: f32, z: f32, near: []village.EvNear) -> int {
  if s[0].field { near[0].wall_n = 0; near[0].floor_n = 0; } else { village.ev_near(near, x, z); }
  near[0].wall_n = wprops.props_near(s[0].props[0], x, z, 12, meadow.exp_height(x, z), near[0].walls[..], near[0].wall_n);
  return near[0].wall_n;
}
// Your pelvis's height standing, for the body you wear (fivelab-bodies.coax BD_RIDE_HIP).
xh_hip :: (s:[]Creator) -> f32 { return figs.BD_RIDE_HIP[ifx s[0].female then 1 else 0]; }
// E from where you stand, your conditions as bearing b: what happened (egm.EG_PRESS_*).
xh_press :: (s: []Creator, now: f32, b: DeedBearing) -> int {
  if !s[0].experimental { return egm.EG_PRESS_NONE; }
  hx := s[0].player_x; hz := s[0].player_z;
  if s[0].mounts[0].riding >= 0 { h := s[0].mounts[0].mounts[s[0].mounts[0].riding]; hx = h.x; hz = h.z; }
  near: [1]village.EvNear; n := xh_walls(s, hx, hz, near[..]);
  return egm.eg_mount_press(s[0].mounts[..], 0, s[0].player_x, s[0].player_z, now, b, near[0].walls[..], n);
}
// A frame of riding (dt seconds): the horse or dragon steps among the zone's boxes over the ground under
// it, and never walks into the dungeon (a mount doesn't go underground; a dragon flies over it); where
// you are. Off it, it only finishes a mount or dismount.
xh_ride :: (s: []Creator, i: mount.MountIn, dt: f32, now: f32) -> egm.EgRider {
  m := s[0].mounts[..];
  if m[0].n == 0 { return egm.EgRider.{}; }
  k := ifx m[0].riding >= 0 then m[0].riding else 0;
  h := m[0].mounts[k]; near: [1]village.EvNear; n := xh_walls(s, h.x, h.z, near[..]);
  _ := egm.eg_mounts_fly(m, i, dt, now, meadow.exp_height(h.x, h.z), near[0].walls[..], n);
  if !s[0].field && !mount.mount_aloft(m[0].mounts[k]) && dungeon.dg_inside(m[0].mounts[k].x, m[0].mounts[k].z, 1.5) { m[0].mounts[k].x = h.x; m[0].mounts[k].z = h.z; m[0].mounts[k].speed = 0; }
  return xh_rider(s, now);
}
// E (or the phone's button): mount the mount in reach or get off the one you ride. You ask with
// your SRD conditions (b: knocked out, held or paralyzed, you stay put). r is the answer
// (egm.EG_PRESS_*, EG_PRESS_NONE when the key goes on); show: a yes to present, the mounts' `show`
// (its footfall, and the dust at the stirrup).
XhKey :: struct { r: int; show: bool; }
xh_key :: (s: []Creator, now: f32, b: DeedBearing) -> XhKey {
  if !s[0].experimental || s[0].hostiles[0].hp <= 0 { return XhKey.{}; }
  shown := s[0].mounts[0].shows;
  r := xh_press(s, now, b);
  return XhKey.{r = r, show = s[0].mounts[0].shows != shown};
}
// A frame in the saddle: the mount steps on your keys (everglade/mounts.coax eg_ride_input; a
// gallop goes at `canter` of its speed, 1 the whole of it) and the answer is where your body goes,
// x then z: the saddle, or once you've just stepped down, where you stood before you mounted.
xh_ride_keys :: (s: []Creator, k: egm.EgRideKeys, canter: f32, now: f32) -> [2] f32 {
  m := s[0].mounts[..];
  i := egm.eg_ride_input(m, k); if i.gallop { i.forward *= canter; }
  on := m[0].riding;
  r := xh_ride(s, i, egm.eg_mounts_dt(m, now), now);
  if r.on { return [2] f32.[r.x, r.z]; }
  h := m[0].mounts[on];
  return [2] f32.[h.from_x, h.from_z];
}
// The phone's button, and a press on it: true when the press is the button's (the zone then presses E).
xh_button :: (s: Creator) -> Box { b := egm.eg_ride_button(s.width, s.height, s.scale); return Box.{x0 = b[0], y0 = b[1], x1 = b[2], y1 = b[3]}; }
xh_button_press :: (s: Creator, x: f32, y: f32, phase: int, touch: bool) -> bool {
  if phase != 0 || !s.experimental || !touch { return false; }
  if egm.eg_mount_prompt(s.mounts[0], s.player_x, s.player_z, s.clock, true).count == 0 { return false; }
  b := xh_button(s);
  return !(x < b.x0 || x > b.x1 || y < b.y0 || y > b.y1);
}
// Where the hint's line starts (its left, its baseline) and its size, device px, on a page w by h at
// scale k: centred under the bar, made smaller until it fits a narrow page.
xh_hint_at :: (t: string, w: f32, h: f32, k: f32) -> [3] f32 {
  cap := egm.eg_ride_hint_cap(face_width(t, f32(egm.EG_RIDE_HINT_CAP) * k, HUD_FACE_BODY), w, k);
  return [3] f32.[w * 0.5 - face_width(t, cap, HUD_FACE_BODY) * 0.5, h - f32(egm.EG_RIDE_HINT_UP) * k, cap];
}
// The mount's prompt: on a phone the MOUNT and DISMOUNT button; otherwise (and for what the button
// can't press: "Land first") the keys as a small line under the bar.
xh_prompt_draw :: (s: Creator, out: []f32, at: int, w: f32, h: f32, k: f32, touch: bool) -> int {
  n := at;
  if !s.experimental || s.hostiles[0].hp <= 0 { return n; }
  col := ink(k, 0.98, 0.94, 0.82);
  if touch {
    t := egm.eg_mount_prompt(s.mounts[0], s.player_x, s.player_z, s.clock, true);
    if egm.eg_prompt_pressable(t) {
      return eg_framed_prompt(out, n, xh_button(s), t, face_width(t, 12 * k, HUD_FACE_BODY), k, col);   // everglade/hud/screens.coax
    }
    if t.count == 0 { return n; }
  }
  t := egm.eg_mount_hint(s.mounts[0], s.player_x, s.player_z, s.clock);
  if t.count == 0 { return n; }
  p := xh_hint_at(t, w, h, k);
  return text(out, n, t, p[0], p[1], p[2], col);
}
xh_rider :: (s:[]Creator, now: f32) -> egm.EgRider {
  if s[0].mounts[0].riding < 0 { return egm.EgRider.{}; }
  h := s[0].mounts[0].mounts[s[0].mounts[0].riding];
  return egm.eg_rider(s[0].mounts[0], now, meadow.exp_height(h.x, h.z), meadow.exp_height(h.from_x, h.from_z), xh_hip(s));
}
// How far above the ground under you your feet are lifted to put your pelvis in the saddle.
xh_lift :: (s:[]Creator, now: f32) -> f32 {
  r := xh_rider(s, now); if !r.on { return 0; }
  return r.y - xh_hip(s) - meadow.exp_height(r.x, r.z);
}
// Your figure while you ride: in the saddle, the horse's way, the legs astride under what the upper
// body plays (the bow's draw included) once you're more than half way up.
xh_figure :: (s:[]Creator, a0: figs.BdAnim) -> figs.BdAnim {
  r := xh_rider(s, s[0].clock); if !r.on { return a0; }
  a := a0; a.yaw = r.face;
  // seated, the upper body sits still (no run's arms) unless an action is layered on it
  if r.seated > 0.5 { if !a.lay { a.clip = figs.BD_IDLE; a.t0 = 0; a.phase = s[0].clock / figs.bd_seconds(figs.BD_IDLE); } a = figs.bd_ride(a, egm.eg_seat(s[0].mounts[0])); }
  return a;
}
// The zone's horses and dragon as moved meshes, into the scene's records from n; the next free record.
xh_records :: (s:[]Creator, b: []figs.Bodies, out: []f32, n0: int, limit: int) -> int {
  n := n0;
  if !s[0].experimental || !egm.eg_mounts_ready(s[0].mounts[0]) { return n; }
  for k: 0..<s[0].mounts[0].n {
    if n >= limit { break; }
    h := s[0].mounts[0].mounts[k];
    d := ifx s[0].mounts[0].kind[k] == egm.EG_DRAGON then egm.eg_dragon_record(s[0].mounts[0], k, s[0].clock, out, n) else egm.eg_horse_record(s[0].mounts[0], k, meadow.exp_height(h.x, h.z), out, n);
    if d.count <= 0 { continue; }
    b[0].draws[n * 4] = cast(u32) d.first; b[0].draws[n * 4 + 1] = cast(u32) d.count; b[0].draws[n * 4 + 2] = cast(u32) n; b[0].draws[n * 4 + 3] = 1; n += 1;
  }
  return n;
}

#test "the white horse stands clear of every box, its rider room to step down, outside the spawn (mounts)" {
  z0: [1]Creator; near: [1]village.EvNear; n := xh_walls(z0[..], f32(XH_HORSE_X), f32(XH_HORSE_Z), near[..]);
  t := egm.EG_RIDING_HORSE;
  #assert mount.mount_body_clear(t, f32(XH_HORSE_X), f32(XH_HORSE_Z), f32(XH_HORSE_FACE), near[0].walls[..], n);
  h := mount.mount_place(f32(XH_HORSE_X), f32(XH_HORSE_Z), f32(XH_HORSE_FACE));
  #assert mount.mount_step_off(h, t, near[0].walls[..], n).ok;
  #assert !mount.mount_near(h, t, 0, 0) && !dungeon.dg_inside(f32(XH_HORSE_X), f32(XH_HORSE_Z), 1.5);
}
#test "a zone horse: placed once its frames arrive, mounted only in reach, left where you get off (mounts)" #steps 200000000 {
  s: [1]Creator; s[0].experimental = true; xh_place(s[..]); #assert s[0].mounts[0].n == 0;
  for i: 0..<egm.EG_HORSE_FRAMES { s[0].mounts[0].count[i] = 3; } s[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  xh_place(s[..]); xh_place(s[..]); #assert s[0].mounts[0].n == 1;
  s[0].player_x = 0; s[0].player_z = 0; #assert xh_press(s[..], 0, DeedBearing.{}) == egm.EG_PRESS_NONE;
  s[0].player_x = f32(XH_HORSE_X) + 1.6; s[0].player_z = f32(XH_HORSE_Z); #assert xh_press(s[..], 0, DeedBearing.{}) == egm.EG_PRESS_MOUNTED;
  r := xh_ride(s[..], mount.MountIn.{}, 0.016, 1); #assert r.on && r.seated == 1 && xh_lift(s[..], 1) > 0.4;
  for k: 0..<120 { r = xh_ride(s[..], mount.MountIn.{forward = 1}, 1.0f32 / 60, 1 + f32(k) / 60); }
  s[0].player_x = r.x; s[0].player_z = r.z;
  #assert xh_press(s[..], 4, DeedBearing.{}) == egm.EG_PRESS_DISMOUNTED;
  for k: 0..<60 { r = xh_ride(s[..], mount.MountIn.{forward = 1}, 1.0f32 / 60, 4 + f32(k) / 60); }
  #assert !r.on && s[0].mounts[0].riding < 0;
  h := s[0].mounts[0].mounts[0]; for k: 0..<60 { r = xh_ride(s[..], mount.MountIn.{forward = 1, gallop = true}, 1.0f32 / 60, 6 + f32(k) / 60); }
  #assert s[0].mounts[0].mounts[0].x == h.x && s[0].mounts[0].mounts[0].z == h.z;
}
#test "the horse can't gallop through a village wall (mounts)" #steps 200000000 {
  s: [1]Creator; s[0].experimental = true; for i: 0..<egm.EG_HORSE_FRAMES { s[0].mounts[0].count[i] = 3; } s[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  // the wall the hostiles' check uses (experimental-hostiles.coax: a monster at (49, 46) stays north of 45)
  _ := egm.eg_mount_add(s[0].mounts[..], 49, 48, 3.14159265);
  s[0].mounts[0].riding = 0; s[0].mounts[0].mounts[0].state = mount.MOUNT_RIDDEN; s[0].mounts[0].mounts[0].rider = 0;
  r := xh_rider(s[..], 0); for k: 0..<300 { r = xh_ride(s[..], mount.MountIn.{forward = 1, gallop = true}, 1.0f32 / 60, f32(k) / 60); }
  #assert r.on;
  #assert s[0].mounts[0].mounts[0].blocked && s[0].mounts[0].mounts[0].z > 44;
}
#test "the red dragon stands in the open near spawn, with room for its wings and to step down (mounts)" {
  z0: [1]Creator; near: [1]village.EvNear; n := xh_walls(z0[..], f32(XH_DRAGON_X), f32(XH_DRAGON_Z), near[..]);
  t := egm.EG_RED_DRAGON; wide := t; wide.radius = 6; wide.high = 40;
  #assert mount.mount_body_clear(t, f32(XH_DRAGON_X), f32(XH_DRAGON_Z), f32(XH_DRAGON_FACE), near[0].walls[..], n);
  #assert mount.mount_clear(wide, f32(XH_DRAGON_X), f32(XH_DRAGON_Z), 6, near[0].walls[..], n);
  #assert mount.mount_step_off(mount.mount_place(f32(XH_DRAGON_X), f32(XH_DRAGON_Z), f32(XH_DRAGON_FACE)), t, near[0].walls[..], n).ok;
  #assert !dungeon.dg_inside(f32(XH_DRAGON_X), f32(XH_DRAGON_Z), 6);
}
#test "the zone's dragon: placed after the horse once its frames arrive, flown off the ground and landed where you leave it (mounts)" #steps 400000000 {
  s: [1]Creator; s[0].experimental = true;
  for i: 0..<egm.EG_HORSE_FRAMES { s[0].mounts[0].count[i] = 3; } s[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  xh_place(s[..]); #assert s[0].mounts[0].n == 1 && xh_dragon(s[..]) < 0;
  for i: 0..<egm.EG_DRAGON_FRAMES { s[0].mounts[0].dcount[i] = 3; } s[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  xh_place(s[..]); xh_place(s[..]); k := xh_dragon(s[..]); #assert k == 1 && s[0].mounts[0].n == 2;
  d := s[0].mounts[0].mounts[k]; g := meadow.exp_height(d.x, d.z);
  s[0].player_x = d.x + cos(d.face) * 3.5; s[0].player_z = d.z - sin(d.face) * 3.5;
  #assert xh_press(s[..], 0, DeedBearing.{}) == egm.EG_PRESS_MOUNTED && s[0].mounts[0].riding == k;
  now: f32 = 0; dt: f32 = 1.0 / 60;
  for i: 0..<60 { now += dt; r := xh_ride(s[..], mount.MountIn.{}, dt, now); }
  #assert xh_lift(s[..], now) > 2.5;   // your feet, astride the neck
  for i: 0..<240 { now += dt; r := xh_ride(s[..], mount.MountIn.{forward = 1, jump = true, climb = true}, dt, now); }
  #assert mount.mount_aloft(s[0].mounts[0].mounts[k]) && xh_lift(s[..], now) > 15;
  #assert xh_press(s[..], now, DeedBearing.{}) == egm.EG_PRESS_LAND_FIRST;
  for i: 0..<1200 { now += dt; r := xh_ride(s[..], mount.MountIn.{land = true}, dt, now); }
  h := s[0].mounts[0].mounts[k]; #assert !mount.mount_aloft(h) && abs(h.wing.y - meadow.exp_height(h.x, h.z)) < 0.01;
  r := xh_rider(s[..], now); s[0].player_x = r.x; s[0].player_z = r.z;
  #assert xh_press(s[..], now + 3, DeedBearing.{}) == egm.EG_PRESS_DISMOUNTED;
}
#test "astride the horse and the dragon, no leg bone sits inside the mount's body at any frame it shows a rider (mounts)" #steps 900000000 {
  // each seat matches its mount, and the rows of a hull are the engine's
  #assert egm.EG_SEAT_OF[egm.EG_HORSE] == figs.BD_SEAT_HORSE && egm.EG_SEAT_OF[egm.EG_DRAGON] == figs.BD_SEAT_DRAGON && figs.RIDE_HULL_ROWS == 14;
  d: [1] figs.People; figs.people_load(d[..]); rows: [figs.BD_ROWS * 4] f32;
  w := 2 * figs.RIDE_HULL_ROWS;
  for body: 0..<2 {
    // the horse: every frame of its idle, walk and gallop; thighs out round the barrel, knees bent,
    // the feet below the barrel's widest at the stirrups, the pelvis on the back over the saddle bone
    h := figs.bd_ride_posed(d[..], body, figs.BD_SEAT_HORSE, rows[..]);
    hip := h.leg_a[0]; knee := h.leg_a[1]; ankle := h.leg_a[2];
    #assert knee.x > hip.x + 0.25 && knee.z > hip.z && ankle.y < knee.y - 0.3 && ankle.y < h.pelvis.y - 0.7;
    bend := figs.dot(figs.unit_or(figs.sub(hip, knee), figs.v3(0, 1, 0)), figs.unit_or(figs.sub(ankle, knee), figs.v3(0, -1, 0)));
    #assert bend > -0.9 && bend < 0;   // the knee bent between 90 and about 155 degrees
    left: [14] f32; right: [14] f32;
    for f: 0..<egm.EG_HORSE_FRAMES {
      for i: 0..<14 { left[i] = egm.EG_HORSE_HULL[f * w + i]; right[i] = egm.EG_HORSE_HULL[f * w + 14 + i]; }
      #assert figs.ride_clearance(h, f32(egm.EG_HORSE_SEAT_UP), left[..], right[..], 0, 0.04) > 0;
    }
    // the dragon: every frame of each clip it plays under a rider, level and pitched as far as it goes
    r := figs.bd_ride_posed(d[..], body, figs.BD_SEAT_DRAGON, rows[..]);
    #assert r.leg_a[2].x > r.leg_a[0].x + 0.5 && r.leg_b[2].x < r.leg_b[0].x - 0.5 && r.leg_a[1].z > r.leg_a[0].z;
    for c: 0..<egm.EG_DRAGON_CLIP.count {
      clip := egm.EG_DRAGON_CLIP[c];
      for k: 0..<dragon.DR_FRAMES[clip] {
        f := dragon.dr_first(clip) + k;
        for i: 0..<14 { left[i] = dragon.DR_HULL[f * w + i]; right[i] = dragon.DR_HULL[f * w + 14 + i]; }
        for p: 0..<3 {
          pitch := ifx p == 0 then f32(egm.EG_DRAGON_DIVE_PITCH) else ifx p == 1 then 0.0f32 else f32(egm.EG_DRAGON_CLIMB_PITCH);
          #assert figs.ride_clearance(r, f32(egm.EG_DRAGON_SEAT_UP), left[..], right[..], pitch, 0.04) > 0;
        }
      }
    }
  }
  // the seat a rider takes is the one for what's under them
  m: [1] egm.EgMounts; none: [6] f32;
  _ := egm.eg_mount_add(m[..], 0, 0, 0); _ = egm.eg_dragon_add(m[..], 30, 0, 0, 0);
  #assert egm.eg_mount_press(m[..], 0, 1.5, 0, 0, DeedBearing.{}, none[..], 0) == egm.EG_PRESS_MOUNTED && egm.eg_seat(m[0]) == figs.BD_SEAT_HORSE;
}

#test "a zone's own places: the horse and the dragon wait where it stands them, among only its own boxes on the open field (mounts)" {
  s: [1]Creator; s[0].experimental = true; s[0].field = true;
  for i: 0..<egm.EG_HORSE_FRAMES { s[0].mounts[0].count[i] = 3; } s[0].mounts[0].frames = egm.EG_HORSE_FRAMES;
  for i: 0..<egm.EG_DRAGON_FRAMES { s[0].mounts[0].dcount[i] = 3; } s[0].mounts[0].dframes = egm.EG_DRAGON_FRAMES;
  xh_place(s[..]); #assert s[0].mounts[0].n == 0;   // none on the field until a zone stands them
  xh_stand(s[..], -6, 43, 1.5, 10, 50, 3);
  #assert s[0].mounts[0].n == 2 && s[0].mounts[0].mounts[0].x == -6 && s[0].mounts[0].mounts[0].z == 43 && s[0].mounts[0].mounts[xh_dragon(s[..])].z == 50;
  // the village's houses are not on the field: no box round one, and the zone's own box is the only wall
  near: [1]village.EvNear; #assert xh_walls(s[..], -18, -23, near[..]) == 0;
  g := meadow.exp_height(0, 5); b := [6] f32.[-1, g, 4, 1, g + 2, 5]; _ := wprops.props_set(s[0].props[..], b[..], 1);
  #assert xh_walls(s[..], 0, 3, near[..]) == 1 && near[0].walls[1] < 0.3 && near[0].walls[4] > 1.5;
}
