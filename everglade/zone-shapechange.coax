// The druid's field (openagents.com/druid, unlisted): Everglade II's open meadow (verse/everglade2/meadow.coax) with a level 17
// Druid whose bar has Wild Shape and Shapechange (Dragon). Only the zone lives here: where the
// druid stands, what its bar holds, and which inputs reach the shared layers. The rules are the
// engine's (aethyr/rules/srd/shapechange.coax, dragon-actions.coax), the body's change, flight and
// breath are Everglade's (everglade/shapeshift.coax over aethyr/action/flight.coax), the looks are
// aethyr/fx/dragon.coax and the bar is fivebar's.
//   W A S D or the stick: walk, and fly once aloft
//   Space or the jump button: take off, then each press or hold beats the wings up
//   Shift in the air: dive
//   Fire Breath: hold its key (or finger) to aim, let go to breathe
//   coax/bin/coax test --library apps/openagents-web/fivelab.coax --only "druid"
#load "shapeshift.coax";

XD_LEVEL :: 17;
XD_PATHS :: [4] string.["/worlds/druid", "/worlds/druid/", "/druid", "/druid/"];
XD_REND_M :: 4.6;        // m from your middle: Rend's 10 feet of reach from a Huge body's edge
XD_FLAP_S :: 0.3;        // a phone's jump tap beats the wings this long
XD_AIM_AHEAD :: 10.0;    // m: the breath's middle meets the ground this far ahead when you breathe from the air
XD_PAD_DEAD :: 0.2;

XcDruid :: struct {
  on: bool;
  sh: [1] Shapeshift;
  seen_at: f32 = -100;                 // the last frame's clock
  cam_k: f32 = 1;                      // the camera's distance factor applied last
  jump_at: f32 = -100;                 // the last jump press the walker passed on
  breath_slot: int = -1;               // the slot held to aim Fire Breath
  breath_key: int; breath_touch: int = -100;
  burn_fx: [XC_FOES] f32;              // when each burning monster's flames last began
  breaths: int; burned: int;           // for the checks
  // a phone's thumbs: the left thumb's stick, the wings' button (xd_pointer)
  touch_seen: bool;
  pad_id: int = -100; pad_ox: f32; pad_oy: f32; pad_x: f32; pad_y: f32;
  fly_id: int = -100;
}

xd_page :: (facts: string) -> bool { for p: XD_PATHS { if cc.page_path(facts, p) { return true; } } return false; }

// book:begin druid-form
// The engine's body, as the shapeshift layer's kinds.
xd_form :: (c: RsCreature) -> int { return ifx c.shape_form == MON_ADULT_RED_DRAGON then SH_DRAGON else ifx c.wild_form != 0 then SH_WOLF else SH_DRUID; }
// book:end druid-form
xd_dragon :: (x: [] XcCombat) -> bool { return x[0].dr.on && x[0].dr.sh[0].form == SH_DRAGON; }
// Flight has the body: the dragon, once its change is done.
xd_flying_body :: (s: [] EgZone) -> bool { x := s[0].xc[..]; return xd_dragon(x) && !sh_changing(x[0].dr.sh[0], s[0].creator[0].clock); }

// The field's bar: the druid's two changes, then the dragon's five actions (greyed until it is one).
xd_bar :: (x: [] XcCombat) {
  b := x[0].b[..];
  wild := fb_feature(FB_WILD, "Wild Shape", "wild-shape"); wild.tg = FB_SELF; wild.opt = -1;
  for i: 0..<x[0].bar_n { if x[0].bar[i].kind == FB_WILD { wild = x[0].bar[i]; } }
  shape := fb_feature(FB_SHAPECHANGE, "Shapechange (Dragon)", "shapechange"); shape.tg = FB_SELF; shape.opt = MON_ADULT_RED_DRAGON; shape.lvl = 9;
  rend := fb_feature(FB_ATTACK, "Rend", "attack");
  breath := fb_feature(FB_BREATH, "Fire Breath", "fire-storm"); breath.tg = FB_SELF;
  tail := fb_feature(FB_TAIL, "Tail Sweep", "shove"); tail.tg = FB_SELF;
  buffet := fb_feature(FB_BUFFET, "Wing Buffet", "gust-of-wind"); buffet.tg = FB_SELF;
  roar := fb_feature(FB_ROAR, "Frightful Roar", "thunderwave"); roar.tg = FB_SELF;
  bar := [7] FbAb.[wild, shape, rend, breath, tail, buffet, roar];
  for i: 0..<bar.count { x[0].bar[i] = bar[i]; }
  x[0].bar_n = bar.count;
  _ := rs_shapechange_ready(b[0].c[0..<1]);   // a jade circlet, worn: the spell's material
  xd_labels(x);
}
// Shapechange's slot says Return to Form while you are changed.
xd_labels :: (x: [] XcCombat) {
  for i: 0..<x[0].bar_n {
    if x[0].bar[i].kind == FB_SHAPECHANGE { x[0].bar[i].name = ifx x[0].b[0].c[0].shape_form != 0 then "Return to Form" else "Shapechange (Dragon)"; }
  }
}
// The page: the open field in Everglade II's daylight, a level 17 Druid.
xd_enter :: (s: [] EgZone) {
  s[0].creator[0].field = true;   // the open field: Everglade II's meadow in place of the glade (charactercreator.coax scene)
  x := s[0].xc[..];
  if x[0].dr.on { return; }
  x[0].dr.on = true; x[0].klass = FB_CL_DRUID; x[0].level = XD_LEVEL; x[0].open = false;
  if x[0].started { xc_set_class(x, FB_CL_DRUID); }
}

// Each frame (xc_frame): the body follows the engine's, its change's moments play, the dragon flies,
// burning monsters show their flames, the camera eases out round the dragon.
xd_frame :: (s: [] EgZone, dt: f32) {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..];
  if !x[0].dr.on || !x[0].started { return; }
  d := x[..]; b := x[0].b[..]; now := cr[0].clock;
  sh := x[0].dr.sh[..];
  // the field gives the spent 9th-level slot and Wild Shape back once you stand in your own shape
  // again (a demo's long rest; docs/dnd/srd-compliance-ledger.md)
  c := b[0].c[0];
  if c.shape_form == 0 && c.wild_form == 0 && !sh_changing(sh[0], now) {
    if b[0].c[0].slots[9] < b[0].c[0].slots_max[9] { b[0].c[0].slots[9] = b[0].c[0].slots_max[9]; }
    if b[0].c[0].uses[RS_USE_WILD] <= 0 { b[0].c[0].uses[RS_USE_WILD] = 1; }
    _ := rs_shapechange_ready(b[0].c[0..<1]);
  }
  want := xd_form(b[0].c[0]);
  if want != sh[0].form {
    from := sh[0].form;
    if sh_begin(sh, want, now) {
      sh[0].wing.x = cr[0].player_x; sh[0].wing.z = cr[0].player_z; sh[0].wing.y = cr[0].player_y; sh[0].wing.yaw = cr[0].player_face;
      sh[0].wing.phase = ifx want == SH_DRAGON then WING_GROUND else sh[0].wing.phase;
      if from == SH_DRAGON { cr[0].player_y = 0; s[0].put_on = true; s[0].put_x = sh[0].wing.x; s[0].put_y = 0; s[0].put_z = sh[0].wing.z; s[0].put_face = sh[0].wing.yaw; }
    }
    xd_labels(x);
  }
  xd_moments(s, x[0].dr.seen_at, now);
  x[0].dr.seen_at = now;
  if xd_flying_body(s) && dt > 0 && dt < 0.25 {
    p := sh_dragon_profile(1);
    sh_step(sh, p, xd_input(s, now), 0, dt, now);
    w := sh[0].wing;
    cr[0].player_x = w.x; cr[0].player_y = w.y; cr[0].player_z = w.z; cr[0].player_face = w.yaw;
    s[0].put_on = true; s[0].put_x = w.x; s[0].put_y = w.y; s[0].put_z = w.z; s[0].put_face = w.yaw;
  }
  // flames on every burning monster, one look at a time
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    if e.dead || !sh_burning(b, 1 + i) { continue; }
    if now - x[0].dr.burn_fx[i] > f32(FXD_BURN_S) - 0.3 || x[0].dr.burn_fx[i] > now {
      x[0].dr.burn_fx[i] = now;
      fx_start_at(s, FXR_BURNING, now, fxp_v(e.x, meadow_y(e.x, e.z), e.z), fxp_v(e.x, meadow_y(e.x, e.z), e.z), fxp_v(1, 0.5, 0.1), 1, 1);
    }
  }
  // the body: hidden while the dragon stands in for it, spun as the change takes it
  bd := sh_body(sh[0], now);
  cr[0].body_hidden = bd.kind == SH_DRAGON || bd.show < 0.15;
  cr[0].body_spin = ifx bd.kind == SH_DRAGON then 0.0f32 else bd.spin;
  cr[0].cam_k = sh_cam_scale(sh[0], now);
}
// Your keys or stick along the camera (aethyr/walk.coax wish), and the wings' buttons.
xd_input :: (s: [] EgZone, now: f32) -> WingInput {
  x := s[0].xc[..]; cr := s[0].creator[0]; held := s[0].held;
  ax := axis(held, HOLD_D, HOLD_A); ay := axis(held, HOLD_W, HOLD_S);
  if x[0].dr.pad_id != -100 && sqrt(x[0].dr.pad_x * x[0].dr.pad_x + x[0].dr.pad_y * x[0].dr.pad_y) > f32(XD_PAD_DEAD) { ax = x[0].dr.pad_x; ay = x[0].dr.pad_y; }
  in: WingInput;
  size := sqrt(ax * ax + ay * ay);
  if size > 0.001 {
    k := ifx size > 1 then 1 / size else 1.0f32;
    mx := ax * k; mz := -ay * k;
    c := cos(cr.yaw); sn := sin(cr.yaw);
    in.mx = mx * c + mz * sn; in.mz = -mx * sn + mz * c;
  }
  tapped := now - x[0].dr.jump_at < f32(XD_FLAP_S);
  space := (held & HOLD_JUMP) != 0 || x[0].dr.fly_id != -100;
  in.jump = space || tapped; in.climb = space || tapped;
  in.dive = s[0].shift && x[0].dr.sh[0].wing.phase == WING_AIR;
  return in;
}
// The walker's jump while the dragon has the body: the wings take it (zone_jump_plan). True when taken.
xd_jump :: (s: [] EgZone, pending: bool) -> bool {
  if !xd_flying_body(s) { return false; }
  if pending { s[0].xc[0].dr.jump_at = s[0].creator[0].clock; }
  return true;
}
// The walker moves nothing of yours while the dragon flies (zone_move_world).
xd_holds_body :: (s: [] EgZone) -> bool { return s[0].xc[0].dr.on && xd_flying_body(s); }
// zone_you: the dragon's place, not the walker's, is yours.
xd_you :: (s: [] EgZone) {
  if !xd_holds_body(s) { return; }
  w := s[0].xc[0].dr.sh[0].wing; cr := s[0].creator[..];
  cr[0].player_x = w.x; cr[0].player_y = w.y; cr[0].player_z = w.z; cr[0].player_face = w.yaw;
  cr[0].moving = w.speed > 0.2;
}

// The change's moments as effects: the rune circle and leaves at its start, the flash, the roar.
xd_moments :: (s: [] EgZone, before: f32, now: f32) {
  x := s[0].xc[..]; cr := s[0].creator[0]; sh := x[0].dr.sh[0];
  m := sh_moments(sh, before, now);
  if m == 0 { return; }
  at := fxp_v(cr.player_x, meadow_y(cr.player_x, cr.player_z) + cr.player_y, cr.player_z);
  green := fxp_v(0.45, 1.0, 0.55); big := ifx sh.form == SH_DRAGON || sh.from == SH_DRAGON then 2.2f32 else 1.0f32;
  if (m & SH_FX_RUNE) != 0 { fx_start_at(s, FXR_RUNE, now, at, at, green, big, 2.2 * big); }
  if (m & SH_FX_VORTEX) != 0 { fx_start_at(s, FXR_VORTEX, now, at, at, green, big, 2); }
  if (m & SH_FX_FLASH) != 0 { fx_start_at(s, FXR_FLASH, now, at, at, fxp_v(0.7, 1.0, 0.6), big, 4 * big); xc_cue(s, "spell-thunder", 0.5, cr.player_x, cr.player_z, 0.8); }
  if (m & SH_FX_ROAR) != 0 { xd_roar_fx(s, now); }
}
xd_mouth :: (s: [] EgZone) -> [3] f32 {
  cr := s[0].creator[0];
  return sh_mouth(cr.player_x, meadow_y(cr.player_x, cr.player_z) + cr.player_y, cr.player_z, cr.player_face, f32(DR_HEIGHT));
}
xd_roar_fx :: (s: [] EgZone, now: f32) {
  cr := s[0].creator[0]; m := xd_mouth(s); d := sh_dir(cr.player_face, 0);
  fx_start_at(s, FXR_ROAR, now, fxp_v(m[0], m[1], m[2]), fxp_v(m[0] + d[0] * 18, m[1], m[2] + d[2] * 18), fxp_v(1, 0.8, 0.5), 2.2, 18);
  xc_cue(s, "monster-roar", 0.8, cr.player_x, cr.player_z, 0.7);
}

// The breath's aim from where the dragon is: level on the ground, down onto the ground ahead from the air.
xd_breath_pitch :: (s: [] EgZone) -> f32 {
  m := xd_mouth(s); cr := s[0].creator[0];
  ahead := f32(XD_AIM_AHEAD);
  gx := cr.player_x + sin(cr.player_face) * ahead; gz := cr.player_z + cos(cr.player_face) * ahead;
  drop := m[1] - (meadow_y(gx, gz) + 0.8);
  return -figs.atan2(drop, ahead);
}
// Hold: aim, if the breath is ready (Recharge 5-6 brought it back).
xd_aim :: (s: [] EgZone, k: int) -> bool {
  x := s[0].xc[..];
  if !x[0].dr.on || k < 0 || k >= x[0].bar_n || x[0].bar[k].kind != FB_BREATH { return false; }
  if !sh_aim(x[0].dr.sh[..], rs_breath_ready(x[0].b[0].c[0]), s[0].creator[0].clock) { x[0].fizzle = k; x[0].fizzle_at = s[0].creator[0].clock; x[0].refused += 1; return true; }
  x[0].dr.breath_slot = k;
  return true;
}
// Let go: the engine resolves the cone's creatures through the bar's own press (xc_use_ab).
xd_release :: (s: [] EgZone) -> bool {
  x := s[0].xc[..];
  k := x[0].dr.breath_slot; x[0].dr.breath_slot = -1;
  if k < 0 || !x[0].dr.sh[0].aiming { return false; }
  return xc_use(s, k);
}
// xc_use_ab's step for Fire Breath: the creatures in the 60-foot cone in the world, then the engine.
xd_breathe :: (s: [] EgZone) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..]; h := cr[0].hostiles[..]; b := x[0].b[..]; now := cr[0].clock;
  yaw := cr[0].player_face; pitch := xd_breath_pitch(s);
  if !sh_release(x[0].dr.sh[..], yaw, pitch, now) { return false; }
  m := xd_mouth(s);
  picks: [XC_FOES] int; n := 0;
  for i: 0..<XC_FOES {
    e := h[0].enemies[i];
    if e.dead || b[0].c[1 + i].x == XC_AWAY { continue; }
    if sh_in_breath(m, yaw, pitch, e.x, meadow_y(e.x, e.z) + 0.8, e.z) { picks[n] = 1 + i; n += 1; }
  }
  fb_seat_in(b, x[0].seat[..]);
  hit := rs_fire_breath_on(b, 0, picks[0..<n]);
  fb_seat_out(b, x[0].seat[..]);
  if hit < 0 { x[0].dr.sh[0].act = SH_ACT_NONE; return false; }
  x[0].dr.breaths += 1; x[0].dr.burned += hit;
  dir := sh_dir(yaw, pitch); far := f32(SH_BREATH_M);
  c := FxCause.{recipe = FXR_DRAGON_BREATH, seed = now * 13.7, t0 = now + f32(SH_BREATH_START), from = fxp_v(m[0], m[1], m[2]), to = fxp_v(m[0] + dir[0] * far, m[1] + dir[1] * far, m[2] + dir[2] * far), col = fxp_v(1, 0.5, 0.1), big = 2.2, reach = far};
  _ := fxp_start(s[0].puffs[..], c, now);
  xc_cue(s, "spell-fire", 0.9, cr[0].player_x, cr[0].player_z, 0.6);
  return true;
}
// After the bar's press: the dragon's clip and look for its other actions.
xd_after :: (s: [] EgZone, a: FbAb) {
  x := s[0].xc[..]; cr := s[0].creator[0]; now := cr.clock;
  if !xd_dragon(x) { return; }
  at := fxp_v(cr.player_x, meadow_y(cr.player_x, cr.player_z) + cr.player_y, cr.player_z);
  if a.kind == FB_ATTACK { sh_act(x[0].dr.sh[..], SH_ACT_REND, now); }
  if a.kind == FB_TAIL { sh_act(x[0].dr.sh[..], SH_ACT_SWEEP, now); fx_start_at(s, FXR_SWEEP, now, at, at, fxp_v(0.6, 0.5, 0.4), 2, f32(RS_SWEEP_FT) * f32(XC_FT) + 1.5); }
  if a.kind == FB_BUFFET { sh_act(x[0].dr.sh[..], SH_ACT_BUFFET, now); fx_start_at(s, FXR_BUFFET, now, at, at, fxp_v(0.8, 0.85, 1), 2, f32(RS_BUFFET_FT) * f32(XC_FT) + 2); }
  if a.kind == FB_ROAR { sh_act(x[0].dr.sh[..], SH_ACT_ROAR, now); xd_roar_fx(s, now); }
}
// A blow's reach in dragon form: Rend reaches 10 feet from the Huge body.
xd_reach :: (s: [] EgZone, a: FbAb, m: XcAim) -> XcAim {
  o := m;
  if xd_dragon(s[0].xc[..]) && a.kind == FB_ATTACK { o.reach = f32(XD_REND_M); }
  return o;
}

// The dragon's draw: its baked frame for its clip now, turned, pitched with its climb, banked with its turns.
xd_draw :: (s: [] EgZone, out: [] f32, n: int) -> int {
  x := s[0].xc[..]; c := s[0].creator[..];
  if !x[0].dr.on || n >= s[0].bodies[0].draws.count / 4 || (n + 1) * 24 > out.count { return n; }
  now := c[0].clock; sh := x[0].dr.sh[0];
  bd := sh_body(sh, now);
  if bd.kind != SH_DRAGON || bd.show <= 0.01 { return n; }
  clip := sh_dragon_clip(sh, sh_dragon_profile(1), now);
  f := dr_frame(clip.clip, clip.t);
  if f < 0 || f >= DR_TOTAL || c[0].dragon_n != DR_TOTAL { return n; }
  w := sh.wing;
  pitch := ifx w.phase == WING_AIR then sh_clamp(w.vy * 0.05, -0.35, 0.3) else 0.0f32;
  y := meadow_y(c[0].player_x, c[0].player_z) + c[0].player_y;
  sh_record(out, n, c[0].dragon_word, c[0].player_x, y, c[0].player_z, c[0].player_face + bd.spin, pitch, w.bank, bd.scale);
  d := s[0].bodies[0].draws[..];
  d[n * 4] = cast(u32) (c[0].dragon_first + f * c[0].dragon_count); d[n * 4 + 1] = cast(u32) c[0].dragon_count;
  d[n * 4 + 2] = cast(u32) n; d[n * 4 + 3] = 1;
  s[0].bodies[0].draw_n = n + 1;
  return n + 1;
}

// ---- a phone: Experimental's touches turn the camera, so the field adds a thumb's stick (the left
// side, under the top third) and the wings' button over the bar's right end.
XD_PAD_R :: 56.0;   // px at k 1: a full push of the stick
xd_fly_at :: (x: [] XcCombat) -> [3] f32 {
  k := x[0].k; r := cc.eg_box4(xc_slot_at(x[0].bar_n, ifx x[0].bar_n > 0 then x[0].bar_n - 1 else 0, x[0].w, x[0].h, x[0].k));
  return [3] f32.[x[0].w - 70 * k, r.y0 - 80 * k, 40 * k];
}
xd_pointer :: (s: [] EgZone, px: f32, py: f32, phase: int, id: int) -> bool {
  x := s[0].xc[..]; cr := s[0].creator[..];
  if !x[0].dr.on { return false; }
  k := x[0].k;
  if phase == 0 && cr[0].ml[0].touch {
    x[0].dr.touch_seen = true;
    f := xd_fly_at(x); dx := px - f[0]; dy := py - f[1];
    if dx * dx + dy * dy <= f[2] * f[2] * 1.4 { x[0].dr.fly_id = id; return true; }
    if px < x[0].w * 0.42 && py > x[0].h * 0.33 && py < cc.eg_box4(xc_slot_at(x[0].bar_n, 0, x[0].w, x[0].h, x[0].k)).y0 - 10 * k {
      x[0].dr.pad_id = id; x[0].dr.pad_ox = px; x[0].dr.pad_oy = py; x[0].dr.pad_x = 0; x[0].dr.pad_y = 0; return true;
    }
    return false;
  }
  if id == x[0].dr.pad_id && phase == 1 {
    r := f32(XD_PAD_R) * k;
    ax := (px - x[0].dr.pad_ox) / r; ay := -(py - x[0].dr.pad_oy) / r;
    m := sqrt(ax * ax + ay * ay);
    if m > 1 { ax /= m; ay /= m; }
    x[0].dr.pad_x = ax; x[0].dr.pad_y = ay; return true;
  }
  if (phase == 2 || phase == 3) && id == x[0].dr.pad_id { x[0].dr.pad_id = -100; x[0].dr.pad_x = 0; x[0].dr.pad_y = 0; return true; }
  if (phase == 2 || phase == 3) && id == x[0].dr.fly_id { x[0].dr.fly_id = -100; return true; }
  return id == x[0].dr.pad_id || id == x[0].dr.fly_id;
}
// The walker's input from the thumbs while the druid walks (zone_move_in).
xd_move_in :: (s: [] EgZone, in: EgMoveIn) -> EgMoveIn {
  x := s[0].xc[..]; o := in;
  if !x[0].dr.on { return o; }
  if x[0].dr.pad_id != -100 { o.key_x = x[0].dr.pad_x; o.key_y = x[0].dr.pad_y; }
  if x[0].dr.fly_id != -100 { o.jump = true; }
  return o;
}
// The thumbs drawn once a finger has touched: the stick's ring and the wings' button.
xd_hud :: (s: [] EgZone, out: [] f32, n0: int, k: f32) -> int {
  x := s[0].xc[..]; n := n0;
  if !x[0].dr.on || !x[0].dr.touch_seen { return n; }
  f := xd_fly_at(x);
  n = ring(out, n, f[0], f[1], f[2], 3 * k, ifx x[0].dr.fly_id != -100 then 1.0f32 else 0.6f32, GOLD);
  label := ifx xd_flying_body(s) then (ifx x[0].dr.sh[0].wing.phase == WING_GROUND then "FLY" else "UP") else "JUMP";
  n = cc.text(out, n, label, f[0] - xc_text_w(label, 11 * k) / 2, f[1] - 6 * k, 11 * k, ink_col(k, 1, 0.85, 0.5));
  if x[0].dr.pad_id != -100 {
    r := f32(XD_PAD_R) * k;
    n = ring(out, n, x[0].dr.pad_ox, x[0].dr.pad_oy, r, 2 * k, 0.5, GOLD);
    n = ring(out, n, x[0].dr.pad_ox + x[0].dr.pad_x * r, x[0].dr.pad_oy - x[0].dr.pad_y * r, 14 * k, 3 * k, 0.9, GOLD);
  }
  return n;
}

// ---- checks

xd_lab :: (s: [] EgZone) {
  s[0].creator[0].experimental = true; s[0].creator[0].clock = 1;
  xd_enter(s);
  xc_start(s[0].xc[..], FB_CL_DRUID);
}
xd_slot :: (x: [] XcCombat, kind: int) -> int { for i: 0..<x[0].bar_n { if x[0].bar[i].kind == kind { return i; } } return -1; }
xd_run :: (s: [] EgZone, seconds: f32) {
  steps := cast(int) floor(seconds * 30);
  for i: 0..<steps { s[0].creator[0].clock += 1.0 / 30.0; xd_frame(s, 1.0 / 30.0); }
}
#test "druid: the field's druid is level 17, and its bar holds Wild Shape, Shapechange (Dragon) and the dragon's five actions" {
  s: [1] EgZone; xd_lab(s[..]);
  x := s[0].xc[..]; c := x[0].b[0].c[0];
  #assert c.klass == RS_DRUID && c.level == 17 && c.slots[9] == 1;
  names := [7] string.["Wild Shape", "Shapechange (Dragon)", "Rend", "Fire Breath", "Tail Sweep", "Wing Buffet", "Frightful Roar"];
  #assert x[0].bar_n == 7;
  for i: 0..<7 { #assert x[0].bar[i].name == names[i]; }
  #assert xc_url("shapechange") == XC_EG_URL && xc_url("fire-storm") == XC_EG_URL && xc_url("wild-shape") == XC_MMO_URL;
}
#test "druid: Shapechange swaps in the dragon's body and the bar's label, and Return to Form gives it back" {
  s: [1] EgZone; xd_lab(s[..]); x := s[0].xc[..];
  k := xd_slot(x, FB_SHAPECHANGE);
  #assert xc_use(s[..], k);
  xd_run(s[..], 0.1);
  #assert x[0].b[0].c[0].shape_form == MON_ADULT_RED_DRAGON && x[0].dr.sh[0].form == SH_DRAGON && x[0].bar[k].name == "Return to Form";
  #assert sh_changing(x[0].dr.sh[0], s[0].creator[0].clock) && s[0].creator[0].cam_k > 1;
  xd_run(s[..], 2);
  #assert s[0].creator[0].body_hidden && abs(s[0].creator[0].cam_k - f32(SH_CAM_DRAGON)) < 0.01;
  s[0].creator[0].clock += 2; x[0].cool_at = -100;
  #assert xc_use(s[..], k);
  xd_run(s[..], 2);
  #assert x[0].b[0].c[0].shape_form == 0 && x[0].dr.sh[0].form == SH_DRUID && !s[0].creator[0].body_hidden && x[0].bar[k].name == "Shapechange (Dragon)";
  // the field gives the 9th-level slot back for the next change
  #assert x[0].b[0].c[0].slots[9] == 1;
}
#test "druid: the dragon takes off with Jump, flies faster than it walks, and glides down to land" {
  s: [1] EgZone; xd_lab(s[..]); x := s[0].xc[..];
  #assert xc_use(s[..], xd_slot(x, FB_SHAPECHANGE));
  xd_run(s[..], 2);
  s[0].held = HOLD_W; xd_run(s[..], 2);
  walked := sqrt(s[0].creator[0].player_x * s[0].creator[0].player_x + s[0].creator[0].player_z * s[0].creator[0].player_z);
  #assert walked > 1 && s[0].creator[0].player_y == 0;
  s[0].held = HOLD_W | HOLD_JUMP; xd_run(s[..], 2);
  #assert x[0].dr.sh[0].wing.phase == WING_AIR && s[0].creator[0].player_y > 3;
  x0 := s[0].creator[0].player_x; z0 := s[0].creator[0].player_z;
  s[0].held = HOLD_W; xd_run(s[..], 2);
  dx := s[0].creator[0].player_x - x0; dz := s[0].creator[0].player_z - z0;
  #assert sqrt(dx * dx + dz * dz) > walked * 1.4;
  s[0].held = 0; xd_run(s[..], 30);
  #assert x[0].dr.sh[0].wing.phase == WING_GROUND && s[0].creator[0].player_y == 0;
}
#test "druid: Fire Breath held and let go burns the monsters in its cone and none behind" {
  s: [1] EgZone; xd_lab(s[..]); x := s[0].xc[..]; h := s[0].creator[0].hostiles[..];
  #assert xc_use(s[..], xd_slot(x, FB_SHAPECHANGE));
  xd_run(s[..], 2.5);
  s[0].creator[0].player_face = 0;   // facing +z
  // two monsters that fire harms (the Imp is immune to it): one in the cone, one behind
  a := -1; bk := -1;
  for i: 0..<XC_FOES {
    h[0].enemies[i].x = 0; h[0].enemies[i].z = -30; h[0].enemies[i].dead = false;
    if (x[0].b[0].c[1 + i].immune & (1 << RS_FIRE)) == 0 { if a < 0 { a = i; } else if bk < 0 { bk = i; } }
  }
  #assert a >= 0 && bk >= 0;
  h[0].enemies[a].x = 1; h[0].enemies[a].z = 9;      // in the cone
  h[0].enemies[bk].x = 0; h[0].enemies[bk].z = -6;   // behind
  s[0].creator[0].clock += 1; x[0].cool_at = -100;
  k := xd_slot(x, FB_BREATH);
  #assert xd_aim(s[..], k) && x[0].dr.sh[0].aiming;
  before_a := x[0].b[0].c[1 + a].hp; before_b := x[0].b[0].c[1 + bk].hp;
  #assert xd_release(s[..]);
  #assert x[0].dr.breaths == 1 && x[0].b[0].c[1 + a].hp < before_a && x[0].b[0].c[1 + bk].hp == before_b;
  #assert x[0].b[0].c[1 + a].dead || x[0].b[0].c[1 + a].hp <= 0 || x[0].b[0].c[1 + a].burning == RS_BURN_ROUNDS;
  // spent until Recharge brings it back
  #assert !rs_breath_ready(x[0].b[0].c[0]);
}
#test "druid: on a phone, the left thumb walks and flies the dragon and the wings' button takes off" {
  s: [1] EgZone; xd_lab(s[..]); x := s[0].xc[..];
  x[0].w = 800; x[0].h = 1600; x[0].k = 2;
  #assert xc_use(s[..], xd_slot(x, FB_SHAPECHANGE));
  xd_run(s[..], 2);
  s[0].creator[0].ml[0].touch = true;
  #assert xd_pointer(s[..], 150, 1000, 0, 7) && xd_pointer(s[..], 150, 850, 1, 7);
  #assert x[0].dr.pad_y > 0.99 && xd_input(s[..], s[0].creator[0].clock).mz != 0;
  f := xd_fly_at(x);
  #assert xd_pointer(s[..], f[0], f[1], 0, 8) && xd_input(s[..], s[0].creator[0].clock).jump;
  xd_run(s[..], 2);
  #assert x[0].dr.sh[0].wing.phase == WING_AIR && s[0].creator[0].player_y > 3;
  #assert xd_pointer(s[..], f[0], f[1], 2, 8) && xd_pointer(s[..], 150, 850, 2, 7) && x[0].dr.pad_id == -100;
}
