// An Everglade zone (game-wide): one player's world on the shared scene, as Everglade Experimental,
// the Druid's meadow and the Archery Range run it. A zone is the state here (EgZone) and what every
// such world does the same way: your body's step on Everglade's controller (where it may stand, its
// jump, the saddle), the keys and the pointer, the frame (the scene, your class's bar and its rules,
// the mount's keys, the sounds), the host's messages and the agent driver. A realm's module holds
// one EgZone, hands these procedures to its C face, and adds only what is its own:
//   apps/openagents-web/fivelab.coax          Everglade Experimental and the Druid's meadow (with the 5E Lab and Character Create)
//   apps/openagents-web/archery-range.coax    the Archery Range
//
// It is built from the engine's and the game's modules and loads them:
//   the scene: the meadow, your figure, the mounts, a zone's own standing things   apps/openagents-web/charactercreator.coax (cc)
//   your class's bar and the SRD rules against the monsters                         apps/openagents-web/experimental-combat.coax
//   the bow: this zone's ground, walls and bodies for the engine's archer           zone-bow.coax (aethyr/action/archery.coax, longbow.coax)
//   riding: E, the saddle, the dragon's Fire Breath                                 zone-ride.coax (mounts.coax, zone-mounts.coax)
//   Shapechange                                                                     apps/openagents-web/druid-scene.coax (shapeshift.coax)
//   the agent driver                                                                zone-drive.coax (aethyr/agent/drive.coax)
// The scene and the class bar still live in the app directory; they move here when Character Create
// and Experimental's combat are split from their pages.
//   COAX_NATIVE_CHECKS=1 coax/bin/coax test --library everglade/zone.coax
#load "../apps/openagents-web/charactercreator.coax" as cc;
#load "../verse/experimental-village.coax" as village;
#load "../verse/experimental-hostiles.coax" as hostile;
#load "../verse/experimental-dungeon.coax" as xdungeon;
#load "../aethyr/loop.coax";
#load "../aethyr/quality-page.coax";   // the graphics governor, wired as every realm wires it (zone_quality_frame, #13147)
#load "../aethyr/rules/srd/battle.coax";
#load "../aethyr/rules/srd/condition-display.coax";   // the conditions' words and icons, every zone's (#13082)
#load "../aethyr/space.coax" as asp;
#load "../aethyr/fx/puff.coax";   // the glade's spell and combat effects (book chapter 72)
#load "../aethyr/fx/battle.coax";   // which effect each battle event starts (#13086)
#load "../apps/openagents-web/fivelab-bodies.coax" as figs;   // the figures: Everglade's Quaternius people, skinned from baked clips
#load "../apps/openagents-web/everglade-move-types.coax";   // what a face hands Everglade's movement step (everglade-step.coax)
#load "../apps/openagents-web/experimental-sound.coax" as exsound;
#load "../aethyr/cam/mouselook.coax" as mlook;   // the mouse looks round with no button held
#load "../aethyr/action/sprint.coax" as sprint;   // a Dash's sprint (dash.coax, wired in experimental-combat.coax xc_sprint_frame)
#load "hud/class-bar.coax";   // Everglade's side bar: rest and knock-out over the bar (#13092)
#load "hud/lines.coax";       // Everglade's line HUD (#13083)
#load "../apps/openagents-web/experimental-combat.coax";   // your class's level 1 bar against the monsters, and CLASSES (#13025)
#load "zone-bow.coax";        // the bow in this zone: its ground and walls, its monsters as bodies, the SRD Longbow attack
#load "../apps/openagents-web/druid-scene.coax";   // Shapechange into the Adult Red Dragon, flight and Fire Breath
#load "../apps/openagents-web/experimental-objects.coax";
#load "mounts.coax" as egm;   // Everglade's horse and red dragon (docs/mounts-spec.md)
#load "zone-ride.coax";       // riding in a zone: E, the saddle, the dragon's Fire Breath
#load "../aethyr/agent/drive.coax";   // the agent driver: entities by id, the HUD's widgets, world operations (#13095)
#load "zone-drive.coax";      // ... wired to a zone
#load "../aethyr/render/environment-frame.coax" as envf;   // the camera's resolved environment, a frame (#13066)

// The strokes a frame may draw and the uniforms it writes (gpu/charactercreator.bindings).
VERTEX_FLOATS :: 16;
MAX_VERTICES :: 250000;   // 16 MB of strokes: the HUD and the labels (the 5E Lab's log too, which shares the count)
U_ENV :: 208;            // the camera's resolved environment, 27 vec4s (aethyr/render/painterly.coax PAINT_ENV_U, env_gpu_pack)
U_ENV_WORDS :: envf.ENV_FRAME_FLOATS;   // the record's words, from its owner (#13067: no second copy of the layout)
UNIFORM_FLOATS :: 316;   // 79 vec4s (gpu/fivelab.bindings, gpu/charactercreator.bindings)
HOLD_W :: 1; HOLD_A :: 2; HOLD_S :: 4; HOLD_D :: 8; HOLD_LEFT :: 16; HOLD_RIGHT :: 32; HOLD_UP :: 64; HOLD_DOWN :: 128; HOLD_IN :: 256; HOLD_OUT :: 512;
HOLD_JUMP :: 1024; HOLD_ALL :: 2047;
OUTBOX_CAP :: 4096;
ACT_NAVIGATE :: 1;
ACT_PREFETCH :: 18;   // host.js (zone-host.js): open a page out of sight, up to its first drawn frame; its progress comes back as message 18, and action 1 to it then hands over in place
KEY_SHIFT :: -13; KEY_TAB :: -15; KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7;
HOST_PAGE :: 600;   // coax/web/host.js's page facts: key=value lines, the url among them
P3 :: struct { x: f32; y: f32; z: f32; }
lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
put :: (buf: [] u8, at: int, text: string) -> int { return rs_put(buf, at, text); }
put_int :: (buf: [] u8, at: int, v: int) -> int { return rs_put_int(buf, at, v); }

// A zone's state. The Creator is the scene (apps/openagents-web/charactercreator.coax); XcCombat is
// your class, its bar and the rules' battle (experimental-combat.coax).
EgZone :: struct {
  xc: [1] XcCombat;
  creator: [1] cc.Creator;
  experimental_audio: [1] exsound.ExperimentalSound;
  drive: [] Drive;   // the agent driver (aethyr/agent/drive.coax), held by the face: empty in checks, off until a driver speaks
  respawn_id: int = -1;
  rein: f32 = 1;     // the share of a gallop the stick asks while you ride (a film stage canters)
  breath_dn: f32;    // how far down the dragon's breath was aimed (its torrent keeps that tilt as the dragon flies)
  breath_puff_at: f32 = -100;   // when the breath's torrent last left the dragon's jaws (zone-ride.coax zone_breath_stream)
  puffs: [1] FxPuffs;   // the effects as puffs (aethyr/fx/puff.coax)
  held: int; shift: bool;   // the keys held (HOLD_*), and Shift
  // the figures (apps/openagents-web/fivelab-bodies.coax): their playback, the frame's instances (the face's objects store) and the shadow tiles' draws
  bodies: [1] figs.Bodies;
  records: [figs.BD_RECORDS * figs.BD_REC_FLOATS] f32;
  shadow_draws: [4096] u32; shadow_n: int;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
  // your body: the face walked it this frame, its feet (metres) and facing, a place the face puts it first, and the last clear place
  you_on: bool;
  you_x: f32; you_y: f32; you_z: f32; you_face: f32;
  put_on: bool; put_x: f32; put_y: f32; put_z: f32; put_face: f32;
  safe_on: bool; safe_x: f32; safe_y: f32; safe_z: f32; safe_face: f32;
  village_near: [1] village.EvNear;   // the walls and floors round you, for the controller
  touch: bool; stick_on: bool; stick_ox: f32; stick_oy: f32; stick_px: f32; stick_py: f32;   // the thumb's stick (aethyr/sticks.coax)
  env: [U_ENV_WORDS] f32; env_n: int;   // the light: the painterly default resolved at the page's fixed noon, once (zone_light)
  qp: [1] QualityPage; gfx_finger: int = -1;   // the graphics governor (aethyr/quality-page.coax): the pixels drawn and the knobs; the finger on its control
}
// The world is up: the page is a zone's, and you aren't walking out of Character Create's studio.
zone_world :: (s: [] EgZone) -> bool { c := s[0].creator[..]; return c[0].on && c[0].experimental && !c[0].walk.on; }

// ---- your body's step: the face steps Everglade's controller (aethyr/walk.coax through
// everglade-step.coax) on the keys and the thumb's stick each frame; this is the zone's half.
ZoneWalk :: struct { on: bool; put: bool; x: f32; y: f32; z: f32; face: f32; }
// Whether the face walks your body this frame (never while you are down), and a place to put it first.
zone_walk :: (s: [] EgZone) -> ZoneWalk #export_c #effects(all) {
  w: ZoneWalk;
  if !s[0].creator[0].experimental { return w; }
  if s[0].creator[0].hostiles[0].ready && s[0].creator[0].hostiles[0].hp<=0 {return w;}w.on=true;if s[0].put_on {w.put=true;w.x=s[0].put_x;w.y=s[0].put_y;w.z=s[0].put_z;w.face=s[0].put_face;s[0].put_on=false;s[0].you_on=true;}else if !s[0].you_on {w.put=true;s[0].you_on=true;}if w.put {s[0].xc[0].jump=EgJump.{};s[0].xc[0].jump_run=0;s[0].you_x=w.x;s[0].you_y=w.y;s[0].you_z=w.z;s[0].you_face=w.face;s[0].creator[0].player_x=w.x;s[0].creator[0].player_y=w.y;s[0].creator[0].player_z=w.z;}return w;
}
// Your keys for Everglade's step: W, A, S and D along the camera, Shift (Everglade runs unless it
// is held: verse_runs), Space to jump. The face adds the thumb's stick.
zone_move_in :: (s: [] EgZone) -> EgMoveIn #export_c #effects(all) {
  h := s[0].held;
  // a Dash's sprint runs you ahead the way it heads (xc_sprint_frame steers it), at its pace (zone_move_scale)
  if sprint.sprint_on(s[0].xc[0].dash[0], s[0].creator[0].clock) {
    return EgMoveIn.{key_y = 1, run = true, theta = s[0].xc[0].dash[0].face - 3.14159265, link_flags = 512};
  }
  dm := fd_move_in(s); if dm.ok && h == 0 { return xd_move_in(s, dm.in); }   // an agent's walk-to, face or use (zone-drive.coax)
  return xd_move_in(s, EgMoveIn.{key_x = axis(h, HOLD_D, HOLD_A), key_y = axis(h, HOLD_W, HOLD_S), run = s[0].shift,
                   jump = h & HOLD_JUMP != 0, theta = s[0].creator[0].yaw});
}
#test "experimental unrecoverable contact returns to the last clear position" {
 s:[1] EgZone;s[0].creator[0].experimental=true;s[0].you_on=true;s[0].safe_on=true;s[0].safe_x=7;s[0].safe_y=3;s[0].safe_z=9;s[0].safe_face=1;
 zone_queue_escape(s[..],10,0,12);w:=zone_walk(s[..]);#assert w.on && w.put && w.x==7 && w.y==3 && w.z==9 && w.face==1;
}
// If fixed structural geometry is genuinely unresolved, return to a previously
// accepted clear position rather than publishing an invalid collision step.
#test "experimental escape falls back to spawn if no earlier clear place exists" {
 s:[1] EgZone;s[0].creator[0].experimental=true;s[0].you_on=true;zone_queue_escape(s[..],10,0,12);w:=zone_walk(s[..]);#assert w.put && w.x==0 && w.y==0 && w.z==0;
}
#test "experimental crowd does not block the player and mobs yield" {
 s:[1] EgZone;s[0].creator[0].experimental=true;s[0].creator[0].hostiles[0].ready=true;
 for i:0..<6 {s[0].creator[0].hostiles[0].enemies[i].x=0;s[0].creator[0].hostiles[0].enemies[i].z=0;}
 w:=zone_move_world(s[..],0,0);#assert w.bodies==0;
 zone_you(s[..],0,0,-0.1,0,false,false,false,0,0,0,0);for i:0..<6 {e:=s[0].creator[0].hostiles[0].enemies[i];#assert e.x*e.x+e.z*e.z>0;}
}
zone_queue_escape :: (s:[] EgZone,x:f32,y:f32,z:f32) {
 use_safe:=s[0].safe_on && (abs(s[0].safe_x-x)+abs(s[0].safe_y-y)+abs(s[0].safe_z-z)>0.05);
 s[0].put_on=true;s[0].put_x=ifx use_safe then s[0].safe_x else 0.0f32;s[0].put_y=ifx use_safe then s[0].safe_y else 0.0f32;s[0].put_z=ifx use_safe then s[0].safe_z else 0.0f32;s[0].put_face=ifx use_safe then s[0].safe_face else s[0].you_face;
}
// The combat controller rate is distinct from environmental pace (which the
// generic walker deliberately clamps to one). Other modes retain their path.
zone_move_scale :: (s:[] EgZone)->f32 #export_c #effects(all) {
  if !s[0].creator[0].experimental || !s[0].xc[0].started { return 1; }
  xc_sync_world(s);
  // dragging what you grapple costs a foot more each foot (grapple.coax rs_drag_feet): half the pace
  // and a Dash's sprint over your run (aethyr/action/sprint.coax sprint_pace)
  return rs_walk_scale(s[0].xc[0].b[..],0) / f32(1 + rs_drag_feet(s[0].xc[0].b[..],0,XC_AWAY,XC_AWAY)/5) * sprint.sprint_pace(s[0].xc[0].dash[0], s[0].creator[0].clock);
}
// The world where you stand, for Everglade's step: the walls and floors round you and your pace.
zone_move_world :: (s: [] EgZone, x: f32, z: f32) -> EgMoveWorld #export_c #effects(all) {
  w: EgMoveWorld;
  w.deck = true;
  // the open field: no village, its walls or its bushes; only the zone's own standing things (aethyr/world/props.coax)
  if s[0].creator[0].field {s[0].village_near[0].floor_n=0;s[0].village_near[0].wall_n=wprops.props_near(s[0].creator[0].props[0],x,z,8,xmeadow.exp_height(x,z),s[0].village_near[0].walls[..],0);w.walls=s[0].village_near[0].wall_n;w.bodies=0;w.pace=xc_bow_pace(s);if xd_holds_body(s) {w.pace=0;}return w;}
  rescue:=village.ev_player_near(s[0].village_near[..],x,s[0].you_y,z);if rescue==2 {zone_queue_escape(s,x,s[0].you_y,z);}else if rescue==0 {s[0].safe_on=true;s[0].safe_x=x;s[0].safe_y=s[0].you_y;s[0].safe_z=z;s[0].safe_face=s[0].you_face;}xc_objects_walls(s,x,z);w.walls=s[0].village_near[0].wall_n;w.floors=s[0].village_near[0].floor_n;w.bodies=0;w.pace=village.ev_bush_pace(x,s[0].you_y,z)*xc_bow_pace(s);if xd_holds_body(s) {w.pace=0;}if sprint.sprint_on(s[0].xc[0].dash[0],s[0].creator[0].clock) {w.link_flags=512;}return w;
}
zone_move_bodies :: (s: [] EgZone) -> [] f32 #export_c #effects(all) { return s[0].village_near[0].walls[0..<0]; }   // none: monsters yield, they don't block
zone_move_walls :: (s: [] EgZone) -> [] f32 #export_c #effects(all) { return s[0].village_near[0].walls[..]; }
zone_move_floors :: (s: [] EgZone) -> [] f32 #export_c #effects(all) { return s[0].village_near[0].floors[..]; }
// Where your body may be.
zone_keep :: (s: [] EgZone, x: f32, z: f32) -> P3 {
  // the meadow's edge, but for the dungeon, which runs on south past it (verse/experimental-dungeon.coax)
  kz:=lo(82,hi(-82,z));if x>f32(xdungeon.DG_X0) && x<xdungeon.dg_east() && z< -82 {kz=hi(xdungeon.dg_south()+0.3,z);}return P3.{x=lo(82,hi(-82,x)),z=kz};
}
// Translate the saved SRD turn to a physical jump envelope. Only an admitted
// rise commits its cost. A running start measures accepted ground motion.
zone_jump_plan :: (s:[] EgZone,origin:EgBody,intent:EgMotionIntent,pending:bool)->EgJump #export_c #effects(all) {
  x:=s[0].xc[..];
  if !s[0].creator[0].experimental || !x[0].started { return EgJump.{}; }
  if xd_jump(s,pending) { return EgJump.{mode=EG_JUMP_DENIED}; }   // the dragon's wings take the jump (druid-scene.coax)
  if !origin.ground { return x[0].jump; }
  x[0].jump=EgJump.{};
  if !pending { return x[0].jump; }
  plan:=EgJump.{mode=EG_JUMP_DENIED};
  b:=x[0].b[..]; seat:=x[0].seat[..];
  saved:=seat[0].turn;
  fb_seat_in(b,seat);
  if rs_jump_ready(b,0) {
    b[0].turn.run_ft=ifx x[0].jump_run>=3.048 then 10 else 0;
    score:=rs_jump_score(b[0].c[0]);
    full:=ifx intent.walk then score else rs_max(3+rs_mod(score),0);
    feet:=rs_jump_reach(b,full);
    left:=rs_movement_left(b,0);
    if intent.walk { feet=rs_min(feet,left); }
    if feet>0 && feet<=left {
      plan.mode=ifx intent.walk then EG_JUMP_LONG else EG_JUMP_HIGH;
      plan.feet=feet;
      if intent.walk { plan.span=f32(feet)*f32(XC_FT); }
      else { plan.height=f32(feet)*f32(XC_FT); }
    }
  }
  fb_seat_out(b,seat); seat[0].turn=saved;
  x[0].jump=plan; x[0].jump_x=origin.x; x[0].jump_z=origin.z;
  return plan;
}
zone_jump_limit :: (s:[] EgZone,origin:EgBody,body0:EgBody)->EgBody {
  body:=body0; x:=s[0].xc[..]; plan:=x[0].jump;
  if plan.mode<EG_JUMP_HIGH || origin.ground && body.ground { return body; }
  dx:=body.x-x[0].jump_x; dz:=body.z-x[0].jump_z;
  span:=sqrt(dx*dx+dz*dz);
  if span>plan.span {
    body.x=x[0].jump_x+dx*plan.span/span;
    body.z=x[0].jump_z+dz*plan.span/span;
    body.px=body.x; body.pz=body.z; body.vx=0; body.vz=0;
  }
  return body;
}
zone_jump_pay :: (s:[] EgZone)->bool {
  x:=s[0].xc[..]; b:=x[0].b[..]; seat:=x[0].seat[..];
  plan:=x[0].jump; saved:=seat[0].turn;
  fb_seat_in(b,seat);
  b[0].turn.run_ft=ifx x[0].jump_run>=3.048 then 10 else 0;
  paid:=false;
  if plan.mode==EG_JUMP_HIGH { paid=rs_high_jump(b,0)==plan.feet; }
  else if rs_jump_ready(b,0) { paid=rs_jump_pay(b,0,plan.feet); }
  fb_seat_out(b,seat);
  if paid { x[0].jump_run=0; }
  else { seat[0].turn=saved; x[0].jump=EgJump.{}; }
  return paid;
}
// Admission between controller advance and body publication. The host only
// transports this result back into the shared controller.
zone_keep_body :: (s:[] EgZone,origin:EgBody,proposed:EgBody)->EgBody #export_c #effects(all) {
  zone_breath_slot(s);
  if zone_riding(s) { return zone_ride_body(s,origin,proposed); }   // the horse carries you (zone-ride.coax)
  body:=zone_jump_limit(s,origin,proposed);
  kept:=zone_keep(s,body.x,body.z); body.x=kept.x; body.z=kept.z;
  if body.x!=proposed.x { body.px=body.x; body.vx=0; }
  if body.z!=proposed.z { body.pz=body.z; body.vz=0; }
  takes_off:=s[0].xc[0].jump.mode>=EG_JUMP_HIGH && origin.ground && !body.ground && body.y>origin.y;
  allowed:=xc_depart(s,origin,body);
  if takes_off && (!allowed || !zone_jump_pay(s)) { return origin; }
  if allowed { return body; }
  body.x=origin.x; body.z=origin.z;
  body.px=body.x; body.pz=body.z; body.vx=0; body.vz=0;
  return body;
}
// Actual body activity after admission. A jump request alone and passive
// falling do not manufacture strenuous locomotion.
zone_rest_motion :: (s:[] EgZone,origin:EgBody,body:EgBody,walking:bool,jumping:bool) #export_c #effects(all) {
  walked:=walking && (body.x!=origin.x || body.z!=origin.z);
  jumped:=jumping && origin.ground && !body.ground && body.y>origin.y;
  if s[0].xc[0].started {
    if walked && origin.ground && body.ground {
      dx:=body.x-origin.x; dz:=body.z-origin.z;
      s[0].xc[0].jump_run=lo(3.048,s[0].xc[0].jump_run+sqrt(dx*dx+dz*dz));
    } else if !walking || jumped || !body.ground || abs(body.vx)+abs(body.vz)<0.01 {
      s[0].xc[0].jump_run=0;
    }
    if body.ground && !origin.ground { s[0].xc[0].jump=EgJump.{}; }
    settled:=body.ground && abs(body.vx)<0.01 && abs(body.vz)<0.01;
    s[0].xc[0].rest_seen=true; s[0].xc[0].rest_settled=settled && !walking && !jumping;
    observed:=rs_rest_observe_motion(s[0].xc[0].b[..],0,walked,jumped,settled);
  }
}
// A drawn bow turns you to face where the camera looks, as far as its aim has come in (docs/verse/bow-combat.md).
// Mouselook faces you the same way, as far as its fade has come: A and D strafe, S backpedals.
zone_aim_face :: (s:[] EgZone,face:f32)->f32 {
  a:=s[0].creator[0].aim; look:=s[0].creator[0].ml[0].shown; if look>a { a=look; } if a<=0 { return face; }
  d:=figs.wrap_angle(s[0].creator[0].yaw+3.14159265-face);
  return figs.wrap_angle(face+d*a);
}
// Your body after the step (its feet, its facing) and the thumb's stick, for the frame.
zone_you :: (s: [] EgZone, x: f32, y: f32, z: f32, face: f32, airborne: bool, touch: bool, stick_on: bool, ox: f32, oy: f32, px: f32, py: f32) #export_c #effects(all) {
  if !s[0].creator[0].experimental { return; }
  {hostile.hostile_push(s[0].creator[0].hostiles[..],x,y,z,s[0].you_x,s[0].you_z);cc.experimental_air(s[0].creator[..],airborne);s[0].creator[0].player_x=x;s[0].creator[0].player_y=y+zone_ride_lift(s);s[0].creator[0].player_z=z;s[0].creator[0].player_face=zone_aim_face(s,face);s[0].creator[0].backpedal=s[0].creator[0].ml[0].shown>0.5 && axis(s[0].held,HOLD_W,HOLD_S)<0;s[0].creator[0].moving=axis(s[0].held,HOLD_W,HOLD_S)!=0 || axis(s[0].held,HOLD_D,HOLD_A)!=0 || stick_on || sprint.sprint_on(s[0].xc[0].dash[0],s[0].creator[0].clock);xc_sprint_frame(s);}
  xd_you(s);
  s[0].you_x = x; s[0].you_y = y; s[0].you_z = z; s[0].you_face = face;
  if touch { s[0].touch = true; }
  s[0].stick_on = stick_on; s[0].stick_ox = ox; s[0].stick_oy = oy; s[0].stick_px = px; s[0].stick_py = py;
}

// ---- the figures and the shadows
// The pack's catalog arrived (fivelab-face.c): the figures' parts.
zone_catalog :: (s: [] EgZone, text: string) #export_c #effects(all) { figs.bd_catalog(s[0].bodies[..], text); cc.catalog(s[0].creator[..], text); }
// The clips baked into the bake store, once (fivelab-face.c).
zone_bake :: (s: [] EgZone, d: [] figs.People, out: [] f32) #export_c #effects(all) { figs.people_load(d); figs.bd_bake(d, out, s[0].creator[0].dev_animations); figs.bd_bake_owned(out); figs.bd_bake_bow(d, out); figs.bd_keep_hands(s[0].bodies[..], d, out); }
// Existing optional layer-size hook: Character Create owns its quality choice.
zone_layers_side :: (s:[] EgZone)->int #export_c #effects(all) {return cc.texture_side(s[0].creator[0]);}
// Character Create's shadow tiles for the host (coaxial_shadow_*_v1; charactercreator.coax shadow_frame): none on the lab's own pages.
zone_shadow_atlas :: (s:[] EgZone,coarse:int,which:int)->int #export_c #effects(all) {return cc.shadow_atlas(s[0].creator[0],coarse!=0,which);}
zone_shadow_field :: (s:[] EgZone,field:int)->int #export_c #effects(all) {return cc.shadow_field(s[0].creator[0],field);}
zone_shadow_event :: (s:[] EgZone,kind:int,arg:int) #export_c #effects(all) {if s[0].creator[0].on {cc.shadow_event(s[0].creator[..],kind,arg);}}
// The shader already clips grass in both shadow tiles and static glade meshes
// in the player tile. Do not submit those vertices to the GPU in the first place.
zone_shadow_select :: (s: [] EgZone) {
  s[0].shadow_n = 0;
  for i: 0..<s[0].bodies[0].draw_n {
    base := s[0].bodies[0].draws[i*4+2];
    if s[0].creator[0].on {
      if base >= 65536 { continue; }
      if s[0].creator[0].shadow[0].on && !s[0].creator[0].shadow[0].now && s[0].records[cast(int) base*24+15] > 11.5 { continue; }
      // the dungeon's inside (charactercreator.coax): under its roof, it casts no sun shadow
      if s[0].records[cast(int) base*24+15] > 15.5 && s[0].records[cast(int) base*24+15] < 16.5 && s[0].records[cast(int) base*24+14] > 0.5 { continue; }
      // a build site's parts (charactercreator.coax build_record): they grow, so the cached glade tile can't hold them
      if s[0].records[cast(int) base*24+15] > 18.5 && s[0].records[cast(int) base*24+13] > 6.5 { continue; }
    }
    j := s[0].shadow_n;
    for k: 0..<4 { s[0].shadow_draws[j*4+k] = s[0].bodies[0].draws[i*4+k]; }
    s[0].shadow_n += 1;
  }
}
// The figures' instances for the frame (the objects store) and their draws; the count of draws.
zone_scene :: (s: [] EgZone, out: [] f32) -> int #export_c #effects(all) {
  n := cc.scene_reserved(s[0].creator[..],s[0].bodies[..],out,ifx s[0].creator[0].experimental then 2 else 0);
  if s[0].creator[0].experimental {
    n=xc_familiar_draw(s,out,n);n=xd_draw(s,out,n);
    if n<s[0].bodies[0].draws.count/4 { n=xc_objects_draw(s,out,n); }
  }
  n = cc.meadow_cull(s[0].creator[..], s[0].bodies[..], out, n, s[0].bodies[0].draws.count/4);   // the open field: only the cells in view (#13147)
  zone_shadow_select(s);
  // first person (charactercreator.coax cc_self_hidden): your body still casts its shadow, but isn't drawn from your eyes
  for i: 0..<s[0].bodies[0].self_n { s[0].bodies[0].draws[i*4+1] = 0; }
  return n;
}

// ---- the graphics governor (aethyr/quality.coax through aethyr/quality-page.coax, #13147): in AUTO
// it draws fewer pixels, then less grass and understory, when frames run long, and more again when
// they keep on time. A zone's face calls zone_quality_frame every frame and answers the host's
// pixel budget with zone_pixel_budget; the tier shows beside the frame rate
// (experimental-combat.coax xc_corner) and a tap there picks the next (zone_gfx_pointer).
ZONE_PIXELS :: 6400000;   // the most pixels a frame draws at any tier (3200 by 2000): the glade's sky and ground are traced per pixel
zone_quality_frame :: (s: [] EgZone, dt: f32, w: f32, h: f32, dpr: f32, golden: bool) #export_c #effects(all) {
  cr := s[0].creator[..];
  drawing := ifx cr[0].on then s[0].bodies[0].draw_n > 0 else true;   // the measured start waits for the scene's first draws
  qp_frame(s[0].qp[..], dt, w, h, dpr, golden, drawing);
  kn := s[0].qp[0].kn; cr[0].q_grass = kn.grass; cr[0].q_fine = kn.fine; cr[0].q_scenery = kn.scenery;
  l: [40] u8; t := qp_label(s[0].qp[..], l[..]);
  cr[0].gfx_n = t.count; for i: 0..<t.count { cr[0].gfx[i] = t[i]; }
}
// A golden frame keeps the zone's own budget, so its picture is the same on every screen.
zone_pixel_budget :: (s: [] EgZone, w: f32, h: f32, dpr: f32) -> int #export_c #effects(all) {
  if s[0].qp[0].golden { return ZONE_PIXELS; }
  px := qp_pixels(s[0].qp[..], w, h, dpr);
  return ifx px <= 0 || px > ZONE_PIXELS then ZONE_PIXELS else px;
}
zone_gfx_pointer :: (s: [] EgZone, x: f32, y: f32, phase: int, id: int) -> bool {
  b := s[0].creator[0].gfx_box; inside := b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1;
  if phase == 0 { if !inside { return false; } s[0].gfx_finger = id; return true; }
  if s[0].gfx_finger < 0 || id != s[0].gfx_finger { return false; }
  if phase >= 2 { s[0].gfx_finger = -1; if phase == 2 && inside { qp_pick(s[0].qp[..], quality_next(s[0].qp[0].q[0].mode)); } }
  return true;
}
#test "a zone's graphics: AUTO steps the pixels and the grass down under long frames, the tier shows, and a tap picks the next" #steps 400000000 {
  s: [1] EgZone; s[0].creator[0].on = true; s[0].creator[0].experimental = true; s[0].bodies[0].draw_n = 1;
  #assert zone_pixel_budget(s[..], 2560, 1600, 2) == ZONE_PIXELS;   // no governor yet: the zone's own
  #assert zone_message(s[..], QP_HOST_GPU, "gpu_vendor=apple\ngpu_arch=metal-3\ngpu_fallback=0\n") && !zone_message(s[..], HOST_PAGE, "url=http://x/worlds/archery-range\nvw=1280\nvh=800\ndpr=2\n");
  zone_quality_frame(s[..], 0, 2560, 1600, 2, false);
  #assert quality_auto(s[0].qp[0].q[..]) && zone_pixel_budget(s[..], 2560, 1600, 2) == ZONE_PIXELS && s[0].creator[0].q_grass == 1 && s[0].creator[0].q_scenery == 1;
  #assert cast(string) s[0].creator[0].gfx[0..<s[0].creator[0].gfx_n] == "GFX AUTO · HIGH" && zone_probe(s[..], 847) == QUALITY_HIGH && zone_probe(s[..], 848) == QUALITY_AUTO;
  for i: 0..<600 { zone_quality_frame(s[..], 0.06, 2560, 1600, 2, false); }
  #assert quality_tier(s[0].qp[0].q[..]) == QUALITY_LOW && zone_pixel_budget(s[..], 2560, 1600, 2) <= 1280 * 800 && s[0].creator[0].q_grass < 0.5 && s[0].creator[0].q_scenery < 1;
  #assert cast(string) s[0].creator[0].gfx[0..<s[0].creator[0].gfx_n] == "GFX AUTO · LOW";
  #assert zone_probe(s[..], 846) == s[0].qp[0].q[0].rung && zone_probe(s[..], 847) == QUALITY_LOW && zone_probe(s[..], 849) < 50;
  // the host is told the rung it settled at, when the zone has nothing else to send
  for i: 0..<9000 { zone_quality_frame(s[..], 0.0178, 2560, 1600, 2, false); if quality_settled_due(s[0].qp[0].q[..]) { break; } }
  #assert quality_settled_due(s[0].qp[0].q[..]) && zone_action(s[..]) == QP_ACT_SETTLED && s[0].out_n >= 5; zone_action_done(s[..]);
  // a tap on the control picks HIGH, held whatever the frames do, and the host keeps it
  s[0].creator[0].gfx_box = cc.Box.{x0 = 900, y0 = 700, x1 = 1000, y1 = 744};
  #assert !zone_gfx_pointer(s[..], 10, 10, 0, 1) && zone_gfx_pointer(s[..], 950, 720, 0, 1) && zone_gfx_pointer(s[..], 950, 720, 2, 1);
  #assert !quality_auto(s[0].qp[0].q[..]) && quality_tier(s[0].qp[0].q[..]) == QUALITY_HIGH;
  #assert zone_action(s[..]) == QP_ACT_QUALITY && cast(string) s[0].outbox[0..<s[0].out_n] == "high";
  for i: 0..<300 { zone_quality_frame(s[..], 0.06, 2560, 1600, 2, false); }
  #assert quality_tier(s[0].qp[0].q[..]) == QUALITY_HIGH && zone_pixel_budget(s[..], 2560, 1600, 2) == ZONE_PIXELS && cast(string) s[0].creator[0].gfx[0..<s[0].creator[0].gfx_n] == "GFX HIGH";
  // a golden frame draws the zone's own budget and shows no control
  zone_quality_frame(s[..], 0.016, 390, 844, 3, true); #assert zone_pixel_budget(s[..], 390, 844, 3) == ZONE_PIXELS && s[0].creator[0].gfx_n == 0;
}

// ---- the frame
// The light (lighting plan Phase 1, #13066): the glade's passes (gpu/charactercreator.coax) read the
// camera's resolved environment at U_ENV, written after the frame has placed the eye (u[16..18]). A
// zone authors no environment, so it is the painterly default at the page's fixed noon (data-clock
// fixed:0.5), resolved once; a film stage (staged) has its own day.
zone_light :: (s: [] EgZone, u: [] f32, staged: bool) {
  if (staged || s[0].creator[0].build_review) && s[0].creator[0].stage_on {
    w := envf.env_frame_glade_day_words(s[0].creator[0].stage_day); for i: 0..<U_ENV_WORDS { u[U_ENV + i] = w[i]; }
    envf.env_frame_day_halo(s[0].creator[0].stage_day, u, 32); return;
  }
  if s[0].env_n == 0 { g := envf.env_frame_glade_words(); for i: 0..<U_ENV_WORDS { s[0].env[i] = g[i]; } s[0].env_n = U_ENV_WORDS; }
  for i: 0..<U_ENV_WORDS { u[U_ENV + i] = s[0].env[i]; }
}
// Everglade Experimental's strokes blend straight alpha (its HUD is the FANTASY style, cc.hud_seal).
zone_straight_alpha :: (s: [] EgZone) -> bool #export_c #effects(all) { return s[0].creator[0].experimental; }
// Before a frame is drawn: the monsters are the zone's to step, and the rules have you.
zone_begin :: (s: [] EgZone) {
  cr := s[0].creator[..];
  cr[0].hostile_external=cr[0].experimental && !cr[0].walk.on;
  if cr[0].experimental && !cr[0].walk.on {
    hostile.hostile_start(cr[0].hostiles[..]);
    xc_start(s[0].xc[..],s[0].xc[0].klass); xc_sync_vitals(s); xc_sync_permissions(s);
  }
}
// The frame's strokes, not yet sealed: the scene, then in the world the monsters' step, your bar
// and its rules (xc_frame) and the mount's keys. A realm draws its own HUD after it, then zone_seal.
zone_draw :: (s: [] EgZone, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int {
  cr := s[0].creator[..];
  zone_mouselook_step(s, ifx still then 0.0f32 else dt);
  n := cc.frame(cr,out,u,width,height,hi(dpr,0.5),dt,still);
  if cr[0].experimental && !cr[0].walk.on {
    if !still && dt>0 && dt<1 { xc_hostile_tick(s,ifx dt>0.25 then 0.25 else dt); }
    n = xc_frame(s,out,n,u,width,height,hi(dpr,0.5),ifx still then 0.0f32 else dt);
    n = zone_ride_prompt(s,out,n,width,height,hi(dpr,0.5));
  }
  return n;
}
// The HUD is the FANTASY style: its strokes blend straight alpha, sealed with their coverage.
zone_seal :: (s: [] EgZone, out: [] f32, n: int) { if s[0].creator[0].experimental { cc.hud_seal(out,0,n); } }
// The frame's sounds: ambience, your steps and the blows you take, and the build sites' landings
// (charactercreator-crew.coax). Your own feet are silent in the air and while a mount carries you: a
// rider plays no footsteps, on the horse or on the dragon in flight.
zone_sounds :: (s: [] EgZone, dt: f32, still: bool) {
  cr := s[0].creator[..];exsound.experimental_sound_tick(s[0].experimental_audio[..],cr[0].experimental && !cr[0].walk.on,cr[0].player_x,cr[0].player_z,exsound.experimental_sound_feet_off(cr[0].airborne,cr[0].mounts[0].riding),cr[0].hostiles[0].hp,cr[0].hostiles[0].hits,ifx still then 0.0f32 else dt);
  // the build sites' landings (charactercreator-crew.coax): a part lands with its material's sound
  if cr[0].experimental && !still {bc:[5]int;cc.cc_crew_sounds(cr,bc[..]);exsound.experimental_sound_build(s[0].experimental_audio[..],bc[..],0.45,0);}
}
// A whole frame of a zone with no HUD of its own: begun, drawn, sealed, heard, listed for the agent
// driver and lit. The count of stroke vertices.
zone_frame :: (s: [] EgZone, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  zone_begin(s);
  n := zone_draw(s, out, u, width, height, dpr, dt, still);
  return zone_finish(s, out, u, n, dt, still);
}
// After a realm's own HUD: sealed, heard, listed for the agent driver and lit.
zone_finish :: (s: [] EgZone, out: [] f32, u: [] f32, n: int, dt: f32, still: bool) -> int {
  zone_seal(s, out, n); zone_sounds(s, dt, still);
  fd_frame(s);
  if u.count >= UNIFORM_FLOATS { zone_light(s, u, false); }
  return n;
}

// ---- input
// Respawn at the experimental spawn; defeated foes stay defeated.
zone_respawn :: (s:[] EgZone)->bool {
 c:=s[0].creator[..];h:=c[0].hostiles[..];if !c[0].experimental || !h[0].ready {return false;}
 if s[0].xc[0].started {if s[0].xc[0].b[0].c[0].hp>0 {return false;}} else if h[0].hp>0 {return false;}
 xc_start(s[0].xc[..],s[0].xc[0].klass);
 xc_set_class(s[0].xc[..],s[0].xc[0].klass);
 h[0].contacts[0]=hostile.HcContacts.{};hostile.hostile_calm(h);   // nothing engages you for a moment, and no shot is in the air
 xc_sync_vitals(s);xc_sync_permissions(s);
 h[0].died_at=0;for i:0..<h[0].taken[0].items.count {h[0].taken[0].items[i].on=false;}
 for i:0..<hostile.HS_N {e:=h[0].enemies[i..<i+1];if !e[0].dead {e[0].x=e[0].home_x;e[0].z=e[0].home_z;e[0].swing= -1;e[0].moving=false;e[0].cool=1;e[0].returning=false;if e[0].sleeper {e[0].awake=false;}}}
 c[0].player_x=0;c[0].player_y=0;c[0].player_z=0;c[0].airborne=false;c[0].land_at= -100;c[0].camera_room= -1;
 s[0].you_on=false;s[0].safe_on=false;s[0].put_on=false;s[0].held=0;s[0].shift=false;s[0].xc[0].target= -1;sprint.sprint_stop(s[0].xc[0].dash[..]);return true;
}
zone_respawn_pointer :: (s:[] EgZone,x:f32,y:f32,phase:int,id:int)->bool {
 c := s[0].creator[..];if !c[0].experimental || !c[0].hostiles[0].ready || c[0].hostiles[0].hp>0 {s[0].respawn_id= -1;return false;}
 k:=c[0].scale;inside:=x>=c[0].width*0.5-130*k && x<=c[0].width*0.5+130*k && y>=105*k && y<=155*k;
 if phase==0 && inside {s[0].respawn_id=id;return true;}
 if s[0].respawn_id!=id {return false;}if phase==2 {s[0].respawn_id= -1;if inside {_:=zone_respawn(s);}return true;}if phase==3 {s[0].respawn_id= -1;return true;}return true;
}
// A key in the world: respawn, the mouse's look, the mount, the dragon's landing and breath, your
// bar, then the walker's keys. False when the zone isn't up or the key isn't one of them.
zone_key :: (s: [] EgZone, key: int) -> bool #export_c #effects(all) {
  if !s[0].creator[0].experimental { return false; }
  if (key=='r' || key=='R') && zone_respawn(s) {return true;}if mlook.ml_key(s[0].creator[0].ml[..],key) {return true;}if (key=='e' || key=='E') && zone_mount_key(s) {return true;}if (key=='x' || key=='X') && zone_land_key(s) {return true;}if (key=='f' || key=='F') && zone_breath_key(s) {return true;}if xc_key(s,key) {return true;}if key==' ' {s[0].held|=HOLD_JUMP;return true;}if key==KEY_SHIFT {s[0].shift=true;return true;}h:=hold_bit(key);if h!=0 {s[0].held|=h;return true;}return false;
}
zone_key_up :: (s: [] EgZone, key: int, mods: int) -> bool #export_c #effects(all) {
  if key == KEY_SHIFT { s[0].shift = false; }
  if s[0].xc[0].dr.breath_slot >= 0 && key == s[0].xc[0].dr.breath_key && xd_release(s) { return true; }
  if mlook.ml_key_up(s[0].creator[0].ml[..], key) { return true; }
  h := ifx key == ' ' then HOLD_JUMP else hold_bit(key);
  s[0].held = s[0].held & (HOLD_ALL - h);   // h is one HOLD_ bit or none
  return h != 0;
}
zone_blur :: (s: [] EgZone) #export_c #effects(all) { s[0].creator[0].dragging=false;s[0].creator[0].down=-1; s[0].stick_on = false; s[0].shift = false; s[0].held = 0; s[0].xc[0].arranging=false; s[0].xc[0].down= -100; mlook.ml_blur(s[0].creator[0].ml[..]); }
// The keys that fly the camera while they are held.
hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_W; }
  if key == 'a' || key == 'A' { return HOLD_A; }
  if key == 's' || key == 'S' { return HOLD_S; }
  if key == 'd' || key == 'D' { return HOLD_D; }
  if key == KEY_LEFT { return HOLD_LEFT; }
  if key == KEY_RIGHT { return HOLD_RIGHT; }
  if key == KEY_UP { return HOLD_UP; }
  if key == KEY_DOWN { return HOLD_DOWN; }
  if key == '=' || key == '+' { return HOLD_IN; }
  if key == '-' || key == '_' { return HOLD_OUT; }
  return 0;
}
axis :: (held: int, plus: int, minus: int) -> f32 {
  a: f32 = 0;
  if held & plus != 0 { a += 1; }
  if held & minus != 0 { a -= 1; }
  return a;
}
zone_wheel :: (s: [] EgZone, dy: f32) -> bool #export_c #effects(all) { cc.wheel(s[0].creator[..],dy); return true; }
// A pointer on the page: the respawn, the mount's button, your bar, then the scene's (the camera's drag).
zone_pointer :: (s: [] EgZone, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  if phase == 0 { s[0].creator[0].ml[0].touch = kind != 0; }
  if s[0].creator[0].on {if s[0].creator[0].experimental && zone_gfx_pointer(s,x,y,phase,id) {return true;}if s[0].creator[0].experimental && zone_respawn_pointer(s,x,y,phase,id) {return true;}if s[0].creator[0].experimental && zone_ride_pointer(s,x,y,phase) {return true;}if s[0].creator[0].experimental && xc_pointer(s,x,y,phase,id) {return true;}return cc.pointer(s[0].creator[..],x,y,phase,id);}
  return false;
}
// Optional browser mouse-button input. Existing pointer ABI and all other routes stay unchanged.
zone_pointer_buttons :: (s:[] EgZone,x:f32,y:f32,phase:int,kind:int,id:int,button:int)->bool #export_c #effects(all) {
  if phase == 0 { s[0].creator[0].ml[0].touch = kind != 0; }
  // the bow (docs/verse/bow-combat.md): the right button held draws and its release looses; the left
  // button while drawing lets it down. The drag still turns the camera, which is the aim.
  if s[0].creator[0].on && kind==0 && s[0].creator[0].experimental {
    act:=eg_bow_button(button,phase,s[0].xc[0].ar[0]);   // Everglade's Longbow on the mouse (everglade/longbow.coax)
    if act==EG_BOW_DRAW {_:=xc_bow_begin(s,false);}
    else if act==EG_BOW_LOOSE {_:=xc_bow_loose(s);}
    else if act==EG_BOW_LET_DOWN && xc_bow_cancel(s) {return true;}
  }
  if s[0].creator[0].on && kind==0 {if s[0].creator[0].experimental && button!=1 && button!=2 && zone_respawn_pointer(s,x,y,phase,id) {return true;}if s[0].creator[0].experimental && button!=1 && button!=2 && xc_pointer(s,x,y,phase,id) {return true;}return cc.mouse_pointer(s[0].creator[..],x,y,phase,id,button);}
  return zone_pointer(s,x,y,phase,kind,id);
}
// No OS cursor while Experimental's crosshair is up (a drawn bow, mouselook's reticle): the crosshair is the pointer.
zone_cursor :: (s: [] EgZone) -> int #export_c #effects(all) {
  c := s[0].creator[..];
  if c[0].on && c[0].experimental && !c[0].walk.on && (s[0].xc[0].ar[0].draw[0].on || c[0].aim > 0.01 || c[0].ml[0].shown > 0.01) { return 4; }
  return 0;
}
// Experimental's mouselook, the host's face (aethyr/cam/mouselook.coax): in the world while you stand
// (dead, the cursor is free for the respawn), never in Character Create's studio or the walk out of it.
// The mouse turns the camera as a drag does, its tilt held to the drag's.
zone_mouselook :: (s: [] EgZone) -> int #export_c #effects(all) { return mlook.ml_host(s[0].creator[0].ml[0]); }
zone_look_delta :: (s: [] EgZone, dx: f32, dy: f32) #export_c #effects(all) {
  c := s[0].creator[..]; t := mlook.ml_turn(c[0].ml[0], dx, dy);
  c[0].yaw = figs.wrap_angle(c[0].yaw - t[0]); c[0].pitch = cc.cc_clamp(c[0].pitch + t[1], -1.2, 1.2);
}
zone_pointer_lock :: (s: [] EgZone, status: int) #export_c #effects(all) { mlook.ml_lock(s[0].creator[0].ml[..], status); if status == 1 { s[0].creator[0].dragging = false; } }
#test "Experimental's mouse looks round in the world, not in the studio, and a dead hero gets the cursor" {
  s: [1] EgZone; s[0].creator[0].on = true; s[0].creator[0].experimental = true; s[0].creator[0].hostiles[0].ready = true; s[0].creator[0].hostiles[0].hp = 10;
  zone_mouselook_step(s[..], 0.1); #assert zone_mouselook(s[..]) == mlook.ML_LOOK;
  zone_pointer_lock(s[..], 1); yaw := s[0].creator[0].yaw; pitch := s[0].creator[0].pitch;
  zone_look_delta(s[..], 100, 40); #assert s[0].creator[0].yaw < yaw && s[0].creator[0].pitch > pitch;
  #assert zone_key(s[..], KEY_TAB) && zone_mouselook(s[..]) == mlook.ML_FREE;
  #assert zone_key(s[..], KEY_TAB) && zone_mouselook(s[..]) == mlook.ML_LOOK;
  for i: 0..<5 { zone_mouselook_step(s[..], 0.1); }
  #assert abs(figs.wrap_angle(zone_aim_face(s[..], 0) - (s[0].creator[0].yaw + 3.14159265))) < 0.001;   // you face the camera's way
  s[0].creator[0].hostiles[0].hp = 0; zone_mouselook_step(s[..], 0.1); #assert zone_mouselook(s[..]) == 0;
  s[0].creator[0].experimental = false; zone_mouselook_step(s[..], 0.1); #assert zone_mouselook(s[..]) == 0;
}
zone_mouselook_step :: (s: [] EgZone, dt: f32) {
  c := s[0].creator[..];
  c[0].ml[0].able = c[0].on && c[0].experimental && !c[0].walk.on && !(c[0].hostiles[0].ready && c[0].hostiles[0].hp <= 0);
  mlook.ml_step(c[0].ml[..], dt);
}

// ---- the host's messages and what the zone asks of it
// A message every zone takes the same way: a driver's command, the bar's kept order, your character
// and its kept appearance. False when it is the realm's to read (the page's facts).
zone_message :: (s: [] EgZone, kind: int, t: string) -> bool #export_c #effects(all) {
  if kind == QP_HOST_GPU { qp_gpu(s[0].qp[..], t); return true; }   // the adapter's facts: the governor's alone
  if kind == HOST_PAGE { qp_facts(s[0].qp[..], t); }                // the page's facts: the governor's start, and still the realm's to read
  if kind == 700 { fd_message(s, t); return true; }   // a driver's command (coax/web/host.js coaxial.drive)
  if kind==12 { _ := xc_order_load(s[0].xc[..], t); return true; }
  if kind==16 {cc.load_player(s[0].creator[..],t);return true;}
  if kind==17 {cc.player_reply(s[0].creator[..],t);return true;}
  if kind==ACT_PREFETCH {cc.walk_reply(s[0].creator[..],t);return true;}
  // The host delivers a kept appearance before page facts identify the route.
  if kind==4 { return cc.restore(s[0].creator[..],t); }
  return false;
}
// The page is this zone's (t: the host's page facts): the scene comes up as a world, the camera behind you.
zone_enter :: (s: [] EgZone, t: string) #export_c #effects(all) {
  cr := s[0].creator[..];
  if !cr[0].experimental {cr[0].preview_collapsed=true;}
  cr[0].on=true;cr[0].experimental=true;cr[0].dev_animations=cc.dev_local(t);cr[0].build_review=cc.build_review_page(t);cr[0].yaw=0;cr[0].pitch=0.35;cr[0].dist=4;
  cc.ensure(cr);
}
zone_action :: (s: [] EgZone) -> int #export_c #effects(all) {
 if s[0].creator[0].on && s[0].creator[0].profile_request {for i:0..<56 {s[0].outbox[i]=s[0].creator[0].profile_bytes[i];}s[0].out_n=56;s[0].creator[0].profile_request=false;return 16;}
 if s[0].creator[0].experimental && s[0].xc[0].order_dirty {s[0].out_n=xc_order_save(s[0].xc[..],s[0].outbox[..]);s[0].xc[0].order_dirty=false;if s[0].out_n>0 {return 12;}}
 // USE IN EVERGLADE: open Everglade out of sight while the character walks there, then hand over in place (charactercreator-walk.coax).
 if s[0].creator[0].on && cc.walk_ask(s[0].creator[..]) {s[0].out_n=put(s[0].outbox[..],0,"/worlds/everglade");return ACT_PREFETCH;}
 if s[0].creator[0].on && cc.walk_leave(s[0].creator[..]) {s[0].out_n=put(s[0].outbox[..],0,"/worlds/everglade");return ACT_NAVIGATE;}
 if s[0].creator[0].on && s[0].creator[0].revision!=s[0].creator[0].saved {s[0].out_n=cc.save(s[0].creator[0],s[0].outbox[..]);s[0].creator[0].saved=s[0].creator[0].revision;return 4;} if s[0].action == 0 { t := qp_tell(s[0].qp[..], s[0].outbox[..]); if t.action != 0 { s[0].out_n = t.n; return t.action; } }   // the tier to keep, or the rung AUTO settled at
 a := s[0].action; s[0].action = 0; return a; }
zone_action_done :: (s: [] EgZone) #export_c #effects(all) { s[0].out_n = 0; }

// 840 mouselook's word to the host, 841 the pointer held, 842 the reticle (percent), 843 the camera's turn, 844 its tilt (milliradians), 845 the bar slot under the pointer
// the graphics governor (zone_quality_frame): 846 its rung (-1 before it starts), 847 the tier shown (0 high, 1 med, 2 low), 848 the mode (3 auto), 849 the grass knob in hundredths
zone_probe :: (s:[] EgZone,f:int)->int #export_c #effects(all) {if f>=900 {return xc_probe(s,f);}
  if f==846 {return ifx s[0].qp[0].ready then s[0].qp[0].q[0].rung else -1;}if f==847 {return ifx s[0].qp[0].ready then quality_tier(s[0].qp[0].q[..]) else -1;}if f==848 {return s[0].qp[0].q[0].mode;}if f==849 {return cast(int)(s[0].creator[0].q_grass*100+0.5);}
  c := s[0].creator[..];if f==840 {return mlook.ml_host(c[0].ml[0]);}if f==841 {return ifx c[0].ml[0].locked then 1 else 0;}if f==842 {return cast(int)(c[0].ml[0].shown*100);}if f==843 {return cast(int)(c[0].yaw*1000);}if f==844 {return cast(int)(c[0].pitch*1000);}if f==845 {return s[0].xc[0].hover;}return cc.probe(s[0].creator[..],f);}
