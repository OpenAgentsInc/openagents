  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":2,\"id\":\"call_1\",\"function\":{\"name\":\"Bash\",\"arguments\":\"{\\\"command\\\":\\\"ls\\\"}\"}}]}}]}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_OAI_TOOL_DELTA && ev[0].block_index == 2 && cast(string) ev[0].id_buf[0..<ev[0].id_n] == "call_1";
  #assert cast(string) ev[0].name_buf[0..<ev[0].name_n] == "Bash" && cast(string) tb[0..<ev[0].text_n] == "{\"command\":\"ls\"}";
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"function\":{\"arguments\":\"a\"}}]}}]}", ev[..], tb[..]) && ev[0].block_index == 0;

  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].stop_reason == FLAWED_STOP_END_TURN;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"x\"}]}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].stop_reason == FLAWED_STOP_NONE;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"tool_calls\"}]}", ev[..], tb[..]) && ev[0].stop_reason == FLAWED_STOP_TOOL_USE;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"length\"}]}", ev[..], tb[..]) && ev[0].stop_reason == FLAWED_STOP_MAX_TOKENS;

  #assert flawed_wire_parse_openai_sse("{\"choices\":[],\"usage\":{\"prompt_tokens\":500,\"completion_tokens\":80,\"prompt_tokens_details\":{\"cached_tokens\":200}}}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].input_tokens == 500 && ev[0].output_tokens == 80 && ev[0].cache_read_tokens == 200;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":0}}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].cache_read_tokens == 0;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[],\"usage\":{\"prompt_tokens\":0,\"completion_tokens\":1}}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_DELTA;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{}}]}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_NONE;

  #assert flawed_wire_stop_reason("end_turn") == FLAWED_STOP_END_TURN && flawed_wire_stop_reason("max_tokens") == FLAWED_STOP_MAX_TOKENS;
  #assert flawed_wire_stop_reason("refusal") == FLAWED_STOP_REFUSAL && flawed_wire_stop_reason("other") == FLAWED_STOP_NONE;

  // Tool schema serialization: parse back with jv_parse to verify exact JSON structure and cache_control placement
  buf: [8192] u8;
  o: [1] Jo;
  nodes: [512] JvNode;
  d: [1] Jv;
  sb: [128] u8;

  // Anthropic with cache_last=true, 1 tool disallowed -> 7 tools, cache_control ONLY on index 6 (TodoWrite)
  jo_start(o[..], buf[..]);
  n1 := flawed_wire_write_tools(o[..], true, "", "WebFetch", true);
  #assert !o[0].bad && n1 == 7 && jv_parse(d[..], jo_text(o[..]), nodes[..]) && jv_kind(d[0], 0) == JV_ARRAY && jv_len(d[0], 0) == 7;
  t0 := jv_at(d[0], 0, 0);
  #assert jv_str(d[0], jv_get(d[0], t0, "name"), sb[..]) == 4 && cast(string) sb[0..<4] == "Read";
  #assert jv_str(d[0], jv_get(d[0], t0, "description"), sb[..]) > 10;
  #assert jv_kind(d[0], jv_get(d[0], t0, "input_schema")) == JV_OBJECT;
  #assert jv_get(d[0], t0, "cache_control") == -1;
  t6 := jv_at(d[0], 0, 6);
  #assert jv_str(d[0], jv_get(d[0], t6, "name"), sb[..]) == 9 && cast(string) sb[0..<9] == "TodoWrite";
  #assert jv_kind(d[0], jv_get(d[0], t6, "cache_control")) == JV_OBJECT;

  // Anthropic with only index 0 (Read) allowed and cache_last=true -> index 0 gets cache_control
  jo_start(o[..], buf[..]);
  n1a := flawed_wire_write_tools(o[..], true, "Read", "", true);
  #assert !o[0].bad && n1a == 1 && jv_parse(d[..], jo_text(o[..]), nodes[..]) && jv_kind(d[0], jv_get(d[0], jv_at(d[0], 0, 0), "cache_control")) == JV_OBJECT;

  // Anthropic with cache_last=false -> no cache_control even on last tool
  jo_start(o[..], buf[..]);
  n1b := flawed_wire_write_tools(o[..], true, "Read", "", false);
  #assert !o[0].bad && n1b == 1 && jv_parse(d[..], jo_text(o[..]), nodes[..]) && jv_get(d[0], jv_at(d[0], 0, 0), "cache_control") == -1;

  // OpenAI format with cache_last=true -> function wrapper, never cache_control
  jo_start(o[..], buf[..]);
  n2 := flawed_wire_write_tools(o[..], false, "Read,Bash", "", true);
  #assert !o[0].bad && n2 == 2 && jv_parse(d[..], jo_text(o[..]), nodes[..]) && jv_len(d[0], 0) == 2;
  f1 := jv_at(d[0], 0, 1);
  #assert jv_str(d[0], jv_get(d[0], f1, "type"), sb[..]) == 8 && cast(string) sb[0..<8] == "function";
  fn1 := jv_get(d[0], f1, "function");
  #assert jv_str(d[0], jv_get(d[0], fn1, "name"), sb[..]) == 4 && cast(string) sb[0..<4] == "Bash";
  #assert jv_str(d[0], jv_get(d[0], fn1, "description"), sb[..]) > 10;
  #assert jv_kind(d[0], jv_get(d[0], fn1, "parameters")) == JV_OBJECT;
  #assert jv_get(d[0], f1, "cache_control") == -1;

  // Empty allow result -> valid empty JSON array []
  jo_start(o[..], buf[..]);
  #assert flawed_wire_write_tools(o[..], true, "NoSuch", "", true) == 0 && !o[0].bad && jo_text(o[..]) == "[]";
}
