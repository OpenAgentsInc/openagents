#test "anthropic_wire: string helpers, boundaries, and model/OpenRouter mapping" {
  // Copy & cat boundaries
  small: [3] u8;
  #assert flawed_aw_copy(small[..], "abcde") == 3 && cast(string) small[0..<3] == "abc";
  #assert flawed_aw_cat(small[..], -1, "x") == 0;
  #assert flawed_aw_cat(small[..], 2, "xy") == 3 && small[2] == 'x';
  // Starts / ends / contains / lower / eq_ci / trim_slash exact edges
  #assert flawed_aw_starts("ab", "ab") && !flawed_aw_starts("a", "ab") && !flawed_aw_starts("xb", "ab");
  #assert flawed_aw_ends("ab", "ab") && !flawed_aw_ends("b", "ab") && !flawed_aw_ends("ax", "ab") && !flawed_aw_ends("xb", "ab");
  #assert flawed_aw_contains("abc", "") && flawed_aw_contains("abc", "abc") && flawed_aw_contains("abc", "c") && !flawed_aw_contains("ab", "abc") && !flawed_aw_contains("abc", "d") && !flawed_aw_contains("axc", "bc");
  #assert flawed_aw_lower('A') == 'a' && flawed_aw_lower('Z') == 'z' && flawed_aw_lower('@') == '@' && flawed_aw_lower('[') == '[';
  #assert flawed_aw_eq_ci("Ab", "aB") && !flawed_aw_eq_ci("Ab", "xb") && !flawed_aw_eq_ci("a", "ab");
  #assert flawed_aw_trim_slash("/") == "/" && flawed_aw_trim_slash("a//") == "a" && flawed_aw_trim_slash("a/") == "a";

  #assert flawed_wire_strip_model("flawed:claude-opus-4-7") == "claude-opus-4-7";
  #assert flawed_wire_strip_model("flawed:claude-sonnet-4-6[1m]") == "claude-sonnet-4-6";
  #assert flawed_wire_strip_model("claude-haiku-4-5") == "claude-haiku-4-5";
  #assert flawed_wire_has_1m("flawed:claude-opus-4-7[1m]") && !flawed_wire_has_1m("claude-opus-4-7");

  #assert flawed_wire_model_family("claude-haiku-4-5") == FLAWED_MODEL_HAIKU_45;
  #assert flawed_wire_model_family("claude-sonnet-4-6") == FLAWED_MODEL_SONNET;
  #assert flawed_wire_model_family("claude-opus-4-7") == FLAWED_MODEL_OPUS;

  ob: [96] u8;
  #assert cast(string) ob[0..<flawed_wire_openrouter_model("flawed:claude-opus-4-7", ob[..])] == "anthropic/claude-opus-4.7";
  #assert cast(string) ob[0..<flawed_wire_openrouter_model("claude-opus-4-6", ob[..])] == "anthropic/claude-opus-4.6";
  #assert cast(string) ob[0..<flawed_wire_openrouter_model("claude-sonnet-4-6", ob[..])] == "anthropic/claude-sonnet-4.6";
  #assert cast(string) ob[0..<flawed_wire_openrouter_model("claude-haiku-4-5", ob[..])] == "anthropic/claude-haiku-4.5";
  #assert cast(string) ob[0..<flawed_wire_openrouter_model("google/gemini-2.5-pro", ob[..])] == "google/gemini-2.5-pro";
  #assert cast(string) ob[0..<flawed_wire_openrouter_model("claude-custom", ob[..])] == "anthropic/claude-custom";
  #assert cast(string) ob[0..<flawed_wire_openrouter_model("", ob[..])] == "anthropic/claude-sonnet-4.6";
}

