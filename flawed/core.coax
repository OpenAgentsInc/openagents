#test "flawed core (Ch 11): bypass-immune permission engine, auto classifier, denial breaker, path safety & shell wildcards compose" {
  // Protected path safety feeds bypass-immune 1g safetyCheck
  ps := flawed_check_path_safety_for_auto_edit("/repo/.git/hooks/pre-commit");
  #assert !ps.safe && ps.classifier_approvable;
  #assert flawed_check_path_safety_for_auto_edit("/repo/.claude/worktrees/wt1/a.coax").safe;
  #assert flawed_match_shell_wildcard("git *", "git status", false) && !flawed_match_shell_wildcard("git *", "gitconfig", false);
  #assert flawed_parse_xml_classifier_block("<thinking><block>yes</block></thinking><block>no</block>") == 0;

  dt: [1] FlawedDenialTracker;
  v := flawed_eval_permission_outer(FlawedOuterInput.{
    inner = FlawedInnerInput.{mode = FLAWED_PMODE_BYPASS, tool_behavior = FLAWED_PBEH_ASK, is_safety_check = true, classifier_approvable = ps.classifier_approvable},
  }, dt[..]);
  #assert v.behavior == FLAWED_PBEH_ASK && v.reason == FLAWED_PREASON_SAFETY_CHECK;
  #assert flawed_plan_mode_transition(FLAWED_PMODE_DEFAULT, FLAWED_PMODE_AUTO, false, true).status == FLAWED_MTRANS_STRIP_DANGEROUS;
  ro: [1] FlawedResolveOnce;
  #assert flawed_resolve_claim(ro[..], 1) && !flawed_resolve_claim(ro[..], 2) && flawed_resolve_deliver(ro[..], FLAWED_PBEH_ALLOW);
}

