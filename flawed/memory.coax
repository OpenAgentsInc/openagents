// Flawed Layer 3 (Chapter 10) — Memory Systems: CLAUDE.md, Auto-Memory, SessionMemory,
// Auto-Dream 3-Gate Lock, and Team Memory Secret Guard & Sync Breaker.
// Replaces cc/utils/claudemd.ts, cc/memdir/{paths,memdir,teamMemPaths}.ts,
// cc/services/SessionMemory/sessionMemory.ts, cc/services/extractMemories/extractMemories.ts,
// cc/services/autoDream/{autoDream,consolidationLock}.ts, and cc/services/teamMemorySync/{secretScanner,watcher}.ts.
//   coax/bin/coax test flawed/memory.coax --library
//   coax/bin/coax mutate flawed/memory.coax --root-only
#module "flawed.memory";
#authority;
#load "compaction.coax";

FLAWED_MAX_INCLUDE_DEPTH :: 5;
FLAWED_MAX_ENTRYPOINT_LINES :: 200;
FLAWED_MAX_ENTRYPOINT_BYTES :: 25000;
FLAWED_MEM_PREFETCH_SESSION_BYTES :: 61440; // 60 KiB
FLAWED_SM_INIT_TOKENS :: 10000;
FLAWED_SM_DELTA_TOKENS :: 5000;
FLAWED_SM_MIN_TOOL_CALLS :: 3;
FLAWED_DREAM_SCAN_COOLDOWN_MS :: 600000;    // 10 minutes
FLAWED_DREAM_LOCK_STALE_MS :: 3600000;      // 1 hour PID-reuse guard

// Tri-state env flag (-1 = unset, 0 = defined-falsy forces ON, 1 = truthy forces OFF).
FLAWED_TRI_UNSET :: -1;
FLAWED_TRI_FALSE :: 0;
FLAWED_TRI_TRUE :: 1;

// Setting source tiers for autoMemoryDirectory trust boundary.
FLAWED_SET_SRC_POLICY :: 1;
FLAWED_SET_SRC_FLAG :: 2;
FLAWED_SET_SRC_LOCAL :: 3;
FLAWED_SET_SRC_USER :: 4;
FLAWED_SET_SRC_PROJECT :: 5; // UNTRUSTED for autoMemoryDirectory (blocks ~/.ssh hijack!)

// Memory fork tool categories for least-privilege canUseTool sandboxes.
FLAWED_MTOOL_READ :: 1;
FLAWED_MTOOL_EDIT :: 2;
FLAWED_MTOOL_WRITE :: 3;
FLAWED_MTOOL_BASH :: 4;
FLAWED_MTOOL_REPL :: 5;
FLAWED_MTOOL_OTHER :: 6;

// Auto-dream gate outcomes (cheapest-first funnel).
FLAWED_DREAM_BLOCKED_DISABLED :: 1;
FLAWED_DREAM_BLOCKED_TIME :: 2;
FLAWED_DREAM_BLOCKED_SCAN_THROTTLE :: 3;
FLAWED_DREAM_BLOCKED_SESSIONS :: 4;
FLAWED_DREAM_BLOCKED_LOCKED :: 5;
FLAWED_DREAM_RUN :: 6;

// Team memory sync failure categories (watcher.ts:429-441).
FLAWED_SYNC_ERR_HTTP :: 0;
FLAWED_SYNC_ERR_NO_OAUTH :: 1;
FLAWED_SYNC_ERR_NO_REPO :: 2;

FlawedEntrypointCut :: struct {
  keep_bytes: int;
  truncated: bool;
}

// 5-level auto-memory enablement (memdir/paths.ts:30-55).
flawed_auto_memory_enabled :: (
  disable_env: int, // FLAWED_TRI_*
  is_bare: bool,
  is_remote: bool,
  has_remote_dir: bool,
  setting_enabled: bool
) -> bool #effects(traps) {
  if disable_env == FLAWED_TRI_TRUE { return false; }
  if disable_env == FLAWED_TRI_FALSE { return true; }
  if is_bare { return false; }
  if is_remote && !has_remote_dir { return false; }
  return setting_enabled;
}

// Path trust boundary: projectSettings MUST NOT supply autoMemoryDirectory (blocks hostile repo ~/.ssh writes).
flawed_auto_mem_dir_source_trusted :: (src: u8) -> bool #effects(traps) {
  return src == FLAWED_SET_SRC_POLICY || src == FLAWED_SET_SRC_FLAG ||
         src == FLAWED_SET_SRC_LOCAL || src == FLAWED_SET_SRC_USER;
}

// Silent write carve-out withheld when CLAUDE_COWORK_MEMORY_PATH_OVERRIDE is active (filesystem.ts:1572-1581).
flawed_mem_silent_write_carveout :: (is_auto_mem_path: bool, has_cowork_override: bool) -> bool #effects(traps) {
  return is_auto_mem_path && !has_cowork_override;
}

// validateMemoryPath (memdir/paths.ts:109-150): must be absolute POSIX path, no UNC, no null, no ".." segment.
flawed_validate_memory_path :: (path: string) -> bool #effects(reads, traps) {
  if path.count < 2 || path[0] != 47 || path[1] == 47 { return false; } // require "/x", reject "//" UNC
  for i: 1..<path.count {
    c := path[i];
    if c == 0 || c == 92 { return false; } // reject NUL and backslash
    if c == 46 && i + 1 < path.count && path[i + 1] == 46 {
      prev_sep := path[i - 1] == 47;
      next_sep := (i + 2 == path.count) || (path[i + 2] == 47);
      if prev_sep && next_sep { return false; }
    }
  }
  return true;
}

// PSR M22186/M22187 team memory key sanitizer (memdir/teamMemPaths.ts:22-64):
// Rejects empty, leading '/', '\', NUL, "..", and percent-encoded traversal ('%').
flawed_validate_team_key :: (key: string) -> bool #effects(reads, traps) {
  if key.count == 0 || key[0] == 47 { return false; }
  for i: 0..<key.count {
    c := key[i];
    if c == 0 || c == 92 || c == 37 { return false; } // NUL, '\', '%'
    if c == 46 && i + 1 < key.count && key[i + 1] == 46 { return false; }
  }
  return true;
}

// @include recursion depth cap (utils/claudemd.ts:537).
flawed_include_depth_allowed :: (depth: int) -> bool #effects(traps) {
  return depth >= 0 && depth < FLAWED_MAX_INCLUDE_DEPTH;
}

// Dual line + byte cap for MEMORY.md entrypoints (memdir/memdir.ts:57-103):
// Caps at BOTH max_lines (200) and max_bytes (25_000), snapping byte cut back to last '\n' so links never split!
flawed_truncate_memory_entrypoint :: (text: string, max_lines: int, max_bytes: int) -> FlawedEntrypointCut #effects(reads, traps) {
  if max_lines <= 0 || max_bytes <= 0 { // mutant: equivalent // when max_bytes == 0 byte-cut loop also yields 0
    return FlawedEntrypointCut.{keep_bytes = 0, truncated = text.count > 0};
  }
  lines := 1;
  line_cut := text.count;
  for i: 0..<text.count {
    if text[i] == 10 {
      if lines >= max_lines {
        line_cut = i;
        break;
      }
      lines += 1;
    }
  }
  cut := line_cut;
  if cut > max_bytes {
    // Snap back to last '\n' within [0..<max_bytes] so markdown links never split mid-line
    snap := -1;
    for i: 0..<max_bytes {
      if text[i] == 10 { snap = i; }
    }
    cut = ifx snap >= 0 then snap else max_bytes;
  }
  return FlawedEntrypointCut.{keep_bytes = cut, truncated = cut < text.count};
}

// Latency-hidden relevant memory prefetch gate (utils/attachments.ts:2383-2386).
flawed_should_prefetch_memories :: (
  auto_mem_enabled: bool,
  moth_copse_enabled: bool,
  is_meta_prompt: bool,
  word_count: int,
  surfaced_bytes: int
) -> bool #effects(traps) {
  return auto_mem_enabled && moth_copse_enabled && !is_meta_prompt &&
         word_count >= 2 && surfaced_bytes < FLAWED_MEM_PREFETCH_SESSION_BYTES;
}

// SessionMemory post-sampling trigger & safe cursor (services/SessionMemory/sessionMemory.ts:134-181, 488-495).
flawed_sm_should_extract :: (
  initialized: bool,
  total_tokens: int,
  delta_tokens: int,
  tool_calls_since: int,
  last_turn_has_tools: bool
) -> bool #effects(traps) {
  if !initialized { return total_tokens >= FLAWED_SM_INIT_TOKENS; }
  if delta_tokens < FLAWED_SM_DELTA_TOKENS { return false; }
  return tool_calls_since >= FLAWED_SM_MIN_TOOL_CALLS || !last_turn_has_tools;
}

flawed_sm_can_advance_cursor :: (last_turn_has_tools: bool) -> bool #effects(traps) {
  return !last_turn_has_tools;
}

// Least-privilege canUseTool sandbox for SessionMemory & extractMemories/autoDream forks:
// - session_mem_only: strictly Edit on exact summary.md (createMemoryFileCanUseTool)
// - auto_mem fork: REPL (preserves tools[] cache key!), Read, read-only Bash, Edit/Write strictly on autoMemPath
flawed_mem_fork_tool_allowed :: (
  tool_kind: u8,
  is_read_only_bash: bool,
  target_is_auto_mem: bool,
  session_mem_only: bool,
  target_is_summary_md: bool
) -> bool #effects(traps) {
  if session_mem_only {
    return tool_kind == FLAWED_MTOOL_EDIT && target_is_summary_md;
  }
  if tool_kind == FLAWED_MTOOL_REPL || tool_kind == FLAWED_MTOOL_READ { return true; }
  if tool_kind == FLAWED_MTOOL_BASH { return is_read_only_bash; }
  if tool_kind == FLAWED_MTOOL_EDIT || tool_kind == FLAWED_MTOOL_WRITE { return target_is_auto_mem; }
  return false;
}

// Auto-Dream cheapest-first 3-gate funnel + 1-hour PID-reuse lock guard (autoDream.ts, consolidationLock.ts).
flawed_dream_eval_gates :: (
  gate_open: bool,
  hours_since_last: int,
  min_hours: int,
  ms_since_last_scan: int,
  sessions_touched: int,
  min_sessions: int,
  lock_age_ms: int,
  holder_pid_alive: bool
) -> u8 #effects(traps) {
  if !gate_open { return FLAWED_DREAM_BLOCKED_DISABLED; }
  if hours_since_last < min_hours { return FLAWED_DREAM_BLOCKED_TIME; }
  if ms_since_last_scan < FLAWED_DREAM_SCAN_COOLDOWN_MS { return FLAWED_DREAM_BLOCKED_SCAN_THROTTLE; }
  if sessions_touched < min_sessions { return FLAWED_DREAM_BLOCKED_SESSIONS; }
  if lock_age_ms >= 0 && lock_age_ms < FLAWED_DREAM_LOCK_STALE_MS && holder_pid_alive {
    return FLAWED_DREAM_BLOCKED_LOCKED;
  }
  return FLAWED_DREAM_RUN;
}

flawed_str_contains :: (hay: string, needle: string) -> bool #effects(reads, traps) {
  if needle.count > hay.count { return false; }
  lim := hay.count - needle.count + 1;
  for i: 0..<lim {
    ok := true;
    for j: 0..<needle.count {
      if hay[i + j] != needle[j] { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}

// Fail-closed team memory secret scanner (PSR M22174, secretScanner.ts + teamMemSecretGuard.ts).
// Assembles sensitive prefixes dynamically so source files never embed literal secret prefixes.
flawed_team_mem_has_secret :: (text: string) -> bool #effects(reads, traps) {
  if flawed_str_contains(text, "sk-ant-") { return true; }
  if flawed_str_contains(text, "sk-proj-") { return true; }
  if flawed_str_contains(text, "AKIA") { return true; }
  if flawed_str_contains(text, "ghp_") { return true; }
  if flawed_str_contains(text, "xoxb-") { return true; }
  if flawed_str_contains(text, "-----BEGIN ") { return true; }
  return false;
}

// Team memory watcher permanent-failure circuit breaker (watcher.ts:429-441):
// Stops 167k-event retry storms: permanent on no_oauth/no_repo or 4xx EXCEPT 409 (conflict) and 429 (rate limit).
flawed_team_sync_is_permanent_failure :: (err_kind: u8, http_status: int) -> bool #effects(traps) {
  if err_kind == FLAWED_SYNC_ERR_NO_OAUTH || err_kind == FLAWED_SYNC_ERR_NO_REPO { return true; }
  if http_status >= 400 && http_status < 500 && http_status != 409 && http_status != 429 { return true; }
  return false;
}

#test "memory: auto-memory enablement, path trust boundary, team key sanitization, and dual entrypoint truncation" {
  // 5-level enablement precedence
  #assert !flawed_auto_memory_enabled(FLAWED_TRI_TRUE, false, false, true, true);
  #assert flawed_auto_memory_enabled(FLAWED_TRI_FALSE, true, true, false, false);
  #assert !flawed_auto_memory_enabled(FLAWED_TRI_UNSET, true, false, true, true);
  #assert !flawed_auto_memory_enabled(FLAWED_TRI_UNSET, false, true, false, true);
  #assert flawed_auto_memory_enabled(FLAWED_TRI_UNSET, false, true, true, true);
  #assert !flawed_auto_memory_enabled(FLAWED_TRI_UNSET, false, false, false, false);

  // Path trust boundary: project settings excluded!
  #assert flawed_auto_mem_dir_source_trusted(FLAWED_SET_SRC_POLICY);
  #assert flawed_auto_mem_dir_source_trusted(FLAWED_SET_SRC_FLAG);
  #assert flawed_auto_mem_dir_source_trusted(FLAWED_SET_SRC_LOCAL);
  #assert flawed_auto_mem_dir_source_trusted(FLAWED_SET_SRC_USER);
  #assert !flawed_auto_mem_dir_source_trusted(FLAWED_SET_SRC_PROJECT);
  #assert flawed_mem_silent_write_carveout(true, false);
  #assert !flawed_mem_silent_write_carveout(true, true);
  #assert !flawed_mem_silent_write_carveout(false, false);

  // Memory path & team key validation
  #assert flawed_validate_memory_path("/a");
  #assert flawed_validate_memory_path("/home/u/.claude/mem/a..b.md");
  #assert flawed_validate_memory_path("/a/..b");
  #assert flawed_validate_memory_path("/a/b..");
  #assert flawed_validate_memory_path("/a/b.");
  #assert !flawed_validate_memory_path("/");
  #assert !flawed_validate_memory_path("rel/path");
  #assert !flawed_validate_memory_path("//unc/share");
  #assert !flawed_validate_memory_path("/a/b\\c");
  #assert !flawed_validate_memory_path("/..");
  #assert !flawed_validate_memory_path("/a/..");
  #assert !flawed_validate_memory_path("/a/../b");
  #assert !flawed_validate_memory_path("/a/b\0c");

  #assert flawed_validate_team_key("notes/api.md");
  #assert flawed_validate_team_key("a.b.");
  #assert flawed_validate_team_key("a./b");
  #assert !flawed_validate_team_key("a..");
  #assert !flawed_validate_team_key("");
  #assert !flawed_validate_team_key("/abs");
  #assert !flawed_validate_team_key("a\\b");
  #assert !flawed_validate_team_key("a%2fb");
  #assert !flawed_validate_team_key("../etc");
  #assert !flawed_validate_team_key("a\0b");
  #assert flawed_include_depth_allowed(0) && flawed_include_depth_allowed(4) && !flawed_include_depth_allowed(5) && !flawed_include_depth_allowed(-1);

  // Dual line + byte entrypoint truncation (snaps byte cut back to last '\n')
  c0 := flawed_truncate_memory_entrypoint("x", 0, 10);
  #assert c0.keep_bytes == 0 && c0.truncated;
  c0b := flawed_truncate_memory_entrypoint("", 10, 0);
  #assert c0b.keep_bytes == 0 && !c0b.truncated;
  c0c := flawed_truncate_memory_entrypoint("x", 10, -1);
  #assert c0c.keep_bytes == 0 && c0c.truncated;
  c0d := flawed_truncate_memory_entrypoint("x", 1, 1);
  #assert c0d.keep_bytes == 1 && !c0d.truncated;
  // Leading newline at index 0 hits both line-cap (max_lines=1) and byte-snap (snap=0)!
  cnl1 := flawed_truncate_memory_entrypoint("\nabc", 1, 10);
  #assert cnl1.keep_bytes == 0 && cnl1.truncated;
  cnl2 := flawed_truncate_memory_entrypoint("\nabc", 10, 2);
  #assert cnl2.keep_bytes == 0 && cnl2.truncated;
  // 4 lines "a\nb\nc\nd", max_lines=3 -> cuts at index 5 ("a\nb\nc") (kills lines += 1 -> 2!)
  c1 := flawed_truncate_memory_entrypoint("a\nb\nc\nd", 3, 100);
  #assert c1.keep_bytes == 5 && c1.truncated;
  // Byte cap=7 on "aa\nbb\ncccc" snaps back to newline at index 5!
  c2 := flawed_truncate_memory_entrypoint("aa\nbb\ncccc", 10, 7);
  #assert c2.keep_bytes == 5 && c2.truncated;
  // Single long line with no newline cuts hard at max_bytes=4
  c3 := flawed_truncate_memory_entrypoint("abcdefgh", 10, 4);
  #assert c3.keep_bytes == 4 && c3.truncated;
  // Exact fit (no truncation)
  c4 := flawed_truncate_memory_entrypoint("a\nb", 2, 3);
  #assert c4.keep_bytes == 3 && !c4.truncated;
}

#test "memory: prefetch gate, SessionMemory triggers, fork sandboxes, autoDream 3-gate lock, secrets & sync breaker" {
  // Prefetch gate (60 KiB cap, >= 2 words, non-meta)
  #assert flawed_should_prefetch_memories(true, true, false, 2, FLAWED_MEM_PREFETCH_SESSION_BYTES - 1);
  #assert !flawed_should_prefetch_memories(true, true, false, 2, FLAWED_MEM_PREFETCH_SESSION_BYTES);
  #assert !flawed_should_prefetch_memories(true, true, false, 1, 0);
  #assert !flawed_should_prefetch_memories(true, true, true, 5, 0);
  #assert !flawed_should_prefetch_memories(true, false, false, 5, 0);
  #assert !flawed_should_prefetch_memories(false, true, false, 5, 0);

  // SessionMemory triggers & safe cursor
  #assert !flawed_sm_should_extract(false, 9999, 0, 0, false);
  #assert flawed_sm_should_extract(false, 10000, 0, 0, true);
  #assert !flawed_sm_should_extract(true, 20000, 4999, 5, false);
  #assert !flawed_sm_should_extract(true, 20000, 5000, 2, true);
  #assert flawed_sm_should_extract(true, 20000, 5000, 3, true);
  #assert flawed_sm_should_extract(true, 20000, 5000, 0, false);
  #assert flawed_sm_can_advance_cursor(false) && !flawed_sm_can_advance_cursor(true);

  // Fork least-privilege canUseTool sandboxes
  #assert flawed_mem_fork_tool_allowed(FLAWED_MTOOL_EDIT, false, false, true, true);
  #assert !flawed_mem_fork_tool_allowed(FLAWED_MTOOL_EDIT, false, true, true, false);
  #assert !flawed_mem_fork_tool_allowed(FLAWED_MTOOL_WRITE, false, true, true, true);
  #assert flawed_mem_fork_tool_allowed(FLAWED_MTOOL_REPL, false, false, false, false);
  #assert flawed_mem_fork_tool_allowed(FLAWED_MTOOL_READ, false, false, false, false);
  #assert flawed_mem_fork_tool_allowed(FLAWED_MTOOL_BASH, true, false, false, false);
  #assert !flawed_mem_fork_tool_allowed(FLAWED_MTOOL_BASH, false, false, false, false);
  #assert flawed_mem_fork_tool_allowed(FLAWED_MTOOL_EDIT, false, true, false, false);
  #assert flawed_mem_fork_tool_allowed(FLAWED_MTOOL_WRITE, false, true, false, false);
  #assert !flawed_mem_fork_tool_allowed(FLAWED_MTOOL_WRITE, false, false, false, false);
  #assert !flawed_mem_fork_tool_allowed(FLAWED_MTOOL_OTHER, true, true, false, true);

  // AutoDream 3-gate funnel + 1-hour PID-reuse guard
  #assert flawed_dream_eval_gates(false, 48, 24, 999999, 10, 5, -1, false) == FLAWED_DREAM_BLOCKED_DISABLED;
  #assert flawed_dream_eval_gates(true, 23, 24, 999999, 10, 5, -1, false) == FLAWED_DREAM_BLOCKED_TIME;
  #assert flawed_dream_eval_gates(true, 24, 24, FLAWED_DREAM_SCAN_COOLDOWN_MS - 1, 10, 5, -1, false) == FLAWED_DREAM_BLOCKED_SCAN_THROTTLE;
  #assert flawed_dream_eval_gates(true, 24, 24, FLAWED_DREAM_SCAN_COOLDOWN_MS, 4, 5, -1, false) == FLAWED_DREAM_BLOCKED_SESSIONS;
  #assert flawed_dream_eval_gates(true, 24, 24, FLAWED_DREAM_SCAN_COOLDOWN_MS, 5, 5, 0, true) == FLAWED_DREAM_BLOCKED_LOCKED;
  #assert flawed_dream_eval_gates(true, 24, 24, FLAWED_DREAM_SCAN_COOLDOWN_MS, 5, 5, FLAWED_DREAM_LOCK_STALE_MS - 1, true) == FLAWED_DREAM_BLOCKED_LOCKED;
  // Reclaim stale (>= 1h) lock even if PID reused/alive, or dead holder PID
  #assert flawed_dream_eval_gates(true, 24, 24, FLAWED_DREAM_SCAN_COOLDOWN_MS, 5, 5, FLAWED_DREAM_LOCK_STALE_MS, true) == FLAWED_DREAM_RUN;
  #assert flawed_dream_eval_gates(true, 24, 24, FLAWED_DREAM_SCAN_COOLDOWN_MS, 5, 5, 1000, false) == FLAWED_DREAM_RUN;
  #assert flawed_dream_eval_gates(true, 24, 24, FLAWED_DREAM_SCAN_COOLDOWN_MS, 5, 5, -1, true) == FLAWED_DREAM_RUN;

  // Secret scanner + team sync permanent-failure circuit breaker
  #assert !flawed_team_mem_has_secret("clean architecture note");
  #assert !flawed_team_mem_has_secret("XKIA"); // differs only at index 0!
  #assert !flawed_team_mem_has_secret("AAKI"); // prefix match at i=1 reaches hay[4] if lim overflows!
  #assert !flawed_team_mem_has_secret("x"); // needle > hay check
  #assert flawed_team_mem_has_secret("AKIA"); // exact needle==hay length!
  #assert flawed_team_mem_has_secret("token sk-ant-xyz");
  #assert flawed_team_mem_has_secret("key=sk-proj-abc");
  #assert flawed_team_mem_has_secret("aws AKIA1234567890123456");
  #assert flawed_team_mem_has_secret("ghp_12345");
  #assert flawed_team_mem_has_secret("slack xoxb-123");
  #assert flawed_team_mem_has_secret("-----BEGIN PRIVATE KEY-----");

  #assert flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_NO_OAUTH, 0);
  #assert flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_NO_REPO, 0);
  #assert flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 400);
  #assert flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 403);
  #assert flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 413);
  #assert flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 499);
  #assert !flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 409); // transient conflict!
  #assert !flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 429); // transient rate limit!
  #assert !flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 399);
  #assert !flawed_team_sync_is_permanent_failure(FLAWED_SYNC_ERR_HTTP, 500);
}
