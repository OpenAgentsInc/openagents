  #assert flawed_wire_tool_permission("WebFetch", "https://example.com", FLAWED_PMODE_DONT_ASK, false, false) == FLAWED_PBEH_ALLOW;

  #assert flawed_wire_tool_permission("Edit", "/repo/.git/hooks/pre-commit", FLAWED_PMODE_AUTO, false, true) == FLAWED_PBEH_ASK;
  #assert flawed_wire_tool_permission("Write", "/repo/.git/hooks/pre-commit", FLAWED_PMODE_DONT_ASK, false, true) == FLAWED_PBEH_DENY;
  #assert flawed_wire_tool_permission("Edit", "/repo/src/a.coax", FLAWED_PMODE_PLAN, false, true) == FLAWED_PBEH_DENY;
  #assert flawed_wire_tool_permission("Edit", "/repo/src/a.coax", FLAWED_PMODE_DEFAULT, false, false) == FLAWED_PBEH_ASK;
  #assert flawed_wire_tool_permission("Edit", "/repo/src/a.coax", FLAWED_PMODE_DEFAULT, false, true) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("Write", "/repo/src/a.coax", FLAWED_PMODE_ACCEPT_EDITS, false, false) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("Edit", "/repo/src/a.coax", FLAWED_PMODE_AUTO, false, false) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("Edit", "/repo/src/a.coax", FLAWED_PMODE_DONT_ASK, false, false) == FLAWED_PBEH_ALLOW;

  #assert flawed_wire_tool_permission("Bash", "IFS=: read a", FLAWED_PMODE_AUTO, false, true) == FLAWED_PBEH_ASK;
  #assert flawed_wire_tool_permission("Bash", "IFS=: read a", FLAWED_PMODE_DONT_ASK, false, true) == FLAWED_PBEH_DENY;
  #assert flawed_wire_tool_permission("Bash", "git status", FLAWED_PMODE_PLAN, false, true) == FLAWED_PBEH_ASK;
  #assert flawed_wire_tool_permission("Bash", "git status", FLAWED_PMODE_DEFAULT, false, false) == FLAWED_PBEH_ASK;
  #assert flawed_wire_tool_permission("Bash", "git status", FLAWED_PMODE_DEFAULT, false, true) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("Bash", "git status", FLAWED_PMODE_ACCEPT_EDITS, false, false) == FLAWED_PBEH_ASK;
  #assert flawed_wire_tool_permission("Bash", "git status", FLAWED_PMODE_AUTO, false, false) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("Bash", "git status", FLAWED_PMODE_DONT_ASK, false, false) == FLAWED_PBEH_DENY;
  #assert flawed_wire_tool_permission("Bash", "git status", FLAWED_PMODE_DONT_ASK, false, true) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("UnknownTool", "", FLAWED_PMODE_DEFAULT, false, true) == FLAWED_PBEH_ASK;
}

#test "wire: Gemini native SSE parser handles thoughts, text, functionCall, thoughtSignature, usage, and errors" {
  ev: [1] FlawedWireSseEvent;
  tb: [256] u8;
  sb: [256] u8;
  sn := [1] int.[0];

  #assert flawed_wire_parse_gemini_sse("{}", 0, ev[0..<0], tb[..], sb[..], sn[..]) == -1;
  #assert flawed_wire_parse_gemini_sse("{}", 0, ev[..], tb[..], sb[..], sn[0..<0]) == -1;
  sn[0] = 9;
  #assert flawed_wire_parse_gemini_sse("", 0, ev[..], tb[..], sb[..], sn[..]) == -1 && sn[0] == 0;
  #assert flawed_wire_parse_gemini_sse("[]", 0, ev[..], tb[..], sb[..], sn[..]) == -1;

  // Error object resets out_sig_n
  sn[0] = 5;
  #assert flawed_wire_parse_gemini_sse("{\"error\":{\"code\":400,\"message\":\"bad arg\"}}", 0, ev[..], tb[..], sb[..], sn[..]) == 0;
  #assert ev[0].kind == FLAWED_SSE_ERROR && cast(string) tb[0..<ev[0].text_n] == "bad arg" && sn[0] == 0;

  // Multi-part chunk: part 0 thought, part 1 single-byte text, part 2 functionCall with thoughtSignature
  multi := "{\"candidates\":[{\"content\":{\"role\":\"model\",\"parts\":[{\"thought\":true,\"text\":\"Thinking...\"},{\"text\":\"H\"},{\"functionCall\":{\"name\":\"Read\",\"id\":\"call_7\",\"args\":{\"file_path\":\"a.coax\"}},\"thoughtSignature\":\"SIG_ABC\"}]},\"finishReason\":\"STOP\"}],\"usageMetadata\":{\"promptTokenCount\":120,\"candidatesTokenCount\":30,\"thoughtsTokenCount\":45,\"cachedContentTokenCount\":80}}";
  #assert flawed_wire_parse_gemini_sse(multi, 0, ev[..], tb[..], sb[..], sn[..]) == 3;
  #assert ev[0].kind == FLAWED_SSE_THINK_DELTA && cast(string) tb[0..<ev[0].text_n] == "Thinking..." && sn[0] == 0;
  #assert ev[0].input_tokens == 120 && ev[0].output_tokens == 75 && ev[0].cache_read_tokens == 80 && ev[0].stop_reason == FLAWED_STOP_END_TURN;

  #assert flawed_wire_parse_gemini_sse(multi, 1, ev[..], tb[..], sb[..], sn[..]) == 3;
  #assert ev[0].kind == FLAWED_SSE_TEXT_DELTA && cast(string) tb[0..<ev[0].text_n] == "H";

  #assert flawed_wire_parse_gemini_sse(multi, 2, ev[..], tb[..], sb[..], sn[..]) == 3;
  #assert ev[0].kind == FLAWED_SSE_OAI_TOOL_DELTA && ev[0].block_index == 2;
  #assert cast(string) ev[0].name_buf[0..<ev[0].name_n] == "Read" && cast(string) ev[0].id_buf[0..<ev[0].id_n] == "call_7";
  #assert cast(string) tb[0..<ev[0].text_n] == "{\"file_path\":\"a.coax\"}" && cast(string) sb[0..<sn[0]] == "SIG_ABC";

  // Out-of-bounds part_idx still preserves metadata as MSG_DELTA
  #assert flawed_wire_parse_gemini_sse(multi, 3, ev[..], tb[..], sb[..], sn[..]) == 0 && ev[0].kind == FLAWED_SSE_MSG_DELTA;
  #assert flawed_wire_parse_gemini_sse(multi, -1, ev[..], tb[..], sb[..], sn[..]) == 0 && ev[0].kind == FLAWED_SSE_MSG_DELTA;

  // Function call without args defaults to "{}"
  no_args := "{\"candidates\":[{\"content\":{\"parts\":[{\"functionCall\":{\"name\":\"Ping\"}}]}}]}";
  #assert flawed_wire_parse_gemini_sse(no_args, 0, ev[..], tb[..], sb[..], sn[..]) == 1;
  #assert ev[0].kind == FLAWED_SSE_OAI_TOOL_DELTA && cast(string) tb[0..<ev[0].text_n] == "{}" && ev[0].cache_read_tokens == 0;

  // Trailing single-byte signature-only empty text part
  sig_only := "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"\",\"thoughtSignature\":\"S\"}]},\"finishReason\":\"MAX_TOKENS\"}]}";
  #assert flawed_wire_parse_gemini_sse(sig_only, 0, ev[..], tb[..], sb[..], sn[..]) == 1;
  #assert ev[0].kind == FLAWED_SSE_SIG_DELTA && cast(string) sb[0..<sn[0]] == "S" && ev[0].stop_reason == FLAWED_STOP_MAX_TOKENS;

  // Empty text part with finishReason/usage -> MSG_DELTA; without metadata -> NONE
  fin_empty := "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"\"}]},\"finishReason\":\"SAFETY\"}]}";
  #assert flawed_wire_parse_gemini_sse(fin_empty, 0, ev[..], tb[..], sb[..], sn[..]) == 1 && ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].stop_reason == FLAWED_STOP_REFUSAL;
  #assert flawed_wire_parse_gemini_sse("{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"\"}]}}]}", 0, ev[..], tb[..], sb[..], sn[..]) == 1 && ev[0].kind == FLAWED_SSE_NONE;

  // Metadata-only chunk (no parts): prompt only, output only, or completely empty
  #assert flawed_wire_parse_gemini_sse("{\"usageMetadata\":{\"promptTokenCount\":1}}", 0, ev[..], tb[..], sb[..], sn[..]) == 0 && ev[0].kind == FLAWED_SSE_MSG_DELTA;
  #assert flawed_wire_parse_gemini_sse("{\"usageMetadata\":{\"candidatesTokenCount\":1}}", 0, ev[..], tb[..], sb[..], sn[..]) == 0 && ev[0].kind == FLAWED_SSE_MSG_DELTA;
  #assert flawed_wire_parse_gemini_sse("{}", 0, ev[..], tb[..], sb[..], sn[..]) == 0 && ev[0].kind == FLAWED_SSE_NONE;
}

#test "wire: OpenAI/Psionic SSE parser and OpenAI+Gemini tool schema serialization" {
  ev: [1] FlawedWireSseEvent;
  tb: [256] u8;
  #assert !flawed_wire_parse_openai_sse("{}", ev[0..<0], tb[..]);
  #assert !flawed_wire_parse_openai_sse("", ev[..], tb[..]) && !flawed_wire_parse_openai_sse("{bad", ev[..], tb[..]) && !flawed_wire_parse_openai_sse("[]", ev[..], tb[..]);
  #assert flawed_wire_parse_openai_sse("[DONE]", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_STOP;
  #assert flawed_wire_parse_openai_sse("{\"error\":{\"message\":\"rate limited\"}}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_ERROR && cast(string) tb[0..<ev[0].text_n] == "rate limited";

  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{\"reasoning_content\":\"t\"}}]}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_THINK_DELTA && cast(string) tb[0..<ev[0].text_n] == "t";
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{\"reasoning\":\"alt\"}}]}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_THINK_DELTA && cast(string) tb[0..<ev[0].text_n] == "alt";

  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{\"content\":\"h\"},\"finish_reason\":\"stop\"}]}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_TEXT_DELTA && cast(string) tb[0..<ev[0].text_n] == "h" && ev[0].stop_reason == FLAWED_STOP_END_TURN;

  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":2,\"id\":\"call_1\",\"function\":{\"name\":\"Bash\",\"arguments\":\"{\\\"command\\\":\\\"ls\\\"}\"}}]}}]}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_OAI_TOOL_DELTA && ev[0].block_index == 2 && cast(string) ev[0].id_buf[0..<ev[0].id_n] == "call_1";
  #assert cast(string) ev[0].name_buf[0..<ev[0].name_n] == "Bash" && cast(string) tb[0..<ev[0].text_n] == "{\"command\":\"ls\"}";
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"function\":{\"arguments\":\"a\"}}]}}]}", ev[..], tb[..]) && ev[0].block_index == 0;

  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].stop_reason == FLAWED_STOP_END_TURN;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"x\"}]}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].stop_reason == FLAWED_STOP_NONE;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"tool_calls\"}]}", ev[..], tb[..]) && ev[0].stop_reason == FLAWED_STOP_TOOL_USE;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{},\"finish_reason\":\"length\"}]}", ev[..], tb[..]) && ev[0].stop_reason == FLAWED_STOP_MAX_TOKENS;

  #assert flawed_wire_parse_openai_sse("{\"choices\":[],\"usage\":{\"prompt_tokens\":500,\"completion_tokens\":80,\"prompt_tokens_details\":{\"cached_tokens\":200}}}", ev[..], tb[..]);
  #assert ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].input_tokens == 500 && ev[0].output_tokens == 80 && ev[0].cache_read_tokens == 200;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":0}}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_DELTA && ev[0].cache_read_tokens == 0;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[],\"usage\":{\"prompt_tokens\":0,\"completion_tokens\":1}}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_MSG_DELTA;
  #assert flawed_wire_parse_openai_sse("{\"choices\":[{\"delta\":{}}]}", ev[..], tb[..]) && ev[0].kind == FLAWED_SSE_NONE;

  #assert flawed_wire_stop_reason("end_turn") == FLAWED_STOP_END_TURN && flawed_wire_stop_reason("tool_use") == FLAWED_STOP_TOOL_USE;
  #assert flawed_wire_stop_reason("max_tokens") == FLAWED_STOP_MAX_TOKENS && flawed_wire_stop_reason("refusal") == FLAWED_STOP_REFUSAL;
  #assert flawed_wire_stop_reason("RECITATION") == FLAWED_STOP_REFUSAL && flawed_wire_stop_reason("PROHIBITED_CONTENT") == FLAWED_STOP_REFUSAL;
  #assert flawed_wire_stop_reason("other") == FLAWED_STOP_NONE;

  // Tool schema serialization: Gemini functionDeclarations vs OpenAI function wrapper
  buf: [8192] u8;
  o: [1] Jo;
  nodes: [512] JvNode;
  d: [1] Jv;
  sb: [128] u8;

  // Gemini format with 1 tool disallowed -> 7 declarations inside [{"functionDeclarations":[...]}]
  jo_start(o[..], buf[..]);
  n1 := flawed_wire_write_tools(o[..], true, "", "WebFetch");
  #assert !o[0].bad && n1 == 7 && jv_parse(d[..], jo_text(o[..]), nodes[..]) && jv_kind(d[0], 0) == JV_ARRAY && jv_len(d[0], 0) == 1;
  decls := jv_get(d[0], jv_at(d[0], 0, 0), "functionDeclarations");
  #assert jv_kind(d[0], decls) == JV_ARRAY && jv_len(d[0], decls) == 7;
  t0 := jv_at(d[0], decls, 0);
  #assert jv_str(d[0], jv_get(d[0], t0, "name"), sb[..]) == 4 && cast(string) sb[0..<4] == "Read";
  #assert jv_str(d[0], jv_get(d[0], t0, "description"), sb[..]) > 10;
  #assert jv_kind(d[0], jv_get(d[0], t0, "parameters")) == JV_OBJECT;

  // OpenAI format -> function wrapper
  jo_start(o[..], buf[..]);
  n2 := flawed_wire_write_tools(o[..], false, "Read,Bash", "");
  #assert !o[0].bad && n2 == 2 && jv_parse(d[..], jo_text(o[..]), nodes[..]) && jv_len(d[0], 0) == 2;
  f1 := jv_at(d[0], 0, 1);
  #assert jv_str(d[0], jv_get(d[0], f1, "type"), sb[..]) == 8 && cast(string) sb[0..<8] == "function";
  fn1 := jv_get(d[0], f1, "function");
  #assert jv_str(d[0], jv_get(d[0], fn1, "name"), sb[..]) == 4 && cast(string) sb[0..<4] == "Bash";
  #assert jv_str(d[0], jv_get(d[0], fn1, "description"), sb[..]) > 10;
  #assert jv_kind(d[0], jv_get(d[0], fn1, "parameters")) == JV_OBJECT;

  // Empty allow result -> valid empty JSON
  jo_start(o[..], buf[..]);
  #assert flawed_wire_write_tools(o[..], false, "NoSuch", "") == 0 && !o[0].bad && jo_text(o[..]) == "[]";
}
