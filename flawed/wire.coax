// Flawed — Live LLM Wire Codec & Runtime Policy Authority.
// Pure, I/O-free, zero-heap serializer and streaming SSE parser for Local Psionic Metal
// (Inkling 2 Mini / OpenAI Chat Completions), Vertex AI & Gemini API (Gemini 4 Neon family
// native streamGenerateContent), and OpenRouter, plus Claude-Code-parity tool permission
// classification and endpoint/thinking resolution.
//
// Checks: coax/bin/coax test flawed/wire.coax --library
// Mutate: coax/bin/coax mutate flawed/wire.coax --root-only
#module "flawed.wire";
#load "../coax/lib/json/json.coax";
#load "permissions.coax";
#load "perm_match.coax";
#load "shell_sandbox.coax";
#load "api_policy.coax";
#authority;

FLAWED_BE_AUTO :: 0;
FLAWED_BE_LOCAL :: 1;
FLAWED_BE_VERTEX :: 2;
FLAWED_BE_GEMINI :: 3;
FLAWED_BE_OPENROUTER :: 4;

FLAWED_THINK_ADAPTIVE :: 0;
FLAWED_THINK_EXTENDED :: 1;
FLAWED_THINK_OFF :: 2;

FLAWED_SANDBOX_OFF :: 0;
FLAWED_SANDBOX_AUTO :: 1;
FLAWED_SANDBOX_ENFORCED :: 2;

FLAWED_CACHE_GLOBAL :: 0;
FLAWED_CACHE_ORG :: 1;
FLAWED_CACHE_OFF :: 2;

FLAWED_STYLE_DEFAULT :: 0;
FLAWED_STYLE_CONCISE :: 1;
FLAWED_STYLE_EXPLANATORY :: 2;
FLAWED_STYLE_LEARNING :: 3;

FLAWED_HOOKS_ALL :: 0;
FLAWED_HOOKS_MANAGED :: 1;
FLAWED_HOOKS_OFF :: 2;

FLAWED_SSE_NONE :: 0;
FLAWED_SSE_TEXT_DELTA :: 3;
FLAWED_SSE_THINK_DELTA :: 4;
FLAWED_SSE_SIG_DELTA :: 5;
FLAWED_SSE_MSG_DELTA :: 8;
FLAWED_SSE_MSG_STOP :: 9;
FLAWED_SSE_ERROR :: 10;
FLAWED_SSE_OAI_TOOL_DELTA :: 11;

FlawedWireSseEvent :: struct {
  kind: int;
  block_index: int;
  text_n: int;
  id_buf: [128] u8; id_n: int;
  name_buf: [64] u8; name_n: int;
  stop_reason: int;
  input_tokens: int;
  output_tokens: int;
  cache_read_tokens: int;
}

flawed_aw_copy :: (dst: [] u8, src: string) -> int #effects(all) {
  n := ifx src.count < dst.count then src.count else dst.count; // mutant: equivalent (when src.count == dst.count both branches equal dst.count)
  for i: 0..<n { dst[i] = src[i]; }
  return n;
}

flawed_aw_cat :: (dst: [] u8, at: int, src: string) -> int #effects(all) {
  n := at;
  if n < 0 { return 0; }
  for c: src {
    if n >= dst.count { return n; } // mutant: equivalent (n grows by 1 from <= dst.count, so > never precedes ==)
    dst[n] = c;
    n += 1;
  }
  return n;
}

flawed_aw_starts :: (s: string, pre: string) -> bool #effects(all) {
  if s.count < pre.count { return false; }
  for i: 0..<pre.count { if s[i] != pre[i] { return false; } }
  return true;
}

flawed_aw_ends :: (s: string, suf: string) -> bool #effects(all) {
  if s.count < suf.count { return false; }
  off := s.count - suf.count;
  for i: 0..<suf.count { if s[off + i] != suf[i] { return false; } }
  return true;
}

flawed_aw_lower :: (c: u8) -> u8 #effects(all) {
  return ifx c >= 'A' && c <= 'Z' then cast(u8) (c + 32) else c;
}

flawed_aw_eq_ci :: (a: string, b: string) -> bool #effects(all) {
  if a.count != b.count { return false; }
  for i: 0..<a.count { if flawed_aw_lower(a[i]) != flawed_aw_lower(b[i]) { return false; } }
  return true;
}

flawed_aw_trim_slash :: (s: string) -> string #effects(all) {
  b := s;
  while b.count > 1 && b[b.count - 1] == '/' { b = cast(string) b[0..<b.count - 1]; }
  return b;
}

flawed_wire_strip_model :: (raw: string) -> string #effects(all) {
  s := raw;
  if flawed_aw_starts(s, "flawed:") { s = cast(string) s[7..<s.count]; }
  if flawed_aw_ends(s, "[1m]") { s = cast(string) s[0..<s.count - 4]; }
  return s;
}

flawed_wire_is_local_model :: (raw: string) -> bool #effects(all) {
  m := flawed_wire_strip_model(raw);
  return flawed_aw_starts(m, "inkling") || m == "local" || m == "hybrid-exec-v1";
}

flawed_wire_is_gemini :: (backend: int) -> bool #effects(all) {
  return backend == FLAWED_BE_VERTEX || backend == FLAWED_BE_GEMINI;
}

flawed_wire_gemini_model :: (raw: string, out: [] u8) -> int #effects(all) {
  m := flawed_wire_strip_model(raw);
  if flawed_aw_starts(m, "google/") { m = cast(string) m[7..<m.count]; }
  if m.count == 0 || flawed_wire_is_local_model(m) { return flawed_aw_copy(out, "gemini-4-neon"); }
  return flawed_aw_copy(out, m);
}

flawed_wire_openrouter_model :: (raw: string, out: [] u8) -> int #effects(all) {
  m := flawed_wire_strip_model(raw);
  if m.count == 0 || flawed_wire_is_local_model(m) { return flawed_aw_copy(out, "google/gemini-4-neon"); }
  for c: m { if c == '/' { return flawed_aw_copy(out, m); } }
  n := flawed_aw_cat(out, 0, "google/");
  return flawed_aw_cat(out, n, m);
}

flawed_wire_endpoint_url :: (backend: int, base_url: string, local_base: string, project: string, location: string, model: string, out: [] u8) -> int #effects(all) {
  if backend == FLAWED_BE_LOCAL {
    b := flawed_aw_trim_slash(ifx local_base.count > 0 then local_base else "http://127.0.0.1:8080");
    if flawed_aw_ends(b, "/chat/completions") { return flawed_aw_copy(out, b); }
    n := flawed_aw_cat(out, 0, b);
    if flawed_aw_ends(b, "/v1") { return flawed_aw_cat(out, n, "/chat/completions"); }
    return flawed_aw_cat(out, n, "/v1/chat/completions");
  }
  if backend == FLAWED_BE_OPENROUTER {
    b := flawed_aw_trim_slash(ifx base_url.count > 0 then base_url else "https://openrouter.ai/api/v1");
    if flawed_aw_ends(b, "/chat/completions") { return flawed_aw_copy(out, b); }
    n := flawed_aw_cat(out, 0, b);
    return flawed_aw_cat(out, n, "/chat/completions");
  }
  mb: [128] u8;
  mn := flawed_wire_gemini_model(model, mb[..]);
  gm := cast(string) mb[0..<mn];
  if backend == FLAWED_BE_GEMINI {
    b := flawed_aw_trim_slash(ifx base_url.count > 0 then base_url else "https://generativelanguage.googleapis.com");
    if flawed_aw_ends(b, ":streamGenerateContent?alt=sse") { return flawed_aw_copy(out, b); }
    n := flawed_aw_cat(out, 0, b);
    n = flawed_aw_cat(out, n, "/v1beta/models/");
    n = flawed_aw_cat(out, n, gm);
    return flawed_aw_cat(out, n, ":streamGenerateContent?alt=sse");
  }
  // FLAWED_BE_VERTEX (native streamGenerateContent?alt=sse on us/eu multi-region, global, or regional)
  proj := ifx project.count > 0 then project else "openagentsgemini";
  loc := ifx location.count > 0 then location else "us";
  n := 0; // mutant: equivalent (both branches below overwrite n before reading it)
  if base_url.count > 0 {
    b := flawed_aw_trim_slash(base_url);
    if flawed_aw_ends(b, ":streamGenerateContent?alt=sse") { return flawed_aw_copy(out, b); }
    n = flawed_aw_cat(out, 0, b);
  } else {
    n = flawed_aw_cat(out, 0, "https://");
    if loc == "us" || loc == "eu" {
      n = flawed_aw_cat(out, n, "aiplatform.");
      n = flawed_aw_cat(out, n, loc);
      n = flawed_aw_cat(out, n, ".rep.googleapis.com");
    } else if loc == "global" {
      n = flawed_aw_cat(out, n, "aiplatform.googleapis.com");
    } else {
      n = flawed_aw_cat(out, n, loc);
      n = flawed_aw_cat(out, n, "-aiplatform.googleapis.com");
    }
  }
  n = flawed_aw_cat(out, n, "/v1/projects/");
  n = flawed_aw_cat(out, n, proj);
  n = flawed_aw_cat(out, n, "/locations/");
  n = flawed_aw_cat(out, n, loc);
  n = flawed_aw_cat(out, n, "/publishers/google/models/");
  n = flawed_aw_cat(out, n, gm);
  return flawed_aw_cat(out, n, ":streamGenerateContent?alt=sse");
}

flawed_wire_gemini_level :: (effort: string) -> string #effects(all) {
  if effort == "low" { return "low"; }
  if effort == "medium" { return "medium"; }
  return "high";
}

flawed_wire_local_effort :: (thinking_mode: int, effort: string) -> string #effects(all) {
  if thinking_mode == FLAWED_THINK_OFF { return "none"; }
  if effort == "low" || effort == "medium" || effort == "high" || effort == "xhigh" || effort == "max" { return effort; }
  return "high";
}

flawed_wire_max_tokens :: (thinking_mode: int, effort: string, is_local: bool) -> int #effects(all) {
  if is_local {
    if thinking_mode == FLAWED_THINK_OFF || effort == "low" { return 4096; }
    return 8192;
  }
  if thinking_mode == FLAWED_THINK_OFF || effort == "low" { return 16384; }
  if effort == "medium" { return 24576; }
  if effort == "xhigh" { return 49152; }
  if effort == "max" { return 65536; }
  return 32768;
}

flawed_wire_csv_has :: (csv: string, name: string) -> bool #effects(all) {
  if csv.count == 0 || name.count == 0 { return false; } // mutant: equivalent (loop skips empty csv, eq_ci fails empty name)
  i := 0;
  while i < csv.count {
    while i < csv.count && (csv[i] == ',' || csv[i] == ' ' || csv[i] == '\t') { i += 1; }
    start := i;
    while i < csv.count && csv[i] != ',' { i += 1; }
    end := i;
    while end > start && (csv[end - 1] == ' ' || csv[end - 1] == '\t') { end -= 1; } // mutant: equivalent (csv[start] is non-space when end == start, loop already terminates)
    if end > start && flawed_aw_eq_ci(cast(string) csv[start..<end], name) { return true; } // mutant: equivalent (name.count > 0 so empty slice never matches)
  }
  return false;
}

flawed_wire_tool_allowed :: (tool_name: string, allowed_csv: string, disallowed_csv: string) -> bool #effects(all) {
  if tool_name.count == 0 { return false; }
  if flawed_wire_csv_has(disallowed_csv, tool_name) { return false; }
  if allowed_csv.count > 0 && !flawed_wire_csv_has(allowed_csv, tool_name) { return false; }
  return true;
}

flawed_wire_tool_permission :: (tool_name: string, target: string, pmode: int, bypass_danger: bool, session_allow: bool) -> int #effects(all) {
  // Default Allow All (FLAWED_PMODE_BYPASS) and explicit bypass approve everything with zero permission checks.
  if bypass_danger || pmode == FLAWED_PMODE_BYPASS { return FLAWED_PBEH_ALLOW; }
  if tool_name == "Read" || tool_name == "Glob" || tool_name == "Grep" || tool_name == "TodoWrite" {
    return FLAWED_PBEH_ALLOW;
  }
  if tool_name == "WebFetch" {
    if pmode == FLAWED_PMODE_AUTO || pmode == FLAWED_PMODE_ACCEPT_EDITS || pmode == FLAWED_PMODE_DONT_ASK || session_allow {
      return FLAWED_PBEH_ALLOW;
    }
    return FLAWED_PBEH_ASK;
  }
  if tool_name == "Edit" || tool_name == "Write" {
    ps := flawed_check_path_safety_for_auto_edit(target);
    if !ps.safe {
      return ifx pmode == FLAWED_PMODE_DONT_ASK then FLAWED_PBEH_DENY else FLAWED_PBEH_ASK;
    }
    if pmode == FLAWED_PMODE_PLAN { return FLAWED_PBEH_DENY; }
    if pmode == FLAWED_PMODE_AUTO || pmode == FLAWED_PMODE_ACCEPT_EDITS || pmode == FLAWED_PMODE_DONT_ASK || session_allow {
      return FLAWED_PBEH_ALLOW;
    }
    return FLAWED_PBEH_ASK;
  }
  if tool_name == "Bash" {
    if !flawed_bash_precheck_safe(target) {
      return ifx pmode == FLAWED_PMODE_DONT_ASK then FLAWED_PBEH_DENY else FLAWED_PBEH_ASK;
    }
    if pmode == FLAWED_PMODE_PLAN { return FLAWED_PBEH_ASK; }
    if pmode == FLAWED_PMODE_AUTO { return FLAWED_PBEH_ALLOW; }
    if pmode == FLAWED_PMODE_DONT_ASK { return ifx session_allow then FLAWED_PBEH_ALLOW else FLAWED_PBEH_DENY; }
    return ifx session_allow then FLAWED_PBEH_ALLOW else FLAWED_PBEH_ASK;
  }
  return FLAWED_PBEH_ASK;
}

flawed_wire_stop_reason :: (s: string) -> int #effects(all) {
  if s == "end_turn" || s == "stop" || s == "STOP" { return FLAWED_STOP_END_TURN; }
  if s == "tool_use" || s == "tool_calls" { return FLAWED_STOP_TOOL_USE; }
  if s == "max_tokens" || s == "length" || s == "MAX_TOKENS" { return FLAWED_STOP_MAX_TOKENS; }
  if s == "refusal" || s == "SAFETY" || s == "RECITATION" || s == "PROHIBITED_CONTENT" { return FLAWED_STOP_REFUSAL; }
  return FLAWED_STOP_NONE;
}

flawed_aw_str :: (v: Jv, node: int, out: [] u8) -> int #effects(all) {
  n := jv_str(v, node, out);
  return ifx n > 0 then n else 0; // mutant: equivalent (when n == 0 both branches return 0)
}

// Parses part `part_idx` of a Vertex AI / Gemini native streamGenerateContent SSE JSON chunk.
// Returns total part count (>= 1) when candidates[0].content.parts is non-empty, 0 for error
// or metadata-only chunks, or -1 on malformed input / empty output slices.
flawed_wire_parse_gemini_sse :: (data_json: string, part_idx: int, out_ev: [] FlawedWireSseEvent, txt_buf: [] u8, sig_buf: [] u8, out_sig_n: [] int) -> int #effects(all) {
  if out_ev.count < 1 || out_sig_n.count < 1 { return -1; }
  out_ev[0] = FlawedWireSseEvent.{};
  out_sig_n[0] = 0;
  nodes: [512] JvNode;
  d: [1] Jv;
  if !jv_parse(d[..], data_json, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return -1; } // mutant: equivalent (jv_parse fails -> jv_kind == 0 != JV_OBJECT)
  v := d[0];

  err := jv_get(v, 0, "error");
  if jv_kind(v, err) == JV_OBJECT {
    out_ev[0].kind = FLAWED_SSE_ERROR;
    out_ev[0].text_n = flawed_aw_str(v, jv_get(v, err, "message"), txt_buf);
    return 0;
  }

  um := jv_get(v, 0, "usageMetadata");
  out_ev[0].input_tokens = jv_int(v, jv_get(v, um, "promptTokenCount"), 0);
  cand_tok := jv_int(v, jv_get(v, um, "candidatesTokenCount"), 0);
  th_tok := jv_int(v, jv_get(v, um, "thoughtsTokenCount"), 0);
  out_ev[0].output_tokens = cand_tok + th_tok;
  out_ev[0].cache_read_tokens = jv_int(v, jv_get(v, um, "cachedContentTokenCount"), 0);

  c0 := jv_at(v, jv_get(v, 0, "candidates"), 0);
  fb: [32] u8;
  fn := flawed_aw_str(v, jv_get(v, c0, "finishReason"), fb[..]);
  out_ev[0].stop_reason = flawed_wire_stop_reason(cast(string) fb[0..<fn]);

  parts := jv_get(v, jv_get(v, c0, "content"), "parts");
  nparts := jv_len(v, parts);
  has_meta := out_ev[0].stop_reason != FLAWED_STOP_NONE || out_ev[0].input_tokens > 0 || out_ev[0].output_tokens > 0;
  if nparts <= 0 || part_idx < 0 || part_idx >= nparts { // mutant: equivalent (jv_len returns >= 0 so nparts < 0 is unreachable)
    if has_meta { out_ev[0].kind = FLAWED_SSE_MSG_DELTA; }
    return 0;
  }

  p := jv_at(v, parts, part_idx);
  out_sig_n[0] = flawed_aw_str(v, jv_get(v, p, "thoughtSignature"), sig_buf);

  fc := jv_get(v, p, "functionCall");
  if jv_kind(v, fc) == JV_OBJECT {
    out_ev[0].kind = FLAWED_SSE_OAI_TOOL_DELTA;
    out_ev[0].block_index = part_idx;
    out_ev[0].name_n = flawed_aw_str(v, jv_get(v, fc, "name"), out_ev[0].name_buf[..]);
    out_ev[0].id_n = flawed_aw_str(v, jv_get(v, fc, "id"), out_ev[0].id_buf[..]);
    args_n := jv_get(v, fc, "args");
    if jv_kind(v, args_n) == JV_OBJECT {
      out_ev[0].text_n = flawed_aw_copy(txt_buf, jv_raw(v, args_n));
    } else {
      out_ev[0].text_n = flawed_aw_copy(txt_buf, "{}");
    }
    return nparts;
  }

  tn := flawed_aw_str(v, jv_get(v, p, "text"), txt_buf);
  if tn > 0 {
    is_th := jv_bool(v, jv_get(v, p, "thought"));
    out_ev[0].kind = ifx is_th then FLAWED_SSE_THINK_DELTA else FLAWED_SSE_TEXT_DELTA;
    out_ev[0].text_n = tn;
    return nparts;
  }
  if out_sig_n[0] > 0 {
    out_ev[0].kind = FLAWED_SSE_SIG_DELTA;
    return nparts;
  }
  if has_meta { out_ev[0].kind = FLAWED_SSE_MSG_DELTA; }
  return nparts;
}

// Parses one OpenAI / Local Psionic Metal / OpenRouter Chat Completions SSE chunk.
flawed_wire_parse_openai_sse :: (data_json: string, out_ev: [] FlawedWireSseEvent, txt_buf: [] u8) -> bool #effects(all) {
  if out_ev.count < 1 { return false; }
  out_ev[0] = FlawedWireSseEvent.{};
  if data_json == "[DONE]" {
    out_ev[0].kind = FLAWED_SSE_MSG_STOP;
    return true;
  }
  nodes: [256] JvNode;
  d: [1] Jv;
  if !jv_parse(d[..], data_json, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; } // mutant: equivalent (jv_parse fails -> jv_kind == 0 != JV_OBJECT)
  v := d[0];

  err := jv_get(v, 0, "error");
  if jv_kind(v, err) == JV_OBJECT {
    out_ev[0].kind = FLAWED_SSE_ERROR;
    out_ev[0].text_n = flawed_aw_str(v, jv_get(v, err, "message"), txt_buf);
    return true;
  }

  u := jv_get(v, 0, "usage");
  out_ev[0].input_tokens = jv_int(v, jv_get(v, u, "prompt_tokens"), 0);
  out_ev[0].output_tokens = jv_int(v, jv_get(v, u, "completion_tokens"), 0);
  out_ev[0].cache_read_tokens = jv_int(v, jv_get(v, jv_get(v, u, "prompt_tokens_details"), "cached_tokens"), 0);
  has_usage := out_ev[0].input_tokens > 0 || out_ev[0].output_tokens > 0;

  ch := jv_at(v, jv_get(v, 0, "choices"), 0);
  sb: [32] u8;
  sn := flawed_aw_str(v, jv_get(v, ch, "finish_reason"), sb[..]);
  out_ev[0].stop_reason = flawed_wire_stop_reason(cast(string) sb[0..<sn]);

  dl := jv_get(v, ch, "delta");
  rc := jv_get(v, dl, "reasoning_content");
  if rc < 0 { rc = jv_get(v, dl, "reasoning"); } // mutant: equivalent (node 0 is root object, child node index is always >= 1 or -1)
  rc_n := flawed_aw_str(v, rc, txt_buf);
  if rc_n > 0 {
    out_ev[0].kind = FLAWED_SSE_THINK_DELTA;
    out_ev[0].text_n = rc_n;
    return true;
  }
  ct_n := flawed_aw_str(v, jv_get(v, dl, "content"), txt_buf);
  if ct_n > 0 {
    out_ev[0].kind = FLAWED_SSE_TEXT_DELTA;
    out_ev[0].text_n = ct_n;
    return true;
  }
  tc0 := jv_at(v, jv_get(v, dl, "tool_calls"), 0);
  if tc0 > 0 { // mutant: equivalent (node 0 is root object, array element node index is always >= 2 or -1)
    out_ev[0].kind = FLAWED_SSE_OAI_TOOL_DELTA;
    out_ev[0].block_index = jv_int(v, jv_get(v, tc0, "index"), 0);
    out_ev[0].id_n = flawed_aw_str(v, jv_get(v, tc0, "id"), out_ev[0].id_buf[..]);
    fn := jv_get(v, tc0, "function");
    out_ev[0].name_n = flawed_aw_str(v, jv_get(v, fn, "name"), out_ev[0].name_buf[..]);
    out_ev[0].text_n = flawed_aw_str(v, jv_get(v, fn, "arguments"), txt_buf);
    return true;
  }
  if sn > 0 || has_usage {
    out_ev[0].kind = FLAWED_SSE_MSG_DELTA;
  }
  return true;
}

flawed_wire_write_tool_one :: (o: [] Jo, gemini_fmt: bool, name: string, desc: string, schema_raw: string) #effects(all) {
  if gemini_fmt {
    jo_obj(o);
    jo_key(o, "name"); jo_str(o, name);
    jo_key(o, "description"); jo_str(o, desc);
    jo_key(o, "parameters"); jo_raw(o, schema_raw);
    jo_end(o);
  } else {
    jo_obj(o);
    jo_key(o, "type"); jo_str(o, "function");
    jo_key(o, "function"); jo_obj(o);
    jo_key(o, "name"); jo_str(o, name);
    jo_key(o, "description"); jo_str(o, desc);
    jo_key(o, "parameters"); jo_raw(o, schema_raw);
    jo_end(o);
    jo_end(o);
  }
}

FLAWED_WIRE_NTOOLS :: 8;

flawed_wire_write_tools :: (o: [] Jo, gemini_fmt: bool, allowed_csv: string, disallowed_csv: string) -> int #effects(all) {
  names := [FLAWED_WIRE_NTOOLS] string.["Read", "Edit", "Write", "Bash", "Glob", "Grep", "TodoWrite", "WebFetch"];
  descs := [FLAWED_WIRE_NTOOLS] string.[
    "Read a file from the filesystem with optional 1-based offset and line limit.",
    "Perform exact string replacement inside an existing file (read the file first).",
    "Create a new file or overwrite an existing file with complete contents.",
    "Execute a shell command in the working directory and return stdout/stderr and exit code.",
    "Find files matching a glob pattern (e.g. **/*.coax, src/*.swift).",
    "Search file contents for a regex or literal pattern across the workspace.",
    "Update the task checklist displayed to the user.",
    "Fetch text content from an http(s) URL (SSRF-protected).",
  ];
  schemas := [FLAWED_WIRE_NTOOLS] string.[
    "{\"type\":\"object\",\"properties\":{\"file_path\":{\"type\":\"string\"},\"offset\":{\"type\":\"integer\"},\"limit\":{\"type\":\"integer\"}},\"required\":[\"file_path\"]}",
    "{\"type\":\"object\",\"properties\":{\"file_path\":{\"type\":\"string\"},\"old_string\":{\"type\":\"string\"},\"new_string\":{\"type\":\"string\"},\"replace_all\":{\"type\":\"boolean\"}},\"required\":[\"file_path\",\"old_string\",\"new_string\"]}",
    "{\"type\":\"object\",\"properties\":{\"file_path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"file_path\",\"content\"]}",
    "{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"timeout\":{\"type\":\"integer\"},\"description\":{\"type\":\"string\"}},\"required\":[\"command\"]}",
    "{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"}},\"required\":[\"pattern\"]}",
    "{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"glob\":{\"type\":\"string\"},\"head_limit\":{\"type\":\"integer\"}},\"required\":[\"pattern\"]}",
    "{\"type\":\"object\",\"properties\":{\"todos\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"activeForm\":{\"type\":\"string\"}},\"required\":[\"content\",\"status\"]}}},\"required\":[\"todos\"]}",
    "{\"type\":\"object\",\"properties\":{\"url\":{\"type\":\"string\"}},\"required\":[\"url\"]}",
  ];
  if gemini_fmt {
    jo_arr(o);
    jo_obj(o);
    jo_key(o, "functionDeclarations");
    jo_arr(o);
  } else {
    jo_arr(o);
  }
  emitted := 0;
  for i: 0..<FLAWED_WIRE_NTOOLS {
    if !flawed_wire_tool_allowed(names[i], allowed_csv, disallowed_csv) { continue; }
    flawed_wire_write_tool_one(o, gemini_fmt, names[i], descs[i], schemas[i]);
    emitted += 1;
  }
  if gemini_fmt {
    jo_end(o);
    jo_end(o);
    jo_end(o);
  } else {
    jo_end(o);
  }
  return emitted;
}

