// What an agent did, as the person reads it (GitHub issue 5, phase 2; docs/agents.md, "What
// an agent did"): its events (agent-record.coax's gamebuilder.agent.event.v1) as a timeline of
// cards, the one live line of what it is doing now, the meter of its turns and its budget
// against their limits, and the text field the person types in. The Agents pane
// (agents.coax) keeps the events and draws them with these; nothing here runs an agent.
//
//   - A card a type: the person's message and the agent's, a tool call folded to one line
//     (tap it for its arguments and result), a change with its summary, Show me and Undo
//     this, an ask, its answer, a state, usage and an error. A type this file does not know
//     yet is drawn as its type's word and its text, so a new one shows before it has a card.
//   - The field: an EditBuf (components/core/edit.coax) with its caret and selection drawn
//     here; arrows, Shift to select, Option for words, Command for lines and the ends, and
//     Command-A, Z and Shift-Z.
//   scripts/check.sh
#load "../../components/core/edit.coax";

// ---- limits (each said in words, with its number, where it shows)
ATL_CARDS :: 96;           // events the pane keeps for all its agents; the oldest go first, and the timeline says so
ATL_WHO :: 16;             // agents a ring tells apart
ATL_ARGS_SHOWN :: 600;     // bytes of a tool call's arguments an unfolded card shows
ATL_FIELD_LINES :: 32;     // lines a field lays out (it shows its last ones)

AtlRing :: struct {
  ev: [ATL_CARDS] AgrEvent;
  who: [ATL_CARDS] int;      // whose: the pane's agent index; -1 for a slot no one's
  open: [ATL_CARDS] bool;    // a tool card unfolded
  undone: [ATL_CARDS] bool;  // a change card the person took back
  at: int;                   // the next slot written
  n: int;                    // slots filled
  cut: [ATL_WHO] bool;       // an agent's oldest events went to make room
}

// A new event of who's, at the end: its slot, its fields the caller's to fill.
atl_add :: (r: [] AtlRing, who: int, type: int) -> int {
  k := r[0].at;
  if r[0].n == ATL_CARDS {
    old := r[0].who[k];
    if old >= 0 && old < ATL_WHO { r[0].cut[old] = true; }
  } else { r[0].n += 1; }
  r[0].ev[k] = agr_event(type);
  r[0].who[k] = who; r[0].open[k] = false; r[0].undone[k] = false;
  r[0].at = (k + 1) % ATL_CARDS;
  return k;
}
// The slot of the i-th filled event, oldest first.
atl_slot :: (r: [] AtlRing, i: int) -> int { return (r[0].at - r[0].n + i + 2 * ATL_CARDS) % ATL_CARDS; }
// who's events are gone (its place is another agent's now).
atl_forget :: (r: [] AtlRing, who: int) {
  for i: 0..<ATL_CARDS { if r[0].who[i] == who { r[0].who[i] = -1; } }
  if who >= 0 && who < ATL_WHO { r[0].cut[who] = false; }
}
// who's last event's slot, of type (-1: any), or -1.
atl_last :: (r: [] AtlRing, who: int, type: int) -> int {
  i := r[0].n;
  while i > 0 {
    i -= 1;
    k := atl_slot(r, i);
    if r[0].who[k] == who && (type < 0 || r[0].ev[k].type == type) { return k; }
  }
  return -1;
}
// How many of who's events the ring holds.
atl_count :: (r: [] AtlRing, who: int) -> int {
  c := 0; for i: 0..<r[0].n { if r[0].who[atl_slot(r, i)] == who { c += 1; } }
  return c;
}
// The change card Undo this takes back: who's last change not taken back, or -1.
atl_undoable :: (r: [] AtlRing, who: int) -> int {
  i := r[0].n;
  while i > 0 {
    i -= 1;
    k := atl_slot(r, i);
    if r[0].who[k] == who && r[0].ev[k].type == AGR_EDIT && !r[0].undone[k] { return k; }
  }
  return -1;
}

// ---- words

// The first line of s, at most n bytes.
atl_first_line :: (s: string, n: int) -> string {
  k := 0; while k < s.count && s[k] != '\n' { k += 1; }
  return agr_cut(cast(string) s[0..<k], n);
}
// "$0.42": cents as dollars.
atl_dollars :: (out: [] u8, n: int, cents: int) -> int {
  m := agr_put(out, n, "$"); m = agr_int(out, m, cast(s64) (cents / 100)); m = agr_put(out, m, ".");
  c := cents % 100; if c < 10 { m = agr_put(out, m, "0"); }
  return agr_int(out, m, cast(s64) c);
}
// The meter's words: "Turn 3 of 20 - $0.42 of $2.00 of your Claude plan".
atl_meter_words :: (turns: int, turn_limit: int, cents: int, cent_limit: int, out: [] u8) -> string {
  n := agr_put(out, 0, "Turn "); n = agr_int(out, n, cast(s64) turns); n = agr_put(out, n, " of "); n = agr_int(out, n, cast(s64) turn_limit);
  n = agr_put(out, n, " - "); n = atl_dollars(out, n, cents); n = agr_put(out, n, " of "); n = atl_dollars(out, n, cent_limit);
  n = agr_put(out, n, " of your Claude plan");
  return cast(string) out[0..<n];
}
// How full the meter is: the nearer of its two limits.
atl_meter_share :: (turns: int, turn_limit: int, cents: int, cent_limit: int) -> f32 {
  a := ifx turn_limit > 0 then cast(f32) turns / cast(f32) turn_limit else 0.0f32;
  b := ifx cent_limit > 0 then cast(f32) cents / cast(f32) cent_limit else 0.0f32;
  s := ifx a > b then a else b;
  return ifx s > 1 then 1.0f32 else ifx s < 0 then 0.0f32 else s;
}

// What it is doing now, in one line (the row's), from its last event: "" for none.
atl_step :: (r: [] AtlRing, who: int, out: [] u8) -> string {
  k := atl_last(r, who, -1);
  while k >= 0 && r[0].ev[k].type == AGR_USAGE {
    // usage is the meter's: the step is the event before it
    j := -1; i := r[0].n;
    while i > 0 { i -= 1; s := atl_slot(r, i); if s == k { break; } }
    while i > 0 { i -= 1; s := atl_slot(r, i); if r[0].who[s] == who { j = s; break; } }
    k = j;
  }
  if k < 0 { return ""; }
  ev := r[0].ev[k];
  text := cast(string) r[0].ev[k].text[0..<ev.text_n];
  n := 0;
  t := ev.type;
  if t == AGR_MESSAGE { n = agr_put(out, 0, ifx ev.from == AGR_PERSON then "Read your message" else "Said: "); if ev.from == AGR_AGENT { n = agr_put(out, n, atl_first_line(text, AGR_STEP)); } }
  else if t == AGR_TOOL {
    n = agr_put(out, 0, ifx ev.ok then "Used " else "Was refused ");
    n = agr_put(out, n, cast(string) r[0].ev[k].tool[0..<ev.tool_n]);
  }
  else if t == AGR_EDIT { n = agr_put(out, 0, "Changed the level: "); n = agr_put(out, n, text); }
  else if t == AGR_ASK { n = agr_put(out, 0, "Asked: "); n = agr_put(out, n, text); }
  else if t == AGR_ANSWER { n = agr_put(out, 0, "You answered: "); n = agr_put(out, n, text); }
  else if t == AGR_STATE {
    n = agr_put(out, 0, AGR_STATE_WORDS[ev.state]);
    if text.count > 0 { n = agr_put(out, n, ": "); n = agr_put(out, n, text); }
  }
  else { n = agr_put(out, 0, text); }
  return agr_cut(atl_first_line(cast(string) out[0..<n], AGR_STEP), AGR_STEP);
}

// A card's heading: who or what.
atl_title :: (ev: AgrEvent, agent_name: string) -> string {
  t := ev.type;
  if t == AGR_MESSAGE { return ifx ev.from == AGR_PERSON then "You" else agent_name; }
  if t == AGR_EDIT { return "Changed the level"; }
  if t == AGR_ASK { return "Asks you"; }
  if t == AGR_ANSWER { return "You answered"; }
  if t == AGR_USAGE { return "Used"; }
  if t == AGR_ERROR { return "Could not go on"; }
  if t == AGR_WORKTREE { return "Its folder"; }
  if t == AGR_BRANCH { return "Its branch"; }
  if t == AGR_PULL { return "Its pull request"; }
  if t == AGR_FILES { return "Files it changed"; }
  if t == AGR_CHECK { return ifx ev.ok then "A check passed" else "A check failed"; }
  if t == AGR_PIN { return "The pin"; }
  if t >= 0 && t < AGR_TYPES { return AGR_TYPE_ID[t]; }
  return "event";
}
// A Code agent's step event in words, when it has no text of its own.
atl_code_words :: (event: AgrEvent, out: [] u8) -> string {
  ev := event; n := 0; t := ev.type;
  repo := ifx ev.repo >= 0 && ev.repo < AGR_REPOS then AGR_REPO_GITHUB[ev.repo] else "";
  if t == AGR_WORKTREE {
    n = agr_put(out, n, "A worktree of "); n = agr_put(out, n, repo); n = agr_put(out, n, " from origin/main");
    if ev.commit_n > 0 { n = agr_put(out, n, " at "); n = agr_put(out, n, cast(string) ev.commit[0..<(ifx ev.commit_n > 10 then 10 else ev.commit_n)]); }
  }
  if t == AGR_BRANCH { n = agr_put(out, n, cast(string) ev.branch[0..<ev.branch_n]); }
  if t == AGR_PULL {
    n = agr_put(out, n, "#"); n = agr_int(out, n, cast(s64) ev.number);
    if ev.url_n > 0 { n = agr_put(out, n, " - "); n = agr_put(out, n, cast(string) ev.url[0..<ev.url_n]); }
  }
  if t == AGR_FILES { n = agr_int(out, n, cast(s64) ev.count); n = agr_put(out, n, ifx ev.count == 1 then " file" else " files"); }
  if t == AGR_CHECK { n = agr_put(out, n, cast(string) ev.name[0..<ev.name_n]); }
  if t == AGR_PIN && ev.url_n > 0 { n = agr_put(out, n, cast(string) ev.url[0..<ev.url_n]); }
  return cast(string) out[0..<n];
}

// ---- a card

// What a card's controls dispatch: each the base plus the card's slot (the pane's numbers).
AtlActs :: struct { fold: int; show: int; undo: int; }

atl_id :: (prefix: string, k: int, suffix: string, out: [] u8) -> string {
  n := agr_put(out, 0, prefix); n = agr_put(out, n, "."); n = agr_int(out, n, cast(s64) k); n = agr_put(out, n, suffix);
  return cast(string) out[0..<n];
}

// Card k of the ring at x, y, w wide; agent_name heads the agent's messages; undoable: this
// change is the one Undo this takes back. Returns its height.
// pl and e: where its pictures go, and the editor whose pictures they are (agent-replay.coax).
atl_card :: (f: [] UiFrame, r: [] AtlRing, k: int, agent_name: string, undoable: bool, acts: AtlActs, pl: [] AtlPics, e: [] Editor, x: f32, y: f32, w: f32) -> f32 {
  s := f[0].skin; m := f[0].m;
  ev := r[0].ev[k];
  text := cast(string) r[0].ev[k].text[0..<ev.text_n];
  t := ev.type;
  pad := s.space;
  ib: [32] u8;
  if t == AGR_TOOL {
    // one line, folded: the tool and how it went; tapped, its arguments and result
    tb: [160] u8;
    tn := agr_put(tb[..], 0, ifx r[0].open[k] then "v " else "> ");
    tn = agr_put(tb[..], tn, cast(string) r[0].ev[k].tool[0..<ev.tool_n]);
    tn = agr_put(tb[..], tn, ifx ev.ok then "" else " - refused");
    line := sheet_pool(f[0].sheet, cast(string) tb[0..<tn]);
    h := s.small.line;
    body := "";
    if r[0].open[k] {
      bb: [ATL_ARGS_SHOWN + AGR_RESULT + 32] u8;
      bn := agr_put(bb[..], 0, agr_cut(cast(string) r[0].ev[k].args[0..<ev.args_n], ATL_ARGS_SHOWN));
      if ev.args_n > ATL_ARGS_SHOWN || ev.cut { bn = agr_put(bb[..], bn, " ..."); }
      if ev.result_n > 0 { bn = agr_put(bb[..], bn, "\n= "); bn = agr_put(bb[..], bn, cast(string) r[0].ev[k].result[0..<ev.result_n]); }
      body = sheet_pool(f[0].sheet, cast(string) bb[0..<bn]);
      h += control_copy_lines(f[0].sheet, m, s.small, s.faint, x + pad, y + s.small.line, w - pad, body);
    }
    row := uiframe_semantic(f, atl_id("card", k, "", ib[..]), EL_BUTTON, line, x, y, w, h, ifx r[0].open[k] then EL_S_CURRENT else 0, acts.fold + k);
    _ := sheet_text(f[0].sheet, m, -1, x, y, s.small.line, s.small.face, ifx ev.ok then s.faint else s.danger, line);
    sheet_hit(f[0].sheet, UIFRAME_HIT, row, 0, x, y, w, h);
    // a play-test's card: what it saw, as a picture of the level (its paths, where bots stuck, what
    // nobody reached), under the line; a tool card that names a revision is one
    if ev.ok && ev.level > 0 && ev.after != 0 {
      h += s.space / 2;
      h += atl_pic(f, pl, e, atl_id("card", k, ".playtest", ib[..]), ev.level, ev.after, PIC_PLAYTEST, "What the play-test saw", x, y + h, ifx w > ATL_REPLAY_W then ATL_REPLAY_W else w);
    }
    return h;
  }
  if t == AGR_EDIT {
    // the change: its words, Show me, and Undo this while it is the one to take back
    tw := w - 2 * pad;
    th := control_copy(f[0].sheet, m, s.body, s.ink, x + pad, y + pad + s.small.line, tw, text);
    // the level before and after it, side by side (agent-replay.coax); measured on a sheet that is thrown away
    ph := atl_pics_change_height(f, tw);
    h := 2 * pad + s.small.line + th + s.space / 2 + ph + s.space / 2 + s.control_h;
    _ := sheet_box(f[0].sheet, x, y, w, h, s.radius_control, s.border, s.surface, ifx r[0].undone[k] then s.hairline else s.accent);
    _ := uiframe_semantic(f, atl_id("card", k, "", ib[..]), EL_TEXT, text, x, y, w, h, 0, 0);
    _ := sheet_text(f[0].sheet, m, -1, x + pad, y + pad, s.small.line, s.small.face, s.muted, ifx r[0].undone[k] then "Changed the level - you took it back" else "Changed the level");
    _ = control_copy(f[0].sheet, m, s.body, ifx r[0].undone[k] then s.muted else s.ink, x + pad, y + pad + s.small.line, tw, text);
    _ = atl_pics_change(f, pl, e, ev, k, x + pad, y + pad + s.small.line + th + s.space / 2, tw);
    by := y + pad + s.small.line + th + s.space / 2 + ph + s.space / 2;
    sw := ctx_button(f, atl_id("card", k, ".show", ib[..]), x + pad, by, "Show me", false, ifx r[0].undone[k] then EL_S_DISABLED else 0, acts.show + k);
    if undoable { _ := ctx_button(f, atl_id("card", k, ".undo", ib[..]), x + pad + sw + s.space / 2, by, "Undo this", false, 0, acts.undo); }
    return h;
  }
  if t == AGR_USAGE {
    ub: [96] u8;
    un := agr_put(ub[..], 0, "Used "); un = agr_int(ub[..], un, cast(s64) ev.turns); un = agr_put(ub[..], un, ifx ev.turns == 1 then " turn and " else " turns and ");
    un = atl_dollars(ub[..], un, cast(int) ev.cents); un = agr_put(ub[..], un, " of your plan");
    _ := sheet_text(f[0].sheet, m, -1, x, y, s.small.line, s.small.face, s.faint, sheet_pool(f[0].sheet, cast(string) ub[0..<un]));
    return s.small.line;
  }
  if t == AGR_STATE {
    sb: [AGR_TEXT + 32] u8;
    sn := agr_put(sb[..], 0, AGR_STATE_WORDS[ev.state]);
    if text.count > 0 { sn = agr_put(sb[..], sn, ": "); sn = agr_put(sb[..], sn, text); }
    if sn > 0 && sb[0] >= 'a' && sb[0] <= 'z' { sb[0] = sb[0] - 32; }
    return control_copy(f[0].sheet, m, s.small, ifx ev.state == AGR_FAILED then s.danger else s.muted, x, y, w, sheet_pool(f[0].sheet, cast(string) sb[0..<sn]));
  }
  // a Code agent's steps (issue 8, code-agent.coax): its folder, branch and pull request in words
  cb: [AGR_URL + AGR_REF + 96] u8;
  if text.count == 0 && t >= AGR_WORKTREE && t <= AGR_PIN { text = sheet_pool(f[0].sheet, atl_code_words(ev, cb[..])); }
  // a message, an ask, an answer, an error, and a type not drawn here yet: its heading and text
  person := t == AGR_MESSAGE && ev.from == AGR_PERSON;
  boxed := person || t == AGR_ASK || t == AGR_ANSWER;
  inset := ifx boxed then pad else 0.0f32;
  tw := w - 2 * inset;
  th := control_copy(f[0].sheet, m, s.body, s.ink, x + inset, y + inset + s.small.line, tw, text);
  h := 2 * inset + s.small.line + th;
  if boxed { _ := sheet_box(f[0].sheet, x, y, w, h, s.radius_control, s.border, ifx person then s.raised else s.surface, ifx t == AGR_ASK then AG_GOLD_TONE else s.hairline); }
  _ := uiframe_semantic(f, atl_id("card", k, "", ib[..]), EL_TEXT, text, x, y, w, h, 0, 0);
  _ := sheet_text(f[0].sheet, m, -1, x + inset, y + inset, s.small.line, s.small.face, ifx t == AGR_ERROR then s.danger else s.muted, atl_title(ev, agent_name));
  _ = control_copy(f[0].sheet, m, s.body, ifx t == AGR_ERROR then s.danger else s.ink, x + inset, y + inset + s.small.line, tw, text);
  return h;
}
AG_GOLD_TONE :: Rgba.{r = 1, g = 0.78, b = 0.2, a = 1};    // an ask waits on the person

// who's timeline, its last `shown` cards, from y: the note that older ones were cut first.
// Returns its height.
atl_timeline :: (f: [] UiFrame, r: [] AtlRing, who: int, agent_name: string, shown: int, acts: AtlActs, pl: [] AtlPics, e: [] Editor, x: f32, y: f32, w: f32) -> f32 {
  s := f[0].skin; m := f[0].m;
  total := atl_count(r, who);
  skip := ifx total > shown then total - shown else 0;
  top := y; at := y;
  if skip > 0 || (who >= 0 && who < ATL_WHO && r[0].cut[who]) {
    _ := sheet_text(f[0].sheet, m, -1, x, at, s.small.line, s.small.face, s.faint, "(earlier events are not shown here: the pane keeps the last 96 of all its agents)");
    at += s.small.line + s.space / 2;
  }
  last := atl_undoable(r, who);
  seen := 0;
  for i: 0..<r[0].n {
    k := atl_slot(r, i);
    if r[0].who[k] != who { continue; }
    seen += 1;
    if seen <= skip { continue; }
    at += atl_card(f, r, k, agent_name, k == last, acts, pl, e, x, at, w) + s.space / 2;
  }
  return at - top;
}

// ---- the meter

// The meter: its words over a bar as full as the nearer limit. Returns its height.
atl_meter :: (f: [] UiFrame, id: string, turns: int, turn_limit: int, cents: int, cent_limit: int, x: f32, y: f32, w: f32) -> f32 {
  s := f[0].skin; m := f[0].m;
  mb: [128] u8;
  words := sheet_pool(f[0].sheet, atl_meter_words(turns, turn_limit, cents, cent_limit, mb[..]));
  share := atl_meter_share(turns, turn_limit, cents, cent_limit);
  _ := sheet_text(f[0].sheet, m, -1, x, y, s.small.line, s.small.face, s.faint, words);
  h := s.small.line + s.space / 4;
  h += ctx_bar(f, id, x, y + h, w, words, share, ifx share >= 0.9 then s.warning else s.accent);
  return h;
}

// ---- the field

// The field's lines: where each starts and ends, wrapped to w.
atl_field_lines :: (m: TextMeasure, face: int, text: string, w: f32, out: [] TextLine) -> int {
  if text.count == 0 { out[0] = TextLine.{from = 0, to = 0}; return 1; }
  faces := TextFaces.{plain = face, bold = face, code = face};
  n := text_wrap_lines(m, faces, text, ifx w > 1 then w else 1.0f32, out);
  // a last line break leaves an empty line for the caret
  if n < out.count && text[text.count - 1] == '\n' { out[n] = TextLine.{from = text.count, to = text.count}; n += 1; }
  if n == 0 { out[0] = TextLine.{from = 0, to = 0}; n = 1; }
  return n;
}
// The line the byte at i is on.
atl_line_of :: (lines: [] TextLine, n: int, i: int) -> int {
  for k: 0..<n { if i < lines[k].to || (i == lines[k].to && (k == n - 1 || lines[k + 1].from > i)) { if i >= lines[k].from { return k; } } }
  return n - 1;
}

// A text field drawn here with its own caret and selection: the kit's field frame (its row,
// label and value for the accessibility tree), the text wrapped inside, the selection's wash
// and, while it has the keyboard, the caret. lines: the lines it is tall. Returns its height.
atl_field :: (f: [] UiFrame, id: string, eb: [] EditBuf, x: f32, y: f32, w: f32, label: string, placeholder: string, lines: int, focused: bool, state: int, action: int) -> f32 {
  s := f[0].skin; m := f[0].m;
  text := eb_text(eb);
  h := ctx_textarea(f, id, x, y, w, label, text, placeholder, lines, true, state, action);
  pad := s.chrome.field_pad;
  ix := x + pad; iy := y + pad; iw := w - 2 * pad; ih := h - 2 * pad;
  uiframe_clip(f, ix, iy, ix + iw, iy + ih);
  face := s.body.face; lh := s.body.line;
  if text.count == 0 {
    _ := sheet_text(f[0].sheet, m, -1, ix, iy, lh, face, s.faint, placeholder);
    if focused { sheet_fill(f[0].sheet, ix, iy, 2, lh, 0, s.accent); }
    uiframe_unclip(f);
    return h;
  }
  ls: [ATL_FIELD_LINES] TextLine;
  n := atl_field_lines(m, face, text, iw, ls[..]);
  caret := eb[0].caret;
  cl := atl_line_of(ls[..], n, caret);
  // the lines it shows: its last ones, and always the caret's
  rows := cast(int) (ih / lh); if rows < 1 { rows = 1; }
  first := ifx cl >= rows then cl - rows + 1 else 0;
  lo := eb_sel_lo(eb); hi := eb_sel_hi(eb);
  for k: first..<n {
    ly := iy + cast(f32) (k - first) * lh;
    if ly > iy + ih { break; }
    a := ls[k].from; b := ls[k].to;
    if focused && hi > lo && hi > a && lo <= b {
      sa := ifx lo > a then lo else a; sb := ifx hi < b then hi else b;
      x0 := ix + measure_width(m, face, cast(string) text[a..<sa]);
      x1 := ix + measure_width(m, face, cast(string) text[a..<sb]);
      if sb == b && hi > b { x1 += 4; }
      sheet_fill(f[0].sheet, x0, ly, x1 - x0, lh, 0, s.selection);
    }
    shown := b; while shown > a && (text[shown - 1] == '\n') { shown -= 1; }
    _ := sheet_text(f[0].sheet, m, -1, ix, ly, lh, face, s.ink, cast(string) text[a..<shown]);
  }
  if focused && cl >= first {
    cx := ix + measure_width(m, face, cast(string) text[ls[cl].from..<caret]);
    sheet_fill(f[0].sheet, cx, iy + cast(f32) (cl - first) * lh, 2, lh, 0, s.accent);
  }
  uiframe_unclip(f);
  return h;
}

// Typed text into the field, at most limit bytes in all: control characters but a line break
// are left out. True when it changed.
atl_field_type :: (eb: [] EditBuf, text: string, limit: int) -> bool {
  changed := false;
  for i: 0..<text.count {
    c := text[i];
    if c < 32 && c != '\n' { continue; }
    if eb[0].n - (eb_sel_hi(eb) - eb_sel_lo(eb)) + 1 > limit { break; }
    if eb_insert(eb, cast(string) text[i..<i + 1]) { changed = true; }
  }
  return changed;
}
// What a key did to the field.
ATL_KEY_NONE :: 0; ATL_KEY_TAKEN :: 1; ATL_KEY_ENTER :: 2; ATL_KEY_ESCAPE :: 3;
// A key (the shared host's numbering: -1 Escape, -2 Enter, -3 Backspace, -4 Left, -5 Right,
// -6 Up, -7 Down, -8 Home, -9 End; mods 1 Shift, 4 Option, 8 Command), in a field of lines
// laid out in the face at w (Up and Down move a line). Returns ATL_KEY_*.
atl_field_key :: (eb: [] EditBuf, key: int, mods: int, m: TextMeasure, face: int, w: f32) -> int {
  shift := (mods & 1) != 0; option := (mods & 4) != 0; command := (mods & 8) != 0;
  if key == -1 { return ATL_KEY_ESCAPE; }
  if key == -2 { return ATL_KEY_ENTER; }
  c := eb[0].caret;
  if key == -3 {
    if eb_sel_hi(eb) > eb_sel_lo(eb) { eb_cut_selection(eb); return ATL_KEY_TAKEN; }
    to := ifx command then eb_line_start(eb, c) else ifx option then eb_prev_word(eb, c) else eb_prev_boundary(eb, c);
    eb_delete_to(eb, to); return ATL_KEY_TAKEN;
  }
  to := -1;
  if key == -4 {
    if !shift && eb_sel_hi(eb) > eb_sel_lo(eb) && !command && !option { to = eb_sel_lo(eb); }
    else { to = ifx command then eb_line_start(eb, c) else ifx option then eb_prev_word(eb, c) else eb_prev_boundary(eb, c); }
  }
  if key == -5 {
    if !shift && eb_sel_hi(eb) > eb_sel_lo(eb) && !command && !option { to = eb_sel_hi(eb); }
    else { to = ifx command then eb_line_stop(eb, c) else ifx option then eb_next_word(eb, c) else eb_next_boundary(eb, c); }
  }
  if key == -8 || (key == -6 && command) { to = 0; }
  if key == -9 || (key == -7 && command) { to = eb[0].n; }
  if (key == -6 || key == -7) && !command {
    // a line up or down, at the same distance in
    text := eb_text(eb);
    ls: [ATL_FIELD_LINES] TextLine;
    n := atl_field_lines(m, face, text, w, ls[..]);
    cl := atl_line_of(ls[..], n, c);
    nl := ifx key == -6 then cl - 1 else cl + 1;
    if nl < 0 { to = 0; }
    else if nl >= n { to = eb[0].n; }
    else {
      want := measure_width(m, face, cast(string) text[ls[cl].from..<c]);
      to = ls[nl].from;
      while to < ls[nl].to && text[to] != '\n' {
        nx := eb_next_boundary(eb, to);
        if measure_width(m, face, cast(string) text[ls[nl].from..<nx]) > want + 0.5 { break; }
        to = nx;
      }
    }
  }
  if to >= 0 {
    if shift { eb_select_to(eb, to); } else { eb_move_to(eb, to); }
    return ATL_KEY_TAKEN;
  }
  if command && key == 'a' { eb_select_all(eb); return ATL_KEY_TAKEN; }
  if command && key == 'z' { _ = ifx shift then eb_redo(eb) else eb_undo(eb); return ATL_KEY_TAKEN; }
  return ATL_KEY_NONE;
}

// ---- checks

#test "a ring keeps the last events of every agent, says when one's were cut, and finds the change to take back" {
  r: [1] AtlRing;
  for i: 0..<ATL_CARDS + 4 {
    k := atl_add(r[..], i % 2, ifx i % 5 == 0 then AGR_EDIT else AGR_TOOL);
    r[0].ev[k].n = cast(s32) i;
  }
  #assert r[0].n == ATL_CARDS && r[0].cut[0] && r[0].cut[1];
  #assert r[0].ev[atl_slot(r[..], 0)].n == 4 && r[0].ev[atl_slot(r[..], ATL_CARDS - 1)].n == cast(s32) (ATL_CARDS + 3);
  #assert atl_count(r[..], 0) == ATL_CARDS / 2;
  // agent 1's last change is 95; taken back, the one before it (85) is next
  u := atl_undoable(r[..], 1);
  #assert u >= 0 && r[0].ev[u].n == 95;
  r[0].undone[u] = true;
  #assert r[0].ev[atl_undoable(r[..], 1)].n == 85;
  atl_forget(r[..], 1);
  #assert atl_count(r[..], 1) == 0 && atl_undoable(r[..], 1) == -1 && !r[0].cut[1] && atl_count(r[..], 0) == ATL_CARDS / 2;
}

#test "the step and the meter say what it is doing and how near its limits are, in words" {
  r: [1] AtlRing; b: [256] u8;
  #assert atl_step(r[..], 0, b[..]) == "";
  k := atl_add(r[..], 0, AGR_TOOL); r[0].ev[k].tool_n = agr_set(r[0].ev[k].tool[..], "read_level"); r[0].ev[k].ok = true;
  #assert atl_step(r[..], 0, b[..]) == "Used read_level";
  k = atl_add(r[..], 0, AGR_EDIT); agr_event_text(r[0].ev[k..<k + 1], "added 2 blocks (Block 29, Block 30)");
  k = atl_add(r[..], 1, AGR_MESSAGE); r[0].ev[k].from = AGR_AGENT; agr_event_text(r[0].ev[k..<k + 1], "another agent's");
  k = atl_add(r[..], 0, AGR_USAGE); r[0].ev[k].turns = 3;
  // usage is the meter's: the step is still the change
  #assert atl_step(r[..], 0, b[..]) == "Changed the level: added 2 blocks (Block 29, Block 30)";
  #assert atl_step(r[..], 1, b[..]) == "Said: another agent's";
  k = atl_add(r[..], 0, AGR_STATE); r[0].ev[k].state = AGR_STOPPED; agr_event_text(r[0].ev[k..<k + 1], "you stopped it");
  #assert atl_step(r[..], 0, b[..]) == "stopped: you stopped it";
  #assert atl_meter_words(3, 20, 42, 200, b[..]) == "Turn 3 of 20 - $0.42 of $2.00 of your Claude plan";
  #assert atl_meter_words(0, 20, 5, 200, b[..]) == "Turn 0 of 20 - $0.05 of $2.00 of your Claude plan";
  #assert atl_meter_share(5, 20, 150, 200) == 0.75 && atl_meter_share(25, 20, 0, 200) == 1;
}

#test "a field moves its caret by character, word and line, selects with Shift, and keeps to its limit" {
  eb: [1] EditBuf; m := TextMeasure.{kind = MEASURE_CELLS};
  #assert atl_field_type(eb[..], "add two ramps", 1000);
  #assert eb[0].caret == 13;
  #assert atl_field_key(eb[..], -4, 4, m, 0, 100) == ATL_KEY_TAKEN && eb[0].caret == 8;      // Option-Left: a word back
  #assert atl_field_key(eb[..], -5, 1, m, 0, 100) == ATL_KEY_TAKEN && eb_selected(eb[..]) == "r";   // Shift-Right selects
  _ = atl_field_type(eb[..], "R", 1000);
  #assert eb_text(eb[..]) == "add two Ramps";
  #assert atl_field_key(eb[..], 'a', 8, m, 0, 100) == ATL_KEY_TAKEN && eb_selected(eb[..]) == "add two Ramps";
  #assert atl_field_key(eb[..], -3, 0, m, 0, 100) == ATL_KEY_TAKEN && eb[0].n == 0;
  #assert atl_field_key(eb[..], 'z', 8, m, 0, 100) == ATL_KEY_TAKEN && eb_text(eb[..]) == "add two Ramps";
  #assert atl_field_key(eb[..], -8, 0, m, 0, 100) == ATL_KEY_TAKEN && eb[0].caret == 0;
  #assert atl_field_key(eb[..], -9, 0, m, 0, 100) == ATL_KEY_TAKEN && eb[0].caret == 13;
  // Up and Down go a line, at the same distance in
  eb_set(eb[..], "first line\nsecond");
  eb_move_to(eb[..], 3);
  #assert atl_field_key(eb[..], -7, 0, m, 0, 100) == ATL_KEY_TAKEN && eb[0].caret == 14;
  #assert atl_field_key(eb[..], -6, 0, m, 0, 100) == ATL_KEY_TAKEN && eb[0].caret == 3;
  // the limit: what doesn't fit is not typed
  eb_clear(eb[..]);
  _ = atl_field_type(eb[..], "abcdef", 4);
  #assert eb_text(eb[..]) == "abcd";
  #assert atl_field_key(eb[..], -2, 0, m, 0, 100) == ATL_KEY_ENTER && atl_field_key(eb[..], -1, 0, m, 0, 100) == ATL_KEY_ESCAPE;
}
#test "a Code agent's steps have words on their cards: its folder, branch and pull request" {
  b: [256] u8;
  w := agr_event(AGR_WORKTREE); w.repo = AGR_ENGINE; w.commit_n = agr_set(w.commit[..], "f5a5677d32aa");
  #assert atl_code_words(w, b[..]) == "A worktree of OpenAgentsInc/openagents from origin/main at f5a5677d32";
  #assert atl_title(w, "Code") == "Its folder";
  pr := agr_event(AGR_PULL); pr.number = 12; pr.url_n = agr_set(pr.url[..], "https://github.com/OpenAgentsInc/openagents/pull/12");
  #assert atl_code_words(pr, b[..]) == "#12 - https://github.com/OpenAgentsInc/openagents/pull/12";
  fl := agr_event(AGR_FILES); fl.count = 1;
  #assert atl_code_words(fl, b[..]) == "1 file";
}
