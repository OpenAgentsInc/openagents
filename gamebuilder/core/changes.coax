// What an agent changed, kept in view (GitHub issue 5; docs/agents-audit.md, recommendation 4,
// "A lasting highlight" and "A change card"). Every call from outside the person's own hands
// (an Agents pane agent's tool call, agents.coax; a call from the terminal, attach.coax) is
// carried out between ch_snap and ch_record: what it changed is told apart (added, moved,
// changed in place, removed), said in words ("added 3 blocks, moved 1, removed 2", with the
// things by name and id), and kept highlighted until the person dismisses it.
//
//   - The words are one export for every surface: ch_words and ch_json. apply-edits answers
//     them (a dry run says what a batch would change), the changes row answers them for what is
//     highlighted, the line under the toolbar says them, and the Agents pane's change card
//     (phase 2) reads them.
//   - The highlight is drawn in ed_draw through the editor's one cube pass: a thing added or
//     changed by an agent wears an outline in that agent's colour (the selection's edge bars,
//     tinted); added is also lit; moved and changed leave a thin ghost outline where the thing
//     was, and moved a line along the ground from there; removed leaves the ghost alone. No
//     new shader or mesh: the outline is LOOK_LINE with a tint (host/Sources/Shaders.metal).
//   - It does not fade: it stays until dismissed (the dismiss-changes row, the toolbar's
//     eye.slash), and what the person changed back since (⌘Z) stops being drawn.
//   - Show me (the show-changes row, the toolbar's eye) frames every highlighted thing, where
//     it is and where it was.
// Who changed it: 0 is a call from outside the app (--attach), CH_AGENT0 + k the pane's agent k.
//   scripts/check.sh

CH_MARKS :: 64;            // things kept highlighted at once; when more change, the oldest highlight goes
CH_AGENT0 :: 100;          // the Agents pane's agent k changes things as CH_AGENT0 + k (agents.coax, AG_ID0)
CH_ADDED :: 1; CH_MOVED :: 2; CH_CHANGED :: 3; CH_REMOVED :: 4;
CH_HOW_WORD :: [5] string.["", "added", "moved", "changed", "removed"];
// Each agent's colour, as the host's tints number them (play.coax, Shaders.metal): cyan, green,
// orange, blue, indigo, red; a call from outside the app is yellow.
CH_COLOURS :: 6;
CH_COLOUR :: [CH_COLOURS] s32.[3, 5, 18, 1, 17, 2];
CH_OUTSIDE :: 7;
// How heavy the lines are, as a share of the selection's.
CH_LINE :: 1.8f32; CH_GHOST :: 0.7f32;
CH_LIT :: 1.3f32;          // how much brighter an added thing is drawn
CH_MARK_INSTANCES :: 25;   // what one highlight draws at most: an outline, a ghost and a line
CH_WORDS :: 160;           // bytes of a summary line (NOTE_MAX: it is said under the toolbar)

// One thing a call changed: how, and the thing now and before (an added thing has no before,
// a removed one no now).
ChThing :: struct { how: s32; id: s32; now: Actor; was: Actor; }
// One thing kept highlighted: who changed it last, in which call, and how it stood before the
// first change that is still highlighted.
ChMark :: struct { how: s32; who: s32; batch: s32; id: s32; was: Actor; }
Changes :: struct { marks: [CH_MARKS] ChMark; n: s32; batch: s32; noted: s32; }
// The level's things as they stood before a call.
ChSnap :: struct { before: [ACTORS_MAX] Actor; n: s64; rev: int; level: s32; }   // (and which level they were)

ch_snap :: (e: [] Editor, s: [] ChSnap) {
  s[0].n = ed_count(e); s[0].rev = ed_agent_rev(e); s[0].level = ed_level(e);
  for i: 0..<s[0].n { s[0].before[i] = ed_actor(e, i); }
}
ch_at :: (a: Actor, b: Actor) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z; }
ch_same :: (a: Actor, b: Actor) -> bool {
  return a.kind == b.kind && ch_at(a, b) && a.yaw == b.yaw && a.scale == b.scale && a.sx == b.sx && a.sy == b.sy && a.sz == b.sz;
}
// How a thing that was `was` and is `now` changed: 0 not at all, moved, or changed in place.
ch_how :: (was: Actor, now: Actor) -> s32 {
  if ch_same(was, now) { return 0; }
  return ifx ch_at(was, now) then CH_CHANGED else CH_MOVED;
}

// What changed since the snapshot, in the level's order: what is there now (added, moved,
// changed), then what is gone. How many it wrote.
ch_diff :: (e: [] Editor, s: [] ChSnap, out: [] ChThing) -> int {
  n := 0;
  for i: 0..<ed_count(e) {
    a := ed_actor(e, i);
    how: s32 = CH_ADDED; was := Actor.{};
    for k: 0..<s[0].n { if s[0].before[k].id == a.id { was = s[0].before[k]; how = ch_how(was, a); break; } }
    if how != 0 && n < out.count { out[n] = ChThing.{how = how, id = a.id, now = a, was = was}; n += 1; }
  }
  for k: 0..<s[0].n {
    b := s[0].before[k];
    if ed_index(e, b.id) >= 0 { continue; }
    if n < out.count { out[n] = ChThing.{how = CH_REMOVED, id = b.id, was = b}; n += 1; }
  }
  return n;
}

// ---- the words

ch_kind :: (t: ChThing) -> s32 { return ifx t.how == CH_REMOVED then t.was.kind else t.now.kind; }
// A kind as a word in a sentence: "block", "blocks", "health pack", "enemies"; water stays water.
ch_noun :: (t: [] Text, kind: s32, many: bool) {
  name := KIND_NAME[kind];
  if name.count == 0 { return; }
  first: [1] u8; first[0] = name[0];
  if first[0] >= 'A' && first[0] <= 'Z' { first[0] += 32; }
  tx_put(t, cast(string) first[..]);
  rest := cast(string) name[1..<name.count];
  if !many || kind == KIND_WATER { tx_put(t, rest); return; }
  if rest.count > 0 && rest[rest.count - 1] == 'y' { tx_put(t, cast(string) rest[0..<rest.count - 1]); tx_put(t, "ies"); return; }
  tx_put(t, rest); tx_put(t, "s");
}
// A thing by name and id: "Block 29".
ch_name :: (t: [] Text, kind: s32, id: s32) { tx_put(t, KIND_NAME[kind]); tx_put(t, " "); tx_n(t, id); }
// What the things say, in one line: "added 3 blocks, moved 1, removed 2". Each clause names its
// kind ("things" when they are of several); a clause after the first names it only when it is
// not the first's.
ch_words :: (things: [] ChThing, t: [] Text) {
  said := 0; first_kind: s32 = -2;
  for h: CH_ADDED..<CH_REMOVED + 1 {
    how := cast(s32) h;
    n := 0; kind: s32 = -2;
    for th: things {
      if th.how != how { continue; }
      k := ch_kind(th);
      kind = ifx n == 0 then k else (ifx kind == k then kind else -1);
      n += 1;
    }
    if n == 0 { continue; }
    if said > 0 { tx_put(t, ", "); }
    tx_put(t, CH_HOW_WORD[how]); tx_put(t, " "); tx_int(t, cast(s64) n);
    if said == 0 || kind != first_kind {
      tx_put(t, " ");
      if kind >= 0 { ch_noun(t, kind, n > 1); } else { tx_put(t, ifx n > 1 then "things" else "thing"); }
    }
    if said == 0 { first_kind = kind; }
    said += 1;
  }
  if said == 0 { tx_put(t, "changed nothing"); }
}
// The same as JSON members of an open object: "summary" and "things", each thing with its id,
// its kind (the level file's word), its name and how it changed.
ch_json :: (o: [] Jo, things: [] ChThing) {
  b: [CH_WORDS] u8; t := [1] Text.[Text.{buf = b[..]}];
  ch_words(things, t[..]);
  jo_key(o, "summary"); jo_str(o, cast(string) b[0..<t[0].at]);
  jo_key(o, "things"); jo_arr(o);
  for th: things { ch_thing_json(o, th); jo_end(o); }
  jo_end(o);
}
// One thing's object, left open for the caller's own members.
ch_thing_json :: (o: [] Jo, th: ChThing) {
  k := ch_kind(th);
  jo_obj(o); we_int(o, "id", cast(int) th.id);
  jo_key(o, "kind"); jo_str(o, LEVEL_KIND[k]);
  nb: [64] u8; n := [1] Text.[Text.{buf = nb[..]}]; ch_name(n[..], k, th.id);
  jo_key(o, "name"); jo_str(o, cast(string) nb[0..<n[0].at]);
  jo_key(o, "how"); jo_str(o, CH_HOW_WORD[th.how]);
}
// Who changed it, in words: "Agent 1", or "Outside the app" for a call from the terminal.
ch_who :: (t: [] Text, who: s32) {
  if who >= CH_AGENT0 { tx_put(t, "Agent "); tx_n(t, who - CH_AGENT0 + 1); return; }
  tx_put(t, "Outside the app");
}
ch_colour :: (who: s32) -> s32 { return ifx who >= CH_AGENT0 then CH_COLOUR[(who - CH_AGENT0) % CH_COLOURS] else CH_OUTSIDE; }

// ---- the highlight

// How a highlighted thing stands now against how it was: what the person took back since
// (⌘Z) is not highlighted any more. 0: nothing to show.
ch_now :: (e: [] Editor, m: ChMark) -> ChThing {
  i := ed_index(e, m.id);
  if m.how == CH_ADDED { return ifx i >= 0 then ChThing.{how = CH_ADDED, id = m.id, now = ed_actor(e, i)} else ChThing.{}; }
  if i < 0 { return ifx m.how == CH_REMOVED then ChThing.{how = CH_REMOVED, id = m.id, was = m.was} else ChThing.{}; }
  a := ed_actor(e, i);
  return ChThing.{how = ch_how(m.was, a), id = m.id, now = a, was = m.was};
}
// What is highlighted, by whom (who < 0: anyone's), as things. How many it wrote.
ch_things :: (e: [] Editor, who: s32, out: [] ChThing) -> int {
  c := e[0].changes[0]; n := 0;
  for k: 0..<cast(s64) c.n {
    m := c.marks[k];
    if who >= 0 && m.who != who { continue; }
    th := ch_now(e, m);
    if th.how != 0 && n < out.count { out[n] = th; n += 1; }
  }
  return n;
}
ch_any :: (e: [] Editor) -> bool {
  for k: 0..<cast(s64) e[0].changes[0].n { if ch_now(e, e[0].changes[0].marks[k]).how != 0 { return true; } }
  return false;
}

ch_find :: (c: [] Changes, id: s32) -> int {
  for k: 0..<cast(s64) c[0].n { if c[0].marks[k].id == id { return k; } }
  return -1;
}
ch_drop :: (c: [] Changes, k: int) {
  for j: k..<cast(s64) c[0].n - 1 { c[0].marks[j] = c[0].marks[j + 1]; }
  c[0].n -= 1;
}
// Keeps a call's changes highlighted as who's: a thing already highlighted keeps how it stood
// before its first change, so a ghost stays where it really was.
ch_mark :: (e: [] Editor, who: s32, things: [] ChThing) {
  c := e[0].changes[..];
  c[0].batch += 1;
  for th: things {
    k := ch_find(c, th.id);
    if k < 0 {
      if c[0].n == CH_MARKS { ch_drop(c, 0); }
      c[0].marks[c[0].n] = ChMark.{how = th.how, who = who, batch = c[0].batch, id = th.id, was = th.was};
      c[0].n += 1;
      continue;
    }
    m := c[0].marks[k];
    how := th.how;
    if m.how == CH_ADDED { how = ifx th.how == CH_REMOVED then 0 else CH_ADDED; }      // added and taken out again: nothing
    else if th.how != CH_REMOVED { how = ch_how(m.was, th.now); }                       // back where it was: nothing
    if how == 0 { ch_drop(c, k); continue; }
    // the newest change is the one shown, and it goes last
    ch_drop(c, k);
    c[0].marks[c[0].n] = ChMark.{how = how, who = who, batch = c[0].batch, id = th.id, was = m.was};
    c[0].n += 1;
  }
  e[0].dirty = true;
}

// What a call changed since the snapshot, kept highlighted as who's and said under the toolbar:
// "Agent 1: added 3 blocks, moved 1 (Block 29, Block 30, Block 31, Block 4)". How many things.
ch_record :: (e: [] Editor, who: s32, s: [] ChSnap) -> int {
  things: [CH_MARKS] ChThing;
  return ch_record_into(e, who, s, things[..]);
}
// The same, with what it changed left in things (an agent's change card names them).
ch_record_into :: (e: [] Editor, who: s32, s: [] ChSnap, things: [] ChThing) -> int {
  // a different level is open now (the call made one, or opened one): it is said as that, and nothing of
  // it is a change to the level that was open ("Outside the app: opened level 13")
  if ed_level(e) != s[0].level {
    lb: [NOTE_MAX] u8; lt := [1] Text.[Text.{buf = lb[..]}];
    ch_who(lt[..], who); tx_put(lt[..], ": opened level "); tx_n(lt[..], ed_level(e));
    ed_say(e, cast(string) lb[0..<lt[0].at]);
    return 0;
  }
  n := ch_diff(e, s, things);
  if n == 0 { return 0; }
  ch_mark(e, who, things[0..<n]);
  // the level before and after, to be drawn on the change's card (pictures.coax)
  pic_want_change(e, who, s, s[0].rev, things[0..<n]);
  b: [NOTE_MAX] u8; t := [1] Text.[Text.{buf = b[..]}];
  ch_line(t[..], who, things[0..<n]);
  ed_say(e, cast(string) b[0..<t[0].at]);
  e[0].changes[0].noted = e[0].note_len;
  return n;
}
// One call's line: who, the words, and the things by name while they fit.
ch_line :: (t: [] Text, who: s32, things: [] ChThing) {
  ch_who(t, who); tx_put(t, ": "); ch_summary(t, things);
}
// The words and the things by name while they fit: "added 2 blocks (Block 29, Block 30)".
ch_summary :: (t: [] Text, things: [] ChThing) {
  ch_words(things, t);
  room := t[0].buf.count - 3;
  for i: 0..<things.count {
    nb: [64] u8; nt := [1] Text.[Text.{buf = nb[..]}];
    ch_name(nt[..], ch_kind(things[i]), things[i].id);
    if t[0].at + nt[0].at + 3 > room { tx_put(t, ", …"); break; }
    tx_put(t, ifx i == 0 then " (" else ", "); tx_put(t, cast(string) nb[0..<nt[0].at]);
    if i == things.count - 1 { tx_put(t, ")"); }
  }
}

// Takes the highlight off who's changes (who < 0: everyone's), and the line under the toolbar
// with it when it was a change's. How many things were highlighted.
ch_dismiss :: (e: [] Editor, who: s32) -> int {
  c := e[0].changes[..];
  gone := 0; k := 0;
  while k < cast(s64) c[0].n {
    if who >= 0 && c[0].marks[k].who != who { k += 1; continue; }
    if ch_now(e, c[0].marks[k]).how != 0 { gone += 1; }
    ch_drop(c, k);
  }
  if c[0].n == 0 && c[0].noted > 0 && c[0].noted == e[0].note_len { ed_say(e, ""); }
  if c[0].n == 0 { c[0].noted = 0; }
  e[0].dirty = true;
  return gone;
}

// Show me: frames who's highlighted things (who < 0: everyone's), where they are and where
// they were. How many things it framed; 0 moves nothing.
ch_frame :: (e: [] Editor, who: s32) -> int {
  things: [CH_MARKS] ChThing;
  n := ch_things(e, who, things[..]);
  return ch_frame_things(e, things[0..<n]);
}
// Show me on one change: the view framed on the things with these ids, where each is now and,
// while it is still highlighted, where it was. How many it found.
ch_frame_ids :: (e: [] Editor, ids: [] s32) -> int {
  all: [CH_MARKS] ChThing;
  n := ch_things(e, -1, all[..]);
  things: [CH_MARKS] ChThing; k := 0;
  for id: ids {
    if k >= things.count { break; }
    found := false;
    for i: 0..<n { if !found && all[i].id == id { things[k] = all[i]; k += 1; found = true; } }
    if found { continue; }
    at := ed_index(e, id);
    if at >= 0 { things[k] = ChThing.{how = CH_CHANGED, id = id, now = ed_actor(e, at), was = ed_actor(e, at)}; k += 1; }
  }
  return ch_frame_things(e, things[0..<k]);
}
ch_frame_things :: (e: [] Editor, things: [] ChThing) -> int {
  n := things.count;
  if n == 0 { return 0; }
  big: f32 = 1000000000.0;
  lo := WorldPoint.{x = big, y = big, z = big}; hi := WorldPoint.{x = -big, y = -big, z = -big};
  for i: 0..<n {
    th := things[i];
    for side: 0..<2 {
      if side == 0 && th.how == CH_REMOVED { continue; }
      if side == 1 && th.how == CH_ADDED { continue; }
      b := ed_bounds(ifx side == 0 then th.now else th.was);
      if b.c.x - b.hx < lo.x { lo.x = b.c.x - b.hx; } if b.c.y - b.hy < lo.y { lo.y = b.c.y - b.hy; } if b.c.z - b.hz < lo.z { lo.z = b.c.z - b.hz; }
      if b.c.x + b.hx > hi.x { hi.x = b.c.x + b.hx; } if b.c.y + b.hy > hi.y { hi.y = b.c.y + b.hy; } if b.c.z + b.hz > hi.z { hi.z = b.c.z + b.hz; }
    }
  }
  c := WorldPoint.{x = (lo.x + hi.x) * 0.5, y = (lo.y + hi.y) * 0.5, z = (lo.z + hi.z) * 0.5};
  ed_frame(e, c, vp_len(hi.x - c.x, hi.y - c.y, hi.z - c.z));
  return n;
}

// ---- what is drawn

// The highlight, after the things: each changed thing's outline in its agent's colour, the
// ghost of where it was, and a line along the ground for a move.
ch_draw :: (e: [] Editor, out: [] f32, n: s64) -> s64 {
  m := n;
  c := e[0].changes[0];
  for k: 0..<cast(s64) c.n {
    th := ch_now(e, c.marks[k]);
    if th.how == 0 { continue; }
    tint := ch_colour(c.marks[k].who);
    if th.how != CH_REMOVED { m = ed_edges(out, m, ed_shown(e, th.now), CH_LINE, tint); }
    if th.how != CH_ADDED { m = ed_edges(out, m, th.was, CH_GHOST, tint); }
    if th.how == CH_MOVED {
      now := ed_shown(e, th.now);
      ax := cast(f32) th.was.x / 100; az := cast(f32) th.was.z / 100;
      bx := cast(f32) now.x / 100; bz := cast(f32) now.z / 100;
      dx := bx - ax; dz := bz - az; span := sqrt(dx * dx + dz * dz);
      if span > 0.01 {
        yaw := angle_atan2(-dz, dx) * 57.29578;
        m = ed_line(out, m, WorldPoint.{x = (ax + bx) * 0.5, y = 0.03, z = (az + bz) * 0.5}, span * 0.5, 0.02, 0.02, yaw, tint);
      }
    }
  }
  return m;
}
// Whether a thing is lit, as an added one is: the shade ed_draw multiplies by.
ch_light :: (e: [] Editor, id: s32) -> f32 {
  k := ch_find(e[0].changes[..], id);
  if k < 0 { return 1; }
  return ifx ch_now(e, e[0].changes[0].marks[k]).how == CH_ADDED then CH_LIT else 1;
}

// ---- checks

ChTest :: struct { e: [1] Editor; snap: [1] ChSnap; out: [INSTANCES_MAX * INSTANCE_FLOATS] f32; }

ch_test_words :: (b: [] u8, things: [] ChThing) -> string {
  t := [1] Text.[Text.{buf = b}];
  ch_words(things, t[..]);
  return cast(string) b[0..<t[0].at];
}
ch_test_block :: (id: s32, x: s32, kind: s32) -> Actor { return Actor.{id = id, kind = kind, x = x, scale = 100, sx = 100, sy = 100, sz = 100}; }

#test "a call's changes are said in words: added 3 blocks, moved 1, removed 2" {
  b := ch_test_block(1, 0, KIND_BLOCK);
  things := [6] ChThing.[
    ChThing.{how = CH_ADDED, id = 29, now = ch_test_block(29, 0, KIND_BLOCK)},
    ChThing.{how = CH_ADDED, id = 30, now = ch_test_block(30, 0, KIND_BLOCK)},
    ChThing.{how = CH_ADDED, id = 31, now = ch_test_block(31, 0, KIND_BLOCK)},
    ChThing.{how = CH_MOVED, id = 1, now = b, was = b},
    ChThing.{how = CH_REMOVED, id = 4, was = ch_test_block(4, 0, KIND_BLOCK)},
    ChThing.{how = CH_REMOVED, id = 5, was = ch_test_block(5, 0, KIND_BLOCK)}];
  wb: [CH_WORDS] u8;
  #assert ch_test_words(wb[..], things[..]) == "added 3 blocks, moved 1, removed 2";
  // several kinds are things; a clause of another kind names it; one is singular
  things[1].now.kind = KIND_TREE;
  #assert ch_test_words(wb[..], things[0..<3]) == "added 3 things";
  #assert ch_test_words(wb[..], things[3..<5]) == "moved 1 block, removed 1";
  things[4].was.kind = KIND_ENEMY;
  #assert ch_test_words(wb[..], things[3..<5]) == "moved 1 block, removed 1 enemy";
  things[5].was.kind = KIND_ENEMY;
  #assert ch_test_words(wb[..], things[4..<6]) == "removed 2 enemies";
  things[4].was.kind = KIND_WATER; things[5].was.kind = KIND_WATER;
  #assert ch_test_words(wb[..], things[4..<6]) == "removed 2 water";
  #assert ch_test_words(wb[..], things[0..<0]) == "changed nothing";
  // and the line under the toolbar names who and the things
  lb: [NOTE_MAX] u8; l := [1] Text.[Text.{buf = lb[..]}];
  ch_line(l[..], CH_AGENT0, things[3..<4]);
  #assert cast(string) lb[0..<l[0].at] == "Agent 1: moved 1 block (Block 1)";
  l[0].at = 0; ch_line(l[..], 0, things[0..<1]);
  #assert cast(string) lb[0..<l[0].at] == "Outside the app: added 1 block (Block 29)";
}

#test "what a call changed stays highlighted, each way drawn differently, until dismissed" {
  t: [1] ChTest; e := t[0].e[..];
  ed_init(e, 800, 400);
  ed_new(e, 1);
  plain := ed_draw(e, t[0].out[..]);
  ch_snap(e, t[0].snap[..]);
  moved := ed_actor(e, 4).id; gone := ed_actor(e, 5).id;
  e[0].selected = moved; _ = ed_set_field(e, FIELD_X, cast(s32) ed_actor(e, 4).x + 300);
  e[0].selected = gone; ed_delete(e);
  added := ed_add(e, KIND_BLOCK);
  e[0].selected = 0;
  #assert ch_record(e, CH_AGENT0, t[0].snap[..]) == 3;
  #assert ch_any(e);
  // the line under the toolbar says it
  nb: [NOTE_MAX] u8; said := cast(string) nb[0..<ed_note(e, nb[..])];
  #assert level_find(said, "Agent 1: added 1 block, moved 1, removed 1 (") == 0;
  // drawn: the added one lit with an outline (12), the moved one's outline, ghost and line (25), the ghost of the removed one (12)
  n := ed_draw(e, t[0].out[..]);
  #assert n == plain + 12 + 25 + 12;
  // in the agent's colour, as lines
  last := (n - 1) * INSTANCE_FLOATS;
  #assert t[0].out[last + 17] == cast(f32) LOOK_LINE && t[0].out[last + 18] == cast(f32) ch_colour(CH_AGENT0);
  #assert ch_light(e, added) > 1 && ch_light(e, moved) == 1;
  // it does not fade
  _ = ed_tick(e, 60);
  #assert ed_draw(e, t[0].out[..]) == n && ch_any(e);
  // what the person takes back is not highlighted any more: ⌘Z the add
  ed_undo(e);
  #assert ed_draw(e, t[0].out[..]) == n - 13;
  ed_redo(e);
  // Show me frames them: the camera moves, and everything highlighted is in view
  before := ed_eye(e);
  #assert ch_frame(e, -1) == 3;
  #assert ed_dist(before, ed_eye(e)) > 0.1;
  a := ed_actor(e, ed_index(e, added));
  #assert ed_through(e, cast(f32) a.x / 100, 0.5, cast(f32) a.z / 100).ok;
  // another agent's colour is its own
  #assert ch_colour(CH_AGENT0 + 1) != ch_colour(CH_AGENT0) && ch_colour(0) == CH_OUTSIDE;
  // dismissed: nothing drawn, the line gone, and Show me has nothing to frame
  #assert ch_dismiss(e, -1) == 3;
  #assert !ch_any(e) && ed_draw(e, t[0].out[..]) == plain && ed_note(e, nb[..]) == 0 && ch_frame(e, -1) == 0;
}

#test "a thing changed twice keeps where it first was; added then removed is nothing" {
  t: [1] ChTest; e := t[0].e[..];
  ed_init(e, 800, 400);
  ed_new(e, 1);
  id := ed_actor(e, 4).id; x0 := ed_actor(e, 4).x;
  for step: 0..<2 {
    ch_snap(e, t[0].snap[..]);
    e[0].selected = id; _ = ed_set_field(e, FIELD_X, cast(s32) ed_actor(e, ed_index(e, id)).x + 200);
    _ = ch_record(e, CH_AGENT0 + cast(s32) step, t[0].snap[..]);
  }
  things: [CH_MARKS] ChThing;
  #assert ch_things(e, -1, things[..]) == 1 && things[0].was.x == x0 && things[0].how == CH_MOVED;
  // the newest change is whose it is
  #assert ch_things(e, CH_AGENT0 + 1, things[..]) == 1 && ch_things(e, CH_AGENT0, things[..]) == 0;
  // moved back where it was: nothing to show
  ch_snap(e, t[0].snap[..]);
  e[0].selected = id; _ = ed_set_field(e, FIELD_X, cast(s32) x0);
  _ = ch_record(e, 0, t[0].snap[..]);
  #assert !ch_any(e);
  // added and taken out by later calls
  ch_snap(e, t[0].snap[..]); n := ed_add(e, KIND_BLOCK); _ = ch_record(e, 0, t[0].snap[..]);
  #assert ch_any(e);
  ch_snap(e, t[0].snap[..]); e[0].selected = n; ed_delete(e); _ = ch_record(e, 0, t[0].snap[..]);
  #assert !ch_any(e) && e[0].changes[0].n == 0;
}
