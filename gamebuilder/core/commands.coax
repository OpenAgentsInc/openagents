// GameBuilder's commands: one table that every way in reads
// (docs/programmatic-access.md, stage C0). A row is one feature: its verb,
// what it changes, who may run it, its arguments and their limits, what it
// answers, the exports it calls and the surfaces that offer it. gb_run
// carries a row out on an open editor and writes its answer; the gamebuilder
// CLI (cli/main.coax) reads and writes the level and game files around it.
// The CLI's help and its capability manifest (`gamebuilder commands --json`)
// are made from the table, never typed again, and so is the Claude skill
// (gb_skill, `gamebuilder skill`), and so are the MCP tools (coax/mcp.coax, `gamebuilder mcp`).
// The app's own buttons are rows too: coax/controls.coax lists them
// (GB_CONTROLS), and the host presses one through ed_command.
//
// A verb is matched exactly against the table (gb_find). Nothing here reads a
// sentence: a person's words go to a model, which picks a row by name.
//
// Answers are the agent seam's form (coax/agent.coax):
//   {"ok":true,...}
//   {"ok":false,"error":CODE,"why":WORDS}
// CODE: bad-request, not-found, not-permitted or edit-refused; apply-edits
// answers the seam's own codes (stale, locked, refused, ...); claimed is
// another agent's claim (claims.coax), the holder named in the words. A limit
// that refused it is said in the words, with its number.
//
// Who calls: the person, unless the call names an agent: an Agents pane agent
// is named by the pane (gb_command_run_as), any other by --agent NAME. A claim
// refuses only an agent's change, never the person's.
//   scripts/check.sh

// The secp256k1 tables the editor loads are built at compile time (editor.coax).
#run_steps 100000000;
#load "editor.coax";
// What an agent is and what it did: the record, its event log, its states and their words (issue 4).
#load "agent-record.coax";
#load "agent-rows.coax";
#load "agent-pictures.coax";   // an agent's newest picture kept on the account (issue 9)
// The core loop's counts on gamebuilder.org: a day's totals and the funnel made from them (issue 18).
#load "loop-day.coax";
#load "../shared/plays.coax";   // a published game, counted: what the published row reads back (docs/publishing.md)
#load "engine-fork.coax";   // engine-ready and engine-mine: what they answer (issue 23)
#load "triage.coax";        // where a request belongs: the question set and the rules on its answer (issue 22)
#load "engine-list.coax";   // the engine's capability list, made by tools/engine-list.coax (issue 21)

// The surfaces a row is offered on.
GB_UI :: 1; GB_CLI :: 2; GB_MCP :: 4; GB_SKILL :: 8; GB_HTTP :: 16; GB_PANE :: 32; GB_WEB :: 64; GB_CLOUD :: 128;
GB_SURFACES :: 8;
GB_SURFACE_NAME :: [GB_SURFACES] string.["ui", "cli", "mcp", "skill", "http", "pane", "web", "cloud"];
// Offline rows: whatever reaches a level's file.
GB_FILES :: 30;             // GB_CLI | GB_MCP | GB_SKILL | GB_HTTP
GB_EVERY :: 31;             // and the app's own controls
// The Agents pane's tools (agents.coax): the open level read, changed, taken back and
// played, and nothing else (no files, no other levels, no games).
GB_FILES_PANE :: 62;        // GB_FILES | GB_PANE
// The cloud Builder's rows (issue 27; coax/cloud-rows.coax, cli/cloud.coax): the rows a Builder the
// hosted server runs may write as a command of a step, on its own level and as itself. They are
// the pane's rows that run on the account's files, less play-test (a match would hold the one
// server for minutes), and agent-undo, which takes back its own last change. The mark is this
// surface and nothing else: what the Builder is told and what the server carries out both read it.
GB_FILES_PANE_CLOUD :: 190; // GB_FILES | GB_PANE | GB_CLOUD

// view: changes only what this screen shows (the tool, the camera, the selection, the clipboard);
// spend: a model is paid for (Decide).
// social: says or does something others in the lobby see (the lobby rows).
GB_EFFECTS :: [7] string.["read", "edit", "view", "play", "account", "spend", "social"];
// What an approval asks, as the skill says it.
GB_APPROVAL_WORDS :: [4] string.["", "only on a level or game you own", "asks the person first", "only the person, never an agent for them"];
// person: only the person can do it (type the code from their email), never an agent for them.
GB_APPROVALS :: [4] string.["none", "owner", "confirm", "person"];
// Argument kinds; "text:N" is any text of at most N bytes.
GB_KINDS :: [40] string.["level", "game", "template", "kind", "thing", "field", "value", "batch", "text", "tool", "revision", "content",
  "agent", "role", "job", "message", "answer", "after", "report", "region",
  "shipped", "scrapper", "slot", "player", "line", "member", "side", "reply", "look", "say", "name", "into", "owners", "published", "version", "feedback", "which", "picture", "computer", "status"];
// A tool's words, as ed_tool numbers them.
GB_TOOL_WORD :: [ED_TOOLS] string.["select", "move", "rotate", "scale"];
// party-answer's and party-look's words.
GB_REPLY_WORD :: [2] string.["yes", "no"];
GB_LOOK_WORD :: [2] string.["on", "off"];

// Why a row is not on a surface (docs/programmatic-access.md, "Surfaces and their gaps"). Every
// row is on every surface (GB_UI, GB_CLI, GB_MCP, GB_SKILL, GB_HTTP, GB_PANE) unless its gap column
// names a reason here that excuses the ones it lacks; a reason must excuse a surface the row lacks
// and fit the row (a #test below holds both). "live" excuses no surface: the row needs a live
// service, so it has no golden case (tools/commands-golden.coax holds that).
GbGap :: struct { name: string; excuses: s32; words: string; }
GB_GAP_N :: 23;
GB_GAPS :: [GB_GAP_N] GbGap.[
  GbGap.{name = "screen", excuses = GB_CLI | GB_MCP | GB_SKILL | GB_HTTP,
    words = "it acts on what the app's screen holds (the selection, the clipboard, the tool, the history, the panes); a program reaches it in the running app with --attach"},
  GbGap.{name = "pane", excuses = GB_UI | GB_CLI | GB_MCP | GB_SKILL | GB_HTTP,
    words = "the Agents pane's own: an agent's turn taken back, or its question to the person"},
  GbGap.{name = "open-level", excuses = GB_PANE,
    words = "it reaches past the open level (other levels, games, files, the account, the engine), and the pane's agent gets the open level only"},
  GbGap.{name = "pane-reads", excuses = GB_PANE,
    words = "the pane's agent reads the open level as read-level; this other form of it is for programs"},
  GbGap.{name = "view", excuses = GB_PANE,
    words = "it changes only what the person's screen shows or keeps (the tool, the view, the clipboard, the history); the pane's agent changes the level, and takes back its own turns with undo-turn"},
  GbGap.{name = "batch", excuses = GB_PANE,
    words = "the pane's agent makes every change as one apply-edits batch, which undo-turn takes back whole"},
  GbGap.{name = "drawn", excuses = GB_UI,
    words = "a read: the app shows what it answers where it is used, so no control asks for it"},
  GbGap.{name = "headless", excuses = GB_UI,
    words = "it plays with no screen; on the screen the person plays the level instead"},
  GbGap.{name = "gesture", excuses = GB_UI,
    words = "the app makes it with a drag on the selection, not a press"},
  GbGap.{name = "auto", excuses = GB_UI,
    words = "the app does it on its own, with no control: your levels move between your devices as they are saved"},
  GbGap.{name = "spend", excuses = GB_CLI | GB_MCP | GB_SKILL | GB_HTTP | GB_PANE,
    words = "it pays for a model with the app's own login, one request at a time, and only the person presses it"},
  GbGap.{name = "person", excuses = GB_MCP | GB_HTTP | GB_PANE,
    words = "only the person may do it, at a screen or a terminal (or, where the row is on HTTP, with their own login from gamebuilder.org's page or gamebuilder --remote), never an agent for them"},
  GbGap.{name = "login", excuses = GB_UI | GB_MCP | GB_HTTP,
    words = "each surface has its own login: the app its account sheet; MCP and HTTP act as the login of the CLI that serves them"},
  GbGap.{name = "agents", excuses = GB_PANE,
    words = "an agent's record and log belong to the surface the person runs it from; the pane's agent is one of those agents and does not drive the others"},
  GbGap.{name = "runner", excuses = GB_UI,
    words = "a running agent reports its own events through it; the person reads them in the Agents pane"},
  GbGap.{name = "claim", excuses = GB_UI,
    words = "a claim keeps one agent out of another's work, and never refuses the person, so the app has no control to make or end one; it draws every claim on the ground in its agent's colour"},
  GbGap.{name = "match", excuses = GB_PANE,
    words = "it starts, steers or reads the match on the person's screen; the pane's agent plays a level headless instead (play-test)"},
  GbGap.{name = "lobby", excuses = GB_CLI | GB_MCP | GB_SKILL | GB_HTTP | GB_PANE,
    words = "the lobby and the party live in the running app, signed with the person's key on the room's relay; only the person is in the room, never a program or an agent for them"},
  GbGap.{name = "web", excuses = GB_RULED,
    words = "it is a plan line of gamebuilder.org's own world of blocks and balls, which its chat's model and its tools write alike (web/blocks.coax); a level's file takes apply-edits instead"},
  GbGap.{name = "site", excuses = GB_UI | GB_PANE,
    words = "it reads gamebuilder.org's own counts (how many visits reached each step of making a game there), which the app has no screen for and a level's agent no use for; the owner reads them at a command line"},
  GbGap.{name = "door", excuses = GB_UI | GB_MCP | GB_HTTP | GB_PANE,
    words = "it asks the OpenAgents decision door, signed with a key the command line keeps on this computer; an agent on another surface runs the command line for it, or reads engine-list and decides itself"},
  GbGap.{name = "computer", excuses = GB_UI | GB_MCP | GB_HTTP | GB_PANE,
    words = "it looks at this computer's own tools and GitHub login (git, gh, claude), which only the command line run there sees"},
  GbGap.{name = "live", excuses = 0,
    words = "it needs a live service (the account server, a model, a relay, a match on the network), which a golden case does not reach"},
];
// The surfaces the rule covers. The website (GB_WEB) has its own grammar (web/), held apart, and
// the cloud Builder (GB_CLOUD) has the few rows marked for it, not every row less a reason.
GB_RULED :: 63;             // GB_UI | GB_CLI | GB_MCP | GB_SKILL | GB_HTTP | GB_PANE
gb_gap_find :: (name: string) -> int {
  for i: 0..<GB_GAP_N { if GB_GAPS[i].name == name { return i; } }
  return -1;
}
// Whether row c says it has no golden case (the reason "live").
gb_gap_has :: (c: GbCommand, name: string) -> bool {
  for k: 0..<gb_parts(c.gap) { if gb_part(c.gap, k) == name { return true; } }
  return false;
}

GbCommand :: struct {
  verb: string;           // the one name, on every surface
  area: string;           // level, game, edit, view, decide, play, account, engine, agent, code, site
  effect: string;         // GB_EFFECTS
  approval: string;       // GB_APPROVALS: owner rows change only what this account may (ed_may_edit)
  arguments: string;      // kinds, "|"-separated, in order
  flags: string;          // "--x:cm|--dry-run:bool"
  result: string;         // what it answers
  limit: string;          // what bounds it, naming the constant
  impl: string;           // the exports it calls
  surfaces: s32;
  gap: string;            // GB_GAPS, "|"-separated: why the row is not on each surface it lacks
  usage: string; help: string;
}

GB_N :: 120;
// The verbs, as the table's rows: a verb is a typed value and its row at once.
VERB_LIST_LEVELS :: 0; VERB_READ_LEVEL :: 1; VERB_READ_STATE :: 2; VERB_READ_CONTENT :: 3;
VERB_NEW_LEVEL :: 4; VERB_COPY_LEVEL :: 5;
VERB_LIST_GAMES :: 6; VERB_LIST_TEMPLATES :: 7; VERB_NEW_GAME :: 8; VERB_RENAME_GAME :: 9; VERB_READ_GAME :: 10;
VERB_APPLY_EDITS :: 11; VERB_ADD :: 12; VERB_SET_FIELD :: 13; VERB_DELETE :: 14; VERB_LIST_PALETTE :: 15; VERB_LIST_FIELDS :: 16;
VERB_LIST_MODES :: 17;
// The account rows are carried out by the surface around the core (it asks the server; cli/account.coax).
VERB_WHOAMI :: 18; VERB_LOGIN :: 19; VERB_LOGOUT :: 20;
// The engine row is answered by the surface too, with the engine commit it was built on (gb_engine).
VERB_ENGINE :: 21;
// The app's own: they act on the level open on its screen, its selection and its history
// (GB_UI). A later --attach (stage C5) offers them to the CLI and MCP.
VERB_UNDO :: 22; VERB_REDO :: 23; VERB_SET_TOOL :: 24; VERB_FOCUS :: 25;
VERB_COPY :: 26; VERB_PASTE :: 27; VERB_DUPLICATE :: 28;
// Decide is carried out by the host: it sends the request the core writes and hands the answer back.
VERB_DECIDE :: 29;
VERB_CUT :: 30;
// A match played headless with bots in every seat (playtest.coax).
VERB_PLAY_TEST :: 31;
// The Agents pane (agents.coax): open or close it; an agent's last turn taken back; a
// question put to the person, the turn waiting for the answer.
VERB_AGENTS :: 32; VERB_UNDO_TURN :: 33; VERB_ASK :: 34;
// A level's file put whole, against the revision it was read at: how a level moves between
// your devices through the account (docs/programmatic-access.md, C7).
VERB_WRITE_CONTENT :: 35;
// An agent as a stored record with its event log (agent-record.coax, agent-rows.coax). agents
// lists them; agents-pane is the app's button that opens the pane.
VERB_AGENT_READ :: 36; VERB_AGENT_EVENTS :: 37; VERB_AGENT_NEW :: 38; VERB_AGENT_MESSAGE :: 39;
VERB_AGENT_ANSWER :: 40; VERB_AGENT_STOP :: 41; VERB_AGENT_UNDO :: 42; VERB_AGENT_REPORT :: 43;
VERB_AGENTS_PANE :: 44;
// A Code agent (issue 8; agents.coax, code-agent.coax): what one on a repository is given and may
// do, and the pane's sheet that starts one after the person approves it.
VERB_CODE_BRIEF :: 45; VERB_CODE_AGENT :: 46;
// Claims (claims.coax): what an agent is working on, so another agent's change there is refused.
VERB_CLAIM :: 47; VERB_CLAIMS :: 48; VERB_RELEASE :: 49;
// The app's screen: a level or a shipped game opened, a match played on it (issue 3, step 3).
// The lobby and the party, the person's own (lobby-rows.coax).
VERB_OPEN_LEVEL :: 50;
VERB_OPEN_GAME :: 51;
VERB_PLAY :: 52;
VERB_STOP :: 53;
VERB_PLAY_STATE :: 54;
VERB_LIST_SCRAPPERS :: 55;
VERB_TRAVEL :: 56;
VERB_DIGGER :: 57;
VERB_BAG_SELECT :: 58;
VERB_LOBBY_READ :: 59;
VERB_LOBBY_NAME :: 60;
VERB_LOBBY_SAY :: 61;
VERB_LOBBY_MUTE :: 62;
VERB_LOBBY_REPORT :: 63;
VERB_PARTY_READ :: 64;
VERB_PARTY_INVITE :: 65;
VERB_PARTY_ANSWER :: 66;
VERB_PARTY_LEAVE :: 67;
VERB_PARTY_SIDE :: 68;
VERB_PARTY_SCRAPPER :: 69;
VERB_PARTY_MATCH :: 70;
VERB_PARTY_LOOK :: 71;
VERB_PARTY_START :: 72;
// Your games and levels managed: deleted, named, moved, and who owns a game (issue 3, step 4).
VERB_DELETE_LEVEL :: 73;
VERB_DELETE_GAME :: 74;
VERB_RENAME_LEVEL :: 75;
VERB_MOVE_LEVEL :: 76;
VERB_OWNERS :: 77;
VERB_SET_OWNERS :: 78;
// gamebuilder.org's own world: its plan lines, as its chat's model and its tools write them (issue 3, step 5).
VERB_WEB_PLACE :: 79;
VERB_WEB_BALL :: 80;
VERB_WEB_PUT :: 81;
VERB_WEB_TURN :: 82;
VERB_WEB_KIND :: 83;
VERB_WEB_SIZE :: 84;
VERB_WEB_MOVE :: 85;
VERB_WEB_REMOVE :: 86;
VERB_WEB_CLEAR :: 87;
VERB_WEB_SET :: 88;
VERB_WEB_RESET :: 89;
VERB_WEB_GRAVITY :: 90;
VERB_WEB_SELECT :: 91;
VERB_WEB_SPIN :: 92;
// The website's core loop, counted (shared/loop.coax, loop-day.coax): the surface answers it from
// the day files its server keeps (cli/main.coax, cli_funnel).
VERB_FUNNEL :: 93;
// What agents and calls from outside the app changed, kept highlighted on the open level
// (changes.coax): read it, Show me (frame it), and dismiss it.
VERB_CHANGES :: 94; VERB_SHOW_CHANGES :: 95; VERB_DISMISS_CHANGES :: 96;
// Publishing to the web (publish.coax; docs/publishing.md), the person's own (issue 3, step 7).
VERB_PUB_PUBLISH :: 97;
VERB_PUB_PUBLISHED :: 98;
VERB_PUB_VERSIONS :: 99;
VERB_PUB_SET_LIVE :: 100;
VERB_PUB_UNPUBLISH :: 101;
VERB_PUB_REMOVE_PUBLISHED :: 102;
VERB_PUB_FEEDBACK :: 103;
VERB_PUB_FEEDBACK_HIDE :: 104;
VERB_PUB_BLOCK :: 105;
VERB_PUB_REPORT :: 106;
// Whether this computer's agents' conversations are kept on the account while logged in (the
// Agents pane's switch; sync.coax reports them when it is on).
VERB_AGENTS_ACCOUNT :: 107;
// The pictures the app drew of agents' changes and play-tests, kept beside the level (pictures.coax).
VERB_PICTURES :: 108; VERB_PICTURE :: 109;
// An agent's newest picture, kept on the account for gamebuilder.org/agents (agent-pictures.coax).
VERB_AGENT_PICTURE :: 110;
// What the engine can do (issue 21; engine-list.coax, made from the engine's book at the pinned
// commit): every chapter in a line, and one in full.
VERB_ENGINE_LIST :: 112; VERB_ENGINE_READ :: 113;
// Where a request in the person's words belongs (issue 22; triage.coax): the commands, GameBuilder's
// own code, or the engine.
VERB_TRIAGE :: 114;
// a computer your agents run on, and an agent started there (issue 11: cli/resident.coax)
VERB_COMPUTERS :: 115; VERB_COMPUTER_REPORT :: 116; VERB_AGENT_NEW_ON :: 117;
// The engine pull request from a person's own fork (issue 23; engine-fork.coax): what this computer
// needs for one, and the person's own pull requests.
VERB_ENGINE_READY :: 118; VERB_ENGINE_MINE :: 119;

GB_COMMANDS :: [GB_N] GbCommand.[
  GbCommand.{verb = "list-levels", area = "level", effect = "read", approval = "none", result = "gamebuilder.levels.v1",
    limit = "9,999 levels (LEVEL_MAX)", impl = "ed_level_number|ed_level_title|ed_level_mine", surfaces = GB_FILES, gap = "drawn|open-level",
    usage = "", help = "the levels in the folder, each with the game of yours it belongs to and its revision (read-content's)"},
  GbCommand.{verb = "read-level", area = "level", effect = "read", approval = "none", arguments = "level", result = "gamebuilder.level.v1",
    impl = "ed_agent_scene", surfaces = GB_FILES_PANE_CLOUD, gap = "drawn",
    usage = "LEVEL", help = "the level as data: its things, its shape table, its revision, and whether it is yours to change"},
  GbCommand.{verb = "read-state", area = "level", effect = "read", approval = "none", arguments = "level", result = "world.state.v1",
    impl = "ed_agent_state", surfaces = GB_FILES, gap = "drawn|pane-reads",
    usage = "LEVEL", help = "the level as the engine's world state, the form the web answers a world in"},
  GbCommand.{verb = "read-content", area = "level", effect = "read", approval = "none", arguments = "level", result = "gamebuilder.content.v1",
    impl = "ed_save", surfaces = GB_FILES, gap = "drawn|pane-reads",
    usage = "LEVEL", help = "the level's file, exactly as the app writes it"},
  GbCommand.{verb = "new-level", area = "level", effect = "edit", approval = "none", flags = "--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
    limit = "9,999 levels (LEVEL_MAX)", impl = "ed_level_next|ed_new|ed_save", surfaces = GB_EVERY, gap = "open-level",
    usage = "[--dry-run] [--key K]", help = "a new arena level of your own, numbered one past the highest"},
  GbCommand.{verb = "copy-level", area = "level", effect = "edit", approval = "none", arguments = "level", flags = "--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
    limit = "9,999 levels (LEVEL_MAX)", impl = "ed_level_next|ed_copy|ed_save", surfaces = GB_EVERY, gap = "open-level",
    usage = "LEVEL [--dry-run] [--key K]", help = "your own copy of a level, numbered one past the highest; level 0 is Scrappers Arena's own"},
  GbCommand.{verb = "list-games", area = "game", effect = "read", approval = "none", result = "gamebuilder.games.v1",
    limit = "32 games (MINE_MAX), 16 levels each (MINE_LEVELS)", impl = "ed_mines|ed_mine_at|ed_mine_title|ed_mine_template|ed_mine_level", surfaces = GB_FILES | GB_WEB, gap = "drawn|open-level",
    usage = "", help = "your games, each with its template and its levels"},
  GbCommand.{verb = "list-templates", area = "game", effect = "read", approval = "none", result = "gamebuilder.templates.v1",
    impl = "ed_templates|ed_template_name", surfaces = GB_FILES, gap = "drawn|open-level",
    usage = "", help = "the game types a new game can be made on, as the New Game picker shows them: each id, name and line (shared/game-types.coax, gamebuilder.org's too)"},
  GbCommand.{verb = "new-game", area = "game", effect = "edit", approval = "none", arguments = "template", flags = "--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
    limit = "32 games (MINE_MAX)", impl = "ed_new_game|ed_level_next|ed_mine_save|ed_save", surfaces = GB_EVERY, gap = "open-level",
    usage = "TEMPLATE [--dry-run] [--key K]", help = "a new game of yours of a game type (TEMPLATE: its id), its first level holding what that type starts with, the same things gamebuilder.org opens it with"},
  GbCommand.{verb = "rename-game", area = "game", effect = "edit", approval = "owner", arguments = "game|text", flags = "--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
    limit = "a name of 1 to 48 bytes, one line, no bar (MINE_TITLE)", impl = "ed_mine_rename|ed_mine_save", surfaces = GB_EVERY, gap = "open-level",
    usage = "GAME NAME [--dry-run] [--key K]", help = "give a game of yours a new name"},
  GbCommand.{verb = "read-game", area = "game", effect = "read", approval = "none", arguments = "game", result = "gamebuilder.content.v1",
    impl = "ed_mine_save", surfaces = GB_FILES, gap = "drawn|open-level",
    usage = "GAME", help = "a game's file: its name, its template and its levels"},
  GbCommand.{verb = "apply-edits", area = "edit", effect = "edit", approval = "owner", arguments = "level|batch", flags = "--agent:agent|--dry-run:bool|--key:key", result = "realm.result.v1",
    limit = "64 edits a batch (WE_BATCH); 200 m from the middle (AGENT_REACH)", impl = "ed_agent_apply|ed_save", surfaces = GB_FILES_PANE_CLOUD, gap = "gesture",
    usage = "LEVEL BATCH.json|'{...}' [--agent NAME] [--dry-run] [--key K]", help = "carry out a world.edit.v1 batch as one step, or refuse it whole; read the level first for its revision"},
  GbCommand.{verb = "add", area = "edit", effect = "edit", approval = "owner", arguments = "level|kind", flags = "--agent:agent|--x:cm|--z:cm|--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
    limit = "a level's one start, rival start, goals, hoops and ball; four health packs (PACKS); in the village, 33 buildings (VL_PUT) sharing 512 solid boxes (VL_WALLS), each put at the nearest place clear of the others", impl = "ed_add|ed_add_refusal|ed_save", surfaces = GB_EVERY, gap = "batch",
    usage = "LEVEL KIND [--x CM --z CM] [--agent NAME] [--dry-run] [--key K]", help = "add a thing from the template's palette, on the ground at x, z (or the middle), snapped to the grid"},
  GbCommand.{verb = "set-field", area = "edit", effect = "edit", approval = "owner", arguments = "level|thing|field|value", flags = "--agent:agent|--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
