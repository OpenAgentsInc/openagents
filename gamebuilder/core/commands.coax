// ---- the version every surface reports (docs/programmatic-access.md, "Versions")

// GB_COMMIT, GB_DIRTY: the commit this build is made from, written by scripts/env.sh.
#load "../build/stamp.coax";
GB_RELEASE :: "0.1.0";

// A digest of one row: every column, so any change to what the row is, takes or answers changes it.
gb_hash_text :: (h: int, s: string) -> int {
  x := h;
  for c: s { x = ((x ^ cast(int) c) * 16777619) & 4294967295; }
  return ((x ^ 31) * 16777619) & 4294967295;   // the end of a column
}
gb_row_digest_of :: (c: GbCommand) -> int {
  h: int = 2166136261;
  for s: [12] string.[c.verb, c.area, c.effect, c.approval, c.arguments, c.flags, c.result, c.limit, c.impl, c.gap, c.usage, c.help] { h = gb_hash_text(h, s); }
  return ((h ^ cast(int) c.surfaces) * 16777619) & 4294967295;
}
gb_row_digest :: (v: int) -> int { return ifx v >= 0 && v < GB_N then gb_row_digest_of(GB_COMMANDS[v]) else 0; }
// The table's digest: every row, in order. Two builds that answer the same rows the same way
// have the same one; a build whose table differs in anything has another.
gb_table_digest :: () -> int {
  h: int = 2166136261;
  for v: 0..<GB_N { h = ((h ^ gb_row_digest(v)) * 16777619) & 4294967295; }
  return h;
}
// A digest as the 8 hex digits every surface writes.
gb_hex8 :: (v: int, out: [] u8) -> string {
  digits := "0123456789abcdef";
  if out.count < 8 { return ""; }
  for i: 0..<8 { out[i] = digits[(v >> ((7 - i) * 4)) & 15]; }
  return cast(string) out[0..<8];
}
// The version: the release, the commit and the table, as semver's build words:
// "0.1.0+f3ece6bd335f.table-1a2b3c4d" (".dirty" after the commit when the build had changes not
// committed). The CLI's `version`, the manifest, OpenAPI, MCP's initialize, the app's About and
// the hosted server all say this one.
gb_version :: (out: [] u8) -> string {
  t := [1] Text.[Text.{buf = out}];
  hb: [8] u8;
  tx_put(t[..], GB_RELEASE); tx_put(t[..], "+"); tx_put(t[..], GB_COMMIT);
  if GB_DIRTY { tx_put(t[..], ".dirty"); }
  tx_put(t[..], ".table-"); tx_put(t[..], gb_hex8(gb_table_digest(), hb[..]));
  return cast(string) out[0..<t[0].at];
}

// The row a verb names, or -1.
gb_find :: (verb: string) -> int {
  for i: 0..<GB_N { if GB_COMMANDS[i].verb == verb { return i; } }
  return -1;
}
// Whether row v takes argument kind k ("text" also matches "text:N").
gb_part :: (s: string, k: int) -> string {
  n := 0; from := 0;
  for i: 0..<s.count + 1 {
    if i == s.count || s[i] == '|' {
      if n == k { return cast(string) s[from..<i]; }
      n += 1; from = i + 1;
    }
  }
  return "";
}
gb_parts :: (s: string) -> int {
  if s.count == 0 { return 0; }
  n := 1;
  for c: s { if c == '|' { n += 1; } }
  return n;
}
gb_has_flag :: (v: int, flag: string) -> bool {
  f := GB_COMMANDS[v].flags;
  for k: 0..<gb_parts(f) {
    p := gb_part(f, k);
    cut := 0; while cut < p.count && p[cut] != ':' { cut += 1; }
    if cast(string) p[0..<cut] == flag { return true; }
  }
  return false;
}

// ---- arguments

// What a call names, read from words (the CLI's argv, or a tool call's values).
GbArgs :: struct {
  which: s32;                     // picture's: PIC_BEFORE, PIC_AFTER or PIC_PLAYTEST (pictures.coax)
  level: s32; game: s32; plays: s32; kind: s32; thing: s32; field: s32; value: s32;
  x: s32; z: s32; at: bool;       // where an added thing goes; at false: the middle of the view
  dry: bool;                      // --dry-run: carry it out, answer, write nothing
  key: string;                    // --key K: the surface keeps the first result sent with K and answers it again (gb_key_ok)
  tool: s32;                      // set-tool's: as ed_tool numbers it
  agent: s32;                     // who calls: an Agents pane agent's id (agents.coax), a named agent's (--agent), or 0: the person
  who: string;                    // --agent NAME: the name a program gives itself (claims.coax)
  region: string; claim: ClaimRegion;   // claim's: a box or things, as written and as read
  mode: s32; size: s32; seconds: s32; seed: s32;   // play-test's (playtest.coax), with its defaults when not given
  text: string; batch: string;
  revision: s32; content: string;  // write-content's: the revision the file was read at (0: none), and the file
  aid: string; role: s32;          // an agent's id; a new agent's kind (AGR_KIND_ID)
  say: string;                     // a new agent's job, a message, or an answer, in the person's words
  after: s32; report: string;      // agent-events' cursor; agent-report's report (and computer-report's status)
  picture: string;                 // agent-picture's: one gamebuilder.picture.v1 line (agent-pictures.coax)
  on: string;                      // agent-new-on's computer, by its name
  pick: s32;                       // a shipped game, a Scrapper, a bag's slot, a lobby player, line or party member: its number
  side: s32; yes: bool;            // party-side's side; party-answer's yes, party-look's on
  into: s32; owners: string;       // move-level's game (0: none); set-owners' accounts, a comma between each
  pub: s32; version: s32; item: s32;   // a published game, its version, an item of its feedback (publish.coax)
  from: string;                    // publish's --from CODE: the published game this one was remixed from ("": none)
}
// Flags as words: "" when not given.
GbFlags :: struct { x: string; z: string; dry: bool; key: string; mode: string; size: string; seconds: string; seed: string; agent: string; from: string; }
// One word of a call read as a row's flag, the way every surface that takes a command line reads
// it (the CLI's arguments; a cloud Builder's command, coax/cloud-rows.coax): 2 when w is a flag
// that takes the word after it (v, kept in f), 1 when it stands alone, 0 when w is no row's flag.
gb_flag_take :: (w: string, v: string, f: [] GbFlags) -> int {
  if w == "--dry-run" { f[0].dry = true; return 1; }
  if w == "--agent" { f[0].agent = v; return 2; }
  if w == "--x" { f[0].x = v; return 2; }
  if w == "--z" { f[0].z = v; return 2; }
  if w == "--key" { f[0].key = v; return 2; }
  if w == "--mode" { f[0].mode = v; return 2; }
  if w == "--size" { f[0].size = v; return 2; }
  if w == "--seconds" { f[0].seconds = v; return 2; }
  if w == "--seed" { f[0].seed = v; return 2; }
  if w == "--from" { f[0].from = v; return 2; }
  return 0;
}

// A key, as realm.result.v1's are: 1 to 64 of letters, digits, -, _ and ., starting with a
// letter or a digit (a key names a file).
GB_KEY_MAX :: 64;
gb_key_ok :: (k: string) -> bool {
  if k.count < 1 || k.count > GB_KEY_MAX { return false; }
  for i: 0..<k.count {
    c := k[i];
    word := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
    if !word && (i == 0 || (c != '-' && c != '_' && c != '.')) { return false; }
  }
  return true;
}

GbInt :: struct { ok: bool; v: int; }
// A whole number, with an optional minus: at most 9 digits.
gb_int :: (s: string) -> GbInt {
  neg := s.count > 0 && s[0] == '-';
  d := ifx neg then cast(string) s[1..<s.count] else s;
  if d.count == 0 || d.count > 9 { return GbInt.{}; }
  v := 0;
  for c: d { if c < '0' || c > '9' { return GbInt.{}; } v = v * 10 + cast(int) (c - '0'); }
  return GbInt.{ok = true, v = ifx neg then -v else v};
}
// A revision (ed_agent_rev's, below 2^31): its value, or -1 when w is not one.
gb_revision :: (w: string) -> int {
  if w.count == 0 || w.count > 10 { return -1; }
  v := 0;
  for c: w { if c < '0' || c > '9' { return -1; } v = v * 10 + cast(int) (c - '0'); }
  return ifx v > 2147483647 then -1 else v;
}
// Lower case, for matching a field's name.
gb_same_lower :: (a: string, b: string) -> bool {
  if a.count != b.count { return false; }
  for i: 0..<a.count {
    x := a[i]; y := b[i];
    if x >= 'A' && x <= 'Z' { x += 32; }
    if y >= 'A' && y <= 'Z' { y += 32; }
    if x != y { return false; }
  }
  return true;
}

// Reads the words for row v into a: "" when they are good, else why not.
// The why names the argument and its bounds.
gb_args_read :: (v: int, words: [] string, flags: GbFlags, a: [] GbArgs) -> string {
  a[0] = GbArgs.{};
  c := GB_COMMANDS[v];
  want := gb_parts(c.arguments);
  if words.count < want { return ifx want == 1 then "it takes one argument" else "it takes more arguments"; }
  if words.count > want { return "it takes fewer arguments"; }
  for k: 0..<want {
    kind := gb_part(c.arguments, k); w := words[k];
    if kind == "level" {
      n := gb_int(w);
      if !n.ok || n.v < 0 || n.v > LEVEL_MAX { return "a level is a number from 0 to 9999 (LEVEL_MAX)"; }
      a[0].level = cast(s32) n.v;
    } else if kind == "game" {
      n := gb_int(w);
      if !n.ok || n.v < 1 || n.v > LEVEL_MAX { return "a game is a number from 1 to 9999 (list-games)"; }
      a[0].game = cast(s32) n.v;
    } else if kind == "template" {
      t := template_of(w);
      if t < 0 { return "a template is a game type's id: list-templates names them"; }
      a[0].plays = t;
    } else if kind == "kind" {
      t := level_kind_of(w);
      if t < 0 { return "a kind is a kind's word: list-palette names the ones a level's game type offers"; }
      a[0].kind = t;
    } else if kind == "thing" {
      n := gb_int(w);
      if !n.ok || n.v < 1 { return "a thing is its id, a number from 1 (read-level)"; }
      a[0].thing = cast(s32) n.v;
    } else if kind == "field" {
      f := -1;
      for i: 0..<FIELDS { if gb_same_lower(w, FIELD_NAME[i]) { f = i; } }
      if f < 0 { return "a field is kind, east, up, north, turn, scale, width, height or depth, or a moving platform's or a lift's distance or period"; }
      a[0].field = cast(s32) f;
    } else if kind == "value" {
      if a[0].field == FIELD_KIND {
        t := level_kind_of(w);
        if t < 0 { return "a kind is one of the palette's (list-palette)"; }
        a[0].value = t;
      } else {
        n := gb_int(w);
        if !n.ok { return "a value is a whole number"; }
        a[0].value = cast(s32) n.v;
      }
    } else if kind == "text" {
      if !mine_title_ok(w) { return "a name is 1 to 48 bytes on one line, with no bar and no space at either end (MINE_TITLE)"; }
      a[0].text = w;
    } else if kind == "batch" {
      if w.count == 0 { return "a batch is a world.edit.v1 batch"; }
      a[0].batch = w;
    } else if kind == "revision" {
      r := gb_revision(w);
      if r < 0 { return "a revision is read-content's, a whole number from 0 (0: the level isn't there yet)"; }
      a[0].revision = cast(s32) r;
    } else if kind == "content" {
      if w.count == 0 { return "the content is a level's file (read-content)"; }
      if w.count > AGENT_FILE_MAX { return "a level's file is at most 262144 bytes (AGENT_FILE_MAX)"; }
      a[0].content = w;
    } else if kind == "agent" {
      if !agr_id_ok(w) { return "an agent is its id: 1 to 32 of a to z, 0 to 9 and -, starting with a letter (agents)"; }
      a[0].aid = w;
    } else if kind == "role" {
      t := agr_index(AGR_KIND_ID[..], w);
      if t < 0 { return "a role is build, playtest, art, fix, watch or code"; }
      a[0].role = cast(s32) t;
    } else if kind == "job" {
      why := agr_job_why(w);
      if why.count > 0 { return why; }
      a[0].say = w;
    } else if kind == "message" || kind == "answer" {
      if w.count == 0 { return ifx kind == "message" then "say what you want it to do" else "answer with one of its answers"; }
      if w.count > AGR_MESSAGE_MAX { return "a message is at most 1000 bytes (AGR_MESSAGE_MAX)"; }
      a[0].say = w;
    } else if kind == "after" {
      n := gb_int(w);
      if !n.ok || n.v < 0 || n.v > AGR_EVENTS { return "after is an event's number, 0 to 100000 (0: from the first)"; }
      a[0].after = cast(s32) n.v;
    } else if kind == "report" {
      if w.count == 0 || w[0] != '{' { return "a report is a JSON object: {record, from, events}"; }
      a[0].report = w;
    } else if kind == "picture" {
      if w.count == 0 || w[0] != '{' { return "a picture is one gamebuilder.picture.v1 line, a JSON object"; }
      if w.count > PIC_LINE { return "a picture's line is at most 12288 bytes (PIC_LINE)"; }
      a[0].picture = w;
    } else if kind == "status" {
      if w.count == 0 || w[0] != '{' { return "a computer's status is a JSON object (gamebuilder.computer.v1)"; }
      a[0].report = w;
    } else if kind == "computer" {
      if w.count == 0 || w.count > AGR_COMPUTER || !agr_line_ok(w) { return "a computer is its name, 1 to 48 bytes on one line (computers)"; }
      a[0].on = w;
    } else if kind == "region" {
      r: [1] ClaimRegion;
      why := claim_region_read(w, r[..]);
      if why.count > 0 { return why; }
      a[0].region = w; a[0].claim = r[0];
    } else if kind == "shipped" || kind == "scrapper" || kind == "slot" || kind == "player" || kind == "line" || kind == "member" || kind == "side" {
      n := gb_int(w); most := gb_pick_most(kind);
      if !n.ok || n.v < 0 || n.v > most { return gb_pick_words(kind); }
      if kind == "side" { a[0].side = cast(s32) n.v; } else { a[0].pick = cast(s32) n.v; }
    } else if kind == "into" {
      n := gb_int(w);
      if !n.ok || n.v < 0 || n.v > LEVEL_MAX { return "a game is a number from 1 to 9999 (list-games), or 0 for none"; }
      a[0].into = cast(s32) n.v;
    } else if kind == "published" || kind == "version" || kind == "feedback" {
      n := gb_int(w);
      if !n.ok || n.v < 1 || n.v > 1000000 { return ifx kind == "published" then "a published game is its number (published)" else ifx kind == "version" then "a version is its number, from 1 (versions)" else "a feedback item is its number (feedback)"; }
      if kind == "published" { a[0].pub = cast(s32) n.v; } else if kind == "version" { a[0].version = cast(s32) n.v; } else { a[0].item = cast(s32) n.v; }
    } else if kind == "owners" {
      why := mine_owners_why(w);
      if why.count > 0 { return why; }
      a[0].owners = w;
    } else if kind == "reply" || kind == "look" {
      yes := ifx kind == "reply" then "yes" else "on"; no := ifx kind == "reply" then "no" else "off";
      if w != yes && w != no { return ifx kind == "reply" then "answer yes or no" else "look is on or off"; }
      a[0].yes = w == yes;
    } else if kind == "say" {
      if w.count == 0 { return "say something"; }
      if w.count > LB_TEXT { return "a message is at most 280 bytes (LB_TEXT)"; }
      a[0].say = w;
    } else if kind == "name" {
      if w.count < LB_NAME_MIN || w.count > LB_NAME { return "a lobby name is 3 to 20 bytes (LB_NAME_MIN, LB_NAME)"; }
      a[0].text = w;
    } else if kind == "which" {
      t := pic_which_of(w);
      if t == 0 { return "which picture is before, after or playtest"; }
      a[0].which = t;
    } else if kind == "tool" {
      t := -1;
      for i: 0..<ED_TOOLS { if w == GB_TOOL_WORD[i] { t = i; } }
      if t < 0 { return "a tool is select, move, rotate or scale"; }
      a[0].tool = cast(s32) t;
    }
  }
  if flags.x.count > 0 || flags.z.count > 0 {
    if !gb_has_flag(v, "--x") { return "it takes no --x or --z"; }
    x := gb_int(flags.x); z := gb_int(flags.z);
    if !x.ok || !z.ok { return "--x and --z come together, each a whole number of centimetres"; }
    if x.v < -AGENT_REACH || x.v > AGENT_REACH || z.v < -AGENT_REACH || z.v > AGENT_REACH { return "--x and --z are within 20000 cm of the middle (AGENT_REACH)"; }
    a[0].x = cast(s32) x.v; a[0].z = cast(s32) z.v; a[0].at = true;
  }
  if flags.dry {
    if !gb_has_flag(v, "--dry-run") { return "it changes nothing, so it takes no --dry-run"; }
    a[0].dry = true;
  }
  if flags.agent.count > 0 {
    if !gb_has_flag(v, "--agent") { return "it takes no --agent: only a change, a claim and a release say which agent makes them"; }
    if !claim_name_ok(flags.agent) { return "--agent NAME is 1 to 32 of letters, digits, -, _ and ., starting with a letter or a digit"; }
    a[0].who = flags.agent; a[0].agent = claim_named(flags.agent);
  }
  if flags.key.count > 0 {
    if !gb_has_flag(v, "--key") { return "it changes nothing, so it takes no --key"; }
    if !gb_key_ok(flags.key) { return "--key K is 1 to 64 of letters, digits, -, _ and ., starting with a letter or a digit"; }
    a[0].key = flags.key;
  }
  if flags.from.count > 0 {
    if !gb_has_flag(v, "--from") { return "it takes no --from: only publish says which game a remix came from"; }
    if !pub_code_ok(flags.from) { return PUB_FROM_WORDS; }
    a[0].from = flags.from;
  }
  return gb_args_play(v, flags, a);
}
// The most a numbered kind may be, and what it is in words when it is out of bounds.
gb_pick_most :: (kind: string) -> int {
  if kind == "shipped" { return GAMES - 1; }
  if kind == "scrapper" { return CLASSES - 1; }
  if kind == "slot" { return SCENE_HOTBAR - 1; }
  if kind == "player" { return LB_PLAYERS - 1; }
  if kind == "line" { return LB_MESSAGES - 1; }
  if kind == "member" { return PT_MEMBERS - 1; }
  return 1;   // side
}
gb_pick_words :: (kind: string) -> string {
  if kind == "shipped" { return "a game the app ships is 0 (Scrappers Arena) or 1 (SPLICEBOTS) (GAMES)"; }
  if kind == "scrapper" { return "a Scrapper is its number, 0 to 2 (list-scrappers)"; }
  if kind == "slot" { return "a slot of the bag is 0 to 8 (SCENE_HOTBAR)"; }
  if kind == "player" { return "a player is their number in lobby-read, 0 to 47 (LB_PLAYERS)"; }
  if kind == "line" { return "a line is its number in lobby-read, 0 to 59 (LB_MESSAGES)"; }
  if kind == "member" { return "a member is their number in party-read, 0 to 3 (PT_MEMBERS)"; }
  return "a side is 0 or 1";
}
// play-test's flags, each with its default.
gb_args_play :: (v: int, flags: GbFlags, a: [] GbArgs) -> string {
  a[0].mode = MODE_KNOCKOUTS; a[0].size = SIZE_USUAL; a[0].seconds = PLAYTEST_SECONDS; a[0].seed = PLAYTEST_SEED;
  if flags.mode.count + flags.size.count + flags.seconds.count + flags.seed.count == 0 { return ""; }
  if !gb_has_flag(v, "--mode") { return "it takes no --mode, --size, --seconds or --seed"; }
  if flags.mode.count > 0 {
    m := playtest_mode_of(flags.mode);
    if m < 0 { return "--mode is knockouts, last-stand, scrapball or hoops (list-modes)"; }
    a[0].mode = m;
  }
  if flags.size.count > 0 {
    n := gb_int(flags.size);
    if !n.ok || n.v < 1 || n.v > TEAM_SIZE { return "--size is 1 to 5 a side (TEAM_SIZE)"; }
    a[0].size = cast(s32) n.v;
  }
  if flags.seconds.count > 0 {
    n := gb_int(flags.seconds);
    if !n.ok || n.v < 1 || n.v > PLAYTEST_SECONDS { return "--seconds is 1 to 600 of match time (PLAYTEST_SECONDS)"; }
    a[0].seconds = cast(s32) n.v;
  }
  if flags.seed.count > 0 {
    n := gb_int(flags.seed);
    if !n.ok || n.v < 0 { return "--seed is a whole number from 0 to 999999999"; }
    a[0].seed = cast(s32) n.v;
  }
  return "";
}

// ---- carrying a row out

GB_DOC_MAX :: 262144;       // a level's file, at most (ed_save_max, held by a check)
GB_DONE :: 0; GB_REFUSED :: 1; GB_APPROVAL :: 2; GB_UNKNOWN :: 3;

// What the surface around the core does next: write the open level (as
// ed_level numbers it) and your game save_game, unless it was a dry run.
GbResult :: struct {
  code: s32; json: string; save_level: bool; save_game: s32;
  agent: s32;      // an agent row's: the store's record k + 1 to write (agent-ID.agent), 0 for none
  lines: string;   // and the event lines to append to its log (agent-ID.events), each with its line break
  drop_level: s32; drop_game: s32;   // a level's file and a game's file to delete (delete-level, delete-game), 0 for none
  save_also: s32;                    // a second game of yours to write (move-level's: the one it left), 0 for none
  published: s32; version: s32;      // publish's: the published game and the version just made, whose level file the surface keeps (0: none)
  undone: bool;                      // agent-undo took back a cloud agent's kept change: the surface lets it go (GbWorld.undo)
  // agent-picture's (agent-pictures.coax): the folder's agent-pictures file whole, the JPEG to keep
  // as picture-ADDRESS.jpg and its address, and the address of the one it replaced, to delete ("" for none)
  pictures: string; jpeg: string; jpeg_at: string; jpeg_gone: string;
  computer: s32;                     // computer-report's: the store's computer k + 1 to write (computer-ID.computer), 0 for none
}

// What the core is told about the folder: the level numbers there are, and (where the surface
// read the files: the CLI, MCP and HTTP) each one's revision, in the same order.
// For an agent row (agent-rows.coax): the agents there are (none: an empty slice), the named
// agent's log as its file holds it, the time now in milliseconds since 1970, and this computer's
// name as the person sees it ("this Mac").
// hosted: an account's files on the site's server (serve --accounts), where agents are reported
// to and read, never started or told anything: they run on the person's computer.
// games: where a published game's link lives (GAMES_DOMAIN: "https://gamebuilder.org" on the site's server), "" on a
// device, where a publish is kept on the device.
// pictures: the folder's agent-pictures file, each agent's newest picture kept there (agent-pictures.coax), "" for none.
// A hosted server (serve --accounts) says whether it runs cloud agents (it has a model key: issue 7,
// cli/cloud.coax), and for agent-undo the named cloud agent's newest change kept to take back:
// "LEVEL BEFORE AFTER" on a line, then the level's file as it was before it ("": none kept).
GbWorld :: struct { levels: [] s32; revs: [] s32; agents: [] AgrStore; log: string; now: s64; computer: string; hosted: bool; games: string; cloud: bool; undo: string; pictures: string;
  computers: [] AgrComputers;     // the computers the surface read (computer-ID.computer; issue 11)
  plays: string; }                // each of the account's published games' counts, a line a game (shared/plays.coax py_list_put): a hosted server's, "" on a device

gb_refuse :: (o: [] Jo, error: string, why: string) -> GbResult {
  jo_obj(o); jo_key(o, "ok"); jo_bool(o, false);
  jo_key(o, "error"); jo_str(o, error);
  jo_key(o, "why"); jo_str(o, why);
  jo_end(o);
  return GbResult.{code = GB_REFUSED, json = jo_text(o)};
}
gb_ok :: (o: [] Jo) { jo_obj(o); jo_key(o, "ok"); jo_bool(o, true); }
gb_done :: (o: [] Jo, a: GbArgs, save_level: bool, save_game: s32) -> GbResult {
  if a.dry { jo_key(o, "dry_run"); jo_bool(o, true); }
  if a.key.count > 0 && !a.dry { jo_key(o, "key"); jo_str(o, a.key); }
  jo_end(o);
  if o[0].bad { return GbResult.{code = GB_REFUSED, json = ""}; }
  return GbResult.{code = GB_DONE, json = jo_text(o), save_level = save_level && !a.dry, save_game = ifx a.dry then 0 else save_game};
}

// Opens level n from its file's bytes (none: there is no file): a level of
// yours, or Scrappers Arena's own (0). The host calls it before a row that
// names a level. "" when it is open, else why not.
gb_open :: (e: [] Editor, n: s32, text: [] u8, found: bool) -> string {
  if n == 0 { return ifx ed_open_game(e, GAME_SCRAPPERS, text) then "" else "Scrappers Arena's level file is not a level's"; }
  if !found { return "there is no such level (list-levels)"; }
  return ifx ed_open(e, n, text) then "" else "that file is not a level's";
}

// Carries out row v on the open editor (gb_open first for a row that names a
// level) and writes its answer into out.
gb_run :: (e: [] Editor, v: int, a: GbArgs, w: GbWorld, out: [] u8) -> GbResult {
  o: [1] Jo; jo_start(o[..], out);
  if e.count != 1 || v < 0 || v >= GB_N { return gb_refuse(o[..], "bad-request", "no such command"); }
  c := GB_COMMANDS[v];
  if c.area == "account" { return gb_refuse(o[..], "bad-request", "the account is asked of the server by the surface, not the core"); }
  if v == VERB_ENGINE { return gb_refuse(o[..], "bad-request", "the surface answers the engine row with the commit it was built on (gb_engine)"); }
  if c.area == "site" { return gb_refuse(o[..], "bad-request", "the surface answers the funnel row from the day files its server keeps (gamebuilder funnel, or --remote for gamebuilder.org's)"); }
  if v == VERB_DECIDE { return gb_refuse(o[..], "bad-request", "the app carries Decide out: it sends the request the core writes (ed_decide_body) and hands back the answer"); }
  if v == VERB_WRITE_CONTENT { return gb_write_content(e, a, w, o[..]); }
  if c.area == "publish" { return gb_run_publish(e, v, a, w, o[..]); }
  if c.area == "web" { return gb_refuse(o[..], "not-permitted", "it is a plan line of gamebuilder.org's own world (web/blocks.coax): a level here takes apply-edits"); }
  if c.area == "lobby" { return gb_refuse(o[..], "not-permitted", "the lobby is the person's own, on the app's lobby sheet (ed_lobby_command): a program or an agent does not join the room"); }
  if v >= VERB_DELETE_LEVEL && v <= VERB_SET_OWNERS { return gb_run_manage(e, v, a, w, o[..]); }
  if v >= VERB_OPEN_LEVEL && v <= VERB_BAG_SELECT { return gb_run_play(e, v, a, w, o[..]); }
  if c.area == "agent" { return gb_agent_run(e, v, a, w, o[..]); }
  if c.approval == "owner" && c.area != "game" && !ed_may_edit(e) {
    return gb_refuse(o[..], "not-permitted", "this level is not yours to change: make your own copy (copy-level)");
  }
  if v == VERB_LIST_LEVELS {
    gb_ok(o[..]); jo_key(o[..], "levels"); jo_arr(o[..]);
    for i: 0..<LEVEL_MAX + 1 {     // in order
      if !gb_world_has(w, cast(s32) i) { continue; }
      jo_obj(o[..]);
      we_int(o[..], "level", i);
      b: [64] u8; jo_key(o[..], "title"); jo_str(o[..], cast(string) b[0..<ed_level_title(cast(s32) i, b[..])]);
      we_int(o[..], "game", cast(int) ed_level_mine(e, cast(s32) i));
      gi := mine_find(e, ed_level_mine(e, cast(s32) i));
      if gi >= 0 { for k: 0..<cast(s64) e[0].mine[gi].level_n { if e[0].mine[gi].levels[k] == cast(s32) i && e[0].mine[gi].name_n[k] > 0 { jo_key(o[..], "name"); nb: [MINE_TITLE] u8; jo_str(o[..], mine_level_name(e[0].mine[gi], k, nb[..])); } } }
      // what read-content would say: a device's sync asks only for what changed
      rev := gb_world_rev(w, cast(s32) i);
      if rev >= 0 { we_int(o[..], "revision", rev); }
      jo_end(o[..]);
    }
    jo_end(o[..]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_READ_LEVEL { return gb_raw(o[..], ed_agent_scene(e, out)); }
  if v == VERB_READ_STATE { return gb_raw(o[..], ed_agent_state(e, out)); }
  if v == VERB_READ_CONTENT {
    doc: [GB_DOC_MAX] u8; n := ed_save(e, doc[..]);
    if n <= 0 { return gb_refuse(o[..], "bad-request", "the level's file did not fit"); }
    gb_ok(o[..]); we_int(o[..], "level", cast(int) ed_level(e)); we_int(o[..], "revision", ed_agent_rev(e));
    jo_key(o[..], "content"); jo_str(o[..], cast(string) doc[0..<n]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_NEW_LEVEL || v == VERB_COPY_LEVEL {
    n := ed_level_next(w.levels);
    if n == 0 { return gb_refuse(o[..], "edit-refused", "there are 9999 levels already (LEVEL_MAX)"); }
    from := e[0].level;
    if v == VERB_NEW_LEVEL { ed_new(e, n); } else { ed_copy(e, n); }
    if ed_level(e) != n { return gb_refuse(o[..], "edit-refused", "the level could not be made"); }
    gb_ok(o[..]); we_int(o[..], "level", cast(int) n);
    if v == VERB_COPY_LEVEL { we_int(o[..], "from", cast(int) from); }
    return gb_done(o[..], a, true, 0);
  }
  if v == VERB_LIST_GAMES {
    gb_ok(o[..]); jo_key(o[..], "games"); jo_arr(o[..]);
    for i: 0..<ed_mines(e) {
      g := ed_mine_at(e, i);
      jo_obj(o[..]);
      we_int(o[..], "game", cast(int) g);
      b: [64] u8; jo_key(o[..], "title"); jo_str(o[..], cast(string) b[0..<ed_mine_title(e, g, b[..])]);
      jo_key(o[..], "template"); jo_str(o[..], TEMPLATE_ID[ed_mine_template(e, g)]);
      jo_key(o[..], "levels"); jo_arr(o[..]);
      m := e[0].mine[mine_find(e, g)];
      for k: 0..<cast(s64) m.level_n { jo_int(o[..], cast(int) m.levels[k]); }
      jo_end(o[..]);
      jo_end(o[..]);
    }
    jo_end(o[..]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_LIST_TEMPLATES {
    gb_ok(o[..]); jo_key(o[..], "templates"); jo_arr(o[..]);
    // in the order the app's picker shows them (shared/game-types.coax gt_picker)
    order: [GT_TYPES] int; n := gt_picker(GT_ON_APP, order[..]);
    for i: 0..<n {
      t := order[i];
      jo_obj(o[..]); jo_key(o[..], "template"); jo_str(o[..], TEMPLATE_ID[t]); jo_key(o[..], "name"); jo_str(o[..], TEMPLATE_NAME[t]);
      jo_key(o[..], "line"); jo_str(o[..], GT_LINE[t]); jo_end(o[..]);
    }
    jo_end(o[..]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_NEW_GAME {
    level := ed_level_next(w.levels);
    g: s32 = 1;
    while g <= LEVEL_MAX && mine_find(e, g) >= 0 { g += 1; }
    if e[0].mine_n >= MINE_MAX { return gb_refuse(o[..], "edit-refused", "you have 32 games already (MINE_MAX)"); }
    if level == 0 { return gb_refuse(o[..], "edit-refused", "there are 9999 levels already (LEVEL_MAX)"); }
    if !ed_new_game(e, g, a.plays, level) { return gb_refuse(o[..], "edit-refused", "the game could not be made"); }
    gb_ok(o[..]); we_int(o[..], "game", cast(int) g); we_int(o[..], "level", cast(int) level);
    jo_key(o[..], "template"); jo_str(o[..], TEMPLATE_ID[a.plays]);
    // (a type that starts with several levels: all of them, in order; the first is the one open)
    if gt_levels(cast(int) a.plays) > 1 { jo_key(o[..], "levels"); jo_arr(o[..]); for k: 0..<gt_levels(cast(int) a.plays) { jo_int(o[..], cast(int) level + k); } jo_end(o[..]); }
    return gb_done(o[..], a, true, g);
  }
  if v == VERB_RENAME_GAME || v == VERB_READ_GAME {
    if mine_find(e, a.game) < 0 { return gb_refuse(o[..], "not-found", "you have no such game (list-games)"); }
    if v == VERB_RENAME_GAME {
      b: [MINE_TITLE] u8;
      for i: 0..<a.text.count { b[i] = a.text[i]; }
      if a.text.count > MINE_TITLE || !ed_mine_rename(e, a.game, b[0..<a.text.count]) { return gb_refuse(o[..], "edit-refused", "that name can't be a game's"); }
      gb_ok(o[..]); we_int(o[..], "game", cast(int) a.game); jo_key(o[..], "title"); jo_str(o[..], a.text);
      return gb_done(o[..], a, false, a.game);
    }
    doc: [MINE_DOC_MAX] u8; n := ed_mine_save(e, a.game, doc[..]);
    gb_ok(o[..]); we_int(o[..], "game", cast(int) a.game);
    jo_key(o[..], "content"); jo_str(o[..], cast(string) doc[0..<n]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_APPLY_EDITS {
    // the engine reads a batch only in the wire's own form; the spaces and line breaks
    // a person or an agent writes between its parts are dropped first, which loses nothing
    tb: [WE_BATCH_BODY] u8;
    batch := gb_tidy(a.batch, tb[..]);
    snap: [1] ChSnap; ch_snap(e, snap[..]);
    text := agent_apply_text(e, a.agent, batch, out);
    if text.count == 0 { return gb_refuse(o[..], "bad-request", "the answer did not fit"); }
    ok := agent_answer_ok(text);
    if !ok && agent_has(text, "\"error\":\"unreadable\"") {
      // say how it reads, written as the wire writes it, when it reads at all
      cb: [WE_BATCH_BODY] u8;
      wire := gb_wire(batch, cb[..]);
      if wire.count > 0 && wire != batch {
        jo_start(o[..], out);
        jo_obj(o[..]); jo_key(o[..], "ok"); jo_bool(o[..], false); jo_key(o[..], "error"); jo_str(o[..], "unreadable");
        jo_key(o[..], "why"); jo_str(o[..], "a batch is written as the wire writes it: each edit's fields in the wire's order, and no others. Here is yours written so; check nothing of yours was left out, then send it");
        jo_key(o[..], "wire"); jo_str(o[..], wire); jo_end(o[..]);
        return GbResult.{code = GB_REFUSED, json = ifx o[0].bad then text else jo_text(o[..])};
      }
    }
    // what it changed, in words (changes.coax): a dry run says what the batch would do
    if ok && text[text.count - 1] == '}' {
      things: [CH_MARKS] ChThing;
      k := ch_diff(e, snap[..], things[..]);
      sb: [8192] u8; so: [1] Jo; jo_start(so[..], sb[..]);
      jo_obj(so[..]); ch_json(so[..], things[0..<k]); jo_end(so[..]);
      more := jo_text(so[..]);
      if !so[0].bad && more.count > 2 && text.count + more.count <= out.count {
        out[text.count - 1] = ',';
        for i: 1..<more.count { out[text.count - 1 + i] = more[i]; }
        text = cast(string) out[0..<text.count - 1 + more.count];
      }
    }
    // the seam's answer, with what gb_done adds to any other row's
    if ok && (a.dry || a.key.count > 0) && text.count + 32 + a.key.count <= out.count && text[text.count - 1] == '}' {
      tb2: [96] u8; t := [1] Text.[Text.{buf = tb2[..]}];
      if a.dry { tx_put(t[..], ",\"dry_run\":true"); } else { tx_put(t[..], ",\"key\":\""); tx_put(t[..], a.key); tx_put(t[..], "\""); }
      tx_put(t[..], "}");
      for i: 0..<t[0].at { out[text.count - 1 + i] = tb2[i]; }
      text = cast(string) out[0..<text.count - 1 + t[0].at];
    }
    return GbResult.{code = ifx ok then GB_DONE else GB_REFUSED, json = text, save_level = ok && !a.dry};
  }
  if v == VERB_ADD {
    why := ed_add_why(e, a.kind);
    if why.count > 0 && !ed_kind_one(e, a.kind) { return gb_refuse(o[..], "edit-refused", why); }
    if a.at { p := e[0].vp[..]; p[0].here_ok = true; p[0].here_x = cast(int) a.x; p[0].here_z = cast(int) a.z; }
    had := ed_index(e, e[0].selected);
    steps := ed_scene(e).st[0].done;
    id := ed_add(e, a.kind);
    if id == 0 && why.count == 0 && gk_building(cast(int) a.kind) >= 0 { rb: [128] u8; rn := vl_why_words(VL_WHY_ROOM, 0, rb[..], 0); return gb_refuse(o[..], "edit-refused", cast(string) rb[0..<rn]); }
    if id == 0 { return gb_refuse(o[..], "edit-refused", ifx why.count > 0 then why else "it could not be added"); }
    // where it landed may be in another agent's claim: then it is taken back, and not left to redo
    if ed_scene(e).st[0].done > steps {
      at := ed_actor(e, ed_index(e, id));
      wb: [512] u8; k := claim_on_place(e, a.agent, cast(int) at.x, cast(int) at.z);
      if k >= 0 {
        ed_undo(e); editor_scene_branch(ed_scene(e));
        return gb_refuse(o[..], "claimed", claim_why(e, k, "where it would put the new thing", 0, wb[..]));
      }
      claims_touch(e, a.agent);
    }
    gb_ok(o[..]); we_int(o[..], "id", cast(int) id);
    jo_key(o[..], "kind"); jo_str(o[..], LEVEL_KIND[a.kind]);
    // a kind a level has one of: the one there is, not moved
    if why.count > 0 { jo_key(o[..], "already"); jo_bool(o[..], true); jo_key(o[..], "why"); jo_str(o[..], why); }
    we_int(o[..], "rev", ed_agent_rev(e));
    return gb_done(o[..], a, why.count == 0, 0);
  }
  if v == VERB_SET_FIELD || v == VERB_DELETE {
    if ed_index(e, a.thing) < 0 { return gb_refuse(o[..], "not-found", "the level has no such thing (read-level)"); }
    wb: [512] u8;
    k := claim_on_thing(e, a.agent, a.thing);
    if k >= 0 { return gb_refuse(o[..], "claimed", claim_why(e, k, "thing", cast(int) a.thing, wb[..])); }
    if v == VERB_SET_FIELD && (a.field == FIELD_X || a.field == FIELD_Z) {
      at := ed_actor(e, ed_index(e, a.thing));
      k = claim_on_place(e, a.agent, ifx a.field == FIELD_X then cast(int) a.value else cast(int) at.x, ifx a.field == FIELD_Z then cast(int) a.value else cast(int) at.z);
      if k >= 0 { return gb_refuse(o[..], "claimed", claim_why(e, k, "where it would move the thing", 0, wb[..])); }
    }
    claims_touch(e, a.agent);
    e[0].selected = a.thing;
    if v == VERB_DELETE {
      ed_delete(e);
      if ed_index(e, a.thing) >= 0 { return gb_refuse(o[..], "edit-refused", "it could not be taken out"); }
      gb_ok(o[..]); we_int(o[..], "id", cast(int) a.thing); we_int(o[..], "rev", ed_agent_rev(e));
      return gb_done(o[..], a, true, 0);
    }
    why := ed_field_why(e, a.field, a.value);
    if why.count > 0 {
      if why == "out of range" {
        b: [128] u8; t := [1] Text.[Text.{buf = b[..]}];
        tx_put(t[..], FIELD_NAME[a.field]); tx_put(t[..], " is from "); tx_n(t[..], FIELD_MIN[a.field]);
        tx_put(t[..], " to "); tx_n(t[..], FIELD_MAX[a.field]);
        u := FIELD_UNIT[a.field];
        if u == "cm" { tx_put(t[..], " "); }
        tx_put(t[..], u);
        return gb_refuse(o[..], "edit-refused", cast(string) b[0..<t[0].at]);
      }
      return gb_refuse(o[..], "edit-refused", why);
    }
    if !ed_set_field(e, a.field, a.value) { return gb_refuse(o[..], "edit-refused", "the field could not be set"); }
    gb_ok(o[..]); we_int(o[..], "id", cast(int) a.thing);
    jo_key(o[..], "field"); jo_str(o[..], FIELD_NAME[a.field]);
    we_int(o[..], "value", cast(int) ed_field(e, a.field)); we_int(o[..], "rev", ed_agent_rev(e));
    return gb_done(o[..], a, true, 0);
  }
  if v == VERB_LIST_PALETTE {
    gb_ok(o[..]); jo_key(o[..], "template"); jo_str(o[..], TEMPLATE_ID[ed_template(e)]);
    jo_key(o[..], "kinds"); jo_arr(o[..]);
    for i: 0..<ed_palette_count(e) {
      k := ed_palette_kind(e, cast(s32) i);
      jo_obj(o[..]); jo_key(o[..], "kind"); jo_str(o[..], LEVEL_KIND[k]); jo_key(o[..], "name"); jo_str(o[..], KIND_NAME[k]);
      jo_key(o[..], "one"); jo_bool(o[..], ed_kind_one(e, k)); jo_end(o[..]);
    }
    jo_end(o[..]);
    // what the game type is, how building goes in it and its limits, in words with their numbers: what
    // gamebuilder.org's model is told of the same type (shared/game-types.coax)
    t := cast(int) ed_template(e);
    jo_key(o[..], "game_type"); jo_str(o[..], GT_SAID[t]);
    if GT_BUILT[t].count > 0 { jo_key(o[..], "building"); jo_str(o[..], GT_BUILT[t]); }
    lb: [1024] u8; ln := gt_limits_words(t, ACTORS_MAX, lb[..], 0);
    jo_key(o[..], "limits"); jo_str(o[..], cast(string) lb[0..<ln]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_LIST_FIELDS {
    gb_ok(o[..]); jo_key(o[..], "fields"); jo_arr(o[..]);
    for f: 0..<FIELDS {
      jo_obj(o[..]); jo_key(o[..], "field"); jo_str(o[..], FIELD_NAME[f]); jo_key(o[..], "unit"); jo_str(o[..], FIELD_UNIT[f]);
      we_int(o[..], "min", cast(int) FIELD_MIN[f]); we_int(o[..], "max", cast(int) FIELD_MAX[f]); jo_end(o[..]);
    }
    jo_end(o[..]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_LIST_MODES {
    gb_ok(o[..]); jo_key(o[..], "modes"); jo_arr(o[..]);
    for m: 0..<ed_play_modes() {
      jo_obj(o[..]); we_int(o[..], "mode", cast(int) m); jo_key(o[..], "word"); jo_str(o[..], PLAYTEST_MODE_WORD[m]); b: [64] u8; jo_key(o[..], "name"); jo_str(o[..], cast(string) b[0..<ed_play_mode_name(cast(s32) m, b[..])]); jo_end(o[..]);
    }
    jo_end(o[..]);
    we_int(o[..], "size_most", cast(int) ed_play_size_most());
    return gb_done(o[..], a, false, 0);
  }
  if (v >= VERB_UNDO && v <= VERB_DUPLICATE) || v == VERB_CUT { return gb_run_app(e, v, a, o[..]); }
  if v == VERB_PICTURES { pic_list_answer(e, o[..]); return gb_raw(o[..], ifx o[0].bad then 0 else jo_text(o[..]).count); }
  if v == VERB_PICTURE {
    why := pic_why_none(e, cast(int) a.revision, a.which);
    if why.count > 0 { return gb_refuse(o[..], "not-found", why); }
    if !pic_answer(e, o[..], cast(int) a.revision, a.which) || o[0].bad { return gb_refuse(o[..], "bad-request", "the answer did not fit"); }
    return gb_raw(o[..], jo_text(o[..]).count);
  }
  if v == VERB_CHANGES {
    things: [CH_MARKS] ChThing;
    k := ch_things(e, -1, things[..]);
    gb_ok(o[..]);
    // the summary: each one who changed something, and what
    b: [1024] u8; t := [1] Text.[Text.{buf = b[..]}];
    for i: 0..<k {
      who := gb_change_who(e, things[i].id); seen := false;
      for j: 0..<i { if gb_change_who(e, things[j].id) == who { seen = true; } }
      if seen { continue; }
      mine: [CH_MARKS] ChThing; m := ch_things(e, who, mine[..]);
      if t[0].at > 0 { tx_put(t[..], "; "); }
      ch_line(t[..], who, mine[0..<m]);
    }
    jo_key(o[..], "summary"); jo_str(o[..], ifx k == 0 then "nothing an agent changed is highlighted here" else cast(string) b[0..<t[0].at]);
    jo_key(o[..], "things"); jo_arr(o[..]);
    for i: 0..<k {
      ch_thing_json(o[..], things[i]);
      who := gb_change_who(e, things[i].id);
      wb: [64] u8; wt := [1] Text.[Text.{buf = wb[..]}]; ch_who(wt[..], who);
      jo_key(o[..], "who"); jo_str(o[..], cast(string) wb[0..<wt[0].at]);
      jo_end(o[..]);
    }
    jo_end(o[..]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_SHOW_CHANGES {
    if e[0].play[0].on { return gb_refuse(o[..], "edit-refused", "a match is being played: stop it first"); }
    k := ch_frame(e, -1);
    if k == 0 { return gb_refuse(o[..], "not-found", "nothing an agent changed is highlighted here (changes)"); }
    gb_ok(o[..]); we_int(o[..], "things", k);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_DISMISS_CHANGES {
    gb_ok(o[..]); we_int(o[..], "dismissed", ch_dismiss(e, -1));
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_AGENTS_ACCOUNT {
    e[0].agents_private = !e[0].agents_private;
    gb_ok(o[..]); jo_key(o[..], "on"); jo_bool(o[..], !e[0].agents_private);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_AGENTS_PANE {
    e[0].agents_open = !e[0].agents_open;
    gb_ok(o[..]); jo_key(o[..], "open"); jo_bool(o[..], e[0].agents_open);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_UNDO_TURN {
    r := ed_agent_undo_turn(e, a.agent);
    if r == AGENT_NONE { return gb_refuse(o[..], "edit-refused", "you have no turn to take back"); }
    if r == AGENT_CHANGED { return gb_refuse(o[..], "edit-refused", "the level changed since your turn: the person's edit stands (read-level)"); }
    if r == AGENT_REFUSED { return gb_refuse(o[..], "edit-refused", "not now: a match is being played or the level is being dragged"); }
    gb_ok(o[..]); jo_key(o[..], "already"); jo_bool(o[..], r == AGENT_ALREADY); we_int(o[..], "rev", ed_agent_rev(e));
    return gb_done(o[..], a, r == AGENT_UNDONE, 0);
  }
  if v == VERB_ASK { return gb_refuse(o[..], "bad-request", "only the Agents pane asks the person (agents.coax)"); }
  if v == VERB_ENGINE_READY || v == VERB_ENGINE_MINE { return gb_refuse(o[..], "bad-request", "the surface runs git and gh and answers this row (enf_ready, enf_mine)"); }
  if v == VERB_TRIAGE { return gb_refuse(o[..], "bad-request", "the surface asks the decision door and answers the triage row (tri_body, tri_answer)"); }
  if v == VERB_ENGINE_LIST { return gb_engine_list(o[..]); }
  if v == VERB_ENGINE_READ { return gb_engine_read(o[..], a.text); }
  if v == VERB_CODE_BRIEF || v == VERB_CODE_AGENT {
    repo := agr_index(AGR_REPO_ID[..], a.text);
    if repo < 0 { return gb_refuse(o[..], "bad-request", "a repository is openagents (the engine) or gamebuilder (the app)"); }
    if v == VERB_CODE_BRIEF { return gb_code_brief(o[..], repo); }
    // the pane takes it on its next tick (code-agent.coax): the sheet, never a start
    e[0].agents_open = true; e[0].code_sheet = cast(s32) (repo + 1);
    gb_ok(o[..]); jo_key(o[..], "repo"); jo_str(o[..], AGR_REPO_ID[repo]); jo_key(o[..], "approve"); jo_bool(o[..], true);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_CLAIM {
    wb: [512] u8;
    m := claims_make(e, a.agent, a.who, a.claim, wb[..]);
    if m.error.count > 0 { return gb_refuse(o[..], m.error, m.why); }
    gb_ok(o[..]); we_int(o[..], "level", cast(int) ed_level(e));
    jo_key(o[..], "claim"); claim_json(o[..], e[0].claims[0].c[m.at]);
    jo_key(o[..], "again"); jo_bool(o[..], m.again); we_int(o[..], "seconds", CLAIM_SECONDS);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_CLAIMS {
    s := claims_here(e);
    gb_ok(o[..]); jo_key(o[..], "schema"); jo_str(o[..], "gamebuilder.claims.v1"); we_int(o[..], "level", cast(int) ed_level(e));
    jo_key(o[..], "claims"); jo_arr(o[..]);
    for k: 0..<s[0].n { claim_json(o[..], s[0].c[k]); }
    jo_end(o[..]);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_RELEASE {
    n := claims_end(e, a.agent);
    gb_ok(o[..]); we_int(o[..], "level", cast(int) ed_level(e)); we_int(o[..], "released", n);
    return gb_done(o[..], a, false, 0);
  }
  if v == VERB_PLAY_TEST {
    why := playtest_why(e);
    if why.count > 0 { return gb_refuse(o[..], "bad-request", why); }
    return gb_raw(o[..], ed_play_test(e, a.mode, a.size, a.seconds, a.seed, out));
  }
  return gb_refuse(o[..], "bad-request", "no such command");
}
// Who changed a highlighted thing last (changes.coax).
gb_change_who :: (e: [] Editor, id: s32) -> s32 {
  k := ch_find(e[0].changes[..], id);
  return ifx k >= 0 then e[0].changes[0].marks[k].who else 0;
}
// The app's own rows, on the open level (gb_run checked who may change it).
gb_run_app :: (e: [] Editor, v: int, a: GbArgs, o: [] Jo) -> GbResult {
  if e[0].play[0].on { return gb_refuse(o, "edit-refused", "a match is being played: stop it first"); }
  if v == VERB_UNDO || v == VERB_REDO {
    redo := v == VERB_REDO;
    if !(ifx redo then ed_can_redo(e) else ed_can_undo(e)) { return gb_refuse(o, "edit-refused", ifx redo then "there is nothing to make again" else "there is nothing to take back"); }
    rev := ed_agent_rev(e);
    if redo { ed_redo(e); } else { ed_undo(e); }
    if ed_agent_rev(e) == rev { return gb_refuse(o, "edit-refused", "not in the middle of a drag"); }
    gb_ok(o); we_int(o, "rev", ed_agent_rev(e));
    return gb_done(o, a, true, 0);
  }
  if v == VERB_SET_TOOL {
    ed_set_tool(e, a.tool);
    gb_ok(o); jo_key(o, "tool"); jo_str(o, GB_TOOL_WORD[ed_tool(e)]);
    return gb_done(o, a, false, 0);
  }
  if v == VERB_PASTE {
    if !ed_clip_has(e) { return gb_refuse(o, "edit-refused", "nothing is copied"); }
    id := ed_clip_paste(e);
    if id == 0 { return gb_refuse(o, "edit-refused", "it could not be pasted"); }
    gb_ok(o); we_int(o, "id", cast(int) id); we_int(o, "rev", ed_agent_rev(e));
    return gb_done(o, a, true, 0);
  }
  // focus, copy and duplicate: the thing named, selected
  if ed_index(e, a.thing) < 0 { return gb_refuse(o, "not-found", "the level has no such thing (read-level)"); }
  e[0].selected = a.thing;
  if v == VERB_FOCUS { ed_focus(e); gb_ok(o); we_int(o, "id", cast(int) a.thing); return gb_done(o, a, false, 0); }
  k := ed_actor(e, ed_index(e, a.thing)).kind;
  if k == KIND_START || k == KIND_RIVAL { return gb_refuse(o, "edit-refused", "a level has one start for each team: it can't be copied"); }
  if v == VERB_COPY {
    if !ed_clip_copy(e) { return gb_refuse(o, "edit-refused", "it could not be copied"); }
    gb_ok(o); we_int(o, "id", cast(int) a.thing); return gb_done(o, a, false, 0);
  }
  if v == VERB_CUT {
    if !ed_clip_cut(e) || ed_index(e, a.thing) >= 0 { return gb_refuse(o, "edit-refused", "it could not be cut"); }
    gb_ok(o); we_int(o, "id", cast(int) a.thing); we_int(o, "rev", ed_agent_rev(e)); return gb_done(o, a, true, 0);
  }
  id := ed_clip_duplicate(e);
  if id == 0 { return gb_refuse(o, "edit-refused", "it could not be copied"); }
  gb_ok(o); we_int(o, "id", cast(int) id); we_int(o, "from", cast(int) a.thing); we_int(o, "rev", ed_agent_rev(e));
  return gb_done(o, a, true, 0);
}
gb_world_has :: (w: GbWorld, n: s32) -> bool {
  for k: w.levels { if k == n { return true; } }
  return false;
}
// Level n's revision as the surface read it, or -1 when it didn't.
gb_world_rev :: (w: GbWorld, n: s32) -> int {
  if w.revs.count != w.levels.count { return -1; }
  for i: 0..<w.levels.count { if w.levels[i] == n { return cast(int) w.revs[i]; } }
  return -1;
}
// write-content: level a.level's file put whole. The surface opened the level when it is there
// (w names it); the file must have been read at its revision now, or at 0 when it isn't there.
gb_write_content :: (e: [] Editor, a: GbArgs, w: GbWorld, o: [] Jo) -> GbResult {
  if a.level < 1 { return gb_refuse(o, "not-permitted", "level 0 is Scrappers Arena's own: write your copy's number (copy-level)"); }
  had := gb_world_has(w, a.level);
  if had && !ed_may_edit(e) { return gb_refuse(o, "not-permitted", "this level is not yours to change: make your own copy (copy-level)"); }
  now := ifx had then ed_agent_rev(e) else 0;
  if cast(int) a.revision != now {
    return gb_refuse(o, "stale", ifx had then "the level changed since that revision: read-content gives it as it is now" else "there is no such level yet: send revision 0 to make it");
  }
  doc: [AGENT_FILE_MAX] u8;
  if a.content.count > doc.count { return gb_refuse(o, "limit", "a level's file is at most 262144 bytes (AGENT_FILE_MAX)"); }
  for i: 0..<a.content.count { doc[i] = a.content[i]; }
  if !ed_open(e, a.level, doc[0..<a.content.count]) || ed_level(e) != a.level { return gb_refuse(o, "unreadable", "that is not a level's file (read-content gives one)"); }
  if !ed_may_edit(e) { return gb_refuse(o, "not-permitted", "that file is a game's own level, not yours to write"); }
  gb_ok(o); we_int(o, "level", cast(int) a.level); we_int(o, "revision", ed_agent_rev(e));
  return gb_done(o, a, true, 0);
}
// An answer some export wrote straight into out.
// Your games and levels managed: a level or a game deleted (the surface deletes the file,
// drop_level and drop_game), a level named or moved between games, and who owns a game.
gb_run_manage :: (e: [] Editor, v: int, a: GbArgs, w: GbWorld, o: [] Jo) -> GbResult {
  if v == VERB_DELETE_LEVEL || v == VERB_RENAME_LEVEL || v == VERB_MOVE_LEVEL {
    if a.level < 1 || !gb_world_has(w, a.level) { return gb_refuse(o, "not-found", "you have no such level (list-levels)"); }
    g := mine_of_level(e, a.level);
    gi := mine_find(e, g);
    if v == VERB_DELETE_LEVEL {
      if gi >= 0 && e[0].mine[gi].level_n <= 1 { return gb_refuse(o, "edit-refused", "a game keeps one level at least: delete-game deletes the game"); }
      if !a.dry && gi >= 0 { _ = mine_drop_level(e, g, a.level); }
      // the open level is not written again: the host deletes its file and opens another
      if !a.dry && a.level == e[0].level && !e[0].official { e[0].fresh = false; editor_scene_saved(ed_scene(e)); }
      gb_ok(o); we_int(o, "level", cast(int) a.level);
      r := gb_done(o, a, false, ifx gi >= 0 then g else 0);
      if !a.dry { r.drop_level = a.level; }
      return r;
    }
    if v == VERB_RENAME_LEVEL {
      if gi < 0 { return gb_refuse(o, "edit-refused", "a level is named in its game: put it in one of yours first (move-level)"); }
      if !a.dry { _ = mine_name_level(e, g, a.level, a.text); }
      gb_ok(o); we_int(o, "level", cast(int) a.level); jo_key(o, "name"); jo_str(o, a.text);
      return gb_done(o, a, false, g);
    }
    // move-level
    if a.into == g { return gb_refuse(o, "edit-refused", ifx g == 0 then "that level is in no game already" else "that level is in that game already"); }
    if gi >= 0 && e[0].mine[gi].level_n <= 1 { return gb_refuse(o, "edit-refused", "a game keeps one level at least: delete-game deletes the game"); }
    ti := mine_find(e, a.into);
    if a.into != 0 && ti < 0 { return gb_refuse(o, "not-found", "you have no such game (list-games)"); }
    // a level goes into a game whose type offers every kind of thing it holds (shared/game-types.coax gt_offers): a
    // crates room into a crates game, an empty level into any; its own game's type always offers them
    if ti >= 0 && a.level == e[0].level && !e[0].official {
      into := cast(int) e[0].mine[ti].plays;
      for i: 0..<ed_count(e) {
        kd := cast(int) ed_actor(e, i).kind;
        if gt_offers(into, kd) { continue; }
        wb: [200] u8; wt := [1] Text.[Text.{buf = wb[..]}];
        tx_put(wt[..], "that level holds a "); tx_put(wt[..], GK_SAID[kd]); nm := TEMPLATE_NAME[into]; vowel := nm.count > 0 && (nm[0] == 'a' || nm[0] == 'e' || nm[0] == 'i' || nm[0] == 'o' || nm[0] == 'u' || nm[0] == 'A' || nm[0] == 'E' || nm[0] == 'I' || nm[0] == 'O' || nm[0] == 'U');
        tx_put(wt[..], ifx vowel then ", which an " else ", which a "); tx_put(wt[..], nm);
        tx_put(wt[..], " game has no kind for: a level moves into a game whose type offers every kind of thing it holds");
        return gb_refuse(o, "edit-refused", cast(string) wb[0..<wt[0].at]);
      }
    }
    if ti >= 0 && e[0].mine[ti].level_n >= MINE_LEVELS { return gb_refuse(o, "limit", "a game holds 16 levels (MINE_LEVELS)"); }
    if !a.dry { _ = mine_move_level(e, a.level, a.into); }
    gb_ok(o); we_int(o, "level", cast(int) a.level); we_int(o, "game", cast(int) a.into);
    // both games' files change: the one it left is written here, the one it joined below
    r := gb_done(o, a, false, ifx a.into != 0 then a.into else g);
    if !a.dry && g != 0 && a.into != 0 { r.save_also = g; }
    return r;
  }
  gi := mine_find(e, a.game);
  if gi < 0 { return gb_refuse(o, "not-found", "you have no such game (list-games)"); }
  if v == VERB_DELETE_GAME {
    if !a.dry { _ = mine_drop(e, a.game); }
    gb_ok(o); we_int(o, "game", cast(int) a.game);
    r := gb_done(o, a, false, 0);
    if !a.dry { r.drop_game = a.game; }
    return r;
  }
  if v == VERB_OWNERS {
    gb_ok(o); we_int(o, "game", cast(int) a.game); jo_key(o, "owners"); jo_arr(o);
    for k: 0..<OWNERS_MAX { ob: [ACCOUNT_MAX] u8; n := mine_owner(e[0].mine[gi], k, ob[..]); if n > 0 { jo_str(o, cast(string) ob[0..<n]); } }
    jo_end(o);
    return gb_done(o, a, false, 0);
  }
  // set-owners: the person's own account among them, so no one locks themself out
  me := cast(string) e[0].account[0..<cast(s64) e[0].account_n];
  if me.count == 0 { return gb_refuse(o, "not-logged-in", "owners are accounts: log in first (login)"); }
  if !mine_owners_has(a.owners, me) { return gb_refuse(o, "edit-refused", "your own account is one of the owners, or you could not change the game again"); }
  if !a.dry { _ = mine_set_owners(e, a.game, a.owners); }
  gb_ok(o); we_int(o, "game", cast(int) a.game); jo_key(o, "owners"); jo_str(o, a.owners);
  return gb_done(o, a, false, a.game);
}


// Publishing (publish.coax): every call checks the account itself. On the site's server (GbWorld.games is where
// the links live) a publish is on the web and the answer's link is the whole address; on a device it is kept on
// the device, and the answer says so.
PUB_WHERE :: "kept on this device: publish with --remote, or at gamebuilder.org, and it is on the web";
PUB_WHERE_WEB :: "on the web: anyone with the link plays it, with no account";
PUB_LINK :: 96;
// A game's link: GAMES/g/CODE, or g/CODE on a device.
gb_pub_link :: (o: [] Jo, w: GbWorld, code: [] u8) {
  lb: [PUB_LINK] u8; ln := 0;
  if w.games.count > 0 && w.games.count < PUB_LINK - 16 { for c: w.games { lb[ln] = c; ln += 1; } lb[ln] = '/'; ln += 1; }
  for c: "g/" { lb[ln] = c; ln += 1; } for k: 0..<PUB_CODE { lb[ln] = code[k]; ln += 1; }
  jo_key(o, "link"); jo_str(o, cast(string) lb[0..<ln]);
}
gb_pub_where :: (o: [] Jo, w: GbWorld) { jo_key(o, "where"); jo_str(o, ifx w.games.count > 0 then PUB_WHERE_WEB else PUB_WHERE); }
gb_pub_game :: (o: [] Jo, s: [] PubStore, i: s64, w: GbWorld) {
  g := s[0].games[i];
  jo_obj(o); we_int(o, "published", cast(int) g.id); we_int(o, "level", cast(int) g.level);
  name := g.name; jo_key(o, "name"); jo_str(o, cast(string) name[0..<cast(s64) g.name_n]);
  tp := g.type; if g.type_n > 0 { jo_key(o, "template"); jo_str(o, cast(string) tp[0..<cast(s64) g.type_n]); }
  code := g.code; gb_pub_link(o, w, code[..]);
  we_int(o, "live", cast(int) g.live); we_int(o, "versions", cast(int) g.versions);
  jo_key(o, "on_web"); jo_bool(o, g.state == PUB_LIVE);
  from := g.from; if g.from_n == PUB_CODE { jo_key(o, "from"); jo_str(o, cast(string) from[0..<PUB_CODE]); }
  // its counts, where they are kept: the account's server (a game never counted there reads as nothing yet)
  if w.games.count > 0 {
    p: [1] Plays; _ = py_list_get(w.plays, cast(string) code[0..<PUB_CODE], p[..]);
    jo_key(o, "plays"); jo_obj(o);
    for f: 0..<PY_N { we_int(o, PY_ROWS[f].name, p[0].n[f]); }
    jo_end(o);
  }
  jo_end(o);
}
gb_pub_refused :: (o: [] Jo, d: PubDone) -> GbResult { return gb_refuse(o, d.error, d.why); }
gb_run_publish :: (e: [] Editor, v: int, a: GbArgs, w: GbWorld, o: [] Jo) -> GbResult {
  me := cast(string) e[0].account[0..<cast(s64) e[0].account_n];
  s := e[0].pub[..];
  if me.count == 0 { return gb_refuse(o, "not-logged-in", "publishing needs your account: log in first (login)"); }
  if v == VERB_PUB_PUBLISHED {
    gb_ok(o); jo_key(o, "published"); jo_arr(o);
    for i: 0..<cast(s64) s[0].game_n { if pub_mine(s, me, s[0].games[i].id) >= 0 { gb_pub_game(o, s, i, w); } }
    jo_end(o); gb_pub_where(o, w);
    return gb_done(o, a, false, 0);
  }
  if v == VERB_PUB_PUBLISH {
    if a.level < 1 || !gb_world_has(w, a.level) { return gb_refuse(o, "not-found", "you have no such level (list-levels)"); }
    doc: [GB_DOC_MAX] u8; n := ed_save(e, doc[..]);
    if n <= 0 { return gb_refuse(o, "bad-request", "the level's file did not fit"); }
    // the level's game type goes with it: the link's page plays it as that type (a level no game holds is an arena)
    mg := mine_of_level(e, a.level);
    tpl := TEMPLATE_ID[ifx mg > 0 && ed_mine_template(e, mg) >= 0 then ed_mine_template(e, mg) else TEMPLATE_ARENA];
    d := pub_publish_from(s, me, a.level, a.text, tpl, a.from, doc[0..<n], w.now, a.dry);
    if d.error.count > 0 { return gb_pub_refused(o, d); }
    gb_ok(o); we_int(o, "published", cast(int) d.game); we_int(o, "version", cast(int) d.version);
    if !a.dry { i := pub_find(s, d.game); code := s[0].games[i].code; gb_pub_link(o, w, code[..]); }
    // the game it was remixed from, as kept (said once, at its first publish)
    fb: [PUB_CODE] u8; from := ifx a.dry then "" else pub_from(s, d.game, fb[..]);
    if from.count > 0 { jo_key(o, "from"); jo_str(o, from); }
    gb_pub_where(o, w);
    r := gb_done(o, a, false, 0);
    // the surface keeps the version's file beside the store (cli/main.coax: the link plays those bytes)
    if !a.dry { r.published = d.game; r.version = d.version; }
    return r;
  }
  if v == VERB_PUB_FEEDBACK_HIDE || v == VERB_PUB_BLOCK || v == VERB_PUB_REPORT {
    act := ifx v == VERB_PUB_FEEDBACK_HIDE then PUB_HIDE else ifx v == VERB_PUB_BLOCK then PUB_BLOCK else PUB_REPORT;
    d := pub_act(s, me, a.item, act, a.dry);
    if d.error.count > 0 { return gb_pub_refused(o, d); }
    gb_ok(o); we_int(o, "feedback", cast(int) a.item);
    return gb_done(o, a, false, 0);
  }
  i := pub_mine(s, me, a.pub);
  if i < 0 { return gb_refuse(o, "not-found", "you have no such published game (published)"); }
  if v == VERB_PUB_VERSIONS {
    gb_ok(o); we_int(o, "published", cast(int) a.pub); jo_key(o, "versions"); jo_arr(o);
    hex := "0123456789abcdef";
    for k: 0..<cast(s64) s[0].version_n {
      x := s[0].versions[k];
      if x.game != a.pub { continue; }
      jo_obj(o); we_int(o, "version", cast(int) x.n); jo_key(o, "at"); jo_int(o, x.at); we_int(o, "size", cast(int) x.size);
      hb: [64] u8; for j: 0..<32 { hb[j * 2] = hex[cast(s64) (x.hash[j] >> 4)]; hb[j * 2 + 1] = hex[cast(s64) (x.hash[j] & 15)]; }
      jo_key(o, "sha256"); jo_str(o, cast(string) hb[0..<64]); jo_key(o, "live"); jo_bool(o, x.n == s[0].games[i].live); jo_end(o);
    }
    jo_end(o);
    return gb_done(o, a, false, 0);
  }
  if v == VERB_PUB_FEEDBACK {
    gb_ok(o); we_int(o, "published", cast(int) a.pub); jo_key(o, "feedback"); jo_arr(o);
    k := cast(s64) s[0].feedback_n - 1;
    while k >= 0 {
      f := s[0].feedback[k]; k -= 1;
      if f.game != a.pub { continue; }
      jo_obj(o); we_int(o, "feedback", cast(int) f.id); we_int(o, "version", cast(int) f.version);
      jo_key(o, "thumb"); jo_str(o, ifx f.up then "up" else "down");
      jo_key(o, "state"); jo_str(o, ifx f.state == PUB_HIDDEN then "hidden" else ifx f.state == PUB_HELD then "held" else "new");
      text := f.text; if f.state == PUB_NEW { jo_key(o, "text"); jo_str(o, cast(string) text[0..<cast(s64) f.text_n]); }
      jo_key(o, "reported"); jo_bool(o, f.reported); jo_end(o);
    }
    jo_end(o);
    return gb_done(o, a, false, 0);
  }
  d := ifx v == VERB_PUB_SET_LIVE then pub_set_live(s, me, a.pub, a.version, a.dry) else ifx v == VERB_PUB_UNPUBLISH then pub_unpublish(s, me, a.pub, a.dry) else pub_remove(s, me, a.pub, a.dry);
  if d.error.count > 0 { return gb_pub_refused(o, d); }
  gb_ok(o); we_int(o, "published", cast(int) a.pub);
  if v == VERB_PUB_SET_LIVE { we_int(o, "live", cast(int) a.version); }
  return gb_done(o, a, false, 0);
}

// The screen's own rows: a level or a shipped game opened (the core says which; the host reads the
// file and opens it, ed_open_due), and a match played on it.
gb_run_play :: (e: [] Editor, v: int, a: GbArgs, w: GbWorld, o: [] Jo) -> GbResult {
  p := e[0].play[..];
  if v == VERB_LIST_SCRAPPERS {
    gb_ok(o); jo_key(o, "scrappers"); jo_arr(o);
    for k: 0..<ed_play_classes() {
      b: [64] u8; jo_obj(o); we_int(o, "scrapper", cast(int) k);
      jo_key(o, "name"); jo_str(o, cast(string) b[0..<ed_play_class_name(cast(s32) k, b[..])]); jo_end(o);
    }
    jo_end(o);
    return gb_done(o, a, false, 0);
  }
  if v == VERB_PLAY_STATE {
    gb_ok(o); jo_key(o, "playing"); jo_bool(o, ed_playing(e));
    jo_key(o, "mode"); jo_str(o, PLAYTEST_MODE_WORD[ed_play_mode(e)]);
    we_int(o, "size", cast(int) ed_play_size(e)); we_int(o, "slot", cast(int) ed_bag_selected(e));
    return gb_done(o, a, false, 0);
  }
  if v == VERB_OPEN_LEVEL || v == VERB_OPEN_GAME {
    if p[0].on { return gb_refuse(o, "edit-refused", "a match is being played: stop it first"); }
    if v == VERB_OPEN_LEVEL && !gb_world_has(w, a.level) { return gb_refuse(o, "not-found", "there is no such level here (list-levels)"); }
    if v == VERB_OPEN_LEVEL { e[0].open_due = a.level + 1; } else { e[0].open_game_due = a.pick + 1; }
    gb_ok(o); we_int(o, ifx v == VERB_OPEN_LEVEL then "level" else "game", cast(int) (ifx v == VERB_OPEN_LEVEL then a.level else a.pick));
    return gb_done(o, a, false, 0);
  }
  if v == VERB_PLAY {
    if p[0].on { return gb_refuse(o, "edit-refused", "a match is being played already: stop it first"); }
    if e[0].plays >= 0 && e[0].plays < GT_TYPES && !GT_PLAYS_IN_APP[e[0].plays] { return gb_refuse(o, "edit-refused", ed_play_why(e[0].plays)); }
    if ed_play_needs_page(e) { return gb_refuse(o, "edit-refused", PLAY_NO_PAGE); }
    _ = ed_play_setup(e, a.mode, a.size);
    ed_play(e, a.pick);
    if !ed_playing(e) { return gb_refuse(o, "edit-refused", "the match could not start in this level"); }
    gb_ok(o); we_int(o, "scrapper", cast(int) a.pick); jo_key(o, "mode"); jo_str(o, PLAYTEST_MODE_WORD[a.mode]); we_int(o, "size", cast(int) a.size);
    return gb_done(o, a, false, 0);
  }
  if !p[0].on { return gb_refuse(o, "edit-refused", "no match is being played: play first"); }
  if v == VERB_STOP { ed_stop(e); }
  else if v == VERB_TRAVEL {
    if !p[0].real || !e[0].farm[0].ok { return gb_refuse(o, "edit-refused", "travel is SPLICEBOTS' farm's, while you play it"); }
    ed_farm_travel(e);
  } else if v == VERB_DIGGER {
    if !p[0].real || !e[0].scene[0].digger { return gb_refuse(o, "edit-refused", "the digger is SPLICEBOTS', while you play it with one"); }
    ed_digger_toggle(e);
  } else if v == VERB_BAG_SELECT {
    if !p[0].real { return gb_refuse(o, "edit-refused", "the bag is SPLICEBOTS', while you play it"); }
    ed_bag_select(e, a.pick);
  }
  gb_ok(o);
  return gb_done(o, a, false, 0);
}

gb_raw :: (o: [] Jo, n: s64) -> GbResult {
  if n <= 0 { return gb_refuse(o, "bad-request", "the answer did not fit"); }
  return GbResult.{code = GB_DONE, json = cast(string) o[0].buf[0..<n]};
}

// ---- what the surfaces are made from

// The capability manifest: every row, as `gamebuilder commands --json` prints it.
// It says which build it is: the version (gb_version) and the table's digest on its own, which
// `gamebuilder version --remote` compares with the hosted server's.
gb_manifest :: (out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  vb: [96] u8; hb: [8] u8;
  jo_obj(o[..]); jo_key(o[..], "schema"); jo_str(o[..], "gamebuilder.commands.v1");
  jo_key(o[..], "version"); jo_str(o[..], gb_version(vb[..]));
  jo_key(o[..], "table"); jo_str(o[..], gb_hex8(gb_table_digest(), hb[..]));
  jo_key(o[..], "commands"); jo_arr(o[..]);
  for c: GB_COMMANDS {
    jo_obj(o[..]);
    jo_key(o[..], "verb"); jo_str(o[..], c.verb); jo_key(o[..], "area"); jo_str(o[..], c.area);
    jo_key(o[..], "effect"); jo_str(o[..], c.effect); jo_key(o[..], "approval"); jo_str(o[..], c.approval);
    jo_key(o[..], "arguments"); jo_arr(o[..]); for k: 0..<gb_parts(c.arguments) { jo_str(o[..], gb_part(c.arguments, k)); } jo_end(o[..]);
    jo_key(o[..], "flags"); jo_arr(o[..]); for k: 0..<gb_parts(c.flags) { jo_str(o[..], gb_part(c.flags, k)); } jo_end(o[..]);
    jo_key(o[..], "result"); jo_str(o[..], c.result); jo_key(o[..], "limit"); jo_str(o[..], c.limit);
    jo_key(o[..], "impl"); jo_str(o[..], c.impl);
    jo_key(o[..], "surfaces"); jo_arr(o[..]);
    for s: 0..<GB_SURFACES { if (c.surfaces & cast(s32) (1 << s)) != 0 { jo_str(o[..], GB_SURFACE_NAME[s]); } }
    jo_end(o[..]);
    jo_key(o[..], "gap"); jo_arr(o[..]); for k: 0..<gb_parts(c.gap) { jo_str(o[..], gb_part(c.gap, k)); } jo_end(o[..]);
    jo_key(o[..], "usage"); jo_str(o[..], c.usage); jo_key(o[..], "help"); jo_str(o[..], c.help);
    jo_end(o[..]);
  }
  jo_end(o[..]); jo_end(o[..]);
  return ifx o[0].bad then "" else jo_text(o[..]);
}

// A batch with the spaces, tabs and line breaks between its parts dropped (never inside a string).
gb_tidy :: (text: string, out: [] u8) -> string {
  n := 0; quoted := false; escaped := false;
  for c: text {
    if quoted {
      if escaped { escaped = false; } else if c == '\\' { escaped = true; } else if c == '"' { quoted = false; }
    } else {
      if c == ' ' || c == '\t' || c == '\n' || c == '\r' { continue; }
      if c == '"' { quoted = true; }
    }
    if n >= out.count { return text; }
    out[n] = c; n += 1;
  }
  return cast(string) out[0..<n];
}
// A batch read the engine's way and written as the wire writes it, fields it doesn't know left
// out; "" when it doesn't read as a batch at all.
gb_wire :: (text: string, out: [] u8) -> string {
  if text.count == 0 || text.count > WE_BATCH_BODY { return ""; }
  nodes: [WE_BATCH * WE_NODES + 16] JvNode; da: [1] Jv;
  if !jv_parse(da[..], text, nodes[..]) { return ""; }
  d := da[0];
  wb: [WE_NAME + 1] u8;
  if !jv_raw_eq(jv_raw(d, jv_get(d, 0, "schema")), WE_SCHEMA) { return ""; }
  rev := jv_int(d, jv_get(d, 0, "rev"), -1);
  words := WE_DO;
  what := we_index(words[..], we_word(d, jv_get(d, 0, "do"), wb[..]));
  list := jv_get(d, 0, "edits");
  if jv_kind(d, list) != JV_ARRAY || jv_len(d, list) > WE_BATCH { return ""; }
  edits: [WE_BATCH] WorldEdit;
  n := jv_len(d, list);
  // each edit read for what it says (we_from also holds it to its exact form, which is what is asked here)
  for i: 0..<n { edits[i] = we_from(d, jv_at(d, list, i)); if edits[i].op == 0 { return ""; } edits[i].ok = true; }
  return we_batch_write(rev, what, edits[..], n, out);
}

// ---- the engine, and changing it

// The engine is open source at OpenAgentsInc/openagents; GameBuilder builds
// against one commit of it (openagents.lock, AGENTS.md "Dependencies"). What
// a world needs that the engine can't do is proposed there as a pull request.
GB_ENGINE_REPO :: "OpenAgentsInc/openagents";
GB_ENGINE_PARTS :: 6;
GB_ENGINE_PATH :: [GB_ENGINE_PARTS] string.["metaverse-engine/render/", "metaverse-engine/physics/", "metaverse-engine/move/ and metaverse-engine/cam/",
  "metaverse-engine/world/, content/ and editor/", "metaverse-engine/fx/ and gpu/", "coax/"];
GB_ENGINE_WHAT :: [GB_ENGINE_PARTS] string.["how a world is drawn: light, shadows, materials, sky, water, grass", "rigid bodies, collision and queries",
  "walking, jumping and the cameras", "the world, its content tables and the world.edit.v1 wire", "effects and the GPU passes", "the Coax compiler and its libraries"];
GB_ENGINE_STEPS :: 7;
GB_ENGINE_STEP :: [GB_ENGINE_STEPS] string.[
  "Be sure it is the engine's to do, and that the engine can't do it already. What is in a level is the gamebuilder commands'. Which kinds of thing there are, templates and game rules are GameBuilder's own code. How things look (water that ripples, light, materials), move and collide, and the world formats, are the engine's: `gamebuilder engine-list` and `gamebuilder engine-read N` say what it does now, and its source at the commit `gamebuilder engine` names is the last word.",
  "Tell the person what the engine can't do yet, what you would change, and why; ask before you open a pull request in their name.",
  "Run `gamebuilder engine-ready`: it says what this computer is missing, each with its fix, and whether your branch goes to the repository or to your own fork. Clone github.com/OpenAgentsInc/openagents and branch from main. Without push access, which is the usual case, `gh repo fork OpenAgentsInc/openagents --remote --remote-name fork` in the clone makes your fork on GitHub the first time and adds it as the remote `fork`.",
  "Read its AGENTS.md. Add the feature as an engine primitive: its own module, its own #test checks and a section in the engine's docs, usable by any world, never only by GameBuilder.",
  "Run the checks its AGENTS.md names, and fix what they find.",
  "Push the branch (`git push fork BRANCH` to your fork, or to the repository if you may) and open the pull request with `gh pr create --repo OpenAgentsInc/openagents`, saying what a GameBuilder world needs it for. Give the person its link.",
  "Once it is merged, GameBuilder moves to that engine commit (scripts/pin.sh bump in the GameBuilder repo) and the feature can be used. `gamebuilder engine-mine` lists your pull requests and says whether GameBuilder has each merged one yet."];

// The code-brief row's answer (gamebuilder.code.v1): what a Code agent on repo is given and may do,
// in the words the pane's approval says them (agent-record.coax).
gb_code_brief :: (o: [] Jo, repo: int) -> GbResult {
  gb_ok(o); jo_key(o, "schema"); jo_str(o, "gamebuilder.code.v1");
  jo_key(o, "repo"); jo_str(o, AGR_REPO_ID[repo]);
  jo_key(o, "github"); jo_str(o, AGR_REPO_GITHUB[repo]);
  jo_key(o, "is"); jo_str(o, AGR_REPO_WORDS[repo]);
  jo_key(o, "from"); jo_str(o, "origin/main");
  jo_key(o, "rules"); jo_str(o, "AGENTS.md");
  jo_key(o, "ends"); jo_str(o, AGR_REPO_ENDS[repo]);
  jo_key(o, "then"); jo_str(o, AGR_REPO_THEN[repo]);
  jo_key(o, "limits"); jo_obj(o); jo_key(o, "turns"); jo_int(o, AGR_CODE_TURNS); jo_key(o, "cents"); jo_int(o, AGR_CODE_CENTS); jo_end(o);
  jo_key(o, "approval"); jo_str(o, "confirm");
  jo_key(o, "words"); jo_arr(o);
  jo_str(o, AGR_CODE_MAY); jo_str(o, AGR_CODE_WHERE); jo_str(o, AGR_REPO_ENDS_WORDS[repo]);
  if AGR_REPO_THEN_WORDS[repo].count > 0 { jo_str(o, AGR_REPO_THEN_WORDS[repo]); }
  jo_str(o, AGR_CODE_PLAN);
  jo_end(o);
  jo_end(o);
  if o[0].bad { return GbResult.{code = GB_REFUSED, json = ""}; }
  return GbResult.{code = GB_DONE, json = jo_text(o)};
}

// A chapter's status in words, as the engine's book says it.
ENG_STATUS :: [3] string.["implemented", "partly implemented", "design draft"];
// The row with chapter number n: its index in ENG_ROWS, or -1.
eng_find :: (n: s64) -> int { for i: 0..<ENG_N { if cast(s64) ENG_ROWS[i].number == n { return i; } } return -1; }
// A chapter's line: what engine-list gives of each and engine-read starts with.
gb_engine_row :: (o: [] Jo, r: EngRow) {
  jo_key(o, "chapter"); jo_int(o, cast(s64) r.number); jo_key(o, "title"); jo_str(o, r.title);
  jo_key(o, "status"); jo_str(o, ENG_STATUS[r.status]); jo_key(o, "part"); jo_str(o, r.part);
  jo_key(o, "folder"); jo_str(o, r.folder);
}
// The engine-list row's answer (gamebuilder.engine.list.v1): every chapter in a line, with how many are of each status.
gb_engine_list :: (o: [] Jo) -> GbResult {
  counts: [3] s64;
  for r: ENG_ROWS { counts[r.status] += 1; }
  gb_ok(o); jo_key(o, "schema"); jo_str(o, "gamebuilder.engine.list.v1");
  jo_key(o, "repo"); jo_str(o, GB_ENGINE_REPO); jo_key(o, "commit"); jo_str(o, ENG_PIN);
  jo_key(o, "from"); jo_str(o, "metaverse-engine/book");
  jo_key(o, "implemented"); jo_int(o, counts[ENG_IMPLEMENTED]); jo_key(o, "partly"); jo_int(o, counts[ENG_PARTLY]); jo_key(o, "drafts"); jo_int(o, counts[ENG_DRAFT]);
  jo_key(o, "limit"); jo_str(o, "The list is the engine's book at this commit. What the engine does with no chapter is not in it: read the source before you call something missing.");
  jo_key(o, "chapters"); jo_arr(o);
  for r: ENG_ROWS { jo_obj(o); gb_engine_row(o, r); jo_end(o); }
  jo_end(o);
  jo_end(o);
  if o[0].bad { return GbResult.{code = GB_REFUSED, json = ""}; }
  return GbResult.{code = GB_DONE, json = jo_text(o)};
}
// The engine-read row's answer (gamebuilder.engine.chapter.v1): one chapter, by its number as text.
gb_engine_read :: (o: [] Jo, which: string) -> GbResult {
  n := gb_int(which);
  i := ifx n.ok then eng_find(n.v) else -1;
  if i < 0 { return gb_refuse(o, "bad-request", "a chapter is its number in engine-list"); }
  r := ENG_ROWS[i];
  gb_ok(o); jo_key(o, "schema"); jo_str(o, "gamebuilder.engine.chapter.v1");
  gb_engine_row(o, r);
  jo_key(o, "summary"); jo_str(o, r.summary);
  jo_key(o, "source"); jo_arr(o);
  k := 0; while gb_part(r.source, k).count > 0 { jo_str(o, gb_part(r.source, k)); k += 1; }
  jo_end(o);
  b: [200] u8; t := [1] Text.[Text.{buf = b[..]}];
  tx_put(t[..], "https://github.com/"); tx_put(t[..], GB_ENGINE_REPO); tx_put(t[..], "/tree/"); tx_put(t[..], ENG_PIN); tx_put(t[..], "/metaverse-engine/book");
  jo_key(o, "book"); jo_str(o, cast(string) b[0..<t[0].at]);
  jo_key(o, "means"); jo_str(o, ifx r.status == ENG_IMPLEMENTED then "The engine does this. If a world can't use it, the change is GameBuilder's own code."
    else ifx r.status == ENG_PARTLY then "The engine does part of this. Read the chapter and its source to see whether your case is covered before you propose a change."
    else "The engine does not do this yet: the chapter is a design. Building it is an engine upgrade (gamebuilder engine).");
  jo_end(o);
  if o[0].bad { return GbResult.{code = GB_REFUSED, json = ""}; }
  return GbResult.{code = GB_DONE, json = jo_text(o)};
}

// The engine row's answer: the commit this surface was built on, what the engine holds, and the steps.
gb_engine :: (o: [] Jo, pin: string) -> GbResult {
  gb_ok(o); jo_key(o, "engine"); jo_str(o, "OpenAgents Metaverse Engine");
  jo_key(o, "repo"); jo_str(o, GB_ENGINE_REPO); jo_key(o, "commit"); jo_str(o, pin);
  b: [200] u8; t := [1] Text.[Text.{buf = b[..]}];
  tx_put(t[..], "https://github.com/"); tx_put(t[..], GB_ENGINE_REPO); tx_put(t[..], "/tree/"); tx_put(t[..], pin);
  jo_key(o, "source"); jo_str(o, cast(string) b[0..<t[0].at]);
  jo_key(o, "parts"); jo_arr(o);
  for i: 0..<GB_ENGINE_PARTS { jo_obj(o); jo_key(o, "path"); jo_str(o, GB_ENGINE_PATH[i]); jo_key(o, "what"); jo_str(o, GB_ENGINE_WHAT[i]); jo_end(o); }
  jo_end(o);
  jo_key(o, "upgrade"); jo_arr(o); for i: 0..<GB_ENGINE_STEPS { jo_str(o, GB_ENGINE_STEP[i]); } jo_end(o);
  jo_end(o);
  if o[0].bad { return GbResult.{code = GB_REFUSED, json = ""}; }
  return GbResult.{code = GB_DONE, json = jo_text(o)};
}

// ---- the Claude skill (`gamebuilder skill`), made from the table

GB_SKILL_MAX :: 32768;
// The batch's form and rules, as the skill and the Agents pane's brief say them.
gb_batch_text :: (t: [] Text) {
  tx_put(t, "```json\n{\"schema\":\"world.edit.v1\",\"rev\":REV,\"do\":\"apply\",\"edits\":[\n  {\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":500,\"y\":0,\"z\":-300,\"yaw\":0,\"scale\":100},\n  {\"op\":\"move\",\"id\":12,\"x\":0,\"y\":0,\"z\":800},\n  {\"op\":\"rotate\",\"id\":12,\"yaw\":45},\n  {\"op\":\"scale\",\"id\":12,\"scale\":150},\n  {\"op\":\"despawn\",\"id\":7}]}\n```\n\n");
  tx_put(t, "- Write each edit's fields in exactly the order shown, and no others. Spaces and line breaks between them are fine. If a batch comes back `unreadable` with a `wire` field, that is your batch written the way the wire wants it: check nothing of yours was left out, then send that.\n");
  tx_put(t, "- `rev` is the `rev` you read. If the level changed since, the batch is refused as `stale`: read it again and plan again. Adding a shape row that nothing stands on doesn't change `rev`.\n");
  tx_put(t, "- A spawn's `id` is 0: the level numbers it. Its `kind` is a row of the shape table, the `content` you read, as `ID|KIND|WIDTH|HEIGHT|DEPTH` in centimetres. `scale` is 100 for the row's own size.\n");
  tx_put(t, "- A new size is a new row. Add it in the same batch, before the spawn that names it, as the table's next row N: `{\"op\":\"cell\",\"table\":\"shape\",\"row\":N,\"col\":\"*\",\"v\":\"N|block|400|50|200\"}`. `col` `*` means the whole row, and N is written twice, as `row` and at the start of `v`. Rows are only ever added; when a row already has the size you want, name it.\n");
  // (a moving platform's and a lift's way: the table's two columns more, shared/kinds.coax's limits)
  tx_put(t, "- A level with a moving platform or a lift in it (the platformer's `mover` and `lift`) has two columns more in its shape table, `ID|KIND|WIDTH|HEIGHT|DEPTH|GO|EVERY`: how far a row's things go, 0 to "); tx_int(t, GK_GO_MOST); tx_put(t, " cm (a mover along z, a lift up), and how long there and back takes, "); tx_int(t, GK_EVERY_LEAST); tx_put(t, " to "); tx_int(t, GK_EVERY_MOST);
  tx_put(t, " ms; both are 0 for every other kind. A new row for one may end with them, `N|mover|320|90|400|1200|4500`; left out, it goes as a new one does (a mover "); tx_int(t, GK_GO_NEW); tx_put(t, " cm, a lift "); tx_int(t, GK_LIFT_NEW); tx_put(t, " cm, every "); tx_int(t, GK_EVERY_NEW);
  tx_put(t, " ms). To change how one goes in a batch, take it out and spawn it again on a row with the new numbers.\n");
  tx_put(t, "- The answer's `ids` has one number for each edit, in order: a spawn's new thing, the thing a move, turn, size or removal changed, and a new row's number for a `cell`. A dry run answers the same, with `dry_run` true.\n\n");
}
gb_skill :: (out: [] u8) -> string {
  t := [1] Text.[Text.{buf = out}];
  tx_put(t[..], "---\nname: gamebuilder\ndescription: Build and change GameBuilder game worlds with the gamebuilder command line: make games and levels, read a level, add, move, turn, resize and remove things, and carry out world.edit.v1 batches as one step the person can undo. Use when asked to build, lay out, edit or fix a GameBuilder level or game. Also use when a world needs something the OpenAgents Metaverse Engine can't do yet: it says how to propose that engine change as a pull request at OpenAgentsInc/openagents.\n---\n\n");
  tx_put(t[..], "# GameBuilder worlds with the gamebuilder CLI\n\n");
  tx_put(t[..], "Run `gamebuilder VERB ...` (or `gb`). Commands answer JSON. A refusal is `{\"ok\":false,\"error\":CODE,\"why\":WORDS}`, where the words name the limit that refused it, with its number. Exit codes: 0 done (or a dry run), 1 refused, 3 no such command. `gamebuilder help` lists the commands; `gamebuilder commands` is the same list as JSON. `--dir DIR` (or `GAMEBUILDER_DIR`) works on the level and game files in another folder.\n\n");
  tx_put(t[..], "If the gamebuilder MCP tools (`gb_read_level`, `gb_apply_edits`, ...) are connected, they are these same commands, named `gb_` and the verb with `_` for `-`: use whichever you have. A person connects them with `claude mcp add gamebuilder -- gamebuilder mcp`.\n\n");
  tx_put(t[..], "## Before you start\n\n");
  tx_put(t[..], "- `gamebuilder version` checks that it is installed. It is installed from the GameBuilder repo with `scripts/install-cli.sh`.\n");
  tx_put(t[..], "- `gamebuilder whoami` says which account you act as. If nobody is logged in, ask the person to run `gamebuilder login` themselves: it opens gamebuilder.org/login/cli, they log in there and paste the code the page shows. Never log in for them, and never ask them for the code.\n");
  tx_put(t[..], "- It changes the level and game files the GameBuilder app keeps on this computer. Ask the person to close a level in the app before you change it, or the app's next save writes over your change.\n\n");
  tx_put(t[..], "## Opening a game or level in the app\n\n");
  tx_put(t[..], "`gamebuilder --attach open-level LEVEL` opens a level on the screen of the GameBuilder app that is open on this computer. To open one of the person's games, open its first level: `list-games` gives each game's `levels`. It answers `{\"ok\":true,\"level\":LEVEL}`.\n\n");
  tx_put(t[..], "- If it answers that GameBuilder isn't open, the app is not running: ask the person to open it, then send the command again.\n");
  tx_put(t[..], "- `open-game` is only for the games the app ships (0 Scrappers Arena, 1 SPLICEBOTS). A game of the person's opens with `open-level`.\n");
  tx_put(t[..], "- No command opens a level in a browser at gamebuilder.org. A published game has a link in a browser: `published` lists each one's.\n\n");
  tx_put(t[..], "## Editing a world\n\n");
  tx_put(t[..], "1. Find the level with `list-games` and `list-levels`, or make one: `new-game TEMPLATE` (see `list-templates`) or `new-level`. A new game's first level is a starter place with things already in it. They are the person's: move or remove the ones in your way, and say which.\n");
  tx_put(t[..], "2. Read it: `read-level LEVEL`. `rev` is the revision you read. `things` is every thing in it: its `id`, its `kind` (a row of the shape table) and `is` (that kind's name), where it stands (`x`, `y`, `z`), its turn (`yaw`) and its size (`scale`). `content` is the level's shape table. `locked` true means the level isn't yours to change.\n");
  tx_put(t[..], "3. If it is locked, `copy-level LEVEL` makes your own copy, and you change that. Level 0 is Scrappers Arena's own level.\n");
  tx_put(t[..], "4. Plan the whole change, then send it as one batch: write it to a file, run `apply-edits LEVEL batch.json --dry-run`, and when that answers ok, run it again without `--dry-run`. The batch lands as one step the person can undo, or none of it does.\n");
  tx_put(t[..], "5. Read the level again and check that it is what you meant. For one small change, `add`, `set-field` and `delete` are simpler than a batch.\n\n");
  tx_put(t[..], "A change can carry `--key K`, a name of your own for that one call (1 to 64 of letters, digits, -, _ and .). The first result sent with it is kept with the folder, and the same call sent again with the same key answers that result again and changes nothing: use it when you may have to retry a call and don't know whether the first one landed.\n\n");
  tx_put(t[..], "Units: centimetres, with y up and the level's middle at x 0, z 0; z is north. A thing's x and z are the middle of its base, and y is how high its base is (a thing may float). Turns are whole degrees from -180 to 180.\n\n");
  tx_put(t[..], "A thing's size is its shape row (width, height and depth, in centimetres) times its `scale`, a percent of all three sides alike. `set-field LEVEL THING width CM` (or `height`, `depth`) gives one thing one new side, and the level adds the shape row for it. Nothing checks that things overlap: read the level back and look.\n\n");
  tx_put(t[..], "## The batch: world.edit.v1\n\n");
  gb_batch_text(t[..]);
  tx_put(t[..], "## Limits\n\n");
  tx_put(t[..], "- "); tx_int(t[..], WE_BATCH); tx_put(t[..], " edits a batch.\n");
  tx_put(t[..], "- In a batch, and with `add --x --z`, a thing stands within "); tx_int(t[..], AGENT_REACH); tx_put(t[..], " cm of the middle on x and z, and 0 to "); tx_int(t[..], AGENT_REACH); tx_put(t[..], " cm up. `set-field` takes the wider ranges `list-fields` gives.\n");
  tx_put(t[..], "- `scale` is "); tx_int(t[..], cast(s64) FIELD_MIN[FIELD_SCALE]); tx_put(t[..], " to "); tx_int(t[..], cast(s64) FIELD_MAX[FIELD_SCALE]); tx_put(t[..], " percent.\n");
  tx_put(t[..], "- A new shape's sides are "); tx_int(t[..], AGENT_SIZE_MIN); tx_put(t[..], " to "); tx_int(t[..], AGENT_SIZE_MAX); tx_put(t[..], " cm; a level holds "); tx_int(t[..], SHAPES_MAX); tx_put(t[..], " shapes at most.\n");
  tx_put(t[..], "- A level has one start for each team. You can move them, but not add or remove them.\n");
  tx_put(t[..], "- A level holds the kinds of thing its game type allows: `list-palette LEVEL` names them, says what the type is and how building goes in it, and gives its limits (how far, how high, how big, how many) in words with their numbers. An edit past a limit is refused with those words. A thing's fields and their ranges: `list-fields`.\n");
  tx_put(t[..], "- A moving platform or a lift goes 0 to "); tx_int(t[..], GK_GO_MOST); tx_put(t[..], " cm, there and back in "); tx_int(t[..], GK_EVERY_LEAST); tx_put(t[..], " to "); tx_int(t[..], GK_EVERY_MOST);
  tx_put(t[..], " ms: `set-field LEVEL THING distance CM` and `set-field LEVEL THING period MS`. No other thing has a distance or a period.\n");
  tx_put(t[..], "- Levels are numbered 1 to "); tx_int(t[..], LEVEL_MAX); tx_put(t[..], "; you can have "); tx_int(t[..], MINE_MAX); tx_put(t[..], " games.\n\n");
  tx_put(t[..], "## Commands\n\n");
  for c: GB_COMMANDS {
    if (c.surfaces & GB_SKILL) == 0 { continue; }
    tx_put(t[..], "- `gamebuilder "); tx_put(t[..], c.verb);
    if c.usage.count > 0 { tx_put(t[..], " "); tx_put(t[..], c.usage); }
    tx_put(t[..], "`: "); tx_put(t[..], c.help); tx_put(t[..], " ("); tx_put(t[..], c.effect);
    for k: 0..<GB_APPROVALS.count { if GB_APPROVALS[k] == c.approval && GB_APPROVAL_WORDS[k].count > 0 { tx_put(t[..], "; "); tx_put(t[..], GB_APPROVAL_WORDS[k]); } }
    tx_put(t[..], ")\n");
  }
  tx_put(t[..], "\n## When the world needs more than the commands\n\n");
  tx_put(t[..], "Ask first. Before you tell a person something can't be done, run:\n\n```sh\ngamebuilder triage \"what the person asked for, in their words\"\n```\n\n");
  tx_put(t[..], "It answers a `fit`. Do what the fit says:\n\n");
  tx_put(t[..], "- `commands`: the commands above do it. Run the one it names in `command`, then the rest. Don't ask the person anything.\n");
  tx_put(t[..], "- `gamebuilder`: it needs GameBuilder's own code: a new kind of thing, a template, a game rule or the editor itself. That code isn't open. Tell the person what is missing.\n");
  tx_put(t[..], "- `engine-has`: the engine already does it and GameBuilder does not use it yet. That is GameBuilder's own code too: tell the person.\n");
  tx_put(t[..], "- `engine-partly`: the engine does part of it. Read the chapter it names (`gamebuilder engine-read N`) and that chapter's source, then say which part is missing.\n");
  tx_put(t[..], "- `engine-needs`: the engine can't do it yet. Say the answer's `offer` to the person, word for word:\n\n  > "); tx_put(t[..], TRI_OFFER); tx_put(t[..], "\n\n");
  tx_put(t[..], "  \"Potentially\" is part of it: today a merged engine feature earns credit in the person's GitHub name, and no payment exists. Don't promise more. On a yes, follow the steps at the end of this section. On a no, tell the person what the engine is missing and stop.\n\n");
  tx_put(t[..], "When it answers `\"sure\":false`, the model was under 75% sure. Tell the person you are not certain, read `gamebuilder engine-list` yourself, and decide from it before you offer anything. The answer then carries the chapter the model picked, whatever the fit: look at it. The same request gives the same answer each time; a request worded another way can give another.\n\n");
  tx_put(t[..], "Triage asks OpenAgents' decision model once a call and needs the network. With no answer (`unreachable`, `refused`), decide which of three it is yourself:\n\n");
  tx_put(t[..], "- **The level**: what is in it, where, and how big. Use the commands above.\n");
  tx_put(t[..], "- **The game**: which kinds of thing there are, templates, game rules and the editor itself. These are GameBuilder's own code, which isn't open. Tell the person what is missing.\n");
  tx_put(t[..], "- **The engine**: the OpenAgents Metaverse Engine and Coax, open source at "); tx_put(t[..], GB_ENGINE_REPO); tx_put(t[..], ". It holds:\n");
  for i: 0..<GB_ENGINE_PARTS { tx_put(t[..], "  - `"); tx_put(t[..], GB_ENGINE_PATH[i]); tx_put(t[..], "`: "); tx_put(t[..], GB_ENGINE_WHAT[i]); tx_put(t[..], "\n"); }
  tx_put(t[..], "\nBefore you say the engine can't do something, look: `gamebuilder engine-list` names every chapter of the engine's book at the commit GameBuilder is built on, each as implemented, partly implemented or a design draft, and `gamebuilder engine-read N` gives one chapter's summary and source files. An implemented chapter means the engine does it, so what is missing is GameBuilder's own code. A design draft, or no chapter at all, means it is an engine change. The list is the book: what the engine does with no chapter is not in it.\n");
  tx_put(t[..], "\nWhen a world needs the engine to do something it can't, and the person said yes to the offer, propose the change as a pull request at "); tx_put(t[..], GB_ENGINE_REPO); tx_put(t[..], ". The person needs no push access there: the branch goes to their own fork. The pull request is public and in their GitHub name, and a person at OpenAgents reviews it and may change or decline it. `gamebuilder engine` gives the engine commit GameBuilder is built on (read the engine's source at that commit) and these steps:\n\n");
  for i: 0..<GB_ENGINE_STEPS { tx_int(t[..], cast(s64) (i + 1)); tx_put(t[..], ". "); tx_put(t[..], GB_ENGINE_STEP[i]); tx_put(t[..], "\n"); }
  if t[0].at >= out.count { return ""; }
  return cast(string) out[0..<t[0].at];
}

// ---- checks

#test "the command table is well formed" {
  names := [GB_N] string.["list-levels", "read-level", "read-state", "read-content", "new-level", "copy-level",
    "list-games", "list-templates", "new-game", "rename-game", "read-game",
    "apply-edits", "add", "set-field", "delete", "list-palette", "list-fields", "list-modes",
    "whoami", "login", "logout", "engine",
    "undo", "redo", "set-tool", "focus", "copy", "paste", "duplicate", "decide", "cut", "play-test",
    "agents", "undo-turn", "ask", "write-content",
    "agent-read", "agent-events", "agent-new", "agent-message", "agent-answer", "agent-stop", "agent-undo", "agent-report",
    "agents-pane", "code-brief", "code-agent", "claim", "claims", "release",
    "open-level", "open-game", "play", "stop", "play-state", "list-scrappers", "travel", "digger", "bag-select",
    "lobby-read", "lobby-name", "lobby-say", "lobby-mute", "lobby-report", "party-read", "party-invite", "party-answer", "party-leave", "party-side", "party-scrapper", "party-match", "party-look", "party-start",
    "delete-level", "delete-game", "rename-level", "move-level", "owners", "set-owners",
    "place", "ball", "put", "turn", "kind", "size", "move", "remove", "clear", "set", "reset", "gravity", "select", "spin", "funnel",
    "changes", "show-changes", "dismiss-changes",
    "publish", "published", "versions", "set-live", "unpublish", "remove-published", "feedback", "feedback-hide", "block", "report",
    "agents-account", "pictures", "picture", "agent-picture", "goes", "engine-list", "engine-read", "triage", "computers", "computer-report", "agent-new-on", "engine-ready", "engine-mine"];
  for i: 0..<GB_N {
    c := GB_COMMANDS[i];
    // each VERB_ constant is its row
    #assert c.verb == names[i] && gb_find(c.verb) == i;
    for j: i + 1..<GB_N { #assert c.verb != GB_COMMANDS[j].verb; }
    known_effect := false; for x: GB_EFFECTS { if x == c.effect { known_effect = true; } }
    known_approval := false; for x: GB_APPROVALS { if x == c.approval { known_approval = true; } }
    #assert known_effect && known_approval;
    for k: 0..<gb_parts(c.arguments) {
      known := false; for x: GB_KINDS { if x == gb_part(c.arguments, k) { known = true; } }
      #assert known;
    }
    // what changes something you may not own asks for its owner; a read never writes
    #assert c.effect != "edit" || c.approval != "none" || c.arguments == "" || c.arguments == "level" || c.arguments == "template";
    // an edit a program sends can be tried first; the app's own buttons are their own try
    #assert c.effect == "edit" || !gb_has_flag(i, "--dry-run");
    #assert c.effect != "edit" || gb_has_flag(i, "--dry-run") || (c.surfaces & GB_CLI) == 0;
    // and can be sent again safely with a key (realm.result.v1)
    #assert gb_has_flag(i, "--key") == (c.effect == "edit" && (c.surfaces & GB_CLI) != 0);
    #assert c.usage.count > 0 || c.arguments == "";
    #assert c.help.count > 0 && c.impl.count > 0 && ((c.surfaces & (GB_CLI | GB_UI | GB_PANE)) != 0 || (c.area == "web" && c.surfaces == GB_WEB));
    // the pane's agent gets the open level's rows and no others: never a game, a file or the account
    #assert (c.surfaces & GB_PANE) == 0 || ((c.area == "level" || c.area == "edit" || c.area == "play") && c.effect != "spend" && c.approval != "person" && c.verb != "read-state" && c.verb != "read-content");
    // what is not read or looked at needs someone's leave
    // (a match on the person's own screen is looked at: the screen's play rows)
    #assert c.effect == "read" || c.effect == "view" || c.approval != "none" || c.area == "level" || c.area == "game" || c.area == "account" || (c.effect == "play" && gb_gap_has(c, "screen"));
    #assert c.effect != "spend" || c.approval == "confirm" || c.approval == "person";
    // only the person logs in; the account is never a level's edit
    // and only the person speaks, invites or plays with others in the lobby
    #assert (c.approval == "person") == (c.verb == "login" || c.verb == "set-owners" || (c.area == "lobby" && c.effect != "read") || (c.area == "publish" && c.effect != "read")) && (c.area == "account") == (c.effect == "account");
    // every row the CLI runs is in the skill, and the skill offers only what the CLI runs
    #assert ((c.surfaces & GB_SKILL) != 0) == ((c.surfaces & GB_CLI) != 0);
    #assert (c.surfaces & GB_MCP) == 0 || (c.surfaces & GB_CLI) != 0;
  }
  #assert gb_find("nope") == -1 && gb_find("") == -1 && gb_find("Add") == -1;
}

#test "a call's words are read by their kinds, with their bounds in the refusal" {
  a: [1] GbArgs; none := GbFlags.{};
  #assert gb_try(VERB_SET_FIELD, "3 12 East -400", none, a[..]) == "";
  #assert a[0].level == 3 && a[0].thing == 12 && a[0].field == FIELD_X && a[0].value == -400;
  #assert gb_try(VERB_SET_FIELD, "3 12 kind tree", none, a[..]) == "" && a[0].value == KIND_TREE;
  #assert gb_try(VERB_SET_FIELD, "3 12 colour 1", none, a[..]) != "";
  #assert gb_try(VERB_READ_LEVEL, "10000", none, a[..]) == "a level is a number from 0 to 9999 (LEVEL_MAX)";
  #assert gb_try(VERB_READ_LEVEL, "", none, a[..]) != "";
  #assert gb_try(VERB_ADD, "1 ball", GbFlags.{x = "300", z = "-200"}, a[..]) == "" && a[0].at && a[0].x == 300 && a[0].z == -200;
  #assert gb_try(VERB_ADD, "1 ball", GbFlags.{x = "300"}, a[..]) != "";
  #assert gb_try(VERB_ADD, "1 ball", GbFlags.{x = "30000", z = "0"}, a[..]) == "--x and --z are within 20000 cm of the middle (AGENT_REACH)";
  #assert gb_try(VERB_READ_LEVEL, "1", GbFlags.{dry = true}, a[..]) != "";
  #assert gb_try(VERB_NEW_GAME, "adventure", GbFlags.{dry = true}, a[..]) == "" && a[0].plays == TEMPLATE_ADVENTURE && a[0].dry;
  #assert gb_try(VERB_RENAME_GAME, "2 A|B", none, a[..]) != "";
  #assert gb_try(VERB_NEW_LEVEL, "", GbFlags.{key = "k-1.A_b"}, a[..]) == "" && a[0].key == "k-1.A_b";
  #assert gb_try(VERB_READ_LEVEL, "1", GbFlags.{key = "k"}, a[..]) != "";
  for bad: [6] string.["", ".", "..", "a/b", "a b", "-k"] { #assert gb_try(VERB_NEW_LEVEL, "", GbFlags.{key = bad}, a[..]) != "" || bad == ""; }
  long: [65] u8; for i: 0..<65 { long[i] = 'k'; }
  #assert gb_try(VERB_NEW_LEVEL, "", GbFlags.{key = cast(string) long[..]}, a[..]) != "";
  // play-test's flags, and their defaults
  #assert gb_try(VERB_PLAY_TEST, "1", none, a[..]) == "" && a[0].mode == MODE_KNOCKOUTS && a[0].size == SIZE_USUAL && a[0].seconds == PLAYTEST_SECONDS && a[0].seed == PLAYTEST_SEED;
  #assert gb_try(VERB_PLAY_TEST, "1", GbFlags.{mode = "hoops", size = "5", seconds = "30", seed = "0"}, a[..]) == "" && a[0].mode == MODE_HOOPS && a[0].size == 5 && a[0].seconds == 30 && a[0].seed == 0;
  #assert gb_try(VERB_PLAY_TEST, "1", GbFlags.{mode = "Hoops"}, a[..]) != "" && gb_try(VERB_PLAY_TEST, "1", GbFlags.{size = "6"}, a[..]) == "--size is 1 to 5 a side (TEAM_SIZE)";
  #assert gb_try(VERB_PLAY_TEST, "1", GbFlags.{seconds = "601"}, a[..]) != "" && gb_try(VERB_PLAY_TEST, "1", GbFlags.{seed = "-1"}, a[..]) != "";
  #assert gb_try(VERB_READ_LEVEL, "1", GbFlags.{seed = "1"}, a[..]) != "";
}

// Reads a call written as one line of words, as a shell would split it.
gb_try :: (v: int, line: string, flags: GbFlags, a: [] GbArgs) -> string {
  w: [8] string; n := 0; from := 0;
  for i: 0..<line.count + 1 {
    if i == line.count || line[i] == ' ' {
      if i > from && n < 8 { w[n] = cast(string) line[from..<i]; n += 1; }
      from = i + 1;
    }
  }
  return gb_args_read(v, w[0..<n], flags, a);
}

CommandTest :: struct { e: [1] Editor; out: [65536] u8; doc: [65536] u8; }

#test "publish --from keeps the game a remix came from, and published reads it back, with the game's counts where a server keeps them" {
  t: [1] CommandTest; e := t[0].e[..]; none: [1] s32; a: [1] GbArgs;
  #assert gb_try(VERB_PUB_PUBLISH, "1 Moss", GbFlags.{from = "abc234"}, a[..]) == "" && a[0].from == "abc234";
  #assert gb_try(VERB_PUB_PUBLISH, "1 Moss", GbFlags.{from = "abc0ef"}, a[..]) == PUB_FROM_WORDS && gb_try(VERB_PUB_UNPUBLISH, "1", GbFlags.{from = "abc234"}, a[..]) != "";
  #assert gb_run(e, VERB_NEW_GAME, GbArgs.{plays = TEMPLATE_ARENA}, GbWorld.{levels = none[0..<0]}, t[0].out[..]).code == GB_DONE;
  for c: "me@example.com" { e[0].account[e[0].account_n] = c; e[0].account_n += 1; }
  one := [1] s32.[ed_level(e)];
  w := GbWorld.{levels = one[..], now = 1000};
  // a dry run keeps nothing, and says nothing of it
  r := gb_run(e, VERB_PUB_PUBLISH, GbArgs.{level = one[0], text = "Moss Two", from = "abc234", dry = true}, w, t[0].out[..]);
  #assert r.code == GB_DONE && level_find(r.json, "\"from\"") < 0 && e[0].pub[0].game_n == 0;
  r = gb_run(e, VERB_PUB_PUBLISH, GbArgs.{level = one[0], text = "Moss Two", from = "abc234"}, w, t[0].out[..]);
  #assert r.code == GB_DONE && r.published == 1 && r.version == 1 && level_find(r.json, "\"from\":\"abc234\"") > 0;
  // a later version that says another game is answered with the one kept
  r = gb_run(e, VERB_PUB_PUBLISH, GbArgs.{level = one[0], text = "Moss Two", from = "zzz999"}, w, t[0].out[..]);
  #assert r.code == GB_DONE && r.version == 2 && level_find(r.json, "\"from\":\"abc234\"") > 0;
  // on a device: the game it came from, and no counts (none are kept there)
  r = gb_run(e, VERB_PUB_PUBLISHED, GbArgs.{}, w, t[0].out[..]);
  #assert r.code == GB_DONE && level_find(r.json, "\"on_web\":true,\"from\":\"abc234\"}") > 0 && level_find(r.json, "\"plays\"") < 0;
  // on the account's server: the counts the server read for it, and nothing yet for a game never counted
  code := e[0].pub[0].games[0].code; p: [1] Plays; lb: [PY_LINE] u8;
  w.games = "https://gamebuilder.org";
  r = gb_run(e, VERB_PUB_PUBLISHED, GbArgs.{}, w, t[0].out[..]);
  #assert level_find(r.json, "\"from\":\"abc234\",\"plays\":{\"opened\":0,\"minute\":0,\"remix\":0,\"remade\":0}}") > 0;
  p[0].n[PY_OPENED] = 12; p[0].n[PY_MINUTE] = 5; p[0].n[PY_REMIX] = 2; p[0].n[PY_REMADE] = 1;
  ln := py_list_put(lb[..], 0, cast(string) code[0..<PUB_CODE], p[..]);
  w.plays = cast(string) lb[0..<ln];
  r = gb_run(e, VERB_PUB_PUBLISHED, GbArgs.{}, w, t[0].out[..]);
  #assert level_find(r.json, "\"plays\":{\"opened\":12,\"minute\":5,\"remix\":2,\"remade\":1}}") > 0;
}

#test "rows change a level as the app does, and refuse in words" {
  t: [1] CommandTest; e := t[0].e[..];
  none: [1] s32;
  w := GbWorld.{levels = none[0..<0]};
  a: [1] GbArgs;
  // a new level: number 1, an arena of things
  #assert gb_run(e, VERB_NEW_LEVEL, GbArgs.{}, w, t[0].out[..]).save_level && ed_level(e) == 1;
  before := ed_count(e);
  // a block where it is asked for
  #assert gb_try(VERB_ADD, "1 block", GbFlags.{x = "500", z = "-300"}, a[..]) == "";
  r := gb_run(e, VERB_ADD, a[0], w, t[0].out[..]);
  #assert r.code == GB_DONE && r.save_level && ed_count(e) == before + 1;
  id := e[0].selected;
  #assert ed_field(e, FIELD_X) == 500 && ed_field(e, FIELD_Z) == -300;
  // a field set through the inspector's export, in range, and refused out of it with the numbers
  #assert gb_try(VERB_SET_FIELD, "1 0 turn 90", GbFlags.{}, a[..]) != "";
  a[0] = GbArgs.{level = 1, thing = id, field = FIELD_TURN, value = 90};
  #assert gb_run(e, VERB_SET_FIELD, a[0], w, t[0].out[..]).code == GB_DONE && ed_field(e, FIELD_TURN) == 90;
  a[0].value = 900;
  r = gb_run(e, VERB_SET_FIELD, a[0], w, t[0].out[..]);
  #assert r.code == GB_REFUSED && level_find(r.json, "Turn is from -180 to 180") >= 0;
  // a second ball is not added: the one there is answers
  a[0] = GbArgs.{level = 1, kind = KIND_BALL};
  r = gb_run(e, VERB_ADD, a[0], w, t[0].out[..]);
  #assert r.code == GB_DONE && !r.save_level && level_find(r.json, "\"already\":true") >= 0;
  // a dry run changes the editor and says it wrote nothing
  a[0] = GbArgs.{level = 1, thing = id, dry = true};
  r = gb_run(e, VERB_DELETE, a[0], w, t[0].out[..]);
  #assert r.code == GB_DONE && !r.save_level && level_find(r.json, "\"dry_run\":true") >= 0 && ed_index(e, id) < 0;
  // no such thing
  a[0] = GbArgs.{level = 1, thing = 9999};
  #assert gb_run(e, VERB_DELETE, a[0], w, t[0].out[..]).code == GB_REFUSED;
  // the game's own level is not yours: a copy is
  _ = gb_open(e, 0, t[0].doc[0..<0], true);
  a[0] = GbArgs.{thing = 1};
  r = gb_run(e, VERB_DELETE, a[0], w, t[0].out[..]);
  #assert r.code == GB_REFUSED && level_find(r.json, "not-permitted") >= 0 && level_find(r.json, "copy-level") >= 0;
  one := [1] s32.[1];
  r = gb_run(e, VERB_COPY_LEVEL, GbArgs.{}, GbWorld.{levels = one[..]}, t[0].out[..]);
  #assert r.save_level && ed_level(e) == 2 && ed_may_edit(e);
}

#test "a new game and its level, named and listed" {
  t: [1] CommandTest; e := t[0].e[..];
  none: [1] s32;
  w := GbWorld.{levels = none[0..<0]};
  r := gb_run(e, VERB_NEW_GAME, GbArgs.{plays = TEMPLATE_ADVENTURE}, w, t[0].out[..]);
  #assert r.code == GB_DONE && r.save_level && r.save_game == 1 && ed_level(e) == 1 && ed_template(e) == TEMPLATE_ADVENTURE;
  r = gb_run(e, VERB_RENAME_GAME, GbArgs.{game = 1, text = "Moss Run"}, w, t[0].out[..]);
  #assert r.code == GB_DONE && r.save_game == 1;
  r = gb_run(e, VERB_LIST_GAMES, GbArgs.{}, w, t[0].out[..]);
  #assert level_find(r.json, "\"title\":\"Moss Run\",\"template\":\"adventure\",\"levels\":[1]") >= 0;
  r = gb_run(e, VERB_LIST_PALETTE, GbArgs.{}, w, t[0].out[..]);
  #assert level_find(r.json, "\"template\":\"adventure\"") >= 0 && level_find(r.json, "\"kind\":\"ball\"") < 0;
  #assert gb_run(e, VERB_RENAME_GAME, GbArgs.{game = 7, text = "X"}, w, t[0].out[..]).code == GB_REFUSED;
}

#test "a level's whole file fits the answer" { #assert ed_save_max() <= GB_DOC_MAX; }

#test "the manifest names every row" {
  t: [1] CommandTest;
  m := gb_manifest(t[0].out[..]);
  #assert m.count > 0;
  for c: GB_COMMANDS { #assert level_find(m, c.verb) >= 0; }
  vb: [96] u8; hb: [8] u8;
  #assert level_find(m, "\"table\":\"") >= 0 && level_find(m, gb_version(vb[..])) >= 0;
  #assert level_find(m, gb_hex8(gb_table_digest(), hb[..])) >= 0;
}

// The surface rule (issue 3, item 2): a row is on every surface unless it says why not, in words
// from GB_GAPS, and every reason it gives is true of it and excuses a surface it lacks. A row
// added on one surface only, or a reason left after the surface came, fails here.
gb_gap_why :: (c: GbCommand) -> string {
  excused: s32 = 0;
  for k: 0..<gb_parts(c.gap) {
    g := gb_gap_find(gb_part(c.gap, k));
    if g < 0 { return "names a reason GB_GAPS doesn't have"; }
    r := GB_GAPS[g];
    if r.name != "live" && (r.excuses & (GB_RULED ^ (c.surfaces & GB_RULED))) == 0 { return "gives a reason for a surface it is on"; }
    // each reason is true of the row
    if r.name == "drawn" && c.effect != "read" { return "says drawn but is not a read"; }
    if r.name == "spend" && c.effect != "spend" { return "says spend but pays for nothing"; }
    if r.name == "person" && c.approval != "person" { return "says person but anyone may run it"; }
    if r.name == "login" && c.area != "account" { return "says login but is not an account row"; }
    if r.name == "pane" && ((c.surfaces & GB_PANE) == 0 || (c.surfaces & GB_UI) != 0) { return "says pane but is not the pane's own"; }
    if (r.name == "screen" || r.name == "view") && (c.surfaces & GB_UI) == 0 { return "says screen or view but the app has no control for it"; }
    if r.name == "match" && c.area != "play" { return "says match but is not a play row"; }
    if r.name == "lobby" && c.area != "lobby" { return "says lobby but is not a lobby row"; }
    if r.name == "web" && (c.area != "web" || c.surfaces != GB_WEB) { return "says web but is not the website's own plan line"; }
    if r.name == "site" && c.area != "site" { return "says site but is not one of the website's own rows"; }
    if r.name == "batch" && (c.effect != "edit" || (c.surfaces & GB_PANE) != 0) { return "says batch but is not an edit kept from the pane"; }
    if r.name == "gesture" && c.effect != "edit" { return "says gesture but is not an edit"; }
    if (r.name == "agents" || r.name == "runner") && c.area != "agent" { return "says agents or runner but is not an agent row"; }
    if r.name == "claim" && (c.effect != "edit" || (c.surfaces & GB_PANE) == 0 || level_find(c.flags, "--agent:") < 0) { return "says claim but is not an edit an agent names itself in"; }
    excused |= r.excuses;
  }
  lacks := GB_RULED ^ (c.surfaces & GB_RULED);
  missing := lacks ^ (lacks & excused);
  if missing != 0 {
    for s: 0..<GB_SURFACES { if (missing & cast(s32) (1 << s)) != 0 { return GB_SURFACE_NAME[s]; } }
  }
  return "";
}

#test "every row is on every surface, or says why not in words the table holds" {
  for c: GB_COMMANDS { #assert gb_gap_why(c) == ""; }
  for g: GB_GAPS { #assert g.words.count > 0 && gb_gap_find(g.name) >= 0; }
  // a row on one surface only, with no reason, is refused, and says which surface it lacks
  one := GB_COMMANDS[VERB_ADD]; one.surfaces = GB_CLI | GB_SKILL; one.gap = "";
  #assert gb_gap_why(one) == "ui";
  // a reason for a surface the row is on, a reason not true of it, and a word not in the list
  on := GB_COMMANDS[VERB_ADD]; on.surfaces = GB_FILES; on.gap = "batch|drawn";
  #assert gb_gap_why(on) == "says drawn but is not a read";
  stale := GB_COMMANDS[VERB_UNDO]; stale.surfaces = GB_UI | GB_PANE; stale.gap = "screen|view";
  #assert gb_gap_why(stale) == "gives a reason for a surface it is on";
  #assert gb_gap_why(GbCommand.{verb = "x", effect = "read", surfaces = GB_CLI | GB_SKILL, gap = "soon"}) == "names a reason GB_GAPS doesn't have";
}

#test "the version names the commit and the table, and any change to a row changes the table's digest" {
  vb: [96] u8; hb: [8] u8;
  v := gb_version(vb[..]);
  #assert level_find(v, GB_RELEASE) == 0 && level_find(v, GB_COMMIT) > 0 && level_find(v, ".table-") > 0;
  #assert level_find(v, gb_hex8(gb_table_digest(), hb[..])) == v.count - 8;
  #assert gb_table_digest() == gb_table_digest() && gb_hex8(0x1a2b3c4d, hb[..]) == "1a2b3c4d";
  // each column counts: a row changed in any one of them is another row
  for v2: 0..<GB_N {
    c := GB_COMMANDS[v2]; d := gb_row_digest(v2);
    for k: 0..<13 {
      x := c;
      if k == 0 { x.verb = "other"; } else if k == 1 { x.area = "other"; } else if k == 2 { x.effect = "other"; }
      else if k == 3 { x.approval = "other"; } else if k == 4 { x.arguments = "level|level"; } else if k == 5 { x.flags = "--other:bool"; }
      else if k == 6 { x.result = "other"; } else if k == 7 { x.limit = "other"; } else if k == 8 { x.impl = "other"; }
      else if k == 9 { x.usage = "other"; } else if k == 10 { x.help = "other"; } else if k == 11 { x.gap = "live"; }
      else { x.surfaces = c.surfaces ^ GB_HTTP; }
      #assert gb_row_digest_of(x) != d;
    }
    for w: v2 + 1..<GB_N { #assert gb_row_digest(w) != d; }
  }
}

#test "the skill names every row it offers, the limits and the engine's way in" {
  t: [1] CommandTest; b: [GB_SKILL_MAX] u8;
  s := gb_skill(b[..]);
  #assert s.count > 0 && level_find(s, "name: gamebuilder\n") >= 0;
  for c: GB_COMMANDS {
    if (c.surfaces & GB_SKILL) == 0 { continue; }
    #assert level_find(s, c.help) >= 0;
    line: [256] u8; lt := [1] Text.[Text.{buf = line[..]}];
    tx_put(lt[..], "`gamebuilder "); tx_put(lt[..], c.verb); if c.usage.count > 0 { tx_put(lt[..], " "); tx_put(lt[..], c.usage); } tx_put(lt[..], "`");
    #assert level_find(s, cast(string) line[0..<lt[0].at]) >= 0;
  }
  #assert level_find(s, "64 edits a batch") >= 0 && level_find(s, "20000 cm of the middle") >= 0;
  #assert level_find(s, "gh pr create --repo OpenAgentsInc/openagents") >= 0;
  o: [1] Jo; jo_start(o[..], t[0].out[..]);
  r := gb_engine(o[..], "0123abcd");
  #assert r.code == GB_DONE && level_find(r.json, "\"repo\":\"OpenAgentsInc/openagents\",\"commit\":\"0123abcd\"") >= 0;
  #assert level_find(r.json, "/tree/0123abcd") >= 0 && level_find(r.json, "\"upgrade\":[") >= 0;
}

#test "a batch as people write it: spaced out, in another order, or dry" {
  t: [1] CommandTest; e := t[0].e[..];
  none: [1] s32; w := GbWorld.{levels = none[0..<0]};
  r := gb_run(e, VERB_NEW_GAME, GbArgs.{plays = TEMPLATE_ADVENTURE}, w, t[0].out[..]);
  #assert r.code == GB_DONE;
  rb: [64] u8; rt := [1] Text.[Text.{buf = rb[..]}]; tx_int(rt[..], cast(s64) ed_agent_rev(e));
  rev := cast(string) rb[0..<rt[0].at];
  bb: [512] u8; bt := [1] Text.[Text.{buf = bb[..]}];
  tx_put(bt[..], "{\n  \"schema\": \"world.edit.v1\", \"rev\": "); tx_put(bt[..], rev);
  tx_put(bt[..], ",\n  \"do\": \"apply\",\n  \"edits\": [\n    {\"op\": \"spawn\", \"id\": 0, \"kind\": 2, \"x\": 500, \"y\": 0, \"z\": 0, \"yaw\": 0, \"scale\": 100}\n  ]\n}\n");
  // the fields out of the wire's order: refused, with the batch as the wire writes it
  ob: [512] u8; ot := [1] Text.[Text.{buf = ob[..]}];
  tx_put(ot[..], "{\"schema\":\"world.edit.v1\",\"rev\":"); tx_put(ot[..], rev);
  tx_put(ot[..], ",\"do\":\"apply\",\"edits\":[{\"op\":\"spawn\",\"kind\":2,\"id\":0,\"x\":500,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}]}");
  r = gb_run(e, VERB_APPLY_EDITS, GbArgs.{batch = cast(string) ob[0..<ot[0].at]}, w, t[0].out[..]);
  #assert r.code == GB_REFUSED && level_find(r.json, "\"wire\":\"{\\\"schema\\\":\\\"world.edit.v1\\\"") >= 0;
  // spaced out over lines, as the skill shows it, and dry: carried out, nothing written
  r = gb_run(e, VERB_APPLY_EDITS, GbArgs.{batch = cast(string) bb[0..<bt[0].at], dry = true}, w, t[0].out[..]);
  #assert r.code == GB_DONE && level_find(r.json, "\"dry_run\":true}") >= 0 && !r.save_level;
  tb: [64] u8;
  #assert gb_tidy("{ \"a\" : \"b c\" }\n", tb[..]) == "{\"a\":\"b c\"}";
}
