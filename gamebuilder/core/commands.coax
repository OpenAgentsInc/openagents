  GbCommand.{verb = "play-test", area = "play", effect = "read", approval = "none", arguments = "level",
    flags = "--mode:mode|--size:size|--seconds:seconds|--seed:seed", result = "gamebuilder.playtest.v1",
    limit = "600 seconds of match or walking time (PLAYTEST_SECONDS); 1 to 5 a side (TEAM_SIZE); a path keeps 40 points a bot (PLAYTEST_POINTS); a walk-through looks for 64 things at most (PLAYTEST_MARKERS) on a grid of 16,384 cells (NAV_GRID_MOST)", impl = "ed_play_test", surfaces = GB_FILES_PANE, gap = "headless",
    usage = "LEVEL [--mode MODE] [--size N] [--seconds S] [--seed N]",
    help = "play the level headless and report how it went: an arena by a match with bots in every seat, in fixed steps from a seed (the score, knockouts), every other game type by a walk-through, a bot that walks from your start to every thing it can reach; and for both the bots' paths, where they got stuck, and the things no bot reached. In the app it is also a picture of the level with the paths on it. The same call answers the same every time"},
  GbCommand.{verb = "agents", area = "agent", effect = "read", approval = "none", result = "gamebuilder.agents.v1",
