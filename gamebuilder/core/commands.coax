    usage = "", help = "ask the person a question with buttons to answer it, and wait for the answer: use it when the request could mean two different levels, never to confirm an edit; with engine set, when the level needs an engine change, the person is offered a Code agent on the engine for it"},
  GbCommand.{verb = "write-content", area = "level", effect = "edit", approval = "owner", arguments = "level|revision|content", flags = "--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
