  GbCommand.{verb = "agent-new", area = "agent", effect = "edit", approval = "owner", arguments = "game|role|job", flags = "--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
    limit = "a job of at most 240 bytes (AGR_JOB); 256 agents a folder keeps (AGR_RECORDS); build and playtest run today; a cloud Builder at most 12 model steps (a step runs at most 8 commands), 100,000 tokens, 30 changes and 10 minutes a message and 60 model steps a day an account (AGR_CLOUD_STEPS, AGR_CLOUD_TOKENS, AGR_CLOUD_EDITS, AGR_CLOUD_MINUTES, AGR_CLOUD_DAY)", impl = "agr_record_new|agr_append|gb_agent_new_cloud", surfaces = GB_FILES | GB_UI | GB_WEB, gap = "agents",
    usage = "GAME ROLE JOB [--dry-run] [--key K]", help = "a new agent on a game of yours, queued on this computer: a Builder (build) or a Playtester (playtest), with its job in your words. GameBuilder runs it on the game's first level with your own Claude Code. On your account (gamebuilder.org/agents, serve --accounts) it is a cloud Builder: the server runs it with OpenAgents' model, free, and its answer says its limits"},
  GbCommand.{verb = "agent-message", area = "agent", effect = "edit", approval = "owner", arguments = "agent|message", flags = "--dry-run:bool|--key:key", result = "gamebuilder.result.v1",
