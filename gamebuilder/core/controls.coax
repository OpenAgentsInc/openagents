// The app's controls: every button, menu item and banner the host draws,
// each with the command table's row it runs (docs/programmatic-access.md,
// "The UI goes through it"). A button can only exist with a row behind it,
// and a press runs that row through ed_command, the one export every
// surface calls: the toolbar's Undo is the `undo` row, its Add block is the
// `add` row with {"kind":"block"}. The SwiftUI toolbar and menus in
// host/Sources/App.swift read this table through ed_control_* and draw
// what it says, until they are drawn in Coax.
//
// ed_command fills in what a call leaves out from the screen: the level is
// the open one, and a thing is the selection. A call that names another
// level is refused; the app opens levels itself.
//
// This file is the app core's root: scripts/generate.sh compiles it (it
// loads mcp.coax, the command table and the whole editor), and its run is
// every check the core has (scripts/check.sh).
//   scripts/check.sh
// The secp256k1 tables the editor loads are built at compile time (editor.coax).
#run_steps 100000000;
#load "mcp.coax";
#load "attach.coax";
#load "agents.coax";
#load "sync.coax";
#load "lobby-rows.coax";

// Where a control is drawn.
GB_PLACE_TOOLBAR :: 0;      // the toolbar over the viewport
GB_PLACE_MENU :: 1;         // the Mac's menu bar, with a key
GB_PLACE_LEVELS :: 2;       // the levels menu, the toolbar's first control
GB_PLACE_BANNER :: 3;       // the banner over a level you may not change
GB_PLACE_PANEL :: 4;        // the side panel, drawn by the core (coax/panel.coax)
GB_PLACE_EDIT :: 5;         // the Mac's own Edit menu items, sent to the level while it has the keys
GB_PLACE_AGENTS :: 6;       // the Agents pane, drawn by the core (coax/agents.coax)
GB_PLACE_PLAY :: 7;         // the play sheet and the match's HUD
GB_PLACE_LOBBY :: 8;        // the lobby sheet
GB_PLACES :: 9;

// Who carries a press out.
GB_HOST_CORE :: 0;          // ed_control_press, through ed_command
GB_HOST_DECIDE :: 1;        // the host: it sends the request the core writes (Decide.swift)
GB_HOST_NEW_GAME :: 2;      // the host: it opens the picker (picker.coax), makes the game of the type chosen, then writes its file
GB_HOST_PANEL :: 3;         // the core's own panel, which calls the row's exports as it draws
GB_HOST_FILE :: 4;          // ed_control_press_with, then the host reads the file the core says is due and opens it (ed_open_due)
GB_HOST_DRAWN :: 5;         // the host draws the row's answer where it is used, as it changes (the match's HUD)
GB_HOST_LOBBY :: 6;         // the host's lobby sheet: ed_lobby_command, as the person's own press, signed with their key

// A menu key's modifiers.
GB_MOD_COMMAND :: 1; GB_MOD_SHIFT :: 2;

GbControl :: struct {
  id: string;               // "toolbar.undo": the place, then what it is
  verb: int;                // its row (VERB_)
  place: s32;               // GB_PLACE_
  group: s32;               // the toolbar's run of buttons between two bars; the menu bar's group
  args: string;             // the call's arguments, beyond what the screen fills in: {"kind":"block"}
  icon: string;             // the SF Symbol the host draws
  name: string;             // its words: its tooltip, its menu item, its banner
  key: string;              // a menu item's key, or ""
  mods: s32;                // GB_MOD_
  host: s32;                // GB_HOST_
  each: string;             // drawn once for each of many: the argument a press gives (ed_control_press_with), or ""
}

// The menu bar's groups, as the host places them: 0 replaces Undo and Redo, 1 follows the
// pasteboard items, 2 replaces New.
GB_CONTROL_N :: 73;
