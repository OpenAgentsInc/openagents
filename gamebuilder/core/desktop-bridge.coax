// Relocatable C-ABI bridge embedding gamebuilder/core/ inside OpenAgents Desktop (GitHub #14043).
// Compiled into gamebuilder-core.o via `coax c ... --library` + `ld -r -exported_symbol '_oa_gb_*'`,
// keeping apps/openagents-desktop/ -> gamebuilder/ acyclic in contexts.txt.
//
// Invariant (gamebuilder/INVARIANTS.md): 100% of level/game mutations and UI button presses dispatch
// strictly through GB_COMMANDS (gb_command) and GB_CONTROLS (ed_control_press_with).
#run_steps 100000000;
#load "app.coax";

GbDesktopState :: struct {
  e: [1] Editor;
  pic_stage: [1] Editor;
  f: [1] Farm;
  farm_loaded: bool;
  pics: [1] PicStore;
  world_hud: [1] Hud;
  world_attached: bool;
  world_verts: [65536] f32;
  world_uniforms: [256] f32;
  lobby: [1] Lobby;
  lobby_key: [32] u8;
  lobby_aux: [32] u8;
  lobby_ready: bool;
  sync_st: [1] GbSync;
  ag_store: [1] AgrStore;
  now_ms: s64;
}

oa_gb_state_size :: () -> int #export_c #effects(all) {
  return size_of(GbDesktopState);
}

oa_gb_init :: (st: [] GbDesktopState, w: f32, h: f32) #export_c #effects(all) {
  if st.count < 1 { return; }
  ed_init(st[0].e[..], w, h);
  ed_pics_attach(st[0].e[..], st[0].pics[..]);
  st[0].farm_loaded = false;
  st[0].world_attached = false;
}

oa_gb_resize :: (st: [] GbDesktopState, w: f32, h: f32) #export_c #effects(all) {
  if st.count < 1 { return; }
  ed_resize(st[0].e[..], w, h);
}

oa_gb_set_account :: (st: [] GbDesktopState, email: string) #export_c #effects(all) {
  if st.count < 1 { return; }
  buf: [ACCOUNT_MAX] u8;
  n := ifx email.count < ACCOUNT_MAX then email.count else ACCOUNT_MAX;
  for i: 0..<n { buf[i] = email[i]; }
  ed_set_account(st[0].e[..], buf[0..<n]);
}

// ---- Single Command Table Choke Point (GB_COMMANDS & GB_CONTROLS)

oa_gb_run_verb :: (st: [] GbDesktopState, verb_name: string, args_json: string, levels: [] s32, out_json: [] u8) -> s64 #export_c #effects(all) {
  if st.count < 1 || out_json.count < 2 { return 0; }
  v := gb_find(verb_name);
  if v < 0 { return 0; }
  r := gb_command_run_world(st[0].e[..], v, args_json, GbWorld.{levels = levels, agents = st[0].ag_store[..], now = st[0].now_ms}, out_json, 0);
  if r.json.count == 0 { return 0; }
  return ifx r.code == GB_DONE then r.json.count else -r.json.count;
}

oa_gb_press_ctrl :: (st: [] GbDesktopState, ctrl_id: string, args_json: string, levels: [] s32, out_json: [] u8) -> s64 #export_c #effects(all) {
  if st.count < 1 || out_json.count < 2 { return 0; }
  idx := gb_control_find(ctrl_id);
  if idx < 0 { return 0; }
  abuf: [4096] u8;
  an := ifx args_json.count < 4096 then args_json.count else 4096;
  for i: 0..<an { abuf[i] = args_json[i]; }
  return ed_control_press_with(st[0].e[..], cast(s32) idx, abuf[0..<an], levels, out_json);
}

oa_gb_table_digest :: (out_hex: [] u8) -> int #export_c #effects(all) {
  if out_hex.count < 8 { return 0; }
  hb: [8] u8;
  s := gb_hex8(gb_table_digest(), hb[..]);
  for i: 0..<s.count { out_hex[i] = s[i]; }
  return s.count;
}

// Returns GB_APPROVALS index from canonical GB_COMMANDS (0=none, 1=owner, 2=confirm, 3=person, -1=unknown).
oa_gb_verb_approval :: (verb_name: string) -> s32 #export_c #effects(all) {
  v := gb_find(verb_name);
  if v < 0 || v >= GB_COMMANDS.count { return -1; }
  ap := GB_COMMANDS[v].approval;
  for k: 0..<GB_APPROVALS.count {
    if GB_APPROVALS[k] == ap { return cast(s32) k; }
  }
  return 0;
}

