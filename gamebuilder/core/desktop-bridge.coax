// Packs full UI state snapshot for cd_gb_sync_ui & cd_mv_tab_status:
// out_i[0..25]:
//   0:tool, 1:can_undo, 2:can_redo, 3:template_id, 4:playing, 5:level_n, 6:saved_rev,
//   7:save_due, 8:read_only, 9:change_count, 10:sel_count, 11:sel_id, 12:sel_kind,
//   13..23: 11 ed_field values, 24:actor_count, 25:claims_count
// out_cam[0..8]: hit/sel xyz (cm), eye xyz (cm), pivot xyz (cm)
oa_gb_ui_sync :: (st: [] GbDesktopState, out_i: [] s32, out_cam: [] s64, out_label: [] u8, out_note: [] u8) -> bool #export_c #effects(all) {
  if st.count < 1 || out_i.count < 26 || out_cam.count < 9 { return false; }
  e := st[0].e[..];
  out_i[0] = ed_tool(e);
  out_i[1] = ifx ed_can_undo(e) then 1 else 0;
  out_i[2] = ifx ed_can_redo(e) then 1 else 0;
  out_i[3] = ed_template(e);
  out_i[4] = ifx e[0].play[0].on then 1 else 0;
  out_i[5] = ed_level(e);
  out_i[6] = cast(s32) ed_agent_rev(e);
  out_i[7] = ifx ed_save_due(e) then 1 else 0;
  out_i[8] = ifx !ed_may_edit(e) then 1 else 0;
  out_i[9] = cast(s32) e[0].changes[0].n;
  has_sel := ed_has_selection(e);
  out_i[10] = ifx has_sel then 1 else 0;
  out_i[11] = ifx has_sel then e[0].selected else 0;
  out_i[12] = ifx has_sel then ed_field(e, 0) else -1;
  for fi: 0..<11 { out_i[13 + fi] = ifx has_sel then ed_field(e, cast(s32) fi) else 0; }
  out_i[24] = cast(s32) ed_count(e);
  out_i[25] = cast(s32) claims_here(e)[0].n;

  eye := ed_eye(e);
  piv := e[0].pivot;
  sel_x: s64 = cast(s64) (piv.x * 100.0f32);
  sel_y: s64 = cast(s64) (piv.y * 100.0f32);
  sel_z: s64 = cast(s64) (piv.z * 100.0f32);
  if has_sel {
    si := ed_index(e, e[0].selected);
    if si >= 0 {
      a := ed_actor(e, si);
      sel_x = cast(s64) a.x; sel_y = cast(s64) a.y; sel_z = cast(s64) a.z;
      t := [1] Text.[Text.{buf = out_label}];
      if a.kind >= 0 && a.kind < KINDS { tx_put(t[..], KIND_NAME[a.kind]); } else { tx_put(t[..], "actor"); }
      tx_put(t[..], " #"); tx_n(t[..], a.id);
      if t[0].at < out_label.count { out_label[t[0].at] = 0; }
    }
  } else if out_label.count > 0 { out_label[0] = 0; }

  out_cam[0] = sel_x; out_cam[1] = sel_y; out_cam[2] = sel_z;
  out_cam[3] = cast(s64) (eye.x * 100.0f32); out_cam[4] = cast(s64) (eye.y * 100.0f32); out_cam[5] = cast(s64) (eye.z * 100.0f32);
  out_cam[6] = cast(s64) (piv.x * 100.0f32); out_cam[7] = cast(s64) (piv.y * 100.0f32); out_cam[8] = cast(s64) (piv.z * 100.0f32);

  if out_note.count > 0 {
    nn := cast(int) e[0].note_len;
    if nn >= out_note.count { nn = out_note.count - 1; }
    for i: 0..<nn { out_note[i] = e[0].note[i]; }
    out_note[nn] = 0;
  }
  return true;
}

// Emits "0\t1\t<sel>\t<id>\t<kind> #<id>\n" TSV for the right-side Drawer scene tree.
oa_gb_tree_tsv :: (st: [] GbDesktopState, out: [] u8) -> int #export_c #effects(all) {
  if st.count < 1 || out.count < 2 { return 0; }
  e := st[0].e[..];
  t := [1] Text.[Text.{buf = out}];
  n := ed_count(e);
  if n > 128 { n = 128; }
  for i: 0..<n {
    a := ed_actor(e, i);
    sel := a.id == e[0].selected;
    tx_put(t[..], ifx sel then "0\t1\t1\t" else "0\t1\t0\t");
    tx_n(t[..], a.id);
    tx_put(t[..], "\t");
    if a.kind >= 0 && a.kind < KINDS { tx_put(t[..], KIND_NAME[a.kind]); } else { tx_put(t[..], "thing"); }
    tx_put(t[..], " #"); tx_n(t[..], a.id);
    tx_put(t[..], "\n");
  }
  return cast(int) t[0].at;
}
