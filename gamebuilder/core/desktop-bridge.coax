// ---- Render Pipeline 2: SPLICEBOTS UE Farm Pack

oa_gb_farm_open :: (st: [] GbDesktopState, pack: [] u8) -> bool #export_c #effects(all) {
  if st.count < 1 { return false; }
  ok := ed_farm_open(st[0].f[..], pack);
  st[0].farm_loaded = ok;
  if ok { _ = ed_farm_bind(st[0].e[..], st[0].f[..]); }
  return ok;
}

oa_gb_farm_shown :: (st: [] GbDesktopState) -> bool #export_c #effects(all) {
  return st.count > 0 && st[0].farm_loaded && ed_farm_shown(st[0].e[..]);
}

oa_gb_farm_draws :: (st: [] GbDesktopState) -> s32 #export_c #effects(all) {
  return ifx st.count > 0 && st[0].farm_loaded then ed_farm_draws(st[0].f[..]) else 0;
}

oa_gb_farm_copy :: (st: [] GbDesktopState, draws: [] u32, objects: [] f32) -> bool #export_c #effects(all) {
  return st.count > 0 && st[0].farm_loaded && ed_farm_copy(st[0].f[..], draws, objects);
}

// ---- Render Pipeline 3: world.coax -> web/hud.coax (9 Web Worlds)

oa_gb_world_attach :: (st: [] GbDesktopState, on: bool) #export_c #effects(all) {
  if st.count < 1 { return; }
  st[0].world_attached = on;
  ed_world_attach(st[0].e[..], on);
}

oa_gb_world_draws :: (st: [] GbDesktopState) -> bool #export_c #effects(all) {
  return st.count > 0 && ed_world_draws(st[0].e[..]);
}

oa_gb_world_playing :: (st: [] GbDesktopState) -> bool #export_c #effects(all) {
  return st.count > 0 && ed_world_playing(st[0].e[..]);
}

oa_gb_world_step :: (st: [] GbDesktopState, w: f32, h: f32, dpr: f32, dt: f32) -> int #export_c #effects(all) {
  if st.count < 1 || !st[0].world_attached { return 0; }
  return ed_world_frame(st[0].e[..], st[0].world_hud[..], st[0].world_verts[..], st[0].world_uniforms[..], w, h, dpr, dt);
}

