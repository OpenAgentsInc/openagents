// ---- Render Pipeline 2: SPLICEBOTS UE Farm Pack

oa_gb_farm_open :: (st: [] GbDesktopState, pack: [] u8) -> bool #export_c #effects(all) {
  if st.count < 1 { return false; }
  ok := ed_farm_open(st[0].f[..], pack);
  st[0].farm_loaded = ok;
  if ok { _ = ed_farm_bind(st[0].e[..], st[0].f[..]); }
  return ok;
}

oa_gb_farm_shown :: (st: [] GbDesktopState) -> bool #export_c #effects(all) {
  return st.count > 0 && st[0].farm_loaded && ed_farm_shown(st[0].e[..]);
