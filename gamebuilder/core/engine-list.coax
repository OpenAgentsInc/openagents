ENG_PIN :: "7c8823286b8c07a12cefb236cd8206d5de0c2c48";
ENG_N :: 103;
ENG_IMPLEMENTED :: 0; ENG_PARTLY :: 1; ENG_DRAFT :: 2;
// source: up to 4 files, "|" between them. folder: the engine folder most of them are in, "" for none.
EngRow :: struct { number: s32; status: s32; title: string; part: string; folder: string; source: string; summary: string; }
ENG_ROWS :: [ENG_N] EngRow.[
  EngRow.{number = 1, status = 0, title = "A frame has a fixed step", part = "Foundations", folder = "move",
    source = "metaverse-engine/examples/frame-rates.coax|metaverse-engine/examples/jump-at-60.coax|metaverse-engine/core/loop.coax|metaverse-engine/move/player.coax",
    summary = "Why a fixed step makes physics independent of the frame rate. How to keep time in whole nanoseconds, so that a step count doesn't depend on float rounding. How to clamp a long frame, limit the steps in one frame, and drop the extra time. How to draw between the last two steps. How to check that..."},
  EngRow.{number = 2, status = 0, title = "Spaces and units", part = "Foundations", folder = "core",
    source = "metaverse-engine/examples/feet-in-every-space.coax|metaverse-engine/core/refusals.coax|metaverse-engine/core/space.coax|metaverse-engine/tests/spaces/grid-as-world.coax",
    summary = "The engine's spaces: world, local, view, screen, and the Grid's drawing units. How to move a point between spaces with named functions only. How to use units as types, so that metres and grid units don't mix. How to check that code that mixes spaces doesn't compile."},
  EngRow.{number = 3, status = 0, title = "State starts from its defaults", part = "Foundations", folder = "state",
    source = "metaverse-engine/examples/state-defaults.coax|metaverse-engine/core/loop.coax|metaverse-engine/move/player.coax|metaverse-engine/move/walk.coax",
    summary = "What a declared default is, and where Coax applies it. Why zeroed memory isn't a constructed value. How native and browser hosts use the same compiler-generated initializers. How to compare initial states byte for byte, and how to confirm that the comparison detects a missing default."},
  EngRow.{number = 4, status = 0, title = "Input becomes typed actions", part = "Foundations", folder = "move",
    source = "metaverse-engine/examples/one-press.coax|metaverse-engine/core/input.coax|metaverse-engine/move/player.coax|metaverse-engine/move/walk.coax",
    summary = "How to separate actions from the devices that produce them. The difference between a level (something held) and a press (something that happens once). How to give each press to exactly one step. How to split a look movement across a frame's steps. How to handle dead zones, out-of-range values..."},
  EngRow.{number = 5, status = 0, title = "Replay a session exactly", part = "Foundations", folder = "core",
    source = "metaverse-engine/examples/power-boundaries.coax|metaverse-engine/examples/replay-a-walk.coax|metaverse-engine/core/math.coax|metaverse-engine/core/rand.coax",
    summary = "The envelope that every accepted external event travels in. How the gate refuses duplicate, stale, and unknown events. Why a live session and its replay apply events through the same call. How state digests find the first step that differs. Why the host's math library breaks replay across..."},
  EngRow.{number = 6, status = 0, title = "Entities are born and die", part = "A world", folder = "core",
    source = "metaverse-engine/core/entity.coax|metaverse-engine/examples/born-and-gone.coax|metaverse-engine/tests/entity-oracle.coax",
    summary = "Why a slot index alone isn't an identity, and how generations fix that. The difference between a handle, for use inside a step, and an EntityId, for saves, the network, and edits. How spawns and despawns wait for the step's flush. How to check a store against a plain list of IDs."},
  EngRow.{number = 7, status = 0, title = "Ask the world where things are", part = "A world", folder = "physics",
    source = "metaverse-engine/examples/four-questions.coax|metaverse-engine/physics/query.coax|metaverse-engine/tests/query-oracle.coax|metaverse-engine/move/player.coax",
    summary = "How to describe a realm's colliders: a flat ground, boxes, capsules, and floors. The contract of each of the four queries. One definition of the ground: its height, its slope, and which surface it is. How to check a query against a separate oracle that uses containment instead of formulas."},
  EngRow.{number = 8, status = 0, title = "Ground and collision", part = "A world", folder = "physics",
    source = "metaverse-engine/physics/ground.coax|metaverse-engine/physics/ground-query.coax|metaverse-engine/physics/ground-contact.coax|metaverse-engine/physics/collide.coax",
    summary = "Chapter 7 asks where shapes are. This chapter resolves a vertical capsule against boxes, body capsules and floor sides. Terrain locomotion samples the feet's height and slope; it does not sweep the full walking capsule against terrain triangles. Exact sphere/mesh contacts serve queries and the..."},
  EngRow.{number = 9, status = 0, title = "A character moves", part = "A world", folder = "move",
    source = "metaverse-engine/examples/run-and-jump.coax|metaverse-engine/move/player.coax|metaverse-engine/move/locomotion.coax|metaverse-engine/move/walk.coax",
    summary = "Steering the velocity toward a wish direction at a fixed acceleration. Gravity, the jump speed and the peak height on a fixed step. Standing, landing, falling and sliding, decided in one order each step. Turning to face the direction of travel. What the controller reads and what it writes."},
  EngRow.{number = 10, status = 0, title = "The camera follows", part = "A world", folder = "cam",
    source = "metaverse-engine/examples/follow-a-wall.coax|metaverse-engine/examples/one-camera-at-a-time.coax|metaverse-engine/cam/follow.coax|metaverse-engine/cam/shot.coax",
    summary = "The follow camera's state: turn, tilt, distance, and a spring-followed target. A critically damped spring that never overshoots. Room from the colliders: pulled in at once, backed out gently. Easing that is the same for any step size. Drawing the camera between the last two steps. One shot type..."},
  EngRow.{number = 11, status = 0, title = "The WGSL renderer", part = "Seeing it", folder = "render",
    source = "metaverse-engine/examples/admit-a-frame.coax|metaverse-engine/render/frame.coax|metaverse-engine/render/geometry.coax|metaverse-engine/render/graph/passes.coax",
    summary = "An incorrect draw count can make a shader read past its vertices. A correct count can still draw the wrong image if the browser and native host disagree about a binding, a depth clear or a water pass. The renderer must agree on both the bytes a frame may read and the order in which it reads them."},
  EngRow.{number = 12, status = 1, title = "Materials", part = "Seeing it", folder = "render",
    source = "metaverse-engine/render/shade/material.coax|metaverse-engine/examples/shade-a-material.coax|metaverse/style.coax|metaverse-engine/render/shade/sky.coax",
    summary = "The shading functions every painterly realm's fragment shader calls, and why moving them didn't change a byte of any shader. A material as data, and a table that is admitted whole or refused before anything draws. The banded surface on the CPU, compared bit for bit with a realm's own fragment..."},
  EngRow.{number = 13, status = 1, title = "Light and shadow", part = "Seeing it", folder = "render",
    source = "metaverse-engine/render/shade/light.coax|metaverse-engine/render/shade/material.coax|metaverse-engine/examples/light-a-frame.coax|metaverse/style.coax",
    summary = "A key light from a clock: its direction through the day, and the moon taking over while the sun is down. A shadow map that doesn't crawl: its middle moves in whole texels. Haze as a function of distance and height. Local lights as a bounded list that refuses past its size."},
  EngRow.{number = 14, status = 1, title = "Figures and animation", part = "Seeing it", folder = "anim",
    source = "metaverse-engine/anim/pose.coax|metaverse-engine/anim/skin.coax|metaverse-engine/anim/motion.coax|metaverse-engine/examples/pose-a-ranger.coax",
    summary = "A joint's local pose, and a cross-fade blended joint by joint before any parent's transform. The posed skeleton, chained from the root, and the palette the vertex shader reads. Gaits advanced by distance, so feet keep pace with the ground. Motions with joint limits that refuse, never bend."},
  EngRow.{number = 15, status = 1, title = "UI and the HUD", part = "Seeing it", folder = "ui",
    source = "metaverse-engine/ui/hud.coax|metaverse-engine/ui/tree.coax|metaverse-engine/ui/draw.coax|metaverse-engine/ui/arwes-frames.coax",
    summary = "Screen space in points, y down, with safe-area insets. Layout as pure functions from the viewport to rectangles. Hit areas that equal the drawn rectangles. UI input becoming chapter 4's typed actions. Focus order, semantic controls and keyboard activation, so the whole UI works from a keyboard..."},
  EngRow.{number = 16, status = 1, title = "Budgets that refuse", part = "Seeing it", folder = "host",
    source = "metaverse-engine/core/budget.coax|metaverse-engine/core/assets.coax|metaverse-engine/examples/budget-a-frame.coax|apps/openagents-web/garden.coax",
    summary = "A frame budget as declared data: steps, vertices, draw records and bytes. A declaration that is valid only when a full buffer is over budget. A meter that takes each request whole or refuses all of it, and keeps the first refusal for the report. A budget check in every realm, with the numbers..."},
  EngRow.{number = 17, status = 1, title = "A scene owns the state", part = "Physics", folder = "state",
    source = "metaverse-engine/physics/sim/scene.coax|metaverse-engine/examples/scene-three-shapes.coax|metaverse-engine/state/declarations.coax|metaverse-engine/state/lifecycle.coax",
    summary = "How to describe a world as data and then build it into solver arrays, so that stepping never allocates, looks anything up by name or changes shape. Why geometry, physical material and appearance are three separate descriptions of one entity. How a step is scheduled across several solvers and a..."},
  EngRow.{number = 18, status = 1, title = "Rigid bodies and time steps", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/rigid.coax|metaverse-engine/examples/spin-rigid-bodies.coax",
    summary = "The Newton–Euler equations for one body, and quaternion attitude. Explicit, semi-implicit and implicit integration, and what each does to energy, momentum and stability. Why the gyroscopic term needs care, and how an implicit step for it keeps a fast-spinning body stable. How to state an..."},
  EngRow.{number = 19, status = 2, title = "Joints in generalized coordinates", part = "Physics", folder = "",
    source = "",
    summary = "Spatial (6D) vectors and the tree structure of an articulated body. Forward kinematics along the tree. The mass matrix by the composite rigid-body algorithm (CRBA), the bias forces by recursive Newton–Euler (RNEA), and forward dynamics either by factoring M or by the articulated-body..."},
  EngRow.{number = 20, status = 1, title = "Find the pairs that might touch", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/broad.coax|metaverse-engine/examples/find-candidate-pairs.coax",
    summary = "Axis-aligned bounding boxes (AABBs), fattened by motion and a margin. Sweep and prune: sort box endpoints on an axis, report overlapping intervals, and exploit the fact that the order barely changes per step. Bounding volume hierarchies built in parallel from Morton codes. Brute-force all-pairs..."},
  EngRow.{number = 21, status = 1, title = "Find where they touch", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/narrow.coax|metaverse-engine/examples/find-where-they-touch.coax",
    summary = "Support functions and the Minkowski difference, the idea behind every general convex test. GJK for distance and intersection, EPA for penetration depth, and Minkowski portal refinement (MPR) as a cheaper alternative. Closed-form tests for primitive pairs, and the separating axis theorem for..."},
  EngRow.{number = 22, status = 2, title = "Contact as an optimization", part = "Physics", folder = "",
    source = "",
    summary = "Constraints as rows of a Jacobian: contact normals, friction directions, joint limits, equality constraints. Coulomb friction cones, and their pyramidal and elliptic approximations. Soft constraints: why a constraint with a little compliance makes the problem well posed, and how stiffness and..."},
  EngRow.{number = 23, status = 1, title = "Particles and their neighbors", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/particles.coax|metaverse-engine/examples/particle-neighbors.coax",
    summary = "Uniform spatial hashing and cell lists. Sorting particles by cell (counting sort, prefix sums) so neighbors are close in memory. Fixed-radius neighbor search and its determinism. Sampling shapes into particles at build time."},
  EngRow.{number = 24, status = 1, title = "Liquids from particles", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/sph.coax|metaverse-engine/examples/water-column.coax",
    summary = "Kernel interpolation, and estimating a field and its gradient from particles. Weakly compressible SPH (WCSPH) with an equation of state. Divergence-free SPH (DFSPH): solving for pressure so density stays constant and velocity stays divergence-free. Viscosity, surface tension and boundaries."},
  EngRow.{number = 25, status = 1, title = "Cloth and rope from constraints", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/pbd.coax|metaverse-engine/examples/rope-and-cloth.coax",
    summary = "Constraints as functions C(x) = 0 or C(x) ≥ 0 on particle positions. The PBD loop: predict, project constraints, update velocities. XPBD's compliance and Lagrange multipliers. Stretch, bending, volume and collision constraints, for cloth, rope and soft blobs. Gauss–Seidel versus Jacobi..."},
  EngRow.{number = 26, status = 1, title = "Sand, snow and clay on a grid", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/mpm.coax|metaverse-engine/examples/sand-and-jelly.coax",
    summary = "The particle-to-grid and grid-to-particle transfers, and affine particle in cell (APIC). Moving-least-squares MPM (MLS-MPM), which makes the update compact and fast. Deformation gradients and constitutive models: neo-Hookean elasticity, fixed corotated, snow plasticity, Drucker–Prager sand..."},
  EngRow.{number = 27, status = 2, title = "Elastic solids on a mesh", part = "Physics", folder = "",
    source = "",
    summary = "Linear tetrahedral elements, the deformation gradient per element and the rest-shape matrix. Hyperelastic energies: StVK, corotated and stable neo-Hookean. Explicit (symplectic Euler) and implicit (backward Euler by Newton) stepping, and when each is worth it. Assembling the stiffness matrix..."},
  EngRow.{number = 28, status = 1, title = "Smoke on a grid", part = "Physics", folder = "physics",
    source = "metaverse-engine/physics/sim/grid-fluid.coax|metaverse-engine/examples/smoke-and-vortex.coax",
    summary = "Operator splitting for incompressible flow: advect, add forces, project. Semi-Lagrangian advection and why it is unconditionally stable. Pressure projection by solving a Poisson equation. Staggered (MAC) grids and boundary conditions."},
  EngRow.{number = 29, status = 2, title = "Materials meet", part = "Physics", folder = "",
    source = "",
    summary = "Coupling as momentum exchange at an interface, and why Newton's third law must hold exactly in the sums. Rigid–particle, rigid–grid (MPM) and particle–mesh couplings. Explicit coupling's stability limit, and substepping. One-way versus two-way coupling."},
  EngRow.{number = 30, status = 2, title = "Contact that holds", part = "Physics", folder = "",
    source = "",
    summary = "Why explicit coupling oscillates for stiff interfaces. SAP: compliant contact as a convex optimization over velocities, solved with the implicit FEM step. IPC: log barriers on distance, continuous collision detection in the line search, and smoothed friction. Why both need f64, and why neither..."},
  EngRow.{number = 31, status = 2, title = "Many worlds in one step", part = "Physics", folder = "",
    source = "",
    summary = "A leading batch dimension over every solver array. Per-environment parameters and domain randomization, and what may vary (masses, friction, gains, poses) versus what may not (topology). Independent resets without disturbing other environments. Seeding: one counter-based stream per environment...."},
  EngRow.{number = 32, status = 2, title = "Differentiate a simulation", part = "Physics", folder = "",
    source = "",
    summary = "Reverse mode over a time-stepped simulation, and checkpointing. The adjoint of an implicit step: differentiate the optimality condition rather than the iterations. Gradients through contact: what they mean at a switch, and smoothing. Gradient modes per solver: exact, custom, none, enforced at..."},
  EngRow.{number = 33, status = 2, title = "Sensors read the simulation", part = "Physics", folder = "",
    source = "",
    summary = "Proprioception: joint positions, velocities and torques. Inertial measurement units from body accelerations and rates, with bias and noise. Contact and force/torque sensors, and tactile arrays. Ray-cast range sensors: lidar and depth. Sample-and-hold, delay and noise models; stamps."},
  EngRow.{number = 34, status = 2, title = "Pictures for policies", part = "Physics", folder = "",
    source = "",
    summary = "Camera models: pinhole intrinsics, extrinsics, distortion. Batched rasterization for RGB, depth, segmentation and normals. Ray tracing for depth-of-field, shadows and reflections when realism is the point. Image-level domain randomization: lighting, textures, camera pose and sensor noise...."},
  EngRow.{number = 35, status = 2, title = "Bring in robots and meshes", part = "Physics", folder = "",
    source = "",
    summary = "URDF and MJCF: links, joints, inertias, limits, actuators and the differences between them. Meshes: OBJ, STL, glTF; units, winding and watertightness. Convex decomposition for collision and tetrahedralization for FEM. Physical plausibility checks on inertias."},
  EngRow.{number = 36, status = 2, title = "Record and replay a world", part = "Physics", folder = "",
    source = "",
    summary = "What a recording must contain to be reproducible: scene asset digests, the schedule, profiles, seeds, controls and the compiler identity. State snapshots and their format. Recomputation replay, and comparing it against recorded states. Finding the first divergent step and stage."},
  EngRow.{number = 37, status = 2, title = "Measure the engine honestly", part = "Physics", folder = "",
    source = "",
    summary = "The compatibility matrix as published data: what combinations exist. An acceptance suite: every chapter's oracles, run per backend and profile. Benchmark methodology: scenes, warm-up, compile and startup time, per-environment and aggregate throughput, and variance. Comparison with other engines..."},
  EngRow.{number = 38, status = 2, title = "Stream a large world", part = "Big worlds", folder = "",
    source = "",
    summary = "World cells and their content-hashed packs. Interest: distance rings for loading, simulating and drawing, with hysteresis. A floating origin, so far positions stay precise. Sleeping and waking physics at a cell's edge. Loading on a budget, ahead of need, without blocking a frame."},
  EngRow.{number = 39, status = 1, title = "Ephemerides, time scales and frames", part = "Big worlds", folder = "space",
    source = "metaverse-engine/space/ephemeris.coax|metaverse-engine/space/frames.coax|metaverse-engine/space/fixtures/horizons.coax|metaverse-engine/examples/read-an-ephemeris.coax",
    summary = "Reading a pinned ephemeris (Horizons vector tables first, then one SPICE SPK segment type) with its time scale, frame, centre, units, dataset version and coverage recorded. TAI, TT, TDB and UTC, and converting through a pinned leap-second table. Full state transforms between barycentric..."},
  EngRow.{number = 40, status = 2, title = "Propagate with a stated error", part = "Big worlds", folder = "",
    source = "",
    summary = "Analytic two-body coasts, patched conics with sphere-of-influence handoff, and restricted n-body dynamics with chapter 39's bodies as sources and vessels as test particles. Fixed-step RK4, symplectic leapfrog and higher-order compositions, and adaptive Dormand–Prince 5(4). Error budgets per..."},
  EngRow.{number = 41, status = 2, title = "Burns consume mass", part = "Big worlds", folder = "",
    source = "",
    summary = "Thrust from mass flow and exhaust speed, F = ṁ v_e. Separate accounts for energy source, reaction mass, coolant and consumables. Jet power P = F v_e / 2, which ties thrust, exhaust speed and power. Torque from off-centre thrust, and attitude with inertia recomputed as mass moves...."},
  EngRow.{number = 42, status = 2, title = "Reach a moving target", part = "Big worlds", folder = "",
    source = "",
    summary = "Lambert solutions as initial guesses. The ideal constant-acceleration benchmark. Finite-thrust direct shooting and collocation. Path constraints: crew acceleration, propellant reserve, exclusion zones. Gravity assists as flybys whose energy change follows encounter geometry."},
  EngRow.{number = 43, status = 2, title = "Heat has to go somewhere", part = "Big worlds", folder = "",
    source = "",
    summary = "A lumped thermal network: drive, power, electronics, occupied spaces, heat sinks and radiators as nodes. Radiative rejection and its fourth-power law. Finite sinks and expendable coolant. Declaring hypothetical propulsion heat as a model, never an assumption."},
  EngRow.{number = 44, status = 2, title = "Inside a turning, accelerating ship", part = "Big worlds", folder = "",
    source = "",
    summary = "Proper acceleration as the floor, and why planetary gravity is not added to an interior in free fall. Rotating-frame dynamics: Coriolis, centrifugal and Euler terms. Spin habitats, foot attachment, and loose objects through a turn. A compartment model of pressure, volume and leaks. A bounded..."},
  EngRow.{number = 45, status = 2, title = "Sensors that see the past", part = "Big worlds", folder = "",
    source = "",
    summary = "Truth, emitted signal, received measurement and estimated track as four kinds of data. The light-time solution, round-trip radar and command latency. Detection from sensitivity, geometry, background and emission. A track filter whose uncertainty grows with age and maneuverability. Stamped..."},
  EngRow.{number = 46, status = 2, title = "Time warp that stops for every event", part = "Big worlds", folder = "",
    source = "",
    summary = "Event functions and root finding over a propagation step. Swept time of impact with curvature refinement. Splitting a long step at the earliest root. Replay at omniscient and observation levels. Why per-participant warp cannot exist inside one shared encounter."},
  EngRow.{number = 47, status = 2, title = "Hits through layers", part = "Big worlds", folder = "",
    source = "",
    summary = "A ship as a graph of compartments and components. Penetration through layers (sacrificial bumper, rear wall, structure, components) from relative velocity, projectile mass and shape, incidence and material. Response tables fitted to ballistic-limit equations, with refusal outside their range...."},
  EngRow.{number = 48, status = 2, title = "One world at three fidelities", part = "Big worlds", folder = "",
    source = "",
    summary = "Fidelity profiles: engineering baseline, game and teaching presentation. Typed rule modules that declare the objects and laws they change. Provenance on every tunable: explicit, inferred or invented, with unit and source. Batched rollouts, learned surrogates, and admitting a scenario as a..."},
  EngRow.{number = 49, status = 1, title = "Rooms and presence", part = "Big worlds", folder = "session",
    source = "coax/web/room/room.coax|metaverse-engine/net/profile.coax|metaverse-engine/session/party.coax|metaverse-engine/session/travel.coax",
    summary = "A room groups players under one simulation owner. Everglade clients send commands over a socket; the server steps the world and sends accepted state. An HTTP presence poll is not Everglade's simulation path."},
  EngRow.{number = 50, status = 1, title = "Lockstep for small deterministic games", part = "Big worlds", folder = "net",
    source = "apps/openagents-web/lockroom.coax|metaverse-engine/net/profile.coax",
    summary = "Lockstep sends orders instead of authoritative state. Each peer waits for commits, applies orders in the same sequence and compares state hashes. lockroom.coax supplies commits, orders, hash checks and snapshot repair; Belt 2200 uses it through belt-lockstep.coax. The guarantee needs the same..."},
  EngRow.{number = 51, status = 1, title = "A realm is a document", part = "Making worlds: OpenAgents Metaverse Engine", folder = "state",
    source = "metaverse-engine/editor/doc.coax|metaverse-engine/editor/edit.coax|metaverse-engine/examples/read-a-realm.coax|metaverse-engine/state/declarations.coax",
    summary = "A realm as a versioned document with an identity: a kind, a version, a revision and a hash. Reading a document into typed state with bounds, in whole units, so the same document is the same bytes on every device. Moving an older version forward, and refusing a newer one whole instead of..."},
  EngRow.{number = 52, status = 1, title = "Edit a realm in place", part = "Making worlds: OpenAgents Metaverse Engine", folder = "state",
    source = "metaverse-engine/editor/edit.coax|metaverse-engine/examples/edit-a-realm.coax|metaverse-engine/state/declarations.coax|metaverse-engine/state/lifecycle.coax",
    summary = "An edit as an operation over chapter 51's document, with its inverse. Why an edit is refused when its target no longer holds its before. Undo and redo as a position in a log of operations. Why a save names the revision it was read at."},
  EngRow.{number = 53, status = 1, title = "Bring in assets", part = "Making worlds: OpenAgents Metaverse Engine", folder = "editor",
    source = "metaverse-engine/editor/pack.coax|metaverse-engine/host/pack-table.coax|metaverse-engine/examples/bring-in-assets.coax|metaverse-engine/tools/pack-check.coax",
    summary = "Packing many assets into one streamed file with a table, a catalog and a budget. A licence on every asset, from its source, refused when it is missing or doesn't match its catalog line. Reading untrusted bytes whole: every field checked before anything is kept, and a refusal that names what it..."},
  EngRow.{number = 54, status = 1, title = "Publish a realm", part = "Making worlds: OpenAgents Metaverse Engine", folder = "editor",
    source = "apps/openagents-web/myrealm.coax|metaverse-engine/editor/publish.coax|metaverse-engine/examples/publish-a-realm.coax",
    summary = "A realm as four things: its world on the galaxy, its module, its assets, its save slot. A publish record: document hash, module build identity, asset hashes, golden and page text. Release gates per realm, compared against production first, so a release is stopped only by a regression it causes...."},
  EngRow.{number = 55, status = 1, title = "Fork a realm", part = "Making worlds: OpenAgents Metaverse Engine", folder = "editor",
    source = "metaverse-engine/editor/doc.coax|metaverse-engine/editor/edit.coax|metaverse-engine/examples/fork-a-realm.coax",
    summary = "A fork as (parent revision, edit log): it starts as its parent's realm and replays from it. Provenance: forked from what, at which revision, chained through forks of forks. Isolation: a fork's edits and saves never reach its parent. Rules as switches the base declares, refused when it doesn't."},
  EngRow.{number = 56, status = 1, title = "The Grid", part = "Realms", folder = "",
    source = "metaverse/gridwalk.coax|metaverse-engine/examples/walk-the-grid.coax",
    summary = "Composing a realm's session from the foundations: one clock, typed actions, the walking controller, the camera, replay. Keys and two thumbs saying the same thing as one Intent per frame. A session that records itself and replays exactly, with the first step that differs found when it doesn't."},
  EngRow.{number = 57, status = 2, title = "Made realms", part = "Realms", folder = "",
    source = "",
    summary = "A realm as data played by one shared module. Composition for a first-time visitor: what was asked for, in view from the spawn, on a phone too. Four cameras over one controller: third person, first person, top-down and 2D side-on. Characters who talk, from the document's names, roles and lore."},
