// Crates' public objective contract and a bounded keyboard/touch player.
// The waypoints describe the visible rooms, as a walkthrough does. Feedback
// is read-only own-frame diagnostics; all effects use the ordinary input path.
// This is labelled diagnostic-assisted evidence, separate from vision exploration.
PcStep :: struct {push:bool;way:int;a:f64;b:f64;}
pc_go :: (col:f64,row:f64)->PcStep {return PcStep.{a=col,b=row};}
pc_push :: (way:int,crate:int,to:f64)->PcStep {return PcStep.{push=true,way=way,a=cast(f64)crate,b=to};}
pc_axis :: (delta:f64,speed:f64)->int {
  if abs(delta)>55 || (abs(delta)>8 && speed<60) {return ifx delta>0 then 1 else -1;}return 0;
}
#test "crate player brakes near a waypoint and bounds every pulse" {
  #assert pc_axis(70,300)==1 && pc_axis(-70,300)==-1;
  #assert pc_axis(40,300)==0 && pc_axis(40,10)==1 && pc_axis(5,0)==0;
}
PcFrame :: struct {x:f64;z:f64;room:int;cleared:int;lit:int;gate:int;resets:int;sequence:int;time:int;box:[3][4]f64;ok:bool;}
pt_cr_frame :: (p:[]Pt)->PcFrame {
  f:PcFrame;r:=ifx p[0].driver==0 then pb_read(p[0].c[..],"globalThis.gamebuilderObservation") else wd_read(p[0].wd[..],"globalThis.gamebuilderObservation");if r<0 {return f;}
  d:=ifx p[0].driver==0 then cdp_doc(p[0].c[..]) else p[0].wd[0].doc[0];
  f.ok=pt_frame_valid(d,r) && pt_frame_tick(p[0].health[..],jv_int(d,jv_get(d,r,"sequence"),0),proc_now_ms()) && jv_kind(d,r)==JV_OBJECT && jv_int(d,jv_get(d,r,"game_type"),-1)==5 && jv_get(d,r,"room")>=0;
  f.x=cast(f64)jv_int(d,jv_get(d,r,"x_cm"),-99999);f.z=cast(f64)jv_int(d,jv_get(d,r,"z_cm"),-99999);
  f.room=jv_int(d,jv_get(d,r,"room"),-1);f.cleared=jv_int(d,jv_get(d,r,"rooms_cleared"),-1);f.lit=jv_int(d,jv_get(d,r,"pads_lit"),-1);f.gate=jv_int(d,jv_get(d,r,"gate_open"),-1);f.resets=jv_int(d,jv_get(d,r,"room_resets"),-1);f.sequence=jv_int(d,jv_get(d,r,"sequence"),0);f.time=jv_int(d,jv_get(d,r,"time_ms"),0);
  names:=[12]string.["crate0_x_cm","crate0_z_cm","crate0_vx_cm","crate0_vz_cm","crate1_x_cm","crate1_z_cm","crate1_vx_cm","crate1_vz_cm","crate2_x_cm","crate2_z_cm","crate2_vx_cm","crate2_vz_cm"];
  for i:0..<12 {f.box[i/4][i%4]=cast(f64)jv_int(d,jv_get(d,r,names[i]),0);}return f;
}
pt_cr_pulse :: (p:[]Pt,dx:int,dz:int,ms:int,pushing:bool)->bool {
  if ms<0 || ms>150 {return false;}_:=pb_heartbeat(pt_dir(p));
  if p[0].touch {
    if dx==0 && dz==0 {return pb_wait(pt_dir(p),ms+150);}
    // A light thumb push gives fine control near a pad. Full-radius pulses
    // accelerate too far during real browser event latency and overshoot.
    w:=cast(int)pt_number(p,"innerWidth",0);h:=cast(int)pt_number(p,"innerHeight",0);points:=[1]PbContact.[PbContact.{id=1,x=w/4,y=h*3/5}];
    // A tiny walking correction cannot overcome a heavy crate's static
    // friction. Keep a useful thumb force while shortening the push duration.
    if !pb_touch(p[0].c[..],"touchStart",points[..]) {return false;}_:=pb_wait(pt_dir(p),20);strength:=ifx ms<=25 && !pushing then 5 else 18;points[0].x+=dx*strength;points[0].y-=dz*strength;
    moved:=pb_touch(p[0].c[..],"touchMove",points[..]);_=pb_wait(pt_dir(p),ms);up:=pb_touch(p[0].c[..],"touchEnd",points[..]);_=pb_wait(pt_dir(p),150);return moved && up;
  }
  keys:=[4]string.["a","d","s","w"];codes:=[4]string.["KeyA","KeyD","KeyS","KeyW"];held:=[4]bool.[dx<0,dx>0,dz<0,dz>0];ok:=true;
  for i:0..<4 {if held[i] {ok=pt_key(p,keys[i],codes[i],true) && ok;}}
  _:=pb_wait(pt_dir(p),ms);
  for i:0..<4 {if held[i] {ok=pt_key(p,keys[i],codes[i],false) && ok;}}
  _:=pb_wait(pt_dir(p),100);return ok;
}
pt_cr_goto :: (p:[]Pt,room:int,tx:f64,tz:f64)->bool {
  f:=pt_cr_frame(p);last:=f;speed:f64=0;end:=proc_now_ms()+18000;stale:=0;
  while f.ok && proc_now_ms()<end {
    if f.room!=room {return true;}
    dx:=tx-f.x;dz:=tz-f.z;
    tolerance:f64=ifx p[0].touch then 28 else 12;
    if abs(dx)<tolerance && abs(dz)<tolerance && speed<35 {return true;}
    ax:=pc_axis(dx,speed);az:=pc_axis(dz,speed);
    near:=abs(dx)<65 && abs(dz)<65;
    if !pt_cr_pulse(p,ax,az,ifx near then 25 else 100,false) {return false;}
    last=f;f=pt_cr_frame(p);dt:=f.time-last.time;
    if dt<=0 {stale+=1;if stale>10 {return false;}}else {stale=0;speed=(abs(f.x-last.x)+abs(f.z-last.z))*1000/cast(f64)dt;}
  }
  _:=pt_observe(p);return false;
}
pt_cr_step :: (p:[]Pt,room:int,s:PcStep)->bool {
  cols:=ifx room==0 then 7 else ifx room==1 then 8 else 9;rows:=ifx room==0 then 5 else 7;
  if !s.push {return pt_cr_goto(p,room,(s.a-cast(f64)(cols-1)*0.5)*150,(cast(f64)(rows-1)*0.5-s.b)*150);}
  k:=cast(int)s.a;f:=pt_cr_frame(p);if !f.ok || k<0 || k>2 {return false;}
  vertical:=s.way<2;
  if !pt_cr_goto(p,room,ifx vertical then f.box[k][0] else f.x,ifx vertical then f.z else f.box[k][1]) {return false;}
  target:=ifx vertical then (cast(f64)(rows-1)*0.5-s.b)*150 else (s.b-cast(f64)(cols-1)*0.5)*150;
  end:=proc_now_ms()+15000;reached:=false;
  while proc_now_ms()<end {
    f=pt_cr_frame(p);if !f.ok {return false;}if f.room!=room {return true;}
    pos:=f.box[k][ifx vertical then 1 else 0];v:=ifx vertical then f.box[k][3] else f.box[k][2];
    left:=ifx s.way==0 || s.way==3 then target-pos else pos-target;
    // Release before inertia carries the crate onto the pad. Units are cm.
    if left<(ifx p[0].touch then 25.0 else 5.0)+v*v/(2*0.5*981) {reached=true;break;}
    if !pt_cr_pulse(p,ifx s.way==2 then -1 else ifx s.way==3 then 1 else 0,ifx s.way==0 then 1 else ifx s.way==1 then -1 else 0,ifx left<40 then 25 else 80,true) {return false;}
  }
  _:=pb_wait(pt_dir(p),700);_=pt_observe(p);return reached;
}
pt_cr_room :: (p:[]Pt,room:int,steps:[]PcStep)->bool {
  for i:0..<steps.count {if pt_cr_frame(p).room!=room {break;}ok:=pt_cr_step(p,room,steps[i]);f:=pt_cr_frame(p);b:[2048]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"game");jo_str(o[..],GT_ID[GT_CRATES]);jo_key(o[..],"room");jo_int(o[..],room+1);jo_key(o[..],"waypoint");jo_int(o[..],i+1);jo_key(o[..],"x_cm");jo_int(o[..],cast(int)f.x);jo_key(o[..],"z_cm");jo_int(o[..],cast(int)f.z);jo_key(o[..],"boxes");jo_arr(o[..]);for box:f.box {jo_arr(o[..]);for value:box {jo_int(o[..],cast(int)value);}jo_end(o[..]);}jo_end(o[..]);jo_key(o[..],"ok");jo_bool(o[..],ok);jo_end(o[..]);path:[4096]u8;_=fs_append(pt_path(p,"measurements.jsonl",path[..]),jo_text(o[..]));_=fs_append(pt_path(p,"measurements.jsonl",path[..]),"\n");pt_event(p,"crate-waypoint","ordinary input walkthrough",ok);if !ok {print("crates room % waypoint % failed\n",room+1,i+1);_=pt_shot(p,"crates-stuck.png");return false;}}
  _:=pb_wait(pt_dir(p),500);f:=pt_cr_frame(p);return f.ok && f.cleared==room+1 && f.room==(room+1)%3;
}
pt_crates :: (p:[]Pt) {
  entered:=pt_picker(p) && pt_enter(p,5);_=pt_shot(p,"crates.png");f:=pt_cr_frame(p);
  initial:=entered && f.ok && f.room==0 && f.lit==0 && f.gate==0 && f.cleared==0;
  moved:=pt_hold(p,"d","KeyD",700);_=pb_wait(pt_dir(p),500);pushed:=pt_cr_frame(p).box[0][0]>f.box[0][0]+30;
  nojump:=pt_press(p," ","Space") && pt_bool(p,"globalThis.gamebuilderObservation?.y_cm===0 && globalThis.gamebuilderObservation?.flying===0");
  pt_result(p,"world.crates",initial && moved && pushed && nojump);
  reset:=ifx p[0].touch then pt_tap(p,"hot.s.0") else pt_press(p,"r","KeyR");_=pb_wait(pt_dir(p),3000);again:=pt_cr_frame(p);
  pt_result(p,"game.crates.reset",reset && again.resets==f.resets+1 && abs(again.x-f.x)<5 && abs(again.z-f.z)<5 && abs(again.box[0][0]-f.box[0][0])<5 && again.gate==0);
  r0:=[7]PcStep.[pc_push(3,0,4),pc_go(3,3),pc_go(4,3),pc_push(0,0,1),pc_go(5,1.6),pc_go(5,2),pc_go(7.3,2)];
  r1:=[9]PcStep.[pc_go(1,1),pc_go(2,1),pc_push(1,0,4),pc_go(1,3.5),pc_go(1,5),pc_go(5,5),pc_push(0,1,2),pc_go(6,3),pc_go(8.3,3)];
  r2:=[31]PcStep.[pc_push(3,1,6),pc_go(5,3),pc_go(5,4),pc_go(6,4),pc_push(0,1,1),pc_go(5,2),pc_go(5,3),pc_go(3,3),pc_go(3,1),pc_go(2,1),pc_push(1,0,3),pc_go(1,2.5),pc_go(1,3),pc_push(3,0,6),pc_go(5,3),pc_go(5,2),pc_go(6,2),pc_push(1,0,5),pc_go(5,4),pc_go(5,3),pc_go(3,3),pc_go(3,5),pc_go(2,5),pc_push(0,2,3),pc_go(1,3.5),pc_go(1,3),pc_push(3,2,6),pc_go(5,2),pc_go(7,2),pc_go(7,3),pc_go(9.3,3)];
  solved:=pt_cr_room(p,0,r0[..]);if solved {_:=pb_wait(pt_dir(p),3500);solved=pt_cr_room(p,1,r1[..]);}if solved {_:=pb_wait(pt_dir(p),3500);solved=pt_cr_room(p,2,r2[..]);}
  _:=pt_shot(p,"crates-objective.png");returned:=pt_picker(p) && pt_enter(p,0);pt_result(p,"game.crates.objective",solved && returned && pt_bool(p,"document.getElementById('hot.s.0')?.getBoundingClientRect().width>0"));
}
