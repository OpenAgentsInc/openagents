// Pure control and public circuit data; no live effect or game-state mutation.
#load "../../web/world-racing.coax";
RaceFrame :: struct {ok:bool;sequence:int;x:f32;z:f32;s:f32;hint:int;fx:f32;fz:f32;speed:f32;lap:int;gate:int;backs:int;clock:int;best:int;light:int;done:bool;}
prc_command :: (error:[]f32,value:f32)->int {error[0]+=value;if error[0]>0.5 {error[0]-=1;return 1;}if error[0]< -0.5 {error[0]+=1;return -1;}return 0;}
#test "digital steering approximates an analog request without unbounded holds" {
  e:[1]f32;n:=0;for i:0..<20 {n+=prc_command(e[..],0.3);}#assert n==6 && abs(e[0])<0.01;
}
