// Every export the app's core has is accounted for (docs/programmatic-access.md, "Drift
// checks"): each `ed_` function marked #export_c in the files given is named in a command
// row's impl, or in GB_PLUMBING (coax/controls.coax), and not in both; and every ed_ name those name is an export that exists. So a new export the host
// calls is a row's, or it says why it is not.
//
// And the hosts go through the rows (docs/programmatic-access.md, "Drift checks"): each host
// file given after --host (host/Sources/*.swift, host/linux/main.c, host/panel/*) names only
// the ways in (ed_command, ed_lobby_command, the controls: GB_PLUMBING), what the screen draws
// (GB_PLUMBING, and a read row's impl), and the impl of a row whose control the host carries out
// (GB_HOST_DECIDE, GB_HOST_NEW_GAME, GB_HOST_FILE: Decide's request, New Game's picker, the file
// a row said to open). A host that calls an action row's export itself, past its row, fails here.
// A tool, not a #test: a check cannot read a file. scripts/check.sh runs it; it prints what
// does not hold and ends 1, or "commands: ok" and 0.
//   coax/web/tool.sh tools/commands-check.coax gamebuilder/core/*.coax --host host/Sources/*.swift host/linux/main.c host/panel/*
// tool.sh: run-steps 100000000
#load "../../coax/lib/sys/tool.coax";
#load "../core/controls.coax";
#load "../../coax/lib/sys/fs.coax";
#import "Basic";

CC_EXPORTS :: 512;
CC_NAME :: 64;
CcCheck :: struct {
  text: [1048576] u8;
  names: [CC_EXPORTS * CC_NAME] u8; name_n: [CC_EXPORTS] int; n: int;
}

CcText :: struct { text: [1048576] u8; }
cc_name :: (c: [] CcCheck, i: int) -> string { return cast(string) c[0].names[i * CC_NAME..<i * CC_NAME + c[0].name_n[i]]; }
cc_has :: (c: [] CcCheck, name: string) -> bool {
  for i: 0..<c[0].n { if cc_name(c, i) == name { return true; } }
  return false;
}
// The exports in one file's text: a line that starts "ed_NAME ::" and is marked #export_c.
cc_scan :: (c: [] CcCheck, text: string) -> bool {
  from := 0;
  for i: 0..<text.count + 1 {
    if i < text.count && text[i] != '\n' { continue; }
    line := cast(string) text[from..<i]; from = i + 1;
    if line.count < 4 || line[0] != 'e' || line[1] != 'd' || line[2] != '_' || level_find(line, "#export_c") < 0 { continue; }
    cut := 0; while cut < line.count && line[cut] != ' ' { cut += 1; }
    if cut + 3 > line.count || line[cut + 1] != ':' || line[cut + 2] != ':' { continue; }
    if cut > CC_NAME || c[0].n >= CC_EXPORTS { return false; }
    for k: 0..<cut { c[0].names[c[0].n * CC_NAME + k] = line[k]; }
    c[0].name_n[c[0].n] = cut; c[0].n += 1;
  }
  return true;
}
// How many of the two name it: the rows' impl (any number of rows may share an export), and
// GB_PLUMBING.
cc_named :: (name: string) -> int {
  row := 0; plumbing := 0;
  for r: GB_COMMANDS { for k: 0..<gb_parts(r.impl) { if gb_part(r.impl, k) == name { row = 1; } } }
  for p: GB_PLUMBING { if p == name { plumbing += 1; } }
  return row + plumbing;
}
// Whether a host may name export name itself (-1), and when not, the row whose way in it skips:
// it may when the export is plumbing, or a row that names it is a read or carried out by the host.
cc_host_may :: (name: string) -> int {
  for p: GB_PLUMBING { if p == name { return -1; } }
  skipped := -1;
  for v: 0..<GB_N {
    r := GB_COMMANDS[v];
    named := false;
    for k: 0..<gb_parts(r.impl) { if gb_part(r.impl, k) == name { named = true; } }
    if !named { continue; }
    if r.effect == "read" { return -1; }
    carried := false;
    for c: GB_CONTROLS { if c.verb == v && (c.host == GB_HOST_DECIDE || c.host == GB_HOST_NEW_GAME || c.host == GB_HOST_FILE) { carried = true; } }
    if carried { return -1; }
    if skipped < 0 { skipped = v; }
  }
  return skipped;
}
cc_word :: (ch: u8) -> bool { return (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '_' || (ch >= 'A' && ch <= 'Z'); }
// The host file's words that are exports, each checked: how many it names past their rows.
cc_host :: (c: [] CcCheck, file: string, text: string) -> int {
  bad := 0; i := 0;
  while i < text.count {
    if text[i] == 'e' && i + 3 < text.count && text[i + 1] == 'd' && text[i + 2] == '_' && (i == 0 || !cc_word(text[i - 1])) {
      j := i; while j < text.count && cc_word(text[j]) { j += 1; }
      name := cast(string) text[i..<j];
      if cc_has(c, name) {
        v := cc_host_may(name);
        if v >= 0 { print("commands: NOT a row's way in: % names %, the % row's: run it through ed_command\n", file, name, GB_COMMANDS[v].verb); bad += 1; }
      }
      i = j; continue;
    }
    i += 1;
  }
  return bad;
}
cc_is_export_name :: (s: string) -> bool { return s.count > 3 && s[0] == 'e' && s[1] == 'd' && s[2] == '_'; }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; bad := 0;
  if !args_load(a[..]) || args_count(a[..]) < 1 { print("usage: tool.sh tools/commands-check.coax gamebuilder/core/*.coax\n"); return 2; }
  c: [1] CcCheck;
  hosts := args_count(a[..]);
  for f: 0..<args_count(a[..]) { if args_at(a[..], f) == "--host" { hosts = f; } }
  for f: 0..<hosts {
    n := fs_read(args_at(a[..], f), c[0].text[..]);
    if n < 0 || n >= c[0].text.count { print("commands: NOT read %\n", args_at(a[..], f)); bad += 1; continue; }
    if !cc_scan(c[..], cast(string) c[0].text[0..<n]) { print("commands: NOT more than % exports\n", CC_EXPORTS); return 1; }
  }
  for i: 0..<c[0].n {
    name := cc_name(c[..], i); k := cc_named(name);
    if k == 0 { print("commands: NOT accounted for: % (a row's impl, or GB_PLUMBING in gamebuilder/core/controls.coax)\n", name); bad += 1; }
    if k > 1 { print("commands: NOT in one place only: %\n", name); bad += 1; }
  }
  // what the lists name exists (a row's impl may name more than exports: a route, a file)
  for r: GB_COMMANDS {
    for k: 0..<gb_parts(r.impl) {
      p := gb_part(r.impl, k);
      if cc_is_export_name(p) && !cc_has(c[..], p) { print("commands: NOT an export: % (the % row's impl)\n", p, r.verb); bad += 1; }
    }
  }
  for p: GB_PLUMBING { if !cc_has(c[..], p) { print("commands: NOT an export: % (GB_PLUMBING)\n", p); bad += 1; } }
  // the hosts: only the ways in, and what is drawn
  files := 0;
  for f: hosts + 1..<args_count(a[..]) {
    ht: [1] CcText;
    n := fs_read(args_at(a[..], f), ht[0].text[..]);
    if n < 0 || n >= ht[0].text.count { print("commands: NOT read %\n", args_at(a[..], f)); bad += 1; continue; }
    bad += cc_host(c[..], args_at(a[..], f), cast(string) ht[0].text[0..<n]);
    files += 1;
  }
  if bad > 0 { return 1; }
  print("commands: ok, % exports, % host files through the rows\n", c[0].n, files);
  return 0;
}
