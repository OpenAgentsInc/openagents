// Publish an immutable, same-origin qualification snapshot. Public game files
// only; evidence, accounts and credentials never enter this staging directory.
// tool.sh: tls
// tool.sh: stack-gib 2
#load "../tests/player/provenance.coax";
#load "../../coax/lib/net/http.coax";
#load "../../coax/lib/sys/tool.coax";
#import "Basic";
PR_BUCKET :: "gs://openagentsgemini-gamebuilder-player-releases";
PR_BACKEND :: "https://www.googleapis.com/compute/v1/projects/openagentsgemini/global/backendBuckets/gamebuilder-player-releases";
pr_command :: (args:[]string,out:[]u8)->bool {err:[4096]u8;for i:0..<out.count {out[i]=0;}r:=proc_run(args,120000,out,err[..]);if r.status!=0 || r.timed_out {tool_errln("snapshot cloud operation failed; no credentials or response bodies logged");return false;}return true;}
pr_name :: (s:string)->bool {if s.count<1 || s.count>64 {return false;}for c:s {if !((c>='a'&&c<='z')||(c>='0'&&c<='9')||c=='-') {return false;}}return true;}
pr_replace :: (s:string,needle:string,value:string,out:[]u8)->int {
  if needle.count==0 {return -1;}i:=0;n:=0;while i<s.count {if i+needle.count<=s.count && s[i..<i+needle.count]==needle {n=ws_put(out,n,value);i+=needle.count;}else {if n<0 || n>=out.count {return -1;}out[n]=s[i];n+=1;i+=1;}if n<0 {return -1;}}return n;
}
pr_setup :: (dir:string)->bool {
  out:[65536]u8;small:[1024]u8;
  exists:=[7]string.["gcloud","storage","buckets","describe",PR_BUCKET,"--project=openagentsgemini","--format=json"];
  if !pr_command(exists[..],out[..]) {create:=[8]string.["gcloud","storage","buckets","create",PR_BUCKET,"--project=openagentsgemini","--location=US","--uniform-bucket-level-access"];if !pr_command(create[..],out[..]) {return false;}}
  public:=[8]string.["gcloud","storage","buckets","add-iam-policy-binding",PR_BUCKET,"--member=allUsers","--role=roles/storage.objectViewer","--project=openagentsgemini"];if !pr_command(public[..],out[..]) {return false;}
  website:=[8]string.["gcloud","storage","buckets","update",PR_BUCKET,"--web-error-page=404.html","--project=openagentsgemini","--quiet"];if !pr_command(website[..],out[..]) {return false;}
  backend:=[7]string.["gcloud","compute","backend-buckets","describe","gamebuilder-player-releases","--project=openagentsgemini","--format=json"];
  if !pr_command(backend[..],out[..]) {create:=[8]string.["gcloud","compute","backend-buckets","create","gamebuilder-player-releases","--gcs-bucket-name=openagentsgemini-gamebuilder-player-releases","--project=openagentsgemini","--enable-cdn"];if !pr_command(create[..],out[..]) {return false;}}
  // Read-modify-write the current URL map: preserve every existing host, API,
  // redirect and route; add only the snapshot prefix to the existing matcher.
  get:=[8]string.["gcloud","compute","url-maps","describe","gamebuilder-web","--global","--project=openagentsgemini","--format=json"];
  if !pr_command(get[..],out[..]) {return false;}length:=0;while length<out.count && out[length]!=0 {length+=1;}d:[1]Jv;nodes:[8192]JvNode;if !jv_parse(d[..],cast(string)out[0..<length],nodes[..]) {return false;}
  body:[65536]u8;o:[1]Jo;jo_start(o[..],body[..]);jo_obj(o[..]);found:=false;present:=false;
  for i:0..<jv_len(d[0],0) {v:=jv_at(d[0],0,i);key:=jv_key(d[0],v);if key=="id" || key=="creationTimestamp" || key=="selfLink" || key=="kind" {continue;}jo_key(o[..],key);
    if key!="pathMatchers" {jv_write(d[0],v,o[..]);continue;}jo_arr(o[..]);
    for j:0..<jv_len(d[0],v) {matcher:=jv_at(d[0],v,j);if jv_raw(d[0],jv_get(d[0],matcher,"name"))!="site" {jv_write(d[0],matcher,o[..]);continue;}found=true;jo_obj(o[..]);
      for k:0..<jv_len(d[0],matcher) {field:=jv_at(d[0],matcher,k);name:=jv_key(d[0],field);jo_key(o[..],name);if name!="pathRules" {jv_write(d[0],field,o[..]);continue;}jo_arr(o[..]);
        for q:0..<jv_len(d[0],field) {rule:=jv_at(d[0],field,q);paths:=jv_get(d[0],rule,"paths");for x:0..<jv_len(d[0],paths) {if jv_raw(d[0],jv_at(d[0],paths,x))=="/player-releases/*" {if jv_raw(d[0],jv_get(d[0],rule,"service"))!=PR_BACKEND {return false;}present=true;}}jv_write(d[0],rule,o[..]);}
        if !present {jo_obj(o[..]);jo_key(o[..],"paths");jo_arr(o[..]);jo_str(o[..],"/player-releases/*");jo_end(o[..]);jo_key(o[..],"service");jo_str(o[..],PR_BACKEND);jo_end(o[..]);}jo_end(o[..]);
      }jo_end(o[..]);
    }jo_end(o[..]);
  }jo_end(o[..]);if !found || o[0].bad {return false;}if present {return true;}
  path:[4096]u8;file:=fs_join(dir,"snapshot-url-map.json",path[..]);if !fs_write(file,jo_text(o[..])) {return false;}
  option:[4200]u8;n:=ws_put(option[..],0,"--source=");n=ws_put(option[..],n,file);validate:=[9]string.["gcloud","compute","url-maps","validate","--global","--project=openagentsgemini","--load-balancing-scheme=EXTERNAL_MANAGED",cast(string)option[0..<n],"--quiet"];if !pr_command(validate[..],small[..]) {return false;}put:=[9]string.["gcloud","compute","url-maps","import","gamebuilder-web","--global","--project=openagentsgemini",cast(string)option[0..<n],"--quiet"];return pr_command(put[..],small[..]);
}
pr_files :: (root:string,rel:string,o:[]Jo)->bool {
  list:[1]FsList;path:[4096]u8;dir:=ifx rel.count==0 then root else fs_join(root,rel,path[..]);count:=fs_list(dir,list[..]);if count<0 {return false;}
  for i:0..<count {name:=fs_entry(list[..],i);if name.count==0 || name[0]=='.' {continue;}child:[4096]u8;file:=fs_join(dir,name,child[..]);sub:[4096]u8;key:=ifx rel.count==0 then name else fs_join(rel,name,sub[..]);
    if fs_kind(file)==FS_DIR {if !pr_files(root,key,o) {return false;}}else {bytes:[8388608]u8;hash:[64]u8;n:=fs_read(file,bytes[..]);if n<0 || !pt_sha(bytes[0..<n],hash[..]) {return false;}jo_key(o,key);jo_str(o,cast(string)hash[..]);}
  }return true;
}
// Upload the bare mount object explicitly: gcloud cp would otherwise treat an
// existing resource prefix as a directory and append index.html. The normal
// scoped publishing credential stays in memory and is never printed or stored.
pr_root :: (name:string,html:string)->bool {
  args:=[5]string.["gcloud","auth","print-access-token","--project=openagentsgemini","--quiet"];token:[4096]u8;err:[4096]u8;r:=proc_run(args[..],15000,token[..],err[..]);if r.status!=0 || r.out_n<1 {return false;}
  auth:[4200]u8;n:=ws_put(auth[..],0,"Authorization: Bearer ");n=ws_put(auth[..],n,http_trim(cast(string)token[0..<r.out_n]));headers:=[3]string.[cast(string)auth[0..<n],"Content-Type: text/html","Cache-Control: public,max-age=31536000,immutable"];
  url:[2048]u8;n=ws_put(url[..],0,"https://storage.googleapis.com/upload/storage/v1/b/openagentsgemini-gamebuilder-player-releases/o?uploadType=media&ifGenerationMatch=0&name=player-releases%2F");n=ws_put(url[..],n,name);work:[1]HttpWork;body:[65536]u8;reply:=http_do(work[..],"POST",cast(string)url[0..<n],headers[..],html,30000,0,body[..]);for i:0..<token.count {token[i]=0;}for i:0..<auth.count {auth[i]=0;}return reply.error==HTTP_OK && reply.code==200;
}
#test "snapshot names cannot target main, paths or credentials and rewriting is bounded" {
  #assert pr_name("phase1-20261117-abc123") && !pr_name("../main") && !pr_name("a/b") && !pr_name("a?token=x") && !pr_name("");b:[32]u8;n:=pr_replace("a/a/","a/","b/",b[..]);#assert n==4 && cast(string)b[0..<n]=="b/b/" && pr_replace("long","o","0123456789",b[0..<4])<0;
}
// The page as a release mounted under `mount` serves it: every address of the site's own that the
// page names (its script, its fonts and their preloads, its shaders, its pack) under the mount, the
// mount told to the page's two hosts (the script's own address for the page host, data-root for
// the GPU host), and search engines kept out. The new length, or -1.
PR_PAGE :: 131072;
pr_page :: (index:string,mount:string,out:[]u8)->int {
  a:[PR_PAGE]u8;b:[PR_PAGE]u8;value:[1024]u8;
  m:=ws_put(value[..],0,"<head>\n<meta name=\"robots\" content=\"noindex\">\n<meta name=\"coaxial-mount\" content=\"");m=ws_put(value[..],m,mount);m=ws_put(value[..],m,"\">");n:=pr_replace(index,"<head>",cast(string)value[0..<m],a[..]);if n<1 {return -1;}
  for field:[5]string.["src=\"/","href=\"/","data-wgsl=\"/","pack:/","url(/"] {m=ws_put(value[..],0,field[0..<field.count-1]);m=ws_put(value[..],m,mount);m=ws_put(value[..],m,"/");n=pr_replace(cast(string)a[0..<n],field,cast(string)value[0..<m],b[..]);if n<1 {return -1;}for q:0..<n {a[q]=b[q];}}
  m=ws_put(value[..],0,"root=coaxial-root&mount=");m=ws_put(value[..],m,mount);m=ws_put(value[..],m,"\"");n=pr_replace(cast(string)a[0..<n],"root=coaxial-root\"",cast(string)value[0..<m],b[..]);if n<1 {return -1;}for q:0..<n {a[q]=b[q];}
  m=ws_put(value[..],0,"data-app=\"hud\" data-wasm=\"");m=ws_put(value[..],m,mount);m=ws_put(value[..],m,"/build/hud.wasm\" data-root=\"");m=ws_put(value[..],m,mount);m=ws_put(value[..],m,"\"");n=pr_replace(cast(string)a[0..<n],"data-app=\"hud\"",cast(string)value[0..<m],b[..]);if n<1 || n>out.count {return -1;}
  for q:0..<n {out[q]=b[q];}return n;
}
#test "a mounted release's page: its script, fonts, shaders and pack under the mount, and the mount told to both hosts" {
  page:="<html><head>\n<link rel=\"preload\" href=\"/fonts/a.woff2\">\n<style>@font-face{src:url(/fonts/a.woff2)}</style></head><script type=\"module\" src=\"/host/app.js?app=site&root=coaxial-root\" data-app=\"hud\" data-wgsl=\"/build/hud.wgsl\" data-assets=\"pack:/assets/village.pack\"></script></html>";
  out:[4096]u8;n:=pr_page(page,"/player-releases/x1",out[..]);#assert n>0;got:=cast(string)out[0..<n];
  want:="<html><head>\n<meta name=\"robots\" content=\"noindex\">\n<meta name=\"coaxial-mount\" content=\"/player-releases/x1\">\n<link rel=\"preload\" href=\"/player-releases/x1/fonts/a.woff2\">\n<style>@font-face{src:url(/player-releases/x1/fonts/a.woff2)}</style></head><script type=\"module\" src=\"/player-releases/x1/host/app.js?app=site&root=coaxial-root&mount=/player-releases/x1\" data-app=\"hud\" data-wasm=\"/player-releases/x1/build/hud.wasm\" data-root=\"/player-releases/x1\" data-wgsl=\"/player-releases/x1/build/hud.wgsl\" data-assets=\"pack:/player-releases/x1/assets/village.pack\"></script></html>";
  #assert got==want;
}
pr_publish :: (stage:string,name:string,dir:string)->bool {
  if !pr_name(name) || !pr_setup(dir) {return false;}prefix:[256]u8;n:=ws_put(prefix[..],0,"/player-releases/");n=ws_put(prefix[..],n,name);mount:=cast(string)prefix[0..<n];
  index:[PR_PAGE]u8;a:[PR_PAGE]u8;path:[4096]u8;value:[1024]u8;m:=0;n=fs_read(fs_join(stage,"index.html",path[..]),index[..]);if n<1 || n>=PR_PAGE {return false;}
  n=pr_page(cast(string)index[0..<n],mount,a[..]);if n<1 || !fs_write(fs_join(stage,"index.html",path[..]),cast(string)a[0..<n]) {return false;}
  // The permission fixture must open this exact release, not main.
  for fixture_name:[2]string.["build/player-permission.html","build/player-focus.html"] {fixture:[4096]u8;fn:=fs_read(fs_join(stage,fixture_name,path[..]),fixture[..]);if fn<1 {return false;}m=ws_put(value[..],0,mount);m=ws_put(value[..],m,"?observe=1");fn=pr_replace(cast(string)fixture[0..<fn],"/?observe=1",cast(string)value[0..<m],a[..]);if fn<1 || !fs_write(fs_join(stage,fixture_name,path[..]),cast(string)a[0..<fn]) {return false;}}
  manifest:[131072]u8;o:[1]Jo;jo_start(o[..],manifest[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"gamebuilder.player.release.v1");jo_key(o[..],"name");jo_str(o[..],name);jo_key(o[..],"mount");jo_str(o[..],mount);jo_key(o[..],"deployment");catalog:[65536]u8;cn:=fs_read(fs_join(stage,"build/player-catalog.json",path[..]),catalog[..]);if cn<1 {return false;}d:[1]Jv;nodes:[4096]JvNode;if !jv_parse(d[..],cast(string)catalog[0..<cn],nodes[..]) {return false;}jv_write(d[0],0,o[..]);jo_key(o[..],"files");jo_obj(o[..]);if !pr_files(stage,"",o[..]) {return false;}jo_end(o[..]);jo_end(o[..]);if o[0].bad || !fs_write(fs_join(stage,"release.json",path[..]),jo_text(o[..])) {return false;}
  destination:[512]u8;n=ws_put(destination[..],0,PR_BUCKET);n=ws_put(destination[..],n,mount);dest:=cast(string)destination[0..<n];out:[4096]u8;err:[4096]u8;
  // Refuse every existing name, including a partial upload. No replacement or
  // deletion of a previously published qualification release is possible here.
  ls:=[5]string.["gcloud","storage","ls",dest,"--project=openagentsgemini"];check:=proc_run(ls[..],15000,out[..],err[..]);if check.status==0 {tool_errln("snapshot name already exists; choose a new immutable name");return false;}
  sync:=[9]string.["gcloud","storage","rsync",stage,dest,"--recursive","--cache-control=public,max-age=31536000,immutable","--project=openagentsgemini","--quiet"];if !pr_command(sync[..],out[..]) {return false;}
  // Shared routing scaffolding uses the product's ordinary 404 page. Each
  // release also retains its hashed copy; the snapshot assets stay immutable.
  error_page:=[9]string.["gcloud","storage","cp",fs_join(stage,"404.html",path[..]),"gs://openagentsgemini-gamebuilder-player-releases/404.html","--content-type=text/html","--cache-control=no-cache","--project=openagentsgemini","--quiet"];if !pr_command(error_page[..],out[..]) {return false;}
  root_html:[PR_PAGE]u8;hn:=fs_read(fs_join(stage,"index.html",path[..]),root_html[..]);if hn<1 || !pr_root(name,cast(string)root_html[0..<hn]) {return false;}
  metadata:=[8]string.["gcloud","storage","objects","update",dest,"--cache-control=public,max-age=31536000,immutable","--project=openagentsgemini","--quiet"];if !pr_command(metadata[..],out[..]) {return false;}
  for page:[3]string.["/login","/play","/credits"] {target:[1024]u8;tn:=ws_put(target[..],0,dest);tn=ws_put(target[..],tn,page);copy:=[9]string.["gcloud","storage","cp",fs_join(stage,"index.html",path[..]),cast(string)target[0..<tn],"--content-type=text/html","--cache-control=public,max-age=31536000,immutable","--project=openagentsgemini","--quiet"];if !pr_command(copy[..],out[..]) {return false;}}
  print("snapshot: https://gamebuilder.org%\n",mount);return true;
}
tool_main :: ()->int #export_c #effects(all) {a:[1]Args;if !args_load(a[..]) {return 2;}dir:=args_value(a[..],"--out","build/player-release");if !fs_mkdir_private(dir) {return 2;}return ifx pr_publish(args_at(a[..],0),args_at(a[..],1),dir) then 0 else 1;}
