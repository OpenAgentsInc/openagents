pt_worlds :: (p:[]Pt) {
  ids:=[8]string.["world.third-person","world.first-person","world.top-down","world.side-scroller","world.village","world.platformer","world.racing","world.drift"];
  shots:=[8]string.["third-person.png","first-person.png","top-down.png","side-scroller.png","village.png","platformer.png","racing.png","drift.png"];
