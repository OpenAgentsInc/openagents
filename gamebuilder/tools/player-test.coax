  if mode=="--merge" {return pt_merge(a[..]);}
  if mode=="--write-catalog" {return ifx pt_write_catalog(args_at(a[..],1)) then 0 else 1;}
  if mode=="--watchdog" {return pb_watchdog_for(args_at(a[..],1),args_at(a[..],2),5400000);}
  if mode=="--wd-watchdog" {return wd_watchdog(args_at(a[..],1),args_at(a[..],2),args_at(a[..],3));}
  if mode=="--wd-record" {return wd_record(args_at(a[..],1),args_at(a[..],2),args_at(a[..],3));}
  if mode=="--hang-input" {c:[1]Cdp;if !cdp_connect(c[..],args_at(a[..],1)) {return 1;}_:=pb_key(c[..],"w","KeyW",true);proc_sleep(30000);return 1;}
  if mode=="--selftest" {return pt_conformance(args_value(a[..],"--out","build/player-tests/conformance"));}
  if mode=="--gpu-selftest" {return pt_gpu_faults(args_at(a[..],1),args_value(a[..],"--out","build/player-tests/gpu-conformance"));}
  if mode=="--wd-selftest" {return pt_wd_conformance(args_at(a[..],1),args_value(a[..],"--webdriver","http://127.0.0.1:4445"),args_value(a[..],"--capabilities",""),args_value(a[..],"--fixture-url",""));}
  if mode=="--telemetry" {return pt_telemetry(args_at(a[..],1),args_at(a[..],2));}
  if mode=="--record" {return pb_record_limited(args_at(a[..],1),args_at(a[..],2),1800000,200,1073741824);}
  if mode=="--catalog" {b:[32768]u8;n:=pt_catalog(b[..],args_at(a[..],1),args_at(a[..],2));if n<0 {return 1;}print("%\n",cast(string)b[0..<n]);return 0;}
  if mode=="--mail-check" {m:[1]PlayerMail;ok:=pm_open(m[..]);print("dedicated mailbox: %\n",ifx ok then "ready" else "unavailable");return ifx ok then 0 else 1;}
  if mode=="--mail-new-check" {m:[1]PlayerMail;ok:=pm_new(m[..]);print("disposable mailbox: %, HTTP %\n",ok,m[0].status);return ifx ok then 0 else 1;}
