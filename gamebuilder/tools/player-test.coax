    jo_str(o[..],ifx !applicable then "not-applicable" else ifx v==1 then "pass" else ifx v==2 then "product-fail" else ifx v==3 then "infrastructure-fail" else ifx v==4 then "inconclusive" else "blocked");jo_end(o[..]);}
  jo_end(o[..]);jo_key(o[..],"passed");jo_int(o[..],passed);jo_key(o[..],"required");jo_int(o[..],required);jo_key(o[..],"requiredTarget");jo_bool(o[..],pt_target_required(target));jo_end(o[..]);
