  passed:=0;required:=0;for t:0..<PT_TARGET_COUNT {for j:0..<PT_CASES {if pt_target_required(t) && pt_applicable(t,ids[j]) {required+=1;if verdict[t][j]==1 {passed+=1;}else {ready=false;}}}}
  b:[65536]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"player.matrix.v1");jo_key(o[..],"expectedServicePolicy");jo_str(o[..],PT_SERVICE_POLICY);jo_key(o[..],"phase1Complete");jo_bool(o[..],ready);jo_key(o[..],"invalidInput");jo_bool(o[..],invalid);
  jo_key(o[..],"deploymentRevision");jo_str(o[..],cast(string)revision[0..<revision_n]);jo_key(o[..],"runnerSha256");jo_str(o[..],cast(string)runner_hash[0..<runner_n]);jo_key(o[..],"origin");jo_str(o[..],cast(string)release_origin[0..<origin_n]);jo_key(o[..],"releaseManifestSha256");jo_str(o[..],cast(string)release_hash[0..<hash_n]);jo_key(o[..],"sources");jo_raw(o[..],jo_text(so[..]));jo_key(o[..],"cells");jo_arr(o[..]);
  for t:0..<PT_TARGET_COUNT {for j:0..<PT_CASES {
    applicable:=pt_applicable(t,ids[j]);v:=verdict[t][j];
    jo_obj(o[..]);jo_key(o[..],"target");jo_str(o[..],targets[t]);jo_key(o[..],"case");jo_str(o[..],ids[j]);jo_key(o[..],"outcome");jo_str(o[..],ifx !applicable then "not-applicable" else ifx v==1 then "pass" else ifx v==2 then "product-fail" else ifx v==3 then "infrastructure-fail" else ifx v==4 then "inconclusive" else "blocked");jo_end(o[..]);
  }}
  jo_end(o[..]);jo_key(o[..],"passed");jo_int(o[..],passed);jo_key(o[..],"required");jo_int(o[..],required);jo_key(o[..],"cleanRuns");jo_arr(o[..]);for t:0..<PT_TARGET_COUNT {jo_obj(o[..]);jo_key(o[..],"target");jo_str(o[..],targets[t]);jo_key(o[..],"agent-entitled");jo_int(o[..],clean[t][0]);jo_key(o[..],"ordinary");jo_int(o[..],clean[t][1]);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);
  // ready was conservatively computed before serialization; missing cells also
  // make their source runs unclean, so phase1Complete can never omit a cell.
  if o[0].bad || so[0].bad || !fs_write(fs_join(dir,"report.json",path[..]),jo_text(o[..])) {return 2;}
  html:="<!doctype html><meta charset=utf-8><title>GameBuilder player matrix</title><style>body{font:16px system-ui;padding:2rem;background:#10141c;color:#eee}td{padding:.4rem;border-bottom:1px solid #555}</style><h1>Live player matrix</h1><p id=s></p><table id=t></table><script>fetch('report.json').then(r=>r.json()).then(r=>{document.querySelector('#s').textContent=`${r.passed}/${r.required} cells passed. Phase 1 complete: ${r.phase1Complete}. Three consecutive clean runs per target and role are required.`;for(const c of r.cells){const tr=document.querySelector('#t').appendChild(document.createElement('tr'));for(const v of [c.target,c.case,c.outcome])tr.appendChild(document.createElement('td')).textContent=v}})</script>";_=fs_write(fs_join(dir,"report.html",path[..]),html);
  print("matrix: %/% required cells passed; phase 1 complete %\n",passed,required,ready);return ifx ready then 0 else 2;
}
tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) {return 2;}
  mode:=args_at(a[..],0);
  if mode=="--public-diagnose" {
    c:[1]Cdp;if !cdp_launch_live_headless(c[..],1440,900,"gb-public-diagnose-") {return 1;}defer cdp_close(c[..]);
    _:=cdp_call(c[..],"Runtime.enable","{}",PB_CALL_MS);_=cdp_call(c[..],"Log.enable","{}",PB_CALL_MS);
    _:=cdp_send(c[..],"Page.navigate","{\"url\":\"https://gamebuilder.org\"}");end:=proc_now_ms()+20000;
    while proc_now_ms()<end {if cdp_poll(c[..],200)==CDP_GOT {d:=cdp_doc(c[..]);if cdp_event_method(d)=="Runtime.exceptionThrown" {print("public exception: %\n",jv_raw(d,jv_path(d,0,"params.exceptionDetails.exception.description")));}}}
    r:=pb_read(c[..],"({text:document.body.innerText.slice(0,200),buttons:document.querySelectorAll('button').length})");if r>=0 {print("public page: %\n",jv_raw(cdp_doc(c[..]),r));}return 0;
  }
