    }
    if args_has(a[..],"--tab") {
      _:=pb_click(p[0].c[..],100,100);r:=cdp_call(p[0].c[..],"Target.createTarget","{\"url\":\"about:blank\",\"background\":false}",PB_CALL_MS);if r<0 {return 1;}id:[128]u8;n:=jv_str(cdp_doc(p[0].c[..]),jv_get(cdp_doc(p[0].c[..]),r,"targetId"),id[..]);url:[512]u8;u:=ws_put(url[..],0,"ws://127.0.0.1:");u=pb_decimal(url[..],u,p[0].c[0].port);u=ws_put(url[..],u,"/devtools/page/");u=ws_put(url[..],u,cast(string)id[0..<n]);q:[1]Cdp;if !cdp_connect(q[..],cast(string)url[0..<u]) {return 1;}_=cdp_call(q[..],"Page.bringToFront","{}",PB_CALL_MS);clicked:=pb_click(q[..],100,100);hidden:=pt_wait(p[..],"!document.hasFocus()",2000);r=pb_read(p[0].c[..],"({hidden:document.hidden,focus:document.hasFocus()})");if r>=0 {print("other tab: %\n",jv_raw(cdp_doc(p[0].c[..]),r));}_=cdp_call(p[0].c[..],"Page.bringToFront","{}",PB_CALL_MS);_=pb_click(p[0].c[..],100,100);restored:=pt_wait(p[..],"document.hasFocus()",2000);cdp_shut(q[..]);print("real-click tab focus: clicked %, old focus lost %, restored %\n",clicked,hidden,restored);return ifx clicked && hidden && restored then 0 else 1;
    }
    r:=cdp_call(p[0].c[..],"Browser.getWindowForTarget","{}",PB_CALL_MS);id:=ifx r>=0 then jv_int(cdp_doc(p[0].c[..]),jv_get(cdp_doc(p[0].c[..]),r,"windowId"),-1) else -1;
    b:[256]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"windowId");jo_int(o[..],id);jo_key(o[..],"bounds");jo_obj(o[..]);jo_key(o[..],"windowState");jo_str(o[..],"minimized");jo_end(o[..]);jo_end(o[..]);sent:=id>=0 && cdp_call(p[0].c[..],"Browser.setWindowBounds",jo_text(o[..]),PB_CALL_MS)>=0;hidden:=pt_wait(p[..],"document.hidden && !document.hasFocus()",2000);
