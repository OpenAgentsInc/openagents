    jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"windowId");jo_int(o[..],id);jo_key(o[..],"bounds");jo_obj(o[..]);jo_key(o[..],"windowState");jo_str(o[..],"normal");jo_end(o[..]);jo_end(o[..]);_=cdp_call(p[0].c[..],"Browser.setWindowBounds",jo_text(o[..]),PB_CALL_MS);_=cdp_call(p[0].c[..],"Page.bringToFront","{}",PB_CALL_MS);restored:=pt_wait(p[..],"!document.hidden && document.hasFocus()",2000);print("headless window lifecycle: sent %, hidden %, restored %\n",sent,hidden,restored);return ifx sent && hidden && restored then 0 else 1;
  }
