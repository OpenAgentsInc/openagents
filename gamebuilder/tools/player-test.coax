Pt :: struct {
  health:[1]PlayerFrameHealth;frame_fresh:bool;input_verified:bool;input_fault:bool;
  c:[1]Cdp; mail:[1]PlayerMail;
  wd:[1]PlayerWd; driver:int; target:int; touch:bool;
  dir:[4096]u8;dir_n:int; origin:[2048]u8;origin_n:int;
  ws:[512]u8;ws_n:int; start:int; recorder:int=-1;
  verdict:[PT_CASES]int; // 0 blocked, 1 pass, 2 product fail, 3 infrastructure, 4 inconclusive
  step:int; failed:int; authenticated:bool; headed:bool;
  ordinary:bool;critical:bool;visual_only:bool;public_only:bool;capacity_only:bool;platformer_entry:bool;agent_only:bool;create_only:bool;pointer_only:bool;games_only:bool;editor_only:bool;crates_only:bool;platformer_only:bool;racing_only:bool;explore_only:bool;reuse_session:bool;requests:int;max_requests:int=10;
  provenance:bool; recording:bool; observer:bool; leased:bool;background_ok:bool;
  asset_seen:[PT_ASSET_COUNT]bool;asset_hash:[PT_ASSET_COUNT][64]u8;
  last_place_x:int;last_place_y:int;
  runner_hash:[64]u8;runner_hash_ok:bool;
  release_hash:[64]u8;release_hash_ok:bool;
  catalog_revision:[40]u8;catalog_n:int;provenance_bad:bool;hardware:bool;
}
pt_bool :: (p:[]Pt,e:string)->bool {return ifx p[0].driver==0 then pb_bool(p[0].c[..],e) else wd_bool(p[0].wd[..],e);}
pt_number :: (p:[]Pt,e:string,f:f64)->f64 {return ifx p[0].driver==0 then pb_number(p[0].c[..],e,f) else wd_number(p[0].wd[..],e,f);}
pt_type :: (p:[]Pt,text:string)->bool {
  if p[0].driver==0 {return pb_type(p[0].c[..],text);}
  // These journeys type ASCII requests. Per-key delivery lets Safari's controlled
  // Coax editor commit each edit before the next key, including the software keyboard.
  ch:[1]u8;for i:0..<text.count {if text[i]>=128 {return false;}_:=pb_heartbeat(pt_dir(p));ch[0]=text[i];if !wd_type(p[0].wd[..],cast(string)ch[..]) {pt_event(p,"infrastructure","Safari send-keys rejected",false);return false;}proc_sleep(ifx p[0].touch then 100 else 30);}return true;
}
pt_field_matches :: (p:[]Pt,id:string,expected:string)->bool {
  quoted:[512]u8;o:[1]Jo;jo_start(o[..],quoted[..]);jo_str(o[..],id);js:[1024]u8;n:=ws_put(js[..],0,"document.getElementById(");n=ws_put(js[..],n,jo_text(o[..]));n=ws_put(js[..],n,")?.value||''");
