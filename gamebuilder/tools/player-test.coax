pt_count :: (p:[]Pt)->int {return cast(int)pt_number(p,"Number(document.getElementById('blocks')?.textContent.split('\\n')[0])",-1);}
pt_chat_notice_ok :: (text:string)->bool {return text.count==0 || text=="the agent sees the last 12 messages: older ones are let go.";}
