    drew:=pt_number(p,"globalThis.coaxial?.worldLoop()?.submissions",-1)>frames && pt_number(p,"globalThis.coaxial?.drawStats()?.indices",-1)>0;
    if kind==7 || kind==8 {pt_result(p,ids[w],enter && move && abs(x1-x0)+abs(z1-z0)>30 && image && drew);if kind==8 {pt_event(p,"blocked","drift is newer than the qualified snapshot; its twelve-ring walkthrough is required and not implemented",false);}continue;}
