pt_merge :: (a:[]Args)->int {
  dir:=args_value(a,"--out","");if dir.count==0 || !fs_mkdir_private(dir) {tool_errln("--merge needs a fresh private --out directory");return 2;}
  verdict:[PT_TARGET_COUNT][PT_CASES]int;clean:[PT_TARGET_COUNT][2]int;last:[PT_TARGET_COUNT][2]int;ids:=PT_IDS;targets:=PT_TARGETS;
