  if fs_exists(fs_join(dir,"report.json",path[..])) {tool_errln("matrix evidence already exists; choose a fresh --out");return 2;}
  sources:[32768]u8;so:[1]Jo;jo_start(so[..],sources[..]);jo_arr(so[..]);
  i:=1;while i<args_count(a) {
    source:=args_at(a,i);i+=1;if source=="--out" {i+=1;continue;}if inputs>=64 {invalid=true;break;}
    n:=fs_read(fs_join(source,"report.json",path[..]),body[..]);inputs+=1;jo_str(so[..],source);
    if n<=0 || !jv_parse(d[..],cast(string)body[0..<n],nodes[..]) || jv_raw(d[0],jv_get(d[0],0,"schema"))!="player.result.v1" {invalid=true;continue;}
    if !pt_service_policy_ok(d[0]) {invalid=true;continue;}
    target:=jv_raw(d[0],jv_get(d[0],0,"target"));t:=-1;for j:0..<PT_TARGET_COUNT {if target==targets[j] {t=j;}}if t<0 {invalid=true;continue;}
    role:=jv_raw(d[0],jv_get(d[0],0,"role"));if role!="ordinary" && role!="agent-entitled" {invalid=true;continue;}ordinary:=role=="ordinary";r:=ifx ordinary then 1 else 0;
    source_runner:=jv_raw(d[0],jv_get(d[0],0,"runnerSha256"));if source_runner.count!=64 {invalid=true;}else if runner_n==0 {runner_n=ws_put(runner_hash[..],0,source_runner);}else if source_runner!=cast(string)runner_hash[..] {invalid=true;}
    source_origin:=jv_raw(d[0],jv_get(d[0],0,"origin"));source_hash:=jv_raw(d[0],jv_get(d[0],0,"releaseManifestSha256"));
    if origin_n==0 {origin_n=ws_put(release_origin[..],0,source_origin);hash_n=ws_put(release_hash[..],0,source_hash);}else if source_origin!=cast(string)release_origin[0..<origin_n] || source_hash!=cast(string)release_hash[0..<hash_n] {invalid=true;}
    cells:=jv_get(d[0],0,"cells");seen:[PT_CASES]bool;run_clean:=jv_bool(d[0],jv_get(d[0],0,"provenanceVerified")) && jv_bool(d[0],jv_get(d[0],0,"recordingPresent")) && jv_bool(d[0],jv_get(d[0],0,"hardwareGpu")) && pt_video_ok(source) && jv_bool(d[0],jv_get(d[0],0,"inputVerified"));
    run_clean=run_clean && jv_raw(d[0],jv_get(d[0],0,"scope"))=="full";
    deployment:=jv_raw(d[0],jv_get(d[0],0,"deploymentRevision"));if deployment.count==40 {if revision_n==0 {revision_n=ws_put(revision[..],0,deployment);}else if deployment!=cast(string)revision[..] {invalid=true;run_clean=false;}}else {run_clean=false;}
    for k:0..<jv_len(d[0],cells) {
      cell:=jv_at(d[0],cells,k);if jv_raw(d[0],jv_get(d[0],cell,"target"))!=target {continue;}
      id:=jv_raw(d[0],jv_get(d[0],cell,"case"));index:=-1;for j:0..<PT_CASES {if id==ids[j] {index=j;}}if index<0 {invalid=true;continue;}if seen[index] {invalid=true;}seen[index]=true;
      if !pt_applicable(t,id) || !pt_role_required(ordinary,id) {continue;}
      outcome:=jv_raw(d[0],jv_get(d[0],cell,"outcome"));v:=ifx outcome=="pass" then 1 else ifx outcome=="product-fail" then 2 else ifx outcome=="infrastructure-fail" then 3 else ifx outcome=="inconclusive" then 4 else 0;
      verdict[t][index]=pt_merge_verdict(verdict[t][index],v);if v!=1 {run_clean=false;}
    }
    for j:0..<PT_CASES {if !seen[j] {invalid=true;run_clean=false;}}
