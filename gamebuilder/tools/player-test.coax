  d:=ifx p[0].driver==0 then cdp_doc(p[0].c[..]) else p[0].wd[0].doc[0];v:[2048]u8;vn:=jv_str(d,r,v[..]);ok:=vn==expected.count && cast(string)v[0..<vn]==expected;if !ok {print("input length: expected %, received %\n",expected.count,vn);}for i:0..<v.count {v[i]=0;}return ok;
}
pt_click :: (p:[]Pt,x:int,y:int)->bool {
  w:=pt_number(p,"innerWidth",1440);h:=pt_number(p,"innerHeight",900);px:=cast(int)(cast(f64)x*w/1440);py:=cast(int)(cast(f64)y*h/900);
  return ifx p[0].driver==0 then (ifx p[0].touch then pb_touch_tap(p[0].c[..],px,py) else pb_click(p[0].c[..],px,py)) else wd_click(p[0].wd[..],px,py,p[0].touch);
}
pt_slider_max :: (p:[]Pt)->bool {
  x:=cast(int)pt_number(p,"(()=>{const e=document.getElementById('p.world.gravity');if(!e)return -1;const r=e.getBoundingClientRect();return r.right-2})()",-1);
  y:=cast(int)pt_number(p,"(()=>{const e=document.getElementById('p.world.gravity');if(!e)return -1;const r=e.getBoundingClientRect();return r.y+r.height/2})()",-1);
  if x<0 || y<0 {return false;}_:=pb_heartbeat(pt_dir(p));return ifx p[0].driver==0 then (ifx p[0].touch then pb_touch_tap(p[0].c[..],x,y) else pb_click(p[0].c[..],x,y)) else wd_click(p[0].wd[..],x,y,p[0].touch);
}
pt_key :: (p:[]Pt,key:string,code:string,down:bool)->bool {return ifx p[0].driver==0 then pb_key(p[0].c[..],key,code,down) else wd_key(p[0].wd[..],key,down);}
pt_select_all :: (p:[]Pt)->bool {
  if p[0].driver==0 {n:=cast(int)pt_number(p,"document.activeElement?.value?.length||0",0);if n>1200 {return false;}for i:0..<n {if !pb_press(p[0].c[..],"Backspace","Backspace") {return false;}}return true;}
  return wd_clear_active(p[0].wd[..]);
}
pt_dir :: (p:[]Pt)->string {return cast(string)p[0].dir[0..<p[0].dir_n];}
pt_lease_root :: (p:[]Pt)->string {return ifx p[0].ordinary then "/tmp/gamebuilder-player-ordinary-inbox.lease" else "/tmp/gamebuilder-player-inbox.lease";}
pt_lease_owner :: (p:[]Pt)->string {return ifx p[0].ordinary then "/tmp/gamebuilder-player-ordinary-inbox.lease/owner.pid" else "/tmp/gamebuilder-player-inbox.lease/owner.pid";}
pt_account_lease :: (p:[]Pt)->bool {
  // mkdir is the OS's atomic exclusion primitive; an existing lease fails closed.
  args:=[4]string.["/bin/mkdir","-m","700",pt_lease_root(p)];
  out:[64]u8;err:[256]u8;r:=proc_run(args[..],2000,out[..],err[..]);p[0].leased=r.status==0;
  if !p[0].leased {owner:[32]u8;n:=fs_read(pt_lease_owner(p),owner[..]);pid:=ifx n>0 then args_whole(cast(string)owner[0..<n]) else 0;
    if pid>1 && cxproc_pid_alive(pid)==0 {_:=fs_remove(pt_lease_owner(p));_=fs_remove(pt_lease_root(p));r=proc_run(args[..],2000,out[..],err[..]);p[0].leased=r.status==0;}}
  if p[0].leased {owner:[32]u8;n:=pb_decimal(owner[..],0,cxproc_self_pid());_=fs_write(pt_lease_owner(p),cast(string)owner[0..<n]);}
  return p[0].leased;
}
pt_unlease :: (p:[]Pt) {if p[0].leased {_:=fs_remove(pt_lease_owner(p));_=fs_remove(pt_lease_root(p));p[0].leased=false;}}
pt_provenance :: (p:[]Pt)->bool {
  work:[1]HttpWork;body:[65536]u8;headers:[1]string;url:[4096]u8;n:=ws_put(url[..],0,pt_origin(p));n=ws_put(url[..],n,"/build/player-catalog.json");
  r:=http_do(work[..],"GET",cast(string)url[0..<n],headers[0..<0],"",10000,0,body[..]);d:[1]Jv;nodes:[4096]JvNode;
  if r.error!=HTTP_OK || r.code!=200 || !jv_parse(d[..],cast(string)body[0..<r.n],nodes[..]) {return false;}
  path:[4096]u8;_=fs_write(pt_path(p,"served-catalog.json",path[..]),cast(string)body[0..<r.n]);
  revision:=jv_raw(d[0],jv_get(d[0],0,"revision"));if revision.count!=40 {p[0].provenance_bad=true;}else if p[0].catalog_n==0 {p[0].catalog_n=ws_put(p[0].catalog_revision[..],0,revision);}else if revision!=cast(string)p[0].catalog_revision[..] {p[0].provenance_bad=true;}
  expected:=jv_get(d[0],0,"assets");ok:=jv_raw(d[0],jv_get(d[0],0,"schema"))=="gamebuilder.player.catalog.v1";
  cases:=jv_get(d[0],0,"requiredCases");ids:=PT_IDS;ok=ok && jv_len(d[0],cases)==PT_CASES;
  for i:0..<PT_CASES {ok=ok && jv_raw(d[0],jv_at(d[0],cases,i))==ids[i];}
  assets:=PT_ASSETS;for i:0..<PT_ASSET_COUNT {asset:=assets[i];
    hash:=jv_raw(d[0],jv_get(d[0],expected,asset));expr:[1024]u8;en:=ws_put(expr[..],0,"globalThis.coaxialAssetReceipts?.['");en=ws_put(expr[..],en,asset);en=ws_put(expr[..],en,"']?.sha256||''");
    _:=pb_heartbeat(pt_dir(p));v:=ifx p[0].driver==0 then pb_read(p[0].c[..],cast(string)expr[0..<en]) else wd_read(p[0].wd[..],cast(string)expr[0..<en]);
    got:=ifx p[0].driver==0 then cdp_doc(p[0].c[..]) else p[0].wd[0].doc[0];actual:=ifx v>=0 then jv_raw(got,v) else "";
    if hash.count!=64 {p[0].provenance_bad=true;}
    if actual.count>0 {
      if actual!=hash || (p[0].asset_seen[i] && actual!=cast(string)p[0].asset_hash[i][..]) {p[0].provenance_bad=true;}
      if actual.count==64 {p[0].asset_seen[i]=true;_=ws_put(p[0].asset_hash[i][..],0,actual);}
    }
    if !(p[0].critical || p[0].platformer_entry || p[0].agent_only || p[0].create_only || p[0].pointer_only || p[0].editor_only || p[0].crates_only || p[0].platformer_only || p[0].racing_only || p[0].explore_only) || i<5 {ok=ok && p[0].asset_seen[i];}
  }
  if cdp_contains(pt_origin(p),"/player-releases/") {
    n=ws_put(url[..],0,pt_origin(p));n=ws_put(url[..],n,"/release.json");manifest:[131072]u8;mr:=http_do(work[..],"GET",cast(string)url[0..<n],headers[0..<0],"",10000,0,manifest[..]);md:[1]Jv;mn:[8192]JvNode;hash:[64]u8;
    good:=mr.error==HTTP_OK && mr.code==200 && jv_parse(md[..],cast(string)manifest[0..<mr.n],mn[..]) && jv_raw(md[0],jv_get(md[0],0,"schema"))=="gamebuilder.player.release.v1" && jv_raw(md[0],jv_path(md[0],0,"deployment.revision"))==revision && pt_sha(manifest[0..<mr.n],hash[..]);
    if good && p[0].release_hash_ok && cast(string)hash[..]!=cast(string)p[0].release_hash[..] {good=false;}
    if good {p[0].release_hash=hash;p[0].release_hash_ok=true;mp:[4096]u8;_=fs_write(pt_path(p,"release.json",mp[..]),cast(string)manifest[0..<mr.n]);}else {p[0].provenance_bad=true;}ok=ok && good;
  }
  p[0].provenance=ok && !p[0].provenance_bad;pt_event(p,"provenance","loaded bytes match served catalog",p[0].provenance);return p[0].provenance;
}
pt_origin :: (p:[]Pt)->string {return cast(string)p[0].origin[0..<p[0].origin_n];}
pt_path :: (p:[]Pt,name:string,out:[]u8)->string {return fs_join(pt_dir(p),name,out);}
pt_event :: (p:[]Pt,kind:string,name:string,ok:bool) {
  b:[8192]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"at_ms");jo_int(o[..],proc_now_ms()-p[0].start);
  p[0].step+=1;jo_key(o[..],"sequence");jo_int(o[..],p[0].step);
  jo_key(o[..],"kind");jo_str(o[..],kind);jo_key(o[..],"name");jo_str(o[..],name);jo_key(o[..],"ok");jo_bool(o[..],ok);jo_end(o[..]);
  path:[4096]u8;_:=fs_append(pt_path(p,"events.jsonl",path[..]),jo_text(o[..]));_=fs_append(pt_path(p,"events.jsonl",path[..]),"\n");
}
pt_result :: (p:[]Pt,id:string,ok:bool) {
  ids:=PT_IDS;for i:0..<PT_CASES {if ids[i]==id {p[0].verdict[i]=pt_merge_verdict(p[0].verdict[i],ifx ok then 1 else ifx p[0].input_fault then 3 else 2);}}
  if !ok {p[0].failed+=1;}pt_event(p,"assertion",id,ok);print("% %\n",ifx ok then "PASS" else "FAIL",id);
  if !ok {name:[256]u8;n:=ws_put(name[..],0,"failure-");n=ws_put(name[..],n,id);n=ws_put(name[..],n,".png");_=pt_shot(p,cast(string)name[0..<n]);}
}
pt_observe :: (p:[]Pt)->bool {
  visible:="({schema:'player.visible-observation.v1',at_ms:performance.now(),url:location.origin+location.pathname,focus:document.activeElement?.id||'',text:document.body.innerText.replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi,'[email]').slice(0,12000)})";
  expression:=ifx p[0].visual_only then visible else PT_OBSERVE;
  _:=pb_heartbeat(pt_dir(p));r:=ifx p[0].driver==0 then pb_read(p[0].c[..],expression) else wd_read(p[0].wd[..],expression);if r<0 {return false;}
  d:=ifx p[0].driver==0 then cdp_doc(p[0].c[..]) else p[0].wd[0].doc[0];frame:=jv_path(d,r,"diagnostics.frame");p[0].frame_fresh=pt_frame_valid(d,frame) && pt_frame_tick(p[0].health[..],jv_int(d,jv_get(d,frame,"sequence"),0),proc_now_ms());path:[4096]u8;ok:=fs_append(pt_path(p,"observations.jsonl",path[..]),jv_raw(d,r));_=fs_append(pt_path(p,"observations.jsonl",path[..]),"\n");return ok;
}
pt_wait :: (p:[]Pt,expression:string,ms:int)->bool {
  end:=proc_now_ms()+ms;
  while proc_now_ms()<end {if !pb_heartbeat(pt_dir(p)) {return false;}if pt_bool(p,expression) {return true;}proc_sleep(100);}
  return false;
}
// Resolve bar identities from accessible labels, including a saved/reordered bar.
pt_hot_id :: (p:[]Pt,label:string,out:[]u8)->string {
  quoted:[256]u8;o:[1]Jo;jo_start(o[..],quoted[..]);jo_str(o[..],label);js:[1024]u8;n:=ws_put(js[..],0,"[...document.querySelectorAll('[id^=\"hot.s.\"]')].find(e=>e.getAttribute('aria-label')===");n=ws_put(js[..],n,jo_text(o[..]));n=ws_put(js[..],n,")?.id||''");r:=pb_read(p[0].c[..],cast(string)js[0..<n]);k:=ifx r>=0 then jv_str(cdp_doc(p[0].c[..]),r,out) else 0;return ifx k>0 then cast(string)out[0..<k] else "";
}
pt_hot :: (p:[]Pt,label:string)->bool {id:[128]u8;return pt_tap(p,pt_hot_id(p,label,id[..]));}
pt_palette :: (p:[]Pt,label:string)->bool {
  if !pt_hot(p,"more") {return false;}quoted:[256]u8;o:[1]Jo;jo_start(o[..],quoted[..]);jo_str(o[..],label);js:[1024]u8;n:=ws_put(js[..],0,"[...document.querySelectorAll('.hb-pn')].find(e=>e.textContent===");n=ws_put(js[..],n,jo_text(o[..]));n=ws_put(js[..],n,")?.closest('button')?.id||''");r:=pb_read(p[0].c[..],cast(string)js[0..<n]);id:[128]u8;k:=ifx r>=0 then jv_str(cdp_doc(p[0].c[..]),r,id[..]) else 0;ok:=k>0 && pt_reveal_setting(p,cast(string)id[0..<k]) && pt_tap(p,cast(string)id[0..<k]);if pt_bool(p,"!!document.getElementById('pal')") {_:=pt_hot(p,"more");}return ok;
}
pt_tap :: (p:[]Pt,id:string)->bool {
  if id.count==0 {return false;}resolved:[128]u8;target:=id;
  if id.count>5 && cast(string)id[0..<5]=="kind." && !pt_reveal_picker(p,id) {pt_event(p,"input.tap",id,false);return false;}
  if p[0].driver==0 && id=="hot.s.5" && pt_bool(p,"document.getElementById('hot.s.0')?.getAttribute('aria-label')==='reset'") {target=pt_hot_id(p,"reset",resolved[..]);if target.count==0 {return false;}}
