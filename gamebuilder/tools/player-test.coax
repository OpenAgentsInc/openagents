  if p[0].driver==0 {ready=false;end:=proc_now_ms()+1200;while !ready && proc_now_ms()<end {r:=pb_target(p[0].c[..],target);ready=r>=0 && jv_kind(cdp_doc(p[0].c[..]),r)==JV_OBJECT;if !ready {_:=pb_wait(pt_dir(p),100);}}}
  ok:=ready && (ifx p[0].driver==0 then pb_tap_as(p[0].c[..],target,p[0].touch) else wd_tap(p[0].wd[..],target,p[0].touch));pt_event(p,"input.tap",id,ok);if !ok {_:=pt_observe(p);}_=pb_wait(pt_dir(p),150);return ok;
}
pt_press :: (p:[]Pt,key:string,code:string)->bool {
  _:=pb_heartbeat(pt_dir(p));ok:=false;
  if p[0].touch {
    if key.count==1 && key[0]>='1' && key[0]<='5' {ids:=[5]string.["hot.s.0","hot.s.1","hot.s.2","hot.s.3","hot.s.4"];ok=pt_tap(p,ids[key[0]-'1']);}   // (the bar: shapes, edit, decide, camera, world)
    else if key==" " {ok=pt_click(p,1150,350);}
    else if key=="Enter" {ok=ifx pt_bool(p,"document.activeElement?.id==='say'") then (ifx p[0].driver==0 then pb_press(p[0].c[..],"Enter","Enter") else wd_type(p[0].wd[..],"")) else pt_tap(p,"say");}
    else if key=="Escape" {
      if pt_bool(p,"['INPUT','TEXTAREA'].includes(document.activeElement?.tagName)") {ok=pt_click(p,1100,150);}
      else if pt_bool(p,"!!document.getElementById('sel')") {ok=pt_click(p,1200,150);}
      else if pt_bool(p,"document.getElementById('hot.s.1')?.classList.contains('hb-on')") {ok=pt_tap(p,"hot.s.1");}
      else if pt_bool(p,"document.getElementById('hot.s.0')?.classList.contains('hb-on')") {ok=pt_tap(p,"hot.s.0");}
      else if pt_bool(p,"!!document.getElementById('p.world.gravity')") {ok=pt_tap(p,"hot.s.4");}else {ok=true;}
    }else {ok=ifx p[0].driver==0 then pb_press(p[0].c[..],key,code) else wd_press(p[0].wd[..],key);}
  }else if p[0].driver==1 {ok=wd_hold(p[0].wd[..],key,ifx key==" " then 80 else 0);}
  else {a:=pt_key(p,key,code,true);if key==" " {_:=pb_wait(pt_dir(p),80);}b:=pt_key(p,key,code,false);ok=a&&b;}
  pt_event(p,ifx p[0].touch then "input.touch-intent" else "input.key",code,ok);_=pb_wait(pt_dir(p),100);return ok;
}
pt_stick :: (p:[]Pt,key:string,ms:int,jump:bool,look:int)->bool {return ifx p[0].driver==0 then pb_stick(p[0].c[..],key,ms,jump,look,pt_dir(p)) else wd_stick(p[0].wd[..],key,ms,jump,look);}
pt_hold :: (p:[]Pt,key:string,code:string,ms:int)->bool {
  if p[0].visual_only {
    // Decode/blank-check with input released; decoding may take longer than an
    // action. During movement take fresh real screenshots without decoding on
    // the control path. The independent visual oracle checks their outcomes.
    if p[0].touch || ms<0 || ms>5000 {return false;}path:[4096]u8;ok:=pt_shot(p,"visible-input.png") && pt_image_check(pt_path(p,"visible-input.png",path[..]));if !ok {return false;}left:=ms;
    ok=pv_fresh_shot(p) && pt_key(p,key,code,true);
    while left>0 && ok {part:=ifx left>200 then 200 else left;ok=pb_wait(pt_dir(p),part);left-=part;if left>0 {ok=pv_fresh_shot(p) && ok;}}
    up:=pt_key(p,key,code,false);pt_event(p,"input.visual-hold",code,ok && up);return ok && up;
  }
  if ms<0 || ms>5000 || !pt_observe(p) || !p[0].frame_fresh {p[0].input_fault=true;if p[0].driver==0 {_:=pb_release(p[0].c[..]);}else {_:=wd_release(p[0].wd[..]);}pt_event(p,"infrastructure","movement refused a stale or malformed own-frame observation",false);return false;}
  if p[0].touch {
    left:=ms;ok:=true;while left>0 && ok {part:=ifx left>200 then 200 else left;_=pb_heartbeat(pt_dir(p));ok=pt_stick(p,key,part,false,0);if !ok {p[0].input_fault=true;tool_errln(cdp_error(p[0].c[..]));tool_errln(jv_raw(cdp_doc(p[0].c[..]),jv_path(cdp_doc(p[0].c[..]),0,"error.message")));pt_event(p,"infrastructure","native touch command rejected or timed out",false);}ok=ok && pt_observe(p) && p[0].frame_fresh;left-=part;}return ok;
  }
  if p[0].driver==1 {left:=ms;ok:=true;while left>0 && ok {part:=ifx left>200 then 200 else left;_=pb_heartbeat(pt_dir(p));ok=wd_hold(p[0].wd[..],key,part) && pt_observe(p) && p[0].frame_fresh;left-=part;}return ok;}
  if ms<0 || ms>5000 {return false;}_:=pb_heartbeat(pt_dir(p));ok:=pt_key(p,key,code,true);
  left:=ms;waited:=true;
  while left>0 && waited {part:=ifx left>200 then 200 else left;waited=pb_wait(pt_dir(p),part) && pt_observe(p) && p[0].frame_fresh;left-=part;}
  up:=pt_key(p,key,code,false);pt_event(p,"input.hold",code,ok&&waited&&up);_=pb_wait(pt_dir(p),150);return ok&&waited&&up;
}
pt_go :: (p:[]Pt,path:string)->bool {
  p[0].health[0]=PlayerFrameHealth.{};url:[4096]u8;n:=ws_put(url[..],0,pt_origin(p));n=ws_put(url[..],n,path);_=pb_heartbeat(pt_dir(p));
