// gamebuilder.org's world and HUD: the GPU layer under the page. The browser lays the page's
// words and pictures out (page.coax); this is everything behind them, and it is a scene of the
// OpenAgents Metaverse Engine (docs/web-world.md):
//
//   the frame      the engine's stylized frame (metaverse-engine/render/shade/stylized-frame.coax):
//                  the camera, the sunrise's look, the sun's shadow box, the grass field, its wind,
//                  the character it parts round, and its reveal
//   the ground     one part of the engine's architecture kit (metaverse-engine/arch/), the ground
//                  material: bare, it is the engine's graybox floor with a grid a metre square;
//                  where the reveal has passed it is meadow under the engine's grass
//   the things     the page's blocks and balls (web/blocks.coax) as rigid bodies of the engine's
//                  physics (metaverse-engine/physics/sim/bodies.coax): they fall from a little above
//                  where they are put, rest, stack, tip and sleep; the character pushes them by
//                  running into them, by their weight. Drawn as the kit's boxes and balls, lit and
//                  shadowed by the engine, and solid to the character by the engine's collision
//                  (metaverse-engine/physics/query.coax and collide.coax)
//   the character  moved by the GameBuilder app's own rules on foot (coax/her.coax: SPLICEBOTS' walk
//                  and jump, metaverse/splice-bots/rules/walk.coax in the pinned tree), posed by
//                  ghost.coax (a Quaternius outfit on the people rig, CC0) and shaded as the
//                  engine's ghost (metaverse-engine/render/ghost.coax)
//   the HUD        a thin ARWES frame round every panel the page has, from the ported ARWES
//                  geometry in the pinned tree (components/core/arwes/frames.coax and fx.coax;
//                  ARWES is arwes/arwes by Romel Perez, MIT: metaverse-engine/ui/arwes/LICENSE)
//
// web/gpu/hud.coax names the engine's shaders for it; nothing is drawn by a shader written here.
//
// One scene, three views, one camera. The home page, and the builder before a type is picked, is the
// world's meadow with the game types as a ring of portals round the camera (issue 30: web/ring.coax,
// hud_ring; the glue raises it, HUD_RING_MSG): it drifts from one portal to the next, and a pick flies
// it through that portal into the type's world. Where the ring is not up the page's own view is the bare
// floor, looked straight down on from so high that a metre is 48 CSS pixels and sliding with the
// page's scroll; at the login it leans back 45 degrees; in the world it comes down behind the
// character, and the grass spreads from the character's feet to the horizon in HUD_SPREAD seconds.
//
// Down in the world the camera is the engine's free orbit (metaverse-engine/cam/camera.coax), wired
// as Everglade wires it (metaverse-engine/cam/chase.coax: a drag's turn, the wheel, a pinch, the
// held keys; the touch sticks of metaverse-engine/core/sticks.coax): it circles the character,
// zooms out to 12 m and in to 1.5 m and on into the character's head, keeps in front of the blocks
// and above the ground, and the character runs away from it when W is held. Nothing of the camera
// is written here but where its input comes from and the turn between this page's axes and the
// engine's.
//
// Units: metres. A grid square of the page's blocks (web/blocks.coax) is one metre, so the page's
// hundredths of a square are centimetres. The page's x is to the right, its z ahead and y up; the
// engine's camera looks along -z, so a page (x, y, z) is the engine's (x, y, -z). The rules and
// the collision run in the page's axes; only what is drawn is turned.
//
// The page tells it where its panels are (message 100: a count, then "KIND X Y W H" a line, CSS
// pixels from the window's top left), where the pointer is (101: "X Y"), how far down the page the
// window is (102: thousandths, then pixels), which view is shown (103: 0 the home page, 1 the
// login, 2 the world), which keys are held (104: bits) and the things (105), whether the press about to come began on one of the page's own
// things (107) and the wheel (108: "DY OVER"). The page host itself hands over every pointer
// (hud_pointer: a mouse's drag, a finger). It tells the page where the character is (action 106)
// and where things came to rest (action 110).
//
// A stroke's vertex is 8 floats: x, y in device pixels; r, g, b, a; then how far the point is from
// its stroke's centre line and the stroke's half width, both in device pixels.
//   coax/bin/coax test web/hud.coax --library

#load "../../components/core/arwes/frames.coax";
#load "../../components/core/arwes/fx.coax";
#load "../../metaverse/splice-bots/rules/walk.coax";
#load "../../metaverse-engine/render/shade/stylized-frame.coax";
#load "../../metaverse-engine/arch/solid.coax";
#load "../../metaverse-engine/physics/collide.coax";
#load "../../metaverse-engine/physics/sim/bodies.coax";
#load "../../metaverse-engine/cam/kinds.coax";
#load "../../metaverse-engine/cam/reticle.coax" as reticle;
#load "../../metaverse-engine/cam/mouselook.coax" as ml;
#load "../../metaverse-engine/core/sticks.coax" as pad;
#load "../../metaverse-engine/move/creative-fly.coax" as fly;
#load "hud-layout.coax";
#load "ghost.coax";
#load "world-village.coax";
#load "props.coax";
#load "../shared/game-types.coax";   // the game types, and a type's own kinds of block (shared/kinds.coax BL_R_*), as the page says them
#load "observe.coax";
#load "world-crates.coax";
#load "world-platformer.coax";
#load "../../metaverse-engine/cam/frame.coax";
#load "world-racing.coax";
#load "world-drift.coax";
#load "ring.coax";   // the home page's ring of portals (issue 30)

HUD_PANELS :: 40;
HUD_VERTICES :: 24000;
HUD_FLOATS :: 8;
HUD_BLOCKS :: 1000;        // things at once, blocks and balls alike (web/blocks.coax's BL_MAX)
HUD_INBOX :: 65536;        // the page's list of a thousand things fits
HUD_PANELS_MSG :: 100; HUD_POINTER_MSG :: 101; HUD_SCROLL_MSG :: 102; HUD_VIEW_MSG :: 103;
HUD_KEYS_MSG :: 104; HUD_BLOCKS_MSG :: 105;
HUD_OVER_MSG :: 107; HUD_WHEEL_MSG :: 108;   // the camera's: is the next press on the page's own things; the wheel
HUD_FOLLOW_MSG :: 109;    // the page's follow camera button: 1 on, 0 off
HUD_TYPING_MSG :: 112;    // the caret is in one of the page's fields (1) or not (0): typing frees a held pointer
HUD_TOOL_MSG :: 113;      // the hotbar's state, the page's: "TOOL EDIT ID GRAVITY CAMERA MODE" (the placing tool or -1, edit mode, the selected thing's id or 0, gravity in tenths of the normal, the camera menu's camera: 0 orbit, 1 follow, 2 first person, 3 top-down, the placing mode)
HUD_M_SNAP :: 0; HUD_M_FREE :: 1;   // how a placing tool places (web/blocks.coax's BL_M_*): on the grid or exactly where it is pointed, at rest either way (nothing placed drops in)
HUD_EDIT :: 114;          // the action that tells the page an edit a tool made: a plan line of web/blocks.coax, or "select bN"
HUD_T_BLOCK :: 0; HUD_T_BALL :: 1; HUD_T_SLAB :: 2; HUD_T_PILLAR :: 3;   // the shapes the placing tool places (web/blocks.coax's BL_T_*): a cube, a sphere, a slab, a pillar
HUD_T_SHAPES :: 4;
HUD_T_MODEL :: 10;           // a building tool: HUD_T_MODEL and the village's model (web/blocks.coax's BL_T_MODEL)
HUD_T_HALF :: 0.5;           // the building tools' snapping grid, metres
// A limit a person met where a tool was used, or with the character: told to the page as "limit WORD" (HUD_EDIT), which says it on
// screen in words with its number (web/blocks.coax bl_why). Never a silent no-op: the ghost's cross alone is not enough.
HUD_L_NONE :: 0; HUD_L_FULL :: 1; HUD_L_ROOM :: 2; HUD_L_FAR :: 3; HUD_L_SIZE :: 4; HUD_L_SKY :: 5;
HUD_L_BOXES :: 6;            // the buildings' solid boxes are all used (shared/buildings.coax VL_WALLS), or VL_PUT stand
HUD_L_COUNT :: 7;
HUD_L_WORDS :: [HUD_L_COUNT] string.["", "limit full", "limit room", "limit far", "limit size", "limit sky", "limit boxes"];
HUD_T_DRAG :: 6.0;        // CSS pixels the pointer must travel with a thing held before letting go moves it
HUD_GRAVITY :: -9.81;     // m/s^2: the normal gravity of the things (the engine's own)
HUD_T_GRID :: 0.5;        // metres: what a tool places and moves to snaps to
HUD_T_BALL_R :: 0.6;      // metres: the ball tool's ball
HUD_T_GROW :: 1.1;        // one notch of the wheel grows or shrinks the selected thing by this
HUD_T_REACH :: 700.0;     // metres a tool's ray reaches: across the whole of the world a thing may stand in, corner to corner, and more
HUD_T_SMALL :: 28.0;      // CSS pixels: a ghost drawn lower than this on the screen gets a marker over it, so it can be seen far off
HUD_T_PIN :: 44.0;        // CSS pixels: how tall that marker stands
HUD_SKY :: 60.0;          // metres over the ground the character rises to at most: a jump with no gravity stops here, and so does flying
HUD_T_FAR :: 200.0;       // metres from the middle of the world a thing may be put (web/blocks.coax's BL_FAR)
HUD_T_FAR_COURSE :: 700.0;   // and in the platformer, whose course runs 628 m, and drift, whose rings run 600 m (web/chat.coax ch_bounds)
HUD_T_SPACE :: 10.0;      // drift: with nothing nearer along the ray, a tool places this far out, in open space
HUD_KIND_MSG :: 111;      // the game type picked: 0 third person, 1 first person, 2 top down, 3 side on (the meadow, by the engine's camera kinds, cam/kinds.coax), 4 the medieval village
HUD_PACK_MSG :: 605;      // the page host's: the pack's bytes in so far and in all, "LOADED TOTAL" (coax/web/host.js)
HUD_TYPES :: 9;           // game types
HUD_VILLAGE :: 4;         // the medieval village (world-village.coax): its own world, in third person
HUD_CRATES :: 5;          // crates (world-crates.coax): its own world, a puzzle room seen top down
HUD_PLATFORMER :: 6;      // platformer (world-platformer.coax): its own world, a sky course seen side on
HUD_RACING :: 7;          // racing (world-racing.coax): its own world, a circuit driven in a car, the camera chasing it
HUD_DRIFT :: 8;           // drift (world-drift.coax): its own world, a ship in zero g flown through rings, the camera its aim
HUD_SAYS :: 115;          // the action that tells the page what the world is (its own words for the chat's model); nothing for the meadow
HUD_DOWN :: 6.0;          // a second: the camera closes this share of what is left of its way down to the world (0.97 of the way in 0.6 s: the entrance is short, and nothing waits for it)
HUD_UP :: 5.28;           // and of its way back up when the world is left, so the next entrance starts from the page's view
HUD_ROOM_MSG :: 118;      // crates: which level of its game the room is, and of how many, from 0: "ROOM ROOMS" (the page's, or the app's own). Another room: what stood here is gone, and the room is entered when its things are told (105)
HUD_CALM_MSG :: 117;      // how the world comes up, from the glue: bit 1 the person prefers reduced motion (the browser's setting), bit 2 the page says this world is a kept one come back (a restored game). Either, and it comes up settled: no entrance
HUD_SWING :: 14.0;        // a second: turned on, the follow camera closes this share of the way round to the character's back (there in a quarter of a second), then is locked
HUD_WHERE :: 106;         // the action that tells the page where the character is
HUD_WHERE_EVERY :: 0.25;  // seconds between two of them at least
HUD_SETTLED :: 110;       // the action that tells the page where things came to rest
HUD_SETTLED_EVERY :: 0.5; // seconds between two of them at least
HUD_OUTBOX :: 16384;      // bytes: some three hundred things' rests at once (the rest are told half a second later)
// The things: rigid bodies. A square is a metre; a block of a cubic metre is 200 kg.
HUD_DROP :: 3.0;          // metres above its place a new thing appears, to fall from
HUD_DROP_NEXT :: 0.2;     // and each one that came with it this share of that higher, so they land in turn
HUD_DROP_TURNS :: 6;      // up to this many heights, then from the first again
HUD_FALL_AT :: 0.9;       // how far down the camera has come before time starts for them (0.4 s in)
HUD_DENSITY :: 200.0;     // kg a cubic metre: a block
HUD_FRICTION :: 0.5;
HUD_BOUNCE :: 0.15;
HUD_BALL_DENSITY :: 40.0; // a ball of 0.3 m is 4.5 kg
HUD_BALL_FRICTION :: 0.6;
HUD_BALL_BOUNCE :: 0.55;
HUD_BALL_ROLL :: 0.06;    // metres: its rolling resistance (it loses 1.4 m/s each second it rolls)
HUD_PUSH :: 12000.0;      // newtons the character pushes a standing thing with
HUD_SHOVE :: 6.9;         // m/s: a thing already going as fast as it runs gets no more from it
HUD_PUSH_CURVE :: 12.0;   // how the push sags between the two (the engine's bd_push_share): light things are run along with, heavy ones leaned on
HUD_UPRIGHT :: 0.9962;    // the cosine of 5 degrees: a box whose axis is this near the upright rests on a face
HUD_SQUARE :: 0.9995;     // and one whose every axis is this near a world axis is a box by its corners to the character
HUD_BALL_SEGMENTS :: 14; HUD_BALL_RINGS :: 8;
HUD_BALL_VERTICES :: 588; // 14 round: two caps of 3 a segment, six bands of 6
HUD_TILT :: 2.2;          // a second: the camera closes this share of what is left of its turn
// The views the page names (103).
HUD_HOME :: 0; HUD_LOGIN :: 1; HUD_WORLD :: 2;
// The camera. Its field of view is the old HUD's: a focal length of 1.2 window heights.
HUD_FOV :: 0.7895822;     // 2 atan(1 / 2.4), radians
HUD_PIXELS :: 48.0;       // CSS pixels a metre of floor is at the home page
HUD_WORLD_FAR :: 9.5;     // metres behind the character the orbit starts at (the wheel takes it from 1.5 to 12, and into its head)
HUD_WORLD_PITCH :: 0.12;  // radians down the orbit starts at: flatter than where it rests (the engine's 0.3), so the top third of the window is sky and the sun comes up in it
HUD_GONE :: 14.0;         // a second: how fast the character's body leaves the view when the eye is in or at its head
HUD_TAP_JUMP :: 0.3;      // seconds a tap's jump is held (a tap is a whole jump, not a hop)
HUD_PI :: 3.14159265;
// The home page's ring of portals (issue 30; web/ring.coax; docs/web-world.md, "The ring"): the
// meadow with the game types round the character, before a type is picked.
HUD_RING_MSG :: 120;      // the ring is up (1) or left: "0 KIND", the type picked (the view goes through its portal) or -1
HUD_RING_KEY_MSG :: 121;  // a key of the ring's: 1 the portal to the left, 2 to the right, 3 enter the one lit, 4 the person did something else
HUD_RING_PIC_MSG :: 122;  // a type's picture, some rows of it: "PORTAL ROW ROWS" and then six hex digits a texel (red, green, blue)
HUD_RING_SAYS :: 123;     // the action that tells the page where the portals are on the screen: "STATE LIT" and a line each, "X Y WIDE" in CSS pixels, where its name goes (under its sill's middle) and how wide its picture is drawn (WIDE -1: not in view)
HUD_RING_PICK :: 124;     // the action that tells the page a portal was taken (pressed, walked into, Return): its place in the ring
HUD_RING_UP :: 0; HUD_RING_FLYING :: 1; HUD_RING_GONE :: 2;   // the ring's state, as HUD_RING_SAYS says it
HUD_RING_DRIFT :: 0.9;    // a second: until the person does something the view drifts round, closing this share of its turn to the next portal (and never slower than HUD_RING_CREEP)
HUD_RING_CREEP :: 0.06;   // radians a second
HUD_RING_DWELL :: 3.5;    // seconds the drifting view rests on a portal before it turns to the next
HUD_RING_TURN :: 5.0;     // a second: the view closes this share of its turn to the next portal
HUD_RING_FLY :: 0.7;      // seconds the view takes through a portal
HUD_RING_DAWN :: 1.2;     // seconds of the sunrise the pictures take to light
HUD_RING_SWIPE :: 40.0;   // CSS pixels a finger travels sideways for the next portal
HUD_RING_EDGE :: 96.0;    // CSS pixels from the window's side a portal's name's middle must be, to be shown whole
// The character (SrWalkTuning: 6.9 m/s, a 1.67 m jump, one air jump to 3.90 m).
HUD_STRIDE :: 4.4;        // metres of floor one loop of the run clip covers (two steps)
HUD_STILL :: 0.4;         // m/s: slower than this it stands
HUD_LAND :: 0.45;         // seconds of the landing clip a landing on the spot plays
HUD_BODY :: 0.3;          // metres: the character's radius against a wall
HUD_TALL :: 1.8;          // and its height, under a block's underside
// The grass: the engine's field, and its reveal from the character's feet.
HUD_SPREAD :: 2.0;        // seconds the grass takes from the feet to the horizon
HUD_HORIZON :: 200.0;     // metres: past this the haze has hidden the ground
// The sky: the engine's sunrise (stylized-frame.coax sty_sunrise), run once each time the world comes up.
HUD_SUNRISE :: 4.0;       // seconds from pitch black to full day
HUD_FRONT :: 2.4;         // metres: how wide the reveal's front is at the feet (it widens with distance)
HUD_RECEDE :: 1.0;        // seconds it takes to go again when the world is left
HUD_GRASS_COLS :: 480;    // the field's cells across, and deep: a blade a cell. Square: the camera looks any way
HUD_GRASS_ROWS :: 480;
HUD_GRASS_BEHIND :: 3.0;  // metres of the field behind the eye
HUD_SMALL :: 700.0;       // CSS pixels: a window narrower than this is a small one (a phone's)
HUD_GRASS_SMALL :: 190;   // a small window's field: cells across and deep, 0.2 m each (38 m square, blades to 32 m)
HUD_PART :: 0.8;          // metres round the character its feet part the grass
// The keys held (104): forward, back, left, right, jump; and the camera's, as Everglade's: turn left
// and right, tilt up and down, zoom in and out.
HUD_KEY_FORE :: 1; HUD_KEY_BACK :: 2; HUD_KEY_LEFT :: 4; HUD_KEY_RIGHT :: 8; HUD_KEY_JUMP :: 16;
HUD_KEY_TURN_LEFT :: 32; HUD_KEY_TURN_RIGHT :: 64; HUD_KEY_TILT_UP :: 128; HUD_KEY_TILT_DOWN :: 256; HUD_KEY_ZOOM_IN :: 512; HUD_KEY_ZOOM_OUT :: 1024;
HUD_KEY_DOWN :: 2048;     // Shift: descend, while flying only (it is nothing on foot: there is no walk key)
HUD_KEYS_ALL :: 4095;
HUD_FLY_SOFT :: 0.2;      // and the share of its flying speed it is taken to meet a thing with (12 m/s would send a ball off at 18)
HUD_FLY_PUSH :: 1500.0;   // newtons the character pushes a thing with while it flies: a nudge, an eighth of its shove on foot
HUD_ASSEMBLE :: 0.9;      // seconds a frame takes to draw itself in
HUD_KINDS :: 9;           // ARWES's frame families: underline, lines, corners, octagon, nero, nefrex, kranox, header, circle
HUD_SHADE :: 9;           // not a frame: a panel of words the floor is dimmed behind, so they read
// The scene's stores (coax/web/host.js): the kit's vertices, the records, the ground table, the
// character's skinned vertices and its triangles.
HUD_BALL_NEAR :: 12;         // balls drawn smooth, the nearest the character; the rest with HUD_LOW_SEGMENTS by HUD_LOW_RINGS
HUD_LOW_SEGMENTS :: 8; HUD_LOW_RINGS :: 5;
// the ground's two triangles, a patch of earth (6) under each of the village's solids, and the things at their most: all balls,
// HUD_BALL_NEAR of them smooth (588 vertices: 14 segments by 7 bands of 6) and the rest low (192)
HUD_MESH_VERTICES :: 6 + 6 * VL_SOLIDS + HUD_BALL_NEAR * 588 + (HUD_BLOCKS - HUD_BALL_NEAR) * 192 + RG_MAX * RG_VERTICES;   // (and the home page's ring)
HUD_KIT_RECORDS :: 2;        // the ground's and the blocks'
HUD_RECORDS :: HUD_KIT_RECORDS + VL_GHOST_AT + 1;   // and one a building of the village, and the building tool's ghost
HUD_RECORD_FLOATS :: 16;
HUD_DRAWS :: 12 + VL_PUT + 1;   // the ground, the blocks, the village's buildings, the ghost, the character
HUD_GROUND_HALF :: 4000.0;   // metres: half the ground part's side
HUD_GROUND_STEP :: 256.0;    // it follows the camera in steps of this

HudPanel :: struct { kind: int; x: f32; y: f32; w: f32; h: f32; t: f32; hot: f32; }   // t: how far it has drawn itself in; hot: how lit, the pointer on it
Hud :: struct {
  time: f32;
  n: int; panels: [HUD_PANELS] HudPanel;
  px: f32 = -9999; py: f32 = -9999; lit: f32;   // the pointer, and how lit its glow is
  scroll: f32;                                  // how far down the page the window is, 0 to 1
  down: f32;                                    // and in CSS pixels: the ground slides with the page
  lean: f32; tilt: f32;                         // the camera: where it is turning to (0 straight down on the grid, 1 leaned back 45 degrees) and where it is
  view: int;                                    // which page is shown
  zoom: f32;                                    // how far the camera has come down to the world's character, 0 to 1
  keys: int;                                    // the keys held, the character's while the world is shown
  observe_wait: f32; observe_seq: int; observe_on: bool; // opt-in own-frame diagnostics
  nb: int; boxes: [(HUD_BLOCKS + VL_SOLIDS) * QUERY_BOX] f32; // the world's and placed blocks' colliders
  nh: int; hulls: [HUD_BLOCKS * HUD_HULL] f32;  // boxes that have turned or tipped (their six faces),
  nc: int; balls: [HUD_BLOCKS * QUERY_CAPSULE] f32;   // and balls
  things: [1] Bodies;                           // the things themselves: the engine's rigid bodies under the page's ids, the page's axes; all shared (none is local decoration)
  past: [1] Bd_History;                         // their last second, step by step: what the page is told of their rests is read from it
  nk: int; known: [HUD_BLOCKS] HudThing;        // what the page has said of each thing, and been told
  marks_in: [HUD_MARKS] HudMark;                // (the list being read)
  nmk: int; marks: [HUD_MARKS] HudMark;         // the marks among them (hud_marker): goals, shards, boosts
  pf_n: int; pf_things: [1] PfThings;           // the platformer: the level's things its course is made of, as the page last told them (hud_plat_things)
  pf_in_n: int; pf_in: [1] PfThings;            // and the list being read
  drop: f32 = HUD_DROP;                         // how far above its place a thing the world opens with appears (the entrance: nothing placed later drops in)
  moved: bool;                                  // a thing moved this frame: the colliders and the mesh are to be made again
  twait: f32;                                   // how long until the page may be told of rests again
  want_x: f32; want_z: f32;                     // the speed the character was making for this frame, before any wall
  ground: f32;                                  // the floor or block top under the character
  told: [4] int; wait: f32; said: bool;         // where the page was last told it is, and how long until it may be told again
  told_fly: bool;                               // and whether it was told it flies
  told_y: int;                                  // and, in the platformer, how high its feet were
  action: int; outbox: [HUD_OUTBOX] u8; out_n: int;   // what the page is told now (hud-glue.js hears it)
  foot: SrOnFoot; born: bool;                   // the character on foot (the app's rules); born once its jump is tuned
  taps: int;                                    // presses of Space told since the last frame (hud_message, 104)
  fly: fly.Fly;                                 // fly mode (the engine's creative flight, move/creative-fly.coax): two quick presses of Space
  cx: f32; cz: f32; cy: f32;                    // where it stands and how high its feet are, the page's axes
  face: f32;                                    // the way it faces, radians, 0 ahead
  pace: f32;                                    // how fast it is going, 0 to 1 of a run
  land: f32;                                    // seconds left of a landing's clip
  // the world's camera: the engine's free orbit, and what turns it
  orbit: Orbit; orbiting: bool;             // live from the moment the world comes up until the camera is back at the page's view
  look_yaw: f32; look_pitch: f32;               // a mouse drag's look since the last frame, radians
  drag: bool; drag_id: int; drag_x: f32; drag_y: f32;   // the mouse held on the world, and where it was last (device pixels)
  over: bool;                                   // the press about to come began on one of the page's own things (107): not the camera's
  cam: int = -1;                                // the camera the page's camera menu picked (-1: none yet, the game type's own; 113: 0 orbit, 1 follow, 2 first person, 3 top-down; hud_cam_want)
  follow: bool;                                 // the follow camera is on (109): the camera is locked behind the character, and the keys are the character's own
  mouse: [1] ml.Mouselook;                      // first person: the pointer held (the engine's mouselook, cam/mouselook.coax): the mouse looks with no button down
  // the hotbar's build tools (docs/web-world.md, "The hotbar"): the tool picked and the thing selected are the page's (113)
  tool: int = -1; sel: int;                     // the placing tool (HUD_T_*, -1 none) and the selected thing's id (0 none)
  mode: int = HUD_M_FREE;                       // how the placing tool places (HUD_M_*): the page's, per tool
  editing: bool;                                // edit mode: a press on a thing selects it, and a drag moves it
  grav: f32 = 1; grav_n: int = 10;              // the world's gravity, as a multiple of the normal (and in tenths, as the page says it): the things' and the character's
  props: [1] Props;                             // the world's properties that differ (web/props.coax: the engine's tunables), as the page last said them (113)
  far_n: int = 950;                             // camera.distance as it was last given to the orbit, in hundredths of a metre
  held_x: f32; held_y: f32;                     // where the pointer was when a thing was picked up
  tx: f32 = -9999; ty: f32 = -9999;             // where the pointer is, device pixels, for the tool's ray
  tooling: bool; tool_id: int;                  // the tool has the pointer that is down, and which pointer
  carry: int;                                   // the move tool: the id of the thing picked up (0 none)
  edit: [64] u8; edit_n: int;                   // an edit waiting to be told to the page (HUD_EDIT)
  limit: int; atop: bool;                       // a limit just met (HUD_L_*), waiting to be told to the page in words; and the character is at the sky's limit (said once each time it gets there)
  since: f32;                                   // seconds the world has been shown this time (a settled world's things rest in place while it is under a second)
  calm: int;                                    // how the world comes up (117, HUD_CALM_MSG): 0 with its entrance; else settled, with none (bit 1 reduced motion, bit 2 a kept world come back)
  type: int;                                    // the game type (111)
  kind: int;                                    // and its camera: which of the engine's camera kinds the world is entered and played as
  village: [1] Village;                         // the medieval village: its pack, its places and its entrance (world-village.coax)
  crates: [1] Crates;                           // crates: the room, its pads and its gate (world-crates.coax)
  room_due: bool; room_whole: int;                               // crates: another room was named (HUD_ROOM_MSG): it is entered when its things are told
  plat: [1] Platformer;                         // platformer: the course, its run, its shards (world-platformer.coax)
  race: [1] Racing;                             // racing: the circuit, the car, the run (world-racing.coax)
  drift: [1] Drift;                             // drift: the ship, the rocks, the rings, the run (world-drift.coax)
  table_for: int;                               // whose ground table is in `table`: 0 none, 1 the village's, 2 the circuit's
  act: int = -1;                                // the page's count of presses of the world's own action (113: reset the room); -1 before it is first told
  fly_n: int = -1; fly_ask: bool;               // the page's count of presses of "fly" (113), -1 before it is first told; one more asks the step to fly or land
  noted: int;                                   // what the page was last told the world is (hud_says)
  line_x: f32; line_z: f32;                     // side on: a point of the line the character is held on (where it stood as the world came up)
  sticks: pad.Sticks; tap: f32;                 // a phone's thumbs (the engine's sticks), and seconds left of a tap's jump
  wide: f32; high: f32; dpr: f32 = 1;           // the picture's size in device pixels and their ratio, as the last frame had them
  gone: f32;                                    // how far the character's body is left out of the view, 0 to 1 (the eye in its head)
  spread: f32;                                  // seconds of the grass's spread so far, 0 to HUD_SPREAD
  dawn: f32;                                    // seconds of the sunrise so far, 0 (pitch black) to HUD_SUNRISE (day)
  from_x: f32; from_z: f32;                     // where it spreads from: the character's feet when it began
  blades: int;                                  // the grass blades this frame draws
  ghost: [1] Ghost;                             // its model, and the pose it is in
  bare: bool;                                   // the model is left out: not loaded, posed or drawn (the checks of the rules alone)
  // the scene's stores, its draws, and the numbers that say they changed
  mesh: [HUD_MESH_VERTICES * ARCH_VERTEX_FLOATS] f32; mesh_n: int;
  records: [HUD_RECORDS * HUD_RECORD_FLOATS] f32;
  table: [VL_TABLE_FLOATS] f32; table_gen: int; table_on: bool;   // the ground table: where no grass grows (the village's buildings)
  owner: [VL_SOLIDS] int; table_put: int = -1;   // which building (its id) each of the statics is; the buildings the ground table was made with
  quarter: int; rec_gen: int;                   // the building tools' turn (quarter turns, the page's); the records' own version (the ghost moves them alone)
  ns: int; statics: [VL_SOLIDS * QUERY_BOX] f32;                // the world's own solids (a building's boxes), the page's axes: the one list the character, the bodies, the camera, the tools' ray and the grass's mask read
  skin: [GHOST_V * HUD_SKIN_FLOATS] f32;
  tris: [GHOST_T * 3] u32; tris_n: int;
  host_draws: [HUD_DRAWS * 4] u32; draw_n: int; ghost_draw: int = -1;
  gen: int; skin_gen: int; tris_gen: int;
  stale: bool = true; built: f32 = -1;          // the mesh is to be written again; whether the things were drawn when it was (0 or 1)
  at_x: f32; at_z: f32;                         // where the ground part is
  // the app's editor (coax/world.coax: the level drawn by this scene while it is built, issue 2): nothing is
  // stepped and nobody stands in it, the camera is the editor's own, and the things it names are lit
  still: bool;                                  // the world holds still: no character, no body moves, no rule runs
  eye_on: bool; eye: StyCamera;                 // the camera is given (the engine's axes), not the orbit's
  glow_n: int; glow: [HUD_GLOWS] int; glow_a: [HUD_GLOWS] f32;   // things lit: their ids, and how lit (0 to 1)
  // the home page's ring of portals (web/ring.coax)
  ring: bool; ring_n: int;                      // it is up, and how many portals (the shared list's types, in its order)
  ring_at: int;                                 // the portal lit: the one pointed at, or the one the view looks most nearly at
  ring_idle: bool; ring_dwell: f32;             // nobody has done anything yet: the view drifts round, resting on each portal (seconds it has rested)
  ring_turn: bool;                              // the view is turning to the portal lit (an arrow, a swipe)
  ring_hover: bool;                             // the mouse has moved since a key chose: the portal under it is the one lit
  ring_down: bool; ring_id: int; ring_touch: bool; ring_x0: f32; ring_y0: f32; ring_far: f32;   // a press on the ring: whose, where it began, how far it has gone (device pixels)
  ring_pick: int = -1; ring_asked: f32;         // a portal taken, waiting to be told to the page; and seconds until walking into one may ask again
  ring_fly: f32 = -1; ring_to: int; ring_from: StyCamera;   // seconds through a portal (-1: not), which, and the camera it began from
  ring_state: int; ring_lit: f32;               // HUD_RING_*; how lit the pictures are, 0 to 1
  ring_gone: bool;                              // the ring has just gone: the page is told once
  ring_said: [RG_MAX * 24 + 16] u8; ring_said_n: int;   // what the page was last told of the portals' places
  ring_box: [RG_MAX * 4] f32;                   // each picture's box on the screen as the last frame drew it, device pixels (left, top, right, bottom; right under left: not in view)
  gates: [RG_MAX] Portal;                       // the ring as the engine's portals (world/portal.coax)
  pics: [RG_MAX * RG_PIC_W * RG_PIC_H] u32; pics_gen: int;   // the pictures' texels, a row of the store a row of a picture (THE STAND-IN: web/ring.coax)
  inbox: [HUD_INBOX] u8;
  lines: [1024] AxLine;
  points: [256] AfPoint;
}

// A thing as the page knows it: its id, how often the page has moved and sized it, and the rest the page was last told (if it has been).
HudThing :: struct { id: int; moves: int; sizes: int; said: bool; rest: [HUD_REST] int; role: int; hx: f64; hy: f64; hz: f64; }   // (and where the page last put it: its footprint's middle and its bottom, metres: a crates room reset puts it back there)
// A thing of a game type's own kind that is a mark, not a body (web/blocks.coax BL_R_*: crates' goal, the
// platformer's shard, racing's boost): nothing collides with it; the world's rules read it. The page's axes, metres.
HudMark :: struct { id: int; role: int; moves: int; x: f32; y: f32; z: f32; w: f32; h: f32; d: f32; taken: bool; ix: int; iy: int; iz: int; turn: int; }   // (and its place in hundredths as the page said it, and its turn, degrees)
HUD_MARKS :: GT_LEVEL_THINGS;   // as many as a level holds things: none is ever left out
HUD_GLOWS :: 16;          // things lit at once in the app's editor (a selection, what an agent just changed)
hud_mark_size :: (g: HudMark) -> f32 { m := ifx g.w > g.h then g.w else g.h; return ifx m > g.d then m else g.d; }
hud_marker :: (role: int) -> bool { return role == BL_R_GOAL || role == BL_R_SHARD || role == BL_R_BOOST || role == BL_R_TRACK || role == BL_R_RING || role == BL_R_GATE || role == BL_R_START; }
// A kind that holds where it is put, a fixed body: a wall, a pad, spikes, a checkpoint, a moving platform, a lift.
hud_held_role :: (role: int) -> bool { return role == BL_R_WALL || role == BL_R_PAD || role == BL_R_SPIKES || role == BL_R_CHECKPOINT || role == BL_R_SLIDER || role == BL_R_LIFT; }
HUD_MOVER :: 1;           // the character's id among the engine's movers: the one player here
HUD_CONE_REACH :: 1.6;    // metres from the car's middle a built cone is knocked away
HUD_HULL :: 27;           // numbers a turned box is to the engine's queries: 3 and 4 a face (QUERY_HULL_HEAD, QUERY_HULL_FACE)
HUD_REST :: 8;            // numbers a thing's rest is told in: x, y, z, w, h, d, turn, tipped

HudOut :: struct { v: [] f32; n: int; }

hud_vertex :: (o: [] HudOut, x: f32, y: f32, a: f32, d: f32, hw: f32) {
  at := o[0].n * HUD_FLOATS;
  if at + HUD_FLOATS > o[0].v.count { return; }
  o[0].v[at] = x; o[0].v[at + 1] = y;
  o[0].v[at + 2] = 1; o[0].v[at + 3] = 1; o[0].v[at + 4] = 1; o[0].v[at + 5] = a;
  o[0].v[at + 6] = d; o[0].v[at + 7] = hw;
  o[0].n += 1;
}
// A stroke from a to b, `width` wide: two triangles a pixel wider each side, for its soft edge.
hud_line :: (o: [] HudOut, ax: f32, ay: f32, bx: f32, by: f32, width: f32, alpha: f32) {
  dx := bx - ax; dy := by - ay;
  run := sqrt(dx * dx + dy * dy);
  if !(run > 0.001) || !(alpha > 0.003) { return; }
  hw := ifx width < 1 then 0.5f32 else width * 0.5;
  e := hw + 1;
  nx := -dy / run * e; ny := dx / run * e;
  hud_vertex(o, ax + nx, ay + ny, alpha, e, hw); hud_vertex(o, ax - nx, ay - ny, alpha, -e, hw); hud_vertex(o, bx + nx, by + ny, alpha, e, hw);
  hud_vertex(o, bx + nx, by + ny, alpha, e, hw); hud_vertex(o, ax - nx, ay - ny, alpha, -e, hw); hud_vertex(o, bx - nx, by - ny, alpha, -e, hw);
}
// A filled triangle, hard edged.
hud_tri :: (o: [] HudOut, ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, alpha: f32) {
  if !(alpha > 0.003) { return; }
  hud_vertex(o, ax, ay, alpha, 0, 4); hud_vertex(o, bx, by, alpha, 0, 4); hud_vertex(o, cx, cy, alpha, 0, 4);
}

// One panel's frame, `t` of the way through its assembly, in device pixels.
hud_frame_of :: (h: [] Hud, o: [] HudOut, p: HudPanel, d: f32) {
  if p.kind < 0 || p.kind >= HUD_KINDS || !(p.w > 4 && p.h > 4) { return; }
  s := af_settings(p.kind);
  s.square *= d; s.corner_length *= d; s.corner_width *= d; s.large_line_length *= d; s.small_line_length *= d;
  s.side_width *= d; s.deco_width *= d; s.stroke *= d; s.large_line_width *= d; s.small_line_width *= d;
  b := HudBox.{x = p.x * d, y = p.y * d, width = p.w * d, height = p.h * d};
  pts := h[0].points[..];
  n := af_frame_settings(p.kind, b, s, p.t, pts);
  start := 0;
  for i: 0..<n {
    if pts[i].move { start = i; }
    last := i + 1 == n || pts[i + 1].move;
    if last && pts[start].fill {
      // a filled path: a fan from its first point (the families' fills are plates and small marks)
      a := pts[start].alpha * (ifx pts[start].layer == 2 then 0.5f32 else 0.03f32);
      for k: start + 1..<i { hud_tri(o, pts[start].x, pts[start].y, pts[k].x, pts[k].y, pts[k + 1].x, pts[k + 1].y, a); }
    }
    if i > start && !pts[start].fill {
      w := ifx pts[i].stroke > 0 then pts[i].stroke else d;
      a := pts[i].alpha * ((ifx pts[i].layer == 2 then 0.5f32 else 0.3f32) + 0.3 * p.hot);
      hud_line(o, pts[i - 1].x, pts[i - 1].y, pts[i].x, pts[i].y, w, a);
    }
  }
  // lit: a small cross outside each corner, as a sight closing on it
  if p.hot > 0.02 {
    g := (9 - 3 * p.hot) * d; r := 3 * d;
    for c: 0..<4 {
      x := ifx (c & 1) == 0 then b.x - g else b.x + b.width + g; y := ifx (c & 2) == 0 then b.y - g else b.y + b.height + g;
      hud_line(o, x - r, y, x + r, y, d, 0.4 * p.hot); hud_line(o, x, y - r, x, y + r, d, 0.4 * p.hot);
    }
  }
}

// The window's own mark: down the right, where the window is on the page.
hud_chrome :: (h: [] Hud, o: [] HudOut, w: f32, ht: f32, d: f32) {
  m := 14 * d;
  top := 2 * m; run := ht - 4 * m;
  hud_line(o, w - m * 0.5, top, w - m * 0.5, top + run, d, 0.08);
  at := top + run * h[0].scroll;
  hud_line(o, w - m * 0.5 - 8 * d, at, w - m * 0.5, at, d, 0.6);
}

// Whether the level's boxes are the platformer's course (its platforms, pads, checkpoints, moving platforms,
// lifts and spikes): the course draws them and says where they are solid, and the bodies are only what a
// tool selects and moves.
hud_plat_owns :: (h: [] Hud) -> bool { return h[0].type == HUD_PLATFORMER && h[0].plat[0].ok; }
// What stands in the world, for the engine's queries: the things, on flat ground at 0 (the platformer's ground falls away: pf_ground).
hud_colliders :: (h: [] Hud) -> Colliders {
  return Colliders.{ground = ifx h[0].type == HUD_PLATFORMER then pf_ground(h[0].plat[..]) else 0.0f32, ground_enabled = true, boxes = h[0].boxes[0..<h[0].nb * QUERY_BOX], hulls = h[0].hulls[0..<h[0].nh * HUD_HULL], capsules = h[0].balls[0..<h[0].nc * QUERY_CAPSULE]};
}
// The things as the engine's colliders, where they are now: a box that stands square is a box by
// its corners, one that has turned or tipped is a hull of its six faces, a ball is a capsule of no
// length. Made again whenever a thing has moved.
hud_solids :: (h: [] Hud) {
  b := h[0].things[..]; s := b[0].set[..];
  h[0].nb = 0; h[0].nh = 0; h[0].nc = 0;
  for i: 0..<bd_count(b) {
    p := s[0].pos[i];
    if b[0].kind[i] == Bd_Kind.ball {
      o := h[0].nc * QUERY_CAPSULE; r := cast(f32) b[0].half[i].x;
      h[0].balls[o] = cast(f32) p.x; h[0].balls[o + 1] = cast(f32) p.y; h[0].balls[o + 2] = cast(f32) p.z;
      h[0].balls[o + 3] = cast(f32) p.x; h[0].balls[o + 4] = cast(f32) p.y; h[0].balls[o + 5] = cast(f32) p.z; h[0].balls[o + 6] = r;
      h[0].nc += 1;
      continue;
    }
    // (the platformer's boxes are its course's: where they are now is the course's to say, pf_solids below)
    if hud_plat_owns(h) { continue; }
    q := s[0].att[i]; half := b[0].half[i];
    axes := [3] D3.[dq_rotate(q, D3_X), dq_rotate(q, D3_Y), dq_rotate(q, D3_Z)];
    square := true;
    for a: axes { if fmax(fmax(abs(a.x), abs(a.y)), abs(a.z)) < HUD_SQUARE { square = false; } }
    if square {
      e := bd_extent(b, i); o := h[0].nb * QUERY_BOX;
      h[0].boxes[o] = cast(f32) (p.x - e.x); h[0].boxes[o + 1] = cast(f32) (p.y - e.y); h[0].boxes[o + 2] = cast(f32) (p.z - e.z);
      h[0].boxes[o + 3] = cast(f32) (p.x + e.x); h[0].boxes[o + 4] = cast(f32) (p.y + e.y); h[0].boxes[o + 5] = cast(f32) (p.z + e.z);
      h[0].nb += 1;
      continue;
    }
    e := bd_extent(b, i); o := h[0].nh * HUD_HULL;
    h[0].hulls[o] = 6; h[0].hulls[o + 1] = cast(f32) (p.y - e.y); h[0].hulls[o + 2] = cast(f32) (p.y + e.y);
    for f: 0..<6 {
      a := axes[f / 2]; reach := ifx f / 2 == 0 then half.x else ifx f / 2 == 1 then half.y else half.z;
      n := ifx f % 2 == 0 then a else d3_neg(a);
      at := o + QUERY_HULL_HEAD + f * QUERY_HULL_FACE;
      h[0].hulls[at] = cast(f32) n.x; h[0].hulls[at + 1] = cast(f32) n.y; h[0].hulls[at + 2] = cast(f32) n.z; h[0].hulls[at + 3] = cast(f32) (d3_dot(n, p) + reach);
    }
    h[0].nh += 1;
  }
  // and what stands in the world itself: the village's buildings, once they have risen
  for k: 0..<h[0].ns * QUERY_BOX { h[0].boxes[h[0].nb * QUERY_BOX + k] = h[0].statics[k]; }
  h[0].nb += h[0].ns;
}
// The world's own solids, made again (when a building has risen, the pack has come in, the game type
// has changed): the one list of boxes (vl_solids: each building's model's solids). They are the
// character's and the camera's colliders (hud_solids), the rigid bodies' walls (the engine's
// bd_wall: a ball bounces off a house and a block lands on its roof), what the tools' ray meets
// (hud_pick), and where no grass grows (the engine's ground table, from every building's solids,
// risen or not, with earth under them).
hud_statics :: (h: [] Hud) {
  v := h[0].village[..]; b := h[0].things[..];
  h[0].ns = ifx h[0].type == HUD_VILLAGE then vl_solids_of(v, h[0].statics[..], h[0].owner[..]) else ifx h[0].type == HUD_CRATES then cr_solids(h[0].crates[..], h[0].statics[..]) else ifx h[0].type == HUD_PLATFORMER then pf_solids(h[0].plat[..], h[0].cz, h[0].statics[..]) else 0;
  bd_walls_clear(b);
  for k: 0..<h[0].ns { x := h[0].statics[k * QUERY_BOX..<(k + 1) * QUERY_BOX]; w := bd_wall(b, hud_d3(x[0], x[1], x[2]), hud_d3(x[3], x[4], x[5])); }
  // (the racing circuit's table: grass everywhere but on and by its ribbon, world-racing.coax rc_ground;
  // the village's again when the placed buildings change: no grass inside them either)
  want := ifx h[0].type == HUD_VILLAGE && v[0].ready then 1 else ifx h[0].type == HUD_RACING && h[0].race[0].ok then 2 else 0;
  if want != h[0].table_for || (want == 1 && h[0].table_put != v[0].put_gen) {
    h[0].table_for = want; h[0].table_on = want != 0; h[0].table_put = v[0].put_gen;
    if want == 1 { all: [VL_SOLIDS * QUERY_BOX] f32; n := vl_all_solids(v, all[..]); vl_ground(all[0..<n * QUERY_BOX], h[0].table[..]); h[0].table_gen += 1; }
    if want == 2 { rc_ground(h[0].race[..], h[0].table[..]); h[0].table_gen += 1; }
  }
  hud_solids(h); h[0].stale = true;
}
// The floor feet at `feet` can stand on at a point: the ground, or a block's top no more than a step up.
hud_floor :: (h: [] Hud, x: f32, z: f32, feet: f32) -> f32 { return query_stand(hud_colliders(h), x, z, feet, HUD_BODY * 0.6).y; }
// The walls have their say (as coax/her.coax's her_slide): the character moved by (dx, dz) from
// (x0, z0), stopped by what the engine's sweep meets and slid along it. Where it got to.
hud_slide :: (h: [] Hud, x0: f32, z0: f32, feet: f32, dx: f32, dz: f32) -> [2] f32 {
  c := hud_colliders(h);
  x := x0; z := z0; bx := dx; bz := dz;
  for pass: 0..<3 {
    if bx * bx + bz * bz < 0.0000001 { break; }
    from := WorldPoint.{x = x, y = feet + HUD_BODY + 0.32, z = z};   // above what it steps over
    hit := query_sweep(c, from, HUD_BODY, WorldPoint.{x = bx, y = 0, z = bz});
    if hit.status != QueryStatus.ok { break; }
    if !hit.hit { x += bx; z += bz; break; }
    mag := sqrt(bx * bx + bz * bz);
    t := hit.t - 0.02 / mag; if t < 0 { t = 0; }
    x += bx * t; z += bz * t;
    nx := hit.normal.x; nz := hit.normal.z;
    nl := sqrt(nx * nx + nz * nz);
    if nl < 0.0001 { break; }
    nx /= nl; nz /= nl;
    rx := bx * (1 - t); rz := bz * (1 - t);
    into := rx * nx + rz * nz;
    if into > 0 { break; }
    bx = rx - nx * into; bz = rz - nz * into;
  }
  // and the engine's walker pushes its whole body (feet to head) out of any block it is still in:
  // one put where it stands, or one that hangs at the height of its head
  // (a box that stands square by collide_walls, one that has turned or tipped by its faces, a ball by its round)
  profile := CollideProfile.{radius = HUD_BODY, height = HUD_TALL};
  out := collide_walls(c, profile, CollideState.{feet = WorldPoint.{x = x, y = feet, z = z}});
  out = collide_hulls(c, profile, out).state;
  out = collide_bodies(c, profile, out, dx, dz).state;
  return [2] f32.[out.feet.x, out.feet.z];
}

// The character's step: the keys held move it, only while the world is shown, by the app's rules on
// foot (as coax/her.coax runs them: the walk, then the walls, then the jump over the floor found
// under it). Forward is ahead; a diagonal is no faster; it turns to face the way it goes; the jump
// key jumps, and once more in the air; a block is a wall, or ground to land on and walk off. Then
// the clip that shows it: the air loop off the floor, the landing after it when it lands on the
// spot, the run by the ground it covers, else idle.
hud_walk :: (h: [] Hud, step: f32) {
  if h[0].type == HUD_RACING { hud_race_feet(h); return; }   // (racing: no one walks; the camera follows the car)
  if h[0].type == HUD_DRIFT { hud_drift_feet(h); return; }   // (drift: nor here; the camera follows the ship)
  t := hud_tuning(h);
  if !h[0].born { h[0].foot.jump = sr_her_jump(0, t); h[0].born = true; }
  ground: f32 = 0;
  if h[0].view == HUD_WORLD {
    k := h[0].keys;
    // (a world with no jump: the keys that jump and fly are nothing there, and nothing flies)
    if hud_no_jump(h) { k &= HUD_KEYS_ALL - HUD_KEY_JUMP - HUD_KEY_DOWN; h[0].taps = 0; h[0].tap = 0; h[0].sticks.jump = false; h[0].fly = fly.fly_stop(h[0].fly); }
    go := hud_axis(k, HUD_KEY_FORE, HUD_KEY_BACK) + h[0].sticks.pad_y;
    // the rules' side is to the walker's right in a world whose x runs the other way: left here is +1
    side := hud_axis(k, HUD_KEY_LEFT, HUD_KEY_RIGHT) - h[0].sticks.pad_x;
    jump := (k & HUD_KEY_JUMP) != 0;
    // the game type's keys. Top down, the camera never turns, so the arrows run too: every key is a
    // direction on the screen. Side on, the character runs only along its line: A, D and the arrows
    // left and right run it, and W, the up arrow and a thumb pushed up jump
    kd := hud_camera_kind(h);
    if h[0].kind == CAM_KIND_TOP { go += hud_axis(k, HUD_KEY_TILT_UP, HUD_KEY_TILT_DOWN); side += hud_axis(k, HUD_KEY_TURN_LEFT, HUD_KEY_TURN_RIGHT); }
    if kd.planar { side += hud_axis(k, HUD_KEY_TURN_LEFT, HUD_KEY_TURN_RIGHT); jump = jump || go > 0.5 || (k & HUD_KEY_TILT_UP) != 0; go = 0; }
    go = clamp(go, -1, 1); side = clamp(side, -1, 1);
    // ahead is away from the camera: the rules' view is the orbit's, in the page's axes. The body
    // keeps the way it faces while the camera turns round it: only steering turns it
    was := h[0].foot.walk;
    view := ifx h[0].orbiting then wrap_angle(HUD_PI - h[0].orbit.yaw) else 0.0f32;
    // the follow camera: the body and the view are locked together (as mouselook locks them), so the
    // body turns with the view and the keys are the character's own: W ahead, S backs up still facing
    // ahead, and A and D turn it (hud_orbit: they turn the view), never a step to the side
    locked := h[0].follow && h[0].orbiting && h[0].kind == CAM_KIND_THIRD;
    if locked { side = 0; } else { was.face_off = wrap_angle(was.face_off - wrap_angle(view - was.yaw)); }
    was.yaw = view;
    // a tap on a phone's look side is a whole jump
    if h[0].sticks.jump { h[0].tap = HUD_TAP_JUMP; }
    if h[0].tap > 0 { h[0].tap -= step; }
    j := h[0].foot.jump;
    // (each press of Space told since the last frame, in order: let go, then down, so a tap shorter than a frame counts)
    space := (k & HUD_KEY_JUMP) != 0; sink := (k & HUD_KEY_DOWN) != 0;
    ft: fly.FlyTuning; toggled := false;
    may := hud_may_fly(h);   // (player.fly: with it off, as side on, a second press is no flight)
    for e: 0..<h[0].taps {
      j = sr_jump_press(sr_jump_press(j, false), true);
      if may { up := fly.fly_press(fly.fly_press(h[0].fly, false, ft).fly, true, ft); h[0].fly = up.fly; toggled = toggled != up.toggled; }
    }
    h[0].taps = 0;
    // "fly" pressed on the hotbar (or from its palette): flight turns on or off as a double Space would
    if h[0].fly_ask { h[0].fly_ask = false; if may { h[0].fly.on = !h[0].fly.on; h[0].fly.since = fly.FLY_NEVER; toggled = !toggled; } }
    j = sr_jump_press(j, jump || h[0].tap > 0);
    j.air_jumps = t.air_jumps;
    // fly mode (the engine's creative flight): Space pressed twice quickly turns it on and off, in
    // every game type but the side-scroller. The press that toggles it is no jump
    if !may { h[0].fly = fly.fly_stop(h[0].fly); }
    else {
      pr := fly.fly_press(h[0].fly, space, ft);
      h[0].fly = fly.fly_tick(pr.fly, step);
      if toggled != pr.toggled { j.presses.waiting = 0; j.waiting_time = 0; j.vy = 0; j.on_ground = false; }
    }
    flying := h[0].fly.on;
    n := sr_walk_step(was, go, side, sr_walk_pace(h[0].foot.stance, t), sr_jump_airborne(j), t, step);
    if flying {
      // level by the keys, the way the walk reads them (ahead is away from the camera), at the
      // flying speed and at once: no run-up, and a stop on letting go. It still turns to face its way
      v := fly.fly_velocity(sin(was.yaw) * go - cos(was.yaw) * side, cos(was.yaw) * go + sin(was.yaw) * side, space, sink, ft);
      n.vx = v.x; n.vz = v.z; n.speed = sqrt(v.x * v.x + v.z * v.z);
      n.x = was.x + v.x * step; n.z = was.z + v.z * step;
    }
    if locked { n.face_off = was.face_off; }   // steering does not turn it away from the view: backing up, it still faces ahead
    // the speed it is making for, before any wall: what it pushes things with
    h[0].want_x = n.vx; h[0].want_z = n.vz;
    at := hud_slide(h, was.x, was.z, j.y, n.x - was.x, n.z - was.z);
    // side on, it is held on its line (the engine's: cam_kind_line, in the engine's axes), whatever pushed it
    if kd.planar && h[0].orbiting { on := cam_kind_line(kd, v3(at[0], 0, -at[1]), v3(h[0].line_x, 0, -h[0].line_z), HUD_PI); at[0] = on.x; at[1] = -on.z; }
    if step > 0 && (at[0] != n.x || at[1] != n.z) {
      // a wall took some of the step: it keeps only the speed it really made
      n.vx = (at[0] - was.x) / step; n.vz = (at[1] - was.z) / step; n.speed = sqrt(n.vx * n.vx + n.vz * n.vz);
      // (and no more than it was making for: a block that landed on it and pushed it aside moved it, but did not throw it)
      wanted := sqrt(h[0].want_x * h[0].want_x + h[0].want_z * h[0].want_z);
      if n.speed > wanted { less := ifx n.speed > 0 then wanted / n.speed else 0.0f32; n.vx *= less; n.vz *= less; n.speed = wanted; }
    }
    n.x = at[0]; n.z = at[1];
    ground = hud_floor(h, n.x, n.z, j.y);
    if flying {
      // no gravity, whatever the world's: up while Space is held, down while Shift is, else level.
      // The ground and a thing's top stop it; sinking onto one ends the flight
      up := fly.fly_velocity(0, 0, space, sink, ft).y;
      j.prev_y = j.y; j.y += up * step; j.vy = up; j.on_ground = false; j.presses.waiting = 0; j.waiting_time = 0; j.landed = false;
      if j.y <= ground {
        j.y = ground;
        h[0].fly = fly.fly_ground(h[0].fly, true, sink && !space);
        if !h[0].fly.on { j.on_ground = true; j.landed = true; j.impact = 0; }
      }
    } else { j = sr_jump_advance(j, t, ground, step); }
    // its head under a block: it rises no further
    if j.vy > 0 {
      for i: 0..<h[0].nb {
        b := h[0].boxes[i * QUERY_BOX..<(i + 1) * QUERY_BOX];
        if n.x > b[0] && n.x < b[3] && n.z > b[2] && n.z < b[5] && j.prev_y + HUD_TALL <= b[1] + 0.05 && j.y + HUD_TALL > b[1] {
          j.y = b[1] - HUD_TALL; j.vy = 0; if j.prev_y > j.y { j.prev_y = j.y; }
        }
      }
    }
    // the sky's limit: it rises no higher than HUD_SKY over the ground (with no gravity a jump would never end)
    if j.y > HUD_SKY { j.y = HUD_SKY; if j.prev_y > j.y { j.prev_y = j.y; } if j.vy > 0 { j.vy = 0; } if !h[0].atop { h[0].atop = true; h[0].limit = HUD_L_SKY; } }
    if j.y < HUD_SKY - 1 { h[0].atop = false; }
    // (flying, it is drawn where it is: its steps are the frame's own, with nothing between to blend)
    if flying { j.prev_y = j.y; j.vy = 0; j.clock = 0; }
    h[0].foot.walk = n; h[0].foot.jump = j; h[0].foot.stance = sr_stance_tick(h[0].foot.stance, step);
  } else {
    // anywhere else it stands where it was, on what is under it
    ground = hud_floor(h, h[0].foot.walk.x, h[0].foot.walk.z, h[0].foot.jump.y);
    h[0].foot.walk.vx = 0; h[0].foot.walk.vz = 0; h[0].foot.walk.speed = 0;
    h[0].want_x = 0; h[0].want_z = 0;
    h[0].foot.jump = sr_her_jump(ground, t);
    h[0].fly = fly.fly_stop(h[0].fly); h[0].taps = 0;
  }
  w := h[0].foot.walk;
  h[0].cx = w.x; h[0].cz = w.z; h[0].cy = sr_feet_y(h[0].foot, ground, t); h[0].ground = ground;
  h[0].face = sr_face_yaw(w);
  ease := step * 10; if ease > 1 { ease = 1; }
  h[0].pace += (w.speed / t.walk_speed - h[0].pace) * ease;
  // its clip
  if h[0].bare || (h[0].zoom <= 0.003 && h[0].view != HUD_WORLD) { return; }   // not seen: nothing is posed (or loaded)
  g := h[0].ghost[..];
  if !ghost_load(g) { return; }
  air := sr_jump_airborne(h[0].foot.jump);
  if h[0].foot.jump.landed { h[0].land = ifx w.speed < 1.5 then f32(HUD_LAND) else 0.0f32; }
  if air || w.speed >= 1.5 { h[0].land = 0; }
  if air { ghost_play(g, GHOST_AIR, step, step, 0.14, true); }
  else if h[0].land > 0 { h[0].land -= step; ghost_play(g, GHOST_LAND, step, step, 0.08, false); }
  else if w.speed > HUD_STILL { ghost_play(g, GHOST_RUN, w.speed * step / HUD_STRIDE * g[0].seconds[GHOST_RUN], step, 0.16, true); }
  else { ghost_play(g, GHOST_IDLE, step, step, 0.25, true); }
  ghost_skin(g);
  // the platformer's hero: solid, in the runner's livery, its head, hands and feet swollen (the engine's render/livery.coax)
  if hud_hero(h) { ghost_paint(g, LIVERY_RUNNER); ghost_swell(g); }
}
// Whether the character is drawn as a hero, solid and in a livery (the platformer's), not as a ghost.
hud_hero :: (h: [] Hud) -> bool { return h[0].type == HUD_PLATFORMER; }

// The app's walk and jump rules as this world tunes them: their own numbers, the gravity (rising
// and falling) the world's multiple of theirs. A jump is as fast off the ground as ever, so it goes
// higher and longer in light gravity and is short and heavy in strong.
// The air jump is the side-scroller's alone: in the other game types a second quick press of Space is fly mode.
// The registry's part (web/props.coax): how fast it runs, how high it jumps (a jump's height goes as
// its speed squared), and how many jumps it has in the air. While it may fly, the second press is
// flight's and there is no air jump; with flying off, or side on, the air jump is back.
hud_tuning :: (h: [] Hud) -> SrWalkTuning {
  t: SrWalkTuning; t.gravity *= h[0].grav;
  p := h[0].props[..];
  if pr_changed(p, TW_RUN_SPEED) { t.walk_speed = cast(f32) pr_value(p, TW_RUN_SPEED) * 0.01; }
  if pr_changed(p, TW_JUMP_HEIGHT) { t.jump_speed *= sqrt(cast(f32) pr_value(p, TW_JUMP_HEIGHT) / cast(f32) TW_ROWS[TW_JUMP_HEIGHT].def); }
  t.air_jumps = ifx hud_may_fly(h) then 0 else pr_value(p, TW_AIR_JUMPS);
  return t;
}
// Whether fly mode may be turned on: player.fly, and never side on.
hud_may_fly :: (h: [] Hud) -> bool { return !cam_kind(h[0].kind).planar && pr_value(h[0].props[..], TW_FLY) != 0; }
// The lens: camera.fov when it is set, else the game type's own.
hud_lens :: (h: [] Hud) -> f32 { return ifx pr_changed(h[0].props[..], TW_FOV) then cast(f32) pr_value(h[0].props[..], TW_FOV) * 0.01745329252f32 else ifx h[0].type == HUD_PLATFORMER && h[0].kind == CAM_KIND_SIDE then f32(PF_LENS) else cam_kind(h[0].kind).fov; }
// A thing's material as the registry has it for that thing (its own, its kind's, every thing's, else the
// world's own numbers): made again for any body that is not as it says. With nothing set, nothing is touched.
// world.physics off is every thing fixed at once (the engine's density of nothing): nothing falls or is pushed and
// each holds where it is, the character still walks on them; on again, each is its own again and falls from there.
HudStuff :: struct { density: f64; friction: f64; bounce: f64; }
hud_stuff :: (h: [] Hud, id: int, kind: int, role: int) -> HudStuff {
  p := h[0].props[..];
  // (in the platformer what is built stays where it is put: there is no ground under the course for it to fall to;
  // and a wall, a pad, spikes or a checkpoint holds where it is in any world)
  held := pr_thing(p, TW_FIXED, id, kind) != 0 || pr_value(p, TW_PHYSICS) == 0 || h[0].type == HUD_PLATFORMER || h[0].type == HUD_DRIFT || hud_held_role(role);
  m := HudStuff.{density = ifx held then 0.0 else cast(f64) pr_thing(p, TW_DENSITY, id, kind),
                 friction = cast(f64) pr_thing(p, TW_FRICTION, id, kind) / 100.0, bounce = cast(f64) pr_thing(p, TW_BOUNCE, id, kind) / 100.0};
  // (crates: a plain block is a crate, heavy and dull, unless the registry was set another for it: world-crates.coax CR_DENSITY)
  if h[0].type == HUD_CRATES && kind == PR_BLOCK && role == 0 {
    if !held && pr_thing(p, TW_DENSITY, id, kind) == pr_plain(p, TW_DENSITY, kind) { m.density = CR_DENSITY; }
    if pr_thing(p, TW_FRICTION, id, kind) == pr_plain(p, TW_FRICTION, kind) { m.friction = CR_FRICTION; }
    if pr_thing(p, TW_BOUNCE, id, kind) == pr_plain(p, TW_BOUNCE, kind) { m.bounce = CR_BOUNCE; }
  }
  return m;
}
hud_materials :: (h: [] Hud) {
  b := h[0].things[..];
  for i: 0..<bd_count(b) {
    m := hud_stuff(h, b[0].id[i], ifx b[0].kind[i] == Bd_Kind.ball then PR_BALL else PR_BLOCK, hud_role(h, b[0].id[i]));
    if b[0].friction[i] != m.friction || b[0].bounce[i] != m.bounce || b[0].set[0].mass[i] != m.density * bd_volume(b[0].kind[i], b[0].half[i]) { bd_material(b, i, m.density, m.friction, m.bounce); }
  }
}
// The world's properties changed (or may have): each rule that keeps a number of its own takes the
// registry's. Gravity is the engine's scene setting for the things (a change wakes them) and the
// walk rules' own for the character (hud_tuning); at none nothing falls.
hud_tune :: (h: [] Hud) {
  p := h[0].props[..];
  g := pr_value(p, TW_GRAVITY);
  if g != h[0].grav_n * 10 {
    h[0].grav_n = g / 10; h[0].grav = cast(f32) g * 0.01;
    bd_gravity(h[0].things[..], ifx g == 100 then f64(HUD_GRAVITY) else ifx g == 0 then 0.0 else HUD_GRAVITY * cast(f64) g / 100.0);
  }
  hud_materials(h);
  // the camera's distance is given to the orbit when it is set (the wheel zooms from there; the game type keeps its own range)
  far := pr_value(p, TW_DISTANCE);
  if far != h[0].far_n { h[0].far_n = far; if h[0].orbiting && !metaverse_orbit_inside(h[0].orbit) { h[0].orbit.want = cast(f32) far * 0.01; } }
}
// One held key against another: 1, -1 or nothing.
hud_axis :: (keys: int, plus: int, minus: int) -> f32 { return (ifx (keys & plus) != 0 then 1.0f32 else 0.0f32) - (ifx (keys & minus) != 0 then 1.0f32 else 0.0f32); }
// The character's feet in the engine's axes (the page's z turned).
hud_feet :: (h: [] Hud) -> Point { return v3(h[0].cx, h[0].cy, -h[0].cz); }
// What the camera is given to follow: the character; in crates the middle of the room, so the top-down view holds the whole room still.
hud_cam_feet :: (h: [] Hud) -> Point { if h[0].type != HUD_CRATES { return hud_feet(h); } m := cr_mid(h[0].crates[..]); return v3(m.x, 0, -m.z); }
// The puzzle is a board, not a camera chase: its eight outer corners must
// remain visible in portrait as well as landscape. The engine fits the same
// orbit (including its shoulder), retaining the top-down bearing and lens.
hud_crate_corners :: (h:[]Hud)->[8]FrameSubject {
  points:[8]FrameSubject;m:=cr_mid(h[0].crates[..]);half:=cr_half(h[0].crates[..]);hx:=half.x;hz:=half.z;
  for i:0..<8 {points[i]=FrameSubject.{at=v3(m.x+(ifx (i&1)==0 then -hx else hx),ifx (i&2)==0 then 0 else f32(CR_WALL),-m.z+(ifx (i&4)==0 then -hz else hz))};}return points;
}
hud_camera_kind :: (h:[]Hud)->CamKind {
  kd:=cam_kind(h[0].kind);if h[0].type!=HUD_CRATES || !h[0].crates[0].ok {return kd;}
  aspect:=ifx h[0].high>0 && h[0].wide>0 then cast(f32)h[0].wide/cast(f32)h[0].high else 1.6f32;
  points:=hud_crate_corners(h);orbit:=cam_kind_start(kd,hud_cam_feet(h),HUD_PI);
  fit:=frame_orbit_fit(orbit,points[..],FrameLens.{fov=kd.fov,aspect=aspect},FrameRect.{x0=-0.88,x1=0.88,y0=-0.82,y1=0.82},kd.far,120);
  if fit.fits {kd.near=fit.distance;kd.far=fit.distance;kd.dist=fit.distance;kd.zooms=false;}return kd;
}
// The world's camera this frame: the engine's free orbit, stepped as Everglade steps it. It starts
// as the world comes up: behind the character, HUD_WORLD_FAR back, looking the way W runs. A look
// or a zoom is taken from the world's first frame, while the camera is still coming down (nothing
// is held for the entrance: hud_looks); on the way back up when the world is left, it only follows. Its room: before the blocks, and above the
// ground (a slab the eye keeps the orbit's clearance over), by the orbit's own room and limit.
hud_orbit :: (h: [] Hud, step: f32) {
  world := h[0].view == HUD_WORLD;
  if !h[0].orbiting {
    if !world { h[0].look_yaw = 0; h[0].look_pitch = 0; return; }
    // the game type's camera, the engine's (cam/kinds.coax): where its orbit starts is where the entrance ends.
    // Ahead is the engine's yaw pi (its yaw 0 faces its +z: the page's behind). Third person keeps
    // this page's own distance, and the kinds that look start flat enough to see the sun come up
    kd := hud_camera_kind(h);
    o := cam_kind_start(kd, hud_cam_feet(h), HUD_PI);
    if h[0].kind == CAM_KIND_THIRD { o.want = cast(f32) pr_value(h[0].props[..], TW_DISTANCE) * 0.01; o.zoom = HUD_WORLD_FAR; }
    if h[0].type == HUD_CRATES { o.want = kd.far; o.zoom = kd.far; }   // the whole room, from the kind's furthest
    if kd.looks { o.pitch = HUD_WORLD_PITCH; }
    if h[0].ring { o.want = hud_ring_back(h); o.zoom = o.want; }   // (the ring: far enough back for a whole portal)
    // (drift: the view is the ship's aim from the first frame, so it starts behind the ship, looking the way it faces)
    if h[0].type == HUD_DRIFT && h[0].drift[0].ok { f := dr_ahead(h[0].drift[..]); o.yaw = yaw_of(f[0], f[2]); }
    o.shown = metaverse_orbit_ray(o).far;
    h[0].orbit = o; h[0].orbiting = true; h[0].gone = 0;
    h[0].line_x = h[0].cx; h[0].line_z = h[0].cz;
  }
  if !world && h[0].zoom <= 0 { h[0].orbiting = false; h[0].drag = false; return; }
  in: CamChaseIn;
  in.feet = hud_cam_feet(h); in.heading = HUD_PI - h[0].face; in.moving = h[0].foot.walk.speed > 0.6;
  o := h[0].orbit;
  kd := hud_camera_kind(h);
  if world {
    k := h[0].keys;
    in.look_yaw = h[0].look_yaw + h[0].sticks.dyaw; in.look_pitch = h[0].look_pitch + h[0].sticks.dpitch;
    in.turn = hud_axis(k, HUD_KEY_TURN_LEFT, HUD_KEY_TURN_RIGHT); in.tilt = hud_axis(k, HUD_KEY_TILT_UP, HUD_KEY_TILT_DOWN);
    in.zoom = hud_axis(k, HUD_KEY_ZOOM_OUT, HUD_KEY_ZOOM_IN);
    if h[0].type == HUD_RACING { in.turn = 0; in.tilt = 0; }   // (the arrows drive the car)
    o = cam_kind_pinch(kd, o, h[0].sticks.zoom);
  }
  h[0].look_yaw = 0; h[0].look_pitch = 0;
  // the follow camera: locked behind the character. Turned on, the view swings round to the
  // character's back (the way it faces is kept, the turn between it and the view closed fast), and
  // from then the two are one: A and D and a thumb pushed sideways turn the view as the arrows do
  // (the orbit's own key turn), a drag turns it, and the body faces the way the view looks
  locked := h[0].follow && world && h[0].kind == CAM_KIND_THIRD && !h[0].ring;
  if locked {
    off := h[0].foot.walk.face_off;
    d := off * (ifx step * HUD_SWING < 1 then step * HUD_SWING else 1.0f32);
    if abs(off) < 0.002 { d = off; }
    o.yaw = wrap_angle(o.yaw - d); h[0].foot.walk.face_off = off - d;
    in.turn = clamp(in.turn + hud_axis(h[0].keys, HUD_KEY_LEFT, HUD_KEY_RIGHT) - h[0].sticks.pad_x, -1, 1);
  }
  // the frame's input as the game type takes it, the orbit's step, and the orbit held to its type
  mode: CamMode;
  o = cam_kind_keep(kd, cam_chase_orbit(mode, o, cam_kind_in(kd, in), step), HUD_PI);
  if h[0].type == HUD_RACING { o = hud_race_chase(h, o, step); }
  // what stands in the way, in the engine's axes: the blocks, and the ground as a slab
  boxes: [(HUD_BLOCKS + VL_SOLIDS + 1) * 6] f32;
  // (crates: the view is from over the whole room, held on its middle: a crate dropping in there, or standing there, is not in its way)
  nbox := ifx h[0].type >= HUD_CRATES then 0 else h[0].nb;
  for i: 0..<nbox {
    b := h[0].boxes[i * QUERY_BOX..<(i + 1) * QUERY_BOX]; q := i * 6;
    boxes[q] = b[0]; boxes[q + 1] = b[1]; boxes[q + 2] = -b[5]; boxes[q + 3] = b[3]; boxes[q + 4] = b[4]; boxes[q + 5] = -b[2];
  }
  g := nbox * 6; far: f32 = 100000;
  boxes[g] = o.pivot.x - far; boxes[g + 1] = -100; boxes[g + 2] = o.pivot.z - far; boxes[g + 3] = o.pivot.x + far; boxes[g + 4] = 0; boxes[g + 5] = o.pivot.z + far;
  // (drift: no ground under the ship for the view to stop at)
  room := metaverse_orbit_room(o, boxes[0..<0], boxes[0..<(ifx h[0].type == HUD_DRIFT then g else g + 6)]);
  o = metaverse_orbit_limit(o, room, step);
  h[0].orbit = o;
  // locked, the body faces where the view looks this very frame
  if locked { h[0].foot.walk.yaw = wrap_angle(HUD_PI - o.yaw); h[0].face = sr_face_yaw(h[0].foot.walk); }
  // in its head, or the eye pulled in to its shoulders: its body leaves the view (the orbit's rule)
  // (not before the camera is nearly down: flying in to its head, the character is still seen)
  want := ifx metaverse_orbit_unseen(o) && h[0].zoom > 0.9 then 1.0f32 else 0.0f32;
  ease := step * HUD_GONE; if ease > 1 { ease = 1; }
  h[0].gone += (want - h[0].gone) * ease;
  if abs(want - h[0].gone) < 0.004 { h[0].gone = want; }
}

// The camera: the engine's (stylized-frame.coax StyCamera). On the page's own views it looks at a
// point on the floor from `high` away, leaned from straight down, never turned. In the world it is
// the orbit's shot (the engine's orbit looks along its yaw from +z, pitch down; the frame's camera
// along its yaw from -z, pitch up: the same view is pi less the yaw, and the pitch turned over).
// Between them, as far as the camera has come down (zoom), it is part of the way from one to the other.
hud_camera :: (h: [] Hud, height: f32, d: f32) -> StyCamera {
  high := height / d * 1.2 / HUD_PIXELS;       // so a metre at the point is HUD_PIXELS CSS pixels
  lean := h[0].tilt * 45 * 0.01745329;
  tz := -h[0].down / HUD_PIXELS;
  // the way it looks, the page's axes: (0, -cos lean, sin lean)
  c := StyCamera.{x = 0, y = cos(lean) * high, z = -(tz - sin(lean) * high), yaw = 0, pitch = lean - 1.5707963, fov = HUD_FOV, near = 0.1, far = 3000};
  z := h[0].zoom;
  if !h[0].orbiting || !(z > 0) { return c; }
  s := metaverse_orbit_shot(h[0].orbit);
  yaw := wrap_angle(HUD_PI - h[0].orbit.yaw);
  lens := hud_lens(h);   // the game type's lens (side on, a long one), or the one the world's settings ask for
  if z >= 1 { c.x = s.eye.x; c.y = s.eye.y; c.z = s.eye.z; c.yaw = yaw; c.pitch = -h[0].orbit.pitch; c.fov = lens; return c; }
  c.fov += (lens - c.fov) * z;
  c.x += (s.eye.x - c.x) * z; c.y += (s.eye.y - c.y) * z; c.z += (s.eye.z - c.z) * z;
  c.yaw = yaw * z;
  c.pitch += (-h[0].orbit.pitch - c.pitch) * z;
  return c;
}

// The day the sunrise ends as, and stays: the sun high and to the right of the way the camera looks,
// warm light, soft shadows, a lush meadow, and the engine's air (the sky, its sun, its clouds and
// what distance fades to all come from the sun's place: atmosphere.coax). The zenith's, horizon's
// and haze's colours below are what the look falls back to without air; with it they are not used.
hud_day :: () -> StyLook {
  l: StyLook;
  l.sun_x = 0.426; l.sun_y = 0.669; l.sun_z = -0.609; l.shadow = 0.85;     // 42 degrees up, 35 degrees right of ahead
  l.sun_r = 0.74; l.sun_g = 0.67; l.sun_b = 0.54; l.band = 0.45;
  l.sky_r = 0.27; l.sky_g = 0.34; l.sky_b = 0.4;
  l.ground_r = 0.2; l.ground_g = 0.21; l.ground_b = 0.17;
  l.zenith_r = 0.13; l.zenith_g = 0.4; l.zenith_b = 0.88;
  l.horizon_r = 0.64; l.horizon_g = 0.81; l.horizon_b = 0.96;
  l.haze_r = l.horizon_r; l.haze_g = l.horizon_g; l.haze_b = l.horizon_b; l.haze = 0.012; l.haze_start = 20; l.haze_most = 1;
  // the sky itself is the engine's atmosphere (air): its colours, its sun and its clouds come from the sun's place
  l.air = 1; l.cloud = 0.42; l.cloud_scale = 1;
  l.sun_disc = 0.017;
  // the grass is the engine's lush grass: curved blades in tufts, with their own colour and light
  l.lush = 1;
  l.blade = 0.46; l.blade_wide = 0.046; l.grass_cell = 0.16; l.grass_reach = 60;
  l.meadow_dry = 0.22;
  return l;
}
// The look `seconds` into the sunrise: the engine's sunrise to hud_day, the sun coming up dead ahead
// of the camera (the engine's -z, the way W runs). Pitch black at 0, the day at HUD_SUNRISE and after.
hud_look :: (seconds: f32) -> StyLook { return sty_sunrise(hud_day(), seconds / HUD_SUNRISE, 0, -1); }
// And as the game type has it: the village's sunrise ends in its own low morning.
hud_look_of :: (h: [] Hud) -> StyLook { if h[0].type == HUD_CRATES { return cr_look(h[0].crates[..]); } if h[0].type == HUD_PLATFORMER { return pf_look(h[0].plat[..]); } if h[0].type == HUD_RACING { return rc_look(h[0].race[..], hud_day()); } if h[0].type == HUD_DRIFT { return dr_look(h[0].drift[..]); } if h[0].type != HUD_VILLAGE { return hud_look(h[0].dawn); } return sty_sunrise(vl_day(hud_day()), h[0].dawn / HUD_SUNRISE, 0, -1); }

// How far the grass's front has come, `seconds` into its spread: nothing at the start, the horizon
// at HUD_SPREAD. The camera sits HUD_WORLD_FAR behind the feet and a metre far off is a few pixels,
// so the front runs faster the further it has gone: the reciprocal of its distance from the camera
// falls evenly with time, and on the screen it is seen to climb to the horizon at a steady pace.
hud_front :: (seconds: f32) -> f32 {
  s := seconds / HUD_SPREAD;
  if !(s > 0) { return 0; }
  if s >= 1 { return HUD_HORIZON; }
  near: f32 = 1.0 / HUD_WORLD_FAR; far: f32 = 1.0 / (HUD_WORLD_FAR + HUD_HORIZON);
  return 1 / (near - (near - far) * s) - HUD_WORLD_FAR;
}
// And how wide the front is there: HUD_FRONT at the feet, wider as it goes, so it is soft far off too.
hud_front_edge :: (radius: f32) -> f32 { return HUD_FRONT + radius * 0.12; }

hud_d3 :: (x: f32, y: f32, z: f32) -> D3 { return d3(cast(f64) x, cast(f64) y, cast(f64) z); }
// How a thing stands: its size as it stands (across, up, along), how far it has turned about the
// upright (radians, the way dq_y turns), and whether it leans. A box resting on any face is the
// same box said upright: its size is its reach along the world's axes. One that leans is said by
// its own size.
HudStand :: struct { w: f64; h: f64; d: f64; turn: f64; tipped: bool; }
hud_stand :: (h: [] Hud, i: int) -> HudStand { return hud_stand_at(h, i, h[0].things[0].set[0].att[i]); }
hud_stand_at :: (h: [] Hud, i: int, q: DQ) -> HudStand {
  b := h[0].things[..]; half := b[0].half[i];
  if b[0].kind[i] == Bd_Kind.ball { return HudStand.{w = half.x * 2, h = half.x * 2, d = half.x * 2}; }
  axes := [3] D3.[dq_rotate(q, D3_X), dq_rotate(q, D3_Y), dq_rotate(q, D3_Z)];
  size := [3] f64.[half.x * 2, half.y * 2, half.z * 2];
  up := 0;
  for k: 1..<3 { if abs(axes[k].y) > abs(axes[up].y) { up = k; } }
  // of the other two, the one that runs most along +x (either way round) is its width
  j := (up + 1) % 3; k := (up + 2) % 3;
  wide := ifx abs(axes[j].x) >= abs(axes[k].x) then j else k; deep := ifx wide == j then k else j;
  along := ifx axes[wide].x < 0 then d3_neg(axes[wide]) else axes[wide];
  turn := ifx along.x > 0.001 then atan_d(-along.z / along.x) else 0.0;
  if abs(axes[up].y) >= HUD_UPRIGHT { return HudStand.{w = size[wide], h = size[up], d = size[deep], turn = turn}; }
  return HudStand.{w = size[0], h = size[1], d = size[2], turn = turn, tipped = true};
}
// Its rest for the page, in whole numbers: the middle of its footprint and its lowest point, its
// size as it stands, hundredths of a square; its turn in degrees; 1 when it leans. Read from the
// engine's history at the last step made (the state a server would replicate), not from the live
// arrays: what is told is what was simulated.
hud_rest :: (h: [] Hud, i: int) -> [HUD_REST] int {
  b := h[0].things[..];
  was := bd_at(h[0].past[..], b[0].id[i], b[0].steps);
  p := ifx was.ok then was.pos else b[0].set[0].pos[i]; q := ifx was.ok then was.att else b[0].set[0].att[i];
  st := hud_stand_at(h, i, q);
  // how far it reaches down from its middle, as it stood then
  x := dq_rotate(q, D3_X); y := dq_rotate(q, D3_Y); z := dq_rotate(q, D3_Z); half := b[0].half[i];
  down := ifx b[0].kind[i] == Bd_Kind.ball then half.x else abs(x.y) * half.x + abs(y.y) * half.y + abs(z.y) * half.z;
  // (the floor is the lowest a thing stands: one the solver has left pressed a little into it, under a
  // heavy gravity or a neighbour, is still on it. A bottom under the floor is no place the page keeps.)
  low := hud_whole(cast(f32) ((p.y - down) * 100)); if low < 0 { low = 0; }
  return [HUD_REST] int.[hud_whole(cast(f32) (p.x * 100)), low, hud_whole(cast(f32) (p.z * 100)),
                         hud_whole(cast(f32) (st.w * 100)), hud_whole(cast(f32) (st.h * 100)), hud_whole(cast(f32) (st.d * 100)),
                         hud_whole(cast(f32) (st.turn * 57.29577951)), ifx st.tipped then 1 else 0];
}
// A thing's new size from the page (metres across, up and along as it stands). It keeps its lowest
// point and its footprint's middle (the engine's bd_resize), and wakes. A box resting on a face is
// first said upright, the same box in the same place, so the new size is along the axes the page
// was told; one that leans is sized along its own.
hud_resize :: (h: [] Hud, i: int, w: f64, ht: f64, d: f64) {
  b := h[0].things[..];
  if b[0].kind[i] == Bd_Kind.ball { bd_resize(b, i, d3(w * 0.5, 0, 0), hud_stuff(h, b[0].id[i], PR_BALL, 0).density); return; }
  st := hud_stand(h, i);
  if !st.tipped {
    bd_place(b, i, b[0].set[0].pos[i], dq_y(st.turn));
    b[0].half[i] = d3(st.w * 0.5, st.h * 0.5, st.d * 0.5);
  }
  bd_resize(b, i, d3(w * 0.5, ht * 0.5, d * 0.5), hud_stuff(h, b[0].id[i], PR_BLOCK, hud_role(h, b[0].id[i])).density);   // (its weight for its new size is the registry's: a block's 200 kg a cubic metre unless it says another)
}
// Time for the things: the engine's fixed steps from this frame's seconds, once the camera is down
// in the world. The character is their mover: an upright capsule where it stands, making for the
// speed its keys asked of it, pushing with HUD_PUSH newtons. It is one of the engine's movers, by
// id: another player would be another. Every step is kept in the history. When any thing moved,
// the colliders the character meets are made again.
hud_things :: (h: [] Hud, step: f32) {
  b := h[0].things[..];
  h[0].moved = false;
  n := bd_count(b);
  if n == 0 || h[0].view != HUD_WORLD || h[0].zoom < HUD_FALL_AT { return; }
  // (the platformer's course: its boxes are held and its own to move (pf_solids), so with nothing loose among them, a ball say, there is nothing to step)
  if hud_plat_owns(h) { loose := false; for i: 0..<n { if b[0].set[0].inv_mass[i] != 0 { loose = true; break; } } if !loose { return; } }
  // (flying, it only nudges what it meets: an eighth of the force, and a fifth of its speed is what a ball is struck with)
  soft: f32 = ifx h[0].fly.on then f32(HUD_FLY_SOFT) else 1.0f32;
  ok := bd_mover(b, HUD_MOVER, hud_d3(h[0].cx, h[0].cy, h[0].cz), cast(f64) (h[0].cy + HUD_TALL), HUD_BODY, hud_d3(h[0].want_x * soft, 0, h[0].want_z * soft), (ifx h[0].fly.on then f64(HUD_FLY_PUSH) else f64(HUD_PUSH)) * cast(f64) pr_value(h[0].props[..], TW_PUSH) / 100.0, HUD_SHOVE, HUD_PUSH_CURVE);
  awake := bd_sleeping(b) < n;
  made := bd_advance_kept(b, h[0].past[..], cast(f64) step);
  if awake || bd_sleeping(b) < n { h[0].moved = true; hud_solids(h); }
}
// No grass grows where a thing rests: each thing on or near the ground is told to the engine's grass
// as a rest (sty_rest_add: a line with a width; a block's is along its longer side, a ball's a spot
// half its width), the nearest to the character first, as many as the engine takes (STY_PATHS).
// The blades thin out toward it, so a block sits in the grass and not on top of it.
HUD_GRASS_REST :: 0.6;    // metres over the ground a thing's underside may be and still keep the grass off
hud_footprints :: (h: [] Hud, u: [] f32) {
  b := h[0].things[..];
  n := bd_count(b);
  used: [BD_MAX] bool;
  for k: 0..<STY_PATHS {
    best := -1; near: f64 = 0;
    for i: 0..<n {
      if used[i] { continue; }
      st := hud_stand(h, i);
      p := b[0].set[0].pos[i];
      if st.tipped || p.y - st.h * 0.5 > HUD_GRASS_REST { continue; }
      dx := p.x - cast(f64) h[0].cx; dz := p.z - cast(f64) h[0].cz; d := dx * dx + dz * dz;
      if best < 0 || d < near { best = i; near = d; }
    }
    if best < 0 { return; }
    used[best] = true;
    st := hud_stand(h, best);
    p := b[0].set[0].pos[best];
    long := ifx st.w >= st.d then st.w else st.d; short := ifx st.w >= st.d then st.d else st.w;
    if b[0].kind[best] == Bd_Kind.ball { short = short * 0.5; long = short; }   // a ball touches the ground in its middle
    // the way its longer side runs, in the page's axes: across (x) turned by its turn, or along (z)
    ax := ifx st.w >= st.d then cos(st.turn) else sin(st.turn); az := ifx st.w >= st.d then -sin(st.turn) else cos(st.turn);
    half := (long - short) * 0.5;
    ok := sty_rest_add(u, cast(f32) (p.x - ax * half), -cast(f32) (p.z - az * half), cast(f32) (p.x + ax * half), -cast(f32) (p.z + az * half), cast(f32) (short * 0.5));
  }
}
// A pose of the page's in the engine's axes: (x, y, z) is (x, y, -z), and a turn about an axis is
// the same turn about that axis mirrored.
hud_turned :: (q: DQ) -> DQ { return dq(-q.x, -q.y, q.z, q.w); }
hud_v :: (a: D3) -> [3] f32 { return [3] f32.[cast(f32) a.x, cast(f32) a.y, cast(f32) a.z]; }

// The scene's mesh and records, written again when what they show has changed: the ground part
// under the camera, and the things where they are (between the engine's last two steps, so they
// move as smoothly as the frames come), once the camera has begun to come down (`shown`).
hud_build :: (h: [] Hud, shown: bool) {
  p: [1] ArchPen; arch_pen(p[..], h[0].mesh[..]);
  // the ground: one square of the ground material, all grass cover and no paving; the engine's
  // reveal says where it is still the bare floor
  arch_material(p[..], ARCH_M_GROUND, 0, 0, 0);
  // (the platformer's floor falls away under its course as it comes up, and is gone once it is up)
  // (drift's floor falls away too, as its tiles rise as the rocks)
  g: f32 = HUD_GROUND_HALF; gy := ifx h[0].type == HUD_PLATFORMER then pf_floor(h[0].plat[..]) else ifx h[0].type == HUD_DRIFT then dr_floor(h[0].drift[..]) else 0.0f32;
  if !(h[0].type == HUD_PLATFORMER && pf_up(h[0].plat[..])) && !(h[0].type == HUD_DRIFT && dr_up(h[0].drift[..])) { arch_quad(p[..], arch_at(-g, gy, g, 0, 1, 0, 1, 0), arch_at(g, gy, g, 0, 1, 0, 1, 0), arch_at(g, gy, -g, 0, 1, 0, 1, 0), arch_at(-g, gy, -g, 0, 1, 0, 1, 0)); }
  // the earth under the village's buildings and rocks (no grass grows there: the ground table)
  if h[0].table_for == 1 { all: [VL_SOLIDS * QUERY_BOX] f32; n := vl_all_solids(h[0].village[..], all[..]); vl_earth(all[0..<n * QUERY_BOX], p[..]); }
  // the things: the kit's smooth stone, a pale grey. A block is the kit's box turned as it is; a
  // ball is the kit's round, turned as it has rolled, with a dark band round it so its roll is seen
  arch_material(p[..], ARCH_M_SMOOTH, 0.74, 0.76, 0.8);
  // (a world of its own draws what is its own: crates, its room and its crates)
  if h[0].type == HUD_CRATES && h[0].crates[0].clock > 0 { cr_mesh(h[0].crates[..], p[..], h[0].time); }
  if h[0].type == HUD_PLATFORMER && h[0].plat[0].clock > 0 && !h[0].bare { pf_mesh_near(h[0].plat[..], p[..], h[0].time, h[0].cz, ifx h[0].still then 1000000.0f32 else f32(PF_DRAWN)); }
  if h[0].type == HUD_RACING && h[0].race[0].clock > 0 && !h[0].bare { rc_mesh(h[0].race[..], p[..], (h[0].keys & (HUD_KEY_BACK | HUD_KEY_TILT_DOWN)) != 0); }
  if h[0].type == HUD_DRIFT && h[0].drift[0].clock > 0 && !h[0].bare { y := h[0].orbit.yaw; dr_mesh(h[0].drift[..], p[..], h[0].orbiting && metaverse_orbit_first(h[0].orbit) > 0.5, [3] f32.[-cos(y), 0, sin(y)]); }
  // what the page has built, in every game type (every game type is built in)
  if shown {
    b := h[0].things[..];
    arch_material(p[..], ARCH_M_SMOOTH, 0.74, 0.76, 0.8);
    // (the HUD_BALL_NEAR balls nearest the character are drawn smooth, the rest low: a thousand balls fit the mesh)
    smooth: [HUD_BLOCKS] bool; balls := 0;
    for i: 0..<bd_count(b) { smooth[i] = false; if b[0].kind[i] == Bd_Kind.ball { balls += 1; } }
    for k: 0..<(ifx balls < HUD_BALL_NEAR then balls else HUD_BALL_NEAR) {
      best := -1; far := 0.0;
      for i: 0..<bd_count(b) {
        if smooth[i] || b[0].kind[i] != Bd_Kind.ball { continue; }
        dx := b[0].set[0].pos[i].x - cast(f64) h[0].cx; dz := b[0].set[0].pos[i].z - cast(f64) h[0].cz; d := dx * dx + dz * dz;
        if best < 0 || d < far { best = i; far = d; }
      }
      if best >= 0 { smooth[best] = true; }
    }
    // the marks: a goal a glowing tile (green once a crate rests on it), a shard a turning gold gem until it is taken, a boost a glowing strip
    // (crates: the room draws its own pads and gate, world-crates.coax cr_mesh; where you start is shown only while the level is built)
    room := h[0].type == HUD_CRATES && h[0].crates[0].ok && h[0].crates[0].clock > 0;
    for q: 0..<h[0].nmk {
      mq := h[0].marks[q];
      if mq.taken || (mq.role == BL_R_SHARD && hud_plat_owns(h)) { continue; }   // (the course draws its own shards)
      if room && (mq.role == BL_R_GOAL || mq.role == BL_R_GATE) { continue; }
      if mq.role == BL_R_START { if !h[0].still { continue; } arch_material(p[..], ARCH_M_GLOW, 0.9, 0.9, 1.0); pf_slab(p[..], mq.x - 0.3, mq.y, mq.z - 0.3, mq.x + 0.3, mq.y + 0.08, mq.z + 0.3); continue; }
      if mq.role == BL_R_SHARD { arch_material(p[..], ARCH_M_GLOW, 1.7, 1.15, 0.3); pf_gem(p[..], mq.x, mq.y + mq.h * 0.5, mq.z, hud_mark_size(mq) * 0.5, h[0].time * 2.0); continue; }
      if mq.role == BL_R_GOAL { arch_material(p[..], ARCH_M_GLOW, 1.5, 0.85, 0.2); }
      else if mq.role == BL_R_GATE { arch_material(p[..], ARCH_M_GLOW, 1.3, 0.16, 0.1); }
      else if mq.role == BL_R_TRACK || mq.role == BL_R_RING { arch_material(p[..], ARCH_M_GLOW, 0.5, 0.5, 0.55); }
      else { arch_material(p[..], ARCH_M_GLOW, 0.25, 1.2, 1.6); }
      pf_slab(p[..], mq.x - mq.w * 0.5, mq.y, mq.z - mq.d * 0.5, mq.x + mq.w * 0.5, mq.y + (ifx mq.h < 0.05 then mq.h else 0.05f32), mq.z + mq.d * 0.5);
    }
    wi := 0;   // (crates: its walls rise one after another, in the bodies' order)
    for i: 0..<bd_count(b) {
      if room && b[0].kind[i] == Bd_Kind.box && hud_crates_draw(h, p[..], i, wi) { if bd_fixed(b, i) { wi += 1; } continue; }
      if hud_plat_owns(h) && b[0].kind[i] == Bd_Kind.box { continue; }   // (the course draws its own platforms)
      // a kind's look: a pad pink and glowing, spikes red, a checkpoint amber (green once stood on), a wall dark, a cone orange; a plain thing the kit's grey
      role := hud_role(h, b[0].id[i]);
      if role == BL_R_PAD { arch_material(p[..], ARCH_M_GLOW, 1.6, 0.35, 1.1); }
      else if role == BL_R_SPIKES { arch_material(p[..], ARCH_M_GLOW, 1.4, 0.18, 0.12); }
      else if role == BL_R_CHECKPOINT { arch_material(p[..], ARCH_M_GLOW, 1.5, 0.85, 0.2); }
      else if role == BL_R_WALL { arch_material(p[..], ARCH_M_SMOOTH, 0.3, 0.32, 0.38); }
      else if role == BL_R_CONE { arch_material(p[..], ARCH_M_SMOOTH, 1.0, 0.45, 0.08); }
      else { arch_material(p[..], ARCH_M_SMOOTH, 0.74, 0.76, 0.8); }
      pose := bd_pose(b, i);
      c := d3(pose.pos.x, pose.pos.y, -pose.pos.z); q := hud_turned(pose.att); half := b[0].half[i];
      if b[0].kind[i] == Bd_Kind.box {
        arch_obox(p[..], hud_v(c), hud_v(d3_scale(dq_rotate(q, D3_X), half.x)), hud_v(d3_scale(dq_rotate(q, D3_Y), half.y)), hud_v(d3_scale(dq_rotate(q, D3_Z), half.z)));
        continue;
      }
      from := p[0].n; r := cast(f32) half.x;
      arch_ellipsoid(p[..], 0, 0, 0, r, r, r, ifx smooth[i] then HUD_BALL_SEGMENTS else HUD_LOW_SEGMENTS, ifx smooth[i] then HUD_BALL_RINGS else HUD_LOW_RINGS);
      for v: from..<p[0].n {
        o := v * ARCH_VERTEX_FLOATS; m := h[0].mesh[..];
        band := abs(m[o + 1]) < r * 0.3;
        at := d3_add(c, dq_rotate(q, hud_d3(m[o], m[o + 1], m[o + 2]))); nor := dq_rotate(q, hud_d3(m[o + 3], m[o + 4], m[o + 5]));
        m[o] = cast(f32) at.x; m[o + 1] = cast(f32) at.y; m[o + 2] = cast(f32) at.z;
        m[o + 3] = cast(f32) nor.x; m[o + 4] = cast(f32) nor.y; m[o + 5] = cast(f32) nor.z;
        if band { m[o + 9] = 0.2; m[o + 10] = 0.22; m[o + 11] = 0.27; }
      }
    }
  }
  if h[0].ring && shown { rg_mesh(p[..], h[0].ring_n, ifx h[0].ring_fly >= 0 then h[0].ring_to else h[0].ring_at); }
  h[0].mesh_n = p[0].n;
  // the records: the ground stands where the camera is, the blocks where they are
  for i: 0..<HUD_RECORDS * HUD_RECORD_FLOATS { h[0].records[i] = 0; }
  for r: 0..<HUD_RECORDS { o := r * HUD_RECORD_FLOATS; h[0].records[o + 4] = 1; h[0].records[o + 8] = 1; h[0].records[o + 9] = 1; h[0].records[o + 10] = 1; }
  h[0].records[0] = h[0].at_x; h[0].records[2] = h[0].at_z;
  // the village's buildings: where each stands, as far up as it has risen
  vl_records(h[0].village[..], h[0].records[HUD_KIT_RECORDS * HUD_RECORD_FLOATS..<h[0].records.count]);
  h[0].built = ifx shown then 1.0f32 else 0.0f32; h[0].stale = false; h[0].gen += 1; h[0].rec_gen += 1;
}
// The character's skinned vertices put where it stands, for the `skin` store: the figure's own
// space (its front +z, its left +x) turned to face the way it goes, in the engine's axes.
hud_skin :: (h: [] Hud) {
  g := h[0].ghost[..];
  if !g[0].ready || g[0].clip < 0 { return; }
  if h[0].tris_n == 0 {
    for i: 0..<g[0].nt { for k: 0..<3 { h[0].tris[i * 3 + k] = cast(u32) ghost_corner(g, i, k); } }
    h[0].tris_n = g[0].nt * 3; h[0].tris_gen += 1;
  }
  // facing `face` in the page's axes is (sin, cos) of it: the engine's (sin, -cos)
  turn := 3.14159265 - h[0].face;
  c := cos(turn); s := sin(turn);
  hero := hud_hero(h) && g[0].livery >= 0;   // its colours with it, else black: the shader draws it as a ghost
  for i: 0..<g[0].nv {
    mx := g[0].pos[i * 3]; my := g[0].pos[i * 3 + 1]; mz := g[0].pos[i * 3 + 2];
    nx := g[0].nor[i * 3]; ny := g[0].nor[i * 3 + 1]; nz := g[0].nor[i * 3 + 2];
    o := i * HUD_SKIN_FLOATS;
    h[0].skin[o] = h[0].cx + mx * c + mz * s; h[0].skin[o + 1] = h[0].cy + my; h[0].skin[o + 2] = -h[0].cz - mx * s + mz * c;
    h[0].skin[o + 3] = nx * c + nz * s; h[0].skin[o + 4] = ny; h[0].skin[o + 5] = -nx * s + nz * c;
    for k: 0..<3 { h[0].skin[o + 6 + k] = ifx hero then g[0].paint[i * 3 + k] else 0.0f32; }
  }
  h[0].skin_gen += 1;
}
// The scene's draws (coax/web/host.js: first, count, base instance with its top bit set for
// vertices in order, instances): the ground, the blocks, and last the character, which is blended.
hud_draws :: (h: [] Hud) {
  n := 0; h[0].ghost_draw = -1;
  d := h[0].host_draws[..];
  d[0] = 0; d[1] = 6; d[2] = 0x80000000; d[3] = 1; n = 1;
  if h[0].mesh_n > 6 { d[4] = 6; d[5] = cast(u32) (h[0].mesh_n - 6); d[6] = 0x80000001; d[7] = 1; n = 2; }
  // the village's buildings: indexed draws over the pack's index buffer, a record each (HUD_PACK_AT and up)
  if h[0].type == HUD_VILLAGE && h[0].zoom > 0.003 { n += vl_draws(h[0].village[..], d[n * 4..<(HUD_DRAWS - 1) * 4], HUD_PACK_AT); }
  if !h[0].bare && !h[0].still && h[0].zoom > 0.003 && h[0].tris_n > 0 && h[0].type != HUD_RACING && h[0].type != HUD_DRIFT && !hud_ring_alone(h) {
    o := n * 4; d[o] = 0; d[o + 1] = cast(u32) h[0].tris_n; d[o + 2] = 0x80000000 | HUD_GHOST_AT; d[o + 3] = 1;
    h[0].ghost_draw = n; n += 1;
  }
  h[0].draw_n = n;
}

// A float to the nearest whole number.
hud_whole :: (v: f32) -> int { return cast(int) floor(v + 0.5); }
hud_put :: (h: [] Hud, v: int) {
  a := v;
  if a < 0 { if h[0].out_n < h[0].outbox.count { h[0].outbox[h[0].out_n] = '-'; h[0].out_n += 1; } a = -a; }
  digits: [12] u8; m := 0;
  if a == 0 { digits[0] = '0'; m = 1; }
  while a > 0 && m < 12 { digits[m] = cast(u8) ('0' + a % 10); m += 1; a /= 10; }
  while m > 0 { m -= 1; if h[0].out_n < h[0].outbox.count { h[0].outbox[h[0].out_n] = digits[m]; h[0].out_n += 1; } }
}
// Where the character is, for the page: "X Z FX FZ", its place in hundredths of a square and the way
// it faces as a unit vector in hundredths. Told while the world is shown, when it has changed, four
// times a second at most, and not while an earlier word is still waiting to be taken.
hud_where :: (h: [] Hud, step: f32) {
  if h[0].wait > 0 { h[0].wait -= step; }
  if h[0].view != HUD_WORLD || h[0].wait > 0 || h[0].action != 0 { return; }
  now := [4] int.[hud_whole(h[0].cx * 100), hud_whole(h[0].cz * 100), hud_whole(sin(h[0].face) * 100), hud_whole(cos(h[0].face) * 100)];
  // (in the platformer the course is high up: how high the feet are is said too, for "a platform above my head")
  high := ifx h[0].type == HUD_PLATFORMER || h[0].type == HUD_DRIFT then hud_whole(h[0].cy * 100) else 0;
  if h[0].said && now[0] == h[0].told[0] && now[1] == h[0].told[1] && now[2] == h[0].told[2] && now[3] == h[0].told[3] && h[0].told_fly == h[0].fly.on && h[0].told_y == high { return; }
  h[0].told = now; h[0].told_fly = h[0].fly.on; h[0].told_y = high; h[0].said = true; h[0].wait = HUD_WHERE_EVERY;
  h[0].out_n = 0;
  for k: 0..<4 { if k > 0 { h[0].outbox[h[0].out_n] = ' '; h[0].out_n += 1; } hud_put(h, now[k]); }
  // (and " 1" more while it flies: the page tells the model "moving: flying")
  if h[0].fly.on { h[0].outbox[h[0].out_n] = ' '; h[0].outbox[h[0].out_n + 1] = '1'; h[0].out_n += 2; }
  // (the platformer's height after a word for flying, " 0" there: it never flies)
  if h[0].type == HUD_PLATFORMER || h[0].type == HUD_DRIFT { if !h[0].fly.on { h[0].outbox[h[0].out_n] = ' '; h[0].outbox[h[0].out_n + 1] = '0'; h[0].out_n += 2; } h[0].outbox[h[0].out_n] = ' '; h[0].out_n += 1; hud_put(h, high); }
  h[0].action = HUD_WHERE;
}
// Where things came to rest, for the page: "ID X Y Z W H D TURN TIP" for each thing that sleeps
// and whose rest the page has not been told, one after another (web/blocks.coax's bl_things reads
// it). Told while the world is shown, twice a second at most, and not while an earlier word is
// still waiting to be taken.
// Where the thing with this id is in what the page has said, or -1.
// (the page's ids come in rising, so `known` is in id order and a binary search finds one; a miss looks through all, to be sure)
// A thing's kind, as the page said it (none when it is not known).
hud_role :: (h: [] Hud, id: int) -> int { k := hud_known(h, id); return ifx k >= 0 then h[0].known[k].role else 0; }
hud_known :: (h: [] Hud, id: int) -> int {
  lo := 0; hi := h[0].nk;
  while lo < hi { mid := (lo + hi) / 2; if h[0].known[mid].id < id { lo = mid + 1; } else { hi = mid; } }
  if lo < h[0].nk && h[0].known[lo].id == id { return lo; }
  for t: 0..<h[0].nk { if h[0].known[t].id == id { return t; } }
  return -1;
}
hud_settled :: (h: [] Hud, step: f32) {
  if h[0].twait > 0 { h[0].twait -= step; }
  // (crates: where a crate is pushed to is the run's, not the level's: the room is as it was built when it is entered again)
  if h[0].view != HUD_WORLD || h[0].twait > 0 || h[0].action != 0 || h[0].type == HUD_CRATES { return; }
  b := h[0].things[..];
  h[0].out_n = 0;
  for i: 0..<bd_count(b) {
    if bd_awake(b, i) { continue; }
    now := hud_rest(h, i);
    t := hud_known(h, b[0].id[i]);
    if t < 0 { continue; }
    same := h[0].known[t].said;
    for k: 0..<HUD_REST { if h[0].known[t].rest[k] != now[k] { same = false; } }
    if same { continue; }
    if h[0].out_n + 120 > HUD_OUTBOX { break; }
    if h[0].out_n > 0 { h[0].outbox[h[0].out_n] = ' '; h[0].out_n += 1; }
    hud_put(h, b[0].id[i]);
    for k: 0..<HUD_REST { h[0].outbox[h[0].out_n] = ' '; h[0].out_n += 1; hud_put(h, now[k]); h[0].known[t].rest[k] = now[k]; }
    h[0].known[t].said = true;
  }
  // (looked again no sooner than HUD_SETTLED_EVERY, told or not: a thousand rests are not read every frame)
  h[0].twait = HUD_SETTLED_EVERY;
  if h[0].out_n > 0 { h[0].action = HUD_SETTLED; }
}
// What the page is told now (0: nothing), its words, and that it has been taken.
hud_action :: (h: [] Hud) -> int #export_c #effects(all) { return ifx h.count < 1 then 0 else h[0].action; }
hud_outbox_len :: (h: [] Hud) -> int #export_c #effects(all) { return ifx h.count < 1 then 0 else h[0].out_n; }
hud_action_done :: (h: [] Hud) #export_c #effects(all) { if h.count > 0 { h[0].action = 0; h[0].out_n = 0; } }

hud_observe :: (h:[]Hud,step:f32) {
  h[0].observe_wait-=step;
  if !h[0].observe_on || h[0].view!=HUD_WORLD || h[0].observe_wait>0 || h[0].action!=0 {return;}
  h[0].observe_seq+=1;
  v:[GB_OBSERVE_FIELDS]int;
  own:=[16]int.[h[0].observe_seq,hud_whole(h[0].time*1000),hud_whole(h[0].cx*100),hud_whole(h[0].cy*100),hud_whole(h[0].cz*100),hud_whole(h[0].ground*100),hud_whole(h[0].orbit.yaw*1000),hud_whole(h[0].orbit.pitch*1000),hud_whole(h[0].orbit.shown*100),h[0].kind,h[0].grav_n,h[0].keys,h[0].sel,ifx h[0].fly.on then 1 else 0,h[0].type,h[0].mode];
  for i:0..<16 {v[i]=own[i];}v[16]=-1;
  if h[0].type==HUD_CRATES {
    c:=h[0].crates[..];v[16]=c[0].room;v[17]=cr_count(c[0].lit);v[18]=c[0].r[0].ng;v[19]=ifx c[0].solved then 1 else 0;v[20]=c[0].cleared;v[21]=c[0].resets;
    // (the room's first three crates, in the order of their ids: the level's order)
    b:=h[0].things[..];last:=-1;for k:0..<3 {i:=-1;for j:0..<bd_count(b) {if cr_is(b,j) && b[0].id[j]>last && (i<0 || b[0].id[j]<b[0].id[i]) {i=j;}}if i>=0 {last=b[0].id[i];at:=22+k*4;v[at]=hud_whole(cast(f32)b[0].set[0].pos[i].x*100);v[at+1]=hud_whole(cast(f32)b[0].set[0].pos[i].z*100);v[at+2]=hud_whole(cast(f32)b[0].set[0].vel[i].x*100);v[at+3]=hud_whole(cast(f32)b[0].set[0].vel[i].z*100);}}
  }
  v[34]=ifx h[0].foot.jump.on_ground then 1 else 0;v[35]=hud_whole(h[0].foot.jump.vy*100);v[36]=hud_whole(h[0].foot.walk.vz*100);v[37]=h[0].foot.jump.air_used;
  if h[0].type==HUD_PLATFORMER {p:=h[0].plat[..];v[38]=hud_whole(p[0].clock*1000);v[39]=p[0].run.next;v[40]=p[0].falls;v[41]=ifx p[0].run.done then 1 else 0;v[42]=course_taken(p[0].taken[..]);}
  if h[0].type==HUD_RACING {r:=h[0].race[..];f:=rc_ahead(r);v[43]=hud_whole(r[0].s*100);v[44]=r[0].hint;v[45]=hud_whole(f[0]*1000);v[46]=hud_whole(f[2]*1000);v[47]=hud_whole(rc_speed(r)*100);v[48]=r[0].run.lap;v[49]=r[0].run.next;v[50]=ifx r[0].run.done then 1 else 0;v[51]=r[0].backs;v[52]=hud_whole(r[0].run.clock*1000);v[53]=hud_whole(r[0].run.best_lap*1000);v[54]=rc_light(r);}
  n:=gb_observation(v[..],h[0].outbox[..]);if n<=0 {return;}
  h[0].out_n=n;h[0].action=GB_OBSERVE;h[0].observe_wait=ifx h[0].type==HUD_PLATFORMER || h[0].type==HUD_RACING then 0.05 else 0.1;
}

#test "own-frame observation is opt-in, bounded and leaves gameplay untouched" {
  t:[1]HudTest;h:=t[0].h[..];h[0].view=HUD_WORLD;h[0].cx=4.25;h[0].cy=0.5;h[0].keys=16;
  hud_observe(h,0.1);#assert h[0].action==0;
  h[0].observe_on=true;h[0].action=HUD_EDIT;hud_observe(h,0.1);#assert h[0].action==HUD_EDIT;
  h[0].action=0;hud_observe(h,0.1);#assert h[0].action==GB_OBSERVE && h[0].cx==4.25 && h[0].cy==0.5 && h[0].keys==16;
  seq:=h[0].observe_seq;hud_action_done(h);hud_observe(h,0.01);#assert h[0].action==0 && h[0].observe_seq==seq;
}

// A phone's move stick, while a thumb is on it: a ring where it went down and a mark where it is pushed.
hud_stick :: (h: [] Hud, o: [] HudOut, d: f32) {
  s := h[0].sticks;
  if !s.move_on || h[0].view != HUD_WORLD { return; }
  r := cast(f32) pad.STICKS_RADIUS * d;
  for k: 0..<32 {
    a := cast(f32) k * 0.19634954; b := a + 0.19634954;
    hud_line(o, s.ox + cos(a) * r, s.oy + sin(a) * r, s.ox + cos(b) * r, s.oy + sin(b) * r, d, 0.35);
  }
  nx := s.ox + s.pad_x * r; ny := s.oy - s.pad_y * r; m := 9 * d;
  hud_line(o, nx - m, ny, nx + m, ny, 2 * d, 0.7); hud_line(o, nx, ny - m, nx, ny + m, 2 * d, 0.7);
}

// First person: the engine's reticle (cam/reticle.coax) at the middle of the window, once the camera is in the head.
hud_reticle :: (h: [] Hud, o: [] HudOut, w: f32, ht: f32, d: f32) {
  if h[0].kind != CAM_KIND_FIRST || !hud_looks(h) { return; }
  st: [reticle.RETICLE_MAX] reticle.ReticleStroke;
  n := reticle.reticle_strokes(st[..], w * 0.5, ht * 0.5, d, 0.9, 0, 0);
  for i: 0..<n { hud_line(o, st[i].ax, st[i].ay, st[i].bx, st[i].by, st[i].width, st[i].alpha); }
}

// First person holds the pointer (the engine's mouselook, cam/mouselook.coax; the page host asks the
// browser for its Pointer Lock and says what it did). The mouse may look once the camera is in the
// head. It is never held until the world is pressed: the world opens with the cursor free, for the
// chat and the menu. Escape (the browser's own), the caret going to a field (Enter), the picker and
// leaving the world all let it go; a press on the world holds it again. Free, a drag still looks.
hud_mouse :: (h: [] Hud, step: f32) {
  m := h[0].mouse[..];
  able := h[0].kind == CAM_KIND_FIRST && hud_looks(h);
  if !able { m[0].free = true; m[0].refused = false; }
  m[0].able = able;
  ml.ml_step(m, step);
}
// What the page host is told (coaxial_mouselook): 0 no mouselook here, 1 the cursor is free, 2 hold the pointer.
hud_mouselook :: (h: [] Hud) -> int #export_c #effects(all) { return ifx h.count < 1 then 0 else ml.ml_host(h[0].mouse[0]); }
// The mouse moved while the pointer is held (CSS pixels, right and down positive): the look's turn
// and tilt, at the engine's sensitivity (ML_TURN), in the drag's sense (right turns right, up looks up).
hud_look_delta :: (h: [] Hud, dx: f32, dy: f32) #export_c #effects(all) {
  if h.count < 1 || !hud_looks(h) { return; }
  t := ml.ml_turn(h[0].mouse[0], dx, dy);
  h[0].look_yaw -= t[0]; h[0].look_pitch -= t[1];
}
// The host's word on the lock: 1 held, 0 let go (Escape too: the cursor is then free until the world is pressed), 2 refused (the drag looks, as before).
hud_pointer_lock :: (h: [] Hud, status: int) #export_c #effects(all) { if h.count > 0 { ml.ml_lock(h[0].mouse[..], status); } }

// The village's clock: its entrance runs once the pack is in and the world is shown, and runs back
// (the buildings sink) when the world is left. While a building is rising the records are written
// again each frame; when one becomes solid the colliders are made again.
hud_village :: (h: [] Hud, step: f32) {
  v := h[0].village[..];
  on := h[0].type == HUD_VILLAGE && h[0].view == HUD_WORLD;
  was := v[0].clock;
  if on && v[0].ready { v[0].clock += step; if hud_calm(h) || v[0].clock > vl_done(v) + 0.1 { v[0].clock = vl_done(v) + 0.1; } }   // (settled: the village stands at once)
  else if v[0].clock > 0 { v[0].clock -= step * (vl_done(v) / HUD_RECEDE); if v[0].clock <= 0 { v[0].clock = 0; vl_again(v); } }   // (left: next time every building rises)
  if v[0].clock != was { h[0].stale = true; }
  solid := ifx h[0].type == HUD_VILLAGE then vl_solid_count(v) else 0;
  if solid != v[0].solid { v[0].solid = solid; hud_statics(h); }
}
// What the page is told the world is, for the chat's model (action HUD_SAYS): the village's green
// once its pack is in, that they are loading before, and nothing (an empty word) for the meadow.
// Told when it changes, and not while an earlier word is still waiting to be taken.
hud_says :: (h: [] Hud) {
  if h[0].view != HUD_WORLD || h[0].action != 0 { return; }
  now := ifx h[0].type == HUD_CRATES then cr_state(h[0].crates[..]) else ifx h[0].type == HUD_PLATFORMER then pf_state(h[0].plat[..]) else ifx h[0].type == HUD_RACING then rc_state(h[0].race[..]) else ifx h[0].type == HUD_DRIFT then dr_state(h[0].drift[..]) else ifx h[0].type != HUD_VILLAGE then 0 else ifx h[0].village[0].ready then 2 else 1;
  if now == h[0].noted { return; }
  h[0].noted = now;
  h[0].out_n = ifx now == 0 then 0 else ifx h[0].type == HUD_CRATES then cr_describe(h[0].crates[..], h[0].outbox[..]) else ifx h[0].type == HUD_PLATFORMER then pf_describe(h[0].plat[..], h[0].outbox[..]) else ifx h[0].type == HUD_RACING then rc_describe(h[0].race[..], h[0].outbox[..]) else ifx h[0].type == HUD_DRIFT then dr_describe(h[0].drift[..], h[0].outbox[..]) else vl_describe(h[0].village[..], h[0].outbox[..]);
  h[0].action = HUD_SAYS;
}
// While the village's pack is coming in: a thin line along the foot of the window, as long as the
// share of the pack that is in, over a faint one the window's width.
hud_loading :: (h: [] Hud, o: [] HudOut, w: f32, ht: f32, d: f32) {
  v := h[0].village[..];
  if h[0].type != HUD_VILLAGE || h[0].view != HUD_WORLD || v[0].ready || v[0].failed { return; }
  y := ht - 3 * d; m := w * 0.3;
  hud_line(o, m, y, w - m, y, d, 0.12);
  hud_line(o, m, y, m + (w - 2 * m) * vl_progress(v), y, 2 * d, 0.7);
}
// The pack, for the page host (hud-face.c): whether it is still held back (nothing of it is fetched
// until the village is picked), whether what was fetched is admitted (its size and the SHA-256 the
// host put in the village's digest), and each of its parts as it arrives.
hud_pack_wait :: (h: [] Hud) -> int #export_c #effects(all) { return ifx h.count > 0 && h[0].village[0].wanted then 0 else 1; }
hud_pack_admit :: (h: [] Hud, bytes: int) -> int #export_c #effects(all) { return ifx h.count > 0 && vl_admit(h[0].village[..], bytes) then 1 else 0; }
hud_asset_ready :: (h: [] Hud, i: int, bytes: int) #export_c #effects(all) { if h.count > 0 { vl_part(h[0].village[..], i, bytes); hud_statics(h); } }
hud_catalog_cap :: () -> int #export_c #effects(all) { return VL_CATALOG; }

// One frame. Stroke vertices written.
hud_frame :: (h: [] Hud, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c #effects(all) {
  if h.count < 1 { return 0; }
  d := ifx dpr < 1 then 1.0f32 else dpr;
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  h[0].time += step;
  inside := h[0].px > -1000;
  h[0].lit += ((ifx inside then 1.0f32 else 0.0f32) - h[0].lit) * (ifx step * 6 > 1 then 1.0f32 else step * 6);
  // the camera eases to its lean: quick at first, settling
  turn := step * HUD_TILT; if turn > 1 { turn = 1; }
  h[0].tilt += (h[0].lean - h[0].tilt) * turn;
  if abs(h[0].lean - h[0].tilt) < 0.0005 { h[0].tilt = h[0].lean; }
  // and comes down to the character when the world is shown, quickly (HUD_DOWN), and goes back up when it is left
  near := ifx h[0].view == HUD_WORLD then 1.0f32 else 0.0f32;
  drop := step * (ifx h[0].view == HUD_WORLD then f32(HUD_DOWN) else f32(HUD_UP)); if drop > 1 { drop = 1; }
  h[0].zoom += (near - h[0].zoom) * drop;
  if abs(near - h[0].zoom) < 0.0005 { h[0].zoom = near; }
  h[0].wide = width; h[0].high = height; h[0].dpr = d;
  hud_mouse(h, step);
  // (world.time_scale: the character's and the things' seconds, not the camera's or the page's)
  sim := step * cast(f32) pr_value(h[0].props[..], TW_TIME_SCALE) * 0.01;
  // (held still, the app's editor: the world is drawn as it stands and nothing in it is stepped)
  if !h[0].still {
    hud_platformer(h, sim);
    hud_racing(h, sim);
    hud_drifting(h, sim);
    hud_walk(h, sim);
    hud_orbit(h, step);
    hud_ring(h, step);
  }
  h[0].sticks = pad.metaverse_sticks_used(h[0].sticks);   // the frame has read the thumbs' look, zoom and tap
  if !h[0].still { hud_things(h, sim); }
  hud_edit_say(h);
  hud_village(h, step);
  if !h[0].still { hud_crates(h, step); }
  hud_ring_say(h, uniforms);
  hud_where(h, step);
  hud_settled(h, step);
  hud_says(h);
  hud_observe(h, step);
  if h[0].view == HUD_WORLD { h[0].since += step; }
  // the grass spreads from where the character stood when the world came up, and goes when it is left
  if h[0].view == HUD_WORLD && (hud_meadow(h) || h[0].type == HUD_RACING) {
    if h[0].spread <= 0 { h[0].from_x = h[0].cx; h[0].from_z = h[0].cz; }
    h[0].spread += step; if h[0].spread > HUD_SPREAD { h[0].spread = HUD_SPREAD; }
  } else if h[0].spread > 0 {
    h[0].spread -= step * (HUD_SPREAD / HUD_RECEDE); if h[0].spread < 0 { h[0].spread = 0; }
  }
  // the sun comes up with it, once, and stays up; leaving the world, the sky goes back to black with the grass
  // (world.time_of_day: the sun comes up as far as that and stays; set earlier in the day, it goes back down there twice as fast)
  noon := HUD_SUNRISE * TW_DAY_SHARE[pr_value(h[0].props[..], TW_TIME_OF_DAY)];
  if h[0].view == HUD_WORLD && hud_meadow(h) {
    if h[0].dawn <= noon { h[0].dawn += step; if h[0].dawn > noon { h[0].dawn = noon; } }
    else { h[0].dawn -= step * 2; if h[0].dawn < noon { h[0].dawn = noon; } }
  }
  else if h[0].dawn > 0 { h[0].dawn -= step * (HUD_SUNRISE / HUD_RECEDE); if h[0].dawn < 0 { h[0].dawn = 0; } }
  front := hud_front(h[0].spread);
  h[0].blades = 0;
  if uniforms.count >= HUD_UNIFORMS && width >= 1 && height >= 1 {
    u := uniforms;
    eye := hud_camera(h, height, d);
    if h[0].eye_on { eye = h[0].eye; }   // the app's editor: its own camera
    if h[0].ring && h[0].ring_fly >= 0 { eye = hud_ring_eye(h, eye); }   // through a portal
    look := hud_look_of(h);
    // the registry's part of the look: the haze, and the grass's height and how thick it grows
    pp := h[0].props[..];
    look.haze *= cast(f32) pr_value(pp, TW_HAZE) * 0.01;
    look.blade = cast(f32) pr_value(pp, TW_GRASS_HEIGHT) * 0.01;
    thick := sqrt(cast(f32) pr_value(pp, TW_GRASS_DENSITY) * 0.01);
    if pr_changed(pp, TW_GRASS_DENSITY) { look.grass_cell /= thick; }
    // on the page's own views the floor only fades to black with distance, from the point the camera
    // looks at (as the old HUD's did: over 2.88 window heights of floor); the world's haze comes in with the world
    high := height / d * 1.2 / HUD_PIXELS; z := h[0].zoom;
    look.haze = (1 - z) / (high * 2.4) + look.haze * z; look.haze_start = high * (1 - z) + look.haze_start * z;
    look.haze_r *= z; look.haze_g *= z; look.haze_b *= z;
    ok := sty_frame(u, width, height, h[0].time, eye, look);
    // the sun's shadows: the ground round the character
    if h[0].eye_on {
      // (round what the given camera looks at: 14 m ahead of it on the level, or under it when it looks down)
      f := sty_forward(eye); reach: f32 = 14;
      ok = sty_shadow_box(u, eye.x + f[0] * reach, 0, eye.z + f[2] * reach, 32, 80) && ok;
    } else { ok = sty_shadow_box(u, h[0].cx, h[0].cy, -h[0].cz, 26, 60) && ok; }
    // the grass: a field ahead of the eye, once the reveal has begun; its wind; the character parts it
    if front > 0 {
      // a square of it, HUD_GRASS_BEHIND behind the eye and the rest ahead, whichever way the camera looks
      // (a small window, a phone's, has a smaller field of fewer, wider blades: under a sixth of the vertices)
      cols := HUD_GRASS_COLS; rows := HUD_GRASS_ROWS;
      if width / d < HUD_SMALL { cols = HUD_GRASS_SMALL; rows = HUD_GRASS_SMALL; look.grass_cell = 0.2; look.grass_reach = 32; look.blade_wide = 0.06; if pr_changed(pp, TW_GRASS_DENSITY) { look.grass_cell /= thick; } }
      wide := cast(f32) cols * look.grass_cell; deep := cast(f32) rows * look.grass_cell;
      // (thicker grass is a smaller field: the blades stop where it does)
      if look.grass_reach > deep - HUD_GRASS_BEHIND - 2 { look.grass_reach = deep - HUD_GRASS_BEHIND - 2; }
      h[0].blades = sty_grass_field(u, look, eye.x + sin(eye.yaw) * (wide * 0.5 - HUD_GRASS_BEHIND) - wide * 0.5, eye.z - cos(eye.yaw) * (deep * 0.5 - HUD_GRASS_BEHIND) - deep * 0.5, cols, rows);
    }
    // (once it has reached the horizon there is no reveal left: the whole world is grass)
    if h[0].spread >= HUD_SPREAD { ok = sty_reveal(u, 0, 0, 0, 0) && ok; }
    else { ok = sty_reveal(u, h[0].from_x, -h[0].from_z, front, hud_front_edge(front)) && ok; }
    aloft := h[0].cy - h[0].ground; if aloft < 0 { aloft = 0; }
    // (its feet part the grass on the ground, less as it leaves it, and not at all once it flies clear of the blades)
    ok = sty_mover(u, h[0].cx, -h[0].cz, ifx !h[0].still && aloft < 1 && !(h[0].fly.on && aloft > 0.3) then f32(HUD_PART) * (1 - aloft) else 0.0f32) && ok;
    ok = sty_wind(u, 0.8, 0.6, 0.3 * cast(f32) pr_value(pp, TW_WIND) * 0.01, 3) && ok;
    // the bare floor: black, a faint line every metre and every four; plainer once you stand on it
    ink := (0.07 + 0.1 * h[0].zoom) * (ifx h[0].type == HUD_CRATES && h[0].crates[0].clock > 0 then cr_grid(h[0].crates[..]) else ifx h[0].type == HUD_PLATFORMER then pf_grid(h[0].plat[..]) else ifx h[0].type == HUD_DRIFT then dr_grid(h[0].drift[..]) else 1.0f32);
    ok = sty_bare(u, 0, 0, 0, 1, ink, ink, ink, 4) && ok;
    if h[0].table_for == 1 { sty_ground_table(u, VL_TABLE_X0, VL_TABLE_Z0, VL_TABLE_CELL, VL_TABLE_N); } else if h[0].table_for == 2 { sty_ground_table(u, RC_TABLE_X0, RC_TABLE_Z0, RC_TABLE_CELL, RC_TABLE_N); } else { sty_ground_table(u, 0, 0, 1, 0); }
    sty_path_clear(u);
    if h[0].type == HUD_VILLAGE && h[0].view == HUD_WORLD { vl_paths(u); }   // the green's worn paths, then the things' rests in what is left
    hud_footprints(h, u);
    // the page's own: the pointer, the panel the ground is dimmed behind (the first of kind HUD_SHADE), the scale
    u[HUD_U_POINTER] = h[0].px * d; u[HUD_U_POINTER + 1] = h[0].py * d; u[HUD_U_POINTER + 2] = h[0].lit * (1 - h[0].tilt); u[HUD_U_POINTER + 3] = h[0].zoom;
    u[HUD_U_SHADE] = 0; u[HUD_U_SHADE + 1] = 0; u[HUD_U_SHADE + 2] = 0; u[HUD_U_SHADE + 3] = 0;
    for i: 0..<h[0].n {
      p := h[0].panels[i];
      if p.kind == HUD_SHADE { u[HUD_U_SHADE] = p.x * d; u[HUD_U_SHADE + 1] = p.y * d; u[HUD_U_SHADE + 2] = p.w * d; u[HUD_U_SHADE + 3] = p.h * d; break; }
    }
    u[HUD_U_PAGE] = d; u[HUD_U_PAGE + 1] = h[0].zoom; u[HUD_U_PAGE + 2] = h[0].gone; u[HUD_U_PAGE + 3] = ifx h[0].ring then h[0].ring_lit else 0.0f32;
    // the ground part follows the camera in big steps, so it never ends
    gx := floor(eye.x / HUD_GROUND_STEP + 0.5) * HUD_GROUND_STEP; gz := floor(eye.z / HUD_GROUND_STEP + 0.5) * HUD_GROUND_STEP;
    if gx != h[0].at_x || gz != h[0].at_z { h[0].at_x = gx; h[0].at_z = gz; h[0].stale = true; }
  }
  // the things are drawn once the camera has begun to come down, and again whenever one has moved
  shown := h[0].zoom > 0.003;
  if h[0].stale || h[0].moved || (h[0].built > 0.5) != shown { hud_build(h, shown); }
  if !h[0].bare && !h[0].still && h[0].zoom > 0.003 { hud_skin(h); }
  hud_ghost_building(h);
  hud_draws(h);
  o: [1] HudOut; o[0].v = out;
  // the moving lines, faint, the height of the window
  b := HudBox.{x = 0, y = 0, width = width, height = height};
  n := ax_moving_lines(b, 64 * d, 2, 11, ax_wrap(h[0].time / 14), h[0].lines[..]);
  for i: 0..<n { l := h[0].lines[i]; hud_line(o[..], l.a.x, l.a.y, l.b.x, l.b.y, d, 0.06 * (1 - h[0].tilt)); }
  // each panel that is in the window draws itself in, then stays
  for i: 0..<h[0].n {
    p := h[0].panels[i];
    seen := p.y < height / d * 0.94 && p.y + p.h > 0;
    if seen && p.t < 1 { p.t += step / HUD_ASSEMBLE; if p.t > 1 { p.t = 1; } h[0].panels[i].t = p.t; }
    on := inside && h[0].px >= p.x && h[0].px <= p.x + p.w && h[0].py >= p.y && h[0].py <= p.y + p.h;
    p.hot += ((ifx on then 1.0f32 else 0.0f32) - p.hot) * (ifx step * 10 > 1 then 1.0f32 else step * 10);
    h[0].panels[i].hot = p.hot;
    if seen && p.t > 0 { hud_frame_of(h, o[..], p, d); }
  }
  hud_chrome(h, o[..], width, height, d);
  hud_stick(h, o[..], d);
  hud_reticle(h, o[..], width, height, d);
  if uniforms.count >= HUD_UNIFORMS { hud_tool_draw(h, o[..], uniforms, d); }
  if uniforms.count >= HUD_UNIFORMS && h[0].still { hud_still_draw(h, o[..], uniforms, d); }
  hud_loading(h, o[..], width, height, d);
  return o[0].n;
}

// The scene, for the host (hud-face.c): how many draws, which are blended (the character: the
// engine's ghost, source over), the grass's blades, and each store's size and generation.
hud_draw_count :: (h: [] Hud) -> int #export_c #effects(all) { return ifx h.count < 1 then 0 else h[0].draw_n; }
// (the character as a ghost is blended over what is behind it; as the platformer's hero it is solid)
hud_draw_blend :: (h: [] Hud, i: int) -> int #export_c #effects(all) { return ifx h.count > 0 && i == h[0].ghost_draw && !hud_hero(h) then 2 else 0; }
hud_grass :: (h: [] Hud) -> int #export_c #effects(all) { return ifx h.count < 1 then 0 else h[0].blades; }
// How many vertices the host draws a blade: the engine's lush blade has nine.
hud_grass_vertices :: (h: [] Hud) -> int #export_c #effects(all) { return sty_grass_vertices(hud_day()); }
hud_store_cap :: (k: int) -> int #export_c #effects(all) {
  if k == 0 { return HUD_MESH_VERTICES * ARCH_VERTEX_FLOATS * 4; }
  if k == 1 { return HUD_RECORDS * HUD_RECORD_FLOATS * 4; }
  if k == 2 { return VL_TABLE_FLOATS * 4; }
  if k == 3 { return GHOST_V * HUD_SKIN_FLOATS * 4; }
  if k == 4 { return GHOST_T * 3 * 4; }
  if k == 5 { return RG_MAX * RG_PIC_W * RG_PIC_H * 4; }
  return 0;
}
hud_store_bytes :: (h: [] Hud, k: int) -> int #export_c #effects(all) {
  if h.count < 1 { return 0; }
  if k == 0 { return (ifx h[0].mesh_n < 6 then 6 else h[0].mesh_n) * ARCH_VERTEX_FLOATS * 4; }
  if k == 3 { return (ifx h[0].ghost[0].nv < 1 then 1 else h[0].ghost[0].nv) * HUD_SKIN_FLOATS * 4; }
  if k == 4 { return (ifx h[0].tris_n < 3 then 3 else h[0].tris_n) * 4; }
  if k == 5 { return (ifx h[0].ring_n < 1 then 1 else h[0].ring_n) * RG_PIC_W * RG_PIC_H * 4; }   // (the pictures of the portals there are)
  return hud_store_cap(k);
}
hud_store_version :: (h: [] Hud, k: int) -> int #export_c #effects(all) {
  if h.count < 1 { return 0; }
  if k == 0 { return h[0].gen; }
  if k == 1 { return h[0].rec_gen; }
  if k == 2 { return h[0].table_gen; }
  if k == 3 { return h[0].skin_gen; }
  if k == 4 { return h[0].tris_gen; }
  if k == 5 { return h[0].pics_gen; }
  return 0;
}

// A whole number from text at `at`: its value and where it ended. A minus sign is taken.
HudRead :: struct { value: int; at: int; ok: bool; }
hud_read :: (t: string, from: int) -> HudRead {
  i := from;
  while i < t.count && (t[i] == ' ' || t[i] == '\n') { i += 1; }
  neg := i < t.count && t[i] == '-';
  if neg { i += 1; }
  v := 0; got := false;
  while i < t.count && t[i] >= '0' && t[i] <= '9' { if v < 100000000 { v = v * 10 + cast(int) (t[i] - '0'); } i += 1; got = true; }
  return HudRead.{value = ifx neg then -v else v, at = i, ok = got};
}
// Whether the camera takes a look or a zoom, and the hotbar's tools a press, now: the world is shown.
// From its first frame: the camera is still coming down then, and nothing waits for it (issue 14:
// a person moves, looks and builds within a second of picking a type; docs/web-world.md, "The first second").
hud_looks :: (h: [] Hud) -> bool { return h[0].orbiting && h[0].view == HUD_WORLD; }
// Whether the world comes up settled, with no entrance: the person prefers reduced motion, or the
// page says this world is a kept one come back (HUD_CALM_MSG).
hud_calm :: (h: [] Hud) -> bool { return h[0].calm != 0; }
// The world settled, as it comes up: the camera down at the character, the grass out to the horizon
// and the sun where the world's time of day has it. Each world's own entrance is settled where it is
// entered (hud_crates_in, hud_plat_in, hud_race_in, hud_drift_in; the village in hud_village).
hud_settle :: (h: [] Hud) {
  h[0].zoom = 1; h[0].tilt = 1;
  if hud_meadow(h) || h[0].type == HUD_RACING { h[0].from_x = h[0].cx; h[0].from_z = h[0].cz; h[0].spread = HUD_SPREAD; }
  if hud_meadow(h) { h[0].dawn = HUD_SUNRISE * TW_DAY_SHARE[pr_value(h[0].props[..], TW_TIME_OF_DAY)]; }
}
// A pointer, from the page host (coax/web/host.js: device pixels; phase 0 down, 1 moved, 2 up, 3
// cancelled; kind 0 a mouse, else a finger; id the pointer's). A mouse held on the world and dragged
// turns the camera, either button (Everglade's drag: cam_drag); a finger is one of the engine's
// thumbs (sticks.coax: the left half moves, the right half looks, a second finger there pinches,
// a tap there jumps). A press that began on one of the page's own things (107) is not the camera's.
hud_pointer :: (h: [] Hud, x: f32, y: f32, phase: int, kind: int, id: int, button: int) #export_c #effects(all) {
  if h.count < 1 { return; }
  world := h[0].view == HUD_WORLD;
  // (the home page's ring: a press is a portal's, a drag looks round, a swipe is the next portal)
  if h[0].ring { if kind == 0 { h[0].tx = x; h[0].ty = y; } if world { hud_ring_pointer(h, x, y, phase, kind, id); } return; }
  // a build tool picked: the pointer is the tool's (a finger, or the mouse's first button), from its
  // press on the world to its release; the mouse's other buttons still turn the camera
  if kind == 0 || h[0].tooling || hud_tooled(h) { h[0].tx = x; h[0].ty = y; }
  if h[0].tooling && id == h[0].tool_id {
    if phase >= 2 { h[0].tooling = false; hud_tool_release(h); }
    return;
  }
  // (first person with a placing tool: the first click on the world holds the pointer, and the ones
  // after it place. A browser that refused the lock leaves the click the tool's)
  if phase == 0 && !h[0].over && kind == 0 && button == 0 && h[0].kind == CAM_KIND_FIRST && h[0].tool >= 0 && hud_looks(h) && !ml.ml_on(h[0].mouse[0]) && !h[0].mouse[0].refused {
    ml.ml_press(h[0].mouse[..], 0);
    return;
  }
  // (a placing tool takes any such press; edit mode only one on a thing: on empty world it is the camera's)
  if phase == 0 && !h[0].over && (kind != 0 || button == 0) && hud_tool_press(h) {
    h[0].tooling = true; h[0].tool_id = id;
    return;
  }
  if kind != 0 {
    if phase == 0 && (h[0].over || !world) { return; }
    if phase == 0 { ml.ml_press(h[0].mouse[..], kind); }   // a finger never holds the pointer
    h[0].sticks = pad.metaverse_sticks_world_touch(h[0].sticks, id, phase, x, y, h[0].wide, h[0].high, h[0].dpr, cast(f64) h[0].time);
    return;
  }
  if phase == 0 {
    if h[0].over || !world { return; }
    ml.ml_press(h[0].mouse[..], 0);   // a press on the world: first person holds the pointer from here (hud_mouse says whether it may)
    h[0].drag = true; h[0].drag_id = id; h[0].drag_x = x; h[0].drag_y = y;
    return;
  }
  if !h[0].drag || id != h[0].drag_id { return; }
  if phase == 1 {
    if hud_looks(h) { t := cam_drag(x - h[0].drag_x, y - h[0].drag_y, h[0].dpr); h[0].look_yaw += t[0]; h[0].look_pitch += t[1]; }
    h[0].drag_x = x; h[0].drag_y = y;
    return;
  }
  h[0].drag = false;
}
// The window lost the keys: nothing is held, no drag, no thumbs.
#test "losing the window cancels keyboard holds and queued jumps as well as thumbs" #steps 2000000000 {
  t:[1]HudTest;h:=t[0].h[..];hud_test_world(t[..]);h[0].keys=HUD_KEY_LEFT;hud_test_run(t[..],10,0.01);
  h[0].keys|=HUD_KEY_JUMP;h[0].taps=1;h[0].drag=true;h[0].sticks.move_on=true;h[0].sticks.pad_x=1;
  hud_blur(h);#assert h[0].keys==0 && h[0].taps==0 && !h[0].drag && !h[0].sticks.move_on && h[0].sticks.pad_x==0;
  x:=h[0].cx;z:=h[0].cz;hud_test_run(t[..],100,0.01);#assert h[0].foot.walk.speed==0 && abs(h[0].cx-x)+abs(h[0].cz-z)<1;
}
hud_blur :: (h: [] Hud) #export_c #effects(all) {
  if h.count < 1 { return; }
  h[0].drag = false; h[0].sticks = pad.metaverse_sticks_reset(); h[0].tap = 0;
  h[0].keys = 0; h[0].taps = 0;
  h[0].tooling = false; h[0].carry = 0; h[0].ring_down = false;
}

// An entrance starts over: the orbit begins again as its game type's, and the grass's and the sunrise's clocks at nothing.
hud_again :: (h: [] Hud) { h[0].orbiting = false; h[0].drag = false; h[0].spread = 0; h[0].dawn = 0; h[0].mouse[0].free = true; h[0].village[0].clock = 0; vl_again(h[0].village[..]); if h[0].type == HUD_CRATES { h[0].crates[0].cleared = 0; hud_crates_in(h); } if h[0].type == HUD_PLATFORMER { hud_plat_in(h); } if h[0].type == HUD_RACING { hud_race_in(h); } if h[0].type == HUD_DRIFT { hud_drift_in(h); } }
// A game type's camera: the meadow's four are the engine's camera kinds; the village is third person.
hud_cam_of :: (type: int) -> int { return ifx type == HUD_VILLAGE then CAM_KIND_THIRD else ifx type == HUD_CRATES then CAM_KIND_TOP else ifx type == HUD_PLATFORMER then CAM_KIND_SIDE else ifx type == HUD_RACING || type == HUD_DRIFT then CAM_KIND_THIRD else type; }
// The camera now: a game type's own, or the one the page's camera menu picked (orbit and follow are
// third person; first person; top-down). Side on, crates and the platformer keep their own: they have no menu.
hud_cam_want :: (h: [] Hud) -> int {
  if h[0].cam < 0 || h[0].type == CAM_KIND_SIDE || h[0].type >= HUD_CRATES { return hud_cam_of(h[0].type); }
  return ifx h[0].cam == 2 then CAM_KIND_FIRST else ifx h[0].cam == 3 then CAM_KIND_TOP else CAM_KIND_THIRD;
}
// The camera changed in the world: the orbit starts again as the new kind's, from where it stands, and a held pointer is let go.
hud_cam_to :: (h: [] Hud, kind: int) { if kind == h[0].kind { return; } h[0].kind = kind; h[0].orbiting = false; h[0].drag = false; h[0].mouse[0].free = true; }
// The meadow and what is built on it (the first four game types and the village): grass, a sunrise, the page's things drawn.
hud_meadow :: (h: [] Hud) -> bool { return h[0].type <= HUD_VILLAGE; }
// A world where the character neither jumps nor flies: crates (a jump would clear a crate).
hud_no_jump :: (h: [] Hud) -> bool { return h[0].type == HUD_CRATES; }

// ---------------------------------------------------------------- crates (world-crates.coax; docs/web-world.md, "Crates")
// What the level's things make the room (world-crates.coax CrRoom): its walls (the bodies of that
// kind) and its gate reach as far as its floor is laid; its pads, its gate and where you start are
// its marks. Told to the room whenever the things are (105), so a wall moved, a pad added or the gate
// put on another side is the room at once; the shut gate is the world's solid again.
hud_crates_lay :: (h: [] Hud) {
  b := h[0].things[..]; r: [1] CrRoom;
  for i: 0..<bd_count(b) {
    if hud_role(h, b[0].id[i]) != BL_R_WALL { continue; }
    e := bd_extent(b, i); at := b[0].set[0].pos[i];
    cr_reach(r[..], cast(f32) (at.x - e.x), cast(f32) (at.z - e.z), cast(f32) (at.x + e.x), cast(f32) (at.z + e.z));
  }
  for q: 0..<h[0].nmk {
    m := h[0].marks[q];
    side := ((m.turn % 180) + 180) % 180 == 90;   // (turned a quarter: its width lies along)
    hw := (ifx side then m.d else m.w) * 0.5; hd := (ifx side then m.w else m.d) * 0.5;
    if m.role == BL_R_GATE && !r[0].gated { r[0].gated = true; r[0].gate = [4] f32.[m.x - hw, m.z - hd, m.x + hw, m.z + hd]; cr_reach(r[..], m.x - hw, m.z - hd, m.x + hw, m.z + hd); }
    if m.role == BL_R_GOAL && r[0].ng < CR_GOALS { r[0].goals[r[0].ng * 2] = m.x; r[0].goals[r[0].ng * 2 + 1] = m.z; r[0].ng += 1; }
    if m.role == BL_R_START && !r[0].started { r[0].started = true; r[0].sx = m.x; r[0].sz = m.z; }
  }
  cr_lay(h[0].crates[..], r[0]);
  hud_statics(h);
}
// You at the room's start, standing still, and the camera starting over above the room.
hud_crates_put :: (h: [] Hud) {
  c := h[0].crates[..];
  s := cr_start(c);
  h[0].foot.walk.x = s.x; h[0].foot.walk.z = s.z; h[0].foot.walk.vx = 0; h[0].foot.walk.vz = 0; h[0].foot.walk.speed = 0;
  h[0].cx = s.x; h[0].cz = s.z; h[0].want_x = 0; h[0].want_z = 0;
  h[0].orbiting = false;
  // A new room commits its own framing immediately, including a larger room.
  // Otherwise its first frame would still use the previous room's shorter view.
  if h[0].view==HUD_WORLD {kd:=hud_camera_kind(h);o:=cam_kind_start(kd,hud_cam_feet(h),HUD_PI);o.shown=metaverse_orbit_ray(o).far;h[0].orbit=o;h[0].orbiting=true;}
}
// The room entered (the world come up, the room reset, the game's next level told): nothing lit, the
// gate shut, every thing back where the level has it (what moves dropping in, one after another, as
// when the world opens; settled, standing there), you at its start. Its things are the level's: told
// after this (the app's Play, another room), they are the room when they come (HUD_BLOCKS_MSG).
hud_crates_in :: (h: [] Hud) {
  c := h[0].crates[..]; b := h[0].things[..];
  cr_enter(c);
  if hud_calm(h) { cr_settle(c); }
  falls := 0;
  for t: 0..<h[0].nk {
    i := bd_index(b, h[0].known[t].id); if i < 0 { continue; }
    tall := ifx b[0].kind[i] == Bd_Kind.ball then b[0].half[i].x else b[0].half[i].y;
    up := 0.0;
    if !bd_fixed(b, i) && !hud_calm(h) { up = CR_DROP + CR_DROP_NEXT * cast(f64) falls; falls += 1; }
    bd_place(b, i, d3(h[0].known[t].hx, h[0].known[t].hy + tall + up, h[0].known[t].hz), DQ.{});
    if bd_fixed(b, i) || hud_calm(h) { bd_still(b, i); }
  }
  for q: 0..<h[0].nmk { h[0].marks[q].taken = false; }
  hud_crates_lay(h);
  hud_crates_put(h);
}
// A crate or a wall of the room drawn (thing `i` among the bodies, a box; `wi` how many walls came
// before it): a wall the kit's dark stone, as far up as it has risen, a line of light along its top;
// a crate a box with a light on its top, green while it rests on a pad. False: neither (a kind of
// another look), drawn as any thing is.
hud_crates_draw :: (h: [] Hud, p: [] ArchPen, i: int, wi: int) -> bool {
  b := h[0].things[..]; c := h[0].crates[..];
  role := hud_role(h, b[0].id[i]);
  if role != BL_R_WALL && role != 0 { return false; }
  pose := bd_pose(b, i);
  mid := d3(pose.pos.x, pose.pos.y, -pose.pos.z); q := hud_turned(pose.att); half := b[0].half[i];
  ex := dq_rotate(q, D3_X); ey := dq_rotate(q, D3_Y); ez := dq_rotate(q, D3_Z);
  if role == BL_R_WALL {
    up := cast(f64) cr_risen(c[0].clock, wi % 64);
    if up < 0.01 { return true; }
    low := d3_sub(mid, d3_scale(ey, half.y)); m := d3_add(low, d3_scale(ey, half.y * up));
    arch_material(p, ARCH_M_SMOOTH, 0.2, 0.235, 0.3);
    arch_obox(p, hud_v(m), hud_v(d3_scale(ex, half.x)), hud_v(d3_scale(ey, half.y * up)), hud_v(d3_scale(ez, half.z)));
    // (the line of light along its top, a tenth of its thickness in from each edge)
    on := cast(f64) cr_lights(c[0].clock);
    arch_material(p, ARCH_M_GLOW, cast(f32) (0.22 * on), cast(f32) (0.9 * on), cast(f32) (1.1 * on));
    t := d3_add(low, d3_scale(ey, half.y * up * 2 + 0.015));
    arch_obox(p, hud_v(t), hud_v(d3_scale(ex, half.x * 0.1)), hud_v(d3_scale(ey, 0.015)), hud_v(d3_scale(ez, half.z * 0.1)));
    return true;
  }
  if bd_fixed(b, i) { return false; }
  arch_material(p, ARCH_M_SMOOTH, 0.42, 0.44, 0.5);
  arch_obox(p, hud_v(mid), hud_v(d3_scale(ex, half.x)), hud_v(d3_scale(ey, half.y)), hud_v(d3_scale(ez, half.z)));
  // on a pad that it lights: its middle is within the reach of one
  held := false; r := c[0].r[0];
  for k: 0..<r.ng { if (c[0].lit & (1 << k)) != 0 && cr_abs(cast(f32) pose.pos.x - r.goals[k * 2]) <= CR_REACH && cr_abs(cast(f32) pose.pos.z - r.goals[k * 2 + 1]) <= CR_REACH { held = true; } }
  if held { arch_material(p, ARCH_M_GLOW, 0.2, 1.3, 0.7); } else { arch_material(p, ARCH_M_GLOW, 0.9, 0.5, 0.1); }
  t := d3_add(mid, d3_scale(ey, half.y + 0.012));
  arch_obox(p, hud_v(t), hud_v(d3_scale(ex, half.x * 0.38)), hud_v(d3_scale(ey, 0.012)), hud_v(d3_scale(ez, half.z * 0.38)));
  return true;
}
// The puzzle's frame: its rules (what is lit, solved, the gate, the way out), while the world is
// shown; solved, the gate is no longer solid; out through it, the next level of the game is wanted:
// the page is told "room next" (HUD_EDIT; the app reads Crates.through, coax/world.coax) and tells
// the room and its things; a game of one level is that room again. A crate never tips (a box that
// can be pushed turns only as it is put). Leaving the world the room goes down as fast as the camera
// goes up. Its mesh is written again each frame (the pads breathe, the walls rise, the crates move).
hud_crates :: (h: [] Hud, step: f32) {
  c := h[0].crates[..]; b := h[0].things[..];
  if h[0].type != HUD_CRATES { return; }
  if h[0].view != HUD_WORLD {
    if c[0].clock > 0 { if c[0].clock > 2 { c[0].clock = 2; } c[0].clock -= step * (2 / HUD_RECEDE); if c[0].clock < 0 { c[0].clock = 0; } h[0].stale = true; }
    return;
  }
  for i: 0..<bd_count(b) { if cr_is(b, i) { b[0].set[0].inv_inertia[i] = D3_ZERO; } }
  what := cr_step(c, b, h[0].cx, h[0].cz, step);
  if what == CR_SOLVED { hud_statics(h); }
  if what == CR_NEXT {
    c[0].cleared += 1;
    if c[0].rooms <= 1 { hud_crates_in(h); } else { h[0].edit_n = hud_edit_put(h, 0, "room next"); }
  }
  h[0].stale = true;
}

// ---------------------------------------------------------------- platformer (world-platformer.coax; docs/web-world.md, "Platformer")
// The course entered from its start: the character on the first slab (it rises under it), still,
// the camera starting over beside it.
hud_plat_in :: (h: [] Hud) {
  p := h[0].plat[..];
  ok := hud_plat_enter(h);
  if hud_calm(h) { p[0].clock = PF_ENTER; }   // (settled: the course is up)
  hud_plat_put(h, pf_start(p));
  h[0].orbiting = false;
  hud_statics(h);
}
// The things the course is made of, into out: the level's (h.pf_things, as the page told them), and, when
// none of them is a checkpoint (a level with no goal: an empty one, or one kept before the course was
// things), a new game's course with the level's on it. How many.
hud_plat_things :: (h: [] Hud, out: [] PfThing) -> int {
  n := 0; goal := false;
  for i: 0..<h[0].pf_n { if n < out.count { out[n] = h[0].pf_things[0].t[i]; n += 1; goal = goal || out[n - 1].role == BL_R_CHECKPOINT; } }
  if !goal { n += pf_starter(out[n..<out.count]); }
  return n;
}
// The course entered, made of the level's things.
hud_plat_enter :: (h: [] Hud) -> bool {
  g := h[0].pf_in[..]; n := hud_plat_things(h, g[0].t[..]);
  return pf_enter_with(h[0].plat[..], g[0].t[0..<n]);
}
// The level's things changed (one moved, sized, added, removed, or a moving platform's way set): the
// course is made of them as they are now, where it stands (pf_lay: the clock and what was taken kept).
hud_plat_course :: (h: [] Hud) {
  if h[0].type != HUD_PLATFORMER { return; }
  same := h[0].pf_in_n == h[0].pf_n;
  if same { for i: 0..<h[0].pf_n { a := h[0].pf_in[0].t[i]; b := h[0].pf_things[0].t[i]; if a.role != b.role || a.x != b.x || a.y != b.y || a.z != b.z || a.w != b.w || a.h != b.h || a.d != b.d || a.go != b.go || a.every != b.every { same = false; break; } } }
  if same { return; }
  h[0].pf_n = h[0].pf_in_n; for i: 0..<h[0].pf_n { h[0].pf_things[0].t[i] = h[0].pf_in[0].t[i]; }
  if !h[0].plat[0].ok { return; }   // (not entered yet: hud_plat_in makes it)
  g := h[0].pf_in[..]; n := hud_plat_things(h, g[0].t[..]);
  laid := pf_lay(h[0].plat[..], g[0].t[0..<n]);
  hud_statics(h); h[0].stale = true;
}
// The character put down at `at`, still.
hud_plat_put :: (h: [] Hud, at: [3] f32) {
  h[0].foot.walk.x = at[0]; h[0].foot.walk.z = at[2]; h[0].foot.walk.vx = 0; h[0].foot.walk.vz = 0; h[0].foot.walk.speed = 0;
  h[0].foot.jump = sr_her_jump(at[1], hud_tuning(h)); h[0].born = true;   // (put, it is where it is put: the first frame does not stand it on the floor again)
  h[0].cx = at[0]; h[0].cy = at[1]; h[0].cz = at[2]; h[0].want_x = 0; h[0].want_z = 0;
}
// The course's frame, before the character's step: its rules where the character's last step left
// it (shards, checkpoints, the goal; spikes and the void put it back at the last checkpoint; a pad
// throws it up), then the platforms move (the solids made again) and carry what stands on them. What is
// built here is the course's too (every game type is built in): the course is the level's things.
// Leaving the world the course goes down as fast as the camera goes up.
hud_platformer :: (h: [] Hud, step: f32) {
  p := h[0].plat[..];
  if h[0].type != HUD_PLATFORMER { return; }
  if h[0].view != HUD_WORLD {
    if p[0].clock > 0 { if p[0].clock > 2 { p[0].clock = 2; } p[0].clock -= step * (2 / HUD_RECEDE); if p[0].clock < 0 { p[0].clock = 0; } h[0].stale = true; }
    return;
  }
  j := h[0].foot.jump;
  s := pf_step(p, h[0].foot.walk.x, j.y, h[0].foot.walk.z, j.on_ground, step);
  if s.back { hud_plat_put(h, s.to); }
  else {
    if s.bounce { j.vy = PF_BOUNCE; j.on_ground = false; j.air_used = 0; j.jumped = true; j.cut_done = true; j.since_floor = 1; }
    j.y += s.carry[1]; j.prev_y += s.carry[1];
    h[0].foot.jump = j;
    h[0].foot.walk.z += s.carry[2];
  }
  hud_statics(h);
  h[0].stale = true;
}

// ---------------------------------------------------------------- racing (world-racing.coax; docs/web-world.md, "Racing")
// The race made: the circuit laid, the car on the grid (it drops in), the camera starting over behind it.
hud_race_in :: (h: [] Hud) {
  p: [RC_POINTS] TrackPoint; n := hud_track_points(h, p[..]);
  rc_make(h[0].race[..], p[0..<n]);
  if hud_calm(h) { rc_settle(h[0].race[..]); }
  h[0].orbiting = false;
  hud_race_feet(h); hud_statics(h);
}
// The circuit's points: the level's track points in the list's order (a mark each: its place the line's,
// its bottom the road's height, its turn the bank), or, when the level has fewer than a circuit needs
// or they make no ribbon, the ones a new game starts with. How many into out.
hud_track_points :: (h: [] Hud, out: [] TrackPoint) -> int {
  n := 0;
  for q: 0..<h[0].nmk { g := h[0].marks[q]; if g.role == BL_R_TRACK && n < out.count { out[n] = rc_point(g.ix, g.iy, g.iz, g.turn); n += 1; } }
  probe: [1] Track;
  if n < GT_TRACK_FEW || !track_make(out[0..<n], RC_PER, probe[..]) { n = rc_points(out); }
  return n;
}
// The level's track points changed (one moved, added or removed): the ribbon is laid through them again,
// the grass's table with it, and the car is back on the grid.
hud_track :: (h: [] Hud) {
  r := h[0].race[..];
  if h[0].type != HUD_RACING || !r[0].ok { return; }
  p: [RC_POINTS] TrackPoint; n := hud_track_points(h, p[..]);
  if rc_laid(r, p[0..<n]) || !rc_lay(r, p[0..<n]) { return; }
  h[0].table_for = 0;
  hud_race_feet(h); hud_statics(h);
}
// The camera's feet are the car's (the page's axes): it chases the car.
hud_race_feet :: (h: [] Hud) {
  r := h[0].race[..];
  if !r[0].ok { return; }
  a := rc_at(r);
  h[0].cx = a[0]; h[0].cy = a[1] - 0.6; h[0].cz = -a[2]; h[0].ground = h[0].cy;
  h[0].foot.walk.x = h[0].cx; h[0].foot.walk.z = h[0].cz; h[0].foot.walk.vx = 0; h[0].foot.walk.vz = 0; h[0].foot.walk.speed = 0;
}
// The race's frame: the keys as the car's (W or Up on, S or Down the brake, A and D or Left and
// Right steer, Space the handbrake), stepped by the race's own fixed step. Leaving the world the
// circuit goes as fast as the camera goes up.
hud_racing :: (h: [] Hud, step: f32) {
  r := h[0].race[..];
  if h[0].type != HUD_RACING || !r[0].ok { return; }
  if h[0].view != HUD_WORLD {
    if r[0].clock > 0 { if r[0].clock > 3 { r[0].clock = 3; } r[0].clock -= step * (3 / HUD_RECEDE); if r[0].clock < 0 { r[0].clock = 0; } r[0].baked = 0; h[0].stale = true; }
    return;
  }
  k := h[0].keys;
  on := (k & (HUD_KEY_FORE | HUD_KEY_TILT_UP)) != 0; off := (k & (HUD_KEY_BACK | HUD_KEY_TILT_DOWN)) != 0;
  right := (k & (HUD_KEY_RIGHT | HUD_KEY_TURN_RIGHT)) != 0; left := (k & (HUD_KEY_LEFT | HUD_KEY_TURN_LEFT)) != 0;
  throttle := (ifx on then 1.0f32 else 0.0f32) - (ifx off then 1.0f32 else 0.0f32);
  steer := clamp((ifx right then 1.0f32 else 0.0f32) - (ifx left then 1.0f32 else 0.0f32) + h[0].sticks.pad_x,-1,1);
  throttle = clamp(throttle + h[0].sticks.pad_y,-1,1);
  // what the page built here, for the car to meet (every game type is built in): each thing's box, in the engine's axes
  built: [RC_BOXES * 6] f32; nb := 0; b := h[0].things[..];
  for i: 0..<bd_count(b) {
    if nb >= RC_BOXES { break; }
    if hud_role(h, b[0].id[i]) == BL_R_CONE { continue; }   // (a cone is knocked away, not met: below)
    q := b[0].set[0].pos[i]; e := bd_extent(b, i); o := nb * 6;
    built[o] = cast(f32) (q.x - e.x); built[o + 1] = cast(f32) (q.y - e.y); built[o + 2] = cast(f32) (-q.z - e.z);
    built[o + 3] = cast(f32) (q.x + e.x); built[o + 4] = cast(f32) (q.y + e.y); built[o + 5] = cast(f32) (-q.z + e.z);
    nb += 1;
  }
  rc_built(r, built[0..<nb * 6]);
  // the boosts built on the road, in the engine's axes
  boosts: [HUD_MARKS * 6] f32; no := 0;
  for q: 0..<h[0].nmk {
    g := h[0].marks[q];
    if g.role != BL_R_BOOST { continue; }
    o := no * 6;
    boosts[o] = g.x - g.w * 0.5; boosts[o + 1] = g.y; boosts[o + 2] = -g.z - g.d * 0.5;
    boosts[o + 3] = g.x + g.w * 0.5; boosts[o + 4] = g.y + g.h; boosts[o + 5] = -g.z + g.d * 0.5;
    no += 1;
  }
  rc_boosts(r, boosts[0..<no * 6]);
  _ = rc_step(r, throttle, steer, (k & HUD_KEY_JUMP) != 0 || (h[0].sticks.look_on && !h[0].sticks.travelled), step);
  // a cone the car comes within reach of is knocked away from it, up and on
  car := rc_at(r); vcar := rc_speed(r);
  for i: 0..<bd_count(b) {
    if hud_role(h, b[0].id[i]) != BL_R_CONE || bd_fixed(b, i) { continue; }
    q := b[0].set[0].pos[i];
    dx := cast(f32) q.x - car[0]; dz := cast(f32) q.z + car[2]; dd := dx * dx + dz * dz;
    if dd > HUD_CONE_REACH * HUD_CONE_REACH || dd < 0.0001 { continue; }
    s := (abs(vcar) * 0.8 + 2) / sqrt(dd); m := b[0].set[0].mass[i];
    bd_wake(b, i); bd_impulse(b, i, d3(cast(f64) (dx * s) * m, 3.0 * m, cast(f64) (dz * s) * m), q);
  }
  hud_race_feet(h);
  h[0].stale = true;
}
// The chase: the camera swings round behind the car, quickly (a look of the mouse's is let go again).
hud_race_chase :: (h: [] Hud, o: Orbit, step: f32) -> Orbit {
  n := o; f := rc_ahead(h[0].race[..]);
  if !(f[0] * f[0] + f[2] * f[2] > 0.01) { return n; }
  want := yaw_of(f[0], f[2]);
  ease := step * 3.5; if ease > 1 { ease = 1; }
  n.yaw = wrap_angle(n.yaw + wrap_angle(want - n.yaw) * ease);
  return n;
}

// ---------------------------------------------------------------- drift (world-drift.coax; docs/web-world.md, "Drift")
// The world made: the course through the level's rings, the rocks and the sky from the seed, the ship on the floor at the start.
hud_drift_in :: (h: [] Hud) {
  g: [DR_RINGS] Ring; n := hud_ring_marks(h, g[..]);
  dr_make(h[0].drift[..], g[0..<n]);
  if !h[0].drift[0].ok { dr_in(h[0].drift[..]); }   // (rings the rocks have no room round: a new game's)
  if hud_calm(h) && h[0].drift[0].ok { h[0].drift[0].clock = DR_GO + DR_SKY + DR_STARS_IN; }   // (settled: the floor gone, the stars out, the sun up)
  h[0].orbiting = false;
  hud_drift_feet(h); hud_statics(h);
}
// The course's rings: the level's ring things in the list's order (a mark each: the thing's middle the
// ring's, and the ring as much wider than DR_RING_R as the thing is than its made size), or, when the
// level has none, the ones a new game starts with. How many into out.
hud_ring_marks :: (h: [] Hud, out: [] Ring) -> int {
  n := 0;
  for q: 0..<h[0].nmk { g := h[0].marks[q]; if g.role == BL_R_RING && n < out.count { out[n] = dr_ring_of(g.x, g.y, g.z, g.w, g.h); n += 1; } }
  if n < 1 { n = dr_rings(out); }
  return n;
}
// The level's rings changed (one moved, sized, added or removed): the course goes through them as they
// are now, the rocks round it, and the ship is back at the start.
hud_course_rings :: (h: [] Hud) {
  d := h[0].drift[..];
  if h[0].type != HUD_DRIFT || !d[0].ok { return; }
  g: [DR_RINGS] Ring; n := hud_ring_marks(h, g[..]);
  if dr_laid(d, g[0..<n]) || !dr_lay(d, g[0..<n]) { return; }
  d[0].baked = 0; h[0].stale = true;
  hud_drift_feet(h); hud_statics(h);
}
// The camera's feet are the ship's (the page's axes): it follows the ship, a little under it so the view is from over it.
hud_drift_feet :: (h: [] Hud) {
  d := h[0].drift[..];
  if !d[0].ok { return; }
  a := dr_at(d);
  h[0].cx = a[0]; h[0].cy = a[1] - 1.0; h[0].cz = -a[2]; h[0].ground = h[0].cy;
  h[0].foot.walk.x = h[0].cx; h[0].foot.walk.z = h[0].cz; h[0].foot.walk.vx = 0; h[0].foot.walk.vz = 0; h[0].foot.walk.speed = 0;
}
// The ship's frame: W and S thrust ahead and back, A and D strafe, Space rises and Shift sinks; the aim
// is the view's (its yaw, and how far it looks down from where a chase view rests: level). Stepped by
// the world's own fixed step. Leaving the world it goes as fast as the camera goes up.
hud_drifting :: (h: [] Hud, step: f32) {
  d := h[0].drift[..];
  if h[0].type != HUD_DRIFT || !d[0].ok { return; }
  if h[0].view != HUD_WORLD {
    if d[0].clock > 0 { if d[0].clock > 3 { d[0].clock = 3; } d[0].clock -= step * (3 / HUD_RECEDE); if d[0].clock < 0 { d[0].clock = 0; } d[0].baked = 0; h[0].stale = true; }
    return;
  }
  k := h[0].keys;
  in: DrIn;
  in.fore = hud_axis(k, HUD_KEY_FORE, HUD_KEY_BACK); in.side = hud_axis(k, HUD_KEY_RIGHT, HUD_KEY_LEFT); in.lift = hud_axis(k, HUD_KEY_JUMP, HUD_KEY_DOWN);
  if h[0].orbiting { o := h[0].orbit; in.yaw = o.yaw; in.down = o.pitch - FREE_PITCH * (1 - metaverse_orbit_first(o)); }
  // what the page built here, for the ship to meet (every game type is built in): the nearest DR_BOXES, as boxes in the engine's axes
  built: [DR_BOXES * 6] f32; nb := 0; b := h[0].things[..]; a := dr_at(d);
  far: [DR_BOXES] f32;
  for i: 0..<bd_count(b) {
    q := b[0].set[0].pos[i]; e := bd_extent(b, i);
    dx := cast(f32) q.x - a[0]; dy := cast(f32) q.y - a[1]; dz := cast(f32) -q.z - a[2]; r2 := dx * dx + dy * dy + dz * dz;
    slot := nb;
    if nb >= DR_BOXES { slot = -1; worst := 0; for j: 1..<DR_BOXES { if far[j] > far[worst] { worst = j; } } if far[worst] > r2 { slot = worst; } }
    if slot < 0 { continue; }
    o := slot * 6; far[slot] = r2;
    built[o] = cast(f32) (q.x - e.x); built[o + 1] = cast(f32) (q.y - e.y); built[o + 2] = cast(f32) (-q.z - e.z);
    built[o + 3] = cast(f32) (q.x + e.x); built[o + 4] = cast(f32) (q.y + e.y); built[o + 5] = cast(f32) (-q.z + e.z);
    if nb < DR_BOXES { nb += 1; }
  }
  dr_built(d, built[0..<nb * 6]);
  _ = dr_step(d, in, step);
  hud_drift_feet(h);
  h[0].stale = true;
}

// ---------------------------------------------------------------- the build tools
// A tool's ray, in the page's axes (where the bodies are): from the eye through the pointer; in
// first person through the middle of the window, where the reticle is.
HudRay :: struct { o: WorldPoint; d: WorldPoint; }
hud_ray :: (h: [] Hud) -> HudRay {
  c := hud_camera(h, h[0].high, h[0].dpr);
  f := sty_forward(c); r := sty_right(c); up := sty_up(c);
  nx: f32 = 0; ny: f32 = 0;
  if h[0].kind != CAM_KIND_FIRST && h[0].wide >= 1 && h[0].high >= 1 { nx = h[0].tx / h[0].wide * 2 - 1; ny = 1 - h[0].ty / h[0].high * 2; }
  ty := tan(c.fov * 0.5); tx := ty * (ifx h[0].high >= 1 then h[0].wide / h[0].high else 1.0f32);
  dx := f[0] + r[0] * nx * tx + up[0] * ny * ty; dy := f[1] + r[1] * nx * tx + up[1] * ny * ty; dz := f[2] + r[2] * nx * tx + up[2] * ny * ty;
  return HudRay.{o = world_point(c.x, c.y, -c.z), d = world_point(dx, dy, -dz)};
}
// What the ray meets first, by the engine's ray query: a thing (its place among the bodies; a box
// that has turned is met by the box round it) or the ground, and where. Nothing: `hit` false.
HudPick :: struct { hit: bool; body: int = -1; building: int; x: f32; y: f32; z: f32; nx: f32; ny: f32; nz: f32; }   // building: a placed building's id, met by one of its boxes
hud_pick :: (h: [] Hud, things: bool) -> HudPick {
  b := h[0].things[..]; s := b[0].set[..];
  boxes: [(HUD_BLOCKS + VL_SOLIDS) * QUERY_BOX] f32; balls: [HUD_BLOCKS * QUERY_CAPSULE] f32;
  box_of: [HUD_BLOCKS] int; ball_of: [HUD_BLOCKS] int; nb := 0; nc := 0;
  if things {
    for i: 0..<bd_count(b) {
      q := s[0].pos[i];
      if b[0].kind[i] == Bd_Kind.ball {
        o := nc * QUERY_CAPSULE; r := cast(f32) b[0].half[i].x;
        balls[o] = cast(f32) q.x; balls[o + 1] = cast(f32) q.y; balls[o + 2] = cast(f32) q.z; balls[o + 3] = balls[o]; balls[o + 4] = balls[o + 1]; balls[o + 5] = balls[o + 2]; balls[o + 6] = r;
        ball_of[nc] = i; nc += 1;
      } else {
        e := bd_extent(b, i); o := nb * QUERY_BOX;
        boxes[o] = cast(f32) (q.x - e.x); boxes[o + 1] = cast(f32) (q.y - e.y); boxes[o + 2] = cast(f32) (q.z - e.z);
        boxes[o + 3] = cast(f32) (q.x + e.x); boxes[o + 4] = cast(f32) (q.y + e.y); boxes[o + 5] = cast(f32) (q.z + e.z);
        box_of[nb] = i; nb += 1;
      }
    }
  }
  // and the world's own solids: a press on a building's wall or roof is met there (no thing: nothing to select)
  // (not the platformer's: its solids are its things' own boxes, already among the things)
  ns := ifx hud_plat_owns(h) && things then 0 else h[0].ns;
  for k: 0..<ns * QUERY_BOX { boxes[nb * QUERY_BOX + k] = h[0].statics[k]; }
  solid := nb + ns;
  ray := hud_ray(h);
  hit := query_ray(Colliders.{ground = hud_colliders(h).ground, ground_enabled = true, boxes = boxes[0..<solid * QUERY_BOX], capsules = balls[0..<nc * QUERY_CAPSULE]}, ray.o, ray.d, HUD_T_REACH);
  out: HudPick;
  if hit.status != QueryStatus.ok || !hit.hit { return out; }
  out.hit = true; out.x = hit.point.x; out.y = hit.point.y; out.z = hit.point.z;
  out.nx = hit.normal.x; out.ny = hit.normal.y; out.nz = hit.normal.z;
  if hit.shape == QueryShape.box && hit.index >= 0 && hit.index < nb { out.body = box_of[hit.index]; }
  if hit.shape == QueryShape.capsule && hit.index >= 0 && hit.index < nc { out.body = ball_of[hit.index]; }
  if hit.shape == QueryShape.box && hit.index >= nb && hit.index < solid && h[0].type == HUD_VILLAGE { out.building = h[0].owner[hit.index - nb]; }
  return out;
}
// A length snapped to the tools' grid, in hundredths of a square.
hud_snap :: (v: f32) -> int { return hud_whole(v / HUD_T_GRID) * hud_whole(HUD_T_GRID * 100); }
// An edit for the page, in web/blocks.coax's own words: `verb`, then a thing's id ("b7") when there
// is one, then lengths in hundredths written as squares ("1.50"). It waits its turn (hud_edit_say).
hud_edit_put :: (h: [] Hud, n: int, text: string) -> int { k := n; for c: text { if k < h[0].edit.count { h[0].edit[k] = c; k += 1; } } return k; }
hud_edit_num :: (h: [] Hud, n: int, v: int) -> int {
  k := hud_edit_put(h, n, ifx v < 0 then " -" else " "); a := ifx v < 0 then -v else v;
  digits: [12] u8; m := 0; whole := a / 100;
  if whole == 0 { digits[0] = '0'; m = 1; }
  while whole > 0 && m < 12 { digits[m] = cast(u8) ('0' + whole % 10); m += 1; whole /= 10; }
  while m > 0 { m -= 1; if k < h[0].edit.count { h[0].edit[k] = digits[m]; k += 1; } }
  two: [3] u8; two[0] = '.'; two[1] = cast(u8) ('0' + (a / 10) % 10); two[2] = cast(u8) ('0' + a % 10);
  return hud_edit_put(h, k, cast(string) two[0..<3]);
}
hud_edit :: (h: [] Hud, verb: string, id: int, v: [] int) {
  n := hud_edit_put(h, 0, verb);
  if id > 0 {
    n = hud_edit_put(h, n, " b");
    digits: [12] u8; m := 0; a := id;
    while a > 0 && m < 12 { digits[m] = cast(u8) ('0' + a % 10); m += 1; a /= 10; }
    while m > 0 { m -= 1; if n < h[0].edit.count { h[0].edit[n] = digits[m]; n += 1; } }
  }
  for k: 0..<v.count { n = hud_edit_num(h, n, v[k]); }
  h[0].edit_n = n;
}
// The waiting edit is told to the page when nothing else is being told.
hud_edit_say :: (h: [] Hud) {
  // (a limit that was met goes when no edit is waiting: its words, for the page to show)
  if h[0].edit_n <= 0 && h[0].limit > HUD_L_NONE && h[0].limit < HUD_L_COUNT && h[0].action == 0 { words := HUD_L_WORDS; h[0].edit_n = hud_edit_put(h, 0, words[h[0].limit]); h[0].limit = HUD_L_NONE; }
  if h[0].edit_n <= 0 || h[0].action != 0 { return; }
  h[0].out_n = 0;
  for i: 0..<h[0].edit_n { h[0].outbox[h[0].out_n] = h[0].edit[i]; h[0].out_n += 1; }
  h[0].edit_n = 0; h[0].action = HUD_EDIT;
}
// Whether the page would take one more thing of the tool's kind at (x, z), hundredths of a square:
// there is room for it (a thousand things, blocks and balls alike: web/blocks.coax's limit) and the
// place is inside the world's bounds. When not, the tool's ghost says so and a press places nothing.
hud_room :: (h: [] Hud, tool: int, x: int, z: int) -> bool { return hud_room_why(h, tool, x, z) == HUD_L_NONE; }
// Which limit refuses it (HUD_L_NONE: none does).
hud_room_why :: (h: [] Hud, tool: int, x: int, z: int) -> int {
  b := h[0].things[..]; far := hud_whole(hud_far(h) * 100);
  if x < -far || x > far || z < -far || z > far { return HUD_L_FAR; }
  return ifx h[0].nk >= HUD_BLOCKS then HUD_L_FULL else HUD_L_NONE;
}
// Where a placing tool would put its thing now, and how: the middle of its footprint and its
// bottom's height (hundredths of a square), whether it may go there, and whether the place is the
// furthest the tool reaches and not where the pointer is.
//
// The ray (the pointer's, or the reticle's in first person) meets the ground or a thing. On a
// thing's top the new one stands on that top; on a thing's side it stands beside it, at that
// thing's own foot. Then the mode, set down at rest either way (nothing a tool places drops in):
//   snap   the footprint is a cell of the grid (a cell is as wide as the thing: a metre for a
//          block, so blocks sit flush). A cell something stands in is blocked
//   free   exactly where the ray meets; blocked where it would stand in something
// Far off a pixel of the pointer covers metres of ground, so a place that is not on the grid is
// kept to a grain no finer than two pixels there (hud_grain): the ghost stands still. A ray that
// meets nothing (over the horizon), or meets the ground past the world's bounds, is brought back
// to the furthest place a thing may stand along the way it points: `clamped`.
HudAim :: struct { ok: bool; x: int; y: int; z: int; blocked: bool; clamped: bool; why: int; }   // why: the limit that blocks it (HUD_L_*)
// A shape the tool places, as the one path that places them all needs it: half its footprint's
// side (a ball's radius) and its height. A cube is a metre; the sphere 0.6 m in radius; the slab
// 2 m square and a quarter high; the pillar a metre square and 3 m high. All but the sphere are
// boxes to the page and the physics (`place X Z W D H`): a shape here is a size, not a new body.
HudShape :: struct { half: f32; tall: f32; }
hud_shape :: (tool: int) -> HudShape {
  if tool == HUD_T_BALL { return HudShape.{half = HUD_T_BALL_R, tall = HUD_T_BALL_R * 2}; }
  if tool == HUD_T_SLAB { return HudShape.{half = 1, tall = 0.25}; }
  if tool == HUD_T_PILLAR { return HudShape.{half = 0.5, tall = 3}; }
  return HudShape.{half = 0.5, tall = 1};
}
// The grain a place far away is kept to, metres: a hundredth near by, and further off the least of
// 5, 10, 25 and 50 cm, 1, 2 and 5 m that two pixels of the pointer cover there (the ground `far`
// metres off, seen from `high` over it, through a lens of `focal` pixels).
hud_grain :: (far: f32, high: f32, focal: f32) -> f32 {
  up := ifx high < 0.5 then 0.5f32 else high;
  two := ifx focal > 1 then 2 * far * far / (up * focal) else 0.0f32;
  steps := [7] f32.[0.05, 0.1, 0.25, 0.5, 1, 2, 5];
  if two <= 0.02 { return 0.01; }
  for s: steps { if s >= two { return s; } }
  return 5;
}
// How far from the middle a thing may be put in this game type, metres.
hud_far :: (h: [] Hud) -> f32 { return ifx h[0].type == HUD_PLATFORMER || h[0].type == HUD_DRIFT then HUD_T_FAR_COURSE else HUD_T_FAR; }
hud_aim :: (h: [] Hud) -> HudAim {
  out: HudAim;
  b := h[0].things[..];
  sh := hud_shape(h[0].tool); half := sh.half; tall := sh.tall;
  ray := hud_ray(h); at := hud_pick(h, true); far_m := hud_far(h);
  // side on, in the platformer: where the pointer is on the character's line (x 0), the shape's middle
  // there, unless the ray meets a thing or a platform's top before it (there is no ground to stand it on)
  if h[0].type == HUD_PLATFORMER && abs(ray.d.x) > 0.0001 {
    t := -ray.o.x / ray.d.x;
    dx := at.x - ray.o.x; dy := at.y - ray.o.y; dz := at.z - ray.o.z;
    dl := sqrt(ray.d.x * ray.d.x + ray.d.y * ray.d.y + ray.d.z * ray.d.z);
    met := at.hit && (at.body >= 0 || at.ny > 0.7) && sqrt(dx * dx + dy * dy + dz * dz) < t * dl + 0.01;
    if t > 0 && !met { at = HudPick.{hit = true, x = 0, y = ray.o.y + ray.d.y * t - tall * 0.5, z = ray.o.z + ray.d.z * t, ny = 1}; }
  }
  // drift, in open space: a thing met nearer than HUD_T_SPACE, else the shape's middle that far along the ray (no ground)
  if h[0].type == HUD_DRIFT {
    dx := at.x - ray.o.x; dy := at.y - ray.o.y; dz := at.z - ray.o.z;
    dl := sqrt(ray.d.x * ray.d.x + ray.d.y * ray.d.y + ray.d.z * ray.d.z);
    if dl < 0.0001 { return out; }
    if !(at.hit && at.body >= 0 && sqrt(dx * dx + dy * dy + dz * dz) < HUD_T_SPACE) {
      t := HUD_T_SPACE / dl;
      at = HudPick.{hit = true, x = ray.o.x + ray.d.x * t, y = ray.o.y + ray.d.y * t - tall * 0.5, z = ray.o.z + ray.d.z * t, ny = 1};
    }
  }
  px := at.x; py: f32 = 0; pz := at.z; on := -1;
  if at.hit && abs(at.x) <= far_m && abs(at.z) <= far_m { on = at.body; }
  else {
    // nothing met, or the ground past the bounds: the furthest place along the way the ray points
    flat := sqrt(ray.d.x * ray.d.x + ray.d.z * ray.d.z);
    if flat < 0.0001 { return out; }
    ux := ray.d.x / flat; uz := ray.d.z / flat; reach: f32 = HUD_T_REACH;
    if ux > 0.0001 { reach = fmin_f(reach, (far_m - ray.o.x) / ux); } else if ux < -0.0001 { reach = fmin_f(reach, (-far_m - ray.o.x) / ux); }
    if uz > 0.0001 { reach = fmin_f(reach, (far_m - ray.o.z) / uz); } else if uz < -0.0001 { reach = fmin_f(reach, (-far_m - ray.o.z) / uz); }
    if reach < 0 { reach = 0; }
    px = clamp(ray.o.x + ux * reach, -far_m, far_m); pz = clamp(ray.o.z + uz * reach, -far_m, far_m);
    out.clamped = true;
  }
  snap := h[0].mode == HUD_M_SNAP; cell := half * 2;
  if on >= 0 {
    q := b[0].set[0].pos[on]; e := bd_extent(b, on);
    if at.ny > 0.7 { py = at.y; }
    else {
      // a side: beside it, at its foot (snapped, the cell next to the one met; else touching the face)
      nl := sqrt(at.nx * at.nx + at.nz * at.nz); out_by := ifx snap then 0.02f32 else half;
      if nl > 0.0001 { px += at.nx / nl * out_by; pz += at.nz / nl * out_by; }
      py = cast(f32) (q.y - e.y); if py < 0 && h[0].type != HUD_DRIFT { py = 0; }
    }
  }
  // (a top met that is no thing's: a platform's, a roof: it stands on that; never under the floor)
  if on < 0 && at.hit && !out.clamped && at.ny > 0.7 && (at.y > 0.05 || h[0].type == HUD_DRIFT) { py = at.y; }
  if snap { px = (floor(px / cell) + 0.5) * cell; pz = (floor(pz / cell) + 0.5) * cell; }
  else {
    dx := px - ray.o.x; dz := pz - ray.o.z;
    g := hud_grain(sqrt(dx * dx + dz * dz), ray.o.y - py, h[0].high * 0.5 / tan(hud_lens(h) * 0.5));
    px = floor(px / g + 0.5) * g; pz = floor(pz / g + 0.5) * g;
  }
  if h[0].type == HUD_PLATFORMER { px = 0; }   // (side on, on the character's line, snapped or not)
  out.ok = true; out.x = hud_whole(px * 100); out.y = hud_whole(py * 100); out.z = hud_whole(pz * 100);
  far := hud_whole(far_m * 100);
  if out.x > far { out.x = far; } if out.x < -far { out.x = -far; } if out.z > far { out.z = far; } if out.z < -far { out.z = -far; }
  // (snapped beside a thing whose side is not on the grid's lines, the cell next to the face still
  // holds part of that thing: then it is the cell after it, one more along the way the face looks)
  if snap && on >= 0 && !(at.ny > 0.7) && hud_stands_in(h, out.x, out.y, out.z, half, tall) {
    step := hud_whole(cell * 100);
    if abs(at.nx) >= abs(at.nz) { out.x += ifx at.nx > 0 then step else -step; } else { out.z += ifx at.nz > 0 then step else -step; }
  }
  out.why = hud_room_why(h, h[0].tool, out.x, out.z);
  // set down at rest, it may not stand in anything
  if out.why == HUD_L_NONE && hud_stands_in(h, out.x, out.y, out.z, half, tall) { out.why = HUD_L_ROOM; }
  out.blocked = out.why != HUD_L_NONE;
  return out;
}
// Where a building tool would put its building now: where the ray meets the ground (or a building, at its
// foot), on the half-metre grid when snapped, turned the page's quarter turns. Blocked where it would stand in
// another building or the person, or when the buildings' boxes are all used.
hud_aim_building :: (h: [] Hud) -> HudAim {
  out: HudAim; v := h[0].village[..];
  m := h[0].tool - HUD_T_MODEL;
  if m < 0 || m >= VL_KINDS || !v[0].ready { return out; }
  at := hud_pick(h, false);
  if !at.hit { return out; }
  px := at.x; pz := at.z;
  if h[0].mode == HUD_M_SNAP { px = floor(px / HUD_T_HALF + 0.5) * HUD_T_HALF; pz = floor(pz / HUD_T_HALF + 0.5) * HUD_T_HALF; }
  out.ok = true; out.x = hud_whole(px * 100); out.z = hud_whole(pz * 100); out.y = 0;
  far := hud_whole(HUD_T_FAR * 100);
  if out.x > far || out.x < -far || out.z > far || out.z < -far { out.why = HUD_L_FAR; out.blocked = true; return out; }
  scale := VL_SCALE; boxes := VL_KIND_BOXES; used := 0;
  for j: 0..<v[0].nput { used += boxes[v[0].put[j].model]; }
  if !vl_fits(m, v[0].nput, used) { out.why = HUD_L_BOXES; out.blocked = true; return out; }
  p := VlPlace.{model = m, x = cast(f32) out.x * 0.01, z = cast(f32) out.z * 0.01, quarter = h[0].quarter, scale = cast(f32) scale[m] * 0.01};
  // (every building's boxes, risen or not, so none is placed where one is about to stand)
  all: [VL_SOLIDS * QUERY_BOX] f32; n := vl_all_solids(v, all[..]);
  if vl_meets(v, p, all[0..<n * QUERY_BOX], h[0].cx, h[0].cz, h[0].cy + HUD_TALL) { out.why = HUD_L_ROOM; out.blocked = true; }
  return out;
}
// The ghost of the building a tool would place, where it would go: the real model, tinted, its record and draw.
hud_ghost_building :: (h: [] Hud) {
  v := h[0].village[..];
  was := v[0].ghost; was_on := v[0].ghost_on; was_bad := v[0].ghost_bad;
  aim := ifx h[0].tool >= HUD_T_MODEL && hud_tooled(h) && h[0].type == HUD_VILLAGE && (h[0].tx >= -1000 || h[0].kind == CAM_KIND_FIRST) then hud_aim_building(h) else HudAim.{};
  scale := VL_SCALE; m := h[0].tool - HUD_T_MODEL;
  v[0].ghost_on = aim.ok;
  if aim.ok { v[0].ghost = VlPlace.{model = m, x = cast(f32) aim.x * 0.01, z = cast(f32) aim.z * 0.01, quarter = h[0].quarter, scale = cast(f32) scale[m] * 0.01}; v[0].ghost_bad = aim.blocked; }
  g := v[0].ghost;
  if was_on != v[0].ghost_on || was_bad != v[0].ghost_bad || g.model != was.model || g.x != was.x || g.z != was.z || g.quarter != was.quarter {
    vl_ghost_record(v, h[0].records[HUD_KIT_RECORDS * HUD_RECORD_FLOATS..<h[0].records.count]); h[0].rec_gen += 1;
  }
}
// Whether a thing of this footprint and height, its bottom at y over (x, z) (hundredths), would
// stand in any thing that is there (a centimetre and a half of touching is not standing in).
hud_stands_in :: (h: [] Hud, xi: int, yi: int, zi: int, half: f32, tall: f32) -> bool {
  b := h[0].things[..];
  x := cast(f64) xi * 0.01; y := cast(f64) yi * 0.01; z := cast(f64) zi * 0.01; r := cast(f64) half - 0.015; top := y + cast(f64) tall - 0.015;
  for i: 0..<bd_count(b) {
    q := b[0].set[0].pos[i]; e := bd_extent(b, i);
    if x + r > q.x - e.x && x - r < q.x + e.x && z + r > q.z - e.z && z - r < q.z + e.z && top > q.y - e.y && y + 0.015 < q.y + e.y { return true; }
  }
  return false;
}
fmin_f :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }
// Whether the hotbar's tools work now: a placing tool is picked or edit mode is on, and the world is shown (from its first frame).
hud_tooled :: (h: [] Hud) -> bool { return (h[0].tool >= 0 || h[0].editing) && hud_looks(h); }
// A press on the world, where the pointer is. True when it is the tools' and not the camera's.
// A placing tool: a new block or ball where the ray meets the ground or a thing, snapped (it falls
// in as placed things do). Else, in edit mode: the thing under the pointer is selected and held
// (a drag moves it); on empty ground nothing is selected, and the press is the camera's.
// Every one is an edit of the page's list, told to the page.
hud_tool_press :: (h: [] Hud) -> bool {
  if !hud_tooled(h) { return false; }
  b := h[0].things[..]; none: [1] int;
  at := hud_pick(h, true);
  if h[0].tool >= HUD_T_MODEL {
    // a building where its ghost is: the page checks it again (web/blocks.coax bl_building_why) and says why when not
    aim := hud_aim_building(h);
    if aim.ok && aim.blocked { h[0].limit = aim.why; }
    if !aim.ok || aim.blocked { return true; }
    m := h[0].tool - HUD_T_MODEL;
    n := hud_edit_put(h, 0, "put "); n = hud_edit_put(h, n, vl_word(m));
    n = hud_edit_num(h, n, aim.x); n = hud_edit_num(h, n, aim.z); n = hud_edit_num(h, n, h[0].quarter * 9000);
    h[0].edit_n = n;
    return true;
  }
  if h[0].tool >= 0 {
    // set down exactly where the ghost is, at rest
    aim := hud_aim(h);
    // (a place it may not go: nothing is placed, and the page says why in words; brought back from past the bounds, it is placed and the bound is said)
    if aim.ok && aim.blocked { h[0].limit = aim.why; }
    if !aim.ok || aim.blocked { return true; }
    if aim.clamped { h[0].limit = HUD_L_FAR; }
    sh := hud_shape(h[0].tool);
    box := [6] int.[aim.x, aim.z, hud_whole(sh.half * 200), hud_whole(sh.half * 200), hud_whole(sh.tall * 100), aim.y]; ball := [4] int.[aim.x, aim.z, hud_whole(HUD_T_BALL_R * 100), aim.y];
    // (set down exactly where the ghost is, at rest: its bottom's height is always said)
    if h[0].tool != HUD_T_BALL { hud_edit(h, "place", 0, box[..]); } else { hud_edit(h, "ball", 0, ball[..]); }
    h[0].edit_n = hud_edit_put(h, h[0].edit_n, " rest");
    return true;
  }
  id := ifx at.hit && at.body >= 0 then b[0].id[at.body] else ifx at.hit && at.building > 0 then at.building else 0;
  if id > 0 {
    h[0].carry = id; h[0].held_x = h[0].tx; h[0].held_y = h[0].ty;
    if id != h[0].sel { hud_edit(h, "select", id, none[0..<0]); }
    return true;
  }
  if h[0].sel > 0 { hud_edit(h, "select none", 0, none[0..<0]); }
  return false;
}
// Whether the held thing has been dragged, and not only pressed.
hud_dragged :: (h: [] Hud) -> bool { return h[0].carry > 0 && abs(h[0].tx - h[0].held_x) + abs(h[0].ty - h[0].held_y) > HUD_T_DRAG * h[0].dpr; }
// The press let go. A thing that was dragged is put where the ray meets the ground, snapped: the
// page moves it there, and it falls to rest as any moved thing does.
hud_tool_release :: (h: [] Hud) {
  id := h[0].carry; moved := hud_dragged(h); h[0].carry = 0;
  if id <= 0 || !moved || !hud_tooled(h) || !h[0].editing { return; }
  at := hud_pick(h, false);
  to := [2] int.[hud_snap(at.x), hud_snap(at.z)];
  if at.hit { hud_edit(h, "move", id, to[..]); }
}
// The wheel in edit mode with the pointer on the selected thing: the thing grows (up the wheel) or
// shrinks a notch, every side alike, within the page's limits. True when the wheel was the tools'.
hud_tool_wheel :: (h: [] Hud, dy: f32) -> bool {
  // (a building tool: the wheel turns its ghost a quarter, as R and Shift+R do: the page keeps the turn)
  if hud_tooled(h) && h[0].tool >= HUD_T_MODEL { if dy != 0 { h[0].edit_n = hud_edit_put(h, 0, ifx dy > 0 then "spin 1" else "spin -1"); } return true; }
  if !hud_tooled(h) || !h[0].editing || h[0].sel <= 0 { return false; }
  b := h[0].things[..]; i := bd_index(b, h[0].sel);
  at := hud_pick(h, true);
  if i < 0 || !at.hit || at.body != i { return false; }
  if dy == 0 { return true; }
  k: f64 = ifx dy < 0 then HUD_T_GROW else 1.0 / HUD_T_GROW;
  ball := b[0].kind[i] == Bd_Kind.ball; st := hud_stand(h, i);
  low: f64 = ifx ball then 0.3 else 0.25; high: f64 = ifx ball then 3.0 else 12.0;
  // (all three by one factor, kept inside the limits together so its shape is kept)
  most := fmax(fmax(st.w, st.h), st.d); least := fmin(fmin(st.w, st.h), st.d);
  if most * k > high { k = high / most; h[0].limit = HUD_L_SIZE; }
  if least * k < low { k = low / least; h[0].limit = HUD_L_SIZE; }
  now := [3] int.[hud_whole(cast(f32) (st.w * k * 100)), hud_whole(cast(f32) (st.d * k * 100)), hud_whole(cast(f32) (st.h * k * 100))];
  hud_edit(h, "size", h[0].sel, now[..]);
  return true;
}
// A box drawn as its twelve edges, in the window, from its low and high corners in the page's axes.
hud_wire :: (o: [] HudOut, u: [] f32, lo: [3] f32, hi: [3] f32, d: f32, alpha: f32) {
  c: [8] StyOnScreen;
  for k: 0..<8 { c[k] = sty_project(u, ifx (k & 1) != 0 then hi[0] else lo[0], ifx (k & 2) != 0 then hi[1] else lo[1], -(ifx (k & 4) != 0 then hi[2] else lo[2])); }
  ends := [24] int.[0, 1, 2, 3, 4, 5, 6, 7, 0, 2, 1, 3, 4, 6, 5, 7, 0, 4, 1, 5, 2, 6, 3, 7];
  for e: 0..<12 { a := c[ends[e * 2]]; b := c[ends[e * 2 + 1]]; if a.ahead && b.ahead { hud_line(o, a.x, a.y, b.x, b.y, d, alpha); } }
}
// A ball drawn as three rings round its middle.
hud_rings :: (o: [] HudOut, u: [] f32, x: f32, y: f32, z: f32, r: f32, d: f32, alpha: f32) {
  for ring: 0..<3 {
    was: StyOnScreen;
    for k: 0..<25 {
      a := cast(f32) k * 0.2617994; ca := cos(a) * r; sa := sin(a) * r;
      p := ifx ring == 0 then sty_project(u, x + ca, y, -(z + sa)) else ifx ring == 1 then sty_project(u, x + ca, y + sa, -z) else sty_project(u, x, y + ca, -(z + sa));
      if k > 0 && was.ahead && p.ahead { hud_line(o, was.x, was.y, p.x, p.y, d, alpha); }
      was = p;
    }
  }
}
// A cross at height y round (x, z), half a side `r`: a place a thing cannot be put.
hud_cross :: (o: [] HudOut, u: [] f32, x: f32, y: f32, z: f32, r: f32, d: f32, alpha: f32) {
  a := sty_project(u, x - r, y, -(z - r)); b := sty_project(u, x + r, y, -(z + r)); c := sty_project(u, x - r, y, -(z + r)); e := sty_project(u, x + r, y, -(z - r));
  if a.ahead && b.ahead { hud_line(o, a.x, a.y, b.x, b.y, d, alpha); }
  if c.ahead && e.ahead { hud_line(o, c.x, c.y, e.x, e.y, d, alpha); }
}
// A square at height y round (x, z), half a side `r`: a footprint, or a cell of the grid.
hud_square :: (o: [] HudOut, u: [] f32, x: f32, y: f32, z: f32, r: f32, d: f32, alpha: f32) {
  c: [4] StyOnScreen;
  c[0] = sty_project(u, x - r, y, -(z - r)); c[1] = sty_project(u, x + r, y, -(z - r)); c[2] = sty_project(u, x + r, y, -(z + r)); c[3] = sty_project(u, x - r, y, -(z + r));
  for k: 0..<4 { a := c[k]; b := c[(k + 1) % 4]; if a.ahead && b.ahead { hud_line(o, a.x, a.y, b.x, b.y, d, alpha); } }
}
// The placing tool's ghost: the thing where it would go, and how. Snap: the grid's cell lit under
// it, and the thing flush in it. Free: the thing alone. Drop: the thing up in the air where it
// would appear, a faint line down to the ground and its footprint there. Where it may not go: all
// of it faint, and a cross. At the furthest the tool reaches: a bar across its foot with its two
// ends turned down. Far off, where it is too small to see: a marker standing over it.
hud_ghost :: (h: [] Hud, o: [] HudOut, u: [] f32, d: f32) {
  aim := hud_aim(h);
  if !aim.ok { return; }
  ball := h[0].tool == HUD_T_BALL;
  sh := hud_shape(h[0].tool); half := sh.half; tall := sh.tall;
  x := cast(f32) aim.x * 0.01; y := cast(f32) aim.y * 0.01; z := cast(f32) aim.z * 0.01;
  alpha: f32 = ifx aim.blocked then 0.3 else 0.7;
  if ball { hud_rings(o, u, x, y + half, z, half, d, alpha); }
  else { hud_wire(o, u, [3] f32.[x - half, y, z - half], [3] f32.[x + half, y + tall, z + half], d, alpha); }
  if h[0].mode == HUD_M_SNAP { hud_square(o, u, x, y, z, half, 2 * d, ifx aim.blocked then 0.45f32 else 0.95f32); }
  if aim.blocked { hud_cross(o, u, x, y, z, half, 2 * d, 0.8); }
  foot := sty_project(u, x, y, -z); head := sty_project(u, x, y + tall, -z);
  if !foot.ahead { return; }
  if aim.clamped {
    w := 28 * d;
    hud_line(o, foot.x - w, foot.y, foot.x + w, foot.y, 2 * d, 0.9);
    hud_line(o, foot.x - w, foot.y, foot.x - w, foot.y + 7 * d, 2 * d, 0.9); hud_line(o, foot.x + w, foot.y, foot.x + w, foot.y + 7 * d, 2 * d, 0.9);
  }
  if head.ahead && abs(foot.y - head.y) < HUD_T_SMALL * d {
    top := foot.y - HUD_T_PIN * d; m := 5 * d;
    hud_line(o, foot.x, foot.y, foot.x, top + m, 2 * d, 0.9);
    hud_line(o, foot.x, top + m, foot.x - m, top, 2 * d, 0.9); hud_line(o, foot.x - m, top, foot.x, top - m, 2 * d, 0.9);
    hud_line(o, foot.x, top - m, foot.x + m, top, 2 * d, 0.9); hud_line(o, foot.x + m, top, foot.x, top + m, 2 * d, 0.9);
  }
}
// A thing's box, as it lies now, as lines; a ball as rings.
hud_wire_thing :: (h: [] Hud, o: [] HudOut, u: [] f32, i: int, d: f32, alpha: f32) {
  b := h[0].things[..]; q := b[0].set[0].pos[i];
  if b[0].kind[i] == Bd_Kind.ball { hud_rings(o, u, cast(f32) q.x, cast(f32) q.y, cast(f32) q.z, cast(f32) b[0].half[i].x, d, alpha); return; }
  e := bd_extent(b, i);
  hud_wire(o, u, [3] f32.[cast(f32) (q.x - e.x), cast(f32) (q.y - e.y), cast(f32) (q.z - e.z)], [3] f32.[cast(f32) (q.x + e.x), cast(f32) (q.y + e.y), cast(f32) (q.z + e.z)], d, alpha);
}
// What the tools show, as lines over the world: in edit mode the selected thing's box, bright, and
// the thing under the pointer, fainter; a ghost of the block or the ball where a placing tool would
// put it; and, dragging a thing, its box where it would be put down.
// The app's editor (the world held still): each thing it names lit, as its edges (a ball's rings), brighter the more
// lit; a mark (a goal, a shard, a boost) by its own box.
hud_still_draw :: (h: [] Hud, o: [] HudOut, u: [] f32, d: f32) {
  b := h[0].things[..];
  for g: 0..<h[0].glow_n {
    a := h[0].glow_a[g]; if !(a > 0) { continue; }
    i := bd_index(b, h[0].glow[g]);
    if i >= 0 { hud_wire_thing(h, o, u, i, 2 * d, ifx a > 1 then 1.0f32 else a); continue; }
    // (a building: the bounds of its solid boxes, or, of a model with none, its footprint as high as it stands)
    v := h[0].village[..];
    for j: 0..<v[0].nput {
      if h[0].type != HUD_VILLAGE || v[0].put_id[j] != h[0].glow[g] { continue; }
      lo := [3] f32.[1e9, 1e9, 1e9]; hi := [3] f32.[-1e9, -1e9, -1e9]; any := false;
      for k: 0..<h[0].ns {
        if h[0].owner[k] != h[0].glow[g] { continue; }
        x := h[0].statics[k * QUERY_BOX..<(k + 1) * QUERY_BOX]; any = true;
        for q: 0..<3 { if x[q] < lo[q] { lo[q] = x[q]; } if x[q + 3] > hi[q] { hi[q] = x[q + 3]; } }
      }
      if !any {
        p := v[0].put[j]; f := vl_foot(p.model, hud_whole(p.x * 100), hud_whole(p.z * 100), p.quarter, hud_whole(p.scale * 100)); tall := VL_TALL;
        lo = [3] f32.[cast(f32) (f.x - f.hx) * 0.01, 0, cast(f32) (f.z - f.hz) * 0.01]; hi = [3] f32.[cast(f32) (f.x + f.hx) * 0.01, cast(f32) tall[p.model] * 0.001 * p.scale, cast(f32) (f.z + f.hz) * 0.01];
      }
      hud_wire(o, u, lo, hi, 2 * d, ifx a > 1 then 1.0f32 else a);
    }
    for q: 0..<h[0].nmk {
      m := h[0].marks[q]; if m.id != h[0].glow[g] { continue; }
      hud_wire(o, u, [3] f32.[m.x - m.w * 0.5, m.y, m.z - m.d * 0.5], [3] f32.[m.x + m.w * 0.5, m.y + m.h, m.z + m.d * 0.5], 2 * d, ifx a > 1 then 1.0f32 else a);
    }
  }
}
hud_tool_draw :: (h: [] Hud, o: [] HudOut, u: [] f32, d: f32) {
  if !hud_tooled(h) { return; }
  b := h[0].things[..];
  chosen := ifx h[0].editing && h[0].sel > 0 then bd_index(b, h[0].sel) else -1;
  if chosen >= 0 { hud_wire_thing(h, o, u, chosen, 2 * d, 0.9); }
  // (a placed building selected: the bounds of its boxes)
  if h[0].editing && h[0].sel > 0 && chosen < 0 {
    lo := [3] f32.[1e9, 1e9, 1e9]; hi := [3] f32.[-1e9, -1e9, -1e9]; any := false;
    for k: 0..<h[0].ns {
      if h[0].owner[k] != h[0].sel { continue; }
      x := h[0].statics[k * QUERY_BOX..<(k + 1) * QUERY_BOX]; any = true;
      for a: 0..<3 { if x[a] < lo[a] { lo[a] = x[a]; } if x[a + 3] > hi[a] { hi[a] = x[a + 3]; } }
    }
    if any { hud_wire(o, u, lo, hi, 2 * d, 0.9); }
  }
  if h[0].tx < -1000 && h[0].kind != CAM_KIND_FIRST { return; }
  if hud_dragged(h) {
    i := bd_index(b, h[0].carry); at := hud_pick(h, false);
    if i < 0 || !at.hit { return; }
    e := bd_extent(b, i); x := cast(f32) hud_snap(at.x) * 0.01; z := cast(f32) hud_snap(at.z) * 0.01;
    if b[0].kind[i] == Bd_Kind.ball { hud_rings(o, u, x, cast(f32) e.y, z, cast(f32) e.x, d, 0.7); }
    else { hud_wire(o, u, [3] f32.[x - cast(f32) e.x, 0, z - cast(f32) e.z], [3] f32.[x + cast(f32) e.x, cast(f32) (e.y * 2), z + cast(f32) e.z], d, 0.7); }
    return;
  }
  if h[0].tool >= HUD_T_MODEL {
    v := h[0].village[..];
    if !v[0].ghost_on { return; }
    scale := VL_SCALE; g := v[0].ghost;
    f := vl_foot(g.model, hud_whole(g.x * 100), hud_whole(g.z * 100), g.quarter, scale[g.model]);
    lo := [3] f32.[cast(f32) (f.x - f.hx) * 0.01, 0.02, cast(f32) (f.z - f.hz) * 0.01]; hi := [3] f32.[cast(f32) (f.x + f.hx) * 0.01, 0.02, cast(f32) (f.z + f.hz) * 0.01];
    hud_wire(o, u, lo, hi, 2 * d, ifx v[0].ghost_bad then 0.45f32 else 0.85f32);
    if v[0].ghost_bad { hud_cross(o, u, g.x, 0.02, g.z, 0.6, 2 * d, 0.8); }
    return;
  }
  if h[0].tool >= 0 { hud_ghost(h, o, u, d); return; }
  at := hud_pick(h, true);
  if !at.hit { return; }
  if at.body >= 0 && at.body != chosen { hud_wire_thing(h, o, u, at.body, d, 0.45); }
}

// The page's word: its panels (100) or the pointer (101), in the inbox.
hud_message :: (h: [] Hud, kind: int, length: int) #export_c #effects(all) {
  if kind == 116 { if h.count>0 { h[0].observe_on = length==1 && h[0].inbox[0]=='1'; } return; }
  if h.count < 1 || length < 0 || length > HUD_INBOX { return; }
  t := cast(string) h[0].inbox[0..<length];
  if kind == HUD_POINTER_MSG {
    x := hud_read(t, 0); y := hud_read(t, x.at);
    if x.ok && y.ok { h[0].px = cast(f32) x.value; h[0].py = cast(f32) y.value; } else { h[0].px = -9999; h[0].py = -9999; }
    return;
  }
  if kind == HUD_SCROLL_MSG {
    // how far the window is down the page, in thousandths
    v := hud_read(t, 0); px := hud_read(t, v.at);
    if v.ok { h[0].scroll = ifx v.value < 0 then 0.0f32 else ifx v.value > 1000 then 1.0f32 else cast(f32) v.value / 1000; }
    if px.ok { h[0].down = cast(f32) px.value; }
    return;
  }
  if kind == HUD_VIEW_MSG {
    // which page is shown: 1 leans the camera back so the grid is seen as ground
    v := hud_read(t, 0);
    if v.ok && v.value >= HUD_HOME && v.value <= HUD_WORLD {
      if v.value != HUD_WORLD && h[0].ring { hud_ring_off(h); }   // (the ring is the world's: another page ends it)
      if v.value == HUD_WORLD && h[0].view != HUD_WORLD { hud_again(h); h[0].since = 0; if hud_calm(h) { hud_settle(h); } }   // each time the world comes up its entrance plays from the start; or, settled, there is none
      h[0].view = v.value; h[0].lean = ifx v.value == HUD_HOME then 0.0f32 else 1.0f32;
    }
    return;
  }
  if kind == HUD_CALM_MSG {
    // how the world comes up: with its entrance (0), or settled (bit 1 reduced motion, bit 2 a kept world come back)
    v := hud_read(t, 0);
    h[0].calm = ifx v.ok then v.value & 3 else 0;
    return;
  }
  if kind == HUD_KEYS_MSG {
    // the keys held now, as bits; anything that is not a number lets them all go
    v := hud_read(t, 0);
    now := ifx v.ok then v.value & HUD_KEYS_ALL else 0;
    // (a press of Space is counted as it is told, so one made and let go between two frames is still a press)
    if (now & HUD_KEY_JUMP) != 0 && (h[0].keys & HUD_KEY_JUMP) == 0 && h[0].taps < 4 { h[0].taps += 1; }
    h[0].keys = now;
    return;
  }
  if kind == HUD_OVER_MSG {
    // the press about to come began on one of the page's own things (the chat, the account menu, a link): not the camera's
    v := hud_read(t, 0);
    h[0].over = v.ok && v.value != 0;
    return;
  }
  if kind == HUD_TOOL_MSG {
    // the hotbar's state, from the page: "TOOL EDIT ID GRAVITY FOLLOW"; and after its line, the world's
    // properties that differ (the engine's own text of the map: web/props.coax pr_wire). When that part is
    // there it is the whole truth: what it does not name is as the world starts
    cut := 0; while cut < t.count && t[cut] != '\n' { cut += 1; }
    told := cut < t.count;
    if told { took := tun_load(TW_ROWS[..], h[0].props[0].over[..], cast(string) t[cut + 1..<t.count]); }
    tl := hud_read(t, 0); ed := hud_read(t, tl.at); id := hud_read(t, ed.at); gr := hud_read(t, id.at); fo := hud_read(t, gr.at); mo := hud_read(t, fo.at); ac := hud_read(t, mo.at); fl := hud_read(t, ac.at);
    // (and how often "fly" has been pressed: one more than last told turns flight on or off)
    qu := hud_read(t, fl.at); h[0].quarter = ifx qu.ok then ((qu.value % 4) + 4) % 4 else 0;
    if fl.ok { if h[0].fly_n >= 0 && fl.value != h[0].fly_n && h[0].view == HUD_WORLD { h[0].fly_ask = true; } h[0].fly_n = fl.value; }
    // (and how often the world's own action has been pressed: one more than last told is a press. Crates: the room is reset; the platformer: the course starts over; racing: the car back on the track, or after the flag a race again; drift: the ship back at the last ring, or after the last the course again)
    if ac.ok { if h[0].act >= 0 && ac.value != h[0].act && h[0].type == HUD_CRATES && h[0].view == HUD_WORLD { h[0].crates[0].resets += 1; hud_crates_in(h); } if h[0].act >= 0 && ac.value != h[0].act && h[0].type == HUD_PLATFORMER && h[0].view == HUD_WORLD { hud_plat_in(h); } if h[0].act >= 0 && ac.value != h[0].act && h[0].type == HUD_RACING && h[0].view == HUD_WORLD { rc_act(h[0].race[..]); h[0].stale = true; } if h[0].act >= 0 && ac.value != h[0].act && h[0].type == HUD_DRIFT && h[0].view == HUD_WORLD { dr_act(h[0].drift[..]); h[0].stale = true; } h[0].act = ac.value; }
    h[0].mode = ifx mo.ok && mo.value == HUD_M_SNAP then HUD_M_SNAP else HUD_M_FREE;
    h[0].tool = ifx tl.ok && ((tl.value >= 0 && tl.value < HUD_T_SHAPES) || (tl.value >= HUD_T_MODEL && tl.value < HUD_T_MODEL + VL_KINDS)) then tl.value else -1;
    h[0].editing = ed.ok && ed.value != 0;
    h[0].sel = ifx h[0].editing && id.ok && id.value > 0 then id.value else 0;
    if !h[0].editing { h[0].carry = 0; }
    if h[0].tool < 0 && !h[0].editing { h[0].tooling = false; }
    // gravity, none to five times the normal: the engine's scene setting for the things (a change
    // wakes them), and the walk rules' own for the character (hud_tuning). At none nothing falls
    // (told without the properties, the line's own gravity is the registry's world.gravity)
    if !told && gr.ok && gr.value >= 0 && gr.value <= 50 { at := TunAt.{prop = TW_GRAVITY}; pr_ready(h[0].props[..]); st := tun_set(TW_ROWS[..], h[0].props[0].base[..], h[0].props[0].over[..], at, gr.value * 10); }
    hud_tune(h);
    // the camera menu's camera (the registry's camera.view, mirrored into the line): follow is third person locked behind; first person and top-down are the engine's own kinds
    if fo.ok && fo.value >= 0 && fo.value < 4 { h[0].cam = fo.value; h[0].follow = fo.value == 1; hud_cam_to(h, hud_cam_want(h)); }
    return;
  }
  if kind == HUD_RING_MSG { v := hud_read(t, 0); to := hud_read(t, v.at); if v.ok && v.value != 0 { hud_ring_on(h); } else if v.ok { hud_ring_leave(h, ifx to.ok then to.value else -1); } return; }
  if kind == HUD_RING_KEY_MSG { v := hud_read(t, 0); if v.ok { hud_ring_key(h, v.value); } return; }
  if kind == HUD_RING_PIC_MSG { hud_ring_pic(h, t); return; }
  if kind == HUD_KIND_MSG {
    // the game type picked: the next entrance is that type's, from the start
    // (while the ring is up the world is the ring's meadow: a type is entered once its portal has been gone through, and told again then)
    v := hud_read(t, 0);
    if h[0].ring { return; }
    if v.ok && v.value >= 0 && v.value < HUD_TYPES && (v.value != h[0].type || h[0].ring_state == HUD_RING_GONE) {
      h[0].ring_state = HUD_RING_UP;
      hud_type(h, v.value);
    }
    return;
  }
  if kind == HUD_PACK_MSG {
    // the pack as it comes in: bytes so far, and in all
    a := hud_read(t, 0); b := hud_read(t, a.at);
    if a.ok && b.ok { h[0].village[0].loaded = a.value; h[0].village[0].total = b.value; }
    return;
  }
  if kind == HUD_TYPING_MSG {
    // the caret is in a field: a held pointer is let go, and stays free until the world is pressed again
    v := hud_read(t, 0);
    if v.ok && v.value != 0 { h[0].mouse[0].free = true; }
    return;
  }
  if kind == HUD_FOLLOW_MSG {
    v := hud_read(t, 0);
    h[0].follow = v.ok && v.value != 0;
    return;
  }
  if kind == HUD_WHEEL_MSG {
    // the wheel: CSS pixels down, and whether it turned over one of the page's own things. Over the
    // world, once the camera is down, it zooms: Everglade's wheel (cam_wheel)
    dy := hud_read(t, 0); own := hud_read(t, dy.at);
    // (with the size tool and a thing selected, the wheel is the tool's: it sizes the thing)
    if dy.ok && !(own.ok && own.value != 0) && hud_looks(h) && !hud_tool_wheel(h, cast(f32) dy.value) { h[0].orbit = cam_kind_wheel(hud_camera_kind(h), h[0].orbit, cast(f32) dy.value); }
    return;
  }
  if kind == HUD_ROOM_MSG {
    // crates: which level of its game the room is, and of how many. Another room: what stood in this
    // one is gone (the next one's things have the same names), and it is entered when its things are told
    // (a third number, when the page gives one, counts the times the level was replaced whole: a kept copy read over
    // it, the account's opened. Another count is another room's worth of change: entered afresh)
    r := hud_read(t, 0); of := hud_read(t, r.at); whole := hud_read(t, of.at);
    if !r.ok || !of.ok || r.value < 0 || of.value < 1 || r.value >= of.value { return; }
    c := h[0].crates[..];
    c[0].rooms = of.value;
    if r.value != c[0].room || (whole.ok && whole.value != h[0].room_whole) {
      c[0].room = r.value; if whole.ok { h[0].room_whole = whole.value; }
      b := h[0].things[..];
      while bd_count(b) > 0 { gone := bd_remove(b, 0); }
      h[0].nk = 0; h[0].nmk = 0; h[0].room_due = true; h[0].stale = true;
      if h[0].type == HUD_CRATES { hud_crates_lay(h); hud_solids(h); }
    }
    return;
  }
  if kind == HUD_BLOCKS_MSG {
    // what stands in the world: a count, then "ID KIND MOVES SIZES X Y Z W H D" a line: the page's
    // name for it, 0 a block or 1 a ball, how often the page has moved and sized it, then, in
    // hundredths of a square, the middle of its footprint, its bottom's height, and its size across,
    // up and along (a ball's width, three times); and, on the same line, 1 more when it was set
    // down at rest: such a thing, when it is new, is made exactly at its place, asleep (the
    // engine's bd_still), and does not fall. A thing not seen before is made, a little above
    // its place, to fall; one the page has moved since is put above its new place, upright; one it
    // has sized is sized where it rests; one the list no longer has is gone. Otherwise a thing is
    // where the engine has it: the page's place for it is only what it was last told. A line that
    // cannot be read ends the list; one that reads but is no thing (no size, a kind that is neither)
    // is passed over, and a bottom under the floor is the floor (not in drift's open space): the rest of the list is still read,
    // so one bad thing never takes the things after it, or the ones placed next, with it.
    b := h[0].things[..];
    seen: [HUD_BLOCKS] bool;   // by its place in `known`
    c := hud_read(t, 0);
    n := ifx !c.ok || c.value < 0 then 0 else ifx c.value > HUD_BLOCKS then HUD_BLOCKS else c.value;
    at := c.at; k: f64 = 0.01;   // hundredths of a square to metres
    fresh := 0;
    // (the buildings among them: the village's, standing still, read apart)
    pn := 0; pid: [VL_PUT] int; px: [VL_PUT] int; pz: [VL_PUT] int; pm: [VL_PUT] int; pq: [VL_PUT] int; psc: [VL_PUT] int;
    // (and the marks among them: a goal, a shard or a boost is no body; one that has not moved keeps being taken)
    nmk := 0; mk := h[0].marks_in[..];
    npf := 0;
    for i: 0..<n {
      v: [10] int; good := true;
      for q: 0..<10 { r := hud_read(t, at); if !r.ok { good = false; break; } at = r.at; v[q] = r.value; }
      if !good { break; }
      // (one more number on its own line: set down at rest)
      // (one more number on its own line: 1 set down at rest, asleep; 2 made at its place, to fall only if that leaves it in the air.
      // No more: a thing the world opened with, which alone appears above its place and falls in)
      rest := false; starts := true; peek := at;
      while peek < t.count && t[peek] == ' ' { peek += 1; }
      turn := 0; go := 0; every := 0;
      if peek < t.count && t[peek] >= '0' && t[peek] <= '9' {
        r := hud_read(t, peek); at = r.at; rest = r.value == 1; starts = r.value == 0;
        // (and one more after it: the thing's turn, degrees; a course's mark is read by it, a track point's bank)
        peek = at; while peek < t.count && t[peek] == ' ' { peek += 1; }
        if peek < t.count && ((t[peek] >= '0' && t[peek] <= '9') || t[peek] == '-') {
          q := hud_read(t, peek); if q.ok { at = q.at; turn = q.value; }
          // (and two more after that: how far a moving platform or a lift goes, hundredths, and how long there and back takes, milliseconds)
          peek = at; while peek < t.count && t[peek] == ' ' { peek += 1; }
          if peek < t.count && t[peek] >= '0' && t[peek] <= '9' { g := hud_read(t, peek); e := hud_read(t, g.at); if g.ok && e.ok { at = e.at; go = g.value; every = e.value; } }
        }
      }
      if v[1] == 2 { if pn < VL_PUT { pid[pn] = v[0]; px[pn] = v[4]; pz[pn] = v[6]; pm[pn] = v[7]; pq[pn] = v[8]; psc[pn] = v[9]; pn += 1; } continue; }
      // (a block of the game type's own kind: BL_ROLE_WIRE and its kind)
      role := ifx v[1] > BL_ROLE_WIRE && v[1] < BL_ROLE_WIRE + BL_ROLES then v[1] - BL_ROLE_WIRE else 0;
      if role > 0 { v[1] = 0; }
      if !(v[7] > 0 && v[8] > 0 && v[9] > 0) || v[1] < 0 || v[1] > 1 || v[0] < 0 || v[0] >= BD_ID_ROOM { continue; }
      // (the platformer's course is the level's boxes and shards, as the page has them)
      if h[0].type == HUD_PLATFORMER && v[1] == 0 && npf < PF_PARTS { h[0].pf_in[0].t[npf] = PfThing.{role = role, x = v[4], y = ifx v[5] < 0 then 0 else v[5], z = v[6], w = v[7], h = v[8], d = v[9], go = go, every = every}; npf += 1; }
      if hud_marker(role) {
        if nmk < HUD_MARKS {
          mk[nmk] = HudMark.{id = v[0], role = role, moves = v[2] * 4096 + v[3], x = cast(f32) v[4] * 0.01, y = cast(f32) v[5] * 0.01, z = cast(f32) v[6] * 0.01, w = cast(f32) v[7] * 0.01, h = cast(f32) v[8] * 0.01, d = cast(f32) v[9] * 0.01, ix = v[4], iy = v[5], iz = v[6], turn = turn};
          for q: 0..<h[0].nmk { if h[0].marks[q].id == v[0] && h[0].marks[q].moves == mk[nmk].moves { mk[nmk].taken = h[0].marks[q].taken; } }
          nmk += 1;
        }
        continue;
      }
      if v[5] < 0 && h[0].type != HUD_DRIFT { v[5] = 0; }   // (drift is open space: no floor)
      x := cast(f64) v[4] * k; y := cast(f64) v[5] * k; z := cast(f64) v[6] * k;
      w := cast(f64) v[7] * k; ht := cast(f64) v[8] * k; d := cast(f64) v[9] * k;
      slot := bd_index(b, v[0]); know := hud_known(h, v[0]);
      // how far above its place it appears: each of a batch a little higher (six heights, then round again), to land in turn
      up := cast(f64) h[0].drop * (1.0 + HUD_DROP_NEXT * cast(f64) (fresh % HUD_DROP_TURNS));
      if hud_calm(h) && h[0].since < 1.0 { up = 0; }   // (a settled world's own things stand where they rest: nothing falls in)
      if slot < 0 || know < 0 {
        if slot >= 0 || h[0].nk >= HUD_BLOCKS { continue; }
        // what it is made of is the registry's (web/props.coax): the world's own numbers unless something was set for it, its kind or every thing
        m := hud_stuff(h, v[0], ifx v[1] == 1 then PR_BALL else PR_BLOCK, role);
        if !starts || m.density == 0.0 { up = 0; }   // (a fixed thing is made where it is to stand: it would not fall there)
        if v[1] == 1 {
          slot = bd_ball(b, v[0], d3(x, y + w * 0.5 + up, z), w * 0.5, m.density, m.friction, m.bounce, HUD_BALL_ROLL);
        } else { slot = bd_box(b, v[0], d3(x, y + ht * 0.5 + up, z), DQ.{}, d3(w * 0.5, ht * 0.5, d * 0.5), m.density, m.friction, m.bounce); }
        if slot < 0 { continue; }
        know = h[0].nk; h[0].nk += 1;
        h[0].known[know] = HudThing.{id = v[0], moves = v[2], sizes = v[3], role = role, hx = x, hy = y, hz = z};
        if rest { bd_still(b, slot); } else if starts { fresh += 1; }
      } else {
        // (a new kind first: what it is made of may change with it, a wall's or a pad's fixed)
        if role != h[0].known[know].role { h[0].known[know].role = role; m := hud_stuff(h, v[0], PR_BLOCK, role); bd_material(b, slot, m.density, m.friction, m.bounce); }
        if v[3] != h[0].known[know].sizes { hud_resize(h, slot, w, ht, d); h[0].known[know].sizes = v[3]; }
        if v[2] != h[0].known[know].moves {
          tall := ifx b[0].kind[slot] == Bd_Kind.ball then b[0].half[slot].x else b[0].half[slot].y;
          bd_place(b, slot, d3(x, y + tall, z), DQ.{});   // (put at its new place, not lifted first)
          h[0].known[know].moves = v[2]; h[0].known[know].hx = x; h[0].known[know].hy = y; h[0].known[know].hz = z;
        }
      }
      seen[know] = true;
    }
    // what the page no longer has is gone: its body from the engine, and what was known of it
    j := h[0].nk - 1;
    while j >= 0 {
      if !seen[j] {
        gone := bd_remove(b, bd_index(b, h[0].known[j].id));
        h[0].nk -= 1;
        h[0].known[j] = h[0].known[h[0].nk]; seen[j] = seen[h[0].nk];
      }
      j -= 1;
    }
    h[0].nmk = nmk; for q: 0..<nmk { h[0].marks[q] = mk[q]; }
    h[0].pf_in_n = npf;
    hud_track(h); hud_course_rings(h); hud_plat_course(h);
    // crates: the room is what its things make it; a room just named, or one not begun, is entered with them
    if h[0].type == HUD_CRATES {
      if h[0].room_due { h[0].room_due = false; hud_crates_in(h); }
      else { hud_crates_lay(h); if h[0].crates[0].clock == 0 { hud_crates_put(h); } }
    }
    // the level's buildings: solid (the statics, the grass's table) as they stand, made again when they differ
    if h[0].type == HUD_VILLAGE && vl_put_in(h[0].village[..], pn, pid[..], px[..], pz[..], pm[..], pq[..], psc[..]) { hud_statics(h); h[0].rec_gen += 1; }
    hud_solids(h);
    h[0].stale = true;
    return;
  }
  if kind != HUD_PANELS_MSG { return; }
  c := hud_read(t, 0);
  if !c.ok { return; }
  n := ifx c.value < 0 then 0 else ifx c.value > HUD_PANELS then HUD_PANELS else c.value;
  at := c.at;
  for i: 0..<n {
    k := hud_read(t, at); x := hud_read(t, k.at); y := hud_read(t, x.at); w := hud_read(t, y.at); ht := hud_read(t, w.at);
    if !(k.ok && x.ok && y.ok && w.ok && ht.ok) { n = i; break; }
    at = ht.at;
    // a panel keeps how far it has drawn itself while it is the same kind in the same place in the list
    same := i < h[0].n && h[0].panels[i].kind == k.value;
    keep := ifx same then h[0].panels[i].t else 0.0f32; lit := ifx same then h[0].panels[i].hot else 0.0f32;
    h[0].panels[i] = HudPanel.{kind = k.value, x = cast(f32) x.value, y = cast(f32) y.value, w = cast(f32) w.value, h = cast(f32) ht.value, t = keep, hot = lit};
  }
  h[0].n = n;
}
// ---------------------------------------------------------------- the home page's ring of portals
// (issue 30; web/ring.coax; docs/web-world.md, "The ring"). The ring is the meadow in third person
// with nothing built on it and the game types' portals round the character. The page says when it
// is up and when it is left (HUD_RING_MSG); a portal is taken by a press on it, by Return, or by
// walking into it, and the page is told (HUD_RING_PICK): the pick itself is the page's, as a press
// on the type's name is. When the page says a type was picked the view goes through its portal and
// the ring is gone; the type's world then comes up as any world does.

// How many portals: the shared list's types, in its order (shared/game-types.coax gt_picker). A
// type added there is a portal here.
hud_ring_count :: () -> int { order: [GT_TYPES] int; n := gt_picker(GT_ON_SITE, order[..]); return ifx n > RG_MAX then RG_MAX else n; }
// Which portal a game type's is (its place in the list): -1, none.
hud_ring_of :: (kind: int) -> int {
  order: [GT_TYPES] int; n := gt_picker(GT_ON_SITE, order[..]);
  for i: 0..<n { if i < RG_MAX && gt_web_kind(order[i]) == kind { return i; } }
  return -1;
}
// The ring with the character still in its middle: there it stands between the camera and the portal
// ahead, a ghost over the picture, so it is not drawn; once it walks (toward a portal, to take it) it is.
HUD_RING_STILL :: 0.5;   // metres from the middle the character is still "in the middle"
hud_ring_alone :: (h: [] Hud) -> bool { return h[0].ring && h[0].cx * h[0].cx + h[0].cz * h[0].cz < HUD_RING_STILL * HUD_RING_STILL; }
hud_ring_back :: (h: [] Hud) -> f32 { return rg_back(h[0].ring_n, ifx h[0].high >= 1 then h[0].wide / h[0].high else 1.6f32, HUD_FOV); }
// The character in the middle of the ring, facing the first portal, at rest.
hud_ring_feet :: (h: [] Hud) {
  h[0].cx = 0; h[0].cz = 0; h[0].cy = 0; h[0].ground = 0; h[0].face = 0;
  h[0].foot.walk.x = 0; h[0].foot.walk.z = 0; h[0].foot.walk.vx = 0; h[0].foot.walk.vz = 0; h[0].foot.walk.speed = 0;
  h[0].foot.walk.yaw = 0; h[0].foot.walk.face_off = 0;
}
hud_ring_on :: (h: [] Hud) {
  if h[0].ring { return; }
  h[0].ring = true; h[0].ring_n = hud_ring_count();
  rows := rg_rows(h[0].gates[..], h[0].ring_n);
  h[0].ring_at = 0; h[0].ring_idle = true; h[0].ring_dwell = 0; h[0].ring_turn = true; h[0].ring_hover = false; h[0].ring_down = false;
  h[0].ring_pick = -1; h[0].ring_asked = 0; h[0].ring_fly = -1; h[0].ring_state = HUD_RING_UP; h[0].ring_said_n = 0; h[0].ring_lit = 0; h[0].ring_gone = false;
  for i: 0..<RG_MAX { h[0].ring_box[i * 4] = 0; h[0].ring_box[i * 4 + 2] = -1; }
  // the meadow, in third person, nothing held and nobody flying
  if h[0].type != 0 { hud_type(h, 0); }
  h[0].kind = CAM_KIND_THIRD; h[0].tool = -1; h[0].editing = false; h[0].sel = 0; h[0].carry = 0; h[0].tooling = false; h[0].fly = fly.fly_stop(h[0].fly);
  hud_ring_feet(h);
  hud_again(h); h[0].since = 0; if hud_calm(h) { hud_settle(h); }
  h[0].stale = true;
}
// The ring is gone. What comes next comes up as any world does from a page of the site: the camera
// down from above and the sun up from black (or, settled, at once).
hud_ring_off :: (h: [] Hud) {
  if !h[0].ring { return; }
  h[0].ring = false; h[0].ring_fly = -1; h[0].ring_pick = -1; h[0].ring_down = false; h[0].ring_lit = 0;
  h[0].ring_state = HUD_RING_GONE; h[0].ring_gone = true; h[0].stale = true;
  h[0].kind = hud_cam_want(h);
  hud_ring_feet(h);
  if h[0].view == HUD_WORLD { h[0].view = HUD_LOGIN; }
  h[0].zoom = 0; h[0].orbiting = false; h[0].drag = false; h[0].spread = 0; h[0].dawn = 0;
}
// The page left the ring: for a game type picked (`kind`), through its portal first; for anything
// else, or for a person who prefers reduced motion, or a kept world come back, at once (a cut).
hud_ring_leave :: (h: [] Hud, kind: int) {
  if !h[0].ring { return; }
  to := hud_ring_of(kind);
  if to < 0 || hud_calm(h) || h[0].view != HUD_WORLD || h[0].zoom < 0.5 || h[0].wide < 1 { hud_ring_off(h); return; }
  if h[0].ring_fly >= 0 { return; }
  h[0].ring_from = hud_camera(h, h[0].high, h[0].dpr);
  h[0].ring_fly = 0; h[0].ring_to = to; h[0].ring_state = HUD_RING_FLYING; h[0].ring_idle = false; h[0].ring_turn = false; h[0].ring_down = false; h[0].stale = true;
}
// The camera on its way through a portal: from where it was to a metre before the picture's
// middle, looking straight at it, eased.
hud_ring_eye :: (h: [] Hud, was: StyCamera) -> StyCamera {
  t := clamp(h[0].ring_fly / HUD_RING_FLY, 0, 1); e := t * t * (3 - 2 * t);
  a := rg_angle(h[0].ring_to, h[0].ring_n); r := rg_radius(h[0].ring_n) - 1.0;
  c := h[0].ring_from; out := was;
  tx := sin(a) * r; ty: f32 = RG_SILL + RG_TALL * 0.5; tz := -cos(a) * r;
  out.x = c.x + (tx - c.x) * e; out.y = c.y + (ty - c.y) * e; out.z = c.z + (tz - c.z) * e;
  out.yaw = c.yaw + wrap_angle(a - c.yaw) * e; out.pitch = c.pitch * (1 - e); out.fov = c.fov;
  return out;
}
hud_ring_go :: (h: [] Hud, by: int) {
  h[0].ring_idle = false; h[0].ring_at = rg_step(h[0].ring_at, by, h[0].ring_n); h[0].ring_turn = true; h[0].ring_hover = false; h[0].stale = true;
}
hud_ring_key :: (h: [] Hud, key: int) {
  if !h[0].ring || h[0].ring_fly >= 0 { return; }
  h[0].ring_idle = false;
  if key == 1 { hud_ring_go(h, -1); }
  else if key == 2 { hud_ring_go(h, 1); }
  else if key == 3 { h[0].ring_pick = h[0].ring_at; }
}
// The portal whose picture is under a point of the window (device pixels), as the last frame drew
// them: the nearest of them (the tallest on the screen), or -1.
hud_ring_under :: (h: [] Hud, x: f32, y: f32) -> int {
  best := -1; tall: f32 = 0;
  for i: 0..<h[0].ring_n {
    b := h[0].ring_box[i * 4..<i * 4 + 4];
    if b[2] <= b[0] || x < b[0] || x > b[2] || y < b[1] || y > b[3] { continue; }
    if best < 0 || b[3] - b[1] > tall { best = i; tall = b[3] - b[1]; }
  }
  return best;
}
// A pointer on the ring. A press let go where it began is the portal's under it. A mouse held and
// dragged looks round (the orbit's drag); a finger dragged sideways is the next portal that way.
hud_ring_pointer :: (h: [] Hud, x: f32, y: f32, phase: int, kind: int, id: int) {
  if h[0].ring_fly >= 0 { return; }
  if phase == 0 {
    if h[0].over { return; }
    h[0].ring_idle = false;
    h[0].ring_down = true; h[0].ring_id = id; h[0].ring_touch = kind != 0; h[0].ring_x0 = x; h[0].ring_y0 = y; h[0].ring_far = 0; h[0].drag_x = x; h[0].drag_y = y;
    return;
  }
  if phase == 1 && kind == 0 && !h[0].ring_down { h[0].ring_hover = true; return; }
  if !h[0].ring_down || id != h[0].ring_id { return; }
  far := abs(x - h[0].ring_x0) + abs(y - h[0].ring_y0);
  if far > h[0].ring_far { h[0].ring_far = far; }
  small := HUD_T_DRAG * h[0].dpr * 2;
  if phase == 1 {
    if !h[0].ring_touch && h[0].ring_far > small && hud_looks(h) {
      t := cam_drag(x - h[0].drag_x, y - h[0].drag_y, h[0].dpr); h[0].look_yaw += t[0]; h[0].look_pitch += t[1];
      h[0].ring_turn = false; h[0].ring_hover = false;
    }
    h[0].drag_x = x; h[0].drag_y = y;
    return;
  }
  h[0].ring_down = false;
  if phase != 2 { return; }
  if h[0].ring_far <= small { g := hud_ring_under(h, x, y); if g >= 0 { h[0].ring_pick = g; } return; }
  dx := x - h[0].ring_x0;
  if h[0].ring_touch && abs(dx) > HUD_RING_SWIPE * h[0].dpr && abs(dx) > abs(y - h[0].ring_y0) { hud_ring_go(h, ifx dx < 0 then 1 else -1); }
}
// The ring's frame, after the character's and the orbit's: the view drifts until the person does
// something, turns to the portal an arrow or a swipe chose, and sits far enough back for a whole
// portal; the portal lit is the one under the mouse, else the one the view looks most nearly at;
// walking into one takes it; and the way through one runs its time.
hud_ring :: (h: [] Hud, step: f32) {
  if !h[0].ring || h[0].view != HUD_WORLD { return; }
  n := h[0].ring_n;
  if h[0].ring_fly >= 0 {
    h[0].ring_fly += step;
    t := h[0].ring_fly / HUD_RING_FLY;
    h[0].ring_lit = 1 - clamp((t - 0.55) / 0.45, 0, 1);
    if t >= 1 { hud_ring_off(h); }
    return;
  }
  h[0].ring_lit = ifx hud_calm(h) then 1.0f32 else clamp(h[0].dawn / HUD_RING_DAWN, 0, 1);
  if h[0].keys != 0 { h[0].ring_idle = false; h[0].ring_turn = false; }
  if h[0].ring_asked > 0 { h[0].ring_asked -= step; }
  if !h[0].orbiting { return; }
  o := h[0].orbit;
  o.want = hud_ring_back(h);
  // left alone, the view drifts round to the right, a portal at a time, resting on each so its name can be read
  // (in any window: a phone's upright one shows one portal); a person who prefers less motion keeps the first
  if h[0].ring_idle && !hud_calm(h) && !h[0].ring_turn {
    h[0].ring_dwell += step;
    if h[0].ring_dwell >= HUD_RING_DWELL { h[0].ring_dwell = 0; h[0].ring_at = rg_step(h[0].ring_at, 1, n); h[0].ring_turn = true; h[0].stale = true; }
  }
  if h[0].ring_turn {
    off := wrap_angle(HUD_PI - rg_toward(h[0].ring_at, n, h[0].cx, h[0].cz) - o.yaw);
    rate: f32 = ifx h[0].ring_idle then HUD_RING_DRIFT else HUD_RING_TURN;
    d := off * (ifx hud_calm(h) || step * rate > 1 then 1.0f32 else step * rate);
    if h[0].ring_idle && abs(d) < HUD_RING_CREEP * step { d = ifx off < 0 then -HUD_RING_CREEP * step else HUD_RING_CREEP * step; }
    if abs(off) < 0.003 || abs(d) >= abs(off) { d = off; h[0].ring_turn = false; }
    o.yaw = wrap_angle(o.yaw + d);
  }
  h[0].orbit = o;
  at := h[0].ring_at;
  if !h[0].ring_turn {
    under := ifx h[0].ring_hover then hud_ring_under(h, h[0].tx, h[0].ty) else -1;
    eye := metaverse_orbit_shot(o).eye;
    at = ifx under >= 0 then under else rg_ahead(n, eye.x, -eye.z, wrap_angle(HUD_PI - o.yaw));
  }
  if at >= 0 && at != h[0].ring_at { h[0].ring_at = at; h[0].stale = true; }
  // walked into one (the engine's portals: the nearest in reach)
  if h[0].ring_pick < 0 && h[0].ring_asked <= 0 { g := rg_stands(h[0].gates[..], n, h[0].cx, h[0].cz); if g >= 0 { h[0].ring_pick = g; } }
}
hud_ring_text :: (out: [] u8, n: int, v: int, end: u8) -> int { k := rg_int(out, n, v); if k < out.count { out[k] = end; k += 1; } return k; }
// What the page is told of the ring: a portal taken; else, when it has changed, where each portal's
// name goes on the screen (under its sill's middle, CSS pixels) and how wide its picture is drawn
// (-1: it is not in view), after the ring's state and the portal lit. And once, that the ring is gone.
hud_ring_say :: (h: [] Hud, u: [] f32) {
  if h[0].action != 0 { return; }
  if !h[0].ring {
    if h[0].ring_gone { h[0].ring_gone = false; h[0].out_n = rg_put(h[0].outbox[..], 0, "2 0\n"); h[0].action = HUD_RING_SAYS; }
    return;
  }
  if h[0].view != HUD_WORLD || u.count < HUD_UNIFORMS || h[0].wide < 1 || h[0].high < 1 { return; }
  if h[0].ring_pick >= 0 && h[0].ring_fly < 0 {
    h[0].out_n = rg_int(h[0].outbox[..], 0, h[0].ring_pick); h[0].action = HUD_RING_PICK;
    h[0].ring_pick = -1; h[0].ring_asked = 1;
    return;
  }
  n := h[0].ring_n; d := h[0].dpr;
  text: [RG_MAX * 24 + 16] u8;
  k := hud_ring_text(text[..], 0, h[0].ring_state, ' ');
  k = hud_ring_text(text[..], k, ifx h[0].ring_fly >= 0 then h[0].ring_to else h[0].ring_at, '\n');
  eye := metaverse_orbit_shot(h[0].orbit).eye;
  for i: 0..<n {
    box := h[0].ring_box[i * 4..<i * 4 + 4]; box[0] = 0; box[2] = -1;
    a := rg_angle(i, n); c := rg_corner(i, n, 0.5, 0.5, 0);
    // in view: the eye is on the picture's side of it, every corner is ahead, and some of it is in the window
    seen := h[0].ring_fly < 0 && h[0].orbiting && (c[0] - eye.x) * sin(a) + (c[2] - eye.z) * -cos(a) > 0.5;
    l: f32 = 0; t: f32 = 0; r: f32 = 0; b: f32 = 0;
    if seen {
      for q: 0..<4 {
        g := rg_corner(i, n, ifx q == 0 || q == 3 then 0.0f32 else 1.0f32, ifx q < 2 then 0.0f32 else 1.0f32, 0);
        on := sty_project(u, g[0], g[1], g[2]);
        if !on.ahead { seen = false; break; }
        if q == 0 || on.x < l { l = on.x; } if q == 0 || on.x > r { r = on.x; }
        if q == 0 || on.y < t { t = on.y; } if q == 0 || on.y > b { b = on.y; }
      }
    }
    if seen && (r < 0 || l > h[0].wide || b < 0 || t > h[0].high) { seen = false; }
    if !seen { k = rg_put(text[..], k, "0 0 -1\n"); continue; }
    box[0] = l; box[1] = t; box[2] = r; box[3] = b;
    // (under its sill, where the meadow is: the heading has the window's top)
    foot := rg_corner(i, n, 0.5, 1, 0);
    on := sty_project(u, foot[0], foot[1] - RG_POST - 0.1, foot[2]);
    // (a name whose middle is too near the window's side to be whole there is not shown: its picture still takes a press)
    if !on.ahead || on.x < HUD_RING_EDGE * d || on.x > h[0].wide - HUD_RING_EDGE * d || on.y > h[0].high - 24 * d { k = rg_put(text[..], k, "0 0 -1\n"); continue; }
    k = hud_ring_text(text[..], k, hud_whole(on.x / d), ' ');
    k = hud_ring_text(text[..], k, hud_whole(on.y / d), ' ');
    k = hud_ring_text(text[..], k, hud_whole((r - l) / d), '\n');
  }
  same := k == h[0].ring_said_n;
  if same { for i: 0..<k { if text[i] != h[0].ring_said[i] { same = false; break; } } }
  if same { return; }
  for i: 0..<k { h[0].ring_said[i] = text[i]; h[0].outbox[i] = text[i]; }
  h[0].ring_said_n = k; h[0].out_n = k; h[0].action = HUD_RING_SAYS;
}
hud_ring_hex :: (c: u8) -> u32 { return ifx c >= '0' && c <= '9' then cast(u32) (c - '0') else ifx c >= 'a' && c <= 'f' then cast(u32) (c - 'a') + 10 else 0; }
// Some rows of a portal's picture, from the glue: "PORTAL ROW ROWS" and then six hex digits a texel
// (red, green, blue), RG_PIC_W of them a row. A message that is not whole is left out; the store's
// version moves when a picture's last row is in.
hud_ring_pic :: (h: [] Hud, t: string) {
  p := hud_read(t, 0); row := hud_read(t, p.at); rows := hud_read(t, row.at);
  if !p.ok || !row.ok || !rows.ok || p.value < 0 || p.value >= RG_MAX || row.value < 0 || rows.value < 1 || row.value + rows.value > RG_PIC_H { return; }
  at := rows.at;
  while at < t.count && (t[at] == ' ' || t[at] == '\n') { at += 1; }
  count := rows.value * RG_PIC_W;
  if t.count - at < count * 6 { return; }
  to := (p.value * RG_PIC_H + row.value) * RG_PIC_W;
  for k: 0..<count {
    o := at + k * 6;
    r := hud_ring_hex(t[o]) * 16 + hud_ring_hex(t[o + 1]); g := hud_ring_hex(t[o + 2]) * 16 + hud_ring_hex(t[o + 3]); b := hud_ring_hex(t[o + 4]) * 16 + hud_ring_hex(t[o + 5]);
    h[0].pics[to + k] = r | (g << 8) | (b << 16) | 0xff000000;
  }
  if row.value + rows.value >= RG_PIC_H { h[0].pics_gen += 1; }
}
// The game type is `v`: its camera, its entrance from the start, and nothing of another type's world.
hud_type :: (h: [] Hud, v: int) {
  h[0].type = v; h[0].kind = hud_cam_want(h); hud_again(h);
  if v == HUD_VILLAGE { h[0].village[0].wanted = true; }   // from now the host fetches the pack
  if v != HUD_CRATES { h[0].crates[0] = Crates.{}; h[0].room_due = false; }
  if v != HUD_PLATFORMER { h[0].plat[0] = Platformer.{stand = -1}; }
  if v != HUD_RACING { h[0].race[0] = Racing.{}; }
  if v != HUD_DRIFT { h[0].drift[0] = Drift.{}; }
  h[0].village[0].solid = 0; hud_statics(h);
}

hud_max_vertices :: () -> int #export_c #effects(all) { return HUD_VERTICES; }
hud_vertex_floats :: () -> int #export_c #effects(all) { return HUD_FLOATS; }
hud_uniform_floats :: () -> int #export_c #effects(all) { return HUD_UNIFORMS; }
hud_inbox_cap :: () -> int #export_c #effects(all) { return HUD_INBOX; }

HudTest :: struct { h: [1] Hud; out: [HUD_VERTICES * HUD_FLOATS] f32; u: [HUD_UNIFORMS] f32; told: [HUD_OUTBOX] u8; }
// A whole number as text into `out` at n: where it ended.
hud_test_put :: (out: [] u8, n: int, v: int) -> int {
  k := n; a := v;
  if a < 0 { out[k] = '-'; k += 1; a = -a; }
  digits: [12] u8; m := 0;
  if a == 0 { digits[0] = '0'; m = 1; }
  while a > 0 { digits[m] = cast(u8) ('0' + a % 10); m += 1; a /= 10; }
  while m > 0 { m -= 1; out[k] = digits[m]; k += 1; }
  return k;
}
hud_test_say :: (h: [] Hud, kind: int, text: string) { for i: 0..<text.count { h[0].inbox[i] = text[i]; } hud_message(h, kind, text.count); }
hud_test_run :: (t: [] HudTest, frames: int, dt: f32) { for k: 0..<frames { m := hud_frame(t[0].h[..], t[0].out[..], t[0].u[..], 1600, 1200, 2, dt); } }

#test "the page's panels are read, each draws itself in once it is in the window, and a bad line stops the list" #steps 400000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  hud_test_say(h, HUD_PANELS_MSG, "3\n3 40 60 400 200\n6 40 300 600 300\n2 40 5000 300 200\n");
  // a shade panel draws no frame: the floor is dimmed behind its box
  hud_test_say(h, HUD_PANELS_MSG, "1\n9 100 50 400 300\n");
  plain := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1800, 2, 0.016);
  #assert t[0].u[HUD_U_SHADE] == 200 && t[0].u[HUD_U_SHADE + 1] == 100 && t[0].u[HUD_U_SHADE + 2] == 800 && t[0].u[HUD_U_SHADE + 3] == 600;
  hud_test_say(h, HUD_PANELS_MSG, "0\n");
  none := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1800, 2, 0.016);
  #assert plain == none && t[0].u[HUD_U_SHADE + 2] == 0;
  hud_test_say(h, HUD_PANELS_MSG, "3\n3 40 60 400 200\n6 40 300 600 300\n2 40 5000 300 200\n");
  #assert h[0].n == 3 && h[0].panels[1].kind == 6 && h[0].panels[1].w == 600 && h[0].panels[2].y == 5000;
  bare := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1800, 2, 0.016);
  #assert bare > 0 && bare % 3 == 0 && t[0].u[STY_U_SIZE] == 1600 && t[0].u[STY_U_SIZE + 1] == 1800 && t[0].u[HUD_U_PAGE] == 2;
  #assert h[0].panels[0].t > 0 && h[0].panels[1].t > 0 && h[0].panels[2].t == 0;   // the third is far below the window
  for k: 0..<80 { m := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1800, 2, 0.016); }
  #assert h[0].panels[0].t == 1 && h[0].panels[2].t == 0;
  full := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1800, 2, 0.016);
  #assert full > bare && full < HUD_VERTICES;
  // every vertex is white, with a half width: a stroke
  for v: 0..<full { at := v * HUD_FLOATS; #assert t[0].out[at + 2] == 1 && t[0].out[at + 5] > 0 && t[0].out[at + 5] <= 1 && t[0].out[at + 7] > 0; }
  // the same list again keeps what is drawn; a scroll moves a panel without starting it over
  hud_test_say(h, HUD_PANELS_MSG, "3\n3 40 -20 400 200\n6 40 220 600 300\n2 40 900 300 200\n");
  #assert h[0].panels[0].t == 1 && h[0].panels[0].y == -20 && h[0].panels[2].t == 0;
  hud_test_say(h, HUD_PANELS_MSG, "2\n3 1 2 3 4\nx\n");
  #assert h[0].n == 1;
  hud_test_say(h, HUD_PANELS_MSG, "99999\n");
  #assert h[0].n == 0;
}
#test "the pointer lights the ground and the panel it is on, and going away puts both out" #steps 100000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  none := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016);
  hud_test_say(h, HUD_POINTER_MSG, "400 300");
  for k: 0..<60 { m := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016); }
  #assert h[0].lit > 0.9 && t[0].u[HUD_U_POINTER] == 400 && t[0].u[HUD_U_POINTER + 1] == 300 && t[0].u[HUD_U_POINTER + 2] > 0.9 && t[0].u[HUD_U_POINTER + 3] == 0;
  // a panel under the pointer lights, and its sights are drawn; the page's place moves the mark
  hud_test_say(h, HUD_PANELS_MSG, "1\n3 300 200 300 200\n");
  for k: 0..<60 { m := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016); }
  #assert h[0].panels[0].hot > 0.9;
  hud_test_say(h, HUD_POINTER_MSG, "10 10");
  for k: 0..<60 { m := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016); }
  #assert h[0].panels[0].hot < 0.05;
  hud_test_say(h, HUD_SCROLL_MSG, "500 640"); #assert h[0].scroll == 0.5 && h[0].down == 640;
  hud_test_say(h, HUD_SCROLL_MSG, "9000"); #assert h[0].scroll == 1 && h[0].down == 640;
  // the login leans the camera back, smoothly, and home stands it up again; the pointer's glow is the home page's
  #assert hud_camera(h, 600, 1).pitch == -1.5707963;
  hud_test_say(h, HUD_VIEW_MSG, "1");
  one := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016);
  #assert h[0].tilt > 0 && h[0].tilt < 0.1 && hud_camera(h, 600, 1).pitch > -1.5707963 && hud_camera(h, 600, 1).pitch < -1.5;
  for k: 0..<400 { m := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016); }
  #assert h[0].tilt == 1 && near(hud_camera(h, 600, 1).pitch, -0.7853982, 0.0001) && t[0].u[HUD_U_POINTER + 2] == 0;
  hud_test_say(h, HUD_VIEW_MSG, "0");
  for k: 0..<400 { m := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016); }
  #assert h[0].tilt == 0;
  hud_test_say(h, HUD_POINTER_MSG, "gone");
  for k: 0..<120 { m := hud_frame(h, t[0].out[..], t[0].u[..], 800, 600, 1, 0.016); }
  #assert h[0].lit < 0.05;
}

#test "the home page looks straight down on the engine's bare floor: a metre is 48 CSS pixels, it slides with the page, and no grass grows" #steps 400000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  n := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.016);
  u := t[0].u[..];
  mid := sty_project(u, 0, 0, 0); right := sty_project(u, 1, 0, 0); ahead := sty_project(u, 0, 0, -1);
  #assert mid.ahead && near(mid.x, 800, 0.01) && near(mid.y, 600, 0.01) && near(right.x - mid.x, 96, 0.01) && near(right.y, 600, 0.01) && near(mid.y - ahead.y, 96, 0.01) && near(ahead.x, 800, 0.01);
  // the page scrolled 640 pixels down: the floor has gone up the window as far
  hud_test_say(h, HUD_SCROLL_MSG, "500 640");
  n = hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.016);
  #assert near(sty_project(u, 0, 0, 0).y, 600 - 1280, 0.05) && near(sty_project(u, 0, 0, 0).x, 800, 0.01);
  // the floor is the engine's ground part, wholly bare (a reveal whose front has not left), black with a line a metre and another every four
  #assert u[STY_U_REVEAL + 2] == 0 && u[STY_U_REVEAL + 3] > 0 && hud_grass(h) == 0 && h[0].blades == 0;
  #assert u[STY_U_BARE] == 0 && u[STY_U_BARE + 3] == 1 && near(u[STY_U_BARE_LINE], 0.07, 0.0001) && u[STY_U_BARE_LINE + 3] == 4 && u[STY_U_GROUND + 3] == 0;
  // and it fades to black with distance only past the point the camera looks at (30 m up: 1200 device pixels at 2 are 600 CSS, times 1.2, over 48)
  #assert u[STY_U_HAZE] == 0 && u[STY_U_HAZE + 1] == 0 && u[STY_U_HAZE + 2] == 0 && near(u[STY_U_HAZE_INFO], 15, 0.001) && near(u[STY_U_HAZE + 3], 1.0 / 36, 0.0001);
  // one draw: the ground's two triangles, of the ground material, standing under the camera; nothing blended
  #assert hud_draw_count(h) == 1 && h[0].mesh_n == 6 && h[0].host_draws[0] == 0 && h[0].host_draws[1] == 6 && h[0].host_draws[2] == 0x80000000 && h[0].host_draws[3] == 1 && hud_draw_blend(h, 0) == 0;
  for v: 0..<6 { o := v * ARCH_VERTEX_FLOATS; #assert h[0].mesh[o + 6] == ARCH_M_GROUND && h[0].mesh[o + 1] == 0 && h[0].mesh[o + 4] == 1 && h[0].mesh[o + 7] == 1 && h[0].mesh[o + 8] == 0 && abs(h[0].mesh[o]) == HUD_GROUND_HALF; }
  #assert h[0].records[4] == 1 && h[0].records[8] == 1 && h[0].records[0] == 0 && h[0].records[2] == 0;
  // a still page sends its stores once: their generation stands
  g := hud_store_version(h, 0);
  hud_test_run(t[..], 20, 0.016);
  #assert hud_store_version(h, 0) == g && hud_store_version(h, 1) == g && hud_store_version(h, 2) == 0 && hud_store_version(h, 3) == 0;
  #assert hud_store_bytes(h, 0) == 6 * 12 * 4 && hud_store_bytes(h, 1) == HUD_RECORDS * 64 && hud_store_bytes(h, 2) == VL_TABLE_FLOATS * 4 && hud_store_cap(0) == HUD_MESH_VERTICES * 48 && hud_store_cap(5) == RG_MAX * RG_PIC_W * RG_PIC_H * 4 && hud_store_bytes(h, 5) == RG_PIC_W * RG_PIC_H * 4 && hud_store_cap(6) == 0;
  #assert hud_uniform_floats() == STY_UNIFORM_FLOATS + 12 && hud_uniform_floats() % 4 == 0;
}

// The ring's frames until an action is asked: it, and its words (the action is then done).
hud_test_ring_told :: (t: [] HudTest, want: int, frames: int) -> string {
  h := t[0].h[..];
  for k: 0..<frames {
    hud_test_run(t, 1, 0.016);
    if h[0].action == want { n := h[0].out_n; for i: 0..<n { t[0].told[i] = h[0].outbox[i]; } hud_action_done(h); return cast(string) t[0].told[0..<n]; }
    if h[0].action != 0 { hud_action_done(h); }
  }
  return "";
}
#test "the ring: the shared list's types as portals round the meadow, the view drifting until the person does something; the arrows turn to the next portal and Return takes the one lit" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  // one list: as many portals as the shared list has types for the site, and no more than the engine's portals a world, nor the page's names
  order: [GT_TYPES] int;
  #assert hud_ring_count() == gt_picker(GT_ON_SITE, order[..]) && RG_MAX == PRT_MAX && RG_MAX == 16 && hud_ring_of(gt_web_kind(GT_RACING)) == 7;
  hud_test_say(h, HUD_RING_MSG, "1");
  hud_test_say(h, HUD_VIEW_MSG, "2");
  #assert h[0].ring && h[0].ring_n == 9 && h[0].type == 0 && h[0].kind == CAM_KIND_THIRD && h[0].ring_idle && h[0].ring_at == 0;
  // the character stands in the middle, between the camera and the portal ahead: not drawn there, drawn once it walks
  #assert hud_ring_alone(h);
  h[0].cz = 2; #assert !hud_ring_alone(h); h[0].cz = 0;
  // the entrance comes down to the meadow, and the page is told where each portal's name goes: some in view, some not
  said := hud_test_ring_told(t[..], HUD_RING_SAYS, 900);
  #assert said.count > 0 && h[0].orbiting && cast(string) said[0..<2] == "0 ";
  lines := 0;
  for i: 0..<said.count { if said[i] == '\n' { lines += 1; } }
  #assert lines == 10;
  // the pictures light with the sunrise
  hud_test_run(t[..], 120, 0.016);
  #assert h[0].ring_lit > 0 && t[0].u[HUD_U_PAGE + 3] == h[0].ring_lit;
  // left alone, the view rests on the first portal, then drifts round to the next, and rests there
  hud_test_run(t[..], 60, 0.016);
  #assert !h[0].ring_turn && h[0].ring_at == 0;
  y0 := h[0].orbit.yaw; hud_test_run(t[..], cast(int) (HUD_RING_DWELL / 0.016) + 240, 0.016);
  #assert abs(wrap_angle(h[0].orbit.yaw - y0)) > 0.5 && h[0].ring_at == 1 && !h[0].ring_turn;
  // the right arrow: the next portal to the right is lit and the view turns to it; and back with the left
  was := h[0].ring_at;
  hud_test_say(h, HUD_RING_KEY_MSG, "2");
  #assert h[0].ring_at == rg_step(was, 1, 9) && !h[0].ring_idle && h[0].ring_turn;
  hud_test_run(t[..], 120, 0.016);
  #assert !h[0].ring_turn && h[0].ring_at == rg_step(was, 1, 9);
  y1 := h[0].orbit.yaw; hud_test_run(t[..], 60, 0.016);
  #assert h[0].orbit.yaw == y1;   // (no drift once the person has done something)
  hud_test_say(h, HUD_RING_KEY_MSG, "1"); hud_test_say(h, HUD_RING_KEY_MSG, "1");
  hud_test_run(t[..], 120, 0.016);
  #assert h[0].ring_at == rg_step(was, -1, 9);
  // Return: the page is told the portal lit was taken (it presses that type's name: the pick is the page's)
  hud_test_say(h, HUD_RING_KEY_MSG, "3");
  took := hud_test_ring_told(t[..], HUD_RING_PICK, 4);
  #assert took.count == 1 && cast(int) (took[0] - '0') == rg_step(was, -1, 9);
  // the page picked it: the view goes through its portal, the type held until it is through; then the ring is gone, said once, and the type comes
  to: [8] u8; tn := hud_test_put(to[..], 0, gt_web_kind(order[rg_step(was, -1, 9)]));
  hud_test_say(h, HUD_KIND_MSG, cast(string) to[0..<tn]);
  #assert h[0].type == 0;
  m: [16] u8; m[0] = '0'; m[1] = ' '; mn := hud_test_put(m[..], 2, gt_web_kind(order[rg_step(was, -1, 9)]));
  hud_test_say(h, HUD_RING_MSG, cast(string) m[0..<mn]);
  #assert h[0].ring && h[0].ring_fly == 0 && h[0].ring_state == HUD_RING_FLYING;
  hud_test_run(t[..], 20, 0.016);
  #assert h[0].ring && h[0].ring_fly > 0;
  // (on the way through, the names are out of view: the page is told so, then that the ring is gone)
  gone := ""; for k: 0..<6 { gone = hud_test_ring_told(t[..], HUD_RING_SAYS, 60); if gone.count > 0 && gone[0] == '2' { break; } #assert gone.count > 0 && gone[0] == '1'; }
  #assert gone == "2 0\n" && !h[0].ring && h[0].ring_state == HUD_RING_GONE && !hud_ring_alone(h);
  hud_test_say(h, HUD_KIND_MSG, cast(string) to[0..<tn]);
  #assert h[0].type == gt_web_kind(order[rg_step(was, -1, 9)]);
}
#test "the ring: walking the character into a portal takes it; a press on a portal's picture takes it; another page, or a person who prefers less motion, leaves it at once" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  hud_test_say(h, HUD_RING_MSG, "1"); hud_test_say(h, HUD_VIEW_MSG, "2");
  said := hud_test_ring_told(t[..], HUD_RING_SAYS, 900);
  #assert said.count > 0;
  // walked straight ahead into the first portal (the character faces it)
  hud_test_say(h, HUD_KEYS_MSG, "1");
  took := hud_test_ring_told(t[..], HUD_RING_PICK, 600);
  hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert took == "0" && h[0].cz > rg_radius(9) - 4.0;
  // a press on a picture drawn on the screen takes that portal (the page then presses its name)
  u: [1] HudTest; g := u[0].h[..];
  g[0].bare = true;
  hud_test_say(g, HUD_RING_MSG, "1"); hud_test_say(g, HUD_VIEW_MSG, "2");
  for k: 0..<900 { hud_test_run(u[..], 1, 0.016); if g[0].action != 0 { hud_action_done(g); } if g[0].orbiting && g[0].ring_box[2] > g[0].ring_box[0] { break; } }
  hud_test_say(g, HUD_RING_KEY_MSG, "4");
  b := g[0].ring_box[0..<4]; px := (b[0] + b[2]) * 0.5; py := (b[1] + b[3]) * 0.5;
  #assert b[2] > b[0] && hud_ring_under(g, px, py) == 0;
  hud_pointer(g, px, py, 0, 0, 1, 0); hud_pointer(g, px, py, 2, 0, 1, 0);
  #assert hud_test_ring_told(u[..], HUD_RING_PICK, 4) == "0";
  // another page: the ring goes at once, said once
  hud_test_say(g, HUD_VIEW_MSG, "1");
  #assert !g[0].ring && hud_test_ring_told(u[..], HUD_RING_SAYS, 4) == "2 0\n";
  // less motion: no drift, and a type picked is a cut, not a way through its portal
  w: [1] HudTest; c := w[0].h[..];
  c[0].bare = true;
  hud_test_say(c, HUD_CALM_MSG, "1"); hud_test_say(c, HUD_RING_MSG, "1"); hud_test_say(c, HUD_VIEW_MSG, "2");
  hud_test_run(w[..], 60, 0.016);
  y0 := c[0].orbit.yaw; hud_test_run(w[..], 120, 0.016);
  #assert c[0].orbiting && c[0].orbit.yaw == y0 && c[0].ring_lit == 1;
  hud_test_say(c, HUD_RING_MSG, "0 7");
  #assert !c[0].ring && c[0].ring_fly < 0 && c[0].ring_state == HUD_RING_GONE;
}
#test "the ring's pictures: rows of a type's picture from the glue fill its part of the store, and the store's version moves when a picture is whole" #steps 400000000 {
  t: [1] HudTest; h := t[0].h[..];
  g := hud_store_version(h, 5);
  text: [64 + RG_PIC_W * 6 * 2] u8; n := 0;
  for c: "3 142 2\n" { text[n] = c; n += 1; }
  for k: 0..<RG_PIC_W * 2 { for c: "ff8000" { text[n] = c; n += 1; } }
  for i: 0..<n { h[0].inbox[i] = text[i]; } hud_message(h, HUD_RING_PIC_MSG, n);
  #assert hud_store_version(h, 5) == g + 1 && h[0].pics[(3 * RG_PIC_H + 143) * RG_PIC_W + 5] == (0xff000000 | 0x0080ff) && h[0].pics[(3 * RG_PIC_H + 141) * RG_PIC_W] == 0;
  // a message that is not whole, or past a picture's rows, is left out
  for i: 0..<n { h[0].inbox[i] = text[i]; } hud_message(h, HUD_RING_PIC_MSG, n - 6);
  #assert hud_store_version(h, 5) == g + 1;
}

#test "the world brings the camera down to a character who runs where the keys say, at the app's 6.9 m/s, and turns to face the way it goes" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  // keys do nothing until the world is shown, and no character is drawn
  hud_test_say(h, HUD_KEYS_MSG, "17");
  hud_test_run(t[..], 60, 0.016);
  #assert h[0].cz == 0 && h[0].cy == 0 && h[0].zoom == 0 && t[0].u[HUD_U_PAGE + 1] == 0 && h[0].ghost_draw == -1 && !h[0].ghost[0].ready;
  hud_test_say(h, HUD_KEYS_MSG, "1");
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 600, 0.01);
  // six seconds forward at 6.9 m/s, less the moment it takes to get going; and the camera is down:
  // the engine's orbit, HUD_WORLD_FAR behind it and over its right shoulder, looking the way it runs
  // and a little down, the character in the window left of its middle
  #assert h[0].zoom == 1 && h[0].tilt == 1 && h[0].cz > 41.0 && h[0].cz < 41.42 && h[0].cx == 0 && h[0].cy == 0;
  #assert near(h[0].foot.walk.speed, 6.9, 0.01);
  view := hud_camera(h, 1200, 2); shot := metaverse_orbit_shot(h[0].orbit);
  #assert h[0].orbiting && near(view.yaw, 0, 0.00001) && view.pitch <= -HUD_WORLD_PITCH + 0.0001 && view.pitch >= -f32(FREE_PITCH) - 0.0001 && view.x == shot.eye.x && view.y == shot.eye.y && view.z == shot.eye.z;
  #assert near(view.x, f32(FREE_SHOULDER), 0.01) && near(view.y, f32(FREE_HEIGHT) + sin(-view.pitch) * HUD_WORLD_FAR, 0.01) && view.z > -h[0].cz + 9 && view.z < -h[0].cz + 10.2;
  at := sty_project(t[0].u[..], h[0].cx, f32(FREE_HEIGHT), -h[0].cz);
  #assert at.ahead && at.x < 800 && at.x > 600 && at.y > 300 && at.y < 900 && t[0].u[HUD_U_PAGE + 1] == 1 && t[0].u[HUD_U_PAGE + 2] == 0 && t[0].u[HUD_U_POINTER + 3] == 1;
  #assert h[0].pace > 0.99;
  // right and forward together: no faster than one, and it turns to face that way (45 degrees)
  ax := h[0].cx; az := h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "9");
  hud_test_run(t[..], 100, 0.01);
  gone := sqrt((h[0].cx - ax) * (h[0].cx - ax) + (h[0].cz - az) * (h[0].cz - az));
  #assert gone > 6.59 && gone < 6.92 && h[0].cx > ax + 3.4 && abs(h[0].face - 0.7853982) < 0.01;
  // to the right is to the right on the screen
  #assert sty_project(t[0].u[..], h[0].cx + 1, 0, -h[0].cz).x > sty_project(t[0].u[..], h[0].cx, 0, -h[0].cz).x;
  // left alone is the other way; letting go stops it, and it stands idle
  hud_test_say(h, HUD_KEYS_MSG, "4");
  bx := h[0].cx;
  hud_test_run(t[..], 100, 0.01);
  #assert h[0].cx < bx - 3.4 && abs(h[0].face + 1.5707963) < 0.02;
  hud_test_say(h, HUD_KEYS_MSG, "gone");
  hud_test_run(t[..], 100, 0.01);
  bx = h[0].cx;
  hud_test_run(t[..], 100, 0.01);
  #assert h[0].cx == bx && h[0].pace < 0.01 && h[0].foot.walk.speed == 0;
  // leaving the world lifts the camera, and the keys move nothing: not a step, not a jump
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_test_say(h, HUD_KEYS_MSG, "17");
  hud_test_run(t[..], 900, 0.01);
  #assert h[0].zoom == 0 && h[0].tilt == 1 && h[0].cx == bx && h[0].cy == 0 && h[0].ghost_draw == -1 && near(hud_camera(h, 1200, 2).pitch, -0.7853982, 0.0001) && !h[0].orbiting;
  hud_test_say(h, HUD_VIEW_MSG, "7"); #assert h[0].view == HUD_LOGIN;
}

#test "space jumps 1.67 m and it lands where the floor is; a second press at the top is no air jump here (fly mode is two quick presses); the camera's pivot rises with it" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 300, 0.01);
  // held: one jump, to the app's height (sr_metric_jump: 1.67 m), then down to the floor and no bounce
  hud_test_say(h, HUD_KEYS_MSG, "16");
  top: f32 = 0; rose: f32 = 0; air := 0; parted := true;
  for k: 0..<200 {
    hud_test_run(t[..], 1, 0.01);
    if h[0].cy > top { top = h[0].cy; } if h[0].orbit.pivot.y - f32(FREE_HEIGHT) > rose { rose = h[0].orbit.pivot.y - f32(FREE_HEIGHT); }
    if h[0].cy > 0 { air += 1; }
    // in the air it parts less of the grass, and none from a metre up
    if h[0].cy >= 1 && t[0].u[STY_U_MOVER + 2] != 0 { parted = false; }
    if h[0].cy > 0.1 && h[0].cy < 0.9 && !(t[0].u[STY_U_MOVER + 2] > 0 && t[0].u[STY_U_MOVER + 2] < HUD_PART) { parted = false; }
  }
  tune: SrWalkTuning;
  #assert near(top, sr_metric_jump(tune), 0.03) && near(top, 1.67, 0.03) && air > 55 && air < 90 && parted;
  #assert h[0].cy == 0 && h[0].foot.jump.on_ground && rose > 1.2 && rose <= top && near(t[0].u[STY_U_MOVER + 2], HUD_PART, 0.0001);
  // let go and pressed again at the top (long after the first press), and once more: no air jump in this game type, and no flight: the jump's own height
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "16");
  top = 0; again := false; third := false;
  for k: 0..<400 {
    hud_test_run(t[..], 1, 0.01);
    if h[0].cy > top { top = h[0].cy; }
    if !again && h[0].foot.jump.vy < 0 { hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 1, 0.01); hud_test_say(h, HUD_KEYS_MSG, "16"); again = true; }
    else if again && !third && h[0].foot.jump.vy < 0 && h[0].cy > 0 { third = true; }
  }
  #assert again && third && near(top, sr_metric_jump(tune), 0.03) && !h[0].fly.on && sr_metric_double(tune) > 3.8;
  #assert h[0].cy == 0 && h[0].foot.jump.on_ground && h[0].cx == 0 && h[0].cz == 0;
}

// The world shown and the camera down in it (five seconds of frames), for the camera's checks.
hud_test_world :: (t: [] HudTest) { t[0].h[0].bare = true; hud_test_say(t[0].h[..], HUD_VIEW_MSG, "2"); hud_test_run(t, 500, 0.01); }

#test "a mouse held on the world and dragged turns the engine's orbit round the character, to Everglade's limits; a press on the page's own things does not" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  // on the way down a look and a zoom are taken, from the world's first frame: nothing waits for the entrance
  e: [1] HudTest; g := e[0].h[..]; g[0].bare = true;
  hud_test_say(g, HUD_VIEW_MSG, "2"); hud_test_run(e[..], 1, 0.01);
  #assert g[0].orbiting && g[0].zoom < 0.1 && hud_looks(g) && near(g[0].orbit.yaw, -HUD_PI, 0.0001) && g[0].orbit.want == HUD_WORLD_FAR;
  hud_pointer(g, 800, 600, 0, 0, 1, 0); hud_pointer(g, 1000, 600, 1, 0, 1, 0); hud_test_say(g, HUD_WHEEL_MSG, "300 0");
  hud_test_run(e[..], 5, 0.01);
  #assert g[0].zoom < 0.5 && !near(g[0].orbit.yaw, -HUD_PI, 0.1) && g[0].orbit.want > HUD_WORLD_FAR;
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 500, 0.01);
  #assert h[0].zoom == 1 && hud_looks(h) && hud_camera(h, 1200, 2).yaw == 0;
  face := h[0].face;
  // 200 device pixels to the right at 2 a CSS pixel: Everglade's drag (cam_drag) turns the view 0.55 radians right
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 1000, 600, 1, 0, 1, 0);
  hud_test_run(t[..], 1, 0.01);
  #assert near(hud_camera(h, 1200, 2).yaw, 100 * f32(CAM_DRAG_TURN), 0.0001) && near(hud_camera(h, 1200, 2).pitch, -HUD_WORLD_PITCH, 0.0001);
  // the eye has swung round to the character's left, still looking at it; the character has not turned
  at := sty_project(t[0].u[..], h[0].cx, f32(FREE_HEIGHT), -h[0].cz);
  #assert hud_camera(h, 1200, 2).x < -4 && at.ahead && at.x > 500 && at.x < 800 && h[0].face == face && h[0].cx == 0 && h[0].cz == 0;
  // up the window looks up, as far as the orbit's range; down looks down, to nearly straight down
  hud_pointer(h, 1000, 560, 1, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert near(h[0].orbit.pitch, HUD_WORLD_PITCH - 20 * f32(CAM_DRAG_TURN), 0.0001);
  hud_pointer(h, 1000, -3000, 1, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbit.pitch == f32(FREE_PITCH_MIN) && near(hud_camera(h, 1200, 2).pitch, -f32(FREE_PITCH_MIN), 0.0001);
  hud_pointer(h, 1000, 3000, 1, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbit.pitch == f32(FREE_PITCH_MAX);
  // let go: the mouse moves and nothing turns; another pointer's move never did
  yaw := h[0].orbit.yaw;
  hud_pointer(h, 1000, 3000, 2, 0, 1, 0); hud_pointer(h, 200, 100, 1, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbit.yaw == yaw && h[0].orbit.pitch == f32(FREE_PITCH_MAX) && !h[0].drag;
  hud_pointer(h, 800, 600, 0, 0, 1, 2); hud_pointer(h, 900, 600, 1, 0, 7, 2); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbit.yaw == yaw && h[0].drag;
  // the other button drags as well (Everglade's look with either)
  hud_pointer(h, 700, 600, 1, 0, 1, 2); hud_test_run(t[..], 1, 0.01);
  #assert near(h[0].orbit.yaw, yaw + 50 * f32(CAM_DRAG_TURN), 0.0001);
  hud_pointer(h, 700, 600, 3, 0, 1, 2); #assert !h[0].drag;
  // a press that began on the chat or the account menu (107) is the page's: its drag turns nothing
  yaw = h[0].orbit.yaw;
  hud_test_say(h, HUD_OVER_MSG, "1");
  hud_pointer(h, 300, 1000, 0, 0, 1, 0); hud_pointer(h, 900, 700, 1, 0, 1, 0); hud_pointer(h, 900, 700, 2, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbit.yaw == yaw && !h[0].drag;
  hud_test_say(h, HUD_OVER_MSG, "0");
  hud_pointer(h, 300, 1000, 0, 0, 1, 0); #assert h[0].drag;
  // the window loses the keys: the drag is over
  hud_blur(h); #assert !h[0].drag;
  // no drag turns the page's own views
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_pointer(h, 800, 600, 0, 0, 1, 0); #assert !h[0].drag;
}

#test "W runs away from the camera wherever it has turned, and the character turns only to the way it is steered" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_world(t[..]);
  // the camera turned a quarter turn to the right (a drag of pi/2 over Everglade's turn, in CSS pixels at 2 device pixels each)
  drag := 1.5707963 / f32(CAM_DRAG_TURN) * 2;
  hud_pointer(h, 100, 600, 0, 0, 1, 0); hud_pointer(h, 100 + drag, 600, 1, 0, 1, 0); hud_pointer(h, 100 + drag, 600, 2, 0, 1, 0);
  hud_test_run(t[..], 1, 0.01);
  #assert near(hud_camera(h, 1200, 2).yaw, 1.5707963, 0.001) && near(h[0].face, 0, 0.0001) && near(sr_face_yaw(h[0].foot.walk), 0, 0.0001);
  // it looks along the page's +x now: W runs that way, at the app's speed, and the character turns to face it
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 100, 0.01);
  #assert h[0].cx > 5.5 && h[0].cx < 6.92 && abs(h[0].cz) < 0.01 && near(h[0].face, 1.5707963, 0.02);
  // D is to the camera's right: the page's -z; the eye stays behind the way it looks
  bx := h[0].cx; bz := h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "8"); hud_test_run(t[..], 100, 0.01);
  #assert h[0].cz < bz - 5.5 && abs(h[0].cx - bx) < 0.6 && near(hud_camera(h, 1200, 2).yaw, 1.5707963, 0.001) && hud_camera(h, 1200, 2).x < h[0].cx - 7;
  // the page is still told the character's facing, not the camera's (action 106)
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01); hud_action_done(h); hud_test_run(t[..], 30, 0.01);
  #assert h[0].action == HUD_WHERE && h[0].told[2] == hud_whole(sin(h[0].face) * 100) && h[0].told[3] == hud_whole(cos(h[0].face) * 100) && h[0].told[3] < -95;
  // the held keys turn and tilt it as Everglade's arrows do, and zoom it
  yaw := h[0].orbit.yaw; pitch := h[0].orbit.pitch;
  hud_test_say(h, HUD_KEYS_MSG, "32"); hud_test_run(t[..], 50, 0.01);
  #assert near(wrap_angle(h[0].orbit.yaw - yaw), 0.5 * f32(FREE_KEY_TURN), 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "64"); hud_test_run(t[..], 50, 0.01);
  #assert near(wrap_angle(h[0].orbit.yaw - yaw), 0, 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "128"); hud_test_run(t[..], 20, 0.01); #assert h[0].orbit.pitch < pitch - 0.2;
  hud_test_say(h, HUD_KEYS_MSG, "256"); hud_test_run(t[..], 40, 0.01); #assert h[0].orbit.pitch > pitch + 0.2;
  hud_test_say(h, HUD_KEYS_MSG, "512"); hud_test_run(t[..], 50, 0.01); #assert h[0].orbit.want < HUD_WORLD_FAR - 2;
  hud_test_say(h, HUD_KEYS_MSG, "1024"); hud_test_run(t[..], 100, 0.01); #assert h[0].orbit.want > HUD_WORLD_FAR;
  hud_test_say(h, HUD_KEYS_MSG, "4095"); #assert h[0].keys == HUD_KEYS_ALL;
}

#test "the wheel zooms out to 12 m and in to 1.5 m, and on into the character's head: first person, its body out of the view" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_world(t[..]);
  // out: Everglade's wheel (cam_wheel), at most 400 of one turn, as far as the orbit's furthest
  hud_test_say(h, HUD_WHEEL_MSG, "100 0");
  #assert near(h[0].orbit.want, HUD_WORLD_FAR + 100 * f32(CAM_WHEEL_ZOOM), 0.0001);
  hud_test_say(h, HUD_WHEEL_MSG, "-9000 0"); #assert near(h[0].orbit.want, HUD_WORLD_FAR - 300 * f32(CAM_WHEEL_ZOOM), 0.0001);
  hud_test_say(h, HUD_WHEEL_MSG, "400 0"); hud_test_say(h, HUD_WHEEL_MSG, "400 0"); #assert h[0].orbit.want == f32(FREE_FAR);
  hud_test_run(t[..], 200, 0.01);
  far := hud_camera(h, 1200, 2);
  #assert near(h[0].orbit.zoom, f32(FREE_FAR), 0.01) && far.z > 11 && t[0].u[HUD_U_PAGE + 2] == 0;
  // over the chat or the account menu the wheel is the page's
  hud_test_say(h, HUD_WHEEL_MSG, "-400 1"); #assert h[0].orbit.want == f32(FREE_FAR);
  hud_test_say(h, HUD_WHEEL_MSG, "x"); #assert h[0].orbit.want == f32(FREE_FAR);
  // in: it stops at the closest, the character still in view
  for k: 0..<5 { hud_test_say(h, HUD_WHEEL_MSG, "-400 0"); }
  #assert h[0].orbit.want == f32(FREE_NEAR);
  hud_test_run(t[..], 200, 0.01);
  #assert near(h[0].orbit.zoom, f32(FREE_NEAR), 0.01) && h[0].gone == 0 && !metaverse_orbit_inside(h[0].orbit) && h[0].ghost_draw == -1;
  // and a little more goes on into its head: the eye where its eyes are, looking the way it looked, its body left out
  hud_test_say(h, HUD_WHEEL_MSG, "-120 0"); #assert h[0].orbit.want == 0;
  hud_test_run(t[..], 200, 0.01);
  eye := hud_camera(h, 1200, 2);
  #assert metaverse_orbit_inside(h[0].orbit) && h[0].gone == 1 && t[0].u[HUD_U_PAGE + 2] == 1 && t[0].u[HUD_U_PAGE + 1] == 1;
  #assert near(eye.x, 0, 0.01) && near(eye.y, f32(FREE_EYE), 0.01) && near(eye.z, -f32(FREE_FACE), 0.01) && eye.yaw == 0;
  // there it looks nearly straight up and down, and W still runs where it looks
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 800, 9000, 1, 0, 1, 0); hud_pointer(h, 800, 9000, 2, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert near(h[0].orbit.pitch, f32(FREE_FIRST_PITCH), 0.0001);
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 100, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert h[0].cz > 5.5 && abs(h[0].cx) < 0.01;
  // any zoom out comes back out to the closest, and the body is back
  hud_test_say(h, HUD_WHEEL_MSG, "10 0"); #assert h[0].orbit.want == f32(FREE_NEAR);
  hud_test_run(t[..], 300, 0.01);
  #assert !metaverse_orbit_inside(h[0].orbit) && h[0].gone == 0 && t[0].u[HUD_U_PAGE + 2] == 0;
  // the wheel turns nothing on the page's own views
  hud_test_say(h, HUD_VIEW_MSG, "0"); hud_test_say(h, HUD_WHEEL_MSG, "400 0"); #assert h[0].orbit.want == f32(FREE_NEAR);
}

#test "the camera keeps in front of a block and above the ground, by the orbit's own room; pressed to the character's shoulders, its body is left out" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  // a wall 4 m behind the character, wider and taller than the view of it: the eye stops the orbit's clearance in front of it
  h[0].drop = 0;   // put where it rests: 36 tonnes of wall
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 0 -450 2000 600 100\n");
  hud_test_world(t[..]);
  eye := hud_camera(h, 1200, 2);
  #assert h[0].nb == 1 && near(-eye.z, -4 + f32(FREE_CLEAR), 0.05) && h[0].orbit.shown < 4.2 && h[0].orbit.zoom == HUD_WORLD_FAR && h[0].gone == 0;
  // turned to look along the wall there is nothing behind it: it backs out again, gently
  hud_test_say(h, HUD_KEYS_MSG, "32"); hud_test_run(t[..], 71, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  mid := h[0].orbit.shown;
  hud_test_run(t[..], 300, 0.01);
  #assert mid < 9 && h[0].orbit.shown > mid && h[0].orbit.shown > 9;
  // the wall right at its back: the eye is pulled in to its shoulders, and the body leaves the view
  hud_test_say(h, HUD_KEYS_MSG, "64"); hud_test_run(t[..], 71, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n2 0 1 1 0 0 -130 2000 600 100\n");
  hud_test_run(t[..], 100, 0.01);
  #assert h[0].orbit.shown < f32(FREE_CLOAK) && metaverse_orbit_unseen(h[0].orbit) && !metaverse_orbit_inside(h[0].orbit) && h[0].gone == 1 && t[0].u[HUD_U_PAGE + 2] == 1;
  // no blocks: looking up from as low as the orbit goes, the eye keeps its clearance over the ground
  hud_test_say(h, HUD_BLOCKS_MSG, "0\n");
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 800, -9000, 1, 0, 1, 0); hud_pointer(h, 800, -9000, 2, 0, 1, 0);
  hud_test_run(t[..], 300, 0.01);
  low := hud_camera(h, 1200, 2);
  #assert h[0].orbit.pitch == f32(FREE_PITCH_MIN) && near(low.y, f32(FREE_CLEAR), 0.01) && h[0].orbit.shown < 3 && h[0].gone == 0;
}

#test "a phone's thumbs are the engine's sticks: the left half moves, the right half looks, a second finger there pinches, a tap there jumps" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_world(t[..]);
  bare := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.01);
  // a finger down on the right half and dragged 100 CSS pixels left: the view turns left by the sticks' look
  hud_pointer(h, 1200, 600, 0, 1, 5, 0); hud_pointer(h, 1000, 600, 1, 1, 5, 0);
  hud_test_run(t[..], 1, 0.01);
  #assert near(hud_camera(h, 1200, 2).yaw, -100 * f32(pad.STICKS_LOOK), 0.0001);
  // a second finger there: the two spread 100 CSS pixels, which zooms in as 600 of the wheel, and nothing turns
  yaw := h[0].orbit.yaw;
  hud_pointer(h, 1000, 800, 0, 1, 6, 0); hud_pointer(h, 1000, 1000, 1, 1, 6, 0);
  hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbit.yaw == yaw && near(h[0].orbit.want, HUD_WORLD_FAR - 600 * f32(CAM_WHEEL_ZOOM), 0.05) && h[0].sticks.zoom == 0;
  hud_pointer(h, 1000, 1000, 2, 1, 6, 0); hud_pointer(h, 1000, 600, 2, 1, 5, 0);
  // a thumb on the left half pushed up a full ring: it runs away from the camera, and the stick is drawn
  hud_pointer(h, 300, 800, 0, 1, 7, 0); hud_pointer(h, 300, 800 - 2 * f32(pad.STICKS_RADIUS), 1, 1, 7, 0);
  shown := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.01);
  #assert shown == bare + 34 * 6 && h[0].sticks.pad_y == 1;
  hud_test_run(t[..], 100, 0.01);
  ahead := h[0].cx * sin(HUD_PI - h[0].orbit.yaw) + h[0].cz * cos(HUD_PI - h[0].orbit.yaw);
  #assert ahead > 5.5 && ahead < 6.92;
  hud_pointer(h, 300, 700, 2, 1, 7, 0); hud_test_run(t[..], 100, 0.01);
  #assert h[0].foot.walk.speed == 0 && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.01) == bare;
  // a quick still touch on the right half: a whole jump
  hud_pointer(h, 1300, 500, 0, 1, 8, 0); hud_pointer(h, 1300, 500, 2, 1, 8, 0);
  top: f32 = 0;
  for k: 0..<150 { hud_test_run(t[..], 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  #assert near(top, 1.67, 0.05) && h[0].cy == 0;
  // a touch that began on the page's own things is the page's; and losing the window lets every thumb go
  hud_test_say(h, HUD_OVER_MSG, "1");
  hud_pointer(h, 300, 800, 0, 1, 9, 0); #assert !h[0].sticks.move_on;
  hud_test_say(h, HUD_OVER_MSG, "0");
  hud_pointer(h, 300, 800, 0, 1, 9, 0); #assert h[0].sticks.move_on;
  hud_blur(h); #assert !h[0].sticks.move_on;
}

// How far the camera's view is turned from the way the character faces, radians (0: directly behind it).
hud_test_aside :: (h: [] Hud) -> f32 { return abs(wrap_angle(HUD_PI - h[0].orbit.yaw - h[0].face)); }

#test "the follow camera is locked behind the character: it swings there at once and stays, the keys are the character's own; free is as it was" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_world(t[..]);
  // free (as the world opens): running to the left turns the character and not the camera
  yaw := h[0].orbit.yaw;
  hud_test_say(h, HUD_KEYS_MSG, "4"); hud_test_run(t[..], 200, 0.01);
  #assert !h[0].follow && h[0].orbit.yaw == yaw && near(h[0].face, -1.5707963, 0.02) && h[0].cx < -10;
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01);
  #assert hud_test_aside(h) > 1.5;
  // follow on, standing: the camera swings round to its back in under half a second (the character does not turn), and is locked
  face := h[0].face;
  hud_test_say(h, HUD_FOLLOW_MSG, "1");
  hud_test_run(t[..], 10, 0.01); #assert hud_test_aside(h) < 0.5 && hud_test_aside(h) > 0.2 && near(wrap_angle(h[0].face - face), 0, 0.0001);
  hud_test_run(t[..], 40, 0.01);
  #assert h[0].follow && hud_test_aside(h) < 0.00001 && near(wrap_angle(h[0].face - face), 0, 0.0001) && h[0].foot.walk.face_off == 0;
  eye := metaverse_orbit_shot(h[0].orbit).eye;
  #assert (eye.x - h[0].cx) * sin(h[0].face) + (-eye.z - h[0].cz) * cos(h[0].face) < -8;
  // from here it is behind every frame: standing, turning, running, backing up, after a drag
  locked := true;
  // A turns the character left where it stands, at the orbit's key turn, and the camera with it; D turns it back
  x0 := h[0].cx; z0 := h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "4");
  for k: 0..<100 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  #assert locked && near(wrap_angle(h[0].face - face), -f32(FREE_KEY_TURN), 0.01) && h[0].cx == x0 && h[0].cz == z0 && h[0].foot.walk.speed == 0;
  hud_test_say(h, HUD_KEYS_MSG, "8");
  for k: 0..<100 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  #assert locked && near(wrap_angle(h[0].face - face), 0, 0.01) && h[0].cx == x0 && h[0].cz == z0;
  // W runs the way it faces; with D held as well it runs a curve to the right, the camera behind it throughout
  hud_test_say(h, HUD_KEYS_MSG, "1");
  for k: 0..<100 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  ran := (h[0].cx - x0) * sin(face) + (h[0].cz - z0) * cos(face);
  #assert locked && ran > 5.5 && ran < 6.92 && near(wrap_angle(h[0].face - face), 0, 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "9");
  for k: 0..<50 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  #assert locked && near(wrap_angle(h[0].face - face), 0.5 * f32(FREE_KEY_TURN), 0.02) && near(h[0].foot.walk.speed, 6.9, 0.05);
  // S backs up: it moves the other way from the way it faces, and does not turn
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01);
  face = h[0].face; x0 = h[0].cx; z0 = h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "2");
  for k: 0..<100 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  back := (h[0].cx - x0) * sin(face) + (h[0].cz - z0) * cos(face);
  #assert locked && back < -5.5 && h[0].face == face;
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01);
  // a drag to the right turns the character and the camera together, by the orbit's drag; up and down still tilt
  tilt := h[0].orbit.pitch;
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 1000, 560, 1, 0, 1, 0); hud_pointer(h, 1000, 560, 2, 0, 1, 0);
  for k: 0..<20 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  #assert locked && near(wrap_angle(h[0].face - face), 100 * f32(CAM_DRAG_TURN), 0.001) && near(h[0].orbit.pitch, tilt - 20 * f32(CAM_DRAG_TURN), 0.001);
  // the arrows turn it too, and a thumb pushed to the side
  face = h[0].face;
  hud_test_say(h, HUD_KEYS_MSG, "32");
  for k: 0..<50 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert locked && near(wrap_angle(h[0].face - face), -0.5 * f32(FREE_KEY_TURN), 0.01);
  face = h[0].face; x0 = h[0].cx; z0 = h[0].cz;
  hud_pointer(h, 300, 800, 0, 1, 7, 0); hud_pointer(h, 300 + 2 * f32(pad.STICKS_RADIUS), 800, 1, 1, 7, 0);
  for k: 0..<50 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  hud_pointer(h, 300, 800, 2, 1, 7, 0);
  #assert locked && near(wrap_angle(h[0].face - face), 0.5 * f32(FREE_KEY_TURN), 0.01) && h[0].cx == x0 && h[0].cz == z0;
  // the zoom and its head are as before, and locked there too
  for k: 0..<5 { hud_test_say(h, HUD_WHEEL_MSG, "-400 0"); } hud_test_say(h, HUD_WHEEL_MSG, "-120 0");
  hud_test_say(h, HUD_KEYS_MSG, "5");
  for k: 0..<200 { hud_test_run(t[..], 1, 0.01); if hud_test_aside(h) > 0.00001 { locked = false; } }
  #assert locked && metaverse_orbit_inside(h[0].orbit) && h[0].gone == 1;
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_say(h, HUD_WHEEL_MSG, "400 0"); hud_test_run(t[..], 200, 0.01);
  // off again: the camera stays where it is, and the keys are the camera's again: A runs to its left, turning the character and not the view
  held := h[0].orbit.yaw; want := h[0].orbit.want; face = h[0].face;
  hud_test_say(h, HUD_FOLLOW_MSG, "0"); hud_test_run(t[..], 1, 0.01);
  #assert !h[0].follow && h[0].orbit.yaw == held && h[0].orbit.want == want && h[0].face == face;
  hud_test_say(h, HUD_KEYS_MSG, "4"); hud_test_run(t[..], 200, 0.01);
  #assert h[0].orbit.yaw == held && near(wrap_angle(h[0].face - face), -1.5707963, 0.02) && near(h[0].foot.walk.speed, 6.9, 0.05);
  hud_test_say(h, HUD_FOLLOW_MSG, "x"); #assert !h[0].follow;
}

// The world entered as game type `kind`, the camera down in it.
hud_test_kind :: (t: [] HudTest, kind: string) { t[0].h[0].bare = true; hud_test_say(t[0].h[..], HUD_KIND_MSG, kind); hud_test_say(t[0].h[..], HUD_VIEW_MSG, "2"); hud_test_run(t, 500, 0.01); }

#test "first person: the entrance ends in the character's head looking at the sunrise; it looks and runs where it looks, never zooms out, and has the engine's reticle" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  hud_test_say(h, HUD_KIND_MSG, "1"); hud_test_say(h, HUD_VIEW_MSG, "2");
  // on the way down the character is still seen, and there is no reticle
  hud_test_run(t[..], 10, 0.01);
  part := hud_camera(h, 1200, 2);
  #assert h[0].kind == CAM_KIND_FIRST && h[0].zoom > 0.3 && h[0].zoom < 0.9 && h[0].gone == 0 && part.y > 3 && part.y < 12 && part.yaw == 0;
  hud_test_run(t[..], 500, 0.01);
  eye := hud_camera(h, 1200, 2);
  #assert h[0].zoom == 1 && metaverse_orbit_inside(h[0].orbit) && h[0].orbit.want == 0 && h[0].gone == 1 && t[0].u[HUD_U_PAGE + 2] == 1;
  #assert near(eye.x, 0, 0.01) && near(eye.y, f32(FREE_EYE), 0.01) && near(eye.z, -f32(FREE_FACE), 0.01) && near(eye.yaw, 0, 0.00001) && near(eye.pitch, -HUD_WORLD_PITCH, 0.0001) && eye.fov == HUD_FOV;
  // the reticle: the engine's five strokes at the middle of the window
  with := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0);
  h[0].kind = CAM_KIND_THIRD; plain := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0); h[0].kind = CAM_KIND_FIRST;
  #assert with == plain + 5 * 6;
  // nothing zooms it out: not the wheel, not the key, not a pinch
  hud_test_say(h, HUD_WHEEL_MSG, "400 0"); hud_test_say(h, HUD_KEYS_MSG, "1024");
  hud_pointer(h, 1200, 600, 0, 1, 5, 0); hud_pointer(h, 1000, 800, 0, 1, 6, 0); hud_pointer(h, 1000, 700, 1, 1, 6, 0); hud_pointer(h, 1000, 700, 2, 1, 6, 0); hud_pointer(h, 1200, 600, 2, 1, 5, 0);
  hud_test_run(t[..], 100, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert h[0].orbit.want == 0 && metaverse_orbit_inside(h[0].orbit) && h[0].gone == 1;
  // a drag looks round (a quarter turn to the right), and W runs where it looks: the page's +x
  drag := 1.5707963 / f32(CAM_DRAG_TURN) * 2;
  hud_pointer(h, 100, 600, 0, 0, 1, 0); hud_pointer(h, 100 + drag, 600, 1, 0, 1, 0); hud_pointer(h, 100 + drag, 600, 2, 0, 1, 0);
  hud_test_run(t[..], 1, 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 100, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert near(hud_camera(h, 1200, 2).yaw, 1.5707963, 0.001) && h[0].cx > 5.5 && abs(h[0].cz) < 0.01;
  // A steps to its left (the page's +z now), Space jumps, and the follow button's word does nothing here
  hud_test_say(h, HUD_FOLLOW_MSG, "1");
  z0 := h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "20"); top: f32 = 0;
  for k: 0..<100 { hud_test_run(t[..], 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  #assert h[0].cz > z0 + 5 && top > 1.5 && near(hud_camera(h, 1200, 2).yaw, 1.5707963, 0.001);
}

#test "first person holds the pointer: a press on the world asks for it, the mouse then looks with no button down, and Escape, the caret, the picker and other types let it go" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  hud_test_say(h, HUD_KIND_MSG, "1"); hud_test_say(h, HUD_VIEW_MSG, "2");
  // from the world's first frames, the camera still coming down, the cursor is free: nothing waits for the entrance
  hud_test_run(t[..], 5, 0.01);
  #assert h[0].zoom < 0.5 && hud_mouselook(h) == ml.ML_FREE && !ml.ml_on(h[0].mouse[0]);
  // arrived: the cursor is still free (the chat and the menu need it) until the world is pressed
  hud_test_run(t[..], 500, 0.01);
  #assert hud_mouselook(h) == ml.ML_FREE && !ml.ml_on(h[0].mouse[0]);
  // a press on one of the page's own things is not the world's: still free
  hud_test_say(h, HUD_OVER_MSG, "1"); hud_pointer(h, 800, 1100, 0, 0, 1, 0); hud_pointer(h, 800, 1100, 2, 0, 1, 0);
  #assert hud_mouselook(h) == ml.ML_FREE;
  // a press on the world: the host is asked to hold the pointer; a move before the browser has said yes turns nothing
  hud_test_say(h, HUD_OVER_MSG, "0"); hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 800, 600, 2, 0, 1, 0);
  #assert hud_mouselook(h) == ml.ML_LOOK;
  hud_look_delta(h, 200, 0); #assert h[0].look_yaw == 0;
  // held: the mouse looks, at the engine's sensitivity; right turns right (the page's +x), and W runs there
  hud_pointer_lock(h, 1);
  #assert ml.ml_on(h[0].mouse[0]);
  quarter := 1.5707963 / f32(ml.ML_TURN);
  for k: 0..<10 { hud_look_delta(h, quarter / 10, 0); hud_test_run(t[..], 1, 0.01); }
  #assert near(hud_camera(h, 1200, 2).yaw, 1.5707963, 0.001);
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 100, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert h[0].cx > 5.5 && abs(h[0].cz) < 0.01;
  // the mouse pushed away looks up, pulled back looks down, and stops at the engine's first-person limits
  p0 := hud_camera(h, 1200, 2).pitch;
  hud_look_delta(h, 0, -100); hud_test_run(t[..], 1, 0.01);
  #assert near(hud_camera(h, 1200, 2).pitch, p0 + 100 * f32(ml.ML_TURN), 0.0001);
  for k: 0..<40 { hud_look_delta(h, 0, 400); hud_test_run(t[..], 1, 0.01); }
  #assert hud_camera(h, 1200, 2).pitch < -1.2 && hud_camera(h, 1200, 2).pitch > -1.5707963;
  // the drag still looks while it is held or not: the same turn
  // Escape (the browser lets go): the cursor is free, and a move turns nothing
  hud_pointer_lock(h, 0);
  y0 := hud_camera(h, 1200, 2).yaw;
  #assert hud_mouselook(h) == ml.ML_FREE; hud_look_delta(h, 300, 0); hud_test_run(t[..], 1, 0.01); #assert hud_camera(h, 1200, 2).yaw == y0;
  drag := 0.5 / f32(CAM_DRAG_TURN) * 2;
  hud_pointer(h, 100, 600, 0, 0, 1, 0);
  #assert hud_mouselook(h) == ml.ML_LOOK;   // (that press asks again)
  hud_pointer_lock(h, 2);                   // refused this time: the drag is the look
  #assert hud_mouselook(h) == ml.ML_FREE;
  hud_pointer(h, 100 + drag, 600, 1, 0, 1, 0); hud_pointer(h, 100 + drag, 600, 2, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert near(wrap_angle(hud_camera(h, 1200, 2).yaw - y0), 0.5, 0.001);
  // held again, then the caret goes to the chat's box (Enter): let go, and not asked for again until the world is pressed
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 800, 600, 2, 0, 1, 0); hud_pointer_lock(h, 1);
  #assert ml.ml_on(h[0].mouse[0]);
  hud_test_say(h, HUD_TYPING_MSG, "1"); #assert hud_mouselook(h) == ml.ML_FREE;
  hud_pointer_lock(h, 0); hud_test_say(h, HUD_TYPING_MSG, "0"); hud_test_run(t[..], 1, 0.01);
  #assert hud_mouselook(h) == ml.ML_FREE;
  // a finger never holds it
  hud_pointer(h, 1200, 600, 0, 1, 5, 0); #assert hud_mouselook(h) == 0; hud_pointer(h, 1200, 600, 2, 1, 5, 0);
  // held, then back to the picker (the login's pose): nothing is asked, and the next entrance starts free
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 800, 600, 2, 0, 1, 0); hud_pointer_lock(h, 1);
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_test_run(t[..], 1, 0.01);
  #assert hud_mouselook(h) == 0;
  hud_pointer_lock(h, 0); hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 600, 0.01);
  #assert hud_mouselook(h) == ml.ML_FREE;
  // third person never asks for it
  hud_test_say(h, HUD_KIND_MSG, "0"); hud_test_run(t[..], 600, 0.01);
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 800, 600, 2, 0, 1, 0); hud_test_run(t[..], 1, 0.01);
  #assert hud_mouselook(h) == 0;
}

#test "top down: the entrance ends high above the character looking steeply down, north up; it never turns, every key is a screen direction, the wheel zooms within its range" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_kind(t[..], "2");
  eye := hud_camera(h, 1200, 2);
  // 12 m out at 63 degrees: some 12 m up and 5.4 m behind, looking ahead and down; the character in the window, never left out
  #assert h[0].zoom == 1 && near(eye.yaw, 0, 0.00001) && near(eye.pitch, -f32(CAM_KIND_TOP_PITCH), 0.0001) && near(eye.y, f32(FREE_HEIGHT) + 12 * sin(1.1), 0.02) && near(eye.z, 12 * cos(1.1), 0.02) && eye.fov == HUD_FOV;
  at := sty_project(t[0].u[..], h[0].cx, 1, -h[0].cz);
  #assert at.ahead && at.x > 600 && at.x < 900 && at.y > 400 && at.y < 800 && h[0].gone == 0;
  // nothing turns or tilts it: not a drag, not the arrows, not a thumb, not the follow button, not a long run
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 1200, 300, 1, 0, 1, 0); hud_pointer(h, 1200, 300, 2, 0, 1, 0);
  hud_pointer(h, 1200, 600, 0, 1, 5, 0); hud_pointer(h, 1000, 500, 1, 1, 5, 0); hud_pointer(h, 1000, 500, 2, 1, 5, 0);
  hud_test_say(h, HUD_FOLLOW_MSG, "1");
  fixed := true;
  // D runs to the right of the screen (the page's +x), W up it (+z), at the app's speed
  hud_test_say(h, HUD_KEYS_MSG, "8");
  for k: 0..<200 { hud_test_run(t[..], 1, 0.01); c := hud_camera(h, 1200, 2); if abs(c.yaw) > 0.00001 || abs(c.pitch + f32(CAM_KIND_TOP_PITCH)) > 0.0001 { fixed = false; } }
  #assert fixed && h[0].cx > 12 && abs(h[0].cz) < 0.01 && near(h[0].foot.walk.speed, 6.9, 0.05);
  r0 := sty_project(t[0].u[..], h[0].cx, 0, -h[0].cz); r1 := sty_project(t[0].u[..], h[0].cx + 1, 0, -h[0].cz); r2 := sty_project(t[0].u[..], h[0].cx, 0, -h[0].cz - 1);
  #assert r1.x > r0.x + 20 && abs(r1.y - r0.y) < 1 && r2.y < r0.y - 20 && abs(r2.x - r0.x) < 20;
  x0 := h[0].cx;
  hud_test_say(h, HUD_KEYS_MSG, "1");
  for k: 0..<200 { hud_test_run(t[..], 1, 0.01); c := hud_camera(h, 1200, 2); if abs(c.yaw) > 0.00001 || abs(c.pitch + f32(CAM_KIND_TOP_PITCH)) > 0.0001 { fixed = false; } }
  #assert fixed && h[0].cz > 12 && abs(h[0].cx - x0) < 2;
  // the arrows are directions too: left runs left, down runs down the screen
  x0 = h[0].cx; z0 := h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "32"); hud_test_run(t[..], 100, 0.01); #assert h[0].cx < x0 - 5;
  hud_test_say(h, HUD_KEYS_MSG, "256"); hud_test_run(t[..], 100, 0.01); #assert h[0].cz < z0 - 4;
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01);
  c := hud_camera(h, 1200, 2); #assert near(c.yaw, 0, 0.00001) && near(c.pitch, -f32(CAM_KIND_TOP_PITCH), 0.0001);
  // the wheel: in to 6 m and no nearer (never into its head), out to 12 m
  for k: 0..<8 { hud_test_say(h, HUD_WHEEL_MSG, "-400 0"); }
  hud_test_run(t[..], 200, 0.01);
  #assert h[0].orbit.want == f32(CAM_KIND_TOP_NEAR) && near(h[0].orbit.zoom, 6, 0.01) && !metaverse_orbit_inside(h[0].orbit) && h[0].gone == 0;
  for k: 0..<8 { hud_test_say(h, HUD_WHEEL_MSG, "400 0"); } #assert h[0].orbit.want == 12;
  // and no reticle is drawn
  hud_test_say(h, HUD_KIND_MSG, "9"); #assert h[0].kind == CAM_KIND_TOP;
}

#test "side on: the entrance swings round to look at the character from its side, level with it, through a long lens; A and D run along its line, W jumps, its depth is held" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  h[0].foot.walk.x = 2; h[0].foot.walk.z = 1;
  hud_test_say(h, HUD_KIND_MSG, "3"); hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 12, 0.01);
  mid := hud_camera(h, 1200, 2); #assert mid.yaw < -0.3 && mid.yaw > -1.5 && mid.fov < HUD_FOV && mid.fov > f32(CAM_KIND_SIDE_FOV);
  hud_test_run(t[..], 500, 0.01);
  eye := hud_camera(h, 1200, 2);
  // 12 m to the character's right, at the pivot's height, looking across (the engine's -x): the page's ahead is to the right of the screen
  #assert h[0].zoom == 1; #assert near(eye.yaw, -1.5707963, 0.0001); #assert near(eye.pitch, 0, 0.0001); #assert near(eye.x, 2 + 12, 0.01); #assert near(eye.y, f32(FREE_HEIGHT), 0.01); #assert eye.fov == f32(CAM_KIND_SIDE_FOV);
  a0 := sty_project(t[0].u[..], 2, 1, -1); a1 := sty_project(t[0].u[..], 2, 1, -2);
  #assert a0.ahead && a1.x > a0.x + 50 && abs(a1.y - a0.y) < 1 && a0.x > 500 && a0.x < 1000 && h[0].gone == 0;
  // D runs to the right (ahead, the page's +z), on its line; A back; the right arrow runs too
  hud_test_say(h, HUD_KEYS_MSG, "8"); hud_test_run(t[..], 100, 0.01);
  #assert h[0].cz > 6.5 && near(h[0].cx, 2, 0.0001) && near(h[0].foot.walk.speed, 6.9, 0.05) && near(h[0].face, 0, 0.05);
  z0 := h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "4"); hud_test_run(t[..], 200, 0.01);
  #assert h[0].cz < z0 - 6 && near(h[0].cx, 2, 0.0001);
  z0 = h[0].cz;
  hud_test_say(h, HUD_KEYS_MSG, "64"); hud_test_run(t[..], 100, 0.01); #assert h[0].cz > z0 + 4 && near(h[0].cx, 2, 0.0001);
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01);
  // W jumps where it stands (so does the up arrow): it does not go into the picture; S does nothing
  z0 = h[0].cz; top: f32 = 0;
  hud_test_say(h, HUD_KEYS_MSG, "1");
  for k: 0..<120 { hud_test_run(t[..], 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  #assert top > 1.5 && h[0].cz == z0 && near(h[0].cx, 2, 0.0001);
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 60, 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "128"); top = 0;
  for k: 0..<120 { hud_test_run(t[..], 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  #assert top > 1.5 && h[0].cz == z0;
  hud_test_say(h, HUD_KEYS_MSG, "2"); hud_test_run(t[..], 100, 0.01); #assert h[0].cz == z0 && near(h[0].cx, 2, 0.0001) && h[0].foot.walk.speed == 0;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  // pushed off its line, it is put back on it the next frame
  h[0].foot.walk.x = 2.8; hud_test_run(t[..], 1, 0.01); #assert near(h[0].cx, 2, 0.0001);
  // the camera never turns or tilts, and zooms between 7 and 12 m
  hud_pointer(h, 800, 600, 0, 0, 1, 0); hud_pointer(h, 1200, 300, 1, 0, 1, 0); hud_pointer(h, 1200, 300, 2, 0, 1, 0);
  for k: 0..<8 { hud_test_say(h, HUD_WHEEL_MSG, "-400 0"); }
  hud_test_run(t[..], 200, 0.01);
  c := hud_camera(h, 1200, 2);
  #assert near(c.yaw, -1.5707963, 0.0001) && near(c.pitch, 0, 0.0001) && h[0].orbit.want == f32(CAM_KIND_SIDE_NEAR) && near(c.x, 2 + 7, 0.02);
}

#test "picking a game type plays its entrance from the start: the orbit is that type's, and the grass and the sunrise begin again" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_world(t[..]);
  hud_test_run(t[..], 800, 0.01);
  #assert h[0].kind == CAM_KIND_THIRD && h[0].spread == HUD_SPREAD && h[0].dawn == HUD_SUNRISE && h[0].orbit.want == HUD_WORLD_FAR;
  // back at the picker (the login's pose) for a second and a half: the camera is back up
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_test_run(t[..], 150, 0.01);
  #assert h[0].zoom < 0.001 && h[0].spread == 0 && h[0].dawn == 0;
  // top down picked: its orbit, its clocks at nothing
  hud_test_say(h, HUD_KIND_MSG, "2"); hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbiting && h[0].orbit.pitch == f32(CAM_KIND_TOP_PITCH) && h[0].orbit.want == 12 && h[0].spread > 0 && h[0].spread < 0.02 && h[0].dawn > 0 && h[0].dawn < 0.02;
  // the view said again each frame (as the glue says it) starts nothing over
  hud_test_run(t[..], 300, 0.01); hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_say(h, HUD_KIND_MSG, "2");
  #assert h[0].spread == HUD_SPREAD && h[0].dawn > 2.9 && h[0].orbiting;
  // the same type picked again, at once, mid sunrise: it starts over all the same, where the character now stands
  h[0].foot.walk.x = 7;
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_test_run(t[..], 5, 0.01);
  hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 1, 0.01);
  #assert h[0].spread < 0.02 && h[0].dawn < 0.02 && h[0].from_x == 7 && h[0].orbiting && near(h[0].orbit.pivot.x, 7, 0.0001);
  // each type's lens and start, and a type that is none is not taken
  hud_test_say(h, HUD_KIND_MSG, "3"); #assert h[0].kind == CAM_KIND_SIDE && !h[0].orbiting;
  hud_test_say(h, HUD_KIND_MSG, "9"); hud_test_say(h, HUD_KIND_MSG, "-1"); hud_test_say(h, HUD_KIND_MSG, "x"); #assert h[0].kind == CAM_KIND_SIDE;
  hud_test_say(h, HUD_KIND_MSG, "0"); #assert h[0].kind == CAM_KIND_THIRD;
}

// The edit the HUD tells the page next (its action HUD_EDIT), within a few frames: "" when it tells none.
hud_test_edit :: (t: [] HudTest) -> string {
  h := t[0].h[..];
  for k: 0..<6 {
    hud_test_run(t, 1, 0.01);
    code := hud_action(h);
    if code == HUD_EDIT { n := hud_outbox_len(h); for i: 0..<n { t[0].told[i] = h[0].outbox[i]; } hud_action_done(h); return cast(string) t[0].told[0..<n]; }
    if code != 0 { hud_action_done(h); }
  }
  return "";
}
// The pointer put on a point of the world (the page's axes), as the mouse moving there.
hud_test_point :: (t: [] HudTest, x: f32, y: f32, z: f32) -> StyOnScreen { p := sty_project(t[0].u[..], x, y, -z); hud_pointer(t[0].h[..], p.x, p.y, 1, 0, 1, 0); return p; }
// The starting things at rest in a world that is up, as game type `kind`.
hud_test_built :: (t: [] HudTest, kind: string) {
  h := t[0].h[..];
  hud_test_say(h, HUD_KIND_MSG, kind); hud_test_say(h, HUD_BLOCKS_MSG, HUD_TEST_START);
  hud_test_down(t); hud_test_run(t, 400, 0.01);
  for k: 0..<4 { if hud_action(h) != 0 { hud_action_done(h); } hud_test_run(t, 30, 0.01); }
  if hud_action(h) != 0 { hud_action_done(h); }
}

// The k-th word of an edit as hundredths ("2.50" is 250, "-1.5" is -150): -999999 when it is no number.
hud_test_num :: (said: string, k: int) -> int {
  at := 0; word := 0;
  while at < said.count {
    while at < said.count && said[at] == ' ' { at += 1; }
    end := at; while end < said.count && said[end] != ' ' { end += 1; }
    if word == k {
      w := cast(string) said[at..<end]; i := 0; neg := w.count > 0 && w[0] == '-'; if neg { i = 1; }
      whole := 0; part := 0; places := 0; seen := 0;
      while i < w.count && w[i] >= '0' && w[i] <= '9' { whole = whole * 10 + cast(int) (w[i] - '0'); i += 1; seen += 1; }
      if i < w.count && w[i] == '.' { i += 1; while i < w.count && w[i] >= '0' && w[i] <= '9' { if places < 2 { part = part * 10 + cast(int) (w[i] - '0'); places += 1; } i += 1; seen += 1; } if places == 1 { part *= 10; } }
      if seen == 0 || i != w.count { return -999999; }
      return ifx neg then -(whole * 100 + part) else whole * 100 + part;
    }
    word += 1; at = end;
  }
  return -999999;
}
iabs :: (v: int) -> int { return ifx v < 0 then -v else v; }
hud_test_ends :: (said: string, tail: string) -> bool { return said.count >= tail.count && cast(string) said[said.count - tail.count..<said.count] == tail; }
// A click of the mouse's first button where the pointer was last put.
hud_test_click :: (t: [] HudTest, g: StyOnScreen) -> string { h := t[0].h[..]; hud_pointer(h, g.x, g.y, 0, 0, 1, 0); hud_pointer(h, g.x, g.y, 2, 0, 1, 0); return hud_test_edit(t); }

#test "the placing tools' two modes: free sets the thing down exactly where the pointer is, snap sets it in the grid's cell, both at rest (nothing a tool places drops in); each ghost shows its mode" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  // no tool, not editing: a press on the world is the camera's, and nothing is told
  bare := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0);
  g := hud_test_point(t[..], 2.2, 0, 3.1);
  hud_pointer(h, g.x, g.y, 0, 0, 1, 0);
  #assert h[0].drag && !h[0].tooling && hud_test_edit(t[..]) == "";
  hud_pointer(h, g.x, g.y, 2, 0, 1, 0);
  // free (what the page says when it says no mode): the block's wire alone, standing on the ground where it will be: nothing up in the air, no line down
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0");
  #assert h[0].tool == HUD_T_BLOCK && h[0].mode == HUD_M_FREE && !h[0].editing && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + 12 * 6;
  hud_pointer(h, g.x, g.y, 0, 0, 1, 0);
  #assert h[0].tooling && !h[0].drag;
  said := hud_test_edit(t[..]);
  // (not on the grid any more: where the pointer is, to the grain two pixels cover there)
  #assert cast(string) said[0..<6] == "place " && hud_test_ends(said, " 1.00 1.00 1.00 0.00 rest") && iabs(hud_test_num(said, 1) - 220) <= 5 && iabs(hud_test_num(said, 2) - 310) <= 5;
  hud_pointer(h, g.x, g.y, 2, 0, 1, 0); #assert !h[0].tooling && hud_test_edit(t[..]) == "";
  // the other mouse button still turns the camera with a tool picked
  yaw := h[0].orbit.yaw;
  hud_pointer(h, 800, 600, 0, 0, 1, 2); hud_pointer(h, 1000, 600, 1, 0, 1, 2); hud_pointer(h, 1000, 600, 2, 0, 1, 2); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbit.yaw != yaw && hud_test_edit(t[..]) == "";
  hud_pointer(h, 800, 600, 0, 0, 1, 2); hud_pointer(h, 600, 600, 1, 0, 1, 2); hud_pointer(h, 600, 600, 2, 0, 1, 2); hud_test_run(t[..], 1, 0.01);
  // free: the plain wire where it would stand; a press sets it down there, at rest, on the ground
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  g = hud_test_point(t[..], 2.2, 0, 3.1);
  #assert h[0].mode == HUD_M_FREE && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + 12 * 6;
  said = hud_test_click(t[..], g);
  #assert cast(string) said[0..<6] == "place " && hud_test_ends(said, " 1.00 1.00 1.00 0.00 rest") && iabs(hud_test_num(said, 1) - 220) <= 5 && iabs(hud_test_num(said, 2) - 310) <= 5;
  // snap: the cell lit under it and the wire flush in it; the place is the cell's middle exactly, wherever in the cell the pointer is
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 0");
  #assert h[0].mode == HUD_M_SNAP && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + (12 + 4) * 6;
  #assert hud_test_click(t[..], g) == "place 2.50 3.50 1.00 1.00 1.00 0.00 rest";
  g = hud_test_point(t[..], 2.95, 0, 3.02); #assert hud_test_click(t[..], g) == "place 2.50 3.50 1.00 1.00 1.00 0.00 rest";
  g = hud_test_point(t[..], -1.3, 0, -0.8); #assert hud_test_click(t[..], g) == "place -1.50 -0.50 1.00 1.00 1.00 0.00 rest";
  // on the top of a thing (the platform, a metre high) it stands on that top
  b := h[0].things[..];
  g = hud_test_point(t[..], -3.3, 1.0, 4.2); #assert hud_test_click(t[..], g) == "place -3.50 4.50 1.00 1.00 1.00 1.00 rest";
  // on a side of a thing (the wall's near face, at z 7.5, off the grid's lines) it stands beside it: the cell before the face still holds some wall, so the one before that
  g = hud_test_point(t[..], 0.3, 0.6, 7.5); #assert hud_test_click(t[..], g) == "place 0.50 6.50 1.00 1.00 1.00 0.00 rest";
  // a cell something stands in: the ghost is faint and crossed out (two more lines), and a press places nothing
  g = hud_test_point(t[..], 2.2, 0, 5.2);
  aim := hud_aim(h); #assert aim.ok && aim.blocked && aim.x == 250 && aim.z == 550 && !aim.clamped;
  #assert hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + (12 + 4 + 2) * 6 && hud_test_click(t[..], g) == "limit room";   // (and the page is told why, to say it in words)
  // free on a side: touching the face, at the thing's foot; free where it would stand in a thing is refused too
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  g = hud_test_point(t[..], 0.3, 0.6, 7.5); said = hud_test_click(t[..], g);
  #assert hud_test_ends(said, " 1.00 1.00 1.00 0.00 rest") && iabs(hud_test_num(said, 1) - 30) <= 5 && iabs(hud_test_num(said, 2) - 700) <= 5;
  g = hud_test_point(t[..], 2.2, 0, 5.2); #assert hud_aim(h).blocked && hud_test_click(t[..], g) == "limit room";
  // the ball tool: three rings; snapped, its cell is as wide as it is (1.2 m); free, the rings alone
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 0");
  g = hud_test_point(t[..], 2.2, 0, 3.1);
  #assert hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + (3 * 24 + 4) * 6 && hud_test_click(t[..], g) == "ball 1.80 3.00 0.60 0.00 rest";
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 2");
  #assert hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + 3 * 24 * 6;
  said = hud_test_click(t[..], g); #assert cast(string) said[0..<5] == "ball " && hud_test_ends(said, " 0.60 0.00 rest") && iabs(hud_test_num(said, 1) - 220) <= 5;
  // the other shapes go the same way, each by its own size: a slab (2 m square, a quarter high: its cell is 2 m) and a pillar (a metre square, 3 m high)
  hud_test_say(h, HUD_TOOL_MSG, "2 0 0 10 0 0");
  g = hud_test_point(t[..], 6.3, 0, -2.4);
  #assert h[0].tool == HUD_T_SLAB && hud_test_click(t[..], g) == "place 7.00 -3.00 2.00 2.00 0.25 0.00 rest";
  hud_test_say(h, HUD_TOOL_MSG, "3 0 0 10 0 0");
  #assert h[0].tool == HUD_T_PILLAR && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + (12 + 4) * 6 && hud_test_click(t[..], g) == "place 6.50 -2.50 1.00 1.00 3.00 0.00 rest";
  hud_test_say(h, HUD_TOOL_MSG, "2 0 0 10 0 2"); said = hud_test_click(t[..], g); #assert cast(string) said[0..<6] == "place " && hud_test_ends(said, " 2.00 2.00 0.25 0.00 rest");
  // a slab onto the platform's top, snapped: on that top
  hud_test_say(h, HUD_TOOL_MSG, "2 0 0 10 0 0");
  g = hud_test_point(t[..], -3.3, 1.0, 4.2); #assert hud_test_click(t[..], g) == "place -3.00 5.00 2.00 2.00 0.25 1.00 rest";
  // a shape that is none is no tool
  hud_test_say(h, HUD_TOOL_MSG, "4 0 0 10 0 0"); #assert h[0].tool == -1;
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 2"); g = hud_test_point(t[..], 2.2, 0, 3.1);
  // a press on one of the page's own things is not the tool's
  hud_test_say(h, HUD_OVER_MSG, "1"); hud_pointer(h, g.x, g.y, 0, 0, 1, 0); #assert !h[0].tooling && hud_test_edit(t[..]) == "";
  hud_test_say(h, HUD_OVER_MSG, "0");
  // a finger places as the mouse does
  hud_pointer(h, g.x, g.y, 0, 1, 9, 0); hud_pointer(h, g.x, g.y, 2, 1, 9, 0);
  said = hud_test_edit(t[..]); #assert cast(string) said[0..<5] == "ball " && !h[0].sticks.look_on && !h[0].sticks.move_on;
  // a mode that is none is free (the old dropping mode's number too); no tool: no ghost
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 7"); #assert h[0].mode == HUD_M_FREE; hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 0"); hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 2"); #assert h[0].mode == HUD_M_FREE;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0");
  #assert h[0].tool == -1 && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare;
}

#test "a ball goes onto things as a block does: set down on a block's top it stays there, beside a block's side it stands at its foot, and a block goes onto a ball; what the chat places appears at its place, never above it" #steps 4000000000 #traversal 600000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  b := h[0].things[..];
  // the ball tool, the pointer on the platform's top (a metre up): the edit's bottom is that top, as the block tool's is, and it is set down at rest
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 1");
  g := hud_test_point(t[..], -3.5, 1.0, 4.5);
  #assert hud_pick(h, true).body == bd_index(b, 1);
  said := hud_test_click(t[..], g);
  #assert cast(string) said[0..<5] == "ball " && hud_test_ends(said, " 0.60 1.00 rest") && iabs(hud_test_num(said, 1) + 350) <= 13 && iabs(hud_test_num(said, 2) - 450) <= 13;   // (to the grain there)
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  blk := hud_test_click(t[..], g); #assert cast(string) blk[0..<6] == "place " && hud_test_ends(blk, " 1.00 1.00 1.00 1.00 rest");
  // the pointer on the platform's near side: beside it, touching the face, at the platform's foot (there is no dropping mode to put it on the top from a side)
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 1");
  g = hud_test_point(t[..], -3.0, 0.5, 3.0);
  side := hud_pick(h, true); #assert side.body == bd_index(b, 1) && side.ny < 0.5;
  said = hud_test_click(t[..], g);
  #assert cast(string) said[0..<5] == "ball " && hud_test_ends(said, " 0.60 0.00 rest") && iabs(hud_test_num(said, 1) + 300) <= 13 && iabs(hud_test_num(said, 2) - 240) <= 13;
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  said = hud_test_click(t[..], g); #assert hud_test_ends(said, " 1.00 1.00 1.00 0.00 rest") && iabs(hud_test_num(said, 2) - 250) <= 13;
  // set down at rest on that top, free and snapped: the bottom is the top, and `rest`
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 1");
  g = hud_test_point(t[..], -2.5, 1.0, 3.5); said = hud_test_click(t[..], g);
  #assert cast(string) said[0..<5] == "ball " && hud_test_ends(said, " 0.60 1.00 rest") && iabs(hud_test_num(said, 1) + 250) <= 13 && iabs(hud_test_num(said, 2) - 350) <= 13;
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 0");
  #assert hud_test_click(t[..], g) == "ball -3.00 3.00 0.60 1.00 rest";
  // the page makes both (their lines, as the page writes them): the one at rest is there at once, asleep; the one the chat placed with no
  // `rest` (2 on its line) is at its place too, on the platform's top and not above it, awake; and a block the chat put on the ground (8) is on the ground at once
  hud_test_say(h, HUD_BLOCKS_MSG, "7\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 1 1 1 -350 100 450 120 120 120 2\n6 1 1 1 -250 100 350 120 120 120 1\n8 0 1 1 900 0 -300 100 100 100 2\n");
  i5 := bd_index(b, 5); #assert d3_eq(b[0].set[0].pos[i5], d3(-3.5, 1.6, 4.5)) && bd_awake(b, i5) && d3_eq(b[0].set[0].pos[bd_index(b, 6)], d3(-2.5, 1.6, 3.5)) && !bd_awake(b, bd_index(b, 6));
  #assert d3_eq(b[0].set[0].pos[bd_index(b, 8)], d3(9, 0.5, -3)) && bd_awake(b, bd_index(b, 8));
  hud_test_run(t[..], 900, 0.01);
  i5 = bd_index(b, 5); p := b[0].set[0].pos[i5];
  #assert !bd_awake(b, i5) && near_d(p.y, 1.6, 0.01) && p.x > -4 && p.x < -2 && p.z > 3 && p.z < 5;
  p6 := b[0].set[0].pos[bd_index(b, 6)]; #assert near_d(p6.y, 1.6, 0.01) && p6.x > -4 && p6.x < -2;
  p8 := b[0].set[0].pos[bd_index(b, 8)]; #assert !bd_awake(b, bd_index(b, 8)) && near_d(p8.y, 0.5, 0.002) && near_d(p8.x, 9, 0.002) && near_d(p8.z, -3, 0.002);
  // a block and a ball onto a ball: the pointer on the starting ball's top (0.6 m across) gives a bottom at its top
  ball := bd_index(b, 4); bp := b[0].set[0].pos[ball];
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  g = hud_test_point(t[..], cast(f32) bp.x, cast(f32) bp.y + 0.3, cast(f32) bp.z);
  #assert hud_pick(h, true).body == ball;
  said = hud_test_click(t[..], g); #assert cast(string) said[0..<6] == "place " && hud_test_ends(said, " 1.00 1.00 1.00 0.60 rest");
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 1");
  said = hud_test_click(t[..], g); #assert cast(string) said[0..<5] == "ball " && hud_test_ends(said, " 0.60 0.60 rest");
  // a ball the chat puts on a ball (awake, at its place) does not stay balanced there: it comes off and rests on the ground beside it (the physics' own)
  hud_test_say(h, HUD_BLOCKS_MSG, "8\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 1 1 1 -350 100 450 120 120 120 2\n6 1 1 1 -250 100 350 120 120 120 1\n8 0 1 1 900 0 -300 100 100 100 2\n7 1 1 1 82 60 301 60 60 60 2\n");
  hud_test_run(t[..], 1200, 0.01);
  p7 := b[0].set[0].pos[bd_index(b, 7)];
  #assert near_d(p7.y, 0.3, 0.02) && p7.x == p7.x;
}

#test "far placement: the tool reaches the whole world; far off the place keeps to a grain and a marker stands over the ghost; over the horizon it is the furthest place that way, and says so; snapping is exact at any distance" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  // the grain: a hundredth near by, coarser with distance, never finer than two pixels of the pointer cover
  #assert hud_grain(5, 2.6, 1440) == 0.01 && hud_grain(12, 2.6, 1440) == 0.1 && hud_grain(40, 2.6, 1440) == 1 && hud_grain(150, 2.6, 1440) == 5 && hud_grain(1000, 2.6, 1440) == 5;
  #assert hud_grain(12, 0.1, 1440) == hud_grain(12, 0.5, 1440) && hud_grain(12, 2.6, 0) == 0.01 && hud_grain(20, 10, 1440) < hud_grain(20, 2, 1440);
  // a pick at long range: the ground 150 m ahead and 30 m to the right is met where it is (the ray reaches it)
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 0");
  g := hud_test_point(t[..], -30.3, 0, 150.4);
  at := hud_pick(h, true); #assert at.hit && at.body < 0 && near(at.x, -30.3, 0.6) && near(at.z, 150.4, 3) && at.ny > 0.99;
  // snapped, the place is the cell's middle exactly, as near by
  aim := hud_aim(h); #assert aim.ok && !aim.clamped && !aim.blocked && (aim.x - 50) % 100 == 0 && (aim.z - 50) % 100 == 0 && iabs(aim.x + 3050) <= 100 && iabs(aim.z - 15050) <= 300;
  said := hud_test_click(t[..], g);
  #assert hud_test_ends(said, " 1.00 1.00 1.00 0.00 rest") && hud_test_num(said, 1) == aim.x && hud_test_num(said, 2) == aim.z;
  // free, it keeps to the grain there: a whole number of them, so the ghost does not shimmer with the pointer; and a marker stands over it (five lines), the block being a few pixels high
  bare := 0; hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0"); bare = hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0);
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  aim = hud_aim(h); #assert aim.ok && !aim.clamped && aim.x % 500 == 0 && aim.z % 500 == 0 && iabs(aim.x + 3030) <= 250 && iabs(aim.z - 15040) <= 400;
  #assert hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + (12 + 5) * 6;
  // one pixel of the pointer aside is the same place
  hud_pointer(h, g.x + 1, g.y, 1, 0, 1, 0); same := hud_aim(h); #assert same.x == aim.x && same.z == aim.z;
  // near by there is no marker
  g = hud_test_point(t[..], 2.2, 0, 3.1); #assert hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + 12 * 6;
  // the pointer over the horizon: nothing is met, and the ghost is the furthest place a thing may stand that way, on the world's bound, with the bar that says so (three lines) and its marker
  hud_pointer(h, 800, 150, 1, 0, 1, 0);
  #assert !hud_pick(h, true).hit;
  aim = hud_aim(h); #assert aim.ok && aim.clamped && !aim.blocked && aim.z == 20000 && iabs(aim.x) < 2000 && aim.y == 0;
  #assert hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + (12 + 3 + 5) * 6;
  said = hud_test_click(t[..], StyOnScreen.{x = 800, y = 150});
  #assert hud_test_ends(said, " 200.00 1.00 1.00 1.00 0.00 rest");
  // (it was brought back from past the bounds: placed, and the page is told the bound, to say it in words)
  #assert hud_test_edit(t[..]) == "limit far";
  // off to one side over the horizon it is where that way leaves the bounds; and the ground past the bounds is brought back to them
  hud_pointer(h, 1500, 150, 1, 0, 1, 0); aim = hud_aim(h); #assert aim.clamped && (aim.x == 20000 || aim.z == 20000) && aim.x > 3000;
  g = hud_test_point(t[..], 10, 0, 260); #assert hud_pick(h, true).hit;
  aim = hud_aim(h); #assert aim.ok && aim.clamped && aim.z == 20000 && iabs(aim.x) < 1500;
  // free, the same reach: a far press sets one down there
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  g = hud_test_point(t[..], -40, 0, 120); said = hud_test_click(t[..], g);
  #assert cast(string) said[0..<6] == "place " && hud_test_ends(said, " 1.00 1.00 1.00 0.00 rest") && iabs(hud_test_num(said, 1) + 4000) <= 250 && iabs(hud_test_num(said, 2) - 12000) <= 500;
  // the world full: the ghost is crossed out and nothing is placed, in any mode
  nk := h[0].nk; h[0].nk = HUD_BLOCKS;
  g = hud_test_point(t[..], 2.2, 0, 3.1);
  #assert hud_aim(h).blocked && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + (12 + 2) * 6 && hud_test_click(t[..], g) == "limit full";
  h[0].nk = nk; #assert !hud_aim(h).blocked;
  #assert hud_room(h, HUD_T_BLOCK, 200, 300) && !hud_room(h, HUD_T_BLOCK, 20050, 0) && !hud_room(h, HUD_T_BLOCK, 0, -20050) && hud_room(h, HUD_T_BLOCK, -20000, 20000);
}

#test "a thing set down at rest is made exactly in its place, asleep, and stays there to the bit beside and on top of others; a push wakes it; far out a dropped thing lands and sleeps and one at rest stays" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  b := h[0].things[..];
  // three set down at rest: two side by side on the ground, touching, and one on top of the first; and a ball at rest
  hud_test_say(h, HUD_BLOCKS_MSG, "8\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 550 0 -350 100 100 100 1\n6 0 1 1 650 0 -350 100 100 100 1\n7 0 1 1 550 100 -350 100 100 100 1\n8 1 1 1 850 0 -350 120 120 120 1\n");
  i5 := bd_index(b, 5); i6 := bd_index(b, 6); i7 := bd_index(b, 7); i8 := bd_index(b, 8);
  #assert bd_count(b) == 8 && !bd_awake(b, i5) && !bd_awake(b, i6) && !bd_awake(b, i7) && !bd_awake(b, i8) && bd_sleeping(b) == 8;
  #assert d3_eq(b[0].set[0].pos[i5], d3(5.5, 0.5, -3.5)) && d3_eq(b[0].set[0].pos[i6], d3(6.5, 0.5, -3.5)) && d3_eq(b[0].set[0].pos[i7], d3(5.5, 1.5, -3.5)) && d3_eq(b[0].set[0].pos[i8], d3(8.5, 0.6, -3.5));
  // ten seconds on: not one has moved by a bit, and all still sleep
  hud_test_run(t[..], 1000, 0.01);
  #assert bd_sleeping(b) == 8 && d3_eq(b[0].set[0].pos[i5], d3(5.5, 0.5, -3.5)) && d3_eq(b[0].set[0].pos[i6], d3(6.5, 0.5, -3.5)) && d3_eq(b[0].set[0].pos[i7], d3(5.5, 1.5, -3.5)) && d3_eq(b[0].set[0].pos[i8], d3(8.5, 0.6, -3.5));
  #assert b[0].set[0].att[i7].w == 1.0 && b[0].set[0].att[i5].w == 1.0;
  // the page is told where they rest: where they were put
  for k: 0..<6 { if hud_action(h) != 0 { hud_action_done(h); } hud_test_run(t[..], 60, 0.01); }
  r7 := hud_test_rest(h, 7); #assert r7[0] == 550 && r7[1] == 100 && r7[2] == -350 && r7[3] == 100 && r7[6] == 0 && r7[7] == 0;
  // the list said again (the page says it now and then) changes nothing: they are not made again or woken
  hud_test_say(h, HUD_BLOCKS_MSG, "8\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 550 0 -350 100 100 100 1\n6 0 1 1 650 0 -350 100 100 100 1\n7 0 1 1 550 100 -350 100 100 100 1\n8 1 1 1 850 0 -350 120 120 120 1\n");
  #assert bd_sleeping(b) == 8 && bd_count(b) == 8;
  // running into the ball set down at rest kicks it: woken as any sleeper is
  h[0].foot.walk.x = 8.5; h[0].foot.walk.z = -5.0; h[0].foot.walk.yaw = 0; h[0].foot.walk.face_off = 0;
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 80, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert b[0].set[0].pos[bd_index(b, 8)].z > -3.2;
  // 200 m out, the world's far corner: one dropped lands on the ground there and sleeps; one at rest beside it never moves
  hud_test_say(h, HUD_BLOCKS_MSG, "10\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 550 0 -350 100 100 100 1\n6 0 1 1 650 0 -350 100 100 100 1\n7 0 1 1 550 100 -350 100 100 100 1\n8 1 1 1 850 0 -350 120 120 120 1\n9 0 1 1 20000 0 -20000 100 100 100\n10 0 1 1 19800 0 -20000 100 100 100 1\n");
  i9 := bd_index(b, 9); i10 := bd_index(b, 10);
  #assert bd_awake(b, i9) && !bd_awake(b, i10) && near_d(b[0].set[0].pos[i9].y, 0.5 + HUD_DROP, 1e-9);
  hud_test_run(t[..], 400, 0.01);
  #assert !bd_awake(b, bd_index(b, 9)) && near_d(b[0].set[0].pos[bd_index(b, 9)].y, 0.5, 0.002) && near_d(b[0].set[0].pos[bd_index(b, 9)].x, 200, 0.01) && near_d(b[0].set[0].pos[bd_index(b, 9)].z, -200, 0.01);
  #assert d3_eq(b[0].set[0].pos[bd_index(b, 10)], d3(198, 0.5, -200)) && !bd_awake(b, bd_index(b, 10));
}

#test "edit mode: a press on a thing selects it, a drag moves it to where it is let go, the wheel on it sizes it, and empty ground lets it go; out of edit mode nothing is selected" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  b := h[0].things[..];
  one := bd_index(b, 1); at := b[0].set[0].pos[one];
  // out of edit mode a press on the block is the camera's
  on := hud_test_point(t[..], cast(f32) at.x, cast(f32) at.y, cast(f32) at.z);
  hud_pointer(h, on.x, on.y, 0, 0, 1, 0);
  #assert h[0].drag && h[0].carry == 0 && hud_test_edit(t[..]) == "";
  hud_pointer(h, on.x, on.y, 2, 0, 1, 0);
  bare := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0);
  // edit mode: the thing under the pointer is drawn, faint; a press selects it (the page is told), and no camera drag begins
  hud_test_say(h, HUD_TOOL_MSG, "-1 1 0 10 0");
  #assert h[0].editing && h[0].sel == 0 && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + 12 * 6;
  hud_pointer(h, on.x, on.y, 0, 0, 1, 0);
  #assert h[0].tooling && !h[0].drag && h[0].carry == 1 && hud_test_edit(t[..]) == "select b1";
  // let go where it was pressed: selected, not moved
  hud_pointer(h, on.x, on.y, 2, 0, 1, 0); #assert h[0].carry == 0 && hud_test_edit(t[..]) == "";
  // the page says it is selected: its box is drawn (bright), and a press on it again says nothing new
  hud_test_say(h, HUD_TOOL_MSG, "-1 1 1 10 0");
  #assert h[0].sel == 1 && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + 12 * 6;
  // the wheel with the pointer on it: a notch bigger, every side alike (2 x 2 x 1 becomes 2.2 x 2.2 x 1.1); the camera does not zoom
  want := h[0].orbit.want;
  hud_test_say(h, HUD_WHEEL_MSG, "-100 0");
  #assert h[0].orbit.want == want && hud_test_edit(t[..]) == "size b1 2.20 2.20 1.10";
  hud_test_say(h, HUD_WHEEL_MSG, "100 0"); #assert hud_test_edit(t[..]) == "size b1 1.82 1.82 0.91";
  // the page sizes it (its sizes count goes up): it is a real body, heavier by the cube of the notch
  light := b[0].set[0].inv_mass[one];
  hud_test_say(h, HUD_BLOCKS_MSG, "4\n1 0 1 2 -300 0 400 220 110 220\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n");
  hud_test_run(t[..], 60, 0.01);
  one = bd_index(b, 1);
  #assert abs(light / b[0].set[0].inv_mass[one] - 1.331) < 0.001;
  // the wheel off the thing zooms the camera, and sizes nothing
  g := hud_test_point(t[..], 2.2, 0, 3.1);
  hud_test_say(h, HUD_WHEEL_MSG, "-100 0"); #assert h[0].orbit.want < want && hud_test_edit(t[..]) == "";
  // held and dragged across the ground, then let go: moved there, on the half metre; while it is dragged its box is drawn where it would go
  at = b[0].set[0].pos[one];
  on = hud_test_point(t[..], cast(f32) at.x, cast(f32) at.y, cast(f32) at.z);
  hud_pointer(h, on.x, on.y, 0, 0, 1, 0);
  #assert h[0].carry == 1 && !hud_dragged(h) && hud_test_edit(t[..]) == "";
  g = hud_test_point(t[..], 3.2, 0, 1.8);
  #assert hud_dragged(h) && hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.0) == bare + 2 * 12 * 6;
  hud_pointer(h, g.x, g.y, 2, 0, 1, 0);
  #assert h[0].carry == 0 && !h[0].tooling && hud_test_edit(t[..]) == "move b1 3.00 2.00";
  // the ball is selected the same way, and sized by its width
  ball := bd_index(b, 4); bp := b[0].set[0].pos[ball];
  on = hud_test_point(t[..], cast(f32) bp.x, cast(f32) bp.y, cast(f32) bp.z);
  hud_pointer(h, on.x, on.y, 0, 0, 1, 0); hud_pointer(h, on.x, on.y, 2, 0, 1, 0);
  #assert hud_test_edit(t[..]) == "select b4";
  hud_test_say(h, HUD_TOOL_MSG, "-1 1 4 10 0");
  hud_test_say(h, HUD_WHEEL_MSG, "-100 0"); #assert hud_test_edit(t[..]) == "size b4 0.66 0.66 0.66";
  // a press on empty ground lets the selection go, and is the camera's to drag
  g = hud_test_point(t[..], 2.2, 0, 3.1);
  hud_pointer(h, g.x, g.y, 0, 0, 1, 0);
  #assert h[0].drag && !h[0].tooling && hud_test_edit(t[..]) == "select none";
  hud_pointer(h, g.x, g.y, 2, 0, 1, 0);
  // a placing tool in edit mode places; edit mode off, the selection is gone and a press on a thing is the camera's again
  hud_test_say(h, HUD_TOOL_MSG, "0 1 4 10 0");
  placed := hud_test_click(t[..], g); #assert cast(string) placed[0..<6] == "place " && hud_test_ends(placed, " 1.00 1.00 1.00 0.00 rest");
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 4 10 0");
  #assert !h[0].editing && h[0].sel == 0;
  hud_pointer(h, on.x, on.y, 0, 0, 1, 0); #assert h[0].drag && h[0].carry == 0 && hud_test_edit(t[..]) == "";
  hud_pointer(h, on.x, on.y, 2, 0, 1, 0);
  // losing the window lets a held thing go, unmoved
  hud_test_say(h, HUD_TOOL_MSG, "-1 1 0 10 0"); hud_pointer(h, on.x, on.y, 0, 0, 1, 0); hud_blur(h);
  #assert h[0].carry == 0 && !h[0].tooling;
}

#test "the tools work in each game type: from above by the pointer, in first person by the middle of the window" #steps 4000000000 {
  t: [2] HudTest;
  // top-down: the pointer's ray from the fixed camera picks the ground and a thing
  h := t[0].h[..];
  hud_test_built(t[0..<1], "2");
  hud_test_say(h, HUD_TOOL_MSG, "0 1 0 10 3");
  g := hud_test_point(t[0..<1], -2.3, 0, -1.2);
  from_top := hud_test_click(t[0..<1], g);
  #assert cast(string) from_top[0..<6] == "place " && iabs(hud_test_num(from_top, 1) + 230) <= 10 && iabs(hud_test_num(from_top, 2) + 120) <= 10;
  hud_test_say(h, HUD_TOOL_MSG, "-1 1 0 10 3");
  b := h[0].things[..]; at := b[0].set[0].pos[bd_index(b, 2)];
  on := hud_test_point(t[0..<1], cast(f32) at.x, cast(f32) (at.y * 2), cast(f32) at.z);
  hud_pointer(h, on.x, on.y, 0, 0, 1, 0); hud_pointer(h, on.x, on.y, 2, 0, 1, 0);
  #assert hud_test_edit(t[0..<1]) == "select b2";
  // first person: wherever the pointer is, the ray is the reticle's: straight ahead and a little down, so the block lands dead ahead
  f := t[1].h[..];
  hud_test_say(f, HUD_KIND_MSG, "1"); hud_test_down(t[1..<2]); hud_test_run(t[1..<2], 200, 0.01);
  hud_test_say(f, HUD_TOOL_MSG, "0 0 0 10 2");
  // with a placing tool picked the first click on the world holds the pointer and places nothing; the ones after it place
  #assert !ml.ml_on(f[0].mouse[0]) && hud_mouselook(f) == ml.ML_FREE;
  hud_pointer(f, 100, 1100, 0, 0, 1, 0); hud_pointer(f, 100, 1100, 2, 0, 1, 0);
  #assert hud_test_edit(t[1..<2]) == "" && !f[0].tooling && hud_mouselook(f) == ml.ML_LOOK;
  hud_pointer_lock(f, 1); #assert ml.ml_on(f[0].mouse[0]);
  hud_pointer(f, 100, 1100, 0, 0, 1, 0); hud_pointer(f, 100, 1100, 2, 0, 1, 0);
  said := hud_test_edit(t[1..<2]);
  #assert said.count > 12 && cast(string) said[0..<11] == "place 0.00 " && said[11] != '-';
  // Escape lets the pointer go (the browser's): the next click holds it again, and places nothing
  hud_pointer_lock(f, 0); hud_test_run(t[1..<2], 2, 0.01);
  hud_pointer(f, 100, 1100, 0, 0, 1, 0); hud_pointer(f, 100, 1100, 2, 0, 1, 0); #assert hud_test_edit(t[1..<2]) == "" && hud_mouselook(f) == ml.ML_LOOK;
  // a browser that refuses to hold it leaves the click the tool's: it places
  hud_pointer_lock(f, 2);
  hud_pointer(f, 100, 1100, 0, 0, 1, 0); hud_pointer(f, 100, 1100, 2, 0, 1, 0); said = hud_test_edit(t[1..<2]); #assert said.count > 12 && cast(string) said[0..<6] == "place ";
  // the reticle's ray has the same reach: looking level at the horizon, the ghost is on the world's bound
  f[0].orbit.pitch = -0.2; hud_test_run(t[1..<2], 2, 0.01);
  far := hud_aim(f); #assert far.ok && far.clamped && far.z == 20000;
}

#test "a thing pressed a little into the ground by a heavy gravity is told as on the ground, and a list with a bottom under the floor still reads to its end: the placing tool keeps placing" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  b := h[0].things[..];
  // five times the gravity, and two blocks placed side by side: every rest the page is told has its bottom at the floor or over it
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 50 0");
  hud_test_say(h, HUD_BLOCKS_MSG, "6\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 -100 0 -250 100 100 100\n6 0 1 1 0 0 -250 100 100 100\n");
  for k: 0..<24 {
    said := hud_test_told(t[..], 20);
    at := 0;
    while at < said.count {
      v: [9] HudRead; for q: 0..<9 { v[q] = hud_read(said, at); at = v[q].at; }
      #assert v[8].ok && v[2].value >= 0;
    }
  }
  #assert bd_count(b) == 6 && bd_sleeping(b) == 6;
  for i: 0..<6 { r := hud_rest(h, i); #assert r[1] >= 0; }
  // a body the solver has left a centimetre in the ground is still said to stand on it
  i5 := bd_index(b, 5); p5 := b[0].set[0].pos[i5];
  bd_place(b, i5, d3(p5.x, 0.5 - 0.03, p5.z), DQ.{}); hud_test_run(t[..], 1, 0.017);
  #assert b[0].set[0].pos[i5].y < 0.494 && hud_rest(h, i5)[1] == 0;
  // and a list that says a bottom under the floor (an older page's) puts the thing on the floor and reads on: the things after it stay, and a new one is made
  hud_test_say(h, HUD_BLOCKS_MSG, "7\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 -100 0 -250 100 100 100\n6 0 1 1 0 -1 -250 100 100 100\n7 0 1 1 200 0 -250 100 100 100\n");
  #assert bd_count(b) == 7 && bd_index(b, 6) >= 0 && bd_index(b, 7) >= 0 && h[0].nk == 7;
  // a line that is no thing (no height) is passed over, and the list still reads to its end
  hud_test_say(h, HUD_BLOCKS_MSG, "8\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 -100 0 -250 100 100 100\n6 0 1 1 0 0 -250 100 0 100\n7 0 1 1 200 0 -250 100 100 100\n8 0 1 1 400 0 -250 100 100 100\n");
  #assert bd_count(b) == 7 && bd_index(b, 6) < 0 && bd_index(b, 7) >= 0 && bd_index(b, 8) >= 0;
}

#test "gravity is the world's setting: things fall by it and wake when it changes, the character's jump is as high as it allows, and a run with a change in it repeats bit for bit" #steps 4000000000 {
  t: [2] HudTest;
  a := t[0].h[..]; c := t[1].h[..];
  // one block dropped from the same height in two worlds, a tenth of gravity and five times it: after the same fifth of a second, fifty times as far
  one := "1\n1 0 1 1 0 600 600 100 100 100\n";
  hud_test_say(a, HUD_BLOCKS_MSG, one); hud_test_say(c, HUD_BLOCKS_MSG, one);
  hud_test_down(t[0..<1]); hud_test_down(t[1..<2]);
  hud_test_say(a, HUD_TOOL_MSG, "-1 0 0 1 0"); hud_test_say(c, HUD_TOOL_MSG, "-1 0 0 50 0");
  #assert near(a[0].grav, 0.1, 0.00001) && c[0].grav == 5 && abs(a[0].things[0].gravity + 0.981) < 0.000001 && abs(c[0].things[0].gravity + 49.05) < 0.000001;
  hud_test_run(t[0..<1], 1, 0.0); hud_test_run(t[1..<2], 1, 0.0);
  ya := a[0].things[0].set[0].pos[0].y; yc := c[0].things[0].set[0].pos[0].y;
  for k: 0..<12 { hud_test_run(t[0..<1], 1, 1.0f32 / 60); hud_test_run(t[1..<2], 1, 1.0f32 / 60); }
  fa := ya - a[0].things[0].set[0].pos[0].y; fc := yc - c[0].things[0].set[0].pos[0].y;
  #assert ya == yc && fa > 0.01 && fc > 0.5 && abs(fc / fa - 50) < 0.01;
  // a number that is no gravity is not taken
  hud_test_say(a, HUD_TOOL_MSG, "-1 0 0 -1 0"); hud_test_say(a, HUD_TOOL_MSG, "-1 0 0 51 0"); hud_test_say(a, HUD_TOOL_MSG, "-1 0 0"); #assert near(a[0].grav, 0.1, 0.00001);
  // the starting things at rest and asleep: the same gravity said again wakes none; another wakes them all
  r: [1] HudTest; h := r[0].h[..];
  hud_test_built(r[..], "0"); hud_test_run(r[..], 300, 0.01);
  b := h[0].things[..];
  #assert bd_sleeping(b) == bd_count(b) && bd_count(b) == 4;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0"); #assert bd_sleeping(b) == 4;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 20 0"); #assert bd_sleeping(b) == 0 && abs(b[0].gravity + 19.62) < 0.000001;
  // the character's jump: the rules' own height under the world's gravity. Normal: 1.67 m; double the gravity: under half of it; half: over twice
  tops: [3] f32; gravs := [3] string.["-1 0 0 10 0", "-1 0 0 20 0", "-1 0 0 5 0"];
  for g: 0..<3 {
    hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(r[..], 200, 0.01);
    hud_test_say(h, HUD_TOOL_MSG, gravs[g]);
    hud_test_say(h, HUD_KEYS_MSG, "16");
    for k: 0..<500 { hud_test_run(r[..], 1, 0.01); if h[0].cy > tops[g] { tops[g] = h[0].cy; } }
    tune := hud_tuning(h);
    #assert near(tops[g], sr_metric_jump(tune), 0.06) && h[0].cy == 0;
  }
  #assert near(tops[0], 1.67, 0.03) && tops[1] < tops[0] * 0.5 && tops[1] > tops[0] * 0.4 && tops[2] > tops[0] * 2 && tops[2] < tops[0] * 2.1;
  // two worlds given the same things, the same pushes and the same change of gravity at the same frame: the engine's digest agrees at every frame
  x: [2] HudTest; same := true;
  for w: 0..<2 { hud_test_say(x[w].h[..], HUD_BLOCKS_MSG, HUD_TEST_START); hud_test_down(x[w..<w + 1]); }
  for k: 0..<500 {
    for w: 0..<2 {
      if k == 150 { hud_test_say(x[w].h[..], HUD_TOOL_MSG, "-1 0 0 3 0"); }
      if k == 300 { hud_test_say(x[w].h[..], HUD_TOOL_MSG, "-1 0 0 42 0"); hud_test_say(x[w].h[..], HUD_KEYS_MSG, "1"); }
      hud_test_run(x[w..<w + 1], 1, 0.01);
    }
    if bd_digest(x[0].h[0].things[..]) != bd_digest(x[1].h[0].things[..]) { same = false; }
  }
  #assert same && x[0].h[0].cz > 5 && bd_digest(x[0].h[0].things[..]) != bd_digest(h[0].things[..]);
}

#test "no gravity at all: nothing falls, a thing in the air hangs and sleeps, a push still moves and wakes things, the character walks as ever and its jump rises to the sky's limit and stops; gravity back, everything falls" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  b := h[0].things[..];
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 0 0");
  #assert h[0].grav == 0 && b[0].gravity == 0.0 && hud_tuning(h).gravity == 0 && bd_sleeping(b) == 0;
  // the things at rest stay exactly where they are, and sleep again; one put in the air hangs where it was put
  was: [4] D3; for i: 0..<4 { was[i] = b[0].set[0].pos[i]; }
  hud_test_say(h, HUD_BLOCKS_MSG, "5\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 -500 200 -300 100 100 100\n");
  five := bd_index(b, 5); up := b[0].set[0].pos[five].y;
  hud_test_run(t[..], 300, 0.01);
  #assert bd_sleeping(b) == 5 && b[0].set[0].pos[five].y == up && up > 2.4;
  for i: 0..<4 { now := b[0].set[0].pos[i]; #assert near_d(now.x, was[i].x, 1e-6) && near_d(now.y, was[i].y, 1e-6) && near_d(now.z, was[i].z, 1e-6); }
  for i: 0..<5 { p := b[0].set[0].pos[i]; #assert p.x == p.x && p.y == p.y && p.z == p.z; }
  // the character runs on the ground as ever (W: ahead), at its speed, and stays on it
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 100, 0.01);
  #assert h[0].cz > 4 && h[0].cy == 0 && near(h[0].foot.walk.speed, 6.9, 0.05);
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 100, 0.01);
  // running into the ball still kicks it, and it wakes: no gravity does not freeze the world
  ball := bd_index(b, 4); bp := b[0].set[0].pos[ball];
  h[0].foot.walk.x = cast(f32) bp.x; h[0].foot.walk.z = cast(f32) bp.z - 1.2; h[0].foot.walk.yaw = 0; h[0].foot.walk.face_off = 0;
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 60, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert bd_awake(b, ball) && b[0].set[0].pos[ball].z > bp.z + 0.3;
  // a jump: it leaves the ground and keeps rising (no fall), to the sky's limit, where it stops and stays
  hud_test_say(h, HUD_KEYS_MSG, "16"); hud_test_run(t[..], 100, 0.01);
  y1 := h[0].cy; hud_test_run(t[..], 100, 0.01);
  #assert y1 > 9 && h[0].cy > y1 + 9 && h[0].foot.jump.vy == 10.6;
  hud_test_run(t[..], 600, 0.01);
  #assert h[0].cy == HUD_SKY && h[0].foot.jump.vy == 0;
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 200, 0.01); #assert h[0].cy == HUD_SKY;
  // gravity back: the character comes down to the ground, and the thing that hung in the air falls to it
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0");
  hud_test_run(t[..], 800, 0.01);
  #assert h[0].cy == 0 && !sr_jump_airborne(h[0].foot.jump) && near_d(b[0].set[0].pos[bd_index(b, 5)].y, 0.5, 0.01);
}

// Space pressed and let go, `frames` frames of a hundredth each for the press and as many for the gap after.
hud_test_space :: (t: [] HudTest, keys: int, frames: int) { h := t[0].h[..]; hud_test_put_keys(h, keys | HUD_KEY_JUMP); hud_test_run(t, frames, 0.01); hud_test_put_keys(h, keys); hud_test_run(t, frames, 0.01); }
hud_test_put_keys :: (h: [] Hud, keys: int) { text: [12] u8; n := hud_test_put(text[..], 0, keys); for i: 0..<n { h[0].inbox[i] = text[i]; } hud_message(h, HUD_KEYS_MSG, n); }

#test "fly mode: one press of Space jumps, two within 0.3 s fly and a slow second does not; flying has no gravity at any setting, flies level at 12 m/s, up on Space and down on Shift, and stops on letting go; two presses again fall, and sinking onto the ground lands" #steps 4000000000 #traversal 600000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  // no air jump in this game type; the side-scroller keeps its own
  #assert hud_tuning(h).air_jumps == 0;
  // one press: a jump, as ever, up to its 1.67 m and down again; never flying
  hud_test_put_keys(h, 16); top: f32 = 0;
  for k: 0..<200 { hud_test_run(t[..], 1, 0.01); if h[0].cy > top { top = h[0].cy; } #assert !h[0].fly.on; }
  hud_test_put_keys(h, 0); hud_test_run(t[..], 50, 0.01);
  #assert near(top, 1.67, 0.05) && h[0].cy == 0 && !sr_jump_airborne(h[0].foot.jump);
  // a second press in the air long after the first: no air jump, and no flight (it lands as it would have)
  hud_test_space(t[..], 0, 20); #assert h[0].cy > 0.5 && !h[0].fly.on;
  y0 := h[0].cy; hud_test_space(t[..], 0, 3); #assert !h[0].fly.on && h[0].foot.jump.vy < 0;
  hud_test_run(t[..], 150, 0.01); #assert h[0].cy == 0;
  // two presses 0.31 s apart: the second is too late (a jump each); 0.2 s apart: flying, where the first press's jump had carried it
  hud_test_space(t[..], 0, 3); hud_test_run(t[..], 25, 0.01); hud_test_space(t[..], 0, 3); #assert !h[0].fly.on;
  hud_test_run(t[..], 200, 0.01); #assert h[0].cy == 0;
  hud_test_space(t[..], 0, 5); hud_test_space(t[..], 0, 5);
  #assert h[0].fly.on && h[0].cy > 0.3 && sr_jump_airborne(h[0].foot.jump);
  // it hangs: no gravity, at the world's own, at none and at five times it
  gravs := [3] string.["-1 0 0 10 0", "-1 0 0 0 0", "-1 0 0 50 0"];
  for g: 0..<3 { hud_test_say(h, HUD_TOOL_MSG, gravs[g]); y := h[0].cy; hud_test_run(t[..], 100, 0.01); #assert h[0].cy == y && h[0].fly.on && h[0].foot.jump.vy == 0; }
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0");
  // Space held: up at 8 m/s; let go: it stops at once; Shift held: down at 8 m/s; Shift is nothing but that
  y1 := h[0].cy; hud_test_put_keys(h, 16); hud_test_run(t[..], 100, 0.01);
  #assert near(h[0].cy - y1, 8.0, 0.1) && h[0].fly.on;
  hud_test_put_keys(h, 0); y2 := h[0].cy; hud_test_run(t[..], 30, 0.01); #assert h[0].cy == y2;
  hud_test_put_keys(h, HUD_KEY_DOWN); hud_test_run(t[..], 50, 0.01); #assert near(y2 - h[0].cy, 4.0, 0.05) && h[0].fly.on;
  hud_test_put_keys(h, 0);
  // W: level, ahead, at 12 m/s (1.74 times its run) from the first frame; let go: stopped the next frame; a diagonal is no faster
  z0 := h[0].cz; y3 := h[0].cy;
  hud_test_put_keys(h, 1); hud_test_run(t[..], 100, 0.01);
  #assert near(h[0].cz - z0, 12.0, 0.15) && h[0].cy == y3 && near(h[0].foot.walk.speed, 12.0, 0.01);
  hud_test_put_keys(h, 0); z1 := h[0].cz; hud_test_run(t[..], 20, 0.01); #assert h[0].cz == z1 && h[0].foot.walk.speed == 0;
  hud_test_put_keys(h, 1 | 8); hud_test_run(t[..], 10, 0.01); #assert near(h[0].foot.walk.speed, 12.0, 0.01); hud_test_put_keys(h, 0); hud_test_run(t[..], 2, 0.01);
  // (taps shorter than a frame count: each told as it happens, a press and its release before the next frame)
  // the page is told it flies
  for k: 0..<4 { if hud_action(h) != 0 { hud_action_done(h); } hud_test_run(t[..], 30, 0.01); }
  #assert h[0].told_fly;
  // two quick presses again: it falls under the world's gravity and lands on the ground, on foot
  hud_test_space(t[..], 0, 5); hud_test_space(t[..], 0, 5);
  #assert !h[0].fly.on && sr_jump_airborne(h[0].foot.jump);
  hud_test_run(t[..], 400, 0.01); #assert h[0].cy == 0 && !sr_jump_airborne(h[0].foot.jump) && !h[0].fly.on;
  // flying again, then Shift all the way down: touching the ground while sinking ends the flight, and it stands
  hud_test_space(t[..], 0, 5); hud_test_space(t[..], 0, 5); #assert h[0].fly.on;
  hud_test_put_keys(h, 16); hud_test_run(t[..], 50, 0.01); hud_test_put_keys(h, HUD_KEY_DOWN); hud_test_run(t[..], 200, 0.01);
  #assert !h[0].fly.on && h[0].cy == 0 && !sr_jump_airborne(h[0].foot.jump);
  hud_test_put_keys(h, 0); hud_test_run(t[..], 10, 0.01);
  // two taps each made and let go between two frames (the page tells the keys as they change): still two presses, and it flies
  hud_test_put_keys(h, 16); hud_test_put_keys(h, 0); hud_test_run(t[..], 8, 0.016); #assert !h[0].fly.on && h[0].cy > 0;
  hud_test_put_keys(h, 16); hud_test_put_keys(h, 0); hud_test_run(t[..], 1, 0.016); #assert h[0].fly.on;
  hud_test_put_keys(h, 16); hud_test_put_keys(h, 0); hud_test_put_keys(h, 16); hud_test_put_keys(h, 0); hud_test_run(t[..], 1, 0.016); #assert !h[0].fly.on;
  hud_test_run(t[..], 200, 0.01); #assert h[0].cy == 0;
  // flying level along the ground does not end it
  hud_test_space(t[..], 0, 5); hud_test_space(t[..], 0, 5);
  hud_test_put_keys(h, HUD_KEY_DOWN); hud_test_run(t[..], 100, 0.01); #assert !h[0].fly.on;   // (sunk onto the ground: over)
  hud_test_put_keys(h, 0); hud_test_run(t[..], 5, 0.01);
  // the hotbar's "fly": the page's count of its presses, first told as it is (nothing), then one more each press: on, off, and on again
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 0 0 4"); hud_test_run(t[..], 2, 0.01); #assert !h[0].fly.on;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 0 0 5"); hud_test_run(t[..], 2, 0.01); #assert h[0].fly.on;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 0 0 5"); hud_test_run(t[..], 2, 0.01); #assert h[0].fly.on;   // (told again, the same: nothing)
  hud_test_put_keys(h, 16); hud_test_run(t[..], 30, 0.01); hud_test_put_keys(h, 0); #assert h[0].cy > 1;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 0 0 6"); hud_test_run(t[..], 2, 0.01); #assert !h[0].fly.on;
  hud_test_run(t[..], 300, 0.01); #assert h[0].cy == 0;
}

#test "flying still meets the world: a block stops it and it lands on a block's top; it only nudges things; the side-scroller does not fly and keeps its air jump; leaving the world ends it" #steps 4000000000 #traversal 600000000 {
  t: [2] HudTest; h := t[0].h[..];
  hud_test_built(t[0..<1], "0");
  b := h[0].things[..];
  // up, then ahead into the wall (6 m wide, 2 m high, its near face at z 7.5): it is stopped there
  hud_test_space(t[0..<1], 0, 5); hud_test_space(t[0..<1], 0, 5); #assert h[0].fly.on;
  h[0].foot.walk.x = 0; h[0].foot.walk.z = 4;
  hud_test_put_keys(h, 1); hud_test_run(t[0..<1], 150, 0.01);
  #assert h[0].cz < 7.5 - HUD_BODY + 0.05 && h[0].cz > 6.5 && h[0].fly.on;
  // over it: up 3 m, ahead until over the wall, then Shift: it comes down on the wall's top (2 m), and that is a landing
  hud_test_put_keys(h, 16); hud_test_run(t[0..<1], 40, 0.01);
  hud_test_put_keys(h, 1); hud_test_run(t[0..<1], 8, 0.01); hud_test_put_keys(h, 0); hud_test_run(t[0..<1], 2, 0.01);
  #assert h[0].cz > 7.6 && h[0].cz < 8.4 && h[0].cy > 2.5;
  hud_test_put_keys(h, HUD_KEY_DOWN); hud_test_run(t[0..<1], 100, 0.01); hud_test_put_keys(h, 0); hud_test_run(t[0..<1], 5, 0.01);
  #assert !h[0].fly.on && near(h[0].cy, 2.0, 0.01) && !sr_jump_airborne(h[0].foot.jump);
  // flying into the ball just over the ground: it is nudged at most, never kicked as a run kicks it
  ball := bd_index(b, 4); bp := b[0].set[0].pos[ball];
  h[0].foot.walk.x = cast(f32) bp.x; h[0].foot.walk.z = cast(f32) bp.z - 1.5; h[0].foot.jump.y = 0; h[0].foot.jump.on_ground = true;
  hud_test_run(t[0..<1], 5, 0.01);
  hud_test_space(t[0..<1], 0, 2); hud_test_space(t[0..<1], 0, 2); #assert h[0].fly.on && h[0].cy < 0.55;
  hud_test_put_keys(h, 1); fastest := 0.0;
  for k: 0..<40 { hud_test_run(t[0..<1], 1, 0.01); fastest = fmax(fastest, d3_len(b[0].set[0].vel[bd_index(b, 4)])); }
  hud_test_put_keys(h, 0);
  // (at most the fifth of its flying speed a ball is struck with, times the ball's 1.55: under 4 m/s, where a run sends it off at over 10)
  #assert fastest < 4.0 && h[0].fly.on;
  // the side-scroller: two quick presses are a jump and its air jump, never flight
  s := t[1].h[..];
  hud_test_built(t[1..<2], "3");
  #assert hud_tuning(s).air_jumps == 1;
  hud_test_space(t[1..<2], 0, 5); hud_test_space(t[1..<2], 0, 5);
  #assert !s[0].fly.on && s[0].foot.jump.air_used == 1;
  hud_test_run(t[1..<2], 300, 0.01); #assert s[0].cy == 0;
  // leaving the world ends a flight
  hud_test_say(h, HUD_VIEW_MSG, "2");
  h[0].foot.jump.y = 0; h[0].foot.jump.on_ground = true; hud_test_run(t[0..<1], 20, 0.01);
  hud_test_space(t[0..<1], 0, 3); hud_test_space(t[0..<1], 0, 3);
  hud_test_say(h, HUD_VIEW_MSG, "0"); hud_test_run(t[0..<1], 5, 0.01); #assert !h[0].fly.on;
}

#test "leaving the world takes the camera back to the page's view, and the world comes up again behind the character" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_world(t[..]);
  hud_pointer(h, 100, 600, 0, 0, 1, 0); hud_pointer(h, 900, 300, 1, 0, 1, 0); hud_pointer(h, 900, 300, 2, 0, 1, 0);
  hud_test_say(h, HUD_WHEEL_MSG, "-400 0");
  hud_test_run(t[..], 50, 0.01);
  #assert hud_camera(h, 1200, 2).yaw > 2 && h[0].orbit.want < HUD_WORLD_FAR;
  // home: on the way up it is part of the way between the two, turning back; then exactly the page's view
  hud_test_say(h, HUD_VIEW_MSG, "0");
  hud_test_run(t[..], 25, 0.01);
  part := hud_camera(h, 1200, 2);
  #assert h[0].orbiting && part.yaw > 0.1 && part.yaw < 2 && part.pitch < -0.4 && part.y > 5;
  hud_test_run(t[..], 900, 0.01);
  home := hud_camera(h, 1200, 2);
  #assert !h[0].orbiting && h[0].zoom == 0 && home.yaw == 0 && home.pitch == -1.5707963 && home.x == 0 && near(home.y, 15, 0.001) && near(home.z, 0, 0.0001);
  // the world again: the orbit starts over, behind the character and looking the way W runs
  hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 1, 0.01);
  #assert h[0].orbiting && near(h[0].orbit.yaw, -HUD_PI, 0.0001) && h[0].orbit.want == HUD_WORLD_FAR && h[0].orbit.pitch == HUD_WORLD_PITCH;
  // on the way down it has not turned: the same pitch a step, lower each frame, never through the floor
  last := hud_camera(h, 1200, 2).y; fell := true;
  for k: 0..<500 { hud_test_run(t[..], 1, 0.01); c := hud_camera(h, 1200, 2); if c.y > last + 0.0001 || c.yaw != 0 || c.y < 1 { fell = false; } last = c.y; }
  #assert fell && h[0].zoom == 1;
}

#test "the grass spreads from the character's feet to the horizon in two seconds, from where it stood, steadily up the screen, and goes when the world is left" #steps 2000000000 {
  // the front: nothing at the start, the horizon at two seconds and after, always further
  #assert hud_front(0) == 0 && hud_front(-1) == 0 && hud_front(HUD_SPREAD) == HUD_HORIZON && hud_front(HUD_SPREAD + 3) == HUD_HORIZON && HUD_SPREAD == 2;
  last: f32 = 0;
  for k: 1..<201 { f := hud_front(cast(f32) k * 0.01); #assert f > last && f <= HUD_HORIZON; last = f; }
  // steadily on the screen: the reciprocal of its distance from the camera falls evenly with time
  a := 1 / (hud_front(0.4) + HUD_WORLD_FAR); b := 1 / (hud_front(0.8) + HUD_WORLD_FAR); c := 1 / (hud_front(1.2) + HUD_WORLD_FAR); e := 1 / (hud_front(1.6) + HUD_WORLD_FAR);
  #assert near(a - b, b - c, 0.00001) && near(b - c, c - e, 0.00001) && near(hud_front(1.0), 8.676, 0.01) && hud_front(0.4) > 1.5 && hud_front(0.4) < 3;
  #assert hud_front_edge(0) == HUD_FRONT && hud_front_edge(100) > hud_front_edge(10);
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  u := t[0].u[..];
  hud_test_run(t[..], 30, 0.01);
  #assert h[0].spread == 0 && hud_grass(h) == 0 && u[STY_U_REVEAL + 2] == 0;
  // the world comes up while it stands at (3, 2): the grass starts there, and stays there when it runs off
  h[0].foot.walk.x = 3; h[0].foot.walk.z = 2;
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 1, 0.01);
  #assert h[0].from_x == 3 && h[0].from_z == 2 && u[STY_U_REVEAL] == 3 && u[STY_U_REVEAL + 1] == -2 && u[STY_U_REVEAL + 2] > 0 && u[STY_U_REVEAL + 2] < 0.1 && u[STY_U_REVEAL + 3] > HUD_FRONT;
  #assert hud_grass(h) == HUD_GRASS_COLS * HUD_GRASS_ROWS && u[STY_U_GRASS + 3] == HUD_GRASS_COLS && u[STY_U_GRASS_INFO] == HUD_GRASS_ROWS && u[STY_U_GRASS_INFO + 3] == 60;
  hud_test_say(h, HUD_KEYS_MSG, "8");
  was: f32 = 0; grew := true;
  for k: 0..<189 { hud_test_run(t[..], 1, 0.01); if !(u[STY_U_REVEAL + 2] > was) { grew = false; } was = u[STY_U_REVEAL + 2]; }
  // 1.9 seconds in: still short of the horizon, still spreading from where it began; the wind blows, the character parts it
  #assert grew && h[0].cx > 6 && u[STY_U_REVEAL] == 3 && u[STY_U_REVEAL + 1] == -2 && was > 60 && was < HUD_HORIZON && u[STY_U_REVEAL + 3] > 0;
  #assert u[STY_U_WIND + 2] == 0.3 && near(u[STY_U_WIND], 0.8, 0.0001) && u[STY_U_WIND + 3] == 3 && near(u[STY_U_MOVER], h[0].cx, 0.0001) && near(u[STY_U_MOVER + 1], -h[0].cz, 0.0001) && near(u[STY_U_MOVER + 2], HUD_PART, 0.0001);
  // the field lies ahead of the eye and round it
  view := hud_camera(h, 1200, 2);
  #assert u[STY_U_GRASS] < view.x - 38 && u[STY_U_GRASS] + cast(f32) HUD_GRASS_COLS * u[STY_U_GRASS + 2] > view.x + 38 && u[STY_U_GRASS + 1] < view.z - 70 && near(u[STY_U_GRASS + 1] + cast(f32) HUD_GRASS_ROWS * u[STY_U_GRASS + 2], view.z + HUD_GRASS_BEHIND, 0.01);
  // two seconds: it has reached the horizon, and there is no reveal left: the whole world is grass
  hud_test_run(t[..], 12, 0.01);
  #assert h[0].spread == HUD_SPREAD && u[STY_U_REVEAL + 3] == 0 && hud_grass(h) == HUD_GRASS_COLS * HUD_GRASS_ROWS && near(u[STY_U_BARE_LINE], 0.17, 0.0001);
  // the world's haze is in: from 16 m, the horizon's colour
  #assert u[STY_U_HAZE_INFO] == 20 && near(u[STY_U_HAZE + 3], 0.012, 0.0001) && u[STY_U_HAZE + 2] == u[STY_U_HORIZON + 2] && u[STY_U_HAZE] == u[STY_U_HORIZON];
  hud_test_run(t[..], 300, 0.01);
  #assert h[0].spread == HUD_SPREAD && u[STY_U_REVEAL + 3] == 0;
  // leaving the world, it goes back to the bare floor within a second
  hud_test_say(h, HUD_VIEW_MSG, "0");
  hud_test_run(t[..], 50, 0.01);
  #assert h[0].spread > 0 && h[0].spread < HUD_SPREAD && u[STY_U_REVEAL + 3] > 0 && u[STY_U_REVEAL + 2] < HUD_HORIZON;
  hud_test_run(t[..], 60, 0.01);
  #assert h[0].spread == 0 && hud_grass(h) == 0 && u[STY_U_REVEAL + 2] == 0 && u[STY_U_REVEAL + 3] > 0;
}

#test "the character is the engine's ghost: one blended draw, its skinned vertices where it stands, facing the way it goes; and its clip is what it is doing" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  home := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.016);
  hud_test_say(h, HUD_VIEW_MSG, "1");
  hud_test_run(t[..], 200, 0.016);
  #assert h[0].ghost_draw == -1 && hud_draw_count(h) == 1 && !h[0].ghost[0].ready && h[0].tris_n == 0;
  // the world, the camera already down (its descent is checked above)
  hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  h[0].foot.walk.x = 4; h[0].foot.walk.z = 7;
  n := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.016);
  g := h[0].ghost[..];
  #assert g[0].ready && g[0].clip == GHOST_IDLE && h[0].tris_n == g[0].nt * 3 && hud_draw_count(h) == 2 && h[0].ghost_draw == 1;
  // its draw is the last: its triangles in order from the `tris` store, marked as the character's, blended as the engine's ghost
  #assert h[0].host_draws[4] == 0 && h[0].host_draws[5] == cast(u32) (g[0].nt * 3) && h[0].host_draws[6] == (0x80000000 | HUD_GHOST_AT) && h[0].host_draws[7] == 1;
  #assert hud_draw_blend(h, 1) == 2 && hud_draw_blend(h, 0) == 0 && hud_draw_blend(h, 2) == 0;
  #assert hud_store_bytes(h, 3) == g[0].nv * HUD_SKIN_FLOATS * 4 && hud_store_bytes(h, 4) == g[0].nt * 12 && hud_store_version(h, 4) == 1 && hud_store_version(h, 3) > 0;
  for i: 0..<h[0].tris_n { #assert cast(int) h[0].tris[i] < g[0].nv; }
  // every skinned vertex is within the figure's reach of where it stands (the engine's z is the page's, turned), with a unit normal,
  // and the figure stands in the window's middle, a little under two metres tall
  loy: f32 = 9999; hiy: f32 = -9999; top: f32 = 9999; foot: f32 = -9999;
  for i: 0..<g[0].nv {
    o := i * HUD_SKIN_FLOATS;
    #assert abs(h[0].skin[o] - 4) < 1.2 && abs(h[0].skin[o + 2] + 7) < 1.2 && h[0].skin[o + 1] > -0.1 && h[0].skin[o + 1] < 2.1;
    l := h[0].skin[o + 3] * h[0].skin[o + 3] + h[0].skin[o + 4] * h[0].skin[o + 4] + h[0].skin[o + 5] * h[0].skin[o + 5];
    #assert l > 0.97 && l < 1.03;
    if h[0].skin[o + 1] < loy { loy = h[0].skin[o + 1]; } if h[0].skin[o + 1] > hiy { hiy = h[0].skin[o + 1]; }
    s := sty_project(t[0].u[..], h[0].skin[o], h[0].skin[o + 1], h[0].skin[o + 2]);
    #assert s.ahead && s.x > 560 && s.x < 1040 && s.y > 300 && s.y < 900;
    if s.y < top { top = s.y; } if s.y > foot { foot = s.y; }
  }
  #assert hiy - loy > 1.6 && hiy - loy < 2.0 && loy < 0.1 && foot - top > 180 && foot - top < 420;
  // a ghost here: no livery, so no colour goes with its vertices
  #assert g[0].livery < 0 && h[0].skin[6] == 0 && h[0].skin[7] == 0 && h[0].skin[8] == 0 && !hud_hero(h);
  // turned a quarter to face the page's +x, each vertex has gone a quarter round it: what was ahead of it is to its right
  h[0].face = 0; hud_skin(h);
  ax := h[0].skin[0] - 4; az := h[0].skin[2] + 7; nx := h[0].skin[3]; nz := h[0].skin[5];
  h[0].face = 1.5707963; hud_skin(h);
  #assert near(h[0].skin[0] - 4, -az, 0.0001) && near(h[0].skin[2] + 7, ax, 0.0001) && near(h[0].skin[3], -nz, 0.0001) && near(h[0].skin[5], nx, 0.0001);
  // running, it plays the run; in the air, the air loop; landed on the spot, the landing
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 3, 0.05);
  #assert g[0].clip == GHOST_RUN;
  hud_test_say(h, HUD_KEYS_MSG, "16"); hud_test_run(t[..], 3, 0.05);
  #assert g[0].clip == GHOST_AIR && h[0].cy > 0;
  h[0].bare = true; hud_test_run(t[..], 14, 0.05); h[0].bare = false;
  #assert h[0].foot.jump.on_ground && h[0].foot.walk.speed < 1;
  hud_test_run(t[..], 1, 0.05);
  #assert g[0].clip == GHOST_LAND || g[0].clip == GHOST_IDLE;
  // and it fades out with the camera's rise when the world is left, and is gone at the top
  hud_test_say(h, HUD_VIEW_MSG, "0");
  mid := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.05);
  #assert h[0].ghost_draw == 1 && t[0].u[HUD_U_PAGE + 1] < 1 && t[0].u[HUD_U_PAGE + 1] > 0;
  h[0].bare = true; hud_test_run(t[..], 900, 0.016); h[0].bare = false;
  gone := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.016);
  #assert h[0].zoom == 0 && h[0].ghost_draw == -1 && hud_draw_count(h) == 1;
  // no stroke is the character's any more: every vertex written is a stroke
  for v: 0..<gone { #assert t[0].out[v * HUD_FLOATS + 7] > 0; }
}

// A thing's line for message 105 is "ID KIND MOVES SIZES X Y Z W H D".
HUD_TEST_START :: "4\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n";
// The world shown and the camera down, so time runs for the things.
hud_test_down :: (t: [] HudTest) { h := t[0].h[..]; hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1; h[0].bare = true; }
// The lowest point of any thing.
hud_test_low :: (h: [] Hud) -> f64 { b := h[0].things[..]; low := 1e300; for i: 0..<bd_count(b) { low = fmin(low, b[0].set[0].pos[i].y - bd_extent(b, i).y); } return low; }
// What the page was last told of the rest of the thing with this id: x, y, z, w, h, d, turn, tipped.
hud_test_rest :: (h: [] Hud, id: int) -> [HUD_REST] int { none: [HUD_REST] int; t := hud_known(h, id); return ifx t < 0 || !h[0].known[t].said then none else h[0].known[t].rest; }
// What the page is told next of rests, taken; "" when nothing is.
hud_test_told :: (t: [] HudTest, frames: int) -> string {
  h := t[0].h[..];
  for k: 0..<frames {
    hud_test_run(t, 1, 0.01);
    if hud_action(h) == HUD_SETTLED { n := hud_outbox_len(h); for i: 0..<n { t[0].told[i] = h[0].outbox[i]; } hud_action_done(h); return cast(string) t[0].told[0..<n]; }
    if hud_action(h) != 0 { hud_action_done(h); }
  }
  return "";
}

#test "the page's things are read (105): each is a body of the engine's, put a little above its place; a bad line ends the list; they are drawn only in the world, as the kit's boxes and balls" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  hud_test_say(h, HUD_BLOCKS_MSG, "4\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 50 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n");
  #assert bd_count(b) == 4 && b[0].id[0] == 1 && b[0].id[1] == 2 && b[0].id[2] == 3 && b[0].id[3] == 4 && h[0].nk == 4;
  // a square is a metre: the first is 2 m wide round x = -3 and z = 4, 1 m high, a block of 1200 kg, its bottom HUD_DROP above the floor it is to rest on
  #assert d3_eq(b[0].half[0], d3(1, 0.5, 1)) && d3_eq(s[0].pos[0], d3(-3, 0.5 + HUD_DROP, 4)) && near_d(s[0].mass[0], 2 * 1 * 2 * HUD_DENSITY, 1e-9) && b[0].kind[0] == Bd_Kind.box && b[0].friction[0] == HUD_FRICTION && b[0].bounce[0] == HUD_BOUNCE;
  // each one that came with it a fifth of the drop higher, so they land in turn; the third's own bottom is half a metre up
  #assert near_d(s[0].pos[1].y, 1.5 + HUD_DROP * 1.2, 1e-9) && near_d(s[0].pos[2].y, 0.5 + 1 + HUD_DROP * 1.4, 1e-9) && d3_eq(b[0].half[2], d3(3, 1, 0.5)) && s[0].pos[2].z == 8;
  // the ball: 0.6 m across, 4.5 kg, with its own friction, bounce and rolling resistance
  #assert b[0].kind[3] == Bd_Kind.ball && b[0].half[3].x == 0.3 && near_d(s[0].pos[3].y, 0.3 + HUD_DROP * 1.6, 1e-9) && near_d(s[0].mass[3], 4.5239, 0.001) && b[0].roll[3] == HUD_BALL_ROLL && b[0].bounce[3] == HUD_BALL_BOUNCE && b[0].friction[3] == HUD_BALL_FRICTION;
  // to the character they are the engine's colliders where they are: three boxes by their corners, and a ball
  o := h[0].boxes[..];
  #assert h[0].nb == 3 && h[0].nc == 1 && h[0].nh == 0 && o[0] == -4 && o[1] == 3 && o[2] == 3 && o[3] == -2 && o[4] == 4 && o[5] == 5;
  #assert near(h[0].balls[0], 0.8, 0.0001) && near(h[0].balls[1], 0.3 + HUD_DROP * 1.6, 0.0001) && h[0].balls[2] == 3 && h[0].balls[3] == h[0].balls[0] && near(h[0].balls[6], 0.3, 0.0001);
  h[0].bare = true;
  bare := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.016);
  // at the home page nothing stands on the floor, and no time passes for the things
  #assert hud_draw_count(h) == 1 && h[0].mesh_n == 6 && b[0].steps == 0;
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 15, 0.016);
  // as the camera comes down they are drawn, hanging where they are to fall from: 36 vertices a block, 588 the ball, one opaque draw after the ground's
  #assert h[0].zoom > 0.3 && h[0].zoom < 0.8 && b[0].steps == 0 && h[0].mesh_n == 6 + 3 * 36 + HUD_BALL_VERTICES && hud_draw_count(h) == 2 && hud_store_bytes(h, 0) == (6 + 108 + 588) * 48;
  #assert h[0].host_draws[4] == 6 && h[0].host_draws[5] == 108 + 588 && h[0].host_draws[6] == 0x80000001 && h[0].host_draws[7] == 1 && hud_draw_blend(h, 1) == 0;
  // the first block's vertices: the kit's smooth stone, inside its box up there, the page's z turned to the engine's, each with a unit normal
  for v: 6..<42 {
    m := v * ARCH_VERTEX_FLOATS;
    #assert h[0].mesh[m + 6] == ARCH_M_SMOOTH && h[0].mesh[m] >= -4 && h[0].mesh[m] <= -2 && h[0].mesh[m + 1] >= 3 && h[0].mesh[m + 1] <= 4 && h[0].mesh[m + 2] >= -5 && h[0].mesh[m + 2] <= -3;
    #assert near(h[0].mesh[m + 3] * h[0].mesh[m + 3] + h[0].mesh[m + 4] * h[0].mesh[m + 4] + h[0].mesh[m + 5] * h[0].mesh[m + 5], 1, 0.001) && h[0].mesh[m + 9] > 0.5;
  }
  #assert h[0].records[HUD_RECORD_FLOATS] == 0 && h[0].records[HUD_RECORD_FLOATS + 2] == 0 && h[0].records[HUD_RECORD_FLOATS + 4] == 1;
  // the camera down, they fall, land in turn and come to rest: each at its half height on the floor (the third fell its half metre too), asleep
  low := 9.0;
  for k: 0..<400 { hud_test_run(t[..], 1, 0.016); low = fmin(low, hud_test_low(h)); }
  #assert h[0].zoom == 1 && bd_sleeping(b) == 4 && low > -0.002;
  // (a landing shifts a tall or a long block a centimetre or so)
  #assert near_d(s[0].pos[0].y, 0.5, 0.002) && near_d(s[0].pos[1].y, 1.5, 0.002) && near_d(s[0].pos[2].y, 1.0, 0.002) && near_d(s[0].pos[3].y, 0.3, 0.001) && near_d(s[0].pos[0].x, -3, 0.02) && near_d(s[0].pos[2].z, 8, 0.03);
  #assert near(o[1], 0, 0.002) && near(o[4], 1, 0.002) && near(h[0].balls[1], 0.3, 0.001);
  for v: 6..<42 { y := h[0].mesh[v * ARCH_VERTEX_FLOATS + 1]; #assert y > -0.002 && y < 1.002; }
  // the ball's vertices: on its round about its middle, facing out, pale with a dark band
  dark := 0; pale := 0;
  for v: 6 + 108..<6 + 108 + HUD_BALL_VERTICES {
    m := v * ARCH_VERTEX_FLOATS;
    dx := h[0].mesh[m] - 0.8; dy := h[0].mesh[m + 1] - 0.3; dz := h[0].mesh[m + 2] + 3;
    #assert near(sqrt(dx * dx + dy * dy + dz * dz), 0.3, 0.001) && near(dx * h[0].mesh[m + 3] + dy * h[0].mesh[m + 4] + dz * h[0].mesh[m + 5], 0.3, 0.001);
    if h[0].mesh[m + 9] < 0.5 { dark += 1; } else { pale += 1; }
  }
  // (the band is the ring of vertices round its middle: three of each of the 28 quads that meet there)
  #assert dark == 84 && pale == HUD_BALL_VERTICES - 84;
  // asleep, nothing is sent again; a change of the list is
  g := hud_store_version(h, 0);
  hud_test_run(t[..], 10, 0.016);
  #assert hud_store_version(h, 0) == g && !h[0].moved;
  hud_test_say(h, HUD_BLOCKS_MSG, "0\n");
  none := hud_frame(h, t[0].out[..], t[0].u[..], 1600, 1200, 2, 0.016);
  #assert bd_count(b) == 0 && h[0].nb == 0 && h[0].nc == 0 && h[0].mesh_n == 6 && hud_draw_count(h) == 1 && hud_store_version(h, 0) != g;
  hud_test_say(h, HUD_BLOCKS_MSG, "3\n1 0 1 1 0 0 300 200 100 200\n1 2 3\n3 0 1 1 0 0 900 100 100 100\n"); #assert bd_count(b) == 1 && b[0].id[0] == 1 && h[0].nk == 1;
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n1 0 1 1 0 0 300 200 0 200\n"); #assert bd_count(b) == 0;      // no height: not a thing
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 2 1 1 0 0 300 200 100 200\n"); #assert bd_count(b) == 0;    // nor is a kind that is neither
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 -5 300 200 100 200\n"); #assert bd_count(b) == 1 && near_d(s[0].pos[0].y, 0.5 + HUD_DROP, 1e-9);   // one said under the floor is put on it
  hud_test_say(h, HUD_BLOCKS_MSG, "0\n"); #assert bd_count(b) == 0;
  hud_test_say(h, HUD_BLOCKS_MSG, "999\n"); #assert bd_count(b) == 0;
  hud_test_say(h, HUD_BLOCKS_MSG, "x"); #assert bd_count(b) == 0;
  // balls are things like any other: as many as the list says, up to the one cap; and a thousand balls fit the mesh
  hud_test_say(h, HUD_BLOCKS_MSG, "10\n1 1 1 1 0 0 0 60 60 60\n2 1 1 1 100 0 0 60 60 60\n3 1 1 1 200 0 0 60 60 60\n4 1 1 1 300 0 0 60 60 60\n5 1 1 1 400 0 0 60 60 60\n6 1 1 1 500 0 0 60 60 60\n7 1 1 1 600 0 0 60 60 60\n8 1 1 1 700 0 0 60 60 60\n9 1 1 1 800 0 0 60 60 60\n10 0 1 1 900 0 0 100 100 100\n");
  #assert bd_count(b) == 10 && b[0].id[9] == 10 && b[0].kind[9] == Bd_Kind.box && h[0].nc == 9 && h[0].nk == 10;
  #assert 6 + HUD_BALL_NEAR * HUD_BALL_VERTICES + (HUD_BLOCKS - HUD_BALL_NEAR) * HUD_LOW_SEGMENTS * (HUD_LOW_RINGS - 1) * 6 + VL_SOLIDS * 6 + RG_MAX * RG_VERTICES == HUD_MESH_VERTICES && HUD_BALL_VERTICES == HUD_BALL_SEGMENTS * (HUD_BALL_RINGS - 1) * 6 && HUD_BLOCKS <= BD_MAX && VL_SOLIDS <= BD_WALLS;
  #assert 6 + RC_MESH <= HUD_MESH_VERTICES && 6 + PF_MESH <= HUD_MESH_VERTICES;
}

#test "a block is solid, by the engine's collision: a wall to run into, a top to jump onto and stand on, an edge to walk off and fall from" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true; h[0].drop = 0;
  b := h[0].things[..];
  // two metres wide, six long, one high, its near side two metres ahead: 3.6 tonnes, put where it rests
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 0 500 200 100 600\n");
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_say(h, HUD_KEYS_MSG, "1");
  hud_test_run(t[..], 200, 0.01);
  // stopped at its side, a body's radius short of it, not running on the spot; and for all its running at it (the
  // things' time starts 0.4 s in now, so it is leaned on for a second and a half) the block has not moved two centimetres
  #assert near(h[0].foot.walk.z, 2 - HUD_BODY, 0.04) && h[0].foot.walk.z <= 2 - HUD_BODY + 0.03 && h[0].cy == 0 && h[0].foot.walk.speed < 0.05 && h[0].ground == 0;
  #assert near_d(b[0].set[0].pos[0].z, 5, 0.02) && near_d(b[0].set[0].pos[0].y, 0.5, 0.001);
  // jumping at it lands on its top: the top is ground, and the floor under it is the block's
  hud_test_say(h, HUD_KEYS_MSG, "17");
  hud_test_run(t[..], 70, 0.01);
  #assert h[0].foot.jump.on_ground && near(h[0].cy, 1, 0.002) && h[0].foot.walk.z > 2.3 && h[0].foot.walk.z < 8.5 && near(h[0].ground, 1, 0.002);
  // standing there, still, it stays there
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_test_run(t[..], 100, 0.01);
  #assert near(h[0].cy, 1, 0.002) && h[0].foot.jump.on_ground;
  // and walking on, it goes off the far edge, falls, and lands on the floor beyond
  hud_test_say(h, HUD_KEYS_MSG, "1");
  fell := false;
  for k: 0..<200 { hud_test_run(t[..], 1, 0.01); if !h[0].foot.jump.on_ground && h[0].cy < 0.95 && h[0].cy > 0 { fell = true; #assert h[0].foot.walk.z > 8; } }
  #assert fell && h[0].cy == 0 && h[0].foot.jump.on_ground && h[0].foot.walk.z > 8 + HUD_BODY && h[0].ground == 0;
  // coming back, it is a wall from that side too
  hud_test_say(h, HUD_KEYS_MSG, "2");
  hud_test_run(t[..], 300, 0.01);
  #assert near(h[0].foot.walk.z, 8 + HUD_BODY, 0.03) && h[0].foot.walk.z >= 8 + HUD_BODY - 0.01 && h[0].cy == 0;
  // sideways along it, it slides: the wall takes only the part of the step that goes into it
  hud_test_say(h, HUD_KEYS_MSG, "10");
  sx := h[0].cx;
  hud_test_run(t[..], 20, 0.01);
  #assert h[0].cx > sx + 0.3 && near(h[0].foot.walk.z, 8 + HUD_BODY, 0.03) && h[0].cx < 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_test_run(t[..], 150, 0.01);
  #assert bd_sleeping(b) == 1 && !h[0].moved;
  // a block put where it stands pushes it out by the nearest side
  x := h[0].foot.walk.x; z := h[0].foot.walk.z;
  o := h[0].boxes[..]; o[0] = x - 1; o[1] = 0; o[2] = z - 2; o[3] = x + 0.1; o[4] = 3; o[5] = z + 2;
  hud_test_run(t[..], 2, 0.01);
  #assert near(h[0].foot.walk.x, x + 0.1 + HUD_BODY, 0.01) && near(h[0].foot.walk.z, z, 0.01) && h[0].cy == 0;
  // a block overhead stops a jump at its underside: its head is 1.8 m up, the block 2.4 m
  x = h[0].foot.walk.x; z = h[0].foot.walk.z;
  o[0] = x - 1; o[1] = 2.4; o[2] = z - 1; o[3] = x + 1; o[4] = 3; o[5] = z + 1;
  hud_test_say(h, HUD_KEYS_MSG, "16");
  top: f32 = 0;
  for k: 0..<150 { hud_test_run(t[..], 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  #assert top <= 0.6 + 0.01 && top > 0.5 && h[0].cy == 0 && near(h[0].foot.walk.x, x, 0.001);
}

#test "a block falls from a little above where it is put, comes to rest on the ground at its height within two seconds, sleeps, and the page is told where" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  hud_test_down(t[..]);
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n7 0 1 1 250 0 600 100 100 100\n");
  #assert near_d(s[0].pos[0].y, 0.5 + HUD_DROP, 1e-9) && bd_awake(b, 0);
  low := 9.0; top := 0.0; landed := -1; slept := -1;
  for k: 0..<200 {
    hud_test_run(t[..], 1, 0.01);
    y := s[0].pos[0].y;
    low = fmin(low, y - 0.5);
    if landed < 0 && y < 0.501 { landed = k; }
    if landed >= 0 && k > landed + 2 { top = fmax(top, y); }
    if slept < 0 && !bd_awake(b, 0) { slept = k; }
  }
  // three metres take 0.78 s; it never goes into the ground; it bounces 7 cm at most; it sleeps within two seconds of being put
  #assert landed > 70 && landed < 85 && low > -0.001 && top < 0.5 + 0.08 && top > 0.5 + 0.02 && slept > landed && slept < 200;
  #assert near_d(s[0].pos[0].y, 0.5, 0.001) && near_d(s[0].pos[0].x, 2.5, 0.001) && near_d(s[0].pos[0].z, 6, 0.001) && near_d(s[0].att[0].w, 1, 1e-6) && b[0].lifted == 0 && b[0].faults == 0;
  // the page is told its rest: its name, the middle of its footprint, its bottom, its size, no turn, not tipped
  #assert hud_test_told(t[..], 60) == "7 250 0 600 100 100 100 0 0";
  // and not again while it rests there
  #assert hud_test_told(t[..], 120) == "";
  // a ball does the same, with more bounce
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n7 0 1 1 250 0 600 100 100 100\n8 1 1 1 -200 0 300 60 60 60\n");
  #assert bd_count(b) == 2 && !bd_awake(b, 0) && near_d(s[0].pos[1].y, 0.3 + HUD_DROP, 1e-9);
  low = 9.0; top = 0.0; landed = -1;
  for k: 0..<400 {
    hud_test_run(t[..], 1, 0.01);
    y := s[0].pos[1].y;
    low = fmin(low, y - 0.3);
    if landed < 0 && y < 0.301 { landed = k; }
    if landed >= 0 && k > landed + 2 { top = fmax(top, y); }
  }
  #assert low > -0.001 && top > 0.3 + 0.6 && top < 0.3 + 1.1 && !bd_awake(b, 1) && near_d(s[0].pos[1].y, 0.3, 0.001) && !bd_awake(b, 0);
  #assert hud_test_told(t[..], 60) == "8 -200 0 300 60 60 60 0 0";
}

#test "two blocks stacked stay stacked: the upper lands on the lower, both rest, and ten seconds on they are where they were" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  hud_test_down(t[..]);
  // a 2 m slab, and a 1 m block whose bottom is to be a metre up: on it
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n1 0 1 1 0 0 500 200 100 200\n2 0 1 1 30 100 520 100 100 100\n");
  hud_test_run(t[..], 300, 0.01);
  // (the landing knocks both a few centimetres)
  #assert bd_sleeping(b) == 2 && near_d(s[0].pos[0].y, 0.5, 0.002) && near_d(s[0].pos[1].y, 1.5, 0.004) && near_d(s[0].pos[1].x, 0.3, 0.08) && near_d(s[0].pos[1].z, 5.2, 0.08) && near_d(s[0].pos[0].x, 0, 0.03);
  where := s[0].pos[1];
  // the page is told both, where they are to the centimetre: the upper one's bottom is a metre up
  told := hud_test_told(t[..], 60);
  low := hud_test_rest(h, 1); up := hud_test_rest(h, 2);
  #assert told.count > 30 && low[1] == 0 && low[3] == 200 && low[4] == 100 && up[1] == 100 && up[3] == 100 && up[0] == hud_whole(cast(f32) (s[0].pos[1].x * 100)) && up[2] == hud_whole(cast(f32) (s[0].pos[1].z * 100)) && up[7] == 0 && low[7] == 0;
  hud_test_run(t[..], 1000, 0.01);
  #assert bd_sleeping(b) == 2 && d3_eq(s[0].pos[1], where) && hud_test_low(h) > -0.002;
  // the character can jump onto the stack's lower block and stand there, and the stack is as it was
  h[0].foot.walk.z = 2.4; h[0].foot.walk.x = -0.6;
  hud_test_say(h, HUD_KEYS_MSG, "17");
  hud_test_run(t[..], 35, 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_test_run(t[..], 60, 0.01);
  #assert near(h[0].cy, 1, 0.01) && h[0].foot.jump.on_ground && near_d(s[0].pos[1].y, 1.5, 0.004) && near_d(s[0].pos[0].y, 0.5, 0.002);
}

// The character put at the start, facing a thing three metres ahead, and run at it for `frames` frames. How high its feet got.
hud_test_charge :: (t: [] HudTest, frames: int) -> f32 {
  h := t[0].h[..];
  hud_test_say(h, HUD_KEYS_MSG, "0");
  h[0].foot.walk.z = 0; h[0].foot.walk.x = 0;
  hud_test_run(t, 100, 0.01);
  hud_test_say(h, HUD_KEYS_MSG, "1");
  high: f32 = 0;
  for k: 0..<frames { hud_test_run(t, 1, 0.01); if h[0].cy > high { high = h[0].cy; } }
  return high;
}
#test "running into things pushes them by their weight: a small block is run along with, a cubic metre is shoved at a walk, the starting blocks give a little, and a 12 m wall barely moves; the character is never lifted" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  h[0].drop = 0;
  hud_test_down(t[..]);
  // each three metres ahead, put where it rests, and run at for three seconds. The push is 12 kN on a
  // standing thing and sags to nothing at the run's 6.9 m/s (the engine's bd_push_share, curve 12);
  // friction is half a thing's weight: v / 6.9 = (1 - r) / (1 + 12 r), r the friction over 12 kN
  // 0.6 m cubed, 43 kg: r = 0.018, 5.6 m/s were it not for the stride it takes to catch it up again: over 4 m/s
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 0 300 60 60 60\n");
  #assert hud_test_charge(t[..], 300) == 0 && near_d(s[0].mass[0], 43.2, 1e-6) && s[0].vel[0].z > 4 && s[0].vel[0].z < 5.7 && s[0].pos[0].z > 13 && near_d(s[0].pos[0].y, 0.3, 0.01);
  #assert h[0].foot.walk.z > 11 && h[0].foot.walk.z < cast(f32) s[0].pos[0].z - 0.3 - HUD_BODY + 0.05;
  // a cubic metre, 200 kg: r = 0.082, 3.2 m/s at most: about 2.4 with the character's stride behind it
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n2 0 1 1 0 0 300 100 100 100\n");
  #assert hud_test_charge(t[..], 300) == 0 && near_d(s[0].mass[0], 200, 1e-6) && s[0].vel[0].z > 1.9 && s[0].vel[0].z < 3.3 && s[0].pos[0].z > 7.5 && s[0].pos[0].z < 11 && near_d(s[0].pos[0].y, 0.5, 0.01) && abs(s[0].pos[0].x) < 0.05;
  // and the character is right behind it
  #assert near(h[0].foot.walk.z, cast(f32) s[0].pos[0].z - 0.5 - HUD_BODY, 0.12);
  // the starting platform, 2 by 2 by 1, 800 kg: r = 0.33, under a metre a second
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n3 0 1 1 0 0 300 200 100 200\n");
  #assert hud_test_charge(t[..], 300) == 0 && s[0].vel[0].z > 0.4 && s[0].vel[0].z < 1.0 && s[0].pos[0].z > 3.8 && s[0].pos[0].z < 5.6;
  // the starting pillar, 1 by 1 by 3, 600 kg: about a metre a second, and it stays standing
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n4 0 1 1 0 0 300 100 300 100\n");
  #assert hud_test_charge(t[..], 300) == 0 && s[0].vel[0].z > 0.6 && s[0].vel[0].z < 1.4 && s[0].pos[0].z > 4.3 && dq_rotate(s[0].att[0], D3_Y).y > 0.999 && near_d(s[0].pos[0].y, 1.5, 0.01);
  // the starting wall, 6 by 1 by 2, 2.4 tonnes: its friction is 98 hundredths of the push: centimetres in three seconds
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n5 0 1 1 0 0 300 600 200 100\n");
  #assert hud_test_charge(t[..], 300) == 0 && s[0].pos[0].z > 3.003 && s[0].pos[0].z < 3.08 && near(h[0].foot.walk.z, cast(f32) s[0].pos[0].z - 0.5 - HUD_BODY, 0.05);
  // a wall 12 m long, 4.8 tonnes: more friction than there is push: millimetres
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n6 0 1 1 0 0 300 1200 200 100\n");
  #assert hud_test_charge(t[..], 300) == 0 && s[0].pos[0].z >= 3.0 && s[0].pos[0].z < 3.01 && near_d(s[0].mass[0], 4800, 1e-6) && h[0].foot.walk.speed < 0.3 && h[0].cy == 0;
}

#test "the ball is kicked by running into it: it leaves faster than the run, rolls, and comes to rest; the page is told where" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  h[0].drop = 0;
  hud_test_down(t[..]);
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n4 1 1 1 0 0 300 60 60 60\n");
  hud_test_run(t[..], 80, 0.01);
  #assert !bd_awake(b, 0) && hud_test_told(t[..], 60) == "4 0 0 300 60 60 60 0 0";
  hud_test_say(h, HUD_KEYS_MSG, "1");
  fastest := 0.0;
  for k: 0..<60 { hud_test_run(t[..], 1, 0.01); fastest = fmax(fastest, s[0].vel[0].z); }
  // 6.9 m/s and its bounce of 0.55 on top: over 9 m/s, well ahead of the character
  #assert fastest > 9 && fastest < 11 && s[0].pos[0].z > cast(f64) h[0].foot.walk.z + 1 && near_d(s[0].pos[0].y, 0.3, 0.01);
  // let go: it rolls on, slows at about 1.4 m/s a second, stops within ten seconds and sleeps, on the floor
  hud_test_say(h, HUD_KEYS_MSG, "0");
  rolling := false;
  for k: 0..<100 { hud_test_run(t[..], 1, 0.01); }
  rolling = near_d(d3_len(bd_spin(b, 0)) * 0.3, d3_len(s[0].vel[0]), 0.2) && d3_len(s[0].vel[0]) > 2;
  hud_test_run(t[..], 900, 0.01);
  #assert rolling && !bd_awake(b, 0) && s[0].pos[0].z > 15 && s[0].pos[0].z < 45 && near_d(s[0].pos[0].y, 0.3, 0.001) && hud_test_low(h) > -0.001;
  // the page is told where it stopped: its name, its place in hundredths, its bottom on the floor, 0.6 across
  told := hud_test_told(t[..], 60);
  r := hud_read(told, 0); x := hud_read(told, r.at); y := hud_read(told, x.at); z := hud_read(told, y.at); w := hud_read(told, z.at);
  #assert r.value == 4 && z.ok && z.value == hud_whole(cast(f32) (s[0].pos[0].z * 100)) && y.value == 0 && w.value == 60 && x.value == hud_whole(cast(f32) (s[0].pos[0].x * 100));
}

#test "a block put where another stands parts from it without flying off; one put on the character lands and pushes it aside" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  h[0].drop = 0;
  hud_test_down(t[..]);
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 0 600 100 100 100\n");
  hud_test_run(t[..], 80, 0.01);
  // a second one half inside the first
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n1 0 1 1 0 0 600 100 100 100\n2 0 1 1 40 0 620 100 100 100\n");
  fastest := 0.0;
  for k: 0..<300 { hud_test_run(t[..], 1, 0.01); fastest = fmax(fastest, fmax(d3_len(s[0].vel[0]), d3_len(s[0].vel[1]))); }
  // how deep they are still in each other, by the engine's own test of two boxes
  f := narrow_box_box(bd_shape(b, 0), bd_shape(b, 1));
  apart := 1.0;
  for k: 0..<f.count { apart = fmin(apart, 1.0 + f.distance[k]); }
  // (they part by the engine's positional push alone: neither gains any speed by it)
  #assert bd_sleeping(b) == 2 && apart > 1 - 0.01 && fastest < 0.5 && near_d(s[0].pos[0].y, 0.5, 0.005) && near_d(s[0].pos[1].y, 0.5, 0.005) && hud_test_low(h) > -0.006;
  // one dropped from three metres onto the character where it stands: the character is beside it afterwards, on the floor, not under it and not thrown
  h[0].drop = HUD_DROP;
  hud_test_say(h, HUD_BLOCKS_MSG, "3\n1 0 1 1 0 0 600 100 100 100\n2 0 1 1 40 0 620 100 100 100\n3 0 1 1 10 0 0 100 100 100\n");
  high: f32 = 0;
  for k: 0..<300 { hud_test_run(t[..], 1, 0.01); if h[0].cy > high { high = h[0].cy; } }
  dx := h[0].foot.walk.x - cast(f32) s[0].pos[2].x; dz := h[0].foot.walk.z - cast(f32) s[0].pos[2].z;
  #assert !bd_awake(b, 2) && near_d(s[0].pos[2].y, 0.5, 0.005) && (abs(dx) >= 0.5 + HUD_BODY - 0.02 || abs(dz) >= 0.5 + HUD_BODY - 0.02) && high == 0 && h[0].cy == 0 && abs(dx) < 1.0 && abs(dz) < 1.0 && h[0].foot.walk.speed == 0;
}

#test "the page moves and sizes a thing by the counts it sends; otherwise where a thing is is the engine's to say, and a thing gone from the list is gone" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  hud_test_down(t[..]);
  hud_test_say(h, HUD_BLOCKS_MSG, HUD_TEST_START);
  hud_test_run(t[..], 400, 0.01);
  #assert bd_sleeping(b) == 4;
  said := hud_test_told(t[..], 60);
  // all four are told at once, in id order, each within a centimetre or two of where it was put
  #assert cast(string) said[0..<28] == "1 -300 0 400 200 100 200 0 0" && hud_test_rest(h, 2)[3] == 100 && hud_test_rest(h, 2)[4] == 300 && hud_test_rest(h, 3)[3] == 600 && near(cast(f32) hud_test_rest(h, 3)[2], 800, 3) && cast(string) said[said.count - 23..<said.count] == "4 80 0 300 60 60 60 0 0";
  // the same list with other places and sizes but the same counts changes nothing: they sleep on where they are
  hud_test_say(h, HUD_BLOCKS_MSG, "4\n1 0 1 1 900 0 900 300 300 300\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 90 90 90\n");
  #assert bd_sleeping(b) == 4 && near_d(s[0].pos[0].x, -3, 0.001) && d3_eq(b[0].half[0], d3(1, 0.5, 1)) && b[0].half[3].x == 0.3;
  // sized (its second count up): taller where it rests, its bottom still on the floor, awake, 300 kg a cubic metre
  hud_test_say(h, HUD_BLOCKS_MSG, "4\n1 0 1 2 -300 0 400 200 300 100\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 2 80 0 300 100 100 100\n");
  #assert bd_awake(b, 0) && d3_eq(b[0].half[0], d3(1, 1.5, 0.5)) && near_d(s[0].pos[0].y, 1.5, 0.002) && near_d(s[0].pos[0].x, -3, 0.001) && near_d(s[0].mass[0], 6 * HUD_DENSITY, 1e-6);
  #assert bd_awake(b, 3) && b[0].half[3].x == 0.5 && near_d(s[0].pos[3].y, 0.5, 0.002) && !bd_awake(b, 1);
  hud_test_run(t[..], 100, 0.01);
  #assert bd_sleeping(b) == 4 && hud_test_told(t[..], 60) == "1 -300 0 400 200 300 100 0 0 4 80 0 300 100 100 100 0 0";
  // moved (its first count up): at its new place, upright, not lifted first; one moved to a height falls from that height
  hud_test_say(h, HUD_BLOCKS_MSG, "4\n1 0 2 2 500 0 -200 200 300 100\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 2 2 -400 100 0 100 100 100\n");
  #assert d3_eq(s[0].pos[0], d3(5, 1.5, -2)) && bd_awake(b, 0) && near_d(s[0].pos[3].y, 1 + 0.5, 1e-9) && s[0].pos[3].x == -4 && d3_eq(s[0].vel[0], D3_ZERO);
  hud_test_run(t[..], 400, 0.01);
  #assert bd_sleeping(b) == 4 && near_d(s[0].pos[0].y, 1.5, 0.002) && near_d(s[0].pos[3].y, 0.5, 0.002);
  told := hud_test_told(t[..], 60);
  later := hud_test_told(t[..], 60);   // (the ball, which fell further and bounced longer)
  m1 := hud_test_rest(h, 1);
  #assert told.count > 0 && near(cast(f32) m1[0], 500, 3) && m1[1] == 0 && near(cast(f32) m1[2], -200, 3) && m1[3] == 200 && m1[4] == 300 && m1[5] == 100 && m1[7] == 0 && later.count > 0 && hud_test_rest(h, 4)[3] == 100 && near(cast(f32) hud_test_rest(h, 4)[0], -400, 60) && hud_test_rest(h, 4)[1] == 0;
  // the second gone from the list: its body is gone, and the others keep their names, their places and their counts
  hud_test_say(h, HUD_BLOCKS_MSG, "3\n1 0 2 2 500 0 -200 200 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 2 2 -400 100 0 100 100 100\n");
  #assert bd_count(b) == 3 && b[0].id[0] == 1 && b[0].id[1] == 3 && b[0].id[2] == 4 && b[0].kind[2] == Bd_Kind.ball && h[0].nk == 3 && h[0].known[hud_known(h, 4)].moves == 2 && h[0].known[hud_known(h, 4)].sizes == 2 && hud_known(h, 2) == -1 && near_d(s[0].pos[1].z, 8, 0.03) && h[0].nb == 2 && h[0].nc == 1;
  // the same list again moves nothing and tells nothing
  hud_test_say(h, HUD_BLOCKS_MSG, "3\n1 0 2 2 500 0 -200 200 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 2 2 -400 100 0 100 100 100\n");
  hud_test_run(t[..], 100, 0.01);
  #assert bd_count(b) == 3 && near_d(s[0].pos[0].y, 1.5, 0.002) && hud_test_told(t[..], 100) == "";
}

#test "a block that has turned or fallen over is still solid, and the page is told how it stands: turned, lying as the box it now is, or tipped" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  h[0].drop = 0;
  hud_test_down(t[..]);
  // a pillar 1 by 1 by 3 at (0, 6); a wall across at 10 m
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n1 0 1 1 0 0 600 100 300 100\n2 0 1 1 0 0 1000 400 100 100\n");
  hud_test_run(t[..], 80, 0.01);
  #assert bd_sleeping(b) == 2 && hud_test_told(t[..], 60) == "1 0 0 600 100 300 100 0 0 2 0 0 1000 400 100 100 0 0";
  // the wall turned 30 degrees where it stands (as a shove off its middle would turn it): to the character it is a hull of six faces, and still a wall
  bd_place(b, 1, s[0].pos[1], dq_y(0.5235988));
  hud_test_run(t[..], 100, 0.01);
  #assert h[0].nh == 1 && h[0].nb == 1 && h[0].hulls[0] == 6 && near(h[0].hulls[1], 0, 0.002) && near(h[0].hulls[2], 1, 0.002);
  #assert hud_test_told(t[..], 60) == "2 0 0 1000 400 100 100 30 0";
  h[0].foot.walk.x = 0.5; h[0].foot.walk.z = 8;
  hud_test_say(h, HUD_KEYS_MSG, "1");
  hud_test_run(t[..], 45, 0.01);
  // its near face runs at 30 degrees: the character is held off it by its radius, on the near side, and slides along it (and round its end, in time)
  q := s[0].att[1]; out := dq_rotate(q, d3(0, 0, -1));
  face := cast(f32) ((cast(f64) h[0].foot.walk.x - s[0].pos[1].x) * out.x + (cast(f64) h[0].foot.walk.z - s[0].pos[1].z) * out.z);
  #assert face > 0.5 + HUD_BODY - 0.1 && face < 0.5 + HUD_BODY + 0.3 && h[0].foot.walk.x < 0.45 && h[0].cy == 0 && near_d(s[0].pos[1].y, 0.5, 0.01) && h[0].nh == 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  // the pillar pushed over (a turn about x and a nudge): it falls flat along z, and is told as the box it now is: 1 wide, 1 high, 3 long
  bd_place(b, 0, d3(0, 1.5 * cos(0.5) + 0.5 * sin(0.5), 6), dq_x(0.5));
  hud_test_run(t[..], 400, 0.01);
  #assert !bd_awake(b, 0) && near_d(s[0].pos[0].y, 0.5, 0.01) && s[0].pos[0].z > 6.5 && bd_sleeping(b) == 2;
  told := hud_test_told(t[..], 60);
  r := hud_read(told, 0); x := hud_read(told, r.at); y := hud_read(told, x.at); z := hud_read(told, y.at); w := hud_read(told, z.at); ht := hud_read(told, w.at); d := hud_read(told, ht.at); turn := hud_read(told, d.at); tip := hud_read(told, turn.at);
  #assert r.value == 1 && y.value == 0 && w.value == 100 && ht.value == 100 && d.value == 300 && tip.ok && tip.value == 0 && turn.value >= -3 && turn.value <= 3 && z.value > 650;
  // sized by the page as it lies (4 long now): it is made that box where it rests, its bottom on the floor
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n1 0 1 2 0 0 600 100 100 400\n2 0 1 1 0 0 1000 400 100 100\n");
  e := bd_extent(b, 0);
  #assert near_d(e.x, 0.5, 0.03) && near_d(e.y, 0.5, 0.001) && near_d(e.z, 2, 0.03) && near_d(s[0].pos[0].y, 0.5, 0.01) && d3_eq(b[0].half[0], d3(0.5, 0.5, 2));
  // a block left leaning on another is told as tipped, by its own size
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n5 0 1 1 0 0 2000 100 100 100\n6 0 1 1 95 0 2000 40 160 100\n");
  hud_test_run(t[..], 60, 0.01);
  lean := bd_index(b, 6);
  bd_place(b, lean, d3(0.5 + 0.2 * cos(0.6) + 0.8 * sin(0.6), 0.8 * cos(0.6) + 0.2 * sin(0.6), 20), dq_z(0.6));
  hud_test_run(t[..], 500, 0.01);
  told = hud_test_told(t[..], 100);
  told = hud_test_told(t[..], 100);
  st := hud_stand(h, lean);
  #assert !bd_awake(b, lean) && (st.tipped || near_d(bd_extent(b, lean).y, 0.2, 0.02) || near_d(bd_extent(b, lean).y, 0.8, 0.02));
  if st.tipped { kn := h[0].known[hud_known(h, 6)]; #assert h[0].nh >= 1 && kn.rest[7] == 1 && kn.rest[3] == 40 && kn.rest[4] == 160; }
}

#test "forty-eight things, eight of them balls, dropped and left for half a minute: nothing under the ground, nothing not a number, all at rest" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  hud_test_down(t[..]);
  // the list as the page would write it: 40 blocks of several sizes close together, some to land on others, and 8 balls among them
  text: [4096] u8; n := 0;
  n = hud_test_put(text[..], n, 48); text[n] = '\n'; n += 1;
  for k: 0..<48 {
    ball := k % 6 == 5;
    row := [10] int.[k + 1, ifx ball then 1 else 0, 1, 1, (k % 8) * 110 - 400, (k / 16) * 60, 300 + ((k / 8) % 6) * 120, ifx ball then 60 else 60 + (k % 3) * 40, ifx ball then 60 else 50 + (k % 4) * 30, ifx ball then 60 else 80 + (k % 2) * 60];
    for q: 0..<10 { n = hud_test_put(text[..], n, row[q]); text[n] = ifx q == 9 then '\n' else ' '; n += 1; }
  }
  for i: 0..<n { h[0].inbox[i] = text[i]; }
  hud_message(h, HUD_BLOCKS_MSG, n);
  #assert bd_count(b) == 48 && h[0].nc == 8;
  low := 9.0; most := 0;
  for k: 0..<3000 {
    hud_test_run(t[..], 1, 0.01);
    if hud_action(h) != 0 { hud_action_done(h); }   // the page takes what it is told
    low = fmin(low, hud_test_low(h));
    if b[0].count_m > most { most = b[0].count_m; }
    if k % 50 == 0 { for i: 0..<48 { #assert d3_finite(s[0].pos[i]) && d3_finite(s[0].vel[i]) && abs(s[0].pos[i].x) < 60 && abs(s[0].pos[i].z) < 60 && s[0].pos[i].y < 20; } }
  }
  #assert low > -0.04 && b[0].faults == 0 && b[0].lifted == 0 && b[0].dropped == 0 && most > 40 && bd_sleeping(b) == 48 && hud_test_low(h) > -0.01;
  // every vertex drawn is a number, and the page has been told of every one of them by now
  for v: 0..<h[0].mesh_n { m := v * ARCH_VERTEX_FLOATS; #assert h[0].mesh[m] == h[0].mesh[m] && h[0].mesh[m + 1] > -0.05 && h[0].mesh[m + 1] < 20; }
  for i: 0..<48 { #assert h[0].known[i].said; }
  #assert h[0].mesh_n == 6 + 40 * 36 + 8 * HUD_BALL_VERTICES;
}

#test "a thousand things, the cap: all of them bodies, at rest where they were set; one more is not taken; a thousand balls fit the mesh, the twelve nearest smooth; the rests are told a few hundred at a time" #steps 40000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..];
  b := h[0].things[..]; s := b[0].set[..];
  hud_test_down(t[..]);
  // the list as the page writes it at its cap, and one line more: balls on a grid 2.5 m apart, set down at rest
  text: [HUD_INBOX] u8; n := 0;
  n = hud_test_put(text[..], n, HUD_BLOCKS + 1); text[n] = '\n'; n += 1;
  for k: 0..<HUD_BLOCKS + 1 {
    row := [11] int.[k + 1, 1, 1, 1, (k % 32) * 250 - 4000, 0, (k / 32) * 250 - 4000, 60, 60, 60, 1];
    for q: 0..<11 { n = hud_test_put(text[..], n, row[q]); text[n] = ifx q == 10 then '\n' else ' '; n += 1; }
  }
  #assert n < HUD_INBOX;
  for i: 0..<n { h[0].inbox[i] = text[i]; }
  hud_message(h, HUD_BLOCKS_MSG, n);
  #assert bd_count(b) == HUD_BLOCKS && h[0].nk == HUD_BLOCKS && bd_index(b, HUD_BLOCKS + 1) < 0 && bd_sleeping(b) == HUD_BLOCKS && hud_room_why(h, HUD_T_BALL, 0, 0) == HUD_L_FULL;
  hud_test_run(t[..], 30, 0.016);
  // all still where they were set; every ball drawn, the mesh inside its store, the twelve nearest the character smooth
  #assert bd_sleeping(b) == HUD_BLOCKS && near_d(s[0].pos[0].x, -40.0, 1e-9) && near_d(s[0].pos[0].y, 0.3, 1e-9) && b[0].dropped == 0;
  #assert h[0].mesh_n <= HUD_MESH_VERTICES && h[0].mesh_n == 6 + HUD_BALL_NEAR * HUD_BALL_VERTICES + (HUD_BLOCKS - HUD_BALL_NEAR) * HUD_LOW_SEGMENTS * (HUD_LOW_RINGS - 1) * 6;
  // the page is told every rest it has not heard, in turns that fit the outbox, until all are told
  told := 0;
  for k: 0..<60 { hud_test_run(t[..], 1, 0.016); if hud_action(h) == HUD_SETTLED { #assert hud_outbox_len(h) <= HUD_OUTBOX; told += 1; } if hud_action(h) != 0 { hud_action_done(h); } }
  said := 0; for i: 0..<HUD_BLOCKS { if h[0].known[i].said { said += 1; } }
  #assert said == HUD_BLOCKS && told >= 1;
  // one taken away: there is room for one more
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 1 1 1 -4000 0 -4000 60 60 60 1\n");
  #assert bd_count(b) == 1 && hud_room_why(h, HUD_T_BALL, 0, 0) == HUD_L_NONE;
}

#test "the page is told where the character is: its place and facing in hundredths, when they change, four times a second at most, in the world only" #steps 2000000000 {
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  hud_test_run(t[..], 50, 0.01);
  #assert hud_action(h) == 0;
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 1, 0.01);
  #assert hud_action(h) == HUD_WHERE && cast(string) h[0].outbox[0..<hud_outbox_len(h)] == "0 0 0 100";
  hud_action_done(h);
  // standing still, nothing more is said
  hud_test_run(t[..], 100, 0.01);
  #assert hud_action(h) == 0 && hud_outbox_len(h) == 0;
  // running right: said again, but not before a quarter second has gone by
  hud_test_say(h, HUD_KEYS_MSG, "8");
  told := 0;
  for k: 0..<100 { hud_test_run(t[..], 1, 0.01); if hud_action(h) != 0 { told += 1; hud_action_done(h); } }
  #assert told >= 3 && told <= 5;
  // stopped: the last word is where it stands. "X Z FX FZ": it went right (+x) about 6.9 m, 6.9 squares, facing +x
  hud_test_say(h, HUD_KEYS_MSG, "0");
  r: HudRead; z: HudRead; fx: HudRead; fz: HudRead;
  for k: 0..<100 {
    hud_test_run(t[..], 1, 0.01);
    if hud_action(h) == 0 { continue; }
    w := cast(string) h[0].outbox[0..<hud_outbox_len(h)];
    r = hud_read(w, 0); z = hud_read(w, r.at); fx = hud_read(w, z.at); fz = hud_read(w, fx.at);
    hud_action_done(h);
  }
  #assert r.ok && z.ok && fx.ok && fz.ok && r.value > 640 && r.value < 720 && z.value == 0 && fx.value == 100 && fz.value == 0;
  #assert r.value == hud_whole(h[0].cx * 100) && hud_action(h) == 0;
  // a word not yet taken is not written over
  hud_test_say(h, HUD_KEYS_MSG, "1");
  hud_test_run(t[..], 100, 0.01);
  #assert hud_action(h) == HUD_WHERE && hud_read(cast(string) h[0].outbox[0..<hud_outbox_len(h)], hud_read(cast(string) h[0].outbox[0..<hud_outbox_len(h)], 0).at).value < 40;
}

#test "the sky starts pitch black, the sun comes up dead ahead over four seconds, it ends as a blue day and stays, and leaving the world is black again" #steps 2000000000 {
  #assert HUD_SUNRISE == 4;
  // the look: black at the start (no light, no sky), the day at four seconds and after
  n := hud_look(0); d := hud_look(HUD_SUNRISE); day := hud_day();
  #assert n.zenith_b == 0 && n.horizon_r == 0 && n.sun_r == 0 && n.sky_b == 0 && n.ground_g == 0 && n.haze_b == 0 && n.glow_r == 0 && n.cloud_dim == 1 && n.sun_y < -0.2;
  #assert d.zenith_b == day.zenith_b && d.sun_x == day.sun_x && d.sun_y == day.sun_y && d.cloud_dim == 0 && hud_look(HUD_SUNRISE + 9).sun_y == day.sun_y;
  // the day: a blue sky, clouds, the sun up and ahead (the engine's -z) with its disc, haze the horizon's colour to the far ground
  #assert day.zenith_b > 0.8 && day.zenith_b > day.zenith_r * 4 && day.cloud > 0.3 && day.sun_y > 0.5 && day.sun_z < -0.5 && day.sun_disc > 0.01 && day.haze_most == 1 && day.haze_r == day.horizon_r && day.haze_b == day.horizon_b;
  #assert day.air == 1 && n.air == 1;
  // the sun is on the horizon dead ahead of the camera at the engine's share of the sunrise, and only climbs
  r := hud_look(HUD_SUNRISE * STY_SUNRISE_HORIZON); #assert near(r.sun_y, 0, 0.0001) && near(r.sun_x, 0, 0.0001) && near(r.sun_z, -1, 0.0001) && r.glow_r > 0.9;
  last: f32 = -1;
  for k: 0..<121 { l := hud_look(cast(f32) k * (HUD_SUNRISE / 120)); #assert l.sun_y > last || k == 120 && l.sun_y == day.sun_y; last = l.sun_y; }
  t: [1] HudTest; h := t[0].h[..];
  h[0].bare = true;
  u := t[0].u[..];
  // the page's own views: the sky and every light are black, and stay black
  hud_test_run(t[..], 30, 0.01);
  #assert h[0].dawn == 0 && u[STY_U_ZENITH + 2] == 0 && u[STY_U_HORIZON] == 0 && u[STY_U_SUN_COLOUR] == 0 && u[STY_U_SKY_LIGHT + 2] == 0 && u[STY_U_GLOW_R] == 0 && u[STY_U_HAZE + 2] == 0;
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_test_run(t[..], 200, 0.01);
  #assert h[0].dawn == 0 && u[STY_U_ZENITH + 2] == 0 && u[STY_U_SUN_COLOUR] == 0;
  // the world: the sunrise runs with the clock; at the horizon's share the sun is on the horizon ahead, its disc and glow in the frame
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 168, 0.01);
  #assert near(h[0].dawn, 1.68, 0.001) && near(u[STY_U_SUN + 1], 0, 0.001) && u[STY_U_SUN + 2] < -0.999 && u[STY_U_SUN_DISC] == day.sun_disc && u[STY_U_GLOW_R] > 0.9 && u[STY_U_ZENITH + 2] > 0.3 && u[STY_U_CLOUD_DIM] > 0.5;
  // four seconds: the day, and it stays the day
  hud_test_run(t[..], 700, 0.01);
  #assert h[0].dawn == HUD_SUNRISE && u[STY_U_ZENITH + 2] == day.zenith_b && near(u[STY_U_SUN + 1], 0.669, 0.001) && u[STY_U_GLOW_R] == 0 && u[STY_U_CLOUD_DIM] == 0 && u[STY_U_SUN_COLOUR] == day.sun_r;
  hud_test_run(t[..], 500, 0.01);
  #assert h[0].dawn == HUD_SUNRISE && u[STY_U_ZENITH + 2] == day.zenith_b;
  // leaving the world: black again within a second, and the next time the world comes up the sun rises again
  hud_test_say(h, HUD_VIEW_MSG, "0");
  hud_test_run(t[..], 50, 0.01);
  #assert h[0].dawn > 0 && h[0].dawn < HUD_SUNRISE;
  hud_test_run(t[..], 60, 0.01);
  #assert h[0].dawn == 0 && u[STY_U_ZENITH + 2] == 0 && u[STY_U_SUN_COLOUR] == 0 && u[STY_U_GLOW_R] == 0;
  hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 33, 0.01);
  #assert near(h[0].dawn, 0.33, 0.001) && u[STY_U_ZENITH + 2] > 0 && u[STY_U_ZENITH + 2] < 0.05;
}

#test "the grass is the engine's lush grass, nine vertices a blade; a small window has under a sixth of the blades; and things at rest keep the grass off" #steps 2000000000 {
  day := hud_day();
  t: [1] HudTest; h := t[0].h[..];
  #assert day.lush == 1 && sty_grass_vertices(day) == 9 && hud_grass_vertices(h) == 9;
  h[0].bare = true;
  u := t[0].u[..];
  h[0].drop = 0;   // a wall, put where it rests, 4.5 m behind the character
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 0 -450 2000 600 100\n");
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_run(t[..], 100, 0.01);
  // the usual window (1600 by 1200 device pixels at 2: 800 CSS pixels wide): the whole field
  #assert u[STY_U_LUSH] == 1 && hud_grass(h) == HUD_GRASS_COLS * HUD_GRASS_ROWS && u[STY_U_GRASS + 2] == day.grass_cell && u[STY_U_GRASS_INFO + 3] == 60;
  // the things that have come to rest are told to the grass as rests, the nearest to the character first
  hud_test_run(t[..], 500, 0.01);
  n := cast(int) u[STY_U_PATH_INFO];
  // (the wall is 20 m long and 1 m through: a rest 19 m long, half a metre either side of its middle line)
  #assert n == 1 && u[STY_U_PATH + 5] == 1 && near(u[STY_U_PATH + 4], 0.5, 0.01) && near(abs(u[STY_U_PATH + 2] - u[STY_U_PATH]), 19, 0.05) && near(u[STY_U_PATH + 1], u[STY_U_PATH + 3], 0.01);
  b := h[0].things[..];
  first := -1; near: f64 = 0;
  for i: 0..<bd_count(b) { p := b[0].set[0].pos[i]; dx := p.x - cast(f64) h[0].cx; dz := p.z - cast(f64) h[0].cz; if first < 0 || dx * dx + dz * dz < near { first = i; near = dx * dx + dz * dz; } }
  p := b[0].set[0].pos[first];
  mx := (u[STY_U_PATH] + u[STY_U_PATH + 2]) * 0.5; mz := (u[STY_U_PATH + 1] + u[STY_U_PATH + 3]) * 0.5;
  #assert near(mx, cast(f32) p.x, 0.01) && near(mz, -cast(f32) p.z, 0.01);
  // a small window (600 CSS pixels wide): a field of HUD_GRASS_SMALL cells a side, 0.2 m apart, to 32 m
  m := hud_frame(h, t[0].out[..], u, 600, 900, 1, 0.01);
  #assert hud_grass(h) == HUD_GRASS_SMALL * HUD_GRASS_SMALL && near(u[STY_U_GRASS + 2], 0.2, 0.0001) && u[STY_U_GRASS_INFO + 3] == 32 && u[STY_U_GRASS + 3] == HUD_GRASS_SMALL && HUD_GRASS_SMALL * HUD_GRASS_SMALL * 6 < HUD_GRASS_COLS * HUD_GRASS_ROWS;
}

// The village's buildings as solids (docs/web-world.md, "The medieval village"): the one list of boxes.
// The list a new village's page tells its scene: the green's nine buildings (b2 to b10, as shared/game-types.coax
// gt_starter has them after its ball), then `more` lines of things besides, `extra` of them.
hud_test_green :: (h: [] Hud, extra: int, more: string) {
  s: [GT_STARTER_MAX] GtThing; n := gt_starter(GT_VILLAGE, s[..]); o := h[0].inbox[..];
  k := hud_test_put(o, 0, GT_GREEN + extra); o[k] = '\n'; k += 1;
  for i: 0..<n {
    m := gk_building(s[i].kind);
    if m < 0 { continue; }
    v := [10] int.[i + 1, 2, 1, 1, s[i].x, 0, s[i].z, m, vl_quarter(s[i].turn), s[i].scale];
    for q: 0..<10 { if v[q] < 0 { o[k] = '-'; k += 1; } k = hud_test_put(o, k, ifx v[q] < 0 then -v[q] else v[q]); o[k] = ' '; k += 1; }
    o[k] = '1'; o[k + 1] = '\n'; k += 2;
  }
  for c: more { o[k] = c; k += 1; }
  hud_message(h, HUD_BLOCKS_MSG, k);
}
hud_test_village :: (t: [] HudTest) {
  h := t[0].h[..]; h[0].bare = true;
  hud_test_say(h, HUD_KIND_MSG, "4"); hud_test_say(h, HUD_VIEW_MSG, "2");
  vl_test_ready(h[0].village[..]); hud_test_green(h, 0, ""); hud_statics(h);
  hud_test_run(t, 700, 0.016);
}
#test "the village's buildings are solid to everything: a ball bounces off a wall, a block lands on a roof, the character is stopped by a wall and lands on a roof, the tools' ray meets a wall, and it all repeats" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_village(t[..]);
  b := h[0].things[..];
  // every building of the green has risen: the world's solids are the village's, and each is a wall of the bodies' scene (none takes a body's room)
  s: [VL_SOLIDS * 6] f32; n := vl_solids(h[0].village[..], s[..]);
  #assert n == 7 && h[0].ns == n && b[0].count_x == n && h[0].nb == n && h[0].table_on && h[0].table_gen == 1;
  for k: 0..<n * 6 { #assert h[0].statics[k] == s[k] && h[0].boxes[k] == s[k]; }
  // the first house's long wall: x -14.4 to -7.15, z 12.45 to 13.9, 4.35 m high (the test pack's box, turned a quarter, 1.45 times its size)
  // a ball thrown at it from the green comes back, and is never inside it
  ball := bd_ball(b, 900, d3(-10.0, 0.3, 8.0), 0.3, HUD_BALL_DENSITY, HUD_BALL_FRICTION, HUD_BALL_BOUNCE, HUD_BALL_ROLL);
  b[0].set[0].vel[ball] = d3(0.0, 0.0, 7.0);
  far := 0.0; back := false;
  for k: 0..<200 { hud_test_run(t[..], 1, 0.016); i := bd_index(b, 900); z := b[0].set[0].pos[i].z; if z > far { far = z; } if b[0].set[0].vel[i].z < -0.5 { back = true; } }
  #assert far > 12.0 && far < 12.2 && back;
  // a block dropped over the wall's top rests on it; one dropped beside the house reaches the ground
  on := bd_box(b, 901, d3(-10.0, 8.0, 13.2), DQ.{}, d3(0.3, 0.3, 0.3), HUD_DENSITY, HUD_FRICTION, HUD_BOUNCE);
  off := bd_box(b, 902, d3(-10.0, 8.0, 10.0), DQ.{}, d3(0.3, 0.3, 0.3), HUD_DENSITY, HUD_FRICTION, HUD_BOUNCE);
  hud_test_run(t[..], 300, 0.016);
  #assert near(cast(f32) b[0].set[0].pos[bd_index(b, 901)].y, 4.35 + 0.3, 0.02) && near(cast(f32) b[0].set[0].pos[bd_index(b, 902)].y, 0.3, 0.02);
  // and under the eave (it hangs from 2.9 m up) a block reaches the ground too, while one dropped on the eave stays on it
  under := bd_box(b, 903, d3(-8.5, 1.0, 7.4), DQ.{}, d3(0.3, 0.3, 0.3), HUD_DENSITY, HUD_FRICTION, HUD_BOUNCE);
  over := bd_box(b, 904, d3(-8.5, 6.0, 7.4), DQ.{}, d3(0.3, 0.3, 0.3), HUD_DENSITY, HUD_FRICTION, HUD_BOUNCE);
  hud_test_run(t[..], 300, 0.016);
  #assert near(cast(f32) b[0].set[0].pos[bd_index(b, 903)].y, 0.3, 0.02) && near(cast(f32) b[0].set[0].pos[bd_index(b, 904)].y, 2.5 * 1.45 + 0.3, 0.02);
  // the character runs at the wall and is stopped a body's width short of it
  h[0].foot.walk.x = -12; h[0].foot.walk.z = 9;
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 150, 0.016); hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert h[0].cz > 11.9 && h[0].cz < 12.45 - HUD_BODY + 0.03 && near(h[0].cx, -12, 0.2);
  // put above the roof it comes down onto it, not through it
  h[0].foot.walk.x = -12; h[0].foot.walk.z = 13.2; h[0].foot.jump.y = 9; h[0].foot.jump.prev_y = 9; h[0].foot.jump.vy = 0;
  low: f32 = 100;
  for k: 0..<200 { hud_test_run(t[..], 1, 0.016); if h[0].cy < low { low = h[0].cy; } }
  #assert near(h[0].cy, 4.35, 0.02) && low > 4.3 && near(h[0].cz, 13.2, 0.05);
  // the tools' ray, through the pixel a point of the wall's face is drawn at, meets the wall there (and no thing)
  h[0].foot.walk.x = -10; h[0].foot.walk.z = 6; h[0].foot.jump.y = 0; h[0].foot.jump.prev_y = 0;
  hud_test_run(t[..], 200, 0.016);
  px := sty_project(t[0].u[..], -11.5, 2.0, -12.45);
  #assert px.ahead;
  h[0].tx = px.x; h[0].ty = px.y;
  at := hud_pick(h, true);
  #assert at.hit && at.body == -1 && near(at.z, 12.45, 0.05) && near(at.x, -11.5, 0.3) && near(at.y, 2.0, 0.3);
  // the same again from the start gives the same bodies, bit for bit
  u: [1] HudTest; g := u[0].h[..];
  hud_test_village(u[..]);
  c := g[0].things[..];
  b2 := bd_ball(c, 900, d3(-10.0, 0.3, 8.0), 0.3, HUD_BALL_DENSITY, HUD_BALL_FRICTION, HUD_BALL_BOUNCE, HUD_BALL_ROLL);
  c[0].set[0].vel[b2] = d3(0.0, 0.0, 7.0);
  w: [1] HudTest; e := w[0].h[..];
  hud_test_village(w[..]);
  d := e[0].things[..];
  b3 := bd_ball(d, 900, d3(-10.0, 0.3, 8.0), 0.3, HUD_BALL_DENSITY, HUD_BALL_FRICTION, HUD_BALL_BOUNCE, HUD_BALL_ROLL);
  d[0].set[0].vel[b3] = d3(0.0, 0.0, 7.0);
  for k: 0..<200 { hud_test_run(u[..], 1, 0.016); hud_test_run(w[..], 1, 0.016); #assert bd_digest(c) == bd_digest(d); }
  // leaving the village for the meadow takes the walls with it
  hud_test_say(h, HUD_KIND_MSG, "0");
  #assert h[0].ns == 0 && b[0].count_x == 0 && !h[0].table_on;
}

#test "a building placed since the world opened (the page's kind 2) stands at once and is solid, picked as its own id; a building tool's ghost is the real model, red where it meets the person, and a press asks the page to put it there, turned" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_village(t[..]);
  b := h[0].things[..]; v := h[0].village[..];
  n0 := h[0].ns; tg := h[0].table_gen; rg := h[0].rec_gen;
  // one building from the page: id 77, model 0 (the test pack's one), at x 20, z -10, a quarter turned, 1.45 times its size
  hud_test_green(h, 1, "77 2 1 1 2000 0 -1000 0 1 145\n");
  #assert v[0].nput == GT_GREEN + 1;
  #assert v[0].put_id[GT_GREEN] == 77 && v[0].put[GT_GREEN].quarter == 1 && v[0].put_rise[GT_GREEN] == -1 && v[0].put_rise[0] == 0;
  #assert h[0].ns == n0 + 3 && h[0].owner[n0] == 77 && h[0].owner[n0 + 2] == 77 && h[0].owner[0] == 2;
  #assert h[0].table_gen == tg + 1 && h[0].rec_gen > rg && h[0].nk == 0 && b[0].count_x == n0 + 3;
  // the same list again changes nothing
  tg = h[0].table_gen; hud_test_green(h, 1, "77 2 1 1 2000 0 -1000 0 1 145\n"); #assert h[0].table_gen == tg;
  // the test pack's model is 5 by 6 m (x by z) and 4 m high: turned a quarter and 1.45 times its size, 8.7 m along x and 7.25 m along z
  lo := [3] f32.[1e9, 1e9, 1e9]; hi := [3] f32.[-1e9, -1e9, -1e9];
  for q: n0..<n0 + 3 { for a: 0..<3 { if h[0].statics[q * 6 + a] < lo[a] { lo[a] = h[0].statics[q * 6 + a]; } if h[0].statics[q * 6 + a + 3] > hi[a] { hi[a] = h[0].statics[q * 6 + a + 3]; } } }
  #assert near(hi[0] - lo[0], 8.7, 0.01) && near(hi[2] - lo[2], 7.25, 0.01) && near(hi[1], 5.8, 0.01) && lo[0] > 15 && hi[0] < 25 && lo[2] > -15 && hi[2] < -5;
  // a block dropped over its tall wall rests on its top
  x := h[0].statics[n0 * 6..<n0 * 6 + 6];
  on := bd_box(b, 901, d3(cast(f64) (x[0] + x[3]) * 0.5, 9.0, cast(f64) (x[2] + x[5]) * 0.5), DQ.{}, d3(0.3, 0.3, 0.3), HUD_DENSITY, HUD_FRICTION, HUD_BOUNCE);
  hud_test_run(t[..], 300, 0.016);
  #assert near(cast(f32) b[0].set[0].pos[bd_index(b, 901)].y, 5.8 + 0.3, 0.02);
  gone := bd_remove(b, bd_index(b, 901));
  // a building tool (the line's tool 10, its quarter last): the ghost where the pointer meets the ground, on the half-metre grid
  h[0].tool = HUD_T_MODEL; h[0].mode = HUD_M_SNAP; h[0].quarter = 0;
  px := sty_project(t[0].u[..], h[0].cx - 2.2, 0, -h[0].cz);   // (the test model's side wall, 1.45 to 2.9 m along x, round the person)
  #assert px.ahead;
  h[0].tx = px.x; h[0].ty = px.y;
  aim := hud_aim_building(h);
  #assert aim.ok;
  #assert aim.blocked;
  #assert aim.why == HUD_L_ROOM;
  #assert aim.x % 50 == 0 && aim.z % 50 == 0;   // (it would stand in the person)
  hud_ghost_building(h);
  r := h[0].records[(HUD_KIT_RECORDS + VL_GHOST_AT) * HUD_RECORD_FLOATS..<(HUD_KIT_RECORDS + VL_GHOST_AT + 1) * HUD_RECORD_FLOATS];
  #assert v[0].ghost_on;
  #assert v[0].ghost_bad;
  #assert r[8] > 1.4 && r[9] < 0.5 && near(r[4], 1.45, 0.0001);
  // a press there asks nothing of the page and says why
  #assert hud_tool_press(h) && h[0].edit_n == 0 && h[0].limit == HUD_L_ROOM;
  h[0].limit = HUD_L_NONE;
  // further off, clear of it and of the green's: the ghost is the model's own colours, and a press puts it, turned as the page says
  h[0].quarter = 1;
  px = sty_project(t[0].u[..], h[0].cx, 0, -(h[0].cz + 14));
  h[0].tx = px.x; h[0].ty = px.y;
  aim = hud_aim_building(h);
  #assert aim.ok && !aim.blocked;
  hud_ghost_building(h);
  #assert v[0].ghost_on && !v[0].ghost_bad && r[8] < 1 && near(r[3], 1.5707963, 0.0001);
  #assert hud_tool_press(h) && h[0].edit_n > 0 && cast(string) h[0].edit[0..<17] == "put britons_house" && cast(string) h[0].edit[h[0].edit_n - 6..<h[0].edit_n] == " 90.00";
  h[0].edit_n = 0;
  // the wheel turns the tool's ghost (the page keeps the turn)
  #assert hud_tool_wheel(h, 1) && cast(string) h[0].edit[0..<h[0].edit_n] == "spin 1";
  h[0].edit_n = 0;
  // in edit mode the ray meets the building and picks it as its own id
  h[0].tool = -1; h[0].editing = true;
  px = sty_project(t[0].u[..], 20, 3, 7.1);
  if px.ahead { h[0].tx = px.x; h[0].ty = px.y; at := hud_pick(h, true); #assert at.hit && at.body == -1 && at.building == 77; }
  // the app's editor lights it (the world held still names it): its boxes' bounds, as lines
  out := [1] HudOut.[HudOut.{v = t[0].out[..], n = 0}];
  h[0].glow_n = 1; h[0].glow[0] = 77; h[0].glow_a[0] = 1; hud_still_draw(h, out[..], t[0].u[..], 1);
  lit := out[0].n; #assert lit > 0;
  h[0].glow[0] = 2; out[0].n = 0; hud_still_draw(h, out[..], t[0].u[..], 1); #assert out[0].n > 0;
  h[0].glow[0] = 99; out[0].n = 0; hud_still_draw(h, out[..], t[0].u[..], 1); #assert out[0].n == 0; h[0].glow_n = 0;
  // gone from the list, it is gone: its box, and the ghost with no tool; the green's are the level's too, and go when they do
  hud_test_green(h, 0, "");
  hud_ghost_building(h);
  #assert v[0].nput == GT_GREEN && h[0].ns == n0 && !v[0].ghost_on;
  hud_test_say(h, HUD_BLOCKS_MSG, "0\n");
  #assert v[0].nput == 0 && h[0].ns == 0;
}

// ---------------------------------------------------------------- crates (docs/web-world.md, "Crates")
// Level `room` (from 0) of a new crates game told to the scene as the page tells it: which room it is of
// the three, then its things (shared/game-types.coax gt_starter_level), named 1 and up in their order.
hud_test_room :: (h: [] Hud, room: int) {
  o := h[0].inbox[..]; m := hud_test_put(o, 0, room); o[m] = ' '; o[m + 1] = '3'; hud_message(h, HUD_ROOM_MSG, m + 2);
  s: [GT_STARTER_MAX] GtThing; n := gt_starter_level(GT_CRATES, room, s[..]);
  m = hud_test_put(o, 0, n); o[m] = '\n'; m += 1;
  for i: 0..<n {
    role := gk_role(s[i].kind);
    v := [10] int.[i + 1, ifx role > 0 then BL_ROLE_WIRE + role else 0, 1, 1, s[i].x, s[i].y, s[i].z, s[i].w, s[i].h, s[i].d];
    for q: 0..<10 { m = hud_test_put(o, m, v[q]); o[m] = ' '; m += 1; }
    o[m] = '2'; o[m + 1] = '\n'; m += 2;
  }
  hud_message(h, HUD_BLOCKS_MSG, m);
}
// The first crate of the room (the least id among them) among the bodies, or -1.
hud_test_crate :: (h: [] Hud) -> int { b := h[0].things[..]; i := -1; for j: 0..<bd_count(b) { if cr_is(b, j) && (i < 0 || b[0].id[j] < b[0].id[i]) { i = j; } } return i; }
// The puzzle up at room `room`, the camera down, its crates landed and at rest: where a recorded
// solution starts from (tools/crates-record.coax records from here, and the check below replays from here).
hud_test_crates :: (t: [] HudTest, room: int) {
  h := t[0].h[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "5"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_test_room(h, room);
  hud_crates_in(h);
  hud_test_run(t, 420, 0.016666668);
}
// The keys a recording's letters hold: w north, s south, a west, d east, j jump (x: none).
hud_test_keys :: (letters: string) -> int {
  bits := 0;
  for ch: letters { if ch == 'j' { bits |= HUD_KEY_JUMP; } if ch == 'w' { bits |= HUD_KEY_FORE; } if ch == 's' { bits |= HUD_KEY_BACK; } if ch == 'a' { bits |= HUD_KEY_LEFT; } if ch == 'd' { bits |= HUD_KEY_RIGHT; } }
  return bits;
}
// A recording replayed: runs of letters and a count of frames, 60 frames a second. How many frames it ran.
hud_test_replay :: (t: [] HudTest, rec: string) -> int {
  h := t[0].h[..]; i := 0; frames := 0; text: [16] u8;
  while i < rec.count {
    from := i;
    while i < rec.count && (rec[i] < '0' || rec[i] > '9') { i += 1; }
    bits := hud_test_keys(cast(string) rec[from..<i]);
    n := 0;
    while i < rec.count && rec[i] >= '0' && rec[i] <= '9' { n = n * 10 + cast(int) (rec[i] - '0'); i += 1; }
    m := hud_test_put(text[..], 0, bits);
    hud_test_say(h, HUD_KEYS_MSG, cast(string) text[0..<m]);
    hud_test_run(t, n, 0.016666668); frames += n;
  }
  hud_test_say(h, HUD_KEYS_MSG, "0");
  return frames;
}
#test "crates: every room a new game starts with, told as the level's things: its recorded solution, replayed through the real character and the real bodies, lights every pad, opens the gate and walks out, and the next level is wanted" #steps 2000000000000 {
  t: [1] HudTest; h := t[0].h[..]; c := h[0].crates[..]; b := h[0].things[..];
  recs := cr_solutions();
  for room: 0..<CR_ROOMS {
    hud_test_crates(t[..], room);
    // landed, at rest, nothing lit, the gate shut and solid, the camera the engine's top-down kind, and the grass and the sunrise not begun
    #assert c[0].ok && c[0].room == room && c[0].rooms == 3;
    #assert c[0].cleared == room && !c[0].solved && !c[0].through && c[0].lit == 0;
    #assert bd_sleeping(b) == room + 1;   // (its crates: a wall is fixed, and never sleeps)
    #assert c[0].r[0].ng == room + 1 && h[0].nmk == room + 3;
    #assert h[0].kind == CAM_KIND_TOP && h[0].orbit.pivot.x == 0 && h[0].orbit.pivot.z == 0 && h[0].orbit.want == hud_camera_kind(h).far && h[0].spread == 0 && h[0].dawn == 0 && h[0].blades == 0 && h[0].ns == 1 && h[0].ns == cr_solids(c, h[0].statics[..]) && h[0].things[0].count_x == h[0].ns;
    said := false;
    frames := 0; rec := recs[room];
    frames = hud_test_replay(t[..], rec);
    #assert frames > 60 && frames < 60 * 90;
    // out through the gate: the room is cleared and the next level wanted, told to the page once ("room next")
    for k: 0..<30 { if hud_action(h) == HUD_EDIT && cast(string) h[0].outbox[0..<hud_outbox_len(h)] == "room next" { said = true; } hud_action_done(h); hud_test_run(t[..], 1, 0.016666668); }
    #assert c[0].cleared == room + 1 && c[0].room == room && c[0].solved && c[0].through && c[0].lit == (1 << (room + 1)) - 1 && h[0].ns == 0 && (said || cast(string) h[0].edit[0..<h[0].edit_n] == "room next");
    // the camera never came in from its place over the room, whatever stood or fell in the middle of it
    #assert h[0].orbit.shown > hud_camera_kind(h).far - 0.5;
  }
  // the page tells the first room again (the game's levels go round): what stood in the third is gone, the room is entered with its things
  hud_test_room(h, 0);
  #assert c[0].room == 0 && !c[0].solved && !c[0].through && c[0].clock == 0 && c[0].cleared == 3 && bd_count(b) == 6 && h[0].nk == 6 && h[0].nmk == 3 && h[0].ns == 1 && h[0].cx == c[0].r[0].sx;
}
#test "crates: nothing jumps or flies there; the page's action resets the room; the page is told the room's state; pushed crates are never told as the level's; a game of one level is the same room again; and leaving for the meadow takes the room" #steps 2000000000000 {
  t: [1] HudTest; h := t[0].h[..]; c := h[0].crates[..]; b := h[0].things[..];
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2 0");
  hud_test_crates(t[..], 0);
  s := cr_start(c); #assert h[0].cx == s.x && h[0].cz == s.z && h[0].act == 0 && s.x == -3 && s.z == 0;
  // Space, held and tapped twice: it stays on the floor and does not fly
  for k: 0..<4 { hud_test_say(h, HUD_KEYS_MSG, "16"); hud_test_run(t[..], 4, 0.016666668); hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 4, 0.016666668); #assert h[0].cy == 0 && !h[0].fly.on; }
  // what the page is told (action HUD_SAYS), once the other words are out
  told := false;
  for k: 0..<200 { hud_test_run(t[..], 1, 0.016666668); if hud_action(h) == HUD_SAYS { told = cr_test_has(cast(string) h[0].outbox[0..<h[0].out_n], "room 1 of 3. pads lit: 0 of 1"); } hud_action_done(h); }
  #assert told;
  // push the crate east a way: it never tips, and where it is pushed to is not told as the level's (HUD_SETTLED)
  i := hud_test_crate(h); x0 := 0.0;
  #assert i >= 0 && b[0].set[0].pos[i].x == x0 && b[0].half[i].x == CR_HALF && near_d(b[0].set[0].mass[i], CR_DENSITY * 0.729, 0.001) && b[0].friction[i] == CR_FRICTION;
  hud_test_say(h, HUD_KEYS_MSG, "8"); settled := false;
  for k: 0..<90 { hud_test_run(t[..], 1, 0.016666668); if hud_action(h) == HUD_SETTLED { settled = true; } hud_action_done(h); }
  hud_test_say(h, HUD_KEYS_MSG, "0");
  for k: 0..<120 { hud_test_run(t[..], 1, 0.016666668); if hud_action(h) == HUD_SETTLED { settled = true; } hud_action_done(h); }
  i = hud_test_crate(h); #assert b[0].set[0].pos[i].x > x0 + 0.5 && h[0].cx > s.x + 1 && !settled && b[0].set[0].att[i].w == 1;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2 0"); #assert c[0].resets == 0;       // the same count: no press
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2 1");
  i = hud_test_crate(h);
  #assert c[0].resets == 1 && c[0].room == 0 && c[0].clock == 0 && b[0].set[0].pos[i].x == x0 && b[0].set[0].pos[i].y > 2 && h[0].cx == s.x && h[0].cz == s.z && bd_count(b) == 6;
  // the walls keep the character in: run west for two seconds and it is still east of the west wall
  hud_test_say(h, HUD_KEYS_MSG, "4"); hud_test_run(t[..], 120, 0.016666668); hud_test_say(h, HUD_KEYS_MSG, "0");
  west := c[0].x0 + f32(CR_CELL);
  #assert h[0].cx > west + 0.25 && h[0].cx < west + 0.4;
  // a game of one level: solved and out through the gate, it is the same room again, from the start
  hud_test_say(h, HUD_ROOM_MSG, "0 1");
  #assert c[0].rooms == 1 && c[0].room == 0 && bd_count(b) == 6;
  hud_crates_in(h); hud_test_run(t[..], 420, 0.016666668);
  frames := hud_test_replay(t[..], cr_solutions()[0]);
  #assert frames > 60 && c[0].cleared == 1 && !c[0].solved && !c[0].through && c[0].clock < 0.5 && h[0].edit_n == 0 && h[0].cx == s.x && h[0].ns == 1;
  // a room the page names that the game has not is no room
  hud_test_say(h, HUD_ROOM_MSG, "3 3"); #assert c[0].room == 0 && c[0].rooms == 1;
  // the meadow again: no room, no gate; its things are the page's to tell
  hud_test_say(h, HUD_KIND_MSG, "2");
  #assert !c[0].ok && h[0].ns == 0 && b[0].count_x == 0 && hud_meadow(h) && !hud_no_jump(h);
}
#test "crates: the room is the level's things: a wall moved, the floor reaches it; the gate put on the north side, the way out is north; a pad added must hold a crate too; the start moved, you start there" #steps 2000000000000 {
  t: [1] HudTest; h := t[0].h[..]; c := h[0].crates[..]; b := h[0].things[..];
  hud_test_crates(t[..], 0);
  #assert c[0].x0 == -5.25 && c[0].x1 == 5.25 && c[0].z0 == -3.75 && c[0].z1 == 3.75 && c[0].out_x == 1 && c[0].r[0].ng == 1 && c[0].r[0].started;
  // room 1 as the page tells it, with its things changed: the north wall (thing 1) a metre further north, a pad
  // more (thing 10), the start (thing 9) two metres east; then the gate (thing 8) on the north side
  s: [GT_STARTER_MAX] GtThing; n := gt_starter_level(GT_CRATES, 0, s[..]);
  s[0].z += 100; s[8].x += 200; s[n] = GtThing.{kind = GK_CRATE_GOAL, x = -150, z = -150, w = 120, h = 4, d = 120}; n += 1;
  for pass: 0..<2 {
    if pass == 1 { s[7].x = 0; s[7].z = 450; }
    o := h[0].inbox[..]; m := hud_test_put(o, 0, n); o[m] = '\n'; m += 1;
    for i: 0..<n {
      role := gk_role(s[i].kind);
      v := [10] int.[i + 1, ifx role > 0 then BL_ROLE_WIRE + role else 0, ifx i == 0 || i == 8 then 2 else ifx i == 7 then 1 + pass else 1, 1, s[i].x, s[i].y, s[i].z, s[i].w, s[i].h, s[i].d];
      for q: 0..<10 { m = hud_test_put(o, m, v[q]); o[m] = ' '; m += 1; }
      o[m] = '2'; o[m + 1] = '\n'; m += 2;
    }
    hud_message(h, HUD_BLOCKS_MSG, m);
    if pass == 0 { #assert c[0].z1 == 4.75 && c[0].x1 == 5.25 && c[0].out_x == 1 && c[0].r[0].ng == 2 && c[0].r[0].sx == -1 && h[0].cx == -3 && h[0].ns == 1 && c[0].clock > 1; }
  }
  #assert c[0].out_x == 0 && c[0].out_z == 1 && c[0].z1 == 5.25 && h[0].ns == 1 && h[0].statics[2] == 3.75 && h[0].statics[5] == 5.25;
  // the room reset: you start where the start is now; one crate on its pad does not solve a room of two pads
  hud_crates_in(h); #assert h[0].cx == -1 && h[0].cz == 0;
  i := hud_test_crate(h); bd_place(b, i, d3(1.5, CR_HALF, 1.5), DQ.{}); bd_still(b, i);
  hud_test_run(t[..], 3, 0.016666668);
  #assert c[0].lit == 1 && !c[0].solved;
}

#test "a limit the tools or the character meet is told to the page, to be said in words: the world full, the sky, a size at its end; never while an edit is waiting" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  b := h[0].things[..];
  // which limit refuses a place: none; the world's bounds; the world full (balls and blocks alike)
  #assert hud_room_why(h, HUD_T_BLOCK, 0, 0) == HUD_L_NONE && hud_room(h, HUD_T_BALL, 0, 0) && hud_room_why(h, HUD_T_BLOCK, 20001, 0) == HUD_L_FAR && hud_room_why(h, HUD_T_BLOCK, -20001, 0) == HUD_L_FAR && hud_room_why(h, HUD_T_BLOCK, 0, 20001) == HUD_L_FAR && hud_room_why(h, HUD_T_BLOCK, 0, -20001) == HUD_L_FAR && hud_room_why(h, HUD_T_BLOCK, 20000, -20000) == HUD_L_NONE;
  nk := h[0].nk; h[0].nk = HUD_BLOCKS; #assert hud_room_why(h, HUD_T_BLOCK, 0, 0) == HUD_L_FULL && hud_room_why(h, HUD_T_BALL, 0, 0) == HUD_L_FULL && !hud_room(h, HUD_T_BLOCK, 0, 0) && hud_room_why(h, HUD_T_BLOCK, 20001, 0) == HUD_L_FAR;
  h[0].nk = HUD_BLOCKS - 1; #assert hud_room(h, HUD_T_BLOCK, 0, 0); h[0].nk = nk;
  hud_test_say(h, HUD_BLOCKS_MSG, "11\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 1 1 1 1000 0 1000 60 60 60 1\n6 1 1 1 1100 0 1000 60 60 60 1\n7 1 1 1 1200 0 1000 60 60 60 1\n8 1 1 1 1300 0 1000 60 60 60 1\n9 1 1 1 1400 0 1000 60 60 60 1\n10 1 1 1 1500 0 1000 60 60 60 1\n11 1 1 1 1600 0 1000 60 60 60 1\n");
  #assert hud_room_why(h, HUD_T_BALL, 0, 0) == HUD_L_NONE && hud_room_why(h, HUD_T_BLOCK, 0, 0) == HUD_L_NONE && hud_room_why(h, HUD_T_SLAB, 0, 0) == HUD_L_NONE;
  // the ball tool pressed with the world full: nothing is placed, and the page is told which limit
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 1");
  g := hud_test_point(t[..], 2.2, 0, 3.1);
  nk = h[0].nk; h[0].nk = HUD_BLOCKS;
  aim := hud_aim(h); #assert aim.ok && aim.blocked && aim.why == HUD_L_FULL;
  #assert hud_test_click(t[..], g) == "limit full" && h[0].limit == HUD_L_NONE && hud_test_edit(t[..]) == "";
  h[0].nk = nk;
  // a limit waits its turn behind an edit, and is not lost: the edit first, then the words
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  h[0].limit = HUD_L_SKY; said := hud_test_click(t[..], g);
  #assert cast(string) said[0..<6] == "place " && hud_test_edit(t[..]) == "limit sky" && hud_test_edit(t[..]) == "";
  // a limit that is none, or no limit at all, says nothing
  h[0].limit = HUD_L_COUNT; #assert hud_test_edit(t[..]) == ""; h[0].limit = -1; #assert hud_test_edit(t[..]) == ""; h[0].limit = HUD_L_NONE;
  words := HUD_L_WORDS; #assert words[HUD_L_FULL] == "limit full" && words[HUD_L_ROOM] == "limit room" && words[HUD_L_FAR] == "limit far" && words[HUD_L_SIZE] == "limit size" && words[HUD_L_SKY] == "limit sky" && words[0] == "";
  // the wheel on the selected thing at its biggest: it grows no more, and the page is told the size is at its end
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n3 0 1 2 0 0 800 1200 200 100\n"); hud_test_run(t[..], 60, 0.01);
  hud_test_say(h, HUD_TOOL_MSG, "-1 1 3 10 0 1");
  g = hud_test_point(t[..], 0, 1.0, 7.5); #assert hud_pick(h, true).body == bd_index(b, 3);
  hud_test_say(h, HUD_WHEEL_MSG, "-100 0");
  #assert hud_test_edit(t[..]) == "size b3 12.00 1.00 2.00" && hud_test_edit(t[..]) == "limit size";
  // and one notch inside its range says nothing of a limit
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n3 0 1 3 0 0 800 400 200 100\n"); hud_test_run(t[..], 60, 0.01);
  g = hud_test_point(t[..], 0, 1.0, 7.5); hud_test_say(h, HUD_WHEEL_MSG, "-100 0");
  said = hud_test_edit(t[..]); #assert cast(string) said[0..<8] == "size b3 " && hud_test_edit(t[..]) == "";
}

#test "the sky's limit is said once each time the character gets there, and again only after it has come a metre down" #steps 4000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 0 0 1");   // no gravity: a jump keeps rising
  hud_test_say(h, HUD_KEYS_MSG, "16"); hud_test_run(t[..], 5, 0.01); hud_test_say(h, HUD_KEYS_MSG, "0");
  told := 0;
  for q: 0..<4000 { hud_test_run(t[..], 1, 0.01); if hud_action(h) == HUD_EDIT { if cast(string) h[0].outbox[0..<hud_outbox_len(h)] == "limit sky" { told += 1; } } if hud_action(h) != 0 { hud_action_done(h); } if told > 0 && q > 3000 { break; } }
  #assert h[0].cy == HUD_SKY && told == 1 && h[0].atop;
  // gravity back: it falls; under the limit by a metre the next arrival is said again
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 1"); hud_test_run(t[..], 60, 0.01);
  #assert h[0].cy < HUD_SKY - 1 && !h[0].atop;
}

// ---------------------------------------------------------------- the world's properties (web/props.coax)

// A jump with Space held, let go at its top, and Space pressed again in the air and held: how high it got. It ends on the ground.
hud_test_hop :: (t: [] HudTest) -> f32 {
  h := t[0].h[..]; top: f32 = 0;
  hud_test_put_keys(h, 16);
  for k: 0..<32 { hud_test_run(t, 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  hud_test_put_keys(h, 0); hud_test_run(t, 2, 0.01);
  hud_test_put_keys(h, 16);
  for k: 0..<60 { hud_test_run(t, 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  hud_test_put_keys(h, 0);
  for k: 0..<400 { hud_test_run(t, 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  return top;
}
#test "disable double jump: player.air_jumps and player.fly are the registry's. With flying off the air jump is back and two quick presses do not fly; with air jumps off the jump rule refuses a jump in the air; flying turned off in the air falls; side on, the air jump is the registry's too" #steps 4000000000 #traversal 600000000 {
  t: [2] HudTest; h := t[0].h[..];
  hud_test_built(t[..], "0");
  // as the world starts: it may fly, and while it may there is no air jump
  #assert hud_may_fly(h) && hud_tuning(h).air_jumps == 0;
  // flying off: the registry's one air jump is back. A jump and a second press in the air go far higher than one jump, and never fly
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.fly=off\n");
  #assert !hud_may_fly(h) && hud_tuning(h).air_jumps == 1;
  top := hud_test_hop(t[..]);
  #assert top > 3.0 && top < 4.2 && !h[0].fly.on && h[0].cy == 0;
  hud_test_space(t[..], 0, 5); hud_test_space(t[..], 0, 5); #assert !h[0].fly.on;
  hud_test_run(t[..], 300, 0.01); #assert h[0].cy == 0;
  // air jumps off as well: the second press in the air is refused, and it is one jump of 1.67 m
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.air_jumps=0\nplayer.fly=off\n");
  #assert hud_tuning(h).air_jumps == 0 && !hud_may_fly(h);
  top = hud_test_hop(t[..]);
  #assert near(top, 1.67, 0.06) && h[0].foot.jump.air_used == 0 && !h[0].fly.on && h[0].cy == 0;
  // two air jumps: higher than with one
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.air_jumps=2\nplayer.fly=off\n");
  #assert hud_tuning(h).air_jumps == 2;
  // air jumps off and flying left on: two quick presses still fly (flight is its own setting)
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.air_jumps=0\n");
  #assert hud_may_fly(h) && hud_tuning(h).air_jumps == 0;
  hud_test_space(t[..], 0, 5); hud_test_space(t[..], 0, 5); #assert h[0].fly.on && h[0].cy > 0.3;
  // flying turned off while it flies: it falls under the world's gravity and lands
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.air_jumps=0\nplayer.fly=off\n");
  hud_test_run(t[..], 300, 0.01); #assert !h[0].fly.on && h[0].cy == 0 && !sr_jump_airborne(h[0].foot.jump);
  // the properties told with nothing in them: as the world starts
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\n"); #assert hud_may_fly(h) && hud_tuning(h).air_jumps == 0 && h[0].props[0].over[0].n == 0;
  // text that is no map of the registry changes nothing
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.air_jumps=9\n"); hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.wings=on\n"); #assert h[0].props[0].over[0].n == 0;
  // side on: it never flies, whatever player.fly says, and its air jump is the registry's
  s := t[1].h[..];
  hud_test_built(t[1..<2], "3");
  #assert !hud_may_fly(s) && hud_tuning(s).air_jumps == 1;
  top = hud_test_hop(t[1..<2]); #assert top > 3.0;
  hud_test_say(s, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.air_jumps=0\n"); #assert hud_tuning(s).air_jumps == 0 && !hud_may_fly(s);
  top = hud_test_hop(t[1..<2]); #assert near(top, 1.67, 0.06) && s[0].foot.jump.air_used == 0;
}
#test "the world's properties reach the things: gravity, and a thing's bounce, friction, weight and being fixed, for one thing, a kind or all; told again nothing is touched; a new thing is made of what they say; put back, the world's own numbers" #steps 4000000000 #traversal 600000000 {
  t: [1] HudTest; h := t[0].h[..]; b := h[0].things[..];
  hud_test_built(t[..], "0");
  // gravity is the registry's: told with the properties, the line's own number is passed over
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 30 0 2\nworld.gravity=0.5\n"); #assert near(h[0].grav, 0.5, 0.0001) && abs(b[0].gravity + 4.905) < 0.000001 && h[0].grav_n == 5 && hud_tuning(h).gravity == 16;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 30 0 2\n"); #assert h[0].grav == 1 && b[0].gravity == HUD_GRAVITY;
  // told without them (the hotbar's line alone), its number is the registry's world.gravity
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 30 0"); #assert near(h[0].grav, 3, 0.0001) && pr_value(h[0].props[..], TW_GRAVITY) == 300;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0"); #assert h[0].grav == 1 && h[0].props[0].over[0].n == 0;
  // the world's own numbers, as before the registry
  i1 := bd_index(b, 1); i2 := bd_index(b, 2); i3 := bd_index(b, 3); i4 := bd_index(b, 4);
  #assert b[0].bounce[i4] == HUD_BALL_BOUNCE && b[0].friction[i4] == HUD_BALL_FRICTION && b[0].friction[i1] == HUD_FRICTION && b[0].bounce[i1] == HUD_BOUNCE && near_d(b[0].set[0].mass[i1], 800, 0.000001) && near_d(b[0].set[0].mass[i4], 40.0 * 4.18879 * 0.027, 0.001);
  // one ball bouncier, one block heavy, every block slippery, one block fixed
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nthing.bounce@4=0.9\nthing.friction@-1=0.1\nthing.density@1=2000\nthing.fixed@2=on\n");
  #assert b[0].bounce[i4] == 0.9 && b[0].friction[i4] == HUD_BALL_FRICTION && near_d(b[0].set[0].mass[i1], 8000, 0.000001) && b[0].friction[i1] == 0.1 && b[0].friction[i3] == 0.1 && bd_fixed(b, i2) && !bd_fixed(b, i1) && b[0].bounce[i1] == HUD_BOUNCE;
  // the same said again touches nothing: a body's material is made again only when it is not what the registry says
  hud_test_run(t[..], 300, 0.01); d := bd_digest(b);
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nthing.bounce@4=0.9\nthing.friction@-1=0.1\nthing.density@1=2000\nthing.fixed@2=on\n"); #assert bd_digest(b) == d;
  // the heavy block is harder to push: resized, it keeps its weight for its size; the fixed one is not moved by a run at it
  hud_resize(h, i1, 1.0, 1.0, 1.0); #assert near_d(b[0].set[0].mass[i1], 2000, 0.000001);
  // for every thing: one value, and a new thing is made of it from the start (a fixed one where it is to stand, not above it)
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nthing.bounce=0.5\nthing.density=1000\nthing.fixed@6=on\n");
  #assert b[0].bounce[i4] == 0.5 && b[0].bounce[i1] == 0.5 && !bd_fixed(b, i2) && b[0].friction[i1] == HUD_FRICTION && near_d(b[0].set[0].mass[i1], 1000, 0.000001);
  hud_test_say(h, HUD_BLOCKS_MSG, "6\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 600 0 0 100 100 100\n6 0 1 1 900 0 0 100 100 100\n");
  i5 := bd_index(b, 5); i6 := bd_index(b, 6);
  #assert i5 >= 0 && b[0].bounce[i5] == 0.5 && near_d(b[0].set[0].mass[i5], 1000, 0.000001) && b[0].set[0].pos[i5].y > 3.0 && bd_fixed(b, i6) && b[0].set[0].pos[i6].y == 0.5;
  hud_test_run(t[..], 300, 0.01); #assert b[0].set[0].pos[bd_index(b, 6)].y == 0.5 && near_d(b[0].set[0].pos[bd_index(b, 5)].y, 0.5, 0.02);
  // put back: every body is as the world makes it
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\n");
  i1 = bd_index(b, 1); i4 = bd_index(b, 4); i6 = bd_index(b, 6);
  #assert b[0].bounce[i4] == HUD_BALL_BOUNCE && b[0].bounce[i1] == HUD_BOUNCE && near_d(b[0].set[0].mass[i1], 200, 0.000001) && !bd_fixed(b, i6) && near_d(b[0].set[0].mass[i6], 200, 0.000001);
  // "disable physics": world.physics off holds every thing where it is (a new one too, in the air where it was put); on again they fall
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nworld.physics=off\n");
  for i: 0..<bd_count(b) { #assert bd_fixed(b, i); }
  hud_test_say(h, HUD_BLOCKS_MSG, "7\n1 0 1 1 -300 0 400 200 100 200\n2 0 1 1 300 0 500 100 300 100\n3 0 1 1 0 0 800 600 200 100\n4 1 1 1 80 0 300 60 60 60\n5 0 1 1 600 0 0 100 100 100\n6 0 1 1 900 0 0 100 100 100\n7 0 1 1 -900 300 0 100 100 100\n");
  i7 := bd_index(b, 7); #assert i7 >= 0 && bd_fixed(b, i7); y7 := b[0].set[0].pos[i7].y; #assert near_d(y7, 3.5, 0.001);
  hud_test_run(t[..], 300, 0.01); #assert b[0].set[0].pos[bd_index(b, 7)].y == y7;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\n");
  i7 = bd_index(b, 7); #assert !bd_fixed(b, i7);
  hud_test_run(t[..], 300, 0.01); #assert near_d(b[0].set[0].pos[bd_index(b, 7)].y, 0.5, 0.02);
}
#test "the world's properties reach the character, time, the sky, the grass and the camera: its run and its jump's height, its push, time's pace, the time of day, the haze, the wind, the grass, the camera's distance, lens and follow" #steps 4000000000 #traversal 600000000 {
  t: [1] HudTest; h := t[0].h[..]; b := h[0].things[..];
  hud_test_built(t[..], "0");
  base := hud_tuning(h);
  #assert base.walk_speed == 6.9 && base.jump_speed == 10.6;
  // it runs at the speed asked, and a jump is as high as asked at normal gravity
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.fly=off\nplayer.air_jumps=0\nplayer.run_speed=12\nplayer.jump_height=4\n");
  #assert near(hud_tuning(h).walk_speed, 12, 0.0001) && near(hud_tuning(h).jump_speed, 10.6 * sqrt(4.0 / 1.67), 0.001);
  top: f32 = 0;
  hud_test_put_keys(h, 16); for k: 0..<90 { hud_test_run(t[..], 1, 0.01); if h[0].cy > top { top = h[0].cy; } }
  hud_test_put_keys(h, 0); hud_test_run(t[..], 300, 0.01);
  #assert near(top, 4.0, 0.15) && h[0].cy == 0;
  hud_test_put_keys(h, 2); hud_test_run(t[..], 150, 0.01); #assert near(h[0].foot.walk.speed, 12, 0.05); hud_test_put_keys(h, 0); hud_test_run(t[..], 100, 0.01);
  // no jump at all at a height of nothing
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.fly=off\nplayer.jump_height=0\n"); top = hud_test_hop(t[..]); #assert top == 0 && hud_tuning(h).walk_speed == 6.9;
  // its push: the mover's force, times what is asked
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.push_strength=2.5\n"); hud_test_run(t[..], 2, 0.01); #assert b[0].movers[0].force == 30000.0;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nplayer.push_strength=0\n"); hud_test_run(t[..], 2, 0.01); #assert b[0].movers[0].force == 0.0;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\n"); hud_test_run(t[..], 2, 0.01); #assert b[0].movers[0].force == HUD_PUSH;
  // time's pace: the things make half the steps at half the pace, twice at double
  s0 := b[0].steps; hud_test_run(t[..], 120, 0.01); one := b[0].steps - s0;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nworld.time_scale=0.5\n"); s0 = b[0].steps; hud_test_run(t[..], 120, 0.01); half := b[0].steps - s0;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nworld.time_scale=2\n"); s0 = b[0].steps; hud_test_run(t[..], 120, 0.01); two := b[0].steps - s0;
  #assert one >= 71 && one <= 73 && half >= 35 && half <= 37 && two >= 143 && two <= 145;
  // the time of day: the sun stops where it is asked to, goes back down to an earlier one, and comes up again to day
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nworld.time_of_day=sunrise\n"); hud_test_run(t[..], 60, 0.1);
  #assert near(h[0].dawn, HUD_SUNRISE * 0.46, 0.0001);
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nworld.time_of_day=night\n"); hud_test_run(t[..], 60, 0.1); #assert h[0].dawn == 0;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\n"); hud_test_run(t[..], 130, 0.1); #assert h[0].dawn == HUD_SUNRISE;
  // the haze, the wind and the grass, as the frame's uniforms have them
  u := t[0].u[..];
  hud_test_run(t[..], 1, 0.01); haze := u[STY_U_HAZE + 3]; bend := u[STY_U_WIND + 2]; blade := u[STY_U_GRASS_INFO + 1]; cell := u[STY_U_GRASS + 2];
  #assert near(bend, 0.3, 0.00001) && near(blade, 0.46, 0.00001) && near(cell, 0.16, 0.00001) && haze > 0;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nworld.wind=2\nworld.haze=3\ngrass.height=1\ngrass.density=1.5\n"); hud_test_run(t[..], 1, 0.01);
  #assert near(u[STY_U_WIND + 2], 0.6, 0.00001) && near(u[STY_U_HAZE + 3], haze * 3, 0.00001) && near(u[STY_U_GRASS_INFO + 1], 1.0, 0.00001) && near(u[STY_U_GRASS + 2], 0.16 / sqrt(1.5), 0.00001) && u[STY_U_GRASS_INFO + 3] <= 480 * u[STY_U_GRASS + 2] - 5;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\nworld.wind=0\nworld.haze=0\ngrass.density=0.5\n"); hud_test_run(t[..], 1, 0.01);
  #assert u[STY_U_WIND + 2] == 0 && u[STY_U_HAZE + 3] == 0 && near(u[STY_U_GRASS + 2], 0.16 / sqrt(0.5), 0.00001) && near(u[STY_U_GRASS_INFO + 3], 60, 0.0001);
  // the camera: its distance is given to the orbit when it is set (and the wheel zooms from there), its lens when one is asked, and the follow camera
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 1 2\ncamera.distance=4\ncamera.fov=90\ncamera.view=follow\n");
  #assert h[0].orbit.want == 4 && near(hud_camera(h, 1200, 2).fov, 1.5707963, 0.0001) && h[0].follow;
  hud_test_say(h, HUD_WHEEL_MSG, "400 0"); far := h[0].orbit.want; #assert far > 4;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 1 2\ncamera.distance=4\ncamera.fov=90\ncamera.view=follow\n"); #assert h[0].orbit.want == far;
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\n"); #assert h[0].orbit.want == 9.5 && hud_camera(h, 1200, 2).fov == HUD_FOV && !h[0].follow;
  // the next entrance ends at the distance asked
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 10 0 2\ncamera.distance=6\n"); hud_test_say(h, HUD_VIEW_MSG, "0"); hud_test_run(t[..], 300, 0.01); hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 500, 0.01);
  #assert h[0].orbiting && h[0].orbit.want == 6;
}

// ---------------------------------------------------------------- platformer (docs/web-world.md, "Platformer")
// The course up, the camera beside it, the character standing at the start with nothing held:
// where the recorded run starts from (tools/platformer-record.coax records from here, and the check below replays from here).
hud_test_plat :: (t: [] HudTest) {
  h := t[0].h[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "6"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_plat_in(h);
  hud_test_run(t, 84, 0.016666668);
}
#test "platformer: the recorded run, replayed through the real character, the walk rules and the course, touches every checkpoint in order and reaches the goal in two to three minutes without a fall" #steps 2000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; p := h[0].plat[..];
  hud_test_plat(t[..]);
  #assert pf_up(p) && p[0].run.going && h[0].kind == CAM_KIND_SIDE && h[0].orbiting && h[0].ns > 0 && near(h[0].cy, PF_START, 0.05) && pf_ground(p) == PF_NO_GROUND;
  #assert hud_tuning(h).air_jumps == 1 && !h[0].fly.on;
  frames := hud_test_replay(t[..], PF_SOLUTION);
  #assert p[0].run.done && p[0].falls == 0 && p[0].run.clock > 120 && p[0].run.clock < 180 && course_taken(p[0].taken[..]) > p[0].c[0].shards / 2;
  #assert frames > 120 * 60 && h[0].cz > p[0].c[0].end - 20;
}
#test "platformer: built in like any world: a platform the chat puts over the character's head is held there (no ground under the course), drawn and stood on; the page is told how high the feet are; the shapes tool places on the character's line where the pointer is" #steps 2000000000000 {
  t: [1] HudTest; h := t[0].h[..]; p := h[0].plat[..]; b := h[0].things[..];
  hud_test_plat(t[..]);
  #assert near(h[0].cz, 2, 0.3) && near(h[0].cy, PF_START, 0.05) && h[0].cx == 0;
  // what the HUD tells the page of where it stands: the feet's height after the word for flying
  said := false;
  for k: 0..<60 { hud_test_run(t[..], 1, 0.016666668); if hud_action(h) == HUD_WHERE { w := cast(string) h[0].outbox[0..<h[0].out_n]; said = hud_test_ends(w, " 0 400") && cast(string) w[0..<6] == "0 200 "; } hud_action_done(h); if said { break; } }
  #assert said;
  // "add a platform above my head": the chat's slab, 3 by 3 by 0.5, its bottom 2.6 over the feet, at rest
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 660 200 300 50 300 1\n");
  i := bd_index(b, 1);
  #assert i >= 0 && near_d(b[0].set[0].pos[i].y, 6.85, 0.001);
  hud_test_run(t[..], 240, 0.016666668);
  // held: still where it was put, though nothing is under it
  i = bd_index(b, 1); #assert near_d(b[0].set[0].pos[i].y, 6.85, 0.001) && near_d(b[0].set[0].pos[i].z, 2, 0.001) && b[0].set[0].inv_mass[i] == 0;
  // solid: feet over it stand on its top, and it is in the scene's mesh
  #assert near(hud_floor(h, 0, 2, 7.6), 7.1, 0.01) && near(hud_floor(h, 0, 2, 6.0), PF_START, 0.05);
  h[0].bare = false; hud_build(h, true); n := h[0].mesh_n; hud_test_say(h, HUD_BLOCKS_MSG, "0\n"); hud_build(h, true);
  #assert h[0].mesh_n < n && bd_count(b) == 0;
  // the shapes tool, side on: a cube where the pointer is in the air on the character's line, set down at rest there
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  g := hud_test_point(t[..], 0, 9, 6);
  aim := hud_aim(h); #assert aim.ok && !aim.blocked && aim.x == 0 && iabs(aim.z - 600) <= 30 && iabs(aim.y - 850) <= 30;
  told := hud_test_click(t[..], g);
  #assert cast(string) told[0..<11] == "place 0.00 " && hud_test_ends(told, " rest") && hud_test_num(told, 1) == 0 && hud_test_num(told, 2) == aim.z && hud_test_num(told, 6) == aim.y;
  // far along the course, as far as it runs: the platformer's bounds are its own
  #assert hud_far(h) == HUD_T_FAR_COURSE && hud_room_why(h, 0, 0, 62000) == HUD_L_NONE && hud_room_why(h, 0, 0, 70001) == HUD_L_FAR;
}
#test "platformer: its own kinds built on the course: a pad throws the character up, spikes laid on a platform put it back, a shard is taken by touching it and comes back with the course" #steps 2000000000000 {
  t: [1] HudTest; h := t[0].h[..]; p := h[0].plat[..]; b := h[0].things[..]; c := p[0].c[..];
  hud_test_plat(t[..]);
  #assert c[0].n == 67 && h[0].pf_n == 0;
  // a pad 2 by 2 under the character's feet (its top the first platform's), fixed: a platform of the course, with a new game's under it (the level has no checkpoint of its own)
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 11 1 1 0 350 200 200 50 200 1\n");
  i := bd_index(b, 1); #assert i >= 0 && b[0].set[0].inv_mass[i] == 0 && hud_role(h, 1) == BL_R_PAD && h[0].nmk == 0 && h[0].pf_n == 1 && c[0].n == 68 && c[0].parts[0].kind == PF_PAD && c[0].gates == 9;
  top: f32 = 0; for k: 0..<50 { hud_test_run(t[..], 1, 0.016666668); if h[0].cy > top { top = h[0].cy; } }
  #assert top > PF_START + 3;
  // spikes laid on the first platform there instead: no body to stand on, and feet on them are put back, a fall counted
  f := p[0].falls;
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 12 1 2 0 400 200 280 25 200 1\n");
  #assert hud_role(h, 1) == BL_R_SPIKES && c[0].n == 67 && c[0].spikes == 7;
  for k: 0..<240 { hud_test_run(t[..], 1, 0.016666668); if p[0].falls > f { break; } }
  #assert p[0].falls > f && near(h[0].cz, 2, 0.05) && near(h[0].cy, PF_START, 0.05);
  // a shard over the character's head: a mark, no body; touched, taken; told again, still taken
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n2 13 1 1 0 450 200 50 50 50 1\n");
  #assert bd_count(b) == 0 && h[0].nmk == 1 && h[0].marks[0].role == BL_R_SHARD && c[0].shards == 39 && c[0].spikes == 6 && !p[0].taken[0];
  h[0].bare = false; hud_build(h, true); n := h[0].mesh_n;
  hud_test_run(t[..], 2, 0.016666668);
  #assert p[0].taken[0] && course_taken(p[0].taken[..]) == 1;
  hud_build(h, true); #assert h[0].mesh_n < n;
  clock := p[0].clock;
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n2 13 1 1 0 450 200 50 50 50 1\n"); #assert p[0].taken[0] && p[0].clock == clock;
  // the course again: the shard back
  hud_plat_in(h); #assert !p[0].taken[0] && c[0].shards == 39;
  hud_test_say(h, HUD_BLOCKS_MSG, "0\n"); #assert h[0].nmk == 0 && c[0].shards == 38 && c[0].n == 67;
}
// A new game's course told as the page tells it (message 105): every thing of the starter a line, a moving
// platform's and a lift's way after its turn; `moved` is told as moved and sized again.
hud_test_course :: (h: [] Hud, s: [] GtThing, n: int, moved: int) {
  o := h[0].inbox[..]; m := hud_test_put(o, 0, n); o[m] = '\n'; m += 1;
  for i: 0..<n {
    r := gk_role(s[i].kind);
    v := [10] int.[i + 1, ifx r > 0 then BL_ROLE_WIRE + r else 0, ifx i == moved then 2 else 1, ifx i == moved then 2 else 1, s[i].x, s[i].y, s[i].z, s[i].w, s[i].h, s[i].d];
    for q: 0..<10 { m = hud_test_put(o, m, v[q]); o[m] = ' '; m += 1; }
    o[m] = '1'; m += 1;
    if gk_moves(s[i].kind) { o[m] = ' '; o[m + 1] = '0'; o[m + 2] = ' '; m += 3; m = hud_test_put(o, m, s[i].go); o[m] = ' '; m += 1; m = hud_test_put(o, m, s[i].every); }
    o[m] = '\n'; m += 1;
  }
  hud_message(h, HUD_BLOCKS_MSG, m);
}
#test "platformer: the course is the level's things: a new game's told as the page tells them is the course it always had, part for part; a platform moved is where it is now with the clock kept; a level with checkpoints of its own is its own course, its furthest checkpoint the goal, and a moving platform carries what stands on it as far as its thing says" #steps 2000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; p := h[0].plat[..]; b := h[0].things[..]; c := p[0].c[..];
  hud_test_plat(t[..]);
  first := c[0];
  s: [GT_STARTER_MAX] GtThing; n := gt_starter(GT_PLATFORMER, s[..]);
  clock := p[0].clock;
  hud_test_course(h, s[..], n, -1);
  // the same course, part for part: 73 bodies (its platforms and its spikes) and 38 marks, none of them the character's solids twice
  #assert h[0].pf_n == n && bd_count(b) == 73 && h[0].nmk == 38 && c[0].n == first.n && c[0].shards == first.shards && c[0].spikes == first.spikes && c[0].gates == first.gates && p[0].clock == clock && p[0].run.going;
  for i: 0..<c[0].n { q := c[0].parts[i]; w := first.parts[i]; #assert q.kind == w.kind && q.z0 == w.z0 && q.z1 == w.z1 && q.y == w.y && q.gate == w.gate && q.slide.bz == w.slide.bz && q.slide.by == w.slide.by && q.slide.period == w.slide.period; }
  #assert h[0].nb == h[0].ns && h[0].ns > 0;
  // (the recorded run on it: the check above, and through the app's level and keys, coax/world.coax)
  // the second platform raised a metre: the course has it there, the clock as it was and the run going on
  hud_test_run(t[..], 30, 0.016666668);
  clock = p[0].clock; s[3].y += 100;
  hud_test_course(h, s[..], n, 3);
  #assert c[0].parts[1].y == PF_START + 1 && p[0].clock == clock && p[0].run.going;
  // a level of three things: a platform, a moving platform going 6 m and back every 4 seconds, and a checkpoint, which is the goal
  hud_test_say(h, HUD_BLOCKS_MSG, "3\n1 0 1 1 0 310 200 320 90 400 1\n2 21 1 1 0 310 600 320 90 400 1 0 600 4000\n3 14 1 1 0 310 1600 320 90 400 1\n");
  #assert c[0].n == 3 && c[0].gates == 1 && c[0].parts[1].kind == PF_MOVER && c[0].parts[1].slide.bz == 6 && c[0].parts[1].slide.period == 4 && hud_role(h, 2) == BL_R_SLIDER && p[0].run.going && p[0].run.gates == 1;
  at := pf_box(p, 1)[2];
  hud_plat_put(h, [3] f32.[0, PF_START, at + 2]);
  hud_test_run(t[..], 60, 0.016666668);
  moved := pf_box(p, 1)[2] - at;
  #assert abs(moved) > 1 && near(h[0].cz, at + 2 + moved, 0.05) && near(h[0].cy, PF_START, 0.05) && p[0].stand == 1;
  // its way set to 12 m every 8 seconds: the course has it so
  hud_test_say(h, HUD_BLOCKS_MSG, "3\n1 0 1 1 0 310 200 320 90 400 1\n2 21 1 1 0 310 600 320 90 400 1 0 1200 8000\n3 14 1 1 0 310 1600 320 90 400 1\n");
  #assert c[0].parts[1].slide.bz == 12 && c[0].parts[1].slide.period == 8 && p[0].run.going;
  // on the checkpoint: the goal
  hud_plat_put(h, [3] f32.[0, PF_START, 16]); hud_test_run(t[..], 2, 0.016666668);
  #assert p[0].run.done && p[0].won > 0;
}
#test "racing and crates: their own kinds built: a cone is knocked away by the car and never met as a wall; a boost is a mark the race reads; a wall is fixed and a goal a mark" #steps 4000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; r := h[0].race[..]; b := h[0].things[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "7"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_race_in(h);
  hud_test_run(t[..], 480, 0.016666668);
  // a cone 12 m ahead of the car on the road (made on the grass, put there), and a boost
  a := track_at(r[0].t[..], r[0].s + 12); c := track_point(a, 0, 0); s0 := r[0].s;
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n1 18 1 1 0 0 0 40 60 40 1\n2 17 1 1 0 0 0 400 25 400 1\n");
  i := bd_index(b, 1);
  #assert i >= 0 && hud_role(h, 1) == BL_R_CONE && !bd_fixed(b, i) && h[0].nmk == 1 && h[0].marks[0].role == BL_R_BOOST && bd_count(b) == 1;
  bd_place(b, i, d3(cast(f64) c[0], cast(f64) c[1] + 0.3, cast(f64) -c[2]), DQ.{}); bd_wake(b, i); was := b[0].set[0].pos[i];
  // driven through: the car is not stopped by it (it is not among what the car meets) and it is knocked away
  hud_test_say(h, HUD_KEYS_MSG, "1");
  for k: 0..<300 { hud_test_run(t[..], 1, 0.016666668); if r[0].s > s0 + 25 { break; } }
  q := b[0].set[0].pos[bd_index(b, 1)];
  #assert r[0].s > s0 + 20 && r[0].nbx == 0 && r[0].nbo == 1 && (q.x - was.x) * (q.x - was.x) + (q.z - was.z) * (q.z - was.z) > 1;
  // crates: a wall is fixed, a goal a mark
  hud_test_say(h, HUD_KIND_MSG, "6");
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n3 15 1 1 0 0 0 150 240 150 1\n4 16 1 1 0 0 0 120 25 120 1\n");
  j := bd_index(b, 3);
  #assert j >= 0 && bd_fixed(b, j) && hud_role(h, 3) == BL_R_WALL && h[0].nmk == 1 && h[0].marks[0].role == BL_R_GOAL && bd_index(b, 4) < 0;
}
#test "racing: the circuit is the level's track points: a new game's are the ribbon it always had; one moved, the ribbon is laid through where it is now and the car is back on the grid; with too few, the first circuit" #steps 4000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; r := h[0].race[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "7"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_race_in(h);
  first: [RC_POINTS] TrackPoint; nf := rc_points(first[..]);
  #assert r[0].ok && nf == GT_CIRCUIT && rc_laid(r, first[0..<nf]);
  length := r[0].t[0].length; line := r[0].line;
  // the level as a new game has it (shared/game-types.coax), told as the page tells it: the same ribbon, nothing laid again
  s: [GT_STARTER_MAX] GtThing; n := gt_starter(GT_RACING, s[..]);
  o := h[0].inbox[..]; m := hud_test_put(o, 0, n); o[m] = '\n'; m += 1;
  for i: 0..<n {
    v := [10] int.[i + 1, BL_ROLE_WIRE + BL_R_TRACK, 1, 1, s[i].x, s[i].y, s[i].z, s[i].w, s[i].h, s[i].d];
    for q: 0..<10 { m = hud_test_put(o, m, v[q]); o[m] = ' '; m += 1; }
    o[m] = '2'; o[m + 1] = ' '; m = hud_test_put(o, m + 2, s[i].turn); o[m] = '\n'; m += 1;
  }
  hud_message(h, HUD_BLOCKS_MSG, m);
  #assert h[0].nmk == GT_CIRCUIT && h[0].marks[6].role == BL_R_TRACK && h[0].marks[6].turn == 9 && bd_count(h[0].things[..]) == 0;
  #assert rc_laid(r, first[0..<nf]) && r[0].t[0].length == length && r[0].line == line;
  // driven a little, then a point is moved (the far corner pulled 40 m out): the ribbon is longer, through the new place, and the car is on the grid again
  hud_test_run(t[..], 200, 0.016666668); hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 120, 0.016666668);
  #assert r[0].s > line - RC_GRID + 5;
  clock := r[0].clock;
  s[13].x += 4000;
  m = hud_test_put(o, 0, n); o[m] = '\n'; m += 1;
  for i: 0..<n {
    v := [10] int.[i + 1, BL_ROLE_WIRE + BL_R_TRACK, ifx i == 13 then 2 else 1, 1, s[i].x, s[i].y, s[i].z, s[i].w, s[i].h, s[i].d];
    for q: 0..<10 { m = hud_test_put(o, m, v[q]); o[m] = ' '; m += 1; }
    o[m] = '2'; o[m + 1] = ' '; m = hud_test_put(o, m + 2, s[i].turn); o[m] = '\n'; m += 1;
  }
  hud_message(h, HUD_BLOCKS_MSG, m);
  #assert r[0].ok && !rc_laid(r, first[0..<nf]) && r[0].np == GT_CIRCUIT && r[0].pts[13].x == 180 && r[0].t[0].length > length + 30 && r[0].clock == clock && r[0].shown;
  #assert abs(r[0].s - (r[0].line - RC_GRID)) < 0.01 && !r[0].run.done && r[0].run.lap == 0;
  near_new := track_near(r[0].t[..], 180, 1.8, -100, -1, 0);
  #assert abs(near_new.side) < 0.01;
  // two points alone are no circuit: the first one stands
  hud_test_say(h, HUD_BLOCKS_MSG, "2\n1 19 1 1 0 0 0 200 25 200 2 0\n2 19 1 1 5000 0 0 200 25 200 2 0\n");
  #assert r[0].ok && rc_laid(r, first[0..<nf]) && r[0].t[0].length == length;
  // three make one, the second the line
  hud_test_say(h, HUD_BLOCKS_MSG, "3\n1 19 1 1 0 0 0 200 25 200 2 0\n2 19 1 1 8000 0 0 200 25 200 2 0\n3 19 1 1 4000 0 6000 200 25 200 2 0\n");
  #assert r[0].ok && r[0].np == 3 && r[0].t[0].n == 3 * RC_PER && r[0].t[0].length > 200 && r[0].t[0].length < 280;
}
// ---------------------------------------------------------------- drift (docs/web-world.md, "Drift")
// The level's rings told as the page tells them (message 105): each a mark of drift's own kind.
hud_test_rings :: (h: [] Hud, s: [] GtThing, n: int, moved: int) {
  o := h[0].inbox[..]; m := hud_test_put(o, 0, n); o[m] = '\n'; m += 1;
  for i: 0..<n {
    v := [10] int.[i + 1, BL_ROLE_WIRE + BL_R_RING, ifx i == moved then 2 else 1, 1, s[i].x, s[i].y, s[i].z, s[i].w, s[i].h, s[i].d];
    for q: 0..<10 { m = hud_test_put(o, m, v[q]); o[m] = ' '; m += 1; }
    o[m] = '2'; o[m + 1] = '\n'; m += 2;
  }
  hud_message(h, HUD_BLOCKS_MSG, m);
}
#test "drift: the course is the level's rings: a new game's are the course it always had; one moved or made wider, the course goes through it as it is now and the ship is back at the start; with none, the first course" #steps 4000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; d := h[0].drift[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "8"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_drift_in(h);
  first: [DR_RINGS] Ring; nf := dr_rings(first[..]);
  #assert d[0].ok && nf == GT_RINGS && dr_laid(d, first[0..<nf]);
  // the level as a new game has it, told as the page tells it: the same course, nothing laid again
  s: [GT_STARTER_MAX] GtThing; n := gt_starter(GT_DRIFT, s[..]);
  rock := d[0].home[7];
  hud_test_rings(h, s[..], n, -1);
  #assert h[0].nmk == GT_RINGS && h[0].marks[2].role == BL_R_RING && bd_count(h[0].things[..]) == 0 && dr_laid(d, first[0..<nf]) && d[0].home[7][0] == rock[0];
  // flown a little, then the third ring is moved 40 m up and made twice as wide: the course is through where it is now
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 150, 0.016666668);
  clock := d[0].clock; #assert arch_vlen(arch_vsub(dr_at(d), DR_START)) > 3;
  s[2].y += 4000; s[2].w = 400; s[2].h = 400; s[2].d = 400;
  hud_test_rings(h, s[..], n, 2);
  r := d[0].course[0].ring[2];
  #assert d[0].ok && !dr_laid(d, first[0..<nf]) && d[0].course[0].n == GT_RINGS && abs(r.y - (first[2].y + 41)) < 0.01 && r.r == DR_RING_R * 2 && d[0].clock == clock;
  #assert arch_vlen(arch_vsub(dr_at(d), DR_START)) < 0.01 && d[0].run.next == 0 && d[0].run.going;
  // rings taken away: the course is the ones left; none left, the first course
  hud_test_rings(h, s[..], 4, -1); #assert d[0].course[0].n == 4 && d[0].run.gates == 4;
  hud_test_rings(h, s[..], 0, -1); #assert d[0].course[0].n == GT_RINGS && dr_laid(d, first[0..<nf]);
}
#test "drift: the keys fly the ship (W ahead, D right, Space up), the view is its aim, nobody walks, R puts it back, the page is told, and leaving takes it" #steps 4000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; d := h[0].drift[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "8"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_drift_in(h);
  #assert d[0].ok && h[0].kind == CAM_KIND_THIRD && hud_look_of(h).sun_r == 0;
  // nothing is held for the entrance: W flies the ship from the first frame, the floor still falling away
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 20, 0.016666668);
  #assert !dr_up(d) && d3_len(d[0].ship.vel) > 0 && d[0].run.going && h[0].orbiting;
  hud_test_run(t[..], 60, 0.016666668);
  #assert dr_up(d) && d[0].run.going && dr_speed(d) > 3 && hud_look_of(h).sun_r > 1.3;
  // the camera's feet are the ship's; the view is behind it, looking the way it goes
  a := dr_at(d); f := dr_ahead(d);
  #assert near(h[0].cx, a[0], 0.01) && near(h[0].cz, -a[2], 0.01);
  s := metaverse_orbit_shot(h[0].orbit);
  #assert (s.at.x - s.eye.x) * f[0] + (s.at.z - s.eye.z) * f[2] > 0;
  // D: to the right (-x, looking along +z); Space: up
  hud_test_say(h, HUD_KEYS_MSG, "8"); b := dr_at(d); hud_test_run(t[..], 40, 0.016666668); c := dr_at(d); #assert c[0] < b[0] - 0.5;
  hud_test_say(h, HUD_KEYS_MSG, "16"); hud_test_run(t[..], 40, 0.016666668); e := dr_at(d); #assert e[1] > c[1] + 0.5;
  // the view turned (the arrows turn it): the ship comes round to look where it looks
  hud_test_say(h, HUD_KEYS_MSG, "64"); hud_test_run(t[..], 60, 0.016666668); hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 120, 0.016666668);
  g := dr_ahead(d); w := dr_aim(h[0].orbit.yaw, 0); #assert abs(h[0].orbit.yaw) > 0.3 && g[0] * w[0] + g[2] * w[2] > 0.95;
  // R: back at the start (no ring passed yet), still
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 1 0 0 0"); hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 1 0 0 1");
  #assert d[0].backs == 1 && arch_vlen(arch_vsub(dr_at(d), d[0].course[0].start)) < 0.5;
  // what it is, for the chat
  told := false;
  for k: 0..<120 { hud_test_run(t[..], 1, 0.016666668); if hud_action(h) == HUD_SAYS { told = told || pf_test_has(cast(string) h[0].outbox[0..<h[0].out_n], "drift: a small ship"); } hud_action_done(h); }
  #assert told;
  // the meadow again: no ship, the character walks again
  hud_test_say(h, HUD_KIND_MSG, "0");
  #assert !d[0].ok && hud_meadow(h);
}
#test "drift: built in like any world: a thing the page puts in open space is held there (no gravity), the ship meets it (under the floor too), the tool places in the air ahead of the view, and the page is told how high the ship is" #steps 4000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; d := h[0].drift[..]; b := h[0].things[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "8"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_drift_in(h);
  hud_test_run(t[..], 300, 0.016666668);
  #assert dr_up(d) && hud_far(h) == HUD_T_FAR_COURSE;
  // a slab 10 m ahead of the ship (page z is -engine z), 30 m under the floor that was: held there, and among what the ship meets
  a := dr_at(d);
  hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 -3000 -1000 400 50 400 1\n");
  i := bd_index(b, 1); #assert i >= 0 && bd_fixed(b, i);
  hud_test_run(t[..], 60, 0.016666668);
  q := b[0].set[0].pos[bd_index(b, 1)]; #assert near(cast(f32) q.y, -29.75, 0.01) && d[0].nbx == 1;
  // the tool, nothing near along its ray: its place is HUD_T_SPACE out along it, in the air (free: kept to the grain there, a few centimetres)
  hud_test_say(h, HUD_TOOL_MSG, "0 0 0 10 0 1");
  h[0].tx = h[0].wide * 0.5; h[0].ty = h[0].high * 0.5;
  aim := hud_aim(h); c := hud_camera(h, h[0].high, h[0].dpr); f := sty_forward(c);
  #assert aim.ok && !aim.blocked && !aim.clamped;
  #assert iabs(aim.x - hud_whole((c.x + f[0] * HUD_T_SPACE) * 100)) <= 30 && iabs(aim.y - hud_whole((c.y + f[1] * HUD_T_SPACE - 0.5) * 100)) <= 30;
  // where: the ship's height is said, as the platformer's feet are (here 40 m under where the floor was)
  h[0].cy = -40;
  h[0].wait = 0; h[0].action = 0; h[0].said = false; hud_where(h, 0.016666668);
  w := cast(string) h[0].outbox[0..<h[0].out_n];
  #assert hud_action(h) == HUD_WHERE && hud_test_ends(w, " 0 -4000");
  hud_action_done(h);
  #assert a[1] > 0 && a[1] < 3;   // (the ship began a little over the floor)
}
// ---------------------------------------------------------------- racing (docs/web-world.md, "Racing")
#test "racing: the keys drive the car (and not the camera), the camera chases it, nobody walks, R puts it back, the page is told, and leaving takes it" #steps 4000000000000 #traversal 1000000000 {
  t: [1] HudTest; h := t[0].h[..]; r := h[0].race[..];
  h[0].bare = true; hud_test_say(h, HUD_KIND_MSG, "7"); hud_test_say(h, HUD_VIEW_MSG, "2"); h[0].zoom = 1; h[0].tilt = 1;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_race_in(h);
  #assert r[0].ok; #assert h[0].kind == CAM_KIND_THIRD; #assert h[0].table_for == 2 && h[0].table_on;
  // the entrance and the countdown, a second in all: W held does nothing till green
  hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 57, 0.016666668);
  #assert r[0].shown && !r[0].run.going && abs(rc_speed(r)) < 0.5 && rc_light(r) == 3;
  hud_test_run(t[..], 120, 0.016666668);
  #assert r[0].run.going && rc_speed(r) > 10 && h[0].orbiting && near(hud_look_of(h).sun_y, 0.045, 0.01);
  // the camera is behind the car, looking the way it goes; the camera's feet are the car's
  a := rc_at(r); f := rc_ahead(r);
  #assert near(h[0].cx, a[0], 0.01) && near(h[0].cz, -a[2], 0.01);
  s := metaverse_orbit_shot(h[0].orbit);
  #assert (s.at.x - s.eye.x) * f[0] + (s.at.z - s.eye.z) * f[2] > 0;
  // the right arrow steers right (the car's right, -x looking along +z), and turns no camera of its own
  yaw := h[0].orbit.yaw;
  hud_test_say(h, HUD_KEYS_MSG, "65"); hud_test_run(t[..], 30, 0.016666668);
  g := rc_ahead(r); #assert g[0] < f[0] - 0.05;
  // R: back on the track at the last checkpoint (none yet: the grid), still
  hud_test_say(h, HUD_KEYS_MSG, "0");
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 1 0 0 0"); hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 1 0 0 1");
  #assert r[0].backs == 1 && abs(r[0].s - (r[0].line - RC_GRID)) < 0.1;
  // what it is, for the chat
  told := false;
  for k: 0..<120 { hud_test_run(t[..], 1, 0.016666668); if hud_action(h) == HUD_SAYS { told = told || pf_test_has(cast(string) h[0].outbox[0..<h[0].out_n], "a racing circuit"); } hud_action_done(h); }
  #assert told;
  // the meadow again: no circuit, the village's table not kept, the character walks again
  hud_test_say(h, HUD_KIND_MSG, "0");
  #assert !r[0].ok && h[0].table_for == 0 && !h[0].table_on && hud_meadow(h);
}
#test "platformer: the character is held on its line and never flies; the void puts it back at the start; R starts the course over; the page is told the course; and leaving takes it" #steps 2000000000000 {
  t: [1] HudTest; h := t[0].h[..]; p := h[0].plat[..];
  hud_test_plat(t[..]);
  // Space twice quickly is a double jump here, not flight
  hud_test_say(h, HUD_KEYS_MSG, "16"); hud_test_run(t[..], 3, 0.016666668); hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 2, 0.016666668);
  hud_test_say(h, HUD_KEYS_MSG, "16"); hud_test_run(t[..], 3, 0.016666668);
  #assert !h[0].fly.on && h[0].foot.jump.air_used == 1 && h[0].cx == 0;
  hud_test_say(h, HUD_KEYS_MSG, "0"); hud_test_run(t[..], 90, 0.016666668);
  // run back off the start's near end: down into the void, and back at the start, still
  hud_test_say(h, HUD_KEYS_MSG, "4");
  for k: 0..<400 { hud_test_run(t[..], 1, 0.016666668); if p[0].falls > 0 { break; } }
  hud_test_say(h, HUD_KEYS_MSG, "0");
  #assert p[0].falls == 1; #assert near(h[0].cz, 2, 0.3); #assert near(h[0].foot.jump.y, PF_START, 0.1) && near(h[0].cx, 0, 0.01);
  // the page's action: the course starts over (its entrance again)
  hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 1 0 0 0"); hud_test_say(h, HUD_TOOL_MSG, "-1 0 0 1 0 0 1");
  #assert p[0].falls == 0 && p[0].clock < 0.1 && !pf_up(p);
  // what it is, for the chat
  told := false;
  for k: 0..<300 { hud_test_run(t[..], 1, 0.016666668); if hud_action(h) == HUD_SAYS { told = told || pf_test_has(cast(string) h[0].outbox[0..<h[0].out_n], "a platformer"); } hud_action_done(h); }
  #assert told;
  // the meadow again: no course, no platforms, the ground back
  hud_test_say(h, HUD_KIND_MSG, "2");
  #assert !p[0].ok && h[0].ns == 0 && hud_colliders(h).ground == 0 && hud_meadow(h);
}

#test "platformer: the character is a hero, not a ghost: solid (not blended), in the runner's livery, every vertex coloured, its head, hands and feet swollen; the meadow's is the ghost again" #steps 2000000000000 {
  t: [1] HudTest; h := t[0].h[..];
  hud_test_plat(t[..]);
  h[0].bare = false;   // (drawn: the course's checks leave it out)
  hud_test_run(t[..], 30, 0.016666668);
  g := h[0].ghost[..];
  #assert hud_hero(h) && g[0].ready && g[0].livery == LIVERY_RUNNER && h[0].ghost_draw >= 0 && hud_draw_blend(h, h[0].ghost_draw) == 0;
  caps := 0; jackets := 0;
  for i: 0..<g[0].nv {
    o := i * HUD_SKIN_FLOATS;
    #assert h[0].skin[o + 6] + h[0].skin[o + 7] + h[0].skin[o + 8] > 0.5;
    for k: 0..<3 { #assert h[0].skin[o + 6 + k] == g[0].paint[i * 3 + k]; }
    if g[0].part[i] == LIVERY_CAP { caps += 1; } if g[0].part[i] == LIVERY_JACKET { jackets += 1; }
  }
  #assert caps > 10 && jackets > 50;
  // the head is swollen: taller than the ghost's (its own head, unswollen, from the same pose)
  hl: f32 = 9; hh: f32 = -9;
  for i: 0..<g[0].nv { if g[0].group[i] == 1 && g[0].share[i] > 0.99 { y := g[0].pos[i * 3 + 1]; if y < hl { hl = y; } if y > hh { hh = y; } } }
  ghost_skin(g);
  gl: f32 = 9; gh: f32 = -9;
  for i: 0..<g[0].nv { if g[0].group[i] == 1 && g[0].share[i] > 0.99 { y := g[0].pos[i * 3 + 1]; if y < gl { gl = y; } if y > gh { gh = y; } } }
  #assert hh - hl > (gh - gl) * 1.25;
  // the meadow: the ghost, blended, its vertices black
  hud_test_say(h, HUD_KIND_MSG, "2");
  hud_test_run(t[..], 5, 0.016666668);
  #assert !hud_hero(h) && (h[0].ghost_draw < 0 || hud_draw_blend(h, h[0].ghost_draw) == 2) && h[0].skin[6] == 0 && h[0].skin[HUD_SKIN_FLOATS * 7 + 7] == 0;
}

#test "crates stays fully framed through portrait and landscape, in every room" #steps 200000000000 {
  t:[1]HudTest;h:=t[0].h[..];h[0].type=HUD_CRATES;h[0].kind=CAM_KIND_TOP;h[0].view=HUD_WORLD;h[0].zoom=1;
  for room:0..<CR_ROOMS {hud_test_room(h,room);hud_crates_in(h);#assert h[0].crates[0].ok && h[0].crates[0].room==room && cr_half(h[0].crates[..]).x>=5.25;
    for shape:0..<2 {h[0].wide=ifx shape==0 then 412 else 1440;h[0].high=ifx shape==0 then 915 else 900;h[0].orbiting=false;hud_orbit(h,0.016);
      kd:=hud_camera_kind(h);shot:=metaverse_orbit_shot(h[0].orbit);points:=hud_crate_corners(h);lens:=FrameLens.{fov=kd.fov,aspect=cast(f32)h[0].wide/cast(f32)h[0].high};
      for point:points {#assert frame_inside(shot,lens,FrameRect.{x0=-0.89,x1=0.89,y0=-0.83,y1=0.83},point);}
      #assert !kd.zooms && kd.near==kd.far && h[0].kind==CAM_KIND_TOP;
    }
  }
}

#test "racing: a left thumb drives and steers the same vehicle; holding a still right thumb brakes" #steps 4000000000000 #traversal 1000000000 {
  t:[1]HudTest;h:=t[0].h[..];r:=h[0].race[..];h[0].bare=true;hud_test_say(h,HUD_KIND_MSG,"7");hud_test_say(h,HUD_VIEW_MSG,"2");h[0].zoom=1;h[0].tilt=1;hud_test_say(h,HUD_KEYS_MSG,"0");hud_race_in(h);hud_test_run(t[..],420,0.016666668);
  start:=r[0].s;h[0].sticks.pad_y=1;hud_test_run(t[..],60,0.016666668);#assert r[0].s>start+4 && rc_speed(r)>8;
  f:=rc_ahead(r);h[0].sticks.pad_x=0.5;hud_test_run(t[..],30,0.016666668);g:=rc_ahead(r);#assert g[0]<f[0]-0.02;
  h[0].sticks.pad_y=0;h[0].sticks.pad_x=0;speed:=abs(rc_speed(r));h[0].sticks.look_on=true;h[0].sticks.travelled=false;hud_test_run(t[..],60,0.016666668);#assert abs(rc_speed(r))<speed;
}

// ---------------------------------------------------------------- the first second (issue 14; docs/web-world.md, "The first second")
// One game type come up, its entrance playing, W and D held and the hotbar's first tool picked: what
// its first frame takes, as bits. 1: a look and a zoom (hud_looks), the camera still up near the
// page's view; 2: the tools (hud_tooled); 4: a press on the world is the tool's, not the camera's;
// 8: a fifth of a second in, the keys have moved what they move (the character; the ship, its clock
// running), or, racing, the rule that needs a start has it short: the car is in and held till green,
// and W drives it a second and a bit in.
hud_test_first :: (kind: int) -> int {
  t: [1] HudTest; h := t[0].h[..]; h[0].bare = true;
  text: [4] u8; n := hud_test_put(text[..], 0, kind);
  hud_test_say(h, HUD_KIND_MSG, cast(string) text[0..<n]);
  if kind == HUD_VILLAGE { vl_test_ready(h[0].village[..]); hud_test_green(h, 0, ""); hud_statics(h); }
  hud_test_say(h, HUD_VIEW_MSG, "2");
  hud_test_say(h, HUD_TOOL_MSG, "1 0 0 10 0 2");
  hud_test_say(h, HUD_KEYS_MSG, "9");
  hud_test_run(t[..], 1, 0.016666668);
  got := 0;
  if h[0].view == HUD_WORLD && h[0].type == kind && h[0].zoom < 0.2 && h[0].orbiting && hud_looks(h) { got |= 1; }
  if hud_tooled(h) { got |= 2; }
  x0 := h[0].cx; z0 := h[0].cz;
  if kind == 1 { hud_pointer_lock(h, 1); }   // (first person: the browser holds the pointer, and a press is then the tool's)
  hud_pointer(h, 800, 800, 0, 0, 1, 0); if h[0].tooling { got |= 4; } hud_pointer(h, 800, 800, 2, 0, 1, 0);
  hud_test_run(t[..], 11, 0.016666668);
  if kind == HUD_RACING {
    r := h[0].race[..]; held := r[0].shown && !r[0].run.going && abs(rc_speed(r)) < 1.0;
    hud_test_run(t[..], 60, 0.016666668);
    if held && r[0].run.going && rc_speed(r) > 0.5 && r[0].clock < 1.3 { got |= 8; }
  } else if kind == HUD_DRIFT {
    d := h[0].drift[..]; if d[0].run.going && d3_len(d[0].ship.vel) > 0.2 && !dr_up(d) { got |= 8; }
  } else if abs(h[0].cx - x0) + abs(h[0].cz - z0) > 0.05 { got |= 8; }
  return got;
}
#test "nothing is held for the entrance: the first frame of each of the nine game types takes a look, the hotbar's tool and the keys" #steps 4000000000000 #traversal 1000000000 {
  #assert HUD_TYPES == 9;
  #assert hud_test_first(0) == 15;                // third person
  #assert hud_test_first(1) == 15;                // first person
  #assert hud_test_first(2) == 15;                // top down
  #assert hud_test_first(3) == 15;                // side on
  #assert hud_test_first(HUD_VILLAGE) == 15;
  #assert hud_test_first(HUD_CRATES) == 15;
  #assert hud_test_first(HUD_PLATFORMER) == 15;
  #assert hud_test_first(HUD_RACING) == 15;       // (the lights are the rule: held till green, a second in)
  #assert hud_test_first(HUD_DRIFT) == 15;
  // every entrance is short: the camera is down in 0.6 s, the grass out in two, each world's own up within about a second
  #assert HUD_DOWN >= 6 && HUD_SPREAD <= 2 && HUD_SUNRISE <= 4 && PF_ENTER <= 1.0 && DR_GO <= 1.0 && RC_COUNT_AT + 3 * RC_BEAT <= 1.0 && CR_RISE_AT + CR_RISE <= 1.0 && CR_LIGHTS <= 1.0;
}
// A game type come up settled (`calm`: HUD_CALM_MSG's bits), one frame on: whether nothing of its entrance is left.
hud_test_settled :: (kind: int, calm: string) -> bool {
  t: [1] HudTest; h := t[0].h[..]; h[0].bare = true;
  hud_test_say(h, HUD_CALM_MSG, calm);
  text: [4] u8; n := hud_test_put(text[..], 0, kind);
  hud_test_say(h, HUD_KIND_MSG, cast(string) text[0..<n]);
  if kind == HUD_VILLAGE { vl_test_ready(h[0].village[..]); hud_statics(h); }
  hud_test_say(h, HUD_VIEW_MSG, "2");
  // a thing the world opens with: a block a metre high, five metres ahead (and, in the village, its green)
  if kind == HUD_VILLAGE { hud_test_green(h, 1, "1 0 1 1 0 0 500 200 100 600\n"); } else { hud_test_say(h, HUD_BLOCKS_MSG, "1\n1 0 1 1 0 0 500 200 100 600\n"); }
  hud_test_run(t[..], 1, 0.016666668);
  ok := h[0].zoom == 1 && h[0].tilt == 1 && hud_looks(h) && h[0].orbiting;
  b := h[0].things[..]; slot := bd_index(b, 1);
  ok = ok && slot >= 0 && near_d(b[0].set[0].pos[slot].y, 0.5, 0.01);   // (it stands where it rests: nothing falls in)
  if hud_meadow(h) { ok = ok && h[0].spread == HUD_SPREAD && h[0].dawn == HUD_SUNRISE * TW_DAY_SHARE[pr_value(h[0].props[..], TW_TIME_OF_DAY)] && hud_look_of(h).sun_r > 0.5; }
  if kind == HUD_VILLAGE { ok = ok && h[0].village[0].clock >= vl_done(h[0].village[..]) && vl_solid_count(h[0].village[..]) == GT_GREEN; }
  if kind == HUD_CRATES { c := h[0].crates[..]; ok = ok && cr_lights(c[0].clock) == 1 && cr_risen(c[0].clock, 40) == 1 && cr_grid(c) == 0 && cr_is(b, slot); }
  if kind == HUD_PLATFORMER { p := h[0].plat[..]; ok = ok && pf_up(p) && p[0].run.going && pf_grid(p) < 0.01 && near(h[0].cy, PF_START, 0.05); }
  if kind == HUD_DRIFT { d := h[0].drift[..]; ok = ok && dr_up(d) && dr_stars(d) == 1 && dr_grid(d) < 0.01 && hud_look_of(h).sun_r > 1.3; }
  if kind == HUD_RACING {
    // the ribbon in, the car on the grid at rest, the grass out; the lights are the rule and still count: green within a second
    r := h[0].race[..]; ok = ok && rc_up(r) && rc_bent(r) == 1 && r[0].shown && !r[0].run.going && h[0].spread == HUD_SPREAD;
    hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 66, 0.016666668);
    ok = ok && r[0].run.going && rc_speed(r) > 0.5;
  }
  return ok;
}
#test "reduced motion: every game type comes up settled, with no entrance: the camera down, the day, the grass, each world's own up, its things at rest" #steps 4000000000000 #traversal 1000000000 {
  #assert hud_test_settled(0, "1") && hud_test_settled(1, "1") && hud_test_settled(2, "1") && hud_test_settled(3, "1");
  #assert hud_test_settled(HUD_VILLAGE, "1");
  #assert hud_test_settled(HUD_CRATES, "1");
  #assert hud_test_settled(HUD_PLATFORMER, "1");
  #assert hud_test_settled(HUD_RACING, "1");
  #assert hud_test_settled(HUD_DRIFT, "1");
  // with no such word the entrance plays: the same question a frame in says no
  #assert !hud_test_settled(0, "0") && !hud_test_settled(HUD_PLATFORMER, "0") && !hud_test_settled(HUD_DRIFT, "0") && !hud_test_settled(0, "x");
}
#test "the settled start: a kept world come back comes up with no entrance (the page's word), each time it comes up; the word taken back, the entrance plays again" #steps 4000000000000 #traversal 1000000000 {
  // the page's word alone (bit 2), and with reduced motion too (3)
  #assert hud_test_settled(0, "2") && hud_test_settled(HUD_VILLAGE, "2") && hud_test_settled(HUD_CRATES, "2") && hud_test_settled(HUD_PLATFORMER, "2");
  #assert hud_test_settled(HUD_RACING, "2") && hud_test_settled(HUD_DRIFT, "2") && hud_test_settled(0, "3");
  t: [1] HudTest; h := t[0].h[..]; h[0].bare = true;
  hud_test_say(h, HUD_CALM_MSG, "2"); #assert hud_calm(h);
  hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 1, 0.01);
  #assert h[0].zoom == 1 && h[0].spread == HUD_SPREAD && h[0].dawn > 0 && hud_looks(h);
  // the word said again each frame (as the glue says it) changes nothing; the keys walk at once
  hud_test_say(h, HUD_CALM_MSG, "2"); hud_test_say(h, HUD_KEYS_MSG, "1"); hud_test_run(t[..], 20, 0.01);
  #assert h[0].zoom == 1 && h[0].cz > 0.05;
  hud_test_say(h, HUD_KEYS_MSG, "0");
  // left and come back, still kept: settled again
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_test_run(t[..], 150, 0.01); #assert h[0].zoom < 0.01 && h[0].spread == 0;
  hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 1, 0.01); #assert h[0].zoom == 1 && h[0].spread == HUD_SPREAD;
  // a new game picked (the page takes its word back): the entrance plays from the start
  hud_test_say(h, HUD_VIEW_MSG, "1"); hud_test_run(t[..], 150, 0.01);
  hud_test_say(h, HUD_CALM_MSG, "0"); #assert !hud_calm(h);
  hud_test_say(h, HUD_VIEW_MSG, "2"); hud_test_run(t[..], 1, 0.01);
  #assert h[0].zoom < 0.2 && h[0].spread < 0.05 && h[0].dawn < 0.05 && hud_looks(h);
}
