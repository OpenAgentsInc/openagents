// gamebuilder.org's world as a level file: what a person builds on the website, written and read
// as the same file the app keeps a level in (coax/level.coax; docs/web-world.md, "Kept in this
// browser"). Two Metaverse Engine documents, one after the other: the world (world.doc.v1,
// metaverse-engine/editor/world-doc.coax) and the content its entities' kinds name
// (aethyr.content.v1, table `shape`: a kind's word and a size a row). Nothing here is a format of
// the website's own: the codecs are the engine's, and the columns, the units and the kinds' words
// are the app's.
//
//   world.doc.v1 level-N                the level: N is the website's kind of game type, plus one
//   ...
//   e SLOT GEN ID FLAGS HAS X Y Z YAW ... KIND ... OWN    a thing: where the middle of its foot is and
//                                       how high its bottom is, metres; its turn, radians; its kind, a row
//                                       of `shape`; and one own column, its size in percent (100; a
//                                       building's is its scale, 50 to 300 percent of its model)
//   aethyr.content.v1 level REV
//   reach 100000
//   table shape id kind:text sx:cm sy:cm sz:cm
//   1|block|200|100|200                 a kind's word (shared/kinds.coax: block, ball, a game type's
//                                       own pad, boost, cone...; the village's buildings by their
//                                       models' words, at their models' own size) and a size across,
//                                       up and along
// A level with a moving platform or a lift in it has two columns more, `go:cm every:int`: how far a
// row's things go, centimetres, and how long there and back takes, milliseconds (0 and 0 for a
// kind that does not move). A level with none is written without them, as it always was.
//
// A game's document is the app's too (coax/games.coax: aethyr.content.v1 `game`, a row of table
// `game` with its title and its type's id, a row of table `levels` with its level's number).
//
// What a file does not hold: a thing's number (things read back are b1, b2, ... in the file's
// order), a lean (a tipped thing reads back upright where it lay) and the undo history. The
// world's settings that differ are kept beside it as the engine's own text of them
// (state/tunables.coax tun_save), with a thing's number as its place in the file.
//
// The app holds 512 things and 64 shapes a level today and knows the kinds of shared/kinds.coax's
// first table; a website level within those opens there (tools/game-types-check.coax holds it).
// Issue 2 is making the app take the rest.
//   coax/bin/coax test web/level.coax --library

#load "blocks.coax";
#load "../../metaverse-engine/editor/world-doc.coax";

LV_CAP :: BL_MAX;            // the slots of the World a level is written from and read into
LV_LISTS :: 64;              // its spatial index's lists: a power of two
LV_OWN :: 1;                 // a thing's size in percent, as the app's level has it
LV_REACH :: 100000;          // centimetres a shape's side may be, as the app's table says
LV_DOC :: 262144;            // bytes a level's file may take (a thousand things take about 150,000)
LV_GAME :: 256;              // bytes a game's document takes
LV_SETTINGS :: 8192;         // bytes of the settings that differ
LV_KEEP_MAX :: 1048576;      // bytes a kept record may be at most (the browser host's byte storage: coax/web/STORAGE.md)

// The storage a level is written from and read into: the engine's World at the website's size, the
// shape table as it is made, and the content document as it is read. It is big, so it is the
// page's to hold (not the stack's).
LvStore :: struct {
  gen: [LV_CAP] int; live: [LV_CAP] bool; born: [LV_CAP] bool; doomed: [LV_CAP] bool;
  ids: [LV_CAP] int; free: [LV_CAP] int; spawns: [LV_CAP] int; en: [ENTITY_COUNTERS] int;
  has: [LV_CAP] int; f: [WORLD_F * LV_CAP] f32; i: [WORLD_I * LV_CAP] int;
  head: [LV_LISTS] int; next: [LV_CAP] int; prev: [LV_CAP] int; at: [LV_CAP] int;
  cx: [LV_CAP] int; cz: [LV_CAP] int; gx: [LV_CAP] f32; gz: [LV_CAP] f32; cell: [1] f32; gn: [SPATIAL_COUNTERS] int;
  sys_id: [1] int; sys_reads: [1] int; sys_writes: [1] int;
  seen: [WORLD_COMPONENTS] int; n: [WORLD_COUNTERS] int;
  own: [LV_CAP * LV_OWN] int;
  // the shape table: each row's kind (lv_code) and its size
  code: [LV_CAP] int; sx: [LV_CAP] int; sy: [LV_CAP] int; sz: [LV_CAP] int; go: [LV_CAP] int; every: [LV_CAP] int; shapes: int;
  content: [1] ContentDoc;
  moved: [1] TunStore;       // the settings that differ, with things' numbers as their places in the file
}

lv_world :: (b: [] LvStore) -> World {
  return World.{
    ents = EntityStore.{gen = b[0].gen[..], live = b[0].live[..], born = b[0].born[..], doomed = b[0].doomed[..],
      ids = b[0].ids[..], free = b[0].free[..], spawns = b[0].spawns[..], n = b[0].en[..]},
    has = b[0].has[..], f = b[0].f[..], i = b[0].i[..],
    grid = SpatialGrid.{head = b[0].head[..], next = b[0].next[..], prev = b[0].prev[..], at = b[0].at[..],
      cx = b[0].cx[..], cz = b[0].cz[..], x = b[0].gx[..], z = b[0].gz[..], cell = b[0].cell[..], n = b[0].gn[..]},
    sys_id = b[0].sys_id[..], sys_reads = b[0].sys_reads[..], sys_writes = b[0].sys_writes[..],
    seen = b[0].seen[..], n = b[0].n[..]};
}

// A thing's kind as one number: 0 a plain block, 1 a ball, LV_ROLE and a game type's kind, LV_MODEL and a building's model.
LV_ROLE :: 100; LV_MODEL :: 200;
lv_code :: (k: Block) -> int { return ifx k.kind == BL_BUILDING then LV_MODEL + k.model else ifx k.kind == BL_BALL then 1 else ifx k.role > 0 then LV_ROLE + k.role else 0; }
// Its word in the shape table: the shared kinds' (shared/kinds.coax), a building's by its model's.
lv_word :: (code: int) -> string {
  if code >= LV_MODEL { return vl_word(code - LV_MODEL); }
  // (the file's word is the app's kind's own, so the app opens it as that kind: a crate's pad is "crate-goal" there,
  // "goal" only in a plan line; the app's "goal" is its soccer goal)
  if code >= LV_ROLE { return ifx code - LV_ROLE < BL_ROLES then GK_WORD[GK_ROLE[code - LV_ROLE]] else ""; }
  return ifx code == 1 then GK_WORD[GK_BALL] else GK_WORD[GK_BLOCK];
}
// The kind a word of the table names; -1: none the website builds with.
lv_code_of :: (word: string) -> int {
  if word == GK_WORD[GK_BLOCK] { return 0; }
  if word == GK_WORD[GK_BALL] { return 1; }
  for q: 1..<BL_ROLES { if GK_WORD[GK_ROLE[q]] == word { return LV_ROLE + q; } }
  r := bl_role_of(word); if r > 0 { return LV_ROLE + r; }   // (a file this page wrote before, with a plan line's word for the crate's pad)
  m := vl_kind_of(word); if m >= 0 { return LV_MODEL + m; }
  return -1;
}
// The row of the shape table for a kind and a size, from 1: added when the table has none like it.
lv_shape :: (st: [] LvStore, code: int, sx: int, sy: int, sz: int, go: int, every: int) -> int {
  for i: 0..<st[0].shapes { if st[0].code[i] == code && st[0].sx[i] == sx && st[0].sy[i] == sy && st[0].sz[i] == sz && st[0].go[i] == go && st[0].every[i] == every { return i + 1; } }
  if st[0].shapes >= LV_CAP { return 0; }
  i := st[0].shapes;
  st[0].code[i] = code; st[0].sx[i] = sx; st[0].sy[i] = sy; st[0].sz[i] = sz; st[0].go[i] = go; st[0].every[i] = every; st[0].shapes += 1;
  return i + 1;
}
// A level's name in its document: "level-N".
lv_name :: (level: int, out: [] u8) -> int { n := bl_put(out, 0, "level-"); return bl_int(out, n, level); }

// The world as its level file (its world document, then its content) into out: its length, or 0
// when it does not fit or `level` is no level's number.
lv_write :: (b: [] Blocks, st: [] LvStore, level: int, out: [] u8) -> int {
  if level < 1 || level > 9999 { return 0; }
  w := lv_world(st);
  if !world_init(w, 8) { return 0; }
  st[0].shapes = 0;
  for i: 0..<b[0].n {
    k := b[0].b[i];
    // (a building's row is its model's own size, as the app keeps it; how big it stands is its own column)
    nat := vl_size(k.model, 100);
    row := ifx k.kind == BL_BUILDING then lv_shape(st, lv_code(k), nat[0], nat[1], nat[2], 0, 0) else lv_shape(st, lv_code(k), k.w, k.h, k.d, k.go, k.every);
    made := world_spawn(w, WORLD_TRANSFORM | WORLD_KIND);
    if row == 0 || made.handle == ENTITY_NONE { return 0; }
    s := entity_slot(made.handle);
    _ = world_set_f(w, WF_X, s, we_m(k.x)); _ = world_set_f(w, WF_Y, s, we_m(k.y)); _ = world_set_f(w, WF_Z, s, we_m(k.z));
    _ = world_set_f(w, WF_YAW, s, we_rad(editor_turn(k.turn)));
    _ = world_set_i(w, WI_KIND, s, row);
    st[0].own[s * LV_OWN] = ifx k.kind == BL_BUILDING then k.scale else 100;
  }
  if !world_commit(w) { return 0; }
  name: [16] u8; nn := lv_name(level, name[..]);
  doc := world_save(w, cast(string) name[0..<nn], st[0].shapes + 1, 0, b[0].n + 1, st[0].own[..], LV_OWN, out);
  if doc.count == 0 { return 0; }
  n := doc.count;
  n = bl_put(out, n, "aethyr.content.v1 level "); n = bl_int(out, n, st[0].shapes + 1);
  n = bl_put(out, n, "\nreach "); n = bl_int(out, n, LV_REACH);
  // (two columns more when a thing moves: how far it goes and how long there and back takes)
  moving := false; for i: 0..<st[0].shapes { moving = moving || st[0].every[i] > 0; }
  n = bl_put(out, n, ifx moving then "\ntable shape id kind:text sx:cm sy:cm sz:cm go:cm every:int\n" else "\ntable shape id kind:text sx:cm sy:cm sz:cm\n");
  for i: 0..<st[0].shapes {
    n = bl_int(out, n, i + 1); n = bl_put(out, n, "|"); n = bl_put(out, n, lv_word(st[0].code[i]));
    n = bl_put(out, n, "|"); n = bl_int(out, n, st[0].sx[i]); n = bl_put(out, n, "|"); n = bl_int(out, n, st[0].sy[i]);
    n = bl_put(out, n, "|"); n = bl_int(out, n, st[0].sz[i]);
    if moving { n = bl_put(out, n, "|"); n = bl_int(out, n, st[0].go[i]); n = bl_put(out, n, "|"); n = bl_int(out, n, st[0].every[i]); }
    n = bl_put(out, n, "\n");
  }
  return ifx n >= out.count then 0 else n;
}

// Where a file's content document starts: after the world document's last line (coax/level.coax level_split).
lv_split :: (text: string) -> int {
  head := "\naethyr.content.v1 ";
  if text.count < head.count { return text.count; }
  for i: 0..<text.count - head.count + 1 {
    if text[i] == '\n' && cast(string) text[i..<i + head.count] == head { return i + 1; }
  }
  return text.count;
}

// Reads a level file into the list, in place of what it held: every thing set down at rest where
// the file says (nothing read back falls in), numbered b1 and up in the file's order. The list's
// bounds and kinds are the game type's (ch_bounds), set before this. False for bytes that are not
// a level the website builds: a document the engine refuses, a table that is not `shape`, a kind
// this game type does not have, a size or a place out of its limits. The list is then not to be
// used as it stands: the caller makes the type's new world (bl_new).
lv_read :: (b: [] Blocks, st: [] LvStore, text: string) -> bool {
  at := lv_split(text);
  if at >= text.count { return false; }
  c := st[0].content[..];
  if !ct_read(c, text[at..<text.count]) || c[0].t_n != 1 { return false; }
  t := ct_table(c, "shape");
  rows := ct_rows(c, t);
  if t < 0 || (ct_cols(c, t) != 5 && ct_cols(c, t) != 7) || rows > LV_CAP { return false; }
  moving := ct_cols(c, t) == 7;
  cols := [6] string.["kind", "sx", "sy", "sz", "go", "every"];
  for k: 0..<ct_cols(c, t) - 1 { if ct_col(c, t, cols[k]) != k + 1 { return false; } }
  for r: 0..<rows {
    if ct_get(c, t, r, 0) != r + 1 { return false; }
    code := lv_code_of(ct_str(c, t, r, 1));
    if code < 0 { return false; }
    st[0].code[r] = code; st[0].sx[r] = ct_get(c, t, r, 2); st[0].sy[r] = ct_get(c, t, r, 3); st[0].sz[r] = ct_get(c, t, r, 4);
    st[0].go[r] = ifx moving then ct_get(c, t, r, 5) else 0; st[0].every[r] = ifx moving then ct_get(c, t, r, 6) else 0;
    // (a distance and a period are a moving platform's or a lift's alone, within their limits)
    if !gk_travel_ok(ifx code >= LV_ROLE && code < LV_MODEL then GK_ROLE[code - LV_ROLE] else GK_BLOCK, st[0].go[r], st[0].every[r]) { return false; }
  }
  st[0].shapes = rows;
  w := lv_world(st);
  if !world_init(w, 8) { return false; }
  d := world_load(w, text[0..<at], st[0].own[..], LV_OWN);
  if !d.ok || d.content != c[0].rev { return false; }
  b[0].n = 0; b[0].next = 0; b[0].sel = 0; b[0].here = false; b[0].rev += 1;
  for s: 0..<world_high(w) {
    if world_at(w, s) == ENTITY_NONE { continue; }
    if !world_has(w, s, WORLD_TRANSFORM | WORLD_KIND) { return false; }
    row := world_i(w, WI_KIND, s);
    if row < 1 || row > rows { return false; }
    if st[0].own[s * LV_OWN] != 100 && st[0].code[row - 1] < LV_MODEL { return false; }
    code := st[0].code[row - 1]; sx := st[0].sx[row - 1]; sy := st[0].sy[row - 1]; sz := st[0].sz[row - 1];
    x := we_cm(world_f(w, WF_X, s)); y := we_cm(world_f(w, WF_Y, s)); z := we_cm(world_f(w, WF_Z, s)); turn := we_deg(world_f(w, WF_YAW, s));
    if code >= LV_MODEL {
      // (its scale is its own column; a file kept before buildings had one holds the size it stood at in its row instead)
      nat := vl_size(code - LV_MODEL, 100); scale := st[0].own[s * LV_OWN];
      if scale == 100 && sx != nat[0] && nat[0] > 0 { scale = (sx * 100 + nat[0] / 2) / nat[0]; }
      if y != 0 || !bl_add_building(b, code - LV_MODEL, x, z, ((turn % 360) + 360) % 360, scale) { return false; }
    } else if code == 1 {
      if sx != sy || sx != sz || !bl_add_ball(b, x, z, sx / 2, y) { return false; }
    } else {
      role := ifx code >= LV_ROLE then code - LV_ROLE else BL_R_NONE;
      if !bl_role_ok(b, role) || !bl_add(b, x, z, sx, sz, sy, y) { return false; }
      b[0].b[b[0].n - 1].role = role; b[0].b[b[0].n - 1].go = st[0].go[row - 1]; b[0].b[b[0].n - 1].every = st[0].every[row - 1];
    }
    b[0].b[b[0].n - 1].turn = ifx code >= LV_MODEL then b[0].b[b[0].n - 1].turn else turn;
    b[0].b[b[0].n - 1].rest = true;
  }
  b[0].why = BL_WHY_NONE;
  return true;
}

// A game's document, as the app writes one (coax/games.coax ed_mine_save): its title, its type's
// id, and its one level's number. Its length.
lv_game_write :: (kind: int, out: [] u8) -> int {
  ty := gt_web_type(kind);
  if ty < 0 { return 0; }
  n := bl_put(out, 0, "aethyr.content.v1 game 1\nreach 1\ntable game id title:text template:text\n1|Game ");
  n = bl_int(out, n, kind + 1); n = bl_put(out, n, "|"); n = bl_put(out, n, GT_ID[ty]);
  n = bl_put(out, n, "\ntable levels id level:int\n1|"); n = bl_int(out, n, kind + 1); n = bl_put(out, n, "\n");
  return ifx n >= out.count then 0 else n;
}
// The website's kind of game type a game's document names; -1 for bytes that are not one, a type
// the website does not have, or a level that is not that type's.
lv_game_read :: (st: [] LvStore, text: string) -> int {
  c := st[0].content[..];
  if !ct_read(c, text) || c[0].t_n != 2 { return -1; }
  g := ct_table(c, "game"); l := ct_table(c, "levels");
  if g < 0 || l < 0 || ct_rows(c, g) != 1 || ct_rows(c, l) != 1 || ct_col(c, g, "template") < 0 || ct_col(c, l, "level") < 0 { return -1; }
  kind := gt_web_kind(gt_of(ct_str(c, g, 0, ct_col(c, g, "template"))));
  if kind < 0 || ct_get(c, l, 0, ct_col(c, l, "level")) != kind + 1 { return -1; }
  return kind;
}

// The world's settings that differ, as the engine's own text of them (tun_save: "path=value" a
// line), with a thing's number written as its place in the list, which is its number when the
// level is read back. Its length.
lv_settings_write :: (b: [] Blocks, st: [] LvStore, out: [] u8) -> int {
  pr_ready(b[0].props[..]);
  st[0].moved[0] = b[0].props[0].over[0];
  m := st[0].moved[..]; kept := 0;
  for i: 0..<m[0].n {
    target := m[0].target[i];
    if target > 0 { at := bl_at(b, target); if at < 0 { continue; } target = at + 1; }
    m[0].prop[kept] = m[0].prop[i]; m[0].target[kept] = target; m[0].value[kept] = m[0].value[i]; kept += 1;
  }
  m[0].n = kept;
  return tun_save(TW_ROWS[..], st[0].moved[..], out);
}
// The settings read back: whole or not at all (tun_load). False, and the settings as they were, for text that is not this registry's.
lv_settings_read :: (b: [] Blocks, text: string) -> bool {
  pr_ready(b[0].props[..]);
  if !tun_load(TW_ROWS[..], b[0].props[0].over[..], text) { return false; }
  bl_tuned(b);
  return true;
}

// ---------------------------------------------------------------- checks

LvTest :: struct { b: [1] Blocks; c: [1] Blocks; st: [1] LvStore; a: [LV_DOC] u8; d: [LV_DOC] u8; }
// s with its first `was` made `now`, into out: its length, or 0 when s has no `was`.
lv_test_swap :: (s: string, was: string, now: string, out: [] u8) -> int {
  at := lv_test_find(s, was); if at < 0 { return 0; }
  n := bl_put(out, 0, cast(string) s[0..<at]); n = bl_put(out, n, now);
  return bl_put(out, n, cast(string) s[at + was.count..<s.count]);
}
lv_test_find :: (s: string, part: string) -> int {
  if part.count > s.count { return -1; }
  for i: 0..<s.count - part.count + 1 { if cast(string) s[i..<i + part.count] == part { return i; } }
  return -1;
}

#test "the meadow as a level file: the app's two documents, its things as rows of the shape table; read back it is the same things, at rest, and written again the same bytes" #steps 400000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_new(b, GT_THIRD);
  n := lv_write(b, st, 1, t[0].a[..]);
  file := cast(string) t[0].a[0..<n];
  #assert n > 0 && lv_test_find(file, "world.doc.v1 level-1\ncontent 5\n") == 0 && lv_test_find(file, "\nown 1\n") > 0;
  #assert lv_test_find(file, "\naethyr.content.v1 level 5\nreach 100000\ntable shape id kind:text sx:cm sy:cm sz:cm\n1|block|200|100|200\n2|block|100|300|100\n3|block|600|200|100\n4|ball|120|120|120\n") == lv_split(file) - 1;
  #assert lv_read(c, st, file) && c[0].n == 4 && c[0].next == 4;
  for i: 0..<4 {
    p := b[0].b[i]; q := c[0].b[i];
    #assert q.id == i + 1 && p.kind == q.kind && p.x == q.x && p.y == q.y && p.z == q.z && p.w == q.w && p.h == q.h && p.d == q.d && q.rest && !q.starts && !q.tipped && q.turn == 0;
  }
  m := lv_write(c, st, 1, t[0].d[..]);
  #assert m == n;
  for i: 0..<n { #assert t[0].a[i] == t[0].d[i]; }
}

#test "a new racing game's circuit is things of its level: its track points are written, each with its height and its bank, and read back as they were, and told to the HUD with their bank" #steps 400000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_roles(b, gt_roles(GT_RACING)); bl_new(b, GT_RACING); bl_roles(c, gt_roles(GT_RACING));
  #assert b[0].n == GT_CIRCUIT && b[0].b[6].role == BL_R_TRACK && b[0].b[6].turn == 9 && b[0].b[6].y == 400 && b[0].b[6].x == 12200 && b[0].b[6].z == -9200;
  n := lv_write(b, st, 8, t[0].a[..]);
  file := cast(string) t[0].a[0..<n];
  #assert n > 0 && lv_test_find(file, "1|track|200|25|200\n") > 0 && lv_read(c, st, file) && c[0].n == GT_CIRCUIT;
  for i: 0..<GT_CIRCUIT { #assert c[0].b[i].role == BL_R_TRACK && c[0].b[i].x == b[0].b[i].x && c[0].b[i].y == b[0].b[i].y && c[0].b[i].z == b[0].b[i].z && c[0].b[i].turn == b[0].b[i].turn && c[0].b[i].w == 200; }
  w: [4096] u8; wn := bl_wire(c, w[..]);
  #assert lv_test_find(cast(string) w[0..<wn], "\n7 19 1 1 12200 400 -9200 200 25 200 2 9\n") > 0;
}
#test "a new drift game's rings are things of its level: far out and under the floor as they are, written, read back as they were, and told to the HUD as rings" #steps 400000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_roles(b, gt_roles(GT_DRIFT)); bl_new(b, GT_DRIFT); bl_roles(c, gt_roles(GT_DRIFT)); bl_bounds(c, GT_FAR[GT_DRIFT], GT_HIGH[GT_DRIFT]); bl_low(c, GT_LOW[GT_DRIFT]);
  #assert b[0].n == GT_RINGS && b[0].b[11].role == BL_R_RING && b[0].b[11].x == 38248 && b[0].b[11].y == -4535 && b[0].b[11].z == -44195 && b[0].far == BL_FAR;
  n := lv_write(b, st, 9, t[0].a[..]);
  file := cast(string) t[0].a[0..<n];
  #assert n > 0 && lv_test_find(file, "1|ring|200|200|200\n") > 0 && lv_read(c, st, file) && c[0].n == GT_RINGS;
  for i: 0..<GT_RINGS { #assert c[0].b[i].role == BL_R_RING && c[0].b[i].x == b[0].b[i].x && c[0].b[i].y == b[0].b[i].y && c[0].b[i].z == b[0].b[i].z && c[0].b[i].w == 200 && c[0].b[i].h == 200; }
  w: [4096] u8; wn := bl_wire(c, w[..]);
  #assert lv_test_find(cast(string) w[0..<wn], "\n12 20 1 1 38248 -4535 -44195 200 200 200") > 0;
}
#test "a moving platform's and a lift's distance and period are kept: two columns more of the shape table, only in a level that has one; read back as they were; one past its limits, or on a kind that does not move, is no level" #steps 400000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_bare(b, GT_PLATFORMER); bl_bounds(b, GT_FAR[GT_PLATFORMER], GT_HIGH[GT_PLATFORMER]); bl_roles(b, BL_PF_ROLES);
  #assert bl_plan(b, "place 0 10 3.2 4 0.9 4 rest mover") && bl_plan(b, "place 0 30 3.2 4 0.9 4 rest lift") && bl_plan(b, "goes b2 12 4.5") && bl_plan(b, "place 0 50 3.2 4 0.9 4 rest") && bl_plan(b, "place 0 70 3.2 4 0.9 4 rest mover");
  n := lv_write(b, st, 6, t[0].a[..]); file := cast(string) t[0].a[0..<n];
  #assert n > 0 && lv_test_find(file, "\ntable shape id kind:text sx:cm sy:cm sz:cm go:cm every:int\n1|mover|320|90|400|800|6000\n2|lift|320|90|400|1200|4500\n3|block|320|90|400|0|0\n") > 0;
  bl_bare(c, GT_PLATFORMER); bl_bounds(c, GT_FAR[GT_PLATFORMER], GT_HIGH[GT_PLATFORMER]); bl_roles(c, BL_PF_ROLES);
  #assert lv_read(c, st, file) && c[0].n == 4 && c[0].b[0].role == BL_R_SLIDER && c[0].b[0].go == 800 && c[0].b[0].every == 6000 && c[0].b[1].role == BL_R_LIFT && c[0].b[1].go == 1200 && c[0].b[1].every == 4500 && c[0].b[2].go == 0 && c[0].b[3].every == 6000;
  m := lv_write(c, st, 6, t[0].d[..]); #assert cast(string) t[0].d[0..<m] == file;
  // past its limits, or on a block: no level
  m = lv_test_swap(file, "|1200|4500\n", "|5001|4500\n", t[0].d[..]); #assert m > 0 && !lv_read(c, st, cast(string) t[0].d[0..<m]);
  m = lv_test_swap(file, "3|block|320|90|400|0|0\n", "3|block|320|90|400|800|6000\n", t[0].d[..]); #assert m > 0 && !lv_read(c, st, cast(string) t[0].d[0..<m]);
  // a level with none is written as it always was
  #assert bl_plan(c, "clear") && bl_plan(c, "place 0 50 3.2 4 0.9 4 rest");
  n = lv_write(c, st, 6, t[0].a[..]); #assert lv_test_find(cast(string) t[0].a[0..<n], "\ntable shape id kind:text sx:cm sy:cm sz:cm\n1|block|320|90|400\n") >= 0;
}
#test "a racing circuit's boosts and cones, a thing turned and one in the air are kept; two things of one size share a row" #steps 400000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_bare(b, GT_RACING); bl_roles(b, gt_roles(GT_RACING)); bl_roles(c, gt_roles(GT_RACING));
  #assert bl_plan(b, "place 10 20 4 4 0.25 boost") && bl_plan(b, "place 3 -6 0.4 0.4 0.6 cone") && bl_plan(b, "place -8 2 0.4 0.4 0.6 cone") && bl_plan(b, "place 0 5 2 1 1 3.5 rest") && bl_plan(b, "ball 2 2 0.5");
  b[0].b[3].turn = 135; b[0].b[2].tipped = true;
  n := lv_write(b, st, 8, t[0].a[..]);
  file := cast(string) t[0].a[0..<n];
  #assert n > 0 && lv_test_find(file, "world.doc.v1 level-8\n") == 0 && lv_test_find(file, "\n1|boost|400|25|400\n2|cone|40|60|40\n3|block|200|100|100\n4|ball|100|100|100\n") > 0 && lv_test_find(file, "\n5|") < 0;
  #assert lv_read(c, st, file) && c[0].n == 5;
  #assert c[0].b[0].role == BL_R_BOOST && c[0].b[1].role == BL_R_CONE && c[0].b[2].role == BL_R_CONE && c[0].b[2].x == -800 && !c[0].b[2].tipped;
  #assert c[0].b[3].role == BL_R_NONE && c[0].b[3].y == 350 && c[0].b[3].turn == 135 && c[0].b[3].w == 200 && c[0].b[3].d == 100 && c[0].b[4].kind == BL_BALL && c[0].b[4].w == 100;
  // a game type without those kinds does not take the file
  bl_roles(c, 0);
  #assert !lv_read(c, st, file);
}

#test "the village's buildings are kept by their models' words at their models' own size, turned as they stood, each with its own scale; the green's nine with them; a file kept before buildings had a scale reads at the size it stood" #steps 900000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_new(b, GT_VILLAGE); bl_new(c, GT_VILLAGE); g := 1 + GT_GREEN;
  #assert bl_plan(b, "put market 30 -30 90") && bl_plan(b, "put rock -20 -20 0 2.2");
  n := lv_write(b, st, 5, t[0].a[..]);
  file := cast(string) t[0].a[0..<n];
  #assert n > 0 && lv_test_find(file, "|market|1008|452|777\n") > 0 && lv_test_find(file, "|rock|134|100|110\n") > 0 && lv_test_find(file, "|britons_house|457|327|539\n") > 0;
  #assert lv_read(c, st, file) && c[0].n == g + 2 && c[0].b[g].kind == BL_BUILDING && c[0].b[g].model == 2 && c[0].b[g].turn == 90 && c[0].b[g].x == 3000 && c[0].b[g].scale == 135 && c[0].b[g + 1].model == 4 && c[0].b[g + 1].turn == 0 && c[0].b[g + 1].scale == 220;
  for i: 0..<b[0].n { #assert c[0].b[i].kind == b[0].b[i].kind && c[0].b[i].model == b[0].b[i].model && c[0].b[i].x == b[0].b[i].x && c[0].b[i].z == b[0].b[i].z && c[0].b[i].turn == b[0].b[i].turn && c[0].b[i].scale == b[0].b[i].scale && c[0].b[i].w == b[0].b[i].w; }
  // and nowhere but the village
  bl_new(c, GT_THIRD);
  #assert !lv_read(c, st, file);
  // a file from before: a market's row is the size it stood at (its usual 135 percent), its own column 100
  bl_bare(b, GT_VILLAGE); #assert bl_plan(b, "put market 30 -30 90");
  b[0].b[0].scale = 100; b[0].b[0].kind = BL_BLOCK; b[0].b[0].role = 0; old := vl_size(2, 135); b[0].b[0].w = old[0]; b[0].b[0].h = old[1]; b[0].b[0].d = old[2];
  n = lv_write(b, st, 5, t[0].a[..]); #assert n > 0;
  at := lv_test_find(cast(string) t[0].a[0..<n], "|block|"); #assert at > 0;
  // (the same bytes with the row's word the market's: `block` and `market` are not as long, so the file is made again by hand)
  m := 0; for i: 0..<at + 1 { t[0].d[m] = t[0].a[i]; m += 1; } for ch: "market" { t[0].d[m] = ch; m += 1; } for i: at + 6..<n { t[0].d[m] = t[0].a[i]; m += 1; }
  bl_new(c, GT_VILLAGE);
  #assert lv_read(c, st, cast(string) t[0].d[0..<m]) && c[0].n == 1 && c[0].b[0].kind == BL_BUILDING && c[0].b[0].model == 2 && c[0].b[0].scale == 135 && c[0].b[0].turn == 90;
}

#test "bytes that are not a level are refused: a cut file, a changed byte, a kind nobody builds, a world alone" #steps 400000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_new(b, GT_THIRD);
  n := lv_write(b, st, 1, t[0].a[..]);
  file := cast(string) t[0].a[0..<n]; at := lv_split(file);
  #assert !lv_read(c, st, "") && !lv_read(c, st, cast(string) t[0].a[0..<n - 1]) && !lv_read(c, st, cast(string) t[0].a[0..<at]);
  for i: 0..<n { t[0].d[i] = t[0].a[i]; }
  t[0].d[at - 2] = ifx t[0].d[at - 2] == '1' then '2' else '1';
  #assert !lv_read(c, st, cast(string) t[0].d[0..<n]);
  for i: 0..<n { t[0].d[i] = t[0].a[i]; }
  k := lv_test_find(file, "|ball|");
  t[0].d[k + 1] = 'x';
  #assert !lv_read(c, st, cast(string) t[0].d[0..<n]);
  #assert lv_write(b, st, 0, t[0].a[..]) == 0 && lv_write(b, st, 1, t[0].a[0..<200]) == 0;
}

#test "a full world, a thousand things each of its own size, fits a level file and a kept record, and reads back" #steps 2000000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  b[0].n = 0; b[0].next = 0;
  for i: 0..<BL_MAX { #assert bl_add(b, (i % 40) * 300 - 6000, (i / 40) * 300 - 3000, 25 + i, 100, 100, 0); }
  #assert !bl_add(b, 0, 0, 100, 100, 100, 0) && b[0].why == BL_WHY_FULL;
  n := lv_write(b, st, 1, t[0].a[..]);
  #assert n > 0 && n < LV_DOC && n < LV_KEEP_MAX;
  #assert lv_read(c, st, cast(string) t[0].a[0..<n]) && c[0].n == BL_MAX && c[0].b[999].w == 1024 && c[0].b[999].x == b[0].b[999].x;
}

#test "a game's document is the app's: its type by its id, its level's number; anything else is no game" #steps 100000000 {
  t: [1] LvTest; st := t[0].st[..];
  n := lv_game_write(7, t[0].a[..]);
  #assert cast(string) t[0].a[0..<n] == "aethyr.content.v1 game 1\nreach 1\ntable game id title:text template:text\n1|Game 8|racing\ntable levels id level:int\n1|8\n";
  #assert lv_game_read(st, cast(string) t[0].a[0..<n]) == 7;
  for k: 0..<GT_WEB_TYPES { m := lv_game_write(k, t[0].a[..]); #assert m > 0 && lv_game_read(st, cast(string) t[0].a[0..<m]) == k; }
  #assert lv_game_write(9, t[0].a[..]) == 0 && lv_game_write(-1, t[0].a[..]) == 0;
  #assert lv_game_read(st, "") == -1 && lv_game_read(st, "aethyr.content.v1 game 1\nreach 1\ntable game id title:text template:text\n1|Game 1|arena\ntable levels id level:int\n1|1\n") == -1;
  #assert lv_game_read(st, "aethyr.content.v1 game 1\nreach 1\ntable game id title:text template:text\n1|Game 8|racing\ntable levels id level:int\n1|3\n") == -1;
}

#test "the settings that differ are kept as the registry's own text, a thing's by its place in the file" #steps 200000000 {
  t: [1] LvTest; b := t[0].b[..]; c := t[0].c[..]; st := t[0].st[..];
  bl_new(b, GT_THIRD);
  #assert bl_plan(b, "remove b2") && bl_plan(b, "set world.gravity 0.3") && bl_plan(b, "set b4.bounce 0.9") && bl_plan(b, "set player.fly off");
  n := lv_settings_write(b, st, t[0].a[..]);
  // (b4 is the third thing now: b3 when the level is read back)
  #assert cast(string) t[0].a[0..<n] == "world.gravity=0.3\nplayer.fly=off\nthing.bounce@3=0.9\n";
  m := lv_write(b, st, 1, t[0].d[..]);
  bl_new(c, GT_THIRD);
  #assert lv_read(c, st, cast(string) t[0].d[0..<m]) && lv_settings_read(c, cast(string) t[0].a[0..<n]);
  #assert c[0].grav == 3 && pr_value(c[0].props[..], TW_FLY) == 0 && pr_thing(c[0].props[..], TW_BOUNCE, 3, PR_BALL) == 90 && c[0].b[2].kind == BL_BALL;
  #assert !lv_settings_read(c, "world.nothing=1\n") && c[0].grav == 3;
}
