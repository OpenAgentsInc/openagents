// gamebuilder.org's look, shared by its pages (page.coax, login.coax): the
// stylesheet and a picture's node. Black, white and grey, in Geist and Geist
// Mono; every frame is the HUD's (hud.coax).

#load "../../components/kit/listing.coax";
#load "../../components/backend/dom.coax";
#load "../../components/kit/hotbar.coax";   // the hotbar every game uses, and its science fiction skin

GS_CSS :: 45056;
GS_RING_MOST :: 16;   // names the ring can hold (web/ring.coax RG_MAX, the engine's portals a world: a check holds the two the same)
// A whole number as text, into `out`.
gs_num :: (out: [] u8, v: int) -> string {
  digits: [12] u8; m := 0; a := ifx v < 0 then 0 else v;
  if a == 0 { digits[0] = '0'; m = 1; }
  while a > 0 && m < 12 { digits[m] = cast(u8) ('0' + a % 10); m += 1; a /= 10; }
  k := 0; while m > 0 && k < out.count { m -= 1; out[k] = digits[m]; k += 1; }
  return cast(string) out[0..<k];
}

// The brand's mark: the app's icon (web/img/icon.png) at 64 pixels, as WebP, in the stylesheet itself, so
// it costs no request: cwebp -q 85 -resize 64 64 web/img/icon.png -o mark.webp, then base64. Make it
// again when the icon changes (and index.html's own small icon, in its head).
GS_MARK :: "data:image/webp;base64,";

// What the first paint needs: the rules of the home page (the top, the heading, the line, the names, the
// names over the world's portals, and the foot). web/index.html carries these same rules in its head, written from here by
// tools/home-check.coax, so the home page is drawn and can be pressed before any code runs
// (issue 12); the page's own stylesheet (gs_css) begins with them too. The faces themselves
// (@font-face) are index.html's alone: their files are named by the release (scripts/web-stage.sh).
// A rule another view shares with the home page (the top, .quiet, .lede, .mono) is here, once.
gs_css_first :: (out: [] u8, at: int) -> int {
  n := at;
  n = mc(out, n, ":root{--ink:#fff;--soft:rgba(255,255,255,.66);--dim:rgba(255,255,255,.4);--line:rgba(255,255,255,.2);--sans:Geist,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;--mono:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace}");
  n = mc(out, n, "html{background:#000}body{margin:0;background:transparent;color:var(--ink);font:400 16px/1.5 var(--sans);-webkit-font-smoothing:antialiased}");
  n = mc(out, n, ".gs{position:relative;z-index:1;min-height:100dvh;display:flex;flex-direction:column}.gs *{box-sizing:border-box}.gs img{display:block;max-width:100%}.wrap{width:100%;max-width:1120px;margin:0 auto;padding-left:28px;padding-right:28px}");
  n = mc(out, n, ".mono{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}");
  // the top: the mark, and the way in
  n = mc(out, n, ".top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px}.brand{display:flex;align-items:center;gap:12px;font:500 14px/1 var(--mono);letter-spacing:.18em}a.brand{color:inherit;text-decoration:none}.mark{display:block;width:32px;height:32px;border-radius:7px;background:url(");
  n = mc(out, n, GS_MARK);
  n = mc(out, n, ") center/cover no-repeat}.nav{position:relative;display:flex;align-items:center;gap:22px}");
  n = mc(out, n, ".quiet{appearance:none;border:0;background:none;padding:0;align-self:flex-start;cursor:pointer;color:var(--dim);font:400 12px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;text-decoration:none}.quiet:hover,.quiet:focus-visible{color:#fff;outline:0}.nav .quiet{align-self:center}");
  // the home page (issue 30): one heading and the game types as names to press, in the middle of the window
  n = mc(out, n, ".hero{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding-top:24px;padding-bottom:40px}.hero h1{margin:0;font-weight:600;font-size:clamp(40px,8vw,104px);line-height:.94;letter-spacing:-.045em}.hero h1 span{display:block}");
  n = mc(out, n, ".ghost{color:transparent;-webkit-text-stroke:1.5px #fff}.lede{margin:22px 0 0;color:var(--soft);font:400 clamp(15px,1.5vw,17px)/1.6 var(--mono);letter-spacing:.02em}");
  // the names, before the world is up (and without it): a plain grid of bordered names, each with its key
  n = mc(out, n, ".names{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;width:min(780px,100%);margin-top:36px}");
  n = mc(out, n, ".kind{position:relative;display:flex;align-items:baseline;gap:12px;min-height:48px;padding:12px 16px;border:1px solid rgba(255,255,255,.28);background:rgba(0,0,0,.5);color:#fff;text-decoration:none;text-align:left;font:600 18px/1.2 var(--sans);letter-spacing:-.015em;cursor:pointer;transition:border-color .15s,background .15s}");
  n = mc(out, n, ".kind:hover,.kind:focus-visible,.kind.on{border-color:#fff;background:rgba(255,255,255,.1);outline:0}.kind .no{flex:none;font:400 11px/1 var(--mono);letter-spacing:.14em;color:var(--dim)}.kind .kl{display:none}.gs-ring,.gs-last{display:none!important}");
  n = mc(out, n, "@media (max-width:640px){.names{grid-template-columns:repeat(2,minmax(0,1fr))}.kind{font-size:16px;padding:11px 12px}}");
  // the world is up (the glue's "ringed", hud-glue.js): the heading small at the top, and each name over its portal, where
  // the HUD says that is (--rIx and --rIy, CSS pixels: web/ring.coax); the portal lit says its line too (data-lit)
  n = mc(out, n, "html.ringed .hero{flex:0 0 auto;justify-content:flex-start;padding-top:2px;padding-bottom:0;pointer-events:none}html.ringed .hero h1{font-size:clamp(22px,3.2vw,38px);text-shadow:0 1px 16px rgba(0,0,0,.45)}html.ringed .lede,html.ringed .foot{display:none}");
  n = mc(out, n, "html.ringed .gs{user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;touch-action:none}html.ringed .names{display:block;width:0;height:0;margin:0}");
  n = mc(out, n, "html.ringed .kind{position:fixed;left:-999px;top:0;z-index:2;pointer-events:auto;flex-direction:column;align-items:center;gap:4px;min-height:0;padding:7px 14px 8px;border-color:transparent;background:rgba(0,0,0,.55);text-align:center;white-space:nowrap;transform:translate(-50%,0);animation:gb-ring .6s both}");
  n = mc(out, n, "html.ringed .kind .kl{font:400 12px/1.4 var(--mono);letter-spacing:.02em;color:var(--soft);white-space:normal;width:max-content;max-width:min(300px,78vw)}@keyframes gb-ring{from{opacity:0}}");
  for i: 0..<GS_RING_MOST {
    k: [12] u8; d := gs_num(k[..], i);
    n = mc(out, n, "html.ringed .r"); n = mc(out, n, d); n = mc(out, n, "{left:var(--r"); n = mc(out, n, d); n = mc(out, n, "x,-999px);top:var(--r"); n = mc(out, n, d); n = mc(out, n, "y,0px)}");
    n = mc(out, n, "html.ringed[data-lit=\""); n = mc(out, n, d); n = mc(out, n, "\"] .r"); n = mc(out, n, d); n = mc(out, n, "{border-color:#fff;background:rgba(0,0,0,.8)}");
    n = mc(out, n, "html.ringed[data-lit=\""); n = mc(out, n, d); n = mc(out, n, "\"] .r"); n = mc(out, n, d); n = mc(out, n, " .kl{display:block}");
  }
  // over the meadow (a browser with WebGPU: the sky behind the top bar), the way in is white on the names' shade, not grey on the sky
  n = mc(out, n, "html.gpu .v0 .nav .quiet{color:#fff;background:rgba(0,0,0,.55);padding:9px 14px}html.gpu .v0 .nav .quiet:hover,html.gpu .v0 .nav .quiet:focus-visible{background:rgba(0,0,0,.85)}");
  // a window too short for the heading over the portal lit (a phone on its side): the heading on one line, small, in the top bar's row
  n = mc(out, n, "@media (max-height:520px){html.ringed .hero h1{position:fixed;left:50%;top:22px;transform:translateX(-50%);font-size:20px;line-height:1.2;white-space:nowrap}html.ringed .hero h1 span{display:inline}}");
  // the heading says portals only where there are any: index.html's copy holds both endings and the browser's class picks one (a browser
  // that has WebGPU but no adapter is told so by the page's module, which then draws the other ending alone: home.coax)
  n = mc(out, n, "html:not(.gpu) .hero .wg,html.gpu .hero .ng{display:none}");
  // (the field the glue writes what it found of WebGPU into is never seen: issue 14)
  n = mc(out, n, ".gs-gpu,.gs-count,.gs-count-in{display:none!important}");
  // the foot
  n = mc(out, n, ".foot{margin-top:auto;padding-top:30px;padding-bottom:40px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}.foot a{color:var(--dim);text-decoration:none}.foot a:hover,.foot a:focus-visible{color:#fff}");
  n = mc(out, n, "@media (max-width:520px){.wrap{padding-left:20px;padding-right:20px}.brand{font-size:13px;gap:9px}.mark{width:26px;height:26px}}@media (pointer:coarse){.brand{min-width:44px;min-height:44px}.quiet{min-height:44px;display:inline-flex;align-items:center}}@media (prefers-reduced-motion:reduce){.kind{transition:none}html.ringed .kind{animation:none}}");
  return n;
}

// The page's stylesheet: black, white and grey, in Geist and Geist Mono. The
// page draws no borders or boxes of its own: every panel's frame is the HUD's
// (hud.coax, on the GPU under the page), which finds a panel by its `hud`
// class and takes its frame's kind from the `kN` beside it. Colour comes only
// from the pictures. Bytes written in all.
gs_css :: (out: [] u8, at: int) -> int {
  n := gs_css_first(out, at);
  n = mc(out, n, ".me{appearance:none;position:relative;width:32px;height:32px;padding:0;border:1px solid rgba(255,255,255,.28);border-radius:50%;background:rgba(0,0,0,.6);cursor:pointer;overflow:hidden}.me::before{content:'';position:absolute;left:50%;top:7px;width:8px;height:8px;margin-left:-4px;border-radius:50%;background:var(--soft)}.me::after{content:'';position:absolute;left:50%;top:18px;width:18px;height:18px;margin-left:-9px;border-radius:50%;background:var(--soft)}.me:hover,.me:focus-visible,.me.on{border-color:#fff;outline:0}.me:hover::before,.me:hover::after,.me.on::before,.me.on::after{background:#fff}.menu{position:absolute;right:0;top:42px;z-index:5;display:flex;flex-direction:column;gap:14px;min-width:190px;padding:16px;border:1px solid rgba(255,255,255,.22);background:rgba(0,0,0,.9)}.menu .mono{color:var(--soft);font-size:12px;overflow-wrap:anywhere}.menu button.quiet{align-self:flex-start}.nav .quiet{align-self:center}.pill{display:inline-flex;align-items:center;gap:9px;padding:9px 16px;font:400 12px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--soft);white-space:nowrap}.pill::before{content:'';width:6px;height:6px;background:#fff;animation:blink 1.6s steps(2,end) infinite}@keyframes blink{50%{opacity:.15}}");
  n = mc(out, n, ".btn{display:inline-flex;align-items:center;padding:15px 30px;color:#fff;font:500 13px/1 var(--mono);letter-spacing:.18em;text-transform:uppercase}");
  // a page's head (its small name over its title) and its numbered rows: the credits' (a game type's name has the small number too)
  n = mc(out, n, ".eye{margin:0 0 14px}.head{padding:0 0 18px}.steps{display:flex;flex-direction:column;gap:18px;margin:0;padding:0;list-style:none}.step{display:flex;gap:20px;align-items:baseline;padding:22px 26px}");
  n = mc(out, n, ".no{flex:none;font:400 12px/1 var(--mono);letter-spacing:.14em;color:var(--dim)}.step h3{margin:0;font-weight:600;font-size:22px;letter-spacing:-.02em}.step p{margin:6px 0 0;color:var(--soft);font:400 14px/1.6 var(--mono)}");
  // the login: one narrow column, a field and a button, each in a frame of the HUD's
  n = mc(out, n, ".login{margin:auto;display:flex;flex-direction:column;max-width:560px;padding:40px 44px 44px}.login h1{margin:0;font-weight:600;font-size:clamp(44px,8vw,76px);line-height:.96;letter-spacing:-.045em}.login .lede{margin-top:20px}");
  n = mc(out, n, ".form{display:flex;flex-direction:column;gap:18px;margin-top:38px}.fld{padding:4px 18px}.fld input{display:block;width:100%;height:50px;margin:0;padding:0;border:0;outline:0;background:transparent;color:#fff;font:400 16px/1 var(--mono);letter-spacing:.04em}.fld input::placeholder{color:var(--dim)}");
  // /login/cli: a command line's code, whole on one click (user-select:all), to copy by its button or by hand
  n = mc(out, n, ".fld .cli{margin:0;padding:15px 0;color:#fff;font-size:15px;letter-spacing:.06em;text-transform:none;overflow-wrap:anywhere;user-select:all;-webkit-user-select:all;cursor:text}");
  n = mc(out, n, "button.btn{appearance:none;border:0;background:transparent;cursor:pointer;justify-content:center;height:50px;padding:0 30px}button.btn:hover,button.btn:focus-visible{outline:0;background:rgba(255,255,255,.08)}button.btn:disabled{cursor:default;color:var(--dim)}");
  n = mc(out, n, ".said{margin:0;min-height:20px;color:#fff;font:400 13px/1.5 var(--mono)}.who{margin:18px 0 0;font:400 16px/1.5 var(--mono);overflow-wrap:anywhere}");
  // the world: the chat sits at the foot of the window, over the floor
  n = mc(out, n, ".chat{position:fixed;left:16px;bottom:16px;z-index:4;width:min(440px,calc(100vw - 32px));display:flex;flex-direction:column;gap:8px}.chat.wa{animation:wa 12s linear forwards}.chat.wb{animation:wb 12s linear forwards}@keyframes wa{0%,85%{opacity:1}100%{opacity:.22}}@keyframes wb{0%,85%{opacity:1}100%{opacity:.22}}.chat:hover,.chat.busy,.chat:has(input:not(:placeholder-shown)){opacity:1!important;animation:none}.chat .msg{font-size:13px}.chat .log{max-height:42vh;overflow-y:auto;padding:12px 14px}.log{padding:16px 20px;display:flex;flex-direction:column;gap:10px;background:rgba(0,0,0,.72)}.msg{margin:0;font:400 14px/1.55 var(--mono);color:var(--soft);white-space:pre-wrap;overflow-wrap:anywhere}.msg .mono{display:inline-block;min-width:68px;margin-right:14px}.msg.model{color:#fff}");
  n = mc(out, n, ".chat .fld{background:transparent;transition:background .15s}.chat .fld:focus-within,.chat .fld:has(input:not(:placeholder-shown)){background:rgba(0,0,0,.72)}.gs-blocks,.gs-where,.gs-things,.gs-note,.gs-gpu{display:none!important}.credits{padding-top:120px;padding-bottom:60px}.credits .lede{max-width:560px}.works{margin-top:34px;max-width:860px}.works .by{margin-top:8px;font-size:12px;line-height:1.6;color:var(--soft)}.works a,.credits>a{color:#fff;text-decoration:underline;text-underline-offset:2px}.works .by a+a{margin-left:.8em}.credits>a{display:inline-block;margin-top:28px}.agpic{margin:10px 0 14px}.agpic img{width:320px;max-width:100%;aspect-ratio:5/3;object-fit:cover;border:1px solid rgba(255,255,255,.2)}.saybar{display:flex;gap:8px;align-items:stretch}.saybar .fld{flex:1;min-width:0}button.quiet{align-self:center}");
  // the hotbar, at the foot of the window in the middle: its look is its skin's (the shared component's stylesheet);
  // the page only places it, and the panels that open over it (the world's settings, the selected thing). In a
  // window too narrow for the chat to stand beside it, the chat stands over it
  n = hb_css(hb_scifi(), out, n);
  // and the palette "more" opens over it, and the cue and lift of rearranging (the same skin's)
  n = hb_palette_css(hb_scifi(), out, n);
  // (a panel open over the hotbar stands clear of a slot's row of options)
  n = mc(out, n, ".hotdock:has(.hb-o):not(:has(.limit)) .hpanel,.hotdock:has(.hb-o) .limit{margin-bottom:34px}");
  n = mc(out, n, ".hotdock{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:4;display:flex;flex-direction:column;align-items:center;gap:12px;width:max-content;max-width:calc(100vw - 24px)}.gs-state,.gs-edit,.gs-hotkey,.gs-bar,.gs-bar-in,.gs-drag{display:none!important}");
  n = mc(out, n, ".hpanel{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px;padding:10px 16px;background:rgba(0,0,0,.55);color:var(--soft);font:400 12px/1 var(--mono);letter-spacing:.08em}.hpanel .mono{color:#fff}.hpanel button{appearance:none;min-width:28px;height:28px;padding:0 8px;border:1px solid rgba(255,255,255,.28);background:transparent;color:#fff;font:400 13px/1 var(--mono);cursor:pointer}.hpanel button:hover,.hpanel button:focus-visible{outline:0;background:rgba(255,255,255,.14)}.hpanel .pair{display:flex;align-items:center;gap:6px}");
  // a limit just hit, in words, over the hotbar (docs/web-world.md, "Limits"): white on the panel's shade, in the page's mono
  n = mc(out, n, ".limit{margin:0;padding:9px 16px;max-width:min(560px,calc(100vw - 40px));background:rgba(0,0,0,.62);color:#fff;font:400 12px/1.5 var(--mono);letter-spacing:.06em;text-align:center}.hpanel .near{color:#fff;font-weight:600}");
  n = mc(out, n, ".hpanel .slide{display:flex;align-items:center;gap:12px}.hpanel .slide input{width:200px;margin:0;accent-color:#fff}.hpanel .fact{min-width:44px;color:#fff}");
  // the settings drawn from the registry (web/props-panel.coax): a column of rows that scrolls, a group's name over its rows,
  // a row's name, its control, what it is now, and a reset when it differs (lit); a pressed choice or switch is filled
  n = mc(out, n, ".hprops{flex-direction:column;flex-wrap:nowrap;align-items:stretch;justify-content:flex-start;gap:6px;width:440px;max-width:calc(100vw - 32px);max-height:48vh;overflow-y:auto}.hpanel .pprops{display:flex;flex-direction:column;align-items:stretch;gap:6px;flex-basis:100%}");
  n = mc(out, n, ".hpanel .pgroup{margin-top:6px;color:var(--soft);font-size:11px;text-transform:uppercase}.hpanel .prow{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:28px}.hpanel .prow>.meta{flex:1}.hpanel .prow .slide{flex:1;justify-content:space-between}.hpanel .prow .slide input{width:150px}.hpanel .prow.on .meta{color:#fff}.hpanel .prow button{height:24px;font-size:12px}.hpanel button[aria-pressed=true]{background:rgba(255,255,255,.22);border-color:#fff}.hpanel .asked{color:#fff;line-height:1.4}");
  // (and over a panel that is open there, so the chat's box is never covered)
  n = mc(out, n, "@media (max-width:1680px){.chat{bottom:92px}.gs:has(.hpanel) .chat{bottom:150px}}@media (max-width:640px){.chat{bottom:78px}.gs:has(.hpanel) .chat{bottom:176px}.hpanel .slide input{width:130px}}");
  // the world is the camera's to drag: a drag over it selects no words and a finger on it neither scrolls nor zooms the page; the chat stays the browser's
  n = mc(out, n, ".gs.v2{user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;touch-action:none}.gs.v2 .chat{user-select:text;-webkit-user-select:text;touch-action:auto}");
  // without WebGPU there is no HUD to draw the frames: the page draws plain ones
  // a browser that cannot run the builder: the words, in a plain bordered box where the builder would be, and by the home page's way in (web/gpu-words.coax)
  n = mc(out, n, ".login.nogpu{border:1px solid var(--line);background:rgba(0,0,0,.6)}.login.nogpu h1{font-size:clamp(28px,4.4vw,44px);line-height:1.05;letter-spacing:-.03em}.login.nogpu+.login{margin-top:0}p.nogpu{margin:26px 0 0;max-width:560px;padding:14px 16px;border:1px solid var(--line);color:var(--soft);font:400 14px/1.6 var(--mono)}p.nogpu span{display:block}p.nogpu span:first-child{color:#fff}");
  n = mc(out, n, "html:not(.gpu) .hud{outline:1px solid var(--line)}html:not(.gpu) .hud.k9{outline:0}html:not(.gpu) .hud.k0,html:not(.gpu) .hud.k7{outline:0;border-bottom:1px solid var(--line)}");
  n = mc(out, n, "@media (max-width:520px){.login{padding:28px 22px 30px;margin-left:14px;margin-right:14px;width:auto}.pill{padding:8px 11px;font-size:10px;letter-spacing:.08em;gap:7px}.step{padding:18px 20px}}@media (prefers-reduced-motion:reduce){.pill::before{animation:none}}");
  n = mc(out, n, "@media (pointer:coarse){.me{width:44px;height:44px}.me::before{top:13px}.me::after{top:24px}.menu{top:54px}.chat{bottom:calc(100px + env(safe-area-inset-bottom,0px))}.hotdock{bottom:calc(16px + env(safe-area-inset-bottom,0px))}}");
  n = mc(out,n,"@media (pointer:coarse){.gs:has(.hb-o):not(:has(.hpanel)) .chat{bottom:calc(148px + env(safe-area-inset-bottom,0px))}.hotdock:has(.hb-o):not(:has(.limit)) .hpanel,.hotdock:has(.hb-o) .limit{margin-bottom:64px}}");
  // Chat, panels and tools share a bounded column when they cannot stand
  // beside each other. Flex shrinking scrolls panel/transcript content while
  // retaining the input and the hotbar; no guessed panel-height offset.
  n = mc(out,n,".player-ui{display:contents}@media (max-width:1380px),(pointer:coarse){.player-ui{position:fixed;left:12px;right:12px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:4;display:flex;flex-direction:column;align-items:center;gap:12px;max-height:calc(100dvh - 88px - env(safe-area-inset-bottom,0px));pointer-events:none}.player-ui>.chat{position:static;flex:0 1 auto;min-height:50px;width:min(440px,100%);max-width:100%;pointer-events:auto}.player-ui .chat .log{flex:1 1 auto;min-height:0;max-height:18dvh}.player-ui .saybar{flex:0 0 auto}.player-ui>.hotdock{position:static;left:auto;bottom:auto;transform:none;flex:0 1 auto;min-height:44px;max-width:100%;pointer-events:none}.player-ui .hpanel,.player-ui .hb-p{flex:0 1 auto;min-height:44px;max-height:40dvh;overflow-y:auto;pointer-events:auto}.player-ui .hb,.player-ui .limit{flex-shrink:0;pointer-events:auto}.player-ui>.hotdock:has(.hb-o):not(:has(.hpanel)):not(:has(.limit)){padding-top:64px}}@media (pointer:coarse){.player-ui .hpanel button{min-width:44px;min-height:44px;height:auto}.player-ui .hpanel input[type=range]{min-height:44px}.player-ui .hpanel .prow{min-height:44px;flex-wrap:wrap}}");
  // Wrapped property rows retain their content height inside the scrolling
  // panel. Shrinking them lets a reset button overlap the following row.
  n = mc(out,n,".hprops>*,.hpanel .pprops>*{flex-shrink:0}");
  // a guest (web/page.coax, "A guest"): the chat's words and its one button; the login over the world, which stays as built
  // behind it; and the corner's note of whether what is built is kept in this browser (brighter when it is not)
  n = mc(out, n, ".guest{flex:1;min-width:0;display:flex;align-items:center;gap:12px;padding:8px 8px 8px 16px;background:rgba(0,0,0,.72)}.guest p{flex:1;margin:0;color:var(--soft);font:400 13px/1.45 var(--sans)}.guest button.btn{height:38px;padding:0 18px;white-space:nowrap;border:1px solid rgba(255,255,255,.5)}");
  n = mc(out, n, ".sheet{margin:auto;padding:70px 0 96px;position:relative;z-index:6;display:flex;flex-direction:column;align-items:center;gap:14px;user-select:text;-webkit-user-select:text;touch-action:auto}.sheet .login{margin:0;background:rgba(0,0,0,.86)}.sheet .login h1{font-size:clamp(28px,4.4vw,44px);line-height:1.05;letter-spacing:-.03em}");
  n = mc(out, n, ".kept{position:fixed;right:10px;bottom:24px;z-index:3;font-size:10px;letter-spacing:.08em;color:rgba(255,255,255,.38);text-shadow:0 1px 3px rgba(0,0,0,.6);pointer-events:none;user-select:none}.kept.no{color:#fff}");
  n = mc(out, n, "@media (max-width:640px){.guest{padding:6px 6px 6px 12px;gap:8px}.guest p{font-size:12px}.kept{bottom:auto;top:58px;right:12px}}");
  // the login over the world takes the chat's place while it shows (the chat stands in the column with the hotbar: .player-ui)
  n = mc(out, n, ".gs:has(.sheet) .chat{display:none}");
  // publish (issue 17): the button in the top bar, the sheet's link and rows, and a link's page's small panel over the world
  n = mc(out, n, ".pubgo{appearance:none;text-decoration:none;border:1px solid rgba(255,255,255,.5);background:rgba(0,0,0,.6);color:#fff;padding:9px 14px;cursor:pointer;font:500 12px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase}.pubgo:hover,.pubgo:focus-visible{background:#fff;color:#000;outline:0}.publink{margin:0;color:#fff;font:400 14px/1.4 var(--mono);overflow-wrap:anywhere;user-select:all;-webkit-user-select:all}.pubrow{display:flex;flex-wrap:wrap;align-items:center;gap:10px 20px}.pubrow .quiet{align-self:center}.pubrow .quiet.on{color:#fff}.pubrow [disabled]{opacity:.4;cursor:default}.fine{margin:0;color:var(--dim);font:400 12px/1.5 var(--mono)}.said.fine{color:var(--soft)}.gs-share{display:none!important}.can-share .gs-share{display:inline-flex!important}");
  n = mc(out, n, ".playbar{position:fixed;left:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:4;display:flex;flex-direction:column;gap:10px;width:max-content;max-width:min(400px,calc(100vw - 32px));padding:14px 16px;background:rgba(0,0,0,.72);user-select:text;-webkit-user-select:text}.playbar h1{margin:0;font-weight:600;font-size:20px;line-height:1.15;letter-spacing:-.02em;overflow-wrap:anywhere}.playbar p{margin:0;color:var(--soft);font:400 13px/1.45 var(--sans)}.playbar p.mono{color:var(--dim);font:400 11px/1 var(--mono)}.playbar .btn,.pubbox a.btn{appearance:none;height:38px;padding:0 18px;border:1px solid rgba(255,255,255,.5);background:none;cursor:pointer;text-decoration:none}.playbar .btn:hover,.playbar .btn:focus-visible{background:#fff;color:#000;outline:0}a.btn{text-decoration:none;cursor:pointer}@media (max-width:520px){.sheet:has(.pubbox){padding:0 0 12px;gap:6px}.gs:has(.pubbox) .player-ui{opacity:0;pointer-events:none}.pubbox .lede{margin-bottom:18px}}@media (pointer:coarse){.pubgo{min-height:44px}.playbar .btn{height:44px}}");
  // "your games" (a list of the account's games, a line each; logged in at the ring the button by your icon opens it, "yours", in a panel under the top bar)
  n = mc(out, n, ".mine.yours{position:fixed;top:62px;right:12px;z-index:5;width:max-content;max-width:min(400px,calc(100vw - 24px));max-height:calc(100dvh - 90px);overflow-y:auto;margin:0;padding:14px;background:rgba(0,0,0,.84);border:1px solid var(--line);align-items:stretch}.mine.yours .eye{margin:0 0 4px}");
  n = mc(out, n, ".mine{margin-top:28px;display:flex;flex-direction:column;align-items:flex-start;gap:8px}.mine .game{appearance:none;background:transparent;border:1px solid rgba(255,255,255,.28);color:#fff;padding:10px 14px;margin:0;font:400 13px/1.4 var(--mono);letter-spacing:.04em;text-align:left;cursor:pointer;min-height:44px}.mine .game:hover,.mine .game:focus-visible{border-color:#fff}.mine p.game{border-style:dashed;color:rgba(255,255,255,.6);cursor:default}");
  n = gs_css_agents(out, n);
  return n;
}
// /agents' look (web/agents.coax; issue 29): the component kit's pieces (the side, its rows, the composer, the
// select, a message, the tool line) in this site's black, white and grey. Every rule is under .ag, so none
// touches another page's (.btn, .menu and .log are the site's own names too).
gs_css_agents :: (out: [] u8, at: int) -> int {
  n := at;
  // the page: as tall as the window, the top bar over a black ground; the chats down the left, the conversation and the box at its foot
  n = mc(out, n, ".gs.v5{height:100dvh;overflow:hidden;background:#000}.gs.v5 .top{flex:none;position:relative;z-index:9}.ag{flex:1;min-height:0;display:flex;position:relative;border-top:1px solid var(--line);background:#000;color:#fff;font:400 14px/1.5 var(--sans)}.ag .fr{display:none}.ag .ic{display:block;flex:none;width:16px;height:16px}@keyframes agturn{to{transform:rotate(360deg)}}");
  // the kit's buttons, in this site's black and white (never the site's own wide capitals)
  n = mc(out, n, ".ag .btn{appearance:none;display:inline-flex;align-items:center;justify-content:center;flex:none;height:34px;margin:0;padding:0 14px;border:1px solid rgba(255,255,255,.3);border-radius:8px;background:none;color:#fff;font:500 13px/1 var(--sans);letter-spacing:0;text-transform:none;white-space:nowrap;cursor:pointer}.ag .btn:hover,.ag .btn:focus-visible{border-color:#fff;outline:0}.ag .btn[data-state=primary]{background:#fff;border-color:#fff;color:#000}.ag .btn[disabled]{opacity:.4;cursor:default;border-color:rgba(255,255,255,.3)}.ag .ib{appearance:none;display:inline-flex;align-items:center;justify-content:center;flex:none;width:36px;height:36px;margin:0;padding:0;border:0;border-radius:8px;background:none;color:var(--soft);cursor:pointer}.ag .ib:hover,.ag .ib:focus-visible{background:rgba(255,255,255,.1);color:#fff;outline:0}");
  // the list of agents: its head, the list (it alone scrolls), a game's name and picture over its agents, and the foot
  n = mc(out, n, ".ag .side{flex:none;width:292px;min-height:0;display:flex;flex-direction:column;border-right:1px solid var(--line);background:#0b0b0b}.ag .side-h{flex:none;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 10px 10px 18px}.ag .side-n{margin:0;font:600 14px/1.2 var(--sans)}.ag .side-l{flex:1;min-height:0;overflow-y:auto;padding:0 8px 12px}.ag .side-m{display:flex;justify-content:space-between;gap:8px;margin:16px 10px 6px;color:var(--soft);font:500 12px/1.3 var(--sans)}.ag .side-m span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag .side-c{color:var(--dim)}.ag .side-f{flex:none;max-height:45%;overflow-y:auto;padding:8px;border-top:1px solid var(--line)}.ag .agpic{margin:0 10px 6px}.ag .agpic img{width:100%;aspect-ratio:5/3;object-fit:cover;border:1px solid var(--line);border-radius:8px}");
  n = mc(out, n, ".ag .row{appearance:none;position:relative;display:flex;flex-direction:column;justify-content:center;gap:2px;width:100%;min-height:44px;margin:0;padding:7px 10px;border:0;border-radius:8px;background:none;color:#fff;font:400 14px/1.35 var(--sans);text-align:left;text-decoration:none;cursor:pointer}.ag .row:hover,.ag .row:focus-visible{background:rgba(255,255,255,.08);outline:0}.ag .row[aria-current]{background:rgba(255,255,255,.14)}.ag .row[data-state=busy]{padding-right:34px}.ag .row>.ic{position:absolute;right:10px;top:14px;color:var(--soft);animation:agturn 2.4s linear infinite}.ag .row-t{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag .meta{margin:0;color:var(--dim);font:400 12px/1.4 var(--sans)}.ag p.meta{margin:10px 10px 4px}.ag .meta.over{color:#fff;font-weight:600}.ag-fine{margin:8px 10px;color:var(--dim);font:400 12px/1.5 var(--sans);overflow-wrap:anywhere}.ag-comps .ag-fine{color:var(--soft)}");
  // the conversation: its bar, the log (it scrolls, and stays at its newest), and each kind of line in it
  n = mc(out, n, ".ag-main{flex:1;min-width:0;min-height:0;display:flex;flex-direction:column}.ag-bar{flex:none;display:flex;align-items:center;gap:12px;min-height:56px;padding:8px 20px;border-bottom:1px solid var(--line)}.ag-bar .ib{display:none}.ag-who{flex:1;min-width:0}.ag-who h1{margin:0;font:600 15px/1.3 var(--sans);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag-who p{margin:2px 0 0;color:var(--dim);font:400 12px/1.4 var(--sans);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag-go{flex:none;color:#fff;font:500 13px/1.3 var(--sans);text-decoration:underline;text-underline-offset:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag-log{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column-reverse;padding:0 20px}.ag-thread{width:100%;max-width:760px;margin:0 auto auto;padding:20px 0 12px;display:flex;flex-direction:column;gap:12px}.ag-empty{margin:12vh 0 0;text-align:center}.ag-empty h2{margin:0;font:600 clamp(22px,3vw,30px)/1.2 var(--sans);letter-spacing:-.02em}.ag-empty p{margin:10px 0 0;color:var(--soft)}");
  n = mc(out, n, ".ag .msg-user{align-self:flex-end;max-width:min(560px,86%);padding:9px 14px;border-radius:16px;background:rgba(255,255,255,.13)}.ag .msg-user p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.ag .msg-ai{min-width:0}.ag .md{font:400 15px/1.6 var(--sans);overflow-wrap:anywhere}.ag .md>*{margin:0 0 10px}.ag .md>:last-child{margin-bottom:0}.ag .md h1,.ag .md h2,.ag .md h3,.ag .md h4{font:600 16px/1.35 var(--sans)}.ag .md ul,.ag .md ol{padding-left:22px}.ag .md code{padding:1px 5px;border-radius:4px;background:rgba(255,255,255,.1);font:400 13px/1.5 var(--mono)}.ag .md a{color:#fff}.ag .md pre{margin:0;padding:10px 12px;overflow-x:auto;font:400 13px/1.5 var(--mono)}.ag .md pre code{padding:0;background:none}.ag .code{border:1px solid var(--line);border-radius:8px}.ag .code-h{display:flex;align-items:center;justify-content:space-between;padding:0 2px 0 12px;border-bottom:1px solid var(--line)}.ag .code-h .meta{margin:0}.ag .md table{display:block;overflow-x:auto;border-collapse:collapse}.ag .md td{padding:4px 8px;border:1px solid var(--line)}");
  n = mc(out, n, ".ag .tool{min-width:0;border:1px solid var(--line);border-radius:8px}.ag .tool-h{appearance:none;display:flex;align-items:center;gap:8px;width:100%;min-height:40px;margin:0;padding:6px 10px;border:0;border-radius:8px;background:none;color:#fff;font:400 13px/1.4 var(--sans);text-align:left;cursor:pointer}.ag .tool-h:hover,.ag .tool-h:focus-visible{background:rgba(255,255,255,.06);outline:0}.ag .gl{flex:none;display:inline-flex;color:var(--soft)}.ag .gl[data-state=no]{border-radius:50%;background:#fff;color:#000}.ag .gl[data-state=run] .ic{animation:agturn 2.4s linear infinite}.ag .tool-k{flex:none;max-width:34%;color:var(--soft);font:400 12px/1.4 var(--mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag .tool-d{flex:1;min-width:0;font:400 13px/1.4 var(--mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag .tool-x{flex:none;color:var(--dim)}.ag [data-state=no]>.tool-h{align-items:flex-start}.ag [data-state=no] .tool-d{white-space:normal;overflow-wrap:anywhere}.ag .tool-b{position:relative;padding:10px 46px 10px 12px;border-top:1px solid var(--line)}.ag .tool-b pre{margin:0 0 8px;color:var(--soft);font:400 12px/1.5 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}.ag .tool-b pre:last-of-type{margin:0;color:#fff}.ag .tool-b .ib{position:absolute;right:5px;top:5px}");
  n = mc(out, n, ".ag-change{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;padding:8px 12px;border:1px dashed rgba(255,255,255,.28);border-radius:8px}.ag-change p{flex:1;min-width:180px;margin:0;color:var(--soft);font-size:13px;overflow-wrap:anywhere}.ag-line{margin:0;color:var(--dim);font-size:13px;overflow-wrap:anywhere}.ag .notice{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:10px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.ag .notice-k{margin:0;font:600 13px/1.3 var(--sans)}.ag .notice-t{margin:0;color:var(--soft);font-size:13px;overflow-wrap:anywhere}.ag .notice .btn{margin-top:6px}.ag-live{display:flex;align-items:center;gap:8px;color:var(--soft);font-size:13px}.ag-live>span:last-child{min-width:0;overflow-wrap:anywhere}");
  // the foot: what the last press came to, the message box with the game control and Send under it, and the limits' one line
  n = mc(out, n, ".ag-dock{flex:none;width:100%;max-width:800px;margin:0 auto;padding:8px 20px calc(14px + env(safe-area-inset-bottom,0px))}.ag-said{margin:0 0 8px;color:var(--soft);font-size:13px;overflow-wrap:anywhere}.ag-said.no{padding-left:10px;border-left:2px solid #fff;color:#fff}.ag .composer{padding:10px 10px 8px 14px;border:1px solid rgba(255,255,255,.3);border-radius:14px;background:#111}.ag .composer:focus-within{border-color:#fff}.ag .composer textarea{display:block;width:100%;max-height:40dvh;margin:0;padding:4px 0;border:0;outline:0;resize:none;background:none;color:#fff;font:400 16px/1.45 var(--sans)}.ag .composer textarea::placeholder{color:var(--dim)}.ag .composer-r{display:flex;align-items:center;gap:10px;margin-top:6px}.ag .composer-r>.btn{margin-left:auto}.ag .composer-r>.meta{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag .anchor{position:relative;min-width:0}.ag .sel{appearance:none;display:inline-flex;align-items:center;gap:6px;max-width:100%;height:34px;margin:0;padding:0 10px;border:1px solid var(--line);border-radius:8px;background:none;color:#fff;font:400 13px/1 var(--sans);cursor:pointer}.ag .sel:hover,.ag .sel:focus-visible,.ag .sel[aria-expanded=true]{border-color:#fff;outline:0}.ag .sel-l{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ag .menu.pop{position:absolute;left:0;right:auto;top:auto;bottom:calc(100% + 8px);z-index:6;display:block;width:min(340px,calc(100vw - 40px));min-width:0;max-height:min(70dvh,560px);overflow-y:auto;padding:6px;border:1px solid rgba(255,255,255,.3);border-radius:12px;background:#111}.ag-dock>.ag-fine{margin:8px 4px 0;text-align:center}");
  // a narrow screen: the list is a drawer over the conversation, opened by the bar's button and shut by a press beside it
  n = mc(out, n, ".ag-scrim{display:none}@media (max-width:860px){.ag .row-t,.ag-who h1{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow-wrap:anywhere}.ag .side{position:absolute;left:0;top:0;bottom:0;z-index:8;width:min(320px,86vw);visibility:hidden;transform:translateX(-100%)}.ag.out .side{visibility:visible;transform:none}.ag.out .ag-scrim{display:block;position:absolute;inset:0;z-index:7;appearance:none;margin:0;padding:0;border:0;background:rgba(0,0,0,.62);cursor:pointer}.ag-bar{padding:8px 12px;gap:8px}.ag-bar .ib{display:inline-flex;margin-left:-6px}.ag-log{padding:0 12px}.ag-dock{padding-left:12px;padding-right:12px}.ag-empty{margin-top:8vh}}@media (prefers-reduced-motion:reduce){.ag .row>.ic,.ag .gl[data-state=run] .ic{animation:none}}");
  return n;
}

#test "the complete responsive stylesheet fits the site's allocation" {
  css:[GS_CSS]u8;n:=gs_css(css[..],0);#assert n>0 && n<GS_CSS;
}

// A picture that is on this site.
gs_img :: (t: [] Tree, id: string, src: string, alt: string) -> int {
  i := tr_open(t, id, TG_IMG, "");
  tr_attr(t, i, AT_SRC, src); tr_attr(t, i, AT_LABEL, alt);
  tr_close(t);
  return i;
}

