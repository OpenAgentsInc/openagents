  // and again changes nothing more
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "esc"); #assert k[0].tool == BL_T_NONE && !k[0].editing && !s[0].panel && c[0].cam == GS_CAM_FOLLOW;
  // the shapes tool's two groups: picked, a row stands over its slot: four shapes, a line, two modes (snap and free: nothing drops in); the shape and the mode it has are lit
