  // all the way down: no gravity at all
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "p.world.gravity"), "0"); q0 := gs_frame(s, 0.016, true);
  #assert k[0].grav == 0 && tr_text_of(tr, tr_find(tr, "p.world.gravity.v")) == "0 x" && gs_test_line(tr) == "-1 0 0 0 1 1 0 0 0";
  gs_event(s, GS_CLICK, gs_test_slot(s, "p.world.gravity.r"), 0); r := gs_frame(s, 0.016, true);
  #assert k[0].grav == BL_GRAV && tr_text_of(tr, tr_find(tr, "p.world.gravity.v")) == "1 x" && tr_find(tr, "p.world.gravity.r") < 0 && tr_text_of(tr, tr_find(tr, "state")) == "-1 0 0 10 1 1 0 0 0\ncamera.view=follow\n";
  // a press turns flying off, a choice is the morning, and the camera's choice is the camera menu's: each moves to the top, changed
  gs_event(s, GS_CLICK, gs_test_slot(s, "p.player.fly.t"), 0); r1 := gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "p.world.time_of_day.c3"), 0); r2 := gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "p.camera.view.c2"), 0); r3 := gs_frame(s, 0.016, true);
  #assert pr_value(k[0].props[..], TW_FLY) == 0 && pr_value(k[0].props[..], TW_TIME_OF_DAY) == 3 && c[0].cam == GS_CAM_FIRST && tr_text_of(tr, tr_find(tr, "p.player.fly.t")) == "off" && tr_find(tr, "p.player.fly.r") > 0;
  #assert tr_text_of(tr, tr_find(tr, "state")) == "-1 0 0 10 2 1 0 0 0\nworld.time_of_day=morning\nplayer.fly=off\ncamera.view=first_person\n";
  // the camera menu sets the same row
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "4"); r4 := gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "hot.o.3.1"), 0); r5 := gs_frame(s, 0.016, true);
  #assert c[0].cam == GS_CAM_FOLLOW && pr_value(k[0].props[..], TW_VIEW) == 1;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "4");
  // every setting back at once
  gs_event(s, GS_CLICK, gs_test_slot(s, "p.all"), 0); r6 := gs_frame(s, 0.016, true);
  #assert pr_value(k[0].props[..], TW_FLY) == 1 && k[0].props[0].over[0].n == 0 && tr_find(tr, "p.h.changed") < 0;
  #assert c[0].cam == GS_CAM_ORBIT;
  ch_cam(c, GS_CAM_FOLLOW);   // (as the checks after this left it)
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "p.world.gravity"), "0"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "p.world.gravity"), "500"); #assert k[0].grav == 50;
  // Escape shuts the settings; the slot again opens them
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "esc"); u := gs_frame(s, 0.016, true);
  #assert !s[0].panel && gs_test_slot(s, "world") < 0;
  // left for the logout that follows: a tool, edit mode, a selection, the settings open, a changed gravity
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "1"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "2"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "5");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), cast(string) sel[0..<m]); v := gs_frame(s, 0.016, true);
  #assert k[0].tool == BL_T_BLOCK && k[0].editing && k[0].sel > 0 && s[0].panel && gs_test_slot(s, "sel") < 0 && gs_test_slot(s, "world") >= 0;
  // and the model is told what is selected with the next message
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "make this one taller"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  #assert gs_wants(s) && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "settings changed: world.gravity 5, camera.view follow\\nmode: edit\\nselected: b");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"ok.\"}}]}");
}

#test "yes to the agent's offer starts a build agent: its start goes to its own door, it is read at its own address while it works, its row says its state, and its plan lines are made" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..];nonce:[16]u8;gs_entropy(s,nonce[..],true);
  gs_test_say(s, GS_ADDRESS, 0, "/login");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "ada@example.com"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "123456"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  gs_test_answer(s, 200, "{\"state\":\"logged-in\",\"account\":\"acct_1\"}");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s);
  say := gs_test_slot(s, "say");
  gs_test_say(s, GS_INPUT, say, "make the blocks never fall"); gs_event(s, GS_SUBMIT, say, 0);
  gs_test_route(s, "make/capability");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"content\":\"route: make/capability\\n\\nnot yet. want me to start a build agent on it?\"}}]}");
  gs_test_say(s, GS_INPUT, say, "yes"); gs_event(s, GS_SUBMIT, say, 0);
  #assert gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "offer/accept");
  gs_test_route(s, "offer/accept");
  // the start, to its own door, as a POST
  #assert gs_wants(s) && gs_test_door(s) == "/api/gamebuilder/agents/v1" && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "\"job\":\"make the blocks never fall\"");
  #assert gs_has(gs_test_pool(s), "build agent, starting. the job: make the blocks never fall") && gs_has(gs_test_pool(s), "about 6 minutes, and it costs you nothing for now.");
  gs_test_answer(s, 202, "{\"turn_id\":\"0193a9b2-7c1d-7e2f-8a3b-4c5d6e7f8a9b\",\"state\":\"queued\"}");
  #assert gs_has(gs_test_pool(s), "build agent, waiting for a runner.");
  // two seconds on, it is read: a GET of its own address, the turn's id in it
  for k: 0..<140 { f := gs_frame(s, 0.016, true); }
  #assert gs_wants(s) && gs_test_door(s) == "/api/gamebuilder/agent/v1?id=0193a9b2-7c1d-7e2f-8a3b-4c5d6e7f8a9b" && gs_body_len(s) == 0;
  // what the chat asks still goes while it works
  gs_test_answer(s, 200, "{\"state\":\"completed\",\"content\":[{\"type\":\"text\",\"text\":\"physics is off.\\n+ set world.physics off\"}],\"error\":null}");
  #assert gs_has(gs_test_pool(s), "build agent, done.") && pr_value(s[0].chat[0].blocks[0].props[..], TW_PHYSICS) == 0 && ch_test_said(s[0].chat[..]) == "physics is off." && s[0].flight == GS_NOBODY;
}
#test "yes to the offer, on a world that is a game on your account, starts a cloud Builder there: agent-new, its limits said, and /agents follows it" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..];nonce:[16]u8;gs_entropy(s,nonce[..],true);
  gs_test_say(s, GS_ADDRESS, 0, "/login");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "ada@example.com"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "123456"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  gs_test_answer(s, 200, "{\"state\":\"logged-in\",\"account\":\"acct_1\"}");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s);
  // this world is game 3 on the account (web/account.coax keeps which)
  s[0].acct[0].link[0].game = 3;
  say := gs_test_slot(s, "say");
  gs_test_say(s, GS_INPUT, say, "make a maze of walls"); gs_event(s, GS_SUBMIT, say, 0);
  gs_test_route(s, "make/capability");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"content\":\"route: make/capability\\n\\nnot yet. want me to start a build agent on it?\"}}]}");
  gs_test_say(s, GS_INPUT, say, "yes"); gs_event(s, GS_SUBMIT, say, 0);
  gs_test_route(s, "offer/accept");
  #assert gs_wants(s) && gs_test_door(s) == "/api/rows/agent-new" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"game\":3,\"role\":\"build\",\"job\":\"make a maze of walls\"}";
  #assert gs_has(gs_test_pool(s), "starting a builder on your account on that. its limits: each message: at most 12 model steps (a step runs at most 8 commands), 100,000 tokens, 30 changes and 10 minutes") && gs_has(gs_test_pool(s), "/agents shows it as it works.");
  gs_test_answer(s, 200, "{\"ok\":true,\"agent\":\"c1-0\",\"state\":\"queued\",\"level\":5,\"limits\":\"...\"}");
  #assert gs_has(gs_test_pool(s), "build agent, working on your account: /agents shows it, and its changes come to this world. the job: make a maze of walls") && s[0].flight != GS_AGENT_ASKS;
  // asked again, a refusal is the row's own words
  gs_test_say(s, GS_INPUT, say, "and a moat"); gs_event(s, GS_SUBMIT, say, 0);
  gs_test_route(s, "make/capability");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"content\":\"route: make/capability\\n\\nnot yet. want me to start a build agent on it?\"}}]}");
  gs_test_say(s, GS_INPUT, say, "yes"); gs_event(s, GS_SUBMIT, say, 0);
  gs_test_route(s, "offer/accept");
  #assert gs_wants(s) && gs_test_door(s) == "/api/rows/agent-new";
  gs_test_answer(s, 200, "{\"ok\":false,\"error\":\"not-here\",\"why\":\"this server runs no cloud agents just now (it has no model key): start one in GameBuilder on your Mac\"}");
  #assert gs_has(gs_test_pool(s), "build agent, it didn't start: this server runs no cloud agents just now");
}
#test "who is logged in decides what an address shows: / and /login become the world, /play too, and nobody at /play is in the builder as a guest" #steps 2000000000 {
  // the home page, logged in: the world, and the address stays
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  #assert s[0].view == GS_HOME_VIEW;
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  #assert s[0].view == GS_WORLD_VIEW && s[0].picking && gs_test_slot(s, "kind.0") >= 0 && gs_test_slot(s, "say") < 0 && gs_go(s) == 0;
  // while it was still being asked who is here, the class already held the camera at the picker's pose
  // side-scroller picked: the model is told the game type with the world
  // (the name is a link: the page keeps the press, putting the world's address, /, in the bar, so the browser doesn't follow it)
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.3"), 0);
  #assert gs_go(s) == 1 && s[0].go[0] == '/';
  gs_test_frames(s); k1 := gs_frame(s, 0.016, true);
  #assert s[0].chat[0].kind == 3 && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v2 g3");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "hello"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "chat");
  #assert gs_wants(s) && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "world now:\\ngame type: side-scroller\\n");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hi.\"}}]}");
  // the medieval village picked: the art's credit is on the page for as long as the village is (and in the menu always),
  // the follow button is there (it is third person), and what the HUD says is here goes to the model
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); v1 := gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "type"), 0); gs_test_frames(s); v2 := gs_frame(s, 0.016, true);
  // the picker: the village's card says whose art it is as its tooltip, and nothing else on the page does
  #assert tr_attr_of(s[0].tree[..], tr_find(s[0].tree[..], "kind.4"), AT_TITLE) == GS_VILLAGE_CREDIT && tr_attr_of(s[0].tree[..], tr_find(s[0].tree[..], "kind.0"), AT_TITLE) == "";
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.4"), 0); gs_test_frames(s); v3 := gs_frame(s, 0.016, true);
  vp := cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n];
  #assert s[0].chat[0].blocks[0].n == 1 + GT_GREEN && s[0].chat[0].blocks[0].b[0].kind == BL_BALL && s[0].chat[0].blocks[0].b[1].kind == BL_BUILDING;   // the green starts with a ball and its nine buildings
  #assert s[0].chat[0].kind == GS_VILLAGE && gs_has(vp, "gs v2 g4") && gs_test_slot(s, "hot.s.3") >= 0 && gs_test_slot(s, "note") >= 0;
  // nothing about licences shows while playing
  #assert !gs_has(vp, "Wildfire") && !gs_has(vp, "CC BY") && !gs_has(vp, "0 A.D.") && gs_test_slot(s, "credit") < 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "note"), "a village green. its buildings are solid: things of the list.");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "what is here?"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "chat");
  #assert gs_wants(s) && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "world now:\\ngame type: medieval village\\n") && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "\\na village green. its buildings are solid: things of the list.\\n");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"a market.\"}}]}");
  // the menu has a quiet way to the credits page, and no credit text of its own; the page opens with no load, the address follows,
  // and the way back is to the world as it was: the village, no picker
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); v4 := gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "nav.credits") >= 0 && !gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "Wildfire");
  gs_event(s, GS_CLICK, gs_test_slot(s, "nav.credits"), 0); gs_test_frames(s); c1 := gs_frame(s, 0.016, true);
  cp := cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n];
  #assert s[0].view == GS_CREDITS_VIEW && gs_go(s) == 8 && cast(string) s[0].go[0..<8] == "/credits" && gs_has(cp, "gs v3") && !gs_wants(s) && gs_test_slot(s, "say") < 0;
  #assert gs_has(cp, "0 a.d. buildings and rocks") && gs_has(cp, "Wildfire Games") && gs_has(cp, "https://www.wildfiregames.com/") && gs_has(cp, "CC BY-SA 3.0") && gs_has(cp, "https://creativecommons.org/licenses/by-sa/3.0/");
  #assert gs_has(cp, "/assets/village.pack") && gs_has(cp, "/assets/village-credits.txt") && gs_has(cp, "/assets/village-pack.coax") && gs_has(cp, "Quaternius") && gs_has(cp, "CC0 1.0") && gs_has(cp, "SIL Open Font License 1.1") && gs_has(cp, "Romel Perez") && gs_has(cp, "MIT") && gs_has(cp, "back to the world");
  gs_event(s, GS_CLICK, gs_test_slot(s, "home"), 0); gs_test_frames(s); c2 := gs_frame(s, 0.016, true);
  #assert s[0].view == GS_WORLD_VIEW && !s[0].picking && s[0].chat[0].kind == GS_VILLAGE && gs_go(s) == 1 && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v2 g4");
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); v4b := gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "type"), 0); gs_test_frames(s); v5 := gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.3"), 0); gs_test_frames(s); v6 := gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "credit") < 0 && !gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "Wildfire Games") && s[0].chat[0].note_n == 0 && s[0].chat[0].blocks[0].n == 4;
  // /credits opened by its address, by someone logged in: the credits, not the world; the address stays; back goes to the picker
  ca: [1] GsTest; cb := ca[0].s[..];
  gs_test_say(cb, GS_ADDRESS, 0, "/credits");
  gs_test_answer(cb, 200, "{\"logged_in\":true}");
  #assert cb[0].view == GS_CREDITS_VIEW && gs_go(cb) == 0 && gs_has(cast(string) cb[0].tree[0].pool[0..<cb[0].tree[0].pool_n], "Wildfire Games") && gs_test_slot(cb, "me") >= 0;
  gs_event(cb, GS_CLICK, gs_test_slot(cb, "home"), 0); gs_test_frames(cb);
  #assert cb[0].view == GS_WORLD_VIEW && cb[0].picking && gs_go(cb) == 1;
  // and by nobody: the credits, with the way in at the top; back is the home page, whose footer leads here again
  cc: [1] GsTest; cd := cc[0].s[..];
  gs_test_say(cd, GS_ADDRESS, 0, "/credits");
  gs_test_answer(cd, 200, "{\"logged_in\":false}");
  #assert cd[0].view == GS_CREDITS_VIEW && gs_go(cd) == 0 && gs_has(cast(string) cd[0].tree[0].pool[0..<cd[0].tree[0].pool_n], "CC BY-SA 3.0") && gs_test_slot(cd, "nav.login") >= 0 && gs_test_slot(cd, "me") < 0;
  #assert gs_has(cast(string) cd[0].tree[0].pool[0..<cd[0].tree[0].pool_n], ">back<") == false && gs_test_slot(cd, "home") >= 0;
  gs_event(cd, GS_CLICK, gs_test_slot(cd, "home"), 0); gs_test_frames(cd); c3 := gs_frame(cd, 0.016, true);
  #assert cd[0].view == GS_HOME_VIEW && gs_go(cd) == 1 && gs_test_slot(cd, "foot.credits") >= 0 && tr_attr_of(cd[0].tree[..], tr_find(cd[0].tree[..], "kind.4"), AT_TITLE) == GS_VILLAGE_CREDIT;
  gs_event(cd, GS_CLICK, gs_test_slot(cd, "foot.credits"), 0); gs_test_frames(cd); c4 := gs_frame(cd, 0.016, true);
  #assert cd[0].view == GS_CREDITS_VIEW && gs_go(cd) == 8 && gs_has(cast(string) cd[0].tree[0].pool[0..<cd[0].tree[0].pool_n], "0 a.d. buildings and rocks");
  // /login, logged in: the world, and the address becomes /
  u: [1] GsTest; v := u[0].s[..];
  gs_test_say(v, GS_ADDRESS, 0, "/login");
  gs_test_answer(v, 200, "{\"logged_in\":true}");
  #assert v[0].view == GS_WORLD_VIEW && gs_go(v) == 1 && v[0].go[0] == '/';
  // /play, logged in: the same
  w: [1] GsTest; x := w[0].s[..];
  gs_test_say(x, GS_ADDRESS, 0, "/play");
  gs_test_answer(x, 200, "{\"logged_in\":true}");
  #assert x[0].view == GS_WORLD_VIEW && gs_go(x) == 1 && x[0].go[0] == '/';
  // /play, nobody: the builder all the same (a guest builds with no account): the picker, and the address stays
  y: [1] GsTest; z := y[0].s[..];
  gs_test_say(z, GS_ADDRESS, 0, "/play");
  gs_test_answer(z, 0, "");
  #assert z[0].view == GS_WORLD_VIEW && z[0].picking && gs_go(z) == 0 && gs_test_slot(z, "kind.7") >= 0 && gs_test_slot(z, "email") < 0;
  // Back to / once logged in is still the world, as the type it was: no picker again
  gs_test_say(s, GS_ADDRESS, 0, "/");
  #assert s[0].view == GS_WORLD_VIEW && !s[0].picking && s[0].chat[0].kind == 3;
  // a page opened by someone who was logged in: its class holds the camera at the picker's pose from the first frame
  q: [1] GsTest; r := q[0].s[..];
  gs_test_say(r, GS_ADDRESS, 0, "/"); f0 := gs_frame(r, 0.016, true);
  #assert gs_has(cast(string) r[0].tree[0].pool[0..<r[0].tree[0].pool_n], "gs v0 asking");
}

// What the page's tree holds.
gs_test_pool :: (s: [] Site) -> string { return cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n]; }
#test "crates is a world of its own and built in like any: its card, its first room's nine things in it at first, the build tools and its own reset (R) on its hotbar, a plan's edits made, and the meadow as it was after it" #steps 400000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  #assert s[0].picking && gs_has(gs_test_pool(s), "crates") && gs_has(gs_test_pool(s), "push crates onto pads. open the gate.") && gs_has(gs_test_pool(s), "/img/kind-crates.jpg") && gs_kind_of("kind.5") == GS_CRATES && gs_kind_of("kind.h.5") == GS_CRATES && gs_kind_of("kind.6") == GS_PLATFORMER && gs_kind_of("kind.7") == GS_RACING && gs_kind_of("kind.8") == GS_DRIFT && gs_kind_of("kind.9") == -1;
  #assert k[0].n == 4;
  // a tool picked and the settings open in the meadow first: neither is carried into the puzzle
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "1"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "5");
  #assert k[0].tool != BL_T_NONE && s[0].panel && gs_test_slot(s, "hot.s.8") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); gs_test_frames(s); gs_event(s, GS_CLICK, gs_test_slot(s, "type"), 0); gs_test_frames(s);
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.5"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  #assert c[0].kind == GS_CRATES && gs_has(gs_test_pool(s), "gs v2 g5") && k[0].n == 9 && k[0].tool == BL_T_NONE && !s[0].panel && k[0].grav == BL_GRAV;
  // the hotbar: the build tools and the room's own kinds (no camera menu: the room's camera is its own), then its reset, then more
  #assert gs_test_slot(s, "hot.s.9") >= 0 && gs_test_slot(s, "hot.s.10") < 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.0")) == "shapes" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.1")) == "wall" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.2")) == "goal" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.3")) == "edit" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.4")) == "decide" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.5")) == "world" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.6")) == "reset" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.7")) == "undo" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.9")) == "more";
  // a wall item: the shapes tool picked as a pillar, lit on its own slot; what the HUD places with it is a wall
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.1"), 0); f = gs_frame(s, 0.016, true);
  #assert k[0].tool == BL_T_PILLAR && k[0].brush == BL_R_WALL && tr_class(s[0].tree[..], tr_find(s[0].tree[..], "hot.s.1")) == "hb-s hb-on hud k2" && tr_class(s[0].tree[..], tr_find(s[0].tree[..], "hot.s.0")) == "hb-s hud k2";
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 2.00 2.00 1.00 1.00 3.00 0.00 rest"); #assert k[0].n == 10 && k[0].b[9].role == BL_R_WALL;
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.1"), 0); f = gs_frame(s, 0.016, true); #assert k[0].tool == BL_T_NONE && k[0].brush == BL_R_NONE;
  gs_things_anew(s, c[0].kind); f = gs_frame(s, 0.016, true);
  told := gs_test_line(s[0].tree[..]);
  #assert told.count > 6 && cast(string) told[told.count - 6..<told.count] == " 0 0 0";
  // R, a press of the slot and its key: each is one more press told to the HUD
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); f = gs_frame(s, 0.016, true);
  told = gs_test_line(s[0].tree[..]);
  #assert s[0].act == 1 && cast(string) told[told.count - 6..<told.count] == " 1 0 0";
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.6"), 0); #assert s[0].act == 2;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "7"); #assert s[0].act == 3;
  // 1 is the shapes tool here as anywhere: picked, it places
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "1"); #assert k[0].tool != BL_T_NONE && s[0].act == 3;
  // the model is told the game type, how building goes here and the room (the HUD's words), and a plan it sends is made
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "note"), "a crate puzzle, seen from above. room 1 of 3. pads lit: 0 of 1.");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "put a wall here"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  #assert gs_wants(s) && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "world now:\\ngame type: crates (a crate puzzle, seen from above)\\nbuilding here: the room is things of this level: its walls, its crates, its pads, its gate and where the person starts; move, size, add or remove any of them.") && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "kinds here, a place line's last word: wall (a fixed block nothing pushes") && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "leaving by its gate opens the next.\\na crate puzzle, seen from above. room 1 of 3. pads lit: 0 of 1.\\n");
  #assert !gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "nothing can be built");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\ndone.\\n+ place 0 3 4 0.5 1 0 rest\"}}]}");
  #assert k[0].n == 10 && k[0].b[9].z == 300 && k[0].b[9].w == 400 && k[0].b[9].rest;
  // back to third person: the meadow's things and its hotbar again, and R is nothing there
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); gs_test_frames(s); gs_event(s, GS_CLICK, gs_test_slot(s, "type"), 0); gs_test_frames(s);
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert c[0].kind == 0 && k[0].n == 4 && gs_test_slot(s, "hot.s.0") >= 0 && gs_test_slot(s, "hot.s.8") < 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.3")) == "camera";
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); #assert s[0].act == 3;
}
#test "the village's bar: its houses, the market and the rock first; a building tool turned by R and Shift+R and told to the HUD; the rock's kind by its options or Q; a placed building selected, turned by its panel, and never sized" #steps 1000000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.4"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  #assert c[0].kind == GS_VILLAGE && k[0].models;
  // the bar: the buildings, then the page's own items, then more
  #assert tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.0")) == "britons house" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.1")) == "gauls house";
  #assert tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.2")) == "market" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.3")) == "rock" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.4")) == "edit";
  #assert gs_test_slot(s, "hot.s.8") >= 0 && gs_test_slot(s, "hot.s.9") < 0;
  // 1: the britons house; R turns it a quarter on, Shift+R back, and the HUD is told the turn last on its line
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "1"); f = gs_frame(s, 0.016, true);
  #assert k[0].tool == BL_T_MODEL && k[0].quarter == 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); f = gs_frame(s, 0.016, true);
  told := gs_test_line(s[0].tree[..]);
  #assert k[0].quarter == 2 && cast(string) told[told.count - 2..<told.count] == " 2" && gs_has(cast(string) told, "10 ");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "R"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "R"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "R");
  #assert k[0].quarter == 3;
  // Q does nothing to a house; X sets how it places
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "q"); #assert k[0].tool == BL_T_MODEL;
  #assert k[0].mode[1] == BL_M_FREE; gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "x"); #assert k[0].mode[1] == BL_M_SNAP;
  // 4: the rock, grey; Q makes it the mossy one, and again the grey one
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "4"); #assert k[0].tool == BL_T_MODEL + 4 && s[0].rock == 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "q"); #assert k[0].tool == BL_T_MODEL + 3 && s[0].rock == 1;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "q"); #assert k[0].tool == BL_T_MODEL + 4 && s[0].rock == 0;
  // the HUD puts a building (as the model would): it stands, is selected in edit mode, and its panel turns it, with no sizes
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "5"); f = gs_frame(s, 0.016, true);
  #assert k[0].editing;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "put gauls_house 12.00 -6.00 90.00"); f = gs_frame(s, 0.016, true);
  i := bl_chosen(k);
  #assert i >= 0 && k[0].b[i].kind == BL_BUILDING && k[0].b[i].model == 1 && k[0].b[i].turn == 90;
  #assert gs_test_slot(s, "sel.cw") >= 0 && gs_test_slot(s, "sel.ccw") >= 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "sel.turn")) == "90°" && gs_has(gs_test_pool(s), "gauls house");
  gs_event(s, GS_CLICK, gs_test_slot(s, "sel.cw"), 0); f = gs_frame(s, 0.016, true);
  #assert k[0].b[i].turn == 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "sel.turn")) == "0°";
  gs_event(s, GS_CLICK, gs_test_slot(s, "sel.ccw"), 0); #assert k[0].b[i].turn == 90;
  // a building is never sized
  sz := [3] int.[200, 200, 200];
  #assert !bl_line(k, "size", k[0].b[i].id, sz[..]) && k[0].b[i].turn == 90;
}
#test "the platformer is built in too: the build tools and its start over (R) on its hotbar, no camera menu; 'add a platform above my head' (a recorded conversation) puts a platform over the character, held there; what was built goes when another world of its own is picked" #steps 400000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  #assert s[0].picking && gs_has(gs_test_pool(s), "platformer") && gs_has(gs_test_pool(s), "run, jump, jump again. reach the goal.") && gs_has(gs_test_pool(s), "/img/kind-platformer.jpg");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.6"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  #assert c[0].kind == GS_PLATFORMER && gs_has(gs_test_pool(s), "gs v2 g6") && k[0].n == 111 && k[0].b[0].role == BL_R_NONE && k[0].b[109].role == BL_R_CHECKPOINT && k[0].tool == BL_T_NONE && k[0].far == 70000 && k[0].high == 6000;   // (the course: 111 things of the level)
  #assert gs_test_slot(s, "hot.s.9") >= 0 && gs_test_slot(s, "hot.s.10") < 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.0")) == "shapes" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.1")) == "pad" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.2")) == "spikes" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.3")) == "shard" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.4")) == "checkpoint" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.8")) == "reset" && gs_has(gs_test_pool(s), "start the course over (R)") && gs_has(gs_test_pool(s), "bounce pad: click the world. it throws the character up");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); f = gs_frame(s, 0.016, true); #assert s[0].act == 1;
  // the HUD says where the character is: 12.5 along the course, its feet 8.45 up
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "where"), "0 1250 0 100 0 845");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "note"), "a platformer, seen side on.");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "add a platform above my head"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  body := cast(string) s[0].req_body[0..<gs_body_len(s)];
  #assert gs_wants(s) && gs_has(body, "game type: platformer (a course of floating platforms, seen side on)\\nbuilding here: the course runs along z") && gs_has(body, "a platform above the person's head is a slab about 3 along z, 3 across, 0.5 thick, its bottom about 2.6 over their feet, at their z.") && gs_has(body, "\\na platformer, seen side on.\\nperson: at x 0 z 12.5, feet at height 8.45, facing x 0 z 1\\n") && !gs_has(body, "nothing can be built");
  // the answer as a model gives it: a slab over the head, at rest, high up the course (past the meadow's 12 m)
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\na platform over your head.\\n+ place 0 12.5 3 3 0.5 11.05 rest\"}}]}");
  #assert k[0].n == 112 && k[0].b[111].x == 0 && k[0].b[111].z == 1250 && k[0].b[111].y == 1105 && k[0].b[111].h == 50 && k[0].b[111].rest && c[0].refused_n == 0;
  // far along the course and high up, as the course is: within its own bounds
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "and one by the goal, high up"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\none by the goal.\\n+ place 0 600 3 3 0.5 45 rest\"}}]}");
  #assert k[0].n == 113 && k[0].b[112].z == 60000 && k[0].b[112].y == 4500 && c[0].refused_n == 0;
  // a pad asked for: the model's line names the kind last, and the HUD is told the block as a pad
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "put a bounce pad in front of me"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  body = cast(string) s[0].req_body[0..<gs_body_len(s)];
  #assert gs_has(body, "kinds here, a place line's last word: pad") && gs_has(body, "\\nb112: 0 12.5,") && gs_has(body, "things: 113 of 1000 (113 blocks, 0 balls)") && gs_has(body, "; the rest by id only (b1 to b113)");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\na bounce pad ahead.\\n+ place 0 15 2 2 0.25 8.45 rest pad\"}}]}");
  #assert k[0].n == 114 && k[0].b[113].role == BL_R_PAD && k[0].b[113].rest && c[0].refused_n == 0;
  wire: [16384] u8; wn := bl_wire(k, wire[..]); #assert gs_has(cast(string) wire[0..<wn], "\n114 11 1 1 0 ") && gs_has(cast(string) wire[0..<wn], " 0 0 1000 6000\n");
  // a wall is crates', not the course's: refused, and why is said to the model
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "a wall here"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\na wall.\\n+ place 0 16 1 1 3 8.45 rest wall\"}}]}");
  #assert k[0].n == 114 && c[0].refused_n > 0 && gs_has(cast(string) c[0].refused[0..<c[0].refused_n], "that kind is not built here");
  // another world of its own: nothing built here is carried there, and its bounds are the meadow's
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); gs_test_frames(s); gs_event(s, GS_CLICK, gs_test_slot(s, "type"), 0); gs_test_frames(s);
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert c[0].kind == GS_RACING && k[0].n == GT_CIRCUIT && k[0].far == BL_FAR && k[0].high == BL_HIGH;
}
#test "more: the last slot, never moved, opens every item by group; one used from it is used once; a drag rearranges the bar, takes a slot off or adds an item; a kept bar is checked; reset hotbar is the type's own again" #steps 1000000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..]; tr := s[0].tree[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  // the meadow's own bar, then more (key 0), fixed; the layout the glue keeps is the type's own
  #assert tr_text_of(tr, tr_find(tr, "hot.l.0")) == "shapes" && tr_text_of(tr, tr_find(tr, "hot.l.7")) == "more" && gs_has(tr_class(tr, tr_find(tr, "hot.s.7")), "hb-fix") && tr_find(tr, "pal") < 0;
  #assert tr_text_of(tr, tr_find(tr, "barkept")) == "0\ndefault";
  // 0 opens the palette: each item with its line; those on the bar say their key there
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "0"); f = gs_frame(s, 0.016, true);
  #assert s[0].pal[0].open && tr_find(tr, "pal") > 0 && tr_text_of(tr, tr_find(tr, "pal.pn.2")) == "sphere" && tr_text_of(tr, tr_find(tr, "pal.pk.0")) == "1" && tr_find(tr, "pal.pk.2") < 0 && tr_text_of(tr, tr_find(tr, "pal.pt.9")) == "reset world: the things back as this world began";
  // the sphere, used from it: picked at once, the bar as it was, the palette shut
  gs_event(s, GS_CLICK, gs_test_slot(s, "pal.pn.2"), 0); f = gs_frame(s, 0.016, true);
  #assert k[0].tool == BL_T_BALL && !s[0].pal[0].open && tr_find(tr, "pal") < 0 && tr_text_of(tr, tr_find(tr, "hot.l.1")) == "edit";
  // Escape shuts it too; fly from it is one more press told to the HUD
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "esc"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "0"); #assert s[0].pal[0].open;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "esc"); #assert !s[0].pal[0].open;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "0"); f = gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "pal.p.8"), 0); #assert s[0].fly == 1 && !s[0].pal[0].open;
  // a drag: the sphere added at place 1 (the bar the person's now, and kept); shapes moved to place 3; place 0 taken off
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "drag"), "add 2 1"); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "hot.l.1")) == "sphere" && tr_text_of(tr, tr_find(tr, "hot.l.8")) == "more" && tr_text_of(tr, tr_find(tr, "barkept")) == "0\nshapes,sphere,edit,decide,camera,world,undo,redo";
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "drag"), "move 0 3"); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "barkept")) == "0\nsphere,edit,decide,shapes,camera,world,undo,redo";
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "drag"), "off 0"); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "barkept")) == "0\nedit,decide,shapes,camera,world,undo,redo" && tr_text_of(tr, tr_find(tr, "hot.l.0")) == "edit";
  // (keys follow places: 1 is edit now)
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "1"); #assert k[0].editing; gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "esc");
  // a drag that says nothing the bar has changes nothing
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "drag"), "off 9"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "drag"), "add 99 0"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "drag"), "jump 0 1"); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "barkept")) == "0\nedit,decide,shapes,camera,world,undo,redo";
  // a bar this browser kept: what the catalogue has not is dropped; one with nothing it knows is no bar
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "bar"), "0 world,bogus,edit"); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "barkept")) == "0\nworld,edit" && tr_text_of(tr, tr_find(tr, "hot.l.2")) == "more" && tr_find(tr, "hot.s.3") < 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "bar"), "0\nnothing,here"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "bar"), "x"); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "barkept")) == "0\nworld,edit";
  // reset hotbar, from the palette: the type's own again, and nothing kept
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "0"); f = gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "pal.p.12"), 0); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "barkept")) == "0\ndefault" && tr_text_of(tr, tr_find(tr, "hot.l.0")) == "shapes" && tr_text_of(tr, tr_find(tr, "hot.l.7")) == "more";
  // the palette's keys: the arrows move its focus, a number puts the focused item at that place, Enter uses it
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "0"); f = gs_frame(s, 0.016, true); at := s[0].pal[0].at;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "right"); #assert s[0].pal[0].at != at && s[0].pal[0].open;
  item := s[0].pal[0].at;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "2"); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "hot.l.1")) == s[0].cat[0].items[item].label && tr_text_of(tr, tr_find(tr, "barkept")) != "0\ndefault";
}
#test "racing is built in too: its card, the build tools and its back on the track (R) on its hotbar, no camera menu, the chat told its game type and how building goes, and a plan's edits made" #steps 400000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  #assert s[0].picking && gs_has(gs_test_pool(s), "racing") && gs_has(gs_test_pool(s), "three laps against the clock. no cutting.") && gs_has(gs_test_pool(s), "/img/kind-racing.jpg");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  #assert c[0].kind == GS_RACING && gs_has(gs_test_pool(s), "gs v2 g7") && k[0].n == GT_CIRCUIT && k[0].tool == BL_T_NONE;
  #assert gs_test_slot(s, "hot.s.9") >= 0 && gs_test_slot(s, "hot.s.10") < 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.0")) == "shapes" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.1")) == "boost" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.2")) == "cone" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.6")) == "reset" && gs_has(gs_test_pool(s), "back on the track (R)");
  // the cone item, then a plain shape from the shapes slot: the kind forgotten
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.2"), 0); f = gs_frame(s, 0.016, true); #assert k[0].tool == BL_T_BLOCK && k[0].brush == BL_R_CONE;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 30.00 2.00 0.40 0.40 0.60 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1 && k[0].b[GT_CIRCUIT].role == BL_R_CONE;
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.0"), 0); f = gs_frame(s, 0.016, true); #assert k[0].tool == BL_T_BLOCK && k[0].brush == BL_R_NONE;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 32.00 2.00 1.00 1.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 2 && k[0].b[GT_CIRCUIT + 1].role == BL_R_NONE;
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.0"), 0); f = gs_frame(s, 0.016, true);
  gs_things_anew(s, c[0].kind); f = gs_frame(s, 0.016, true); #assert k[0].n == GT_CIRCUIT;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); f = gs_frame(s, 0.016, true); #assert s[0].act == 1;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "note"), "a racing circuit at the end of the day.");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "build a ramp"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  #assert gs_wants(s) && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "game type: racing (a circuit driven in a car)\\nbuilding here: the person's place is the car's.") && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "\\na racing circuit at the end of the day.\\n");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\ndone.\\n+ place 0 3 1 1 1\"}}]}");
  #assert k[0].n == GT_CIRCUIT + 1;
}
#test "drift is built in too: its card, the build tools and its back at the last ring (R) on its hotbar, no camera menu; 'put a block in front of me' (a recorded conversation) is held in open space, under the floor too; a limit said with its numbers" #steps 400000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  #assert s[0].picking && gs_has(gs_test_pool(s), "drift") && gs_has(gs_test_pool(s), "fly the rings in order. zero g.") && gs_has(gs_test_pool(s), "/img/kind-drift.jpg");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.8"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  #assert c[0].kind == GS_DRIFT && gs_has(gs_test_pool(s), "gs v2 g8") && k[0].n == GT_RINGS && k[0].b[0].role == BL_R_RING && k[0].tool == BL_T_NONE && k[0].far == 70000 && k[0].high == 10000 && k[0].low == -10000 && k[0].roles == BL_DR_ROLES;
  #assert gs_test_slot(s, "hot.s.7") >= 0 && gs_test_slot(s, "hot.s.8") < 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.0")) == "shapes" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.1")) == "edit" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.l.4")) == "reset" && gs_has(gs_test_pool(s), "back at the last ring (R)");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); f = gs_frame(s, 0.016, true); #assert s[0].act == 1;
  // the HUD says where the ship is: 20 m along the course (page z -20), 35 m under where the floor was
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "where"), "0 -2000 0 -100 0 -3500");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "note"), "drift: a small ship among the rocks. ring 2 of 12.");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "put a block in front of me"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  body := cast(string) s[0].req_body[0..<gs_body_len(s)];
  #assert gs_wants(s) && gs_has(body, "game type: drift (a small ship flown through rings in open space)\\nbuilding here: the person's place is the ship's, flying in open space") && gs_has(body, "bottoms go from -100 to 100 m") && gs_has(body, "person: at x 0 z -20, feet at height -35, facing x 0 z -1");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\na block ahead.\\n+ place 0 -26 2 2 2 -36 rest\"}}]}");
  #assert k[0].n == GT_RINGS + 1 && k[0].b[GT_RINGS].y == -3600 && k[0].b[GT_RINGS].z == -2600 && k[0].b[GT_RINGS].rest && c[0].refused_n == 0;
  // too deep: refused, and said with its numbers
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "and one far below"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\nbelow.\\n+ place 0 -26 2 2 2 -150 rest\"}}]}");
  #assert k[0].n == GT_RINGS + 1 && gs_has(cast(string) c[0].refused[0..<c[0].refused_n], "out of reach: a thing's bottom is from -100 to 100 m up.");
}
#test "the world shows frames a second in its corner: counted over half a second, not on the picker or the home page" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..]; gs_test_say(s, GS_ADDRESS, 0, "/"); gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}"); gs_test_frames(s);
  #assert s[0].view == GS_WORLD_VIEW && s[0].picking && gs_test_slot(s, "fps") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s);
  for k: 0..<60 { n := gs_frame(s, 1.0f32 / 60, true); }
  tr := s[0].tree[..];
  #assert gs_test_slot(s, "fps") >= 0 && s[0].fps == 60 && tr_text_of(tr, tr_find(tr, "fps")) == "60";
  for k: 0..<40 { n := gs_frame(s, 1.0f32 / 30, true); }
  #assert s[0].fps == 30 && tr_text_of(tr, tr_find(tr, "fps")) == "30";
}
#test "the world filling up is said in words: nearly full as it gets there, full when the next thing is refused, and the settings' count is bright" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true}");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s); a := gs_frame(s, 0.016, true);
  k := s[0].chat[0].blocks[..]; tr := s[0].tree[..];
  // filled to one short of nine tenths: nothing is said yet; the next thing says the world is nearly full, once
  while k[0].n < 898 { ok := bl_edit(k, "place 3 3 1 1 1 0 rest"); }
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 5 5 1 1 1 0 rest"); b := gs_frame(s, 0.016, true);
  #assert k[0].n == 899 && tr_find(tr, "limit") < 0 && !bl_nearly(k);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 6 5 1 1 1 0 rest"); c := gs_frame(s, 0.016, true);
  #assert k[0].n == 900 && bl_nearly(k) && tr_text_of(tr, tr_find(tr, "limit")) == "nearly full: things: 900 of 1000.";
  s[0].limit_n = 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 7 5 1 1 1 0 rest"); d := gs_frame(s, 0.016, true);
  #assert k[0].n == 901 && tr_find(tr, "limit") < 0;
  // full: the next is refused, and the page says how many there are of how many; the settings' count is bright from nearly full on
  while k[0].n < 1000 { ok := bl_edit(k, "place 3 3 1 1 1 0 rest"); }
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 8 5 1 1 1 0 rest"); e := gs_frame(s, 0.016, true);
  #assert k[0].n == 1000 && !bl_nearly(k) && tr_text_of(tr, tr_find(tr, "limit")) == "world is full: 1000 of 1000 things. delete some to place more.";
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "limit full"); #assert gs_has(cast(string) s[0].limit[0..<s[0].limit_n], "world is full: 1000 of 1000");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "5"); f := gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "world.n")) == "things: 1000 of 1000" && tr_class(tr, tr_find(tr, "world.n")) == "fact near" && gs_has(tr_attr_of(tr, tr_find(tr, "hot.s.0"), AT_TITLE), "things: 1000 of 1000 (1)");
  // a twin of the selected thing is refused in the same words
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "esc"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "2"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "select b1"); g := gs_frame(s, 0.016, true);
  s[0].limit_n = 0; gs_event(s, GS_CLICK, gs_test_slot(s, "sel.dup"), 0); h := gs_frame(s, 0.016, true);
  #assert k[0].n == 1000 && gs_has(tr_text_of(tr, tr_find(tr, "limit")), "world is full: 1000 of 1000 things.");
  // logging out leaves no words behind
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); m := gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "out"), 0);
  gs_test_answer(s, 200, "{}"); #assert s[0].limit_n == 0;
}
#test "/login/cli: the login, then a press makes the command line's code, copy puts it on the clipboard once, and leaving forgets it" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/login/cli");
  #assert s[0].view == GS_CLI_VIEW && gs_wants(s) && gs_test_door(s) == "/api/auth/account" && gs_go(s) == 0;
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  // nobody here: the login as at /login, saying why, and the page stays at /login/cli
  pool := cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n];
  #assert s[0].view == GS_CLI_VIEW && gs_test_slot(s, "email") >= 0 && gs_has(pool, "gs v1") && gs_has(pool, "command line") && gs_test_slot(s, "cli.make") < 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "ada@example.com");
  gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "482913");
  gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  #assert gs_test_door(s) == "/api/auth/email/verify";
  gs_test_answer(s, 200, "{\"state\":\"logged-in\"}");
  // logged in, it stays (not the world): nothing is made before the press
  #assert s[0].view == GS_CLI_VIEW && s[0].login[0].step == LG_IN && gs_go(s) == 0 && !gs_wants(s) && gs_test_slot(s, "cli.make") >= 0 && gs_test_slot(s, "cli.copy") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "cli.make"), 0);
  #assert gs_wants(s) && gs_test_door(s) == "/api/auth/cli/code";
  gs_test_answer(s, 200, "{\"state\":\"code\",\"code\":\"0123456789abcdef0123456789abcdef\",\"expires_in\":300}");
  pool = cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n];
  #assert gs_has(pool, "0123456789abcdef0123456789abcdef") && gs_test_slot(s, "cli.copy") >= 0 && gs_clip_len(s) == 0;
  // copy: the code for the clipboard, once; the button says it was copied
  gs_event(s, GS_CLICK, gs_test_slot(s, "cli.copy"), 0);
  gs_test_frames(s);
  #assert gs_clip_len(s) == 32 && cast(string) s[0].clip[0..<32] == "0123456789abcdef0123456789abcdef" && s[0].login[0].copied;
  #assert gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "copied");
  gs_clip_done(s);
  #assert gs_clip_len(s) == 0 && s[0].clip[0] == 0;
  // back: the world, and the code is forgotten; /login/cli again shows none until a press
  gs_event(s, GS_CLICK, gs_test_slot(s, "home"), 0);
  gs_test_frames(s);
  #assert s[0].view == GS_WORLD_VIEW && s[0].login[0].cli_code_n == 0 && !s[0].login[0].cli;
  gs_test_say(s, GS_ADDRESS, 0, "/login/cli");
  gs_test_frames(s);
  #assert s[0].view == GS_CLI_VIEW && s[0].login[0].cli && s[0].login[0].cli_code_n == 0 && gs_test_slot(s, "cli.copy") < 0;
  // /login and /login/clix are the login, not this
  u: [1] GsTest; v := u[0].s[..];
  gs_test_say(v, GS_ADDRESS, 0, "/login/clix");
  #assert v[0].view == GS_LOGIN_VIEW && !v[0].login[0].cli;
  // a copy press on another page puts nothing on the clipboard
  gs_test_answer(v, 200, "{\"logged_in\":false}");
  #assert gs_clip_len(v) == 0;
}

// ---------------------------------------------------------------- no WebGPU, and a kept world come back (issue 14)
#test "a browser that cannot run the builder is told so in words, each way WebGPU can be missing: by the home page's way in, before the login, and where the world would be; nothing is said when it is fine" #steps 4000000000 {
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  // fine, or nothing known yet: the home page says nothing of it; the glue's field is there to be told
  #assert s[0].view == GS_HOME_VIEW && s[0].gpu == GW_FINE && gs_test_slot(s, "gpu") >= 0 && gs_test_slot(s, "hero.nogpu") < 0 && !gs_has(gs_test_pool(s), GW_HEAD);
  // each way, as the glue says it: the home page says what is wrong and what to do, by its way in
  for way: GW_NONE..<GW_WAYS {
    digit := [1] u8.[cast(u8) ('0' + way)];
    gs_test_say(s, GS_INPUT, gs_test_slot(s, "gpu"), cast(string) digit[..]); p := gs_frame(s, 0.016, true);
    pool := gs_test_pool(s);
    #assert s[0].gpu == way && gs_test_slot(s, "hero.nogpu") >= 0 && gs_has(pool, GW_HEAD) && gs_has(pool, gw_words(way)) && gs_has(pool, gw_do(way)) && gs_has(pool, "nogpu");
    for other: GW_NONE..<GW_WAYS { if other != way { #assert !gs_has(pool, gw_words(other)); } }
  }
  // the login leads to the builder: the words stand before it too (the login itself still works)
  gs_event(s, GS_CLICK, gs_test_slot(s, "nav.login"), 0); gs_test_frames(s); p1 := gs_frame(s, 0.016, true);
  #assert s[0].view == GS_LOGIN_VIEW && gs_test_slot(s, "nogpu") >= 0 && gs_test_slot(s, "email") >= 0 && gs_has(gs_test_pool(s), gw_words(GW_FAILED));
  // a word that is no way, or the browser found fine after all: nothing is said
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "gpu"), "0"); p2 := gs_frame(s, 0.016, true);
  #assert s[0].gpu == GW_FINE && gs_test_slot(s, "nogpu") < 0 && !gs_has(gs_test_pool(s), GW_HEAD);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "gpu"), "9"); #assert s[0].gpu == GW_FINE;
  // the command line's login needs no WebGPU: nothing is said there
  c: [1] GsTest; q := c[0].s[..];
  gs_test_say(q, GS_ADDRESS, 0, "/login/cli"); gs_test_answer(q, 200, "{\"logged_in\":false}");
  q0 := gs_frame(q, 0.016, true);
  gs_test_say(q, GS_INPUT, gs_test_slot(q, "gpu"), "1"); p3 := gs_frame(q, 0.016, true);
  #assert q[0].view == GS_CLI_VIEW && q[0].gpu == GW_NONE && gs_test_slot(q, "nogpu") < 0;
}
#test "logged in with no WebGPU, the builder's place says so in words and is never blank: no picker, no chat, no world to wait for; at /play too" #steps 4000000000 {
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/play"); p0 := gs_frame(s, 0.016, true);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "gpu"), "2");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  p := gs_frame(s, 0.016, true); pool := gs_test_pool(s);
  #assert s[0].view == GS_WORLD_VIEW && gs_test_slot(s, "nogpu") >= 0 && gs_test_slot(s, "kind.0") < 0 && gs_test_slot(s, "say") < 0;
  #assert gs_has(pool, GW_HEAD) && gs_has(pool, gw_words(GW_ADAPTER)) && gs_has(pool, gw_do(GW_ADAPTER)) && gs_has(pool, "no adapter");
  // you are still you: the menu and the way out are there
  #assert gs_test_slot(s, "me") >= 0;
  // nobody at /play, no WebGPU: a guest's builder (issue 13) says it where the world would be, with no picker
  n: [1] GsTest; q := n[0].s[..];
  gs_test_say(q, GS_ADDRESS, 0, "/play"); q0 := gs_frame(q, 0.016, true);
  gs_test_say(q, GS_INPUT, gs_test_slot(q, "gpu"), "1");
  gs_test_answer(q, 200, "{\"logged_in\":false}"); p2 := gs_frame(q, 0.016, true);
  gs_test_frames(q); p2b := gs_frame(q, 0.016, true);
  #assert q[0].view == GS_WORLD_VIEW && gs_test_slot(q, "nogpu") >= 0 && gs_test_slot(q, "kind.0") < 0 && gs_has(gs_test_pool(q), gw_words(GW_NONE)) && gs_has(gs_test_pool(q), gw_do(GW_NONE));
  // WebGPU found after all (the glue's word 0): the picker
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "gpu"), "0"); p3 := gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "nogpu") < 0 && gs_test_slot(s, "kind.0") >= 0;
}
#test "the settled start's seam: a kept world come back says so in the page's class (the glue tells the HUD: no entrance); a type picked in the picker is a new world again" #steps 4000000000 {
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.2"), 0); gs_test_frames(s); p := gs_frame(s, 0.016, true);
  // a type picked: a new world, its entrance plays (no word in the class)
  #assert !s[0].still && gs_has(gs_test_pool(s), "gs v2 g2") && !gs_has(gs_test_pool(s), "still");
  // a restore says the world is a kept one: the class says "still" beside the type
  gs_still(s, true); #assert s[0].dirty; p1 := gs_frame(s, 0.016, true);
  #assert s[0].still && gs_has(gs_test_pool(s), "gs v2 g2 still");
  gs_still(s, true); #assert gs_frame(s, 0.016, true) == 0;   // (said again: nothing changes)
  // back to the picker and a type picked there: a new world, with its entrance
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); p2 := gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "type"), 0); gs_test_frames(s); p3 := gs_frame(s, 0.016, true);
  #assert s[0].picking && gs_has(gs_test_pool(s), "gs v2 pick") && !gs_has(gs_test_pool(s), "g2 still");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.6"), 0); gs_test_frames(s); p4 := gs_frame(s, 0.016, true);
  #assert !s[0].still && gs_has(gs_test_pool(s), "gs v2 g6") && !gs_has(gs_test_pool(s), "still");
  for k: 0..<GS_KINDS { a := GS_KIND_CLASS; b := GS_KIND_STILL; #assert b[k].count == a[k].count + 6 && cast(string) b[k][0..<a[k].count] == a[k]; }
}

// ---------------------------------------------------------------- a guest, and what this browser keeps (issue 13)

// The page opened at the builder's address by nobody, the login's answer in, and a browser that keeps nothing yet.
gs_test_guest :: (s: [] Site) { gs_test_say(s, GS_ADDRESS, 0, GS_BUILDER); gs_test_answer(s, 200, "{\"logged_in\":false}"); }
// Frames with no storage service (time passes; what the page asks of storage waits to be taken).
gs_test_wait :: (s: [] Site, frames: int) { for q: 0..<frames { m := gs_frame(s, 0.016, true); } }
// The storage requests waiting, each taken and answered done; the level written among them is copied to `level`. Its length (0: none was written).
gs_test_puts :: (s: [] Site, level: [] u8) -> int {
  n := 0;
  for q: 0..<16 {
    op := gs_keep_next(s); if op == 0 { break; }
    slot := gs_keep_slot(s);
    if op == KP_PUT && slot == KP_LEVEL_PUT { n = gs_keep_len(s); for i: 0..<n { level[i] = s[0].keep[0].doc[i]; } }
    gs_test_stored(s, slot, ifx op == KP_GET then KP_MISSING else KP_OK, "");
  }
  return n;
}
gs_test_limit :: (s: [] Site) -> string { return cast(string) s[0].limit[0..<s[0].limit_n]; }

GsTwo :: struct { a: [1] Site; b: [1] Site; level: [LV_DOC] u8; game: [LV_GAME] u8; }
#test "no account: the builder opens on the ring, racing is picked and built with every tool, and after a reload the circuit is as it was left, in the same type; undo takes the last thing back" #steps 2000000000 {
  t: [1] GsTwo; s := t[0].a[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_guest(s);
  // the picker, with nobody logged in: no login, no email, the address stays the builder's
  #assert s[0].view == GS_WORLD_VIEW && s[0].picking && s[0].login[0].step == LG_ASK_EMAIL && gs_go(s) == 0 && gs_test_slot(s, "kind.7") >= 0 && gs_test_slot(s, "email") < 0 && gs_has(gs_test_pool(s), GS_HEAD_HERE) && gs_has(gs_test_pool(s), "gs v2 pick ring");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  // racing, with every build tool on its bar and in more, and undo and redo at the bar's end
  tr := s[0].tree[..];
  #assert !s[0].picking && c[0].kind == GS_RACING && s[0].game && gs_has(gs_test_pool(s), "gs v2 g7") && !gs_has(gs_test_pool(s), "g7 still") && k[0].n == GT_CIRCUIT;
  #assert tr_text_of(tr, tr_find(tr, "hot.l.0")) == "shapes" && tr_text_of(tr, tr_find(tr, "hot.l.1")) == "boost" && tr_text_of(tr, tr_find(tr, "hot.l.2")) == "cone" && tr_text_of(tr, tr_find(tr, "hot.l.3")) == "edit" && tr_text_of(tr, tr_find(tr, "hot.l.7")) == "undo" && tr_text_of(tr, tr_find(tr, "hot.l.8")) == "redo";
  #assert tr_text_of(tr, tr_find(tr, "kept")) == "kept in this browser";
  // a boost and two cones, as the HUD's tools place them
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.1"), 0); f = gs_frame(s, 0.016, true); #assert k[0].brush == BL_R_BOOST;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 10.00 20.00 4.00 4.00 0.25 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1 && k[0].b[GT_CIRCUIT].role == BL_R_BOOST;
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.2"), 0); f = gs_frame(s, 0.016, true);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 30.00 2.00 0.40 0.40 0.60 0.00 rest");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 32.00 4.00 0.40 0.40 0.60 0.00 rest");
  #assert k[0].n == GT_CIRCUIT + 3 && k[0].b[GT_CIRCUIT + 2].role == BL_R_CONE;
  // within a second it is written to this browser, as the app's level file under the type's own key
  gs_test_wait(s, 60);
  ln := gs_test_puts(s, t[0].level[..]);
  #assert ln > 0 && gs_has(cast(string) t[0].level[0..<ln], "world.doc.v1") && gs_has(cast(string) t[0].level[0..<ln], "|boost|400|25|400\n") && gs_has(cast(string) t[0].level[0..<ln], "|cone|40|60|40\n");
  gn := lv_game_write(GS_RACING, t[0].game[..]);

  // the reload: another page, the same browser. Until its storage answers, neither the picker nor a world
  r := t[0].b[..]; rk := r[0].chat[0].blocks[..];
  gs_test_say(r, GS_ADDRESS, 0, GS_BUILDER); f = gs_frame(r, 0.016, true);
  #assert r[0].view == GS_WORLD_VIEW && r[0].picking && gs_test_slot(r, "kind.0") < 0 && gs_test_slot(r, "say.in") < 0;
  #assert gs_keep_next(r) == KP_GET && gs_keep_slot(r) == KP_GAME_GET && cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)] == "game" && cast(string) r[0].ns[0..<gs_keep_ns_len()] == "gamebuilder.game" && gs_keep_version() == 1;
  gs_test_stored(r, KP_GAME_GET, KP_OK, cast(string) t[0].game[0..<gn]);
  #assert r[0].boot == GS_B_LEVEL && r[0].picking;
  #assert gs_keep_next(r) == KP_GET && gs_keep_slot(r) == KP_LEVEL_GET && cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)] == "level-8";
  #assert gs_keep_next(r) == KP_GET && gs_keep_slot(r) == KP_SET_GET && cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)] == "settings-8";
  // (and the account's record, asked for with the game: a guest's says only what was built, and nobody is asked about an account)
  #assert gs_keep_next(r) == KP_GET && gs_keep_slot(r) == KP_LINK_GET && cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)] == "account" && gs_keep_next(r) == 0;
  gs_test_stored(r, KP_LINK_GET, KP_OK, "gamebuilder.web-account.v1 -\n7 0 0 0 0 1 -\n");
  #assert r[0].acct[0].loaded && r[0].acct[0].link[GS_RACING].built && !r[0].acct[0].legacy;
  gs_test_stored(r, KP_SET_GET, KP_MISSING, "");
  gs_test_stored(r, KP_LEVEL_GET, KP_OK, cast(string) t[0].level[0..<ln]);
  f = gs_frame(r, 0.016, true);
  // the circuit as it was left, in racing, where the person was: no picker; the class says it was read back (for the HUD)
  #assert !r[0].picking && r[0].game && r[0].chat[0].kind == GS_RACING && r[0].last == GS_RACING && rk[0].n == GT_CIRCUIT + 3 && rk[0].b[GT_CIRCUIT].role == BL_R_BOOST && rk[0].b[GT_CIRCUIT].x == 1000 && rk[0].b[GT_CIRCUIT].z == 2000 && rk[0].b[GT_CIRCUIT + 1].role == BL_R_CONE && rk[0].b[GT_CIRCUIT + 2].role == BL_R_CONE && rk[0].b[GT_CIRCUIT + 2].x == 3200;
  #assert gs_has(gs_test_pool(r), "gs v2 g7 still") && gs_test_slot(r, "kind.0") < 0 && gs_test_slot(r, "hot.s.1") >= 0;
  gs_test_answer(r, 200, "{\"logged_in\":false}");
  #assert r[0].view == GS_WORLD_VIEW && !r[0].picking && gs_test_slot(r, "say.in") >= 0 && gs_go(r) == 0;
  // a reload starts with no history: undo says so, in words with its number
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "hotkey"), "undo");
  #assert rk[0].n == GT_CIRCUIT + 3 && gs_test_limit(r) == "nothing to undo: undo goes back 100 steps, from when this page opened.";
  // one more cone; undo (the key) takes it back, redo (the key) makes it again, and the bar's undo takes it back once more
  gs_event(r, GS_CLICK, gs_test_slot(r, "hot.s.2"), 0); f = gs_frame(r, 0.016, true);
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "place 34.00 6.00 0.40 0.40 0.60 0.00 rest"); #assert rk[0].n == GT_CIRCUIT + 4;
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "hotkey"), "undo"); #assert rk[0].n == GT_CIRCUIT + 3 && rk[0].b[GT_CIRCUIT + 2].x == 3200;
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "hotkey"), "redo"); #assert rk[0].n == GT_CIRCUIT + 4 && rk[0].b[GT_CIRCUIT + 3].x == 3400 && rk[0].b[GT_CIRCUIT + 3].role == BL_R_CONE;
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "hotkey"), "redo"); #assert rk[0].n == GT_CIRCUIT + 4 && gs_test_limit(r) == "nothing to redo.";
  f = gs_frame(r, 0.016, true);
  gs_event(r, GS_CLICK, gs_test_slot(r, "hot.s.7"), 0); #assert rk[0].n == GT_CIRCUIT + 3;
  gs_event(r, GS_CLICK, gs_test_slot(r, "hot.s.8"), 0); #assert rk[0].n == GT_CIRCUIT + 4;
  // the picker is one press away ("game type" in the menu), and the type left is lit there
  gs_event(r, GS_CLICK, gs_test_slot(r, "me"), 0); f = gs_frame(r, 0.016, true);
  #assert gs_test_slot(r, "type") >= 0 && gs_test_slot(r, "in") >= 0 && gs_test_slot(r, "out") < 0 && gs_test_slot(r, "nav.credits") >= 0;
  gs_event(r, GS_CLICK, gs_test_slot(r, "type"), 0); gs_test_frames(r); f = gs_frame(r, 0.016, true);
  #assert r[0].picking && gs_test_slot(r, "kind.7") >= 0 && gs_has(gs_test_pool(r), "kind r7 on");
}

#test "undo and redo: a step an edit, whoever made it. A tool's edit, a setting, the reset of the world, and an answer's plan lines as one; the wheel's notches on a thing are one step" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  hk := gs_test_slot(s, "hotkey"); ed := gs_test_slot(s, "edit");
  gs_test_say(s, GS_INPUT, ed, "place 10.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1;
  // an answer with two plan lines: one step
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "two blocks"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "build/block");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: build/block\\ntwo.\\n+ place 0 3 1 1 1\\n+ place 4 3 1 1 1\"}}]}");
  #assert k[0].n == GT_CIRCUIT + 3;
  gs_test_say(s, GS_INPUT, hk, "undo"); #assert k[0].n == GT_CIRCUIT + 1;
  gs_test_say(s, GS_INPUT, hk, "redo"); #assert k[0].n == GT_CIRCUIT + 3;
  // a setting is a step: gravity by a plan line of the settings' own
  g0 := pr_value(k[0].props[..], TW_GRAVITY);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "low gravity"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); gs_test_route(s, "world/tune");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"route: world/tune\\nlighter.\\n+ set world.gravity 0.3\"}}]}");
  #assert pr_value(k[0].props[..], TW_GRAVITY) != g0;
  gs_test_say(s, GS_INPUT, hk, "undo"); #assert pr_value(k[0].props[..], TW_GRAVITY) == g0 && k[0].n == GT_CIRCUIT + 3;
  gs_test_say(s, GS_INPUT, hk, "redo"); #assert pr_value(k[0].props[..], TW_GRAVITY) != g0;
  // the wheel sizing a thing: its notches within a moment are one step
  id := k[0].b[GT_CIRCUIT].id; w0 := k[0].b[GT_CIRCUIT].w;
  line: [64] u8; ln := bl_put(line[..], 0, "size b"); ln = bl_int(line[..], ln, id); ln = bl_put(line[..], ln, " 2.20 2.20 1.00"); gs_test_say(s, GS_INPUT, ed, cast(string) line[0..<ln]);
  ln = bl_put(line[..], 0, "size b"); ln = bl_int(line[..], ln, id); ln = bl_put(line[..], ln, " 2.40 2.40 1.00"); gs_test_say(s, GS_INPUT, ed, cast(string) line[0..<ln]);
  #assert k[0].b[GT_CIRCUIT].w == 240;
  gs_test_say(s, GS_INPUT, hk, "undo"); #assert k[0].b[GT_CIRCUIT].w == w0;
  // reset world is a step too: the things come back
  gs_test_say(s, GS_INPUT, hk, "0"); f = gs_frame(s, 0.016, true);
  gs_cat(s, c[0].kind, s[0].cat[..]); pid: [24] u8; pn := bl_put(pid[..], 0, "pal.p."); pn = bl_int(pid[..], pn, hb_item_find(s[0].cat[..], "clear"));
  gs_event(s, GS_CLICK, gs_test_slot(s, cast(string) pid[0..<pn]), 0); #assert k[0].n == GT_CIRCUIT;
  gs_test_say(s, GS_INPUT, hk, "undo"); #assert k[0].n == GT_CIRCUIT + 3;
  // a new edit after an undo: there is nothing to make again
  gs_test_say(s, GS_INPUT, hk, "undo");
  gs_test_say(s, GS_INPUT, ed, "place 20.00 20.00 2.00 2.00 1.00 0.00 rest");
  gs_test_say(s, GS_INPUT, hk, "redo"); #assert gs_test_limit(s) == "nothing to redo.";
  // picking a tool, opening a panel, a key that edits nothing: no step
  before := s[0].undo[0].at;
  gs_test_say(s, GS_INPUT, hk, "1"); gs_test_say(s, GS_INPUT, hk, "esc"); gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0);
  #assert s[0].undo[0].at == before;
}

#test "a guest: the chat's box says to log in or create an account, with one button; nothing a guest does asks the chat's door; log in opens over the world, which stays as built, and logging out keeps it" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_guest(s);
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0);
  #assert gs_go(s) == GS_BUILDER.count && cast(string) s[0].go[0..<GS_BUILDER.count] == GS_BUILDER;   // (a guest's world keeps its address, /play: the link is not followed)
  gs_test_frames(s); f := gs_frame(s, 0.016, true);
  tr := s[0].tree[..];
  #assert c[0].guest && !c[0].asking && gs_test_slot(s, "say") < 0 && tr_text_of(tr, tr_find(tr, "say.w")) == "log in or create an account to talk to the agent." && tr_text_of(tr, tr_find(tr, "say.in")) == "log in" && gs_test_slot(s, "me") >= 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 10.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1;
  // decide (the agent's button), by its slot and by its key: said in words, and no request is made, to the chat's door or any other
  #assert tr_text_of(tr, tr_find(tr, "hot.l.4")) == "decide";
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.4"), 0);
  #assert !gs_wants(s) && !c[0].busy && c[0].n == 0 && gs_test_limit(s) == "log in or create an account to talk to the agent." && s[0].flight == GS_NOBODY;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "5"); #assert !gs_wants(s) && !c[0].busy;
  // (and a message forced past the page: it goes nowhere)
  ch_test_type(c, "add a cube"); #assert !ch_send(c) && !gs_wants(s) && !ch_wants(c) && !ch_job_wants(c) && c[0].n == 0;
  f = gs_frame(s, 0.016, true);
  // log in, the chat's button: the login over the world, which is still the world (its class, its things, its hotbar)
  gs_event(s, GS_CLICK, gs_test_slot(s, "say.in"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert s[0].sheet && s[0].view == GS_WORLD_VIEW && gs_go(s) == 0 && gs_has(gs_test_pool(s), "gs v2 g7") && gs_test_slot(s, "email") >= 0 && gs_test_slot(s, "hot.s.0") >= 0 && gs_test_slot(s, "sheet.x") >= 0 && k[0].n == GT_CIRCUIT + 1;
  // "keep building" shuts it; the menu's log in opens it again
  gs_event(s, GS_CLICK, gs_test_slot(s, "sheet.x"), 0); f = gs_frame(s, 0.016, true); #assert !s[0].sheet && gs_test_slot(s, "email") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); f = gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "in"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert s[0].sheet && !s[0].menu;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "ada@example.com"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  #assert gs_wants(s) && gs_test_door(s) == "/api/auth/email/start";
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  #assert s[0].sheet && gs_test_slot(s, "code") >= 0 && s[0].view == GS_WORLD_VIEW;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "123456"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  gs_test_answer(s, 200, "{\"state\":\"logged-in\",\"account\":\"acct_1\"}");
  // logged in: the same world, no picker, the sheet gone, the chat's box a box, and the address the home page's
  f = gs_frame(s, 0.016, true);
  #assert !s[0].sheet && s[0].view == GS_WORLD_VIEW && !s[0].picking && c[0].kind == GS_RACING && k[0].n == GT_CIRCUIT + 1 && gs_go(s) == 1 && s[0].go[0] == '/' && !c[0].guest && gs_test_slot(s, "say") >= 0 && gs_test_slot(s, "say.in") < 0 && gs_test_slot(s, "email") < 0;
  // and now a message goes
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "hello"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0); #assert gs_wants(s) && gs_test_door(s) == "/api/chat/complete/v1";
  gs_test_route(s, "chat"); gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hi.\"}}]}");
  // logging out: the home page; the conversation is gone, the game is not, and the builder's address is it again
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); f = gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "out"), 0);
  gs_test_answer(s, 200, "{\"state\":\"logged-out\"}");
  #assert s[0].view == GS_HOME_VIEW && c[0].n == 0 && k[0].n == GT_CIRCUIT + 1 && c[0].kind == GS_RACING && s[0].game;
  gs_test_say(s, GS_ADDRESS, 0, GS_BUILDER); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert s[0].view == GS_WORLD_VIEW && !s[0].picking && k[0].n == GT_CIRCUIT + 1 && gs_test_slot(s, "say.in") >= 0;
  // a guest's credits and back: the world they came from; the name takes a guest to the home page
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); f = gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "nav.credits"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert s[0].view == GS_CREDITS_VIEW && gs_has(gs_test_pool(s), "back to the world");
  gs_event(s, GS_CLICK, gs_test_slot(s, "home"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert s[0].view == GS_WORLD_VIEW && !s[0].picking && gs_go(s) == 5 && cast(string) s[0].go[0..<5] == "/play";
  gs_event(s, GS_CLICK, gs_test_slot(s, "brand"), 0); #assert s[0].view == GS_HOME_VIEW && gs_go(s) == 1;
}

#test "a browser that keeps nothing still builds, and says the game will not be kept; storage full is said in words with the game's size; each type keeps its own level" #steps 2000000000 {
  // storage refused as it is asked: the picker comes up, the world is built, the corner says it is not kept, and nothing more is asked of storage
  t: [1] GsTwo; s := t[0].a[..]; k := s[0].chat[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, GS_BUILDER); f := gs_frame(s, 0.016, true);
  #assert gs_keep_next(s) == KP_GET; gs_keep_refused(s, KP_UNAVAILABLE);
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  #assert s[0].picking && s[0].boot == GS_B_DONE && gs_test_slot(s, "kind.7") >= 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); f = gs_frame(s, 0.016, true);
  #assert !s[0].picking && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "kept")) == "not kept: this browser's storage is off" && gs_has(tr_class(s[0].tree[..], tr_find(s[0].tree[..], "kept")), "no");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 10.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1;
  gs_test_wait(s, 100); #assert gs_keep_next(s) == 0 && k[0].n == GT_CIRCUIT + 1;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "undo"); #assert k[0].n == GT_CIRCUIT;   // (undo needs no storage)

  // a browser that never answers: the page stops waiting after two seconds, and the picker shows
  r := t[0].b[..]; rk := r[0].chat[0].blocks[..];
  gs_test_say(r, GS_ADDRESS, 0, GS_BUILDER); gs_test_wait(r, 100);
  #assert r[0].boot == GS_B_ASK && gs_test_slot(r, "kind.0") < 0;
  gs_test_wait(r, 40); f = gs_frame(r, 0.016, true);
  #assert r[0].boot == GS_B_DONE && gs_test_slot(r, "kind.0") >= 0;
  // its answer comes after all (nothing kept): it keeps from here on
  #assert gs_keep_next(r) == KP_GET; gs_test_stored(r, KP_GAME_GET, KP_MISSING, "");
  gs_test_answer(r, 200, "{\"logged_in\":false}");
  gs_event(r, GS_CLICK, gs_test_slot(r, "kind.7"), 0); gs_test_frames(r); f = gs_frame(r, 0.016, true);
  #assert tr_text_of(r[0].tree[..], tr_find(r[0].tree[..], "kept")) == "kept in this browser";
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "place 10.00 20.00 2.00 2.00 1.00 0.00 rest");
  gs_test_wait(r, 60);
  // the level's write finds no room: said over the hotbar with the game's size, the corner says it too, and the world is still up
  wrote := false;
  for q: 0..<8 { op := gs_keep_next(r); if op == 0 { break; } slot := gs_keep_slot(r); if slot == KP_LEVEL_PUT { wrote = true; } gs_test_stored(r, slot, ifx slot == KP_LEVEL_PUT then KP_QUOTA else KP_OK, ""); }
  f = gs_frame(r, 0.016, true);
  #assert wrote && rk[0].n == GT_CIRCUIT + 1 && gs_test_limit(r) == "this browser's storage is full: your game (3 kb) is not kept. free some space and it will be." && tr_text_of(r[0].tree[..], tr_find(r[0].tree[..], "limit")) == gs_test_limit(r);
  #assert tr_text_of(r[0].tree[..], tr_find(r[0].tree[..], "kept")) == "not kept: this browser's storage is full";
  // the next change is tried again, and kept: the corner says so
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "place 14.00 20.00 2.00 2.00 1.00 0.00 rest");
  gs_test_wait(r, 60); ln := gs_test_puts(r, t[0].level[..]); f = gs_frame(r, 0.016, true);
  #assert ln > 0 && tr_text_of(r[0].tree[..], tr_find(r[0].tree[..], "kept")) == "kept in this browser";
  // another type picked: racing's level is written first if it changed, and crates' own is asked for; with one kept, it is the room
  gs_event(r, GS_CLICK, gs_test_slot(r, "me"), 0); f = gs_frame(r, 0.016, true); gs_event(r, GS_CLICK, gs_test_slot(r, "type"), 0); f = gs_frame(r, 0.016, true);
  gs_event(r, GS_CLICK, gs_test_slot(r, "kind.5"), 0);
  #assert !r[0].picking && r[0].chat[0].kind == GS_CRATES && rk[0].n == 9;
  asked := 0; put := 0;
  for q: 0..<8 { op := gs_keep_next(r); if op == 0 { break; } slot := gs_keep_slot(r); key := cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)];
    if slot == KP_LEVEL_GET && key == "level-6" { asked += 1; } if slot == KP_GAME_PUT && lv_game_read(r[0].keep[0].st[..], cast(string) r[0].keep[0].game[0..<gs_keep_len(r)]) == GS_CRATES { put += 1; }
    if op == KP_PUT { gs_test_stored(r, slot, KP_OK, ""); } }
  #assert asked == 1 && put == 1;
  // (a level kept for crates: a wall, written as the app writes one)
  u := t[0].a[..]; bl_bare(u[0].chat[0].blocks[..], GT_CRATES); bl_roles(u[0].chat[0].blocks[..], gt_roles(GT_CRATES));
  #assert bl_plan(u[0].chat[0].blocks[..], "place 2 2 1 1 3 wall");
  wn := lv_write(u[0].chat[0].blocks[..], u[0].keep[0].st[..], GS_CRATES + 1, t[0].level[..]);
  gs_test_stored(r, KP_SET_GET, KP_MISSING, ""); gs_test_stored(r, KP_LEVEL_GET, KP_OK, cast(string) t[0].level[0..<wn]);
  f = gs_frame(r, 0.016, true);
  #assert rk[0].n == 1 && rk[0].b[0].role == BL_R_WALL && r[0].chat[0].kind == GS_CRATES && gs_has(gs_test_pool(r), "gs v2 g5 still");
  // crates' game is three levels, a room each. The room cleared and left (the HUD's "room next"): the next level is
  // the world, its own record asked for (level-10), and with none kept it is the room a new game has there; the HUD is
  // told which room of how many
  #assert r[0].room == 0 && tr_text_of(r[0].tree[..], tr_find(r[0].tree[..], "room")) == "0 3 1";
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "room next"); f = gs_frame(r, 0.016, true);
  second: [GT_STARTER_MAX] GtThing;
  #assert r[0].room == 1 && gs_slot(r) == GT_WEB_TYPES && rk[0].n == gt_starter_level(GT_CRATES, 1, second[..]) && rk[0].n == 12 && tr_text_of(r[0].tree[..], tr_find(r[0].tree[..], "room")) == "1 3 1";
  asked = 0;
  for q: 0..<8 { op := gs_keep_next(r); if op == 0 { break; } slot := gs_keep_slot(r); key := cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)];
    if (slot == KP_LEVEL_GET && key == "level-10") || (slot == KP_SET_GET && key == "settings-10") { asked += 1; }
    gs_test_stored(r, slot, ifx op == KP_GET then KP_MISSING else KP_OK, ""); }
  #assert asked == 2 && rk[0].n == 12;
  // what is built in the second room is kept as its own level, and the game kept is still crates
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "place 1.00 1.00 1.00 1.00 1.00 0.00 rest"); #assert rk[0].n == 13;
  gs_test_wait(r, 60); wrote = false;
  for q: 0..<8 { op := gs_keep_next(r); if op == 0 { break; } slot := gs_keep_slot(r); key := cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)];
    if op == KP_PUT && slot == KP_LEVEL_PUT && key == "level-10" { wrote = true; }
    gs_test_stored(r, slot, ifx op == KP_GET then KP_MISSING else KP_OK, ""); }
  #assert wrote && r[0].keep[0].kept == GS_CRATES;
  // on through the third room and back to the first, whose kept level (the one wall) is read again
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "room next"); #assert r[0].room == 2 && rk[0].n == 17 && gs_slot(r) == GT_WEB_TYPES + 1;
  for q: 0..<8 { op := gs_keep_next(r); if op == 0 { break; } gs_test_stored(r, gs_keep_slot(r), ifx op == KP_GET then KP_MISSING else KP_OK, ""); }
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "room next"); #assert r[0].room == 0 && rk[0].n == 9 && gs_slot(r) == GS_CRATES;
  for q: 0..<8 { op := gs_keep_next(r); if op == 0 { break; } slot := gs_keep_slot(r);
    if op == KP_GET && slot == KP_LEVEL_GET { #assert cast(string) r[0].keep[0].key[0..<gs_keep_key_len(r)] == "level-6"; gs_test_stored(r, slot, KP_OK, cast(string) t[0].level[0..<wn]); }
    else { gs_test_stored(r, slot, ifx op == KP_GET then KP_MISSING else KP_OK, ""); } }
  f = gs_frame(r, 0.016, true);
  #assert rk[0].n == 1 && rk[0].b[0].role == BL_R_WALL && tr_text_of(r[0].tree[..], tr_find(r[0].tree[..], "room")) == "0 3 2";
  // another type has one level: the HUD is told of no rooms there, and "room next" is nothing
  gs_event(r, GS_CLICK, gs_test_slot(r, "me"), 0); f = gs_frame(r, 0.016, true); gs_event(r, GS_CLICK, gs_test_slot(r, "type"), 0); f = gs_frame(r, 0.016, true);
  gs_event(r, GS_CLICK, gs_test_slot(r, "kind.7"), 0); f = gs_frame(r, 0.016, true);
  was_n := rk[0].n;
  gs_test_say(r, GS_INPUT, gs_test_slot(r, "edit"), "room next");
  #assert r[0].room == 0 && rk[0].n == was_n && tr_find(r[0].tree[..], "room") < 0;
}

// The glue's answer to the counting's note: the browser's clock (count.coax).
gs_test_clock :: (s: [] Site, text: string) { gs_test_say(s, GS_INPUT, gs_test_slot(s, "count"), text); }
// A count the face takes to send: it goes to the list's door, and this is its body.
gs_test_count :: (s: [] Site) -> string {
  #assert gs_wants(s) && s[0].flight == GS_COUNT_ASKS && gs_test_door(s) == LP_DOOR;
  gs_sent(s);
  return cast(string) s[0].req_body[0..<s[0].req_body_n];
}
#test "the loop is counted as a visit goes through it: each step once, under the list's names, held while the first load runs, behind the login's and the chat's requests, and a count that fails changes nothing" #steps 4000000000 {
  t: [1] GsTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  // the home page asks the glue for the clock (the note's third number), and counts nothing until it answers
  #assert gs_has(gs_test_pool(s), "0 -1 3 0\n/api/count\n") && !gs_wants(s) && gs_test_slot(s, "count") >= 0;
  gs_test_clock(s, "900 900 148 0 0 -1 0 0"); gs_test_frames(s);
  // arrived, the builder (the home page's ring is its picker) and the first paint's time: held (the first load's requests are its own), and shown for the browser to take if the page is left
  #assert !gs_wants(s) && s[0].flight == GS_NOBODY;
  #assert gs_has(gs_test_pool(s), "4101 900 3 5000\n/api/count\n{\"schema\":\"gamebuilder.count.v1\",\"counts\":[{\"name\":\"arrived\",\"ms\":-1},{\"name\":\"builder\",\"ms\":900},{\"name\":\"button_ms\",\"ms\":148}]}");
  // racing's portal, 2 s in: the hold is over; the type pressed on the home page is "create", and its world up is the pick
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  #assert s[0].view == GS_WORLD_VIEW && !s[0].picking && c[0].kind == GS_RACING && !gs_wants(s);
  gs_test_clock(s, "2000 2000 148 0 0 0 0 0");
  #assert gs_test_count(s) == "{\"schema\":\"gamebuilder.count.v1\",\"counts\":[{\"name\":\"arrived\",\"ms\":-1},{\"name\":\"builder\",\"ms\":900},{\"name\":\"button_ms\",\"ms\":148},{\"name\":\"create\",\"ms\":1100},{\"name\":\"picked\",\"ms\":0}]}";
  // the count fails: the page is as it was, and nothing is sent again
  gs_event(s, GS_END, 500, 0); gs_test_frames(s);
  #assert s[0].flight == GS_NOBODY && s[0].view == GS_WORLD_VIEW && !s[0].picking && !gs_wants(s) && s[0].limit_n == 0;
  // a thing placed
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 10.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1;   // (the circuit is the level's already)
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 14.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 2;   // (the second is not a first)
  gs_test_clock(s, "9000 9000 148 0 0 0 0 0");
  #assert gs_test_count(s) == "{\"schema\":\"gamebuilder.count.v1\",\"counts\":[{\"name\":\"placed\",\"ms\":7000}]}";
  // with that count still with the host, the guest opens the login and sends an email: the login's request takes the wire
  gs_event(s, GS_CLICK, gs_test_slot(s, "say.in"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  gs_test_clock(s, "12000 12000 148 0 0 0 0 0");
  #assert s[0].sheet && s[0].flight == GS_COUNT_ASKS && !gs_wants(s);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "ada@example.com"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  #assert gs_wants(s) && s[0].flight == GS_LOGIN_ASKS && gs_test_door(s) == "/api/auth/email/start";
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  #assert gs_test_slot(s, "code") >= 0;
  // then the account prompt's own count goes
  #assert gs_test_count(s) == "{\"schema\":\"gamebuilder.count.v1\",\"counts\":[{\"name\":\"prompt\",\"ms\":3000}]}";
  gs_event(s, GS_END, 0, 0);
  // the code taken: an account
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "123456"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  gs_test_answer(s, 200, "{\"state\":\"logged-in\",\"account\":\"acct_1\"}");
  f = gs_frame(s, 0.016, true);
  gs_test_clock(s, "20000 20000 148 0 0 0 0 0");
  // (and the game built as a guest is kept on the account at once, by an account that agrees: its step is counted with it; issue 16)
  gs_test_acct(s);
  #assert gs_test_count(s) == "{\"schema\":\"gamebuilder.count.v1\",\"counts\":[{\"name\":\"account\",\"ms\":8000},{\"name\":\"kept\",\"ms\":0}]}";
  gs_event(s, GS_END, 200, 0); gs_test_frames(s);
  // a message to the agent: the chat's own request goes first, and the message is counted
  #assert !c[0].guest && gs_test_slot(s, "say") >= 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "say"), "add a cube"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "say"), 0);
  gs_test_clock(s, "21000 21000 148 0 0 0 0 0");
  #assert gs_wants(s) && s[0].flight == GS_CHAT_ASKS && gs_test_door(s) != LP_DOOR;
  #assert s[0].count[0].qn == 1 && s[0].count[0].q[0].row == LP_MESSAGE && s[0].count[0].q[0].ms == 1000;
  // every step the page has today was counted once; the ones that are issue 17's wait for their call
  m := s[0].count[0].mask;
  for row: [9] int.[LP_ARRIVED, LP_CREATE, LP_BUILDER, LP_PICKED, LP_PLACED, LP_PROMPT, LP_ACCOUNT, LP_MESSAGE, LP_BUTTON_MS] { #assert (m & ct_bit(row)) != 0; }
  for row: [4] int.[LP_PUBLISHED, LP_SHARED, LP_REMIX, LP_NOGPU] { #assert (m & ct_bit(row)) == 0; }
  // the seam issue 17 calls: one line where the step happens
  gs_count(s, LP_PUBLISHED); gs_count(s, LP_PUBLISHED); gs_test_clock(s, "30000 30000 148 0 0 0 0 0");
  #assert s[0].count[0].qn == 2 && s[0].count[0].q[1].row == LP_PUBLISHED && s[0].count[0].q[1].ms == 9000;
}
#test "nothing is counted for a program's browser or off the site; a browser with no WebGPU is counted as one; a page loaded at the builder's address counts its own time to the builder" #steps 4000000000 {
  // a player test, a load check, a dev server: the glue says so, and no count is ever wanted
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  gs_test_clock(s, "900 900 148 2 0 -1 0 0"); gs_test_frames(s);
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0); gs_test_frames(s);
  gs_test_clock(s, "9000 9000 148 2 0 0 0 0"); gs_test_frames(s);
  #assert s[0].count[0].off && !gs_wants(s) && s[0].flight == GS_NOBODY && s[0].view == GS_WORLD_VIEW;
  // the builder's address, reached by the home page's button before its code had loaded; no WebGPU here
  u: [1] GsTest; v := u[0].s[..];
  gs_test_guest(v);
  gs_test_clock(v, "1400 1400 200 1 0 -1 0 0"); gs_test_frames(v);
  #assert !gs_wants(v);
  gs_test_clock(v, "5200 5200 200 1 0 0 0 0");
  #assert gs_test_count(v) == "{\"schema\":\"gamebuilder.count.v1\",\"counts\":[{\"name\":\"arrived\",\"ms\":-1},{\"name\":\"create\",\"ms\":-1},{\"name\":\"builder\",\"ms\":1400},{\"name\":\"builder_ms\",\"ms\":1400}]}";
  gs_event(v, GS_END, 200, 0);
  gs_test_say(v, GS_INPUT, gs_test_slot(v, "gpu"), "1"); gs_test_frames(v);
  gs_test_clock(v, "6000 6000 200 1 0 0 0 0");
  #assert gs_test_count(v) == "{\"schema\":\"gamebuilder.count.v1\",\"counts\":[{\"name\":\"nogpu\",\"ms\":0}]}";
  // the page left with a count held: the browser took it (the glue says), and the page sends nothing
  w: [1] GsTest; x := w[0].s[..];
  gs_test_say(x, GS_ADDRESS, 0, "/");
  gs_test_answer(x, 200, "{\"logged_in\":false}");
  gs_test_clock(x, "900 900 148 0 0 -1 0 0"); gs_test_frames(x);
  #assert x[0].count[0].qn == 3;   // (arrived, the first paint's time, and the builder: the home page's ring is the builder's picker)
  gs_test_clock(x, "left"); gs_test_clock(x, "6000 6000 148 0 0 0 0 0"); gs_test_frames(x);
  #assert x[0].count[0].qn == 0 && !gs_wants(x);
}

// ---------------------------------------------------------------- the account (web/account.coax; issue 16)

GsAcctTest :: struct { s: [1] Site; file: [8192] u8; reply: [16384] u8; }
gs_test_kept :: (s: [] Site) -> string { tr := s[0].tree[..]; return tr_text_of(tr, tr_find(tr, "kept")); }
gs_test_who :: (s: [] Site) { #assert gs_wants(s) && gs_test_door(s) == "/api/auth/account" && gs_body_len(s) == 0; gs_test_answer(s, 200, "{\"logged_in\":true,\"account\":\"acct_1\",\"kind\":\"person\"}"); }

#test "an account without leaving the game: a guest builds, logs in from the sheet with a new email, and the game is kept on the account as a new game of its type, through the rows every surface uses; the world never changes, and it is said in words" #steps 4000000000 {
  t: [1] GsAcctTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..]; a := s[0].acct[..];
  s[0].byhand = true;
  gs_test_guest(s);
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); gs_test_frames(s); f := gs_frame(s, 0.016, true);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 10.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1;   // (the circuit is the level's already)
  // a guest: built, and nothing is asked of any account; the corner says where the game is kept
  gs_test_frames(s); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert a[0].link[GS_RACING].built && !gs_wants(s) && s[0].flight == GS_NOBODY && gs_test_kept(s) == "kept in this browser";
  // the sheet over the game: it says it is the way to an account too, and that the game stays
  gs_event(s, GS_CLICK, gs_test_slot(s, "say.in"), 0); f = gs_frame(s, 0.016, true);
  tr := s[0].tree[..];
  #assert s[0].sheet && tr_text_of(tr, tr_find(tr, "login.h")) == "log in or create an account." && tr_text_of(tr, tr_find(tr, "login.l")) == "your game stays as it is, and is kept on your account. a new email makes a new account. we email you a code.";
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "new@example.com"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "123456"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  #assert gs_wants(s) && gs_test_door(s) == "/api/auth/email/verify";
  gs_sent(s); gs_test_say(s, GS_PIECE, 200, "{\"state\":\"logged-in\",\"account\":\"acct_1\",\"new\":true,\"player\":null}"); gs_event(s, GS_END, 200, 0);
  // logged in, the account made: at once who is logged in is asked (the login service's own answer), then the account's levels
  #assert s[0].login[0].made && !s[0].sheet && k[0].n == GT_CIRCUIT + 1;
  gs_test_who(s);
  #assert gs_test_door(s) == "/api/rows/list-levels"; gs_test_answer(s, 200, "{\"ok\":true,\"levels\":[]}");
  // a game of the type, made with a key that this browser's record holds first
  gs_test_frames(s);
  #assert gs_wants(s) && gs_test_door(s) == "/api/rows/new-game" && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "{\"template\":\"racing\",\"key\":\"web-");
  #assert gs_has(cast(string) s[0].keep[0].link[0..<s[0].keep[0].link_n], "gamebuilder.web-account.v1 acct_1\n7 0 0 0 0 1 web-");
  f = gs_frame(s, 0.016, true); #assert gs_test_kept(s) == "saving to your account";
  gs_test_answer(s, 200, "{\"ok\":true,\"game\":1,\"level\":1,\"template\":\"racing\"}");
  #assert gs_test_door(s) == "/api/rows/list-levels"; gs_test_answer(s, 200, "{\"ok\":true,\"levels\":[{\"level\":1,\"title\":\"Level 1\",\"game\":1,\"revision\":40}]}");
  // its file: the app's level file, the same bytes this browser keeps but for the level's number
  body := cast(string) s[0].req_body[0..<gs_body_len(s)];
  #assert gs_test_door(s) == "/api/rows/write-content" && gs_has(body, "{\"level\":1,\"revision\":40,\"content\":\"world.doc.v1 level-1\\n") && gs_has(body, "aethyr.content.v1 level ") && gs_has(body, "table shape id kind:text sx:cm sy:cm sz:cm");
  gs_test_answer(s, 200, "{\"ok\":true,\"level\":1,\"revision\":41}");
  f = gs_frame(s, 0.016, true);
  #assert k[0].n == GT_CIRCUIT + 1 && c[0].kind == GS_RACING && gs_test_kept(s) == "kept on your account" && tr_class(s[0].tree[..], tr_find(s[0].tree[..], "kept")) == "kept mono";
  #assert gs_test_limit(s) == "your game is kept on your account now: it opens in the app, and in any browser you log in on.";
  gs_test_frames(s);
  #assert gs_has(cast(string) s[0].keep[0].link[0..<s[0].keep[0].link_n], "gamebuilder.web-account.v1 acct_1\n7 1 1 41 ") && !gs_wants(s);
  // built on: saved four seconds later, from the revision agreed on; a save with no answer changes nothing here, is said, and is tried again
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 30.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 2;
  gs_test_wait(s, 200); #assert !gs_wants(s);
  gs_test_wait(s, 80); gs_test_keep(s);
  gs_test_who(s);
  gs_test_answer(s, 200, "{\"ok\":true,\"levels\":[{\"level\":1,\"game\":1,\"revision\":41}]}");
  #assert gs_test_door(s) == "/api/rows/write-content" && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "{\"level\":1,\"revision\":41,");
  gs_test_answer(s, 0, "");
  f = gs_frame(s, 0.016, true);
  #assert k[0].n == GT_CIRCUIT + 2 && gs_test_kept(s) == "not on your account yet" && tr_class(s[0].tree[..], tr_find(s[0].tree[..], "kept")) == "kept mono no";
  #assert gs_test_limit(s) == "not kept on your account yet: can't reach the server. it is kept in this browser, and tried again.";
  #assert s[0].keep[0].state == KP_ON && s[0].keep[0].doc_n > 0 && s[0].keep[0].put_level == GS_RACING + 1;   // (this browser's copy: written as ever)
  for q: 0..<6 { gs_test_frames(s); }
  gs_test_who(s);
  gs_test_answer(s, 200, "{\"ok\":true,\"levels\":[{\"level\":1,\"game\":1,\"revision\":41}]}");
  gs_test_answer(s, 200, "{\"ok\":true,\"level\":1,\"revision\":42}");
  f = gs_frame(s, 0.016, true); #assert gs_test_kept(s) == "kept on your account" && a[0].link[GS_RACING].rev == 42;
  // logged out: nothing more is asked of the account, and the game is in this browser
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); f = gs_frame(s, 0.016, true); gs_event(s, GS_CLICK, gs_test_slot(s, "out"), 0);
  gs_test_answer(s, 200, "{\"state\":\"logged-out\"}");
  gs_test_say(s, GS_ADDRESS, 0, GS_BUILDER); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  #assert k[0].n == GT_CIRCUIT + 2 && !gs_wants(s) && gs_test_kept(s) == "kept in this browser";
}

#test "a returning person on another browser: the picker lists the games on their account, one picked opens here as its type, and one the app plays says so; a game this page can't hold whole stays in this browser, said with the number" #steps 4000000000 {
  t: [1] GsAcctTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..]; a := s[0].acct[..];
  u: [1] GsAcctTest; v := u[0].s[..];
  s[0].byhand = true;
  // the account's racing game, as another browser left it: its circuit and two things
  gs_test_guest(v); gs_event(v, GS_CLICK, gs_test_slot(v, "kind.7"), 0); gs_test_frames(v);
  gs_test_say(v, GS_INPUT, gs_test_slot(v, "edit"), "place 10.00 20.00 2.00 2.00 1.00 0.00 rest"); gs_test_say(v, GS_INPUT, gs_test_slot(v, "edit"), "place 30.00 20.00 2.00 2.00 1.00 0.00 rest");
  fn := lv_write(v[0].chat[0].blocks[..], v[0].keep[0].st[..], 5, t[0].file[..]);
  o: [1] Jo; jo_start(o[..], t[0].reply[..]); jo_obj(o[..]); jo_key(o[..], "ok"); jo_bool(o[..], true); jo_key(o[..], "level"); jo_int(o[..], 5); jo_key(o[..], "revision"); jo_int(o[..], 77);
  jo_key(o[..], "content"); jo_str(o[..], cast(string) t[0].file[0..<fn]); jo_end(o[..]);
  #assert fn > 0 && !o[0].bad;
  // this browser: logged in, nothing kept here: the ring, with "your games" a button by your icon
  gs_test_say(s, GS_ADDRESS, 0, "/"); gs_test_answer(s, 200, "{\"logged_in\":true,\"account\":\"acct_1\",\"primary\":\"ada@example.com\"}");
  gs_test_frames(s); f := gs_frame(s, 0.016, true);
  #assert s[0].picking && gs_test_slot(s, "kind.7") >= 0 && gs_test_slot(s, "mine.b") >= 0 && tr_find(s[0].tree[..], "mine.e") < 0;
  // "your games", by your icon: it opens them over the ring
  gs_event(s, GS_CLICK, gs_test_slot(s, "mine.b"), 0); f = gs_frame(s, 0.016, true);
  #assert tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "mine.e")) == "your games";
  gs_test_who(s);
  #assert gs_test_door(s) == "/api/rows/list-games";
  gs_test_answer(s, 200, "{\"ok\":true,\"games\":[{\"game\":1,\"title\":\"Game 1\",\"template\":\"arena\",\"levels\":[1]},{\"game\":2,\"title\":\"Game 2\",\"template\":\"racing\",\"levels\":[5]}]}");
  f = gs_frame(s, 0.016, true); tr := s[0].tree[..];
  #assert tr_text_of(tr, tr_find(tr, "game.x.0")) == "Game 1 · in the app" && gs_test_slot(s, "game.0") < 0 && tr_text_of(tr, tr_find(tr, "game.1")) == "Game 2 · racing";
  // picked: racing is entered, and the account's copy is read and is the world
  gs_event(s, GS_CLICK, gs_test_slot(s, "game.1"), 0); gs_test_frames(s);
  #assert !s[0].picking && c[0].kind == GS_RACING && k[0].n == GT_CIRCUIT;   // (a new racing game: its circuit)
  gs_test_who(s);
  gs_test_answer(s, 200, "{\"ok\":true,\"levels\":[{\"level\":1,\"game\":1,\"revision\":3},{\"level\":5,\"game\":2,\"revision\":77}]}");
  #assert gs_test_door(s) == "/api/rows/read-content" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"level\":5}";
  gs_test_answer(s, 200, cast(string) t[0].reply[0..<o[0].n]);
  f = gs_frame(s, 0.016, true);
  #assert k[0].n == GT_CIRCUIT + 2 && k[0].b[GT_CIRCUIT + 1].x == 3000 && a[0].link[GS_RACING].game == 2 && a[0].link[GS_RACING].level == 5 && a[0].link[GS_RACING].rev == 77 && s[0].still && !un_can_undo(s[0].undo[..]);
  #assert gs_test_limit(s) == "opened from your account." && gs_test_kept(s) == "kept on your account";
  // and it is kept in this browser too, as its type's level
  gs_test_frames(s); #assert s[0].keep[0].put_level == GS_RACING + 1 && s[0].keep[0].doc_n > 0;
  // built past what the account holds: 513 things. It is not sent, and the page says so with the number
  line: [64] u8;
  for i: 0..<GT_LEVEL_THINGS - 1 - GT_CIRCUIT { n := bl_put(line[..], 0, "place "); n = bl_int(line[..], n, 50 + (i % 24) * 4); n = bl_put(line[..], n, ".00 "); n = bl_int(line[..], n, 40 + (i / 24) * 4); n = bl_put(line[..], n, ".00 2.00 2.00 1.00 0.00 rest"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), cast(string) line[0..<n]); }
  #assert k[0].n == GT_LEVEL_THINGS + 1;
  for q: 0..<3 { gs_test_frames(s); }
  gs_test_who(s);
  gs_test_answer(s, 200, "{\"ok\":true,\"levels\":[{\"level\":5,\"game\":2,\"revision\":77}]}");
  f = gs_frame(s, 0.016, true);
  #assert !gs_wants(s) && gs_test_kept(s) == "kept in this browser only" && gs_test_limit(s) == "kept in this browser only: a game on your account holds 512 things at most, and this one has 513. delete some and it is kept there too.";
}

gs_test_counted :: (s: [] Site, row: int) -> bool { return ((s[0].count[0].mask | s[0].count[0].want) & ct_bit(row)) != 0; }
gs_test_text :: (s: [] Site, id: string) -> string { tr := s[0].tree[..]; return tr_text_of(tr, tr_find(tr, id)); }
GS_TEST_LINK :: "https://gamebuilder.org/g/abc234";

#test "publish without leaving the game: a guest presses publish and gets the account sheet over the game; logged in, the publish sheet opens, the game is kept on the account and published through the publish row, and the link is shown, copied and taken down again; the world never changes" #steps 4000000000 {
  t: [1] GsAcctTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..]; p := s[0].pub[..];
  gs_test_guest(s);
  // (no publish while a type is still being picked)
  f := gs_frame(s, 0.016, true); #assert gs_test_slot(s, "pub") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0); gs_test_frames(s); f = gs_frame(s, 0.016, true);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 10.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 1;
  gs_test_frames(s); f = gs_frame(s, 0.016, true);
  // the button is in the top bar, drawn by the page like the rest of it
  tr := s[0].tree[..];
  #assert gs_test_text(s, "pub") == "publish" && tr[0].nodes[tr_find(tr, "pub")].tag == TG_BUTTON && !gs_wants(s);
  // a guest: the account sheet, over the game, which stays as it is; nothing is asked of any server yet
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub"), 0); f = gs_frame(s, 0.016, true);
  #assert s[0].sheet && p[0].after && !p[0].open && gs_test_text(s, "login.h") == "log in or create an account." && k[0].n == GT_CIRCUIT + 1 && c[0].kind == GS_RACING && !pb_busy(p);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "new@example.com"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "123456"); gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  #assert gs_test_door(s) == "/api/auth/email/verify";
  gs_test_answer(s, 200, "{\"state\":\"logged-in\",\"account\":\"acct_1\",\"new\":true,\"player\":null}");
  // in: the publish goes on where it was, with nothing lost. The sheet is open, and asks who is here, then what the account has published
  #assert p[0].open && !p[0].after && !s[0].sheet && k[0].n == GT_CIRCUIT + 1 && s[0].flight == GS_PUBLISH_ASKS && gs_test_door(s) == "/api/auth/account" && gs_body_len(s) == 0;
  gs_test_answer(s, 200, "{\"logged_in\":true,\"account\":\"acct_1\",\"kind\":\"person\"}");
  #assert gs_test_door(s) == "/api/rows/published";
  gs_test_answer(s, 200, "{\"ok\":true,\"published\":[],\"where\":\"on the web\"}");
  f = gs_frame(s, 0.016, true); tr = s[0].tree[..];
  #assert gs_test_text(s, "pub.h") == "put it on the web." && tr_attr_of(tr, tr_find(tr, "pub.name"), AT_VALUE) == "my racing game" && gs_test_text(s, "pub.go") == "publish" && gs_test_slot(s, "pub.link") < 0;
  // the limits, in words with their numbers, and who sees what
  #assert gs_has(gs_test_text(s, "pub.fine"), "512 things") && gs_has(gs_test_text(s, "pub.fine"), "256 kb") && gs_has(gs_test_text(s, "pub.fine"), "16 games") && gs_has(gs_test_text(s, "pub.l"), "no account") && gs_has(gs_test_text(s, "pub.l"), "not shown");
  // named and published: who is here, then the same row every surface uses, with the account's own level
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "pub.name"), "Moss Run");
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub.go"), 0);
  #assert gs_test_door(s) == "/api/auth/account";
  gs_test_answer(s, 200, "{\"logged_in\":true,\"account\":\"acct_1\",\"kind\":\"person\"}");
  gs_test_frames(s);
  #assert s[0].flight == GS_PUBLISH_ASKS && gs_test_door(s) == "/api/rows/publish" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"level\":1,\"name\":\"Moss Run\"}" && !gs_test_counted(s, LP_PUBLISHED);
  gs_test_answer(s, 200, "{\"ok\":true,\"published\":2,\"version\":1,\"link\":\"https://gamebuilder.org/g/abc234\",\"where\":\"on the web\"}");
  f = gs_frame(s, 0.016, true); tr = s[0].tree[..];
  #assert gs_test_counted(s, LP_PUBLISHED) && gs_test_text(s, "pub.h") == "it's on the web." && gs_test_text(s, "pub.link") == GS_TEST_LINK && gs_has(tr_class(tr, tr_find(tr, "pub.link")), "gs-link") && gs_test_text(s, "pub.go") == "publish this version";
  #assert gs_has(tr_class(tr, tr_find(tr, "pub.share")), "gs-share") && tr_attr_of(tr, tr_find(tr, "pub.open"), AT_HREF) == GS_TEST_LINK && gs_test_text(s, "pub.v.0") == "version 1: live" && gs_test_slot(s, "pub.v.1") < 0 && gs_has(gs_test_text(s, "pub.said"), "anyone with the link");
  // the link, onto the clipboard, and the button says so
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub.copy"), 0); f = gs_frame(s, 0.016, true);
  #assert gs_clip_len(s) == GS_TEST_LINK.count && cast(string) s[0].clip[0..<s[0].clip_n] == GS_TEST_LINK && gs_test_text(s, "pub.copy") == "copied";
  gs_clip_done(s);
  // taken down: the same sheet, the unpublish row, and how it stands read back
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub.down"), 0);
  gs_test_answer(s, 200, "{\"logged_in\":true,\"account\":\"acct_1\",\"kind\":\"person\"}");
  #assert gs_test_door(s) == "/api/rows/unpublish" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"published\":2}";
  gs_test_answer(s, 200, "{\"ok\":true,\"published\":2}");
  #assert gs_test_door(s) == "/api/rows/published";
  gs_test_answer(s, 200, "{\"ok\":true,\"published\":[{\"published\":2,\"level\":1,\"name\":\"Moss Run\",\"link\":\"https://gamebuilder.org/g/abc234\",\"live\":1,\"versions\":2,\"on_web\":false}]}");
  f = gs_frame(s, 0.016, true);
  #assert gs_test_text(s, "pub.h") == "it's off the web." && gs_test_slot(s, "pub.link") < 0 && gs_test_slot(s, "pub.down") < 0 && gs_test_text(s, "pub.go") == "publish again" && gs_test_text(s, "pub.v.0") == "version 2: make live" && gs_test_text(s, "pub.v.1") == "version 1: the one it plays";
  // an older version made the one the link plays: the set-live row
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub.v.0"), 0);
  gs_test_answer(s, 200, "{\"logged_in\":true,\"account\":\"acct_1\",\"kind\":\"person\"}");
  #assert gs_test_door(s) == "/api/rows/set-live" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"published\":2,\"version\":2}";
  gs_test_answer(s, 200, "{\"ok\":true,\"published\":2,\"live\":2}");
  gs_test_answer(s, 200, "{\"ok\":true,\"published\":[{\"published\":2,\"level\":1,\"name\":\"Moss Run\",\"link\":\"https://gamebuilder.org/g/abc234\",\"live\":2,\"versions\":2,\"on_web\":true}]}");
  f = gs_frame(s, 0.016, true);
  #assert gs_test_text(s, "pub.h") == "it's on the web." && gs_test_text(s, "pub.v.0") == "version 2: live";
  // a refusal is the server's own words; the sheet shuts and the game is as it was all along
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub.go"), 0);
  gs_test_answer(s, 200, "{\"logged_in\":true,\"account\":\"acct_1\",\"kind\":\"person\"}");
  gs_test_frames(s);
  gs_test_answer(s, 429, "{\"ok\":false,\"error\":\"limit\",\"why\":\"30 publishes an hour (PUB_PER_HOUR): try again later\"}");
  f = gs_frame(s, 0.016, true);
  #assert gs_test_text(s, "pub.said") == "not published: 30 publishes an hour (PUB_PER_HOUR): try again later." && tr_class(s[0].tree[..], tr_find(s[0].tree[..], "pub.said")) == "said";
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub.x"), 0); f = gs_frame(s, 0.016, true);
  #assert !p[0].open && gs_test_slot(s, "pub.box") < 0 && k[0].n == GT_CIRCUIT + 1 && c[0].kind == GS_RACING && gs_test_slot(s, "hot.s.0") >= 0;
  // a guest who shuts the account sheet is asked nothing more
  s[0].login[0].step = LG_ASK_EMAIL;
  gs_event(s, GS_CLICK, gs_test_slot(s, "pub"), 0); #assert s[0].sheet && p[0].after;
  f = gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "sheet.x"), 0); f = gs_frame(s, 0.016, true);
  #assert !s[0].sheet && !p[0].after && !p[0].open;
}

GsPlayTest :: struct { s: [1] Site; b: [1] Blocks; st: [1] LvStore; file: [8192] u8; reply: [16384] u8; level: [8192] u8; }
// A published racing game's answer, as the hosted server gives it: a level with one thing placed, named `name`.
gs_test_play_answer :: (t: [] GsPlayTest, name: string) -> string {
  ty := gt_web_type(GS_RACING); b := t[0].b[..];
  bl_new(b, ty); bl_bounds(b, GT_FAR[ty], GT_HIGH[ty]); bl_low(b, GT_LOW[ty]); bl_roles(b, gt_roles(ty));
  #assert bl_edit(b, "place 10.00 20.00 2.00 2.00 1.00 0.00 rest");
  n := lv_write(b, t[0].st[..], 3, t[0].file[..]);
  #assert n > 0;
  o: [1] Jo; jo_start(o[..], t[0].reply[..]); jo_obj(o[..]);
  jo_key(o[..], "ok"); jo_bool(o[..], true); jo_key(o[..], "schema"); jo_str(o[..], "gamebuilder.play.v1"); jo_key(o[..], "code"); jo_str(o[..], "abc234");
  jo_key(o[..], "name"); jo_str(o[..], name); jo_key(o[..], "template"); jo_str(o[..], GT_ID[ty]); jo_key(o[..], "version"); jo_int(o[..], 2);
  jo_key(o[..], "content"); jo_str(o[..], cast(string) t[0].file[0..<n]); jo_end(o[..]);
  #assert !o[0].bad;
  return jo_text(o[..]);
}

#test "a published game's link plays it with no login and no build tools: the game is asked for by its code, comes up as its own type, and the page shows its name, remix, the way to the builder and report; nothing of it is kept or sent to an account" #steps 4000000000 {
  t: [1] GsPlayTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..]; p := s[0].pub[..];
  gs_test_say(s, GS_ADDRESS, 0, "/g/abc234");
  #assert s[0].playing && s[0].view == GS_WORLD_VIEW && !s[0].picking && p[0].play == PL_ASK && gs_test_counted(s, LP_SHARED);
  // who is here is asked as on every address; nobody is, and nothing more is asked of them: the game is asked for with no login
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  #assert s[0].flight == GS_PUBLISH_ASKS && gs_test_door(s) == "/api/play/abc234" && gs_body_len(s) == 0 && s[0].playing && s[0].view == GS_WORLD_VIEW;
  f := gs_frame(s, 0.016, true);
  #assert gs_test_text(s, "play.h") == "one moment." && gs_has(gs_test_pool(s), "gs v2 pick") && gs_test_slot(s, "hot.s.0") < 0;
  answer := gs_test_play_answer(t[..], "Moss Run");
  gs_test_answer(s, 200, answer);
  f = gs_frame(s, 0.016, true); tr := s[0].tree[..];
  // it is up: its type's world, its things, its name
  #assert p[0].play == PL_UP && c[0].kind == GS_RACING && k[0].n == GT_CIRCUIT + 1 && gs_has(gs_test_pool(s), "gs v2 g7") && gs_test_text(s, "play.name") == "Moss Run";
  #assert gs_test_text(s, "play.remix") == "remix" && tr_attr_of(tr, tr_find(tr, "play.make"), AT_HREF) == GS_BUILDER && gs_test_text(s, "play.report") == "report" && tr_attr_of(tr, tr_find(tr, "play.create"), AT_HREF) == GS_BUILDER;
  // the HUD has the world's wire; the page has no build tool, no chat, no publish, no account, no edit field for a tool to write to
  #assert gs_test_slot(s, "blocks") >= 0 && gs_test_slot(s, "state") >= 0 && gs_test_slot(s, "where") >= 0 && gs_test_slot(s, "hotkey") >= 0;
  #assert gs_test_slot(s, "hot.s.0") < 0 && gs_test_slot(s, "say") < 0 && gs_test_slot(s, "say.in") < 0 && gs_test_slot(s, "edit") < 0 && gs_test_slot(s, "pub") < 0 && gs_test_slot(s, "me") < 0 && gs_test_slot(s, "kept") < 0;
  // played for a while: nothing is written to this browser, nothing asked of an account, and the builder's steps are not counted
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "where"), "1.00 2.00 0.00 1.00");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "1"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "del");
  #assert k[0].n == GT_CIRCUIT + 1 && k[0].tool == BL_T_NONE;
  act := s[0].act; gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "r"); #assert s[0].act == act + 1;   // (R: a race starts again, as in the builder)
  gs_test_frames(s); gs_test_wait(s, 400);
  #assert gs_keep_next(s) == 0 && !gs_wants(s) && !gs_test_counted(s, LP_BUILDER) && !gs_test_counted(s, LP_PICKED) && !s[0].acct[0].link[GS_RACING].built;
  // a report: four reasons, one sent, and thanks
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.report"), 0); f = gs_frame(s, 0.016, true);
  #assert gs_test_text(s, "play.r.0") == "offensive" && gs_test_text(s, "play.r.3") == "something else" && gs_test_slot(s, "play.remix") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.r.2"), 0);
  #assert gs_test_door(s) == "/api/play/abc234/report" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"reason\":\"spam\"}";
  gs_test_answer(s, 200, "{\"ok\":true,\"reported\":true}");
  f = gs_frame(s, 0.016, true);
  #assert gs_has(gs_test_text(s, "play.note"), "reported") && gs_test_slot(s, "play.report") < 0 && gs_test_slot(s, "play.remix") >= 0;
  // remix: this browser keeps no game of the type, so the copy is the visitor's at once, in their own builder, as a guest
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.remix"), 0);
  #assert p[0].checking && s[0].playing;
  for q: 0..<2 { op := gs_keep_next(s); #assert op == KP_GET; gs_test_stored(s, gs_keep_slot(s), KP_MISSING, ""); }   // (the level and its settings: neither is kept here)
  #assert !s[0].playing && s[0].game && k[0].n == GT_CIRCUIT + 1 && c[0].kind == GS_RACING && gs_test_counted(s, LP_REMIX) && gs_go(s) == GS_BUILDER.count && cast(string) s[0].go[0..<GS_BUILDER.count] == GS_BUILDER;
  ln := gs_test_puts(s, t[0].level[..]);
  #assert ln > 0 && gs_has(cast(string) t[0].level[0..<ln], "world.doc.v1 level-8\n");
  f = gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "hot.s.0") >= 0 && gs_test_slot(s, "pub") >= 0 && gs_test_slot(s, "edit") >= 0 && gs_test_slot(s, "play") < 0 && gs_has(gs_test_limit(s), "this copy is yours now");
  // and it is theirs to build on
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 30.00 20.00 2.00 2.00 1.00 0.00 rest"); #assert k[0].n == GT_CIRCUIT + 2;
}

#test "a link's game is counted from its page, and its remix remembers it: the game's own door hears opened once the tab is known to count, and remix from the builder it led to; the copy is kept as a remix of that game" #steps 4000000000 {
  t: [1] GsPlayTest; s := t[0].s[..]; c := s[0].chat[..]; p := s[0].pub[..];
  gs_test_say(s, GS_ADDRESS, 0, "/g/abc234");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  answer := gs_test_play_answer(t[..], "Moss Run");
  gs_test_answer(s, 200, answer);
  f := gs_frame(s, 0.016, true);
  // it is up, and whether this tab counts is not known yet: nothing is sent
  #assert p[0].play == PL_UP && !gs_wants(s);
  gs_test_clock(s, "900 900 148 0 0 -1 0 0"); f = gs_frame(s, 0.016, true);
  #assert gs_wants(s) && s[0].flight == GS_PUBLISH_ASKS && gs_test_door(s) == "/api/play/abc234/played" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"fact\":\"opened\"}";
  gs_test_answer(s, 200, "{\"ok\":true,\"counted\":\"opened\"}");
  f = gs_frame(s, 0.016, true);
  #assert p[0].play == PL_UP && s[0].playing && (!gs_wants(s) || gs_test_door(s) != "/api/play/abc234/played");
  // remix: the copy is the visitor's, in their builder, and the game it came from hears of it from there
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.remix"), 0);
  for q: 0..<2 { op := gs_keep_next(s); #assert op == KP_GET; gs_test_stored(s, gs_keep_slot(s), KP_MISSING, ""); }
  #assert !s[0].playing && s[0].game && c[0].kind == GS_RACING;
  f = gs_frame(s, 0.016, true);
  #assert gs_wants(s) && s[0].flight == GS_PUBLISH_ASKS && gs_test_door(s) == "/api/play/abc234/played" && cast(string) s[0].req_body[0..<gs_body_len(s)] == "{\"fact\":\"remix\"}";
  gs_test_answer(s, 0, "");
  f = gs_frame(s, 0.016, true);
  #assert s[0].game && !s[0].playing && (!gs_wants(s) || gs_test_door(s) != "/api/play/abc234/played");
  // and the copy is kept as a remix of that game: its publish will say so (web/publish.coax)
  #assert ac_from(s[0].acct[..], GS_RACING) == "abc234";
}
#test "a link's game opened in a program's browser is not counted" #steps 4000000000 {
  t: [1] GsPlayTest; s := t[0].s[..]; p := s[0].pub[..];
  gs_test_say(s, GS_ADDRESS, 0, "/g/abc234");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  answer := gs_test_play_answer(t[..], "Moss Run");
  gs_test_answer(s, 200, answer);
  f := gs_frame(s, 0.016, true);
  gs_test_clock(s, "900 900 148 2 0 -1 0 0"); f = gs_frame(s, 0.016, true);
  gs_test_frames(s); gs_test_wait(s, 400);
  #assert p[0].play == PL_UP && s[0].count[0].off && !gs_wants(s) && p[0].facts == 0;
}

#test "a link's page: a link that plays nothing says so and leads to the builder; remix never replaces a game kept in this browser without a yes" #steps 4000000000 {
  t: [1] GsPlayTest; s := t[0].s[..]; c := s[0].chat[..]; k := c[0].blocks[..]; p := s[0].pub[..];
  // not a code: nothing is asked for it
  gs_test_say(s, GS_ADDRESS, 0, "/g/NOPE");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  f := gs_frame(s, 0.016, true);
  #assert s[0].playing && p[0].play == PL_GONE && !gs_wants(s) && gs_test_text(s, "play.h") == "this game isn't available." && gs_test_text(s, "play.make") == "create a game";
  // unpublished or taken down: the server says so, and so does the page
  gs_test_say(s, GS_ADDRESS, 0, "/g/abc234");
  gs_test_answer(s, 404, "{\"ok\":false,\"error\":\"not-found\",\"why\":\"this game isn't available\"}");
  f = gs_frame(s, 0.016, true);
  #assert p[0].play == PL_GONE && gs_test_text(s, "play.h") == "this game isn't available." && gs_test_slot(s, "play.remix") < 0;
  // the server didn't answer: try again asks again
  gs_test_say(s, GS_ADDRESS, 0, "/g/abc234");
  gs_test_answer(s, 0, "");
  f = gs_frame(s, 0.016, true);
  #assert p[0].play == PL_FAIL && gs_test_text(s, "play.again") == "try again";
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.again"), 0);
  #assert gs_test_door(s) == "/api/play/abc234";
  answer := gs_test_play_answer(t[..], "Moss Run");
  gs_test_answer(s, 200, answer);
  #assert p[0].play == PL_UP && k[0].n == GT_CIRCUIT + 1;
  // remix, and this browser keeps a racing game of the visitor's own: asked, in words, and kept on a no
  f = gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.remix"), 0);
  #assert p[0].checking;
  for q: 0..<4 {
    op := gs_keep_next(s); if op == 0 { break; }
    slot := gs_keep_slot(s);
    gs_test_stored(s, slot, ifx slot == KP_LEVEL_GET then KP_OK else KP_MISSING, ifx slot == KP_LEVEL_GET then cast(string) t[0].file[0..<lv_write(t[0].b[..], t[0].st[..], 8, t[0].file[..])] else "");
  }
  f = gs_frame(s, 0.016, true);
  #assert s[0].playing && p[0].swap && !p[0].checking && gs_has(gs_test_text(s, "play.ask"), "you have a racing game in this browser already") && gs_test_text(s, "play.swap") == "replace mine";
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.keep"), 0); f = gs_frame(s, 0.016, true);
  #assert s[0].playing && !p[0].swap && gs_keep_next(s) == 0 && gs_test_slot(s, "play.remix") >= 0;
  // the builder from the link's page: the visitor's own game, not the one they were playing
  gs_event(s, GS_CLICK, gs_test_slot(s, "play.make"), 0);
  #assert !s[0].playing && !s[0].game && gs_go(s) == GS_BUILDER.count;
}
