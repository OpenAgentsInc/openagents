// gamebuilder.org: the GameBuilder website, a Coax Native Web page the
// browser draws. One page is the whole site: the home page (the ring of game types: web/home.coax),
// the login and the world (the home page of someone logged in: docs/web-world.md) are views
// of it, and moving between them changes the address without loading a page
// (the host's dom_go; coax/web/dom-host.js). The page is a tree (components/core/tree.coax)
// in black and white, sent to the page by the browser backend
// (components/backend/dom.coax). Under it the GPU draws the HUD (hud.coax):
// the ground, the ring of portals and a frame round every panel that has the `hud` class. Its pictures
// (web/img/) are the game types' portals; the brand's mark is in the stylesheet (look.coax). The host is
// coax/web/dom-host.js and holds no logic; site-face.c is its scalar face.
// It is built as two modules (issue 30): web/site.coax, the page with /agents left out (web/agents-off.coax),
// which every address but /agents loads, and web/site-agents.coax, the page with the chat with your
// agents (web/agents.coax), which only /agents loads. This file's checks run with each.
//   scripts/web.sh           dev server with hot reload, http://127.0.0.1:8810/
//   scripts/web.sh check     the checks
//   coax/bin/coax test web/site.coax --library

#load "look.coax";
#load "home.coax";   // the home page: its words and its nodes (index.html holds the same, for the first paint)
#load "login.coax";
#load "chat.coax";
#load "../../coax/lib/crypto/entropy.coax";
#load "../../components/kit/dock.coax";   // the kit's slider (k_slider)
#load "gpu-words.coax";     // what is said when the browser cannot run the builder (issue 14)
#load "props-panel.coax";   // the settings panels, drawn from the registry
#load "undo.coax";          // undo and redo: a step an edit
#load "keep.coax";          // what is built, kept in this browser as the app's level file
#load "count.coax";         // the core loop's steps, counted (issue 18): the steps are shared/loop.coax's
#load "account.coax";       // and, logged in, on the account: the same file, through the same rows as every surface (issue 16)
#load "../core/agent-record.coax";   // an agent's record, events and words: the app's, the CLI's and this page's one list
#load "publish.coax";       // publish, and a link anyone plays: the same rows again, and the link's page (issue 17)

GS_INBOX :: LV_DOC + KP_HEADER;   // a field's text, an address, a piece of an answer from the host, or a kept level read back (keep.coax)
// The page's voice: lowercase, clipped, few words. The name, GAMEBUILDER, keeps
// its capitals. No game has a section of its own for now (the owner's call); pictures keep plain descriptions for screen readers.
GS_HOME_VIEW :: 0; GS_LOGIN_VIEW :: 1; GS_WORLD_VIEW :: 2; GS_CREDITS_VIEW :: 3; GS_CLI_VIEW :: 4; GS_AGENTS_VIEW :: 5;
GS_VIEWS :: 6;
// Where each view lives. The world is the home page of someone logged in, and anyone's at GS_BUILDER (a guest builds there: gs_path).
// The credits (whose work the site uses, and under what licence) are a page of their own, for anyone, logged in or not.
// /login/cli is where `gamebuilder login` sends you: the login, then a one-time code for the command
// line with a copy button (login.coax, docs/cli.md). It looks like the login (its class is v1) and
// being logged in does not move you off it: that is when it is used.
// /agents is a chat with your agents (issues 4 and 29; web/agents.coax): logged in only, a page of its own (v5).
GS_PATHS :: [GS_VIEWS] string.["/", "/login", "/", "/credits", "/login/cli", "/agents"];
GS_VIEW_CLASS :: [GS_VIEWS] string.[GS_HOME_CLASS, "gs v1", "gs v2", "gs v3", "gs v1", "gs v5"];
GS_CLIP :: 4096;       // what a copy button puts on the clipboard: a command line's code, a published game's link, or (on /agents) what came back to a command, or an answer's block of code
// The game types you pick from before the world comes up (docs/web-world.md, "Game types"): each
// has its own entrance and its own camera and keys, which are the HUD's (hud.coax: the engine's
// camera kinds, in this order). The page's class says which (g0 to g3), or that you are picking.
// The types and their cards are shared/game-types.coax's (the app's picker draws the same list):
// the website's nine, its kind k being type gt_web_type(k), in the order gt_picker gives.
GS_KINDS :: GT_WEB_TYPES;
GS_KIND_NO :: [GS_KINDS] string.["0", "1", "2", "3", "4", "5", "6", "7", "8"];
GS_KIND_KEY :: [GS_KINDS] string.["1", "2", "3", "4", "5", "6", "7", "8", "9"];
GS_KIND_CLASS :: [GS_KINDS] string.["gs v2 g0", "gs v2 g1", "gs v2 g2", "gs v2 g3", "gs v2 g4", "gs v2 g5", "gs v2 g6", "gs v2 g7", "gs v2 g8"];
// the same, for a kept world come back (`still`): the glue reads the word and the HUD brings the world up settled, with no entrance (hud.coax HUD_CALM_MSG)
GS_KIND_STILL :: [GS_KINDS] string.["gs v2 g0 still", "gs v2 g1 still", "gs v2 g2 still", "gs v2 g3 still", "gs v2 g4 still", "gs v2 g5 still", "gs v2 g6 still", "gs v2 g7 still", "gs v2 g8 still"];
GS_SIDE :: 3;          // the side-scroller: its camera is its own, so the hotbar has no camera menu there
GS_VILLAGE :: 4;       // the medieval village: its buildings are 0 A.D.'s art, credited on its card's tooltip and on the credits page (gs_credits)
GS_OWN :: 5;           // from here on a game type is a world of its own, not the meadow: built in as the meadow is, and its hotbar adds its own action (reset)
GS_CRATES :: 5;        // crates: a puzzle room seen from above (web/world-crates.coax)
GS_PLATFORMER :: 6;    // platformer: a sky course seen side on (web/world-platformer.coax)
GS_RACING :: 7;        // racing: a circuit driven in a car (web/world-racing.coax)
GS_DRIFT :: 8;         // drift: a ship flown through rings in zero g (web/world-drift.coax)
GS_VILLAGE_CREDIT :: GT_CREDIT[GT_VILLAGE];   // (shared/game-types.coax: the app's card says it too)
// Whose request is with the host: one goes at a time.
// The kept game as the page opens (keep.coax): asked for, then its level awaited, then done (there was none, it is up, or it took too long).
GS_B_ASK :: 0; GS_B_LEVEL :: 1; GS_B_DONE :: 2;
GS_NOBODY :: 0; GS_LOGIN_ASKS :: 1; GS_CHAT_ASKS :: 2; GS_AGENT_ASKS :: 3;   // (the build agent's own requests: web/chat.coax)
GS_COUNT_ASKS :: 4;    // a count of the loop's steps (web/count.coax): the last to go, the first to give way, and its answer is not read
GS_ACCOUNT_ASKS :: 5;  // the account's: the game kept there (web/account.coax); before a count, after a conversation
GS_AGENTS_ASKS :: 6;   // /agents' rows (agents, agent-events), on your account
GS_PUBLISH_ASKS :: 7;  // publishing's, and a link's page's (web/publish.coax): a person's press, after the account's save it waits on
GS_LINK :: "/g/";      // a published game's link is GS_LINK and its code (docs/publishing.md): the world, played, with no build tools
GS_GO :: 32;
// What the host says happened: a press, a field's text, Enter in a field, a piece of an
// answer and its end, and the address (as the page starts, and after Back or Forward).
GS_CLICK :: 1; GS_INPUT :: 2; GS_SUBMIT :: 3; GS_PIECE :: 4; GS_END :: 5; GS_ADDRESS :: 13;

Site :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  view: int;                           // which page of the site is shown: one module, no reload between them
  room: int; whole: int;               // crates: which of its game's levels is up, from 0 (a room each), and how many times the level was replaced whole (the HUD enters it afresh)
  go: [GS_GO] u8; go_n: int;           // an address for the face to put in the bar (the page is already drawn)
  login: [1] Login;
  chat: [1] Chat;
  asked_play: bool;                    // the world was asked for by its old address, /play
  menu: bool;                          // your menu is open
  panel: bool;                         // the world's settings are open over the hotbar
  cams: bool;                          // the camera menu is open over its slot
  pal: [1] HbPalette;                  // the "more" palette: open or not, and the item focused in it
  rock: int;                           // which rock the village's rock tool places: 0 the grey one, 1 the mossy one
  cat: [1] HbCatalog;                  // the hotbar's catalogue as it stands (gs_cat fills it before each use)
  lay: [GS_KINDS] HbLayout;            // each game type's bar, as this browser keeps it (its own until the person changes it)
  laid: [GS_KINDS] bool; mine: [GS_KINDS] bool;   // a type's bar is set up; it is the person's (kept by the glue), not the type's own
  fly: int;                            // presses of "fly" so far: the HUD is told the count, and flies or lands when it changes
  act: int;                            // presses of the world's own action so far (crates: reset the room; the platformer: start the course over; racing: back on the track, or after the flag race again): the HUD is told the count, and acts when it changes
  tip: [96] u8;                        // the shapes slot's tooltip as it stands (what it places, and how full the world is)
  limit: [AC_SAID] u8; limit_n: int; limit_till: f32;   // a limit you just hit, in words with its number, shown over the hotbar for GS_LIMIT_SHOWN seconds
  gpu: int;                            // why the builder can't run in this browser (gpu-words.coax GW_*; the glue asks the browser and says which): 0, it can, or nothing is known yet
  still: bool;                         // the world shown is a kept one come back (a restored game): it comes up settled, with no entrance (gs_still; picking a type in the picker ends it)
  picking: bool;                       // logged in, you are picking a game type: the world comes up once you have (the choice is the chat's `kind`)
  want: int = -1;                      // a type the address asked for (GS_BUILDER?type=ID: a name of the home page's pressed, its own link): entered once the world is up
  mine_open: bool;                     // logged in, at the ring: "your games" is open (the button by your icon)
  last: int = -1;                      // the type you picked last, here or (the glue says) in this browser before: shown lit, nothing more
  fps: int; fps_t: f32; fps_n: int;    // frames a second, counted over each half second, shown faint in the world's corner
  left: bool;                          // you pressed log out: the home page is next, not the login
  game: bool;                          // a game is up: a type was picked, or the kept game was read back. Coming to the world again is that game, not the picker
  boot: int;                           // GS_B_*: where reading the kept game back has got to
  boot_at: f32; open_at: f32;          // when the kept game, and a picked type's level, were asked for (an answer that takes too long is not waited for)
  sheet: bool;                         // the login is open over the world (a guest pressed log in): the world stays on screen behind it
  redo: int;                           // undo (1) or redo (2) was asked for in this event: done once the event's own edits are known
  keep: [1] Keep;                      // what is built, kept in this browser
  acct: [1] Acct;                      // and on the account of whoever is logged in (web/account.coax)
  was_in: bool;                        // someone was logged in at the last look: logging in is when the account is first looked at
  listed: bool;                        // the picker has asked for the account's games since it opened
  byhand: bool;                        // (checks only) the account's requests are answered by the check itself, not as an account that agrees
  keep_at: [2] int; keep_op: int;      // the storage request the face is to make: its slot and token, and KP_GET or KP_PUT
  ns: [32] u8;                         // the storage namespace, where the face can point at it
  undo: [1] Undo;                      // undo and redo
  was_world: bool;                     // the credits were opened from the world: going back keeps the game type you had
  count: [1] Count;                    // the loop's steps this tab has counted, and the counts that wait to be sent (count.coax)
  ag: [1] GsAgents;                    // /agents: your agents, read from your account
  to_game: int;                        // a game /agents' link opens in the builder, once the account's games are listed (0: none)
  to_agents: bool;                     // /agents was asked for logged out: back to it once you are in
  pub: [1] Publish;                    // publishing the game that is up, and a link's page (web/publish.coax)
  playing: bool;                       // the address is a published game's link: its world is played, and nothing of the builder shows
  flight: int;                         // whose request is with the host
  req_url: [96] u8; req_url_n: int;    // the request the face sends: its door and its body
  req_body: [AC_BODY] u8; req_body_n: int;   // (the biggest request: a level's file kept on the account)
  req_ready: bool;
  inbox: [GS_INBOX] u8;
  clip: [GS_CLIP] u8; clip_n: int;     // for the clipboard, once: the face writes it after the frame (dom_clip)
  sets: [MF_COUNT] AfSettings;
  css: [GS_CSS] u8;
  ui: [1] Ui;
  tree: [1] Tree;
  dom: [1] Dom;
}

gs_build :: (s: [] Site) {
  t := s[0].tree[..];
  a: [UI_ID] u8; b: [UI_ID] u8;
  tr_begin(t);
  // the view is in the page's class, where the glue reads it for the HUD's camera
  classes := GS_VIEW_CLASS;
  // while the login is still being asked who is here, the class says so ("asking"): a browser
  // that was logged in last time keeps the home page out of sight for that moment (index.html)
  asking := [GS_VIEWS] string.[GS_HOME_ASKING, "gs v1 asking", "gs v2 pick asking", "gs v3", "gs v1 asking", "gs v5 asking"];
  // in the world the class also says the game type, or that it is still being picked (the camera waits at the login's pose)
  kinds := ifx s[0].still then GS_KIND_STILL else GS_KIND_CLASS;
  checking := s[0].login[0].step == LG_CHECKING;
  // (picking, once the kept game has been asked for: the ring of portals, as on the home page; the glue raises it in the world: "ring")
  here := ifx s[0].view != GS_WORLD_VIEW then (ifx checking then asking[s[0].view] else classes[s[0].view]) else ifx !s[0].picking then kinds[s[0].chat[0].kind] else ifx checking then asking[2] else ifx s[0].boot == GS_B_DONE && s[0].want < 0 then "gs v2 pick ring" else "gs v2 pick";
  // a link's page: the world as the game's type once its level is in it; until then the camera waits, as at the picker
  if s[0].playing { here = ifx s[0].pub[0].play == PL_UP then kinds[s[0].chat[0].kind] else "gs v2 pick"; }
  // the home page is home.coax's, whole: index.html holds the same nodes for the first paint
  // the counting's note for the glue (count.coax): the note, and what waits to be sent, should the page be left first
  cn: [CT_NOTE + LP_BODY + 64] u8; cb: [LP_BODY] u8;
  cl := bl_put(cn[..], 0, ct_note(s[0].count[..], cb[..])); cl = bl_put(cn[..], cl, "\n"); cl = bl_put(cn[..], cl, LP_DOOR); cl = bl_put(cn[..], cl, "\n"); cl = bl_put(cn[..], cl, ct_waiting(s[0].count[..], cb[..]));
  counting := cast(string) cn[0..<cl];
  if s[0].view == GS_HOME_VIEW { gs_home_page(t, here, s[0].gpu, counting); return; }
  page := tr_open(t, "page", TG_MAIN, here);

  // the top bar: the logo alone in the window's top left corner; at the right, the way in, or you
  top := tr_open(t, "top", TG_HEADER, "top");
  gs_brand(t);
  // why the builder can't run here, from the glue (hud-glue.js: it asks the browser for WebGPU): a hidden field on every view (the home page's is home.coax's)
  gs_gpu_field(t);
  gs_count_field(t, counting);
  if s[0].view == GS_CREDITS_VIEW && s[0].login[0].step != LG_IN { gs_way_in(t); }
  if s[0].playing {
    // a link's page: the one way on is the builder
    nav := tr_open(t, "nav", TG_NAV, "nav");
    mk := tr_leaf(t, "play.create", TG_A, "pubgo", "create a game"); tr_attr(t, mk, AT_HREF, GS_BUILDER);
    tr_close(t);
  } else if s[0].view == GS_WORLD_VIEW || ((s[0].view == GS_CREDITS_VIEW || s[0].view == GS_AGENTS_VIEW) && s[0].login[0].step == LG_IN) {
    nav := tr_open(t, "nav", TG_NAV, "nav");
    // publish: the game that is up, on the web, at a link anyone plays (a guest is asked to log in or create an account first)
    if s[0].view == GS_WORLD_VIEW && !s[0].picking && s[0].gpu == GW_FINE {
      pg := tr_leaf(t, "pub", TG_BUTTON, "pubgo", "publish"); tr_attr(t, pg, AT_TITLE, "put this game on the web: a link anyone can play");
    }
    // at the ring, logged in: "your games", by your icon (it opens them over the ring: gs_mine)
    if s[0].view == GS_WORLD_VIEW && s[0].picking && s[0].login[0].step == LG_IN && s[0].gpu == GW_FINE {
      mb := tr_leaf(t, "mine.b", TG_BUTTON, "pubgo", "your games"); tr_attr(t, mb, AT_EXPANDED, ifx s[0].mine_open then "true" else "false");
    }
    // you are an icon; pressing it opens a small menu under it: who you are, and the way out (a guest: the way in)
    me := tr_leaf(t, "me", TG_BUTTON, ifx s[0].menu then "me on" else "me", "");
    tr_attr(t, me, AT_LABEL, "account");
    if s[0].menu {
      menu := tr_open(t, "menu", TG_DIV, "menu");
      if s[0].login[0].who_n > 0 { who := tr_leaf(t, "nav.who", TG_SPAN, "mono", cast(string) s[0].login[0].who[0..<s[0].login[0].who_n]); }
      if !s[0].picking && s[0].view == GS_WORLD_VIEW { type := tr_leaf(t, "type", TG_BUTTON, "quiet", "game type"); }   // back to the picker
      if s[0].login[0].step == LG_IN {
        agents := tr_leaf(t, "nav.agents", TG_A, "quiet", "agents");   // your agents, by game: a page of its own
        tr_attr(t, agents, AT_HREF, "/agents");
      }
      credits := tr_leaf(t, "nav.credits", TG_A, "quiet", "credits");   // whose work the site uses: a page of its own
      tr_attr(t, credits, AT_HREF, "/credits");
      if s[0].login[0].step == LG_IN { out := tr_leaf(t, "out", TG_BUTTON, "quiet", "log out"); }
      else if s[0].login[0].step != LG_CHECKING { in := tr_leaf(t, "in", TG_BUTTON, "quiet", "log in"); }
      tr_close(t);
    }
    tr_close(t);
  }
  tr_close(t);
  // a browser that cannot run the builder is told so where the builder would be, and before the login that leads to it
  // (never a blank or black page; the command line's login needs no WebGPU and is left alone)
  if s[0].gpu != GW_FINE && (s[0].view == GS_WORLD_VIEW || s[0].view == GS_LOGIN_VIEW) { gs_nogpu(s, t); }
  if s[0].gpu != GW_FINE && s[0].view == GS_WORLD_VIEW { tr_close(t); return; }
  if s[0].view == GS_LOGIN_VIEW || s[0].view == GS_CLI_VIEW { lg_section(s[0].login[..], t); tr_close(t); return; }
  if s[0].view == GS_CREDITS_VIEW { gs_credits(s, t); tr_close(t); return; }
  if s[0].view == GS_WORLD_VIEW && s[0].playing { gs_play(s, t); tr_close(t); return; }
  if s[0].view == GS_AGENTS_VIEW { if s[0].login[0].step == LG_IN { gs_agents(s, t); } tr_close(t); return; }
  if s[0].view == GS_WORLD_VIEW {
    // the world itself is the HUD's (hud.coax): the page adds only the chat (for a guest, the words that say how to talk
    // to the agent) and, before it, the game type picker: no chat until a type is picked. Nobody need be logged in.
    // (while the game kept in this browser is still being asked for, neither: a returning person lands in their game, not on the picker)
    {
      if s[0].picking { if s[0].boot == GS_B_DONE { gs_picker(s, t); } }
      else {
        overlay := tr_open(t, "world.ui", TG_DIV, "player-ui");
        ch_section(s[0].chat[..], t); gs_foot(s, t); tr_close(t);
        // a guest who pressed log in: the login over the world, which stays as it is behind it
        if s[0].sheet && s[0].login[0].step != LG_IN {
          sheet := tr_open(t, "sheet", TG_DIV, "sheet");
          s[0].login[0].over = true; lg_section(s[0].login[..], t); s[0].login[0].over = false;
          shut := tr_leaf(t, "sheet.x", TG_BUTTON, "quiet", "keep building");
          tr_close(t);
        }
        else if s[0].pub[0].open { gs_pub_sheet(s, t); }
        // whether what is built is kept, small and faint in the window's bottom right corner, over the frames a second
        // (logged in, it is the account's note while the account has one: saving, kept, or why not)
        note := kp_note(s[0].keep[..]); fine := s[0].keep[0].state == KP_ON && !s[0].keep[0].full;
        mine := ifx s[0].login[0].step == LG_IN then ac_note(s[0].acct[..]) else "";
        if mine.count > 0 { note = mine; fine = s[0].acct[0].state == AC_S_BUSY || s[0].acct[0].state == AC_S_KEPT; }
        if note.count > 0 { kept := tr_leaf(t, "kept", TG_SPAN, ifx fine then "kept mono" else "kept mono no", note); tr_attr(t, kept, AT_LIVE, "polite"); }
        // frames a second, small and faint in the window's bottom right corner
        digits: [12] u8; fn := bl_int(digits[..], 0, s[0].fps);
        fps := tr_leaf(t, "fps", TG_SPAN, "fps mono", cast(string) digits[0..<fn]);
        tr_attr(t, fps, AT_TITLE, "frames a second");
      }   // (nothing about licences shows while playing: the credits are a page, /credits)
    }
    tr_close(t);
    return;
  }

}

GS_LIMIT_SHOWN :: 5.0;   // seconds a limit's words stay over the hotbar
// A limit was hit (AGENTS.md: it is said on screen, in words, with its number, never as a silent no-op): its words over the hotbar for a while.
gs_limit :: (s: [] Site, why: int) {
  n := bl_why(s[0].chat[0].blocks[..], why, s[0].limit[..], 0);
  if n > 0 { s[0].limit_n = n; s[0].limit_till = s[0].time + GS_LIMIT_SHOWN; s[0].dirty = true; }
}
// Words over the hotbar for a while: something a person should know, said once (a limit of the browser's, the end of undo).
gs_say :: (s: [] Site, words: string) { s[0].limit_n = bl_put(s[0].limit[..], 0, words); s[0].limit_till = s[0].time + GS_LIMIT_SHOWN; s[0].dirty = true; }
// The world has just become nearly full (the thing just added took it to BL_NEAR percent): said once, as it happens.
gs_nearly :: (s: [] Site, before: int) {
  k := s[0].chat[0].blocks[..];
  if !bl_nearly(k) || before * 100 >= BL_MAX * BL_NEAR || k[0].n <= before { return; }
  n := bl_put(s[0].limit[..], 0, "nearly full: "); n = bl_count(k, s[0].limit[..], n) ; n = bl_put(s[0].limit[..], n, ".");
  s[0].limit_n = n; s[0].limit_till = s[0].time + GS_LIMIT_SHOWN; s[0].dirty = true;
}
// The hotbar (docs/web-world.md, "The hotbar"): every item this world has is its catalogue, in
// sets, and the "more" slot at the bar's right end opens the palette of them all; the bar is the
// few of them the person keeps there, in their order (a layout per game type, kept by this browser:
// the glue's localStorage, read back through gs_bar_in and checked against the catalogue).
GS_SETS :: 6;
GS_SET :: [GS_SETS] string.["build", "place", "edit", "camera", "world", "agent"];
GS_SET_BUILD :: 0; GS_SET_PLACE :: 1; GS_SET_EDIT :: 2; GS_SET_CAMERA :: 3; GS_SET_WORLD :: 4; GS_SET_AGENT :: 5;
GS_MODE_AT :: 4;   // where the shapes slot's modes begin among its options, after its four shapes
GS_SHAPE_IDS :: [BL_SHAPES] string.["cube", "sphere", "slab", "pillar"];
// A game type's own kinds as hotbar items (their ids are the kinds' words, bl_role_word): the glyph, and what it does.
GS_ROLE_GLYPHS :: [BL_ROLES] string.["", "⤒", "▲", "◆", "⚑", "▇", "◎", "»", "△", "∿", "◯", "⇄", "⇅", "⇥", "⌂"];
GS_ROLE_TIPS :: [BL_ROLES] string.["",
  "bounce pad: click the world. it throws the character up",
  "spikes: click the world. standing on them puts the character back",
  "shard: click the world. touched, it is taken; the course brings it back",
  "checkpoint: click the world. stood on, a fall comes back to it",
  "wall: click the world. fixed: nothing pushes it",
  "goal: click the world. a crate must rest on it to open the gate",
  "boost: click the world. the car speeds up over it",
  "cone: click the world. the car knocks it away",
  "track point: click the world. the road is laid through the track points in their order",
  "ring: click the world. the course goes through the rings in their order",
  "moving platform: click the world. it slides 8 m along the course and back in 6 seconds, carrying who stands on it",
  "lift: click the world. it rises 6 m and comes down in 6 seconds, carrying who stands on it",
  "gate: click the world. the way out of the room: shut until every goal holds a crate. the first one placed is the room's",
  "start: click the world. where you stand when the room is entered. the first one placed is the room's"];
// The kind an item places (its id, a kind's word, that this game type has); 0 for any other item.
gs_role_item :: (s: [] Site, id: string) -> int { r := bl_role_of(id); return ifx r > 0 && bl_role_ok(s[0].chat[0].blocks[..], r) then r else 0; }
GS_MORE_TIP :: "more: everything you can do here, and where each goes (0)";
// The cameras the camera menu holds, in its order (and the number the HUD is told: hud.coax's hud_cam_want).
GS_CAM_ORBIT :: 0; GS_CAM_FOLLOW :: 1; GS_CAM_FIRST :: 2; GS_CAM_TOP :: 3; GS_CAMS :: 4;
// The camera a game type starts with: its own (side on keeps its own, and says the orbit).
gs_cam_of :: (kind: int) -> int { return ifx kind == 1 then GS_CAM_FIRST else ifx kind == 2 then GS_CAM_TOP else GS_CAM_ORBIT; }
// A game type's bar as it starts, as its items' ids: the meadow's tools; a world of its own, its own action.
// (every game type is built in: a world of its own has the build tools too, no camera menu (its camera is its own), and its reset)
// (a world of its own: its own kinds after the shapes, as items of their own)
// (undo and redo stand at the bar's end where there is room for them: the platformer's and the village's bars are full, and theirs are in "more"; the keys work everywhere)
gs_bar_of :: (kind: int) -> string { return ifx kind == GS_CRATES then "shapes,wall,goal,edit,decide,world,reset,undo,redo" else ifx kind == GS_PLATFORMER then "shapes,pad,spikes,shard,checkpoint,edit,decide,world,reset" else ifx kind == GS_RACING then "shapes,boost,cone,edit,decide,world,reset,undo,redo" else ifx kind >= GS_OWN then "shapes,edit,decide,world,reset,undo,redo" else ifx kind == GS_VILLAGE then "britons,gauls,market,rock,edit,decide,camera,world" else "shapes,edit,decide,camera,world,undo,redo"; }
// The village's building tools, by their items: a house of each people's, the market, and the rocks (one item, the two rocks its options).
GS_BUILD_IDS :: [4] string.["britons", "gauls", "market", "rock"];
// The model an item of the village's places (the rock: the one its options last chose); -1 for any other item.
gs_model_of :: (s: [] Site, id: string) -> int {
  return ifx id == "britons" then 0 else ifx id == "gauls" then 1 else ifx id == "market" then 2 else ifx id == "rock" then (ifx s[0].rock == 1 then 3 else 4) else -1;
}
// Every item a game type has, filled from the page's own state (the shared component keeps none):
// each says what it is, a short name under its glyph and a line of what it does.
gs_cat :: (s: [] Site, kind: int, cat: [] HbCatalog) {
  c := s[0].chat[..]; k := c[0].blocks[..];
  cat[0].n = 0; cat[0].sets = 0;
  names := GS_SET; for g: 0..<GS_SETS { set := hb_set(cat, names[g]); }
  glyphs := [BL_SHAPES] string.["▢", "●", "▭", "▯"]; arts := [BL_SHAPES] string.["", "sphere", "", ""];
  tips := [BL_SHAPES] string.["place a cube: click the world", "place a sphere: click the world", "place a slab: click the world", "place a pillar: click the world"];
  // a world of its own: its own action too (every game type is built in: a game type adds, it never takes building away)
  if kind >= GS_OWN {
    r := hb_item(cat, GS_SET_WORLD, HbSlot.{id = "reset", glyph = "↺", label = "reset", kind = HB_ACTION, tip = ifx kind == GS_CRATES then "reset the room (R)" else ifx kind == GS_RACING then "back on the track (R)" else ifx kind == GS_DRIFT then "back at the last ring (R)" else "start the course over (R)"});
  }
  // basic geometry is one slot: its glyph is the shape it places now (the sphere's is the skin's shaded ball), and picked
  // it shows two groups over it: the shape (Q and E step through them) and how it is placed (Z and X)
  // (its tooltip also says how full the world is: "place a cube: click the world. things: 4 of 1000")
  tn := bl_put(s[0].tip[..], 0, tips[k[0].shape]); tn = bl_put(s[0].tip[..], tn, ". "); tn = bl_count(k, s[0].tip[..], tn);
  a0 := hb_item(cat, GS_SET_BUILD, HbSlot.{id = "shapes", glyph = glyphs[k[0].shape], art = arts[k[0].shape], label = "shapes", tip = cast(string) s[0].tip[0..<tn], opt = k[0].shape, opt_b = GS_MODE_AT + k[0].mode[0]});
  s0 := hb_item_option(cat, a0, HbOption.{id = "cube", label = "cube", tip = "a cube, 1 m (Q, E)"});
  s1 := hb_item_option(cat, a0, HbOption.{id = "sphere", label = "sphere", tip = "a sphere, 0.6 m radius (Q, E)"});
  s2 := hb_item_option(cat, a0, HbOption.{id = "slab", label = "slab", tip = "a slab, 2 m square, 0.25 m high (Q, E)"});
  s3 := hb_item_option(cat, a0, HbOption.{id = "pillar", label = "pillar", tip = "a pillar, 1 m square, 3 m high (Q, E)"});
  m0 := hb_item_option(cat, a0, HbOption.{id = "snap", label = "snap", group = 1, tip = "snap: on the grid, set down still (Z, X)"});
  m1 := hb_item_option(cat, a0, HbOption.{id = "free", label = "free", group = 1, tip = "free: exactly where you point, set down still (Z, X)"});
  // each shape is an item of its own too, so a bar may hold a sphere alone
  ids := GS_SHAPE_IDS;
  for q: 0..<BL_SHAPES { one := hb_item(cat, GS_SET_BUILD, HbSlot.{id = ids[q], glyph = glyphs[q], art = arts[q], label = ids[q], tip = tips[q]}); }
  // a game type's own kinds (shared/kinds.coax): each places its kind in the shape it is made as, click the world
  roles := ch_roles_of(kind); kg := GS_ROLE_GLYPHS; kt := GS_ROLE_TIPS;
  for r: 1..<BL_ROLES { if (roles & (1 << r)) != 0 { one := hb_item(cat, GS_SET_PLACE, HbSlot.{id = bl_role_word(r), glyph = kg[r], label = bl_role_word(r), tip = kt[r]}); } }
  // the village's buildings (0 A.D.'s models): each places a ghost of itself, turned by R, Shift+R or the wheel, snapped or free
  if kind == GS_VILLAGE {
    bids := GS_BUILD_IDS; bglyph := [4] string.["⌂", "⌂", "⛫", "◆"]; blabel := [4] string.["britons house", "gauls house", "market", "rock"];
    btip := [4] string.["a britons house: click the green to place it (R turns it)", "a gauls house: click the green to place it (R turns it)", "the gauls' market: click the green to place it (R turns it)", "a rock, grey or mossy: click the green to place it (R turns it)"];
    for q: 0..<4 {
      one := hb_item(cat, GS_SET_PLACE, HbSlot.{id = bids[q], glyph = bglyph[q], label = blabel[q], tip = btip[q], opt = ifx q == 3 then s[0].rock else k[0].mode[1], opt_b = 2 + k[0].mode[1]});
      if q == 3 {
        r0 := hb_item_option(cat, one, HbOption.{id = "grey", label = "rock", tip = "a grey rock"});
        r1 := hb_item_option(cat, one, HbOption.{id = "mossy", label = "mossy rock", tip = "a mossy rock"});
      }
      g := ifx q == 3 then 1 else 0;
      bm0 := hb_item_option(cat, one, HbOption.{id = "snap", label = "snap", group = g, tip = "snap: on the half-metre grid, set down still (Z, X)"});
      bm1 := hb_item_option(cat, one, HbOption.{id = "free", label = "free", group = g, tip = "free: exactly where you point, set down still (Z, X)"});
    }
  }
  a2 := hb_item(cat, GS_SET_EDIT, HbSlot.{id = "edit", glyph = "✎", label = "edit", kind = HB_TOGGLE, on = k[0].editing, tip = "edit mode: click a thing to select it, drag to move it"});
  // the camera: pressed, a row of the cameras stands over it (as the shapes' row does), the one in use lit; side on has its own alone
  cg := [GS_CAMS] string.["◎", "⇧", "◉", "▣"];
  a4 := hb_item(cat, GS_SET_CAMERA, HbSlot.{id = "camera", glyph = cg[c[0].cam], label = "camera", kind = HB_TOGGLE, group = 1, on = s[0].cams, hidden = kind == GS_SIDE || kind >= GS_OWN, tip = "camera: pick how you see the world", opt = c[0].cam});
  c0 := hb_item_option(cat, a4, HbOption.{id = "orbit", label = "orbit", tip = "orbit: drag to turn the camera round you, the wheel to zoom"});
  c1 := hb_item_option(cat, a4, HbOption.{id = "follow", label = "follow", tip = "follow: the camera stays behind you"});
  c2 := hb_item_option(cat, a4, HbOption.{id = "first", label = GT_NAME[GT_FIRST], tip = "first person: through your own eyes"});
  c3 := hb_item_option(cat, a4, HbOption.{id = "top", label = GT_NAME[GT_TOP], tip = "top-down: from above, it never turns"});
  a5 := hb_item(cat, GS_SET_WORLD, HbSlot.{id = "world", glyph = "⚙", label = "world", kind = HB_TOGGLE, group = 1, on = s[0].panel, tip = "world settings: gravity, time, the sky, how you move, the camera, the grass"});
  // flying, as Space twice does (not side on, and not while the world's player.fly is off)
  a6 := hb_item(cat, GS_SET_WORLD, HbSlot.{id = "fly", glyph = "⇡", label = "fly", kind = HB_ACTION, group = 1, hidden = kind == GS_SIDE || kind >= GS_OWN, off = pr_value(k[0].props[..], TW_FLY) == 0, tip = "fly: start or stop flying (Space twice does too)"});
  a7 := hb_item(cat, GS_SET_WORLD, HbSlot.{id = "clear", glyph = "⟲", label = "reset world", kind = HB_ACTION, group = 1, tip = "reset world: the things back as this world began"});
  a3 := hb_item(cat, GS_SET_AGENT, HbSlot.{id = "decide", glyph = "✦", label = "decide", kind = HB_ACTION, group = 1, busy = c[0].busy, tip = "decide: the agent builds the next thing"});
  t := hb_item(cat, GS_SET_WORLD, HbSlot.{id = "type", glyph = "▦", label = "game type", kind = HB_ACTION, group = 1, tip = "game type: pick another world"});
  u := hb_item(cat, GS_SET_WORLD, HbSlot.{id = "unbar", glyph = "⌫", label = "reset hotbar", kind = HB_ACTION, group = 1, tip = "reset hotbar: this world's own bar again"});
  // undo and redo: every edit is a step, a tool's or the agent's (web/undo.coax; the catalogue's last, in the edit set); with none to take, pressed they say so
  u0 := hb_item(cat, GS_SET_EDIT, HbSlot.{id = "undo", glyph = "↶", label = "undo", kind = HB_ACTION, tip = "undo: take the last edit back (Ctrl+Z, ⌘Z)"});
  u1 := hb_item(cat, GS_SET_EDIT, HbSlot.{id = "redo", glyph = "↷", label = "redo", kind = HB_ACTION, tip = "redo: make it again (Ctrl+Shift+Z, ⇧⌘Z, Ctrl+Y)"});
}
// The layout of the game type shown: the one this browser keeps, else the type's own.
gs_lay :: (s: [] Site) -> [] HbLayout {
  kind := s[0].chat[0].kind;
  if !s[0].laid[kind] { gs_cat(s, kind, s[0].cat[..]); n := hb_lay_read(s[0].lay[kind..<kind + 1], s[0].cat[..], gs_bar_of(kind)); s[0].laid[kind] = true; }
  return s[0].lay[kind..<kind + 1];
}
// The hotbar as it stands now: the catalogue filled, the layout on the bar, then "more"; the placing
// tool lit (the shapes slot when it is on the bar, else the shape's own).
gs_hot :: (s: [] Site, b: [] Hotbar) {
  kind := s[0].chat[0].kind; k := s[0].chat[0].blocks[..];
  l := gs_lay(s); gs_cat(s, kind, s[0].cat[..]);
  hb_fill(b, s[0].cat[..], l, s[0].pal[..], GS_MORE_TIP);
  ids := GS_SHAPE_IDS;
  at := hb_find(b, "shapes"); if at < 0 && k[0].tool != BL_T_NONE { at = hb_find(b, ids[k[0].shape]); }
  if k[0].brush != BL_R_NONE && k[0].tool != BL_T_NONE { at = hb_find(b, bl_role_word(k[0].brush)); }
  if k[0].tool >= BL_T_MODEL { bids := GS_BUILD_IDS; m := k[0].tool - BL_T_MODEL; at = hb_find(b, bids[ifx m == 3 then 3 else ifx m == 4 then 3 else m]); }
  hb_pick(b, ifx k[0].tool != BL_T_NONE then at else -1);
}
// The layout this browser kept for a game type, from the glue ("KIND ids", or "KIND\nids"): read against that type's
// catalogue; one whose every id is unknown is no layout, and the type's own stands.
gs_bar_in :: (s: [] Site, text: string) {
  if text.count < 2 || (text[1] != '\n' && text[1] != ' ') { return; }   // ("KIND ids" from a field, which keeps no line break)
  kind := cast(int) text[0] - cast(int) '0';
  if kind < 0 || kind >= GS_KINDS { return; }
  ids := cast(string) text[2..<text.count];
  gs_cat(s, kind, s[0].cat[..]);
  got: [1] HbLayout; n := hb_lay_read(got[..], s[0].cat[..], ids);
  if n == 0 && ids.count > 0 { return; }
  s[0].lay[kind] = got[0]; s[0].laid[kind] = true; s[0].mine[kind] = true; s[0].dirty = true;
}
// The layout as the glue keeps it ("KIND\nids", or "KIND\ndefault" while it is the type's own).
gs_bar_text :: (s: [] Site, out: [] u8) -> int {
  kind := s[0].chat[0].kind; l := gs_lay(s);
  n := bl_int(out, 0, kind); n = bl_put(out, n, "\n");
  if !s[0].mine[kind] { return bl_put(out, n, "default"); }
  gs_cat(s, kind, s[0].cat[..]);
  return n + hb_lay_text(l, s[0].cat[..], out[n..<out.count]);
}
// The person changed the bar: it is theirs now, and kept.
gs_bar_mine :: (s: [] Site) { s[0].mine[s[0].chat[0].kind] = true; s[0].dirty = true; }
// An item used: from its slot on the bar (what the shared component said the press did), or from the
// palette (pressed once, as if it stood on the bar). The page's state follows.
gs_do :: (s: [] Site, id: string, p: HbPress) {
  c := s[0].chat[..]; k := c[0].blocks[..];
  if p.slot < 0 { return; }
  ids := GS_SHAPE_IDS;
  // (an option chosen: the tool's shape or its mode, and the tool stays picked)
  if id == "shapes" && p.option >= 0 { if p.group == 0 { set := bl_set_shape(k, p.option); } else { set := bl_set_mode(k, 0, p.option - GS_MODE_AT); } }
  else if id == "shapes" { bl_pick(k, p.picked); }
  for q: 0..<BL_SHAPES { if id == ids[q] { if p.picked { set := bl_set_shape(k, q); } bl_pick(k, p.picked); } }
  r := gs_role_item(s, id);
  if r > 0 { put := bl_pick_kind(k, r, p.picked); }
  m := gs_model_of(s, id);
  if m >= 0 {
    // a building item: an option chosen (the rock's kind, or how it places) keeps it picked; else it is picked or put down
    if p.option >= 0 {
      if id == "rock" && p.group == 0 { s[0].rock = p.option; bl_pick_building(k, gs_model_of(s, id), true); }
      else { set := bl_set_mode(k, 1, ifx id == "rock" then p.option - 2 else p.option); bl_pick_building(k, m, true); }
    } else { bl_pick_building(k, m, p.picked); }
  }
  if id == "edit" { bl_mode(k, p.on); }
  if id == "decide" { if c[0].guest { gs_say(s, CH_GUEST); } else { went := ch_decide(c); } }   // (a guest: said in words, and nothing is asked)
  if id == "undo" { s[0].redo = 1; }
  if id == "redo" { s[0].redo = 2; }
  if id == "camera" && p.option >= 0 { ch_cam(c, p.option); }
  else if id == "camera" { s[0].cams = p.on; }
  if id == "world" { s[0].panel = p.on; }
  if id == "reset" { s[0].act += 1; }
  if id == "fly" { s[0].fly += 1; }
  if id == "clear" { gs_things_anew(s, c[0].kind); }
  if id == "type" { s[0].picking = true; s[0].sheet = false; s[0].pal[0].open = false; }
  if id == "unbar" { kind := c[0].kind; s[0].laid[kind] = false; s[0].mine[kind] = false; }
  if id == HB_MORE { if p.on { hb_pal_open(s[0].pal[..], s[0].cat[..]); } else { shut := hb_pal_close(s[0].pal[..]); } }
  c[0].dirty = true; s[0].dirty = true;
}
// A press of a slot of the bar `b` (filled by gs_hot): what the shared component said, done.
gs_hot_press :: (s: [] Site, b: [] Hotbar, p: HbPress) {
  if p.slot < 0 || p.slot >= b[0].n { return; }
  id := b[0].slots[p.slot].id;
  // (the palette's own item list is the catalogue as it stands: filled before it is opened)
  if id == HB_MORE { gs_cat(s, s[0].chat[0].kind, s[0].cat[..]); }
  gs_do(s, id, p);
}
// Item i of the catalogue used from the palette, once, without adding it to the bar: pressed as if it
// stood there alone. The camera, whose menu stands over its own slot, steps on to the next camera.
gs_use :: (s: [] Site, i: int) {
  c := s[0].chat[..]; k := c[0].blocks[..];
  gs_cat(s, c[0].kind, s[0].cat[..]);
  if i < 0 || i >= s[0].cat[0].n { return; }
  one: [1] Hotbar; a := hb_add(one[..], s[0].cat[0].items[i]);
  id := one[0].slots[0].id;
  if id == "camera" { ch_cam(c, (c[0].cam + 1) % GS_CAMS); c[0].dirty = true; s[0].dirty = true; return; }
  ids := GS_SHAPE_IDS;
  lit := k[0].tool != BL_T_NONE && ifx k[0].brush != BL_R_NONE then id == bl_role_word(k[0].brush) else (id == "shapes" || id == ids[k[0].shape]);
  hb_pick(one[..], ifx lit then 0 else -1);
  gs_do(s, id, hb_press(one[..], 0));
}
// The things back as a game type begins: the village green its ball, the meadow its own, a world of its own none.
gs_things_anew :: (s: [] Site, kind: int) {
  c := s[0].chat[..];
  bl_new_level(c[0].blocks[..], gt_web_type(kind), s[0].room);   // what a new game of the type starts with (shared/game-types.coax), the app's too: crates, the room that is up
  c[0].dirty = true;
}
// A drag on the bar or out of the palette, from the glue (docs/web-world.md, "Rearranging"): "move
// FROM TO" (a slot lifted and dropped along the bar), "off FROM" (dropped away from it: taken off,
// still in more), "add ITEM TO" (an item of the palette dropped on the bar). Places are the layout's;
// "more" is never one of them.
gs_drag :: (s: [] Site, text: string) {
  l := gs_lay(s); gs_cat(s, s[0].chat[0].kind, s[0].cat[..]);
  a := bl_word(text, 0); b := bl_word(text, a.hi); d := bl_word(text, b.hi);
  verb := cast(string) text[a.lo..<a.hi];
  xn := bl_read(cast(string) text[b.lo..<b.hi]); yn := bl_read(cast(string) text[d.lo..<d.hi]);
  x := ifx xn.ok then xn.v / 100 else -1; y := ifx yn.ok then yn.v / 100 else -1;
  done := false;
  if verb == "move" { done = hb_lay_move(l, x, y); }
  else if verb == "off" { done = hb_lay_remove(l, x) >= 0; }
  else if verb == "add" && x >= 0 && x < s[0].cat[0].n { done = hb_lay_add(l, y, x); }
  if done { gs_bar_mine(s); s[0].chat[0].dirty = true; }
}
// A number of tenths as text ("1.0", "0.3"), into out.
// The foot of the world: the hotbar in the middle, and over it the panel that is open: the world's
// settings (drawn from the registry: web/props-panel.coax), or the thing selected in edit mode, what
// can be done to it and what it is made of. Hidden with them: what the HUD is told (the tool, the
// mode, the selection, gravity, the camera; then every setting that differs, one a line) and the
// fields the glue writes a tool's edit and a pressed key into.
// The hotbar's state for the HUD (the glue reads the element's text: the tool, edit mode, the selection, the camera,
// the world's own action, flying), and the field the glue writes a key into. The builder's foot's, and a link's page's.
gs_state :: (s: [] Site, t: [] Tree) {
  c := s[0].chat[..]; k := c[0].blocks[..];
  tc: [8192] u8;
  n := bl_state(k, tc[..]); n = bl_put(tc[..], n, " "); n = bl_int(tc[..], n, c[0].cam); n = bl_put(tc[..], n, " "); n = bl_int(tc[..], n, bl_mode_now(k)); n = bl_put(tc[..], n, " "); n = bl_int(tc[..], n, s[0].act); n = bl_put(tc[..], n, " "); n = bl_int(tc[..], n, s[0].fly); n = bl_put(tc[..], n, " "); n = bl_int(tc[..], n, k[0].quarter);
  // (and after its line, the settings that differ: always the line's end, so the HUD knows the rest are as the world starts)
  n = bl_put(tc[..], n, "\n"); n = pr_wire(k[0].props[..], tc[..], n);
  state := tr_leaf(t, "state", TG_SPAN, "gs-state", cast(string) tc[0..<n]);
  tr_attr(t, state, AT_HIDDEN, "true");
  // (crates: which level of its game the room is, of how many, and how many times the level was replaced whole. A
  // link's page plays the one level it was sent: finishing it starts it again)
  if kp_rooms(c[0].kind) > 1 {
    rc: [48] u8; rn := bl_int(rc[..], 0, ifx s[0].playing then 0 else s[0].room); rn = bl_put(rc[..], rn, " "); rn = bl_int(rc[..], rn, ifx s[0].playing then 1 else kp_rooms(c[0].kind)); rn = bl_put(rc[..], rn, " "); rn = bl_int(rc[..], rn, s[0].whole);
    rm := tr_leaf(t, "room", TG_SPAN, "gs-room", cast(string) rc[0..<rn]);
    tr_attr(t, rm, AT_HIDDEN, "true");
  }
  hk := tr_open(t, "hotkey", TG_INPUT, "gs-hotkey"); tr_attr(t, hk, AT_TYPE, "text"); tr_attr(t, hk, AT_HIDDEN, "true"); tr_attr(t, hk, AT_COMPLETE, "off"); tr_close(t);
}
// The publish sheet, over the world (the world stays as it is behind it): the game's name, the one button, and,
// once it is on the web, its link to copy and share, its versions, and the way to take it down.
gs_pub_sheet :: (s: [] Site, t: [] Tree) {
  p := s[0].pub[..]; busy := pb_busy(p);
  tc: [PB_SAID + 64] u8; ida: [UI_ID] u8;
  sheet := tr_open(t, "pubsheet", TG_DIV, "sheet");
  box := tr_open(t, "pub.box", TG_SECTION, "wrap login hud k9 pubbox");
  eye := tr_leaf(t, "pub.e", TG_P, "eye mono", "publish");
  h := tr_leaf(t, "pub.h", TG_H1, "", ifx !p[0].listed && busy then "one moment." else ifx p[0].game > 0 && p[0].on then "it's on the web." else ifx p[0].game > 0 then "it's off the web." else "put it on the web.");
  lede := tr_leaf(t, "pub.l", TG_P, "lede", "anyone with the link plays it in their browser, with no account. your name and email are not shown.");
  form := tr_open(t, "pub.form", TG_DIV, "form");
  fld := tr_open(t, "pub.name.f", TG_DIV, "fld hud k3");
  f := tr_open(t, "pub.name", TG_INPUT, "");
  tr_attr(t, f, AT_TYPE, "text"); tr_attr(t, f, AT_COMPLETE, "off"); tr_attr(t, f, AT_PLACEHOLDER, "name your game"); tr_attr(t, f, AT_LABEL, "Name"); tr_attr(t, f, AT_VALUE, pb_name(p));
  tr_close(t);
  tr_close(t);
  said := tr_leaf(t, "pub.said", TG_P, ifx p[0].bad then "said" else "said fine", cast(string) p[0].said[0..<p[0].said_n]);
  tr_attr(t, said, AT_LIVE, "polite");
  go := tr_leaf(t, "pub.go", TG_BUTTON, "btn hud k4", ifx busy then "..." else ifx p[0].game > 0 && p[0].on then "publish this version" else ifx p[0].game > 0 then "publish again" else "publish");
  if busy { tr_attr(t, go, AT_DISABLED, "true"); }
  if p[0].link_n > 0 && p[0].on {
    // the link: to copy, to hand to the system's share sheet where the browser has one (the glue asks it), and to open
    at := tr_leaf(t, "pub.link", TG_P, "publink gs-link", pb_link(p));
    acts := tr_open(t, "pub.acts", TG_DIV, "pubrow");
    copy := tr_leaf(t, "pub.copy", TG_BUTTON, "quiet", ifx p[0].copied then "copied" else "copy link");
    share := tr_leaf(t, "pub.share", TG_BUTTON, "quiet gs-share", "share");
    open := tr_leaf(t, "pub.open", TG_A, "quiet", "play it"); tr_attr(t, open, AT_HREF, pb_link(p));
    tr_close(t);
  }
  if p[0].game > 0 {
    // its versions, newest first: a press makes that one the one the link plays; and the way to take the link down
    vs := tr_open(t, "pub.vs", TG_DIV, "pubrow");
    digits := [PB_VERS] string.["0", "1", "2", "3", "4", "5"];
    for i: 0..<PB_VERS {
      v := p[0].versions - i;
      if v < 1 { break; }
      n := bl_put(tc[..], 0, "version "); n = bl_int(tc[..], n, v);
      if v == p[0].live { n = bl_put(tc[..], n, ifx p[0].on then ": live" else ": the one it plays"); } else { n = bl_put(tc[..], n, ": make live"); }
      one := tr_leaf(t, tr_cat(ida[..], "pub.v.", digits[i]), TG_BUTTON, ifx v == p[0].live then "quiet on" else "quiet", cast(string) tc[0..<n]);
      tr_attr(t, one, AT_TITLE, "make this version the one the link plays");
      if busy { tr_attr(t, one, AT_DISABLED, "true"); }
    }
    if p[0].on { down := tr_leaf(t, "pub.down", TG_BUTTON, "quiet", "unpublish"); tr_attr(t, down, AT_TITLE, "take the link down at once: publish puts it back at the same link"); if busy { tr_attr(t, down, AT_DISABLED, "true"); } }
    tr_close(t);
  }
  ln := pb_limits(tc[..]);
  fine := tr_leaf(t, "pub.fine", TG_P, "fine", cast(string) tc[0..<ln]);
  tr_close(t);
  tr_close(t);
  shut := tr_leaf(t, "pub.x", TG_BUTTON, "quiet", "keep building");
  tr_close(t);
}
// A published game's page (its link, GS_LINK and a code): the world, played, and one small panel over it: the
// game's name, Remix (a copy in your own builder), the way to the builder, and Report. No build tools, no chat, no
// account. While the game is asked for, or when the link plays nothing, the panel says so in the middle of the page.
gs_play :: (s: [] Site, t: [] Tree) {
  p := s[0].pub[..]; c := s[0].chat[..];
  ida: [UI_ID] u8; tc: [PB_SAID] u8;
  if p[0].play != PL_UP {
    box := tr_open(t, "play", TG_SECTION, "wrap login hud k9");
    eye := tr_leaf(t, "play.e", TG_P, "eye mono", "a game");
    if p[0].play == PL_ASK || p[0].play == PL_GOT { h := tr_leaf(t, "play.h", TG_H1, "", "one moment."); }
    else if p[0].play == PL_FAIL {
      h := tr_leaf(t, "play.h", TG_H1, "", "can't reach the server.");
      l := tr_leaf(t, "play.l", TG_P, "lede", "the game could not be read just now.");
      form := tr_open(t, "play.form", TG_DIV, "form"); again := tr_leaf(t, "play.again", TG_BUTTON, "btn hud k4", "try again"); tr_close(t);
    } else {
      h := tr_leaf(t, "play.h", TG_H1, "", ifx p[0].play == PL_APP then "this page can't show this game." else "this game isn't available.");
      l := tr_leaf(t, "play.l", TG_P, "lede", ifx p[0].play == PL_APP then "it has things only the gamebuilder app plays. you can still make your own here." else "the link is wrong, or its maker took it off the web. you can make your own.");
      form := tr_open(t, "play.form", TG_DIV, "form"); mk := tr_leaf(t, "play.make", TG_A, "btn hud k4", "create a game"); tr_attr(t, mk, AT_HREF, GS_BUILDER); tr_close(t);
    }
    tr_close(t);
    return;
  }
  // the world's wire for the HUD: what stands in it, where you are, and its state (no edit field: nothing here builds)
  ch_wire(c, t); gs_state(s, t);
  bar := tr_open(t, "play", TG_SECTION, "playbar hud k3");
  tr_attr(t, bar, AT_LABEL, "this game");
  name := tr_leaf(t, "play.name", TG_H1, "", pb_title(p));
  by := tr_leaf(t, "play.by", TG_P, "mono", "made with gamebuilder");
  if p[0].swap {
    names := GT_NAME;
    n := bl_put(tc[..], 0, "you have a "); n = bl_put(tc[..], n, names[gt_web_type(c[0].kind)]); n = bl_put(tc[..], n, " game in this browser already. remixing puts this one in its place.");
    ask := tr_leaf(t, "play.ask", TG_P, "", cast(string) tc[0..<n]); tr_attr(t, ask, AT_LIVE, "polite");
    row := tr_open(t, "play.row", TG_DIV, "pubrow");
    yes := tr_leaf(t, "play.swap", TG_BUTTON, "btn", "replace mine"); no := tr_leaf(t, "play.keep", TG_BUTTON, "quiet", "keep mine");
    tr_close(t);
  } else if p[0].reporting {
    ask := tr_leaf(t, "play.ask", TG_P, "", "what is wrong with it? a person reads every report.");
    row := tr_open(t, "play.row", TG_DIV, "pubrow");
    digits := [PB_REASONS] string.["0", "1", "2", "3"]; words := PB_REASON_SAID;
    for r: 0..<PB_REASONS { one := tr_leaf(t, tr_cat(ida[..], "play.r.", digits[r]), TG_BUTTON, "quiet", words[r]); }
    no := tr_leaf(t, "play.r.x", TG_BUTTON, "quiet", "never mind");
    tr_close(t);
  } else {
    row := tr_open(t, "play.row", TG_DIV, "pubrow");
    remix := tr_leaf(t, "play.remix", TG_BUTTON, "btn", ifx p[0].checking then "..." else "remix"); tr_attr(t, remix, AT_TITLE, "open a copy in your own builder: yours to change, kept in your browser");
    mk := tr_leaf(t, "play.make", TG_A, "quiet", "create a game"); tr_attr(t, mk, AT_HREF, GS_BUILDER);
    if !p[0].reported { rep := tr_leaf(t, "play.report", TG_BUTTON, "quiet", "report"); }
    tr_close(t);
  }
  if p[0].note_n > 0 { note := tr_leaf(t, "play.note", TG_P, "", cast(string) p[0].note[0..<p[0].note_n]); tr_attr(t, note, AT_LIVE, "polite"); }
  tr_close(t);
}
gs_foot :: (s: [] Site, t: [] Tree) {
  c := s[0].chat[..]; k := c[0].blocks[..];
  bar: [1] Hotbar; gs_hot(s, bar[..]);
  tc: [8192] u8;
  // (a bar of more than seven slots stands in two rows on a phone: "tall", and the chat stands over both)
  dock := tr_open(t, "dock", TG_DIV, "hotdock");
  if s[0].panel {
    p := tr_open(t, "world", TG_SECTION, "hpanel hprops hud k1");
    tr_attr(t, p, AT_LABEL, "world settings");
    eye := tr_leaf(t, "world.e", TG_SPAN, "mono", "world");
    // how full the world is, live: "things: 12 of 1000" (brighter once it is nearly full)
    cn := bl_count(k, tc[..], 0);
    count := tr_leaf(t, "world.n", TG_SPAN, ifx bl_nearly(k) || k[0].n >= BL_MAX then "fact near" else "fact", cast(string) tc[0..<cn]);
    pp_world(t, k);
    // what was asked for that nothing does yet (an answer routed make): kept to be built
    if c[0].asks > 0 {
      pp_head(t, "p.h.asked", "asked for, not here yet");
      ids := [CH_ASKED] string.["p.a.0", "p.a.1", "p.a.2", "p.a.3", "p.a.4", "p.a.5"];
      for a: 0..<c[0].asks { one := tr_leaf(t, ids[a], TG_SPAN, "asked", cast(string) c[0].asked[a][0..<c[0].asked_n[a]]); }
    }
    tr_close(t);
  }
  i := bl_chosen(k);
  if k[0].editing && i >= 0 && !s[0].panel {
    one := k[0].b[i]; ball := one.kind == BL_BALL; built := one.kind == BL_BUILDING;
    p := tr_open(t, "sel", TG_SECTION, "hpanel hud k1");
    tr_attr(t, p, AT_LABEL, "selected thing");
    n := bl_put(tc[..], 0, "b"); n = bl_int(tc[..], n, one.id);
    name := tr_leaf(t, "sel.id", TG_SPAN, "mono", cast(string) tc[0..<n]);
    sides := [3] string.["w", "d", "h"]; ids0 := [3] string.["sel.w0", "sel.d0", "sel.h0"]; ids1 := [3] string.["sel.w1", "sel.d1", "sel.h1"]; idp := [3] string.["sel.pw", "sel.pd", "sel.ph"]; idv := [3] string.["sel.vw", "sel.vd", "sel.vh"];
    sizes := [3] int.[one.w, one.d, one.h];
    if built {
      // a building: its name, how big it stands and its turn, a quarter turn each way; no sizes (a model stands at its own, at its scale)
      nm := tr_leaf(t, "sel.name", TG_SPAN, "fact", vl_name(one.model));
      n = bl_int(tc[..], 0, one.scale); n = bl_put(tc[..], n, "%"); sc := tr_leaf(t, "sel.scale", TG_SPAN, "fact", cast(string) tc[0..<n]); tr_attr(t, sc, AT_TITLE, "its scale: percent of its model");
      left := tr_leaf(t, "sel.ccw", TG_BUTTON, "", "⟲"); tr_attr(t, left, AT_LABEL, "turn left"); tr_attr(t, left, AT_TITLE, "turn a quarter left");
      n = bl_int(tc[..], 0, one.turn); n = bl_put(tc[..], n, "°"); tv := tr_leaf(t, "sel.turn", TG_SPAN, "fact", cast(string) tc[0..<n]);
      right := tr_leaf(t, "sel.cw", TG_BUTTON, "", "⟳"); tr_attr(t, right, AT_LABEL, "turn right"); tr_attr(t, right, AT_TITLE, "turn a quarter right");
    }
    for a: 0..<(ifx built then 0 else ifx ball then 1 else 3) {
      pair := tr_open(t, idp[a], TG_SPAN, "pair");
      less := tr_leaf(t, ids0[a], TG_BUTTON, "", "−"); tr_attr(t, less, AT_LABEL, ifx ball then "smaller" else ifx a == 0 then "narrower" else ifx a == 1 then "shorter along" else "lower");
      n = bl_put(tc[..], 0, ifx ball then "r" else sides[a]); n = bl_put(tc[..], n, " "); n = bl_num(tc[..], n, ifx ball then one.w / 2 else sizes[a]);
      val := tr_leaf(t, idv[a], TG_SPAN, "fact", cast(string) tc[0..<n]);
      more := tr_leaf(t, ids1[a], TG_BUTTON, "", "+"); tr_attr(t, more, AT_LABEL, ifx ball then "bigger" else ifx a == 0 then "wider" else ifx a == 1 then "longer along" else "taller");
      tr_close(t);
    }
    twin := tr_leaf(t, "sel.dup", TG_BUTTON, "", "⧉"); tr_attr(t, twin, AT_LABEL, "duplicate"); tr_attr(t, twin, AT_TITLE, "duplicate");
    gone := tr_leaf(t, "sel.del", TG_BUTTON, "", "✕"); tr_attr(t, gone, AT_LABEL, "delete"); tr_attr(t, gone, AT_TITLE, "delete (Delete)");
    // what it is made of: the registry's thing rows, as they stand for it
    own := tr_open(t, "sel.p", TG_DIV, "pprops");
    pp_thing(t, k, i);
    tr_close(t);
    tr_close(t);
  }
  // a limit just hit, in words (it goes by itself after a few seconds)
  if s[0].limit_n > 0 { lim := tr_leaf(t, "limit", TG_P, "limit hud k1", cast(string) s[0].limit[0..<s[0].limit_n]); tr_attr(t, lim, AT_LIVE, "polite"); }
  // "more" pressed: every item this world has, over the bar (the catalogue gs_hot filled)
  pal := k_hb_palette(t, "pal", "everything you can do here", s[0].cat[..], gs_lay(s), s[0].pal[..], hb_scifi());
  hot := k_hotbar(t, "hot", "tools", bar[..], hb_scifi());
  gs_state(s, t);
  ed := tr_open(t, "edit", TG_INPUT, "gs-edit"); tr_attr(t, ed, AT_TYPE, "text"); tr_attr(t, ed, AT_HIDDEN, "true"); tr_attr(t, ed, AT_COMPLETE, "off"); tr_close(t);
  // the bar's order, for the glue to keep in this browser ("KIND\nids", or "KIND\ndefault"); the one it kept, read back; a drag
  bn := gs_bar_text(s, tc[..]);
  kept := tr_leaf(t, "barkept", TG_SPAN, "gs-bar", cast(string) tc[0..<bn]); tr_attr(t, kept, AT_HIDDEN, "true");
  bi := tr_open(t, "bar", TG_INPUT, "gs-bar-in"); tr_attr(t, bi, AT_TYPE, "text"); tr_attr(t, bi, AT_HIDDEN, "true"); tr_attr(t, bi, AT_COMPLETE, "off"); tr_close(t);
  dg := tr_open(t, "drag", TG_INPUT, "gs-drag"); tr_attr(t, dg, AT_TYPE, "text"); tr_attr(t, dg, AT_HIDDEN, "true"); tr_attr(t, dg, AT_COMPLETE, "off"); tr_close(t);
  tr_close(t);
}
// Escape: one press clears every passing state of the hotbar at once. The placing tool is put down
// (and its row of options goes with it), edit mode is left and nothing is selected (the HUD lets go
// of a held thing when it is told), and the world's settings shut. What is a setting stays: the
// follow camera, the gravity, a slot's remembered option.
gs_clear :: (s: [] Site) {
  c := s[0].chat[..]; k := c[0].blocks[..];
  bl_mode(k, false);
  if k[0].tool != BL_T_NONE { k[0].tool = BL_T_NONE; k[0].rev += 1; }
  s[0].panel = false; s[0].cams = false; s[0].pal[0].open = false; c[0].dirty = true;
}

// The credits: every work of someone else's the site uses. A row each: what it is and where the
// site uses it, who made it, its licence, and (where the licence asks) what was changed and where
// the changed files are. Links go to the makers, the licence and the files. Anyone may read it,
// logged in or not; the way back is the name in the top bar, or the link here.
GS_CREDITS :: 5;
GsCredit :: struct { name: string; what: string; who: string; who_url: string; licence: string; licence_url: string; changed: string; }
gs_credit_rows :: () -> [GS_CREDITS] GsCredit {
  return [GS_CREDITS] GsCredit.[
    GsCredit.{name = "0 a.d. buildings and rocks", what = "the medieval village: two houses, a market, two rocks, and their textures.",
      who = "Wildfire Games", who_url = "https://www.wildfiregames.com/", licence = "CC BY-SA 3.0", licence_url = "https://creativecommons.org/licenses/by-sa/3.0/",
      changed = "changed: exported to gltf, recentred, packed for the engine, textures resized to 512 and saved as jpeg, normal maps left out, scaled and turned on the page. the changed art is shared under the same licence:"},
    GsCredit.{name = "quaternius character and animations", what = "the figure you run as: an outfit of modular character outfits - fantasy on the universal base characters rig, with clips from the universal animation library. thinned and baked.",
      who = "Quaternius", who_url = "https://quaternius.com/", licence = "CC0 1.0 (public domain)", licence_url = "https://creativecommons.org/publicdomain/zero/1.0/",
      changed = "no credit is required. thank you."},
    GsCredit.{name = "geist and geist mono", what = "the page's typefaces.",
      who = "The Geist Project Authors (Vercel)", who_url = "https://github.com/vercel/geist-font", licence = "SIL Open Font License 1.1", licence_url = "/fonts/Geist-OFL.txt",
      changed = "unchanged."},
    GsCredit.{name = "arwes", what = "the frames round the page's panels: the geometry of arwes's frames, ported to coax.",
      who = "Romel Perez", who_url = "https://arwes.dev/", licence = "MIT", licence_url = "https://github.com/arwes/arwes/blob/main/LICENSE",
      changed = "ported, not copied: the same shapes, drawn by this site's own renderer."},
    GsCredit.{name = "apps sdk ui icons", what = "the small marks on the agents page: a check, a cross, the chevrons, copy, the list's button.",
      who = "OpenAI", who_url = "https://github.com/openai/apps-sdk-ui", licence = "MIT", licence_url = "/build/icons/NOTICE",
      changed = "unchanged."}];
}
gs_credits :: (s: [] Site, t: [] Tree) {
  a: [UI_ID] u8; b: [UI_ID] u8;
  box := tr_open(t, "credits", TG_SECTION, "wrap credits");
  head := tr_open(t, "credits.hd", TG_DIV, "head hud k0");
  eye := tr_leaf(t, "credits.e", TG_P, "eye mono", "credits");
  h := tr_leaf(t, "credits.h", TG_H1, "", "other people's work.");
  tr_close(t);
  lede := tr_leaf(t, "credits.l", TG_P, "lede", "what the site uses that we did not make, who made it, and its licence. everything else is ours.");
  list := tr_open(t, "credits.g", TG_OL, "steps works");
  rows := gs_credit_rows(); nos := [GS_CREDITS] string.["0", "1", "2", "3", "4"]; nums := [GS_CREDITS] string.["01", "02", "03", "04", "05"];
  for k: 0..<GS_CREDITS {
    r := rows[k];
    li := tr_open(t, tr_cat(a[..], "credit.", nos[k]), TG_LI, "step hud k3");
    no := tr_leaf(t, tr_cat(b[..], "credit.n.", nos[k]), TG_SPAN, "no", nums[k]);
    body := tr_open(t, tr_cat(b[..], "credit.b.", nos[k]), TG_DIV, "");
    name := tr_leaf(t, tr_cat(b[..], "credit.h.", nos[k]), TG_H3, "", r.name);
    what := tr_leaf(t, tr_cat(b[..], "credit.p.", nos[k]), TG_P, "", r.what);
    by := tr_open(t, tr_cat(b[..], "credit.by.", nos[k]), TG_P, "mono by");
    w0 := tr_leaf(t, tr_cat(b[..], "credit.w0.", nos[k]), TG_SPAN, "", "by ");
    who := tr_leaf(t, tr_cat(b[..], "credit.who.", nos[k]), TG_A, "", r.who); tr_attr(t, who, AT_HREF, r.who_url);
    w1 := tr_leaf(t, tr_cat(b[..], "credit.w1.", nos[k]), TG_SPAN, "", ". licence: ");
    lic := tr_leaf(t, tr_cat(b[..], "credit.lic.", nos[k]), TG_A, "", r.licence); tr_attr(t, lic, AT_HREF, r.licence_url);
    tr_close(t);
    ch := tr_open(t, tr_cat(b[..], "credit.c.", nos[k]), TG_P, "mono by");
    c0 := tr_leaf(t, tr_cat(b[..], "credit.c0.", nos[k]), TG_SPAN, "", r.changed);
    if k == 0 {
      // the changed art itself, the note of what was changed, and the tool that made the pack: public files of the site
      f1 := tr_leaf(t, "credit.f.pack", TG_A, "", "the pack"); tr_attr(t, f1, AT_HREF, "/assets/village.pack");
      f2 := tr_leaf(t, "credit.f.note", TG_A, "", "the note"); tr_attr(t, f2, AT_HREF, "/assets/village-credits.txt");
      f3 := tr_leaf(t, "credit.f.tool", TG_A, "", "the tool"); tr_attr(t, f3, AT_HREF, "/assets/village-pack.coax");
    }
    tr_close(t);
    tr_close(t);
    tr_close(t);
  }
  tr_close(t);
  back := tr_leaf(t, "home", TG_A, "quiet", ifx s[0].login[0].step == LG_IN || s[0].was_world then "back to the world" else "back");
  tr_attr(t, back, AT_HREF, "/");
  tr_close(t);
}
// The game type picker: the ring of portals, as on the home page (home.coax gs_ring_section: the heading and the
// types' names, which stand over their portals once the world is up), the one picked last lit, and, logged in and
// opened by the button by your icon, "your games". A hidden field takes the type this browser picked before (the
// glue's: a convenience, never needed).
gs_picker :: (s: [] Site, t: [] Tree) {
  gs_ring_section(t, s[0].gpu, s[0].last, "pick");
  keep := tr_open(t, "last", TG_INPUT, "gs-last");
  tr_attr(t, keep, AT_TYPE, "text"); tr_attr(t, keep, AT_HIDDEN, "true"); tr_attr(t, keep, AT_COMPLETE, "off");
  tr_close(t);
  if s[0].mine_open { gs_mine(s, t); }
}
// "your games", over the ring for someone logged in who opened it: the games on their account (web/account.coax),
// each with its type. One this page builds is a button that opens it here; one the app plays says so.
gs_mine :: (s: [] Site, t: [] Tree) {
  ac := s[0].acct[..];
  if s[0].login[0].step != LG_IN { return; }
  a: [UI_ID] u8; b: [UI_ID] u8; no: [8] u8; line: [AC_TITLE + 64] u8; names := GT_NAME;
  box := tr_open(t, "mine", TG_DIV, "mine yours");
  eye := tr_leaf(t, "mine.e", TG_P, "eye mono", "your games");
  if s[0].limit_n > 0 { lim := tr_leaf(t, "mine.s", TG_P, "lede", cast(string) s[0].limit[0..<s[0].limit_n]); tr_attr(t, lim, AT_LIVE, "polite"); }
  else if !ac[0].listed { w := tr_leaf(t, "mine.w", TG_P, "lede", "one moment."); }
  else if ac[0].games_n == 0 { w := tr_leaf(t, "mine.w", TG_P, "lede", "none on your account yet. build one and it is kept there."); }
  for i: 0..<ac[0].games_n {
    g := ac[0].games[i];
    nn := bl_int(no[..], 0, i);
    n := bl_put(line[..], 0, cast(string) ac[0].games[i].title[0..<g.title_n]);
    if g.kind >= 0 {
      n = bl_put(line[..], n, " · "); n = bl_put(line[..], n, names[gt_web_type(g.kind)]);
      here := ac[0].link[g.kind].game == g.game;
      if here { n = bl_put(line[..], n, " · in this browser"); }
      one := tr_leaf(t, tr_cat(a[..], "game.", cast(string) no[0..<nn]), TG_BUTTON, "quiet game", cast(string) line[0..<n]);
    } else {
      n = bl_put(line[..], n, " · in the app");
      one := tr_leaf(t, tr_cat(a[..], "game.x.", cast(string) no[0..<nn]), TG_P, "game app", cast(string) line[0..<n]);
    }
  }
  if ac[0].more > 0 { n := bl_put(line[..], 0, "and "); n = bl_int(line[..], n, ac[0].more); n = bl_put(line[..], n, " more: this page lists "); n = bl_int(line[..], n, AC_GAMES); n = bl_put(line[..], n, "."); w := tr_leaf(t, "mine.m", TG_P, "lede", cast(string) line[0..<n]); }
  tr_close(t);
}
// The builder can't run in this browser: what is wrong and what to do, in the site's words (web/gpu-words.coax).
gs_nogpu :: (s: [] Site, t: [] Tree) {
  box := tr_open(t, "nogpu", TG_SECTION, "wrap login nogpu");
  eye := tr_leaf(t, "nogpu.e", TG_P, "eye mono", gw_name(s[0].gpu));
  h := tr_leaf(t, "nogpu.h", TG_H1, "", GW_HEAD);
  w := tr_leaf(t, "nogpu.w", TG_P, "lede", gw_words(s[0].gpu));
  d := tr_leaf(t, "nogpu.d", TG_P, "lede", gw_do(s[0].gpu));
  tr_close(t);
}
// The world shown is a kept one come back (true), or a new one (false): a kept world comes up settled,
// with no entrance. The seam a restore uses (issue 13's kept game on reload): say it before the world
// is shown; picking a type in the picker says it is a new one again.
gs_still :: (s: [] Site, on: bool) { if s[0].still != on { s[0].still = on; s[0].dirty = true; } }
// What a game type stands on: 0 the meadow with its starting things, 1 the village green, 2 a world of its own (nothing of the page's).
gs_ground :: (kind: int) -> int { return ifx kind >= GS_OWN then 2 else ifx kind == GS_VILLAGE then 1 else 0; }
// Which game type an id of the picker's names ("kind.2", or a part of that button: "kind.h.2"): -1, none.
gs_kind_of :: (id: string) -> int {
  if id.count < 6 || cast(string) id[0..<5] != "kind." { return -1; }
  k := cast(int) id[id.count - 1] - cast(int) '0';
  return ifx k >= 0 && k < GS_KINDS then k else -1;
}

// The type an address of the builder's chose ("/play?type=racing": shared/game-types.coax GT_ID) as a website kind: -1, none.
gs_type_asked :: (path: string) -> int {
  q := -1;
  for i: 0..<path.count { if path[i] == '?' { q = i; break; } }
  if q < 0 { return -1; }
  at := q + 1;
  while at < path.count {
    end := at; while end < path.count && path[end] != '&' && path[end] != '#' { end += 1; }
    part := cast(string) path[at..<end];
    if part.count > 5 && cast(string) part[0..<5] == "type=" { return gt_web_kind(gt_of(cast(string) part[5..<part.count])); }
    if end < path.count && path[end] == '#' { break; }
    at = end + 1;
  }
  return -1;
}

// ---------------------------------------------------------------- the face's calls

// One frame: builds and flushes if something changed or is entering. Bytes of commands to apply.
// Platform input: the shared browser entropy adapter provides the nonce.
gs_entropy :: (s:[]Site,bytes:[]u8,ok:bool) #export_c #effects(all) {if s.count>0 {ch_job_entropy(s[0].chat[..],bytes,ok);ac_entropy(s[0].acct[..],bytes,ok);}}
gs_frame :: (s: [] Site, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready {
    n := mono_frames(s[0].sets[..]);
    s[0].ready = true; s[0].dirty = true;
    lg_begin(s[0].login[..]);
    // the game kept in this browser is asked for as the page opens, whoever is here
    n = bl_put(s[0].ns[..], 0, KP_NS);
    kp_boot(s[0].keep[..]); s[0].boot = GS_B_ASK; s[0].boot_at = 0;
  }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  // frames a second: counted over half a second of real time, and the corner's number changes only when the count does
  // (a frame run at once after a press, a few microseconds on, is not a frame drawn: those are not counted)
  if dt >= 0.002 {
    s[0].fps_t += dt; s[0].fps_n += 1;
    if s[0].fps_t >= 0.5 {
      now := cast(int) (cast(f32) s[0].fps_n / s[0].fps_t + 0.5);
      if now != s[0].fps && s[0].view == GS_WORLD_VIEW && !s[0].picking { s[0].dirty = true; }
      s[0].fps = now; s[0].fps_t = 0; s[0].fps_n = 0;
    }
  }
  if s[0].login[0].dirty { s[0].login[0].dirty = false; s[0].dirty = true; }
  if s[0].chat[0].dirty { s[0].chat[0].dirty = false; s[0].dirty = true; }
  gs_tally(s);
  if s[0].count[0].dirty { s[0].count[0].dirty = false; s[0].dirty = true; }
  if s[0].limit_n > 0 && s[0].time >= s[0].limit_till { s[0].limit_n = 0; s[0].dirty = true; }
  ch_job_tick(s[0].chat[..], s[0].time);   // (a build agent at work is read every two seconds)
  if s[0].view == GS_AGENTS_VIEW { gs_agents_tick(s); }   // (and /agents' agents at work: web/agents.coax)
  gs_here(s);
  // the kept game: an answer that takes too long is not waited for (the picker shows; a picked type stays as it opened)
  if s[0].boot != GS_B_DONE && s[0].time >= s[0].boot_at + KP_BOOT_WAIT { kp_give_up(s[0].keep[..]); s[0].boot = GS_B_DONE; s[0].dirty = true; }
  if s[0].boot == GS_B_DONE && s[0].keep[0].opening >= 0 && s[0].time >= s[0].open_at + KP_BOOT_WAIT { kp_give_up(s[0].keep[..]); }
  // and what is built is written as it changes, while the world is up
  if s[0].game && s[0].view == GS_WORLD_VIEW && !s[0].picking && !s[0].playing { kp_tick(s[0].keep[..], s[0].chat[0].blocks[..], gs_slot(s), s[0].time); }
  if s[0].chat[0].seed == 0 { s[0].chat[0].seed = 1 + cast(int) (s[0].time * 100000); bl_start(s[0].chat[0].blocks[..]); }
  gs_acct(s); gs_pub(s);
  // a type the address asked for (a name of the ring's, pressed): entered once the world is up and the kept game has been asked for
  if s[0].want >= 0 && s[0].view == GS_WORLD_VIEW && !s[0].playing && s[0].boot == GS_B_DONE {
    w := s[0].want; s[0].want = -1;
    if w < GS_KINDS { gs_pick(s, w); }
    s[0].dirty = true; gs_tally(s);
  }
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..];
  if !d[0].styled {
    n := gs_css(s[0].css[..], 0);
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  gs_build(s);
  ui_end(s[0].ui[..]);
  s[0].animating = s[0].ui[0].busy;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }
  return bytes;
}
// Whether a game is up with nothing of it still being read from this browser: what the account may be asked about.
// (a published game being played is not the visitor's game: the account is never asked about it)
// Which of this browser's kept levels the world that is up is (keep.coax's slots: the type's, or a later room of crates').
gs_slot :: (s: [] Site) -> int { return kp_slot(s[0].chat[0].kind, s[0].room); }
gs_up :: (s: [] Site) -> bool { return s[0].game && !s[0].playing && s[0].view == GS_WORLD_VIEW && !s[0].picking && s[0].boot == GS_B_DONE && s[0].keep[0].opening < 0; }
// Publishing's part of a frame or an event (web/publish.coax): a guest who pressed publish and has logged in gets the
// sheet; a publish waits on the account's save; one that went through is counted; and a link's page puts the game it
// was sent in the world.
gs_pub :: (s: [] Site) {
  p := s[0].pub[..]; c := s[0].chat[..]; k := s[0].keep[..];
  in := s[0].login[0].step == LG_IN;
  was := p[0].phase; had := p[0].play;
  if s[0].playing {
    if p[0].play == PL_GOT {
      // the published level is the world: its type entered as picked, and its file read over it
      bl_reset(c[0].blocks[..]); gs_enter(s, p[0].kind, false);
      shown := lv_read(c[0].blocks[..], k[0].st[..], cast(string) p[0].file[0..<p[0].file_n]);
      if !shown { bl_new(c[0].blocks[..], gt_web_type(p[0].kind)); }
      pb_play_took(p, shown, s[0].time);
    }
    // Remix asked this browser for its own game of the type, and the answer never came: there is none to keep
    if p[0].checking && k[0].opening < 0 { p[0].checking = false; gs_remix(s); }
    // the game counted (shared/plays.coax): opened, and played a minute
    pb_fact_tick(p, s[0].time, ct_may(s[0].count[..]));
    if p[0].play != had || p[0].phase != was { s[0].dirty = true; }
    return;
  }
  world := s[0].view == GS_WORLD_VIEW && !s[0].picking;
  // the login ended under a publish, or there was none: the account sheet, and the publish sheet again after it
  if p[0].login { p[0].login = false; if !in && world { p[0].open = false; p[0].after = true; s[0].sheet = true; } s[0].dirty = true; }
  if p[0].after && in && world { pb_open(p, c[0].kind); s[0].dirty = true; }
  if p[0].after && !in && !s[0].sheet { p[0].after = false; }   // (they shut the account sheet: nothing more is asked)
  if p[0].open && !world { pb_close(p); }
  pb_tick(p, s[0].acct[..], k[0].st[..], c[0].blocks[..], c[0].kind, s[0].time, in, gs_up(s));
  if p[0].done { p[0].done = false; gs_count(s, LP_PUBLISHED); }
  pb_fact_tick(p, s[0].time, ct_may(s[0].count[..]));   // (Remix pressed on a link's page: counted from the builder it led to)
  if p[0].phase != was { s[0].dirty = true; }
}
// A link's page is left for the builder: the world is the visitor's again. The game kept in this browser is read back
// as when the page opens (or the picker shows, when there is none).
gs_play_leave :: (s: [] Site) {
  p := s[0].pub[..]; k := s[0].keep[..];
  s[0].playing = false; p[0].play = PL_NONE; p[0].swap = false; p[0].checking = false; p[0].reporting = false;
  s[0].game = false; s[0].still = false; s[0].view = GS_HOME_VIEW; s[0].dirty = true;
  bl_reset(s[0].chat[0].blocks[..]); un_forget(s[0].undo[..]);
  if k[0].kept >= 0 && kp_open(k, k[0].kept) { s[0].boot = GS_B_LEVEL; s[0].boot_at = s[0].time; } else { s[0].boot = GS_B_DONE; }
}
// Remix: the game being played becomes a game of the visitor's own, in their own builder (a guest's, kept in their
// browser; logged in, kept on their account as a new game). It is never the creator's: nothing of theirs changes.
// A game of this type the visitor already keeps here is asked about first, and never replaced without a yes.
gs_remix :: (s: [] Site) {
  p := s[0].pub[..]; c := s[0].chat[..]; k := s[0].keep[..]; a := s[0].acct[..];
  kind := c[0].kind;
  if p[0].play != PL_UP || kind < 0 || kind >= GS_KINDS { return; }
  pb_fact(p, PY_REMIX);
  s[0].playing = false; p[0].play = PL_NONE; p[0].swap = false; p[0].checking = false; p[0].reporting = false; p[0].note_n = 0;
  // a new game: whatever this browser had linked to an account for the type is left where it is, on the account
  s[0].room = 0; ac_forget_game(a, kind);
  // and where it came from is kept beside it, to be said when it is published (web/publish.coax)
  ac_from_set(a, kind, pb_code(p));
  s[0].game = true; s[0].still = true; k[0].restored = true; un_forget(s[0].undo[..]);
  kp_game(k, kind); kp_write(k, c[0].blocks[..], kind);
  gs_count(s, LP_REMIX);
  // the builder's address (logged in, the settling makes it the home page's)
  s[0].asked_play = true;
  s[0].go_n = 0; for ch: GS_BUILDER { s[0].go[s[0].go_n] = ch; s[0].go_n += 1; }
  gs_say(s, "this copy is yours now: build on it. it is kept in this browser.");
  c[0].dirty = true; s[0].dirty = true;
}
// What happens on a link's page: the panel's buttons, and the few things the glue says (the keys' R, where you are).
gs_play_event :: (s: [] Site, kind: int, id: string, n: int) {
  p := s[0].pub[..]; c := s[0].chat[..]; k := s[0].keep[..];
  if kind == GS_INPUT {
    if id == "count" { if cast(string) s[0].inbox[0..<n] == "left" { ct_left(s[0].count[..]); } else { ct_told(s[0].count[..], cast(string) s[0].inbox[0..<n]); } }
    else if id == "gpu" { s[0].gpu = gw_way(cast(string) s[0].inbox[0..<n]); }
    else if p[0].play != PL_UP { }
    else if id == "where" { bl_you(c[0].blocks[..], cast(string) s[0].inbox[0..<n]); }
    else if id == "things" { moved := bl_things(c[0].blocks[..], cast(string) s[0].inbox[0..<n]); }
    else if id == "note" { ch_note(c, cast(string) s[0].inbox[0..<n]); }
    // R: a world's own action (crates resets its room, a race starts again), as in the builder; no other key builds anything here
    else if id == "hotkey" && cast(string) s[0].inbox[0..<n] == "r" && c[0].kind >= GS_OWN { s[0].act += 1; c[0].dirty = true; }
    return;
  }
  if kind != GS_CLICK { return; }
  if id == "play.again" { pb_play_ask(p); }
  else if id == "play.make" || id == "play.create" || id == "brand" {
    // the builder (the name: the home page, for a guest), with the visitor's own game
    home := id == "brand" && s[0].login[0].step != LG_IN;
    gs_play_leave(s);
    if home { gs_show(s, GS_HOME_VIEW, true); }
    else { s[0].asked_play = true; s[0].go_n = 0; for ch: GS_BUILDER { s[0].go[s[0].go_n] = ch; s[0].go_n += 1; } }
  }
  else if p[0].play != PL_UP { }
  else if id == "play.remix" {
    // this browser's own game of the type, if it keeps one, is asked for first: it is not replaced without a yes
    if !p[0].checking && k[0].state == KP_ON && kp_open(k, c[0].kind) { p[0].checking = true; s[0].open_at = s[0].time; }
    else if !p[0].checking { gs_remix(s); }
  }
  else if id == "play.swap" { gs_remix(s); }
  else if id == "play.keep" { p[0].swap = false; }
  else if id == "play.report" { p[0].reporting = true; p[0].note_n = 0; }
  else if id == "play.r.x" { p[0].reporting = false; }
  else if id.count == 8 && cast(string) id[0..<7] == "play.r." && id[7] >= '0' && id[7] <= '3' { pb_report(p, cast(int) (id[7] - '0')); }
}
// The account's part of a frame or an event (web/account.coax): its pass moved on, its record written to this
// browser when it changed, what it has to say said over the hotbar, and a world it replaced taken as a kept one come back.
gs_acct :: (s: [] Site) {
  a := s[0].acct[..]; c := s[0].chat[..]; k := s[0].keep[..];
  in := s[0].login[0].step == LG_IN;
  // (a browser whose storage never answered has no record: the account is asked all the same)
  if !a[0].loaded && s[0].boot == GS_B_DONE && k[0].state == KP_OFF { ac_record_read(a, ""); }
  // (the loop's count of "made an account or logged in" is the code's taking: gs_event, LP_ACCOUNT)
  if in && !s[0].was_in { ac_wake(a); }
  s[0].was_in = in;
  // the picker asks for the account's games as it opens
  listing := in && s[0].picking && s[0].view == GS_WORLD_VIEW;
  if listing && !s[0].listed { ac_list(a); }
  s[0].listed = listing;
  was := a[0].state; had := a[0].listed;
  ac_tick(a, c[0].blocks[..], gs_slot(s), s[0].time, in, gs_up(s));
  if a[0].link_dirty && a[0].loaded {
    a[0].link_dirty = false;
    rec: [KP_LINK] u8; n := ac_record_write(a, rec[..]);
    if !kp_link(k, rec[0..<n]) { ac_linked(a); }
  }
  if a[0].pulled {
    // the account's copy is the world now: a kept one come back (settled, no entrance), and undo starts from it
    a[0].pulled = false; s[0].whole += 1; k[0].restored = true; s[0].still = true; un_forget(s[0].undo[..]); c[0].dirty = true; s[0].dirty = true;
  }
  if a[0].made {
    // a game's first write to the account is done: the loop's step (shared/loop.coax; issue 18's count)
    a[0].made = false; gs_count(s, LP_KEPT);
  }
  if a[0].said_n > 0 { s[0].limit_n = ac_take(a, s[0].limit[..]); s[0].limit_till = s[0].time + GS_LIMIT_SHOWN * 2; s[0].dirty = true; }
  if a[0].state != was || a[0].listed != had { s[0].dirty = true; }
  // a game /agents' link opens: found among the account's games once they are listed, it opens as one picked in the picker does
  if s[0].to_game > 0 && listing && a[0].listed {
    game := s[0].to_game; s[0].to_game = 0;
    for i: 0..<a[0].games_n { if a[0].games[i].game == game { to := ac_open(a, i); if to >= 0 { gs_pick(s, to); } break; } }
  }
}
// (the world asks for every frame while it is up, so the corner's frames a second count the frames
// the world draws; a frame with nothing changed builds nothing)
gs_busy :: (s: [] Site) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating || s[0].login[0].dirty || s[0].chat[0].dirty || s[0].count[0].dirty || (s[0].view == GS_WORLD_VIEW && !s[0].picking) || (s[0].view == GS_AGENTS_VIEW && ga_ticks(s[0].ag[..]))); }
// Shows one of the site's pages and asks the face to put its address in the bar.
gs_show :: (s: [] Site, view: int, push: bool) {
  // coming to the world, you pick a game type first (back from the credits you are where you were: the type you had, or the picker)
  // (and with a game up, a picked one or the one kept in this browser, you are in it: the picker is "game type" away)
  if view == GS_WORLD_VIEW && s[0].view != GS_WORLD_VIEW && !(s[0].view == GS_CREDITS_VIEW && s[0].was_world) && !s[0].game { s[0].picking = true; }
  // leaving the world: what is built is written now, not a moment on
  if view != GS_WORLD_VIEW && s[0].view == GS_WORLD_VIEW { if s[0].game && !s[0].picking && !s[0].playing { kp_write(s[0].keep[..], s[0].chat[0].blocks[..], gs_slot(s)); } s[0].sheet = false; pb_close(s[0].pub[..]); }
  if view == GS_CREDITS_VIEW && s[0].view != GS_CREDITS_VIEW { s[0].was_world = s[0].view == GS_WORLD_VIEW; }
  // the command line's part of the login is /login/cli's alone: leaving it forgets any code it showed
  if view != GS_CLI_VIEW { lg_cli_forget(s[0].login[..]); s[0].clip_n = 0; }
  // /agents reads your agents afresh each time it is shown: the conversation that was up comes up again
  if view == GS_AGENTS_VIEW { ga_fresh(s[0].ag[..]); }
  s[0].login[0].cli = view == GS_CLI_VIEW;
  s[0].view = view; s[0].dirty = true;
  paths := GS_PATHS;
  // (the world's address: / for someone logged in, the builder's for anyone else)
  path := ifx view == GS_WORLD_VIEW && s[0].login[0].step != LG_IN then GS_BUILDER else paths[view];
  if push { s[0].go_n = 0; for c: path { s[0].go[s[0].go_n] = c; s[0].go_n += 1; } }
}
// Who is here, for the chat: only someone logged in talks to the agent (web/chat.coax).
gs_here :: (s: [] Site) {
  step := s[0].login[0].step;
  ch_guest(s[0].chat[..], step != LG_IN);   // the agent is for accounts: nothing a guest types is sent (chat.coax, issue 15)
  // (while the login is still asking who is here, the chat's box is not yet the guest's words: a moment, for someone who is logged in)
  if s[0].chat[0].asking != (step == LG_CHECKING) { s[0].chat[0].asking = step == LG_CHECKING; s[0].dirty = true; }
}
// A game type entered: its world as a new game of the type opens, unless `carry` (the meadow's four types share
// the meadow's things, as ever). The bounds, the kinds and the camera are the type's.
gs_enter :: (s: [] Site, kind: int, carry: bool) {
  c := s[0].chat[..];
  s[0].room = 0;
  if !carry { bl_new(c[0].blocks[..], gt_web_type(kind)); }
  if gs_ground(kind) == 2 { bl_reset(c[0].blocks[..]); s[0].panel = false; }
  c[0].kind = kind; ch_bounds(c); ch_cam(c, gs_cam_of(kind)); s[0].cams = false; c[0].note_n = 0; s[0].last = kind; s[0].picking = false;
  s[0].game = true; s[0].keep[0].restored = false; s[0].still = false; un_forget(s[0].undo[..]); c[0].dirty = true; s[0].dirty = true;
}
// A game type's kept level and settings, read from this browser (keep.coax: KP_E_OPEN), put in the world that is up
// as that type. A level that is no level is not used: the type's new game stands. True when the kept level is up.
gs_kept_in :: (s: [] Site) -> bool {
  c := s[0].chat[..]; k := s[0].keep[..]; b := c[0].blocks[..];
  if k[0].got_n == 0 { return false; }
  if !lv_read(b, k[0].st[..], cast(string) k[0].got[0..<k[0].got_n]) { bl_new_level(b, gt_web_type(c[0].kind), s[0].room); return false; }
  s[0].whole += 1;
  if k[0].got_set_n > 0 && lv_settings_read(b, cast(string) k[0].got_set[0..<k[0].got_set_n]) { ch_tuned(c); }
  k[0].restored = true; s[0].still = true; un_forget(s[0].undo[..]); c[0].dirty = true; s[0].dirty = true;
  // (a level kept here before this browser had the account's record was built here: it is a game worth keeping)
  if s[0].acct[0].legacy { ac_built(s[0].acct[..], gs_slot(s)); }
  return true;
}
// What a storage reply came to (keep.coax's KP_E_*), done.
gs_kept :: (s: [] Site, what: int) {
  c := s[0].chat[..]; k := s[0].keep[..];
  if what == KP_E_GAME {
    // the first answer: a game is kept here, and nobody has picked a type meanwhile: its level is read, and then it is up
    s[0].dirty = true;
    if s[0].playing { s[0].boot = GS_B_DONE; return; }   // (a link's page plays the link's game: this browser's own waits for the builder)
    if s[0].boot != GS_B_ASK { return; }
    if k[0].kept >= 0 && kp_open(k, k[0].kept) { s[0].boot = GS_B_LEVEL; s[0].boot_at = s[0].time; } else { s[0].boot = GS_B_DONE; }
  } else if what == KP_E_OPEN && s[0].playing {
    // Remix asked what this browser keeps of the type: a game built here is asked about, anything less is no loss
    p := s[0].pub[..]; a := s[0].acct[..];
    if s[0].boot == GS_B_LEVEL { s[0].boot = GS_B_DONE; }
    if p[0].checking {
      p[0].checking = false;
      mine := k[0].got_n > 0 && (!a[0].loaded || a[0].legacy || a[0].link[c[0].kind].built || a[0].link[c[0].kind].level > 0);
      if mine { p[0].swap = true; s[0].dirty = true; } else { gs_remix(s); }
    }
  } else if what == KP_E_OPEN {
    if s[0].boot == GS_B_LEVEL {
      // the kept game comes up: its type entered, as picked, and its level over it
      s[0].boot = GS_B_DONE;
      bl_reset(c[0].blocks[..]); gs_enter(s, k[0].opened, false);
      up := gs_kept_in(s);
    } else if s[0].game && k[0].opened == gs_slot(s) && !un_can_undo(s[0].undo[..]) {
      // a type just picked has a level kept here: it is the world (nothing has been built on the new one yet)
      up := gs_kept_in(s);
    }
  } else if what == KP_E_FAILED {
    // not kept, in words with the number (the corner's note stays for as long as it is so)
    s[0].limit_n = kp_words(k, s[0].limit[..], 0); s[0].limit_till = s[0].time + GS_LIMIT_SHOWN * 2; s[0].dirty = true;
  } else if what == KP_E_KEPT { s[0].dirty = true; }
  else if what == KP_E_LINK {
    ac_record_read(s[0].acct[..], cast(string) k[0].got_link[0..<k[0].got_link_n]);
    if s[0].acct[0].legacy && k[0].restored && s[0].game { ac_built(s[0].acct[..], gs_slot(s)); }
  } else if what == KP_E_LINKED { ac_linked(s[0].acct[..]); }
}
// Undo (1) or redo (2), as a key or a hotbar item asked: the step taken, or said in words that there is none.
gs_redo :: (s: [] Site, which: int) {
  c := s[0].chat[..]; u := s[0].undo[..]; b := c[0].blocks[..];
  done := ifx which == 2 then un_redo(u, b) else un_undo(u, b);
  if done { ch_tuned(c); c[0].dirty = true; s[0].limit_n = 0; ac_built(s[0].acct[..], gs_slot(s)); }
  else { s[0].limit_n = un_words(u, which == 2, s[0].limit[..], 0); s[0].limit_till = s[0].time + GS_LIMIT_SHOWN; }
  s[0].dirty = true;
}
// Where being logged in or not puts you. Logged in, every address is the world: the home page
// and the login give way to it. Not logged in, the world is still yours at the builder's address
// (a guest builds with every tool: docs/web-world.md, "A guest"); logging out goes to the home page.
gs_settle :: (s: [] Site) {
  step := s[0].login[0].step;
  gs_here(s);
  // logged out: the conversation is forgotten. The game built is not: it is in this browser, and "create a game" is it again
  if s[0].left && (step == LG_ASK_EMAIL || step == LG_ASK_CODE) {
    s[0].left = false;
    ch_forget(s[0].chat[..]); gs_clear(s); s[0].limit_n = 0;
    if s[0].view == GS_WORLD_VIEW || s[0].view == GS_AGENTS_VIEW { gs_show(s, GS_HOME_VIEW, true); }
    s[0].asked_play = false;
    return;
  }
  if s[0].view == GS_CLI_VIEW { return; }   // logged in or not, /login/cli stays: logged in is when it is used
  // /agents is yours: logged out, the login, and back here once you are in
  if s[0].view == GS_AGENTS_VIEW {
    if step == LG_ASK_EMAIL || step == LG_ASK_CODE { s[0].to_agents = true; gs_show(s, GS_LOGIN_VIEW, true); }
    return;
  }
  if s[0].to_agents && step == LG_IN && s[0].view == GS_LOGIN_VIEW { s[0].to_agents = false; gs_show(s, GS_AGENTS_VIEW, true); return; }
  // the builder's address is the world for anyone, at once: who is here changes only what the chat says
  if s[0].asked_play && s[0].view != GS_WORLD_VIEW { gs_show(s, GS_WORLD_VIEW, false); }
  if s[0].view == GS_CREDITS_VIEW { return; }   // the credits are anyone's: being logged in or not moves nothing
  if step == LG_IN && (s[0].view != GS_WORLD_VIEW || s[0].asked_play || s[0].sheet) {
    // the address changes only when it was not already the home page's (a guest who logged in over the world is at / now)
    gs_show(s, GS_WORLD_VIEW, s[0].view == GS_LOGIN_VIEW || s[0].asked_play || s[0].sheet);
    s[0].asked_play = false; s[0].sheet = false;
  }
  if step == LG_ASK_EMAIL || step == LG_ASK_CODE { s[0].asked_play = false; }   // a guest at the builder's address stays: the world is theirs to build
}
// The game on your account this world is, for the chat: yes to its offer starts a cloud Builder on it
// (web/chat.coax ch_job_start; issue 7), its limits in the record module's words. 0 for a guest, or a
// world not on the account yet.
gs_cloud_game :: (s: [] Site) {
  c := s[0].chat[..]; k := c[0].kind;
  c[0].cloud_game = ifx s[0].login[0].step == LG_IN && k >= 0 && k < GT_WEB_TYPES then cast(s32) s[0].acct[0].link[k].game else 0;
  if c[0].cloud_words_n == 0 { c[0].cloud_words_n = agr_cloud_words(c[0].cloud_words[..]).count; }
}
// The next request for the face, when nothing is with the host: the login's first, then the chat's, then the build agent's.
gs_queue :: (s: [] Site) {
  l := s[0].login[..]; c := s[0].chat[..]; k := s[0].count[..];
  // a count never holds the wire from the login, the chat or the account's save: one that waits takes it (the host ends the count's
  // request and says nothing more of it; whether it was counted is nothing to the page)
  if s[0].flight == GS_COUNT_ASKS && !s[0].req_ready && (lg_wants(l) || ch_wants(c) || ch_job_wants(c) || ac_wants(s[0].acct[..]) || pb_wants(s[0].pub[..]) || (s[0].view == GS_AGENTS_VIEW && ga_wants(s[0].ag[..]))) { ct_end(k, 0); s[0].flight = GS_NOBODY; }
  if s[0].flight != GS_NOBODY { return; }
  if lg_wants(l) {
    lg_sent(l);
    s[0].req_url_n = l[0].url_n; for i: 0..<l[0].url_n { s[0].req_url[i] = l[0].url[i]; }
    s[0].req_body_n = l[0].body_n; for i: 0..<l[0].body_n { s[0].req_body[i] = l[0].body[i]; }
    s[0].flight = GS_LOGIN_ASKS; s[0].req_ready = true;
  } else if ch_wants(c) {
    ch_sent(c);
    s[0].req_url_n = 0; for ch: CH_DOOR { s[0].req_url[s[0].req_url_n] = ch; s[0].req_url_n += 1; }
    s[0].req_body_n = c[0].body_n; for i: 0..<c[0].body_n { s[0].req_body[i] = c[0].body[i]; }
    s[0].flight = GS_CHAT_ASKS; s[0].req_ready = true;
  } else if s[0].view == GS_AGENTS_VIEW && s[0].login[0].step == LG_IN && ga_wants(s[0].ag[..]) {
    g := s[0].ag[..];
    s[0].req_url_n = 0; for ch: ga_door(g) { s[0].req_url[s[0].req_url_n] = ch; s[0].req_url_n += 1; }
    body := ga_body(g, s[0].req_body[..]); s[0].req_body_n = body.count;
    s[0].flight = GS_AGENTS_ASKS; s[0].req_ready = true;
  } else if ch_job_wants(c) {
    ch_job_sent(c);
    s[0].req_url_n = c[0].job_url_n; for i: 0..<c[0].job_url_n { s[0].req_url[i] = c[0].job_url[i]; }
    s[0].req_body_n = c[0].job_body_n; for i: 0..<c[0].job_body_n { s[0].req_body[i] = c[0].job_body[i]; }   // (none: a GET)
    s[0].flight = GS_AGENT_ASKS; s[0].req_ready = true;
  } else if ac_wants(s[0].acct[..]) {
    // the account's, last: a conversation never waits on a save
    a := s[0].acct[..]; ac_sent(a);
    s[0].req_url_n = a[0].url_n; for i: 0..<a[0].url_n { s[0].req_url[i] = a[0].url[i]; }
    s[0].req_body_n = a[0].body_n; for i: 0..<a[0].body_n { s[0].req_body[i] = a[0].body[i]; }   // (none: a GET)
    s[0].flight = GS_ACCOUNT_ASKS; s[0].req_ready = true;
  } else if pb_wants(s[0].pub[..]) {
    // publishing's, and a link's page's: after the account's save, which a publish waits on
    p := s[0].pub[..]; pb_sent(p);
    s[0].req_url_n = p[0].url_n; for i: 0..<p[0].url_n { s[0].req_url[i] = p[0].url[i]; }
    s[0].req_body_n = p[0].body_n; for i: 0..<p[0].body_n { s[0].req_body[i] = p[0].body[i]; }   // (none: a GET)
    s[0].flight = GS_PUBLISH_ASKS; s[0].req_ready = true;
  } else if ct_wants(k) {
    // the loop's steps, counted: the last to go, to this site's own door (shared/loop.coax)
    body := ct_send(k, s[0].req_body[..]);
    if body.count == 0 { ct_end(k, 0); return; }
    s[0].req_url_n = 0; for ch: LP_DOOR { s[0].req_url[s[0].req_url_n] = ch; s[0].req_url_n += 1; }
    s[0].req_body_n = body.count;
    s[0].flight = GS_COUNT_ASKS; s[0].req_ready = true;
  }
}
// Crates: the room that is up was cleared and left by its gate (the HUD's "room next"): what was built in it is
// written, and the next level of the game is the world (after the last, the first again): the one this browser keeps
// for it, or the room a new game has there. Each room is a level of its own: its steps are not the last room's to undo.
gs_room_next :: (s: [] Site) {
  c := s[0].chat[..]; k := s[0].keep[..];
  rooms := kp_rooms(c[0].kind);
  if !s[0].game || s[0].playing || rooms < 2 { return; }
  kp_write(k, c[0].blocks[..], gs_slot(s));
  s[0].room = (s[0].room + 1) % rooms;
  bl_new_level(c[0].blocks[..], gt_web_type(c[0].kind), s[0].room);
  k[0].restored = false; s[0].still = false; un_forget(s[0].undo[..]); c[0].dirty = true; s[0].dirty = true;
  if kp_open(k, gs_slot(s)) { s[0].open_at = s[0].time; }
}
// A game type picked in the picker: the world comes up as it (the HUD plays its entrance), the follow camera free.
gs_pick :: (s: [] Site, picked: int) {
  c := s[0].chat[..];
  s[0].to_game = 0;
  // the village green starts with a ball alone (its buildings are the world's); leaving it, the meadow's things are back
  // and a world of its own starts with its course alone (racing's track points, crates' first room; nothing yet in the others), no tool picked, no panel open and the normal gravity
  now := gs_ground(picked); was := gs_ground(c[0].kind);
  // (one world of its own to another: what was built in the one is not carried into the other)
  // what was built as the type left is written first: each type keeps its own level (keep.coax)
  if s[0].game { kp_write(s[0].keep[..], c[0].blocks[..], gs_slot(s)); }
  gs_enter(s, picked, !(now != was || (now == 2 && picked != c[0].kind)));
  // the type is the game being built now; and the level kept for it here, if there is one, is read (it is the world when it comes: gs_kept)
  s[0].boot = GS_B_DONE;
  kp_game(s[0].keep[..], picked);
  if kp_open(s[0].keep[..], picked) { s[0].open_at = s[0].time; }
}
// A step of the core loop happened: counted, once a visit, under its name in shared/loop.coax's list (issue 18).
// This is the whole of what a new step's code does: gs_count(s, LP_PUBLISHED). When it is sent, and that a count
// that fails is nothing to the page, are count.coax's.
gs_count :: (s: [] Site, step: int) { ct_mark(s[0].count[..], step); }
// The steps the page can see in its own state, counted as they come to be so (each once: count.coax).
gs_tally :: (s: [] Site) {
  k := s[0].count[..];
  if k[0].at == CT_AT_UNKNOWN { return; }   // (the address is the first thing the host says)
  step := s[0].login[0].step;
  gs_count(s, LP_ARRIVED);
  // (the home page is the builder's picker too: the ring of portals, the types' names before the world is up)
  if s[0].view == GS_HOME_VIEW { gs_count(s, LP_BUTTON_MS); if s[0].gpu == GW_FINE { gs_count(s, LP_BUILDER); } }
  if s[0].gpu != GW_FINE { gs_count(s, LP_NOGPU); }
  // the login shown to someone not logged in is today's account prompt (issue 16's sheet calls gs_count(s, LP_PROMPT) itself)
  asked := step == LG_ASK_EMAIL || step == LG_ASK_CODE;
  if asked && s[0].view == GS_LOGIN_VIEW { ct_stray(k); ct_mark_as(k, LP_PROMPT, k[0].at == CT_AT_OTHER); }
  if asked && s[0].view == GS_WORLD_VIEW && s[0].sheet { gs_count(s, LP_PROMPT); }
  if s[0].view != GS_WORLD_VIEW || s[0].gpu != GW_FINE { return; }
  // the builder: the picker shown, or a game kept in this browser come back
  if s[0].picking && s[0].boot == GS_B_DONE && step != LG_CHECKING { gs_count(s, LP_BUILDER); gs_count(s, LP_BUILDER_MS); }
  if s[0].playing { return; }   // (a link's page is not the builder: its own step is LP_SHARED, counted as the address is read)
  if !s[0].picking && s[0].game { gs_count(s, LP_BUILDER); gs_count(s, LP_BUILDER_MS); ct_mark_as(k, LP_PICKED, s[0].keep[0].restored && s[0].still); }
}
// A press (1), a field's text (2) or Enter in a field (3) on the node in `slot`; a piece of an
// answer (4) and its end (5), where `slot` is the answer's HTTP status; or the address (13).
gs_event :: (s: [] Site, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  n := ifx length < 0 then 0 else ifx length > GS_INBOX then GS_INBOX else length;
  l := s[0].login[..]; c := s[0].chat[..];
  // a storage reply (keep.coax): the kept game, a level read back, or a write done or refused
  if kind >= KP_EVENT && kind < KP_EVENT + 8 { gs_kept(s, kp_reply(s[0].keep[..], kind - KP_EVENT, s[0].inbox[0..<n])); return; }
  if kind == GS_ADDRESS {
    path := cast(string) s[0].inbox[0..<n];
    // a published game's link: the world, played. Its game is asked for with no login; who is here is still asked,
    // so Remix keeps the copy on the account of someone logged in
    link := path.count >= GS_LINK.count && cast(string) path[0..<GS_LINK.count] == GS_LINK;
    if s[0].playing && !link { gs_play_leave(s); }
    if link {
      // (a game of the visitor's own that was up, after Back from the builder: written first)
      if s[0].game && !s[0].playing && s[0].view == GS_WORLD_VIEW && !s[0].picking { kp_write(s[0].keep[..], c[0].blocks[..], gs_slot(s)); }
      s[0].playing = true; s[0].game = false; s[0].picking = false; s[0].asked_play = false; s[0].sheet = false; s[0].menu = false;
      pb_close(s[0].pub[..]);
      if s[0].boot == GS_B_LEVEL { s[0].boot = GS_B_DONE; }
      ct_address(s[0].count[..], CT_AT_OTHER);
      lg_begin(l);
      s[0].view = GS_WORLD_VIEW; s[0].dirty = true;
      shown := pb_play_code(s[0].pub[..], path);
      gs_count(s, LP_SHARED);
      gs_settle(s); gs_tally(s); gs_queue(s);
      return;
    }
    view := GS_HOME_VIEW;
    if path.count >= 6 && cast(string) path[0..<6] == "/login" { view = GS_LOGIN_VIEW; }
    cli := path.count >= 10 && cast(string) path[0..<10] == "/login/cli" && (path.count == 10 || path[10] == '/' || path[10] == '?' || path[10] == '#');
    if cli { view = GS_CLI_VIEW; }
    credits := path.count >= 8 && cast(string) path[0..<8] == "/credits";
    agents := path.count >= 7 && cast(string) path[0..<7] == "/agents" && (path.count == 7 || path[7] == '/' || path[7] == '?' || path[7] == '#');
    // /play is the builder's address: the world for anyone. Logged in it settles to /; a guest stays there
    s[0].asked_play = path.count >= 5 && cast(string) path[0..<5] == "/play";
    // with a type chosen (a name of the ring's pressed before the page's code had loaded: its own link), that type, once the world is up
    if s[0].asked_play { s[0].want = gs_type_asked(path); }
    ct_address(s[0].count[..], ifx s[0].asked_play then CT_AT_BUILDER else ifx view == GS_HOME_VIEW && !credits then CT_AT_HOME else CT_AT_OTHER);
    // whoever is logged in is asked on every address, so the home page can be the world
    lg_begin(l);
    gs_show(s, ifx credits then GS_CREDITS_VIEW else ifx agents then GS_AGENTS_VIEW else ifx cli then GS_CLI_VIEW else ifx s[0].login[0].step == LG_IN && !s[0].asked_play then GS_WORLD_VIEW else view, false);
    gs_settle(s); gs_tally(s); gs_queue(s);
    return;
  }
  if kind == GS_PIECE { if s[0].flight == GS_COUNT_ASKS { return; } if s[0].flight == GS_AGENTS_ASKS { ga_piece(s[0].ag[..], s[0].inbox[0..<n]); } else if s[0].flight == GS_CHAT_ASKS { ch_piece(c, s[0].inbox[0..<n]); } else if s[0].flight == GS_AGENT_ASKS { ch_job_piece(c, s[0].inbox[0..<n]); } else if s[0].flight == GS_ACCOUNT_ASKS { ac_piece(s[0].acct[..], s[0].inbox[0..<n]); } else if s[0].flight == GS_PUBLISH_ASKS { pb_piece(s[0].pub[..], s[0].inbox[0..<n]); } else { lg_piece(l, s[0].inbox[0..<n]); } return; }
  if kind == GS_END {
    who := s[0].flight; s[0].flight = GS_NOBODY;
    // a count's answer is not read: counted or not, nothing on the page changes
    if who == GS_COUNT_ASKS { ct_end(s[0].count[..], slot); gs_queue(s); return; }
    s[0].dirty = true; code := l[0].step == LG_ASK_CODE;
    // (an answer's plan lines, however many, are one step of undo: the list is marked before them and compared after)
    if who == GS_CHAT_ASKS || who == GS_AGENT_ASKS { un_begin(s[0].undo[..], c[0].blocks[..]); }
    if who == GS_AGENTS_ASKS {
      g := s[0].ag[..]; ga_end(g, slot);
    }
    else if who == GS_CHAT_ASKS { gs_cloud_game(s); ch_end(c, slot); } else if who == GS_AGENT_ASKS { ch_job_end(c, slot); } else if who == GS_LOGIN_ASKS { lg_end(l, slot); if code && l[0].step == LG_IN { gs_count(s, LP_ACCOUNT); } }
    if who == GS_CHAT_ASKS || who == GS_AGENT_ASKS { if un_end(s[0].undo[..], c[0].blocks[..], s[0].time, false) { ac_built(s[0].acct[..], gs_slot(s)); } }
    if who == GS_ACCOUNT_ASKS { ac_end(s[0].acct[..], s[0].keep[0].st[..], c[0].blocks[..], gs_slot(s), slot, s[0].time, gs_up(s)); }
    if who == GS_PUBLISH_ASKS { pb_end(s[0].pub[..], ifx c[0].kind >= 0 && c[0].kind < GS_KINDS then s[0].acct[0].link[c[0].kind].level else 0, slot, s[0].time); }
    gs_settle(s); gs_acct(s); gs_pub(s); gs_tally(s); gs_queue(s);
    return;
  }
  id := dm_slot_id(s[0].dom[..], slot);
  if id.count == 0 { return; }
  s[0].dirty = true;
  // a link's page: its own few events, and nothing of the builder's
  if s[0].playing { gs_play_event(s, kind, id, n); gs_settle(s); gs_acct(s); gs_pub(s); gs_tally(s); gs_queue(s); return; }
  world := s[0].view == GS_WORLD_VIEW && !s[0].picking;
  // undo and redo: an event that may edit the world's list has the list marked before it and compared after it, and
  // what differs is one step (web/undo.coax). The HUD's reports of where things rest, and what is typed, are no edits.
  edits := world && (kind == GS_CLICK || (kind == GS_INPUT && (id == "edit" || id == "hotkey" || (id.count > 2 && cast(string) id[0..<2] == "p."))));
  wheel := kind == GS_INPUT && id == "edit" && n > 5 && cast(string) s[0].inbox[0..<5] == "size ";
  s[0].redo = 0;
  if edits { un_begin(s[0].undo[..], c[0].blocks[..]); }
  things := c[0].blocks[0].n;
  // the glue's answer to the counting's note (count.coax): the browser's clock, or that the page was left and the browser took what waited
  if kind == GS_INPUT && id == "count" { if cast(string) s[0].inbox[0..<n] == "left" { ct_left(s[0].count[..]); } else { ct_told(s[0].count[..], cast(string) s[0].inbox[0..<n]); } }
  else if kind == GS_INPUT && id == "gpu" {
    // why the builder can't run here, from the glue: one digit (gpu-words.coax gw_way)
    s[0].gpu = gw_way(cast(string) s[0].inbox[0..<n]);
  }
  else if kind == GS_INPUT && id == "last" {
    // the type this browser picked before, from the glue: lit in the picker, if it is one
    v := ifx n == 1 then cast(int) s[0].inbox[0] - cast(int) '0' else -1;
    if v >= 0 && v < GS_KINDS && s[0].last < 0 { s[0].last = v; }
  }
  else if kind == GS_INPUT && world && id == "edit" {
    // a tool's or edit mode's edit, from the HUD: the same words a plan line is
    before := c[0].blocks[0].n;
    if cast(string) s[0].inbox[0..<n] == "room next" { gs_room_next(s); }
    else if bl_edit(c[0].blocks[..], cast(string) s[0].inbox[0..<n]) { c[0].dirty = true; gs_nearly(s, before); }
    else { gs_limit(s, c[0].blocks[0].why); }   // (refused for a limit, the page's or one the HUD met: said in words)
  }
  else if kind == GS_INPUT && world && id == "hotkey" {
    // a key the glue passes on: a slot's own key; Escape, which clears everything the hotbar holds
    // for the moment, at once; Delete, the selected thing
    key := cast(string) s[0].inbox[0..<n]; k := c[0].blocks[..];
    // (while the palette is open the arrows, Enter and 1 to 9 are its: the glue passes them on only then)
    pal := s[0].pal[0].open && (key == "up" || key == "down" || key == "left" || key == "right" || key == "enter" || (key.count == 1 && key[0] >= '1' && key[0] <= '9'));
    names := [5] string.["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Enter"]; words := [5] string.["up", "down", "left", "right", "enter"];
    if key == "esc" { gs_clear(s); s[0].sheet = false; pb_close(s[0].pub[..]); }
    else if key == "undo" { s[0].redo = 1; }
    else if key == "redo" { s[0].redo = 2; }
    else if key == "del" { if bl_delete(k) { c[0].dirty = true; } }
    else if pal {
      said := key; for w: 0..<5 { if key == words[w] { said = names[w]; } }
      lo := gs_lay(s); gs_cat(s, c[0].kind, s[0].cat[..]);
      r := hb_pal_key(s[0].pal[..], s[0].cat[..], lo, said);
      if r.placed >= 0 { gs_bar_mine(s); c[0].dirty = true; }
      if r.used >= 0 { gs_use(s, r.used); }
    }
    // Q and E step through the picked tool's shapes, back and on; Z and X through its modes (on the shapes
    // slot's row; with no shapes slot on the bar, the picked tool's own)
    else if key == "q" || key == "e" || key == "z" || key == "x" {
      bar: [1] Hotbar; gs_hot(s, bar[..]);
      g := ifx key == "q" || key == "e" then 0 else 1; by := ifx key == "e" || key == "x" then 1 else -1;
      p := hb_cycle_in(bar[..], g, by);
      // (a building tool: Z and X its mode; Q and E the rock's kind, and nothing for a house)
      if k[0].tool >= BL_T_MODEL && g == 1 { set := bl_set_mode(k, 1, (k[0].mode[1] + by + 2) % 2); c[0].dirty = true; }
      else if k[0].tool >= BL_T_MODEL + 3 { s[0].rock = (s[0].rock + 1) % 2; bl_pick_building(k, gs_model_of(s, "rock"), true); c[0].dirty = true; }
      else if k[0].tool >= BL_T_MODEL { }
      else if p.slot >= 0 { gs_hot_press(s, bar[..], p); }
      else if k[0].tool != BL_T_NONE && g == 0 { set := bl_set_shape(k, (k[0].shape + by + BL_SHAPES) % BL_SHAPES); bl_pick(k, true); c[0].dirty = true; }
      else if k[0].tool != BL_T_NONE { set := bl_set_mode(k, 0, (k[0].mode[0] + by + 2) % 2); c[0].dirty = true; }
    }
    // R: a world's own action (crates: reset the room), wherever its slot stands
    else if (key == "r" || key == "R") && k[0].tool >= BL_T_MODEL { bl_spin(k, ifx key == "r" then 1 else -1); c[0].dirty = true; }
    else if key == "r" { if c[0].kind >= GS_OWN { gs_do(s, "reset", HbPress.{slot = 0, kind = HB_ACTION}); } }
    else { bar: [1] Hotbar; gs_hot(s, bar[..]); gs_hot_press(s, bar[..], hb_key(bar[..], key)); }
  }
  else if kind == GS_INPUT && world && id == "bar" { gs_bar_in(s, cast(string) s[0].inbox[0..<n]); }
  else if kind == GS_INPUT && world && id == "drag" { gs_drag(s, cast(string) s[0].inbox[0..<n]); }
  else if kind == GS_INPUT && world && id.count > 2 && cast(string) id[0..<2] == "p." {
    // a setting's slider: the whole number it stands at, through the same plan line the model writes
    if pp_input(c[0].blocks[..], id, cast(string) s[0].inbox[0..<n]) { c[0].dirty = true; }
  }
  else if kind == GS_INPUT && world && id == "pub.name" { pb_name_input(s[0].pub[..], s[0].inbox[0..<n]); }
  else if kind == GS_INPUT { if world && id == "say" { ch_input(c, s[0].inbox[0..<n]); } else if id == "where" { bl_you(c[0].blocks[..], cast(string) s[0].inbox[0..<n]); } else if id == "things" { moved := bl_things(c[0].blocks[..], cast(string) s[0].inbox[0..<n]); } else if id == "note" { ch_note(c, cast(string) s[0].inbox[0..<n]); } else if s[0].view == GS_AGENTS_VIEW && ga_input(s[0].ag[..], id, s[0].inbox[0..<n]) { } else { lg_input(l, id, s[0].inbox[0..<n]); } }
  else if kind == GS_SUBMIT {
    // what you typed goes to the model, and the box is empty for the next
    if world && id == "say" { if ch_send(c) { dm_value(s[0].dom[..], "say", ""); gs_count(s, LP_MESSAGE); } }
    else if world && id == "pub.name" { pb_publish(s[0].pub[..]); }
    else if s[0].view == GS_AGENTS_VIEW && ga_press(s[0].ag[..], id) { }
    else { lg_submit(l, id); }
  }
  else if kind == GS_CLICK {
    // the site's own links keep the page: the view changes and the address follows
    // your icon opens and shuts your menu; any other press shuts it
    open := id == "me" && !s[0].menu;
    if s[0].menu != open { s[0].menu = open; s[0].dirty = true; }
    picked := ifx s[0].picking && s[0].view == GS_WORLD_VIEW then gs_kind_of(id) else -1;
    if id == "nav.login" { gs_show(s, GS_LOGIN_VIEW, true); }
    // the home page's button: the builder's address goes in the bar and is asked for, as if it were typed
    // there; who may be at it is the settling's to say (gs_settle), now or once the login has answered
    // (the home page's ring: a type's name or its portal; the HUD presses the name of a portal taken in the world)
    else if s[0].view == GS_HOME_VIEW && gs_kind_of(id) >= 0 {
      gs_count(s, LP_CREATE);
      s[0].asked_play = true; s[0].want = gs_kind_of(id);
      s[0].go_n = 0; for ch: GS_BUILDER { s[0].go[s[0].go_n] = ch; s[0].go_n += 1; }
      gs_settle(s);
    }
    else if id == "mine.b" { s[0].mine_open = !s[0].mine_open; }
    // a guest's way in, from the menu or the chat's button: over the world when one is up (it stays on screen), else the login's page
    else if id == "in" || id == "say.in" { if world { s[0].sheet = true; s[0].limit_n = 0; } else { gs_show(s, GS_LOGIN_VIEW, true); } }
    else if id == "sheet.x" { s[0].sheet = false; s[0].pub[0].after = false; }
    // publish: someone logged in gets the sheet; a guest the account sheet first, over the game, and the publish sheet
    // once they are in (gs_pub). Nothing of the game changes either way
    else if world && id == "pub" {
      p := s[0].pub[..]; s[0].limit_n = 0;
      if s[0].login[0].step == LG_IN { s[0].sheet = false; pb_open(p, c[0].kind); }
      else { pb_close(p); p[0].after = true; s[0].sheet = true; }
    }
    else if world && id == "pub.x" { pb_close(s[0].pub[..]); }
    else if world && id == "pub.go" { pb_publish(s[0].pub[..]); }
    else if world && id == "pub.down" { pb_down(s[0].pub[..]); }
    else if world && id.count == 7 && cast(string) id[0..<6] == "pub.v." && id[6] >= '0' && id[6] <= '5' { pb_live(s[0].pub[..], s[0].pub[0].versions - cast(int) (id[6] - '0')); }
    // the link, onto the clipboard (the face writes it after this frame), and the button says so
    else if world && id == "pub.copy" && s[0].pub[0].link_n > 0 && s[0].pub[0].link_n <= GS_CLIP {
      s[0].clip_n = 0; for b: pb_link(s[0].pub[..]) { s[0].clip[s[0].clip_n] = b; s[0].clip_n += 1; }
      s[0].pub[0].copied = true;
    }
    // (the share button is the browser's own sheet, opened by the glue; the link leaves the page for the game's own)
    else if world && id == "pub.share" { }
    else if world && id == "pub.open" { kp_write(s[0].keep[..], c[0].blocks[..], gs_slot(s)); }
    else if id == "nav.credits" || id == "foot.credits" { gs_show(s, GS_CREDITS_VIEW, true); }
    // /agents: in this page's module when it holds the page (web/site-agents.coax); else the link is followed, and
    // /agents loads its own module (web/site.coax holds the home page, the login and the world without it)
    else if id == "nav.agents" { if ga_here() { gs_show(s, GS_AGENTS_VIEW, true); } }
    // an agent's row: its conversation comes up
    else if s[0].view == GS_AGENTS_VIEW && ga_row_of(id) >= 0 { ga_open(s[0].ag[..], ga_row_of(id)); }
    // its game, opened in the builder: the account's games are listed afresh, and the game opens as one picked there does (gs_acct)
    else if s[0].view == GS_AGENTS_VIEW && id == "ga.open" && ga_open_game(s[0].ag[..]) >= 0 {
      s[0].to_game = ga_open_game(s[0].ag[..]); s[0].acct[0].listed = false; s[0].listed = false; s[0].picking = true;
      gs_show(s, GS_WORLD_VIEW, true);
    }
    // a send, the game control, Stop and take back (each a row of the table's), a row opened, and what came back to one copied
    else if s[0].view == GS_AGENTS_VIEW && k_code_copy(s[0].tree[..], tr_find(s[0].tree[..], id)).count > 0 {
      code := k_code_copy(s[0].tree[..], tr_find(s[0].tree[..], id));
      if code.count <= GS_CLIP { s[0].clip_n = 0; for b: code { s[0].clip[s[0].clip_n] = b; s[0].clip_n += 1; } }
    }
    else if s[0].view == GS_AGENTS_VIEW && gs_agents_press(s, id) { }
    // a game type picked: the world comes up as it (the HUD plays its entrance), the follow camera free
    // (a name on the ring is a link to /play?type=ID, for a press before the page's code is up: here the page keeps
    // the press, and says so by putting the world's own address in the bar, or the browser would follow the link)
    else if picked >= 0 {
      gs_pick(s, picked);
      if s[0].go_n == 0 && s[0].view == GS_WORLD_VIEW { bar := ifx s[0].login[0].step != LG_IN then GS_BUILDER else "/"; for ch: bar { s[0].go[s[0].go_n] = ch; s[0].go_n += 1; } }
    }
    // one of "your games": its type is entered as picked, and the account's copy opens over it once this browser's own
    // game of that type is safe (web/account.coax ac_open)
    else if s[0].picking && s[0].view == GS_WORLD_VIEW && id.count > 5 && id.count < 8 && cast(string) id[0..<5] == "game." && id[5] >= '0' && id[5] <= '9' {
      to := ac_open(s[0].acct[..], ac_int(cast(string) id[5..<id.count]));
      if to >= 0 { gs_pick(s, to); }
    }
    // "game type" in your menu: back to the picker; the world is entered again when one is picked
    else if world && id == "type" { s[0].picking = true; s[0].sheet = false; }
    // the hotbar: a slot pressed (it says nothing to the chat, but for the model's own button)
    // one of a slot's options (the row over a picked tool): chosen, and the slot stays as it was
    else if world && hb_option_of("hot", id).slot >= 0 { bar: [1] Hotbar; gs_hot(s, bar[..]); at := hb_option_of("hot", id); gs_hot_press(s, bar[..], hb_choose(bar[..], at.slot, at.option)); }
    else if world && hb_slot_of("hot", id) >= 0 { bar: [1] Hotbar; gs_hot(s, bar[..]); gs_hot_press(s, bar[..], hb_press(bar[..], hb_slot_of("hot", id))); }
    // an item of the palette: used once, and the palette shuts
    else if world && hb_pal_of("pal", id) >= 0 { gs_cat(s, c[0].kind, s[0].cat[..]); used := hb_pal_use(s[0].pal[..], s[0].cat[..], hb_pal_of("pal", id)); if used >= 0 { gs_use(s, used); } }
    else if world && id.count > 2 && cast(string) id[0..<2] == "p." { if pp_click(c[0].blocks[..], id) { ch_tuned(c); c[0].dirty = true; } }
    // the selected thing's buttons: a side a step smaller or bigger, a twin beside it, or gone
    else if world && id.count == 6 && cast(string) id[0..<4] == "sel." && (id[4] == 'w' || id[4] == 'd' || id[4] == 'h') && (id[5] == '0' || id[5] == '1') {
      if bl_grow(c[0].blocks[..], ifx id[4] == 'w' then 0 else ifx id[4] == 'd' then 1 else 2, id[5] == '1') { c[0].dirty = true; } else { gs_limit(s, c[0].blocks[0].why); }
    }
    else if world && id == "sel.dup" { before := c[0].blocks[0].n; if bl_twin(c[0].blocks[..]) { c[0].dirty = true; gs_nearly(s, before); } else { gs_limit(s, c[0].blocks[0].why); } }
    else if world && id == "sel.del" { if bl_delete(c[0].blocks[..]) { c[0].dirty = true; } }
    else if world && (id == "sel.cw" || id == "sel.ccw") {
      // a building turned a quarter where it stands (refused, and said why, where it would meet another)
      kb := c[0].blocks[..]; i := bl_chosen(kb);
      if i >= 0 && kb[0].b[i].kind == BL_BUILDING { to := [1] int.[(kb[0].b[i].turn + (ifx id == "sel.ccw" then 90 else 270)) % 360 * 100]; if bl_line(kb, "turn", kb[0].b[i].id, to[..]) { c[0].dirty = true; } else { gs_limit(s, kb[0].why); } }
    }
    // (a guest's way back from the credits is the world they came from; the name takes a guest home)
    else if id == "brand" || id == "home" { gs_show(s, ifx s[0].login[0].step == LG_IN || (id == "home" && s[0].view == GS_CREDITS_VIEW && s[0].was_world) then GS_WORLD_VIEW else GS_HOME_VIEW, true); }
    else if id == "out" { s[0].left = true; pressed := lg_press(l, id); }
    // the command line's code, onto the clipboard (the face writes it after this frame), and the button says so
    else if id == "cli.copy" && s[0].view == GS_CLI_VIEW && l[0].cli_code_n > 0 {
      s[0].clip_n = 0; for b: lg_cli_code(l) { s[0].clip[s[0].clip_n] = b; s[0].clip_n += 1; }
      l[0].copied = true; l[0].dirty = true;
    }
    else if lg_press(l, id) && id == "back" { dm_value(s[0].dom[..], "code", ""); }
  }
  if edits {
    // (undo or redo asked for: the event made no edit of its own, and the step is taken now)
    if s[0].redo != 0 { s[0].undo[0].open = false; gs_redo(s, s[0].redo); }
    else if un_end(s[0].undo[..], c[0].blocks[..], s[0].time, wheel) { ac_built(s[0].acct[..], gs_slot(s)); }
  }
  s[0].redo = 0;
  // a thing more in the world after the person's own edit: the first one placed by hand
  if edits && c[0].blocks[0].n > things && s[0].view == GS_WORLD_VIEW { gs_count(s, LP_PLACED); }
  gs_settle(s); gs_acct(s); gs_pub(s); gs_tally(s); gs_queue(s);
}
// The storage request the face is to make now (keep.coax): KP_GET or KP_PUT, 0 for none. Its slot, token, key and
// (a write's) bytes are read after it; the host's answer is an event KP_EVENT + slot, or, refused at once, gs_keep_refused.
gs_keep_next :: (s: [] Site) -> int #export_c #effects(all) { if s.count < 1 { return 0; } s[0].keep_op = kp_next(s[0].keep[..], s[0].keep_at[..]); return s[0].keep_op; }
gs_keep_slot :: (s: [] Site) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].keep_at[0] else 0; }
gs_keep_token :: (s: [] Site) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].keep_at[1] else 0; }
gs_keep_key_len :: (s: [] Site) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].keep[0].key_n else 0; }
gs_keep_ns_len :: () -> int #export_c #effects(all) { return KP_NS.count; }
gs_keep_version :: () -> int #export_c #effects(all) { return KP_VERSION; }
// Which of the Keep's records a write's slot writes (0 the game, 1 the level, 2 the settings, 3 the account's record), and its length.
gs_keep_which :: (s: [] Site) -> int #export_c #effects(all) { if s.count < 1 { return 0; } slot := s[0].keep_at[0]; return ifx slot == KP_LEVEL_PUT then 1 else ifx slot == KP_SET_PUT then 2 else ifx slot == KP_LINK_PUT then 3 else 0; }
gs_keep_len :: (s: [] Site) -> int #export_c #effects(all) { return ifx s.count > 0 then kp_len(s[0].keep[..], s[0].keep_at[0]) else 0; }
gs_keep_refused :: (s: [] Site, status: int) #export_c #effects(all) { if s.count > 0 { gs_kept(s, kp_refused(s[0].keep[..], s[0].keep_at[0], status)); } }
gs_size :: (s: [] Site, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
gs_inbox_cap :: () -> int #export_c #effects(all) { return GS_INBOX; }
// What the face should do now: an address to put in the bar (its length, once), and a request to
// send (true once: then it is with the host until its answer ends).
gs_go :: (s: [] Site) -> int #export_c #effects(all) { if s.count < 1 { return 0; } n := s[0].go_n; s[0].go_n = 0; return n; }
gs_wants :: (s: [] Site) -> bool #export_c #effects(all) { if s.count < 1 { return false; } gs_queue(s); return s[0].req_ready; }
gs_sent :: (s: [] Site) #export_c #effects(all) { if s.count > 0 { s[0].req_ready = false; } }
gs_url_len :: (s: [] Site) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].req_url_n else 0; }
// What the copy button put for the clipboard (its length), until the face says it is written; then it is gone.
gs_clip_len :: (s: [] Site) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].clip_n else 0; }
gs_clip_done :: (s: [] Site) #export_c #effects(all) { if s.count > 0 { for i: 0..<GS_CLIP { s[0].clip[i] = 0; } s[0].clip_n = 0; } }
gs_body_len :: (s: [] Site) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].req_body_n else 0; }

GsTest :: struct { s: [1] Site; }
gs_has :: (hay: string, needle: string) -> bool {
  if needle.count == 0 || needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 { if cast(string) hay[i..<i + needle.count] == needle { return true; } }
  return false;
}
// The host's storage, as a browser that keeps nothing yet and takes every write: each request answered at once
// (a read: nothing there; a write: done). A check that wants another browser answers the requests itself first.
gs_test_keep :: (s: [] Site) {
  for q: 0..<16 {
    op := gs_keep_next(s); if op == 0 { break; }
    gs_test_stored(s, gs_keep_slot(s), ifx op == KP_GET then KP_MISSING else KP_OK, "");
  }
}
// A storage reply, as the host gives it: the header (the slot's token, the status, the record's length), then the record.
gs_test_stored :: (s: [] Site, slot: int, status: int, record: string) {
  h := [4] int.[s[0].keep[0].token[slot], status, record.count, 0];
  for w: 0..<4 { for q: 0..<4 { s[0].inbox[w * 4 + q] = cast(u8) ((h[w] >> (q * 8)) & 255); } }
  for i: 0..<record.count { s[0].inbox[KP_HEADER + i] = record[i]; }
  gs_event(s, KP_EVENT + slot, 0, KP_HEADER + record.count);
}
// The host's part for the account (web/account.coax), as an account that agrees: it has the games this browser's record
// says and no others, makes the game asked for, and takes every write. Each of the account's requests is answered at
// once, so a check of something else never finds one in the way. A check of the account itself answers them by hand
// (Acct's own requests, taken with gs_test_answer, while `byhand`).
gs_test_acct :: (s: [] Site) {
  if s[0].byhand { return; }
  for q: 0..<8 {
    if s[0].flight == GS_NOBODY { gs_queue(s); }
    if s[0].flight != GS_ACCOUNT_ASKS { break; }
    a := s[0].acct[..]; kind := a[0].kind; url := cast(string) a[0].url[0..<a[0].url_n];
    l := ifx kind >= 0 then a[0].link[kind] else AcLink.{};
    b: [160] u8; n := 0;
    if url == "/api/auth/account" { n = bl_put(b[..], 0, "{\"logged_in\":true,\"account\":\"acct_t\"}"); }
    else if url == "/api/rows/list-games" { n = bl_put(b[..], 0, "{\"ok\":true,\"games\":[]}"); }
    else if url == "/api/rows/new-game" { n = bl_put(b[..], 0, "{\"ok\":true,\"game\":1,\"level\":1}"); }
    else if url == "/api/rows/list-levels" {
      n = bl_put(b[..], 0, "{\"ok\":true,\"levels\":[");
      if l.level > 0 { n = bl_put(b[..], n, "{\"level\":"); n = bl_int(b[..], n, l.level); n = bl_put(b[..], n, ",\"revision\":"); n = bl_int(b[..], n, ifx l.rev > 0 then l.rev else 1); n = bl_put(b[..], n, "}"); }
      n = bl_put(b[..], n, "]}");
    } else { n = bl_put(b[..], 0, "{\"ok\":true,\"revision\":"); n = bl_int(b[..], n, (ifx l.rev > 0 then l.rev else 1) + 1); n = bl_put(b[..], n, "}"); }
    gs_sent(s);
    gs_test_say(s, GS_PIECE, 200, cast(string) b[0..<n]);
    gs_event(s, GS_END, 200, 0);
  }
}
// (on /agents the page asks for frames while an agent works, only so its clock runs: with nothing else to draw, that is still)
gs_test_still :: (s: [] Site) -> bool { return !gs_busy(s) || (s[0].view == GS_AGENTS_VIEW && !s[0].dirty && !s[0].animating && !s[0].login[0].dirty && !s[0].chat[0].dirty && !s[0].count[0].dirty); }
gs_test_frames :: (s: [] Site) { for k: 0..<200 { gs_test_keep(s); gs_test_acct(s); if gs_test_still(s) { break; } m := gs_frame(s, 0.016, true); } gs_test_acct(s); }
gs_test_slot :: (s: [] Site, id: string) -> int { for k: 0..<512 { if dm_slot_id(s[0].dom[..], k) == id { return k; } } return -1; }
gs_test_say :: (s: [] Site, kind: int, slot: int, text: string) { for i: 0..<text.count { s[0].inbox[i] = text[i]; } gs_event(s, kind, slot, text.count); }
// The host's part of a request: takes it, then gives the answer in a piece and an end.
gs_test_answer :: (s: [] Site, status: int, text: string) {
  gs_test_acct(s);
  #assert gs_wants(s);
  gs_sent(s);
  gs_test_say(s, GS_PIECE, status, text);
  gs_event(s, GS_END, status, 0);
  gs_test_frames(s);
}
// The select step's answer (web/chat.coax): a route, and no property or thing.
gs_test_route :: (s: [] Site, route: string) {
  b: [256] u8; n := bl_put(b[..], 0, "{\"choices\":[{\"message\":{\"content\":\"route: "); n = bl_put(b[..], n, route); n = bl_put(b[..], n, "\\nprops: none\\nthings: none\"}}]}");
  gs_test_answer(s, 200, cast(string) b[0..<n]);
}
// What the HUD is told, its first line: the hotbar's state (the settings that differ follow it).
gs_test_line :: (tr: [] Tree) -> string { t := tr_text_of(tr, tr_find(tr, "state")); for i: 0..<t.count { if t[i] == '\n' { return cast(string) t[0..<i]; } } return t; }
gs_test_door :: (s: [] Site) -> string { return cast(string) s[0].req_url[0..<gs_url_len(s)]; }

#test "the first frame sends the home page: one heading and the game types' names, each a link to the builder with its type, the way home, no picture and no game's own section; a still page then sends nothing" #steps 200000000 {
  t: [1] GsTest; s := t[0].s[..];
  n := gs_frame(s, 0.016, true);
  #assert n > 0 && s[0].dom[0].styled;
  out := cast(string) s[0].dom[0].out[0..<n];
  #assert gs_has(out, "GameBuilder") && !gs_has(out, "GAMEBUILDER") && gs_has(out, GS_HOME) && gs_has(out, "gs v0");
  #assert gs_has(out, GS_HEAD) && gs_has(out, GS_HEAD_HERE) && gs_has(out, GS_LINE) && gs_has(out, GS_APPS) && gs_has(out, "racing") && gs_has(out, "medieval village");
  // each name is a link to the builder's address with its type, and the one heading is the only one
  tr := s[0].tree[..]; go := tr_find(tr, "kind.7");
  #assert go >= 0 && tr[0].nodes[go].tag == TG_A && tr_attr_of(tr, go, AT_HREF) == "/play?type=racing" && tr_find(tr, "create") < 0;
  heads := 0; for i: 0..<tr[0].n { if tr[0].nodes[i].tag == TG_H1 || tr[0].nodes[i].tag == TG_H2 { heads += 1; } }
  #assert heads == 1;
  // no picture is asked for (the mark is in the stylesheet; the portals' pictures are named in a hidden line for the glue), and the faces are index.html's to name
  for i: 0..<tr[0].n { #assert tr[0].nodes[i].tag != TG_IMG; }
  #assert !gs_has(out, "@font-face") && gs_has(out, "data:image/webp;base64,");
  #assert !gs_has(out, "scrappers arena") && !gs_has(out, "SPLICEBOTS") && !gs_has(out, "Everglade") && !gs_has(out, "party up");
  #assert !s[0].dom[0].overflow && s[0].tree[0].lost == 0;
  // every page asks who is here
  #assert gs_wants(s) && gs_test_door(s) == "/api/auth/account";
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  #assert s[0].view == GS_HOME_VIEW && gs_go(s) == 0 && !gs_busy(s) && gs_frame(s, 0.016, true) == 0;
  // and, the login answered, the page's class says the ring is up (the glue raises it in the world)
  #assert gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v0 ring");
}
#test "a type's name on the home page goes to the builder as that type, which is the world for anyone: pressed while the login is still asked, pressed logged in, and pressed by a guest, who builds with no login" #steps 1200000000 {
  // pressed before the login has answered: the address is the builder's at once, and the world comes up as racing (it is anyone's)
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_frames(s);
  #assert s[0].login[0].step == LG_CHECKING && gs_test_slot(s, "kind.7") >= 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.7"), 0);
  #assert s[0].view == GS_WORLD_VIEW && s[0].want == 7 && gs_go(s) == GS_BUILDER.count && cast(string) s[0].go[0..<GS_BUILDER.count] == GS_BUILDER;
  // logged in: the builder is the world, as the type pressed
  gs_test_answer(s, 200, "{\"logged_in\":true,\"email\":\"ada@example.com\"}");
  gs_test_frames(s);
  #assert s[0].view == GS_WORLD_VIEW && !s[0].picking && s[0].chat[0].kind == 7 && s[0].want < 0 && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v2 g7");
  // pressed by someone the login already said is nobody: a guest builds (issue 13), in the type pressed, not the login
  u: [1] GsTest; v := u[0].s[..];
  gs_test_say(v, GS_ADDRESS, 0, "/");
  gs_test_answer(v, 200, "{\"logged_in\":false}");
  gs_event(v, GS_CLICK, gs_test_slot(v, "kind.h.4"), 0);
  #assert gs_go(v) == GS_BUILDER.count && cast(string) v[0].go[0..<GS_BUILDER.count] == GS_BUILDER;
  gs_test_frames(v);
  #assert v[0].view == GS_WORLD_VIEW && !v[0].picking && v[0].chat[0].kind == GS_VILLAGE && gs_test_slot(v, "kind.0") < 0 && gs_test_slot(v, "email") < 0;
  // a name pressed before the page's code had loaded is its own link: the builder's address with the type, and the type is entered
  w: [1] GsTest; x := w[0].s[..];
  gs_test_say(x, GS_ADDRESS, 0, "/play?type=racing");
  gs_test_answer(x, 200, "{\"logged_in\":false}");
  gs_test_frames(x);
  #assert x[0].view == GS_WORLD_VIEW && !x[0].picking && x[0].chat[0].kind == GS_RACING;
  // /play with no type, or one that is no type, is the ring: the same picker as the home page's
  y: [1] GsTest; z := y[0].s[..];
  gs_test_say(z, GS_ADDRESS, 0, "/play?type=chess");
  gs_test_answer(z, 200, "{\"logged_in\":false}");
  gs_test_frames(z);
  #assert z[0].view == GS_WORLD_VIEW && z[0].picking && gs_test_slot(z, "kind.8") >= 0 && gs_has(cast(string) z[0].tree[0].pool[0..<z[0].tree[0].pool_n], "gs v2 pick ring");
  #assert gs_type_asked("/play?type=drift") == GS_DRIFT && gs_type_asked("/play?x=1&type=top-down#a") == 2 && gs_type_asked("/play") == -1 && gs_type_asked("/play?type=") == -1;
}
#test "log in keeps the page: the view changes, the address follows, and the name goes home" #steps 900000000 {
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  #assert s[0].view == GS_HOME_VIEW && gs_go(s) == 0 && !gs_wants(s);
  link := gs_test_slot(s, "nav.login");
  #assert link >= 0;
  gs_event(s, GS_CLICK, link, 0);
  gs_test_frames(s);
  // the face is told to push /login; who is here is already known, so nothing more is asked
  #assert s[0].view == GS_LOGIN_VIEW && gs_go(s) == 6 && cast(string) s[0].go[0..<6] == "/login" && gs_go(s) == 0 && !gs_wants(s);
  #assert s[0].login[0].step == LG_ASK_EMAIL && gs_test_slot(s, "email") >= 0 && gs_test_slot(s, "nav.login") < 0;
  // typing and Enter reach the login through the page
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "ada@example.com");
  gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  #assert gs_wants(s) && gs_test_door(s) == "/api/auth/email/start";
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  #assert s[0].login[0].step == LG_ASK_CODE && gs_test_slot(s, "code") >= 0;
  // the name goes home with no reload; Back (the address again) returns to the login as it was
  gs_event(s, GS_CLICK, gs_test_slot(s, "brand"), 0);
  #assert s[0].view == GS_HOME_VIEW && gs_go(s) == 1 && s[0].go[0] == '/';
  gs_test_say(s, GS_ADDRESS, 0, "/login");
  gs_test_frames(s);
  #assert s[0].view == GS_LOGIN_VIEW && s[0].login[0].step == LG_ASK_CODE && !gs_wants(s);
  // a page opened at /login starts there
  u: [1] GsTest; v := u[0].s[..];
  gs_test_say(v, GS_ADDRESS, 0, "/login");
  #assert v[0].view == GS_LOGIN_VIEW && gs_wants(v) && gs_go(v) == 0;
}
#test "logged in, the home page is the world with a chat; what you say goes to the model; logging out goes back to the home page and keeps the game built" #steps 2000000000 {
  t: [1] GsTest; s := t[0].s[..];
  gs_test_say(s, GS_ADDRESS, 0, "/login");
  gs_test_answer(s, 200, "{\"logged_in\":false}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "email"), "ada@example.com");
  gs_event(s, GS_SUBMIT, gs_test_slot(s, "email"), 0);
  gs_test_answer(s, 200, "{\"state\":\"sent\"}");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "code"), "123456");
  gs_event(s, GS_SUBMIT, gs_test_slot(s, "code"), 0);
  #assert s[0].view == GS_LOGIN_VIEW;
  gs_test_answer(s, 200, "{\"state\":\"logged-in\",\"account\":\"acct_1\"}");
  // the address is / and you pick a game type before the world: the ring, no chat
  #assert s[0].view == GS_WORLD_VIEW && gs_go(s) == 1 && s[0].go[0] == '/' && s[0].picking;
  pool := cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n];
  #assert gs_has(pool, "gs v2 pick ring") && !gs_has(pool, "gs v2 g") && gs_has(pool, GS_HEAD_HERE) && gs_has(pool, "third person") && gs_has(pool, "first person") && gs_has(pool, "top-down") && gs_has(pool, "side-scroller") && gs_has(pool, "medieval village");
  #assert gs_test_slot(s, "say") < 0 && gs_test_slot(s, "follow") < 0 && gs_test_slot(s, "decide") < 0 && gs_test_slot(s, "kind.0") >= 0 && gs_test_slot(s, "kind.3") >= 0 && gs_test_slot(s, "kind.5") >= 0 && gs_test_slot(s, "kind.6") >= 0 && gs_test_slot(s, "kind.7") >= 0 && gs_test_slot(s, "kind.8") >= 0 && gs_test_slot(s, "kind.9") < 0 && gs_test_slot(s, "me") >= 0;
  #assert !gs_has(pool, " on\"") && s[0].last == -1;
  // every portal's picture is named for the glue (the HUD draws them), and a press on a name's part picks it
  #assert gs_has(pool, "/img/kind-third.jpg") && gs_has(pool, "/img/kind-first.jpg") && gs_has(pool, "/img/kind-top.jpg") && gs_has(pool, "/img/kind-side.jpg") && gs_has(pool, "/img/kind-village.jpg") && gs_kind_of("kind.h.2") == 2;
  // the type this browser picked last time (the glue's word) is lit, and nothing more; a word that is no type is not taken
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "last"), "9"); #assert s[0].last == -1;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "last"), "2"); p1 := gs_frame(s, 0.016, true);
  #assert s[0].last == 2 && s[0].picking && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "kind r2 on") && !gs_wants(s);
  // the menu has no "game type" while you are picking
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); p2 := gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "out") >= 0 && gs_test_slot(s, "type") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); p3 := gs_frame(s, 0.016, true);
  // first person picked (a press on the button's name counts): the world as it, the chat, and the camera menu's camera first person
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.h.1"), 0); gs_test_frames(s); p4 := gs_frame(s, 0.016, true);
  #assert !s[0].picking && s[0].chat[0].kind == 1 && s[0].last == 1 && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v2 g1") && !gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], GS_HEAD_HERE);
  #assert gs_test_slot(s, "say") >= 0 && gs_test_slot(s, "hot.s.2") >= 0 && gs_test_slot(s, "hot.s.3") >= 0 && s[0].chat[0].cam == GS_CAM_FIRST && gs_test_slot(s, "decide") < 0 && gs_test_slot(s, "kind.0") < 0 && !gs_wants(s);
  // "game type" in the menu goes back to the picker, the last pick lit; third person picked: the follow button is back
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); p5 := gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "type") >= 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "type"), 0); gs_test_frames(s); p6 := gs_frame(s, 0.016, true);
  #assert s[0].picking && !s[0].menu && gs_test_slot(s, "say") < 0 && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v2 pick ring") && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "kind r1 on");
  gs_event(s, GS_CLICK, gs_test_slot(s, "kind.0"), 0);
  #assert gs_go(s) > 0;   // (the press kept: the world's address in the bar, never the link followed)
  gs_test_frames(s); p7 := gs_frame(s, 0.016, true);
  #assert !s[0].picking && s[0].chat[0].kind == 0 && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v2 g0");
  say := gs_test_slot(s, "say");
  #assert say >= 0 && gs_test_slot(s, "email") < 0 && gs_test_slot(s, "me") >= 0 && !gs_wants(s);
  // Narrow layouts stack these siblings in one bounded flow, so growing a
  // selected-object panel cannot cover the chat's input.
  overlay := tr_find(s[0].tree[..], "world.ui");
  #assert overlay >= 0 && s[0].tree[0].nodes[tr_find(s[0].tree[..], "chat")].parent == overlay && s[0].tree[0].nodes[tr_find(s[0].tree[..], "dock")].parent == overlay;
  #assert !gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "asking");
  // you are an icon: the menu is shut until it is pressed, then it has who you are and the way out; a second press shuts it
  #assert gs_test_slot(s, "out") < 0 && gs_test_slot(s, "nav.who") < 0 && gs_test_slot(s, "brand.n") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); gs_test_frames(s); m1 := gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "out") >= 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); m2 := gs_frame(s, 0.016, true);
  #assert gs_test_slot(s, "out") < 0;
  #assert gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "gs v2");
  // the HUD says where things came to rest, through the page's hidden field: the list has it, and the model is told it with the next message
  #assert gs_test_slot(s, "things") >= 0 && gs_test_slot(s, "where") >= 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "things"), "4 -730 0 1250 60 60 60 0 0");
  #assert s[0].chat[0].blocks[0].b[3].x == -730 && s[0].chat[0].blocks[0].b[3].z == 1250 && s[0].chat[0].blocks[0].b[3].moves == 1;
  gs_test_say(s, GS_INPUT, say, "where am i?");
  gs_event(s, GS_SUBMIT, say, 0);
  // the select step first: the route and the properties the message is about (none); then the answer's question
  #assert gs_wants(s) && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "route: NAME\\nprops: PATHS") && !gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "You are GameBuilder,");
  gs_test_route(s, "world/where");
  #assert gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "b4: ball -7.3 12.5, radius 0.3, bottom 0") && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "world now:\\ngame type: third person\\n");
  #assert gs_wants(s) && gs_test_door(s) == "/api/chat/complete/v1";
  #assert gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "{\"role\":\"user\",\"content\":\"You are GameBuilder,") && gs_has(cast(string) s[0].req_body[0..<gs_body_len(s)], "message: where am i?\"}]}");
  gs_test_answer(s, 200, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"On a grid.\"}}]}");
  #assert s[0].chat[0].n == 2 && ch_test_text(s[0].chat[..], 1) == "On a grid." && s[0].flight == GS_NOBODY;
  // the camera, beside the decide button: pressed, its menu stands over it (orbit, follow, first person, top-down), the orbit lit;
  // a camera picked from it is the one in use and the menu stays; pressed again the menu shuts and the camera stays; it sends nothing
  cam := gs_test_slot(s, "hot.s.3");
  #assert cam >= 0 && s[0].chat[0].cam == GS_CAM_ORBIT && gs_test_slot(s, "hot.o.3.0") < 0 && gs_test_slot(s, "decide") < 0 && gs_has(cast(string) s[0].tree[0].pool[0..<s[0].tree[0].pool_n], "hb hb-scifi");
  gs_event(s, GS_CLICK, cam, 0); f1 := gs_frame(s, 0.016, true);
  #assert s[0].cams && tr_class(s[0].tree[..], tr_find(s[0].tree[..], "hot.s.3")) == "hb-s hb-on hud k2" && !gs_wants(s) && s[0].chat[0].n == 2 && !s[0].chat[0].busy;
  #assert tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.o.3.0")) == "orbit" && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "hot.o.3.2")) == "first person" && gs_test_slot(s, "hot.o.3.3") >= 0 && gs_test_slot(s, "hot.o.3.4") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.o.3.2"), 0); f2 := gs_frame(s, 0.016, true);
  #assert s[0].chat[0].cam == GS_CAM_FIRST && s[0].cams && gs_has(tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "state")), " 2 ");
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.o.3.1"), 0); f3 := gs_frame(s, 0.016, true);
  #assert s[0].chat[0].cam == GS_CAM_FOLLOW;
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.g.3"), 0); f4 := gs_frame(s, 0.016, true);
  #assert !s[0].cams && s[0].chat[0].cam == GS_CAM_FOLLOW && gs_test_slot(s, "hot.o.3.0") < 0 && tr_class(s[0].tree[..], tr_find(s[0].tree[..], "hot.s.3")) == "hb-s hud k2" && !gs_wants(s);
  gs_test_hotbar(s);
  // the name keeps you in the world
  gs_event(s, GS_CLICK, gs_test_slot(s, "brand"), 0);
  #assert s[0].view == GS_WORLD_VIEW && gs_go(s) == 1;
  // logging out, from the menu: the service is told, the conversation is gone and the home page is back.
  // The game built is not forgotten (it is kept in this browser, and is the builder's again): its things, its type, its camera and its settings stand
  built := s[0].chat[0].blocks[0].n; grav := s[0].chat[0].blocks[0].grav;
  gs_event(s, GS_CLICK, gs_test_slot(s, "me"), 0); m3 := gs_frame(s, 0.016, true);
  gs_event(s, GS_CLICK, gs_test_slot(s, "out"), 0);
  #assert gs_wants(s) && gs_test_door(s) == "/api/auth/logout";
  gs_test_answer(s, 200, "{\"state\":\"logged-out\"}");
  #assert s[0].view == GS_HOME_VIEW && s[0].chat[0].n == 0 && gs_go(s) == 1 && gs_test_slot(s, "nav.login") >= 0;
  k := s[0].chat[0].blocks[..];
  #assert s[0].chat[0].cam == GS_CAM_FOLLOW && !s[0].cams && s[0].last == 0 && !s[0].picking && s[0].chat[0].kind == 0 && s[0].game && k[0].n == built && k[0].grav == grav && grav != BL_GRAV;
  #assert k[0].tool == BL_T_NONE && !k[0].editing && !s[0].panel && s[0].chat[0].guest;   // and what the hotbar held for the moment is put down
  // the builder's address again, as nobody: the same game, no picker, and the chat's box is the guest's words
  gs_test_say(s, GS_ADDRESS, 0, "/play"); gs_test_frames(s); a1 := gs_frame(s, 0.016, true);
  #assert s[0].view == GS_WORLD_VIEW && !s[0].picking && k[0].n == built && gs_test_slot(s, "say") < 0 && gs_test_slot(s, "say.in") >= 0 && gs_go(s) == 0;
}
// The hotbar, from a world that is up with nothing typed: its tools, edit mode, the selection's panel, the model's
// button and the world's settings. It leaves a block tool picked, edit mode on, a thing selected and gravity changed.
gs_test_hotbar :: (s: [] Site) {
  c := s[0].chat[..]; k := c[0].blocks[..]; tr := s[0].tree[..];
  n0 := k[0].n; said := c[0].n;
  // six slots, a divider before the model's; the state the HUD is told; nothing picked
  // every slot is named under its glyph, and says what it does when the pointer rests on it
  names := [5] string.["shapes", "edit", "decide", "camera", "world"]; lids := [5] string.["hot.l.0", "hot.l.1", "hot.l.2", "hot.l.3", "hot.l.4"];
  for q: 0..<5 { #assert tr_text_of(tr, tr_find(tr, lids[q])) == names[q] && tr_class(tr, tr_find(tr, lids[q])) == "hb-l"; }
  #assert tr_attr_of(tr, tr_find(tr, "hot.s.0"), AT_TITLE) == "place a cube: click the world. things: 4 of 1000 (1)" && tr_attr_of(tr, tr_find(tr, "hot.s.3"), AT_TITLE) == "camera: pick how you see the world (4)" && tr_attr_of(tr, tr_find(tr, "hot.s.0"), AT_LABEL) == "shapes" && tr_text_of(tr, tr_find(tr, "hot.g.0")) == "▢";
  // (a press on a slot's name is a press on the slot)
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.l.0"), 0); #assert k[0].tool == BL_T_BLOCK; gs_event(s, GS_CLICK, gs_test_slot(s, "hot.l.0"), 0); #assert k[0].tool == BL_T_NONE;
  #assert gs_test_slot(s, "hot.s.0") >= 0 && gs_test_slot(s, "hot.s.4") >= 0 && gs_test_slot(s, "hot.s.7") >= 0 && gs_test_slot(s, "hot.s.8") < 0 && tr_find(tr, "hot.d.2") > 0 && gs_test_line(tr) == "-1 0 0 10 1 1 0 0 0";
  // a limit is said on screen, in words, with its number. One the HUD met where the tool was used (something stands there): nothing
  // changes, and its words stand over the hotbar; five seconds later they are gone by themselves
  #assert tr_find(tr, "limit") < 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "limit room"); l0 := gs_frame(s, 0.016, true);
  #assert k[0].n == n0 && tr_text_of(tr, tr_find(tr, "limit")) == "no room there: something is standing in that place." && tr_class(tr, tr_find(tr, "limit")) == "limit hud k1" && tr_attr_of(tr, tr_find(tr, "limit"), AT_LIVE) == "polite";
  for q: 0..<300 { lq := gs_frame(s, 0.016, true); } #assert tr_find(tr, "limit") >= 0;   // (4.8 s on: still there)
  for q: 0..<20 { lq := gs_frame(s, 0.016, true); } #assert tr_find(tr, "limit") < 0 && s[0].limit_n == 0;
  // one the page's own list refuses: a place past the world's bounds, the sky's limit, and a word that is no limit (nothing is said)
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 600 0 1 1 1"); l1 := gs_frame(s, 0.016, true);
  #assert k[0].n == n0 && tr_text_of(tr, tr_find(tr, "limit")) == "too far: things stay within 200 m of the middle.";
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "limit sky"); l2 := gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "limit")) == "as high as it goes: the sky stops at 60 m.";
  s[0].limit_n = 0; gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "limit nothing"); gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "hello"); l3 := gs_frame(s, 0.016, true);
  #assert tr_find(tr, "limit") < 0 && k[0].n == n0;
  // the shapes tool by its slot: a cube, as the world opens; then the sphere, by the shapes' key (the glue passes a key on): the slot's glyph is the skin's ball; neither says anything to the chat
  gs_event(s, GS_CLICK, gs_test_slot(s, "hot.s.0"), 0); a := gs_frame(s, 0.016, true); gs_test_acct(s);
  #assert k[0].tool == BL_T_BLOCK && tr_class(tr, tr_find(tr, "hot.s.0")) == "hb-s hb-on hud k2" && gs_test_line(tr) == "0 0 0 10 1 1 0 0 0" && !gs_wants(s) && c[0].n == said;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "e"); b := gs_frame(s, 0.016, true);
  #assert k[0].tool == BL_T_BALL && k[0].shape == BL_T_BALL && tr_class(tr, tr_find(tr, "hot.s.0")) == "hb-s hb-on hud k2" && tr_class(tr, tr_find(tr, "hot.g.0")) == "hb-g hb-a-sphere" && gs_test_line(tr) == "1 0 0 10 1 1 0 0 0";
  // the HUD says where the tool was used: a plan line, and the list has the ball; then the block tool's
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "ball 2.50 -3.00 0.60");
  #assert k[0].n == n0 + 1 && k[0].b[n0].kind == BL_BALL && k[0].b[n0].x == 250 && k[0].b[n0].z == -300 && k[0].sel == 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "q");
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), "place 6.00 6.00 1.00 1.00 1.00");
  #assert k[0].tool == BL_T_BLOCK && k[0].n == n0 + 2 && k[0].b[n0 + 1].w == 100 && !gs_wants(s);
