  #assert k[0].b[n0 + 1].h == 125 && k[0].b[n0 + 1].w == 75 && tr_text_of(tr, tr_find(tr, "sel.vh")) == "h 1.25" && tr_text_of(tr, tr_find(tr, "sel.vw")) == "w 0.75";
  // a side at its least takes no step smaller: the page says the range (and at its most, no step bigger)
  for q: 0..<3 { gs_event(s, GS_CLICK, gs_test_slot(s, "sel.w0"), 0); }
  f2 := gs_frame(s, 0.016, true);
  #assert k[0].b[n0 + 1].w == 25 && tr_text_of(tr, tr_find(tr, "limit")) == "that size is out of range: sides are 0.25 to 12 m.";
  s[0].limit_n = 0; gs_event(s, GS_CLICK, gs_test_slot(s, "sel.w1"), 0); gs_event(s, GS_CLICK, gs_test_slot(s, "sel.w1"), 0); f3 := gs_frame(s, 0.016, true);
  #assert k[0].b[n0 + 1].w == 75 && tr_find(tr, "limit") < 0;
  gs_event(s, GS_CLICK, gs_test_slot(s, "sel.dup"), 0); g := gs_frame(s, 0.016, true);
  #assert k[0].n == n0 + 3 && k[0].sel == k[0].b[n0 + 2].id && k[0].b[n0 + 2].h == 125 && k[0].b[n0 + 2].x == 600 + 75 + 25;
  gs_event(s, GS_CLICK, gs_test_slot(s, "sel.del"), 0); h := gs_frame(s, 0.016, true);
  #assert k[0].n == n0 + 2 && k[0].sel == 0 && gs_test_slot(s, "sel") < 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), cast(string) sel[0..<m]);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "del"); i := gs_frame(s, 0.016, true);
  #assert k[0].n == n0 + 1 && k[0].sel == 0;
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "hotkey"), "del"); #assert k[0].n == n0 + 1;   // nothing selected: nothing goes
  // a ball selected has one size
  m = bl_put(sel[..], 0, "select b"); m = bl_int(sel[..], m, k[0].b[n0].id);
  gs_test_say(s, GS_INPUT, gs_test_slot(s, "edit"), cast(string) sel[0..<m]); j := gs_frame(s, 0.016, true);
  #assert tr_text_of(tr, tr_find(tr, "sel.vw")) == "r 0.6" && gs_test_slot(s, "sel.h1") < 0 && gs_test_slot(s, "sel.w1") >= 0;
  // and what it is made of, from the registry: a ball's own bounce; fixed pressed on (its own, with a reset), then reset
  ball := k[0].b[n0].id; pb: [40] u8; pn := bl_put(pb[..], 0, "p.b"); pn = bl_int(pb[..], pn, ball); pq := pn;
  pn = bl_put(pb[..], pq, ".bounce.v"); #assert tr_text_of(tr, tr_find(tr, cast(string) pb[0..<pn])) == "0.55";
  pn = bl_put(pb[..], pq, ".fixed.t"); gs_event(s, GS_CLICK, gs_test_slot(s, cast(string) pb[0..<pn]), 0); j1 := gs_frame(s, 0.016, true);
