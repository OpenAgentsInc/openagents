// The medieval village (docs/web-world.md, "The medieval village"): a game type that is its own
// world. A village green in the meadow: two houses, a market and a few rocks round a worn path,
// under a low morning sun. The buildings are 0 A.D.'s (art by Wildfire Games, CC BY-SA 3.0), from
// the pack web/assets/village.pack (tools/village-pack.coax builds it; the page's host fetches it
// from this site only once the village is picked), drawn by the engine's painted surfaces
// (metaverse-engine/render/shade/stylized-pack.coax) in the same frame, light and shadow as
// everything else, and solid to the character by the engine's collision.
//
// This file is the village's own part of the world: the pack's admission (its size and SHA-256,
// web/village-pin.coax) and its catalog (each model's indices and bounds, the boxes that are solid),
// the buildings the level holds, standing (they are things of the level: the page's list on the
// website, the level open in the app; a new village's are the green's, shared/game-types.coax
// gt_starter), the entrance (the buildings the world opens with rise out of the ground one after
// another), the paths, the look, and what the page is told is here. web/hud.coax owns the frame,
// the camera, the character and the things, and calls in here.
//
// Axes: the page's (x right, z ahead, y up; the engine draws (x, y, -z)). A model's own axes are
// the engine's; it stands turned in quarter turns, so its solid boxes stay square to the world.
//   coax/bin/coax test web/world-village-checks.coax --library   (with the pack itself)

#load "village-pin.coax";
#load "../shared/game-types.coax";   // the buildings' models and rules (shared/buildings.coax), and the green a new village opens with
#load "../../metaverse-engine/render/shade/stylized-frame.coax";
#load "../../metaverse-engine/arch/solid.coax";

VL_MODELS :: 8;            // models a pack may hold
VL_BOXES :: 384;           // solid boxes the pack's models have between them
VL_SOLIDS :: VL_WALLS;     // solid boxes as the level's buildings stand (a model standing twice has its boxes twice): the engine's BD_WALLS
VL_CATALOG :: 32768;       // bytes of catalog the page keeps
// The green's ground table (the engine's: metaverse-engine/arch/flora.coax ArchGround, read by the
// stylized look's grass and ground): where no grass grows. Its first node, the engine's axes.
VL_TABLE_N :: 96; VL_TABLE_CELL :: 0.5; VL_TABLE_X0 :: -24.0; VL_TABLE_Z0 :: -42.0;
VL_TABLE_FLOATS :: 37636;  // (VL_TABLE_N + 1) squared nodes, four floats each
VL_INSET :: 0.5;           // metres inside a thing's foot where the grass stops: it grows right up to a wall or a rock, and only the floor well inside is bare
VL_FIRST :: 0.15;          // seconds into the entrance the first building starts to rise
VL_NEXT :: 0.2;            // seconds between one building's start and the next's
VL_RISE :: 0.5;            // seconds a building takes to come up
VL_SOLID_AT :: 0.6;        // how far up a building must be before it is solid
VL_CREDIT :: "0 A.D. art by Wildfire Games, CC BY-SA 3.0";
VL_LICENCE :: "CC BY-SA 3.0";
// The pack's parts, as the host numbers a pack's four assets: its catalog, vertices, indices and layers.
VL_PARTS :: 4;

Village :: struct {
  wanted: bool;                          // the village has been picked: the pack is to be fetched (till then the host holds it back)
  admitted: bool;                        // the pack's size and SHA-256 are the pinned ones
  digest: [32] u8;                       // where the host puts the SHA-256 of what it fetched
  parts: int; failed: bool;              // which of the pack's four parts are in (bits), and whether one failed
  ready: bool;                           // the catalog is read and every part is in: the buildings can be drawn
  credited: bool;                        // the catalog names the art's makers and its licence
  loaded: int; total: int;               // bytes of the pack in so far, of how many (the host's message 605)
  models: int;
  first: [VL_MODELS] int; count: [VL_MODELS] int;   // a model's indices in the pack's index buffer
  bounds: [VL_MODELS * 6] f32;           // and its bounds, metres, its own axes: low x y z, high x y z
  nbox: int; box_of: [VL_BOXES] int; box: [VL_BOXES * 6] f32;   // the models' solid boxes, their own axes
  clock: f32;                            // seconds of the entrance so far, once the pack is in
  solid: int;                            // how many of the buildings are solid now
  // the level's buildings (the page's list, kind 2: web/blocks.coax; the app's level, coax/world.coax), in its order
  nput: int; put: [VL_PUT] VlPlace; put_id: [VL_PUT] int; put_gen: int;   // put_gen: one more each time they change
  put_rise: [VL_PUT] int;                // its turn in the entrance (those the world opened with, in the list's order); -1: placed since, it stood at once
  // the building tool's ghost: the real model where it would go, lit and shadowed, tinted (red where it may not go)
  ghost: VlPlace; ghost_on: bool; ghost_bad: bool;
  catalog: [VL_CATALOG] u8;
}

// A whole number from text at `from`: its value and where it ended. A minus sign is taken.
VlRead :: struct { value: int; at: int; ok: bool; }
vl_read :: (t: string, from: int) -> VlRead {
  i := from;
  while i < t.count && t[i] == ' ' { i += 1; }
  neg := i < t.count && t[i] == '-';
  if neg { i += 1; }
  v := 0; got := false;
  while i < t.count && t[i] >= '0' && t[i] <= '9' { if v < 100000000 { v = v * 10 + cast(int) (t[i] - '0'); } i += 1; got = true; }
  return VlRead.{value = ifx neg then -v else v, at = i, ok = got};
}
vl_has :: (hay: string, needle: string) -> bool {
  if needle.count == 0 || needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 { if cast(string) hay[i..<i + needle.count] == needle { return true; } }
  return false;
}
// The host has hashed the pack it fetched (the engine's pack gate, coax/web/PACK-GATE.md): it is
// admitted only if it is exactly the pack this page was built with.
vl_admit :: (v: [] Village, bytes: int) -> bool {
  pin := VL_PACK_SHA256;
  same := bytes == VL_PACK_BYTES;
  for k: 0..<32 { if v[0].digest[k] != pin[k] { same = false; } }
  v[0].admitted = same;
  return same;
}
// The pack's catalog: the art's credit and licence (an L line: without one the pack is not used),
// each model's indices and bounds (G lines) and the boxes that are solid (B lines), millimetres.
// True when it was all read and every model a place names is there.
vl_catalog :: (v: [] Village, t: string) -> bool {
  v[0].models = 0; v[0].nbox = 0; v[0].credited = false;
  at := 0;
  while at < t.count {
    e := at; while e < t.count && t[e] != '\n' { e += 1; }
    line := cast(string) t[at..<e]; at = e + 1;
    if line.count < 3 || line[1] != ' ' { continue; }
    if line[0] == 'L' { if vl_has(line, "Wildfire Games") && vl_has(line, VL_LICENCE) { v[0].credited = true; } continue; }
    if line[0] != 'G' && line[0] != 'B' { continue; }
    n: [9] int; p := 1; good := true; want := ifx line[0] == 'G' then 9 else 7;
    for k: 0..<want { r := vl_read(line, p); if !r.ok { good = false; break; } n[k] = r.value; p = r.at; }
    if !good { return false; }
    if line[0] == 'G' {
      if n[0] != v[0].models || n[0] >= VL_MODELS || n[1] < 0 || n[2] < 3 { return false; }
      v[0].first[n[0]] = n[1]; v[0].count[n[0]] = n[2];
      for k: 0..<6 { v[0].bounds[n[0] * 6 + k] = cast(f32) n[3 + k] / 1000; }
      v[0].models += 1;
    } else {
      if n[0] < 0 || n[0] >= v[0].models || v[0].nbox >= VL_BOXES { return false; }
      v[0].box_of[v[0].nbox] = n[0];
      for k: 0..<6 { v[0].box[v[0].nbox * 6 + k] = cast(f32) n[1 + k] / 1000; }
      v[0].nbox += 1;
    }
  }
  // (every model a level may name: shared/buildings.coax)
  return v[0].credited && v[0].models >= VL_KINDS;
}
// One of the pack's parts has arrived (bytes 0: it failed). The catalog (part 0) is in the
// village's own buffer. The buildings are ready when the pack was admitted, the catalog reads and
// every part is in.
vl_part :: (v: [] Village, i: int, bytes: int) {
  if i < 0 || i >= VL_PARTS { return; }
  if bytes <= 0 { v[0].failed = true; v[0].ready = false; return; }
  if i == 0 && (bytes > VL_CATALOG || !vl_catalog(v, cast(string) v[0].catalog[0..<bytes])) { v[0].failed = true; v[0].ready = false; return; }
  v[0].parts |= 1 << i;
  v[0].ready = v[0].admitted && !v[0].failed && v[0].parts == 15;
}
// How far the pack has come, 0 to 1 (1 once it is ready; 0 before anything is known).
vl_progress :: (v: [] Village) -> f32 {
  if v[0].ready { return 1; }
  if v[0].total <= 0 { return 0; }
  f := cast(f32) v[0].loaded / cast(f32) v[0].total;
  return ifx f > 0.98 then 0.98f32 else f;
}

// How far the building whose turn is `i` has risen, `seconds` into the entrance: 0 under the ground,
// 1 standing. They come up one after another, each easing in and out.
vl_risen :: (seconds: f32, i: int) -> f32 {
  t := (seconds - (VL_FIRST + VL_NEXT * cast(f32) i)) / VL_RISE;
  if t <= 0 { return 0; }
  if t >= 1 { return 1; }
  return t * t * (3 - 2 * t);
}
// How far building `j` of the level has risen: one placed since the world opened stands at once.
vl_up :: (v: [] Village, j: int) -> f32 { return ifx v[0].put_rise[j] < 0 then 1.0f32 else vl_risen(v[0].clock, v[0].put_rise[j]); }
// The entrance's whole length: when the last building that rises stands (with none, as one's).
vl_done :: (v: [] Village) -> f32 {
  last := 0;
  for j: 0..<v[0].nput { if v[0].put_rise[j] > last { last = v[0].put_rise[j]; } }
  return VL_FIRST + VL_NEXT * cast(f32) last + VL_RISE;
}
// The world is opened again (the entrance from the start): every building the level holds rises, in the list's order.
vl_again :: (v: [] Village) { for j: 0..<v[0].nput { v[0].put_rise[j] = j; } }
// A point of a model's own axes where a place stands it, the engine's axes: scaled, turned its
// quarter turns about the upright (as the engine's records turn a part: x' = x cos + z sin,
// z' = -x sin + z cos), moved. The place's z is the page's: the engine's is its negative.
vl_stand :: (p: VlPlace, x: f32, z: f32) -> [2] f32 {
  q := ((p.quarter % 4) + 4) % 4;
  c: f32 = ifx q == 0 then 1.0f32 else ifx q == 2 then -1.0f32 else 0.0f32;
  s: f32 = ifx q == 1 then 1.0f32 else ifx q == 3 then -1.0f32 else 0.0f32;
  lx := x * p.scale; lz := z * p.scale;
  return [2] f32.[lx * c + lz * s + p.x, -lx * s + lz * c - p.z];
}
// A model's solids where a place stands it: the model's boxes (the pack's catalog: walls, rooms
// filled, roofs, eaves; tools/village-pack.coax finds them from the model's own surface), scaled,
// turned and moved with the place, as the engine's colliders want them, the page's axes (low x y z,
// high x y z), six floats a box, written to `out` from box `n` on. How many boxes `out` then
// holds. This is the one source of a building's solids: the character's collision, the rigid
// bodies' walls, the camera's room, the tools' ray and the grass's mask all read these boxes, for
// a place of the green or for a copy of a model placed anywhere.
vl_place_solids :: (v: [] Village, p: VlPlace, out: [] f32, n: int) -> int {
  if !v[0].ready || p.model < 0 || p.model >= v[0].models { return n; }
  m := n;
  for b: 0..<v[0].nbox {
    if v[0].box_of[b] != p.model || (m + 1) * 6 > out.count { continue; }
    k := v[0].box[b * 6..<b * 6 + 6];
    a := vl_stand(p, k[0], k[2]); c := vl_stand(p, k[3], k[5]);
    // (the engine's z turned back to the page's)
    o := m * 6;
    out[o] = ifx a[0] < c[0] then a[0] else c[0]; out[o + 3] = ifx a[0] < c[0] then c[0] else a[0];
    out[o + 1] = k[1] * p.scale; out[o + 4] = k[4] * p.scale;
    out[o + 2] = ifx -a[1] < -c[1] then -a[1] else -c[1]; out[o + 5] = ifx -a[1] < -c[1] then -c[1] else -a[1];
    m += 1;
  }
  return m;
}
// The solid boxes of every building that has risen far enough. How many.
vl_solids :: (v: [] Village, out: [] f32) -> int { none: [1] int; return vl_solids_of(v, out, none[0..<0]); }
// The same, and for each box whose it is in `owner` (when it has room): its building's id.
vl_solids_of :: (v: [] Village, out: [] f32, owner: [] int) -> int {
  n := 0;
  for j: 0..<v[0].nput {
    if vl_up(v, j) < VL_SOLID_AT { continue; }
    was := n; n = vl_place_solids(v, v[0].put[j], out, n);
    for k: was..<n { if k < owner.count { owner[k] = v[0].put_id[j]; } }
  }
  return n;
}
// The level's buildings from the list ("ID 2 MOVES SIZES X Y Z MODEL QUARTER SCALE" a line, already read: `ids`
// and five numbers each, x and z in hundredths, the scale in percent), in its order. One that is new while the
// entrance has not begun rises in its turn; one placed since stands at once. True when they differ from those standing.
vl_put_in :: (v: [] Village, n: int, ids: [] int, x: [] int, z: [] int, model: [] int, quarter: [] int, scale: [] int) -> bool {
  m := 0; same := true;
  was_n := v[0].nput; was_id: [VL_PUT] int; was_rise: [VL_PUT] int;
  for j: 0..<was_n { was_id[j] = v[0].put_id[j]; was_rise[j] = v[0].put_rise[j]; }
  for i: 0..<n {
    if m >= VL_PUT || model[i] < 0 || model[i] >= VL_KINDS || scale[i] < VL_SCALE_SMALL || scale[i] > VL_SCALE_BIG { continue; }
    p := VlPlace.{model = model[i], x = cast(f32) x[i] * 0.01, z = cast(f32) z[i] * 0.01, quarter = ((quarter[i] % 4) + 4) % 4, scale = cast(f32) scale[i] * 0.01, name = vl_name(model[i])};
    if m >= v[0].nput || v[0].put_id[m] != ids[i] || v[0].put[m].model != p.model || v[0].put[m].x != p.x || v[0].put[m].z != p.z || v[0].put[m].quarter != p.quarter || v[0].put[m].scale != p.scale { same = false; }
    rise := ifx v[0].clock > 0 then -1 else m;
    for j: 0..<was_n { if was_id[j] == ids[i] { rise = was_rise[j]; } }
    v[0].put[m] = p; v[0].put_id[m] = ids[i]; v[0].put_rise[m] = rise; m += 1;
  }
  if m != v[0].nput { same = false; }
  v[0].nput = m;
  if !same { v[0].put_gen += 1; }
  return !same;
}
// Whether model `p` standing there would stand in a box of `boxes` (the page's axes, six floats each; a
// few centimetres of touching is not standing in) or in the person (a body's width round (cx, cz), `tall` high).
vl_meets :: (v: [] Village, p: VlPlace, boxes: [] f32, cx: f32, cz: f32, tall: f32) -> bool {
  mine: [VL_BOXES * 6] f32; n := vl_place_solids(v, p, mine[..], 0); e: f32 = 0.03; r: f32 = 0.35;
  for a: 0..<n {
    x := mine[a * 6..<a * 6 + 6];
    if x[0] + e < cx + r && cx - r < x[3] - e && x[2] + e < cz + r && cz - r < x[5] - e && x[1] < tall { return true; }
    for b: 0..<boxes.count / 6 {
      y := boxes[b * 6..<b * 6 + 6];
      if x[0] + e < y[3] && y[0] + e < x[3] && x[1] + e < y[4] && y[1] + e < x[4] && x[2] + e < y[5] && y[2] + e < x[5] { return true; }
    }
  }
  return false;
}
// The green's ground table: grass everywhere but under what stands on the ground. Every node is
// flat (height 0), all grass (cover 1), unpaved; then no grass at the nodes more than VL_INSET
// inside a box that reaches the ground (a room's floor, a rock's base: a thin wall or an eave keeps
// its grass, so the grass grows right up to what stands on it and never shows a bare square), for every
// building, risen or not (nothing grows where a building is about to stand). `boxes` are solids in the
// page's axes (vl_place_solids); the table is in the engine's (its z the page's turned).
vl_ground :: (boxes: [] f32, table: [] f32) {
  side := VL_TABLE_N + 1;
  if table.count < side * side * 4 { return; }
  for k: 0..<side * side { table[k * 4] = 0; table[k * 4 + 1] = 1; table[k * 4 + 2] = 0; table[k * 4 + 3] = 0; }
  for b: 0..<boxes.count / 6 {
    x := boxes[b * 6..<b * 6 + 6];
    if x[1] > 0.01 { continue; }
    i0 := cast(int) floor((x[0] + VL_INSET - VL_TABLE_X0) / VL_TABLE_CELL + 0.999); i1 := cast(int) floor((x[3] - VL_INSET - VL_TABLE_X0) / VL_TABLE_CELL);
    j0 := cast(int) floor((-x[5] + VL_INSET - VL_TABLE_Z0) / VL_TABLE_CELL + 0.999); j1 := cast(int) floor((-x[2] - VL_INSET - VL_TABLE_Z0) / VL_TABLE_CELL);
    // (the table's edge keeps its grass: past the table the edge's nodes are what is read)
    for j: j0..<j1 + 1 { for i: i0..<i1 + 1 { if i > 0 && j > 0 && i < VL_TABLE_N && j < VL_TABLE_N { table[(j * side + i) * 4 + 1] = 0; } } }
  }
}
// Every building's solids, risen or not: what the ground table and the bare earth are made from.
vl_all_solids :: (v: [] Village, out: [] f32) -> int {
  n := 0;
  for j: 0..<v[0].nput { n = vl_place_solids(v, v[0].put[j], out, n); }
  return n;
}
// The earth under what stands on the ground: a patch of the engine's ground material with no grass
// cover, a finger over the ground, VL_INSET inside each box that reaches it (`boxes`: the page's axes),
// so the floor inside a building is earth, not grass-green, and none shows outside a wall or a rock.
vl_earth :: (boxes: [] f32, p: [] ArchPen) {
  arch_material(p, ARCH_M_GROUND, 0, 0, 0);
  for b: 0..<boxes.count / 6 {
    x := boxes[b * 6..<b * 6 + 6];
    if x[1] > 0.01 { continue; }
    // (inside the foot by as much as the grass is, so no earth shows past a wall or a rock)
    y: f32 = 0.012; g: f32 = VL_INSET;
    if x[3] - x[0] <= g * 2 || x[5] - x[2] <= g * 2 { continue; }
    arch_quad(p, arch_at(x[0] + g, y, -x[2] - g, 0, 1, 0, 0, 0), arch_at(x[3] - g, y, -x[2] - g, 0, 1, 0, 0, 0), arch_at(x[3] - g, y, -x[5] + g, 0, 1, 0, 0, 0), arch_at(x[0] + g, y, -x[5] + g, 0, 1, 0, 0, 0));
  }
}
// How many buildings are solid now: when this changes the colliders are made again.
vl_solid_count :: (v: [] Village) -> int {
  if !v[0].ready { return 0; }
  n := 0;
  for j: 0..<v[0].nput { if vl_up(v, j) >= VL_SOLID_AT { n += 1; } }
  return n;
}
// The buildings' records, for the engine's stand (sixteen floats each: where it stands and its turn,
// its scale, its wash): one not yet up stands as far under the ground as it has still to rise.
vl_records :: (v: [] Village, out: [] f32) {
  for j: 0..<v[0].nput { vl_record(v, v[0].put[j], vl_up(v, j), out, j * 16); }
  // and the tool's ghost last (VL_GHOST_AT)
  vl_ghost_record(v, out);
}
VL_GHOST_AT :: VL_PUT;   // the record (and the draw's instance past the first building's) of the tool's ghost
// The ghost's record alone (it moves with the pointer): bluish where it may go, red where it may not.
vl_ghost_record :: (v: [] Village, out: [] f32) {
  o := VL_GHOST_AT * 16;
  if o + 16 > out.count { return; }
  vl_record(v, v[0].ghost, 1, out, o);
  out[o + 8] = ifx v[0].ghost_bad then 1.45f32 else 0.8f32; out[o + 9] = ifx v[0].ghost_bad then 0.42f32 else 1.0f32; out[o + 10] = ifx v[0].ghost_bad then 0.38f32 else 1.25f32;
}
// One place's record at `o`: where it stands and its turn, its scale, its wash; `risen` 0 to 1 (not yet up: under the ground by as much).
vl_record :: (v: [] Village, p: VlPlace, risen: f32, out: [] f32, o: int) {
  if o + 16 > out.count { return; }
  for k: 0..<16 { out[o + k] = 0; }
  tall := ifx v[0].ready && p.model >= 0 && p.model < v[0].models then v[0].bounds[p.model * 6 + 4] * p.scale else 0.0f32;
  out[o] = p.x; out[o + 1] = -(tall + 0.3) * (1 - risen); out[o + 2] = -p.z; out[o + 3] = cast(f32) (((p.quarter % 4) + 4) % 4) * 1.5707963;
  out[o + 4] = p.scale;
  out[o + 8] = 1; out[o + 9] = 1; out[o + 10] = 1;
}
// The buildings' draws (the host's: first index, count, base instance, instances), indexed over the
// pack's index buffer, one a building that has begun to rise; `base` is the base instance of the
// first building's record. How many were written.
vl_draws :: (v: [] Village, out: [] u32, base: int) -> int {
  if !v[0].ready { return 0; }
  n := 0;
  for j: 0..<v[0].nput {
    m := v[0].put[j].model;
    if !(vl_up(v, j) > 0) || (n + 1) * 4 > out.count || m < 0 || m >= v[0].models { continue; }
    out[n * 4] = cast(u32) v[0].first[m]; out[n * 4 + 1] = cast(u32) v[0].count[m]; out[n * 4 + 2] = cast(u32) (base + j); out[n * 4 + 3] = 1;
    n += 1;
  }
  // and the tool's ghost
  m := v[0].ghost.model;
  if v[0].ghost_on && (n + 1) * 4 <= out.count && m >= 0 && m < v[0].models {
    out[n * 4] = cast(u32) v[0].first[m]; out[n * 4 + 1] = cast(u32) v[0].count[m]; out[n * 4 + 2] = cast(u32) (base + VL_GHOST_AT); out[n * 4 + 3] = 1;
    n += 1;
  }
  return n;
}
// The worn paths of the green, for the engine's ground (sty_path_add), the engine's axes: up the
// middle from where you start to the market, and across to each house's door.
vl_paths :: (u: [] f32) {
  ok := sty_path_add(u, 0, 1, 0, -23, 1.5);
  ok = sty_path_add(u, 0, -11, -7.5, -11, 1.0) && ok;
  ok = sty_path_add(u, 0, -14, 7.5, -14, 1.0) && ok;
  ok = sty_path_add(u, -1, -23, -9, -24, 0.9) && ok;
}
// The village's day: the sunrise ends in a low golden morning, the sun 17 degrees up and well to
// the right of the way you look, long shadows across the green, warm light on thatch and timber.
// The sky, its sun and its clouds are the engine's air, from the sun's place.
vl_day :: (meadow: StyLook) -> StyLook {
  l := meadow;
  l.sun_x = 0.62; l.sun_y = 0.29; l.sun_z = -0.729;
  l.sun_r = 0.9; l.sun_g = 0.66; l.sun_b = 0.4; l.shadow = 0.8;
  l.sky_r = 0.3; l.sky_g = 0.34; l.sky_b = 0.42;
  l.ground_r = 0.22; l.ground_g = 0.19; l.ground_b = 0.14;
  l.cloud = 0.5;
  l.meadow_dry = 0.3;
  return l;
}
// What is here, for the page's chat (the HUD tells the page; the model is told it with the world).
// The buildings themselves are things of the list, which the model is told with the rest. Written to
// `out`; how many bytes.
vl_put :: (out: [] u8, n: int, s: string) -> int { k := n; for c: s { if k < out.count { out[k] = c; k += 1; } } return k; }
vl_put_int :: (out: [] u8, n: int, v: int) -> int {
  k := n; a := v;
  if a < 0 { k = vl_put(out, k, "-"); a = -a; }
  digits: [12] u8; m := 0;
  if a == 0 { digits[0] = '0'; m = 1; }
  while a > 0 && m < 12 { digits[m] = cast(u8) ('0' + a % 10); m += 1; a /= 10; }
  while m > 0 { m -= 1; if k < out.count { out[k] = digits[m]; k += 1; } }
  return k;
}
vl_describe :: (v: [] Village, out: [] u8) -> int {
  n := vl_put(out, 0, ifx v[0].ready then "a village green. its buildings are solid, and they are things of the list: yours to move, turn and remove." else "a village green. its buildings are still loading.");
  if !v[0].ready { return n; }
  n = vl_put(out, n, " art: "); n = vl_put(out, n, VL_CREDIT); n = vl_put(out, n, ".");
  return n;
}

// ---------------------------------------------------------------- checks (the pack itself is checked in world-village-checks.coax)

VL_TEST_CATALOG :: "pack village\nbudget 6291456\nbytes 0000000100\nL 0 0 A.D. art by Wildfire Games|CC BY-SA 3.0|https://www.wildfiregames.com/\nM a 0 30 0 -2.000 0.000 -3.000 2.000 5.000 3.000\nG 0 0 30 -2000 0 -3000 2000 5000 3000\nB 0 -2000 0 -3000 2000 4000 -2000\nB 0 1000 0 -2000 2000 3000 3000\nB 0 -3000 2000 -3000 -2000 2500 3000\nM b 30 60 0 -2.000 0.000 -2.000 2.000 4.000 2.000\nG 1 30 60 -2000 0 -2000 2000 4000 2000\nG 2 90 9 -5000 0 -4000 5000 8000 4000\nB 2 -5000 0 -4000 -4000 6000 4000\nG 3 99 3 -500 0 -500 500 700 500\nB 3 -500 0 -500 500 700 500\nG 4 102 6 -600 0 -600 600 1000 600\nT 0 a.png 0\n";
vl_test_ready :: (v: [] Village) {
  pin := VL_PACK_SHA256; for k: 0..<32 { v[0].digest[k] = pin[k]; }
  ok := vl_admit(v, VL_PACK_BYTES);
  t := VL_TEST_CATALOG; for i: 0..<t.count { v[0].catalog[i] = t[i]; }
  vl_part(v, 0, t.count); vl_part(v, 1, 48); vl_part(v, 2, 12); vl_part(v, 3, 1);
}
vl_test_near :: (a: f32, b: f32) -> bool { return abs(a - b) < 0.001; }
// The green a new village opens with, as the page's list tells it (shared/game-types.coax gt_starter): the
// ball is b1, the buildings b2 and up. How many buildings.
vl_test_green :: (v: [] Village) -> int {
  s: [GT_STARTER_MAX] GtThing; n := gt_starter(GT_VILLAGE, s[..]);
  ids: [VL_PUT] int; x: [VL_PUT] int; z: [VL_PUT] int; m: [VL_PUT] int; q: [VL_PUT] int; sc: [VL_PUT] int; k := 0;
  for i: 0..<n {
    if gk_building(s[i].kind) < 0 { continue; }
    ids[k] = i + 1; x[k] = s[i].x; z[k] = s[i].z; m[k] = gk_building(s[i].kind); q[k] = vl_quarter(s[i].turn); sc[k] = s[i].scale; k += 1;
  }
  changed := vl_put_in(v, k, ids[..], x[..], z[..], m[..], q[..], sc[..]);
  return k;
}
// That green's buildings as places, for a check to read.
vl_test_places :: () -> [GT_GREEN] VlPlace { v: [1] Village; n := vl_test_green(v[..]); out: [GT_GREEN] VlPlace; for i: 0..<GT_GREEN { out[i] = v[0].put[i]; } return out; }

#test "the pack is admitted only as the pinned one: its size and every byte of its SHA-256" {
  v: [1] Village; pin := VL_PACK_SHA256;
  #assert !vl_admit(v[..], VL_PACK_BYTES);   // nothing hashed yet
  for k: 0..<32 { v[0].digest[k] = pin[k]; }
  #assert vl_admit(v[..], VL_PACK_BYTES) && v[0].admitted;
  #assert !vl_admit(v[..], VL_PACK_BYTES - 1) && !v[0].admitted && !vl_admit(v[..], VL_PACK_BYTES + 1) && !vl_admit(v[..], 0);
  for k: 0..<32 {
    v[0].digest[k] = pin[k] ^ 1; #assert !vl_admit(v[..], VL_PACK_BYTES);
    v[0].digest[k] = pin[k]; #assert vl_admit(v[..], VL_PACK_BYTES);
  }
}
#test "the catalog: models, bounds and solid boxes in metres; no credit and licence line, a missing model or a bad line and it is refused" {
  v: [1] Village;
  #assert vl_catalog(v[..], VL_TEST_CATALOG) && v[0].credited && v[0].models == 5 && v[0].nbox == 5;
  #assert v[0].first[1] == 30 && v[0].count[1] == 60 && v[0].first[4] == 102 && v[0].count[4] == 6;
  #assert v[0].bounds[0] == -2 && v[0].bounds[4] == 5 && v[0].bounds[5] == 3 && v[0].bounds[2 * 6 + 4] == 8 && vl_test_near(v[0].bounds[3 * 6 + 4], 0.7);
  #assert v[0].box_of[1] == 0 && v[0].box[6] == 1 && v[0].box[6 + 4] == 3 && v[0].box[6 + 5] == 3 && v[0].box_of[3] == 2 && v[0].box[3 * 6 + 3] == -4 && v[0].box[2 * 6 + 1] == 2 && v[0].box[2 * 6 + 4] == 2.5;
  // without the makers' name and the licence the pack is not used
  #assert !vl_catalog(v[..], "G 0 0 30 0 0 0 1 1 1\nG 1 30 3 0 0 0 1 1 1\nG 2 33 3 0 0 0 1 1 1\nG 3 36 3 0 0 0 1 1 1\nG 4 39 3 0 0 0 1 1 1\n") && !v[0].credited;
  #assert !vl_catalog(v[..], "L 0 Someone|CC BY-SA 3.0|u\nG 0 0 30 0 0 0 1 1 1\nG 1 30 3 0 0 0 1 1 1\nG 2 33 3 0 0 0 1 1 1\nG 3 36 3 0 0 0 1 1 1\nG 4 39 3 0 0 0 1 1 1\n");
  #assert !vl_catalog(v[..], "L 0 0 A.D. art by Wildfire Games|CC0|u\nG 0 0 30 0 0 0 1 1 1\nG 1 30 3 0 0 0 1 1 1\nG 2 33 3 0 0 0 1 1 1\nG 3 36 3 0 0 0 1 1 1\nG 4 39 3 0 0 0 1 1 1\n");
  head := "L 0 0 A.D. art by Wildfire Games|CC BY-SA 3.0|u\n";
  buf: [512] u8;
  // a model a place names is missing; models out of order; a short line; a box of a model not there
  n := vl_put(buf[..], 0, head); n = vl_put(buf[..], n, "G 0 0 30 0 0 0 1 1 1\nG 1 30 3 0 0 0 1 1 1\nG 2 33 3 0 0 0 1 1 1\nG 3 36 3 0 0 0 1 1 1\n");
  #assert !vl_catalog(v[..], cast(string) buf[0..<n]);
  n = vl_put(buf[..], n, "G 4 39 3 0 0 0 1 1 1\n"); #assert vl_catalog(v[..], cast(string) buf[0..<n]);
  m := vl_put(buf[..], n, "B 5 0 0 0 1 1 1\n"); #assert !vl_catalog(v[..], cast(string) buf[0..<m]);
  m = vl_put(buf[..], n, "B 4 0 0 0 1 1\n"); #assert !vl_catalog(v[..], cast(string) buf[0..<m]);
  m = vl_put(buf[..], n, "G 6 0 3 0 0 0 1 1 1\n"); #assert !vl_catalog(v[..], cast(string) buf[0..<m]);
  m = vl_put(buf[..], n, "B 4 -1500 0 0 1 1 1\nX whatever\n\n"); #assert vl_catalog(v[..], cast(string) buf[0..<m]) && v[0].box[0] == -1.5;
}
#test "the buildings are ready only when the pack was admitted, its catalog reads and all four parts are in; a failed part and nothing is drawn" {
  v: [1] Village;
  vl_test_ready(v[..]);
  #assert v[0].ready && !v[0].failed && vl_progress(v[..]) == 1;
  // not admitted: never ready
  w: [1] Village; t := VL_TEST_CATALOG; for i: 0..<t.count { w[0].catalog[i] = t[i]; }
  vl_part(w[..], 0, t.count); vl_part(w[..], 1, 48); vl_part(w[..], 2, 12); vl_part(w[..], 3, 1);
  d: [GT_GREEN * 4] u32;
  #assert vl_test_green(w[..]) == GT_GREEN && !w[0].ready && w[0].parts == 15 && vl_draws(w[..], d[..], 0) == 0;
  // three parts in: not yet; progress is the host's bytes
  x: [1] Village; pin := VL_PACK_SHA256; for k: 0..<32 { x[0].digest[k] = pin[k]; } ok := vl_admit(x[..], VL_PACK_BYTES);
  for i: 0..<t.count { x[0].catalog[i] = t[i]; }
  vl_part(x[..], 0, t.count); vl_part(x[..], 2, 12); vl_part(x[..], 3, 1);
  #assert !x[0].ready && vl_progress(x[..]) == 0;
  x[0].loaded = 500; x[0].total = 1000; #assert vl_progress(x[..]) == 0.5;
  x[0].loaded = 1000; #assert vl_progress(x[..]) == 0.98;
  vl_part(x[..], 7, 5); vl_part(x[..], -1, 5); #assert !x[0].ready;
  vl_part(x[..], 1, 48); #assert x[0].ready;
  // a part that failed
  vl_part(x[..], 3, 0); #assert x[0].failed && !x[0].ready;
  // a catalog too long, or one that does not read
  y: [1] Village; for k: 0..<32 { y[0].digest[k] = pin[k]; } ok = vl_admit(y[..], VL_PACK_BYTES);
  vl_part(y[..], 0, VL_CATALOG + 1); #assert y[0].failed;
  z: [1] Village; for k: 0..<32 { z[0].digest[k] = pin[k]; } ok = vl_admit(z[..], VL_PACK_BYTES);
  vl_part(z[..], 0, 5); #assert z[0].failed && !z[0].ready;
}
#test "the entrance: the buildings the world opens with rise one after another, each from under the ground, and all stand by its end; one placed since stands at once" {
  #assert vl_risen(0, 0) == 0 && vl_risen(VL_FIRST, 0) == 0 && vl_test_near(vl_risen(VL_FIRST + VL_RISE * 0.5, 0), 0.5) && vl_risen(VL_FIRST + VL_RISE + 0.001, 0) == 1 && vl_risen(99, 0) == 1;
  #assert vl_risen(VL_FIRST + VL_RISE * 0.25, 0) < 0.25 && vl_risen(VL_FIRST + VL_RISE * 0.75, 0) > 0.75;   // eased
  // the next starts VL_NEXT later, and so on
  #assert vl_risen(VL_FIRST + VL_NEXT, 1) == 0 && vl_test_near(vl_risen(VL_FIRST + VL_NEXT + VL_RISE * 0.5, 1), 0.5) && vl_test_near(vl_risen(VL_FIRST + VL_NEXT * 2 + VL_RISE * 0.5, 2), 0.5);
  for i: 1..<GT_GREEN { #assert vl_risen(4.0, i) <= vl_risen(4.0, i - 1); }
  v: [1] Village; vl_test_ready(v[..]);
  // with no building the entrance is one's; with the green's nine, the ninth's
  #assert vl_test_near(vl_done(v[..]), VL_FIRST + VL_RISE) && vl_test_green(v[..]) == GT_GREEN && v[0].nput == GT_GREEN && v[0].put_rise[0] == 0 && v[0].put_rise[8] == 8 && v[0].put_id[0] == 2;
  #assert vl_risen(vl_done(v[..]) + 0.001, GT_GREEN - 1) == 1 && vl_risen(vl_done(v[..]) - 0.2, GT_GREEN - 1) < 1 && vl_done(v[..]) < 12;
  // the records: under the ground by its own height at the start, standing at the end; turned and scaled as placed
  r: [(VL_GHOST_AT + 1) * 16] f32;
  vl_records(v[..], r[..]);
  places := vl_test_places();
  #assert r[0] == places[0].x && vl_test_near(r[1], -(5 * places[0].scale + 0.3)) && r[2] == -places[0].z && vl_test_near(r[3], 1.5707963) && r[4] == places[0].scale && r[8] == 1 && r[9] == 1 && r[10] == 1;
  #assert vl_test_near(r[2 * 16 + 1], -(8 * places[2].scale + 0.3)) && vl_test_near(r[2 * 16 + 3], 3.1415926) && r[3 * 16 + 3] == 0;
  d: [GT_GREEN * 4] u32;
  #assert vl_draws(v[..], d[..], 2048) == 0 && vl_solid_count(v[..]) == 0;
  v[0].clock = VL_FIRST + VL_RISE * 0.5; vl_records(v[..], r[..]);
  #assert vl_test_near(r[1], -(5 * places[0].scale + 0.3) * 0.5) && vl_draws(v[..], d[..], 2048) == 2 && d[0] == 0 && d[1] == 30 && d[2] == 2048 && d[3] == 1 && d[4] == 30 && d[6] == 2049 && vl_solid_count(v[..]) == 0;
  v[0].clock = vl_done(v[..]); vl_records(v[..], r[..]);
  for i: 0..<GT_GREEN { #assert r[i * 16 + 1] == 0; }
  #assert vl_draws(v[..], d[..], 2048) == GT_GREEN && vl_solid_count(v[..]) == GT_GREEN;
  // the market's draw: its model's indices, its own record
  #assert d[2 * 4] == 90 && d[2 * 4 + 1] == 9 && d[2 * 4 + 2] == 2050 && d[8 * 4 + 2] == 2056 && d[8 * 4] == 99;
  // a short buffer takes what fits
  #assert vl_draws(v[..], d[0..<8], 0) == 2;
  // a tenth placed now, mid-entrance, stands at once, solid, while the green's are where they were; one of the green's
  // moved keeps its turn; the world opened again, all ten rise in the list's order
  ids: [10] int; x: [10] int; z: [10] int; m: [10] int; q: [10] int; sc: [10] int;
  for i: 0..<GT_GREEN { ids[i] = v[0].put_id[i]; x[i] = cast(int) floor(v[0].put[i].x * 100 + 0.5); z[i] = cast(int) floor(v[0].put[i].z * 100 + 0.5); m[i] = v[0].put[i].model; q[i] = v[0].put[i].quarter; sc[i] = cast(int) floor(v[0].put[i].scale * 100 + 0.5); }
  ids[9] = 40; x[9] = 3000; z[9] = -3000; m[9] = 0; q[9] = 0; sc[9] = 100;
  v[0].clock = VL_FIRST + VL_RISE * 0.5;
  #assert !vl_put_in(v[..], 9, ids[..], x[..], z[..], m[..], q[..], sc[..]) && vl_put_in(v[..], 10, ids[..], x[..], z[..], m[..], q[..], sc[..]) && v[0].nput == 10 && v[0].put_rise[9] == -1 && v[0].put_rise[8] == 8;
  #assert vl_up(v[..], 9) == 1 && vl_test_near(vl_up(v[..], 0), 0.5) && vl_up(v[..], 8) == 0 && vl_solid_count(v[..]) == 1 && vl_draws(v[..], d[..], 0) == 3 && d[2 * 4 + 2] == 9;
  x[3] = -2500; #assert vl_put_in(v[..], 10, ids[..], x[..], z[..], m[..], q[..], sc[..]) && v[0].put_rise[3] == 3 && v[0].put[3].x == -25;
  v[0].clock = 0; vl_again(v[..]); #assert v[0].put_rise[9] == 9 && vl_up(v[..], 9) == 0 && vl_done(v[..]) > VL_FIRST + VL_NEXT * 9;
  // a scale past a building's is not stood: 49 and 301 percent
  sc[9] = 49; #assert vl_put_in(v[..], 10, ids[..], x[..], z[..], m[..], q[..], sc[..]) && v[0].nput == 9; sc[9] = 301; #assert !vl_put_in(v[..], 10, ids[..], x[..], z[..], m[..], q[..], sc[..]) && v[0].nput == 9;
}
#test "a place stands its model turned in quarter turns, and its solid boxes with it, square to the world in the page's axes" {
  p := VlPlace.{model = 0, x = 10, z = 20, quarter = 0, scale = 2};
  a := vl_stand(p, 1, 3); #assert a[0] == 12 && a[1] == -14;        // the engine's z: the model's own +z is toward you
  p.quarter = 1; a = vl_stand(p, 1, 3); #assert a[0] == 16 && a[1] == -22;
  p.quarter = 2; a = vl_stand(p, 1, 3); #assert a[0] == 8 && a[1] == -26;
  p.quarter = 3; a = vl_stand(p, 1, 3); #assert a[0] == 4 && a[1] == -18;
  p.quarter = -1; a = vl_stand(p, 1, 3); #assert a[0] == 4 && a[1] == -18;
  p.quarter = 4; a = vl_stand(p, 1, 3); #assert a[0] == 12 && a[1] == -14;
  v: [1] Village; vl_test_ready(v[..]);
  s: [VL_SOLIDS * 6] f32;
  #assert vl_solids(v[..], s[..]) == 0 && vl_test_green(v[..]) == GT_GREEN && vl_solids(v[..], s[..]) == 0;
  // the first house alone is up: its two boxes, turned a quarter and scaled 1.45 about (-11.5, 11)
  v[0].clock = VL_FIRST + VL_RISE * 0.75;
  #assert vl_solid_count(v[..]) == 1 && vl_solids(v[..], s[..]) == 3;
  k: f32 = 1.45;
  // box (-2, -3)..(2, -2): turned a quarter, x' = z, z' = -x: x from -3k to -2k, engine z from -2k to 2k
  #assert vl_test_near(s[0], -11.5 - 3 * k) && vl_test_near(s[3], -11.5 - 2 * k) && vl_test_near(s[2], 11 - 2 * k) && vl_test_near(s[5], 11 + 2 * k) && s[1] == 0 && vl_test_near(s[4], 4 * k);
  #assert s[6] < s[9] && s[8] < s[11] && vl_test_near(s[10], 3 * k);
  // the eave: it hangs, from 2 m to 2.5 m (scaled), and you walk under it
  #assert vl_test_near(s[13], 2 * k) && vl_test_near(s[16], 2.5 * k) && s[12] < s[15];
  // all up: every place's model's boxes (the second house model has none; the fourth rock model has none)
  v[0].clock = vl_done(v[..]);
  n := vl_solids(v[..], s[..]);
  #assert n == 3 + 0 + 1 + 0 + 1 + 0 + 0 + 1 + 1;
  for i: 0..<n { #assert s[i * 6] < s[i * 6 + 3] && s[i * 6 + 2] < s[i * 6 + 5] && s[i * 6 + 1] >= 0 && s[i * 6 + 4] > s[i * 6 + 1]; }
  #assert vl_solids(v[..], s[0..<12]) == 2 && vl_all_solids(v[..], s[..]) == n;
  // a copy of a model placed anywhere has the model's solids there; a model the pack lacks, or a pack not in, has none
  copy := VlPlace.{model = 0, x = 30, z = -40, quarter = 0, scale = 1};
  #assert vl_place_solids(v[..], copy, s[..], 0) == 3 && s[0] == 28 && s[3] == 32 && s[2] == -38 && s[5] == -37 && s[4] == 4;
  #assert vl_place_solids(v[..], copy, s[..], 5) == 8 && vl_place_solids(v[..], VlPlace.{model = 7, scale = 1}, s[..], 0) == 0 && vl_place_solids(v[..], VlPlace.{model = -1, scale = 1}, s[..], 2) == 2;
  e: [1] Village; #assert vl_place_solids(e[..], copy, s[..], 0) == 0 && vl_all_solids(e[..], s[..]) == 0;
}
#test "what the page is told is here: a green whose buildings are things of the list, and the art's credit; loading says so" {
  v: [1] Village; out: [1024] u8;
  n := vl_describe(v[..], out[..]);
  #assert cast(string) out[0..<n] == "a village green. its buildings are still loading.";
  vl_test_ready(v[..]);
  n = vl_describe(v[..], out[..]);
  t := cast(string) out[0..<n];
  #assert t == "a village green. its buildings are solid, and they are things of the list: yours to move, turn and remove. art: 0 A.D. art by Wildfire Games, CC BY-SA 3.0.";
}
#test "the village's day is a low warm morning, and its paths are the engine's" {
  m: StyLook; m.air = 1; m.lush = 1; m.blade = 0.46;
  l := vl_day(m);
  #assert l.air == 1 && l.lush == 1 && l.blade == 0.46 && l.sun_y > 0.2 && l.sun_y < 0.4 && l.sun_x > 0.4 && l.sun_z < 0 && l.sun_r > l.sun_g && l.sun_g > l.sun_b;
  #assert vl_test_near(l.sun_x * l.sun_x + l.sun_y * l.sun_y + l.sun_z * l.sun_z, 1);
  u: [STY_UNIFORM_FLOATS] f32;
  sty_path_clear(u[..]); vl_paths(u[..]);
  #assert u[STY_U_PATH_INFO] == 4 && u[STY_U_PATH + 1] == 1 && u[STY_U_PATH + 3] == -23 && u[STY_U_PATH + 4] == 1.5 && u[STY_U_PATH + 5] == 0 && u[STY_U_PATH + 8] == 0 && u[STY_U_PATH + 8 + 2] == -7.5;
}
VlGroundTest :: struct { t: [VL_TABLE_FLOATS] f32; mesh: [64 * ARCH_VERTEX_FLOATS] f32; }
vl_test_node :: (g: [] VlGroundTest, x: f32, z: f32, field: int) -> f32 { i := cast(int) floor((x - VL_TABLE_X0) / VL_TABLE_CELL + 0.5); j := cast(int) floor((z - VL_TABLE_Z0) / VL_TABLE_CELL + 0.5); return g[0].t[(j * (VL_TABLE_N + 1) + i) * 4 + field]; }
#test "no grass grows on the floor inside what stands on the ground: the table's nodes half a metre inside a box have no cover, its edge and an eave's keep theirs, and the earth there is a patch of ground inside it with none" #steps 2000000000 {
  g: [1] VlGroundTest; side := VL_TABLE_N + 1;
  #assert side * side * 4 == VL_TABLE_FLOATS;
  // a wall from x 2 to 4 and the page's z 10 to 12 (the engine's -12 to -10); an eave over x -6 to -4
  boxes := [12] f32.[2, 0, 10, 4, 3, 12, -6, 2, 10, -4, 2.5, 12];
  vl_ground(boxes[..], g[0].t[..]);
  #assert vl_test_node(g[..], 3, -11, 1) == 0 && vl_test_node(g[..], 2.5, -10.5, 1) == 0 && vl_test_node(g[..], 3.5, -11.5, 1) == 0 && vl_test_node(g[..], 3, -11, 0) == 0 && vl_test_node(g[..], 3, -11, 2) == 0;
  // the grass grows right up to the box: its edge has grass, and so does all round it, and under the eave there always was
  #assert vl_test_node(g[..], 2, -10, 1) == 1 && vl_test_node(g[..], 4, -12, 1) == 1 && vl_test_node(g[..], 1.5, -11, 1) == 1 && vl_test_node(g[..], 4.5, -11, 1) == 1 && vl_test_node(g[..], 3, -9.5, 1) == 1 && vl_test_node(g[..], 3, -12.5, 1) == 1 && vl_test_node(g[..], -5, -11, 1) == 1 && vl_test_node(g[..], 0, 0, 1) == 1;
  bare := 0; for k: 0..<side * side { if g[0].t[k * 4 + 1] == 0 { bare += 1; } }
  #assert bare == 9;
  // a box too thin to have a floor inside (a wall) keeps all its grass
  thin := [6] f32.[2, 0, 10, 2.8, 3, 14]; vl_ground(thin[..], g[0].t[..]); none := 0; for k: 0..<side * side { if g[0].t[k * 4 + 1] == 0 { none += 1; } }
  #assert none == 0;
  vl_ground(boxes[..], g[0].t[..]);
  // a box over the table's edge leaves the edge its grass (past the table the edge is what is read)
  wide := [6] f32.[-40, 0, -20, 40, 1, 60];
  vl_ground(wide[..], g[0].t[..]);
  #assert g[0].t[1] == 1 && g[0].t[(side * side - 1) * 4 + 1] == 1 && g[0].t[(side + 1) * 4 + 1] == 0 && g[0].t[((side - 2) * side + side - 2) * 4 + 1] == 0 && g[0].t[(side - 1) * 4 + 1] == 1;
  // a table too short is left alone
  vl_ground(boxes[..], g[0].t[0..<100]); #assert g[0].t[(side + 1) * 4 + 1] == 0;
  // the earth: one patch for the wall's box, none for the eave, lying a finger over the ground with no cover
  p: [1] ArchPen; arch_pen(p[..], g[0].mesh[..]);
  vl_earth(boxes[..], p[..]);
  #assert p[0].n == 6;
  for k: 0..<6 { o := k * ARCH_VERTEX_FLOATS; m := g[0].mesh[..]; #assert m[o + 1] > 0.005 && m[o + 1] < 0.03 && m[o] >= 2.49 && m[o] <= 3.51 && m[o + 2] <= -10.49 && m[o + 2] >= -11.51 && m[o + 4] == 1 && m[o + 6] == ARCH_M_GROUND && m[o + 7] == 0 && m[o + 8] == 0; }
}
