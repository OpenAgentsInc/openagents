WS_BROOK :: [3] f32.[0.26, 0.46, 0.52];   // the kit stream's teal, so it reads as water in the warm light
WS_SPILL :: [3] f32.[0.7, 0.8, 0.74];
WS_BARK :: [3] f32.[0.36, 0.22, 0.12];
