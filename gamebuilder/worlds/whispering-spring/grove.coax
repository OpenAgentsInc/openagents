// The Whispering Spring's grove: one composed shot of a low-poly Texas Hill Country grove at golden
// hour. A blue-green pool at the foot of a tall, banded umber cut bank with roots over its face;
// the pool spills over a low limestone step into a brook that runs toward you. Twisted live-oak and
// cedar trunks frame the shot and reach six bare limbs over it, where visitors hang prayer ribbons.
// Low-poly boulders and spiky agave clumps sit round the edges. Broad flat-shaded facets in a
// restrained palette (olive, walnut, pale limestone, muted blue-green), built once with the
// Metaverse Engine's mesh pen. Where everything stands is in PLAN.md's table and here.
//   coax/bin/coax test gamebuilder/worlds/whispering-spring/world-spring.coax --library
#load "../../../metaverse-engine/arch/solid.coax";
#load "../../../metaverse-engine/core/points.coax";

WS_PI :: 3.14159265;
WS_TAU :: 6.2831853;

// ---- the layout (metres; +y up; the camera looks toward -z)
WS_POOL_X :: 0.4;   WS_POOL_Z :: -1.9;    // the middle of the kit's pool (for ripples, the plume, the spot)
WS_POOL_RX :: 2.0;  WS_POOL_RZ :: 1.1;
WS_WATER_Y :: 0.0;   // the kit's pool surface once placed
WS_KIT :: [3] f32.[0.0, -0.55, 3.2];   // where the kit's scene sits in the grove (its pool and bank line up at this offset)
WS_STREAM_Y :: -0.47;   // the kit's stream below the spill sheet, once placed
// the spill: a low limestone step at the pool's front right, the brook running on toward the camera
WS_LIP_X :: 0.1;    WS_LIP_Z :: 0.0;    WS_LIP_YAW :: 0.0;   // the kit's spillway sill, along x
// the creek stones, near the camera at the front left, clear of the quail's strip and its sight lines
WS_PILE_X :: -2.6;  WS_PILE_Z :: 4.5;
WS_CAIRN_X :: -3.75; WS_CAIRN_Z :: 3.9; WS_CAIRN_TOP :: 0.19; WS_CAIRN_HW :: 0.52;
// More cairns along the grove, each a slab with its own pile of five creek stones beside it:
// the spring's (the first), the woodland's, the meadow's, the golden field's, and the mandala's edge.
WS_CAIRNS :: 5;
WS_CAIRN_AT :: [WS_CAIRNS * 2] f32.[-3.75, 3.9,  -15.5, 3.6,  14.5, 3.4,  30.5, 3.8,  -24.0, 4.6];
WS_PILE_DX :: 1.15; WS_PILE_DZ :: 0.6;   // each pile sits this far from its slab (the first: WS_PILE_X, WS_PILE_Z)
ws_cairn_top_at :: (k: int) -> f32 {
  if k <= 0 { return WS_CAIRN_TOP; }
  return ws_ground_y(WS_CAIRN_AT[k * 2], WS_CAIRN_AT[k * 2 + 1]) + 0.11;
}
ws_near_cairn :: (x: f32, z: f32, r: f32) -> bool {
  for k: 0..<WS_CAIRNS {
    cx: f32 = WS_CAIRN_AT[k * 2]; cz: f32 = WS_CAIRN_AT[k * 2 + 1];
    dx := x - cx; dz := z - cz; px := x - cx - f32(WS_PILE_DX); pz := z - cz - f32(WS_PILE_DZ);
    if dx * dx + dz * dz < r * r || px * px + pz * pz < r * r { return true; }
  }
  return false;
}
// The quail's range: the near bank left of the stream, with nothing in it or between it and the camera.
WS_RANGE :: [4] f32.[-3.5, 0.4, -1.95, 2.7];   // x0, z0, x1, z1
// Where the quail goes to give each clue (inside its range): stones, ribbon, pool.
WS_CLUE_AT :: [6] f32.[-3.1, 2.55,  -3.1, 0.6,  -2.1, 0.55];
// The spout: a carved limestone mouth in the bank above the pool, the water falling from its lip
// into the pool's back (world-spring.coax draws the moving water).
WS_SPOUT :: [3] f32.[0.4, 1.4, -4.07];         // the mouth's middle, on the kit bank's face
WS_SPOUT_LIP :: [3] f32.[0.4, 1.25, -3.77];    // where the water leaves the stone
WS_SPOUT_FALL :: [3] f32.[0.4, 0.0, -3.0];     // where it meets the pool
// The interaction spots the pointer and keyboard pick: x, y, z, radius. The quail's spot moves with it.
WS_SPOT_POOL :: 0; WS_SPOT_STONES :: 1; WS_SPOT_BRANCH :: 2; WS_SPOT_QUAIL :: 3; WS_SPOTS :: 4;
WS_SPOT :: [12] f32.[0.4, 0.05, -1.9, 1.4,   -3.1, 0.3, 4.3, 0.9,   -2.7, 2.35, -1.0, 0.95];
// What the camera aims at, and the box every frame must show (x0, y0, z0, x1, y1, z1).
WS_AIM :: [3] f32.[0.0, 1.35, -0.8];   // a low camera, looking a little up
WS_SAFE :: [6] f32.[-4.95, 0.0, -3.7, 3.4, 3.1, 3.05];

