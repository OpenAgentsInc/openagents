  -37.0, 1.0, 0.0, 6.4, 1.9, 59,  0.2, 0.0,    // the one past the mandala,
   40.0, 0.6, 0.0, 6.2, 1.8, 61, -0.1, 0.1];   // and the open field's
WS_TREE_CLUMPS :: 7;

