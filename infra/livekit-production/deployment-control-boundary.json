{
  "schemaVersion": "openagents.livekit_deployment_control.v1",
  "project": "openagentsgemini",
  "region": "us-central1",
  "trigger": "oa-livekit-prod-runtime",
  "serviceAccount": "oa-livekit-prod-deployer",
  "sourceConnection": "oa-livekit-github",
  "sourceRepository": "projects/openagentsgemini/locations/us-central1/connections/oa-livekit-github/repositories/openagents",
  "sourceRemoteUri": "https://github.com/OpenAgentsInc/openagents.git",
  "legacyAutomation": "oa-mvp-automation",
  "legacyDefaultComputeServiceAccount": "157437760789-compute",
  "requiredBuildIdentityPolicies": [
    "cloudbuild.useBuildServiceAccount=false",
    "cloudbuild.useComputeServiceAccount=false"
  ],
  "privilegedIdentityDenyPolicy": "deny-legacy-livekit-privileged-impersonation",
  "privilegedIdentityTag": "openagentsgemini/livekit-privileged-identity/protected",
  "sourceRef": "refs/heads/main",
  "operation": "production-runtime-apply",
  "clusterCredentialRoute": "gke_connect_gateway",
  "receiptBucket": "openagentsgemini-livekit-deployment-receipts",
  "maximumBuildSeconds": 5400,
  "callerSubstitutions": [],
  "callerIamGrants": []
}
