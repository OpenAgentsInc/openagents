{
  "displayName": "OpenAgents LiveKit production",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Active rooms",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(livekit_room_total)"
                }
              }
            ],
            "yAxis": {
              "label": "rooms",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Participants",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(livekit_participant_total)"
                }
              }
            ],
            "yAxis": {
              "label": "participants",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Participant join failures",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(livekit_participant_join_total{state!=\"success\"}[5m]))"
                }
              }
            ],
            "yAxis": {
              "label": "failures/sec",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Packet loss ratio",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(livekit_packet_loss_total[5m])) / clamp_min(sum(rate(livekit_packet_total[5m])), 1)"
                }
              }
            ],
            "yAxis": {
              "label": "ratio",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
