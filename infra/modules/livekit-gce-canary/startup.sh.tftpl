#!/bin/bash
set -euo pipefail
umask 077

readonly metadata_root="http://metadata.google.internal/computeMetadata/v1"
readonly secret_root="https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets"
readonly runtime_dir="/run/openagents-livekit-canary"

mkdir -p "$runtime_dir"
mountpoint -q "$runtime_dir" || mount -t tmpfs -o nodev,nosuid,noexec,mode=0700 tmpfs "$runtime_dir"

access_token="$(
  curl --fail --silent --show-error \
    --header "Metadata-Flavor: Google" \
    "$metadata_root/instance/service-accounts/default/token" |
    sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p'
)"

fetch_secret() {
  local secret_id="$1"
  local destination="$2"
  local response
  local encoded

  response="$(
    curl --fail --silent --show-error \
      --header "Authorization: Bearer $access_token" \
      "$secret_root/$secret_id/versions/latest:access"
  )"
  encoded="$(printf '%s' "$response" | tr -d '\n' | sed -n 's/.*"data"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  test -n "$encoded"
  printf '%s' "$encoded" | tr '_-' '/+' | base64 --decode >"$destination"
  chmod 0400 "$destination"
}

fetch_secret "${api_key_secret_id}" "$runtime_dir/api-key"
fetch_secret "${api_secret_secret_id}" "$runtime_dir/api-secret"
fetch_secret "${tls_certificate_secret_id}" "$runtime_dir/tls.crt"
fetch_secret "${tls_private_key_secret_id}" "$runtime_dir/tls.key"
unset access_token

api_key="$(tr -d '\r\n' <"$runtime_dir/api-key")"
api_secret="$(tr -d '\r\n' <"$runtime_dir/api-secret")"
test -n "$api_key"
test -n "$api_secret"

cat >"$runtime_dir/livekit.yaml" <<EOF
port: 7880
log_level: info
prometheus:
  port: 6789
rtc:
  tcp_port: ${tcp_fallback_port}
  port_range_start: ${media_udp_port_start}
  port_range_end: ${media_udp_port_end}
  use_external_ip: true
keys:
  "$api_key": "$api_secret"
room:
  auto_create: false
turn:
  enabled: true
${turn_udp_config}
  tls_port: ${turn_tls_port}
  domain: ${turn_domain}
  cert_file: /run/livekit/tls.crt
  key_file: /run/livekit/tls.key
EOF
chmod 0400 "$runtime_dir/livekit.yaml"
unset api_key api_secret

cat >"$runtime_dir/Caddyfile" <<'EOF'
:443 {
  tls /run/livekit/tls.crt /run/livekit/tls.key
  reverse_proxy 127.0.0.1:7880
}
EOF
chmod 0400 "$runtime_dir/Caddyfile"

systemctl start docker
docker pull "${livekit_server_image}"
docker pull "${reverse_proxy_image}"

docker run \
  --detach \
  --name livekit-server \
  --network host \
  --restart unless-stopped \
  --read-only \
  --security-opt no-new-privileges \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m \
  --volume "$runtime_dir:/run/livekit:ro" \
  "${livekit_server_image}" \
  --config /run/livekit/livekit.yaml

docker run \
  --detach \
  --name livekit-tls-proxy \
  --network host \
  --restart unless-stopped \
  --read-only \
  --security-opt no-new-privileges \
  --tmpfs /config:rw,noexec,nosuid,nodev,size=16m \
  --tmpfs /data:rw,noexec,nosuid,nodev,size=64m \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=32m \
  --volume "$runtime_dir:/run/livekit:ro" \
  "${reverse_proxy_image}" \
  run --config /run/livekit/Caddyfile --adapter caddyfile
