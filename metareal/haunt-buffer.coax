// The binary GPU span gate. No GPU address is formed before this passes.
#authority;
#test "whole triangles in a nonempty bounded vertex span" {
 v:[48]u8;i:[12]u8;
 #assert metareal_haunt_buffer_ok(v[..],i[..],1);
 #assert !metareal_haunt_buffer_ok(v[0..<47],i[..],1);
 #assert !metareal_haunt_buffer_ok(v[..],i[0..<11],1);
 #assert !metareal_haunt_buffer_ok(v[0..<0],i[..],1);
 #assert !metareal_haunt_buffer_ok(v[..],i[0..<0],1);
 i[0]=1;#assert !metareal_haunt_buffer_ok(v[..],i[..],1);i[0]=0;
 v[35]=1;#assert !metareal_haunt_buffer_ok(v[..],i[..],1);
}
#forall "each vertex scalar rejects a non-finite value" k:0..<8 {
 v:[48]u8;i:[12]u8;v[k*4+2]=128;v[k*4+3]=127;
 #assert !metareal_haunt_buffer_ok(v[..],i[..],1);
}
#forall "every index byte is included" k:0..<4 {
 v:[48]u8;i:[12]u8;i[k]=1;
 #assert !metareal_haunt_buffer_ok(v[..],i[..],1);
}
#forall "all three indices are checked" k:0..<3 {
 v:[48]u8;i:[12]u8;i[k*4]=1;
 #assert !metareal_haunt_buffer_ok(v[..],i[..],1);
}
#test "layer and scalar edge gates" {
 #assert !metareal_haunt_buffer_sizes(48,12,0);#assert !metareal_haunt_buffer_sizes(48,12,65);
 #assert metareal_haunt_buffer_sizes(48,12,64);#assert metareal_haunt_buffer_sizes(48,12,1);
 #assert !metareal_haunt_buffer_sizes(16777217,12,1);#assert !metareal_haunt_buffer_sizes(48,16777217,1);
 #assert !metareal_haunt_buffer_sizes(-48,12,1);#assert !metareal_haunt_buffer_sizes(48,-12,1);
}
hb_limits :: (vertices:int,indices:int,layers:int)->bool {
 return vertices>0 && vertices<=16777216 && indices>0 && indices<=16777216 && layers>0 && layers<=64;
}
metareal_haunt_buffer_sizes :: (vertices:int,indices:int,layers:int)->bool #export_c {
 return hb_limits(vertices,indices,layers) && vertices%48==0 && indices%12==0;
}
hb_word :: (b:[]u8,k:int)->u32 {return cast(u32)b[k]|cast(u32)b[k+1]<<8|cast(u32)b[k+2]<<16|cast(u32)b[k+3]<<24;}
metareal_haunt_buffer_ok :: (v:[]u8,i:[]u8,layers:int)->bool #export_c {
 if !metareal_haunt_buffer_sizes(v.count,i.count,layers){return false;}
 for k:0..<v.count/48 {
  base:=k*48;
  if !hb_scalar(v,base) || !hb_scalar(v,base+4) || !hb_scalar(v,base+8) || !hb_scalar(v,base+12) || !hb_scalar(v,base+16) || !hb_scalar(v,base+20) || !hb_scalar(v,base+24) || !hb_scalar(v,base+28){return false;}
  if cast(int)v[k*48+35]>=layers{return false;}
 }
 for k:0..<i.count/4 {if cast(int)hb_word(i,k*4)>=v.count/48{return false;}}
 return true;
}

#test "raw span budget boundaries are independent of stride" {
 #assert hb_limits(1,1,1);#assert !hb_limits(0,1,1);#assert !hb_limits(1,0,1);
 #assert hb_limits(16777216,16777216,64);#assert !hb_limits(16777217,1,1);#assert !hb_limits(1,16777217,1);
}
#test "little endian words and scalar upper boundary" {
 word:=[4]u8.[0x78,0x56,0x34,0x12];#assert hb_word(word[..],0)==0x12345678;
 v:[48]u8;i:[12]u8;v[2]=0x74;v[3]=0x49;v[1]=0x24;
 #assert metareal_haunt_buffer_ok(v[..],i[..],1);
 v[0]=1;#assert !metareal_haunt_buffer_ok(v[..],i[..],1);
}
#test "colour bytes are not mistaken for a ninth scalar" {
 v:[48]u8;i:[12]u8;v[32]=255;v[33]=255;v[34]=255;
 #assert metareal_haunt_buffer_ok(v[..],i[..],1);
}
#test "second vertex uses the exact byte stride and texture slice" {
 v:[96]u8;i:[12]u8;v[50]=128;v[51]=127;
 #assert !metareal_haunt_buffer_ok(v[..],i[..],1);
 v[50]=0;v[51]=0;v[83]=1;#assert !metareal_haunt_buffer_ok(v[..],i[..],1);
}

hb_scalar :: (v:[]u8,at:int)->bool {return (hb_word(v,at)&0x7fffffff)<=0x49742400;}
#test "draws stay in actual index memory, including their last index" {
 #assert metareal_haunt_draw_range(0,3,3);#assert metareal_haunt_draw_range(3,3,6);
 #assert !metareal_haunt_draw_range(-1,3,6);#assert !metareal_haunt_draw_range(0,0,3);
 #assert !metareal_haunt_draw_range(0,4,6);#assert !metareal_haunt_draw_range(0,3,2);
 #assert !metareal_haunt_draw_range(4,3,6);#assert !metareal_haunt_draw_range(0,3,-1);
}
hb_draw_budget :: (first:int,count:int,total:int)->bool {return first>=0 && count>0 && count<=total && first<=total-count;}
metareal_haunt_draw_range :: (first:int,count:int,total:int)->bool #export_c {return hb_draw_budget(first,count,total) && count%3==0;}
#test "draw span gates a single element independently of triangles" {#assert hb_draw_budget(0,1,1);#assert !hb_draw_budget(0,0,1);}
