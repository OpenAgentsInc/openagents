// Haunted House's linear-light material functions, emitted directly as Metal.
hl_min :: (a:f32,b:f32)->f32 {if a<b{return a;}return b;}
hl_max :: (a:f32,b:f32)->f32 {if a>b{return a;}return b;}
metareal_haunt_attenuate :: (d:f32,r:f32)->f32 #export_c {q:=hl_max(0.0f32,1.0f32-d/hl_max(r,0.01f32));return q*q;}
metareal_haunt_ambient :: (ny:f32,channel:f32)->f32 #export_c {
 sky:=ifx channel<0.5f32 then 0.08f32 else ifx channel<1.5f32 then 0.09f32 else 0.15f32;
 ground:=ifx channel<0.5f32 then 0.03f32 else ifx channel<1.5f32 then 0.025f32 else 0.02f32;
 return ground+(sky-ground)*(ny*0.5f32+0.5f32);
}
metareal_haunt_shade :: (albedo:f32,light:f32,glow:f32,distance:f32,channel:f32,flash:f32)->f32 #export_c {
 fog:=1.0f32-exp(-distance*distance*0.000121f32);
 fogcolor:=ifx channel<0.5f32 then 0.035f32 else ifx channel<1.5f32 then 0.04f32 else 0.07f32;
 lit:=albedo*(light+glow*2.0f32+flash*2.0f32)*1.3f32;
 return lit+(fogcolor-lit)*fog;
}
#test "point lights end at their radius" {#assert metareal_haunt_attenuate(5.0f32,5.0f32)==0.0f32;#assert metareal_haunt_attenuate(0.0f32,5.0f32)==1.0f32;}
