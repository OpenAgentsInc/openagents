// Metareal's native home. Scene generation, animation, layout, touch ownership
// and protobuf admission run in Coax. The host owns bounded memory/GPU handles.
// Port source: the native home/graph and HUD in the engine source archive.

#import_proto "../proto/descriptors/ios-home.pb" as Home;

host_load :: (h: int, slot: int) -> f64 #foreign;
host_store :: (h: int, slot: int, value: f64) #foreign;
host_byte :: (h: int, index: int) -> int #foreign;
host_size :: (h: int) -> int #foreign;
host_dot :: (h: int, x: f64, y: f64, size: f64, light: f64, soft: f64, crisp: f64) #foreign;
host_line :: (h: int, ax: f64, ay: f64, bx: f64, by: f64, light_a: f64, light_b: f64, width: f64) #foreign;
host_bar :: (h: int, x: f64, y: f64, width: f64, height: f64, press: f64, flash: f64) #foreign;
host_label_byte :: (h: int, index: int, value: int) #foreign;
host_output_reset :: (h: int) #foreign;
host_output_byte :: (h: int, value: int) #foreign;

CELL_CAPACITY :: 105000;
NODES :: 256;
NODE_STRIDE :: 12;
LINKS :: 25088;
LINK_STRIDE :: 10;
MOTES :: 67000;
MOTE_STRIDE :: 8;

minimum :: (a: f64, b: f64) -> f64 { if a < b { return a; } return b; }
maximum :: (a: f64, b: f64) -> f64 { if a > b { return a; } return b; }
clamp :: (a: f64, low: f64, high: f64) -> f64 { return minimum(high, maximum(low, a)); }
smooth :: (a: f64, b: f64, x: f64) -> f64 { t := clamp((x-a)/(b-a),0.0,1.0); return t*t*(3.0-2.0*t); }
get_int :: (h: int, slot: int) -> int { return int(host_load(h,slot)); }
set_int :: (h: int, slot: int, value: int) { host_store(h,slot,f64(value)); }

// Xorshift32 exactly matches the source's unsigned seed/shift sequence.
random :: (h: int) -> f64 {
  a := get_int(h,0);
  a = (a ^ (a << 13)) & 4294967295;
  a = a ^ (a >> 17);
  a = (a ^ (a << 5)) & 4294967295;
  set_int(h,0,a);
  return f64(a >> 8) / 16777216.0;
}
range :: (h: int, a: f64, b: f64) -> f64 { return a + (b-a)*random(h); }

// The generated codec owns wire validation; this is the screen's closed
// schema-1 admission policy. Host bytes are copied once into bounded scratch
// storage; decoded views never escape this initialization call.
admit_config :: (h: int) -> bool {
  count:=host_size(h);
  if count<1 || count>1024 {return false;}
  scratch:[1024] u8;
  for index:0..<count {
    value:=host_byte(h,index);
    if value<0 || value>255 {return false;}
    scratch[index]=cast(u8)value;
  }
  config:=Home_HomeConfiguration_decode_minimal(scratch[0..<count]);
  if config.error!=0 {return false;}
  if !Home_HomeConfiguration_unknown(config,0).done {return false;}
  version:=Home_HomeConfiguration_get_schema_version(config);
  seed:=Home_HomeConfiguration_get_seed(config);
  motes:=Home_HomeConfiguration_get_mote_count(config);
  satellites:=Home_HomeConfiguration_get_satellite_count(config);
  start:=Home_HomeConfiguration_get_start(config);
  if version.value!=1 || seed.value==0 || motes.value>4096 || satellites.value>8 {return false;}
  action:=start.value;
  if !Home_HudAction_unknown(action,0).done {return false;}
  id:=Home_HudAction_get_id(action);
  label:=Home_HudAction_get_label(action);
  enabled:=Home_HudAction_get_enabled(action);
  shown:=Home_HudAction_get_shown(action);
  // The old resource subset did not allow the transient pressed field at all.
  if Home_HudAction_get_pressed(action).present {return false;}
  if id.value!="home.start" || !enabled.value || !shown.value {return false;}
  if label.value.count<1 || label.value.count>32 {return false;}
  for value:label.value {if value<32 || value>126 {return false;}}
  // The resident bridge stores label bytes, never a pointer into scratch.
  for index:0..<33 {host_label_byte(h,index,0);}
  for value,index:label.value {host_label_byte(h,index,cast(int)value);}
  set_int(h,20,cast(int)seed.value);
  set_int(h,21,cast(int)motes.value);
  set_int(h,22,cast(int)satellites.value);
  return true;
}

node :: (h: int, cluster: int, x: f64, y: f64, px: f64, brightness: f64, crisp: f64, reveal: f64) -> int {
  n := get_int(h,1);
  if n >= 2048 { set_int(h,11,1); return 0; }
  at := NODES+n*NODE_STRIDE;
  host_store(h,at,x); host_store(h,at+1,y); host_store(h,at+2,f64(cluster));
  host_store(h,at+3,px); host_store(h,at+4,brightness); host_store(h,at+5,crisp); host_store(h,at+6,reveal);
  set_int(h,1,n+1);
  return n;
}
polar :: (h: int, c: int, radius: f64, degrees: f64, px: f64, bright: f64, crisp: f64, reveal: f64) -> int {
  a := degrees*0.017453293;
  return node(h,c,radius*cos(a),radius*sin(a),px,bright,crisp,reveal);
}
link :: (h: int, a: int, b: int, intensity: f64, travel: f64, reveal: f64, rate: f64) {
  n := get_int(h,2);
  if n >= 4096 { set_int(h,11,1); return; }
  at := LINKS+n*LINK_STRIDE;
  set_int(h,at,a); set_int(h,at+1,b); host_store(h,at+2,intensity); host_store(h,at+3,travel);
  host_store(h,at+4,reveal); host_store(h,at+5,rate); host_store(h,at+6,0.0);
  set_int(h,2,n+1);
}
nearest :: (h: int, id: int, from: int, to: int) -> int {
  x := host_load(h,NODES+id*NODE_STRIDE); y := host_load(h,NODES+id*NODE_STRIDE+1);
  best := from; distance := 100000.0; i := from;
  while i < to {
    dx := host_load(h,NODES+i*NODE_STRIDE)-x; dy := host_load(h,NODES+i*NODE_STRIDE+1)-y;
    d := dx*dx+dy*dy;
    if d < distance { distance = d; best = i; }
    i += 1;
  }
  return best;
}
arc :: (h: int, c: int, cx: f64, cy: f64, r: f64, from: f64, to: f64, dots: int, px: f64, bright: f64, crisp: f64, at: f64, sweep: f64) -> int {
  start := get_int(h,1); i := 0;
  while i < dots {
    k := f64(i)/f64(dots-1); angle := (from+(to-from)*k)*0.017453293;
    tint := random(h); // Retain the original RNG step even in monochrome.
    id := node(h,c,cx+r*cos(angle),cy+r*sin(angle),px,bright*(0.8+0.4*random(h)),crisp,at+sweep*k);
    i += 1;
  }
  return start;
}
sheaf :: (h: int, start: int, end: int, targets: int, target_end: int, intensity: f64, rate: f64) {
  i := start;
  while i < end {
    target := nearest(h,i,targets,target_end);
    link(h,i,target,intensity,2.0,host_load(h,NODES+i*NODE_STRIDE+6)+0.3,rate);
    i += 1;
  }
}
fan :: (h: int, start: int, end: int, focus: int, intensity: f64, rate: f64) {
  i := start;
  while i < end { link(h,i,focus,intensity,2.5,host_load(h,NODES+i*NODE_STRIDE+6)+0.3,rate); i += 1; }
}
main_graph :: (h: int) -> int {
  hub := node(h,0,0.0,0.0,22.0,1.9,1.0,0.2);
  grey_from := get_int(h,1); i := 0;
  while i < 8 {
    angle := 22.0;
    if i == 1 { angle = 64.0; } else if i == 2 { angle = 112.0; } else if i == 3 { angle = 152.0; }
    else if i == 4 { angle = 198.0; } else if i == 5 { angle = 236.0; } else if i == 6 { angle = 292.0; } else if i == 7 { angle = 332.0; }
    r := range(h,0.15,0.31);
    id := polar(h,0,r,angle+range(h,-8.0,8.0),10.0,0.30,1.0,0.45+r*2.0);
    link(h,hub,id,0.16,1.0,0.35+r*2.0,0.3); i += 1;
  }
  grey_to := get_int(h,1);
  c1 := node(h,0,0.20,0.0,9.0,0.32,1.0,0.7);
  c2 := node(h,0,0.42,-0.01,9.0,1.0,1.0,0.9);
  focus := node(h,0,0.64,-0.01,5.0,1.5,1.0,1.1);
  link(h,hub,c1,0.22,1.0,0.6,1.2); link(h,c1,c2,0.22,1.0,0.8,1.2); link(h,c2,focus,0.22,1.0,1.0,1.2);
  i = 0;
  while i < 6 { id := node(h,0,0.46+0.03*f64(i),-0.01+range(h,-0.008,0.008),2.5,0.7,0.3,1.2+0.05*f64(i)); i += 1; }
  d1 := node(h,0,0.03,-0.30,9.0,0.32,1.0,0.8);
  down := node(h,0,0.02,-0.60,9.0,1.0,1.0,1.1);
  link(h,hub,d1,0.2,1.0,0.7,0.8); link(h,d1,down,0.2,1.0,0.9,0.8);
  i = 0;
  while i < 3 {
    x := 0.22; y := 0.36;
    if i == 1 { x = 0.26; y = -0.34; } else if i == 2 { x = 0.12; y = 0.50; }
    id := node(h,0,x,y,8.0,0.9,1.0,1.3); link(h,nearest(h,id,grey_from,grey_to),id,0.14,1.0,1.2,0.25); i += 1;
  }
  agents := arc(h,0,0.0,0.0,0.44,100.0,252.0,24,7.5,0.9,0.8,1.2,1.0);
  agent_end := get_int(h,1); sheaf(h,agents,agent_end,grey_from,grey_to,0.10,0.05);
  a := arc(h,0,0.0,0.0,0.60,104.0,160.0,30,3.6,0.6,0.8,2.0,0.6); sheaf(h,a,get_int(h,1),agents,agent_end,0.045,0.015);
  a = arc(h,0,0.0,0.0,0.60,166.0,214.0,26,3.6,0.6,0.8,2.4,0.5); sheaf(h,a,get_int(h,1),agents,agent_end,0.045,0.015);
  a = arc(h,0,0.0,0.0,0.60,220.0,262.0,24,3.6,0.6,0.8,2.8,0.5); sheaf(h,a,get_int(h,1),agents,agent_end,0.045,0.015);
  a = arc(h,0,0.0,0.0,0.80,68.0,106.0,16,5.5,0.8,0.8,2.6,0.5); fan(h,a,get_int(h,1),agent_end-1,0.05,0.03);
  a = arc(h,0,0.0,0.0,0.86,240.0,292.0,44,4.5,0.75,0.8,3.0,0.8); fan(h,a,get_int(h,1),down,0.028,0.02);
  a = arc(h,0,0.24,0.0,0.70,-62.0,62.0,76,3.0,0.6,0.8,3.2,1.0); fan(h,a,get_int(h,1),focus,0.03,0.025);
  a = arc(h,0,0.0,0.0,0.64,22.0,92.0,46,3.0,0.45,0.8,2.2,0.7);
  a = arc(h,0,0.0,0.0,0.64,300.0,332.0,14,3.0,0.45,0.8,3.0,0.4);
  i = 0;
  while i < 40 {
    r := range(h,0.08,0.56); id := polar(h,0,r,range(h,0.0,360.0),2.5,range(h,0.3,0.7),0.3,1.0+r*3.0); i += 1;
  }
  return hub;
}

satellite :: (h: int, c: int, at: f64) -> int {
  hub := node(h,c,0.0,0.0,13.0,1.4,1.0,at);
  inner := get_int(h,1); count := 2+int(range(h,0.0,2.0)); turn := range(h,0.0,360.0); i := 0;
  while i < count {
    radius := range(h,0.16,0.28); angle := turn+360.0*f64(i)/f64(count)+range(h,-20.0,20.0);
    n := polar(h,c,radius,angle,9.0,0.3,1.0,at+0.2); link(h,hub,n,0.15,1.0,at+0.1,0.2); i += 1;
  }
  inner_end := get_int(h,1); agents := inner_end; count = 3+int(range(h,0.0,3.0)); i = 0;
  while i < count {
    r := range(h,0.42,0.6); angle := range(h,0.0,360.0); tint := range(h,-1.0,0.2);
    n := polar(h,c,r,angle,8.0,0.85,1.0,at+0.4);
    link(h,hub,n,0.12,1.0,at+0.35,0.12); // Each agent is connected through its nearest inner node below.
    set_int(h,LINKS+(get_int(h,2)-1)*LINK_STRIDE,nearest(h,n,inner,inner_end)); i += 1;
  }
  agent_end := get_int(h,1); i = 0;
  while i < 2 {
    from := range(h,0.0,360.0); span := range(h,60.0,130.0); tint := range(h,-1.0,0.6);
    radius := range(h,0.82,0.96);
    start := arc(h,c,0.0,0.0,radius,from,from+span,int(span/6.0),4.0,0.7,0.8,at+0.6,0.6);
    sheaf(h,start,get_int(h,1),agents,agent_end,0.04,0.01); i += 1;
  }
  i = 0;
  while i < 6 { n := polar(h,c,range(h,0.1,0.7),range(h,0.0,360.0),2.5,0.5,0.3,at+0.5); i += 1; }
  return hub;
}

metareal_home_capacity :: () -> int #export_c { return CELL_CAPACITY; }
metareal_home_init :: (h: int) -> bool #export_c {
  i := 0; while i < CELL_CAPACITY { host_store(h,i,0.0); i += 1; }
  if !admit_config(h) { return false; }
  set_int(h,0,get_int(h,20)); host_store(h,42,0.012); host_store(h,30,-1.0);
  hub := main_graph(h); previous := -1; first := -1; i = 0;
  while i < get_int(h,22) {
    angle := 1.5707963+6.2831853*(f64(i)+0.5)/f64(get_int(h,22)); c := i+1;
    host_store(h,40+c*4,0.8*cos(angle)); host_store(h,41+c*4,0.6*sin(angle));
    spin := -0.05; if (i & 1) == 1 { spin = 0.05; } host_store(h,42+c*4,spin);
    at := 6.0+0.55*f64(i); n := satellite(h,c,at);
    link(h,hub,n,0.07,1.0,at-0.2,0.25);
    if previous >= 0 { link(h,previous,n,0.05,1.0,at+0.2,0.1); }
    if first < 0 { first = n; } previous = n; i += 1;
  }
  if get_int(h,22) > 2 { link(h,previous,first,0.05,1.0,6.0+0.55*f64(get_int(h,22)),0.1); }
  i = 0;
  while i < get_int(h,21) {
    at := MOTES+i*MOTE_STRIDE;
    host_store(h,at,random(h)*2.5-1.25); host_store(h,at+1,random(h)*2.5-1.25);
    depth := 1.1+8.0*pow(random(h),1.3); host_store(h,at+2,depth);
    host_store(h,at+3,random(h)*6.2831853);
    kind := random(h); u := random(h); far := 1.0/sqrt(depth);
    if kind < 0.968 {
      host_store(h,at+4,3.0+3.0*u*u); host_store(h,at+5,(0.03+0.2*u*u*u)*far);
      host_store(h,at+6,0.6+1.2*random(h));
    } else if kind < 0.997 {
      host_store(h,at+4,6.0+4.0*u); host_store(h,at+5,(0.3+0.3*u)*far);
      host_store(h,at+6,1.5+2.5*random(h)); host_store(h,at+7,0.1);
    } else {
      host_store(h,at+4,34.0+46.0*u); host_store(h,at+5,0.006+0.010*u);
      host_store(h,at+6,0.3+0.4*random(h)); host_store(h,at+7,1.0);
    }
    i += 1;
  }
  set_int(h,0,get_int(h,20) ^ 2654435769);
  return get_int(h,11) == 0;
}

spawn :: (h: int, id: int, brightness: f64) {
  count := get_int(h,3);
  if count >= 800 { return; }
  at := 100000+count*6; set_int(h,at,id); host_store(h,at+1,0.0); host_store(h,at+2,brightness); set_int(h,3,count+1);
}
update :: (h: int, dt: f64, t: f64) {
  i := 0;
  while i < get_int(h,1) { at := NODES+i*NODE_STRIDE+9; host_store(h,at,host_load(h,at)*exp(-dt*3.5)); i += 1; }
  i = 0;
  while i < get_int(h,3) {
    at := 100000+i*6; l := LINKS+get_int(h,at)*LINK_STRIDE;
    progress := host_load(h,at+1)+dt/host_load(h,l+3);
    if progress >= 1.0 {
      n := NODES+get_int(h,l+1)*NODE_STRIDE+9;
      host_store(h,n,minimum(1.0,host_load(h,n)+0.7*host_load(h,at+2)));
      count := get_int(h,3)-1; j := 0;
      while j < 3 { host_store(h,at+j,host_load(h,100000+count*6+j)); j += 1; }
      set_int(h,3,count);
    } else { host_store(h,at+1,progress); i += 1; }
  }
  i = 0;
  while i < get_int(h,2) {
    at := LINKS+i*LINK_STRIDE; rate := host_load(h,at+5);
    if rate > 0.0 && t >= host_load(h,at+4)+1.0 {
      next := host_load(h,at+6);
      if next == 0.0 { next = t+random(h)/rate; }
      while t >= next { spawn(h,i,0.6+0.4*random(h)); next += -log(maximum(0.0001,random(h)))/rate; }
      host_store(h,at+6,next);
    }
    i += 1;
  }
}

// Reusable HUD bar layout and ownership live in the engine, not the iOS view.
metareal_hud_hits :: (x: f64, y: f64, bx: f64, by: f64, bw: f64, bh: f64, slop: f64) -> bool #export_c {
  return x >= bx-slop && x <= bx+bw+slop && y >= by-slop && y <= by+bh+slop;
}
metareal_hud_touch :: (phase: int, x: f64, y: f64, bx: f64, by: f64, bw: f64, bh: f64, down: bool) -> int #export_c {
  if phase == 0 { if metareal_hud_hits(x,y,bx,by,bw,bh,0.0) { return 1; } return 0; }
  if phase == 1 { if down && metareal_hud_hits(x,y,bx,by,bw,bh,bh*0.6) { return 1; } return 0; }
  if phase == 2 { if down && metareal_hud_hits(x,y,bx,by,bw,bh,bh*0.6) { return 2; } }
  return 0;
}

metareal_home_frame :: (h: int, now: f64, width: f64, height: f64, scale: f64, safe_bottom: f64, reduced: bool) #export_c {
  if width < 1.0 || height < 1.0 || scale < 1.0 || width > 16384.0 || height > 16384.0 { return; }
  last := host_load(h,30); dt := 0.0; if last >= 0.0 { dt = clamp(now-last,0.0,0.1); }
  host_store(h,30,now); t := host_load(h,31)+dt; host_store(h,31,t);
  animation_dt := dt;
  if reduced { t = 20.0; animation_dt = 0.0; }
  if !reduced { update(h,dt,t); }
  short_side := minimum(width,height); px_scale := short_side/600.0;
  radius := short_side*0.5*(0.98-0.36*smooth(4.5,11.0,t)); i := 0;
  // Drift and wrap the original 4000-mote field.
  while i < get_int(h,21) {
    at := MOTES+i*MOTE_STRIDE; x := host_load(h,at); y := host_load(h,at+1);
    depth := host_load(h,at+2); phase := host_load(h,at+3); slow := 1.0/pow(depth,0.8);
    x += (0.006+0.014*sin(y*2.1+t*0.11+phase))*slow*animation_dt;
    y += (0.011+0.009*cos(x*1.7-t*0.09+phase*1.3))*slow*animation_dt;
    if x > 1.25 { x -= 2.5; } else if x < -1.25 { x += 2.5; }
    if y > 1.25 { y -= 2.5; } else if y < -1.25 { y += 2.5; }
    host_store(h,at,x); host_store(h,at+1,y);
    brightness := host_load(h,at+5)*(0.72+0.28*sin(t*host_load(h,at+6)+phase));
    host_dot(h,(x+1.0)*width*0.5,(1.0-y)*height*0.5,host_load(h,at+4)*px_scale,brightness*0.5,host_load(h,at+7),0.0);
    i += 1;
  }
  i = 0;
  while i < get_int(h,1) {
    at := NODES+i*NODE_STRIDE; cluster := get_int(h,at+2);
    angle := host_load(h,42+cluster*4)*t; if reduced { angle = 0.0; }
    r := radius; if cluster > 0 { r = short_side*0.105; }
    gx := host_load(h,at); gy := host_load(h,at+1);
    x := (0.5+host_load(h,40+cluster*4)*0.5)*width+(gx*cos(angle)-gy*sin(angle))*r;
    y := (0.5-host_load(h,41+cluster*4)*0.5)*height-(gx*sin(angle)+gy*cos(angle))*r;
    host_store(h,at+7,x); host_store(h,at+8,y);
    fade := smooth(host_load(h,at+6),host_load(h,at+6)+0.7,t);
    bright := (host_load(h,at+4)+host_load(h,at+9)*1.8)*fade;
    if fade > 0.0 { host_dot(h,x,y,host_load(h,at+3)*px_scale*(1.0+host_load(h,at+5)),bright*0.5,0.0,host_load(h,at+5)); }
    i += 1;
  }
  i = 0;
  while i < get_int(h,2) {
    at := LINKS+i*LINK_STRIDE; a := NODES+get_int(h,at)*NODE_STRIDE; b := NODES+get_int(h,at+1)*NODE_STRIDE;
    fade := smooth(host_load(h,at+4),host_load(h,at+4)+0.9,t);
    if fade > 0.0 {
      ax := host_load(h,a+7); ay := host_load(h,a+8);
      bx := ax+(host_load(h,b+7)-ax)*fade; by := ay+(host_load(h,b+8)-ay)*fade;
      light := host_load(h,at+2)*fade*0.5;
      host_line(h,ax,ay,bx,by,light,light,0.8*px_scale);
    }
    i += 1;
  }
  if !reduced {
    i = 0;
    while i < get_int(h,3) {
      at := 100000+i*6; l := LINKS+get_int(h,at)*LINK_STRIDE;
      a := NODES+get_int(h,l)*NODE_STRIDE; b := NODES+get_int(h,l+1)*NODE_STRIDE;
      progress := host_load(h,at+1); tail := maximum(0.0,progress-0.12);
      ax := host_load(h,a+7); ay := host_load(h,a+8); dx := host_load(h,b+7)-ax; dy := host_load(h,b+8)-ay;
      light := host_load(h,at+2)*smooth(0.0,0.15,progress)*(1.0-smooth(0.85,1.0,progress));
      host_line(h,ax+dx*tail,ay+dy*tail,ax+dx*progress,ay+dy*progress,0.0,light*0.8,1.28*px_scale);
      host_dot(h,ax+dx*progress,ay+dy*progress,4.0*px_scale,light*1.2,0.15,0.0); i += 1;
    }
  }
  hud_out(h,dt,width,height,scale,safe_bottom);
}

// The Start bar alone: laid out at the bottom, pressed and flashing. The
// home draws it over its graph; the Grid's overview (metareal/camera.coax)
// draws it over the Grid.
metareal_home_hud_frame :: (h: int, now: f64, width: f64, height: f64, scale: f64, safe_bottom: f64) #export_c {
  if width < 1.0 || height < 1.0 || scale < 1.0 || width > 16384.0 || height > 16384.0 { return; }
  last := host_load(h,30); dt := 0.0; if last >= 0.0 { dt = clamp(now-last,0.0,0.1); }
  host_store(h,30,now);
  hud_out(h,dt,width,height,scale,safe_bottom);
}

hud_out :: (h: int, dt: f64, width: f64, height: f64, scale: f64, safe_bottom: f64) {
  bx := 20.0*scale; bh := 58.0*scale; bw := maximum(0.0,width-40.0*scale);
  by := maximum(0.0,height-maximum(0.0,safe_bottom)-18.0*scale-bh);
  host_store(h,100,width); host_store(h,101,height); host_store(h,102,scale);
  host_store(h,104,bx); host_store(h,105,by); host_store(h,106,bw); host_store(h,107,bh);
  target := 0.0; if get_int(h,110) == 1 && get_int(h,111) == 1 { target = 1.0; }
  press := host_load(h,112); rate := 9.0; if target > press { rate = 30.0; }
  press += (target-press)*(1.0-exp(-rate*dt)); flash := host_load(h,113)*exp(-3.0*dt);
  host_store(h,112,press); host_store(h,113,flash);
  host_bar(h,bx,by,bw,bh,press,flash);
}

invocation :: (h: int) -> bool {
  host_output_reset(h);
  count:=get_int(h,114);
  if count<1 {return false;}
  // Only request-ID formatting is local; every protobuf byte is generated.
  request:[32] u8;prefix:="home-start-";at:=0;
  for value:prefix {request[at]=value;at+=1;}
  divisor:=1;
  while divisor<=count/10 {divisor*=10;}
  while divisor>0 {request[at]=cast(u8)(48+(count/divisor)%10);at+=1;divisor=divisor/10;}
  first:[512] u8;second:[512] u8;output:[512] u8;
  message:=Home_HudInvocation_new();
  message=Home_HudInvocation_set_schema(message,1,first[..]);
  message=Home_HudInvocation_set_world(message,"home",second[..]);
  message=Home_HudInvocation_set_action_id(message,"home.start",first[..]);
  message=Home_HudInvocation_set_request_id(message,cast(string)request[0..<at],second[..]);
  message=Home_HudInvocation_set_revision(message,cast(u64)count,first[..]);
  encoded:=Home_HudInvocation_encode(message,output[..]);
  if encoded.error!=0 {return false;}
  for value:encoded.wire {host_output_byte(h,cast(int)value);}
  return true;
}
metareal_home_touch :: (h: int, phase: int, x: f64, y: f64) -> bool #export_c {
  down := get_int(h,110) == 1;
  result := metareal_hud_touch(phase,x,y,host_load(h,104),host_load(h,105),host_load(h,106),host_load(h,107),down);
  if phase == 0 {
    set_int(h,110,result); set_int(h,111,result);
    host_store(h,116,x); host_store(h,117,y); set_int(h,118,1-result);
  } else if phase == 1 {
    set_int(h,111,result);
    dx := x-host_load(h,116); dy := y-host_load(h,117);
    if dx*dx+dy*dy > 400.0*host_load(h,102)*host_load(h,102) { set_int(h,118,0); }
  } else {
    set_int(h,110,0); set_int(h,111,0);
    if result == 2 {
      host_store(h,113,1.0); set_int(h,114,get_int(h,114)+1);
      if !invocation(h) {return false;}
      // The host routes this HudInvocation to the Grid (metareal/grid.coax).
      // The home replays behind it.
      host_store(h,31,0.0); set_int(h,3,0);
      i := 0; while i < get_int(h,2) { host_store(h,LINKS+i*LINK_STRIDE+6,0.0); i += 1; }
      return true;
    }
    if phase == 2 && get_int(h,118) == 1 {
      i := 0; best := -1; distance := 4096.0*host_load(h,102)*host_load(h,102);
      while i < get_int(h,1) {
        at := NODES+i*NODE_STRIDE; dx := x-host_load(h,at+7); dy := y-host_load(h,at+8);
        if dx*dx+dy*dy < distance { distance = dx*dx+dy*dy; best = i; } i += 1;
      }
      if best >= 0 { host_store(h,NODES+best*NODE_STRIDE+9,1.0); }
    }
    set_int(h,118,0);
  }
  return false;
}
metareal_home_resume :: (h: int) #export_c { host_store(h,30,-1.0); set_int(h,110,0); set_int(h,111,0); set_int(h,118,0); }
metareal_home_presses :: (h: int) -> int #export_c { return get_int(h,114); }
