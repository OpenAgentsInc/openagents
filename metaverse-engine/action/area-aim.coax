// Area targeting (book chapter 96, #13081): the one module every realm aims, outlines and resolves an
// area of effect through, Everglade's Entangle and Thunderwave, a Fog Cloud or a Moonbeam alike. It
// keeps the SRD's areas of effect (SRD 5.2.1, Rules Glossary) as shapes on the ground:
//   AREA_CIRCLE  a Sphere (or a Cylinder, or an Emanation) seen from above: half is its radius;
//   AREA_SQUARE  a Cube on a point: half is half its side;
//   AREA_BOX     a Cube from you, or any area whose squares are known: the rectangle side0..side1 across
//                and fore0..fore1 ahead of its point, facing (fx, fz) (Thunderwave's cube);
//   AREA_CONE    a Cone from its point: reach long, as wide at each point as that point is far from it;
//   AREA_LINE    a Line from its point: reach long, half its width each side.
// Placing it: pressing such an ability arms it instead of casting. A placed area (a circle or a square)
// lies where the crosshair meets the ground, follows it each frame and is held to the ability's range
// (beyond it, it stops at the range's edge along the same line, marked far so a realm may tint it). An
// area from the caster (a box, a cone or a line) stays on the caster and turns toward the crosshair. A
// confirm casts it there, at exactly the point the preview showed; a cancel (Esc, a right click, the
// slot again) drops it, nothing spent.
// Showing it: area_aim_point walks its outline and then its guides, one point at a time, each with
// whether the pen joins it to the point before. The realm sets each point on its own ground, projects
// it with area_view_at (a pinhole camera's eye and axes) and draws the joined points with its own line.
// Who it holds: area_aim_contains says whether a creature standing at (x, z) is inside it. The
// ruleset still decides what the cast does to them.
//   coax/bin/coax test metaverse-engine/action/area-aim.coax --library

#module "metaverse.engine.action.area_aim";

AREA_CIRCLE :: 0; AREA_SQUARE :: 1; AREA_BOX :: 2; AREA_CONE :: 3; AREA_LINE :: 4;
AREA_EDGE :: 48;           // outline points a realm draws (a multiple of 4: a square's corners land on them)
AREA_GUIDE_STEPS :: 8;     // each guide in pieces, so it follows the ground
AREA_GUIDES :: 6;          // a square's or a box's guides: three across and three along it

AreaAim :: struct {
  on: bool;
  slot: int = -1;          // the realm's ability slot it is for
  shape: int; half: f32;   // a circle's radius, a square's half side, a line's half width (metres)
  range: f32;              // metres from the caster its middle may be
  x: f32; z: f32;          // its point now: a placed area's middle, or the caster under an area from them
  far: bool;               // the crosshair was past the range: the middle stopped at its edge
  armed_at: f32;
  fx: f32 = 0; fz: f32 = 1;          // the way it faces, a unit on the ground
  side0: f32; side1: f32; fore0: f32; fore1: f32;   // a box's rectangle, metres across and ahead of its point
  reach: f32;              // a cone's or a line's length
  until: f32 = -1;         // a realm showing a cast's area after it opened: until when
}
AreaShot :: struct { ok: bool; slot: int = -1; x: f32; z: f32; fx: f32; fz: f32; }

// ---- making one

// Armed for `slot` at time t: nothing cast yet. A placed circle or square.
area_aim_arm :: (slot: int, shape: int, half: f32, range: f32, t: f32) -> AreaAim {
  return AreaAim.{on = true, slot = slot, shape = shape, half = half, range = range, armed_at = t};
}
// A box at (x, z) facing (fx, fz): side0..side1 across it, fore0..fore1 ahead (metres).
area_box :: (x: f32, z: f32, fx: f32, fz: f32, side0: f32, side1: f32, fore0: f32, fore1: f32) -> AreaAim {
  return AreaAim.{on = true, shape = AREA_BOX, x = x, z = z, fx = fx, fz = fz, side0 = side0, side1 = side1, fore0 = fore0, fore1 = fore1};
}
area_cone :: (x: f32, z: f32, fx: f32, fz: f32, reach: f32) -> AreaAim {
  return AreaAim.{on = true, shape = AREA_CONE, x = x, z = z, fx = fx, fz = fz, reach = reach};
}
area_line :: (x: f32, z: f32, fx: f32, fz: f32, reach: f32, half: f32) -> AreaAim {
  return AreaAim.{on = true, shape = AREA_LINE, x = x, z = z, fx = fx, fz = fz, reach = reach, half = half};
}
area_circle :: (x: f32, z: f32, r: f32) -> AreaAim { return AreaAim.{on = true, shape = AREA_CIRCLE, x = x, z = z, half = r}; }
area_square :: (x: f32, z: f32, half: f32) -> AreaAim { return AreaAim.{on = true, shape = AREA_SQUARE, x = x, z = z, half = half}; }
// The same area facing `face` radians (0 is +z), from the caster at (x, z).
area_face :: (a: AreaAim, x: f32, z: f32, face: f32) -> AreaAim { b := a; b.x = x; b.z = z; b.fx = sin(face); b.fz = cos(face); return b; }
// Whether it opens from the caster (and turns) rather than lying where it is placed.
area_from_caster :: (a: AreaAim) -> bool { return a.shape == AREA_BOX || a.shape == AREA_CONE || a.shape == AREA_LINE; }

// ---- placing it

// Each frame: the caster at (cx, cz), the crosshair meeting the ground at (hx, hz).
area_aim_follow :: (a: AreaAim, cx: f32, cz: f32, hx: f32, hz: f32) -> AreaAim {
  if !a.on { return a; }
  b := a; dx := hx - cx; dz := hz - cz; d := sqrt(dx * dx + dz * dz);
  if area_from_caster(a) {
    b.x = cx; b.z = cz; b.far = false;
    if d > 0.0001 { b.fx = dx / d; b.fz = dz / d; }
    return b;
  }
  b.far = d > a.range;
  if b.far && d > 0.0001 { b.x = cx + dx / d * a.range; b.z = cz + dz / d * a.range; } else { b.x = hx; b.z = hz; }
  return b;
}
// Confirm: the cast's point and way, the preview's, and the aim put away.
area_aim_confirm :: (a: [] AreaAim) -> AreaShot {
  if !a[0].on { return AreaShot.{}; }
  r := AreaShot.{ok = true, slot = a[0].slot, x = a[0].x, z = a[0].z, fx = a[0].fx, fz = a[0].fz};
  a[0] = AreaAim.{};
  return r;
}
area_aim_cancel :: (a: [] AreaAim) -> bool { was := a[0].on; a[0] = AreaAim.{}; return was; }

// ---- its outline

// A point across and ahead of the area's point, on the ground (x, z).
area_at :: (a: AreaAim, side: f32, fore: f32) -> [2] f32 {
  return [2] f32.[a.x + side * a.fz + fore * a.fx, a.z - side * a.fx + fore * a.fz];
}
// Its rectangle across and ahead (a square's, a box's, a line's): [side0, side1, fore0, fore1].
area_rect :: (a: AreaAim) -> [4] f32 {
  if a.shape == AREA_BOX { return [4] f32.[a.side0, a.side1, a.fore0, a.fore1]; }
  if a.shape == AREA_LINE { return [4] f32.[-a.half, a.half, 0, a.reach]; }
  return [4] f32.[-a.half, a.half, -a.half, a.half];
}
// Point i of AREA_EDGE round its outline (x, z on the ground): a circle's rim, a rectangle's sides
// (corners on points 0, 12, 24 and 36), a cone's three sides.
area_aim_edge :: (a: AreaAim, i: int) -> [2] f32 {
  if a.shape == AREA_CIRCLE {
    t := f32(i % AREA_EDGE) * 6.2831853 / f32(AREA_EDGE);
    return [2] f32.[a.x + cos(t) * a.half, a.z + sin(t) * a.half];
  }
  if a.shape == AREA_CONE {
    // from its point out the left side, across the far end, back down the right side
    third := AREA_EDGE / 3; e := (i % AREA_EDGE) / third; u := f32(i % third) / f32(third);
    if e == 0 { return area_at(a, -0.5 * a.reach * u, a.reach * u); }
    if e == 1 { return area_at(a, a.reach * (u - 0.5), a.reach); }
    return area_at(a, 0.5 * a.reach * (1 - u), a.reach * (1 - u));
  }
  r := area_rect(a);
  side := AREA_EDGE / 4; e := (i % AREA_EDGE) / side; u := f32(i % side) / f32(side);
  s := ifx e == 0 then r[0] + (r[1] - r[0]) * u else ifx e == 1 then r[1] else ifx e == 2 then r[1] - (r[1] - r[0]) * u else r[0];
  f := ifx e == 0 then r[2] else ifx e == 1 then r[2] + (r[3] - r[2]) * u else ifx e == 2 then r[3] else r[3] - (r[3] - r[2]) * u;
  return area_at(a, s, f);
}
// The points a realm draws: the closed outline, then (a square or a box) its guides, which fill the
// rectangle so the whole of it reads.
area_aim_points :: (a: AreaAim) -> int {
  n := AREA_EDGE + 1;
  if a.shape == AREA_SQUARE || a.shape == AREA_BOX { n += AREA_GUIDES * (AREA_GUIDE_STEPS + 1); }
  return n;
}
// Point p of them, (x, z) on the ground.
area_aim_point :: (a: AreaAim, p: int) -> [2] f32 {
  if p <= AREA_EDGE { return area_aim_edge(a, p); }
  q := p - AREA_EDGE - 1; g := q / (AREA_GUIDE_STEPS + 1); u := f32(q % (AREA_GUIDE_STEPS + 1)) / f32(AREA_GUIDE_STEPS);
  r := area_rect(a); w := f32(g % 3 + 1) / 4;
  if g < 3 { return area_at(a, r[0] + (r[1] - r[0]) * w, r[2] + (r[3] - r[2]) * u); }   // along it
  return area_at(a, r[0] + (r[1] - r[0]) * u, r[2] + (r[3] - r[2]) * w);                 // across it
}
// Whether the pen joins point p to the one before it (each guide starts afresh).
area_aim_joined :: (a: AreaAim, p: int) -> bool {
  if p == 0 { return false; }
  if p <= AREA_EDGE { return true; }
  return (p - AREA_EDGE - 1) % (AREA_GUIDE_STEPS + 1) != 0;
}
// Whether point p is on a guide (a realm draws those finer) rather than the outline.
area_aim_guide :: (p: int) -> bool { return p > AREA_EDGE; }

// ---- who it holds

// Whether a creature standing at (x, z) is inside it.
area_aim_contains :: (a: AreaAim, x: f32, z: f32) -> bool {
  if !a.on { return false; }
  dx := x - a.x; dz := z - a.z;
  if a.shape == AREA_CIRCLE { return dx * dx + dz * dz <= a.half * a.half; }
  side := dx * a.fz - dz * a.fx; fore := dx * a.fx + dz * a.fz;
  if a.shape == AREA_CONE { return fore > 0 && fore <= a.reach && side <= fore * 0.5 && side >= -fore * 0.5; }
  r := area_rect(a);
  return side >= r[0] && side < r[1] && fore >= r[2] && fore < r[3];
}

// ---- seeing it

// A pinhole camera: its eye, its forward, right and up axes, its focal length in pixels and the
// screen point straight ahead.
AreaView :: struct { eye: [3] f32; fwd: [3] f32; right: [3] f32; up: [3] f32; focal: f32; cx: f32; cy: f32; near: f32 = 0.2; }
AreaAt :: struct { x: f32; y: f32; ok: bool; }
// Where the world point (wx, wy, wz) lands on the screen; not ok behind the near plane.
area_view_at :: (v: AreaView, wx: f32, wy: f32, wz: f32) -> AreaAt {
  dx := wx - v.eye[0]; dy := wy - v.eye[1]; dz := wz - v.eye[2];
  ahead := dx * v.fwd[0] + dy * v.fwd[1] + dz * v.fwd[2];
  if ahead < v.near { return AreaAt.{}; }
  return AreaAt.{x = v.cx + v.focal * (dx * v.right[0] + dy * v.right[1] + dz * v.right[2]) / ahead,
                 y = v.cy - v.focal * (dx * v.up[0] + dy * v.up[1] + dz * v.up[2]) / ahead, ok = true};
}

#test "area aim: follows the crosshair, held to its range; confirm casts at the preview; cancel spends nothing" {
  a := area_aim_arm(3, AREA_SQUARE, 3.048, 27.432, 1);
  #assert a.on && a.slot == 3;
  a = area_aim_follow(a, 0, 0, 5, 10);
  #assert a.x == 5 && a.z == 10 && !a.far;
  // 50 m off: held at 90 feet along the same line
  a = area_aim_follow(a, 0, 0, 0, -50);
  #assert a.far && abs(a.x) < 0.001 && abs(a.z + 27.432) < 0.001;
  // its outline: a square's corners on it, every point on its sides
  for i: 0..<AREA_EDGE { p := area_aim_edge(a, i); #assert abs(abs(p[0] - a.x) - 3.048) < 0.001 || abs(abs(p[1] - a.z) - 3.048) < 0.001; }
  c := area_aim_edge(a, 0); #assert abs(c[0] - (a.x - 3.048)) < 0.001 && abs(c[1] - (a.z - 3.048)) < 0.001;
  h: [1] AreaAim; h[0] = a;
  shot := area_aim_confirm(h[..]);
  #assert shot.ok && shot.slot == 3 && shot.x == a.x && shot.z == a.z && !h[0].on;
  #assert !area_aim_confirm(h[..]).ok;
  h[0] = area_aim_arm(1, AREA_CIRCLE, 6.096, 36.576, 2); #assert area_aim_cancel(h[..]) && !h[0].on && !area_aim_cancel(h[..]);
  r := area_aim_follow(area_aim_arm(1, AREA_CIRCLE, 2, 30, 0), 0, 0, 3, 4); p := area_aim_edge(r, 12);
  #assert abs((p[0] - 3) * (p[0] - 3) + (p[1] - 4) * (p[1] - 4) - 4) < 0.001;
}
#test "an area from the caster stays on them and turns to the crosshair" {
  a := area_box(0, 0, 0, 1, -1, 1, 0, 3);
  a = area_aim_follow(a, 2, 2, 12, 2);   // the crosshair 10 m east
  #assert a.x == 2 && a.z == 2 && !a.far && abs(a.fx - 1) < 0.0001 && abs(a.fz) < 0.0001;
  #assert area_aim_contains(a, 4, 2) && !area_aim_contains(a, 0, 2) && !area_aim_contains(a, 4, 4);
}
#test "every shape holds exactly what its outline closes round" {
  shapes := [5] AreaAim.[area_circle(1, 2, 3), area_square(1, 2, 3), area_box(1, 2, 0.6, 0.8, -1.5, 2, -0.5, 4),
                         area_cone(1, 2, 0.6, 0.8, 5), area_line(1, 2, -0.8, 0.6, 6, 0.75)];
  for a: shapes {
    // a point just inside each outline point (toward the area's middle) is in, just outside is out
    mx: f32 = 0; mz: f32 = 0;
    for i: 0..<AREA_EDGE { e := area_aim_edge(a, i); mx += e[0]; mz += e[1]; }
    mx /= f32(AREA_EDGE); mz /= f32(AREA_EDGE);
    #assert area_aim_contains(a, mx, mz);
    for i: 0..<AREA_EDGE {
      e := area_aim_edge(a, i); dx := e[0] - mx; dz := e[1] - mz; d := sqrt(dx * dx + dz * dz);
      if d < 0.2 { continue; }
      #assert area_aim_contains(a, e[0] - dx / d * 0.05, e[1] - dz / d * 0.05);
      #assert !area_aim_contains(a, e[0] + dx / d * 0.05, e[1] + dz / d * 0.05);
    }
  }
  // the SRD Cone: as wide at each point as it is far from its point of origin
  c := area_cone(0, 0, 0, 1, 10);
  #assert area_aim_contains(c, 2.4, 5) && !area_aim_contains(c, 2.6, 5) && !area_aim_contains(c, 0, 10.1) && !area_aim_contains(c, 0, -0.1);
  off := c; off.on = false; #assert !area_aim_contains(off, 0, 5);
}
#test "the points a realm draws: the outline closed, each guide its own stroke" {
  b := area_box(0, 0, 0, 1, -1, 1, 0, 2);
  #assert area_aim_points(b) == AREA_EDGE + 1 + AREA_GUIDES * (AREA_GUIDE_STEPS + 1) && area_aim_points(area_cone(0, 0, 0, 1, 3)) == AREA_EDGE + 1;
  first := area_aim_point(b, 0); last := area_aim_point(b, AREA_EDGE);
  #assert first[0] == last[0] && first[1] == last[1] && !area_aim_joined(b, 0) && area_aim_joined(b, AREA_EDGE);
  #assert !area_aim_joined(b, AREA_EDGE + 1) && area_aim_joined(b, AREA_EDGE + 2) && area_aim_guide(AREA_EDGE + 1) && !area_aim_guide(AREA_EDGE);
  for p: AREA_EDGE + 1..<area_aim_points(b) { q := area_aim_point(b, p); #assert q[0] >= -1.0001 && q[0] <= 1.0001 && q[1] >= -0.0001 && q[1] <= 2.0001; }
}
#test "the view puts a point ahead on the screen and drops one behind" {
  v := AreaView.{eye = [3] f32.[0, 0, 0], fwd = [3] f32.[0, 0, 1], right = [3] f32.[1, 0, 0], up = [3] f32.[0, 1, 0], focal = 100, cx = 50, cy = 40};
  p := area_view_at(v, 1, 1, 2); #assert p.ok && abs(p.x - 100) < 0.001 && abs(p.y + 10) < 0.001;
  #assert !area_view_at(v, 0, 0, -1).ok;
}
