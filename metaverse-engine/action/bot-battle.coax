// Bot battles (#13505): machines fight with the cards they hold, in real time. Each bot holds up to
// four cards, and each card is a move a key uses (1 to 4). A bot's battery is its energy: a move costs
// charge, big moves cost more, and the battery fills again over time. Every bot has health; a bot at
// zero powers down and stays down until it is repaired. A side fields one bot at a time and may swap
// in another of its crew (a core swap), which takes a moment in which the side can't act.
//
// The ruleset keeps its own health, charge and turns, as metaverse-engine/action/README.md asks; a
// card's press goes through the deed pipeline (deed.coax): the bar asks, the battle's own rules
// answer at once, and only an accepted move presents. A stunned bot's bearing locks acting, so its
// presses are refused and its bar greys. A card's feel (animation, effect, sound, movement) is the
// presentation contract deed_feel_missing checks.
//
// Time is the deed pipeline's: ticks of 1/64 s. A realm steps the battle with seconds (bb_step).
//
//   coax/bin/coax test metaverse-engine/action/bot-battle.coax --library

#module "metaverse.engine.action.botbattle";
#load "deed.coax";

BB_CARDS :: 4;          // cards one bot holds: its moves
BB_CREW :: 3;           // bots one side may field, one at a time
BB_SWAP :: 48;          // ticks a core swap takes (0.75 s): the side can't act meanwhile

// Why a press did or didn't go ahead.
BbVerdict :: enum u8 { ok; down; locked; cooling; waiting; no_card; no_charge; far; swapping; over; no_feel; }

// A card as a move: what it costs, what it does, how long it takes to be ready again, how near the
// foe must be, and how long a hit holds the foe still. A card id is the realm's own.
BbCard :: struct {
  id: int;
  power: int;             // health a hit takes
  cost: int;              // battery charge it spends
  cool: int;              // ticks before it can be used again
  reach: f32;             // metres: the foe must be this near
  stun: int;              // ticks a hit locks the foe's acting
  feel: DeedFeel;         // how it is shown: animation, effect, sound, movement
}
BbBot :: struct {
  id: int;                // the realm's own
  hp: int; hp_max: int;
  charge: f32; charge_max: f32;
  recharge: f32;          // charge a second while standing
  cards: [BB_CARDS] BbCard; card_n: int;
  bar: [1] DeedBar;         // its moves' slots: asked, answered, cooling, greyed
  stun_until: int;        // the tick its stun ends
  down: bool;             // powered down: no moves, no recharge, until repaired
}
BbSide :: struct { bots: [BB_CREW] BbBot; n: int; active: int; swap_until: int; }
// What a press did: the verdict, the card, the damage dealt, and whether the foe went down.
BbHit :: struct { side: int = -1; slot: int = -1; card: int = -1; verdict: BbVerdict; damage: int; downed: bool; }
BbBattle :: struct {
  on: bool;
  now: int;               // ticks since the battle began
  carry: f32;             // seconds not yet a whole tick
  sides: [2] BbSide;
  winner: int = -1;       // the side still standing, -1 while both are
  last: BbHit;            // the last accepted move
  moves: int;             // accepted moves so far
}

// ---- making bots
bb_card :: (id: int, power: int, cost: int, cool_s: f32, reach: f32, stun_s: f32, feel: DeedFeel) -> BbCard {
  return BbCard.{id = id, power = power, cost = cost, cool = deed_tick(cool_s), reach = reach, stun = deed_tick(stun_s), feel = feel};
}
bb_bot :: (id: int, hp: int, charge: f32, recharge: f32) -> BbBot {
  return BbBot.{id = id, hp = hp, hp_max = hp, charge = charge, charge_max = charge, recharge = recharge};
}
// Gives a bot a card: false when it already holds four, or the card's feel is missing a part.
bb_give :: (b: [] BbBot, c: BbCard) -> bool {
  if b[0].card_n >= BB_CARDS || deed_feel_missing(c.feel) != 0 { return false; }
  b[0].cards[b[0].card_n] = c; b[0].card_n += 1;
  return true;
}
// Takes every card away (a re-splice gives them again).
bb_clear :: (b: [] BbBot) { b[0].card_n = 0; b[0].bar[0] = DeedBar.{}; }
// Back to full health and a full battery, standing (a charger's repair).
bb_repair :: (b: [] BbBot) { b[0].hp = b[0].hp_max; b[0].charge = b[0].charge_max; b[0].down = false; b[0].stun_until = 0; b[0].bar[0] = DeedBar.{}; }
// Takes health: true when this took it to zero and the bot powered down.
bb_hurt :: (b: [] BbBot, damage: int) -> bool {
  if b[0].down || damage <= 0 { return false; }
  b[0].hp -= damage;
  if b[0].hp > 0 { return false; }
  b[0].hp = 0; b[0].down = true; b[0].charge = 0;
  return true;
}
bb_health :: (b: BbBot) -> f32 { return ifx b.hp_max > 0 then f32(b.hp) / f32(b.hp_max) else 0.0f32; }
bb_battery :: (b: BbBot) -> f32 { return ifx b.charge_max > 0 then b.charge / b.charge_max else 0.0f32; }
bb_bearing :: (b: BbBot, now: int) -> DeedBearing {
  free: DeedBearing;
  if b.down { return deed_bear(free, DeedPose.down, DEED_LOCK_ALL); }
  if now < b.stun_until { return deed_bear(free, DeedPose.reel, DEED_LOCK_ACT | DEED_LOCK_MOVE); }
  return free;
}

// ---- a battle
bb_side_set :: (s: [] BbSide, crew: [] BbBot) {
  s[0] = BbSide.{};
  for i: 0..<crew.count { if s[0].n < BB_CREW { s[0].bots[s[0].n] = crew[i]; s[0].n += 1; } }
  // the first bot standing goes in first
  for i: 0..<s[0].n { if !s[0].bots[i].down { s[0].active = i; break; } }
}
// Begins a battle between two crews (one bot each, or more to swap between).
bb_begin :: (b: [] BbBattle, mine: [] BbBot, theirs: [] BbBot) {
  b[0] = BbBattle.{on = true};
  bb_side_set(b[0].sides[0..<1], mine); bb_side_set(b[0].sides[1..<2], theirs);
  bb_judge(b);
}
bb_end :: (b: [] BbBattle) { b[0].on = false; }
bb_active :: (b: BbBattle, side: int) -> BbBot { return b.sides[side].bots[b.sides[side].active]; }
bb_standing :: (s: BbSide) -> int { k := 0; for i: 0..<s.n { if !s.bots[i].down { k += 1; } } return k; }
// A side with no bot standing has lost.
bb_judge :: (b: [] BbBattle) {
  if b[0].winner >= 0 { return; }
  a := bb_standing(b[0].sides[0]); z := bb_standing(b[0].sides[1]);
  if a == 0 && b[0].sides[0].n > 0 { b[0].winner = 1; }
  else if z == 0 && b[0].sides[1].n > 0 { b[0].winner = 0; }
}

// Whether `side`'s active bot can use card `slot` now with its foe `dist` metres away. Reads only.
bb_can :: (b: BbBattle, side: int, slot: int, dist: f32) -> BbVerdict {
  if !b.on || b.winner >= 0 { return BbVerdict.over; }
  s := b.sides[side];
  if b.now < s.swap_until { return BbVerdict.swapping; }
  me := s.bots[s.active];
  if me.down { return BbVerdict.down; }
  if slot < 0 || slot >= me.card_n { return BbVerdict.no_card; }
  c := me.cards[slot];
  v := deed_can(me.bar[0], slot, b.now, bb_bearing(me, b.now), c.feel);
  if v == DeedVerdict.locked { return BbVerdict.locked; }
  if v == DeedVerdict.no_feel { return BbVerdict.no_feel; }
  if v == DeedVerdict.waiting { return BbVerdict.waiting; }
  if v == DeedVerdict.cooling { return BbVerdict.cooling; }
  if dist > c.reach { return BbVerdict.far; }
  if me.charge < f32(c.cost) { return BbVerdict.no_charge; }
  return BbVerdict.ok;
}
// `side` uses card `slot` on the other side's active bot, `dist` metres away. The bar asks; the
// battle answers at once: a yes spends the charge, takes the foe's health, may stun it, and cools
// the slot; a press that can't go ahead (out of reach, too little charge) is refused and greys.
bb_use :: (b: [] BbBattle, side: int, slot: int, dist: f32) -> BbHit {
  hit := BbHit.{side = side, slot = slot};
  hit.verdict = bb_can(b[0], side, slot, dist);
  a := b[0].sides[side].active; me := b[0].sides[side].bots[a..<a + 1];
  if hit.verdict == BbVerdict.over || hit.verdict == BbVerdict.swapping || hit.verdict == BbVerdict.down || hit.verdict == BbVerdict.no_card { return hit; }
  c := me[0].cards[slot]; hit.card = c.id;
  seq := deed_ask(me[0].bar[..], slot, b[0].now, bb_bearing(me[0], b[0].now), c.feel);
  if seq == 0 { return hit; }   // locked, cooling or waiting: the bar said so
  if hit.verdict != BbVerdict.ok { _ := deed_answer(me[0].bar[..], seq, false, b[0].now, 0); return hit; }
  _ := deed_answer(me[0].bar[..], seq, true, b[0].now, c.cool);
  me[0].charge -= f32(c.cost);
  fa := b[0].sides[1 - side].active; foe := b[0].sides[1 - side].bots[fa..<fa + 1];
  hit.damage = ifx foe[0].down then 0 else bb_lo(c.power, foe[0].hp);
  hit.downed = bb_hurt(foe, c.power);
  if !hit.downed && c.stun > 0 { foe[0].stun_until = bb_hi(foe[0].stun_until, b[0].now + c.stun); }
  b[0].last = hit; b[0].moves += 1;
  bb_judge(b);
  return hit;
}
// A blow from outside the cards (the world's: a fall, a sweep that catches it): health off `side`'s active bot.
bb_strike :: (b: [] BbBattle, side: int, damage: int) -> bool {
  a := b[0].sides[side].active; d := bb_hurt(b[0].sides[side].bots[a..<a + 1], damage);
  bb_judge(b);
  return d;
}
// Holds `side`'s active bot still for `ticks` (a stun from outside the cards).
bb_stun :: (b: [] BbBattle, side: int, ticks: int) {
  s := b[0].sides[side..<side + 1];
  s[0].bots[s[0].active].stun_until = bb_hi(s[0].bots[s[0].active].stun_until, b[0].now + ticks);
}
// A core swap: `side` fields crew bot `to` instead. Like switching: it takes BB_SWAP ticks in which
// the side can't act; a powered-down bot can't be swapped in, nor the one already fielded.
bb_swap :: (b: [] BbBattle, side: int, to: int) -> bool {
  s := b[0].sides[side..<side + 1];
  if !b[0].on || b[0].winner >= 0 || to < 0 || to >= s[0].n || to == s[0].active || s[0].bots[to].down || b[0].now < s[0].swap_until { return false; }
  s[0].active = to; s[0].swap_until = b[0].now + BB_SWAP;
  return true;
}
// The next crew bot standing after the fielded one, or -1.
bb_next :: (s: BbSide) -> int {
  for k: 1..<s.n { i := (s.active + k) % s.n; if !s.bots[i].down { return i; } }
  return -1;
}
// `dt` seconds of battle: the clock moves on and every bot standing refills its battery.
bb_step :: (b: [] BbBattle, dt: f32) {
  if !b[0].on { return; }
  b[0].carry += dt;
  ticks := deed_tick(b[0].carry);
  b[0].now += ticks; b[0].carry -= f32(ticks) / f32(DEED_HZ);
  for side: 0..<2 {
    for i: 0..<b[0].sides[side].n {
      bot := b[0].sides[side].bots[i..<i + 1];
      if bot[0].down { continue; }
      bot[0].charge = bb_lof(bot[0].charge_max, bot[0].charge + bot[0].recharge * dt);
      deed_expire(bot[0].bar[..], b[0].now);
    }
  }
  bb_judge(b);
}
// A rule-based foe: the card it uses now against a foe `dist` metres away, or -1. The strongest card
// ready, in reach and paid for; ties go to the cheaper.
bb_pick :: (b: BbBattle, side: int, dist: f32) -> int {
  best := -1; bp := -1; bc := 0;
  me := bb_active(b, side);
  for i: 0..<me.card_n {
    if bb_can(b, side, i, dist) != BbVerdict.ok { continue; }
    c := me.cards[i];
    if c.power > bp || (c.power == bp && c.cost < bc) { best = i; bp = c.power; bc = c.cost; }
  }
  return best;
}
// How slot `slot` of `side`'s fielded bot looks now: greyed, cooling, and whether it is paid for.
BbLook :: struct { grey: f32; cool: f32; paid: bool; held: bool; }
bb_look :: (b: BbBattle, side: int, slot: int) -> BbLook {
  me := bb_active(b, side); l: BbLook;
  if slot < 0 || slot >= me.card_n { return l; }
  c := me.cards[slot];
  d := deed_look(me.bar[0], slot, b.now, c.cool);
  l.grey = d.grey; l.cool = d.cool; l.held = true; l.paid = me.charge >= f32(c.cost);
  return l;
}
// The words for a refusal, for a realm's message line.
bb_words :: (v: BbVerdict) -> string {
  if v == BbVerdict.down { return "powered down"; }
  if v == BbVerdict.locked { return "stunned"; }
  if v == BbVerdict.cooling { return "not ready"; }
  if v == BbVerdict.no_card { return "no card in that slot"; }
  if v == BbVerdict.no_charge { return "battery too low"; }
  if v == BbVerdict.far { return "out of reach"; }
  if v == BbVerdict.swapping { return "swapping cores"; }
  if v == BbVerdict.over { return "the battle is over"; }
  if v == BbVerdict.no_feel { return "that card can't be shown"; }
  return "";
}

bb_lo :: (a: int, b: int) -> int { return ifx a < b then a else b; }
bb_hi :: (a: int, b: int) -> int { return ifx a > b then a else b; }
bb_lof :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }

// ---- checks
bb_feel :: () -> DeedFeel { return DeedFeel.{anim = 1, fx = 1, sound = "hit", move = DeedMove.lunge}; }
bb_test_bot :: (id: int) -> BbBot {
  b := [1] BbBot.[bb_bot(id, 10, 100, 10)];
  _ := bb_give(b[..], bb_card(1, 1, 10, 0.5, 3, 0, bb_feel()));     // a jab: cheap, quick
  _ := bb_give(b[..], bb_card(2, 4, 40, 2.0, 3, 1.0, bb_feel()));   // a big move: costly, slow, and it stuns
  _ := bb_give(b[..], bb_card(3, 2, 20, 1.0, 12, 0, bb_feel()));    // a long reach
  return b[0];
}

#test "bot battle: a bot holds four cards at most, and a card must say how it is shown" {
  b := [1] BbBot.[bb_bot(1, 10, 100, 10)];
  for i: 0..<4 { #assert bb_give(b[..], bb_card(i, 1, 10, 1, 3, 0, bb_feel())); }
  #assert !bb_give(b[..], bb_card(9, 1, 10, 1, 3, 0, bb_feel())) && b[0].card_n == 4;
  c := [1] BbBot.[bb_bot(2, 10, 100, 10)];
  #assert !bb_give(c[..], bb_card(1, 1, 10, 1, 3, 0, DeedFeel.{})) && c[0].card_n == 0;
  bb_clear(b[..]); #assert b[0].card_n == 0;
}
#test "bot battle: a move costs charge, takes health, cools, and big moves cost more" {
  b := [1] BbBattle.[BbBattle.{}];
  mine := [1] BbBot.[bb_test_bot(1)]; theirs := [1] BbBot.[bb_test_bot(2)];
  bb_begin(b[..], mine[..], theirs[..]);
  #assert b[0].on && b[0].winner == -1;
  h := bb_use(b[..], 0, 1, 2);
  #assert h.verdict == BbVerdict.ok && h.damage == 4 && h.card == 2 && bb_active(b[0], 1).hp == 6 && bb_active(b[0], 0).charge == 60;
  // the same slot again at once: cooling, and nothing changes
  h = bb_use(b[..], 0, 1, 2);
  #assert h.verdict == BbVerdict.cooling && bb_active(b[0], 1).hp == 6 && bb_active(b[0], 0).charge == 60;
  // the jab is ready; the long reach works from afar and the jab doesn't
  #assert bb_use(b[..], 0, 0, 2).verdict == BbVerdict.ok && bb_active(b[0], 0).charge == 50;
  #assert bb_use(b[..], 0, 0, 5).verdict == BbVerdict.cooling;
  bb_step(b[..], 0.6);
  #assert bb_use(b[..], 0, 0, 5).verdict == BbVerdict.far && bb_look(b[0], 0, 0).grey == 1;
  #assert bb_use(b[..], 0, 2, 10).verdict == BbVerdict.ok && bb_active(b[0], 1).hp == 3;
  // a bot whose battery is low can't pay for the big move until it refills
  b[0].sides[0].bots[0].charge = 30; bb_step(b[..], 2.0);
  #assert bb_active(b[0], 0).charge == 50 && bb_use(b[..], 0, 1, 2).verdict == BbVerdict.ok;
}
#test "bot battle: a stunned bot can't act, a bot at zero powers down, and the side with none standing loses" {
  b := [1] BbBattle.[BbBattle.{}];
  mine := [1] BbBot.[bb_test_bot(1)]; theirs := [1] BbBot.[bb_test_bot(2)];
  bb_begin(b[..], mine[..], theirs[..]);
  #assert bb_use(b[..], 0, 1, 2).verdict == BbVerdict.ok;     // stuns for a second
  #assert bb_use(b[..], 1, 0, 2).verdict == BbVerdict.locked && bb_look(b[0], 1, 0).grey == 1;
  bb_step(b[..], 1.1);
  #assert bb_use(b[..], 1, 0, 2).verdict == BbVerdict.ok && bb_active(b[0], 0).hp == 9;
  #assert bb_strike(b[..], 1, 6) && bb_active(b[0], 1).down && bb_active(b[0], 1).hp == 0 && b[0].winner == 0;
  #assert bb_use(b[..], 1, 2, 2).verdict == BbVerdict.over;
  // down stays down: no recharge, no moves, until it is repaired
  bot := [1] BbBot.[bb_active(b[0], 1)];
  #assert !bb_hurt(bot[..], 3) && bot[0].charge == 0;
  bb_repair(bot[..]);
  #assert !bot[0].down && bot[0].hp == 10 && bot[0].charge == 100;
}
#test "bot battle: a core swap fields another bot, takes a moment, and never fields a downed one" {
  b := [1] BbBattle.[BbBattle.{}];
  mine := [2] BbBot.[bb_test_bot(1), bb_test_bot(3)]; theirs := [1] BbBot.[bb_test_bot(2)];
  mine[0].down = true;   // the first is down: the second goes in first
  bb_begin(b[..], mine[..], theirs[..]);
  #assert b[0].sides[0].active == 1 && bb_next(b[0].sides[0]) == -1 && !bb_swap(b[..], 0, 0);
  b[0].sides[0].bots[0].down = false;
  #assert bb_next(b[0].sides[0]) == 0 && bb_swap(b[..], 0, 0) && bb_active(b[0], 0).id == 1;
  #assert bb_use(b[..], 0, 0, 1).verdict == BbVerdict.swapping && !bb_swap(b[..], 0, 1);
  bb_step(b[..], 0.8);
  #assert bb_use(b[..], 0, 0, 1).verdict == BbVerdict.ok;
  // the fielded bot going down leaves the other standing: the battle goes on
  #assert bb_strike(b[..], 0, 20) && b[0].winner == -1 && bb_swap(b[..], 0, 1);
}
#test "bot battle: a rule-based foe uses its strongest ready card in reach that it can pay for" {
  b := [1] BbBattle.[BbBattle.{}];
  mine := [1] BbBot.[bb_test_bot(1)]; theirs := [1] BbBot.[bb_test_bot(2)];
  bb_begin(b[..], mine[..], theirs[..]);
  #assert bb_pick(b[0], 1, 2) == 1 && bb_pick(b[0], 1, 8) == 2 && bb_pick(b[0], 1, 20) == -1;
  _ := bb_use(b[..], 1, 1, 2);
  #assert bb_pick(b[0], 1, 2) == 2;               // the big move cools: the next strongest
  b[0].sides[1].bots[0].charge = 15;
  #assert bb_pick(b[0], 1, 2) == 0;               // only the jab is paid for
  #assert bb_words(BbVerdict.no_charge) == "battery too low" && bb_words(BbVerdict.ok) == "";
}
