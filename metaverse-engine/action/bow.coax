// Bow combat (docs/metaverse/bow-combat.md): a draw you hold and release, and arrows that fly as
// real projectiles. Nothing here rolls: a realm's ruleset decides whether an arrow that reaches a
// creature hits (Experimental: rules/srd/ rs_shoot). This module owns
//
//   the draw (BowDraw): held, it builds strength along one curve (bow_strength) and brings the aim
//   in, smoothly both ways (bow_step, bow_aim): the crosshair, the over-the-shoulder camera, the
//   walk and the turn to face the aim all read that one blend, so nothing pops;
//   the arrows (Arrows): each is launched from a hand with a velocity and flies a closed-form arc
//   under gravity (arrow_pos), so its place is a pure function of its launch and the clock at any
//   frame rate; it ends on a body (ARROW_HIT), sticks in the ground or a prop for ARROW_STAY
//   seconds and fades over ARROW_FADE (ARROW_STUCK), or is let go;
//   the aim (arrow_aim_velocity): the launch that lands an arrow at a point at a given speed, so a
//   full draw lands where the crosshair points; and arrow_timed_velocity, the launch that arrives
//   at a point after a given time (a ruleset that resolves a shot on arrival: Experimental's
//   Goblins, metaverse/experimental-hostiles.coax hostile_fly).
//
// A realm adopts it by keeping one BowDraw per archer and one Arrows pool, stepping each arrow's
// segment against its own world (arrow_segment, then arrow_hit / arrow_stick), and drawing the
// pool's arrows (metaverse-engine/fx/puff.coax fxp_arrow_at).
//   coax/bin/coax test metaverse-engine/action/bow.coax
#module "metaverse.engine.action.bow";

BOW_G :: 9.81;              // m/s², down
BOW_FULL :: 0.8;            // seconds to a full draw
BOW_SPEED :: 42.4;          // m/s an arrow leaves a full draw at: at 45 degrees it carries about 183 m (a Longbow's 600 ft long range)
BOW_SLACK :: 0.25;          // the share of BOW_SPEED an arrow leaves an undrawn bow at
BOW_EASE :: 0.18;           // seconds the aim takes to come in, and to go
BOW_FOLLOW :: 0.45;         // seconds the aim holds after a loose, so you watch the arrow fly
BOW_WALK :: 0.45;           // your pace while drawn, a share of your own
BOW_TAP :: 0.15;            // seconds: a press let go sooner (a tap) draws on its own to full and looses

// One archer's draw. on: drawing now, since `at`; self_loose: it looses itself at full draw (a key or a
// tap); aim: 0 to 1, how far the aim has come in (bow_step).
BowDraw :: struct { on: bool; at: f32 = -100; self_loose: bool; aim: f32; follow: f32; loosed: int; cancelled: int; }

bow_clamp :: (v: f32, a: f32, b: f32) -> f32 { if v < a { return a; } if v > b { return b; } return v; }
bow_begin :: (d: [] BowDraw, now: f32, self_loose: bool) { if d[0].on { if self_loose { d[0].self_loose = true; } return; } d[0].on = true; d[0].at = now; d[0].self_loose = self_loose; }
// How drawn the bow is, 0 to 1: quick at first, then slower to the last of it.
bow_strength :: (d: BowDraw, now: f32) -> f32 {
  if !d.on { return 0; }
  p := bow_clamp((now - d.at) / f32(BOW_FULL), 0, 1);
  return 1 - (1 - p) * (1 - p);
}
// The speed an arrow leaves a bow drawn `strength`, m/s.
bow_speed :: (strength: f32) -> f32 { return f32(BOW_SPEED) * (f32(BOW_SLACK) + (1 - f32(BOW_SLACK)) * bow_clamp(strength, 0, 1)); }
// Let go: the strength it was drawn to (0 when it wasn't drawn).
bow_release :: (d: [] BowDraw, now: f32) -> f32 {
  if !d[0].on { return 0; }
  st := bow_strength(d[0], now); d[0].on = false; d[0].self_loose = false; d[0].loosed += 1; d[0].follow = f32(BOW_FOLLOW); return st;
}
bow_cancel :: (d: [] BowDraw) { if d[0].on { d[0].cancelled += 1; } d[0].on = false; d[0].self_loose = false; d[0].follow = 0; }
// Whether a self-loosing draw has come to full.
bow_due :: (d: BowDraw, now: f32) -> bool { return d.on && d.self_loose && now - d.at >= f32(BOW_FULL) - 0.0001; }
// The aim comes in while drawn and goes when not, over BOW_EASE either way; after a loose it
// holds for BOW_FOLLOW first (the follow-through).
bow_step :: (d: [] BowDraw, dt: f32) {
  if dt <= 0 { return; }
  if !d[0].on && d[0].follow > 0 { d[0].follow -= dt; return; }
  k := dt / f32(BOW_EASE);
  d[0].aim = bow_clamp(d[0].aim + ifx d[0].on then k else -k, 0, 1);
}
// The aim's blend, eased (smoothstep): what the crosshair, camera, pace and turn follow.
bow_aim :: (d: BowDraw) -> f32 { a := d.aim; return a * a * (3 - 2 * a); }
// Your pace while the aim is in: from your own down to BOW_WALK.
bow_pace :: (d: BowDraw) -> f32 { return 1 - (1 - f32(BOW_WALK)) * bow_aim(d); }

#test "a draw builds along one curve, and a short one looses slower" {
  d: [1] BowDraw; bow_begin(d[..], 10, false);
  #assert bow_strength(d[0], 10) == 0 && bow_strength(d[0], 10 + f32(BOW_FULL)) == 1 && bow_strength(d[0], 30) == 1;
  half := bow_strength(d[0], 10 + f32(BOW_FULL) * 0.5); #assert half > 0.5 && half < 1;
  #assert bow_speed(0) == f32(BOW_SPEED) * f32(BOW_SLACK) && bow_speed(1) == f32(BOW_SPEED) && bow_speed(half) < bow_speed(1);
  st := bow_release(d[..], 10.2); #assert st > 0 && st < 1 && !d[0].on && d[0].loosed == 1;
  #assert bow_release(d[..], 11) == 0 && d[0].loosed == 1;
}
#test "the aim eases in and out, and a cancel looses nothing" {
  d: [1] BowDraw; bow_begin(d[..], 0, false);
  bow_step(d[..], 0.09); a := bow_aim(d[0]); #assert a > 0 && a < 1 && bow_pace(d[0]) < 1;
  bow_step(d[..], 1); #assert bow_aim(d[0]) == 1 && abs(bow_pace(d[0]) - f32(BOW_WALK)) < 0.0001;
  bow_cancel(d[..]); #assert !d[0].on && d[0].cancelled == 1 && d[0].loosed == 0;
  bow_step(d[..], 0.09); #assert bow_aim(d[0]) > 0 && bow_aim(d[0]) < 1;
  bow_step(d[..], 1); #assert bow_aim(d[0]) == 0;
  // a loose holds the aim for the follow-through, then lets it go
  bow_begin(d[..], 5, false); bow_step(d[..], 1); _ := bow_release(d[..], 6);
  bow_step(d[..], f32(BOW_FOLLOW) * 0.5); #assert bow_aim(d[0]) == 1;
  bow_step(d[..], f32(BOW_FOLLOW)); bow_step(d[..], 1); #assert bow_aim(d[0]) == 0;
}
// What a body shows of a draw, for its pose, its string and the arrow on it: how far the string is
// back, whether an arrow is nocked, and when the last one left. Every archer's realm steps one
// beside its BowDraw (bow_show_step each frame after bow_step, bow_show_loosed at the loose), so a
// drawn bow looks the same wherever it is held. The string stays back for 0.3 s after the loose,
// while the release's frames play.
BOW_SHOW_HOLD :: 0.3;
BowShow :: struct { strength: f32; nocked: bool; loose_at: f32 = -100; }
bow_show_step :: (sh: [] BowShow, d: BowDraw, now: f32) {
  sh[0].nocked = d.on;
  if d.on { sh[0].strength = bow_strength(d, now); } else if now - sh[0].loose_at > f32(BOW_SHOW_HOLD) { sh[0].strength = 0; }
}
bow_show_loosed :: (sh: [] BowShow, now: f32) { sh[0].loose_at = now; sh[0].nocked = false; }
#test "a body shows the string coming back as the draw builds, the arrow gone at the loose, and the string home a moment after" {
  d: [1] BowDraw; sh: [1] BowShow;
  bow_show_step(sh[..], d[0], 0); #assert !sh[0].nocked && sh[0].strength == 0;
  bow_begin(d[..], 1, false); bow_show_step(sh[..], d[0], 1.4); #assert sh[0].nocked && sh[0].strength > 0.5 && sh[0].strength < 1;
  bow_show_step(sh[..], d[0], 2); #assert sh[0].strength == 1;
  _ := bow_release(d[..], 2); bow_show_loosed(sh[..], 2); bow_show_step(sh[..], d[0], 2.1);
  #assert !sh[0].nocked && sh[0].strength == 1 && sh[0].loose_at == 2;
  bow_show_step(sh[..], d[0], 2.31); #assert sh[0].strength == 0;
}
#test "a self-loosing draw is due at full draw" {
  d: [1] BowDraw; bow_begin(d[..], 1, true);
  #assert !bow_due(d[0], 1.5) && bow_due(d[0], 1 + f32(BOW_FULL));
  e: [1] BowDraw; bow_begin(e[..], 1, false); #assert !bow_due(e[0], 9);
}

// ---- arrows
ARROWS :: 32;               // in the air or stuck at once
ARROW_STAY :: 4.0;          // seconds a stuck arrow stays
ARROW_FADE :: 1.0;          // and then fades over
ARROW_LONG :: 6.0;          // seconds an arrow may fly before it is let go
ARROW_FREE :: 0; ARROW_FLYING :: 1; ARROW_STUCK :: 2; ARROW_HIT :: 3;
// An arrow: who loosed it (a realm's id: Experimental's 0 you, 1 + i its monster i), where from and
// how fast at `t0`, the clock its last segment reached (`last`); stopped (stuck or on a body) at
// `end` where it was then. aim: the creature it was loosed at, -1 none; passed: the one whose
// body it went through on a miss (it is not tested again); strength: how drawn its bow was;
// mark: the static target it stuck in (a realm's index, metaverse-engine/action/target.coax), -1 none, and
// off: how far from that target's middle.
Arrow :: struct {
  state: int; owner: int; aim: int = -1; passed: int = -1; strength: f32 = 1; mark: int = -1; off: f32;
  from: [3] f32; vel: [3] f32; t0: f32; last: f32; end: f32;
  at: [3] f32; dir: [3] f32;   // where it stopped, and the way it points there
}
Arrows :: struct { a: [ARROWS] Arrow; loosed: int; stuck: int; hits: int; dropped: int; }

// Where arrow a is `t` seconds after it left the hand, and its heading there (unit).
arrow_pos :: (a: Arrow, t: f32) -> [3] f32 {
  return [3] f32.[a.from[0] + a.vel[0] * t, a.from[1] + a.vel[1] * t - 0.5 * f32(BOW_G) * t * t, a.from[2] + a.vel[2] * t];
}
arrow_dir :: (a: Arrow, t: f32) -> [3] f32 {
  v := [3] f32.[a.vel[0], a.vel[1] - f32(BOW_G) * t, a.vel[2]];
  m := sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]); if m < 0.0001 { return [3] f32.[0, -1, 0]; }
  return [3] f32.[v[0] / m, v[1] / m, v[2] / m];
}
// Loose one: a free slot, else the stuck arrow stuck longest, else the oldest. Its slot.
arrow_loose :: (p: [] Arrows, owner: int, from: [3] f32, vel: [3] f32, now: f32, aim: int, strength: f32) -> int {
  slot := -1; oldest := 1e9f32;
  for i: 0..<ARROWS { if p[0].a[i].state == ARROW_FREE { slot = i; break; } }
  if slot < 0 { for i: 0..<ARROWS { a := p[0].a[i]; key := ifx a.state == ARROW_FLYING then a.t0 + 1e6 else a.end; if key < oldest { oldest = key; slot = i; } } p[0].dropped += 1; }
  p[0].a[slot] = Arrow.{state = ARROW_FLYING, owner = owner, aim = aim, strength = strength, from = from, vel = vel, t0 = now, last = now};
  p[0].loosed += 1;
  return slot;
}
// Arrow i's segment this step: from where its last step left it to where it is `now` (its two
// ends, then the clock it reaches), and the step is taken. A stopped arrow has none: count 0.
ArrowSeg :: struct { count: int; p0: [3] f32; p1: [3] f32; t0: f32; t1: f32; }
arrow_segment :: (p: [] Arrows, i: int, now: f32) -> ArrowSeg {
  a := p[0].a[i..<i + 1];
  if a[0].state != ARROW_FLYING || now <= a[0].last { return ArrowSeg.{}; }
  s := ArrowSeg.{count = 1, p0 = arrow_pos(a[0], a[0].last - a[0].t0), p1 = arrow_pos(a[0], now - a[0].t0), t0 = a[0].last, t1 = now};
  a[0].last = now;
  return s;
}
// It stops `u` of the way along its segment: in a body (hit), or stuck in the ground or a prop.
arrow_stop :: (p: [] Arrows, i: int, s: ArrowSeg, u: f32, hit: bool) {
  a := p[0].a[i..<i + 1]; t := s.t0 + (s.t1 - s.t0) * bow_clamp(u, 0, 1);
  a[0].at = arrow_pos(a[0], t - a[0].t0); a[0].dir = arrow_dir(a[0], t - a[0].t0); a[0].end = t; a[0].last = t;
  a[0].state = ifx hit then ARROW_HIT else ARROW_STUCK;
  if hit { p[0].hits += 1; } else { p[0].stuck += 1; }
}
// How visible arrow a is `now`: whole in flight; stuck, whole for ARROW_STAY then fading over
// ARROW_FADE; gone in a body at once.
// Arrow i sticks in static target `mark`, `off` metres from its middle, `u` of the way along its
// segment: stuck as in a prop, and it remembers what it struck.
arrow_mark :: (p: [] Arrows, i: int, s: ArrowSeg, u: f32, mark: int, off: f32) {
  arrow_stop(p, i, s, u, false);
  p[0].a[i].mark = mark; p[0].a[i].off = off;
}
arrow_alpha :: (a: Arrow, now: f32) -> f32 {
  if a.state == ARROW_FLYING { return 1; }
  if a.state == ARROW_STUCK { return bow_clamp(1 - (now - a.end - f32(ARROW_STAY)) / f32(ARROW_FADE), 0, 1); }
  return 0;
}
// Lets go of the arrows that are done: faded, ended in a body, or flown too long.
arrow_tidy :: (p: [] Arrows, now: f32) {
  for i: 0..<ARROWS {
    a := p[0].a[i..<i + 1];
    if (a[0].state == ARROW_STUCK && arrow_alpha(a[0], now) <= 0) || a[0].state == ARROW_HIT || (a[0].state == ARROW_FLYING && now - a[0].t0 > f32(ARROW_LONG)) { a[0] = Arrow.{}; }
  }
}
// The launch velocity that lands an arrow leaving `from` at `speed` on `to`: the lower of the two
// arcs; out of reach, the 45 degree arc toward it (the furthest it goes).
arrow_aim_velocity :: (from: [3] f32, to: [3] f32, speed: f32) -> [3] f32 {
  dx := to[0] - from[0]; dy := to[1] - from[1]; dz := to[2] - from[2];
  r := sqrt(dx * dx + dz * dz); v2 := speed * speed; g := f32(BOW_G);
  if r < 0.001 { return [3] f32.[0, ifx dy >= 0 then speed else -speed, 0]; }
  disc := v2 * v2 - g * (g * r * r + 2 * dy * v2);
  c := 0.70710678f32; s := 0.70710678f32;   // tan of the angle: (v2 - sqrt(disc)) / (g r)
  if disc >= 0 { tn := (v2 - sqrt(disc)) / (g * r); c = 1 / sqrt(1 + tn * tn); s = tn * c; }
  return [3] f32.[dx / r * speed * c, speed * s, dz / r * speed * c];
}
// The launch from `from` for a bow drawn to `strength` and aimed at `to`: a full draw lands on it,
// a short draw flies the same line slower and drops short.
arrow_launch :: (from: [3] f32, to: [3] f32, strength: f32) -> [3] f32 {
  v := arrow_aim_velocity(from, to, bow_speed(1)); k := bow_speed(strength) / bow_speed(1);
  return [3] f32.[v[0] * k, v[1] * k, v[2] * k];
}
// The launch velocity that arrives at `to` from `from` after `fly` seconds.
arrow_timed_velocity :: (from: [3] f32, to: [3] f32, fly: f32) -> [3] f32 {
  t := ifx fly < 0.01 then 0.01f32 else fly;
  return [3] f32.[(to[0] - from[0]) / t, (to[1] - from[1]) / t + 0.5 * f32(BOW_G) * t, (to[2] - from[2]) / t];
}
// Where segment p0 → p1 first comes within r of the axis c0 → c1 (a creature's hurt capsule), as
// a share of the segment (0 to 1), or -1 when it never does. Sampled finely along the segment,
// then the first sample inside is refined by halving.
arrow_in :: (u: f32, p0: [3] f32, p1: [3] f32, c0: [3] f32, c1: [3] f32, r: f32) -> bool {
  q := [3] f32.[p0[0] + (p1[0] - p0[0]) * u, p0[1] + (p1[1] - p0[1]) * u, p0[2] + (p1[2] - p0[2]) * u];
  ax := c1[0] - c0[0]; ay := c1[1] - c0[1]; az := c1[2] - c0[2]; l2 := ax * ax + ay * ay + az * az;
  k := ifx l2 > 0 then bow_clamp(((q[0] - c0[0]) * ax + (q[1] - c0[1]) * ay + (q[2] - c0[2]) * az) / l2, 0, 1) else 0.0f32;
  ex := q[0] - c0[0] - ax * k; ey := q[1] - c0[1] - ay * k; ez := q[2] - c0[2] - az * k;
  return ex * ex + ey * ey + ez * ez <= r * r;
}
arrow_capsule :: (p0: [3] f32, p1: [3] f32, c0: [3] f32, c1: [3] f32, r: f32) -> f32 {
  sx := p1[0] - p0[0]; sy := p1[1] - p0[1]; sz := p1[2] - p0[2];
  n := cast(int) (sqrt(sx * sx + sy * sy + sz * sz) / (r * 0.5)) + 1; if n > 256 { n = 256; }
  for k: 0..<n + 1 {
    u := f32(k) / f32(n);
    if arrow_in(u, p0, p1, c0, c1, r) {
      lo := ifx k > 0 then f32(k - 1) / f32(n) else 0.0f32; top := u;
      for j: 0..<12 { m := (lo + top) * 0.5; if arrow_in(m, p0, p1, c0, c1, r) { top = m; } else { lo = m; } }
      return top;
    }
  }
  return -1;
}

#test "a full draw aimed at a point lands on it, and a short draw falls short" {
  from := [3] f32.[0, 1.5, 0]; to := [3] f32.[0, 0.5, 30];
  v := arrow_aim_velocity(from, to, bow_speed(1));
  p: [1] Arrows; i := arrow_loose(p[..], 0, from, v, 0, -1, 1);
  t := 30 / v[2]; at := arrow_pos(p[0].a[i], t);
  #assert abs(at[1] - 0.5) < 0.02 && abs(at[0]) < 0.001 && v[1] > 0;
  // the same aim at a quarter of the speed comes down well short of 30 m
  w := [3] f32.[v[0] * 0.25, v[1] * 0.25, v[2] * 0.25]; s := Arrow.{from = from, vel = w};
  land := 0.0f32; for k: 1..<401 { q := arrow_pos(s, f32(k) * 0.01); if q[1] < 0.5 { land = q[2]; break; } }
  #assert land > 0 && land < 10;
  // out of reach: the 45 degree arc
  far := arrow_aim_velocity(from, [3] f32.[0, 0, 900], bow_speed(1)); #assert abs(far[1] - far[2]) < 0.01;
}
#test "a timed launch arrives on its point on time, along an arc" {
  from := [3] f32.[1, 1, 1]; to := [3] f32.[1, 1.2, 21];
  v := arrow_timed_velocity(from, to, 0.8); a := Arrow.{from = from, vel = v};
  q := arrow_pos(a, 0.8); #assert abs(q[1] - 1.2) < 0.001 && abs(q[2] - 21) < 0.001;
  mid := arrow_pos(a, 0.4); #assert mid[1] > 1.1 + 0.5;   // it rises over the straight line
}
#test "an arrow flies by segments at any step, stops in a body or sticks, then fades and is let go" {
  p: [1] Arrows; i := arrow_loose(p[..], 0, [3] f32.[0, 1, 0], [3] f32.[0, 0, 40], 0, 2, 1);
  a := arrow_segment(p[..], i, 0.1); b := arrow_segment(p[..], i, 0.25);
  #assert a.count == 1 && b.count == 1 && abs(a.p1[2] - 4) < 0.001 && abs(b.p0[2] - 4) < 0.001 && abs(b.p1[2] - 10) < 0.001 && b.p1[1] < 1;
  #assert arrow_segment(p[..], i, 0.25).count == 0;
  // a body 7 m on, a capsule 0.4 round: met at about 6.6 m
  u := arrow_capsule(b.p0, b.p1, [3] f32.[0, 0, 7], [3] f32.[0, 2, 7], 0.4);
  #assert u > 0 && abs(b.p0[2] + (b.p1[2] - b.p0[2]) * u - 6.6) < 0.05;
  #assert arrow_capsule(b.p0, b.p1, [3] f32.[3, 0, 7], [3] f32.[3, 2, 7], 0.4) < 0;
  arrow_stop(p[..], i, b, u, true); #assert p[0].a[i].state == ARROW_HIT && p[0].hits == 1 && arrow_alpha(p[0].a[i], 0.3) == 0;
  arrow_tidy(p[..], 0.3); #assert p[0].a[i].state == ARROW_FREE;
  j := arrow_loose(p[..], 0, [3] f32.[0, 1, 0], [3] f32.[0, 0, 20], 1, -1, 1); s := arrow_segment(p[..], j, 1.5);
  arrow_stop(p[..], j, s, 0.5, false); stuck := p[0].a[j];
  #assert stuck.state == ARROW_STUCK && abs(stuck.at[2] - 5) < 0.01 && stuck.dir[2] > 0.9 && stuck.dir[1] < 0;
  #assert arrow_alpha(stuck, 1.25 + f32(ARROW_STAY)) == 1 && arrow_alpha(stuck, 1.25 + f32(ARROW_STAY) + 0.5) > 0 && arrow_alpha(stuck, 1.25 + f32(ARROW_STAY) + f32(ARROW_FADE) + 0.01) == 0;
  arrow_tidy(p[..], 3); #assert p[0].a[j].state == ARROW_STUCK;
  arrow_tidy(p[..], 1.25 + f32(ARROW_STAY) + f32(ARROW_FADE) + 0.1); #assert p[0].a[j].state == ARROW_FREE;
}
#test "an arrow that sticks in a static target remembers which and how far from its middle; a short draw launches the same line slower" {
  p: [1] Arrows; i := arrow_loose(p[..], 0, [3] f32.[0, 1, 0], arrow_launch([3] f32.[0, 1, 0], [3] f32.[0, 1, 20], 1), 0, -1, 1);
  #assert p[0].a[i].mark == -1;
  s := arrow_segment(p[..], i, 0.2); arrow_mark(p[..], i, s, 0.5, 3, 0.07);
  #assert p[0].a[i].state == ARROW_STUCK && p[0].a[i].mark == 3 && abs(p[0].a[i].off - 0.07) < 0.0001 && p[0].stuck == 1;
  j := arrow_loose(p[..], 0, [3] f32.[0, 1, 0], [3] f32.[0, 0, 10], 1, -1, 1); #assert p[0].a[j].mark == -1;
  full := arrow_launch([3] f32.[0, 1, 0], [3] f32.[0, 1, 20], 1); half := arrow_launch([3] f32.[0, 1, 0], [3] f32.[0, 1, 20], 0.5);
  k := bow_speed(0.5) / bow_speed(1); #assert abs(half[2] - full[2] * k) < 0.001 && abs(half[1] - full[1] * k) < 0.001 && half[2] < full[2];
}
#test "a full pool lets the longest-stuck arrow go first" {
  p: [1] Arrows;
  for k: 0..<ARROWS { i := arrow_loose(p[..], 0, [3] f32.[0, 1, 0], [3] f32.[0, 0, 10], f32(k), -1, 1); s := arrow_segment(p[..], i, f32(k) + 0.1); arrow_stop(p[..], i, s, 1, false); }
  first := p[0].a[0].end; i := arrow_loose(p[..], 0, [3] f32.[0, 1, 0], [3] f32.[0, 0, 10], 50, -1, 1);
  #assert i == 0 && p[0].dropped == 1 && p[0].a[0].state == ARROW_FLYING && first < 1;
}
