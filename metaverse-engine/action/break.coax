// Breakables and attachments (book chapters 73 and 74, GitHub #12993).
//
// A breakable is intact until accepted reactions bring its integrity to zero; then it breaks once. The
// break is not a mesh swap done in place: it hands back one state patch (the declared fact, such as the
// State Lab's gate.broken) for the world-edit/variant boundary (metaverse-engine/state/variants.coax) to publish
// with its geometry, collision and navigation resources together, a sound stimulus for creatures that
// hear it (metaverse-engine/ai/stimulus.coax) and a bounded debris burst. A broken fact that is already true
// (loaded from a save, or broken a second time) breaks nothing and drops nothing.
//
// Three cost profiles: pre-fractured small debris (a few pieces, no collision, faded), authored kinematic
// breakup with a durable end state (pieces on a path, then the broken variant), and procedural structural
// fracture through metaverse/demolish.coax's support model (budgeted pieces that may collide).
//
// An attachment (a rider on a mount, a sword in a hand) has one movement authority while attached:
// the parent. Children update after their parents (attach_order), from the parent's accepted pose. A
// detach is refused when no admitted placement is free.
//
//   coax/bin/coax test metaverse-engine/action/break.coax --library

#module "aethyr.action.break";
#load "react.coax";
#load "../core/space.coax";
#load "../physics/query.coax";

BREAK_DEBRIS_MAX :: 64;     // pieces one break may launch
ATTACH_MAX :: 16;           // attachments in one table

BreakProfile :: enum u8 { debris; kinematic; structural; }
// A breakable's admitted record: the fact it owns, its integrity, its cost profile and debris budget.
Breakable :: struct {
  fact: int;                         // the declared state field (bool) that is true once broken
  integrity: int;                    // accepted damage it takes before it breaks
  profile: BreakProfile;
  pieces: int; life: int;            // debris pieces and their lifetime, ticks
  collide: bool;                     // structural pieces may collide; cosmetic debris never does
  hear: f32 = 30;                    // metres the break is heard
  at: WorldPoint;
}
BreakState :: struct { damage: int; broken: bool; breaks: int; refused: int; }
BreakStatus :: enum u8 { intact; broke; already; invalid; }
BreakResult :: struct {
  status: BreakStatus; state: BreakState;
  fact: int; pieces: int; collide: bool; life: int;   // the patch and the debris to launch
  heard_at: WorldPoint; heard: f32;                    // the sound stimulus
}

break_ok :: (b: Breakable) -> bool {
  if b.fact <= 0 || b.integrity < 1 || b.pieces < 0 || b.pieces > BREAK_DEBRIS_MAX || b.life < 0 || !(b.hear >= 0) { return false; }
  if b.profile == BreakProfile.debris && b.collide { return false; }   // cosmetic debris never blocks
  return query_point_finite(b.at);
}
// Apply reaction r carrying damage (already scaled by the ruleset) to breakable b in state s, whose fact
// currently reads broken_fact (from the published state). Only accepted harm counts.
break_hit :: (b: Breakable, s: BreakState, r: Reaction, damage: int, broken_fact: bool) -> BreakResult {
  out: BreakResult; out.state = s; out.fact = b.fact;
  if !break_ok(b) { out.status = BreakStatus.invalid; out.state.refused += 1; return out; }
  if broken_fact || s.broken { out.status = BreakStatus.already; out.state.broken = true; return out; }
  harm := r.kind == ReactionKind.struck || r.kind == ReactionKind.weak || r.kind == ReactionKind.resisted;
  if !harm || damage <= 0 { out.status = BreakStatus.intact; return out; }
  out.state.damage = s.damage + damage;
  if out.state.damage < b.integrity { out.status = BreakStatus.intact; return out; }
  out.state.broken = true; out.state.breaks = s.breaks + 1;
  out.status = BreakStatus.broke;
  out.pieces = b.pieces; out.collide = b.collide; out.life = b.life;
  out.heard_at = b.at; out.heard = b.hear;
  return out;
}

// Cosmetic debris: pieces with a lifetime, never colliders. A burst over the budget is clipped and counted.
Debris :: struct { until: [BREAK_DEBRIS_MAX] int; n: int; clipped: int; }
break_debris :: (d: Debris, r: BreakResult, now: int, budget: int) -> Debris {
  out := break_debris_expire(d, now);
  if r.status != BreakStatus.broke { return out; }
  cap := ifx budget < BREAK_DEBRIS_MAX then budget else BREAK_DEBRIS_MAX;
  for i: 0..<r.pieces { if out.n < cap { out.until[out.n] = now + r.life; out.n += 1; } else { out.clipped += 1; } }
  return out;
}
break_debris_expire :: (d: Debris, now: int) -> Debris {
  out: Debris; out.clipped = d.clipped;
  for i: 0..<d.n { if d.until[i] > now { out.until[out.n] = d.until[i]; out.n += 1; } }
  return out;
}

// ---- attachments
Attach :: struct { child: int; parent: int; anchor: int; offset: WorldPoint; }
AttachTable :: struct { items: [ATTACH_MAX] Attach; n: int; refused: int; }
AttachStatus :: enum u8 { ok; cycle; taken; full; missing; blocked; }
attach_parent_of :: (t: AttachTable, child: int) -> int { for i: 0..<t.n { if t.items[i].child == child { return t.items[i].parent; } } return -1; }
// Attach child to parent at anchor: refused if the child already has a parent, it would make a cycle,
// or the table is full.
attach_add :: (t: AttachTable, a: Attach) -> AttachTable {
  out := t;
  if a.child == a.parent || attach_parent_of(t, a.child) >= 0 || t.n >= ATTACH_MAX { out.refused += 1; return out; }
  p := a.parent;
  for guard: 0..<ATTACH_MAX + 1 { if p < 0 { break; } if p == a.child { out.refused += 1; return out; } p = attach_parent_of(t, p); }
  out.items[out.n] = a; out.n += 1;
  return out;
}
// The order to update: every parent before its children (depth, then child id). out holds child ids.
attach_order :: (t: AttachTable, out: [] int) -> int {
  depth: [ATTACH_MAX] int;
  for i: 0..<t.n { k := 0; p := t.items[i].parent; for guard: 0..<ATTACH_MAX { if p < 0 { break; } q := attach_parent_of(t, p); if q < 0 { break; } k += 1; p = q; } depth[i] = k; }
  n := 0; idx: [ATTACH_MAX] int;
  for i: 0..<t.n { idx[n] = i; n += 1; }
  for i: 1..<n {
    k := i;
    while k > 0 && (depth[idx[k]] < depth[idx[k - 1]] || (depth[idx[k]] == depth[idx[k - 1]] && t.items[idx[k]].child < t.items[idx[k - 1]].child)) { tmp := idx[k]; idx[k] = idx[k - 1]; idx[k - 1] = tmp; k -= 1; }
  }
  m := 0;
  for i: 0..<n { if m < out.count { out[m] = t.items[idx[i]].child; m += 1; } }
  return m;
}
// The child's position from its parent's accepted position and yaw (the only movement authority).
attach_pose :: (a: Attach, parent_at: WorldPoint, parent_yaw: f32) -> WorldPoint {
  c := cos(parent_yaw); s := sin(parent_yaw);
  return world_point(parent_at.x + a.offset.x * c + a.offset.z * s, parent_at.y + a.offset.y, parent_at.z - a.offset.x * s + a.offset.z * c);
}
// Detach child: it is placed at the first of the candidate spots where a capsule of radius r is free in
// colliders c; with none free the detach is refused and it stays attached.
DetachResult :: struct { status: AttachStatus; table: AttachTable; at: WorldPoint; }
attach_detach :: (t: AttachTable, child: int, spots: [] WorldPoint, r: f32, c: Colliders) -> DetachResult {
  out: DetachResult; out.table = t;
  k := -1; for i: 0..<t.n { if t.items[i].child == child { k = i; } }
  if k < 0 { out.status = AttachStatus.missing; return out; }
  ids: [1] QueryId;
  for p: spots {
    hit := query_overlap_checked(c, world_point(p.x, p.y + r + 0.05, p.z), r, ids[..]);
    if hit.status == QueryStatus.ok && hit.count == 0 {
      for i: k..<t.n - 1 { out.table.items[i] = t.items[i + 1]; }
      out.table.n = t.n - 1; out.at = p; out.status = AttachStatus.ok;
      return out;
    }
  }
  out.status = AttachStatus.blocked; out.table.refused += 1;
  return out;
}

// ---- checks
#test "a gate breaks once from accepted harm and never again, nor after a load" {
  gate := Breakable.{fact = 10, integrity = 10, profile = BreakProfile.kinematic, pieces = 6, life = 128, at = world_point(8, 0, 4)};
  struck := Reaction.{kind = ReactionKind.struck};
  s: BreakState;
  r := break_hit(gate, s, struck, 6, false);
  #assert r.status == BreakStatus.intact && r.state.damage == 6;
  // guarded, immune and zero-damage reactions don't wear it
  #assert break_hit(gate, r.state, Reaction.{kind = ReactionKind.guarded}, 6, false).state.damage == 6;
  #assert break_hit(gate, r.state, Reaction.{kind = ReactionKind.flinch}, 0, false).status == BreakStatus.intact;
  b := break_hit(gate, r.state, struck, 4, false);
  #assert b.status == BreakStatus.broke && b.fact == 10 && b.pieces == 6 && b.heard == 30 && b.heard_at.x == 8 && b.state.breaks == 1;
  again := break_hit(gate, b.state, struck, 4, false);
  #assert again.status == BreakStatus.already && again.pieces == 0 && again.state.breaks == 1;
  // a fresh state over a loaded broken fact: already broken, no drops
  #assert break_hit(gate, BreakState.{}, struck, 40, true).status == BreakStatus.already;
  bad := gate; bad.fact = 0; #assert break_hit(bad, s, struck, 40, false).status == BreakStatus.invalid;
  bad = gate; bad.profile = BreakProfile.debris; bad.collide = true; #assert !break_ok(bad);
  bad = gate; bad.pieces = BREAK_DEBRIS_MAX + 1; #assert !break_ok(bad);
}

#test "cosmetic debris keeps its budget and lifetime" {
  pot := Breakable.{fact = 3, integrity = 1, pieces = 12, life = 10, at = world_point(0, 0, 0)};
  r := break_hit(pot, BreakState.{}, Reaction.{kind = ReactionKind.struck}, 1, false);
  d := break_debris(Debris.{}, r, 100, 8);
  #assert d.n == 8 && d.clipped == 4 && !r.collide;
  #assert break_debris_expire(d, 109).n == 8 && break_debris_expire(d, 110).n == 0;
  #assert break_debris(d, BreakResult.{}, 101, 8).n == 8;
}

#test "attachments: one parent, no cycles, parents first, and a blocked dismount stays mounted" {
  t: AttachTable;
  t = attach_add(t, Attach.{child = 2, parent = 1, offset = world_point(0, 1, 0)});    // a rider on a horse
  t = attach_add(t, Attach.{child = 3, parent = 2, offset = world_point(0.3, 0.2, 0.4)});  // a sword in the rider's hand
  #assert t.n == 2;
  #assert attach_add(t, Attach.{child = 1, parent = 3}).refused == 1;   // a cycle
  #assert attach_add(t, Attach.{child = 2, parent = 5}).refused == 1;   // already attached
  #assert attach_add(t, Attach.{child = 4, parent = 4}).refused == 1;
  order: [4] int;
  #assert attach_order(t, order[..]) == 2 && order[0] == 2 && order[1] == 3;
  // reversed insertion still orders the parent first
  r: AttachTable; r.n = 2; r.items[0] = t.items[1]; r.items[1] = t.items[0];
  #assert attach_order(r, order[..]) == 2 && order[0] == 2 && order[1] == 3;
  // the child follows its parent's accepted pose
  p := attach_pose(t.items[1], world_point(10, 0, 5), 1.5707964);
  #assert abs(p.x - 10.4) < 0.0001 && abs(p.y - 0.2) < 0.0001 && abs(p.z - 4.7) < 0.0001;
  // dismount: the first spot is in a wall, the second free
  c: Colliders; c.ground = 0; wall := [6] f32.[0, 0, 0, 2, 3, 2]; c.boxes = wall[..];
  spots := [2] WorldPoint.[world_point(1, 0, 1), world_point(4, 0, 1)];
  d := attach_detach(t, 2, spots[..], 0.3, c);
  #assert d.status == AttachStatus.ok && d.at.x == 4 && d.table.n == 1 && attach_parent_of(d.table, 2) == -1;
  boxed := [1] WorldPoint.[world_point(1, 0, 1)];
  e := attach_detach(t, 2, boxed[..], 0.3, c);
  #assert e.status == AttachStatus.blocked && e.table.n == 2 && attach_parent_of(e.table, 2) == 1;
  #assert attach_detach(t, 9, spots[..], 0.3, c).status == AttachStatus.missing;
}
