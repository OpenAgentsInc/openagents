ACTOR_LAB_METRICS :: 66;
actor_lab_metric_name :: (index:int)->string #export_c #effects(all) {
 if index==65 {return "notices";}if index==64 {return "scan_peak";}if index<28 {return state_lab_metric_name(index);}
 names:=[36]string.["guard_id","guard_verb","guard_reason","guard_nav","guard_target","guard_lost","guard_x","guard_z","villager_id","villager_verb","villager_reason","villager_nav","villager_target","villager_lost","villager_x","villager_z","mount_id","mount_verb","mount_reason","mount_nav","mount_target","mount_lost","mount_x","mount_z","entities","actor_state_bytes","sense_peak","settled_peak","choice_peak","search_peak","mount_owner","alternate","actor_refused","model_stale","nav_invalidated","mounted"];
 return ifx index<64 then names[index-28] else "";
}
actor_lab_metric :: (s:[]ActorLab,index:int)->f64 #export_c #effects(all) {
 if index<28 {return state_lab_metric(s[0].world[..],index);}store:=actor_entity_store(s[0].actors[..]);
 if index<52 {row:=(index-28)/8;column:=(index-28)%8;h:=s[0].handles[row];if !entities.entity_alive(store,h) {return 0;}a:=s[0].actors[0].actors[entities.entity_slot(h)];
  if column==0 {return f64(a.id);}if column==1 {return f64(a.choice.verb);}if column==2 {return f64(a.choice.reason);}if column==3 {return f64(a.navigation.status);}if column==4 {return f64(a.perception.target);}if column==5 {return f64(a.perception.lost);}if column==6 {return f64(a.body.body.pos.x);}return f64(a.body.body.pos.z);
 }
 if index==52 {return f64(entities.entity_count(store));}if index==53 {return f64(size_of(ActorLab));}if index>=54 && index<=57 {return f64(s[0].peaks[index-54]);}
 if index==58 {return f64(s[0].actors[0].actors[entities.entity_slot(s[0].handles[2])].owner);}if index==59 {return ifx s[0].alternate then 1 else 0;}if index==60 {return f64(s[0].refused);}if index==61 {return f64(s[0].stale);}if index==62 {return f64(s[0].invalidated);}if index==63 {return f64(s[0].actors[0].actors[entities.entity_slot(s[0].handles[2])].controller);}if index==64 {return f64(s[0].peaks[4]);}if index==65 {return f64(s[0].notices);}return 0;
}
actor_lab_digest :: (s:[]ActorLab)->assets.AssetId #effects(all) {
 words:[4096]int;n:=0;base:=state_lab_digest(s[0].world[..]);for v:base.words {words[n]=cast(int)v;n+=1;}store:=actor_entity_store(s[0].actors[..]);words[n]=entities.entity_digest(store);n+=1;
 for i:0..<ACTOR_EXEC_SLOTS {h:=entities.entity_at(store,i);if h==entities.ENTITY_NONE || s[0].actors[0].actors[i].id==0 {continue;}a:=s[0].actors[0].actors[i];par:=a.definition.parameters;
  head:=[39]int.[a.id,cast(int)h.value,a.owner,a.controller,a.brain.tick,a.brain.rule,a.brain.until,a.brain.last,a.brain.draws,a.choice.verb,a.choice.goal,a.choice.reason,a.choice.weight,a.perception.tick,a.perception.reason,a.perception.target,a.perception.generation,a.perception.last_seen,a.perception.lost,ifx a.perception.seen then 1 else 0,ifx a.perception.alert then 1 else 0,ifx a.perception.culled then 1 else 0,a.navigation.status,a.navigation.goal,a.navigation.asked,a.navigation.retry_at,a.navigation.still,a.navigation.serial,a.navigation.key.actor,a.navigation.key.generation,a.navigation.key.owner,a.navigation.key.world,a.navigation.key.nav,a.navigation.key.profile,a.navigation.key.radius,a.navigation.key.request,a.last_anchor,a.goal_x,a.goal_z];
  for v:head {words[n]=v;n+=1;}for v:a.definition.content.words {words[n]=cast(int)v;n+=1;}for v:a.archetype.words {words[n]=cast(int)v;n+=1;}for v:a.brain.ready {words[n]=v;n+=1;}
  for j:0..<a.perception.memory.count {st:=a.perception.memory.items[j];values:=[6]int.[cast(int)st.kind,st.source,st.tick,cast(int)f32_bits(st.at.x),cast(int)f32_bits(st.at.y),cast(int)f32_bits(st.at.z)];for v:values {words[n]=v;n+=1;}}
  body:=[11]int.[cast(int)f32_bits(a.body.body.pos.x),cast(int)f32_bits(a.body.body.pos.y),cast(int)f32_bits(a.body.body.pos.z),cast(int)f32_bits(a.body.body.vel.x),cast(int)f32_bits(a.body.body.vel.y),cast(int)f32_bits(a.body.body.vel.z),cast(int)f32_bits(a.body.body.face),a.model.kind,a.model.target,cast(int)f32_bits(a.model.x),cast(int)f32_bits(a.model.z)];for v:body {words[n]=v;n+=1;}
  schema:=actor_scope_schema(a);saved:[STATE_SAVE_WORDS]int;sn:=state_save(schema,a.facts,StateRefs.{},saved[..]);for j:0..<sn {words[n]=saved[j];n+=1;}
 }return state_words_id(words[0..<n]);
}
actor_lab_hash :: (s:[]ActorLab,out:[]u8)->bool #export_c #effects(all) {return assets.asset_hex(actor_lab_digest(s),out);}
actor_lab_observe :: (s:[]ActorLab) #effects(all) {
 marks:=[30]int.[16,32,64,96,97,128,129,160,161,192,193,224,256,288,320,321,352,384,416,417,448,449,480,481,512,513,544,576,608,640];tick:=s[0].world[0].clock.ticks;
 for mark:marks {if tick==mark && s[0].trace_n<32 {row:=s[0].trace_n;s[0].trace_ticks[row]=tick;s[0].trace_ids[row]=actor_lab_digest(s);for i:0..<ACTOR_LAB_METRICS {s[0].trace_metrics[row][i]=actor_lab_metric(s,i);}s[0].trace_n+=1;}}
}
actor_lab_trial :: (s:[]ActorLab,fps:int,visual:bool,observe:bool)->bool #export_c #effects(all) {
 if fps!=0 && fps!=30 && fps!=60 && fps!=144 {return false;}profile:=ifx s[0].control_ai then 1 else 0;if !actor_lab_open(s,profile) {return false;}s[0].script=true;s[0].observe=observe;s[0].world[0].visual=visual;
 elapsed:=0;frame:=0;total:=10000000000;uneven:=[5]int.[1000000,23000000,7000000,48000000,11000000];while elapsed<total {ns:=ifx fps==0 then uneven[frame%5] else ((frame+1)*1000000000/fps-frame*1000000000/fps);if elapsed+ns>total {ns=total-elapsed;}actor_lab_frame(s,ns);elapsed+=ns;frame+=1;if !s[0].ready {return false;}}return s[0].world[0].clock.ticks==640;
}
