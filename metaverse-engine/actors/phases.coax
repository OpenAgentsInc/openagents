// Actor task admission and offline scheduling, #12992.
#module "metaverse.engine.actors.phases";
#authority;
ACTOR_TASKS :: 16;
ACTOR_PHASES :: 6;
ACTOR_APPLY :: 0; ACTOR_SENSE :: 1; ACTOR_CHOOSE :: 2;
ACTOR_MOVE :: 3; ACTOR_FINALIZE :: 4; ACTOR_PRESENT :: 5;
// Facts, knowledge, intent, transform, pose, sensors, presentation, ready resources.
ACTOR_CHANNELS :: 255;
ActorTask :: struct {
 id:int;phase:int;reads:u32;writes:u32;
 dependency_count:int;dependencies:[ACTOR_TASKS]int;
}
ActorPlanStep :: struct {id:int;phase:int;reads:u32;writes:u32;}
ActorPlan :: struct {valid:bool;n:int;steps:[ACTOR_TASKS]ActorPlanStep;}
ActorPlanStatus :: enum u8 {ok;version;capacity;identity;phase;channels;dependency;cycle;conflict;}
ActorPlanResult :: struct {status:ActorPlanStatus;task:int= -1;related:int= -1;plan:ActorPlan;}
#load "tests/phases.coax" #test;

// No partially compiled plan escapes. Dependency names are resolved once here;
// the runtime receives only fixed task IDs in their execution order.
actor_plan_compile :: (version:int,tasks:[]const ActorTask)->ActorPlanResult #effects(all) {
 if version!=1 {return ActorPlanResult.{status=ActorPlanStatus.version};}
 if tasks.count<1 || tasks.count>ACTOR_TASKS {return ActorPlanResult.{status=ActorPlanStatus.capacity};}
 allowed:=[ACTOR_PHASES]u32.[15,2,4,8,48,64];
 before:[ACTOR_TASKS]u32;
 for t,i:tasks {
  if t.id<1 {return ActorPlanResult.{status=ActorPlanStatus.identity,task=t.id};}
  for j:0..<i {if tasks[j].id==t.id {return ActorPlanResult.{status=ActorPlanStatus.identity,task=t.id};}}
  if t.phase<0 || t.phase>=ACTOR_PHASES {return ActorPlanResult.{status=ActorPlanStatus.phase,task=t.id};}
  if (t.reads & (4294967295 ^ cast(u32)ACTOR_CHANNELS))!=0 || (t.writes & (4294967295 ^ allowed[t.phase]))!=0 {
   return ActorPlanResult.{status=ActorPlanStatus.channels,task=t.id};
  }
  if t.dependency_count<0 || t.dependency_count>ACTOR_TASKS {return ActorPlanResult.{status=ActorPlanStatus.dependency,task=t.id};}
 }
 for t,i:tasks {
  for k:0..<t.dependency_count {
   id:=t.dependencies[k];at:= -1;
   for other,j:tasks {if other.id==id {at=j;}}
   if at<0 {return ActorPlanResult.{status=ActorPlanStatus.dependency,task=t.id,related=id};}
   bit:=cast(u32)(1<<at);
   if (before[i] & bit)!=0 {return ActorPlanResult.{status=ActorPlanStatus.dependency,task=t.id,related=id};}
   before[i]|=bit;
  }
  for other,j:tasks {if other.phase<t.phase {before[i]|=cast(u32)(1<<j);}}
 }
 // Transitive closure: a task requires everything required by its ancestors.
 for k:0..<tasks.count {for i:0..<tasks.count {
  if (before[i] & cast(u32)(1<<k))!=0 {before[i]|=before[k];}
 }}
 for t,i:tasks {if (before[i] & cast(u32)(1<<i))!=0 {return ActorPlanResult.{status=ActorPlanStatus.cycle,task=t.id};}}
 for a,i:tasks {for j:i+1..<tasks.count {
  b:=tasks[j];hazard:=(a.writes & (b.reads | b.writes)) | (b.writes & a.reads);
  if hazard!=0 && (before[i] & cast(u32)(1<<j))==0 && (before[j] & cast(u32)(1<<i))==0 {
   return ActorPlanResult.{status=ActorPlanStatus.conflict,task=a.id,related=b.id};
  }
 }}
 // One-based ID ranks let each selection scan a bounded canonical priority
 // range, independently of authored array positions (including ID_MAX).
 rank:[ACTOR_TASKS]int;
 for t,i:tasks {for other:tasks {if t.id>=other.id {rank[i]+=1;}}}
 result:ActorPlanResult;done:u32;
 for step:0..<tasks.count {
  best:= -1;
  for priority:0..<tasks.count {
   for t,i:tasks {
    if rank[i]!=priority+1 || (done & cast(u32)(1<<i))!=0 || (before[i] & (4294967295 ^ done))!=0 {continue;}
    best=i;break;
   }
   if best>=0 {break;}
  }
  // A cycle was already refused by closure, so at least one task is ready.
  t:=tasks[best];result.plan.steps[step]=ActorPlanStep.{id=t.id,phase=t.phase,reads=t.reads,writes=t.writes};
  done|=cast(u32)(1<<best);
 }
 result.plan.n=tasks.count;result.plan.valid=true;return result;
}
