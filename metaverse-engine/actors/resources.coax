// Actor root claims use the shared stream's existing logical owner.
#load "definitions.coax";
#load "../core/assets.coax" as assets;
#load "../render/registry.coax" as gpu;
#authority;
ActorResources :: struct {valid:bool;manifest:assets.AssetId;epoch:int;n:int;roots:[ACTOR_ROOTS]int;claims:[ACTOR_ROOTS]ResourceReference;}
#load "tests/resources.coax" #test;
actor_resources_hold :: (a:ActorArchetype,s:[]ResourceStream,m:[]ResourceManifest)->ActorResources #effects(all) {
 if !a.valid || a.root_count<0 || a.root_count>ACTOR_ROOTS || !resource_stream_bound(s,m) || s[0].closing || !assets.asset_same(a.manifest,m[0].identity) {return ActorResources.{};}
 next:=[1]ResourceStream.[s[0]];out:=ActorResources.{manifest=m[0].identity,epoch=s[0].epoch,n=a.root_count};
 for i:0..<a.root_count {
  // The stream admits the owner index before allocating a claim.
  root:=a.roots[i];
  claim:=resource_stream_hold(next[..],m,root);if claim.slot<0 {return ActorResources.{};}
  out.roots[i]=root;out.claims[i]=claim;
 }
 out.valid=true;s[0]=next[0];return out;
}
actor_resources_bound :: (lease:ActorResources,s:[]ResourceStream,m:[]ResourceManifest)->bool #effects(all) {
 if !lease.valid || lease.n<0 || lease.n>ACTOR_ROOTS || !resource_stream_bound(s,m) || lease.epoch!=s[0].epoch || !assets.asset_same(lease.manifest,m[0].identity) {return false;}
 for i:0..<lease.n {
  ref:=lease.claims[i];if ref.slot<0 || ref.slot>=RESOURCE_STREAM_REFERENCES || ref.epoch!=s[0].epoch {return false;}
  entry:=s[0].claims[ref.slot];if !entry.live || entry.serial!=ref.serial || entry.root!=lease.roots[i] {return false;}
 }
 return true;
}
actor_resources_ready :: (lease:ActorResources,s:[]ResourceStream,m:[]ResourceManifest)->bool #effects(all) {
 if !actor_resources_bound(lease,s,m) || s[0].closing {return false;}
 for i:0..<lease.n {if !resource_stream_ready(s,lease.roots[i]) {return false;}}return true;
}
actor_resources_drop :: (lease:[]ActorResources,s:[]ResourceStream,m:[]ResourceManifest)->bool #effects(all) {
 if !actor_resources_bound(lease[0],s,m) {return false;}next:=[1]ResourceStream.[s[0]];
 for i:0..<lease[0].n {if !resource_stream_drop(next[..],m,lease[0].claims[i]) {return false;}}
 s[0]=next[0];lease[0]=ActorResources.{};return true;
}
