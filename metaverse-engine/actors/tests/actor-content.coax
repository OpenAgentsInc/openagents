// Receipt projection of the compiled authoring data; no simulation logic.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../lab.coax";
#load "../../core/assets.coax" as assets;
#run_steps 250000000;
tool_main :: ()->int #export_c #effects(all) {
 for preset:0..<3 {c:=ifx preset==0 then ACTOR_LAB_NORMAL else ifx preset==1 then ACTOR_LAB_GUARD else ACTOR_LAB_PATH;
 for i:0..<c.n {d:=c.items[i];base:=c.native[i];hash:[64]u8;schema:[64]u8;manifest:[64]u8;
 #assert assets.asset_hex(d.content,hash[..]) && assets.asset_hex(base.schema,schema[..]) && assets.asset_hex(base.manifest,manifest[..]);
 print("preset=% id=% revision=% profile=% schema=% manifest=% roots=% phases=% speed_cm=% radius_cm=% sense=% search=%\n",preset,d.id,d.revision,cast(string)hash[..],cast(string)schema[..],cast(string)manifest[..],base.root_count,base.plan.n,d.parameters.speed,d.parameters.radius,d.parameters.sense_work,d.parameters.path_work);
 }}return 0;
}
