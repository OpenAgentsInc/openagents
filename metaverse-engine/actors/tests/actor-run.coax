// Native receipts for the actual playable actor route and SDK frame entry.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../lab.coax";
#load "../../core/assets.coax" as assets;
#run_steps 250000000;
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) {return 2;}fps:=args_whole(args_at(a[..],0));s:[1]ActorLab;profile:=ifx args_count(a[..])>1 then args_whole(args_at(a[..],1)) else 0;
 if !actor_lab_open(s[..],profile) || !actor_lab_trial(s[..],fps,false,true) {print("actor trial refused at %\n",s[0].world[0].clock.ticks);return 1;}
 contract:[64]u8;#assert actor_contract_hex(fps,contract[..]);print("{\"profile\":\"actors-1\",\"contract_hash\":\"%\",\"fps\":%,\"controls\":[",cast(string)contract[..],fps);for r:0..<s[0].control_n {if r>0 {print(",");}print("[%,%,%,%]",actor_lab_control_word(s[..],r,0),actor_lab_control_word(s[..],r,1),actor_lab_control_word(s[..],r,2),actor_lab_control_word(s[..],r,3));}print("],\"trace\":[");
 for row:0..<s[0].trace_n {if row>0 {print(",");}h:[64]u8;#assert assets.asset_hex(s[0].trace_ids[row],h[..]);print("{\"hash\":\"%\",\"metrics\":{",cast(string)h[..]);
  for i:0..<ACTOR_LAB_METRICS {if i>0 {print(",");}print("\"%\":%",actor_lab_metric_name(i),s[0].trace_metrics[row][i]);}print("}}");
 }h:[64]u8;#assert actor_lab_hash(s[..],h[..]);print("],\"final\":{\"hash\":\"%\",\"metrics\":{",cast(string)h[..]);for i:0..<ACTOR_LAB_METRICS {if i>0 {print(",");}print("\"%\":%",actor_lab_metric_name(i),actor_lab_metric(s[..],i));}print("}}}\n");return 0;
}
