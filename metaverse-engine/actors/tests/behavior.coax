behavior_test_plan :: ()->BehaviorPlan #effects(all) {
 a:=behavior_fixture_archetype();d:=behavior_fixture_definition();s:=behavior_fixture_schema();refs:StateRefs;anchors:=[2]int.[100,200];
 r:=behavior_compile(a,s,refs,d,anchors[..]);#assert r.status==BehaviorPlanStatus.ok;return r.plan;
}
behavior_test_facts :: (p:BehaviorPlan)->BehaviorFacts #effects(all) {
 s:=behavior_fixture_schema();refs:StateRefs;store:=state_construct(s,refs,1);
 f:=behavior_project(p,s,store,refs,1);#assert f.valid;return f;
}
behavior_test_clock :: (tick:int)->clock.FrameClock #effects(all) {return clock.loop_frame(clock.FrameClock.{ticks=tick-1,frames=tick-1},1.0/64.0).clock;}
behavior_test_context :: ()->BehaviorContext #effects(all) {return BehaviorContext.{actor=7,generation=2,owner=3};}
#test "behavior consumes paid ticks once and times actions without a second clock" #steps 30000000 {
 p:=behavior_test_plan();f:=behavior_test_facts(p);opened:=behavior_open(p,7,2,3,1,2026,0);#assert opened.ready;
 c:=behavior_test_context();r:=behavior_step(p,opened,behavior_test_clock(1),f,c);
 #assert r.status==BehaviorStatus.ok && r.state.tick==1 && r.command.active && r.command.started && r.command.sequence==20 && r.command.verb==BEHAVIOR_HOLD;
 #assert r.state.serial==1 && r.state.draws==1 && r.work.draws==1 && r.work.actions==1 && r.work.sequences==2 && r.work.guards==1;
 again:=behavior_step(p,r.state,behavior_test_clock(1),f,c);#assert again.status==BehaviorStatus.clock && again.state.serial==1 && again.state.tick==1 && !again.command.active;
 r=behavior_step(p,r.state,behavior_test_clock(2),f,c);#assert r.status==BehaviorStatus.ok && r.state.successes==1 && r.state.serial==2 && r.event_n==1 && r.events[0].outcome==BEHAVIOR_SUCCESS;
 c.signals=3;c.target=99;c.target_generation=4;r=behavior_step(p,r.state,behavior_test_clock(3),f,c);
 #assert r.status==BehaviorStatus.ok && r.command.sequence==10 && r.command.verb==BEHAVIOR_SAY && r.state.serial==3;
 r=behavior_step(p,r.state,behavior_test_clock(4),f,c);#assert r.status==BehaviorStatus.ok && !r.command.started && r.state.serial==3 && r.work.draws==0;
 r=behavior_step(p,r.state,behavior_test_clock(5),f,c);#assert r.state.successes==3 && r.command.sequence==20;
}
#test "behavior action feedback binds actor generation owner world and one action serial" #steps 30000000 {
 p:=behavior_test_plan();f:=behavior_test_facts(p);s:=behavior_open(p,7,2,3,1,2026,0);c:=behavior_test_context();r:=behavior_step(p,s,behavior_test_clock(1),f,c);s=r.state;
 key:=r.command.key;
 for which:0..<5 {bad:=c;bad.feedback=BehaviorFeedback.{key=key,outcome=BEHAVIOR_SUCCESS};
  if which==0 {bad.feedback.key.actor=8;}if which==1 {bad.feedback.key.generation=3;}if which==2 {bad.feedback.key.owner=4;}
  if which==3 {bad.feedback.key.world_epoch=2;}if which==4 {bad.feedback.key.serial=2;}
  refused:=behavior_step(p,s,behavior_test_clock(2),f,bad);#assert refused.status==BehaviorStatus.feedback && refused.state.serial==1 && refused.state.tick==1 && refused.event_n==0;
 }
 c.feedback=BehaviorFeedback.{key=key,outcome=BEHAVIOR_FAILURE};r=behavior_step(p,s,behavior_test_clock(2),f,c);
 #assert r.status==BehaviorStatus.ok && r.state.failures==1 && r.event_n==1 && r.events[0].outcome==BEHAVIOR_FAILURE;
 #assert behavior_step(p,r.state,behavior_test_clock(3),f,c).status==BehaviorStatus.feedback;
}
#test "behavior jumps choose only the current anchor and interrupt scheduled movement once" #steps 30000000 {
 a:=behavior_fixture_archetype();d:=behavior_fixture_definition();s:=behavior_fixture_schema();refs:StateRefs;anchors:=[2]int.[100,200];
 d.sequences[0].guard_n=1;d.sequences[0].guards[0]=BehaviorGuard.{kind=BEHAVIOR_SCHEDULE};d.sequences[0].cooldown=64;
 d.sequences[0].actions[0]=BehaviorAction.{verb=BEHAVIOR_GO,duration=128};
 compiled:=behavior_compile(a,s,refs,d,anchors[..]);#assert compiled.status==BehaviorPlanStatus.ok;p:=compiled.plan;
 f:=behavior_test_facts(p);c:=behavior_test_context();opened:=behavior_open(p,7,2,3,1,2026,0);
 r:=behavior_step(p,opened,behavior_test_clock(1),f,c);#assert r.command.argument==100 && r.command.anchor_slot==0 && r.state.serial==1;
 f.day=100;f.phase=7;r=behavior_step(p,r.state,behavior_test_clock(2),f,c);
 #assert r.status==BehaviorStatus.ok && r.command.argument==200 && r.command.anchor_slot==1 && r.command.started && r.state.serial==2;
 #assert r.state.interrupts==1 && r.event_n==1 && r.events[0].serial==1 && r.events[0].outcome==BEHAVIOR_INTERRUPTED && !r.state.cooling[0] && r.schedule==1 && r.anchor==200;
 bad:=r.state;bad.anchor_slot=2;bad.argument=0;#assert !behavior_state_ok(p,bad);
 r=behavior_step(p,r.state,behavior_test_clock(3),f,c);#assert !r.command.started && r.state.serial==2 && r.state.interrupts==1;
}
#test "behavior weighted choices match an independent stream oracle with and without repeat suppression" #steps 60000000 {
 a:=behavior_fixture_archetype();schema:=behavior_fixture_schema();refs:StateRefs;anchors:[1]int;
 expected:=[2][24]int.[[24]int.[20,30,20,30,10,20,30,20,10,30,10,30,10,30,20,30,20,30,20,30,20,30,20,30],
  [24]int.[20,20,30,30,10,20,30,30,20,30,10,30,10,30,20,30,20,30,30,20,20,30,30,30]];
 for mode:0..<2 {
  a.parameters[ACTOR_REPEAT]=state_int(1-mode);d:=BehaviorDefinition.{id=2,n=3};
  for i:0..<3 {d.sequences[i]=BehaviorSequence.{id=(3-i)*10,weight=3-i};}
  compiled:=behavior_compile(a,schema,refs,d,anchors[0..<0]);#assert compiled.status==BehaviorPlanStatus.ok;p:=compiled.plan;
  state:=behavior_open(p,7,2,3,1,2026,0);f:=behavior_test_facts(p);c:=behavior_test_context();
  for tick:1..<25 {r:=behavior_step(p,state,behavior_test_clock(tick),f,c);#assert r.status==BehaviorStatus.ok && r.command.sequence==expected[mode][tick-1] && r.state.draws==tick && r.state.serial==tick && r.state.successes==tick-1;state=r.state;}
 }
}
#test "behavior sequences advance once retain noninterruptible actions and cool down at the exact boundary" #steps 30000000 {
 a:=behavior_fixture_archetype();d:=behavior_fixture_definition();schema:=behavior_fixture_schema();refs:StateRefs;anchors:=[2]int.[100,200];
 d.sequences[0].actions[0].interruptible=false;d.sequences[0].action_n=2;d.sequences[0].actions[1]=BehaviorAction.{duration=2};d.sequences[1].actions[0].duration=20;
 p:=behavior_compile(a,schema,refs,d,anchors[..]).plan;f:=behavior_test_facts(p);c:=behavior_test_context();c.signals=3;c.target=99;c.target_generation=4;
 opened:=behavior_open(p,7,2,3,1,2026,0);r:=behavior_step(p,opened,behavior_test_clock(1),f,c);#assert r.command.sequence==10 && r.command.attributes==BEHAVIOR_INTERACTING;
 c.signals=0;c.target=0;c.target_generation=0;r=behavior_step(p,r.state,behavior_test_clock(2),f,c);#assert !r.command.started && r.command.sequence==10 && r.state.draws==1;
 r=behavior_step(p,r.state,behavior_test_clock(3),f,c);#assert r.event_n==2 && r.events[0].outcome==BEHAVIOR_SUCCESS && !r.events[0].finished && r.events[1].serial==0 && r.events[1].outcome==BEHAVIOR_INTERRUPTED;
 #assert r.state.interrupts==1 && r.command.sequence==20 && r.state.completed[0]==3;
 c.signals=3;c.target=99;c.target_generation=4;
 r=behavior_step(p,r.state,behavior_test_clock(4),f,c);#assert r.command.sequence==20;
 r=behavior_step(p,r.state,behavior_test_clock(5),f,c);#assert r.command.sequence==20;
 r=behavior_step(p,r.state,behavior_test_clock(6),f,c);#assert r.command.sequence==10 && r.command.started && r.state.interrupts==2;
}
#test "behavior rejects unpaid clocks stale worlds malformed contexts and exhausted cursors without partial results" #steps 60000000 {
 p:=behavior_test_plan();f:=behavior_test_facts(p);c:=behavior_test_context();s:=behavior_open(p,7,2,3,1,2026,0);
 for which:0..<14 {bad:=behavior_test_clock(1);
  if which==0 {bad.step_ns=1;}if which==1 {bad.max_steps=0;}if which==2 {bad.max_steps=9;}if which==3 {bad.max_frame_ns=0;}
  if which==4 {bad.max_frame_ns=250000001;}if which==5 {bad.frames=0;}if which==6 {bad.due=1;}if which==7 {bad.ran=0;}
  if which==8 {bad.ran=9;}if which==9 {bad.ticks=2;}if which==10 {bad.carry_ns= -1;}if which==11 {bad.carry_ns=125000000;}
  if which==12 {bad.counted_ns= -1;}if which==13 {bad.counted_ns=250000001;}
  r:=behavior_step(p,s,bad,f,c);#assert r.status==BehaviorStatus.clock && r.state.tick==0 && r.state.serial==0 && !r.command.active;
 }
 for which:0..<8 {bad:=f;
  if which==0 {bad.valid=false;}if which==1 {bad.policy.words[7]^=1;}if which==2 {bad.epoch=2;}if which==3 {bad.tick=2;}
  if which==4 {bad.day= -1;}if which==5 {bad.phase= -1;}if which==6 {bad.phase=8;}if which==7 {bad.tick= -2;}
  #assert behavior_step(p,s,behavior_test_clock(1),bad,c).status==BehaviorStatus.facts;
 }
 for which:0..<8 {bad:=c;
  if which==0 {bad.actor=8;}if which==1 {bad.generation=3;}if which==2 {bad.owner=4;}if which==3 {bad.signals=256;}
  if which==4 {bad.signals=2;}if which==5 {bad.target=99;}if which==6 {bad.signals=1;bad.target=7;bad.target_generation=1;}
  if which==7 {bad.signals=1;bad.target=99;}
  r:=behavior_step(p,s,behavior_test_clock(1),f,bad);#assert r.status!=BehaviorStatus.ok && r.state.tick==0 && r.event_n==0;
 }
 s.tick=1000000000;#assert behavior_step(p,s,behavior_test_clock(1000000001),f,c).status==BehaviorStatus.exhausted;
 s=behavior_open(p,7,2,3,1,2026,0);s.draws=1000000000;#assert behavior_step(p,s,behavior_test_clock(1),f,c).status==BehaviorStatus.exhausted;
 s.draws=0;s.serial=1000000000;#assert behavior_step(p,s,behavior_test_clock(1),f,c).status==BehaviorStatus.exhausted;
}
#test "behavior fact guards read only projected typed values and compare complete reference identities" #steps 30000000 {
 a:=behavior_fixture_archetype();d:=behavior_fixture_definition();schema:=behavior_fixture_schema();refs:StateRefs;anchors:=[2]int.[100,200];
 d.sequences[0].guards[0]=BehaviorGuard.{field=102,value=state_bool(false)};
 d.sequences[1].guard_n=1;d.sequences[1].guards[0]=BehaviorGuard.{kind=BEHAVIOR_LESS,field=101,value=state_int(2)};
 p:=behavior_compile(a,schema,refs,d,anchors[..]).plan;f:=behavior_test_facts(p);c:=behavior_test_context();s:=behavior_open(p,7,2,3,1,2026,0);
 r:=behavior_step(p,s,behavior_test_clock(1),f,c);#assert r.command.sequence==10;
 f.values[1]=state_bool(true);r=behavior_step(p,r.state,behavior_test_clock(2),f,c);#assert r.command.sequence==20 && r.state.interrupts==1;
 f.values[0]=state_int(2);r=behavior_step(p,r.state,behavior_test_clock(3),f,c);#assert r.status==BehaviorStatus.ok && !r.command.active && r.state.selected== -1;
 v:=StateValue.{kind=STATE_VECTOR,number=[3]f64.[1,2,3]};#assert behavior_value_equal(v,v);
 for which:0..<8 {other:=v;
  if which<3 {other.number[which]+=1;}if which==3 {other.kind=STATE_SCALAR;}if which==4 {other.integer=1;}
  if which==5 {other.entity=1;}if which==6 {other.generation=1;}if which==7 {other.content.words[7]=1;}
  #assert !behavior_value_equal(v,other);
 }
 g:=BehaviorGuard.{kind=BEHAVIOR_LESS,slot=0,expected=false,value=StateValue.{kind=STATE_SCALAR,number=[3]f64.[0.5,0,0]}};
 f.values[0]=StateValue.{kind=STATE_SCALAR,number=[3]f64.[0.5,0,0]};#assert behavior_guard(g,f,c,false);
 f.values[0].number[0]=0.25;#assert !behavior_guard(g,f,c,false);
}
#test "behavior owned plan shapes and initial identities have exact bounds" #steps 60000000 {
 p:=behavior_test_plan();f:=behavior_test_facts(p);c:=behavior_test_context();s:=behavior_open(p,7,2,3,1,2026,0);
 for which:0..<16 {bad:=p;
  if which==0 {bad.n=0;}if which==1 {bad.n=9;}if which==2 {bad.field_count= -1;}if which==3 {bad.field_count=9;}
  if which==4 {bad.anchor_n= -1;}if which==5 {bad.anchor_n=17;}if which==6 {bad.schedule_n= -1;}if which==7 {bad.schedule_n=9;}
  if which==8 {bad.day_ticks=0;}if which==9 {bad.day_ticks=5529601;}if which==10 {bad.sequences[0].guard_n= -1;}
  if which==11 {bad.sequences[0].guard_n=5;}if which==12 {bad.sequences[0].action_n=0;}if which==13 {bad.sequences[0].action_n=5;}
  if which==14 {bad.schedules[0].guard_n= -1;}if which==15 {bad.schedules[0].guard_n=5;}
  #assert !behavior_plan_shape(bad) && behavior_step(bad,s,behavior_test_clock(1),f,c).status==BehaviorStatus.plan;
 }
 shape:=p;shape.n=8;shape.field_count=8;shape.anchor_n=16;shape.schedule_n=8;shape.day_ticks=5529600;
 for i:0..<8 {shape.sequences[i].guard_n=4;shape.sequences[i].action_n=4;shape.schedules[i].guard_n=4;}#assert behavior_plan_shape(shape);
 shape.n=1;shape.field_count=0;shape.anchor_n=0;shape.schedule_n=0;shape.day_ticks=1;shape.sequences[0].guard_n=0;shape.sequences[0].action_n=1;#assert behavior_plan_shape(shape);
 for which:0..<10 {actor:=7;generation:=2;owner:=3;epoch:=1;tick:=0;
  if which==0 {actor=0;}if which==1 {generation=0;}if which==2 {generation=1000000001;}if which==3 {owner=0;}
  if which==4 {owner=1000000001;}if which==5 {epoch=0;}if which==6 {epoch=1000000001;}if which==7 {tick= -1;}
  if which==8 {tick=1000000001;}if which==9 {actor= -1;}
  #assert !behavior_open(p,actor,generation,owner,epoch,2026,tick).ready;
 }
 #assert behavior_open(p,1,1,1,1,-1,0).ready && behavior_open(p,9223372036854775807,1000000000,1000000000,1000000000,9223372036854775807,1000000000).ready;
 p.identity.words[7]^=1;#assert !behavior_open(p,7,2,3,1,2026,0).ready;
}
#test "behavior cursor validation refuses every malformed active and inactive state word" #steps 60000000 {
 p:=behavior_test_plan();f:=behavior_test_facts(p);c:=behavior_test_context();s:=behavior_open(p,7,2,3,1,2026,0);
 active:=behavior_step(p,s,behavior_test_clock(1),f,c).state;#assert behavior_state_ok(p,active);
 edge:=active;edge.actor=1;edge.generation=1;edge.owner=1;edge.started=0;edge.cooling[0]=true;edge.completed[0]=0;#assert behavior_state_ok(p,edge);
 edge.generation=1000000000;edge.owner=1000000000;edge.world_epoch=1000000000;#assert behavior_state_ok(p,edge);
 for which:0..<33 {bad:=active;
  if which==0 {bad.ready=false;}if which==1 {bad.policy.words[0]^=1;}if which==2 {bad.actor=0;}
  if which==3 {bad.generation=0;}if which==4 {bad.generation=1000000001;}if which==5 {bad.owner=0;}if which==6 {bad.owner=1000000001;}
  if which==7 {bad.world_epoch=0;}if which==8 {bad.world_epoch=1000000001;}
  if which==9 {bad.selected= -2;}if which==10 {bad.selected=p.n;}if which==11 {bad.last= -2;}if which==12 {bad.last=p.n;}
  if which==13 {bad.cooling[0]=true;bad.completed[0]= -1;}if which==14 {bad.cooling[0]=true;bad.completed[0]=2;}
  if which==15 {bad.completed[0]=1;}if which==16 {bad.step= -1;}if which==17 {bad.step=1;}
  if which==18 {bad.started= -1;}if which==19 {bad.started=2;}if which==20 {bad.serial=0;}
  if which==21 {bad.argument=1;}if which==22 {bad.anchor_slot=0;}if which==23 {bad.target=99;}if which==24 {bad.target_generation=1;}
  if which==25 {bad.tick= -1;}if which==26 {bad.draws= -1;}if which==27 {bad.serial= -1;}
  if which==28 {bad.successes= -1;}if which==29 {bad.failures= -1;}if which==30 {bad.interrupts= -1;}
  if which==31 {bad.draws=1000000001;}if which==32 {bad.tick=1000000001;}
  #assert !behavior_state_ok(p,bad) && behavior_step(p,bad,behavior_test_clock(2),f,c).status==BehaviorStatus.state;
 }
 for which:0..<6 {bad:=s;
  if which==0 {bad.step=1;}if which==1 {bad.started=1;}if which==2 {bad.argument=1;}
  if which==3 {bad.anchor_slot=0;}if which==4 {bad.target=99;}if which==5 {bad.target_generation=1;}
  #assert !behavior_state_ok(p,bad);
 }
 for which:0..<4 {bad:=active;
  if which==0 {bad.serial=1000000001;}if which==1 {bad.successes=1000000001;}if which==2 {bad.failures=1000000001;}if which==3 {bad.interrupts=1000000001;}
  #assert !behavior_state_ok(p,bad);
 }
}
#test "behavior commands expose every native verb and fence targets independently of interruption permission" #steps 150000000 {
 a:=behavior_fixture_archetype();a.parameters[ACTOR_CONTROLLER]=state_int(2);schema:=behavior_fixture_schema();refs:StateRefs;anchors:=[2]int.[100,200];
 for verb:0..<7 {for mode:0..<2 {
  d:=BehaviorDefinition.{id=6,n=1};d.sequences[0]=BehaviorSequence.{id=1};
  d.sequences[0].actions[0]=BehaviorAction.{verb=verb,argument=ifx verb==BEHAVIOR_GO then 100 else ifx verb==BEHAVIOR_SAY then 8 else 0,duration=3,interruptible=mode==1};
  compiled:=behavior_compile(a,schema,refs,d,anchors[..]);#assert compiled.status==BehaviorPlanStatus.ok;p:=compiled.plan;
  f:=behavior_test_facts(p);c:=behavior_test_context();c.signals=1;c.target=99;c.target_generation=4;s:=behavior_open(p,7,2,3,1,2026,0);
  r:=behavior_step(p,s,behavior_test_clock(1),f,c);moving:=verb==1 || verb==2 || verb==3 || verb==6;interacting:=verb==4 || verb==5;targeted:=verb==2 || verb==3 || verb==4;
  #assert r.status==BehaviorStatus.ok && r.command.verb==verb && r.command.attributes==(ifx moving then 1 else 0)+(ifx interacting then 2 else 0)+mode*4;
  #assert r.command.target==(ifx targeted then 99 else 0) && r.command.target_generation==(ifx targeted then 4 else 0);
  c.feedback=BehaviorFeedback.{key=r.command.key,outcome=BEHAVIOR_RUNNING};r=behavior_step(p,r.state,behavior_test_clock(2),f,c);#assert r.status==BehaviorStatus.ok && !r.command.started && r.state.serial==1;
  c.feedback=BehaviorFeedback.{};r=behavior_step(p,r.state,behavior_test_clock(3),f,c);#assert !r.command.started;
  c.feedback=BehaviorFeedback.{key=r.command.key,outcome=BEHAVIOR_RUNNING};r=behavior_step(p,r.state,behavior_test_clock(4),f,c);#assert r.command.started && r.state.serial==2;c.feedback=BehaviorFeedback.{};
  #assert r.state.successes==(ifx verb==0 || verb==5 then 1 else 0) && r.state.failures==(ifx verb==0 || verb==5 then 0 else 1);
  if targeted {
   edge:=r.state;edge.target=1;edge.target_generation=1;#assert behavior_state_ok(p,edge);edge.target_generation=1000000000;#assert behavior_state_ok(p,edge);
   c.target_generation=5;r=behavior_step(p,r.state,behavior_test_clock(5),f,c);#assert r.state.interrupts==1 && r.command.target_generation==5 && r.command.started;
   for invalid:0..<4 {bad:=r.state;if invalid==0 {bad.target=0;}if invalid==1 {bad.target=7;}if invalid==2 {bad.target_generation=0;}if invalid==3 {bad.target_generation=1000000001;}#assert !behavior_state_ok(p,bad);}
   c.signals=0;c.target=0;c.target_generation=0;r=behavior_step(p,r.state,behavior_test_clock(6),f,c);#assert !r.command.active && r.state.interrupts==2 && behavior_state_ok(p,r.state);
  }
  if verb==BEHAVIOR_GO {for invalid:0..<3 {bad:=r.state;
   if invalid==0 {bad.anchor_slot= -1;}if invalid==1 {bad.anchor_slot=2;}if invalid==2 {bad.argument=200;bad.anchor_slot=1;}
   #assert !behavior_state_ok(p,bad);
  }}
 }}
}
#test "behavior projected worlds copied facts and schedule filters retain their full admission boundary" #steps 60000000 {
 p:=behavior_test_plan();schema:=behavior_fixture_schema();refs:StateRefs;store:=state_construct(schema,refs,1);
 f:=behavior_project(p,schema,store,refs,1);store.values[0]=state_int(2);#assert f.values[0].integer==0;
 for which:0..<5 {bad:=store;
  if which==0 {bad.ready=false;}if which==1 {bad.schema=0;}if which==2 {bad.epoch=2;}if which==3 {bad.values[0]=state_int(3);}if which==4 {bad.phase=8;}
  #assert !behavior_project(p,schema,bad,refs,1).valid;
 }
 bad_schema:=schema;bad_schema.id=0;#assert !behavior_project(p,bad_schema,store,refs,1).valid;
 bad_plan:=p;bad_plan.valid=false;#assert !behavior_project(bad_plan,schema,store,refs,1).valid;
 bad_plan=p;bad_plan.schema=state_schema_id(bad_schema);bad_store:=store;bad_store.schema=0;#assert !behavior_project(bad_plan,bad_schema,bad_store,refs,1).valid;
 for which:0..<3 {bad:=p;if which==0 {bad.fields[0].slot= -1;}if which==1 {bad.fields[0].slot=2;}if which==2 {bad.fields[0].reference.id=999;}
  #assert !behavior_project(bad,schema,store,refs,1).valid;
 }
 bad_plan=p;bad_plan.fields[0]=ActorCompiledField.{slot=schema.n,reference=ActorFieldRef.{kind=STATE_INT}};#assert !behavior_project(bad_plan,schema,store,refs,1).valid;
 a:=behavior_fixture_archetype();d:=behavior_fixture_definition();anchors:=[2]int.[100,200];d.schedules[0].day_period=2;d.schedules[0].day_remainder=1;d.schedules[0].guard_n=1;
 d.schedules[0].guards[0]=BehaviorGuard.{field=102,value=state_bool(true)};d.schedules[1].anchor=0;
 p=behavior_compile(a,schema,refs,d,anchors[..]).plan;f=behavior_test_facts(p);c:=behavior_test_context();f.day=1;f.phase=3;f.values[1]=state_bool(true);
 schedule:=behavior_schedule(p,f,c);#assert schedule.active && schedule.anchor==100 && schedule.guards==1;
 f.day=2;#assert !behavior_schedule(p,f,c).active;f.day=1;f.values[1]=state_bool(false);#assert !behavior_schedule(p,f,c).active;
 f.phase=4;schedule=behavior_schedule(p,f,c);#assert !schedule.active && schedule.row==1;
 f.day=1;f.phase=3;f.values[1]=state_bool(true);opened:=behavior_open(p,7,2,3,1,2026,0);
 result:=behavior_step(p,opened,behavior_test_clock(1),f,c);#assert result.status==BehaviorStatus.ok && result.work.guards==2 && result.schedule==0 && result.anchor==100;
 p.schedule_n=0;#assert behavior_schedule(p,f,c).row== -1;
}
#test "behavior feedback shapes and all terminal counter exhaustion preserve the complete old cursor" #steps 60000000 {
 p:=behavior_test_plan();f:=behavior_test_facts(p);c:=behavior_test_context();opened:=behavior_open(p,7,2,3,1,2026,0);
 for which:0..<3 {bad:=c;if which==0 {bad.feedback.outcome= -1;}if which==1 {bad.feedback.outcome=5;}if which==2 {bad.feedback.key.serial=1;}
  #assert behavior_step(p,opened,behavior_test_clock(1),f,bad).status==BehaviorStatus.feedback;
 }
 active:=behavior_step(p,opened,behavior_test_clock(1),f,c);
 for outcome:[2]int.[-1,5] {bad:=c;bad.feedback=BehaviorFeedback.{key=active.command.key,outcome=outcome};#assert behavior_step(p,active.state,behavior_test_clock(2),f,bad).status==BehaviorStatus.feedback;}
 for which:0..<3 {s:=active.state;feedback:=c;
  if which==0 {s.successes=1000000000;}if which==1 {s.failures=1000000000;}if which==2 {s.interrupts=1000000000;}
  feedback.feedback=BehaviorFeedback.{key=active.command.key,outcome=2+which};r:=behavior_step(p,s,behavior_test_clock(2),f,feedback);
  #assert r.status==BehaviorStatus.exhausted && r.state.tick==1 && r.state.serial==1 && r.event_n==0 && !r.command.active;
 }
 bad:=c;bad.signals=1;bad.target=99;bad.target_generation=1000000001;#assert behavior_step(p,opened,behavior_test_clock(1),f,bad).status==BehaviorStatus.context;
 paid:=behavior_test_clock(1);paid.max_steps=1;#assert behavior_step(p,opened,paid,f,c).status==BehaviorStatus.ok;
 paid.max_frame_ns=1;paid.counted_ns=1;#assert behavior_step(p,opened,paid,f,c).status==BehaviorStatus.ok;
 paid=behavior_test_clock(1);paid.carry_ns=124999999;#assert behavior_step(p,opened,paid,f,c).status==BehaviorStatus.ok;
 c.signals=3;c.target=1;c.target_generation=1;#assert behavior_step(p,opened,behavior_test_clock(1),f,c).status==BehaviorStatus.ok;
 c.target_generation=1000000000;#assert behavior_step(p,opened,behavior_test_clock(1),f,c).status==BehaviorStatus.ok;
 c.signals=255;#assert behavior_step(p,opened,behavior_test_clock(1),f,c).status==BehaviorStatus.ok;
 current:=f;current.tick=1;current.day=1000000000;#assert behavior_step(p,opened,behavior_test_clock(1),current,c).status==BehaviorStatus.ok;
 current.day=1000000001;#assert behavior_step(p,opened,behavior_test_clock(1),current,c).status==BehaviorStatus.facts;
 scheduled:=clock.loop_accept_ns(clock.FrameClock.{},clock.LOOP_STEP_NS*2);partial:=clock.loop_ran_some(scheduled,1);owed:=clock.loop_ran(clock.loop_accept_ns(partial,0));
 cursor:=behavior_open(p,7,2,3,1,2026,1);#assert owed.counted_ns==0 && behavior_step(p,cursor,owed,f,c).status==BehaviorStatus.ok;
}
#test "behavior weighted groups exclude ineligible peers and retain the first eligible alternate" #steps 60000000 {
 a:=behavior_fixture_archetype();schema:=behavior_fixture_schema();refs:StateRefs;anchors:[1]int;
 d:=BehaviorDefinition.{id=9,n=2};d.sequences[0]=BehaviorSequence.{id=10,guard_n=1,weight=65535};
 d.sequences[0].guards[0]=BehaviorGuard.{kind=BEHAVIOR_SIGNAL,signal=BEHAVIOR_VISIBLE};d.sequences[1]=BehaviorSequence.{id=20};
 p:=behavior_compile(a,schema,refs,d,anchors[0..<0]).plan;f:=behavior_test_facts(p);c:=behavior_test_context();s:=behavior_open(p,7,2,3,1,2026,0);
 r:=behavior_step(p,s,behavior_test_clock(1),f,c);#assert r.status==BehaviorStatus.ok && r.command.sequence==20;
 d.sequences[0].guard_n=0;d.sequences[0].weight=1;d.sequences[1].weight=65535;
 p=behavior_compile(a,schema,refs,d,anchors[0..<0]).plan;f=behavior_test_facts(p);s=behavior_open(p,7,2,3,1,2026,0);
 r=behavior_step(p,s,behavior_test_clock(1),f,c);#assert r.command.sequence==20;
 r=behavior_step(p,r.state,behavior_test_clock(2),f,c);#assert r.status==BehaviorStatus.ok && r.command.sequence==10;
}
#test "behavior target replacement recomputes both eligibility and top priority after cooling the old sequence" #steps 30000000 {
 a:=behavior_fixture_archetype();schema:=behavior_fixture_schema();refs:StateRefs;anchors:[1]int;d:=behavior_fixture_definition();d.schedule_n=0;
 d.sequences[0].guard_n=0;d.sequences[0].cooldown=3;d.sequences[0].actions[0]=BehaviorAction.{verb=BEHAVIOR_CHASE,duration=64};
 p:=behavior_compile(a,schema,refs,d,anchors[0..<0]).plan;f:=behavior_test_facts(p);c:=behavior_test_context();c.signals=1;c.target=99;c.target_generation=4;
 s:=behavior_open(p,7,2,3,1,2026,0);r:=behavior_step(p,s,behavior_test_clock(1),f,c);#assert r.command.sequence==10;
 c.target_generation=5;r=behavior_step(p,r.state,behavior_test_clock(2),f,c);#assert r.status==BehaviorStatus.ok && r.command.sequence==20 && r.state.cooling[0] && r.state.completed[0]==2 && r.state.interrupts==1;
}
#test "behavior unavailable scheduled movement emits no null anchor while fixed anchor one stays available" #steps 30000000 {
 a:=behavior_fixture_archetype();schema:=behavior_fixture_schema();refs:StateRefs;anchors:=[1]int.[1];
 d:=BehaviorDefinition.{id=10,n=1,schedule_n=1};d.sequences[0]=BehaviorSequence.{id=1};d.sequences[0].actions[0]=BehaviorAction.{verb=BEHAVIOR_GO,duration=64};
 p:=behavior_compile(a,schema,refs,d,anchors[..]).plan;f:=behavior_test_facts(p);c:=behavior_test_context();s:=behavior_open(p,7,2,3,1,2026,0);
 r:=behavior_step(p,s,behavior_test_clock(1),f,c);#assert r.status==BehaviorStatus.ok && !r.command.active && r.state.draws==0 && r.state.serial==0;
 d.schedule_n=0;d.sequences[0].actions[0].argument=1;p=behavior_compile(a,schema,refs,d,anchors[..]).plan;f=behavior_test_facts(p);s=behavior_open(p,7,2,3,1,2026,0);
 r=behavior_step(p,s,behavior_test_clock(1),f,c);#assert r.status==BehaviorStatus.ok && r.command.active && r.command.argument==1 && r.command.anchor_slot==0;
}
#test "behavior unavailable next actions fail the sequence without minting an action serial" #steps 30000000 {
 a:=behavior_fixture_archetype();schema:=behavior_fixture_schema();refs:StateRefs;anchors:[1]int;
 d:=BehaviorDefinition.{id=11,n=1};d.sequences[0]=BehaviorSequence.{id=1,action_n=2,cooldown=3};d.sequences[0].actions[1]=BehaviorAction.{verb=BEHAVIOR_CHASE,duration=64};
 p:=behavior_compile(a,schema,refs,d,anchors[0..<0]).plan;f:=behavior_test_facts(p);c:=behavior_test_context();s:=behavior_open(p,7,2,3,1,2026,0);
 r:=behavior_step(p,s,behavior_test_clock(1),f,c);#assert r.command.active && r.state.serial==1;
 r=behavior_step(p,r.state,behavior_test_clock(2),f,c);
 #assert r.status==BehaviorStatus.ok && !r.command.active && r.state.serial==1 && r.state.draws==1 && r.state.failures==1 && r.state.interrupts==0 && r.event_n==2;
 #assert r.events[0].outcome==BEHAVIOR_SUCCESS && !r.events[0].finished && r.events[1].outcome==BEHAVIOR_FAILURE && r.events[1].serial==0 && r.events[1].step==1 && r.events[1].finished;
 #assert behavior_state_ok(p,r.state);
}
#forall "behavior action pairs clear old command arguments anchors and targets before the next body action" first:0..<7,next:0..<7 #steps 200000000 {
 a:=behavior_fixture_archetype();a.parameters[ACTOR_CONTROLLER]=state_int(2);schema:=behavior_fixture_schema();refs:StateRefs;anchors:=[2]int.[100,200];
 d:=BehaviorDefinition.{id=7,n=1};d.sequences[0]=BehaviorSequence.{id=1,cooldown=2,action_n=2};
 for verb,k:[2]int.[first,next] {d.sequences[0].actions[k]=BehaviorAction.{verb=verb,argument=ifx verb==BEHAVIOR_GO then 100 else ifx verb==BEHAVIOR_SAY then 8 else 0};}
 compiled:=behavior_compile(a,schema,refs,d,anchors[..]);#assert compiled.status==BehaviorPlanStatus.ok;p:=compiled.plan;
 f:=behavior_test_facts(p);c:=behavior_test_context();c.signals=1;c.target=99;c.target_generation=4;
 s:=behavior_open(p,7,2,3,1,2026,0);r:=behavior_step(p,s,behavior_test_clock(1),f,c);
 c.feedback=BehaviorFeedback.{key=r.command.key,outcome=BEHAVIOR_SUCCESS};r=behavior_step(p,r.state,behavior_test_clock(2),f,c);
 #assert r.status==BehaviorStatus.ok && r.command.verb==next && r.command.started && r.command.step==1 && r.state.serial==2 && r.event_n==1 && !r.events[0].finished;
 #assert r.command.argument==(ifx next==BEHAVIOR_GO then 100 else ifx next==BEHAVIOR_SAY then 8 else 0) && r.command.anchor_slot==(ifx next==BEHAVIOR_GO then 0 else -1);
 targeted:=next==BEHAVIOR_CHASE || next==BEHAVIOR_FLEE || next==BEHAVIOR_INTERACT;
 #assert r.command.target==(ifx targeted then 99 else 0) && r.command.target_generation==(ifx targeted then 4 else 0) && behavior_state_ok(p,r.state);
 c.feedback=BehaviorFeedback.{key=r.command.key,outcome=BEHAVIOR_SUCCESS};r=behavior_step(p,r.state,behavior_test_clock(3),f,c);
 #assert r.status==BehaviorStatus.ok && !r.command.active && r.state.selected== -1 && r.state.successes==1 && r.state.serial==2 && r.state.draws==1 && r.events[0].finished && behavior_state_ok(p,r.state);
 c.feedback=BehaviorFeedback.{};r=behavior_step(p,r.state,behavior_test_clock(4),f,c);#assert r.status==BehaviorStatus.ok && !r.command.active && r.event_n==0;
 r=behavior_step(p,r.state,behavior_test_clock(5),f,c);#assert r.status==BehaviorStatus.ok && r.command.started && r.command.step==0 && r.state.serial==3 && r.state.draws==2;
}
