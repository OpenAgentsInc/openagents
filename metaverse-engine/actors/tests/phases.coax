actor_phase_task :: (id:int,phase:int)->ActorTask {
 return ActorTask.{id=id,phase=phase};
}
#test "actor phases compile stable IDs independent of source order and preserve complete task records" {
 tasks:=[6]ActorTask.[actor_phase_task(60,5),actor_phase_task(30,2),actor_phase_task(10,0),
  actor_phase_task(50,4),actor_phase_task(40,3),actor_phase_task(20,1)];
 reads:=[6]u32.[128,9,2,4,8,48];writes:=[6]u32.[15,2,4,8,48,64];
 for i:0..<6 {tasks[i].reads=reads[tasks[i].phase];tasks[i].writes=writes[tasks[i].phase];}
 r:=actor_plan_compile(1,tasks[..]);#assert r.status==ActorPlanStatus.ok && r.plan.valid && r.plan.n==6;
 for i:0..<6 {s:=r.plan.steps[i];#assert s.id==(i+1)*10 && s.phase==i && s.reads==reads[i] && s.writes==writes[i];}
 for i:0..<6 {for j:i+1..<6 {swap:=tasks[i];tasks[i]=tasks[j];tasks[j]=swap;}}
 other:=actor_plan_compile(1,tasks[..]);#assert other.status==ActorPlanStatus.ok;
 for i:0..<6 {#assert other.plan.steps[i].id==r.plan.steps[i].id;}
}
#test "actor dependencies resolve stable IDs and order conflicting services transitively" {
 tasks:=[4]ActorTask.[actor_phase_task(40,0),actor_phase_task(20,0),actor_phase_task(30,0),actor_phase_task(10,0)];
 tasks[0].writes=1;tasks[3].reads=1;
 tasks[3].dependency_count=1;tasks[3].dependencies[0]=30;
 tasks[2].dependency_count=1;tasks[2].dependencies[0]=20;
 tasks[1].dependency_count=1;tasks[1].dependencies[0]=40;
 r:=actor_plan_compile(1,tasks[..]);#assert r.status==ActorPlanStatus.ok;
 expected:=[4]int.[40,20,30,10];for i:0..<4 {#assert r.plan.steps[i].id==expected[i];}
 tasks[3].dependency_count=0;r=actor_plan_compile(1,tasks[..]);
 #assert r.status==ActorPlanStatus.conflict && !r.plan.valid && r.plan.n==0 && r.task==40 && r.related==10;
 tasks[3].dependency_count=1;tasks[0].dependency_count=1;tasks[0].dependencies[0]=10;
 r=actor_plan_compile(1,tasks[..]);#assert r.status==ActorPlanStatus.cycle && !r.plan.valid;
}
#test "actor task schema refuses unknown fields and dependencies before publishing any schedule" {
 tasks:=[2]ActorTask.[actor_phase_task(1,0),actor_phase_task(2,1)];
 for which:0..<10 {
  bad:=tasks;
  if which==0 {bad[0].id=0;}if which==1 {bad[1].id=1;}
  if which==2 {bad[0].phase= -1;}if which==3 {bad[0].phase=6;}
  if which==4 {bad[0].reads=256;}if which==5 {bad[1].writes=1;}
  if which==6 {bad[0].dependency_count= -1;}if which==7 {bad[0].dependency_count=17;}
  if which==8 {bad[0].dependency_count=1;bad[0].dependencies[0]=99;}
  if which==9 {bad[1].dependency_count=2;bad[1].dependencies[0]=1;bad[1].dependencies[1]=1;}
  r:=actor_plan_compile(1,bad[..]);#assert r.status!=ActorPlanStatus.ok && !r.plan.valid && r.plan.n==0;
 }
 #assert actor_plan_compile(0,tasks[..]).status==ActorPlanStatus.version;
 #assert actor_plan_compile(2,tasks[..]).status==ActorPlanStatus.version;
 #assert actor_plan_compile(1,tasks[0..<0]).status==ActorPlanStatus.capacity;
 full:[17]ActorTask;for i:0..<17 {full[i]=actor_phase_task(i+1,0);}
 #assert actor_plan_compile(1,full[..]).status==ActorPlanStatus.capacity;
 full[15].id=9223372036854775807;
 r:=actor_plan_compile(1,full[0..<16]);#assert r.status==ActorPlanStatus.ok && r.plan.n==16 && r.plan.steps[15].id==9223372036854775807;
 full[0].dependency_count=16;for i:0..<16 {full[0].dependencies[i]=full[i].id;}
 #assert actor_plan_compile(1,full[0..<16]).status==ActorPlanStatus.cycle;
 full[0].dependency_count=17;#assert actor_plan_compile(1,full[0..<16]).status==ActorPlanStatus.dependency;
 tasks[0].dependency_count=1;tasks[0].dependencies[0]=99;r=actor_plan_compile(1,tasks[..]);
 #assert r.status==ActorPlanStatus.dependency && r.task==1 && r.related==99;
}
#test "actor phase ownership forbids moving gameplay from presentation or before the owning stage" {
 masks:=[6]u32.[15,2,4,8,48,64];tasks:=[1]ActorTask.[actor_phase_task(1,0)];
 for phase:0..<6 {for channel:0..<9 {
  tasks[0].phase=phase;tasks[0].reads=255;tasks[0].writes=cast(u32)(1<<channel);
  r:=actor_plan_compile(1,tasks[..]);
  #assert (r.status==ActorPlanStatus.ok)==((masks[phase] & tasks[0].writes)!=0);
 }}
 tasks[0].writes=0;#assert actor_plan_compile(1,tasks[..]).status==ActorPlanStatus.ok;
 // Explicit dependencies cannot run presentation before movement or sense before lifecycle.
 pair:=[2]ActorTask.[actor_phase_task(2,3),actor_phase_task(1,5)];
 pair[0].dependency_count=1;pair[0].dependencies[0]=1;
 #assert actor_plan_compile(1,pair[..]).status==ActorPlanStatus.cycle;
}

// Independent small oracle: enumerate every possible execution order. It uses
// neither reachability masks nor the compiler's closure/ready-task algorithm.
#forall "actor three-service graphs match exhaustive execution-order enumeration" graph:0..<64 {
 for profile:0..<4 {
  tasks:=[3]ActorTask.[actor_phase_task(30,0),actor_phase_task(10,0),actor_phase_task(20,0)];
  if profile==1 {for i:0..<3 {tasks[i].writes=1;}}
  if profile==2 {tasks[0].writes=1;tasks[1].reads=1;tasks[2].writes=2;}
  if profile==3 {tasks[0].phase=2;tasks[1].phase=0;tasks[2].phase=1;}
  bit:=0;
  for i:0..<3 {for j:0..<3 {if i==j {continue;}
   if (graph & (1<<bit))!=0 {tasks[i].dependencies[tasks[i].dependency_count]=tasks[j].id;tasks[i].dependency_count+=1;}
   bit+=1;
  }}
  permutations:=[6][3]int.[[3]int.[0,1,2],[3]int.[0,2,1],[3]int.[1,0,2],
   [3]int.[1,2,0],[3]int.[2,0,1],[3]int.[2,1,0]];
  valid:[6]bool;count:=0;best:= -1;
  for p,k:permutations {
   positions:[3]int;for i:0..<3 {positions[p[i]]=i;}
   ok:=true;
   for t,i:tasks {
    for d:0..<t.dependency_count {for other,j:tasks {
     if t.dependencies[d]==other.id && positions[j]>=positions[i] {ok=false;}
    }}
    for other,j:tasks {if other.phase<t.phase && positions[j]>=positions[i] {ok=false;}}
   }
   valid[k]=ok;if !ok {continue;}count+=1;
   earlier:=best<0;
   if best>=0 {for i:0..<3 {
    a:=tasks[p[i]].id;b:=tasks[permutations[best][i]].id;
    if a==b {continue;}earlier=a<b;break;
   }}
   if earlier {best=k;}
  }
  conflict:=false;
  for i:0..<3 {for j:i+1..<3 {
   touches:=false;
   for channel:0..<8 {
    iw:=((tasks[i].writes>>channel)&1)!=0;jw:=((tasks[j].writes>>channel)&1)!=0;
    ir:=((tasks[i].reads>>channel)&1)!=0;jr:=((tasks[j].reads>>channel)&1)!=0;
    if (iw && (jr || jw)) || (jw && ir) {touches=true;}
   }
   if !touches {continue;}left:=false;right:=false;
   for p,k:permutations {if !valid[k] {continue;}positions:[3]int;for at:0..<3 {positions[p[at]]=at;}
    if positions[i]<positions[j] {left=true;}else {right=true;}
   }
   if left && right {conflict=true;}
  }}
  r:=actor_plan_compile(1,tasks[..]);
  if count==0 {#assert r.status==ActorPlanStatus.cycle && !r.plan.valid;}
  else if conflict {#assert r.status==ActorPlanStatus.conflict && !r.plan.valid;}
  else {#assert r.status==ActorPlanStatus.ok && r.plan.valid && r.plan.n==3;
   for i:0..<3 {#assert r.plan.steps[i].id==tasks[permutations[best][i]].id;}
  }
 }
}
