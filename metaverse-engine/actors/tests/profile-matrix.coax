actor_test_parameter :: (p:[]ActorParameters,f:int,v:int) {
 if f==0 {p[0].controller=v;}else if f==1 {p[0].physics=v;}else if f==2 {p[0].animation=v;}else if f==3 {p[0].speed=v;}else if f==4 {p[0].radius=v;}
 else if f==5 {p[0].alert=v;p[0].discover=100000;p[0].track=100000;p[0].cull=100000;}else if f==6 {p[0].discover=v;p[0].alert=0;p[0].track=100000;p[0].cull=100000;}
 else if f==7 {p[0].track=v;p[0].alert=0;p[0].discover=0;p[0].cull=100000;}else if f==8 {p[0].cull=v;p[0].alert=0;p[0].discover=0;p[0].track=0;}
 else if f==9 {p[0].vertical=v;}else if f==10 {p[0].period=v;}else if f==11 {p[0].grace=v;}else if f==12 {p[0].forget=v;}else if f==13 {p[0].sense_work=v;}else if f==14 {p[0].path_work=v;}else if f==15 {p[0].retry=v;}else if f==16 {p[0].stuck=v;}
 else if f==17 {p[0].services=cast(u32)v;}else if f==18 {p[0].resources=cast(u32)v;}else if f==19 {p[0].hooks=cast(u32)v;}else if f==20 {p[0].n=v;}else if f==21 {p[0].rows=v;}
 else if f==22 {p[0].rules[0].verb=v;p[0].controller=1;}else if f==23 {p[0].rules[0].goal=v;p[0].controller=1;}else if f==24 {p[0].rules[0].require=cast(u32)v;}else if f==25 {p[0].rules[0].forbid=cast(u32)v;}
 else if f==26 {p[0].rules[0].priority=v;}else if f==27 {p[0].rules[0].weight=v;}else if f==28 {p[0].rules[0].duration=v;}else if f==29 {p[0].rules[0].cooldown=v;}
}
#test "typed parameter bounds admit both endpoints and refuse both neighbours" {
 lows:=[30]int.[0,0,0,1,10,0,0,0,0,0,1,0,1,1,1,1,1,127,1,0,1,1,0,0,0,0,0,1,1,0];
 highs:=[30]int.[1,0,0,800,80,100000,100000,100000,100000,10000,64,640,230400,16,128,640,640,127,63,7,8,8,5,4,127,127,7,1000,640,640];
 for f:0..<30 {for side:0..<4 {v:=ifx side==0 then lows[f] else ifx side==1 then highs[f] else ifx side==2 then lows[f]-1 else highs[f]+1;
  if v<0 && (f==17 || f==18 || f==19 || f==24 || f==25) {continue;}p:[1]ActorParameters;actor_test_parameter(p[..],f,v);#assert actor_parameters_ok(p[0])==(side<2);
 }}
 p:ActorParameters;p.alert=601;#assert !actor_parameters_ok(p);p=ActorParameters.{};p.discover=801;#assert !actor_parameters_ok(p);p=ActorParameters.{};p.track=2001;#assert !actor_parameters_ok(p);
 p=ActorParameters.{};p.rules[0].require=1;p.rules[0].forbid=1;#assert !actor_parameters_ok(p);
 for mode:0..<2 {p=ActorParameters.{};if mode==0 {p.rules[0].verb=ACTOR_DRIVE;}else {p.rules[0].goal=ACTOR_RIDER;}#assert !actor_parameters_ok(p);}
}
#test "all override groups flatten exactly without keeping author parent lookups" {
 base:ActorParameters;own:ActorParameters;own.speed=123;own.radius=44;own.controller=1;own.physics=1;own.animation=1;
 own.discover=99;own.alert=33;own.track=123;own.vertical=7;own.cull=999;own.period=8;own.grace=2;own.forget=9;
 own.sense_work=7;own.path_work=9;own.retry=4;own.stuck=5;own.n=2;own.rules[0].verb=3;own.repeat=true;own.rows=2;own.schedule[0].anchor=2;own.services=5;own.resources=3;own.hooks=1;own.deps[1]=5;
 for group:0..<8 {mask:=cast(u32)1<<cast(u32)group;p:=actor_inherit(base,own,mask);
 #assert p.speed==(ifx group==0 then 123 else base.speed) && p.radius==(ifx group==0 then 44 else base.radius) && p.controller==(ifx group==0 then 1 else 0) && p.physics==(ifx group==0 then 1 else 0) && p.animation==(ifx group==0 then 1 else 0);
 #assert p.discover==(ifx group==1 then 99 else base.discover) && p.alert==(ifx group==1 then 33 else base.alert) && p.track==(ifx group==1 then 123 else base.track) && p.vertical==(ifx group==1 then 7 else base.vertical) && p.cull==(ifx group==1 then 999 else base.cull) && p.period==(ifx group==1 then 8 else base.period) && p.grace==(ifx group==1 then 2 else base.grace) && p.forget==(ifx group==1 then 9 else base.forget);
 #assert p.sense_work==(ifx group==2 then 7 else base.sense_work) && p.path_work==(ifx group==2 then 9 else base.path_work) && p.retry==(ifx group==2 then 4 else base.retry) && p.stuck==(ifx group==2 then 5 else base.stuck);
 #assert p.n==(ifx group==3 then 2 else 1) && p.rules[0].verb==(ifx group==3 then 3 else 0) && p.repeat==(group==3);
 #assert p.rows==(ifx group==4 then 2 else 1) && p.schedule[0].anchor==(ifx group==4 then 2 else 1);
 #assert p.services==(ifx group==5 then cast(u32)5 else base.services) && p.resources==(ifx group==6 then cast(u32)3 else base.resources);
 #assert p.hooks==(ifx group==7 then cast(u32)1 else base.hooks) && p.deps[1]==(ifx group==7 then cast(u32)5 else base.deps[1]);
 }
}
#test "compiled content identity includes only resolved active authored fields" {
 schema:=StateSchema.{id=1,n=1};schema.fields[0]=StateField.{id=10,name="gate"};refs:StateRefs;a:=[1]ActorAuthor.[ActorAuthor.{id=1}];c:=actor_compile(a[..],schema,refs,1);#assert c.status==ACTOR_OK && assets.asset_same(c.items[0].content,actor_definition_id(c.items[0]));
 d:=c.items[0];d.parameters.rules[0].interruptible=false;#assert !assets.asset_same(d.content,actor_definition_id(d));d=c.items[0];d.parameters.rules[1].verb=3;#assert assets.asset_same(d.content,actor_definition_id(d));
}
#test "flat definitions match independent little-endian SHA goldens at default and full extents" #steps 200000000 #traversal 2000000000 {
 schema:=StateSchema.{id=1,n=1};schema.fields[0]=StateField.{id=10,name="gate"};refs:StateRefs;a:=[1]ActorAuthor.[ActorAuthor.{id=1}];c:=actor_compile(a[..],schema,refs,16);h:[64]u8;#assert c.status==ACTOR_OK && assets.asset_hex(c.items[0].content,h[..]) && cast(string)h[..]=="c3fdaea1cbf730ff5506b4cc8f91c0ddd1cf4c85a1322ac9bb91636d71098535";
 schema.id=7;schema.revision=3;schema.day_ticks=16;p:=ActorParameters.{controller=1,speed=800,radius=80,discover=100000,alert=123,track=100000,vertical=10000,cull=100000,period=64,grace=640,forget=230400,sense_work=16,path_work=128,retry=640,stuck=640,n=8,repeat=true,rows=8,resources=31,hooks=3};
 for i:0..<6 {p.deps[i]=cast(u32)((1<<i)-1);}for i:0..<8 {p.rules[i]=ActorRule.{verb=i%6,goal=i%5,require=cast(u32)1<<cast(u32)(i%7),priority=i,weight=i+1,duration=i+1,cooldown=i,interruptible=i%2==0};p.schedule[i]=ActorSchedule.{phase=i*2,anchor=i+1,field=10,equals=i%2};}
 a[0]=ActorAuthor.{id=123,revision=7,parameters=p};c=actor_compile(a[..],schema,refs,16);#assert c.status==ACTOR_OK && assets.asset_hex(c.items[0].content,h[..]) && cast(string)h[..]=="e004b927d0eb20ea955cb4e3ee61e0c182a4910f2a198629fb346ebdb81cbdfd";
}
#test "catalogue capacities unknown fields cycles and schedules refuse with no published catalogue" #steps 300000000 #traversal 3000000000 {
 schema:=StateSchema.{id=1,n=1,day_ticks=16};schema.fields[0]=StateField.{id=10,name="gate"};refs:StateRefs;all:[9]ActorAuthor;for i:0..<9 {all[i]=ActorAuthor.{id=i+1};}
 #assert actor_compile(all[0..<0],schema,refs,16).status==ACTOR_CAPACITY && actor_compile(all[0..<9],schema,refs,16).status==ACTOR_CAPACITY;
 c:=actor_compile(all[0..<8],schema,refs,16);#assert c.status==ACTOR_OK && c.n==8;
 for which:0..<29 {a:=all;s:=schema;anchors:=16;
  if which==0 {s.n=0;}else if which==1 {anchors=0;}else if which==2 {anchors=17;}else if which==3 {a[0].format=0;}else if which==4 {a[0].format=2;}else if which==5 {a[0].id=0;}else if which==6 {a[0].revision=0;}else if which==7 {a[0].parent= -1;}else if which==8 {a[0].overrides=256;}else if which==9 {a[1].id=1;}
  else if which==10 {a[0].parameters.speed=0;}else if which==11 {a[0].parameters.schedule[0].phase= -1;}else if which==12 {a[0].parameters.schedule[0].phase=16;}else if which==13 {a[0].parameters.schedule[0].anchor=0;}else if which==14 {a[0].parameters.schedule[0].anchor=17;}else if which==15 {a[0].parameters.rows=2;}
  else if which==16 {a[0].parameters.schedule[0].field=11;}else if which==17 {a[0].parameters.schedule[0].field=10;a[0].parameters.schedule[0].equals=2;}else if which==18 {a[0].parameters.schedule[0].field=10;a[0].parameters.schedule[0].equals= -1;}
  else if which==19 {s.fields[0].kind=STATE_SCALAR;s.fields[0].initial=StateValue.{kind=STATE_SCALAR};a[0].parameters.schedule[0].field=10;}
  else if which==20 {a[0].parameters.deps[0]=64;}else if which==21 {a[0].parameters.deps[1]=0;}else if which==22 {a[0].parameters.deps[5]=0;}
  else if which==23 {a[0].parent=2;a[1].parent=1;}else if which==24 {a[0].parameters.deps[0]=2;}else if which==25 {a[0].parent=99;}
  else if which==26 {a[0].parent=3;a[2].parent=1;}else if which==27 {a[0].parameters.schedule[0].field= -1;}else {a[0].parameters.speed=321;a[0].parameters.radius=10;}
  c=actor_compile(a[0..<8],s,refs,anchors);#assert c.status==(ifx which==23 || which==24 || which==26 then ACTOR_CYCLE else ACTOR_INVALID) && c.n==0;
 }
 // Child precedes its parent, and an empty override mask inherits everything.
 a:=[2]ActorAuthor.[ActorAuthor.{id=2,parent=1,overrides=0},ActorAuthor.{id=1}];a[1].parameters.speed=320;a[1].parameters.radius=10;c=actor_compile(a[..],schema,refs,1);#assert c.status==ACTOR_OK && c.items[0].parameters.speed==320 && c.items[0].parameters.radius==10 && c.items[0].id==2;
 // Boolean schedule guards and equality endpoints resolve to a typed address.
 schema.fields[0].kind=STATE_BOOL;schema.fields[0].initial=state_bool(false);a[1].parameters.rows=2;a[1].parameters.schedule[0]=ActorSchedule.{field=10,equals=0};a[1].parameters.schedule[1]=ActorSchedule.{phase=15,field=10,equals=1};c=actor_compile(a[1..<2],schema,refs,1);#assert c.status==ACTOR_OK;
 live:=state_construct(schema,refs,1);#assert actor_schedule(c.items[0],live)==1;live.phase=14;live.values[0]=state_bool(true);#assert actor_schedule(c.items[0],live)==0;live.phase=15;#assert actor_schedule(c.items[0],live)==1;
}
#test "inheritance at slot zero and canonical guard-free indices do not alias authored lookup state" {
 schema:=StateSchema.{id=1,n=1};schema.fields[0]=StateField.{id=10,name="gate"};refs:StateRefs;a:=[2]ActorAuthor.[ActorAuthor.{id=1},ActorAuthor.{id=2,parent=1,overrides=0}];a[0].parameters.speed=300;a[0].parameters.schedule[0].index=7;c:=actor_compile(a[..],schema,refs,1);
 #assert c.status==ACTOR_OK && c.items[1].parameters.speed==300 && c.items[0].parameters.schedule[0].index== -1 && c.items[1].parameters.schedule[0].index== -1;
 a[0].parameters.deps[5]=63;#assert actor_compile(a[..],schema,refs,1).status==ACTOR_CYCLE;
}
