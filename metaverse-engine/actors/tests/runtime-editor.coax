#load "../../core/entity.coax" as entities;
#load "../../ai/decide.coax" as decisions;
#load "../../ai/stimulus.coax" as senses;
#load "../../core/space.coax" as spatial;
#load "../../core/replay.coax" as replay;
#test "editor hooks reset live behavior knowledge navigation and actual pending model ownership" #steps 300000000 #traversal 3000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.definition.parameters.hooks=4;
 a.brain=ActorBrain.{tick=0,rule=0,until=50,last=0,draws=10};a.brain.ready[0]=20;
 a.perception=ActorPerception.{tick=0,target=7,generation=1,last_seen=0,seen=true};a.perception.memory.count=1;a.perception.memory.latest=0;a.perception.memory.items[0]=senses.Stimulus.{kind=senses.StimulusKind.sight,source=7,tick=0,at=spatial.world_point(5,0,4)};
 a.navigation=ActorNavigation.{key=ActorNavKey.{actor=a.id,generation=add_sat(entities.entity_generation(a.handle).value,1),owner=a.owner,world=1,nav=1,radius=30,request=1},status=ACTOR_NAV_PENDING,goal=102,asked=0,serial=1};a.model=decisions.DecideIntent.{kind=decisions.DECIDE_HOLD};f[0].base.pool[0].actors[i]=a;
 back:[1]replay.ReplayBacking;session:=replay.replay_backing(back[..]);replay.replay_record(session,0,1);ticket:=actor_model_ask(f[0].base.pool[..],f[0].base.handle,session,0,1,1,4);#assert ticket.status==ACTOR_OK;
 #assert actor_editor_reset(f[0].base.pool[..],f[0].base.handle,a.owner,1);work:=actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1));got:=f[0].base.pool[0].actors[i];
 #assert work.ok && work.search==0 && got.brain.draws==1 && got.brain.until==17 && got.brain.tick==1 && got.choice.reason==ACTOR_CHOSEN && got.perception.memory.count==0;
 #assert got.navigation.serial==2 && got.navigation.asked==1 && got.model.kind==decisions.DECIDE_NONE && got.model_world==0 && got.model_nav==0 && !decisions.decide_waiting(f[0].base.pool[0].models[..],i) && f[0].base.pool[0].hooks[2]==1;
}
#test "a new semantic revision revokes existing model intent and ticket before sensing or action selection" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);back:[1]replay.ReplayBacking;session:=replay.replay_backing(back[..]);replay.replay_record(session,0,1);
 ticket:=actor_model_ask(f[0].base.pool[..],f[0].base.handle,session,0,2,1,4);#assert ticket.status==ACTOR_OK;f[0].base.pool[0].actors[i].model=decisions.DecideIntent.{kind=decisions.DECIDE_HOLD};
 #assert actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1)).ok;got:=f[0].base.pool[0].actors[i];#assert got.model.kind==decisions.DECIDE_NONE && got.model_world==0 && got.model_nav==0 && !decisions.decide_waiting(f[0].base.pool[0].models[..],i);
}
#test "a disabled actor's editor hook leaves the exact invalidated navigation mode" #steps 200000000 #traversal 2000000000 {
 f:[1]ActorRuntimeFixture;actor_runtime_fixture(f[..]);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.scope_enabled=false;a.facts.values[0]=state_bool(false);a.navigation.status=ACTOR_NAV_PENDING;f[0].base.pool[0].actors[i]=a;
 #assert actor_editor_reset(f[0].base.pool[..],f[0].base.handle,a.owner,1);work:=actor_runtime_step(f[0].base.pool[..],actor_runtime_world(f[..],1));got:=f[0].base.pool[0].actors[i];#assert work.ok && got.choice.reason==ACTOR_SLEEP && got.navigation.status==ACTOR_NAV_INVALIDATED && got.facts.values[0].integer==0;
}
