#load "../../core/entity.coax" as entities;
#load "../../physics/query-scene.coax" as scene;
#load "../../physics/query-filter.coax" as filters;
#load "../../physics/query.coax" as queries;
#test "semantic sight uses solid categories self exclusion eye height and the actual target endpoint" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<7 {f:=base;store:=actor_entity_store(f[0].base.pool[..]);target:=entities.entity_spawn(store);entities.entity_flush(store);i:=entities.entity_slot(f[0].base.handle);f[0].base.pool[0].actors[i].definition.parameters.period=1;f[0].base.pool[0].actors[i].choice=ActorChoice.{verb=ACTOR_FLEE,goal=ACTOR_AWAY};
 boxes:=[6]f32.[4.4,0,3.5,4.6,3,4.5];metadata:=[1]filters.QueryCollider.[filters.QueryCollider.{ref=filters.ColliderRef.{id=1,generation=1},shape=queries.QueryShape.box,surface=1}];
 if mode==1 {metadata[0].role=filters.QueryRole.sensor;}else if mode==2 {metadata[0].entity=f[0].base.handle;}else if mode==3 {boxes=[6]f32.[5,0,3.5,6,3,4.5];}else if mode==4 {boxes=[6]f32.[6,0,3.5,7,3,4.5];}else if mode==5 {boxes=[6]f32.[3.5,2,3.5,5.5,2.2,4.5];}else if mode==6 {boxes=[6]f32.[3.5,4,3.5,5.5,5,4.5];}
 targets:=[1]ActorTarget.[ActorTarget.{handle=target.handle,x=500,y=ifx mode==6 then 100 else 0,z=400}];w:=actor_runtime_world(f[..],1);w.targets=targets[..];w.queries.geometry.boxes=boxes[..];w.queries.metadata=metadata[..];work:[1]ActorWork;actor_runtime_sense(f[0].base.pool[..],i,w,work[..]);a:=f[0].base.pool[0].actors[i];
 #assert work[0].rays==1 && work[0].sense==1 && work[0].refused==0 && a.choice.verb==ACTOR_HOLD && a.choice.work==(ifx mode==0 then 0 else 7) && a.perception.seen==(mode!=0) && a.perception.generation==(ifx mode==0 then 0 else 1);
 }
}
#test "broad phase spends no rays beyond circular range culling or relative height limits" #steps 300000000 #traversal 3000000000 {
 base:[1]ActorRuntimeFixture;actor_runtime_fixture(base[..]);
 for mode:0..<5 {f:=base;store:=actor_entity_store(f[0].base.pool[..]);target:=entities.entity_spawn(store);entities.entity_flush(store);i:=entities.entity_slot(f[0].base.handle);a:=f[0].base.pool[0].actors[i];a.definition.parameters.period=1;if mode==2 || mode==3 {a.body.body.pos.y=1;}f[0].base.pool[0].actors[i]=a;
 targets:=[1]ActorTarget.[ActorTarget.{handle=target.handle,x=ifx mode==1 then 900 else ifx mode==4 then 1000 else 500,y=ifx mode==2 then 400 else ifx mode==3 then -200 else 0,z=ifx mode==1 then 900 else 400}];w:=actor_runtime_world(f[..],1);w.targets=targets[..];if mode==0 {w.focus_x=2400;w.focus_z=2400;}
 work:[1]ActorWork;actor_runtime_sense(f[0].base.pool[..],i,w,work[..]);got:=f[0].base.pool[0].actors[i];#assert work[0].rays==(ifx mode<2 then 0 else 1) && work[0].refused==0 && got.perception.seen==(mode>=2);
 }
}
