#test "attributes are finalized pose and typed intent reads and notices are bounded stable event data" #steps 300000000 #traversal 3000000000 {
 f:=actor_test_pool();h:=f.handle;a:=actor_attributes(f.pool[..],h);#assert a.valid && !a.moving && !a.controlled && !a.interacting && !a.interruptible && !a.airborne;
 f.pool[0].actors[0].brain=ActorBrain.{tick=4,rule=0};f.pool[0].actors[0].choice=ActorChoice.{status=ACTOR_OK,verb=ACTOR_INTERACT,reason=ACTOR_CHOSEN};f.pool[0].actors[0].goal_x=300;f.pool[0].actors[0].goal_z=400;f.pool[0].actors[0].perception.target=7;
 a=actor_attributes(f.pool[..],h);#assert a.interacting && a.interruptible;notice:=actor_notice(f.pool[..],h,4);#assert notice.kind==ACTOR_NOTICE_INTEREST && notice.source==1 && notice.generation==1 && notice.tick==4 && notice.target==7 && notice.x==300 && notice.z==400;
 f.pool[0].actors[0].choice.verb=ACTOR_FLEE;f.pool[0].actors[0].choice.reason=ACTOR_INTERRUPTED;notice=actor_notice(f.pool[..],h,4);#assert notice.kind==ACTOR_NOTICE_FEAR;
 f.pool[0].actors[0].body.body.vel.x=1;a=actor_attributes(f.pool[..],h);#assert a.moving;f.pool[0].actors[0].body.body.vel.x=0;f.pool[0].actors[0].body.body.vel.z=1;f.pool[0].actors[0].body.body.act=walking.Act.airborne;f.pool[0].actors[0].controller=1;f.pool[0].actors[0].definition.parameters.rules[0].interruptible=false;a=actor_attributes(f.pool[..],h);#assert a.moving && a.airborne && a.controlled && !a.interacting && !a.interruptible;
 for field:0..<8 {g:=f;if field==0 {g.pool[0].ready=false;}else if field==1 {removed:=actor_remove(g.pool[..],h);}else if field==2 {g.pool[0].actors[0].id=0;}else if field==3 {g.pool[0].actors[0].brain.rule= -1;}else if field==4 {g.pool[0].actors[0].brain.tick=3;}else if field==5 {g.pool[0].actors[0].choice.status=ACTOR_INVALID;}else if field==6 {g.pool[0].actors[0].choice.reason=ACTOR_HELD;}else {g.pool[0].actors[0].choice.verb=ACTOR_GO;}#assert actor_notice(g.pool[..],h,4).kind==0;}
 #assert !actor_attributes(f.pool[0..<0],h).valid && actor_notice(f.pool[0..<0],h,4).kind==0;
 #assert !actor_attributes(f.pool[..],entities.ENTITY_NONE).valid && actor_notice(f.pool[..],entities.ENTITY_NONE,4).kind==0;
 removed:=actor_remove(f.pool[..],h);#assert !actor_attributes(f.pool[..],h).valid;
}
