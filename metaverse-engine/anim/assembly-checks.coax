// Independent small geometry and admission checks; loaded only for checks.
#test "rigid assembly names are owned bounded printable canonical values" {
 n:=assembly_name("left hip");#assert n.n==8 && cast(string)n.bytes[0..<n.n]=="left hip" && assembly_name("").n==0 && assembly_name("bad\nname").n==0;
 b:[128]u8;for i:0..<128 {b[i]='a';}#assert assembly_name(cast(string)b[0..<127]).n==127 && assembly_name(cast(string)b[..]).n==0;
 #assert assembly_name_ok(n);n.bytes[9]=1;#assert !assembly_name_ok(n);n=assembly_name("a");n.bytes[0]=127;#assert !assembly_name_ok(n);n.n=128;#assert !assembly_name_ok(n);
}
#test "canonical names include every printable boundary and compare the first byte" {
 for text:[4]string.[" ","~","a","printable !~"] {n:=assembly_name(text);#assert n.n==text.count && assembly_name_ok(n) && assembly_name_same(n,n);}
 #assert !assembly_name_same(assembly_name("a"),assembly_name("b")) && !assembly_name_same(assembly_name("a"),assembly_name("ab"));
 #assert !assembly_name_ok(AssemblyName.{});b:[128]u8;for i:0..<127 {b[i]='~';}n:=assembly_name(cast(string)b[0..<127]);#assert assembly_name_ok(n);n.n=128;#assert !assembly_name_ok(n);
 n=assembly_name("a");n.bytes[0]=31;#assert !assembly_name_ok(n);n.bytes[0]=127;#assert !assembly_name_ok(n);#assert assembly_name(cast(string)n.bytes[0..<1]).n==0;
 n.n=128;for i:0..<128 {n.bytes[i]='a';}#assert !assembly_name_ok(n);
}
#test "wire counts and extents are refused before any fixed array is indexed" {
 for n:[4]int.[0,1,32,33] {#assert assembly_counts(n,1,1,1,3)==(n==1 || n==32);}
 for n:[4]int.[0,1,96,97] {#assert assembly_counts(1,n,1,1,3)==(n==1 || n==96);}
 for n:[4]int.[0,1,256,257] {#assert assembly_counts(1,1,n,1,3)==(n==1 || n==256);}
 for n:[4]int.[0,1,2000000,2000001] {#assert assembly_counts(1,1,1,n,3)==(n==1 || n==2000000);}
 for n:[6]int.[0,2,3,4,6000000,6000003] {#assert assembly_counts(1,1,1,1,n)==(n==3 || n==6000000);}
 #assert assembly_span(0,1,0,1) && assembly_span(7,2,7,9) && !assembly_span(7,3,7,9) && !assembly_span(8,1,7,9) && !assembly_span(0,0,0,1);
}
#test "palette rows reproduce analytic rigid transforms at every explosion endpoint" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();a[0].part[0].low=v3(0.9,-0.1,-0.1);a[0].part[0].high=v3(1.1,0.1,0.1);a[0].part[1].explode=v3(2,4,6);angles:[2]f32;angles[0]=1.57079632679;p:[1]AssemblyPose;#assert assembly_pose(a[..],angles[..],p[..]);
 out:[48]f32;for e:[3]f32.[0,0.5,1] {for k:0..<48 {out[k]=99;}#assert assembly_palette(a[..],p[..],e,0,out[..]);#assert abs(out[16])<0.00001 && abs(out[17]+1)<0.00001;
  #assert abs(out[19]-2*e)<0.00001 && abs(out[23]-4*e)<0.00001 && abs(out[27]-6*e)<0.00001;
  for i:0..<3 {#assert out[i*16+13]==0 && out[i*16+14]==0 && out[i*16+15]==0;}
 }
 #assert !assembly_palette(a[0..<0],p[..],0,-1,out[..]) && !assembly_palette(a[..],p[0..<0],0,-1,out[..]);
 a[0].part[0].node=3;#assert !assembly_admit(a[..]);a[0]=assembly_fixture();a[0].part[0].parent=3;#assert !assembly_admit(a[..]);
 // A translated hinge exercises the palette translation as well as rotation.
 a[0]=assembly_fixture();angles[0]=0;angles[1]=1.57079632679;#assert assembly_pose(a[..],angles[..],p[..]) && assembly_palette(a[..],p[..],0,-1,out[..]);#assert abs(out[19]-1)<0.00001 && abs(out[23]+1)<0.00001;
}
#test "assembly capacity endpoints are usable and out of range counts fail independently" {
 a:[1]RigidAssembly;
 for count:[2]int.[1,32] {a[0]=assembly_fixture();a[0].joints=count;for i:0..<count {a[0].joint[i]=a[0].joint[0];a[0].joint[i].name.bytes[0]=cast(u8)(33+i);}for i:0..<3 {a[0].part[i].joint= -1;}#assert assembly_admit(a[..]);}
 for count:[2]int.[1,96] {a[0]=assembly_fixture();a[0].parts=count;a[0].nodes=count;a[0].vertices=count;a[0].indices=count*3;for i:0..<count {a[0].part[i]=a[0].part[0];a[0].part[i].joint= -1;a[0].part[i].name=assembly_name("aa");a[0].part[i].name.bytes[0]=cast(u8)(33+i%90);a[0].part[i].name.bytes[1]=cast(u8)(33+i/90);a[0].part[i].node=i;a[0].part[i].first_vertex=i;a[0].part[i].vertices=1;a[0].part[i].first_index=i*3;a[0].part[i].indices=3;}#assert assembly_admit(a[..]);}
 a[0]=assembly_fixture();a[0].parts=1;a[0].nodes=1;a[0].vertices=1;a[0].indices=3;a[0].part[0].vertices=1;#assert assembly_admit(a[..]);
 a[0].nodes=256;#assert assembly_admit(a[..]);a[0].nodes=257;#assert !assembly_admit(a[..]);a[0].nodes=0;#assert !assembly_admit(a[..]);
 a[0].nodes=1;a[0].vertices=2000000;a[0].part[0].vertices=2000000;#assert assembly_admit(a[..]);a[0].vertices=2000001;a[0].part[0].vertices=2000001;#assert !assembly_admit(a[..]);
 a[0].vertices=1;a[0].part[0].vertices=1;a[0].indices=6000000;a[0].part[0].indices=6000000;#assert assembly_admit(a[..]);a[0].indices=6000003;a[0].part[0].indices=6000003;#assert !assembly_admit(a[..]);
 a[0]=assembly_fixture();a[0].vertices=0;#assert !assembly_admit(a[..]);a[0]=assembly_fixture();a[0].indices=2;#assert !assembly_admit(a[..]);a[0]=assembly_fixture();a[0].vertices=10;#assert !assembly_admit(a[..]);a[0]=assembly_fixture();a[0].indices=12;#assert !assembly_admit(a[..]);
}
#test "assembly graph limits and zero-width joint and part bounds have precise meaning" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();a[0].joint[0].low=1;a[0].joint[0].high=1;a[0].joint[0].stand=1;a[0].joint[1].stand= -2;#assert assembly_admit(a[..]);a[0].joint[1].stand=2;#assert assembly_admit(a[..]);a[0].joint[1].stand= -3;#assert !assembly_admit(a[..]);
 a[0]=assembly_fixture();a[0].part[0].low=a[0].part[0].high;#assert assembly_admit(a[..]);a[0].part[0].low.y=10;#assert !assembly_admit(a[..]);a[0]=assembly_fixture();a[0].part[0].low.z=10;#assert !assembly_admit(a[..]);
 a[0]=assembly_fixture();a[0].part[0].joint= -2;#assert !assembly_admit(a[..]);a[0]=assembly_fixture();a[0].part[0].label=AssemblyName.{};#assert !assembly_admit(a[..]);a[0]=assembly_fixture();a[0].part[0].name=AssemblyName.{};#assert !assembly_admit(a[..]);
 a[0]=assembly_fixture();a[0].part[0].high.x=1000000;#assert !assembly_admit(a[..]);
 a[0]=assembly_fixture();a[0].part[0].vertices=8;a[0].part[1].first_vertex=8;a[0].part[1].vertices=2;#assert !assembly_admit(a[..]);
 a[0]=assembly_fixture();a[0].part[0].indices=6;a[0].part[1].first_index=6;a[0].part[1].indices=6;#assert !assembly_admit(a[..]);
 // An indirect cycle through source node zero must not be treated as a root.
 a[0]=assembly_fixture();a[0].part[0].parent=2;a[0].part[2].parent=1;a[0].part[1].parent=0;#assert !assembly_admit(a[..]);
 a[0].part[0].parent= -1;#assert assembly_admit(a[..]);
}
#test "root and child pose limits are inclusive and the recorded stand is the identity" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();angles:[2]f32;p:[1]AssemblyPose;
 angles[0]= -2;angles[1]=2;#assert assembly_pose(a[..],angles[..],p[..]);angles[0]=2;angles[1]= -2;#assert assembly_pose(a[..],angles[..],p[..]);angles[0]= -3;#assert !assembly_pose(a[..],angles[..],p[..]);
 a[0].joint[0].stand=0.8;a[0].joint[1].stand= -0.4;angles[0]=0.8;angles[1]= -0.4;#assert assembly_pose(a[..],angles[..],p[..]);x:=assembly_point(a[..],p[..],0,v3(1,2,3),0);#assert abs(x.x-1)<0.00001 && abs(x.y-2)<0.00001 && abs(x.z-3)<0.00001;
 angles[0]+=1.57079632679;angles[1]= -0.4;#assert !assembly_pose(a[..],angles[..],p[..]);angles[0]=1.8;#assert assembly_pose(a[..],angles[..],p[..]);x=assembly_point(a[..],p[..],0,v3(1,0,0),0);#assert abs(x.x-0.5403023059)<0.00001 && abs(x.y-0.8414709848)<0.00001;
}
#test "a two-link assembly composes quarter turns about rest pivots and preserves its sibling" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();#assert assembly_admit(a[..]);angles:[ASSEMBLY_JOINTS]f32;angles[0]=1.57079632679;angles[1]=1.57079632679;p:[1]AssemblyPose;
 #assert assembly_pose(a[..],angles[..],p[..]);x:=assembly_point(a[..],p[..],1,v3(2,0,0),0);#assert abs(x.x+1)<0.00001 && abs(x.y-1)<0.00001 && abs(x.z)<0.00001;
 sibling:=assembly_point(a[..],p[..],2,v3(5,0,0),0);#assert sibling.x==5 && sibling.y==0;
 exploded:=assembly_point(a[..],p[..],1,v3(2,0,0),0.5);#assert abs(exploded.x+1)<0.00001 && abs(exploded.y-2)<0.00001;
 before:=p[0];angles[1]=3;#assert !assembly_pose(a[..],angles[..],p[..]) && p[0].position[1].x==before.position[1].x;
 #assert !assembly_pose(a[..],angles[0..<1],p[..]) && !assembly_pose(a[..],angles[..],p[0..<0]);
}
#test "rigid assembly palettes use the shared pose matrix and separate explosion from selection" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();angles:[32]f32;angles[0]=1.57079632679;p:[1]AssemblyPose;#assert assembly_pose(a[..],angles[..],p[..]);out:[48]f32;
 #assert assembly_palette(a[..],p[..],0.5,1,out[..]);#assert abs(out[0])<0.00001 && abs(out[1]+1)<0.00001 && abs(out[4]-1)<0.00001 && out[12]==0 && out[28]==1;
 #assert out[19]==0 && out[23]==1 && out[32]==1 && out[37]==1 && out[42]==1;
 #assert !assembly_palette(a[..],p[..],-1,0,out[..]) && !assembly_palette(a[..],p[..],2,0,out[..]) && !assembly_palette(a[..],p[..],0,0,out[0..<47]);
}
#test "rigid assembly admission refuses invalid identities graphs names bounds and geometry" {
 a:[1]RigidAssembly;good:=assembly_fixture();a[0]=good;a[0].source=AssetId.{};#assert !assembly_admit(a[..]);a[0]=good;a[0].description=AssetId.{};#assert !assembly_admit(a[..]);a[0]=good;a[0].topology=AssetId.{};#assert !assembly_admit(a[..]);
 for n:[4]int.[0,33,-1,100] {a[0]=good;a[0].joints=n;#assert !assembly_admit(a[..]);}for n:[3]int.[0,97,-1] {a[0]=good;a[0].parts=n;#assert !assembly_admit(a[..]);}
 a[0]=good;a[0].joint[1].parent=1;#assert !assembly_admit(a[..]);a[0]=good;a[0].joint[1].parent= -2;#assert !assembly_admit(a[..]);a[0]=good;a[0].joint[1].name=a[0].joint[0].name;#assert !assembly_admit(a[..]);
 a[0]=good;a[0].joint[0].axis=v3(0,0,0);#assert !assembly_admit(a[..]);a[0]=good;a[0].joint[0].stand=3;#assert !assembly_admit(a[..]);a[0]=good;a[0].joint[0].low=4;#assert !assembly_admit(a[..]);
 a[0]=good;a[0].part[1].name=a[0].part[0].name;#assert !assembly_admit(a[..]);a[0]=good;a[0].part[1].node=0;#assert !assembly_admit(a[..]);a[0]=good;a[0].part[0].parent=1;a[0].part[1].parent=0;#assert !assembly_admit(a[..]);
 a[0]=good;a[0].part[0].joint=2;#assert !assembly_admit(a[..]);a[0]=good;a[0].part[0].first_index=1;#assert !assembly_admit(a[..]);a[0]=good;a[0].part[1].vertices=0;#assert !assembly_admit(a[..]);a[0]=good;a[0].part[0].low.x=10;#assert !assembly_admit(a[..]);
 a[0]=good;a[0].part[0].rest[0]=1000000;#assert !assembly_admit(a[..]);a[0]=good;a[0].part[0].explode.y=1000000;#assert !assembly_admit(a[..]);
 #assert !assembly_admit(a[0..<0]);
}

#test "rigid assembly native nonfinite input preserves the previous result" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();angles:[ASSEMBLY_JOINTS]f32;p:[1]AssemblyPose;
 angles[1]=f32_from_bits(0x7fc00000);#assert !assembly_pose(a[..],angles[..],p[..]);
 a[0].part[0].rest[0]=f32_from_bits(0x7f800000);#assert !assembly_admit(a[..]);
}
// A hand-authored independent two-link fixture: a root pivot at zero, a child
// pivot at x=1, and an unbound sibling at x=5. Counts cover three tiny meshes.
assembly_fixture :: ()->RigidAssembly #effects(all) {
 a:RigidAssembly;a.source.words[0]=1;a.description.words[0]=2;a.topology.words[0]=3;a.joints=2;a.parts=3;a.nodes=3;a.vertices=9;a.indices=9;
 a.joint[0]=AssemblyJoint.{name=assembly_name("root"),axis=v3(0,0,1),low= -2,high=2};a.joint[1]=AssemblyJoint.{name=assembly_name("child"),parent=0,axis=v3(0,0,1),pivot=v3(1,0,0),low= -2,high=2};
 for i:0..<3 {p:=a.part[i];p.name=assembly_name([3]string.["part-a","part-b","sibling"][i]);p.label=p.name;p.node=i;p.joint=ifx i<2 then i else -1;p.first_vertex=i*3;p.vertices=3;p.first_index=i*3;p.indices=3;p.low=v3(cast(f32)i-0.1,-0.1,-0.1);p.high=v3(cast(f32)i+0.1,0.1,0.1);for k:0..<3 {p.rest[k*4+k]=1;}a.part[i]=p;}
 a.part[1].explode=v3(0,2,0);a.part[2].low.x=4.9;a.part[2].high.x=5.1;return a;
}
