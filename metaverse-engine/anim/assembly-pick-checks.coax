// Independent transformed-ray scenarios.
#test "a root-owned asymmetric box rotates into the ray before its tied child" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();a[0].part[0].low=v3(0.9,-0.1,-0.1);a[0].part[0].high=v3(1.1,0.1,0.1);angles:[2]f32;angles[0]=1.57079632679;p:[1]AssemblyPose;#assert assembly_pose(a[..],angles[..],p[..]);
 #assert assembly_pick(a[..],p[..],world_point(0,1,3),world_point(0,0,-1),0)==0;
 #assert assembly_pick(a[..],p[..],world_point(5,0,3),world_point(0,0,-1),0)==2 && assembly_pick(a[..],p[..],world_point(9,0,3),world_point(0,0,-1),0)== -1;
}
#test "ray picking transforms root child explosion and direction and keeps the nearest first tie" {
 a:[1]RigidAssembly;a[0]=assembly_fixture();angles:[2]f32;angles[0]=1.57079632679;angles[1]=1.57079632679;p:[1]AssemblyPose;#assert assembly_pose(a[..],angles[..],p[..]);
 #assert assembly_pick(a[..],p[..],world_point(0,0,3),world_point(0,0,-1),0)==0;
 #assert assembly_pick(a[..],p[..],world_point(0,1,3),world_point(0,0,-1),0)==1;
 #assert assembly_pick(a[..],p[..],world_point(0,2,3),world_point(0,0,-1),0.5)==1;
 #assert assembly_pick(a[..],p[..],world_point(-3,0,0),world_point(1,0,0),0)==0;
 // Farther sibling is visited last, but cannot replace the nearer root.
 angles[0]=0;angles[1]=0;#assert assembly_pose(a[..],angles[..],p[..]);#assert assembly_pick(a[..],p[..],world_point(-3,0,0),world_point(1,0,0),0)==0;
 a[0].part[1].low=a[0].part[0].low;a[0].part[1].high=a[0].part[0].high;a[0].part[1].joint=0;#assert assembly_pick(a[..],p[..],world_point(0,0,3),world_point(0,0,-1),0)==0;
}
