 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";c:=w[0].library[0].clips[0];p:=anim_local(out[..],c.body.offset+15*56);#assert abs(p.q.z-0.70710677)<0.00001 && abs(p.q.w-0.70710677)<0.00001;
}

