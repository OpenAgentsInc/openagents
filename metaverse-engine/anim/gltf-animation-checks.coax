 for rate:[2]f32.[0,241] {#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],rate,out[..],w[..])=="gltf-sample-rate";}
 for time:[3]f32.[-1,601,0] {aw_put(b[..],172,f32_bits(time));#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="gltf-key-times";}
