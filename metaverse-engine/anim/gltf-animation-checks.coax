 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";c:=w[0].library[0].clips[0];for k:0..<3 {#assert c.curves[k]==k && abs(anim_float(out[..],c.face.offset+(15*3+k)*4)-[3]f32.[0.25,0.35,0.45][k])<0.000001;}m:=anim_test_replace(cast(string)z[0..<n],"\"bufferView\":9,\"componentType\":5126,\"count\":6,\"type\":\"SCALAR\"","\"bufferView\":9,\"componentType\":5126,\"count\":2,\"type\":\"VEC3\"",a[..]);#assert m>0 && ag_test_open(cast(string)a[0..<m],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="gltf-animation-shape";
