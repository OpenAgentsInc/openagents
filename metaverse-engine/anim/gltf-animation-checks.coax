#test "glTF source clocks bake rotations and morph curves through the common clip sampler" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]);w:[1]AiBuild;out:[65536]u8;scene:[1]AgScene;#assert ag_scene(g[..],"made",out[..],w[..],scene[..])=="" && ag_animations(g[..],scene[..],30,out[..],w[..])=="";
 c:=w[0].library[0].clips[0];#assert w[0].library[0].count==1 && c.frames==31 && c.rate==30 && c.length==1 && c.joint_count==2 && c.curve_count==1;
 p:=anim_local(out[..],c.body.offset+(15*2)*28);#assert abs(p.q.y-0.38268343)<0.00001 && abs(p.q.w-0.92387953)<0.00001 && anim_float(out[..],c.face.offset+15*4)==0.5;
 #assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]);text:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"input\":6,\"output\":7","\"input\":6,\"output\":7,\"interpolation\":\"STEP\"",text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],scene[..])=="" && ag_animations(g[..],scene[..],30,out[..],w[..])=="";c=w[0].library[0].clips[0];#assert anim_local(out[..],c.body.offset+15*2*28).q.y==0 && abs(anim_local(out[..],c.body.offset+30*2*28).q.y-0.70710677)<0.00001;
}
#test "glTF animation refuses duplicate targets invalid clocks unsupported paths and insufficient output" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;w:[1]AiBuild;out:[65536]u8;scene:[1]AgScene;text:[8192]u8;
 for row:[5]string.["rotation|other","\"node\":1,\"path\":\"weights\"|\"node\":0,\"path\":\"rotation\"","\"input\":6|\"input\":99","\"output\":7|\"output\":99","\"input\":6,\"output\":7|\"input\":6,\"output\":7,\"interpolation\":\"OTHER\""] {split:=0;for c,k:row {if c=='|' {split=k;break;}}n:=anim_test_replace(AG_CHARACTER,row[0..<split],row[split+1..<row.count],text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],scene[..])=="" && ag_animations(g[..],scene[..],30,out[..],w[..])!="";}
 aw_put(b[..],172,f32_bits(0));#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],scene[..])=="" && ag_animations(g[..],scene[..],30,out[..],w[..])=="gltf-key-times";
}

#test "glTF sampling keeps a nominal frame grid through source float rounding" {
 b:[252]u8;ag_character_bytes(b[..]);aw_put(b[..],172,0x3f800001);g:[1]AgFile;nodes:[2048]JvNode;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]);w:[1]AiBuild;out:[65536]u8;scene:[1]AgScene;#assert ag_scene(g[..],"rounded",out[..],w[..],scene[..])=="" && ag_animations(g[..],scene[..],30,out[..],w[..])=="";c:=w[0].library[0].clips[0];#assert c.frames==31 && c.length==f32_from_bits(0x3f800001) && abs(c.rate-30)<0.00001;
}

#test "glTF cubic Hermite scales both tangents by the source key interval" {
 b:[256]u8;aw_put(b[..],4,f32_bits(2));values:=[18]f32.[0,0,0,1,2,3,2,3,4,0,1,2,5,8,11,0,0,0];for value,k:values {aw_put(b[..],16+k*4,f32_bits(value));}g:=[1]AgFile.[AgFile.{binary=b[..]}];c:=AgChannel.{mode=2,width=3,time=AgAccess.{ok=true,count=2,components=1,component=5126,bytes=4,stride=4,offset=0},data=AgAccess.{ok=true,count=6,components=3,component=5126,bytes=4,stride=12,offset=16}};
 span:=ag_span(g[..],c,1);#assert span.a==0 && span.b==1 && span.share==0.5 && span.dt==2;for k:0..<3 {#assert ag_curve(g[..],c,span,k)==[3]f32.[3.5,5.5,7.5][k];}span=ag_span(g[..],c,0.5);for k:0..<3 {#assert ag_curve(g[..],c,span,k)==[3]f32.[2.1875,3.6875,5.1875][k];}
 span=ag_span(g[..],c,-1);#assert ag_curve(g[..],c,span,2)==3;span=ag_span(g[..],c,3);#assert ag_curve(g[..],c,span,2)==11 && !g[0].bad;
}
#test "glTF bracket search handles every source key and interpolation gap" {
 b:[128]u8;for t,k:[5]f32.[0,0.2,1,2,5] {aw_put(b[..],k*4,f32_bits(t));aw_put(b[..],32+k*4,f32_bits(cast(f32)k));}g:=[1]AgFile.[AgFile.{binary=b[..]}];c:=AgChannel.{mode=1,width=1,time=AgAccess.{ok=true,count=5,components=1,component=5126,bytes=4,stride=4,offset=0},data=AgAccess.{ok=true,count=5,components=1,component=5126,bytes=4,stride=4,offset=32}};
 for t,k:[11]f32.[-1,0,0.1,0.2,0.5,1,1.5,2,4,5,9] {span:=ag_span(g[..],c,t);#assert ag_curve(g[..],c,span,0)==[11]f32.[0,0,0,1,1,2,2,3,3,4,4][k];}c.time.count=1;#assert ag_curve(g[..],c,ag_span(g[..],c,3),0)==0;
}
#test "glTF quaternion interpolation follows the sphere and normalizes cubic components" {
 b:[256]u8;aw_put(b[..],4,f32_bits(2));aw_put(b[..],28,f32_bits(1));aw_put(b[..],36,f32_bits(1));g:=[1]AgFile.[AgFile.{binary=b[..]}];c:=AgChannel.{width=4,time=AgAccess.{ok=true,count=2,components=1,component=5126,bytes=4,stride=4,offset=0},data=AgAccess.{ok=true,count=2,components=4,component=5126,bytes=4,stride=16,offset=16}};q:=ag_rotation(g[..],c,ag_span(g[..],c,0.5));#assert abs(q.y-0.38268343)<0.00001 && abs(q.w-0.92387953)<0.00001;
 c.mode=1;q=ag_rotation(g[..],c,ag_span(g[..],c,1));#assert q.y==0 && q.w==1;
 for k:16..<112 {b[k]=0;}aw_put(b[..],44,f32_bits(1));aw_put(b[..],52,f32_bits(1));aw_put(b[..],84,f32_bits(1));c.mode=2;c.data.count=6;q=ag_rotation(g[..],c,ag_span(g[..],c,1));#assert abs(q.y-0.8320503)<0.00001 && abs(q.w-0.5547002)<0.00001 && !g[0].bad;
 aw_put(b[..],52,0);aw_put(b[..],84,0);aw_put(b[..],92,f32_bits(-1));q=ag_rotation(g[..],c,ag_span(g[..],c,1));#assert g[0].bad;
 g[0].bad=false;aw_put(b[..],84,f32_bits(0.008));aw_put(b[..],92,f32_bits(-0.999967999488));q=ag_rotation(g[..],c,ag_span(g[..],c,1));#assert !g[0].bad && abs(quat_dot(q,q)-1)<0.00001;
}

#test "glTF baked clip descriptors and all body and face samples retain their packed positions" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;w:[1]AiBuild;out:[65536]u8;scene:[1]AgScene;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],scene[..])=="" && ag_animations(g[..],scene[..],30,out[..],w[..])=="";
 c:=w[0].library[0].clips[0];#assert c.ready && anim_equal(c.name,anim_named("turn")) && anim_equal(c.rig,anim_named("made")) && c.joints[0]==0 && c.joints[1]==1 && c.curves[0]==0 && w[0].at==2344 && w[0].layout.bytes==2344;
 #assert c.body.pack==0 && c.body.offset==484 && c.body.count==62 && c.body.stride==28 && c.body.width==28 && c.face.pack==0 && c.face.offset==2220 && c.face.count==31 && c.face.stride==4 && c.face.width==4;
 for frame:0..<31 {p:=anim_local(out[..],484+frame*56);angle:=cast(f32)frame/30*1.5707963267948966;#assert abs(p.q.y-sin(angle/2))<0.00001 && abs(p.q.w-cos(angle/2))<0.00001 && p.t.x==0 && p.t.y==0 && p.t.z==0;other:=anim_local(out[..],484+frame*56+28);#assert other.q.w==1 && other.t.y==0 && abs(anim_float(out[..],2220+frame*4)-cast(f32)frame/30)<0.000001;}
 id:[1]AssetId;#assert asset_parse("2d7aed266ca68cc36536313bd01373536b54fbf4518c070e2e50f61f13a25e79",id[..]) && asset_same(asset_id(cast(string)out[0..<2344]),id[0]);
 #assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],scene[..])=="" && ag_animations(g[..],scene[..],30,out[0..<2343],w[..])=="output-capacity";
}
#test "glTF spline source tangents bake translations through the complete document path" {
 b:[512]u8;ag_character_bytes(b[..]);for value,k:[18]f32.[0,0,0,1,2,3,2,3,4,0,1,2,5,8,11,0,0,0] {aw_put(b[..],256+k*4,f32_bits(value));}
 a:[8192]u8;z:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"byteOffset\":176,\"byteLength\":32","\"byteOffset\":256,\"byteLength\":72",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"bufferView\":7,\"componentType\":5126,\"count\":2,\"type\":\"VEC4\"","\"bufferView\":7,\"componentType\":5126,\"count\":6,\"type\":\"VEC3\"",z[..]);#assert n>0;n=anim_test_replace(cast(string)z[0..<n],"\"input\":6,\"output\":7","\"input\":6,\"output\":7,\"interpolation\":\"CUBICSPLINE\"",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"path\":\"rotation\"","\"path\":\"translation\"",z[..]);#assert n>0;
 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";
 c:=w[0].library[0].clips[0];p:=anim_local(out[..],c.body.offset+15*56);#assert p.t.x==3.25 && p.t.y==5.25 && p.t.z==7.25 && p.q.w==1;#assert anim_local(out[..],c.body.offset).t.x==1 && anim_local(out[..],c.body.offset+30*56).t.z==11;
}

#test "glTF rest-only clips retain node weights without inheriting a prior library" {
 b:[252]u8;ag_character_bytes(b[..]);text:[8192]u8;prefix:=0;for k:0..<AG_CHARACTER.count-12 {if AG_CHARACTER[k..<k+13]=="\"animations\":" {prefix=k;break;}}#assert prefix>0;o:[1]PnOut;o[0].buf=text[..];pn_put(o[..],AG_CHARACTER[0..<prefix]);pn_put(o[..],"\"animations\":[]}");g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(pn_text(o[..]),b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";w[0].library[0].count=50;#assert ag_animations(g[..],sc[..],30,out[..],w[..])=="" && w[0].library[0].count==1;c:=w[0].library[0].clips[0];#assert c.frames==2 && abs(c.rate-30)<0.00001 && anim_equal(c.name,anim_named("clip-0")) && anim_local(out[..],c.body.offset).q.w==1 && anim_float(out[..],c.face.offset)==0;
}
#test "glTF clip capacity accepts 64 distinct single-channel clips and refuses 65" #steps 200000000 {
 b:[252]u8;ag_character_bytes(b[..]);text:[65536]u8;prefix:=0;for k:0..<AG_CHARACTER.count-12 {if AG_CHARACTER[k..<k+13]=="\"animations\":" {prefix=k;break;}}#assert prefix>0;
 for count:[2]int.[64,65] {o:[1]PnOut;o[0].buf=text[..];pn_put(o[..],AG_CHARACTER[0..<prefix]);pn_put(o[..],"\"animations\":[");for k:0..<count {if k>0 {pn_put(o[..],",");}pn_put(o[..],"{\"name\":\"clip-");pn_putint(o[..],k);pn_put(o[..],"\",\"samplers\":[{\"input\":6,\"output\":7}],\"channels\":[{\"sampler\":0,\"target\":{\"node\":0,\"path\":\"rotation\"}}]}");}pn_put(o[..],"]}");g:[1]AgFile;nodes:[8192]JvNode;w:[1]AiBuild;out:[262144]u8;sc:[1]AgScene;#assert ag_test_open(pn_text(o[..]),b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";e:=ag_animations(g[..],sc[..],30,out[..],w[..]);#assert e==(ifx count==64 then "" else "gltf-clip-limit");if count==64 {#assert w[0].library[0].count==64 && anim_equal(w[0].library[0].clips[63].name,anim_named("clip-63"));}}
}
#test "glTF bracket records select exact endpoints and every preceding interval" {
 b:[64]u8;for v,k:[3]f32.[0,1,2] {aw_put(b[..],k*4,f32_bits(v));}g:=[1]AgFile.[AgFile.{binary=b[..]}];c:=AgChannel.{time=AgAccess.{ok=true,count=3,components=1,component=5126,bytes=4,stride=4,offset=0}};
 s:=ag_span(g[..],c,0);#assert s.a==0 && s.b==0 && s.dt==0 && s.share==0;s=ag_span(g[..],c,2);#assert s.a==2 && s.b==2 && s.dt==0 && s.share==0;s=ag_span(g[..],c,1);#assert s.a==1 && s.b==2 && s.share==0 && s.dt==1;s=ag_span(g[..],c,0.5);#assert s.a==0 && s.b==1 && s.share==0.5 && s.dt==1;
}

#test "glTF clip accepts its exact packed output size without a spare sample" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;w:[1]AiBuild;out:[2344]u8;sc:[1]AgScene;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="" && w[0].at==out.count;
}
