 b:[512]u8;for value,k:[27]f32.[1,2,3,0,0,0,4,5,6,7,8,9,10,20,30,2,3,4,1,2,3,20,40,60,5,6,7] {aw_put(b[..],16+k*4,f32_bits(value));}g:=[1]AgFile.[AgFile.{binary=b[..]}];c:=AgChannel.{mode=2,width=3,data=AgAccess.{ok=true,count=9,components=3,component=5126,bytes=4,stride=12,offset=16}};s:=AgSpan.{a=1,b=2,share=0.5,dt=3};for k:0..<3 {#assert ag_curve(g[..],c,s,k)==[3]f32.[15.375,30.375,45.375][k];}
}

#test "glTF source-time and scale tolerances have representable inclusive endpoints" #steps 200000000 {
 b:[512]u8;ag_character_bytes(b[..]);aw_put(b[..],172,f32_bits(600));g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],1,out[..],w[..])=="" && w[0].library[0].clips[0].frames==601;
 ag_character_bytes(b[..]);for k:0..<18 {aw_put(b[..],256+k*4,f32_bits(ifx (k/3)%3==1 then 1 else 0));}text:[8192]u8;n:=ag_scale_fixture(text[..]);#assert n>0;for index:[3]int.[0,3,6] {initial:=ifx index==3 then 1.0f32 else 0.0f32;aw_put(b[..],256+index*4,f32_bits(initial+0.0000152587890625));#assert ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";aw_put(b[..],256+index*4,f32_bits(initial));}
}

#test "glTF quaternion interpolation indexes later keys and admits its exact normalization floor" {
 b:[128]u8;for v,k:[12]f32.[0,0,0,1,0.5,0.5,0.5,0.5,-0.5,0.5,-0.5,0.5] {aw_put(b[..],k*4,f32_bits(v));}g:=[1]AgFile.[AgFile.{binary=b[..]}];c:=AgChannel.{width=4,data=AgAccess.{ok=true,count=3,components=4,component=5126,bytes=4,stride=16,offset=0}};s:=AgSpan.{a=1,b=2,share=0.5,dt=1};q:=ag_rotation(g[..],c,s);#assert abs(q.x)<0.000001 && abs(q.z)<0.000001 && abs(q.y-0.70710677)<0.000001 && abs(q.w-0.70710677)<0.000001;
 for k:0..<16 {b[k]=0;}aw_put(b[..],0,f32_bits(0.00390625));c.mode=1;s=AgSpan.{};q=ag_rotation(g[..],c,s);#assert !g[0].bad && q.x==1 && q.w==0;
}
