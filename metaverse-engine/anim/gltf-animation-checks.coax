#test "glTF missing clock input refuses even when accessor zero is a valid clock" {
 b:[252]u8;ag_character_bytes(b[..]);source:="{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"byteLength\":252,\"uri\":\"made.bin\"}],\"nodes\":[{\"name\":\"Head\"},{\"name\":\"Character\",\"mesh\":0,\"skin\":0}],\"skins\":[{\"joints\":[0],\"inverseBindMatrices\":5}],\"meshes\":[{\"extras\":{\"targetNames\":[\"jawOpen\"]},\"primitives\":[{\"attributes\":{\"POSITION\":6,\"NORMAL\":1,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[{\"POSITION\":8}]}]}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":72,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":84,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":96,\"byteLength\":6},{\"buffer\":0,\"byteOffset\":104,\"byteLength\":64},{\"buffer\":0,\"byteOffset\":168,\"byteLength\":8},{\"buffer\":0,\"byteOffset\":176,\"byteLength\":32},{\"buffer\":0,\"byteOffset\":208,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":244,\"byteLength\":8}],\"accessors\":[{\"bufferView\":6,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"},{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":2,\"componentType\":5121,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":3,\"componentType\":5121,\"normalized\":true,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":4,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":5,\"componentType\":5126,\"count\":1,\"type\":\"MAT4\"},{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":7,\"componentType\":5126,\"count\":2,\"type\":\"VEC4\"},{\"bufferView\":8,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":9,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"}],\"animations\":[{\"name\":\"turn\",\"samplers\":[{\"input\":0,\"output\":7},{\"input\":0,\"output\":9}],\"channels\":[{\"sampler\":0,\"target\":{\"node\":0,\"path\":\"rotation\"}},{\"sampler\":1,\"target\":{\"node\":1,\"path\":\"weights\"}}]}]}";text:[8192]u8;n:=anim_test_replace(source,"\"input\":0,","",text[..]);#assert n>0;g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="gltf-animation-accessor";
}

#test "glTF first node single-shape default weights survive a rest-only clip" {
 b:[252]u8;ag_character_bytes(b[..]);source:="{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"byteLength\":252,\"uri\":\"made.bin\"}],\"nodes\":[{\"name\":\"Head\",\"mesh\":0,\"skin\":0,\"weights\":[0.75]},{\"name\":\"Character\"}],\"skins\":[{\"joints\":[0],\"inverseBindMatrices\":5}],\"meshes\":[{\"extras\":{\"targetNames\":[\"jawOpen\"]},\"primitives\":[{\"attributes\":{\"POSITION\":0,\"NORMAL\":1,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[{\"POSITION\":8}]}]}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":72,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":84,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":96,\"byteLength\":6},{\"buffer\":0,\"byteOffset\":104,\"byteLength\":64},{\"buffer\":0,\"byteOffset\":168,\"byteLength\":8},{\"buffer\":0,\"byteOffset\":176,\"byteLength\":32},{\"buffer\":0,\"byteOffset\":208,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":244,\"byteLength\":8}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":2,\"componentType\":5121,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":3,\"componentType\":5121,\"normalized\":true,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":4,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":5,\"componentType\":5126,\"count\":1,\"type\":\"MAT4\"},{\"bufferView\":6,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"},{\"bufferView\":7,\"componentType\":5126,\"count\":2,\"type\":\"VEC4\"},{\"bufferView\":8,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":9,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"}],\"animations\":[]}";g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(source,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";c:=w[0].library[0].clips[0];#assert c.curve_count==1 && anim_float(out[..],c.face.offset)==0.75 && anim_float(out[..],c.face.offset+4)==0.75;
}

#test "glTF absent target sampler and output fields cannot borrow the first object" {
 b:[252]u8;ag_character_bytes(b[..]);text:[8192]u8;g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;
 for row:[3]string.["\"node\":0,|gltf-channel-node","\"sampler\":0,|gltf-animation-accessor",",\"output\":7|gltf-animation-accessor"] {split:=0;for c,k:row {if c=='|' {split=k;break;}}n:=anim_test_replace(AG_CHARACTER,row[0..<split],"",text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])==row[split+1..<row.count];}
}
#test "glTF channel capacity diagnoses 2048 duplicate channels separately from overflow" #steps 200000000 {
 b:[252]u8;ag_character_bytes(b[..]);text:[262144]u8;prefix:=0;for k:0..<AG_CHARACTER.count-12 {if AG_CHARACTER[k..<k+13]=="\"animations\":" {prefix=k;break;}}#assert prefix>0;
 for count:[2]int.[2048,2049] {o:[1]PnOut;o[0].buf=text[..];pn_put(o[..],AG_CHARACTER[0..<prefix]);pn_put(o[..],"\"animations\":[{\"samplers\":[{\"input\":6,\"output\":7}],\"channels\":[");for k:0..<count {if k>0 {pn_put(o[..],",");}pn_put(o[..],"{\"sampler\":0,\"target\":{\"node\":0,\"path\":\"rotation\"}}");}pn_put(o[..],"]}]}");g:[1]AgFile;nodes:[32768]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(pn_text(o[..]),b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])==(ifx count==2048 then "gltf-duplicate-channel" else "gltf-channel-limit");}
}

#test "glTF explicitly declared LINEAR is the same mode as its omitted default" {
 b:[252]u8;ag_character_bytes(b[..]);text:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"input\":6,\"output\":7","\"input\":6,\"output\":7,\"interpolation\":\"LINEAR\"",text[..]);#assert n>0;g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";id:[1]AssetId;#assert asset_parse("2d7aed266ca68cc36536313bd01373536b54fbf4518c070e2e50f61f13a25e79",id[..]) && asset_same(asset_id(cast(string)out[0..<w[0].at]),id[0]);
}

#test "glTF animated weights keep later mesh shape offsets and curve offsets independently" {
 b:[512]u8;ag_character_bytes(b[..]);for value,k:[4]f32.[0.1,0.2,0.3,0.4] {aw_put(b[..],256+k*4,f32_bits(value));}source:="{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"byteLength\":252,\"uri\":\"made.bin\"}],\"nodes\":[{\"name\":\"Head\",\"mesh\":0,\"skin\":0},{\"name\":\"Character\",\"mesh\":1,\"skin\":0}],\"skins\":[{\"joints\":[0],\"inverseBindMatrices\":5}],\"meshes\":[{\"extras\":{\"targetNames\":[\"jawOpen\"]},\"primitives\":[{\"attributes\":{\"POSITION\":0,\"NORMAL\":1,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[{\"POSITION\":8}]}]},{\"extras\":{\"targetNames\":[\"eyeBlinkLeft\",\"eyeBlinkRight\"]},\"primitives\":[{\"attributes\":{\"POSITION\":0,\"NORMAL\":1,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[{\"POSITION\":8},{\"POSITION\":8}]}]}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":72,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":84,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":96,\"byteLength\":6},{\"buffer\":0,\"byteOffset\":104,\"byteLength\":64},{\"buffer\":0,\"byteOffset\":168,\"byteLength\":8},{\"buffer\":0,\"byteOffset\":176,\"byteLength\":32},{\"buffer\":0,\"byteOffset\":208,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":256,\"byteLength\":16}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":2,\"componentType\":5121,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":3,\"componentType\":5121,\"normalized\":true,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":4,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":5,\"componentType\":5126,\"count\":1,\"type\":\"MAT4\"},{\"bufferView\":6,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"},{\"bufferView\":7,\"componentType\":5126,\"count\":2,\"type\":\"VEC4\"},{\"bufferView\":8,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":9,\"componentType\":5126,\"count\":4,\"type\":\"SCALAR\"}],\"animations\":[{\"name\":\"turn\",\"samplers\":[{\"input\":6,\"output\":7},{\"input\":6,\"output\":9}],\"channels\":[{\"sampler\":0,\"target\":{\"node\":0,\"path\":\"rotation\"}},{\"sampler\":1,\"target\":{\"node\":1,\"path\":\"weights\"}}]}]}";g:[1]AgFile;nodes:[8192]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(source,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";c:=w[0].library[0].clips[0];#assert c.curve_count==3 && sc[0].shape_first[1]==1 && anim_float(out[..],c.face.offset+15*3*4)==0 && abs(anim_float(out[..],c.face.offset+(15*3+1)*4)-0.2)<0.000001 && abs(anim_float(out[..],c.face.offset+(15*3+2)*4)-0.3)<0.000001;
}
