}

#test "glTF rest clips retain all mesh default weights and node overrides" {
 b:[252]u8;ag_character_bytes(b[..]);base:[8192]u8;prefix:=0;for k:0..<AG_CHARACTER.count-12 {if AG_CHARACTER[k..<k+13]=="\"animations\":" {prefix=k;break;}}o:[1]PnOut;o[0].buf=base[..];pn_put(o[..],AG_CHARACTER[0..<prefix]);pn_put(o[..],"\"animations\":[]}");a:[8192]u8;z:[8192]u8;
 n:=anim_test_replace(pn_text(o[..]),"\"targetNames\":[\"jawOpen\"]","\"targetNames\":[\"jawOpen\",\"eyeBlinkLeft\",\"eyeBlinkRight\"]",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"targets\":[{\"POSITION\":8}]","\"targets\":[{\"POSITION\":8},{\"POSITION\":8},{\"POSITION\":8}]",z[..]);#assert n>0;n=anim_test_replace(cast(string)z[0..<n],"\"extras\":{","\"weights\":[0.2,0.4,0.6],\"extras\":{",a[..]);#assert n>0;
 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";c:=w[0].library[0].clips[0];#assert c.curve_count==3;for k:0..<3 {#assert c.curves[k]==k;for frame:0..<2 {#assert anim_float(out[..],c.face.offset+(frame*3+k)*4)==[3]f32.[0.2,0.4,0.6][k];}}
 m:=anim_test_replace(cast(string)a[0..<n],"\"name\":\"Character\"","\"name\":\"Character\",\"weights\":[0.1,0.3,0.5]",z[..]);#assert m>0 && ag_test_open(cast(string)z[0..<m],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";c=w[0].library[0].clips[0];for k:0..<3 {#assert anim_float(out[..],c.face.offset+k*4)==[3]f32.[0.1,0.3,0.5][k];}
 m=anim_test_replace(cast(string)a[0..<n],"\"name\":\"Character\"","\"name\":\"Character\",\"weights\":[0.1,0.3]",z[..]);#assert m>0 && ag_test_open(cast(string)z[0..<m],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="gltf-default-weights";
}
#test "glTF duration and sample-rate boundaries preserve inclusive supported frame grids" #steps 200000000 {
 b:[252]u8;g:[1]AgFile;nodes:[2048]JvNode;w:[1]AiBuild;out:[262144]u8;sc:[1]AgScene;
 for rate:[2]f32.[1,240] {ag_character_bytes(b[..]);#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],rate,out[..],w[..])=="" && w[0].library[0].clips[0].frames==cast(int)rate+1;}
 for intervals:[2]int.[1999,2000] {ag_character_bytes(b[..]);aw_put(b[..],172,f32_bits(cast(f32)intervals/30));#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";e:=ag_animations(g[..],sc[..],30,out[..],w[..]);#assert e==(ifx intervals==1999 then "" else "gltf-frame-limit");if intervals==1999 {#assert w[0].library[0].clips[0].frames==2000;}}
}

#test "glTF nonaligned duration takes a final exact endpoint and unknown paths keep their reason" {
 b:[252]u8;ag_character_bytes(b[..]);aw_put(b[..],172,f32_bits(1.01));g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";c:=w[0].library[0].clips[0];#assert c.frames==32 && c.length==1.01 && abs(c.rate-31.0f32/1.01)<0.00001 && anim_float(out[..],c.face.offset+31*4)==1;
 text:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"path\":\"rotation\"","\"path\":\"unknown\"",text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="gltf-channel-path";
}
#test "glTF quaternion slerp retains arbitrary nonzero components from both source keys" {
 b:[64]u8;for v,k:[8]f32.[0.5,0.5,0.5,0.5,-0.5,0.5,-0.5,0.5] {aw_put(b[..],k*4,f32_bits(v));}g:=[1]AgFile.[AgFile.{binary=b[..]}];c:=AgChannel.{width=4,data=AgAccess.{ok=true,count=2,components=4,component=5126,bytes=4,stride=16,offset=0}};s:=AgSpan.{a=0,b=1,share=0.5,dt=1};q:=ag_rotation(g[..],c,s);#assert abs(q.x)<0.000001 && abs(q.z)<0.000001 && abs(q.y-0.70710677)<0.000001 && abs(q.w-0.70710677)<0.000001;
}

ag_scale_fixture :: (out:[]u8)->int {
 a:[8192]u8;z:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"byteOffset\":176,\"byteLength\":32","\"byteOffset\":256,\"byteLength\":72",a[..]);if n<1 {return -1;}n=anim_test_replace(cast(string)a[0..<n],"\"bufferView\":7,\"componentType\":5126,\"count\":2,\"type\":\"VEC4\"","\"bufferView\":7,\"componentType\":5126,\"count\":6,\"type\":\"VEC3\"",z[..]);if n<1 {return -1;}n=anim_test_replace(cast(string)z[0..<n],"\"input\":6,\"output\":7","\"input\":6,\"output\":7,\"interpolation\":\"CUBICSPLINE\"",a[..]);if n<1 {return -1;}return anim_test_replace(cast(string)a[0..<n],"\"path\":\"rotation\"","\"path\":\"scale\"",out);
}
#test "glTF scale tracks admit unit values and inspect every cubic tangent independently" {
 b:[512]u8;ag_character_bytes(b[..]);for k:0..<18 {aw_put(b[..],256+k*4,f32_bits(ifx (k/3)%3==1 then 1 else 0));}text:[8192]u8;n:=ag_scale_fixture(text[..]);#assert n>0;g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;
 #assert ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="";
 for index:[12]int.[0,1,2,6,7,8,9,10,11,15,16,17] {aw_put(b[..],256+index*4,f32_bits(0.01));#assert ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="gltf-animated-scale";aw_put(b[..],256+index*4,0);}
 for index:[6]int.[3,4,5,12,13,14] {aw_put(b[..],256+index*4,f32_bits(1.01));#assert ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && ag_animations(g[..],sc[..],30,out[..],w[..])=="gltf-animated-scale";aw_put(b[..],256+index*4,f32_bits(1));}
}
