 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";m:=w[0].library[0].rig[0].meshes[0];for v:0..<3 {#assert anim_float(out[..],m.vertices.offset+v*96+24)==[3]f32.[0.1,0.3,0.5][v] && anim_float(out[..],m.vertices.offset+v*96+28)==[3]f32.[0.2,0.4,0.6][v] && anim_float(out[..],m.vertices.offset+v*96+60)==0 && anim_float(out[..],m.vertices.offset+v*96+64)==1 && anim_float(out[..],m.vertices.offset+v*96+68)==0 && anim_float(out[..],m.vertices.offset+v*96+72)== -1;}
 n=anim_test_replace(AG_CHARACTER,"\"byteOffset\":96,\"byteLength\":6","\"byteOffset\":352,\"byteLength\":12",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"componentType\":5123","\"componentType\":5125",z[..]);#assert n>0 && ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";m=w[0].library[0].rig[0].meshes[0];for k:0..<3 {#assert anim_word(out[..],m.indices.offset+k*4)==cast(u32)k;}
 b[96]=0;b[97]=1;b[98]=2;n=anim_test_replace(AG_CHARACTER,"\"componentType\":5123","\"componentType\":5121",a[..]);#assert n>0 && ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";
}
#test "glTF absent normals and normal-only morphs use the documented defaults" {
 b:[252]u8;ag_character_bytes(b[..]);a:[8192]u8;z:[8192]u8;n:=anim_test_replace(AG_CHARACTER,",\"NORMAL\":1","",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"targets\":[{\"POSITION\":8}]","\"targets\":[{\"NORMAL\":8}]",z[..]);#assert n>0;
 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";r:=w[0].library[0].rig[0];at:=r.meshes[0].vertices.offset;#assert anim_float(out[..],at+12)==0 && anim_float(out[..],at+16)==1 && anim_float(out[..],at+20)==0;at=r.morphs[0].data.offset;#assert anim_float(out[..],at+8)==0 && anim_float(out[..],at+12)==0 && anim_float(out[..],at+16)==0 && anim_float(out[..],at+20)==0 && anim_float(out[..],at+24)== -0.1 && anim_float(out[..],at+28)==0;
}

#test "glTF shared shape and sparse descriptor capacities fail at their own named boundary" #steps 200000000 {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[32768]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;mesh:[32768]u8;text:[65536]u8;
 for shapes:[2]int.[256,257] {o:[1]PnOut;o[0].buf=mesh[..];pn_put(o[..],"\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[");for k:0..<shapes {if k>0 {pn_put(o[..],",");}pn_put(o[..],"{\"POSITION\":8}");}pn_put(o[..],"]}]}],\"unused\":[");n:=anim_test_replace(AG_CHARACTER,"\"meshes\":[",pn_text(o[..]),text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]);e:=ag_scene(g[..],"made",out[..],w[..],sc[..]);#assert e==(ifx shapes==256 then "" else "gltf-shape-limit");if shapes==256 {#assert w[0].library[0].rig[0].shape_count==256 && w[0].library[0].rig[0].morph_count==256 && sc[0].shape_count[1]==256;second:[65536]u8;nn:=anim_test_replace(cast(string)text[0..<n],"\"name\":\"Head\"","\"name\":\"Head\",\"mesh\":0,\"skin\":0",second[..]);#assert nn>0 && ag_test_open(cast(string)second[0..<nn],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="gltf-shape-limit";}}
 o:[1]PnOut;o[0].buf=mesh[..];pn_put(o[..],"\"meshes\":[{\"primitives\":[");for p:0..<3 {if p>0 {pn_put(o[..],",");}pn_put(o[..],"{\"attributes\":{\"POSITION\":0,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[");for k:0..<128 {if k>0 {pn_put(o[..],",");}pn_put(o[..],"{\"POSITION\":8}");}pn_put(o[..],"]}");}pn_put(o[..],"]}],\"unused\":[");n:=anim_test_replace(AG_CHARACTER,"\"meshes\":[",pn_text(o[..]),text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="gltf-morph-limit";
}
#test "glTF shape predicates and optional source vectors preserve exact field contracts" {
 a:=AgAccess.{ok=true,count=3,components=2};#assert ag_shape(a,3,2) && !ag_shape(a,2,2) && !ag_shape(a,3,3);a.ok=false;#assert !ag_shape(a,3,2);
 b:[1]u8;nodes:[128]JvNode;g:[1]AgFile;#assert ag_test_open("{\"v\":[1,2,3],\"bad\":[1,2],\"name\":\":Zz0_\"}",b[0..<0],g[..],nodes[..]);#assert ag_vec(g[..],0,"v",3) && !ag_vec(g[..],0,"bad",3) && ag_vec(g[..],0,"absent",3) && anim_equal(ag_name(g[..],0,"name","",0),anim_named("_Zz0_"));
}

#test "glTF multiple mesh nodes retain separate materials global shapes and source sections" {
 b:[252]u8;ag_character_bytes(b[..]);aw_put(b[..],208,f32_bits(0.25));aw_put(b[..],212,f32_bits(0.5));aw_put(b[..],216,f32_bits(0.75));a:[8192]u8;z:[8192]u8;
 n:=anim_test_replace(AG_CHARACTER,"\"name\":\"Head\"","\"name\":\"Head\",\"mesh\":1,\"skin\":0",a[..]);#assert n>0;
 n=anim_test_replace(cast(string)a[0..<n],"\"meshes\":[","\"materials\":[{\"name\":\"zero\"},{\"name\":\"one\"}],\"meshes\":[{\"extras\":{\"targetNames\":[\"jawOpen\"]},\"primitives\":[{\"attributes\":{\"POSITION\":0,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"material\":1,\"targets\":[{\"POSITION\":8}]}]},{\"extras\":{\"targetNames\":[\"eyeBlinkLeft\"]},\"primitives\":[{\"attributes\":{\"POSITION\":0,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[{\"POSITION\":8}]}]}],\"unused\":[",z[..]);#assert n>0;
 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";r:=w[0].library[0].rig[0];#assert r.sections==2 && r.shape_count==2 && r.morph_count==2 && sc[0].shape_first[0]==0 && sc[0].shape_first[1]==1 && sc[0].shape_count[0]==1 && sc[0].shape_count[1]==1 && r.face_bindings==2 && r.face_map[0].input==0 && r.face_map[1].target==1;
 #assert r.meshes[0].material==0 && r.meshes[1].material==1 && anim_word(out[..],r.meshes[1].vertices.offset+32)==1 && r.morphs[0].shape==0 && r.morphs[1].shape==1 && r.morphs[1].section==1 && r.morphs[0].data.count==2;
 for k:0..<2 {p:=r.morphs[k].data;#assert anim_word(out[..],p.offset)==0 && anim_word(out[..],p.offset+4)==cast(u32)k && anim_float(out[..],p.offset+8)==0.25 && anim_float(out[..],p.offset+12)==0.5 && anim_float(out[..],p.offset+16)==0.75 && anim_word(out[..],p.offset+32)==2;}
}
#test "glTF one-node skins and malformed child ownership have distinct admission results" {
 b:[252]u8;ag_character_bytes(b[..]);a:[8192]u8;g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;
 n:=anim_test_replace(AG_CHARACTER,"{\"name\":\"Head\"},{\"name\":\"Character\",\"mesh\":0,\"skin\":0}","{\"name\":\"Head\",\"mesh\":0,\"skin\":0}",a[..]);#assert n>0 && ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"one",out[..],w[..],sc[..])=="" && w[0].library[0].rig[0].joints==1;
 n=anim_test_replace(AG_CHARACTER,"\"name\":\"Head\"","\"name\":\"Head\",\"children\":[2]",a[..]);#assert n>0 && ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"bad",out[..],w[..],sc[..])=="gltf-hierarchy";
 n=anim_test_replace(AG_CHARACTER,"\"name\":\"Character\"","\"name\":\"Character\",\"children\":[0]",a[..]);#assert n>0;z:[8192]u8;n=anim_test_replace(cast(string)a[0..<n],"\"name\":\"Head\"","\"name\":\"Head\",\"children\":[1]",z[..]);#assert n>0 && ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"cycle",out[..],w[..],sc[..])=="gltf-hierarchy";
}

#test "glTF full skin joint table and primitive table preserve inclusive capacities" #steps 200000000 {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[16384]JvNode;w:[1]AiBuild;out:[262144]u8;sc:[1]AgScene;a:[65536]u8;z:[65536]u8;insert:[32768]u8;
 o:[1]PnOut;o[0].buf=insert[..];pn_put(o[..],"\"nodes\":[");for k:2..<512 {pn_put(o[..],"{\"name\":\"j-");pn_putint(o[..],k);pn_put(o[..],"\"},");}n:=anim_test_replace(AG_CHARACTER,"\"nodes\":[",pn_text(o[..]),a[..]);#assert n>0;
 for count:[2]int.[512,513] {o[0]=PnOut.{buf=insert[..]};pn_put(o[..],"\"joints\":[");for k:0..<count {if k>0 {pn_put(o[..],",");}pn_putint(o[..],k);}pn_put(o[..],"]");m:=anim_test_replace(cast(string)a[0..<n],"\"joints\":[0],\"inverseBindMatrices\":5",pn_text(o[..]),z[..]);#assert m>0 && ag_test_open(cast(string)z[0..<m],b[..],g[..],nodes[..]);e:=ag_scene(g[..],"full",out[..],w[..],sc[..]);#assert e==(ifx count==512 then "" else "gltf-skin-joints");if count==512 {#assert sc[0].skin_count==512 && sc[0].skin_joint[511]==511;}}
 for count:[2]int.[64,65] {o[0]=PnOut.{buf=insert[..]};pn_put(o[..],"\"meshes\":[{\"extras\":{\"targetNames\":[\"jawOpen\"]},\"primitives\":[");for k:0..<count {if k>0 {pn_put(o[..],",");}pn_put(o[..],"{\"attributes\":{\"POSITION\":0,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[{\"POSITION\":8}]}");}pn_put(o[..],"]}],\"unused\":[");n=anim_test_replace(AG_CHARACTER,"\"meshes\":[",pn_text(o[..]),a[..]);#assert n>0 && ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]);e:=ag_scene(g[..],"sections",out[..],w[..],sc[..]);#assert e==(ifx count==64 then "" else "gltf-primitive-limit");if count==64 {#assert w[0].library[0].rig[0].sections==64 && w[0].library[0].rig[0].morphs[63].section==63;m:=anim_test_replace(cast(string)a[0..<n],"\"name\":\"Head\"","\"name\":\"Head\",\"mesh\":0,\"skin\":0",z[..]);#assert m>0 && ag_test_open(cast(string)z[0..<m],b[..],g[..],nodes[..]) && ag_scene(g[..],"sections",out[..],w[..],sc[..])=="gltf-primitive-limit";}}
}

#test "glTF all-zero source morphs allocate no sparse rows and permit exact geometry capacity" {
 b:[252]u8;ag_character_bytes(b[..]);for k:208..<244 {b[k]=0;}g:[1]AgFile;nodes:[2048]JvNode;w:[1]AiBuild;out:[452]u8;sc:[1]AgScene;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && w[0].at==452 && w[0].library[0].rig[0].morph_count==0 && w[0].library[0].rig[0].shape_count==1;
}

#test "glTF wrong material shape and geometry declarations have named refusals" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;text:[8192]u8;
 for row:[14]string.["\"meshes\":[|\"materials\":[{\"name\":\"\"}],\"meshes\":[|gltf-material-name","\"meshes\":[|\"materials\":[{\"name\":\"a\"},{\"name\":\"a\"}],\"meshes\":[|gltf-material-name","\"targetNames\":[\"jawOpen\"]|\"targetNames\":[\"bad name\"]|gltf-shape-name","\"targetNames\":[\"jawOpen\"]|\"targetNames\":[\"\"]|gltf-shape-name","\"targetNames\":[\"jawOpen\"]|\"targetNames\":[false]|gltf-shape-name","\"POSITION\":0|\"POSITION\":-1|gltf-geometry-accessor","\"POSITION\":0|\"POSITION\":4|gltf-geometry-accessor","\"indices\":4|\"indices\":-1|gltf-geometry-accessor","\"indices\":4|\"indices\":5|gltf-geometry-accessor","\"mesh\":0|\"mesh\":-1|gltf-primitive-limit","\"targets\":[{\"POSITION\":8}]|\"targets\":[{\"NORMAL\":4}]|gltf-morph-accessor","\"skins\":[|\"skins\":[],\"unused\":[|gltf-skin-count","\"meshes\":[|\"meshes\":[],\"unused\":[|gltf-primitive-limit","\"primitives\":[|\"primitives\":[],\"unused\":[|gltf-primitive-limit"] {a:= -1;z:= -1;for c,k:row {if c=='|' {if a<0 {a=k;}else {z=k;}}}n:=anim_test_replace(AG_CHARACTER,row[0..<a],row[a+1..<z],text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]);#assert ag_scene(g[..],"made",out[..],w[..],sc[..])==row[z+1..<row.count];}
 #assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"bad name",out[..],w[..],sc[..])=="rig-name";
}

#test "glTF float skin weights and 16-bit joints are accepted without integer normalization" {
 b:[512]u8;ag_character_bytes(b[..]);for v:0..<3 {for k:0..<4 {b[256+v*8+k*2]=0;aw_put(b[..],280+v*16+k*4,f32_bits(ifx k==0 then 1 else 0));}}
 a:[8192]u8;z:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"byteOffset\":72,\"byteLength\":12","\"byteOffset\":256,\"byteLength\":24",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"bufferView\":2,\"componentType\":5121","\"bufferView\":2,\"componentType\":5123",z[..]);#assert n>0;n=anim_test_replace(cast(string)z[0..<n],"\"byteOffset\":84,\"byteLength\":12","\"byteOffset\":280,\"byteLength\":48",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"bufferView\":3,\"componentType\":5121,\"normalized\":true","\"bufferView\":3,\"componentType\":5126",z[..]);#assert n>0;
 g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"float-skin",out[..],w[..],sc[..])=="";#assert out[w[0].library[0].rig[0].meshes[0].vertices.offset+52]==255;
 m:=anim_test_replace(cast(string)z[0..<n],"\"componentType\":5126,\"count\":3,\"type\":\"VEC4\"","\"componentType\":5121,\"count\":3,\"type\":\"VEC4\"",a[..]);#assert m>0 && ag_test_open(cast(string)a[0..<m],b[..],g[..],nodes[..]) && ag_scene(g[..],"bad",out[..],w[..],sc[..])=="gltf-skin-accessor";
}

