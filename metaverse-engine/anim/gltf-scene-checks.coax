#test "glTF one-character names and source parent zero retain their identities" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;a:[8192]u8;z:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"name\":\"Head\"","\"name\":\"A\",\"children\":[1]",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"meshes\":[","\"materials\":[{\"name\":\"B\"}],\"meshes\":[",z[..]);#assert n>0;n=anim_test_replace(cast(string)z[0..<n],"\"targetNames\":[\"jawOpen\"]","\"targetNames\":[\"C\"]",a[..]);#assert n>0 && ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"D",out[..],w[..],sc[..])=="";r:=w[0].library[0].rig[0];#assert r.names[0].n==1 && r.materials[0].n==1 && r.shapes[0].n==1 && r.parents[1]==0 && r.face_bindings==0;
}

#test "glTF skin normalization divides by the source sum rather than assuming unit input" {
 b:[64]u8;out:[96]u8;for k:0..<8 {b[k*2]=cast(u8)k;aw_put(b[..],16+k*4,f32_bits(0.5));}g:=[1]AgFile.[AgFile.{binary=b[..]}];sc:[1]AgScene;sc[0].skin_count=8;for k:0..<8 {sc[0].skin_joint[k]=k;}joints:[2]AgAccess;weights:[2]AgAccess;for k:0..<2 {joints[k]=AgAccess.{ok=true,count=1,components=4,component=5123,bytes=2,stride=8,offset=k*8};weights[k]=AgAccess.{ok=true,count=1,components=4,component=5126,bytes=4,stride=16,offset=16+k*16};}
 #assert ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);for k:0..<8 {#assert cast(int)out[52+k]==(ifx k<7 then 32 else 31);}
}
#test "glTF replacement clears scene scratch shape metadata before publishing a new rig" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;sc[0].shape_count[0]=255;sc[0].shape_first[0]=7;sc[0].skin_joint[5]=100;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && sc[0].shape_count[0]==0 && sc[0].shape_first[0]==0 && sc[0].skin_joint[5]==0;
}

#test "glTF generated shape labels ignore unrelated root metadata and reject duplicates" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;a:[8192]u8;z:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"asset\":{","\"name\":\"unrelated\",\"asset\":{",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"extras\":{\"targetNames\":[\"jawOpen\"]},","",z[..]);#assert n>0 && ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="" && anim_equal(w[0].library[0].rig[0].shapes[0],anim_named("shape-0"));
 n=anim_test_replace(AG_CHARACTER,"\"targetNames\":[\"jawOpen\"]","\"targetNames\":[\"a\",\"a\"]",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"targets\":[{\"POSITION\":8}]","\"targets\":[{\"POSITION\":8},{\"POSITION\":8}]",z[..]);#assert n>0 && ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="gltf-shape-name";
}
#test "glTF final geometry admission refuses either an empty scene or a nonfinite sparse delta" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;text:[8192]u8;n:=anim_test_replace(AG_CHARACTER,",\"mesh\":0","",text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="gltf-geometry";
 aw_put(b[..],208,0x7f800000);#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="gltf-geometry";
}
#test "glTF positions and morph deltas require float components even with valid integer vectors" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;text:[8192]u8;
 for accessor:[2]int.[0,8] {needle:[128]u8;replacement:[128]u8;a:[1]PnOut;z:[1]PnOut;a[0].buf=needle[..];z[0].buf=replacement[..];pn_put(a[..],"\"bufferView\":");pn_putint(a[..],accessor);pn_put(a[..],",\"componentType\":5126");pn_put(z[..],"\"bufferView\":");pn_putint(z[..],accessor);pn_put(z[..],",\"componentType\":5122,\"normalized\":true");n:=anim_test_replace(AG_CHARACTER,pn_text(a[..]),pn_text(z[..]),text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])==(ifx accessor==0 then "gltf-geometry-accessor" else "gltf-morph-accessor");}
}

#test "glTF first scale axis missing attributes and float-vector geometry fail independently" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;text:[8192]u8;
 for row:[4]string.["\"name\":\"Head\"|\"name\":\"Head\",\"scale\":[2,1,1]|gltf-nonunit-scale","\"POSITION\":0,||gltf-geometry-accessor",",\"skin\":0||gltf-mesh-skin","\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"|\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC2\"|gltf-geometry-accessor"] {a:= -1;z:= -1;for c,k:row {if c=='|' {if a<0 {a=k;}else {z=k;}}}n:=anim_test_replace(AG_CHARACTER,row[0..<a],row[a+1..<z],text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])==row[z+1..<row.count];}
 for k:0..<16 {aw_put(b[..],104+k*4,ifx k%5==0 then 1 else 0);}n:=anim_test_replace(AG_CHARACTER,"\"bufferView\":5,\"componentType\":5126","\"bufferView\":5,\"componentType\":5125",text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="gltf-inverse-bind";
}

#test "glTF invalid child indices on later parents cannot default to source node zero" {
 b:[252]u8;ag_character_bytes(b[..]);text:[8192]u8;n:=anim_test_replace(AG_CHARACTER,"\"name\":\"Character\"","\"name\":\"Character\",\"children\":[\"not-an-index\"]",text[..]);#assert n>0;g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;#assert ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="gltf-hierarchy";
}
