 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[8192]JvNode;w:[1]AiBuild;out:[262144]u8;sc:[1]AgScene;insert:[32768]u8;text:[65536]u8;
 for count:[2]int.[512,513] {o:[1]PnOut;o[0].buf=insert[..];pn_put(o[..],"\"nodes\":[");for k:2..<count {pn_put(o[..],"{\"name\":\"node-");pn_putint(o[..],k);pn_put(o[..],"\"},");}n:=anim_test_replace(AG_CHARACTER,"\"nodes\":[",pn_text(o[..]),text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]);e:=ag_scene(g[..],"made",out[..],w[..],sc[..]);#assert e==(ifx count==512 then "" else "gltf-skin-count");if count==512 {#assert w[0].library[0].rig[0].joints==512;}}
 for count:[2]int.[64,65] {o:[1]PnOut;o[0].buf=insert[..];pn_put(o[..],"\"materials\":[");for k:0..<count {if k>0 {pn_put(o[..],",");}pn_put(o[..],"{}");}pn_put(o[..],"],\"meshes\":[");n:=anim_test_replace(AG_CHARACTER,"\"meshes\":[",pn_text(o[..]),text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]);e:=ag_scene(g[..],"made",out[..],w[..],sc[..]);#assert e==(ifx count==64 then "" else "gltf-material-limit");}
}

