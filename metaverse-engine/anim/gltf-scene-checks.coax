AG_CHARACTER :: "{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"byteLength\":252,\"uri\":\"made.bin\"}],\"nodes\":[{\"name\":\"Head\"},{\"name\":\"Character\",\"mesh\":0,\"skin\":0}],\"skins\":[{\"joints\":[0],\"inverseBindMatrices\":5}],\"meshes\":[{\"extras\":{\"targetNames\":[\"jawOpen\"]},\"primitives\":[{\"attributes\":{\"POSITION\":0,\"NORMAL\":1,\"JOINTS_0\":2,\"WEIGHTS_0\":3},\"indices\":4,\"targets\":[{\"POSITION\":8}]}]}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":72,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":84,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":96,\"byteLength\":6},{\"buffer\":0,\"byteOffset\":104,\"byteLength\":64},{\"buffer\":0,\"byteOffset\":168,\"byteLength\":8},{\"buffer\":0,\"byteOffset\":176,\"byteLength\":32},{\"buffer\":0,\"byteOffset\":208,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":244,\"byteLength\":8}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":2,\"componentType\":5121,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":3,\"componentType\":5121,\"normalized\":true,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":4,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":5,\"componentType\":5126,\"count\":1,\"type\":\"MAT4\"},{\"bufferView\":6,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"},{\"bufferView\":7,\"componentType\":5126,\"count\":2,\"type\":\"VEC4\"},{\"bufferView\":8,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":9,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"}],\"animations\":[{\"name\":\"turn\",\"samplers\":[{\"input\":6,\"output\":7},{\"input\":6,\"output\":9}],\"channels\":[{\"sampler\":0,\"target\":{\"node\":0,\"path\":\"rotation\"}},{\"sampler\":1,\"target\":{\"node\":1,\"path\":\"weights\"}}]}]}";
ag_character_bytes :: (b:[]u8) {
 for k:0..<252 {b[k]=0;}for value,k:[9]f32.[-0.2,1,0,0.2,1,0,0,1.4,0] {aw_put(b,k*4,f32_bits(value));}for k:0..<3 {aw_put(b,36+k*12+8,f32_bits(1));b[84+k*4]=255;b[96+k*2]=cast(u8)k;}for k:0..<4 {aw_put(b,104+(k*4+k)*4,f32_bits(1));}aw_put(b,172,f32_bits(1));aw_put(b,188,f32_bits(1));aw_put(b,196,f32_bits(0.70710677));aw_put(b,204,f32_bits(0.70710677));aw_put(b,236,f32_bits(-0.1));aw_put(b,248,f32_bits(1));
}
#test "glTF character imports its skin mesh inverse binds shapes and named face map" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]);w:[1]AiBuild;out:[65536]u8;scene:[1]AgScene;#assert ag_scene(g[..],"made",out[..],w[..],scene[..])=="";
 r:=w[0].library[0].rig[0];#assert r.joints==2 && r.parents[0]== -1 && r.mapped[0]==6 && r.names[1].n==9 && r.bind[0]==1 && r.sections==1 && r.material_count==1 && r.shape_count==1 && r.face_bindings==1 && r.face_map[0].input==17;
 mesh:=r.meshes[0];#assert mesh.vertices.count==3 && mesh.indices.count==3 && anim_float(out[..],mesh.vertices.offset)== -0.2 && out[mesh.vertices.offset+52]==255 && anim_word(out[..],mesh.indices.offset+8)==2;
 #assert r.morph_count==1 && r.morphs[0].data.count==1 && anim_word(out[..],r.morphs[0].data.offset)==2 && anim_float(out[..],r.morphs[0].data.offset+12)== -0.1;
}
#test "glTF scene rejects incompatible transforms hierarchy skin and mesh before publication" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;w:[1]AiBuild;out:[65536]u8;scene:[1]AgScene;text:[8192]u8;
 for row:[9]string.["2.0|1.0","\"name\":\"Head\"|\"name\":\"Head\",\"scale\":[2,2,2]","\"name\":\"Head\"|\"name\":\"Head\",\"children\":[0]","\"joints\":[0]|\"joints\":[2]","\"skin\":0|\"skin\":1","\"indices\":4|\"indices\":4,\"mode\":1","\"POSITION\":0|\"POSITION\":99","\"name\":\"Character\"|\"name\":\"Head\"","\"version\":\"2.0\"|\"version\":\"2.0\"},\"extensionsRequired\":[\"KHR_draco_mesh_compression\"],\"unused\":{"] {split:=0;for c,k:row {if c=='|' {split=k;break;}}n:=anim_test_replace(AG_CHARACTER,row[0..<split],row[split+1..<row.count],text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],scene[..])!="";}
 #assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[0..<16],w[..],scene[..])=="output-capacity";
 b[72]=1;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],scene[..])=="gltf-skin-weights";
}

#test "glTF made geometry matches an independent packed-format byte oracle" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[2048]JvNode;#assert ag_test_open(AG_CHARACTER,b[..],g[..],nodes[..]);w:[1]AiBuild;out:[65536]u8;for k:0..<out.count {out[k]=255;}scene:[1]AgScene;#assert ag_scene(g[..],"made",out[..],w[..],scene[..])=="" && w[0].at==484 && w[0].layout.bytes==484;id:[1]AssetId;#assert asset_parse("bf4ce9c1d3deecbafd48fc8c41f545b65fb3cbdaf0a1e33503d1440f36c957c4",id[..]) && asset_same(asset_id(cast(string)out[0..<484]),id[0]);
 r:=w[0].library[0].rig[0];#assert scene[0].nodes==2 && scene[0].node_joint[0]==0 && scene[0].node_joint[1]==1 && scene[0].skin_count==1 && scene[0].skin_joint[0]==0 && scene[0].shape_first[1]==0 && scene[0].shape_count[1]==1 && r.ready && anim_equal(r.name,anim_named("made")) && r.parents[1]== -1 && r.mapped[1]== -1;
 p:=w[0].layout;#assert p.rest.pack==0 && p.rest.offset==0 && p.rest.count==2 && p.rest.stride==28 && p.rest.width==28 && p.bind.pack==0 && p.bind.offset==56 && p.bind.count==2 && p.bind.stride==48 && p.bind.width==48;
 m:=r.meshes[0];#assert m.material==0 && m.vertices.pack==0 && m.vertices.offset==152 && m.vertices.count==3 && m.vertices.stride==96 && m.vertices.width==96 && m.indices.pack==0 && m.indices.offset==440 && m.indices.stride==4 && m.indices.width==4;
 d:=r.morphs[0];#assert d.shape==0 && d.section==0 && d.data.pack==0 && d.data.offset==452 && d.data.stride==32 && d.data.width==32 && r.face_map[0].target==0 && !r.face_map[0].control && r.face_map[0].weight==1;
}

#test "glTF source names sanitize only unsupported bytes and bound every generated label" {
 text:[4096]u8;nodes:[128]JvNode;g:[1]AgFile;#assert ag_test_open("{\"name\":\"A b:c/9._-\",\"wrong\":7,\"empty\":\"\"}",text[0..<0],g[..],nodes[..]);
 #assert anim_equal(ag_name(g[..],0,"name","unused",0),anim_named("A_b_c_9._-")) && ag_name(g[..],0,"wrong","unused",0).n==0 && ag_name(g[..],0,"empty","unused",0).n==0 && anim_equal(ag_name(g[..],0,"missing","joint-",123),anim_named("joint-123"));
 for n:[2]int.[64,65] {o:[1]PnOut;o[0].buf=text[..];pn_put(o[..],"{\"name\":\"");for k:0..<n {pn_put(o[..],"a");}pn_put(o[..],"\"}");#assert ag_test_open(pn_text(o[..]),text[0..<0],g[..],nodes[..]);#assert ag_name(g[..],0,"name","",0).n==(ifx n==64 then 64 else 0);}
}
#test "glTF scene names every rejected hierarchy transform material mesh and shape condition" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;scene:[1]AgScene;text:[8192]u8;
 for row:[29]string.[
 "\"name\":\"Head\"|\"name\":\"Head\",\"children\":false|gltf-hierarchy",
 "\"name\":\"Head\"|\"name\":\"Head\",\"children\":[1,1]|gltf-hierarchy",
 "\"name\":\"Head\"|\"name\":\"Head\",\"children\":[-1]|gltf-hierarchy",
 "\"name\":\"Head\"|\"name\":\"Head\",\"children\":[1]|",
 "\"name\":\"Head\"|\"name\":\"Head\",\"translation\":[1,2]|gltf-node-transform",
 "\"name\":\"Head\"|\"name\":\"Head\",\"rotation\":[0,0,0,0]|gltf-node-rotation",
 "\"name\":\"Head\"|\"name\":\"Head\",\"matrix\":[]|gltf-node-transform",
 "\"joints\":[0]|\"joints\":[]|gltf-skin-joints",
 "\"joints\":[0]|\"joints\":[0,0]|gltf-skin-joints",
 "\"inverseBindMatrices\":5|\"inverseBindMatrices\":0|gltf-inverse-bind",
 "\"inverseBindMatrices\":5|\"inverseBindMatrices\":-1|gltf-inverse-bind",
 "\"skin\":0|\"skin\":-1|gltf-mesh-skin",
 "\"indices\":4|\"indices\":4,\"material\":1|gltf-material-index",
 "\"indices\":4|\"indices\":4,\"material\":-1|gltf-material-index",
 "\"indices\":4|\"indices\":4,\"extensions\":{}|gltf-primitive-mode",
 "\"indices\":4|\"indices\":0|gltf-geometry-accessor",
 "\"NORMAL\":1|\"NORMAL\":4|gltf-vertex-accessor",
 "\"NORMAL\":1|\"TEXCOORD_0\":1|gltf-vertex-accessor",
 "\"NORMAL\":1|\"TANGENT\":1|gltf-vertex-accessor",
 "\"JOINTS_0\":2|\"JOINTS_0\":3|gltf-skin-accessor",
 "\"JOINTS_0\":2|\"JOINTS_0\":4|gltf-skin-accessor",
 "\"WEIGHTS_0\":3|\"WEIGHTS_0\":4|gltf-skin-accessor",
 "\"WEIGHTS_0\":3|\"WEIGHTS_0\":3,\"JOINTS_1\":-1|gltf-skin-accessor",
 "\"WEIGHTS_0\":3|\"WEIGHTS_0\":3,\"WEIGHTS_1\":-1|gltf-skin-accessor",
 "\"WEIGHTS_0\":3|\"WEIGHTS_0\":3,\"JOINTS_2\":2|gltf-influence-limit",
 "\"WEIGHTS_0\":3|\"WEIGHTS_0\":3,\"WEIGHTS_2\":3|gltf-influence-limit",
 "\"targetNames\":[\"jawOpen\"]|\"targetNames\":[]|gltf-shape-names",
 "\"targets\":[{\"POSITION\":8}]|\"targets\":[{\"POSITION\":4}]|gltf-morph-accessor",
 "\"targets\":[{\"POSITION\":8}]|\"targets\":[{\"POSITION\":8,\"TANGENT\":8}]|gltf-morph-tangent"
 ] {a:= -1;z:= -1;for c,k:row {if c=='|' {if a<0 {a=k;}else {z=k;}}}n:=anim_test_replace(AG_CHARACTER,row[0..<a],row[a+1..<z],text[..]);#assert n>0 && ag_test_open(cast(string)text[0..<n],b[..],g[..],nodes[..]);e:=ag_scene(g[..],"made",out[..],w[..],scene[..]);if row[z+1..<row.count]=="" {#assert e=="";}else {#assert e==row[z+1..<row.count];}}
}

#test "glTF eight influences normalize by largest remainder and retain all 16-bit joint IDs" {
 b:[64]u8;out:[96]u8;for k:0..<8 {b[k*2]=cast(u8)k;aw_put(b[..],16+k*4,f32_bits([8]f32.[0.05,0.1,0.15,0.2,0.1,0.1,0.1,0.2][k]));}
 g:=[1]AgFile.[AgFile.{binary=b[..]}];sc:[1]AgScene;sc[0].skin_count=8;for k:0..<8 {sc[0].skin_joint[k]=407-k;}
 joints:[2]AgAccess;weights:[2]AgAccess;for k:0..<2 {joints[k]=AgAccess.{ok=true,count=1,components=4,component=5123,bytes=2,stride=8,offset=k*8};weights[k]=AgAccess.{ok=true,count=1,components=4,component=5126,bytes=4,stride=16,offset=16+k*16};}
 #assert ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);sum:=0;for k:0..<8 {#assert cast(int)out[36+k*2]+cast(int)out[37+k*2]*256==407-k && out[52+k]==[8]u8.[13,26,38,51,26,25,25,51][k];sum+=cast(int)out[52+k];}#assert sum==255;
 b[14]=8;#assert !ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);b[14]=7;
 b[14]=0;#assert !ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);aw_put(b[..],16,0);#assert ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);b[14]=7;
 for value:[2]f32.[-0.1,1.1] {aw_put(b[..],44,f32_bits(value));#assert !ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);}
 for k:0..<8 {aw_put(b[..],16+k*4,0);}#assert !ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);
 aw_put(b[..],16,f32_bits(1));joints[1].ok=false;#assert ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0) && out[52]==255 && out[56]==0;g[0].bad=true;#assert !ag_skin_vertex(g[..],sc[..],joints[..],weights[..],0,out[..],0);
}

#test "glTF hierarchy reorders forward parents and retains nonidentity local transforms" {
 b:[252]u8;ag_character_bytes(b[..]);g:[1]AgFile;nodes:[4096]JvNode;w:[1]AiBuild;out:[65536]u8;sc:[1]AgScene;a:[8192]u8;z:[8192]u8;
 n:=anim_test_replace(AG_CHARACTER,"\"name\":\"Character\"","\"name\":\"Character\",\"children\":[0]",a[..]);#assert n>0;n=anim_test_replace(cast(string)a[0..<n],"\"name\":\"Head\"","\"name\":\"Head\",\"translation\":[1,2,3],\"rotation\":[0,0,1,0],\"scale\":[1,1,1]",z[..]);#assert n>0 && ag_test_open(cast(string)z[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";
 r:=w[0].library[0].rig[0];#assert r.parents[0]== -1 && r.parents[1]==0 && sc[0].node_joint[0]==1 && sc[0].node_joint[1]==0 && sc[0].skin_joint[0]==1 && r.rest[1].t.x==1 && r.rest[1].t.y==2 && r.rest[1].t.z==3 && r.rest[1].q.z==1 && r.rest[1].q.w==0 && anim_local(out[..],28).t.z==3;
 #assert r.bind[12]==1 && r.bind[17]==1 && r.bind[22]==1;
 n=anim_test_replace(cast(string)z[0..<n],",\"inverseBindMatrices\":5","",a[..]);#assert n>0 && ag_test_open(cast(string)a[0..<n],b[..],g[..],nodes[..]) && ag_scene(g[..],"made",out[..],w[..],sc[..])=="";r=w[0].library[0].rig[0];#assert r.bind[12]== -1 && r.bind[17]== -1 && r.bind[15]==1 && r.bind[19]==2 && r.bind[23]== -3;
}
