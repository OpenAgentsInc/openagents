AP_TEST :: "{\"schema\":\"anim.performance.v1\",\"name\":\"made-performance\",\"rig\":\"made-rig\",\"length\":4,\"layers\":[{\"kind\":\"base\",\"clip\":\"made-wave\",\"start\":0,\"end\":4,\"speed\":1,\"blend_in\":0,\"blend_out\":0.4,\"weight\":1,\"mask\":\"all\"},{\"kind\":\"fix-up\",\"solver\":\"look-at\",\"joint\":\"Head\",\"target\":[1,2,3],\"start\":1,\"end\":3,\"speed\":1,\"blend_in\":0.2,\"blend_out\":0.2,\"weight\":0.7,\"mask\":\"head\"}]}";
#test "animation performances resolve clips masks and late fix-ups without retaining JSON" {
 rigs:[1]AnimRig;rigs[0].ready=true;rigs[0].name=anim_named("made-rig");rigs[0].joints=1;rigs[0].names[0]=anim_named("Head");
 clips:=[1]AnimClip.[AnimClip.{ready=true,name=anim_named("made-wave"),rig=anim_named("made-rig"),length=0.5}];p:[1]AnimPerformance;
 #assert anim_performance_load(AP_TEST,rigs[..],clips[..],p[..])==0 && p[0].ready && p[0].count==2 && p[0].layers[0].clip==0 && p[0].layers[1].solver==1 && p[0].layers[1].joint==0 && p[0].layers[1].target.z==3;
 #assert p[0].layers[1].weight==0.7 && p[0].layers[0].blend_out==0.4 && anim_mask("arm_r")==5 && anim_mask("hands")==6 && anim_mask("legs")==7;
 changed:[4096]u8;from:=[5]string.["made-wave","\"mask\":\"head\"","\"speed\":1","\"weight\":0.7","\"end\":3"];to:=[5]string.["missing","\"mask\":\"tail\"","\"speed\":0","\"weight\":1.1","\"end\":5"];
 for k:0..<5 {n:=anim_test_replace(AP_TEST,from[k],to[k],changed[..]);#assert n>0 && anim_performance_load(cast(string)changed[0..<n],rigs[..],clips[..],p[..])!=0 && p[0].count==2;}
}
anim_test_performance_context :: (rigs:[]AnimRig,clips:[]AnimClip) {
 rigs[0].ready=true;rigs[0].name=anim_named("made-rig");rigs[0].joints=1;rigs[0].names[0]=anim_named("Head");clips[0]=AnimClip.{ready=true,name=anim_named("made-wave"),rig=anim_named("made-rig"),length=4};
}
#test "animation performances preserve every layer value and refuse unsupported combinations" #steps 100000000 {
 r:[1]AnimRig;c:[1]AnimClip;anim_test_performance_context(r[..],c[..]);p:[1]AnimPerformance;
 #assert anim_performance_load(AP_TEST,r[..],c[..],p[..])==ANIM_OK && anim_equal(p[0].name,anim_named("made-performance")) && anim_equal(p[0].rig,r[0].name) && p[0].length==4;
 a:=p[0].layers[0];b:=p[0].layers[1];#assert a.kind==0 && a.clip==0 && a.start==0 && a.end==4 && a.speed==1 && a.blend_in==0 && a.blend_out==0.4 && a.weight==1 && a.mask==0 && a.solver== -1 && a.joint== -1;
 #assert b.kind==4 && b.clip== -1 && b.start==1 && b.end==3 && b.speed==1 && b.blend_in==0.2 && b.blend_out==0.2 && b.weight==0.7 && b.mask==2 && b.solver==1 && b.joint==0 && b.target.x==1 && b.target.y==2 && b.target.z==3;
 #assert anim_mask("all")==0 && anim_mask("face")==1 && anim_mask("head")==2 && anim_mask("upper")==3 && anim_mask("arm_l")==4 && anim_mask("missing")== -1;
 from:=[26]string.["\"schema\":\"anim.performance.v1\"","\"name\":\"made-performance\"","\"rig\":\"made-rig\"","\"length\":4","\"kind\":\"base\"","\"kind\":\"base\"","\"mask\":\"all\"","\"start\":0","\"end\":4","\"speed\":1","\"weight\":1","\"blend_out\":0.4","\"blend_out\":0.4","\"kind\":\"fix-up\"","\"solver\":\"look-at\"","\"joint\":\"Head\"","\"target\":[1,2,3]","\"target\":[1,2,3]","\"kind\":\"base\"","\"kind\":\"fix-up\"","\"kind\":\"base\"","\"kind\":\"base\"","\"kind\":\"base\"","\"blend_in\":0.2","\"blend_out\":0.2","\"start\":1"];
 to:=[26]string.["\"schema\":\"anim.performance.v1\",\"extra\":0","\"name\":\"\"","\"rig\":\"missing\"","\"length\":0","\"kind\":\"unknown\"","\"kind\":0","\"mask\":\"head\"","\"start\":-1","\"end\":0","\"speed\":0","\"weight\":2","\"blend_out\":-0.1","\"blend_out\":5","\"kind\":\"fix-up\",\"clip\":\"made-wave\"","\"solver\":\"missing\"","\"joint\":\"root\"","\"target\":[1,2]","\"target\":[1,2,1000001]","\"kind\":\"base\",\"solver\":\"reach\"","\"kind\":\"override\",\"clip\":\"made-wave\"","\"kind\":\"base\",\"target\":[0,0,0]","\"kind\":\"base\",\"joint\":\"Head\"","\"kind\":\"base\",\"extra\":0","\"blend_in\":-0.1","\"blend_out\":3","\"start\":3"];
 errors:=[26]int.[2,4,8,5,4,4,2,5,5,5,5,5,5,2,8,8,5,5,2,2,2,2,2,5,5,5];changed:[8192]u8;
 for k:0..<26 {n:=anim_test_replace(AP_TEST,from[k],to[k],changed[..]);#assert n>0 && anim_performance_load(cast(string)changed[0..<n],r[..],c[..],p[..])==errors[k];}
 #assert anim_performance_load("{}",r[..],c[..],p[..])==ANIM_SCHEMA && anim_performance_load("[]",r[..],c[..],p[..])==ANIM_JSON && anim_performance_load(AP_TEST,r[..],c[..],p[0..<0])==ANIM_CAPACITY;
 r[0].ready=false;#assert anim_performance_load(AP_TEST,r[..],c[..],p[..])==ANIM_REFERENCE;r[0].ready=true;c[0].ready=false;#assert anim_performance_load(AP_TEST,r[..],c[..],p[..])==ANIM_REFERENCE;c[0].ready=true;c[0].rig=anim_named("other");#assert anim_performance_load(AP_TEST,r[..],c[..],p[..])==ANIM_REFERENCE;
}
#test "animation performances admit all authored layer and solver kinds in order" {
 r:[1]AnimRig;c:[1]AnimClip;anim_test_performance_context(r[..],c[..]);p:[1]AnimPerformance;layers:[16384]u8;text:[32768]u8;o:[1]Jo;jo_start(o[..],layers[..]);jo_arr(o[..]);
 for k:0..<8 {jo_obj(o[..]);jo_key(o[..],"kind");jo_str(o[..],ifx k<4 then ANIM_LAYER_KINDS[k] else "fix-up");jo_key(o[..],"mask");jo_str(o[..],ANIM_MASKS[k]);jo_key(o[..],"start");jo_int(o[..],0);jo_key(o[..],"end");jo_int(o[..],4);jo_key(o[..],"speed");jo_int(o[..],1);jo_key(o[..],"blend_in");jo_int(o[..],0);jo_key(o[..],"blend_out");jo_int(o[..],0);jo_key(o[..],"weight");jo_int(o[..],1);
  if k<4 {jo_key(o[..],"clip");jo_str(o[..],"made-wave");}else {jo_key(o[..],"solver");jo_str(o[..],ANIM_SOLVERS[k-4]);jo_key(o[..],"joint");jo_str(o[..],"Head");jo_key(o[..],"target");jo_raw(o[..],"[-1.1,2.2,-3.3]");}jo_end(o[..]);}jo_end(o[..]);
 n:=anim_test_set(AP_TEST,"layers",jo_text(o[..]),text[..]);#assert anim_performance_load(cast(string)text[0..<n],r[..],c[..],p[..])==0 && p[0].count==8;
 for k:0..<8 {#assert p[0].layers[k].kind==(ifx k<4 then k else 4) && p[0].layers[k].mask==k;if k>=4 {#assert p[0].layers[k].solver==k-4 && p[0].layers[k].target.x== -1.1 && p[0].layers[k].target.y==2.2 && p[0].layers[k].target.z== -3.3;}}
}
#test "animation performance layer capacity and ordering are exact" #steps 100000000 {
 r:[1]AnimRig;c:[1]AnimClip;anim_test_performance_context(r[..],c[..]);p:[1]AnimPerformance;layers:[16384]u8;text:[32768]u8;o:[1]Jo;
 for count:[3]int.[0,32,33] {jo_start(o[..],layers[..]);jo_arr(o[..]);for k:0..<count {jo_obj(o[..]);jo_key(o[..],"kind");jo_str(o[..],ifx k==0 then "base" else "override");jo_key(o[..],"clip");jo_str(o[..],"made-wave");jo_key(o[..],"mask");jo_str(o[..],"all");jo_key(o[..],"start");jo_int(o[..],0);jo_key(o[..],"end");jo_int(o[..],4);jo_key(o[..],"speed");jo_raw(o[..],"0.01");jo_key(o[..],"weight");jo_int(o[..],0);jo_key(o[..],"blend_in");jo_int(o[..],2);jo_key(o[..],"blend_out");jo_int(o[..],2);jo_end(o[..]);}jo_end(o[..]);n:=anim_test_set(AP_TEST,"layers",jo_text(o[..]),text[..]);#assert anim_performance_load(cast(string)text[0..<n],r[..],c[..],p[..])==(ifx count==32 then ANIM_OK else ANIM_LIMIT);if count==32 {#assert p[0].count==32 && p[0].layers[31].weight==0 && p[0].layers[31].speed==0.01;}}
 changed:[8192]u8;n:=anim_test_set(AP_TEST,"layers","{}",changed[..]);#assert anim_performance_load(cast(string)changed[0..<n],r[..],c[..],p[..])==ANIM_LIMIT;
 n=anim_test_replace(AP_TEST,"\"kind\":\"base\"","\"kind\":\"override\"",changed[..]);#assert anim_performance_load(cast(string)changed[0..<n],r[..],c[..],p[..])==ANIM_SCHEMA;
}
#test "animation performances require one base and put all solvers after ordinary layers" {
 r:[1]AnimRig;c:[1]AnimClip;anim_test_performance_context(r[..],c[..]);p:[1]AnimPerformance;nodes:[1024]JvNode;d:[1]Jv;#assert jv_parse(d[..],AP_TEST,nodes[..]);layers:=jv_get(d[0],0,"layers");list:[8192]u8;text:[16384]u8;changed:[16384]u8;o:[1]Jo;
 jo_start(o[..],list[..]);jo_arr(o[..]);jv_write(d[0],jv_at(d[0],layers,0),o[..]);jo_end(o[..]);n:=anim_test_set(AP_TEST,"layers",jo_text(o[..]),text[..]);#assert anim_performance_load(cast(string)text[0..<n],r[..],c[..],p[..])==0 && p[0].count==1;
 n=anim_test_set(AP_TEST,"rig","\"\"",changed[..]);#assert anim_performance_load(cast(string)changed[0..<n],r[..],c[..],p[..])==ANIM_NAME;n=anim_test_set(AP_TEST,"layers","{\"x\":0}",changed[..]);#assert anim_performance_load(cast(string)changed[0..<n],r[..],c[..],p[..])==ANIM_LIMIT;
 jo_start(o[..],list[..]);jo_arr(o[..]);jv_write(d[0],jv_at(d[0],layers,0),o[..]);jv_write(d[0],jv_at(d[0],layers,1),o[..]);row:[4096]u8;nn:=anim_test_set(jv_raw(d[0],jv_at(d[0],layers,0)),"kind","\"override\"",row[..]);jo_raw(o[..],cast(string)row[0..<nn]);jo_end(o[..]);n=anim_test_set(AP_TEST,"layers",jo_text(o[..]),text[..]);#assert anim_performance_load(cast(string)text[0..<n],r[..],c[..],p[..])==ANIM_SCHEMA;
}
#test "animation blend windows reject negative overflow and float32-zero durations" {
 r:[1]AnimRig;c:[1]AnimClip;anim_test_performance_context(r[..],c[..]);p:[1]AnimPerformance;nodes:[1024]JvNode;d:[1]Jv;#assert jv_parse(d[..],AP_TEST,nodes[..]);base:=jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,"layers"),0));a:[4096]u8;b:[4096]u8;text:[8192]u8;list:[8192]u8;o:[1]Jo;
 n:=anim_test_set(base,"start","1",a[..]);n=anim_test_set(cast(string)a[0..<n],"blend_in","0",b[..]);n=anim_test_set(cast(string)b[0..<n],"blend_out","0",a[..]);for end:[2]string.["1","1.0000000001"] {nn:=anim_test_set(cast(string)a[0..<n],"end",end,b[..]);jo_start(o[..],list[..]);jo_arr(o[..]);jo_raw(o[..],cast(string)b[0..<nn]);jo_end(o[..]);nn=anim_test_set(AP_TEST,"layers",jo_text(o[..]),text[..]);#assert anim_performance_load(cast(string)text[0..<nn],r[..],c[..],p[..])==ANIM_NUMBER;}
 n=anim_test_set(base,"blend_in","3",a[..]);n=anim_test_set(cast(string)a[0..<n],"blend_out","2",b[..]);jo_start(o[..],list[..]);jo_arr(o[..]);jo_raw(o[..],cast(string)b[0..<n]);jo_end(o[..]);n=anim_test_set(AP_TEST,"layers",jo_text(o[..]),text[..]);#assert anim_performance_load(cast(string)text[0..<n],r[..],c[..],p[..])==ANIM_NUMBER;
 json:="{\"zero\":0,\"positive\":4,\"negative\":-1,\"wrong\":\"1\",\"huge\":1e39}";#assert jv_parse(d[..],json,nodes[..]);#assert anim_blend_number(d[0],jv_get(d[0],0,"zero")).ok && anim_blend_number(d[0],jv_get(d[0],0,"zero")).value==0 && anim_blend_number(d[0],jv_get(d[0],0,"positive")).value==4 && !anim_blend_number(d[0],jv_get(d[0],0,"negative")).ok && !anim_blend_number(d[0],jv_get(d[0],0,"wrong")).ok && !anim_blend_number(d[0],jv_get(d[0],0,"huge")).ok;
}
