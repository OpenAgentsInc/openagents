#test "retarget baking emits an admitted target clip with roots events and named curves" {
 source:=rt_test_rig();source.joints=2;source.name=anim_named("source");source.shape_count=1;source.shapes[0]=anim_named("smile");target:=source;target.name=anim_named("target");
 bytes:[120]u8;for k:0..<4 {aw_put(bytes[..],k*28+24,f32_bits(1));}aw_put(bytes[..],56,f32_bits(2));aw_put(bytes[..],104,f32_bits(0.70710678));aw_put(bytes[..],108,f32_bits(0.70710678));aw_put(bytes[..],116,f32_bits(0.5));packs:=[1]AnimPack.[AnimPack.{id=asset_id(cast(string)bytes[..]),bytes=bytes[..]}];
 clip:AnimClip;clip.ready=true;clip.name=anim_named("move");clip.role=clip.name;clip.rig=source.name;clip.source=packs[0].id;clip.frames=2;clip.rate=1;clip.length=1;clip.joint_count=2;clip.joints[1]=1;clip.body=AnimPart.{pack=0,count=4,stride=28,width=28};clip.root=AnimPart.{pack=0,count=2,stride=56,width=12};clip.curve_count=1;clip.curves[0]=0;clip.face=AnimPart.{pack=0,offset=112,count=2,stride=4,width=4};clip.event_count=1;clip.events[0]=AnimEvent.{at=1,kind=2,joint=1};
 plan:[1]RtPlan;#assert rt_plan(source,target,plan[..])==0;out:[512]u8;result:=rt_bake(source,target,clip,packs[..],plan[0],out[..],0,asset_id("made-retarget"));#assert result.bytes==120 && result.clip.rig.n==6 && result.clip.curve_count==1 && result.clip.event_count==1 && result.dropped_curves==0;
 packed:=[1]AnimPack.[AnimPack.{id=asset_id(cast(string)out[0..<result.bytes]),bytes=out[0..<result.bytes]}];hash:[64]u8;#assert asset_hex(packed[0].id,hash[..]);text:[4096]u8;n:=aw_clip(text[..],result.clip,target,cast(string)hash[..]);loaded:[1]AnimClip;rigs:=[1]AnimRig.[target];#assert anim_clip_load(cast(string)text[0..<n],packed[..],rigs[..],loaded[..])==0 && loaded[0].root.stride==56;
 sample:[1]AnimSample;anim_sample(target,loaded[0],packed[..],1,sample[..]);#assert sample[0].position[0].x==2 && sample[0].weights[0]==0.5;
 target.shape_count=0;result=rt_bake(source,target,clip,packs[..],plan[0],out[..],0,asset_id("made-retarget"));#assert result.bytes==112 && result.dropped_curves==1 && result.clip.curve_count==0;
 #assert rt_bake(source,target,clip,packs[..],plan[0],out[0..<111],0,asset_id("made-retarget")).bytes== -1;
}
