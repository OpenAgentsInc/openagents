// The Metaverse Engine's architecture kit, a town square: what stands in a plaza, as generators. Each writes one
// part at the origin with the ground at y 0, and its solids with it (metaverse-engine/arch/mesh.coax), so a
// flight of steps can be climbed, a terrace stood on, and nothing drawn here can be walked through.
//
//   arch_steps         a flight of stone steps, climbing toward -z
//   arch_terrace       a raised stone platform with a paved top
//   arch_pedestal      a great square pier with a roundel, for a lantern or an urn
//   arch_banner_frame  two posts and a beam with a banner hung between them
//   arch_bench         a seat of planks on two stone blocks
//   arch_fountain      a round basin, a bowl on a stem, falling water and a statue
//   arch_parasol       a striped market parasol over a table of flowers
//   arch_barrel, arch_urn, arch_planter   a barrel, a clay jar, a stone urn with a clipped bush
//   arch_dais          a round stepped plinth;  arch_podium  a square one
//   arch_paved_ring    a ring of setts laid in arcs inside a stone kerb
//
// The parameters of each: metaverse-engine/arch/README.md.
//   coax/bin/coax test --library metaverse-engine/arch/plaza.coax
#module "metaverse.engine.arch.plaza";
#load "village.coax";
#load "flora.coax";

// A flight of `steps` steps, `w` wide, climbing `h` over `run` metres toward -z: its foot's front
// edge lies along z 0 and its top step ends at z -run. Each step is a solid a walker climbs.
arch_steps :: (p: [] ArchPen, w: f32, run: f32, h: f32, steps: int) -> ArchPart {
  from := p[0].n; hw := w * 0.5;
  if steps < 1 { return arch_part(p, from); }
  tread := run / cast(f32) steps; riser := h / cast(f32) steps;
  arch_material(p, ARCH_M_SLAB, 0, 0, 0);
  for i: 0..<steps {
    z1 := -tread * cast(f32) i; z0 := -tread * cast(f32) (i + 1); y1 := riser * cast(f32) (i + 1);
    arch_slab(p, -hw, 0, z0, hw, y1, z1);
    arch_solid_box(p, -hw, 0, z0, hw, y1, z1);
  }
  return arch_part(p, from);
}
// A terrace: a platform of dressed stone `w` wide and `d` deep behind its front edge (along z 0),
// `h` high, paved with slabs under a coping. Its top is ground for whoever reaches it.
arch_terrace :: (p: [] ArchPen, w: f32, d: f32, h: f32) -> ArchPart {
  from := p[0].n; hw := w * 0.5;
  arch_material(p, ARCH_M_ASHLAR, 0.7, 0.69, 0.64);
  arch_slab(p, -hw, 0, -d, hw, h - 0.14, 0);
  arch_material(p, ARCH_M_SLAB, 0, 0, 0);
  arch_slab(p, -hw - 0.06, h - 0.14, -d - 0.06, hw + 0.06, h, 0.06);
  arch_solid_box(p, -hw, 0, -d, hw, h, 0);
  return arch_part(p, from);
}
// A great square pier, `side` across and `h` high: a plinth, a shaft of dressed stone with a
// roundel on its front, and a cap in two courses.
arch_pedestal :: (p: [] ArchPen, side: f32, h: f32) -> ArchPart {
  from := p[0].n; t := side * 0.5;
  arch_material(p, ARCH_M_ASHLAR, 0.72, 0.71, 0.66);
  arch_slab(p, -t - 0.1, 0, -t - 0.1, t + 0.1, 0.32, t + 0.1);
  arch_slab(p, -t, 0.32, -t, t, h - 0.3, t);
  arch_material(p, ARCH_M_SMOOTH, 0, 0, 0);
  arch_slab(p, -t - 0.08, h - 0.3, -t - 0.08, t + 0.08, h - 0.14, t + 0.08);
  arch_slab(p, -t - 0.16, h - 0.14, -t - 0.16, t + 0.16, h, t + 0.16);
  f := arch_wall_of(0, side, side);
  arch_wall_fan(p, f, t, h * 0.52, side * 0.27, 0, f32(ARCH_TAU), 14, 0.05);
  for k: 0..<14 {
    a := f32(ARCH_TAU) * cast(f32) k / 14.0; b := f32(ARCH_TAU) * cast(f32) (k + 1) / 14.0; r := side * 0.3;
    arch_beam(p, arch_wall_at(f, t + cos(a) * r, h * 0.52 + sin(a) * r, 0.03), arch_wall_at(f, t + cos(b) * r, h * 0.52 + sin(b) * r, 0.03), 0.035);
  }
  arch_solid_box(p, -t - 0.1, 0, -t - 0.1, t + 0.1, h, t + 0.1);
  return arch_part(p, from);
}
// Two posts `w` apart and a beam across them `h` up, braced, with a banner `long` long hung
// between them in a colour (0, 0, 0: deep blue). It faces +z.
arch_banner_frame :: (p: [] ArchPen, w: f32, h: f32, long: f32, r: f32, g: f32, b: f32) -> ArchPart {
  from := p[0].n; hw := w * 0.5;
  arch_material(p, ARCH_M_TIMBER, 0, 0, 0);
  for k: 0..<2 {
    x: f32 = ifx k == 0 then -hw else hw;
    arch_beam(p, arch_v(x, 0, 0), arch_v(x, h + 0.45, 0), 0.085);
    cap := p[0].n; arch_cone(p, 0.15, 0, 0.3, 4); arch_move(p[0].out, arch_part(p, cap), x, h + 0.45, 0);
    arch_beam(p, arch_v(x, h - 0.75, 0), arch_v(x + (ifx k == 0 then -0.55f32 else 0.55f32), h - 0.05, 0), 0.05);
    arch_solid_box(p, x - 0.085, 0, -0.085, x + 0.085, h + 0.45, 0.085);
  }
  arch_beam(p, arch_v(-hw - 0.7, h, 0), arch_v(hw + 0.7, h, 0), 0.075);
  face := ArchWall.{ox = -hw, oz = 0, rx = 1, rz = 0, nx = 0, nz = 1};
  arch_tint(p, r, g, b);
  arch_banner(p, face, hw, h - 0.16, w - 0.42, long, 0);
  return arch_part(p, from);
}
// A bench `w` long: a seat of planks laid across two blocks of stone.
arch_bench :: (p: [] ArchPen, w: f32) -> ArchPart {
  from := p[0].n; hw := w * 0.5;
  arch_material(p, ARCH_M_SMOOTH, 0.62, 0.66, 0.66);
  for k: 0..<2 {
    x: f32 = ifx k == 0 then -hw + 0.42 else hw - 0.42;
    arch_slab(p, x - 0.16, 0, -0.2, x + 0.16, 0.38, 0.2);
    arch_solid_box(p, x - 0.16, 0, -0.2, x + 0.16, 0.38, 0.2);
  }
  arch_material(p, ARCH_M_PLANK, 0.7, 0.4, 0.2);
  arch_slab(p, -hw, 0.38, -0.27, hw, 0.5, 0.27);
  arch_solid_box(p, -hw, 0.38, -0.27, hw, 0.5, 0.27);
  return arch_part(p, from);
}
// A fountain `r` across its basin: a low step, a basin of water, a bowl on a stem that spills into
// it, and a robed statue on the stem's head, `h` high over all.
arch_fountain :: (p: [] ArchPen, r: f32, h: f32) -> ArchPart {
  from := p[0].n;
  arch_material(p, ARCH_M_SMOOTH, 0.8, 0.79, 0.74);
  arch_ring(p, 0, r + 0.35, 0, 0.16, 0, ARCH_TAU, 20);
  arch_ring(p, r - 0.28, r, 0.16, 0.66, 0, ARCH_TAU, 20);
  arch_ring(p, r - 0.36, r + 0.08, 0.66, 0.74, 0, ARCH_TAU, 20);
  arch_material(p, ARCH_M_WATER, 0, 0, 0);
  arch_ring(p, 0, r - 0.28, 0.5, 0.56, 0, ARCH_TAU, 20);
  // The stem and its bowl.
  bowl := r * 0.58; by := h * 0.36;
  arch_material(p, ARCH_M_SMOOTH, 0.8, 0.79, 0.74);
  stem := [7] ArchTurn.[ArchTurn.{r = r * 0.3, y = 0.16, flute = 0}, ArchTurn.{r = r * 0.2, y = 0.9, flute = 0}, ArchTurn.{r = r * 0.14, y = by - 0.5, flute = 0},
                         ArchTurn.{r = bowl * 0.5, y = by - 0.3, flute = 0}, ArchTurn.{r = bowl, y = by - 0.06, flute = 0}, ArchTurn.{r = bowl + 0.05, y = by + 0.06, flute = 0}, ArchTurn.{r = bowl - 0.08, y = by + 0.06, flute = 0}];
  arch_lathe(p, stem[..], 16, 0, 0);
  arch_material(p, ARCH_M_WATER, 0, 0, 0);
  arch_ring(p, 0, bowl - 0.08, by - 0.02, by + 0.03, 0, ARCH_TAU, 16);
  // Water falling from the bowl's lip in eight sheets.
  for k: 0..<8 {
    a := f32(ARCH_TAU) * (cast(f32) k + 0.5) / 8.0; c := cos(a); s := sin(a); wide := bowl * 0.2;
    x0 := c * (bowl + 0.05) - s * wide; z0 := s * (bowl + 0.05) + c * wide; x1 := c * (bowl + 0.05) + s * wide; z1 := s * (bowl + 0.05) - c * wide;
    arch_face(p, arch_v(x1 * 1.08, 0.56, z1 * 1.08), arch_v(x0 * 1.08, 0.56, z0 * 1.08), arch_v(x0, by + 0.04, z0), arch_v(x1, by + 0.04, z1));
  }
  // The stem above the bowl, and the statue: a robed figure holding a dish.
  arch_material(p, ARCH_M_SMOOTH, 0.8, 0.79, 0.74);
  sy := h * 0.56; tall := h - sy;
  upper := [4] ArchTurn.[ArchTurn.{r = r * 0.12, y = by, flute = 0}, ArchTurn.{r = r * 0.1, y = sy - 0.3, flute = 0}, ArchTurn.{r = r * 0.2, y = sy - 0.16, flute = 0}, ArchTurn.{r = r * 0.2, y = sy, flute = 0}];
  arch_lathe(p, upper[..], 12, 0, 0);
  arch_material(p, ARCH_M_SMOOTH, 0.6, 0.63, 0.62);
  robe := [6] ArchTurn.[ArchTurn.{r = tall * 0.2, y = sy, flute = 0}, ArchTurn.{r = tall * 0.15, y = sy + tall * 0.4, flute = 0}, ArchTurn.{r = tall * 0.11, y = sy + tall * 0.62, flute = 0},
                         ArchTurn.{r = tall * 0.14, y = sy + tall * 0.76, flute = 0}, ArchTurn.{r = tall * 0.06, y = sy + tall * 0.84, flute = 0}, ArchTurn.{r = tall * 0.05, y = sy + tall * 0.87, flute = 0}];
  arch_lathe(p, robe[..], 10, 0, 0);
  arch_ellipsoid(p, 0, sy + tall * 0.93, 0, tall * 0.075, tall * 0.085, tall * 0.075, 8, 6);
  for k: 0..<2 {
    sx: f32 = ifx k == 0 then -1 else 1;
    arch_limb(p, sx * tall * 0.13, sy + tall * 0.75, 0, sx * tall * 0.15, sy + tall * 0.58, tall * 0.08, tall * 0.045, tall * 0.035, 6);
    arch_limb(p, sx * tall * 0.15, sy + tall * 0.58, tall * 0.08, sx * tall * 0.04, sy + tall * 0.6, tall * 0.2, tall * 0.035, tall * 0.03, 6);
  }
  arch_ellipsoid(p, 0, sy + tall * 0.6, tall * 0.21, tall * 0.1, tall * 0.035, tall * 0.1, 8, 4);
  arch_solid_round(p, 0, 0, r + 0.35, 0, 0.16);
  arch_solid_round(p, 0, 0, r, 0.16, 0.74);
  arch_solid_round(p, 0, 0, bowl + 0.05, 0.74, by + 0.06);
  return arch_part(p, from);
}
// A market parasol `r` across on a pole `h` high, its cloth in wedges of a colour and cream with
// a scalloped edge, over a trestle table of flowers.
arch_parasol :: (p: [] ArchPen, r: f32, h: f32, cr: f32, cg: f32, cb: f32, seed: int) -> ArchPart {
  from := p[0].n; wedges := 12;
  arch_material(p, ARCH_M_TIMBER, 0, 0, 0);
  arch_beam(p, arch_v(0, 0, 0), arch_v(0, h + 0.25, 0), 0.045);
  tip := arch_v(0, h + 0.12, 0); rim := h - r * 0.34;
  for i: 0..<wedges {
    a := f32(ARCH_TAU) * cast(f32) i / cast(f32) wedges; b := f32(ARCH_TAU) * cast(f32) (i + 1) / cast(f32) wedges; m := (a + b) * 0.5;
    if i % 2 == 0 { arch_material(p, ARCH_M_CLOTH, cr, cg, cb); } else { arch_material(p, ARCH_M_CLOTH, 0.94, 0.9, 0.8); }
    qa := arch_v(cos(a) * r, rim, sin(a) * r); qb := arch_v(cos(b) * r, rim, sin(b) * r);
    arch_face(p, qb, qa, tip, tip);
    // The edge that hangs down: a scallop to a point under the wedge's middle.
    arch_face(p, qa, qb, arch_v(cos(m) * r, rim - 0.2, sin(m) * r), arch_v(cos(m) * r, rim - 0.2, sin(m) * r));
    arch_material(p, ARCH_M_TIMBER, 0, 0, 0);
    arch_beam(p, arch_v(0, rim + 0.05, 0), arch_vmul(arch_vadd(qa, arch_v(0, 0, 0)), 1.0), 0.012);
  }
  // The table: boards on two trestles, and flowers in crates on it.
  arch_material(p, ARCH_M_PLANK, 0.6, 0.42, 0.25);
  tw := r * 0.72; td := r * 0.36;
  arch_slab(p, -tw, 0.68, 0.25, tw, 0.76, 0.25 + td * 2);
  arch_material(p, ARCH_M_TIMBER, 0, 0, 0);
  for k: 0..<2 {
    x: f32 = ifx k == 0 then -tw + 0.2 else tw - 0.2;
    arch_beam(p, arch_v(x, 0, 0.32), arch_v(x, 0.68, 0.25 + td), 0.035); arch_beam(p, arch_v(x, 0, 0.18 + td * 2), arch_v(x, 0.68, 0.25 + td), 0.035);
  }
  arch_goods(p, ARCH_GOODS_FLOWERS, -tw + 0.05, 0.3, tw - 0.05, 0.2 + td * 2, 0.76, seed);
  arch_solid_box(p, -tw, 0, 0.25, tw, 0.76, 0.25 + td * 2);
  arch_solid_round(p, 0, 0, 0.045, 0, h);
  return arch_part(p, from);
}
// A barrel `r` at its belly and `h` high: staves in two iron hoops.
arch_barrel :: (p: [] ArchPen, r: f32, h: f32) -> ArchPart {
  from := p[0].n;
  arch_material(p, ARCH_M_BARK, 0.5, 0.33, 0.19);
  staves := [5] ArchTurn.[ArchTurn.{r = r * 0.8, y = 0, flute = 0}, ArchTurn.{r = r * 0.96, y = h * 0.25, flute = 0}, ArchTurn.{r = r, y = h * 0.5, flute = 0}, ArchTurn.{r = r * 0.96, y = h * 0.75, flute = 0}, ArchTurn.{r = r * 0.8, y = h, flute = 0}];
  arch_lathe(p, staves[..], 12, 0, 0);
  arch_material(p, ARCH_M_METAL, 0, 0, 0);
  arch_ring(p, r * 0.9, r * 0.95, h * 0.16, h * 0.22, 0, ARCH_TAU, 12);
  arch_ring(p, r * 0.9, r * 0.95, h * 0.78, h * 0.84, 0, ARCH_TAU, 12);
  arch_solid_round(p, 0, 0, r, 0, h);
  return arch_part(p, from);
}
// A clay jar `r` at its belly and `h` high, in a colour.
arch_urn :: (p: [] ArchPen, r: f32, h: f32, cr: f32, cg: f32, cb: f32) -> ArchPart {
  from := p[0].n;
  arch_material(p, ARCH_M_CLOTH, cr, cg, cb);
  shape := [6] ArchTurn.[ArchTurn.{r = r * 0.5, y = 0, flute = 0}, ArchTurn.{r = r, y = h * 0.4, flute = 0}, ArchTurn.{r = r * 0.9, y = h * 0.64, flute = 0},
                          ArchTurn.{r = r * 0.42, y = h * 0.86, flute = 0}, ArchTurn.{r = r * 0.56, y = h, flute = 0}, ArchTurn.{r = r * 0.4, y = h, flute = 0}];
  arch_lathe(p, shape[..], 10, 0, 0);
  arch_solid_round(p, 0, 0, r, 0, h);
  return arch_part(p, from);
}
// A stone urn `r` across on a foot, with a clipped bush growing in it: `h` high over all.
arch_planter :: (p: [] ArchPen, r: f32, h: f32, seed: int) -> ArchPart {
  from := p[0].n; rim := h * 0.48;
  arch_material(p, ARCH_M_SMOOTH, 0.8, 0.79, 0.74);
  shape := [6] ArchTurn.[ArchTurn.{r = r * 0.6, y = 0, flute = 0}, ArchTurn.{r = r * 0.4, y = rim * 0.2, flute = 0}, ArchTurn.{r = r * 0.34, y = rim * 0.36, flute = 0},
                          ArchTurn.{r = r * 0.9, y = rim * 0.74, flute = 0}, ArchTurn.{r = r, y = rim, flute = 0}, ArchTurn.{r = r * 0.8, y = rim, flute = 0}];
  arch_lathe(p, shape[..], 12, 0, 0);
  p[0].material = ARCH_M_LEAF; p[0].tint = [3] f32.[0.2, 0.4, 0.16];
  br := r * 0.95; heart := arch_v(0, rim + br * 0.5, 0);
  arch_leaf_mass(p, 0, rim + br * 0.78, 0, br, br * 0.9, br, heart, rim, rim + br * 1.8, 16, 0.5, seed);
  arch_solid_round(p, 0, 0, r, 0, rim + br * 1.4);
  return arch_part(p, from);
}
// A round stepped plinth: `tiers` drums of dressed stone, the lowest `r` across and each above it
// a quarter narrower, `h` high over all. Each tier is a step.
arch_dais :: (p: [] ArchPen, r: f32, h: f32, tiers: int) -> ArchPart {
  from := p[0].n;
  if tiers < 1 { return arch_part(p, from); }
  for k: 0..<tiers {
    rk := r * (1 - 0.25 * cast(f32) k); y0 := h * cast(f32) k / cast(f32) tiers; y1 := h * cast(f32) (k + 1) / cast(f32) tiers;
    arch_material(p, ARCH_M_ASHLAR, 0.72, 0.71, 0.66);
    arch_drum(p, rk, y0, y1, 24);
    arch_material(p, ARCH_M_SMOOTH, 0.78, 0.77, 0.72);
    arch_ring(p, 0, rk + 0.05, y1 - 0.06, y1, 0, ARCH_TAU, 24);
    arch_solid_round(p, 0, 0, rk, y0, y1);
  }
  return arch_part(p, from);
}
// A stepped base of dressed stone: `tiers` blocks, the lowest `w` by `d` and each above it 0.45 m
// narrower all round, `h` high over all. Each tier is a step.
arch_podium :: (p: [] ArchPen, w: f32, d: f32, h: f32, tiers: int) -> ArchPart {
  from := p[0].n;
  if tiers < 1 { return arch_part(p, from); }
  for k: 0..<tiers {
    in_ := 0.45 * cast(f32) k; hw := w * 0.5 - in_; hd := d * 0.5 - in_;
    y0 := h * cast(f32) k / cast(f32) tiers; y1 := h * cast(f32) (k + 1) / cast(f32) tiers;
    if hw <= 0.1 || hd <= 0.1 { break; }
    arch_material(p, ARCH_M_ASHLAR, 0.72, 0.71, 0.66);
    arch_slab(p, -hw, y0, -hd, hw, y1 - 0.08, hd);
    arch_material(p, ARCH_M_SMOOTH, 0.78, 0.77, 0.72);
    arch_slab(p, -hw - 0.04, y1 - 0.08, -hd - 0.04, hw + 0.04, y1, hd + 0.04);
    arch_solid_box(p, -hw, y0, -hd, hw, y1, hd);
  }
  return arch_part(p, from);
}
// A ring of paving from r0 out to r1: setts laid in arcs round the middle, lying `lift` above
// the ground, inside a kerb of cut stone `kerb` wide. It is too low to be a solid.
arch_paved_ring :: (p: [] ArchPen, r0: f32, r1: f32, kerb: f32, lift: f32) -> ArchPart {
  from := p[0].n; segments := 56;
  arch_material(p, ARCH_M_SETT, 0, 0, 0);
  for i: 0..<segments {
    a := f32(ARCH_TAU) * cast(f32) i / cast(f32) segments; b := f32(ARCH_TAU) * cast(f32) (i + 1) / cast(f32) segments;
    mid := (r0 + r1) * 0.5;
    // u runs round the ring at its middle radius, v out from the middle: courses are arcs.
    arch_quad(p, arch_at(cos(a) * r0, lift, sin(a) * r0, 0, 1, 0, a * mid, r0), arch_at(cos(b) * r0, lift, sin(b) * r0, 0, 1, 0, b * mid, r0),
              arch_at(cos(b) * r1, lift, sin(b) * r1, 0, 1, 0, b * mid, r1), arch_at(cos(a) * r1, lift, sin(a) * r1, 0, 1, 0, a * mid, r1));
  }
  arch_material(p, ARCH_M_SMOOTH, 0.76, 0.75, 0.7);
  arch_ring(p, r1, r1 + kerb, 0, lift + 0.07, 0, ARCH_TAU, segments);
  return arch_part(p, from);
}

// Whether every solid of a part lies inside the part's own bounds (grown by `slack`): no solid
// stands where nothing is drawn.
arch_solids_inside :: (p: [] ArchPen, part: ArchPart, slack: f32) -> bool {
  b := arch_bounds(p[0].out, part);
  for k: 0..<part.solids {
    o := (part.solid + k) * ARCH_SOLID_FLOATS;
    x := p[0].solids[o + 1]; z := p[0].solids[o + 2]; hx := p[0].solids[o + 3]; hz := p[0].solids[o + 4]; turn := p[0].solids[o + 5];
    // A turned box's reach along each axis.
    ex := abs(cos(turn)) * hx + abs(sin(turn)) * hz; ez := abs(sin(turn)) * hx + abs(cos(turn)) * hz;
    if x - ex < b.x0 - slack || x + ex > b.x1 + slack || z - ez < b.z0 - slack || z + ez > b.z1 + slack { return false; }
    if p[0].solids[o + 6] < b.y0 - slack || p[0].solids[o + 7] > b.y1 + slack || p[0].solids[o + 7] <= p[0].solids[o + 6] { return false; }
  }
  return true;
}
// How many of a part's vertices lie inside one of its solids (grown by `slack`), as a share:
// what is drawn that blocks.
arch_solid_share :: (p: [] ArchPen, part: ArchPart, slack: f32) -> f32 {
  if part.count <= 0 { return 0; }
  inside := 0;
  for i: 0..<part.count {
    v := (part.first + i) * ARCH_VERTEX_FLOATS; x := p[0].out[v]; y := p[0].out[v + 1]; z := p[0].out[v + 2];
    for k: 0..<part.solids {
      o := (part.solid + k) * ARCH_SOLID_FLOATS;
      if y < p[0].solids[o + 6] - slack || y > p[0].solids[o + 7] + slack { continue; }
      dx := x - p[0].solids[o + 1]; dz := z - p[0].solids[o + 2]; c := cos(p[0].solids[o + 5]); s := sin(p[0].solids[o + 5]);
      lx := dx * c - dz * s; lz := dx * s + dz * c;
      hit := false;
      if cast(int) p[0].solids[o] == ARCH_SOLID_ROUND { hit = sqrt(dx * dx + dz * dz) <= p[0].solids[o + 3] + slack; }
      else { hit = abs(lx) <= p[0].solids[o + 3] + slack && abs(lz) <= p[0].solids[o + 4] + slack; }
      if hit { inside += 1; break; }
    }
  }
  return cast(f32) inside / cast(f32) part.count;
}

PLAZA_TEST_VERTICES :: 60000;
#test "steps climb, a terrace is a platform, and each keeps its solids to what is drawn" #steps 400000000 {
  buf: [PLAZA_TEST_VERTICES * ARCH_VERTEX_FLOATS] f32; solids: [256 * ARCH_SOLID_FLOATS] f32;
  p: [1] ArchPen; arch_pen(p[..], buf[..]); arch_pen_solids(p[..], solids[..]);
  steps := arch_steps(p[..], 8, 5, 1.6, 10); sb := arch_bounds(buf[..], steps);
  #assert !p[0].full && steps.count == 10 * 36 && steps.solids == 10 && abs(sb.y1 - 1.6) < 0.001 && abs(sb.z0 + 5) < 0.001 && sb.z1 == 0 && sb.x1 == 4;
  // Each step rises less than a walker steps, and the top one ends at the flight's height.
  for k: 0..<10 { o := (steps.solid + k) * ARCH_SOLID_FLOATS; #assert abs(solids[o + 7] - 0.16 * cast(f32) (k + 1)) < 0.0001 && abs(solids[o + 4] - 0.25) < 0.0001; }
  #assert arch_solids_inside(p[..], steps, 0.001) && arch_solid_share(p[..], steps, 0.001) == 1;
  terrace := arch_terrace(p[..], 30, 20, 1.6); tb := arch_bounds(buf[..], terrace);
  #assert terrace.solids == 1 && abs(tb.y1 - 1.6) < 0.001 && tb.z0 < -20 && arch_solids_inside(p[..], terrace, 0.001) && arch_count_of(buf[..], terrace, ARCH_M_SLAB) == 36;
  pier := arch_pedestal(p[..], 1.4, 2.2); #assert pier.solids == 1 && abs(arch_bounds(buf[..], pier).y1 - 2.2) < 0.001 && arch_solids_inside(p[..], pier, 0.07);
  frame := arch_banner_frame(p[..], 1.5, 4.6, 2.6, 0, 0, 0);
  #assert frame.solids == 2 && arch_count_of(buf[..], frame, ARCH_M_BANNER) == 15 && arch_solids_inside(p[..], frame, 0.001) && arch_bounds(buf[..], frame).y0 >= 0;
  bench := arch_bench(p[..], 2.4); #assert bench.solids == 3 && abs(arch_bounds(buf[..], bench).y1 - 0.5) < 0.001 && arch_solids_inside(p[..], bench, 0.001) && arch_solid_share(p[..], bench, 0.001) == 1;
  #assert !p[0].full && arch_normals_unit(buf[..], frame) && arch_normals_unit(buf[..], pier);
}
#test "a fountain, a parasol, a barrel, jars, a planter, a dais and a ring of setts keep to their sizes and their solids" #steps 400000000 {
  buf: [PLAZA_TEST_VERTICES * ARCH_VERTEX_FLOATS] f32; solids: [64 * ARCH_SOLID_FLOATS] f32;
  p: [1] ArchPen; arch_pen(p[..], buf[..]); arch_pen_solids(p[..], solids[..]);
  fountain := arch_fountain(p[..], 2.2, 5.2); fb := arch_bounds(buf[..], fountain);
  #assert !p[0].full && fountain.solids == 3 && fb.y1 > 5.0 && fb.y1 < 5.4 && fb.x1 < 2.6 && arch_count_of(buf[..], fountain, ARCH_M_WATER) > 0 && arch_solids_inside(p[..], fountain, 0.05);
  parasol := arch_parasol(p[..], 1.7, 2.5, 0.8, 0.2, 0.15, 4); pb := arch_bounds(buf[..], parasol);
  #assert parasol.solids == 2 && pb.y1 < 2.9 && pb.x1 <= 1.71 && arch_count_of(buf[..], parasol, ARCH_M_CLOTH) > 12 * 6 && arch_solids_inside(p[..], parasol, 0.01);
  barrel := arch_barrel(p[..], 0.4, 0.95); #assert barrel.solids == 1 && abs(arch_bounds(buf[..], barrel).y1 - 0.95) < 0.001 && arch_solids_inside(p[..], barrel, 0.01);
  urn := arch_urn(p[..], 0.3, 0.7, 0.74, 0.36, 0.2); #assert urn.solids == 1 && abs(arch_bounds(buf[..], urn).x1 - 0.3) < 0.01;
  planter := arch_planter(p[..], 0.5, 1.6, 2); #assert planter.solids == 1 && arch_count_of(buf[..], planter, ARCH_M_LEAF) > 0 && arch_bounds(buf[..], planter).y1 > 1.3;
  dais := arch_dais(p[..], 3.2, 0.9, 2); db := arch_bounds(buf[..], dais);
  #assert dais.solids == 2 && abs(db.y1 - 0.9) < 0.001 && abs(db.x1 - 3.25) < 0.01 && abs(solids[(dais.solid + 1) * ARCH_SOLID_FLOATS + 3] - 2.4) < 0.001 && arch_solids_inside(p[..], dais, 0.06);
  podium := arch_podium(p[..], 3.6, 2.4, 0.9, 2); #assert podium.solids == 2 && abs(arch_bounds(buf[..], podium).y1 - 0.9) < 0.001 && arch_solids_inside(p[..], podium, 0.001);
  ring := arch_paved_ring(p[..], 3.2, 7.0, 0.3, 0.03); rb := arch_bounds(buf[..], ring);
  #assert !p[0].full && ring.solids == 0 && arch_count_of(buf[..], ring, ARCH_M_SETT) == 56 * 6 && abs(rb.x1 - 7.3) < 0.01 && rb.y1 <= 0.101;
}
#test "every village generator's solids stand inside what it draws, and a building's walls are solid" #steps 800000000 {
  buf: [140000 * ARCH_VERTEX_FLOATS] f32; solids: [256 * ARCH_SOLID_FLOATS] f32;
  p: [1] ArchPen; arch_pen(p[..], buf[..]); arch_pen_solids(p[..], solids[..]);
  cot: ArchCottage; cot.porch = 1.8; cottage := arch_cottage(p[..], cot);
  #assert cottage.solids >= 4 && arch_solids_inside(p[..], cottage, 0.01);
  // The house's own box reaches its walls: a point a hand inside each wall is in a solid.
  o := (cottage.solid + cottage.solids - 2) * ARCH_SOLID_FLOATS;
  #assert solids[o] == ARCH_SOLID_BOX && abs(solids[o + 3] - (cot.w * 0.5 + 0.07)) < 0.001 && abs(solids[o + 4] - (cot.d * 0.5 + 0.07)) < 0.001 && solids[o + 6] == 0;
  house: ArchStoneHouse; house.annex = 1.4; stone := arch_stone_house(p[..], house); #assert stone.solids == 2 && arch_solids_inside(p[..], stone, 0.01);
  tower: ArchTower; round := arch_round_tower(p[..], tower); #assert round.solids == 1 && arch_solids_inside(p[..], round, 0.01);
  ch: ArchChurch; church := arch_church(p[..], ch); #assert church.solids == 4 && arch_solids_inside(p[..], church, 0.01);
  dry: ArchDryWall; dry.run = 8; dry.tumble = 2; wall := arch_drystone(p[..], dry);
  #assert wall.solids > 6 && arch_solids_inside(p[..], wall, 0.12) && arch_solid_share(p[..], wall, 0.2) > 0.97;
  // Its solids follow its top: high where it stands, lower at its tumbled end.
  first := (wall.solid + dry.fallen) * ARCH_SOLID_FLOATS; last := (wall.solid + wall.solids - 1) * ARCH_SOLID_FLOATS;
  #assert solids[first + 7] > 0.7 && solids[last + 7] < solids[first + 7] - 0.2;
  coped := arch_coped_wall(p[..], 5, 1.1, 0.4, 0.5, 0.55, 0.6); pier := arch_pier(p[..], 0.6, 1.4, true);
  lamp := arch_lamp_post(p[..], 3.2); pole := arch_banner_pole(p[..], 5, 0.8, 0.2, 0.2); sign := arch_signpost(p[..], 2.4, 3);
  st: ArchStall; stall := arch_stall(p[..], st); crate := arch_crate(p[..], 0.8);
  #assert coped.solids == 1 && pier.solids == 1 && lamp.solids == 2 && pole.solids == 1 && sign.solids == 1 && stall.solids == 5 && crate.solids == 1;
  #assert arch_solids_inside(p[..], coped, 0.001) && arch_solids_inside(p[..], pier, 0.001) && arch_solids_inside(p[..], lamp, 0.02) && arch_solids_inside(p[..], pole, 0.02);
  #assert arch_solids_inside(p[..], sign, 0.001) && arch_solids_inside(p[..], stall, 0.001) && arch_solids_inside(p[..], crate, 0.04) && !p[0].full;
  // Bunting hangs overhead: it blocks no one.
  line := arch_bunting(p[..], arch_v(0, 4, 0), arch_v(8, 4, 0), 0.6, 12, true); #assert line.solids == 0;
}
