// The sounds of building, from numbers: what a part makes as it lands on a build site
// (metaverse-engine/world/build-site.coax). A pole or a board knocks, woven withies creak, a stone clacks on
// a stone, thatch and boughs rustle, a spade cuts earth. Each is a recipe in Audio Lab's
// synthesized format (sfx.coax: SfxLayer, sl, sfx_add; synth.coax's oscillators, seeded noise,
// envelopes and one-pole filters), rendered once to 16-bit mono WAV bytes by the page that plays
// it. Nothing is recorded or downloaded: CC0, made by OpenAgents. Integers only, so a recipe
// renders the same bytes on every build and target. Which sound a part makes is
// metaverse-engine/world/build-work.coax bw_sound.
//   coax/bin/coax test metaverse-engine/audio/build-sfx.coax --library
#load "sfx.coax";

BSFX_WOOD :: 0;     // a pole, a beam, a board set down: a hollow knock
BSFX_WITHY :: 1;    // a withy bent round a stake: a short creak
BSFX_STONE :: 2;    // a stone set on a stone: a clack and a smaller one after it
BSFX_THATCH :: 3;   // a reed bundle or a bough laid: a dry rustle
BSFX_EARTH :: 4;    // a spade into earth, or clay pressed on: a gritty cut and a dull thud
BSFX_COUNT :: 5;
BSFX_NAMES :: [BSFX_COUNT] string.["build-wood", "build-withy", "build-stone", "build-thatch", "build-earth"];
BSFX_MAX_MS :: 700;

bsfx_id :: (name: string) -> int {
  for i: 0..<BSFX_COUNT { if BSFX_NAMES[i] == name { return i; } }
  return -1;
}

// book:begin build-recipes
bsfx_recipe :: (id: int) -> Sfx {
  s := Sfx.{};
  if id == BSFX_WOOD {          // a hollow knock: the wood's low body, a higher partial, the strike's click
    s = sfx_add(s, sl_curve(sl(SFX_SINE, 0, 260, 2, 210, 168, 0, 0, 0, 1000), 3));
    s = sfx_add(s, sl_curve(sl(SFX_SINE, 0, 140, 2, 590, 540, 0, 0, 0, 450), 3));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 45, 1, 0, 0, 2600, 900, 120, 700), 3));
  } else if id == BSFX_WITHY {  // stick and slip as the rod bends: dense clicks through a narrow band, a strained buzz
    s = sfx_add(s, sl_curve(sl(SFX_CRACKLE, 0, 420, 50, 180, 420, 2200, 1400, 600, 1000), 1));
    s = sfx_add(s, sl_vib(sl_curve(sl(SFX_SAW, 0, 420, 60, 240, 190, 1300, 900, 300, 300), 1), 40, 13));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 380, 80, 2, 0, 0, 3000, 1200, 500, 450), 3));
  } else if id == BSFX_STONE {  // a hard clack with a short ring, then the stone settling with a smaller one
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 40, 1, 0, 0, 7000, 2500, 1200, 1000), 3));
    s = sfx_add(s, sl_curve(sl(SFX_SINE, 0, 90, 1, 2300, 2050, 0, 0, 0, 380), 3));
    s = sfx_add(s, sl_curve(sl(SFX_SINE, 0, 120, 1, 380, 300, 0, 0, 0, 500), 3));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 85, 30, 1, 0, 0, 6000, 2500, 1500, 500), 3));
    s = sfx_add(s, sl_curve(sl(SFX_SINE, 85, 70, 1, 2700, 2500, 0, 0, 0, 200), 3));
  } else if id == BSFX_THATCH { // a soft swell of dry hiss with crisp ticks in it
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 560, 90, 0, 0, 5200, 2600, 1400, 1000), 1));
    s = sfx_add(s, sl_curve(sl(SFX_CRACKLE, 20, 520, 60, 90, 40, 7000, 4000, 1800, 550), 1));
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 300, 40, 0, 0, 900, 600, 250, 300), 2));
  } else if id == BSFX_EARTH {  // the blade's gritty cut, the soil's crunch, a dull thud under it
    s = sfx_add(s, sl_curve(sl(SFX_NOISE, 0, 360, 12, 0, 0, 1600, 420, 160, 1000), 2));
    s = sfx_add(s, sl_curve(sl(SFX_CRACKLE, 0, 320, 8, 520, 160, 3000, 1500, 400, 650), 2));
    s = sfx_add(s, sl_curve(sl(SFX_SINE, 0, 220, 4, 105, 58, 0, 0, 0, 800), 3));
  }
  return s;
}
// book:end build-recipes

// The scratch a render needs.
BSFX_MAX_FRAMES :: BSFX_MAX_MS * SFX_RATE / 1000;

// A build sound rendered as sfx.coax renders an Everglade effect: peaks to 0.8 of full scale
// through a soft saturation, so every effect leaves the synthesizer at one level.
bsfx_render :: (id: int, rate: int, mix: [] int, out: [] u8) -> SfxRender {
  r := SfxRender.{};
  if id < 0 || id >= BSFX_COUNT || rate < 8000 { return r; }
  s := bsfx_recipe(id);
  n := s.ms * rate / 1000;
  if n > mix.count || n < 1 || out.count < WAV_HEADER + 2 * n { return r; }
  m := mix[0..<n];
  for i: 0..<n { m[i] = 0; }
  for j: 0..<s.n { sfx_layer(s.layers[j], 70111 + id * 977 + j * 131, rate, m); }
  peak := 0;
  for i: 0..<n { peak = au_max(peak, au_abs(m[i])); }
  if peak > 0 {
    for i: 0..<n {
      v := au_saturate(m[i] * (AU_ONE * 9 / 10) / peak, 78643);
      m[i] = au_clamp(v * 4 / 5 / 2, -32768, 32767);
    }
  }
  b := wav_write(m[0..<n], 1, rate, out);
  if b < 0 { return r; }
  return SfxRender.{ok = true, frames = n, peak = peak, bytes = b};
}

#test "every build sound has a name and a recipe, fits the scratch, and is not an Everglade name" {
  for i: 0..<BSFX_COUNT {
    #assert bsfx_id(BSFX_NAMES[i]) == i && sfx_id(BSFX_NAMES[i]) == -1;
    s := bsfx_recipe(i);
    #assert s.n > 0 && s.ms > 0 && s.ms <= BSFX_MAX_MS && s.loop == 0;
  }
  #assert bsfx_id("nothing") == -1;
}

// The 16-bit sample k of a WAV's data.
bsfx_sample :: (a: [] u8, k: int) -> int {
  v := (cast(int) a[WAV_HEADER + 2 * k] | (cast(int) a[WAV_HEADER + 2 * k + 1] << 8));
  return ifx v >= 32768 then v - 65536 else v;
}
// How many times the samples a..b cross zero: a rough brightness.
bsfx_crossings :: (a: [] u8, from: int, to: int) -> int {
  n := 0; prev := bsfx_sample(a, from);
  for k: from + 1..<to { v := bsfx_sample(a, k); if (v >= 0) != (prev >= 0) { n += 1; } prev = v; }
  return n;
}

#test "a build sound renders loud WAV bytes, the same bytes each time" #steps 900000000 {
  mix: [BSFX_MAX_FRAMES] int; a: [WAV_HEADER + 2 * BSFX_MAX_FRAMES] u8; b: [WAV_HEADER + 2 * BSFX_MAX_FRAMES] u8;
  for id: 0..<BSFX_COUNT {
    r := bsfx_render(id, 8000, mix[..], a[..]);
    #assert r.ok && r.peak > 0 && r.bytes == WAV_HEADER + 2 * r.frames;
    loud := 0;
    for i: 0..<r.frames { loud = au_max(loud, au_abs(bsfx_sample(a[..], i))); }
    #assert loud > 20000 && loud <= 32767;
    q := bsfx_render(id, 8000, mix[..], b[..]);
    same := q.bytes == r.bytes;
    for i: 0..<r.bytes { if a[i] != b[i] { same = false; } }
    #assert same;
  }
  #assert !bsfx_render(BSFX_COUNT, SFX_RATE, mix[..], a[..]).ok && !bsfx_render(0, SFX_RATE, mix[0..<10], a[..]).ok;
}

#test "the materials sound apart, stone brighter than wood and a knock shorter than a rustle" #steps 900000000 {
  mix: [BSFX_MAX_FRAMES] int; a: [WAV_HEADER + 2 * BSFX_MAX_FRAMES] u8;
  w := bsfx_render(BSFX_WOOD, SFX_RATE, mix[..], a[..]); wood := bsfx_crossings(a[..], 0, SFX_RATE / 25);
  st := bsfx_render(BSFX_STONE, SFX_RATE, mix[..], a[..]); stone := bsfx_crossings(a[..], 0, SFX_RATE / 25);
  #assert stone > wood * 3;
  th := bsfx_render(BSFX_THATCH, SFX_RATE, mix[..], a[..]);
  #assert w.frames < th.frames && st.frames < th.frames;
}
