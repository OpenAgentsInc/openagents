#test "complete authored audio catalogue keeps its frozen content identity and exact lookup" #steps 40000000 {
 expected:=[32]u8.[200,25,94,13,132,216,134,219,177,47,95,21,214,39,15,155,252,193,251,228,226,86,206,190,156,55,16,6,64,90,253,53];#assert hpc_equal(hpc_everglade_fingerprint(),expected);
 for row:HPC_EVERGLADE_ASSETS {#assert hpc_everglade(row.name).name==row.name;}
 #assert !hpc_everglade("").valid&&!hpc_everglade("fire-hit-e2/").valid;
 #assert hpc_everglade("fire-hit-e2").canonical&&!hpc_everglade("fire-cast-e1").canonical;
 #assert !hpc_everglade_at(-1).valid&&!hpc_everglade_at(153).valid&&hpc_everglade_at(0).name=="fire-cast-e1"&&hpc_everglade_at(152).valid;
}
hpc_everglade :: (name:string)->HostAudioAsset #export_c #effects(all) {for row:HPC_EVERGLADE_ASSETS {if row.name==name {return row;}}return HostAudioAsset.{};}
hpc_everglade_at :: (id:int)->HostAudioAsset #export_c #effects(all) {if id<0||id>=153 {return HostAudioAsset.{};}return HPC_EVERGLADE_ASSETS[id];}
hpc_everglade_fingerprint :: ()->[32]u8 #effects(all) {buf:[131072]u8;o:[1]Jo;jo_start(o[..],buf[..]);jo_arr(o[..]);for row:HPC_EVERGLADE_ASSETS {jo_arr(o[..]);jo_bool(o[..],row.valid);jo_str(o[..],row.name);jo_str(o[..],row.source_url);jo_int(o[..],row.source_bytes);for hash:[2][32]u8.[row.source_sha,row.pcm_sha] {jo_arr(o[..]);for byte:hash {jo_int(o[..],int(byte));}jo_end(o[..]);}jo_int(o[..],row.frames);jo_int(o[..],row.channels);jo_bool(o[..],row.canonical);jo_str(o[..],row.companion_url);jo_int(o[..],row.companion_bytes);jo_end(o[..]);}jo_end(o[..]);return hpc_hash(buf[0..<o[0].n]);}
