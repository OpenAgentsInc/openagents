// Cinematic entry and hand-back (book chapter 78, GitHub #12994). A cinematic starts from the current
// live shot (its first frame is that shot exactly) and eases into its own track; when it ends it hands
// back by one explicit outcome: resume the saved follow orbit, reset behind the subject, or retain the
// orbit turned to look the way the track last looked. The hand-back eases from the track's last shot to
// the follow camera's, and its last frame is the follow camera's exactly. Cancelling jumps straight to
// the hand-back from where the camera is; a teleport or a lost target cuts to the follow camera with no
// blend (no sweep across the world). The camera reads finished poses only: nothing here steps actors or
// owns a clock; the realm passes its time.
//
//   coax/bin/coax test metaverse-engine/cam/handback.coax --library

#load "camera.coax";
#load "../core/points.coax";

CamOutcome :: enum u8 { resume; reset_behind; retain; }
CamCutPhase :: enum u8 { off; entering; playing; handing; done; }
CamCut :: struct {
  phase: CamCutPhase;
  outcome: CamOutcome;
  saved: Orbit;           // the follow orbit when the cinematic began
  entry: Shot;            // the live shot it began from
  last: Shot;             // the last shot it showed
  start: f32; enter: f32 = 0.6;   // seconds: when it began and how long it eases in
  hand_at: f32; hand: f32 = 1.5;  // when the hand-back began and how long it eases
  from: Shot;             // the shot the hand-back eases from
  cut: bool;              // the last hand-back was a cut (teleport, target lost)
}
// Begin a cinematic at now from the live shot and the follow orbit.
cam_cut_enter :: (live: Shot, o: Orbit, now: f32, enter: f32, outcome: CamOutcome) -> CamCut {
  c: CamCut; c.phase = CamCutPhase.entering; c.outcome = outcome; c.saved = o; c.entry = live; c.last = live; c.start = now; c.enter = enter;
  return c;
}
// The shot to show while it plays, from the track's shot this frame.
cam_cut_play :: (c: [] CamCut, track: Shot, now: f32) -> Shot {
  if c[0].phase == CamCutPhase.entering {
    u := ifx c[0].enter > 0 then (now - c[0].start) / c[0].enter else 1.0f32;
    if u >= 1 { c[0].phase = CamCutPhase.playing; c[0].last = track; return track; }
    s := metaverse_shot_mix(c[0].entry, track, ifx u < 0 then 0.0f32 else u);
    c[0].last = s; return s;
  }
  if c[0].phase == CamCutPhase.playing { c[0].last = track; return track; }
  return c[0].last;
}
// End it at now: the orbit the follow camera returns to by the outcome, and the hand-back begins from
// the last shot shown. heading is the subject's facing for reset_behind.
cam_cut_end :: (c: [] CamCut, live: Orbit, heading: f32, now: f32) -> Orbit {
  if c[0].phase != CamCutPhase.entering && c[0].phase != CamCutPhase.playing { return live; }
  c[0].phase = CamCutPhase.handing; c[0].hand_at = now; c[0].from = c[0].last; c[0].cut = false;
  o := live;
  if c[0].outcome == CamOutcome.resume { o = c[0].saved; o.pivot = live.pivot; o.shown = live.shown; }
  else if c[0].outcome == CamOutcome.reset_behind { o.yaw = wrap_angle(heading); o.pitch = c[0].saved.pitch; }
  else { o = metaverse_orbit_toward(live, c[0].last); }
  return o;
}
// Cancelled (a key, a click): the hand-back starts now from where the camera is.
cam_cut_cancel :: (c: [] CamCut, live: Orbit, heading: f32, now: f32) -> Orbit { return cam_cut_end(c, live, heading, now); }
// A teleport or a lost target: straight to the follow camera, no blend.
cam_cut_drop :: (c: [] CamCut) { if c[0].phase != CamCutPhase.off { c[0].phase = CamCutPhase.done; c[0].cut = true; } }
// The shot while handing back: from the track's last shot to the follow camera's chase, eased; the
// follow camera's own once done.
cam_cut_hand :: (c: [] CamCut, chase: Shot, now: f32) -> Shot {
  if c[0].phase == CamCutPhase.done || c[0].phase == CamCutPhase.off { return chase; }
  if c[0].phase != CamCutPhase.handing { return c[0].last; }
  u := ifx c[0].hand > 0 then (now - c[0].hand_at) / c[0].hand else 1.0f32;
  if u >= 1 { c[0].phase = CamCutPhase.done; return chase; }
  s := metaverse_shot_mix(c[0].from, chase, ifx u < 0 then 0.0f32 else u);
  c[0].last = s;
  return s;
}
// The same while the track's last framing still rides a moving subject: the hand-back eases from the
// track's shot this frame (not a frozen one, which would lag behind a subject still walking).
cam_cut_hand_on :: (c: [] CamCut, track: Shot, chase: Shot, now: f32) -> Shot {
  if c[0].phase == CamCutPhase.handing { c[0].from = track; }
  return cam_cut_hand(c, chase, now);
}
cam_cut_live :: (c: CamCut) -> bool { return c.phase == CamCutPhase.entering || c.phase == CamCutPhase.playing || c.phase == CamCutPhase.handing; }

// ---- checks
cam_test_near :: (a: Shot, b: Shot, e: f32) -> bool { return length(sub(a.eye, b.eye)) <= e && length(sub(a.at, b.at)) <= e; }

#test "entry starts on the live shot; the hand-back ends on the follow camera's, each frame a small step" {
  o := metaverse_orbit_start(v3(0, 0, 0), 0);
  live := Shot.{eye = v3(0, 2, -4), at = v3(0, 1.5, 1)};
  track := Shot.{eye = v3(5, 3, 0), at = v3(0, 1, 0)};
  c := [1] CamCut.[cam_cut_enter(live, o, 10, 0.6, CamOutcome.retain)];
  #assert cam_test_near(cam_cut_play(c[..], track, 10), live, 0.0001);   // the first frame is the live shot
  last := live;
  for k: 1..<60 { s := cam_cut_play(c[..], track, 10 + f32(k) / 60); #assert cam_test_near(s, last, 0.5); last = s; }
  #assert c[0].phase == CamCutPhase.playing && cam_test_near(cam_cut_play(c[..], track, 11.1), track, 0.0001);
  chase := Shot.{eye = v3(0, 2, -4.2), at = v3(0, 1.4, 1)};
  back := cam_cut_end(c[..], o, 0, 12);
  // retain: the orbit turned to look the way the track looked
  f := metaverse_orbit_forward(back);
  #assert f.x < -0.5;
  prev := cam_cut_hand(c[..], chase, 12);
  #assert cam_test_near(prev, track, 0.0001);   // its first frame is the track's last
  for k: 1..<100 { s := cam_cut_hand(c[..], chase, 12 + f32(k) / 60); #assert cam_test_near(s, prev, 0.5); prev = s; }
  #assert c[0].phase == CamCutPhase.done && cam_test_near(cam_cut_hand(c[..], chase, 14), chase, 0.0001);
  #assert !cam_cut_live(c[0]);
  // handing back from a track that still rides its subject: from that frame's track to the chase
  d := [1] CamCut.[cam_cut_enter(live, o, 0, 0, CamOutcome.retain)];
  _ := cam_cut_play(d[..], track, 0);
  _o := cam_cut_end(d[..], o, 0, 1);
  moved := Shot.{eye = v3(5, 3, 2), at = v3(0, 1, 2)};
  #assert cam_test_near(cam_cut_hand_on(d[..], moved, chase, 1), moved, 0.0001);
  #assert cam_test_near(cam_cut_hand_on(d[..], moved, chase, 2.5), chase, 0.0001) && d[0].phase == CamCutPhase.done;
}

#test "outcomes: resume the saved follow, reset behind the subject; cancel and drop" {
  o := metaverse_orbit_start(v3(0, 0, 0), 0.3); o.pitch = 0.5;
  track := Shot.{eye = v3(5, 3, 0), at = v3(0, 1, 0)};
  c := [1] CamCut.[cam_cut_enter(Shot.{eye = v3(0, 2, -4), at = v3(0, 1, 1)}, o, 0, 0.5, CamOutcome.resume)];
  _ := cam_cut_play(c[..], track, 1);
  moved := o; moved.yaw = 2; moved.pitch = 0.1; moved.pivot = v3(9, 1.6, 9);
  r := cam_cut_end(c[..], moved, 1.2, 2);
  #assert r.yaw == o.yaw && r.pitch == 0.5 && r.pivot.x == 9;
  c[0] = cam_cut_enter(Shot.{}, o, 0, 0.5, CamOutcome.reset_behind);
  r = cam_cut_end(c[..], moved, 1.2, 2);
  #assert abs(r.yaw - 1.2) < 0.0001 && r.pitch == 0.5;
  // cancel mid-entry: the hand-back starts from where it is
  c[0] = cam_cut_enter(Shot.{eye = v3(0, 2, -4), at = v3(0, 1, 1)}, o, 0, 1, CamOutcome.retain);
  mid := cam_cut_play(c[..], track, 0.5);
  ignored := cam_cut_cancel(c[..], o, 0, 0.5);
  #assert c[0].phase == CamCutPhase.handing && cam_test_near(cam_cut_hand(c[..], Shot.{}, 0.5), mid, 0.0001);
  // a teleport or a lost target: the follow camera at once, no blend
  cam_cut_drop(c[..]);
  chase := Shot.{eye = v3(100, 2, 100), at = v3(100, 2, 105)};
  #assert c[0].cut && cam_test_near(cam_cut_hand(c[..], chase, 0.6), chase, 0.0001);
  // ending something that isn't playing changes nothing
  idle: [1] CamCut;
  #assert cam_cut_end(idle[..], moved, 0, 1).yaw == moved.yaw && idle[0].phase == CamCutPhase.off;
}
