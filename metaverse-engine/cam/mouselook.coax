// Mouselook: the action-combat camera, as Neverwinter's. In a realm's world the mouse turns the camera
// with no button held; the hero runs where it looks (W toward the reticle, metaverse-engine/cam/reticle.coax,
// which is always shown while the mouse looks). The host holds the pointer (the browser's Pointer
// Lock, coax/web/host.js) and only forwards how far the mouse moved; every decision is here.
//
// Tab frees the cursor for the bar and the menus and takes it back; Alt frees it while held; Escape
// (the browser's own) frees it. A click on the world, or Tab, looks again. A browser that refuses the
// lock leaves the realm's click-drag orbit as it was, with nothing said. A finger never looks this
// way: a phone keeps its thumbs. A realm that is not in its world (a studio) sets `able` false.
//
// The host face (coax/web/host.js): coaxial_mouselook(state) -> ml_host; coaxial_look_delta(state,
// dx, dy) -> ml_turn (CSS pixels); coaxial_pointer_lock(state, status) -> ml_lock.
//   coax/bin/coax test metaverse-engine/cam/mouselook.coax --library
#module "aethyr.cam.mouselook";
#load "reticle.coax" as reticle;

ML_TURN :: 0.0024;     // radians the camera turns for a CSS pixel of the mouse (about 75 degrees for 550 px)
ML_FADE :: 0.25;       // seconds the reticle takes to come in or go
ML_KEY_TAB :: -15;     // host.js KEYS
ML_KEY_ALT :: -16;
ML_FREE :: 1;          // ml_host: the realm looks this way, the cursor is free now
ML_LOOK :: 2;          // ml_host: the realm wants the pointer held

Mouselook :: struct {
  able: bool;          // in the realm's world (not a studio, not a walk out of it): the mouse may look
  free: bool;          // the player freed the cursor (Tab, Escape); a click on the world or Tab ends it
  alt: bool;           // Alt held: free while it is
  locked: bool;        // the host holds the pointer: the mouse turns the camera
  refused: bool;       // the browser refused the lock: the drag orbits, as before, until a click asks again
  touch: bool;         // the last press was a finger's
  shown: f32;          // the reticle, 0 to 1
}

// The mouse turns the camera now.
ml_on :: (m: Mouselook) -> bool { return m.able && m.locked && !m.touch; }
ml_wants :: (m: Mouselook) -> bool { return m.able && !m.free && !m.alt && !m.refused && !m.touch; }
// What the host is told: 0 not here (the host does nothing), ML_FREE, or ML_LOOK (hold the pointer).
ml_host :: (m: Mouselook) -> int {
  if !m.able || m.touch { return 0; }
  return ifx ml_wants(m) then ML_LOOK else ML_FREE;
}
// A key down: Tab toggles, Alt frees while held. True when it was mouselook's.
ml_key :: (m: [] Mouselook, key: int) -> bool {
  if !m[0].able || m[0].touch { return false; }
  if key == ML_KEY_TAB {
    if ml_wants(m[0]) { m[0].free = true; } else { m[0].free = false; m[0].refused = false; m[0].alt = false; }
    return true;
  }
  if key == ML_KEY_ALT { m[0].alt = true; return true; }
  return false;
}
ml_key_up :: (m: [] Mouselook, key: int) -> bool {
  if key != ML_KEY_ALT || !m[0].alt { return false; }
  m[0].alt = false; return true;
}
// The page lost the keyboard: Alt is let go.
ml_blur :: (m: [] Mouselook) { m[0].alt = false; }
// The host's word: 1 the pointer is held, 0 it was let go, 2 the browser refused it.
ml_lock :: (m: [] Mouselook, status: int) {
  if status == 1 { m[0].locked = true; m[0].refused = false; return; }
  // let go while still wanted: the browser's Escape, which frees the cursor
  if status == 0 && m[0].locked && ml_wants(m[0]) { m[0].free = true; }
  if status == 2 { m[0].refused = true; }
  m[0].locked = false;
}
// A press the realm's UI didn't take, on the world: kind 0 a mouse, else a finger. A mouse's asks
// to look again (the host holds the pointer inside this press).
ml_press :: (m: [] Mouselook, kind: int) {
  m[0].touch = kind != 0;
  if kind == 0 && m[0].able { m[0].free = false; m[0].refused = false; }
}
// The mouse moved dx, dy CSS pixels while held: the camera's turn and tilt, radians (right and down
// positive). Zero unless the mouse is looking.
ml_turn :: (m: Mouselook, dx: f32, dy: f32) -> [2] f32 {
  if !ml_on(m) || !ml_finite(dx) || !ml_finite(dy) { return [2] f32.[0, 0]; }
  ex := ifx dx > 400 then 400.0f32 else ifx dx < -400 then -400.0f32 else dx;
  ey := ifx dy > 400 then 400.0f32 else ifx dy < -400 then -400.0f32 else dy;
  return [2] f32.[ex * f32(ML_TURN), ey * f32(ML_TURN)];
}
// The reticle's fade, a frame.
ml_step :: (m: [] Mouselook, dt: f32) {
  t := ifx ml_finite(dt) && dt > 0 then dt else 0.0f32;
  want := ifx ml_on(m[0]) then 1.0f32 else 0.0f32;
  d := t / f32(ML_FADE);
  if m[0].shown < want { m[0].shown = ifx m[0].shown + d > want then want else m[0].shown + d; }
  else { m[0].shown = ifx m[0].shown - d < want then want else m[0].shown - d; }
}
// A reticle stroke (metaverse-engine/cam/reticle.coax) over something the reticle covers: a little warmer and
// brighter, nothing more.
ml_tint :: (q: reticle.ReticleStroke, over: bool) -> reticle.ReticleStroke {
  if !over { return q; }
  t := q; t.r = 1; t.g = 0.62; t.b = 0.42; t.alpha = ifx q.alpha * 1.15 > 1 then 1.0f32 else q.alpha * 1.15; return t;
}
ml_finite :: (v: f32) -> bool { return v == v && v < 1e30 && v > -1e30; }

#test "in the world it wants the pointer; a held pointer turns the camera and brings in the reticle" {
  m: [1] Mouselook;
  #assert ml_host(m[0]) == 0;
  m[0].able = true;
  #assert ml_host(m[0]) == ML_LOOK && !ml_on(m[0]);
  t := ml_turn(m[0], 100, 0); #assert t[0] == 0;
  ml_lock(m[..], 1);
  t = ml_turn(m[0], 100, -50); #assert t[0] > 0.2 && t[0] < 0.3 && t[1] < 0;
  t = ml_turn(m[0], 9000, 0); #assert t[0] < 1;
  ml_step(m[..], 0.1); #assert m[0].shown > 0.3 && m[0].shown < 0.5;
  ml_step(m[..], 1); #assert m[0].shown == 1;
}
#test "Tab frees the cursor and takes it back; Alt frees it while held" {
  m: [1] Mouselook; m[0].able = true; ml_lock(m[..], 1);
  #assert ml_key(m[..], ML_KEY_TAB) && ml_host(m[0]) == ML_FREE;
  ml_lock(m[..], 0); #assert !ml_on(m[0]) && m[0].free;
  #assert ml_key(m[..], ML_KEY_TAB) && ml_host(m[0]) == ML_LOOK;
  ml_lock(m[..], 1);
  #assert ml_key(m[..], ML_KEY_ALT) && ml_host(m[0]) == ML_FREE;
  ml_lock(m[..], 0); #assert !m[0].free;   // let go for Alt, not Escape
  #assert ml_key_up(m[..], ML_KEY_ALT) && ml_host(m[0]) == ML_LOOK;
  #assert !ml_key_up(m[..], ML_KEY_ALT) && !ml_key(m[..], 'w');
}
#test "Escape frees it; a click on the world looks again; a refusal leaves the drag" {
  m: [1] Mouselook; m[0].able = true; ml_lock(m[..], 1);
  ml_lock(m[..], 0); #assert m[0].free && ml_host(m[0]) == ML_FREE;
  ml_press(m[..], 0); #assert ml_host(m[0]) == ML_LOOK;
  ml_lock(m[..], 2); #assert m[0].refused && ml_host(m[0]) == ML_FREE && !ml_on(m[0]);
  ml_press(m[..], 0); #assert ml_host(m[0]) == ML_LOOK;
}
#test "over something the reticle warms; otherwise it is as drawn" {
  st: [reticle.RETICLE_MAX] reticle.ReticleStroke;
  n := reticle.reticle_strokes(st[..], 10, 10, 1, 0.8, 0, 0);
  #assert n == 5 && ml_tint(st[0], false).g == st[0].g && ml_tint(st[0], true).g < st[0].g && ml_tint(st[0], true).alpha > st[0].alpha;
}
#test "a finger never looks this way, and a studio isn't asked" {
  m: [1] Mouselook; m[0].able = true; ml_lock(m[..], 1);
  ml_press(m[..], 1); #assert ml_host(m[0]) == 0 && !ml_on(m[0]) && !ml_key(m[..], ML_KEY_TAB);
  t := ml_turn(m[0], 50, 0); #assert t[0] == 0;
  ml_press(m[..], 0); #assert ml_on(m[0]);
  m[0].able = false; #assert ml_host(m[0]) == 0 && !ml_on(m[0]) && !ml_key(m[..], ML_KEY_TAB);
}
