// The overhead camera (GitHub #13087): a spectator's orbit over a board or a field, at a yaw and a
// pitch down, dist metres out from a pivot (px, pz) on the ground. The wheel and a pinch zoom it
// between a near and a far, and a drag pans it so the ground follows the pointer. Experimental's lab
// (fivelab.coax) wires it for its battle grid.
//
//   coax/bin/coax test metaverse-engine/cam/overhead.coax --library

CAM_OVERHEAD_PITCH :: 0.6;   // radians down its home view looks

// Its home view: yaw 0, CAM_OVERHEAD_PITCH down, dist out from (0, pz).
CamOverhead :: struct { yaw: f32; pitch: f32; dist: f32; px: f32; pz: f32; }
cam_overhead_home :: (dist: f32, pz: f32) -> CamOverhead { return CamOverhead.{yaw = 0, pitch = f32(CAM_OVERHEAD_PITCH), dist = dist, px = 0, pz = pz}; }
// Its distance times `by`, held between near and far.
cam_overhead_zoom :: (dist: f32, by: f32, near: f32, far: f32) -> f32 {
  d := dist * by; d = ifx d > near then d else near;
  return ifx far < d then far else d;
}
// A pan: the ground follows the pointer, dx right and dy down (device px), so the pivot (px, pz) moves
// the other way along the camera's level right (rx, rz) and forward (fx, fz), at the pivot's scale
// (dist over focal metres a pixel, foreshortened by the pitch along the view), held within hx and hz
// of the origin.
cam_overhead_pan :: (px: f32, pz: f32, dist: f32, focal: f32, pitch: f32, fx: f32, fz: f32, rx: f32, rz: f32, dx: f32, dy: f32, hx: f32, hz: f32) -> [2] f32 {
  m := dist / (ifx focal > 1 then focal else 1.0f32);   // metres per px at the pivot
  sp := sin(pitch); ahead := m / (ifx sp > 0.3 then sp else 0.3f32);   // the ground is foreshortened along the view
  ax := fx; az := fz; al := sqrt(ax * ax + az * az);
  if al > 0.0001 { ax /= al; az /= al; }
  x := px + (-rx * dx * m + ax * dy * ahead);
  z := pz + (-rz * dx * m + az * dy * ahead);
  x = ifx x > -hx then x else -hx; x = ifx hx < x then hx else x;
  z = ifx z > -hz then z else -hz; z = ifx hz < z then hz else z;
  return [2] f32.[x, z];
}

#test "the overhead camera zooms between near and far, and a pan moves the ground with the pointer" {
  h := cam_overhead_home(40, 0.6); #assert h.pitch == f32(CAM_OVERHEAD_PITCH) && h.dist == 40 && h.yaw == 0 && h.px == 0;
  #assert cam_overhead_zoom(40, 0.5, 6, 140) == 20 && cam_overhead_zoom(40, 0.01, 6, 140) == 6 && cam_overhead_zoom(40, 10, 6, 140) == 140;
  // looking north (forward +z), right +x: a drag right moves the pivot left (west), a drag down moves it north
  p := cam_overhead_pan(0, 0, 10, 100, 0.6, 0, 1, 1, 0, 50, 0, 20, 20); #assert p[0] < -4.9 && p[0] > -5.1 && p[1] == 0;
  q := cam_overhead_pan(0, 0, 10, 100, 0.6, 0, 1, 1, 0, 0, 50, 20, 20); #assert q[1] > 5 && q[0] == 0;
  r := cam_overhead_pan(0, 0, 1000, 100, 0.6, 0, 1, 1, 0, 50, 0, 20, 20); #assert r[0] == -20;
}
