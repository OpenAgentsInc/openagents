// Frame-rate parity for attention and the camera (GitHub #13026). One recorded input (a walk, a turn,
// a target that crosses your view, ducks behind a wall and comes back, and a switch press) is played
// through metaverse-engine/core/loop.coax's FrameClock at 30, 60 and 144 FPS and over uneven frames with a stall. The
// actor and attention step only on the paid fixed ticks; the camera reads the finished actor pose on
// each frame. The checks: attention's state and the actor's pose agree tick for tick at every frame
// rate, and evaluating the camera (cam_centred, its ground ring and its shot) leaves the actor
// simulation's digest exactly as it is without a camera.
//
//   coax/bin/coax test metaverse-engine/cam/parity.coax --library

#module "metaverse.engine.cam.parity";
#load "../core/loop.coax" as clock;
#load "attention.coax" as attn;
#load "modes.coax";

ParityActor :: struct { x: f32; z: f32; face: f32; vx: f32; vz: f32; }
ParityRun :: struct { ticks: int; digest: u64; attn_digest: u64; switched: int; hidden: int; frames: int; }
// The recorded input on tick t: walk ahead for two seconds, turn, then walk on; a switch press on tick 300.
parity_input :: (t: int) -> [3] f32 {
  turn := ifx t >= 128 && t < 192 then 1.5f32 else 0.0f32;
  return [3] f32.[0, ifx t < 384 then 1.0f32 else 0.0f32, turn];
}
parity_step :: (a: ParityActor, t: int) -> ParityActor {
  i := parity_input(t); out := a; dt := 1.0f32 / 64;
  out.face = a.face + i[2] * dt;
  out.vx = sin(out.face) * 3.5 * i[1]; out.vz = cos(out.face) * 3.5 * i[1];
  out.x = a.x + out.vx * dt; out.z = a.z + out.vz * dt;
  return out;
}
// Two targets: one that crosses ahead of you, one that stands still; the wall hides the first a while.
parity_targets :: (t: int, out: [] attn.AttnTarget) {
  u := f32(t) / 64;
  out[0] = attn.AttnTarget.{id = 1, gen = 1, caps = attn.ATTN_LOCK, at = world_point(-6 + u * 2.0, 1.6, 9)};
  out[1] = attn.AttnTarget.{id = 2, gen = 1, caps = attn.ATTN_LOCK, at = world_point(3, 1.6, 12)};
}
parity_mix :: (h: u64, v: u64) -> u64 { return (((h ^ v) & 4294967295) * 16777619) & 4294967295; }   // 32-bit FNV-1a
parity_bits :: (f: f32) -> u64 { return cast(u64) f32_bits(f); }
parity_actor_digest :: (h: u64, a: ParityActor) -> u64 {
  return parity_mix(parity_mix(parity_mix(parity_mix(parity_mix(h, parity_bits(a.x)), parity_bits(a.z)), parity_bits(a.face)), parity_bits(a.vx)), parity_bits(a.vz));
}
parity_attn_digest :: (h: u64, s: attn.AttnState) -> u64 {
  return parity_mix(parity_mix(parity_mix(parity_mix(h, cast(u64) (s.target + 1)), cast(u64) s.since), cast(u64) s.seen), cast(u64) cast(int) s.reason);
}
// Play the recording for ten seconds of frames: fps 0 is the uneven schedule (with a 100 ms stall).
// camera: evaluate the camera each frame on the finished pose.
parity_run :: (fps: int, camera: bool) -> ParityRun {
  out: ParityRun; c: clock.FrameClock; a: ParityActor; st: attn.AttnState;
  wall := [6] f32.[-3, 0, 6.5, -1, 3, 7];   // hides the crossing target from about 2.5 s to 3.5 s
  col: Colliders; col.ground = -10; col.boxes = wall[..];
  ts: [2] attn.AttnTarget;
  m: CamMode; g: [1] CamGround; none: [4] f32;
  o := metaverse_orbit_start(v3(0, 0, 0), 0.4);
  uneven := [6] int.[1000000, 23000000, 7000000, 48000000, 11000000, 100000000];   // the last a 100 ms stall, caught up in one frame
  h: u64 = 2166136261; ha: u64 = 2166136261;
  elapsed := 0; frame := 0; total := 10000000000;
  while elapsed < total {
    ns := ifx fps == 0 then uneven[frame % 6] else ((frame + 1) * 1000000000 / fps - frame * 1000000000 / fps);
    if elapsed + ns > total { ns = total - elapsed; }
    c = clock.loop_accept_ns(c, ns);
    for i: 0..<clock.loop_due(c) {
      t := c.ticks + i + 1;
      a = parity_step(a, t);
      parity_targets(t, ts[..]);
      q := attn.AttnQuery.{origin = world_point(a.x, 1.6, a.z), forward = world_point(sin(a.face), 0, cos(a.face)), retain_cos = -1};
      st = attn.attn_step(st, q, ts[..], col, t, t == 300, false);
      if st.reason == attn.AttnReason.switched { out.switched += 1; }
      if st.reason == attn.AttnReason.hidden { out.hidden += 1; }
      h = parity_actor_digest(h, a); ha = parity_attn_digest(ha, st);
    }
    c = clock.loop_ran(c);
    if camera {
      // the camera reads the finished pose: its ground ring, the centred follow and the shot
      feet := v3(a.x, 0, a.z);
      cam_test_fill(g[..], feet.x, feet.z, 0.05);
      o = metaverse_orbit_follow(o, feet, a.face, true, f32(f64(ns) / 1e9));
      k := cam_centred(m, g[..], o, none[0..<0]);
      o = metaverse_orbit_limit(o, k.room, f32(f64(ns) / 1e9));
      _ := cam_shot(m, o, k.eye_pitch, k.press);
    }
    elapsed += ns; frame += 1;
  }
  out.ticks = c.ticks; out.digest = h; out.attn_digest = ha; out.frames = frame;
  return out;
}

#test "attention and the actor agree tick for tick at 30, 60 and 144 FPS and over uneven frames and a stall" #steps 2000000000 {
  base := parity_run(60, false);
  #assert base.ticks == 640 && base.switched >= 1 && base.hidden >= 1;
  for fps: [4] int.[30, 60, 144, 0] {
    r := parity_run(fps, true);
    #assert r.ticks == base.ticks && r.digest == base.digest && r.attn_digest == base.attn_digest && r.switched == base.switched && r.hidden == base.hidden;
  }
}
#test "evaluating the camera leaves the actor simulation digest unchanged" #steps 2000000000 {
  for fps: [2] int.[144, 0] {
    without := parity_run(fps, false); with := parity_run(fps, true);
    #assert without.digest == with.digest && without.attn_digest == with.attn_digest && with.frames == without.frames;
  }
}
