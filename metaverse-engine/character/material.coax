// A character's material record (#13012; metaverse-engine/book/ch012-materials.md, "a material table in each
// realm ... a material ID per instance"). One record per surface, with defined defaults: an empty
// record is a matte cloth at roughness 0.8 with no maps, as OpenPBR's empty closure is its defaults.
// Every Quaternius part (Character Create, Everglade II's player and people, the Fantasy wardrobe)
// names its material by its colour layer, so a part's material ID is its layer: the table holds one
// record per colour layer of the pack. The table is admitted whole or refused before it is
// uploaded; a refused table draws every part with the defaults.
// Shading: metaverse-engine/render/character-material.coax. Data maps (normal, ORM) live in the pack's
// linear data layers (entry kind 6, catalog rows "D <index> <name> <licence>"), never sRGB-decoded.
//   coax/bin/coax test metaverse-engine/character/material.coax
#module "metaverse.engine.character.material";

CM_KIND_SKIN :: 0;
CM_KIND_CLOTH :: 1;
CM_KIND_HAIR :: 2;
CM_KIND_EYE :: 3;
CM_KIND_METAL :: 4;
CM_KINDS :: 5;
CM_NONE :: -1;          // no map
CM_MAX :: 128;          // records in one table: one per colour layer
CM_DATA_MAX :: 32;      // data layers a pack may carry
CM_FLOATS :: 12;        // a record on the GPU: three vec4s (cm_pack)
CharMaterial :: struct {
  kind: int = CM_KIND_CLOTH;
  r: f32 = 1; g: f32 = 1; b: f32 = 1;   // a linear multiplier on the base colour
  roughness: f32 = 0.8;   // without an ORM map; with one, the map's green
  metalness: f32 = 0;     // without an ORM map; with one, the map's blue (when orm_metal)
  normal: int = CM_NONE;  // the data layer of its tangent-space normal map
  orm: int = CM_NONE;     // the data layer of its occlusion (R), roughness (G), metalness (B)
  occlusion: bool = true; // whether the ORM map's red is occlusion (a roughness-only map's is not)
  orm_metal: bool = true; // whether the ORM map's blue is metalness (a roughness-only map's is not)
  strength: f32 = 1;      // the normal map's strength
  sheen: f32 = 0;         // film: cloth sheen, 0 to 1
  dye: bool = true;       // whether the record's dye masks apply (cloth); dyes are display space, see CA_DYES
}
CM_OK :: 0;
CM_KIND :: 1;        // a kind it doesn't know
CM_COLOUR :: 2;      // a multiplier channel outside 0 to 4, or NaN
CM_ROUGH :: 3;       // roughness outside 0 to 1, or NaN
CM_METAL :: 4;       // metalness outside 0 to 1, or NaN
CM_MAP :: 5;         // a map past the pack's data layers
CM_STRENGTH :: 6;    // a normal strength outside 0 to 2, or NaN
CM_SHEEN :: 7;       // a sheen outside 0 to 1, or NaN
CM_TABLE :: 8;       // no records, or more than CM_MAX
// Why one record can't be drawn with a pack of `data` data layers, or CM_OK.
cm_check :: (m: CharMaterial, data: int) -> int {
  if m.kind < 0 || m.kind >= CM_KINDS { return CM_KIND; }
  if !(m.r >= 0 && m.r <= 4 && m.g >= 0 && m.g <= 4 && m.b >= 0 && m.b <= 4) { return CM_COLOUR; }
  if !(m.roughness >= 0 && m.roughness <= 1) { return CM_ROUGH; }
  if !(m.metalness >= 0 && m.metalness <= 1) { return CM_METAL; }
  if m.normal < CM_NONE || m.normal >= data || m.orm < CM_NONE || m.orm >= data { return CM_MAP; }
  if !(m.strength >= 0 && m.strength <= 2) { return CM_STRENGTH; }
  if !(m.sheen >= 0 && m.sheen <= 1) { return CM_SHEEN; }
  return CM_OK;
}
CmRefusal :: struct { index: int = -1; reason: int = CM_OK; }
// A table, admitted whole or refused at its first bad record (index -1: the table itself).
cm_admit :: (table: [] CharMaterial, data: int) -> CmRefusal {
  if table.count == 0 || table.count > CM_MAX || data < 0 || data > CM_DATA_MAX { return CmRefusal.{reason = CM_TABLE}; }
  for i: 0..<table.count { why := cm_check(table[i], data); if why != CM_OK { return CmRefusal.{index = i, reason = why}; } }
  return CmRefusal.{};
}
// The defaults a kind starts from.
cm_kind :: (kind: int) -> CharMaterial {
  m: CharMaterial; m.kind = kind;
  if kind == CM_KIND_SKIN { m.roughness = 0.6; m.dye = false; m.occlusion = false; m.orm_metal = false; }
  if kind == CM_KIND_CLOTH { m.sheen = 0.5; }
  if kind == CM_KIND_HAIR { m.roughness = 0.6; m.dye = false; }
  if kind == CM_KIND_EYE { m.roughness = 0.55; m.dye = false; }
  if kind == CM_KIND_METAL { m.roughness = 0.5; m.metalness = 1; m.dye = false; }
  return m;
}
// One record as three vec4s: (r, g, b, kind), (roughness, metalness, normal, orm),
// (strength, sheen, dye, flags: 1 occlusion + 2 orm_metal). Maps are -1 for none.
cm_pack :: (m: CharMaterial, out: [] f32) {
  out[0] = m.r; out[1] = m.g; out[2] = m.b; out[3] = cast(f32) m.kind;
  out[4] = m.roughness; out[5] = m.metalness; out[6] = cast(f32) m.normal; out[7] = cast(f32) m.orm;
  out[8] = m.strength; out[9] = m.sheen; out[10] = ifx m.dye then 1.0f32 else 0.0f32; out[11] = (ifx m.occlusion then 1.0f32 else 0.0f32) + (ifx m.orm_metal then 2.0f32 else 0.0f32);
}

// ---- the table from a pack's catalog: its colour layers ("T i NAME lic") and data layers ("D i NAME lic")
cm_ends :: (s: string, tail: string) -> bool { return s.count >= tail.count && s[s.count - tail.count..<s.count] == tail; }
cm_starts :: (s: string, head: string) -> bool { return s.count >= head.count && s[0..<head.count] == head; }
cm_word_end :: (s: string, at: int) -> int { e := at; while e < s.count && s[e] != ' ' { e += 1; } return e; }
cm_whole :: (s: string) -> int {
  if s.count == 0 || s.count > 6 { return -1; }
  v := 0; for c: s { if c < '0' || c > '9' { return -1; } v = v * 10 + cast(int) (c - '0'); } return v;
}
CmRow :: struct { index: int = -1; name: string; }
// "X i NAME lic" -> (i, NAME), or index -1.
cm_row :: (row: string, tag: u8) -> CmRow {
  if row.count < 5 || row[0] != tag || row[1] != ' ' { return CmRow.{}; }
  e := cm_word_end(row, 2); i := cm_whole(row[2..<e]); if i < 0 || e + 1 >= row.count { return CmRow.{}; }
  ne := cm_word_end(row, e + 1); return CmRow.{index = i, name = row[e + 1..<ne]};
}
// The data layer called `name`, or CM_NONE.
cm_data :: (t: string, name: string) -> int {
  at := 0;
  while at < t.count { e := at; while e < t.count && t[e] != '\n' { e += 1; } r := cm_row(t[at..<e], 'D'); at = e + 1;
    if r.index >= 0 && r.name == name { return r.index; } }
  return CM_NONE;
}
CM_FAMILIES :: [5] string.["Knight", "Noble", "Peasant", "Ranger", "Wizard"];
// The record for the colour layer called `name`, from the data layers in catalog `t`: the five
// Fantasy families' cloth and armour (their T_<Family>_Normal and _ORM), the base bodies' skin
// (T_Regular_<Body>_Normal and _Roughness, a roughness-only map), hair, eyes, and the rest cloth.
cm_for_layer :: (t: string, name: string) -> CharMaterial {
  if cm_starts(name, "T_Regular_Female") || cm_starts(name, "T_Regular_Male") {
    m := cm_kind(CM_KIND_SKIN); body := ifx cm_starts(name, "T_Regular_Female") then "Female" else "Male";
    nb: [64] u8; ob: [64] u8;
    m.normal = cm_data(t, cm_join(nb[..], "T_Regular_", body, "_Normal"));
    m.orm = cm_data(t, cm_join(ob[..], "T_Regular_", body, "_Roughness"));
    return m;
  }
  if cm_starts(name, "T_Superhero_") { return cm_kind(CM_KIND_SKIN); }
  if cm_starts(name, "T_Hair_") { return cm_kind(CM_KIND_HAIR); }
  if cm_starts(name, "T_Eye_") { return cm_kind(CM_KIND_EYE); }
  for f: CM_FAMILIES {
    if cm_starts(name, "T_") && cm_starts(name[2..<name.count], f) && cm_ends(name, "_BaseColor.png") {
      m := cm_kind(CM_KIND_CLOTH);   // its ORM map says which texels are metal (the Knight's armour)
      nb: [64] u8; ob: [64] u8;
      m.normal = cm_data(t, cm_join(nb[..], "T_", f, "_Normal"));
      m.orm = cm_data(t, cm_join(ob[..], "T_", f, "_ORM"));
      return m;
    }
  }
  return cm_kind(CM_KIND_CLOTH);
}
cm_join :: (b: [] u8, x: string, y: string, z: string) -> string {
  n := 0; for c: x { if n < b.count { b[n] = c; n += 1; } } for c: y { if n < b.count { b[n] = c; n += 1; } } for c: z { if n < b.count { b[n] = c; n += 1; } }
  return cast(string) b[0..<n];
}
// The pack's data layers: the count of D rows, or -1 when their indices aren't 0, 1, 2... in order.
cm_data_count :: (t: string) -> int {
  n := 0; at := 0;
  while at < t.count { e := at; while e < t.count && t[e] != '\n' { e += 1; } r := cm_row(t[at..<e], 'D'); at = e + 1;
    if r.index >= 0 { if r.index != n { return -1; } n += 1; } }
  return n;
}
// Fill `table` (one record per colour layer) from catalog t and pack it into `out` (CM_FLOATS a
// record). Returns the records written, or 0 when the table is refused: then every record is the
// default and maps are off, so a pack without data layers, or a bad one, draws as before maps.
cm_table :: (t: string, table: [] CharMaterial, out: [] f32) -> int {
  data := cm_data_count(t); n := 0; at := 0;
  for i: 0..<table.count { table[i] = CharMaterial.{}; }
  while at < t.count { e := at; while e < t.count && t[e] != '\n' { e += 1; } r := cm_row(t[at..<e], 'T'); at = e + 1;
    if r.index >= 0 && r.index < table.count { table[r.index] = cm_for_layer(t, r.name); if r.index + 1 > n { n = r.index + 1; } } }
  ok := data >= 0 && n > 0 && cm_admit(table[0..<n], data).reason == CM_OK && out.count >= n * CM_FLOATS;
  if !ok { for i: 0..<table.count { table[i] = CharMaterial.{}; } }
  for i: 0..<table.count { if (i + 1) * CM_FLOATS <= out.count { cm_pack(table[i], out[i * CM_FLOATS..<(i + 1) * CM_FLOATS]); } }
  return ifx ok then n else 0;
}

#test "an empty record is the defined defaults: matte cloth, no maps, dyed" {
  m: CharMaterial;
  #assert m.kind == CM_KIND_CLOTH && m.roughness == 0.8 && m.metalness == 0 && m.normal == CM_NONE && m.orm == CM_NONE && m.dye && m.strength == 1;
  #assert cm_check(m, 0) == CM_OK;
  for k: 0..<CM_KINDS { #assert cm_check(cm_kind(k), 0) == CM_OK && cm_kind(k).kind == k; }
  #assert !cm_kind(CM_KIND_SKIN).dye && !cm_kind(CM_KIND_SKIN).occlusion && !cm_kind(CM_KIND_SKIN).orm_metal && cm_kind(CM_KIND_METAL).metalness == 1 && m.orm_metal && m.occlusion;
}
#test "admission refuses each bad field, NaNs included, and a bad table whole" {
  nan := 0.0f32; nan = nan / nan; m: CharMaterial;
  b := m; b.kind = 5; #assert cm_check(b, 4) == CM_KIND; b.kind = -1; #assert cm_check(b, 4) == CM_KIND;
  b = m; b.g = 4.5; #assert cm_check(b, 4) == CM_COLOUR; b.g = nan; #assert cm_check(b, 4) == CM_COLOUR; b.g = -0.1; #assert cm_check(b, 4) == CM_COLOUR;
  b = m; b.roughness = 1.01; #assert cm_check(b, 4) == CM_ROUGH; b.roughness = nan; #assert cm_check(b, 4) == CM_ROUGH;
  b = m; b.metalness = -0.01; #assert cm_check(b, 4) == CM_METAL; b.metalness = nan; #assert cm_check(b, 4) == CM_METAL;
  b = m; b.normal = 4; #assert cm_check(b, 4) == CM_MAP; b.normal = 3; #assert cm_check(b, 4) == CM_OK; b.orm = -2; #assert cm_check(b, 4) == CM_MAP;
  b = m; b.strength = 2.5; #assert cm_check(b, 4) == CM_STRENGTH; b.strength = nan; #assert cm_check(b, 4) == CM_STRENGTH;
  b = m; b.sheen = 1.5; #assert cm_check(b, 4) == CM_SHEEN; b.sheen = nan; #assert cm_check(b, 4) == CM_SHEEN;
  t: [3] CharMaterial; t[2].normal = 7;
  r := cm_admit(t[..], 4); #assert r.index == 2 && r.reason == CM_MAP;
  t[2].normal = 1; r = cm_admit(t[..], 4); #assert r.index == -1 && r.reason == CM_OK;
  #assert cm_admit(t[0..<0], 4).reason == CM_TABLE && cm_admit(t[..], CM_DATA_MAX + 1).reason == CM_TABLE;
}
CM_TEST_CATALOG :: "L 6 x\nT 0 T_Regular_Male_Dark_BaseColor.png 4\nT 1 T_Knight_2_BaseColor.png 6\nT 2 T_Hair_1_BaseColor.png 4\nT 3 T_Eye_Brown.png 4\nT 4 T_Wizard_BaseColor.png 6\nT 5 glade/0 250\nC fantasy/x 0 3 4 0 3 65\nD 0 T_Knight_Normal 6\nD 1 T_Knight_ORM 6\nD 2 T_Regular_Male_Normal 6\nD 3 T_Regular_Male_Roughness 6\n";
#test "the table names each colour layer's material and its maps from the catalog" {
  t: [8] CharMaterial; out: [8 * CM_FLOATS] f32;
  #assert cm_data_count(CM_TEST_CATALOG) == 4 && cm_data(CM_TEST_CATALOG, "T_Knight_ORM") == 1 && cm_data(CM_TEST_CATALOG, "T_Wizard_ORM") == CM_NONE;
  #assert cm_table(CM_TEST_CATALOG, t[..], out[..]) == 6;
  #assert t[0].kind == CM_KIND_SKIN && t[0].normal == 2 && t[0].orm == 3 && !t[0].occlusion && !t[0].orm_metal && t[0].metalness == 0;
  #assert t[1].kind == CM_KIND_CLOTH && t[1].normal == 0 && t[1].orm == 1 && t[1].metalness == 0 && t[1].orm_metal;
  #assert t[2].kind == CM_KIND_HAIR && t[3].kind == CM_KIND_EYE;
  // a family without maps in this pack keeps the defaults
  #assert t[4].normal == CM_NONE && t[4].orm == CM_NONE && t[4].metalness == 0;
  #assert t[5].kind == CM_KIND_CLOTH && t[5].normal == CM_NONE;
  // packed: kind in the first vec4's w, maps in the second's z and w
  #assert out[1 * CM_FLOATS + 3] == 1 && out[1 * CM_FLOATS + 6] == 0 && out[1 * CM_FLOATS + 7] == 1 && out[0 * CM_FLOATS + 11] == 0 && out[1 * CM_FLOATS + 11] == 3 && out[4 * CM_FLOATS + 6] == -1;
}
#test "a catalog with out-of-order data rows is refused and draws the defaults" {
  t: [8] CharMaterial; out: [8 * CM_FLOATS] f32;
  #assert cm_table("T 0 T_Knight_BaseColor.png 6\nD 1 T_Knight_Normal 6\n", t[..], out[..]) == 0;
  #assert t[0].normal == CM_NONE && out[6] == -1 && out[7] == -1;
  // no data rows at all: the records still name kinds, with no maps
  #assert cm_table("T 0 T_Knight_BaseColor.png 6\nT 1 T_Eye_Brown.png 4\n", t[..], out[..]) == 2 && t[0].orm == CM_NONE && t[1].kind == CM_KIND_EYE && t[0].metalness == 0;
  #assert cm_row("T x name 4", 'T').index == -1 && cm_row("D 12 name 4", 'D').index == 12 && cm_row("D 12", 'D').index == -1;
}
