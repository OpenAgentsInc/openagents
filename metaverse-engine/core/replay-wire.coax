// Portable accepted-event record v1. It is a completed simulation trace,
// not a native memory dump, checkpoint, authorization token or signature.
#module "aethyr.replay_wire";
#load "replay.coax";
#load "../../coax/lib/crypto/sha256.coax";
#authority;
ARC_EVENTS :: 4096;
ARC_MARKS :: 65536;
ARC_HEADER :: 48;
ARC_EVENT :: 112;
ArcRead :: struct {ok:bool;profile:int;initial:int;seed:int;events:int;marks:int;count:int;}

#test "portable record has fixed little-endian words and admits signed payload bits" {
  b:[1]ReplayBacking;session:=replay_backing(b[..]);replay_record(session,-1,-9223372036854775808);
  session.events[0]=ReplayEvent.{source=2,request=1,words=[10]int.[-1,0,1,2,3,4,5,6,7,9223372036854775807]};
  session.n[REPLAY_EVENTS]=1;replay_stepped(session,123);
  bytes:[200]u8;bytes[199]=165;n:=arc_encode(session,7,bytes[..],false);
  #assert n==200 && bytes[0]=='A' && bytes[7]=='1' && bytes[8]==7;
  for i:16..<24 {#assert bytes[i]==255;}
  #assert bytes[24]==0 && bytes[31]==128 && bytes[32]==1 && bytes[40]==1;
  for i:80..<88 {#assert bytes[i]==255;}
  read:=arc_read(bytes[..],7);#assert read.ok && read.initial==-1 && read.seed==-9223372036854775808 && read.events==1 && read.marks==1 && read.count==200;
  other:[1]ReplayBacking;target:=replay_backing(other[..]);
  #assert arc_decode(bytes[..],7,target,false);
  #assert target.events[0].words[0]==-1 && target.events[0].words[9]==9223372036854775807;
  #assert replay_digest(target)==replay_digest(session);
  for i:0..<200 {changed:=bytes;changed[i]^=1;#assert !arc_read(changed[..],7).ok;}
  #assert !arc_read(bytes[..],8).ok && !arc_decode(bytes[..],7,target,true);
  for size:0..<200 {#assert !arc_read(bytes[0..<size],7).ok;}
}
#test "invalid extents and event order refuse before output changes" {
  b:[1]ReplayBacking;s:=replay_backing(b[..]);replay_record(s,1,2);out:[512]u8;out[0]=165;
  #assert arc_encode(s,0,out[..],true)==0 && out[0]==165;
  #assert arc_encode(s,-1,out[..],false)==0 && out[0]==165;
  s.n[REPLAY_EVENTS]=-1;#assert arc_encode(s,1,out[..],false)==0 && out[0]==165;
  s.n[REPLAY_EVENTS]=0;s.n[REPLAY_MARKS]=ARC_MARKS+1;#assert arc_encode(s,1,out[..],false)==0;
  s.n[REPLAY_MARKS]=0;#assert arc_encode(s,1,out[0..<79],false)==0;
  #assert arc_encode(s,1,out[0..<80],false)==80;
  tiny:=s;tiny.n=s.n[0..<15];#assert arc_encode(tiny,1,out[..],false)==0;
  tiny=s;tiny.channels=s.channels[0..<2];#assert arc_encode(tiny,1,out[..],false)==0;
  s.n[REPLAY_EVENTS]=2;s.n[REPLAY_MARKS]=2;
  s.events[0]=ReplayEvent.{tick=1,source=0,request=1};s.events[1]=ReplayEvent.{tick=0,source=0,request=2};
  #assert arc_encode(s,1,out[..],false)==0;
}
#forall "event metadata agrees with the completed-trace admission table" tick:-1..<4,previous:0..<3,marks:0..<4,source:-1..<4,request:0..<2,epoch:-1..<2 {
  e:=ReplayEvent.{tick=tick,source=source,request=request,epoch=epoch};
  expected:=tick>=previous && tick<=marks-1 && source>=0 && source<=2 && request==1 && epoch>=0;
  #assert arc_event_ok(e,previous,marks)==expected;
}
#test "size limits are checked without allocating their largest traces" {
  #assert arc_size(4096,65536)==983120;
  #assert arc_size(4097,0)==0 && arc_size(0,65537)==0;
  #assert arc_size(-1,0)==0 && arc_size(0,-1)==0;
  #assert arc_size(0,0)==80;
}
#test "empty profile zero and multiple events use exact capacities and independent offsets" {
  b:[1]ReplayBacking;s:=replay_backing(b[..]);replay_record(s,17,23);
  bytes:[512]u8;for i:0..<bytes.count {bytes[i]=165;}
  #assert arc_encode(s,0,bytes[..],false)==80 && arc_read(bytes[0..<80],0).ok;
  target:[1]ReplayBacking;t:=replay_backing(target[..]);
  #assert arc_decode(bytes[0..<80],0,t,false) && t.n[REPLAY_INITIAL]==17;
  for i:0..<3 {
    e:=ReplayEvent.{tick=i+1,source=i,request=i+2,epoch=i+9};
    for k:0..<10 {e.words[k]=(i+1)*100+k;}
    s.events[i]=e;
  }
  for mark:[4]int.[77,88,99,111] {replay_stepped(s,mark);}
  s.n[REPLAY_EVENTS]=3;s.events=s.events[0..<3];s.marks=s.marks[0..<4];
  n:=arc_encode(s,0,bytes[0..<448],false);#assert n==448 && bytes[448]==165;
  #assert bytes[48]==1 && bytes[72]==9 && bytes[160]==2 && bytes[184]==10 && bytes[272]==3 && bytes[296]==11;
  #assert bytes[384]==77 && bytes[392]==88 && bytes[400]==99 && bytes[408]==111;
  t.events=t.events[0..<3];t.marks=t.marks[0..<4];
  #assert arc_decode(bytes[0..<n],0,t,false) && replay_digest(t)==replay_digest(s);
  for i:0..<3 {
    #assert t.events[i].tick==i+1 && t.events[i].source==i && t.events[i].epoch==i+9 && t.events[i].request==i+2;
    for k:0..<10 {#assert t.events[i].words[k]==(i+1)*100+k;}
  }
  smaller:=t;smaller.events=t.events[0..<2];#assert !arc_decode(bytes[0..<n],0,smaller,false);
  smaller=t;smaller.marks=t.marks[0..<3];#assert !arc_decode(bytes[0..<n],0,smaller,false);
  smaller=t;smaller.n=t.n[0..<15];#assert !arc_decode(bytes[0..<n],0,smaller,false);
  smaller=t;smaller.channels=t.channels[0..<2];#assert !arc_decode(bytes[0..<n],0,smaller,false);
  smaller=s;smaller.events=s.events[0..<2];#assert arc_encode(smaller,0,bytes[..],false)==0;
  smaller=s;smaller.marks=s.marks[0..<3];#assert arc_encode(smaller,0,bytes[..],false)==0;
  #assert !arc_decode(bytes[0..<n],-1,t,false) && !arc_read(bytes[0..<n+1],0).ok;
  // Reseal malformed fields so refusal cannot rely only on the checksum.
  for field:0..<6 {
    bad:=bytes;
    if field==0 {arc_word(bad[..],32,4097);}
    if field==1 {arc_word(bad[..],48,-1);}
    if field==2 {arc_word(bad[..],48+8,3);}
    if field==3 {arc_word(bad[..],48+16,0);}
    if field==4 {arc_word(bad[..],48+24,-1);}
    if field==5 {arc_word(bad[..],160,0);}
    arc_seal(bad[..],n);before:=t.n[REPLAY_INITIAL];
    #assert !arc_read(bad[0..<n],0).ok && !arc_decode(bad[0..<n],0,t,false);
    #assert t.n[REPLAY_INITIAL]==before && t.events[2].words[9]==309;
  }
}

arc_word :: (out:[]u8,at:int,value:int) #effects(all) {
  bits:=cast,trunc(u64)value;
  for i:0..<8 {out[at+i]=cast,trunc(u8)(bits>>(i*8));}
}
arc_value :: (bytes:[]u8,at:int)->int #effects(all) {
  bits:u64;for i:0..<8 {bits|=cast(u64)bytes[at+i]<<(i*8);}return cast,trunc(int)bits;
}
arc_size :: (events:int,marks:int)->int #effects(all) {
  if events<0 || events>ARC_EVENTS || marks<0 || marks>ARC_MARKS {return 0;}
  return ARC_HEADER+events*ARC_EVENT+marks*8+32;
}
arc_event_ok :: (e:ReplayEvent,previous:int,marks:int)->bool #effects(all) {
  return e.tick>=previous && e.tick<marks && e.source>=0 && e.source<REPLAY_SOURCES && e.request>=1 && e.epoch>=0;
}
arc_event :: (bytes:[]u8,at:int)->ReplayEvent #effects(all) {
  e:=ReplayEvent.{tick=arc_value(bytes,at),source=arc_value(bytes,at+8),request=arc_value(bytes,at+16),epoch=arc_value(bytes,at+24)};
  for i:0..<10 {e.words[i]=arc_value(bytes,at+32+i*8);}return e;
}
arc_seal :: (out:[]u8,count:int) #effects(all) {
  digest:[32]u8;#assert sha256_hash_checked(out[0..<count-32],digest[..],false)==SHA_OK;
  for byte,i:digest {out[count-32+i]=byte;}
}
arc_encode :: (s:ReplaySession,profile:int,out:[]u8,overlap:bool)->int #effects(all) {
  if overlap || profile<0 || s.n.count<REPLAY_COUNTERS || s.channels.count<REPLAY_SOURCES {return 0;}
  ne:=s.n[REPLAY_EVENTS];nm:=s.n[REPLAY_MARKS];count:=arc_size(ne,nm);
  if count==0 || out.count<count || s.events.count<ne || s.marks.count<nm {return 0;}
  previous:=0;
  for i:0..<ne {if !arc_event_ok(s.events[i],previous,nm) {return 0;}previous=s.events[i].tick;}
  magic:="AETHYR01";for byte,i:magic {out[i]=byte;}
  arc_word(out,8,profile);arc_word(out,16,s.n[REPLAY_INITIAL]);arc_word(out,24,s.n[REPLAY_SEED]);arc_word(out,32,ne);arc_word(out,40,nm);
  for i:0..<ne {
    e:=s.events[i];at:=ARC_HEADER+i*ARC_EVENT;
    arc_word(out,at,e.tick);arc_word(out,at+8,e.source);arc_word(out,at+16,e.request);arc_word(out,at+24,e.epoch);
    for k:0..<10 {arc_word(out,at+32+k*8,e.words[k]);}
  }
  for i:0..<nm {arc_word(out,ARC_HEADER+ne*ARC_EVENT+i*8,s.marks[i]);}
  arc_seal(out,count);return count;
}
arc_read :: (bytes:[]u8,profile:int)->ArcRead #effects(all) {
  r:ArcRead;
  if profile<0 || bytes.count<80 || cast(string)bytes[0..<8]!="AETHYR01" || arc_value(bytes,8)!=profile {return r;}
  ne:=arc_value(bytes,32);nm:=arc_value(bytes,40);count:=arc_size(ne,nm);
  if count!=bytes.count {return r;}
  digest:[32]u8;#assert sha256_hash_checked(bytes[0..<count-32],digest[..],false)==SHA_OK;
  for byte,i:digest {if byte!=bytes[count-32+i] {return r;}}
  previous:=0;
  for i:0..<ne {e:=arc_event(bytes,ARC_HEADER+i*ARC_EVENT);if !arc_event_ok(e,previous,nm) {return r;}previous=e.tick;}
  return ArcRead.{ok=true,profile=profile,initial=arc_value(bytes,16),seed=arc_value(bytes,24),events=ne,marks=nm,count=count};
}
// overlap covers the input and every destination region, and pairwise
// overlap of destination regions. Failure leaves all destination bytes alone.
arc_decode :: (bytes:[]u8,profile:int,s:ReplaySession,overlap:bool)->bool #effects(all) {
  if overlap || s.n.count<REPLAY_COUNTERS || s.channels.count<REPLAY_SOURCES {return false;}
  r:=arc_read(bytes,profile);
  if !r.ok || s.events.count<r.events || s.marks.count<r.marks {return false;}
  replay_record(s,r.initial,r.seed);
  for i:0..<r.events {s.events[i]=arc_event(bytes,ARC_HEADER+i*ARC_EVENT);}
  for i:0..<r.marks {replay_stepped(s,arc_value(bytes,ARC_HEADER+r.events*ARC_EVENT+i*8));}
  s.n[REPLAY_EVENTS]=r.events;return true;
}
