// The Metaverse Engine's World (GitHub #13274, the AAA audit's G6): one place a realm's entities live, on the
// client, in the room and in the offline worker. It is four parts.
//
//   The entity store    metaverse-engine/core/entity.coax: handles, EntityIds, spawns and despawns at the flush.
//   Component columns   fixed structure-of-arrays columns keyed by slot: a transform, a body, health,
//                       a kind and a replication row. A slot's `has` bits say which it carries.
//   The system list     systems in one order, each with the components it reads and writes. A step
//                       runs every system in that order, and a system's access to a column it did
//                       not declare is refused and counted.
//   A spatial index     metaverse-engine/core/spatial.coax: the slots near a point, without a scan.
//
// A World is bounded and deterministic. Its caps are the lengths of the realm's own storage, taken
// whole or refused (world_init); a step allocates nothing; and world_digest is one number for the
// whole state, so a replay (chapter 5) compares it a step at a time. Coax has no procedure values,
// so the list holds each system's id and declarations and the realm calls its own procedures
// between world_system_begin and world_system_end; the World refuses a system out of its order.
//
// Outside a step the realm owns the columns: it fills a spawn's slot, reads rows for replication,
// loads a save. Inside a step every access goes through the running system's declarations.
// Archetypes are not needed: a realm adds its own columns beside these, one element a slot.
//   coax/bin/coax test metaverse-engine/core/world.coax
//   coax/bin/coax mutate metaverse-engine/core/world.coax --root-only

#module "metaverse.engine.world";
#authority;
#load "entity.coax";
#load "spatial.coax";

// book:begin columns
// The components, a bit each.
WORLD_TRANSFORM :: 1;   // where it stands and faces: WF_X WF_Y WF_Z WF_YAW
WORLD_BODY :: 2;        // how it moves and how big it is: WF_VX WF_VY WF_VZ WF_RADIUS WF_HEIGHT
WORLD_HEALTH :: 4;      // WI_HP WI_HP_MAX
WORLD_KIND :: 8;        // what it is, the realm's number: WI_KIND
WORLD_ROW :: 16;        // its replication row in the realm's table: WI_ROW
WORLD_COMPONENTS :: 5;
WORLD_ALL :: 31;

// The f32 columns and the int columns: column c's element for slot i is f[c * cap + i].
WF_X :: 0; WF_Y :: 1; WF_Z :: 2; WF_YAW :: 3;
WF_VX :: 4; WF_VY :: 5; WF_VZ :: 6; WF_RADIUS :: 7; WF_HEIGHT :: 8;
WORLD_F :: 9;
WI_HP :: 0; WI_HP_MAX :: 1; WI_KIND :: 2; WI_ROW :: 3;
WORLD_I :: 4;

// The component an f32 column belongs to, and an int column's.
world_f_component :: (col: int) -> int #effects(all) { return ifx col <= WF_YAW then WORLD_TRANSFORM else WORLD_BODY; }
world_i_component :: (col: int) -> int #effects(all) {
  if col <= WI_HP_MAX { return WORLD_HEALTH; }
  return ifx col == WI_KIND then WORLD_KIND else WORLD_ROW;
}
// book:end columns

// book:begin world
// The World's counters, at these places in `n` (WORLD_COUNTERS of them).
WORLD_READY :: 0;        // 1 once world_init took the storage
WORLD_TICK :: 1;         // steps run
WORLD_SYSTEMS :: 2;      // systems in the list
WORLD_STEPPING :: 3;     // 1 inside a step
WORLD_NEXT :: 4;         // the place in the list of the system due next this step
WORLD_RUNNING :: 5;      // the running system's place in the list, plus one (0 none)
WORLD_VIOLATIONS :: 6;   // accesses refused: a column the running system did not declare, or no system running in a step
WORLD_FIRST :: 7;        // the first violation's system id (0: no system was running)
WORLD_FIRST_WHAT :: 8;   // and what it asked for: the component, plus WORLD_WROTE for a write
WORLD_SKIPPED :: 9;      // systems begun out of order, and steps ended before every system ran
WORLD_AUDIT :: 10;       // 1: each system's undeclared columns are compared before and after it (world_audit)
WORLD_AUDITED :: 11;     // undeclared changes the audit found
WORLD_SEEN_HIGH :: 12;   // the slots ever used when the running system began: what its audit covers
WORLD_COUNTERS :: 13;
WORLD_WROTE :: 256;

World :: struct {
  ents: EntityStore;                 // who is here (metaverse-engine/core/entity.coax)
  has: [] int;                       // each slot's components, a bit each
  f: [] f32;                         // the f32 columns, WORLD_F of them, one after another
  i: [] int;                         // the int columns, WORLD_I of them
  grid: SpatialGrid;                 // where each slot with a transform stood at the last step's end
  sys_id: [] int;                    // the system list, in order: each system's id (1 or more),
  sys_reads: [] int; sys_writes: [] int;   // the components it reads, and those it writes
  seen: [] int;                      // the audit's digest of each component before the running system
  n: [] int;                         // the counters
}
world_cap :: (w: World) -> int #effects(all) { return w.ents.gen.count; }

// Whether the views make a World: one element a slot in every slot view, whole columns, a grid over
// the same slots, room for a system and for the counters.
world_shaped :: (w: World) -> bool #effects(all) {
  cap := world_cap(w);   // 1 or more: a grid has a slot
  e := w.ents;
  if e.live.count != cap || e.born.count != cap || e.doomed.count != cap || e.ids.count != cap || e.free.count != cap || e.spawns.count != cap || e.n.count < ENTITY_COUNTERS { return false; }
  if w.has.count != cap || w.f.count != WORLD_F * cap || w.i.count != WORLD_I * cap { return false; }
  if !spatial_shaped(w.grid) || w.grid.at.count != cap { return false; }
  if w.sys_id.count < 1 || w.sys_reads.count != w.sys_id.count || w.sys_writes.count != w.sys_id.count { return false; }
  return w.seen.count >= WORLD_COMPONENTS && w.n.count >= WORLD_COUNTERS;
}
// An empty World over the realm's storage, its index in cells `cell` metres a side: no entities,
// no systems, tick 0. False, and nothing changed, for storage that is not a World's.
world_init :: (w: World, cell: f32) -> bool #effects(all) {
  if !world_shaped(w) { return false; }
  entity_clear(w.ents);
  for k: 0..<w.has.count { w.has[k] = 0; }
  for k: 0..<w.f.count { w.f[k] = 0; }
  for k: 0..<w.i.count { w.i[k] = 0; }
  _ := spatial_init(w.grid, cell);
  for k: 0..<w.sys_id.count { w.sys_id[k] = 0; w.sys_reads[k] = 0; w.sys_writes[k] = 0; }
  for k: 0..<w.seen.count { w.seen[k] = 0; }
  for k: 0..<w.n.count { w.n[k] = ifx k == WORLD_READY then 1 else 0; }
  return true;
}
world_ready :: (w: World) -> bool #effects(all) { return w.n.count >= WORLD_COUNTERS && w.n[WORLD_READY] == 1; }
world_tick :: (w: World) -> int #effects(all) { return w.n[WORLD_TICK]; }
world_violations :: (w: World) -> int #effects(all) { return w.n[WORLD_VIOLATIONS]; }
// book:end world

// book:begin systems
// Adds a system to the end of the list: its id (1 or more, the realm's), the components it reads
// and those it writes. A system may read what it writes. False, and nothing changed, once the
// World has stepped (the list is the session's), for an id below 1 or already in the list,
// components that are not components, or a full list.
world_system :: (w: World, id: int, reads: int, writes: int) -> bool #effects(all) {
  if !world_ready(w) || w.n[WORLD_TICK] != 0 || w.n[WORLD_STEPPING] != 0 { return false; }
  k := w.n[WORLD_SYSTEMS];
  if id < 1 || k >= w.sys_id.count || (reads | writes) < 0 || (reads | writes) > WORLD_ALL { return false; }
  for j: 0..<k { if w.sys_id[j] == id { return false; } }
  w.sys_id[k] = id; w.sys_reads[k] = reads; w.sys_writes[k] = writes;
  w.n[WORLD_SYSTEMS] = k + 1;
  return true;
}
// A step opens. False if the World is not ready or a step is open already.
world_step_begin :: (w: World) -> bool #effects(all) {
  if !world_ready(w) || w.n[WORLD_STEPPING] != 0 { return false; }
  w.n[WORLD_STEPPING] = 1; w.n[WORLD_NEXT] = 0; w.n[WORLD_RUNNING] = 0;
  return true;
}
// One component's columns as one number, over slots 0..<high (the audit's before and after: the
// slots in use when the system began, so a spawn's new slot is not a change).
world_component_digest :: (w: World, component: int, high: int) -> int #effects(all) {
  cap := world_cap(w); h := 2166136261;
  for c: 0..<WORLD_F {
    if world_f_component(c) != component { continue; }
    for s: 0..<high { h = entity_mix(h, cast(int) f32_bits(w.f[c * cap + s])); }
  }
  for c: 0..<WORLD_I {
    if world_i_component(c) != component { continue; }
    for s: 0..<high { h = entity_mix(entity_mix(h, w.i[c * cap + s]), w.i[c * cap + s] >> 32); }
  }
  return h;
}
// The system with this id runs now: true only for the system the list has next, inside a step, with
// none running. Anything else is counted in WORLD_SKIPPED and nothing runs.
world_system_begin :: (w: World, id: int) -> bool #effects(all) {
  k := w.n[WORLD_NEXT];
  if w.n[WORLD_STEPPING] != 1 || w.n[WORLD_RUNNING] != 0 || k >= w.n[WORLD_SYSTEMS] || w.sys_id[k] != id {
    w.n[WORLD_SKIPPED] = add_sat(w.n[WORLD_SKIPPED], 1);
    return false;
  }
  w.n[WORLD_RUNNING] = k + 1;
  if w.n[WORLD_AUDIT] == 1 {
    w.n[WORLD_SEEN_HIGH] = entity_high(w.ents);
    for c: 0..<WORLD_COMPONENTS { w.seen[c] = world_component_digest(w, 1 << c, w.n[WORLD_SEEN_HIGH]); }
  }
  return true;
}
// A refused access, counted; the first one is kept (WORLD_FIRST, WORLD_FIRST_WHAT).
world_violation :: (w: World, component: int, write: bool) #effects(all) {
  if w.n[WORLD_VIOLATIONS] == 0 {
    r := w.n[WORLD_RUNNING];
    w.n[WORLD_FIRST] = ifx r > 0 then w.sys_id[r - 1] else 0;
    w.n[WORLD_FIRST_WHAT] = component + (ifx write then WORLD_WROTE else 0);
  }
  w.n[WORLD_VIOLATIONS] = add_sat(w.n[WORLD_VIOLATIONS], 1);
}
// The running system is done: with the audit on, a component it did not declare a write to and
// changed all the same (past the accessors) is a violation. The list moves to its next system.
world_system_end :: (w: World) #effects(all) {
  r := w.n[WORLD_RUNNING];
  if r == 0 { return; }
  if w.n[WORLD_AUDIT] == 1 {
    for c: 0..<WORLD_COMPONENTS {
      if (w.sys_writes[r - 1] & (1 << c)) != 0 || w.seen[c] == world_component_digest(w, 1 << c, w.n[WORLD_SEEN_HIGH]) { continue; }
      w.n[WORLD_AUDITED] = add_sat(w.n[WORLD_AUDITED], 1);
      world_violation(w, 1 << c, true);
    }
  }
  w.n[WORLD_RUNNING] = 0;
  w.n[WORLD_NEXT] = r;
}
// Turns the audit on or off, between steps (false inside one).
world_audit :: (w: World, on: bool) -> bool #effects(all) {
  if !world_ready(w) || w.n[WORLD_STEPPING] != 0 { return false; }
  w.n[WORLD_AUDIT] = ifx on then 1 else 0;
  return true;
}
// Whether the caller may read (or write) a component now. Outside a step, yes: the columns are the
// realm's. Inside one, only the running system, and only what it declared (a write is a read too).
// A refusal is counted.
world_may :: (w: World, component: int, write: bool) -> bool #effects(all) {
  if w.n[WORLD_STEPPING] == 0 { return true; }
  r := w.n[WORLD_RUNNING];
  if r > 0 {
    mask := ifx write then w.sys_writes[r - 1] else w.sys_reads[r - 1] | w.sys_writes[r - 1];
    if (mask & component) != 0 { return true; }
  }
  world_violation(w, component, write);
  return false;
}
// book:end systems

// book:begin access
// One element of an f32 column: 0 for a column or slot that is none, or an access refused.
world_f :: (w: World, col: int, slot: int) -> f32 #effects(all) {
  cap := world_cap(w);
  if col < 0 || col >= WORLD_F || slot < 0 || slot >= cap || !world_may(w, world_f_component(col), false) { return 0; }
  return w.f[col * cap + slot];
}
// Sets it: false, and nothing changed, for a column or slot that is none, or an access refused.
world_set_f :: (w: World, col: int, slot: int, v: f32) -> bool #effects(all) {
  cap := world_cap(w);
  if col < 0 || col >= WORLD_F || slot < 0 || slot >= cap || !world_may(w, world_f_component(col), true) { return false; }
  w.f[col * cap + slot] = v;
  return true;
}
world_i :: (w: World, col: int, slot: int) -> int #effects(all) {
  cap := world_cap(w);
  if col < 0 || col >= WORLD_I || slot < 0 || slot >= cap || !world_may(w, world_i_component(col), false) { return 0; }
  return w.i[col * cap + slot];
}
world_set_i :: (w: World, col: int, slot: int, v: int) -> bool #effects(all) {
  cap := world_cap(w);
  if col < 0 || col >= WORLD_I || slot < 0 || slot >= cap || !world_may(w, world_i_component(col), true) { return false; }
  w.i[col * cap + slot] = v;
  return true;
}
// Whether slot carries every one of these components.
world_has :: (w: World, slot: int, components: int) -> bool #effects(all) {
  return slot >= 0 && slot < world_cap(w) && (w.has[slot] & components) == components;
}
// book:end access

// book:begin life
// A spawn carrying these components. A free slot's columns are zero (init and the settle that
// frees a slot see to it), so it starts at zero, for the realm (or the spawning system, for the
// components it writes) to fill now. It is alive, and in the index, from the step's end.
// ENTITY_NONE when every slot is in use or the components are not components.
world_spawn :: (w: World, components: int) -> Spawned #effects(all) {
  if !world_ready(w) || components < 0 || components > WORLD_ALL { return Spawned.{}; }
  made := entity_spawn(w.ents);
  if made.handle != ENTITY_NONE { w.has[entity_slot(made.handle)] = components; }
  return made;
}
// A despawn: the entity stays alive, with its columns, until the step's end.
world_despawn :: (w: World, h: Handle(Entity)) #effects(all) { entity_despawn(w.ents, h); }
world_alive :: (w: World, h: Handle(Entity)) -> bool #effects(all) { return entity_alive(w.ents, h); }
// The live entity in slot i, or ENTITY_NONE: a system's ordered walk is slots 0..<world_high.
world_at :: (w: World, i: int) -> Handle(Entity) #effects(all) { return entity_at(w.ents, i); }
world_high :: (w: World) -> int #effects(all) { return entity_high(w.ents); }
world_count :: (w: World) -> int #effects(all) { return entity_count(w.ents); }

// Applies the despawns and spawns (the entity store's flush) and brings the index up to date: a
// slot given up loses its components and its columns go back to zero, every live slot with a
// transform stands in the index where its columns say, and no other slot does.
world_settle :: (w: World) #effects(all) {
  cap := world_cap(w);
  for s: 0..<entity_high(w.ents) {
    if !w.ents.doomed[s] { continue; }
    w.has[s] = 0;
    for c: 0..<WORLD_F { w.f[c * cap + s] = 0; }
    for c: 0..<WORLD_I { w.i[c * cap + s] = 0; }
  }
  entity_flush(w.ents);
  for s: 0..<entity_high(w.ents) {
    if w.ents.live[s] && (w.has[s] & WORLD_TRANSFORM) != 0 { _ := spatial_put(w.grid, s, w.f[WF_X * cap + s], w.f[WF_Z * cap + s]); }
    else { spatial_drop(w.grid, s); }
  }
}
// The realm's setup between steps is in: what it spawned is alive and indexed. False inside a step.
world_commit :: (w: World) -> bool #effects(all) {
  if !world_ready(w) || w.n[WORLD_STEPPING] != 0 { return false; }
  world_settle(w);
  return true;
}
// The step closes: true only when every system in the list ran, in order, and none is running.
// Then spawns and despawns apply, the index is brought up to date and the tick moves on. A step
// ended early is counted in WORLD_SKIPPED and stays open.
world_step_end :: (w: World) -> bool #effects(all) {
  if w.n[WORLD_STEPPING] != 1 { return false; }
  if w.n[WORLD_RUNNING] != 0 || w.n[WORLD_NEXT] != w.n[WORLD_SYSTEMS] {
    w.n[WORLD_SKIPPED] = add_sat(w.n[WORLD_SKIPPED], 1);
    return false;
  }
  world_settle(w);
  w.n[WORLD_STEPPING] = 0;
  w.n[WORLD_TICK] = add_sat(w.n[WORLD_TICK], 1);
  return true;
}
// The slots within r metres of (x, z) as the index has them (where each stood at the last step's
// end), into out (as many as fit); how many there are. It reads transforms: 0 when refused.
world_near :: (w: World, x: f32, z: f32, r: f32, out: [] int) -> int #effects(all) {
  if !world_may(w, WORLD_TRANSFORM, false) { return 0; }
  return spatial_query(w.grid, x, z, r, out);
}
// book:end life

// book:begin digest
// The World as one number: the entity store, the tick, and each live or waiting slot's components
// and the columns it carries. Equal worlds give equal digests on every host.
world_digest :: (w: World) -> int #effects(all) {
  cap := world_cap(w);
  h := entity_mix(entity_digest(w.ents), w.n[WORLD_TICK]);
  for s: 0..<entity_high(w.ents) {
    if !w.ents.live[s] && !w.ents.born[s] { continue; }
    h = entity_mix(h, w.has[s]);
    for c: 0..<WORLD_F { if (w.has[s] & world_f_component(c)) != 0 { h = entity_mix(h, cast(int) f32_bits(w.f[c * cap + s])); } }
    for c: 0..<WORLD_I { if (w.has[s] & world_i_component(c)) != 0 { h = entity_mix(entity_mix(h, w.i[c * cap + s]), w.i[c * cap + s] >> 32); } }
  }
  return h;
}
// book:end digest

// A World's storage at a fixed size, for a realm that wants one field: WORLD_SLOTS entities,
// WORLD_LISTS index lists and WORLD_LIST systems. A zone's room and the offline worker hold one a
// zone; the checks below run on it.
WORLD_SLOTS :: 4096; WORLD_LISTS :: 4096; WORLD_LIST :: 32;
WorldStore :: struct {
  gen: [WORLD_SLOTS] int; live: [WORLD_SLOTS] bool; born: [WORLD_SLOTS] bool; doomed: [WORLD_SLOTS] bool;
  ids: [WORLD_SLOTS] int; free: [WORLD_SLOTS] int; spawns: [WORLD_SLOTS] int; en: [ENTITY_COUNTERS] int;
  has: [WORLD_SLOTS] int; f: [WORLD_F * WORLD_SLOTS] f32; i: [WORLD_I * WORLD_SLOTS] int;
  head: [WORLD_LISTS] int; next: [WORLD_SLOTS] int; prev: [WORLD_SLOTS] int; at: [WORLD_SLOTS] int;
  cx: [WORLD_SLOTS] int; cz: [WORLD_SLOTS] int; gx: [WORLD_SLOTS] f32; gz: [WORLD_SLOTS] f32; cell: [1] f32; gn: [SPATIAL_COUNTERS] int;
  sys_id: [WORLD_LIST] int; sys_reads: [WORLD_LIST] int; sys_writes: [WORLD_LIST] int;
  seen: [WORLD_COMPONENTS] int; n: [WORLD_COUNTERS] int;
}
// The World over the first `cap` slots of a store: the realm's declared cap, 1 to WORLD_SLOTS. Any
// other cap gives views of no slots, which world_init refuses.
world_of :: (b: [] WorldStore, cap: int) -> World #effects(all) {
  c := ifx cap >= 1 && cap <= WORLD_SLOTS then cap else 0;
  return World.{
    ents = EntityStore.{gen = b[0].gen[0..<c], live = b[0].live[0..<c], born = b[0].born[0..<c], doomed = b[0].doomed[0..<c],
      ids = b[0].ids[0..<c], free = b[0].free[0..<c], spawns = b[0].spawns[0..<c], n = b[0].en[..]},
    has = b[0].has[0..<c], f = b[0].f[0..<WORLD_F * c], i = b[0].i[0..<WORLD_I * c],
    grid = SpatialGrid.{head = b[0].head[..], next = b[0].next[0..<c], prev = b[0].prev[0..<c], at = b[0].at[0..<c],
      cx = b[0].cx[0..<c], cz = b[0].cz[0..<c], x = b[0].gx[0..<c], z = b[0].gz[0..<c], cell = b[0].cell[..], n = b[0].gn[..]},
    sys_id = b[0].sys_id[..], sys_reads = b[0].sys_reads[..], sys_writes = b[0].sys_writes[..],
    seen = b[0].seen[..], n = b[0].n[..]};
}

// ---- checks

wt_new :: (b: [] WorldStore, cap: int) -> World #effects(all) { w := world_of(b, cap); _ := world_init(w, 8); return w; }
// One entity with every component, alive and indexed at (x, z).
wt_put :: (w: World, x: f32, z: f32) -> Handle(Entity) #effects(all) {
  made := world_spawn(w, WORLD_ALL); s := entity_slot(made.handle);
  _ := world_set_f(w, WF_X, s, x); _ := world_set_f(w, WF_Z, s, z);
  _ := world_commit(w);
  return made.handle;
}

#test "world: each column belongs to one component" {
  #assert world_f_component(WF_X) == WORLD_TRANSFORM && world_f_component(WF_Y) == WORLD_TRANSFORM && world_f_component(WF_Z) == WORLD_TRANSFORM && world_f_component(WF_YAW) == WORLD_TRANSFORM;
  #assert world_f_component(WF_VX) == WORLD_BODY && world_f_component(WF_VY) == WORLD_BODY && world_f_component(WF_VZ) == WORLD_BODY && world_f_component(WF_RADIUS) == WORLD_BODY && world_f_component(WF_HEIGHT) == WORLD_BODY;
  #assert world_i_component(WI_HP) == WORLD_HEALTH && world_i_component(WI_HP_MAX) == WORLD_HEALTH && world_i_component(WI_KIND) == WORLD_KIND && world_i_component(WI_ROW) == WORLD_ROW;
  #assert WORLD_F == WF_HEIGHT + 1 && WORLD_I == WI_ROW + 1 && WORLD_ALL == (1 << WORLD_COMPONENTS) - 1;
}
#test "world: storage is taken whole or refused; init empties it; the cap is the realm's" {
  b: [1] WorldStore; w := world_of(b[..], 64);
  #assert world_cap(w) == 64 && world_shaped(w) && !world_ready(w);
  #assert world_cap(world_of(b[..], 0)) == 0 && world_cap(world_of(b[..], -1)) == 0 && world_cap(world_of(b[..], 1)) == 1 && world_cap(world_of(b[..], 2)) == 2;
  #assert world_cap(world_of(b[..], WORLD_SLOTS)) == WORLD_SLOTS && world_cap(world_of(b[..], WORLD_SLOTS + 1)) == 0 && world_shaped(world_of(b[..], WORLD_SLOTS)) && world_shaped(world_of(b[..], 1));
  #assert !world_shaped(world_of(b[..], 0)) && !world_init(world_of(b[..], 0), 8) && !world_init(world_of(b[..], WORLD_SLOTS + 1), 8) && b[0].n[WORLD_READY] == 0;
  // one view wrong at a time
  bad := w; bad.ents.gen = b[0].gen[0..<0]; #assert !world_shaped(bad) && !world_init(bad, 8);
  bad = w; bad.ents.live = b[0].live[0..<63]; #assert !world_shaped(bad);
  bad = w; bad.ents.born = b[0].born[0..<63]; #assert !world_shaped(bad);
  bad = w; bad.ents.doomed = b[0].doomed[0..<63]; #assert !world_shaped(bad);
  bad = w; bad.ents.ids = b[0].ids[0..<63]; #assert !world_shaped(bad);
  bad = w; bad.ents.free = b[0].free[0..<63]; #assert !world_shaped(bad);
  bad = w; bad.ents.spawns = b[0].spawns[0..<63]; #assert !world_shaped(bad);
  bad = w; bad.ents.n = b[0].en[0..<ENTITY_COUNTERS - 1]; #assert !world_shaped(bad);
  bad = w; bad.has = b[0].has[0..<65]; #assert !world_shaped(bad);
  bad = w; bad.f = b[0].f[0..<WORLD_F * 64 - 1]; #assert !world_shaped(bad);
  bad = w; bad.i = b[0].i[0..<WORLD_I * 64 + 1]; #assert !world_shaped(bad);
  bad = w; bad.grid.head = b[0].head[0..<3]; #assert !world_shaped(bad);
  bad = w; bad.grid.next = b[0].next[0..<65]; bad.grid.prev = b[0].prev[0..<65]; bad.grid.at = b[0].at[0..<65]; bad.grid.cx = b[0].cx[0..<65]; bad.grid.cz = b[0].cz[0..<65]; bad.grid.x = b[0].gx[0..<65]; bad.grid.z = b[0].gz[0..<65];
  #assert spatial_shaped(bad.grid) && !world_shaped(bad);
  bad = w; bad.sys_id = b[0].sys_id[0..<0]; bad.sys_reads = b[0].sys_reads[0..<0]; bad.sys_writes = b[0].sys_writes[0..<0]; #assert !world_shaped(bad);
  bad = w; bad.sys_reads = b[0].sys_reads[0..<WORLD_LIST - 1]; #assert !world_shaped(bad);
  bad = w; bad.sys_writes = b[0].sys_writes[0..<WORLD_LIST - 1]; #assert !world_shaped(bad);
  bad = w; bad.seen = b[0].seen[0..<WORLD_COMPONENTS - 1]; #assert !world_shaped(bad);
  bad = w; bad.n = b[0].n[0..<WORLD_COUNTERS - 1]; #assert !world_shaped(bad) && !world_init(bad, 8) && !world_ready(bad);
  one := w; one.sys_id = b[0].sys_id[0..<1]; one.sys_reads = b[0].sys_reads[0..<1]; one.sys_writes = b[0].sys_writes[0..<1]; #assert world_shaped(one);
  #assert !world_ready(w) && b[0].cell[0] == 0;
  // dirt everywhere, then init
  for k: 0..<64 { b[0].has[k] = 7; b[0].gen[k] = 3; b[0].at[k] = 1; }
  for k: 0..<WORLD_F * 64 { b[0].f[k] = 2; } for k: 0..<WORLD_I * 64 { b[0].i[k] = 2; }
  for k: 0..<WORLD_LIST { b[0].sys_id[k] = 9; b[0].sys_reads[k] = 9; b[0].sys_writes[k] = 9; }
  for k: 0..<WORLD_COMPONENTS { b[0].seen[k] = 9; } for k: 0..<WORLD_COUNTERS { b[0].n[k] = 9; }
  #assert world_init(w, 8) && world_ready(w) && world_tick(w) == 0 && world_count(w) == 0 && world_high(w) == 0 && world_violations(w) == 0 && b[0].cell[0] == 8;
  for k: 0..<64 { #assert b[0].has[k] == 0 && b[0].gen[k] == 0 && b[0].at[k] == 0; }
  for k: 0..<WORLD_F * 64 { #assert b[0].f[k] == 0; } for k: 0..<WORLD_I * 64 { #assert b[0].i[k] == 0; }
  for k: 0..<WORLD_LIST { #assert b[0].sys_id[k] == 0 && b[0].sys_reads[k] == 0 && b[0].sys_writes[k] == 0; }
  for k: 0..<WORLD_COMPONENTS { #assert b[0].seen[k] == 0; }
  for k: 1..<WORLD_COUNTERS { #assert b[0].n[k] == 0; }
  #assert b[0].n[WORLD_READY] == 1;
  // a store's slots are within what a handle can name
  #assert ENTITY_SLOT_MASK + 1 >= WORLD_SLOTS;
}
#test "world: the system list takes each id once, in order, with real components, until the first step" {
  b: [1] WorldStore; w := world_of(b[..], 8);
  #assert !world_system(w, 1, WORLD_TRANSFORM, WORLD_BODY);   // not ready
  #assert world_init(w, 8);
  #assert !world_system(w, 0, 0, 0) && !world_system(w, -3, 0, 0) && b[0].n[WORLD_SYSTEMS] == 0;
  #assert !world_system(w, 1, WORLD_ALL + 1, 0) && !world_system(w, 1, 0, WORLD_ALL + 1) && !world_system(w, 1, -1, 0) && !world_system(w, 1, 0, -1) && b[0].n[WORLD_SYSTEMS] == 0;
  #assert world_system(w, 5, WORLD_TRANSFORM, WORLD_BODY) && world_system(w, 1, WORLD_ALL, 0) && world_system(w, 9, 0, WORLD_ALL) && b[0].n[WORLD_SYSTEMS] == 3;
  #assert b[0].sys_id[0] == 5 && b[0].sys_reads[0] == WORLD_TRANSFORM && b[0].sys_writes[0] == WORLD_BODY && b[0].sys_id[1] == 1 && b[0].sys_reads[1] == WORLD_ALL && b[0].sys_id[2] == 9 && b[0].sys_writes[2] == WORLD_ALL;
  #assert !world_system(w, 5, 0, 0) && !world_system(w, 9, 0, 0) && !world_system(w, 1, 0, 0) && b[0].n[WORLD_SYSTEMS] == 3;
  // a full list
  for k: 3..<WORLD_LIST { #assert world_system(w, 100 + k, 0, 0); }
  #assert !world_system(w, 99, 0, 0) && b[0].n[WORLD_SYSTEMS] == WORLD_LIST;
  // inside a step, and after one, the list is closed
  c: [1] WorldStore; v := wt_new(c[..], 8);
  #assert world_system(v, 1, 0, 0) && world_step_begin(v) && !world_system(v, 2, 0, 0);
  #assert world_system_begin(v, 1); world_system_end(v); #assert world_step_end(v) && world_tick(v) == 1;
  #assert !world_system(v, 2, 0, 0) && c[0].n[WORLD_SYSTEMS] == 1;
}
#test "world: a step runs every system in the list's order, each once, or it does not close" {
  b: [1] WorldStore; w := world_of(b[..], 8);
  #assert !world_step_begin(w) && !world_step_end(w) && !world_commit(w) && !world_audit(w, true);   // not ready
  #assert world_init(w, 8) && world_system(w, 4, 0, 0) && world_system(w, 2, 0, 0) && world_system(w, 7, 0, 0);
  #assert !world_system_begin(w, 4) && b[0].n[WORLD_SKIPPED] == 1;   // no step open
  #assert !world_step_end(w) && b[0].n[WORLD_SKIPPED] == 1;
  #assert world_step_begin(w) && !world_step_begin(w) && b[0].n[WORLD_STEPPING] == 1;
  #assert !world_commit(w) && !world_audit(w, true);
  #assert !world_system_begin(w, 2) && !world_system_begin(w, 7) && b[0].n[WORLD_SKIPPED] == 3 && b[0].n[WORLD_RUNNING] == 0;   // not the next
  #assert !world_step_end(w) && b[0].n[WORLD_SKIPPED] == 4 && world_tick(w) == 0 && b[0].n[WORLD_STEPPING] == 1;                // none ran yet
  world_system_end(w); #assert b[0].n[WORLD_NEXT] == 0;                                                                         // none running: nothing
  #assert world_system_begin(w, 4) && b[0].n[WORLD_RUNNING] == 1 && !world_system_begin(w, 2) && !world_system_begin(w, 4) && b[0].n[WORLD_SKIPPED] == 6;   // one at a time
  #assert !world_step_end(w) && b[0].n[WORLD_SKIPPED] == 7;                                                                     // one still running
  world_system_end(w); #assert b[0].n[WORLD_RUNNING] == 0 && b[0].n[WORLD_NEXT] == 1;
  #assert !world_system_begin(w, 4) && world_system_begin(w, 2) && b[0].n[WORLD_RUNNING] == 2; world_system_end(w); #assert b[0].n[WORLD_NEXT] == 2;
  #assert !world_step_end(w) && b[0].n[WORLD_SKIPPED] == 9;                                                                     // the last has not run
  #assert world_system_begin(w, 7); world_system_end(w);
  #assert !world_system_begin(w, 7) && !world_system_begin(w, 4) && b[0].n[WORLD_SKIPPED] == 11;                                // the list is done
  #assert world_step_end(w) && world_tick(w) == 1 && b[0].n[WORLD_STEPPING] == 0 && b[0].n[WORLD_SKIPPED] == 11;
  #assert world_step_begin(w) && b[0].n[WORLD_NEXT] == 0 && world_system_begin(w, 4); world_system_end(w);
  #assert world_system_begin(w, 2); world_system_end(w); #assert world_system_begin(w, 7); world_system_end(w); #assert world_step_end(w) && world_tick(w) == 2;
  // a World with no systems steps too; a step begun mid-system state starts clean
  c: [1] WorldStore; v := wt_new(c[..], 8);
  c[0].n[WORLD_NEXT] = 5; c[0].n[WORLD_RUNNING] = 3;
  #assert world_step_begin(v) && c[0].n[WORLD_NEXT] == 0 && c[0].n[WORLD_RUNNING] == 0 && !world_system_begin(v, 0) && c[0].n[WORLD_RUNNING] == 0 && world_step_end(v) && world_tick(v) == 1;
}
#test "world: inside a step a column is read and written only by a system that declared it" {
  b: [1] WorldStore; w := wt_new(b[..], 8);
  #assert world_system(w, 3, WORLD_TRANSFORM, WORLD_BODY) && world_system(w, 6, WORLD_HEALTH | WORLD_KIND, WORLD_ROW) && world_system(w, 8, 0, 0);
  // outside a step the columns are the realm's
  #assert world_may(w, WORLD_HEALTH, true) && world_may(w, WORLD_HEALTH, false);
  #assert world_set_f(w, WF_X, 2, 1.5) && world_set_f(w, WF_YAW, 2, 0.25) && world_set_f(w, WF_VX, 2, 3) && world_set_f(w, WF_HEIGHT, 7, 1.75) && world_set_i(w, WI_HP, 2, 40) && world_set_i(w, WI_HP_MAX, 2, 50) && world_set_i(w, WI_KIND, 2, 6) && world_set_i(w, WI_ROW, 7, 12);
  #assert world_f(w, WF_X, 2) == 1.5 && world_f(w, WF_YAW, 2) == 0.25 && world_f(w, WF_VX, 2) == 3 && world_f(w, WF_HEIGHT, 7) == 1.75 && world_i(w, WI_HP, 2) == 40 && world_i(w, WI_HP_MAX, 2) == 50 && world_i(w, WI_KIND, 2) == 6 && world_i(w, WI_ROW, 7) == 12;
  #assert b[0].f[WF_X * 8 + 2] == 1.5 && b[0].f[WF_HEIGHT * 8 + 7] == 1.75 && b[0].i[WI_HP * 8 + 2] == 40 && b[0].i[WI_ROW * 8 + 7] == 12;
  // no such column or slot
  #assert !world_set_f(w, -1, 2, 9) && !world_set_f(w, WORLD_F, 2, 9) && !world_set_f(w, WF_X, -1, 9) && !world_set_f(w, WF_X, 8, 9) && !world_set_i(w, -1, 2, 9) && !world_set_i(w, WORLD_I, 2, 9) && !world_set_i(w, WI_HP, -1, 9) && !world_set_i(w, WI_HP, 8, 9);
  b[0].f[WF_Y * 8] = 5; b[0].i[WI_HP_MAX * 8] = 5; b[0].f[WF_X * 8 + 7] = 6; b[0].i[WI_HP * 8 + 7] = 6;   // what an index past its column would reach
  #assert world_f(w, -1, 2) == 0 && world_f(w, WORLD_F, 0) == 0 && world_f(w, WF_X, -1) == 0 && world_f(w, WF_X, 8) == 0 && world_i(w, -1, 2) == 0 && world_i(w, WORLD_I, 0) == 0 && world_i(w, WI_HP, -1) == 0 && world_i(w, WI_HP, 8) == 0;
  #assert world_f(w, WF_HEIGHT, 7) == 1.75 && world_i(w, WI_ROW, 7) == 12 && world_f(w, WF_X, 7) == 6 && world_i(w, WI_HP, 7) == 6 && world_violations(w) == 0;
  #assert world_f(w, WF_Y, 0) == 5 && world_i(w, WI_HP_MAX, 0) == 5 && world_f(w, WF_X, 0) == 0 && world_i(w, WI_HP, 0) == 0;
  // in a step with no system running: refused, counted, and the first is kept with no system
  #assert world_step_begin(w);
  #assert world_f(w, WF_X, 2) == 0 && world_i(w, WI_HP, 2) == 0 && !world_set_f(w, WF_X, 2, 9) && !world_set_i(w, WI_HP, 2, 9) && world_violations(w) == 4;
  #assert b[0].n[WORLD_FIRST] == 0 && b[0].n[WORLD_FIRST_WHAT] == WORLD_TRANSFORM && b[0].f[WF_X * 8 + 2] == 1.5 && b[0].i[WI_HP * 8 + 2] == 40;
  // system 3 reads the transform and writes the body (and may read what it writes), nothing else
  #assert world_system_begin(w, 3);
  #assert world_f(w, WF_X, 2) == 1.5 && world_f(w, WF_VX, 2) == 3 && world_set_f(w, WF_VX, 2, 4) && world_f(w, WF_VX, 2) == 4 && world_violations(w) == 4;
  #assert !world_set_f(w, WF_X, 2, 9) && world_i(w, WI_HP, 2) == 0 && !world_set_i(w, WI_KIND, 2, 9) && world_i(w, WI_ROW, 7) == 0 && world_violations(w) == 8;
  #assert !world_may(w, WORLD_TRANSFORM, true) && world_may(w, WORLD_TRANSFORM, false) && world_may(w, WORLD_BODY, true) && world_may(w, WORLD_BODY, false) && !world_may(w, WORLD_KIND, false) && world_violations(w) == 10;
  #assert b[0].f[WF_X * 8 + 2] == 1.5 && b[0].i[WI_KIND * 8 + 2] == 6;
  world_system_end(w);
  // system 6 reads health and kind, writes the row
  #assert world_system_begin(w, 6);
  #assert world_i(w, WI_HP, 2) == 40 && world_i(w, WI_KIND, 2) == 6 && world_set_i(w, WI_ROW, 2, 3) && world_i(w, WI_ROW, 2) == 3 && world_violations(w) == 10;
  #assert !world_set_i(w, WI_HP, 2, 1) && !world_set_i(w, WI_KIND, 2, 1) && world_f(w, WF_X, 2) == 0 && world_f(w, WF_VX, 2) == 0 && world_violations(w) == 14;
  world_system_end(w);
  // system 8 declared nothing
  #assert world_system_begin(w, 8) && !world_may(w, WORLD_ROW, false) && !world_may(w, WORLD_ROW, true) && world_violations(w) == 16; world_system_end(w);
  #assert world_step_end(w) && world_may(w, WORLD_ROW, true) && world_violations(w) == 16;
  #assert b[0].n[WORLD_FIRST] == 0 && b[0].n[WORLD_FIRST_WHAT] == WORLD_TRANSFORM;   // the first stays
  // the first violation names its system and whether it wrote
  c: [1] WorldStore; v := wt_new(c[..], 8);
  #assert world_system(v, 3, WORLD_TRANSFORM, 0) && world_system(v, 11, WORLD_TRANSFORM, 0) && world_step_begin(v) && world_system_begin(v, 3); world_system_end(v);
  #assert world_system_begin(v, 11) && !world_set_i(v, WI_HP, 0, 1) && world_i(v, WI_KIND, 0) == 0;
  #assert c[0].n[WORLD_FIRST] == 11 && c[0].n[WORLD_FIRST_WHAT] == WORLD_HEALTH + WORLD_WROTE && world_violations(v) == 2;
  d: [1] WorldStore; u := wt_new(d[..], 8);
  #assert world_system(u, 3, 0, 0) && world_step_begin(u) && world_system_begin(u, 3) && world_i(u, WI_KIND, 0) == 0 && d[0].n[WORLD_FIRST] == 3 && d[0].n[WORLD_FIRST_WHAT] == WORLD_KIND;
  d[0].n[WORLD_VIOLATIONS] = 9223372036854775807; world_violation(u, WORLD_ROW, true); #assert d[0].n[WORLD_VIOLATIONS] == 9223372036854775807 && d[0].n[WORLD_FIRST_WHAT] == WORLD_KIND;
}
#test "world: the audit finds a write past the accessors to a column the system did not declare" {
  b: [1] WorldStore; w := wt_new(b[..], 8);
  #assert world_system(w, 3, WORLD_TRANSFORM, WORLD_BODY) && world_system(w, 4, 0, WORLD_ALL);
  h := wt_put(w, 1, 1); s := entity_slot(h); #assert s == 0 && world_high(w) == 1;
  #assert world_audit(w, true) && b[0].n[WORLD_AUDIT] == 1;
  // declared writes, by the accessor or past it: nothing found
  #assert world_step_begin(w) && world_system_begin(w, 3);
  b[0].f[WF_VX * 8 + s] = 2; #assert world_set_f(w, WF_VY, s, 3);
  world_system_end(w); #assert b[0].n[WORLD_AUDITED] == 0 && world_violations(w) == 0;
  #assert world_system_begin(w, 4); b[0].i[WI_HP * 8 + s] = 5; b[0].f[WF_X * 8 + s] = 9; world_system_end(w);
  #assert world_step_end(w) && b[0].n[WORLD_AUDITED] == 0 && world_violations(w) == 0;
  // an undeclared write past the accessors, to each component in turn
  #assert world_step_begin(w) && world_system_begin(w, 3);
  b[0].f[WF_YAW * 8 + s] = 1;
  world_system_end(w); #assert b[0].n[WORLD_AUDITED] == 1 && world_violations(w) == 1 && b[0].n[WORLD_FIRST] == 3 && b[0].n[WORLD_FIRST_WHAT] == WORLD_TRANSFORM + WORLD_WROTE && b[0].n[WORLD_RUNNING] == 0 && b[0].n[WORLD_NEXT] == 1;
  #assert world_system_begin(w, 4); world_system_end(w); #assert world_step_end(w);
  #assert world_step_begin(w) && world_system_begin(w, 3);
  b[0].i[WI_HP_MAX * 8 + s] = 7; b[0].i[WI_KIND * 8 + s] = 7; b[0].i[WI_ROW * 8 + s] = 1 << 40;
  world_system_end(w); #assert b[0].n[WORLD_AUDITED] == 4 && world_violations(w) == 4;
  #assert world_system_begin(w, 4); world_system_end(w); #assert world_step_end(w) && b[0].n[WORLD_AUDITED] == 4;
  // a spawn into a slot never used before is not a change, nor is a despawn
  j: [1] WorldStore; x := wt_new(j[..], 8); hx := wt_put(x, 1, 1);
  #assert world_system(x, 2, 0, 0) && world_audit(x, true) && world_step_begin(x) && world_system_begin(x, 2);
  #assert world_spawn(x, WORLD_ALL).handle != ENTITY_NONE && world_high(x) == 2 && j[0].n[WORLD_SEEN_HIGH] == 1; world_despawn(x, hx); world_system_end(x);
  #assert world_step_end(x) && j[0].n[WORLD_AUDITED] == 0 && world_violations(x) == 0 && world_count(x) == 1;
  // the first one names its component
  k: [1] WorldStore; v := wt_new(k[..], 8); _ := wt_put(v, 1, 1);
  #assert world_system(v, 12, 0, 0) && world_audit(v, true) && world_step_begin(v) && world_system_begin(v, 12); k[0].i[WI_KIND * 8] = 3; world_system_end(v);
  #assert k[0].n[WORLD_AUDITED] == 1 && k[0].n[WORLD_FIRST] == 12 && k[0].n[WORLD_FIRST_WHAT] == WORLD_KIND + WORLD_WROTE;
  // a write that puts the old value back is no change; a slot never used is outside the audit
  #assert world_step_begin(w) && world_system_begin(w, 3);
  b[0].i[WI_KIND * 8 + s] = 8; b[0].i[WI_KIND * 8 + s] = 7; b[0].i[WI_KIND * 8 + 5] = 3;
  world_system_end(w); #assert b[0].n[WORLD_AUDITED] == 4;
  #assert world_system_begin(w, 4); world_system_end(w); #assert world_step_end(w);
  // the audit off: nothing is compared, and a stale digest is not read
  #assert world_audit(w, false) && b[0].n[WORLD_AUDIT] == 0;
  #assert world_step_begin(w) && world_system_begin(w, 3); b[0].i[WI_KIND * 8 + s] = 1; world_system_end(w);
  #assert world_system_begin(w, 4); world_system_end(w); #assert world_step_end(w) && b[0].n[WORLD_AUDITED] == 4 && world_violations(w) == 4;
  // the count holds at its most
  b[0].n[WORLD_AUDITED] = 9223372036854775807; #assert world_audit(w, true) && world_step_begin(w) && world_system_begin(w, 3); b[0].i[WI_KIND * 8 + s] = 2; world_system_end(w);
  #assert b[0].n[WORLD_AUDITED] == 9223372036854775807;
  b[0].n[WORLD_SKIPPED] = 9223372036854775807; #assert !world_system_begin(w, 3) && !world_step_end(w) && b[0].n[WORLD_SKIPPED] == 9223372036854775807;
}
#test "world: a component's digest is its columns over the slots ever used, and nothing else" {
  b: [1] WorldStore; w := wt_new(b[..], 8);
  _ := wt_put(w, 1, 1); _ := wt_put(w, 2, 2); #assert world_high(w) == 2;
  t := world_component_digest(w, WORLD_TRANSFORM, 2); bo := world_component_digest(w, WORLD_BODY, 2); he := world_component_digest(w, WORLD_HEALTH, 2); ki := world_component_digest(w, WORLD_KIND, 2); ro := world_component_digest(w, WORLD_ROW, 2);
  empty := 2166136261;
  #assert t != empty && bo != empty && he != empty && ki != empty && ro != empty && world_component_digest(w, 0, 2) == empty && bo != he && ki == ro;
  // each column moves its own component only; the second slot counts; a slot past high does not
  for c: 0..<WORLD_F {
    b[0].f[c * 8 + 1] = 0.5;
    #assert (world_component_digest(w, WORLD_TRANSFORM, 2) != t) == (c <= WF_YAW) && (world_component_digest(w, WORLD_BODY, 2) != bo) == (c > WF_YAW);
    #assert world_component_digest(w, WORLD_HEALTH, 2) == he && world_component_digest(w, WORLD_KIND, 2) == ki && world_component_digest(w, WORLD_ROW, 2) == ro;
    b[0].f[c * 8 + 1] = ifx c == WF_X || c == WF_Z then 2 else 0;
    b[0].f[c * 8 + 2] = 0.5; #assert world_component_digest(w, WORLD_TRANSFORM, 2) == t && world_component_digest(w, WORLD_BODY, 2) == bo; b[0].f[c * 8 + 2] = 0;
  }
  for c: 0..<WORLD_I {
    b[0].i[c * 8 + 1] = 5;
    #assert (world_component_digest(w, WORLD_HEALTH, 2) != he) == (c <= WI_HP_MAX) && (world_component_digest(w, WORLD_KIND, 2) != ki) == (c == WI_KIND) && (world_component_digest(w, WORLD_ROW, 2) != ro) == (c == WI_ROW);
    #assert world_component_digest(w, WORLD_TRANSFORM, 2) == t && world_component_digest(w, WORLD_BODY, 2) == bo;
    b[0].i[c * 8 + 1] = 1 << 32;   // a change in the high half alone counts
    #assert (world_component_digest(w, WORLD_HEALTH, 2) != he) == (c <= WI_HP_MAX) && (world_component_digest(w, WORLD_KIND, 2) != ki) == (c == WI_KIND) && (world_component_digest(w, WORLD_ROW, 2) != ro) == (c == WI_ROW);
    b[0].i[c * 8 + 1] = 0;
    b[0].i[c * 8 + 2] = 5; #assert world_component_digest(w, WORLD_HEALTH, 2) == he && world_component_digest(w, WORLD_KIND, 2) == ki && world_component_digest(w, WORLD_ROW, 2) == ro; b[0].i[c * 8 + 2] = 0;
  }
  // fewer slots is another number, more slots than were used takes the zeros beyond
  #assert world_component_digest(w, WORLD_TRANSFORM, 1) != t && world_component_digest(w, WORLD_TRANSFORM, 0) == empty && world_component_digest(w, WORLD_KIND, 3) != ki && world_component_digest(w, WORLD_KIND, 1) != ki;
  // the numbers themselves: FNV-1a over the low 32 bits of each word, f32s by their bits
  c: [1] WorldStore; v := wt_new(c[..], 4); made := world_spawn(v, WORLD_KIND); #assert world_commit(v) && entity_slot(made.handle) == 0 && world_set_i(v, WI_KIND, 0, 3);
  #assert world_component_digest(v, WORLD_KIND, 1) == entity_mix(entity_mix(2166136261, 3), 0);
  #assert world_set_f(v, WF_X, 0, 1) && world_component_digest(v, WORLD_TRANSFORM, 1) == entity_mix(entity_mix(entity_mix(entity_mix(2166136261, 1065353216), 0), 0), 0);
}
#test "world: spawns start at zero, live and indexed from the step's end; despawns leave it then" {
  b: [1] WorldStore; w := world_of(b[..], 4); out: [8] int;
  #assert world_spawn(w, WORLD_ALL).handle == ENTITY_NONE;   // not ready
  #assert world_init(w, 8) && world_system(w, 1, WORLD_TRANSFORM, 0) && world_system(w, 2, 0, WORLD_TRANSFORM);
  #assert world_spawn(w, -1).handle == ENTITY_NONE && world_spawn(w, WORLD_ALL + 1).handle == ENTITY_NONE && b[0].en[ENTITY_SPAWNS] == 0 && b[0].en[ENTITY_REFUSED] == 0;
  a := world_spawn(w, WORLD_TRANSFORM | WORLD_HEALTH); sa := entity_slot(a.handle);
  #assert sa == 0 && a.id.value == 1 && world_has(w, sa, WORLD_TRANSFORM) && world_has(w, sa, WORLD_HEALTH | WORLD_TRANSFORM) && !world_has(w, sa, WORLD_BODY) && !world_has(w, sa, WORLD_TRANSFORM | WORLD_BODY) && world_has(w, sa, 0);
  #assert !world_has(w, -1, 0) && !world_has(w, 4, 0) && world_has(w, 3, 0) && !world_has(w, 3, WORLD_KIND);
  for q: 0..<WORLD_F { #assert world_set_f(w, q, sa, 7) && world_set_f(w, q, 3, 7); } for q: 0..<WORLD_I { #assert world_set_i(w, q, sa, 7) && world_set_i(w, q, 3, 7); }
  #assert world_set_f(w, WF_X, sa, 3) && world_set_f(w, WF_Z, sa, 4);
  #assert !world_alive(w, a.handle) && world_count(w) == 0 && world_at(w, sa) == ENTITY_NONE && world_near(w, 0, 0, 5, out[..]) == 0;
  #assert world_commit(w) && world_alive(w, a.handle) && world_count(w) == 1 && world_at(w, sa) == a.handle && world_high(w) == 1 && world_tick(w) == 0;
  #assert world_near(w, 0, 0, 5, out[..]) == 1 && out[0] == sa && world_near(w, 0, 0, 4.9, out[..]) == 0;
  // one with no transform is alive and not in the index; a cancelled spawn is neither and keeps no components
  n := world_spawn(w, WORLD_KIND); c := world_spawn(w, WORLD_ALL); world_despawn(w, c.handle);
  #assert world_has(w, entity_slot(c.handle), WORLD_ALL) && world_commit(w) && world_alive(w, n.handle) && !world_alive(w, c.handle) && world_count(w) == 2 && !world_has(w, entity_slot(c.handle), WORLD_KIND) && b[0].has[entity_slot(c.handle)] == 0;
  #assert world_near(w, 0, 0, 100, out[..]) == 1 && !spatial_has(w.grid, entity_slot(n.handle)) && !spatial_has(w.grid, entity_slot(c.handle));
  // in a step: a system moves it, the index follows at the step's end; a despawn stays alive and indexed until then
  #assert world_step_begin(w) && world_system_begin(w, 1);
  #assert world_near(w, 0, 0, 5, out[..]) == 1 && world_violations(w) == 0; world_system_end(w);
  #assert world_system_begin(w, 2) && world_set_f(w, WF_X, sa, 30) && world_near(w, 30, 4, 1, out[..]) == 0 && world_near(w, 3, 4, 1, out[..]) == 1; world_system_end(w);
  #assert world_step_end(w) && world_near(w, 30, 4, 1, out[..]) == 1 && world_near(w, 3, 4, 1, out[..]) == 0 && world_tick(w) == 1;
  #assert world_step_begin(w) && world_system_begin(w, 1); world_despawn(w, a.handle);
  #assert world_alive(w, a.handle) && world_has(w, sa, WORLD_TRANSFORM) && world_near(w, 30, 4, 1, out[..]) == 1; world_system_end(w);
  #assert world_system_begin(w, 2); world_system_end(w);
  // a system that did not declare the transform cannot ask the index
  #assert world_violations(w) == 0 && world_near(w, 30, 4, 1, out[..]) == 0 && world_violations(w) == 1;
  #assert world_step_end(w) && !world_alive(w, a.handle) && world_count(w) == 1 && b[0].has[sa] == 0 && world_near(w, 30, 4, 1, out[..]) == 0 && !spatial_has(w.grid, sa);
  // the slot it gave up is zero again for its next owner; a slot nobody gave up keeps what it held
  for q: 0..<WORLD_F { #assert b[0].f[q * 4 + sa] == 0 && b[0].f[q * 4 + 3] == 7; } for q: 0..<WORLD_I { #assert b[0].i[q * 4 + sa] == 0 && b[0].i[q * 4 + 3] == 7; }
  for q: 0..<WORLD_F { b[0].f[q * 4 + 3] = 0; } for q: 0..<WORLD_I { b[0].i[q * 4 + 3] = 0; }
  // an entity that loses its transform leaves the index at the next settle
  d := world_spawn(w, WORLD_TRANSFORM); #assert world_commit(w) && spatial_has(w.grid, entity_slot(d.handle));
  b[0].has[entity_slot(d.handle)] = WORLD_KIND; #assert world_commit(w) && !spatial_has(w.grid, entity_slot(d.handle)) && world_alive(w, d.handle);
  // every slot in use: refused, counted by the store
  #assert world_spawn(w, 0).handle != ENTITY_NONE && world_spawn(w, 0).handle != ENTITY_NONE && world_commit(w) && world_count(w) == 4;
  #assert world_spawn(w, 0).handle == ENTITY_NONE && b[0].en[ENTITY_REFUSED] == 1;
}
#test "world: the digest is the store, the tick and each present slot's own columns" {
  b: [1] WorldStore; w := wt_new(b[..], 8); c: [1] WorldStore; v := wt_new(c[..], 8);
  #assert world_digest(w) == world_digest(v) && world_digest(w) == entity_mix(entity_digest(w.ents), 0);
  a := world_spawn(w, WORLD_TRANSFORM | WORLD_KIND); a2 := world_spawn(v, WORLD_TRANSFORM | WORLD_KIND); s := entity_slot(a.handle);
  #assert world_digest(w) == world_digest(v);
  d0 := world_digest(w);
  // a waiting spawn's columns count already; columns it does not carry never do
  #assert world_set_f(w, WF_X, s, 2) && world_digest(w) != d0 && world_set_f(w, WF_X, s, 0) && world_digest(w) == d0;
  #assert world_set_f(w, WF_YAW, s, 2) && world_digest(w) != d0 && world_set_f(w, WF_YAW, s, 0);
  #assert world_set_i(w, WI_KIND, s, 2) && world_digest(w) != d0 && world_set_i(w, WI_KIND, s, 1 << 32) && world_digest(w) != d0 && world_set_i(w, WI_KIND, s, 0) && world_digest(w) == d0;
  #assert world_set_f(w, WF_VX, s, 2) && world_set_f(w, WF_HEIGHT, s, 2) && world_set_i(w, WI_HP, s, 2) && world_set_i(w, WI_HP_MAX, s, 2) && world_set_i(w, WI_ROW, s, 2) && world_digest(w) == d0;
  b[0].has[s] = WORLD_ALL; d1 := world_digest(w); #assert d1 != d0;
  #assert world_set_f(w, WF_VX, s, 3) && world_digest(w) != d1 && world_set_f(w, WF_VX, s, 2) && world_set_i(w, WI_ROW, s, 3) && world_digest(w) != d1 && world_set_i(w, WI_ROW, s, 2) && world_set_i(w, WI_HP, s, 3) && world_digest(w) != d1 && world_set_i(w, WI_HP, s, 2) && world_digest(w) == d1;
  b[0].has[s] = WORLD_TRANSFORM | WORLD_KIND;
  // a slot nobody holds does not count; the tick does; live counts as waiting did
  #assert world_set_f(w, WF_X, 5, 9) && world_digest(w) == d0;
  #assert world_commit(w) && world_commit(v) && world_digest(w) == world_digest(v) && world_digest(w) != d0;
  d2 := world_digest(w); #assert world_set_f(w, WF_Z, s, 1) && world_digest(w) != d2 && world_set_f(w, WF_Z, s, 0) && world_digest(w) == d2;
  #assert world_step_begin(w) && world_step_end(w) && world_digest(w) != d2 && world_digest(v) == d2;
  // a despawned slot's leftovers do not count
  #assert world_step_begin(v) && world_step_end(v) && world_digest(w) == world_digest(v);
  world_despawn(w, a.handle); world_despawn(v, a2.handle); #assert world_commit(w) && world_commit(v);
  b[0].f[WF_X * 8 + s] = 4; b[0].i[WI_KIND * 8 + s] = 4; b[0].has[s] = WORLD_ALL; #assert world_digest(w) == world_digest(v);
  // the number itself for one entity: the store's digest, the tick, its components, then its columns in order
  e: [1] WorldStore; u := wt_new(e[..], 2); m0 := world_spawn(u, 0); m := world_spawn(u, WORLD_TRANSFORM | WORLD_ROW);
  #assert entity_slot(m0.handle) == 0 && entity_slot(m.handle) == 1 && world_set_f(u, WF_Y, 1, 1) && world_set_i(u, WI_ROW, 1, 7 + (5 << 32)) && world_set_i(u, WI_KIND, 1, 9) && world_set_i(u, WI_HP_MAX, 0, 9);
  h := entity_mix(entity_mix(entity_mix(entity_digest(u.ents), 0), 0), WORLD_TRANSFORM | WORLD_ROW);
  h = entity_mix(entity_mix(entity_mix(entity_mix(h, 0), 1065353216), 0), 0); h = entity_mix(entity_mix(h, 7), 5);
  #assert world_digest(u) == h;
}
WORLD_WALK :: 400;
#forall "world: through random steps of moves, spawns and despawns, the index answers as a scan does and two worlds agree" seed: 1..<5 #steps 400000000 {
  b: [1] WorldStore; w := wt_new(b[..], WORLD_WALK); c: [1] WorldStore; v := wt_new(c[..], WORLD_WALK);
  #assert world_system(w, 1, WORLD_TRANSFORM, WORLD_BODY) && world_system(w, 2, WORLD_BODY, WORLD_TRANSFORM) && world_audit(w, true);
  #assert world_system(v, 1, WORLD_TRANSFORM, WORLD_BODY) && world_system(v, 2, WORLD_BODY, WORLD_TRANSFORM);
  got: [WORLD_WALK] int; want: [WORLD_WALK] bool;
  for pass: 0..<2 {
    u := ifx pass == 0 then w else v; s := seed * 7919;
    for t: 0..<12 {
      // the realm spawns between steps
      for k: 0..<60 {
        s = (s * 1103515245 + 12345) & 0x7fffffff; if (s >> 8) % 3 == 0 { continue; }
        made := world_spawn(u, WORLD_TRANSFORM | WORLD_BODY); if made.handle == ENTITY_NONE { continue; }
        s = (s * 1103515245 + 12345) & 0x7fffffff; _ := world_set_f(u, WF_X, entity_slot(made.handle), f32((s >> 8) % 20000) / 100.0 - 100.0);
        s = (s * 1103515245 + 12345) & 0x7fffffff; _ := world_set_f(u, WF_Z, entity_slot(made.handle), f32((s >> 8) % 20000) / 100.0 - 100.0);
      }
      #assert world_step_begin(u) && world_system_begin(u, 1);
      for i: 0..<world_high(u) {
        if world_at(u, i) == ENTITY_NONE { continue; }
        s = (s * 1103515245 + 12345) & 0x7fffffff; _ := world_set_f(u, WF_VX, i, f32((s >> 8) % 400) / 100.0 - 2.0 - world_f(u, WF_X, i) / 50.0);
        s = (s * 1103515245 + 12345) & 0x7fffffff; _ := world_set_f(u, WF_VZ, i, f32((s >> 8) % 400) / 100.0 - 2.0);
        s = (s * 1103515245 + 12345) & 0x7fffffff; if (s >> 8) % 9 == 0 { world_despawn(u, world_at(u, i)); }
      }
      world_system_end(u); #assert world_system_begin(u, 2);
      for i: 0..<world_high(u) {
        if world_at(u, i) == ENTITY_NONE { continue; }
        _ := world_set_f(u, WF_X, i, world_f(u, WF_X, i) + world_f(u, WF_VX, i)); _ := world_set_f(u, WF_Z, i, world_f(u, WF_Z, i) + world_f(u, WF_VZ, i));
      }
      world_system_end(u); #assert world_step_end(u) && world_violations(u) == 0 && u.n[WORLD_SKIPPED] == 0;
      if pass == 1 { continue; }
      // the first world's index against a scan of its columns
      #assert spatial_count(u.grid) == world_count(u);
      for q: 0..<3 {
        s2 := s + q * 977; px := f32((s2 >> 4) % 20000) / 100.0 - 100.0; pz := f32((s2 >> 9) % 20000) / 100.0 - 100.0; r := f32(5 + q * 20); m := 0;
        for i: 0..<WORLD_WALK { dx := b[0].f[WF_X * WORLD_WALK + i] - px; dz := b[0].f[WF_Z * WORLD_WALK + i] - pz; want[i] = world_at(u, i) != ENTITY_NONE && dx * dx + dz * dz <= r * r; if want[i] { m += 1; } }
        n := world_near(u, px, pz, r, got[..]);
        #assert n == m;
        for k: 0..<n { #assert want[got[k]]; want[got[k]] = false; }
      }
    }
  }
  // the same session twice is the same world, with the audit on or off
  #assert world_digest(w) == world_digest(v) && world_tick(w) == 12 && world_count(w) > 100;
}
