// A realm's edits through their codec (compliance plan step E11, GitHub #13250):
// proto/verse/realm-edits-v1.json holds the bodies the realm edit layer, My Realm and the CLI send
// to change a realm, and what the server answers them today. This requires:
//   - every request body is what metaverse-engine/editor/change.coax writes for the fields it holds, and
//     its keys are its message's in proto/descriptors/verse-doc.pb (edits.proto);
//   - every JSON answer's keys are its message's; a refusal is SQL's object or the API's own.
// coax/web/api/tests/realm_record_checks.coax sends the same bodies to the API.
//   coax/web/tool.sh metaverse-engine/editor/change-goldens.coax proto/verse/realm-edits-v1.json

#import "Basic";
#load "change.coax";
#load "edit.coax";
#load "../../coax/lib/proto/importer.coax";
#load "../../coax/lib/proto/golden-keys.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/fs.coax";

CG_FIXTURE_PATH :: "proto/verse/realm-edits-v1.json";
CG_DESCRIPTOR_PATH :: "proto/descriptors/verse-doc.pb";
CG_PKG :: ".openagents.verse.doc.v1alpha1.";
Cg :: struct { bad: int; pass: int; quiet: bool; }
cg_need :: (g: [] Cg, name: string, what: string, ok: bool) -> bool {
  if ok { g[0].pass += 1; return true; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (%)\n", name, what); }
  return false;
}
cg_keys :: (g: [] Cg, st: [] D_State, name: string, leaf: string, text: string) {
  full: [128] u8; fn := editor_put(full[..], editor_put(full[..], 0, CG_PKG), leaf);
  nodes: [512] JvNode;
  why := pk_text_keys(st, cast(string) full[0..<fn], text, false, false, nodes[..]);
  if why == "" { g[0].pass += 1; return; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (its keys are %'s: %)\n", name, leaf, why); }
}
CgText :: struct { b: [1024] u8; n: int; }
cg_s :: (j: Jv, at: int, key: string, t: [] CgText) -> string {
  t[0].n = jv_str(j, jv_get(j, at, key), t[0].b[..]);
  return ifx t[0].n < 0 then "" else cast(string) t[0].b[0..<t[0].n];
}
// A request's body written again by the codec from the fields it holds: its length, or -1.
cg_rewrite :: (request: string, body: string, buf: [] u8) -> int {
  nodes: [128] JvNode; j: [1] Jv;
  if !jv_parse(j[..], body, nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { return -1; }
  d := j[0];
  rev := jv_int(d, jv_get(d, 0, "rev"), 0);
  a: [1] CgText; b: [1] CgText; c: [1] CgText;
  if request == "SwitchRequest" { return editor_switch_body(rev, cg_s(d, 0, "row", a[..]), jv_kind(d, jv_get(d, 0, "on")) == JV_TRUE, false, buf); }
  if request == "ReviseRequest" { return editor_words_body(rev, "prompt", cg_s(d, 0, "prompt", a[..]), false, buf); }
  if request == "AskRequest" { return editor_words_body(rev, "words", cg_s(d, 0, "words", a[..]), false, buf); }
  if request == "AskDoneRequest" { return editor_words_body(rev, "commit", cg_s(d, 0, "commit", a[..]), false, buf); }
  if request == "AskDocRequest" { return editor_ask_doc_body(rev, cg_s(d, 0, "name", a[..]), cg_s(d, 0, "data", b[..]), buf); }
  if request == "LoreRequest" { return editor_lore_body(rev, cg_s(d, 0, "who", a[..]), cg_s(d, 0, "text", b[..]), false, buf); }
  if request == "PlaceRequest" {
    // the numbers go back as they were written
    return editor_place_body(rev, cg_s(d, 0, "thing", a[..]), jv_raw(d, jv_get(d, 0, "x")), jv_raw(d, jv_get(d, 0, "z")), jv_raw(d, jv_get(d, 0, "yaw")), false, buf);
  }
  if request == "SettingsRequest" {
    tools := jv_get(d, 0, "tools"); names: [8] string; on: [8] bool; k := 0;
    for i: 0..<jv_len(d, tools) { if k < 8 { e := jv_at(d, tools, i); names[k] = jv_key(d, e); on[k] = jv_kind(d, e) == JV_TRUE; k += 1; } }
    return editor_settings_body(rev, names[0..<k], on[0..<k], buf);
  }
  if request == "QuestRequest" {
    steps := jv_get(d, 0, "steps"); texts: [3] CgText; list: [3] string; k := 0;
    for i: 0..<jv_len(d, steps) {
      if k < 3 { texts[k].n = jv_str(d, jv_at(d, steps, i), texts[k].b[..]); list[k] = ifx texts[k].n < 0 then "" else cast(string) texts[k].b[0..<texts[k].n]; k += 1; }
    }
    return editor_quest_body(rev, cg_s(d, 0, "giver", a[..]), cg_s(d, 0, "ask", b[..]), list[0..<k], cg_s(d, 0, "reward", c[..]), false, buf);
  }
  return -1;
}
cg_request :: (g: [] Cg, st: [] D_State, name: string, request: string, body: string) {
  // realms.c's own callers of describe and fork are not this codec's
  if request == "DescribeRequest" { cg_keys(g, st, name, request, body); return; }
  if request == "ForkRequest" { return; }
  cg_keys(g, st, name, request, body);
  buf: [2048] u8;
  n := cg_rewrite(request, body, buf[..]);
  got := ifx n < 0 then "" else cast(string) buf[0..<n];
  if got == body { g[0].pass += 1; return; }
  g[0].bad += 1;
  if !g[0].quiet { print("FAIL  % (the body, written by the codec)\n  got:  %\n  want: %\n", name, got, body); }
}

cg_run :: (text: string, st: [] D_State) -> int {
  nodes: [8192] JvNode; f: [1] Jv;
  if !jv_parse(f[..], text, nodes[..]) { print("FAIL  the fixture is not JSON\n"); return 1; }
  g: [1] Cg; bodies := 0;
  steps := jv_get(f[0], 0, "steps");
  for i: 0..<jv_len(f[0], steps) {
    s := jv_at(f[0], steps, i);
    nb: [160] u8; nn := jv_str(f[0], jv_get(f[0], s, "name"), nb[..]); name := ifx nn < 0 then "" else cast(string) nb[0..<nn];
    mb: [32] u8; mn := jv_str(f[0], jv_get(f[0], s, "message"), mb[..]); message := ifx mn < 0 then "" else cast(string) mb[0..<mn];
    qb: [32] u8; qn := jv_str(f[0], jv_get(f[0], s, "request"), qb[..]); request := ifx qn < 0 then "" else cast(string) qb[0..<qn];
    rb: [4096] u8; rn := jv_str(f[0], jv_get(f[0], s, "reply"), rb[..]);
    bb: [4096] u8; bn := jv_str(f[0], jv_get(f[0], s, "body"), bb[..]);
    if !cg_need(g[..], name, "the step has an answer", rn > 0) { continue; }
    reply := cast(string) rb[0..<rn];
    if message == "RouteError" { _ = cg_need(g[..], name, "the refusal is SQL's object", reply.count > 12 && reply[0..<11] == "{\"error\": \""); }
    else if message == "ErrorReply" { _ = cg_need(g[..], name, "the refusal is the API's own", reply.count > 11 && reply[0..<10] == "{\"error\":\""); }
    else if message == "MadeLines" { _ = cg_need(g[..], name, "the made realm's lines start with its slug", reply.count > 5 && reply[0..<5] == "slug "); }
    else { cg_keys(g[..], st, name, message, reply); }
    if request != "" && bn >= 0 { cg_request(g[..], st, name, request, cast(string) bb[0..<bn]); bodies += 1; }
  }
  more := jv_get(f[0], 0, "bodies");
  for i: 0..<jv_len(f[0], more) {
    s := jv_at(f[0], more, i);
    nb: [160] u8; nn := jv_str(f[0], jv_get(f[0], s, "name"), nb[..]);
    qb: [32] u8; qn := jv_str(f[0], jv_get(f[0], s, "request"), qb[..]);
    bb: [4096] u8; bn := jv_str(f[0], jv_get(f[0], s, "body"), bb[..]);
    if cg_need(g[..], "bodies", "a body has its name, its request and its text", nn > 0 && qn > 0 && bn > 0) { cg_request(g[..], st, cast(string) nb[0..<nn], cast(string) qb[0..<qn], cast(string) bb[0..<bn]); bodies += 1; }
  }
  _ = cg_need(g[..], "the fixture", "it holds request bodies of every kind", bodies >= 16);
  print("% realm edit goldens hold, % failed\n", g[0].pass, g[0].bad);
  return ifx g[0].bad == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  path := ifx loaded && args_count(args[..]) >= 1 then args_at(args[..], 0) else CG_FIXTURE_PATH;
  buf: [262144] u8;
  n := fs_read(path, buf[..]);
  if n <= 0 { tool_errln("change-goldens: cannot read the fixture"); return 2; }
  pb: [65536] u8;
  pn := fs_read(CG_DESCRIPTOR_PATH, pb[..]);
  if pn <= 0 { tool_errln("change-goldens: cannot read the descriptor"); return 2; }
  d: [1] PkDescriptor;
  err := pk_load(d[..], cast(string) pb[0..<pn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  st := d[0].state[..];
  // the checks bite: a body the codec writes otherwise, a key the message lacks; a good one passes
  g: [1] Cg;
  g[0] = Cg.{quiet = true};
  cg_request(g[..], st, "self", "SwitchRequest", "{\"row\": \"night\",\"on\":true}");
  spaced := g[0].bad;
  g[0] = Cg.{quiet = true};
  cg_request(g[..], st, "self", "SwitchRequest", "{\"row\":\"night\",\"off\":true}");
  keyed := g[0].bad;
  g[0] = Cg.{quiet = true};
  cg_request(g[..], st, "self", "LoreRequest", "{\"text\":\"x\",\"who\":\"m\"}");
  ordered := g[0].bad;
  g[0] = Cg.{quiet = true};
  cg_request(g[..], st, "self", "SwitchRequest", "{\"rev\":3,\"row\":\"night\",\"on\":false}");
  cg_request(g[..], st, "self", "QuestRequest", "{\"giver\":\"m\",\"ask\":\"a\",\"steps\":[\"s\",\"\"],\"reward\":\"r\"}");
  if spaced == 0 || keyed == 0 || ordered == 0 || g[0].bad != 0 { print("FAIL  the check takes a body it should refuse, or refuses a good one\n"); return 1; }
  return cg_run(cast(string) buf[0..<n], st);
}
