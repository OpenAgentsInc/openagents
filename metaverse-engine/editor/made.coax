// A realm made or forked, on the wire (compliance plan step E11, GitHub #13250;
// proto/openagents/verse/doc/v1alpha1/made.proto): what POST /api/playtest/realms (the builder's
// make) and POST /api/playtest/realms/<slug>/fork answer, and the body that asks for a fork. The
// one reader of the answer in both its forms, and the one writer of the fork's body: the builder,
// My Realm and the CLI call it.
//   ?as=lines   "slug SLUG\npath /worlds/SLUG\npage 0|1\n"   (coax/web/api/realm-wire.coax writes it)
//   JSON        {"name": "N", "path": "/worlds/SLUG", "slug": "SLUG","page":false}: SQL's object
//               as jsonb's text, and `page` added by realms.c with no spaces. A made realm's fork
//               adds "rev" and "from"; a built-in realm's fork adds "base", "from" and "rules".
// proto/verse/realm-made-v1.json holds what the server answers, held through this file by
// made-goldens.coax and through the routes by coax/web/api/tests/realm_record_checks.coax.
//   coax/bin/coax test metaverse-engine/editor/made.coax --library

#module "metaverse.engine.editor.made";
#load "doc.coax";

FORGE_MADE_NAME :: 160;   // a realm's name, at most (the server keeps 40 characters)
FORGE_MADE_PATH :: 80;    // "/worlds/" and a slug
FORGE_MADE_RULES :: 16;   // a fork's rules, at most (the server's bound)
FORGE_MADE_RULE :: 24;    // a rule's id: [a-z0-9-]

// What a make or a fork answered. path is the realm's page as the answer names it ("/worlds/SLUG", or
// "/realms/SLUG" from an API before worlds), "" when it names none or another
// realm's; page is whether that page was written. The JSON form also says name, and for a fork
// the realm it came from (from, with rev for a made realm's, base and rules for a built-in one's).
ForgeMade :: struct {
  ok: bool; slug: [FORGE_SLUG] u8; slug_n: int; path: [FORGE_MADE_PATH] u8; path_n: int; page: bool; page_said: bool;
  name: [FORGE_MADE_NAME] u8; name_n: int; from: [FORGE_SLUG] u8; from_n: int; base: [FORGE_SLUG] u8; base_n: int; rev: int;
  rules: [FORGE_MADE_RULES * FORGE_MADE_RULE] u8; rule_n: [FORGE_MADE_RULES] int; rules_n: int; rules_said: bool;
}
forge_made_slug :: (m: [] ForgeMade) -> string { return cast(string) m[0].slug[0..<m[0].slug_n]; }
forge_made_path :: (m: [] ForgeMade) -> string { return cast(string) m[0].path[0..<m[0].path_n]; }
forge_made_name :: (m: [] ForgeMade) -> string { return cast(string) m[0].name[0..<m[0].name_n]; }
forge_made_from :: (m: [] ForgeMade) -> string { return cast(string) m[0].from[0..<m[0].from_n]; }
forge_made_base :: (m: [] ForgeMade) -> string { return cast(string) m[0].base[0..<m[0].base_n]; }
forge_made_rule :: (m: [] ForgeMade, k: int) -> string { return cast(string) m[0].rules[k * FORGE_MADE_RULE..<k * FORGE_MADE_RULE + m[0].rule_n[k]]; }
// Whether path is slug's page: "/worlds/SLUG" or "/realms/SLUG".
forge_made_path_ok :: (path: string, slug: string) -> bool {
  return path.count == slug.count + 8 && (path[0..<8] == "/worlds/" || path[0..<8] == "/realms/") && path[8..<path.count] == slug;
}
forge_rule_ok :: (id: string) -> bool {
  if id.count < 1 || id.count > FORGE_MADE_RULE { return false; }
  for c: id { if !(forge_lower(c) || forge_digit(c) || c == '-') { return false; } }
  return true;
}
// Where the page goes after a make or a fork: the realm's own page when it was written, else the
// built page with the slug as its hash (a private realm, or a server with no bucket). Its length
// in out, or -1.
forge_made_goes :: (m: [] ForgeMade, out: [] u8) -> int {
  if !m[0].ok { return -1; }
  if m[0].page && m[0].path_n > 0 { return forge_put(out, forge_put(out, 0, "/worlds/"), forge_made_slug(m)); }
  return forge_put(out, forge_put(out, 0, "/worlds/built#"), forge_made_slug(m));
}

// The ?as=lines answer read: ok when it names a slug. A line it doesn't know is passed over.
forge_read_made :: (text: string) -> ForgeMade {
  m: [1] ForgeMade;
  path := ""; at := 0;
  for end: 0..<text.count + 1 {
    if end < text.count && text[end] != '\n' { continue; }
    line := text[at..<end]; at = end + 1;
    if line.count > 5 && line[0..<5] == "slug " {
      slug := line[5..<line.count];
      if !forge_slug_ok(slug) { return ForgeMade.{}; }
      for i: 0..<slug.count { m[0].slug[i] = slug[i]; } m[0].slug_n = slug.count;
    }
    if line.count > 5 && line[0..<5] == "path " { path = line[5..<line.count]; }
    if line == "page 1" { m[0].page = true; m[0].page_said = true; }
    if line == "page 0" { m[0].page = false; m[0].page_said = true; }
  }
  if m[0].slug_n == 0 { return ForgeMade.{}; }
  if forge_made_path_ok(path, forge_made_slug(m[..])) { for i: 0..<path.count { m[0].path[i] = path[i]; } m[0].path_n = path.count; }
  m[0].ok = true;
  return m[0];
}
// The JSON answer read: ok when it has a slug, a name and that slug's path; a member of another
// kind refuses it whole.
forge_read_made_json :: (body: string) -> ForgeMade {
  none: ForgeMade; m: [1] ForgeMade;
  nodes: [96] JvNode; j: [1] Jv; pb: [FORGE_MADE_PATH] u8;
  if !jv_parse(j[..], body, nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { return none; }
  m[0].slug_n = jv_str(j[0], jv_get(j[0], 0, "slug"), m[0].slug[..]);
  m[0].name_n = jv_str(j[0], jv_get(j[0], 0, "name"), m[0].name[..]);
  pn := jv_str(j[0], jv_get(j[0], 0, "path"), pb[..]);
  if m[0].slug_n < 0 || m[0].name_n < 0 || pn < 0 || !forge_slug_ok(forge_made_slug(m[..])) || !forge_made_path_ok(cast(string) pb[0..<pn], forge_made_slug(m[..])) { return none; }
  for i: 0..<pn { m[0].path[i] = pb[i]; } m[0].path_n = pn;
  page := jv_get(j[0], 0, "page");
  if page >= 0 {
    if jv_kind(j[0], page) != JV_TRUE && jv_kind(j[0], page) != JV_FALSE { return none; }
    m[0].page = jv_kind(j[0], page) == JV_TRUE; m[0].page_said = true;
  }
  if jv_get(j[0], 0, "from") >= 0 {
    m[0].from_n = jv_str(j[0], jv_get(j[0], 0, "from"), m[0].from[..]);
    if m[0].from_n < 0 || !forge_slug_ok(forge_made_from(m[..])) { return none; }
  }
  if jv_get(j[0], 0, "base") >= 0 {
    m[0].base_n = jv_str(j[0], jv_get(j[0], 0, "base"), m[0].base[..]);
    if m[0].base_n < 0 || !forge_slug_ok(forge_made_base(m[..])) { return none; }
  }
  if jv_get(j[0], 0, "rev") >= 0 {
    m[0].rev = forge_whole(forge_num(j[0], jv_get(j[0], 0, "rev")), 1, FORGE_REV_MOST);
    if m[0].rev < 1 { return none; }
  }
  rules := jv_get(j[0], 0, "rules");
  if rules >= 0 {
    if jv_kind(j[0], rules) != JV_ARRAY || jv_len(j[0], rules) > FORGE_MADE_RULES { return none; }
    for k: 0..<jv_len(j[0], rules) {
      n := jv_str(j[0], jv_at(j[0], rules, k), m[0].rules[k * FORGE_MADE_RULE..<(k + 1) * FORGE_MADE_RULE]);
      if n < 0 || !forge_rule_ok(cast(string) m[0].rules[k * FORGE_MADE_RULE..<k * FORGE_MADE_RULE + n]) { return none; }
      m[0].rule_n[k] = n;
    }
    m[0].rules_n = jv_len(j[0], rules); m[0].rules_said = true;
  }
  m[0].ok = true;
  return m[0];
}
// The JSON answer written: SQL's object (keys by length, then by bytes: rev, base, from, name,
// path, slug, rules, each only when it has one) and, when page was said, realms.c's `page` after
// it with no spaces. Its length, or -1.
forge_made_json :: (m: [] ForgeMade, buf: [] u8) -> int {
  o: [1] Jo; jo_start(o[..], buf);
  jo_byte(o[..], '{');
  if m[0].rev >= 1 { jo_put(o[..], "\"rev\": "); forge_jo_int(o[..], m[0].rev); jo_put(o[..], ", "); }
  if m[0].base_n > 0 { jo_put(o[..], "\"base\": "); jo_quoted(o[..], forge_made_base(m)); jo_put(o[..], ", "); }
  if m[0].from_n > 0 { jo_put(o[..], "\"from\": "); jo_quoted(o[..], forge_made_from(m)); jo_put(o[..], ", "); }
  jo_put(o[..], "\"name\": "); jo_quoted(o[..], forge_made_name(m));
  jo_put(o[..], ", \"path\": "); jo_quoted(o[..], forge_made_path(m));
  jo_put(o[..], ", \"slug\": "); jo_quoted(o[..], forge_made_slug(m));
  if m[0].rules_said {
    jo_put(o[..], ", \"rules\": [");
    for k: 0..<m[0].rules_n { if k > 0 { jo_put(o[..], ", "); } jo_quoted(o[..], forge_made_rule(m, k)); }
    jo_byte(o[..], ']');
  }
  if m[0].page_said { jo_put(o[..], ifx m[0].page then ",\"page\":true" else ",\"page\":false"); }
  jo_byte(o[..], '}');
  return ifx o[0].bad then -1 else o[0].n;
}

// POST .../<slug>/fork's body. A made realm's fork: {} or {"name":"N"} (with_rules false). A
// built-in realm's: {"rules":["a","b"]} with the rules switched on, then the name when there is
// one. Its length, or -1 when a rule is no rule's id or buf is short.
forge_fork_body :: (with_rules: bool, rules: [] string, name: string, buf: [] u8) -> int {
  o: [1] Jo; jo_start(o[..], buf);
  jo_byte(o[..], '{');
  if with_rules {
    if rules.count > FORGE_MADE_RULES { return -1; }
    jo_put(o[..], "\"rules\":[");
    for k: 0..<rules.count {
      if !forge_rule_ok(rules[k]) { return -1; }
      if k > 0 { jo_byte(o[..], ','); }
      jo_quoted(o[..], rules[k]);
    }
    jo_byte(o[..], ']');
  }
  if name != "" { if with_rules { jo_byte(o[..], ','); } jo_put(o[..], "\"name\":"); jo_quoted(o[..], name); }
  jo_byte(o[..], '}');
  return ifx o[0].bad then -1 else o[0].n;
}

// ---- a built-in realm's fork pane (docs/metaverse/realm-fork.md): fork info and a fork's publish
FORGE_FORK_TEXT :: 200;    // a title, a maker or a name, at most
FORGE_FORK_LABEL :: 96;    // a rule's label, at most
// GET .../<slug>/fork, text a line each (SQL's verse.fork_info):
//   base SLUG, title TITLE, fork 0|1, from SLUG|NAME (a fork only), maker MAKER, name NAME,
//   owner 0|1, published 0|1, then "rule ID 0|1 LABEL" for each rule of the base.
ForgeForkInfo :: struct {
  ok: bool; fork: bool; owner: bool; published: bool;
  base: [FORGE_SLUG] u8; base_n: int; from: [FORGE_SLUG] u8; from_n: int;
  title: [FORGE_FORK_TEXT] u8; title_n: int; from_name: [FORGE_FORK_TEXT] u8; from_name_n: int;
  maker: [FORGE_FORK_TEXT] u8; maker_n: int; name: [FORGE_FORK_TEXT] u8; name_n: int;
  rule_id: [FORGE_MADE_RULES * FORGE_MADE_RULE] u8; rule_id_n: [FORGE_MADE_RULES] int; rule_on: [FORGE_MADE_RULES] bool;
  rule_label: [FORGE_MADE_RULES * FORGE_FORK_LABEL] u8; rule_label_n: [FORGE_MADE_RULES] int; rules_n: int;
}
forge_fork_base :: (f: [] ForgeForkInfo) -> string { return cast(string) f[0].base[0..<f[0].base_n]; }
forge_fork_from :: (f: [] ForgeForkInfo) -> string { return cast(string) f[0].from[0..<f[0].from_n]; }
forge_fork_title :: (f: [] ForgeForkInfo) -> string { return cast(string) f[0].title[0..<f[0].title_n]; }
forge_fork_from_name :: (f: [] ForgeForkInfo) -> string { return cast(string) f[0].from_name[0..<f[0].from_name_n]; }
forge_fork_maker :: (f: [] ForgeForkInfo) -> string { return cast(string) f[0].maker[0..<f[0].maker_n]; }
forge_fork_name :: (f: [] ForgeForkInfo) -> string { return cast(string) f[0].name[0..<f[0].name_n]; }
forge_fork_rule_id :: (f: [] ForgeForkInfo, k: int) -> string { return cast(string) f[0].rule_id[k * FORGE_MADE_RULE..<k * FORGE_MADE_RULE + f[0].rule_id_n[k]]; }
forge_fork_rule_label :: (f: [] ForgeForkInfo, k: int) -> string { return cast(string) f[0].rule_label[k * FORGE_FORK_LABEL..<k * FORGE_FORK_LABEL + f[0].rule_label_n[k]]; }
// text into buf: its length, or -1 when it does not fit.
forge_fork_keep :: (buf: [] u8, text: string) -> int {
  if text.count > buf.count { return -1; }
  for i: 0..<text.count { buf[i] = text[i]; }
  return text.count;
}
// Fork info read into f: false (f not ok) when it names no base, a line is not of its kind or a
// text does not fit. A line of another key is passed over.
forge_read_fork_info :: (f: [] ForgeForkInfo, text: string) -> bool {
  f[0] = ForgeForkInfo.{};
  at := 0; said_fork := false;
  for end: 0..<text.count + 1 {
    if end < text.count && text[end] != '\n' { continue; }
    line := text[at..<end]; at = end + 1;
    sp := 0; while sp < line.count && line[sp] != ' ' { sp += 1; }
    if sp >= line.count { continue; }
    key := line[0..<sp]; rest := line[sp + 1..<line.count];
    if key == "base" { f[0].base_n = forge_fork_keep(f[0].base[..], rest); if f[0].base_n < 0 || !forge_slug_ok(rest) { return false; } }
    else if key == "title" { f[0].title_n = forge_fork_keep(f[0].title[..], rest); if f[0].title_n < 0 { return false; } }
    else if key == "maker" { f[0].maker_n = forge_fork_keep(f[0].maker[..], rest); if f[0].maker_n < 0 { return false; } }
    else if key == "name" { f[0].name_n = forge_fork_keep(f[0].name[..], rest); if f[0].name_n < 0 { return false; } }
    else if key == "fork" || key == "owner" || key == "published" {
      if rest != "0" && rest != "1" { return false; }
      if key == "fork" { f[0].fork = rest == "1"; said_fork = true; } else if key == "owner" { f[0].owner = rest == "1"; } else { f[0].published = rest == "1"; }
    }
    else if key == "from" {
      bar := 0; while bar < rest.count && rest[bar] != '|' { bar += 1; }
      if bar >= rest.count || !forge_slug_ok(rest[0..<bar]) { return false; }
      f[0].from_n = forge_fork_keep(f[0].from[..], rest[0..<bar]);
      f[0].from_name_n = forge_fork_keep(f[0].from_name[..], rest[bar + 1..<rest.count]);
      if f[0].from_n < 0 || f[0].from_name_n < 0 { return false; }
    }
    else if key == "rule" {
      a := 0; while a < rest.count && rest[a] != ' ' { a += 1; }
      k := f[0].rules_n;
      if k >= FORGE_MADE_RULES || !forge_rule_ok(rest[0..<a]) || a + 2 > rest.count || (rest[a + 1] != '0' && rest[a + 1] != '1') { return false; }
      if a + 2 < rest.count && rest[a + 2] != ' ' { return false; }
      label := ifx a + 3 <= rest.count then rest[a + 3..<rest.count] else "";
      f[0].rule_id_n[k] = forge_fork_keep(f[0].rule_id[k * FORGE_MADE_RULE..<(k + 1) * FORGE_MADE_RULE], rest[0..<a]);
      f[0].rule_label_n[k] = forge_fork_keep(f[0].rule_label[k * FORGE_FORK_LABEL..<(k + 1) * FORGE_FORK_LABEL], label);
      if f[0].rule_label_n[k] < 0 { return false; }
      f[0].rule_on[k] = rest[a + 1] == '1'; f[0].rules_n = k + 1;
    }
  }
  if f[0].base_n == 0 || !said_fork || (f[0].fork && f[0].from_n == 0) { f[0] = ForgeForkInfo.{}; return false; }
  f[0].ok = true;
  return true;
}
// Fork info written, as SQL writes it: its length, or -1.
forge_fork_info_lines :: (f: [] ForgeForkInfo, buf: [] u8) -> int {
  n := forge_put(buf, forge_put(buf, forge_put(buf, 0, "base "), forge_fork_base(f)), "\ntitle ");
  n = forge_put(buf, forge_put(buf, n, forge_fork_title(f)), ifx f[0].fork then "\nfork 1\n" else "\nfork 0\n");
  if f[0].fork { n = forge_put(buf, forge_put(buf, forge_put(buf, forge_put(buf, forge_put(buf, n, "from "), forge_fork_from(f)), "|"), forge_fork_from_name(f)), "\n"); }
  n = forge_put(buf, forge_put(buf, forge_put(buf, n, "maker "), forge_fork_maker(f)), "\nname ");
  n = forge_put(buf, forge_put(buf, n, forge_fork_name(f)), ifx f[0].owner then "\nowner 1\n" else "\nowner 0\n");
  n = forge_put(buf, n, ifx f[0].published then "published 1\n" else "published 0\n");
  for k: 0..<f[0].rules_n {
    n = forge_put(buf, forge_put(buf, forge_put(buf, n, "rule "), forge_fork_rule_id(f, k)), ifx f[0].rule_on[k] then " 1 " else " 0 ");
    n = forge_put(buf, forge_put(buf, n, forge_fork_rule_label(f, k)), "\n");
  }
  return n;
}
// POST .../<fork>/publish from the fork pane: {"published":true} lists the fork, false takes it off.
forge_fork_publish_body :: (published: bool, buf: [] u8) -> int {
  return forge_put(buf, 0, ifx published then "{\"published\":true}" else "{\"published\":false}");
}
// 200 from a fork's publish: {"listed": true, "published": true, "visibility": "public",
// "description": "A fork of ..."}; listed and visibility are said since migration 0110 (listed
// < 0 and vis "" leave them out, as a server before it answers).
forge_fork_published_json :: (listed: int, published: bool, vis: string, description: string, buf: [] u8) -> int {
  o: [1] Jo; jo_start(o[..], buf);
  jo_byte(o[..], '{');
  if listed >= 0 { jo_put(o[..], ifx listed > 0 then "\"listed\": true, " else "\"listed\": false, "); }
  jo_put(o[..], ifx published then "\"published\": true, " else "\"published\": false, ");
  if vis != "" { jo_put(o[..], "\"visibility\": "); jo_quoted(o[..], vis); jo_put(o[..], ", "); }
  jo_put(o[..], "\"description\": "); jo_quoted(o[..], description); jo_byte(o[..], '}');
  return ifx o[0].bad then -1 else o[0].n;
}
ForgeForkPublished :: struct { ok: bool; published: bool; listed: int = -1; vis: [12] u8; vis_n: int; description: [400] u8; description_n: int; }
forge_read_fork_published :: (body: string) -> ForgeForkPublished {
  r: ForgeForkPublished;
  nodes: [16] JvNode; j: [1] Jv;
  if !jv_parse(j[..], body, nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { return r; }
  p := jv_kind(j[0], jv_get(j[0], 0, "published"));
  r.description_n = jv_str(j[0], jv_get(j[0], 0, "description"), r.description[..]);
  if (p != JV_TRUE && p != JV_FALSE) || r.description_n < 0 { return ForgeForkPublished.{}; }
  l := jv_get(j[0], 0, "listed");
  if l >= 0 {
    if jv_kind(j[0], l) != JV_TRUE && jv_kind(j[0], l) != JV_FALSE { return ForgeForkPublished.{}; }
    r.listed = ifx jv_kind(j[0], l) == JV_TRUE then 1 else 0;
  }
  if jv_get(j[0], 0, "visibility") >= 0 {
    r.vis_n = jv_str(j[0], jv_get(j[0], 0, "visibility"), r.vis[..]);
    v := ifx r.vis_n < 0 then "" else cast(string) r.vis[0..<r.vis_n];
    if v != "private" && v != "unlisted" && v != "public" { return ForgeForkPublished.{}; }
  }
  r.published = p == JV_TRUE; r.ok = true;
  return r;
}

#test "the lines of a made realm: its slug, its own path and whether its page was written" {
  m: [1] ForgeMade; out: [96] u8;
  m[0] = forge_read_made("slug moonlit-marsh\npath /worlds/moonlit-marsh\npage 1\n");
  #assert m[0].ok && forge_made_slug(m[..]) == "moonlit-marsh" && forge_made_path(m[..]) == "/worlds/moonlit-marsh" && m[0].page && m[0].page_said;
  n := forge_made_goes(m[..], out[..]);
  #assert cast(string) out[0..<n] == "/worlds/moonlit-marsh";
  m[0] = forge_read_made("slug moonlit-marsh\npath /worlds/moonlit-marsh\npage 0\n");
  #assert m[0].ok && !m[0].page && m[0].page_said;
  n = forge_made_goes(m[..], out[..]);
  #assert cast(string) out[0..<n] == "/worlds/built#moonlit-marsh" && forge_made_goes(m[..], out[0..<26]) == -1;
  // an API from before worlds says /realms/; the page still goes to /worlds/
  m[0] = forge_read_made("slug a\npath /realms/a\npage 1");
  #assert m[0].ok && forge_made_path(m[..]) == "/realms/a";
  n = forge_made_goes(m[..], out[..]);
  #assert cast(string) out[0..<n] == "/worlds/a" && forge_made_goes(m[..], out[0..<8]) == -1;
  // another realm's path, or none, is no path: the page goes to the built page
  m[0] = forge_read_made("slug a\npath /worlds/b\npage 1\n");
  #assert m[0].ok && m[0].path_n == 0;
  n = forge_made_goes(m[..], out[..]);
  #assert cast(string) out[0..<n] == "/worlds/built#a";
  m[0] = forge_read_made("slug a\npath /elsewhere/a\npage 1\n");
  #assert m[0].ok && m[0].path_n == 0;
  m[0] = forge_read_made("slug a\npage 1\n");
  #assert m[0].ok && m[0].path_n == 0 && m[0].page;
  m[0] = forge_read_made("note x\nslug a\n");
  #assert m[0].ok && !m[0].page && !m[0].page_said && forge_made_slug(m[..]) == "a";
  // no slug, or one that is none, refuses it; so does asking where a refused one goes
  #assert !forge_read_made("").ok && !forge_read_made("path /worlds/a\npage 1\n").ok && !forge_read_made("slug A b\npath /worlds/a\n").ok && !forge_read_made("slug \n").ok && !forge_read_made("slugs a\n").ok;
  m[0] = forge_read_made("");
  #assert forge_made_goes(m[..], out[..]) == -1;
  #assert forge_made_path_ok("/worlds/a", "a") && forge_made_path_ok("/realms/a", "a") && !forge_made_path_ok("/worlds/ab", "a") && !forge_made_path_ok("/worlds/a", "ab") && !forge_made_path_ok("/realmz/a", "a") && !forge_made_path_ok("", "a");
}
#test "the JSON answer of a make and of both forks is read and written back; a wrong kind refuses it" {
  m: [1] ForgeMade; buf: [512] u8;
  made := "{\"name\": \"Moonlit Marsh\", \"path\": \"/realms/moonlit-marsh\", \"slug\": \"moonlit-marsh\",\"page\":true}";
  m[0] = forge_read_made_json(made);
  #assert m[0].ok && forge_made_slug(m[..]) == "moonlit-marsh" && forge_made_name(m[..]) == "Moonlit Marsh" && forge_made_path(m[..]) == "/realms/moonlit-marsh" && m[0].page && m[0].page_said && m[0].rev == 0 && m[0].from_n == 0 && !m[0].rules_said;
  n := forge_made_json(m[..], buf[..]);
  #assert cast(string) buf[0..<n] == made && forge_made_json(m[..], buf[0..<n - 1]) == -1;
  fork := "{\"rev\": 3, \"from\": \"moonlit-marsh\", \"name\": \"Moonlit Marsh Fork\", \"path\": \"/realms/moonlit-marsh-fork\", \"slug\": \"moonlit-marsh-fork\",\"page\":false}";
  m[0] = forge_read_made_json(fork);
  #assert m[0].ok && m[0].rev == 3 && forge_made_from(m[..]) == "moonlit-marsh" && !m[0].page && m[0].page_said;
  n = forge_made_json(m[..], buf[..]);
  #assert cast(string) buf[0..<n] == fork;
  rules := "{\"base\": \"everglade\", \"from\": \"everglade\", \"name\": \"Doomglade\", \"path\": \"/realms/doomglade\", \"slug\": \"doomglade\", \"rules\": [\"night\", \"waves\"],\"page\":true}";
  m[0] = forge_read_made_json(rules);
  #assert m[0].ok && forge_made_base(m[..]) == "everglade" && m[0].rules_said && m[0].rules_n == 2 && forge_made_rule(m[..], 0) == "night" && forge_made_rule(m[..], 1) == "waves";
  n = forge_made_json(m[..], buf[..]);
  #assert cast(string) buf[0..<n] == rules;
  none := "{\"base\": \"everglade\", \"from\": \"everglade\", \"name\": \"E\", \"path\": \"/realms/e\", \"slug\": \"e\", \"rules\": []}";
  m[0] = forge_read_made_json(none);
  #assert m[0].ok && m[0].rules_said && m[0].rules_n == 0 && !m[0].page_said;
  n = forge_made_json(m[..], buf[..]);
  #assert cast(string) buf[0..<n] == none;
  #assert !forge_read_made_json("[]").ok && !forge_read_made_json("{").ok && !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/s\"}").ok && !forge_read_made_json("{\"path\": \"/realms/s\", \"slug\": \"s\"}").ok && !forge_read_made_json("{\"name\": \"N\", \"slug\": \"s\"}").ok;
  #assert !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/t\", \"slug\": \"s\"}").ok && !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/S\", \"slug\": \"S\"}").ok && !forge_read_made_json("{\"name\": 4, \"path\": \"/realms/s\", \"slug\": \"s\"}").ok;
  #assert !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\",\"page\":1}").ok && !forge_read_made_json("{\"rev\": 0, \"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\"}").ok && !forge_read_made_json("{\"rev\": \"3\", \"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\"}").ok;
  #assert !forge_read_made_json("{\"from\": \"S!\", \"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\"}").ok && !forge_read_made_json("{\"from\": 1, \"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\"}").ok && !forge_read_made_json("{\"base\": \"B\", \"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\"}").ok && !forge_read_made_json("{\"base\": 2, \"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\"}").ok;
  #assert !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\", \"rules\": {}}").ok && !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\", \"rules\": [\"Night\"]}").ok && !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\", \"rules\": [4]}").ok;
  #assert !forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\", \"rules\": [\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\"]}").ok;
  m[0] = forge_read_made_json("{\"name\": \"N\", \"path\": \"/realms/s\", \"slug\": \"s\", \"rules\": [\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\"]}");
  #assert m[0].ok && m[0].rules_n == 16 && forge_made_rule(m[..], 15) == "a";
  #assert forge_rule_ok("night") && forge_rule_ok("no-destroy2") && !forge_rule_ok("") && !forge_rule_ok("Night") && !forge_rule_ok("a b") && forge_rule_ok("abcdefghijklmnopqrstuvwx") && !forge_rule_ok("abcdefghijklmnopqrstuvwxy");
}
#test "a fork's body: a made realm's with or without a name, a built-in realm's with its rules" {
  buf: [256] u8; no: [1] string;
  n := forge_fork_body(false, no[0..<0], "", buf[..]);
  #assert cast(string) buf[0..<n] == "{}";
  n = forge_fork_body(false, no[0..<0], "My \"Fork\"", buf[..]);
  #assert cast(string) buf[0..<n] == "{\"name\":\"My \\\"Fork\\\"\"}" && forge_fork_body(false, no[0..<0], "My \"Fork\"", buf[0..<n - 1]) == -1;
  n = forge_fork_body(true, no[0..<0], "", buf[..]);
  #assert cast(string) buf[0..<n] == "{\"rules\":[]}";
  n = forge_fork_body(true, no[0..<0], "Doomglade", buf[..]);
  #assert cast(string) buf[0..<n] == "{\"rules\":[],\"name\":\"Doomglade\"}";
  two := [2] string.["night", "waves"];
  n = forge_fork_body(true, two[..], "", buf[..]);
  #assert cast(string) buf[0..<n] == "{\"rules\":[\"night\",\"waves\"]}";
  n = forge_fork_body(true, two[0..<1], "D", buf[..]);
  #assert cast(string) buf[0..<n] == "{\"rules\":[\"night\"],\"name\":\"D\"}";
  // rules are not sent for a made realm's fork, and a rule that is no id refuses the body
  n = forge_fork_body(false, two[..], "", buf[..]);
  #assert cast(string) buf[0..<n] == "{}";
  bad := [2] string.["night", "No"];
  #assert forge_fork_body(true, bad[..], "", buf[..]) == -1;
  many: [17] string; for k: 0..<17 { many[k] = "a"; }
  #assert forge_fork_body(true, many[..], "", buf[..]) == -1 && forge_fork_body(true, many[0..<16], "", buf[..]) > 0;
}
#test "fork info: Everglade itself and a fork of it are read and written back; a broken line refuses it" {
  f: [1] ForgeForkInfo; buf: [1024] u8;
  base := "base everglade\ntitle Everglade\nfork 0\nmaker OpenAgents\nname Everglade\nowner 0\npublished 0\nrule night 0 Always night\nrule waves 1 Hostile waves\n";
  #assert forge_read_fork_info(f[..], base) && f[0].ok && forge_fork_base(f[..]) == "everglade" && forge_fork_title(f[..]) == "Everglade" && !f[0].fork && f[0].from_n == 0;
  #assert forge_fork_maker(f[..]) == "OpenAgents" && forge_fork_name(f[..]) == "Everglade" && !f[0].owner && !f[0].published && f[0].rules_n == 2;
  #assert forge_fork_rule_id(f[..], 0) == "night" && !f[0].rule_on[0] && forge_fork_rule_label(f[..], 0) == "Always night" && forge_fork_rule_id(f[..], 1) == "waves" && f[0].rule_on[1] && forge_fork_rule_label(f[..], 1) == "Hostile waves";
  n := forge_fork_info_lines(f[..], buf[..]);
  #assert cast(string) buf[0..<n] == base && forge_fork_info_lines(f[..], buf[0..<n - 1]) == -1;
  fork := "base everglade\ntitle Everglade\nfork 1\nfrom everglade|Everglade\nmaker Open<Agents>\nname Doom|glade\nowner 1\npublished 1\nrule waves 1 Hostile waves\n";
  #assert forge_read_fork_info(f[..], fork) && f[0].fork && forge_fork_from(f[..]) == "everglade" && forge_fork_from_name(f[..]) == "Everglade" && forge_fork_maker(f[..]) == "Open<Agents>" && forge_fork_name(f[..]) == "Doom|glade" && f[0].owner && f[0].published;
  n = forge_fork_info_lines(f[..], buf[..]);
  #assert cast(string) buf[0..<n] == fork;
  // a base with no rules; a rule with no label; a key this reader does not know
  #assert forge_read_fork_info(f[..], "base e\ntitle E\nfork 0\nmaker M\nname E\nowner 0\npublished 0\n") && f[0].rules_n == 0;
  #assert forge_read_fork_info(f[..], "base e\ntitle E\nfork 0\nnote x y\nrule night 1\n") && f[0].rules_n == 1 && f[0].rule_on[0] && f[0].rule_label_n[0] == 0;
  n = forge_fork_info_lines(f[..], buf[..]);
  #assert cast(string) buf[0..<n] == "base e\ntitle E\nfork 0\nmaker \nname \nowner 0\npublished 0\nrule night 1 \n";
  // refused whole
  #assert !forge_read_fork_info(f[..], "") && !f[0].ok && !forge_read_fork_info(f[..], "title E\nfork 0\n") && !forge_read_fork_info(f[..], "base e\ntitle E\n") && !forge_read_fork_info(f[..], "base E!\nfork 0\n");
  #assert !forge_read_fork_info(f[..], "base e\nfork 2\n") && !forge_read_fork_info(f[..], "base e\nfork 0\nowner yes\n") && !forge_read_fork_info(f[..], "base e\nfork 0\npublished x\n");
  #assert !forge_read_fork_info(f[..], "base e\nfork 1\n") && !forge_read_fork_info(f[..], "base e\nfork 1\nfrom e\n") && !forge_read_fork_info(f[..], "base e\nfork 1\nfrom E!|E\n") && forge_read_fork_info(f[..], "base e\nfork 1\nfrom e|\n");
  #assert !forge_read_fork_info(f[..], "base e\nfork 0\nrule Night 1 L\n") && !forge_read_fork_info(f[..], "base e\nfork 0\nrule night 2 L\n") && !forge_read_fork_info(f[..], "base e\nfork 0\nrule night\n") && !forge_read_fork_info(f[..], "base e\nfork 0\nrule night 1L\n");
  long: [320] u8; head := "base e\nfork 0\ntitle ";
  for i: 0..<head.count { long[i] = head[i]; }
  for i: head.count..<320 { long[i] = 'w'; }
  #assert forge_read_fork_info(f[..], cast(string) long[0..<head.count + 200]) && f[0].title_n == 200 && !forge_read_fork_info(f[..], cast(string) long[0..<head.count + 201]);
  many: [600] u8; mn := forge_put(many[..], 0, "base e\nfork 0\n");
  for k: 0..<16 { mn = forge_put(many[..], mn, "rule a 1 L\n"); }
  #assert forge_read_fork_info(f[..], cast(string) many[0..<mn]) && f[0].rules_n == 16;
  mn = forge_put(many[..], mn, "rule a 1 L\n");
  #assert !forge_read_fork_info(f[..], cast(string) many[0..<mn]);
  #assert forge_fork_keep(buf[0..<2], "ab") == 2 && forge_fork_keep(buf[0..<2], "abc") == -1;
}
#test "a fork's publish: the pane's body and the answer" {
  buf: [256] u8;
  n := forge_fork_publish_body(true, buf[..]);
  #assert cast(string) buf[0..<n] == "{\"published\":true}";
  n = forge_fork_publish_body(false, buf[..]);
  #assert cast(string) buf[0..<n] == "{\"published\":false}" && forge_fork_publish_body(false, buf[0..<10]) == -1;
  want := "{\"listed\": true, \"published\": true, \"visibility\": \"public\", \"description\": \"A fork of Everglade on the Verse by OpenAgents: hostile waves.\"}";
  n = forge_fork_published_json(1, true, "public", "A fork of Everglade on the Verse by OpenAgents: hostile waves.", buf[..]);
  #assert cast(string) buf[0..<n] == want && forge_fork_published_json(1, true, "public", "A fork of Everglade on the Verse by OpenAgents: hostile waves.", buf[0..<n - 1]) == -1;
  r := forge_read_fork_published(want);
  #assert r.ok && r.published && r.listed == 1 && cast(string) r.vis[0..<r.vis_n] == "public" && cast(string) r.description[0..<r.description_n] == "A fork of Everglade on the Verse by OpenAgents: hostile waves.";
  n = forge_fork_published_json(0, false, "unlisted", "x", buf[..]);
  #assert cast(string) buf[0..<n] == "{\"listed\": false, \"published\": false, \"visibility\": \"unlisted\", \"description\": \"x\"}";
  r = forge_read_fork_published(cast(string) buf[0..<n]);
  #assert r.ok && !r.published && r.listed == 0 && cast(string) r.vis[0..<r.vis_n] == "unlisted";
  n = forge_fork_published_json(-1, true, "", "x", buf[..]);
  #assert cast(string) buf[0..<n] == "{\"published\": true, \"description\": \"x\"}";
  r = forge_read_fork_published(cast(string) buf[0..<n]);
  #assert r.ok && r.published && r.listed == -1 && r.vis_n == 0;
  #assert !forge_read_fork_published("{\"published\": 1, \"description\": \"x\"}").ok && !forge_read_fork_published("{\"published\": true}").ok && !forge_read_fork_published("{\"description\": \"x\"}").ok && !forge_read_fork_published("[]").ok && !forge_read_fork_published("{\"published\": true, \"description\": 4}").ok;
  #assert !forge_read_fork_published("{\"listed\": 1, \"published\": true, \"description\": \"x\"}").ok && !forge_read_fork_published("{\"published\": true, \"visibility\": \"open\", \"description\": \"x\"}").ok && !forge_read_fork_published("{\"published\": true, \"visibility\": 3, \"description\": \"x\"}").ok;
}
