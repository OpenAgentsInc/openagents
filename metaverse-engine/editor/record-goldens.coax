// The realm record's goldens through the codec (compliance plan step E11, GitHub #13250):
// proto/verse/realm-record-v1.json holds what coax/web/api/realms.c's record routes answer today
// (mine, visibility, publish, published) and the bodies sent to them. This reads every body and
// reply through metaverse-engine/editor/record.coax (a Conflict through doc.coax) and requires, for each step:
//   - the reply reads as its message, and written back from what was read it is the same bytes;
//   - a request's body is what the codec writes for its revision, visibility and listed (one the
//     codec refuses to write is one the server refused: status 400);
//   - every key is a json_name of its message in proto/descriptors/verse-doc.pb (record.proto);
//   - the ?as=lines text of mine is the same realms as the JSON reply before it;
//   - a refusal realms.c answers itself (ErrorReply, the API's, written by
//     coax/web/api/api-wire.coax) reads as a refusal.
// coax/web/api/tests/realm_record_checks.coax makes the same calls against the API.
//   coax/web/tool.sh metaverse-engine/editor/record-goldens.coax proto/verse/realm-record-v1.json

#import "Basic";
#load "record.coax";
#load "../../coax/lib/proto/importer.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/fs.coax";

RG_FIXTURE_PATH :: "proto/verse/realm-record-v1.json";
RG_DESCRIPTOR_PATH :: "proto/descriptors/verse-doc.pb";
RG_PKG :: ".openagents.verse.doc.v1alpha1.";
RG_ROWS :: 16;

RgDescriptor :: struct {
  types: [128] D_Type; enums: [16] D_Type; fields: [1024] D_Field; values: [256] D_Value; groups: [1024] string;
  files: [16] string; deps: [64] string; arena: [1048576] u8; output: [1] u8; symbols: [4096] string;
  state: [1] D_State;
}
rg_descriptor_load :: (g: [] RgDescriptor, raw: string) -> string {
  g[0].state[0] = D_State.{types = g[0].types[..], enums = g[0].enums[..], fields = g[0].fields[..], values = g[0].values[..], groups = g[0].groups[..],
    files = g[0].files[..], deps = g[0].deps[..], arena = g[0].arena[..], output = g[0].output[..], symbols = g[0].symbols[..]};
  D_parse(g[0].state[..], raw, "RG");
  return g[0].state[0].error;
}
Rg :: struct { bad: int; pass: int; rows: [RG_ROWS] EditorMine; rows_n: int; }
rg_need :: (g: [] Rg, name: string, what: string, ok: bool) -> bool {
  if ok { g[0].pass += 1; return true; }
  g[0].bad += 1; print("FAIL  % (%)\n", name, what);
  return false;
}
rg_same :: (g: [] Rg, name: string, what: string, got: string, want: string) {
  if got == want { g[0].pass += 1; return; }
  g[0].bad += 1; print("FAIL  % (%)\n  got:  %\n  want: %\n", name, what, got, want);
}
// Whether every key of the object at `at` is a json_name of the message (its leaf name).
rg_keys_of :: (st: [] D_State, leaf: string, j: Jv, at: int) -> bool {
  full: [128] u8; n := editor_put(full[..], 0, RG_PKG); n = editor_put(full[..], n, leaf);
  m := -1;
  for i: 0..<st[0].nt { if st[0].types[i].full == cast(string) full[0..<n] { m = i; } }
  if m < 0 || jv_kind(j, at) != JV_OBJECT { return false; }
  t := st[0].types[m];
  for i: 0..<jv_len(j, at) {
    k := jv_key(j, jv_at(j, at, i)); found := false;
    for f: t.first..<t.first + t.count { if st[0].fields[f].json == k { found = true; } }
    if !found { return false; }
  }
  return true;
}
rg_body_keys :: (st: [] D_State, leaf: string, text: string) -> bool {
  nodes: [2048] JvNode; j: [1] Jv;
  if !jv_parse(j[..], text, nodes[..]) || !rg_keys_of(st, leaf, j[0], 0) { return false; }
  if leaf == "MineReply" {
    list := jv_get(j[0], 0, "realms");
    for i: 0..<jv_len(j[0], list) { if !rg_keys_of(st, "MineRealm", j[0], jv_at(j[0], list, i)) { return false; } }
  }
  return true;
}
rg_mine_same :: (a: [] EditorMine, b: [] EditorMine) -> bool {
  return editor_mine_slug(a) == editor_mine_slug(b) && editor_mine_name(a) == editor_mine_name(b) && editor_mine_vis(a) == editor_mine_vis(b) &&
    a[0].rev == b[0].rev && a[0].published == b[0].published && a[0].listed == b[0].listed;
}

// One reply through the codec.
rg_reply :: (g: [] Rg, st: [] D_State, name: string, message: string, reply: string) {
  buf: [16384] u8;
  if message == "MineReply" {
    n := editor_read_mine(reply, g[0].rows[..]);
    if !rg_need(g, name, "the reply reads as a MineReply", n >= 0) { g[0].rows_n = 0; return; }
    g[0].rows_n = n;
    w := editor_mine_json(g[0].rows[0..<n], buf[..]);
    rg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    _ = rg_need(g, name, "its keys are MineReply's and MineRealm's", rg_body_keys(st, "MineReply", reply));
    return;
  }
  if message == "MineLines" {
    // the same realms as the JSON reply before it, a line each
    at := 0; k := 0; w := 0;
    for end: 0..<reply.count {
      if reply[end] != '\n' { continue; }
      m: [1] EditorMine; m[0] = editor_read_mine_line(reply[at..<end]); at = end + 1;
      if !rg_need(g, name, "a line reads as a realm", m[0].slug_n > 0) { return; }
      _ = rg_need(g, name, "the line is the realm the JSON reply named", k < g[0].rows_n && rg_mine_same(m[..], g[0].rows[k..<k + 1]));
      w = editor_mine_line(m[..], buf[..], w); k += 1;
      if w < 0 { break; }
    }
    _ = rg_need(g, name, "every realm of the JSON reply has its line, and no text is left over", k == g[0].rows_n && at == reply.count);
    rg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    return;
  }
  if message == "VisibilityReply" {
    r := editor_read_visibility(reply);
    if !rg_need(g, name, "the reply reads as a VisibilityReply", r.ok) { return; }
    w := editor_visibility_reply(r.rev, cast(string) r.slug[0..<r.slug_n], cast(string) r.vis[0..<r.vis_n], cast(string) r.was[0..<r.was_n], r.page, buf[..]);
    rg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    _ = rg_need(g, name, "its keys are VisibilityReply's", rg_body_keys(st, "VisibilityReply", reply));
    return;
  }
  if message == "PublishReply" {
    r := editor_read_published(reply);
    if !rg_need(g, name, "the reply reads as a PublishReply", r.ok && r.engine >= 0) { return; }
    w := editor_publish_reply(r.rev, cast(string) r.sha[..], r.listed, ifx r.engine == 1 then cast(string) r.sha_engine[..] else "", cast(string) r.vis[0..<r.vis_n], buf[..]);
    rg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    _ = rg_need(g, name, "its keys are PublishReply's", rg_body_keys(st, "PublishReply", reply));
    return;
  }
  if message == "PublishRecord" {
    r: [1] EditorRecord;
    if !rg_need(g, name, "the reply reads as a PublishRecord", editor_read_record(r[..], reply)) { return; }
    w := editor_record_json(r[..], buf[..]);
    rg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    _ = rg_need(g, name, "its keys are PublishRecord's", rg_body_keys(st, "PublishRecord", reply));
    return;
  }
  if message == "RouteError" {
    e: [EDITOR_ERROR] u8; words := editor_read_error(reply, e[..]);
    if !rg_need(g, name, "the reply reads as a RouteError", words != "") { return; }
    w := editor_error_json(words, buf[..]);
    rg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    _ = rg_need(g, name, "its only key is RouteError's", rg_body_keys(st, "RouteError", reply));
    return;
  }
  if message == "ErrorReply" {
    // the API's own refusal (openagents.api.v1alpha1, coax/web/api/api-wire.coax writes it): read here
    e: [EDITOR_ERROR] u8; words := editor_read_error(reply, e[..]);
    _ = rg_need(g, name, "the reply reads as a refusal", words != "" && reply.count == words.count + 12 && reply[0..<10] == "{\"error\":\"");
    return;
  }
  if message == "Conflict" {
    r := editor_read_reply(reply);
    if !rg_need(g, name, "the reply reads as a Conflict", r.ok && r.error_n > 0) { return; }
    rs: [1] EditorReply; rs[0] = r;
    w := editor_conflict(r.rev, editor_reply_error(rs[..]), buf[..]);
    rg_same(g, name, "written back", ifx w < 0 then "" else cast(string) buf[0..<w], reply);
    _ = rg_need(g, name, "its keys are Conflict's", rg_body_keys(st, "Conflict", reply));
    return;
  }
  _ = rg_need(g, name, "the step names a message this check knows", false);
}
// One request's body: what the codec writes for the fields it holds.
rg_request :: (g: [] Rg, st: [] D_State, name: string, request: string, body: string, status: int) {
  nodes: [32] JvNode; j: [1] Jv; buf: [256] u8; vb: [64] u8;
  if !rg_need(g, name, "the body is JSON", jv_parse(j[..], body, nodes[..]) && jv_kind(j[0], 0) == JV_OBJECT) { return; }
  _ = rg_need(g, name, "the body's keys are its message's", rg_keys_of(st, request, j[0], 0));
  rev := editor_whole(editor_num(j[0], jv_get(j[0], 0, "rev")), 1, EDITOR_REV_MOST);
  if request == "VisibilityRequest" {
    vn := editor_member(j[0], 0, "visibility", vb[..]);
    w := editor_visibility_body(rev, ifx vn < 0 then "" else cast(string) vb[0..<vn], buf[..]);
    if w < 0 { _ = rg_need(g, name, "a visibility the codec won't write is one the server refused", status == 400); return; }
    rg_same(g, name, "the body, written", cast(string) buf[0..<w], body);
    return;
  }
  if request == "PublishRequest" {
    listed := editor_flag(j[0], 0, "listed");
    w := ifx listed >= 0 then editor_publish_body(rev, listed == 1, buf[..]) else editor_rev_body(rev, buf[..]);
    rg_same(g, name, "the body, written", ifx w < 0 then "" else cast(string) buf[0..<w], body);
    return;
  }
  _ = rg_need(g, name, "the step names a request this check knows", false);
}

rg_run :: (text: string, st: [] D_State) -> int {
  nodes: [4096] JvNode; f: [1] Jv;
  if !jv_parse(f[..], text, nodes[..]) { print("FAIL  the fixture is not JSON\n"); return 1; }
  g: [1] Rg;
  steps := jv_get(f[0], 0, "steps");
  if jv_len(f[0], steps) < 20 { print("FAIL  the fixture has too few steps\n"); return 1; }
  for i: 0..<jv_len(f[0], steps) {
    s := jv_at(f[0], steps, i);
    nb: [160] u8; name := editor_str(f[0], jv_get(f[0], s, "name"), nb[..]);
    mb: [32] u8; message := editor_str(f[0], jv_get(f[0], s, "message"), mb[..]);
    qb: [32] u8; request := editor_str(f[0], jv_get(f[0], s, "request"), qb[..]);
    rb: [16384] u8; rn := jv_str(f[0], jv_get(f[0], s, "reply"), rb[..]);
    bb: [4096] u8; bn := jv_str(f[0], jv_get(f[0], s, "body"), bb[..]);
    if !rg_need(g[..], name, "the step has a reply", rn >= 0) { continue; }
    rg_reply(g[..], st, name, message, cast(string) rb[0..<rn]);
    if request != "" && bn >= 0 { rg_request(g[..], st, name, request, cast(string) bb[0..<bn], jv_int(f[0], jv_get(f[0], s, "status"), 200)); }
  }
  print("% realm record goldens hold, % failed\n", g[0].pass, g[0].bad);
  return ifx g[0].bad == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  path := ifx loaded && args_count(args[..]) >= 1 then args_at(args[..], 0) else RG_FIXTURE_PATH;
  buf: [262144] u8;
  n := fs_read(path, buf[..]);
  if n <= 0 { tool_errln("record-goldens: cannot read the fixture"); return 2; }
  pb: [65536] u8;
  pn := fs_read(RG_DESCRIPTOR_PATH, pb[..]);
  if pn <= 0 { tool_errln("record-goldens: cannot read the descriptor"); return 2; }
  d: [1] RgDescriptor;
  err := rg_descriptor_load(d[..], cast(string) pb[0..<pn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  st := d[0].state[..];
  // The key check bites: a key the message lacks fails.
  if rg_body_keys(st, "PublishReply", "{\"rev\": 2, \"sha\": \"x\"}") || !rg_body_keys(st, "PublishReply", "{\"rev\": 2, \"sha256\": \"x\"}") ||
     rg_body_keys(st, "MineReply", "{\"realms\": [{\"rev\": 1, \"title\": \"x\"}]}") {
    print("FAIL  the key check takes a body it should refuse\n"); return 1;
  }
  return rg_run(cast(string) buf[0..<n], st);
}
