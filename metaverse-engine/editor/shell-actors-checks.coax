// The checks of the shell's actors (shell-actors.coax, GitHub #13466). shell.coax loads this file
// with `#load ... #test;`.

// The model fixture with two actors and their dusk plans; the editor shows `clock`, actor `shown` (0: none).
es_test_actors :: (h: [] EsTest, rev: int, clock: string, shown: int) {
  s := h[0].s[..]; out := h[0].text[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true;
  n := em_begin(out, "splice", 0, rev, 0, 0, 0);
  n = em_cols(out, n, cols[..]);
  n = em_kind(out, n, 1001, "Cargo crate");
  n = em_entity(out, n, 1, 1001, 350, 0, -1200, 90, 100);
  n = em_plans(out, n, "plans");
  n = em_clock(out, n, "clock", clock);
  n = em_actor(out, n, 1, "Raider 1");
  n = em_actor(out, n, 6, "Imperial 1");
  n = em_plan(out, n, 1, "dusk", "dance", 0, 0, "chase", "-600 -4800");
  n = em_plan(out, n, 6, "dusk", "patrol", 180, 500, "chase", "850 -4500, 850 -5700");
  n = em_plan(out, n, 6, "dawn", "guard", 0, 800, "call", "0 -3700, 0 -3000");
  if shown > 0 { n = em_asel(out, n, shown); }
  for i: 0..<n { s[0].inbox[i] = out[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, n);
}
// The waiting action's one cell edit: its table, row, column and value as "TABLE ROW COL VALUE", or "".
es_test_cell :: (h: [] EsTest, rev: int, out: [] u8) -> string {
  if es_test_batch(h, rev) != WB_APPLY || h[0].edits[0].op != WE_CELL { return ""; }
  e := h[0].edits[0];
  n := ct_put(out, 0, cast(string) e.table[0..<e.table_n]); n = ct_put(out, n, " "); n = ct_put_int(out, n, e.id); n = ct_put(out, n, " ");
  n = ct_put(out, n, cast(string) e.name[0..<e.name_n]); n = ct_put(out, n, " "); n = ct_put(out, n, cast(string) e.text[0..<e.text_n]);
  return cast(string) out[0..<n];
}

#test "a world with actors: a time-of-day control, an Actors list, and picking one asks the page to show it" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..]; o: [160] u8;
  es_test_actors(h[..], 5, "dusk", 0); es_test_frames(h[..], 1);
  #assert tr_find(t, "clock") > 0 && tr_find(t, "actors.list") > 0 && tr_find(t, "actor.1") > 0 && tr_find(t, "actor.6") > 0 && tr_find(t, "plan.card") < 0;
  // the Actors header is closed: the list is not inside it, and the things and the actors are in the one side, under what is selected
  #assert t[0].nodes[tr_find(t, "actors.list")].parent != tr_find(t, "actors.head") && t[0].nodes[tr_find(t, "things")].parent == tr_find(t, "one.b") && t[0].nodes[tr_find(t, "actors.list")].parent == tr_find(t, "one.b");
  // the time of day: a cell edit of the clock table's row 1; the one it is changes nothing
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "clock"), 0); es_test_frames(h[..], 1);
  #assert s[0].open == ES_OPEN_CLOCK && tr_find(t, "clock.1") > 0;
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "clock.1"), 0);
  #assert es_test_cell(h[..], 5, o[..]) == "clock 1 when dawn" && s[0].open == ES_OPEN_NONE;
  coaxial_editor_act_done(s); es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "clock"), 0); es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "clock.3"), 0);
  #assert coaxial_editor_act_kind(s) == 0;
  // an actor: the page is asked to show it; pressed again while shown, none
  es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "actor.6"), 0);
  #assert coaxial_editor_act_kind(s) == ES_ACTOR && cast(string) s[0].acts[0][0..<coaxial_editor_act_len(s)] == "actor 6";
  coaxial_editor_act_done(s);
  es_test_actors(h[..], 5, "dusk", 6); es_test_frames(h[..], 1);
  #assert tr_find(t, "plan.card") > 0 && tr_find(t, "pdo") > 0 && tr_find(t, "pon") > 0 && tr_find(t, "plan.2") > 0;
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "actor.6"), 0);
  #assert cast(string) s[0].acts[0][0..<coaxial_editor_act_len(s)] == "actor 0";
  coaxial_editor_act_done(s);
  // a world with no actors shows none of it
  es_test_model(h[..], 0, 7, 0, ""); es_test_frames(h[..], 1);
  #assert tr_find(t, "clock") < 0 && tr_find(t, "actors.list") < 0;
}
#test "the shown actor's plan: its fields hold the plan at the time shown, and each change is one cell edit of its row" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..]; o: [160] u8;
  es_test_actors(h[..], 5, "dusk", 6); es_test_frames(h[..], 1);
  #assert cast(string) s[0].pdraft[2][0..<s[0].pdraft_n[2]] == "850 -4500, 850 -5700" && cast(string) s[0].pdraft[0][0..<s[0].pdraft_n[0]] == "180" && cast(string) s[0].pdraft[1][0..<s[0].pdraft_n[1]] == "500";
  // what it does: Imperial 1 at dusk is row 62
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pdo"), 0); es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pdo.3"), 0);
  #assert es_test_cell(h[..], 5, o[..]) == "plans 62 * 62|6|dusk|guard|850 -4500, 850 -5700|180|500|chase";
  coaxial_editor_act_done(s); es_test_frames(h[..], 1);
  // standing takes one point: the route is cut to it in the same edit
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pdo"), 0); es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pdo.0"), 0);
  #assert es_test_cell(h[..], 5, o[..]) == "plans 62 * 62|6|dusk|stand|850 -4500|180|500|chase";
  coaxial_editor_act_done(s); es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pon"), 0); es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pon.1"), 0);
  #assert es_test_cell(h[..], 5, o[..]) == "plans 62 on call";
  coaxial_editor_act_done(s); es_test_frames(h[..], 1);
  // the one it does already changes nothing
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pdo"), 0); es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "pdo.4"), 0);
  #assert coaxial_editor_act_kind(s) == 0;
  // the route and the speed, typed; what it holds already changes nothing; an empty field is said, not sent
  es_test_frames(h[..], 1);
  es_test_type(h[..], "plan.2", "  0 -3700, 0 -3000 ");
  #assert es_test_cell(h[..], 5, o[..]) == "plans 62 route 0 -3700, 0 -3000";
  coaxial_editor_act_done(s);
  es_test_type(h[..], "plan.0", "250");
  #assert es_test_cell(h[..], 5, o[..]) == "plans 62 speed 250";
  coaxial_editor_act_done(s);
  es_test_type(h[..], "plan.1", "500");
  #assert coaxial_editor_act_kind(s) == 0;
  es_test_type(h[..], "plan.1", "  ");
  #assert coaxial_editor_act_kind(s) == 0 && s[0].said_n > 0;
  // at dawn the card is the dawn plan, row 60, and its fields are filled again
  es_test_actors(h[..], 6, "dawn", 6); es_test_frames(h[..], 1);
  #assert cast(string) s[0].pdraft[2][0..<s[0].pdraft_n[2]] == "0 -3700, 0 -3000" && cast(string) s[0].pdraft[1][0..<s[0].pdraft_n[1]] == "800";
  es_test_type(h[..], "plan.1", "900");
  #assert es_test_cell(h[..], 6, o[..]) == "plans 60 notice 900";
  coaxial_editor_act_done(s);
  // the story's time: the card shows dawn; an actor with no plan at that time has no card
  es_test_actors(h[..], 7, "story", 1); es_test_frames(h[..], 1);
  #assert tr_find(t, "plan.card") < 0;
}
