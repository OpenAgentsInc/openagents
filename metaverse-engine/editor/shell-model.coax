// What a page tells the editor shell (GitHub #13416, the browser editor's E7;
// docs/editor/2026-11-12-browser-editor.md, docs/protocol/editor-model-v1.md): the world it has
// open, its entities, the kinds they are, and the last refusal. The page's realm writes it; the
// shell (shell.coax), a module of its own, reads it and draws the outliner and the inspector
// from it. This file is the one codec (proto/world/model-v1.json holds the bytes).
//
// The model is lines of text:
//   editor.model.v1 WORLD LANE REV UNDO REDO SELECTED   the world's ID, its lane (dev or live), the
//                                       lane's revision, the steps that can be undone and redone, and
//                                       the selected entity's ID (0: none)
//   cols NAME ...                       the World columns an edit may set on an entity (world-edit.coax WE_COL)
//   table NAME                          the content table the kinds are rows of, when its cells may be
//                                       edited (E10, #13419): a cell's edit names it; left out, cells are only shown
//   k KIND NAME                         a kind: its content ID and its name
//   e ID KIND X Y Z YAW SCALE           an entity: its ID on the wire, its kind, where it stands in whole
//                                       centimetres, its turn in whole degrees, its size in whole percent
//   c KIND COLUMN VALUE                 a cell of a kind's content row
//   templates NAME                      the content table templates are rows of, when the realm keeps them
//                                       (E5, #13414): saved groups of things, each placed as one edit
//   t ID NAME                           a template: its row's ID and its name
//   tp ID PARTS                         its parts (place.coax pl_template_write)
//   all N CAP                           how many things the world holds in all, and how many it takes at
//                                       most (E13, #13422): a world with more things than a model lists says so
//   kinds N                             how many kinds the world has in all, when the model names only some of them
//   local                               the world is kept on this device and has no live lane: nothing to publish
//   land RMIN RMAX                      the world takes `terrain` edits: the smallest and the widest brush, centimetres
//   m ID NAME                           a material a brush paints: its number in a `terrain` edit and its name
//   here X Z                            the last point tapped on the ground, whole centimetres (E8, #13417);
//                                       left out until a point is tapped
//   no WORDS                            the last refusal, in words
// Lines come in the order they are listed in, the `templates` line after `table`, and each `tp` after its `t`.
// (The lists above are in the order the lines were added to the shape.) Every number is whole. A name and a value are one line of printable
// bytes. em_read refuses any bytes but the ones em_write writes (it writes what it read and
// compares).
//   coax/bin/coax test metaverse-engine/editor/shell-model.coax --library
#load "world-edit.coax";

EM_SCHEMA :: "editor.model.v1";
EM_ENTS :: 256;        // entities a model lists
EM_KINDS :: 64;        // kinds
EM_CELLS :: 256;       // content cells
EM_NAME :: 40;         // bytes in a kind's name
EM_VALUE :: 80;        // bytes in a cell's value
EM_WORDS :: 240;       // bytes in a refusal
EM_TEMPLATES :: 32;    // templates
EM_PARTS :: 480;       // bytes in a template's parts (place.coax PL_TEMPLATE)
EM_MATS :: 16;         // materials a brush paints
EM_BYTES :: 65536;     // bytes a model may take

EdModel :: struct {
  ok: bool;
  world: [WE_WORLD] u8; world_n: int;
  lane: int; rev: int; undo: int; redo: int; sel: int;
  cols: [WE_COLS] bool;
  table: [WE_NAME] u8; table_n: int;
  ttable: [WE_NAME] u8; ttable_n: int;
  nt: int; t_id: [EM_TEMPLATES] int; t_name: [EM_TEMPLATES] [EM_NAME] u8; t_name_n: [EM_TEMPLATES] int; t_parts: [EM_TEMPLATES] [EM_PARTS] u8; t_parts_n: [EM_TEMPLATES] int;
  nk: int; kind_id: [EM_KINDS] int; kind_name: [EM_KINDS] [EM_NAME] u8; kind_n: [EM_KINDS] int;
  ne: int; e_id: [EM_ENTS] int; e_kind: [EM_ENTS] int; e_x: [EM_ENTS] int; e_y: [EM_ENTS] int; e_z: [EM_ENTS] int; e_yaw: [EM_ENTS] int; e_scale: [EM_ENTS] int;
  nc: int; c_kind: [EM_CELLS] int; c_col: [EM_CELLS] [WE_NAME] u8; c_col_n: [EM_CELLS] int; c_val: [EM_CELLS] [EM_VALUE] u8; c_val_n: [EM_CELLS] int;
  all: bool; all_n: int; all_cap: int;   // the world's things in all and at most (left out: the model lists them all)
  kinds_all: int;                        // the world's kinds in all (0: the model names them all)
  local: bool;                           // kept on this device: no live lane
  land: bool; land_lo: int; land_hi: int;   // terrain edits are taken: a brush's radius, centimetres
  nm: int; mat_id: [EM_MATS] int; mat_name: [EM_MATS] [EM_NAME] u8; mat_n: [EM_MATS] int;
  here: bool; here_x: int; here_z: int;
  no: [EM_WORDS] u8; no_n: int;
}

// One line of printable bytes, with no space at either end.
em_text_ok :: (s: string, most: int) -> bool {
  if s.count < 1 || s.count > most || s[0] == ' ' || s[s.count - 1] == ' ' { return false; }
  for b: s { if b < 32 || b == 127 { return false; } }
  return true;
}

// ---- the writer, a line at a time (n: bytes written so far; past out.count when it does not fit)

em_begin :: (out: [] u8, world: string, lane: int, rev: int, undo: int, redo: int, sel: int) -> int {
  lanes := WE_LANE;
  if !we_world_ok(world) || lane < 0 || lane > 1 || rev < 0 || undo < 0 || redo < 0 || sel < 0 { return out.count + 1; }
  n := ct_put(out, 0, EM_SCHEMA); n = ct_put(out, n, " "); n = ct_put(out, n, world);
  n = ct_put(out, n, " "); n = ct_put(out, n, lanes[lane]);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, rev);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, undo);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, redo);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, sel);
  return ct_put(out, n, "\n");
}
em_cols :: (out: [] u8, at: int, cols: [] bool) -> int {
  names := WE_COL;
  n := ct_put(out, at, "cols");
  for k: 0..<WE_COLS { if k < cols.count && cols[k] { n = ct_put(out, n, " "); n = ct_put(out, n, names[k]); } }
  return ct_put(out, n, "\n");
}
em_table :: (out: [] u8, at: int, name: string) -> int {
  if !ct_name_ok(name) { return out.count + 1; }
  n := ct_put(out, at, "table "); n = ct_put(out, n, name);
  return ct_put(out, n, "\n");
}
em_templates :: (out: [] u8, at: int, name: string) -> int {
  if !ct_name_ok(name) { return out.count + 1; }
  n := ct_put(out, at, "templates "); n = ct_put(out, n, name);
  return ct_put(out, n, "\n");
}
// A template: its name line, then its parts line.
em_template :: (out: [] u8, at: int, id: int, name: string, parts: string) -> int {
  if id < 1 || !em_text_ok(name, EM_NAME) || !em_text_ok(parts, EM_PARTS) { return out.count + 1; }
  n := ct_put(out, at, "t "); n = ct_put_int(out, n, id); n = ct_put(out, n, " "); n = ct_put(out, n, name);
  n = ct_put(out, n, "\ntp "); n = ct_put_int(out, n, id); n = ct_put(out, n, " "); n = ct_put(out, n, parts);
  return ct_put(out, n, "\n");
}
em_kind :: (out: [] u8, at: int, id: int, name: string) -> int {
  if id < 0 || !em_text_ok(name, EM_NAME) { return out.count + 1; }
  n := ct_put(out, at, "k "); n = ct_put_int(out, n, id); n = ct_put(out, n, " "); n = ct_put(out, n, name);
  return ct_put(out, n, "\n");
}
em_entity :: (out: [] u8, at: int, id: int, kind: int, x: int, y: int, z: int, yaw: int, scale: int) -> int {
  if id < 1 || kind < 0 { return out.count + 1; }
  n := ct_put(out, at, "e "); n = ct_put_int(out, n, id);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, kind);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, x);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, y);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, z);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, yaw);
  n = ct_put(out, n, " "); n = ct_put_int(out, n, scale);
  return ct_put(out, n, "\n");
}
em_cell :: (out: [] u8, at: int, kind: int, col: string, value: string) -> int {
  if kind < 0 || !ct_name_ok(col) || !em_text_ok(value, EM_VALUE) { return out.count + 1; }
  n := ct_put(out, at, "c "); n = ct_put_int(out, n, kind);
  n = ct_put(out, n, " "); n = ct_put(out, n, col); n = ct_put(out, n, " "); n = ct_put(out, n, value);
  return ct_put(out, n, "\n");
}
em_all :: (out: [] u8, at: int, n_all: int, cap: int) -> int {
  if n_all < 0 || cap < n_all { return out.count + 1; }
  n := ct_put(out, at, "all "); n = ct_put_int(out, n, n_all); n = ct_put(out, n, " "); n = ct_put_int(out, n, cap);
  return ct_put(out, n, "\n");
}
em_kinds_all :: (out: [] u8, at: int, n_all: int) -> int {
  if n_all < 1 { return out.count + 1; }
  n := ct_put(out, at, "kinds "); n = ct_put_int(out, n, n_all);
  return ct_put(out, n, "\n");
}
em_local :: (out: [] u8, at: int) -> int { return ct_put(out, at, "local\n"); }
em_land :: (out: [] u8, at: int, lo: int, hi: int) -> int {
  if lo < 1 || hi < lo || hi > WE_REACH { return out.count + 1; }
  n := ct_put(out, at, "land "); n = ct_put_int(out, n, lo); n = ct_put(out, n, " "); n = ct_put_int(out, n, hi);
  return ct_put(out, n, "\n");
}
em_mat :: (out: [] u8, at: int, id: int, name: string) -> int {
  if id < 0 || id > 255 || !em_text_ok(name, EM_NAME) { return out.count + 1; }
  n := ct_put(out, at, "m "); n = ct_put_int(out, n, id); n = ct_put(out, n, " "); n = ct_put(out, n, name);
  return ct_put(out, n, "\n");
}
em_here :: (out: [] u8, at: int, x: int, z: int) -> int {
  if x < -WE_REACH || x > WE_REACH || z < -WE_REACH || z > WE_REACH { return out.count + 1; }
  n := ct_put(out, at, "here "); n = ct_put_int(out, n, x); n = ct_put(out, n, " "); n = ct_put_int(out, n, z);
  return ct_put(out, n, "\n");
}
em_no :: (out: [] u8, at: int, words: string) -> int {
  if !em_text_ok(words, EM_WORDS) { return out.count + 1; }
  n := ct_put(out, at, "no "); n = ct_put(out, n, words);
  return ct_put(out, n, "\n");
}

// A whole model, as its bytes ("" when it does not fit).
em_write :: (m: [] EdModel, out: [] u8) -> string {
  n := em_begin(out, cast(string) m[0].world[0..<m[0].world_n], m[0].lane, m[0].rev, m[0].undo, m[0].redo, m[0].sel);
  n = em_cols(out, n, m[0].cols[..]);
  if m[0].table_n > 0 { n = em_table(out, n, cast(string) m[0].table[0..<m[0].table_n]); }
  if m[0].ttable_n > 0 { n = em_templates(out, n, cast(string) m[0].ttable[0..<m[0].ttable_n]); }
  for k: 0..<m[0].nk { n = em_kind(out, n, m[0].kind_id[k], cast(string) m[0].kind_name[k][0..<m[0].kind_n[k]]); }
  for k: 0..<m[0].ne { n = em_entity(out, n, m[0].e_id[k], m[0].e_kind[k], m[0].e_x[k], m[0].e_y[k], m[0].e_z[k], m[0].e_yaw[k], m[0].e_scale[k]); }
  for k: 0..<m[0].nc { n = em_cell(out, n, m[0].c_kind[k], cast(string) m[0].c_col[k][0..<m[0].c_col_n[k]], cast(string) m[0].c_val[k][0..<m[0].c_val_n[k]]); }
  for k: 0..<m[0].nt { n = em_template(out, n, m[0].t_id[k], cast(string) m[0].t_name[k][0..<m[0].t_name_n[k]], cast(string) m[0].t_parts[k][0..<m[0].t_parts_n[k]]); }
  if m[0].all { n = em_all(out, n, m[0].all_n, m[0].all_cap); }
  if m[0].kinds_all > 0 { n = em_kinds_all(out, n, m[0].kinds_all); }
  if m[0].local { n = em_local(out, n); }
  if m[0].land { n = em_land(out, n, m[0].land_lo, m[0].land_hi); }
  for k: 0..<m[0].nm { n = em_mat(out, n, m[0].mat_id[k], cast(string) m[0].mat_name[k][0..<m[0].mat_n[k]]); }
  if m[0].here { n = em_here(out, n, m[0].here_x, m[0].here_z); }
  if m[0].no_n > 0 { n = em_no(out, n, cast(string) m[0].no[0..<m[0].no_n]); }
  if n > out.count { return ""; }
  return cast(string) out[0..<n];
}

// ---- the reader

// The rest of a line after its first `skip` words.
em_rest :: (line: string, skip: int) -> string {
  at := 0; seen := 0;
  while at < line.count && seen < skip { if line[at] == ' ' { seen += 1; } at += 1; }
  return ifx seen < skip then "" else line[at..<line.count];
}
em_copy :: (to: [] u8, s: string) -> int {
  n := ifx s.count > to.count then to.count else s.count;
  for i: 0..<n { to[i] = s[i]; }
  return n;
}
// The model in text, into m. False (and m not ok) for any bytes em_write would not write.
em_read :: (m: [] EdModel, text: string, scratch: [] u8) -> bool {
  m[0].ok = false; m[0].nk = 0; m[0].ne = 0; m[0].nc = 0; m[0].no_n = 0; m[0].world_n = 0; m[0].here = false; m[0].table_n = 0; m[0].ttable_n = 0; m[0].nt = 0;
  m[0].all = false; m[0].local = false; m[0].land = false; m[0].nm = 0; m[0].kinds_all = 0;
  for k: 0..<WE_COLS { m[0].cols[k] = false; }
  if text.count < EM_SCHEMA.count || text.count > EM_BYTES { return false; }
  lines := ct_parts(text, '\n');
  head := ct_part(text, '\n', 0);
  if ct_part(head, ' ', 0) != EM_SCHEMA || ct_parts(head, ' ') != 7 { return false; }
  m[0].world_n = em_copy(m[0].world[..], ct_part(head, ' ', 1));
  lane := ct_part(head, ' ', 2);
  m[0].lane = ifx lane == "live" then 1 else 0;
  m[0].rev = ct_num(ct_part(head, ' ', 3)).v; m[0].undo = ct_num(ct_part(head, ' ', 4)).v;
  m[0].redo = ct_num(ct_part(head, ' ', 5)).v; m[0].sel = ct_num(ct_part(head, ' ', 6)).v;
  for i: 1..<lines {
    line := ct_part(text, '\n', i);
    word := ct_part(line, ' ', 0);
    if word == "cols" {
      for k: 1..<ct_parts(line, ' ') { c := we_col(ct_part(line, ' ', k)); if c >= 0 { m[0].cols[c] = true; } }
    } else if word == "table" {
      m[0].table_n = em_copy(m[0].table[..], em_rest(line, 1));
    } else if word == "templates" {
      m[0].ttable_n = em_copy(m[0].ttable[..], em_rest(line, 1));
    } else if word == "t" && m[0].nt < EM_TEMPLATES {
      k := m[0].nt;
      m[0].t_id[k] = ct_num(ct_part(line, ' ', 1)).v;
      m[0].t_name_n[k] = em_copy(m[0].t_name[k][..], em_rest(line, 2));
      m[0].t_parts_n[k] = 0;
      m[0].nt += 1;
    } else if word == "tp" && m[0].nt > 0 {
      // the parts of the template named on the line before
      m[0].t_parts_n[m[0].nt - 1] = em_copy(m[0].t_parts[m[0].nt - 1][..], em_rest(line, 2));
    } else if word == "k" && m[0].nk < EM_KINDS {
      k := m[0].nk;
      m[0].kind_id[k] = ct_num(ct_part(line, ' ', 1)).v;
      m[0].kind_n[k] = em_copy(m[0].kind_name[k][..], em_rest(line, 2));
      m[0].nk += 1;
    } else if word == "e" && m[0].ne < EM_ENTS {
      k := m[0].ne;
      m[0].e_id[k] = ct_num(ct_part(line, ' ', 1)).v; m[0].e_kind[k] = ct_num(ct_part(line, ' ', 2)).v;
      m[0].e_x[k] = ct_num(ct_part(line, ' ', 3)).v; m[0].e_y[k] = ct_num(ct_part(line, ' ', 4)).v; m[0].e_z[k] = ct_num(ct_part(line, ' ', 5)).v;
      m[0].e_yaw[k] = ct_num(ct_part(line, ' ', 6)).v; m[0].e_scale[k] = ct_num(ct_part(line, ' ', 7)).v;
      m[0].ne += 1;
    } else if word == "c" && m[0].nc < EM_CELLS {
      k := m[0].nc;
      m[0].c_kind[k] = ct_num(ct_part(line, ' ', 1)).v;
      m[0].c_col_n[k] = em_copy(m[0].c_col[k][..], ct_part(line, ' ', 2));
      m[0].c_val_n[k] = em_copy(m[0].c_val[k][..], em_rest(line, 3));
      m[0].nc += 1;
    } else if word == "all" {
      m[0].all = true; m[0].all_n = ct_num(ct_part(line, ' ', 1)).v; m[0].all_cap = ct_num(ct_part(line, ' ', 2)).v;
    } else if word == "kinds" {
      m[0].kinds_all = ct_num(ct_part(line, ' ', 1)).v;
    } else if word == "local" {
      m[0].local = true;
    } else if word == "land" {
      m[0].land = true; m[0].land_lo = ct_num(ct_part(line, ' ', 1)).v; m[0].land_hi = ct_num(ct_part(line, ' ', 2)).v;
    } else if word == "m" && m[0].nm < EM_MATS {
      k := m[0].nm;
      m[0].mat_id[k] = ct_num(ct_part(line, ' ', 1)).v;
      m[0].mat_n[k] = em_copy(m[0].mat_name[k][..], em_rest(line, 2));
      m[0].nm += 1;
    } else if word == "here" {
      m[0].here = true; m[0].here_x = ct_num(ct_part(line, ' ', 1)).v; m[0].here_z = ct_num(ct_part(line, ' ', 2)).v;
    } else if word == "no" {
      m[0].no_n = em_copy(m[0].no[..], em_rest(line, 1));
    }
  }
  // only the bytes the writer writes
  m[0].ok = em_write(m, scratch) == text;
  return m[0].ok;
}

// A kind's name ("" when the model names no such kind).
em_kind_name :: (m: [] EdModel, kind: int, out: [] u8) -> string {
  for k: 0..<m[0].nk { if m[0].kind_id[k] == kind { n := em_copy(out, cast(string) m[0].kind_name[k][0..<m[0].kind_n[k]]); return cast(string) out[0..<n]; } }
  return "";
}
// The entity with this ID: its place in the model, or -1.
em_entity_at :: (m: [] EdModel, id: int) -> int {
  for k: 0..<m[0].ne { if m[0].e_id[k] == id && id > 0 { return k; } }
  return -1;
}

// ---- checks

EmTest :: struct { m: [1] EdModel; out: [EM_BYTES] u8; scratch: [EM_BYTES] u8; }
// The fixture proto/world/model-v1.json holds.
em_test_text :: (out: [] u8) -> string {
  cols: [WE_COLS] bool; cols[WEC_X] = true; cols[WEC_Z] = true; cols[WEC_YAW] = true;
  n := em_begin(out, "splice", 0, 7, 3, 1, 2);
  n = em_cols(out, n, cols[..]);
  n = em_table(out, n, "pieces");
  n = em_templates(out, n, "templates");
  n = em_kind(out, n, 1001, "Cargo crate");
  n = em_kind(out, n, 1002, "Parked rover");
  n = em_entity(out, n, 1, 1001, 350, 0, -1200, 90, 100);
  n = em_entity(out, n, 2, 1002, -40, 12, 600, -179, 100);
  n = em_cell(out, n, 1002, "kit", "rover");
  n = em_cell(out, n, 1002, "scale", "1.5");
  n = em_template(out, n, 3, "Crate by a rover", "1001 -150 0 0 100,1002 150 0 90 100");
  n = em_here(out, n, 420, -75);
  n = em_no(out, n, "That spot is inside the Scanner gate, which stays clear.");
  return ifx n > out.count then "" else cast(string) out[0..<n];
}

#test "a model written is the model read, and it writes the same bytes again" {
  h: [1] EmTest; m := h[0].m[..];
  text := em_test_text(h[0].out[..]);
  #assert text.count > 200 && em_read(m, text, h[0].scratch[..]);
  w := m[0].world;
  #assert cast(string) w[0..<m[0].world_n] == "splice" && m[0].lane == 0 && m[0].rev == 7 && m[0].undo == 3 && m[0].redo == 1 && m[0].sel == 2;
  #assert m[0].cols[WEC_X] && m[0].cols[WEC_Z] && m[0].cols[WEC_YAW] && !m[0].cols[WEC_Y] && !m[0].cols[WEC_KIND];
  #assert m[0].nk == 2 && m[0].ne == 2 && m[0].nc == 2 && m[0].no_n == 56;
  #assert m[0].e_id[1] == 2 && m[0].e_kind[1] == 1002 && m[0].e_x[1] == -40 && m[0].e_y[1] == 12 && m[0].e_z[1] == 600 && m[0].e_yaw[1] == -179 && m[0].e_scale[1] == 100;
  name: [EM_NAME] u8;
  #assert em_kind_name(m, 1002, name[..]) == "Parked rover" && em_kind_name(m, 7, name[..]) == "";
  #assert em_entity_at(m, 2) == 1 && em_entity_at(m, 3) == -1 && em_entity_at(m, 0) == -1;
  #assert m[0].here && m[0].here_x == 420 && m[0].here_z == -75;
  tb := m[0].table;
  #assert cast(string) tb[0..<m[0].table_n] == "pieces";
  tt := m[0].ttable; tn := m[0].t_name[0]; tp := m[0].t_parts[0];
  #assert cast(string) tt[0..<m[0].ttable_n] == "templates" && m[0].nt == 1 && m[0].t_id[0] == 3 && cast(string) tn[0..<m[0].t_name_n[0]] == "Crate by a rover" && cast(string) tp[0..<m[0].t_parts_n[0]] == "1001 -150 0 0 100,1002 150 0 90 100";
}

#test "a model with nothing in it reads, and bytes the writer would not write are refused" {
  h: [1] EmTest; m := h[0].m[..];
  none: [WE_COLS] bool;
  n := em_begin(h[0].out[..], "splice", 1, 0, 0, 0, 0);
  n = em_cols(h[0].out[..], n, none[..]);
  #assert em_read(m, cast(string) h[0].out[0..<n], h[0].scratch[..]) && m[0].lane == 1 && m[0].ne == 0 && m[0].no_n == 0 && !m[0].here;
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nhere 1\n", h[0].scratch[..]) && !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nhere 1 2 3\n", h[0].scratch[..]);
  #assert em_here(h[0].out[..], 0, WE_REACH + 1, 0) > EM_BYTES && m[0].table_n == 0;
  #assert em_template(h[0].out[..], 0, 0, "x", "1 0 0 0 100") > EM_BYTES && em_template(h[0].out[..], 0, 1, "", "1 0 0 0 100") > EM_BYTES && em_template(h[0].out[..], 0, 1, "x", "") > EM_BYTES && em_templates(h[0].out[..], 0, "T") > EM_BYTES && m[0].nt == 0;
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nt 1 A template with no parts\n", h[0].scratch[..]) && !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\ntp 1 1 0 0 0 100\n", h[0].scratch[..]);
  #assert em_table(h[0].out[..], 0, "Pieces") > EM_BYTES && !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\ntable two words\n", h[0].scratch[..]);
  #assert !em_read(m, "editor.model.v2 splice dev 0 0 0 0\ncols\n", h[0].scratch[..]);
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\ne 1 5 0 0 0 0 100 extra\n", h[0].scratch[..]);
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\ne 01 5 0 0 0 0 100\n", h[0].scratch[..]);
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nx what\n", h[0].scratch[..]);
  #assert !em_read(m, "editor.model.v1 Splice dev 0 0 0 0\ncols\n", h[0].scratch[..]);
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\n\n", h[0].scratch[..]);
  #assert !em_read(m, "", h[0].scratch[..]);
}

#test "what does not fit, or is not a name, a place or a line, is not written" {
  h: [1] EmTest; small: [24] u8;
  #assert em_begin(small[..], "splice", 0, 1, 0, 0, 0) > small.count;
  #assert em_begin(h[0].out[..], "Splice", 0, 1, 0, 0, 0) > EM_BYTES && em_begin(h[0].out[..], "splice", 2, 1, 0, 0, 0) > EM_BYTES;
  #assert em_kind(h[0].out[..], 0, 1, "") > EM_BYTES && em_kind(h[0].out[..], 0, 1, "two\nlines") > EM_BYTES && em_kind(h[0].out[..], 0, 1, " lead") > EM_BYTES;
  #assert em_entity(h[0].out[..], 0, 0, 1, 0, 0, 0, 0, 100) > EM_BYTES;
  #assert em_cell(h[0].out[..], 0, 1, "Kit", "v") > EM_BYTES && em_cell(h[0].out[..], 0, 1, "kit", "") > EM_BYTES;
  #assert em_no(h[0].out[..], 0, "") > EM_BYTES;
}

#test "a world kept on this device says so, with how many things it holds and takes, and the brushes its land takes" {
  h: [1] EmTest; m := h[0].m[..]; out := h[0].out[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true;
  n := em_begin(out, "create-world", 0, 12, 1, 0, 0);
  n = em_cols(out, n, cols[..]);
  n = em_kind(out, n, 3, "nature/rock-1");
  n = em_entity(out, n, 900, 3, 0, 0, 0, 0, 100);
  n = em_all(out, n, 1203, 4096);
  n = em_kinds_all(out, n, 788);
  n = em_local(out, n);
  n = em_land(out, n, 100, 4000);
  n = em_mat(out, n, 1, "Grass");
  n = em_mat(out, n, 0, "Grid");
  text := cast(string) out[0..<n];
  #assert em_read(m, text, h[0].scratch[..]) && m[0].all && m[0].all_n == 1203 && m[0].all_cap == 4096 && m[0].kinds_all == 788 && m[0].local && m[0].land && m[0].land_lo == 100 && m[0].land_hi == 4000;
  mn := m[0].mat_name[0];
  #assert m[0].nm == 2 && m[0].mat_id[0] == 1 && cast(string) mn[0..<m[0].mat_n[0]] == "Grass" && m[0].mat_id[1] == 0;
  // a model without them has none
  n = em_begin(out, "splice", 0, 1, 0, 0, 0); n = em_cols(out, n, cols[..]);
  #assert em_read(m, cast(string) out[0..<n], h[0].scratch[..]) && !m[0].all && !m[0].local && !m[0].land && m[0].nm == 0 && m[0].kinds_all == 0;
  // what is not one is not written or read
  #assert em_all(out, 0, 5, 4) > EM_BYTES && em_all(out, 0, -1, 4) > EM_BYTES && em_land(out, 0, 0, 10) > EM_BYTES && em_land(out, 0, 20, 10) > EM_BYTES;
  #assert em_kinds_all(out, 0, 0) > EM_BYTES && !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nkinds 0\n", h[0].scratch[..]) && !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nkinds 5 6\n", h[0].scratch[..]);
  #assert em_mat(out, 0, 256, "x") > EM_BYTES && em_mat(out, 0, 1, "") > EM_BYTES;
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nlocal yes\n", h[0].scratch[..]) && !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nall 5\n", h[0].scratch[..]);
  #assert !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nland 0 5\n", h[0].scratch[..]) && !em_read(m, "editor.model.v1 splice dev 0 0 0 0\ncols\nm 1\n", h[0].scratch[..]);
}
