// The editor shell (GitHub #13416, the browser editor's E7;
// docs/editor/2026-11-12-browser-editor.md): what `?edit` opens over an engine page. A strip of
// actions, the world's things in a list, and the selected thing's place and facts, built from
// the components the chat page is built from (components/kit/frames.coax and dock.coax, in the
// mono skin) and drawn by the browser (components/backend/dom.coax), so its text is real text:
// select it, find it, zoom it.
//
// The shell is a module of its own beside the page's. The page tells it what the world holds
// (shell-model.coax, editor.model.v1) and the shell asks the page to act: a batch of edits
// (world-edit.coax, world.edit.v1) the page sends as its own, or a thing to select. It keeps no
// world and decides nothing: whether an edit stands is the server's answer, which comes back in
// the next model as new places or as a refusal in words.
//
// It has no look of its own. Every node is a kit component, the stylesheet is the skin's, and
// this file names no colour, face or size (coax/web/tool.sh editor-skin-check).
//   coax/bin/coax test metaverse-engine/editor/shell.coax --library
#load "../../components/kit/dock.coax";
#load "../../components/backend/dom.coax";
#load "shell-model.coax";
#load "place.coax";
#load "../../coax/lib/agent/world/turn.coax";   // what the agent's turn is told, and a hosted turn's plan
#load "code-wire.coax";                         // a realm's code on the dev server: what is asked and answered
#load "shell-assets.coax";                      // the Assets pane: the world's imports, a file dropped, its licence and the limits (#13420)
#load "shell-actors.coax";                      // the actors: the time of day, the Actors list and the selected actor's plan (#13466)
#load "shell-files.coax";                       // the Files pane: the world's and its project's attachments, never a player's (#13468)
#load "shell-scripts.coax";                     // the Scripts pane: a realm script written, built, run, swapped, published and reported (#13467)
#load "shell-lists.coax";                       // lists of switches: a realm's board and its tools (#13478)
#load "shell-revs.coax";                        // the revisions: what the newest step changed, in the bar, and the Revisions list (#13485)

ES_INBOX :: 200704;    // a model (EM_BYTES), a field's text, or a file of code as typed (RC_TEXT, and room to see that it is longer), from the host
ES_CSS :: 24576;
ES_ACT :: 24576;       // bytes one action for the page takes (a template placed is a batch of up to PL_PARTS spawns; a turn is WT_BYTES with its attachments)
ES_ACTS :: 4;          // actions that wait for the page
ES_DRAFT :: 16;        // bytes typed into a number's field
ES_CLICK :: 1; ES_INPUT :: 2; ES_SUBMIT :: 3; ES_MODEL :: 6;
ES_AGENT :: 7;         // the page was opened for the agent (?edit=agent): the foot is open from the start
ES_PLANNED :: 8;       // a hosted turn's plan (world.plan.v1), in the inbox: its steps become one batch of edits
ES_HELD :: 14;         // the page is held in the app shell, beside the site's side (docs/app-shell.md): no column for the side here
// Code (E12, #13421). The page's host says the dev server serves this page (ES_CODE_HERE, the page's module in
// the inbox); a deployed page's host never does, and the shell then has no Code button and no Code pane.
// What the shell asks the dev server (realm.code.v1, code-wire.coax) goes by the host's dom_stream, and
// the answer comes back in pieces (ES_PIECE, its status in `slot`) and an end (ES_END).
ES_PIECE :: 4; ES_END :: 5; ES_CODE_HERE :: 9;
ES_FLY_NONE :: 0; ES_FLY_LIST :: 1; ES_FLY_READ :: 2; ES_FLY_SAVE :: 3;
ES_NOTE_NONE :: 0; ES_NOTE_SAVED :: 1; ES_NOTE_ERRORS :: 2; ES_NOTE_NO :: 3;
ES_TURN :: 524;        // an action for the conversation in the foot, not the page: the world as a turn is told it (world.turn.v1)
ES_BATCH :: 520;       // an action: a world.edit.v1 batch for the page to send
ES_SELECT :: 521;      // an action: the ID of the thing to select, 0 for none
ES_VIEW :: 522;        // an action for the viewport's tools, as words (viewport.coax vp_act): "tool move", "grid 50", "fly on", "run pause", "step", "sim on"
// The viewport's tools (viewport.coax VT_*), as a person reads them, and what each does.
ES_TOOLS :: 5;
ES_TOOL :: [ES_TOOLS] string.["Play", "Select", "Move", "Turn", "Size"];
ES_TOOL_WORD :: [ES_TOOLS] string.["play", "select", "move", "turn", "size"];
ES_TOOL_NOTE :: [ES_TOOLS] string.["Walk the world as a player", "Tap a thing to select it", "Drag the selected thing along the ground", "Drag sideways to turn the selected thing", "Drag up or down to size the selected thing"];
ES_GRIDS :: 4;
ES_GRID :: [ES_GRIDS] string.["10 cm", "25 cm", "50 cm", "1 m"];
ES_GRID_CM :: [ES_GRIDS] int.[10, 25, 50, 100];
ES_OPEN_NONE :: 0; ES_OPEN_WHEN :: 1; ES_OPEN_KIND :: 2; ES_OPEN_TOOL :: 3; ES_OPEN_GRID :: 4; ES_OPEN_ADD :: 5; ES_OPEN_COUNT :: 6; ES_OPEN_FILE :: 7; ES_OPEN_BRUSH :: 8; ES_OPEN_MAT :: 9; ES_OPEN_LICENCE :: 10;
// The land's brush (E13, #13422), for a world that says its land takes `terrain` edits (the model's `land` line):
// the tool after the others, the brush's kinds as a person reads them (world-edit.coax WE_BRUSH), and the steps
// its radius and its strength are picked from.
ES_TOOL_LAND :: 5;
ES_LAND :: "Land";
ES_LAND_NOTE :: "Drag on the ground to shape or paint it";
ES_BRUSH :: [WE_BRUSHES] string.["Paint", "Raise", "Lower", "Smooth", "Flatten"];
ES_BRUSH_NOTE :: [WE_BRUSHES] string.["Paint a material on the ground", "Raise the ground under the brush", "Lower the ground under the brush", "Smooth the ground under the brush", "Level the ground to the height at the brush's middle"];
ES_RADII :: 9;
ES_RADIUS_CM :: [ES_RADII] int.[100, 200, 400, 800, 1200, 1600, 2400, 3200, 4000];
ES_STRENGTHS :: 10;   // 10 percent a step, to 100
ES_PLAN :: 523;        // an action: "add KIND COUNT": the page plans where COUNT things of a kind go from the point last tapped (place.coax) and sends them as one batch
// How many things Add places: one where you tapped, or several spread out round it.
ES_COUNTS :: 4;
ES_COUNT :: [ES_COUNTS] int.[1, 3, 5, 10];
ES_COUNT_NAME :: [ES_COUNTS] string.["One", "3 spread out", "5 spread out", "10 spread out"];
// What a column is called beside its field, and what its number counts.
ES_COL_NAME :: [WE_COLS] string.["X cm", "Y cm", "Z cm", "Turn °", "Speed X", "Speed Y", "Speed Z", "Radius cm", "Height cm", "Health", "Health max", "Kind", "Row"];
ES_WHEN :: [2] string.["Now", "Next session"];
ES_WHEN_NOTE :: [2] string.["People in the world see it at once", "People see it the next time they come in"];

EdShell :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  have: bool;                            // a model came
  when: int;                             // when a publish reaches people: 0 now, 1 next session
  open: int;                             // the one select that is open (ES_OPEN_*)
  tool: int; grid: int = 2;              // the viewport's tool (ES_TOOL) and the grid a move snaps to (ES_GRID)
  fly: bool; paused: bool; sim: bool;    // the camera flies; the World is paused; the World runs with the player's hands off
  count: int;                            // how many Add places (ES_COUNT)
  brush: int = 1; mat: int; radius: int = 3; strength: int = 5;   // the land's brush: its kind (ES_BRUSH), the material it paints (its place in the model's list), its radius (ES_RADIUS_CM) and its strength (tens of percent, less one)
  group: [PL_PARTS] int; ngroup: int;    // the things gathered to save as a template, by ID
  tname: [EM_NAME] u8; tname_n: int;     // the name typed for it
  held: bool;                            // the site's side is the app shell's, around this page: the dock has no column for it
  agent: bool; agent_made: bool;         // the foot with the chat's conversation is open; it was opened once (it is then kept, put away)
  turn_due: bool;                        // the conversation has not been told of the world as it now is
  said: [EM_WORDS] u8; said_n: int;      // the shell's own word about what was typed, until the next action
  draft: [WE_COLS] [ES_DRAFT] u8; draft_n: [WE_COLS] int;
  cell: [EM_CELLS] [EM_VALUE] u8; cell_n: [EM_CELLS] int;   // what is typed into a content cell's field, by the cell's place in the model
  shown_sel: int; shown_rev: int;        // the thing and the revision the fields were last filled for
  pdraft: [ES_PLAN_COLS] [EM_ROUTE] u8; pdraft_n: [ES_PLAN_COLS] int;   // what is typed into the shown plan's fields (shell-actors.coax)
  pshown: int = -2; pshown_rev: int = -1;  // the actor and time, and the revision, the plan's fields were last filled for
  acts: [ES_ACTS] [ES_ACT] u8; act_n: [ES_ACTS] int; act_kind: [ES_ACTS] int; nacts: int;
  // code: the page's module as the dev server knows it (none: no code here), the realm's files, and the one open
  code_page: [RC_PAGE] u8; code_page_n: int;
  code: bool;                            // the Code pane is open
  nfiles: int; file: [RC_FILES] [RC_PATH] u8; file_n: [RC_FILES] int; file_bytes: [RC_FILES] int;
  code_at: int = -1;                     // the open file, by its place in the list
  code_n: int;                           // bytes of it, as typed
  code_edits: int; code_sent: int;       // times it was typed in, and how many when it was last opened or sent: they differ while it has changes that are not saved
  code_long: bool;                       // what is typed is longer than a file the editor saves
  code_fill: bool;                       // the field is due the file's text
  code_leave: int = -1;                  // the file picked while this one had changes: picked again, the changes are dropped
  code_flight: int; code_ask: bool; code_want: int;   // what the dev server was asked (ES_FLY_*), whether the ask is still to send, and the file it names
  code_req_n: int; code_resp_n: int; code_lost: bool; // the ask's bytes, the answer's so far, and whether it was more than an answer is
  code_note: int; code_words_n: int;     // what the pane says of the last open or save (ES_NOTE_*), and its words
  clip_n: int;                           // bytes for the clipboard (a code block's Copy), until the host takes them
  // assets (E11, #13420; shell-assets.coax): the world's imports as its server lists them (no list: no Assets here), and one file at a time
  assets: bool;                          // the Assets pane is open
  as_have: bool; as_asked: bool;         // a list came (world.assets.v1); the first was asked for
  as_flight: int; as_ask: bool;          // what the world's server was asked (ES_AS_*), and whether the ask is still to go to the host
  as_licence: int = -1;                  // the licence chosen for the next file (-1: none yet)
  as_file: bool; as_file_bytes: int; as_file_name_n: int;   // the file that waits to be sent
  as_note: int; as_words_n: int;         // what the pane says of the last file (ES_AS_SAID_*), and its words
  as_url_n: int; as_head_n: int;         // where the ask goes, and an import's first bytes (0: a GET)
  as_how: int;                           // how the ask goes (ES_HOW_*)
  as_told: bool;                         // the page was told the hash of the world's pack (as_pack)
  as_url: [WAS_URL] u8; as_head: [FW_HEAD] u8;   // shared by the Files pane (shell-files.coax), whose heads are longer
  files: bool;                           // the Files pane is open (#13468)
  fl: EsFiles;
  scripts: bool;                         // the Scripts pane is open (#13467)
  sc: EsScripts;
  revs: bool;                            // the Revisions list is open (#13485)
  rv: EsRevs;
  as_hash: [64] u8; as_pack: [64] u8;    // the waiting file's SHA-256 as the server answered it, and the pack's hash the page was last told
  as_file_name: [WAS_FILE_NAME] u8;
  as_words: [EM_WORDS] u8;
  as_list: [1] WasList; as_next: [1] WasList;
  code_door: [16] u8; code_door_n: int;
  code_words: [RC_ERRORS] u8;
  clip: [RC_ERRORS] u8;
  code_text: [RC_TEXT] u8;
  code_req: [RC_TEXT + RC_HEAD] u8;
  code_resp: [RC_TEXT + RC_HEAD] u8;
  inbox: [ES_INBOX] u8;
  scratch: [EM_BYTES] u8;
  model: [1] EdModel;
  sets: [MF_COUNT] AfSettings;
  css: [ES_CSS] u8;
  ui: [1] Ui;
  tree: [1] Tree;
  dom: [1] Dom;
}

// ---- actions for the page

es_act :: (s: [] EdShell, kind: int, body: string) -> bool {
  if s[0].nacts >= ES_ACTS || body.count > ES_ACT || body.count == 0 { return false; }
  k := s[0].nacts;
  for i: 0..<body.count { s[0].acts[k][i] = body[i]; }
  s[0].act_n[k] = body.count; s[0].act_kind[k] = kind; s[0].nacts += 1;
  return true;
}
es_say :: (s: [] EdShell, words: string) { s[0].said_n = em_copy(s[0].said[..], words); }
// A batch of edits made from the model's revision: one step, so one undo takes all of it back.
es_batch_of :: (s: [] EdShell, what: int, edits: [] WorldEdit, n: int) {
  out: [ES_ACT] u8;
  text := we_batch_write(s[0].model[0].rev, what, edits, n, out[..]);
  s[0].said_n = 0;
  if !es_act(s, ES_BATCH, text) { es_say(s, "That did not go: the page is still busy with the last change. Try again."); }
}
// A batch of one kind (undo, redo, a publish) or of one edit.
es_batch :: (s: [] EdShell, what: int, e: WorldEdit) {
  edits: [1] WorldEdit; edits[0] = e;
  es_batch_of(s, what, edits[..], ifx what == WB_APPLY then 1 else 0);
}
es_in_group :: (s: [] EdShell, id: int) -> int { for k: 0..<s[0].ngroup { if s[0].group[k] == id { return k; } } return -1; }
// The thing a row's control is for: "thing.12.x" is 12; -1 for any other id.
es_group_id :: (id: string) -> int {
  if !es_id_is(id, "thing.") || id.count < 9 || cast(string) id[id.count - 2..<id.count] != ".x" { return -1; }
  v := ct_num(id[6..<id.count - 2]);
  return ifx v.ok && v.v > 0 then v.v else -1;
}
// The land's brush is the tool: the world's land takes edits and the tool was picked.
es_landing :: (s: [] EdShell) -> bool { return s[0].model[0].land && s[0].tool == ES_TOOL_LAND; }
// Whether step k of the radii is one the world's land takes.
es_radius_ok :: (s: [] EdShell, k: int) -> bool {
  radii := ES_RADIUS_CM;
  return k >= 0 && k < ES_RADII && radii[k] >= s[0].model[0].land_lo && radii[k] <= s[0].model[0].land_hi;
}
// Tells the page one part of the brush (viewport.coax vp_act): 0 its kind, 1 its material, 2 its radius, 3 its strength.
es_brush_tell :: (s: [] EdShell, part: int) {
  m := s[0].model[..]; words: [24] u8; n := 0;
  if part == 0 { kinds := WE_BRUSH; n = ct_put(words[..], 0, "brush "); n = ct_put(words[..], n, kinds[s[0].brush]); }
  if part == 1 { if m[0].nm == 0 { return; } n = ct_put(words[..], 0, "mat "); n = ct_put_int(words[..], n, m[0].mat_id[ifx s[0].mat < m[0].nm then s[0].mat else 0]); }
  if part == 2 { radii := ES_RADIUS_CM; n = ct_put(words[..], 0, "radius "); n = ct_put_int(words[..], n, radii[s[0].radius]); }
  if part == 3 { n = ct_put(words[..], 0, "strength "); n = ct_put_int(words[..], n, (s[0].strength + 1) * 10); }
  _ := es_act(s, ES_VIEW, cast(string) words[0..<n]);
}
es_select :: (s: [] EdShell, id: int) {
  out: [12] u8; n := ct_put_int(out[..], 0, id);
  _ := es_act(s, ES_SELECT, cast(string) out[0..<n]);
}

// ---- the tree

es_id_is :: (id: string, part: string) -> bool { return id.count > part.count && cast(string) id[0..<part.count] == part; }
// The whole number after a part ("thing.12" after "thing." is 12), or -1.
es_index :: (id: string, part: string) -> int {
  if !es_id_is(id, part) { return -1; }
  v := ct_num(id[part.count..<id.count]);
  return ifx v.ok && v.v >= 0 then v.v else -1;
}

// What the shell or the server last refused, where the right pane begins.
es_build_said :: (s: [] EdShell) {
  t := s[0].tree[..]; u := s[0].ui[..]; m := s[0].model[..];
  if s[0].said_n > 0 { a := k_notice(t, u, "said", "Not done", cast(string) s[0].said[0..<s[0].said_n]); tr_close(t); }
  else if m[0].no_n > 0 { a := k_notice(t, u, "refused", "Not done", cast(string) m[0].no[0..<m[0].no_n]); tr_close(t); }
}
// A file's path as the list has it, and its name as a person reads it: the path inside the realm's folder.
es_file_path :: (s: [] EdShell, k: int) -> string {
  if k < 0 || k >= s[0].nfiles { return ""; }
  return cast(string) s[0].file[k][0..<s[0].file_n[k]];
}
es_file_name :: (s: [] EdShell, k: int) -> string {
  path := es_file_path(s, k); lead := 11 + s[0].code_page_n;   // "metaverse/", the page, "/"
  return ifx path.count > lead then cast(string) path[lead..<path.count] else path;
}
es_code_changed :: (s: [] EdShell) -> bool { return s[0].code_at >= 0 && s[0].code_edits != s[0].code_sent; }
// The Code pane: the realm's files in a select, the open one in a code field, Save, and what the compiler said.
es_build_code :: (s: [] EdShell) {
  t := s[0].tree[..]; u := s[0].ui[..];
  buf: [UI_ID] u8;
  pane := k_pane(t, u, "code.pane", DK_WIDE, "Code");
  es_build_said(s);
  row := tr_open(t, "code.acts", TG_DIV, "rowf");
  open := s[0].open == ES_OPEN_FILE;
  k_select_begin(t, u, "file", ifx s[0].code_at >= 0 then es_file_name(s, s[0].code_at) else "Pick a file", "This realm's source files", open);
  if open {
    for k: 0..<s[0].nfiles { r := k_row(t, u, tr_join(buf[..], "file.", k), es_file_name(s, k), ifx s[0].file_bytes[k] > RC_TEXT then "Too long to open here" else "", k == s[0].code_at); }
  }
  k_select_end(t, open);
  if s[0].code_at >= 0 {
    can := es_code_changed(s) && !s[0].code_long && s[0].code_flight == ES_FLY_NONE;
    sv := k_button(t, u, "code.save", "Save", ifx can then BS_PRIMARY else BS_DISABLED);
    word := ifx s[0].code_flight == ES_FLY_SAVE then "Saving" else ifx es_code_changed(s) then "Not saved" else "";
    if word.count > 0 { st := tr_leaf(t, "code.state", TG_SPAN, "meta", word); }
  } else if s[0].code_flight == ES_FLY_READ { st := tr_leaf(t, "code.state", TG_SPAN, "meta", "Opening"); }
  tr_close(t);
  if s[0].code_at >= 0 {
    path := es_file_path(s, s[0].code_at);
    f := k_code_field(t, u, "code.text", ifx rc_ends(path, ".wgsl") then "wgsl" else "coax", "The file's text");
  } else if s[0].code_flight != ES_FLY_READ { none := k_meta(t, "code.none", "Pick a file to open it."); }
  words := cast(string) s[0].code_words[0..<s[0].code_words_n];
  if s[0].code_long { a := k_notice(t, u, "code.said", "Not saved", "This file is longer than the editor saves (192 KB)."); tr_close(t); }
  else if s[0].code_note == ES_NOTE_SAVED { a := k_notice(t, u, "code.said", "Saved", "The world reloads."); tr_close(t); }
  else if s[0].code_note == ES_NOTE_ERRORS {
    a := k_notice(t, u, "code.said", "Compile errors", "The file is saved. The last good build keeps running.");
    c := k_code(t, u, "code.errors", "coax", words);
    tr_close(t);
  }
  else if s[0].code_note == ES_NOTE_NO { a := k_notice(t, u, "code.said", "Not done", words); tr_close(t); }
  k_pane_end(t);
}

// ---- code: what the dev server is asked, and its answers

es_code_say :: (s: [] EdShell, note: int, words: string) {
  s[0].code_note = note;
  n := ifx words.count > RC_ERRORS then RC_ERRORS else words.count;
  for i: 0..<n { s[0].code_words[i] = words[i]; }
  s[0].code_words_n = n;
}
// One ask at a time: false while another waits for its answer, or when it is not an ask.
es_code_go :: (s: [] EdShell, flight: int, k: int) -> bool {
  if s[0].code_flight != ES_FLY_NONE || s[0].code_page_n == 0 { return false; }
  page := cast(string) s[0].code_page[0..<s[0].code_page_n];
  op := ifx flight == ES_FLY_LIST then RC_LIST else ifx flight == ES_FLY_READ then RC_READ else RC_SAVE;
  text := ifx flight == ES_FLY_SAVE then cast(string) s[0].code_text[0..<s[0].code_n] else "";
  ask := rc_ask(op, page, es_file_path(s, k), text, s[0].code_req[..]);
  if ask.count == 0 { return false; }
  s[0].code_req_n = ask.count; s[0].code_flight = flight; s[0].code_ask = true; s[0].code_want = k;
  s[0].code_resp_n = 0; s[0].code_lost = false;
  return true;
}
// The host says the dev server serves this page, and names the page's module.
es_code_here :: (s: [] EdShell, length: int) {
  n := ifx length < 0 || length > RC_PAGE then 0 else length;
  if s[0].code_page_n > 0 || !rc_page_ok(cast(string) s[0].inbox[0..<n]) { return; }
  for i: 0..<n { s[0].code_page[i] = s[0].inbox[i]; }
  s[0].code_page_n = n;
  s[0].code_door_n = ct_copy(s[0].code_door[..], RC_URL);
  _ := es_code_go(s, ES_FLY_LIST, -1);
}
es_code_piece :: (s: [] EdShell, length: int) {
  if s[0].code_flight == ES_FLY_NONE { return; }
  n := ifx length < 0 then 0 else ifx length > ES_INBOX then ES_INBOX else length;
  if s[0].code_resp_n + n > RC_TEXT + RC_HEAD { s[0].code_lost = true; return; }
  for i: 0..<n { s[0].code_resp[s[0].code_resp_n + i] = s[0].inbox[i]; }
  s[0].code_resp_n += n;
}
es_code_end :: (s: [] EdShell, status: int) {
  flight := s[0].code_flight;
  if flight == ES_FLY_NONE { return; }
  s[0].code_flight = ES_FLY_NONE;
  page := cast(string) s[0].code_page[0..<s[0].code_page_n];
  a := rc_answer_read(ifx s[0].code_lost then "" else cast(string) s[0].code_resp[0..<s[0].code_resp_n]);
  if flight == ES_FLY_LIST {
    // any answer but the realm's files: there is no code here (a page that is not a realm's, a server that has no such route)
    s[0].nfiles = 0;
    if status != 200 || !a.ok || a.what != RC_FILES_ARE || a.name != page { return; }
    at := 0;
    for k: 0..<a.n {
      f := rc_file_at(page, a.rest, at);
      s[0].file_n[k] = ct_copy(s[0].file[k][..], f.path); s[0].file_bytes[k] = f.bytes;
      at = f.next;
    }
    s[0].nfiles = a.n;
    return;
  }
  path := es_file_path(s, s[0].code_want);
  if a.ok && a.what == RC_REFUSED { es_code_say(s, ES_NOTE_NO, a.name); return; }
  if flight == ES_FLY_READ {
    if status != 200 || !a.ok || a.what != RC_FILE || a.name != path { es_code_say(s, ES_NOTE_NO, "That file did not open: the dev server did not answer."); return; }
    for i: 0..<a.rest.count { s[0].code_text[i] = a.rest[i]; }
    s[0].code_n = a.rest.count; s[0].code_at = s[0].code_want;
    s[0].code_sent = s[0].code_edits; s[0].code_long = false; s[0].code_fill = true; s[0].code_leave = -1;
    es_code_say(s, ES_NOTE_NONE, "");
    return;
  }
  if status != 200 || !a.ok || a.name != path || (a.what != RC_SAVED && a.what != RC_ERRORS_ARE) {
    s[0].code_sent = s[0].code_edits - 1;   // it is still not saved
    es_code_say(s, ES_NOTE_NO, "That did not save: the dev server did not answer.");
    return;
  }
  if a.what == RC_SAVED { es_code_say(s, ES_NOTE_SAVED, ""); } else { es_code_say(s, ES_NOTE_ERRORS, a.rest); }
}
// A press in the Code pane, or on its button in the strip. Whether it was one.
es_code_click :: (s: [] EdShell, id: string) -> bool {
  if s[0].nfiles == 0 { return false; }
  if id == "code" { s[0].code = !s[0].code; s[0].code_fill = s[0].code && s[0].code_at >= 0; return true; }
  if id == "code.errors.copy" { for i: 0..<s[0].code_words_n { s[0].clip[i] = s[0].code_words[i]; } s[0].clip_n = s[0].code_words_n; return true; }
  if id == "code.save" {
    if !es_code_changed(s) || s[0].code_long { return true; }
    sent := s[0].code_edits;
    if es_code_go(s, ES_FLY_SAVE, s[0].code_at) { s[0].code_sent = sent; es_code_say(s, ES_NOTE_NONE, ""); }
    return true;
  }
  k := es_index(id, "file.");
  if k < 0 || k >= s[0].nfiles { return false; }
  if k == s[0].code_at && !es_code_changed(s) { return true; }
  if s[0].file_bytes[k] > RC_TEXT { es_code_say(s, ES_NOTE_NO, "That file is longer than the editor opens (192 KB)."); return true; }
  // a file with changes is not left by one press: the same file picked again drops them
  if es_code_changed(s) && s[0].code_leave != k {
    s[0].code_leave = k;
    es_code_say(s, ES_NOTE_NO, "This file has changes that are not saved. Save it, or pick the other file again to drop them.");
    return true;
  }
  if !es_code_go(s, ES_FLY_READ, k) { es_code_say(s, ES_NOTE_NO, "The last save is still on its way. Try again."); }
  return true;
}
// What is typed in the code field, whole, each time it changes.
es_code_typed :: (s: [] EdShell, length: int) {
  s[0].code_edits += 1; s[0].code_leave = -1;
  if s[0].code_note != ES_NOTE_ERRORS { es_code_say(s, ES_NOTE_NONE, ""); }   // the compiler's words stay while they are mended
  if length < 0 || length > RC_TEXT { s[0].code_long = true; return; }
  for i: 0..<length { s[0].code_text[i] = s[0].inbox[i]; }
  s[0].code_n = length; s[0].code_long = false;
}

es_build :: (s: [] EdShell) {
  t := s[0].tree[..]; u := s[0].ui[..]; m := s[0].model[..];
  buf: [UI_ID] u8; buf2: [UI_ID] u8; name: [EM_NAME] u8; line: [EM_WORDS] u8;
  tr_begin(t);
  dock := k_dock(t, "editor", true);
  if !s[0].held { places := k_dock_side(t, "places"); }   // the site's side, which the page's host puts in the slot (coax/web/host.js)
  if !s[0].have {
    bar := k_pane(t, u, "bar", DK_TOP, "");
    wait := tr_leaf(t, "bar.wait", TG_SPAN, "meta", "Opening the world");
    k_pane_end(t);
    tr_close(t);
    return;
  }
  sel := em_entity_at(m, m[0].sel);

  // the strip: what can be done to the world as a whole
  bar := k_pane(t, u, "bar", DK_TOP, "");
  tr_attr(t, bar, AT_LABEL, "Editor");
  undo := k_button(t, u, "undo", "Undo", ifx m[0].undo > 0 then BS_PLAIN else BS_DISABLED);
  redo := k_button(t, u, "redo", "Redo", ifx m[0].redo > 0 then BS_PLAIN else BS_DISABLED);
  // a world kept on this device has no live lane: nothing to publish
  if !m[0].local && !m[0].at_once {
    pub := k_button(t, u, "publish", "Publish", BS_PRIMARY);
    whens := ES_WHEN; notes := ES_WHEN_NOTE;
    k_select_begin(t, u, "when", whens[s[0].when], "When a publish reaches people", s[0].open == ES_OPEN_WHEN);
    if s[0].open == ES_OPEN_WHEN { for k: 0..<2 { r := k_row(t, u, tr_join(buf[..], "when.", k), whens[k], notes[k], k == s[0].when); } }
    k_select_end(t, s[0].open == ES_OPEN_WHEN);
  }
  // the viewport: the tool the pointer is, the grid a move snaps to, a new thing at the point last tapped, the camera and the clock.
  // A world that is only lists of switches has no thing to pick or move: it has none of these (shell-lists.coax)
  tools := ES_TOOL; tnotes := ES_TOOL_NOTE; grids := ES_GRID;
  landing := es_landing(s);
  plain := es_lists_only(m);
  if !plain {
  k_select_begin(t, u, "tool", ifx landing then ES_LAND else tools[ifx s[0].tool < ES_TOOLS then s[0].tool else 0], "What the pointer does in the world", s[0].open == ES_OPEN_TOOL);
  if s[0].open == ES_OPEN_TOOL {
    for k: 0..<ES_TOOLS { r := k_row(t, u, tr_join(buf[..], "tool.", k), tools[k], tnotes[k], k == s[0].tool); }
    if m[0].land { r := k_row(t, u, tr_join(buf[..], "tool.", ES_TOOL_LAND), ES_LAND, ES_LAND_NOTE, landing); }
  }
  k_select_end(t, s[0].open == ES_OPEN_TOOL);
  // the land's brush: its kind, what it paints, how wide it is and how hard it presses
  if landing {
    brushes := ES_BRUSH; bnotes := ES_BRUSH_NOTE;
    k_select_begin(t, u, "brush", brushes[s[0].brush], "What the brush does to the ground", s[0].open == ES_OPEN_BRUSH);
    if s[0].open == ES_OPEN_BRUSH { for k: 0..<WE_BRUSHES { r := k_row(t, u, tr_join(buf[..], "brush.", k), brushes[k], bnotes[k], k == s[0].brush); } }
    k_select_end(t, s[0].open == ES_OPEN_BRUSH);
    if s[0].brush == 0 && m[0].nm > 0 {
      at := ifx s[0].mat < m[0].nm then s[0].mat else 0;
      mn := m[0].mat_name[at];
      k_select_begin(t, u, "mat", cast(string) mn[0..<m[0].mat_n[at]], "What the brush paints", s[0].open == ES_OPEN_MAT);
      if s[0].open == ES_OPEN_MAT { for k: 0..<m[0].nm { kn := m[0].mat_name[k]; r := k_row(t, u, tr_join(buf[..], "mat.", k), cast(string) kn[0..<m[0].mat_n[k]], "", k == at); } }
      k_select_end(t, s[0].open == ES_OPEN_MAT);
    }
    radii := ES_RADIUS_CM;
    n0 := ct_put_int(line[..], 0, radii[s[0].radius] / 100); n0 = ct_put(line[..], n0, " m");
    rs := k_stepper(t, "radius", "Radius", cast(string) line[0..<n0], es_radius_ok(s, s[0].radius - 1), es_radius_ok(s, s[0].radius + 1));
    n0 = ct_put_int(line[..], 0, (s[0].strength + 1) * 10); n0 = ct_put(line[..], n0, "%");
    ss := k_stepper(t, "strength", "Strength", cast(string) line[0..<n0], s[0].strength > 0, s[0].strength < ES_STRENGTHS - 1);
  }
  if !landing {
    k_select_begin(t, u, "grid", grids[s[0].grid], "The grid a moved thing snaps to", s[0].open == ES_OPEN_GRID);
    if s[0].open == ES_OPEN_GRID { for k: 0..<ES_GRIDS { r := k_row(t, u, tr_join(buf[..], "grid.", k), grids[k], "", k == s[0].grid); } }
    k_select_end(t, s[0].open == ES_OPEN_GRID);
  }
  if m[0].here && m[0].nk > 0 {
    k_select_begin(t, u, "add", "Add", "Place a new thing at the point you last tapped", s[0].open == ES_OPEN_ADD);
    if s[0].open == ES_OPEN_ADD {
      for k: 0..<m[0].nk {
        kn := m[0].kind_name[k];
        r := k_row(t, u, tr_join(buf[..], "add.", m[0].kind_id[k]), cast(string) kn[0..<m[0].kind_n[k]], "", false);
      }
      for k: 0..<m[0].nt {
        tn := m[0].t_name[k];
        r := k_row(t, u, tr_join(buf[..], "addt.", m[0].t_id[k]), cast(string) tn[0..<m[0].t_name_n[k]], "Template", false);
      }
      // a world with more kinds than a model names says how many of them are here
      if m[0].kinds_all > m[0].nk {
        n := ct_put_int(line[..], 0, m[0].nk); n = ct_put(line[..], n, " of "); n = ct_put_int(line[..], n, m[0].kinds_all); n = ct_put(line[..], n, " kinds are listed here.");
        more := k_meta(t, "add.more", cast(string) line[0..<n]);
      }
    }
    k_select_end(t, s[0].open == ES_OPEN_ADD);
    counts := ES_COUNT_NAME;
    k_select_begin(t, u, "count", counts[s[0].count], "How many of a kind Add places", s[0].open == ES_OPEN_COUNT);
    if s[0].open == ES_OPEN_COUNT { for k: 0..<ES_COUNTS { r := k_row(t, u, tr_join(buf[..], "count.", k), counts[k], "", k == s[0].count); } }
    k_select_end(t, s[0].open == ES_OPEN_COUNT);
  }
  es_build_clock(s);
  fly := k_button(t, u, "fly", ifx s[0].fly then "Stop flying" else "Fly", BS_PLAIN);
  run := k_button(t, u, "run", ifx s[0].paused then "Play" else "Pause", BS_PLAIN);
  step := k_button(t, u, "step", "Step", BS_PLAIN);
  sim := k_button(t, u, "sim", ifx s[0].sim then "Stop simulating" else "Simulate", BS_PLAIN);
  }
  agent := k_button(t, u, "agent", ifx s[0].agent then "Hide agent" else "Agent", BS_PLAIN);
  // assets: only where the world's server answered with its list. Closed, its button still takes a dropped file
  asseting := s[0].assets && s[0].as_have;
  if s[0].as_have { ab := k_button(t, u, "assets", ifx s[0].assets then "Hide assets" else "Assets", BS_PLAIN); if !s[0].assets { tr_attr(t, ab, AT_DROP, ""); } }
  // files: only where the world's server answered with its attachments (a member, or the dev server)
  filing := s[0].files && s[0].fl.have && !asseting;
  if s[0].fl.have { fb := k_button(t, u, "files", ifx filing then "Hide files" else "Files", BS_PLAIN); }
  // code: only where the dev server answered with the realm's files
  // scripts: only where the world's server answered with its script list
  scripting := s[0].scripts && s[0].sc.have && !asseting && !filing;
  if s[0].sc.have { sb := k_button(t, u, "scripts", ifx scripting then "Hide scripts" else "Scripts", BS_PLAIN); }
  coding := s[0].code && s[0].nfiles > 0 && !asseting && !filing && !scripting;
  if s[0].nfiles > 0 { cb := k_button(t, u, "code", ifx s[0].code then "Hide code" else "Code", BS_PLAIN); }
  w := m[0].world;
  n := ct_put(line[..], 0, cast(string) w[0..<m[0].world_n]);
  n = ct_put(line[..], n, " · revision "); n = ct_put_int(line[..], n, m[0].rev);
  es_rv_build_bar(s, cast(string) line[0..<n]);   // a button that opens the Revisions list, and what the newest step changed (shell-revs.coax)
  k_pane_end(t);
  revising := s[0].revs && s[0].rv.have && !coding && !asseting && !filing && !scripting;


  // the realm's code takes the right side while it is open; else the selected thing, and what was refused
  if coding { es_build_code(s); }
  if asseting { es_build_assets(s); }
  if filing { es_build_files(s); }
  if scripting { es_build_scripts(s); }
  if revising { es_build_revs(s); }
  // the editor's one side, on the right: what is selected, then the world's things and actors; the realm's code,
  // the assets, the files or the scripts take its place while one of them is open
  if !coding && !asseting && !filing && !scripting && !revising {
  right := k_pane(t, u, "one", DK_RIGHT, ifx plain then "World" else "Selected");
  es_fl_build_pin(s);   // a picture pinned beside the scene (shell-files.coax)
  es_build_said(s);
  es_build_lists(s);    // a realm's board and its tools, each row a switch (shell-lists.coax)
  if !plain {
  if s[0].ngroup > 0 {
    grp := k_card(t, u, "group", "Group");
    n = ct_put_int(line[..], 0, s[0].ngroup); n = ct_put(line[..], n, ifx s[0].ngroup == 1 then " thing" else " things");
    gm := k_meta(t, "group.n", cast(string) line[0..<n]);
    gf := k_prop(t, u, "tname", "Name", "A name for the template");
    gr := tr_open(t, "group.acts", TG_DIV, "rowf");
    gs := k_button(t, u, "tsave", "Save as template", ifx s[0].ngroup >= 2 && s[0].tname_n > 0 then BS_PLAIN else BS_DISABLED);
    gc := k_link(t, "tclear", "Clear the group");
    tr_close(t);
    tr_close(t);
  }
  es_build_plan(s);
  if sel < 0 { none := k_meta(t, "one.none", ifx m[0].na > 0 then "Pick a thing or an actor from the list." else "Pick a thing from the list."); }
  else {
    kind := em_kind_name(m, m[0].e_kind[sel], name[..]);
    card := k_card(t, u, "one.card", ifx kind.count > 0 then kind else "Thing");
    names := ES_COL_NAME;
    for c: 0..<WE_COLS { if m[0].cols[c] && c != WEC_KIND { f := k_prop(t, u, tr_join(buf[..], "col.", c), names[c], "0"); } }
    // where a thing's kind may be set, it is picked from the kinds the world has
    if m[0].cols[WEC_KIND] && m[0].nk > 0 {
      k_select_begin(t, u, "kind", ifx kind.count > 0 then kind else "Kind", "What kind of thing this is", s[0].open == ES_OPEN_KIND);
      if s[0].open == ES_OPEN_KIND {
        for k: 0..<m[0].nk {
          kn := m[0].kind_name[k];
          r := k_row(t, u, tr_join(buf[..], "kind.", m[0].kind_id[k]), cast(string) kn[0..<m[0].kind_n[k]], "", m[0].kind_id[k] == m[0].e_kind[sel]);
        }
      }
      k_select_end(t, s[0].open == ES_OPEN_KIND);
    }
    acts := tr_open(t, "one.acts", TG_DIV, "rowf");
    rm := k_icon_button(t, "remove", IC_TRASH, "Remove this thing");
    off := k_icon_button(t, "deselect", IC_X, "Select nothing");
    tr_close(t);
    tr_close(t);
    // its kind's content row
    cells := 0;
    for k: 0..<m[0].nc { if m[0].c_kind[k] == m[0].e_kind[sel] { cells += 1; } }
    if cells > 0 {
      facts := k_card(t, u, "one.kind", "Its kind");
      for k: 0..<m[0].nc {
        if m[0].c_kind[k] != m[0].e_kind[sel] { continue; }
        col := m[0].c_col[k]; val := m[0].c_val[k];
        // a table whose cells may be edited shows each as a field; else as what it is
        if m[0].table_n > 0 { f := k_prop(t, u, tr_join(buf2[..], "cell.", k), cast(string) col[0..<m[0].c_col_n[k]], ""); }
        else { g := k_fact(t, tr_join(buf2[..], "fact.", k), cast(string) col[0..<m[0].c_col_n[k]], cast(string) val[0..<m[0].c_val_n[k]]); }
      }
      tr_close(t);
    }
  }
  // the world's things, under what is selected
  th := k_header(t, u, "things", "Things");
  tr_close(t);   // the header holds only its title
  // a world that says how many things it holds and takes: the count, and how many of them are listed here
  if m[0].all {
    n = 0;
    if m[0].ne < m[0].all_n { n = ct_put_int(line[..], n, m[0].ne); n = ct_put(line[..], n, " of "); }
    n = ct_put_int(line[..], n, m[0].all_n); n = ct_put(line[..], n, ifx m[0].all_n == 1 then " thing" else " things");
    if m[0].ne < m[0].all_n { n = ct_put(line[..], n, " listed, the newest"); }
    n = ct_put(line[..], n, ". This world holds "); n = ct_put_int(line[..], n, m[0].all_cap); n = ct_put(line[..], n, " at most.");
    cap := k_meta(t, "things.all", cast(string) line[0..<n]);
  }
  if m[0].ne == 0 { none := k_meta(t, "things.none", "Nothing is placed yet."); }
  else {
    list := tr_open(t, "things.list", TG_NAV, "list");
    tr_attr(t, list, AT_LABEL, "Things in the world");
    for k: 0..<m[0].ne {
      n = ct_put(line[..], 0, "No. "); n = ct_put_int(line[..], n, m[0].e_id[k]);
      kind := em_kind_name(m, m[0].e_kind[k], name[..]);
      title := ifx kind.count > 0 then kind else "Thing";
      // a realm that keeps templates lets a thing be gathered into a group, from its row
      if m[0].ttable_n > 0 { r := k_row_with(t, u, tr_join(buf[..], "thing.", m[0].e_id[k]), title, cast(string) line[0..<n], k == sel, IC_PLUS, "Add to the group", es_in_group(s, m[0].e_id[k]) >= 0); }
      else { r := k_row(t, u, tr_join(buf[..], "thing.", m[0].e_id[k]), title, cast(string) line[0..<n], k == sel); }
    }
    tr_close(t);
  }
  es_build_actors(s);
  }
  k_pane_end(t);
  }
  // the foot: the chat's own conversation, which the page's host puts in the slot (coax/web/host.js). Once
  // opened it is kept and only put away, so the conversation stays as it was
  if s[0].agent_made {
    foot := k_pane(t, u, "agent.pane", DK_BOTTOM, "Agent");
    k_pane_shut(t, foot, !s[0].agent);
    slot := k_slot(t, "agent.slot");
    k_pane_end(t);
  }
  tr_close(t);
}

// ---- what a press and a field do

// A column's value on the selected thing, as the model has it.
es_value :: (m: [] EdModel, at: int, col: int) -> int {
  if col == WEC_X { return m[0].e_x[at]; } if col == WEC_Y { return m[0].e_y[at]; } if col == WEC_Z { return m[0].e_z[at]; }
  if col == WEC_YAW { return m[0].e_yaw[at]; } if col == WEC_KIND { return m[0].e_kind[at]; }
  return 0;
}
// The group saved as a template: one row of the realm's templates table (a whole-row cell edit), its
// parts each thing's kind and where it stands from the group's middle.
es_template_save :: (s: [] EdShell) {
  m := s[0].model[..];
  if s[0].ngroup < 2 || s[0].tname_n == 0 || m[0].ttable_n == 0 { return; }
  things: [PL_PARTS] PlaceThing; parts: [PL_PARTS] PlacePart; n := 0;
  for k: 0..<s[0].ngroup {
    at := em_entity_at(m, s[0].group[k]);
    if at < 0 { continue; }   // a thing removed since it was gathered
    things[n] = PlaceThing.{kind = m[0].e_kind[at], x = m[0].e_x[at], z = m[0].e_z[at], yaw = m[0].e_yaw[at], scale = m[0].e_scale[at]};
    n += 1;
  }
  nm := s[0].tname; name := cast(string) nm[0..<s[0].tname_n];
  for b: name { if b == '|' { es_say(s, "A template's name may not hold the bar sign."); return; } }
  pt: [PL_TEMPLATE] u8;
  text := ifx n >= 2 && pl_template_of(things[0..<n], parts[..]) == n then pl_template_write(parts[0..<n], pt[..]) else "";
  if text.count == 0 { es_say(s, "That group can't be saved as one template: its things are too many or too far apart."); return; }
  id := 1;
  for k: 0..<m[0].nt { if m[0].t_id[k] >= id { id = m[0].t_id[k] + 1; } }
  e := WorldEdit.{ok = true, op = WE_CELL, id = id};
  tb := m[0].ttable;
  e.table_n = ct_copy(e.table[..], cast(string) tb[0..<m[0].ttable_n]);
  e.name[0] = '*'; e.name_n = 1;
  row: [WE_TEXT + 64] u8;
  rn := ct_put_int(row[..], 0, id); rn = ct_put(row[..], rn, "|"); rn = ct_put(row[..], rn, name); rn = ct_put(row[..], rn, "|"); rn = ct_put(row[..], rn, text);
  if rn > WE_TEXT { es_say(s, "That group can't be saved as one template: its things are too many or too far apart."); return; }
  e.text_n = ct_copy(e.text[..], cast(string) row[0..<rn]);
  es_batch(s, WB_APPLY, e);
  s[0].ngroup = 0; s[0].tname_n = 0;
  dm_value(s[0].dom[..], "tname", "");
}
// A template placed at the point last tapped: every part a spawn, all in one batch, so one undo takes it back.
es_template_place :: (s: [] EdShell, id: int) {
  m := s[0].model[..];
  for k: 0..<m[0].nt {
    if m[0].t_id[k] != id { continue; }
    parts: [PL_PARTS] PlacePart; scratch: [PL_TEMPLATE] u8; edits: [PL_PARTS] WorldEdit;
    tp := m[0].t_parts[k];
    n := pl_template_read(cast(string) tp[0..<m[0].t_parts_n[k]], parts[..], scratch[..]);
    if n < 1 { es_say(s, "That template can't be read."); return; }
    for i: 0..<n {
      at := pl_template_at(parts[i], m[0].here_x, m[0].here_z, 0);
      edits[i] = WorldEdit.{ok = true, op = WE_SPAWN, id = 0, kind = at.kind, x = at.x, z = at.z, yaw = at.yaw, scale = at.scale};
    }
    es_batch_of(s, WB_APPLY, edits[..], n);
    return;
  }
}
es_click :: (s: [] EdShell, id: string) {
  m := s[0].model[..];
  // a select opens, or closes if it was the open one; any other press closes whichever is open
  was := s[0].open; s[0].open = ES_OPEN_NONE;
  names := [14] string.["when", "kind", "tool", "grid", "add", "count", "file", "brush", "mat", "licence", "clock", "pdo", "pon", "sfor"];
  for name, k: names { if id == name { s[0].open = ifx was == k + 1 then ES_OPEN_NONE else k + 1; return; } }
  if es_rv_click(s, id) { return; }
  if s[0].have && es_lists_click(s, id) { return; }
  if es_as_click(s, id) { if s[0].assets { s[0].files = false; } return; }
  if es_fl_click(s, id) { return; }
  if es_sc_click(s, id) { return; }
  if s[0].have && es_actors_click(s, id) { return; }
  if es_code_click(s, id) { if s[0].code { s[0].assets = false; s[0].files = false; } return; }
  if es_index(id, "when.") >= 0 && es_index(id, "when.") < 2 { s[0].when = es_index(id, "when."); return; }
  // the viewport's tools are the shell's to pick and the page's to obey
  words: [24] u8;
  if es_index(id, "tool.") >= 0 && es_index(id, "tool.") < ES_TOOLS {
    s[0].tool = es_index(id, "tool."); tw := ES_TOOL_WORD;
    n := ct_put(words[..], 0, "tool "); n = ct_put(words[..], n, tw[s[0].tool]);
    _ := es_act(s, ES_VIEW, cast(string) words[0..<n]);
    return;
  }
  // the land's brush: picking the tool tells the page the brush as the shell shows it
  if es_index(id, "tool.") == ES_TOOL_LAND && m[0].land {
    s[0].tool = ES_TOOL_LAND;
    _ := es_act(s, ES_VIEW, "tool land");
    es_brush_tell(s, 0); es_brush_tell(s, 2); es_brush_tell(s, 3);
    return;
  }
  if es_index(id, "brush.") >= 0 && es_index(id, "brush.") < WE_BRUSHES && es_landing(s) {
    s[0].brush = es_index(id, "brush.");
    es_brush_tell(s, 0);
    if s[0].brush == 0 { es_brush_tell(s, 1); }
    return;
  }
  if es_index(id, "mat.") >= 0 && es_index(id, "mat.") < m[0].nm && es_landing(s) { s[0].mat = es_index(id, "mat."); es_brush_tell(s, 1); return; }
  if es_landing(s) && (id == "radius.less" || id == "radius.more") {
    to := s[0].radius + (ifx id == "radius.more" then 1 else -1);
    if es_radius_ok(s, to) { s[0].radius = to; es_brush_tell(s, 2); }
    return;
  }
  if es_landing(s) && (id == "strength.less" || id == "strength.more") {
    to := s[0].strength + (ifx id == "strength.more" then 1 else -1);
    if to >= 0 && to < ES_STRENGTHS { s[0].strength = to; es_brush_tell(s, 3); }
    return;
  }
  if es_index(id, "grid.") >= 0 && es_index(id, "grid.") < ES_GRIDS {
    s[0].grid = es_index(id, "grid."); cm := ES_GRID_CM;
    n := ct_put(words[..], 0, "grid "); n = ct_put_int(words[..], n, cm[s[0].grid]);
    _ := es_act(s, ES_VIEW, cast(string) words[0..<n]);
    return;
  }
  if id == "agent" { s[0].agent = !s[0].agent; if !s[0].agent_made { s[0].turn_due = true; } s[0].agent_made = true; return; }
  if es_index(id, "count.") >= 0 && es_index(id, "count.") < ES_COUNTS { s[0].count = es_index(id, "count."); return; }
  // the group: a row's control gathers its thing or lets it go
  gid := es_group_id(id);
  if gid > 0 {
    at := es_in_group(s, gid);
    if at >= 0 { for k: at + 1..<s[0].ngroup { s[0].group[k - 1] = s[0].group[k]; } s[0].ngroup -= 1; }
    else if s[0].ngroup >= PL_PARTS { es_say(s, "A group holds 32 things at most."); }
    else { s[0].group[s[0].ngroup] = gid; s[0].ngroup += 1; }
    return;
  }
  if id == "tclear" { s[0].ngroup = 0; return; }
  if id == "tsave" { es_template_save(s); return; }
  if id == "fly" { s[0].fly = !s[0].fly; _ := es_act(s, ES_VIEW, ifx s[0].fly then "fly on" else "fly off"); return; }
  if id == "run" { s[0].paused = !s[0].paused; _ := es_act(s, ES_VIEW, ifx s[0].paused then "run pause" else "run play"); return; }
  if id == "step" { s[0].paused = true; _ := es_act(s, ES_VIEW, "step"); return; }
  if id == "sim" { s[0].sim = !s[0].sim; _ := es_act(s, ES_VIEW, ifx s[0].sim then "sim on" else "sim off"); return; }
  if !s[0].have { return; }
  // a new thing of the kind picked, at the point last tapped
  add := es_index(id, "add.");
  if add >= 0 && m[0].here {
    counts := ES_COUNT;
    if s[0].count == 0 { es_batch(s, WB_APPLY, WorldEdit.{ok = true, op = WE_SPAWN, id = 0, kind = add, x = m[0].here_x, z = m[0].here_z}); return; }
    // several: the page plans where they go, since it knows each kind's footprint and what stands there
    n := ct_put(words[..], 0, "add "); n = ct_put_int(words[..], n, add); n = ct_put(words[..], n, " "); n = ct_put_int(words[..], n, counts[s[0].count]);
    s[0].said_n = 0;
    _ := es_act(s, ES_PLAN, cast(string) words[0..<n]);
    return;
  }
  tid := es_index(id, "addt.");
  if tid > 0 && m[0].here { es_template_place(s, tid); return; }
  none: WorldEdit;
  picked := es_index(id, "kind.");
  if picked >= 0 && m[0].cols[WEC_KIND] && em_entity_at(m, m[0].sel) >= 0 {
    if picked != m[0].e_kind[em_entity_at(m, m[0].sel)] { es_batch(s, WB_APPLY, WorldEdit.{ok = true, op = WE_SET, id = m[0].sel, col = WEC_KIND, v = picked}); }
    return;
  }
  if id == "undo" && m[0].undo > 0 { es_batch(s, WB_UNDO, none); }
  else if id == "redo" && m[0].redo > 0 { es_batch(s, WB_REDO, none); }
  else if id == "publish" && !m[0].local && !m[0].at_once {
    // a world that runs scripts: the shell sends the publish, so a script that would do more can be asked about (shell-scripts.coax)
    what := ifx s[0].when == 1 then WB_PUBLISH_NEXT else WB_PUBLISH_NOW;
    if !es_sc_publish(s, what, false) { es_batch(s, what, none); }
  }
  else if id == "remove" && em_entity_at(m, m[0].sel) >= 0 { es_batch(s, WB_APPLY, WorldEdit.{ok = true, op = WE_DESPAWN, id = m[0].sel}); }
  else if id == "deselect" { es_select(s, 0); }
  else if es_index(id, "thing.") > 0 { es_select(s, es_index(id, "thing.")); }
}
// Enter in a column's field: the number typed becomes an edit, or the shell says why it is not one.
es_submit :: (s: [] EdShell, col: int) {
  m := s[0].model[..];
  at := em_entity_at(m, m[0].sel);
  if at < 0 || col < 0 || col >= WE_COLS || !m[0].cols[col] { return; }
  d := s[0].draft[col];
  v := ct_num(cast(string) d[0..<s[0].draft_n[col]]);
  names := ES_COL_NAME;
  if !v.ok {
    out: [EM_WORDS] u8;
    n := ct_put(out[..], 0, names[col]); n = ct_put(out[..], n, " takes a whole number.");
    es_say(s, cast(string) out[0..<n]);
    return;
  }
  if v.v == es_value(m, at, col) { s[0].said_n = 0; return; }
  es_batch(s, WB_APPLY, WorldEdit.{ok = true, op = WE_SET, id = m[0].sel, col = col, v = v.v});
}
// Enter in a content cell's field: what is typed becomes a cell edit of the kind's row, unless it is what the cell holds.
es_submit_cell :: (s: [] EdShell, k: int) {
  m := s[0].model[..];
  at := em_entity_at(m, m[0].sel);
  if at < 0 || k < 0 || k >= m[0].nc || m[0].table_n == 0 || m[0].c_kind[k] != m[0].e_kind[at] { return; }
  typed := s[0].cell[k]; val := m[0].c_val[k];
  text := cast(string) typed[0..<s[0].cell_n[k]];
  if text == cast(string) val[0..<m[0].c_val_n[k]] { s[0].said_n = 0; return; }
  if !em_text_ok(text, EM_VALUE) {
    es_say(s, "A cell takes one line of words or a number, and may not be empty.");
    return;
  }
  e := WorldEdit.{ok = true, op = WE_CELL, id = m[0].c_kind[k]};
  tb := m[0].table; cn := m[0].c_col[k];
  e.table_n = ct_copy(e.table[..], cast(string) tb[0..<m[0].table_n]);
  e.name_n = ct_copy(e.name[..], cast(string) cn[0..<m[0].c_col_n[k]]);
  e.text_n = ct_copy(e.text[..], text);
  es_batch(s, WB_APPLY, e);
}
// The model the page sent is in the inbox.
// The world as the conversation's next turn is told it: the selection, the point last tapped, the
// kinds and as many things as fit one action, the rest counted. False while the page is still busy.
es_turn :: (s: [] EdShell) -> bool {
  m := s[0].model[..];
  out: [ES_ACT] u8; room := out[0..<ES_ACT - 24];
  n := wt_begin(room, cast(string) m[0].world[0..<m[0].world_n], m[0].lane == 1, m[0].rev, ifx em_entity_at(m, m[0].sel) >= 0 then m[0].sel else 0);
  if m[0].here { n = wt_here(room, n, m[0].here_x, m[0].here_z); }
  for k: 0..<m[0].nk { if k < WT_KINDS { n = wt_kind(room, n, m[0].kind_id[k], cast(string) m[0].kind_name[k][0..<m[0].kind_n[k]]); } }
  if n < 0 { return true; }   // a world whose kinds alone do not fit is not told: the turn goes without it
  // the attachments the world's server listed (shell-files.coax): their names, notes and tags, never their bytes
  if s[0].fl.have {
    l := s[0].fl.l[..];
    for k: 0..<l[0].n {
      if k >= WT_FILES { break; }
      next := wt_file(room, n, fw_id_of(l, k), l[0].f[k].kind, l[0].f[k].bytes, fw_name_of(l, k), fw_note_of(l, k), fw_tags_of(l, k));
      if next < 0 { continue; }
      n = next;
    }
  }
  listed := 0;
  for k: 0..<m[0].ne {
    if listed >= WT_THINGS { break; }
    yaw := m[0].e_yaw[k];
    next := wt_thing(room, n, m[0].e_id[k], m[0].e_kind[k], m[0].e_x[k], m[0].e_z[k], ifx yaw < -179 || yaw > 180 then 0 else yaw);
    if next < 0 { break; }
    n = next; listed += 1;
  }
  if listed < m[0].ne { n = wt_more(out[..], n, m[0].ne - listed); }
  return n < 0 || es_act(s, ES_TURN, cast(string) out[0..<n]);
}
// A hosted turn's plan: its steps as one batch of edits made from the model's revision, so one undo
// takes the turn back and the server's rules answer it as they answer a person's edit.
es_plan :: (s: [] EdShell, length: int) {
  m := s[0].model[..];
  n := ifx length < 0 then 0 else ifx length > WP_BYTES then 0 else length;
  plan: [1] WorldPlan; scratch: [WP_BYTES] u8;
  if !s[0].have || !wp_read(plan[..], cast(string) s[0].inbox[0..<n], scratch[..]) { es_say(s, "The agent's change could not be read."); return; }
  if wp_word(plan[..]) != cast(string) m[0].world[0..<m[0].world_n] || plan[0].rev != m[0].rev { es_say(s, "The world changed while the agent worked. Ask it again."); return; }
  none: WorldEdit;
  if plan[0].steps[0].tool == WT_UNDO { es_batch(s, WB_UNDO, none); return; }
  if plan[0].steps[0].tool == WT_REDO { es_batch(s, WB_REDO, none); return; }
  edits: [WP_STEPS] WorldEdit;
  for k: 0..<plan[0].n {
    st := plan[0].steps[k];
    at := em_entity_at(m, st.id);
    if st.tool != WT_PLACE && at < 0 { es_say(s, "The agent named a thing that is no longer here. Ask it again."); return; }
    if st.tool == WT_PLACE { edits[k] = WorldEdit.{ok = true, op = WE_SPAWN, id = 0, kind = st.kind, x = st.x, z = st.z, yaw = st.yaw}; }
    else if st.tool == WT_MOVE { edits[k] = WorldEdit.{ok = true, op = WE_MOVE, id = st.id, x = st.x, y = m[0].e_y[at], z = st.z}; }
    else if st.tool == WT_TURN { edits[k] = WorldEdit.{ok = true, op = WE_ROTATE, id = st.id, yaw = st.yaw}; }
    else if st.tool == WT_SIZE { edits[k] = WorldEdit.{ok = true, op = WE_SCALE, id = st.id, scale = st.percent}; }
    else { edits[k] = WorldEdit.{ok = true, op = WE_DESPAWN, id = st.id}; }
    if !we_valid(edits[k]) { es_say(s, "The agent asked for a change this world does not take."); return; }
  }
  es_batch_of(s, WB_APPLY, edits[..], plan[0].n);
}
es_model :: (s: [] EdShell, length: int) {
  n := ifx length < 0 then 0 else ifx length > ES_INBOX then ES_INBOX else length;
  // bytes that are not a model close the lists: the shell shows nothing it was not told
  if !em_read(s[0].model[..], cast(string) s[0].inbox[0..<n], s[0].scratch[..]) { s[0].have = false; return; }
  s[0].have = true; s[0].turn_due = true;
  if !s[0].as_asked && es_as_go(s, ES_AS_LIST, "") { s[0].as_asked = true; }   // the world's assets, once it is known which world this is
  // a gathered thing that is no longer in the world leaves the group
  kept := 0;
  for k: 0..<s[0].ngroup { if em_entity_at(s[0].model[..], s[0].group[k]) >= 0 { s[0].group[kept] = s[0].group[k]; kept += 1; } }
  s[0].ngroup = kept;
}

// ---------------------------------------------------------------- the face's calls

// One frame: builds and flushes if something changed or is entering. Bytes of commands to apply.
coaxial_editor_frame :: (s: [] EdShell, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready {
    n := mono_frames(s[0].sets[..]);
    s[0].ready = true; s[0].dirty = true; s[0].shown_sel = -1;
  }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  es_rv_kick(s);   // the world's events, read again once its revision moved and the channel is free (shell-revs.coax)
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..]; m := s[0].model[..];
  if !d[0].styled {
    n := mono_dock_css(s[0].css[..], mono_css(s[0].css[..]));
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  es_build(s);
  ui_end(s[0].ui[..]);
  // the fields hold the selected thing's numbers: filled when the thing or the world's revision
  // changes, in the flush that makes them, so nothing typed after is written over
  at := ifx s[0].have then em_entity_at(m, m[0].sel) else -1;
  if s[0].have && (m[0].sel != s[0].shown_sel || m[0].rev != s[0].shown_rev) {
    s[0].shown_sel = m[0].sel; s[0].shown_rev = m[0].rev;
    buf: [UI_ID] u8;
    for c: 0..<WE_COLS {
      if at < 0 || !m[0].cols[c] { continue; }
      n := ct_put_int(s[0].draft[c][..], 0, es_value(m, at, c));
      s[0].draft_n[c] = n;
      dr := s[0].draft[c];
      dm_value(d, tr_join(buf[..], "col.", c), cast(string) dr[0..<n]);
    }
    for k: 0..<m[0].nc {
      if at < 0 || m[0].table_n == 0 || m[0].c_kind[k] != m[0].e_kind[at] { continue; }
      val := m[0].c_val[k];
      s[0].cell_n[k] = em_copy(s[0].cell[k][..], cast(string) val[0..<m[0].c_val_n[k]]);
      dm_value(d, tr_join(buf[..], "cell.", k), cast(string) val[0..<m[0].c_val_n[k]]);
    }
  }
  if s[0].have { es_plan_fill(s, d); es_fl_fill(s, d); es_sc_fill(s, d); }
  s[0].animating = s[0].ui[0].busy;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  // the code field holds the open file: filled once the field is on the page, after the flush that made it
  if s[0].code_fill && !d[0].overflow {
    with := dm_value_after(d, "code.text", cast(string) s[0].code_text[0..<s[0].code_n]);
    if with >= 0 { s[0].code_fill = false; }
    if with > 0 { bytes = with; }
  }
  bytes = es_sc_fill_after(s, d, bytes);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; s[0].shown_sel = -1; s[0].pshown = -2; s[0].code_fill = s[0].code && s[0].code_at >= 0; s[0].sc.fill = s[0].scripts; return -1; }
  return bytes;
}
coaxial_editor_busy :: (s: [] EdShell) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating); }
// A press (1), a field's text (2) or Enter in a field (3) on the node in this slot; or the page's model (6), in the inbox.
coaxial_editor_event :: (s: [] EdShell, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].dirty = true;
  es_event(s, kind, slot, length);
  es_fl_kick(s);   // the world's attachments, once the channel to its server is free (shell-files.coax)
  es_sc_kick(s);   // the world's scripts, likewise; and whether the page's script status is wanted (shell-scripts.coax)
  // the conversation in the foot is told of the world as it now is, once the page has room for the word
  if s[0].agent_made && s[0].have && s[0].turn_due && es_turn(s) { s[0].turn_due = false; }
}
es_event :: (s: [] EdShell, kind: int, slot: int, length: int) {
  if kind == ES_MODEL { es_model(s, length); return; }
  if kind == ES_HELD { s[0].held = true; s[0].dirty = true; return; }
  if kind == ES_AGENT { s[0].agent = true; s[0].agent_made = true; s[0].turn_due = true; return; }
  if kind == ES_PLANNED { es_plan(s, length); return; }
  if kind == ES_CODE_HERE { es_code_here(s, length); return; }
  if kind == ES_PIECE { es_code_piece(s, length); return; }
  if kind == ES_END { es_code_end(s, slot); return; }
  if kind == ES_FILE { if es_id_is(dm_slot_id(s[0].dom[..], slot), "files") { es_fl_file(s, length); } else { es_as_file(s, length); } return; }
  if kind == ES_SENT { if s[0].rv.flight != ES_RV_NONE { es_rv_sent(s, slot, length); } else if s[0].sc.flight != ES_SC_NONE { es_sc_sent(s, slot, length); } else if s[0].fl.flight != ES_FL_NONE { es_fl_sent(s, slot, length); } else { es_as_sent(s, slot, length); } return; }
  if kind == ES_VIEWER { s[0].sc.logged = true; return; }
  if kind == ES_STATUS { es_sc_status(s, length); return; }
  id := dm_slot_id(s[0].dom[..], slot);
  if id.count == 0 { return; }
  if kind == ES_CLICK { es_click(s, id); }
  if id == "code.text" { if kind == ES_INPUT { es_code_typed(s, length); } return; }
  if kind == ES_INPUT && es_id_is(id, "files.") && es_fl_typed(s, id, length) { return; }
  if es_id_is(id, "scripts.") && (id == "scripts.text" || id == "scripts.name" || id == "scripts.reason") { if kind == ES_INPUT { _ := es_sc_typed(s, id, length); } return; }
  if kind == ES_SUBMIT && id == "files.url" { _ := es_fl_click(s, "files.link"); return; }
  if id == "tname" {
    if kind == ES_INPUT {
      lo := 0; hi := ifx length < 0 then 0 else ifx length > ES_INBOX then ES_INBOX else length;
      while lo < hi && (s[0].inbox[lo] == ' ' || s[0].inbox[lo] == '\n') { lo += 1; }
      while hi > lo && (s[0].inbox[hi - 1] == ' ' || s[0].inbox[hi - 1] == '\n') { hi -= 1; }
      n := ifx hi - lo > EM_NAME then 0 else hi - lo;
      ok := true;
      for i: 0..<n { if s[0].inbox[lo + i] < 32 || s[0].inbox[lo + i] == 127 { ok = false; } }
      s[0].tname_n = ifx ok then n else 0;
      for i: 0..<s[0].tname_n { s[0].tname[i] = s[0].inbox[lo + i]; }
    }
    if kind == ES_SUBMIT { es_template_save(s); }
    return;
  }
  cell := es_index(id, "cell.");
  if cell >= 0 && cell < EM_CELLS {
    if kind == ES_INPUT {
      lo := 0; hi := ifx length < 0 then 0 else ifx length > ES_INBOX then ES_INBOX else length;
      while lo < hi && (s[0].inbox[lo] == ' ' || s[0].inbox[lo] == '\n') { lo += 1; }
      while hi > lo && (s[0].inbox[hi - 1] == ' ' || s[0].inbox[hi - 1] == '\n') { hi -= 1; }
      n := ifx hi - lo > EM_VALUE then 0 else hi - lo;   // longer than a cell holds: not one
      for i: 0..<n { s[0].cell[cell][i] = s[0].inbox[lo + i]; }
      s[0].cell_n[cell] = n;
    }
    if kind == ES_SUBMIT { es_submit_cell(s, cell); }
    return;
  }
  pc := es_index(id, "plan.");
  if pc >= 0 && pc < ES_PLAN_COLS {
    if kind == ES_INPUT {
      lo := 0; hi := ifx length < 0 then 0 else ifx length > ES_INBOX then ES_INBOX else length;
      while lo < hi && (s[0].inbox[lo] == ' ' || s[0].inbox[lo] == '\n') { lo += 1; }
      while hi > lo && (s[0].inbox[hi - 1] == ' ' || s[0].inbox[hi - 1] == '\n') { hi -= 1; }
      n := ifx hi - lo > EM_ROUTE then 0 else hi - lo;   // longer than a route holds: not one
      for i: 0..<n { s[0].pdraft[pc][i] = s[0].inbox[lo + i]; }
      s[0].pdraft_n[pc] = n;
    }
    if kind == ES_SUBMIT { es_plan_submit(s, pc); }
    return;
  }
  col := es_index(id, "col.");
  if col < 0 || col >= WE_COLS { return; }
  if kind == ES_INPUT {
    // spaces round a number are not part of it
    lo := 0; hi := ifx length < 0 then 0 else ifx length > ES_INBOX then ES_INBOX else length;
    while lo < hi && (s[0].inbox[lo] == ' ' || s[0].inbox[lo] == '\n') { lo += 1; }
    while hi > lo && (s[0].inbox[hi - 1] == ' ' || s[0].inbox[hi - 1] == '\n') { hi -= 1; }
    n := ifx hi - lo > ES_DRAFT then 0 else hi - lo;   // longer than any number: not one
    for i: 0..<n { s[0].draft[col][i] = s[0].inbox[lo + i]; }
    s[0].draft_n[col] = n;
  }
  if kind == ES_SUBMIT { es_submit(s, col); }
}
coaxial_editor_size :: (s: [] EdShell, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
coaxial_editor_inbox_cap :: () -> int #export_c #effects(all) { return ES_INBOX; }
// The action that waits for the page: its kind (0: none) and its bytes (at acts[0]); done takes it away.
coaxial_editor_act_kind :: (s: [] EdShell) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].nacts > 0 then s[0].act_kind[0] else 0; }
coaxial_editor_act_len :: (s: [] EdShell) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].nacts > 0 then s[0].act_n[0] else 0; }
coaxial_editor_act_done :: (s: [] EdShell) #export_c #effects(all) {
  if s.count < 1 || s[0].nacts < 1 { return; }
  for k: 1..<s[0].nacts { s[0].acts[k - 1] = s[0].acts[k]; s[0].act_n[k - 1] = s[0].act_n[k]; s[0].act_kind[k - 1] = s[0].act_kind[k]; }
  s[0].nacts -= 1;
}

// The ask that waits to go to the dev server: its bytes (at code_req; 0: none), to the address at code_door; asked takes it away.
coaxial_editor_asking :: (s: [] EdShell) -> int #export_c #effects(all) { return ifx s.count > 0 && s[0].code_ask then s[0].code_req_n else 0; }
coaxial_editor_asked :: (s: [] EdShell) #export_c #effects(all) { if s.count > 0 { s[0].code_ask = false; } }
// The ask that waits to go to the world's server (shell-assets.coax; ES_HOW_*): 0 none, 1 a GET of the address at
// as_url, 2 a POST there of the bytes at as_head followed by the waiting file's, 3 a POST of as_head followed by the
// file's SHA-256 and a line end (the file stays), 4 a PUT of the file alone to as_url, 5 a POST of as_head alone,
// 6 a POST of the Scripts pane's source alone (sc.src, coaxial_editor_source bytes of it); fetched takes it away.
coaxial_editor_fetching :: (s: [] EdShell) -> int #export_c #effects(all) { return ifx s.count < 1 || !s[0].as_ask then 0 else s[0].as_how; }
coaxial_editor_fetched :: (s: [] EdShell) #export_c #effects(all) { if s.count > 0 { s[0].as_ask = false; } }
coaxial_editor_source :: (s: [] EdShell) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].sc.src_n else 0; }
// What a Copy press put by for the clipboard: its bytes (at clip; 0: none); done takes it away.
coaxial_editor_clip_len :: (s: [] EdShell) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].clip_n else 0; }
coaxial_editor_clip_done :: (s: [] EdShell) #export_c #effects(all) { if s.count > 0 { s[0].clip_n = 0; } }

// ---------------------------------------------------------------- checks

EsTest :: struct { s: [1] EdShell; text: [EM_BYTES] u8; edits: [WE_BATCH] WorldEdit; }
// The model fixture, given to the shell as the host gives it.
es_test_model :: (h: [] EsTest, sel: int, rev: int, undo: int, refused: string) {
  s := h[0].s[..]; out := h[0].text[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true; cols[WEC_Z] = true; cols[WEC_YAW] = true;
  n := em_begin(out, "splice", 0, rev, undo, 0, sel);
  n = em_cols(out, n, cols[..]);
  n = em_kind(out, n, 1001, "Cargo crate");
  n = em_kind(out, n, 1002, "Parked rover");
  n = em_entity(out, n, 1, 1001, 350, 0, -1200, 90, 100);
  n = em_entity(out, n, 2, 1002, -40, 12, 600, -179, 100);
  n = em_cell(out, n, 1002, "kit", "rover");
  if refused.count > 0 { n = em_no(out, n, refused); }
  for i: 0..<n { s[0].inbox[i] = out[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, n);
}
es_test_type :: (h: [] EsTest, id: string, text: string) {
  s := h[0].s[..];
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_editor_event(s, ES_INPUT, dm_find(s[0].dom[..], id), text.count);
  coaxial_editor_event(s, ES_SUBMIT, dm_find(s[0].dom[..], id), 0);
}
// The waiting action as the batch it is: its kind of batch, or -1.
es_test_batch :: (h: [] EsTest, rev: int) -> int {
  s := h[0].s[..];
  if coaxial_editor_act_kind(s) != ES_BATCH { return -1; }
  a := s[0].acts[0];
  b := we_batch_read(cast(string) a[0..<coaxial_editor_act_len(s)], h[0].edits[..]);
  return ifx b.ok && b.rev == rev then b.what else -1;
}
// The same world where a thing's kind may be set too.
es_test_kinds :: (h: [] EsTest) {
  s := h[0].s[..]; out := h[0].text[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true; cols[WEC_KIND] = true;
  n := em_begin(out, "splice", 0, 4, 0, 0, 1);
  n = em_cols(out, n, cols[..]);
  n = em_kind(out, n, 1001, "Cargo crate");
  n = em_kind(out, n, 1002, "Parked rover");
  n = em_entity(out, n, 1, 1001, 350, 0, -1200, 90, 100);
  for i: 0..<n { s[0].inbox[i] = out[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, n);
}
// Frames, with the read of the world's events a frame asks for answered as a server with none answers it
// (shell-revs-checks.coax answers it with events).
es_test_frames :: (h: [] EsTest, n: int) {
  s := h[0].s[..];
  for k: 0..<n {
    _ := coaxial_editor_frame(s, 0.016, true);
    if s[0].rv.flight != ES_RV_NONE { coaxial_editor_fetched(s); coaxial_editor_event(s, ES_SENT, 404, 0); }
  }
}

#test "before a model the shell says it is opening; with one it lists the world's things by kind" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  n := coaxial_editor_frame(s, 0.016, true);
  #assert n > 1000 && tr_find(t, "bar.wait") > 0 && tr_find(t, "things") < 0 && s[0].dom[0].out[0] == DC_STYLE;
  es_test_model(h[..], 0, 7, 3, "");
  n = coaxial_editor_frame(s, 0.016, true);
  #assert t[0].lost == 0 && t[0].depth == 0 && tr_find(t, "bar.wait") < 0;
  #assert tr_text_of(t, tr_find(t, "thing.1.t")) == "Cargo crate" && tr_text_of(t, tr_find(t, "thing.2.t")) == "Parked rover" && tr_text_of(t, tr_find(t, "thing.2.m")) == "No. 2";
  #assert tr_text_of(t, tr_find(t, "bar.rev")) == "splice · revision 7" && tr_find(t, "one.none") > 0 && tr_find(t, "one.card") < 0;
  #assert !tr_has(t, tr_find(t, "undo"), AT_DISABLED) && tr_has(t, tr_find(t, "redo"), AT_DISABLED);
  es_test_frames(h[..], 3);
  #assert !coaxial_editor_busy(s) && coaxial_editor_frame(s, 0.016, true) == 0;
}

#test "the dock keeps a column for the site's side, unless the page is held in the app shell, whose side is around it" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  es_test_model(h[..], 0, 7, 3, "");
  n := coaxial_editor_frame(s, 0.016, true);
  #assert tr_find(t, "places.slot") > 0 && tr_find(t, "thing.1.t") > 0;
  coaxial_editor_event(s, ES_HELD, 0, 0);
  n = coaxial_editor_frame(s, 0.016, true);
  #assert tr_find(t, "places") < 0 && tr_find(t, "places.slot") < 0 && tr_find(t, "thing.1.t") > 0 && t[0].depth == 0;
}

#test "a press on a thing asks the page to select it; the selected thing shows its fields filled and its kind's facts" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  es_test_model(h[..], 0, 7, 3, "");
  es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "thing.2"), 0);
  a := s[0].acts[0];
  #assert coaxial_editor_act_kind(s) == ES_SELECT && cast(string) a[0..<coaxial_editor_act_len(s)] == "2";
  coaxial_editor_act_done(s);
  #assert coaxial_editor_act_kind(s) == 0 && coaxial_editor_act_len(s) == 0;
  // the page selects it and says so
  es_test_model(h[..], 2, 7, 3, "");
  n := coaxial_editor_frame(s, 0.016, true);
  #assert tr_has(t, tr_find(t, "thing.2"), AT_CURRENT) && !tr_has(t, tr_find(t, "thing.1"), AT_CURRENT);
  #assert tr_text_of(t, tr_find(t, "one.card.h")) == "Parked rover" && tr_find(t, "col.0") > 0 && tr_find(t, "col.2") > 0 && tr_find(t, "col.3") > 0 && tr_find(t, "col.1") < 0;
  #assert tr_text_of(t, tr_find(t, "col.3.n")) == "Turn °" && tr_text_of(t, tr_find(t, "fact.0.n")) == "kit" && tr_text_of(t, tr_find(t, "fact.0.v")) == "rover";
  // its three fields were filled in the flush that made them, and the shell is still
  values := dm_test_count(d, n, DC_VALUE);
  dx := s[0].draft[WEC_X]; dz := s[0].draft[WEC_Z]; dy := s[0].draft[WEC_YAW];
  #assert values == 3 && cast(string) dx[0..<s[0].draft_n[WEC_X]] == "-40" && cast(string) dz[0..<s[0].draft_n[WEC_Z]] == "600" && cast(string) dy[0..<s[0].draft_n[WEC_YAW]] == "-179";
  #assert !coaxial_editor_busy(s);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "deselect"), 0);
  b := s[0].acts[0];
  #assert coaxial_editor_act_kind(s) == ES_SELECT && cast(string) b[0..<coaxial_editor_act_len(s)] == "0";
}

#test "a number typed and entered is one set edit from the model's revision; what is not a number is said, and the same number asks nothing" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  es_test_model(h[..], 2, 7, 3, "");
  es_test_frames(h[..], 5);
  es_test_type(h[..], "col.0", " 125 ");
  #assert es_test_batch(h[..], 7) == WB_APPLY;
  e := h[0].edits[0];
  #assert e.op == WE_SET && e.id == 2 && e.col == WEC_X && e.v == 125 && s[0].nacts == 1;
  coaxial_editor_act_done(s);
  es_test_type(h[..], "col.3", "ninety");
  es_test_frames(h[..], 1);
  #assert s[0].nacts == 0 && tr_text_of(t, tr_find(t, "said.t")) == "Turn ° takes a whole number." && tr_text_of(t, tr_find(t, "said.k")) == "Not done";
  es_test_type(h[..], "col.3", "12345678901234567");
  #assert s[0].nacts == 0 && s[0].said_n > 0;
  es_test_type(h[..], "col.2", "600");
  es_test_frames(h[..], 1);
  #assert s[0].nacts == 0 && s[0].said_n == 0 && tr_find(t, "said") < 0;
  es_test_type(h[..], "col.2", "-600");
  #assert es_test_batch(h[..], 7) == WB_APPLY && h[0].edits[0].col == WEC_Z && h[0].edits[0].v == -600;
}

#test "undo, redo, remove and publish are batches; a button that can do nothing asks nothing; the choice of when is kept" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  es_test_model(h[..], 2, 9, 1, "");
  es_test_frames(h[..], 5);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "undo"), 0);
  #assert es_test_batch(h[..], 9) == WB_UNDO;
  coaxial_editor_act_done(s);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "redo"), 0);
  #assert s[0].nacts == 0;
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "remove"), 0);
  #assert es_test_batch(h[..], 9) == WB_APPLY && h[0].edits[0].op == WE_DESPAWN && h[0].edits[0].id == 2;
  coaxial_editor_act_done(s);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "publish"), 0);
  #assert es_test_batch(h[..], 9) == WB_PUBLISH_NOW;
  coaxial_editor_act_done(s);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "when"), 0);
  es_test_frames(h[..], 1);
  #assert s[0].open == ES_OPEN_WHEN && tr_find(t, "when.1") > 0 && tr_text_of(t, tr_find(t, "when.1.m")) == "People see it the next time they come in";
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "when.1"), 0);
  es_test_frames(h[..], 1);
  #assert s[0].open == ES_OPEN_NONE && s[0].when == 1 && tr_find(t, "when.1") < 0 && tr_text_of(t, tr_find(t, "when.l")) == "Next session";
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "publish"), 0);
  #assert es_test_batch(h[..], 9) == WB_PUBLISH_NEXT;
}

#test "a refusal in the model is a notice in its words; a new revision fills the fields again; a model that is not one closes the lists" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  es_test_model(h[..], 2, 7, 3, "That spot is inside the Scanner gate, which stays clear.");
  es_test_frames(h[..], 5);
  #assert tr_text_of(t, tr_find(t, "refused.t")) == "That spot is inside the Scanner gate, which stays clear." && tr_attr_of(t, tr_find(t, "refused"), AT_ROLE) == "status";
  es_test_model(h[..], 2, 8, 4, "");
  n := coaxial_editor_frame(s, 0.016, true);
  #assert dm_test_count(d, n, DC_VALUE) == 3 && tr_find(t, "refused") < 0 && tr_text_of(t, tr_find(t, "bar.rev")) == "splice · revision 8";
  // more actions than wait is said, not lost quietly
  for k: 0..<ES_ACTS + 1 { coaxial_editor_event(s, ES_CLICK, dm_find(d, "undo"), 0); }
  #assert s[0].nacts == ES_ACTS && s[0].said_n > 0;
  bad := "editor.model.v9 nothing";
  for i: 0..<bad.count { s[0].inbox[i] = bad[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, bad.count);
  es_test_frames(h[..], 1);
  #assert !s[0].have && tr_find(t, "bar.wait") > 0 && tr_find(t, "thing.1") < 0;
}

#test "the stylesheet is the skin's own and nothing more" {
  h: [1] EsTest; s := h[0].s[..];
  n := coaxial_editor_frame(s, 0.016, true);
  css: [ES_CSS] u8;
  want := mono_dock_css(css[..], mono_css(css[..]));
  d := s[0].dom[..];
  // the first command is the stylesheet: its opcode, its length, its bytes
  #assert d[0].out[0] == DC_STYLE && want < ES_CSS;
  got := cast(int) d[0].out[1] + cast(int) d[0].out[2] * 256 + cast(int) d[0].out[3] * 65536;
  #assert got == want;
  same := true;
  for i: 0..<want { if d[0].out[5 + i] != css[i] { same = false; } }
  #assert same;
}

// Whether the stylesheet has a rule for a class: ".name" with no more of a name after it.
es_test_styled :: (css: string, name: string) -> bool {
  for i: 0..<css.count {
    if css[i] != '.' || i + 1 + name.count > css.count || cast(string) css[i + 1..<i + 1 + name.count] != name { continue; }
    after := i + 1 + name.count;
    if after >= css.count { return true; }
    b := css[after];
    if !((b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') || b == '-' || b == '_') { return true; }
  }
  return false;
}
// Classes the kit gives a node to name it for scripts and readers, with no rule of their own in the skin.
ES_TEST_BARE :: [2] string.["btn-l", "sel-l"];   // a button's and a select's label (frames.coax k_button, k_select_begin)

#test "every class on every node of the shell, in each of its states, is one the skin has a rule for" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  css: [ES_CSS] u8;
  sheet := cast(string) css[0..<mono_dock_css(css[..], mono_css(css[..]))];
  seen := 0;
  for state: 0..<4 {
    if state == 1 { es_test_model(h[..], 0, 7, 3, ""); }
    if state == 2 { es_test_model(h[..], 2, 7, 3, "That spot is inside the Scanner gate, which stays clear."); coaxial_editor_event(s, ES_CLICK, dm_find(d, "when"), 0); }
    if state == 3 { es_test_model(h[..], 2, 8, 0, ""); es_test_type(h[..], "col.0", "far"); coaxial_editor_event(s, ES_CLICK, dm_find(d, "agent"), 0); }
    es_test_frames(h[..], 2);
    for i: 0..<t[0].n {
      cls := tr_class(t, i);
      for k: 0..<ct_parts(cls, ' ') {
        word := ct_part(cls, ' ', k);
        if word.count == 0 { continue; }
        bare := ES_TEST_BARE;
        #assert es_test_styled(sheet, word) || word == bare[0] || word == bare[1];
        seen += 1;
      }
    }
  }
  #assert seen > 120 && es_test_styled(sheet, "pane-l") && !es_test_styled(sheet, "pane-x") && !es_test_styled(sheet, "pan");
}

#test "where a kind may be set it is a select of the world's kinds: picking another is one set edit, picking the same asks nothing, and it has no number field" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  es_test_kinds(h[..]);
  es_test_frames(h[..], 2);
  #assert tr_find(t, "kind") > 0 && tr_text_of(t, tr_find(t, "kind.l")) == "Cargo crate" && tr_find(t, "col.11") < 0 && tr_find(t, "col.0") > 0 && tr_find(t, "kind.1002") < 0;
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "kind"), 0);
  es_test_frames(h[..], 1);
  #assert s[0].open == ES_OPEN_KIND && tr_has(t, tr_find(t, "kind.1001"), AT_CURRENT) && !tr_has(t, tr_find(t, "kind.1002"), AT_CURRENT);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "kind.1001"), 0);
  es_test_frames(h[..], 1);
  #assert s[0].open == ES_OPEN_NONE && s[0].nacts == 0;
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "kind"), 0);
  es_test_frames(h[..], 1);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "kind.1002"), 0);
  #assert es_test_batch(h[..], 4) == WB_APPLY && h[0].edits[0].op == WE_SET && h[0].edits[0].col == WEC_KIND && h[0].edits[0].v == 1002 && h[0].edits[0].id == 1 && s[0].open == ES_OPEN_NONE;
  // the two selects are never open together
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "kind"), 0);
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "when"), 0);
  #assert s[0].open == ES_OPEN_WHEN;
}

// The waiting action's words, when it is one for the viewport ("" otherwise); it is taken.
es_test_view :: (h: [] EsTest, out: [] u8) -> string {
  s := h[0].s[..];
  if coaxial_editor_act_kind(s) != ES_VIEW { return ""; }
  n := coaxial_editor_act_len(s);
  for i: 0..<n { out[i] = s[0].acts[0][i]; }
  coaxial_editor_act_done(s);
  return cast(string) out[0..<n];
}
es_test_press :: (h: [] EsTest, id: string) { s := h[0].s[..]; coaxial_editor_event(s, ES_CLICK, dm_find(s[0].dom[..], id), 0); es_test_frames(h, 1); }
// The fixture world with a point tapped on the ground.
es_test_here :: (h: [] EsTest) {
  s := h[0].s[..]; out := h[0].text[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true;
  n := em_begin(out, "splice", 0, 6, 0, 0, 0);
  n = em_cols(out, n, cols[..]);
  n = em_kind(out, n, 1001, "Cargo crate");
  n = em_kind(out, n, 1002, "Parked rover");
  n = em_here(out, n, 420, -75);
  for i: 0..<n { s[0].inbox[i] = out[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, n);
}

#test "the viewport's strip: a tool and a grid are picked from selects, and fly, pause, step and simulate are buttons that say what they will do next; each tells the page in words" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; w: [32] u8;
  es_test_model(h[..], 0, 7, 3, "");
  es_test_frames(h[..], 1);
  #assert tr_text_of(t, tr_find(t, "tool.l")) == "Play" && tr_text_of(t, tr_find(t, "grid.l")) == "50 cm" && tr_find(t, "tool.2") < 0;
  es_test_press(h[..], "tool");
  #assert s[0].open == ES_OPEN_TOOL && tr_text_of(t, tr_find(t, "tool.2.t")) == "Move" && tr_text_of(t, tr_find(t, "tool.2.m")) == "Drag the selected thing along the ground" && tr_has(t, tr_find(t, "tool.0"), AT_CURRENT);
  es_test_press(h[..], "tool.2");
  #assert es_test_view(h[..], w[..]) == "tool move" && s[0].open == ES_OPEN_NONE && tr_text_of(t, tr_find(t, "tool.l")) == "Move";
  es_test_press(h[..], "tool"); es_test_press(h[..], "tool.4");
  #assert es_test_view(h[..], w[..]) == "tool size";
  es_test_press(h[..], "grid");
  #assert s[0].open == ES_OPEN_GRID && tr_has(t, tr_find(t, "grid.2"), AT_CURRENT);
  es_test_press(h[..], "grid.0");
  #assert es_test_view(h[..], w[..]) == "grid 10" && tr_text_of(t, tr_find(t, "grid.l")) == "10 cm";
  es_test_press(h[..], "grid"); es_test_press(h[..], "grid.3");
  #assert es_test_view(h[..], w[..]) == "grid 100" && tr_text_of(t, tr_find(t, "grid.l")) == "1 m";
  #assert tr_text_of(t, tr_find(t, "fly.l")) == "Fly";
  es_test_press(h[..], "fly");
  #assert es_test_view(h[..], w[..]) == "fly on" && tr_text_of(t, tr_find(t, "fly.l")) == "Stop flying";
  es_test_press(h[..], "fly");
  #assert es_test_view(h[..], w[..]) == "fly off" && tr_text_of(t, tr_find(t, "fly.l")) == "Fly";
  es_test_press(h[..], "run");
  #assert es_test_view(h[..], w[..]) == "run pause" && tr_text_of(t, tr_find(t, "run.l")) == "Play";
  es_test_press(h[..], "run");
  #assert es_test_view(h[..], w[..]) == "run play" && tr_text_of(t, tr_find(t, "run.l")) == "Pause";
  // a step pauses: the button then offers Play
  es_test_press(h[..], "step");
  #assert es_test_view(h[..], w[..]) == "step" && s[0].paused && tr_text_of(t, tr_find(t, "run.l")) == "Play";
  es_test_press(h[..], "sim");
  #assert es_test_view(h[..], w[..]) == "sim on" && tr_text_of(t, tr_find(t, "sim.l")) == "Stop simulating";
  es_test_press(h[..], "sim");
  #assert es_test_view(h[..], w[..]) == "sim off" && s[0].nacts == 0;
  // one select is open at a time
  es_test_press(h[..], "tool"); es_test_press(h[..], "grid");
  #assert s[0].open == ES_OPEN_GRID && tr_find(t, "tool.0") < 0 && tr_find(t, "grid.0") > 0;
  es_test_press(h[..], "grid");
  #assert s[0].open == ES_OPEN_NONE;
}

#test "Add is there once a point was tapped: the kind picked is one spawn edit at that point" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  es_test_model(h[..], 0, 7, 3, "");
  es_test_frames(h[..], 1);
  #assert tr_find(t, "add") < 0;
  es_test_here(h[..]);
  es_test_frames(h[..], 1);
  #assert tr_find(t, "add") > 0 && tr_find(t, "add.1002") < 0;
  es_test_press(h[..], "add");
  #assert s[0].open == ES_OPEN_ADD && tr_text_of(t, tr_find(t, "add.1002.t")) == "Parked rover";
  es_test_press(h[..], "add.1002");
  #assert es_test_batch(h[..], 6) == WB_APPLY && s[0].open == ES_OPEN_NONE;
  e := h[0].edits[0];
  #assert e.op == WE_SPAWN && e.id == 0 && e.kind == 1002 && e.x == 420 && e.z == -75 && e.yaw == 0 && e.scale == 100;
}

#test "Agent opens a foot with a slot for the chat's conversation; Hide agent puts the foot away and keeps the slot" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  es_test_model(h[..], 0, 7, 3, "");
  es_test_frames(h[..], 1);
  #assert tr_find(t, "agent.pane") < 0 && tr_text_of(t, tr_find(t, "agent.l")) == "Agent";
  es_test_press(h[..], "agent");
  #assert tr_class(t, tr_find(t, "agent.pane")) == "pane pane-bm" && !tr_has(t, tr_find(t, "agent.pane"), AT_HIDDEN) && tr_class(t, tr_find(t, "agent.slot")) == "slot" && tr_text_of(t, tr_find(t, "agent.l")) == "Hide agent";
  slot := dm_find(s[0].dom[..], "agent.slot");
  es_test_press(h[..], "agent");
  #assert tr_has(t, tr_find(t, "agent.pane"), AT_HIDDEN) && dm_find(s[0].dom[..], "agent.slot") == slot && s[0].nacts == 1 && coaxial_editor_act_kind(s) == ES_TURN;   // the page is asked nothing; the conversation was told the world
  es_test_press(h[..], "agent");
  #assert !tr_has(t, tr_find(t, "agent.pane"), AT_HIDDEN) && dm_find(s[0].dom[..], "agent.slot") == slot;
  // a page opened for the agent has the foot open from the start
  k: [1] EsTest; ks := k[0].s[..];
  es_test_model(k[..], 0, 7, 3, "");
  coaxial_editor_event(ks, ES_AGENT, 0, 0);
  es_test_frames(k[..], 1);
  #assert tr_find(ks[0].tree[..], "agent.slot") > 0 && !tr_has(ks[0].tree[..], tr_find(ks[0].tree[..], "agent.pane"), AT_HIDDEN);
}

// The fixture world whose kinds' cells may be edited: the table is named.
es_test_table :: (h: [] EsTest, rev: int) {
  s := h[0].s[..]; out := h[0].text[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true;
  n := em_begin(out, "splice", 0, rev, 0, 0, 2);
  n = em_cols(out, n, cols[..]);
  n = em_table(out, n, "pieces");
  n = em_kind(out, n, 1001, "Cargo crate");
  n = em_kind(out, n, 1002, "Parked rover");
  n = em_entity(out, n, 1, 1001, 350, 0, -1200, 90, 100);
  n = em_entity(out, n, 2, 1002, -40, 12, 600, -179, 100);
  n = em_cell(out, n, 1001, "name", "Cargo crate");
  n = em_cell(out, n, 1002, "name", "Parked rover");
  n = em_cell(out, n, 1002, "scale", "1500");
  for i: 0..<n { s[0].inbox[i] = out[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, n);
}

#test "a table whose cells may be edited shows the selected kind's cells as filled fields: a changed one is a cell edit that names the table, the row and the column; the same words ask nothing and an empty cell is said" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  es_test_table(h[..], 5);
  n := coaxial_editor_frame(s, 0.016, true);
  // the selected thing is a Parked rover: its two cells are fields, the other kind's is not shown
  #assert tr_find(t, "cell.1") > 0 && tr_find(t, "cell.2") > 0 && tr_find(t, "cell.0") < 0 && tr_find(t, "fact.1") < 0 && tr_text_of(t, tr_find(t, "cell.2.n")) == "scale";
  #assert dm_test_count(d, n, DC_VALUE) == 3;   // its one column and its two cells
  c2 := s[0].cell[2];
  #assert cast(string) c2[0..<s[0].cell_n[2]] == "1500";
  es_test_type(h[..], "cell.2", " 1800 ");
  #assert es_test_batch(h[..], 5) == WB_APPLY;
  e := h[0].edits[0]; tb := e.table; nm := e.name; tx := e.text;
  #assert e.op == WE_CELL && e.id == 1002 && cast(string) tb[0..<e.table_n] == "pieces" && cast(string) nm[0..<e.name_n] == "scale" && cast(string) tx[0..<e.text_n] == "1800" && we_valid(e);
  coaxial_editor_act_done(s);
  es_test_type(h[..], "cell.1", "Parked rover");
  #assert s[0].nacts == 0 && s[0].said_n == 0;
  es_test_type(h[..], "cell.1", "   ");
  es_test_frames(h[..], 1);
  #assert s[0].nacts == 0 && tr_text_of(t, tr_find(t, "said.t")) == "A cell takes one line of words or a number, and may not be empty.";
  es_test_type(h[..], "cell.1", "Long-range rover");
  #assert es_test_batch(h[..], 5) == WB_APPLY && h[0].edits[0].id == 1002 && s[0].said_n == 0;
  // without a table the cells are facts, as before
  k: [1] EsTest;
  es_test_model(k[..], 2, 7, 3, "");
  es_test_frames(k[..], 1);
  #assert tr_find(k[0].s[0].tree[..], "fact.0") > 0 && tr_find(k[0].s[0].tree[..], "cell.0") < 0;
}

// The fixture world of a realm that keeps templates: three things, one template, a point tapped.
es_test_templates :: (h: [] EsTest, rev: int, things: int) {
  s := h[0].s[..]; out := h[0].text[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true;
  n := em_begin(out, "splice", 0, rev, 0, 0, 0);
  n = em_cols(out, n, cols[..]);
  n = em_templates(out, n, "templates");
  n = em_kind(out, n, 1001, "Cargo crate");
  n = em_kind(out, n, 1002, "Parked rover");
  if things > 0 { n = em_entity(out, n, 1, 1001, 1000, 0, 2000, 0, 100); }
  if things > 1 { n = em_entity(out, n, 2, 1002, 1300, 0, 2000, 90, 100); }
  if things > 2 { n = em_entity(out, n, 5, 1002, 1000, 0, 2300, -45, 100); }
  n = em_template(out, n, 3, "Crate by a rover", "1001 -150 0 0 100,1002 150 0 90 100");
  n = em_here(out, n, 420, -75);
  for i: 0..<n { s[0].inbox[i] = out[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, n);
}

#test "things are gathered into a group from their rows and saved as a template: one whole-row cell edit, its parts from the group's middle; a thing that leaves the world leaves the group" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  es_test_templates(h[..], 9, 3);
  es_test_frames(h[..], 1);
  #assert tr_find(t, "thing.1.x") > 0 && tr_find(t, "group") < 0 && tr_class(t, tr_find(t, "thing.1.w")) == "row-x";
  es_test_press(h[..], "thing.1.x");
  #assert s[0].ngroup == 1 && tr_text_of(t, tr_find(t, "group.n")) == "1 thing" && tr_has(t, tr_find(t, "tsave"), AT_DISABLED) && tr_has(t, tr_find(t, "thing.1.x"), AT_PRESSED) && s[0].nacts == 0;
  es_test_press(h[..], "thing.2.x"); es_test_press(h[..], "thing.5.x");
  #assert s[0].ngroup == 3 && tr_text_of(t, tr_find(t, "group.n")) == "3 things" && tr_has(t, tr_find(t, "tsave"), AT_DISABLED);
  // a row's control lets its thing go again
  es_test_press(h[..], "thing.5.x");
  #assert s[0].ngroup == 2 && !tr_has(t, tr_find(t, "thing.5.x"), AT_PRESSED);
  es_test_press(h[..], "thing.5.x");
  // a name, then Save: the row is the next free ID, the name and the parts
  name := "Rover camp";
  for i: 0..<name.count { s[0].inbox[i] = name[i]; }
  coaxial_editor_event(s, ES_INPUT, dm_find(s[0].dom[..], "tname"), name.count);
  es_test_frames(h[..], 1);
  #assert !tr_has(t, tr_find(t, "tsave"), AT_DISABLED);
  es_test_press(h[..], "tsave");
  #assert es_test_batch(h[..], 9) == WB_APPLY;
  e := h[0].edits[0]; tb := e.table; nm := e.name; tx := e.text;
  #assert e.op == WE_CELL && e.id == 4 && cast(string) tb[0..<e.table_n] == "templates" && cast(string) nm[0..<e.name_n] == "*" && we_valid(e);
  #assert cast(string) tx[0..<e.text_n] == "4|Rover camp|1001 -100 -100 0 100,1002 200 -100 90 100,1002 -100 200 -45 100";
  #assert s[0].ngroup == 0 && s[0].tname_n == 0 && tr_find(t, "group") < 0;
  coaxial_editor_act_done(s);
  // a name with the bar sign is said, and nothing is sent
  es_test_press(h[..], "thing.1.x"); es_test_press(h[..], "thing.2.x");
  bad := "a|b";
  for i: 0..<bad.count { s[0].inbox[i] = bad[i]; }
  coaxial_editor_event(s, ES_INPUT, dm_find(s[0].dom[..], "tname"), bad.count);
  coaxial_editor_event(s, ES_SUBMIT, dm_find(s[0].dom[..], "tname"), 0);
  #assert s[0].nacts == 0 && s[0].said_n > 0 && s[0].ngroup == 2;
  // thing 2 is removed elsewhere: the group holds one, and Clear empties it
  es_test_templates(h[..], 10, 1);
  es_test_frames(h[..], 1);
  #assert s[0].ngroup == 1 && tr_text_of(t, tr_find(t, "group.n")) == "1 thing";
  es_test_press(h[..], "tclear");
  #assert s[0].ngroup == 0 && tr_find(t, "group") < 0;
  // a realm that keeps no templates has plain rows
  k: [1] EsTest;
  es_test_model(k[..], 0, 7, 3, "");
  es_test_frames(k[..], 1);
  #assert tr_find(k[0].s[0].tree[..], "thing.1.x") < 0 && tr_find(k[0].s[0].tree[..], "thing.1") > 0;
}

#test "Add lists the templates after the kinds: a template is placed at the point tapped as one batch of spawns; several of a kind are the page's to plan" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; w: [32] u8;
  es_test_templates(h[..], 9, 3);
  es_test_frames(h[..], 1);
  es_test_press(h[..], "add");
  #assert tr_text_of(t, tr_find(t, "addt.3.t")) == "Crate by a rover" && tr_text_of(t, tr_find(t, "addt.3.m")) == "Template" && tr_find(t, "add.1001") > 0;
  es_test_press(h[..], "addt.3");
  #assert es_test_batch(h[..], 9) == WB_APPLY && s[0].nacts == 1;
  a := s[0].acts[0];
  b := we_batch_read(cast(string) a[0..<coaxial_editor_act_len(s)], h[0].edits[..]);
  #assert b.ok && b.n == 2 && h[0].edits[0].op == WE_SPAWN && h[0].edits[0].kind == 1001 && h[0].edits[0].x == 270 && h[0].edits[0].z == -75 && h[0].edits[0].id == 0;
  #assert h[0].edits[1].kind == 1002 && h[0].edits[1].x == 570 && h[0].edits[1].yaw == 90 && h[0].edits[1].scale == 100;
  coaxial_editor_act_done(s);
  // one of a kind is a spawn where you tapped; several are asked of the page in words
  #assert tr_text_of(t, tr_find(t, "count.l")) == "One";
  es_test_press(h[..], "count");
  #assert s[0].open == ES_OPEN_COUNT && tr_text_of(t, tr_find(t, "count.2.t")) == "5 spread out";
  es_test_press(h[..], "count.2");
  #assert s[0].count == 2 && tr_text_of(t, tr_find(t, "count.l")) == "5 spread out";
  es_test_press(h[..], "add"); es_test_press(h[..], "add.1002");
  #assert coaxial_editor_act_kind(s) == ES_PLAN;
  p := s[0].acts[0];
  #assert cast(string) p[0..<coaxial_editor_act_len(s)] == "add 1002 5";
  coaxial_editor_act_done(s);
  es_test_press(h[..], "count"); es_test_press(h[..], "count.0");
  es_test_press(h[..], "add"); es_test_press(h[..], "add.1002");
  #assert es_test_batch(h[..], 9) == WB_APPLY && h[0].edits[0].op == WE_SPAWN && h[0].edits[0].kind == 1002 && h[0].edits[0].x == 420;
}

#test "the conversation in the foot is told the world once the foot was opened: the selection, the point tapped, the kinds and the things; again when the world changes" {
  h: [1] EsTest; s := h[0].s[..]; turn: [1] WorldTurn; scratch: [WT_BYTES] u8;
  es_test_model(h[..], 2, 7, 0, "");
  es_test_frames(h[..], 1);
  #assert s[0].nacts == 0;   // no foot yet: nobody to tell
  es_test_press(h[..], "agent");
  #assert coaxial_editor_act_kind(s) == ES_TURN;
  a := s[0].acts[0];
  #assert cast(string) a[0..<coaxial_editor_act_len(s)] == "world.turn.v1 splice dev 7 2\nk 1001 Cargo crate\nk 1002 Parked rover\ne 1 1001 350 -1200 90\ne 2 1002 -40 600 -179\n";
  #assert wt_read(turn[..], cast(string) a[0..<coaxial_editor_act_len(s)], scratch[..]);
  coaxial_editor_act_done(s);
  es_test_model(h[..], 1, 8, 1, "");
  #assert coaxial_editor_act_kind(s) == ES_TURN;
  b := s[0].acts[0];
  #assert wt_read(turn[..], cast(string) b[0..<coaxial_editor_act_len(s)], scratch[..]) && turn[0].rev == 8 && turn[0].sel == 1;
  coaxial_editor_act_done(s);
  #assert s[0].nacts == 0;
}
es_test_plan :: (h: [] EsTest, plan: string) {
  s := h[0].s[..];
  for i: 0..<plan.count { s[0].inbox[i] = plan[i]; }
  coaxial_editor_event(s, ES_PLANNED, 0, plan.count);
}
#test "a hosted turn's plan becomes one batch of edits from the model's revision; a plan for another revision, or naming a thing that is gone, is said and not sent" {
  h: [1] EsTest; s := h[0].s[..];
  es_test_model(h[..], 2, 7, 0, "");
  es_test_plan(h[..], "world.plan.v1 splice 7\nplace 1001 420 -75 90\nmove 2 100 -200\nturn 1 -45\nsize 2 150\nremove 1\n");
  #assert es_test_batch(h[..], 7) == WB_APPLY;
  a := s[0].acts[0];
  b := we_batch_read(cast(string) a[0..<coaxial_editor_act_len(s)], h[0].edits[..]);
  #assert b.ok && b.n == 5 && h[0].edits[0].op == WE_SPAWN && h[0].edits[0].kind == 1001 && h[0].edits[0].x == 420 && h[0].edits[0].z == -75 && h[0].edits[0].yaw == 90;
  #assert h[0].edits[1].op == WE_MOVE && h[0].edits[1].id == 2 && h[0].edits[1].x == 100 && h[0].edits[1].y == 12 && h[0].edits[1].z == -200;
  #assert h[0].edits[2].op == WE_ROTATE && h[0].edits[2].yaw == -45 && h[0].edits[3].op == WE_SCALE && h[0].edits[3].scale == 150 && h[0].edits[4].op == WE_DESPAWN && h[0].edits[4].id == 1;
  coaxial_editor_act_done(s);
  es_test_plan(h[..], "world.plan.v1 splice 7\nundo\n");
  #assert es_test_batch(h[..], 7) == WB_UNDO;
  coaxial_editor_act_done(s);
  es_test_plan(h[..], "world.plan.v1 splice 6\nremove 1\n");
  #assert s[0].nacts == 0 && cast(string) s[0].said[0..<s[0].said_n] == "The world changed while the agent worked. Ask it again.";
  es_test_plan(h[..], "world.plan.v1 splice 7\nremove 9\n");
  #assert s[0].nacts == 0 && cast(string) s[0].said[0..<s[0].said_n] == "The agent named a thing that is no longer here. Ask it again.";
  es_test_plan(h[..], "not a plan");
  #assert s[0].nacts == 0 && cast(string) s[0].said[0..<s[0].said_n] == "The agent's change could not be read.";
}

// ---- code (E12, #13421)

// An answer from the dev server, as the host gives it: its pieces, then its end with the status.
es_test_answer :: (h: [] EsTest, status: int, body: string) {
  s := h[0].s[..];
  at := 0;
  while at < body.count {
    n := ifx body.count - at > 4096 then 4096 else body.count - at;
    for i: 0..<n { s[0].inbox[i] = body[at + i]; }
    coaxial_editor_event(s, ES_PIECE, status, n);
    at += n;
  }
  coaxial_editor_event(s, ES_END, status, 0);
}
// The host's word that the dev server serves this page, and the server's list of two files.
es_test_code :: (h: [] EsTest) {
  s := h[0].s[..];
  es_test_model(h[..], 0, 7, 3, "");
  for c, i: "splice" { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_CODE_HERE, 0, 6);
  coaxial_editor_asked(s);
  es_test_answer(h, 200, "realm.code.v1 files splice 3\nf metaverse/splice/gpu/splice.coax 900\nf metaverse/splice/splice-game.coax 300000\nf metaverse/splice/walk.coax 9\n");
}
es_test_ask :: (h: [] EsTest) -> string {
  s := h[0].s[..];
  n := coaxial_editor_asking(s);
  coaxial_editor_asked(s);
  return cast(string) s[0].code_req[0..<n];
}

#test "code is there only where the host says the dev server serves the page and the server lists the realm's files: a deployed page has no Code button and asks nothing" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  // a deployed page: the host never says so
  es_test_model(h[..], 0, 7, 3, "");
  es_test_frames(h[..], 2);
  #assert tr_find(t, "code") < 0 && tr_find(t, "code.pane") < 0 && coaxial_editor_asking(s) == 0 && s[0].nfiles == 0 && tr_find(t, "one") > 0;
  coaxial_editor_event(s, ES_CLICK, 0, 0);
  #assert !s[0].code && !es_code_click(s, "code") && !es_code_click(s, "code.save") && !es_code_click(s, "file.0") && coaxial_editor_asking(s) == 0;
  // a name that is not a page's asks nothing
  for c, i: "../etc" { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_CODE_HERE, 0, 6);
  #assert coaxial_editor_asking(s) == 0 && s[0].code_page_n == 0;
  // the dev server's page: the shell asks for the realm's files at the code route
  for c, i: "splice" { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_CODE_HERE, 0, 6);
  #assert cast(string) s[0].code_door[0..<s[0].code_door_n] == "/coaxial/code" && es_test_ask(h[..]) == "realm.code.v1 list splice\n" && coaxial_editor_asking(s) == 0;
  // a server with no such route (--static), or one that lists nothing: still no button
  es_test_answer(h[..], 405, "GET only\n");
  es_test_frames(h[..], 1);
  #assert s[0].nfiles == 0 && tr_find(t, "code") < 0 && s[0].code_flight == ES_FLY_NONE;
  h2: [1] EsTest; s2 := h2[0].s[..]; t2 := s2[0].tree[..];
  es_test_model(h2[..], 0, 7, 3, "");
  for c, i: "splice" { s2[0].inbox[i] = c; }
  coaxial_editor_event(s2, ES_CODE_HERE, 0, 6);
  es_test_answer(h2[..], 200, "realm.code.v1 files splice 0\n");
  es_test_frames(h2[..], 1);
  #assert s2[0].nfiles == 0 && tr_find(t2, "code") < 0;
  // another page's files are not this page's
  h3: [1] EsTest; s3 := h3[0].s[..];
  es_test_model(h3[..], 0, 7, 3, "");
  for c, i: "splice" { s3[0].inbox[i] = c; }
  coaxial_editor_event(s3, ES_CODE_HERE, 0, 6);
  es_test_answer(h3[..], 200, "realm.code.v1 files orbit 1\nf metaverse/orbit/orbit.coax 9\n");
  #assert s3[0].nfiles == 0;
}

#test "the Code pane lists the realm's files, opens one into a code field, and Save sends its text; saved, compile errors in the compiler's words, and a refusal are each said" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  es_test_code(h[..]);
  es_test_frames(h[..], 1);
  #assert s[0].nfiles == 3 && tr_text_of(t, tr_find(t, "code.l")) == "Code" && tr_find(t, "code.pane") < 0 && tr_find(t, "one") > 0;
  es_test_press(h[..], "code");
  #assert tr_text_of(t, tr_find(t, "code.l")) == "Hide code" && tr_class(t, tr_find(t, "code.pane")) == "pane pane-r pane-w" && tr_find(t, "one") < 0;
  #assert tr_text_of(t, tr_find(t, "file.l")) == "Pick a file" && tr_find(t, "code.none") > 0 && tr_find(t, "code.text") < 0 && tr_find(t, "code.save") < 0;
  es_test_press(h[..], "file");
  #assert s[0].open == ES_OPEN_FILE && tr_text_of(t, tr_find(t, "file.0.t")) == "gpu/splice.coax" && tr_text_of(t, tr_find(t, "file.2.t")) == "walk.coax" && tr_text_of(t, tr_find(t, "file.1.m")) == "Too long to open here";
  // a file longer than the editor opens is said, not asked for
  es_test_press(h[..], "file.1");
  #assert coaxial_editor_asking(s) == 0 && tr_text_of(t, tr_find(t, "code.said.t")) == "That file is longer than the editor opens (192 KB)." && s[0].open == ES_OPEN_NONE;
  es_test_press(h[..], "file");
  es_test_press(h[..], "file.2");
  #assert es_test_ask(h[..]) == "realm.code.v1 read splice metaverse/splice/walk.coax\n" && tr_text_of(t, tr_find(t, "code.state")) == "Opening" && tr_find(t, "code.none") < 0;
  es_test_answer(h[..], 200, "realm.code.v1 file metaverse/splice/walk.coax 9\nx :: 1;\n\n");
  n := coaxial_editor_frame(s, 0.016, true);
  // the field is made and filled in one flush, with the file's own bytes
  #assert s[0].code_at == 2 && n > 0 && dm_test_count(d, n, DC_VALUE) == 1 && !s[0].code_fill && cast(string) s[0].code_text[0..<s[0].code_n] == "x :: 1;\n\n";
  #assert tr_attr_of(t, tr_find(t, "code.text"), AT_LANG) == "coax" && tr_text_of(t, tr_find(t, "file.l")) == "walk.coax" && tr_has(t, tr_find(t, "code.save"), AT_DISABLED) && tr_find(t, "code.state") < 0 && tr_find(t, "code.said") < 0;
  // typing makes it savable; Save sends the file as typed
  typed := "x :: 2;\ny :: 3;\n";
  for c, i: typed { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_INPUT, dm_find(d, "code.text"), typed.count);
  coaxial_editor_event(s, ES_SUBMIT, dm_find(d, "code.text"), 0);
  n = coaxial_editor_frame(s, 0.016, true);
  #assert dm_test_count(d, n, DC_VALUE) == 0 && !tr_has(t, tr_find(t, "code.save"), AT_DISABLED) && tr_text_of(t, tr_find(t, "code.state")) == "Not saved" && coaxial_editor_asking(s) == 0 && s[0].nacts == 0;
  es_test_press(h[..], "code.save");
  #assert es_test_ask(h[..]) == "realm.code.v1 save splice metaverse/splice/walk.coax 16\nx :: 2;\ny :: 3;\n" && tr_text_of(t, tr_find(t, "code.state")) == "Saving" && tr_has(t, tr_find(t, "code.save"), AT_DISABLED);
  es_test_answer(h[..], 200, "realm.code.v1 saved metaverse/splice/walk.coax 0\n");
  es_test_frames(h[..], 1);
  #assert tr_text_of(t, tr_find(t, "code.said.k")) == "Saved" && tr_text_of(t, tr_find(t, "code.said.t")) == "The world reloads." && tr_find(t, "code.errors") < 0 && tr_find(t, "code.state") < 0 && tr_has(t, tr_find(t, "code.save"), AT_DISABLED);
  // a save the compiler refuses: its words, in a code block, and the file is saved all the same
  for c, i: "x :: ;\n" { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_INPUT, dm_find(d, "code.text"), 7);
  es_test_frames(h[..], 1);
  #assert tr_find(t, "code.said") < 0;
  es_test_press(h[..], "code.save");
  #assert es_test_ask(h[..]) == "realm.code.v1 save splice metaverse/splice/walk.coax 7\nx :: ;\n";
  es_test_answer(h[..], 200, "realm.code.v1 errors metaverse/splice/walk.coax 44\nmetaverse/splice/walk.coax:1:6: error[E0101]");
  es_test_frames(h[..], 1);
  #assert tr_text_of(t, tr_find(t, "code.said.k")) == "Compile errors" && tr_text_of(t, tr_find(t, "code.said.t")) == "The file is saved. The last good build keeps running.";
  #assert tr_text_of(t, tr_find(t, "code.errors.pre")) == "metaverse/splice/walk.coax:1:6: error[E0101]" && tr_find(t, "code.state") < 0;
  // Copy puts the compiler's words by for the clipboard
  es_test_press(h[..], "code.errors.copy");
  #assert coaxial_editor_clip_len(s) == 44 && cast(string) s[0].clip[0..<44] == "metaverse/splice/walk.coax:1:6: error[E0101]";
  coaxial_editor_clip_done(s);
  #assert coaxial_editor_clip_len(s) == 0;
  // the words stay while the file is mended, and go with the next save
  for c, i: "x :: 4;\n" { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_INPUT, dm_find(d, "code.text"), 8);
  es_test_frames(h[..], 1);
  #assert tr_find(t, "code.errors") > 0;
  es_test_press(h[..], "code.save");
  #assert tr_find(t, "code.errors") < 0 && es_test_ask(h[..]).count > 0;
  // no answer: it is still not saved, and said
  es_test_answer(h[..], 0, "");
  es_test_frames(h[..], 1);
  #assert tr_text_of(t, tr_find(t, "code.said.t")) == "That did not save: the dev server did not answer." && !tr_has(t, tr_find(t, "code.save"), AT_DISABLED);
  es_test_press(h[..], "code.save");
  es_test_answer(h[..], 404, "realm.code.v1 refused 0 That file is not one of this realm's.\n");
  es_test_frames(h[..], 1);
  #assert tr_text_of(t, tr_find(t, "code.said.k")) == "Not done" && tr_text_of(t, tr_find(t, "code.said.t")) == "That file is not one of this realm's.";
  // Hide code puts the pane away and brings the selected thing's back; opened again the field is filled again
  es_test_press(h[..], "code");
  #assert tr_find(t, "code.pane") < 0 && tr_find(t, "one") > 0;
  coaxial_editor_event(s, ES_CLICK, dm_find(d, "code"), 0);
  n = coaxial_editor_frame(s, 0.016, true);
  #assert tr_find(t, "code.text") > 0 && dm_test_count(d, n, DC_VALUE) == 1 && cast(string) s[0].code_text[0..<s[0].code_n] == "x :: 4;\n";
}

#test "a file with changes is not left by one press; what is typed past the editor's size is not saved; every class in the pane is the skin's" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; d := s[0].dom[..];
  css: [ES_CSS] u8;
  sheet := cast(string) css[0..<mono_dock_css(css[..], mono_css(css[..]))];
  es_test_code(h[..]);
  es_test_frames(h[..], 1);
  es_test_press(h[..], "code");
  es_test_press(h[..], "file");
  es_test_press(h[..], "file.2");
  _ := es_test_ask(h[..]);
  es_test_answer(h[..], 200, "realm.code.v1 file metaverse/splice/walk.coax 9\nx :: 1;\n\n");
  es_test_frames(h[..], 1);
  for c, i: "y" { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_INPUT, dm_find(d, "code.text"), 1);
  es_test_press(h[..], "file");
  es_test_press(h[..], "file.0");
  #assert coaxial_editor_asking(s) == 0 && s[0].code_at == 2 && tr_text_of(t, tr_find(t, "code.said.t")) == "This file has changes that are not saved. Save it, or pick the other file again to drop them.";
  es_test_press(h[..], "file");
  es_test_press(h[..], "file.0");
  #assert es_test_ask(h[..]) == "realm.code.v1 read splice metaverse/splice/gpu/splice.coax\n";
  es_test_answer(h[..], 200, "realm.code.v1 file metaverse/splice/gpu/splice.coax 3\nabc");
  n := coaxial_editor_frame(s, 0.016, true);
  #assert s[0].code_at == 0 && dm_test_count(d, n, DC_VALUE) == 1 && !es_code_changed(s) && tr_find(t, "code.said") < 0;
  // more than a file the editor saves
  coaxial_editor_event(s, ES_INPUT, dm_find(d, "code.text"), RC_TEXT + 1);
  es_test_frames(h[..], 1);
  #assert s[0].code_long && s[0].code_n == 3 && tr_has(t, tr_find(t, "code.save"), AT_DISABLED) && tr_text_of(t, tr_find(t, "code.said.t")) == "This file is longer than the editor saves (192 KB).";
  es_test_press(h[..], "code.save");
  #assert coaxial_editor_asking(s) == 0;
  // an answer for another file than the one asked for opens nothing
  for c, i: "ab" { s[0].inbox[i] = c; }
  coaxial_editor_event(s, ES_INPUT, dm_find(d, "code.text"), 2);
  es_test_press(h[..], "code.save");
  _ = es_test_ask(h[..]);
  es_test_answer(h[..], 200, "realm.code.v1 errors metaverse/splice/gpu/splice.coax 5\nE0302");
  es_test_press(h[..], "file");
  seen := 0;
  for i: 0..<t[0].n {
    cls := tr_class(t, i);
    for k: 0..<ct_parts(cls, ' ') {
      word := ct_part(cls, ' ', k);
      if word.count == 0 { continue; }
      bare := ES_TEST_BARE;
      #assert es_test_styled(sheet, word) || word == bare[0] || word == bare[1];
      seen += 1;
    }
  }
  #assert seen > 60 && es_test_styled(sheet, "pane-w") && es_test_styled(sheet, "code-in") && tr_find(t, "code.errors") > 0 && tr_find(t, "file.0") > 0;
}

// A world kept on this device, whose land takes brushes: WorldBuilder's (E13, #13422).
es_test_local :: (h: [] EsTest, listed: int, in_all: int) {
  s := h[0].s[..]; out := h[0].text[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true; cols[WEC_Z] = true; cols[WEC_YAW] = true;
  n := em_begin(out, "create-world", 0, 9, 2, 0, 0);
  n = em_cols(out, n, cols[..]);
  n = em_kind(out, n, 3, "nature/rock-1");
  for k: 0..<listed { n = em_entity(out, n, k + 1, 3, k * 100, 0, 0, 0, 100); }
  n = em_all(out, n, in_all, 4096);
  n = em_kinds_all(out, n, 788);
  n = em_local(out, n);
  n = em_land(out, n, 100, 4000);
  n = em_mat(out, n, 1, "Grass"); n = em_mat(out, n, 3, "Sand"); n = em_mat(out, n, 0, "Grid");
  n = em_here(out, n, 100, 200);
  for i: 0..<n { s[0].inbox[i] = out[i]; }
  coaxial_editor_event(s, ES_MODEL, 0, n);
}
#test "a world kept on this device has no Publish; it says how many things it holds, how many are listed and how many it takes" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..];
  es_test_local(h[..], 2, 2);
  es_test_frames(h[..], 1);
  #assert tr_find(t, "publish") < 0 && tr_find(t, "when") < 0 && tr_find(t, "undo") > 0 && tr_find(t, "redo") > 0;
  #assert tr_text_of(t, tr_find(t, "things.all")) == "2 things. This world holds 4096 at most.";
  es_test_local(h[..], 2, 1203);
  es_test_frames(h[..], 1);
  #assert tr_text_of(t, tr_find(t, "things.all")) == "2 of 1203 things listed, the newest. This world holds 4096 at most.";
  // Add says how many of the world's kinds it lists, when not all
  es_test_press(h[..], "add");
  #assert tr_text_of(t, tr_find(t, "add.more")) == "1 of 788 kinds are listed here." && tr_find(t, "add.3") > 0;
  es_test_press(h[..], "add");
  // a world that has a live lane keeps Publish, and one that does not count says nothing of it
  es_test_model(h[..], 0, 7, 3, "");
  es_test_frames(h[..], 1);
  #assert tr_find(t, "publish") > 0 && tr_find(t, "when") > 0 && tr_find(t, "things.all") < 0;
  es_test_here(h[..]);
  es_test_frames(h[..], 1);
  es_test_press(h[..], "add");
  #assert tr_find(t, "add.1001") > 0 && tr_find(t, "add.more") < 0;
}
#test "the land's brush is a tool only where the world's land takes edits: its kind, material, radius and strength are told to the page in words, and every class it shows is the skin's" {
  h: [1] EsTest; s := h[0].s[..]; t := s[0].tree[..]; w: [32] u8;
  // Splice's land takes none: no Land among the tools
  es_test_model(h[..], 0, 7, 3, "");
  es_test_frames(h[..], 1);
  es_test_press(h[..], "tool");
  #assert tr_find(t, "tool.4") > 0 && tr_find(t, "tool.5") < 0;
  es_test_press(h[..], "tool");
  es_test_local(h[..], 1, 1);
  es_test_frames(h[..], 1);
  #assert tr_find(t, "brush") < 0 && tr_find(t, "radius") < 0 && tr_find(t, "grid") > 0;
  es_test_press(h[..], "tool");
  #assert tr_text_of(t, tr_find(t, "tool.5.t")) == "Land" && tr_text_of(t, tr_find(t, "tool.5.m")) == "Drag on the ground to shape or paint it";
  es_test_press(h[..], "tool.5");
  // picking it tells the page the tool and the brush as it is shown
  #assert es_test_view(h[..], w[..]) == "tool land" && es_test_view(h[..], w[..]) == "brush raise" && es_test_view(h[..], w[..]) == "radius 800" && es_test_view(h[..], w[..]) == "strength 60" && s[0].nacts == 0;
  #assert tr_text_of(t, tr_find(t, "tool.l")) == "Land" && tr_text_of(t, tr_find(t, "brush.l")) == "Raise" && tr_text_of(t, tr_find(t, "radius")) == "8 m" && tr_text_of(t, tr_find(t, "strength")) == "60%";
  #assert tr_find(t, "mat") < 0 && tr_find(t, "grid") < 0;
  // paint shows what it paints, the world's materials by name
  es_test_press(h[..], "brush");
  #assert tr_text_of(t, tr_find(t, "brush.4.m")) == "Level the ground to the height at the brush's middle";
  es_test_press(h[..], "brush.0");
  #assert es_test_view(h[..], w[..]) == "brush paint" && es_test_view(h[..], w[..]) == "mat 1" && tr_text_of(t, tr_find(t, "mat.l")) == "Grass";
  es_test_press(h[..], "mat"); es_test_press(h[..], "mat.1");
  #assert es_test_view(h[..], w[..]) == "mat 3" && tr_text_of(t, tr_find(t, "mat.l")) == "Sand";
  // the steppers: a step each press, held to what the land takes and to 10 to 100 percent
  es_test_press(h[..], "radius.more");
  #assert es_test_view(h[..], w[..]) == "radius 1200" && tr_text_of(t, tr_find(t, "radius")) == "12 m";
  for k: 0..<8 { es_test_press(h[..], "radius.more"); _ := es_test_view(h[..], w[..]); }
  #assert s[0].radius == ES_RADII - 1 && tr_text_of(t, tr_find(t, "radius")) == "40 m" && tr_has(t, tr_find(t, "radius.more"), AT_DISABLED);
  es_test_press(h[..], "strength.less");
  #assert es_test_view(h[..], w[..]) == "strength 50" && tr_text_of(t, tr_find(t, "strength")) == "50%";
  for k: 0..<8 { es_test_press(h[..], "strength.less"); _ := es_test_view(h[..], w[..]); }
  #assert s[0].strength == 0 && tr_text_of(t, tr_find(t, "strength")) == "10%" && tr_has(t, tr_find(t, "strength.less"), AT_DISABLED) && s[0].nacts == 0;
  // every class shown with the brush out is one the skin has a rule for
  css: [ES_CSS] u8;
  sheet := cast(string) css[0..<mono_dock_css(css[..], mono_css(css[..]))];
  for i: 0..<t[0].n {
    cls := tr_class(t, i);
    for k: 0..<ct_parts(cls, ' ') {
      word := ct_part(cls, ' ', k);
      bare := ES_TEST_BARE;
      #assert word.count == 0 || es_test_styled(sheet, word) || word == bare[0] || word == bare[1];
    }
  }
  #assert es_test_styled(sheet, "step");
  // another tool puts the brush away and brings the grid back
  es_test_press(h[..], "tool"); es_test_press(h[..], "tool.1");
  #assert es_test_view(h[..], w[..]) == "tool select" && tr_find(t, "brush") < 0 && tr_find(t, "grid") > 0;
}
#load "shell-assets-checks.coax" #test;   // the Assets pane (#13420)
#load "shell-files-checks.coax" #test;    // the Files pane (#13468)
#load "shell-actors-checks.coax" #test;   // the actors (#13466)
#load "shell-scripts-checks.coax" #test;  // the Scripts pane (#13467)
#load "shell-lists-checks.coax" #test;    // lists of switches (#13478)
#load "shell-revs-checks.coax" #test;     // the revisions (#13485)
