// `was` in `s` swapped for `with`, into out (the first place it stands; s itself when it does not).
sc_edit_swap :: (s: string, was: string, with: string, out: [] u8) -> string {
  for i: 0..<s.count - was.count + 1 {
    if s[i..<i + was.count] != was { continue; }
    n := 0;
    for k: 0..<i { out[n] = s[k]; n += 1; }
    for k: 0..<with.count { out[n] = with[k]; n += 1; }
    for k: i + was.count..<s.count { out[n] = s[k]; n += 1; }
    return cast(string) out[0..<n];
  }
  return s;
}
