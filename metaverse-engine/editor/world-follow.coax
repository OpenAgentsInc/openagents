// A page's place in a world with an ID (GitHub #13413, the browser editor's E4;
// docs/editor/2026-11-12-browser-editor.md "One live channel"): which lane it joined, the revision
// it stands at, and the one request at a time it has out. The page reads the lane's document once,
// then takes the lane's events in order, so an edit made in another tab, by an agent or from the
// CLI reaches it through the same edit log its own edits use.
//
// It asks for events once a second (the API's event stream, as a page follows a made realm). On
// the dev server `coax serve` also says when a world was written (the live channel's "world"
// message, inbox kind 614), and the page asks at once, so an outside edit shows in well under a
// second.
//
// This file decides what to ask and what an answer is; it sends nothing. The page's face hands the
// request to the host (coaxial_http: wf_wants, wf_url, wf_body, wf_flags, then wf_sent with the
// host's id) and the answer back (wf_answer). The realm carries a document and each event out on
// its own World and says so (wf_loaded, wf_took); anything out of order sends the page back to the
// document (wf_reopen).
//   coax/bin/coax test metaverse-engine/editor/world-follow.coax --library
#load "world-edit.coax";
#load "world-live.coax";

WF_POLL :: 1.0f32;        // seconds between asks for events on the dev lane, where people edit
WF_POLL_LIVE :: 5.0f32;   // and on the live lane, where a publish is the only event
WF_IDLE :: 30.0f32;       // seconds between looks at a world with nothing published
WF_RETRY :: 2.0f32;       // seconds before a request that got no answer is asked again
WF_URL :: 200;
WF_LATE :: 4;          // requests given up on whose answers the page still takes (the host has 8 at most)
WF_HTTP_POST :: 1; WF_HTTP_WANTED :: 4;   // coaxial_http's flags (coax/web/http-requests.js)
WFQ_NONE :: 0; WFQ_DOC :: 1; WFQ_EVENTS :: 2; WFQ_POST :: 3;
WFQ_TABLES :: 4;     // the lane's content tables (GET .../content), for a realm that reads the world's own (#13419)
WFS_OFF :: 0;        // no world is open
WFS_OPENING :: 1;    // the document is being read
WFS_FOLLOWING :: 2;  // the page stands at `rev` and takes events
WFS_NOTHING :: 3;    // nothing is published yet: the page shows the designed world
WFS_RELOAD :: 4;     // this build reads neither live revision: the page must be loaded again

WorldFollow :: struct {
  status: int; lane: int;
  rev: int = -1;              // the lane's revision the page stands at
  dev: int; live: int; undo: int; redo: int;   // what the last answer said of the world
  pins: WorldPins;
  id: [WE_WORLD] u8; id_n: int;
  want: int; flying: int; host_id: int = -1;
  late: [WF_LATE] int; late_id: [WF_LATE] int; late_n: int;   // requests given up on (what each asked, the host's id): their answers are still taken
  url: [WF_URL] u8; url_n: int;
  body_n: int;                // bytes of a batch waiting to be sent, or in flight. The page keeps the bytes (wf_post's
                              // store): a world's batch may be 65,536 bytes, and a realm's board never sends one that long
  since: f32; wait: f32;
  hold: f32;                  // seconds the document is not asked for again, after an answer that was none
  nudged: bool; refetch: bool;
  refused: [240] u8; refused_n: int; refused_edit: int = -1; refused_status: int;   // the last write's refusal, in words
  taken: int; reopened: int; sent: int;        // counters: events carried out, returns to the document, requests sent
  tables: bool;               // the realm reads the world's own content tables: each document read is followed by a read of them
  tabled: bool;               // they were read for the document the page stands at
}
wf_id :: (f: [] WorldFollow) -> string { return cast(string) f[0].id[0..<f[0].id_n]; }
// Open world `id` on a lane, for a build with these pins. False for what is no world or lane.
wf_open :: (f: [] WorldFollow, id: string, lane: int, pins: WorldPins) -> bool {
  if !we_world_ok(id) || (lane != WL_DEV && lane != WL_LIVE) { return false; }
  f[0] = WorldFollow.{status = WFS_OPENING, lane = lane, pins = pins, refetch = true};
  f[0].id_n = ct_copy(f[0].id[..], id);
  return true;
}
// Back to the document: an event was out of order, or could not be carried out.
wf_reopen :: (f: [] WorldFollow) { if f[0].status != WFS_OFF { f[0].refetch = true; f[0].reopened += 1; } }
// The dev server says world `id` was written.
wf_nudge :: (f: [] WorldFollow, id: string) { if f[0].status != WFS_OFF && id == wf_id(f) { f[0].nudged = true; } }
// A batch to send (the page's own edits, an undo, a publish), copied into `store`, which the page keeps for
// this follower and hands to wf_body: false when one is still waiting or it is longer than the store.
wf_post :: (f: [] WorldFollow, store: [] u8, body: string) -> bool {
  if f[0].status == WFS_OFF || f[0].body_n > 0 || body.count == 0 || body.count > store.count { return false; }
  for i: 0..<body.count { store[i] = body[i]; }
  f[0].body_n = body.count;
  f[0].refused_n = 0; f[0].refused_edit = -1; f[0].refused_status = 0;
  return true;
}
wf_put_url :: (f: [] WorldFollow, tail: string, after: int, pins: bool) {
  n := ct_put(f[0].url[..], 0, "/api/worlds/"); n = ct_put(f[0].url[..], n, wf_id(f)); n = ct_put(f[0].url[..], n, tail);
  if tail.count > 0 { n = ct_put(f[0].url[..], n, ifx f[0].lane == WL_DEV then "lane=dev" else "lane=live"); }
  if after >= 0 { n = ct_put(f[0].url[..], n, "&after="); n = ct_put_int(f[0].url[..], n, after); }
  if pins {
    p := f[0].pins;
    n = ct_put(f[0].url[..], n, "&engine="); n = ct_put_int(f[0].url[..], n, p.engine); n = ct_put(f[0].url[..], n, "&rules="); n = ct_put_int(f[0].url[..], n, p.rules);
    n = ct_put(f[0].url[..], n, "&content="); n = ct_put_int(f[0].url[..], n, p.content); n = ct_put(f[0].url[..], n, "&wire="); n = ct_put_int(f[0].url[..], n, p.wire);
  }
  f[0].url_n = ifx n > f[0].url.count then 0 else n;
}
// A frame's turn: decides the next request, when none is out. A waiting batch goes first, then
// the document when the page must (re)read it, then the events when they are due or were nudged.
wf_step :: (f: [] WorldFollow, dt: f32) {
  if f[0].status == WFS_OFF || f[0].status == WFS_RELOAD { return; }
  f[0].since += dt;
  if f[0].flying != WFQ_NONE {
    f[0].wait += dt;
    if f[0].wait < WF_RETRY * 5 { return; }
    // the answer hasn't come: ask again, and still take this one's if it comes first (a slow server, or a
    // page's clock that runs ahead of the network's: coax drive's agent clock, #13475)
    if f[0].late_n == WF_LATE {   // the oldest goes
      for k: 1..<WF_LATE { f[0].late[k - 1] = f[0].late[k]; f[0].late_id[k - 1] = f[0].late_id[k]; }
      f[0].late_n -= 1;
    }
    f[0].late[f[0].late_n] = f[0].flying; f[0].late_id[f[0].late_n] = f[0].host_id; f[0].late_n += 1;
    f[0].flying = WFQ_NONE; f[0].host_id = -1;
  }
  if f[0].want != WFQ_NONE { return; }
  if f[0].body_n > 0 && f[0].lane == WL_DEV { wf_put_url(f, "", -1, false); f[0].want = WFQ_POST; return; }
  if f[0].refetch {
    if f[0].since >= f[0].hold { wf_put_url(f, "?", -1, f[0].lane == WL_LIVE); f[0].want = WFQ_DOC; f[0].since = 0; f[0].hold = 0; }
    return;
  }
  // the document the page stands at was read: its tables next, before any event (an event may be a cell of them)
  if f[0].tables && !f[0].tabled && f[0].status == WFS_FOLLOWING { wf_put_url(f, "/content?", -1, false); f[0].want = WFQ_TABLES; return; }
  every := ifx f[0].status == WFS_NOTHING then WF_IDLE else (ifx f[0].lane == WL_DEV then WF_POLL else WF_POLL_LIVE);
  due := f[0].nudged || f[0].since >= every;
  if (f[0].status == WFS_FOLLOWING || f[0].status == WFS_NOTHING) && due {
    f[0].nudged = false; f[0].since = 0;
    if f[0].status == WFS_NOTHING { f[0].refetch = true; return; }
    wf_put_url(f, "/events?", f[0].rev, false); f[0].want = WFQ_EVENTS;
  }
}
// What the face sends now, if anything.
wf_wants :: (f: [] WorldFollow) -> bool { return f[0].want != WFQ_NONE && f[0].url_n > 0; }
wf_url :: (f: [] WorldFollow) -> string { return cast(string) f[0].url[0..<f[0].url_n]; }
wf_body :: (f: [] WorldFollow, store: [] u8) -> string { return ifx f[0].want == WFQ_POST && f[0].body_n <= store.count then cast(string) store[0..<f[0].body_n] else ""; }
wf_flags :: (f: [] WorldFollow) -> int { return ifx f[0].want == WFQ_POST then WF_HTTP_POST | WF_HTTP_WANTED else WF_HTTP_WANTED; }
// The face sent it: the host's id for the answer (below 0: the host could not take it now).
wf_sent :: (f: [] WorldFollow, host_id: int) {
  if f[0].want == WFQ_NONE { return; }
  if host_id >= 0 { f[0].flying = f[0].want; f[0].host_id = host_id; f[0].wait = 0; f[0].sent += 1; }
  f[0].want = WFQ_NONE;
}
// A new engine started on this state (a code reload on the dev server keeps the state, #13457): the
// host dropped every request the old engine had out, so the one out now gets no answer. It is
// asked again at once, not after WF_RETRY * 5 seconds; an events request is asked as nudged.
wf_engine_started :: (f: [] WorldFollow) {
  f[0].late_n = 0;
  if f[0].flying == WFQ_NONE { return; }
  if f[0].flying == WFQ_EVENTS { f[0].nudged = true; }
  f[0].flying = WFQ_NONE; f[0].host_id = -1; f[0].wait = 0;
}
// An answer from the host: what it answers (WFQ_NONE when it is not this follower's), its status
// and its body. The request is no longer out.
WfAnswer :: struct { what: int; status: int; body: string; }
wf_answer :: (f: [] WorldFollow, host_id: int, text: string) -> WfAnswer {
  a := WfAnswer.{};
  late := -1;
  for k: 0..<f[0].late_n { if f[0].late_id[k] == host_id { late = k; } }
  if f[0].flying != WFQ_NONE && host_id == f[0].host_id {
    a.what = f[0].flying;
  } else if late >= 0 && (f[0].flying == WFQ_NONE || f[0].flying == f[0].late[late]) {
    // a request given up on answered after all: it answers what its asking again asks, whose own answer is
    // then not taken; a POST asked again is the same batch
    a.what = f[0].late[late];
    if f[0].want == a.what { f[0].want = WFQ_NONE; }   // asked again but not sent yet: not wanted now
  } else {
    if late >= 0 {   // answered, and not taken: the host may give its id to another request now
      for k: late + 1..<f[0].late_n { f[0].late[k - 1] = f[0].late[k]; f[0].late_id[k - 1] = f[0].late_id[k]; }
      f[0].late_n -= 1;
    }
    return a;
  }
  f[0].flying = WFQ_NONE; f[0].host_id = -1; f[0].late_n = 0;
  at := 0;
  while at < text.count && text[at] >= '0' && text[at] <= '9' && at < 4 { a.status = a.status * 10 + cast(int) (text[at] - '0'); at += 1; }
  if at >= text.count || text[at] != '\n' { a.status = 0; return a; }
  a.body = text[at + 1..<text.count];
  return a;
}
// The page read the lane's document and stands at its revision. v: the state that carried it.
wf_loaded :: (f: [] WorldFollow, v: WorldState) {
  f[0].status = WFS_FOLLOWING; f[0].refetch = false; f[0].nudged = false; f[0].since = 0; f[0].tabled = false;
  f[0].rev = v.rev; f[0].dev = v.dev; f[0].live = v.live; f[0].undo = v.undo; f[0].redo = v.redo;
}
// The realm read the lane's tables (or the answer was none, and it keeps the ones it has).
wf_tabled :: (f: [] WorldFollow) { f[0].tabled = true; }
// The document could not be read: `status` is the route's. 404 on live: nothing is published
// yet. 409: this build reads neither live revision. Anything else is asked again.
wf_not_loaded :: (f: [] WorldFollow, status: int) {
  f[0].since = 0; f[0].hold = ifx status == 404 || status == 409 then 0 else WF_RETRY;
  if status == 404 { f[0].status = WFS_NOTHING; f[0].refetch = false; f[0].rev = -1; }
  if status == 409 { f[0].status = WFS_RELOAD; f[0].refetch = false; }
}
// The page carried the lane's next event out and stands one revision on.
wf_took :: (f: [] WorldFollow) { f[0].rev += 1; f[0].taken += 1; if f[0].lane == WL_DEV { f[0].dev = f[0].rev; } }
// A write was answered. 200: the batch as taken follows as events, asked for at once. Anything
// else: the words of the refusal are kept for the page to show.
wf_posted :: (f: [] WorldFollow, a: WfAnswer) {
  f[0].body_n = 0;
  if a.status == 200 { f[0].nudged = true; return; }
  r := we_refusal_read(a.body, f[0].refused[..]);
  f[0].refused_status = a.status; f[0].refused_n = ifx r.ok then r.words_n else 0; f[0].refused_edit = r.edit;
  if a.status == 409 { f[0].nudged = true; }   // stale: the events the page has not taken explain it
}
wf_refused :: (f: [] WorldFollow) -> string { return cast(string) f[0].refused[0..<f[0].refused_n]; }
// The k-th line of an events answer ("" past the last).
wf_line :: (body: string, k: int) -> string { return ct_part(body, '\n', k); }

#test "world follow: a page reads the document, then asks for events on its clock, and at once when nudged" {
  store: [2048] u8;   // the page's room for a batch on its way
  f := [1] WorldFollow.[WorldFollow.{}]; pins := WorldPins.{engine = 1, rules = 1, content = 2, wire = 1};
  wf_step(f[..], 1); #assert !wf_wants(f[..]) && f[0].status == WFS_OFF;
  #assert !wf_open(f[..], "Splice", WL_DEV, pins) && !wf_open(f[..], "splice", 2, pins) && wf_open(f[..], "splice", WL_DEV, pins);
  wf_step(f[..], 0.016);
  #assert wf_wants(f[..]) && wf_url(f[..]) == "/api/worlds/splice?lane=dev" && wf_flags(f[..]) == WF_HTTP_WANTED && wf_body(f[..], store[..]) == "";
  wf_sent(f[..], 3); #assert !wf_wants(f[..]) && f[0].flying == WFQ_DOC && f[0].sent == 1;
  wf_step(f[..], 0.5); #assert !wf_wants(f[..]);   // one request at a time
  #assert wf_answer(f[..], 4, "200\n{}").what == WFQ_NONE && f[0].flying == WFQ_DOC;   // another request's answer
  a := wf_answer(f[..], 3, "200\n{\"x\":1}");
  #assert a.what == WFQ_DOC && a.status == 200 && a.body == "{\"x\":1}" && f[0].flying == WFQ_NONE;
  wf_loaded(f[..], WorldState.{rev = 7, dev = 7, live = 2, undo = 3, redo = 1});
  #assert f[0].status == WFS_FOLLOWING && f[0].rev == 7 && f[0].undo == 3 && f[0].redo == 1;
  wf_step(f[..], 0.5); #assert !wf_wants(f[..]);
  wf_step(f[..], 0.6);
  #assert wf_wants(f[..]) && wf_url(f[..]) == "/api/worlds/splice/events?lane=dev&after=7";
  wf_sent(f[..], 0);
  a = wf_answer(f[..], 0, "200\nLINE1\nLINE2\n");
  #assert a.what == WFQ_EVENTS && wf_line(a.body, 0) == "LINE1" && wf_line(a.body, 1) == "LINE2" && wf_line(a.body, 2) == "";
  wf_took(f[..]); wf_took(f[..]); #assert f[0].rev == 9 && f[0].dev == 9 && f[0].taken == 2;
  // nudged: the next frame asks, well inside the second
  wf_step(f[..], 0.016); #assert !wf_wants(f[..]);
  wf_nudge(f[..], "other"); wf_step(f[..], 0.016); #assert !wf_wants(f[..]);
  wf_nudge(f[..], "splice"); wf_step(f[..], 0.016);
  #assert wf_wants(f[..]) && wf_url(f[..]) == "/api/worlds/splice/events?lane=dev&after=9";
  // the host could not take it: asked again at the next turn of the clock
  wf_sent(f[..], -1); #assert f[0].flying == WFQ_NONE && f[0].sent == 2;
  wf_step(f[..], 1.1); #assert wf_wants(f[..]);
  // an answer with no status line is no answer
  wf_sent(f[..], 2); a = wf_answer(f[..], 2, "garbage"); #assert a.what == WFQ_EVENTS && a.status == 0 && a.body == "";
}
#test "world follow: a request given up on is asked again, and its answer is still taken when it comes first (#13475)" {
  store: [2048] u8;   // the page's room for a batch on its way
  f := [1] WorldFollow.[WorldFollow.{}]; pins := WorldPins.{engine = 1, rules = 1, content = 2, wire = 1};
  #assert wf_open(f[..], "splice", WL_DEV, pins);
  wf_step(f[..], 0.016); wf_sent(f[..], 3);
  // ten seconds with no answer: the document is asked for again
  wf_step(f[..], WF_RETRY * 5); wf_step(f[..], 0.016);
  #assert wf_wants(f[..]) && wf_url(f[..]) == "/api/worlds/splice?lane=dev";
  wf_sent(f[..], 5); #assert f[0].flying == WFQ_DOC && f[0].sent == 2;
  // the first asking answers: taken as the document; the second's answer, after it, is not
  a := wf_answer(f[..], 3, "200\nDOC");
  #assert a.what == WFQ_DOC && a.status == 200 && a.body == "DOC" && f[0].flying == WFQ_NONE && f[0].late_n == 0;
  #assert wf_answer(f[..], 5, "200\nDOC").what == WFQ_NONE;
  // the second asking answers first: the first's answer, after it, is not taken
  #assert wf_open(f[..], "splice", WL_DEV, pins);
  wf_step(f[..], 0.016); wf_sent(f[..], 1);
  wf_step(f[..], WF_RETRY * 5); wf_step(f[..], 0.016); wf_sent(f[..], 2);
  #assert wf_answer(f[..], 2, "200\nDOC").what == WFQ_DOC && wf_answer(f[..], 1, "200\nDOC").what == WFQ_NONE;
  // the page went on to ask for something else (a batch goes first): a late answer to what it no longer asks is not taken
  #assert wf_open(f[..], "splice", WL_DEV, pins);
  f[0].refetch = false; f[0].status = WFS_FOLLOWING; f[0].since = WF_POLL;
  wf_step(f[..], 0.016); #assert f[0].want == WFQ_EVENTS; wf_sent(f[..], 1);
  #assert wf_post(f[..], store[..], "BATCH");
  wf_step(f[..], WF_RETRY * 5);
  #assert f[0].late_n == 1 && f[0].late[0] == WFQ_EVENTS && f[0].late_id[0] == 1 && f[0].want == WFQ_POST;
  wf_sent(f[..], 4);
  #assert wf_answer(f[..], 1, "200\n").what == WFQ_NONE && f[0].flying == WFQ_POST && f[0].late_n == 0;
  #assert wf_answer(f[..], 4, "200\n").what == WFQ_POST;
  // a new engine dropped every request: no late answer is waited for
  #assert wf_open(f[..], "splice", WL_DEV, pins);
  wf_step(f[..], 0.016); wf_sent(f[..], 6);
  wf_step(f[..], WF_RETRY * 5); #assert f[0].late_n == 1 && f[0].late_id[0] == 6;
  wf_engine_started(f[..]); #assert f[0].late_n == 0;
  // a server slower than two givings up: the first asking's answer is still taken, and the last four are kept
  #assert wf_open(f[..], "splice", WL_DEV, pins);
  for k: 0..<6 { wf_step(f[..], 0.016); #assert wf_wants(f[..]); wf_sent(f[..], k); wf_step(f[..], WF_RETRY * 5); }
  #assert f[0].late_n == WF_LATE && f[0].late_id[0] == 2 && f[0].late_id[3] == 5;
  #assert wf_answer(f[..], 1, "200\nDOC").what == WFQ_NONE && wf_answer(f[..], 2, "200\nDOC").what == WFQ_DOC;
  #assert f[0].late_n == 0 && !wf_wants(f[..]);
}
#test "world follow: out of order sends the page back to the document; a request that never answers is asked again" {
  f := [1] WorldFollow.[WorldFollow.{}]; pins := WorldPins.{engine = 1, rules = 1, content = 2, wire = 1};
  #assert wf_open(f[..], "splice", WL_LIVE, pins);
  wf_step(f[..], 0.016);
  #assert wf_url(f[..]) == "/api/worlds/splice?lane=live&engine=1&rules=1&content=2&wire=1";
  wf_sent(f[..], 1); a := wf_answer(f[..], 1, "404\n{\"error\":\"nothing is published yet\"}");
  wf_not_loaded(f[..], a.status); #assert f[0].status == WFS_NOTHING && f[0].rev == -1;
  // nothing published: the page looks again every half minute, not every second
  wf_step(f[..], 20); #assert !wf_wants(f[..]);
  wf_step(f[..], 10.1); wf_step(f[..], 0.016); #assert wf_wants(f[..]) && f[0].want == WFQ_DOC;
  wf_sent(f[..], 1); a = wf_answer(f[..], 1, "200\n{}"); wf_loaded(f[..], WorldState.{rev = 2, live = 2});
  #assert f[0].status == WFS_FOLLOWING && f[0].rev == 2;
  wf_took(f[..]); #assert f[0].rev == 3 && f[0].dev == 0;   // a live page's dev number is the answer's, not its own
  wf_reopen(f[..]); wf_step(f[..], 0.016);
  #assert wf_wants(f[..]) && f[0].want == WFQ_DOC && f[0].reopened == 1;
  // no answer for ten seconds: the request is given up and asked again
  wf_sent(f[..], 5);
  for i: 0..<9 { wf_step(f[..], 1); #assert !wf_wants(f[..]); }
  wf_step(f[..], 1.5); #assert wf_wants(f[..]) && f[0].flying == WFQ_NONE;
  // the old answer, should it come before the second asking goes out, is the document's (#13475)
  #assert wf_answer(f[..], 5, "200\n{}").what == WFQ_DOC && !wf_wants(f[..]);
  wf_reopen(f[..]); wf_step(f[..], 0.016); #assert wf_wants(f[..]) && f[0].want == WFQ_DOC;
  // a new engine on this state: the request the old one had out is asked again in the next frame
  wf_sent(f[..], 7); wf_step(f[..], 0.016); #assert !wf_wants(f[..]) && f[0].flying == WFQ_DOC;
  wf_engine_started(f[..]); #assert f[0].flying == WFQ_NONE && f[0].host_id == -1;
  wf_step(f[..], 0.016); #assert wf_wants(f[..]) && f[0].want == WFQ_DOC;
  #assert wf_answer(f[..], 7, "200\n{}").what == WFQ_NONE;
  wf_engine_started(f[..]); #assert f[0].want == WFQ_DOC;   // nothing out: nothing changes
  wf_sent(f[..], 8); a = wf_answer(f[..], 8, "200\n{}"); wf_loaded(f[..], WorldState.{rev = 3, live = 3});
  wf_step(f[..], WF_POLL_LIVE); wf_sent(f[..], 9); #assert f[0].flying == WFQ_EVENTS;
  wf_engine_started(f[..]); wf_step(f[..], 0.016);
  #assert wf_wants(f[..]) && f[0].want == WFQ_EVENTS && wf_url(f[..]) == "/api/worlds/splice/events?lane=live&after=3";
  // 409: the build reads neither revision; the page stops asking
  wf_sent(f[..], 6); a = wf_answer(f[..], 6, "409\n{}"); wf_not_loaded(f[..], a.status);
  #assert f[0].status == WFS_RELOAD;
  wf_step(f[..], 5); #assert !wf_wants(f[..]);
  // any other failure is asked again
  #assert wf_open(f[..], "splice", WL_DEV, pins);
  wf_step(f[..], 0.016); wf_sent(f[..], 1); a = wf_answer(f[..], 1, "0\n"); wf_not_loaded(f[..], a.status);
  #assert f[0].status == WFS_OPENING;
  wf_step(f[..], 0.016); #assert !wf_wants(f[..]);
  wf_step(f[..], WF_RETRY); #assert wf_wants(f[..]);
}
#test "world follow: a write goes first, one at a time; a refusal's words are kept; nothing is written on the live lane" {
  store: [2048] u8;   // the page's room for a batch on its way
  f := [1] WorldFollow.[WorldFollow.{}]; pins := WorldPins.{engine = 1, rules = 1, content = 2, wire = 1};
  #assert !wf_post(f[..], store[..], WE_UNDO_FIXTURE) && wf_open(f[..], "splice", WL_DEV, pins);
  wf_step(f[..], 0.016); wf_sent(f[..], 0); a := wf_answer(f[..], 0, "200\n{}"); wf_loaded(f[..], WorldState.{rev = 7, dev = 7});
  #assert !wf_post(f[..], store[0..<4], WE_UNDO_FIXTURE);   // longer than the page's room for it
  #assert wf_post(f[..], store[..], WE_UNDO_FIXTURE) && !wf_post(f[..], store[..], WE_UNDO_FIXTURE) && !wf_post(f[..], store[..], "");
  wf_step(f[..], 0.016);
  #assert wf_wants(f[..]) && f[0].want == WFQ_POST && wf_url(f[..]) == "/api/worlds/splice" && wf_body(f[..], store[..]) == WE_UNDO_FIXTURE && wf_flags(f[..]) == 5;
  wf_sent(f[..], 2); a = wf_answer(f[..], 2, "422\n{\"error\":\"nothing to undo\"}");
  #assert a.what == WFQ_POST;
  wf_posted(f[..], a);
  #assert f[0].body_n == 0 && wf_refused(f[..]) == "nothing to undo" && f[0].refused_status == 422 && f[0].refused_edit == -1 && !f[0].nudged;
  #assert wf_post(f[..], store[..], WE_UNDO_FIXTURE) && wf_refused(f[..]) == "";
  wf_step(f[..], 0.016); wf_sent(f[..], 2); a = wf_answer(f[..], 2, "200\n{}"); wf_posted(f[..], a);
  #assert f[0].nudged && wf_refused(f[..]) == "";
  wf_step(f[..], 0.016); #assert f[0].want == WFQ_EVENTS;   // the batch as taken comes back as events, asked for at once
  wf_sent(f[..], 1); a = wf_answer(f[..], 1, "200\n");
  #assert wf_post(f[..], store[..], WE_UNDO_FIXTURE);
  wf_step(f[..], 0.016); wf_sent(f[..], 2); a = wf_answer(f[..], 2, "422\n{\"error\":\"in the kept-clear zone 'Scanner gate'\",\"edit\":1}"); wf_posted(f[..], a);
  #assert wf_refused(f[..]) == "in the kept-clear zone 'Scanner gate'" && f[0].refused_edit == 1;
  #assert wf_post(f[..], store[..], WE_UNDO_FIXTURE);
  wf_step(f[..], 0.016); wf_sent(f[..], 2); a = wf_answer(f[..], 2, "409\n{\"error\":\"stale\"}"); wf_posted(f[..], a);
  #assert f[0].nudged && f[0].refused_status == 409;
  // a live page never writes
  #assert wf_open(f[..], "splice", WL_LIVE, pins);
  wf_step(f[..], 0.016); wf_sent(f[..], 0); a = wf_answer(f[..], 0, "200\n{}"); wf_loaded(f[..], WorldState.{rev = 1, live = 1});
  #assert wf_post(f[..], store[..], WE_UNDO_FIXTURE);
  wf_step(f[..], 0.016); #assert f[0].want != WFQ_POST;
}

#test "a realm that reads the world's own tables asks for them after each document, before any event; one that does not never asks" {
  store: [2048] u8;   // the page's room for a batch on its way
  f := [1] WorldFollow.[WorldFollow.{}];
  #assert wf_open(f[..], "splice", WL_DEV, WorldPins.{engine = 1, rules = 1, content = 1, wire = 1});
  f[0].tables = true;
  wf_step(f[..], 0.016);
  #assert f[0].want == WFQ_DOC;
  wf_sent(f[..], 1); a := wf_answer(f[..], 1, "200\nx");
  wf_loaded(f[..], WorldState.{rev = 3, dev = 3});
  wf_step(f[..], 5);
  #assert f[0].want == WFQ_TABLES && wf_url(f[..]) == "/api/worlds/splice/content?lane=dev" && wf_body(f[..], store[..]) == "" && wf_flags(f[..]) == WF_HTTP_WANTED;
  wf_sent(f[..], 2); a = wf_answer(f[..], 2, "200\ntables");
  #assert a.what == WFQ_TABLES && a.status == 200 && a.body == "tables";
  wf_tabled(f[..]);
  wf_step(f[..], 5);
  #assert f[0].want == WFQ_EVENTS;
  wf_sent(f[..], 3); a = wf_answer(f[..], 3, "200\n");
  // back to the document: its tables are read again
  wf_reopen(f[..]); wf_step(f[..], 0.016);
  #assert f[0].want == WFQ_DOC;
  wf_sent(f[..], 4); a = wf_answer(f[..], 4, "200\nx");
  wf_loaded(f[..], WorldState.{rev = 4, dev = 4});
  wf_step(f[..], 0.016);
  #assert f[0].want == WFQ_TABLES;
  // a realm that keeps its build's tables
  k := [1] WorldFollow.[WorldFollow.{}];
  #assert wf_open(k[..], "splice", WL_LIVE, WorldPins.{engine = 1, rules = 1, content = 1, wire = 1});
  wf_step(k[..], 0.016); wf_sent(k[..], 1); a = wf_answer(k[..], 1, "200\nx");
  wf_loaded(k[..], WorldState.{lane = WL_LIVE, rev = 1, live = 1});
  wf_step(k[..], 60);
  #assert k[0].want == WFQ_EVENTS;
}
