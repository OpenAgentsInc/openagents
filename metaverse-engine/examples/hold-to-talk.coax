// book:begin example
#load "../audio/voice.coax";
#import "Basic";

// The Metaverse Engine's HOLD TO TALK through its event gate (metaverse-engine/audio/voice.coax). Each hold is a
// question the realm asks; the voice host's final transcript (Parakeet, run locally:
// metaverse/voice-host --recognizer parakeet) is its answer. The transcripts below are the ones the
// host returned for the committed fixtures (docs/verification/verse-parakeet-2026-11-02).
// A duplicate, an answer after a cancel and a silent hold are shown, then the record replays.
show :: (r: [] VoiceRealm, what: string, verdict: int) {
  names := [8] string.["accepted", "duplicate", "stale", "unknown", "full", "replaying", "too long", "log full"];
  print("%: %\n", what, names[verdict]);
}
heard :: (r: [] VoiceRealm) {
  out: [600] u8;
  n := engine_voice_heard(r, out[..]);
  kind := ifx engine_voice_heard_kind(r) == VOICE_NO_SPEECH then "no speech" else "heard";
  print("  step: hold % % \"%\"\n", engine_voice_heard_request(r), kind, cast(string) out[0..<n]);
}
main :: () {
  r: [1] VoiceRealm;
  engine_voice_init(r[..], 12669);
  steps := 0;
  // Hold, speak, release: the press applies at the next step and asks question 1.
  show(r[..], "press", engine_voice_control(r[..], VOICE_PRESS));
  took := engine_voice_step(r[..]); steps += 1;
  q := engine_voice_holding(r[..]);
  show(r[..], "final for hold 1", engine_voice_offer(r[..], q, engine_voice_epoch(r[..]), "Build a small red house next to a tall tree."));
  show(r[..], "the same final again", engine_voice_offer(r[..], q, engine_voice_epoch(r[..]), "Build a small red house next to a tall tree."));
  took = engine_voice_step(r[..]); steps += 1;
  heard(r[..]);
  // Hold again, then cancel before the host answers: its late transcript is stale.
  show(r[..], "press", engine_voice_control(r[..], VOICE_PRESS));
  took = engine_voice_step(r[..]); steps += 1;
  late := engine_voice_holding(r[..]);
  old := engine_voice_epoch(r[..]);
  show(r[..], "cancel", engine_voice_control(r[..], VOICE_CANCEL));
  took = engine_voice_step(r[..]); steps += 1;
  show(r[..], "late final for the cancelled hold", engine_voice_offer(r[..], late, old, "Hello Foreman. What are we building today?"));
  // A silent hold: the host's empty final is "no speech", and still closes the hold.
  show(r[..], "press", engine_voice_control(r[..], VOICE_PRESS));
  took = engine_voice_step(r[..]); steps += 1;
  show(r[..], "empty final", engine_voice_offer(r[..], engine_voice_holding(r[..]), engine_voice_epoch(r[..]), ""));
  took = engine_voice_step(r[..]); steps += 1;
  heard(r[..]);
  print("applied %, refused % duplicate and % stale\n", engine_voice_applied(r[..]), engine_voice_refused(r[..], REPLAY_DUPLICATE), engine_voice_refused(r[..], REPLAY_STALE));
  // The record replays with no recognizer, host or network.
  print("replay of % steps matched: %\n", steps, engine_voice_replay(r[..], VOICE_INITIAL, steps));
  heard(r[..]);
}
// book:end example
