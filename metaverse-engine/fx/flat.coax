// A cause seen from above (book chapter 72, #13086): how a map or a flat view of a battle grid draws
// the same causes the 3D view turns into puffs (puff.coax). A bolt is a line flying from → to, an
// area spell a ring out to its reach, and the rest a ring opening where it lands. Pure: a function
// of the cause and its age, so the flat and the 3D views always show the same effects.
//   coax/bin/coax test --library metaverse-engine/fx/flat.coax
#load "puff.coax";

FXF_NONE :: 0; FXF_LINE :: 1; FXF_RING :: 2;
// A line from (ax, az) to (bx, bz), or a ring round (ax, az) of radius r (metres), at strength alpha.
FxFlat :: struct { kind: int; ax: f32; az: f32; bx: f32; bz: f32; r: f32; alpha: f32; col: FxV; }

// The recipes that fly from → to.
fxf_flies :: (r: int) -> bool {
  return r == FXR_FIREBOLT || r == FXR_STREAK || r == FXR_ARROW || r == FXR_STAR || r == FXR_ELDRITCH || r == FXR_SOULFIRE
      || r == FXR_SHAFT || r == FXR_STONE || r == FXR_NOTES || r == FXR_LAY || r == FXR_FLURRY;
}
// The recipes that cover an area `reach` metres round `to`.
fxf_area :: (r: int) -> bool {
  return r == FXR_FIREBALL || r == FXR_SHOCK || r == FXR_ORBIT || r == FXR_SHIMMER || r == FXR_BLOOM || r == FXR_HALO
      || r == FXR_WAVE || r == FXR_THORNS || r == FXR_NECRO_RING || r == FXR_LIGHTNING;
}
// Cause c at `now`, from above: FXF_NONE before it starts and after it ends.
fxf_of :: (c: FxCause, now: f32) -> FxFlat {
  out := FxFlat.{kind = FXF_NONE, ax = c.to.x, az = c.to.z, bx = c.to.x, bz = c.to.z, col = c.col};
  a := fxp_through(now, c.t0, fxp_life(c));
  if a < 0 { return out; }
  dx := c.to.x - c.from.x; dz := c.to.z - c.from.z;
  if fxf_flies(c.recipe) && dx * dx + dz * dz > 0.25 {
    head := fxp_min(1, a * 2.2); tail := fxp_min(1, fxp_max(0, a * 2.2 - 0.5));
    out.kind = FXF_LINE; out.alpha = 1 - a * 0.5;
    out.ax = c.from.x + dx * tail; out.az = c.from.z + dz * tail;
    out.bx = c.from.x + dx * head; out.bz = c.from.z + dz * head;
    return out;
  }
  out.kind = FXF_RING; out.alpha = 1 - a;
  out.r = ifx fxf_area(c.recipe) then c.reach * (0.85 + 0.3 * a) else 0.55 + 0.6 * a;
  return out;
}

#test "flat effects: a bolt is a line that flies, an area a ring out to its reach, a cause past its life is gone" {
  bolt := FxCause.{recipe = FXR_FIREBOLT, t0 = 0, from = fxp_v(0, 1, 0), to = fxp_v(10, 1, 0), col = fxp_v(1, 0.5, 0.1)};
  f := fxf_of(bolt, 0.1);
  #assert f.kind == FXF_LINE && f.ax == 0 && f.bx > 0 && f.bx < 10 && f.col.x == 1;
  ball := FxCause.{recipe = FXR_FIREBALL, t0 = 0, from = fxp_v(0, 1, 0), to = fxp_v(5, 1, 5), reach = 6};
  r := fxf_of(ball, 0.2);
  #assert r.kind == FXF_RING && r.ax == 5 && r.r > 5 && r.r < 7.5;
  #assert fxf_of(ball, 100).kind == FXF_NONE && fxf_of(ball, -1).kind == FXF_NONE;
  heal := FxCause.{recipe = FXR_HEAL, t0 = 0, to = fxp_v(2, 0, 3)};
  #assert fxf_of(heal, 0.5).kind == FXF_RING && fxf_of(heal, 0.5).r < 1.5;
}
