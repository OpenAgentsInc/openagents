// C compilation/linking effects only, against the retained single Coax owner.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<3||args_count(a[..])>4||(args_count(a[..])==4&&args_at(a[..],3)!="--sanitize") {tool_errln("usage: build-linux-live-media ROOT EMISSION NEW_OUT [--sanitize]");return 2;}
 if cxtool_os()!=2 {return 2;}root:=args_at(a[..],0);emission:=args_at(a[..],1);out:=args_at(a[..],2);sanitize:=args_has(a[..],"--sanitize");if !fs_mkdir(out) {return 1;}argv:[64]string;n:=0;paths:[24][4096]u8;inputs:[1]RtqInputs;
 for flag:[11]string.["nice","-n10","gcc","-std=gnu11",ifx sanitize then "-O1" else "-O2","-ffp-contract=off","-fno-fast-math","-ffunction-sections","-fdata-sections","-Wl,--gc-sections","-DCOAX_TOOL_STACK=((size_t)1<<30)"] {argv[n]=flag;n+=1;}
 for dir:[5]string.[emission,fs_join(root,"verse/native",paths[0][..]),fs_join(root,"verse/gpu",paths[1][..]),fs_join(root,"metaverse-engine/render/tests",paths[2][..]),fs_join(root,"coax/platform",paths[3][..])] {argv[n]="-I";argv[n+1]=dir;n+=2;}
 argv[n]=fs_join(emission,"LiveMedia.c",paths[4][..]);if !rtq_input_add(inputs[..],argv[n]) {return 1;}n+=1;
 for file,i:[11]string.["metaverse-engine/host/tests/linux-live-media-effects.c","verse/native/render-host.c","verse/native/render-images.c","verse/native/render-live-media.c","verse/native/render-media.c","verse/gpu/vkc.c","verse/gpu/vks.c","coax/platform/tool-native.c","coax/platform/process-native.c","coax/platform/store-file-native.c","coax/platform/read-file-native.c"] {argv[n]=fs_join(root,file,paths[5+i][..]);if !rtq_input_add(inputs[..],argv[n]) {return 1;}n+=1;}
 for file:[3]string.["LiveMedia.h","RenderHost.h","RenderTexture.h"] {if !rtq_input_add(inputs[..],fs_join(emission,file,paths[16][..])) {return 1;}}
 for flag:[3]string.["-lvulkan","-lpthread","-lm"] {argv[n]=flag;n+=1;}if sanitize {for flag:[4]string.["-fsanitize=address,undefined","-fno-sanitize-recover=all","-fno-omit-frame-pointer","-g"] {argv[n]=flag;n+=1;}}
 bin:=fs_join(out,"check-linux-live-media",paths[17][..]);argv[n]="-o";argv[n+1]=bin;n+=2;stdout:[1048576]u8;stderr:[1048576]u8;env:[]string;
 r:=rtq_command(argv[0..<n],env,proc_now_ms()+180000,out,"link",stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_inputs_match(inputs[..])||!rtq_input_add(inputs[..],bin) {return 1;}
 record:[65536]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.linux-live-media-build.v1");jo_key(o[..],"sanitized");jo_bool(o[..],sanitize);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);return ifx !o[0].bad&&fs_write(fs_join(out,"build.json",paths[18][..]),jo_text(o[..])) then 0 else 1;
}
