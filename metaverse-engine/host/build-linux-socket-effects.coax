// Build the shared portable worker SDK and Coax physical-effects driver.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
#test "SDK flag transport splits whitespace and never expands shell syntax" {
 out:[4]string;#assert hsb_words(" -I/sdk\n-lssl\t-lcrypto ",out[..],0)==3&&out[0]=="-I/sdk"&&out[1]=="-lssl"&&out[2]=="-lcrypto";
 #assert hsb_words("$(not-a-command)",out[..],0)==1&&out[0]=="$(not-a-command)";#assert hsb_words("a b c d e",out[..],0)== -1;
}
hsb_words :: (text:string,out:[]string,start:int)->int {
 n:=start;from:=0;for i:0..<text.count+1 {if i==text.count||text[i]==' '||text[i]=='\n'||text[i]=='\t' {if i>from {if n==out.count {return -1;}out[n]=text[from..<i];n+=1;}from=i+1;}}return n;
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<5||args_count(a[..])>7||cxtool_os()!=2 {tool_errln("usage: build-linux-socket-effects ROOT EMISSION NEW_OUT TLS_CFLAGS_FILE TLS_LIBS_FILE [--sanitize] [--transport]");return 2;}
 for i:5..<args_count(a[..]) {if args_at(a[..],i)!="--sanitize"&&args_at(a[..],i)!="--transport" {return 2;}}transport:=args_has(a[..],"--transport");
 root:=args_at(a[..],0);emission:=args_at(a[..],1);out:=args_at(a[..],2);sanitize:=args_has(a[..],"--sanitize");if !fs_mkdir(out) {return 1;}
 paths:[40][4096]u8;argv:[96]string;n:=0;inputs:[1]RtqInputs;
 for flag:[11]string.["nice","-n10","gcc","-std=gnu11",ifx sanitize then "-O1" else "-O2","-D_DEFAULT_SOURCE","-ffp-contract=off","-fno-fast-math","-Wno-unused-function","-Wno-unused-variable","-Wno-unused-but-set-variable"] {argv[n]=flag;n+=1;}
 argv[n]="-I";argv[n+1]=emission;n+=2;for dir,i:[2]string.["coax/platform","apps/aethyrforge-desktop"] {argv[n]="-I";argv[n+1]=fs_join(root,dir,paths[i][..]);n+=2;}
 for file,i:[3]string.["HostNetwork.c","HostEntropy.c",ifx transport then "HostCheck.c" else "SocketEffects.c"] {argv[n]=fs_join(emission,file,paths[2+i][..]);if !rtq_input_add(inputs[..],argv[n]) {return 1;}n+=1;}
 for file,i:[10]string.["apps/aethyrforge-desktop/MetalSockets.c",ifx transport then "metaverse-engine/host/tests/vulkan-effects.c" else "metaverse-engine/host/tests/socket-sdk-effects.c","coax/platform/socket-native.c","coax/platform/tls-native.c","coax/platform/entropy-native.c","coax/platform/entropy-foreign.c","coax/platform/tool-native.c","coax/platform/process-native.c","coax/platform/store-file-native.c","coax/platform/read-file-native.c"] {argv[n]=fs_join(root,file,paths[5+i][..]);if !rtq_input_add(inputs[..],argv[n]) {return 1;}n+=1;}
 for file:[6]string.["HostNetwork.h","entropy-policy.h",ifx transport then "HostCheck.h" else "SocketEffects.h","HostNetwork.profile.json","HostEntropy.profile.json",ifx transport then "HostCheck.profile.json" else "SocketEffects.profile.json"] {if !rtq_input_add(inputs[..],fs_join(emission,file,paths[15][..])) {return 1;}}
 for file:[10]string.["apps/aethyrforge-desktop/metal-sockets.h","coax/platform/socket-native.h","coax/platform/tls-native.h","coax/platform/tls-apple.inc","coax/platform/entropy-native.h","coax/platform/entropy-foreign.h","coax/platform/tool-native.h","coax/platform/process-native.h","coax/platform/store-file-native.h","coax/platform/read-file-native.h"] {if !rtq_input_add(inputs[..],fs_join(root,file,paths[15][..])) {return 1;}}
 if transport {
  for flag:[6]string.["-no-pie","-DHF_EXTERNAL_TRANSPORT","-I",fs_join(root,"verse/native",paths[18][..]),"-I",fs_join(root,"coax/web",paths[19][..])] {argv[n]=flag;n+=1;}
  for file,i:[2]string.["fixture.c","host-transport.c"] {argv[n]=fs_join(emission,file,paths[20+i][..]);if !rtq_input_add(inputs[..],argv[n]) {return 1;}n+=1;}
  for file,i:[3]string.["verse/native/realm-host.c","verse/native/host-sockets.c","metaverse-engine/host/tests/fixture-face.c"] {argv[n]=fs_join(root,file,paths[22+i][..]);if !rtq_input_add(inputs[..],argv[n]) {return 1;}n+=1;}
  for file:[3]string.["fixture.h","RenderHost.h","fixture.profile.json"] {if !rtq_input_add(inputs[..],fs_join(emission,file,paths[25][..])) {return 1;}}
  for file:[5]string.["verse/native/realm-host.h","verse/native/face.h","verse/native/audio-host.h","coax/web/host-transport-face.c","coax/web/host-lifecycle-face.c"] {if !rtq_input_add(inputs[..],fs_join(root,file,paths[25][..])) {return 1;}}
 }
 cf:[8192]u8;lf:[8192]u8;cn:=fs_read(args_at(a[..],3),cf[..]);ln:=fs_read(args_at(a[..],4),lf[..]);if cn<0||ln<0||!rtq_input_add(inputs[..],args_at(a[..],3))||!rtq_input_add(inputs[..],args_at(a[..],4)) {return 1;}n=hsb_words(cast(string)cf[0..<cn],argv[..],n);if n<0 {return 1;}n=hsb_words(cast(string)lf[0..<ln],argv[..],n);if n<0 {return 1;}
 for flag:[2]string.["-lpthread","-lm"] {argv[n]=flag;n+=1;}if sanitize {for flag:[4]string.["-fsanitize=address,undefined","-fno-sanitize-recover=all","-fno-omit-frame-pointer","-g"] {argv[n]=flag;n+=1;}}
 bin:=fs_join(out,ifx transport then "check-vulkan" else "MetalSocketEffects",paths[16][..]);argv[n]="-o";argv[n+1]=bin;n+=2;env:[]string;stdout:[1048576]u8;stderr:[1048576]u8;r:=rtq_command(argv[0..<n],env,proc_now_ms()+120000,out,"link",stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_inputs_match(inputs[..])||!rtq_input_add(inputs[..],bin) {return 1;}
 record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.linux-socket-build.v1");jo_key(o[..],"sanitized");jo_bool(o[..],sanitize);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);return ifx o[0].bad||!fs_write(fs_join(out,"build.json",paths[17][..]),jo_text(o[..])) then 1 else 0;
}
