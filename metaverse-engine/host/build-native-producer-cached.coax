// Native compiler/linker effects over an existing source-qualified C/H cache.
// No Coax re-emission, generated-source rewriting or duplicate-symbol waiver.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<4||args_count(a[..])>7 {tool_errln("usage: build-native-producer-cached ROOT C_CACHE MATCHING_FACE_DIR NEW_OUT [--sanitize] [--objects PRIOR_BUILD]");return 2;}
 for i:4..<args_count(a[..]) {if args_at(a[..],i)=="--objects" {if i+1>=args_count(a[..]) {return 2;}continue;}if args_at(a[..],i)!="--sanitize"&&(i==4||args_at(a[..],i-1)!="--objects") {return 2;}}
 if cxtool_os()!=2 {return 2;}root:=args_at(a[..],0);cache:=args_at(a[..],1);face:=args_at(a[..],2);out:=args_at(a[..],3);sanitize:=args_has(a[..],"--sanitize");paths:[20][4096]u8;inputs:[1]RtqInputs;
 if !fs_mkdir(out) {return 1;}listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 for name:[10]string.["everglade5e.c","everglade5e.h","Grid.c","Grid.h","River.c","River.h","Everglade5e-rules.c","Everglade5e-rules.h","Everglade-step.h","Guard-guide-policy.h"] {if !rtq_input_add(inputs[..],fs_join(cache,name,paths[0][..])) {return 1;}}
 if !rtq_input_add(inputs[..],fs_join(face,"everglade5e-face.c",paths[0][..])) {return 1;}
 files:=fs_list(face,listing[..]);if files<0 {return 1;}for i:0..<files {name:=fs_entry(listing[..],i);n:=name.count;if n>2&&name[n-2]=='.'&&name[n-1]=='h'&&!rtq_input_add(inputs[..],fs_join(face,name,paths[0][..])) {return 1;}}
 for name:[2]string.["verse/native/face.h","verse/native/face-defaults.h"] {if !rtq_input_add(inputs[..],fs_join(root,name,paths[0][..])) {return 1;}}
 objects:[6]string;argv:[24]string;stdout:[1048576]u8;stderr:[1048576]u8;env:[]string;prior:=args_value(a[..],"--objects","");
 for name,i:[6]string.["everglade5e","Grid","River","Everglade5e-rules","producer-face","face-defaults"] {
  text:[64]u8;o:[1]Jo;jo_start(o[..],text[..]);jo_put(o[..],name);jo_put(o[..],".o");objects[i]=fs_join(out,jo_text(o[..]),paths[1+i][..]);
  if i<4&&prior!="" {objects[i]=fs_join(prior,jo_text(o[..]),paths[1+i][..]);if !rtq_input_add(inputs[..],objects[i]) {return 1;}continue;}
  source:[128]u8;w:[1]Jo;jo_start(w[..],source[..]);jo_put(w[..],name);jo_put(w[..],".c");
  path:=ifx i<4 then fs_join(cache,jo_text(w[..]),paths[7][..]) else ifx i==4 then fs_join(face,"everglade5e-face.c",paths[7][..]) else fs_join(root,"verse/native/face-defaults.h",paths[7][..]);
  n:=0;for flag:[10]string.["nice","-n15","gcc","-x","c","-std=gnu11",ifx sanitize then "-O1" else "-O2","-fPIC","-ffp-contract=off","-fno-fast-math"] {argv[n]=flag;n+=1;}
  argv[n]=ifx i<4 then "-fvisibility=hidden" else "-DCOAXIAL_NATIVE_ADDRESS";n+=1;argv[n]="-Wno-attributes";n+=1;argv[n]="-I";argv[n+1]=cache;n+=2;
  if sanitize {for flag:[3]string.["-fsanitize=address,undefined","-fno-omit-frame-pointer","-g"] {argv[n]=flag;n+=1;}}
  for flag:[4]string.["-c",path,"-o",objects[i]] {argv[n]=flag;n+=1;}
  r:=rtq_command(argv[0..<n],env,proc_now_ms()+180000,out,name,stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}
  if !rtq_input_add(inputs[..],objects[i]) {return 1;}
 }
 bin:=fs_join(out,"libeverglade.so",paths[8][..]);n:=0;for flag:[3]string.["nice","-n15","gcc"] {argv[n]=flag;n+=1;}argv[n]="-shared";n+=1;if sanitize {argv[n]="-fsanitize=address,undefined";n+=1;}for object:objects {argv[n]=object;n+=1;}for flag:[4]string.["-lm","-o",bin,"-Wl,-soname,libeverglade.so"] {argv[n]=flag;n+=1;}
 r:=rtq_command(argv[0..<n],env,proc_now_ms()+180000,out,"link",stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_inputs_match(inputs[..])||!rtq_input_add(inputs[..],bin) {return 1;}
 symbols:=[4]string.["nm","-D","--defined-only",bin];r=rtq_command(symbols[..],env,proc_now_ms()+30000,out,"symbols",stdout[..],stderr[..]);if !rtq_ok(r) {return 1;}
 record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.cached-native-producer.v1");jo_key(o[..],"sanitized");jo_bool(o[..],sanitize);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_key(o[..],"scope");jo_str(o[..],"Unedited qualified C/H plus matching face in a native-width DSO; compiler cache/source admission and actual execution remain separate.");jo_end(o[..]);return ifx !o[0].bad&&fs_write(fs_join(out,"build.json",paths[9][..]),jo_text(o[..])) then 0 else 1;
}
