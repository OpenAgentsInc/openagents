// Actual browser Wasm decoder against every byte of the authored native bank.
#load "../../coax/web/wasm-chrome.coax";
#load "../render/tests/qualification-files.coax";
#load "layers-conformance.coax";
hl_line :: (text:string,wanted:int)->string {start:=0;line:=0;for c,i:text {if c=='\n' {if line==wanted {return rtq_trim(text[start..<i]);}line+=1;start=i+1;}}return ifx line==wanted then rtq_trim(text[start..<text.count]) else "";}
hl_spawn :: (argv:[]string)->int {h:=proc_new();if h<0 {return -1;}for arg:argv {if !proc_arg(h,arg){_:=proc_release(h);return -1;}}if proc_start(h)!=0 {_:=proc_release(h);return -1;}return h;}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=3 {tool_errln("usage: check-browser-layers REACTOR.wasm NATIVE_FIXTURE_DIR NEW_OUT");return 2;}
 paths:[10][4096]u8;wasm:=args_at(a[..],0);fixture:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 2;}listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 site:=fs_join(out,"site",paths[0][..]);if !fs_mkdir(site) {return 1;}binary:[2097152]u8;n:=fs_read(wasm,binary[..]);if n<1||!fs_write(fs_join(site,"host-layers.wasm",paths[1][..]),cast(string)binary[0..<n])||!fs_write(fs_join(site,"index.html",paths[1][..]),"<!doctype html><title>Canonical layer fixture</title>") {return 1;}
 inputs:[1]RtqInputs;for file:[4]string.[wasm,"coax/web/layers-bridge.js","coax/web/layers-face.c","metaverse-engine/host/tests/layers-effects.js"] {if !rtq_input_add(inputs[..],file) {return 1;}}
 compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);if !rtq_input_add(inputs[..],compiler)||!rtq_deps(inputs[..],compiler,"metaverse-engine/host/check-browser-layers.coax",proc_now_ms()+30000,out,"observer-dependencies")||!rtq_deps(inputs[..],compiler,"metaverse-engine/host/layers-carrier.coax",proc_now_ms()+30000,out,"reactor-dependencies") {tool_errln("layer dependency fence failed");return 1;}print("Layer dependencies fenced.\n");
 list:[65536]u8;config:[65536]u8;listpath:=fs_join(fixture,"layers.list",paths[1][..]);configpath:=fs_join(fixture,"textures.config",paths[2][..]);ln:=fs_read(listpath,list[..]);cn:=fs_read(configpath,config[..]);bank:=fs_join(fixture,"layers.rgba",paths[3][..]);
 if ln<1||cn<1||!rtq_input_add(inputs[..],listpath)||!rtq_input_add(inputs[..],configpath)||!rtq_input_add(inputs[..],bank) {tool_errln("layer native fixture fence failed");return 1;}print("Layer native fixture fenced.\n");
 root:=fs_cwd(paths[4][..]);host:=fs_join(root,"coax/web",paths[5][..]);argv:=[9]string.["coax/web/serve.sh",site,"--host-dir",host,"--listen","127.0.0.1:9177","--static","--cache","0"];
 server:=hl_spawn(argv[..]);if server<0 {return 1;}defer {k:=proc_kill(server,PROC_SIGTERM);w:=proc_wait(server,2000);r:=proc_release(server);}
 waiting:[1]Cdp;body:[4096]u8;ready:=false;for attempt:0..<100 {if cdp_get(waiting[..],9177,"/",body[..])>0 {ready=true;break;}proc_sleep(50);}if !ready {return 1;}
 c:[1]Cdp;if !cdp_launch(c[..],160,90,"coax-layer-bank-") {return 1;}defer {cdp_close(c[..]);}
 nav:=cdp_call(c[..],"Page.navigate","{\"url\":\"http://127.0.0.1:9177/\"}",30000);ready=false;for attempt:0..<100 {if wc_eval(c[..],"document.readyState==='complete'&&location.hostname==='127.0.0.1'")=="true" {ready=true;break;}proc_sleep(50);}if !ready {return 1;}
 glue:[65536]u8;gn:=fs_read(WC_HOST_FILE,glue[..]);if gn<1||wc_eval(c[..],cast(string)glue[0..<gn])!="ready" {return 1;}gn=fs_read("metaverse-engine/host/tests/layers-effects.js",glue[..]);if gn<1||wc_eval(c[..],cast(string)glue[0..<gn])!="ready" {return 1;}
 opened:=wc_eval(c[..],"(async()=>JSON.stringify(await hostLayerEffects.open()))()");if opened!="[512,0,0,0]" {tool_errln(opened);tool_errln(cdp_error(c[..]));return 1;}print("Actual image bridge opened.\n");
 raw:[5592404]u8;source:[8388608]u8;native:[4194304]u8;encoded:[65536]u8;js:[4096]u8;o:[1]Jo;report:[262144]u8;r:[1]Jo;jo_start(r[..],report[..]);jo_obj(r[..]);jo_key(r[..],"schema");jo_str(r[..],"aethyr.host.layer-bank.v1");jo_key(r[..],"layers");jo_arr(r[..]);count:=0;different:=0;per_layer:=0;side:=htx_profile(2).side;levels:=0;
 while true {
  name:=hl_line(cast(string)list[0..<ln],count);if name=="" {break;}if !nfm_relative_name(name) {return 1;}
  input:=fs_join(fixture,name,paths[6][..]);sn:=fs_read(input,source[..]);if sn<1||!rtq_input_add(inputs[..],input)||!wc_file(c[..],"input.img",cast(string)source[0..<sn]) {return 1;}
  p:=htx_plan(source[0..<sn],side);if p.status!=0 {return 1;}values:[9]int;jo_start(o[..],js[..]);jo_put(o[..],"hostLayerEffects.decode('input.img',");jo_int(o[..],side);jo_put(o[..],")");v:=cdp_evaluate(c[..],jo_text(o[..]));if v<0 {tool_errln(cdp_error(c[..]));return 1;}d:=cdp_doc(c[..]);if jv_len(d,v)!=9 {return 1;}for i:0..<9 {values[i]=jv_int(d,jv_at(d,v,i),-1);}if !hlc_plan(values[..],p) {return 1;}
  at:=0;while at<p.bytes {chunk:=ifx p.bytes-at<16384 then p.bytes-at else 16384;jo_start(o[..],js[..]);jo_put(o[..],"hostLayerEffects.read(");jo_int(o[..],at);jo_put(o[..],",");jo_int(o[..],chunk);jo_put(o[..],")");v=cdp_evaluate(c[..],jo_text(o[..]));if v<0 {return 1;}en:=jv_str(cdp_doc(c[..]),v,encoded[..]);if en<1||b64_decode(cast(string)encoded[0..<en],raw[at..<at+chunk])!=chunk {return 1;}at+=chunk;}
  offset:=0;layer_different:=0;for level:0..<p.levels {
   line:=hl_line(cast(string)config[0..<cn],level+2);width:=args_whole(rtq_word(line,0));height:=args_whole(rtq_word(line,1));bank_offset:=args_whole(rtq_word(line,2));row_bytes:=args_whole(rtq_word(line,3));slice_bytes:=args_whole(rtq_word(line,4));
   if width!=img_side(side,level)||height!=width||row_bytes!=width*4||slice_bytes!=width*height*4||fs_read_at(bank,bank_offset+count*slice_bytes,native[0..<slice_bytes])!=slice_bytes {return 1;}
   delta:=hlc_bytes(raw[offset..<offset+slice_bytes],native[0..<slice_bytes]);if delta<0 {return 1;}layer_different+=delta;offset+=slice_bytes;
  }
  if offset!=p.bytes||!fs_write(fs_join(out,name,paths[7][..]),cast(string)raw[0..<p.bytes]) {return 1;}
  different+=layer_different;per_layer=p.bytes;levels=p.levels;count+=1;jo_obj(r[..]);jo_key(r[..],"source");jo_str(r[..],name);jo_key(r[..],"source_bytes");jo_int(r[..],sn);jo_key(r[..],"bytes");jo_int(r[..],p.bytes);jo_key(r[..],"different");jo_int(r[..],layer_different);jo_end(r[..]);print("Canonical layer %: % bytes, % different.\n",count,p.bytes,layer_different);
 }
 closed:=wc_eval(c[..],"hostLayerEffects.close()")=="true";cdp_close(c[..]);same:=rtq_inputs_match(inputs[..]);passed:=hlc_complete(count,different,side,levels)&&fs_size(bank)==count*per_layer&&same&&closed;
 jo_end(r[..]);jo_key(r[..],"passed");jo_bool(r[..],passed);jo_key(r[..],"count");jo_int(r[..],count);jo_key(r[..],"different");jo_int(r[..],different);jo_key(r[..],"source_fence_unchanged");jo_bool(r[..],same);jo_key(r[..],"inputs");rtq_inputs_json(r[..],inputs[..],"");jo_end(r[..]);if r[0].bad||!fs_write(fs_join(out,"comparison.json",paths[8][..]),jo_text(r[..])) {return 1;}return ifx passed then 0 else 1;
}
// Fixture input list names one physical file per slice, no traversal.
nfm_relative_name :: (s:string)->bool {if s==""||s=="."||s==".." {return false;}for c:s {if c=='/'||c=='\\' {return false;}}return true;}
