// Execute the real platform adapter; Coax admits every raw observation.
#load "../../coax/web/wasm-chrome.coax";
#load "audio-worklet-refusal-conformance.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=2 {tool_errln("usage: check-browser-worklet-refusal LOCAL_URL OUT.json");return 2;}
 url:=args_at(a[..],0);if url.count<17||url[0..<17]!="http://127.0.0.1:" {return 2;}
 c:[1]Cdp;if !cdp_launch(c[..],160,90,"coax-worklet-refusal-") {return 1;}defer {cdp_close(c[..]);}
 params:[8192]u8;o:[1]Jo;jo_start(o[..],params[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],url);jo_end(o[..]);nav:=cdp_call(c[..],"Page.navigate",jo_text(o[..]),CDP_CALL_MS);
 glue:[16384]u8;n:=fs_read("metaverse-engine/host/tests/audio-worklet-memory.js",glue[..]);if n<0 {tool_errln("Missing memory fixture SDK glue.");return 1;}
 if wc_eval(c[..],cast(string)glue[0..<n])!="ready" {tool_errln(cdp_error(c[..]));tool_errln("Memory fixture glue did not install.");return 1;}
 value:=cdp_evaluate(c[..],"Promise.race([workletMemoryFixture(),new Promise((resolve,reject)=>setTimeout(()=>reject(Error('fixture timeout')),15000))]).catch(error=>({error:String(error.stack),stage:globalThis.workletMemoryStage}))");if value<0 {tool_errln(cdp_error(c[..]));return 1;}d:=cdp_doc(c[..]);if jv_len(d,value)!=20 {diagnostic:[8192]u8;jo_start(o[..],diagnostic[..]);jv_write(d,value,o[..]);tool_errln(jo_text(o[..]));return 1;}
 rows:[20]int;for i:0..<20 {rows[i]=jv_int(d,jv_at(d,value,i),-999);}report:[4096]u8;jo_start(o[..],report[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.browser-worklet-refusal.v1");jo_key(o[..],"rows");jv_write(d,value,o[..]);jo_key(o[..],"passed");jo_bool(o[..],hwr_accept(rows[..]));jo_end(o[..]);if o[0].bad||!fs_write(args_at(a[..],1),jo_text(o[..])) {return 1;}
 print("Actual Worklet refusal/cancellation ownership: %.\n",hwr_accept(rows[..]));return ifx hwr_accept(rows[..]) then 0 else 1;
}
