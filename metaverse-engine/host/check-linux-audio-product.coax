// Actual product realm dispatcher, physical spans, draining packets and muted
// device ownership. This is an SDK trace; the ordinary Vulkan window is separate.
#load "native-audio.coax";
#load "audio-product-conformance.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
hpr_open :: (mode:int)->int #foreign #effects(all);
hpr_info :: (field:int)->int #foreign #effects(all);
hpr_send :: (bytes:[]u8) #foreign #effects(all);
hpr_after :: () #foreign #effects(all);
hpr_gesture :: () #foreign #effects(all);
hpr_shown :: (shown:bool) #foreign #effects(all);
hpr_frame :: ()->int #foreign #effects(all);
hpr_retire :: () #foreign #effects(all);
hpr_close :: ()->int #foreign #effects(all);
hpa_send :: (text:string) {bytes:[128]u8;for b,i:text {bytes[i]=b;}hpr_send(bytes[0..<text.count]);}
hpa_wait :: (before:int)->bool {deadline:=proc_now_ms()+5000;while hpr_info(23)<=before&&proc_now_ms()<deadline {proc_sleep(10);}return hpr_info(23)>before;}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=2 {tool_errln("usage: check-linux-audio-product NEW_OUT ROOT");return 2;}
 out:=args_at(a[..],0);root:=args_at(a[..],1);paths:[4][4096]u8;if !fs_mkdir(out) {return 1;}
 inputs:[1]RtqInputs;for file:[8]string.["metaverse/native/realm-host.c","metaverse/native/realm-host.h","metaverse/native/audio-host.c","metaverse/native/audio-pipewire.c","metaverse-engine/host/tests/audio-fixture-face.c","metaverse-engine/host/tests/linux-audio-product-effects.c","metaverse-engine/host/audio-session.coax","metaverse-engine/host/audio-product-conformance.coax"] {if !rtq_input_add(inputs[..],fs_join(root,file,paths[0][..])) {return 1;}}
 self:[4096]u8;sn:=cxproc_self_path(self[..]);if sn<1||!rtq_input_add(inputs[..],cast(string)self[0..<sn]) {return 1;}
 q:HostAudioProductObserved;passed:=true;if hpr_open(0)!=0 {return 1;}defer {closed:=hpr_close();}
 q.assets=hpr_info(5);q.words=hpr_info(4);hpa_send("!bus 0.5");q.control=hpr_info(41);hpa_send("pulse 0.25 0");q.pre_cue=hpr_info(41);proc_sleep(100);q.pre_frames=hpr_info(0);q.pre_callbacks=hpr_info(23);
 hpr_shown(false);hpr_gesture();proc_sleep(100);q.covered_frames=hpr_info(0);q.covered_callbacks=hpr_info(23);q.started=hpr_info(8);
 hpr_shown(true);if !hpa_wait(0) {return 1;}hpa_send("pulse 0.25 0");q.cue=hpr_info(41);q.accepted=hpr_info(1);hpr_after();q.repeat_accepted=hpr_info(1);
 hpr_shown(false);q.running_frames=hpr_info(0);q.running_callbacks=hpr_info(23);proc_sleep(150);q.hidden_frames=hpr_info(0);q.hidden_callbacks=hpr_info(23);
 hpr_shown(true);if !hpa_wait(q.hidden_callbacks) {return 1;}hpr_shown(false);q.resumed_frames=hpr_info(0);q.resumed_callbacks=hpr_info(23);q.nonzero=hpr_info(30);q.drains=hpr_info(50);
 hpr_retire();q.retired=hpr_info(10);q.retired_frames=hpr_info(0);proc_sleep(100);q.late_frames=hpr_info(0);q.device_closed=hpr_info(42);q.context_closed=hpr_close();
 q.bad_metadata=hpr_open(1);passed=passed&&hpr_frame()==3&&hpr_frame()==3;metadata_frames:=hpr_info(51);closed:=hpr_close();passed=passed&&closed==1;
 q.bad_source=hpr_open(2);q.remaining_assets=hpr_info(5);hpr_shown(false);hpr_gesture();hpa_send("pulse 0.25 0");q.unavailable=hpr_info(41);hpa_send("pulse2 0.25 0");q.remaining_cue=hpr_info(41);passed=passed&&hpr_frame()==3&&hpr_frame()==3;q.world_frames=hpr_info(51);passed=passed&&metadata_frames==q.world_frames;closed=hpr_close();passed=passed&&closed==1;
 q.packet_refusals=0;for mode:3..<6 {if hpr_open(mode)!=0 {return 1;}hpa_send("!bus 0.5");if hpr_info(41)== -1&&hpr_info(1)==0&&hpr_info(50)==1 {q.packet_refusals+=1;}passed=passed&&hpr_frame()==3&&hpr_frame()==3&&hpr_info(51)==2;closed=hpr_close();passed=passed&&closed==1;}
 same:=rtq_inputs_match(inputs[..]);passed=passed&&same&&hpa_accept(q);
 record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.linux-audio-product.v1");jo_key(o[..],"passed");jo_bool(o[..],passed);jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],same);jo_key(o[..],"observed");jo_arr(o[..]);
 for value:[32]int.[q.assets,q.words,q.control,q.pre_cue,q.pre_frames,q.pre_callbacks,q.covered_frames,q.covered_callbacks,q.started,q.running_frames,q.running_callbacks,q.cue,q.accepted,q.repeat_accepted,q.hidden_frames,q.hidden_callbacks,q.resumed_frames,q.resumed_callbacks,q.retired,q.retired_frames,q.late_frames,q.device_closed,q.context_closed,q.nonzero,q.bad_metadata,q.bad_source,q.remaining_assets,q.unavailable,q.remaining_cue,q.world_frames,q.drains,q.packet_refusals] {jo_int(o[..],value);}jo_end(o[..]);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);
 if o[0].bad||!fs_write(fs_join(out,"audio.json",paths[0][..]),jo_text(o[..])) {return 1;}print("Actual realm audio product trace passed %.\n",passed);return ifx passed then 0 else 1;
}
