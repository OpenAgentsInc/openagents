// Actual ordinary window/local-room qualification. Coax owns the schedule,
// receipt and immutable source fence; the executable performs SDK effects.
#import "Basic";
#load "linux-window-conformance.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/net/socket_foreign.coax";
hlw_add :: (inputs:[]RtqInputs,path:string)->bool {for i:0..<inputs.count {if inputs[i].count<512 {return rtq_input_add(inputs[i..<i+1],path);}}return false;}
hlw_tree :: (inputs:[]RtqInputs,dir:string,depth:int)->bool {
 if depth>12 {return false;}listing:[1]FsList;n:=fs_list(dir,listing[..]);if n<0||listing[0].full {return false;}
 for i:0..<n {path:[4096]u8;file:=fs_join(dir,fs_entry(listing[..],i),path[..]);kind:=fs_kind(file);if kind==FS_DIR {if !hlw_tree(inputs,file,depth+1) {return false;}}else if kind!=FS_FILE||!hlw_add(inputs,file) {return false;}}return true;
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=5 {tool_errln("usage: check-linux-window BUILD FACTS ROOM_BINARY ROOM_DEV NEW_OUT");return 2;}
 build:=args_at(a[..],0);facts:=args_at(a[..],1);room:=args_at(a[..],2);dev:=args_at(a[..],3);out:=args_at(a[..],4);if !fs_mkdir(out) {return 1;}listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 inputs:[3]RtqInputs;paths:[12][4096]u8;manifest:=fs_join(build,"build.json",paths[0][..]);json:[262144]u8;nodes:[8192]JvNode;doc:[1]Jv;
 if !rtq_json_file(manifest,json[..],nodes[..],doc[..]) {return 1;}rows:=jv_get(doc[0],0,"inputs");if jv_kind(doc[0],rows)!=JV_OBJECT {return 1;}
 for i:0..<jv_len(doc[0],rows) {row:=jv_at(doc[0],rows,i);file:=jv_key(doc[0],row);hash:[64]u8;if !rtq_hash_file(file,hash[..])||cast(string)hash[..]!=jv_raw(doc[0],row)||!hlw_add(inputs[..],file) {tool_errln(file);return 1;}}
 self:[4096]u8;self_n:=cxproc_self_path(self[..]);if self_n<1 {return 1;}bin:=fs_join(build,"vk-realm",paths[1][..]);
 for file:[6]string.[cast(string)self[0..<self_n],manifest,bin,facts,room,fs_join(build,"net",paths[2][..])] {if !hlw_add(inputs[..],file) {return 1;}}
 if !hlw_tree(inputs[..],fs_join(build,"render",paths[3][..]),0)||!hlw_tree(inputs[..],fs_join(build,"render-assets",paths[4][..]),0)||!hlw_tree(inputs[..],dev,0) {return 1;}
 listener:=cxsock_listen(0);if listener<0 {return 1;}port:=cxsock_port(listener);closed:=cxsock_close(listener);
 ptext:[32]u8;o:[1]Jo;jo_start(o[..],ptext[..]);jo_int(o[..],port);p:=proc_new();if p<0 {return 1;}
 defer {k:=proc_kill(p,PROC_SIGTERM);w:=proc_wait(p,2000);freed:=proc_release(p);}
 for arg:[12]string.["nice","-n15",room,"--listen","127.0.0.1","--port",jo_text(o[..]),"--dev",dev,"--native-local","--name","host-contract-window"] {if !proc_arg(p,arg) {return 1;}}
 unset:=proc_unset(p,"PORT");env_ok:=proc_env(p,"OA_ROOM_DEV_ADMIN=0");if !unset||!env_ok||proc_start(p)!=0 {return 1;}
 ready:=false;until:=proc_now_ms()+10000;while proc_now_ms()<until {for byte:"127.0.0.1" {pushed:=cxsock_host_push(int(byte));}sock:=cxsock_connect(port,100);if sock>=0 {c:=cxsock_close(sock);ready=true;break;}proc_sleep(20);}if !ready {return 1;}
 origin:[128]u8;jo_start(o[..],origin[..]);jo_put(o[..],"http://127.0.0.1:");jo_int(o[..],port);site:=jo_text(o[..]);
 local:[256]u8;jo_start(o[..],local[..]);jo_put(o[..],"METAVERSE_NATIVE_LOCAL_ROOM=ws://127.0.0.1:");jo_int(o[..],port);
 raw:=fs_join(out,"observed.i64",paths[5][..]);state:=fs_join(out,"state",paths[6][..]);if !fs_mkdir(state) {return 1;}
 argv:=[20]string.["nice","-n15",bin,build,"unused","--facts",facts,"--size","320x180","--window","--seconds","40","--net",state,"--origin",site,"--host-window",raw,"--mute-audio","--audio"];
 env:=[1]string.[jo_text(o[..])];stdout:[1048576]u8;stderr:[1048576]u8;r:=rtq_command(argv[..],env[..],proc_now_ms()+90000,out,"world",stdout[..],stderr[..]);
 killed:=proc_kill(p,PROC_SIGTERM);room_exit:=proc_wait(p,2000);room_n:=cxproc_read_bytes(p,1000,stdout[..]);if room_n>0 {saved:=fs_write(fs_join(out,"room.stdout",paths[7][..]),cast(string)stdout[0..<room_n]);}
 bytes:[712]u8;q:[89]int;if fs_read(raw,bytes[..])!=bytes.count {return 1;}for i:0..<q.count {v:u64;for lane:0..<8 {v|=cast(u64)bytes[i*8+lane]<<(lane*8);}q[i]=cast,trunc(int)v;}
 stable:=true;for i:0..<inputs.count {stable=rtq_inputs_match(inputs[i..<i+1])&&stable;}
 passed:=rtq_ok(r)&&hlwq_accept(q[..])&&stable;record:[1048576]u8;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.linux-window.v1");jo_key(o[..],"passed");jo_bool(o[..],passed);jo_key(o[..],"observations");jo_arr(o[..]);for v:q {jo_int(o[..],v);}jo_end(o[..]);jo_key(o[..],"source_fence");jo_bool(o[..],stable);jo_key(o[..],"input_groups");jo_arr(o[..]);for i:0..<inputs.count {rtq_inputs_json(o[..],inputs[i..<i+1],"");}jo_end(o[..]);jo_end(o[..]);return ifx !o[0].bad&&fs_write(fs_join(out,"receipt.json",paths[8][..]),jo_text(o[..]))&&passed then 0 else 1;
}
