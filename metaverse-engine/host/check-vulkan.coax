// Native Linux realm adapter core probes. Build with build-vulkan.coax;
// all orchestration/expected rows/JSON admission live in Coax.
#import "Basic";
#load "receipt.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
hvn_open :: ()->int #foreign #effects(all);
hvn_memory :: (field:int)->int #foreign #effects(all);
hvn_observe :: (event:int,field:int)->int #foreign #effects(all);
hvn_reset :: () #foreign #effects(all);
hvn_asset :: (index:int,bytes:[]u8) #foreign #effects(all);
hvn_frame :: (w:f32,h:f32,dpr:f32,dt:f32,still:int) #foreign #effects(all);
hvn_key :: (key:int,mods:int,down:int) #foreign #effects(all);
hvn_pointer :: (x:f32,y:f32,phase:int,kind:int,id:int) #foreign #effects(all);
hvn_wheel :: (dy:f32) #foreign #effects(all);
hvn_blur :: () #foreign #effects(all);
hvn_send :: (kind:int,bytes:[]u8) #foreign #effects(all);
hvn_close :: () #foreign #effects(all);
hvn_rows :: (out:[][8]int)->int {
  n:=hvn_observe(-1,2);if n<0 || n>out.count {return -1;}
  for i:0..<n {for k:0..<8 {out[i][k]=hvn_observe(i,k);}}return n;
}
hvn_json_rows :: (o:[]Jo,rows:[][8]int) {jo_arr(o);for row:rows {jo_arr(o);for v:row {jo_int(o,v);}jo_end(o);}jo_end(o);}
tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {tool_errln("usage: check-vulkan OUT_CORE.json");return 2;}
  if hvn_open()!=1 {return 1;}defer {hvn_close();}
  version:=hvn_observe(-1,0);constructed:=hvn_observe(-1,1);
  data:=[4]u8.['A','B','C','D'];hvn_asset(0,data[..]);big:[65]u8;for i:0..<65 {big[i]='z';}hvn_asset(1,big[..]);
  assets:[4][8]int;an:=hvn_rows(assets[..]);hvn_reset();
  hvn_frame(320,180,2,0,1);hvn_frame(320,180,2,1.0f32/64,1);
  frames:[2][8]int;fn:=hvn_rows(frames[..]);hvn_reset();
  hvn_key(-6,15,1);hvn_key(-6,15,0);hvn_key(128578,0,1);hvn_blur();hvn_wheel(32);
  hvn_pointer(25,68.5,0,0,17);hvn_pointer(25,68.5,2,0,17);
  hvn_pointer(14,18,0,1,19);hvn_pointer(14,18,2,1,19);
  utf8:=[7]u8.['A',0xc3,0xa9,0xf0,0x9f,0x99,0x82];hvn_send(901,utf8[..]);overflow:[129]u8;for i:0..<129 {overflow[i]='x';}hvn_send(901,overflow[..]);action:=[4]u8.['h','a','s','h'];hvn_send(900,action[..]);
  events:[13][8]int;en:=hvn_rows(events[..]);dropped:=hvn_observe(-1,3);held:=hvn_observe(-1,5);
  if an<0 || fn<0 || en<0 || !hc_core(version,constructed,dropped,held,assets[0..<an],frames[0..<fn],events[0..<en]) {tool_errln("Native realm core observations differ");return 1;}
  buf:[8192]u8;o:[1]Jo;jo_start(o[..],buf[..]);jo_obj(o[..]);
  jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.observations.v1");jo_key(o[..],"host");jo_str(o[..],"vulkan");jo_key(o[..],"scope");jo_str(o[..],"core");
  jo_key(o[..],"version");jo_int(o[..],version);jo_key(o[..],"constructed");jo_int(o[..],constructed);jo_key(o[..],"dropped");jo_int(o[..],dropped);jo_key(o[..],"held");jo_int(o[..],held);
  jo_key(o[..],"physical_addresses");jo_arr(o[..]);for i:0..<3 {jo_int(o[..],hvn_memory(i));}jo_end(o[..]);
  jo_key(o[..],"assets");hvn_json_rows(o[..],assets[0..<an]);jo_key(o[..],"frames");hvn_json_rows(o[..],frames[0..<fn]);jo_key(o[..],"events");hvn_json_rows(o[..],events[0..<en]);jo_end(o[..]);
  d:[1]Jv;nodes:[512]JvNode;
  if o[0].bad || !jv_parse(d[..],jo_text(o[..]),nodes[..]) || !hcr_core(d[0]) || !fs_write(args_at(a[..],0),jo_text(o[..])) {return 1;}
  print("Native Vulkan realm adapter core dispatch passed; no GPU/audio claim.\n");return 0;
}
