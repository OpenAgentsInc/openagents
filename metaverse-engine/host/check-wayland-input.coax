// Build and exercise the real production Wayland/XKB listeners, with no window/GPU.
#import "Basic";
#load "wayland-input-conformance.coax";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
#test "Wayland SDK flag projection keeps literal words and bounded storage" {
 out:[3]string;#assert hwi_flags(" -I/a\t-lm\n-lxkbcommon ",out[..],0)==3&&out[0]=="-I/a"&&out[2]=="-lxkbcommon";
 #assert hwi_flags("a b c d",out[..],0)== -1;
}
hwi_flags::(text:string,out:[]string,n:int)->int {
 at:=n;from:=0;for i:0..<text.count+1{if i==text.count||text[i]==' '||text[i]=='\n'||text[i]=='\t'{if i>from{if at==out.count{return -1;}out[at]=text[from..<i];at+=1;}from=i+1;}}return at;
}
hwi_receipt::(path:string)->bool {
 bytes:[65536]u8;nodes:[2048]JvNode;d:[1]Jv;if !rtq_json_file(path,bytes[..],nodes[..],d[..]){return false;}
 if jv_raw(d[0],jv_get(d[0],0,"schema"))!="aethyr.host.wayland-input.v1"{return false;}
 list:=jv_get(d[0],0,"rows");if jv_len(d[0],list)!=53{return false;}rows:[212]int;
 for i:0..<53{row:=jv_at(d[0],list,i);if jv_len(d[0],row)!=4{return false;}for k:0..<4{rows[4*i+k]=jv_int(d[0],jv_at(d[0],row,k),-999);}}
 return hwic_accept(rows[..]);
}
tool_main::()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<2||args_count(a[..])>3||(args_count(a[..])==3&&args_at(a[..],2)!="--sanitize")||cxtool_os()!=2{tool_errln("usage: check-wayland-input ROOT NEW_OUT [--sanitize] (Linux, in its declared SDK environment)");return 2;}
 root:=args_at(a[..],0);out:=args_at(a[..],1);sanitize:=args_has(a[..],"--sanitize");if !fs_mkdir(out){return 1;}
 inputs:[1]RtqInputs;paths:[48][4096]u8;stdout:[1048576]u8;stderr:[1048576]u8;env:[]string;compiler_buf:[4096]u8;compiler:=proc_getenv("COAX",compiler_buf[..]);
 if !rtq_input_add(inputs[..],compiler){return 1;}
 for file,i:[10]string.["metaverse-engine/host/wayland-input.coax","metaverse-engine/host/wayland-input-fixture.c","metaverse-engine/host/wayland-input-conformance.coax","metaverse-engine/host/check-wayland-input.coax","metaverse/gpu/vkw.h","metaverse/gpu/wayland-input-sdk.h","metaverse/gpu/vkp.h","metaverse/gpu/vkc.h","metaverse/kms/keys.h","metaverse/kms/realm.h"]{if !rtq_input_add(inputs[..],fs_join(root,file,paths[i][..])){return 1;}}
 source:=fs_join(out,"wayland-input.c",paths[10][..]);header:=fs_join(out,"wayland-input.h",paths[11][..]);timings:=fs_join(out,"coax-timings.json",paths[12][..]);
 emit:=[9]string.[compiler,"c",fs_join(root,"metaverse-engine/host/wayland-input.coax",paths[13][..]),"--library","--header",header,"--timings",timings,""];
 r:=rtq_command(emit[0..<8],env,proc_now_ms()+90000,out,"coax-emit",stdout[..],stderr[..]);if !rtq_ok(r)||!fs_write(source,cast(string)stdout[0..<r.out_n])||!rtq_input_add(inputs[..],source)||!rtq_input_add(inputs[..],header){return 1;}
 query:=[3]string.["pkg-config","--variable=pkgdatadir","wayland-protocols"];r=rtq_command(query[..],env,proc_now_ms()+30000,out,"protocol-dir",stdout[..],stderr[..]);if !rtq_ok(r){return 1;}dir:[4096]u8;pn:=r.out_n;while pn>0&&(stdout[pn-1]==10||stdout[pn-1]==13){pn-=1;}if pn>dir.count{return 1;}for i:0..<pn{dir[i]=stdout[i];}
 protocols:[2]string;
 for spec,i:[2][2]string.[[2]string.["stable/xdg-shell/xdg-shell.xml","xdg-shell"],[2]string.["unstable/xdg-decoration/xdg-decoration-unstable-v1.xml","xdg-decoration-unstable-v1"]]{
  xml:=fs_join(cast(string)dir[0..<pn],spec[0],paths[14+i][..]);if !rtq_input_add(inputs[..],xml){return 1;}
  for suffix,k:[2]string.["-client-protocol.h","-protocol.c"]{name:[128]u8;o:[1]Jo;jo_start(o[..],name[..]);jo_put(o[..],spec[1]);jo_put(o[..],suffix);dest:=fs_join(out,jo_text(o[..]),paths[16+2*i+k][..]);scan:=[4]string.["wayland-scanner",ifx k==0 then "client-header" else "private-code",xml,dest];r=rtq_command(scan[..],env,proc_now_ms()+30000,out,jo_text(o[..]),stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_input_add(inputs[..],dest){return 1;}if k==1{protocols[i]=dest;}}
 }
 pkg:=[5]string.["pkg-config","--cflags","--libs","wayland-client","xkbcommon"];r=rtq_command(pkg[..],env,proc_now_ms()+30000,out,"pkg-config",stdout[..],stderr[..]);if !rtq_ok(r){return 1;}flags:[8192]u8;if r.out_n>flags.count{return 1;}for i:0..<r.out_n{flags[i]=stdout[i];}flag_n:=r.out_n;
 argv:[64]string;n:=0;for flag:[10]string.["nice","-n15","gcc","-std=gnu11",ifx sanitize then "-O1" else "-O2","-g","-ffunction-sections","-fdata-sections","-Wl,--gc-sections","-ffp-contract=off"]{argv[n]=flag;n+=1;}
 if sanitize{argv[n]="-fsanitize=address,undefined";argv[n+1]="-fno-omit-frame-pointer";n+=2;}
 for include:[3]string.[out,fs_join(root,"metaverse/gpu",paths[20][..]),fs_join(root,"metaverse/kms",paths[21][..])]{argv[n]="-I";argv[n+1]=include;n+=2;}
 for file:[4]string.[fs_join(root,"metaverse-engine/host/wayland-input-fixture.c",paths[22][..]),source,protocols[0],protocols[1]]{argv[n]=file;n+=1;}
 n=hwi_flags(cast(string)flags[0..<flag_n],argv[..],n);if n<0{return 1;}binary:=fs_join(out,"fixture",paths[23][..]);for flag:[4]string.["-lvulkan","-lm","-o",binary]{argv[n]=flag;n+=1;}
 r=rtq_command(argv[0..<n],env,proc_now_ms()+180000,out,"sdk-build",stdout[..],stderr[..]);if !rtq_ok(r)||!rtq_input_add(inputs[..],binary){return 1;}
 run:=[4]string.["nice","-n15",binary,fs_join(out,"keymap.txt",paths[26][..])];run_env:=[3]string.["LC_ALL=C.UTF-8","ASAN_OPTIONS=detect_leaks=1:abort_on_error=1","UBSAN_OPTIONS=halt_on_error=1"];
 r=rtq_command(run[..],run_env[..],proc_now_ms()+30000,out,"listener",stdout[..],stderr[..]);observation:=fs_join(out,"observations.json",paths[24][..]);if !rtq_ok(r)||!fs_write(observation,cast(string)stdout[0..<r.out_n])||!hwi_receipt(observation)||!rtq_inputs_match(inputs[..]){tool_errln("Wayland listener observations refused");return 1;}
 record:[65536]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.wayland-input-sources.v1");jo_key(o[..],"sanitize");jo_bool(o[..],sanitize);jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],root);jo_end(o[..]);if o[0].bad||!fs_write(fs_join(out,"sources.json",paths[25][..]),jo_text(o[..])){return 1;}
 print("Actual Wayland/XKB listeners: all53 rows/212 fields passed; sanitizer %.\n",sanitize);return 0;
}
