// Separate small source closures retain their normal compiler profile reports.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=3 {tool_errln("usage: emit-linux-audio-product ROOT COMPILER NEW_OUT");return 2;}
 root:=args_at(a[..],0);compiler:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}
 for source,i:[2]string.["metaverse-engine/host/check-linux-audio-product.coax","metaverse-engine/host/audio-fixture.coax"] {
  base:=[2]string.["NativeAudio","fixture"][i];paths:[4][4096]u8;names:[3][128]u8;code:[16777216]u8;error:[1048576]u8;o:[1]Jo;
  jo_start(o[..],names[0][..]);jo_put(o[..],base);jo_put(o[..],".h");header:=fs_join(out,jo_text(o[..]),paths[0][..]);
  jo_start(o[..],names[1][..]);jo_put(o[..],base);jo_put(o[..],".profile.json");profile:=fs_join(out,ifx i==0 then "profile.json" else jo_text(o[..]),paths[1][..]);
  argv:=[8]string.[compiler,"c",fs_join(root,source,paths[2][..]),"--library","--header",header,"--profile-report",profile];env:[]string;
  r:=rtq_command(argv[..],env,proc_now_ms()+120000,out,base,code[..],error[..]);jo_start(o[..],names[2][..]);jo_put(o[..],base);jo_put(o[..],".c");
  if !rtq_ok(r)||!fs_write(fs_join(out,jo_text(o[..]),paths[3][..]),cast(string)code[0..<r.out_n]) {return 1;}
  if i==0 {if !fs_write(fs_join(out,"ProductCheck.h",paths[3][..]),"#include \"NativeAudio.h\"\n") {return 1;}}
 }return 0;
}
