// Emit only small platform companion closures; the qualified world C cache
// and graphics products are supplied separately and are never re-emitted.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||(args_count(a[..])!=3&&args_count(a[..])!=4)||(args_count(a[..])==4&&args_at(a[..],3)!="--input-only"&&args_at(a[..],3)!="--text-only"&&args_at(a[..],3)!="--session-only") {tool_errln("usage: emit-linux-world-shell ROOT COMPILER NEW_OUT [--input-only|--text-only|--session-only]");return 2;}
 root:=args_at(a[..],0);compiler:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}paths:[5][4096]u8;listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 for spec,unit_index:[8][2]string.[[2]string.["os/verse-panel.coax","verse-panel"],[2]string.["os/verse-hands.coax","verse-hands"],[2]string.["metaverse-engine/host/native-audio.coax","NativeAudio"],[2]string.["verse/native/net.coax","net"],[2]string.["metaverse-engine/host/wayland-input.coax","wayland-input"],[2]string.["metaverse-engine/host/wayland-text.coax","wayland-text"],[2]string.["metaverse-engine/host/linux-window-session.coax","linux-window-session"],[2]string.["metaverse-engine/render/film.coax","film"]] {
  if args_has(a[..],"--input-only")&&unit_index<4 {continue;}
  if args_has(a[..],"--text-only")&&unit_index!=5 {continue;}
  if args_has(a[..],"--session-only")&&unit_index!=6 {continue;}
  // the film profile (#13004) goes with every full emission; vk-realm builds without it too
  names:[3][128]u8;lengths:[3]int;for suffix,i:[3]string.[".c",".h",".profile.json"] {o:[1]Jo;jo_start(o[..],names[i][..]);jo_put(o[..],spec[1]);jo_put(o[..],suffix);lengths[i]=jo_text(o[..]).count;}
  argv:=[8]string.[compiler,"c",fs_join(root,spec[0],paths[0][..]),"--library","--header",fs_join(out,cast(string)names[1][0..<lengths[1]],paths[1][..]),"--profile-report",fs_join(out,cast(string)names[2][0..<lengths[2]],paths[2][..])];
  env:[]string;stdout:[16777216]u8;stderr:[1048576]u8;r:=rtq_command(argv[..],env,proc_now_ms()+240000,out,spec[1],stdout[..],stderr[..]);if !rtq_ok(r)||!fs_write(fs_join(out,cast(string)names[0][0..<lengths[0]],paths[3][..]),cast(string)stdout[0..<r.out_n]) {return 1;}
 }return 0;
}
