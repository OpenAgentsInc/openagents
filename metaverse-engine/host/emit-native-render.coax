// Bounded CPU facade emission. Shader products and their admission stay
// separate; this writes the compiler's real profile and original C/header.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<3||args_count(a[..])>4||(args_count(a[..])==4&&args_at(a[..],3)!="--textures-only"&&args_at(a[..],3)!="--host-only") {tool_errln("usage: emit-native-render PREPARED_ROOT ORIGINAL_COMPILER NEW_OUT [--textures-only|--host-only]");return 2;}
 root:=args_at(a[..],0);compiler:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}paths:[4][4096]u8;listing:[1]FsList;if fs_list(out,listing[..])!=0 {return 2;}
 for spec,i:[2][4]string.[[4]string.["metaverse-engine/render/host/native-host.coax","RenderHost.c","RenderHost.h","emission-profile.json"],[4]string.["metaverse-engine/render/native-images.coax","RenderTexture.c","RenderTexture.h","texture-emission-profile.json"]] {
  if i==0&&args_has(a[..],"--textures-only") {continue;}
  if i==1&&args_has(a[..],"--host-only") {continue;}
  argv:=[8]string.[compiler,"c",fs_join(root,spec[0],paths[0][..]),"--library","--header",fs_join(out,spec[2],paths[1][..]),"--profile-report",fs_join(out,spec[3],paths[2][..])];env:[]string;code:[16777216]u8;error:[1048576]u8;
  r:=rtq_command(argv[..],env,proc_now_ms()+180000,out,spec[1],code[..],error[..]);if !rtq_ok(r)||!fs_write(fs_join(out,spec[1],paths[3][..]),cast(string)code[0..<r.out_n]) {return 1;}
 }return 0;
}
