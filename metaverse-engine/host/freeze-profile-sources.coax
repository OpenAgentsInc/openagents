// Copy and hash the actual successful compiler profile's product sources.
// This records artifacts; it never writes a compiler admission receipt.
#import "Basic";
#load "../render/tests/qualification-files.coax";
#load "../../coax/lib/sys/args.coax";
fps_relative :: (root:string,path:string)->string {
 if path.count<=root.count||path[0..<root.count]!=root||path[root.count]!='/' {return "";}
 relative:=path[root.count+1..<path.count];at:=0;for i:0..<relative.count+1 {if i==relative.count||relative[i]=='/' {part:=relative[at..<i];if part==""||part=="."||part==".." {return "";}at=i+1;}}return relative;
}
#test "profile source copies remain inside the exact observed root" {
 #assert fps_relative("/root","/root/a/b.coax")=="a/b.coax";
 for path:[6]string.["/root","/root-other/a","/root/../a","/root//a","/root/./a","a.coax"] {#assert fps_relative("/root",path)=="";}
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=3 {tool_errln("usage: freeze-profile-sources ROOT PROFILE NEW_OUT");return 2;}
 root:=args_at(a[..],0);profile:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out) {return 1;}bytes:[2097152]u8;nodes:[32768]JvNode;doc:[1]Jv;if !rtq_json_file(profile,bytes[..],nodes[..],doc[..]) {return 1;}
 d:=doc[0];if jv_kind(d,jv_get(d,0,"success"))!=JV_TRUE {return 1;}rows:=jv_get(d,0,"sources");if jv_kind(d,rows)!=JV_ARRAY||jv_len(d,rows)<1 {return 1;}
 held:[1]RtqInputs;source:[8388608]u8;paths:[3][4096]u8;record:[262144]u8;o:[1]Jo;jo_start(o[..],record[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"aethyr.host.frozen-profile-sources.v1");jo_key(o[..],"sources");jo_obj(o[..]);
 for i:0..<jv_len(d,rows) {row:=jv_at(d,rows,i);path:[4096]u8;n:=jv_str(d,jv_get(d,row,"path"),path[..]);if n<1 {return 1;}original:=cast(string)path[0..<n];relative:=fps_relative(root,original);hash:[64]u8;if relative.count==0||!rtq_hash_file(original,hash[..])||jv_raw(d,jv_get(d,row,"sha256"))!=cast(string)hash[..]||!rtq_input_add(held[..],original) {return 1;}
  dest:=fs_join(out,relative,paths[0][..]);length:=fs_read(original,source[..]);if length<0||!fs_mkdir(fs_dir(dest))||!fs_write(dest,cast(string)source[0..<length]) {return 1;}
  copied:[64]u8;if !rtq_hash_file(dest,copied[..])||cast(string)copied[..]!=cast(string)hash[..] {return 1;}jo_key(o[..],relative);jo_str(o[..],cast(string)hash[..]);
 }
 jo_end(o[..]);jo_key(o[..],"source_count");jo_int(o[..],jv_len(d,rows));jo_key(o[..],"source_fence_unchanged");stable:=rtq_inputs_match(held[..]);jo_bool(o[..],stable);jo_end(o[..]);return ifx stable&&!o[0].bad&&fs_write(fs_join(out,"frozen-sources.json",paths[1][..]),jo_text(o[..])) then 0 else 1;
}
