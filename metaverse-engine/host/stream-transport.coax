// Bind a concrete streamed resource attempt to its authenticated whole source.
// Effects remain owned until the SDK joins; wanted-state publication stays in
// resource-stream.coax at the paid step boundary.
#authority;
#load "transport-manifest.coax";
#load "../world/resource-stream.coax";
ST_SOURCE_BYTES :: 32768; // The carrier's actual retained configuration span.
StreamTransportRun :: struct {live:bool;checked:bool;key:ResourceLoadKey;}
StreamTransport :: struct {phase:int;scene:assets.AssetId;manifest:[1]HptManifest;runs:[RESOURCE_MANIFEST_MAX]StreamTransportRun;}

#test "transport binds actual scene and original manifest before starting effects" #steps 200000000 {
  m:=resource_manifest_fixture(1);m.valid=true;m.identity=assets.asset_id("stream-transport-manifest");
  scene:="actual-scene";p:=HptManifest.{valid=true,count=1,scene=assets.asset_id(scene),manifest=m.identity};
  p.entries[0]=HptSource.{status=HptStatus.ok,raw=true,container=m.entries[0].plan.content,content=m.entries[0].plan.content,container_bytes=4,bytes=4};
  wire:[208]u8;#assert hpt_write(p,m,wire[..])==HptManifestStatus.ok;
  hex:[64]u8;#assert assets.asset_hex(assets.asset_id(cast(string) wire[..]),hex[..]);
  s:[1]StreamTransport;#assert !st_open(s[..],m,wire[..],cast(string) hex[..]) && s[0].phase==0;
  #assert !st_scene(s[..],scene,"bad") && s[0].phase==0;
  wrong:[64]u8;#assert assets.asset_hex(assets.asset_id("other scene"),wrong[..]);
  #assert !st_scene(s[..],scene,cast(string) wrong[..]) && s[0].phase==0;
  #assert assets.asset_hex(p.scene,wrong[..]);#assert st_scene(s[..],scene,cast(string) wrong[..]) && s[0].phase==1;
  #assert !st_scene(s[..],scene,cast(string) wrong[..]);
  #assert !st_open(s[..],m,wire[..],"bad") && s[0].phase==1;
  bad:=m;bad.valid=false;#assert !st_open(s[..],bad,wire[..],cast(string) hex[..]) && s[0].phase==1;
  bad=m;bad.identity.words[0]^=1;#assert !st_open(s[..],bad,wire[..],cast(string) hex[..]);
  bad=m;bad.entries[0].plan.spec.backend=ResourceBackend.vulkan;#assert !st_open(s[..],bad,wire[..],cast(string) hex[..]);
  damaged:=wire;damaged[0]^=1;#assert !st_open(s[..],m,damaged[..],cast(string) hex[..]);
  other:=p;other.scene=assets.asset_id("other scene");#assert hpt_write(other,m,damaged[..])==HptManifestStatus.ok;
  #assert assets.asset_hex(assets.asset_id(cast(string) damaged[..]),wrong[..]);#assert !st_open(s[..],m,damaged[..],cast(string) wrong[..]);
  #assert st_open(s[..],m,wire[..],cast(string) hex[..]) && s[0].phase==2 && assets.asset_same(s[0].manifest[0].identity,assets.asset_id(cast(string) wire[..]));
  #assert !st_open(s[..],m,wire[..],cast(string) hex[..]);
  #assert st_drained(s[..]) && st_close(s[..]) && s[0].phase==3 && !st_close(s[..]);
  #assert !st_scene(s[..],scene,cast(string) wrong[..]) && !st_open(s[..],m,wire[..],cast(string) hex[..]);
}
#test "transport requires the exact live loading key and every location field" {
  m:=resource_manifest_fixture(1);m.valid=true;
  p:=HptSource.{status=HptStatus.ok,raw=true,container=m.entries[0].plan.content,content=m.entries[0].plan.content,container_bytes=4,bytes=4};
  s:[1]StreamTransport;s[0].phase=2;s[0].manifest[0]=HptManifest.{valid=true,count=1};s[0].manifest[0].entries[0]=p;
  k:=ResourceLoadKey.{owner=0,generation=1,epoch=7,content=p.content};o:=ResourceOwner.{phase=ResourceOwnerPhase.loading,generation=1,content=p.content};
  #assert st_idle(s[..],0) && !st_idle(s[..], -1) && !st_idle(s[..],1);
  for field:0..<11 {bad:=p;
    if field==0 {bad.status=HptStatus.invalid;}if field==1 {bad.raw=false;}if field==2 {bad.container.words[0]^=1;}if field==3 {bad.content.words[0]^=1;}
    if field==4 {bad.container_bytes=5;}if field==5 {bad.offset=1;}if field==6 {bad.bytes=3;}
    key:=k;if field==7 {key.content.words[0]^=1;}if field==8 {key.generation=2;}if field==9 {key.epoch=8;}if field==10 {key.owner=1;}
    #assert !st_begin(s[..],o,7,true,key,bad) && st_idle(s[..],0);
  }
  #assert !st_begin(s[..],o,7,false,k,p);bad_o:=o;bad_o.phase=ResourceOwnerPhase.loaded;#assert !st_begin(s[..],bad_o,7,true,k,p);
  bad_o=o;bad_o.content.words[0]^=1;#assert !st_begin(s[..],bad_o,7,true,k,p);
  bad_k:=k;bad_k.owner= -1;#assert !st_begin(s[..],o,7,true,bad_k,p);
  bad_k=k;bad_k.generation=0;bad_o=o;bad_o.generation=0;#assert !st_begin(s[..],bad_o,7,true,bad_k,p);
  bad_k=k;bad_k.epoch=0;#assert !st_begin(s[..],o,0,true,bad_k,p);
  s[0].phase=1;#assert !st_begin(s[..],o,7,true,k,p) && !st_idle(s[..],0) && !st_drained(s[..]);s[0].phase=2;
  #assert st_begin(s[..],o,7,true,k,p) && st_live(s[..],k) && !st_checked(s[..],k) && !st_idle(s[..],0) && !st_drained(s[..]);
  #assert !st_begin(s[..],o,7,true,k,p) && !st_close(s[..]);
  #assert !st_end(s[..],k,false,false) && st_live(s[..],k);
  #assert !st_end(s[..],k,true,true) && st_live(s[..],k);
  bad_k=k;bad_k.content.words[0]^=1;#assert !st_live(s[..],bad_k) && !st_end(s[..],bad_k,true,false);
  bad_k=k;bad_k.generation+=1;#assert !st_live(s[..],bad_k) && !st_end(s[..],bad_k,true,false);
  bad_k=k;bad_k.epoch+=1;#assert !st_live(s[..],bad_k) && !st_end(s[..],bad_k,true,false);
  bad_k=k;bad_k.owner= -1;#assert !st_live(s[..],bad_k);
  // Hostile hidden slots make both bounds observable without relying on a trap.
  hidden:=s;bad_k=k;bad_k.owner=1;hidden[0].runs[1]=StreamTransportRun.{live=true,key=bad_k};#assert !st_live(hidden[..],bad_k);
  hidden=s;hidden[0].phase=1;#assert !st_live(hidden[..],k);
  #assert st_end(s[..],k,true,false) && !st_end(s[..],k,true,false) && st_idle(s[..],0);
  fresh:=k;fresh.generation=2;o.generation=2;#assert st_begin(s[..],o,7,true,fresh,p);
  #assert !st_end(s[..],k,true,false) && st_live(s[..],fresh);
  #assert st_end(s[..],fresh,true,false) && st_close(s[..]) && !st_live(s[..],fresh);
}
#test "SDK hex projection admits only exact complete location identities and raw flags" {
  m:=resource_manifest_fixture(1);p:=HptSource.{status=HptStatus.ok,raw=true,container=m.entries[0].plan.content,content=m.entries[0].plan.content,container_bytes=4,bytes=4};
  s:[1]StreamTransport;s[0].phase=2;s[0].manifest[0]=HptManifest.{valid=true,count=1};s[0].manifest[0].entries[0]=p;
  k:=ResourceLoadKey.{owner=0,generation=1,epoch=1,content=p.content};o:=ResourceOwner.{phase=ResourceOwnerPhase.loading,generation=1,content=p.content};hex:[64]u8;#assert assets.asset_hex(p.content,hex[..]);text:=cast(string) hex[..];
  for raw:[2]int.[-1,2] {#assert !st_begin_hex(s[..],o,1,true,k,text,text,0,4,raw);}
  #assert !st_begin_hex(s[..],o,1,true,k,"bad",text,0,4,1) && !st_begin_hex(s[..],o,1,true,k,text,"bad",0,4,1);
  bad:=k;bad.owner=1;#assert !st_begin_hex(s[..],o,1,true,bad,text,text,0,4,1);
  #assert !st_begin_hex(s[..],o,1,true,k,text,text,0,4,0) && !st_begin_hex(s[..],o,1,true,k,text,text,1,4,1) && !st_begin_hex(s[..],o,1,true,k,text,text,0,3,1);
  #assert st_begin_hex(s[..],o,1,true,k,text,text,0,4,1) && !st_begin_hex(s[..],o,1,true,k,text,text,0,4,1) && st_end(s[..],k,true,false);
  p.raw=false;p.container_bytes=512;s[0].manifest[0].entries[0]=p;
  for raw:[2]int.[-1,2] {#assert !st_begin_hex(s[..],o,1,true,k,text,text,0,4,raw);}
  #assert st_begin_hex(s[..],o,1,true,k,text,text,0,4,0) && st_end(s[..],k,true,false);
}
#test "whole source validation precedes decode and cannot clear a newer attempt" #steps 200000000 {
  storage:[512]u8;wire:=pack_test(600,storage[..]);read:[1]PackRead;#assert pack_read(wire,read[..]);entry:=read[0].entries[2];
  plan:=resource_plan(storage[entry.at..<entry.at+entry.n],ResourceSpec.{format=ResourceFormat.indices});
  m:=resource_manifest_fixture(1);m.valid=true;m.identity=assets.asset_id("bound-manifest");m.entries[0].plan=plan;
  p:=hpt_source(storage[..],plan,entry.at,false);#assert p.status==HptStatus.ok;
  s:[1]StreamTransport;s[0].phase=2;s[0].manifest[0]=HptManifest.{valid=true,count=1,manifest=m.identity};s[0].manifest[0].entries[0]=p;
  k:=ResourceLoadKey.{owner=0,generation=1,epoch=1,content=plan.content};o:=ResourceOwner.{phase=ResourceOwnerPhase.loading,generation=1,content=plan.content};
  #assert !st_source(s[..],m,k,storage[..]);#assert st_begin(s[..],o,1,true,k,p);
  bad_m:=m;bad_m.valid=false;#assert !st_source(s[..],bad_m,k,storage[..]);bad_m=m;bad_m.identity.words[0]^=1;#assert !st_source(s[..],bad_m,k,storage[..]);
  bad_m=m;bad_m.count=2;#assert !st_source(s[..],bad_m,k,storage[..]);
  bad_k:=k;bad_k.generation=2;#assert !st_source(s[..],m,bad_k,storage[..]);
  bad:=storage;bad[0]^=1;#assert !st_source(s[..],m,k,bad[..]) && !st_checked(s[..],k);
  bad=storage;bad[entry.at]^=1;#assert !st_source(s[..],m,k,bad[..]);
  // Even an admitted change outside the resource must match the whole root.
  bad=storage;bad[511]^=1;#assert !st_source(s[..],m,k,bad[..]);
  #assert st_source(s[..],m,k,storage[..]) && st_checked(s[..],k) && !st_source(s[..],m,k,storage[..]);
  #assert !st_end(s[..],k,false,true) && st_checked(s[..],k);
  #assert st_end(s[..],k,true,true) && !st_checked(s[..],k) && st_drained(s[..]);
  k.generation=2;o.generation=2;#assert st_begin(s[..],o,1,true,k,p);
  old:=k;old.generation=1;#assert !st_source(s[..],m,old,storage[..]) && !st_end(s[..],old,true,false) && st_live(s[..],k);
  #assert st_end(s[..],k,true,false) && st_drained(s[..]);
}
#test "carrier accepts every row through its exact source span limit" #steps 200000000 {
  m:=resource_manifest_fixture(64);m.valid=true;scene:="bounded-scene";
  p:=HptManifest.{valid=true,count=64,scene=assets.asset_id(scene)};
  for i:0..<64 {p.entries[i]=HptSource.{status=HptStatus.ok,container=m.entries[i].plan.content,content=m.entries[i].plan.content,container_bytes=32768,bytes=4};}
  wire:[HPT_BYTES]u8;#assert hpt_write(p,m,wire[..])==HptManifestStatus.ok;hex:[64]u8;scene_hex:[64]u8;#assert assets.asset_hex(p.scene,scene_hex[..]);
  s:[1]StreamTransport;#assert st_scene(s[..],scene,cast(string) scene_hex[..]);
  p.entries[63].container_bytes=32769;#assert hpt_write(p,m,wire[..])==HptManifestStatus.ok && assets.asset_hex(assets.asset_id(cast(string) wire[..]),hex[..]);
  #assert !st_open(s[..],m,wire[..],cast(string) hex[..]) && s[0].phase==1;
  p.entries[63].container_bytes=32768;#assert hpt_write(p,m,wire[..])==HptManifestStatus.ok && assets.asset_hex(assets.asset_id(cast(string) wire[..]),hex[..]);
  #assert st_open(s[..],m,wire[..],cast(string) hex[..]);
  for i:0..<64 {k:=ResourceLoadKey.{owner=i,generation=9223372036854775807,epoch=9223372036854775807,content=p.entries[i].content};o:=ResourceOwner.{phase=ResourceOwnerPhase.loading,generation=k.generation,content=k.content};#assert st_begin(s[..],o,k.epoch,true,k,p.entries[i]);}
  #assert !st_idle(s[..],64) && !st_drained(s[..]) && !st_close(s[..]);
  for i:0..<64 {#assert st_end(s[..],s[0].runs[i].key,true,false);}
  #assert st_drained(s[..]) && st_close(s[..]);
}

st_same :: (a:HptSource,b:HptSource)->bool #effects(all) {
  return a.status==HptStatus.ok && b.status==HptStatus.ok && a.raw==b.raw && assets.asset_same(a.container,b.container) && assets.asset_same(a.content,b.content) && a.container_bytes==b.container_bytes && a.offset==b.offset && a.bytes==b.bytes;
}
st_scene :: (s:[]StreamTransport,bytes:string,hex:string)->bool #export_c #effects(all) {
  if s[0].phase!=0 {return false;}root:[1]assets.AssetId;
  if !assets.asset_parse(hex,root[..]) || !assets.asset_same(assets.asset_id(bytes),root[0]) {return false;}
  s[0].scene=root[0];s[0].phase=1;return true;
}
st_open :: (s:[]StreamTransport,m:ResourceManifest,bytes:[]u8,hex:string)->bool #export_c #effects(all) {
  if s[0].phase!=1 || !m.valid {return false;}root:[1]assets.AssetId;parsed:[1]HptManifest;
  if !assets.asset_parse(hex,root[..]) || hpt_read(bytes,root[0],s[0].scene,m,parsed[..])!=HptManifestStatus.ok {return false;}
  for i:0..<m.count {if m.entries[i].plan.spec.backend!=ResourceBackend.browser || parsed[0].entries[i].container_bytes>ST_SOURCE_BYTES {return false;}}
  s[0].manifest[0]=parsed[0];s[0].phase=2;return true;
}
st_idle :: (s:[]StreamTransport,row:int)->bool #export_c #effects(all) {return s[0].phase==2 && row>=0 && row<s[0].manifest[0].count && !s[0].runs[row].live;}
st_live :: (s:[]StreamTransport,k:ResourceLoadKey)->bool #export_c #effects(all) {
  if s[0].phase!=2 || k.owner<0 || k.owner>=s[0].manifest[0].count {return false;}
  r:=s[0].runs[k.owner];return r.live && r.key.generation==k.generation && r.key.epoch==k.epoch && assets.asset_same(r.key.content,k.content);
}
st_checked :: (s:[]StreamTransport,k:ResourceLoadKey)->bool #export_c #effects(all) {return st_live(s,k) && s[0].runs[k.owner].checked;}
st_begin :: (s:[]StreamTransport,owner:ResourceOwner,epoch:int,wanted:bool,k:ResourceLoadKey,location:HptSource)->bool #export_c #effects(all) {
  if !st_idle(s,k.owner) || !wanted || owner.phase!=ResourceOwnerPhase.loading || k.generation<1 || k.epoch<1 || owner.generation!=k.generation || epoch!=k.epoch || !assets.asset_same(owner.content,k.content) {return false;}
  p:=s[0].manifest[0].entries[k.owner];if !assets.asset_same(k.content,p.content) || !st_same(p,location) {return false;}
  s[0].runs[k.owner]=StreamTransportRun.{live=true,key=k};return true;
}
st_begin_hex :: (s:[]StreamTransport,owner:ResourceOwner,epoch:int,wanted:bool,k:ResourceLoadKey,container:string,content:string,offset:int,bytes:int,raw:int)->bool #export_c #effects(all) {
  if !st_idle(s,k.owner) || raw<0 || raw>1 {return false;}a:[1]assets.AssetId;b:[1]assets.AssetId;
  if !assets.asset_parse(container,a[..]) || !assets.asset_parse(content,b[..]) {return false;}
  return st_begin(s,owner,epoch,wanted,k,HptSource.{status=HptStatus.ok,raw=raw==1,container=a[0],content=b[0],container_bytes=s[0].manifest[0].entries[k.owner].container_bytes,offset=offset,bytes=bytes});
}
st_source :: (s:[]StreamTransport,m:ResourceManifest,k:ResourceLoadKey,bytes:[]u8)->bool #export_c #effects(all) {
  if !st_live(s,k) || s[0].runs[k.owner].checked || !m.valid || m.count!=s[0].manifest[0].count || !assets.asset_same(m.identity,s[0].manifest[0].manifest) {return false;}
  p:=s[0].manifest[0].entries[k.owner];if !st_same(hpt_source(bytes,m.entries[k.owner].plan,p.offset,p.raw),p) {return false;}
  s[0].runs[k.owner].checked=true;return true;
}
st_end :: (s:[]StreamTransport,k:ResourceLoadKey,joined:bool,success:bool)->bool #export_c #effects(all) {
  if !st_live(s,k) || !joined || (success && !s[0].runs[k.owner].checked) {return false;}
  s[0].runs[k.owner]=StreamTransportRun.{};return true;
}
st_drained :: (s:[]StreamTransport)->bool #export_c #effects(all) {
  if s[0].phase!=2 {return false;}for i:0..<s[0].manifest[0].count {if s[0].runs[i].live {return false;}}return true;
}
st_close :: (s:[]StreamTransport)->bool #export_c #effects(all) {if !st_drained(s) {return false;}s[0].phase=3;return true;}
