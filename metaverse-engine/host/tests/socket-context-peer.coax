// Finite private physical-peer fixture. No production cookies or credentials.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/proc.coax";
#load "../../../coax/lib/json/json.coax";
#load "../../../coax/lib/net/socket_foreign.coax";
#load "../../../coax/lib/net/ws_server.coax";
#test "physical opening header observations preserve a single exact field" {
 #assert hcp_field("GET / HTTP/1.1\r\nOrigin: x\r\nCookie: a=b\r\n\r\n","origin")=="x";
 #assert hcp_field("GET / HTTP/1.1\r\nOrigin: x\r\norigin: y\r\n\r\n","origin")=="duplicate";
 #assert hcp_field("GET / HTTP/1.1\r\n\r\n","cookie")=="";
}
hcp_field :: (head:string,name:string)->string {
 at:=wss_cr(head)+2;value:="";found:=false;
 while at<head.count {end:=at;while end<head.count&&head[end]!='\r'{end+=1;}if end==at{break;}line:=head[at..<end];colon:=-1;for b,i:line{if b==':'&&colon<0{colon=i;}}
  if colon>0&&ws_ieq(line[0..<colon],name){if found{return "duplicate";}value=ws_trim(line[colon+1..<line.count]);found=true;}at=end+2;
 }return value;
}
hcp_path :: (raw:string)->string {at:=4;while at<raw.count&&raw[at]!=' '{at+=1;}return ifx at>=4&&raw.count>=4 then raw[4..<at] else "";}
hcp_send :: (h:int,bytes:string)->bool {for b:bytes{if cxsock_write(h,int(b))!=0{return false;}}return cxsock_flush(h,500)==0;}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=1{return 2;}report:=args_at(a[..],0);listener:=cxsock_listen(9172);if listener<0{return 1;}defer{closed:=cxsock_close(listener);}
 bytes:[32768]u8;records:[1]Jo;jo_start(records[..],bytes[..]);jo_arr(records[..]);deadline:=cxsock_now_ms()+120000;
 while cxsock_now_ms()<deadline {
  h:=cxsock_accept(listener,0);if h<0{proc_sleep(1);continue;}
  input:[16384]u8;used:=0;end:=cxsock_now_ms()+2000;
  while cxsock_now_ms()<end&&ws_find_end(cast(string)input[0..<used])==0 {n:=cxsock_read(h,50);if n< -2||n== -1{break;}if n>input.count-used{break;}if n>0{for i:0..<n{input[used+i]=u8(cxsock_byte(h,i));}used+=n;}}
  raw:=cast(string)input[0..<used];if ws_find_end(raw)==0{closed:=cxsock_close(h);continue;}
  path:=hcp_path(raw);origin:=hcp_field(raw,"origin");cookie:=hcp_field(raw,"cookie");out:[16384]u8;accepted:=0;
  if path=="/health" {n:=wss_http_write("200 OK","text/plain","ok",out[..]);sent:=hcp_send(h,cast(string)out[0..<n]);closed:=cxsock_close(h);continue;}
  if path=="/seed" {accepted=2;sent:=hcp_send(h,"HTTP/1.1 200 OK\r\nContent-Length: 4\r\nSet-Cookie: auth=one; Path=/auth; HttpOnly\r\nSet-Cookie: other=two; Path=/other\r\nSet-Cookie: secure=three; Path=/auth; Secure\r\nSet-Cookie: expired=gone; Path=/auth; Expires=Thu, 01 Jan 1970 00:00:00 GMT\r\nConnection: close\r\n\r\nseed");}
  else {
   hello:=wss_request(raw);expected:=ifx path=="/other" then "other=two" else ifx path=="/host" then "" else "auth=one";
   if hello.status==WSS_OK&&origin=="http://127.0.0.1:9172"&&cookie==expected {accepted=1;n:=wss_accept_write(raw[hello.key_from..<hello.key_to],out[..]);sent:=hcp_send(h,cast(string)out[0..<n]);n=wss_frame_write(WS_OP_TEXT,"authenticated",out[..]);sent=hcp_send(h,cast(string)out[0..<n]);n=wss_close_write(1000,out[..]);sent=hcp_send(h,cast(string)out[0..<n]);}
   else {n:=wss_http_write("401 Unauthorized","text/plain","refused",out[..]);sent:=hcp_send(h,cast(string)out[0..<n]);}
  }
  closed:=cxsock_close(h);jo_obj(records[..]);for pair:[3][2]string.[[2]string.["path",path],[2]string.["origin",origin],[2]string.["cookie",cookie]]{jo_key(records[..],pair[0]);jo_str(records[..],pair[1]);}jo_key(records[..],"accepted");jo_int(records[..],accepted);jo_end(records[..]);
  snapshot:=records[0];jo_end(records[..]);if records[0].bad||!fs_write(report,jo_text(records[..])){return 1;}records[0]=snapshot;
 }return 0;
}
