// IFC (ISO 10303-21, the STEP text form) to a ple-scene.v1 scene, in Coax (GitHub #13812). A PLE
// run's deliverable is often an IFC model (output/model.ifc, or artifacts/<task>/.../model.ifc), and
// the Gym and ple-run show scenes. tools/ple-ifc-to-scene.py does this with ifcopenshell, which a Mac
// rarely has; this needs nothing.
//
// What it reads. Every product (an entity whose ObjectPlacement is an IFCLOCALPLACEMENT and whose
// Representation an IFCPRODUCTDEFINITIONSHAPE) but the site, building, storey, spaces and openings.
// Its placement chain (IFCAXIS2PLACEMENT3D: location, axis, ref direction) is followed to the world.
// Its 'Body' representation (else 'Box', else the first) gives its solids:
//   IFCEXTRUDEDAREASOLID of a rectangle, a circle (a cylinder along the extrusion), or any closed
//     profile (its 2D box: IFCPOLYLINE, IFCINDEXEDPOLYCURVE)
//   IFCBOUNDINGBOX, IFCTRIANGULATEDFACESET and IFCPOLYGONALFACESET (the box of their points)
//   IFCBOOLEANRESULT and IFCBOOLEANCLIPPINGRESULT (the first operand), IFCMAPPEDITEM (its map,
//     placed by its target)
// One solid keeps its orientation when the scene can say it: a box or cylinder turned about z only
// (rot_z), a cylinder lying along a horizontal direction (axis "x" and rot_z). Anything else, and a
// product of several solids, is the box around it in world axes. The length unit is the model's
// IFCSIUNIT (metre, with its prefix); out comes metres.
//
// The layer is the class's: walls, slabs, columns and the like are architecture; furniture racks;
// pipes chw_pipe; ducts, air handlers and chillers crah; distribution boards, transformers and
// switches pdu; cable carriers tray; cable segments busway; fire terminals sprinklers; a proxy by
// its name when that says (rack, pdu, crah, pipe, tray, busway, sprinkler), else tray.
#load "ple-scene-out.coax";

PLE_IFC_DEPTH :: 32;                  // placements and mapped items followed at most this deep

PleIfcEnt :: struct { id: int; name_from: int; name_to: int; args_from: int; args_to: int; }
PleIfc :: struct {
  text: string;
  ents: [] PleIfcEnt;
  n: int;
  table: [] int;                      // id hash: entity index + 1, 0 empty
  scale: f32;                         // metres per model length unit
  dropped: int;                       // entities past ents' room
}
// A span of text: one argument, or a list's item.
PleIfcSpan :: struct { from: int; to: int; }
// An orthonormal frame: origin and axes in its parent.
PleIfcFrame :: struct { o: Point; x: Point; y: Point; z: Point; }
// A solid as a box in a frame: centred on f.o, half sizes along f.x, f.y, f.z. round: a cylinder
// along f.z, with diameters 2 half.x and 2 half.y.
PleIfcSolid :: struct { f: PleIfcFrame; half: Point; round: bool; ok: bool; }
// What ple_ifc_scene read.
PleIfcStats :: struct { products: int; kept: int; no_shape: int; boxed: int; dropped: int; }

ple_ifc_identity :: () -> PleIfcFrame { return PleIfcFrame.{x = v3(1.0, 0.0, 0.0), y = v3(0.0, 1.0, 0.0), z = v3(0.0, 0.0, 1.0)}; }
// p (in b's parent) seen from a's parent: a after b.
ple_ifc_apply :: (a: PleIfcFrame, p: Point) -> Point { return add(a.o, add(times(a.x, p.x), add(times(a.y, p.y), times(a.z, p.z)))); }
ple_ifc_turn :: (a: PleIfcFrame, d: Point) -> Point { return add(times(a.x, d.x), add(times(a.y, d.y), times(a.z, d.z))); }
ple_ifc_compose :: (a: PleIfcFrame, b: PleIfcFrame) -> PleIfcFrame {
  return PleIfcFrame.{o = ple_ifc_apply(a, b.o), x = ple_ifc_turn(a, b.x), y = ple_ifc_turn(a, b.y), z = ple_ifc_turn(a, b.z)};
}

// ---- the STEP text

ple_ifc_at :: (t: string, k: int, c: u8) -> bool { return k < t.count && t[k] == c; }
ple_ifc_space :: (c: u8) -> bool { return c == ' ' || c == 10 || c == 13 || c == 9; }
ple_ifc_digit :: (c: u8) -> bool { return c >= '0' && c <= '9'; }
ple_ifc_upper :: (c: u8) -> bool { return c >= 'A' && c <= 'Z'; }
ple_ifc_spaces_to :: (t: string, i: int, to: int) -> int { k := i; while k < to && ple_ifc_space(t[k]) { k += 1; } return k; }
// Past a quoted string starting at i (its opening quote). STEP's '' (a quote inside) reads as the
// string ending and another starting, which skips the same text. Past the end when it is open.
ple_ifc_past_string :: (t: string, i: int) -> int {
  k := i + 1;
  while k < t.count && t[k] != 39 { k += 1; }
  return k + 1;
}
// Past a /* comment */ starting at i (an open one runs to the end).
ple_ifc_past_comment :: (t: string, i: int) -> int {
  k := i + 2;
  while k + 1 < t.count {   // mutant: equivalent (k + 2: only a */ closing the text is then not seen, and t.count is where it ends)
    if t[k] == '*' && t[k + 1] == '/' { return k + 2; }
    k += 1;
  }
  return t.count;
}
// The table is open addressing on the id itself (ids count up from 1, so they spread), probing up;
// it always has an empty slot (more slots than entities).
ple_ifc_put :: (f: [] PleIfc, id: int, index: int) {
  cap := f[0].table.count;
  for k: 0..<cap {
    slot := (id + k) & (cap - 1);   // mutant: equivalent (any probe order that visits every slot finds a free one, and ple_ifc_find walks the same)
    if f[0].table[slot] == 0 { f[0].table[slot] = index + 1; return; }
  }
}
// The entity #id's index, or -1.
ple_ifc_find :: (f: [] PleIfc, id: int) -> int {
  cap := f[0].table.count;
  for k: 0..<cap {
    slot := (id + k) & (cap - 1);   // mutant: equivalent (as in ple_ifc_put)
    e := f[0].table[slot];
    if e == 0 { return -1; }
    if f[0].ents[e - 1].id == id { return e - 1; }
  }
  return -1;   // mutant: equivalent (not reached: an empty slot ends the walk first)
}

// Reads text's entities into f: every "#id=NAME(args);" outside a quoted string or a comment (ents
// and table are f's room; table.count a power of two, more than ents.count). The header's records
// have no #id, so they are passed over. False when text is not a STEP file or an entity is cut short.
ple_ifc_index :: (text: string, ents: [] PleIfcEnt, table: [] int, f: [] PleIfc) -> bool {
  f[0] = PleIfc.{text = text, ents = ents, table = table, scale = 1.0};
  if table.count <= ents.count || (table.count & (table.count - 1)) != 0 { return false; }
  for k: 0..<table.count { table[k] = 0; }
  if text.count < 13 || cast(string) text[0..<13] != "ISO-10303-21;" { return false; }
  i := 13;
  while i < text.count {
    c := text[i];
    if c == '/' && ple_ifc_at(text, i + 1, '*') { i = ple_ifc_past_comment(text, i); continue; }
    if c == 39 { i = ple_ifc_past_string(text, i); continue; }
    if c != '#' { i += 1; continue; }
    // #id = NAME ( args ) ;
    k := i + 1; id := 0;
    while k < text.count && ple_ifc_digit(text[k]) { id = id * 10 + cast(int) (text[k] - '0'); k += 1; }
    k = ple_ifc_spaces_to(text, k, text.count);
    if !ple_ifc_at(text, k, '=') { i = k; continue; }
    k = ple_ifc_spaces_to(text, k + 1, text.count);
    nf := k;
    while k < text.count && (ple_ifc_upper(text[k]) || ple_ifc_digit(text[k]) || text[k] == '_') { k += 1; }
    nt := k;
    k = ple_ifc_spaces_to(text, k, text.count);
    if !ple_ifc_at(text, k, '(') || nt == nf { i = k; continue; }
    af := k + 1; depth := 0;
    while k < text.count {
      ch := text[k];
      if ch == 39 { k = ple_ifc_past_string(text, k); continue; }
      if ch == '(' { depth += 1; }
      else if ch == ')' { depth -= 1; if depth == 0 { break; } }
      k += 1;
    }
    if k >= text.count { return false; }   // an entity cut short
    if f[0].n < ents.count && id > 0 && ple_ifc_find(f, id) < 0 {
      ents[f[0].n] = PleIfcEnt.{id = id, name_from = nf, name_to = nt, args_from = af, args_to = k};
      ple_ifc_put(f, id, f[0].n);
      f[0].n += 1;
    } else { f[0].dropped += 1; }
    i = k;
  }
  f[0].scale = ple_ifc_unit(f);
  return true;
}

ple_ifc_name :: (f: [] PleIfc, e: int) -> string { x := f[0].ents[e]; return cast(string) f[0].text[x.name_from..<x.name_to]; }
ple_ifc_args :: (f: [] PleIfc, e: int) -> PleIfcSpan { x := f[0].ents[e]; return PleIfcSpan.{from = x.args_from, to = x.args_to}; }
ple_ifc_is :: (f: [] PleIfc, e: int, name: string) -> bool { return e >= 0 && ple_ifc_name(f, e) == name; }
// The end of the value that starts at i (before to): the next comma outside parentheses and strings.
ple_ifc_value_end :: (t: string, i: int, to: int) -> int {
  k := i; depth := 0;
  while k < to {
    c := t[k];
    if c == 39 { k = ple_ifc_past_string(t, k); continue; }
    if c == '(' { depth += 1; }
    else if c == ')' { depth -= 1; }
    else if c == ',' && depth == 0 { return k; }
    k += 1;
  }
  return to;
}
// The kth comma-separated value of span s (an entity's args, or a list's inside), trimmed; to < from when missing.
ple_ifc_item :: (f: [] PleIfc, s: PleIfcSpan, k: int) -> PleIfcSpan {
  t := f[0].text;
  i := ple_ifc_spaces_to(t, s.from, s.to);
  for j: 0..<k { i = ple_ifc_spaces_to(t, ple_ifc_value_end(t, i, s.to) + 1, s.to); }
  if i >= s.to { return PleIfcSpan.{to = -1}; }
  b := ple_ifc_value_end(t, i, s.to);
  while b > i && ple_ifc_space(t[b - 1]) { b -= 1; }
  return PleIfcSpan.{from = i, to = b};
}
ple_ifc_arg :: (f: [] PleIfc, e: int, k: int) -> PleIfcSpan { return ple_ifc_item(f, ple_ifc_args(f, e), k); }
// A list value's inside: "(a,b)" without its parentheses; to < from when s is not a list.
ple_ifc_inside :: (f: [] PleIfc, s: PleIfcSpan) -> PleIfcSpan {
  if s.to - s.from < 2 || f[0].text[s.from] != '(' || f[0].text[s.to - 1] != ')' { return PleIfcSpan.{to = -1}; }   // mutant: equivalent (a shorter span fails the parentheses anyway; the length keeps the reads inside)
  return PleIfcSpan.{from = s.from + 1, to = s.to - 1};
}
ple_ifc_count :: (f: [] PleIfc, list: PleIfcSpan) -> int {
  n := 0;
  while ple_ifc_item(f, list, n).to >= ple_ifc_item(f, list, n).from { n += 1; }
  return n;
}
ple_ifc_text :: (f: [] PleIfc, s: PleIfcSpan) -> string {
  return ifx s.to < s.from then "" else cast(string) f[0].text[s.from..<s.to];   // mutant: equivalent (an empty span's text is "" either way)
}
// #id's entity index, or -1 (not a reference, or no such entity).
ple_ifc_ref :: (f: [] PleIfc, s: PleIfcSpan) -> int {
  t := ple_ifc_text(f, s);
  if t.count < 2 || t[0] != '#' { return -1; }
  id := 0;
  for k: 1..<t.count { if !ple_ifc_digit(t[k]) { return -1; } id = id * 10 + cast(int) (t[k] - '0'); }
  return ple_ifc_find(f, id);
}
// A STEP real or integer ("1.", "-2.5E-3", "7"), or a typed one ("IFCLENGTHMEASURE(2.)"); ok false
// otherwise. STEP's "1." and "1.E4" are JSON's "1.0" and "1.0E4" with a 0 after the fraction, and
// ple_parse_f64_ok reads that.
ple_ifc_num :: (f: [] PleIfc, s: PleIfcSpan, ok: [] bool) -> f64 {
  t := ple_ifc_text(f, s);
  a := 0; b := t.count;
  while a < b && ple_ifc_upper(t[a]) { a += 1; }
  if a > 0 && ple_ifc_at(t, a, '(') && t[b - 1] == ')' { a += 1; b -= 1; } else { a = 0; }
  ok[0] = false;
  if b - a > 48 { return 0; }   // mutant: equivalent (49 or more is past what ple_parse_f64_ok takes)
  buf: [50] u8; n := 0; dot := false;
  for k: a..<b {
    c := t[k];
    if dot && (c == 'E' || c == 'e') { buf[n] = '0'; n += 1; dot = false; }
    buf[n] = c; n += 1;
    if c == '.' { dot = true; }
  }
  if dot { buf[n] = '0'; n += 1; }
  v: [1] f64;
  ok[0] = ple_parse_f64_ok(cast(string) buf[0..<n], v[..]);
  return v[0];
}
ple_ifc_f :: (f: [] PleIfc, s: PleIfcSpan, fallback: f32) -> f32 {
  ok: [1] bool; v := ple_ifc_num(f, s, ok[..]);
  return ifx ok[0] then cast(f32) v else fallback;
}

// ---- points, directions, placements

// An IFCCARTESIANPOINT's or IFCDIRECTION's coordinates (a missing z is 0), or fallback.
ple_ifc_point :: (f: [] PleIfc, e: int, fallback: Point) -> Point {
  if !ple_ifc_is(f, e, "IFCCARTESIANPOINT") && !ple_ifc_is(f, e, "IFCDIRECTION") { return fallback; }
  l := ple_ifc_inside(f, ple_ifc_arg(f, e, 0));
  return v3(ple_ifc_f(f, ple_ifc_item(f, l, 0), 0.0), ple_ifc_f(f, ple_ifc_item(f, l, 1), 0.0), ple_ifc_f(f, ple_ifc_item(f, l, 2), 0.0));
}
// A frame at o with z along z_dir and x along x_dir made square to it (when x_dir is along z: the
// world x, or y when z is near x).
ple_ifc_frame_from :: (o: Point, z_dir: Point, x_dir: Point) -> PleIfcFrame {
  z := unit_or(z_dir, v3(0.0, 0.0, 1.0));
  xr := sub(x_dir, times(z, dot(x_dir, z)));
  if !(length(xr) > 0.000001) {   // mutant: equivalent (a length of exactly 1e-6)
    xr = ifx abs(z.x) < 0.9 then v3(1.0, 0.0, 0.0) else v3(0.0, 1.0, 0.0);   // mutant: equivalent (|z.x| exactly 0.9)
    xr = sub(xr, times(z, dot(xr, z)));
  }
  x := unit_or(xr, v3(1.0, 0.0, 0.0));
  return PleIfcFrame.{o = o, x = x, y = cross(z, x), z = z};
}
// IFCAXIS2PLACEMENT3D (location, axis, ref direction) or IFCAXIS2PLACEMENT2D (location, ref direction).
ple_ifc_axes :: (f: [] PleIfc, e: int) -> PleIfcFrame {
  if ple_ifc_is(f, e, "IFCAXIS2PLACEMENT3D") {
    o := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 0)), v3(0.0, 0.0, 0.0));
    z := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 1)), v3(0.0, 0.0, 1.0));
    x := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 2)), v3(1.0, 0.0, 0.0));
    return ple_ifc_frame_from(o, z, x);
  }
  if ple_ifc_is(f, e, "IFCAXIS2PLACEMENT2D") {
    o := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 0)), v3(0.0, 0.0, 0.0));
    x := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 1)), v3(1.0, 0.0, 0.0));
    return ple_ifc_frame_from(v3(o.x, o.y, 0.0), v3(0.0, 0.0, 1.0), v3(x.x, x.y, 0.0));
  }
  return ple_ifc_identity();
}
// An IFCLOCALPLACEMENT in the world: its PlacementRelTo's, then its own.
ple_ifc_placement :: (f: [] PleIfc, e: int, depth: int) -> PleIfcFrame {
  if !ple_ifc_is(f, e, "IFCLOCALPLACEMENT") || depth > PLE_IFC_DEPTH { return ple_ifc_identity(); }
  parent := ple_ifc_ref(f, ple_ifc_arg(f, e, 0));
  own := ple_ifc_axes(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 1)));
  if parent < 0 { return own; }
  return ple_ifc_compose(ple_ifc_placement(f, parent, depth + 1), own);
}
// IFCCARTESIANTRANSFORMATIONOPERATOR3D (axis1, axis2, origin, scale, axis3): a frame (scale ignored).
ple_ifc_operator :: (f: [] PleIfc, e: int) -> PleIfcFrame {
  if !ple_ifc_is(f, e, "IFCCARTESIANTRANSFORMATIONOPERATOR3D") && !ple_ifc_is(f, e, "IFCCARTESIANTRANSFORMATIONOPERATOR3DNONUNIFORM") { return ple_ifc_identity(); }
  x := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 0)), v3(1.0, 0.0, 0.0));
  o := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 2)), v3(0.0, 0.0, 0.0));
  z := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 4)), v3(0.0, 0.0, 1.0));
  return ple_ifc_frame_from(o, z, x);
}
// Metres per length unit: the project's IFCSIUNIT for length (.MILLI. .CENTI. .DECI. .KILO. prefixes), else 1.
ple_ifc_unit :: (f: [] PleIfc) -> f32 {
  for e: 0..<f[0].n {
    if !ple_ifc_is(f, e, "IFCSIUNIT") || ple_ifc_text(f, ple_ifc_arg(f, e, 1)) != ".LENGTHUNIT." { continue; }
    p := ple_ifc_text(f, ple_ifc_arg(f, e, 2));
    if p == ".MILLI." { return 0.001; }
    if p == ".CENTI." { return 0.01; }
    if p == ".DECI." { return 0.1; }
    if p == ".KILO." { return 1000.0; }
    return 1.0;
  }
  return 1.0;
}

// ---- solids

// The 2D box of a profile's outer curve: IFCPOLYLINE's points or IFCINDEXEDPOLYCURVE's point list.
ple_ifc_curve_box :: (f: [] PleIfc, e: int, lo2: [] Point, hi2: [] Point) -> bool {
  lo2[0] = v3(1000000.0, 1000000.0, 0.0); hi2[0] = v3(-1000000.0, -1000000.0, 0.0);
  n := 0;
  if ple_ifc_is(f, e, "IFCPOLYLINE") {
    l := ple_ifc_inside(f, ple_ifc_arg(f, e, 0));
    for k: 0..<ple_ifc_count(f, l) {
      p := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_item(f, l, k)), v3(0.0, 0.0, 0.0));
      lo2[0] = v3(lo(lo2[0].x, p.x), lo(lo2[0].y, p.y), 0.0); hi2[0] = v3(hi(hi2[0].x, p.x), hi(hi2[0].y, p.y), 0.0); n += 1;
    }
  } else if ple_ifc_is(f, e, "IFCINDEXEDPOLYCURVE") {
    pl := ple_ifc_ref(f, ple_ifc_arg(f, e, 0));
    if !ple_ifc_is(f, pl, "IFCCARTESIANPOINTLIST2D") { return false; }
    l := ple_ifc_inside(f, ple_ifc_arg(f, pl, 0));
    for k: 0..<ple_ifc_count(f, l) {
      q := ple_ifc_inside(f, ple_ifc_item(f, l, k));
      x := ple_ifc_f(f, ple_ifc_item(f, q, 0), 0.0); y := ple_ifc_f(f, ple_ifc_item(f, q, 1), 0.0);
      lo2[0] = v3(lo(lo2[0].x, x), lo(lo2[0].y, y), 0.0); hi2[0] = v3(hi(hi2[0].x, x), hi(hi2[0].y, y), 0.0); n += 1;
    }
  }
  return n > 1;
}
// The box of a list of 3D points (IFCCARTESIANPOINTLIST3D's), as a solid in its frame.
ple_ifc_points_solid :: (f: [] PleIfc, list: PleIfcSpan) -> PleIfcSolid {
  l := ple_ifc_inside(f, list); n := ple_ifc_count(f, l);
  if n == 0 { return PleIfcSolid.{}; }
  mn := v3(1000000.0, 1000000.0, 1000000.0); mx := v3(-1000000.0, -1000000.0, -1000000.0);
  for k: 0..<n {
    q := ple_ifc_inside(f, ple_ifc_item(f, l, k));
    p := v3(ple_ifc_f(f, ple_ifc_item(f, q, 0), 0.0), ple_ifc_f(f, ple_ifc_item(f, q, 1), 0.0), ple_ifc_f(f, ple_ifc_item(f, q, 2), 0.0));
    mn = v3(lo(mn.x, p.x), lo(mn.y, p.y), lo(mn.z, p.z)); mx = v3(hi(mx.x, p.x), hi(mx.y, p.y), hi(mx.z, p.z));
  }
  c := times(add(mn, mx), 0.5);
  fr := ple_ifc_identity(); fr.o = c;
  return PleIfcSolid.{f = fr, half = times(sub(mx, mn), 0.5), ok = true};
}
// One representation item as a solid in the representation's frame.
ple_ifc_solid :: (f: [] PleIfc, e: int, depth: int) -> PleIfcSolid {
  if e < 0 || depth > PLE_IFC_DEPTH { return PleIfcSolid.{}; }
  nm := ple_ifc_name(f, e);
  if nm == "IFCEXTRUDEDAREASOLID" || nm == "IFCEXTRUDEDAREASOLIDTAPERED" {
    pe := ple_ifc_ref(f, ple_ifc_arg(f, e, 0));
    pos := ple_ifc_axes(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 1)));
    dir := unit_or(ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 2)), v3(0.0, 0.0, 1.0)), v3(0.0, 0.0, 1.0));
    depth_v := ple_ifc_f(f, ple_ifc_arg(f, e, 3), 0.0);
    if pe < 0 || !(depth_v > 0) { return PleIfcSolid.{}; }
    // the profile: its 2D frame (Position, arg 2 of the parametrised ones) and half sizes
    pn := ple_ifc_name(f, pe);
    p2 := ple_ifc_identity(); hx: f32 = 0; hy: f32 = 0; is_round := false;
    if pn == "IFCRECTANGLEPROFILEDEF" || pn == "IFCROUNDEDRECTANGLEPROFILEDEF" || pn == "IFCRECTANGLEHOLLOWPROFILEDEF" {
      p2 = ple_ifc_axes(f, ple_ifc_ref(f, ple_ifc_arg(f, pe, 2)));
      hx = ple_ifc_f(f, ple_ifc_arg(f, pe, 3), 0.0) * 0.5; hy = ple_ifc_f(f, ple_ifc_arg(f, pe, 4), 0.0) * 0.5;
    } else if pn == "IFCCIRCLEPROFILEDEF" || pn == "IFCCIRCLEHOLLOWPROFILEDEF" {
      p2 = ple_ifc_axes(f, ple_ifc_ref(f, ple_ifc_arg(f, pe, 2)));
      hx = ple_ifc_f(f, ple_ifc_arg(f, pe, 3), 0.0); hy = hx; is_round = true;
    } else if pn == "IFCARBITRARYCLOSEDPROFILEDEF" || pn == "IFCARBITRARYPROFILEDEFWITHVOIDS" {
      lo2: [1] Point; hi2: [1] Point;
      if !ple_ifc_curve_box(f, ple_ifc_ref(f, ple_ifc_arg(f, pe, 2)), lo2[..], hi2[..]) { return PleIfcSolid.{}; }
      p2.o = times(add(lo2[0], hi2[0]), 0.5); hx = (hi2[0].x - lo2[0].x) * 0.5; hy = (hi2[0].y - lo2[0].y) * 0.5;
    } else { return PleIfcSolid.{}; }
    if !(hx > 0) || !(hy > 0) { return PleIfcSolid.{}; }
    // the swept box: the profile's frame, pushed half the depth along the direction; a slanted
    // sweep is the box around it (its frame's z the direction, its sides the profile's)
    swept := PleIfcFrame.{o = add(p2.o, times(dir, depth_v * 0.5)), x = p2.x, y = p2.y, z = v3(0.0, 0.0, 1.0)};
    half := v3(hx, hy, depth_v * 0.5);
    if abs(dir.z) < 0.9999 {   // mutant: equivalent (|dir.z| exactly 0.9999)
      swept.z = dir;
      if is_round { return PleIfcSolid.{}; }   // a slanted cylinder: not a shape the scene has
    }
    return PleIfcSolid.{f = ple_ifc_compose(pos, swept), half = half, round = is_round, ok = true};
  }
  if nm == "IFCBOUNDINGBOX" {
    c := ple_ifc_point(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 0)), v3(0.0, 0.0, 0.0));
    half := v3(ple_ifc_f(f, ple_ifc_arg(f, e, 1), 0.0) * 0.5, ple_ifc_f(f, ple_ifc_arg(f, e, 2), 0.0) * 0.5, ple_ifc_f(f, ple_ifc_arg(f, e, 3), 0.0) * 0.5);
    if !(half.x > 0) || !(half.y > 0) || !(half.z > 0) { return PleIfcSolid.{}; }
    fr := ple_ifc_identity(); fr.o = add(c, half);
    return PleIfcSolid.{f = fr, half = half, ok = true};
  }
  if nm == "IFCTRIANGULATEDFACESET" || nm == "IFCPOLYGONALFACESET" {
    pl := ple_ifc_ref(f, ple_ifc_arg(f, e, 0));
    if !ple_ifc_is(f, pl, "IFCCARTESIANPOINTLIST3D") { return PleIfcSolid.{}; }
    return ple_ifc_points_solid(f, ple_ifc_arg(f, pl, 0));
  }
  if nm == "IFCBOOLEANRESULT" || nm == "IFCBOOLEANCLIPPINGRESULT" {
    return ple_ifc_solid(f, ple_ifc_ref(f, ple_ifc_arg(f, e, 1)), depth + 1);
  }
  return PleIfcSolid.{};
}

// A solid's world box, folded into mn/mx: its centre and, on each world axis, the reach of its sides.
ple_ifc_fold :: (s: PleIfcSolid, mn: [] Point, mx: [] Point) {
  x := s.f.x; y := s.f.y; z := s.f.z; h := s.half;
  r := v3(abs(x.x) * h.x + abs(y.x) * h.y + abs(z.x) * h.z, abs(x.y) * h.x + abs(y.y) * h.y + abs(z.y) * h.z, abs(x.z) * h.x + abs(y.z) * h.y + abs(z.z) * h.z);
  p := sub(s.f.o, r); q := add(s.f.o, r);
  mn[0] = v3(lo(mn[0].x, p.x), lo(mn[0].y, p.y), lo(mn[0].z, p.z)); mx[0] = v3(hi(mx[0].x, q.x), hi(mx[0].y, q.y), hi(mx[0].z, q.z));
}
// The solids of a representation's items, placed by at: the count, the first in one[0], their world box in mn/mx.
ple_ifc_items :: (f: [] PleIfc, rep: int, at: PleIfcFrame, one: [] PleIfcSolid, mn: [] Point, mx: [] Point, depth: int) -> int {
  if depth > PLE_IFC_DEPTH { return 0; }   // mutant: equivalent (one map deeper holds only solids ple_ifc_solid refuses at that depth)
  items := ple_ifc_inside(f, ple_ifc_arg(f, rep, 3));
  n := 0;
  for k: 0..<ple_ifc_count(f, items) {
    item := ple_ifc_ref(f, ple_ifc_item(f, items, k));
    if ple_ifc_is(f, item, "IFCMAPPEDITEM") {
      rmap := ple_ifc_ref(f, ple_ifc_arg(f, item, 0));
      inner := ple_ifc_ref(f, ple_ifc_arg(f, rmap, 1));
      if !ple_ifc_is(f, rmap, "IFCREPRESENTATIONMAP") || !ple_ifc_is(f, inner, "IFCSHAPEREPRESENTATION") { continue; }
      origin := ple_ifc_axes(f, ple_ifc_ref(f, ple_ifc_arg(f, rmap, 0)));
      target := ple_ifc_operator(f, ple_ifc_ref(f, ple_ifc_arg(f, item, 1)));
      sub_one: [1] PleIfcSolid;
      m := ple_ifc_items(f, inner, ple_ifc_compose(at, ple_ifc_compose(target, origin)), sub_one[..], mn, mx, depth + 1);
      if n == 0 { one[0] = sub_one[0]; }
      n += m;
      continue;
    }
    s := ple_ifc_solid(f, item, depth);
    if !s.ok { continue; }
    s.f = ple_ifc_compose(at, s.f);
    ple_ifc_fold(s, mn, mx);
    if n == 0 { one[0] = s; }
    n += 1;
  }
  return n;
}
PLE_IFC_REP_SKIPPED :: [4] string.["Axis", "FootPrint", "Annotation", "Profile"];
ple_ifc_rep_skipped :: (ident: string) -> bool { for k: 0..<PLE_IFC_REP_SKIPPED.count { if ident == PLE_IFC_REP_SKIPPED[k] { return true; } } return false; }
// A product's shape representation to use: 'Body', else 'Box', else the first that is not an axis,
// footprint, annotation or profile; -1 when none.
ple_ifc_body :: (f: [] PleIfc, shape: int) -> int {
  reps := ple_ifc_inside(f, ple_ifc_arg(f, shape, 2));
  best := -1; best_rank: int;
  for k: 0..<ple_ifc_count(f, reps) {
    r := ple_ifc_ref(f, ple_ifc_item(f, reps, k));
    if !ple_ifc_is(f, r, "IFCSHAPEREPRESENTATION") { continue; }
    ident := ple_ifc_unquote(ple_ifc_text(f, ple_ifc_arg(f, r, 1)));
    if ple_ifc_rep_skipped(ident) { continue; }
    rank := ifx ident == "Body" then 0 else ifx ident == "Box" then 1 else 2;   // mutant: equivalent (the last rank: any above Box's orders the same)
    if best < 0 || rank < best_rank { best = r; best_rank = rank; }
  }
  return best;
}

// ---- products to elements

// The lower case of an ASCII name, into buf (cut to its room).
ple_ifc_lower :: (s: string, buf: [] u8) -> string {
  n := ifx s.count < buf.count then s.count else buf.count;   // mutant: equivalent (s.count == buf.count copies as many either way)
  for k: 0..<n { buf[k] = ifx ple_ifc_upper(s[k]) then s[k] + 32 else s[k]; }
  return cast(string) buf[0..<n];
}
// The layer a product of class cls (upper case, IFC...) and name goes in: the first class part it
// has, else the first name part (any case), else tray.
PLE_IFC_CLASS_PARTS :: [29] string.["SLAB", "WALL", "COLUMN", "BEAM", "ROOF", "DOOR", "WINDOW", "COVERING", "PLATE", "MEMBER", "RAILING", "STAIR", "FOOTING",
  "FURNI", "PIPE", "DUCT", "UNITARY", "CHILLER", "FAN", "AIRTERMINAL", "COIL", "FIRE", "SPRINKLER", "CABLECARRIER", "CABLESEGMENT",
  "ELECTRIC", "TRANSFORMER", "SWITCH", "DISTRIBUTION"];
PLE_IFC_CLASS_LAYERS :: [29] PleLayer.[PleLayer.architecture, PleLayer.architecture, PleLayer.architecture, PleLayer.architecture, PleLayer.architecture,
  PleLayer.architecture, PleLayer.architecture, PleLayer.architecture, PleLayer.architecture, PleLayer.architecture, PleLayer.architecture,
  PleLayer.architecture, PleLayer.architecture, PleLayer.racks, PleLayer.chw_pipe, PleLayer.crah, PleLayer.crah, PleLayer.crah, PleLayer.crah,
  PleLayer.crah, PleLayer.crah, PleLayer.sprinklers, PleLayer.sprinklers, PleLayer.tray, PleLayer.busway, PleLayer.pdu, PleLayer.pdu,
  PleLayer.pdu, PleLayer.pdu];
PLE_IFC_NAME_PARTS :: [16] string.["rack", "cabinet", "pdu", "switchboard", "panel", "crah", "crac", "ahu", "pipe", "busway", "feeder", "sprinkler",
  "wall", "slab", "column", "floor"];
PLE_IFC_NAME_LAYERS :: [16] PleLayer.[PleLayer.racks, PleLayer.racks, PleLayer.pdu, PleLayer.pdu, PleLayer.pdu, PleLayer.crah, PleLayer.crah,
  PleLayer.crah, PleLayer.chw_pipe, PleLayer.busway, PleLayer.busway, PleLayer.sprinklers, PleLayer.architecture, PleLayer.architecture,
  PleLayer.architecture, PleLayer.architecture];
ple_ifc_layer :: (cls: string, name: string) -> PleLayer {
  for k: 0..<PLE_IFC_CLASS_PARTS.count { if ple_has_substr(cls, PLE_IFC_CLASS_PARTS[k]) { return PLE_IFC_CLASS_LAYERS[k]; } }
  b: [128] u8; low := ple_ifc_lower(name, b[..]);
  for k: 0..<PLE_IFC_NAME_PARTS.count { if ple_has_substr(low, PLE_IFC_NAME_PARTS[k]) { return PLE_IFC_NAME_LAYERS[k]; } }
  return PleLayer.tray;
}
// The products that are not things in the room.
PLE_IFC_SKIPPED :: [9] string.["IFCSITE", "IFCBUILDING", "IFCBUILDINGSTOREY", "IFCSPACE", "IFCOPENINGELEMENT", "IFCANNOTATION", "IFCGRID", "IFCVIRTUALELEMENT", "IFCPROJECT"];
ple_ifc_skipped :: (cls: string) -> bool { for k: 0..<PLE_IFC_SKIPPED.count { if cls == PLE_IFC_SKIPPED[k] { return true; } } return false; }
// A string value without its quotes ('' stays as is), or "".
ple_ifc_unquote :: (s: string) -> string {
  if s.count < 2 || s[0] != 39 || s[s.count - 1] != 39 { return ""; }   // mutant: equivalent (the one two-quote string, '', is "" either way)
  return cast(string) s[1..<s.count - 1];
}
ple_ifc_upright :: (d: Point) -> bool { return abs(d.z) > 0.999; }   // mutant: equivalent (|d.z| exactly 0.999)
// A box standing on side up: centre o, horizontal side p (its rot_z) of half size hp, the other hq, height hz.
ple_ifc_stand :: (o: Point, p: Point, hp: f32, hq: f32, hz: f32, scale: f32, out: [] PleElement) -> bool {
  out[0].center = times(o, scale);
  out[0].size = v3(hp * 2.0 * scale, hq * 2.0 * scale, hz * 2.0 * scale);
  out[0].rot_z = atan2(p.y, p.x);
  return true;
}
// The scene element for a solid in metres (scale) into out[0] (a box in world axes when it comes):
// kept oriented when the scene can say it, true; else the box around it (mn/mx), false.
ple_ifc_element :: (s: PleIfcSolid, mn: Point, mx: Point, single: bool, scale: f32, out: [] PleElement) -> bool {
  if single && s.round {
    a := s.f.z; d := s.half.x * 2.0 * scale; along := s.half.z * 2.0 * scale;
    if ple_ifc_upright(a) {
      out[0].shape = PleShape.cylinder; out[0].center = times(s.f.o, scale); out[0].size = v3(d, d, along); out[0].rot_z = atan2(s.f.x.y, s.f.x.x);
      return true;
    }
    if abs(a.z) < 0.001 {   // mutant: equivalent (|a.z| exactly 0.001) -- lying down: along x, turned about z to its direction
      out[0].shape = PleShape.cylinder; out[0].axis = PleAxis.x; out[0].center = times(s.f.o, scale); out[0].size = v3(along, d, d); out[0].rot_z = atan2(a.y, a.x);
      return true;
    }
  }
  if single && !s.round {
    if ple_ifc_upright(s.f.z) { return ple_ifc_stand(s.f.o, s.f.x, s.half.x, s.half.y, s.half.z, scale, out); }
    if ple_ifc_upright(s.f.x) { return ple_ifc_stand(s.f.o, s.f.y, s.half.y, s.half.z, s.half.x, scale, out); }
    if ple_ifc_upright(s.f.y) { return ple_ifc_stand(s.f.o, s.f.z, s.half.z, s.half.x, s.half.y, scale, out); }
  }
  out[0].center = times(times(add(mn, mx), 0.5), scale);
  out[0].size = times(sub(mx, mn), scale);
  return false;
}

// The scene of an indexed model f: its products as elements (the first PLE_MAX_ELEMENTS), bounds
// around them, task named, run unscored (score 0) and gates schema only.
ple_ifc_scene :: (f: [] PleIfc, task: string, sc: [] PleScene, st: [] PleIfcStats) -> bool {
  if sc.count < 1 || st.count < 1 { return false; }
  sc[0] = PleScene.{};
  st[0] = PleIfcStats.{dropped = f[0].dropped};
  sc[0].version = ple_make_text64(PLE_SCENE_VERSION); sc[0].task = ple_make_text64(task); sc[0].units = ple_make_text64("meters");
  sc[0].run = PleRun.{gates = PleGates.{schema = true}};
  bmn := v3(1000000.0, 1000000.0, 1000000.0); bmx := v3(-1000000.0, -1000000.0, -1000000.0);
  for e: 0..<f[0].n {
    place := ple_ifc_ref(f, ple_ifc_arg(f, e, 5));
    shape := ple_ifc_ref(f, ple_ifc_arg(f, e, 6));
    cls := ple_ifc_name(f, e);
    if !ple_ifc_is(f, place, "IFCLOCALPLACEMENT") || !ple_ifc_is(f, shape, "IFCPRODUCTDEFINITIONSHAPE") || ple_ifc_skipped(cls) { continue; }
    st[0].products += 1;
    rep := ple_ifc_body(f, shape);
    one: [1] PleIfcSolid; mn := [1] Point.[v3(1000000.0, 1000000.0, 1000000.0)]; mx := [1] Point.[v3(-1000000.0, -1000000.0, -1000000.0)];
    n := ifx rep < 0 then 0 else ple_ifc_items(f, rep, ple_ifc_placement(f, place, 0), one[..], mn[..], mx[..], 0);
    if n == 0 { st[0].no_shape += 1; continue; }
    if sc[0].element_count >= PLE_MAX_ELEMENTS { continue; }
    name := ple_ifc_unquote(ple_ifc_text(f, ple_ifc_arg(f, e, 2)));
    gid := ple_ifc_unquote(ple_ifc_text(f, ple_ifc_arg(f, e, 0)));
    // the class as the schema spells it: Ifc and the rest as the file has it (IFCWALL: IfcWALL)
    cb: [64] u8; cn := 0;
    for k: 0..<cls.count { if cn < cb.count { cb[cn] = ifx k > 0 && k < 3 then cls[k] + 32 else cls[k]; cn += 1; } }
    el := [1] PleElement.[PleElement.{
      id = ple_make_text64(ifx gid.count > 0 && gid.count <= 64 then gid else "ifc"),
      layer = ple_ifc_layer(cls, name),
      ifc_class = ple_make_text64(cast(string) cb[0..<cn]),
    }];
    if !ple_ifc_element(one[0], mn[0], mx[0], n == 1, f[0].scale, el[..]) { st[0].boxed += 1; }
    mb: [128] u8; mo: [1] Jo; jo_start(mo[..], mb[..]); jo_obj(mo[..]); jo_key(mo[..], "name"); jo_str(mo[..], ifx name.count <= 80 then name else cast(string) name[0..<80]); jo_end(mo[..]);   // mutant: equivalent (a name of exactly 80 is itself cut to 80)
    if !mo[0].bad { el[0].meta = ple_make_text128(jo_text(mo[..])); }
    sc[0].elements[sc[0].element_count] = el[0]; sc[0].element_count += 1; st[0].kept += 1;
    w0 := times(mn[0], f[0].scale); w1 := times(mx[0], f[0].scale);
    bmn = v3(lo(bmn.x, w0.x), lo(bmn.y, w0.y), lo(bmn.z, w0.z)); bmx = v3(hi(bmx.x, w1.x), hi(bmx.y, w1.y), hi(bmx.z, w1.z));
  }
  if sc[0].element_count == 0 { bmn = v3(0.0, 0.0, 0.0); bmx = bmn; }
  sc[0].bounds = PleBounds.{min = bmn, max = bmx};
  return true;
}

// ---- checks

PLE_IFC_SAMPLE :: "ISO-10303-21;\nHEADER;\nFILE_NAME('a;b.ifc','2026-11-20',(''),(''),'','','');\nENDSEC;\nDATA;\n#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);\n#2=IFCCARTESIANPOINT((0.,0.,0.));\n#3=IFCAXIS2PLACEMENT3D(#2,$,$);\n#4=IFCLOCALPLACEMENT($,#3);\n/* the rack: 600 x 1200 x 2200, at (3, 4, 0), turned a quarter */\n#10=IFCCARTESIANPOINT((3000.,4000.,0.));\n#11=IFCDIRECTION((0.,1.,0.));\n#12=IFCAXIS2PLACEMENT3D(#10,$,#11);\n#13=IFCLOCALPLACEMENT(#4,#12);\n#14=IFCRECTANGLEPROFILEDEF(.AREA.,'r',$,600.,1200.);\n#15=IFCDIRECTION((0.,0.,1.));\n#16=IFCEXTRUDEDAREASOLID(#14,$,#15,2200.);\n#17=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#16));\n#18=IFCPRODUCTDEFINITIONSHAPE($,$,(#17));\n#19=IFCFURNISHINGELEMENT('0rack',$,'Rack A1 (it''s; here)',$,$,#13,#18,$);\n/* the pipe: r 100, 10 m along x from (1, 5, 3) */\n#20=IFCCARTESIANPOINT((1000.,5000.,3000.));\n#21=IFCAXIS2PLACEMENT3D(#20,$,$);\n#22=IFCLOCALPLACEMENT(#4,#21);\n#23=IFCCIRCLEPROFILEDEF(.AREA.,$,$,100.);\n#24=IFCDIRECTION((1.,0.,0.));\n#25=IFCDIRECTION((0.,1.,0.));\n#26=IFCAXIS2PLACEMENT3D(#2,#24,#25);\n#27=IFCEXTRUDEDAREASOLID(#23,#26,#15,1.E4);\n#28=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#27));\n#29=IFCSHAPEREPRESENTATION($,'Axis','Curve3D',());\n#30=IFCPRODUCTDEFINITIONSHAPE($,$,(#29,#28));\n#31=IFCPIPESEGMENT('0pipe',$,'CHW',$,$,#22,#30,$,$);\n/* the slab: a polyline 10 x 8 m, 200 deep */\n#40=IFCCARTESIANPOINT((0.,0.));\n#41=IFCCARTESIANPOINT((10000.,0.));\n#42=IFCCARTESIANPOINT((10000.,8000.));\n#43=IFCPOLYLINE((#40,#41,#42,#40));\n#44=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#43);\n#45=IFCEXTRUDEDAREASOLID(#44,$,#15,200.);\n#46=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#45));\n#47=IFCPRODUCTDEFINITIONSHAPE($,$,(#46));\n#48=IFCSLAB('0slab',$,'Floor',$,$,#4,#47,$,.FLOOR.);\n/* a proxy named for a PDU, a mesh; and one of two items, boxed */\n#50=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(800.,0.,0.),(800.,800.,1800.)));\n#51=IFCTRIANGULATEDFACESET(#50,$,$,((1,2,3)),$);\n#52=IFCSHAPEREPRESENTATION($,'