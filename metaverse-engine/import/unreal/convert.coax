// An admitted bundle (bundle.coax) into an imported world: its meshes as welded pack vertices and
// indices, its placements as instance rows, its collision as the engine's colliders, its lights, spots,
// textures, sounds and tables, written as one pack's catalog (the importer's spec, section 5). The tool
// that drives it is metaverse-engine/tools/unreal-level-import.coax; the realm that walks what it writes
// is metaverse-engine/world/imported.coax's reader (the generic imported-world module).
//
// The pack vertex is 48 bytes, CV_WORDS words: position (3 f32), normal (3 f32), UV (2 f32), colour
// (RGBA, 8 bits each, linear), then three zero words. Indices are u32 into the whole vertex entry. A
// mesh is welded: identical vertices of one section are one vertex. A section is one glTF primitive
// (one material slot), positions in the engine's frame (glTF's: axes.coax ua_gltf) after the glTF's
// own node transforms. Every number is from parsed geometry, sorted by id, never Unreal's raw bytes,
// so the same bundle gives the same pack.
//
// The catalog's lines beyond pack.coax's (every other line is a realm's, pack.coax says; M and C lines carry a licence
// in field 4, so colliders are col lines):
//   world 1 NAME                     this format, version 1, and the pack's name
//   title TEXT                       what a realm shows
//   north X Y Z                      the source's north in the engine (axes.coax UA_NORTH)
//   map K ID                         map K (0, 1, ...): its bundle id
//   mat K R G B A LAYER FLAGS [SR SG SB]   material K: linear base colour, its colour layer or -1, flags
//                                    (1 two-sided, 2 masked, 4 unlit, 8 translucent, 16 fallback, 32 two-tone);
//                                    a two-tone material adds its shadow colour: it is the lit colour where
//                                    the key light falls and the shadow colour where it doesn't
//   M NAME FIRST COUNT 0 X0 Y0 Z0 X1 Y1 Z1   section NAME (sN): its indices and its local bounds
//   P MAP SECTION MAT CX CZ QX QY QZ QW TX TY TZ SX SY SZ NAME   an instance of a section, in 64 m
//                                    cell (CX, CZ), sorted by map, section, material, name
//   spawn MAP X Y Z YAW              the map's player start (a level with none is refused)
//   key MAP DX DY DZ R G B I         the direction toward the strongest directional light, its colour
//   light MAP X Y Z R G B I RANGE    a point or spot light, as numbers (CV_LIGHTS a map at most)
//   spot MAP KIND X Y Z YAW NAME     a named spot: player_start, tag or target_point
//   col MAP box X0 Y0 Z0 X1 Y1 Z1 NAME                 an axis-aligned solid (a walker's wall)
//   col MAP hull F LO HI (NX NY NZ D)... NAME          a convex solid: n.p <= d inside every face
//   col MAP floor OX OZ AX AZ BX BZ Y0 YA YB NAME      a flat or sloped parallelogram you stand on
//   col MAP capsule AX AY AZ BX BY BZ R NAME           a capsule
//   fall MAP Y                       below this a walker has fallen out of the world
//   table K ID FORMAT ROWS LINES     table K and its count of X lines that follow
//   X K LINE                         one line of table K, verbatim
// A yaw is radians about +y from +z toward +x, the walker's (metaverse-engine/move/walk.coax).
//   coax/bin/coax test metaverse-engine/import/unreal/convert.coax
#load "../../anim/import-container.coax";
#load "../../anim/gltf-access.coax";
#load "../../render/cel-mesh.coax";
#load "axes.coax";
#load "substitute.coax";
#load "files.coax";

CV_WORDS :: 12;
CV_CELL :: 64.0;                // m: the cells instance rows are grouped by (metaverse-engine/world/cells.coax)
CV_SLACK :: 0.10;               // m a collider may reach outside its visible mesh before it is reported
CV_LIGHTS :: 16;                // point and spot lights a map carries; the rest are listed by brightness
// The limits, shown with every import's counts (no hidden limits):
CV_MESH_TRIANGLES :: 250000;    // a mesh's triangles at most (more needs the cluster path, spec 5.1)
CV_TEXTURE_SIDE :: 4096;        // a texture's side at most
CV_HULL_POINTS :: 64;           // a convex collider's points at most
CV_HULL_FACES :: 32;            // its faces at most

// What a count row counts (read / carried / substituted / skipped / refused).
CV_MESHES :: 0; CV_MATERIALS :: 1; CV_TEXTURES :: 2; CV_SOUNDS :: 3; CV_TABLES :: 4; CV_PLACEMENTS :: 5;
CV_LIGHT_ROWS :: 6; CV_SPOTS :: 7; CV_VOLUMES :: 8; CV_LANDSCAPES :: 9; CV_COLLIDERS :: 10; CV_SKIPPED :: 11; CV_ROWS :: 12;
CV_ROW_NAMES :: [CV_ROWS] string.["meshes", "materials", "textures", "sounds", "tables", "placements", "lights", "spots", "volumes", "landscapes", "colliders", "skipped.json rows"];
CvCount :: struct { read: int; carried: int; substituted: int; skipped: int; refused: int; }

CvSection :: struct { mesh: int; slot: int; first: int; count: int; lo: [3] f32; hi: [3] f32; }
CvMesh :: struct { sections: int; first: int; shape: int; tris: int; lo: [3] f64; hi: [3] f64; done: bool; }
CvMat :: struct { rgba: [4] f32; layer: int = -1; flags: int; shade: [3] f32; }
CvLayer :: struct { texture: int; data: bool; }   // a texture row, carried as a colour or a data layer
CV_TWO_SIDED :: 1; CV_MASKED :: 2; CV_UNLIT :: 4; CV_TRANSLUCENT :: 8; CV_FALLBACK :: 16; CV_TWO_TONE :: 32;

// The geometry being built: caller arrays (the tool's), so nothing here allocates.
CvGeo :: struct {
  verts: [] u32; nv: int; idx: [] u32; ni: int; hash: [] int;
  sections: [] CvSection; ns: int;
  meshes: [] CvMesh;                       // one a bundle mesh row (meshes, then skeletal meshes)
  bad: string;                             // why the last call refused, "" when it didn't
}

// ---- welding

cv_hash :: (w: [] u32) -> int #effects(all) {
  h: u64 = 1469598103934665603;
  for x: w { h = mul_wrap(h ^ cast(u64) x, 1099511628211); }
  return cast(int) (h >> 1);
}
// The index of a vertex (CV_WORDS words), welded against the section that starts at vertex `base`.
cv_vertex :: (g: [] CvGeo, base: int, w: [] u32) -> int #effects(all) {
  size := g[0].hash.count;
  at := cv_hash(w) % size;
  while g[0].hash[at] >= 0 {
    v := g[0].hash[at];
    if v >= base {
      same := true;
      for k: 0..<CV_WORDS { if g[0].verts[v * CV_WORDS + k] != w[k] { same = false; break; } }
      if same { return v; }
    }
    at = (at + 1) % size;
  }
  if (g[0].nv + 1) * CV_WORDS > g[0].verts.count || g[0].nv * 2 >= g[0].hash.count { return -1; }
  v := g[0].nv; for k: 0..<CV_WORDS { g[0].verts[v * CV_WORDS + k] = w[k]; }
  g[0].hash[at] = v; g[0].nv += 1;
  return v;
}
cv_words :: (p: D3, n: D3, u: f64, v: f64, rgba: u32, out: [] u32) #effects(all) {
  out[0] = f32_bits(cast(f32) p.x); out[1] = f32_bits(cast(f32) p.y); out[2] = f32_bits(cast(f32) p.z);
  // -0 and 0 weld: a normal or UV of either sign is the same vertex
  nx := cast(f32) n.x; ny := cast(f32) n.y; nz := cast(f32) n.z; fu := cast(f32) u; fv := cast(f32) v;
  out[3] = f32_bits(nx + 0.0); out[4] = f32_bits(ny + 0.0); out[5] = f32_bits(nz + 0.0); out[6] = f32_bits(fu + 0.0); out[7] = f32_bits(fv + 0.0);
  out[8] = rgba; out[9] = 0; out[10] = 0; out[11] = 0;
}
cv_section_open :: (g: [] CvGeo, mesh: int, slot: int) -> int #effects(all) {
  if g[0].ns >= g[0].sections.count { return -1; }
  s := g[0].ns; g[0].sections[s] = CvSection.{mesh = mesh, slot = slot, first = g[0].ni, lo = [3] f32.[1e30, 1e30, 1e30], hi = [3] f32.[-1e30, -1e30, -1e30]};
  g[0].ns += 1; return s;
}
cv_corner :: (g: [] CvGeo, s: int, base: int, p: D3, n: D3, u: f64, v: f64, rgba: u32) -> bool #effects(all) {
  w: [CV_WORDS] u32; cv_words(p, n, u, v, rgba, w[..]);
  i := cv_vertex(g, base, w[..]);
  if i < 0 || g[0].ni >= g[0].idx.count { return false; }
  g[0].idx[g[0].ni] = cast(u32) i; g[0].ni += 1; g[0].sections[s].count += 1;
  c := [3] f32.[cast(f32) p.x, cast(f32) p.y, cast(f32) p.z];
  for k: 0..<3 { if c[k] < g[0].sections[s].lo[k] { g[0].sections[s].lo[k] = c[k]; } if c[k] > g[0].sections[s].hi[k] { g[0].sections[s].hi[k] = c[k]; } }
  return true;
}
cv_fail :: (g: [] CvGeo, why: string) -> int #effects(all) { g[0].bad = why; return -1; }

// ---- glTF meshes

// A 4x4 column-major transform, glTF's.
CvM4 :: struct { m: [16] f64; }
cv_identity :: () -> CvM4 #effects(all) { r: CvM4; r.m[0] = 1; r.m[5] = 1; r.m[10] = 1; r.m[15] = 1; return r; }
cv_mul :: (a: CvM4, b: CvM4) -> CvM4 #effects(all) {
  r: CvM4;
  for c: 0..<4 { for row: 0..<4 { s := 0.0; for k: 0..<4 { s += a.m[k * 4 + row] * b.m[c * 4 + k]; } r.m[c * 4 + row] = s; } }
  return r;
}
cv_apply :: (a: CvM4, p: D3) -> D3 #effects(all) { return d3(a.m[0] * p.x + a.m[4] * p.y + a.m[8] * p.z + a.m[12], a.m[1] * p.x + a.m[5] * p.y + a.m[9] * p.z + a.m[13], a.m[2] * p.x + a.m[6] * p.y + a.m[10] * p.z + a.m[14]); }
// A normal by the inverse transpose of the upper 3x3 (cofactors: the determinant's scale drops out in the unit).
cv_normal :: (a: CvM4, n: D3) -> D3 #effects(all) {
  c0 := d3_cross(d3(a.m[4], a.m[5], a.m[6]), d3(a.m[8], a.m[9], a.m[10]));
  c1 := d3_cross(d3(a.m[8], a.m[9], a.m[10]), d3(a.m[0], a.m[1], a.m[2]));
  c2 := d3_cross(d3(a.m[0], a.m[1], a.m[2]), d3(a.m[4], a.m[5], a.m[6]));
  det := a.m[0] * c0.x + a.m[1] * c0.y + a.m[2] * c0.z;
  r := d3_add(d3_add(d3_scale(c0, n.x), d3_scale(c1, n.y)), d3_scale(c2, n.z));
  if det < 0 { r = d3_neg(r); }
  return d3_unit_or(r, d3(0.0, 1.0, 0.0));
}
cv_trs :: (t: D3, q: DQ, s: D3) -> CvM4 #effects(all) {
  r: CvM4;
  x := dq_rotate(q, d3(s.x, 0.0, 0.0)); y := dq_rotate(q, d3(0.0, s.y, 0.0)); z := dq_rotate(q, d3(0.0, 0.0, s.z));
  r.m[0] = x.x; r.m[1] = x.y; r.m[2] = x.z; r.m[4] = y.x; r.m[5] = y.y; r.m[6] = y.z; r.m[8] = z.x; r.m[9] = z.y; r.m[10] = z.z;
  r.m[12] = t.x; r.m[13] = t.y; r.m[14] = t.z; r.m[15] = 1;
  return r;
}
cv_node :: (g: [] AgFile, node: int) -> CvM4 #effects(all) {
  d := g[0].d;
  m := jv_get(d, node, "matrix");
  if m != -1 { r: CvM4; for k: 0..<16 { r.m[k] = anim_number(d, jv_at(d, m, k), -1e12, 1e12).value; } return r; }
  t := d3(0.0, 0.0, 0.0); q := dq(0.0, 0.0, 0.0, 1.0); s := d3(1.0, 1.0, 1.0);
  tn := jv_get(d, node, "translation"); rn := jv_get(d, node, "rotation"); sn := jv_get(d, node, "scale");
  if tn != -1 { t = d3(ab_f(d, tn, 0), ab_f(d, tn, 1), ab_f(d, tn, 2)); }
  if rn != -1 { q = dq(anim_number(d, jv_at(d, rn, 0), -2.0, 2.0).value, anim_number(d, jv_at(d, rn, 1), -2.0, 2.0).value, anim_number(d, jv_at(d, rn, 2), -2.0, 2.0).value, anim_number(d, jv_at(d, rn, 3), -2.0, 2.0).value); }
  if sn != -1 { s = d3(ab_f(d, sn, 0), ab_f(d, sn, 1), ab_f(d, sn, 2)); }
  return cv_trs(t, q, s);
}
cv_byte :: (x: f32) -> u32 #effects(all) { v := ifx x < 0 then 0.0f32 else ifx x > 1 then 1.0f32 else x; return cast(u32) cast(int) floor(v * 255 + 0.5); }
cv_rgba :: (r: f32, gg: f32, b: f32, a: f32) -> u32 #effects(all) { return cv_byte(r) | (cv_byte(gg) << 8) | (cv_byte(b) << 16) | (cv_byte(a) << 24); }

// One glTF mesh primitive into a section of mesh `mesh` (slot `slot`), through transform `x`.
cv_primitive :: (g: [] CvGeo, f: [] AgFile, prim: int, x: CvM4, mesh: int, slot: int) -> int #effects(all) {
  d := f[0].d;
  mode := ag_int(f, prim, "mode", 4); if mode != 4 { return cv_fail(g, "a mesh primitive that isn't triangles"); }
  attrs := jv_get(d, prim, "attributes");
  pos := ag_accessor(f, ag_int(f, attrs, "POSITION", -1));
  if !pos.ok || pos.components != 3 { return cv_fail(g, "a mesh primitive without positions"); }
  nrm := ag_accessor(f, ag_int(f, attrs, "NORMAL", -1)); has_n := nrm.ok && nrm.components == 3 && nrm.count == pos.count;
  uv := ag_accessor(f, ag_int(f, attrs, "TEXCOORD_0", -1)); has_uv := uv.ok && uv.components == 2 && uv.count == pos.count;
  col := ag_accessor(f, ag_int(f, attrs, "COLOR_0", -1)); has_c := col.ok && (col.components == 3 || col.components == 4) && col.count == pos.count;
  ii := ag_int(f, prim, "indices", -1); idx := ag_accessor(f, ii);
  count := ifx ii >= 0 then idx.count else pos.count;
  if (ii >= 0 && !idx.ok) || count % 3 != 0 { return cv_fail(g, "a mesh primitive whose indices aren't whole triangles"); }
  s := cv_section_open(g, mesh, slot); if s < 0 { return cv_fail(g, "more mesh sections than the import holds"); }
  base := g[0].nv;
  for t: 0..<count / 3 {
    c: [3] int; p: [3] D3;
    for k: 0..<3 {
      c[k] = ifx ii >= 0 then cast(int) ag_value(f, idx, t * 3 + k, 0) else t * 3 + k;
      if c[k] < 0 || c[k] >= pos.count { return cv_fail(g, "a mesh index outside its vertices"); }
      p[k] = cv_apply(x, d3(cast(f64) ag_value(f, pos, c[k], 0), cast(f64) ag_value(f, pos, c[k], 1), cast(f64) ag_value(f, pos, c[k], 2)));
    }
    face := d3_unit_or(d3_cross(d3_sub(p[1], p[0]), d3_sub(p[2], p[0])), d3(0.0, 1.0, 0.0));
    for k: 0..<3 {
      n := ifx has_n then cv_normal(x, d3(cast(f64) ag_value(f, nrm, c[k], 0), cast(f64) ag_value(f, nrm, c[k], 1), cast(f64) ag_value(f, nrm, c[k], 2))) else face;
      u := ifx has_uv then cast(f64) ag_value(f, uv, c[k], 0) else 0.0; v := ifx has_uv then cast(f64) ag_value(f, uv, c[k], 1) else 0.0;
      rgba := ifx has_c then cv_rgba(ag_value(f, col, c[k], 0), ag_value(f, col, c[k], 1), ag_value(f, col, c[k], 2), ifx col.components == 4 then ag_value(f, col, c[k], 3) else 1.0f32) else 0xFFFFFFFF;
      if !cv_corner(g, s, base, p[k], n, u, v, rgba) { return cv_fail(g, "more vertices than the import holds"); }
    }
  }
  if f[0].bad { return cv_fail(g, "a mesh accessor outside its buffer"); }
  return count / 3;
}
// A whole glTF binary as mesh `mesh`: every node with a mesh, through its parents' transforms, each
// primitive a section in order (the bundle's slot order). The triangles, or -1 (g.bad says why).
cv_gltf :: (g: [] CvGeo, bytes: [] u8, nodes: [] JvNode, mesh: int) -> int #effects(all) {
  c := ai_glb(bytes); if !c.ok { return cv_fail(g, "a mesh file that isn't glTF binary"); }
  dv: [1] Jv;
  if !jv_parse(dv[..], cast(string) bytes[c.json_first..<c.json_first + c.json_size], nodes) { return cv_fail(g, "a mesh file's JSON doesn't parse"); }
  ff: [1] AgFile; f := ff[..]; f[0].d = dv[0]; f[0].binary = bytes[c.binary_first..<c.binary_first + c.binary_size];
  d := dv[0];
  list := jv_get(d, 0, "nodes"); n := jv_len(d, list);
  if n > 4096 { return cv_fail(g, "a mesh file with more nodes than the import reads"); }
  parent: [4096] int; for k: 0..<n { parent[k] = -1; }
  for k: 0..<n {
    kids := jv_get(d, jv_at(d, list, k), "children");
    for j: 0..<jv_len(d, kids) { child := anim_integer(d, jv_at(d, kids, j), 0, n - 1); if child >= 0 { parent[child] = k; } }
  }
  tris := 0; slot := 0;
  g[0].meshes[mesh].first = g[0].ns;
  for k: 0..<n {
    node := jv_at(d, list, k);
    m := ag_int(f, node, "mesh", -1); if m < 0 { continue; }
    x := cv_node(f, node); up := parent[k]; guard := 0;
    while up >= 0 && guard < 64 { x = cv_mul(cv_node(f, jv_at(d, list, up)), x); up = parent[up]; guard += 1; }
    prims := jv_get(d, ag_top(f, "meshes", m), "primitives");
    for p: 0..<jv_len(d, prims) {
      t := cv_primitive(g, f, jv_at(d, prims, p), x, mesh, slot);
      if t < 0 { return -1; }
      tris += t; slot += 1;
    }
  }
  if slot == 0 { return cv_fail(g, "a mesh file with no mesh"); }
  cv_mesh_close(g, mesh, tris);
  return tris;
}
cv_mesh_close :: (g: [] CvGeo, mesh: int, tris: int) #effects(all) {
  m := g[0].meshes[mesh]; m.sections = g[0].ns - m.first; m.tris = tris; m.done = true;
  m.lo = [3] f64.[1e30, 1e30, 1e30]; m.hi = [3] f64.[-1e30, -1e30, -1e30];
  for s: m.first..<g[0].ns { for k: 0..<3 { m.lo[k] = fmin(m.lo[k], cast(f64) g[0].sections[s].lo[k]); m.hi[k] = fmax(m.hi[k], cast(f64) g[0].sections[s].hi[k]); } }
  g[0].meshes[mesh] = m;
}

// The engine's own shape for a substituted mesh (substitute.coax), at Unreal's sizes, one section.
cv_shape :: (g: [] CvGeo, shape: int, mesh: int) -> int #effects(all) {
  return cv_shape_in(g, shape, mesh, d3(-0.5, -0.5, -0.5), d3(0.5, 0.5, 0.5));
}
// The same, fitted to the mesh's bounds (lo and hi in the pack's axes, metres): the unit shape's box,
// -0.5 to 0.5 on each axis, is scaled and moved onto them. A flat side (a plane's height) keeps the
// shape flat at its place. The character stand-in keeps its own size and place (the Mannequin's pivot).
cv_shape_in :: (g: [] CvGeo, shape: int, mesh: int, lo: D3, hi: D3) -> int #effects(all) {
  buf: [8192 * VERTEX_WORDS] u32; p: [1] Pen; pen_set(p[..], 1, MAT_WORLD, 1, 1, 1);
  if shape == SU_BOX || shape == SU_BOUNDS { box(buf[..], p[..], frame_at(v3(0, 0, 0), 0), 0.5, 0.5, 0.5); }
  if shape == SU_PLANE { quad(buf[..], p[..], v3(-0.5, 0, -0.5), v3(-0.5, 0, 0.5), v3(0.5, 0, 0.5), v3(0.5, 0, -0.5)); }
  if shape == SU_SPHERE { ball(buf[..], p[..], v3(0, 0, 0), 0.5, 24); }
  if shape == SU_CYLINDER { tube(buf[..], p[..], frame_at(v3(0, -0.5, 0), 0), 1, 0.5, 0.5, 0.5, 0.5, 24, true); }
  if shape == SU_CONE { tube(buf[..], p[..], frame_at(v3(0, -0.5, 0), 0), 1, 0.5, 0.5, 0, 0, 24, true); }
  if shape == SU_CHARACTER { tube(buf[..], p[..], frame_at(v3(0, 0, 0), 0), 1.8, 0.25, 0.18, 0.2, 0.14, 16, true); }
  if p[0].n == 0 || p[0].over { return cv_fail(g, "no engine shape for this substitute"); }
  g[0].meshes[mesh].first = g[0].ns;
  s := cv_section_open(g, mesh, 0); if s < 0 { return cv_fail(g, "more mesh sections than the import holds"); }
  base := g[0].nv;
  for v: 0..<p[0].n {
    i := v * VERTEX_WORDS; packed := buf[i + 3];
    n := d3(cast(f64) (packed & 255) / 255 * 2 - 1, cast(f64) ((packed >> 8) & 255) / 255 * 2 - 1, cast(f64) ((packed >> 16) & 255) / 255 * 2 - 1);
    at := d3(cast(f64) f32_from_bits(buf[i]), cast(f64) f32_from_bits(buf[i + 1]), cast(f64) f32_from_bits(buf[i + 2]));
    if shape != SU_CHARACTER {
      sx := hi.x - lo.x; sy := hi.y - lo.y; sz := hi.z - lo.z;
      at = d3(lo.x + (at.x + 0.5) * sx, lo.y + (at.y + 0.5) * sy, lo.z + (at.z + 0.5) * sz);
      // a stretched normal: divide by the scale (a flat axis keeps its own), then unit length
      n = d3(ifx sx > 1e-9 then n.x / sx else n.x, ifx sy > 1e-9 then n.y / sy else n.y, ifx sz > 1e-9 then n.z / sz else n.z);
    }
    if !cv_corner(g, s, base, at, d3_unit_or(n, d3(0.0, 1.0, 0.0)), 0, 0, 0xFFFFFFFF) { return cv_fail(g, "more vertices than the import holds"); }
  }
  cv_mesh_close(g, mesh, p[0].n / 3);
  return p[0].n / 3;
}

// ---- materials

// The parameter names the importer maps (spec 5.4): every other parameter is listed, not guessed.
CV_BASE_COLOR :: "BaseColor|Base Color|Color|Colour|Base Colour|Tint|Albedo|DiffuseColor|Base_Color";
CV_BASE_TEXTURE :: "BaseColor|Base Color|Albedo|Diffuse|BaseColorTexture|Base_Color|Texture";
CV_DEFAULT :: [4] f32.[0.7, 0.7, 0.7, 1];
// A material row as the engine's record: the mapped base colour and texture, its blend and shading.
// `layer_of` maps a texture row to its colour layer (-1: none). `unmapped` counts what was not mapped.
cv_material :: (b: [] AbBundle, row: int, layer_of: [] int, unmapped: [] int) -> CvMat #effects(all) {
  return cv_material_toned(b, row, layer_of, unmapped, "", "");
}
// The same, with a two-tone pair named by the import's command (--two-tone LIT=SHADE): a material whose
// vectors have both names is a toon material that shades itself (a project's own master, often "unlit"
// in the engine): its base colour is LIT, its shadow colour SHADE, and the realm lights it by the key.
// Empty names: no pair.
cv_material_toned :: (b: [] AbBundle, row: int, layer_of: [] int, unmapped: [] int, lit: string, shade: string) -> CvMat #effects(all) {
  return cv_material_shaded(b, row, layer_of, unmapped, lit, shade, "");
}
// The same, with the master's own shade rule named too (--shade-auto SWITCH:SHARE:TINT): a two-tone material
// whose scalar SWITCH is on takes its shadow colour from its lit colour as the master computes it,
// LIT x SHARE x TINT / luma(TINT) (Splice Bots' M_SpliceMaster: ShadeAuto, ShadeShare, ShadeTint), not from
// its SHADE vector, which the master then ignores. Empty: no rule.
cv_material_shaded :: (b: [] AbBundle, row: int, layer_of: [] int, unmapped: [] int, lit: string, shade: string, auto: string) -> CvMat #effects(all) {
  d := b[0].d; m: CvMat; m.rgba = CV_DEFAULT;
  if ab_field(d, row, "origin") == "engine" { m.flags = CV_FALLBACK; return m; }   // substitute.coax: the engine's default
  vs := jv_get(d, row, "vectors"); found := false; lit_at := -1; shade_at := -1;
  if lit.count > 0 && shade.count > 0 {
    for k: 0..<jv_len(d, vs) {
      nm := ab_field(d, jv_at(d, vs, k), "name");
      if nm == lit && lit_at < 0 { lit_at = k; } else if nm == shade && shade_at < 0 { shade_at = k; }
    }
    if lit_at < 0 || shade_at < 0 { lit_at = -1; shade_at = -1; }
  }
  if lit_at >= 0 {
    lv := jv_get(d, jv_at(d, vs, lit_at), "value"); sv := jv_get(d, jv_at(d, vs, shade_at), "value");
    for c: 0..<4 { m.rgba[c] = cast(f32) ab_f(d, lv, c); } for c: 0..<3 { m.shade[c] = cast(f32) ab_f(d, sv, c); }
    m.flags |= CV_TWO_TONE; found = true;
    cv_shade_auto(d, row, auto, m.rgba, m.shade[..]);
  }
  for k: 0..<jv_len(d, vs) {
    if k == lit_at || k == shade_at { continue; }
    e := jv_at(d, vs, k);
    if anim_in(jv_raw(d, jv_get(d, e, "name")), CV_BASE_COLOR) && !found { v := jv_get(d, e, "value"); for c: 0..<4 { m.rgba[c] = cast(f32) ab_f(d, v, c); } found = true; }
    else { unmapped[0] += 1; }
  }
  ts := jv_get(d, row, "textures"); tex := -1;
  for k: 0..<jv_len(d, ts) {
    e := jv_at(d, ts, k);
    if anim_in(jv_raw(d, jv_get(d, e, "name")), CV_BASE_TEXTURE) && tex < 0 { tex = ab_find(b, b[0].textures, ab_field(d, e, "texture")); }
    else { unmapped[0] += 1; }
  }
  baked := jv_get(d, jv_get(d, row, "baked"), "base_color");
  if tex < 0 && baked != -1 { tex = ab_find(b, b[0].textures, ab_s(d, baked)); }
  unmapped[0] += jv_len(d, jv_get(d, row, "scalars"));
  if tex >= 0 { m.layer = layer_of[tex]; if !found { m.rgba = [4] f32.[1, 1, 1, 1]; } }
  if !found && tex < 0 { m.flags |= CV_FALLBACK; }
  if jv_bool(d, jv_get(d, row, "two_sided")) { m.flags |= CV_TWO_SIDED; }
  blend := ab_field(d, row, "blend");
  if blend == "masked" { m.flags |= CV_MASKED; }
  if blend == "translucent" || blend == "additive" { m.flags |= CV_TRANSLUCENT; }
  if ab_field(d, row, "shading") == "unlit" && m.flags & CV_TWO_TONE == 0 { m.flags |= CV_UNLIT; }
  return m;
}
// The master's own shade, when the material turns it on (cv_material_shaded): auto is "SWITCH:SHARE:TINT".
cv_shade_auto :: (d: Jv, row: int, auto: string, lit: [4] f32, out: [] f32) #effects(all) {
  names: [3] string; n := 0; from := 0;
  for at: 0..<auto.count + 1 { if at == auto.count || auto[at] == ':' { if n < 3 { names[n] = auto[from..<at]; } n += 1; from = at + 1; } }
  if n != 3 { return; }
  on := -1.0; share := -1.0; tint: [3] f64; has_tint := false;
  ss := jv_get(d, row, "scalars");
  for k: 0..<jv_len(d, ss) {
    e := jv_at(d, ss, k); nm := ab_field(d, e, "name");
    if nm == names[0] { on = ab_num(d, jv_get(d, e, "value")).value; } else if nm == names[1] { share = ab_num(d, jv_get(d, e, "value")).value; }
  }
  vs := jv_get(d, row, "vectors");
  for k: 0..<jv_len(d, vs) {
    e := jv_at(d, vs, k);
    if ab_field(d, e, "name") == names[2] { v := jv_get(d, e, "value"); for c: 0..<3 { tint[c] = ab_f(d, v, c); } has_tint = true; }
  }
  if on <= 0.5 || share < 0 || !has_tint { return; }
  luma := tint[0] * 0.2126 + tint[1] * 0.7152 + tint[2] * 0.0722;
  if luma < 0.0001 { luma = 0.0001; }
  for c: 0..<3 { out[c] = cast(f32) (cast(f64) lit[c] * share * tint[c] / luma); }
}
// How a texture is carried: 1 a colour layer, 2 a data layer, 0 refused (its use unknown, spec 5.4).
// A texture a material uses as base colour, or a user-interface or default sRGB image, is colour;
// a normal map or a mask (ORM) is data; anything else is refused, not guessed.
cv_texture_use :: (b: [] AbBundle, row: int, base_color: bool) -> int #effects(all) {
  d := b[0].d; c := ab_field(d, row, "compression"); srgb := jv_bool(d, jv_get(d, row, "srgb"));
  if base_color || (srgb && (c == "ui" || c == "default" || c == "bc7")) { return 1; }
  if c == "normalmap" || c == "masks" { return 2; }
  return 0;
}

// ---- collision

// A collider in the engine's frame: kind CV_C_*, its numbers as the catalog writes them.
CV_C_BOX :: 0; CV_C_HULL :: 1; CV_C_FLOOR :: 2; CV_C_CAPSULE :: 3;
CV_C_NAMES :: [4] string.["box", "hull", "floor", "capsule"];
CvShape :: struct { map: int; kind: int; n: int; v: [3 + 4 * CV_HULL_FACES] f64; lo: [3] f64; hi: [3] f64; }
cv_d3_at :: (v: [] f64, k: int) -> D3 #effects(all) { return d3(v[k], v[k + 1], v[k + 2]); }
// A box's 8 world corners (Unreal mesh-local centre, rotation and half extent, through a placement's
// world transform), in the engine's frame.
cv_box_corners :: (center: D3, rot: DQ, ext: D3, t: D3, q: DQ, s: D3, out: [] D3) #effects(all) {
  for k: 0..<8 {
    local := d3(ifx k & 1 != 0 then ext.x else -ext.x, ifx k & 2 != 0 then ext.y else -ext.y, ifx k & 4 != 0 then ext.z else -ext.z);
    mesh := d3_add(center, dq_rotate(rot, local));        // Unreal mesh space, cm
    w := ua_place(t, q, s, mesh);                          // Unreal world, cm
    out[k] = ua_pos(w.x, w.y, w.z);
  }
}
cv_bounds :: (c: [] D3, sh: [] CvShape) #effects(all) {
  for k: 0..<3 { sh[0].lo[k] = 1e30; sh[0].hi[k] = -1e30; }
  for p: c { pv := [3] f64.[p.x, p.y, p.z]; for k: 0..<3 { sh[0].lo[k] = fmin(sh[0].lo[k], pv[k]); sh[0].hi[k] = fmax(sh[0].hi[k], pv[k]); } }
}
CV_BOX_FACES :: [6] [4] int.[[4] int.[0, 2, 6, 4], [4] int.[1, 5, 7, 3], [4] int.[0, 4, 5, 1], [4] int.[2, 3, 7, 6], [4] int.[0, 1, 3, 2], [4] int.[4, 6, 7, 5]];
CV_FLAT :: 0.0001;     // m: thinner than this a box is a floor (a plane's collision)
// The 8 corners as the engine's collider: an axis-aligned box (a wall), a level parallelogram (a
// floor) when it has no thickness, or a 6-face hull.
cv_box_shape :: (c: [] D3, map: int, sh: [] CvShape) -> bool #effects(all) {
  sh[0] = CvShape.{map = map}; cv_bounds(c, sh);
  mid := d3(0.0, 0.0, 0.0); for p: c { mid = d3_add(mid, d3_scale(p, 0.125)); }
  // aligned: every corner on its box's bounds
  aligned := true;
  for p: c { pv := [3] f64.[p.x, p.y, p.z]; for k: 0..<3 { if !(near_d(pv[k], sh[0].lo[k], 0.000001) || near_d(pv[k], sh[0].hi[k], 0.000001)) { aligned = false; } } }
  if sh[0].hi[1] - sh[0].lo[1] < CV_FLAT {
    // a level slab: corner 0 and its two neighbours across the ground (the ones not along the thin axis)
    o := c[0]; a := d3(0.0, 0.0, 0.0); bb := d3(0.0, 0.0, 0.0); found := 0;
    for k: 1..<8 { e := d3_sub(c[k], o); if d3_len(e) > CV_FLAT && (k == 1 || k == 2 || k == 4) { if found == 0 { a = e; } else if found == 1 { bb = e; } found += 1; } }
    if found != 2 { return false; }
    sh[0].kind = CV_C_FLOOR; sh[0].n = 9;
    vals := [9] f64.[o.x, o.z, a.x, a.z, bb.x, bb.z, o.y, a.y, bb.y];
    for k: 0..<9 { sh[0].v[k] = vals[k]; }
    return true;
  }
  if aligned {
    sh[0].kind = CV_C_BOX; sh[0].n = 6;
    for k: 0..<3 { sh[0].v[k] = sh[0].lo[k]; sh[0].v[k + 3] = sh[0].hi[k]; }
    return true;
  }
  sh[0].kind = CV_C_HULL; sh[0].v[0] = 6; sh[0].v[1] = sh[0].lo[1]; sh[0].v[2] = sh[0].hi[1]; sh[0].n = 3 + 24;
  for f, k: CV_BOX_FACES {
    n := d3_unit_or(d3_cross(d3_sub(c[f[1]], c[f[0]]), d3_sub(c[f[2]], c[f[0]])), d3(0.0, 1.0, 0.0));
    if d3_dot(n, d3_sub(c[f[0]], mid)) < 0 { n = d3_neg(n); }
    at := 3 + k * 4; sh[0].v[at] = n.x; sh[0].v[at + 1] = n.y; sh[0].v[at + 2] = n.z; sh[0].v[at + 3] = d3_dot(n, c[f[0]]);
  }
  return true;
}
// A convex hull's faces from its points (at most CV_HULL_POINTS): every plane through three points with
// every point on its inner side, once each.
cv_hull_shape :: (p: [] D3, map: int, sh: [] CvShape) -> bool #effects(all) {
  if p.count < 4 || p.count > CV_HULL_POINTS { return false; }
  sh[0] = CvShape.{map = map, kind = CV_C_HULL}; cv_bounds(p, sh);
  span := 0.0; for k: 0..<3 { span = fmax(span, sh[0].hi[k] - sh[0].lo[k]); }
  eps := fmax(span * 0.000001, 0.0000001); faces := 0;
  for i: 0..<p.count { for j: i + 1..<p.count { for k: j + 1..<p.count {
    n := d3_cross(d3_sub(p[j], p[i]), d3_sub(p[k], p[i])); l := d3_len(n);
    if l < eps * eps { continue; }
    n = d3_scale(n, 1.0 / l); dd := d3_dot(n, p[i]);
    above := false; below := false;
    for q: p { s := d3_dot(n, q) - dd; if s > eps { above = true; } if s < -eps { below = true; } }
    if above && below { continue; }
    if above { n = d3_neg(n); dd = -dd; }
    same := false;
    for f: 0..<faces { at := 3 + f * 4; if near_d(sh[0].v[at], n.x, 0.000001) && near_d(sh[0].v[at + 1], n.y, 0.000001) && near_d(sh[0].v[at + 2], n.z, 0.000001) { same = true; } }
    if same { continue; }
    if faces >= CV_HULL_FACES { return false; }
    at := 3 + faces * 4; sh[0].v[at] = n.x; sh[0].v[at + 1] = n.y; sh[0].v[at + 2] = n.z; sh[0].v[at + 3] = dd; faces += 1;
  } } }
  if faces < 4 { return false; }
  sh[0].v[0] = cast(f64) faces; sh[0].v[1] = sh[0].lo[1]; sh[0].v[2] = sh[0].hi[1]; sh[0].n = 3 + faces * 4;
  return true;
}
// A capsule along its local Z (Unreal's), through a placement: both ends and the radius. False when the
// placement scales it unevenly across its axis (not a capsule any more: refused, spec 5.3).
cv_capsule_shape :: (center: D3, rot: DQ, radius: f64, length: f64, t: D3, q: DQ, s: D3, map: int, sh: [] CvShape) -> bool #effects(all) {
  axis := dq_rotate(rot, d3(0.0, 0.0, 1.0)); side := dq_rotate(rot, d3(1.0, 0.0, 0.0)); other := dq_rotate(rot, d3(0.0, 1.0, 0.0));
  sx := d3_len(d3_mul(s, side)); sy := d3_len(d3_mul(s, other));
  if !near_d(sx, sy, 0.0001 * fmax(sx, sy)) || abs(s.x) < 0.000001 { return false; }
  ends: [2] D3;
  for k: 0..<2 { e := d3_add(center, d3_scale(axis, (ifx k == 0 then -0.5 else 0.5) * length)); w := ua_place(t, q, s, e); ends[k] = ua_pos(w.x, w.y, w.z); }
  r := ua_len(radius * sx);
  sh[0] = CvShape.{map = map, kind = CV_C_CAPSULE, n = 7};
  vals := [7] f64.[ends[0].x, ends[0].y, ends[0].z, ends[1].x, ends[1].y, ends[1].z, r];
  for k: 0..<7 { sh[0].v[k] = vals[k]; }
  for k: 0..<3 { e := [2] f64.[vals[k], vals[k + 3]]; sh[0].lo[k] = fmin(e[0], e[1]) - r; sh[0].hi[k] = fmax(e[0], e[1]) + r; }
  return true;
}
// How far a collider reaches outside a visible box (world bounds lo, hi), in m.
cv_outside :: (sh: CvShape, lo: [3] f64, hi: [3] f64) -> f64 #effects(all) {
  r := 0.0;
  for k: 0..<3 { r = fmax(r, lo[k] - sh.lo[k]); r = fmax(r, sh.hi[k] - hi[k]); }
  return r;
}
// A placed mesh's visible world bounds: its local bounds' 8 corners through the placement, in the engine.
cv_visible :: (m: CvMesh, t: D3, q: DQ, s: D3, lo: [] f64, hi: [] f64) #effects(all) {
  for k: 0..<3 { lo[k] = 1e30; hi[k] = -1e30; }
  for c: 0..<8 {
    local := d3(ifx c & 1 != 0 then m.hi[0] else m.lo[0], ifx c & 2 != 0 then m.hi[1] else m.lo[1], ifx c & 4 != 0 then m.hi[2] else m.lo[2]);
    w := d3_add(t, dq_rotate(q, d3_mul(s, local)));
    wv := [3] f64.[w.x, w.y, w.z];
    for k: 0..<3 { lo[k] = fmin(lo[k], wv[k]); hi[k] = fmax(hi[k], wv[k]); }
  }
}

// ---- writing the catalog

CvText :: struct { b: [] u8; n: int; bad: bool; }
cv_put :: (t: [] CvText, s: string) #effects(all) { if t[0].n + s.count > t[0].b.count { t[0].bad = true; return; } for c: s { t[0].b[t[0].n] = c; t[0].n += 1; } }
cv_num :: (t: [] CvText, v: f64) #effects(all) { b: [48] u8; cv_put(t, " "); cv_put(t, uf_num_text(v, b[..])); }
cv_int :: (t: [] CvText, v: int) #effects(all) { cv_num(t, cast(f64) v); }
cv_word :: (t: [] CvText, s: string) #effects(all) { cv_put(t, " "); cv_put(t, s); }
cv_text :: (t: [] CvText) -> string #effects(all) { return cast(string) t[0].b[0..<t[0].n]; }
cv_shape_line :: (t: [] CvText, sh: CvShape, name: string) #effects(all) {
  cv_put(t, "col"); cv_int(t, sh.map); cv_word(t, CV_C_NAMES[sh.kind]);
  for k: 0..<sh.n { if sh.kind == CV_C_HULL && k == 0 { cv_int(t, cast(int) sh.v[0]); } else { cv_num(t, sh.v[k]); } }
  cv_word(t, name); cv_put(t, "\n");
}
// A name the catalog can carry as one field: its bytes, spaces as _.
cv_field :: (s: string, out: [] u8) -> string #effects(all) {
  n := ifx s.count < out.count then s.count else out.count;
  for k: 0..<n { c := s[k]; out[k] = ifx c <= ' ' || c > '~' then '_' else c; }
  return cast(string) out[0..<n];
}
// A pack entry's name from an id: its last path part before any '.', lower case, [a-z0-9-], at most 24
// bytes, then -K so two never meet.
cv_entry_name :: (id: string, k: int, out: [] u8) -> string #effects(all) {
  from := 0; for c, i: id { if c == '/' { from = i + 1; } }
  n := 0;
  for c: id[from..<id.count] {
    if c == '.' || n >= 24 { break; }
    l := ifx c >= 'A' && c <= 'Z' then c + 32 else c;
    ok := (l >= 'a' && l <= 'z') || (l >= '0' && l <= '9');
    out[n] = ifx ok then l else '-'; n += 1;
  }
  if n == 0 { out[0] = 'x'; n = 1; }
  out[n] = '-'; n += 1;
  digits: [12] u8; dn := 0; v := k; if v == 0 { digits[0] = '0'; dn = 1; }
  while v > 0 { digits[dn] = cast,trunc(u8) (48 + v % 10); dn += 1; v /= 10; }
  for j: 0..<dn { out[n] = digits[dn - 1 - j]; n += 1; }
  return cast(string) out[0..<n];
}
// A placement's cell: 64 m squares across the ground.
cv_cell :: (x: f64) -> int #effects(all) { return cast(int) floor(x / CV_CELL); }
// The yaw of a rotation (radians about +y from +z toward +x): where it turns +z.
cv_yaw :: (q: DQ) -> f64 #effects(all) { f := dq_rotate(q, d3(0.0, 0.0, 1.0)); return cv_atan2(f.x, f.z); }
cv_atan2 :: (y: f64, x: f64) -> f64 #effects(all) {
  if x > 0 { return atan_d(y / x); }
  if x < 0 { return ifx y >= 0 then atan_d(y / x) + PI_D else atan_d(y / x) - PI_D; }
  return ifx y > 0 then PI_D / 2 else ifx y < 0 then -PI_D / 2 else 0.0;
}

#load "convert-checks.coax" #test;
