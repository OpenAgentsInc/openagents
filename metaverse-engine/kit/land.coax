// Cel land: ground, dunes, mesas, rocks, arches, canyons, terraces, towers, steps, sea, palms,
// banners and a moon (the domed houses are printed.coax's), built with the cel mesh writers (metaverse-engine/render/cel-mesh.coax)
// in the colours they are handed. Scattered pieces take a seed, so the same scene writes the same
// triangles. Nothing here draws or decides; it only writes. Splice
// (metaverse/splice-bots/splice-bots.coax) stages them.
//   coax/bin/coax test --library metaverse-engine/kit/land.coax
#load "printed.coax";

// The ground: one wide quad at y 0. MAT_FLOOR draws flagstones; MAT_WORLD a plain cel plane.
kit_ground :: (buf: [] u32, p: [] Pen, obj: int, c: KitTint, tiles: bool) {
  kit_pen(p, obj, ifx tiles then MAT_FLOOR else MAT_WORLD, c);
  quad(buf, p, v3(-150, 0, -150), v3(150, 0, -150), v3(150, 0, 150), v3(-150, 0, 150));
}

// Dune swells: flattened ellipsoids across x in [-span, span] and z in [z0, z1].
kit_dunes :: (buf: [] u32, p: [] Pen, obj: int, c: KitTint, count: int, seed: f32, span: f32, z0: f32, z1: f32, rmin: f32, rmax: f32) {
  kit_pen(p, obj, MAT_WORLD, c);
  for i: 0..<count {
    k := seed + cast(f32) i;
    x := (kit_rand(k + 1) * 2 - 1) * span;
    z := z0 + kit_rand(k + 40) * (z1 - z0);
    r := rmin + kit_rand(k + 80) * (rmax - rmin);
    ellipsoid(buf, p, frame_at(v3(x, -0.075 * r, z), kit_rand(k + 9) * 6), r, r * 0.3, r * 0.8, 12, 6, 0);
  }
}

// Mesas: flat-topped cones in a row across the horizon, about z_far deep.
kit_mesas :: (buf: [] u32, p: [] Pen, obj: int, c: KitTint, count: int, seed: f32, z_far: f32, spacing: f32, hmin: f32, hmax: f32) {
  kit_pen(p, obj, MAT_WORLD, c);
  for i: 0..<count {
    k := seed + cast(f32) i;
    x := (cast(f32) i - cast(f32) (count - 1) * 0.5) * spacing + (kit_rand(k + 120) - 0.5) * spacing * 0.4;
    z := z_far - kit_rand(k + 130) * 40;
    h := hmin + kit_rand(k + 140) * (hmax - hmin);
    r0 := 12 + kit_rand(k + 150) * 10; r1 := 4 + kit_rand(k + 160) * 4;
    tube(buf, p, frame_at(v3(x, -0.5, z), 0), h, r0, r0, r1, r1, 7, true);
  }
}

// One flat-topped mesa (a butte): a talus skirt, rock bands stacked up its steep sides in two
// tints, each band a little turned and set in or out from the one under it so the strata read, a
// flat cap with a lip and fallen boulders round its foot. 10.75 m tall, about 15.5 m across and 12 m
// deep at its foot at s 1.
MESA_BANDS :: 6;
kit_mesa :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, rock: KitTint, band: KitTint) {
  sides := 9;
  kit_pen(p, obj, MAT_WORLD, band);
  tube(buf, p, f, 1.6 * s, 7.6 * s, 5.8 * s, 6.5 * s, 4.9 * s, sides, true);
  y := 1.6f32; rx := 6.3f32; rz := 4.7f32;
  for i: 0..<MESA_BANDS {
    k := cast(f32) i;
    h := 1.3 + kit_rand(k + 700) * 0.35;
    w := 1 - k * 0.02 + (kit_rand(k + 710) - 0.5) * 0.07;
    rx = 6.3 * w; rz = 4.7 * w;
    kit_pen(p, obj + 1 + i % 2, MAT_WORLD, ifx i % 2 == 0 then rock else band);
    g := frame_turn(kit_at(f, (kit_rand(k + 720) - 0.5) * 0.3 * s, y * s, (kit_rand(k + 730) - 0.5) * 0.3 * s), 1, (kit_rand(k + 740) - 0.5) * 0.25);
    tube(buf, p, g, h * s, rx * s, rz * s, rx * 0.97 * s, rz * 0.97 * s, sides, true);
    y += h;
  }
  kit_pen(p, obj + 3, MAT_WORLD, rock);
  tube(buf, p, kit_at(f, 0, y * s, 0), 0.35 * s, rx * 1.05 * s, rz * 1.05 * s, rx * 1.02 * s, rz * 1.02 * s, sides, true);
  kit_pen(p, obj + 4, MAT_WORLD, band);
  for i: 0..<5 {
    k := cast(f32) i;
    a := k * TAU / 5 + kit_rand(k + 750);
    r := 0.5 + kit_rand(k + 760) * 0.6;
    ellipsoid(buf, p, frame_turn(kit_at(f, cos(a) * 7.0 * s, r * 0.7 * s, sin(a) * 5.4 * s), 1, kit_rand(k + 770) * 6), r * 1.2 * s, r * 0.75 * s, r * s, 8, 5, 0);
  }
}

// Rocks: lumps in a ring from d0 to d1 round (cx, cz), radius rmin to rmax.
kit_rocks :: (buf: [] u32, p: [] Pen, obj: int, c: KitTint, count: int, seed: f32, cx: f32, cz: f32, d0: f32, d1: f32, rmin: f32, rmax: f32) {
  kit_pen(p, obj, MAT_WORLD, c);
  for i: 0..<count {
    k := seed + cast(f32) i;
    a := kit_rand(k + 200) * TAU;
    d := d0 + kit_rand(k + 210) * (d1 - d0);
    r := rmin + kit_rand(k + 220) * (rmax - rmin);
    ellipsoid(buf, p, frame_at(v3(cx + cos(a) * d, r * 0.2, cz + sin(a) * d), kit_rand(k + 230) * 6), r, r * 0.7, r * 0.9, 8, 5, 0);
  }
}

// A mound: a convex outline `pts` (x, z pairs, either way round) on the ground, its sides sloping up
// from each edge to a flat top `h` high, `w` in from the edges. land_mound_y is its height anywhere, so
// what is drawn and what is walked on agree; land_mound_push holds a body of radius r out of one too
// steep to climb. A peak: land_peak, its sides up to one point over the outline.
// How far (x, z) is inside the outline: the nearest edge's distance, below 0 outside.
land_mound_d :: (pts: [] const f32, x: f32, z: f32) -> f32 { return land_mound_edge(pts, x, z).y; }
// An edge (i), how far inside it (x, z) is (y), and its inward normal.
LandEdge :: struct { i: int; y: f32; nx: f32; nz: f32; }
land_mound_edge :: (pts: [] const f32, x: f32, z: f32) -> LandEdge {
  n := pts.count / 2; area := 0.0f32;
  for i: 0..<n { j := (i + 1) % n; area += pts[i * 2] * pts[j * 2 + 1] - pts[j * 2] * pts[i * 2 + 1]; }
  sg := ifx area > 0 then 1.0f32 else -1.0f32;
  e := LandEdge.{i = -1, y = 1000000};
  for i: 0..<n {
    j := (i + 1) % n; ex := pts[j * 2] - pts[i * 2]; ez := pts[j * 2 + 1] - pts[i * 2 + 1]; l := hi(sqrt(ex * ex + ez * ez), 0.0001);
    nx := -ez * sg / l; nz := ex * sg / l; d := (x - pts[i * 2]) * nx + (z - pts[i * 2 + 1]) * nz;
    if d < e.y { e = LandEdge.{i = i, y = d, nx = nx, nz = nz}; }
  }
  return e;
}
// Whether (x, z) is within `pad` of the outline's box: the cheap test before the others.
land_near :: (pts: [] const f32, x: f32, z: f32, pad: f32) -> bool {
  x0 := pts[0]; x1 := pts[0]; z0 := pts[1]; z1 := pts[1];
  for i: 1..<pts.count / 2 { x0 = lo(x0, pts[i * 2]); x1 = hi(x1, pts[i * 2]); z0 = lo(z0, pts[i * 2 + 1]); z1 = hi(z1, pts[i * 2 + 1]); }
  return x > x0 - pad && x < x1 + pad && z > z0 - pad && z < z1 + pad;
}
land_mound_y :: (pts: [] const f32, h: f32, w: f32, x: f32, z: f32) -> f32 {
  if !land_near(pts, x, z, 0) { return 0; }
  d := land_mound_d(pts, x, z); return ifx d <= 0 then 0.0f32 else h * clamp(d / w, 0, 1); }
land_mound_push :: (pts: [] const f32, x: f32, z: f32, r: f32) -> Point {
  if !land_near(pts, x, z, r) { return v3(x, 0, z); }
  e := land_mound_edge(pts, x, z);
  if e.i < 0 || e.y <= -r { return v3(x, 0, z); }
  return v3(x - e.nx * (e.y + r), 0, z - e.nz * (e.y + r));
}
// The top's corner i: where the edges either side of it, moved w in, cross.
land_mound_in :: (pts: [] const f32, w: f32, i: int) -> Point {
  n := pts.count / 2; k := (i + n - 1) % n;
  e0 := land_side(pts, k); e1 := land_side(pts, i);
  c0 := e0.nx * pts[k * 2] + e0.nz * pts[k * 2 + 1] + w; c1 := e1.nx * pts[i * 2] + e1.nz * pts[i * 2 + 1] + w;
  det := e0.nx * e1.nz - e0.nz * e1.nx;
  if abs(det) < 0.0001 { return v3(pts[i * 2] + e1.nx * w, 0, pts[i * 2 + 1] + e1.nz * w); }
  return v3((c0 * e1.nz - c1 * e0.nz) / det, 0, (e0.nx * c1 - e1.nx * c0) / det);
}
// Edge i's inward normal.
land_side :: (pts: [] const f32, i: int) -> LandEdge {
  n := pts.count / 2; area := 0.0f32;
  for k: 0..<n { j := (k + 1) % n; area += pts[k * 2] * pts[j * 2 + 1] - pts[j * 2] * pts[k * 2 + 1]; }
  s := ifx area > 0 then 1.0f32 else -1.0f32;
  j := (i + 1) % n; ex := pts[j * 2] - pts[i * 2]; ez := pts[j * 2 + 1] - pts[i * 2 + 1]; l := hi(sqrt(ex * ex + ez * ez), 0.0001);
  return LandEdge.{i = i, nx = -ez * s / l, nz = ex * s / l};
}
// A face a, b, c, d turned up and out.
land_face :: (buf: [] u32, p: [] Pen, a: Point, b: Point, c: Point, d: Point) {
  if cross(sub(b, a), sub(c, a)).y >= 0 { quad(buf, p, a, b, c, d); } else { quad(buf, p, a, d, c, b); }
}
kit_mound :: (buf: [] u32, p: [] Pen, obj: int, top: KitTint, side: KitTint, pts: [] const f32, h: f32, w: f32) {
  n := pts.count / 2;
  if n < 3 { return; }
  kit_pen(p, obj, MAT_WORLD, side);
  for i: 0..<n {
    j := (i + 1) % n; a := land_mound_in(pts, w, i); b := land_mound_in(pts, w, j);
    land_face(buf, p, v3(pts[i * 2], 0, pts[i * 2 + 1]), v3(pts[j * 2], 0, pts[j * 2 + 1]), v3(b.x, h, b.z), v3(a.x, h, a.z));
  }
  kit_pen(p, obj + 1, MAT_WORLD, top);
  c := land_mound_in(pts, w, 0);
  for i: 1..<n - 1 { a := land_mound_in(pts, w, i); b := land_mound_in(pts, w, i + 1); land_face(buf, p, v3(c.x, h, c.z), v3(a.x, h, a.z), v3(b.x, h, b.z), v3(b.x, h, b.z)); }
}
// A peak: its sides from the outline up to one point (x, h, z).
land_peak :: (buf: [] u32, p: [] Pen, obj: int, c: KitTint, pts: [] const f32, x: f32, h: f32, z: f32) {
  kit_pen(p, obj, MAT_WORLD, c);
  n := pts.count / 2;
  for i: 0..<n { j := (i + 1) % n; land_face(buf, p, v3(pts[i * 2], 0, pts[i * 2 + 1]), v3(pts[j * 2], 0, pts[j * 2 + 1]), v3(x, h, z), v3(x, h, z)); }
}

// A post-and-lintel arch: two piers and the lintel over a span, its middle at f.
kit_arch_block :: (buf: [] u32, p: [] Pen, f: Frame, obj: int, pier: KitTint, lintel: KitTint, span: f32, h: f32, thick: f32) {
  kit_pen(p, obj, MAT_WORLD, pier);
  box(buf, p, kit_at(f, -(span * 0.5 + thick * 0.5), h * 0.5, 0), thick * 0.5, h * 0.5, thick * 0.55);
  box(buf, p, kit_at(f, span * 0.5 + thick * 0.5, h * 0.5, 0), thick * 0.5, h * 0.5, thick * 0.55);
  kit_pen(p, obj + 1, MAT_WORLD, lintel);
  box(buf, p, kit_at(f, 0, h + thick * 0.55, 0), span * 0.5 + thick, thick * 0.55, thick * 0.6);
}

// A natural rock arch: a band of blocks along a half ellipse in the frame's x-y plane, its feet at
// x = -span/2 and span/2 on the ground, `rise` high, `thick` through the band and `depth` deep.
kit_arch_round :: (buf: [] u32, p: [] Pen, f: Frame, obj: int, c: KitTint, span: f32, rise: f32, thick: f32, depth: f32, segs: int) {
  kit_pen(p, obj, MAT_WORLD, c);
  for i: 0..<segs {
    a0 := PI * cast(f32) i / cast(f32) segs; a1 := PI * cast(f32) (i + 1) / cast(f32) segs;
    pa := fp(f, cos(a0) * span * 0.5, sin(a0) * rise, 0);
    pb := fp(f, cos(a1) * span * 0.5, sin(a1) * rise, 0);
    g := frame_along(pa, pb, f.z);
    w := 1.0f32 + 0.25 * (1 - sin((a0 + a1) * 0.5));   // the band is heavier toward its feet
    box(buf, p, frame_move(g, times(add(pa, pb), 0.5)), depth * 0.5, length(sub(pb, pa)) * 0.56, thick * 0.5 * w);
  }
}

// Canyon walls: two rows of tall blocks either side of a floor `gap` wide, from z0 to z1, their tops
// ragged, alternating two tints.
kit_canyon :: (buf: [] u32, p: [] Pen, obj: int, a: KitTint, b: KitTint, seed: f32, gap: f32, z0: f32, z1: f32, height: f32) {
  n := 14;
  run := (z1 - z0) / cast(f32) n;
  for side: 0..<2 {
    sx := ifx side == 0 then -1.0f32 else 1.0f32;
    for i: 0..<n {
      k := seed + cast(f32) (i + side * 31);
      w := 3 + kit_rand(k + 300) * 4;
      h := height * (0.6 + kit_rand(k + 310) * 0.7);
      x := sx * (gap * 0.5 + w * 0.5 + kit_rand(k + 320) * 1.5);
      z := z0 + (cast(f32) i + 0.5) * run;
      kit_pen(p, obj + side, MAT_WORLD, ifx i % 2 == 0 then a else b);
      block(buf, p, x, 0, z, w * 0.5, h, run * 0.55);
      if kit_rand(k + 330) > 0.5 { ellipsoid(buf, p, frame_at(v3(x, h, z), kit_rand(k + 340) * 6), w * 0.45, w * 0.3, run * 0.5, 8, 5, 0); }
    }
  }
}

// Stepped terraces: `levels` stacked blocks, each narrower, alternating tints, windows across each face.
kit_terraces :: (buf: [] u32, p: [] Pen, f: Frame, obj: int, a: KitTint, b: KitTint, win: KitTint, levels: int, w0: f32, d0: f32, h: f32) {
  for lvl: 0..<levels {
    k := cast(f32) lvl;
    hw := w0 * 0.5 - k * w0 * 0.09; hd := d0 * 0.5 - k * d0 * 0.075;
    kit_pen(p, obj, MAT_WORLD, ifx lvl % 2 == 0 then a else b);
    box(buf, p, kit_at(f, 0, k * h + h * 0.5, 0), hw, h * 0.5, hd);
    kit_pen(p, obj + 1, MAT_WINDOW, win);
    for w: 0..<4 {
      wx := (cast(f32) w - 1.5) * hw * 0.42;
      box(buf, p, kit_at(f, wx, k * h + h * 0.55, hd + 0.02), 0.5, 0.45, 0.02);
    }
  }
}

// Towers: tall round towers with domed caps and a ring band, scattered round (cx, cz).
kit_towers :: (buf: [] u32, p: [] Pen, obj: int, wall: KitTint, cap: KitTint, seed: f32, count: int, cx: f32, cz: f32, spread: f32, hmin: f32, hmax: f32) {
  for i: 0..<count {
    k := seed + cast(f32) i;
    x := cx + (kit_rand(k + 400) * 2 - 1) * spread;
    z := cz + (kit_rand(k + 410) * 2 - 1) * spread;
    h := hmin + kit_rand(k + 420) * (hmax - hmin);
    r := 2 + kit_rand(k + 430) * 3;
    kit_pen(p, obj, MAT_WORLD, wall);
    tube(buf, p, frame_at(v3(x, 0, z), 0), h, r, r, r * 0.85, r * 0.85, 12, true);
    kit_pen(p, obj + 1, MAT_WORLD, cap);
    tube(buf, p, frame_at(v3(x, h * 0.62, z), 0), h * 0.05, r * 1.08, r * 1.08, r * 1.04, r * 1.04, 12, true);
    ellipsoid(buf, p, frame_at(v3(x, h, z), 0), r * 0.9, r * 0.6, r * 0.9, 12, 6, 0);
  }
}

// A stair rising away along the frame's -z: `count` steps, each `rise` up and `run` deep, `width` wide.
kit_steps :: (buf: [] u32, p: [] Pen, f: Frame, obj: int, a: KitTint, b: KitTint, count: int, rise: f32, run: f32, width: f32) {
  for i: 0..<count {
    k := cast(f32) i;
    kit_pen(p, obj, MAT_WORLD, ifx i % 2 == 0 then a else b);
    box(buf, p, kit_at(f, 0, (k + 1) * rise * 0.5, -k * run), width * 0.5, (k + 1) * rise * 0.5, run * 0.5);
  }
}

// The sea: a flat plane at y from z = z_shore out, with foam lumps along the shore.
kit_sea :: (buf: [] u32, p: [] Pen, obj: int, water: KitTint, foam: KitTint, y: f32, z_shore: f32, seed: f32) {
  kit_pen(p, obj, MAT_FLAT, water);
  quad(buf, p, v3(-150, y, -150), v3(150, y, -150), v3(150, y, z_shore), v3(-150, y, z_shore));
  kit_pen(p, obj + 1, MAT_FLAT, foam);
  for i: 0..<18 {
    k := seed + cast(f32) i;
    x := (kit_rand(k + 500) * 2 - 1) * 40;
    z := z_shore - kit_rand(k + 510) * 30;
    r := 0.8 + kit_rand(k + 520) * 2.2;
    ellipsoid(buf, p, frame_at(v3(x, y, z), kit_rand(k + 530) * 6), r * 1.8, r * 0.35, r * 0.5, 10, 5, 0);
  }
}

// A palm: a leaning two-part trunk and seven drooping fronds.
kit_palm :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, trunk: KitTint, leaf: KitTint) {
  kit_pen(p, obj, MAT_SKIN, trunk);
  mid := fp(f, 0.3 * s, 3.0 * s, 0);
  top := fp(f, 0.9 * s, 6.0 * s, 0);
  limb(buf, p, f.o, mid, 0.3 * s, 0.24 * s, fd(f, 0, 0, 1), 8);
  limb(buf, p, mid, top, 0.24 * s, 0.18 * s, fd(f, 0, 0, 1), 8);
  kit_pen(p, obj + 1, MAT_WORLD, leaf);
  for i: 0..<7 {
    g := frame_turn(frame_at(top, cast(f32) i * TAU / 7), 0, 0.55);
    ellipsoid(buf, p, kit_at(g, 0, 0, 1.6 * s), 0.38 * s, 0.07 * s, 1.6 * s, 8, 4, 0);
  }
}

// A banner on a wall: a cloth panel with a sun disc on it, facing the frame's z.
kit_banner :: (buf: [] u32, p: [] Pen, f: Frame, obj: int, cloth: KitTint, sun: KitTint, w: f32, h: f32) {
  kit_pen(p, obj, MAT_CLOTH, cloth);
  box(buf, p, f, w * 0.5, h * 0.5, 0.08);
  kit_pen(p, obj + 1, MAT_GLOW, sun);
  oval(buf, p, kit_at(f, 0, 0, 0.1), w * 0.28, w * 0.28, 24);
}

// A moon (or a far planet) hanging in the sky at `at`.
kit_moon :: (buf: [] u32, p: [] Pen, obj: int, c: KitTint, at: Point, r: f32) {
  kit_pen(p, obj, MAT_GLOW, c);
  ellipsoid(buf, p, frame_at(at, 0), r, r, r, 24, 12, 0);
}

// A rock wall: a block from (x0, z0) to (x1, z1), h tall, with a darker strata band standing a
// little proud of it part way up and a ragged cap of lumps along its top.
kit_wall :: (buf: [] u32, p: [] Pen, obj: int, face: KitTint, band: KitTint, x0: f32, x1: f32, z0: f32, z1: f32, h: f32, seed: f32) {
  cx := (x0 + x1) * 0.5; cz := (z0 + z1) * 0.5; hx := (x1 - x0) * 0.5; hz := (z1 - z0) * 0.5;
  kit_pen(p, obj, MAT_WORLD, face);
  block(buf, p, cx, 0, cz, hx, h, hz);
  kit_pen(p, obj + 1, MAT_WORLD, band);
  block(buf, p, cx, h * 0.36, cz, hx + 0.12, h * 0.1, hz + 0.12);
  block(buf, p, cx, h * 0.72, cz, hx + 0.08, h * 0.05, hz + 0.08);
  kit_pen(p, obj, MAT_WORLD, face);
  n := cast(int) ((hx + hz) / 5) + 2;
  for i: 0..<n {
    k := seed + cast(f32) i;
    x := x0 + kit_rand(k + 600) * (x1 - x0); z := z0 + kit_rand(k + 610) * (z1 - z0);
    r := 1.5 + kit_rand(k + 620) * 2.5;
    ellipsoid(buf, p, frame_at(v3(x, h, z), kit_rand(k + 630) * 6), r, r * 0.5, r, 8, 5, 0);
  }
}

// A crate: a box with two bands and a lid light.
kit_crate :: (buf: [] u32, p: [] Pen, f: Frame, obj: int, wood: KitTint, band: KitTint, light: KitTint, w: f32) {
  kit_pen(p, obj, MAT_WORLD, wood);
  box(buf, p, kit_at(f, 0, w * 0.4, 0), w * 0.6, w * 0.4, w * 0.45);
  kit_pen(p, obj + 1, MAT_CLOTH, band);
  box(buf, p, kit_at(f, -w * 0.35, w * 0.4, 0), w * 0.06, w * 0.42, w * 0.47);
  box(buf, p, kit_at(f, w * 0.35, w * 0.4, 0), w * 0.06, w * 0.42, w * 0.47);
  kit_pen(p, obj + 2, MAT_GLOW, light);
  box(buf, p, kit_at(f, 0, w * 0.82, 0), w * 0.12, w * 0.03, w * 0.12);
}

#test "a mound's height is the drawn mesh's: 0 outside, its slopes to the edges, its flat top; a peak or a steep one holds a body out" {
  pts := [10] f32.[0, 0, 40, 0, 50, 20, 25, 35, 0, 20];   // a pentagon, counter-clockwise
  rev := [10] f32.[0, 20, 25, 35, 50, 20, 40, 0, 0, 0];   // the same, the other way round
  #assert land_mound_y(pts[..], 10, 8, 25, 18) == 10 && land_mound_y(rev[..], 10, 8, 25, 18) == 10;   // the top
  #assert land_mound_y(pts[..], 10, 8, 20, -1) == 0 && abs(land_mound_y(pts[..], 10, 8, 20, 4) - 5) < 0.001;   // outside; halfway up
  // every top corner is w in from both its edges, at the top's height
  for i: 0..<5 { c := land_mound_in(pts[..], 8, i); #assert abs(land_mound_d(pts[..], c.x, c.z) - 8) < 0.01 && abs(land_mound_y(pts[..], 10, 8, c.x, c.z) - 10) < 0.01; }
  q := land_mound_push(pts[..], 20, 1, 0.5);
  #assert abs(q.z + 0.5) < 0.001 && q.x == 20 && land_mound_push(pts[..], 20, -3, 0.5).z == -3;
  buf: [4000] u32; pen := [1] Pen.[Pen.{}];
  kit_mound(buf[..], pen[..], 1, kit_tint(0.7, 0.7, 0.7), kit_tint(0.5, 0.5, 0.5), pts[..], 10, 8);
  #assert !pen[0].over && pen[0].n == 5 * 6 + 3 * 6;
  for i: 0..<pen[0].n { y := f32_from_bits(buf[i * VERTEX_WORDS + 1]); x := f32_from_bits(buf[i * VERTEX_WORDS]); z := f32_from_bits(buf[i * VERTEX_WORDS + 2]); #assert abs(land_mound_y(pts[..], 10, 8, x, z) - y) < 0.02; }
}
#test "land pieces are deterministic: the same seed writes the same triangles" {
  a: [60000] u32; b: [60000] u32;
  pa := [1] Pen.[Pen.{}]; pb := [1] Pen.[Pen.{}];
  c := kit_tint(0.8, 0.5, 0.3);
  kit_rocks(a[..], pa[..], 4, c, 10, 7, 0, 0, 3, 9, 0.3, 1);
  kit_rocks(b[..], pb[..], 4, c, 10, 7, 0, 0, 3, 9, 0.3, 1);
  #assert pa[0].n == pb[0].n && pa[0].n > 0;
  for i: 0..<pa[0].n * VERTEX_WORDS { #assert a[i] == b[i]; }
}
