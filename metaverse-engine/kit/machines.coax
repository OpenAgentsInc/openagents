// Cel machines: small original robots, walkers and craft built with the cel mesh writers
// (metaverse-engine/render/cel-mesh.coax). Each is written from a Frame (where it stands and which way it
// faces) and a scale, in the colours it is handed, so one machine takes many looks and a scene
// places, turns and sizes it. Nothing here draws or decides; it only writes triangles.
// Object numbers: each machine takes the `obj` it is given and the next few, so ink separates its
// parts. Splice (metaverse/splice-bots/splice-bots.coax) stages them.
//   coax/bin/coax test --library metaverse-engine/kit/machines.coax
#load "../render/cel-mesh.coax";

// A colour (sRGB) a kit piece is drawn in.
KitTint :: struct { r: f32; g: f32; b: f32; }
kit_tint :: (r: f32, g: f32, b: f32) -> KitTint { return KitTint.{r = r, g = g, b = b}; }
kit_pen :: (p: [] Pen, obj: int, mat: int, c: KitTint) { pen_set(p, obj, mat, c.r, c.g, c.b); }
// A deterministic value in [0, 1) for a seed: the same scene writes the same triangles.
kit_rand :: (k: f32) -> f32 { v := sin(k * 127.1 + 311.7) * 43758.5453; return v - floor(v); }
// The frame at local (x, y, z) of f, its axes kept.
kit_at :: (f: Frame, x: f32, y: f32, z: f32) -> Frame { return frame_move(f, fp(f, x, y, z)); }

// The boxy robot: legs, feet, hips, torso with a band, a head with a visor and an eye strip, a chest
// light, an antenna, one arm hanging and one raised by `wave` (0 down to 1 straight up). 3.3 m at s 1.
kit_robot :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, body: KitTint, band: KitTint, glow: KitTint, dark: KitTint, wave: f32) {
  kit_pen(p, obj, MAT_CLOTH, dark);
  box(buf, p, kit_at(f, -0.28 * s, 0.42 * s, 0), 0.14 * s, 0.42 * s, 0.14 * s);
  box(buf, p, kit_at(f, 0.28 * s, 0.42 * s, 0), 0.14 * s, 0.42 * s, 0.14 * s);
  box(buf, p, kit_at(f, 0, 1.02 * s, 0), 0.42 * s, 0.14 * s, 0.32 * s);
  kit_pen(p, obj + 1, MAT_SKIN, body);
  box(buf, p, kit_at(f, -0.28 * s, 0.07 * s, 0.06 * s), 0.20 * s, 0.07 * s, 0.26 * s);
  box(buf, p, kit_at(f, 0.28 * s, 0.07 * s, 0.06 * s), 0.20 * s, 0.07 * s, 0.26 * s);
  box(buf, p, kit_at(f, 0, 1.55 * s, 0), 0.50 * s, 0.45 * s, 0.36 * s);
  box(buf, p, kit_at(f, 0, 2.30 * s, 0), 0.36 * s, 0.30 * s, 0.32 * s);
  kit_pen(p, obj + 2, MAT_FLAT, band);
  box(buf, p, kit_at(f, 0, 1.2 * s, 0), 0.52 * s, 0.07 * s, 0.37 * s);
  ball(buf, p, fp(f, 0.14 * s, 3.2 * s, 0), 0.08 * s, 10);
  kit_pen(p, obj + 3, MAT_WINDOW, dark);
  box(buf, p, kit_at(f, 0, 2.33 * s, 0.33 * s), 0.28 * s, 0.10 * s, 0.02 * s);
  tube(buf, p, frame_at(fp(f, 0.14 * s, 2.62 * s, 0), 0), 0.55 * s, 0.03 * s, 0.03 * s, 0.03 * s, 0.03 * s, 6, true);
  kit_pen(p, obj + 4, MAT_GLOW, glow);
  ball(buf, p, fp(f, 0, 1.6 * s, 0.42 * s), 0.11 * s, 12);
  box(buf, p, kit_at(f, 0, 2.33 * s, 0.345 * s), 0.20 * s, 0.03 * s, 0.01 * s);
  kit_pen(p, obj + 1, MAT_SKIN, body);
  limb(buf, p, fp(f, -0.62 * s, 1.9 * s, 0), fp(f, -0.80 * s, 1.22 * s, 0.10 * s), 0.11 * s, 0.09 * s, fd(f, 0, 0, 1), 8);
  // the raised arm swings from hanging (wave 0) to straight up (wave 1)
  a := clamp01(wave) * 2.6;
  hand := fp(f, 0.62 * s + sin(a) * 0.95 * s, 1.9 * s - cos(a) * 0.95 * s, 0.10 * s);
  limb(buf, p, fp(f, 0.62 * s, 1.9 * s, 0), hand, 0.11 * s, 0.09 * s, fd(f, 0, 0, 1), 8);
  ball(buf, p, hand, 0.14 * s, 10);
}

// The scissor crab: a shell on six splayed legs, two pincer arms reaching ahead. 1 m tall at s 1.
kit_crab :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, shell: KitTint, claw: KitTint, dark: KitTint) {
  kit_pen(p, obj, MAT_FLAT, shell);
  ellipsoid(buf, p, kit_at(f, 0, 0.75 * s, 0), 1.15 * s, 0.5 * s, 0.9 * s, 12, 6, 0);
  kit_pen(p, obj + 1, MAT_FLAT, claw);
  for side: 0..<2 {
    sx := ifx side == 0 then -1.0f32 else 1.0f32;
    limb(buf, p, fp(f, sx * 0.8 * s, 0.9 * s, 0.7 * s), fp(f, sx * 1.7 * s, 0.95 * s, 1.5 * s), 0.13 * s, 0.11 * s, fd(f, 0, 1, 0), 8);
    ball(buf, p, fp(f, sx * 1.85 * s, 0.95 * s, 1.75 * s), 0.34 * s, 10);
  }
  kit_pen(p, obj + 2, MAT_CLOTH, dark);
  for side: 0..<2 {
    sx := ifx side == 0 then -1.0f32 else 1.0f32;
    for j: 0..<3 {
      z := (-0.4 + cast(f32) j * 0.45) * s;
      limb(buf, p, fp(f, sx * 0.9 * s, 0.6 * s, z), fp(f, sx * 1.8 * s, 0.05 * s, z + 0.1 * s), 0.07 * s, 0.05 * s, fd(f, 0, 0, 1), 6);
    }
  }
}

// The walker: a round shell high on four long jointed legs, two bands round it. 4 m tall at s 1.
kit_walker :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, shell: KitTint, band: KitTint, dark: KitTint) {
  kit_pen(p, obj, MAT_SKIN, shell);
  ellipsoid(buf, p, kit_at(f, 0, 4.0 * s, 0), 1.25 * s, 1.0 * s, 1.05 * s, 14, 8, 0);
  kit_pen(p, obj + 1, MAT_FLAT, band);
  box(buf, p, kit_at(f, 0, 4.6 * s, 1.0 * s), 0.95 * s, 0.12 * s, 0.05 * s);
  box(buf, p, kit_at(f, 0, 3.5 * s, 1.0 * s), 0.95 * s, 0.10 * s, 0.05 * s);
  kit_pen(p, obj + 2, MAT_CLOTH, dark);
  for i: 0..<4 {
    sx := ifx i % 2 == 0 then -1.0f32 else 1.0f32;
    sz := ifx i < 2 then -1.0f32 else 1.0f32;
    hip := fp(f, sx * 0.8 * s, 3.4 * s, sz * 0.6 * s);
    knee := fp(f, sx * 2.3 * s, 2.2 * s, sz * 1.6 * s);
    foot := fp(f, sx * 2.7 * s, 0.2 * s, sz * 2.1 * s);
    limb(buf, p, hip, knee, 0.24 * s, 0.17 * s, fd(f, 1, 0, 0), 8);
    limb(buf, p, knee, foot, 0.17 * s, 0.12 * s, fd(f, 1, 0, 0), 8);
    ball(buf, p, foot, 0.28 * s, 10);
  }
}

// The spider: a low domed shell on eight legs, each leg banded (shell colour to the knee, dark
// below, a band ball at the knee). 2 m tall at s 1.
kit_spider :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, shell: KitTint, band: KitTint, dark: KitTint) {
  kit_pen(p, obj, MAT_SKIN, shell);
  ellipsoid(buf, p, kit_at(f, 0, 1.25 * s, 0), 1.25 * s, 0.75 * s, 1.05 * s, 14, 8, 0);
  kit_pen(p, obj + 1, MAT_FLAT, band);
  ellipsoid(buf, p, kit_at(f, 0, 1.25 * s, 0.85 * s), 0.55 * s, 0.32 * s, 0.35 * s, 10, 5, 0);
  for i: 0..<8 {
    side := ifx i < 4 then -1.0f32 else 1.0f32;
    z := (-0.75 + cast(f32) (i % 4) * 0.5) * s;
    hip := fp(f, side * 1.0 * s, 1.1 * s, z);
    knee := fp(f, side * 1.9 * s, 1.85 * s, z * 1.4);
    foot := fp(f, side * 2.7 * s, 0.05 * s, z * 1.9);
    kit_pen(p, obj + 1, MAT_FLAT, band);
    limb(buf, p, hip, knee, 0.16 * s, 0.13 * s, fd(f, 0, 0, 1), 8);
    ball(buf, p, knee, 0.19 * s, 8);
    kit_pen(p, obj + 2, MAT_CLOTH, dark);
    limb(buf, p, knee, foot, 0.13 * s, 0.07 * s, fd(f, 0, 0, 1), 8);
  }
}

// The beast: a long-bodied quadruped machine with a neck and a blunt head; with `cargo` a bundle
// is strapped high on its back (the pack walker). 4 m at the shoulder at s 1.
kit_beast :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, hide: KitTint, dark: KitTint, pack: KitTint, cargo: bool) {
  kit_pen(p, obj, MAT_SKIN, hide);
  box(buf, p, kit_at(f, 0, 3.6 * s, 0), 0.9 * s, 0.75 * s, 2.0 * s);
  limb(buf, p, fp(f, 0, 3.9 * s, 1.8 * s), fp(f, 0, 5.0 * s, 2.9 * s), 0.38 * s, 0.3 * s, fd(f, 1, 0, 0), 8);
  box(buf, p, kit_at(f, 0, 5.1 * s, 3.3 * s), 0.42 * s, 0.38 * s, 0.6 * s);
  kit_pen(p, obj + 1, MAT_CLOTH, dark);
  box(buf, p, kit_at(f, 0, 5.1 * s, 3.92 * s), 0.30 * s, 0.10 * s, 0.03 * s);
  for i: 0..<4 {
    sx := ifx i % 2 == 0 then -1.0f32 else 1.0f32;
    sz := ifx i < 2 then -1.0f32 else 1.0f32;
    hip := fp(f, sx * 0.75 * s, 3.2 * s, sz * 1.5 * s);
    knee := fp(f, sx * 0.95 * s, 1.7 * s, sz * 1.5 * s + 0.45 * s);
    foot := fp(f, sx * 0.95 * s, 0.15 * s, sz * 1.5 * s);
    limb(buf, p, hip, knee, 0.24 * s, 0.18 * s, fd(f, 1, 0, 0), 8);
    limb(buf, p, knee, foot, 0.18 * s, 0.14 * s, fd(f, 1, 0, 0), 8);
    ball(buf, p, foot, 0.24 * s, 8);
  }
  if cargo {
    kit_pen(p, obj + 2, MAT_CLOTH, pack);
    ellipsoid(buf, p, kit_at(f, 0, 4.9 * s, -0.3 * s), 1.1 * s, 0.75 * s, 1.5 * s, 12, 6, 0);
    ellipsoid(buf, p, kit_at(f, 0.2 * s, 5.8 * s, -0.6 * s), 0.8 * s, 0.55 * s, 1.0 * s, 12, 6, 0);
    ellipsoid(buf, p, kit_at(f, -0.1 * s, 6.4 * s, -0.2 * s), 0.5 * s, 0.4 * s, 0.6 * s, 10, 5, 0);
    kit_pen(p, obj + 1, MAT_CLOTH, dark);
    box(buf, p, kit_at(f, 0, 4.9 * s, 0.4 * s), 1.15 * s, 0.08 * s, 0.08 * s);
    box(buf, p, kit_at(f, 0, 4.9 * s, -1.0 * s), 1.15 * s, 0.08 * s, 0.08 * s);
  }
}

// The tank crab: a dome on two treads, twin barrels ahead and a lens. 1.6 m tall at s 1.
kit_tank :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, shell: KitTint, tread: KitTint, lens: KitTint) {
  kit_pen(p, obj, MAT_SKIN, shell);
  ellipsoid(buf, p, kit_at(f, 0, 1.0 * s, 0), 1.0 * s, 0.6 * s, 1.1 * s, 14, 7, 0);
  kit_pen(p, obj + 1, MAT_CLOTH, tread);
  box(buf, p, kit_at(f, -1.0 * s, 0.4 * s, 0), 0.28 * s, 0.38 * s, 1.15 * s);
  box(buf, p, kit_at(f, 1.0 * s, 0.4 * s, 0), 0.28 * s, 0.38 * s, 1.15 * s);
  limb(buf, p, fp(f, -0.35 * s, 1.0 * s, 0.9 * s), fp(f, -0.35 * s, 1.05 * s, 1.9 * s), 0.1 * s, 0.09 * s, fd(f, 0, 1, 0), 8);
  limb(buf, p, fp(f, 0.35 * s, 1.0 * s, 0.9 * s), fp(f, 0.35 * s, 1.05 * s, 1.9 * s), 0.1 * s, 0.09 * s, fd(f, 0, 1, 0), 8);
  kit_pen(p, obj + 2, MAT_GLOW, lens);
  ball(buf, p, fp(f, 0, 1.35 * s, 0.95 * s), 0.14 * s, 10);
}

// The big round mech: a tall rounded body-head with a visor and lens, heavy arms to the ground,
// short thick legs, accent plates. 4.5 m tall at s 1.
kit_mech :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, shell: KitTint, accent: KitTint, dark: KitTint, lens: KitTint) {
  kit_pen(p, obj, MAT_SKIN, shell);
  ellipsoid(buf, p, kit_at(f, 0, 3.0 * s, 0), 1.3 * s, 1.5 * s, 1.15 * s, 16, 9, 0);
  ball(buf, p, fp(f, -1.35 * s, 2.9 * s, 0), 0.55 * s, 12);
  ball(buf, p, fp(f, 1.35 * s, 2.9 * s, 0), 0.55 * s, 12);
  limb(buf, p, fp(f, -1.5 * s, 2.7 * s, 0), fp(f, -1.8 * s, 0.9 * s, 0.3 * s), 0.45 * s, 0.38 * s, fd(f, 0, 0, 1), 10);
  limb(buf, p, fp(f, 1.5 * s, 2.7 * s, 0), fp(f, 1.8 * s, 0.9 * s, 0.3 * s), 0.45 * s, 0.38 * s, fd(f, 0, 0, 1), 10);
  box(buf, p, kit_at(f, -1.8 * s, 0.45 * s, 0.35 * s), 0.5 * s, 0.45 * s, 0.6 * s);
  box(buf, p, kit_at(f, 1.8 * s, 0.45 * s, 0.35 * s), 0.5 * s, 0.45 * s, 0.6 * s);
  kit_pen(p, obj + 1, MAT_CLOTH, dark);
  limb(buf, p, fp(f, -0.6 * s, 1.7 * s, 0), fp(f, -0.7 * s, 0.2 * s, 0.1 * s), 0.42 * s, 0.38 * s, fd(f, 0, 0, 1), 10);
  limb(buf, p, fp(f, 0.6 * s, 1.7 * s, 0), fp(f, 0.7 * s, 0.2 * s, 0.1 * s), 0.42 * s, 0.38 * s, fd(f, 0, 0, 1), 10);
  box(buf, p, kit_at(f, 0, 3.7 * s, 1.0 * s), 0.75 * s, 0.32 * s, 0.12 * s);
  kit_pen(p, obj + 2, MAT_FLAT, accent);
  box(buf, p, kit_at(f, -1.0 * s, 2.2 * s, 0.85 * s), 0.18 * s, 0.35 * s, 0.05 * s);
  box(buf, p, kit_at(f, 1.0 * s, 2.2 * s, 0.85 * s), 0.18 * s, 0.35 * s, 0.05 * s);
  box(buf, p, kit_at(f, -1.8 * s, 0.75 * s, 0.97 * s), 0.3 * s, 0.06 * s, 0.03 * s);
  box(buf, p, kit_at(f, 1.8 * s, 0.75 * s, 0.97 * s), 0.3 * s, 0.06 * s, 0.03 * s);
  kit_pen(p, obj + 3, MAT_GLOW, lens);
  ball(buf, p, fp(f, 0.3 * s, 3.7 * s, 1.12 * s), 0.13 * s, 10);
}

// The rover: a long body, a cab, four wheels and a mast. 2 m tall at s 1.
kit_rover :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, body: KitTint, cab: KitTint, wheel: KitTint) {
  kit_pen(p, obj, MAT_SKIN, body);
  box(buf, p, kit_at(f, 0, 0.9 * s, 0), 0.85 * s, 0.4 * s, 1.6 * s);
  kit_pen(p, obj + 1, MAT_FLAT, cab);
  box(buf, p, kit_at(f, 0, 1.55 * s, 0.7 * s), 0.7 * s, 0.3 * s, 0.6 * s);
  kit_pen(p, obj + 2, MAT_CLOTH, wheel);
  for i: 0..<4 {
    sx := ifx i % 2 == 0 then -1.0f32 else 1.0f32;
    sz := ifx i < 2 then -1.1f32 else 1.1f32;
    limb(buf, p, fp(f, sx * 0.8 * s, 0.45 * s, sz * s), fp(f, sx * 1.1 * s, 0.45 * s, sz * s), 0.45 * s, 0.45 * s, fd(f, 0, 1, 0), 14);
  }
  tube(buf, p, frame_at(fp(f, -0.5 * s, 1.3 * s, -1.2 * s), 0), 1.2 * s, 0.04 * s, 0.04 * s, 0.03 * s, 0.03 * s, 6, true);
}

// The hoverboard (metaverse-engine/action/hoverboard.coax): a deck along the frame's z with a kicked
// nose and tail, a stripe, and two thrusters under it that glow brighter and trail longer with
// `thrust` (0 at rest to 1 at full rush). The frame stands at the deck's underside; 1.3 m long at s 1.
kit_hoverboard :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, deck: KitTint, stripe: KitTint, glow: KitTint, thrust: f32) {
  kit_pen(p, obj, MAT_SKIN, deck);
  box(buf, p, kit_at(f, 0, 0.04 * s, 0), 0.22 * s, 0.035 * s, 0.5 * s);
  box(buf, p, frame_turn(kit_at(f, 0, 0.07 * s, 0.6 * s), 0, -0.35), 0.2 * s, 0.03 * s, 0.13 * s);    // the nose, kicked up
  box(buf, p, frame_turn(kit_at(f, 0, 0.07 * s, -0.6 * s), 0, 0.35), 0.2 * s, 0.03 * s, 0.13 * s);    // the tail
  kit_pen(p, obj + 1, MAT_FLAT, stripe);
  box(buf, p, kit_at(f, 0, 0.078 * s, 0), 0.05 * s, 0.006 * s, 0.46 * s);
  kit_pen(p, obj + 2, MAT_CLOTH, kit_tint(0.16, 0.15, 0.14));
  for i: 0..<2 { box(buf, p, kit_at(f, 0, -0.02 * s, (ifx i == 0 then 0.32f32 else -0.32f32) * s), 0.15 * s, 0.04 * s, 0.09 * s); }
  kit_pen(p, obj + 3, MAT_GLOW, glow);
  k := ifx thrust < 0 then 0.0f32 else ifx thrust > 1 then 1.0f32 else thrust;
  for i: 0..<2 {
    z := (ifx i == 0 then 0.32f32 else -0.32f32) * s;
    box(buf, p, kit_at(f, 0, -0.07 * s, z), 0.11 * s, 0.012 * s, 0.06 * s);
    ball(buf, p, fp(f, 0, -0.1 * s, z - 0.05 * k * s), (0.05 + 0.03 * k) * s, 8);
  }
  // at speed the jet trails out behind
  if k > 0.05 { tube(buf, p, frame_turn(kit_at(f, 0, -0.08 * s, -0.42 * s), 0, -1.5707963), (0.2 + 0.9 * k) * s, 0.05 * s, 0.05 * s, 0.01 * s, 0.01 * s, 6, false); }
}

// The wind turbine: a mast, a nacelle facing the frame's z and three blades at `spin` radians.
kit_turbine :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, mast: KitTint, blade: KitTint, spin: f32) {
  kit_pen(p, obj, MAT_SKIN, mast);
  tube(buf, p, f, 9.0 * s, 0.35 * s, 0.35 * s, 0.2 * s, 0.2 * s, 10, true);
  box(buf, p, kit_at(f, 0, 9.2 * s, 0.2 * s), 0.35 * s, 0.35 * s, 0.7 * s);
  kit_pen(p, obj + 1, MAT_SKIN, blade);
  hub := kit_at(f, 0, 9.2 * s, 0.95 * s);
  ball(buf, p, hub.o, 0.22 * s, 10);
  for i: 0..<3 {
    g := frame_turn(hub, 2, spin + cast(f32) i * TAU / 3);
    box(buf, p, kit_at(g, 0, 1.7 * s, 0), 0.16 * s, 1.6 * s, 0.04 * s);
  }
}

// The airship: a long hull, a deck cabin, a mast and a square sail, floating where f stands.
kit_airship :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, hull: KitTint, sail: KitTint, dark: KitTint) {
  kit_pen(p, obj, MAT_SKIN, hull);
  ellipsoid(buf, p, f, 1.1 * s, 0.8 * s, 3.6 * s, 14, 7, 0);
  kit_pen(p, obj + 1, MAT_CLOTH, dark);
  box(buf, p, kit_at(f, 0, 0.9 * s, -0.4 * s), 0.6 * s, 0.35 * s, 1.2 * s);
  tube(buf, p, kit_at(f, 0, 0.7 * s, 0.6 * s), 3.2 * s, 0.07 * s, 0.07 * s, 0.05 * s, 0.05 * s, 6, true);
  kit_pen(p, obj + 2, MAT_CLOTH, sail);
  box(buf, p, kit_at(f, 0, 2.6 * s, 0.6 * s), 1.3 * s, 1.0 * s, 0.03 * s);
}

// A bird in flight: two thin wings in a shallow V.
kit_bird :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, c: KitTint) {
  kit_pen(p, obj, MAT_FLAT, c);
  box(buf, p, kit_at(frame_turn(f, 2, 0.35), -0.6 * s, 0, 0), 0.6 * s, 0.04 * s, 0.18 * s);
  box(buf, p, kit_at(frame_turn(f, 2, -0.35), 0.6 * s, 0, 0), 0.6 * s, 0.04 * s, 0.18 * s);
}

// The Digger: a squat body on two treads, a drill arm ahead and a battery on its back. Each part
// is drawn only when the caller has it (arm, treads, battery), so a half-built Digger shows what
// is missing. `spin` turns the drill; `glow` is the battery's and the eye's light. 1.6 m tall at s 1.
kit_digger :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, body: KitTint, dark: KitTint, accent: KitTint, glow: KitTint, arm: bool, treads: bool, battery: bool, spin: f32) {
  kit_pen(p, obj, MAT_SKIN, body);
  box(buf, p, kit_at(f, 0, 0.95 * s, 0), 0.62 * s, 0.42 * s, 0.8 * s);
  box(buf, p, kit_at(f, 0, 1.52 * s, 0.25 * s), 0.4 * s, 0.2 * s, 0.4 * s);
  kit_pen(p, obj + 1, MAT_WINDOW, dark);
  box(buf, p, kit_at(f, 0, 1.55 * s, 0.66 * s), 0.3 * s, 0.09 * s, 0.02 * s);
  if treads {
    kit_pen(p, obj + 2, MAT_CLOTH, dark);
    for side: 0..<2 {
      sx := ifx side == 0 then -1.0f32 else 1.0f32;
      box(buf, p, kit_at(f, sx * 0.8 * s, 0.3 * s, 0), 0.2 * s, 0.3 * s, 1.0 * s);
      limb(buf, p, fp(f, sx * 0.6 * s, 0.3 * s, 0.95 * s), fp(f, sx * 1.0 * s, 0.3 * s, 0.95 * s), 0.3 * s, 0.3 * s, fd(f, 0, 1, 0), 10);
      limb(buf, p, fp(f, sx * 0.6 * s, 0.3 * s, -0.95 * s), fp(f, sx * 1.0 * s, 0.3 * s, -0.95 * s), 0.3 * s, 0.3 * s, fd(f, 0, 1, 0), 10);
    }
  } else {
    kit_pen(p, obj + 2, MAT_CLOTH, dark);
    box(buf, p, kit_at(f, 0, 0.3 * s, 0), 0.5 * s, 0.25 * s, 0.6 * s);   // on blocks until it has treads
  }
  if arm {
    kit_pen(p, obj + 3, MAT_FLAT, accent);
    limb(buf, p, fp(f, 0, 1.0 * s, 0.7 * s), fp(f, 0, 0.95 * s, 1.35 * s), 0.2 * s, 0.24 * s, fd(f, 1, 0, 0), 8);
    g := frame_turn(frame_along(fp(f, 0, 0.95 * s, 1.35 * s), fp(f, 0, 0.9 * s, 2.3 * s), fd(f, 1, 0, 0)), 1, spin);
    kit_pen(p, obj + 4, MAT_SKIN, body);
    tube(buf, p, g, 0.95 * s, 0.34 * s, 0.34 * s, 0.02 * s, 0.02 * s, 6, true);
  }
  if battery {
    kit_pen(p, obj + 5, MAT_GLOW, glow);
    box(buf, p, kit_at(f, 0, 1.25 * s, -0.55 * s), 0.34 * s, 0.3 * s, 0.2 * s);
    box(buf, p, kit_at(f, 0, 1.55 * s, 0.675 * s), 0.2 * s, 0.03 * s, 0.01 * s);
  }
}

// A cloaked figure: legs, a poncho cone, a head under a wide hat and a pack. `stride` (radians)
// swings the legs as it walks. 1.8 m tall at s 1.
kit_figure :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, cloak: KitTint, skin: KitTint, dark: KitTint, hat: KitTint, stride: f32) {
  sw := sin(stride) * 0.28 * s;
  kit_pen(p, obj, MAT_CLOTH, dark);
  limb(buf, p, fp(f, -0.16 * s, 0.85 * s, 0), fp(f, -0.16 * s, 0.05 * s, sw), 0.11 * s, 0.09 * s, fd(f, 1, 0, 0), 6);
  limb(buf, p, fp(f, 0.16 * s, 0.85 * s, 0), fp(f, 0.16 * s, 0.05 * s, -sw), 0.11 * s, 0.09 * s, fd(f, 1, 0, 0), 6);
  box(buf, p, kit_at(f, 0, 1.15 * s, -0.3 * s), 0.22 * s, 0.26 * s, 0.12 * s);
  kit_pen(p, obj + 1, MAT_CLOTH, cloak);
  tube(buf, p, kit_at(f, 0, 0.7 * s, 0), 0.85 * s, 0.46 * s, 0.36 * s, 0.14 * s, 0.14 * s, 10, true);
  kit_pen(p, obj + 2, MAT_SKIN, skin);
  ball(buf, p, fp(f, 0, 1.66 * s, 0), 0.17 * s, 10);
  kit_pen(p, obj + 3, MAT_CLOTH, hat);
  tube(buf, p, kit_at(f, 0, 1.76 * s, 0), 0.16 * s, 0.4 * s, 0.4 * s, 0.1 * s, 0.1 * s, 12, true);
}

// A prism along the frame's z from z0 to z1: its cross-section runs from x b0 to b1 at y0 and from
// t0 to t1 at y1 (b0 < b1, t0 < t1), so its sides slope as armour plates do. Six faces, normals out.
kit_prism :: (buf: [] u32, p: [] Pen, f: Frame, b0: f32, b1: f32, t0: f32, t1: f32, y0: f32, y1: f32, z0: f32, z1: f32) {
  a := fp(f, b0, y0, z1); b := fp(f, b1, y0, z1); c := fp(f, t1, y1, z1); d := fp(f, t0, y1, z1);
  a2 := fp(f, b0, y0, z0); b2 := fp(f, b1, y0, z0); c2 := fp(f, t1, y1, z0); d2 := fp(f, t0, y1, z0);
  quad(buf, p, a, b, c, d);       // +z
  quad(buf, p, b2, a2, d2, c2);   // -z
  quad(buf, p, d, c, c2, d2);     // top
  quad(buf, p, a2, b2, b, a);     // bottom
  quad(buf, p, b, b2, c2, c);     // +x side
  quad(buf, p, a, d, d2, a2);     // -x side
}

// One car of the rover train, from zb (its back) to zf (its front), on two track units. The cab
// car has a wedge nose with a dark windshield, headlights and a mast; the last car a rear hatch
// open on a lowered ramp. Every car has angled roof plates, side armour, an orange diagonal stripe
// and a glow strip down each side.
kit_train_car :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, zb: f32, zf: f32, cab: bool, last: bool, body: KitTint, stripe: KitTint, glow: KitTint, dark: KitTint) {
  zc := (zb + zf) * 0.5; hz := (zf - zb) * 0.5;
  // two track units: a belt with round ends and three road wheels on its outer face
  tl := hz - 0.55;
  for side: 0..<2 {
    sx := ifx side == 0 then -1.0f32 else 1.0f32;
    x := sx * 0.96;
    kit_pen(p, obj, MAT_CLOTH, dark);
    box(buf, p, kit_at(f, x * s, 0.4 * s, zc * s), 0.27 * s, 0.4 * s, tl * s);
    limb(buf, p, fp(f, (x - 0.27) * s, 0.4 * s, (zc + tl) * s), fp(f, (x + 0.27) * s, 0.4 * s, (zc + tl) * s), 0.4 * s, 0.4 * s, fd(f, 0, 1, 0), 8);
    limb(buf, p, fp(f, (x - 0.27) * s, 0.4 * s, (zc - tl) * s), fp(f, (x + 0.27) * s, 0.4 * s, (zc - tl) * s), 0.4 * s, 0.4 * s, fd(f, 0, 1, 0), 8);
    kit_pen(p, obj + 1, MAT_SKIN, body);
    for w: 0..<3 {
      wz := zc + (cast(f32) w - 1) * tl;
      limb(buf, p, fp(f, (x + sx * 0.27) * s, 0.4 * s, wz * s), fp(f, (x + sx * 0.31) * s, 0.4 * s, wz * s), 0.2 * s, 0.2 * s, fd(f, 0, 1, 0), 6);
    }
  }
  // the body, and its roof of angled plates
  kit_pen(p, obj + 2, MAT_SKIN, body);
  if cab {
    box(buf, p, kit_at(f, 0, 1.225 * s, zc * s), 1.2 * s, 0.475 * s, hz * s);
    // the wedge: in g, x runs back along the car (-z) and z across it, so its -x face slopes up and back
    g := frame_turn(f, 1, PI * 0.5);
    kit_prism(buf, p, g, -(zf - 0.1) * s, -zb * s, -(zf - 1.05) * s, -zb * s, 1.7 * s, 2.45 * s, -1.2 * s, 1.2 * s);
    kit_prism(buf, p, f, -1.2 * s, 1.2 * s, -0.85 * s, 0.85 * s, 2.45 * s, 2.85 * s, zb * s, (zf - 0.95) * s);
    kit_pen(p, obj + 3, MAT_WINDOW, dark);
    w0 := fp(f, 0, 1.72 * s, (zf - 0.08) * s); w1 := fp(f, 0, 2.43 * s, (zf - 1.03) * s);
    box(buf, p, frame_move(frame_along(w0, w1, fd(f, 1, 0, 0)), times(add(w0, w1), 0.5)), 1.05 * s, length(sub(w1, w0)) * 0.5, 0.03 * s);
    // a nose plate sloping from the tracks up to the body, and the headlights
    kit_pen(p, obj + 4, MAT_FLAT, stripe);
    n0 := fp(f, 0, 0.8 * s, (zf + 0.42) * s); n1 := fp(f, 0, 1.5 * s, (zf + 0.03) * s);
    box(buf, p, frame_move(frame_along(n0, n1, fd(f, 1, 0, 0)), times(add(n0, n1), 0.5)), 1.1 * s, length(sub(n1, n0)) * 0.5, 0.05 * s);
    kit_pen(p, obj + 5, MAT_GLOW, glow);
    box(buf, p, kit_at(f, -0.8 * s, 1.62 * s, (zf + 0.01) * s), 0.18 * s, 0.06 * s, 0.02 * s);
    box(buf, p, kit_at(f, 0.8 * s, 1.62 * s, (zf + 0.01) * s), 0.18 * s, 0.06 * s, 0.02 * s);
    // the mast: a pole with a crossbar and a light on top
    kit_pen(p, obj + 3, MAT_CLOTH, dark);
    tube(buf, p, kit_at(f, 0.55 * s, 2.85 * s, (zb + 0.7) * s), 0.8 * s, 0.045 * s, 0.045 * s, 0.03 * s, 0.03 * s, 6, true);
    box(buf, p, kit_at(f, 0.55 * s, 3.4 * s, (zb + 0.7) * s), 0.22 * s, 0.025 * s, 0.025 * s);
    kit_pen(p, obj + 5, MAT_GLOW, glow);
    ball(buf, p, fp(f, 0.55 * s, 3.7 * s, (zb + 0.7) * s), 0.08 * s, 8);
  } else {
    box(buf, p, kit_at(f, 0, 1.6 * s, zc * s), 1.2 * s, 0.85 * s, hz * s);
    kit_prism(buf, p, f, -1.2 * s, 1.2 * s, -0.85 * s, 0.85 * s, 2.45 * s, 2.85 * s, zb * s, zf * s);
    kit_pen(p, obj + 3, MAT_WINDOW, dark);
    box(buf, p, kit_at(f, -1.215 * s, 2.05 * s, (zc - 0.5 * hz) * s), 0.02 * s, 0.18 * s, 0.35 * s);
    box(buf, p, kit_at(f, 1.215 * s, 2.05 * s, (zc - 0.5 * hz) * s), 0.02 * s, 0.18 * s, 0.35 * s);
  }
  // side armour over the tracks, the stripe and the glow strips
  kit_pen(p, obj + 1, MAT_SKIN, body);
  box(buf, p, kit_at(f, -1.22 * s, 0.98 * s, zc * s), 0.03 * s, 0.2 * s, (hz - 0.1) * s);
  box(buf, p, kit_at(f, 1.22 * s, 0.98 * s, zc * s), 0.03 * s, 0.2 * s, (hz - 0.1) * s);
  kit_pen(p, obj + 4, MAT_FLAT, stripe);
  right := frame_turn(kit_at(f, 1.255 * s, 0, zc * s), 1, PI * 0.5);    // its x runs back along the car
  left := frame_turn(kit_at(f, -1.255 * s, 0, zc * s), 1, -PI * 0.5);   // its x runs ahead
  dash(buf, p, right, 0.55 * hz * s, 0.85 * s, -0.35 * hz * s, 2.4 * s, 0.42 * s, 0.42 * s);
  dash(buf, p, left, -0.55 * hz * s, 0.85 * s, 0.35 * hz * s, 2.4 * s, 0.42 * s, 0.42 * s);
  kit_pen(p, obj + 5, MAT_GLOW, glow);
  box(buf, p, kit_at(f, -1.255 * s, 1.24 * s, zc * s), 0.012 * s, 0.035 * s, (hz - 0.2) * s);
  box(buf, p, kit_at(f, 1.255 * s, 1.24 * s, zc * s), 0.012 * s, 0.035 * s, (hz - 0.2) * s);
  if last {
    // the rear hatch, open: a dark doorway in an orange frame, its ramp down to the ground
    kit_pen(p, obj + 3, MAT_WINDOW, dark);
    box(buf, p, kit_at(f, 0, 1.6 * s, (zb - 0.01) * s), 0.75 * s, 0.75 * s, 0.02 * s);
    kit_pen(p, obj + 4, MAT_FLAT, stripe);
    box(buf, p, kit_at(f, 0, 2.4 * s, (zb - 0.03) * s), 0.87 * s, 0.06 * s, 0.03 * s);
    box(buf, p, kit_at(f, -0.81 * s, 1.6 * s, (zb - 0.03) * s), 0.06 * s, 0.8 * s, 0.03 * s);
    box(buf, p, kit_at(f, 0.81 * s, 1.6 * s, (zb - 0.03) * s), 0.06 * s, 0.8 * s, 0.03 * s);
    r0 := fp(f, 0, 0.84 * s, (zb - 0.04) * s); r1 := fp(f, 0, 0.04 * s, (zb - 1.45) * s);
    ramp := frame_move(frame_along(r0, r1, fd(f, 1, 0, 0)), times(add(r0, r1), 0.5));
    half := length(sub(r1, r0)) * 0.5;
    kit_pen(p, obj + 6, MAT_SKIN, body);
    box(buf, p, ramp, 0.72 * s, half, 0.04 * s);
    kit_pen(p, obj + 3, MAT_CLOTH, dark);
    for k: 0..<4 {
      t := (cast(f32) k - 1.5) * 0.45 * half;
      box(buf, p, kit_at(ramp, 0, t, 0.05 * s), 0.68 * s, 0.025 * s, 0.015 * s);
    }
  }
}

// The rover train: a long tracked desert rover of four cars joined by dark accordion couplers,
// facing the frame's z: a wedge-nosed cab car ahead, then box cars, the last with its rear hatch
// open on a lowered ramp. Cream armour (body), an orange stripe (stripe), glow strips and lights
// (glow), dark treads, windows and couplers (dark). 18 m long, 2.85 m to its roofs and 3.8 m to the
// mast's light at s 1.
TRAIN_CAB :: 4.0f32; TRAIN_CAR :: 3.4f32; TRAIN_GAP :: 0.5f32; TRAIN_CARS :: 3;   // m at s 1: the cab, a box car, a coupler, how many box cars
kit_train :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, body: KitTint, stripe: KitTint, glow: KitTint, dark: KitTint) {
  long := TRAIN_CAB + cast(f32) TRAIN_CARS * (TRAIN_CAR + TRAIN_GAP);
  zf := long * 0.5 + 0.7;   // so the nose plate and the ramp's foot reach about as far either way
  for k: 0..<TRAIN_CARS + 1 {
    l := ifx k == 0 then TRAIN_CAB else TRAIN_CAR;
    zb := zf - l;
    kit_train_car(buf, p, f, s, obj, zb, zf, k == 0, k == TRAIN_CARS, body, stripe, glow, dark);
    if k < TRAIN_CARS {
      // the coupler: bellows folds, alternately wide and narrow
      kit_pen(p, obj + 7, MAT_CLOTH, dark);
      for i: 0..<5 {
        z := zb - TRAIN_GAP * (cast(f32) i + 0.5) / 5;
        w := ifx i % 2 == 0 then 0.95f32 else 0.8f32;
        box(buf, p, kit_at(f, 0, 1.6 * s, z * s), w * s, (w - 0.1) * s, TRAIN_GAP * 0.1 * s);
      }
    }
    zf = zb - TRAIN_GAP;
  }
}

#test "a robot is written inside its store, at the scale it is given, and stops when full" {
  buf: [200000] u32;
  pen := [1] Pen.[Pen.{}];
  w := kit_tint(1, 1, 1); k := kit_tint(0.2, 0.2, 0.2);
  kit_robot(buf[..], pen[..], frame_at(v3(0, 0, 0), 0), 1, 20, w, w, w, k, 1);
  n1 := pen[0].n;
  #assert n1 > 0 && !pen[0].over;
  small: [600] u32;
  q := [1] Pen.[Pen.{}];
  kit_robot(small[..], q[..], frame_at(v3(0, 0, 0), 0), 1, 20, w, w, w, k, 1);
  #assert q[0].over && q[0].n * VERTEX_WORDS <= small.count;
}
#test "a hoverboard is written at the scale it is given, and its jet trails only at speed" {
  buf: [60000] u32; w := kit_tint(1, 1, 1);
  a := [1] Pen.[Pen.{}]; kit_hoverboard(buf[..], a[..], frame_at(v3(0, 0, 0), 0), 1, 30, w, w, w, 0);
  b := [1] Pen.[Pen.{}]; kit_hoverboard(buf[..], b[..], frame_at(v3(0, 0, 0), 0), 1, 30, w, w, w, 1);
  #assert a[0].n > 0 && !a[0].over && b[0].n > a[0].n && !b[0].over;
  small: [300] u32; q := [1] Pen.[Pen.{}];
  kit_hoverboard(small[..], q[..], frame_at(v3(0, 0, 0), 0), 1, 30, w, w, w, 1);
  #assert q[0].over && q[0].n * VERTEX_WORDS <= small.count;
}
#test "kit_rand is deterministic and in [0, 1)" {
  for i: 0..<50 { v := kit_rand(cast(f32) i); #assert v >= 0 && v < 1 && v == kit_rand(cast(f32) i); }
}
