// Lab composition of the Metaverse Engine's existing rigid/contact/SAT kernels with caller-owned large storage.
#load "physics-record.coax";
#load "../physics/sim/narrow.coax";

#test "physics lab Metaverse Engine: broad phase includes a rotated box pair and orders ties by stable ID" {
  b:[3]RigidBody;order:[3]int;tmp:[3]int;
  b[0]=rigid_body(1,d3(1,1,1),d3(0,0,0),dq_y(0.7));
  b[1]=rigid_body(1,d3(1,1,1),d3(1.2,0,0),DQ.{});
  b[2]=rigid_body(1,d3(1,1,1),d3(0,20,0),DQ.{});
  lab_order(b[..],order[..],tmp[..]);#assert order[0]==0 && order[1]==2 && order[2]==1;
  a:[8]int;z:[8]int;n:=lab_pairs(b[..],order[..],a[..],z[..],0.5);
  #assert n==1 && a[0]==0 && z[0]==1;
}
#test "physics lab Metaverse Engine: a real falling box advances and the existing plane solver stops penetration" {
  b:[1]RigidBody;b[0]=rigid_body(1,rigid_box_inertia(1,d3(1,1,1)),d3(0,1,0),DQ.{});
  order:[1]int;tmp:[1]int;a:[1]int;z:[1]int;
  for t:0..<120 {ok:=lab_advance(b[..],1.0/60,d3(0,-9.81,0),plane(D3_Y,0),d3(0.5,0.5,0.5),0.1,0.5,8,order[..],tmp[..],a[..],z[..]);#assert ok;}
  #assert b[0].pos.y>0.4 && b[0].pos.y<0.7;
}
lab_less :: (b:[]RigidBody,a:int,z:int)->bool {return b[a].pos.x<b[z].pos.x || (b[a].pos.x==b[z].pos.x && a<z);}
lab_order :: (b:[]RigidBody,order:[]int,tmp:[]int) {
  for i:0..<b.count {order[i]=i;}
  width:=1;
  while width<b.count {
    base:=0;while base<b.count {
      mid:=base+width;if mid>b.count {mid=b.count;}end:=mid+width;if end>b.count {end=b.count;}
      i:=base;j:=mid;k:=base;
      while k<end {if i<mid && (j==end || lab_less(b,order[i],order[j])) {tmp[k]=order[i];i+=1;}else{tmp[k]=order[j];j+=1;}k+=1;}
      base=end;
    }
    for i:0..<b.count {order[i]=tmp[i];}width*=2;
  }
}
lab_pairs :: (b:[]RigidBody,order:[]int,a:[]int,z:[]int,half:f64)->int {
  // Circumscribed spheres conservatively enclose any orientation of an equal-sided box.
  diameter:=2*sqrt(3.0)*half;n:=0;
  for i:0..<b.count {ia:=order[i];j:=i+1;
    while j<b.count {ib:=order[j];if b[ib].pos.x-b[ia].pos.x>diameter {break;}
      if abs(b[ib].pos.y-b[ia].pos.y)<=diameter && abs(b[ib].pos.z-b[ia].pos.z)<=diameter {
        if n>=a.count || n>=z.count {return -1;}a[n]=ia;z[n]=ib;n+=1;
      }j+=1;
    }
  }return n;
}
lab_advance :: (b:[]RigidBody,dt:f64,gravity:D3,ground:Plane,half:D3,e:f64,mu:f64,passes:int,order:[]int,tmp:[]int,a:[]int,z:[]int)->bool {
  // This profile disables island sleeping in every engine.
  for i:0..<b.count {b[i].supported=false;b[i].sleeping=false;}
  w:=rigid_step(rigid_world(dt,b),gravity);
  lab_order(b,order,tmp);n:=lab_pairs(b,order,a,z,half.x);if n<0 {return false;}
  for pass:0..<passes {
    for i:0..<b.count {
      contacts:[8]Contact;count:=contact_box_plane(b[i].pos,b[i].orientation,half,ground,contacts[..]);
      if count>0 {b[i]=contact_resolve_static(b[i],contacts[0],e,mu);}
    }
    for k:0..<n {
      ia:=a[k];ib:=z[k];m:=narrow_box_box(narrow_box(b[ia].pos,b[ia].orientation,half),narrow_box(b[ib].pos,b[ib].orientation,half));
      for c:0..<m.count {if m.distance[c]<0 {
        ct:=contact_of(m.normal,-m.distance[c],m.point[c]);pair:=contact_resolve(b[ia],b[ib],ct,e,mu);b[ia]=pair.a;b[ib]=pair.b;
      }}
    }
  }return true;
}
lab_snapshot :: (out:[]u8,at:int,b:[]RigidBody,step:int) {
  lab_uput(out,at,cast(u64)step);
  for i:0..<b.count {q:=b[i].orientation;v:=rigid_omega_world(b[i]);
    value:=LabBody.{ok=true,pos=LabVec.{x=b[i].pos.x,y=b[i].pos.y,z=b[i].pos.z},rot=LabQuat.{x=q.x,y=q.y,z=q.z,w=q.w},
      vel=LabVec.{x=b[i].vel.x,y=b[i].vel.y,z=b[i].vel.z},omega=LabVec.{x=v.x,y=v.y,z=v.z}};
    lab_body_put(out,at+8+i*104,value);
  }
}
#test "physics lab broad phase: every SAT overlap survives the conservative sweep and capacity fails explicitly" {
  b:[12]RigidBody;order:[12]int;tmp:[12]int;a:[66]int;z:[66]int;
  for i:0..<12 {b[i]=rigid_body(1,d3(1,1,1),d3(f64(i%4)*0.7,f64(i/4)*0.8,0),dq_y(f64(i)*0.2));}
  lab_order(b[..],order[..],tmp[..]);n:=lab_pairs(b[..],order[..],a[..],z[..],0.5);
  for i:0..<12 {for j:i+1..<12 {m:=narrow_box_box(narrow_box(b[i].pos,b[i].orientation,d3(0.5,0.5,0.5)),narrow_box(b[j].pos,b[j].orientation,d3(0.5,0.5,0.5)));if m.count>0 && m.distance[0]<0 {found:=false;for k:0..<n {if (a[k]==i && z[k]==j) || (a[k]==j && z[k]==i) {found=true;}}#assert found;}}}
  tiny:[1]int;#assert lab_pairs(b[..],order[..],tiny[..],z[..],0.5)== -1 && lab_pairs(b[..],order[..],a[..],tiny[..],0.5)== -1;
}
