// Checks proto/aethyr/physics-lab-v1.json against metaverse-engine/lab/physics-record.coax
// and physics-kernel.coax: LABIN001/LABOUT01 magics, header and body field lists,
// byte formulas, profile bounds, and byte-for-byte round-trips through
// lab_input_put and lab_snapshot.
//
//   coax/web/tool.sh metaverse-engine/lab/physics-lab-profile.coax proto/aethyr/physics-lab-v1.json
#import "Basic";
#load "physics-kernel.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";

PLP_FILE :: 65536;
PLP_NODES :: 1024;

plp_str :: (d: Jv, obj: int, key: string) -> string {
  at := jv_get(d, obj, key);
  return ifx jv_kind(d, at) == JV_STRING then jv_raw(d, at) else "";
}
plp_int :: (d: Jv, obj: int, key: string) -> int {
  at := jv_get(d, obj, key);
  if jv_kind(d, at) != JV_NUMBER { return -1; }
  return jv_int(d, at, -1);
}
plp_arr_eq :: (d: Jv, at: int, want: [] string) -> bool {
  if jv_kind(d, at) != JV_ARRAY || jv_len(d, at) != want.count { return false; }
  k := d.nodes[at].first;
  for s: want {
    if k == -1 || jv_kind(d, k) != JV_STRING || jv_raw(d, k) != s { return false; }
    k = d.nodes[k].next;
  }
  return k == -1;
}
plp_bits_f64 :: (v: f64) -> u64 {
  b: [8] u8; lab_fput(b[..], 0, v); return lab_uget(b[..], 0);
}

plp_check_schema :: (d: Jv) -> bool {
  if plp_int(d, 0, "version") != 1 { return false; }
  if plp_str(d, 0, "byte_order") != "little endian" { return false; }
  if plp_str(d, 0, "check").count == 0 { return false; }

  inp := jv_get(d, 0, "input");
  out := jv_get(d, 0, "output");
  prof := jv_get(d, 0, "profile");
  if jv_kind(d, inp) != JV_OBJECT || jv_kind(d, out) != JV_OBJECT || jv_kind(d, prof) != JV_OBJECT { return false; }

  in_u64 := [5] string.["count", "steps", "sample_every", "seed", "solver_passes"];
  in_f64 := [14] string.["dt", "gravity_x", "gravity_y", "gravity_z", "plane_nx", "plane_ny", "plane_nz", "plane_d", "half_x", "half_y", "half_z", "mass", "friction", "restitution"];
  body_f64 := [13] string.["x", "y", "z", "qx", "qy", "qz", "qw", "vx", "vy", "vz", "world_wx", "world_wy", "world_wz"];
  out_u64 := [3] string.["count", "steps", "sample_every"];

  if plp_str(d, inp, "magic_ascii") != "LABIN001" { return false; }
  if !plp_arr_eq(d, jv_get(d, inp, "header_u64"), in_u64[..]) { return false; }
  if !plp_arr_eq(d, jv_get(d, inp, "header_f64"), in_f64[..]) { return false; }
  if plp_str(d, inp, "bytes") != "160 + 104 * count" { return false; }
  if !plp_arr_eq(d, jv_get(d, 0, "body_f64"), body_f64[..]) { return false; }

  if plp_str(d, out, "magic_ascii") != "LABOUT01" { return false; }
  if !plp_arr_eq(d, jv_get(d, out, "header_u64"), out_u64[..]) { return false; }
  if plp_str(d, out, "bytes") != "32 + 8 * steps + (steps / sample_every + 1) * (8 + 104 * count)" { return false; }

  steps := plp_int(d, prof, "steps");
  every := plp_int(d, prof, "sample_every");
  if steps != 180 || every != 30 { return false; }
  if jv_kind(d, jv_get(d, prof, "sleep")) != JV_FALSE || jv_kind(d, jv_get(d, prof, "ccd")) != JV_FALSE { return false; }
  if plp_int(d, prof, "linear_damping") != 0 || plp_int(d, prof, "angular_damping") != 0 || plp_int(d, prof, "box_convex_radius") != 0 { return false; }
  return true;
}

plp_check_codec :: (d: Jv) -> bool {
  prof := jv_get(d, 0, "profile");
  steps := plp_int(d, prof, "steps");
  every := plp_int(d, prof, "sample_every");
  in_magic := plp_str(d, jv_get(d, 0, "input"), "magic_ascii");
  out_magic := plp_str(d, jv_get(d, 0, "output"), "magic_ascii");

  // Spec presets agree with the profile's steps and sample cadence.
  for kind: 0..<3 {
    sp := lab_spec(kind);
    if sp.steps != steps || sp.sample_every != every { return false; }
    if lab_input_bytes(sp.count) != 160 + 104 * sp.count { return false; }
    if lab_output_bytes(sp.count, sp.steps, sp.sample_every) != 32 + 8 * sp.steps + (sp.steps / sp.sample_every + 1) * (8 + 104 * sp.count) { return false; }
  }
  if lab_input_bytes(0) != 160 || LAB_BODY_BYTES != 104 { return false; }

  // Byte-for-byte check of LABIN001 header and body table written by lab_input_put.
  p := lab_spec(0);
  p.count = 2;
  seed := 424242;
  in_len := lab_input_bytes(p.count);
  in_buf: [512] u8;
  if in_len != 368 { return false; }
  lab_input_put(in_buf[0..<in_len], p, seed);
  if cast(string) in_buf[0..<8] != in_magic { return false; }
  if lab_uget(in_buf[..], 8) != 2 || lab_uget(in_buf[..], 16) != cast(u64) steps || lab_uget(in_buf[..], 24) != cast(u64) every { return false; }
  if lab_uget(in_buf[..], 32) != cast(u64) seed || lab_uget(in_buf[..], 40) != cast(u64) p.passes { return false; }

  hdr_f64 := [14] f64.[p.dt, p.gravity.x, p.gravity.y, p.gravity.z, p.normal.x, p.normal.y, p.normal.z, p.plane_d, p.half.x, p.half.y, p.half.z, p.mass, p.friction, p.restitution];
  for i: 0..<14 {
    if plp_bits_f64(lab_fget(in_buf[..], 48 + 8 * i)) != plp_bits_f64(hdr_f64[i]) { return false; }
  }
  for i: 0..<p.count {
    want := lab_body(p, seed, i);
    got := lab_body_get(in_buf[..], 160 + 104 * i);
    wf := [13] f64.[want.pos.x, want.pos.y, want.pos.z, want.rot.x, want.rot.y, want.rot.z, want.rot.w, want.vel.x, want.vel.y, want.vel.z, want.omega.x, want.omega.y, want.omega.z];
    gf := [13] f64.[got.pos.x, got.pos.y, got.pos.z, got.rot.x, got.rot.y, got.rot.z, got.rot.w, got.vel.x, got.vel.y, got.vel.z, got.omega.x, got.omega.y, got.omega.z];
    for k: 0..<13 {
      if plp_bits_f64(lab_fget(in_buf[..], 160 + 104 * i + 8 * k)) != plp_bits_f64(wf[k]) { return false; }
      if plp_bits_f64(gf[k]) != plp_bits_f64(wf[k]) { return false; }
    }
  }

  // Byte-for-byte check of LABOUT01 layout and lab_snapshot world-space omega conversion.
  out_len := lab_output_bytes(p.count, steps, every);
  if out_len != 32 + 8 * 180 + 7 * (8 + 104 * 2) { return false; }
  out_buf: [4096] u8;
  for i: 0..<8 { out_buf[i] = out_magic[i]; }
  lab_uput(out_buf[..], 8, cast(u64) p.count);
  lab_uput(out_buf[..], 16, cast(u64) steps);
  lab_uput(out_buf[..], 24, cast(u64) every);
  inertia := rigid_box_inertia(p.mass, d3(p.half.x * 2, p.half.y * 2, p.half.z * 2));
  bodies: [2] RigidBody;
  for i: 0..<2 {
    v := lab_body_get(in_buf[..], 160 + 104 * i);
    bodies[i] = rigid_body(p.mass, inertia, d3(v.pos.x, v.pos.y, v.pos.z), dq(v.rot.x, v.rot.y, v.rot.z, v.rot.w));
    bodies[i].vel = d3(v.vel.x, v.vel.y, v.vel.z);
    bodies[i].omega = dq_rotate(dq_conj(bodies[i].orientation), d3(v.omega.x, v.omega.y, v.omega.z));
  }
  base := 32 + 8 * steps;
  for s: 0..<7 {
    step := s * every;
    at := base + s * (8 + 104 * p.count);
    lab_snapshot(out_buf[0..<out_len], at, bodies[..], step);
    if lab_uget(out_buf[..], at) != cast(u64) step { return false; }
  }
  // Sample 0 must echo the exact initial body table.
  for i: 0..<104 * p.count {
    if out_buf[base + 8 + i] != in_buf[160 + i] { return false; }
  }
  if cast(string) out_buf[0..<8] != "LABOUT01" { return false; }
  return true;
}

plp_check_text :: (text: string) -> bool {
  nodes: [PLP_NODES] JvNode; d: [1] Jv;
  if !jv_parse(d[..], text, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  return plp_check_schema(d[0]) && plp_check_codec(d[0]);
}

PLP_SAMPLE :: "{\"version\":1,\"check\":\"coax/web/tool.sh metaverse-engine/lab/physics-lab-profile.coax proto/aethyr/physics-lab-v1.json\",\"byte_order\":\"little endian\",\"input\":{\"magic_ascii\":\"LABIN001\",\"header_u64\":[\"count\",\"steps\",\"sample_every\",\"seed\",\"solver_passes\"],\"header_f64\":[\"dt\",\"gravity_x\",\"gravity_y\",\"gravity_z\",\"plane_nx\",\"plane_ny\",\"plane_nz\",\"plane_d\",\"half_x\",\"half_y\",\"half_z\",\"mass\",\"friction\",\"restitution\"],\"bytes\":\"160 + 104 * count\"},\"body_f64\":[\"x\",\"y\",\"z\",\"qx\",\"qy\",\"qz\",\"qw\",\"vx\",\"vy\",\"vz\",\"world_wx\",\"world_wy\",\"world_wz\"],\"output\":{\"magic_ascii\":\"LABOUT01\",\"header_u64\":[\"count\",\"steps\",\"sample_every\"],\"bytes\":\"32 + 8 * steps + (steps / sample_every + 1) * (8 + 104 * count)\"},\"profile\":{\"steps\":180,\"sample_every\":30,\"sleep\":false,\"ccd\":false,\"linear_damping\":0,\"angular_damping\":0,\"box_convex_radius\":0}}";

#test "physics-lab-v1 profile holds against physics-record.coax" {
  #assert plp_check_text(PLP_SAMPLE);
}

#test "tampered magic or profile step count fails" {
  bad: [2048] u8;
  for i: 0..<PLP_SAMPLE.count { bad[i] = PLP_SAMPLE[i]; }
  hit := false;
  for i: 0..<PLP_SAMPLE.count - 8 {
    if cast(string) bad[i..<i + 8] == "LABIN001" { bad[i + 7] = '2'; hit = true; }
  }
  #assert hit && !plp_check_text(cast(string) bad[0..<PLP_SAMPLE.count]);
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) || args_count(args[..]) != 1 {
    tool_errln("usage: physics-lab-profile.coax <profile.json>"); return 2;
  }
  raw: [PLP_FILE] u8;
  n := fs_read(args_at(args[..], 0), raw[..]);
  if n < 0 { tool_errln("physics-lab-profile: cannot read profile"); return 2; }
  if !plp_check_text(cast(string) raw[0..<n]) {
    print("physics-lab-v1: profile fails\n"); return 1;
  }
  print("physics-lab-v1: profile holds\n");
  return 0;
}
