// Compatible C surface for the controller owned by aethyr.walk.
// Load metaverse-engine/move/walk.coax directly for a qualified Coax API: aliases are not reexports.
// These wrappers do no policy or arithmetic; the authoritative core owns both.
#module "verse.player";
#load "walk.coax" as walk;

metaverse_player_advance_in_realm_traced :: (p: walk.Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32, realm: string) -> walk.AdvanceTrace #export_c #effects(all) {
  return walk.walk_advance_in_realm_traced(p, frame, bodies, walls, floors, realm);
}

metaverse_player_place :: (x: f32, y: f32, z: f32, yaw: f32) -> walk.Player #export_c #effects(all) { return walk.walk_place(x, y, z, yaw); }

metaverse_player_input :: (p: walk.Player, key_x: f32, key_y: f32, pad_x: f32, pad_y: f32,
                          run: bool, jump: bool, dyaw: f32, dpitch: f32) -> walk.Player #export_c #effects(all) { return walk.walk_input(p, key_x, key_y, pad_x, pad_y, run, jump, dyaw, dpitch); }

// A flying realm's controls (metaverse-engine/move/flight.coax, through walk_fly_input): taps, wings and the dive.
metaverse_player_input_flying :: (p: walk.Player, key_x: f32, key_y: f32, pad_x: f32, pad_y: f32, run: bool, jump: bool,
                              taps: int, wings: bool, dive: bool) -> walk.Player #export_c #effects(all) {
  return walk.walk_fly_input(p, key_x, key_y, pad_x, pad_y, run, jump, taps, wings, dive);
}

metaverse_runs :: (shift: bool, stick_run: bool, pad_x: f32, pad_y: f32) -> bool #export_c #effects(all) { return walk.walk_runs(shift, stick_run, pad_x, pad_y); }

metaverse_player_intent :: (p: walk.Player, i: Intent) -> walk.Player { return walk.walk_intent(p, i); }

metaverse_player_advance :: (p: walk.Player, frame: f32) -> walk.Player #export_c #effects(all) { return walk.walk_advance(p, frame); }

metaverse_player_advance_among :: (p: walk.Player, frame: f32, bodies: [] f32, walls: [] f32) -> walk.Player #export_c #effects(all) { return walk.walk_advance_among(p, frame, bodies, walls); }

metaverse_player_advance_on :: (p: walk.Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32) -> walk.Player #export_c #effects(all) { return walk.walk_advance_on(p, frame, bodies, walls, floors); }

metaverse_player_advance_in_realm :: (p: walk.Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32, realm: string) -> walk.Player #export_c #effects(all) { return walk.walk_advance_in_realm(p, frame, bodies, walls, floors, realm); }

metaverse_player_collision_status :: (p: walk.Player) -> int #export_c #effects(all) { return walk.walk_collision_status(p); }

metaverse_player_collision_refusals :: (p: walk.Player) -> u64 #export_c #effects(all) { return walk.walk_collision_refusals(p); }

metaverse_player_collision_residual :: (p: walk.Player) -> f32 #export_c #effects(all) { return walk.walk_collision_residual(p); }

metaverse_player_collision_passes :: (p: walk.Player) -> int #export_c #effects(all) { return walk.walk_collision_passes(p); }

metaverse_player_collision_floor_cut :: (p: walk.Player) -> bool #export_c #effects(all) { return walk.walk_collision_floor_cut(p); }

metaverse_player_query_status :: (p: walk.Player) -> int #export_c #effects(all) { return walk.walk_query_status(p); }

metaverse_player_camera_query_status :: (p: walk.Player) -> int #export_c #effects(all) { return walk.walk_camera_query_status(p); }

metaverse_player_counts :: (p: walk.Player, frame: f32) -> f32 #export_c #effects(all) { return walk.walk_counts(p, frame); }

metaverse_player_ran :: (p: walk.Player) -> int #export_c #effects(all) { return walk.walk_ran(p); }

metaverse_player_feet :: (p: walk.Player) -> walk.Vec3 #export_c #effects(all) { return walk.walk_feet(p); }

metaverse_player_face :: (p: walk.Player) -> f32 #export_c #effects(all) { return walk.walk_face(p); }

metaverse_player_shot :: (p: walk.Player) -> CameraShot { return walk.walk_shot(p); }

metaverse_player_at :: (p: walk.Player) -> walk.Vec3 #export_c #effects(all) { return walk.walk_at(p); }

metaverse_player_eye :: (p: walk.Player) -> walk.Vec3 #export_c #effects(all) { return walk.walk_eye(p); }

metaverse_player_act :: (p: walk.Player) -> int #export_c #effects(all) { return walk.walk_act(p); }
// The motion the controls ask for (walk_asked): what a follow camera turns toward.
metaverse_player_asked :: (p: walk.Player) -> walk.Vec3 #export_c #effects(all) { return walk.walk_asked(p); }

metaverse_player_view :: (p: walk.Player, mode: int) -> CameraShot { return walk.walk_view(p, mode); }

metaverse_player_view_eye :: (p: walk.Player, mode: int) -> walk.Vec3 #export_c #effects(all) { return walk.walk_view_eye(p, mode); }

metaverse_player_view_at :: (p: walk.Player, mode: int) -> walk.Vec3 #export_c #effects(all) { return walk.walk_view_at(p, mode); }

metaverse_player_zoom :: (p:walk.Player,delta:f32) ->walk.Player #export_c #effects(all) { return walk.walk_zoom(p, delta); }

metaverse_player_zoom_view :: (p:walk.Player,mode:int,delta:f32) ->walk.PlayerZoom #export_c #effects(all) { return walk.walk_zoom_view(p, mode, delta); }

metaverse_player_constrain :: (p:walk.Player,x:f32,z:f32) ->walk.Player #export_c #effects(all) { return walk.walk_constrain(p, x, z); }

// Version 2 keeps pending input outside the published Player layout.
metaverse_player_v2_input :: (c:[]walk.WalkControlV2,key_x:f32,key_y:f32,pad_x:f32,pad_y:f32,run:bool,jump:bool,look_x:f32,look_y:f32) #export_c #effects(all) {
  walk.walk_control_feed(c,key_x,key_y,pad_x,pad_y,run,jump,look_x,look_y);
}
metaverse_player_v2_heading :: (c:[]walk.WalkControlV2,p:walk.Player,heading:f32) #export_c #effects(all) {walk.walk_control_heading(c,p,heading);}
metaverse_player_v2_flying :: (c:[]walk.WalkControlV2,p:walk.Player,key_x:f32,key_y:f32,pad_x:f32,pad_y:f32,run:bool,jump:bool,taps:int,wings:bool,dive:bool)->walk.Player #export_c #effects(all) {
  return walk.walk_control_flying(c,p,key_x,key_y,pad_x,pad_y,run,jump,taps,wings,dive);
}
metaverse_player_v2_advance :: (c:[]walk.WalkControlV2,p:walk.Player,frame:f32,bodies:[]f32,walls:[]f32,floors:[]f32,realm:string)->walk.AdvanceTrace #export_c #effects(all) {
  return walk.walk_control_realm(c,p,frame,bodies,walls,floors,realm);
}

metaverse_player_v2_reset :: ()->walk.WalkControlV2 #export_c #effects(all) {fresh:walk.WalkControlV2;return fresh;}

// The body alone, for a room server and a client that keeps its own camera (#13271): no camera field
// crosses this face.
metaverse_body_place :: (x: f32, y: f32, z: f32, yaw: f32) -> walk.Body #export_c #effects(all) { return walk.body_place(x, y, z, yaw); }
metaverse_body_counts :: (b: walk.Body, frame: f32) -> f32 #export_c #effects(all) { return walk.body_counts(b, frame); }
metaverse_body_feet :: (b: walk.Body) -> walk.Vec3 #export_c #effects(all) { return walk.body_feet(b); }
metaverse_body_face :: (b: walk.Body) -> f32 #export_c #effects(all) { return walk.body_face(b); }
metaverse_body_constrain :: (b: walk.Body, x: f32, z: f32) -> walk.Body #export_c #effects(all) { return walk.body_constrain(b, x, z); }
