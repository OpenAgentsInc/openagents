// The Metaverse Engine's fixed-step kinematic walker, extracted from metaverse-engine/move/player.coax.
// The original controller ports aethyr-cpp src/player_core.cpp and
// three-player-controller (hh-hang/three-player-controller, MIT).
//
// This logical owner is aethyr.walk. It owns Player/World, checked movement,
// the frame schedule and ephemeral post-step targets. World declares separate
// collision and locomotion profiles and optional world-height terrain views.
// It also retains the camera state adapters used by the first-person,
// third-person and top-down views; follow.coax alone moves the camera.
// metaverse-engine/move/player.coax owns the compatible C exports. This shared core exports
// no C symbols, so a realm and its Player library may both load it.
//
// The walker is one module (#13270): the step, the source velocity kernel
// (source_velocity) and the version 2 frame-input sidecar (WalkControlV2,
// walk_control_*) all live here. locomotion.coax is the one tuning record and
// player.coax the one C face. The bounded travel subdivision
// (walk-substep-policy.coax) stays a module of its own: v1's guardians step
// through it in pages that carry no walker (everglade/zone-combat.coax).
//
// Units are metres and seconds, +Y up and yaw0 along +Z. The fixed walking
// period is 1/64 s. Runtime tuning comes from World.locomotion; the legacy
// constants below name the published defaults for existing callers/checks.

#module "metaverse.engine.walk";
#load "../physics/stand.coax";
#load "../core/loop.coax";
#load "../core/input.coax";
#load "../physics/query.coax";   // the ground under you: one query for every walking realm
#load "../core/math.coax";    // sine, cosine and powers with the same bits natively and in the browser
#load "../cam/follow.coax";  // the camera: the Metaverse Engine's follow, which every realm shares
#load "../physics/collide.coax"; // checked capsule resolution and the trusted legacy adapters
#load "../physics/collision-profiles.coax" as realm_collision;
#load "player-collision-checks.coax" #test;
#load "locomotion.coax";
#load "walk-substep-policy.coax";
#load "../tests/locomotion-source-oracle.coax" #test;   // the velocity kernel's recorded oracle
#load "echo-walk-checks.coax" #test;
#load "flight.coax";   // the per-step flight hook a flying realm declares (Fairy Forest)
#load "walk-frame.coax";
#load "walk-tuning-checks.coax" #test;
#authority;

PI :: 3.14159265;
TAU :: 6.2831853;

// book:begin tuning
WALK :: 3.5;            // m/s
RUN :: 7.5;
// The one setting for how you move (the owner's, 2026-10-29; meant to become
// a player's setting): true, moving runs (RUN) and holding Shift walks
// (WALK); false, moving walks and Shift runs. On a phone the stick decides
// either way: a full push runs, a light one walks (metaverse/grid.coax RUN_PAST).
RUN_BY_DEFAULT :: INPUT_RUN_BY_DEFAULT;   // metaverse-engine/core/input.coax holds the rule
GRAVITY :: 24.0;        // m/s^2
JUMP :: 7.5;            // m/s up: a 1.17 m peak
ACCEL :: 60.0;          // m/s^2, speeding up and slowing down alike
TURN_RATE :: 10.0;      // how fast the character turns to face its way
RIDE_HEIGHT :: 0.4;     // higher than this above the floor is falling
STEP_SMOOTH :: 10.0;
// book:end tuning
LOOK_AT_HEIGHT :: FOLLOW_HEIGHT; // the camera's target above the feet (metaverse-engine/cam/follow.coax holds the camera's numbers)
CAM_MAX :: FOLLOW_DIST;
CAM_WALL_MIN :: FOLLOW_CLOSEST; // closest a wall pushes the camera in
CAM_LERP :: FOLLOW_EASE;        // per 1/60 s, as the library tuned it
SPRING_TIME :: FOLLOW_SPRING_TIME;
PHI_MIN :: FOLLOW_PHI_MIN;      // the camera's angle down from straight up
PHI_MAX :: FOLLOW_PHI_MAX;      // PI - PHI_MIN
BEHIND_PHI :: 1.10714872; // atan2(400, 200): behind you and above
DEAD_ZONE :: INPUT_DEAD_ZONE;   // stick travel that counts as no input (metaverse-engine/core/input.coax)
STEP :: 0.015625;       // the fixed gameplay step, 1/64 s: metaverse-engine/core/loop.coax's LOOP_STEP_NS
RADIUS :: 0.3;          // your capsule, as aethyr's kRadius
HEIGHT :: 1.8;
BODY :: 7;              // numbers per body: one end, the other, the radius
PASSES :: 3;            // push-outs per step, for bodies that touch
CAM_CLEAR :: FOLLOW_CLEAR; // how far the camera keeps from a body
WALL :: 6;              // numbers per wall: min x, y, z, max x, y, z
STEP_UP :: QUERY_STEP_UP;     // the highest top you walk onto (metaverse-engine/physics/query.coax holds it)
FLOOR_PAD :: QUERY_FLOOR_PAD; // how far past a floor's edge your middle may be and it still holds you
SLIDE_GRIP :: 0.1;      // the share of your feet's push you keep on a slope too steep to stand on

Vec3 :: struct { x: f32; y: f32; z: f32; }

// A flat floor, the camera's room, and the bodies (BODY numbers each).
World :: struct {
  ground: f32 = 0;
  room: f32 = 1000;
  bodies: [] f32;
  walls: [] f32;
  floors: [] f32;       // STAND_FLOATS numbers each (metaverse-engine/physics/stand.coax), on the same floor as the walls
  heightfields: [] QueryHeightfield;
  hulls: [] f32;        // convex solids (metaverse-engine/physics/query.coax): their tops are floors, their sides stop you
  collision: CollideProfile;
  locomotion: LocomotionProfile;
  flight: FlightProfile;   // off unless the realm flies (metaverse-engine/move/flight.coax)
}

// What the character is doing, for the animation that comes later. The
// host reads it as walk_act's number.
Act :: enum u8 { idle; walking; running; airborne; }

// book:begin state
// The body: where you are and what the fixed step reads and writes. The server owns it; the room and
// the wire carry only this (#13271).
Body :: struct {
  pos: Vec3;            // feet, after the last step
  vel: Vec3;
  face: f32;            // yaw the character faces
  on_ground: bool = true;
  act: Act = Act.idle;
  // The controls held now.
  key_x: f32;
  key_y: f32;
  pad_x: f32;
  pad_y: f32;
  run: bool;
  jump_held: bool;
  jumps: InputPress;          // jump presses, each taken by the first step after it (metaverse-engine/core/input.coax)
  // Flight (metaverse-engine/move/flight.coax), for a realm whose World declares it: whether you may beat and
  // climb now, the dive held, the beats taken in the air, and whether the last step dived.
  wings: bool;
  dive_held: bool;
  beats: int;
  diving: bool;
  // Fixed steps (metaverse-engine/core/loop.coax, the engine's one clock): time not yet stepped,
  // and where the last step began, so the frame shows a point between the last two.
  clock: FrameClock;
  prev_pos: Vec3;
  prev_face: f32;
  // Your speed's share, set by the realm: 1 on land, 0.5 wading or swimming
  // (everglade/legacy/v1/river.coax pace_of). WALK and RUN themselves never change.
  pace: f32 = 1;
  grip: f32 = 1;       // the share of your feet's grip on the ground (a realm's ice: everglade-frost.coax); less slides you
  sliding: bool;       // on a floor too steep to stand on, sliding down it
  collision_status: CollideStatus;
  collision_refusals: u64;
  collision_residual: f32;
  collision_passes: int;
  collision_floor_cut: bool;
  query_status: QueryStatus;         // a refused ground receipt on the last physical step
  // The view's yaw the step turns your controls by (the stick's forward is the view's forward): an
  // input, set from the camera on the client and from the wire on the server. The body has no camera.
  yaw: f32 = PI;
}
// The camera: the orbit round the body (theta around +Y from +Z, phi down from +Y, its distance from
// the spring-followed target). The client owns it; the step never reads it.
Camera :: struct {
  theta: f32 = PI;
  phi: f32 = BEHIND_PHI;
  dist: f32 = CAM_MAX;
  max_dist: f32 = CAM_MAX;
  zoom_push: f32;       // zoom past a view's end, gathering to cross it
  target: Vec3 = Vec3.{x = 0, y = LOOK_AT_HEIGHT, z = 0};
  spring_vel: Vec3;
  prev_target: Vec3 = Vec3.{x = 0, y = LOOK_AT_HEIGHT, z = 0};
  prev_dist: f32 = CAM_MAX;
  query_status: QueryStatus;  // the last camera receipt, retained when its step is skipped
}
// What a page holds: its body and its camera.
Player :: struct { body: Body; cam: Camera; }
// book:end state

lo :: (a: f32, b: f32) -> f32 #effects(all) { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 #effects(all) { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 #effects(all) { return lo(high, hi(low, a)); }
mix :: (a: f32, b: f32, t: f32) -> f32 #effects(all) { return a + (b - a) * t; }
mix3 :: (a: Vec3, b: Vec3, t: f32) -> Vec3 #effects(all) {
  return Vec3.{x = mix(a.x, b.x, t), y = mix(a.y, b.y, t), z = mix(a.z, b.z, t)};
}
finite :: (a: f32) -> bool #effects(all) { return a == a && a < 1000000.0 && a > -1000000.0; }
// Strict sign decisions are shared by quadrant selection and view changes;
// neither signed zero is negative, and an unordered value is not negative.
player_negative :: (value: f32) -> bool #effects(all) { return value < 0; }

// An angle in [-PI, PI).
wrap_angle :: (a: f32) -> f32 #effects(all) { return a - f32(TAU) * floor((a + f32(PI)) / f32(TAU)); }

// atan on [0, 1], within 2e-5 rad.
atan_unit :: (t: f32) -> f32 #effects(all) {
  s := t * t;
  return t * (0.99997726 + s * (-0.33262347 + s * (0.19354346 + s * (-0.11643287 + s * (0.05265332 + s * -0.01172120)))));
}

// The angle of (x, y) from +X, in [-PI, PI]; 0 for the origin.
atan2 :: (y: f32, x: f32) -> f32 #effects(all) {
  ax := abs(x); ay := abs(y);
  if ax == 0 && ay == 0 { return 0; }
  a := ifx ay > ax then f32(PI / 2) - atan_unit(ax / ay) else atan_unit(ay / ax);
  if player_negative(x) { a = f32(PI) - a; }
  if y < 0 { a = -a; }
  return a;
}

// ---- The world ----

// The world as the Metaverse Engine's colliders: the ground, the walls as boxes, the bodies as capsules and
// the floors (metaverse-engine/physics/query.coax).
colliders :: (w: World) -> Colliders #effects(all) {
  return Colliders.{ground = w.ground, boxes = w.walls, capsules = w.bodies, floors = w.floors, heightfields = w.heightfields, hulls = w.hulls};
}
// The floor under feet at (x, z): what they stand on (query_stand), the ground or the highest
// wall top your capsule is over or floor you are over that is no more than STEP_UP above them.
floor_at :: (w: World, x: f32, z: f32, feet: f32) -> f32 #effects(all) { return floor_under(w, x, z, feet).y; }
// The same with its slope (a wall's top and the ground are level).
// book:begin ground
floor_under :: (w: World, x: f32, z: f32, feet: f32) -> StandHit #effects(all) {
  g := query_ground(colliders(w), x, z, feet + w.collision.step_up, w.collision.radius);
  return StandHit.{y = g.y, gx = g.gx, gz = g.gz};
}
// book:end ground
// The trusted adapters retain the old direct-helper contract, including large
// moves used by tools and checks. The real fixed step uses collide_move below.
body_collision_state :: (p: Body) -> CollideState #effects(all) { return CollideState.{feet = wp(p.pos), velocity = wp(p.vel)}; }
body_collision_apply :: (p: Body, s: CollideState) -> Body #effects(all) {
  next := p; next.pos = vp(s.feet); next.vel = vp(s.velocity); return next;
}
body_collision_report :: (p: Body, r: CollideResult) -> Body #effects(all) {
  next := p;
  next.query_status = QueryStatus.ok;
  next.collision_status = r.status; next.collision_residual = r.residual;
  next.collision_passes = r.passes; next.collision_floor_cut = r.floor_cut;
  if r.status != CollideStatus.ok && next.collision_refusals < 18446744073709551615 { next.collision_refusals += 1; }
  return next;
}
floor_cuts :: (w: World, x: f32, z: f32, feet: f32) -> bool #effects(all) {
  return collide_floor_cuts(colliders(w), w.collision, world_point(x, feet, z));
}
body_off_floors :: (w: World, from: Body, p: Body) -> Body #effects(all) {
  return body_collision_apply(p, collide_floor_sides(colliders(w), w.collision, body_collision_state(from), body_collision_state(p)));
}
// book:begin walls
body_out_of_walls :: (w: World, p: Body) -> Body #effects(all) {
  return body_collision_apply(p, collide_walls(colliders(w), w.collision, body_collision_state(p)));
}

// book:end walls

v3 :: (x: f32, y: f32, z: f32) -> Vec3 #effects(all) { return Vec3.{x = x, y = y, z = z}; }
add :: (a: Vec3, b: Vec3) -> Vec3 #effects(all) { return v3(a.x + b.x, a.y + b.y, a.z + b.z); }
sub :: (a: Vec3, b: Vec3) -> Vec3 #effects(all) { return v3(a.x - b.x, a.y - b.y, a.z - b.z); }
times :: (a: Vec3, k: f32) -> Vec3 #effects(all) { return v3(a.x * k, a.y * k, a.z * k); }
dot :: (a: Vec3, b: Vec3) -> f32 #effects(all) { return a.x * b.x + a.y * b.y + a.z * b.z; }

// Compatibility for callers inspecting segment parameters. The actual closest
// pair comes from the Metaverse Engine; recovering its parameters does not resolve contacts.
Closest :: struct { s: f32; t: f32; p: Vec3; q: Vec3; }
closest :: (p0: Vec3, p1: Vec3, q0: Vec3, q1: Vec3) -> Closest #effects(all) {
  pair := collide_closest(wp(p0), wp(p1), wp(q0), wp(q1), 0.000001);
  out := Closest.{p = vp(pair.p), q = vp(pair.q)};
  first := sub(p1, p0); second := sub(q1, q0);
  aa := dot(first, first); bb := dot(second, second);
  if aa > 0 { out.s = clamp(dot(sub(out.p, p0), first) / aa, 0, 1); }
  if bb > 0 { out.t = clamp(dot(sub(out.q, q0), second) / bb, 0, 1); }
  return out;
}

// book:begin across
// A trusted direct move, deliberately not the bounded fixed-step entry.
body_move_across :: (w: World, p: Body, dx: f32, dz: f32) -> Body #effects(all) {
  next := body_collision_state(p); next.feet.x += dx; next.feet.z += dz;
  for pass: 0..<w.collision.max_passes {
    bodies := collide_bodies(colliders(w), w.collision, next, dx, dz);
    hulls := collide_hulls(colliders(w), w.collision, bodies.state);
    next = collide_walls(colliders(w), w.collision, hulls.state);
    if !bodies.pushed && !hulls.pushed { break; }
  }
  return body_collision_apply(p, next);
}

// book:end across

// How far the camera may sit from target along offset (a unit direction)
// before something is in the way, up to max: the room, and CAM_CLEAR short
// of the nearest body the line crosses (metaverse-engine/cam/follow.coax follow_room).
camera_room :: (w: World, target: Vec3, offset: Vec3, max: f32) -> f32 #effects(all) {
  return follow_room(colliders(w), w.room, wp(target), wp(offset), max);
}

// The camera as the Metaverse Engine's follow (metaverse-engine/cam/follow.coax): the player keeps its camera's fields, as
// the realms' C faces read them, and each call copies back the fields the follow moved.
wp :: (v: Vec3) -> WorldPoint #effects(all) { return world_point(v.x, v.y, v.z); }
vp :: (w: WorldPoint) -> Vec3 #effects(all) { return Vec3.{x = w.x, y = w.y, z = w.z}; }
follow_of :: (p: Player) -> Follow #effects(all) {
  return Follow.{theta = p.cam.theta, phi = p.cam.phi, dist = p.cam.dist, max_dist = p.cam.max_dist, target = wp(p.cam.target), vel = wp(p.cam.spring_vel)};
}

// ---- The controller ----

look_at :: (p: Player) -> Vec3 #effects(all) { return Vec3.{x = p.body.pos.x, y = p.body.pos.y + f32(LOOK_AT_HEIGHT), z = p.body.pos.z}; }

orbit_offset :: (p: Player) -> Vec3 #effects(all) {
  return vp(follow_offset(follow_of(p)));
}

place_in :: (w: World, x: f32, y: f32, z: f32, yaw: f32) -> Player #effects(all) {
  p: Player;
  p.body.pos = Vec3.{x = x, y = y, z = z};
  p.body.face = wrap_angle(yaw);
  p.cam.theta = wrap_angle(yaw + f32(PI)); p.body.yaw = p.cam.theta;
  p.body.on_ground = y - floor_at(w, x, z, y) <= w.locomotion.ride_height;
  p.cam.target = look_at(p);
  p.body.prev_pos = p.body.pos;
  p.cam.prev_target = p.cam.target;
  p.body.prev_face = p.body.face;
  return p;
}

// Stands at feet facing yaw, with the camera behind.
walk_place :: (x: f32, y: f32, z: f32, yaw: f32) -> Player #effects(all) {
  w: World;
  return place_in(w, x, y, z, yaw);
}

// book:begin input
// This frame's controls, as InputIntent carries them: keyboard axes (-1, 0,
// 1), stick axes in [-1, 1] (x right, y forward), run and jump held, and look
// deltas in radians (positive turns left and looks up). A jump is a press, not a hold:
// it is counted here and taken by the first fixed step after it (metaverse-engine/core/input.coax), so a
// frame that runs no step keeps it and a frame that runs two jumps once. This v1
// single-sample primitive applies look immediately. Frame-driven consumers use
// the version 2 sidecar's (WalkControlV2, below); the Grid samples before calling here.
walk_input :: (p: Player, key_x: f32, key_y: f32, pad_x: f32, pad_y: f32,
                          run: bool, jump: bool, dyaw: f32, dpitch: f32) -> Player #effects(all) {
  next := p;
  next.body.key_x = clamp(key_x, -1, 1);
  next.body.key_y = clamp(key_y, -1, 1);
  next.body.pad_x = clamp(pad_x, -1, 1);
  next.body.pad_y = clamp(pad_y, -1, 1);
  if !finite(key_x) { next.body.key_x = 0; }
  if !finite(key_y) { next.body.key_y = 0; }
  if !finite(pad_x) || !finite(pad_y) { next.body.pad_x = 0; next.body.pad_y = 0; }
  next.body.run = run;
  next.body.jumps = input_level(p.body.jumps, jump);
  next.body.jump_held = jump;
  cam := follow_look(follow_of(next), dyaw, dpitch);
  next.cam.theta = cam.theta; next.cam.phi = cam.phi;
  return next;
}
// book:end input

// Whether you run this frame, for every realm's face: shift is Shift held
// (the key the realms call HOLD_RUN), stick_run the stick's full push
// (metaverse/grid.coax), pad its travel. A stick past the dead zone decides; the
// keys go by RUN_BY_DEFAULT, Shift turning it the other way.
// A flying realm's frame of controls: walk_input's, plus `taps` (a tap is a press even while
// the jump is held; one per frame, as the face counted them), whether you may beat and climb
// now (`wings`) and the dive held.
walk_fly_input :: (p: Player, key_x: f32, key_y: f32, pad_x: f32, pad_y: f32, run: bool, jump: bool,
                   taps: int, wings: bool, dive: bool) -> Player #effects(all) {
  next := walk_input(p, key_x, key_y, pad_x, pad_y, run, jump, 0, 0);
  if taps > 0 && next.body.jumps.pressed == p.body.jumps.pressed {
    next.body.jumps = input_press(next.body.jumps);
    next.body.jumps.held = jump;
  }
  next.body.wings = wings; next.body.dive_held = dive;
  return next;
}

walk_runs :: (shift: bool, stick_run: bool, pad_x: f32, pad_y: f32) -> bool #effects(all) {
  return input_runs(shift, stick_run, pad_x, pad_y);
}
// One frame's Intent (metaverse-engine/core/input.coax), from the keyboard or the touch stick alike.
walk_intent :: (p: Player, i: Intent) -> Player #effects(all) {
  return walk_input(p, 0, 0, i.move_x, i.move_y, i.run, i.jump, i.look_x, i.look_y);
}

// The way the controls push in the world, unit length when `on`.
Wish :: struct { x: f32; z: f32; on: bool; }

// Stick when it is past the dead zone, else keys, turned from the camera's
// frame into the world's.
body_wish :: (p: Body) -> Wish #effects(all) {
  ax := p.key_x; ay := p.key_y;
  if sqrt(p.pad_x * p.pad_x + p.pad_y * p.pad_y) > f32(DEAD_ZONE) { ax = p.pad_x; ay = p.pad_y; }
  size := sqrt(ax * ax + ay * ay);
  w: Wish;
  if size == 0 { return w; }
  mx := ax / size; mz := -ay / size;
  // Turn local -Z onto the camera's flat forward. The camera sits at theta
  // around the target, so its flat forward is -(sin theta, cos theta).
  c := math_cos(p.yaw); s := math_sin(p.yaw);
  w.x = mx * c + mz * s;
  w.z = -mx * s + mz * c;
  w.on = true;
  return w;
}

// book:begin asked
// The motion your controls ask for, m/s on the flat: the wish at the pace you walk or run. A follow
// camera turns toward this, not toward the velocity, which a wall, a push or a room server's
// correction changes without you asking (#12777).
body_asked :: (p: Body) -> Vec3 #effects(all) {
  w := body_wish(p);
  if !w.on { return Vec3.{}; }
  pace := ifx p.run then f32(RUN) else f32(WALK);
  return Vec3.{x = w.x * pace, y = 0, z = w.z * pace};
}
// book:end asked

#test "walk: the intent is the controls' wish at the pace, whatever the velocity a wall or a correction left (#12777)" {
  p := walk_place(0, 0, 0, 0);
  p = walk_input(p, 0, 1, 0, 0, false, false, 0, 0);   // W
  p.body.vel = Vec3.{x = 4, y = 0, z = 0};                  // a correction's sideways velocity
  w := wish(p); i := walk_asked(p);
  #assert near(i.x, w.x * f32(WALK), 0.0001) && near(i.z, w.z * f32(WALK), 0.0001);
  q := walk_input(p, 0, 0, 0, 0, false, false, 0, 0);
  #assert walk_asked(q).x == 0 && walk_asked(q).z == 0;
}

// The library's spring: a critically damped follow of dest, per axis. It
// returns the new position in x and the new velocity in y.
spring_axis :: (cur: f32, vel: f32, dest: f32, dt: f32) -> Vec3 #effects(all) {
  a := follow_spring_axis(cur, vel, dest, dt);
  return Vec3.{x = a.at, y = a.vel, z = 0};
}

// book:begin take
// One fixed step. It first takes a waiting jump press: from the ground, it jumps.
body_step_fixed :: (w: World, given: Body, dt: f32) -> Body #effects(all) {
  p := given;
  t := input_take(given.jumps);
  p.jumps = t.edge;
  if t.pressed && p.on_ground {
    p.vel.y = w.locomotion.jump_speed;
    p.on_ground = false;
  }
  beat := t.pressed && !given.on_ground;   // a press in the air: a wing beat, if the realm flies
// book:end take
// book:begin move
  next := p;
  dir := body_wish(p);
  speed := (ifx p.run then w.locomotion.run_speed else w.locomotion.walk_speed) * clamp(ifx finite(p.pace) then p.pace else 1.0f32, 0, 1);

  if w.locomotion.source_velocity {
    ax:=p.key_x;az:=p.key_y;pad:=sqrt(p.pad_x*p.pad_x+p.pad_y*p.pad_y);if pad>f32(DEAD_ZONE) {ax=p.pad_x;az=p.pad_y;}
    amount:=lo(sqrt(ax*ax+az*az),1);control:=ifx p.on_ground then 1.0f32 else w.locomotion.source_air_control;
    v:=source_velocity(next.vel.x,next.vel.z,dir.x,dir.z,amount,speed,w.locomotion.acceleration*control,ifx p.on_ground then w.locomotion.source_friction else 0.0f32,ifx p.on_ground then w.locomotion.source_braking else 0.0f32,w.locomotion.source_braking_factor,dt);next.vel.x=v.x;next.vel.z=v.z;
  }else {
  // Horizontal velocity steps toward the wish at a fixed rate.
  dx := dir.x * speed - next.vel.x;
  dz := dir.z * speed - next.vel.z;
  diff := sqrt(dx * dx + dz * dz);
  if diff > 0 {
    grip := ifx finite(p.grip) && p.grip > 0 && p.on_ground then lo(p.grip, 1.0f32) else 1.0f32;
    if p.sliding { grip = w.locomotion.slide_grip; }
    applied := lo(diff, w.locomotion.acceleration * grip * dt);
    next.vel.x += dx / diff * applied;
    next.vel.z += dz / diff * applied;
  }
  }
  contact := collide_move(colliders(w), w.collision, body_collision_state(next), next.vel.x * dt, next.vel.z * dt);
  // A refused step keeps the input Body, including its queued jump. The
  // outer FrameClock consumes the assigned step; only diagnostics change.
  if contact.status != CollideStatus.ok { return body_collision_report(given, contact); }
  next = body_collision_report(body_collision_apply(next, contact.state), contact);

  // Gravity and the floor.
  surface := query_ground_checked(colliders(w), next.pos.x, next.pos.z, next.pos.y + w.collision.step_up, w.collision.radius);
  if surface.status != QueryStatus.ok {
    refused := body_collision_report(given, CollideResult.{state = body_collision_state(given), status = CollideStatus.bad_state});
    refused.query_status = surface.status;
    return refused;
  }
  under := StandHit.{y = surface.y, gx = surface.gx, gz = surface.gz};
  ground := under.y;
  above := next.pos.y - ground;
  falls := true;
  next.sliding = false;
  if above <= w.locomotion.ride_height && next.vel.y <= 0 && stand_steep(under) {
    // Too steep to stand on: it holds you as you slide down it, gravity's pull along it speeding
    // you toward its low edge, and over that you fall.
    gl := sqrt(under.gx * under.gx + under.gz * under.gz);
    pull := w.locomotion.gravity * gl / (1 + gl * gl) * dt;
    next.vel.x -= under.gx / gl * pull; next.vel.z -= under.gz / gl * pull;
    next.vel.y = 0;
    next.pos.y = ground;
    next.on_ground = false;
    next.sliding = true;
    falls = false;
  } else if above <= w.locomotion.ride_height && next.vel.y <= 0 {
    if next.on_ground {
      // Standing: ease onto the floor.
      next.vel.y = 0;
      next.pos.y += (ground - next.pos.y) * lo(1, w.locomotion.step_smooth * dt);
      falls = false;
    } else if above + next.vel.y * dt <= 0 {
      // Lands this step.
      next.vel.y = 0;
      next.pos.y = ground;
      next.on_ground = true;
      falls = false;
    }
  }
  if falls {
    next.vel.y -= w.locomotion.gravity * dt;
    next.on_ground = false;
  }
  // A flying realm's hook: in the air, this step's vertical speed is the flight's.
  next.diving = false;
  if w.flight.on && !next.on_ground {
    lift := flight_vertical(w.flight, next.vel.y, next.pos.y, beat, p.jump_held, p.dive_held, p.wings);
    next.vel.y = lift.vy;
    next.diving = lift.diving;
    if lift.beat { next.beats += 1; }
  }
  vertical:=ifx w.locomotion.source_velocity && falls then (p.vel.y+next.vel.y)*0.5 else next.vel.y;
  next.pos.y = hi(next.pos.y + vertical * dt, ground - w.locomotion.sink_limit);

  // Turn toward where you are going.
  if dir.on {
    want := atan2(dir.x, dir.z);
    next.face = wrap_angle(next.face + turn_toward(want, next.face) * lo(1, w.locomotion.turn_rate * dt));
  }

  if !next.on_ground { next.act = Act.airborne; }
  else if !dir.on { next.act = Act.idle; }
  else if speed > w.locomotion.walk_speed + w.locomotion.run_animation_margin { next.act = Act.running; }   // shown running only at a run's speed
  else { next.act = Act.walking; }
  return next;
}
// book:end move

// The turn from face to want, the short way. Half a circle either way is a tie, broken one way:
// anticlockwise. Otherwise a page and the room it plays in, a hair apart, turn opposite ways, and
// the room's correction spins you round.
turn_toward :: (want: f32, face: f32) -> f32 #effects(all) {
  turn := wrap_angle(want - face);
  if abs(turn) > f32(PI) - 0.05 { turn = abs(turn); }
  return turn;
}
#test "a turn of nearly half a circle goes anticlockwise from either side; a shorter one keeps its way" {
  tie := f32(PI) - 0.05;
  // Exactly the tie's width is not yet a tie: the turn keeps its own, clockwise, way.
  #assert turn_toward(0, tie) == -tie && turn_toward(0, -tie) == tie;
  // Past it, both sides turn anticlockwise by the same amount.
  near_half := f32(PI) - 0.02;
  #assert turn_toward(0, near_half) == near_half && turn_toward(0, -near_half) == near_half;
  #assert turn_toward(0, f32(PI) - 0.06) == -(f32(PI) - 0.06) && turn_toward(0.5, 0.25) == 0.25 && turn_toward(0.25, 0.5) == -0.25;
  // Through a step: facing a hair short of straight back and walking forward, you come round anticlockwise.
  w: World;
  p := held(walk_place(0, 0, 0, 0), 0, 1, false);
  p.body.face = near_half;
  q := step(w, p, STEP);
  #assert near(wrap_angle(q.body.face - near_half), near_half * f32(TURN_RATE * STEP), 0.0001);
  p.body.face = -near_half;
  q = step(w, p, STEP);
  #assert near(wrap_angle(q.body.face + near_half), near_half * f32(TURN_RATE * STEP), 0.0001);
}

// ---- A page's player over the body's functions ----
// The body's procedures (body_step, body_move_across, body_collision_report and the rest) take and
// return a Body: they are what the server runs. A page holds a Player, its body and its camera, and
// these are the same procedures for it. Where the step reads the view's yaw, the page's camera
// gives it; the camera's own fields are not touched.
player_yawed :: (p: Player) -> Body #effects(all) { b := p.body; b.yaw = p.cam.theta; return b; }
step :: (w: World, p: Player, dt: f32) -> Player #effects(all) { next := p; next.body = body_step(w, player_yawed(p), dt); return next; }
wish :: (p: Player) -> Wish #effects(all) { return body_wish(player_yawed(p)); }
walk_asked :: (p: Player) -> Vec3 #effects(all) { return body_asked(player_yawed(p)); }
collision_state :: (p: Player) -> CollideState #effects(all) { return body_collision_state(p.body); }
collision_report :: (p: Player, r: CollideResult) -> Player #effects(all) { next := p; next.body = body_collision_report(p.body, r); return next; }
off_floors :: (w: World, from: Player, p: Player) -> Player #effects(all) { next := p; next.body = body_off_floors(w, from.body, p.body); return next; }
out_of_walls :: (w: World, p: Player) -> Player #effects(all) { next := p; next.body = body_out_of_walls(w, p.body); return next; }
move_across :: (w: World, p: Player, dx: f32, dz: f32) -> Player #effects(all) { next := p; next.body = body_move_across(w, p.body, dx, dz); return next; }

// ---- The server's body: placed, given its controls, advanced; no camera anywhere ----
// Stands a body at feet facing yaw; the view starts behind it.
body_place_in :: (w: World, x: f32, y: f32, z: f32, yaw: f32) -> Body #effects(all) { return place_in(w, x, y, z, yaw).body; }
// The same on the flat ground with nothing on it.
body_place :: (x: f32, y: f32, z: f32, yaw: f32) -> Body #effects(all) { w: World; return body_place_in(w, x, y, z, yaw); }
// A tick's controls for a body: the keys and stick, run and jump held, and the view's yaw (radians,
// the camera's theta: what the wire carries). The same clamps and jump edge as walk_input.
body_input :: (b: Body, key_x: f32, key_y: f32, pad_x: f32, pad_y: f32, run: bool, jump: bool, view_yaw: f32) -> Body #effects(all) {
  p: Player; p.body = b;
  next := walk_input(p, key_x, key_y, pad_x, pad_y, run, jump, 0, 0).body;
  next.yaw = ifx finite(view_yaw) then wrap_angle(view_yaw) else b.yaw;
  return next;
}
// One fixed step of a body with its history kept for drawing between steps.
body_history_step :: (w: World, b: Body) -> Body #effects(all) {
  next := b; next.prev_pos = b.pos; next.prev_face = b.face;
  return body_step(w, next, STEP);
}
// Advances a body by a frame's time on the one clock: the steps that are due, none of them a camera's.
body_advance_in :: (w: World, b: Body, frame: f32) -> Body #effects(all) {
  schedule := walk_schedule(b.clock, frame);
  if !schedule.ok { return body_collision_report(b, CollideResult.{state = body_collision_state(b), status = CollideStatus.bad_profile}); }
  next := b; next.clock = schedule.clock;
  for i: 0..<schedule.count { next = body_history_step(w, next); }
  next.clock = loop_ran(next.clock);
  return next;
}

#test "body: the server's body moves exactly as a page's player does, with no camera (#13271)" {
  w: World;
  p := walk_place(1, 0, -2, 0.5);
  b := body_place_in(w, 1, 0, -2, 0.5);
  #assert body_place(1, 0, -2, 0.5).pos.z == -2 && body_place(1, 0, -2, 0.5).face == b.face && body_place(1, 0.2, -2, 0.5).on_ground && !body_place(1, 2, -2, 0.5).on_ground;
  #assert b.pos.x == 1 && b.pos.z == -2 && b.face == p.body.face && b.yaw == p.cam.theta && b.on_ground && b.prev_pos.x == 1;
  // walk forward, turn the view, run, jump: every frame the two agree to the bit
  for f: 0..<240 {
    turn: f32 = ifx f >= 60 && f < 90 then 0.02 else 0.0;
    run := f >= 120; jump := f == 150 || f == 151;
    p = walk_input(p, 0, 1, 0, 0, run, jump, turn, 0);
    b = body_input(b, 0, 1, 0, 0, run, jump, p.cam.theta);
    frame: f32 = ifx (f % 3) == 0 then 0.021 else 0.0125;   // uneven frames: 0, 1 or 2 steps each
    p = advance_in(w, p, frame);
    b = body_advance_in(w, b, frame);
    #assert b.pos.x == p.body.pos.x && b.pos.y == p.body.pos.y && b.pos.z == p.body.pos.z;
    #assert b.vel.x == p.body.vel.x && b.vel.y == p.body.vel.y && b.vel.z == p.body.vel.z;
    #assert b.face == p.body.face && b.on_ground == p.body.on_ground && b.act == p.body.act;
    #assert b.prev_pos.x == p.body.prev_pos.x && b.prev_pos.z == p.body.prev_pos.z && b.prev_face == p.body.prev_face;
    #assert b.clock.ticks == p.body.clock.ticks && b.clock.carry_ns == p.body.clock.carry_ns && b.clock.ran == p.body.clock.ran && b.jumps.taken == p.body.jumps.taken;
  }
  #assert b.pos.z != -2 && b.clock.ticks > 200 && b.jumps.taken == 1;   // it went somewhere, on many steps, and jumped once
}
#test "body: the step reads the view's yaw and nothing else of the camera" {
  w: World;
  p := walk_input(walk_place(0, 0, 0, 0), 0, 1, 0, 0, false, false, 0, 0);
  q := p; q.cam.phi = 0.3; q.cam.dist = 1; q.cam.max_dist = 2; q.cam.zoom_push = 5; q.cam.target = Vec3.{x = 9, y = 9, z = 9}; q.cam.spring_vel = Vec3.{x = 1, y = 1, z = 1};
  a := step(w, p, STEP); c := step(w, q, STEP);
  #assert a.body.pos.x == c.body.pos.x && a.body.pos.z == c.body.pos.z && a.body.vel.z == c.body.vel.z && a.body.face == c.body.face;
  #assert c.cam.phi == 0.3 && c.cam.dist == 1 && c.cam.target.x == 9;   // and the body's step leaves the camera as it was
  // the yaw is the input: a quarter turn of the view turns the way W goes
  r := p; r.cam.theta = p.cam.theta + f32(PI) / 2;
  d := step(w, r, STEP);
  #assert abs(d.body.vel.x) > 0.5 && abs(d.body.vel.z) < 0.001 && abs(a.body.vel.z) > 0.5 && abs(a.body.vel.x) < 0.001;
  // a stale body.yaw does not matter to a page: its camera's yaw is what the step is given
  s2 := p; s2.body.yaw = 1.234;
  #assert step(w, s2, STEP).body.vel.z == a.body.vel.z && player_yawed(s2).yaw == p.cam.theta;
  #assert body_wish(player_yawed(p)).z == wish(p).z && body_asked(player_yawed(p)).z == walk_asked(p).z && walk_asked(p).z != 0;
}
#test "body: its controls are clamped, a jump is one press, and the view's yaw is wrapped or kept" {
  w: World;
  b := body_place_in(w, 0, 0, 0, 0);
  n := body_input(b, 3, -3, 0.5, 9, true, true, 7.0);
  #assert n.key_x == 1 && n.key_y == -1 && n.pad_x == 0.5 && n.pad_y == 1 && n.run && n.jump_held && n.jumps.pressed == b.jumps.pressed + 1;
  #assert near(n.yaw, 7.0 - f32(TAU), 0.0001) && n.yaw < f32(PI);
  #assert body_input(n, 0, 0, 0, 0, false, true, 0.25).jumps.pressed == n.jumps.pressed;   // still held: no second press
  #assert body_input(n, 0, 0, 0, 0, false, false, 0.25).yaw == 0.25 && !body_input(n, 0, 0, 0, 0, false, false, 0.25).run;
  bad: f32 = 2000000.0;
  #assert body_input(n, 0, 0, 0, 0, false, false, bad).yaw == n.yaw && body_input(n, 0, 0, 0, 0, false, false, -bad).yaw == n.yaw;
  #assert body_input(n, bad, 0, 0, 0, false, false, 0).key_x == 0;
}
#test "body: a step keeps where the last began; a clock that is not the engine's is refused and nothing moves" {
  w: World;
  b := body_input(body_place_in(w, 0, 0, 0, 0), 0, 1, 0, 0, true, false, f32(PI));
  one := body_history_step(w, b);
  #assert one.prev_pos.z == b.pos.z && one.pos.z != b.pos.z && one.prev_face == b.face;
  two := body_history_step(w, one);
  #assert two.prev_pos.z == one.pos.z && two.prev_face == one.face && two.pos.z != one.pos.z;
  // a frame's time: the due steps, and the clock says how many ran
  adv := body_advance_in(w, b, f32(STEP) * 2);
  #assert adv.clock.ticks == 2 && adv.clock.ran == 2 && adv.pos.z == two.pos.z && adv.prev_pos.z == one.pos.z && adv.collision_status == CollideStatus.ok;
  none := body_advance_in(w, b, 0);
  #assert none.clock.ticks == 0 && none.clock.ran == 0 && none.pos.z == b.pos.z;
  odd := b; odd.clock.step_ns = 1000;
  r := body_advance_in(w, odd, f32(STEP) * 2);
  #assert r.collision_status == CollideStatus.bad_profile && r.collision_refusals == 1 && r.pos.z == b.pos.z && r.clock.ticks == 0 && r.clock.step_ns == 1000;
}

// A body's frame in a realm's declared collision profile (and its flight, when it flies), among the
// bodies, walls, floors and hulls near it: what a room server runs for a seat.
body_advance_among_hulls :: (b: Body, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32, hulls: [] f32, realm: string) -> Body #effects(all) {
  declaration := realm_collision.collision_profile_lookup(realm);
  if declaration.status != realm_collision.CollisionProfileStatus.ok {
    return body_collision_report(b, CollideResult.{state = body_collision_state(b), status = CollideStatus.bad_profile});
  }
  w := World.{bodies = bodies, walls = walls, floors = floors, hulls = hulls, collision = declaration.profile, flight = flight_profile_lookup(realm)};
  return body_advance_in(w, b, frame);
}
#test "body: in a realm's profile it advances as the page's player does; an unknown realm is refused; drawn feet, facing and bounds agree" {
  hold: [1] f32; none := hold[0..<0]; wall := [6] f32.[-5, 0, 2, 5, 3, 2.5];
  p := walk_input(walk_place(0, 0, 0, 0), 0.4, 1, 0, 0, true, false, 0, 0);
  b := p.body;
  for f: 0..<90 {
    p = walk_advance_among_hulls(p, 0.011, none, wall[..], none, none, "everglade");
    b = body_advance_among_hulls(b, 0.011, none, wall[..], none, none, "everglade");
    #assert b.pos.x == p.body.pos.x && b.pos.z == p.body.pos.z && b.vel.x == p.body.vel.x && b.face == p.body.face && b.clock.carry_ns == p.body.clock.carry_ns;
    #assert body_feet(b).x == walk_feet(p).x && body_feet(b).z == walk_feet(p).z && body_face(b) == walk_face(p) && body_counts(b, 0.011) == walk_counts(p, 0.011);
  }
  #assert b.pos.x != 0 && b.pos.z > 1 && b.pos.z < 2;   // it walked to the wall and was stopped by it
  #assert body_counts(b, 0.011) > 0.0109 && body_counts(b, 0.011) < 0.0111;
  // drawn feet: half way into the next step, half way between the last two
  h := b; h.prev_pos = Vec3.{x = 1, y = 0, z = 1}; h.pos = Vec3.{x = 2, y = 0, z = 3}; h.clock.carry_ns = LOOP_STEP_NS / 2;
  #assert near(body_feet(h).x, 1.5, 0.001) && near(body_feet(h).z, 2, 0.001);
  r := body_advance_among_hulls(b, 0.011, none, wall[..], none, none, "no-such-realm");
  #assert r.collision_status == CollideStatus.bad_profile && r.pos.z == b.pos.z && r.clock.carry_ns == b.clock.carry_ns;
  odd := b; odd.clock.step_ns = 7; #assert body_counts(odd, 0.011) == 0;
  // a realm's bound: put there with no slide and no speed into it, each axis on its own
  c := body_constrain(b, b.pos.x, 1.0);
  #assert c.pos.z == 1.0 && c.prev_pos.z == 1.0 && c.vel.z == 0 && c.pos.x == b.pos.x && c.prev_pos.x == b.prev_pos.x && c.vel.x == b.vel.x && b.vel.x != 0;
  d := body_constrain(b, 3.0, b.pos.z);
  #assert d.pos.x == 3.0 && d.prev_pos.x == 3.0 && d.vel.x == 0 && d.pos.z == b.pos.z && d.prev_pos.z == b.prev_pos.z && d.vel.z == b.vel.z;
  // the page's player: the same body, and its camera's target carried with it
  q := walk_constrain(p, 3.0, 1.0);
  #assert q.body.pos.x == 3.0 && q.body.pos.z == 1.0 && near(q.cam.target.x - p.cam.target.x, 3.0 - p.body.pos.x, 0.0001) && near(q.cam.prev_target.z - p.cam.prev_target.z, 1.0 - p.body.pos.z, 0.0001);
  same := walk_constrain(p, p.body.pos.x, p.body.pos.z);
  #assert same.cam.target.x == p.cam.target.x && same.cam.target.z == p.cam.target.z && same.body.vel.x == p.body.vel.x;
  // a facing that turns: drawn between the last two
  t := b; t.prev_face = 0.2; t.face = 0.6; t.clock.carry_ns = LOOP_STEP_NS / 2;
  #assert near(body_face(t), 0.4, 0.001);
}

// book:begin camera
// The camera's step, after the player's (metaverse-engine/cam/follow.coax): its target follows you on the
// spring, and it pulls in at once where something is in the way and backs out gently. It reads
// the step's result and the colliders and changes only the camera's fields, so the player's step
// is the same with the camera or without it. The player keeps those fields because the realms'
// C faces read them.
camera_step :: (w: World, p: Player, dt: f32) -> Player #effects(all) {
  next := p;
  cam := follow_track(follow_of(p), colliders(w), w.room, wp(look_at(p)), dt);
  next.cam.target = vp(cam.target); next.cam.spring_vel = vp(cam.vel); next.cam.dist = cam.dist;
  next.cam.query_status = cam.status;
  return next;
}
// One fixed step of the player, then of its camera: what steps_in runs each step.
step_once :: (w: World, p: Player, dt: f32) -> Player #effects(all) {
  next := step(w, p, dt);
  if next.body.collision_status != CollideStatus.ok { return next; }
  return camera_step(w, next, dt);
}
// book:end camera

// book:begin advance
// Advances by a frame's time in fixed steps, on the player's clock (metaverse-engine/core/loop.coax):
// the frame's time is clamped, at most LOOP_MAX_STEPS run, and a longer backlog is
// dropped, so a stall never makes a frame slower.
advance_in :: (w: World, p: Player, frame: f32) -> Player #effects(all) {
  return advance_traced(w, p, frame).player;
}

AdvanceTrace :: struct { player: Player; count: int; targets: [LOOP_MAX_STEPS] StepTarget; }
WalkSchedule :: struct { ok: bool; clock: FrameClock; count: int; }
// A new walking frame starts from a paid fixed clock. Zeroed clock defaults
// normalize through loop_accept, but a different positive period is refused.
walk_schedule :: (clock: FrameClock, frame: f32) -> WalkSchedule #effects(all) {
  if (clock.step_ns > 0 && clock.step_ns != LOOP_STEP_NS) || clock.max_steps > LOOP_MAX_STEPS || clock.carry_ns < 0 || clock.carry_ns >= LOOP_STEP_NS || clock.due != 0 {
    return WalkSchedule.{};
  }
  accepted := loop_accept(clock, f64(frame));
  count := loop_due(accepted);
  // Canonical carry, the fixed positive period and the admitted step cap
  // make loop_accept's count lie in0..8, including normalized clock defaults.
  return WalkSchedule.{ok = true, clock = accepted, count = count};
}
walk_target :: (p: Player) -> StepTarget #effects(all) {
  return StepTarget.{feet = wp(p.body.pos), velocity = StepVelocity.{x = p.body.vel.x, y = p.body.vel.y, z = p.body.vel.z},
    face = p.body.face, act = cast(u8) p.body.act, collision_status = cast(u8) p.body.collision_status};
}
advance_traced :: (w: World, p: Player, frame: f32) -> AdvanceTrace #effects(all) {
  out := AdvanceTrace.{player = p};
  schedule := walk_schedule(p.body.clock, frame);
  if !schedule.ok {
    out.player = collision_report(p, CollideResult.{state = collision_state(p), status = CollideStatus.bad_profile});
    return out;
  }
  next := p; next.body.clock = schedule.clock; out.count = schedule.count;
  for i: 0..<schedule.count {
    next = history_step(w, next);
    out.targets[i] = walk_target(next);
  }
  next.body.clock = loop_ran(next.body.clock); out.player = next;
  return out;
}
history_step :: (w: World, p: Player) -> Player #effects(all) {
  next := p; next.body.prev_pos = p.body.pos; next.cam.prev_target = p.cam.target;
  next.body.prev_face = p.body.face; next.cam.prev_dist = p.cam.dist;
  return step_once(w, next, STEP);
}
// Runs n fixed steps (what a clock says are due), keeping where the last began, so the
// frame interpolates between the last two.
steps_in :: (w: World, p: Player, n: int) -> Player #effects(all) {
  next := p;
  for i: 0..<n {
    next = history_step(w, next);
  }
  return next;
}
// book:end advance

walk_advance :: (p: Player, frame: f32) -> Player #effects(all) {
  w: World;
  return advance_in(w, p, frame);
}

// The same among bodies (BODY numbers each, as metaverse_cast_bodies writes
// them) and walls (WALL numbers each, as metaverse_grid_walls writes them); a
// partial last one is ignored.
walk_advance_among :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32) -> Player #effects(all) {
  w: World;
  w.bodies = bodies;
  w.walls = walls;
  return advance_in(w, p, frame);
}
// And on floors (STAND_FLOATS numbers each, metaverse-engine/physics/stand.coax), on the same floor as the walls.
walk_advance_on :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32) -> Player #effects(all) {
  w: World;
  w.bodies = bodies;
  w.walls = walls;
  w.floors = floors;
  return advance_in(w, p, frame);
}

// A shipped walking realm uses its declared profile. An unknown renderer
// refuses before accepting time or consuming a waiting input press.
walk_advance_in_realm :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32, realm: string) -> Player #effects(all) {
  return walk_advance_in_realm_traced(p, frame, bodies, walls, floors, realm).player;
}
walk_advance_in_realm_traced :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32, realm: string) -> AdvanceTrace #effects(all) {
  return walk_advance_among_hulls_traced(p, frame, bodies, walls, floors, floors[0..<0], realm);
}
// And among hulls (metaverse-engine/physics/query.coax), a realm's rocks shaped from their meshes.
walk_advance_among_hulls :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32, hulls: [] f32, realm: string) -> Player #effects(all) {
  return walk_advance_among_hulls_traced(p, frame, bodies, walls, floors, hulls, realm).player;
}
walk_advance_among_hulls_traced :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32, hulls: [] f32, realm: string) -> AdvanceTrace #effects(all) {
  declaration := realm_collision.collision_profile_lookup(realm);
  if declaration.status != realm_collision.CollisionProfileStatus.ok {
    return AdvanceTrace.{player = collision_report(p, CollideResult.{state = collision_state(p), status = CollideStatus.bad_profile})};
  }
  w := World.{bodies = bodies, walls = walls, floors = floors, hulls = hulls, collision = declaration.profile, flight = flight_profile_lookup(realm)};
  return advance_traced(w, p, frame);
}

walk_collision_status :: (p: Player) -> int #effects(all) { return cast(int) cast(u8) p.body.collision_status; }
walk_collision_refusals :: (p: Player) -> u64 #effects(all) { return p.body.collision_refusals; }
walk_collision_residual :: (p: Player) -> f32 #effects(all) { return p.body.collision_residual; }
walk_collision_passes :: (p: Player) -> int #effects(all) { return p.body.collision_passes; }
walk_collision_floor_cut :: (p: Player) -> bool #effects(all) { return p.body.collision_floor_cut; }
walk_query_status :: (p: Player) -> int #effects(all) { return cast(int) cast(u8) p.body.query_status; }
walk_camera_query_status :: (p: Player) -> int #effects(all) { return cast(int) cast(u8) p.cam.query_status; }

// The seconds a frame of `frame` counts for on the player's clock, before it advances: what a
// page face moves the rest of its realm by (its animation, its room's timing), so the realm
// and the player are clamped and dropped by the one clock. It replaced the faces' own 0.1 s
// clamps.
walk_counts :: (p: Player, frame: f32) -> f32 #effects(all) { return body_counts(p.body, frame); }
body_counts :: (b: Body, frame: f32) -> f32 #effects(all) {
  schedule := walk_schedule(b.clock, frame);
  return ifx schedule.ok then f32(f64(schedule.clock.counted_ns) / f64(LOOP_SECOND)) else 0.0f32;
}
// The fixed steps the player's last frame ran.
walk_ran :: (p: Player) -> int #effects(all) { return p.body.clock.ran; }

// How far this frame is between the last two steps, in [0, 1].
alpha :: (p: Player) -> f32 #effects(all) { return loop_alpha(p.body.clock); }

// book:begin drawn
// The feet and facing to draw this frame.
walk_feet :: (p: Player) -> Vec3 #effects(all) { return body_feet(p.body); }
walk_face :: (p: Player) -> f32 #effects(all) { return body_face(p.body); }
// A body's feet and facing as drawn: between its last two steps, by how far its clock is into the next.
body_feet :: (b: Body) -> Vec3 #effects(all) { return mix3(b.prev_pos, b.pos, loop_alpha(b.clock)); }
body_face :: (b: Body) -> f32 #effects(all) {
  return wrap_angle(b.prev_face + wrap_angle(b.face - b.prev_face) * loop_alpha(b.clock));
}
// The camera this frame, the Metaverse Engine's third-person shot: what it looks at, and where it is. A wall
// pulls the camera in at once, so it is never shown further out than the last step.
walk_shot :: (p: Player) -> CameraShot #effects(all) { return follow_shot(follow_of(p), wp(p.cam.prev_target), p.cam.prev_dist, alpha(p)); }
walk_at :: (p: Player) -> Vec3 #effects(all) { return vp(walk_shot(p).at); }
walk_eye :: (p: Player) -> Vec3 #effects(all) { return vp(walk_shot(p).eye); }
// book:end drawn
walk_act :: (p: Player) -> int #effects(all) { return cast(int) cast(u8) p.body.act; }

// ---- Checks ----

near :: (a: f32, b: f32, tolerance: f32) -> bool #effects(all) { return abs(a - b) <= tolerance; }
flat_speed :: (p: Player) -> f32 #effects(all) { return sqrt(p.body.vel.x * p.body.vel.x + p.body.vel.z * p.body.vel.z); }
held :: (p: Player, key_x: f32, key_y: f32, run: bool) -> Player #effects(all) {
  return walk_input(p, key_x, key_y, 0, 0, run, false, 0, 0);
}

#forall "atan2 points the right way" ix: -4..<5, iy: -4..<5 {
  x := f32(ix) * 0.5; y := f32(iy) * 0.5;
  a := atan2(y, x);
  #assert a >= -f32(PI) && a <= f32(PI);
  r := sqrt(x * x + y * y);
  if r == 0 { #assert a == 0; }
  else {
    #assert near(cos(a) * r, x, 0.0001 * r);
    #assert near(sin(a) * r, y, 0.0001 * r);
  }
}

#test "moving runs by default; Shift walks; a stick goes by its push" {
  #assert RUN_BY_DEFAULT;
  #assert walk_runs(false, false, 0, 0) && !walk_runs(true, false, 0, 0);
  #assert walk_runs(false, true, 0, 1) && !walk_runs(false, false, 0, 0.5);
  #assert !walk_runs(true, false, 0, 0.5) && walk_runs(true, true, 0, 1);
  #assert walk_runs(false, false, 0.1, 0.1);   // inside the dead zone the keys decide
  // the speed follows: a run reaches RUN, a walk WALK, and you're shown running only when you are
  w: World;
  p := walk_place(0, 0, 0, 0);
  p = held(p, 0, 1, walk_runs(false, false, 0, 0));
  for i: 0..<60 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(RUN), 0.001) && p.body.act == Act.running;
  p = held(p, 0, 1, walk_runs(true, false, 0, 0));
  for i: 0..<60 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(WALK), 0.001) && p.body.act == Act.walking;
}

#test "atan2 behind is +PI, not -PI" {
  #assert atan2(0, -1) == f32(PI);
  #assert atan2(-0.5, -1) < 0;
}

#forall "atan_unit is close everywhere" i: 0..<101 {
  t := f32(i) / 100;
  #assert near(tan(atan_unit(t)), t, 0.00004);
}

#forall "wrap_angle keeps the direction" k: -30..<31 {
  a := f32(k) * 0.7;
  w := wrap_angle(a);
  #assert w >= -f32(PI) && w < f32(PI);
  #assert near(sin(w), sin(a), 0.0005) && near(cos(w), cos(a), 0.0005);
}

#test "placing sets every part of you" {
  w: World;
  w.ground = 2;
  p := place_in(w, 1, 2.25, -3, 0.5);
  #assert p.body.pos.x == 1 && p.body.pos.y == 2.25 && p.body.pos.z == -3;
  #assert p.body.face == 0.5 && near(p.cam.theta, 0.5 - f32(PI), 0.000001);
  #assert p.body.on_ground;
  #assert p.cam.target.x == 1 && near(p.cam.target.y, 3.77, 0.000001) && p.cam.target.z == -3;
  #assert p.body.prev_pos.x == 1 && p.body.prev_pos.y == 2.25 && p.cam.prev_target.y == p.cam.target.y && p.body.prev_face == 0.5;
  // Higher than RIDE_HEIGHT over this floor is in the air.
  #assert !place_in(w, 0, 2.41, 0, 0).body.on_ground;
  #assert place_in(w, 0, 0.3, 0, 0).body.on_ground;
  q := walk_place(0, 0.4, 0, 0);
  #assert q.body.on_ground && !walk_place(0, 0.41, 0, 0).body.on_ground;
}

// One stick push, walking or running, for 90 steps. Split by gait into two checks (#13094): the 98
// cases together came to 23,374,506 steps, 83% of the 28,000,000 the one check had.
// What the push did: the steps taken, the most the flat speed and one step's change of velocity
// reached, the steps that ended on the ground and at its height, and the speed at the end.
SpeedRun :: struct { steps: int; top: f32; change: f32; grounded: int; level: int; last: f32; }
walk_speed_run :: (run: bool, ix: int, iy: int, count: int) -> SpeedRun #effects(all) {
  w: World; r: SpeedRun;
  p := walk_place(0, 0, 0, 0);
  p = walk_input(p, 0, 0, f32(ix) * 0.5, f32(iy) * 0.5, run, false, 0, 0);
  for i: 0..<count {
    before := p.body.vel;
    p = step(w, p, STEP);
    dvx := p.body.vel.x - before.x; dvz := p.body.vel.z - before.z;
    r.steps += 1;
    r.top = hi(r.top, flat_speed(p));
    r.change = hi(r.change, sqrt(dvx * dvx + dvz * dvz));
    if p.body.on_ground { r.grounded += 1; }
    if p.body.pos.y == 0 { r.level += 1; }
  }
  r.last = flat_speed(p);
  return r;
}
speed_within :: (value: f32, limit: f32) -> bool #effects(all) { return value <= limit + 0.001; }
// A run keeps the walker's promises when every step stayed on the level ground, the speed never
// passed the top, and: with the stick held past the dead zone, the speed changed by ACCEL a step
// at its fastest and ended at the top, which is the most it reached; with the stick at rest, nothing moved.
speed_run_holds :: (r: SpeedRun, top: f32, pushed: bool, count: int) -> bool #effects(all) {
  if r.steps != count || r.grounded != count || r.level != count { return false; }
  if !speed_within(r.top, top) { return false; }
  if !pushed { return r.last == 0 && r.top == 0 && r.change == 0; }
  return near(r.last, top, 0.001) && r.top >= r.last && near(r.change, f32(ACCEL * STEP), 0.001);
}
#test "the speed judge refuses each fault alone" {
  top: f32 = 3.5;
  #assert speed_within(top + 0.001, top) && !speed_within(top + 0.002, top) && speed_within(0, top);
  good := SpeedRun.{steps = 90, top = 3.5, change = f32(ACCEL * STEP), grounded = 90, level = 90, last = 3.5};
  #assert speed_run_holds(good, top, true, 90);
  bad := good; bad.steps = 89; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.steps = 91; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.grounded = 89; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.level = 89; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.top = 3.502; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.last = 3.49; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.top = 3.4995; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.change = f32(ACCEL * STEP) + 0.002; #assert !speed_run_holds(bad, top, true, 90);
  bad = good; bad.change = f32(ACCEL * STEP) - 0.002; #assert !speed_run_holds(bad, top, true, 90);
  // At rest nothing may have moved, and a moving run is not one at rest.
  rest := SpeedRun.{steps = 90, grounded = 90, level = 90};
  #assert speed_run_holds(rest, top, false, 90) && !speed_run_holds(good, top, false, 90) && !speed_run_holds(rest, top, true, 90);
  bad = rest; bad.last = 0.1; #assert !speed_run_holds(bad, top, false, 90);
  bad = rest; bad.top = 0.1; #assert !speed_run_holds(bad, top, false, 90);
  bad = rest; bad.change = 0.1; #assert !speed_run_holds(bad, top, false, 90);
}
walk_speed_holds :: (run: bool, ix: int, iy: int) -> bool #effects(all) {
  top := ifx run then f32(RUN) else f32(WALK);
  return speed_run_holds(walk_speed_run(run, ix, iy, 90), top, ix * ix + iy * iy > 0, 90);
}
#forall "speed never passes the top, and changes no faster than ACCEL, walking" ix: -3..<4, iy: -3..<4 { #assert walk_speed_holds(false, ix, iy); }
#forall "speed never passes the top, and changes no faster than ACCEL, running" ix: -3..<4, iy: -3..<4 { #assert walk_speed_holds(true, ix, iy); }

#test "on ice (a grip under one) the same wish takes you up to speed slower, and you slide on" {
  p := walk_place(0, 0, 0, 0);
  p = walk_input(p, 0, 1, 0, 0, true, false, 0, 0);
  dry := walk_advance(p, 0.0625);
  p.body.grip = 0.1;
  icy := walk_advance(p, 0.0625);
  #assert flat_speed(icy) < flat_speed(dry) * 0.2 && flat_speed(icy) > 0;
}

#test "a pace under one slows you by its share, and the land speeds stay as they are" {
  w: World;
  p := held(walk_place(0, 0, 0, 0), 0, 1, false);
  p.body.pace = 0.5;
  for i: 0..<128 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(WALK) * 0.5, 0.001);
  p.body.pace = 1;
  for i: 0..<128 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(WALK), 0.001);
  #assert walk_place(0, 0, 0, 0).body.pace == 1;
}

#forall "a stick inside the dead zone doesn't move you" ix: -3..<4, iy: -3..<4 {
  w: World;
  p := walk_place(0, 0, 0, 0);
  p = walk_input(p, 0, 0, f32(ix) * 0.04, f32(iy) * 0.04, false, false, 0, 0);
  for i: 0..<30 { p = step(w, p, STEP); }
  #assert p.body.pos.x == 0 && p.body.pos.z == 0 && p.body.act == Act.idle;
}

#test "the dead zone ends at DEAD_ZONE" {
  w: World;
  p := walk_place(0, 0, 0, 0);
  #assert step(w, walk_input(p, 0, 0, 0, 0.2, false, false, 0, 0), STEP).body.vel.z == 0;
  #assert step(w, walk_input(p, 0, 0, 0, 0.21, false, false, 0, 0), STEP).body.vel.z > 0;
  // Past it, the stick wins over the keys.
  q := step(w, walk_input(p, 0, -1, 0, 0.5, false, false, 0, 0), STEP);
  #assert q.body.vel.z > 0;
}

#forall "forward is the way you face" k: -4..<5 {
  w: World;
  yaw := f32(k) * 0.75;
  p := held(walk_place(0, 0, 0, yaw), 0, 1, false);
  for i: 0..<64 { p = step(w, p, STEP); }
  // One second at walking speed, less the time to get up to it.
  d := sqrt(p.body.pos.x * p.body.pos.x + p.body.pos.z * p.body.pos.z);
  #assert d > 3.3 && d <= f32(WALK);
  #assert near(p.body.pos.x / d, sin(yaw), 0.001) && near(p.body.pos.z / d, cos(yaw), 0.001);
  #assert near(wrap_angle(p.body.face - yaw), 0, 0.001);
  #assert p.body.act == Act.walking;
}

#test "the character turns to where it moves, at TURN_RATE" {
  w: World;
  // Right with the camera behind: walk toward -X.
  p := held(walk_place(0, 0, 0, 0), 1, 0, false);
  q := step(w, p, STEP);
  want := -f32(PI) / 2;
  #assert near(q.body.face, want * f32(TURN_RATE * STEP), 0.0001);
  for i: 0..<120 { q = step(w, q, STEP); }
  #assert near(q.body.face, want, 0.001);
  #assert q.body.vel.x < 0 && near(q.body.vel.z, 0, 0.0001);
  // Letting go keeps the facing.
  r := step(w, held(q, 0, 0, false), STEP);
  #assert r.body.face == q.body.face;
}

#forall "a jump goes up 1.17 m and lands back on the floor" run: bool, ix: -1..<2 {
  w: World;
  p := walk_place(0, 0, 0, 0);
  p = walk_input(p, f32(ix), 0, 0, 0, run, true, 0, 0);
  #assert p.body.on_ground && p.body.jumps.waiting == 1;   // the press waits for the step
  p = step(w, p, STEP);
  #assert !p.body.on_ground && p.body.vel.y < f32(JUMP) && p.body.vel.y > f32(JUMP) - 1 && p.body.jumps.waiting == 0;
  peak := p.body.pos.y;
  steps := 1;
  while !p.body.on_ground && steps < 120 {
    p = step(w, p, STEP);
    if !p.body.on_ground { #assert p.body.act == Act.airborne; }
    // Holding jump in the air never jumps again.
    p = walk_input(p, f32(ix), 0, 0, 0, run, true, 0, 0);
    peak = hi(peak, p.body.pos.y);
    #assert p.body.pos.y >= -0.05;
    steps += 1;
  }
  #assert p.body.on_ground && p.body.pos.y == 0 && p.body.vel.y == 0;
  #assert near(peak, f32(JUMP * JUMP / (2 * GRAVITY)), 0.07);
  // About 2 JUMP / GRAVITY, 0.63 s.
  #assert steps >= 38 && steps <= 42;
  #assert p.body.act != Act.airborne;
}

#test "jump acts on the press, not the hold, and only from the ground" {
  w: World;
  p := walk_place(0, 0, 0, 0);
  p = walk_input(p, 0, 0, 0, 0, false, true, 0, 0);
  for i: 0..<5 { p = step(w, p, STEP); }
  vy := p.body.vel.y;
  #assert !p.body.on_ground && vy > 0;
  // Released and pressed again in the air: the step takes the press, and nothing happens.
  p = walk_input(p, 0, 0, 0, 0, false, false, 0, 0);
  p = walk_input(p, 0, 0, 0, 0, false, true, 0, 0);
  #assert p.body.vel.y == vy && p.body.jumps.waiting == 1;
  p = step(w, p, STEP);
  #assert p.body.jumps.waiting == 0 && p.body.vel.y < vy;
  while !p.body.on_ground { p = step(w, p, STEP); }
  // Still held after landing: no jump until it is pressed again.
  p = walk_input(p, 0, 0, 0, 0, false, true, 0, 0);
  p = step(w, p, STEP);
  #assert p.body.on_ground && p.body.jumps.waiting == 0;
  p = walk_input(p, 0, 0, 0, 0, false, false, 0, 0);
  p = walk_input(p, 0, 0, 0, 0, false, true, 0, 0);
  #assert p.body.on_ground;
  p = step(w, p, STEP);
  #assert !p.body.on_ground && p.body.vel.y > f32(JUMP) - 1;
}

// book:begin presses
// The input contract (metaverse-engine/core/input.coax, #12609): a press is taken by exactly one step. At
// 144 FPS most frames run no step: a press in one of them jumps on the next step, not never.
// A frame that runs two steps jumps once, not twice.
#test "a press in a frame with no step jumps on the next one, and a frame of two jumps once" {
  w: World;
  p := walk_place(0, 0, 0, 0);
  p = walk_input(p, 0, 0, 0, 0, false, true, 0, 0);
  p = advance_in(w, p, 0.001);                    // runs no step
  #assert p.body.clock.ticks == 0 && p.body.on_ground && p.body.jumps.waiting == 1;
  p = walk_input(p, 0, 0, 0, 0, false, false, 0, 0);   // let go before the step
  p = advance_in(w, p, 0.015);
  #assert p.body.clock.ticks == 1 && !p.body.on_ground && p.body.jumps.taken == 1;
  q := walk_place(0, 0, 0, 0);
  q = walk_input(q, 0, 0, 0, 0, false, true, 0, 0);
  q = advance_in(w, q, 0.032);                    // two steps
  #assert q.body.clock.ticks == 2 && q.body.jumps.taken == 1 && q.body.jumps.waiting == 0;
  one := step_once(w, step_once(w, walk_input(walk_place(0, 0, 0, 0), 0, 0, 0, 0, false, true, 0, 0), STEP), STEP);
  #assert same_step(q, one) && !same_step(q, step_once(w, q, STEP)) && !same_step(q, walk_place(0, 0, 0, 0));
  // The step that jumps already counts as in the air: on ice, it pushes you with full grip.
  ice := walk_place(0, 0, 0, 0); ice.body.grip = 0.5;
  dry := walk_place(0, 0, 0, 0);
  a := step(w, walk_input(ice, 0, 1, 0, 0, true, true, 0, 0), STEP);
  b := step(w, walk_input(dry, 0, 1, 0, 0, true, true, 0, 0), STEP);
  #assert !a.body.on_ground && same_step(a, b);
}

// The same action stream drives desktop and phone: a session on the keyboard and the same
// session on the touch stick (forward, running, a jump, a turn to the left) become the same
// Intent each frame, and the player passes through the same states.
#test "the keyboard and the touch stick drive the same session to the same states" {
  w: World;
  k := walk_place(0, 0, 0, 0);
  t := walk_place(0, 0, 0, 0);
  for f: 0..<120 {
    jump := f == 10 || f == 70;
    x := ifx f >= 40 && f < 60 then -1.0f32 else 0.0f32;
    keys := input_keys(x, 1, false, jump, false, 0, 0, 0);
    touch := input_stick(x, 1, true, jump, false, 0, 0, 0);
    k = advance_in(w, walk_intent(k, keys), 1.0 / 60.0);
    t = advance_in(w, walk_intent(t, touch), 1.0 / 60.0);
    #assert same_step(k, t) && k.body.pos.x == t.body.pos.x;
  }
  #assert k.body.jumps.taken == 2 && abs(k.body.pos.z) > 5 && abs(k.body.pos.x) > 0.5;   // it ran, turned and jumped twice
}
// book:end presses

#test "placed in the air, you fall to the floor" {
  w: World;
  p := walk_place(0, 3, 0, 0);
  #assert !p.body.on_ground;
  p = step(w, p, STEP);
  #assert p.body.vel.y == -f32(GRAVITY * STEP) && p.body.act == Act.airborne;
  for i: 0..<64 { p = step(w, p, STEP); }
  #assert p.body.on_ground && p.body.pos.y == 0;
}

#test "standing eases onto a floor within RIDE_HEIGHT" {
  w: World;
  w.ground = 0.04;
  p := walk_place(0, 0, 0, 0);
  p.body.vel.y = -3;
  q := step(w, p, STEP);
  #assert q.body.on_ground && q.body.vel.y == 0;
  #assert near(q.body.pos.y, 0.04 * f32(STEP_SMOOTH * STEP), 0.000001);
  // Exactly RIDE_HEIGHT above still stands, and eases down.
  w.ground = 0;
  r := step(w, walk_place(0, 0.4, 0, 0), STEP);
  #assert r.body.on_ground && r.body.vel.y == 0 && near(r.body.pos.y, 0.4 * (1 - f32(STEP_SMOOTH * STEP)), 0.000001);
}

#test "walking off a ledge falls" {
  w: World;
  p := walk_place(0, 0, 0, 0);
  w.ground = -2;
  q := step(w, p, STEP);
  #assert !q.body.on_ground && q.body.vel.y == -f32(GRAVITY * STEP) && q.body.act == Act.airborne;
}

#test "a fall that reaches the floor exactly lands" {
  w: World;
  p := walk_place(0, 0.25, 0, 0);
  p.body.on_ground = false;
  p.body.vel.y = -1;
  q := step(w, p, 0.25);
  #assert q.body.on_ground && q.body.pos.y == 0 && q.body.vel.y == 0;
}

// One look, turned and tilted by iy and ip, then 20 frames walking. Split by the turn's sign into
// two checks (#13115): the 121 cases together came to 15,679,129 steps, 78% of the default 20,000,000.
// What the look and the walk did: the camera's angles before and after the look and the turn and
// tilt asked for, the frames run, those whose eye was a finite point and those whose eye stood
// inside the orbit, and how the body ended.
OrbitRun :: struct { from_theta: f32; from_phi: f32; dyaw: f32; dpitch: f32; theta: f32; phi: f32; frames: int; finite: int; framed: int; speed: f32; grounded: bool; }
camera_orbit_run :: (iy: int, ip: int, count: int) -> OrbitRun #effects(all) {
  r: OrbitRun;
  start := walk_place(0, 0, 0, 0);
  r.from_theta = start.cam.theta; r.from_phi = start.cam.phi;
  r.dyaw = f32(iy) * 0.9; r.dpitch = f32(ip) * 0.9;
  p := walk_input(start, 0, 1, 0, 0, true, false, r.dyaw, r.dpitch);
  r.theta = p.cam.theta; r.phi = p.cam.phi;
  for i: 0..<count {
    p = walk_advance(p, 0.02);
    eye := walk_eye(p); at := walk_at(p);
    ex := eye.x - at.x; ey := eye.y - at.y; ez := eye.z - at.z;
    d := sqrt(ex * ex + ey * ey + ez * ez);
    r.frames += 1;
    if point_finite(eye) { r.finite += 1; }
    if orbit_dist_holds(d, p.cam.max_dist) { r.framed += 1; }
  }
  r.speed = flat_speed(p); r.grounded = p.body.on_ground;
  return r;
}
point_finite :: (v: Vec3) -> bool #effects(all) { return finite(v.x) && finite(v.y) && finite(v.z); }
orbit_look_holds :: (phi: f32, theta: f32) -> bool #effects(all) { return phi >= f32(PHI_MIN) && phi <= f32(PHI_MAX) && theta >= -f32(PI) && theta < f32(PI); }
orbit_dist_holds :: (d: f32, most: f32) -> bool #effects(all) { return d >= f32(CAM_WALL_MIN) - 0.001 && d <= most + 0.001; }
// The look turned the camera by the turn asked for and tilted it by the tilt asked for, as far as
// the camera's limits allow; every frame's eye was a finite point in the orbit; and the body ended
// running on the ground (a jump would still be in the air).
// turn and tilt are the look this case set out to make: the run must have asked for exactly it.
orbit_run_holds :: (r: OrbitRun, count: int, turn: f32, tilt: f32) -> bool #effects(all) {
  if r.dyaw != turn || r.dpitch != tilt { return false; }
  if r.frames != count || r.finite != count || r.framed != count { return false; }
  if !orbit_look_holds(r.phi, r.theta) { return false; }
  if !near(wrap_angle(r.theta - r.from_theta - r.dyaw), 0, 0.0001) { return false; }
  if !near(r.phi, clamp(r.from_phi + r.dpitch, f32(PHI_MIN), f32(PHI_MAX)), 0.0001) { return false; }
  return near(r.speed, f32(RUN), 0.001) && r.grounded;
}
#test "the orbit judges refuse each fault alone" {
  zero: f32 = 0; nan := zero / zero;
  #assert point_finite(Vec3.{x = 1, y = -2, z = 3});
  #assert !point_finite(Vec3.{x = nan, y = 1, z = 1}) && !point_finite(Vec3.{x = 1, y = nan, z = 1}) && !point_finite(Vec3.{x = 1, y = 1, z = nan});
  mid := (f32(PHI_MIN) + f32(PHI_MAX)) / 2;
  #assert orbit_look_holds(mid, 0) && orbit_look_holds(f32(PHI_MIN), 0) && orbit_look_holds(f32(PHI_MAX), 0) && orbit_look_holds(mid, -f32(PI));
  #assert !orbit_look_holds(f32(PHI_MIN) - 0.001, 0) && !orbit_look_holds(f32(PHI_MAX) + 0.001, 0);
  #assert !orbit_look_holds(mid, f32(PI)) && !orbit_look_holds(mid, -f32(PI) - 0.001);
  most: f32 = 4;
  #assert orbit_dist_holds(f32(CAM_WALL_MIN) - 0.001, most) && orbit_dist_holds(most + 0.001, most);
  #assert !orbit_dist_holds(f32(CAM_WALL_MIN) - 0.002, most) && !orbit_dist_holds(most + 0.002, most);
  good := OrbitRun.{from_theta = 0.3, from_phi = mid - 0.25, dyaw = 0.5, dpitch = 0.25, theta = 0.8, phi = mid, frames = 20, finite = 20, framed = 20, speed = f32(RUN), grounded = true};
  #assert orbit_run_holds(good, 20, 0.5, 0.25);
  // A run that asked for another look than the case's is not the case's run.
  #assert !orbit_run_holds(good, 20, 0.6, 0.25) && !orbit_run_holds(good, 20, 0.5, 0.3);
  // A tilt past a limit stops at the limit, and a turn is judged round the circle.
  stopped := good; stopped.dpitch = 9; stopped.phi = f32(PHI_MAX); #assert orbit_run_holds(stopped, 20, 0.5, stopped.dpitch);
  stopped.dpitch = -9; #assert !orbit_run_holds(stopped, 20, 0.5, stopped.dpitch); stopped.phi = f32(PHI_MIN); #assert orbit_run_holds(stopped, 20, 0.5, stopped.dpitch);
  round := good; round.from_theta = 3; round.dyaw = 1; round.theta = 4 - f32(TAU); #assert orbit_run_holds(round, 20, 1, 0.25);
  bad := good; bad.frames = 19; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.frames = 21; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.finite = 19; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.framed = 19; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  // Outside the limits though it is the angle asked for: the limits are their own promise.
  bad = good; bad.from_phi = f32(PHI_MAX); bad.dpitch = 0.01; bad.phi = f32(PHI_MAX) + 0.01; #assert !orbit_run_holds(bad, 20, 0.5, 0.01);
  bad = good; bad.from_theta = f32(PI) - 0.5; bad.theta = f32(PI); #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.theta = 0.801; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.from_theta = 0.301; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.dyaw = 0.501; #assert !orbit_run_holds(bad, 20, 0.501, 0.25);
  bad = good; bad.phi = mid - 0.001; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.from_phi = mid - 0.251; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.dpitch = 0.251; #assert !orbit_run_holds(bad, 20, 0.5, 0.251);
  bad = good; bad.speed = f32(WALK); #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
  bad = good; bad.grounded = false; #assert !orbit_run_holds(bad, 20, 0.5, 0.25);
}
camera_orbit_holds :: (iy: int, ip: int) -> bool #effects(all) { return orbit_run_holds(camera_orbit_run(iy, ip, 20), 20, f32(iy) * 0.9, f32(ip) * 0.9); }
#forall "the camera stays in its orbit (1 of 2)" iy: -5..<0, ip: -5..<6 { #assert camera_orbit_holds(iy, ip); }
#forall "the camera stays in its orbit (2 of 2)" iy: 0..<6, ip: -5..<6 { #assert camera_orbit_holds(iy, ip); }

#test "looking turns the camera by the deltas" {
  p := walk_place(0, 0, 0, 0);
  q := walk_input(p, 0, 0, 0, 0, false, false, 0.3, 0.2);
  #assert near(q.cam.theta, wrap_angle(f32(PI) + 0.3), 0.000001);
  #assert near(q.cam.phi, f32(BEHIND_PHI) + 0.2, 0.000001);
}

#test "the eye sits dist along the orbit from the target" {
  p := walk_place(2, 0, 1, 1);
  at := walk_at(p);
  eye := walk_eye(p);
  o := orbit_offset(p);
  #assert near(eye.x - at.x, o.x * p.cam.dist, 0.00001);
  #assert near(eye.y - at.y, o.y * p.cam.dist, 0.00001);
  #assert near(eye.z - at.z, o.z * p.cam.dist, 0.00001);
  // Behind you and above.
  #assert (eye.x - at.x) * sin(1.0f32) + (eye.z - at.z) * cos(1.0f32) < -1 && eye.y > at.y + 1;
}

#test "the camera pulls in at once and backs out gently" {
  w: World;
  w.room = 2;
  p := walk_place(0, 0, 0, 0);
  q := step_once(w, p, STEP);
  #assert q.cam.dist == 2;
  // A wall closer than CAM_WALL_MIN still leaves that much.
  w.room = 0.1;
  #assert step_once(w, p, STEP).cam.dist == f32(CAM_WALL_MIN);
  // Room again: out by CAM_LERP of the gap per 1/60 s.
  w.room = 1000;
  r := step_once(w, q, STEP);
  gap := f32(CAM_MAX) - 2;
  #assert near(r.cam.dist, 2 + gap * (1 - pow(f32(1 - CAM_LERP), f32(STEP * 60))), 0.00001);
  #assert r.cam.dist > 2 && r.cam.dist < f32(CAM_MAX);
  // Exactly the room it has: it stays.
  w.room = 2;
  #assert step_once(w, q, STEP).cam.dist == 2;
}

// book:begin readonly
// The camera only reads the player (metaverse-engine/cam/follow.coax, book chapter 10). Through a walk and a
// run into a wall and round it, past a body, two jumps and a steady turn, at 60 FPS, the player is the same,
// bit for bit, whether its camera steps after every step, never, or twice a step. Only the
// camera's own fields differ, and the camera did meet the wall.
walker_same :: (a: Player, b: Player) -> bool #effects(all) {
  return a.body.pos.x == b.body.pos.x && a.body.pos.y == b.body.pos.y && a.body.pos.z == b.body.pos.z && a.body.vel.x == b.body.vel.x && a.body.vel.y == b.body.vel.y
    && a.body.vel.z == b.body.vel.z && a.body.face == b.body.face && a.body.on_ground == b.body.on_ground && a.body.act == b.body.act && a.cam.theta == b.cam.theta
    && a.cam.phi == b.cam.phi && a.cam.max_dist == b.cam.max_dist && a.body.prev_pos.x == b.body.prev_pos.x && a.body.prev_pos.y == b.body.prev_pos.y
    && a.body.prev_pos.z == b.body.prev_pos.z && a.body.prev_face == b.body.prev_face && a.body.sliding == b.body.sliding
    && a.body.jumps.waiting == b.body.jumps.waiting && a.body.jumps.taken == b.body.jumps.taken && a.body.clock.ticks == b.body.clock.ticks
    && a.body.clock.carry_ns == b.body.clock.carry_ns;
}
// A frame as advance_in runs it, with the camera stepped `cams` times after each player step.
frame_with :: (w: World, p: Player, frame: f32, cams: int) -> Player #effects(all) {
  next := p;
  next.body.clock = loop_accept(p.body.clock, cast(f64) frame);
  for i: 0..<loop_due(next.body.clock) {
    next.body.prev_pos = next.body.pos; next.cam.prev_target = next.cam.target; next.body.prev_face = next.body.face; next.cam.prev_dist = next.cam.dist;
    next = step(w, next, STEP);
    for c: 0..<cams { next = camera_step(w, next, STEP); }
  }
  next.body.clock = loop_ran(next.body.clock);
  return next;
}
#test "the player is the same whether its camera steps every step, never, or twice a step" {
  walls := [6] f32.[-3, 0, 4, 3, 2.5, 4.5];                    // a wall across your path, 4 m ahead
  bodies := [7] f32.[1.2, 0, 1.5, 1.2, 1.8, 1.5, 0.35];         // a robot beside it
  w: World; w.walls = walls[..]; w.bodies = bodies[..];
  start := walk_place(0, 0, 0, 0);
  runs: [3] Player;
  for c: 0..<3 { runs[c] = start; }
  frame := 1.0f32 / 60.0;
  pulled := false; stopped := false; parted := 0;
  for f: 0..<240 {
    for c: 0..<3 {
      runs[c] = walk_input(runs[c], ifx f > 120 then 1.0f32 else 0, 1, 0, 0, f > 40, f == 30 || f == 150, 0.01, 0);
      runs[c] = frame_with(w, runs[c], frame, c);
    }
    #assert walker_same(runs[0], runs[1]) && walker_same(runs[2], runs[1]);
    if runs[1].cam.dist < f32(CAM_MAX) - 0.5 { pulled = true; }
    if runs[1].body.pos.z == 3.7 { stopped = true; }               // the wall's face, less your radius
    if runs[0].cam.target.z != runs[1].cam.target.z && runs[2].cam.target.z != runs[1].cam.target.z { parted += 1; }
  }
  // It walked into the wall, round it and jumped twice, and the three cameras really differed.
  #assert stopped && runs[1].body.pos.z > 10 && runs[1].body.clock.ticks == 256 && runs[1].body.jumps.taken == 2;
  #assert pulled && parted > 200;
  // The same run with steps_in's own camera gives the same player too.
  q := start;
  for f: 0..<240 {
    q = advance_in(w, walk_input(q, ifx f > 120 then 1.0f32 else 0, 1, 0, 0, f > 40, f == 30 || f == 150, 0.01, 0), frame);
  }
  #assert walker_same(q, runs[1]) && q.cam.target.z == runs[1].cam.target.z && q.cam.dist == runs[1].cam.dist;
  #assert q.cam.prev_target.z == runs[1].cam.prev_target.z && q.cam.prev_dist == runs[1].cam.prev_dist;
}
#forall "walker_same compares every field it names" k: 0..<21 {
  a := walk_input(walk_advance(walk_place(1, 0.5, 2, 0.3), 0.04), 0, 1, 0, 0, false, true, 0, 0);
  #assert walker_same(a, a);
  b := a;
  if k == 0 { b.body.pos.x += 1; } else if k == 1 { b.body.pos.y += 1; } else if k == 2 { b.body.pos.z += 1; } else if k == 3 { b.body.vel.x += 1; }
  else if k == 4 { b.body.vel.y += 1; } else if k == 5 { b.body.vel.z += 1; } else if k == 6 { b.body.face += 1; } else if k == 7 { b.body.on_ground = !b.body.on_ground; }
  else if k == 8 { b.body.act = Act.running; } else if k == 9 { b.cam.theta += 1; } else if k == 10 { b.cam.phi += 1; } else if k == 11 { b.cam.max_dist += 1; }
  else if k == 12 { b.body.prev_pos.x += 1; } else if k == 13 { b.body.prev_pos.y += 1; } else if k == 14 { b.body.prev_pos.z += 1; }
  else if k == 15 { b.body.prev_face += 1; } else if k == 16 { b.body.sliding = !b.body.sliding; } else if k == 17 { b.body.jumps.waiting += 1; }
  else if k == 18 { b.body.jumps.taken += 1; } else if k == 19 { b.body.clock.ticks += 1; } else { b.body.clock.carry_ns += 1; }
  #assert !walker_same(a, b) && !walker_same(b, a);
  c := a; c.cam.target.x += 1; c.cam.dist += 1; c.cam.spring_vel.y += 1; c.cam.prev_target.z += 1; c.cam.prev_dist += 1;
  #assert walker_same(a, c);    // the camera's fields are not the player's
}
// book:end readonly

#test "the camera's target follows you on the spring" {
  w: World;
  p := held(walk_place(0, 0, 0, 0), 0, 1, false);
  for i: 0..<64 { p = step_once(w, p, STEP); }
  // It trails while you walk, never runs ahead, and settles once you stop.
  #assert p.cam.target.z < p.body.pos.z && p.cam.target.z > p.body.pos.z - 1;
  p = held(p, 0, 0, false);
  for i: 0..<128 { p = step_once(w, p, STEP); }
  t := look_at(p);
  #assert near(p.cam.target.x, t.x, 0.001) && near(p.cam.target.y, t.y, 0.001) && near(p.cam.target.z, t.z, 0.001);
}

// The spring from rest, one step, against the exact critically damped
// follow: 1 - (1 + x) e^-x of the way, at speed omega x e^-x.
#forall "the spring is critically damped" k: 1..<8 {
  dt := f32(k) * 0.005;
  x := f32(2.0 / SPRING_TIME) * dt;
  a := spring_axis(0, 0, 1, dt);
  #assert near(a.x, 1 - (1 + x) * exp(-x), 0.002);
  #assert near(a.y, f32(2.0 / SPRING_TIME) * x * exp(-x), 0.05);
}

#test "the spring never overshoots" {
  // Coming from above or below fast enough to pass: it stops at the target.
  b := spring_axis(0.999, 50, 1, STEP);
  #assert b.x == 1 && b.y == 0;
  c := spring_axis(1.001, -50, 1, STEP);
  #assert c.x == 1 && c.y == 0;
  // Short of it from below a negative target: it keeps going.
  d := spring_axis(-2, 0, -1, STEP);
  #assert d.x > -2 && d.x < -1 && d.y > 0;
  // At the target but moving: it moves on.
  e := spring_axis(1, 5, 1, STEP);
  #assert e.x > 1 && e.y != 0;
}

#forall "bad numbers never get in" which: 0..<4 {
  bad := ifx which == 0 then 1.0f32 / 0.0f32 else ifx which == 1 then -1.0f32 / 0.0f32 else 0.0f32 / 0.0f32;
  if which == 3 { bad = 2000000.0; }
  p := walk_place(0, 0, 0, 0);
  q := walk_input(p, bad, bad, bad, 0.5, false, false, bad, bad);
  #assert q.body.key_x == 0 && q.body.key_y == 0 && q.body.pad_x == 0 && q.body.pad_y == 0;
  #assert q.cam.theta == p.cam.theta && q.cam.phi == p.cam.phi;
  q = walk_input(p, 0, 0, 0.5, bad, false, false, 0, 0);
  #assert q.body.pad_x == 0 && q.body.pad_y == 0;
  q = walk_advance(q, bad);
  // a non-number, infinite or absurdly long frame is no frame: refused, nothing stepped
  #assert q.body.clock.carry_ns == 0 && q.body.clock.ticks == 0 && q.body.clock.refused == 1;
  #assert finite(q.body.pos.x) && finite(q.body.pos.y) && finite(q.body.pos.z);
  q = walk_advance(q, 0.1);
  #assert finite(q.body.pos.x) && finite(q.body.pos.z) && q.body.clock.carry_ns >= 0 && q.body.clock.carry_ns < LOOP_STEP_NS;
}

#test "frames run whole steps and show the point between" {
  p := held(walk_place(0, 0, 0, 0), 0, 1, false);
  // A frame of exactly one step runs it.
  one := walk_advance(p, STEP);
  #assert one.body.clock.carry_ns == 0 && one.body.clock.ticks == 1 && one.body.pos.z > 0;
  // A negative frame counts as none.
  #assert walk_advance(p, -1).body.clock.carry_ns == 0 && walk_advance(p, -1).body.clock.ticks == 0;
  p = walk_advance(p, f32(STEP) * 1.5);
  #assert alpha(p) == 0.5;
  f := walk_feet(p);
  #assert f.z > p.body.prev_pos.z && f.z < p.body.pos.z;
  #assert near(f.z, (p.body.prev_pos.z + p.body.pos.z) / 2, 0.0001);
  // A long stall runs at most LOOP_MAX_STEPS and keeps no backlog of whole steps.
  w: World;
  s := p;
  for i: 0..<LOOP_MAX_STEPS { s = step(w, s, STEP); }
  q := walk_advance(p, 10);
  #assert q.body.clock.carry_ns < LOOP_STEP_NS && q.body.pos.z == s.body.pos.z && q.body.clock.dropped_ns > 0;
  r := walk_place(0, 0, 0, 0);
  #assert walk_advance(r, f32(STEP) * (LOOP_MAX_STEPS + 1)).body.clock.carry_ns == 0;
}

#test "each step remembers where it began" {
  w: World;
  w.room = 3;
  p := held(walk_place(0, 0, 0, 0), 1, 1, false);
  p = advance_in(w, p, STEP);
  q := advance_in(w, p, STEP);
  #assert q.body.prev_pos.x == p.body.pos.x && q.body.prev_pos.z == p.body.pos.z;
  #assert q.cam.prev_target.z == p.cam.target.z && q.body.prev_face == p.body.face && q.cam.prev_dist == p.cam.dist;
  #assert q.body.prev_face != q.body.face && q.body.prev_pos.z != q.body.pos.z;
}

#test "the facing shown turns the short way" {
  p := walk_place(0, 0, 0, 3.1);
  p.body.prev_face = 3.1;
  p.body.face = -3.1;
  p.body.clock.carry_ns = LOOP_STEP_NS / 2;
  #assert abs(walk_face(p)) > 3.1;
}

// A page face moves its realm by what the player's clock counts a frame for, and the player by
// the frame itself: the two agree on every frame, a stall's included, and no frame runs more
// steps than a realm's declared budget (8, metaverse-engine/core/budget.coax).
#test "a face's frame time is what the player's clock counts, and runs at most 8 steps" {
  w: World;
  p := walk_input(walk_place(0, 0, 0, 0), 0, 1, 0, 0, true, false, 0, 0);
  frames := [9] f32.[1.0 / 144.0, 1.0 / 60.0, 1.0 / 30.0, 0.1, 0.2, 3.0, -1.0, 0.0 / 0.0, 1.0 / 60.0];
  most := 0;
  for i: 0..<9 {
    counts := walk_counts(p, frames[i]);
    before := p.body.clock.ticks;
    p = walk_advance(p, frames[i]);
    #assert counts == cast(f32) loop_counted(p.body.clock);
    #assert walk_ran(p) == p.body.clock.ticks - before && walk_ran(p) <= 8;
    if walk_ran(p) > most { most = walk_ran(p); }
  }
  #assert most == 8 && walk_counts(p, 3.0) <= 0.140625 && walk_counts(p, 1.0 / 60.0) == cast(f32) loop_counts(p.body.clock, cast(f64) (1.0f32 / 60.0f32));
  #assert walk_counts(p, -1.0) == 0 && walk_counts(p, 0.0 / 0.0) == 0;
}

// The engine core's loop contract (metaverse-engine/core/loop.coax, #12609): the steps are fixed whatever
// the frame rate, so a run and jump fed at 30, 60, 120 or 144 frames a second passes
// through the same states, bit for bit, at every step. Only how many steps each frame
// runs, and the point drawn between the last two, differ.
same_step :: (a: Player, b: Player) -> bool #effects(all) {
  return a.body.pos.x == b.body.pos.x && a.body.pos.y == b.body.pos.y && a.body.pos.z == b.body.pos.z && a.body.vel.x == b.body.vel.x && a.body.vel.y == b.body.vel.y
    && a.body.vel.z == b.body.vel.z && a.body.face == b.body.face && a.body.on_ground == b.body.on_ground && a.cam.target.y == b.cam.target.y && a.cam.dist == b.cam.dist;
}
// book:begin stutter
// No stutter at 60 FPS: the 64 Hz steps do not land one to a frame (some frames run two),
// yet what is drawn moves smoothly. Through a jump's flight the feet drawn each frame change
// speed by no more than gravity does in a frame plus the interpolation's error (measured
// 0.008 m), and the camera by no more than its spring's own pull adds (0.014 m); drawing the
// last step instead lurches by 0.077 m (feet) and 0.062 m (camera) every few frames.
#test "a jump drawn at 60 FPS has no stutter" {
  w: World;
  p := walk_input(walk_place(0, 0, 0, 0), 0, 1, 0, 0, true, true, 0, 0);
  frame := cast(f32) (1.0 / 60.0);
  bound := f32(GRAVITY) * frame * frame + 0.004;   // 0.0107 m
  eye_bound := 0.016f32;
  was_y := 0.0f32; was_dy := 0.0f32; was_eye := 0.0f32; was_deye := 0.0f32;
  flying := 0;
  for k: 0..<90 {
    p = advance_in(w, p, frame);
    y := walk_feet(p).y;
    eye := walk_eye(p).y;
    dy := y - was_y; deye := eye - was_eye;
    if k >= 2 && !p.body.on_ground && p.body.prev_pos.y > 0 && p.body.clock.ticks > 2 {
      #assert abs(dy - was_dy) <= bound;
      #assert abs(deye - was_deye) <= eye_bound;
      flying += 1;
    }
    was_y = y; was_dy = dy; was_eye = eye; was_deye = deye;
  }
  #assert flying > 30;   // most of a 0.6 s flight was checked
  // Drawing the last step instead (no interpolation) would fail the same bound.
  q := walk_input(walk_place(0, 0, 0, 0), 0, 1, 0, 0, true, true, 0, 0);
  worst := 0.0f32; worst_eye := 0.0f32; was_y = 0; was_dy = 0; was_eye = 0; was_deye = 0;
  for k: 0..<40 {
    q = advance_in(w, q, frame);
    dy := q.body.pos.y - was_y;
    eye := q.cam.target.y + orbit_offset(q).y * q.cam.dist;
    deye := eye - was_eye;
    if k >= 2 && !q.body.on_ground { worst = hi(worst, abs(dy - was_dy)); worst_eye = hi(worst_eye, abs(deye - was_deye)); }
    was_y = q.body.pos.y; was_dy = dy; was_eye = eye; was_deye = deye;
  }
  #assert worst > 3 * bound && worst_eye > 3 * eye_bound;
}
// book:end stutter

#forall "same_step compares every field it names" k: 0..<10 {
  a := walk_input(walk_place(1, 0.5, 2, 0.3), 0, 1, 0, 0, false, true, 0, 0);
  #assert same_step(a, a) && a.body.jump_held && a.body.jumps.held;
  b := a;
  if k == 0 { b.body.pos.x += 1; } else if k == 1 { b.body.pos.y += 1; } else if k == 2 { b.body.pos.z += 1; } else if k == 3 { b.body.vel.x += 1; }
  else if k == 4 { b.body.vel.y += 1; } else if k == 5 { b.body.vel.z += 1; } else if k == 6 { b.body.face += 1; } else if k == 7 { b.body.on_ground = !b.body.on_ground; }
  else if k == 8 { b.cam.target.y += 1; } else { b.cam.dist += 1; }
  #assert !same_step(a, b);
  #assert !walk_input(a, 0, 1, 0, 0, false, false, 0, 0).body.jump_held;
}

#forall "a run and jump has the same states at 30, 60, 120 and 144 FPS" r: 0..<4 {
  fps := ifx r == 0 then 30 else ifx r == 1 then 60 else ifx r == 2 then 120 else 144;
  w: World;
  // The reference: one step at a time, the input held as it is through the run.
  ref: [160] Player;
  q := walk_input(walk_place(0, 0, 0, 0), 0.6, 1, 0, 0, true, true, 0, 0);
  for i: 0..<160 { q = step_once(w, q, STEP); ref[i] = q; }
  #assert ref[20].body.pos.y > 0.5 && ref[159].body.on_ground;   // it jumped, and landed
  p := walk_input(walk_place(0, 0, 0, 0), 0.6, 1, 0, 0, true, true, 0, 0);
  last := 0;
  while p.body.clock.ticks < 160 {
    p = advance_in(w, p, cast(f32) (1.0 / cast(f64) fps));
    if p.body.clock.ticks > 160 { break; }
    if p.body.clock.ticks > 0 { #assert same_step(p, ref[p.body.clock.ticks - 1]); }
    // what is drawn lies between the last two steps
    if p.body.clock.ticks > 1 {
      f := walk_feet(p);
      #assert f.y >= lo(p.body.prev_pos.y, p.body.pos.y) && f.y <= hi(p.body.prev_pos.y, p.body.pos.y);
    }
    #assert p.body.clock.ticks - last <= 2 * (64 / fps + 1);
    last = p.body.clock.ticks;
  }
}

#test "the act names what you are doing" {
  w: World;
  p := walk_place(0, 0, 0, 0);
  #assert p.body.act == Act.idle && walk_act(p) == 0;
  #assert walk_act(step(w, held(p, 0, 1, false), STEP)) == 1;
  #assert walk_act(step(w, held(p, 0, 1, true), STEP)) == 2;
}

#test "the stand-in world" {
  w: World;
  w.ground = 1.5;
  #assert floor_at(w, 5, -7, 2) == 1.5;
  p := walk_place(0, 0, 0, 0);
  p.body.vel = Vec3.{x = 1, y = 0, z = 2};
  q := move_across(w, p, 1.5, -2);
  #assert q.body.pos.x == 1.5 && q.body.pos.z == -2 && q.body.vel.x == 1 && q.body.vel.z == 2;
  w.room = 2;
  #assert camera_room(w, p.body.pos, orbit_offset(p), 3) == 2 && camera_room(w, p.body.pos, orbit_offset(p), 1) == 1;
}

#test "the helpers" {
  #assert clamp(5, -1, 1) == 1 && clamp(-5, -1, 1) == -1 && clamp(0.5, -1, 1) == 0.5;
  #assert mix(2, 4, 0.25) == 2.5;
  m := mix3(Vec3.{x = 0, y = 0, z = 0}, Vec3.{x = 2, y = 4, z = 8}, 0.5);
  #assert m.x == 1 && m.y == 2 && m.z == 4;
  #assert finite(999999) && !finite(1000000) && !finite(-1000000);
  #assert near(1, 1.5, 0.5) && !near(1, 1.6, 0.5);
}

// ---- Bodies ----

// A body standing 2 m ahead (+Z): a post 0.2 m wide from the floor to 3 m.
POST :: 7;
post :: (out: [] f32, x: f32, z: f32, r: f32) #effects(all) {
  out[0] = x; out[1] = 0; out[2] = z; out[3] = x; out[4] = 3; out[5] = z; out[6] = r;
}

#forall "closest points are no further apart than any other pair" i: 0..<6, j: 0..<6 {
  p0 := v3(0, 0, 0); p1 := v3(1, f32(i) * 0.4 - 1, 0.5);
  q0 := v3(f32(j) * 0.3 - 0.5, 1, -0.2); q1 := v3(0.4, f32(j) * -0.2, f32(i) * 0.1 + 0.7);
  if i == 5 { p1 = p0; }          // a point
  if j == 5 { q1 = q0; }
  c := closest(p0, p1, q0, q1);
  #assert c.s >= 0 && c.s <= 1 && c.t >= 0 && c.t <= 1;
  g := sub(c.p, c.q); best := dot(g, g);
  for a: 0..<21 {
    for b: 0..<21 {
      u := add(p0, times(sub(p1, p0), f32(a) / 20));
      v := add(q0, times(sub(q1, q0), f32(b) / 20));
      h := sub(u, v);
      #assert best <= dot(h, h) + 0.00001;
    }
  }
}

#test "parallel segments meet where they overlap" {
  c := closest(v3(0, 0, 0), v3(0, 2, 0), v3(1, 1, 0), v3(1, 3, 0));
  #assert near(c.p.x, 0, 0.00001) && near(c.q.x, 1, 0.00001) && near(c.p.y, c.q.y, 0.00001) && c.p.y >= 1 && c.p.y <= 2;
  d := closest(v3(0, 0, 0), v3(0, 0, 0), v3(1, 1, 0), v3(1, 1, 0));
  #assert d.s == 0 && d.t == 0 && d.q.x == 1;
}

#test "you walk up to a body and stop at its edge" {
  bodies: [POST] f32;
  post(bodies[..], 0, 2, 0.2);
  w: World;
  w.bodies = bodies[..];
  p := held(walk_place(0, 0, 0, 0), 0, 1, false);
  for i: 0..<48 { p = step(w, p, STEP); }
  #assert near(p.body.pos.z, 2 - 0.2 - f32(RADIUS), 0.0001) && near(p.body.pos.x, 0, 0.0001);
  // What went into it stopped; you still face it, pressing. (Held long
  // enough, the smallest drift slides you round it, as round bodies do.)
  #assert near(p.body.vel.z, 0, 0.0001) && p.body.act == Act.walking;
  // Sideways along it still goes.
  p = held(p, 1, 0, false);
  for i: 0..<64 { p = step(w, p, STEP); }
  #assert p.body.pos.x < -0.5 && near(p.body.pos.z, 1.5, 0.01);
}

#test "a body moving into you pushes you" {
  bodies: [POST] f32;
  w: World;
  w.bodies = bodies[..];
  p := walk_place(0, 0, 0, 0);
  for i: 0..<20 {
    post(bodies[..], 0, 1 - f32(i) * 0.05, 0.4);
    p = step(w, p, STEP);
  }
  // The post's at z = 0.05 now: you are a radius and its width behind it.
  #assert near(p.body.pos.z, 0.05 - 0.4 - f32(RADIUS), 0.0001);
}

#test "a body passes over your head and under your feet" {
  bodies: [14] f32;
  // A bar across at 2.3 m and a ball at 0.2 m, 1 m ahead.
  bodies[0] = -2; bodies[1] = 2.3; bodies[2] = 1; bodies[3] = 2; bodies[4] = 2.3; bodies[5] = 1; bodies[6] = 0.2;
  bodies[7] = 0; bodies[8] = 0.2; bodies[9] = 1; bodies[10] = 0; bodies[11] = 0.2; bodies[12] = 1; bodies[13] = 0.2;
  w: World;
  w.bodies = bodies[0..<7];
  p := walk_place(0, 0, 1, 0);
  #assert move_across(w, p, 0, 0).body.pos.z == 1;   // under the bar
  w.bodies = bodies[..];
  q := move_across(w, p, 0, 0);                 // on the ball: back off it
  #assert near(q.body.pos.z, 1 - sqrt(0.5f32 * 0.5 - 0.1 * 0.1), 0.0001);   // clear of it at your shin, 0.1 m above its centre
  // Jumping clear over it (its own: the bar would hit your head).
  w.bodies = bodies[7..<14];
  p.body.pos.y = 0.45;
  #assert move_across(w, p, 0, 0).body.pos.z == 1;
  p.body.pos.y = 0.39;
  #assert move_across(w, p, 0, 0).body.pos.z < 1;
}

#test "standing on a body's axis, you go back the way you came" {
  bodies: [POST] f32;
  post(bodies[..], 1, 1, 0.2);
  w: World;
  w.bodies = bodies[..];
  p := walk_place(1, 0, 0.5, 0);
  q := move_across(w, p, 0, 0.5);
  #assert near(q.body.pos.x, 1, 0.0001) && near(q.body.pos.z, 0.5, 0.0001);
  q = move_across(w, walk_place(1, 0, 1, 0), 0, 0);
  #assert near(q.body.pos.z, 0.5, 0.0001);
}

#test "the camera stops short of a body behind you" {
  bodies: [POST] f32;
  post(bodies[..], 0, -2, 0.3);
  w: World;
  w.bodies = bodies[..];
  p := walk_place(0, 0, 0, 0);
  // Straight back, level: CAM_CLEAR and its width before it.
  room := camera_room(w, v3(0, 1, 0), v3(0, 0, -1), 4);
  #assert near(room, 2 - 0.3 - f32(CAM_CLEAR), 0.0001);
  // A slanted line crossing the upright post stops sooner along itself.
  slant := camera_room(w, v3(0, 1, 0), v3(0, 0.6, -0.8), 4);
  #assert slant < 2 / 0.8 && slant > 0;
  // Off to the side, or behind the camera, it is not in the way.
  #assert camera_room(w, v3(0, 1, 0), v3(1, 0, 0), 4) == 4;
  #assert camera_room(w, v3(0, 1, 0), v3(0, 0, 1), 4) == 4;
  // Too close for any room: none, and the step keeps CAM_WALL_MIN.
  #assert camera_room(w, v3(0, 1, -1.6), v3(0, 0, -1), 4) == 0;
  q := step_once(w, p, STEP);
  #assert q.cam.dist < f32(CAM_MAX);
}

#test "bodies with bad numbers, and a partial one, are skipped" {
  bodies: [10] f32;
  post(bodies[..], 0, 0, 0.5);
  w: World;
  p := walk_place(0, 0, 0, 0);
  w.bodies = bodies[..];
  #assert move_across(w, p, 0, 0).body.pos.z != 0;
  bodies[6] = 0;
  #assert move_across(w, p, 0, 0).body.pos.z == 0;    // no width
  for k: 0..<7 {
    post(bodies[..], 0, 0, 0.5);
    bodies[k] = 2000000;
    #assert move_across(w, p, 0, 0).body.pos.z == 0 && camera_room(w, v3(0, 1, 2), v3(0, 0, -1), 4) == 4;
  }
  post(bodies[..], 0, 0, 0.5);
  w.bodies = bodies[0..<6];
  #assert move_across(w, p, 0, 0).body.pos.z == 0;
  // The exported call reads them.
  stand := walk_advance_among(walk_place(0, 0, 0.2, 0), STEP, bodies[0..<7], bodies[0..<0]);
  #assert near(stand.body.pos.z, 0.8, 0.0001);
}

// ---- Walls ----

// The terminal: a desk 2.8 x 1 x 1 m at (0, 0, 4) and a screen on it.
desk :: (out: [] f32) #effects(all) {
  out[0] = -1.4; out[1] = 0; out[2] = 3.5; out[3] = 1.4; out[4] = 1; out[5] = 4.5;
  out[6] = -1.2; out[7] = 1; out[8] = 3.9; out[9] = 1.2; out[10] = 2.4; out[11] = 4.1;
}

#test "you walk up to the desk and stop" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  p := held(walk_place(0, 0, 0, 0), 0, 1, false);
  for i: 0..<64 { p = step(w, p, STEP); }
  #assert near(p.body.pos.z, 3.5 - f32(RADIUS), 0.0001) && near(p.body.pos.x, 0, 0.0001) && p.body.vel.z == 0 && p.body.on_ground;
  // Along it you still walk; past its end you go on.
  p = held(p, 1, 1, false);
  for i: 0..<128 { p = step(w, p, STEP); }
  #assert p.body.pos.x < -1.4 && p.body.pos.z > 3.5;
}

#test "a desk's corner rounds you off it, and inside one you go out the nearest side" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  q := move_across(w, walk_place(1.5, 0, 3.4, 0), 0, 0);
  d := sqrt((q.body.pos.x - 1.4) * (q.body.pos.x - 1.4) + (q.body.pos.z - 3.5) * (q.body.pos.z - 3.5));
  #assert near(d, f32(RADIUS), 0.0001) && q.body.pos.x > 1.4 && q.body.pos.z < 3.5;
  r := move_across(w, walk_place(1.3, 0, 4, 0), 0, 0);
  #assert near(r.body.pos.x, 1.4 + f32(RADIUS), 0.0001) && r.body.pos.z == 4;
  s := move_across(w, walk_place(0, 0, 3.6, 0), 0, 0);
  #assert near(s.body.pos.z, 3.5 - f32(RADIUS), 0.0001);
}

#test "you jump onto the desk and stand on it; the screen is still a wall" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  // Standing at the desk's front, jump while walking into it.
  p := held(walk_place(0, 0, 3.2, 0), 0, 1, false);
  p.body.jump_held = false;
  p = walk_input(p, 0, 1, 0, 0, false, true, 0, 0);
  for i: 0..<96 { p = step(w, p, STEP); }
  #assert near(p.body.pos.y, 1, 0.01) && p.body.on_ground;
  // On it, the screen stops you.
  #assert p.body.pos.z <= 3.9 - f32(RADIUS) + 0.0001 && p.body.pos.z > 3.5;
  #assert floor_at(w, p.body.pos.x, p.body.pos.z, p.body.pos.y) == 1;
  // A floor too high to step onto is not a floor.
  #assert floor_at(w, 0, 3.4, 0) == 0 && floor_at(w, 0, 3.4, 0.45) == 1;
  // Off its far side you fall back to the ground.
  #assert floor_at(w, 0, 4.8, 1) == 0;
}

// One ground question for every realm (metaverse-engine/physics/query.coax, #12609 ec-query): the same course of
// a run, a jump onto a 0.5 m ledge, a walk across it and off its far side gives the same states
// whichever way a realm hands the walker its colliders: walls alone (the Grid, Fairy Forest,
// the garden, Hecate's Cemetery) or walls among far bodies and floors (Everglade, the realm
// host, Dead Gears). Built as a floor (a level quad) the ledge holds you the same way until you
// walk off it: a box's top holds you while your capsule is over it, a floor while your middle is
// within FLOOR_PAD of its edge, so you drop off the floor first.
// book:begin course
#test "jumping onto, landing on and walking off a ledge is the same in every realm" {
  ledge := [6] f32.[-2, 0, 1.5, 2, 0.5, 3.5];
  among := [12] f32.[-2, 0, 1.5, 2, 0.5, 3.5,   40, 0, 40, 41, 3, 41];
  bodies := [7] f32.[-40, 0, -40, -40, 1.5, -40, 0.4];
  floors: [2 * STAND_FLOATS] f32;
  stand_put_box(floors[..], 0, 30, 30, 34, 34, 1);
  as_floor: [STAND_FLOATS] f32;
  stand_put_box(as_floor[..], 0, -2, 1.5, 2, 3.5, 0.5);
  a: World; a.walls = ledge[..];
  b: World; b.walls = among[..]; b.bodies = bodies[..]; b.floors = floors[..];
  c: World; c.floors = as_floor[..];
  pa := held(walk_place(0, 0, 0, 0), 0, 1, false);
  pb := pa; pc := pa;
  landed := -1; off_a := -1; off_c := -1;
  for i: 0..<220 {
    jump := i == 12;
    pa = step(a, walk_input(pa, 0, 1, 0, 0, false, jump, 0, 0), STEP);
    pb = step(b, walk_input(pb, 0, 1, 0, 0, false, jump, 0, 0), STEP);
    pc = step(c, walk_input(pc, 0, 1, 0, 0, false, jump, 0, 0), STEP);
    #assert same_step(pa, pb) && pa.body.pos.y == pb.body.pos.y && pa.body.pos.z == pb.body.pos.z;
    if landed < 0 && i > 12 && pa.body.on_ground { landed = i; #assert pa.body.pos.y == 0.5 && pa.body.pos.z > 2; }
    if off_a < 0 && landed >= 0 && !pa.body.on_ground { off_a = i; }
    if off_c < 0 && landed >= 0 && !pc.body.on_ground { off_c = i; }
    if off_c < 0 { #assert same_step(pa, pc) && pa.body.pos.y == pc.body.pos.y; }
  }
  // it landed on the ledge, walked off it, and came down on the ground: the floor first
  #assert landed > 12 && off_a > landed && off_c > landed && off_c < off_a;
  #assert pa.body.on_ground && pc.body.on_ground && pa.body.pos.y == 0 && pc.body.pos.y == 0 && pa.body.pos.z > 6;
  // a realm whose ground is not at 0 stands you on it, and on the ledge's top over it
  higher: World; higher.ground = 0.25; higher.walls = ledge[..];
  #assert floor_at(higher, 0, 0, 0.25) == 0.25 && floor_at(higher, 0, 2, 0.25) == 0.5 && floor_at(higher, 0, 2, -1) == 0.25;
}
// book:end course

#test "the camera stops short of the desk" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  // From in front, looking back through it.
  room := camera_room(w, v3(0, 0.5, 2), v3(0, 0, 1), 4);
  #assert near(room, 1.5 - f32(CAM_CLEAR), 0.0001);
  // Above it, clear.
  #assert camera_room(w, v3(0, 3, 2), v3(0, 0, 1), 4) == 4;
  // Pointing away, clear; from inside, none.
  #assert camera_room(w, v3(0, 0.5, 2), v3(0, 0, -1), 4) == 4;
  #assert camera_room(w, v3(0, 0.5, 4), v3(0, 0, 1), 4) == 0;
  // Hugging it, within CAM_CLEAR: backing away is clear, into it none.
  #assert camera_room(w, v3(0, 0.5, 3.5 - f32(CAM_CLEAR) / 2), v3(0, 0, -1), 4) == 4;
  #assert camera_room(w, v3(0, 0.5, 3.5 - f32(CAM_CLEAR) / 2), v3(0, 0, 1), 4) == 0;
}

#test "walls with bad numbers, inside out or partial are skipped" {
  walls: [12] f32;
  w: World;
  p := walk_place(0, 0, 4, 0);
  for k: 0..<6 {
    desk(walls[..]);
    walls[k] = 2000000;
    w.walls = walls[0..<6];
    #assert move_across(w, p, 0, 0).body.pos.z == 4 && floor_at(w, 0, 4, 0.9) == 0;
  }
  desk(walls[..]);
  walls[0] = 2;                        // min x past max x
  w.walls = walls[0..<6];
  #assert move_across(w, p, 0, 0).body.pos.z == 4;
  desk(walls[..]);
  w.walls = walls[0..<5];
  #assert move_across(w, p, 0, 0).body.pos.z == 4;
  w.walls = walls[..];
  #assert move_across(w, p, 0, 0).body.pos.z != 4;
  #assert walk_advance_among(walk_place(0, 0, 3.4, 0), STEP, walls[0..<0], walls[..]).body.pos.z < 3.21;
}

// Camera modes are shared engine behaviour, so worlds do not reimplement
// orientation in their native adapters. Mode 0 first, 1 third, 2 top down.
#test "first-person eye is in your head and looks along the orbit heading" {
 p:=walk_place(7,0,2,0);p.cam.phi=f32(PI/2);
 e:=walk_view_eye(p,0);a:=walk_view_at(p,0);
 #assert near(e.x,7,0.001) && near(e.y,1.6,0.001) && near(e.z,2,0.001);
 #assert a.z>e.z && near(a.x,e.x,0.001);
}
#test "each view mode is its own shot of the frame drawn" {
  p := walk_advance(walk_input(walk_place(7, 0.5, 2, 0), 0, 1, 0, 0, false, false, 0, 0), 0.04);
  feet := walk_feet(p);
  top := walk_view_eye(p, 2); down := walk_view_at(p, 2);
  #assert top.x == feet.x && top.y == feet.y + 22 && top.z == feet.z - 0.01 && down.x == feet.x && down.y == feet.y && down.z == feet.z;
  e := walk_view_eye(p, 1); a := walk_view_at(p, 1);
  f := walk_eye(p); g := walk_at(p);
  #assert e.x == f.x && e.y == f.y && e.z == f.z && a.x == g.x && a.y == g.y && a.z == g.z && e.y > feet.y + 2;
  #assert walk_view_eye(p, 3).y == f.y;    // any other mode is the follow
}
// book:begin views
// The camera a mode shows, as one of the Metaverse Engine's shots (metaverse-engine/cam/follow.coax): first person, the
// follow behind you, or top down. Each reads only what is drawn this frame.
walk_view :: (p: Player, mode: int) -> CameraShot #effects(all) {
  if mode == 0 { return follow_first_shot(follow_of(p), wp(walk_feet(p))); }
  if mode == 2 { return shot_top(wp(walk_feet(p))); }
  return walk_shot(p);
}
walk_view_eye :: (p: Player, mode: int) -> Vec3 #effects(all) { return vp(walk_view(p, mode).eye); }
walk_view_at :: (p: Player, mode: int) -> Vec3 #effects(all) { return vp(walk_view(p, mode).at); }
// book:end views
walk_zoom :: (p:Player,delta:f32)->Player #effects(all) {next:=p;next.cam.max_dist=follow_zoom(follow_of(p),delta).max_dist;return next;}
// Zooming crosses between first and third person. Out from first person
// past ZOOM_OUT starts third person at its closest; in past the closest
// third-person distance by ZOOM_IN goes to first person. The push gathers
// across frames and clears when the zoom turns, so a jitter at the
// boundary does not flap. Top down only zooms.
ZOOM_OUT :: 0.3;
ZOOM_IN :: 0.6;
PlayerZoom :: struct { player: Player; mode: int; }
walk_zoom_view :: (p:Player,mode:int,delta:f32)->PlayerZoom #effects(all) {
 z:PlayerZoom;z.player=p;z.mode=mode;if !finite(delta) || delta==0 {return z;}
 if mode==2 {z.player=walk_zoom(p,delta);return z;}
 if mode==0 {
  if player_negative(delta) {z.player.cam.zoom_push=0;return z;}
  z.player.cam.zoom_push=p.cam.zoom_push+delta;
  if z.player.cam.zoom_push>=f32(ZOOM_OUT) {z.mode=1;z.player.cam.max_dist=1;z.player.cam.dist=1;z.player.cam.prev_dist=1;z.player.cam.phi=f32(BEHIND_PHI);z.player.cam.zoom_push=0;}
  return z;
 }
 if !player_negative(delta) {z.player=walk_zoom(p,delta);z.player.cam.zoom_push=0;return z;}
 z.player=walk_zoom(p,delta);
 if p.cam.max_dist+delta>=1 {z.player.cam.zoom_push=0;return z;}
 z.player.cam.zoom_push=p.cam.zoom_push+(1-(p.cam.max_dist+delta));
 if z.player.cam.zoom_push>=f32(ZOOM_IN) {z.mode=0;z.player.cam.phi=f32(PI/2);z.player.cam.zoom_push=0;}
 return z;
}
#test "zoom crosses first and third person without flapping" {
 p:=walk_place(7,0,2,0);
 z:=walk_zoom_view(p,0,0.1);#assert z.mode==0;
 z=walk_zoom_view(z.player,0,0.25);#assert z.mode==1 && z.player.cam.max_dist==1 && z.player.cam.phi==f32(BEHIND_PHI);
 z=walk_zoom_view(z.player,1,-0.3);#assert z.mode==1;
 z=walk_zoom_view(z.player,1,0.2);#assert z.mode==1 && near(z.player.cam.max_dist,1.2,0.0001);
 z=walk_zoom_view(z.player,1,-0.2);z=walk_zoom_view(z.player,1,-0.2);#assert z.mode==1 && z.player.cam.max_dist==1;
 z=walk_zoom_view(z.player,1,0.05);z=walk_zoom_view(z.player,1,-0.3);#assert z.mode==1;
 z=walk_zoom_view(z.player,1,-0.5);#assert z.mode==0 && near(z.player.cam.phi,f32(PI/2),0.0001);
 z=walk_zoom_view(z.player,0,0.2);z=walk_zoom_view(z.player,0,-0.1);z=walk_zoom_view(z.player,0,0.2);#assert z.mode==0;
 z=walk_zoom_view(z.player,0,0.4);#assert z.mode==1;
 t:=walk_zoom_view(p,2,-3);#assert t.mode==2 && near(t.player.cam.max_dist,1.4,0.0001);
}
walk_constrain :: (p:Player,x:f32,z:f32)->Player #effects(all) {
 next:=p;dx:=x-p.body.pos.x;dz:=z-p.body.pos.z;
 next.body=body_constrain(p.body,x,z);
 if dx!=0 {next.cam.target.x+=dx;next.cam.prev_target.x+=dx;}
 if dz!=0 {next.cam.target.z+=dz;next.cam.prev_target.z+=dz;}
 return next;
}
// Puts a body at (x, z) where a realm's bounds moved it: no drawn slide to there, and no speed into the bound.
body_constrain :: (b:Body,x:f32,z:f32)->Body #effects(all) {
 next:=b;
 if x!=b.pos.x {next.pos.x=x;next.prev_pos.x=x;next.vel.x=0;}
 if z!=b.pos.z {next.pos.z=z;next.prev_pos.z=z;next.vel.z=0;}
 return next;
}

// ---- floors (metaverse-engine/physics/stand.coax): a roof's slopes, a tower's cone

// A gable roof 8 m across x and 10 m along z, its ridge along z at x 0: eaves `eave` up, the ridge 3 m over them.
gable :: (f: [] f32, eave: f32) #effects(all) {
  stand_put_quad(f, 0, -4, -5, 4, 0, 0, 10, eave, 3, 0);
  stand_put_quad(f, 1, 4, -5, -4, 0, 0, 10, eave, 3, 0);
}

#test "coming down onto a roof you land on its slope and stand there, at the eave and at the ridge" {
  f: [2 * STAND_FLOATS] f32;
  gable(f[..], 4);
  w: World;
  w.floors = f[..];
  p := walk_place(-3.5, 12, 0, 0);
  for i: 0..<120 { p = step(w, p, STEP); }
  #assert p.body.on_ground && near(p.body.pos.y, 4 + 3 * 0.5 / 4, 0.01) && !p.body.sliding;
  q := walk_place(0, 12, 1, 0);
  for i: 0..<120 { q = step(w, q, STEP); }
  #assert q.body.on_ground && near(q.body.pos.y, 7, 0.01);
  // and you jump off it as off the ground
  q = step(w, walk_input(q, 0, 0, 0, 0, false, true, 0, 0), STEP);
  #assert !q.body.on_ground && q.body.vel.y > f32(JUMP) - 1 && q.body.pos.y > 7;
  // under it (inside, on the ground) it is no floor
  r := walk_place(-1, 0, 0, 0);
  for i: 0..<20 { r = step(w, r, STEP); }
  #assert r.body.on_ground && r.body.pos.y == 0;
}

#test "walking along a roof follows its slope, and off its end you fall to the ground" {
  f: [2 * STAND_FLOATS] f32;
  gable(f[..], 4);
  w: World;
  w.floors = f[..];
  p := walk_place(-2, 5.5, -4, 0);   // facing +z, along the ridge
  for i: 0..<20 { p = step(w, p, STEP); }
  #assert p.body.on_ground && near(p.body.pos.y, 5.5, 0.01);
  p = held(p, 0, 1, false);
  fell := false; low := 100.0f32;
  for i: 0..<400 {
    p = step(w, p, STEP);
    if p.body.pos.z < 4.9 { #assert near(p.body.pos.y, 5.5, 0.05) && p.body.on_ground; }
    if p.body.pos.z > 5.3 && !p.body.on_ground { fell = true; }
    low = lo(low, p.body.pos.y);
  }
  #assert fell && p.body.pos.y == 0 && low == 0;
  // across it: up its slope to the ridge, down the other side, off the far eave
  q := walk_place(-3.8, 4.2, 0, f32(PI) / 2);
  for i: 0..<20 { q = step(w, q, STEP); }
  q = held(q, 0, 1, false);
  top := 0.0f32;
  for i: 0..<300 { q = step(w, q, STEP); top = hi(top, q.body.pos.y); }
  #assert top > 6.8 && q.body.pos.x > 4.5 && q.body.pos.y == 0;
}

#test "a slope too steep to stand on slides you off its low edge" {
  f: [STAND_FLOATS] f32;
  stand_put_cone(f[..], 0, 0, 0, 2, 3, 4);
  w: World;
  w.floors = f[..];
  p := walk_place(0.5, 9, 0, 0);
  slid := false;
  for i: 0..<400 {
    p = step(w, p, STEP);
    if p.body.sliding { slid = true; #assert !p.body.on_ground && p.body.pos.y > 2.9; }
  }
  #assert slid && p.body.pos.x > 2 && p.body.pos.y == 0 && p.body.on_ground;
  // and while sliding you can't jump
  q := walk_place(0.5, 9, 0, 0);
  for i: 0..<60 { q = step(w, q, STEP); if q.body.sliding { break; } }
  #assert q.body.sliding;
  q = walk_input(q, 0, 0, 0, 0, false, true, 0, 0);
  #assert q.body.vel.y <= 0;
}

#test "walking into a low roof's edge from the side stops you; one under a step you walk onto" {
  f: [2 * STAND_FLOATS] f32;
  gable(f[..], 1);
  w: World;
  w.floors = f[..];
  p := held(walk_place(-6, 0, 0, f32(PI) / 2), 0, 1, false);
  for i: 0..<200 { p = step(w, p, STEP); }
  #assert p.body.pos.x < -3.9 && p.body.pos.x > -4.5 && p.body.pos.y == 0;
  gable(f[..], 0.3);
  q := held(walk_place(-6, 0, 0, f32(PI) / 2), 0, 1, false);
  for i: 0..<120 { q = step(w, q, STEP); }
  #assert q.body.pos.x > -3 && q.body.pos.y > 0.5;
}

// ---- Flight (metaverse-engine/move/flight.coax): the per-step hook a flying realm declares ----

flier :: () -> World #effects(all) { w: World; w.flight = flight_profile_lookup("fairy-forest"); return w; }
// The flying session's controls in window k of 1/6 s each. A window starts on a frame at 30,
// 60, 120 and 144 FPS alike and, with the clock started half a step in, at least a sixth of a
// 1/64 s step from a step's end, so every rate starts the window's controls on the same step: walk, a jump from the ground held into a climb, a glide,
// a beat held into a climb, a beat and a longer climb, a dive and a glide to the ground.
FLY_WINDOWS :: 18;
fly_controls :: (p: Player, k: int) -> Player #effects(all) {
  held_up := k == 1 || k == 2 || k == 5 || k == 7 || k == 8;
  dive := k == 10 || k == 11;
  return walk_fly_input(p, 0, ifx k < 14 then 1.0f32 else 0, 0, 0, false, held_up, 0, true, dive);
}
// The step a window's controls start on: floor(k * 64 / 6 + 1 / 2).
fly_window_step :: (k: int) -> int #effects(all) { return (64 * k + 3) / 6; }
fly_start :: () -> Player #effects(all) { p := walk_place(0, 0, 0, 0); p.body.clock.carry_ns = LOOP_STEP_NS / 2; return p; }
same_flight :: (a: Player, b: Player) -> bool #effects(all) {
  return same_step(a, b) && a.body.beats == b.body.beats && a.body.diving == b.body.diving && a.body.jumps.taken == b.body.jumps.taken;
}
fly_reference :: (out: [] Player) #effects(all) {
  w := flier();
  q := fly_start();
  k := 0;
  for i: 0..<out.count {
    while fly_window_step(k + 1) <= i { k += 1; }   // out.count steps end with the last window
    q = fly_controls(q, k);
    q = step_once(w, q, STEP);
    out[i] = q;
  }
}
// Frames whose times sum to 1/6 s, unevenly: 4, 1, 2, 5 and 8 of 1/120 s.
fly_uneven :: (f: int) -> f32 #effects(all) {
  parts := [5] f32.[4.0 / 120.0, 1.0 / 120.0, 2.0 / 120.0, 5.0 / 120.0, 8.0 / 120.0];
  return parts[f % 5];
}

// book:begin flight-rates
#forall "a flight of beats, climbs, glides and a dive has the same states at 30, 60, 120 and 144 FPS and on uneven frames" r: 0..<5 {
  fps := ifx r == 0 then 30 else ifx r == 1 then 60 else ifx r == 2 then 120 else 144;
  per := ifx r == 4 then 5 else fps / 6;    // frames a window
  total := fly_window_step(FLY_WINDOWS);
  ref: [192] Player;
  fly_reference(ref[0..<total]);
  // the reference really flew: it climbed held, glided, beat twice in the air, dived and landed
  #assert ref[fly_window_step(3) - 1].body.pos.y > 1 && ref[fly_window_step(3) - 1].body.vel.y == 3.2;
  #assert ref[fly_window_step(4) + 8].body.vel.y == -1.5 && !ref[fly_window_step(4) + 8].body.on_ground;
  #assert ref[total - 1].body.beats == 2 && ref[total - 1].body.jumps.taken == 3;
  #assert ref[fly_window_step(10) + 2].body.diving && ref[fly_window_step(10) + 2].body.vel.y == -7;
  #assert ref[total - 1].body.on_ground && !ref[total - 1].body.diving;
  w := flier();
  p := fly_start();
  frames := 0;
  for k: 0..<FLY_WINDOWS {
    for f: 0..<per {
      p = fly_controls(p, k);
      frame := ifx r == 4 then fly_uneven(frames) else cast(f32) (1.0 / cast(f64) fps);
      p = advance_in(w, p, frame);
      frames += 1;
      if p.body.clock.ticks > 0 { #assert same_flight(p, ref[p.body.clock.ticks - 1]); }
    }
    #assert p.body.clock.ticks == fly_window_step(k + 1);   // every rate ends the window on the same step
  }
  #assert frames == FLY_WINDOWS * per && p.body.clock.ticks == total;
}
// book:end flight-rates

// The session itself, pinned: the feet's height at the end of each window (its bits) and how
// far it walked, so a change to the controls, the windows or the start shows here.
#test "the flying session flies the path it was recorded with" {
  ref: [192] Player;
  fly_reference(ref[..]);
  bits := [18] u32.[0, 1062830080, 1068728317, 1070098015, 1068158149, 1073607463, 1074359493, 1076874435, 1079181300,
    1079866149, 1075278629, 1066722890, 1063767188, 1059835028, 1054054696, 1042231888, 0, 0];
  for k: 0..<18 { #assert f32_bits(ref[fly_window_step(k + 1) - 1].body.pos.y) == bits[k]; }
  #assert ref[191].body.pos.z == 8.1484375 && ref[148].body.pos.z == 8.072266 && ref[159].body.pos.z == 8.1484375;
  #assert fly_start().body.clock.carry_ns * 2 == LOOP_STEP_NS;
  sum := 0.0f32;
  for f: 0..<5 { sum += fly_uneven(f); #assert f == 0 || fly_uneven(f) != fly_uneven(f - 1); }
  #assert abs(sum - 1.0f32 / 6) < 0.000001 && fly_uneven(5) == fly_uneven(0);
}

#forall "same_flight compares every field it names" k: 0..<4 {
  a := walk_fly_input(walk_place(0, 3, 0, 0), 0, 0, 0, 0, false, true, 0, true, true);
  #assert same_flight(a, a);
  b := a;
  if k == 0 { b.body.pos.y += 1; } else if k == 1 { b.body.beats += 1; } else if k == 2 { b.body.diving = !b.body.diving; } else { b.body.jumps.taken += 1; }
  #assert !same_flight(a, b);
}

#test "a glide falls at exactly glide and a held climb rises at exactly climb, step by step" {
  w := flier();
  p := walk_place(0, 10, 0, 0);
  p = walk_fly_input(p, 0, 0, 0, 0, false, false, 0, true, false);
  for i: 0..<64 {
    y := p.body.pos.y;
    p = step(w, p, STEP);
    if i > 4 { #assert p.body.vel.y == -1.5 && p.body.pos.y == y - 1.5 * f32(STEP) && !p.body.on_ground && !p.body.diving; }
  }
  p = walk_fly_input(p, 0, 0, 0, 0, false, true, 0, true, false);   // pressed: a beat, then held: the climb
  p = step(w, p, STEP);
  #assert p.body.beats == 1 && p.body.vel.y == 5.2 && p.body.jumps.taken == 1;
  for i: 0..<64 { p = step(w, p, STEP); }
  y := p.body.pos.y;
  p = step(w, p, STEP);
  #assert p.body.vel.y == 3.2 && p.body.pos.y == y + 3.2 * f32(STEP) && p.body.beats == 1;
}

#test "a press on the ground still jumps; in the air without wings it is spent and lifts nothing" {
  w := flier();
  p := walk_fly_input(walk_place(0, 0, 0, 0), 0, 0, 0, 0, false, true, 0, true, false);
  p = step(w, p, STEP);
  #assert !p.body.on_ground && p.body.beats == 0 && p.body.vel.y > f32(JUMP) - 1;   // the jump, not a beat
  q := walk_fly_input(walk_place(0, 10, 0, 0), 0, 0, 0, 0, false, false, 0, false, false);
  for i: 0..<8 { q = step(w, q, STEP); }   // falling from rest: gravity, then the glide
  #assert q.body.vel.y == -1.5;
  q = walk_fly_input(q, 0, 0, 0, 0, false, true, 0, false, false);
  q = step(w, q, STEP);
  #assert q.body.jumps.taken == 1 && q.body.jumps.waiting == 0 && q.body.beats == 0 && q.body.vel.y == -1.5;
  // the dive works without wings: Shift in the air
  q = walk_fly_input(q, 0, 0, 0, 0, false, false, 0, false, true);
  q = step(w, q, STEP);
  #assert q.body.diving && q.body.vel.y == -7;
  // still held down to the ground: landed, you are not diving
  while !q.body.on_ground { q = step(w, q, STEP); }
  #assert !q.body.diving && q.body.dive_held;
}

#test "a tap is a press even while the jump is held; held, it is one press" {
  p := walk_place(0, 0, 0, 0);
  p = walk_fly_input(p, 0, 0, 0, 0, false, true, 0, true, false);
  #assert p.body.jumps.pressed == 1;
  p = walk_fly_input(p, 0, 0, 0, 0, false, true, 0, true, false);
  #assert p.body.jumps.pressed == 1;                       // held: no new press
  p = walk_fly_input(p, 0, 0, 0, 0, false, true, 2, true, false);
  #assert p.body.jumps.pressed == 2 && p.body.jumps.held;       // a tap while held: one more, the hold kept
  q := walk_fly_input(walk_place(0, 0, 0, 0), 0, 0, 0, 0, false, false, 1, true, false);
  #assert q.body.jumps.pressed == 1 && !q.body.jumps.held && !q.body.jump_held;   // a tap alone: a press, nothing held
  q = walk_fly_input(q, 0, 0, 0, 0, false, true, 1, true, false);
  #assert q.body.jumps.pressed == 2 && q.body.jump_held;        // rising and tapping in one frame: one press
  #assert q.body.wings && !q.body.dive_held;
  q = walk_fly_input(q, 0, 0, 0, 0, false, false, 0, false, true);
  #assert !q.body.wings && q.body.dive_held && q.body.jumps.pressed == 2;
}

#test "a walker with no flight profile is the same with wings and a dive held" {
  w: World;
  a := walk_place(0, 0, 0, 0); b := a;
  for i: 0..<200 {
    jump := i == 5 || i == 30 || i == 31;
    was := a;
    a = walk_fly_input(was, 0, 1, 0, 0, false, jump, 0, false, false);
    #assert walker_same(a, walk_input(was, 0, 1, 0, 0, false, jump, 0, 0));
    b = walk_fly_input(b, 0, 1, 0, 0, false, jump, ifx i == 40 then 1 else 0, true, true);
    a = step_once(w, a, STEP); b = step_once(w, b, STEP);
    if i < 40 { #assert walker_same(a, b) && b.body.beats == 0 && !b.body.diving; }
  }
  #assert a.body.jumps.taken == 2 && b.body.jumps.taken == 3 && b.body.beats == 0 && !b.body.diving;
}

// A level-topped hull for the checks: x in [-1, 1] moved dx along, z in [-1, 1], from -0.25 to `top`.
walk_test_block :: (h: [] f32, dx: f32, top: f32) #effects(all) {
  e := query_test_wedge(h, 0, dx); if e != h.count { return; }
  o := QUERY_HULL_HEAD + 5 * QUERY_HULL_FACE; h[o] = 0; h[o + 1] = 1; h[o + 3] = top; h[2] = top;
}
#test "walk among hulls: you step onto a low one, a tall one stops you, and you jump onto it and stand on its top" {
  h: [QUERY_HULL_HEAD + 6 * QUERY_HULL_FACE] f32; walk_test_block(h[..], 3, 0.4);
  w: World; w.hulls = h[..];
  p := place_in(w, 0, 0, 0, 0);
  for k: 0..<120 { p = walk_input(p, 0, ifx k < 50 then 1.0f32 else 0.0f32, 0, 0, false, false, 0, 0); p.cam.theta = -f32(PI) / 2; p = advance_in(w, p, f32(STEP)); }
  // walked across +x onto it: stood on its top
  #assert p.body.pos.x > 2.4 && p.body.pos.x < 4 && near(p.body.pos.y, 0.4, 0.02) && p.body.on_ground && p.body.collision_refusals == 0;
  walk_test_block(h[..], 3, 1.2);
  q := place_in(w, 0, 0, 0, 0);
  for k: 0..<120 { q = walk_input(q, 0, 1, 0, 0, false, false, 0, 0); q.cam.theta = -f32(PI) / 2; q = walk_advance_among_hulls(q, f32(STEP), h[0..<0], h[0..<0], h[0..<0], h[..], "everglade"); }
  // stopped a radius short of its side, on the ground
  #assert near(q.body.pos.x, 2 - 0.3, 0.01) && q.body.pos.y == 0;
  // a jump with the key held: up, over its edge and down on its top, feet on it
  for k: 0..<120 { q = walk_input(q, 0, ifx k < 36 then 1.0f32 else 0.0f32, 0, 0, false, k < 3, 0, 0); q.cam.theta = -f32(PI) / 2; q = advance_in(w, q, f32(STEP)); }
  #assert q.body.pos.x > 2.2 && near(q.body.pos.y, 1.2, 0.02) && q.body.on_ground;
  // the trusted direct move stops at its side too
  m := move_across(w, place_in(w, 1.5, 0, 0, 0), 0.4, 0); #assert near(m.body.pos.x, 1.7, 0.0001);
  #assert move_across(w, place_in(w, 1.5, 1.3, 0, 0), 0.4, 0).body.pos.x == 1.9;
  #assert near(move_across(w, place_in(w, 1.5, 0.6, 0, 0), 0.4, 0).body.pos.x, 1.7, 0.0001);   // its side is felt up to its top
}

// ---- Faster locomotion on the same paid clock (was walk-scaled.coax) ----
// The ordinary advance_in contract is one collision integration a tick. This opt-in keeps the tick
// and takes as many collision parts in it as the profile's travel limit needs.
body_step :: (w:World,given:Body,dt:f32)->Body #effects(all) {
  if !locomotion_profile_ok(w.locomotion) || walk_travel_parts(w.locomotion.run_speed,f32(STEP),w.collision.max_travel)!=1 {
    return body_collision_report(given,CollideResult.{status=CollideStatus.bad_profile});
  }
  return body_step_fixed(w,given,dt);
}
body_substep :: (w:World,given:Body,dt:f32)->Body #effects(all) {
  if !locomotion_profile_ok(w.locomotion) || walk_travel_parts(w.locomotion.run_speed,dt,w.collision.max_travel)!=1 {
    return body_collision_report(given,CollideResult.{status=CollideStatus.bad_profile});
  }
  return body_step_fixed(w,given,dt);
}
body_substep_refusal :: (given:Body,attempt:Body)->Body #effects(all) {
  return body_collision_report(given,CollideResult.{status=attempt.collision_status,passes=attempt.collision_passes,residual=attempt.collision_residual,floor_cut=attempt.collision_floor_cut});
}
// One paid tick of a body at a faster pace: the tick's travel in as many collision parts as the profile needs.
body_scaled_fixed :: (w:World,given:Body)->Body #effects(all) {
  parts:=walk_travel_parts(w.locomotion.run_speed,f32(STEP),w.collision.max_travel);
  start:=given; start.prev_pos=given.pos; start.prev_face=given.face;
  if parts==0 { return body_collision_report(start,CollideResult.{status=CollideStatus.bad_profile}); }
  next:=start;
  for part:0..<parts {
    next=body_substep(w,next,f32(STEP)/f32(parts));
    if next.collision_status!=CollideStatus.ok { return body_substep_refusal(start,next); }
  }
  return next;
}
body_advance_scaled_in :: (w:World,given:Body,frame:f32)->Body #effects(all) {
  schedule:=walk_schedule(given.clock,frame);
  if !schedule.ok { return body_collision_report(given,CollideResult.{status=CollideStatus.bad_profile}); }
  next:=given; next.clock=schedule.clock;
  for tick:0..<schedule.count { next=body_scaled_fixed(w,next); }
  next.clock=loop_ran(next.clock);
  return next;
}
// The same for a page's player: its body's tick with its camera's yaw, then its camera's step.
walk_scaled_fixed :: (w:World,given:Player)->Player #effects(all) {
  start:=given; start.cam.prev_target=given.cam.target; start.cam.prev_dist=given.cam.dist;
  start.body=body_scaled_fixed(w,player_yawed(given));
  if start.body.collision_status!=CollideStatus.ok { return start; }
  return camera_step(w,start,f32(STEP));
}
advance_scaled_in :: (w:World,given:Player,frame:f32)->Player #effects(all) {
  schedule:=walk_schedule(given.body.clock,frame);
  if !schedule.ok { return collision_report(given,CollideResult.{status=CollideStatus.bad_profile}); }
  next:=given; next.body.clock=schedule.clock;
  for tick:0..<schedule.count { next=walk_scaled_fixed(w,next); }
  next.body.clock=loop_ran(next.body.clock);
  return next;
}
#test "scaled: a body's faster ticks are the page's player's, part for part, and refuse as it does" {
  w:World; w.locomotion.walk_speed=14; w.locomotion.run_speed=30;
  p:=walk_input(walk_place(0,0,0,0),0,1,0,0,true,true,0,0); b:=p.body;
  #assert walk_travel_parts(w.locomotion.run_speed,f32(STEP),w.collision.max_travel)>1;
  for f:0..<40 {
    p=advance_scaled_in(w,p,0.02); b=body_advance_scaled_in(w,b,0.02);
    #assert b.pos.z==p.body.pos.z && b.pos.y==p.body.pos.y && b.vel.z==p.body.vel.z && b.prev_pos.z==p.body.prev_pos.z && b.prev_face==p.body.prev_face && b.clock.ticks==p.body.clock.ticks && b.clock.ran==p.body.clock.ran;
  }
  #assert b.pos.z!=0 && b.clock.ticks>40 && b.jumps.taken==1;
  one:=body_scaled_fixed(w,b); #assert one.prev_pos.z==b.pos.z && one.pos.z!=b.pos.z && one.prev_face==b.face;
  // no steps due: nothing moves and the clock says none ran
  still:=body_advance_scaled_in(w,b,0); #assert still.pos.z==b.pos.z && still.clock.ran==0 && still.clock.ticks==b.clock.ticks;
  // a profile that pays for no travel, a pass budget of none, a clock that is not the engine's: each refused, nothing moved
  z:=w; z.collision.max_travel=0;
  r:=body_scaled_fixed(z,b); #assert r.collision_status==CollideStatus.bad_profile && r.pos.z==b.pos.z && r.collision_refusals==b.collision_refusals+1 && r.prev_pos.z==b.pos.z;
  n:=w; n.collision.max_passes=0;
  q:=body_scaled_fixed(n,b); #assert q.collision_status!=CollideStatus.ok && q.pos.z==b.pos.z && q.jumps.waiting==b.jumps.waiting && q.collision_refusals==b.collision_refusals+1;
  // a page's player: the tick keeps where its camera was, steps the camera after an accepted tick, and leaves it on a refused one
  pq:=p; pq.body=b; pq.cam.prev_target=Vec3.{x=50,y=50,z=50}; pq.cam.prev_dist=0.5;
  ok:=walk_scaled_fixed(w,pq);
  #assert ok.body.collision_status==CollideStatus.ok && ok.body.pos.z==one.pos.z;
  #assert ok.cam.prev_target.z==pq.cam.target.z && ok.cam.prev_target.x==pq.cam.target.x && ok.cam.prev_dist==pq.cam.dist && ok.cam.target.z!=pq.cam.target.z;
  no:=walk_scaled_fixed(n,pq);
  #assert no.body.collision_status==q.collision_status && no.cam.target.z==pq.cam.target.z && no.cam.dist==pq.cam.dist && no.cam.prev_target.z==pq.cam.target.z && no.cam.prev_dist==pq.cam.dist;
  // a part's own entry: a tuning that is not valid, or a part longer than the profile pays for, each alone refuses it
  bad:=w; bad.locomotion.jump_speed= -1;
  #assert walk_travel_parts(bad.locomotion.run_speed,f32(STEP)/8,bad.collision.max_travel)==1 && body_substep(bad,b,f32(STEP)/8).collision_status==CollideStatus.bad_profile;
  #assert locomotion_profile_ok(w.locomotion) && walk_travel_parts(w.locomotion.run_speed,f32(STEP),w.collision.max_travel)!=1 && body_substep(w,b,f32(STEP)).collision_status==CollideStatus.bad_profile;
  #assert body_substep(w,b,f32(STEP)/8).collision_status==CollideStatus.ok;
  odd:=b; odd.clock.step_ns=9;
  o:=body_advance_scaled_in(w,odd,0.02); #assert o.collision_status==CollideStatus.bad_profile && o.pos.z==b.pos.z && o.clock.ticks==b.clock.ticks;
}
#test "ordinary scaled entry keeps one tick and a refused step preserves queued input" {
  w:World; p:=walk_input(walk_place(0,0,0,0),0,1,0,0,true,true,0,0);
  q:=advance_scaled_in(w,p,f32(STEP)); #assert q.body.clock.ticks==1 && q.body.jumps.taken==1;
  w.collision.max_passes=0; q=advance_scaled_in(w,p,f32(STEP));
  #assert q.body.clock.ticks==1 && q.body.pos.z==p.body.pos.z && q.body.jumps.waiting==p.body.jumps.waiting && q.body.collision_refusals==1;
}

// ---- Source velocity ----
// Scalar ground velocity path ported from installed UE 5.8 CharacterMovementComponent
// CalcVelocity/ApplyVelocityBraking, in metres. The Metaverse Engine retains collision and its paid fixed steps.
SourceVelocity :: struct {x:f32;z:f32;}
#test "source velocity accelerates brakes turns and never reverses while stopping" {
 a:=source_velocity(0,0,0,1,1,4.27,5,4,10,2,1.0/64.0);#assert a.x==0 && a.z==0.078125;
 b:=source_velocity(0,4.27,0,0,0,4.27,5,4,10,2,1.0/64.0);#assert abs(b.z-3.58)<0.000001;
 c:=source_velocity(1,0,0,1,1,4.27,5,4,10,2,1.0/64.0);#assert c.x==0.9375 && c.z==0.140625;
 d:=source_velocity(0,0.15,0,0,0,4.27,5,4,10,2,1.0/64.0);#assert d.x==0 && d.z==0;
 e:=source_velocity(0.2,0.3,0,0,0,4.27,0,0,0,2,1.0/64.0);#assert e.x==0.2 && e.z==0.3;
 g:=source_velocity(1,0,0,1,1,4.27,5,128,10,2,1.0/64.0);#assert g.x==0 && g.z==1.078125;
 f:=source_velocity(0,4.27,0,1,1,1.47,5,4,10,2,1.0/64.0);#assert abs(f.z-3.58)<0.000001;
}
#forall "source acceleration respects speed cap and braking approaches zero" angle:0..<8, count:1..<65 {
 x:=sin(cast(f32)angle);z:=cos(cast(f32)angle);v:=SourceVelocity.{};
 for k:0..<count {v=source_velocity(v.x,v.z,x,z,1,4.27,5,4,10,2,1.0/64.0);}#assert v.x*v.x+v.z*v.z<=4.27*4.27+0.00001;
 before:=v.x*v.x+v.z*v.z;v=source_velocity(v.x,v.z,0,0,0,4.27,5,4,10,2,1.0/64.0);#assert v.x*v.x+v.z*v.z<=before;
}
#test "source strict comparisons retain equality unordered and signed boundaries" {
 #assert source_gt(1,0) && !source_gt(0,0) && !source_gt(-1,0);
 #assert source_lt(-1,0) && !source_lt(0,0) && !source_lt(1,0);
 #assert source_le(-1,0) && source_le(0,0) && !source_le(1,0);
 nan:=0.0f32/0.0f32;#assert !source_gt(nan,0) && !source_lt(nan,0) && !source_le(nan,0);
}
#test "source braking distinguishes overshoot tiny motion and the brake threshold" {
 a:=source_velocity(0,0.15,0,0,0,4.27,0,0,100,0,1.0/64.0);#assert a.z==0;
 b:=source_velocity(0,0.00001,0,0,0,4.27,0,0,0,0,1.0/64.0);#assert b.z==0;
 c:=source_velocity(0,0.05,0,0,0,4.27,0,0,0,0,1.0/64.0);#assert c.z==0.05;
 d:=source_velocity(0,0.05,0,0,0,4.27,0,0,0.000001,0,1.0/64.0);#assert d.z==0;
 e:=source_velocity(0,0,0,0,0,4.27,0,0,0,0,1.0/64.0);#assert e.x==0 && e.z==0;
 f:=source_velocity(0,1.5,0,1,1,1.47,5,4,10,2,1.0/64.0);#assert f.z==1.47;
}
source_gt :: (a:f32,b:f32)->bool #effects(all) {return a>b;}
source_lt :: (a:f32,b:f32)->bool #effects(all) {return a<b;}
source_le :: (a:f32,b:f32)->bool #effects(all) {return a<=b;}
source_velocity :: (x:f32,z:f32,dx:f32,dz:f32,amount:f32,speed:f32,accel:f32,friction:f32,brake:f32,factor:f32,dt:f32)->SourceVelocity #effects(all) {
 v:=SourceVelocity.{x=x,z=z};old:=v;old_size:=sqrt(x*x+z*z);maximum:=speed*amount;ax:=dx*accel*amount;az:=dz*accel*amount;zero:=ax==0 && az==0;over:=source_gt(old_size*old_size,maximum*maximum*1.01);
 if zero || over {if source_gt(old_size,0) {v.x+=(0-friction*factor*v.x-brake*x/old_size)*dt;v.z+=(0-friction*factor*v.z-brake*z/old_size)*dt;
  threshold:=ifx source_gt(brake,0) then 0.01f32 else 0.00000001f32;
  if source_lt(v.x*x+v.z*z,0) || source_le(v.x*v.x+v.z*v.z,threshold) {v=SourceVelocity.{};}
  if over && source_lt(v.x*v.x+v.z*v.z,maximum*maximum) && source_gt(ax*old.x+az*old.z,0) {v.x=x/old_size*maximum;v.z=z/old_size*maximum;}
 }}else {share:=ifx source_gt(friction*dt,1) then 1.0f32 else friction*dt;v.x-=(v.x-dx*old_size)*share;v.z-=(v.z-dz*old_size)*share;}
 if !zero {now:=sqrt(v.x*v.x+v.z*v.z);limit:=ifx source_gt(now*now,maximum*maximum*1.01) then now else maximum;v.x+=ax*dt;v.z+=az*dt;size:=sqrt(v.x*v.x+v.z*v.z);if source_gt(size,limit) {v.x=v.x/size*limit;v.z=v.z/size*limit;}}
 return v;
}

// ---- Version 2 frame input ----
// Version 2 frame-input adapter. Player and the original C controller API
// retain their layout; pending controls belong to this explicit sidecar.
WalkControlV2 :: struct {input:InputBuffer;heading:f32;have_heading:bool;}

walk_control_feed :: (c:[]WalkControlV2,key_x:f32,key_y:f32,pad_x:f32,pad_y:f32,run:bool,jump:bool,look_x:f32,look_y:f32) #effects(all) {
  x:=input_axis(key_x);y:=input_axis(key_y);
  px:=input_axis(pad_x);py:=input_axis(pad_y);pad:=Intent.{mended=px.mended+py.mended};
  if input_finite(pad_x) && input_finite(pad_y) && sqrt(px.value*px.value+py.value*py.value)>INPUT_DEAD_ZONE {pad.move_x=px.value;pad.move_y=py.value;}
  i:=Intent.{move_x=x.value,move_y=y.value,run=run,jump=jump,mended=x.mended+y.mended+pad.mended};
  if pad.move_x!=0 || pad.move_y!=0 {i.move_x=pad.move_x;i.move_y=pad.move_y;}
  i=input_amounts(i,look_x,look_y,0);c[0].input=input_feed(c[0].input,i);
}
// An absolute camera heading is a level, distinct from relative look
// amounts. Keep the latest level until a physical step consumes it.
walk_control_heading :: (c:[]WalkControlV2,p:Player,heading:f32) #effects(all) {
  if !input_finite(heading) {c[0].input.mended+=1;return;}
  c[0].heading=heading;c[0].have_heading=true;
}
walk_control_tap :: (c:[]WalkControlV2) #effects(all) {held:=c[0].input.jump.held;c[0].input.jump=input_press(c[0].input.jump);c[0].input.jump.held=held;}
walk_control_flying :: (c:[]WalkControlV2,p:Player,key_x:f32,key_y:f32,pad_x:f32,pad_y:f32,run:bool,jump:bool,taps:int,wings:bool,dive:bool)->Player #effects(all) {
  before:=c[0].input.jump.pressed;
  walk_control_feed(c,key_x,key_y,pad_x,pad_y,run,jump,0,0);
  if taps>0 && c[0].input.jump.pressed==before {walk_control_tap(c);}
  next:=p;next.body.wings=wings;next.body.dive_held=dive;return next;
}
walk_control_zoom :: (c:[]WalkControlV2,amount:f32) #effects(all) {
  i:=input_amounts(Intent.{},0,0,amount);c[0].input.zoom+=i.zoom;c[0].input.mended+=i.mended;
}
walk_control_advance :: (c:[]WalkControlV2,w:World,p:Player,frame:f32)->AdvanceTrace #effects(all) {
  schedule:=walk_schedule(p.body.clock,frame);out:=AdvanceTrace.{player=p};
  if !schedule.ok {return advance_traced(w,p,frame);}
  next:=p;next.body.clock=schedule.clock;c[0].input=input_frame(c[0].input,schedule.count);out.count=schedule.count;
  for step:0..<schedule.count {
    next=walk_control_once(c,w,next);out.targets[step]=walk_target(next);
  }
  next.body.clock=loop_ran(next.body.clock);out.player=next;return out;
}
walk_control_once :: (c:[]WalkControlV2,w:World,p:Player)->Player #effects(all) {
  sample:=input_sample(c[0].input);c[0].input=sample.buffer;a:=sample.actions;next:=p;
  if c[0].have_heading {next.cam.theta=c[0].heading;c[0].have_heading=false;}
  next=walk_input(next,0,0,a.move_x,a.move_y,a.run,false,a.look_x,a.look_y);
  if a.jump {next.body.jumps=input_press(next.body.jumps);}
  next.body.jump_held=c[0].input.jump.held;next.body.jumps.held=next.body.jump_held;
  next=walk_zoom(next,a.zoom);return history_step(w,next);
}
walk_control_realm :: (c:[]WalkControlV2,p:Player,frame:f32,bodies:[]f32,walls:[]f32,floors:[]f32,realm:string)->AdvanceTrace #effects(all) {
  declaration:=realm_collision.collision_profile_lookup(realm);
  if declaration.status!=realm_collision.CollisionProfileStatus.ok {return walk_advance_in_realm_traced(p,frame,bodies,walls,floors,realm);}
  world:=World.{bodies=bodies,walls=walls,floors=floors,collision=declaration.profile,flight=flight_profile_lookup(realm)};
  return walk_control_advance(c,world,p,frame);
}

#test "look and a short jump wait for the first physical step" {
  c:[1]WalkControlV2;p:=walk_place(0,0,0,0);w:World;
  walk_control_feed(c[..],0,1,0,0,true,true,0.3,0.1);
  short:=walk_control_advance(c[..],w,p,0.001).player;
  #assert short.cam.theta==p.cam.theta && short.cam.phi==p.cam.phi && short.body.jumps.taken==0 && c[0].input.jump.waiting==1;
  walk_control_feed(c[..],0,1,0,0,true,false,0,0);
  moved:=walk_control_advance(c[..],w,short,0.015).player;
  #assert abs(wrap_angle(moved.cam.theta-p.cam.theta)-0.3)<0.000001;
  #assert moved.body.jumps.taken==1 && moved.body.vel.y>0 && c[0].input.jump.waiting==0 && !moved.body.jumps.held && !moved.body.jump_held;
}
#test "three steps split look and zoom and agree with three individual samples" {
  a:[1]WalkControlV2;b:[1]WalkControlV2;p:=walk_place(0,0,0,0);q:=p;w:World;
  walk_control_feed(a[..],0,1,0,0,true,true,0.375,0);walk_control_zoom(a[..],-0.375);
  trace:=walk_control_advance(a[..],w,p,3*STEP);p=trace.player;
  #assert trace.count==3;
  for i:0..<3 {
    walk_control_feed(b[..],0,1,0,0,true,i==0,0.125,0);walk_control_zoom(b[..],-0.125);
    q=walk_control_advance(b[..],w,q,STEP).player;
    #assert trace.targets[i].feet.x==q.body.pos.x && trace.targets[i].feet.y==q.body.pos.y && trace.targets[i].feet.z==q.body.pos.z;
  }
  #assert p.body.pos.x==q.body.pos.x && p.body.pos.z==q.body.pos.z && p.body.vel.y==q.body.vel.y && p.cam.theta==q.cam.theta && p.cam.dist==q.cam.dist && p.cam.max_dist==q.cam.max_dist && p.cam.max_dist<CAM_MAX;
  #assert p.body.jumps.taken==1 && q.body.jumps.taken==1 && a[0].input.look_x==0 && a[0].input.zoom==0;
}
#test "absolute heading levels replace across zero-step frames" {
  c:[1]WalkControlV2;p:=walk_place(0,0,0,0);
  walk_control_heading(c[..],p,p.cam.theta+0.2);walk_control_heading(c[..],p,p.cam.theta+0.3);
  #assert c[0].input.look_x==0 && c[0].heading==p.cam.theta+0.3 && c[0].have_heading;
  w:World;q:=walk_control_advance(c[..],w,p,STEP).player;
  #assert q.cam.theta==wrap_angle(p.cam.theta+0.3) && !c[0].have_heading;
}

#test "flying taps retain their held level and invalid amounts are counted" {
  c:[1]WalkControlV2;p:=walk_place(0,0,0,0);
  p=walk_control_flying(c[..],p,0,1,0,0,true,false,1,true,true);
  #assert c[0].input.jump.waiting==1 && !c[0].input.jump.held && p.body.wings && p.body.dive_held && c[0].input.move_y==1 && c[0].input.run;
  p=walk_control_flying(c[..],p,0,1,0,0,true,true,1,false,false);
  #assert c[0].input.jump.waiting==2 && c[0].input.jump.held && !p.body.wings && !p.body.dive_held;
  p=walk_control_flying(c[..],p,0,1,0,0,true,true,1,true,false);
  #assert c[0].input.jump.waiting==3;
  p=walk_control_flying(c[..],p,0,1,0,0,true,true,0,true,false);#assert c[0].input.jump.waiting==3;
  w:World;p=walk_control_advance(c[..],w,p,STEP).player;#assert p.body.jump_held && p.body.jumps.held;
  released:[1]WalkControlV2;walk_control_tap(released[..]);#assert released[0].input.jump.waiting==1 && !released[0].input.jump.held;
  bad:=1000000.0f32;walk_control_heading(c[..],p,bad);walk_control_zoom(c[..],bad);
  #assert c[0].input.mended==2 && c[0].input.zoom==0 && !c[0].have_heading;
}
#test "realm and frame refusal leave the pending input owned by its next valid step" {
  c:[1]WalkControlV2;p:=walk_place(0,0,0,0);empty:[1]f32;
  walk_control_feed(c[..],0,1,0,0,true,true,0.2,0);
  refused:=walk_control_realm(c[..],p,STEP,empty[0..<0],empty[0..<0],empty[0..<0],"unknown");
  #assert refused.count==0 && c[0].input.jump.waiting==1 && c[0].input.look_x==0.2;
  bad:=p;bad.body.clock.step_ns=1;w:World;
  refused=walk_control_advance(c[..],w,bad,STEP);#assert refused.count==0 && c[0].input.jump.waiting==1;
  admitted:=walk_control_realm(c[..],p,STEP,empty[0..<0],empty[0..<0],empty[0..<0],"garden");
  #assert admitted.count==1 && admitted.player.body.jumps.taken==1 && c[0].input.jump.waiting==0;
}
#test "keys and stick share the exact dead zone and mended-axis rule" {
  c:[1]WalkControlV2;
  walk_control_feed(c[..],2,-2,0.2,0,false,false,0,0);
  #assert c[0].input.move_x==1 && c[0].input.move_y==-1 && c[0].input.mended==2 && !c[0].input.run;
  walk_control_feed(c[..],1,1,0.21,-0.4,true,false,0,0);
  #assert c[0].input.move_x==0.21 && c[0].input.move_y==-0.4 && c[0].input.run;
  walk_control_feed(c[..],1,1,0.4,0,false,false,0,0);#assert c[0].input.move_x==0.4 && c[0].input.move_y==0;
  walk_control_feed(c[..],1,1,0,-0.4,false,false,0,0);#assert c[0].input.move_x==0 && c[0].input.move_y==-0.4;
  bad:=1000000.0f32;
  walk_control_feed(c[..],bad,0.5,bad,0.9,false,false,bad,bad);
  #assert c[0].input.move_x==0 && c[0].input.move_y==0.5 && c[0].input.mended==6 && c[0].input.look_x==0 && c[0].input.look_y==0;
  only_y:[1]WalkControlV2;walk_control_feed(only_y[..],0,0,0,bad,false,false,0,0);#assert only_y[0].input.mended==1;
}
