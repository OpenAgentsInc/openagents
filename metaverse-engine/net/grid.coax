// The relevance grid a room's interest uses (#13178): the engine's spatial grid
// (metaverse-engine/core/spatial.coax, where the algorithm and its brute-force check live since #13274) at a
// fixed size, made for one relevance radius with cells NET_GRID_RINGS to the radius. A realm puts
// each entity's slot where it stands once a tick and asks once per client: a query returns exactly
// the slots within the radius.
//
// Its storage is its own fields, and every link is stored plus one, so a grid of zeros is empty
// (the C host's memory starts so). Slots are the caller's (0 to NET_GRID_CAP - 1).
//   coax/bin/coax test metaverse-engine/net/grid.coax
#module "metaverse.engine.net.grid";
#authority;
#load "../core/spatial.coax";

NET_GRID_CAP :: 1024;         // slots at most
NET_GRID_BUCKETS :: 1024;     // the lists cells hash into (a power of two)
NET_GRID_RINGS :: 2;          // cells to the radius: a query looks at (2 * RINGS + 1)^2 cells or (2 * RINGS + 2)^2

NetGrid :: struct {
  radius: f32;                          // m: what a query returns, within this of its point
  head: [NET_GRID_BUCKETS] int;
  next: [NET_GRID_CAP] int; prev: [NET_GRID_CAP] int; at: [NET_GRID_CAP] int;
  cx: [NET_GRID_CAP] int; cz: [NET_GRID_CAP] int;
  x: [NET_GRID_CAP] f32; z: [NET_GRID_CAP] f32;         // where each slot stands
  cell: [1] f32;                        // m: a cell's side
  n: [SPATIAL_COUNTERS] int;            // slots in the grid, and slots queries have looked at
}
net_grid_view :: (g: [] NetGrid) -> SpatialGrid #effects(all) {
  return SpatialGrid.{head = g[0].head[..], next = g[0].next[..], prev = g[0].prev[..], at = g[0].at[..], cx = g[0].cx[..], cz = g[0].cz[..],
    x = g[0].x[..], z = g[0].z[..], cell = g[0].cell[..], n = g[0].n[..]};
}
// An empty grid for relevance radius `radius` (m). A radius of 0 or less puts every slot in one cell.
net_grid_init :: (g: [] NetGrid, radius: f32) #effects(all) {
  g[0].radius = radius;
  _ := spatial_init(net_grid_view(g), radius / f32(NET_GRID_RINGS));
}
net_grid_has :: (g: [] NetGrid, i: int) -> bool #effects(all) { return spatial_has(net_grid_view(g), i); }
net_grid_count :: (g: [] NetGrid) -> int #effects(all) { return g[0].n[SPATIAL_COUNT]; }
net_grid_visits :: (g: [] NetGrid) -> int #effects(all) { return g[0].n[SPATIAL_VISITS]; }
// Slot i stands at (x, z). False (and nothing changed) for a slot outside 0 to NET_GRID_CAP - 1.
net_grid_put :: (g: [] NetGrid, i: int, x: f32, z: f32) -> bool #effects(all) { return spatial_put(net_grid_view(g), i, x, z); }
// Slot i leaves the grid.
net_grid_drop :: (g: [] NetGrid, i: int) #effects(all) { spatial_drop(net_grid_view(g), i); }
// The slots within the grid's radius of (x, z), into out (as many as fit); how many there are.
net_grid_query :: (g: [] NetGrid, x: f32, z: f32, out: [] int) -> int #effects(all) { return spatial_query(net_grid_view(g), x, z, g[0].radius, out); }

// ---- checks (the grid's own are metaverse-engine/core/spatial.coax's)

#test "net grid: zeros are an empty grid; cells are half the radius; a query is the radius's; slots past the cap are refused" {
  g: [1] NetGrid; out: [8] int;
  #assert net_grid_count(g[..]) == 0 && !net_grid_has(g[..], 0) && net_grid_visits(g[..]) == 0;
  net_grid_init(g[..], 40); #assert g[0].cell[0] == 20 && g[0].radius == 40;
  #assert net_grid_put(g[..], 3, 24, 32) && net_grid_put(g[..], 7, 41, 0) && net_grid_put(g[..], 0, -24, -32) && net_grid_count(g[..]) == 3;
  #assert !net_grid_put(g[..], -1, 0, 0) && !net_grid_put(g[..], NET_GRID_CAP, 0, 0) && net_grid_put(g[..], NET_GRID_CAP - 1, 500, 500) && net_grid_count(g[..]) == 4;
  #assert net_grid_has(g[..], 3) && !net_grid_has(g[..], 4) && !net_grid_has(g[..], NET_GRID_CAP);
  n := net_grid_query(g[..], 0, 0, out[..]);   // (24, 32) and (-24, -32) are exactly 40 m off; (41, 0) is past
  #assert n == 2 && ((out[0] == 3 && out[1] == 0) || (out[0] == 0 && out[1] == 3)) && net_grid_visits(g[..]) == 3;
  net_grid_drop(g[..], 3); #assert net_grid_count(g[..]) == 3 && !net_grid_has(g[..], 3) && net_grid_query(g[..], 0, 0, out[..]) == 1 && out[0] == 0;
  // a new radius empties it
  net_grid_init(g[..], 10); #assert net_grid_count(g[..]) == 0 && net_grid_visits(g[..]) == 0 && g[0].cell[0] == 5 && net_grid_query(g[..], 0, 0, out[..]) == 0;
  // the lists are a power of two, as the grid needs
  #assert spatial_shaped(net_grid_view(g[..])) && (NET_GRID_BUCKETS & (NET_GRID_BUCKETS - 1)) == 0;
}
