// Orbit League's additive authoritative profile. The unversioned reported-car wire stays frozen.
#module "orbit.session";
#authority;
#load "session.coax";
#load "record.coax";
#load "row.coax";
#load "replication.coax";

ORB_VERSION :: 2;ORB_FIELDS :: 16;ORB_FUEL :: 14;ORB_LIFE :: 15;
ORB_CLIENT_BYTES :: 256;ORB_INPUT_STALE_MS :: 1000;ORB_MALFORMED :: 9;
OrbInput :: struct {ok:bool;seq:int;throttle:int;steer:int;flags:int;paint:int;clock:int;heard:int;}

#test "Orbit v2: explicit authority, vehicle collision and owner-only fuel use the shared realm contract" {
  p:=orb_realm();#assert net_realm_ok(p) && net_authoritative(p.beat);
  #assert p.beat.hz==60 && p.beat.substeps==2 && p.beat.fair==NET_FAIR_BEAT && p.beat.durable==NET_DURABLE_NONE;
  #assert p.collision==NET_COLLIDE_VEHICLE && p.fields==16 && ORB_LIFE==15 && ORB_INPUT_STALE_MS==1000;
  #assert net_recipient_fields(p,NET_RECIPIENT_PUBLIC,false)==49151;
  #assert net_recipient_fields(p,NET_RECIPIENT_OWNER,false)==65535;
  #assert net_recipient_fields(p,NET_RECIPIENT_PARTY,false)==0 && ORB_FUEL==14;
}
#test "Orbit v2: hello admission names mismatched pins and never falls back to a reported body" {
  #assert orb_admit("H 2 1 1 1",true)==CP_OK && orb_admit("H 2 1 1 1",false)==CP_NO_CAPACITY;
  #assert orb_admit("H 1 1 1 1",true)==CP_WIRE_OLD && orb_admit("H 3 1 1 1",true)==CP_WIRE_NEW;
  #assert orb_admit("H 2 2 1 1",true)==CP_ENGINE && orb_admit("H 2 1 2 1",true)==CP_RULES;
  #assert orb_admit("H 2 1 1 2",true)==CP_CONTENT;
  for t:[5]string.["H","H 2 1 1","H 2 1 1 1 0","c 0 0 0","I 2 1 1 1"] {#assert orb_admit(t,true)==ORB_MALFORMED;}
}
#test "Orbit v2: controls admit every domain endpoint and refuse past each one" {
  good:=OrbInput.{ok=true,seq=1,throttle=-1000,steer=1000,flags=7,paint=31,clock=0,heard=0};
  b:[256]u8;n:=orb_input_write(good,b[..]);#assert n>0;
  r:=orb_input(cast(string)b[0..<n]);#assert r.ok && r.seq==1 && r.throttle== -1000 && r.steer==1000 && r.flags==7 && r.paint==31;
  r=orb_input("I 17 -501 702 5 29 12345 9");
  #assert r.ok && r.seq==17 && r.throttle== -501 && r.steer==702 && r.flags==5 && r.paint==29 && r.clock==12345 && r.heard==9;
  n=orb_input_write(r,b[..]);#assert cast(string)b[0..<n]=="I 17 -501 702 5 29 12345 9";
  good.throttle=1000;good.steer=-1000;good.flags=0;good.paint=0;good.seq=NET_RECORD_MAX;good.clock=NET_RECORD_MAX;good.heard=NET_RECORD_MAX;
  #assert orb_input_valid(good) && orb_input_write(good,b[..])>0;
  x:=good;x.ok=false;#assert !orb_input_valid(x);
  x=good;x.seq=0;#assert !orb_input_valid(x);x.seq=NET_RECORD_MAX+1;#assert !orb_input_valid(x);
  x=good;x.throttle=-1001;#assert !orb_input_valid(x);x.throttle=1001;#assert !orb_input_valid(x);
  x=good;x.steer=-1001;#assert !orb_input_valid(x);x.steer=1001;#assert !orb_input_valid(x);
  x=good;x.flags=-1;#assert !orb_input_valid(x);x.flags=8;#assert !orb_input_valid(x);
  x=good;x.paint=-1;#assert !orb_input_valid(x);x.paint=32;#assert !orb_input_valid(x);
  x=good;x.clock=-1;#assert !orb_input_valid(x);x.clock=NET_RECORD_MAX+1;#assert !orb_input_valid(x);
  x=good;x.heard=-1;#assert !orb_input_valid(x);x.heard=NET_RECORD_MAX+1;#assert !orb_input_valid(x);
  b[0]=99;#assert orb_input_write(x,b[..])==0 && b[0]==99;
  for t:[5]string.["I 0 0 0 0 0 0 0","I 1 0 0 0 0 0","I 1 0 0 0 0 0 0 0","c 1 0 0 0 0 0 0","I 1 1001 0 0 0 0 0"] {#assert !orb_input(t).ok;}
}
#test "Orbit v2: client record byte limits are exact" {
  b:[257]u8;for i:0..<b.count {b[i]='0';}b[0]='I';b[1]=' ';b[243]='1';
  for i:0..<6 {b[244+i*2]=' ';}
  #assert orb_input(cast(string)b[0..<256]).ok;
  #assert !orb_input(cast(string)b[..]).ok;
}
#test "Orbit v2: controls bind to admission and generation, expire by the host clock and cannot buy steps" {
  i:=OrbInput.{ok=true,seq=2};one:=SeatGeneration.{value=1};two:=SeatGeneration.{value=2};
  #assert orb_input_takes(true,one,one,i,1,1);
  #assert !orb_input_takes(false,one,one,i,1,1) && !orb_input_takes(true,one,two,i,1,1);
  #assert !orb_input_takes(true,one,one,i,2,1) && !orb_input_takes(true,one,one,i,1,2);
  i.flags=8;#assert !orb_input_takes(true,one,one,i,1,1);i.flags=0;
  #assert orb_controls_active(i,100,100) && orb_controls_active(i,100,1099);
  #assert !orb_controls_active(i,100,1100) && !orb_controls_active(i,100,99);
  i.ok=false;#assert !orb_controls_active(i,100,100);
  #assert orb_next_generation(SeatGeneration.{}).value==1;
  #assert orb_next_generation(SeatGeneration.{value=NET_RECORD_MAX-1}).value==NET_RECORD_MAX;
  #assert orb_next_generation(SeatGeneration.{value=NET_RECORD_MAX}).value==0;
  #assert orb_next_generation(SeatGeneration.{value=-1}).value==0;
  #assert orb_next_input(0)==1 && orb_next_input(NET_RECORD_MAX-1)==NET_RECORD_MAX;
  #assert orb_next_input(-1)==0 && orb_next_input(NET_RECORD_MAX)==0;
}

orb_realm :: ()->NetRealm #effects(all) {
  return NetRealm.{beat=NetProfile.{hz=60,substeps=2,trust=NET_TRUST_AUTHORITY,durable=NET_DURABLE_NONE,fair=NET_FAIR_BEAT},
    collision=NET_COLLIDE_VEHICLE,fields=ORB_FIELDS,public_fields=((1<<ORB_FIELDS)-1)^(1<<ORB_FUEL),owner_fields=(1<<ORB_FIELDS)-1};
}
orb_admit :: (text:string,initialized:bool)->int #effects(all) {
  r:=net_record_read(text);if !r.ok || r.head!='H' || r.n!=4 {return ORB_MALFORMED;}
  pins:=CompatPins.{engine=r.v[1],rules=r.v[2],content=r.v[3],wire=r.v[0]};
  server:=CompatServer.{pins=CompatPins.{engine=1,rules=1,content=1,wire=ORB_VERSION},wire_min=ORB_VERSION};
  return net_session_admit(server,pins,initialized);
}
orb_input_valid :: (i:OrbInput)->bool #effects(all) {
  return i.ok && i.seq>0 && i.seq<=NET_RECORD_MAX && i.throttle>= -1000 && i.throttle<=1000
    && i.steer>= -1000 && i.steer<=1000 && i.flags>=0 && i.flags<=7 && i.paint>=0 && i.paint<32
    && i.clock>=0 && i.clock<=NET_RECORD_MAX && i.heard>=0 && i.heard<=NET_RECORD_MAX;
}
orb_input :: (text:string)->OrbInput #effects(all) {
  if text.count>ORB_CLIENT_BYTES {return OrbInput.{};}
  r:=net_record_read(text);if !r.ok || r.head!='I' || r.n!=7 {return OrbInput.{};}
  out:=OrbInput.{ok=true,seq=r.v[0],throttle=r.v[1],steer=r.v[2],flags=r.v[3],paint=r.v[4],clock=r.v[5],heard=r.v[6]};
  if !orb_input_valid(out) {return OrbInput.{};}return out;
}
orb_input_write :: (i:OrbInput,out:[]u8)->int #effects(all) {
  if !orb_input_valid(i) {return 0;}
  v:=[7]int.[i.seq,i.throttle,i.steer,i.flags,i.paint,i.clock,i.heard];return net_record_write('I',v[..],out);
}
orb_input_takes :: (admitted:bool,expected:SeatGeneration,actual:SeatGeneration,i:OrbInput,accepted:int,pending:int)->bool #effects(all) {
  return admitted && net_session_current(expected,actual) && orb_input_valid(i) && net_command_newer(i.seq,accepted,pending);
}
orb_controls_active :: (i:OrbInput,heard_ms:int,now:int)->bool #effects(all) {
  return i.ok && now>=heard_ms && now-heard_ms<ORB_INPUT_STALE_MS;
}
orb_next_generation :: (previous:SeatGeneration)->SeatGeneration #effects(all) {
  if previous.value<0 || previous.value>=NET_RECORD_MAX {return SeatGeneration.{};}
  return SeatGeneration.{value=add_sat(previous.value,1)};
}
orb_next_input :: (previous:int)->int #effects(all) {
  if previous<0 || previous>=NET_RECORD_MAX {return 0;}return add_sat(previous,1);
}
