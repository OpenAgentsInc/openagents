// A realm's network profile: what a room host runs each realm by (GitHub #12845, gap analysis G10).
// One host serves several realms on one beat, and each realm selects, rather than copies:
// - timing: the rate its world steps (hz, a divisor of the host's NET_BEAT_HZ) and the physics
//   steps each of those takes (substeps);
// - trust: who decides what happened. NET_TRUST_AUTHORITY: the room steps the world and the
//   clients send commands. NET_TRUST_PRESENCE: each client asserts its own place and the room relays
//   it. NET_TRUST_LOCKSTEP: a small game's clients step the same inputs together. They are separate
//   profiles: presence and lockstep never qualify a realm for authoritative play;
// - durability: NET_DURABLE_NONE (the world ends with the room), or NET_DURABLE_RECEIPTS (progression
//   is posted and a route or a release waits for its receipt). Only an authoritative realm is
//   durable: a self-asserted place can't be progression;
// - fairness: NET_FAIR_BEAT (every seat steps on the host's beat), or NET_FAIR_EARNED (each seat
//   earns its steps by the clock, so a stalled socket gains nothing when it catches up).
// The room server declares Orbit League's and Everglade's (coax/web/room/room.coax rm_profile) and
// its host steps each realm when net_due says (room-host.c).
//   coax/bin/coax test metaverse-engine/net/profile.coax --library
//   coax/bin/coax mutate metaverse-engine/net/profile.coax --library --root-only

#module "metaverse.engine.net.profile";
#authority;

// book:begin net-profile
NET_BEAT_HZ :: 60;        // a room host's beat

NET_TRUST_AUTHORITY :: 1; NET_TRUST_PRESENCE :: 2; NET_TRUST_LOCKSTEP :: 3;
NET_DURABLE_NONE :: 0; NET_DURABLE_RECEIPTS :: 1;
NET_FAIR_BEAT :: 0; NET_FAIR_EARNED :: 1;

NetProfile :: struct {
  hz: int;          // world steps a second
  substeps: int;    // physics steps in each world step
  trust: int;
  durable: int;
  fair: int;
}
// book:end net-profile

// book:begin net-rules
// Whether a profile can run: a rate the beat divides, at least one physics step, a known trust,
// durability only with authority, and earned steps only where the room steps the world.
net_profile_ok :: (p: NetProfile) -> bool #effects(all) {
  if p.hz <= 0 || NET_BEAT_HZ % p.hz != 0 { return false; }
  if p.substeps < 1 { return false; }
  if p.trust < NET_TRUST_AUTHORITY || p.trust > NET_TRUST_LOCKSTEP { return false; }
  if p.durable != NET_DURABLE_NONE && (p.durable != NET_DURABLE_RECEIPTS || p.trust != NET_TRUST_AUTHORITY) { return false; }
  if p.fair != NET_FAIR_BEAT && (p.fair != NET_FAIR_EARNED || p.trust != NET_TRUST_AUTHORITY) { return false; }
  return true;
}
// Whether a realm's world steps on beat number `beat` (from 0). A profile that can't run never does.
net_due :: (p: NetProfile, beat: int) -> bool #effects(all) {
  if !net_profile_ok(p) || beat < 0 { return false; }
  return beat % (NET_BEAT_HZ / p.hz) == 0;
}
// Whether a realm's play qualifies as authoritative (the room decides): presence and lockstep don't.
net_authoritative :: (p: NetProfile) -> bool #effects(all) { return net_profile_ok(p) && p.trust == NET_TRUST_AUTHORITY; }
// book:end net-rules

// ---- checks

#test "net profile: a profile runs only at a rate the beat divides, with a step, a known trust and durability under authority" {
  a := NetProfile.{hz = 30, substeps = 1, trust = NET_TRUST_AUTHORITY, durable = NET_DURABLE_RECEIPTS, fair = NET_FAIR_EARNED};
  #assert net_profile_ok(a) && net_authoritative(a);
  b := a; b.hz = 60; #assert net_profile_ok(b);
  b = a; b.hz = 1; #assert net_profile_ok(b);
  b = a; b.hz = 0; #assert !net_profile_ok(b) && !net_authoritative(b);
  b = a; b.hz = 120; #assert !net_profile_ok(b);
  b = a; b.hz = 61; #assert !net_profile_ok(b);
  b = a; b.hz = 25; #assert !net_profile_ok(b);
  b = a; b.hz = -30; #assert !net_profile_ok(b);
  b = a; b.substeps = 0; #assert !net_profile_ok(b);
  b = a; b.substeps = 2; #assert net_profile_ok(b);
  b = a; b.trust = 0; #assert !net_profile_ok(b);
  b = a; b.trust = 4; #assert !net_profile_ok(b);
  b = a; b.durable = 2; #assert !net_profile_ok(b);
  b = a; b.fair = 2; #assert !net_profile_ok(b);
  // presence and lockstep: neither durable nor earned, and never authoritative
  for t: 2..<4 {
    b = a; b.trust = t; #assert !net_profile_ok(b);
    b.durable = NET_DURABLE_NONE; #assert !net_profile_ok(b);
    b.fair = NET_FAIR_BEAT; #assert net_profile_ok(b) && !net_authoritative(b);
    b.durable = NET_DURABLE_RECEIPTS; #assert !net_profile_ok(b);
  }
  for t: 0..<6 {
    b = a; b.trust = t; b.durable = NET_DURABLE_NONE; b.fair = NET_FAIR_BEAT;
    #assert net_profile_ok(b) == (t >= 1 && t <= 3);
  }
  c := a; c.durable = NET_DURABLE_NONE; c.fair = NET_FAIR_BEAT; #assert net_profile_ok(c) && net_authoritative(c);
}

#test "net profile: each realm steps at its own rate on one beat" {
  fast := NetProfile.{hz = 60, substeps = 2, trust = NET_TRUST_AUTHORITY};
  half := NetProfile.{hz = 30, substeps = 1, trust = NET_TRUST_AUTHORITY, durable = NET_DURABLE_RECEIPTS, fair = NET_FAIR_EARNED};
  tenth := NetProfile.{hz = 6, substeps = 1, trust = NET_TRUST_PRESENCE};
  nf := 0; nh := 0; nt := 0;
  for beat: 0..<NET_BEAT_HZ { if net_due(fast, beat) { nf += 1; } if net_due(half, beat) { nh += 1; } if net_due(tenth, beat) { nt += 1; } }
  #assert nf == 60 && nh == 30 && nt == 6;
  #assert net_due(half, 0) && !net_due(half, 1) && net_due(half, 2) && net_due(tenth, 10) && !net_due(tenth, 9);
  #assert !net_due(half, -2);
  once := tenth; once.hz = 1;
  #assert net_due(once, 0) && net_due(once, 60) && !net_due(once, 59) && !net_due(once, 61);
  bad := half; bad.hz = 7;
  #assert !net_due(bad, 0);
}
