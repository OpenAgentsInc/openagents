// Projectiles over a room (#13157): one thing loosed by a player (an arrow, a bolt) that the room
// simulates and every page draws. The realm keeps its flight (Everglade's arrows: metaverse-engine/action/
// bow.coax) and its rules; this file is what the page and the room say to each other, and the
// bodies' past the room rewinds to (rewind.coax holds the bounds).
//
// The player's page draws its own projectile the frame it is loosed, from the same flight code the
// room runs, and tells the room. The room checks the launch against where it has the player, flies
// the projectile itself, and names it: every page hears the launch with its id, and later its end.
// The page that loosed it matches the room's by the request's number and takes the room's flight
// in place of its own guess; the others draw it from the room's word, the same delay behind as
// they draw its archer. Nothing a page decides here harms anyone: the room's flight decides.
//
// Three records (record.coax: whole numbers a space apart; mm, mm/s, thousandths, ms):
//   F SEQ FX FY FZ TX TY TZ ST VIEW             page to room, just before the action's own request
//       of the same SEQ: where it left (the hand), the point it was aimed at, how strongly it was
//       drawn, and the moment of the room's world the page was drawing the others at then (ms of
//       the room's ticks: tick * 1000 / hz; its low nine digits). The room flies it from that
//       moment: the steps it missed are taken at once, each against the bodies as they stood then
//       (the bodies' past, below), so what the archer's page showed is what the room judges, within
//       rewind.coax's bound
//   a TICK ID SEAT SEQ FX FY FZ VX VY VZ ST AGE  room to pages: projectile ID left SEAT's hand
//       AGE ms before TICK, at this velocity (SEQ: that seat's request, for its own page's match)
//   d TICK ID KIND X Y Z DX DY DZ BODY           room to pages: it ended during TICK: KIND 1 stuck
//       in the ground or a wall at (X, Y, Z) pointing (DX, DY, DZ), 2 in body BODY (a realm's id), 3 gone
//   coax/bin/coax test metaverse-engine/net/projectile.coax
#module "aethyr.net.projectile";
#load "record.coax";
#load "rewind.coax";

NET_SHOT_STUCK :: 1; NET_SHOT_BODY :: 2; NET_SHOT_GONE :: 3;
NET_SHOT_FAR :: 2000000;     // mm: no launch, aim or end farther than 2 km from the origin
NET_SHOT_FAST :: 200000;     // mm/s: no flight faster than 200 m/s

NetLoose :: struct { ok: bool; seq: int; from: [3] f32; to: [3] f32; strength: f32; view_ms: int; }
NetShot :: struct { ok: bool; tick: int; id: int; seat: int; seq: int; from: [3] f32; vel: [3] f32; strength: f32; age_ms: int; }
NetShotEnd :: struct { ok: bool; tick: int; id: int; kind: int; at: [3] f32; dir: [3] f32; body: int = -1; }

net_shot_mm :: (v: f32) -> int { if !(v == v) || v > 1.0e7 || v < -1.0e7 { return 0; } return cast(int) floor(v * 1000 + 0.5); }
net_shot_m :: (v: int) -> f32 { return f32(v) / 1000; }
net_shot_near :: (v: int, most: int) -> bool { return v >= -most && v <= most; }

net_loose_write :: (l: NetLoose, out: [] u8) -> int {
  v := [9] int.[l.seq, net_shot_mm(l.from[0]), net_shot_mm(l.from[1]), net_shot_mm(l.from[2]), net_shot_mm(l.to[0]), net_shot_mm(l.to[1]), net_shot_mm(l.to[2]),
    net_shot_mm(l.strength), (ifx l.view_ms > 0 then l.view_ms else 0) % 1000000000];
  return net_record_write('F', v[..], out);
}
// A page's launch as the room reads it: refused whole when a field is missing, out of the world or not a draw.
net_loose_read :: (t: string) -> NetLoose {
  r := net_record_read(t); l: NetLoose;
  if !r.ok || r.head != 'F' || r.n != 9 || r.v[0] <= 0 { return l; }
  for i: 1..<7 { if !net_shot_near(r.v[i], NET_SHOT_FAR) { return l; } }
  if r.v[7] < 0 || r.v[7] > 1000 || r.v[8] < 0 { return l; }
  l.ok = true; l.seq = r.v[0];
  l.from = [3] f32.[net_shot_m(r.v[1]), net_shot_m(r.v[2]), net_shot_m(r.v[3])];
  l.to = [3] f32.[net_shot_m(r.v[4]), net_shot_m(r.v[5]), net_shot_m(r.v[6])];
  l.strength = net_shot_m(r.v[7]); l.view_ms = r.v[8];
  return l;
}
// The moment (ms of the room's ticks) that a page's VIEW names: its low nine digits, taken as the one nearest now.
net_loose_view :: (now_ms: int, sent: int) -> int {
  base := now_ms - now_ms % 1000000000 + sent;
  if base - now_ms > 500000000 { base -= 1000000000; }
  if now_ms - base > 500000000 { base += 1000000000; }
  return base;
}
net_shot_write :: (s: NetShot, out: [] u8) -> int {
  v := [12] int.[s.tick, s.id, s.seat, s.seq, net_shot_mm(s.from[0]), net_shot_mm(s.from[1]), net_shot_mm(s.from[2]),
    net_shot_mm(s.vel[0]), net_shot_mm(s.vel[1]), net_shot_mm(s.vel[2]), net_shot_mm(s.strength), s.age_ms];
  return net_record_write('a', v[..], out);
}
net_shot_read :: (t: string) -> NetShot {
  r := net_record_read(t); s: NetShot;
  if !r.ok || r.head != 'a' || r.n != 12 || r.v[0] < 0 || r.v[1] <= 0 || r.v[2] < 0 || r.v[2] >= 64 || r.v[3] < 0 { return s; }
  for i: 4..<7 { if !net_shot_near(r.v[i], NET_SHOT_FAR) { return s; } }
  for i: 7..<10 { if !net_shot_near(r.v[i], NET_SHOT_FAST) { return s; } }
  if r.v[10] < 0 || r.v[10] > 1000 || r.v[11] < 0 || r.v[11] > NET_REWIND_AGE_MS { return s; }
  s.ok = true; s.tick = r.v[0]; s.id = r.v[1]; s.seat = r.v[2]; s.seq = r.v[3];
  s.from = [3] f32.[net_shot_m(r.v[4]), net_shot_m(r.v[5]), net_shot_m(r.v[6])];
  s.vel = [3] f32.[net_shot_m(r.v[7]), net_shot_m(r.v[8]), net_shot_m(r.v[9])];
  s.strength = net_shot_m(r.v[10]); s.age_ms = r.v[11];
  return s;
}
net_shot_end_write :: (e: NetShotEnd, out: [] u8) -> int {
  v := [10] int.[e.tick, e.id, e.kind, net_shot_mm(e.at[0]), net_shot_mm(e.at[1]), net_shot_mm(e.at[2]),
    net_shot_mm(e.dir[0]), net_shot_mm(e.dir[1]), net_shot_mm(e.dir[2]), e.body];
  return net_record_write('d', v[..], out);
}
net_shot_end_read :: (t: string) -> NetShotEnd {
  r := net_record_read(t); e: NetShotEnd;
  if !r.ok || r.head != 'd' || r.n != 10 || r.v[0] < 0 || r.v[1] <= 0 || r.v[2] < NET_SHOT_STUCK || r.v[2] > NET_SHOT_GONE { return e; }
  for i: 3..<6 { if !net_shot_near(r.v[i], NET_SHOT_FAR) { return e; } }
  for i: 6..<9 { if !net_shot_near(r.v[i], 1000) { return e; } }
  if r.v[9] < -1 || r.v[9] > 100000 { return e; }
  e.ok = true; e.tick = r.v[0]; e.id = r.v[1]; e.kind = r.v[2];
  e.at = [3] f32.[net_shot_m(r.v[3]), net_shot_m(r.v[4]), net_shot_m(r.v[5])];
  e.dir = [3] f32.[net_shot_m(r.v[6]), net_shot_m(r.v[7]), net_shot_m(r.v[8])];
  e.body = r.v[9];
  return e;
}

// ---- the bodies' past: where each of a realm's bodies stood at each of the last NET_REWIND_TICKS
// ticks, so a flight stepped for a past moment meets them where the archer's page drew them.
NET_PAST_BODIES :: 16;
NetPastRow :: struct { tick: int = -1; up: [NET_PAST_BODIES] bool; x: [NET_PAST_BODIES] f32; z: [NET_PAST_BODIES] f32; }
NetPast :: struct { row: [NET_REWIND_TICKS] NetPastRow; newest: int = -1; kept: int; }
// The tick's row begun (every body down until net_past_put says where it stands).
net_past_begin :: (p: [] NetPast, tick: int) {
  if tick <= p[0].newest { return; }
  p[0].row[tick % NET_REWIND_TICKS] = NetPastRow.{tick = tick};
  // a gap (a paused room) leaves no rows between: what was kept before it is let go
  if p[0].newest >= 0 && tick != p[0].newest + 1 { p[0].kept = 0; }
  p[0].newest = tick; if p[0].kept < NET_REWIND_TICKS { p[0].kept += 1; }
}
net_past_put :: (p: [] NetPast, body: int, x: f32, z: f32) {
  if body < 0 || body >= NET_PAST_BODIES || p[0].newest < 0 { return; }
  r := p[0].row[p[0].newest % NET_REWIND_TICKS..<p[0].newest % NET_REWIND_TICKS + 1];
  r[0].up[body] = true; r[0].x[body] = x; r[0].z[body] = z;
}
// Where body stood `back` ticks before `tick` (rewind.coax net_rewind_tick: inside what is kept).
NetPastAt :: struct { up: bool; x: f32; z: f32; tick: int; }
net_past_at :: (p: [] NetPast, body: int, tick: int, back: int) -> NetPastAt {
  if body < 0 || body >= NET_PAST_BODIES || p[0].newest < 0 || p[0].kept <= 0 { return NetPastAt.{tick = -1}; }
  t := net_rewind_tick(tick, back, p[0].newest, p[0].kept);
  r := p[0].row[t % NET_REWIND_TICKS];
  if r.tick != t { return NetPastAt.{tick = -1}; }
  return NetPastAt.{up = r.up[body], x = r.x[body], z = r.z[body], tick = t};
}

#test "projectile: a launch, a flight and an end survive the wire; a bad one is refused whole" {
  b: [256] u8;
  n := net_loose_write(NetLoose.{seq = 7, from = [3] f32.[1.5, 1.45, -20.25], to = [3] f32.[3, 0.5, -60], strength = 0.8, view_ms = 1794000123456}, b[..]);
  #assert cast(string) b[0..<n] == "F 7 1500 1450 -20250 3000 500 -60000 800 123456";
  l := net_loose_read(cast(string) b[0..<n]);
  #assert l.ok && l.seq == 7 && abs(l.from[2] + 20.25) < 0.001 && abs(l.to[2] + 60) < 0.001 && abs(l.strength - 0.8) < 0.001 && l.view_ms == 123456;
  #assert !net_loose_read("F 0 0 0 0 0 0 0 800 1").ok && !net_loose_read("F 7 0 0 0 0 0 0 1001 1").ok && !net_loose_read("F 7 0 0 0 0 0 0 -1 1").ok;
  #assert !net_loose_read("F 7 2000001 0 0 0 0 0 800 1").ok && !net_loose_read("F 7 0 0 0 0 0 800 1").ok && !net_loose_read("C 7 0 0 0 0 0 0 800 1").ok && !net_loose_read("F 7 0 0 0 0 0 0 800 -1").ok;
  #assert net_loose_read("F 7 2000000 0 0 0 0 -2000000 0 0").ok;
  n = net_shot_write(NetShot.{tick = 900, id = 12, seat = 3, seq = 7, from = [3] f32.[1.5, 1.45, -20.25], vel = [3] f32.[2, 4.5, -40], strength = 1, age_ms = 66}, b[..]);
  #assert cast(string) b[0..<n] == "a 900 12 3 7 1500 1450 -20250 2000 4500 -40000 1000 66";
  s := net_shot_read(cast(string) b[0..<n]);
  #assert s.ok && s.tick == 900 && s.id == 12 && s.seat == 3 && s.seq == 7 && abs(s.vel[2] + 40) < 0.001 && s.strength == 1 && s.age_ms == 66;
  #assert !net_shot_read("a 900 0 3 7 0 0 0 0 0 0 1000 0").ok && !net_shot_read("a 900 12 64 7 0 0 0 0 0 0 1000 0").ok && !net_shot_read("a 900 12 3 7 0 0 0 200001 0 0 1000 0").ok;
  #assert !net_shot_read("a 900 12 3 7 0 0 0 0 0 0 1000 251").ok && !net_shot_read("a 900 12 3 7 0 0 0 0 0 0 1000").ok && !net_shot_read("d 900 12 3 7 0 0 0 0 0 0 1000 0").ok;
  n = net_shot_end_write(NetShotEnd.{tick = 915, id = 12, kind = NET_SHOT_BODY, at = [3] f32.[3, 0.9, -60], dir = [3] f32.[0.05, -0.1, -0.994], body = 5}, b[..]);
  #assert cast(string) b[0..<n] == "d 915 12 2 3000 900 -60000 50 -100 -994 5";
  e := net_shot_end_read(cast(string) b[0..<n]);
  #assert e.ok && e.tick == 915 && e.id == 12 && e.kind == NET_SHOT_BODY && abs(e.at[1] - 0.9) < 0.001 && abs(e.dir[2] + 0.994) < 0.001 && e.body == 5;
  #assert !net_shot_end_read("d 915 12 0 0 0 0 0 0 0 -1").ok && !net_shot_end_read("d 915 12 4 0 0 0 0 0 0 -1").ok && !net_shot_end_read("d 915 12 1 0 0 0 1001 0 0 -1").ok;
  #assert net_shot_end_read("d 915 12 3 0 0 0 0 0 0 -1").ok && !net_shot_end_read("d 915 12 1 0 0 0 0 0 0 -2").ok;
}
#test "projectile: a page's VIEW is the moment nearest now" {
  #assert net_loose_view(1794000123500, 123456) == 1794000123456;
  #assert net_loose_view(1794000123400, 123456) == 1794000123456;          // a little ahead
  #assert net_loose_view(1795000000010, 999999990) == 1794999999990;       // across the nine digits' turn
  #assert net_loose_view(1794999999990, 10) == 1795000000010;
}
#test "projectile: the bodies' past is read inside what was kept, and a gap forgets it" {
  p: [1] NetPast;
  #assert net_past_at(p[..], 0, 10, 0).tick == -1;
  for t: 100..<130 { net_past_begin(p[..], t); net_past_put(p[..], 2, f32(t), -f32(t)); if t >= 120 { net_past_put(p[..], 3, 1, 1); } }
  a := net_past_at(p[..], 2, 129, 0); #assert a.up && a.x == 129 && a.z == -129 && a.tick == 129;
  a = net_past_at(p[..], 2, 129, 5); #assert a.up && a.x == 124;
  a = net_past_at(p[..], 2, 129, 400); #assert a.up && a.x == f32(129 - NET_REWIND_TICKS + 1);   // no further than what is kept
  a = net_past_at(p[..], 3, 129, 12); #assert !a.up && a.tick == 117;                                 // it was not up then
  a = net_past_at(p[..], 3, 129, 2); #assert a.up;
  #assert !net_past_at(p[..], 4, 129, 0).up && net_past_at(p[..], NET_PAST_BODIES, 129, 0).tick == -1 && net_past_at(p[..], -1, 129, 0).tick == -1;
  net_past_begin(p[..], 129); #assert net_past_at(p[..], 2, 129, 0).up;      // the same tick again changes nothing
  net_past_begin(p[..], 200); net_past_put(p[..], 2, 9, 9);                   // a gap: only the new tick is kept
  a = net_past_at(p[..], 2, 200, 5); #assert a.up && a.x == 9 && a.tick == 200;
}
