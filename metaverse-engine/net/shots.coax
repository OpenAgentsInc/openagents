// Arrows over a room (#13157): which of a page's arrows the room has named, and how the room's word
// moves them. Any realm whose arrows the room flies (metaverse-engine/net/projectile.coax) keeps one NetShots
// beside its arrows (metaverse-engine/action/bow.coax Arrows) and calls these; the realm still draws, aims,
// sounds and decides nothing here.
//   loose   yours is drawn the frame you let go, under its request's number (net_shots_loosed)
//   named   the room's a: yours takes the room's flight, the difference eased out of the drawing
//           (net_shots_offset) and kept (fix_mm); another's is loosed from the room's word, as far
//           into its flight as the picture already is past the moment it left
//   ended   the room's d: stuck where it says, in a body, or gone
//   undone  the room refused your request or never answered: the arrow fades out where it is
// The room's flight and the room's rules decide every hit; nothing here harms anyone.
//   coax/bin/coax test metaverse-engine/net/shots.coax
#module "metaverse.engine.net.shots";
#load "projectile.coax";
#load "../action/bow.coax" as bow;

NET_SHOT_MINE :: 0;          // your arrows' owner (bow.Arrow.owner); another's is 1 + its seat
NET_SHOT_LOST :: 64;         // the owner of an arrow this page only heard had stuck
NET_SHOT_FADE :: 0.25;       // s a refused arrow fades over
NET_SHOT_EASE :: 0.12;       // s the room's flight is eased into from yours
NET_SHOT_LATE_MS :: 2000;    // another's arrow is placed at most this far into its flight
NET_SHOT_BOUND_MS :: 400;    // yours left later than this page's moment by at most this (rewind.coax NET_REWIND_VIEW_MS)

// One arrow slot's word from the room: its id there (0 until named), your request's number (yours
// only), whether the room took it, when it began to fade (-1 it doesn't), the room's flight's
// distance from yours when named and when, and the moment the page was drawing when it loosed it
// (ms, the page's clock of the room).
NetShotTag :: struct { id: int; seq: int; taken: bool; fade_at: f32 = -1; off: [3] f32; off_at: f32 = -100; view: int; }
// What a named or ended word did, for the realm's sounds and puffs.
NET_SHOT_DID_NONE :: 0; NET_SHOT_DID_MINE :: 1; NET_SHOT_DID_OTHER :: 2; NET_SHOT_DID_STUCK :: 3; NET_SHOT_DID_BODY :: 4;
NetShots :: struct {
  tag: [bow.ARROWS] NetShotTag;
  // counts the checks read: yours loosed, the others' drawn, landed here (stuck or in a body), yours
  // the room named, the last of those's distance (mm), and refused ones faded
  loosed: int; others: int; landed: int; named: int; fix_mm: int = -1; undone: int;
}

ns_clamp :: (v: int, lo: int, hi: int) -> int { return ifx v < lo then lo else ifx v > hi then hi else v; }
ns_sat :: (v: f32) -> f32 { return ifx v < 0 then 0.0f32 else ifx v > 1 then 1.0f32 else v; }

// Your arrow of request `seq`: its slot, -1 none.
net_shots_mine :: (sh: [] NetShots, p: [] bow.Arrows, seq: int) -> int {
  if seq <= 0 { return -1; }
  for i: 0..<bow.ARROWS { a := p[0].a[i]; if a.state != bow.ARROW_FREE && a.owner == NET_SHOT_MINE && sh[0].tag[i].seq == seq { return i; } }
  return -1;
}
// The arrow the room calls `id`: its slot, -1 none.
net_shots_by_id :: (sh: [] NetShots, p: [] bow.Arrows, id: int) -> int {
  if id <= 0 { return -1; }
  for i: 0..<bow.ARROWS { if p[0].a[i].state != bow.ARROW_FREE && sh[0].tag[i].id == id { return i; } }
  return -1;
}
// Your arrow, loosed into slot i under request `seq` while the page drew the room's moment `view`.
net_shots_loosed :: (sh: [] NetShots, i: int, seq: int, view: int) {
  if i < 0 || i >= bow.ARROWS { return; }
  sh[0].tag[i] = NetShotTag.{seq = seq, view = view}; sh[0].loosed += 1;
}
// The room took your request (its cast): the arrow of that request stays.
net_shots_taken :: (sh: [] NetShots, p: [] bow.Arrows, seq: int) { i := net_shots_mine(sh, p, seq); if i >= 0 { sh[0].tag[i].taken = true; } }
// The room refused it, or never answered: the arrow fades out where it is. True when it began to.
net_shots_undo :: (sh: [] NetShots, p: [] bow.Arrows, seq: int, now: f32) -> bool {
  i := net_shots_mine(sh, p, seq);
  if i < 0 || sh[0].tag[i].taken || sh[0].tag[i].id > 0 || sh[0].tag[i].fade_at >= 0 { return false; }
  sh[0].tag[i].fade_at = now; sh[0].undone += 1;
  return true;
}
// How much of arrow i shows: 1, or less while a refused one fades.
net_shots_shown :: (sh: [] NetShots, i: int, now: f32) -> f32 {
  f := sh[0].tag[i].fade_at; if f < 0 { return 1; }
  u := ns_sat((now - f) / f32(NET_SHOT_FADE)); return 1 - u * u * (3 - 2 * u);
}
// Where arrow i is drawn off the room's flight now: the distance at the room's word, eased out.
net_shots_offset :: (sh: [] NetShots, i: int, now: f32) -> [3] f32 {
  t := sh[0].tag[i]; k := 1 - ns_sat((now - t.off_at) / f32(NET_SHOT_EASE));
  return [3] f32.[t.off[0] * k, t.off[1] * k, t.off[2] * k];
}
// The room named an arrow (a), heard by the page seated at `seat`, whose picture is at the room's
// moment `rt`; it left at `left_ms` there. What it did.
net_shots_named :: (sh: [] NetShots, p: [] bow.Arrows, w: NetShot, left_ms: int, seat: int, rt: int, now: f32) -> int {
  if net_shots_by_id(sh, p, w.id) >= 0 { return NET_SHOT_DID_NONE; }
  mine := w.seat == seat;
  late := f32(ns_clamp(rt - left_ms, 0, NET_SHOT_LATE_MS)) / 1000;
  if mine {
    i := net_shots_mine(sh, p, w.seq);
    if i >= 0 && p[0].a[i].state == bow.ARROW_FLYING {
      // the room flew it from the moment this page was drawing: its start is this page's own,
      // unless the room's bound cut it short, and then it left that much later
      a := p[0].a[i..<i + 1];
      was := bow.arrow_pos(a[0], now - a[0].t0);
      a[0].from = w.from; a[0].vel = w.vel; a[0].strength = w.strength;
      a[0].t0 = a[0].t0 + f32(ns_clamp(left_ms - sh[0].tag[i].view, 0, NET_SHOT_BOUND_MS)) / 1000;
      is := bow.arrow_pos(a[0], now - a[0].t0);
      off := [3] f32.[was[0] - is[0], was[1] - is[1], was[2] - is[2]];
      sh[0].fix_mm = cast(int)(sqrt(off[0] * off[0] + off[1] * off[1] + off[2] * off[2]) * 1000);
      sh[0].tag[i].id = w.id; sh[0].tag[i].taken = true; sh[0].tag[i].fade_at = -1; sh[0].tag[i].off = off; sh[0].tag[i].off_at = now;
      sh[0].named += 1;
      return NET_SHOT_DID_MINE;
    }
    // it already landed here: the room's end puts it right
    if i >= 0 { sh[0].tag[i].id = w.id; sh[0].tag[i].taken = true; sh[0].named += 1; sh[0].fix_mm = 0; return NET_SHOT_DID_MINE; }
  }
  // another's (or yours this page never drew: a page that joined mid-flight)
  i := bow.arrow_loose(p, ifx mine then NET_SHOT_MINE else 1 + w.seat, w.from, w.vel, now - late, -1, w.strength);
  sh[0].tag[i] = NetShotTag.{id = w.id, seq = ifx mine then w.seq else 0, taken = true};
  if mine { return NET_SHOT_DID_MINE; }
  sh[0].others += 1;
  return NET_SHOT_DID_OTHER;
}
// The room's word on where an arrow ended (d). What it did: STUCK when it newly stands where the room
// says (its dust and thunk are the realm's), BODY when it ended in one while this page still flew it.
net_shots_ended :: (sh: [] NetShots, p: [] bow.Arrows, w: NetShotEnd, now: f32) -> int {
  i := net_shots_by_id(sh, p, w.id);
  if w.kind == NET_SHOT_STUCK {
    fresh := i < 0 || p[0].a[i].state == bow.ARROW_FLYING;
    if i < 0 {   // this page let it go (it took it for a hit, or never heard it loosed): it stands where the room says
      i = bow.arrow_loose(p, NET_SHOT_LOST, w.at, [3] f32.[0, 0, 0], now, -1, 1); sh[0].tag[i] = NetShotTag.{id = w.id, taken = true};
    }
    a := p[0].a[i..<i + 1];
    a[0].state = bow.ARROW_STUCK; a[0].at = w.at; a[0].dir = w.dir;
    if !fresh { return NET_SHOT_DID_NONE; }
    a[0].end = now; a[0].last = now; sh[0].landed += 1;
    return NET_SHOT_DID_STUCK;
  }
  if i < 0 { return NET_SHOT_DID_NONE; }
  did := NET_SHOT_DID_NONE;
  if w.kind == NET_SHOT_BODY && p[0].a[i].state == bow.ARROW_FLYING { sh[0].landed += 1; did = NET_SHOT_DID_BODY; }
  if p[0].a[i].state == bow.ARROW_FLYING || w.kind == NET_SHOT_GONE { p[0].a[i] = bow.Arrow.{}; sh[0].tag[i] = NetShotTag.{}; }
  return did;
}
// The frame's end: faded ones let go, and a free slot's word forgotten.
net_shots_tidy :: (sh: [] NetShots, p: [] bow.Arrows, now: f32) {
  for i: 0..<bow.ARROWS {
    if p[0].a[i].state != bow.ARROW_FREE && sh[0].tag[i].fade_at >= 0 && net_shots_shown(sh, i, now) <= 0 { p[0].a[i] = bow.Arrow.{}; }
    if p[0].a[i].state == bow.ARROW_FREE { sh[0].tag[i] = NetShotTag.{}; }
  }
}
// Arrows in the air or stuck now.
net_shots_up :: (p: [] bow.Arrows) -> int {
  c := 0; for i: 0..<bow.ARROWS { st := p[0].a[i].state; if st == bow.ARROW_FLYING || st == bow.ARROW_STUCK { c += 1; } }
  return c;
}

#test "net shots: yours is matched by its request, takes the room's flight eased, and a refused one fades" {
  sh: [1] NetShots; p: [1] bow.Arrows;
  i := bow.arrow_loose(p[..], NET_SHOT_MINE, [3] f32.[0, 1.5, 0], [3] f32.[0, 0, 40], 10, -1, 1);
  net_shots_loosed(sh[..], i, 7, 5000);
  #assert sh[0].loosed == 1 && net_shots_mine(sh[..], p[..], 7) == i && net_shots_mine(sh[..], p[..], 8) < 0 && net_shots_mine(sh[..], p[..], 0) < 0;
  // the room's word: the same arrow from 10 cm to the side, its bound 100 ms later than this page's moment
  w := NetShot.{ok = true, id = 3, seat = 2, seq = 7, from = [3] f32.[0.1, 1.5, 0], vel = [3] f32.[0, 0, 40], strength = 1};
  #assert net_shots_named(sh[..], p[..], w, 5100, 2, 5150, 10.2) == NET_SHOT_DID_MINE;
  #assert sh[0].named == 1 && sh[0].tag[i].id == 3 && sh[0].tag[i].taken && abs(p[0].a[i].t0 - 10.1) < 0.001 && p[0].a[i].from[0] == 0.1f32;
  #assert sh[0].fix_mm > 3950 && sh[0].fix_mm < 4050;   // 10 cm aside and 0.1 s behind at 40 m/s: about 4 m
  o := net_shots_offset(sh[..], i, 10.2); #assert abs(o[2] - 4) < 0.05 && abs(o[0] + 0.1) < 0.01;
  o = net_shots_offset(sh[..], i, 10.2 + f32(NET_SHOT_EASE) / 2); #assert o[2] > 1 && o[2] < 3;
  o = net_shots_offset(sh[..], i, 10.2 + f32(NET_SHOT_EASE) + 0.01); #assert o[0] == 0 && o[2] == 0;   // eased out
  #assert net_shots_by_id(sh[..], p[..], 3) == i && net_shots_named(sh[..], p[..], w, 5100, 2, 5150, 10.3) == NET_SHOT_DID_NONE && sh[0].named == 1;
  #assert !net_shots_undo(sh[..], p[..], 7, 10.4);   // taken: it stays
  // a second, refused: it fades over NET_SHOT_FADE and is let go
  j := bow.arrow_loose(p[..], NET_SHOT_MINE, [3] f32.[0, 1.5, 0], [3] f32.[0, 0, 40], 11, -1, 1);
  net_shots_loosed(sh[..], j, 8, 6000);
  #assert net_shots_shown(sh[..], j, 11) == 1 && net_shots_undo(sh[..], p[..], 8, 11) && sh[0].undone == 1 && !net_shots_undo(sh[..], p[..], 8, 11.1);
  #assert net_shots_shown(sh[..], j, 11.125) > 0.4 && net_shots_shown(sh[..], j, 11.125) < 0.6;
  net_shots_tidy(sh[..], p[..], 11.2); #assert p[0].a[j].state == bow.ARROW_FLYING;
  net_shots_tidy(sh[..], p[..], 11 + f32(NET_SHOT_FADE)); #assert p[0].a[j].state == bow.ARROW_FREE && sh[0].tag[j].seq == 0;
  #assert net_shots_up(p[..]) == 1;
  net_shots_taken(sh[..], p[..], 7); #assert sh[0].tag[i].taken;
}
#test "net shots: another's is loosed from the room's word, as far into its flight as the picture is" {
  sh: [1] NetShots; p: [1] bow.Arrows;
  w := NetShot.{ok = true, id = 9, seat = 4, seq = 2, from = [3] f32.[5, 1.5, 0], vel = [3] f32.[40, 0, 0], strength = 1};
  #assert net_shots_named(sh[..], p[..], w, 1000, 2, 1250, 20) == NET_SHOT_DID_OTHER;
  i := net_shots_by_id(sh[..], p[..], 9);
  #assert i >= 0 && sh[0].others == 1 && p[0].a[i].owner == 5 && abs(p[0].a[i].t0 - 19.75) < 0.001 && sh[0].tag[i].seq == 0;
  // a picture far past it: at most NET_SHOT_LATE_MS in; one ahead of it: none
  w.id = 10; _ := net_shots_named(sh[..], p[..], w, 1000, 2, 99000, 30); #assert abs(p[0].a[net_shots_by_id(sh[..], p[..], 10)].t0 - 28) < 0.001;
  w.id = 11; _ = net_shots_named(sh[..], p[..], w, 1000, 2, 900, 40); #assert p[0].a[net_shots_by_id(sh[..], p[..], 11)].t0 == 40;
  // yours that this page never drew (it joined mid-flight): drawn from the word, as yours
  w.id = 12; w.seat = 2; #assert net_shots_named(sh[..], p[..], w, 1000, 2, 1000, 50) == NET_SHOT_DID_MINE;
  k := net_shots_by_id(sh[..], p[..], 12); #assert p[0].a[k].owner == NET_SHOT_MINE && sh[0].tag[k].seq == 2 && sh[0].others == 3;
}
#test "net shots: the room's end sticks, strikes or removes; a page that let it go has it stand where the room says" {
  sh: [1] NetShots; p: [1] bow.Arrows;
  w := NetShot.{ok = true, id = 1, seat = 3, from = [3] f32.[0, 1.5, 0], vel = [3] f32.[0, 0, 40], strength = 1};
  _ := net_shots_named(sh[..], p[..], w, 0, 0, 0, 1);
  i := net_shots_by_id(sh[..], p[..], 1);
  e := NetShotEnd.{ok = true, id = 1, kind = NET_SHOT_STUCK, at = [3] f32.[0, 0, 20], dir = [3] f32.[0, 0, 1]};
  #assert net_shots_ended(sh[..], p[..], e, 1.5) == NET_SHOT_DID_STUCK && p[0].a[i].state == bow.ARROW_STUCK && p[0].a[i].at[2] == 20 && p[0].a[i].end == 1.5f32 && sh[0].landed == 1;
  #assert net_shots_ended(sh[..], p[..], e, 1.6) == NET_SHOT_DID_NONE && p[0].a[i].end == 1.5f32 && sh[0].landed == 1;   // said again: nothing new
  // never heard loosed: it stands where the room says
  e.id = 5; #assert net_shots_ended(sh[..], p[..], e, 2) == NET_SHOT_DID_STUCK;
  j := net_shots_by_id(sh[..], p[..], 5); #assert j >= 0 && p[0].a[j].owner == NET_SHOT_LOST && p[0].a[j].state == bow.ARROW_STUCK;
  // in a body while still flying here: struck, and gone
  w.id = 2; _ = net_shots_named(sh[..], p[..], w, 0, 0, 0, 3); k := net_shots_by_id(sh[..], p[..], 2);
  b := NetShotEnd.{ok = true, id = 2, kind = NET_SHOT_BODY, at = [3] f32.[0, 1, 10], body = 4};
  #assert net_shots_ended(sh[..], p[..], b, 3.2) == NET_SHOT_DID_BODY && p[0].a[k].state == bow.ARROW_FREE && sh[0].landed == 3;
  #assert net_shots_ended(sh[..], p[..], b, 3.3) == NET_SHOT_DID_NONE;   // unknown now
  // gone: a stuck one is taken away
  g := NetShotEnd.{ok = true, id = 1, kind = NET_SHOT_GONE}; #assert net_shots_ended(sh[..], p[..], g, 4) == NET_SHOT_DID_NONE && p[0].a[i].state == bow.ARROW_FREE && sh[0].tag[i].id == 0;
}
