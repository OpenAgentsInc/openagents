// Reliable spawn and despawn (#13178), engine-wide, over one recipient/entity pair's NetReplica
// (replication.coax). An entity's arrival in a client's view carries its identity (kind, look,
// life) in an absolute row: its spawn. Its departure is a despawn (Everglade's x ID). Both go on the
// reliable session channel, ahead of the tick's updates and outside their byte budget's cuts, and go
// again every `resend` ticks until a tick that held them is acknowledged. Neither rides only on a
// datagram.
//
// The states, per client and entity life:
//   NONE  the client holds nothing of this life: its next row is a spawn;
//   SENT  a spawn went and isn't acknowledged: its rows stay spawns (absolute, reliable);
//   LIVE  a tick that held a row of it was acknowledged: its rows are updates against that.
// On a transport whose updates are datagrams, nothing of a SENT entity goes but its spawn, again
// every `resend` ticks: a datagram can pass the reliable stream, so an update could reach a client
// that hasn't heard who the entity is. On a transport whose one ordered stream carries both (a
// WebSocket: the reliable channel is the socket itself), a changed row of a SENT entity goes at once,
// absolute: it arrives behind its spawn (`ordered`).
//
// A slot's next entity spawns only once its earlier one's despawn has gone (net_replica_ready):
// both ride the one reliable channel, so the client hears the despawn first.
//   coax/bin/coax test metaverse-engine/net/spawn.coax
#module "metaverse.engine.net.spawn";
#authority;
#load "replication.coax";

NET_SPAWN_NONE :: 0; NET_SPAWN_SENT :: 1; NET_SPAWN_LIVE :: 2;

// Where the client stands with the entity whose id + 1 is id1 (0: none there).
net_spawn_state :: (r: NetReplica, id1: int) -> int #effects(all) {
  if id1 == 0 || r.held != id1 { return NET_SPAWN_NONE; }
  return ifx r.base > 0 then NET_SPAWN_LIVE else NET_SPAWN_SENT;
}
// Whether its row now is a spawn: absolute, on the reliable channel, never cut for want of bytes.
net_spawn_row :: (r: NetReplica, id1: int) -> bool #effects(all) { return net_spawn_state(r, id1) != NET_SPAWN_LIVE; }
// Whether a row of it may go now (when it has changed): a spawn not yet sent, or a live entity's
// update, always; an unacknowledged spawn's again only `resend` ticks after its last, or at once on
// one ordered stream.
net_row_may_go :: (r: NetReplica, id1: int, now: int, resend: int, ordered: bool) -> bool #effects(all) {
  if net_spawn_state(r, id1) != NET_SPAWN_SENT { return true; }
  return ordered || now - r.last >= resend;
}
// Whether a despawn owed (gone: the departed id + 1, 0 none; gone_t: the tick it last went, 0 not
// yet) goes now: not sent yet, or unacknowledged `resend` ticks since it went.
net_despawn_due :: (gone: int, gone_t: int, now: int, resend: int) -> bool #effects(all) {
  return gone != 0 && (gone_t == 0 || now - gone_t >= resend);
}

// ---- checks

#test "spawn: a new life is a spawn, a sent one stays a spawn until acknowledged, then its rows are updates" {
  r := NetReplica.{};
  #assert net_spawn_state(r, 8) == NET_SPAWN_NONE && net_spawn_row(r, 8) && net_row_may_go(r, 8, 5, 10, false);
  #assert net_spawn_state(NetReplica.{held = 8, base = 1}, 8) == NET_SPAWN_LIVE;
  #assert net_spawn_state(r, 0) == NET_SPAWN_NONE && net_spawn_state(NetReplica.{held = 0, base = 3}, 0) == NET_SPAWN_NONE;
  r = net_replica_sent(r, 8, 5, 32);
  #assert net_spawn_state(r, 8) == NET_SPAWN_SENT && net_spawn_row(r, 8);
  #assert !net_row_may_go(r, 8, 14, 10, false) && net_row_may_go(r, 8, 15, 10, false);   // again each resend until heard
  #assert net_row_may_go(r, 8, 6, 10, true);   // one ordered stream: behind it at once
  a := net_replica_ack(r, 5, 32);
  #assert net_spawn_state(a, 8) == NET_SPAWN_LIVE && !net_spawn_row(a, 8) && net_row_may_go(a, 8, 6, 10, false);
  // another life in the slot (9) is a spawn again, whatever the last life's state
  #assert net_spawn_state(a, 9) == NET_SPAWN_NONE && net_spawn_row(a, 9) && net_spawn_state(r, 9) == NET_SPAWN_NONE;
  // a field change revokes the baseline: the next row is absolute, a spawn again
  #assert net_spawn_state(net_replica_fields(a, 3, 15), 8) == NET_SPAWN_SENT;
}
#test "despawn: owed and unsent goes now; sent, again each resend until acknowledged; none owed never" {
  #assert net_despawn_due(8, 0, 5, 10) && !net_despawn_due(8, 5, 14, 10) && net_despawn_due(8, 5, 15, 10);
  #assert !net_despawn_due(0, 0, 5, 10) && !net_despawn_due(0, 3, 50, 10);
}
#test "spawn ordering: an entity replaced in its slot: its despawn, then the new one's spawn, then updates; none ahead of an unheard spawn on datagrams" {
  // what one client hears from one slot, in order: entity 7 (id1 8), then entity 9 (id1 10) in its
  // place from tick 10. The client's word comes two ticks on; the tick of 10's first spawn is lost.
  for ordered: 0..<2 {
    r := NetReplica.{};
    heardlog: [64] int; n := 0;   // +id1 a spawn, -id1 a despawn, 1000 + id1 an update
    lost := -1;
    for now: 1..<40 {
      id1 := ifx now < 10 then 8 else 10;
      r = net_replica_observe(r, id1, true, now, 32);
      if net_despawn_due(r.gone, r.gone_t, now, 10) && n < 64 { heardlog[n] = -r.gone; n += 1; r.gone_t = now; }
      if net_replica_ready(r) && net_row_may_go(r, id1, now, 10, ordered == 1) && n < 64 {
        heardlog[n] = ifx net_spawn_row(r, id1) then id1 else 1000 + id1; n += 1;
        if id1 == 10 && lost < 0 { lost = now; }
        r = net_replica_sent(r, id1, now, 32);
      }
      heard := now - 2;
      if heard > 0 && heard != lost { r = net_replica_ack(r, heard, 32); }
    }
    first8 := -1; x8 := -1; spawn10 := -1; up10 := -1; spawns10 := 0;
    for q: 0..<n {
      if heardlog[q] == 8 && first8 < 0 { first8 = q; }
      if heardlog[q] == 1008 { #assert first8 == 0; }
      if heardlog[q] == -8 && x8 < 0 { x8 = q; }
      if heardlog[q] == 10 { #assert x8 >= 0 && up10 < 0; if spawn10 < 0 { spawn10 = q; } spawns10 += 1; }   // no spawn after an update
      if heardlog[q] == 1010 && up10 < 0 { up10 = q; }
    }
    #assert first8 == 0 && x8 > first8 && spawn10 == x8 + 1 && up10 > spawn10 && lost == 10;
    // the lost despawn goes again with the spawn after it, ten ticks on (datagrams) or at once (ordered)
    if ordered == 0 { #assert spawns10 == 2 && heardlog[spawn10 + 1] == -8 && heardlog[spawn10 + 2] == 10 && up10 == spawn10 + 3; }
    else { #assert spawns10 == 4 && heardlog[spawn10 + 1] == 10 && heardlog[spawn10 + 3] == 10 && up10 == spawn10 + 4; }   // each tick until one is heard
  }
}
