// Sand, snow and clay on a grid (book chapter 26): the moving-least-squares
// material point method (MLS-MPM, Hu et al., SIGGRAPH 2018) with APIC
// transfers, in 2D on a dense grid over the unit square, profile
// mpm-mls-2d-f64-v1. Particles carry position, velocity, the affine matrix C
// and the deformation gradient F; the grid is rebuilt every step.
//
//   mpm_add(m, x, v, material)      one particle, or -1 when full
//   mpm_step(m, w)                  P2G, grid update, G2P, return mapping
//   mpm_stress(material, mu, la, F) first Piola-Kirchhoff stress P(F)
//   mpm_energy(material, mu, la, F) the energy density it derives from
//
// Materials: neo-Hookean, fixed corotated, and sand (Drucker-Prager on
// Hencky strain, Klar et al., SIGGRAPH 2016). The scatter runs in particle
// order, so a step is the same bits every run. CPU only, f64, 2D. Snow,
// clay, muscle, a sparse grid, rigid coupling and device kernels are not
// built yet.
//   coax/bin/coax test --library metaverse-engine/physics/sim/mpm.coax
#load "../../core/math-d.coax";

MPM_PARTICLES :: 4096;
MPM_GRID :: 64;                   // cells a side; nodes are (MPM_GRID + 1)^2

Mpm_Material :: enum u8 { neo_hookean; corotated; sand; }

M2 :: struct { a: f64; b: f64; c: f64; d: f64; }   // [[a, b], [c, d]]
M2_I :: M2.{a = 1.0, d = 1.0};
m2 :: (a: f64, b: f64, c: f64, d: f64) -> M2 { return M2.{a = a, b = b, c = c, d = d}; }
m2_mul :: (x: M2, y: M2) -> M2 { return m2(x.a * y.a + x.b * y.c, x.a * y.b + x.b * y.d, x.c * y.a + x.d * y.c, x.c * y.b + x.d * y.d); }
m2_add :: (x: M2, y: M2) -> M2 { return m2(x.a + y.a, x.b + y.b, x.c + y.c, x.d + y.d); }
m2_sub :: (x: M2, y: M2) -> M2 { return m2(x.a - y.a, x.b - y.b, x.c - y.c, x.d - y.d); }
m2_scale :: (x: M2, k: f64) -> M2 { return m2(x.a * k, x.b * k, x.c * k, x.d * k); }
m2_t :: (x: M2) -> M2 { return m2(x.a, x.c, x.b, x.d); }
m2_det :: (x: M2) -> f64 { return x.a * x.d - x.b * x.c; }
m2_inv_t :: (x: M2) -> M2 { k := 1.0 / m2_det(x); return m2(x.d * k, -x.c * k, -x.b * k, x.a * k); }
m2_apply :: (x: M2, v: D2) -> D2 { return d2(x.a * v.x + x.b * v.y, x.c * v.x + x.d * v.y); }
m2_rot :: (t: f64) -> M2 { c := cos(t); s := sin(t); return m2(c, -s, s, c); }
m2_dot :: (x: M2, y: M2) -> f64 { return x.a * y.a + x.b * y.b + x.c * y.c + x.d * y.d; }

// F = U diag(s1, s2) V^T with U, V rotations: the polar rotation R, then the
// eigenvectors of the symmetric S = R^T F. s2 is negative when det F is.
Svd2 :: struct { u: M2; s1: f64; s2: f64; v: M2; }
// The rotation by the angle of (x, y); the identity for (0, 0).
m2_turn :: (x: f64, y: f64) -> M2 {
  r := sqrt(x * x + y * y);
  if r == 0.0 { return M2_I; }
  return m2(x / r, -y / r, y / r, x / r);
}
m2_polar :: (f: M2) -> M2 { return m2_turn(f.a + f.d, f.c - f.b); }
m2_svd :: (f: M2) -> Svd2 {
  out: Svd2; r := m2_polar(f); s := m2_mul(m2_t(r), f);
  // S is symmetric, [[p, q], [q, t]]; its eigenvectors turn by theta with
  // (cos 2 theta, sin 2 theta) along (p - t, 2 q). Half the angle, with no
  // trigonometric function: cos theta >= 0, sin theta takes sin 2 theta's sign.
  h := m2_turn(s.a - s.d, 2.0 * s.b);
  c := sqrt(fmax(0.0, 0.5 * (1.0 + h.a))); sn := sqrt(fmax(0.0, 0.5 * (1.0 - h.a)));
  if h.c < 0.0 { sn = -sn; }   // mutant: equivalent (at sin 2 theta = 0 either sign gives an SVD with the same product U S V^T)
  v := m2(c, -sn, sn, c);
  e := m2_mul(m2_t(v), m2_mul(s, v));
  out.u = m2_mul(r, v); out.v = v; out.s1 = e.a; out.s2 = e.d;
  return out;
}

// Energy density and first Piola-Kirchhoff stress, mu and la the Lame
// parameters.
mpm_energy :: (mat: Mpm_Material, mu: f64, la: f64, f: M2) -> f64 {
  j := m2_det(f);
  if mat == Mpm_Material.neo_hookean { lj := log(j); return 0.5 * mu * (m2_dot(f, f) - 2.0) - mu * lj + 0.5 * la * lj * lj; }
  if mat == Mpm_Material.corotated { s := m2_svd(f); return mu * ((s.s1 - 1.0) * (s.s1 - 1.0) + (s.s2 - 1.0) * (s.s2 - 1.0)) + 0.5 * la * (j - 1.0) * (j - 1.0); }
  s := m2_svd(f); e1 := log(s.s1); e2 := log(s.s2);
  return mu * (e1 * e1 + e2 * e2) + 0.5 * la * (e1 + e2) * (e1 + e2);
}
mpm_stress :: (mat: Mpm_Material, mu: f64, la: f64, f: M2) -> M2 {
  j := m2_det(f); fit := m2_inv_t(f);
  if mat == Mpm_Material.neo_hookean { return m2_add(m2_scale(m2_sub(f, fit), mu), m2_scale(fit, la * log(j))); }
  if mat == Mpm_Material.corotated { return m2_add(m2_scale(m2_sub(f, m2_polar(f)), 2.0 * mu), m2_scale(fit, la * (j - 1.0) * j)); }
  // Hencky St. Venant-Kirchhoff: U (2 mu S^-1 ln S + la tr(ln S) S^-1) V^T.
  s := m2_svd(f); e1 := log(s.s1); e2 := log(s.s2);
  p1 := (2.0 * mu * e1 + la * (e1 + e2)) / s.s1; p2 := (2.0 * mu * e2 + la * (e1 + e2)) / s.s2;
  return m2_mul(s.u, m2_mul(m2(p1, 0.0, 0.0, p2), m2_t(s.v)));
}

// Drucker-Prager return mapping in log strain (Klar et al., section 7.3)
// with friction angle phi: a stretched particle loses all strain (sand
// cannot pull), a sheared one returns to the cone. Returns the new F.
mpm_sand_project :: (f: M2, mu: f64, la: f64, phi: f64) -> M2 {
  s := m2_svd(f); e1 := log(s.s1); e2 := log(s.s2); tr := e1 + e2;
  if tr >= 0.0 { return m2_mul(s.u, m2_t(s.v)); }   // mutant: equivalent (at tr = 0 the strain is on the cone's apex line: both branches return U V^T up to rounding)
  h1 := e1 - 0.5 * tr; h2 := e2 - 0.5 * tr; hn := sqrt(h1 * h1 + h2 * h2);
  sp := sin(phi); alpha := sqrt(2.0 / 3.0) * 2.0 * sp / (3.0 - sp);
  dg := hn + (2.0 * la + 2.0 * mu) / (2.0 * mu) * tr * alpha;
  if dg <= 0.0 || hn == 0.0 { return f; }   // mutant: equivalent (at dg = 0 the mapping moves the strain by 0)
  e1 = e1 - dg * h1 / hn; e2 = e2 - dg * h2 / hn;
  return m2_mul(s.u, m2_mul(m2(exp(e1), 0.0, 0.0, exp(e2)), m2_t(s.v)));
}
// How far log strain e1, e2 lies outside the cone; 0 on or inside it.
mpm_sand_excess :: (f: M2, mu: f64, la: f64, phi: f64) -> f64 {
  s := m2_svd(f); e1 := log(s.s1); e2 := log(s.s2); tr := e1 + e2;
  h1 := e1 - 0.5 * tr; h2 := e2 - 0.5 * tr; sp := sin(phi);
  alpha := sqrt(2.0 / 3.0) * 2.0 * sp / (3.0 - sp);
  return fmax(0.0, sqrt(h1 * h1 + h2 * h2) + (2.0 * la + 2.0 * mu) / (2.0 * mu) * tr * alpha);
}

Mpm :: struct {
  count: int;
  x: [MPM_PARTICLES] D2;
  v: [MPM_PARTICLES] D2;
  c: [MPM_PARTICLES] M2;
  f: [MPM_PARTICLES] M2;
  material: [MPM_PARTICLES] Mpm_Material;
  grid_m: [(MPM_GRID + 1) * (MPM_GRID + 1)] f64;
  grid_v: [(MPM_GRID + 1) * (MPM_GRID + 1)] D2;
}

Mpm_World :: struct {
  n: int = 64;                 // cells a side, at most MPM_GRID
  dt: f64 = 0.0001;
  gravity: D2;
  rho: f64 = 1000.0;           // kg/m^3 (per unit thickness)
  volume: f64;                 // each particle's rest volume, m^2
  mu: f64; la: f64;            // Lame parameters, Pa
  phi: f64 = 0.5236;           // sand friction angle, rad (30 degrees)
  walls: bool = true;          // a box: no flow through the outer 3 cells
}

mpm_add :: (m: [] Mpm, x: D2, v: D2, mat: Mpm_Material) -> int {
  i := m[0].count;
  if i == MPM_PARTICLES { return -1; }
  m[0].count = i + 1;
  m[0].x[i] = x; m[0].v[i] = v; m[0].c[i] = M2.{}; m[0].f[i] = M2_I; m[0].material[i] = mat;
  return i;
}

// Quadratic B-spline weights of the three nodes from `base` along one axis.
mpm_weights :: (fx: f64) -> D3 {
  return d3(0.5 * (1.5 - fx) * (1.5 - fx), 0.75 - (fx - 1.0) * (fx - 1.0), 0.5 * (fx - 0.5) * (fx - 0.5));
}
mpm_w :: (w: D3, k: int) -> f64 { return ifx k == 0 then w.x else ifx k == 1 then w.y else w.z; }

// Particle-to-grid only: masses and momenta, then velocities. Exposed for
// the conservation checks.
mpm_p2g :: (m: [] Mpm, w: Mpm_World) {
  n := w.n; dx := 1.0 / cast(f64) n; inv := cast(f64) n; nodes := (n + 1) * (n + 1);
  for k: 0..<nodes { m[0].grid_m[k] = 0.0; m[0].grid_v[k] = D2.{}; }
  mass := w.rho * w.volume;
  for p: 0..<m[0].count {
    x := m[0].x[p];
    bx := cast(int) floor(x.x * inv - 0.5); by := cast(int) floor(x.y * inv - 0.5);
    fx := x.x * inv - cast(f64) bx; fy := x.y * inv - cast(f64) by;
    wx := mpm_weights(fx); wy := mpm_weights(fy);
    pf := mpm_stress(m[0].material[p], w.mu, w.la, m[0].f[p]);
    stress := m2_scale(m2_mul(pf, m2_t(m[0].f[p])), -w.dt * w.volume * 4.0 * inv * inv);
    affine := m2_add(stress, m2_scale(m[0].c[p], mass));
    for j: 0..<3 {
      for i: 0..<3 {
        gx := bx + i; gy := by + j;
        if gx < 0 || gy < 0 || gx > n || gy > n { continue; }
        wt := mpm_w(wx, i) * mpm_w(wy, j);
        dpos := d2((cast(f64) i - fx) * dx, (cast(f64) j - fy) * dx);
        mv := d2_add(d2_scale(m[0].v[p], mass), m2_apply(affine, dpos));
        k := gy * (n + 1) + gx;
        m[0].grid_v[k] = d2_add(m[0].grid_v[k], d2_scale(mv, wt));
        m[0].grid_m[k] += wt * mass;
      }
    }
  }
}

mpm_step :: (m: [] Mpm, w: Mpm_World) {
  n := w.n; dx := 1.0 / cast(f64) n; inv := cast(f64) n;
  mpm_p2g(m, w);
  for gy: 0..<n + 1 {
    for gx: 0..<n + 1 {
      k := gy * (n + 1) + gx;
      if m[0].grid_m[k] <= 0.0 { continue; }
      v := d2_add(d2_scale(m[0].grid_v[k], 1.0 / m[0].grid_m[k]), d2_scale(w.gravity, w.dt));
      if w.walls {
        // Nothing moves into the outer three cells. The walls slip; the
        // floor grips what presses on it and lets go of what lifts off.
        if gx < 3 && v.x < 0.0 { v.x = 0.0; }   // mutant: equivalent (a component already 0 is set to 0)
        if gx > n - 3 && v.x > 0.0 { v.x = 0.0; }   // mutant: equivalent (a component already 0 is set to 0)
        if gy < 3 && v.y < 0.0 { v = d2(0.0, 0.0); }
        if gy > n - 3 && v.y > 0.0 { v.y = 0.0; }   // mutant: equivalent (a component already 0 is set to 0)
      }
      m[0].grid_v[k] = v;
    }
  }
  for p: 0..<m[0].count {
    x := m[0].x[p];
    bx := cast(int) floor(x.x * inv - 0.5); by := cast(int) floor(x.y * inv - 0.5);
    fx := x.x * inv - cast(f64) bx; fy := x.y * inv - cast(f64) by;
    wx := mpm_weights(fx); wy := mpm_weights(fy);
    nv := D2.{}; nc := M2.{};
    for j: 0..<3 {
      for i: 0..<3 {
        gx := bx + i; gy := by + j;
        if gx < 0 || gy < 0 || gx > n || gy > n { continue; }
        wt := mpm_w(wx, i) * mpm_w(wy, j);
        dpos := d2((cast(f64) i - fx) * dx, (cast(f64) j - fy) * dx);
        gv := m[0].grid_v[gy * (n + 1) + gx];
        nv = d2_add(nv, d2_scale(gv, wt));
        nc = m2_add(nc, m2_scale(m2(gv.x * dpos.x, gv.x * dpos.y, gv.y * dpos.x, gv.y * dpos.y), 4.0 * inv * inv * wt));
      }
    }
    m[0].v[p] = nv; m[0].c[p] = nc;
    f := m2_mul(m2_add(M2_I, m2_scale(nc, w.dt)), m[0].f[p]);
    if m[0].material[p] == Mpm_Material.sand { f = mpm_sand_project(f, w.mu, w.la, w.phi); }
    m[0].f[p] = f;
    m[0].x[p] = d2_add(x, d2_scale(nv, w.dt));
  }
}

// A block of particles, 2 per cell along each axis, from lo to hi.
mpm_block :: (m: [] Mpm, w: Mpm_World, lo: D2, hi: D2, v: D2, mat: Mpm_Material) -> int {
  step := 0.5 / cast(f64) w.n; added := 0;
  nx := cast(int) floor((hi.x - lo.x) / step + 0.000001); ny := cast(int) floor((hi.y - lo.y) / step + 0.000001);
  for j: 0..<ny {
    for i: 0..<nx {
      if mpm_add(m, d2(lo.x + (cast(f64) i + 0.5) * step, lo.y + (cast(f64) j + 0.5) * step), v, mat) < 0 { return -1; }
      added += 1;
    }
  }
  return added;
}

// The Lame parameters of Young's modulus e and Poisson's ratio nu.
mpm_mu :: (e: f64, nu: f64) -> f64 { return e / (2.0 * (1.0 + nu)); }
mpm_la :: (e: f64, nu: f64) -> f64 { return e * nu / ((1.0 + nu) * (1.0 - 2.0 * nu)); }

// ---- checks

test_f :: (k: int) -> M2 {
  return m2(1.0 + 0.3 * sin(cast(f64) k), 0.2 * cos(cast(f64) k * 1.7), -0.15 * sin(cast(f64) k * 2.3), 0.9 + 0.25 * cos(cast(f64) k * 0.7));   // mutant: equivalent (the F generator: any change still gives F with positive determinant for the checks)
}

#test "each stress is the derivative of its energy, and rotates with F" {
  for mi: 0..<3 {
    mat := cast(Mpm_Material) mi;
    for k: 0..<12 {
      f := test_f(k); p := mpm_stress(mat, 3.0, 5.0, f); e := 0.000001;
      // Central differences, one entry of F at a time.
      da := (mpm_energy(mat, 3.0, 5.0, m2_add(f, m2(e, 0.0, 0.0, 0.0))) - mpm_energy(mat, 3.0, 5.0, m2_sub(f, m2(e, 0.0, 0.0, 0.0)))) / (2.0 * e);
      db := (mpm_energy(mat, 3.0, 5.0, m2_add(f, m2(0.0, e, 0.0, 0.0))) - mpm_energy(mat, 3.0, 5.0, m2_sub(f, m2(0.0, e, 0.0, 0.0)))) / (2.0 * e);
      dc := (mpm_energy(mat, 3.0, 5.0, m2_add(f, m2(0.0, 0.0, e, 0.0))) - mpm_energy(mat, 3.0, 5.0, m2_sub(f, m2(0.0, 0.0, e, 0.0)))) / (2.0 * e);
      dd := (mpm_energy(mat, 3.0, 5.0, m2_add(f, m2(0.0, 0.0, 0.0, e))) - mpm_energy(mat, 3.0, 5.0, m2_sub(f, m2(0.0, 0.0, 0.0, e)))) / (2.0 * e);
      #assert abs(p.a - da) < 1e-6 && abs(p.b - db) < 1e-6 && abs(p.c - dc) < 1e-6 && abs(p.d - dd) < 1e-6;
      // P(R F) = R P(F), and the energy does not change.
      r := m2_rot(0.3 * cast(f64) k + 0.1);
      q := mpm_stress(mat, 3.0, 5.0, m2_mul(r, f)); rq := m2_mul(r, p);
      #assert abs(q.a - rq.a) < 1e-12 && abs(q.b - rq.b) < 1e-12 && abs(q.c - rq.c) < 1e-12 && abs(q.d - rq.d) < 1e-12;
      #assert abs(mpm_energy(mat, 3.0, 5.0, m2_mul(r, f)) - mpm_energy(mat, 3.0, 5.0, f)) < 1e-12;
    }
    // At rest, no stress and no energy.
    z := mpm_stress(mat, 3.0, 5.0, M2_I);
    #assert abs(z.a) < 1e-15 && abs(z.b) < 1e-15 && abs(z.c) < 1e-15 && abs(z.d) < 1e-15 && abs(mpm_energy(mat, 3.0, 5.0, M2_I)) < 1e-15;
  }
}

#test "the 2D SVD rebuilds F with rotations, and the polar factor is a rotation" {
  for k: 0..<20 {
    f := test_f(k); s := m2_svd(f);
    g := m2_mul(s.u, m2_mul(m2(s.s1, 0.0, 0.0, s.s2), m2_t(s.v)));
    #assert abs(g.a - f.a) < 1e-14 && abs(g.b - f.b) < 1e-14 && abs(g.c - f.c) < 1e-14 && abs(g.d - f.d) < 1e-14;
    #assert abs(m2_det(s.u) - 1.0) < 1e-14 && abs(m2_det(s.v) - 1.0) < 1e-14 && abs(s.s1 * s.s2 - m2_det(f)) < 1e-14;
    r := m2_polar(f); i := m2_mul(m2_t(r), r);
    #assert abs(i.a - 1.0) < 1e-15 && abs(i.b) < 1e-15 && abs(m2_det(r) - 1.0) < 1e-15;
    // R^T F is symmetric.
    sy := m2_mul(m2_t(r), f);
    #assert abs(sy.b - sy.c) < 1e-14;
  }
}

#test "the sand return mapping lands on the cone, is idempotent, and lets go when stretched" {
  mu := 1000.0; la := 1500.0; phi := 0.5236;
  out := 0;
  for k: 0..<20 {
    f := m2_mul(test_f(k), m2(0.8, 0.0, 0.0, 0.95));   // compressed and sheared
    g := mpm_sand_project(f, mu, la, phi);
    #assert mpm_sand_excess(g, mu, la, phi) < 1e-12;
    h := mpm_sand_project(g, mu, la, phi);
    #assert abs(h.a - g.a) < 1e-12 && abs(h.b - g.b) < 1e-12 && abs(h.c - g.c) < 1e-12 && abs(h.d - g.d) < 1e-12;
    if mpm_sand_excess(f, mu, la, phi) > 0.0 { out += 1; }
  }
  #assert out > 5;
  // Stretched in volume: all strain released, only the rotation stays.
  r := m2_rot(0.4); g := mpm_sand_project(m2_mul(r, m2(1.1, 0.0, 0.0, 1.05)), mu, la, phi);
  #assert abs(g.a - r.a) < 1e-14 && abs(g.b - r.b) < 1e-14 && abs(g.c - r.c) < 1e-14 && abs(g.d - r.d) < 1e-14;
  // Pure compression is inside the cone: unchanged.
  q := m2(0.9, 0.0, 0.0, 0.9);
  #assert mpm_sand_excess(q, mu, la, phi) == 0.0 && m2_eq(mpm_sand_project(q, mu, la, phi), q);
}
m2_eq :: (x: M2, y: M2) -> bool { return x.a == y.a && x.b == y.b && x.c == y.c && x.d == y.d; }

#test "a transfer keeps mass and momentum, and a step without forces or walls keeps momentum" #steps 300000000 {
  m: [1] Mpm; w := Mpm_World.{n = 16, walls = false, volume = 0.0005, mu = 100.0, la = 100.0, dt = 0.0005};
  #assert mpm_block(m[..], w, d2(0.3125, 0.3125), d2(0.625, 0.5), d2(0.0, 0.0), Mpm_Material.neo_hookean) == 60;
  for p: 0..<m[0].count {
    m[0].v[p] = d2(sin(cast(f64) p), cos(cast(f64) p * 0.3));
    m[0].c[p] = m2(0.1 * sin(cast(f64) p * 0.7), 0.2, -0.3, 0.05);
    m[0].f[p] = test_f(p);
  }
  mass := 1000.0 * 0.0005; total := 0.0; pm := d2(0.0, 0.0);
  for p: 0..<m[0].count { pm = d2_add(pm, d2_scale(m[0].v[p], mass)); }
  mpm_p2g(m[..], w);
  gm := d2(0.0, 0.0);
  for k: 0..<17 * 17 { total += m[0].grid_m[k]; gm = d2_add(gm, m[0].grid_v[k]); }
  #assert abs(total - 60.0 * mass) < 1e-12 && abs(gm.x - pm.x) < 1e-12 && abs(gm.y - pm.y) < 1e-12;
  // A whole step: internal forces cancel, so momentum is kept.
  mpm_step(m[..], w);
  after := d2(0.0, 0.0);
  for p: 0..<m[0].count { after = d2_add(after, d2_scale(m[0].v[p], mass)); }
  #assert abs(after.x - pm.x) < 1e-12 && abs(after.y - pm.y) < 1e-12;
}

#test "a soft block set on the floor sags a little and springs back, and never sinks through" #steps 400000000 {
  m: [1] Mpm; w := Mpm_World.{n = 16, volume = 0.0005, dt = 0.0005, gravity = d2(0.0, -9.81), mu = mpm_mu(10000.0, 0.3), la = mpm_la(10000.0, 0.3)};
  #assert mpm_block(m[..], w, d2(0.40625, 0.125), d2(0.59375, 0.25), d2(0.0, 0.0), Mpm_Material.corotated) == 24;
  y0 := 0.0;
  for p: 0..<24 { y0 += m[0].x[p].y; }
  deepest := 0.0; low := 1.0;
  for k: 0..<200 {
    mpm_step(m[..], w);
    y := 0.0;
    for p: 0..<24 { y += m[0].x[p].y; low = fmin(low, m[0].x[p].y); }
    deepest = fmin(deepest, (y - y0) / 24.0);
  }
  #assert deepest < -0.001 && deepest > -0.01 && low > 0.125;
  full: [1] Mpm;
  for k: 0..<MPM_PARTICLES { #assert mpm_add(full[..], d2(0.5, 0.5), d2(0.0, 0.0), Mpm_Material.sand) == k; }
  #assert mpm_add(full[..], d2(0.5, 0.5), d2(0.0, 0.0), Mpm_Material.sand) == -1;
}

// The cone value hn + K tr alpha, unclamped, from Klar et al.'s alpha
// written out separately: 0 on the cone, negative inside.
test_cone :: (f: M2, mu: f64, la: f64, phi: f64) -> f64 {
  s := m2_svd(f); e1 := log(s.s1); e2 := log(s.s2); tr := e1 + e2;
  hn := sqrt((e1 - e2) * (e1 - e2) * 0.5);
  alpha := 2.0 * sin(phi) * sqrt(2.0 / 3.0) / (3.0 - sin(phi));
  return hn + (la + mu) / mu * tr * alpha;
}
test_trace :: (f: M2) -> f64 { s := m2_svd(f); return log(s.s1) + log(s.s2); }

#test "the return mapping keeps the volume, lands exactly on the cone, and leaves the inside alone" {
  mu := 1000.0; la := 1500.0; phi := 0.5236;
  on := 0;
  for k: 0..<20 {
    f := m2_mul(test_f(k), m2(0.8, 0.0, 0.0, 0.95));
    if test_cone(f, mu, la, phi) <= 0.0 || test_trace(f) >= 0.0 { continue; }
    g := mpm_sand_project(f, mu, la, phi);
    #assert abs(test_cone(g, mu, la, phi)) < 1e-12 && abs(test_trace(g) - test_trace(f)) < 1e-12;
    // The shear keeps its direction: only its size shrinks.
    a := m2_svd(f); b := m2_svd(g);
    #assert (log(a.s1) - log(a.s2)) * (log(b.s1) - log(b.s2)) > 0.0;
    on += 1;
  }
  #assert on > 5;
  // A little shear under strong compression is inside the cone: unchanged.
  q := m2_mul(m2_rot(0.2), m2(0.8, 0.0, 0.0, 0.78));
  #assert test_cone(q, mu, la, phi) < 0.0 && m2_eq(mpm_sand_project(q, mu, la, phi), q);
  // m2_eq tells every entry apart, and m2_apply uses every entry.
  #assert !m2_eq(M2_I, m2(2.0, 0.0, 0.0, 1.0)) && !m2_eq(M2_I, m2(1.0, 2.0, 0.0, 1.0)) && !m2_eq(M2_I, m2(1.0, 0.0, 2.0, 1.0)) && !m2_eq(M2_I, m2(1.0, 0.0, 0.0, 2.0));
  r := m2_apply(m2(1.0, 2.0, 3.0, 4.0), d2(5.0, 6.0));
  #assert r.x == 17.0 && r.y == 39.0;
  #assert abs(mpm_mu(1000.0, 0.25) - 400.0) < 1e-12 && abs(mpm_la(1000.0, 0.25) - 400.0) < 1e-12;
  #assert abs(mpm_mu(1000.0, 0.3) - 1000.0 / 2.6) < 1e-12 && abs(mpm_la(1000.0, 0.3) - 300.0 / 0.52) < 1e-9;
}

#test "APIC carries an affine velocity field through a step exactly" #steps 300000000 {
  m: [1] Mpm; w := Mpm_World.{n = 16, walls = false, volume = 0.0005};
  #assert mpm_block(m[..], w, d2(0.3125, 0.3125), d2(0.625, 0.5), d2(0.0, 0.0), Mpm_Material.neo_hookean) == 60;
  a := m2(0.3, -0.7, 0.4, 0.2); b := d2(0.5, -0.25);
  old: [60] D2;
  for p: 0..<60 { old[p] = m[0].x[p]; m[0].v[p] = d2_add(m2_apply(a, m[0].x[p]), b); m[0].c[p] = a; }
  mpm_step(m[..], w);
  for p: 0..<60 {
    want := d2_add(m2_apply(a, old[p]), b); c := m[0].c[p];
    #assert d2_dist(m[0].v[p], want) < 1e-12 && abs(c.a - a.a) < 1e-11 && abs(c.b - a.b) < 1e-11 && abs(c.c - a.c) < 1e-11 && abs(c.d - a.d) < 1e-11;
    #assert d2_dist(m[0].x[p], d2_add(old[p], d2_scale(want, w.dt))) < 1e-15;
  }
  // From C = 0 the step recovers the field's gradient into C.
  m[0].count = 0;
  #assert mpm_block(m[..], w, d2(0.3125, 0.3125), d2(0.625, 0.5), d2(0.0, 0.0), Mpm_Material.neo_hookean) == 60;
  for p: 0..<60 { m[0].v[p] = d2_add(m2_apply(a, m[0].x[p]), b); }
  mpm_step(m[..], w);
  mid := m[0].c[3 * 10 + 5];
  #assert abs(mid.a - a.a) < 0.1 && abs(mid.b - a.b) < 0.1 && abs(mid.c - a.c) < 0.1 && abs(mid.d - a.d) < 0.1;
  // The block's first particle sits half a spacing in from lo.
  #assert d2_dist(old[0], d2(0.3125 + 0.015625, 0.3125 + 0.015625)) < 1e-15;
}

#test "the grid's edges: every node from 0 to n, and nothing past them" #steps 300000000 {
  m: [1] Mpm; w := Mpm_World.{n = 16, walls = false, volume = 0.0005, gravity = d2(0.0, -10.0), dt = 0.001};
  mass := 1000.0 * 0.0005;
  // Four particles whose stencils reach nodes 0 and n but not past them.
  for k: 0..<4 { _ := mpm_add(m[..], d2(ifx (k & 1) != 0 then 0.95 else 0.04, ifx (k & 2) != 0 then 0.95 else 0.04), d2(1.0, 2.0), Mpm_Material.corotated); }
  mpm_p2g(m[..], w); mpm_p2g(m[..], w);
  total := 0.0; mom := d2(0.0, 0.0);
  for k: 0..<17 * 17 { total += m[0].grid_m[k]; mom = d2_add(mom, m[0].grid_v[k]); }
  #assert abs(total - 4.0 * mass) < 1e-15 && abs(mom.x - 4.0 * mass) < 1e-14 && abs(mom.y - 8.0 * mass) < 1e-14;
  #assert m[0].grid_m[0] > 0.0 && m[0].grid_m[17 * 17 - 1] > 0.0;
  mpm_step(m[..], w);
  for p: 0..<4 { #assert abs(m[0].v[p].x - 1.0) < 1e-14 && abs(m[0].v[p].y - (2.0 - 0.01)) < 1e-14; }
  #assert m[0].grid_v[8 * 17 + 8].x == 0.0 && m[0].grid_v[8 * 17 + 8].y == 0.0;   // an empty node stays 0
  // A particle a fifth of a cell from the left edge loses its node -1, and
  // nothing wraps to the far column; one at the right edge loses node n + 1.
  m[0].count = 0;
  _ := mpm_add(m[..], d2(0.01, 0.5), d2(0.0, 0.0), Mpm_Material.corotated);
  _ = mpm_add(m[..], d2(0.97, 0.47), d2(5.0, 0.0), Mpm_Material.corotated);
  _ = mpm_add(m[..], d2(0.5, 0.01), d2(0.0, 0.0), Mpm_Material.corotated);
  _ = mpm_add(m[..], d2(0.47, 0.97), d2(0.0, 5.0), Mpm_Material.corotated);
  mpm_p2g(m[..], w);
  wx := mpm_weights(0.01 * 16.0 + 1.0); wr := mpm_weights(0.97 * 16.0 - 15.0);
  total = 0.0;
  for k: 0..<17 * 17 { total += m[0].grid_m[k]; }
  #assert abs(total - mass * (2.0 * (wx.y + wx.z) + 2.0 * (wr.x + wr.y))) < 1e-14;
  mpm_step(m[..], w);
  #assert abs(m[0].v[0].x) < 1e-15 && abs(m[0].v[0].y + 0.01 * (wx.y + wx.z)) < 1e-14;
  #assert abs(m[0].v[2].x) < 1e-15 && abs(m[0].v[2].y + 0.01 * (wx.y + wx.z)) < 1e-14;
  #assert abs(m[0].v[1].x - 5.0 * (wr.x + wr.y)) < 1e-14 && abs(m[0].v[3].x) < 1e-15;
  // The full 64-cell grid steps too.
  m[0].count = 0; w.n = 64;
  _ = mpm_add(m[..], d2(0.98, 0.98), d2(0.0, 0.0), Mpm_Material.corotated);
  mpm_step(m[..], w);
  #assert m[0].v[0].y < 0.0;
}

#test "the walls: no flow into the outer three cells, a gripping floor, slipping sides" #steps 100000000 {
  m: [1] Mpm; w := Mpm_World.{n = 16, volume = 0.0005};
  // Each case is one particle at rest stress (F = I), so a node's velocity
  // is the particle's, and its new velocity sums the stencil's walls.

  at := [12] D2.[d2(0.08, 0.5), d2(0.08, 0.5), d2(0.15, 0.5), d2(0.92, 0.5), d2(0.92, 0.5), d2(0.85, 0.5),
                    d2(0.5, 0.08), d2(0.5, 0.08), d2(0.5, 0.92), d2(0.5, 0.92), d2(0.5, 0.85), d2(0.5, 0.5)];
  vin := [12] D2.[d2(-1.0, 0.5), d2(1.0, 0.5), d2(-1.0, 0.0), d2(1.0, 0.5), d2(-1.0, 0.5), d2(1.0, 0.0),
                     d2(0.5, -1.0), d2(1.0, 0.0), d2(0.5, 1.0), d2(0.5, -1.0), d2(0.0, 1.0), d2(-1.0, -1.0)];
  for k: 0..<12 {
    m[0].count = 0;
    _ := mpm_add(m[..], at[k], vin[k], Mpm_Material.neo_hookean);
    mpm_step(m[..], w);
    v := m[0].v[0]; s := vin[k];
    // The weight of the one stencil node that is outside the band.
    w3 := mpm_weights(0.15 * 16.0 - 1.0).z; w13 := mpm_weights(0.85 * 16.0 - 13.0).x;
    want := s;
    if k == 0 { want = d2(0.0, 0.5); }
    if k == 2 { want = d2(-w3, 0.0); }
    if k == 3 { want = d2(0.0, 0.5); }
    if k == 5 { want = d2(w13, 0.0); }
    if k == 6 { want = d2(0.0, 0.0); }
    if k == 8 { want = d2(0.5, 0.0); }
    if k == 10 { want = d2(0.0, w13); }
    #assert d2_dist(v, want) < 1e-14;
  }
}

#test "mpm_add sets every field of a reused slot, and a full store refuses a block" {
  m: [1] Mpm; w := Mpm_World.{n = 16};
  #assert mpm_add(m[..], d2(0.5, 0.5), d2(0.0, 0.0), Mpm_Material.neo_hookean) == 0;
  m[0].c[0] = m2(1.0, 2.0, 3.0, 4.0); m[0].count = 0;
  #assert mpm_add(m[..], d2(0.25, 0.75), d2(1.0, -2.0), Mpm_Material.sand) == 0;
  #assert m2_eq(m[0].c[0], M2.{}) && m2_eq(m[0].f[0], M2_I) && m[0].material[0] == Mpm_Material.sand && m[0].v[0].x == 1.0 && m[0].v[0].y == -2.0;
  m[0].count = MPM_PARTICLES - 3;
  #assert mpm_block(m[..], w, d2(0.25, 0.25), d2(0.5, 0.5), d2(0.0, 0.0), Mpm_Material.sand) == -1 && m[0].count == MPM_PARTICLES;
}

#test "a step projects sand and only sand" {
  m: [1] Mpm; w := Mpm_World.{n = 16, walls = false, volume = 0.0005, mu = 1000.0, la = 1500.0, dt = 0.0001};
  for mi: 0..<3 {
    m[0].count = 0;
    _ := mpm_add(m[..], d2(0.5, 0.5), d2(0.0, 0.0), cast(Mpm_Material) mi);
    m[0].f[0] = m2(1.1, 0.0, 0.0, 1.05);
    mpm_step(m[..], w);
    j := m2_det(m[0].f[0]);
    // Sand cannot be stretched: it lets go of all its strain.
    if mi == 2 { #assert abs(j - 1.0) < 1e-9; } else { #assert abs(j - 1.155) < 1e-3; }
  }
}
