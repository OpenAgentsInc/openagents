// The Metaverse Engine's key-light shadow cascades (GitHub #13016, part of #12998). The one 2048 map that
// light.coax describes reaches 60 m and is drawn again every frame. Cascades split that into
// tiles of one depth atlas, each a ring further out, and a tile is drawn again only when its
// snapped view changes:
//   - its middle snaps to a coarse step (a whole number of texels) in the light's space, and it is
//     drawn again only once the eye has moved past the step and its slack;
//   - the light has turned past the tile's own limit (half a texel's shift under a 10 m caster);
//   - geometry installed since (cascade_stale), at most once every CASCADE_STALE_FRAMES;
//   - the nearest tile, while anything moves in it (people, the hero, debris).
// At most one tile is drawn in a frame, and a far tile waits at least its period between draws.
// A phone keeps two tiles; a desktop four. A realm's shader reads each tile's rows (cascade_rows)
// and takes the finest tile that holds a point with its filter.
//   coax/bin/coax test metaverse-engine/render/cascades.coax
//   coax/bin/coax mutate metaverse-engine/render/cascades.coax --root-only

#module "metaverse.engine.render.cascades";
#load "light.coax";

CASCADE_MAX :: 4;
CASCADE_FLOATS :: 24;                        // rows a tile writes for the shader (cascade_rows)
CASCADE_HEADER :: 4;                         // then the header: count, tile drawn now, atlas w, h
CASCADE_BLOCK :: CASCADE_HEADER + CASCADE_MAX * CASCADE_FLOATS;
CASCADE_STALE_FRAMES :: 30;                  // installed geometry redraws the tiles at most this often
CASCADE_SLACK :: 0.125f32;                   // of a step: the eye moves this far past it before a redraw
CASCADE_LOST_TURN :: 0.3f32;                 // radians: a light turned further (the moon for the sun) drops a tile
CASCADE_CASTER :: 10.0f32;                   // metres: the caster height a turn limit is set for

// A tier: how many tiles, how many texels across each, how the atlas lays them out, and per tile
// the half width it reaches round its middle (m), the step its middle snaps to (m), the fewest
// frames between its draws.
CascadeTier :: struct {
  count: int; tile: f32; cols: int; rows: int;
  reach: [CASCADE_MAX] f32; step: [CASCADE_MAX] f32; period: [CASCADE_MAX] int;
}
cascade_tier :: (phone: bool) -> CascadeTier {
  t: CascadeTier;
  if phone {
    t.count = 2; t.tile = 768; t.cols = 2; t.rows = 1;
    t.reach[0] = 20; t.reach[1] = 75;
    t.step[0] = 6; t.step[1] = 24;
    t.period[0] = 1; t.period[1] = 6;
    return t;
  }
  t.count = 4; t.tile = 1024; t.cols = 2; t.rows = 2;
  t.reach[0] = 24; t.reach[1] = 60; t.reach[2] = 150; t.reach[3] = 360;
  t.step[0] = 8; t.step[1] = 20; t.step[2] = 50; t.step[3] = 120;
  t.period[0] = 1; t.period[1] = 3; t.period[2] = 6; t.period[3] = 12;
  return t;
}
// The atlas's size in texels: `which` 0 across, 1 down.
cascade_atlas :: (phone: bool, which: int) -> int {
  t := cascade_tier(phone);
  return cast(int) t.tile * (ifx which == 0 then t.cols else t.rows);
}
// A tile's texel (m), its step as a whole number of texels (m, at least one), and how far the
// eye may stand from its middle before it is drawn again (half a step and the slack).
cascade_texel :: (t: CascadeTier, k: int) -> f32 { return 2 * t.reach[k] / st_max(t.tile, 1); }
cascade_step :: (t: CascadeTier, k: int) -> f32 {
  e := cascade_texel(t, k);
  return st_max(1, floor(t.step[k] / e + 0.5)) * e;
}
cascade_leash :: (t: CascadeTier, k: int) -> f32 { return cascade_step(t, k) * (0.5 + CASCADE_SLACK); }
// The reach a tile is good for round the eye: its own less the leash (the shader picks by the
// tile itself, so this is what the splits come to).
cascade_use :: (t: CascadeTier, k: int) -> f32 { return t.reach[k] - cascade_leash(t, k); }
// How far the light may turn (radians) before a tile is drawn again: half a texel's shift under
// a CASCADE_CASTER-metre caster.
cascade_turn :: (t: CascadeTier, k: int) -> f32 { return 0.5 * cascade_texel(t, k) / CASCADE_CASTER; }
// The depth a tile holds along the light (m): four of its reaches, never under 240 m (the one
// map's), so a tall caster up-light of a near tile still lands in it.
cascade_span :: (t: CascadeTier, k: int) -> f32 { return 4 * st_max(t.reach[k], 60); }

CascadeSlot :: struct {
  drawn: bool;          // holds a picture of the world
  cx: f32; cy: f32;     // its snapped middle, along the light's ax and ay
  lx: f32; ly: f32; lz: f32;   // the light it was drawn from
  age: int;             // frames since it was drawn
  stale: bool;          // geometry installed since
}
CascadeState :: struct {
  on: bool; phone: bool; tier: CascadeTier;
  slot: [CASCADE_MAX] CascadeSlot;
  frame: int; pending: bool; last_stale: int;
  draw: int;            // the tile drawn this frame, -1 none
  draws: int;           // tiles drawn since opened
}

// The host made the atlas (cascade_atlas texels): every tile is empty and is drawn in turn.
cascade_open :: (s: [] CascadeState, phone: bool) {
  s[0].on = true; s[0].phone = phone; s[0].tier = cascade_tier(phone);
  for k: 0..<CASCADE_MAX { s[0].slot[k] = CascadeSlot.{}; }
  s[0].frame = 0; s[0].pending = false; s[0].last_stale = -CASCADE_STALE_FRAMES; s[0].draw = -1; s[0].draws = 0;
}
// Geometry installed (a pack, a page, an edit): every tile is drawn again, rate-limited.
cascade_stale :: (s: [] CascadeState) { s[0].pending = true; }
// The host could not draw the tile this frame asked for: it is empty again.
cascade_dropped :: (s: [] CascadeState) {
  d := s[0].draw;
  if d >= 0 && d < CASCADE_MAX { s[0].slot[d].drawn = false; }
  s[0].draw = -1;
}

// The light's level axis ax (its y 0) and ay across it, for a light toward (lx, ly, lz):
// light.coax light_space's.
// An empty tile's light (0, 0, 0) takes straight overhead's.
cascade_axes :: (lx: f32, ly: f32, lz: f32) -> LightSpace {
  s: LightSpace;
  s.axx = 1; s.reach = 1; s.texel = 1;
  n := sqrt(lz * lz + lx * lx);
  if abs(ly) < 0.999 && n > 0.000001 { s.axx = lz / n; s.axz = -lx / n; }
  s.ayx = ly * s.axz; s.ayy = lz * s.axx - lx * s.axz; s.ayz = -ly * s.axx;
  return s;
}
// A point (x, z on the ground) along ax (`which` 0) or ay (1).
cascade_along :: (a: LightSpace, x: f32, z: f32, which: int) -> f32 {
  return ifx which == 0 then x * a.axx + z * a.axz else x * a.ayx + z * a.ayz;
}
// x snapped to a whole step.
cascade_snap :: (x: f32, step: f32) -> f32 { return floor(x / st_max(step, 0.000001) + 0.5) * step; }

// How much tile k wants drawing now: 3 empty, 2 its view changed (moved, turned or stale), 1 the
// nearest with movers in it, 0 not at all.
cascade_want :: (s: CascadeState, k: int, eye_x: f32, eye_z: f32, lx: f32, ly: f32, lz: f32, movers: bool) -> int {
  q := s.slot[k];
  if !q.drawn { return 3; }
  if q.stale { return 2; }
  if q.lx * lx + q.ly * ly + q.lz * lz < cos(cascade_turn(s.tier, k)) { return 2; }
  a := cascade_axes(q.lx, q.ly, q.lz);
  leash := cascade_leash(s.tier, k);
  if abs(cascade_along(a, eye_x, eye_z, 0) - q.cx) > leash || abs(cascade_along(a, eye_x, eye_z, 1) - q.cy) > leash { return 2; }
  if k == 0 && movers { return 1; }
  return 0;
}

// The frame: which tile to draw (-1 none), drawn at the eye (x, z) and the light toward (lx, ly,
// lz, a unit vector). The tile's rows change to its new view now; the host draws it this frame.
cascade_frame :: (s: [] CascadeState, eye_x: f32, eye_z: f32, lx: f32, ly: f32, lz: f32, movers: bool) -> int {
  s[0].draw = -1;
  if !s[0].on { return -1; }
  s[0].frame += 1;
  t := s[0].tier;
  if s[0].pending && s[0].frame - s[0].last_stale >= CASCADE_STALE_FRAMES {
    for k: 0..<t.count { s[0].slot[k].stale = true; }
    s[0].pending = false; s[0].last_stale = s[0].frame;
  }
  best := -1; best_want := 0; best_age := -1;
  for k: 0..<t.count {
    q := s[0].slot[k];
    if q.drawn && q.age < 1000000 { s[0].slot[k].age = q.age + 1; }
    // a light turned right round leaves a tile showing the wrong world: empty it
    if q.drawn && q.lx * lx + q.ly * ly + q.lz * lz < cos(CASCADE_LOST_TURN) { s[0].slot[k].drawn = false; }
    w := cascade_want(s[0], k, eye_x, eye_z, lx, ly, lz, movers);
    if w == 0 { continue; }
    age := s[0].slot[k].age;
    if s[0].slot[k].drawn && age < t.period[k] { continue; }
    // empty tiles go nearest first; others by how long they have waited, the nearer on a tie
    if w > best_want || (w == best_want && w < 3 && age > best_age) { best = k; best_want = w; best_age = age; }
  }
  if best < 0 { return -1; }
  a := cascade_axes(lx, ly, lz);
  step := cascade_step(t, best);
  s[0].slot[best] = CascadeSlot.{drawn = true, cx = cascade_snap(cascade_along(a, eye_x, eye_z, 0), step), cy = cascade_snap(cascade_along(a, eye_x, eye_z, 1), step), lx = lx, ly = ly, lz = lz, age = 0, stale = false};
  s[0].draw = best; s[0].draws += 1;
  return best;
}

// Tile k's place in the atlas, in its texels: x, y (from the top left), w, h.
cascade_rect_px :: (t: CascadeTier, k: int, which: int) -> int {
  col := k % t.cols; row := k / t.cols; size := cast(int) t.tile;
  if which == 0 { return col * size; }
  if which == 1 { return row * size; }
  return size;
}

// The shader's block: the header (count, 0 when off; the tile drawn now, -1 none; the atlas's w
// and h in texels), then CASCADE_FLOATS a tile:
//   0  its rect in the atlas's uv: x, y (down), w, h
//   4  across the tile, -1 to 1: ax / reach and -cx / reach (dot it with (x, y, z, 1))
//   8  up the tile: ay / reach and -cy / reach
//   12 depth, 0 toward the light: -l / span and 0.5
//   16 the filter: its radius in the atlas's uv (u, v), the depth bias, the normal offset (m)
//   20 the edge the filter keeps clear (of the tile's -1 to 1), 1 when it holds a picture, its texel (m), 0
// `radius` is the preset's filter radius in texels of the one map, `base_texel` that map's texel
// (m) and `base_reach` its reach: a tile keeps the same penumbra in metres, the same bias and the
// same normal offset (more where its texels are coarser).
cascade_rows :: (s: CascadeState, out: [] f32, radius: f32, base_texel: f32, base_reach: f32) {
  for i: 0..<CASCADE_BLOCK { out[i] = 0; }
  if !s.on { return; }
  t := s.tier;
  out[0] = cast(f32) t.count; out[1] = cast(f32) s.draw;
  aw := t.tile * cast(f32) t.cols; ah := t.tile * cast(f32) t.rows;
  out[2] = aw; out[3] = ah;
  for k: 0..<t.count {
    q := s.slot[k]; o := CASCADE_HEADER + k * CASCADE_FLOATS;
    r := t.reach[k]; span := cascade_span(t, k); texel := cascade_texel(t, k);
    a := cascade_axes(q.lx, q.ly, q.lz);
    out[o] = cast(f32) cascade_rect_px(t, k, 0) / aw; out[o + 1] = cast(f32) cascade_rect_px(t, k, 1) / ah;
    out[o + 2] = t.tile / aw; out[o + 3] = t.tile / ah;
    out[o + 4] = a.axx / r; out[o + 5] = 0; out[o + 6] = a.axz / r; out[o + 7] = -q.cx / r;
    out[o + 8] = a.ayx / r; out[o + 9] = a.ayy / r; out[o + 10] = a.ayz / r; out[o + 11] = -q.cy / r;
    out[o + 12] = -q.lx / span; out[o + 13] = -q.ly / span; out[o + 14] = -q.lz / span; out[o + 15] = 0.5;
    coarse := st_max(1, texel / st_max(base_texel, 0.000001));
    taps := st_max(radius * 1.6, radius * 1.6 * base_texel / texel);   // texels of the tile
    out[o + 16] = taps / aw; out[o + 17] = taps / ah;
    out[o + 18] = 0.0006 * 4 * base_reach * coarse / span;
    out[o + 19] = 0.08 * coarse;
    out[o + 20] = 2 * (taps + 1.5) / t.tile;
    out[o + 21] = ifx q.drawn then 1.0f32 else 0.0f32;
    out[o + 22] = texel;
  }
}
// Tile k's rows into the atlas's own -1 to 1 (y up), for a caster or reader that maps a point
// once (the character pass): 12 floats, across, up and depth, each dotted with (x, y, z, 1).
cascade_atlas_rows :: (s: CascadeState, k: int, radius: f32, base_texel: f32, base_reach: f32, out: [] f32) {
  b: [CASCADE_BLOCK] f32;
  cascade_rows(s, b[..], radius, base_texel, base_reach);
  o := CASCADE_HEADER + k * CASCADE_FLOATS;
  sx := b[o + 2]; ox := 2 * b[o] + b[o + 2] - 1;
  sy := b[o + 3]; oy := 1 - 2 * b[o + 1] - b[o + 3];
  for i: 0..<4 { out[i] = b[o + 4 + i] * sx; out[4 + i] = b[o + 8 + i] * sy; out[8 + i] = b[o + 12 + i]; }
  out[3] += ox; out[7] += oy;
}

// Which tile holds the point (x, y, z) with its filter, as the shader picks: the finest one
// drawn, -1 none (lit).
cascade_pick :: (b: [] f32, x: f32, y: f32, z: f32) -> int {
  n := cast(int) b[0];
  for k: 0..<n {
    o := CASCADE_HEADER + k * CASCADE_FLOATS;
    if b[o + 21] < 0.5 { continue; }
    qx := b[o + 4] * x + b[o + 5] * y + b[o + 6] * z + b[o + 7];
    qy := b[o + 8] * x + b[o + 9] * y + b[o + 10] * z + b[o + 11];
    qz := b[o + 12] * x + b[o + 13] * y + b[o + 14] * z + b[o + 15];
    edge := 1 - b[o + 20];
    if abs(qx) < edge && abs(qy) < edge && qz > 0 && qz < 1 { return k; }
  }
  return -1;
}

// ---- checks
cascade_test_light :: (i: int) -> LightKey { return light_key(-0.9, 1.1, 0.3, -0.05, 0.3 + cast(f32) i * 0.0007); }
cascade_test_open :: (phone: bool) -> CascadeState {
  s: [1] CascadeState; cascade_open(s[..], phone);
  return s[0];
}
// Runs frames until every tile is drawn, standing at (x, z) under light k.
cascade_test_fill :: (s: [] CascadeState, x: f32, z: f32, k: LightKey) {
  for i: 0..<64 { _ := cascade_frame(s, x, z, k.x, k.y, k.z, false); }
}

#test "the tiers: four tiles on a desktop in a 2048 atlas, two on a phone in 1536 by 768" {
  d := cascade_tier(false); p := cascade_tier(true);
  #assert d.count == 4 && p.count == 2;
  #assert cascade_atlas(false, 0) == 2048 && cascade_atlas(false, 1) == 2048;
  #assert cascade_atlas(true, 0) == 1536 && cascade_atlas(true, 1) == 768;
  // each tile reaches further and redraws no more often than the one inside it
  for k: 1..<d.count { #assert d.reach[k] > d.reach[k - 1] && d.period[k] > d.period[k - 1] && cascade_use(d, k) > cascade_use(d, k - 1); }
  #assert p.reach[1] > p.reach[0] && p.period[1] > p.period[0];
  // the near tile is sharper than the one map (120 m over 2048 texels), and the far reaches further than its 60 m
  #assert cascade_texel(d, 0) < 120.0f32 / 2048 && cascade_use(d, d.count - 1) > 60 && cascade_use(p, p.count - 1) > 40;
  #assert cascade_texel(p, 0) < 80.0f32 / 1024;
  // the tiles in the atlas: across, then down
  #assert cascade_rect_px(d, 0, 0) == 0 && cascade_rect_px(d, 1, 0) == 1024 && cascade_rect_px(d, 2, 1) == 1024 && cascade_rect_px(d, 3, 0) == 1024 && cascade_rect_px(d, 3, 1) == 1024 && cascade_rect_px(d, 2, 2) == 1024;
  #assert cascade_rect_px(p, 1, 0) == 768 && cascade_rect_px(p, 1, 1) == 0;
}
#test "a tile's step is a whole number of texels, never under one, and its leash half a step and the slack" {
  d := cascade_tier(false);
  for k: 0..<d.count {
    n := cascade_step(d, k) / cascade_texel(d, k);
    #assert abs(n - floor(n + 0.5)) < 0.001f32 && n >= 1;
    #assert abs(cascade_step(d, k) - d.step[k]) <= cascade_texel(d, k) * 0.5f32 + 0.0001f32;
    #assert abs(cascade_leash(d, k) - cascade_step(d, k) * 0.625f32) < 0.0001f32;
  }
  t := d; t.step[0] = 0.001;   // a step under a texel is one texel
  #assert abs(cascade_step(t, 0) - cascade_texel(t, 0)) < 0.000001f32;
  #assert cascade_snap(7.9, 4) == 8 && cascade_snap(5.9, 4) == 4 && cascade_snap(-6.1, 4) == -8;
  #assert abs(cascade_turn(d, 0) - cascade_texel(d, 0) * 0.05f32) < 0.000001f32;
  #assert cascade_span(d, 0) == 240 && cascade_span(d, 3) == 1440;
}
#test "the axes are light_space's, and an empty tile's light is overhead's" {
  n := sqrt(0.3f32 * 0.3f32 + 0.8f32 * 0.8f32 + 0.5f32 * 0.5f32);
  lx := 0.3f32 / n; ly := 0.8f32 / n; lz := 0.5f32 / n;
  a := cascade_axes(lx, ly, lz); b := light_space(lx, ly, lz, 0, 0, 1, 1);
  #assert a.axx == b.axx && a.axz == b.axz && a.ayx == b.ayx && a.ayy == b.ayy && a.ayz == b.ayz;
  up := cascade_axes(0, 1, 0); none := cascade_axes(0, 0, 0); side := cascade_axes(0.0447, 0.999, 0);
  #assert up.axx == 1 && up.axz == 0 && up.ayz == -1 && none.axx == 1 && none.axz == 0 && none.ayy == 0 && side.axx == 1;
}
#test "closed, it draws nothing and writes a zero block" {
  s: [1] CascadeState;
  #assert cascade_frame(s[..], 0, 0, 0, 1, 0, true) == -1 && s[0].frame == 0;
  b: [CASCADE_BLOCK] f32; b[0] = 9;
  cascade_rows(s[0], b[..], 2, 0.0586, 60);
  for i: 0..<CASCADE_BLOCK { #assert b[i] == 0; }
}
#test "opened, every tile is drawn once, one a frame, the nearest first" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(0);
  seen: [CASCADE_MAX] int;
  for i: 0..<4 {
    d := cascade_frame(s[..], 3, 4, k.x, k.y, k.z, false);
    #assert d == i;
    seen[d] += 1;
  }
  for i: 0..<4 { #assert seen[i] == 1 && s[0].slot[i].drawn; }
  #assert cascade_frame(s[..], 3, 4, k.x, k.y, k.z, false) == -1 && s[0].draws == 4;
}
#forall "a still eye under a still light never draws again, desktop or phone, wherever it stands" i: 0..<48 {
  s: [1] CascadeState; cascade_open(s[..], i % 2 == 1);
  k := cascade_test_light(i * 37);
  x := cast(f32) (i * 13 % 97) - 48.5; z := cast(f32) (i * 29 % 89) - 44.25;
  cascade_test_fill(s[..], x, z, k);
  before := s[0].draws;
  for f: 0..<120 { #assert cascade_frame(s[..], x, z, k.x, k.y, k.z, false) == -1; }
  #assert s[0].draws == before && before == s[0].tier.count;
}
#test "an eye that sways inside the slack never draws again" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(3);
  cascade_test_fill(s[..], 0.0, 0.0, k);
  // a few centimetres of bob and sway
  for f: 0..<600 {
    x := 0.05f32 * sin(cast(f32) f * 0.37); z := 0.04f32 * cos(cast(f32) f * 0.23);
    #assert cascade_frame(s[..], x, z, k.x, k.y, k.z, false) == -1;
  }
}
#test "movers keep the nearest tile drawing, and only it" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(5);
  cascade_test_fill(s[..], 1, 1, k);
  for f: 0..<50 { #assert cascade_frame(s[..], 1, 1, k.x, k.y, k.z, true) == 0; }
  p: [1] CascadeState; cascade_open(p[..], true);
  cascade_test_fill(p[..], 1, 1, k);
  for f: 0..<50 { #assert cascade_frame(p[..], 1, 1, k.x, k.y, k.z, true) == 0; }
}
#test "walking draws each tile as the eye leaves it, never more than one a frame, the far ones least" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(7);
  cascade_test_fill(s[..], 0, 0, k);
  count: [CASCADE_MAX] int; last: [CASCADE_MAX] int; longest: [CASCADE_MAX] int;
  for f: 0..<3600 {   // a minute at 60 frames a second, walking at 5 m/s with movers about
    x := cast(f32) f * (5.0f32 / 60); z := cast(f32) f * (1.5f32 / 60);
    d := cascade_frame(s[..], x, z, k.x, k.y, k.z, true);
    #assert d >= -1 && d < 4;
    if d >= 0 {
      count[d] += 1;
      if f - last[d] > longest[d] { longest[d] = f - last[d]; }
      last[d] = f;
    }
    // no tile ever falls further behind the eye than its use
    // (the far ones wait their periods: at most a couple of metres past their leash)
    for j: 0..<4 {
      q := s[0].slot[j]; a := cascade_axes(q.lx, q.ly, q.lz);
      #assert abs(cascade_along(a, x, z, 0) - q.cx) <= cascade_leash(s[0].tier, j) + 2.5f32;
      #assert abs(cascade_along(a, x, z, 1) - q.cy) <= cascade_leash(s[0].tier, j) + 2.5f32;
    }
  }
  #assert count[0] > count[1] && count[1] > count[2] && count[2] > count[3] && count[3] > 0;
  // the nearest is held back at most a frame or two by the far ones
  #assert longest[0] <= 4;
  // and the farthest is drawn a few times a minute, not every frame
  #assert count[3] < 60 && count[2] < 120;
}
#test "the light turning draws each tile again past its own limit, the far ones less often" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(0);
  cascade_test_fill(s[..], 0, 0, k);
  count: [CASCADE_MAX] int;
  // a 48-minute day turns the sun about 0.0022 radians a second: an hour of frames at that rate
  for f: 0..<3600 {
    c := 0.3f32 + cast(f32) f * (1.0f32 / (2880 * 60));
    l := light_key(-0.9, 1.1, 0.3, -0.05, c);
    d := cascade_frame(s[..], 0, 0, l.x, l.y, l.z, false);
    if d >= 0 { count[d] += 1; }
  }
  #assert count[0] > count[1] && count[1] > count[2] && count[2] >= count[3] && count[0] < 60 && count[3] >= 0;
  #assert count[0] > 0 && count[1] > 0;
}
#test "the moon taking over from the sun empties every tile until each is drawn again" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(0);
  cascade_test_fill(s[..], 0, 0, k);
  d := cascade_frame(s[..], 0, 0, -k.x, -k.y, -k.z, false);
  #assert d == 0;
  for i: 1..<4 { #assert !s[0].slot[i].drawn; }
  b: [CASCADE_BLOCK] f32;
  cascade_rows(s[0], b[..], 2, 0.0586, 60);
  #assert b[CASCADE_HEADER + 21] == 1 && b[CASCADE_HEADER + CASCADE_FLOATS + 21] == 0;
}
#test "installed geometry draws every tile again, at most once in CASCADE_STALE_FRAMES" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(2);
  cascade_test_fill(s[..], 0, 0, k);
  base := s[0].draws;
  cascade_stale(s[..]);
  drawn := 0;
  for f: 0..<CASCADE_STALE_FRAMES * 4 {
    cascade_stale(s[..]);   // a page every frame
    if cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) >= 0 { drawn += 1; }
  }
  // four tiles every CASCADE_STALE_FRAMES frames at most, never every frame
  #assert drawn > 0 && drawn <= 4 * 5 && s[0].draws == base + drawn;
  // once it settles, nothing more
  for f: 0..<CASCADE_STALE_FRAMES * 2 { _ := cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false); }
  for f: 0..<100 { #assert cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == -1; }
}
#test "a dropped draw empties that tile, and it is drawn again next" {
  s: [1] CascadeState; cascade_open(s[..], true);
  k := cascade_test_light(1);
  #assert cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == 0;
  cascade_dropped(s[..]);
  #assert !s[0].slot[0].drawn && s[0].draw == -1;
  #assert cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == 0;
  cascade_dropped(s[..]); cascade_dropped(s[..]);   // twice is once
  #assert cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == 0 && cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == 1;
}
#test "a tile's rows put its middle at its centre and a point a reach away at its edge" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(4);
  cascade_test_fill(s[..], 12.3, -7.7, k);
  b: [CASCADE_BLOCK] f32;
  cascade_rows(s[0], b[..], 2, 120.0f32 / 2048, 60);
  #assert b[0] == 4 && b[1] == -1 && b[2] == 2048 && b[3] == 2048;
  for j: 0..<4 {
    o := CASCADE_HEADER + j * CASCADE_FLOATS; q := s[0].slot[j]; a := cascade_axes(q.lx, q.ly, q.lz);
    r := s[0].tier.reach[j];
    // the middle in the world, on the ground plane's light space
    mx := q.cx * a.axx + q.cy * a.ayx; my := q.cy * a.ayy; mz := q.cx * a.axz + q.cy * a.ayz;
    qx := b[o + 4] * mx + b[o + 5] * my + b[o + 6] * mz + b[o + 7];
    qy := b[o + 8] * mx + b[o + 9] * my + b[o + 10] * mz + b[o + 11];
    qz := b[o + 12] * mx + b[o + 13] * my + b[o + 14] * mz + b[o + 15];
    #assert abs(qx) < 0.0005f32 && abs(qy) < 0.0005f32 && abs(qz - 0.5f32) < 0.0005f32;
    ex := mx + a.axx * r; ez := mz + a.axz * r;
    #assert abs(b[o + 4] * ex + b[o + 6] * ez + b[o + 7] - 1) < 0.0005f32;
    // the rect, the filter's reach and the edge it keeps clear
    #assert b[o + 2] == 0.5 && b[o + 3] == 0.5 && b[o + 21] == 1;
    #assert b[o] == (ifx j % 2 == 1 then 0.5f32 else 0.0f32) && b[o + 1] == (ifx j >= 2 then 0.5f32 else 0.0f32);
    #assert b[o + 16] * 2048 >= 3.2f32 - 0.0001f32 && b[o + 20] > 0 && b[o + 20] < 0.05f32;
    #assert abs(b[o + 22] - cascade_texel(s[0].tier, j)) < 0.000001f32;
  }
  // the near tile's bias and normal offset are the one map's; the far ones' grow with their texels
  #assert abs(b[CASCADE_HEADER + 18] - 0.0006f32) < 0.000001f32 && abs(b[CASCADE_HEADER + 19] - 0.08f32) < 0.000001f32;
  far := CASCADE_HEADER + 3 * CASCADE_FLOATS;
  #assert b[far + 19] > 0.5f32 && b[far + 18] * cascade_span(s[0].tier, 3) > 1;
  // the near tile keeps the one map's penumbra in metres: 3.2 of its texels, a little more of the finer tile's
  #assert abs(b[CASCADE_HEADER + 16] * 2048 * cascade_texel(s[0].tier, 0) - 3.2f32 * 120 / 2048) < 0.0005f32;
}
#test "the shader's pick: the finest tile that holds a point with its filter, none outside them all" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(6);
  cascade_test_fill(s[..], 0, 0, k);
  b: [CASCADE_BLOCK] f32;
  cascade_rows(s[0], b[..], 2, 120.0f32 / 2048, 60);
  #assert cascade_pick(b[..], 0, 0, 0) == 0 && cascade_pick(b[..], 3, 1, -4) == 0;
  // along the light's level axis a tile covers its reach exactly
  a := cascade_axes(k.x, k.y, k.z);
  #assert cascade_pick(b[..], 40 * a.axx, 0, 40 * a.axz) == 1 && cascade_pick(b[..], 100 * a.axx, 0, 100 * a.axz) == 2;
  #assert cascade_pick(b[..], 250 * a.axx, 0, 250 * a.axz) == 3 && cascade_pick(b[..], 900 * a.axx, 0, 900 * a.axz) == -1;
  // within each tile's use of the eye, every point is in that tile or a finer one
  for j: 0..<4 {
    u := cascade_use(s[0].tier, j) * 0.7f32;
    for i: 0..<16 {
      turn := cast(f32) i * 0.3927f32;
      p := cascade_pick(b[..], u * cos(turn), 0.5, u * sin(turn));
      #assert p >= 0 && p <= j;
    }
  }
  // an empty tile is passed over
  b[CASCADE_HEADER + 21] = 0;
  #assert cascade_pick(b[..], 0, 0, 0) == 1;
}
#test "the atlas rows map a tile's -1 to 1 into its quarter of the atlas" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(8);
  cascade_test_fill(s[..], 2, 2, k);
  b: [CASCADE_BLOCK] f32;
  cascade_rows(s[0], b[..], 2, 120.0f32 / 2048, 60);
  for j: 0..<4 {
    r: [12] f32;
    cascade_atlas_rows(s[0], j, 2, 120.0f32 / 2048, 60, r[..]);
    o := CASCADE_HEADER + j * CASCADE_FLOATS;
    x := 5.5f32; y := 1.25f32; z := -3.0f32;
    tx := b[o + 4] * x + b[o + 5] * y + b[o + 6] * z + b[o + 7];
    ty := b[o + 8] * x + b[o + 9] * y + b[o + 10] * z + b[o + 11];
    ax := r[0] * x + r[1] * y + r[2] * z + r[3];
    ay := r[4] * x + r[5] * y + r[6] * z + r[7];
    // the atlas uv the shader reads (rect + tile uv) is the same point
    u := b[o] + (tx * 0.5f32 + 0.5f32) * b[o + 2]; v := b[o + 1] + (0.5f32 - ty * 0.5f32) * b[o + 3];
    #assert abs((ax * 0.5f32 + 0.5f32) - u) < 0.00001f32 && abs((0.5f32 - ay * 0.5f32) - v) < 0.00001f32;
    #assert abs(r[8] * x + r[9] * y + r[10] * z + r[11] - (b[o + 12] * x + b[o + 13] * y + b[o + 14] * z + b[o + 15])) < 0.000001f32;
  }
}
#test "the tier tables are the ones the issue and the atlas sizes were set from" {
  d := cascade_tier(false); p := cascade_tier(true);
  #assert d.tile == 1024 && d.cols == 2 && d.rows == 2 && p.tile == 768 && p.cols == 2 && p.rows == 1;
  #assert d.reach[0] == 24 && d.reach[1] == 60 && d.reach[2] == 150 && d.reach[3] == 360;
  #assert d.step[0] == 8 && d.step[1] == 20 && d.step[2] == 50 && d.step[3] == 120;
  #assert d.period[0] == 1 && d.period[1] == 3 && d.period[2] == 6 && d.period[3] == 12;
  #assert p.reach[0] == 20 && p.reach[1] == 75 && p.step[0] == 6 && p.step[1] == 24 && p.period[0] == 1 && p.period[1] == 6;
}
// The ground point (x, z) at (u, v) along a's ax and ay.
cascade_test_at :: (a: LightSpace, u: f32, v: f32, which: int) -> f32 {
  det := a.axx * a.ayz - a.axz * a.ayx;
  return ifx which == 0 then (u * a.ayz - a.axz * v) / det else (a.axx * v - a.ayx * u) / det;
}
#test "a tile is drawn again just past its leash along either axis, and not just inside it" {
  for which: 0..<2 {
    for j: 0..<4 {
      for past: 0..<2 {
        s: [1] CascadeState; cascade_open(s[..], false);
        k := cascade_test_light(9);
        cascade_test_fill(s[..], 0, 0, k);
        for f: 0..<20 { _ := cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false); }   // every period passed
        q := s[0].slot[j]; a := cascade_axes(q.lx, q.ly, q.lz);
        m := cascade_leash(s[0].tier, j) + (ifx past == 1 then 0.05f32 else -0.05f32);
        u := q.cx + (ifx which == 0 then m else 0.0f32); v := q.cy + (ifx which == 1 then m else 0.0f32);
        ex := cascade_test_at(a, u, v, 0); ez := cascade_test_at(a, u, v, 1);
        d := cascade_frame(s[..], ex, ez, k.x, k.y, k.z, false);
        // tiles inside j are drawn first when they too are past theirs
        if past == 0 { #assert cascade_want(s[0], j, ex, ez, k.x, k.y, k.z, false) == 0; }
        if past == 1 { #assert d >= 0 && d <= j; }
        if past == 1 && j == 0 { #assert d == 0 && s[0].slot[0].cx == cascade_snap(cascade_along(a, ex, ez, 0), cascade_step(s[0].tier, 0)); }
      }
    }
  }
}
#test "installed geometry redraws on the first frame and then exactly CASCADE_STALE_FRAMES later" {
  s: [1] CascadeState; cascade_open(s[..], true);
  k := cascade_test_light(2);
  cascade_test_fill(s[..], 0, 0, k);
  cascade_stale(s[..]);
  #assert cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == 0 && s[0].slot[1].stale;
  for f: 0..<8 { _ := cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false); }
  #assert !s[0].slot[0].stale && !s[0].slot[1].stale;
  cascade_stale(s[..]);
  first := s[0].last_stale;
  for f: 0..<200 {
    if cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) >= 0 { #assert s[0].frame - first == CASCADE_STALE_FRAMES; break; }
  }
  #assert s[0].last_stale == first + CASCADE_STALE_FRAMES;
}
#test "a tile waits out its period: the far tile stale is not drawn until it has aged twelve frames" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(3);
  cascade_test_fill(s[..], 0, 0, k);
  s[0].slot[3].age = 0; s[0].slot[3].stale = true;
  for f: 0..<11 { #assert cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == -1; }
  #assert cascade_frame(s[..], 0, 0, k.x, k.y, k.z, false) == 3;
}
#test "the pick keeps a point to a tile's depth: past it, the deeper tile holds it" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(6);
  cascade_test_fill(s[..], 0, 0, k);
  b: [CASCADE_BLOCK] f32;
  cascade_rows(s[0], b[..], 2, 120.0f32 / 2048, 60);
  // straight up and down the light from the middle: 240 m deep for the two near tiles, 600 m for the next
  #assert cascade_pick(b[..], k.x * 100, k.y * 100, k.z * 100) == 0 && cascade_pick(b[..], -k.x * 100, -k.y * 100, -k.z * 100) == 0;
  #assert cascade_pick(b[..], k.x * 144, k.y * 144, k.z * 144) == 2 && cascade_pick(b[..], -k.x * 144, -k.y * 144, -k.z * 144) == 2;
  #assert cascade_pick(b[..], k.x * 800, k.y * 800, k.z * 800) == -1;
}
#test "opening again forgets every tile, and a phone's atlas is twice as wide as tall in its rows" {
  s: [1] CascadeState; cascade_open(s[..], false);
  k := cascade_test_light(10);
  cascade_test_fill(s[..], 5, 5, k);
  cascade_stale(s[..]); _ := cascade_frame(s[..], 5, 5, k.x, k.y, k.z, false);
  cascade_stale(s[..]);
  cascade_open(s[..], true);
  #assert s[0].phone && s[0].tier.count == 2 && s[0].frame == 0 && !s[0].pending && s[0].draw == -1 && s[0].draws == 0 && s[0].last_stale == -CASCADE_STALE_FRAMES;
  for j: 0..<CASCADE_MAX { #assert !s[0].slot[j].drawn && !s[0].slot[j].stale && s[0].slot[j].age == 0 && s[0].slot[j].cx == 0; }
  // a stale mark right after opening is taken on the first frame
  cascade_stale(s[..]);
  #assert cascade_frame(s[..], 5, 5, k.x, k.y, k.z, false) == 0 && !s[0].pending;
  _ = cascade_frame(s[..], 5, 5, k.x, k.y, k.z, false);
  b: [CASCADE_BLOCK] f32;
  cascade_rows(s[0], b[..], 2, 120.0f32 / 2048, 60);
  #assert b[0] == 2 && b[2] == 1536 && b[3] == 768;
  o := CASCADE_HEADER + CASCADE_FLOATS;
  #assert b[o] == 0.5 && b[o + 1] == 0 && b[o + 2] == 0.5 && b[o + 3] == 1;
  #assert abs(b[o + 16] * 1536 - b[o + 17] * 768) < 0.0001f32 && b[o + 16] < b[o + 17];
  #assert abs(b[o + 20] - 2 * (b[o + 16] * 1536 + 1.5f32) / 768) < 0.0001f32;
}
