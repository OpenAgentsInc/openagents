// Cluster culling on the GPU (GitHub #13008, Valley Lab step 6), learned from Solstice's
// shaders/vg/cull.wgsl (docs/verse/2026-11-07-solstice-comparison.md). These procedures are the
// compute and draw entries of apps/openagents-web/gpu/cull.coax and gpu/cull-draw.coax, which
// `coax wgsl` writes as WGSL; here they run on the CPU, one invocation at a time, for the checks.
//
// A frame, as coax/web/cull-lab.js runs it:
//   1. cl_cull_one, one invocation per cluster: the draw rule of metaverse-engine/render/geometry/dag.coax
//      over the installed pages, then the frustum, then last frame's depth pyramid. A cluster
//      that passes goes on the first draw list; one the pyramid hides goes on the retest list.
//      Each writes its page's request (atomicMax of a priority), and a drawn cluster that is too
//      coarse requests the page of the clusters it replaces. A hidden one writes only CL_KEEP.
//   2. The first draw list, one indirect draw (an instance a cluster, CL_VERTS vertices each).
//   3. cl_hiz_depth and cl_hiz_down: the depth pyramid from that depth, the farthest of each 2x2.
//   4. cl_cull_two over the retest list against the new pyramid: what it no longer hides goes on
//      the second draw list, drawn as 2 was.
// Requests are read back without blocking and go to the residency module (residency.coax).
// A shadow view runs cl_cull_shadow first: its casters' page requests, weighted by CL_WEIGHT.
// Each drawn cluster also writes its texture's wanted mip after the page entries (cl_texture).
// A pyramid built from part of the frame only hides less, so testing next frame's first phase
// against it is conservative.
//   coax/bin/coax test metaverse-engine/render/geometry/cull.coax --library
#load "../../gpu/shader.coax";

// The uniform block, 92 floats (23 vec4s).
CL_M :: 0;          // world to clip, 16 floats by columns (WebGPU depth: 0 near, 1 far)
CL_EYE :: 16;       // the eye, 3 floats
CL_T :: 19;         // the tolerance: error over distance (pixels times the view's radians a pixel)
CL_N :: 20;         // clusters
CL_PAGES :: 21;
CL_HIZ :: 22;       // 1 when the pyramid holds last frame's depth
CL_LEVELS :: 23;    // pyramid levels, at most CL_MAX_LEVELS
CL_VIEW :: 24;      // viewport width and height
CL_W0 :: 26;        // level 0's width and height: half the viewport, rounded up
CL_PLANES :: 28;    // six planes, each (normal, d): inside where dot(normal, p) + d >= 0
CL_OFFSET :: 52;    // each level's first float in the pyramid
CL_WIDTH :: 64;     // each level's width
CL_HEIGHT :: 76;    // each level's height
CL_SHADOW_D :: 88;  // 0 for the camera; for a shadow view (orthographic), the distance its error is over
CL_WEIGHT :: 89;    // how much this view's page requests count: 1 for the camera, less for a shadow view
CL_PIXEL :: 90;     // the view's radians a pixel, for texture demand
CL_MIPS :: 91;      // mip levels a texture has
CL_FLOATS :: 92;
CL_MAX_LEVELS :: 12;

// A cluster's words in info.
CI_PAGE :: 0; CI_CHILD :: 1; CI_FIRST :: 2; CI_COUNT :: 3; CI_ERROR :: 4; CI_PARENT_ERROR :: 5; CI_LEVEL :: 6; CI_ROOT :: 7;
CI_WORDS :: 8;
CL_NO_PAGE :: 0xFFFFFFFF;   // CI_CHILD of a finest cluster
// A cluster's vec4s in data: its own sphere, its parent's, then its own box (min, max). The box's
// w words carry its texture: low.w its UV density (texels a metre at mip 0, in quarter octaves),
// high.w its texture (-1: none).
CD_SELF :: 0; CD_PARENT :: 1; CD_LOW :: 2; CD_HIGH :: 3; CD_WORDS :: 4;
// The draws buffer: two drawIndirect argument sets, then counters.
CW_DRAW1 :: 0; CW_DRAW2 :: 4; CW_RETEST :: 8; CW_LOD :: 9; CW_FRUSTUM :: 10; CW_HIDDEN1 :: 11; CW_HIDDEN2 :: 12; CW_WORDS :: 16;
// The lists buffer, N words each: first draw list, second draw list, retest list, and each
// cluster's flags.
CL_LIST1 :: 0; CL_LIST2 :: 1; CL_RETEST :: 2; CL_FLAGS :: 3; CL_LISTS :: 4;
CF_LOD :: 1; CF_FRUSTUM :: 2; CF_HIDDEN1 :: 4; CF_DRAW1 :: 8; CF_DRAW2 :: 16; CF_HIDDEN2 :: 32;
// Requests: CL_KEEP keeps a page without loading it; anything above it loads, most first.
CL_KEEP :: 1;
CL_VERTS :: 384;    // a cluster's draw: 128 triangles at most
CL_NONE :: 999999999.0;  // a parent error at or past this is a root's (dag.coax's DAG_NONE)
CL_FAR :: 1.0e30;

// Error over the distance from eye to the sphere s (centre, radius); CL_FAR inside it, and for
// a root's parent.
cl_seen :: (error:f32,s:V4,u:[]f32)->f32 {
  if error>=CL_NONE {return CL_FAR;}
  if u[CL_SHADOW_D]>0.0f32 {return error/u[CL_SHADOW_D];}
  dx:=u[CL_EYE]-s.x;dy:=u[CL_EYE+1]-s.y;dz:=u[CL_EYE+2]-s.z;
  d:=sqrt(dx*dx+dy*dy+dz*dz)-s.w;
  if d<=0.000001f32 {return CL_FAR;}
  return error/d;
}
// The draw rule over installed pages (dag.coax's dag_draw): a cluster on an installed page is
// drawn when its parent is too coarse (or it is a root), and it is fine enough or the clusters it
// replaces are not installed.
cl_lod :: (c:int,u:[]f32,data:[]V4,info:[]u32,installed:[]u32)->bool {
  if installed[cast(int)info[c*CI_WORDS+CI_PAGE]]==0 {return false;}
  t:=u[CL_T];
  coarse:=info[c*CI_WORDS+CI_ROOT]!=0 || cl_seen(f32_from_bits(info[c*CI_WORDS+CI_PARENT_ERROR]),data[c*CD_WORDS+CD_PARENT],u)>t;
  if !coarse {return false;}
  child:=info[c*CI_WORDS+CI_CHILD];
  if child==CL_NO_PAGE {return true;}
  if cl_seen(f32_from_bits(info[c*CI_WORDS+CI_ERROR]),data[c*CD_WORDS+CD_SELF],u)<=t {return true;}
  return installed[cast(int)child]==0;
}
// How much a drawn cluster wants its page, or a coarse one the page under it: 2 and up, more as
// its projected error is further past the tolerance.
cl_priority :: (seen:f32,t:f32)->u32 {
  r:=seen/fmax(t,0.000001f32)*16.0f32;
  if r>1000000.0f32 {r=1000000.0f32;}
  return 2+cast(u32)fmax(r,0.0f32);
}
// Whether the box low..high is wholly outside one of the six planes.
cl_outside :: (low:V4,high:V4,u:[]f32)->bool {
  for k:0..<6 {
    at:=CL_PLANES+k*4;nx:=u[at];ny:=u[at+1];nz:=u[at+2];
    px:=ifx nx>=0.0f32 then high.x else low.x;py:=ifx ny>=0.0f32 then high.y else low.y;pz:=ifx nz>=0.0f32 then high.z else low.z;
    if nx*px+ny*py+nz*pz+u[at+3]<0.0f32 {return true;}
  }
  return false;
}
cl_clampi :: (x:int,low:int,high:int)->int {if x<low {return low;} if x>high {return high;} return x;}
// Whether the pyramid hides the box: its nearest depth is past the farthest depth of the pyramid
// texels it covers, at the level where it covers at most two each way. A box reaching behind the
// eye is never hidden.
cl_hidden :: (low:V4,high:V4,u:[]f32,hiz:[]f32)->bool {
  minx:f32=CL_FAR;miny:f32=CL_FAR;maxx:f32=-CL_FAR;maxy:f32=-CL_FAR;near:f32=CL_FAR;
  for k:0..<8 {
    p:=v4(ifx (k&1)!=0 then high.x else low.x,ifx (k&2)!=0 then high.y else low.y,ifx (k&4)!=0 then high.z else low.z,1.0f32);
    q:=m4_apply(m4_at(u,CL_M),p);
    if q.w<=0.0001f32 {return false;}
    x:=q.x/q.w;y:=q.y/q.w;z:=q.z/q.w;
    minx=fmin(minx,x);maxx=fmax(maxx,x);miny=fmin(miny,y);maxy=fmax(maxy,y);near=fmin(near,z);
  }
  if near<=0.0f32 {return false;}
  w0:=cast(int)u[CL_W0];h0:=cast(int)u[CL_W0+1];
  // level 0 texels: x right from the left edge, y down from the top
  x0:=cl_clampi(cast(int)floor((minx*0.5f32+0.5f32)*cast(f32)w0),0,w0-1);x1:=cl_clampi(cast(int)floor((maxx*0.5f32+0.5f32)*cast(f32)w0),0,w0-1);
  y0:=cl_clampi(cast(int)floor((0.5f32-maxy*0.5f32)*cast(f32)h0),0,h0-1);y1:=cl_clampi(cast(int)floor((0.5f32-miny*0.5f32)*cast(f32)h0),0,h0-1);
  level:=0;levels:=cast(int)u[CL_LEVELS];
  while (x1-x0>1 || y1-y0>1) && level<levels-1 {level+=1;x0=x0/2;x1=x1/2;y0=y0/2;y1=y1/2;}
  w:=cast(int)u[CL_WIDTH+level];at:=cast(int)u[CL_OFFSET+level];far:=0.0f32;
  for y:y0..<y1+1 {for x:x0..<x1+1 {far=fmax(far,hiz[at+y*w+x]);}}
  return near>far;
}

// Phase 1: cluster i against the draw rule, the frustum and last frame's pyramid.
cl_cull_one :: (i:u32,u:[]f32,data:[]V4,info:[]u32,installed:[]u32,requests:[]u32,draws:[]u32,lists:[]u32,hiz:[]f32) {
  c:=cast(int)i;n:=cast(int)u[CL_N];
  if c>=n {return;}
  lists[CL_FLAGS*n+c]=0;
  if !cl_lod(c,u,data,info,installed) {return;}
  _:=gpu_atomic_add(draws,CW_LOD,1);
  page:=cast(int)info[c*CI_WORDS+CI_PAGE];low:=data[c*CD_WORDS+CD_LOW];high:=data[c*CD_WORDS+CD_HIGH];
  if cl_outside(low,high,u) {
    _=gpu_atomic_add(draws,CW_FRUSTUM,1);_=gpu_atomic_max(requests,page,CL_KEEP);
    lists[CL_FLAGS*n+c]=CF_LOD|CF_FRUSTUM;return;
  }
  if u[CL_HIZ]>0.5f32 && cl_hidden(low,high,u,hiz) {
    k:=gpu_atomic_add(draws,CW_RETEST,1);lists[CL_RETEST*n+cast(int)k]=cast(u32)c;
    _=gpu_atomic_add(draws,CW_HIDDEN1,1);_=gpu_atomic_max(requests,page,CL_KEEP);
    lists[CL_FLAGS*n+c]=CF_LOD|CF_HIDDEN1;return;
  }
  k:=gpu_atomic_add(draws,CW_DRAW1+1,1);lists[CL_LIST1*n+cast(int)k]=cast(u32)c;
  cl_want(c,u,data,info,requests);cl_texture(c,u,data,requests);
  lists[CL_FLAGS*n+c]=CF_LOD|CF_DRAW1;
}
// A priority weighted by the view's CL_WEIGHT: still 2 and up, so it still loads.
cl_weigh :: (p:u32,u:[]f32)->u32 {return 2+cast(u32)(cast(f32)(p-2)*u[CL_WEIGHT]);}
// A drawn cluster's requests: its page, and the page under it when it is too coarse.
cl_want :: (c:int,u:[]f32,data:[]V4,info:[]u32,requests:[]u32) {
  t:=u[CL_T];page:=cast(int)info[c*CI_WORDS+CI_PAGE];
  _:=gpu_atomic_max(requests,page,cl_weigh(cl_priority(cl_seen(f32_from_bits(info[c*CI_WORDS+CI_PARENT_ERROR]),data[c*CD_WORDS+CD_PARENT],u),t),u));
  child:=info[c*CI_WORDS+CI_CHILD];
  if child==CL_NO_PAGE {return;}
  seen:=cl_seen(f32_from_bits(info[c*CI_WORDS+CI_ERROR]),data[c*CD_WORDS+CD_SELF],u);
  if seen>t {_=gpu_atomic_max(requests,cast(int)child,cl_weigh(cl_priority(seen,t),u));}
}
// The mip a drawn cluster's texture needs: its texels a pixel at the nearest point of its sphere
// are density x distance x the pixel's radians, and mip m holds 2^m of them. Written after the
// page entries as CL_MIPS - mip (atomicMax keeps the finest wanted; 0: not drawn).
cl_mip :: (c:int,u:[]f32,data:[]V4)->int {
  s:=data[c*CD_WORDS+CD_SELF];
  dx:=u[CL_EYE]-s.x;dy:=u[CL_EYE+1]-s.y;dz:=u[CL_EYE+2]-s.z;
  d:=fmax(sqrt(dx*dx+dy*dy+dz*dz)-s.w,0.0001f32);
  f:=data[c*CD_WORDS+CD_LOW].w*d*u[CL_PIXEL];mip:=0;mips:=cast(int)u[CL_MIPS];
  while f>=2.0f32 && mip<mips-1 {f=f*0.5f32;mip+=1;}
  return mip;
}
cl_texture :: (c:int,u:[]f32,data:[]V4,requests:[]u32) {
  tex:=data[c*CD_WORDS+CD_HIGH].w;
  if tex<0.0f32 || u[CL_MIPS]<1.0f32 {return;}
  _:=gpu_atomic_max(requests,cast(int)u[CL_PAGES]+cast(int)tex,cast(u32)(cast(int)u[CL_MIPS]-cl_mip(c,u,data)));
}
// A shadow view, one invocation per cluster: the draw rule and the light's frustum, then the
// page requests a drawn cluster makes, weighted by CL_WEIGHT. It draws nothing here and wants no
// textures; pages it alone wants still load, after the camera's.
cl_cull_shadow :: (i:u32,u:[]f32,data:[]V4,info:[]u32,installed:[]u32,requests:[]u32) {
  c:=cast(int)i;
  if c>=cast(int)u[CL_N] || !cl_lod(c,u,data,info,installed) || cl_outside(data[c*CD_WORDS+CD_LOW],data[c*CD_WORDS+CD_HIGH],u) {return;}
  cl_want(c,u,data,info,requests);
}
// Phase 2: retest entry i against the pyramid of this frame's first draw.
cl_cull_two :: (i:u32,u:[]f32,data:[]V4,info:[]u32,requests:[]u32,draws:[]u32,lists:[]u32,hiz:[]f32) {
  k:=cast(int)i;n:=cast(int)u[CL_N];
  if k>=cast(int)draws[CW_RETEST] {return;}
  c:=cast(int)lists[CL_RETEST*n+k];
  if cl_hidden(data[c*CD_WORDS+CD_LOW],data[c*CD_WORDS+CD_HIGH],u,hiz) {
    _:=gpu_atomic_add(draws,CW_HIDDEN2,1);lists[CL_FLAGS*n+c]=lists[CL_FLAGS*n+c]|CF_HIDDEN2;return;
  }
  j:=gpu_atomic_add(draws,CW_DRAW2+1,1);lists[CL_LIST2*n+cast(int)j]=cast(u32)c;
  cl_want(c,u,data,info,requests);cl_texture(c,u,data,requests);
  lists[CL_FLAGS*n+c]=lists[CL_FLAGS*n+c]|CF_DRAW2;
}
// Pyramid level 0, texel i: the farthest of the 2x2 depth texels under it.
cl_hiz_depth :: (i:u32,u:[]f32,depth:TexDepth,hiz:[]f32) {
  k:=cast(int)i;w0:=cast(int)u[CL_W0];h0:=cast(int)u[CL_W0+1];
  if k>=w0*h0 {return;}
  x:=k%w0;y:=k/w0;vw:=cast(int)u[CL_VIEW];vh:=cast(int)u[CL_VIEW+1];far:=0.0f32;
  for dy:0..<2 {for dx:0..<2 {
    far=fmax(far,gpu_load_depth(depth,cast(s32)cl_clampi(2*x+dx,0,vw-1),cast(s32)cl_clampi(2*y+dy,0,vh-1),0));
  }}
  hiz[cast(int)u[CL_OFFSET]+k]=far;
}
// Pyramid level hz[0], texel i: the farthest of the 2x2 texels of the level under it.
cl_hiz_down :: (i:u32,u:[]f32,hz:[]f32,hiz:[]f32) {
  k:=cast(int)i;l:=cast(int)hz[0];w:=cast(int)u[CL_WIDTH+l];h:=cast(int)u[CL_HEIGHT+l];
  if l<1 || l>=CL_MAX_LEVELS || k>=w*h {return;}
  x:=k%w;y:=k/w;sw:=cast(int)u[CL_WIDTH+l-1];sh:=cast(int)u[CL_HEIGHT+l-1];from:=cast(int)u[CL_OFFSET+l-1];far:=0.0f32;
  for dy:0..<2 {for dx:0..<2 {far=fmax(far,hiz[from+cl_clampi(2*y+dy,0,sh-1)*sw+cl_clampi(2*x+dx,0,sw-1)]);}}
  hiz[cast(int)u[CL_OFFSET+l]+k]=far;
}

// Drawing a list: instance iid is list entry du[16] + iid, vertex vid its triangle vid / 3's
// corner. Past the cluster's triangles every corner is one point, which draws nothing. A
// triangle is lit by its face's normal and tinted by its level.
ClusterV :: struct {pos:V4;colour:V4;}
cl_cluster_vs :: (vid:u32,iid:u32,du:[]f32,lists:[]u32,info:[]u32,tris:[]u32,verts:[]V4)->ClusterV {
  c:=cast(int)lists[cast(int)du[16]+cast(int)iid];t:=cast(int)(vid/3);corner:=cast(int)(vid%3);
  if t>=cast(int)info[c*CI_WORDS+CI_COUNT] {return ClusterV.{pos=v4(0.0f32,0.0f32,0.0f32,1.0f32),colour=v4(0.0f32,0.0f32,0.0f32,1.0f32)};}
  at:=(cast(int)info[c*CI_WORDS+CI_FIRST]+t)*3;
  a:=verts[cast(int)tris[at]];b:=verts[cast(int)tris[at+1]];e:=verts[cast(int)tris[at+2]];
  p:=verts[cast(int)tris[at+corner]];
  n:=cross3(sub3(v3_of(b),v3_of(a)),sub3(v3_of(e),v3_of(a)));
  l:=length3(n);light:=0.35f32;
  if l>0.0f32 {light=0.35f32+0.65f32*fmin(1.0f32,fabs(dot3(n,v3(0.37f32,0.80f32,0.47f32)))/l);}
  level:=cast(f32)info[c*CI_WORDS+CI_LEVEL];
  tint:=v4(0.55f32+0.45f32*fract(level*0.37f32),0.50f32+0.40f32*fract(level*0.61f32+0.3f32),0.45f32+0.50f32*fract(level*0.23f32+0.6f32),1.0f32);
  return ClusterV.{pos=m4_apply(m4_at(du,0),p),colour=v4(tint.x*light,tint.y*light,tint.z*light,1.0f32)};
}
cl_cluster_fs :: (v:ClusterV)->V4 {return v.colour;}
fabs :: (x:f32)->f32 {if x<0.0f32 {return -x;} return x;}

// ---- checks

// Two clusters: a root on page 0 (sphere at the origin) and a finer one on page 1 under it.
cl_fixture :: (u:[]f32,data:[]V4,info:[]u32) {
  for k:0..<CL_FLOATS {u[k]=0.0f32;}
  u[CL_M]=1.0f32;u[CL_M+5]=1.0f32;u[CL_M+10]=1.0f32;u[CL_M+15]=1.0f32;
  u[CL_EYE+2]=-10.0f32;u[CL_T]=0.01f32;u[CL_N]=2.0f32;u[CL_PAGES]=2.0f32;
  u[CL_WEIGHT]=1.0f32;   // the camera's; CL_MIPS 0: no texture demand
  for k:0..<6 {u[CL_PLANES+k*4+3]=1000.0f32;}
  // the root: made from page 1's clusters (its child page), error 0.5
  info[CI_PAGE]=0;info[CI_CHILD]=1;info[CI_FIRST]=0;info[CI_COUNT]=4;info[CI_ERROR]=f32_bits(0.5f32);info[CI_PARENT_ERROR]=f32_bits(1000000000.0f32);info[CI_LEVEL]=1;info[CI_ROOT]=1;
  data[CD_SELF]=v4(0.0f32,0.0f32,0.0f32,1.0f32);data[CD_PARENT]=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  data[CD_LOW]=v4(-1.0f32,-1.0f32,-1.0f32,1.0f32);data[CD_HIGH]=v4(1.0f32,1.0f32,1.0f32,1.0f32);
  // the finest: its parent is the root's group (error 0.5, the same sphere)
  b:=CI_WORDS;info[b+CI_PAGE]=1;info[b+CI_CHILD]=CL_NO_PAGE;info[b+CI_FIRST]=4;info[b+CI_COUNT]=8;info[b+CI_ERROR]=0;info[b+CI_PARENT_ERROR]=f32_bits(0.5f32);info[b+CI_LEVEL]=0;info[b+CI_ROOT]=0;
  data[CD_WORDS+CD_SELF]=v4(0.0f32,0.0f32,0.0f32,1.0f32);data[CD_WORDS+CD_PARENT]=v4(0.0f32,0.0f32,0.0f32,1.0f32);
  data[CD_WORDS+CD_LOW]=v4(-1.0f32,-1.0f32,-1.0f32,1.0f32);data[CD_WORDS+CD_HIGH]=v4(1.0f32,1.0f32,1.0f32,1.0f32);
}
cl_run :: (u:[]f32,data:[]V4,info:[]u32,installed:[]u32,requests:[]u32,draws:[]u32,lists:[]u32,hiz:[]f32) {
  for k:0..<requests.count {requests[k]=0;}
  for k:0..<CW_WORDS {draws[k]=0;}
  draws[CW_DRAW1]=CL_VERTS;draws[CW_DRAW2]=CL_VERTS;
  for i:0..<cast(int)u[CL_N] {cl_cull_one(cast(u32)i,u,data,info,installed,requests,draws,lists,hiz);}
}
#test "texture demand: each drawn cluster's texture wants the mip its nearest texels a pixel give, the finest kept" {
  u:[CL_FLOATS] f32;data:[8] V4;info:[16] u32;cl_fixture(u[..],data[..],info[..]);
  // 256 texels a metre, 0.001 radians a pixel: from 10 m (9 from the sphere) 2.3 texels a pixel, mip 1
  u[CL_PIXEL]=0.001f32;u[CL_MIPS]=8;data[CD_LOW].w=256;data[CD_HIGH].w=1;data[CD_WORDS+CD_LOW].w=256;data[CD_WORDS+CD_HIGH].w=0;
  #assert cl_mip(0,u[..],data[..])==1;
  u[CL_EYE+2]=-1.5f32;#assert cl_mip(0,u[..],data[..])==0;          // close: mip 0
  u[CL_EYE+2]=-500.0f32;#assert cl_mip(0,u[..],data[..])==6;        // 127 texels a pixel
  u[CL_EYE+2]=-100000.0f32;#assert cl_mip(0,u[..],data[..])==7;     // never past the last mip
  installed:=[2] u32.[1,0];requests:[4] u32;draws:[CW_WORDS] u32;lists:[8] u32;hiz:[1] f32;
  u[CL_EYE+2]=-10.0f32;cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert requests[2]==0 && requests[3]==7;                          // the root's texture (1): 8 - mip 1; texture 0 undrawn
  data[CD_HIGH].w=-1;cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert requests[2]==0 && requests[3]==0;                          // no texture, no demand
}
#test "a shadow view asks for the pages its casters need, weighted, and nothing outside the light" {
  u:[CL_FLOATS] f32;data:[8] V4;info:[16] u32;cl_fixture(u[..],data[..],info[..]);
  installed:=[2] u32.[1,0];requests:[2] u32;
  // orthographic: the error is over a fixed 1 m, the tolerance is a texel's 0.1 m: the root (0.5) is too coarse
  u[CL_SHADOW_D]=1;u[CL_T]=0.1f32;
  cl_cull_shadow(0,u[..],data[..],info[..],installed[..],requests[..]);
  full:=requests[1];#assert requests[0]>=2 && full==cl_priority(0.5f32,0.1f32);
  requests[0]=0;requests[1]=0;u[CL_WEIGHT]=0.25f32;cl_cull_shadow(0,u[..],data[..],info[..],installed[..],requests[..]);
  #assert requests[1]==2+(full-2)/4 && requests[1]>=2;               // weighted, still a load
  requests[1]=0;u[CL_EYE+2]=-100000.0f32;cl_cull_shadow(0,u[..],data[..],info[..],installed[..],requests[..]);
  #assert requests[1]==2+(full-2)/4;                                // the light's choice doesn't move with the eye
  requests[0]=0;requests[1]=0;u[CL_PLANES]=1;u[CL_PLANES+3]=-2;     // inside where x >= 2: the cluster isn't lit
  cl_cull_shadow(0,u[..],data[..],info[..],installed[..],requests[..]);#assert requests[0]==0 && requests[1]==0;
  cl_cull_shadow(5,u[..],data[..],info[..],installed[..],requests[..]);#assert requests[0]==0;   // past the clusters
}
#test "the draw rule: the root until its page's children are in and it is too coarse, then the children" {
  u:[CL_FLOATS] f32;data:[8] V4;info:[16] u32;cl_fixture(u[..],data[..],info[..]);
  installed:=[2] u32.[1,0];requests:[2] u32;draws:[CW_WORDS] u32;lists:[8] u32;hiz:[1] f32;
  // from 10 away the root's error is 0.5/9, too coarse; its children aren't in, so it draws and asks for them
  cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_LOD]==1 && draws[CW_DRAW1+1]==1 && lists[CL_LIST1*2]==0 && lists[CL_FLAGS*2]==(CF_LOD|CF_DRAW1) && lists[CL_FLAGS*2+1]==0;
  #assert requests[0]>=2 && requests[1]>=2;
  // with them in, the children draw instead
  installed[1]=1;cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_LOD]==1 && lists[CL_LIST1*2]==1 && lists[CL_FLAGS*2]==0 && requests[1]>=2 && requests[0]==0;
  // far enough away the root is fine, whatever is installed
  u[CL_EYE+2]=-200.0f32;cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_LOD]==1 && lists[CL_LIST1*2]==0 && requests[1]==0;
  // nothing draws without the root's page
  installed[0]=0;cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_LOD]==0 && draws[CW_DRAW1+1]==0;
}
#test "the frustum keeps a box that crosses a plane and drops one wholly outside, which only keeps its page" {
  u:[CL_FLOATS] f32;data:[8] V4;info:[16] u32;cl_fixture(u[..],data[..],info[..]);
  #assert !cl_outside(v4(-1,-1,-1,1),v4(1,1,1,1),u[..]);
  u[CL_PLANES]=1;u[CL_PLANES+3]=-0.5f32;   // inside where x >= 0.5
  #assert !cl_outside(v4(-1,-1,-1,1),v4(1,1,1,1),u[..]) && cl_outside(v4(-1,-1,-1,1),v4(0.4f32,1,1,1),u[..]);
  u[CL_PLANES+3]=-2;
  installed:=[2] u32.[1,0];requests:[2] u32;draws:[CW_WORDS] u32;lists:[8] u32;hiz:[1] f32;
  cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_FRUSTUM]==1 && draws[CW_DRAW1+1]==0 && requests[0]==CL_KEEP && requests[1]==0 && lists[CL_FLAGS*2]==(CF_LOD|CF_FRUSTUM);
}
// A pyramid for an 8x8 viewport: levels 4x4, 2x2 and 1x1, every texel `far`.
cl_pyramid :: (u:[]f32,hiz:[]f32,far:f32) {
  u[CL_VIEW]=8;u[CL_VIEW+1]=8;u[CL_W0]=4;u[CL_W0+1]=4;u[CL_LEVELS]=3;
  u[CL_OFFSET]=0;u[CL_WIDTH]=4;u[CL_HEIGHT]=4;u[CL_OFFSET+1]=16;u[CL_WIDTH+1]=2;u[CL_HEIGHT+1]=2;u[CL_OFFSET+2]=20;u[CL_WIDTH+2]=1;u[CL_HEIGHT+2]=1;
  for k:0..<21 {hiz[k]=far;}
}
#test "the pyramid hides a box behind its depth, never one in front or behind the eye, and the retest draws what it no longer hides" {
  u:[CL_FLOATS] f32;data:[8] V4;info:[16] u32;cl_fixture(u[..],data[..],info[..]);hiz:[21] f32;
  // clip = world (the identity), so depth is z: the box at z 0.4..0.6
  low:=v4(-0.1f32,-0.1f32,0.4f32,1);high:=v4(0.1f32,0.1f32,0.6f32,1);
  cl_pyramid(u[..],hiz[..],0.3f32);#assert cl_hidden(low,high,u[..],hiz[..]);
  cl_pyramid(u[..],hiz[..],0.5f32);#assert !cl_hidden(low,high,u[..],hiz[..]);
  cl_pyramid(u[..],hiz[..],0.3f32);hiz[10]=0.5f32;#assert !cl_hidden(low,high,u[..],hiz[..]);  // the farthest covered texel decides
  cl_pyramid(u[..],hiz[..],0.3f32);#assert !cl_hidden(v4(-0.1f32,-0.1f32,-0.4f32,1),high,u[..],hiz[..]);
  // a wide box tests the coarser level: hidden only when every texel is nearer
  wide_low:=v4(-0.9f32,-0.9f32,0.4f32,1);wide_high:=v4(0.9f32,0.9f32,0.6f32,1);
  #assert cl_hidden(wide_low,wide_high,u[..],hiz[..]);hiz[17]=0.5f32;#assert !cl_hidden(wide_low,wide_high,u[..],hiz[..]);
  // the cull: the root behind a near pyramid is retested, then drawn by the second phase against a far one
  data[CD_LOW]=low;data[CD_HIGH]=high;u[CL_EYE+2]=-200;u[CL_HIZ]=1;cl_pyramid(u[..],hiz[..],0.3f32);
  installed:=[2] u32.[1,0];requests:[2] u32;draws:[CW_WORDS] u32;lists:[8] u32;
  cl_run(u[..],data[..],info[..],installed[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_HIDDEN1]==1 && draws[CW_RETEST]==1 && draws[CW_DRAW1+1]==0 && lists[CL_RETEST*2]==0 && requests[0]==CL_KEEP;
  cl_cull_two(0,u[..],data[..],info[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_HIDDEN2]==1 && draws[CW_DRAW2+1]==0 && lists[CL_FLAGS*2]==(CF_LOD|CF_HIDDEN1|CF_HIDDEN2);
  lists[CL_FLAGS*2]=CF_LOD|CF_HIDDEN1;for k:0..<21 {hiz[k]=1;}
  cl_cull_two(0,u[..],data[..],info[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_DRAW2+1]==1 && lists[CL_LIST2*2]==0 && lists[CL_FLAGS*2]==(CF_LOD|CF_HIDDEN1|CF_DRAW2) && requests[0]>=2;
  cl_cull_two(1,u[..],data[..],info[..],requests[..],draws[..],lists[..],hiz[..]);
  #assert draws[CW_DRAW2+1]==1;
}
#test "the pyramid keeps the farthest depth of each 2x2, clamped at odd edges" {
  u:[CL_FLOATS] f32;u[CL_VIEW]=3;u[CL_VIEW+1]=3;u[CL_W0]=2;u[CL_W0+1]=2;u[CL_LEVELS]=2;
  u[CL_OFFSET]=0;u[CL_WIDTH]=2;u[CL_HEIGHT]=2;u[CL_OFFSET+1]=4;u[CL_WIDTH+1]=1;u[CL_HEIGHT+1]=1;
  d:=[9] f32.[0.1f32,0.2f32,0.9f32, 0.3f32,0.4f32,0.5f32, 0.6f32,0.7f32,0.8f32];depth:=TexDepth.{width=3,height=3,depth=d[..]};
  hiz:[5] f32;for i:0..<5 {cl_hiz_depth(cast(u32)i,u[..],depth,hiz[..]);}
  #assert hiz[0]==0.4f32 && hiz[1]==0.9f32 && hiz[2]==0.7f32 && hiz[3]==0.8f32;
  hz:=[4] f32.[1,0,0,0];for i:0..<2 {cl_hiz_down(cast(u32)i,u[..],hz[..],hiz[..]);}
  #assert hiz[4]==0.9f32;
}
#test "a list entry's vertices are its triangles' corners, and past them nothing" {
  u:[CL_FLOATS] f32;data:[8] V4;info:[16] u32;cl_fixture(u[..],data[..],info[..]);info[CI_FIRST]=1;info[CI_COUNT]=1;info[CI_LEVEL]=2;
  du:[20] f32;du[0]=1;du[5]=1;du[10]=1;du[15]=1;du[16]=1;
  lists:=[2] u32.[1,0];tris:=[6] u32.[0,1,2,1,2,3];verts:=[4] V4.[v4(0,0,0,1),v4(1,0,0,1),v4(0,1,0,1),v4(0,0,1,1)];
  a:=cl_cluster_vs(0,0,du[..],lists[..],info[..],tris[..],verts[..]);b:=cl_cluster_vs(2,0,du[..],lists[..],info[..],tris[..],verts[..]);
  #assert a.pos.x==1 && a.pos.w==1 && b.pos.z==1 && a.colour.x==b.colour.x && a.colour.x>0;
  past:=cl_cluster_vs(3,0,du[..],lists[..],info[..],tris[..],verts[..]);#assert past.pos.x==0 && past.pos.y==0 && past.pos.z==0;
  #assert cl_cluster_fs(a).y==a.colour.y;
}
