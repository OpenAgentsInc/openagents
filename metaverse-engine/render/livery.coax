// A figure painted by part: a livery (#13303). A skinned figure on the people rig (the mannequin's
// 65 joints, metaverse-engine/anim/mannequin.coax) is drawn solid and coloured, not as a ghost
// (ghost.coax): each vertex takes the part of the joint that carries most of it, a part is refined
// by where the vertex sits round its part's middle in the rest pose (the face under a cap, a stripe
// over it, a pack on the back), a livery gives each part a colour, a grain gives cloth a little
// texture, and hands, feet and head swell about their middles so the figure reads chunky and bright
// from far off, side on. The page's scene shader lights it as its other solid surfaces and adds a
// rim (engine_livery_rim) so it stands out from the sky. All scalar, so a shader can call any of it.
// gamebuilder.org's platformer hero is the first (another repository: web/hud.coax).
//   part    = livery_part(joint), then livery_refine(part, dx, dy, dz)   (d: the vertex less its
//             part's middle, metres, +y up, +z the figure's front, +x its left)
//   colour  = livery_colour(livery, part, channel) * livery_grain(x, y, z)   (display values)
//   swell   = 1 + (livery_swell(part) - 1) * w   about the swell group's middle (livery_group),
//             w the vertex's weight on that group's joints
//   rim     = LIVERY_RIM * smoothstep(0.45, 0.95, 1 - |n . v|)
//   coax/bin/coax test metaverse-engine/render/livery.coax --library
#module "metaverse.engine.render.livery";
#load "noise.coax";   // and through it metaverse-engine/gpu/shader.coax

// The parts.
LIVERY_NONE :: 0; LIVERY_SKIN :: 1; LIVERY_CAP :: 2; LIVERY_SCARF :: 3; LIVERY_JACKET :: 4;
LIVERY_SLEEVE :: 5; LIVERY_GLOVE :: 6; LIVERY_LEGS :: 7; LIVERY_BOOT :: 8; LIVERY_PACK :: 9; LIVERY_STRIPE :: 10;
LIVERY_PARTS :: 11;
// The swell groups: none, the head, each hand, each foot.
LIVERY_GROUPS :: 6;
// The liveries.
LIVERY_RUNNER :: 0;   // a red cap with a white stripe, a sunny scarf, a sky-blue jacket, an orange pack, red boots
LIVERY_PILOT :: 1;    // a white helmet with a blue stripe, an orange suit, grey gloves and boots
LIVERY_COUNT :: 2;
LIVERY_RIM :: 0.55;   // how bright the rim is, times the sky's light

// The part of the mannequin's joint `j`: the head is the cap (livery_refine finds the face), the neck
// the scarf, the spine, collar bones and upper arms the jacket, the forearms its sleeves, the hands
// and fingers gloves, the hips and legs trousers, the feet boots. Past the rig, none.
livery_part :: (j: int) -> int {
  if j < 0 || j >= 65 { return LIVERY_NONE; }
  if j == 6 { return LIVERY_CAP; }
  if j == 5 { return LIVERY_SCARF; }
  if (j >= 2 && j <= 4) || j == 7 || j == 8 || j == 31 || j == 32 { return LIVERY_JACKET; } // mutant: equivalent (the neck, 5, is the scarf above)
  if j == 9 || j == 33 { return LIVERY_SLEEVE; }
  if (j >= 10 && j <= 30) || (j >= 34 && j <= 54) { return LIVERY_GLOVE; } // mutant: equivalent (31 is the jacket above)
  if j <= 1 || j == 55 || j == 56 || j == 60 || j == 61 { return LIVERY_LEGS; } // mutant: equivalent (2 is the jacket above)
  return LIVERY_BOOT;
}
// The swell group of joint `j`: 1 the head, 2 and 3 the left and right hand (with their fingers),
// 4 and 5 the left and right foot; 0 the rest.
livery_group :: (j: int) -> int {
  if j == 6 { return 1; }
  if j >= 10 && j <= 30 { return 2; }
  if j >= 34 && j <= 54 { return 3; }
  if j >= 57 && j <= 59 { return 4; }
  if j >= 62 && j <= 64 { return 5; }
  return 0;
}
// A part refined by where the vertex sits round its part's middle in the rest pose: under the cap,
// the front low half is the face; over the top, a band along the middle is the stripe; on the jacket,
// the back is the pack.
livery_refine :: (part: int, dx: f32, dy: f32, dz: f32) -> int {
  if part == LIVERY_CAP {
    if dz > 0.035 && dy < 0.045 { return LIVERY_SKIN; }
    if abs(dx) < 0.024 && dy > 0.02 { return LIVERY_STRIPE; }
    return LIVERY_CAP;
  }
  if part == LIVERY_JACKET && dz < -0.06 && abs(dx) < 0.16 && dy > -0.2 { return LIVERY_PACK; }
  return part;
}
// How much a part swells about its group's middle: the head a third, the hands more, the feet a quarter.
livery_swell :: (part: int) -> f32 {
  if part == LIVERY_CAP || part == LIVERY_SKIN || part == LIVERY_STRIPE { return 1.32; }
  if part == LIVERY_GLOVE { return 1.4; }
  if part == LIVERY_BOOT { return 1.25; }
  return 1.0;
}
// One channel (0 red, 1 green, 2 blue) of a part's colour in a livery, a display value 0 to 1. No
// part, or no such livery: black.
livery_colour :: (livery: int, part: int, k: int) -> f32 {
  r: f32 = 0; g: f32 = 0; b: f32 = 0;
  if livery == LIVERY_RUNNER {
    if part == LIVERY_SKIN { r = 0.96; g = 0.74; b = 0.58; }
    else if part == LIVERY_CAP { r = 0.93; g = 0.2; b = 0.16; }
    else if part == LIVERY_STRIPE { r = 0.98; g = 0.97; b = 0.94; }
    else if part == LIVERY_SCARF { r = 1.0; g = 0.8; b = 0.12; }
    else if part == LIVERY_JACKET { r = 0.13; g = 0.56; b = 0.92; }
    else if part == LIVERY_SLEEVE { r = 0.98; g = 0.97; b = 0.94; }
    else if part == LIVERY_GLOVE { r = 0.98; g = 0.97; b = 0.94; }
    else if part == LIVERY_LEGS { r = 0.16; g = 0.2; b = 0.4; }
    else if part == LIVERY_BOOT { r = 0.86; g = 0.18; b = 0.14; }
    else if part == LIVERY_PACK { r = 1.0; g = 0.52; b = 0.1; }
  } else if livery == LIVERY_PILOT {
    if part == LIVERY_SKIN { r = 0.9; g = 0.68; b = 0.52; }
    else if part == LIVERY_CAP { r = 0.95; g = 0.95; b = 0.97; }
    else if part == LIVERY_STRIPE { r = 0.15; g = 0.4; b = 0.95; }
    else if part == LIVERY_SCARF || part == LIVERY_JACKET || part == LIVERY_SLEEVE || part == LIVERY_LEGS { r = 0.98; g = 0.48; b = 0.1; }
    else if part == LIVERY_GLOVE || part == LIVERY_BOOT { r = 0.42; g = 0.44; b = 0.48; }
    else if part == LIVERY_PACK { r = 0.85; g = 0.86; b = 0.88; }
  }
  return ifx k == 0 then r else ifx k == 1 then g else b;
}
// Cloth's grain at a rest-pose point (metres): a little lighter or darker by the engine's lattice
// hash, cells of a sixty-fourth of a metre, 0.93 to 1.05.
livery_grain :: (x: f32, y: f32, z: f32) -> f32 { return 0.93 + 0.12 * render_noise3(x, y, z); }
// The rim's light (times the sky's) where the surface turns from the eye: ndv = n . v, both unit.
engine_livery_rim :: (ndv: f32) -> f32 { return LIVERY_RIM * smoothstep(0.45, 0.95, 1.0 - clampf(abs(ndv), 0.0, 1.0)); }

#test "every joint of the rig has its part and group: the head a cap, the neck a scarf, hands gloves, feet boots" {
  #assert livery_part(6) == LIVERY_CAP && livery_part(5) == LIVERY_SCARF && livery_part(-1) == LIVERY_NONE && livery_part(65) == LIVERY_NONE;
  for j: 2..<5 { #assert livery_part(j) == LIVERY_JACKET; }
  #assert livery_part(7) == LIVERY_JACKET && livery_part(8) == LIVERY_JACKET && livery_part(31) == LIVERY_JACKET && livery_part(32) == LIVERY_JACKET;
  #assert livery_part(9) == LIVERY_SLEEVE && livery_part(33) == LIVERY_SLEEVE;
  for j: 10..<31 { #assert livery_part(j) == LIVERY_GLOVE && livery_group(j) == 2; }
  for j: 34..<55 { #assert livery_part(j) == LIVERY_GLOVE && livery_group(j) == 3; }
  #assert livery_part(0) == LIVERY_LEGS && livery_part(1) == LIVERY_LEGS && livery_part(55) == LIVERY_LEGS && livery_part(56) == LIVERY_LEGS && livery_part(60) == LIVERY_LEGS && livery_part(61) == LIVERY_LEGS;
  for j: 57..<60 { #assert livery_part(j) == LIVERY_BOOT && livery_group(j) == 4 && livery_part(j + 5) == LIVERY_BOOT && livery_group(j + 5) == 5; }
  #assert livery_group(6) == 1 && livery_group(5) == 0 && livery_group(9) == 0 && livery_group(31) == 0 && livery_group(33) == 0 && livery_group(56) == 0 && livery_group(61) == 0 && livery_group(55) == 0;
  #assert livery_group(60) == 0 && livery_group(65) == 0 && livery_group(-1) == 0;
}

#test "a part refined: the face under the cap, a stripe over it, a pack on the jacket's back" {
  #assert livery_refine(LIVERY_CAP, 0.05, 0.0, 0.08) == LIVERY_SKIN && livery_refine(LIVERY_CAP, 0.05, 0.05, 0.08) == LIVERY_CAP;
  #assert livery_refine(LIVERY_CAP, 0.0, 0.06, 0.0) == LIVERY_STRIPE && livery_refine(LIVERY_CAP, 0.03, 0.06, 0.0) == LIVERY_CAP && livery_refine(LIVERY_CAP, 0.01, 0.01, -0.05) == LIVERY_CAP;
  #assert livery_refine(LIVERY_CAP, 0.05, 0.0, 0.03) == LIVERY_CAP && livery_refine(LIVERY_CAP, -0.02, 0.025, 0.0) == LIVERY_STRIPE;
  #assert livery_refine(LIVERY_JACKET, 0.0, 0.0, -0.08) == LIVERY_PACK && livery_refine(LIVERY_JACKET, 0.0, 0.0, -0.05) == LIVERY_JACKET;
  #assert livery_refine(LIVERY_JACKET, 0.2, 0.0, -0.08) == LIVERY_JACKET && livery_refine(LIVERY_JACKET, 0.0, -0.25, -0.08) == LIVERY_JACKET && livery_refine(LIVERY_JACKET, -0.15, -0.19, -0.07) == LIVERY_PACK;
  #assert livery_refine(LIVERY_BOOT, 0.0, 0.0, -0.08) == LIVERY_BOOT && livery_refine(LIVERY_LEGS, 0.0, 0.06, 0.0) == LIVERY_LEGS;
}

#test "a part's edges: just at a bound, the part it was" {
  #assert livery_refine(LIVERY_CAP, 0.05, 0.0, 0.035) == LIVERY_CAP && livery_refine(LIVERY_CAP, 0.05, 0.045, 0.08) == LIVERY_CAP;
  #assert livery_refine(LIVERY_CAP, 0.024, 0.06, 0.0) == LIVERY_CAP && livery_refine(LIVERY_CAP, 0.0, 0.02, 0.0) == LIVERY_CAP;
  #assert livery_refine(LIVERY_JACKET, 0.0, 0.0, -0.06) == LIVERY_JACKET && livery_refine(LIVERY_JACKET, 0.16, 0.0, -0.08) == LIVERY_JACKET && livery_refine(LIVERY_JACKET, 0.0, -0.2, -0.08) == LIVERY_JACKET;
}

#test "every colour of every part in each livery, as written" {
  want := [66] f32.[
    0, 0, 0, 0.96, 0.74, 0.58, 0.93, 0.2, 0.16, 1.0, 0.8, 0.12, 0.13, 0.56, 0.92, 0.98, 0.97, 0.94,
    0.98, 0.97, 0.94, 0.16, 0.2, 0.4, 0.86, 0.18, 0.14, 1.0, 0.52, 0.1, 0.98, 0.97, 0.94,
    0, 0, 0, 0.9, 0.68, 0.52, 0.95, 0.95, 0.97, 0.98, 0.48, 0.1, 0.98, 0.48, 0.1, 0.98, 0.48, 0.1,
    0.42, 0.44, 0.48, 0.98, 0.48, 0.1, 0.42, 0.44, 0.48, 0.85, 0.86, 0.88, 0.15, 0.4, 0.95];
  for l: 0..<LIVERY_COUNT { for p: 0..<LIVERY_PARTS { for k: 0..<3 { #assert livery_colour(l, p, k) == want[(l * LIVERY_PARTS + p) * 3 + k]; } } }
}

#test "the head, hands and feet swell; the rest keeps its size" {
  #assert livery_swell(LIVERY_CAP) == 1.32 && livery_swell(LIVERY_SKIN) == 1.32 && livery_swell(LIVERY_STRIPE) == 1.32;
  #assert livery_swell(LIVERY_GLOVE) == 1.4 && livery_swell(LIVERY_BOOT) == 1.25;
  for p: 0..<LIVERY_PARTS { if p != LIVERY_CAP && p != LIVERY_SKIN && p != LIVERY_STRIPE && p != LIVERY_GLOVE && p != LIVERY_BOOT { #assert livery_swell(p) == 1; } }
}

#test "each livery colours every part, brightly and apart; no part is black" {
  for l: 0..<LIVERY_COUNT {
    for p: 1..<LIVERY_PARTS {
      s: f32 = 0;
      for k: 0..<3 { c := livery_colour(l, p, k); #assert c >= 0 && c <= 1; s += c; }
      #assert s > 0.7;
    }
    #assert livery_colour(l, LIVERY_NONE, 0) == 0 && livery_colour(l, LIVERY_NONE, 2) == 0;
  }
  #assert livery_colour(LIVERY_COUNT, LIVERY_CAP, 0) == 0 && livery_colour(-1, LIVERY_CAP, 1) == 0;
  // the runner: a red cap, a sky-blue jacket, a yellow scarf, an orange pack
  #assert livery_colour(LIVERY_RUNNER, LIVERY_CAP, 0) > 0.8 && livery_colour(LIVERY_RUNNER, LIVERY_CAP, 2) < 0.3;
  #assert livery_colour(LIVERY_RUNNER, LIVERY_JACKET, 2) > 0.8 && livery_colour(LIVERY_RUNNER, LIVERY_JACKET, 0) < 0.3 && abs(livery_colour(LIVERY_RUNNER, LIVERY_JACKET, 1) - 0.56) < 0.001;
  #assert livery_colour(LIVERY_RUNNER, LIVERY_SCARF, 1) > 0.7 && livery_colour(LIVERY_RUNNER, LIVERY_SCARF, 2) < 0.2 && livery_colour(LIVERY_RUNNER, LIVERY_PACK, 1) < 0.6;
  // apart: each part differs from the jacket in some channel, all but the sleeves and gloves from the cap
  for p: 1..<LIVERY_PARTS {
    if p == LIVERY_JACKET { continue; }
    d: f32 = 0; for k: 0..<3 { d += abs(livery_colour(LIVERY_RUNNER, p, k) - livery_colour(LIVERY_RUNNER, LIVERY_JACKET, k)); }
    #assert d > 0.3;
  }
  #assert livery_colour(LIVERY_RUNNER, LIVERY_SKIN, 0) == 0.96 && livery_colour(LIVERY_RUNNER, LIVERY_SKIN, 1) == 0.74 && livery_colour(LIVERY_RUNNER, LIVERY_SKIN, 2) == 0.58;
  #assert livery_colour(LIVERY_RUNNER, LIVERY_STRIPE, 1) == 0.97 && livery_colour(LIVERY_RUNNER, LIVERY_SLEEVE, 2) == 0.94 && livery_colour(LIVERY_RUNNER, LIVERY_GLOVE, 0) == 0.98;
  #assert livery_colour(LIVERY_RUNNER, LIVERY_LEGS, 2) == 0.4 && livery_colour(LIVERY_RUNNER, LIVERY_BOOT, 0) == 0.86 && livery_colour(LIVERY_RUNNER, LIVERY_BOOT, 1) == 0.18;
  #assert livery_colour(LIVERY_PILOT, LIVERY_CAP, 2) == 0.97 && livery_colour(LIVERY_PILOT, LIVERY_STRIPE, 2) == 0.95 && livery_colour(LIVERY_PILOT, LIVERY_STRIPE, 0) == 0.15;
  #assert livery_colour(LIVERY_PILOT, LIVERY_LEGS, 1) == 0.48 && livery_colour(LIVERY_PILOT, LIVERY_SCARF, 0) == 0.98 && livery_colour(LIVERY_PILOT, LIVERY_JACKET, 2) == 0.1 && livery_colour(LIVERY_PILOT, LIVERY_SLEEVE, 1) == 0.48;
  #assert livery_colour(LIVERY_PILOT, LIVERY_GLOVE, 1) == 0.44 && livery_colour(LIVERY_PILOT, LIVERY_BOOT, 2) == 0.48 && livery_colour(LIVERY_PILOT, LIVERY_PACK, 0) == 0.85 && livery_colour(LIVERY_PILOT, LIVERY_SKIN, 0) == 0.9;
}

#test "cloth's grain stays within a few hundredths of one, and differs from cell to cell" {
  lo: f32 = 2; hi: f32 = 0;
  for i: 0..<64 { g := livery_grain(cast(f32) i * 0.0161, 1.2, 0.03 * cast(f32) i); #assert g >= 0.93 && g <= 1.05; if g < lo { lo = g; } if g > hi { hi = g; } }
  #assert hi - lo > 0.06;
  #assert livery_grain(1, 2, 3) == 0.93 + 0.12 * render_noise3(1, 2, 3);
}

#test "the rim is dark facing the eye and bright at the edge, either side" {
  #assert engine_livery_rim(1) == 0 && engine_livery_rim(-1) == 0 && engine_livery_rim(0.6) == 0;
  #assert abs(engine_livery_rim(0) - LIVERY_RIM) < 0.0001 && abs(engine_livery_rim(-0.04) - LIVERY_RIM) < 0.0001 && abs(engine_livery_rim(2)) < 0.0001;
  #assert engine_livery_rim(0.3) > engine_livery_rim(0.4) && engine_livery_rim(0.3) > 0 && engine_livery_rim(0.3) < LIVERY_RIM;
}
