// Shared display response, bloom extraction/composition, chroma preservation and light shafts.
#module "aethyr.render.post";
#load "material.coax";
#test "postprocessing covers bloom knees and exact chroma and decay branch edges" {
 #assert abs(metaverse_style_bloom_share(0.75,1,0.5)-1.0f32/24)<0.000001;
 #assert metaverse_style_chroma_gain(0.0001,0.5,0.7)==2.5;
 decay:=1.0f32-1.0f32/1048576;sum:f32=0;power:f32=1;for i:0..<1000 {sum+=power;power*=decay;}
 #assert abs(metaverse_style_shaft_total(1000,decay)-sum)<0.1;
}
// ---- 9. Tone
// The tone curve: 1 - exp(-c exposure).
metaverse_style_tone :: (c:f32,exposure:f32)->f32 #export_c #effects(all) {return 1.0f32-exp(-st_max(c,0.0f32)*exposure);}
// Saturation about luminance: a channel pushed away from the pixel's luminance.
metaverse_style_saturation :: (c:f32,lum:f32,amount:f32)->f32 #export_c #effects(all) {return st_max(0.0f32,lum+(c-lum)*amount);}
// Blacks lifted before encoding: c = lift + (1 - lift) c.
metaverse_style_lift :: (c:f32,lift:f32)->f32 #export_c #effects(all) {return lift+(1.0f32-lift)*c;}
// The share of a pixel's light that blooms (art-styles.md 6): none under the
// threshold less the knee, all of the excess past the threshold, a quadratic
// knee between so the glow starts without a seam. As a fraction of the light.
metaverse_style_bloom_share :: (lum:f32,threshold:f32,knee:f32)->f32 #export_c #effects(all) {
 if lum<=0.0f32 {return 0.0f32;}
 k:=st_max(knee,0.00001f32);
 q:=st_min(st_max(lum-threshold+k,0.0f32),2.0f32*k);
 return st_min(st_max(q*q/(4.0f32*k),lum-threshold)/lum,1.0f32);
}
// The light with its blurred bright share mixed back: gently, `amount` of it.
metaverse_style_bloom_mix :: (c:f32,bloom:f32,amount:f32)->f32 #export_c #effects(all) {return c+bloom*amount;}
// ---- 6b. Light shafts: a radial blur of the sky's glow toward the key light's place on screen
// The glow a sky pixel puts into the blur: the sky near the light, by the ray's cosine to it
// (exp(-24 (1 - cos)): half at 14 degrees, a tenth at 25), so gaps in a canopy against the sky round
// the sun stream light and open sky far from it adds nothing. A surface passes it on in the share the
// haze has taken of it (the lit air in front of a far ridge glows; a near trunk blocks).
metaverse_style_shaft_source :: (cos_t:f32)->f32 #export_c #effects(all) {return exp(-24.0f32*st_max(1.0f32-cos_t,0.0f32));}
// How much of the shafts show, by where the light sits on screen (x, y: 0 to 1 across the frame,
// outside it past an edge): all of them inside the frame, fading out over `margin` (0.35) of the
// frame past its edge, none further.
metaverse_style_shaft_fade :: (x:f32,y:f32,margin:f32)->f32 #export_c #effects(all) {
 out:=st_max(st_max(st_max(-x,x-1.0f32),st_max(-y,y-1.0f32)),0.0f32);
 return 1.0f32-metaverse_style_soft_step(margin*0.5f32,margin*0.5f32,out);
}
// Tap i's weight along the march from the pixel toward the light: decay^i (0.94).
metaverse_style_shaft_tap :: (i:f32,decay:f32)->f32 #export_c #effects(all) {return pow(st_max(decay,0.000001f32),i);}
// All n taps' weights together, to share the shafts' strength over them.
metaverse_style_shaft_total :: (n:f32,decay:f32)->f32 #export_c #effects(all) {
 if abs(1.0f32-decay)<0.00000095367431640625f32 {return n;}
 return (1.0f32-pow(st_max(decay,0.000001f32),n))/(1.0f32-decay);
}
// A pixel's shafts: `sum` (the taps' glow, each times its weight) shared over the taps, at the
// preset's weight (0.44 by day, 0.20 at night) and the frame-edge fade. Added to the light, coloured
// like the key light in the haze.
metaverse_style_shaft :: (sum:f32,total:f32,weight:f32,fade:f32)->f32 #export_c #effects(all) {return sum/st_max(total,0.000001f32)*weight*st_sat(fade);}

// The cap on how far the shadow tint and the light may grey a surface: its saturation (chroma over
// value) kept to at least `keep` of its albedo's; the gain to put on its distance from grey (1 when it
// is saturated enough, never more than 2.5).
metaverse_style_chroma_gain :: (have:f32,albedo:f32,keep:f32)->f32 #export_c #effects(all) {
 if have<0.0001f32 {return 1.0f32;}
 return st_min(2.5f32,st_max(1.0f32,albedo*keep/have));
}


#test "the chroma cap: a greyed shadow gets back to 0.7 of its albedo's saturation, never past 2.5 times; a saturated one is left" {
 #assert abs(metaverse_style_chroma_gain(0.2f32,0.6f32,0.7f32)-2.1f32)<0.0001f32;
 #assert metaverse_style_chroma_gain(0.5f32,0.6f32,0.7f32)==1.0f32 && metaverse_style_chroma_gain(0.05f32,0.9f32,0.7f32)==2.5f32 && metaverse_style_chroma_gain(0.0f32,0.6f32,0.7f32)==1.0f32;
}

#test "bloom starts 0.25 under 0.85 with a soft knee and takes all of the excess past it" {
 #assert metaverse_style_bloom_share(0.5f32,0.85f32,0.25f32)==0.0f32;
 #assert metaverse_style_bloom_share(0.60f32,0.85f32,0.25f32)==0.0f32;
 #assert metaverse_style_bloom_share(0.0f32,0.85f32,0.25f32)==0.0f32;
 // at the threshold the knee gives k/4 of light: 0.0625 of 0.85
 #assert abs(metaverse_style_bloom_share(0.85f32,0.85f32,0.25f32)-0.0625f32/0.85f32)<0.0001f32;
 // past threshold + knee, just the excess
 #assert abs(metaverse_style_bloom_share(2.0f32,0.85f32,0.25f32)-1.15f32/2.0f32)<0.0001f32;
 // continuous and never stepping back across the knee
 for i:0..<200 {a:=0.55f32+cast(f32)i*0.004f32;
  #assert metaverse_style_bloom_share(a+0.004f32,0.85f32,0.25f32)*(a+0.004f32)>=metaverse_style_bloom_share(a,0.85f32,0.25f32)*a;
  #assert abs(metaverse_style_bloom_share(a+0.004f32,0.85f32,0.25f32)*(a+0.004f32)-metaverse_style_bloom_share(a,0.85f32,0.25f32)*a)<0.01f32;}
 #assert abs(metaverse_style_bloom_mix(0.5f32,1.0f32,0.30f32)-0.80f32)<0.0001f32;
 #assert abs(metaverse_style_bloom_mix(0.5f32,1.0f32,0.22f32)-0.72f32)<0.0001f32;
}

#test "the tone keeps black, approaches white, and lifts blacks 0.035" {
 #assert metaverse_style_tone(0.0f32,1.6f32)==0.0f32;
 #assert metaverse_style_tone(20.0f32,1.6f32)>0.999f32;
 #assert metaverse_style_tone(0.3f32,2.4f32)>metaverse_style_tone(0.3f32,1.6f32);
 #assert abs(metaverse_style_lift(0.0f32,0.035f32)-0.035f32)<0.00001f32;
 #assert abs(metaverse_style_lift(1.0f32,0.035f32)-1.0f32)<0.00001f32;
 #assert abs(metaverse_style_saturation(0.6f32,0.5f32,1.10f32)-0.61f32)<0.0001f32;
 #assert metaverse_style_saturation(0.0f32,0.5f32,3.0f32)==0.0f32;
 #assert abs(metaverse_style_luma(1.0f32,1.0f32,1.0f32)-1.0f32)<0.0001f32;
}

#test "light shafts: the sky's glow toward the light, 24 taps decaying 0.94, at most the preset's weight" {
 #assert metaverse_style_shaft_source(1.0f32)==1.0f32;
 #assert abs(metaverse_style_shaft_source(cos(13.8f32*0.0174533f32))-0.5f32)<0.01f32;
 #assert metaverse_style_shaft_source(cos(25.5f32*0.0174533f32))<0.1f32 && metaverse_style_shaft_source(-1.0f32)<0.0001f32;
 #assert metaverse_style_shaft_tap(0.0f32,0.94f32)==1.0f32 && abs(metaverse_style_shaft_tap(23.0f32,0.94f32)-0.2405f32)<0.001f32;
 // the 24 desktop taps' weights, and a phone's 12, summed
 s:=0.0f32; for i:0..<24 {s=s+metaverse_style_shaft_tap(cast(f32)i,0.94f32);}
 #assert abs(metaverse_style_shaft_total(24.0f32,0.94f32)-s)<0.001f32;
 s=0.0f32; for i:0..<12 {s=s+metaverse_style_shaft_tap(cast(f32)i,0.94f32);}
 #assert abs(metaverse_style_shaft_total(12.0f32,0.94f32)-s)<0.001f32;
 #assert metaverse_style_shaft_total(5.0f32,1.0f32)==5.0f32;
 // every tap in the light's full glow: the preset's weight, 0.44 by day and 0.20 at night; none in shadow
 t:=metaverse_style_shaft_total(24.0f32,0.94f32);
 #assert abs(metaverse_style_shaft(t,t,0.44f32,1.0f32)-0.44f32)<0.0001f32 && abs(metaverse_style_shaft(t,t,0.20f32,1.0f32)-0.20f32)<0.0001f32;
 #assert metaverse_style_shaft(0.0f32,t,0.22f32,1.0f32)==0.0f32;
}

#test "shafts show while the light is in the frame and fade out over 0.35 of it past the edge" {
 #assert metaverse_style_shaft_fade(0.5f32,0.5f32,0.35f32)==1.0f32 && metaverse_style_shaft_fade(0.0f32,1.0f32,0.35f32)==1.0f32;
 #assert abs(metaverse_style_shaft_fade(1.175f32,0.5f32,0.35f32)-0.5f32)<0.0001f32;
 #assert metaverse_style_shaft_fade(0.5f32,-0.35f32,0.35f32)==0.0f32 && metaverse_style_shaft_fade(-3.0f32,0.5f32,0.35f32)==0.0f32;
 for i:0..<50 {o:=cast(f32)i*0.01f32; #assert metaverse_style_shaft_fade(1.0f32+o+0.01f32,0.5f32,0.35f32)<=metaverse_style_shaft_fade(1.0f32+o,0.5f32,0.35f32);}
}
