// The retained scene's per-frame part (GitHub #13303): one instance row a World slot, kept for the
// GPU, written only when the slot's row changed.
//
// Meshes and materials are registered once from the pack by asset id and stay on the GPU. A frame
// sends transforms and visibility: this module is the transforms' half. It is one more system of
// the World (metaverse-engine/core/world.coax), the last in the list. It declares reads of the
// transform and the kind and writes nothing in the World, so world_digest and the room are
// unchanged and the World's audit finds nothing. What it writes is its own store:
//
//   a row a slot   RETAINED_ROW floats: where it stands now (x, y, z, yaw), its scale, mesh,
//                  material and a live flag, and where it stood a step ago (x, y, z, yaw), which
//                  drawing between steps eases from. The previous transform lives here, not in a
//                  second World column.
//   a dirty span   the first and one past the last row changed since the host last took the span.
//                  A host uploads that span of its GPU buffer and nothing else (the face's
//                  coaxial_store_span_v1; coax/web/host.js). A still world uploads no bytes.
//   an origin      rows are metres from a base origin, as f32. The page's floating origin
//                  (everglade/client/cells.coax E2Cells.origin) moves with you; the difference
//                  between it and the base is one uniform a frame (retained_origin), added on the
//                  GPU, so a rebase uploads no row. Only when the difference passes
//                  RETAINED_REBASE_FAR are the rows written again from the new base, and counted.
//
// The mesh and material of a slot are render columns of this store (retained_set): client-only,
// never digested. The visible list is the spatial index's answer at the camera (retained_visible);
// a device with the cluster and Hi-Z cull (render/geometry/cull.coax) takes it as indirect draws.
//   coax/bin/coax test metaverse-engine/render/retained.coax
#module "metaverse.engine.render.retained";
#load "../core/world.coax";
#load "tests/retained-checks.coax" #test;

RETAINED_ROW :: 12;
RR_X :: 0; RR_Y :: 1; RR_Z :: 2; RR_YAW :: 3; RR_SCALE :: 4; RR_MESH :: 5; RR_MATERIAL :: 6; RR_LIVE :: 7;
RR_PX :: 8; RR_PY :: 9; RR_PZ :: 10; RR_PYAW :: 11;
RETAINED_REBASE_FAR :: 2048.0;   // metres between the base and the page's origin before the rows are rebased

// The counters, at these places in `n`.
RS_READY :: 0;      // 1 once retained_init took the storage
RS_SYSTEM :: 1;     // this system's id in the World's list
RS_LO :: 2;         // the dirty span: the first row changed since the span was taken
RS_HI :: 3;         //   and one past the last (lo >= hi: nothing to upload)
RS_WRITTEN :: 4;    // rows written by the last run
RS_RUNS :: 5;       // runs so far
RS_REBASES :: 6;    // times every row was written again from a new base
RS_UPLOADED :: 7;   // rows a host has taken, all told (a check's measure of what a frame costs)
RS_COUNTERS :: 8;

RetainedStore :: struct {
  rows: [] f32;        // RETAINED_ROW floats a slot, the World's cap of them
  mesh: [] int;        // the render columns, a slot each: the pack's mesh id (0: nothing to draw),
  material: [] int;    //   its material id
  scale: [] f32;       //   and its size (0 is taken as 1)
  base: [] f64;        // 3: the origin the rows are metres from
  n: [] int;
}
RetainedSpan :: struct { first: int; count: int; }   // rows

retained_cap :: (r: RetainedStore) -> int #effects(all) { return r.mesh.count; }
// Takes the storage whole or refuses it: every column the World's cap long.
retained_init :: (w: World, r: RetainedStore) -> bool #effects(all) {
  if r.n.count < RS_COUNTERS { return false; }
  r.n[RS_READY] = 0;
  cap := world_cap(w);
  if !world_ready(w) || cap < 1 || r.rows.count != cap * RETAINED_ROW || r.mesh.count != cap || r.material.count != cap || r.scale.count != cap || r.base.count != 3 { return false; }
  for i: 0..<r.rows.count { r.rows[i] = 0; }
  for i: 0..<cap { r.mesh[i] = 0; r.material[i] = 0; r.scale[i] = 1; }
  for i: 0..<3 { r.base[i] = 0; }
  for i: 0..<RS_COUNTERS { r.n[i] = 0; }
  r.n[RS_READY] = 1;
  return true;
}
// Puts the render system in the World's list. Call it after every other system: retained_system
// refuses to run unless it is the last.
retained_register :: (w: World, r: RetainedStore, id: int) -> bool #effects(all) {
  if r.n.count < RS_COUNTERS || r.n[RS_READY] != 1 || r.n[RS_SYSTEM] != 0 { return false; }
  if !world_system(w, id, WORLD_TRANSFORM | WORLD_KIND, 0) { return false; }
  r.n[RS_SYSTEM] = id;
  return true;
}
retained_is_last :: (w: World, r: RetainedStore) -> bool #effects(all) {
  k := w.n[WORLD_SYSTEMS];
  return r.n[RS_READY] == 1 && r.n[RS_SYSTEM] > 0 && k > 0 && w.sys_id[k - 1] == r.n[RS_SYSTEM];
}
// A slot's mesh, material and size: what the realm's kind draws as. The row is written at the next run.
retained_set :: (r: RetainedStore, slot: int, mesh: int, material: int, scale: f32) -> bool #effects(all) {
  if r.n[RS_READY] != 1 || slot < 0 || slot >= retained_cap(r) || mesh < 0 || material < 0 || !(scale > 0) { return false; }
  r.mesh[slot] = mesh; r.material[slot] = material; r.scale[slot] = scale;
  return true;
}
rt_dirty :: (r: RetainedStore, slot: int) #effects(all) {
  if r.n[RS_LO] >= r.n[RS_HI] { r.n[RS_LO] = slot; r.n[RS_HI] = slot + 1; return; }
  if slot < r.n[RS_LO] { r.n[RS_LO] = slot; }
  if slot + 1 > r.n[RS_HI] { r.n[RS_HI] = slot + 1; }
}
// The run, inside the World's step, after every other system. It begins and ends itself in the
// World's list. The rows written; -1 when it is not the last system or the World refuses it now
// (no step open, or an earlier system has not run), and then nothing is written.
// (ox, oy, oz) is the page's floating origin this frame, in world metres.
retained_system :: (w: World, r: RetainedStore, ox: f64, oy: f64, oz: f64) -> int #effects(all) {
  if !retained_is_last(w, r) || !world_system_begin(w, r.n[RS_SYSTEM]) { return -1; }
  // a base too far from the page's origin: every row again, from the origin
  far := false;
  d := [3] f64.[ox - r.base[0], oy - r.base[1], oz - r.base[2]];
  for k: 0..<3 { if d[k] > RETAINED_REBASE_FAR || d[k] < -RETAINED_REBASE_FAR { far = true; } }
  if far { r.base[0] = ox; r.base[1] = oy; r.base[2] = oz; r.n[RS_REBASES] += 1; }
  written := 0; high := world_high(w);
  for slot: 0..<high {
    at := slot * RETAINED_ROW;
    drawn := world_alive(w, world_at(w, slot)) && world_has(w, slot, WORLD_TRANSFORM | WORLD_KIND) && r.mesh[slot] > 0;
    if !drawn {
      if r.rows[at + RR_LIVE] != 0 { for k: 0..<RETAINED_ROW { r.rows[at + k] = 0; } rt_dirty(r, slot); written += 1; }
      continue;
    }
    now := [4] f32.[cast(f32) (cast(f64) world_f(w, WF_X, slot) - r.base[0]), cast(f32) (cast(f64) world_f(w, WF_Y, slot) - r.base[1]),
                    cast(f32) (cast(f64) world_f(w, WF_Z, slot) - r.base[2]), world_f(w, WF_YAW, slot)];
    fresh := r.rows[at + RR_LIVE] == 0;
    // where it stood a step ago: its row as it was; a new row, or a rebased one, starts at rest
    was := [4] f32.[r.rows[at + RR_X], r.rows[at + RR_Y], r.rows[at + RR_Z], r.rows[at + RR_YAW]];
    if fresh || far { was = now; }
    same := !fresh && !far && r.rows[at + RR_SCALE] == r.scale[slot] && r.rows[at + RR_MESH] == f32(r.mesh[slot]) && r.rows[at + RR_MATERIAL] == f32(r.material[slot]);
    for k: 0..<4 { if r.rows[at + k] != now[k] || r.rows[at + RR_PX + k] != was[k] { same = false; } }
    if same { continue; }
    for k: 0..<4 { r.rows[at + k] = now[k]; r.rows[at + RR_PX + k] = was[k]; }
    r.rows[at + RR_SCALE] = r.scale[slot]; r.rows[at + RR_MESH] = f32(r.mesh[slot]); r.rows[at + RR_MATERIAL] = f32(r.material[slot]); r.rows[at + RR_LIVE] = 1;
    rt_dirty(r, slot); written += 1;
  }
  world_system_end(w);
  r.n[RS_WRITTEN] = written; r.n[RS_RUNS] += 1;
  return written;
}
// The rows a host has still to upload, and they are taken: the next span starts empty.
retained_take :: (r: RetainedStore) -> RetainedSpan #effects(all) {
  if r.n[RS_READY] != 1 || r.n[RS_LO] >= r.n[RS_HI] { return RetainedSpan.{}; }
  s := RetainedSpan.{first = r.n[RS_LO], count = r.n[RS_HI] - r.n[RS_LO]};
  r.n[RS_LO] = 0; r.n[RS_HI] = 0; r.n[RS_UPLOADED] += s.count;
  return s;
}
// The span without taking it (the face's coaxial_store_span_v1 asks for the offset, then the length).
retained_span :: (r: RetainedStore) -> RetainedSpan #effects(all) {
  if r.n[RS_READY] != 1 || r.n[RS_LO] >= r.n[RS_HI] { return RetainedSpan.{}; }
  return RetainedSpan.{first = r.n[RS_LO], count = r.n[RS_HI] - r.n[RS_LO]};
}
// The frame's origin uniform: what the GPU adds to a row's place to stand it from the page's
// origin (ox, oy, oz), and the fourth word the rebases so far (a pass that caches by origin reads it).
retained_origin :: (r: RetainedStore, ox: f64, oy: f64, oz: f64, out: [] f32) -> bool #effects(all) {
  if r.n[RS_READY] != 1 || out.count < 4 { return false; }
  out[0] = cast(f32) (r.base[0] - ox); out[1] = cast(f32) (r.base[1] - oy); out[2] = cast(f32) (r.base[2] - oz); out[3] = f32(r.n[RS_REBASES]);
  return true;
}
// The slots to draw near the camera: the spatial index's answer at (x, z) within `reach`, those
// with a live row, into out. How many. Call it after the step (or inside this system's run).
retained_visible :: (w: World, r: RetainedStore, x: f32, z: f32, reach: f32, out: [] int) -> int #effects(all) {
  if r.n[RS_READY] != 1 { return 0; }
  found := world_near(w, x, z, reach, out);
  if found > out.count { found = out.count; }
  n := 0;
  for k: 0..<found { s := out[k]; if s >= 0 && s < retained_cap(r) && r.rows[s * RETAINED_ROW + RR_LIVE] != 0 { out[n] = s; n += 1; } }
  return n;
}
