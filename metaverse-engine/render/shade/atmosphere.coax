    for i:0..<20 { for j:0..<6 {
      a:f32=(cast(f32)i+0.5f32)/20.0f32*6.2831853f32; e:f32=0.0f32-0.15f32+1.6f32*(cast(f32)j+0.5f32)/6.0f32;
      rd:V3=v3(sin(a)*cos(e),sin(e),0.0f32-cos(a)*cos(e));
