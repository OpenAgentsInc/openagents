// The frame's resolved environment as a typed uniform block (#13451): env_gpu_pack's 27 vec4 rows
// (metaverse-engine/render/shade/environment.coax, layout 1) as a shader reads them. A page whose uniforms
// are a typed block holds one at a 16-byte place (Everglade II's E2U.env); a page whose uniforms
// are still a []f32 reads one from its floats with env_block_of. painterly.coax's paint_env_* read
// it by the layout's own word numbers (ENV_GPU_*, ENV_GPU_CHANNELS + ENV_C_*).
//   coax/bin/coax test metaverse-engine/render/shade/env-block.coax
#load "../../gpu/shader.coax";   // V4 alone: a page loads this beside its own vocabulary
#load "environment.coax";   // ENV_GPU_FLOATS and the layout's offsets

ENV_BLOCK_ROWS :: 27;   // ENV_GPU_FLOATS / 4
EnvBlock :: struct {rows:[ENV_BLOCK_ROWS]V4;}
// Word k of the record (0 to ENV_GPU_FLOATS - 1).
env_block_w :: (e:EnvBlock,k:int)->f32 {return v4_lane(e.rows[k/4],k%4);}
// Three words from k: a colour or a direction, wherever its rows fall.
env_block_w3 :: (e:EnvBlock,k:int)->V3 {return V3.{x=env_block_w(e,k),y=env_block_w(e,k+1),z=env_block_w(e,k+2)};}
// The block written as floats from u[at] (a []f32 page's uniforms; the record env_gpu_pack writes).
env_block_of :: (u:[]f32,at:int)->EnvBlock {
 e:EnvBlock;
 for i:0..<ENV_BLOCK_ROWS {e.rows[i]=v4_at(u,at+4*i);}
 return e;
}

#test "the block is the record's words, row by row, and is read back word for word" {
 #assert ENV_BLOCK_ROWS*4==ENV_GPU_FLOATS && size_of(EnvBlock)==ENV_GPU_FLOATS*4;
 r:=env_profile_sample(env_glade_profile(),0.5);w:=env_gpu_pack(r);
 u:[ENV_GPU_FLOATS+8]f32;for i:0..<ENV_GPU_FLOATS {u[8+i]=w[i];}
 e:=env_block_of(u[..],8);
 for i:0..<ENV_GPU_FLOATS {#assert env_block_w(e,i)==w[i];}
 d:=env_block_w3(e,ENV_GPU_DIR);#assert d.x==r.dir.x && d.y==r.dir.y && d.z==r.dir.z;
 // a colour across two rows
 c:=env_block_w3(e,ENV_GPU_CHANNELS+2);#assert c.x==w[22] && c.y==w[23] && c.z==w[24];
}
