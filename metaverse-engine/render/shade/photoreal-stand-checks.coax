// Checks that pin what photoreal.coax's vertex stage, night sky, still water and lamps give over a
// grid of records, kinds, distances, winds, lights and days: each sums every number a case gives,
// weighted by the case, and compares the sum with the one these procedures gave when it was
// pinned. photoreal.coax loads this file for its checks alone (#load ... #test), so its procedures
// ship nowhere.
prs_v3 :: (v:V3,w:f64)->f64 {return w*(cast(f64)v.x+1.3*cast(f64)v.y+1.7*cast(f64)v.z);}
prs_v4 :: (v:V4,w:f64)->f64 {return w*(cast(f64)v.x+1.3*cast(f64)v.y+1.7*cast(f64)v.z+2.3*cast(f64)v.w);}
prs_w :: (k:int)->f64 {return cast(f64)(k%17+1);}
prs_vertex :: (v:PrV,k:int)->f64 {
  w:f64=prs_w(k);
  return prs_v4(v.pos,w)+prs_v3(v.world,w*1.1)+prs_v3(v.local,w*1.3)+prs_v3(v.normal,w*1.7)+prs_v3(v.facing,w*1.9)+prs_v3(v.tint,w*2.3)+prs_v4(v.info,w*2.9);
}
// (of a surface's numbers, still water sets these; it leaves glow and what passes through at 0)
prs_surface :: (s:PrSurface,k:int)->f64 {
  w:f64=prs_w(k);
  return prs_v3(s.albedo,w)+w*(2.1*cast(f64)s.rough+2.9*cast(f64)s.metal)+prs_v3(s.normal,w*3.1);
}
// A frame block with a platform turned a little and moved, a wind, an eye's field.
prs_block :: (u:[]f32) {
  pr_test_block(u);
  c:f32=cos(0.3f32); s:f32=sin(0.3f32);
  u[PR_POSE]=c; u[PR_POSE+2]=s; u[PR_POSE+3]=4.0f32; u[PR_POSE+8]=0.0f32-s; u[PR_POSE+10]=c; u[PR_POSE+7]=0.0f32-2.0f32; u[PR_POSE+11]=7.0f32;
  u[PR_WIND]=0.6f32; u[PR_WIND+1]=0.8f32; u[PR_WIND+2]=5.0f32; u[PR_WIND+3]=0.7f32;
  // and a sun's shadow map, a little turned and moved
  u[PR_LIGHT]=0.01f32; u[PR_LIGHT+1]=0.002f32; u[PR_LIGHT+3]=0.1f32; u[PR_LIGHT+5]=0.01f32; u[PR_LIGHT+6]=0.003f32; u[PR_LIGHT+7]=0.0f32-0.2f32;
  u[PR_LIGHT+10]=0.005f32; u[PR_LIGHT+11]=0.5f32; u[PR_LIGHT+15]=1.0f32;
}
// The records: every kind and the halves between them, with and without a stretch, riding the
// platform or free, near limits and none, at distances from a few metres to most of a kilometre.
PRS_OBJECTS :: 130;
prs_objects :: (o:[]PrObj) {
  bws:=[5]f32.[0.0f32,-40.0f32,0.5f32,1.0f32,81.0f32];
  for i:0..<PRS_OBJECTS {
    kind:int=i%13; st:int=(i/13)%2; bw:int=i/26;
    m:PrObj;
    m.a=v4(cast(f32)(i%7)*3.0f32-9.0f32,cast(f32)(i%3),0.0f32-6.0f32-cast(f32)((i*37)%900),cast(f32)i*0.7f32);
    m.b=v4(0.6f32+cast(f32)(i%5)*0.3f32,cast(f32)kind*0.5f32,cast(f32)i*0.37f32,bws[bw]);
    m.c=v4(0.9f32,0.8f32,0.7f32,cast(f32)i);
    m.d=ifx st==1 then v4(1.5f32,2.0f32,0.7f32,ifx i%4==0 then 3.0f32 else 0.0f32) else v4(0.0f32,0.0f32,0.0f32,ifx i%4==0 then 3.0f32 else 0.0f32);
    o[i]=m;
  }
  // and one leaning record far off, its lean's roll and pitch both turned
  o[PRS_OBJECTS-1].b=v4(0.4f32,4.0f32,0.9f32,0.0f32); o[PRS_OBJECTS-1].a=v4(1.0f32,0.0f32,0.0f32-1500.0f32,0.2f32);
}
// Three vertices: a plain one with no tint of its own, a leaf folding from 10 m that sinks into
// its part, and one marked to fold from exactly the mark.
prs_mesh :: (mesh:[]f32) {
  v:=[36]f32.[0.5f32,1.0f32,0.25f32, 0.3f32,0.8f32,0.5f32, 2.0f32, 0.0f32,0.0f32, 0.0f32,0.0f32,0.0f32,
              -0.4f32,2.5f32,0.6f32, 0.0f32,0.0f32,1.0f32, 4.0f32, -10.0f32,0.3f32, 0.5f32,0.6f32,0.7f32,
              0.2f32,0.0f32,-0.3f32, 1.0f32,0.0f32,0.0f32, 1.0f32, -8.0f32,0.2f32, 1.0f32,0.0f32,0.0f32];
  for i:0..<36 {mesh[i]=v[i];}
}
// Every record's every vertex, and its shadow's, under one frame block.
prs_stand_pass :: (u:[]f32,objects:[]PrObj,mesh:[]f32,k0:int)->f64 {
  sum:f64=0.0; k:int=k0;
  for i:0..<PRS_OBJECTS { for id:0..<3 {
    sum=sum+prs_vertex(pr_stand(cast(u32)id,cast(u32)i,u,0,mesh,objects),k);
    sum=sum+prs_v4(pr_shadow_stand(cast(u32)id,cast(u32)i,u,0,mesh,objects).pos,prs_w(k)*0.7);
    k=k+1;
  } }
  return sum;
}
prs_stand_sum :: ()->f64 {
  u:[PR_FLOATS]f32; prs_block(u[..]);
  objects:[PRS_OBJECTS]PrObj; prs_objects(objects[..]);
  mesh:[36]f32; prs_mesh(mesh[..]);
  levels:=[3]f32.[0.0f32,0.02f32,0.6f32]; times:=[3]f32.[0.0f32,1.7f32,4.3f32];
  sum:f64=0.0;
  for variant:0..<6 {
    u[PR_LAMPS]=levels[variant%3]; u[PR_UP+3]=times[variant/2]; u[PR_GROUND+3]=ifx variant==4 then 1.0f32 else 0.0f32;
    sum=sum+prs_stand_pass(u[..],objects[..],mesh[..],variant*PRS_OBJECTS*3);
  }
  return sum;
}
#test "the vertex stage pinned: every kind of record, its stretch, ride and near limit, each vertex, lamps, times and tiers" #steps 2000000000 {
  t:f64=prs_stand_sum();
  #assert abs(t-1292087.391274153)<0.000000000001*abs(t);
  // a tier of exactly 0.5 is still the full one
  u:[PR_FLOATS]f32; prs_block(u[..]); u[PR_LAMPS]=0.6f32; u[PR_UP+3]=1.7f32;
  objects:[PRS_OBJECTS]PrObj; prs_objects(objects[..]);
  mesh:[36]f32; prs_mesh(mesh[..]);
  full:f64=prs_stand_pass(u[..],objects[..],mesh[..],0);
  u[PR_GROUND+3]=0.5f32; half:f64=prs_stand_pass(u[..],objects[..],mesh[..],0);
  u[PR_GROUND+3]=1.0f32; reduced:f64=prs_stand_pass(u[..],objects[..],mesh[..],0);
  #assert half==full&&reduced!=full;
}

// The moon's face over a grid across its disc and past its edge, for a moon low, overhead and
// behind, the sun opposite, behind it, beside it and below; a pixel of three widths.
prs_moon_sum :: ()->f64 {
  // (the fourth stands so near overhead that its across way's square is exactly the least the face takes)
  moons:=[4]V3.[v3(0.0f32,0.6f32,0.8f32),v3(0.0f32,1.0f32,0.0f32),normalize3(v3(0.3f32,0.2f32,0.0f32-0.93f32)),v3(0.0003000000142492354f32,1.0f32,0.0009539392194710672f32)];
  softs:=[3]f32.[0.0002f32,0.00001f32,0.001f32];
  sum:f64=0.0; k:int=0;
  for mi:0..<4 {
    moon:V3=moons[mi];
    ax:V3=cross3(v3(0.0f32,1.0f32,0.0f32),moon);
    if (dot3(ax,ax)<0.000001f32) {ax=v3(1.0f32,0.0f32,0.0f32);}
    ax=normalize3(ax); ay:V3=cross3(moon,ax);
    suns:=[4]V3.[scale3(moon,0.0f32-1.0f32),moon,ax,v3(0.0f32,0.0f32-1.0f32,0.0f32)];
    for si:0..<4 { for so:0..<3 { for gx:-6..<7 { for gy:-6..<7 {
      rd:V3=normalize3(add3(moon,add3(scale3(ax,cast(f32)gx*0.0009f32),scale3(ay,cast(f32)gy*0.0009f32))));
      f:V2=pr_moon_face(rd,moon,suns[si],softs[so]);
      sum=sum+prs_w(k)*(cast(f64)f.x+1.3*cast(f64)f.y); k=k+1;
    } } } }
  }
  return sum;
}
// The stars over a spiral of the sky, from the horizon up.
prs_star_sum :: ()->f64 {
  sum:f64=0.0;
  for i:0..<6000 { // mutant: equivalent (the spiral's first way is at the stars' horizon and its last holds no star: where it starts and stops is the check's own choice)
    a:f32=cast(f32)i*0.731f32; y:f32=0.02f32+0.97f32*fract(cast(f32)i*0.618034f32); r:f32=sqrt(1.0f32-y*y);
    sum=sum+prs_v3(pr_stars(v3(cos(a)*r,y,sin(a)*r)),prs_w(i));
  }
  return sum;
}
// The night sky alone over a sky of nothing, along the spiral's ways that hold a star, the moon
// set on one of them: through the evening, cloud from none to most, the moon down, half up
// (still down) and up.
prs_night_sum :: ()->f64 {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  ways:[6000]V3; n:int=0;
  for i:0..<6000 { // mutant: equivalent (the spiral's first way is at the stars' horizon and its last holds no star: where it starts and stops is the check's own choice)
    a:f32=cast(f32)i*0.731f32; y:f32=0.02f32+0.97f32*fract(cast(f32)i*0.618034f32); r:f32=sqrt(1.0f32-y*y);
    rd:V3=v3(cos(a)*r,y,sin(a)*r);
    st:V3=pr_stars(rd);
    if (st.x>0.0f32) {ways[n]=rd; n=n+1;}
  }
  #assert n==43;
  u[PR_MOON]=ways[5].x; u[PR_MOON+1]=ways[5].y; u[PR_MOON+2]=ways[5].z;
  days:=[4]f32.[0.0f32,0.25f32,0.5f32,0.9f32]; moons:=[3]f32.[0.0f32,0.5f32,1.0f32]; hides:=[2]f32.[0.0f32,0.6f32];
  sum:f64=0.0; k:int=0;
  for d:0..<4 { for mo:0..<3 { for h:0..<2 {
    u[PR_SUN+3]=days[d]; u[PR_MOON+3]=moons[mo];
    for i:0..<n {sum=sum+prs_v3(pr_night_sky(v3(0.0f32,0.0f32,0.0f32),ways[i],0.0004f32,hides[h],u[..],0),prs_w(k)); k=k+1;}
  } } }
  return sum;
}
// The sky a realm draws, and its night sky alone, along a spread of ways (under the horizon,
// toward the sun and the moon, overhead) through the day, with and without a moon, cloud and the
// reduced tier.
prs_dome_pass :: (u:[]f32,k0:int)->f64 {
  sum:f64=0.0; k:int=k0; moon:V3=pr_at3(u,PR_MOON);
  for i:0..<48 {
    rd:V3;
    if (i==0) {rd=moon;} else if (i==47) {rd=v3(1.0f32,0.0f32,0.0f32);} else if (i==1) {rd=v3(u[PR_SUN],u[PR_SUN+1],u[PR_SUN+2]);} else if (i<4) {rd=normalize3(add3(moon,v3(0.002f32*cast(f32)(i-2),0.001f32,0.0f32)));}
    else {a:f32=cast(f32)i*0.731f32; y:f32=0.0f32-0.3f32+1.25f32*fract(cast(f32)i*0.618034f32); r:f32=sqrt(fmax(1.0f32-y*y,0.0f32)); rd=v3(cos(a)*r,y,sin(a)*r);}
    sum=sum+prs_v3(pr_dome(rd,0.0004f32,u,0),prs_w(k));
    sum=sum+prs_v3(pr_night_sky(v3(0.01f32,0.02f32,0.03f32),rd,0.0004f32,ifx i%2==0 then 0.0f32 else 0.4f32,u,0),prs_w(k)*1.9);
    k=k+1;
  }
  return sum;
}
prs_dome_block :: (u:[]f32) {
  pr_test_block(u);
  moon:V3=normalize3(v3(0.0f32-0.5f32,0.5f32,0.0f32-0.7f32));
  u[PR_MOON]=moon.x; u[PR_MOON+1]=moon.y; u[PR_MOON+2]=moon.z; u[PR_SKY_SHARE]=0.9f32;
}
prs_dome_sum :: ()->f64 {
  u:[PR_FLOATS]f32; prs_dome_block(u[..]);
  days:=[4]f32.[0.0f32,0.2f32,0.75f32,1.0f32];
  sum:f64=0.0;
  for variant:0..<16 {
    u[PR_SUN+3]=days[variant%4]; u[PR_MOON+3]=ifx (variant/4)%2==0 then 1.0f32 else 0.0f32;
    u[PR_GROUND+3]=ifx variant>=8 then 1.0f32 else 0.0f32;
    u[PR_UP+3]=37.0f32+cast(f32)variant*11.0f32;   // (the clouds drift with the time)
    // the last four under a sun on the horizon, looked at along the horizon itself
    if (variant>=12) {u[PR_SUN]=1.0f32; u[PR_SUN+1]=0.0f32; u[PR_SUN+2]=0.0f32;}
    u[PR_HAZE+3]=ifx variant%3==0 then 0.7f32 else 0.0f32; u[PR_AIR_HAZE]=ifx variant%5==1 then 0.15f32 else 0.0f32;
    sum=sum+prs_dome_pass(u[..],variant*48);
  }
  return sum;
}
#test "the night pinned: the moon's face across its disc, the stars over the sky, and the dome and night sky through the day" #steps 2000000000 {
  m:f64=prs_moon_sum(); s:f64=prs_star_sum(); d:f64=prs_dome_sum(); n:f64=prs_night_sum();
  #assert abs(n-71.58393252576379)<0.000000000001*abs(n);
  #assert abs(m-60446.79974153882)<0.000000000001*abs(m);
  #assert abs(s-6.367499740095038)<0.000000000001*abs(s);
  #assert abs(d-28688.317609901722)<0.000000000001*abs(d);
  // under cloud by day: a tier of exactly 0.5 is still the full one, a moon flag of exactly 0.5 still down
  u:[PR_FLOATS]f32; prs_dome_block(u[..]); u[PR_SUN+3]=0.75f32; u[PR_HAZE+3]=0.7f32; u[PR_UP+3]=40.0f32;
  full:f64=prs_dome_pass(u[..],0);
  u[PR_GROUND+3]=0.5f32; half:f64=prs_dome_pass(u[..],0);
  u[PR_GROUND+3]=1.0f32; reduced:f64=prs_dome_pass(u[..],0);
  #assert half==full&&reduced!=full;
  u[PR_GROUND+3]=0.0f32; u[PR_SUN+3]=0.0f32;
  down:f64=prs_dome_pass(u[..],0);
  u[PR_MOON+3]=0.5f32; still:f64=prs_dome_pass(u[..],0);
  u[PR_MOON+3]=1.0f32; up:f64=prs_dome_pass(u[..],0);
  #assert still==down&&up!=down;
}

// Still water on a floor, on a face whose up is exactly the floor's limit, and on a wall, in a
// wind, at times, from eyes, under a high and a low sun, by day and night, on both tiers, at its
// own depth and at the default.
prs_water_sum :: ()->f64 {
  u:[PR_FLOATS]f32; prs_block(u[..]);
  m:[2*PR_MATERIAL_FLOATS]f32;
  m[0]=0.4f32; m[1]=0.5f32; m[2]=0.45f32; m[PR_M_ROUGH]=0.3f32; m[PR_M_METAL]=0.1f32; m[PR_M_PATTERN]=cast(f32)PR_PATTERN_WATER;
  faces:=[3]V3.[v3(0.0f32,1.0f32,0.0f32),v3(sqrt(0.51f32),0.7f32,0.0f32),v3(0.0f32,0.0f32,1.0f32)];
  sum:f64=0.0; k:int=0;
  for variant:0..<8 {
    u[PR_UP+3]=1.3f32+cast(f32)variant*2.1f32; u[PR_SUN+1]=ifx variant%2==0 then 0.64f32 else 0.01f32; u[PR_SUN+3]=ifx variant%3==0 then 0.3f32 else 1.0f32;
    u[PR_GROUND+3]=ifx variant>=6 then 1.0f32 else 0.0f32; m[PR_M_SCALE]=ifx variant%4<2 then 0.0f32 else 2.5f32;
    u[PR_EYE]=cast(f32)variant*3.0f32-5.0f32; u[PR_EYE+2]=cast(f32)variant*-2.0f32;
    u[PR_WIND+2]=cast(f32)variant*3.0f32;
    for fi:0..<3 { for p:0..<9 {
      v:PrV;
      x:f32=cast(f32)p*7.3f32-11.0f32; z:f32=cast(f32)p*5.7f32+0.4f32;
      v.world=v3(x,0.5f32,z); v.local=v3(x*0.8f32,0.2f32,z*1.2f32); v.normal=faces[fi]; v.facing=faces[fi];
      v.tint=v3(1.0f32,0.9f32,0.8f32); v.info=v4(0.0f32,0.0f32,cast(f32)p,0.0f32);
      sum=sum+prs_surface(pr_surface(v,u[..],0,m[..]),k); k=k+1;
    } }
  }
  return sum;
}
// The lamps' light: field sizes at and under two cells a side, the field on and off, points in
// and out of it, above and below its ground, faces up, sideways and down, levels from the least
// that shows, near lights from none to the table's every one, on smooth and rough surfaces.
// The field's lamp part and the near lights; a field 5 m a cell from (-3, 2), its ground at 1 m.
// (No field size reads under 8: the lamp part starts after the sky part's two floats a cell.)
prs_lamp_setup :: (u:[]f32,field:[]f32,table:[]f32) {
  u[PR_FIELD]=0.0f32-3.0f32; u[PR_FIELD+1]=2.0f32; u[PR_FIELD+2]=5.0f32; u[PR_FIELD+3]=1.0f32;
  for i:8..<field.count {field[i]=0.01f32*cast(f32)((i*7)%23)+0.002f32;}
  for l:0..<PR_NEAR_LIGHTS {
    row:int=(PR_MATERIALS+l)*PR_MATERIAL_FLOATS;
    table[row]=cast(f32)l*2.0f32-9.0f32; table[row+1]=3.0f32+cast(f32)(l%3); table[row+2]=cast(f32)(l%4)*3.0f32-2.0f32;
    table[row+3]=ifx l%5==4 then 0.5f32 else 12.0f32+cast(f32)l; table[row+4]=30.0f32+cast(f32)l; table[row+5]=20.0f32; table[row+6]=10.0f32-cast(f32)l*0.5f32;
  }
}
// Points in and out of the field, above and below its ground, faces up, sideways and down.
prs_lamp_points :: (u:[]f32,field:[]f32,table:[]f32,s:PrSurface,k0:int)->f64 {
  normals:=[4]V3.[v3(0.0f32,1.0f32,0.0f32),v3(1.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,1.0f32),normalize3(v3(0.2f32,0.0f32-0.9f32,0.3f32))];
  sum:f64=0.0; k:int=k0;
  for p:0..<12 { for ni:0..<4 {
    q:V3=v3(cast(f32)p*2.3f32-8.0f32,ifx p%3==0 then 0.0f32 else cast(f32)p*1.4f32-4.0f32,cast(f32)p*1.9f32-3.0f32);
    toward:V3=normalize3(v3(0.3f32*cast(f32)(p%5)-0.6f32,1.0f32,0.2f32));
    sum=sum+prs_v3(pr_lamps(q,normals[ni],toward,s,u,0,field,table),prs_w(k)); k=k+1;
  } }
  return sum;
}
prs_lamp_sum :: ()->f64 {
  u:[PR_FLOATS]f32; field:[4*4*2+4*4*4]f32; table:[PR_TABLE_FLOATS]f32;
  prs_lamp_setup(u[..],field[..],table[..]);
  sizes:=[6]int.[1,4, 4,1, 2,2]; more:=[6]int.[2,3, 3,2, 4,4]; // mutant: equivalent (a side of 1 cell is no field whatever the other side: the 4 beside a 1 could be any size)
  levels:=[3]f32.[1.0f32,0.001f32,0.0012f32]; counts:=[4]f32.[0.0f32,1.0f32,2.4f32,13.0f32]; roughs:=[4]f32.[0.1f32,0.49f32,0.5f32,0.9f32];   // (13: more than the table holds)
  sum:f64=0.0;
  for f:0..<6 {
    u[PR_FIELD_N]=cast(f32)(ifx f<3 then sizes[f*2] else more[(f-3)*2]); u[PR_FIELD_N+1]=cast(f32)(ifx f<3 then sizes[f*2+1] else more[(f-3)*2+1]);
    for variant:0..<8 {
      u[PR_LAMPS]=levels[variant%3]; u[PR_LAMPS+3]=ifx variant%2==0 then 1.0f32 else 0.0f32; u[PR_LAMPS+2]=counts[variant%4];
      s:PrSurface; s.albedo=v3(0.5f32,0.4f32,0.3f32); s.metal=ifx variant%3==2 then 0.6f32 else 0.0f32; s.rough=roughs[(variant+f)%4];
      sum=sum+prs_lamp_points(u[..],field[..],table[..],s,(f*8+variant)*48);
    }
  }
  return sum;
}
#test "still water and the lamps pinned: ripples, depth, the sun's net and sheen; the lamp field's cells and edges and the near lights' highlights" #steps 2000000000 {
  w:f64=prs_water_sum(); l:f64=prs_lamp_sum();
  #assert abs(w-11394.343508934375)<0.000000000001*abs(w);
  #assert abs(l-62.304934644515015)<0.000000000001*abs(l);
  // a field flag of exactly 0.5 is still off
  u:[PR_FLOATS]f32; field:[4*4*2+4*4*4]f32; table:[PR_TABLE_FLOATS]f32;
  prs_lamp_setup(u[..],field[..],table[..]);
  u[PR_FIELD_N]=4.0f32; u[PR_FIELD_N+1]=4.0f32; u[PR_LAMPS]=1.0f32;
  s:PrSurface; s.albedo=v3(0.5f32,0.4f32,0.3f32); s.rough=0.9f32;
  off:f64=prs_lamp_points(u[..],field[..],table[..],s,0);
  u[PR_LAMPS+3]=0.5f32; half:f64=prs_lamp_points(u[..],field[..],table[..],s,0);
  u[PR_LAMPS+3]=1.0f32; on:f64=prs_lamp_points(u[..],field[..],table[..],s,0);
  #assert half==off&&on!=off;
}

#test "a star shows from just over the stars' horizon, and the faintest star is one whose cell is exactly at the threshold" {
  // over a star at the horizon's own height none shows; a hair higher, it does
  k:f32=260.0f32/(0.02f32+0.42f32); found:bool=false; gx:f32=0.0f32; gz:f32=0.0f32;
  for a:0..<400 { for c:0..<40 {
    if (!found&&render_noise2(cast(f32)a,cast(f32)c)>0.96f32) {
      found=true;
      gx=cast(f32)a+0.25f32+0.5f32*render_noise2(cast(f32)a+17.0f32,cast(f32)c);
      gz=cast(f32)c+0.25f32+0.5f32*render_noise2(cast(f32)a,cast(f32)c+31.0f32);
    }
  } }
  #assert found;
  at:V3=pr_stars(v3(gx/k,0.02f32,gz/k));
  #assert at.x==0.0f32&&at.y==0.0f32&&at.z==0.0f32;
  k2:f32=260.0f32/(0.0201f32+0.42f32);
  over:V3=pr_stars(v3(gx/k2,0.0201f32,gz/k2));
  #assert over.x>0.0f32&&over.y>0.0f32&&over.z>0.0f32;
  // the noise's one cell in 36 million exactly at 0.955 (found by search, far out along the grid):
  // its star is the faintest, 0.006 of its colour at its centre
  #assert render_noise2(0.0f32-598.0f32,0.0f32-2599.0f32)==0.955f32;
  cx:f32=0.0f32-598.0f32; cz:f32=0.0f32-2599.0f32;
  ox:f32=0.25f32+0.5f32*render_noise2(cx+17.0f32,cz); oz:f32=0.25f32+0.5f32*render_noise2(cx,cz+31.0f32);
  k3:f32=260.0f32/(1.0f32+0.42f32);
  faint:V3=pr_stars(v3((cx+ox)/k3,1.0f32,(cz+oz)/k3));
  #assert faint.x>0.004f32&&faint.x<0.0061f32;
}
#test "a beacon is dark only while its flash is under -0.3, not at it" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]); u[PR_LAMPS]=1.0f32;
  mesh:[12]f32; mesh[0]=0.5f32; mesh[1]=1.0f32; mesh[4]=1.0f32;
  // sin(x) is exactly -0.3 for this x (found by search), and at time 0 the flash is sin of its phase
  #assert sin(0.0f32-0.30469266f32)==0.0f32-0.3f32;
  o:[2]PrObj;
  o[0].a=v4(0.0f32,5.0f32,0.0f32-20.0f32,0.0f32); o[0].b=v4(1.0f32,6.0f32,0.0f32-0.30469266f32,1.0f32); o[0].c=v4(1.0f32,1.0f32,1.0f32,0.0f32);
  o[1]=o[0]; o[1].b.z=0.0f32-0.4f32;
  lit:PrV=pr_stand(0,0,u[..],0,mesh[..],o[..]); dark:PrV=pr_stand(0,1,u[..],0,mesh[..],o[..]);
  #assert !(lit.pos.x==0.0f32&&lit.pos.y==0.0f32&&lit.pos.z==2.0f32&&lit.pos.w==1.0f32);
  #assert dark.pos.x==0.0f32&&dark.pos.y==0.0f32&&dark.pos.z==2.0f32&&dark.pos.w==1.0f32;
}
