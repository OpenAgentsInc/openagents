// The Metaverse Engine's photoreal style (docs/metaverse/art-styles.md, docs/metaverse/photoreal.md):
// what a realm tagged `photoreal` shades with. Written in Coax and emitted for each GPU.
//
// Light is in its own scale (linear; 1 is a bright white wall in full sun), from a sky that is
// arithmetic on the sun's place (atmosphere.coax): the sun's colour after its air, the sky's
// light on a surface by its normal, the same sky in reflections, and the air's light over
// distance. Surfaces are physically based: a GGX highlight and Fresnel that keep energy
// (character-material.coax cm_ggx), a split-sum environment response (pbr-env.coax), roughness and
// normal detail from a material's pattern. The frame leaves through the film response
// (filmic.coax) at one exposure: the golden hour's colour is the sun's own, not a tint.
//
// A realm's shader module names its entries and calls these with the first float of the frame's
// block in its uniforms (`b`; photoreal-layout.coax, written by photoreal-frame.coax):
//   pr_stand         a part's vertex where its record stands it (the scene's and the shadow's vertex):
//                    bent by the wind, a leaf folded away with distance, a lamp's glow kept a pixel wide
//   pr_surface       a material's surface at a point: colour, roughness, metal, normal detail
//   pr_shadow        how much of the sun reaches a point, from the shadow map
//   pr_field         how much of the sky a point near the ground sees (the ground's sky field)
//   pr_environment   what a surface mirrors: the sky, the sea and ground under the horizon
//   pr_lit           a surface under the sun and the sky
//   pr_lamps         the lamps' light on a surface at night: the baked field, and the lights near the eye
//   pr_air           the air between the eye and a point
//   pr_dome          the sky a realm draws behind its world
//   pr_out           the frame's light as the display's colour
//   coax/bin/coax test --library metaverse-engine/render/shade/photoreal.coax
#load "../../gpu/wgsl.coax";
#load "../noise.coax";
#load "atmosphere.coax";
#load "filmic.coax";
#load "pbr-env.coax";
#load "character-material.coax";
#load "water-optics.coax";
#load "photoreal-layout.coax";
#load "photoreal-surfaces.coax";

// A record as the shader reads it: four rows of four (photoreal-layout.coax PR_R_*).
PrObj :: struct {a:V4; b:V4; c:V4; d:V4;}
// A vertex on its way to the fragment: where it is in the world, where on its own part (metres,
// before its turn), both normals, the pen's tint times the record's, and the facts that don't
// blend: its material, the record's value, the record's phase, 0.
PrV :: struct {pos:V4; world:V3; local:V3; normal:V3; facing:V3; tint:V3; info:V4 #flat;}
PrShade :: struct {pos:V4;}
// A surface ready to light. `through` is how much light passes a thin thing (a leaf).
PrSurface :: struct {albedo:V3; rough:f32; metal:f32; normal:V3; glow:V3; through:f32;}

pr_at3 :: (u:[]f32,at:int)->V3 {return v3(u[at],u[at+1],u[at+2]);}
pr_lum :: (c:V3)->f32 {return c.x*0.2126f32+c.y*0.7152f32+c.z*0.0722f32;}
// A display colour as light, and back (the sRGB curve).
pr_decode1 :: (x:f32)->f32 {c:f32=fmax(x,0.0f32);return ifx c<=0.04045f32 then c/12.92f32 else pow((c+0.055f32)/1.055f32,2.4f32);}
pr_encode1 :: (x:f32)->f32 {c:f32=fmax(x,0.0f32);return ifx c<=0.0031308f32 then c*12.92f32 else 1.055f32*pow(c,1.0f32/2.4f32)-0.055f32;}
pr_decode :: (c:V3)->V3 {return v3(pr_decode1(c.x),pr_decode1(c.y),pr_decode1(c.z));}
pr_encode :: (c:V3)->V3 {return v3(pr_encode1(c.x),pr_encode1(c.y),pr_encode1(c.z));}

// ---- the view
// A world point in clip space: depth is 1 - near / (its distance along the view), so a traced
// background that writes the same number (pr_depth) and the meshes hide each other rightly.
pr_clip :: (w:V3,u:[]f32,b:int)->V4 {
  rel:V3=sub3(w,pr_at3(u,b+PR_EYE));
  z:f32=dot3(rel,pr_at3(u,b+PR_FORWARD));
  t:f32=u[b+PR_EYE+3];
  return v4(dot3(rel,pr_at3(u,b+PR_RIGHT))/(t*u[b+PR_RIGHT+3]),dot3(rel,pr_at3(u,b+PR_UP))/t,z-u[b+PR_FORWARD+3],z);
}
// The depth buffer's value for a point `along` the unit view ray `rd`.
pr_depth :: (rd:V3,along:f32,u:[]f32,b:int)->f32 {
  near:f32=u[b+PR_FORWARD+3];
  return clampf(1.0f32-near/fmax(along*dot3(rd,pr_at3(u,b+PR_FORWARD)),near),0.0f32,1.0f32);
}
// The unit ray through a pixel of a target `width` by `height`.
pr_ray :: (pos:V4,width:f32,height:f32,u:[]f32,b:int)->V3 {
  x:f32=(pos.x/width)*2.0f32-1.0f32; y:f32=1.0f32-(pos.y/height)*2.0f32;
  t:f32=u[b+PR_EYE+3];
  return normalize3(add3(pr_at3(u,b+PR_FORWARD),add3(scale3(pr_at3(u,b+PR_RIGHT),x*t*u[b+PR_RIGHT+3]),scale3(pr_at3(u,b+PR_UP),y*t))));
}
// A platform's point in the world, and a direction; and back.
pr_posed :: (p:V3,u:[]f32,b:int)->V3 {
  o:int=b+PR_POSE;
  return v3(u[o]*p.x+u[o+1]*p.y+u[o+2]*p.z+u[o+3],u[o+4]*p.x+u[o+5]*p.y+u[o+6]*p.z+u[o+7],u[o+8]*p.x+u[o+9]*p.y+u[o+10]*p.z+u[o+11]);
}
pr_posed_dir :: (d:V3,u:[]f32,b:int)->V3 {
  o:int=b+PR_POSE;
  return v3(u[o]*d.x+u[o+1]*d.y+u[o+2]*d.z,u[o+4]*d.x+u[o+5]*d.y+u[o+6]*d.z,u[o+8]*d.x+u[o+9]*d.y+u[o+10]*d.z);
}
pr_unposed :: (w:V3,u:[]f32,b:int)->V3 {
  o:int=b+PR_POSE;
  r:V3=v3(w.x-u[o+3],w.y-u[o+7],w.z-u[o+11]);
  return v3(u[o]*r.x+u[o+4]*r.y+u[o+8]*r.z,u[o+1]*r.x+u[o+5]*r.y+u[o+9]*r.z,u[o+2]*r.x+u[o+6]*r.y+u[o+10]*r.z);
}

// ---- the parts
// A record's sizes along its part's axes: its stretch, or its one scale.
pr_sizes :: (m:PrObj)->V3 {
  if (m.d.x==0.0f32&&m.d.y==0.0f32&&m.d.z==0.0f32) {
    // (a leaning record keeps its roll where the scale is: with no stretch it is one metre a metre)
    if (m.b.y>3.5f32&&m.b.y<4.5f32) {return v3(1.0f32,1.0f32,1.0f32);}
    return v3(m.b.x,m.b.x,m.b.x);
  }
  return v3(m.d.x,m.d.y,m.d.z);
}
// How near the eye must be for a record to be drawn (PR_R_NEAR, in the float that says whether
// it rides the platform): 0 when it is drawn at any distance.
pr_near_of :: (m:PrObj)->f32 {
  if (m.b.w<0.0f32) {return 0.0f32-m.b.w;}
  return fmax(m.b.w-1.0f32,0.0f32);
}
// How much of its size a small thing keeps `dist` metres from the eye: all of it out to four
// fifths of `near` (three fifths as far on the reduced tier, whose pixels are fewer), none
// beyond it. With no `near` it is whole at any distance.
pr_near_keep :: (near:f32,dist:f32,reduced:bool)->f32 {
  if (near<=0.0f32) {return 1.0f32;}
  n:f32=ifx reduced then near*0.6f32 else near;
  return saturate((n-dist)/(n*0.2f32));
}
// A part's point in the world, drawn in toward its record's place by what the record keeps at
// its distance from the eye. Beyond `near` a part is one point: no triangle of it reaches a
// pixel or the shadow map.
pr_kept :: (w:V3,m:PrObj,u:[]f32,b:int)->V3 {
  near:f32=pr_near_of(m);
  if (near<=0.0f32) {return w;}
  place:V3=v3(m.a.x,m.a.y,m.a.z);
  if (m.b.w<0.5f32) {place=pr_posed(place,u,b);}
  k:f32=pr_near_keep(near,length3(sub3(place,pr_at3(u,b+PR_EYE))),u[b+PR_GROUND+3]>0.5f32);
  return add3(place,scale3(sub3(w,place),k));
}
// A leaning record's lean of a vector in its part's frame (PR_LEAN): rolled about x by its
// roll, then pitched about z by its pitch. Any other record leaves it.
pr_leant :: (l:V3,m:PrObj)->V3 {
  if (m.b.y<3.5f32||m.b.y>4.5f32) {return l;}
  cr:f32=cos(m.b.x); sr:f32=sin(m.b.x); cp:f32=cos(m.b.z); sp:f32=sin(m.b.z);
  y:f32=l.y*cr-l.z*sr; z:f32=l.y*sr+l.z*cr;
  return v3(l.x*cp-y*sp,l.x*sp+y*cp,z);
}
// A part's point where its record puts it, before the platform's pose: sized, turned about y,
// set down, and moved by its motion in the wind `wind` (PR_WIND: the way it blows x, z; its speed;
// how gusty).
//
// A swaying part (PR_SWAY) leans downwind by the square of the wind's speed and of the height, as
// a stem under drag does; sways about that lean at its own pace; and takes the gusts, which cross
// a wood as waves 45 m long moving with the wind, so neighbours bend one after another. In still
// air only a small shiver is left.
pr_placed_in :: (p:V3,m:PrObj,time:f32,wind:V4)->V3 {
  s:V3=pr_sizes(m);
  l:V3=v3(p.x*s.x,p.y*s.y,p.z*s.z);
  if (m.b.y>0.5f32&&m.b.y<1.5f32) {l=v3(l.x,l.y+0.25f32*sin(time*0.8f32+m.b.z),l.z);}
  l=pr_leant(l,m);
  c:f32=cos(m.a.w); sn:f32=sin(m.a.w);
  w:V3=v3(l.x*c+l.z*sn+m.a.x,l.y+m.a.y,(0.0f32-l.x)*sn+l.z*c+m.a.z);
  if (m.b.y>1.5f32&&m.b.y<2.5f32) {
    h2:f32=l.y*l.y;
    lean:f32=fmin(h2*0.00004f32*wind.z*wind.z,l.y*0.3f32);
    own:f32=sin(time*1.9f32+m.b.z)+0.35f32*sin(time*3.1f32+m.b.z*1.7f32);
    gust:f32=sin((m.a.x*wind.x+m.a.z*wind.y-time*fmax(wind.z,2.0f32))*0.14f32+0.6f32*sin(time*0.23f32+m.b.z));
    along:f32=lean*(1.0f32+wind.w*(0.7f32*gust+0.3f32*own))+h2*0.0003f32*own;
    across:f32=(h2*0.0002f32+lean*0.25f32*wind.w)*sin(time*1.3f32+m.b.z*2.3f32);
    w=v3(w.x+wind.x*along-wind.y*across,w.y,w.z+wind.y*along+wind.x*across);
  }
  return w;
}
// The same in a light breeze along +x (a realm that writes no wind).
pr_placed :: (p:V3,m:PrObj,time:f32)->V3 {return pr_placed_in(p,m,time,v4(1.0f32,0.0f32,3.0f32,0.5f32));}
// How far a leaf marked to fold from `from` metres has folded at `dist` metres from an eye whose
// half field's tangent is `tangent`: 0 standing, 1 gone at 1.6 times the distance. A narrow view
// (a long lens) sees leaves from farther.
PR_FOLD_MARK :: 8.0f32;   // a vertex whose u is under minus this is a leaf: it folds from -u metres, sinking v metres into its part
pr_fold :: (dist:f32,from:f32,tangent:f32)->f32 {return saturate((dist*tangent*2.4f32-from)/(from*0.6f32));}
// How many times its own size a lamp's glow `radius` metres across is drawn at `dist`: 1 near, more
// far off, where it would be under a pixel or two (0.0027 of the view's half height).
pr_lamp_grow :: (dist:f32,radius:f32,tangent:f32)->f32 {return fmax(1.0f32,dist*tangent*0.0027f32/fmax(radius,0.001f32));}
// A part's vertex where its record stands it: the scene's vertex.
pr_stand :: (id:u32,instance:u32,u:[]f32,b:int,mesh:[]f32,objects:[]PrObj)->PrV {
  m:PrObj=objects[cast(int)instance];
  o:int=cast(int)id*12;
  p:V3=v3(mesh[o],mesh[o+1],mesh[o+2]);
  s:V3=pr_sizes(m);
  // a normal under unequal sizes turns by their inverse
  n:V3=normalize3(v3(mesh[o+3]/fmax(s.x,0.000001f32),mesh[o+4]/fmax(s.y,0.000001f32),mesh[o+5]/fmax(s.z,0.000001f32)));
  c:f32=cos(m.a.w); sn:f32=sin(m.a.w);
  time:f32=u[b+PR_UP+3];
  wind:V4=wg_at4(u,b+PR_WIND);
  eye:V3=pr_at3(u,b+PR_EYE);
  rides:bool=m.b.w<0.5f32;
  gone:bool=false;
  dim:f32=1.0f32;
  if (m.b.y>4.5f32) {
    // a lamp's glow (PR_LAMP, PR_BEACON): off by day, a beacon dark between its flashes, and far off no smaller than
    // a pixel or two, dimmer by the area it gained
    level:f32=u[b+PR_LAMPS];
    at:V3=v3(m.a.x,m.a.y,m.a.z);
    if (rides) {at=pr_posed(at,u,b);}
    grow:f32=pr_lamp_grow(length3(sub3(at,eye)),0.5f32*s.x,u[b+PR_EYE+3]);
    p=scale3(p,grow);
    dim=level*fmax(1.0f32/(grow*grow),0.004f32);
    gone=level<0.02f32||(m.b.y>5.5f32&&sin(time*2.1f32+m.b.z)<0.0f32-0.3f32);
  }
  w:V3=pr_placed_in(p,m,time,wind);
  ln:V3=pr_leant(n,m);
  wn:V3=v3(ln.x*c+ln.z*sn,ln.y,(0.0f32-ln.x)*sn+ln.z*c);
  from:f32=0.0f32-mesh[o+7];
  if (from>=PR_FOLD_MARK) {
    // a leaf: it flutters, and with distance sinks into the mass under it and is gone
    seen:V3=w;
    if (rides) {seen=pr_posed(w,u,b);}
    fold:f32=pr_fold(length3(sub3(seen,eye)),from,u[b+PR_EYE+3]);
    if (u[b+PR_GROUND+3]>0.5f32) {fold=1.0f32;}
    gone=fold>=1.0f32;
    own:f32=fract(sin(p.x*12.9898f32+p.y*78.233f32+p.z*37.719f32)*43758.5453f32);
    flutter:f32=fmin(0.012f32+0.006f32*wind.z,0.09f32)*sin(time*(4.0f32+3.0f32*own)+own*6.2831853f32)*(1.0f32-fold);
    w=add3(w,scale3(wn,flutter-mesh[o+8]*fold*s.x));
  }
  if (rides) {w=pr_posed(w,u,b); wn=pr_posed_dir(wn,u,b);}
  w=pr_kept(w,m,u,b);
  v:PrV;
  v.world=w;
  v.local=v3(p.x*s.x,p.y*s.y,p.z*s.z);
  v.normal=wn;
  v.facing=n;
  tint:V3=v3(mesh[o+9],mesh[o+10],mesh[o+11]);
  if (tint.x==0.0f32&&tint.y==0.0f32&&tint.z==0.0f32) {tint=v3(1.0f32,1.0f32,1.0f32);}
  v.tint=scale3(mul3(tint,v3(m.c.x,m.c.y,m.c.z)),dim);
  // (a leaning record's phase is its pitch: its pattern starts at the pattern's corner)
  v.info=v4(ifx m.d.w>0.5f32 then m.d.w else mesh[o+6],m.c.w,ifx (m.b.y>3.5f32&&m.b.y<4.5f32) then 0.0f32 else m.b.z,m.b.w);
  v.pos=pr_clip(w,u,b);
  // what lies on a surface is drawn a few steps of the depth buffer nearer than it
  if (m.b.y>2.5f32&&m.b.y<4.5f32) {v.pos=v4(v.pos.x,v.pos.y,v.pos.z-0.0000006f32*v.pos.w,v.pos.w);}
  if (gone) {v.pos=v4(0.0f32,0.0f32,2.0f32,1.0f32);}
  return v;
}
// The same vertex in the shadow map's space. Leaves and lamps' glows cast none: a tree's shadow
// is its hearts' and its wood's.
pr_shadow_stand :: (id:u32,instance:u32,u:[]f32,b:int,mesh:[]f32,objects:[]PrObj)->PrShade {
  m:PrObj=objects[cast(int)instance];
  o:int=cast(int)id*12;
  w:V3=pr_placed_in(v3(mesh[o],mesh[o+1],mesh[o+2]),m,u[b+PR_UP+3],wg_at4(u,b+PR_WIND));
  if (m.b.w<0.5f32) {w=pr_posed(w,u,b);}
  w=pr_kept(w,m,u,b);
  s:PrShade;
  s.pos=pr_light_clip(w,u,b);
  if (m.b.y>4.5f32||mesh[o+7]<=0.0f32-PR_FOLD_MARK) {s.pos=v4(0.0f32,0.0f32,2.0f32,1.0f32);}
  return s;
}
pr_light_clip :: (w:V3,u:[]f32,b:int)->V4 {
  p:V4=v4(w.x,w.y,w.z,1.0f32);
  o:int=b+PR_LIGHT;
  return v4(dot4(wg_at4(u,o),p),dot4(wg_at4(u,o+4),p),dot4(wg_at4(u,o+8),p),dot4(wg_at4(u,o+12),p));
}

// ---- the sun's shadow
// The map's reach in the world (m): half its side.
pr_shadow_reach :: (u:[]f32,b:int)->f32 {
  o:int=b+PR_LIGHT;
  return 1.0f32/fmax(sqrt(u[o]*u[o]+u[o+1]*u[o+1]+u[o+2]*u[o+2]),0.000001f32);
}
// How far toward the map's edge the world point p lies: under 0.9 well inside it, 1 and over
// outside (where pr_shadow answers `outside`). A realm asks this before it works out a costly
// `outside`.
pr_shadow_edge :: (p:V3,u:[]f32,b:int)->f32 {
  q:V4=pr_light_clip(p,u,b);
  if (q.z<0.0f32||q.z>1.0f32) {return 2.0f32;}
  return fmax(abs(q.x),abs(q.y));
}
// How much of the sun reaches the world point p on a surface facing n: 1 lit to 0 shadowed, from
// the shadow map, its edge softened over a few taps (four on the reduced tier). A point outside
// the map answers `outside`: what the realm knows of it some other way, or 1.
pr_shadow :: (p:V3,n:V3,outside:f32,u:[]f32,b:int,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->f32 {
  size:f32=cast(f32)gpu_depth_width(shadow_map);
  // a texel's width in the world, from the map's first row (its length is 1 / the map's reach)
  o:int=b+PR_LIGHT;
  reach:f32=1.0f32/fmax(sqrt(u[o]*u[o]+u[o+1]*u[o+1]+u[o+2]*u[o+2]),0.000001f32);
  texel:f32=2.0f32*reach/size;
  q:V4=pr_light_clip(add3(p,scale3(n,texel*1.6f32+0.02f32)),u,b);
  edge:f32=fmax(abs(q.x),abs(q.y));
  if (edge>0.995f32||q.z<0.0f32||q.z>1.0f32) {return outside;}
  uv:V2=v2(q.x*0.5f32+0.5f32,0.5f32-q.y*0.5f32);
  taps:int=ifx u[b+PR_GROUND+3]>0.5f32 then 4 else 9;
  lit:f32=0.0f32;
  for i:0..<9 {
    if (i<taps) {
      a:f32=cast(f32)i*2.399963f32+p.x*3.1f32+p.z*1.7f32; d:f32=sqrt((cast(f32)i+0.5f32)/cast(f32)taps)*1.6f32/size;
      lit=lit+gpu_compare(shadow_map,shadow_cmp,v2(uv.x+cos(a)*d,uv.y+sin(a)*d),q.z-0.00004f32);
    }
  }
  lit=lit/cast(f32)taps;
  // toward the map's edge the answer runs into the outside's, so no line shows where the map ends
  return mix(lit,outside,smoothstep(0.9f32,0.995f32,edge));
}

// ---- the ground's sky field
// How much of the sky the platform's point q sees (1 open, toward 0 between tall things), from
// the field the realm laid over its ground (photoreal-frame.coax pr_field_build). The field holds
// the answer at the ground and on each roof; above them it fades out.
pr_field :: (q:V3,n:V3,u:[]f32,b:int,field:[]f32)->f32 {
  nx:int=cast(int)u[b+PR_FIELD_N]; nz:int=cast(int)u[b+PR_FIELD_N+1];
  if (nx<2||nz<2) {return 1.0f32;}
  cell:f32=u[b+PR_FIELD+2];
  // a wall takes the answer of the open ground just outside it
  x:f32=(q.x+n.x*cell*0.75f32-u[b+PR_FIELD])/cell-0.5f32; z:f32=(q.z+n.z*cell*0.75f32-u[b+PR_FIELD+1])/cell-0.5f32;
  i:int=cast(int)wg_clamp_i(cast(s32)floor(x),0,cast(s32)(nx-2)); j:int=cast(int)wg_clamp_i(cast(s32)floor(z),0,cast(s32)(nz-2));
  tx:f32=saturate(x-cast(f32)i); tz:f32=saturate(z-cast(f32)j);
  a:V2=v2(field[(j*nx+i)*2],field[(j*nx+i)*2+1]); c:V2=v2(field[(j*nx+i+1)*2],field[(j*nx+i+1)*2+1]);
  d:V2=v2(field[((j+1)*nx+i)*2],field[((j+1)*nx+i)*2+1]); e:V2=v2(field[((j+1)*nx+i+1)*2],field[((j+1)*nx+i+1)*2+1]);
  open:f32=mix(mix(a.x,c.x,tx),mix(d.x,e.x,tx),tz);
  top:f32=mix(mix(a.y,c.y,tx),mix(d.y,e.y,tx),tz);
  // how far over the field's own surface there (the ground, or a roof)
  over:f32=fmax(q.y-(u[b+PR_FIELD+3]+top),0.0f32);
  return mix(open,1.0f32,saturate(over/fmax(u[b+PR_FIELD_N+2],1.0f32)));
}

// ---- the sky's light
// The sky's light on a surface facing n (its irradiance over pi, so albedo times this is what the
// surface sends back): nine numbers the frame's writer made from the whole sky and the ground
// under it.
pr_sky_light :: (n:V3,u:[]f32,b:int)->V3 {
  o:int=b+PR_SH;
  c:V3=pr_at3(u,o);
  c=add3(c,add3(scale3(pr_at3(u,o+4),n.y),add3(scale3(pr_at3(u,o+8),n.z),scale3(pr_at3(u,o+12),n.x))));
  c=add3(c,add3(scale3(pr_at3(u,o+16),n.x*n.y),add3(scale3(pr_at3(u,o+20),n.y*n.z),scale3(pr_at3(u,o+24),3.0f32*n.z*n.z-1.0f32))));
  c=add3(c,add3(scale3(pr_at3(u,o+28),n.x*n.z),scale3(pr_at3(u,o+32),n.x*n.x-n.y*n.y)));
  return v3(fmax(c.x,0.0f32),fmax(c.y,0.0f32),fmax(c.z,0.0f32));
}
// ---- the air's light, with haze
// The engine's atmosphere (atmosphere.coax) is a clear day's air. A frame may carry more haze
// (PR_AIR_HAZE: the extra a unit of air takes out of green light; sea air on a still evening is
// about 0.15). Haze takes a little more out of blue than out of red, so a low sun turns gold and
// dimmer; and it scatters the light it takes nearly white and mostly forward, so the sky pales,
// most along the horizon and round the sun. With no haze these are atmo_sky, atmo_far and
// atmo_sunlight exactly.
pr_haze_loss :: (hz:f32)->V3 {return scale3(v3(0.87f32,1.0f32,1.3f32),fmax(hz,0.0f32));}
// What haze leaves of the sun's light after its air: multiply atmo_sunlight (or atmo_sun) by it.
pr_haze_through :: (sun_up:f32,hz:f32)->V3 {return atmo_exp3(scale3(pr_haze_loss(hz),0.0f32-atmo_sun_mass(sun_up)));}
pr_air_light :: (rd:V3,sun:V3,hz:f32)->V3 {
  up:f32=saturate(rd.y);
  cos_t:f32=dot3(rd,sun);
  day:f32=atmo_day(sun.y);
  extra:V3=pr_haze_loss(hz);
  clear:V3=v3(ATMO_AIR_R+ATMO_HAZE,ATMO_AIR_G+ATMO_HAZE,ATMO_AIR_B+ATMO_HAZE);
  all:V3=add3(clear,extra);
  reach:V3=atmo_exp3(scale3(all,0.0f32-atmo_sun_mass(sun.y)*mix(1.0f32,0.3f32,sqrt(up))));
  mass:f32=atmo_mass(up);
  took:V3=v3(1.0f32-exp(0.0f32-all.x*mass),1.0f32-exp(0.0f32-all.y*mass),1.0f32-exp(0.0f32-all.z*mass));
  air:V3=scale3(v3(ATMO_AIR_R/all.x,ATMO_AIR_G/all.y,ATMO_AIR_B/all.z),atmo_even(cos_t));
  forward:f32=atmo_forward(cos_t);
  glow:f32=ATMO_GLOW*(forward+2.8f32*exp(0.0f32-fmax(1.0f32-cos_t,0.0f32)*2.2f32)*exp(0.0f32-up*7.0f32));
  // the extra haze's own share of what the air scatters: nearly white, part of it every way
  // (light it has scattered more than once) and part forward
  hazy:V3=scale3(v3(extra.x/all.x,extra.y/all.y,extra.z/all.z),0.9f32*(0.4f32+0.6f32*forward));
  first:f32=mix(smoothstep(0.0f32-0.14f32,0.02f32,sun.y),1.0f32,exp(0.0f32-up*6.0f32));
  once:V3=scale3(mul3(mul3(reach,took),add3(add3(air,v3(glow,glow,glow)),hazy)),first);
  low:f32=1.0f32-saturate(sun.y*5.0f32+0.15f32);
  // (the blue the clear air scatters again is its share of the air)
  again:V3=scale3(mul3(mul3(v3(0.03f32,0.07f32,0.21f32),took),v3(clear.x/all.x,clear.y/all.y,clear.z/all.z)),mix(1.0f32,2.6f32*mix(0.12f32,1.0f32,smoothstep(0.0f32,0.45f32,up)),low));
  return scale3(add3(once,again),ATMO_SUN*day);
}
// What distance fades to along rd: the air's light along it laid flat on the horizon.
pr_air_far :: (rd:V3,sun:V3,hz:f32)->V3 {
  l:f32=sqrt(rd.x*rd.x+rd.z*rd.z);
  if (l<0.0001f32) {return pr_air_light(v3(0.0f32,0.0f32,0.0f32-1.0f32),sun,hz);}
  return pr_air_light(v3(rd.x/l,0.0f32,rd.z/l),sun,hz);
}
// The faint light of a night sky, so a night is dark blue and never black.
pr_night :: (day:f32)->V3 {return scale3(v3(0.0035f32,0.0052f32,0.0105f32),1.0f32-day);}
// How much of the sun thick cloud takes (photoreal-frame.coax pr_overcast: none to a cover of
// 0.45, all the share by 0.9), and a sky's or the air's light under that cloud: grey by that
// share, and as much of it left as the frame says comes through (PR_SKY_SHARE).
pr_cloud_shade :: (u:[]f32,b:int)->f32 {return smoothstep(0.45f32,0.9f32,u[b+PR_HAZE+3]);}
pr_under_cloud :: (c:V3,u:[]f32,b:int)->V3 {
  l:f32=c.x*0.2126f32+c.y*0.7152f32+c.z*0.0722f32;
  return scale3(mix3(c,v3(l,l,l),pr_cloud_shade(u,b)),u[b+PR_SKY_SHARE]);
}
// The sky along the unit ray rd, without its sun or clouds; under the horizon, the light the
// ground and sea send up (what a mirror tilted down shows).
pr_sky :: (rd:V3,u:[]f32,b:int)->V3 {
  sun:V3=pr_at3(u,b+PR_SUN);
  above:V3=add3(pr_under_cloud(pr_air_light(v3(rd.x,fmax(rd.y,0.0f32),rd.z),sun,u[b+PR_AIR_HAZE]),u,b),pr_night(u[b+PR_SUN+3]));
  if (rd.y>=0.0f32) {return above;}
  // the horizon's own light gives way to the ground's over a few degrees
  return mix3(above,pr_at3(u,b+PR_GROUND),saturate((0.0f32-rd.y)*9.0f32));
}
// ---- the moon and the stars
// The moon's disc along rd: x is how much of the pixel it covers, y how bright that part of its
// face is (0 dark to 1 full in the sun). `moon` and `sun` are the ways to each: the face is a ball
// lit from the sun's side, so its phase is right for where the two stand. `soft` is a pixel's
// width in radians.
PR_MOON_RADIUS :: 0.0046f32;   // radians: a quarter of a degree, the moon's own
pr_moon_face :: (rd:V3,moon:V3,sun:V3,soft:f32)->V2 {
  if (dot3(rd,moon)<0.99f32) {return v2(0.0f32,0.0f32);}
  // the disc's own two ways across the sky
  ax:V3=cross3(v3(0.0f32,1.0f32,0.0f32),moon);
  if (dot3(ax,ax)<0.000001f32) {ax=v3(1.0f32,0.0f32,0.0f32);}
  ax=normalize3(ax); ay:V3=cross3(moon,ax);
  px:f32=dot3(rd,ax)/PR_MOON_RADIUS; py:f32=dot3(rd,ay)/PR_MOON_RADIUS;
  r2:f32=px*px+py*py;
  edge:f32=fmax(soft,0.00002f32)/PR_MOON_RADIUS;
  cover:f32=1.0f32-smoothstep(1.0f32-edge,1.0f32+edge,sqrt(r2));
  if (cover<=0.0f32) {return v2(0.0f32,0.0f32);}
  // the ball's surface there, facing back along the way to the moon
  nz:f32=sqrt(fmax(1.0f32-r2,0.0f32));
  nb:V3=sub3(add3(scale3(ax,px),scale3(ay,py)),scale3(moon,nz));
  // dusty ground sends light back nearly evenly over its lit side (no dark limb), and has seas
  lit:f32=saturate(dot3(nb,sun)*4.0f32+0.08f32);
  seas:f32=0.72f32+0.28f32*pr_noise2(px*2.3f32+5.0f32,py*2.3f32-3.0f32);
  return v2(cover,lit*seas);
}
// The stars along rd (over the horizon): points of their own colours and brightnesses, a few
// bright and many faint, dimmer low in the air, in whites.
pr_stars :: (rd:V3)->V3 {
  if (rd.y<=0.02f32) {return v3(0.0f32,0.0f32,0.0f32);}
  k:f32=260.0f32/(rd.y+0.42f32);
  gx:f32=rd.x*k; gz:f32=rd.z*k;
  cx:f32=floor(gx); cz:f32=floor(gz);
  h:f32=render_noise2(cx,cz);
  if (h<0.955f32) {return v3(0.0f32,0.0f32,0.0f32);}
  ox:f32=0.25f32+0.5f32*render_noise2(cx+17.0f32,cz); oz:f32=0.25f32+0.5f32*render_noise2(cx,cz+31.0f32);
  d2:f32=(gx-cx-ox)*(gx-cx-ox)+(gz-cz-oz)*(gz-cz-oz);
  bright:f32=(h-0.955f32)/0.045f32;
  point:f32=saturate(1.0f32-d2/0.05f32);
  warm:f32=render_noise2(cx-9.0f32,cz+5.0f32);
  col:V3=mix3(v3(0.7f32,0.8f32,1.0f32),v3(1.0f32,0.86f32,0.7f32),warm);
  return scale3(col,point*point*(0.006f32+0.09f32*bright*bright*bright)*saturate(rd.y*5.0f32));
}
// The moon and stars over the sky `sky` along rd, as far as the day and `hide` (cloud, 0 to 1) let them show.
pr_night_sky :: (sky:V3,rd:V3,soft:f32,hide:f32,u:[]f32,b:int)->V3 {
  night:f32=1.0f32-u[b+PR_SUN+3];
  show:f32=1.0f32-hide;
  stars:V3=v3(0.0f32,0.0f32,0.0f32);
  if (night>0.25f32) {stars=scale3(pr_stars(rd),(night-0.25f32)*1.3333f32*show);}
  c:V3=sky;
  if (u[b+PR_MOON+3]>0.5f32) {
    face:V2=pr_moon_face(rd,pr_at3(u,b+PR_MOON),pr_at3(u,b+PR_SUN),soft);
    // its lit face is a tenth as bright as a white wall in the sun; its dark side shows the
    // earth's light, and hides the stars behind it. The air in front of it keeps its own light.
    stars=scale3(stars,1.0f32-face.x);
    c=add3(c,scale3(v3(0.1f32,0.097f32,0.09f32),face.x*show*(face.y+0.004f32)));
  }
  return add3(c,stars);
}
// The sky a realm draws behind its world: the air, the sun's disc and glare, cloud, and at night
// the moon and stars. `soft` is a pixel's width in radians (the disc's edge).
pr_dome :: (rd:V3,soft:f32,u:[]f32,b:int)->V3 {
  sun:V3=pr_at3(u,b+PR_SUN);
  night:V3=pr_night(u[b+PR_SUN+3]);
  hz:f32=u[b+PR_AIR_HAZE];
  if (rd.y<0.0f32) {return add3(pr_under_cloud(pr_air_light(v3(rd.x,0.0f32,rd.z),sun,hz),u,b),night);}
  sky:V3=pr_under_cloud(pr_air_light(rd,sun,hz),u,b);
  dim:V3=scale3(pr_haze_through(sun.y,hz),1.0f32-0.85f32*pr_cloud_shade(u,b));
  disc:V3=mul3(atmo_sun(rd,sun,0.0048f32,soft),dim);
  if (u[b+PR_GROUND+3]>0.5f32) {return pr_night_sky(add3(add3(sky,disc),night),rd,soft,0.0f32,u,b);}
  // (atmo_dome, with the frame's haze between the sun and its clouds)
  c:AtmoCloud=atmo_clouds(rd,sun,sky,u[b+PR_HAZE+3],1.0f32,u[b+PR_UP+3]*0.004f32);
  return add3(add3(scale3(pr_night_sky(add3(sky,disc),rd,soft,c.hide,u,b),1.0f32-c.hide),pr_under_cloud(mul3(c.light,mix3(v3(1.0f32,1.0f32,1.0f32),dim,0.75f32)),u,b)),night);
}

// ---- the air
// The share of a point's light that reaches the eye through `dist` metres of air, looking along rd
// from an eye `eye_y` up: the air is thick at sea level and thins with height.
pr_air_through :: (dist:f32,eye_y:f32,rd_y:f32,u:[]f32,b:int)->f32 {
  h:f32=fmax(u[b+PR_HAZE+1],1.0f32);
  y0:f32=fmax(eye_y-u[b+PR_HAZE+2],0.0f32);
  // the air along the ray: the integral of exp(-y / h) from the eye to the point
  k:f32=rd_y*dist/h;
  along:f32=ifx abs(k)<0.001f32 then dist else dist*(1.0f32-exp(0.0f32-k))/k;
  return exp(0.0f32-u[b+PR_HAZE]*exp(0.0f32-y0/h)*along);
}
// A point's light after the air between it and the eye: some of it lost, and the air's own light
// (the sky along the same way, laid flat) in its place.
pr_air :: (c:V3,w:V3,u:[]f32,b:int)->V3 {
  to:V3=sub3(w,pr_at3(u,b+PR_EYE));
  d:f32=length3(to);
  rd:V3=scale3(to,1.0f32/fmax(d,0.0001f32));
  t:f32=pr_air_through(d,u[b+PR_EYE+1],rd.y,u,b);
  return add3(scale3(c,t),scale3(add3(pr_under_cloud(pr_air_far(rd,pr_at3(u,b+PR_SUN),u[b+PR_AIR_HAZE]),u,b),pr_night(u[b+PR_SUN+3])),1.0f32-t));
}

// ---- materials
// A point's two coordinates across a flat face of its part, in metres: across and up a wall, x
// and z on a floor or roof.
pr_face :: (local:V3,facing:V3)->V2 {
  if (abs(facing.y)>0.7f32) {return v2(local.x,local.z);}
  if (abs(facing.x)>abs(facing.z)) {return v2(local.z,local.y);}
  return v2(local.x,local.y);
}
// Value noise in two and three dimensions on the engine's lattice hash, 0 to 1, and three octaves of it.
pr_noise2 :: (x:f32,y:f32)->f32 {
  ix:f32=floor(x); iy:f32=floor(y); fx:f32=x-ix; fy:f32=y-iy;
  ux:f32=fx*fx*(3.0f32-2.0f32*fx); uy:f32=fy*fy*(3.0f32-2.0f32*fy);
  return mix(mix(render_noise2(ix,iy),render_noise2(ix+1.0f32,iy),ux),mix(render_noise2(ix,iy+1.0f32),render_noise2(ix+1.0f32,iy+1.0f32),ux),uy);
}
pr_cloud2 :: (x:f32,y:f32)->f32 {return pr_noise2(x,y)*0.57f32+pr_noise2(x*2.03f32+11.0f32,y*2.03f32-7.0f32)*0.29f32+pr_noise2(x*4.01f32-3.0f32,y*4.01f32+19.0f32)*0.14f32;}
// A line `wide` metres across on a grid of `every` metres, 1 on the line, its edge a pixel soft.
// `aa` is a pixel's width in x's own units: gpu_fwidth(x), taken by the caller before it branches
// (a browser refuses a derivative taken inside a branch on a varying).
pr_line :: (x:f32,every:f32,wide:f32,aa0:f32)->f32 {
  d:f32=abs(fract(x/every+0.5f32)-0.5f32)*every;
  aa:f32=fmax(aa0,0.0001f32);
  sharp:f32=1.0f32-smoothstep(wide*0.5f32-aa,wide*0.5f32+aa,d);
  // a grid finer than the pixels fades to its average, so far walls don't shimmer
  return mix(saturate(wide/every),sharp,saturate(every/(aa*2.5f32)-0.5f32));
}
// A normal tilted by a slope across the face (dx, dy: rise over run along the face's two ways).
pr_tilt :: (n:V3,facing:V3,dx:f32,dy:f32)->V3 {
  // the face's own two directions in the part: across and up a wall, x and z on a floor
  t:V3=v3(1.0f32,0.0f32,0.0f32); s:V3=v3(0.0f32,0.0f32,1.0f32);
  if (abs(facing.y)<=0.7f32) {
    s=v3(0.0f32,1.0f32,0.0f32);
    if (abs(facing.x)>abs(facing.z)) {t=v3(0.0f32,0.0f32,1.0f32);}
  }
  return normalize3(sub3(n,add3(scale3(t,dx),scale3(s,dy))));
}
// A material's surface at a vertex's point. `detail` is 0 on the reduced tier, where the fine
// normal detail is left out.
pr_surface :: (v:PrV,u:[]f32,b:int,materials:[]f32)->PrSurface {
  row:int=cast(int)wg_clamp_i(cast(s32)(v.info.x+0.5f32),0,PR_MATERIALS-1)*PR_MATERIAL_FLOATS;
  s:PrSurface;
  s.albedo=mul3(pr_decode(v3(materials[row],materials[row+1],materials[row+2])),v.tint);
  s.rough=materials[row+PR_M_ROUGH];
  s.metal=materials[row+PR_M_METAL];
  s.normal=normalize3(v.normal);
  s.glow=scale3(s.albedo,materials[row+PR_M_GLOW]);
  s.through=0.0f32;
  pattern:int=cast(int)(materials[row+PR_M_PATTERN]+0.5f32);
  scale:f32=materials[row+PR_M_SCALE];
  full:bool=u[b+PR_GROUND+3]<0.5f32;
  fl:V3=v.facing;
  f:V2=pr_face(v.local,fl);
  // a pixel's width across the face, taken here, before any branch
  ax:f32=gpu_fwidth(f.x); ay:f32=gpu_fwidth(f.y);
  // and how fast the facing turns (a column's flutes)
  da:f32=gpu_fwidth(fl.x)+gpu_fwidth(fl.z);
  // each instance its own corner of the noise
  seed:f32=v.info.z*7.31f32;
  if (pattern==PR_PATTERN_CONCRETE) {
    // pours of slightly different greys, water marks, and a fine grain
    cloud:f32=pr_cloud2(f.x*0.045f32+seed,f.y*0.045f32-seed);
    grain:f32=pr_noise2(f.x*9.0f32,f.y*9.0f32+seed);
    s.albedo=scale3(s.albedo,0.86f32+0.2f32*cloud+0.06f32*(grain-0.5f32));
    s.rough=saturate(s.rough+0.12f32*(cloud-0.5f32));
  } else if (pattern==PR_PATTERN_GLASS) {
    s=pr_glazing(s,f,ax,ay,fl,seed,scale,0,full,u,b);
  } else if (pattern==PR_PATTERN_RIBBON) {
    s=pr_glazing(s,f,ax,ay,fl,seed,scale,1,full,u,b);
  } else if (pattern==PR_PATTERN_FINS) {
    s=pr_glazing(s,f,ax,ay,fl,seed,scale,2,full,u,b);
  } else if (pattern==PR_PATTERN_POURED) {
    s=pr_poured(s,f,ax,ay,v.world,fl,seed,scale,u,b,materials,row+PR_M_MORE);
  } else if (pattern==PR_PATTERN_PAINTED) {
    s=pr_painted(s,f,ax,ay,v.local,fl,seed,scale);
  } else if (pattern==PR_PATTERN_PAVING) {
    s=pr_paving(s,f,ax,ay,fl,seed,scale,full);
  } else if (pattern==PR_PATTERN_ASPHALT) {
    grit:f32=pr_noise2(f.x*14.0f32,f.y*14.0f32);
    worn:f32=pr_cloud2(f.x*0.06f32,f.y*0.06f32);
    s.albedo=scale3(s.albedo,0.8f32+0.25f32*worn+0.12f32*(grit-0.5f32));
  } else if (pattern==PR_PATTERN_LEAVES) {
    // a crown: darker inside and under, lighter at its sunward tufts
    // (on the part's own frame, so the pattern rides a bending tree)
    tuft:f32=pr_noise2(v.local.x*1.3f32+seed,v.local.z*1.3f32-v.local.y*0.9f32);
    fine:f32=ifx full then pr_noise2(v.local.x*7.0f32-v.local.y*3.0f32+seed,v.local.z*7.0f32+v.local.y*5.0f32) else 0.5f32;
    s.albedo=scale3(s.albedo,(0.62f32+0.7f32*tuft)*(0.8f32+0.4f32*fine));
    s.through=0.35f32;
  } else if (pattern==PR_PATTERN_WATER) {
    if (fl.y>0.7f32) {
      // still water over a floor `scale` metres down (water-optics.coax): the wind's ripples on
      // its face, and under it the floor's colour after the water's own, with the sun's net on it
      t:f32=u[b+PR_UP+3];
      wind:V4=wg_at4(u,b+PR_WIND);
      depth:f32=ifx scale>0.0f32 then scale else 1.2f32;
      amp:f32=fmin(0.02f32+0.011f32*wind.z,0.16f32);
      run:f32=t*(0.12f32+0.03f32*wind.z);
      qx:f32=f.x-wind.x*run; qz:f32=f.y-wind.y*run;
      rx:f32=(pr_noise2(qx*1.7f32+seed,qz*1.7f32)-0.5f32)+0.5f32*(pr_noise2(qx*5.1f32-t*0.4f32,qz*5.1f32+seed)-0.5f32);
      rz:f32=(pr_noise2(qx*1.7f32+19.0f32,qz*1.7f32-seed)-0.5f32)+0.5f32*(pr_noise2(qx*5.1f32+7.0f32,qz*5.1f32+t*0.37f32)-0.5f32);
      s.normal=normalize3(add3(s.normal,v3(rx*amp,0.0f32,rz*amp)));
      toward:V3=normalize3(sub3(pr_at3(u,b+PR_EYE),v.world));
      ci:f32=fmax(dot3(s.normal,toward),0.03f32);
      // down to the floor along the sun's way in the water and back up along the eye's
      sun_in:f32=wo_cos_refracted(fmax(u[b+PR_SUN+1],0.05f32));
      body:V3=wo_through(v3(0.42f32,0.075f32,0.035f32),depth/wo_cos_refracted(ci)+depth/sun_in);
      net:f32=ifx full then 1.0f32+0.5f32*(wo_caustic(v2(f.x*1.4f32,f.y*1.4f32),t)-0.18f32)*u[b+PR_SUN+3] else 1.0f32;
      s.albedo=scale3(mul3(s.albedo,body),WO_LEAVING*1.6f32*net);
      s.rough=0.04f32; s.metal=0.0f32;
    }
  } else if (pattern==PR_PATTERN_GRAVEL) {
    grit:f32=pr_noise2(f.x*23.0f32+seed,f.y*23.0f32);
    stone:f32=pr_noise2(f.x*61.0f32,f.y*61.0f32-seed);
    rake:f32=pr_cloud2(f.x*0.35f32,f.y*0.35f32);
    s.albedo=scale3(s.albedo,(0.78f32+0.26f32*grit+0.2f32*(stone-0.5f32))*(0.9f32+0.2f32*rake));
    if (full) {s.normal=normalize3(add3(s.normal,v3((grit-0.5f32)*0.3f32,0.0f32,(stone-0.5f32)*0.3f32)));}
  } else if (pattern==PR_PATTERN_BLOOM) {
    // ground cover in the material's own colour, and flowers in the record's tint where a
    // plant stands in bloom: more of them toward a bed's middle clumps
    row_c:V3=pr_decode(v3(materials[row],materials[row+1],materials[row+2]));
    tuft:f32=pr_noise2(v.local.x*2.1f32+seed,v.local.z*2.1f32-v.local.y);
    clump:f32=pr_cloud2(v.local.x*0.35f32-seed,v.local.z*0.35f32+seed);
    cellx:f32=floor(v.local.x*6.0f32+v.local.y*2.0f32); cellz:f32=floor(v.local.z*6.0f32-v.local.y*2.0f32);
    flower:f32=stepf(1.0f32-0.5f32*smoothstep(0.35f32,0.7f32,clump),render_noise2(cellx+seed*31.0f32,cellz));
    s.albedo=mix3(scale3(row_c,0.6f32+0.7f32*tuft),scale3(v.tint,0.75f32+0.4f32*render_noise2(cellz,cellx)),flower);
    s.rough=0.9f32; s.through=0.25f32;
  } else if (pattern==PR_PATTERN_STONE) {
    s=pr_stone(s,f,ax,ay,da,v.local,fl,seed,scale,full,materials,row+PR_M_MORE);
  } else if (pattern==PR_PATTERN_PANELS) {
    rib:f32=ifx scale>0.0f32 then scale else 0.3f32;
    // ribs run up a wall and down a roof's slope: their shade is in the normal
    phase:f32=fract(f.x/rib);
    slope:f32=ifx phase<0.2f32 then 0.5f32 else (ifx (phase>0.5f32&&phase<0.7f32) then 0.0f32-0.5f32 else 0.0f32);
    if (full) {s.normal=pr_tilt(s.normal,fl,slope*saturate(rib/(fmax(ax,0.0001f32)*4.0f32)-0.5f32),0.0f32);}
    sheet:f32=render_noise2(floor(f.x/(rib*10.0f32))+seed,floor(f.y/6.0f32));
    s.albedo=scale3(s.albedo,0.9f32+0.14f32*sheet+0.08f32*pr_cloud2(f.x*0.2f32,f.y*0.05f32));
  } else if (pattern==PR_PATTERN_LAWN) {
    mow:f32=pr_cloud2(v.world.x*0.11f32,v.world.z*0.11f32);
    blade:f32=pr_noise2(v.world.x*6.0f32,v.world.z*6.0f32);
    s.albedo=scale3(s.albedo,0.75f32+0.4f32*mow+0.2f32*(blade-0.5f32));
  }
  return s;
}

// ---- light on a surface
// What a surface facing n mirrors when seen along `toward` (the unit way to the eye): the sky
// along the mirrored ray, blurred toward the sky's light on the mirror's own facing as the surface
// roughens. A realm with more to mirror (its own buildings, traced) mixes that in over this.
pr_environment :: (n:V3,toward:V3,rough:f32,u:[]f32,b:int)->V3 {
  r:V3=reflect3(scale3(toward,0.0f32-1.0f32),n);
  // a rough surface's lobe leans toward the normal
  r=normalize3(mix3(r,n,rough*rough));
  sharp:V3=pr_sky(r,u,b);
  return mix3(sharp,pr_sky_light(r,u,b),saturate(rough*1.25f32));
}
// A surface under the sun and the sky. `sun_reach` is how much of the sun reaches it (pr_shadow),
// `open` how much of the sky it sees (pr_field, a crease's shade), `mirrored` what it mirrors
// (pr_environment). Energy is kept: what the surface mirrors it does not also scatter.
pr_lit :: (s:PrSurface,toward:V3,sun_reach:f32,open:f32,mirrored:V3,u:[]f32,b:int)->V3 {
  n:V3=s.normal;
  sun:V3=pr_at3(u,b+PR_SUN);
  light:V3=scale3(pr_at3(u,b+PR_SUN_LIGHT),sun_reach);
  f0:V3=cm_f0(s.albedo,s.metal);
  rough:f32=clampf(s.rough,0.03f32,1.0f32);
  nv:f32=fmax(dot3(n,toward),0.0001f32);
  ndl:f32=dot3(n,sun);
  // a thin thing passes some of the sun that strikes its far side
  wrap:f32=fmax(ndl,0.0f32)+s.through*fmax(0.0f32-ndl,0.0f32)*0.6f32+s.through*0.15f32;
  env:PbrEnvironment=pbr_environment(rough,nv);
  spec_share:V3=v3(saturate(f0.x*env.a+env.b),saturate(f0.y*env.a+env.b),saturate(f0.z*env.a+env.b));
  kept:V3=scale3(v3(1.0f32-spec_share.x,1.0f32-spec_share.y,1.0f32-spec_share.z),1.0f32-s.metal);
  diffuse:V3=mul3(mul3(s.albedo,kept),add3(scale3(light,wrap),scale3(pr_sky_light(n,u,b),open)));
  glint:V3=mul3(cm_ggx(f0,rough,n,sun,toward),light);
  // a crease hides the sky from a mirror too, the more the rougher it is
  seen:f32=mix(1.0f32,open,saturate(0.3f32+rough));
  return add3(add3(diffuse,glint),add3(scale3(mul3(mirrored,spec_share),seen),s.glow));
}

// ---- contact: the screen's ambient occlusion and short contact shadows (a post pass)
// A realm whose shader module has post_fs (coax/web/host.js, the post pass) draws its frame into
// two targets: `light`, the display's colour as pr_out gives it, and `aux`, what the post pass
// needs to know of the surface there: its normal and how much of its light came from the sun
// (pr_sun_share), or a negative share where nothing should be shaded (the sky, the sea, a traced
// view). pr_post then darkens each pixel by what stands round it in the depth buffer: the sky's
// share by how much of the sky the nearby geometry hides, the sun's share by a short march toward
// the sun. Its reach grows with distance, so a tower's foot sits on the deck from the opening
// camera and a bench's from walking height. The reduced tier takes six taps and no march.
PrLit :: struct {light:V4; aux:V4;}
PR_POST_NONE :: -1.0f32;   // aux's fourth: this pixel takes no contact shade
pr_lit_out :: (c:V3,n:V3,share:f32)->PrLit {return PrLit.{light=v4(c.x,c.y,c.z,0.0f32),aux=v4(n.x,n.y,n.z,share)};}
pr_lit_plain :: (c:V4)->PrLit {return PrLit.{light=c,aux=v4(0.0f32,1.0f32,0.0f32,PR_POST_NONE)};}
// The share of a surface's light that is the sun's (0 to 1), by the same terms pr_lit adds.
pr_sun_share :: (n:V3,sun_reach:f32,open:f32,u:[]f32,b:int)->f32 {
  sl:V3=pr_at3(u,b+PR_SUN_LIGHT);
  direct:f32=pr_lum(sl)*sun_reach*fmax(dot3(n,pr_at3(u,b+PR_SUN)),0.0f32);
  sky:f32=pr_lum(pr_sky_light(n,u,b))*open;
  return saturate(direct/fmax(direct+sky,0.000001f32));
}
// The world point behind pixel (x, y) of a w by h target whose depth buffer holds `depth`.
pr_post_z :: (depth:f32,u:[]f32,b:int)->f32 {return u[b+PR_FORWARD+3]/fmax(1.0f32-depth,0.0000001f32);}
pr_post_at :: (x:f32,y:f32,z:f32,w:f32,h:f32,u:[]f32,b:int)->V3 {
  t:f32=u[b+PR_EYE+3];
  nx:f32=(x/w)*2.0f32-1.0f32; ny:f32=1.0f32-(y/h)*2.0f32;
  ray:V3=add3(pr_at3(u,b+PR_FORWARD),add3(scale3(pr_at3(u,b+PR_RIGHT),nx*t*u[b+PR_RIGHT+3]),scale3(pr_at3(u,b+PR_UP),ny*t)));
  return add3(pr_at3(u,b+PR_EYE),scale3(ray,z));
}
// How much light stays at pixel (x, y): 1 untouched, less where it is hidden (pr_post's factor).
pr_contact :: (x:s32,y:s32,n:V3,share:f32,u:[]f32,b:int,depth:TexDepth)->f32 {
  wi:s32=cast(s32)gpu_depth_width(depth); hi:s32=cast(s32)gpu_depth_height(depth);
  w:f32=cast(f32)wi; h:f32=cast(f32)hi;
  d0:f32=gpu_load_depth(depth,x,y,0);
  if (d0>=0.99999f32) {return 1.0f32;}
  z:f32=pr_post_z(d0,u,b);
  fx:f32=cast(f32)x+0.5f32; fy:f32=cast(f32)y+0.5f32;
  p:V3=pr_post_at(fx,fy,z,w,h,u,b);
  reduced:bool=u[b+PR_GROUND+3]>0.5f32;
  t:f32=u[b+PR_EYE+3];
  focal:f32=h/(2.0f32*t);   // pixels a metre spans one metre along the view
  // a fixed dither by pixel (interleaved gradient noise) turns the few taps into fine grain
  noise:f32=fract(52.982919f32*fract(0.06711056f32*fx+0.00583715f32*fy));
  // ambient occlusion: taps in a disc whose width grows with distance
  reach:f32=clampf(z*0.012f32,0.8f32,24.0f32);
  rpx:f32=fmin(reach*focal/z,90.0f32);
  taps:int=ifx reduced then 6 else 12;
  occ:f32=0.0f32;
  if (rpx>1.5f32) {
    for i:0..<12 {
      if (i<taps) {
        a:f32=(cast(f32)i+noise)*2.399963f32;
        r:f32=sqrt((cast(f32)i+noise)/cast(f32)taps)*rpx+1.0f32;
        qx:s32=cast(s32)clampf(fx+cos(a)*r,0.0f32,w-1.0f32); qy:s32=cast(s32)clampf(fy+sin(a)*r,0.0f32,h-1.0f32);
        dq:f32=gpu_load_depth(depth,qx,qy,0);
        if (dq<0.99999f32) {
          s:V3=pr_post_at(cast(f32)qx+0.5f32,cast(f32)qy+0.5f32,pr_post_z(dq,u,b),w,h,u,b);
          v:V3=sub3(s,p); l:f32=length3(v);
          occ=occ+fmax(dot3(n,v)/fmax(l,0.0001f32)-0.12f32,0.0f32)*(1.0f32-smoothstep(reach*0.7f32,reach*1.8f32,l));
        }
      }
    }
  }
  ao:f32=1.0f32-clampf((occ/cast(f32)taps)*1.5f32,0.0f32,0.8f32);
  // contact shadows: a short march toward the sun through the depth buffer, for what the shadow map is too coarse to catch
  shade:f32=0.0f32;
  sun:V3=pr_at3(u,b+PR_SUN);
  if ((!reduced)&&(share>0.02f32)&&(sun.y>0.0f32)) {
    march:f32=clampf(z*0.008f32,0.5f32,10.0f32);
    from:V3=add3(p,scale3(n,march*0.03f32+z*0.0004f32));
    eye:V3=pr_at3(u,b+PR_EYE); fw:V3=pr_at3(u,b+PR_FORWARD);
    for i:1..<9 {
      if (shade<0.5f32) {
        q:V3=add3(from,scale3(sun,march*(cast(f32)i-noise)/8.0f32));
        rel:V3=sub3(q,eye);
        zq:f32=dot3(rel,fw);
        sx:f32=(dot3(rel,pr_at3(u,b+PR_RIGHT))/(zq*t*u[b+PR_RIGHT+3])*0.5f32+0.5f32)*w;
        sy:f32=(0.5f32-dot3(rel,pr_at3(u,b+PR_UP))/(zq*t)*0.5f32)*h;
        if ((zq>u[b+PR_FORWARD+3])&&(sx>=0.0f32)&&(sy>=0.0f32)&&(sx<w)&&(sy<h)) {
          zs:f32=pr_post_z(gpu_load_depth(depth,cast(s32)sx,cast(s32)sy,0),u,b);
          gap:f32=zq-zs;
          if ((gap>zq*0.0012f32+0.03f32)&&(gap<march*1.5f32+zq*0.003f32)) {shade=1.0f32;}
        }
      }
    }
  }
  return (1.0f32-share)*ao+share*(1.0f32-0.85f32*shade)*mix(1.0f32,ao,0.25f32);
}
// The post pass's colour at pixel (x, y): the light the surfaces drew, less what contact hides.
pr_post :: (light:V4,aux:V4,x:s32,y:s32,u:[]f32,b:int,depth:TexDepth)->V3 {
  c:V3=v3(light.x,light.y,light.z);
  if (aux.w<0.0f32) {return c;}
  k:f32=pr_contact(x,y,v3(aux.x,aux.y,aux.z),aux.w,u,b,depth);
  return pr_encode(scale3(pr_decode(c),k));
}

// ---- the lamps
// The light of the lamps on a surface at night, to add to pr_lit's. q, n and `toward` are the
// point, its normal and the way to the eye in the parts' own frame (a platform's, before its
// pose), where the lamp field and the near lights are kept.
//
// The field (photoreal-lights.coax pr_lamp_field) holds every lamp's light on level ground, in
// the sky field's cells: a pool under each lamp. Level ground takes it whole; a wall takes the
// pool at its foot, less of it, fading up the wall over the cell's fade height. The lights near
// the eye (PR_NEAR_LIGHTS at most, none on the reduced tier) add what a pool cannot: their
// highlights on smooth things, a lamp's streak in a canal.
pr_lamps :: (q:V3,n:V3,toward:V3,s:PrSurface,u:[]f32,b:int,field:[]f32,materials:[]f32)->V3 {
  level:f32=u[b+PR_LAMPS];
  if (level<=0.001f32) {return v3(0.0f32,0.0f32,0.0f32);}
  out:V3=v3(0.0f32,0.0f32,0.0f32);
  nx:int=cast(int)u[b+PR_FIELD_N]; nz:int=cast(int)u[b+PR_FIELD_N+1];
  if (u[b+PR_LAMPS+3]>0.5f32&&nx>=2&&nz>=2) {
    cell:f32=u[b+PR_FIELD+2];
    base:int=nx*nz*2;
    x:f32=(q.x+n.x*cell*0.6f32-u[b+PR_FIELD])/cell-0.5f32; z:f32=(q.z+n.z*cell*0.6f32-u[b+PR_FIELD+1])/cell-0.5f32;
    i:int=cast(int)wg_clamp_i(cast(s32)floor(x),0,cast(s32)(nx-2)); j:int=cast(int)wg_clamp_i(cast(s32)floor(z),0,cast(s32)(nz-2));
    tx:f32=saturate(x-cast(f32)i); tz:f32=saturate(z-cast(f32)j);
    e:V4=mix4(mix4(wg_at4(field,base+(j*nx+i)*4),wg_at4(field,base+(j*nx+i+1)*4),tx),mix4(wg_at4(field,base+((j+1)*nx+i)*4),wg_at4(field,base+((j+1)*nx+i+1)*4),tx),tz);
    // above the ground the light fades up a wall over the cell's height; below it (the field's
    // ground is a deck, and this a wall under its edge) it is gone within a few metres; and
    // outside the field there is none
    over:f32=fmax(q.y-u[b+PR_FIELD+3],0.0f32)/fmax(e.w,1.0f32);
    under:f32=saturate((u[b+PR_FIELD+3]-q.y)*0.5f32);
    inside:f32=stepf(-0.5f32,x)*stepf(x,cast(f32)nx-0.5f32)*stepf(-0.5f32,z)*stepf(z,cast(f32)nz-0.5f32);
    share:f32=mix(0.5f32,1.0f32,saturate(n.y))*saturate(1.0f32+n.y*2.0f32)*(1.0f32-under)*inside/(1.0f32+over*over);
    out=scale3(mul3(scale3(s.albedo,1.0f32-s.metal),v3(e.x,e.y,e.z)),share);
  }
  count:int=cast(int)(u[b+PR_LAMPS+2]+0.5f32);
  if (count>0&&s.rough<0.5f32) {
    f0:V3=cm_f0(s.albedo,s.metal);
    rough:f32=fmax(s.rough,0.16f32);   // (a lamp is no point: its highlight is never a single sparkle)
    for k:0..<PR_NEAR_LIGHTS {
      if (k<count) {
        row:int=(PR_MATERIALS+k)*PR_MATERIAL_FLOATS;
        to:V3=sub3(v3(materials[row],materials[row+1],materials[row+2]),q);
        d2:f32=fmax(dot3(to,to),0.01f32);
        fade:f32=saturate(1.0f32-d2/fmax(materials[row+3]*materials[row+3],1.0f32));
        out=add3(out,scale3(mul3(cm_ggx(f0,rough,n,scale3(to,1.0f32/sqrt(d2)),toward),v3(materials[row+4],materials[row+5],materials[row+6])),fade*fade/(d2+1.0f32)));
      }
    }
  }
  return scale3(out,level);
}
// ---- the frame's way out
// The frame's light as the display's colour: exposed, through the film response, encoded.
pr_out :: (c:V3,u:[]f32,b:int)->V3 {
  e:f32=u[b+PR_SUN_LIGHT+3];
  // the camera's white balance: red up and blue down by the same share, a grey's brightness kept
  w:f32=u[b+PR_WARM];
  k:f32=e/(1.0f32+0.1404f32*w);
  t:FilmRGB=film_photo(film_rgb(fmax(c.x,0.0f32)*k*(1.0f32+w),fmax(c.y,0.0f32)*k,fmax(c.z,0.0f32)*k*(1.0f32-w)));
  return pr_encode(v3(saturate(t.r),saturate(t.g),saturate(t.b)));
}

// ---- checks
pr_test_block :: (u:[]f32) {
  for i:0..<u.count {u[i]=0.0f32;}
  u[PR_EYE]=0.0f32; u[PR_EYE+1]=10.0f32; u[PR_EYE+2]=0.0f32; u[PR_EYE+3]=0.5f32;
  u[PR_FORWARD+2]=0.0f32-1.0f32; u[PR_FORWARD+3]=0.5f32;
  u[PR_RIGHT]=1.0f32; u[PR_RIGHT+3]=1.6f32;
  u[PR_UP+1]=1.0f32;
  u[PR_SUN]=0.6f32; u[PR_SUN+1]=0.64f32; u[PR_SUN+2]=0.48f32; u[PR_SUN+3]=1.0f32;
  u[PR_SUN_LIGHT]=0.9f32; u[PR_SUN_LIGHT+1]=0.8f32; u[PR_SUN_LIGHT+2]=0.7f32; u[PR_SUN_LIGHT+3]=1.0f32;
  u[PR_GROUND]=0.05f32; u[PR_GROUND+1]=0.06f32; u[PR_GROUND+2]=0.07f32;
  u[PR_HAZE]=0.00004f32; u[PR_HAZE+1]=1200.0f32;
  u[PR_POSE]=1.0f32; u[PR_POSE+5]=1.0f32; u[PR_POSE+10]=1.0f32;
  u[PR_SH]=0.2f32; u[PR_SH+1]=0.25f32; u[PR_SH+2]=0.3f32; u[PR_SH+4]=0.1f32; u[PR_SH+5]=0.12f32; u[PR_SH+6]=0.15f32;
}
#test "a point straight ahead lands in the middle of the view, its depth 1 - near / distance" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  c:V4=pr_clip(v3(0.0f32,10.0f32,0.0f32-100.0f32),u[..],0);
  #assert abs(c.x)<0.00001f32 && abs(c.y)<0.00001f32 && abs(c.w-100.0f32)<0.0001f32 && abs(c.z/c.w-(1.0f32-0.5f32/100.0f32))<0.000001f32;
  // a traced background writes the same depth for the same point
  #assert abs(pr_depth(v3(0.0f32,0.0f32,0.0f32-1.0f32),100.0f32,u[..],0)-c.z/c.w)<0.000001f32;
  // a point up and to the right by the field's half width sits on the view's corner
  e:V4=pr_clip(v3(0.5f32*1.6f32*100.0f32,10.0f32+0.5f32*100.0f32,0.0f32-100.0f32),u[..],0);
  #assert abs(e.x/e.w-1.0f32)<0.00001f32 && abs(e.y/e.w-1.0f32)<0.00001f32;
  // and the ray through that corner's pixel points back at it
  r:V3=pr_ray(v4(1600.0f32,0.0f32,0.0f32,1.0f32),1600.0f32,1000.0f32,u[..],0);
  to:V3=normalize3(v3(80.0f32,50.0f32,0.0f32-100.0f32));
  #assert abs(r.x-to.x)<0.00001f32 && abs(r.y-to.y)<0.00001f32 && abs(r.z-to.z)<0.00001f32;
}
#test "a platform's pose and its inverse undo each other" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  c:f32=cos(0.3f32); s:f32=sin(0.3f32);
  u[PR_POSE]=c; u[PR_POSE+1]=0.0f32-s; u[PR_POSE+3]=4.0f32; u[PR_POSE+4]=s; u[PR_POSE+5]=c; u[PR_POSE+7]=0.0f32-2.0f32; u[PR_POSE+11]=7.0f32;
  w:V3=pr_posed(v3(10.0f32,3.0f32,0.0f32-6.0f32),u[..],0);
  #assert abs(w.x-(c*10.0f32-s*3.0f32+4.0f32))<0.0001f32 && abs(w.z-1.0f32)<0.0001f32;
  back:V3=pr_unposed(w,u[..],0);
  #assert abs(back.x-10.0f32)<0.0001f32 && abs(back.y-3.0f32)<0.0001f32 && abs(back.z+6.0f32)<0.0001f32;
}
#test "a record sizes, turns and sets down its part; a stretch takes the scale's place" {
  m:PrObj;
  m.a=v4(100.0f32,5.0f32,0.0f32-20.0f32,1.5707963f32); m.b=v4(2.0f32,0.0f32,0.0f32,0.0f32);
  // the part's +x runs along (cos yaw, 0, -sin yaw): a quarter turn sends it to -z
  p:V3=pr_placed(v3(1.0f32,1.0f32,0.0f32),m,0.0f32);
  #assert abs(p.x-100.0f32)<0.0001f32 && abs(p.y-7.0f32)<0.0001f32 && abs(p.z+22.0f32)<0.0001f32;
  m.d=v4(10.0f32,30.0f32,4.0f32,0.0f32); m.a.w=0.0f32;
  q:V3=pr_placed(v3(0.5f32,1.0f32,0.0f32-0.5f32),m,0.0f32);
  #assert abs(q.x-105.0f32)<0.0001f32 && abs(q.y-35.0f32)<0.0001f32 && abs(q.z+22.0f32)<0.0001f32;
  // a swaying part's foot stays put and its top moves; a still one never moves
  m.b.y=2.0f32;
  foot:V3=pr_placed(v3(0.0f32,0.0f32,0.0f32),m,3.0f32); top:V3=pr_placed(v3(0.0f32,1.0f32,0.0f32),m,3.0f32);
  #assert abs(foot.x-100.0f32)<0.0001f32 && abs(top.x-100.0f32)>0.01f32 && abs(top.y-35.0f32)<0.0001f32;
}
#test "a small thing is whole near the eye, shrinks over the last fifth of its distance and is a point beyond it" {
  u:[PR_FLOATS]f32;
  u[PR_POSE]=1.0f32; u[PR_POSE+5]=1.0f32; u[PR_POSE+10]=1.0f32; u[PR_POSE+3]=50.0f32;
  u[PR_EYE]=150.0f32; u[PR_EYE+1]=5.0f32;
  m:PrObj;
  m.a=v4(0.0f32,5.0f32,0.0f32,0.0f32);
  // the platform stands 50 m along x: the record's place is at 50 in the world, 100 m from the eye
  top:V3=v3(50.0f32,7.0f32,0.0f32);
  // no distance given: whole, wherever the eye is
  a:V3=pr_kept(top,m,u[..],0);
  #assert a.y==7.0f32 && pr_near_of(m)==0.0f32;
  m.b.w=0.0f32-200.0f32; a=pr_kept(top,m,u[..],0); #assert a.y==7.0f32 && pr_near_of(m)==200.0f32;
  m.b.w=0.0f32-125.0f32; a=pr_kept(top,m,u[..],0); #assert a.y==7.0f32;
  m.b.w=0.0f32-110.0f32; a=pr_kept(top,m,u[..],0); #assert a.y>5.5f32 && a.y<6.5f32;
  m.b.w=0.0f32-100.0f32; a=pr_kept(top,m,u[..],0); #assert a.y==5.0f32;
  m.b.w=0.0f32-60.0f32; a=pr_kept(top,m,u[..],0); #assert a.y==5.0f32 && a.x==50.0f32;
  // the reduced tier draws it three fifths as far
  m.b.w=0.0f32-160.0f32; u[PR_GROUND+3]=1.0f32; a=pr_kept(top,m,u[..],0); #assert a.y==5.0f32;
  u[PR_GROUND+3]=0.0f32; a=pr_kept(top,m,u[..],0); #assert a.y==7.0f32;
  // a free record measures from its own place: 150 m from this eye
  m.b.w=1.0f32; a=pr_kept(top,m,u[..],0); #assert a.y==7.0f32 && pr_near_of(m)==0.0f32;
  m.b.w=161.0f32; a=pr_kept(v3(0.0f32,7.0f32,0.0f32),m,u[..],0); #assert a.y>5.0f32 && a.y<7.0f32 && pr_near_of(m)==160.0f32;
  #assert pr_near_keep(0.0f32,5000.0f32,false)==1.0f32 && pr_near_keep(100.0f32,80.0f32,false)==1.0f32 && pr_near_keep(100.0f32,90.0f32,false)==0.5f32;
}
#test "the wind leans a swaying part downwind, four times as far at twice the speed, and gusts cross a wood as a wave" {
  m:PrObj;
  m.a=v4(0.0f32,0.0f32,0.0f32,0.0f32); m.b=v4(1.0f32,2.0f32,0.0f32,0.0f32);
  top:V3=v3(0.0f32,12.0f32,0.0f32);
  // a steady wind toward +z: the mean lean over a long while is downwind, and none across
  mean4:f32=0.0f32; mean8:f32=0.0f32; cross:f32=0.0f32;
  for i:0..<400 {
    t:f32=cast(f32)i*0.37f32;
    a:V3=pr_placed_in(top,m,t,v4(0.0f32,1.0f32,4.0f32,0.0f32)); c:V3=pr_placed_in(top,m,t,v4(0.0f32,1.0f32,8.0f32,0.0f32));
    mean4=mean4+a.z/400.0f32; mean8=mean8+c.z/400.0f32; cross=cross+a.x/400.0f32;
    #assert a.y==12.0f32;
  }
  #assert mean4>0.05f32 && abs(mean8/mean4-4.0f32)<0.4f32 && abs(cross)<0.02f32;
  // a storm does not lay a tree flat: the lean is never over a third of the height
  g:V3=pr_placed_in(top,m,1.0f32,v4(0.0f32,1.0f32,60.0f32,0.0f32));
  #assert g.z<=12.0f32*0.3f32+12.0f32*12.0f32*0.0003f32*1.35f32+0.001f32;
  // gusts: two trees a quarter of a gust's length apart downwind are out of step, two abreast are in step
  m.b.z=0.0f32;
  n:PrObj=m; n.a=v4(0.0f32,0.0f32,11.0f32,0.0f32); e:PrObj=m; e.a=v4(11.0f32,0.0f32,0.0f32,0.0f32);
  apart:f32=0.0f32; abreast:f32=0.0f32;
  for i:0..<200 {
    t:f32=cast(f32)i*0.21f32; w:V4=v4(0.0f32,1.0f32,6.0f32,1.0f32);
    a:f32=pr_placed_in(top,m,t,w).z;
    apart=apart+abs(pr_placed_in(top,n,t,w).z-11.0f32-a); abreast=abreast+abs(pr_placed_in(top,e,t,w).z-a);
  }
  #assert abreast<0.0001f32 && apart>abreast+1.0f32;
}
#test "a leaf folds away with distance and a lamp's glow never draws under a pixel or two" {
  // from 60 m: standing to 60, half gone at 78, gone past 96; a long lens sees it standing farther
  t:f32=1.0f32/2.4f32;
  #assert pr_fold(10.0f32,60.0f32,t)==0.0f32 && pr_fold(59.9f32,60.0f32,t)==0.0f32 && abs(pr_fold(78.0f32,60.0f32,t)-0.5f32)<0.001f32 && pr_fold(96.1f32,60.0f32,t)==1.0f32 && pr_fold(400.0f32,60.0f32,t)==1.0f32;
  #assert pr_fold(96.0f32,60.0f32,t*0.5f32)==0.0f32;
  // a lamp 0.2 m in radius: its own size near, and at 2 km the 2.2 m that is a pixel or two there
  #assert pr_lamp_grow(30.0f32,0.2f32,0.41f32)==1.0f32 && abs(pr_lamp_grow(2000.0f32,0.2f32,0.41f32)*0.2f32-2000.0f32*0.41f32*0.0027f32)<0.0001f32;
  // the vertex: a leaf near the eye stands off its part, a far one is outside the view; a lamp is gone by day
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  mesh:[12]f32; mesh[0]=0.0f32; mesh[1]=1.0f32; mesh[2]=0.0f32; mesh[3]=1.0f32; mesh[7]=0.0f32-60.0f32; mesh[8]=1.0f32;
  objects:[1]PrObj; objects[0].a=v4(0.0f32,9.0f32,0.0f32-20.0f32,0.0f32); objects[0].b=v4(1.0f32,0.0f32,0.0f32,0.0f32);
  near:PrV=pr_stand(0,0,u[..],0,mesh[..],objects[..]);
  #assert near.pos.w>0.0f32 && near.pos.z<=near.pos.w && abs(near.world.x)<0.1f32;
  objects[0].a.z=0.0f32-500.0f32;
  far:PrV=pr_stand(0,0,u[..],0,mesh[..],objects[..]);
  #assert far.pos.z>far.pos.w && abs(far.world.x+1.0f32)<0.0001f32;
  // the same leaf near the eye on a phone: gone
  objects[0].a.z=0.0f32-20.0f32; u[PR_GROUND+3]=1.0f32;
  #assert pr_stand(0,0,u[..],0,mesh[..],objects[..]).pos.z>1.0f32;
  u[PR_GROUND+3]=0.0f32; mesh[7]=0.0f32; mesh[0]=0.5f32; mesh[1]=0.0f32;
  objects[0].b.y=5.0f32; objects[0].b.x=0.4f32; objects[0].c=v4(1.0f32,1.0f32,1.0f32,0.0f32);
  #assert pr_stand(0,0,u[..],0,mesh[..],objects[..]).pos.z>1.0f32;
  u[PR_LAMPS]=1.0f32;
  lit:PrV=pr_stand(0,0,u[..],0,mesh[..],objects[..]);
  #assert lit.pos.z<=lit.pos.w && abs(lit.tint.x-1.0f32)<0.0001f32 && abs(lit.world.x-0.2f32)<0.0001f32;
  // two kilometres off it is drawn larger and dimmer, and casts no shadow
  objects[0].a.z=0.0f32-2000.0f32;
  off:PrV=pr_stand(0,0,u[..],0,mesh[..],objects[..]);
  #assert off.world.x>1.0f32 && off.tint.x<0.1f32 && off.tint.x>=0.004f32;
  #assert pr_shadow_stand(0,0,u[..],0,mesh[..],objects[..]).pos.z>1.0f32;
}
#test "the moon's face follows the sun: full across from it, a dark disc beside it, half at a quarter; stars are points over the horizon" {
  moon:V3=v3(0.0f32,0.6f32,0.8f32);
  // full: the sun behind the eye, the way the moon faces
  full:V2=pr_moon_face(moon,moon,scale3(moon,0.0f32-1.0f32),0.0002f32);
  #assert full.x>0.99f32 && full.y>0.6f32;
  // new: the sun behind the moon
  new:V2=pr_moon_face(moon,moon,moon,0.0002f32);
  #assert new.x>0.99f32 && new.y==0.0f32;
  // a quarter, the sun off to +x: the limb on the sun's side is lit and the other dark
  side:V3=v3(1.0f32,0.0f32,0.0f32);
  lit_side:V2=pr_moon_face(normalize3(add3(moon,scale3(side,0.003f32))),moon,side,0.0002f32);
  dark_side:V2=pr_moon_face(normalize3(sub3(moon,scale3(side,0.003f32))),moon,side,0.0002f32);
  #assert lit_side.x>0.99f32 && lit_side.y>0.5f32 && dark_side.x>0.99f32 && dark_side.y==0.0f32;
  // off the disc: nothing
  #assert pr_moon_face(normalize3(add3(moon,scale3(side,0.01f32))),moon,side,0.0002f32).x==0.0f32;
  // stars: none under the horizon, and over it most of the sky is dark with a few points
  #assert pr_stars(v3(0.6f32,0.0f32-0.2f32,0.77f32)).x==0.0f32;
  some:int=0;
  for i:0..<4000 {
    a:f32=cast(f32)i*0.731f32; y:f32=0.1f32+0.85f32*fract(cast(f32)i*0.618034f32); r:f32=sqrt(1.0f32-y*y);
    if (pr_stars(v3(cos(a)*r,y,sin(a)*r)).y>0.0f32) {some+=1;}
  }
  #assert some>0 && some<400;
}
#test "the lamp field lights the ground under a lamp and fades up a wall" {
  // a field of 4 by 4 cells, 5 m each, with one lit cell
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  u[PR_FIELD+2]=5.0f32; u[PR_FIELD_N]=4.0f32; u[PR_FIELD_N+1]=4.0f32; u[PR_FIELD_N+2]=8.0f32;
  field:[4*4*2+4*4*4]f32;
  at:int=4*4*2+(1*4+1)*4; field[at]=0.1f32; field[at+1]=0.08f32; field[at+2]=0.05f32; field[at+3]=6.0f32;
  table:[PR_TABLE_FLOATS]f32;
  s:PrSurface; s.albedo=v3(0.5f32,0.5f32,0.5f32); s.rough=0.9f32; s.normal=v3(0.0f32,1.0f32,0.0f32);
  up:V3=v3(0.0f32,1.0f32,0.0f32); under:V3=v3(7.5f32,0.0f32,7.5f32);
  // lamps off, or no field: nothing
  #assert pr_lamps(under,up,up,s,u[..],0,field[..],table[..]).x==0.0f32;
  u[PR_LAMPS]=1.0f32; u[PR_LAMPS+3]=1.0f32;
  ground:V3=pr_lamps(under,up,up,s,u[..],0,field[..],table[..]);
  #assert abs(ground.x-0.05f32)<0.0001f32 && abs(ground.z-0.025f32)<0.0001f32;
  // two cells off: dark; half on: half the light; a wall there takes less and less with height
  #assert pr_lamps(v3(17.5f32,0.0f32,17.5f32),up,up,s,u[..],0,field[..],table[..]).x==0.0f32;
  u[PR_LAMPS]=0.5f32;
  #assert abs(pr_lamps(under,up,up,s,u[..],0,field[..],table[..]).x-0.025f32)<0.0001f32;
  u[PR_LAMPS]=1.0f32;
  wall:V3=v3(1.0f32,0.0f32,0.0f32);
  low:f32=pr_lamps(v3(4.5f32,1.0f32,7.5f32),wall,up,s,u[..],0,field[..],table[..]).x; high:f32=pr_lamps(v3(4.5f32,12.0f32,7.5f32),wall,up,s,u[..],0,field[..],table[..]).x;
  #assert low>0.005f32 && low<ground.x && high<low*0.4f32;
  // a near light: a highlight on a smooth floor where the light mirrors to the eye, none on a rough one
  u[PR_LAMPS+3]=0.0f32; u[PR_LAMPS+2]=1.0f32;
  row:int=PR_MATERIALS*PR_MATERIAL_FLOATS;
  table[row]=0.0f32-10.0f32; table[row+1]=8.0f32; table[row+2]=0.0f32; table[row+3]=100.0f32; table[row+4]=30.0f32; table[row+5]=30.0f32; table[row+6]=30.0f32;
  s.rough=0.1f32;
  toward:V3=normalize3(v3(10.0f32,8.0f32,0.0f32));
  glint:f32=pr_lamps(v3(0.0f32,0.0f32,0.0f32),up,toward,s,u[..],0,field[..],table[..]).x;
  aside:f32=pr_lamps(v3(0.0f32,0.0f32,0.0f32),up,normalize3(v3(0.0f32,8.0f32,10.0f32)),s,u[..],0,field[..],table[..]).x;
  #assert glint>0.01f32 && glint>aside*20.0f32;
  s.rough=0.9f32;
  #assert pr_lamps(v3(0.0f32,0.0f32,0.0f32),up,toward,s,u[..],0,field[..],table[..]).x==0.0f32;
}
#test "the display's curve and its inverse; the film keeps middle grey and never passes white" {
  for i:0..<11 {x:f32=cast(f32)i*0.1f32; #assert abs(pr_encode1(pr_decode1(x))-x)<0.0001f32;}
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  g:V3=pr_out(v3(0.18f32,0.18f32,0.18f32),u[..],0);
  #assert abs(g.x-pr_encode1(0.18f32))<0.01f32 && abs(g.x-g.y)<0.01f32;
  w:V3=pr_out(v3(60.0f32,60.0f32,60.0f32),u[..],0);
  #assert w.x<=1.0f32 && w.x>0.9f32;
  // a stop more exposure is brighter
  u[PR_SUN_LIGHT+3]=2.0f32;
  #assert pr_out(v3(0.18f32,0.18f32,0.18f32),u[..],0).x>g.x;
}
#test "a surface keeps energy: it never sends back more than reaches it" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  // white light from everywhere: the sky's light 1 on every facing, the mirror's 1, no sun
  u[PR_SUN_LIGHT]=0.0f32; u[PR_SUN_LIGHT+1]=0.0f32; u[PR_SUN_LIGHT+2]=0.0f32;
  for i:0..<36 {u[PR_SH+i]=0.0f32;} u[PR_SH]=1.0f32; u[PR_SH+1]=1.0f32; u[PR_SH+2]=1.0f32;
  for k:0..<40 {
    s:PrSurface;
    s.albedo=v3(1.0f32,1.0f32,1.0f32); s.rough=0.05f32+0.1f32*cast(f32)(k%10); s.metal=ifx k<20 then 0.0f32 else 1.0f32; s.normal=v3(0.0f32,1.0f32,0.0f32);
    a:f32=0.1f32+0.35f32*cast(f32)(k%4);
    c:V3=pr_lit(s,v3(sin(a),cos(a),0.0f32),1.0f32,1.0f32,v3(1.0f32,1.0f32,1.0f32),u[..],0);
    #assert c.x<=1.0001f32 && c.x>0.3f32;
  }
}
#test "the sun lights the face turned to it, a shadow takes that away and the sky's light stays" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  s:PrSurface;
  s.albedo=v3(0.5f32,0.5f32,0.5f32); s.rough=0.9f32; s.normal=v3(0.6f32,0.64f32,0.48f32);
  toward:V3=v3(0.0f32,1.0f32,0.0f32); none:V3=v3(0.0f32,0.0f32,0.0f32);
  lit:V3=pr_lit(s,toward,1.0f32,1.0f32,none,u[..],0); shaded:V3=pr_lit(s,toward,0.0f32,1.0f32,none,u[..],0); closed:V3=pr_lit(s,toward,0.0f32,0.0f32,none,u[..],0);
  #assert lit.x>shaded.x+0.3f32 && shaded.x>0.05f32 && closed.x<0.0001f32;
  // a face turned away takes no sun
  s.normal=v3(0.0f32-0.6f32,0.0f32-0.64f32,0.0f32-0.48f32);
  away:V3=pr_lit(s,toward,1.0f32,1.0f32,none,u[..],0);
  #assert away.x<shaded.x+0.0001f32;
}
#test "the air takes more from a farther point and less from a higher eye" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  near:f32=pr_air_through(100.0f32,10.0f32,0.0f32,u[..],0); far:f32=pr_air_through(10000.0f32,10.0f32,0.0f32,u[..],0);
  high:f32=pr_air_through(10000.0f32,3000.0f32,0.0f32,u[..],0);
  #assert near>0.99f32 && far<near && far>0.5f32 && high>far;
  // a ray level with the ground goes through `dist` of the air there exactly
  #assert abs(far-exp(0.0f32-0.00004f32*exp(0.0f32-10.0f32/1200.0f32)*10000.0f32))<0.0001f32;
}
// A 64 by 64 depth buffer looking straight down from 10 m on open ground, with a block 0.4 m
// high over the right half (x > 0).
pr_test_down :: (u:[]f32,d:[]f32,block:bool) {
  pr_test_block(u);
  u[PR_FORWARD+1]=0.0f32-1.0f32; u[PR_FORWARD+2]=0.0f32; u[PR_RIGHT+3]=1.0f32;
  u[PR_UP+1]=0.0f32; u[PR_UP+2]=0.0f32-1.0f32;
  for j:0..<64 {for i:0..<64 {d[j*64+i]=1.0f32-0.5f32/(ifx (block&&(i>=32)) then 9.6f32 else 10.0f32);}}
}
#test "contact: open ground keeps its light; beside a block the sky and a low sun are partly hidden" {
  u:[PR_FLOATS]f32; d:[4096]f32;
  pr_test_down(u[..],d[..],false);
  z:=TexDepth.{width=64,height=64,depth=d[..]};
  up:V3=v3(0.0f32,1.0f32,0.0f32);
  #assert abs(pr_contact(30,30,up,0.0f32,u[..],0,z)-1.0f32)<0.001f32;
  pr_test_down(u[..],d[..],true);
  // the sky's share: darker at the block's foot than out on the open ground
  foot:f32=pr_contact(30,30,up,0.0f32,u[..],0,z);
  open:f32=pr_contact(4,30,up,0.0f32,u[..],0,z);
  #assert foot<0.95f32 && abs(open-1.0f32)<0.001f32;
  // the sun low over the block: the foot is in its contact shadow, the far ground is not
  u[PR_SUN]=0.894f32; u[PR_SUN+1]=0.447f32; u[PR_SUN+2]=0.0f32;
  #assert pr_contact(30,30,up,1.0f32,u[..],0,z)<0.3f32 && pr_contact(4,30,up,1.0f32,u[..],0,z)>0.99f32;
  // the reduced tier marches nothing, and a pixel marked for none is left as drawn
  u[PR_GROUND+3]=1.0f32;
  #assert pr_contact(30,30,up,1.0f32,u[..],0,z)>0.5f32;
  c:V3=pr_post(v4(0.5f32,0.4f32,0.3f32,0.0f32),v4(0.0f32,1.0f32,0.0f32,PR_POST_NONE),30,30,u[..],0,z);
  #assert c.x==0.5f32 && c.y==0.4f32 && c.z==0.3f32;
}
#test "a face's coordinates: across and up a wall, x and z on a floor" {
  a:V2=pr_face(v3(3.0f32,7.0f32,5.0f32),v3(0.0f32,1.0f32,0.0f32)); #assert a.x==3.0f32 && a.y==5.0f32;
  c:V2=pr_face(v3(3.0f32,7.0f32,5.0f32),v3(1.0f32,0.0f32,0.0f32)); #assert c.x==5.0f32 && c.y==7.0f32;
  d:V2=pr_face(v3(3.0f32,7.0f32,5.0f32),v3(0.0f32,0.0f32,0.0f32-1.0f32)); #assert d.x==3.0f32 && d.y==7.0f32;
}
#test "a record's sizes, sway, bob, lean and turn, each at its edges, against numbers worked by hand" {
  m:PrObj;
  // a stretch with one zero is still the stretch
  m.d=v4(0.0f32,2.0f32,3.0f32,0.0f32); s:V3=pr_sizes(m); #assert s.x==0.0f32 && s.y==2.0f32 && s.z==3.0f32;
  m.d=v4(2.0f32,3.0f32,0.0f32,0.0f32); s=pr_sizes(m); #assert s.x==2.0f32 && s.y==3.0f32 && s.z==0.0f32;
  m.d=v4(2.0f32,0.0f32,0.0f32,0.0f32); s=pr_sizes(m); #assert s.x==2.0f32 && s.y==0.0f32 && s.z==0.0f32;
  // no stretch: the scale, unless the record leans (motion 4), when it is a metre a metre
  m.d=v4(0.0f32,0.0f32,0.0f32,0.0f32); m.b=v4(2.0f32,3.5f32,0.0f32,0.0f32); s=pr_sizes(m); #assert s.x==2.0f32 && s.y==2.0f32 && s.z==2.0f32;
  m.b.y=4.0f32; s=pr_sizes(m); #assert s.x==1.0f32 && s.y==1.0f32 && s.z==1.0f32;
  // the lean: roll 0.3 about x, then pitch 0.5 about z; below motion 3.5 nothing leans
  m.b=v4(0.3f32,3.5f32,0.5f32,0.0f32);
  cr:f32=cos(0.3f32); sr:f32=sin(0.3f32); cp:f32=cos(0.5f32); sp:f32=sin(0.5f32);
  y:f32=2.0f32*cr-3.0f32*sr; z:f32=2.0f32*sr+3.0f32*cr;
  q:V3=pr_leant(v3(1.0f32,2.0f32,3.0f32),m);
  #assert abs(q.x-(cp-y*sp))<0.0001f32 && abs(q.y-(sp+y*cp))<0.0001f32 && abs(q.z-z)<0.0001f32;
  // a leaning record's part is leant where it is placed
  m.b.y=4.0f32; m.d=v4(1.0f32,1.0f32,1.0f32,0.0f32); w0:V3=pr_placed(v3(1.0f32,2.0f32,3.0f32),m,0.0f32);
  #assert abs(w0.x-(cp-y*sp))<0.0001f32 && abs(w0.y-(sp+y*cp))<0.0001f32 && abs(w0.z-z)<0.0001f32;
  m.b.y=3.4f32; q=pr_leant(v3(1.0f32,2.0f32,3.0f32),m); #assert q.x==1.0f32 && q.y==2.0f32 && q.z==3.0f32;
  // the sway, 10 m up at time 3 and phase 0.4, in pr_placed's light breeze (3 m/s along +x, gusty
  // 0.5): a lean downwind by the squares of speed and height, its own sway and the gusts along the
  // wind, a little across it; motions 1.5, 2.5 and 0 keep still
  m.d=v4(0.0f32,0.0f32,0.0f32,0.0f32); m.a=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  m.b=v4(1.0f32,2.0f32,0.4f32,0.0f32);
  w:V3=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32);
  lean:f32=100.0f32*0.00004f32*9.0f32;
  own:f32=sin(5.7f32+0.4f32)+0.35f32*sin(9.3f32+0.68f32);
  gust:f32=sin((0.0f32-9.0f32)*0.14f32+0.6f32*sin(0.69f32+0.4f32));
  #assert abs(w.x-(lean*(1.0f32+0.5f32*(0.7f32*gust+0.3f32*own))+0.03f32*own))<0.0001f32 && abs(w.y-10.0f32)<0.0001f32;
  #assert abs(w.z-(0.02f32+lean*0.125f32)*sin(3.9f32+0.92f32))<0.0001f32;
  m.b.y=1.5f32; w=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32); #assert w.x==0.0f32 && w.y==10.0f32 && w.z==0.0f32;
  m.b.y=2.5f32; w=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32); #assert w.x==0.0f32 && w.y==10.0f32 && w.z==0.0f32;
  m.b.y=0.0f32; w=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32); #assert w.x==0.0f32 && w.y==10.0f32 && w.z==0.0f32;
  // the bob: a quarter metre on sin(0.8 t + phase); motion 0.5 and 1.5 keep still
  m.b.y=1.0f32; w=pr_placed(v3(0.0f32,0.0f32,0.0f32),m,3.0f32); #assert abs(w.y-0.25f32*sin(2.4f32+0.4f32))<0.0001f32 && w.x==0.0f32;
  m.b.y=0.5f32; w=pr_placed(v3(0.0f32,0.0f32,0.0f32),m,3.0f32); #assert w.y==0.0f32;
  m.b.y=1.5f32; w=pr_placed(v3(0.0f32,0.0f32,0.0f32),m,3.0f32); #assert w.y==0.0f32;
  // the turn: a quarter turn sends (1, 0, 2) to (2, 0, -1)
  m.b.y=0.0f32; m.a.w=1.5707963f32; w=pr_placed(v3(1.0f32,0.0f32,2.0f32),m,0.0f32);
  #assert abs(w.x-2.0f32)<0.0001f32 && abs(w.y)<0.0001f32 && abs(w.z+1.0f32)<0.0001f32;
}
#test "a vertex stands where its record puts it: sized, leant, turned, posed, tinted, its facts carried" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  mesh:[36]f32;
  // vertex 0: at (1, 0, 0), facing up, pattern 3, tinted (0.5, 0.8, 0); vertex 1: at (0, 1, 0.5), facing (1, 1, 2), tinted (0, 0.5, 0)
  mesh[0]=1.0f32; mesh[4]=1.0f32; mesh[6]=3.0f32; mesh[9]=0.5f32; mesh[10]=0.8f32;
  mesh[13]=1.0f32; mesh[14]=0.5f32; mesh[15]=1.0f32; mesh[16]=1.0f32; mesh[17]=2.0f32; mesh[18]=2.0f32; mesh[22]=0.5f32;
  objects:[2]PrObj;
  // record 0 leans: roll 0.3, pitch 0.5, stretched 2 along x, at (10, 0, 20), on its own (not on the platform)
  objects[0].a=v4(10.0f32,0.0f32,20.0f32,0.0f32); objects[0].b=v4(0.3f32,4.0f32,0.5f32,1.0f32);
  objects[0].c=v4(0.5f32,0.6f32,0.7f32,0.2f32); objects[0].d=v4(2.0f32,1.0f32,1.0f32,0.0f32);
  v:PrV=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  cr:f32=cos(0.3f32); sr:f32=sin(0.3f32); cp:f32=cos(0.5f32); sp:f32=sin(0.5f32);
  #assert abs(v.world.x-(10.0f32+2.0f32*cp))<0.0001f32 && abs(v.world.y-2.0f32*sp)<0.0001f32 && abs(v.world.z-20.0f32)<0.0001f32;
  #assert abs(v.local.x-2.0f32)<0.0001f32 && v.local.y==0.0f32 && v.local.z==0.0f32;
  #assert abs(v.normal.x+cr*sp)<0.0001f32 && abs(v.normal.y-cr*cp)<0.0001f32 && abs(v.normal.z-sr)<0.0001f32;
  #assert v.facing.x==0.0f32 && v.facing.y==1.0f32 && v.facing.z==0.0f32;
  #assert abs(v.tint.x-0.25f32)<0.0001f32 && abs(v.tint.y-0.48f32)<0.0001f32 && v.tint.z==0.0f32;
  #assert v.info.x==3.0f32 && abs(v.info.y-0.2f32)<0.0001f32 && v.info.z==0.0f32 && v.info.w==1.0f32;
  c0:V4=pr_clip(v.world,u[..],0);
  #assert abs(v.pos.x-c0.x)<0.0001f32 && abs(v.pos.w-c0.w)<0.0001f32 && abs(v.pos.z-(c0.z-0.0000006f32*c0.w))<0.0000001f32;
  // drawn only within 5 m of the eye, 22 m away: all of it is drawn in to its record's place
  objects[0].b.w=6.0f32;
  v=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  #assert abs(v.world.x-10.0f32)<0.0001f32 && abs(v.world.y)<0.0001f32 && abs(v.world.z-20.0f32)<0.0001f32;
  // motion 3.5 lies on a surface but keeps its phase; its own pattern of 0.5 is no pattern
  objects[0].b=v4(1.0f32,3.5f32,0.5f32,1.0f32); objects[0].d.w=0.5f32;
  v=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  #assert v.info.z==0.5f32 && v.info.x==3.0f32;
  // motion 2.5 sits at its own depth
  objects[0].b=v4(1.0f32,2.5f32,0.0f32,1.0f32); objects[0].d=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  v=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  c0=pr_clip(v.world,u[..],0);
  #assert abs(v.pos.z-c0.z)<0.0000001f32;
  // record 1 bobs on a turned, moved platform at time 3: a quarter turn, stretched (2, 4, 1), its own pattern 5, phase 0.7
  c:f32=cos(0.3f32); s:f32=sin(0.3f32);
  u[PR_POSE]=c; u[PR_POSE+1]=0.0f32-s; u[PR_POSE+3]=4.0f32; u[PR_POSE+4]=s; u[PR_POSE+5]=c; u[PR_POSE+7]=0.0f32-2.0f32; u[PR_POSE+11]=7.0f32;
  u[PR_UP+3]=3.0f32;
  objects[1].a=v4(3.0f32,1.0f32,2.0f32,1.5707963f32); objects[1].b=v4(1.0f32,1.0f32,0.7f32,0.0f32);
  objects[1].c=v4(0.4f32,0.5f32,0.6f32,0.9f32); objects[1].d=v4(2.0f32,4.0f32,0.5f32,5.0f32);
  e:PrV=pr_stand(cast(u32)1,cast(u32)1,u[..],0,mesh[..],objects[..]);
  // the part's (0, 4, 0.25), bobbed, turned a quarter is (0.25, 4 + bob, 0), set at (3, 1, 2), then posed
  bob:f32=0.25f32*sin(2.4f32+0.7f32);
  want:V3=pr_posed(v3(3.25f32,5.0f32+bob,2.0f32),u[..],0);
  #assert abs(e.world.x-want.x)<0.0001f32 && abs(e.world.y-want.y)<0.0001f32 && abs(e.world.z-want.z)<0.0001f32;
  #assert abs(e.local.x)<0.0001f32 && abs(e.local.y-4.0f32)<0.0001f32 && abs(e.local.z-0.25f32)<0.0001f32;
  // the normal (1, 1, 2) under sizes (2, 4, 0.5) is (1/2, 1/4, 4), normalised, turned to (4, 1/4, -1/2), posed
  n:V3=normalize3(v3(0.5f32,0.25f32,4.0f32));
  wn:V3=pr_posed_dir(v3(n.z,n.y,0.0f32-n.x),u[..],0);
  #assert abs(e.normal.x-wn.x)<0.0001f32 && abs(e.normal.y-wn.y)<0.0001f32 && abs(e.normal.z-wn.z)<0.0001f32;
  #assert abs(e.facing.x-n.x)<0.0001f32 && abs(e.facing.y-n.y)<0.0001f32 && abs(e.facing.z-n.z)<0.0001f32;
  #assert e.tint.x==0.0f32 && abs(e.tint.y-0.25f32)<0.0001f32 && e.tint.z==0.0f32;
  #assert e.info.x==5.0f32 && abs(e.info.y-0.9f32)<0.0001f32 && abs(e.info.z-0.7f32)<0.0001f32 && e.info.w==0.0f32;
  c1:V4=pr_clip(e.world,u[..],0);
  #assert abs(e.pos.x-c1.x)<0.0001f32 && abs(e.pos.y-c1.y)<0.0001f32 && abs(e.pos.z-c1.z)<0.0000001f32 && abs(e.pos.w-c1.w)<0.0001f32;
  // from 0.5 up a record stands on its own, off the platform
  objects[1].b.w=0.5f32;
  e=pr_stand(cast(u32)1,cast(u32)1,u[..],0,mesh[..],objects[..]);
  #assert abs(e.world.x-3.25f32)<0.0001f32 && abs(e.world.z-2.0f32)<0.0001f32;
  // a vertex with no tint of its own takes the record's whole
  e=pr_stand(cast(u32)2,cast(u32)1,u[..],0,mesh[..],objects[..]);
  #assert abs(e.tint.x-0.4f32)<0.0001f32 && abs(e.tint.y-0.5f32)<0.0001f32 && abs(e.tint.z-0.6f32)<0.0001f32;
}
#test "built surfaces: a band covers its share of a pixel, rooms stay dark by day, a lift's joint and a tie hole darken a poured wall" {
  #assert abs(pr_band(0.0f32,0.0f32,0.5f32,0.1f32,0.0f32)-1.0f32)<0.0001f32 && pr_band(2.0f32,0.0f32,0.5f32,0.1f32,0.0f32)==0.0f32;
  // a band a tenth of a pixel wide covers a tenth of it
  #assert abs(pr_band(0.0f32,0.0f32,0.1f32,1.0f32,0.0f32)-0.1f32)<0.0001f32;
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  #assert pr_room(v2(3.0f32,10.0f32),3.0f32,3.9f32,0.0f32,0.01f32,0.01f32,u[..],0).x==0.0f32;
  u[PR_ROOMS]=1.0f32;
  lit:f32=0.0f32;
  for i:0..<40 {lit=lit+pr_room(v2(cast(f32)i*3.0f32+1.5f32,cast(f32)(i%7)*3.9f32+2.0f32),3.0f32,3.9f32,0.0f32,0.01f32,0.01f32,u[..],0).x;}
  #assert lit>0.0f32;
  m:[16]f32; for i:0..<16 {m[i]=0.0f32;}
  s:PrSurface; s.albedo=v3(0.6f32,0.6f32,0.6f32); s.rough=0.8f32; s.normal=v3(0.0f32,0.0f32,1.0f32);
  u[PR_HAZE+2]=0.0f32-500.0f32;
  face:V3=v3(0.0f32,0.0f32,1.0f32);
  plain:PrSurface=pr_poured(s,v2(1.0f32,1.5f32),0.002f32,0.002f32,v3(0.0f32,100.0f32,0.0f32),face,0.0f32,3.0f32,u[..],0,m[..],8);
  joint:PrSurface=pr_poured(s,v2(1.0f32,3.0f32),0.002f32,0.002f32,v3(0.0f32,100.0f32,0.0f32),face,0.0f32,3.0f32,u[..],0,m[..],8);
  hole:PrSurface=pr_poured(s,v2(1.25f32,0.75f32),0.002f32,0.002f32,v3(0.0f32,100.0f32,0.0f32),face,0.0f32,3.0f32,u[..],0,m[..],8);
  #assert joint.albedo.x<plain.albedo.x*0.85f32 && hole.albedo.x<plain.albedo.x*0.7f32;
  // seen from far off (a pixel of 2 m) the tie hole is gone
  far:PrSurface=pr_poured(s,v2(1.25f32,0.75f32),2.0f32,2.0f32,v3(0.0f32,100.0f32,0.0f32),face,0.0f32,3.0f32,u[..],0,m[..],8);
  #assert far.albedo.x>hole.albedo.x*1.2f32;
  // wet concrete is darker and glossier
  w:PrSurface=pr_wet(s,1.0f32,0.0f32,face);
  #assert w.albedo.x<s.albedo.x*0.7f32 && w.rough<0.3f32;
}
