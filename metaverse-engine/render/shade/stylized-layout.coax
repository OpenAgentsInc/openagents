// The Metaverse Engine's stylized shading, its frame block: where each number of the look sits in a page's
// uniform floats. metaverse-engine/render/shade/stylized-frame.coax writes them on the CPU and
// metaverse-engine/render/shade/stylized.coax's shaders read them, so both load this file and neither repeats an
// offset. A block is STY_UNIFORM_FLOATS floats: STY_UNIFORM_FLOATS / 4 vec4f in a page's bindings.
//
//   STY_U_SIZE        the picture's width and height in pixels, the clock in seconds, the fade (1 shown)
//   STY_U_EYE         the eye, and the focal length in pixels
//   STY_U_VIEW        the view and projection, four rows: clip = row . (x, y, z, 1)
//   STY_U_LIGHT       the sun's view of the scene for its shadow map, four rows
//   STY_U_SUN         the way to the sun, and how dark its shadows are (0 none, 1 no direct light)
//   STY_U_SUN_COLOUR  the sun's colour, and how soft the bands of its light are
//   STY_U_SKY_LIGHT   the light from the sky, on faces that look up; STY_U_GROUND_LIGHT from below
//   STY_U_HAZE        the haze's colour, and how much of it a metre adds
//   STY_U_HAZE_INFO   where the haze starts (m), the most it hides (0 to 1), how far the clouds are turned
//                     round the horizon (radians), and the sun's disc (STY_U_SUN_DISC)
//   STY_U_ZENITH      the sky overhead, and the cloud cover (0 clear, 1 overcast)
//   STY_U_HORIZON     the sky at the horizon, and the clouds' size
//   STY_U_RIGHT, STY_U_UP, STY_U_FORWARD   the eye's own axes
//   STY_U_GRASS       the grass field: its west and north edge, a cell's size, cells across
//   STY_U_GRASS_INFO  cells deep, a blade's height and width, and how far the field is drawn
//   STY_U_GROUND      the ground table (metaverse-engine/arch/flora.coax ArchGround): its first node's x and
//                     z, a cell's size, cells a side
//   STY_U_PATH_INFO   how many dirt paths, how soft their edges are (m), how dry the meadow is (0 lush, 1
//                     dry), and how far its patches are shifted (m)
//   STY_U_PATH        STY_PATHS paths, eight floats each: from (x, z) to (x, z), half its width, three spare
//   STY_U_CUMULUS     STY_CUMULI heaped clouds, four floats each: where it stands round the horizon (radians,
//                     0 along -z, turning toward +x), how high its flat base is (radians above the horizon),
//                     half its width and its height (radians; 0: no cloud)
//   STY_U_REVEAL      the grass's reveal (metaverse-engine/render/shade/vegetation.coax, metaverse_style_reveal):
//                     its centre's x and z, how far its front has reached (m) and how wide the front is
//                     (m; 0: no reveal, the whole field stands)
//   STY_U_MOVER       one mover the grass parts round: its x and z, the parting's radius (m; 0: none),
//                     one spare
//   STY_U_WIND        the wind over the grass: the way it blows (x, z, a unit vector), its bend (radians;
//                     0: the blades only sway a little, as before there was wind) and its speed (m/s)
//   STY_U_BARE        the ground the reveal has not reached, a graybox floor: its colour, and the size of
//                     its grid's squares (m; 0: no lines)
//   STY_U_BARE_LINE   that grid's lines: their own light (r, g, b), and how many squares apart the
//                     second, wider grid's lines are (0: none)
//
// The sun in the sky rides in floats the block already had spare, so the block's size and every
// other offset stay as they were and a frame that writes none of them draws no sun (all 0):
//   STY_U_SUN_DISC    the sun's disc: its radius, radians (0: no disc)
//   STY_U_GLOW_R, _G, _B   the glow the sun puts low in the sky round the horizon, most toward the
//                     sun (0: none): dawn's and dusk's colour
//   STY_U_CLOUD_DIM   how much of the clouds' daylight is gone (0: white daylight clouds, 1: black)
//   STY_U_LUSH        the lush grass (0: the plain blades above; over 0: curved blades in tufts, of
//                     STY_LUSH_VERTICES vertices each, with their own colour, light and seed stalks)
//   STY_U_AIR         the air (metaverse-engine/render/shade/atmosphere.coax): 0, the painted sky above; over
//                     0, the sky, its sun, its clouds and the haze's colour come from the sun's place
//                     alone, in light's own scale, and this is the exposure it is shown at (1 is usual)

STY_U_SIZE :: 0;
STY_U_EYE :: 4;
STY_U_VIEW :: 8;
STY_U_LIGHT :: 24;
STY_U_SUN :: 40;
STY_U_SUN_COLOUR :: 44;
STY_U_SKY_LIGHT :: 48;
STY_U_GROUND_LIGHT :: 52;
STY_U_HAZE :: 56;
STY_U_HAZE_INFO :: 60;
STY_U_ZENITH :: 64;
STY_U_HORIZON :: 68;
STY_U_RIGHT :: 72;
STY_U_UP :: 76;
STY_U_FORWARD :: 80;
STY_U_GRASS :: 84;
STY_U_GRASS_INFO :: 88;
STY_U_GROUND :: 92;
STY_U_PATH_INFO :: 96;
STY_U_PATH :: 100;
STY_PATHS :: 12;
STY_PATH_FLOATS :: 8;
STY_U_CUMULUS :: 196;          // STY_U_PATH + STY_PATHS * STY_PATH_FLOATS
STY_CUMULI :: 6;
STY_U_REVEAL :: 220;           // STY_U_CUMULUS + STY_CUMULI * 4
STY_U_MOVER :: 224;
STY_U_WIND :: 228;
STY_U_BARE :: 232;
STY_U_BARE_LINE :: 236;
STY_UNIFORM_FLOATS :: 240;
STY_U_SUN_DISC :: 63;          // STY_U_HAZE_INFO + 3
STY_U_GLOW_R :: 75;            // STY_U_RIGHT + 3
STY_U_GLOW_G :: 79;            // STY_U_UP + 3
STY_U_GLOW_B :: 83;            // STY_U_FORWARD + 3
STY_U_CLOUD_DIM :: 51;         // STY_U_SKY_LIGHT + 3
STY_U_AIR :: 55;               // STY_U_GROUND_LIGHT + 3
STY_U_LUSH :: 227;             // STY_U_MOVER + 3

// A lush blade's vertices: three triangles (root to its middle, a quad; its middle to its tip). A
// plain blade is one triangle, 3. A host draws this many a blade.
STY_LUSH_VERTICES :: 9;

// The shadow map's bias: how far along its normal a surface is moved before it is looked up (m),
// and how much nearer the sun it must be than what the map holds (a share of the map's depth).
STY_SHADOW_PUSH :: 0.07;
STY_SHADOW_BIAS :: 0.0012;
