// The Metaverse Engine's stylized shading: the hand-painted look as an engine feature, written in Coax and
// emitted for each GPU (`coax wgsl`, `coax spirv`, `coax metal`). Any world built from the Metaverse Engine's
// architecture kit (metaverse-engine/arch/) draws with it: load this file from the world's gpu module and
// name these entries (the world's .module strips the `stylized_` prefix):
//
//   stylized_bg_vs / stylized_bg_fs          the sky: a painted gradient, big puffy clouds lit from the sun's side,
//                                            and, when the look names them, the sun's disc and its glow
//   stylized_scene_vs / stylized_scene_fs    the parts: a vertex pulled from the mesh, stood by its record,
//                                            painted by its material, lit in soft bands, shadowed, hazed
//   stylized_shadow_vs / stylized_shadow_fs  the same parts from the sun, into its shadow map
//   stylized_grass_vs / stylized_grass_fs    painterly grass: a blade a cell of the grass field, grown from the
//                                            ground table, kept off paths, paving and bare ground; bent by
//                                            the wind, parted round a mover, and grown outward from a place
//                                            when the frame has a reveal (stylized-frame.coax: sty_wind,
//                                            sty_mover, sty_reveal; the maths is vegetation.coax's)
//   stylized_water_vs / stylized_water_transmit_fs / stylized_water_emit_fs
//                                            the water pass: a world's wet parts (metaverse-engine/arch/palette.coax,
//                                            ARCH_M_WET and up), drawn last and blended over the rest. A
//                                            host draws each twice: transmit multiplies what is behind it,
//                                            emit adds the water's own colour (coax/web/host.js, water_vs)
//
// What it gives a world:
//   materials     each metaverse-engine/arch/palette.coax material painted from the surface's own metres: courses of
//                 stone, scalloped roof tiles with moss, boards, plaster, leaded lit windows, bark, leaves
//   banded light  the sun in two soft bands (sty_bands) over light from the sky and the ground
//   soft shadows  twelve taps of the sun's shadow map on a spiral (sty_shadow)
//   aerial haze   distance fades to the horizon's colour (sty_haze)
//   ground        grass, dirt paths with soft wandering edges, cobbles (sty_ground)
//   water         sty_river: depth tint from the ground table under it, ripples that run downstream, foam
//                 at the shore and where the table's fourth field says it churns; sty_falls: a
//                 waterfall's falling streaks; spray and a rainbow (sty_wet)
//   sky, clouds   sty_sky: the whole dome, every way the eye can look
//   the sun       its disc in the sky, red on the horizon and white-gold once up (sty_sun_disc,
//                 sty_sun_ink), the glow it puts low in the sky (sty_sun_glow) and on the clouds, and
//                 clouds that go dark with the light (StyLook.sun_disc, glow, cloud_dim; a sunrise is
//                 stylized-frame.coax's sty_sunrise)
//   reveal        ground and grass that spread from a place over a bare graybox floor with a grid
//                 (sty_reveal_at, sty_floor)
//   the air       with a look's `air` over 0 the sky is the engine's atmosphere (atmosphere.coax): the
//                 air's colour from the sun's place, a small sun many times brighter than white with
//                 its glare, soft clouds the sun lights and shades, and haze the colour of the far
//                 air, so the land meets the sky with no band; grass takes a low sun through its
//                 blades (sty_grass_through); and everything is toned by a curve that leaves the
//                 painted colours as they are and rolls the bright sky off (sty_tone)
//   film          stylized_film_bg_fs / _scene_fs / _grass_fs with stylized_bloom_fs and
//                 stylized_post_fs: the same picture drawn as light, so a host with a post pass
//                 (coax/web/host.js: a module that has post_fs) blooms the sun and the bright sky and
//                 tones the frame once. Name them as bg_fs, scene_fs, grass_fs, bloom_fs and post_fs
//
// The frame's numbers are metaverse-engine/render/shade/stylized-frame.coax's (the look, the camera, the sun's box,
// the grass field, the ground table, the paths), at metaverse-engine/render/shade/stylized-layout.coax's offsets.
// The stores: `mesh` the kit's vertices (12 floats each), `objects` the records (16 floats each),
// `heights` the ground table (4 floats a node).
//   coax/bin/coax test --library metaverse-engine/render/shade/stylized.coax
#load "../../gpu/shader.coax";
#load "../../gpu/wgsl.coax";
#load "../noise.coax";
#load "stylized-layout.coax";
#load "../../arch/palette.coax";
#load "vegetation.coax";
#load "post.coax";
#load "atmosphere.coax";

StyObj :: struct {a:V4; b:V4; c:V4; d:V4;}
// info: the material, the record's value, its phase.
StyS :: struct {pos:V4; world:V3; normal:V3; uv:V2; tint:V3; wash:V3; info:V4 #flat;}
StyShade :: struct {pos:V4;}
StyBlade :: struct {pos:V4; world:V3; colour:V3; along:f32;}

STY_TAU :: 6.2831853f32;

// ---- noise on the Metaverse Engine's lattice hash (metaverse-engine/render/noise.coax)
sty_cell :: (x:f32)->u32 {return cast,trunc(u32)(cast(s32)floor(fmin(fmax(x,0.0f32-33554432.0f32),33554430.0f32)));}
sty_hash2 :: (x:f32,y:f32)->f32 {return render_noise_unit(render_noise_mix2(sty_cell(x),sty_cell(y)));}
sty_noise2 :: (x:f32,y:f32)->f32 {
  ix:f32=floor(x); iy:f32=floor(y); fx:f32=x-ix; fy:f32=y-iy;
  sx:f32=fx*fx*(3.0f32-2.0f32*fx); sy:f32=fy*fy*(3.0f32-2.0f32*fy);
  return mix(mix(sty_hash2(ix,iy),sty_hash2(ix+1.0f32,iy),sx),mix(sty_hash2(ix,iy+1.0f32),sty_hash2(ix+1.0f32,iy+1.0f32),sx),sy);
}
sty_fbm2 :: (x:f32,y:f32)->f32 {
  v:f32=0.0f32; a:f32=0.5f32; px:f32=x; py:f32=y;
  for k:0..<4 { v+=a*sty_noise2(px,py); px=px*2.03f32+1.7f32; py=py*2.03f32+9.2f32; a*=0.5f32; }
  return v/0.9375f32;
}
sty_is :: (material:f32,which:int)->bool {return abs(material-cast(f32)which)<0.5f32;}
// A material's colour: the vertex's tint when it has one, else the material's own.
sty_base :: (tint:V3,own:V3)->V3 {if (tint.x+tint.y+tint.z>0.001f32) {return tint;} return own;}

// ---- the frame
sty_clip :: (w:V3,u:[]f32,rows:int)->V4 {
  p:V4=v4(w.x,w.y,w.z,1.0f32);
  return v4(dot4(wg_at4(u,rows),p),dot4(wg_at4(u,rows+4),p),dot4(wg_at4(u,rows+8),p),dot4(wg_at4(u,rows+12),p));
}
// The ray through a pixel.
sty_ray :: (pos:V4,u:[]f32)->V3 {
  return normalize3(add3(scale3(wg_at3(u,STY_U_FORWARD),u[STY_U_EYE+3]),add3(scale3(wg_at3(u,STY_U_RIGHT),pos.x-u[STY_U_SIZE]*0.5f32),scale3(wg_at3(u,STY_U_UP),u[STY_U_SIZE+1]*0.5f32-pos.y))));
}
// Colours are authored as they should look on the display. They are decoded once to light's own
// scale here, lit there, and encoded once on the way out.
sty_decode :: (c:V3)->V3 {return v3(pow(fmax(c.x,0.0f32),2.2f32),pow(fmax(c.y,0.0f32),2.2f32),pow(fmax(c.z,0.0f32),2.2f32));}
// To the screen: a little more colour, then the display's curve.
sty_encode :: (c:V3)->V3 {
  l:f32=c.x*0.2126f32+c.y*0.7152f32+c.z*0.0722f32;
  s:V3=v3(fmax(l+(c.x-l)*1.04f32,0.0f32),fmax(l+(c.y-l)*1.04f32,0.0f32),fmax(l+(c.z-l)*1.04f32,0.0f32));
  return v3(pow(saturate(s.x),1.0f32/2.2f32),pow(saturate(s.y),1.0f32/2.2f32),pow(saturate(s.z),1.0f32/2.2f32));
}

// ---- the sky
// Cloud in the sky's own coordinates (round the horizon and up): above 0.5 is cloud. Great
// masses from a slow field, their edges billowed by two finer ones.
sty_cloud_field :: (ax:f32,ay:f32,cover:f32)->f32 {
  mass:f32=sty_noise2(ax*0.62f32+4.0f32,ay*0.62f32+1.5f32);
  billow:f32=sty_fbm2(ax*2.1f32,ay*2.1f32);
  puff:f32=sty_noise2(ax*7.0f32+11.0f32,ay*7.0f32+3.0f32);
  return mass*0.62f32+billow*0.34f32+(puff-0.5f32)*0.07f32+(cover-0.5f32)*0.36f32;
}
// The cloud field round the whole horizon: at bearing `az` (radians, -pi to pi: 0 along -z, the two
// ends meeting behind, along +z), `k` of the field's own measure a radian, moved `off` along it. The
// field itself does not repeat round the horizon, so within STY_CLOUD_JOIN radians of the join it is
// mixed with the field one whole turn away, half and half at the join: the two sides meet there at
// the same value and no cloud is cut by a line. Away from the join it is the field, untouched.
STY_CLOUD_JOIN :: 0.6f32;
sty_cloud_round :: (az:f32,k:f32,off:f32,ay:f32,cover:f32)->f32 {
  d:f32=sty_cloud_field(az*k+off,ay,cover);
  t:f32=saturate((abs(az)-(STY_TAU*0.5f32-STY_CLOUD_JOIN))/STY_CLOUD_JOIN);
  if (t>0.0f32) { // mutant: equivalent (at a share of exactly 0 the mix below takes none of the other end: the guard only saves work)
    turn:f32=STY_TAU; if (az>0.0f32) {turn=0.0f32-STY_TAU;} // mutant: equivalent (a bearing of exactly 0 is never within the join, so this line is not reached with it)
    d=mix(d,sty_cloud_field((az+turn)*k+off,ay,cover),0.5f32*t);
  }
  return d;
}
// How far inside a heaped cloud a point is, in the cloud's own measure (its height 1, its flat
// base along y 0, `wide` half its width): above 0 inside. A heap is nine round puffs, six along
// its base, larger toward the middle, and three piled on them, with billows on its edge.
sty_cumulus :: (px:f32,py:f32,wide:f32,seed:f32)->f32 {
  d:f32=0.0f32-10.0f32;
  for k:0..<9 {
    fk:f32=cast(f32)k;
    h1:f32=sty_hash2(fk+seed*7.0f32,seed+3.0f32); h2:f32=sty_hash2(fk+11.0f32,seed*5.0f32+1.0f32);
    cx:f32=0.0f32; cy:f32=0.0f32; r:f32=0.0f32;
    if (k<6) {
      cx=wide*((fk+0.5f32)/6.0f32*1.7f32-0.85f32+(h1-0.5f32)*0.12f32);
      edge:f32=cx/wide; r=0.24f32+0.3f32*(1.0f32-edge*edge)*(0.75f32+0.5f32*h2); cy=r*0.42f32;
    } else {
      cx=wide*((fk-7.0f32)*0.36f32+(h1-0.5f32)*0.2f32); r=0.33f32+0.15f32*h2; cy=0.5f32+0.14f32*h1;
    }
    dx:f32=px-cx; dy:f32=py-cy;
    d=fmax(d,r-sqrt(dx*dx+dy*dy));
  }
  d=d+(sty_noise2(px*5.0f32+seed*13.0f32,py*5.0f32)-0.5f32)*0.09f32+(sty_noise2(px*13.0f32,py*13.0f32+seed)-0.5f32)*0.035f32;
  return fmin(d,py*1.6f32+0.02f32);
}
// ---- the sun in the sky
// How much of the sun's disc a ray is in: all of it inside `radius` (radians) of the way to the sun
// (`cos_t` is the cosine of the angle between them), none outside, with an edge `soft` radians wide.
// A radius of 0 is no disc.
sty_sun_disc :: (cos_t:f32,radius:f32,soft:f32)->f32 {
  if (radius<=0.0f32) {return 0.0f32;}
  // the angle itself, from its cosine: for a small angle, the square root of 2 (1 - cos)
  a:f32=sqrt(fmax(2.0f32-2.0f32*cos_t,0.0f32));
  w:f32=fmax(soft,0.00001f32);
  return 1.0f32-smoothstep(radius-w,radius+w,a);
}
// The disc's colour by how high the sun stands (the sine of its height): a deep orange-red on the
// horizon, white-gold by 20 degrees up.
sty_sun_ink :: (sun_up:f32)->V3 {
  return mix3(v3(1.0f32,0.42f32,0.16f32),v3(1.0f32,0.97f32,0.86f32),smoothstep(0.0f32,0.34f32,sun_up));
}
// How much of the sun's glow a ray takes: `cos_t` the cosine of its angle from the sun, `up` how
// high it looks (the sine, 0 at the horizon and under it). Most low in the sky toward the sun (1.3
// at the sun on the horizon), a wide wash round it, a faint band all round the horizon, and nothing
// overhead.
sty_sun_glow :: (cos_t:f32,up:f32)->f32 {
  away:f32=fmax(1.0f32-cos_t,0.0f32);
  low:f32=exp(0.0f32-up*5.0f32);
  return low*(0.62f32*exp(0.0f32-away*2.2f32)+0.08f32)+0.6f32*exp(0.0f32-away*16.0f32)*exp(0.0f32-up*1.5f32);
}
// A cloud's colour under the frame's light: dimmed by the look's cloud_dim (0 daylight, 1 black) and
// warmed by the sun's glow, most on the parts that face the light (`bright`, 0 to 1) and toward the
// sun, and less the darker the clouds are (a cloud before dawn is a dark shape with a little warmth).
sty_cloud_light :: (cloud:V3,bright:f32,cos_t:f32,u:[]f32)->V3 {
  glow:V3=v3(u[STY_U_GLOW_R],u[STY_U_GLOW_G],u[STY_U_GLOW_B]);
  day:f32=1.0f32-saturate(u[STY_U_CLOUD_DIM]);
  near:f32=0.35f32+0.65f32*exp(0.0f32-fmax(1.0f32-cos_t,0.0f32)*1.4f32);
  return add3(scale3(cloud,day),scale3(glow,(0.3f32+0.6f32*saturate(bright))*near*(0.25f32+0.75f32*day)));
}
sty_sky :: (rd:V3,u:[]f32)->V3 {
  zenith:V3=wg_at3(u,STY_U_ZENITH); horizon:V3=wg_at3(u,STY_U_HORIZON);
  up:f32=saturate(rd.y);
  c:V3=mix3(horizon,zenith,pow(up,0.62f32));
  // The sun: its glow low in the sky, then its disc with a little light round it. A look that names
  // neither (all 0) adds nothing here.
  sun_at:V3=wg_at3(u,STY_U_SUN);
  cos_t:f32=dot3(rd,sun_at);
  glow:V3=scale3(v3(u[STY_U_GLOW_R],u[STY_U_GLOW_G],u[STY_U_GLOW_B]),sty_sun_glow(cos_t,up));
  c=add3(c,glow);
  under:V3=c;
  if (u[STY_U_SUN_DISC]>0.0f32) {
    ink:V3=sty_sun_ink(sun_at.y);
    r:f32=u[STY_U_SUN_DISC];
    halo:f32=exp(0.0f32-fmax(1.0f32-cos_t,0.0f32)/(r*r*3.0f32))*0.35f32;
    c=add3(c,scale3(ink,halo));
    c=mix3(c,ink,sty_sun_disc(cos_t,r,1.5f32/fmax(u[STY_U_EYE+3],1.0f32)));
  }
  // Clouds, painted on the dome: crisp-edged heaps, bright where they face the sun and the sky
  // above them, soft blue-grey beneath, thinning to the horizon.
  size:f32=fmax(u[STY_U_HORIZON+3],0.05f32);
  az:f32=wg_atan2(rd.x,0.0f32-rd.z);
  ak:f32=2.2f32/size; aoff:f32=u[STY_U_HAZE_INFO+2]*ak+u[STY_U_SIZE+2]*0.003f32; ay:f32=up*3.4f32/size;
  cover:f32=u[STY_U_ZENITH+3];
  d:f32=sty_cloud_round(az,ak,aoff,ay,cover);
  band:f32=smoothstep(0.04f32,0.22f32,up)*(1.0f32-smoothstep(0.7f32,0.98f32,up));
  // A crisp edge, about two pixels wide whatever the clouds' size.
  wide:f32=fmax(gpu_fwidth(d),0.0005f32);
  edge:f32=smoothstep(0.5f32-wide,0.5f32+wide,d)*band*smoothstep(0.0f32,0.04f32,cover);
  if (edge>0.0f32) { // mutant: equivalent (with an edge of 0 the mix at the end of this block leaves the sky as it was: the guard only saves work)
    sun:V3=wg_at3(u,STY_U_SUN);
    saz:f32=wg_atan2(sun.x,0.0f32-sun.z);
    turn:f32=saz-az; turn=turn-STY_TAU*floor(turn/STY_TAU+0.5f32);
    toward:f32=0.09f32*clampf(turn*2.5f32,0.0f32-1.0f32,1.0f32);
    // The field a step up and toward the sun: thinner there means this side faces the light.
    lit:f32=d-sty_cloud_round(az,ak,aoff+toward,ay+0.16f32,cover);
    bright:f32=smoothstep(0.0f32-0.01f32,0.045f32,lit);
    shade:V3=v3(0.74f32,0.8f32,0.9f32);
    white:V3=v3(1.0f32,0.99f32,0.96f32);
    cloud:V3=sty_cloud_light(mix3(shade,white,saturate(bright*0.85f32+0.12f32)),bright,cos_t,u);
    cloud=mix3(add3(horizon,glow),cloud,smoothstep(0.02f32,0.3f32,up));
    c=mix3(c,cloud,edge);
  }
  // Heaped clouds, each placed by hand: a crisp edge a pixel or two wide, white above, soft
  // blue-grey toward its flat base, and brightest on the edge that faces up to the light.
  el:f32=wg_atan2(rd.y,sqrt(rd.x*rd.x+rd.z*rd.z));
  for i:0..<STY_CUMULI {
    o:int=STY_U_CUMULUS+i*4; tall:f32=u[o+3];
    if (tall>0.001f32) {
      turn:f32=az-u[o]; turn=turn-STY_TAU*floor(turn/STY_TAU+0.5f32);
      px:f32=turn*cos(u[o+1])/tall; py:f32=(el-u[o+1])/tall; half:f32=u[o+2]/tall;
      if (abs(px)<half+0.9f32&&py>0.0f32-0.2f32&&py<1.7f32) { // mutant: equivalent (outside this box sty_cumulus is below 0 by more than an edge: no puff reaches past 0.85 of the half width plus its radius, above 1.2 or under the base. The guard only saves work)
        seed:f32=cast(f32)i+1.0f32;
        in_:f32=sty_cumulus(px,py,half,seed);
        w:f32=1.5f32/(fmax(u[STY_U_EYE+3],1.0f32)*tall);
        over:f32=smoothstep(0.0f32-w,w,in_);
        rim:f32=smoothstep(0.0f32-0.02f32,0.1f32,in_-sty_cumulus(px+0.03f32,py+0.14f32,half,seed));
        body:f32=smoothstep(0.06f32,0.62f32,py+(sty_noise2(px*2.2f32+seed,py*2.2f32)-0.5f32)*0.4f32);
        heap:V3=mix3(v3(0.78f32,0.85f32,0.94f32),v3(1.0f32,0.995f32,0.97f32),saturate(body*0.9f32+rim*0.45f32));
        c=mix3(c,sty_cloud_light(heap,saturate(body*0.9f32+rim*0.45f32),cos_t,u),over);
      }
    }
  }
  // Below the horizon: the haze the land fades into (the horizon's glow goes with it).
  if (rd.y<0.0f32) {return mix3(under,sty_haze_ink(rd,u),saturate(0.0f32-rd.y*8.0f32));}
  return c;
}
stylized_bg_vs :: (i:u32,_iid:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,1.0f32,1.0f32);
}
// ---- the air, the tone and the film
// A bright value rolled off: as it is up to 0.6, then bending slowly toward 1 (0.6 + 0.4 (1 - exp(-(x - 0.6) / 1.2));
// 0.87 at 2 whites, 0.99 at 5), so the colours a world is painted in are untouched and a sky
// brighter than white still has light and shade in it under a sun that is brighter again.
sty_tone1 :: (x:f32)->f32 {
  if (x<=0.6f32) {return fmax(x,0.0f32);} // mutant: equivalent (at 0.6 exactly the curve below gives 0.6 too)
  return 0.6f32+0.4f32*(1.0f32-exp((0.6f32-x)/1.2f32));
}
// Light toned for the display. A colour brighter than the curve can show is rolled off two ways and
// the two are mixed: each channel by itself (which takes a bright colour toward white, as a camera
// does: the sun's core) and all three by the brightest's roll-off (which keeps its hue: a low
// sun stays orange), 0.55 of the first.
sty_tone :: (c:V3)->V3 {
  hi:f32=fmax(c.x,fmax(c.y,c.z));
  if (hi<=0.6f32) {return v3(fmax(c.x,0.0f32),fmax(c.y,0.0f32),fmax(c.z,0.0f32));} // mutant: equivalent (with the brightest channel at 0.6 exactly both roll-offs below leave every channel as it is)
  k:f32=sty_tone1(hi)/hi;
  return mix3(v3(fmax(c.x,0.0f32)*k,fmax(c.y,0.0f32)*k,fmax(c.z,0.0f32)*k),v3(sty_tone1(c.x),sty_tone1(c.y),sty_tone1(c.z)),0.55f32);
}
// The light as it goes to the eye: exposed (the look's air) when the look has air, as it is when not.
sty_exposed :: (c:V3,u:[]f32)->V3 {
  if (u[STY_U_AIR]>0.0f32) {return scale3(c,u[STY_U_AIR]);}
  return c;
}
// To the screen in one pass (no post pass): toned when the look has air, then encoded.
sty_present :: (c:V3,u:[]f32)->V3 {
  if (u[STY_U_AIR]>0.0f32) {return sty_encode(sty_tone(sty_exposed(c,u)));}
  return sty_encode(c);
}
// The sky's light along a ray: the atmosphere when the look has air, else the painted sky.
sty_sky_light :: (rd:V3,u:[]f32)->V3 {
  if (u[STY_U_AIR]>0.0f32) {
    return atmo_dome(rd,wg_at3(u,STY_U_SUN),u[STY_U_SUN_DISC],1.5f32/fmax(u[STY_U_EYE+3],1.0f32),u[STY_U_ZENITH+3],u[STY_U_HORIZON+3],u[STY_U_SIZE+2]);
  }
  return sty_decode(sty_sky(rd,u));
}
// A frame's two targets when a host has a post pass: the light (its alpha the share of it that
// blooms: what is brighter than white, with a soft knee from 0.6) and a second, unused here.
StyFilm :: struct {light:V4; aux:V4;}
sty_film :: (c:V3,u:[]f32)->StyFilm {
  e:V3=sty_exposed(c,u);
  o:StyFilm;
  o.light=v4(e.x,e.y,e.z,metaverse_style_bloom_share(e.x*0.2126f32+e.y*0.7152f32+e.z*0.0722f32,1.0f32,0.4f32));
  return o;
}
stylized_bg_fs :: (pos:V4,u:[]f32)->V4 {
  c:V3=sty_present(sty_sky_light(sty_ray(pos,u),u),u);
  return v4(c.x,c.y,c.z,1.0f32);
}
stylized_film_bg_fs :: (pos:V4,u:[]f32)->StyFilm {return sty_film(sty_sky_light(sty_ray(pos,u),u),u);}
// The bloom's five steps (coax/web/host.js postLayouts): the bright share of the light to a quarter
// of the size, then blurred across and down, twice, the second time to an eighth.
stylized_bloom_fs :: (pos:V4,bloom_src:Tex2D,bloom_lin:Sampler,bloom_step:[]f32)->V4 {
  texel:V2=v2(1.0f32/cast(f32)gpu_width(bloom_src),1.0f32/cast(f32)gpu_height(bloom_src));
  uv:V2=v2(pos.x*bloom_step[3]*texel.x,pos.y*bloom_step[3]*texel.y);
  if (bloom_step[2]<0.5f32) {
    c:V3=v3(0.0f32,0.0f32,0.0f32);
    for k:0..<4 {
      ox:f32=cast(f32)(k&1)*2.0f32-1.0f32; oy:f32=cast(f32)(k>>1)*2.0f32-1.0f32;
      t:V4=gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+ox*texel.x,uv.y+oy*texel.y),0.0f32); // mutant: equivalent (the four taps are the four corners round the pixel: with either sign turned they are the same four)
      // a pixel's share, and no single pixel more than 16 whites: the sun's core glares, it does not flood
      c=add3(c,scale3(v3(fmin(t.x,16.0f32),fmin(t.y,16.0f32),fmin(t.z,16.0f32)),saturate(t.w)));
    }
    return v4(c.x*0.25f32,c.y*0.25f32,c.z*0.25f32,1.0f32);
  }
  dx:f32=bloom_step[0]*texel.x; dy:f32=bloom_step[1]*texel.y;
  m:V4=gpu_sample_level(bloom_src,bloom_lin,uv,0.0f32);
  a:V4=gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+dx*1.385f32,uv.y+dy*1.385f32),0.0f32);
  b:V4=gpu_sample_level(bloom_src,bloom_lin,v2(uv.x-dx*1.385f32,uv.y-dy*1.385f32),0.0f32);
  e:V4=gpu_sample_level(bloom_src,bloom_lin,v2(uv.x+dx*3.231f32,uv.y+dy*3.231f32),0.0f32);
  f:V4=gpu_sample_level(bloom_src,bloom_lin,v2(uv.x-dx*3.231f32,uv.y-dy*3.231f32),0.0f32);
  return v4(m.x*0.227f32+(a.x+b.x)*0.316f32+(e.x+f.x)*0.070f32,m.y*0.227f32+(a.y+b.y)*0.316f32+(e.y+f.y)*0.070f32,m.z*0.227f32+(a.z+b.z)*0.316f32+(e.z+f.z)*0.070f32,1.0f32);
}
// How much of the blurred bright light is laid back over the frame.
STY_BLOOM :: 0.35f32;
// The frame's light with its bloom, toned and encoded: `light` a pixel's own, `quarter` and `eighth`
// the blurred bright light at the two sizes.
sty_post :: (light:V3,quarter:V3,eighth:V3)->V3 {
  b:V3=add3(scale3(quarter,0.55f32),scale3(eighth,0.45f32));
  return sty_encode(sty_tone(add3(light,scale3(b,STY_BLOOM))));
}
stylized_post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_lin:Sampler)->V4 {
  light:V4=gpu_load(post_light,cast(s32)pos.x,cast(s32)pos.y,0); // mutant: equivalent (for the level: the frame's light has one level, and so have the checks' textures)
  uv:V2=v2(pos.x/u[STY_U_SIZE],pos.y/u[STY_U_SIZE+1]);
  q:V4=gpu_sample_level(post_quarter,post_lin,uv,0.0f32);
  e:V4=gpu_sample_level(post_eighth,post_lin,uv,0.0f32);
  c:V3=sty_post(v3(light.x,light.y,light.z),v3(q.x,q.y,q.z),v3(e.x,e.y,e.z));
  return v4(c.x,c.y,c.z,1.0f32);
}

// ---- light
// The sun in two soft bands: a face turned from it is dark, one turned to it bright, and between
// them a half tone. `soft` is how wide each band's edge is.
sty_bands :: (ndl:f32,soft:f32)->f32 {
  s:f32=fmax(soft,0.01f32);
  return smoothstep(0.0f32-s*0.3f32,s*0.7f32,ndl)*0.7f32+smoothstep(0.42f32,0.42f32+s,ndl)*0.3f32;
}
// How much of the sun reaches a point: twelve taps of its shadow map on a spiral, 1 lit to 0 shadowed.
sty_shadow :: (p:V3,n:V3,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->f32 {
  q:V4=sty_clip(add3(p,scale3(n,STY_SHADOW_PUSH)),u,STY_U_LIGHT);
  if (abs(q.x)>0.995f32||abs(q.y)>0.995f32||q.z<0.0f32||q.z>1.0f32) {return 1.0f32;}
  uv:V2=v2(q.x*0.5f32+0.5f32,0.5f32-q.y*0.5f32);
  texel:f32=1.0f32/cast(f32)gpu_depth_width(shadow_map);
  lit:f32=0.0f32;
  for i:0..<12 {
    a:f32=cast(f32)i*2.399963f32; d:f32=sqrt((cast(f32)i+0.5f32)/12.0f32)*3.2f32*texel;
    lit=lit+gpu_compare(shadow_map,shadow_cmp,v2(uv.x+cos(a)*d,uv.y+sin(a)*d),q.z-STY_SHADOW_BIAS);
  }
  return lit/12.0f32;
}
// Distance fades to the haze.
// The haze's colour along the way `to` (a unit vector from the eye): the look's haze, and the sun's
// glow as the sky's horizon takes it that way, so far ground toward a low sun meets the sky's glow.
sty_haze_ink :: (to:V3,u:[]f32)->V3 {
  glow:V3=v3(u[STY_U_GLOW_R],u[STY_U_GLOW_G],u[STY_U_GLOW_B]);
  return add3(wg_at3(u,STY_U_HAZE),scale3(glow,sty_sun_glow(dot3(to,wg_at3(u,STY_U_SUN)),0.0f32)));
}
// The haze's light along the way `to`: the far air's when the look has air (atmo_far), else the
// look's haze colour with the sun's glow.
sty_haze_light :: (to:V3,u:[]f32)->V3 {
  if (u[STY_U_AIR]>0.0f32) {return atmo_far(to,wg_at3(u,STY_U_SUN));}
  return sty_decode(sty_haze_ink(to,u));
}
sty_haze :: (c:V3,p:V3,u:[]f32)->V3 {
  to:V3=sub3(p,wg_at3(u,STY_U_EYE));
  d:f32=length3(to);
  f:f32=1.0f32-exp(0.0f32-fmax(d-u[STY_U_HAZE_INFO],0.0f32)*u[STY_U_HAZE+3]);
  return mix3(c,sty_haze_light(scale3(to,1.0f32/fmax(d,0.0001f32)),u),fmin(f,u[STY_U_HAZE_INFO+1]));
}
// A surface lit: its colour under the banded sun, its shadow, and the light of the sky and the ground.
sty_lit :: (albedo:V3,n:V3,ndl:f32,shadow:f32,u:[]f32)->V3 {
  sun:f32=sty_bands(ndl,u[STY_U_SUN_COLOUR+3])*mix(1.0f32,shadow,u[STY_U_SUN+3]);
  ambient:V3=mix3(wg_at3(u,STY_U_GROUND_LIGHT),wg_at3(u,STY_U_SKY_LIGHT),n.y*0.5f32+0.5f32);
  return mul3(albedo,add3(ambient,scale3(wg_at3(u,STY_U_SUN_COLOUR),sun)));
}

// ---- the ground
// The ground table's field at a place, blended between its four nodes (0 height, 1 grass cover, 2 paving).
sty_table :: (x:f32,z:f32,field:int,u:[]f32,heights:[]f32)->f32 {
  n:s32=cast(s32)u[STY_U_GROUND+3];
  if (n<1) {return ifx field==1 then 1.0f32 else 0.0f32;}
  fx:f32=(x-u[STY_U_GROUND])/u[STY_U_GROUND+2]; fz:f32=(z-u[STY_U_GROUND+1])/u[STY_U_GROUND+2];
  i:s32=wg_clamp_i(cast(s32)floor(fx),0,n-1); j:s32=wg_clamp_i(cast(s32)floor(fz),0,n-1);
  tx:f32=saturate(fx-cast(f32)i); tz:f32=saturate(fz-cast(f32)j);
  row:s32=n+1;
  a:f32=heights[cast(int)((j*row+i)*4)+field]; b:f32=heights[cast(int)((j*row+i+1)*4)+field];
  c:f32=heights[cast(int)(((j+1)*row+i)*4)+field]; d:f32=heights[cast(int)(((j+1)*row+i+1)*4)+field];
  return mix(mix(a,b,tx),mix(c,d,tx),tz);
}
// How far a place is outside the nearest dirt path's edge, in metres (below 0: on the path), the
// edge wandering a little so it never runs straight.
sty_path :: (x:f32,z:f32,u:[]f32)->f32 {
  d:f32=1000.0f32;
  count:s32=cast(s32)u[STY_U_PATH_INFO];
  for i:0..<STY_PATHS {
    if (cast(s32)i<count) {
      o:int=STY_U_PATH+i*STY_PATH_FLOATS;
      ax:f32=u[o]; az:f32=u[o+1]; bx:f32=u[o+2]-ax; bz:f32=u[o+3]-az;
      t:f32=saturate(((x-ax)*bx+(z-az)*bz)/fmax(bx*bx+bz*bz,0.0001f32));
      ex:f32=x-ax-bx*t; ez:f32=z-az-bz*t;
      d=fmin(d,sqrt(ex*ex+ez*ez)-u[o+4]);
    }
  }
  return d+(sty_noise2(x*0.4f32,z*0.4f32)-0.5f32)*0.5f32+(sty_noise2(x*2.1f32+5.0f32,z*2.1f32)-0.5f32)*0.22f32;
}
// How much of a place is dirt path: 1 on it, 0 off it, soft between.
sty_path_share :: (x:f32,z:f32,u:[]f32)->f32 {
  soft:f32=fmax(u[STY_U_PATH_INFO+1],0.02f32);
  return 1.0f32-smoothstep(0.0f32-soft,soft,sty_path(x,z,u));
}
// Grass's colour at a place: `along` 0 at a blade's root to 1 at its tip. Patches of meadow run
// greener and yellower.
sty_grass_colour :: (x:f32,z:f32,along:f32,u:[]f32)->V3 {
  k:f32=sty_meadow(x,z,u);
  root:V3=mix3(v3(0.19f32,0.29f32,0.17f32),v3(0.3f32,0.38f32,0.21f32),k);
  // Tips run from deep green to a dry olive yellow, patch by patch.
  tip:V3=mix3(v3(0.2f32,0.36f32,0.19f32),v3(0.66f32,0.68f32,0.39f32),smoothstep(0.34f32,0.7f32,k));
  return mix3(root,tip,along);
}
// How dry the meadow is at a place: 0 lush to 1 dry, in broad patches.
sty_meadow :: (x:f32,z:f32,u:[]f32)->f32 {
  sx:f32=x+u[STY_U_PATH_INFO+3];
  patch:f32=sty_noise2(sx*0.06f32+3.0f32,z*0.06f32); fine:f32=sty_noise2(sx*0.6f32,z*0.6f32+8.0f32);
  return saturate(patch*0.8f32+fine*0.3f32+u[STY_U_PATH_INFO+2]-0.55f32);
}
// The flag a place lies on, in flags (one about a unit across): how far its own stone's middle
// is, how far the next nearest stone's, and a number of the stone's own from 0 to 1.
sty_flags :: (x:f32,z:f32)->V3 {
  ix:f32=floor(x); iz:f32=floor(z);
  near:f32=10.0f32; next:f32=10.0f32; id:f32=0.0f32;
  for j:0..<3 {
    for i:0..<3 {
      cx:f32=ix+cast(f32)i-1.0f32; cz:f32=iz+cast(f32)j-1.0f32;
      dx:f32=cx+0.5f32+(sty_hash2(cx,cz)-0.5f32)*0.72f32-x; dz:f32=cz+0.5f32+(sty_hash2(cx+17.0f32,cz+29.0f32)-0.5f32)*0.72f32-z;
      d:f32=sqrt(dx*dx+dz*dz);
      if (d<near) { next=near; near=d; id=sty_hash2(cx+5.0f32,cz+3.0f32); } else if (d<next) { next=d; }
    }
  }
  return v3(near,next,id);
}
// A bell about the origin, about a quarter of a unit tall: 1 on it, 0 off it.
sty_bell :: (x:f32,y:f32)->f32 {
  ax:f32=abs(x);
  dome:bool=y>=0.02f32&&sqrt(x*x+(y-0.02f32)*(y-0.02f32))<0.085f32;
  body:bool=y<0.02f32&&y>0.0f32-0.09f32&&ax<0.085f32+(0.02f32-y)*0.5f32;
  lip:bool=y<=0.0f32-0.09f32&&y>0.0f32-0.115f32&&ax<0.16f32;
  clapper:bool=sqrt(x*x+(y+0.145f32)*(y+0.145f32))<0.026f32;
  knob:bool=sqrt(x*x+(y-0.125f32)*(y-0.125f32))<0.024f32;
  if (dome||body||lip||clapper||knob) {return 1.0f32;}
  return 0.0f32;
}
// A four-pointed star `size` across about the origin: 1 on it.
sty_star :: (x:f32,y:f32,size:f32)->f32 {
  if (sqrt(abs(x))+sqrt(abs(y))<sqrt(size)) {return 1.0f32;}
  return 0.0f32;
}
sty_ground :: (p:V3,cover:f32,paved:f32,u:[]f32)->V3 {
  x:f32=p.x; z:f32=p.z;
  soil:f32=sty_fbm2(x*0.33f32,z*0.33f32); grit:f32=sty_noise2(x*3.1f32,z*3.1f32);
  dirt:V3=scale3(mix3(v3(0.57f32,0.44f32,0.29f32),v3(0.67f32,0.52f32,0.35f32),soil),0.96f32+0.07f32*grit);
  // The earth between the blades: a mid green, a little lighter than their roots.
  grass:V3=mix3(v3(0.29f32,0.4f32,0.22f32),v3(0.42f32,0.48f32,0.27f32),sty_meadow(x,z,u));
  path:f32=sty_path_share(x,z,u);
  c:V3=mix3(dirt,grass,saturate(cover)*(1.0f32-path));
  if (paved>0.01f32) {
    // Flagstones: many-sided flags about a metre across, each its own warm grey, with dark joints.
    // The paving's edge follows whole stones' worth of noise, not a straight line.
    f:V3=sty_flags(x*1.2f32,z*1.2f32);
    joint:f32=smoothstep(0.02f32,0.055f32,f.y-f.x);
    stone:V3=scale3(mix3(v3(0.55f32,0.53f32,0.49f32),v3(0.67f32,0.64f32,0.58f32),f.z),0.96f32+0.06f32*grit);
    share:f32=smoothstep(0.38f32,0.62f32,paved+(sty_noise2(x*0.7f32,z*0.7f32)-0.5f32)*0.3f32);
    c=mix3(c,mix3(v3(0.4f32,0.39f32,0.37f32),stone,joint),share);
  }
  return c;
}

// ---- the reveal (metaverse-engine/render/shade/vegetation.coax: metaverse_style_reveal)
// How much of the grass stands at a place: 1 with no reveal in the frame.
sty_reveal_at :: (x:f32,z:f32,u:[]f32)->f32 {
  dx:f32=x-u[STY_U_REVEAL]; dz:f32=z-u[STY_U_REVEAL+1];
  return metaverse_style_reveal(sqrt(dx*dx+dz*dz),u[STY_U_REVEAL+2],u[STY_U_REVEAL+3]);
}
// How much of a grid line `cell` apart covers a place `q` along one axis, where a pixel spans `w`
// of that axis: a line about a pixel wide however far it is, fading out once the squares are
// smaller than six pixels, so far ground goes plain and never shimmers.
sty_grid_axis :: (q:f32,cell:f32,w:f32)->f32 {
  c:f32=fmax(cell,0.0001f32); px:f32=fmax(w,0.000001f32);
  f:f32=fract(q/c); d:f32=fmin(f,1.0f32-f)*c;
  return (1.0f32-smoothstep(px*0.5f32,px*1.5f32,d))*saturate(c/(px*6.0f32));
}
// The bare floor's lines at a place: 0 none to 1 on a line (and up to 2 where both grids' lines lie).
// `wx` and `wz` are how much of x and z a pixel spans there. No lines without a cell size.
sty_floor_lines :: (x:f32,z:f32,wx:f32,wz:f32,u:[]f32)->f32 {
  cell:f32=u[STY_U_BARE+3];
  if (cell<=0.0f32) {return 0.0f32;}
  k:f32=fmax(sty_grid_axis(x,cell,wx),sty_grid_axis(z,cell,wz));
  major:f32=u[STY_U_BARE_LINE+3];
  if (major>=1.0f32) { k=k+fmax(sty_grid_axis(x,cell*major,wx),sty_grid_axis(z,cell*major,wz)); }
  return k;
}
// The bare floor at a ground point, for the fragment that shades it: how bright its lines are there
// (x) and how much of the place is still bare (y: 0 with no reveal, 1 ahead of the front). It takes
// screen derivatives, so a fragment shader calls it before it branches on anything that varies.
sty_floor :: (p:V3,u:[]f32)->V2 {
  wx:f32=gpu_fwidth(p.x); wz:f32=gpu_fwidth(p.z);
  return v2(sty_floor_lines(p.x,p.z,wx,wz,u),1.0f32-sty_reveal_at(p.x,p.z,u));
}

// ---- the materials
// A surface's own colour and its own light. `flat` is 1 for a surface that is all its own light.
StySurface :: struct {albedo:V3; glow:V3;}
// Ground the reveal has not reached is the bare floor: `floor_` is sty_floor's answer for the place
// (its lines' brightness, how bare it is). The surface's colour goes to the floor's by that share
// and the grid's lines give their own light there. Ground the reveal has passed (or a frame with
// none: a share of 0) keeps its colour, and any other material is left as it was.
sty_floor_over :: (m:StySurface,material:f32,floor_:V2,u:[]f32)->StySurface {
  o:StySurface=m;
  if (sty_is(material,ARCH_M_GROUND)) {
    o.albedo=mix3(m.albedo,wg_at3(u,STY_U_BARE),floor_.y);
    o.glow=scale3(wg_at3(u,STY_U_BARE_LINE),floor_.x*floor_.y);
  }
  return o;
}
sty_surface :: (s:StyS,u:[]f32)->StySurface {
  o:StySurface; o.glow=v3(0.0f32,0.0f32,0.0f32); o.albedo=v3(0.6f32,0.6f32,0.6f32);
  m:f32=s.info.x; a:f32=s.uv.x; b:f32=s.uv.y; p:V3=s.world;
  if (sty_is(m,ARCH_M_GROUND)) { o.albedo=sty_ground(p,a,b,u); return o; }
  if (sty_is(m,ARCH_M_PLASTER)) {
    base:V3=sty_base(s.tint,v3(0.93f32,0.88f32,0.74f32));
    o.albedo=scale3(base,0.9f32+0.13f32*sty_fbm2(a*1.1f32+p.x*0.3f32,b*1.1f32+p.z*0.3f32)); return o;
  }
  if (sty_is(m,ARCH_M_TIMBER)) {
    base:V3=sty_base(s.tint,v3(0.27f32,0.17f32,0.11f32));
    o.albedo=scale3(base,0.82f32+0.36f32*sty_noise2(a*2.0f32+b*9.0f32,b*3.0f32-a*26.0f32)); return o;
  }
  if (sty_is(m,ARCH_M_ROOF)) {
    // Clay tiles: courses up the slope, every other course a half tile along, each tile's lower
    // edge rounded, so the course above shows as a scallop over the shaded top of the one below.
    base:V3=sty_base(s.tint,v3(0.52f32,0.2f32,0.11f32));
    r:f32=b/0.27f32; row:f32=floor(r); fr:f32=r-row;
    c:f32=a/0.25f32+0.5f32*(row-2.0f32*floor(row*0.5f32)); fc:f32=fract(c)-0.5f32;
    lip:f32=1.15f32*fc*fc;
    under:bool=fr<lip;
    if (under) { row=row-1.0f32; c=a/0.25f32+0.5f32*(row-2.0f32*floor(row*0.5f32)); }
    tile:f32=sty_hash2(floor(c),row);
    tone:f32=ifx under then 0.66f32 else 0.86f32+0.16f32*smoothstep(lip,1.0f32,fr);
    tone=tone*(0.84f32+0.3f32*tile);
    warm:V3=mix3(base,mul3(base,v3(1.12f32,1.3f32,1.15f32)),sty_hash2(floor(c)+31.0f32,row+7.0f32)*0.6f32);
    moss:f32=smoothstep(0.6f32,0.74f32,sty_fbm2(a*0.42f32+p.x*0.05f32,b*0.5f32+4.0f32))*0.8f32;
    o.albedo=mix3(scale3(warm,tone),v3(0.22f32,0.3f32,0.11f32),moss); return o;
  }
  if (sty_is(m,ARCH_M_ASHLAR)) {
    // Dressed stone: courses 0.3 m high of blocks 0.56 m long, pale joints, each block its own grey.
    base:V3=sty_base(s.tint,v3(0.63f32,0.63f32,0.61f32));
    r:f32=b/0.3f32; row:f32=floor(r); fr:f32=r-row;
    c:f32=a/0.56f32+0.5f32*(row-2.0f32*floor(row*0.5f32)); fc:f32=fract(c);
    joint:f32=1.0f32-smoothstep(0.012f32,0.03f32,fmin(fmin(fr,1.0f32-fr)*0.3f32,fmin(fc,1.0f32-fc)*0.56f32));
    block:f32=sty_hash2(floor(c),row);
    stone:V3=scale3(base,(0.86f32+0.2f32*block)*(0.93f32+0.07f32*smoothstep(0.0f32,0.5f32,fr)));
    o.albedo=mix3(stone,scale3(base,1.2f32),joint*0.85f32); return o;
  }
  if (sty_is(m,ARCH_M_FIELDSTONE)) {
    base:V3=sty_base(s.tint,v3(0.6f32,0.59f32,0.54f32));
    // A stone's top is its lightest face and what faces down its darkest: each reads as a block.
    form:f32=0.8f32+0.24f32*smoothstep(0.0f32-0.3f32,0.9f32,normalize3(s.normal).y);
    o.albedo=scale3(base,form*(0.94f32+0.08f32*sty_noise2(p.x*2.2f32+p.y*1.5f32,p.z*2.2f32-p.y*1.5f32))); return o;
  }
  if (sty_is(m,ARCH_M_PLANK)) {
    base:V3=sty_base(s.tint,v3(0.78f32,0.56f32,0.3f32));
    c:f32=a/0.22f32; fc:f32=fract(c);
    gap:f32=smoothstep(0.0f32,0.07f32,fmin(fc,1.0f32-fc));
    o.albedo=scale3(base,(0.84f32+0.24f32*sty_hash2(floor(c),3.0f32))*(0.55f32+0.45f32*gap)*(0.94f32+0.1f32*sty_noise2(a*30.0f32,b*2.0f32))); return o;
  }
  if (sty_is(m,ARCH_M_DOOR)) {
    base:V3=sty_base(s.tint,v3(0.38f32,0.23f32,0.13f32));
    c:f32=a/0.2f32; fc:f32=fract(c);
    gap:f32=smoothstep(0.0f32,0.08f32,fmin(fc,1.0f32-fc));
    strap:f32=fmax(1.0f32-smoothstep(0.04f32,0.06f32,abs(b-0.45f32)),1.0f32-smoothstep(0.04f32,0.06f32,abs(b-1.55f32)));
    o.albedo=mix3(scale3(base,(0.85f32+0.25f32*sty_hash2(floor(c),9.0f32))*(0.5f32+0.5f32*gap)),v3(0.09f32,0.08f32,0.08f32),strap); return o;
  }
  if (sty_is(m,ARCH_M_WINDOW)) {
    // A lit window: warm light behind leaded diamonds.
    light:V3=sty_base(s.tint,v3(1.0f32,0.72f32,0.3f32));
    da:f32=fract((a+b)/0.17f32); db:f32=fract((a-b)/0.17f32);
    lead:f32=1.0f32-smoothstep(0.05f32,0.1f32,fmin(fmin(da,1.0f32-da),fmin(db,1.0f32-db)));
    pane:f32=0.82f32+0.3f32*sty_hash2(floor((a+b)/0.17f32),floor((a-b)/0.17f32));
    o.albedo=v3(0.05f32,0.04f32,0.03f32);
    o.glow=mix3(scale3(light,pane*1.05f32),v3(0.12f32,0.08f32,0.05f32),lead); return o;
  }
  if (sty_is(m,ARCH_M_BARK)) {
    base:V3=sty_base(s.tint,v3(0.25f32,0.17f32,0.12f32));
    o.albedo=scale3(base,0.78f32+0.4f32*sty_noise2(a*14.0f32,p.y*1.3f32)); return o;
  }
  if (sty_is(m,ARCH_M_LEAF)) {
    // Leaves in four flat tones: deep shade, the leaf's colour, sunlit, and bright yellow-green
    // on top. The tone comes from how the crown faces the sun there, how high in the crown the
    // leaf sits and a slow patch of the world's own, so light and shade lie across a crown in
    // broad patches; a tuft's own number only frays where two tones meet.
    base:V3=sty_base(s.tint,v3(0.26f32,0.5f32,0.17f32));
    facing:f32=dot3(normalize3(s.normal),wg_at3(u,STY_U_SUN))*0.5f32+0.5f32;
    patch:f32=sty_noise2(p.x*0.42f32+p.y*0.3f32,p.z*0.42f32-p.y*0.3f32)-0.5f32;
    light:f32=facing*0.7f32+a*0.26f32+patch*0.13f32;
    shade:V3=mul3(base,v3(0.58f32,0.68f32,0.66f32));
    // A mass's heart (v -1), seen between its leaves: the tone its leaves have, never a brighter one.
    if (b<0.0f32-0.5f32) { o.albedo=mix3(shade,scale3(base,0.9f32),smoothstep(0.46f32,0.52f32,light)); return o; }
    light=light+(b-0.5f32)*0.05f32;
    c:V3=mix3(shade,base,smoothstep(0.38f32,0.43f32,light));
    c=mix3(c,mul3(base,v3(1.2f32,1.15f32,0.86f32)),smoothstep(0.6f32,0.65f32,light));
    c=mix3(c,mul3(base,v3(1.46f32,1.36f32,0.9f32)),smoothstep(0.85f32,0.9f32,light));
    o.albedo=c; return o;
  }
  if (sty_is(m,ARCH_M_METAL)) { o.albedo=v3(0.075f32,0.075f32,0.085f32); return o; }
  if (sty_is(m,ARCH_M_GLOW)) {
    o.albedo=v3(0.1f32,0.08f32,0.05f32); o.glow=scale3(sty_base(s.tint,v3(1.0f32,0.8f32,0.42f32)),1.25f32); return o;
  }
  if (sty_is(m,ARCH_M_CLOTH)) { o.albedo=sty_base(s.tint,v3(0.75f32,0.2f32,0.16f32)); return o; }
  if (sty_is(m,ARCH_M_ROCK)) {
    // A hill: meadow where it lies easy, bedded rock where it is steep, along a wandering line.
    steep:f32=1.0f32-normalize3(s.normal).y;
    wander:f32=sty_noise2(p.x*0.02f32,p.z*0.02f32)-0.5f32;
    bare:f32=smoothstep(0.24f32,0.4f32,steep+wander*0.18f32);
    grass:V3=mix3(v3(0.4f32,0.58f32,0.28f32),v3(0.58f32,0.66f32,0.34f32),sty_noise2(p.x*0.009f32+7.0f32,p.z*0.009f32));
    stone:V3=scale3(v3(0.6f32,0.6f32,0.61f32),0.92f32+0.12f32*sty_noise2(p.y*0.11f32+wander*3.0f32,2.0f32));
    rock:V3=mix3(grass,stone,bare);
    if (s.tint.x+s.tint.y+s.tint.z>0.001f32) {rock=mul3(rock,s.tint);}
    o.albedo=rock; return o;
  }
  if (sty_is(m,ARCH_M_SMOOTH)) {
    base:V3=sty_base(s.tint,v3(0.8f32,0.79f32,0.75f32));
    o.albedo=scale3(base,0.93f32+0.1f32*sty_noise2(p.x*1.7f32+p.y,p.z*1.7f32-p.y)); return o;
  }
  if (sty_is(m,ARCH_M_SHUTTER)) {
    base:V3=sty_base(s.tint,v3(0.46f32,0.3f32,0.17f32));
    slat:f32=fract(b/0.085f32);
    o.albedo=scale3(base,0.55f32+0.5f32*smoothstep(0.0f32,0.5f32,slat)); return o;
  }
  if (sty_is(m,ARCH_M_STAINED)) {
    // A stained light: a gold border, leaded blue glass, a gold bell and a red lozenge under it;
    // or, with a red tint, a saint in red and gold. It glows a little by day.
    gold:V3=v3(0.95f32,0.74f32,0.22f32); blue:V3=v3(0.14f32,0.2f32,0.78f32);
    da:f32=fract((a+b)*3.0f32); db:f32=fract((a-b)*3.0f32);
    lead:f32=1.0f32-smoothstep(0.03f32,0.07f32,fmin(fmin(da,1.0f32-da),fmin(db,1.0f32-db)));
    c:V3=scale3(blue,0.8f32+0.35f32*sty_hash2(floor((a+b)*3.0f32),floor((a-b)*3.0f32)));
    c=mix3(c,v3(0.05f32,0.06f32,0.2f32),lead*0.7f32);
    if (s.tint.x>0.5f32) {
      head:f32=sqrt((a-0.5f32)*(a-0.5f32)+(b+0.95f32)*(b+0.95f32));
      if (b<0.0f32-1.12f32&&b>0.0f32-3.0f32&&abs(a-0.5f32)<0.13f32+(0.0f32-b-1.12f32)*0.09f32) { c=ifx fract(a*1.0f32+0.25f32)<0.5f32 then v3(0.82f32,0.14f32,0.1f32) else v3(0.93f32,0.66f32,0.16f32); }
      if (head<0.14f32) { c=v3(0.96f32,0.82f32,0.6f32); } else if (head<0.2f32) { c=gold; }
    } else {
      if (sty_bell((a-0.5f32)*0.75f32,(b+1.0f32)*0.75f32)>0.5f32) { c=gold; }
      loz:f32=abs(a-0.5f32)/0.22f32+abs(b+2.1f32)/0.36f32;
      if (loz<1.0f32) { c=ifx loz<0.72f32 then v3(0.86f32,0.2f32,0.1f32) else gold; }
    }
    if (abs(a-0.5f32)>0.37f32) { c=gold; }
    o.albedo=scale3(c,0.35f32); o.glow=scale3(c,0.62f32); return o;
  }
  if (sty_is(m,ARCH_M_BANNER)) {
    // A banner: a field, a gold line down each side, a gold bell in a ring, four stars.
    field:V3=sty_base(s.tint,v3(0.12f32,0.16f32,0.6f32)); gold:V3=v3(0.95f32,0.74f32,0.2f32);
    c:V3=scale3(field,0.9f32+0.14f32*sin(a*9.0f32+b*1.7f32));
    bx:f32=abs(a-0.5f32);
    ring:f32=sqrt((a-0.5f32)*(a-0.5f32)+(b+0.74f32)*(b+0.74f32));
    on:f32=sty_bell(a-0.5f32,b+0.74f32)+sty_star(a-0.5f32,b+1.34f32,0.07f32)+sty_star(a-0.27f32,b+1.6f32,0.05f32)+sty_star(a-0.73f32,b+1.6f32,0.05f32)+sty_star(a-0.5f32,b+1.88f32,0.06f32);
    if (on>0.5f32||abs(ring-0.27f32)<0.022f32||(bx>0.39f32&&bx<0.44f32)||(b>0.0f32-0.1f32&&b<0.0f32-0.05f32)) { c=gold; }
    o.albedo=c; return o;
  }
  if (sty_is(m,ARCH_M_SLAB)) {
    // Paving slabs: courses 0.8 m deep of slabs 1.7 m long, every other course a half slab along.
    base:V3=sty_base(s.tint,v3(0.79f32,0.78f32,0.73f32));
    r:f32=b/0.8f32; row:f32=floor(r); fr:f32=r-row;
    c:f32=a/1.7f32+0.5f32*(row-2.0f32*floor(row*0.5f32)); fc:f32=fract(c);
    joint:f32=1.0f32-smoothstep(0.008f32,0.02f32,fmin(fmin(fr,1.0f32-fr)*0.8f32,fmin(fc,1.0f32-fc)*1.7f32));
    o.albedo=mix3(scale3(base,0.93f32+0.1f32*sty_hash2(floor(c),row)),scale3(base,0.62f32),joint); return o;
  }
  if (sty_is(m,ARCH_M_SETT)) {
    // Setts: courses 0.24 m wide of stones 0.36 m long.
    base:V3=sty_base(s.tint,v3(0.6f32,0.59f32,0.56f32));
    r:f32=b/0.24f32; row:f32=floor(r); fr:f32=r-row;
    c:f32=a/0.36f32+0.5f32*(row-2.0f32*floor(row*0.5f32)); fc:f32=fract(c);
    joint:f32=1.0f32-smoothstep(0.012f32,0.03f32,fmin(fmin(fr,1.0f32-fr)*0.24f32,fmin(fc,1.0f32-fc)*0.36f32));
    o.albedo=mix3(scale3(base,0.86f32+0.22f32*sty_hash2(floor(c),row)),scale3(base,0.64f32),joint); return o;
  }
  if (sty_is(m,ARCH_M_ROSE)) {
    // A rose window: eight petals of glass round a gold boss, an orange light in each, in gold tracery.
    glass:V3=sty_base(s.tint,v3(0.5f32,0.38f32,0.95f32)); gold:V3=v3(0.93f32,0.74f32,0.3f32);
    r:f32=sqrt(a*a+b*b); k:f32=(wg_atan2(b,a)/STY_TAU+0.5f32)*8.0f32; fk:f32=fract(k)-0.5f32;
    c:V3=v3(0.1f32,0.1f32,0.3f32);
    reach:f32=(r-0.58f32)/0.3f32;
    if (r>0.26f32&&r<0.9f32&&abs(fk)<0.4f32*sqrt(fmax(1.0f32-reach*reach,0.0f32))) {
      c=scale3(glass,0.75f32+0.4f32*sty_hash2(floor(k),2.0f32));
      if (abs(fk)<0.13f32&&abs(r-0.6f32)<0.09f32) { c=v3(0.96f32,0.56f32,0.16f32); }
    }
    if (r<0.2f32||r>0.92f32) { c=gold; } else if (r<0.26f32) { c=scale3(glass,0.6f32); }
    o.albedo=scale3(c,0.35f32); o.glow=scale3(c,0.62f32); return o;
  }
  if (sty_is(m,ARCH_M_WATER)) {
    base:V3=sty_base(s.tint,v3(0.6f32,0.78f32,0.88f32));
    t:f32=u[STY_U_SIZE+2];
    glint:f32=smoothstep(0.62f32,0.74f32,sty_noise2(p.x*3.1f32+t*0.5f32,p.z*3.1f32+p.y*5.0f32+t*1.6f32));
    o.albedo=mix3(base,v3(0.96f32,0.98f32,1.0f32),glint*0.7f32); return o;
  }
  if (sty_is(m,ARCH_M_CLIFF)) {
    // A cliff: beds of rock a couple of metres thick that waver, a dark crease between two beds,
    // each bed its own grey, and moss on whatever faces up.
    base:V3=sty_base(s.tint,v3(0.4f32,0.44f32,0.5f32));
    bed:f32=p.y/2.4f32+(sty_noise2(p.x*0.09f32,p.z*0.09f32)-0.5f32)*1.1f32;
    fr:f32=fract(bed);
    crease:f32=1.0f32-smoothstep(0.0f32,0.07f32,fmin(fr,1.0f32-fr));
    tone:f32=0.88f32+0.2f32*sty_hash2(floor(bed),3.0f32)+0.2f32*(sty_fbm2(a*0.22f32+p.x*0.07f32,p.y*0.3f32+p.z*0.07f32)-0.5f32);
    rock:V3=mix3(scale3(base,tone),scale3(base,0.66f32),crease*0.6f32);
    moss:f32=smoothstep(0.62f32,0.82f32,normalize3(s.normal).y+(sty_noise2(p.x*0.7f32,p.z*0.7f32)-0.5f32)*0.3f32);
    o.albedo=mix3(rock,v3(0.29f32,0.42f32,0.2f32),moss); return o;
  }
  if (sty_is(m,ARCH_M_PETAL)) { o.albedo=sty_base(s.tint,v3(0.5f32,0.45f32,0.9f32)); return o; }
  // Wet materials outside the water pass: solid, in their plainest colour.
  if (sty_is(m,ARCH_M_RIVER)) { o.albedo=sty_base(s.tint,v3(0.1f32,0.4f32,0.82f32)); return o; }
  if (sty_is(m,ARCH_M_FALLS)) { o.albedo=sty_base(s.tint,v3(0.8f32,0.9f32,0.98f32)); return o; }
  if (sty_is(m,ARCH_M_MIST)) { o.albedo=v3(0.95f32,0.97f32,1.0f32); return o; }
  if (sty_is(m,ARCH_M_RAINBOW)) { o.albedo=v3(0.9f32,0.9f32,0.8f32); return o; }
  return o;
}

// ---- water
// A rainbow's colour across its band: 0 its inside (violet) to 1 its outside (red).
sty_spectrum :: (k:f32)->V3 {
  h:f32=(1.0f32-saturate(k))*0.76f32;
  return v3(saturate(abs(fract(h)*6.0f32-3.0f32)-1.0f32),saturate(abs(fract(h+0.6666667f32)*6.0f32-3.0f32)-1.0f32),saturate(abs(fract(h+0.3333333f32)*6.0f32-3.0f32)-1.0f32));
}
// A river's surface at a place: its colour, and how much of what lies under it it hides (w).
// `deep` is the water over the ground there in metres and `churn` how white the ground table says
// it runs (0 calm, 1 foam); a is metres downstream and b metres across. Shallow water is clear
// turquoise and deep water blue; pale ripples wind downstream; foam lies along the shore
// and wherever it churns.
sty_river :: (base:V3,a:f32,b:f32,x:f32,z:f32,deep:f32,churn:f32,t:f32)->V4 {
  c:V3=mix3(v3(0.4f32,0.8f32,0.86f32),base,smoothstep(0.04f32,0.85f32,deep));
  // The water's own coordinates, bent by a slow swirl so no ripple runs straight.
  wa:f32=a+(sty_noise2(a*0.45f32-t*0.35f32,b*0.45f32)-0.5f32)*2.2f32; wb:f32=b+(sty_noise2(a*0.45f32+9.0f32,b*0.45f32+t*0.25f32)-0.5f32)*2.2f32;
  // Ripples: a net stretched downstream, of which only drifting patches show, and a finer one between.
  // Ripples: the crests of two slow fields, a broad one and a finer one, both stretched downstream
  // and carried down it, so they wind and close like light on a stream bed.
  r1:f32=1.0f32-abs(sty_noise2((wa-t*1.3f32)*0.5f32,wb*1.2f32)*2.0f32-1.0f32);
  r2:f32=1.0f32-abs(sty_noise2((wa-t*0.85f32)*1.15f32+7.3f32,wb*2.5f32+3.1f32)*2.0f32-1.0f32);
  net:f32=fmax(smoothstep(0.86f32,0.95f32,r1)*0.9f32,smoothstep(0.9f32,0.97f32,r2)*0.5f32);
  // Deeper and lighter blue in slow patches.
  c=scale3(c,0.82f32+0.3f32*sty_noise2(wa*0.36f32-t*0.5f32,wb*0.55f32));
  c=mix3(c,v3(0.84f32,0.96f32,1.0f32),saturate(net)*smoothstep(0.03f32,0.3f32,deep));
  wobble:f32=sty_noise2(x*2.3f32+t*0.35f32,z*2.3f32-t*0.2f32);
  shore:f32=1.0f32-smoothstep(0.015f32,0.04f32+0.09f32*wobble,deep);
  white:f32=smoothstep(0.3f32,0.55f32,churn+(sty_noise2(x*1.9f32-t*1.1f32,z*1.9f32+t*0.6f32)-0.5f32)*0.6f32*smoothstep(0.02f32,0.2f32,churn));
  foam:f32=fmax(shore*smoothstep(0.0f32-0.03f32,0.02f32,deep),white);
  c=mix3(c,v3(0.97f32,0.99f32,1.0f32),foam);
  return v4(c.x,c.y,c.z,fmin(fmax(smoothstep(0.0f32-0.02f32,0.3f32,deep)*0.94f32,foam),0.97f32));
}
// A waterfall's sheet: white streaks that fall over blue, ragged at its sides. a runs across it
// from 0 to 1 and b is metres down from its lip.
sty_falls :: (base:V3,a:f32,b:f32,t:f32)->V4 {
  w:f32=sty_noise2(a*11.0f32,b*0.2f32-t*1.7f32)*0.6f32+sty_noise2(a*26.0f32+3.0f32,b*0.5f32-t*2.9f32)*0.4f32;
  c:V3=mix3(base,v3(1.0f32,1.0f32,1.0f32),smoothstep(0.27f32,0.5f32,w));
  // Its sides break into strands that part and close as they fall.
  side:f32=fmin(a,1.0f32-a)+(sty_noise2(b*0.7f32-t*2.2f32,a*9.0f32)-0.5f32)*0.22f32+(sty_noise2(a*40.0f32,b*0.35f32-t*2.6f32)-0.5f32)*0.1f32;
  return v4(c.x,c.y,c.z,saturate(smoothstep(0.02f32,0.1f32,side)*(0.84f32+0.16f32*w)*smoothstep(0.0f32-0.2f32,0.5f32,b)));
}
// A wet surface: its colour as it should look, and how much of what is behind it it hides.
sty_wet :: (s:StyS,u:[]f32,heights:[]f32)->V4 {
  m:f32=s.info.x; p:V3=s.world; t:f32=u[STY_U_SIZE+2];
  if (sty_is(m,ARCH_M_RIVER)) {
    return sty_river(sty_base(s.tint,v3(0.08f32,0.36f32,0.8f32)),s.uv.x,s.uv.y,p.x,p.z,p.y-sty_table(p.x,p.z,0,u,heights),sty_table(p.x,p.z,3,u,heights),t);
  }
  if (sty_is(m,ARCH_M_FALLS)) { return sty_falls(sty_base(s.tint,v3(0.4f32,0.64f32,0.92f32)),s.uv.x,s.uv.y,t); }
  if (sty_is(m,ARCH_M_MIST)) {
    // Spray: thickest where a puff is seen square on, nothing at its rim, drifting a little.
    toward:V3=normalize3(sub3(wg_at3(u,STY_U_EYE),p));
    k:f32=saturate(abs(dot3(normalize3(s.normal),toward)));
    return v4(0.96f32,0.98f32,1.0f32,k*k*k*(0.1f32+0.09f32*sty_noise2(p.x*0.6f32+t*0.4f32,p.y*0.6f32-t*0.7f32)));
  }
  if (sty_is(m,ARCH_M_RAINBOW)) {
    c:V3=sty_spectrum(s.uv.x);
    return v4(c.x,c.y,c.z,pow(sin(saturate(s.uv.x)*3.14159f32),0.7f32)*sin(saturate(s.uv.y)*3.14159f32)*0.6f32);
  }
  // Anything else drawn here is drawn whole.
  o:StySurface=sty_surface(s,u);
  return v4(o.albedo.x,o.albedo.y,o.albedo.z,1.0f32);
}

// ---- the parts
// A part's vertex where its record stands it.
sty_stand :: (id:u32,instance:u32,u:[]f32,mesh:[]f32,objects:[]StyObj)->StyS {
  m:StyObj=objects[cast(int)instance];
  o:int=cast(int)id*12;
  local:V3=scale3(v3(mesh[o],mesh[o+1],mesh[o+2]),m.b.x);
  n:V3=v3(mesh[o+3],mesh[o+4],mesh[o+5]);
  c:f32=cos(m.a.w); sn:f32=sin(m.a.w);
  w:V3=v3(local.x*c+local.z*sn+m.a.x,local.y+m.a.y,(0.0f32-local.x)*sn+local.z*c+m.a.z);
  s:StyS;
  s.world=w;
  s.normal=v3(n.x*c+n.z*sn,n.y,(0.0f32-n.x)*sn+n.z*c);
  s.uv=v2(mesh[o+7],mesh[o+8]);
  s.tint=v3(mesh[o+9],mesh[o+10],mesh[o+11]);
  s.wash=v3(m.c.x,m.c.y,m.c.z);
  s.info=v4(mesh[o+6],m.c.w,m.b.z,0.0f32);
  s.pos=sty_clip(w,u,STY_U_VIEW);
  return s;
}
stylized_scene_vs :: (id:u32,instance:u32,u:[]f32,mesh:[]f32,objects:[]StyObj)->StyS {return sty_stand(id,instance,u,mesh,objects);}
// A surface's light, hazed: what the scene's fragment shows.
sty_scene_light :: (s:StyS,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V3 {
  n:V3=normalize3(s.normal);
  sun:V3=wg_at3(u,STY_U_SUN);
  floor_:V2=sty_floor(s.world,u);
  m:StySurface=sty_floor_over(sty_surface(s,u),s.info.x,floor_,u);
  albedo:V3=sty_decode(mul3(m.albedo,s.wash));
  ndl:f32=dot3(n,sun);
  // Leaves take the sun round their edges: the crown reads as one soft mass.
  shadow:f32=sty_shadow(s.world,n,u,shadow_map,shadow_cmp);
  // Leaves are painted in their own tones of light (sty_surface): the sun reaches every leaf,
  // and another crown's shadow only dims it.
  if (sty_is(s.info.x,ARCH_M_LEAF)||sty_is(s.info.x,ARCH_M_PETAL)) { ndl=1.0f32; shadow=mix(0.5f32,1.0f32,shadow); }
  c:V3=add3(sty_lit(albedo,n,ndl,shadow,u),sty_decode(m.glow));
  return sty_haze(c,s.world,u);
}
stylized_scene_fs :: (s:StyS,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
  c:V3=sty_present(sty_scene_light(s,u,shadow_map,shadow_cmp),u);
  return v4(c.x,c.y,c.z,1.0f32);
}
stylized_film_scene_fs :: (s:StyS,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->StyFilm {return sty_film(sty_scene_light(s,u,shadow_map,shadow_cmp),u);}
// The water pass: a world's wet parts (rivers, pools, falls, spray, a rainbow), drawn after
// everything else in two halves. The first keeps of what lies behind the share the water lets
// through; the second adds the water's own colour, lit, shadowed and hazed.
stylized_water_vs :: (id:u32,instance:u32,u:[]f32,mesh:[]f32,objects:[]StyObj)->StyS {return sty_stand(id,instance,u,mesh,objects);}
stylized_water_transmit_fs :: (s:StyS,u:[]f32,heights:[]f32)->V4 {
  k:f32=1.0f32-sty_wet(s,u,heights).w;
  return v4(k,k,k,1.0f32);
}
stylized_water_emit_fs :: (s:StyS,u:[]f32,heights:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
  w:V4=sty_wet(s,u,heights);
  up:V3=v3(0.0f32,1.0f32,0.0f32);
  c:V3=sty_decode(mul3(v3(w.x,w.y,w.z),s.wash));
  // Open water takes the sun and its shadows; spray and a rainbow are light themselves.
  if (sty_is(s.info.x,ARCH_M_RIVER)||sty_is(s.info.x,ARCH_M_FALLS)) {
    shadow:f32=mix(0.45f32,1.0f32,sty_shadow(s.world,up,u,shadow_map,shadow_cmp));
    c=sty_lit(c,up,1.0f32,shadow,u);
  }
  c=scale3(sty_encode(sty_haze(c,s.world,u)),w.w);
  return v4(c.x,c.y,c.z,1.0f32);
}
stylized_shadow_vs :: (id:u32,instance:u32,u:[]f32,mesh:[]f32,objects:[]StyObj)->StyShade {
  m:StyObj=objects[cast(int)instance];
  o:int=cast(int)id*12;
  local:V3=scale3(v3(mesh[o],mesh[o+1],mesh[o+2]),m.b.x);
  c:f32=cos(m.a.w); sn:f32=sin(m.a.w);
  w:V3=v3(local.x*c+local.z*sn+m.a.x,local.y+m.a.y,(0.0f32-local.x)*sn+local.z*c+m.a.z);
  s:StyShade;
  s.pos=sty_clip(w,u,STY_U_LIGHT);
  // The ground casts nothing: it only takes shadow.
  if (sty_is(mesh[o+6],ARCH_M_GROUND)) { s.pos=v4(0.0f32,0.0f32,2.0f32,1.0f32); }
  return s;
}
stylized_shadow_fs :: (s:StyShade) {}

// ---- the grass
// A blade's share of its height under the frame's reveal (1 with none): it sprouts behind the
// front, a little early or late by its own number `rnd` (0 to 1), so the front is ragged and not a line.
sty_blade_reveal :: (x:f32,z:f32,rnd:f32,u:[]f32)->f32 {
  edge:f32=u[STY_U_REVEAL+3];
  if (edge<=0.0f32) {return 1.0f32;} // mutant: equivalent (at an edge of exactly 0 metaverse_style_reveal answers 1 itself and the rise of 1 is 1; the guard only saves the square root)
  rx:f32=x-u[STY_U_REVEAL]; rz:f32=z-u[STY_U_REVEAL+1];
  return metaverse_style_reveal_rise(metaverse_style_reveal(sqrt(rx*rx+rz*rz)+(rnd-0.5f32)*edge*0.5f32,u[STY_U_REVEAL+2],edge));
}
// A blade `tall` metres high rooted at (x, z), parted by the frame's mover: how far its tip is pushed
// along x and z (away from the mover) and the height it keeps (z). Unparted with no mover.
sty_blade_part :: (x:f32,z:f32,tall:f32,u:[]f32)->V3 {
  radius:f32=u[STY_U_MOVER+2];
  if (radius<=0.0f32) {return v3(0.0f32,0.0f32,tall);}
  mx:f32=x-u[STY_U_MOVER]; mz:f32=z-u[STY_U_MOVER+1]; md:f32=sqrt(mx*mx+mz*mz);
  part:f32=metaverse_style_part(md,radius);
  kept:f32=tall*metaverse_style_part_keep(part,0.45f32);
  push:f32=metaverse_style_part_push(part,0.8f32)*kept/fmax(md,0.05f32);
  return v3(mx*push,mz*push,kept);
}
// How far the frame's wind carries that blade's tip along x and z: the engine's one wave and its
// gusts (vegetation.coax: a 12 m wave, gusts 25 m across) round a steady lean half the bend
// downwind. Nothing with no wind.
sty_blade_wind :: (x:f32,z:f32,tall:f32,u:[]f32)->V2 {
  amp:f32=u[STY_U_WIND+2];
  if (amp<=0.0f32) {return v2(0.0f32,0.0f32);} // mutant: equivalent (a bend of exactly 0 gives a wave of 0 and a lean of 0, so sin(0) times the height: 0 either way; the guard only saves the gust's noise)
  t:f32=u[STY_U_SIZE+2]; wx:f32=u[STY_U_WIND]; wz:f32=u[STY_U_WIND+1]; speed:f32=u[STY_U_WIND+3];
  theta:f32=metaverse_style_wind(x*wx+z*wz,metaverse_style_gust(x,z,t,wx,wz,speed,0.04f32),t,amp,12.0f32,speed);
  bend:f32=metaverse_style_bend(theta+amp*0.5f32,tall,1.0f32);
  return v2(wx*bend,wz*bend);
}
// One blade a cell of the field: a tapered triangle rooted on the ground table, turned to face the
// eye, leaning its own way and swaying a little. No blade grows on a path, on paving, on bare
// ground or past the field's reach.
stylized_grass_vs :: (v:u32,i:u32,u:[]f32,mesh:[]f32,objects:[]StyObj,heights:[]f32)->StyBlade {
  o:StyBlade;
  o.pos=v4(0.0f32,0.0f32,2.0f32,1.0f32); o.world=v3(0.0f32,0.0f32,0.0f32); o.colour=v3(0.0f32,0.0f32,0.0f32); o.along=0.0f32;
  cols:u32=wg_max_u(wg_u32_f(u[STY_U_GRASS+3]),1);
  cx:f32=cast(f32)(i%cols); cz:f32=cast(f32)(i/cols);
  cell:f32=u[STY_U_GRASS+2];
  // Where the cell is in the world decides its blade, so the field can move with the eye.
  gx:f32=floor(u[STY_U_GRASS]/cell)+cx; gz:f32=floor(u[STY_U_GRASS+1]/cell)+cz;
  x:f32=(gx+sty_hash2(gx,gz))*cell; z:f32=(gz+sty_hash2(gx+57.0f32,gz+13.0f32))*cell;
  eye:V3=wg_at3(u,STY_U_EYE);
  ex:f32=x-eye.x; ez:f32=z-eye.z; dist:f32=sqrt(ex*ex+ez*ez);
  reach:f32=u[STY_U_GRASS_INFO+3];
  // The table's grass cover: up to 1 how much grows, and above 1 how long it grows.
  grown:f32=sty_table(x,z,1,u,heights);
  cover:f32=fmin(grown,1.0f32)*(1.0f32-sty_table(x,z,2,u,heights));
  clear:f32=smoothstep(0.0f32-0.1f32,0.5f32,sty_path(x,z,u));
  // Tufts: taller where a slow noise says, and thinning out with distance and at the field's edge.
  tuft:f32=0.7f32+0.5f32*sty_noise2(x*1.4f32,z*1.4f32);
  rnd:f32=sty_hash2(gx+7.0f32,gz+91.0f32);
  thin:f32=1.0f32-smoothstep(reach*0.45f32,reach,dist);
  tall:f32=u[STY_U_GRASS_INFO+1]*fmax(grown,1.0f32)*(0.55f32+0.6f32*rnd)*tuft*clear*smoothstep(0.35f32,0.7f32,cover)*smoothstep(0.0f32,0.25f32,thin-rnd*0.55f32+0.2f32);
  // A reveal: blades sprout behind its front. A mover parts them: they lie lower and lean away.
  tall=tall*sty_blade_reveal(x,z,rnd,u);
  parted:V3=sty_blade_part(x,z,tall,u);
  tall=parted.z;
  if (tall<0.03f32) {return o;}
  y:f32=sty_table(x,z,0,u,heights);
  // Across the blade: level, and square to the way to the eye.
  il:f32=1.0f32/fmax(dist,0.001f32);
  wide:f32=u[STY_U_GRASS_INFO+2]*(0.7f32+0.6f32*sty_hash2(gx+3.0f32,gz+41.0f32))*(1.0f32+dist*0.05f32);
  ax:f32=(0.0f32-ez)*il*wide*0.5f32; az:f32=ex*il*wide*0.5f32;
  ang:f32=sty_hash2(gx+19.0f32,gz+5.0f32)*STY_TAU;
  sway:f32=sin(u[STY_U_SIZE+2]*1.3f32+x*0.7f32+z*0.5f32)*0.035f32;
  lean:f32=tall*(0.12f32+0.3f32*sty_hash2(gx+23.0f32,gz+71.0f32));
  w:V3=v3(x,y,z);
  if (v==0) { w=v3(x-ax,y,z-az); }
  else if (v==1) { w=v3(x+ax,y,z+az); }
  else {
    blow:V2=sty_blade_wind(x,z,tall,u);
    w=v3(x+cos(ang)*lean+sway+blow.x+parted.x,y+tall,z+sin(ang)*lean+blow.y+parted.y); o.along=1.0f32;
  }
  o.world=v3(x,y,z);
  o.colour=scale3(sty_grass_colour(x,z,o.along,u),0.88f32+0.24f32*rnd);
  o.pos=sty_clip(w,u,STY_U_VIEW);
  return o;
}
// How much of a low sun a blade lets through to an eye that looks toward the sun: `cos_t` the cosine
// between the eye's ray and the way to the sun, `sun_up` the sun's height (its sine), `along` how far
// up the blade (0 root, 1 tip). Most at the tip, looking at a sun just over the horizon (4); none looking
// away from it, at the root, or under a sun 30 degrees up. A blade is thin: a low sun behind a
// meadow lights it from within, which is the rim of light a field has at dawn.
sty_grass_through :: (cos_t:f32,sun_up:f32,along:f32)->f32 {
  toward:f32=saturate(cos_t*0.5f32+0.5f32);
  low:f32=1.0f32-smoothstep(0.05f32,0.5f32,sun_up);
  return 4.0f32*toward*toward*toward*low*along*along*smoothstep(0.0f32-0.04f32,0.03f32,sun_up);
}
// A blade's light, hazed.
sty_grass_light :: (g:StyBlade,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V3 {
  up:V3=v3(0.0f32,1.0f32,0.0f32);
  shadow:f32=sty_shadow(g.world,up,u,shadow_map,shadow_cmp);
  // A blade stands in its neighbours' shade at the root and in the sun at its tip.
  root:f32=0.78f32+0.22f32*g.along;
  sun:V3=wg_at3(u,STY_U_SUN);
  albedo:V3=sty_decode(g.colour);
  c:V3=scale3(sty_lit(albedo,up,sun.y,shadow,u),root);
  if (u[STY_U_AIR]>0.0f32) {
    // with air, a low sun comes through the blades toward the eye, in the sun's own colour there
    to:V3=normalize3(sub3(g.world,wg_at3(u,STY_U_EYE)));
    through:f32=sty_grass_through(dot3(to,sun),sun.y,g.along)*mix(1.0f32,shadow,u[STY_U_SUN+3]);
    c=add3(c,scale3(mul3(albedo,wg_at3(u,STY_U_SUN_COLOUR)),through));
  }
  return sty_haze(c,g.world,u);
}
stylized_grass_fs :: (g:StyBlade,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->V4 {
  c:V3=sty_present(sty_grass_light(g,u,shadow_map,shadow_cmp),u);
  return v4(c.x,c.y,c.z,1.0f32);
}
stylized_film_grass_fs :: (g:StyBlade,u:[]f32,shadow_map:TexDepth,shadow_cmp:SamplerCompare)->StyFilm {return sty_film(sty_grass_light(g,u,shadow_map,shadow_cmp),u);}

#test "the bands of light rise from shade to sun, with a half tone between" {
  #assert sty_bands(-1.0f32,0.3f32)==0.0f32 && sty_bands(1.0f32,0.3f32)==1.0f32;
  half:f32=sty_bands(0.32f32,0.3f32);
  #assert half>0.69f32 && half<0.71f32 && sty_bands(0.1f32,0.3f32)<half && sty_bands(0.6f32,0.3f32)>half;
  // Hard edges: a cel's two steps.
  #assert sty_bands(0.1f32,0.02f32)==0.7f32 && sty_bands(0.5f32,0.02f32)==1.0f32 && sty_bands(-0.1f32,0.02f32)==0.0f32;
}
#test "haze leaves what is near alone and hides no more than its most" {
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_HAZE]=0.5f32; u[STY_U_HAZE+1]=0.6f32; u[STY_U_HAZE+2]=0.7f32; u[STY_U_HAZE+3]=0.02f32;
  u[STY_U_HAZE_INFO]=10.0f32; u[STY_U_HAZE_INFO+1]=0.9f32;
  near:V3=sty_haze(v3(1.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,-5.0f32),u[..]);
  #assert near.x==1.0f32 && near.y==0.0f32;
  mid:V3=sty_haze(v3(1.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,-60.0f32),u[..]);
  far:V3=sty_haze(v3(1.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,-5000.0f32),u[..]);
  hx:f32=pow(0.5f32,2.2f32); hy:f32=pow(0.6f32,2.2f32);
  #assert mid.x<1.0f32 && mid.x>far.x && abs(far.x-(0.1f32+0.9f32*hx))<0.001f32 && abs(far.y-0.9f32*hy)<0.001f32;
}
#test "a path is dirt on it and grass beside it, and the grass is greener at its root than its tip" {
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_PATH_INFO]=1.0f32; u[STY_U_PATH_INFO+1]=0.3f32;
  u[STY_U_PATH]=0.0f32; u[STY_U_PATH+1]=0.0f32; u[STY_U_PATH+2]=0.0f32; u[STY_U_PATH+3]=-40.0f32; u[STY_U_PATH+4]=2.5f32;
  #assert sty_path_share(0.0f32,-20.0f32,u[..])==1.0f32 && sty_path_share(9.0f32,-20.0f32,u[..])==0.0f32;
  #assert sty_path(0.0f32,-20.0f32,u[..])<0.0f32-1.5f32 && sty_path(9.0f32,-20.0f32,u[..])>5.0f32;
  on:V3=sty_ground(v3(0.0f32,0.0f32,-20.0f32),1.0f32,0.0f32,u[..]); off:V3=sty_ground(v3(9.0f32,0.0f32,-20.0f32),1.0f32,0.0f32,u[..]);
  #assert on.x>on.y && on.y>on.z && off.y>off.x && off.y>off.z;
  bare:V3=sty_ground(v3(9.0f32,0.0f32,-20.0f32),0.0f32,0.0f32,u[..]); #assert bare.x>bare.y;
  u[STY_U_PATH_INFO+2]=0.5f32;
  root:V3=sty_grass_colour(3.0f32,4.0f32,0.0f32,u[..]); tip:V3=sty_grass_colour(3.0f32,4.0f32,1.0f32,u[..]);
  lush:[STY_UNIFORM_FLOATS]f32; dry:[STY_UNIFORM_FLOATS]f32; dry[STY_U_PATH_INFO+2]=1.0f32;
  #assert sty_meadow(3.0f32,4.0f32,dry[..])>sty_meadow(3.0f32,4.0f32,lush[..]) && sty_grass_colour(3.0f32,4.0f32,1.0f32,dry[..]).x>sty_grass_colour(3.0f32,4.0f32,1.0f32,lush[..]).x;
  #assert tip.y>root.y && tip.x>root.x && root.y>root.x;
  // No table: grass everywhere, flat.
  none:[4]f32;
  #assert sty_table(1.0f32,1.0f32,1,u[..],none[..])==1.0f32 && sty_table(1.0f32,1.0f32,0,u[..],none[..])==0.0f32;
}
#test "every material has a colour, a tint replaces it, and windows and lamps give their own light" {
  u:[STY_UNIFORM_FLOATS]f32;
  s:StyS; s.world=v3(1.3f32,2.1f32,-4.2f32); s.uv=v2(0.37f32,0.61f32); s.tint=v3(0.0f32,0.0f32,0.0f32); s.normal=v3(0.0f32,1.0f32,0.0f32);
  for k:1..<ARCH_M_COUNT {
    s.info=v4(cast(f32)k,0.0f32,0.0f32,0.0f32);
    m:StySurface=sty_surface(s,u[..]);
    #assert m.albedo.x>=0.0f32 && m.albedo.x<=1.3f32 && m.albedo.y>=0.0f32 && m.albedo.z>=0.0f32 && m.albedo.x+m.albedo.y+m.albedo.z>0.05f32;
    lights:bool=k==ARCH_M_WINDOW||k==ARCH_M_GLOW||k==ARCH_M_STAINED||k==ARCH_M_ROSE;
    #assert (m.glow.x>0.0f32)==lights;
  }
  s.info=v4(cast(f32)ARCH_M_CLOTH,0.0f32,0.0f32,0.0f32); s.tint=v3(0.1f32,0.2f32,0.9f32);
  blue:StySurface=sty_surface(s,u[..]); #assert blue.albedo.z==0.9f32 && blue.albedo.x==0.1f32;
  s.info=v4(cast(f32)ARCH_M_ROOF,0.0f32,0.0f32,0.0f32); s.tint=v3(0.0f32,0.0f32,0.0f32);
  red:StySurface=sty_surface(s,u[..]); #assert red.albedo.x>red.albedo.y && red.albedo.y>red.albedo.z;
}
#test "a heaped cloud is white inside its puffs, sky outside them, and flat at its base" {
  // In its own measure: inside near the middle of its base puffs, outside well above and well beside it.
  #assert sty_cumulus(0.0f32,0.3f32,1.6f32,1.0f32)>0.05f32 && sty_cumulus(0.0f32,1.6f32,1.6f32,1.0f32)<0.0f32 && sty_cumulus(3.0f32,0.3f32,1.6f32,1.0f32)<0.0f32;
  #assert sty_cumulus(0.0f32,0.0f32-0.05f32,1.6f32,1.0f32)<0.0f32;
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_ZENITH]=0.3f32; u[STY_U_ZENITH+1]=0.5f32; u[STY_U_ZENITH+2]=0.9f32;
  u[STY_U_HORIZON]=0.7f32; u[STY_U_HORIZON+1]=0.8f32; u[STY_U_HORIZON+2]=0.95f32; u[STY_U_HORIZON+3]=1.0f32;
  u[STY_U_SUN+1]=1.0f32; u[STY_U_EYE+3]=900.0f32;
  clear:V3=sty_sky(normalize3(v3(0.0f32,0.42f32,0.0f32-1.0f32)),u[..]);
  u[STY_U_CUMULUS]=0.0f32; u[STY_U_CUMULUS+1]=0.3f32; u[STY_U_CUMULUS+2]=0.5f32; u[STY_U_CUMULUS+3]=0.3f32;
  cloud:V3=sty_sky(normalize3(v3(0.0f32,0.42f32,0.0f32-1.0f32)),u[..]);
  beside:V3=sty_sky(normalize3(v3(1.0f32,0.42f32,0.0f32)),u[..]);
  #assert cloud.x>clear.x+0.2f32 && cloud.x>0.75f32 && abs(beside.x-clear.x)<0.001f32;
}
#test "flags tile the ground, a bell and a star are where they are drawn, and leaves take four tones" {
  f:V3=sty_flags(3.3f32,7.7f32); #assert f.x<=f.y && f.x<1.2f32 && f.z>=0.0f32 && f.z<1.0f32;
  #assert sty_bell(0.0f32,0.0f32)==1.0f32 && sty_bell(0.3f32,0.0f32)==0.0f32 && sty_bell(0.0f32,0.0f32-0.145f32)==1.0f32;
  #assert sty_star(0.0f32,0.0f32,0.07f32)==1.0f32 && sty_star(0.06f32,0.0f32,0.07f32)==1.0f32 && sty_star(0.04f32,0.04f32,0.07f32)==0.0f32;
  u:[STY_UNIFORM_FLOATS]f32; u[STY_U_SUN+1]=1.0f32;
  s:StyS; s.world=v3(1.0f32,5.0f32,2.0f32); s.tint=v3(0.3f32,0.5f32,0.2f32); s.info=v4(cast(f32)ARCH_M_LEAF,0.0f32,0.0f32,0.0f32);
  s.normal=v3(0.0f32,0.0f32-1.0f32,0.0f32); s.uv=v2(0.0f32,0.1f32); shade:StySurface=sty_surface(s,u[..]);
  s.normal=v3(0.0f32,1.0f32,0.0f32); s.uv=v2(1.0f32,0.9f32); bright:StySurface=sty_surface(s,u[..]);
  s.uv=v2(0.5f32,0.0f32-1.0f32); heart:StySurface=sty_surface(s,u[..]);
  #assert shade.albedo.y<0.36f32 && bright.albedo.y>0.66f32 && heart.albedo.y<0.46f32 && heart.albedo.y>shade.albedo.y && bright.albedo.x>bright.albedo.z;
  // A tuft's own number moves a leaf's light by a twentieth at most: tones lie in broad patches.
  s.normal=v3(1.0f32,0.0f32,0.0f32); s.uv=v2(0.62f32,0.0f32); one:StySurface=sty_surface(s,u[..]);
  s.uv=v2(0.62f32,0.99f32); other:StySurface=sty_surface(s,u[..]); #assert one.albedo.y==other.albedo.y;
}
#test "the sky is its zenith overhead, its horizon at the horizon, and haze below it" {
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_ZENITH]=0.3f32; u[STY_U_ZENITH+1]=0.5f32; u[STY_U_ZENITH+2]=0.9f32; u[STY_U_ZENITH+3]=0.0f32;
  u[STY_U_HORIZON]=0.7f32; u[STY_U_HORIZON+1]=0.8f32; u[STY_U_HORIZON+2]=0.95f32; u[STY_U_HORIZON+3]=1.0f32;
  u[STY_U_HAZE]=0.6f32; u[STY_U_HAZE+1]=0.7f32; u[STY_U_HAZE+2]=0.8f32;
  u[STY_U_SUN]=0.0f32; u[STY_U_SUN+1]=1.0f32;
  top:V3=sty_sky(v3(0.0f32,1.0f32,0.0f32),u[..]); #assert abs(top.x-0.3f32)<0.001f32 && abs(top.z-0.9f32)<0.001f32;
  low:V3=sty_sky(v3(0.0f32,0.0f32,-1.0f32),u[..]); #assert abs(low.x-0.7f32)<0.001f32;
  under:V3=sty_sky(v3(0.0f32,-0.5f32,-0.8f32),u[..]); #assert abs(under.x-0.6f32)<0.001f32;
}
#test "a river is clear at its shore, blue in its depth, white where it churns, and a rainbow runs violet to red" {
  blue:V3=v3(0.08f32,0.36f32,0.8f32);
  shore:V4=sty_river(blue,3.0f32,1.0f32,3.0f32,1.0f32,0.015f32,0.0f32,0.0f32);
  #assert shore.x>0.9f32 && shore.y>0.9f32 && shore.w>0.5f32;
  dry:V4=sty_river(blue,3.0f32,1.0f32,3.0f32,1.0f32,0.0f32-0.5f32,0.0f32,0.0f32); #assert dry.w==0.0f32;
  // Deep water away from a ripple's line: blue, and nearly solid.
  deep:V4=v4(0.0f32,0.0f32,0.0f32,0.0f32); found:bool=false;
  for i:0..<40 {
    q:V4=sty_river(blue,cast(f32)i*0.37f32,0.3f32,cast(f32)i*0.37f32,0.3f32,2.0f32,0.0f32,0.0f32);
    #assert q.w>0.9f32 && q.w<=0.97f32 && q.z>=q.x;
    if (!found&&q.z>q.x+0.3f32) { deep=q; found=true; }
  }
  #assert found && deep.z>0.6f32;
  foam:V4=sty_river(blue,3.0f32,1.0f32,3.0f32,1.0f32,2.0f32,1.0f32,0.0f32); #assert foam.x>0.95f32 && foam.w>0.95f32;
  // It moves: the same place a second later is not the same.
  moved:bool=false;
  for i:0..<20 {
    q0:V4=sty_river(blue,cast(f32)i*0.41f32,0.3f32,0.0f32,0.0f32,2.0f32,0.0f32,0.0f32); q1:V4=sty_river(blue,cast(f32)i*0.41f32,0.3f32,0.0f32,0.0f32,2.0f32,0.0f32,1.0f32);
    if (q0.x!=q1.x) { moved=true; }
  }
  #assert moved;
  edge:V4=sty_falls(blue,0.0f32,5.0f32,0.0f32); mid:V4=sty_falls(blue,0.5f32,5.0f32,0.0f32); #assert edge.w<0.2f32 && mid.w>0.7f32 && mid.z>=0.8f32;
  violet:V3=sty_spectrum(0.0f32); green:V3=sty_spectrum(0.56f32); red:V3=sty_spectrum(1.0f32);
  #assert violet.z>0.9f32 && violet.y<0.1f32 && green.y>0.9f32 && green.x<0.4f32 && red.x>0.9f32 && red.y<0.1f32 && red.z<0.1f32;
}
#test "wet parts hide what is behind them by their own measure, and a cliff is grey rock under moss" {
  u:[STY_UNIFORM_FLOATS]f32; none:[4]f32; u[STY_U_EYE+2]=10.0f32;
  s:StyS; s.world=v3(0.0f32,1.0f32,0.0f32); s.uv=v2(0.5f32,0.5f32); s.tint=v3(0.0f32,0.0f32,0.0f32); s.normal=v3(0.0f32,0.0f32,1.0f32);
  // With no table the ground lies at 0: a metre of water.
  s.info=v4(cast(f32)ARCH_M_RIVER,0.0f32,0.0f32,0.0f32); river:V4=sty_wet(s,u[..],none[..]); #assert river.w>0.9f32;
  s.info=v4(cast(f32)ARCH_M_MIST,0.0f32,0.0f32,0.0f32); puff:V4=sty_wet(s,u[..],none[..]);
  s.normal=v3(1.0f32,0.0f32,0.0f32); rim:V4=sty_wet(s,u[..],none[..]); #assert puff.w>0.08f32 && puff.w<0.25f32 && rim.w<0.02f32;
  s.info=v4(cast(f32)ARCH_M_RAINBOW,0.0f32,0.0f32,0.0f32); bow:V4=sty_wet(s,u[..],none[..]);
  s.uv=v2(0.5f32,0.0f32); end:V4=sty_wet(s,u[..],none[..]); #assert bow.w>0.4f32 && bow.w<0.7f32 && end.w<0.01f32;
  s.info=v4(cast(f32)ARCH_M_ASHLAR,0.0f32,0.0f32,0.0f32); wall:V4=sty_wet(s,u[..],none[..]); #assert wall.w==1.0f32;
  s.info=v4(cast(f32)ARCH_M_CLIFF,0.0f32,0.0f32,0.0f32); face:StySurface=sty_surface(s,u[..]);
  s.normal=v3(0.0f32,1.0f32,0.0f32); top:StySurface=sty_surface(s,u[..]);
  #assert abs(face.albedo.x-face.albedo.z)<0.15f32 && face.albedo.z>=face.albedo.x && top.albedo.y>top.albedo.x+0.08f32 && top.albedo.y>top.albedo.z+0.15f32;
}
#test "a reveal: grass stands behind its front and the bare floor lies ahead of it; no reveal, all grass" {
  u:[STY_UNIFORM_FLOATS]f32;
  #assert sty_reveal_at(50.0f32,0.0f32,u[..])==1.0f32 && sty_floor(v3(50.0f32,0.0f32,3.0f32),u[..]).y==0.0f32;
  u[STY_U_REVEAL]=2.0f32; u[STY_U_REVEAL+1]=0.0f32-1.0f32; u[STY_U_REVEAL+2]=10.0f32; u[STY_U_REVEAL+3]=2.0f32;
  #assert sty_reveal_at(2.0f32,0.0f32-1.0f32,u[..])==1.0f32 && sty_reveal_at(2.0f32+7.9f32,0.0f32-1.0f32,u[..])==1.0f32;
  #assert sty_reveal_at(2.0f32,0.0f32-1.0f32-10.0f32,u[..])==0.0f32 && sty_reveal_at(2.0f32+30.0f32,0.0f32-1.0f32,u[..])==0.0f32;
  #assert abs(sty_reveal_at(2.0f32-9.0f32,0.0f32-1.0f32,u[..])-0.5f32)<0.001f32 && abs(sty_reveal_at(2.0f32,8.0f32,u[..])-0.5f32)<0.001f32;
  // measured round its own centre, not the origin
  #assert sty_reveal_at(0.0f32-7.9f32,0.0f32-1.0f32,u[..])<0.01f32 && sty_reveal_at(11.4f32,0.0f32-1.0f32,u[..])<1.0f32 && sty_reveal_at(11.4f32,0.0f32-1.0f32,u[..])>0.0f32;
  #assert sty_floor(v3(2.0f32,0.0f32,0.0f32-1.0f32),u[..]).y==0.0f32 && sty_floor(v3(40.0f32,0.0f32,0.0f32-1.0f32),u[..]).y==1.0f32;
}
#test "the bare floor's grid: a line on each square's edge a pixel wide, a second grid over it, gone when squares are finer than pixels" {
  // on a line, between lines, and a pixel and a half off it
  #assert sty_grid_axis(3.0f32,1.0f32,0.01f32)==1.0f32 && sty_grid_axis(3.5f32,1.0f32,0.01f32)==0.0f32 && sty_grid_axis(0.0f32-2.0f32,1.0f32,0.01f32)==1.0f32;
  #assert sty_grid_axis(3.004f32,1.0f32,0.01f32)==1.0f32 && sty_grid_axis(3.016f32,1.0f32,0.01f32)==0.0f32;
  near:f32=sty_grid_axis(3.01f32,1.0f32,0.01f32); #assert near>0.3f32 && near<0.7f32;
  // squares of 2: lines at even places only
  #assert sty_grid_axis(4.0f32,2.0f32,0.01f32)==1.0f32 && sty_grid_axis(3.0f32,2.0f32,0.01f32)==0.0f32;
  // a pixel spanning a sixth of a square is the last full line; past it they fade, to nothing
  #assert sty_grid_axis(3.0f32,1.0f32,1.0f32/6.0f32)>0.999f32 && abs(sty_grid_axis(3.0f32,1.0f32,1.0f32/3.0f32)-0.5f32)<0.001f32 && sty_grid_axis(3.0f32,1.0f32,100.0f32)<0.002f32;
  u:[STY_UNIFORM_FLOATS]f32;
  #assert sty_floor_lines(3.0f32,0.5f32,0.01f32,0.01f32,u[..])==0.0f32;
  u[STY_U_BARE+3]=1.0f32;
  #assert sty_floor_lines(3.0f32,0.5f32,0.01f32,0.01f32,u[..])==1.0f32 && sty_floor_lines(3.5f32,7.0f32,0.01f32,0.01f32,u[..])==1.0f32 && sty_floor_lines(3.5f32,7.5f32,0.01f32,0.01f32,u[..])==0.0f32;
  u[STY_U_BARE_LINE+3]=4.0f32;
  #assert sty_floor_lines(4.0f32,0.5f32,0.01f32,0.01f32,u[..])==2.0f32 && sty_floor_lines(3.0f32,0.5f32,0.01f32,0.01f32,u[..])==1.0f32 && sty_floor_lines(3.5f32,8.0f32,0.01f32,0.01f32,u[..])==2.0f32;
  u[STY_U_BARE_LINE+3]=0.5f32; #assert sty_floor_lines(4.0f32,0.5f32,0.01f32,0.01f32,u[..])==1.0f32;
  // a second grid a square apart lies on the first: twice the line
  u[STY_U_BARE_LINE+3]=1.0f32; #assert sty_floor_lines(3.0f32,0.5f32,0.01f32,0.01f32,u[..])==2.0f32;
  // just short of a line and just past it are the same distance from it, either side of the origin
  #assert abs(sty_grid_axis(2.99f32,1.0f32,0.01f32)-sty_grid_axis(3.01f32,1.0f32,0.01f32))<0.001f32 && abs(sty_grid_axis(0.0f32-0.01f32,1.0f32,0.01f32)-sty_grid_axis(0.01f32,1.0f32,0.01f32))<0.001f32;
  #assert sty_grid_axis(2.99f32,1.0f32,0.01f32)>0.3f32 && sty_grid_axis(2.99f32,1.0f32,0.01f32)<0.7f32 && sty_grid_axis(2.75f32,1.0f32,0.01f32)==0.0f32 && sty_grid_axis(3.25f32,1.0f32,0.01f32)==0.0f32;
  // squares half a metre wide: a line at the half
  #assert sty_grid_axis(3.5f32,0.5f32,0.01f32)==1.0f32 && sty_grid_axis(3.25f32,0.5f32,0.01f32)==0.0f32;
}
#test "the bare floor replaces only ground the reveal has not reached, and its lines are their own light" {
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_BARE]=0.1f32; u[STY_U_BARE+1]=0.2f32; u[STY_U_BARE+2]=0.3f32; u[STY_U_BARE_LINE]=0.5f32; u[STY_U_BARE_LINE+1]=0.6f32; u[STY_U_BARE_LINE+2]=0.7f32;
  m:StySurface; m.albedo=v3(0.9f32,0.8f32,0.7f32); m.glow=v3(0.0f32,0.0f32,0.0f32);
  ground:f32=cast(f32)ARCH_M_GROUND;
  // wholly bare, on a line: the floor's colour, the line's light
  bare:StySurface=sty_floor_over(m,ground,v2(1.0f32,1.0f32),u[..]);
  #assert abs(bare.albedo.x-0.1f32)<0.0001f32 && abs(bare.albedo.y-0.2f32)<0.0001f32 && abs(bare.albedo.z-0.3f32)<0.0001f32 && abs(bare.glow.x-0.5f32)<0.0001f32 && abs(bare.glow.y-0.6f32)<0.0001f32 && abs(bare.glow.z-0.7f32)<0.0001f32;
  // off a line: no light; half bare, on a line: half of each
  off:StySurface=sty_floor_over(m,ground,v2(0.0f32,1.0f32),u[..]); #assert off.glow.x==0.0f32 && abs(off.albedo.x-0.1f32)<0.0001f32;
  half:StySurface=sty_floor_over(m,ground,v2(1.0f32,0.5f32),u[..]); #assert abs(half.albedo.x-0.5f32)<0.0001f32 && abs(half.albedo.z-0.5f32)<0.0001f32 && abs(half.glow.x-0.25f32)<0.0001f32 && abs(half.glow.z-0.35f32)<0.0001f32;
  // where both grids' lines cross the light is twice a line's
  both:StySurface=sty_floor_over(m,ground,v2(2.0f32,1.0f32),u[..]); #assert abs(both.glow.y-1.2f32)<0.0001f32;
  // the reveal has passed (or there is none): untouched; and so is anything that is not ground
  grown:StySurface=sty_floor_over(m,ground,v2(1.0f32,0.0f32),u[..]); #assert grown.albedo.x==0.9f32 && grown.albedo.y==0.8f32 && grown.glow.x==0.0f32;
  wall:StySurface=sty_floor_over(m,cast(f32)ARCH_M_ASHLAR,v2(1.0f32,1.0f32),u[..]); #assert wall.albedo.x==0.9f32 && wall.albedo.z==0.7f32 && wall.glow.y==0.0f32;
  plaster:StySurface=sty_floor_over(m,cast(f32)ARCH_M_PLASTER,v2(1.0f32,1.0f32),u[..]); #assert plaster.albedo.x==0.9f32 && plaster.glow.x==0.0f32;
}
#test "a blade under a reveal sprouts behind the front, ragged by its own number; with none it stands" {
  u:[STY_UNIFORM_FLOATS]f32;
  #assert sty_blade_reveal(50.0f32,3.0f32,0.5f32,u[..])==1.0f32;
  u[STY_U_REVEAL]=2.0f32; u[STY_U_REVEAL+1]=0.0f32-1.0f32; u[STY_U_REVEAL+2]=10.0f32; u[STY_U_REVEAL+3]=2.0f32;
  // well behind the front all of it, at and past it none (round the reveal's own centre, on x and on z)
  #assert sty_blade_reveal(2.0f32,0.0f32-1.0f32,0.5f32,u[..])==1.0f32 && sty_blade_reveal(2.0f32+7.0f32,0.0f32-1.0f32,0.5f32,u[..])==1.0f32 && sty_blade_reveal(2.0f32,0.0f32-1.0f32-7.0f32,0.5f32,u[..])==1.0f32;
  #assert sty_blade_reveal(2.0f32+10.5f32,0.0f32-1.0f32,0.5f32,u[..])==0.0f32 && sty_blade_reveal(2.0f32,0.0f32-1.0f32+10.5f32,0.5f32,u[..])==0.0f32 && sty_blade_reveal(0.0f32-8.5f32,0.0f32-1.0f32,0.5f32,u[..])==0.0f32;
  // in the middle of the front: half revealed, three quarters of its height (it sprouts fast)
  #assert abs(sty_blade_reveal(2.0f32+9.0f32,0.0f32-1.0f32,0.5f32,u[..])-0.75f32)<0.001f32;
  // its own number moves it half an edge either way: an early blade is up where a late one is not yet
  early:f32=sty_blade_reveal(2.0f32+9.0f32,0.0f32-1.0f32,0.0f32,u[..]); late:f32=sty_blade_reveal(2.0f32+9.0f32,0.0f32-1.0f32,1.0f32,u[..]);
  #assert early>0.75f32 && late<0.75f32 && abs(early-sty_blade_reveal(2.0f32+8.5f32,0.0f32-1.0f32,0.5f32,u[..]))<0.0001f32 && abs(late-sty_blade_reveal(2.0f32+9.5f32,0.0f32-1.0f32,0.5f32,u[..]))<0.0001f32;
  // a wider front moves a blade's own share with it
  u[STY_U_REVEAL+3]=4.0f32; #assert abs(sty_blade_reveal(2.0f32+8.0f32,0.0f32-1.0f32,0.0f32,u[..])-sty_blade_reveal(2.0f32+7.0f32,0.0f32-1.0f32,0.5f32,u[..]))<0.0001f32;
}
#test "a mover parts the grass: blades by it lie lower and lean away from it, and beyond its radius they stand" {
  u:[STY_UNIFORM_FLOATS]f32;
  none:V3=sty_blade_part(1.0f32,2.0f32,0.4f32,u[..]); #assert none.x==0.0f32 && none.y==0.0f32 && none.z==0.4f32;
  // (no radius is no mover, even for a blade rooted exactly where the mover's place is written)
  u[STY_U_MOVER]=1.0f32; u[STY_U_MOVER+1]=2.0f32; same:V3=sty_blade_part(1.0f32,2.0f32,0.4f32,u[..]); #assert same.z==0.4f32 && same.x==0.0f32;
  u[STY_U_MOVER]=3.0f32; u[STY_U_MOVER+1]=0.0f32-2.0f32; u[STY_U_MOVER+2]=0.8f32;
  // beyond its radius: untouched
  far:V3=sty_blade_part(3.0f32+0.9f32,0.0f32-2.0f32,0.4f32,u[..]); #assert far.x==0.0f32 && far.y==0.0f32 && far.z==0.4f32;
  away:V3=sty_blade_part(3.0f32,0.0f32-2.0f32+5.0f32,0.4f32,u[..]); #assert away.z==0.4f32 && away.y==0.0f32;
  // half way in, on its +x side: 0.725 of its height, pushed +x by 0.4 of that, not along z
  east:V3=sty_blade_part(3.4f32,0.0f32-2.0f32,0.4f32,u[..]);
  #assert abs(east.z-0.29f32)<0.0001f32 && abs(east.x-0.116f32)<0.0001f32 && abs(east.y)<0.0001f32;
  // on its -z side it is pushed -z; on its -x side, -x: always away
  north:V3=sty_blade_part(3.0f32,0.0f32-2.4f32,0.4f32,u[..]); #assert abs(north.y+0.116f32)<0.0001f32 && abs(north.x)<0.0001f32 && abs(north.z-0.29f32)<0.0001f32;
  west:V3=sty_blade_part(2.6f32,0.0f32-2.0f32,0.4f32,u[..]); #assert abs(west.x+0.116f32)<0.0001f32;
  // diagonally: along both, by the same rule
  diag:V3=sty_blade_part(3.3f32,0.0f32-1.6f32,0.4f32,u[..]); #assert diag.x>0.0f32 && diag.y>0.0f32 && abs(diag.y/diag.x-4.0f32/3.0f32)<0.001f32 && abs(diag.z-0.4f32*(1.0f32-0.55f32*0.375f32))<0.0001f32;
  // nearer, lower and further over; right at the mover it lies at 0.45 of its height
  near_:V3=sty_blade_part(3.1f32,0.0f32-2.0f32,0.4f32,u[..]); #assert near_.z<east.z && near_.x>east.x;
  on:V3=sty_blade_part(3.0f32,0.0f32-2.0f32,0.4f32,u[..]); #assert abs(on.z-0.18f32)<0.0001f32 && on.x==0.0f32 && on.y==0.0f32;
  // very near, the push is bounded: no further than 0.8 of a blade's own kept height for each 0.05 m
  close:V3=sty_blade_part(3.01f32,0.0f32-2.0f32,0.4f32,u[..]); #assert close.x>0.0f32 && close.x<0.8f32*close.z*0.01f32/0.05f32+0.0001f32 && abs(close.x-0.8f32*(1.0f32-0.01f32/0.8f32)*close.z*0.01f32/0.05f32)<0.0001f32;
  // a taller blade is pushed further
  tall:V3=sty_blade_part(3.4f32,0.0f32-2.0f32,0.8f32,u[..]); #assert abs(tall.x-0.232f32)<0.0001f32 && abs(tall.z-0.58f32)<0.0001f32;
}
#test "the wind carries a blade's tip downwind, more for a taller blade, in waves that pass; none with no wind" {
  u:[STY_UNIFORM_FLOATS]f32;
  still:V2=sty_blade_wind(4.0f32,7.0f32,0.4f32,u[..]); #assert still.x==0.0f32 && still.y==0.0f32;
  u[STY_U_WIND]=1.0f32; u[STY_U_WIND+1]=0.0f32; u[STY_U_WIND+2]=0.3f32; u[STY_U_WIND+3]=3.0f32;
  // blowing +x: never against the wind (its lean is half the bend, the wave at most the bend back), never across it
  lo:f32=10.0f32; hi:f32=0.0f32-10.0f32;
  for i:0..<200 {
    b:V2=sty_blade_wind(cast(f32)i*0.37f32,cast(f32)i*0.11f32,0.4f32,u[..]);
    #assert b.y==0.0f32 && b.x>=sin(0.0f32-0.15001f32)*0.4f32 && b.x<=sin(0.45001f32)*0.4f32;
    lo=fmin(lo,b.x); hi=fmax(hi,b.x);
  }
  // the field is not bent as one: blades differ, and mostly lean downwind
  #assert hi-lo>0.05f32 && hi>0.08f32 && lo+hi>0.0f32;
  // exactly the engine's wave, gust and bend
  here:V2=sty_blade_wind(4.0f32,7.0f32,0.4f32,u[..]);
  theta:f32=metaverse_style_wind(4.0f32,metaverse_style_gust(4.0f32,7.0f32,0.0f32,1.0f32,0.0f32,3.0f32,0.04f32),0.0f32,0.3f32,12.0f32,3.0f32);
  #assert abs(here.x-metaverse_style_bend(theta+0.15f32,0.4f32,1.0f32))<0.00001f32;
  // a blade twice as tall is carried twice as far
  twice:V2=sty_blade_wind(4.0f32,7.0f32,0.8f32,u[..]); #assert abs(twice.x-2.0f32*here.x)<0.00001f32;
  // it moves with the clock: a second later the same blade is elsewhere, and the wave has gone 3 m downwind
  u[STY_U_SIZE+2]=1.0f32; later:V2=sty_blade_wind(4.0f32,7.0f32,0.4f32,u[..]); moved:V2=sty_blade_wind(7.0f32,7.0f32,0.4f32,u[..]);
  #assert abs(later.x-here.x)>0.001f32 && abs(moved.x-here.x)<0.0001f32;
  // across z it blows along z; and along both by its unit way
  u[STY_U_SIZE+2]=0.0f32; u[STY_U_WIND]=0.0f32; u[STY_U_WIND+1]=1.0f32;
  south:V2=sty_blade_wind(7.0f32,4.0f32,0.4f32,u[..]); #assert south.x==0.0f32 && abs(south.y-metaverse_style_bend(metaverse_style_wind(4.0f32,metaverse_style_gust(7.0f32,4.0f32,0.0f32,0.0f32,1.0f32,3.0f32,0.04f32),0.0f32,0.3f32,12.0f32,3.0f32)+0.15f32,0.4f32,1.0f32))<0.00001f32 && abs(south.y)>0.0001f32;
  u[STY_U_WIND]=0.6f32; u[STY_U_WIND+1]=0.8f32;
  both:V2=sty_blade_wind(4.0f32,7.0f32,0.4f32,u[..]); #assert abs(both.y*0.6f32-both.x*0.8f32)<0.00001f32 && abs(both.x)>0.0001f32;
  along:f32=4.0f32*0.6f32+7.0f32*0.8f32;
  #assert abs(both.x-0.6f32*metaverse_style_bend(metaverse_style_wind(along,metaverse_style_gust(4.0f32,7.0f32,0.0f32,0.6f32,0.8f32,3.0f32,0.04f32),0.0f32,0.3f32,12.0f32,3.0f32)+0.15f32,0.4f32,1.0f32))<0.00001f32;
  // a stronger wind bends it further; a faster one moves its waves
  u[STY_U_WIND+2]=0.6f32; strong:V2=sty_blade_wind(4.0f32,7.0f32,0.4f32,u[..]); #assert abs(strong.x)>abs(both.x);
  u[STY_U_WIND+2]=0.3f32; u[STY_U_WIND+3]=6.0f32; u[STY_U_SIZE+2]=1.0f32; fast:V2=sty_blade_wind(4.0f32,7.0f32,0.4f32,u[..]);
  u[STY_U_WIND+3]=3.0f32; slow:V2=sty_blade_wind(4.0f32,7.0f32,0.4f32,u[..]); #assert abs(fast.x-slow.x)>0.0001f32;
}

#test "the sun's disc is whole inside its radius, gone outside it, soft at its edge, and red low and white-gold high" {
  r:f32=0.03f32;
  // dead on the sun, and well inside the disc
  #assert sty_sun_disc(1.0f32,r,0.001f32)==1.0f32 && sty_sun_disc(cos(0.02f32),r,0.001f32)==1.0f32;
  // outside it, and far from it
  #assert sty_sun_disc(cos(0.04f32),r,0.001f32)==0.0f32 && sty_sun_disc(0.0f32,r,0.001f32)==0.0f32 && sty_sun_disc(0.0f32-1.0f32,r,0.001f32)==0.0f32;
  // on its edge it is half, and the edge is as wide as it is told
  edge:f32=sty_sun_disc(cos(r),r,0.004f32); #assert abs(edge-0.5f32)<0.03f32;
  inner:f32=sty_sun_disc(cos(r-0.003f32),r,0.004f32); outer:f32=sty_sun_disc(cos(r+0.003f32),r,0.004f32);
  #assert inner>0.8f32 && inner<1.0f32 && outer<0.2f32 && outer>0.0f32;
  #assert sty_sun_disc(cos(r-0.003f32),r,0.001f32)==1.0f32 && sty_sun_disc(cos(r+0.003f32),r,0.001f32)==0.0f32;
  // no radius is no disc, even dead on the sun; an edge of no width is still an edge
  #assert sty_sun_disc(1.0f32,0.0f32,0.001f32)==0.0f32 && sty_sun_disc(1.0f32,0.0f32-0.01f32,0.001f32)==0.0f32 && sty_sun_disc(1.0f32,r,0.0f32)==1.0f32 && sty_sun_disc(cos(0.05f32),r,0.0f32)==0.0f32;
  // twice the angle is twice as far: the angle is taken from the cosine, not the cosine itself
  #assert sty_sun_disc(cos(0.055f32),0.06f32,0.001f32)==1.0f32 && sty_sun_disc(cos(0.065f32),0.06f32,0.001f32)==0.0f32;
  low:V3=sty_sun_ink(0.0f32); high:V3=sty_sun_ink(0.5f32); under:V3=sty_sun_ink(0.0f32-0.2f32); mid:V3=sty_sun_ink(0.17f32);
  #assert low.x==1.0f32 && abs(low.y-0.42f32)<0.0001f32 && abs(low.z-0.16f32)<0.0001f32 && under.y==low.y;
  #assert high.x==1.0f32 && abs(high.y-0.97f32)<0.0001f32 && abs(high.z-0.86f32)<0.0001f32 && sty_sun_ink(0.34f32).z==high.z;
  #assert abs(mid.y-0.695f32)<0.001f32 && abs(mid.z-0.51f32)<0.001f32;
}
#test "the sun's glow is most at the sun on the horizon, falls away from it and up the sky, and leaves a faint band all round" {
  at:f32=sty_sun_glow(1.0f32,0.0f32); #assert abs(at-1.3f32)<0.0001f32;
  // away from the sun along the horizon it falls; opposite the sun only the faint band is left
  side:f32=sty_sun_glow(0.0f32,0.0f32); back:f32=sty_sun_glow(0.0f32-1.0f32,0.0f32);
  #assert abs(side-(0.62f32*exp(0.0f32-2.2f32)+0.08f32))<0.0001f32 && abs(back-(0.62f32*exp(0.0f32-4.4f32)+0.08f32+0.6f32*exp(0.0f32-32.0f32)))<0.0001f32 && back>0.08f32 && back<0.09f32;
  near:f32=sty_sun_glow(0.9f32,0.0f32); #assert abs(near-(0.62f32*exp(0.0f32-0.22f32)+0.08f32+0.6f32*exp(0.0f32-1.6f32)))<0.0001f32 && near<at && near>side;
  // up the sky it goes: the wash and the band fast, the light round the sun itself slowly
  up:f32=sty_sun_glow(1.0f32,0.2f32); #assert abs(up-(0.7f32*exp(0.0f32-1.0f32)+0.6f32*exp(0.0f32-0.3f32)))<0.0001f32;
  top:f32=sty_sun_glow(0.0f32,1.0f32); #assert top<0.005f32 && top>0.0f32;
  // a cosine past 1 (rounding) is dead on the sun
  #assert sty_sun_glow(1.001f32,0.0f32)==at;
}
#test "clouds go dark with the light and take the sun's glow, most on their lit side toward the sun, and a look that names neither leaves them as they were" {
  u:[STY_UNIFORM_FLOATS]f32;
  white:V3=v3(1.0f32,0.99f32,0.96f32);
  same:V3=sty_cloud_light(white,1.0f32,1.0f32,u[..]); #assert same.x==1.0f32 && same.y==0.99f32 && same.z==0.96f32;
  u[STY_U_CLOUD_DIM]=1.0f32;
  black:V3=sty_cloud_light(white,1.0f32,1.0f32,u[..]); #assert black.x==0.0f32 && black.y==0.0f32 && black.z==0.0f32;
  u[STY_U_CLOUD_DIM]=3.0f32; over:V3=sty_cloud_light(white,1.0f32,1.0f32,u[..]); #assert over.x==0.0f32;
  u[STY_U_CLOUD_DIM]=0.25f32;
  dim:V3=sty_cloud_light(white,1.0f32,1.0f32,u[..]); #assert abs(dim.x-0.75f32)<0.0001f32 && abs(dim.z-0.72f32)<0.0001f32;
  // the glow: red here, so only the red moves. Lit and toward the sun in daylight takes 0.9 of it
  u[STY_U_CLOUD_DIM]=0.0f32; u[STY_U_GLOW_R]=0.5f32;
  grey:V3=v3(0.2f32,0.2f32,0.2f32);
  lit:V3=sty_cloud_light(grey,1.0f32,1.0f32,u[..]); #assert abs(lit.x-0.65f32)<0.0001f32 && lit.y==0.2f32 && lit.z==0.2f32;
  // its shaded side takes a third of that, and a brightness past 1 is 1
  shade:V3=sty_cloud_light(grey,0.0f32,1.0f32,u[..]); #assert abs(shade.x-0.35f32)<0.0001f32;
  #assert sty_cloud_light(grey,4.0f32,1.0f32,u[..]).x==lit.x;
  // away from the sun it takes less: 0.35 of it opposite, and the falloff is the angle's
  away:V3=sty_cloud_light(grey,1.0f32,0.0f32-1.0f32,u[..]); #assert abs(away.x-(0.2f32+0.45f32*(0.35f32+0.65f32*exp(0.0f32-2.8f32))))<0.0001f32;
  beside:V3=sty_cloud_light(grey,1.0f32,0.0f32,u[..]); #assert abs(beside.x-(0.2f32+0.45f32*(0.35f32+0.65f32*exp(0.0f32-1.4f32))))<0.0001f32;
  #assert sty_cloud_light(grey,1.0f32,1.2f32,u[..]).x==lit.x;
  // a dark cloud takes a quarter of the glow: before dawn it is a dark shape with a little warmth
  u[STY_U_CLOUD_DIM]=1.0f32; night:V3=sty_cloud_light(grey,1.0f32,1.0f32,u[..]); #assert abs(night.x-0.1125f32)<0.0001f32 && night.y==0.0f32;
  u[STY_U_CLOUD_DIM]=0.5f32; half:V3=sty_cloud_light(grey,1.0f32,1.0f32,u[..]); #assert abs(half.x-(0.1f32+0.45f32*0.625f32))<0.0001f32;
  // green and blue glows go to their own channels
  u[STY_U_CLOUD_DIM]=0.0f32; u[STY_U_GLOW_R]=0.0f32; u[STY_U_GLOW_G]=0.5f32; g:V3=sty_cloud_light(grey,1.0f32,1.0f32,u[..]); #assert g.x==0.2f32 && abs(g.y-0.65f32)<0.0001f32 && g.z==0.2f32;
  u[STY_U_GLOW_G]=0.0f32; u[STY_U_GLOW_B]=0.5f32; b:V3=sty_cloud_light(grey,1.0f32,1.0f32,u[..]); #assert b.x==0.2f32 && b.y==0.2f32 && abs(b.z-0.65f32)<0.0001f32;
}
#test "the sky with a sun: its disc where the sun is, its glow low toward it and into the haze under the horizon, nothing overhead, and none of it unless the look names it" {
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_ZENITH]=0.1f32; u[STY_U_ZENITH+1]=0.2f32; u[STY_U_ZENITH+2]=0.5f32; u[STY_U_ZENITH+3]=0.0f32;
  u[STY_U_HORIZON]=0.3f32; u[STY_U_HORIZON+1]=0.3f32; u[STY_U_HORIZON+2]=0.4f32; u[STY_U_HORIZON+3]=1.0f32;
  u[STY_U_HAZE]=0.2f32; u[STY_U_HAZE+1]=0.25f32; u[STY_U_HAZE+2]=0.3f32; u[STY_U_EYE+3]=1000.0f32;
  // the sun 0.1 up (about 6 degrees), dead ahead along -z
  sun:V3=normalize3(v3(0.0f32,0.1f32,0.0f32-1.0f32));
  u[STY_U_SUN]=sun.x; u[STY_U_SUN+1]=sun.y; u[STY_U_SUN+2]=sun.z;
  plain:V3=sty_sky(sun,u[..]); aside:V3=sty_sky(normalize3(v3(1.0f32,0.1f32,0.0f32)),u[..]);
  #assert abs(plain.x-aside.x)<0.0001f32 && plain.x<0.3f32;
  // a disc: the sun's ink where the sun is, the plain sky a disc's width away but for the light round it
  u[STY_U_SUN_DISC]=0.03f32;
  ink:V3=sty_sun_ink(sun.y);
  on:V3=sty_sky(sun,u[..]); #assert abs(on.x-ink.x)<0.0001f32 && abs(on.y-ink.y)<0.0001f32 && abs(on.z-ink.z)<0.0001f32;
  by:V3=sty_sky(normalize3(v3(0.06f32,0.1f32,0.0f32-1.0f32)),u[..]); #assert by.x>plain.x+0.05f32 && by.x<plain.x+0.2f32 && by.y<ink.y-0.1f32;
  off:V3=sty_sky(normalize3(v3(1.0f32,0.1f32,0.0f32)),u[..]); #assert abs(off.x-aside.x)<0.0001f32;
  // the halo round it is the ink's colour, 0.35 of it at the disc, a third of that a disc and a half out
  out:V3=sty_sky(normalize3(v3(0.0f32,0.1f32+0.0453f32,0.0f32-1.0f32)),u[..]);
  clear:V3=v3(0.0f32,0.0f32,0.0f32); u[STY_U_SUN_DISC]=0.0f32; clear=sty_sky(normalize3(v3(0.0f32,0.1f32+0.0453f32,0.0f32-1.0f32)),u[..]); u[STY_U_SUN_DISC]=0.03f32;
  #assert abs((out.x-clear.x)-0.35f32*exp(0.0f32-0.375f32))<0.01f32 && abs((out.y-clear.y)-ink.y*0.35f32*exp(0.0f32-0.375f32))<0.01f32;
  // the edge is a pixel and a half wide at this focal length: 0.0015 radians, so 0.004 inside is whole and 0.004 outside is not the disc
  inside:V3=sty_sky(normalize3(v3(0.026f32,0.1f32,0.0f32-1.0f32)),u[..]); outside:V3=sty_sky(normalize3(v3(0.0345f32,0.1f32,0.0f32-1.0f32)),u[..]);
  #assert abs(inside.y-ink.y)<0.0001f32 && outside.y<ink.y-0.05f32;
  // a glow: red, so only red moves. Low toward the sun it is strong, opposite the sun faint, overhead none
  u[STY_U_SUN_DISC]=0.0f32; u[STY_U_GLOW_R]=0.5f32;
  low:V3=sty_sky(normalize3(v3(0.3f32,0.02f32,0.0f32-1.0f32)),u[..]); base:V3=v3(0.0f32,0.0f32,0.0f32);
  u[STY_U_GLOW_R]=0.0f32; base=sty_sky(normalize3(v3(0.3f32,0.02f32,0.0f32-1.0f32)),u[..]); u[STY_U_GLOW_R]=0.5f32;
  #assert low.x>base.x+0.3f32 && low.y==base.y && low.z==base.z;
  behind:V3=sty_sky(normalize3(v3(0.0f32,0.02f32,1.0f32)),u[..]); #assert behind.x>0.3f32+0.01f32 && behind.x<0.3f32+0.04f32;
  top:V3=sty_sky(v3(0.0f32,1.0f32,0.0f32),u[..]); #assert abs(top.x-0.1f32)<0.003f32;
  // under the horizon the glow goes on into the haze: just under it is the horizon's, well under the haze with its own glow that way
  just:V3=sty_sky(normalize3(v3(0.0f32,0.0f32-0.0001f32,0.0f32-1.0f32)),u[..]); over:V3=sty_sky(normalize3(v3(0.0f32,0.0001f32,0.0f32-1.0f32)),u[..]);
  #assert abs(just.x-over.x)<0.01f32 && just.x>0.3f32+0.5f32;
  deep:V3=normalize3(v3(0.0f32,0.0f32-0.5f32,0.0f32-1.0f32)); under:V3=sty_sky(deep,u[..]);
  want:V3=sty_haze_ink(deep,u[..]); #assert abs(under.x-want.x)<0.0001f32 && under.y==0.25f32 && want.x>0.2f32+0.2f32;
  // the haze's ink: the haze alone with no glow, and with one the sky's horizon glow that way
  ahead:V3=sty_haze_ink(v3(0.0f32,0.0f32,0.0f32-1.0f32),u[..]); back:V3=sty_haze_ink(v3(0.0f32,0.0f32,1.0f32),u[..]);
  #assert abs(ahead.x-(0.2f32+0.5f32*sty_sun_glow(0.0f32-sun.z,0.0f32)))<0.0001f32 && ahead.y==0.25f32 && ahead.z==0.3f32 && back.x<ahead.x-0.4f32 && back.x>0.2f32;
  u[STY_U_GLOW_R]=0.0f32; u[STY_U_GLOW_G]=0.5f32; gg:V3=sty_haze_ink(v3(0.0f32,0.0f32,0.0f32-1.0f32),u[..]); #assert gg.x==0.2f32 && gg.y>0.25f32+0.5f32 && gg.z==0.3f32;
  u[STY_U_GLOW_G]=0.0f32; u[STY_U_GLOW_B]=0.5f32; gb:V3=sty_haze_ink(v3(0.0f32,0.0f32,0.0f32-1.0f32),u[..]); #assert gb.x==0.2f32 && gb.y==0.25f32 && gb.z>0.3f32+0.5f32;
  sk:V3=sty_sky(normalize3(v3(0.3f32,0.02f32,0.0f32-1.0f32)),u[..]); #assert sk.z>base.z+0.3f32 && sk.x==base.x;
  u[STY_U_GLOW_B]=0.0f32; u[STY_U_GLOW_G]=0.5f32; sg:V3=sty_sky(normalize3(v3(0.3f32,0.02f32,0.0f32-1.0f32)),u[..]); #assert sg.y>base.y+0.3f32 && sg.x==base.x;
  u[STY_U_GLOW_G]=0.0f32;
  // far ground toward the sun fades to that ink, and with no glow to the haze as before
  u[STY_U_HAZE+3]=1.0f32; u[STY_U_HAZE_INFO]=0.0f32; u[STY_U_HAZE_INFO+1]=1.0f32;
  far:V3=sty_haze(v3(0.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,0.0f32-500.0f32),u[..]); #assert abs(far.x-pow(0.2f32,2.2f32))<0.0001f32;
  u[STY_U_GLOW_R]=0.5f32;
  warm:V3=sty_haze(v3(0.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,0.0f32-500.0f32),u[..]); #assert abs(warm.x-pow(ahead.x,2.2f32))<0.0001f32 && abs(warm.y-pow(0.25f32,2.2f32))<0.0001f32;
  cold:V3=sty_haze(v3(0.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,500.0f32),u[..]); #assert cold.x<warm.x-0.3f32;
  // a point at the eye itself is not hazed and breaks nothing
  here:V3=sty_haze(v3(0.4f32,0.5f32,0.6f32),wg_at3(u[..],STY_U_EYE),u[..]); #assert here.x==0.4f32 && here.y==0.5f32;
}
#test "the cloud field goes round the whole horizon: untouched away from the join behind, and the same on both sides of it" {
  k:f32=2.2f32;
  // away from the join it is the field itself
  for i:0..<40 {
    az:f32=(cast(f32)i/40.0f32-0.5f32)*2.0f32*(STY_TAU*0.5f32-STY_CLOUD_JOIN);
    #assert sty_cloud_round(az,k,0.3f32,0.4f32,0.5f32)==sty_cloud_field(az*k+0.3f32,0.4f32,0.5f32);
  }
  // at the join the two sides meet: half of each end of the field
  pi:f32=STY_TAU*0.5f32;
  for j:0..<12 {
    ay:f32=0.1f32+cast(f32)j*0.27f32;
    a:f32=sty_cloud_round(pi,k,0.3f32,ay,0.5f32); b:f32=sty_cloud_round(0.0f32-pi,k,0.3f32,ay,0.5f32);
    #assert abs(a-b)<0.0001f32;
    #assert abs(a-(sty_cloud_field(pi*k+0.3f32,ay,0.5f32)+sty_cloud_field(0.3f32-pi*k,ay,0.5f32))*0.5f32)<0.0001f32;
    // and nothing jumps on the way to it, from either side
    last:f32=sty_cloud_round(pi-STY_CLOUD_JOIN-0.01f32,k,0.3f32,ay,0.5f32);
    for s:0..<123 { v:f32=sty_cloud_round(pi-STY_CLOUD_JOIN-0.01f32+cast(f32)(s+1)*0.005f32,k,0.3f32,ay,0.5f32); #assert abs(v-last)<0.03f32; last=v; }
    #assert abs(last-a)<0.03f32;
    last=sty_cloud_round(STY_CLOUD_JOIN+0.01f32-pi,k,0.3f32,ay,0.5f32);
    for s:0..<123 { v:f32=sty_cloud_round(STY_CLOUD_JOIN+0.01f32-pi-cast(f32)(s+1)*0.005f32,k,0.3f32,ay,0.5f32); #assert abs(v-last)<0.03f32; last=v; }
    #assert abs(last-b)<0.03f32;
  }
  // halfway into the join it is a quarter of the far end's
  h:f32=pi-STY_CLOUD_JOIN*0.5f32;
  #assert abs(sty_cloud_round(h,k,0.0f32,0.4f32,0.5f32)-(sty_cloud_field(h*k,0.4f32,0.5f32)*0.75f32+sty_cloud_field((h-STY_TAU)*k,0.4f32,0.5f32)*0.25f32))<0.0001f32;
  #assert abs(sty_cloud_round(0.0f32-h,k,0.0f32,0.4f32,0.5f32)-(sty_cloud_field(0.0f32-h*k,0.4f32,0.5f32)*0.75f32+sty_cloud_field((STY_TAU-h)*k,0.4f32,0.5f32)*0.25f32))<0.0001f32;
  // the sky is sky every way the eye can turn: a whole dome, its zenith's blue all round at one height
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_ZENITH]=0.1f32; u[STY_U_ZENITH+1]=0.2f32; u[STY_U_ZENITH+2]=0.5f32; u[STY_U_HORIZON]=0.3f32; u[STY_U_HORIZON+1]=0.3f32; u[STY_U_HORIZON+2]=0.4f32; u[STY_U_HORIZON+3]=1.0f32;
  u[STY_U_SUN+1]=1.0f32; u[STY_U_EYE+3]=900.0f32;
  first:V3=sty_sky(normalize3(v3(0.0f32,0.5f32,0.0f32-1.0f32)),u[..]);
  for i:0..<64 { a:f32=cast(f32)i/64.0f32*STY_TAU; c:V3=sty_sky(normalize3(v3(sin(a),0.5f32,0.0f32-cos(a))),u[..]); #assert abs(c.z-first.z)<0.0001f32 && c.z>0.4f32; }
}

#test "the painted sky is pinned: its field of cloud and its heaps, over the whole dome, with and without a glow, add up to what they did" #steps 200000000 {
  // A sky with clouds over more than half of it, turned and larger than usual, six heaps round the
  // horizon, the sun to one side, and numbers after the heaps that would be a seventh. Its colours
  // are added up over bearings round the whole horizon and a range of heights, each ray weighed 1
  // to 5 by where it is, so two rays cannot trade places unseen. Five passes: the whole dome; low in
  // the sky; the field alone (no heap has a height); the heaps alone (no cover); and low again,
  // down under the horizon, with a glow and the clouds dimmed.
  for pass:0..<5 {
    u:[STY_UNIFORM_FLOATS]f32;
    u[STY_U_ZENITH]=0.1f32; u[STY_U_ZENITH+1]=0.3f32; u[STY_U_ZENITH+2]=0.8f32; u[STY_U_ZENITH+3]=0.55f32;
    u[STY_U_HORIZON]=0.6f32; u[STY_U_HORIZON+1]=0.7f32; u[STY_U_HORIZON+2]=0.9f32; u[STY_U_HORIZON+3]=1.3f32;
    u[STY_U_HAZE]=0.5f32; u[STY_U_HAZE+1]=0.6f32; u[STY_U_HAZE+2]=0.7f32;
    u[STY_U_HAZE_INFO+2]=0.4f32; u[STY_U_SIZE+2]=100.0f32; u[STY_U_EYE+3]=900.0f32;
    sun:V3=normalize3(v3(0.6f32,0.5f32,0.0f32-0.6f32));
    u[STY_U_SUN]=sun.x; u[STY_U_SUN+1]=sun.y; u[STY_U_SUN+2]=sun.z;
    for i:0..<STY_CUMULI {
      o:int=STY_U_CUMULUS+i*4;
      u[o]=cast(f32)i*1.05f32-2.6f32; u[o+1]=0.06f32+0.03f32*cast(f32)i; u[o+2]=0.2f32+0.04f32*cast(f32)i; u[o+3]=0.16f32+0.03f32*cast(f32)i;
    }
    u[STY_U_REVEAL]=0.2f32; u[STY_U_REVEAL+1]=0.5f32; u[STY_U_REVEAL+2]=0.3f32; u[STY_U_REVEAL+3]=0.3f32;
    n:int=64; m:int=8; lo:f32=0.02f32; hi:f32=0.9f32;
    if (pass==0) { n=48; m=12; lo=0.0f32; hi=1.5f32; }
    if (pass==1) { hi=0.5f32; }
    if (pass==2) { for i:0..<STY_CUMULI { u[STY_U_CUMULUS+i*4+3]=0.0f32; } }
    if (pass==3) { u[STY_U_ZENITH+3]=0.0f32; }
    if (pass==4) { lo=0.0f32-0.3f32; hi=0.6f32; u[STY_U_GLOW_R]=0.5f32; u[STY_U_GLOW_G]=0.3f32; u[STY_U_GLOW_B]=0.1f32; u[STY_U_CLOUD_DIM]=0.3f32; }
    sum:V3=v3(0.0f32,0.0f32,0.0f32);
    for i:0..<n { for j:0..<m {
      a:f32=(cast(f32)i+0.5f32)/cast(f32)n*STY_TAU-STY_TAU*0.5f32; e:f32=lo+(hi-lo)*(cast(f32)j+0.5f32)/cast(f32)m;
      c:V3=sty_sky(v3(sin(a)*cos(e),sin(e),0.0f32-cos(a)*cos(e)),u[..]);
      sum=add3(sum,scale3(c,1.0f32+cast(f32)((i*7+j*3)%5)));
    } }
    want:[5]V3=[5]V3.[v3(696.58826f32,927.9621f32,1477.6311f32),v3(990.28925f32,1116.8137f32,1384.2751f32),v3(790.4461f32,958.8561f32,1341.9601f32),v3(592.6399f32,808.4278f32,1313.8754f32),v3(947.5903f32,1017.3969f32,1191.2145f32)];
    #assert abs(sum.x-want[pass].x)<0.02f32 && abs(sum.y-want[pass].y)<0.02f32 && abs(sum.z-want[pass].z)<0.02f32;
  }
  // a heap at most a thousandth of a radian tall is no heap, even for a ray inside where it would be
  u:[STY_UNIFORM_FLOATS]f32;
  u[STY_U_ZENITH]=0.1f32; u[STY_U_ZENITH+1]=0.3f32; u[STY_U_ZENITH+2]=0.8f32; u[STY_U_HORIZON]=0.6f32; u[STY_U_HORIZON+1]=0.7f32; u[STY_U_HORIZON+2]=0.9f32; u[STY_U_HORIZON+3]=1.0f32;
  u[STY_U_SUN+1]=1.0f32; u[STY_U_EYE+3]=900.0f32;
  ray:V3=v3(0.0f32,sin(0.3004f32),0.0f32-cos(0.3004f32));
  plain:V3=sty_sky(ray,u[..]);
  u[STY_U_CUMULUS]=0.0f32; u[STY_U_CUMULUS+1]=0.3f32; u[STY_U_CUMULUS+2]=0.01f32; u[STY_U_CUMULUS+3]=0.001f32;
  none:V3=sty_sky(ray,u[..]); #assert none.x==plain.x && none.z==plain.z;
  u[STY_U_CUMULUS+3]=0.0011f32; some:V3=sty_sky(ray,u[..]); #assert some.x>plain.x+0.1f32;
  // a heap that stands just short of straight behind is seen from just past it: bearings go round
  u[STY_U_CUMULUS]=3.1f32; u[STY_U_CUMULUS+1]=0.3f32; u[STY_U_CUMULUS+2]=0.5f32; u[STY_U_CUMULUS+3]=0.3f32;
  past:V3=sty_sky(v3(sin(0.0f32-3.1f32)*cos(0.42f32),sin(0.42f32),0.0f32-cos(0.0f32-3.1f32)*cos(0.42f32)),u[..]);
  clear:V3=sty_sky(v3(sin(0.0f32-1.5f32)*cos(0.42f32),sin(0.42f32),0.0f32-cos(0.0f32-1.5f32)*cos(0.42f32)),u[..]);
  #assert past.x>clear.x+0.2f32 && past.x>0.75f32;
  // the sun's disc on the horizon exactly: the ray dead at it is the disc, not the haze under it
  u[STY_U_CUMULUS+3]=0.0f32; u[STY_U_SUN]=0.0f32; u[STY_U_SUN+1]=0.0f32; u[STY_U_SUN+2]=0.0f32-1.0f32; u[STY_U_SUN_DISC]=0.03f32;
  dead:V3=sty_sky(v3(0.0f32,0.0f32,0.0f32-1.0f32),u[..]); ink:V3=sty_sun_ink(0.0f32);
  #assert abs(dead.x-ink.x)<0.0001f32 && abs(dead.y-ink.y)<0.0001f32 && abs(dead.z-ink.z)<0.0001f32;
}

#test "the tone leaves painted colours as they are and rolls a bright light off, toward white and toward its own hue" {
  #assert sty_tone1(0.0f32)==0.0f32 && sty_tone1(0.3f32)==0.3f32 && sty_tone1(0.6f32)==0.6f32 && sty_tone1(0.0f32-2.0f32)==0.0f32;
  #assert abs(sty_tone1(1.8f32)-(0.6f32+0.4f32*(1.0f32-exp(0.0f32-1.0f32))))<0.00001f32 && abs(sty_tone1(3.0f32)-(0.6f32+0.4f32*(1.0f32-exp(0.0f32-2.0f32))))<0.00001f32;
  #assert sty_tone1(0.61f32)>0.6f32 && sty_tone1(0.61f32)<0.61f32 && sty_tone1(50.0f32)>0.999f32 && sty_tone1(50.0f32)<=1.0f32;
  // under 0.6 every channel is itself (and none is under 0)
  same:V3=sty_tone(v3(0.2f32,0.5f32,0.6f32)); #assert same.x==0.2f32 && same.y==0.5f32 && same.z==0.6f32;
  neg:V3=sty_tone(v3(0.0f32-1.0f32,0.3f32,0.0f32-0.2f32)); #assert neg.x==0.0f32 && neg.y==0.3f32 && neg.z==0.0f32;
  // a bright orange (a low sun: 12, 4, 0.2): 0.55 each channel's own roll-off, 0.45 its hue kept under the brightest's
  o:V3=sty_tone(v3(12.0f32,4.0f32,0.2f32)); k:f32=sty_tone1(12.0f32)/12.0f32;
  #assert abs(o.x-sty_tone1(12.0f32))<0.00001f32 && abs(o.y-(0.45f32*4.0f32*k+0.55f32*sty_tone1(4.0f32)))<0.00001f32 && abs(o.z-(0.45f32*0.2f32*k+0.55f32*0.2f32))<0.00001f32;
  #assert o.x>0.99f32 && o.y<0.72f32 && o.y>0.6f32 && o.z<0.13f32;
  // a bright cream (a high sun) is white; green or blue the brightest is handled the same
  w:V3=sty_tone(v3(44.0f32,42.0f32,37.0f32)); #assert w.x>0.999f32 && w.y>0.97f32 && w.z>0.92f32 && w.z<w.y;
  g:V3=sty_tone(v3(0.1f32,3.0f32,0.2f32)); #assert abs(g.y-sty_tone1(3.0f32))<0.00001f32 && g.x<0.1f32 && g.x>0.05f32;
  b:V3=sty_tone(v3(0.1f32,0.2f32,3.0f32)); #assert abs(b.z-sty_tone1(3.0f32))<0.00001f32 && b.y<0.2f32 && b.y>0.1f32;
  n:V3=sty_tone(v3(0.0f32-1.0f32,0.0f32-1.0f32,3.0f32)); #assert n.x==0.0f32 && n.y==0.0f32;
  // just past 0.6 nothing jumps
  j:V3=sty_tone(v3(0.6001f32,0.3f32,0.1f32)); #assert abs(j.x-0.6001f32)<0.0001f32 && abs(j.y-0.3f32)<0.0001f32 && abs(j.z-0.1f32)<0.0001f32;
}
#test "a look with air is exposed, toned and its sky is the atmosphere's; one without is as it was" {
  u:[STY_UNIFORM_FLOATS]f32;
  c:V3=v3(0.2f32,2.0f32,0.5f32);
  // no air: the light as it is, encoded as before
  e:V3=sty_exposed(c,u[..]); #assert e.x==0.2f32 && e.y==2.0f32 && e.z==0.5f32;
  p0:V3=sty_present(c,u[..]); q0:V3=sty_encode(c); #assert p0.x==q0.x && p0.y==q0.y && p0.z==q0.z;
  // air: the exposure scales the light, and it is toned before it is encoded
  u[STY_U_AIR]=0.5f32;
  h:V3=sty_exposed(c,u[..]); #assert h.x==0.1f32 && h.y==1.0f32 && h.z==0.25f32;
  p1:V3=sty_present(c,u[..]); q1:V3=sty_encode(sty_tone(v3(0.1f32,1.0f32,0.25f32))); #assert p1.x==q1.x && p1.y==q1.y && p1.z==q1.z && p1.y<1.0f32;
  // the sky: the painted one without air, the atmosphere's dome with it (its sun, its cloud cover and size, the clock)
  u[STY_U_AIR]=0.0f32;
  u[STY_U_ZENITH]=0.3f32; u[STY_U_ZENITH+1]=0.5f32; u[STY_U_ZENITH+2]=0.9f32; u[STY_U_HORIZON]=0.7f32; u[STY_U_HORIZON+1]=0.8f32; u[STY_U_HORIZON+2]=0.95f32; u[STY_U_HORIZON+3]=1.2f32;
  sun:V3=normalize3(v3(0.4f32,0.67f32,0.0f32-0.6f32)); u[STY_U_SUN]=sun.x; u[STY_U_SUN+1]=sun.y; u[STY_U_SUN+2]=sun.z; u[STY_U_EYE+3]=900.0f32; u[STY_U_SIZE+2]=30.0f32;
  rd:V3=normalize3(v3(0.2f32,0.5f32,0.0f32-1.0f32));
  painted:V3=sty_sky_light(rd,u[..]); want:V3=sty_decode(sty_sky(rd,u[..])); #assert painted.x==want.x && painted.z==want.z;
  u[STY_U_AIR]=1.0f32; u[STY_U_ZENITH+3]=0.4f32; u[STY_U_SUN_DISC]=0.02f32;
  air:V3=sty_sky_light(rd,u[..]); dome:V3=atmo_dome(rd,sun,0.02f32,1.5f32/900.0f32,0.4f32,1.2f32,30.0f32); #assert air.x==dome.x && air.y==dome.y && air.z==dome.z && air.x!=painted.x;
  // dead at the sun: the disc, many times a white; its edge is a pixel and a half at this focal length or a fifth of it
  at:V3=sty_sky_light(sun,u[..]); #assert at.x>10.0f32;
  u[STY_U_EYE+3]=0.0f32; wide:V3=sty_sky_light(sun,u[..]); #assert wide.x<at.x*0.8f32 && wide.x>1.0f32; u[STY_U_EYE+3]=900.0f32;
  // the haze's light: the far air's with air, the look's haze colour without
  u[STY_U_HAZE]=0.5f32; u[STY_U_HAZE+1]=0.6f32; u[STY_U_HAZE+2]=0.7f32;
  to:V3=normalize3(v3(0.3f32,0.0f32-0.2f32,0.0f32-1.0f32));
  ha:V3=sty_haze_light(to,u[..]); fa:V3=atmo_far(to,sun); #assert ha.x==fa.x && ha.y==fa.y && ha.z==fa.z;
  u[STY_U_AIR]=0.0f32; hp:V3=sty_haze_light(to,u[..]); #assert abs(hp.x-pow(0.5f32,2.2f32))<0.0001f32 && abs(hp.z-pow(0.7f32,2.2f32))<0.0001f32;
}
#test "the film: light exposed with the share of it that blooms, and the frame toned once with its bloom laid back" {
  u:[STY_UNIFORM_FLOATS]f32; u[STY_U_AIR]=2.0f32;
  // a dim colour blooms nothing; one over a white blooms what is over it; the knee starts at 0.6
  dim:StyFilm=sty_film(v3(0.1f32,0.2f32,0.05f32),u[..]); #assert dim.light.x==0.2f32 && dim.light.y==0.4f32 && dim.light.z==0.1f32 && dim.light.w==0.0f32 && dim.aux.x==0.0f32 && dim.aux.w==0.0f32;
  lum:f32=4.0f32*0.2126f32+2.0f32*0.7152f32+1.0f32*0.0722f32;
  hot:StyFilm=sty_film(v3(2.0f32,1.0f32,0.5f32),u[..]); #assert hot.light.x==4.0f32 && abs(hot.light.w-metaverse_style_bloom_share(lum,1.0f32,0.4f32))<0.00001f32 && hot.light.w>0.5f32 && hot.light.w<0.7f32;
  knee:StyFilm=sty_film(v3(0.4f32,0.4f32,0.4f32),u[..]); #assert knee.light.w>0.0f32 && knee.light.w<0.1f32;
  green:StyFilm=sty_film(v3(0.0f32,1.0f32,0.0f32),u[..]); red:StyFilm=sty_film(v3(1.0f32,0.0f32,0.0f32),u[..]); blue:StyFilm=sty_film(v3(0.0f32,0.0f32,1.0f32),u[..]);
  #assert green.light.w>red.light.w && red.light.w==0.0f32 && blue.light.w==0.0f32 && abs(green.light.w-metaverse_style_bloom_share(1.4304f32,1.0f32,0.4f32))<0.00001f32;
  far:StyFilm=sty_film(v3(0.0f32,0.0f32,8.0f32),u[..]); #assert abs(far.light.w-metaverse_style_bloom_share(16.0f32*0.0722f32,1.0f32,0.4f32))<0.00001f32;
  rf:StyFilm=sty_film(v3(4.0f32,0.0f32,0.0f32),u[..]); #assert abs(rf.light.w-metaverse_style_bloom_share(8.0f32*0.2126f32,1.0f32,0.4f32))<0.00001f32;
  // the frame: its light and STY_BLOOM of its blurred bright light (0.55 the quarter, 0.45 the eighth), toned and encoded
  l:V3=v3(0.3f32,0.2f32,0.1f32); q:V3=v3(1.0f32,0.5f32,0.2f32); e8:V3=v3(0.4f32,0.8f32,0.6f32);
  got:V3=sty_post(l,q,e8);
  want:V3=sty_encode(sty_tone(v3(0.3f32+STY_BLOOM*(0.55f32+0.18f32),0.2f32+STY_BLOOM*(0.275f32+0.36f32),0.1f32+STY_BLOOM*(0.11f32+0.27f32))));
  #assert abs(got.x-want.x)<0.00001f32 && abs(got.y-want.y)<0.00001f32 && abs(got.z-want.z)<0.00001f32 && STY_BLOOM==0.35f32;
  plain:V3=sty_post(l,v3(0.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,0.0f32)); enc:V3=sty_encode(l); #assert plain.x==enc.x && plain.y==enc.y && plain.z==enc.z;
  // the post pass reads the pixel's own light and the two blurs at the pixel's place in the picture
  u[STY_U_SIZE]=4.0f32; u[STY_U_SIZE+1]=2.0f32;
  lp:[8]V4; for i:0..<8 { lp[i]=v4(0.1f32*cast(f32)i,0.05f32,0.02f32,1.0f32); }
  qp:[2]V4=[2]V4.[v4(1.0f32,0.0f32,0.0f32,1.0f32),v4(0.0f32,1.0f32,0.0f32,1.0f32)];
  ep:[1]V4=[1]V4.[v4(0.0f32,0.0f32,2.0f32,1.0f32)];
  lt:Tex2D=Tex2D.{width=4,height=2,texels=lp[..]}; qt:Tex2D=Tex2D.{width=2,height=1,texels=qp[..]}; et:Tex2D=Tex2D.{width=1,height=1,texels=ep[..]};
  lin:Sampler=Sampler.{linear=true};
  // the pixel at (2.5, 1.5): the light's texel (2, 1), the quarter three eighths of the way across, the eighth's one texel
  px:V4=stylized_post_fs(v4(2.5f32,1.5f32,0.0f32,1.0f32),u[..],lt,qt,et,lin);
  pw:V3=sty_post(v3(0.6f32,0.05f32,0.02f32),v3(0.25f32,0.75f32,0.0f32),v3(0.0f32,0.0f32,2.0f32));
  #assert abs(px.x-pw.x)<0.0001f32 && abs(px.y-pw.y)<0.0001f32 && abs(px.z-pw.z)<0.0001f32 && px.w==1.0f32;
  p2:V4=stylized_post_fs(v4(0.5f32,0.5f32,0.0f32,1.0f32),u[..],lt,qt,et,lin);
  w2:V3=sty_post(v3(0.0f32,0.05f32,0.02f32),v3(1.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,2.0f32)); #assert abs(p2.x-w2.x)<0.0001f32 && abs(p2.y-w2.y)<0.0001f32;
  // (and down the picture: a quarter two texels tall, read a quarter of the way down)
  tp:[2]V4=[2]V4.[v4(1.0f32,0.0f32,0.0f32,1.0f32),v4(0.0f32,1.0f32,0.0f32,1.0f32)]; tall:Tex2D=Tex2D.{width=1,height=2,texels=tp[..]};
  p3:V4=stylized_post_fs(v4(0.5f32,0.5f32,0.0f32,1.0f32),u[..],lt,tall,et,lin);
  w3:V3=sty_post(v3(0.0f32,0.05f32,0.02f32),v3(1.0f32,0.0f32,0.0f32),v3(0.0f32,0.0f32,2.0f32)); #assert abs(p3.x-w3.x)<0.0001f32 && abs(p3.y-w3.y)<0.0001f32;
}
#test "the bloom's steps: the bright share of four pixels to one, no pixel more than 16 whites, then a blur across or down" {
  // a 4 by 4 source: one pixel 40 whites and all of it blooming, one a half-blooming grey, the rest dark
  sp:[16]V4; for i:0..<16 { sp[i]=v4(0.0f32,0.0f32,0.0f32,0.0f32); }
  sp[0]=v4(40.0f32,8.0f32,1.0f32,1.0f32); sp[1]=v4(2.0f32,2.0f32,2.0f32,0.5f32); sp[5]=v4(4.0f32,4.0f32,4.0f32,3.0f32); sp[10]=v4(1.0f32,2.0f32,3.0f32,0.0f32-1.0f32); sp[13]=v4(8.0f32,6.0f32,4.0f32,1.0f32);
  src:Tex2D=Tex2D.{width=4,height=4,texels=sp[..]}; lin:Sampler=Sampler.{linear=true};
  take:[4]f32=[4]f32.[0.0f32,0.0f32,0.0f32,4.0f32];
  // the target is a quarter of the source: its one pixel (0.5, 0.5) is the source's middle, and its four taps are the four inner texel corners
  t:V4=stylized_bloom_fs(v4(0.5f32,0.5f32,0.0f32,1.0f32),src,lin,take[..]);
  // each tap is the mean of four texels; the texel (1, 1) with a share over 1 counts once, the one with a share under 0 not at all
  a:V4=gpu_sample_level(src,lin,v2(0.25f32,0.25f32),0.0f32); b:V4=gpu_sample_level(src,lin,v2(0.75f32,0.25f32),0.0f32);
  c:V4=gpu_sample_level(src,lin,v2(0.25f32,0.75f32),0.0f32); d:V4=gpu_sample_level(src,lin,v2(0.75f32,0.75f32),0.0f32);
  wx:f32=(fmin(a.x,16.0f32)*saturate(a.w)+fmin(b.x,16.0f32)*saturate(b.w)+fmin(c.x,16.0f32)*saturate(c.w)+fmin(d.x,16.0f32)*saturate(d.w))*0.25f32;
  wy:f32=(fmin(a.y,16.0f32)*saturate(a.w)+fmin(b.y,16.0f32)*saturate(b.w)+fmin(c.y,16.0f32)*saturate(c.w)+fmin(d.y,16.0f32)*saturate(d.w))*0.25f32;
  wz:f32=(fmin(a.z,16.0f32)*saturate(a.w)+fmin(b.z,16.0f32)*saturate(b.w)+fmin(c.z,16.0f32)*saturate(c.w)+fmin(d.z,16.0f32)*saturate(d.w))*0.25f32;
  #assert abs(t.x-wx)<0.0001f32 && abs(t.y-wy)<0.0001f32 && abs(t.z-wz)<0.0001f32 && t.w==1.0f32 && t.x>1.0f32 && a.x>11.0f32;
  // a single hot texel is held to 16: a source that is one pixel of 40
  hp:[1]V4=[1]V4.[v4(40.0f32,50.0f32,60.0f32,1.0f32)]; hot:Tex2D=Tex2D.{width=1,height=1,texels=hp[..]};
  h:V4=stylized_bloom_fs(v4(0.5f32,0.5f32,0.0f32,1.0f32),hot,lin,take[..]); #assert h.x==16.0f32 && h.y==16.0f32 && h.z==16.0f32;
  // the blur: nine taps' weights add to 1 (0.227 + 2 (0.316 + 0.070)), across or down by the step
  fp:[1]V4=[1]V4.[v4(2.0f32,3.0f32,4.0f32,1.0f32)]; flat:Tex2D=Tex2D.{width=1,height=1,texels=fp[..]};
  across:[4]f32=[4]f32.[1.0f32,0.0f32,1.0f32,1.0f32];
  f:V4=stylized_bloom_fs(v4(0.5f32,0.5f32,0.0f32,1.0f32),flat,lin,across[..]); #assert abs(f.x-2.0f32*0.999f32)<0.0001f32 && abs(f.y-3.0f32*0.999f32)<0.0001f32 && abs(f.z-4.0f32*0.999f32)<0.0001f32 && f.w==1.0f32;
  // an 8 wide row with one lit texel: across spreads it along the row, down does not
  rp:[8]V4; for i:0..<8 { rp[i]=v4(0.0f32,0.0f32,0.0f32,1.0f32); } rp[4]=v4(1.0f32,2.0f32,3.0f32,1.0f32);
  row:Tex2D=Tex2D.{width=8,height=1,texels=rp[..]}; near:Sampler=Sampler.{linear=false};
  mid:V4=stylized_bloom_fs(v4(4.5f32,0.5f32,0.0f32,1.0f32),row,near,across[..]); #assert abs(mid.x-0.227f32)<0.0001f32 && abs(mid.y-0.454f32)<0.0001f32 && abs(mid.z-0.681f32)<0.0001f32;
  one:V4=stylized_bloom_fs(v4(3.5f32,0.5f32,0.0f32,1.0f32),row,near,across[..]); #assert abs(one.x-0.316f32)<0.0001f32;
  other:V4=stylized_bloom_fs(v4(5.5f32,0.5f32,0.0f32,1.0f32),row,near,across[..]); #assert abs(other.x-0.316f32)<0.0001f32;
  three:V4=stylized_bloom_fs(v4(1.5f32,0.5f32,0.0f32,1.0f32),row,near,across[..]); #assert abs(three.x-0.070f32)<0.0001f32;
  back:V4=stylized_bloom_fs(v4(7.5f32,0.5f32,0.0f32,1.0f32),row,near,across[..]); #assert abs(back.x-0.070f32)<0.0001f32;
  far:V4=stylized_bloom_fs(v4(0.5f32,0.5f32,0.0f32,1.0f32),row,near,across[..]); #assert far.x==0.0f32;
  down:[4]f32=[4]f32.[0.0f32,1.0f32,1.0f32,1.0f32];
  dn:V4=stylized_bloom_fs(v4(3.5f32,0.5f32,0.0f32,1.0f32),row,near,down[..]); #assert dn.x==0.0f32;
  dm:V4=stylized_bloom_fs(v4(4.5f32,0.5f32,0.0f32,1.0f32),row,near,down[..]); #assert abs(dm.x-0.999f32)<0.0001f32;
  // a column: down spreads it
  cp:[8]V4; for i:0..<8 { cp[i]=v4(0.0f32,0.0f32,0.0f32,1.0f32); } cp[4]=v4(1.0f32,0.0f32,0.0f32,1.0f32);
  col:Tex2D=Tex2D.{width=1,height=8,texels=cp[..]};
  c1:V4=stylized_bloom_fs(v4(0.5f32,3.5f32,0.0f32,1.0f32),col,near,down[..]); c2:V4=stylized_bloom_fs(v4(0.5f32,5.5f32,0.0f32,1.0f32),col,near,down[..]); c3:V4=stylized_bloom_fs(v4(0.5f32,1.5f32,0.0f32,1.0f32),col,near,down[..]); c4:V4=stylized_bloom_fs(v4(0.5f32,7.5f32,0.0f32,1.0f32),col,near,down[..]);
  #assert abs(c1.x-0.316f32)<0.0001f32 && abs(c2.x-0.316f32)<0.0001f32 && abs(c3.x-0.070f32)<0.0001f32 && abs(c4.x-0.070f32)<0.0001f32;
  // across does not spread down a column, and a step that is neither (0.5) is a blur
  ca:V4=stylized_bloom_fs(v4(0.5f32,3.5f32,0.0f32,1.0f32),col,near,across[..]); #assert ca.x==0.0f32;
  between:[4]f32=[4]f32.[1.0f32,0.0f32,0.5f32,1.0f32];
  bt:V4=stylized_bloom_fs(v4(4.5f32,0.5f32,0.0f32,1.0f32),row,near,between[..]); #assert abs(bt.x-0.227f32)<0.0001f32;
  // to an eighth: a target pixel spans two source texels
  half:[4]f32=[4]f32.[1.0f32,0.0f32,1.0f32,2.0f32];
  hm:V4=stylized_bloom_fs(v4(2.25f32,0.25f32,0.0f32,1.0f32),row,near,half[..]); #assert abs(hm.x-0.227f32)<0.0001f32;
}
#test "grass lets a low sun through its tips toward the eye, and nothing of a high sun, a sun behind the eye or at its root" {
  // most: the tip, looking straight at a sun just over the horizon
  top:f32=sty_grass_through(1.0f32,0.04f32,1.0f32); #assert abs(top-4.0f32)<0.0001f32;
  // looking away from the sun: none; square to it: an eighth
  #assert sty_grass_through(0.0f32-1.0f32,0.04f32,1.0f32)==0.0f32 && abs(sty_grass_through(0.0f32,0.04f32,1.0f32)-0.5f32)<0.0001f32;
  // down the blade it falls by the square: a quarter half way, none at the root
  #assert abs(sty_grass_through(1.0f32,0.04f32,0.5f32)-1.0f32)<0.0001f32 && sty_grass_through(1.0f32,0.04f32,0.0f32)==0.0f32;
  // a sun 30 degrees up gives none; between, less the higher it is
  #assert sty_grass_through(1.0f32,0.5f32,1.0f32)==0.0f32 && sty_grass_through(1.0f32,0.7f32,1.0f32)==0.0f32;
  mid:f32=sty_grass_through(1.0f32,0.275f32,1.0f32); #assert abs(mid-2.0f32)<0.0001f32;
  // a sun under the horizon: none by 2.3 degrees under, half of it on the horizon's line a little under
  #assert sty_grass_through(1.0f32,0.0f32-0.04f32,1.0f32)==0.0f32 && sty_grass_through(1.0f32,0.0f32-0.1f32,1.0f32)==0.0f32;
  #assert abs(sty_grass_through(1.0f32,0.0f32-0.005f32,1.0f32)-2.0f32)<0.0001f32 && abs(sty_grass_through(1.0f32,0.03f32,1.0f32)-4.0f32)<0.0001f32;
  // a cosine past 1 is 1
  #assert sty_grass_through(1.5f32,0.04f32,1.0f32)==top;
}
