// The Metaverse Engine's stylized shading, its frame block: where each number of the look sits in a page's
// uniform floats. metaverse-engine/render/stylized-frame.coax writes them on the CPU and
// metaverse-engine/render/stylized.coax's shaders read them, so both load this file and neither repeats an
// offset. A block is STY_UNIFORM_FLOATS floats: STY_UNIFORM_FLOATS / 4 vec4f in a page's bindings.
//
//   STY_U_SIZE        the picture's width and height in pixels, the clock in seconds, the fade (1 shown)
//   STY_U_EYE         the eye, and the focal length in pixels
//   STY_U_VIEW        the view and projection, four rows: clip = row . (x, y, z, 1)
//   STY_U_LIGHT       the sun's view of the scene for its shadow map, four rows
//   STY_U_SUN         the way to the sun, and how dark its shadows are (0 none, 1 no direct light)
//   STY_U_SUN_COLOUR  the sun's colour, and how soft the bands of its light are
//   STY_U_SKY_LIGHT   the light from the sky, on faces that look up; STY_U_GROUND_LIGHT from below
//   STY_U_HAZE        the haze's colour, and how much of it a metre adds
//   STY_U_HAZE_INFO   where the haze starts (m), the most it hides (0 to 1), how far the clouds are turned
//                     round the horizon (radians), and one spare
//   STY_U_ZENITH      the sky overhead, and the cloud cover (0 clear, 1 overcast)
//   STY_U_HORIZON     the sky at the horizon, and the clouds' size
//   STY_U_RIGHT, STY_U_UP, STY_U_FORWARD   the eye's own axes
//   STY_U_GRASS       the grass field: its west and north edge, a cell's size, cells across
//   STY_U_GRASS_INFO  cells deep, a blade's height and width, and how far the field is drawn
//   STY_U_GROUND      the ground table (metaverse-engine/arch/flora.coax ArchGround): its first node's x and
//                     z, a cell's size, cells a side
//   STY_U_PATH_INFO   how many dirt paths, how soft their edges are (m), how dry the meadow is (0 lush, 1
//                     dry), and how far its patches are shifted (m)
//   STY_U_PATH        STY_PATHS paths, eight floats each: from (x, z) to (x, z), half its width, three spare
//   STY_U_CUMULUS     STY_CUMULI heaped clouds, four floats each: where it stands round the horizon (radians,
//                     0 along -z, turning toward +x), how high its flat base is (radians above the horizon),
//                     half its width and its height (radians; 0: no cloud)

STY_U_SIZE :: 0;
STY_U_EYE :: 4;
STY_U_VIEW :: 8;
STY_U_LIGHT :: 24;
STY_U_SUN :: 40;
STY_U_SUN_COLOUR :: 44;
STY_U_SKY_LIGHT :: 48;
STY_U_GROUND_LIGHT :: 52;
STY_U_HAZE :: 56;
STY_U_HAZE_INFO :: 60;
STY_U_ZENITH :: 64;
STY_U_HORIZON :: 68;
STY_U_RIGHT :: 72;
STY_U_UP :: 76;
STY_U_FORWARD :: 80;
STY_U_GRASS :: 84;
STY_U_GRASS_INFO :: 88;
STY_U_GROUND :: 92;
STY_U_PATH_INFO :: 96;
STY_U_PATH :: 100;
STY_PATHS :: 12;
STY_PATH_FLOATS :: 8;
STY_U_CUMULUS :: 196;          // STY_U_PATH + STY_PATHS * STY_PATH_FLOATS
STY_CUMULI :: 6;
STY_UNIFORM_FLOATS :: 220;     // STY_U_CUMULUS + STY_CUMULI * 4

// The shadow map's bias: how far along its normal a surface is moved before it is looked up (m),
// and how much nearer the sun it must be than what the map holds (a share of the map's depth).
STY_SHADOW_PUSH :: 0.07;
STY_SHADOW_BIAS :: 0.0012;
