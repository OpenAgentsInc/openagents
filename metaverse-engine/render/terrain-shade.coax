// Terrain material and baked-light shading (GitHub #12995, book chapters 12 and 13): the scalar
// functions a realm's ground shader and the Metaverse Engine's CPU reference both call, so the GPU and the
// checks evaluate one set of equations. Each lowers to WGSL as `coax_p_<name>`.
//
// Materials (metaverse-engine/world/terrain-tile.coax, `aethyr.terrain.materials.v1`): a procedural albedo is
//   t      = w1 noise(f1 p + o1) + w2 noise(f2 p + o2)        (p the world x, z in metres)
//            + ws w_of / (w_of + w_against)                    (a share of the point's layers, 0 if none)
//   gain   = g0 + g1 noise(f3 p + o3)
//   depth  = 1 - darken smoothstep(from, to, fluid depth)
//   albedo = (mix(a, b, t) gain depth)^2.2                     (display colours decoded once)
// and a point's albedo is the sum of its influences' linear albedos times their weights. Layered
// coverage becomes weights with `engine_terrain_over`: a layer of coverage c over the weights so
// far scales them by 1 - c and adds c to its own slot, so the weights keep adding to one.
//
// Baked light (metaverse-engine/render/bake.coax, `aethyr.bake.grid.v1`): AO and RGB bounce on the tile's
// samples, bilinear between them, rising to open sky over `rise` metres above the ground:
//   s        = smoothstep(0, rise, height above ground)
//   ao'      = mix(ao, 1, s);  bounce' = bounce (1 - s)
//   indirect = hemisphere ambient (ao' + bounce')
// Only the indirect term takes AO. The key light, its shadows, local lights and the rim do not,
// and the realm's tone curve applies exposure once, after.
//   coax/bin/coax test metaverse-engine/render/terrain-shade.coax
//   coax/bin/coax mutate metaverse-engine/render/terrain-shade.coax --root-only

#load "noise.coax";   // and through it metaverse-engine/gpu/shader.coax

#test "the value noise is the realms' lattice noise, smoothed between its corners" {
  #assert engine_terrain_noise(1, 2) == render_noise2(1, 2);
  #assert engine_terrain_noise(-3, 5) == render_noise2(-3, 5);
  a := render_noise2(1, 2); b := render_noise2(2, 2); c := render_noise2(1, 3); d := render_noise2(2, 3);
  // at (1.5, 2.25): s = (0.5, 0.15625)
  want := engine_terrain_mix(engine_terrain_mix(a, b, 0.5), engine_terrain_mix(c, d, 0.5), 0.15625);
  #assert engine_terrain_noise(1.5, 2.25) == want;
  e := render_noise2(-2, -1); f := render_noise2(-1, -1); g := render_noise2(-2, 0); h := render_noise2(-1, 0);
  // at (-1.75, -0.5): i = (-2, -1), f = (0.25, 0.5), s = (0.15625, 0.5)
  #assert engine_terrain_noise(-1.75, -0.5) == engine_terrain_mix(engine_terrain_mix(e, f, 0.15625), engine_terrain_mix(g, h, 0.15625), 0.5);
}

#test "a material's blend, gain, depth and decode follow the written equations" {
  x := 12.5f32; z := -7.25f32;
  n1 := engine_terrain_noise(x * 1.7 + 0, z * 1.7 + 0);
  n2 := engine_terrain_noise(x * 0.2 + 5, z * 0.2 + 5);
  #assert engine_terrain_blend_t(x, z, 1.7, 0.6, 0, 0.2, 0.4, 5) == n1 * 0.6 + n2 * 0.4;
  // a second term with no share is not evaluated, and adds nothing
  #assert engine_terrain_blend_t(x, z, 0.13, 1, 0, 9, 0, 3) == engine_terrain_noise(x * 0.13, z * 0.13);
  #assert engine_terrain_blend_t(x, z, 0.13, 0.75, 1, 9, 0, 3) == engine_terrain_noise(x * 0.13 + 1, z * 0.13 + 1) * 0.75;
  g := engine_terrain_noise(x * 0.23 + 7, z * 0.23 + 7);
  #assert engine_terrain_gain(x, z, 0.96, 0.08, 0.23, 7) == 0.96 + 0.08 * g;
  #assert engine_terrain_gain(x, z, 0.9, 0, 0.23, 7) == 0.9;
  #assert engine_terrain_depth_gain(0.1, 0.45, 0.3, 2) == 1;
  #assert engine_terrain_depth_gain(5, 0.45, 0.3, 2) == 0.55;
  #assert abs(engine_terrain_depth_gain(1.15, 0.45, 0.3, 2) - 0.775) < 0.000001;
  #assert engine_terrain_depth_gain(5, 0, 0.3, 2) == 1;
  // a term with no share is never evaluated, so even a nonfinite input to it leaves the result
  inf := 1.0f32; inf = inf / 0.0f32; nan := inf - inf;
  #assert engine_terrain_blend_t(x, z, 0.13, 1, 0, inf, 0, 3) == engine_terrain_noise(x * 0.13, z * 0.13);
  #assert engine_terrain_gain(x, z, 0.9, 0, inf, 7) == 0.9;
  #assert engine_terrain_depth_gain(nan, 0, 0.3, 2) == 1;
  #assert abs(engine_terrain_decode(0.2, 0.6, 0.5, 1) - pow(0.4f32, 2.2f32)) < 0.0000001;
  #assert abs(engine_terrain_decode(0.2, 0.6, 0.25, 0.5) - pow(0.15f32, 2.2f32)) < 0.0000001;
  #assert abs(engine_terrain_decode(0.2, 0.6, 0, 1) - pow(0.2f32, 2.2f32)) < 0.0000001;
  #assert abs(engine_terrain_decode(0.2, 0.6, 1, 1) - pow(0.6f32, 2.2f32)) < 0.0000001;
  #assert engine_terrain_decode(0.0, 0.6, -1, 1) == 0;   // a colour below black decodes to black
}

#test "a layer share is one weight against the other, and nothing where neither is" {
  #assert engine_terrain_share(0.3, 0.1) == 0.75 && engine_terrain_share(0, 0.4) == 0 && engine_terrain_share(0.2, 0) == 1;
  #assert engine_terrain_share(0, 0) == 0;
  // the autumn under a litter: with coverage a over the meadow, then the litter over both, the share
  // gives back a wherever any meadow or autumn is left
  a := 0.35f32; f := 0.6f32;
  m := engine_terrain_over(engine_terrain_over(1, a, 0), f, 0); au := engine_terrain_over(engine_terrain_over(0, a, 1), f, 0);
  #assert abs(engine_terrain_share(au, m) - a) < 0.000001;
}

#test "layered coverage becomes weights that add to one, as sequential mixing does" {
  // meadow, then paving 0.6, then a path edge 0.5, then wet 0.25
  w0 := 1.0f32; w1 := 0.0f32; w2 := 0.0f32; w3 := 0.0f32;
  c := 0.6f32;
  w0 = engine_terrain_over(w0, c, 0); w1 = engine_terrain_over(w1, c, 1); w2 = engine_terrain_over(w2, c, 0); w3 = engine_terrain_over(w3, c, 0);
  c = 0.5;
  w0 = engine_terrain_over(w0, c, 0); w1 = engine_terrain_over(w1, c, 0); w2 = engine_terrain_over(w2, c, 1); w3 = engine_terrain_over(w3, c, 0);
  c = 0.25;
  w0 = engine_terrain_over(w0, c, 0); w1 = engine_terrain_over(w1, c, 0); w2 = engine_terrain_over(w2, c, 0); w3 = engine_terrain_over(w3, c, 1);
  #assert abs(w0 - 0.15) < 0.000001 && abs(w1 - 0.225) < 0.000001 && abs(w2 - 0.375) < 0.000001 && w3 == 0.25;
  #assert abs(w0 + w1 + w2 + w3 - 1) < 0.000001;
  // the same result as mixing the colours in turn
  a := 0.1f32; b := 0.4f32; cc := 0.7f32; d := 0.9f32;
  seq := engine_terrain_mix(engine_terrain_mix(engine_terrain_mix(a, b, 0.6), cc, 0.5), d, 0.25);
  #assert abs(seq - (w0 * a + w1 * b + w2 * cc + w3 * d)) < 0.000001;
  #assert engine_terrain_over(0.8, 0, 1) == 0.8 && engine_terrain_over(0.8, 1, 0) == 0;
}

#test "the bake interpolates bilinearly, clamps to its grid and rises to open sky" {
  #assert engine_bake_bilerp(0, 1, 2, 4, 0.5, 0.5) == 1.75;
  #assert engine_bake_bilerp(0, 1, 2, 4, 0, 1) == 2 && engine_bake_bilerp(0, 1, 2, 4, 1, 0) == 1;
  #assert engine_bake_index(3.75, 8) == 3 && engine_bake_index(-0.5, 8) == 0 && engine_bake_index(8, 8) == 7 && engine_bake_index(9.5, 8) == 7;
  #assert engine_bake_fraction(3.75, 3) == 0.75 && engine_bake_fraction(8, 7) == 1 && engine_bake_fraction(-0.5, 0) == 0;
  #assert engine_bake_inside(-10, -10, 20) == 1 && engine_bake_inside(10, -10, 20) == 1;
  #assert engine_bake_inside(-10.001, -10, 20) == 0 && engine_bake_inside(10.001, -10, 20) == 0;
  #assert engine_bake_rise(0, 7) == 0 && engine_bake_rise(-2, 7) == 0 && engine_bake_rise(7, 7) == 1 && engine_bake_rise(3.5, 7) == 0.5;
  #assert engine_bake_ao(0.4, 0) == 0.4 && engine_bake_ao(0.4, 1) == 1 && abs(engine_bake_ao(0.4, 0.5) - 0.7) < 0.000001;
  #assert engine_bake_bounce(0.2, 0) == 0.2 && engine_bake_bounce(0.2, 1) == 0 && engine_bake_bounce(0.2, 0.25) == 0.15;
  #assert engine_bake_indirect(0.8, 0.5, 0.25) == 0.6;
  #assert engine_bake_indirect(0.8, 1, 0) == 0.8;
}

// ---- materials

// Value noise on the integer lattice: render_noise2 at the four corners, smoothed (3t^2 - 2t^3).
// a + (b - a) t, as metaverse-engine/gpu/shader.coax's mix, under its own name: a realm that loads this beside
// another `mix` (metaverse-engine/core/points.coax's) reads one meaning.
engine_terrain_mix :: (a:f32,b:f32,t:f32)->f32 #export_c #effects(all) {return a+(b-a)*t;}
engine_terrain_noise :: (x:f32,z:f32)->f32 #export_c #effects(all) {
 ix:=floor(x);iz:=floor(z);
 fx:=x-ix;fz:=z-iz;
 sx:=fx*fx*(3.0f32-2.0f32*fx);sz:=fz*fz*(3.0f32-2.0f32*fz);
 return engine_terrain_mix(engine_terrain_mix(render_noise2(ix,iz),render_noise2(ix+1.0f32,iz),sx),engine_terrain_mix(render_noise2(ix,iz+1.0f32),render_noise2(ix+1.0f32,iz+1.0f32),sx),sz);
}
// The blend between a material's two colours at (x, z): w1 noise(f1 p + o1) + w2 noise(f2 p + o2).
engine_terrain_blend_t :: (x:f32,z:f32,f1:f32,w1:f32,o1:f32,f2:f32,w2:f32,o2:f32)->f32 #export_c #effects(all) {
 t:=engine_terrain_noise(x*f1+o1,z*f1+o1)*w1;
 if w2>0.0f32 {t=t+engine_terrain_noise(x*f2+o2,z*f2+o2)*w2;}
 return t;
}
// A layer share: the point's weight of one material against another's, w_of / (w_of + w_against),
// 0 where neither is there.
engine_terrain_share :: (w_of:f32,w_against:f32)->f32 #export_c #effects(all) {
 total:=w_of+w_against;
 if total>0.0f32 {return w_of/total;}
 return 0.0f32;
}
// Its brightness: g0 + g1 noise(f3 p + o3).
engine_terrain_gain :: (x:f32,z:f32,g0:f32,g1:f32,f3:f32,o3:f32)->f32 #export_c #effects(all) {
 if g1>0.0f32 {return g0+g1*engine_terrain_noise(x*f3+o3,z*f3+o3);}
 return g0;
}
// Under fluid `depth` metres deep: 1 - darken smoothstep(from, to, depth).
engine_terrain_depth_gain :: (depth:f32,darken:f32,from:f32,to:f32)->f32 #export_c #effects(all) {
 if darken>0.0f32 {return 1.0f32-darken*smoothstep(from,to,depth);}
 return 1.0f32;
}
// One channel, decoded to linear: (mix(a, b, t) scale)^2.2, black below zero.
engine_terrain_decode :: (a:f32,b:f32,t:f32,scale:f32)->f32 #export_c #effects(all) {
 return pow(fmax(engine_terrain_mix(a,b,t)*scale,0.0f32),2.2f32);
}
// A weight under a new layer of coverage c: scaled by 1 - c, plus c when it is the layer's slot (is 1).
engine_terrain_over :: (w:f32,c:f32,is:f32)->f32 #export_c #effects(all) {
 return w*(1.0f32-c)+c*is;
}

// ---- baked light

engine_bake_bilerp :: (a:f32,b:f32,c:f32,d:f32,fx:f32,fz:f32)->f32 #export_c #effects(all) {
 return engine_terrain_mix(engine_terrain_mix(a,b,fx),engine_terrain_mix(c,d,fx),fz);
}
// The cell a grid coordinate g (in samples from the west or south edge) falls in, of n, clamped.
engine_bake_index :: (g:f32,n:f32)->f32 #export_c #effects(all) {
 return clampf(floor(g),0.0f32,n-1.0f32);
}
engine_bake_fraction :: (g:f32,i:f32)->f32 #export_c #effects(all) {
 return clampf(g-i,0.0f32,1.0f32);
}
// 1 inside [edge, edge + span], 0 past it: where the bake is valid.
engine_bake_inside :: (x:f32,edge:f32,span:f32)->f32 #export_c #effects(all) {
 if x<edge || x>edge+span {return 0.0f32;}
 return 1.0f32;
}
engine_bake_rise :: (h:f32,rise:f32)->f32 #export_c #effects(all) {
 return smoothstep(0.0f32,rise,h);
}
engine_bake_ao :: (ao:f32,s:f32)->f32 #export_c #effects(all) {
 return engine_terrain_mix(ao,1.0f32,s);
}
engine_bake_bounce :: (b:f32,s:f32)->f32 #export_c #effects(all) {
 return b*(1.0f32-s);
}
// One channel of the indirect light: the hemisphere ambient times the AO and the bounce.
engine_bake_indirect :: (hemi:f32,ao:f32,bounce:f32)->f32 #export_c #effects(all) {
 return hemi*(ao+bounce);
}
