// Fixtures metaverse-engine/render/bake.coax's checks share (#12995).

bk_test_grid :: (t: TerrainTile, rev: [8] u32) -> BakeGrid #effects(all) {
  return BakeGrid.{cells = t.cells, spacing = t.spacing, origin_x = t.origin_x, origin_z = t.origin_z, rise = 7,
    key = BakeKey.{tile = rev, content = [8] u32.[9, 9, 9, 9, 9, 9, 9, 9], axes = 1, state = [4] u32.[3, 0, 0, 0]}};
}
bk_test_fill :: (ao: [] f32, bounce: [] f32) #effects(all) {
  for bk_k: 0..<ao.count {
    ao[bk_k] = 0.25 * f32(bk_k % 5);
    bounce[bk_k * 3] = 0.5 * (1 - ao[bk_k]); bounce[bk_k * 3 + 1] = 0.25 * (1 - ao[bk_k]); bounce[bk_k * 3 + 2] = 0;
  }
}
