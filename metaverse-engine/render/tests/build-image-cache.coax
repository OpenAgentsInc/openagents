// SDK compilation and linking only. The decoded bytes and verdict are Coax.
#import "Basic";
#load "qualification-files.coax";
icb_emit :: (compiler:string,source:string,header:string,code:string,profile:string,out:string,label:string)->bool {
 argv:=[8]string.[compiler,"c",source,"--library","--header",header,"--profile-report",profile];env:[]string;bytes:[16777216]u8;stderr:[65536]u8;r:=rtq_run_raw(argv[..],env,120000,bytes[..],stderr[..]);
 path:[4096]u8;if !fs_write(fs_join(out,label,path[..]),cast(string)stderr[0..<r.err_n])||r.started!=0||r.status!=0||r.cut||r.timed_out{return false;}return fs_write(code,cast(string)bytes[0..<r.out_n]);
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])<3{tool_errln("usage: build-image-cache ROOT EMISSION NEW_OUT [--coax IMAGE] [--sanitize]");return 2;}
 root:=args_at(a[..],0);emission:=args_at(a[..],1);out:=args_at(a[..],2);if !fs_mkdir(out){return 1;}paths:[32][4096]u8;compiler:=args_value(a[..],"--coax",fs_join(root,"coax/bin/coax",paths[0][..]));
 for spec,i:[2][2]string.[[2]string.["metaverse-engine/render/tests/check-image-cache.coax","ImageCacheCheck"],[2]string.["coax/lib/crypto/entropy.coax","entropy-policy"]] {
  label:[128]u8;name:[1]Jo;jo_start(name[..],label[..]);jo_put(name[..],spec[1]);jo_put(name[..],".c");code:=fs_join(out,jo_text(name[..]),paths[1+i*4][..]);jo_start(name[..],label[..]);jo_put(name[..],spec[1]);jo_put(name[..],".h");header:=fs_join(out,jo_text(name[..]),paths[2+i*4][..]);jo_start(name[..],label[..]);jo_put(name[..],spec[1]);jo_put(name[..],".profile.json");profile:=fs_join(out,jo_text(name[..]),paths[3+i*4][..]);
  if !icb_emit(compiler,fs_join(root,spec[0],paths[4+i*4][..]),header,code,profile,out,ifx i==0 then "driver-emission.log" else "entropy-emission.log"){return 1;}
 }
 argv:[64]string;n:=0;sanitize:=args_has(a[..],"--sanitize");for flag:[10]string.["cc","-std=c11",ifx sanitize then "-O1" else "-O2","-ffp-contract=off","-fno-fast-math","-Wno-unused-function","-Wno-unused-variable","-D_DEFAULT_SOURCE","-D_DARWIN_C_SOURCE","-DCOAX_TOOL_STACK=((size_t)1<<30)"]{argv[n]=flag;n+=1;}
 for dir,i:[4]string.[emission,out,fs_join(root,"metaverse/native",paths[9][..]),fs_join(root,"coax/platform",paths[10][..])]{argv[n]="-I";argv[n+1]=dir;n+=2;}
 argv[n]=fs_join(emission,"RenderTexture.c",paths[11][..]);n+=1;for file,i:[2]string.["ImageCacheCheck.c","entropy-policy.c"]{argv[n]=fs_join(out,file,paths[12+i][..]);n+=1;}
 for file,i:[9]string.["metaverse/native/render-images.c","metaverse-engine/render/tests/image-cache-effects.c","coax/platform/tool-native.c","coax/platform/process-native.c","coax/platform/store-file-native.c","coax/platform/read-file-native.c","coax/platform/socket-native.c","coax/platform/entropy-native.c","coax/platform/entropy-foreign.c"]{argv[n]=fs_join(root,file,paths[14+i][..]);n+=1;}
 if sanitize{for flag:[4]string.["-fsanitize=address,undefined","-fno-sanitize-recover=all","-fno-omit-frame-pointer","-g"]{argv[n]=flag;n+=1;}}
 if cxtool_os()==1{argv[n]="-framework";argv[n+1]="Security";n+=2;}else{argv[n]="-lpthread";n+=1;}argv[n]="-lm";argv[n+1]="-o";argv[n+2]=fs_join(out,"check-image-cache",paths[24][..]);n+=3;
 env:[]string;stdout:[1048576]u8;stderr:[1048576]u8;r:=rtq_command(argv[0..<n],env,proc_now_ms()+120000,out,"link",stdout[..],stderr[..]);return ifx rtq_ok(r) then 0 else 1;
}
