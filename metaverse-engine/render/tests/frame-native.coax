// Test transport only: actual admission and decoding remain in frame.coax.
#load "../frame.coax";
engine_frame_admit :: (c:FrameCounts,l:RenderFrameLimits,d:RenderDirectDomains,u:[]RenderUpload,
  w:[]u32,domains:[]RenderDrawDomain,indices:[]u32)->RenderFrameResult #export_c #effects(all) {
  return render_frame_admit(c,l,d,u,w,domains,indices);
}
engine_frame_decode :: (w:[]u32,record:int)->RenderDecodedDraw #export_c #effects(all) {return render_decode_draw(w,record);}
engine_frame_preflight :: (l:RenderFrameLimits,u:[]RenderUpload)->RenderFrameResult #export_c #effects(all) {return render_uploads_admit(l,u);}
