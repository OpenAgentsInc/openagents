// Checks for metaverse-engine/render/frame-plan.coax, which loads this file with #test.
//   coax/bin/coax test metaverse-engine/render/frame-plan.coax

#test "the name tables are the enums: one name a member, in the enums' order" {
  #assert cast(int) RenderPassId.scene_late == FP_PASSES.count - 1 && cast(int) RenderPassId.invalid == 13 && cast(int) RenderTarget.invalid == FP_TARGETS.count;
  #assert cast(int) RenderOpKind.particle_sort == FP_KINDS.count - 1 && cast(int) RenderOpKind.media_after == 7 && cast(int) RenderDepth.less == FP_DEPTHS.count - 1;
  #assert cast(int) RenderBlend.under == FP_BLENDS.count - 1 && cast(int) RenderDrawSource.late == FP_SOURCES.count - 1 && cast(int) RenderDrawSource.current == 2;
  #assert cast(int) RenderPassId.shadow_clear == 14 && cast(int) RenderOpKind.cull_early == 8 && cast(int) RenderOpKind.scissor == 11;
  #assert FP_HOST.count == 20 && FPH_FEATURES == 14 && FPH_TILES == 16384 && FPH_PARTICLES_READY == 524288 && FPH_ALL == 1048575;
  #assert cast(int) RenderPassId.hud == 12 && cast(int) RenderTarget.e1 == 11 && cast(int) RenderOpKind.begin == 0 && cast(int) RenderOpKind.copy == 3;
}

// Everglade's kind of frame: every feature on.
fpc_full :: () -> RenderPlan #effects(all) {
  f := RenderFeatures.{scene = true, shadow = true, casters = true, grass = true, water = true, water_copy = true, post = true, post_depth = true,
                       particles = true, particle_depth = true, particle_over = true, media = true};
  c := FrameCounts.{width = 1280, height = 800, vertex_stride = 16, hud_vertices = 96, draw_count = 9, water_draws = 2, grass_instances = 4000,
                    particle_instances = 64, caster_vertices = 300, caster_instances = 5};
  return render_plan(f, c, RenderReadiness.ready, true);
}
// A plan read back from words, written again, is the same words.
fpc_again :: (w: [] u32, n: int) -> bool #effects(all) {
  q: [1] RenderPlan; q[0].status = RenderPlanStatus.ok; q[0].count = frame_plan_count(w[0..<n]);
  if q[0].count < 0 { return false; }
  for i: 0..<q[0].count { q[0].ops[i] = frame_plan_op(w[0..<n], i); }
  v: [2072] u32;
  if frame_plan_write(q[..], v[..]) != n { return false; }
  for i: 0..<n { if v[i] != w[i] { return false; } }
  return true;
}
fpc_has :: (o: [] FpText, t: string) -> bool #effects(all) {
  for at: 0..<o[0].n - t.count + 1 { hit := true; for k: 0..<t.count { if o[0].b[at + k] != t[k] { hit = false; break; } } if hit { return true; } }
  return false;
}

#test "a plan written and read back is the plan: every operation, kind and pass, and the same words again" {
  q: [1] RenderPlan; q[0] = fpc_full();
  #assert q[0].status == RenderPlanStatus.ok && q[0].count > 20;
  w: [2072] u32; for i: 0..<w.count { w[i] = 0xffffffff; }
  n := frame_plan_write(q[..], w[..]);
  #assert n == frame_plan_size(q[0].count) && n == (q[0].count + 1) * 8 && frame_plan_count(w[0..<n]) == q[0].count;
  #assert w[0] == 0x31504641 && w[1] == 1 && w[2] == 8 && w[3] == cast(u32) q[0].count && w[4] == 0 && w[5] == 0 && w[6] == 0 && w[7] == 0;
  #assert w[n] == 0xffffffff;   // nothing past the plan is written
  blooms := 0;
  for i: 0..<q[0].count {
    a := frame_plan_op(w[0..<n], i); b := q[0].ops[i];
    #assert a.kind == b.kind && a.pass == b.pass && a.first == b.first && a.count == b.count && a.instances == b.instances;
    #assert a.colour0 == b.colour0 && a.colour1 == b.colour1 && a.depth == b.depth && a.source == b.source && a.target == b.target;
    #assert a.state.valid == b.state.valid && a.state.colour == b.state.colour && a.state.alpha == b.state.alpha && a.state.outputs == b.state.outputs;
    for k: 0..<4 { #assert a.bloom_step[k] == b.bloom_step[k]; }
    if b.pass == RenderPassId.bloom && b.kind == RenderOpKind.draw { blooms += 1; }
  }
  #assert blooms == 5 && fpc_again(w[..], n);
  // the flat page too: a background and a HUD
  q[0] = render_plan(RenderFeatures.{}, FrameCounts.{width = 320, height = 180, vertex_stride = 16, hud_vertices = 6}, RenderReadiness.ready, true);
  n = frame_plan_write(q[..], w[..]);
  #assert n == 40 && frame_plan_count(w[0..<n]) == 4 && fpc_again(w[..], n) && frame_plan_op(w[0..<n], 2).pass == RenderPassId.hud && frame_plan_op(w[0..<n], 2).count == 6;
}

#test "each field has its own place: one operation's words, bit for bit, and each field read back" {
  q: [1] RenderPlan; q[0].status = RenderPlanStatus.ok; q[0].count = 1;
  q[0].ops[0] = RenderOp.{kind = RenderOpKind.draw, pass = RenderPassId.bloom, draw_source = RenderDrawSource.current,
    colour0 = RenderTarget.light, colour1 = RenderTarget.aux, depth = RenderTarget.scene_depth, source = RenderTarget.q1, target = RenderTarget.e0,
    keep = true, store_depth = true, first = 7, count = 300, instances = 70000, bloom_step = [4] f32.[1, 2, 3, 4]};
  q[0].ops[0].state = RenderPassState.{valid = true, depth = RenderDepth.less, depth_write = true, bias = 2, slope = 3,
    colour = RenderBlend.multiply, alpha = RenderBlend.under, outputs = 2, aux_write = true};
  w: [16] u32;
  #assert frame_plan_write(q[..], w[..]) == 16;
  #assert w[8] == 2 + (10 << 8) + (2 << 16) + (2 << 24);
  #assert w[9] == 2 + (3 << 8) + (4 << 16) + (9 << 24);
  #assert w[10] == 10 + (2 << 8) + (6 << 16) + (2 << 24);
  #assert w[11] == 31 + (2 << 8) + (3 << 16);
  #assert w[12] == 7 && w[13] == 300 && w[14] == 70000 && w[15] == 1 + (2 << 8) + (3 << 16) + (4 << 24);
  o := frame_plan_op(w[..], 0);
  #assert o.kind == RenderOpKind.draw && o.pass == RenderPassId.bloom && o.draw_source == RenderDrawSource.current && o.state.depth == RenderDepth.less;
  #assert o.colour0 == RenderTarget.light && o.colour1 == RenderTarget.aux && o.depth == RenderTarget.scene_depth && o.source == RenderTarget.q1 && o.target == RenderTarget.e0;
  #assert o.state.colour == RenderBlend.multiply && o.state.alpha == RenderBlend.under && o.state.outputs == 2 && o.state.bias == 2 && o.state.slope == 3;
  #assert o.keep && o.store_depth && o.state.valid && o.state.depth_write && o.state.aux_write && o.first == 7 && o.count == 300 && o.instances == 70000;
  #assert o.bloom_step[0] == 1 && o.bloom_step[1] == 2 && o.bloom_step[2] == 3 && o.bloom_step[3] == 4;
  // each flag alone, written and read
  flags := [5] u32.[FP_KEEP, FP_STORE_DEPTH, FP_VALID, FP_DEPTH_WRITE, FP_AUX_WRITE];
  for k: 0..<5 {
    p := RenderOp.{kind = RenderOpKind.begin}; p.state.aux_write = false; p.state.outputs = 0; p.instances = 0;
    if k == 0 { p.keep = true; } if k == 1 { p.store_depth = true; } if k == 2 { p.state.valid = true; }
    if k == 3 { p.state.depth_write = true; } if k == 4 { p.state.aux_write = true; }
    q[0].ops[0] = p;
    #assert frame_plan_write(q[..], w[..]) == 16 && w[11] == flags[k];
    r := frame_plan_op(w[..], 0);
    #assert r.keep == (k == 0) && r.store_depth == (k == 1) && r.state.valid == (k == 2) && r.state.depth_write == (k == 3) && r.state.aux_write == (k == 4);
  }
}

#test "a plan that is not ok, does not fit, or holds a field out of range is refused and leaves no magic" {
  q: [1] RenderPlan; q[0] = fpc_full(); w: [2072] u32;
  n := frame_plan_size(q[0].count);
  w[0] = 99; #assert frame_plan_write(q[..], w[0..<n - 1]) == 0 && w[0] == 0;
  #assert frame_plan_write(q[..], w[0..<n]) == n;
  w[0] = 99; #assert frame_plan_write(q[..], w[0..<1]) == 0 && w[0] == 0;
  #assert frame_plan_write(q[..], w[0..<0]) == 0;
  q[0].status = RenderPlanStatus.loading; #assert frame_plan_write(q[..], w[..]) == 0 && w[0] == 0;
  q[0].status = RenderPlanStatus.invalid; #assert frame_plan_write(q[..], w[..]) == 0;
  q[0].status = RenderPlanStatus.ok; q[0].count = RENDER_OPS + 1; #assert frame_plan_write(q[..], w[..]) == 0;
  q[0].count = -1; #assert frame_plan_write(q[..], w[..]) == 0;
  q[0].count = 0; w[8] = 7; #assert frame_plan_write(q[..], w[..]) == 8 && frame_plan_count(w[0..<8]) == 0 && w[0] == FRAME_PLAN_MAGIC && w[8] == 7;
  // the most operations a plan holds are written
  for i: 0..<RENDER_OPS { q[0].ops[i] = RenderOp.{kind = RenderOpKind.end}; }
  q[0].count = RENDER_OPS; #assert frame_plan_write(q[..], w[..]) == 2056 && frame_plan_count(w[0..<2056]) == RENDER_OPS;
  good := RenderOp.{kind = RenderOpKind.draw, pass = RenderPassId.scene};
  #assert frame_plan_op_ok(good);
  o := good; o.first = -1; #assert !frame_plan_op_ok(o); o.first = 0x80000000; #assert !frame_plan_op_ok(o);
  o = good; o.count = -1; #assert !frame_plan_op_ok(o); o.count = 0x80000000; #assert !frame_plan_op_ok(o);
  o = good; o.instances = -1; #assert !frame_plan_op_ok(o); o.instances = 0x80000000; #assert !frame_plan_op_ok(o);
  o = good; o.first = 0x7fffffff; o.count = 0x7fffffff; o.instances = 0x7fffffff; #assert frame_plan_op_ok(o);
  o = good; o.state.bias = 256; #assert !frame_plan_op_ok(o); o.state.bias = 255; #assert frame_plan_op_ok(o); o.state.bias = -1; #assert !frame_plan_op_ok(o);
  o = good; o.state.slope = 256; #assert !frame_plan_op_ok(o); o.state.slope = 255; #assert frame_plan_op_ok(o); o.state.slope = -1; #assert !frame_plan_op_ok(o);
  o = good; o.state.outputs = 256; #assert !frame_plan_op_ok(o); o.state.outputs = 255; #assert frame_plan_op_ok(o); o.state.outputs = -1; #assert !frame_plan_op_ok(o);
  o = good; o.pass = RenderPassId.invalid; #assert !frame_plan_op_ok(o); o.kind = RenderOpKind.end; #assert frame_plan_op_ok(o);
  o = good; o.colour0 = RenderTarget.invalid; #assert !frame_plan_op_ok(o);
  o = good; o.colour1 = RenderTarget.invalid; #assert !frame_plan_op_ok(o);
  o = good; o.depth = RenderTarget.invalid; #assert !frame_plan_op_ok(o);
  o = good; o.source = RenderTarget.invalid; #assert !frame_plan_op_ok(o);
  o = good; o.target = RenderTarget.invalid; #assert !frame_plan_op_ok(o);
  for k: 0..<4 {
    o = good; o.bloom_step[k] = 0.5; #assert !frame_plan_op_ok(o);
    o.bloom_step[k] = -1; #assert !frame_plan_op_ok(o); o.bloom_step[k] = 256; #assert !frame_plan_op_ok(o);
    o.bloom_step[k] = 255; #assert frame_plan_op_ok(o); o.bloom_step[k] = 0; #assert frame_plan_op_ok(o);
  }
  // one bad operation refuses the whole plan: the last, and the first
  q[0] = fpc_full(); q[0].ops[q[0].count - 1].first = -1; w[0] = 99;
  #assert frame_plan_write(q[..], w[..]) == 0 && w[0] == 0;
  q[0] = fpc_full(); q[0].ops[0].first = -1; w[0] = 99;
  #assert frame_plan_write(q[..], w[..]) == 0 && w[0] == 0;
}

#test "a host refuses another version, another record size, a short buffer and a count past the plan's limit" {
  q: [1] RenderPlan; q[0] = fpc_full(); w: [2072] u32;
  n := frame_plan_write(q[..], w[..]);
  #assert frame_plan_count(w[0..<n]) == q[0].count && frame_plan_count(w[0..<n - 1]) == -1 && frame_plan_count(w[0..<7]) == -1 && frame_plan_count(w[0..<0]) == -1;
  #assert frame_plan_op(w[0..<n], q[0].count - 1).kind == q[0].ops[q[0].count - 1].kind && frame_plan_op(w[0..<n], 0).kind == q[0].ops[0].kind;
  out := frame_plan_op(w[0..<n], q[0].count); #assert out.kind == RenderOpKind.end && out.pass == RenderPassId.invalid && out.count == 0;
  under := frame_plan_op(w[0..<n], -1); #assert under.kind == RenderOpKind.end && under.pass == RenderPassId.invalid;
  #assert frame_plan_op(w[0..<n - 1], 0).pass == RenderPassId.invalid;   // a refused plan has no operation
  w[0] = FRAME_PLAN_MAGIC + 1; #assert frame_plan_count(w[0..<n]) == -1; w[0] = FRAME_PLAN_MAGIC;
  w[1] = 2; #assert frame_plan_count(w[0..<n]) == -1; w[1] = 1;
  w[2] = 9; #assert frame_plan_count(w[0..<n]) == -1; w[2] = 8;
  w[3] = cast(u32) (RENDER_OPS + 1); #assert frame_plan_count(w[..]) == -1;
  w[3] = cast(u32) RENDER_OPS; #assert frame_plan_count(w[..]) == RENDER_OPS && frame_plan_count(w[0..<2055]) == -1 && frame_plan_size(RENDER_OPS) == 2056;
  w[3] = 0x80000000; #assert frame_plan_count(w[..]) == -1;
  // an empty plan is a plan: eight words, no operation
  w[3] = 0; #assert frame_plan_count(w[0..<8]) == 0 && frame_plan_count(w[0..<9]) == 0;
}

#test "the header names every number once, with the enums' values" {
  o: [1] FpText; n := frame_plan_header(o[..]);
  #assert n == o[0].n && n > 1500 && n < 8192 && o[0].b[0] == '/' && o[0].b[1] == '*';
  #assert fpc_has(o[..], "/* The frame plan's numbers (GitHub #13303). Written by metaverse-engine/render/frame-plan.coax:\n *   coax/web/tool.sh metaverse-engine/tools/frame-plan-header.coax > metaverse-engine/host/frame-plan.h\n * Never edit it by hand. The record layout is stated at the top of frame-plan.coax. */\n#ifndef");
  #assert fpc_has(o[..], "#ifndef ENGINE_FRAME_PLAN_H\n#define ENGINE_FRAME_PLAN_H\n#define ENGINE_FP_MAGIC 827344449u\n#define ENGINE_FP_VERSION 1u\n#define ENGINE_FP_WORDS 8u\n#define ENGINE_FP_MOST_OPS 256u\n");
  #assert fpc_has(o[..], "#define ENGINE_FP_FLAG_KEEP 1u\n#define ENGINE_FP_FLAG_STORE_DEPTH 2u\n#define ENGINE_FP_FLAG_VALID 4u\n#define ENGINE_FP_FLAG_DEPTH_WRITE 8u\n#define ENGINE_FP_FLAG_AUX_WRITE 16u\n#define ENGINE_FP_OP_BEGIN 0u\n");
  #assert fpc_has(o[..], "#define ENGINE_FP_OP_MEDIA_AFTER 7u\n#define ENGINE_FP_OP_CULL_EARLY 8u\n") && fpc_has(o[..], "#define ENGINE_FP_OP_PARTICLE_SORT 12u\n#define ENGINE_FP_PASS_BACKGROUND 0u\n") && fpc_has(o[..], "#define ENGINE_FP_PASS_HUD 12u\n#define ENGINE_FP_PASS_SHADOW_CLEAR 14u\n") && fpc_has(o[..], "#define ENGINE_FP_PASS_SCENE_LATE 17u\n#define ENGINE_FP_TARGET_NONE 0u\n");
  #assert fpc_has(o[..], "#define ENGINE_FP_TARGET_E1 11u\n#define ENGINE_FP_DEPTH_NONE 0u\n#define ENGINE_FP_DEPTH_ALWAYS 1u\n#define ENGINE_FP_DEPTH_LESS 2u\n#define ENGINE_FP_BLEND_REPLACE 0u\n");
  #assert fpc_has(o[..], "#define ENGINE_FP_BLEND_UNDER 6u\n#define ENGINE_FP_SOURCE_VERTICES 0u\n#define ENGINE_FP_SOURCE_RECORDS 1u\n#define ENGINE_FP_SOURCE_CURRENT 2u\n#define ENGINE_FP_SOURCE_SHADOW_RECORDS 3u\n#define ENGINE_FP_SOURCE_LATE 4u\n#define ENGINE_FP_HOST_SCENE 1u\n") && fpc_has(o[..], "#define ENGINE_FP_HOST_PARTICLES_READY 524288u\n#endif\n");
  #assert o[0].b[n - 1] == '\n' && !fpc_has(o[..], "AETHYR_FP_PASS_INVALID");
  again: [1] FpText; again[0].n = 77; #assert frame_plan_header(again[..]) == n && again[0].b[0] == '/';
}

// ---- a page's plan from the host's bits (#13303)
fpc_page_x :: () -> RenderShipping #effects(all) {
  x := RenderShipping.{tiles = true, tile = 0, tile_count = 2, clears = 1, shadow_draws = 3, cull = true, cull_runs = 6, character = true, sort = true, bloom_passes = 3};
  x.rects[0] = [4] int.[0, 0, 1024, 1024]; x.rects[1] = [4] int.[1024, 0, 1024, 1024];
  return x;
}
fpc_page_has :: (w: [] u32, kind: RenderOpKind, pass: RenderPassId) -> int #effects(all) {
  n := 0;
  for i: 0..<frame_plan_count(w) { o := frame_plan_op(w, i); if o.kind == kind && (kind != RenderOpKind.draw || o.pass == pass) { n += 1; } }
  return n;
}
#test "a page's plan: the host's feature bits are RenderFeatures' fields in order" {
  for k: 0..<14 {
    f := frame_plan_features(cast(u32) (1 << cast(u64) k));
    got := [14] bool.[f.scene, f.shadow, f.casters, f.grass, f.surface, f.water, f.water_copy, f.post, f.post_depth, f.traced_depth, f.particles, f.particle_depth, f.particle_over, f.media];
    for j: 0..<14 { #assert got[j] == (j == k); }
  }
}
#test "a page's plan: tiles, the cull, the character and the sort are drawn only when the host and the page both have them" {
  c := FrameCounts.{width = 640, height = 360, vertex_stride = 16, hud_vertices = 12, draw_count = 9, particle_instances = 4};
  feat: u32 = 1 | 2 | 128 | 1024 | 8192;
  base: u32 = feat | cast(u32) FPH_SCENE_READY | cast(u32) FPH_PARTICLES_READY;
  w: [2072] u32;
  n := frame_plan_page(base | cast(u32) (FPH_TILES | FPH_CULL | FPH_CHARACTER | FPH_SORT), c, fpc_page_x(), w[..]);
  #assert n > 0 && frame_plan_count(w[0..<n]) * 8 + 8 == n;
  #assert fpc_page_has(w[0..<n], RenderOpKind.cull_early, RenderPassId.invalid) == 1 && fpc_page_has(w[0..<n], RenderOpKind.cull_late, RenderPassId.invalid) == 1;
  #assert fpc_page_has(w[0..<n], RenderOpKind.scissor, RenderPassId.invalid) == 1 && fpc_page_has(w[0..<n], RenderOpKind.particle_sort, RenderPassId.invalid) == 1;
  #assert fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.character) == 1 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.bloom) == 3;
  #assert fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.scene_late) == 1 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.shadow_clear) == 1;
  // a rectangle read back from its two words
  for i: 0..<frame_plan_count(w[0..<n]) { o := frame_plan_op(w[0..<n], i); if o.kind == RenderOpKind.scissor { #assert o.first == 0 && o.count == (1024 | (1024 << 16)); } }
  // the host without each: the page's fact is dropped, the rest of the frame stands
  n = frame_plan_page(base | cast(u32) (FPH_CULL | FPH_CHARACTER | FPH_SORT), c, fpc_page_x(), w[..]);
  #assert n > 0 && fpc_page_has(w[0..<n], RenderOpKind.scissor, RenderPassId.invalid) == 0 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.shadow) == 1 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.character_cast) == 1;
  n = frame_plan_page(base | cast(u32) (FPH_TILES | FPH_CHARACTER | FPH_SORT), c, fpc_page_x(), w[..]);
  #assert n > 0 && fpc_page_has(w[0..<n], RenderOpKind.cull_early, RenderPassId.invalid) == 0 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.scene_late) == 0;
  n = frame_plan_page(base | cast(u32) (FPH_TILES | FPH_CULL | FPH_SORT), c, fpc_page_x(), w[..]);
  #assert n > 0 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.character) == 0;
  n = frame_plan_page(base | cast(u32) (FPH_TILES | FPH_CULL | FPH_CHARACTER), c, fpc_page_x(), w[..]);
  #assert n > 0 && fpc_page_has(w[0..<n], RenderOpKind.particle_sort, RenderPassId.invalid) == 0;
  // the scene's assets pending: the background, the post chain and the HUD only
  n = frame_plan_page(feat | cast(u32) (FPH_TILES | FPH_CULL | FPH_PARTICLES_READY), c, fpc_page_x(), w[..]);
  #assert n > 0 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.scene) == 0 && fpc_page_has(w[0..<n], RenderOpKind.cull_early, RenderPassId.invalid) == 0 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.hud) == 1;
  // the particles' group not in yet
  n = frame_plan_page(feat | cast(u32) (FPH_SORT | FPH_SCENE_READY), c, fpc_page_x(), w[..]);
  #assert n > 0 && fpc_page_has(w[0..<n], RenderOpKind.draw, RenderPassId.particle) == 0 && fpc_page_has(w[0..<n], RenderOpKind.particle_sort, RenderPassId.invalid) == 1;
}
#test "a page's plan: bits past the host's set, features that do not hold together and a short buffer are refused, the first word cleared" {
  c := FrameCounts.{width = 640, height = 360, vertex_stride = 16};
  w: [2072] u32; w[0] = 7;
  #assert frame_plan_page(cast(u32) (FPH_ALL + 1), c, RenderShipping.{}, w[..]) == 0 && w[0] == 0;
  w[0] = 7; #assert frame_plan_page(2, c, RenderShipping.{}, w[..]) == 0 && w[0] == 0;   // a shadow with no scene
  w[0] = 7; #assert frame_plan_page(1, c, RenderShipping.{}, w[0..<16]) == 0 && w[0] == 0;
  x := RenderShipping.{bloom_passes = 9};
  w[0] = 7; #assert frame_plan_page(1, c, x, w[..]) == 0 && w[0] == 0;
  #assert frame_plan_page(cast(u32) (FPH_ALL - 16 - 512), FrameCounts.{width = 1, height = 1, vertex_stride = 1}, RenderShipping.{}, w[..]) > 0;
  #assert frame_plan_page(0, c, RenderShipping.{}, w[..]) == 32 && frame_plan_count(w[0..<32]) == 3;
}
#test "the header has the host's bits and the shipping members" {
  o: [1] FpText; n := frame_plan_header(o[..]);
  #assert n > 0 && fpc_has(o[..], "#define ENGINE_FP_HOST_SCENE 1u\n") && fpc_has(o[..], "#define ENGINE_FP_HOST_TILES 16384u\n") && fpc_has(o[..], "#define ENGINE_FP_HOST_PARTICLES_READY 524288u\n");
  #assert fpc_has(o[..], "#define ENGINE_FP_OP_CULL_EARLY 8u\n") && fpc_has(o[..], "#define ENGINE_FP_PASS_SCENE_LATE 17u\n") && fpc_has(o[..], "#define ENGINE_FP_SOURCE_LATE 4u\n");
}

// A host's ask for a page with no plan of its own (#13451).
fpc_ask :: (bits: u32) -> [FPA_WORDS] u32 #effects(all) {
  a: [FPA_WORDS] u32;
  a[0] = bits; a[1] = 1280; a[2] = 800; a[3] = 16; a[4] = 96; a[5] = 9; a[15] = 5;
  return a;
}
#test "a host's ask is the page's plan: the same words frame_plan_page writes for the same counts and facts" {
  bits: u32 = 1 | 2 | 128 | 1024 | 8192 | FPH_TILES | FPH_CULL | FPH_SORT | FPH_SCENE_READY | FPH_PARTICLES_READY;
  a := fpc_ask(bits);
  a[8] = 64; a[12] = 8; a[13] = 12; a[14] = FPA_GRASS_LAST; a[15] = 3; a[16] = 2; a[17] = 4; a[18] = 2;
  for t: 0..<4 { a[19 + t * 4] = cast(u32) ((t % 2) * 2048); a[20 + t * 4] = cast(u32) ((t / 2) * 2048); a[21 + t * 4] = 2048; a[22 + t * 4] = 2048; }
  c := FrameCounts.{width = 1280, height = 800, vertex_stride = 16, hud_vertices = 96, draw_count = 9, particle_instances = 64};
  x := RenderShipping.{tiles = true, tile = 1, tile_count = 4, clears = 2, shadow_draws = 7, cull = true, cull_runs = 12, character = true, sort = true, grass_last = true, bloom_passes = 3};
  for k: 0..<4 { x.rects[k] = [4] int.[(k % 2) * 2048, (k / 2) * 2048, 2048, 2048]; }
  v: [2072] u32; w: [2072] u32;
  n := frame_plan_host(a[..], v[..]); m := frame_plan_page(bits, c, x, w[..]);
  #assert n > 8 && n == m;
  for i: 0..<n { #assert v[i] == w[i]; }
  // each count has its own word
  b := fpc_ask(1 | 4 | 8 | 32 | FPH_SCENE_READY); b[6] = 2; b[7] = 500; b[10] = 30; b[11] = 4;
  n = frame_plan_host(b[..], v[..]); #assert n > 8;
  grass := 0; caster := 0; wet := 0;
  for i: 0..<frame_plan_count(v[0..<n]) {
    o := frame_plan_op(v[0..<n], i);
    if o.kind == RenderOpKind.draw && o.pass == RenderPassId.grass { grass = o.instances; }
    if o.kind == RenderOpKind.draw && o.pass == RenderPassId.caster { caster = o.count * 100 + o.instances; }
    if o.kind == RenderOpKind.each_begin { wet = o.first * 100 + o.count; }
  }
  #assert grass == 500 && caster == 3004 && wet == 702;
  // a traced page: a surface and its particles
  t := fpc_ask(16 | 1024 | FPH_PARTICLES_READY); t[5] = 0; t[8] = 7; t[9] = 12;
  n = frame_plan_host(t[..], v[..]); #assert frame_plan_count(v[0..<n]) == 6 && frame_plan_op(v[0..<n], 2).count == 12 && frame_plan_op(v[0..<n], 3).instances == 7;
}
#test "a host's ask is refused whole: too few words, an unknown fact, more tiles than there are, a tile past them, six bloom stages" {
  v: [2072] u32;
  good := fpc_ask(FPH_SCENE_READY | 1);
  v[0] = 9; #assert frame_plan_host(good[..], v[..]) > 8 && v[0] == FRAME_PLAN_MAGIC;
  v[0] = 9; #assert frame_plan_host(good[0..<FPA_WORDS - 1], v[..]) == 0 && v[0] == 0;
  a := good; a[14] = 8; #assert frame_plan_host(a[..], v[..]) == 0;
  a = good; a[14] = 7; #assert frame_plan_host(a[..], v[..]) > 8;
  a = good; a[17] = 9; #assert frame_plan_host(a[..], v[..]) == 0;
  a = good; a[15] = 6; #assert frame_plan_host(a[..], v[..]) == 0;
  a = good; a[15] = 0; #assert frame_plan_host(a[..], v[..]) > 8;
  a = good; a[16] = 1; #assert frame_plan_host(a[..], v[..]) == 0;   // a tile to draw with no tiles
  a = good; a[0] = FPH_ALL + 1; #assert frame_plan_host(a[..], v[..]) == 0;
  #assert FPA_WORDS == 55 && FPA_CUT == 51;
}

#test "a host's ask: a lazy shadow map is drawn only on a frame with something to cast" {
  v: [2072] u32;
  a := fpc_ask(1 | 2 | FPH_SCENE_READY); a[5] = 0;
  n := frame_plan_host(a[..], v[..]); #assert frame_plan_op(v[0..<n], 0).depth == RenderTarget.shadow_map;
  a[14] = FPA_SHADOW_LAZY;
  n = frame_plan_host(a[..], v[..]); #assert n > 8 && frame_plan_op(v[0..<n], 0).depth == RenderTarget.scene_depth && frame_plan_op(v[0..<n], 0).colour0 == RenderTarget.screen;
  a[5] = 3;
  n = frame_plan_host(a[..], v[..]); #assert frame_plan_op(v[0..<n], 0).depth == RenderTarget.shadow_map && frame_plan_op(v[0..<n], 1).pass == RenderPassId.shadow && frame_plan_op(v[0..<n], 1).count == 3;
}

#test "a host's ask: the drawn tile's draws are cut to the rectangle the host names, or to the tile's own" {
  v: [2072] u32;
  a := fpc_ask(1 | 2 | FPH_TILES | FPH_SCENE_READY);
  a[16] = 1; a[17] = 2; a[18] = 1; a[19] = 0; a[20] = 0; a[21] = 2048; a[22] = 2048; a[23] = 2048; a[24] = 0; a[25] = 2048; a[26] = 2048;
  n := frame_plan_host(a[..], v[..]);
  // begin, the clear's viewport and draw, the whole viewport, the scissor
  #assert frame_plan_op(v[0..<n], 1).kind == RenderOpKind.viewport && frame_plan_op(v[0..<n], 4).kind == RenderOpKind.scissor;
  #assert frame_plan_op(v[0..<n], 4).first == 0 && frame_plan_op(v[0..<n], 4).count == (2048 | (2048 << 16));
  a[FPA_CUT] = 0; a[FPA_CUT + 1] = 0; a[FPA_CUT + 2] = 4096; a[FPA_CUT + 3] = 2048;
  n = frame_plan_host(a[..], v[..]);
  #assert frame_plan_op(v[0..<n], 4).kind == RenderOpKind.scissor && frame_plan_op(v[0..<n], 4).count == (4096 | (2048 << 16));
  // the clear keeps the tile's own rectangle
  #assert frame_plan_op(v[0..<n], 1).count == (2048 | (2048 << 16));
  // a rectangle of a width and no height is refused, and one past the largest texture
  a[FPA_CUT + 3] = 0; #assert frame_plan_host(a[..], v[..]) == 0;
  a[FPA_CUT + 3] = 40000; #assert frame_plan_host(a[..], v[..]) == 0;
}
