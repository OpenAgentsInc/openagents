// Checks for the shipping half of metaverse-engine/render/passes.coax (#13303), which loads this file with #test.
//   coax/bin/coax test metaverse-engine/render/passes.coax

// Everglade II's frame: a scene with shadow tiles and a separate shadow list, the instance cull,
// particles, the post chain and the HUD between the media layers.
rps_everglade :: () -> RenderShipping #effects(all) {
  x := RenderShipping.{tiles = true, tile = 1, tile_count = 4, clears = 2, shadow_draws = 7, cull = true, cull_runs = 12, grass_last = true, bloom_passes = 3};
  for k: 0..<4 { x.rects[k] = [4] int.[(k % 2) * 2048, (k / 2) * 2048, 2048, 2048]; }
  return x;
}
rps_features :: () -> RenderFeatures #effects(all) {
  return RenderFeatures.{scene = true, shadow = true, post = true, particles = true, media = true};
}
rps_counts :: () -> FrameCounts #effects(all) {
  return FrameCounts.{width = 1440, height = 900, vertex_stride = 16, hud_vertices = 96, draw_count = 40, particle_instances = 9};
}
rps_kinds :: (q: RenderPlan, want: [] const RenderOpKind) -> bool #effects(all) {
  if q.count != want.count { return false; }
  for i: 0..<q.count { if q.ops[i].kind != want[i] { return false; } }
  return true;
}

#test "shipping: no shipping facts is render_plan's program, operation for operation" {
  f := RenderFeatures.{scene = true, shadow = true, casters = true, grass = true, water = true, water_copy = true, post = true, particles = true, particle_depth = true, particle_over = true, media = true};
  c := FrameCounts.{width = 1, height = 1, vertex_stride = 1, hud_vertices = 1, draw_count = 2, water_draws = 1, grass_instances = 1, particle_instances = 1, caster_vertices = 1, caster_instances = 1};
  a := render_plan(f, c, RenderReadiness.ready, true); b := render_plan_shipping(f, c, RenderShipping.{}, RenderReadiness.ready, true);
  #assert a.status == RenderPlanStatus.ok && a.count == 40 && b.count == 40;
  for i: 0..<40 { #assert a.ops[i].kind == b.ops[i].kind && a.ops[i].pass == b.ops[i].pass && a.ops[i].count == b.ops[i].count && a.ops[i].keep == b.ops[i].keep && a.ops[i].store_depth == b.ops[i].store_depth; }
}

#test "shipping: Everglade II's frame is the order host.js drew it in" {
  q := render_plan_shipping(rps_features(), rps_counts(), rps_everglade(), RenderReadiness.ready, true);
  #assert q.status == RenderPlanStatus.ok;
  want := [32] RenderOpKind.[RenderOpKind.cull_early,
    RenderOpKind.begin, RenderOpKind.viewport, RenderOpKind.draw, RenderOpKind.viewport, RenderOpKind.scissor, RenderOpKind.draw, RenderOpKind.end,
    RenderOpKind.begin, RenderOpKind.draw, RenderOpKind.draw, RenderOpKind.end, RenderOpKind.cull_late, RenderOpKind.begin, RenderOpKind.draw, RenderOpKind.draw, RenderOpKind.end,
    RenderOpKind.begin, RenderOpKind.draw, RenderOpKind.end, RenderOpKind.begin, RenderOpKind.draw, RenderOpKind.end, RenderOpKind.begin, RenderOpKind.draw, RenderOpKind.end,
    RenderOpKind.begin, RenderOpKind.draw, RenderOpKind.media_before, RenderOpKind.draw, RenderOpKind.media_after, RenderOpKind.end];
  #assert q.count == 32 && rps_kinds(q, want[..]);
  #assert q.ops[0].count == 12;
  // the tile's pass keeps the atlas, clears tile 1, then draws the shadow list inside tile 1's rectangle
  #assert q.ops[1].depth == RenderTarget.shadow_map && q.ops[1].keep && q.ops[1].store_depth && q.ops[1].colour0 == RenderTarget.none;
  #assert q.ops[2].first == (2048 | (0 << 16)) && q.ops[2].count == (2048 | (2048 << 16)) && q.ops[3].pass == RenderPassId.shadow_clear && q.ops[3].count == 3;
  #assert q.ops[4].first == 0 && q.ops[4].count == 0 && q.ops[5].first == 2048 && q.ops[5].count == (2048 | (2048 << 16));
  #assert q.ops[6].pass == RenderPassId.shadow && q.ops[6].draw_source == RenderDrawSource.shadow_records && q.ops[6].count == 7;
  // the scene: depth stored for the pyramid, the list's draws, then the late draws in a pass that keeps
  #assert q.ops[8].colour0 == RenderTarget.light && q.ops[8].colour1 == RenderTarget.aux && q.ops[8].depth == RenderTarget.scene_depth && !q.ops[8].keep && q.ops[8].store_depth;
  #assert q.ops[9].pass == RenderPassId.background && q.ops[10].pass == RenderPassId.scene && q.ops[10].count == 40 && q.ops[10].draw_source == RenderDrawSource.records;
  #assert q.ops[12].count == 12 && q.ops[13].keep && q.ops[13].store_depth && q.ops[13].colour0 == RenderTarget.light;
  #assert q.ops[14].pass == RenderPassId.scene_late && q.ops[14].draw_source == RenderDrawSource.late && q.ops[14].count == 12 && q.ops[14].state.valid;
  #assert q.ops[15].pass == RenderPassId.particle && q.ops[15].instances == 9;
  // three bloom stages, the quarter chain, then the screen
  #assert q.ops[17].colour0 == RenderTarget.q0 && q.ops[20].colour0 == RenderTarget.q1 && q.ops[23].colour0 == RenderTarget.q0 && q.ops[26].colour0 == RenderTarget.screen;
  #assert q.ops[27].pass == RenderPassId.post && q.ops[29].pass == RenderPassId.hud && q.ops[29].count == 96;
}

#test "shipping: no tile this frame, or nothing to cast, draws no shadow pass; a frame with no post stores depth only for the cull" {
  x := rps_everglade(); x.tile = -1; x.clears = 0;
  q := render_plan_shipping(rps_features(), rps_counts(), x, RenderReadiness.ready, true);
  #assert q.status == RenderPlanStatus.ok && q.ops[0].kind == RenderOpKind.cull_early && q.ops[1].kind == RenderOpKind.begin && q.ops[1].colour0 == RenderTarget.light;
  x = rps_everglade(); x.shadow_draws = 0;
  q = render_plan_shipping(rps_features(), rps_counts(), x, RenderReadiness.ready, true);
  #assert q.status == RenderPlanStatus.ok && q.ops[1].colour0 == RenderTarget.light;
  // the scene's own list casts when there is no separate one
  x = rps_everglade(); x.shadow_draws = -1;
  q = render_plan_shipping(rps_features(), rps_counts(), x, RenderReadiness.ready, true);
  #assert q.ops[6].pass == RenderPassId.shadow && q.ops[6].draw_source == RenderDrawSource.records && q.ops[6].count == 40;
  // while the scene's assets are pending nothing casts and nothing is culled
  q = render_plan_shipping(rps_features(), rps_counts(), rps_everglade(), RenderReadiness.background, true);
  #assert q.status == RenderPlanStatus.ok;
  for i: 0..<q.count { #assert q.ops[i].kind != RenderOpKind.cull_early && q.ops[i].kind != RenderOpKind.cull_late && q.ops[i].kind != RenderOpKind.scissor && q.ops[i].pass != RenderPassId.scene_late; }
  f := RenderFeatures.{scene = true, shadow = true}; x = rps_everglade();
  q = render_plan_shipping(f, rps_counts(), x, RenderReadiness.ready, true);
  first := -1; second := -1;
  for i: 0..<q.count { if q.ops[i].kind == RenderOpKind.begin && q.ops[i].colour0 == RenderTarget.screen { if first < 0 { first = i; } else { second = i; } } }
  #assert first > 0 && second > first && q.ops[first].store_depth && !q.ops[first].keep && q.ops[second].keep && !q.ops[second].store_depth;
  x.cull = false; x.cull_runs = 0;
  q = render_plan_shipping(f, rps_counts(), x, RenderReadiness.ready, true);
  for i: 0..<q.count { if q.ops[i].kind == RenderOpKind.begin && q.ops[i].colour0 == RenderTarget.screen { #assert !q.ops[i].store_depth; } }
}

#forall "shipping: the bloom stages drawn are the first n of the five" n: 0..<6 {
  x := rps_everglade(); x.bloom_passes = n;
  q := render_plan_shipping(rps_features(), rps_counts(), x, RenderReadiness.ready, true);
  targets := [5] RenderTarget.[RenderTarget.q0, RenderTarget.q1, RenderTarget.q0, RenderTarget.e1, RenderTarget.e0];
  seen := 0;
  for i: 0..<q.count { if q.ops[i].kind == RenderOpKind.draw && q.ops[i].pass == RenderPassId.bloom { #assert q.ops[i - 1].colour0 == targets[seen]; seen += 1; } }
  #assert q.status == RenderPlanStatus.ok && seen == n;
}

#test "shipping: the host's character casts into the tile only when the engine says so, and is drawn after the opaque scene and its grass" {
  f := RenderFeatures.{scene = true, shadow = true, grass = true, water = true, post = true, water_copy = true};
  c := FrameCounts.{width = 8, height = 8, vertex_stride = 16, draw_count = 5, water_draws = 1, grass_instances = 30};
  x := rps_everglade(); x.character = true; x.grass_last = true;
  q := render_plan_shipping(f, c, x, RenderReadiness.ready, true);
  cast_at := -1; hero_at := -1; grass_at := -1; late_at := -1; wet_at := -1;
  for i: 0..<q.count { o := q.ops[i];
    if o.pass == RenderPassId.character_cast && o.kind == RenderOpKind.draw { cast_at = i; } if o.pass == RenderPassId.character && o.kind == RenderOpKind.draw { hero_at = i; }
    if o.pass == RenderPassId.grass && o.kind == RenderOpKind.draw { grass_at = i; } if o.pass == RenderPassId.scene_late { late_at = i; } if o.kind == RenderOpKind.each_begin { wet_at = i; } }
  #assert q.status == RenderPlanStatus.ok && cast_at < 0 && late_at > 0 && grass_at == late_at + 1 && hero_at == grass_at + 1 && wet_at > hero_at;
  #assert q.ops[hero_at].draw_source == RenderDrawSource.current && q.ops[hero_at].state.valid && q.ops[hero_at].state.depth == RenderDepth.less;
  x.character_cast = true;
  q = render_plan_shipping(f, c, x, RenderReadiness.ready, true);
  #assert q.ops[7].pass == RenderPassId.character_cast && q.ops[6].pass == RenderPassId.shadow && q.ops[8].kind == RenderOpKind.end;
  // grass first when the page blends its scene
  x.grass_last = false; q = render_plan_shipping(f, c, x, RenderReadiness.ready, true);
  for i: 0..<q.count { if q.ops[i].pass == RenderPassId.grass && q.ops[i].kind == RenderOpKind.draw { #assert q.ops[i + 1].pass == RenderPassId.scene; } }
  // one cleared map a frame (no tiles): the character always casts
  x = RenderShipping.{character = true};
  q = render_plan_shipping(f, c, x, RenderReadiness.ready, true);
  #assert q.ops[0].kind == RenderOpKind.begin && !q.ops[0].keep && q.ops[1].pass == RenderPassId.shadow && q.ops[1].count == 4 && q.ops[2].pass == RenderPassId.character_cast && q.ops[3].kind == RenderOpKind.end;
}

#test "shipping: the particles' sort comes after the shadow and before the scene's pass" {
  f := rps_features(); x := rps_everglade(); x.sort = true;
  q := render_plan_shipping(f, rps_counts(), x, RenderReadiness.ready, true);
  #assert q.ops[8].kind == RenderOpKind.particle_sort && q.ops[7].kind == RenderOpKind.end && q.ops[9].kind == RenderOpKind.begin;
  // before the particles' group is in, the sort still runs (its first result makes the group); with no scene drawn it does not
  q = render_plan_shipping(f, rps_counts(), x, RenderReadiness.ready, false);
  #assert q.ops[8].kind == RenderOpKind.particle_sort;
  q = render_plan_shipping(f, rps_counts(), x, RenderReadiness.background, true);
  for i: 0..<q.count { #assert q.ops[i].kind != RenderOpKind.particle_sort; }
}

#forall "shipping: facts that do not hold together give no program" bad: 0..<18 {
  f := rps_features(); x := rps_everglade();
  if bad == 0 { x.tile = 4; } if bad == 1 { x.tile = -2; } if bad == 2 { x.tile_count = 9; } if bad == 3 { x.clears = 16; }
  if bad == 4 { x.rects[3][0] = 32768; } if bad == 5 { x.rects[0][2] = 0; } if bad == 6 { x.rects[2][1] = -1; } if bad == 7 { x.shadow_draws = -2; }
  if bad == 8 { x.cull_runs = 0; } if bad == 9 { f.shadow = false; } if bad == 10 { x.character_cast = true; } if bad == 11 { x.bloom_passes = 6; }
  if bad == 12 { x.bloom_passes = -1; } if bad == 13 { x.tiles = false; } if bad == 14 { x.sort = true; f.particles = false; } if bad == 15 { x.clears = -1; }
  if bad == 16 { x.tile_count = -1; x.tile = -1; x.clears = 0; } if bad == 17 { x.rects[1][3] = 0; }
  q := render_plan_shipping(f, rps_counts(), x, RenderReadiness.ready, true);
  #assert !render_shipping(f, x) && q.status == RenderPlanStatus.invalid && q.count == 0;
}
#test "shipping: the largest sets are admitted; a character needs a scene and its shadow" {
  f := rps_features(); x := rps_everglade(); x.tile_count = 8; x.tile = 7; x.clears = 255; x.cull_runs = 4294967295; x.shadow_draws = 4294967295; x.character = true; x.character_cast = true; x.sort = true;
  for k: 0..<8 { x.rects[k] = [4] int.[32767, 32767, 32767, 32767]; }
  #assert render_shipping(f, x);
  q := render_plan_shipping(f, rps_counts(), x, RenderReadiness.ready, true);
  #assert q.status == RenderPlanStatus.ok && q.count == 49;
  #assert !render_shipping(RenderFeatures.{scene = true}, RenderShipping.{character = true}) && !render_shipping(RenderFeatures.{}, RenderShipping.{cull = true, cull_runs = 1});
  #assert render_shipping(RenderFeatures.{}, RenderShipping.{}) && !render_shipping(RenderFeatures.{scene = true}, RenderShipping.{shadow_draws = 0});
}
#forall "shipping: the new passes' pipeline states" p: 14..<18 {
  f := rps_features(); s := render_pass_state(f, cast(RenderPassId) p);
  #assert s.valid && s.depth_write && s.outputs == (ifx p < 16 then 0 else 2) && s.depth == (ifx p == 14 then RenderDepth.always else RenderDepth.less);
  #assert s.bias == (ifx p == 15 then 2 else 0) && s.slope == s.bias;
  #assert !render_pass_state(RenderFeatures.{}, cast(RenderPassId) p).valid;
  #assert render_pass_state(RenderFeatures.{scene = true}, cast(RenderPassId) p).valid == (p >= 16);
}
