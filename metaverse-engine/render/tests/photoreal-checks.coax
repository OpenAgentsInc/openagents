// Checks that hold the photoreal style's two halves together: the frame's writer on the CPU
// (metaverse-engine/render/shade/photoreal-frame.coax) carries the shaders' sky and film in
// scalars, because a page's own program cannot load the shaders' vector types beside its own.
// Here both are loaded, and each number is compared with the shader's.
//   coax/bin/coax test --library metaverse-engine/render/tests/photoreal-checks.coax
#load "../shade/photoreal.coax";
#load "../shade/photoreal-frame.coax";

prc_near :: (a: f32, b: f32) -> bool { return abs(a - b) <= 0.00002 + 0.0002 * abs(b); }
#test "the writer's sky, far air, sunlight and day are the shaders' atmosphere, direction by direction" {
  heights := [9] f32.[-0.35, -0.2, -0.1, -0.02, 0, 0.03, 0.21, 0.6, 1];
  for h: 0..<9 {
    a := 0.7f32 + cast(f32) h;
    r := sqrt(1 - heights[h] * heights[h]);
    sun := [3] f32.[cos(a) * r, heights[h], sin(a) * r];
    light := atmo_sunlight(sun[1]); mine := pr_frame_sunlight(sun[1], 0);
    #assert prc_near(mine[0], light.x) && prc_near(mine[1], light.y) && prc_near(mine[2], light.z);
    #assert prc_near(pr_frame_day(sun[1]), atmo_day(sun[1]));
    for k: 0..<PR_SKY_SAMPLES {
      d := pr_sky_direction(k);
      c := atmo_sky(v3(d[0], d[1], d[2]), v3(sun[0], sun[1], sun[2]));
      m := pr_frame_air(d, sun, 0);
      #assert prc_near(m[0], c.x) && prc_near(m[1], c.y) && prc_near(m[2], c.z);
      f := atmo_far(v3(d[0], d[1], d[2]), v3(sun[0], sun[1], sun[2]));
      g := pr_frame_far(d, sun, 0);
      #assert prc_near(g[0], f.x) && prc_near(g[1], f.y) && prc_near(g[2], f.z);
    }
  }
}
#test "the writer's display colour and its sky are the shader's pr_out and pr_sky" {
  u: [PR_FLOATS + 8] f32;
  pr_frame_sky(u[..], 4, PrSky.{sun = [3] f32.[0.5, 0.21, 0.84], sea_level = 0, warm = 0.08});
  levels := [7] f32.[0, 0.004, 0.05, 0.18, 0.6, 1.4, 9];
  for i: 0..<7 {
    c := [3] f32.[levels[i], levels[(i + 2) % 7], levels[(i + 5) % 7]];
    a := pr_out(v3(c[0], c[1], c[2]), u[..], 4);
    m := pr_frame_out(u[..], 4, c);
    #assert prc_near(m[0], a.x) && prc_near(m[1], a.y) && prc_near(m[2], a.z);
  }
  // and in twilight, with the camera's balance for a cool light
  dusk: [PR_FLOATS + 8] f32;
  pr_frame_sky(dusk[..], 4, PrSky.{sun = [3] f32.[0.8, -0.04, 0.6], sea_level = 0, warm = 0.08});
  pr_frame_balance(dusk[..], 4, 0.85);
  #assert dusk[4 + PR_BALANCE_R] > 0.3 && dusk[4 + PR_BALANCE_B] < -0.4;
  for i: 0..<7 {
    c := [3] f32.[levels[i], levels[(i + 2) % 7], levels[(i + 5) % 7]];
    a := pr_out(v3(c[0], c[1], c[2]), dusk[..], 4);
    m := pr_frame_out(dusk[..], 4, c);
    #assert prc_near(m[0], a.x) && prc_near(m[1], a.y) && prc_near(m[2], a.z);
  }
  for k: 0..<PR_SKY_SAMPLES {
    d := pr_sky_direction(k);
    if d[1] < 0 { continue; }
    a := pr_sky(v3(d[0], d[1], d[2]), u[..], 4);
    m := pr_frame_sky_at(u[..], 4, d);
    #assert prc_near(m[0], a.x) && prc_near(m[1], a.y) && prc_near(m[2], a.z);
  }
  // and the nine numbers give back the sky's light the shader reads
  for k: 0..<12 {
    d := pr_sky_direction(k * 8);
    a := pr_sky_light(v3(d[0], d[1], d[2]), u[..], 4);
    m := pr_frame_sky_light(u[..], 4, d[0], d[1], d[2]);
    #assert prc_near(m[0], a.x) && prc_near(m[1], a.y) && prc_near(m[2], a.z);
  }
}
#test "the camera's balance for a cool light, worked from the light on level ground as the shaders read it" {
  heights := [8] f32.[-0.3, -0.18, -0.08, -0.02, 0.03, 0.2, 0.7, 0.012];
  shares := [3] f32.[0, 0.5, 1];
  for h: 0..<8 { for j: 0..<3 {
    u: [PR_FLOATS + 8] f32;
    r := sqrt(1 - heights[h] * heights[h]);
    pr_frame_sky(u[..], 4, PrSky.{sun = [3] f32.[0.6 * r, heights[h], 0.8 * r], haze = 0.1});
    pr_frame_balance(u[..], 4, shares[j]);
    // the light on level ground: the sun's on it and the sky's from overhead (pr_sky_light facing up)
    sky := pr_sky_light(v3(0, 1, 0), u[..], 4);
    up := st_max(heights[h], 0);
    key := v3(u[4 + PR_SUN_LIGHT] * up + sky.x, u[4 + PR_SUN_LIGHT + 1] * up + sky.y, u[4 + PR_SUN_LIGHT + 2] * up + sky.z);
    // its cast past a clear day's sky, red under 0.8 of green and blue over 1.3 of it, by the share,
    // fading out between nautical twilight and night
    fade := smoothstep(-0.2419219, -0.12, heights[h]);
    k := shares[j] * fade;
    red := key.x / key.y / 0.8f32; blue := key.z / key.y / 1.3f32;
    want_r := pow(st_min(red, 1), 0 - k) - 1; want_b := pow(st_max(blue, 1), 0 - k) - 1;
    #assert prc_near(u[4 + PR_BALANCE_R], want_r) && prc_near(u[4 + PR_BALANCE_B], want_b);
    if j == 0 || h == 0 { #assert u[4 + PR_BALANCE_R] == 0 && u[4 + PR_BALANCE_B] == 0; }
    if h == 3 && j == 2 { #assert want_r > 0.3 && want_b < -0.4; }   // twilight: a strong cast, much of it balanced
  } }
}
#test "with haze the writer's sky, far air and sunlight are the shader's; with none the shader's are the engine's atmosphere" {
  heights := [5] f32.[-0.1, 0, 0.08, 0.21, 0.8];
  hazes := [3] f32.[0, 0.05, 0.2];
  for h: 0..<5 { for z: 0..<3 {
    a := 0.3f32 + cast(f32) h;
    r := sqrt(1 - heights[h] * heights[h]);
    sun := [3] f32.[cos(a) * r, heights[h], sin(a) * r];
    sv := v3(sun[0], sun[1], sun[2]);
    light := mul3(atmo_sunlight(sun[1]), pr_haze_through(sun[1], hazes[z])); mine := pr_frame_sunlight(sun[1], hazes[z]);
    #assert prc_near(mine[0], light.x) && prc_near(mine[1], light.y) && prc_near(mine[2], light.z);
    for k: 0..<PR_SKY_SAMPLES {
      d := pr_sky_direction(k);
      dv := v3(d[0], d[1], d[2]);
      c := pr_air_light(dv, sv, hazes[z]);
      m := pr_frame_air(d, sun, hazes[z]);
      #assert prc_near(m[0], c.x) && prc_near(m[1], c.y) && prc_near(m[2], c.z);
      f := pr_air_far(dv, sv, hazes[z]);
      g := pr_frame_far(d, sun, hazes[z]);
      #assert prc_near(g[0], f.x) && prc_near(g[1], f.y) && prc_near(g[2], f.z);
      if z == 0 {
        e := atmo_sky(dv, sv);
        #assert prc_near(c.x, e.x) && prc_near(c.y, e.y) && prc_near(c.z, e.z);
      }
    }
  } }
  // haze pales the sky overhead and reddens and dims a low sun
  sun := v3(-0.92f32, 0.21f32, 0.33f32);
  clear := pr_air_light(v3(0, 1, 0), sun, 0); hazy := pr_air_light(v3(0, 1, 0), sun, 0.15);
  #assert hazy.z / hazy.x < clear.z / clear.x * 0.7;
  a := pr_frame_sunlight(0.21, 0); b := pr_frame_sunlight(0.21, 0.15);
  #assert b[0] < a[0] && b[0] / b[2] > a[0] / a[2] * 1.3;
}
#test "under thick cloud the writer's sky is the shader's, and both take the same share of the sun" {
  covers := [5] f32.[0, 0.45, 0.6, 0.8, 1];
  for j: 0..<5 {
    u: [PR_FLOATS + 8] f32;
    pr_frame_sky(u[..], 4, PrSky.{sun = [3] f32.[0.5, 0.21, 0.84], cover = covers[j], haze = 0.3, sky_share = ifx j == 3 then 0.45f32 else -1.0f32});
    #assert prc_near(pr_cloud_shade(u[..], 4), pr_overcast(covers[j]));
    for k: 0..<PR_SKY_SAMPLES {
      d := pr_sky_direction(k);
      if d[1] < 0 { continue; }
      a := pr_sky(v3(d[0], d[1], d[2]), u[..], 4);
      m := pr_frame_sky_at(u[..], 4, d);
      #assert prc_near(m[0], a.x) && prc_near(m[1], a.y) && prc_near(m[2], a.z);
      if covers[j] >= 1 { #assert a.z - a.x < 0.02 && a.x - a.z < 0.02; }   // a full cover's sky is grey
    }
  }
}
#test "a leaning record stands a part rolled, then pitched, then turned, at its stretch; any other record is as it was" {
  // a record as the shader reads it: a ship 2 m by 1 by 1 at (10, 0, 20), turned a quarter, pitched 0.3 and rolled 0.2
  m := PrObj.{a = v4(10, 0, 20, 1.5707963), b = v4(0.2, 4, 0.3, 1), c = v4(1, 1, 1, 0), d = v4(2, 1, 1, 0)};
  // its bow (+x, one unit): pitched up by 0.3, then turned a quarter: +x runs along (cos yaw, 0, -sin yaw) = (0, 0, -1)
  bow := pr_placed(v3(1, 0, 0), m, 0);
  #assert prc_near(bow.x, 10) && prc_near(bow.y, 2 * sin(0.3f32)) && prc_near(bow.z, 20 - 2 * cos(0.3f32));
  // its mast (+y): rolled toward +z by 0.2, then pitched back by 0.3
  top := pr_leant(v3(0, 1, 0), m);
  #assert prc_near(top.x, 0 - cos(0.2f32) * sin(0.3f32)) && prc_near(top.y, cos(0.2f32) * cos(0.3f32)) && prc_near(top.z, sin(0.2f32));
  // the lean keeps lengths
  q := pr_leant(v3(0.3, -0.7, 0.5), m);
  #assert prc_near(q.x * q.x + q.y * q.y + q.z * q.z, 0.09f32 + 0.49f32 + 0.25f32);
  // with no stretch it is a metre a metre: its scale's float is the roll
  bare := PrObj.{a = v4(0, 0, 0, 0), b = v4(0.2, 4, 0.3, 0), c = v4(1, 1, 1, 0), d = v4(0, 0, 0, 0)};
  #assert pr_sizes(bare).x == 1 && pr_sizes(bare).y == 1;
  // a still record of the same numbers does not lean
  still := PrObj.{a = v4(10, 0, 20, 0), b = v4(3, 0, 0.3, 1), c = v4(1, 1, 1, 0), d = v4(0, 0, 0, 0)};
  p := pr_placed(v3(1, 1, 0), still, 0);
  #assert p.x == 13 && p.y == 3 && p.z == 20;
}
#test "a record's sizes, sway, bob, lean and turn, each at its edges, against numbers worked by hand" {
  m:PrObj;
  // a stretch with one zero is still the stretch
  m.d=v4(0.0f32,2.0f32,3.0f32,0.0f32); s:V3=pr_sizes(m); #assert s.x==0.0f32 && s.y==2.0f32 && s.z==3.0f32;
  m.d=v4(2.0f32,3.0f32,0.0f32,0.0f32); s=pr_sizes(m); #assert s.x==2.0f32 && s.y==3.0f32 && s.z==0.0f32;
  m.d=v4(2.0f32,0.0f32,0.0f32,0.0f32); s=pr_sizes(m); #assert s.x==2.0f32 && s.y==0.0f32 && s.z==0.0f32;
  // no stretch: the scale, unless the record leans (motion 4), when it is a metre a metre
  m.d=v4(0.0f32,0.0f32,0.0f32,0.0f32); m.b=v4(2.0f32,3.5f32,0.0f32,0.0f32); s=pr_sizes(m); #assert s.x==2.0f32 && s.y==2.0f32 && s.z==2.0f32;
  m.b.y=4.0f32; s=pr_sizes(m); #assert s.x==1.0f32 && s.y==1.0f32 && s.z==1.0f32;
  // the lean: roll 0.3 about x, then pitch 0.5 about z; below motion 3.5 nothing leans
  m.b=v4(0.3f32,3.5f32,0.5f32,0.0f32);
  cr:f32=cos(0.3f32); sr:f32=sin(0.3f32); cp:f32=cos(0.5f32); sp:f32=sin(0.5f32);
  y:f32=2.0f32*cr-3.0f32*sr; z:f32=2.0f32*sr+3.0f32*cr;
  q:V3=pr_leant(v3(1.0f32,2.0f32,3.0f32),m);
  #assert abs(q.x-(cp-y*sp))<0.0001f32 && abs(q.y-(sp+y*cp))<0.0001f32 && abs(q.z-z)<0.0001f32;
  // a leaning record's part is leant where it is placed
  m.b.y=4.0f32; m.d=v4(1.0f32,1.0f32,1.0f32,0.0f32); w0:V3=pr_placed(v3(1.0f32,2.0f32,3.0f32),m,0.0f32);
  #assert abs(w0.x-(cp-y*sp))<0.0001f32 && abs(w0.y-(sp+y*cp))<0.0001f32 && abs(w0.z-z)<0.0001f32;
  m.b.y=3.4f32; q=pr_leant(v3(1.0f32,2.0f32,3.0f32),m); #assert q.x==1.0f32 && q.y==2.0f32 && q.z==3.0f32;
  // the sway, 10 m up at time 3 and phase 0.4, in pr_placed's light breeze (3 m/s along +x, gusty
  // 0.5): a lean downwind by the squares of speed and height, its own sway and the gusts along the
  // wind, a little across it; motions 1.5, 2.5 and 0 keep still
  m.d=v4(0.0f32,0.0f32,0.0f32,0.0f32); m.a=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  m.b=v4(1.0f32,2.0f32,0.4f32,0.0f32);
  w:V3=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32);
  lean:f32=100.0f32*0.00004f32*9.0f32;
  own:f32=sin(5.7f32+0.4f32)+0.35f32*sin(9.3f32+0.68f32);
  gust:f32=sin((0.0f32-9.0f32)*0.14f32+0.6f32*sin(0.69f32+0.4f32));
  #assert abs(w.x-(lean*(1.0f32+0.5f32*(0.7f32*gust+0.3f32*own))+0.03f32*own))<0.0001f32 && abs(w.y-10.0f32)<0.0001f32;
  #assert abs(w.z-(0.02f32+lean*0.125f32)*sin(3.9f32+0.92f32))<0.0001f32;
  m.b.y=1.5f32; w=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32); #assert w.x==0.0f32 && w.y==10.0f32 && w.z==0.0f32;
  m.b.y=2.5f32; w=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32); #assert w.x==0.0f32 && w.y==10.0f32 && w.z==0.0f32;
  m.b.y=0.0f32; w=pr_placed(v3(0.0f32,10.0f32,0.0f32),m,3.0f32); #assert w.x==0.0f32 && w.y==10.0f32 && w.z==0.0f32;
  // the bob: a quarter metre on sin(0.8 t + phase); motion 0.5 and 1.5 keep still
  m.b.y=1.0f32; w=pr_placed(v3(0.0f32,0.0f32,0.0f32),m,3.0f32); #assert abs(w.y-0.25f32*sin(2.4f32+0.4f32))<0.0001f32 && w.x==0.0f32;
  m.b.y=0.5f32; w=pr_placed(v3(0.0f32,0.0f32,0.0f32),m,3.0f32); #assert w.y==0.0f32;
  m.b.y=1.5f32; w=pr_placed(v3(0.0f32,0.0f32,0.0f32),m,3.0f32); #assert w.y==0.0f32;
  // the turn: a quarter turn sends (1, 0, 2) to (2, 0, -1)
  m.b.y=0.0f32; m.a.w=1.5707963f32; w=pr_placed(v3(1.0f32,0.0f32,2.0f32),m,0.0f32);
  #assert abs(w.x-2.0f32)<0.0001f32 && abs(w.y)<0.0001f32 && abs(w.z+1.0f32)<0.0001f32;
}
#test "a vertex stands where its record puts it: sized, leant, turned, posed, tinted, its facts carried" {
  u:[PR_FLOATS]f32; pr_test_block(u[..]);
  mesh:[36]f32;
  // vertex 0: at (1, 0, 0), facing up, pattern 3, tinted (0.5, 0.8, 0); vertex 1: at (0, 1, 0.5), facing (1, 1, 2), tinted (0, 0.5, 0)
  mesh[0]=1.0f32; mesh[4]=1.0f32; mesh[6]=3.0f32; mesh[9]=0.5f32; mesh[10]=0.8f32;
  mesh[13]=1.0f32; mesh[14]=0.5f32; mesh[15]=1.0f32; mesh[16]=1.0f32; mesh[17]=2.0f32; mesh[18]=2.0f32; mesh[22]=0.5f32;
  objects:[2]PrObj;
  // record 0 leans: roll 0.3, pitch 0.5, stretched 2 along x, at (10, 0, 20), on its own (not on the platform)
  objects[0].a=v4(10.0f32,0.0f32,20.0f32,0.0f32); objects[0].b=v4(0.3f32,4.0f32,0.5f32,1.0f32);
  objects[0].c=v4(0.5f32,0.6f32,0.7f32,0.2f32); objects[0].d=v4(2.0f32,1.0f32,1.0f32,0.0f32);
  v:PrV=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  cr:f32=cos(0.3f32); sr:f32=sin(0.3f32); cp:f32=cos(0.5f32); sp:f32=sin(0.5f32);
  #assert abs(v.world.x-(10.0f32+2.0f32*cp))<0.0001f32 && abs(v.world.y-2.0f32*sp)<0.0001f32 && abs(v.world.z-20.0f32)<0.0001f32;
  #assert abs(v.local.x-2.0f32)<0.0001f32 && v.local.y==0.0f32 && v.local.z==0.0f32;
  #assert abs(v.normal.x+cr*sp)<0.0001f32 && abs(v.normal.y-cr*cp)<0.0001f32 && abs(v.normal.z-sr)<0.0001f32;
  #assert v.facing.x==0.0f32 && v.facing.y==1.0f32 && v.facing.z==0.0f32;
  #assert abs(v.tint.x-0.25f32)<0.0001f32 && abs(v.tint.y-0.48f32)<0.0001f32 && v.tint.z==0.0f32;
  #assert v.info.x==3.0f32 && abs(v.info.y-0.2f32)<0.0001f32 && v.info.z==0.0f32 && v.info.w==1.0f32;
  c0:V4=pr_clip(v.world,u[..],0);
  #assert abs(v.pos.x-c0.x)<0.0001f32 && abs(v.pos.w-c0.w)<0.0001f32 && abs(v.pos.z-(c0.z-0.0000006f32*c0.w))<0.0000001f32;
  // drawn only within 5 m of the eye, 22 m away: all of it is drawn in to its record's place
  objects[0].b.w=6.0f32;
  v=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  #assert abs(v.world.x-10.0f32)<0.0001f32 && abs(v.world.y)<0.0001f32 && abs(v.world.z-20.0f32)<0.0001f32;
  // motion 3.5 lies on a surface but keeps its phase; its own pattern of 0.5 is no pattern
  objects[0].b=v4(1.0f32,3.5f32,0.5f32,1.0f32); objects[0].d.w=0.5f32;
  v=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  #assert v.info.z==0.5f32 && v.info.x==3.0f32;
  // motion 2.5 sits at its own depth
  objects[0].b=v4(1.0f32,2.5f32,0.0f32,1.0f32); objects[0].d=v4(0.0f32,0.0f32,0.0f32,0.0f32);
  v=pr_stand(cast(u32)0,cast(u32)0,u[..],0,mesh[..],objects[..]);
  c0=pr_clip(v.world,u[..],0);
  #assert abs(v.pos.z-c0.z)<0.0000001f32;
  // record 1 bobs on a turned, moved platform at time 3: a quarter turn, stretched (2, 4, 1), its own pattern 5, phase 0.7
  c:f32=cos(0.3f32); s:f32=sin(0.3f32);
  u[PR_POSE]=c; u[PR_POSE+1]=0.0f32-s; u[PR_POSE+3]=4.0f32; u[PR_POSE+4]=s; u[PR_POSE+5]=c; u[PR_POSE+7]=0.0f32-2.0f32; u[PR_POSE+11]=7.0f32;
  u[PR_UP+3]=3.0f32;
  objects[1].a=v4(3.0f32,1.0f32,2.0f32,1.5707963f32); objects[1].b=v4(1.0f32,1.0f32,0.7f32,0.0f32);
  objects[1].c=v4(0.4f32,0.5f32,0.6f32,0.9f32); objects[1].d=v4(2.0f32,4.0f32,0.5f32,5.0f32);
  e:PrV=pr_stand(cast(u32)1,cast(u32)1,u[..],0,mesh[..],objects[..]);
  // the part's (0, 4, 0.25), bobbed, turned a quarter is (0.25, 4 + bob, 0), set at (3, 1, 2), then posed
  bob:f32=0.25f32*sin(2.4f32+0.7f32);
  want:V3=pr_posed(v3(3.25f32,5.0f32+bob,2.0f32),u[..],0);
  #assert abs(e.world.x-want.x)<0.0001f32 && abs(e.world.y-want.y)<0.0001f32 && abs(e.world.z-want.z)<0.0001f32;
  #assert abs(e.local.x)<0.0001f32 && abs(e.local.y-4.0f32)<0.0001f32 && abs(e.local.z-0.25f32)<0.0001f32;
  // the normal (1, 1, 2) under sizes (2, 4, 0.5) is (1/2, 1/4, 4), normalised, turned to (4, 1/4, -1/2), posed
  n:V3=normalize3(v3(0.5f32,0.25f32,4.0f32));
  wn:V3=pr_posed_dir(v3(n.z,n.y,0.0f32-n.x),u[..],0);
  #assert abs(e.normal.x-wn.x)<0.0001f32 && abs(e.normal.y-wn.y)<0.0001f32 && abs(e.normal.z-wn.z)<0.0001f32;
  #assert abs(e.facing.x-n.x)<0.0001f32 && abs(e.facing.y-n.y)<0.0001f32 && abs(e.facing.z-n.z)<0.0001f32;
  #assert e.tint.x==0.0f32 && abs(e.tint.y-0.25f32)<0.0001f32 && e.tint.z==0.0f32;
  #assert e.info.x==5.0f32 && abs(e.info.y-0.9f32)<0.0001f32 && abs(e.info.z-0.7f32)<0.0001f32 && e.info.w==0.0f32;
  c1:V4=pr_clip(e.world,u[..],0);
  #assert abs(e.pos.x-c1.x)<0.0001f32 && abs(e.pos.y-c1.y)<0.0001f32 && abs(e.pos.z-c1.z)<0.0000001f32 && abs(e.pos.w-c1.w)<0.0001f32;
  // from 0.5 up a record stands on its own, off the platform
  objects[1].b.w=0.5f32;
  e=pr_stand(cast(u32)1,cast(u32)1,u[..],0,mesh[..],objects[..]);
  #assert abs(e.world.x-3.25f32)<0.0001f32 && abs(e.world.z-2.0f32)<0.0001f32;
  // a vertex with no tint of its own takes the record's whole
  e=pr_stand(cast(u32)2,cast(u32)1,u[..],0,mesh[..],objects[..]);
  #assert abs(e.tint.x-0.4f32)<0.0001f32 && abs(e.tint.y-0.5f32)<0.0001f32 && abs(e.tint.z-0.6f32)<0.0001f32;
}
