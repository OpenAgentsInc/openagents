#test "reference oversized working allocation cannot grant uniform words to shader scratch" {
 counts:=FrameCounts.{width=2,height=2,vertex_stride=16};uniforms:[60]f32;uniforms[0]=2;uniforms[1]=2;
 bg:=RF_ARENA_TREE;hud:=RF_WATCH_HUD;shaders:=[2]RFShader.[RFShader.{tree=bg[..]},RFShader.{index=12,tree=hud[..]}];
 images:[4]RQColor;target:[4]RRPixel;scratch:[4]RRPixel;words:[200000]u32;meta:[114688]int;domains:[]RenderDrawDomain;decoded:[]RenderDecodedDraw;out:[5]RQColor;for j:0..<5 {out[j].r=91;}
 work:=RFWorking.{images=images[..],target=target[..],scratch=scratch[..],words=words[..],meta=meta[..],domains=domains,decoded=decoded};
 r:=rf_run(RFInput.{profile=15,counts=counts,uniforms=uniforms[..]},shaders[..],false,RenderTextureFormat.rgba8,RFPolicy.{},work,out[..]);
 #assert r.status==RQStatus.capacity && r.geometry==RenderGeometryStatus.ok && r.frame==RenderFrameStatus.ok && r.bad_shader== -1 && r.draws==0 && r.written==0;
 #assert words[65536]==f32_bits(2) && words[65537]==f32_bits(2);for j:0..<5 {#assert out[j].r==91;}
}
