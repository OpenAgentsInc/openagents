#test "reference layout maps actual media uniform image and sampler names and stage roles" {
  tree:=RFL_MEDIA_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);
  #assert p.status==RQStatus.ok;
  for profile:[2]int.[2,13] {
    r:=rf_shader_layout(profile,13,p,tree[..],meta[..]);
    #assert r.status==RQStatus.ok && r.pipeline.has_fragment && r.count==3 && r.attribute_count==0 && r.attribute_stride==0;
    ids:=[3]int.[2,4,5];
    for i:0..<3 {
      #assert r.bindings[i].name_id==ids[i] && r.bindings[i].kind==i+1 && r.bindings[i].resource==i;
      use:=rf_shader_use(profile,13,i);
      #assert use.resource==i && use.slot==i && use.native_kind==i+1 && use.shape==0;
      #assert use.stages==(ifx i==0 then 3 else 2) && use.stride==(ifx i==0 then 4 else 0);
    }
  }
  #assert rf_shader_layout(15,13,p,tree[..],meta[..]).status==RQStatus.resource;
  #assert rf_shader_layout(-1,13,p,tree[..],meta[..]).status==RQStatus.resource;
  #assert rf_shader_layout(2,-1,p,tree[..],meta[..]).status==RQStatus.resource;
  #assert rf_shader_layout(2,14,p,tree[..],meta[..]).status==RQStatus.resource;
}
#test "reference layout admits the real vertex-only caster and rejects both fragment-presence mismatches" {
  caster:=RP_CATALOG_CASTER_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(caster[..],meta[..]);
  r:=rf_catalog_layout(7,RenderPassId.caster,p,caster[..],meta[..]);
  #assert r.status==RQStatus.ok && !r.pipeline.has_fragment && r.count==1;
  #assert r.bindings[0].resource==0 && r.bindings[0].kind==1;
  #assert rf_shader_use(7,2,0).stages==1;
  #assert rf_catalog_layout(15,RenderPassId.background,p,caster[..],meta[..]).status==RQStatus.unsupported;
  pair:=RFL_PAIR_TREE;p=rq_ir_prepare(pair[..],meta[..]);
  #assert rf_catalog_layout(7,RenderPassId.caster,p,pair[..],meta[..]).status==RQStatus.unsupported;
}
#test "reference layout propagates preparation and pipeline failures before mapping any resources" {
  mismatch:=RP_MISMATCH_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(mismatch[..],meta[..]);
  #assert p.status==RQStatus.ok;
  r:=rf_catalog_layout(15,RenderPassId.background,p,mismatch[..],meta[..]);
  #assert r.status==RQStatus.unsupported && r.count==0;
  three:=RP_THREE_TREE;p=rq_ir_prepare(three[..],meta[..]);
  #assert p.status==RQStatus.ok;
  #assert rf_catalog_layout(15,RenderPassId.background,p,three[..],meta[..]).status==RQStatus.capacity;
  p.status=RQStatus.capacity;
  #assert rf_catalog_layout(15,RenderPassId.background,p,three[..],meta[..]).status==RQStatus.capacity;
}
#forall "reference layout refuses missing extra wrongly typed strided or single-stage catalog resources" variant:0..<5 {
  empty:=RFL_EMPTY_TREE;extra:=RFL_EXTRA_TREE;kind:=RFL_KIND_TREE;stride:=RFL_STRIDE_TREE;stage:=RFL_PAIR_TREE;
  tree:[]u32=empty[..];if variant==1 {tree=extra[..];}if variant==2 {tree=kind[..];}if variant==3 {tree=stride[..];}if variant==4 {tree=stage[..];}
  meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree,meta[..]);#assert p.status==RQStatus.ok;
  r:=rf_catalog_layout(15,RenderPassId.background,p,tree,meta[..]);
  #assert r.status==RQStatus.unsupported;
  if variant==0 {#assert r.count==0;}
  if variant==1 {#assert r.count==1;}
  if variant==2 {#assert rq_ir_parameter(p,tree,meta[..],1,1).kind==2;}
  if variant==3 {#assert rq_ir_parameter(p,tree,meta[..],0,2).stride==8;}
  if variant==4 {#assert rr_pipeline(p,tree,meta[..]).vs.params==3 && r.count==1;}
}
#test "reference layout preserves an actual fragment-only uniform without inventing a vertex use" {
  tree:=RFL_STAGE_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);
  r:=rf_catalog_layout(15,RenderPassId.background,p,tree[..],meta[..]);
  #assert r.status==RQStatus.ok && r.count==1 && r.bindings[0].resource==0 && r.bindings[0].kind==1;
  #assert r.pipeline.vs.params==2 && r.pipeline.fs.params==2 && r.attribute_count==0 && r.attribute_stride==0;
  #assert rf_shader_use(15,0,0).stages==2;
}
#forall "reference layout observes independent image and sampler shape mismatches" comparison:bool {
  array:=RFL_ARRAY_TREE;compare:=RFL_COMPARE_TREE;tree:[]u32=array[..];if comparison {tree=compare[..];}
  meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree,meta[..]);#assert p.status==RQStatus.ok;
  r:=rf_shader_layout(2,13,p,tree,meta[..]);#assert r.status==RQStatus.unsupported;
  at:=ifx comparison then 3 else 2;arg:=rq_ir_parameter(p,tree,meta[..],1,at);
  #assert arg.shape==1 && arg.kind==(ifx comparison then 3 else 2);
  #assert r.count==(ifx comparison then 2 else 1);
}
#forall "reference layout admits exact four and256byte attribute extents and refuses260" variant:0..<3 {
  small:=RFL_SMALL_TREE;large:=RFL_LARGE_TREE;maximal:=RFL_MAX_TREE;tree:[]u32=small[..];if variant==1 {tree=maximal[..];}if variant==2 {tree=large[..];}
  meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree,meta[..]);#assert p.status==RQStatus.ok;
  r:=rf_catalog_layout(15,RenderPassId.background,p,tree,meta[..]);
  if variant==2 {#assert r.status==RQStatus.unsupported;}
  else {
    count:=ifx variant==0 then 1 else 16;stride:=ifx variant==0 then 1 else 64;components:=ifx variant==0 then 1 else 4;
    #assert r.status==RQStatus.ok && r.count==1 && r.attribute_count==count && r.attribute_stride==stride;
    for i:0..<count {#assert r.attributes[i].location==i && r.attributes[i].offset==i*components && r.attributes[i].components==components;}
  }
}
#forall "reference layout refuses odd total bytes and misaligned actual attribute fields after fresh preparation" field_offset:bool {
  tree:=RF_WATCH_HUD;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);
  attrs:=rr_pipeline(p,tree[..],meta[..]).vs.attributes_type;at:=rq_ir_type(meta[..],attrs,1);count:=cast(int)tree[at+1];
  #assert count==4;
  if field_offset {
    for i:0..<count {tree[at+3+i*2]+=1;}tree[at+2+count*2]+=4;
  }else {tree[at+2+count*2]+=1;}
  p=rq_ir_prepare(tree[..],meta[..]);#assert p.status==RQStatus.ok;
  #assert rf_catalog_layout(15,RenderPassId.hud,p,tree[..],meta[..]).status==RQStatus.unsupported;
}
