RQ_IR_LITERAL_TREE :: [98]u32.[2,7,0,1,2,3,4,5,7,4,2,0,2,4,2,8,2,12,16,2,6,1,6,2,6,5,41,1,2,3,40,1,16,5,2596069104,305419896,4,22,1,4,29,2,19,14,18,1,16,5,65535,0,29,2,19,18,18,1,16,5,32,0,27,41,40,0,0,16,2,1065353216,6,4,2,2,2,2,4,2,2,2,2,14,1,1,4,31,6,4,18,0,18,1,18,2,18,3,1,1,0,0];

#test "quad actual checked control tree preserves lane returns loops masks unary and field values" {
 tree:=RQ_IR_RUNTIME_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);#assert p.status==RQStatus.ok;
 input:[16]u32;memory:[8192]u32;out:[16]u32;
 for lane:0..<4 {input[lane*4]=f32_bits(cast(f32)lane);input[lane*4+1]=f32_bits(cast(f32)(2+lane*2));input[lane*4+3]=1065353216;}
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],1,100000,15,RQDerivative.fine);
 #assert r.status==RQStatus.ok && r.publish_mask==15 && r.output_words==16;
 expected:=[16]f32.[-2,1,2,3,13,1,0,14,26.5,2.6931471806,1,16,36.3333320618,4.0986123085,1,18];
 for j:0..<16 {#assert abs(f32_from_bits(out[j])-expected[j])<0.00001f32;}
}
#test "quad actual checked signed64 literal retains its high and low halves before conversion" {
 tree:=RQ_IR_LITERAL_TREE;meta:[RQ_IR_META]int;p:=rq_ir_prepare(tree[..],meta[..]);#assert p.status==RQStatus.ok;
 input:[16]u32;memory:[4096]u32;out:[16]u32;for lane:0..<4 {input[lane*4]=f32_bits(cast(f32)lane);}
 r:=rq_ir_run(p,tree[..],meta[..],input[..],RQResources.{},memory[..],out[..],1,100000,15,RQDerivative.fine);#assert r.status==RQStatus.ok;
 for lane:0..<4 {#assert f32_from_bits(out[lane*4])==57072 && f32_from_bits(out[lane*4+1])==305419904 && f32_from_bits(out[lane*4+2])==cast(f32)lane && f32_from_bits(out[lane*4+3])==1;}
}
