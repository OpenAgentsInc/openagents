rq_ir_body_fixture :: (body:[]u32,version:u32,tree:[]u32,meta:[]int)->RQProgram {
 original:=RQ_IR_TEST_TREE;for j:0..<26 {tree[j]=original[j];}tree[0]=version;tree[20]=0;tree[25]=cast(u32)body.count;
 for j:0..<body.count {tree[26+j]=body[j];}at:=26+body.count;
 tree[at]=1;tree[at+1]=1;tree[at+2]=0;tree[at+3]=0;return rq_ir_prepare(tree[0..<at+4],meta);
}
#forall "quad structural nesting admits its final level and refuses before reading beyond it" kind:0..<3, refused:bool {
 meta:[RQ_IR_META]int;rq_ir_scalar_meta(meta[..]);tree:=[3]u32.[16,2,1065353216];n:=3;
 if kind==0 {tree[0]=40;tree[1]=0;n=2;}if kind==2 {tree[0]=5;n=1;}
 depth:=ifx refused then 24 else 23;m:=[1]RQMachine.[RQMachine.{types=7,procs=1,budget=100,nesting=depth}];
 if kind==0 {rq_ir_shape_place(m[..],tree[0..<n],meta[..]);}else if kind==1 {rq_ir_shape_expr(m[..],tree[0..<n],meta[..]);}else {rq_ir_shape_stmt(m[..],tree[0..<n],meta[..]);}
 #assert m[0].nesting==depth;
 if refused {#assert m[0].status==RQStatus.budget && m[0].at==0 && m[0].steps==0;}
 else {#assert m[0].status==RQStatus.ok && m[0].at==n && m[0].steps==n;}
}
#forall "quad block count admission retains its named exact policy envelope" which:0..<7 {
 counts:=[7]int.[-1,0,1,999999,1000000,1000001,9223372036854775807];allowed:=[7]bool.[false,true,true,true,true,false,false];
 #assert rq_ir_block_count_ok(counts[which])==allowed[which];
}
#forall "quad structural admission refuses malformed nodes before publishing a program" which:0..<24 {
 body:[32]u32;body[0]=2;n:=2;version:u32=3;wanted:=RQStatus.unsupported;
 if which==0 {body[1]=0;}if which==1 {body[1]=26;}
 if which==2 {body[1]=27;body[2]=43;n=3;wanted=RQStatus.malformed;}
 if which==3 {body[0]=0;n=1;}if which==4 {body[0]=12;n=1;}
 if which==5 {body[0]=6;body[1]=2;wanted=RQStatus.malformed;}
 if which==6 || which==7 {body[1]=19;body[2]=ifx which==6 then cast(u32)0 else cast(u32)19;body[3]=17;body[4]=2;body[5]=17;body[6]=2;n=7;}
 if which==8 || which==9 {body[1]=23;body[2]=ifx which==8 then cast(u32)0 else cast(u32)10;body[3]=1;body[4]=17;body[5]=2;n=6;}
 if which==10 || which==11 || which==12 {body[1]=33;body[2]=ifx which==10 then cast(u32)0 else (ifx which==11 then cast(u32)19 else cast(u32)15);body[3]=2;body[4]=1;body[5]=17;body[6]=2;n=7;if which==12 {version=2;}}
 if which==13 || which==14 {body[1]=22;body[2]=ifx which==13 then cast(u32)1 else cast(u32)0;body[3]=ifx which==13 then cast(u32)0 else cast(u32)129;n=4;wanted=ifx which==13 then RQStatus.malformed else RQStatus.capacity;}
 if which==15 || which==16 {body[1]=16;body[2]=ifx which==15 then cast(u32)7 else cast(u32)6;body[3]=0;n=4;wanted=RQStatus.malformed;}
 if which==17 {body[1]=33;body[2]=12;body[3]=7;body[4]=0;n=5;wanted=RQStatus.malformed;}
 if which==18 {body[0]=1;body[1]=1000001;wanted=RQStatus.capacity;}
 if which==19 {body[1]=31;body[2]=6;body[3]=3;for j:0..<3 {body[4+j*2]=17;body[5+j*2]=2;}n=10;wanted=RQStatus.malformed;}
 if which==20 {body[1]=31;body[2]=2;body[3]=0;n=4;}
 if which==21 {body[1]=22;body[2]=0;body[3]=0;n=4;wanted=RQStatus.malformed;}
 if which==22 {body[1]=23;body[2]=1;body[3]=0;n=4;}
 if which==23 {body[1]=33;body[2]=12;body[3]=2;body[4]=0;n=5;wanted=RQStatus.malformed;}
 tree:[256]u32;meta:[RQ_IR_META]int;p:=rq_ir_body_fixture(body[0..<n],version,tree[..],meta[..]);#assert p.status==wanted;
}
#test "quad structural if else consumes both branch records and retains empty blocks" {
 tree:[256]u32;meta:[RQ_IR_META]int;branches:=[7]u32.[6,1,16,1,1,5,5];
 p:=rq_ir_body_fixture(branches[..],3,tree[..],meta[..]);#assert p.status==RQStatus.ok;
 empty:=[2]u32.[1,0];p=rq_ir_body_fixture(empty[..],3,tree[..],meta[..]);#assert p.status==RQStatus.ok;
}

#test "quad malformed GPU result type refuses at the exact truncated node endpoint" {
 body:=[4]u32.[2,33,12,7];tree:[128]u32;meta:[RQ_IR_META]int;p:=rq_ir_body_fixture(body[..],3,tree[..],meta[..]);#assert p.status==RQStatus.malformed;
}
