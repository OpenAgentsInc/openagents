RFP_WRAP_RR_VERTICES_1 :: "static coax_t_RRVertices coax_p_rr_vertices(RFP_ARGS_TOKEN) {coax_t_RRVertices q=rfc_original_rr_vertices(RFP_NAMES_TOKEN);rfc_note(l_tree.data,0,q.steps);if(q.status!=COAX_RQStatus_ok)fprintf(stderr,\"RF_ERROR {\\\"stage\\\":0,\\\"status\\\":%u,\\\"steps\\\":%lld}\\n\",(unsigned)q.status,(long long)q.steps);rfc_last_vertices=q;rfc_last_ids=l_ids;rfc_last_instance=l_instance;rfc_last_words=l_r.layout.count;return q;}";
