width||y>=c.descriptor.height)continue;coax_t_RQColor v=work.images.data[c.offset+y*c.descriptor.width+x];fprintf(stderr,\"RF_PIXEL {\\\"entry\\\":%lld,\\\"target\\\":%d,\\\"x\\\":%lld,\\\"y\\\":%lld,\\\"rgba\\\":[%.9g,%.9g,%.9g,%.9g]}\\n\",(long long)entry,target,(long long)x,(long long)y,(double)v.r,(double)v.g,(double)v.b,(double)v.a);}}}\n";
