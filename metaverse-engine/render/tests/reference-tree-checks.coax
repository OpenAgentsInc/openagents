// Test strings copy into owned mutable byte carriers; string-to-view casts
// deliberately are not part of the language's public conversion profile.
rtt_decode :: (text:string,out:[]u32)->RenderTreeText {
 bytes:[128]u8;for j:0..<text.count {bytes[j]=text[j];}return render_tree_decode(bytes[0..<text.count],out);
}
rtt_limit :: (text:string,out:[]u32,limit:int)->RenderTreeText {
 bytes:[128]u8;for j:0..<text.count {bytes[j]=text[j];}return render_tree_decode_with_limit(bytes[0..<text.count],out,limit);
}
#forall "render tree ASCII separators are exact over every byte" byte:0..<256 {
 expected:=byte==9 || byte==10 || byte==13 || byte==32;
 #assert render_tree_space(cast(u8)byte)==expected;
}
#test "render tree decimal words preserve full u32 range leading zeros and output tail" {
 text:=" \t2 0 4294967295 00017\r\n";out:=[6]u32.[91,92,93,94,95,96];
 r:=rtt_decode(text,out[..]);
 #assert r.status==RenderTreeStatus.ok && r.count==4 && r.version==2 && r.bad_byte==(-1) && r.work==65;
 #assert out[0]==2 && out[1]==0 && out[2]==4294967295 && out[3]==17 && out[4]==95 && out[5]==96;
 text="3\t1\n2\r3 ";r=rtt_decode(text,out[..]);
 #assert r.status==RenderTreeStatus.ok && r.version==3 && r.count==4 && r.work==20;
 for j:0..<4 {#assert out[j]==cast(u32)(ifx j==0 then 3 else j);}
}
#forall "render tree versions are admitted before publication" version:0..<7 {
 text:=[3]u8.[cast(u8)('0'+version),' ','1'];out:=[3]u32.[71,72,73];
 r:=render_tree_decode(text[..],out[..]);valid:=version==2 || version==3;
 #assert r.count==2 && r.version==version;
 if valid {#assert r.status==RenderTreeStatus.ok && r.bad_byte==(-1) && r.work==8 && out[0]==cast(u32)version && out[1]==1 && out[2]==73;}
 else {#assert r.status==RenderTreeStatus.unsupported && r.bad_byte==0 && r.work==3 && out[0]==71 && out[1]==72 && out[2]==73;}
}
#test "render tree malformed and overflowing inputs never publish a prefix" {
 texts:=[9]string.[""," \r\n","+2","2 -1","2 1.0","2 1x","2,1","2 4294967296","2 42949672950"];
 positions:=[9]int.[0,3,0,2,3,3,1,11,12];
 for k:0..<9 {
  out:=[4]u32.[41,42,43,44];r:=rtt_decode(texts[k],out[..]);
  #assert r.status==(ifx k>=7 then RenderTreeStatus.overflow else RenderTreeStatus.malformed) && r.bad_byte==positions[k];
  for j:0..<4 {#assert out[j]==cast(u32)(41+j);}
 }
 out:=[1]u32.[55];nul:=[2]u8.['2',0];r:=render_tree_decode(nul[..],out[..]);
 #assert r.status==RenderTreeStatus.malformed && r.bad_byte==1 && r.work==2 && r.version==(-1) && out[0]==55;
 text:="4294967295";r=rtt_decode(text,out[..]);#assert r.status==RenderTreeStatus.unsupported && r.version==4294967295 && r.count==1 && out[0]==55;
}
#test "render tree capacity follows full syntax validation and leaves all outputs unchanged" {
 text:="3 17";out:=[2]u32.[61,62];r:=rtt_decode(text,out[0..<1]);
 #assert r.status==RenderTreeStatus.capacity && r.count==2 && r.version==3 && r.bad_byte==(-1) && r.work==4 && out[0]==61 && out[1]==62;
 text="2 x";r=rtt_decode(text,out[0..<0]);#assert r.status==RenderTreeStatus.malformed && r.bad_byte==2 && out[0]==61 && out[1]==62;
 text="2";r=rtt_decode(text,out[0..<0]);#assert r.status==RenderTreeStatus.capacity && r.count==1 && r.version==2 && r.work==1;
 r=rtt_decode(text,out[0..<1]);#assert r.status==RenderTreeStatus.ok && r.count==1 && r.work==3 && out[0]==2 && out[1]==62;
}
#test "render tree source byte budget has exact authored lower upper and size endpoints" {
 text:="2 3";out:=[2]u32.[81,82];
 for limit:[4]int.[-1,0,2097153,2147483647] {
  r:=rtt_limit(text,out[..],limit);
  #assert r.status==RenderTreeStatus.budget && r.count==0 && r.version==(-1) && r.bad_byte==(-1) && r.work==0 && out[0]==81 && out[1]==82;
 }
 r:=rtt_limit(text,out[..],2);#assert r.status==RenderTreeStatus.budget && r.bad_byte==2 && r.work==0 && out[0]==81 && out[1]==82;
 r=rtt_limit(text,out[..],3);#assert r.status==RenderTreeStatus.ok && r.count==2 && r.work==8 && out[0]==2 && out[1]==3;
 text="2";r=rtt_limit(text,out[..],1);#assert r.status==RenderTreeStatus.ok && r.count==1 && r.work==3;
 r=rtt_limit(text,out[..],2097152);#assert r.status==RenderTreeStatus.ok && r.count==1 && r.version==2 && r.work==3;
}
#test "render tree digit upper edge and overflowing prefix above the division threshold refuse" {
 out:=[2]u32.[97,98];r:=rtt_decode("2 :",out[..]);
 #assert r.status==RenderTreeStatus.malformed && r.bad_byte==2 && r.count==1 && r.version==2 && r.work==3 && out[0]==97 && out[1]==98;
 r=rtt_decode("2 4294967300",out[..]);
 #assert r.status==RenderTreeStatus.overflow && r.bad_byte==11 && r.count==1 && r.version==2 && r.work==12 && out[0]==97 && out[1]==98;
}
