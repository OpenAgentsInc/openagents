// Which GPU format a realm's texture layers take on a device, and the size tier they take it at
// (GitHub #13014, part of #12998). The browser host passes what the adapter offers
// (texture-compression-bc, -astc, -etc2) and what the pack carries; Coax picks. A block format is
// picked only when the device has it and the pack carries layers encoded in it
// (metaverse-engine/tools/texture-encode.coax writes them); anything else falls back to RGBA8, so a pack
// without encoded layers, or a device without the feature, draws as it always has.
//
// Phones first: a phone (a coarse pointer) prefers ASTC, 6x6 for colour (0.89 bits a texel) and
// 4x4 for normals, then BC; a desktop prefers BC (BC7 colour, BC5 normals), then ASTC 4x4.
// The size tier is Solstice's phone rule: RGBA8 on a phone at most 512 a side, a block format on
// a phone at most 1024; a desktop keeps the side the realm declares. Tiered texture arrays (a small
// tier for every layer, larger tiers fetched on demand, GitHub #13014's last step) build on this
// once the GPU request array (Valley Lab step 6, GitHub #13008) says which layers are wanted.
//
// Checks: coax/bin/coax test metaverse-engine/render/texture-format.coax --library

TF_BC :: 1;            // the adapter has texture-compression-bc; the pack carries BC7 colour and BC5 normals
TF_ASTC :: 2;          // the adapter has texture-compression-astc; the pack carries ASTC 4x4
TF_ETC2 :: 4;          // the adapter has texture-compression-etc2 (no encoder writes it yet)
TF_ASTC6 :: 8;         // the pack carries ASTC 6x6 too (the adapter's ASTC bit covers every block size)

TF_COLOUR :: 0;        // base colour, sRGB
TF_NORMAL :: 1;        // tangent-space normal X and Y

// The formats, as codes the host passes back.
TF_RGBA8_SRGB :: 1; TF_RGBA8 :: 2; TF_BC7_SRGB :: 3; TF_BC5 :: 4; TF_ASTC4_SRGB :: 5; TF_ASTC6_SRGB :: 6; TF_ASTC4 :: 7;

tf_pick :: (features: int, carried: int, phone: bool, role: int) -> int #export_c #effects(all) {
  bc := (features & TF_BC) != 0 && (carried & TF_BC) != 0;
  astc := (features & TF_ASTC) != 0 && (carried & TF_ASTC) != 0;
  astc6 := (features & TF_ASTC) != 0 && (carried & TF_ASTC6) != 0;
  if role == TF_NORMAL {
    if phone && astc { return TF_ASTC4; }
    if bc { return TF_BC5; }
    if astc { return TF_ASTC4; }
    return TF_RGBA8;
  }
  if phone {
    if astc6 { return TF_ASTC6_SRGB; }
    if astc { return TF_ASTC4_SRGB; }
    if bc { return TF_BC7_SRGB; }
    return TF_RGBA8_SRGB;
  }
  if bc { return TF_BC7_SRGB; }
  if astc { return TF_ASTC4_SRGB; }
  if astc6 { return TF_ASTC6_SRGB; }
  return TF_RGBA8_SRGB;
}
#test "a phone takes ASTC, a desktop BC, and either falls back to RGBA8 without the feature or the encoded layers" {
  all := TF_BC | TF_ASTC | TF_ETC2; carried := TF_BC | TF_ASTC | TF_ASTC6;
  #assert tf_pick(all, carried, true, TF_COLOUR) == TF_ASTC6_SRGB && tf_pick(all, carried, false, TF_COLOUR) == TF_BC7_SRGB;
  #assert tf_pick(all, TF_BC | TF_ASTC, true, TF_COLOUR) == TF_ASTC4_SRGB && tf_pick(all, TF_BC, true, TF_COLOUR) == TF_BC7_SRGB;
  #assert tf_pick(all, TF_ASTC, false, TF_COLOUR) == TF_ASTC4_SRGB && tf_pick(all, TF_ASTC6, false, TF_COLOUR) == TF_ASTC6_SRGB;
  #assert tf_pick(TF_BC, carried, true, TF_COLOUR) == TF_BC7_SRGB && tf_pick(TF_ASTC, carried, false, TF_COLOUR) == TF_ASTC4_SRGB;
  #assert tf_pick(TF_ETC2, carried, true, TF_COLOUR) == TF_RGBA8_SRGB && tf_pick(all, 0, true, TF_COLOUR) == TF_RGBA8_SRGB && tf_pick(all, 0, false, TF_COLOUR) == TF_RGBA8_SRGB;
  #assert tf_pick(0, carried, false, TF_COLOUR) == TF_RGBA8_SRGB && tf_pick(TF_ASTC, TF_BC, true, TF_COLOUR) == TF_RGBA8_SRGB && tf_pick(TF_BC, TF_ASTC | TF_ASTC6, false, TF_COLOUR) == TF_RGBA8_SRGB;
  #assert tf_pick(all, carried, true, TF_NORMAL) == TF_ASTC4 && tf_pick(all, carried, false, TF_NORMAL) == TF_BC5 && tf_pick(all, TF_ASTC, false, TF_NORMAL) == TF_ASTC4;
  #assert tf_pick(all, TF_BC, true, TF_NORMAL) == TF_BC5 && tf_pick(all, TF_ASTC6, true, TF_NORMAL) == TF_RGBA8 && tf_pick(0, carried, true, TF_NORMAL) == TF_RGBA8;
}

// A format's WebGPU name ("" for no format).
tf_name :: (format: int) -> string #export_c #effects(all) {
  names := [7] string.["rgba8unorm-srgb", "rgba8unorm", "bc7-rgba-unorm-srgb", "bc5-rg-unorm", "astc-4x4-unorm-srgb", "astc-6x6-unorm-srgb", "astc-4x4-unorm"];
  return ifx format >= 1 && format <= 7 then names[format - 1] else "";
}
// The side of a format's block in texels: 1 for RGBA8 (four bytes a texel); a block is 16 bytes.
tf_block :: (format: int) -> int #export_c #effects(all) { return ifx format == TF_ASTC6_SRGB then 6 else ifx format >= TF_BC7_SRGB && format <= TF_ASTC4 then 4 else ifx format == TF_RGBA8_SRGB || format == TF_RGBA8 then 1 else 0; }
#test "formats name themselves as WebGPU does, with their blocks" {
  #assert tf_name(TF_RGBA8_SRGB) == "rgba8unorm-srgb" && tf_name(TF_RGBA8) == "rgba8unorm" && tf_name(TF_BC7_SRGB) == "bc7-rgba-unorm-srgb" && tf_name(TF_BC5) == "bc5-rg-unorm";
  #assert tf_name(TF_ASTC4_SRGB) == "astc-4x4-unorm-srgb" && tf_name(TF_ASTC6_SRGB) == "astc-6x6-unorm-srgb" && tf_name(TF_ASTC4) == "astc-4x4-unorm" && tf_name(0) == "" && tf_name(8) == "";
  #assert tf_block(TF_RGBA8_SRGB) == 1 && tf_block(TF_RGBA8) == 1 && tf_block(TF_BC7_SRGB) == 4 && tf_block(TF_BC5) == 4 && tf_block(TF_ASTC4) == 4 && tf_block(TF_ASTC6_SRGB) == 6 && tf_block(0) == 0 && tf_block(8) == 0;
}

// A colour format's block build of a pack, by the tag in its file name (GitHub #13305):
// metaverse-engine/tools/block-pack.coax writes NAME.TAG.vpk3 beside NAME.pack, and a realm lists the tags it
// ships (host.js's blocks: asset). "" for a format no build carries (RGBA8 and the normal formats).
tf_tag :: (format: int) -> string #export_c #effects(all) {
  return ifx format == TF_BC7_SRGB then "bc7" else ifx format == TF_ASTC4_SRGB then "astc4" else ifx format == TF_ASTC6_SRGB then "astc6" else "";
}
// The carried bit (tf_pick's `carried`) that a colour build in format stands for; 0 for none.
tf_carries :: (format: int) -> int #export_c #effects(all) {
  return ifx format == TF_BC7_SRGB then TF_BC else ifx format == TF_ASTC4_SRGB then TF_ASTC else ifx format == TF_ASTC6_SRGB then TF_ASTC6 else 0;
}
#test "a colour build's tag names its format, and stands for the bit tf_pick reads" {
  #assert tf_tag(TF_BC7_SRGB) == "bc7" && tf_tag(TF_ASTC4_SRGB) == "astc4" && tf_tag(TF_ASTC6_SRGB) == "astc6";
  #assert tf_tag(TF_RGBA8_SRGB) == "" && tf_tag(TF_RGBA8) == "" && tf_tag(TF_BC5) == "" && tf_tag(TF_ASTC4) == "" && tf_tag(0) == "";
  #assert tf_carries(TF_BC7_SRGB) == TF_BC && tf_carries(TF_ASTC4_SRGB) == TF_ASTC && tf_carries(TF_ASTC6_SRGB) == TF_ASTC6;
  #assert tf_carries(TF_RGBA8_SRGB) == 0 && tf_carries(TF_BC5) == 0 && tf_carries(TF_ASTC4) == 0 && tf_carries(8) == 0;
  // what a build carries is what tf_pick then picks
  for f: 3..<7 { if tf_tag(f) != "" { #assert tf_pick(TF_BC | TF_ASTC, tf_carries(f), false, TF_COLOUR) == f; } }
}

TF_PHONE_RGBA8 :: 512;      // Solstice's phone tier for unpacked RGBA8
TF_PHONE_BLOCKS :: 1024;    // a phone's tier for block-compressed layers (1 byte a texel or less)
// The side a layer array takes: the realm's declared side (or its first image's), capped on a
// phone by the format's tier. -1 refuses a side that isn't positive.
tf_side :: (declared: int, phone: bool, format: int) -> int #export_c #effects(all) {
  if declared <= 0 { return -1; }
  if !phone { return declared; }
  cap := ifx tf_block(format) == 1 then TF_PHONE_RGBA8 else TF_PHONE_BLOCKS;
  return ifx declared > cap then cap else declared; // mutant: equivalent (at declared == cap both give cap)
}
#test "a phone's layers are capped by their format's tier; a desktop's are as declared" {
  #assert tf_side(1536, true, TF_RGBA8_SRGB) == 512 && tf_side(1536, false, TF_RGBA8_SRGB) == 1536 && tf_side(512, true, TF_RGBA8_SRGB) == 512 && tf_side(256, true, TF_RGBA8_SRGB) == 256;
  #assert tf_side(1536, true, TF_ASTC6_SRGB) == 1024 && tf_side(2048, true, TF_BC7_SRGB) == 1024 && tf_side(1024, true, TF_ASTC4) == 1024 && tf_side(513, true, TF_RGBA8) == 512;
  #assert tf_side(0, true, TF_RGBA8_SRGB) == -1 && tf_side(-4, false, TF_RGBA8_SRGB) == -1 && tf_side(0, false, TF_RGBA8_SRGB) == -1 && tf_side(1, false, TF_RGBA8_SRGB) == 1 && tf_side(4096, false, TF_BC7_SRGB) == 4096;
}
