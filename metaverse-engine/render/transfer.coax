// The painterly transfer contract (lighting plan Phase 1 step 0, GitHub #13060): palette and texture
// colours are display sRGB and decode once to linear light; lighting stays linear HDR; the frame
// encodes once at the end. Character Create's glade defined these (its cg_linear, cg_srgb,
// cg_decode, cg_encode and cg_shoulder are now delegates of these). GPU-safe Coax; the scalar pieces
// are exported to C, as metaverse-engine/render/shade/light.coax's are, so the CPU and the shaders share them.
//   coax/bin/coax test metaverse-engine/render/transfer.coax
#load "../gpu/wgsl.coax";

#test "the transfer decodes display colour once and round trips neutral grey" {
 #assert abs(transfer_linear(0.5)-0.214041)<0.00001;
 #assert abs(transfer_srgb(transfer_linear(0.18))-0.18)<0.00001 && transfer_linear(0)==0 && transfer_srgb(0)==0;
 // Negative inputs clamp to black on both sides of the seam; the two pieces meet at it.
 #assert transfer_linear(-0.5)==0 && transfer_srgb(-0.5)==0;
 #assert abs(transfer_linear(0.04045f32)-transfer_linear(0.04046f32))<0.00001 && abs(transfer_srgb(0.0031308f32)-transfer_srgb(0.0031309f32))<0.00001;
 c:=transfer_encode(transfer_decode(v3(0.2,0.5,0.9)));#assert abs(c.x-0.2)<0.00001 && abs(c.y-0.5)<0.00001 && abs(c.z-0.9)<0.00001;
}
#test "the HDR shoulder preserves midtones and orders highlights below white" {
 #assert transfer_shoulder(0.18)==0.18 && transfer_shoulder(0.65)==0.65 && transfer_shoulder(-1)==0;
 #assert transfer_shoulder(1)<transfer_shoulder(4) && transfer_shoulder(4)<transfer_shoulder(100) && transfer_shoulder(100)<=1;
}
transfer_linear :: (x:f32)->f32 #export_c #effects(all) {return ifx x<=0.04045f32 then fmax(x,0)/12.92f32 else pow((x+0.055f32)/1.055f32,2.4f32);}
transfer_srgb :: (x:f32)->f32 #export_c #effects(all) {return ifx x<=0.0031308f32 then fmax(x,0)*12.92f32 else 1.055f32*pow(x,1.0f32/2.4f32)-0.055f32;}
transfer_decode :: (c:V3)->V3 {return v3(transfer_linear(c.x),transfer_linear(c.y),transfer_linear(c.z));}
transfer_encode :: (c:V3)->V3 {return v3(transfer_srgb(c.x),transfer_srgb(c.y),transfer_srgb(c.z));}
transfer_shoulder :: (x:f32)->f32 #export_c #effects(all) {return ifx x<=0.65f32 then fmax(x,0) else 0.65f32+0.35f32*(1.0f32-exp(-(x-0.65f32)/0.35f32));}
