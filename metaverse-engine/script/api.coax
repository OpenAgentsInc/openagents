// The script API: what a realm script loads to call the engine (GitHub #13467).
// GENERATED from metaverse-engine/script/api-table.coax by
//   coax/web/tool.sh metaverse-engine/tools/script-api.coax --write
// Do not edit: change the table. Each procedure is an import of the script's module; the engine
// answers a read from this tick's frame, queues a write for the thing the handler was called for
// and refuses a write that names any other thing. docs/protocol/realm-script-api.md has the table.
#script_api;

// how many things this frame holds
sa_count :: () -> s32 #foreign #effects(foreign, reads);
// the id of thing INDEX in the frame's order, 0 past the end
sa_at :: (index: s32) -> u64 #foreign #effects(foreign, reads);
// whether the thing is in this frame and alive
sa_alive :: (thing: u64) -> bool #foreign #effects(foreign, reads);
// the thing's kind number, the realm's (-1 when it is not in the frame)
sa_kind :: (thing: u64) -> s32 #foreign #effects(foreign, reads);
// the thing's team number, the realm's
sa_team :: (thing: u64) -> s32 #foreign #effects(foreign, reads);
// the thing's x, in metres
sa_x :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// the thing's height, in metres
sa_y :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// the thing's z, in metres
sa_z :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// the thing's yaw, in radians
sa_facing :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// the fastest the thing may move, in metres a second
sa_speed :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// the thing's health
sa_health :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// one of the thing's four running numbers (slot 0 to 3)
sa_var :: (thing: u64, slot: s32) -> f32 #foreign #effects(foreign, reads);
// x of one of the thing's four authored points (its plan's anchors)
sa_point_x :: (thing: u64, point: s32) -> f32 #foreign #effects(foreign, reads);
// z of one of the thing's four authored points
sa_point_z :: (thing: u64, point: s32) -> f32 #foreign #effects(foreign, reads);
// x of where the thing's plan sends it this tick (its own x when it has no plan)
sa_goal_x :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// z of where the thing's plan sends it this tick
sa_goal_z :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// how fast the thing's plan walks it there, in metres a second
sa_goal_speed :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// how far the thing's plan lets it see, in metres (0: never)
sa_notice :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// what the thing's plan does on seeing someone: 0 chase, 1 call, 2 flee, 3 ignore (-1 with no plan)
sa_plan_on :: (thing: u64) -> s32 #foreign #effects(foreign, reads);
// the distance between two things on the ground, a large number when either is missing
sa_distance :: (a: u64, b: u64) -> f32 #foreign #effects(foreign, reads);
// the nearest other living thing of a kind (any kind when negative) within a radius, 0 when none
sa_near :: (thing: u64, kind: s32, radius: f32) -> u64 #foreign #effects(foreign, reads);
// the world's running time in seconds, the same on the page and in a room
sa_time :: () -> f32 #foreign #effects(foreign, reads);
// the time of day, 0 to 1
sa_day :: () -> f32 #foreign #effects(foreign, reads);
// one of the realm's eight running numbers (slot 0 to 7)
sa_world :: (slot: s32) -> f32 #foreign #effects(foreign, reads);
// the handler's next seeded draw in [0, 1): the same on the page and in a room
sa_random :: (thing: u64) -> f32 #foreign #effects(foreign, reads);
// walk toward a point at a speed; the engine caps the speed at sa_speed
sa_move :: (thing: u64, x: f32, z: f32, speed: f32) #foreign #effects(foreign, writes);
// stand still
sa_stop :: (thing: u64) #foreign #effects(foreign, writes);
// turn to a yaw
sa_face :: (thing: u64, yaw: f32) #foreign #effects(foreign, writes);
// set one of the thing's four running numbers
sa_set_var :: (thing: u64, slot: s32, value: f32) #foreign #effects(foreign, writes);
// call on_timer with this timer number after so many seconds (timers 0 to 3; 0 seconds or less cancels)
sa_timer :: (thing: u64, timer: s32, seconds: f32) #foreign #effects(foreign, writes);
// ask the engine for the thing's strike on a target; the engine checks reach and its own cooldown
sa_strike :: (thing: u64, target: u64) #foreign #effects(foreign, writes);
// show line number LINE of the thing's authored lines
sa_say :: (thing: u64, line: s32) #foreign #effects(foreign, writes);
// raise a realm event with a number; the realm decides what it means
sa_emit :: (thing: u64, event: s32, value: f32) #foreign #effects(foreign, writes);
