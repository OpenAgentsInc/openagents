// A script frame and its result (GitHub #13467, docs/research/2026-11-13-realm-scripts.md,
// docs/protocol/realm-script-v1.md): the two shapes that cross between a realm and the script host
// (host.coax). Each tick the realm fills a ScriptFrame from its own running state (the things a script
// may see, the events that happened, the time and a seed), the host runs the world's scripts over it,
// and the realm reads back a ScriptRun: the commands to apply and the diagnostics to show.
//
// A realm loads this file alone. It holds no interpreter: a page keeps the host in its own module
// beside the engine (apps/openagents-web/script-host.coax) and passes these as bytes (`script.frame.v1`
// and `script.result.v1`, proto/world/script-frame-v1.json), and a room links the host and passes the
// same bytes, so both run the same frames.
//   coax/bin/coax test metaverse-engine/script/frame.coax --library

#load "api-table.coax";

// ---- limits (shown in the editor's script pane and in docs/protocol/realm-script-v1.md) ----
SH_SCRIPTS :: 8;          // the scripts one world loads
SH_THINGS :: 256;         // the things in a frame
SH_EVENTS :: 64;          // the events in a frame
SH_COMMANDS :: 512;       // the commands a tick's scripts may queue
SH_DIAGS :: 16;           // the diagnostics a tick keeps (more are counted)
SH_CALL_FUEL :: 20000;    // instructions one handler call may spend
SH_TICK_FUEL :: 400000;   // instructions all of a world's scripts may spend in one tick
SH_STRIKES :: 3;          // failed calls in a row before a script is switched off
SH_VARS :: 4;             // a thing's running numbers
SH_POINTS :: 4;           // a thing's authored points
SH_WORLD :: 8;            // a realm's running numbers
SH_TIMERS :: 4;           // a thing's timers
SH_INSIDE :: 8;           // the things a trigger tracks inside itself at once
SH_STATE :: 256;          // a state record's bytes
SH_FIELDS :: 32;          // a state record's fields a swap can keep
SH_NAME :: 32;            // a field's name or type, in bytes
SH_FAR :: 1000000000.0;   // the distance to a thing that is not there

// ---- diagnostics (proto/registry.json: realm-script.diagnostic.*; docs/protocol/realm-script-v1.md) ----
SD_NONE :: 0;
SD_OVER_BUDGET :: 1;      // the call spent its instruction budget
SD_TRAP :: 2;             // the module trapped: status says how, line says where when the script knows
SD_NOT_YOURS :: 3;        // a write named a thing other than the one the handler was called for
SD_COMMANDS_FULL :: 4;    // the tick's command list is full
SD_TICK_BUDGET :: 5;      // the world's budget for this tick is spent: the script's remaining calls were skipped
SD_SWITCHED_OFF :: 6;     // SH_STRIKES failures in a row: the script is off until it is loaded again
SD_BAD_ARGUMENT :: 7;     // a number that is not finite, or a slot, timer or point that does not exist
SD_REFUSED :: 8;          // the module check refused the bytes: detail is the WM_* code, line the byte
SD_NO_SLOT :: 9;          // more things use the script than it has state slots
SD_FACE :: 10;            // the module's face answers are out of range (abi, state, state size, slots)
SD_CODES :: 11;
SD_NAMES :: [SD_CODES] string.["none", "over-budget", "trap", "not-yours", "commands-full", "tick-budget", "switched-off", "bad-argument", "refused-module", "no-slot", "bad-face"];
// The codes' ids in proto/registry.json (`engine.diagnostic.script-NAME.v1`; this file is their one codec).
// A number is never changed and never used again.
SD_IDS :: [SD_CODES] string.["",
  "engine.diagnostic.script-over-budget.v1", "engine.diagnostic.script-trap.v1", "engine.diagnostic.script-not-yours.v1",
  "engine.diagnostic.script-commands-full.v1", "engine.diagnostic.script-tick-budget.v1", "engine.diagnostic.script-switched-off.v1",
  "engine.diagnostic.script-bad-argument.v1", "engine.diagnostic.script-refused-module.v1", "engine.diagnostic.script-no-slot.v1",
  "engine.diagnostic.script-bad-face.v1"];
// Whether doing the same thing again can help without a change to the script or the world.
SD_RETRY :: [SD_CODES] bool.[false, false, false, false, true, true, false, false, false, false, false];
SD_MEANS :: [SD_CODES] string.["",
  "A handler call spent its instruction budget. The call was undone. Do less in one call, or spread the work over ticks.",
  "The script's module trapped: a failed bounds, arithmetic or cast check, or a bad memory access. The call was undone. The line is the script's source line when it knows it.",
  "A write or an engine call named a thing other than the one the handler was called for. The call was undone. A script changes only its own thing.",
  "The tick's command list was full. The call was undone. Fewer scripts or fewer commands a tick.",
  "The world's instruction budget for this tick was spent. The script's remaining calls this tick were skipped.",
  "The script failed several calls in a row and is switched off until it is loaded again.",
  "A number that is not finite, or a slot, timer or point that does not exist. The call was undone.",
  "The module check refused the bytes. The detail is the refusal and the line is the byte it is about.",
  "More things use the script than it has state slots. The thing has no script this tick.",
  "The module's face answered out of range: its version, its state's place or size, or its slot count."];

ScriptThing :: struct {
  id: u64;                // never 0
  kind: s32; team: s32;   // the realm's numbers
  script: s32 = -1;       // which loaded script drives it, -1 for none
  alive: bool;
  x: f32; y: f32; z: f32; facing: f32;
  speed: f32;             // the fastest it may move
  health: f32;
  reach: f32;             // its trigger radius, 0 for none
  goal_x: f32; goal_z: f32;   // where its plan (data) sends it this tick
  goal_speed: f32;        // and how fast
  notice: f32;            // how far its plan lets it see, 0 for never
  plan_on: s32 = -1;      // what its plan does on seeing someone (0 chase, 1 call, 2 flee, 3 ignore), -1 with no plan
  vars: [SH_VARS] f32;
  px: [SH_POINTS] f32; pz: [SH_POINTS] f32;
}
// An event the realm reports for a thing: handler is RH_ENTER, RH_LEAVE, RH_NOTICE, RH_HIT or RH_USE.
ScriptEvent :: struct { handler: s32; thing: u64; other: u64; amount: f32; }
ScriptFrame :: struct {
  tick: int; seed: int;
  dt: f32; time: f32; day: f32;
  world: [SH_WORLD] f32;
  n_things: int; n_events: int;
  things: [SH_THINGS] ScriptThing;
  events: [SH_EVENTS] ScriptEvent;
}
// op is the API row that queued it (SA_MOVE, SA_STOP, SA_FACE, SA_SET_VAR, SA_STRIKE, SA_SAY, SA_EMIT).
ScriptCommand :: struct { op: s32; thing: u64; target: u64; i: s32; a: f32; b: f32; c: f32; }
ScriptDiag :: struct { code: s32; script: s32; handler: s32; status: s32; line: s32; detail: s32; thing: u64; tick: int; used: int; }
// One tick's shared results.
ScriptRun :: struct {
  fuel: int;              // what is left of the tick's budget
  n_commands: int; n_diags: int; more_diags: int;
  calls: int; failed: int;
  commands: [SH_COMMANDS] ScriptCommand;
  diags: [SH_DIAGS] ScriptDiag;
}

// ---- bytes: script.frame.v1 and script.result.v1, little-endian, fixed rows ----
SF_MAGIC :: 827475539;       // "SFR1"
SR_MAGIC :: 827544147;       // "SRS1"
SF_HEAD :: 68; SF_THING :: 120; SF_EVENT :: 24;
SR_HEAD :: 24; SR_COMMAND :: 36; SR_DIAG :: 44;
SF_BYTES :: SF_HEAD + SH_THINGS * SF_THING + SH_EVENTS * SF_EVENT;
SR_BYTES :: SR_HEAD + SH_COMMANDS * SR_COMMAND + SH_DIAGS * SR_DIAG;

SfCur :: struct { at: int; ok: bool = true; }
sf_put :: (out: [] u8, c: [] SfCur, v: u64, width: int) {
  if !c[0].ok || c[0].at + width > out.count { c[0].ok = false; return; }
  for i: 0..<width { out[c[0].at + i] = cast(u8) ((v >> cast(u64) (i * 8)) & 255); }
  c[0].at += width;
}
sf_put_s :: (out: [] u8, c: [] SfCur, v: int, width: int) { sf_put(out, c, cast,trunc(u64) v, width); }
sf_put_f :: (out: [] u8, c: [] SfCur, v: f32) { sf_put(out, c, cast(u64) f32_bits(v), 4); }
sf_get :: (b: [] u8, c: [] SfCur, width: int) -> u64 {
  if !c[0].ok || c[0].at + width > b.count { c[0].ok = false; return 0; }
  v: u64 = 0;
  for i: 0..<width { v = v | (cast(u64) b[c[0].at + i] << cast(u64) (i * 8)); }
  c[0].at += width;
  return v;
}
sf_get_s32 :: (b: [] u8, c: [] SfCur) -> s32 { return cast,trunc(s32) sf_get(b, c, 4); }
sf_get_s64 :: (b: [] u8, c: [] SfCur) -> int { return cast,trunc(int) sf_get(b, c, 8); }
sf_get_f :: (b: [] u8, c: [] SfCur) -> f32 { return f32_from_bits(cast,trunc(u32) sf_get(b, c, 4)); }

// Writes a frame; its length, or -1 when out is too small or the counts are out of range.
sf_write :: (f: [] ScriptFrame, out: [] u8) -> int {
  if f[0].n_things < 0 || f[0].n_things > SH_THINGS || f[0].n_events < 0 || f[0].n_events > SH_EVENTS { return -1; }
  cur: [1] SfCur; c := cur[..];
  sf_put(out, c, SF_MAGIC, 4); sf_put_s(out, c, f[0].n_things, 2); sf_put_s(out, c, f[0].n_events, 2);
  sf_put_s(out, c, f[0].tick, 8); sf_put_s(out, c, f[0].seed, 8);
  sf_put_f(out, c, f[0].dt); sf_put_f(out, c, f[0].time); sf_put_f(out, c, f[0].day);
  for i: 0..<SH_WORLD { sf_put_f(out, c, f[0].world[i]); }
  for i: 0..<f[0].n_things {
    t := f[0].things[i];
    sf_put(out, c, t.id, 8); sf_put_s(out, c, cast(int) t.kind, 4); sf_put_s(out, c, cast(int) t.team, 4); sf_put_s(out, c, cast(int) t.script, 4);
    sf_put(out, c, ifx t.alive then cast(u64) 1 else cast(u64) 0, 4);
    sf_put_f(out, c, t.x); sf_put_f(out, c, t.y); sf_put_f(out, c, t.z); sf_put_f(out, c, t.facing); sf_put_f(out, c, t.speed); sf_put_f(out, c, t.health); sf_put_f(out, c, t.reach);
    sf_put_f(out, c, t.goal_x); sf_put_f(out, c, t.goal_z); sf_put_f(out, c, t.goal_speed); sf_put_f(out, c, t.notice); sf_put_s(out, c, cast(int) t.plan_on, 4);
    for k: 0..<SH_VARS { sf_put_f(out, c, t.vars[k]); }
    for k: 0..<SH_POINTS { sf_put_f(out, c, t.px[k]); }
    for k: 0..<SH_POINTS { sf_put_f(out, c, t.pz[k]); }
  }
  for i: 0..<f[0].n_events {
    e := f[0].events[i];
    sf_put_s(out, c, cast(int) e.handler, 4); sf_put(out, c, e.thing, 8); sf_put(out, c, e.other, 8); sf_put_f(out, c, e.amount);
  }
  return ifx c[0].ok then c[0].at else -1;
}
// Reads a frame. True when the bytes are exactly one frame: the magic, counts within the limits, every
// row whole and nothing after.
sf_read :: (b: [] u8, f: [] ScriptFrame) -> bool {
  cur: [1] SfCur; c := cur[..];
  if sf_get(b, c, 4) != SF_MAGIC { return false; }
  things := cast(int) sf_get(b, c, 2); events := cast(int) sf_get(b, c, 2);
  if !c[0].ok || things > SH_THINGS || events > SH_EVENTS || b.count != SF_HEAD + things * SF_THING + events * SF_EVENT { return false; }
  f[0].n_things = things; f[0].n_events = events;
  f[0].tick = sf_get_s64(b, c); f[0].seed = sf_get_s64(b, c);
  f[0].dt = sf_get_f(b, c); f[0].time = sf_get_f(b, c); f[0].day = sf_get_f(b, c);
  for i: 0..<SH_WORLD { f[0].world[i] = sf_get_f(b, c); }
  for i: 0..<things {
    t: ScriptThing;
    t.id = sf_get(b, c, 8); t.kind = sf_get_s32(b, c); t.team = sf_get_s32(b, c); t.script = sf_get_s32(b, c);
    t.alive = (sf_get(b, c, 4) & 1) != 0;
    t.x = sf_get_f(b, c); t.y = sf_get_f(b, c); t.z = sf_get_f(b, c); t.facing = sf_get_f(b, c); t.speed = sf_get_f(b, c); t.health = sf_get_f(b, c); t.reach = sf_get_f(b, c);
    t.goal_x = sf_get_f(b, c); t.goal_z = sf_get_f(b, c); t.goal_speed = sf_get_f(b, c); t.notice = sf_get_f(b, c); t.plan_on = sf_get_s32(b, c);
    for k: 0..<SH_VARS { t.vars[k] = sf_get_f(b, c); }
    for k: 0..<SH_POINTS { t.px[k] = sf_get_f(b, c); }
    for k: 0..<SH_POINTS { t.pz[k] = sf_get_f(b, c); }
    f[0].things[i] = t;
  }
  for i: 0..<events {
    e: ScriptEvent;
    e.handler = sf_get_s32(b, c); e.thing = sf_get(b, c, 8); e.other = sf_get(b, c, 8); e.amount = sf_get_f(b, c);
    f[0].events[i] = e;
  }
  return c[0].ok;
}
// Writes a tick's result; its length, or -1.
sr_write :: (r: [] ScriptRun, out: [] u8) -> int {
  if r[0].n_commands < 0 || r[0].n_commands > SH_COMMANDS || r[0].n_diags < 0 || r[0].n_diags > SH_DIAGS { return -1; }
  cur: [1] SfCur; c := cur[..];
  sf_put(out, c, SR_MAGIC, 4); sf_put_s(out, c, r[0].n_commands, 2); sf_put_s(out, c, r[0].n_diags, 2);
  sf_put_s(out, c, r[0].more_diags, 4); sf_put_s(out, c, r[0].fuel, 4); sf_put_s(out, c, r[0].calls, 4); sf_put_s(out, c, r[0].failed, 4);
  for i: 0..<r[0].n_commands {
    k := r[0].commands[i];
    sf_put_s(out, c, cast(int) k.op, 4); sf_put_s(out, c, cast(int) k.i, 4); sf_put(out, c, k.thing, 8); sf_put(out, c, k.target, 8);
    sf_put_f(out, c, k.a); sf_put_f(out, c, k.b); sf_put_f(out, c, k.c);
  }
  for i: 0..<r[0].n_diags {
    d := r[0].diags[i];
    sf_put_s(out, c, cast(int) d.code, 4); sf_put_s(out, c, cast(int) d.script, 4); sf_put_s(out, c, cast(int) d.handler, 4);
    sf_put_s(out, c, cast(int) d.status, 4); sf_put_s(out, c, cast(int) d.line, 4); sf_put_s(out, c, cast(int) d.detail, 4);
    sf_put(out, c, d.thing, 8); sf_put_s(out, c, d.tick, 8); sf_put_s(out, c, d.used, 4);
  }
  return ifx c[0].ok then c[0].at else -1;
}
sr_read :: (b: [] u8, r: [] ScriptRun) -> bool {
  cur: [1] SfCur; c := cur[..];
  if sf_get(b, c, 4) != SR_MAGIC { return false; }
  commands := cast(int) sf_get(b, c, 2); diags := cast(int) sf_get(b, c, 2);
  if !c[0].ok || commands > SH_COMMANDS || diags > SH_DIAGS || b.count != SR_HEAD + commands * SR_COMMAND + diags * SR_DIAG { return false; }
  r[0].n_commands = commands; r[0].n_diags = diags;
  r[0].more_diags = cast(int) sf_get_s32(b, c); r[0].fuel = cast(int) sf_get_s32(b, c); r[0].calls = cast(int) sf_get_s32(b, c); r[0].failed = cast(int) sf_get_s32(b, c);
  for i: 0..<commands {
    k: ScriptCommand;
    k.op = sf_get_s32(b, c); k.i = sf_get_s32(b, c); k.thing = sf_get(b, c, 8); k.target = sf_get(b, c, 8);
    k.a = sf_get_f(b, c); k.b = sf_get_f(b, c); k.c = sf_get_f(b, c);
    r[0].commands[i] = k;
  }
  for i: 0..<diags {
    d: ScriptDiag;
    d.code = sf_get_s32(b, c); d.script = sf_get_s32(b, c); d.handler = sf_get_s32(b, c); d.status = sf_get_s32(b, c); d.line = sf_get_s32(b, c); d.detail = sf_get_s32(b, c);
    d.thing = sf_get(b, c, 8); d.tick = sf_get_s64(b, c); d.used = cast(int) sf_get_s32(b, c);
    r[0].diags[i] = d;
  }
  return c[0].ok;
}

#load "frame-checks.coax" #test;
