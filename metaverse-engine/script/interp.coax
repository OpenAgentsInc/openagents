// The realm-script interpreter (GitHub #13467, docs/research/2026-11-13-realm-scripts.md): runs a module
// the check (wasm.coax) passed. The page and a room run the same bytes through this one file, so a
// script costs the same instructions and leaves the same memory in both.
//
// It gives the three limits a script needs and native code does not have:
//   time    every instruction costs one unit of the call's budget; at zero the call stops (WI_FUEL);
//   memory  the script's linear memory is an array this file owns; every access is checked against it;
//   traps   a failed check is a status the caller reads (WI_TRAP_*), never the process's end.
// And a rollback: wi_begin marks the memory and globals, wi_rollback puts back every byte a call wrote,
// wi_commit keeps them. Memory is saved a WI_CHUNK at its first write, so a call that touches little
// saves little.
//
// A call to an import stops the run with WI_IMPORT: this file calls nothing. The caller (host.coax) reads
// the arguments, answers with wi_answer and runs on. That is how a module that can call "anything it
// imports" can only ever reach the script API.
//
// Nothing here allocates, and nothing here traps: every index into the stack, the frames, the labels,
// the memory and the module is checked before it is used, so no module, however malformed, can end the
// process (metaverse-engine/tools/script-fuzz.coax runs damaged modules by the million to hold this).
// Floats are IEEE with one rounding per operation; a NaN result is always the canonical quiet NaN, so
// the page (wasm) and a room (native) agree to the bit.
//   coax/bin/coax test metaverse-engine/script/interp.coax --library

#load "wasm.coax";

WI_STACK :: 4096;      // 64-bit slots: every frame's locals and operands
WI_FRAMES :: 64;       // calls inside calls
WI_LABELS :: 512;      // open blocks, over all frames
WI_MEM :: WM_PAGES * WM_PAGE;
WI_CHUNK :: 1024;      // the rollback's unit
WI_CHUNKS :: WI_MEM / WI_CHUNK;

WI_DONE :: 0;              // the call returned
WI_IMPORT :: 1;            // stopped at an import: wi_import_row, wi_arg, then wi_answer and wi_run again
WI_FUEL :: 2;              // the budget ran out
WI_TRAP_UNREACHABLE :: 3;  // the module's own trap instruction (a Coax check that failed)
WI_TRAP_MEMORY :: 4;       // a read or write outside the memory
WI_TRAP_DIVIDE :: 5;       // an integer division by zero, or the least integer by minus one
WI_TRAP_CONVERT :: 6;      // a float that does not fit the integer asked for
WI_TRAP_STACK :: 7;        // out of value slots, frames or labels: the call went too deep
WI_TRAP_MALFORMED :: 8;    // an operand that is not there, or bytes the check should have refused
WI_IDLE :: 9;              // no call is in progress
WI_STATUSES :: 10;
WI_STATUS_NAMES :: [WI_STATUSES] string.["done", "import", "over-budget", "trap", "memory", "divide", "convert", "stack", "malformed", "idle"];

WiFrame :: struct { func: s32; ret: s32; locals: s32; labels: s32; }
// cont: where a branch to this label goes; height: the value stack below its results; arity: its results.
WiLabel :: struct { cont: s32; height: s32; arity: s32; loop: bool; }
WiVm :: struct {
  status: int = WI_IDLE;
  pc: int; sp: int; fp: int; lp: int;
  fuel: int;              // what is left of the call's budget
  import: int;            // the import the run stopped at
  mem_n: int;             // the memory's bytes
  n_dirty: int;
  open: bool;             // a transaction is open (wi_begin)
  stack: [WI_STACK] u64;
  frames: [WI_FRAMES] WiFrame;
  labels: [WI_LABELS] WiLabel;
  globals: [WM_GLOBALS] u64;
  kept_globals: [WM_GLOBALS] u64;
  dirty: [WI_CHUNKS] bool;
  dirty_list: [WI_CHUNKS] s32;
  mem: [WI_MEM] u8;
  undo: [WI_MEM] u8;
}

WI_LOW :: 4294967295;                // the low 32 bits
WI_ALL :: cast(u64) 18446744073709551615;
WI_NAN32 :: 2143289344;              // 0x7fc00000
WI_NAN64 :: 9221120237041090560;     // 0x7ff8000000000000

// ---- loading and transactions ----
// A fresh instance: zeroed memory, the data segments copied in, the globals at their initial values.
wi_load :: (b: [] u8, m: [] WmModule, vm: [] WiVm) -> bool {
  vm[0].status = WI_IDLE; vm[0].pc = 0; vm[0].sp = 0; vm[0].fp = 0; vm[0].lp = 0; vm[0].fuel = 0; vm[0].import = 0;
  vm[0].n_dirty = 0; vm[0].open = false;
  vm[0].mem_n = cast(int) m[0].pages * WM_PAGE;
  if vm[0].mem_n < 0 || vm[0].mem_n > WI_MEM { return false; }
  for i: 0..<WI_MEM { vm[0].mem[i] = 0; }
  for i: 0..<WI_CHUNKS { vm[0].dirty[i] = false; }
  for d: 0..<cast(int) m[0].n_data {
    seg := m[0].data[d]; to := cast(int) seg.to; at := cast(int) seg.at; n := cast(int) seg.n;
    if to < 0 || n < 0 || at < 0 || to + n > vm[0].mem_n || at + n > b.count { return false; }
    for i: 0..<n { vm[0].mem[to + i] = b[at + i]; }
  }
  for g: 0..<WM_GLOBALS { vm[0].globals[g] = ifx g < cast(int) m[0].n_globals then m[0].globals[g].init else cast(u64) 0; }
  return true;
}
// Marks the instance: until wi_commit, wi_rollback restores the memory and globals as they are now.
wi_begin :: (vm: [] WiVm) {
  if vm[0].open { wi_commit(vm); }
  for g: 0..<WM_GLOBALS { vm[0].kept_globals[g] = vm[0].globals[g]; }
  vm[0].open = true;
}
wi_commit :: (vm: [] WiVm) {
  for i: 0..<vm[0].n_dirty { c := cast(int) vm[0].dirty_list[i]; if c >= 0 && c < WI_CHUNKS { vm[0].dirty[c] = false; } }
  vm[0].n_dirty = 0; vm[0].open = false;
}
wi_rollback :: (vm: [] WiVm) {
  if !vm[0].open { return; }
  for i: 0..<vm[0].n_dirty {
    c := cast(int) vm[0].dirty_list[i];
    if c < 0 || c >= WI_CHUNKS { continue; }
    base := c * WI_CHUNK;
    for k: 0..<WI_CHUNK { vm[0].mem[base + k] = vm[0].undo[base + k]; }
    vm[0].dirty[c] = false;
  }
  for g: 0..<WM_GLOBALS { vm[0].globals[g] = vm[0].kept_globals[g]; }
  vm[0].n_dirty = 0; vm[0].open = false;
  vm[0].status = WI_IDLE; vm[0].sp = 0; vm[0].fp = 0; vm[0].lp = 0;
}
// Before a write of `size` bytes at `at` (already inside the memory): keep the chunks' bytes once.
wi_touch :: (vm: [] WiVm, at: int, size: int) {
  if !vm[0].open { return; }
  first := at / WI_CHUNK; last := (at + size - 1) / WI_CHUNK;
  for c: first..<last + 1 {
    if c < 0 || c >= WI_CHUNKS || vm[0].dirty[c] || vm[0].n_dirty >= WI_CHUNKS { continue; }
    base := c * WI_CHUNK;
    for k: 0..<WI_CHUNK { vm[0].undo[base + k] = vm[0].mem[base + k]; }
    vm[0].dirty[c] = true; vm[0].dirty_list[vm[0].n_dirty] = cast(s32) c; vm[0].n_dirty += 1;
  }
}
// Reads and writes of the memory from outside (the host's view of a script's state): checked, and a
// write is part of the open transaction. A read outside the memory is 0; a write there does nothing.
wi_peek :: (vm: [] WiVm, at: int) -> u8 {
  if at < 0 || at >= vm[0].mem_n { return 0; }
  return vm[0].mem[at];
}
wi_poke :: (vm: [] WiVm, at: int, v: u8) -> bool {
  if at < 0 || at >= vm[0].mem_n { return false; }
  wi_touch(vm, at, 1); vm[0].mem[at] = v;
  return true;
}

// ---- values ----
wi_s32 :: (x: u64) -> int { return cast(int) (cast,trunc(s32) x); }
wi_s64 :: (x: u64) -> int { return cast,trunc(int) x; }
wi_from_s :: (x: int) -> u64 { return cast,trunc(u64) x; }
wi_f32 :: (x: u64) -> f32 { return f32_from_bits(cast,trunc(u32) x); }
wi_f64 :: (x: u64) -> f64 { return f64_from_bits(x); }
// A float result's bits; every NaN is the canonical one.
wi_of32 :: (x: f32) -> u64 { if x != x { return WI_NAN32; } return cast(u64) f32_bits(x); }
wi_of64 :: (x: f64) -> u64 { if x != x { return WI_NAN64; } return f64_bits(x); }
wi_bool :: (x: bool) -> u64 { return ifx x then cast(u64) 1 else cast(u64) 0; }

wi_clz :: (x: u64, bits: int) -> u64 {
  n := 0; probe: u64 = cast(u64) 1 << cast(u64) (bits - 1);
  while n < bits && (x & probe) == 0 { n += 1; probe = probe >> 1; }
  return cast(u64) n;
}
wi_ctz :: (x: u64, bits: int) -> u64 {
  n := 0; probe: u64 = 1;
  while n < bits && (x & probe) == 0 { n += 1; probe = probe << 1; }
  return cast(u64) n;
}
wi_popcnt :: (x: u64) -> u64 {
  n := 0; v := x;
  while v != 0 { n += cast(int) (v & 1); v = v >> 1; }
  return cast(u64) n;
}
// An arithmetic shift right of a `bits`-wide value by k (0 <= k < bits).
wi_shr_s :: (x: u64, k: u64, bits: int) -> u64 {
  if k == 0 { return x; }
  mask: u64 = ifx bits == 32 then cast(u64) WI_LOW else cast(u64) WI_ALL;
  negative := ((x >> cast(u64) (bits - 1)) & 1) != 0;
  r := x >> k;
  if negative { r = r | ((mask << (cast(u64) bits - k)) & mask); }
  return r;
}
// Round to the nearest whole number, ties to even, as IEEE roundToIntegralTiesToEven.
wi_nearest64 :: (x: f64) -> f64 {
  if x != x || abs(x) >= 4503599627370496.0 { return x; }
  f := floor(x); d := x - f; r := f;
  if d > 0.5 { r = f + 1.0; }
  else if d == 0.5 { half := f / 2.0; if half != floor(half) { r = f + 1.0; } }
  if r == 0.0 { return f64_from_bits(f64_bits(x) & 9223372036854775808); }
  return r;
}
wi_trunc64 :: (x: f64) -> f64 { if x < 0.0 { return -floor(-x); } return floor(x); }
wi_ceil64 :: (x: f64) -> f64 { return -floor(-x); }
// min and max as WebAssembly defines them: a NaN operand gives NaN, and -0 is below +0.
wi_min64 :: (a: f64, b: f64) -> u64 {
  if a != a || b != b { return WI_NAN64; }
  if a == b { return f64_bits(a) | f64_bits(b); }
  return f64_bits(ifx a < b then a else b);
}
wi_max64 :: (a: f64, b: f64) -> u64 {
  if a != a || b != b { return WI_NAN64; }
  if a == b { return f64_bits(a) & f64_bits(b); }
  return f64_bits(ifx a > b then a else b);
}
// f64 to f32 as IEEE rounds it: a magnitude past the largest float is an infinity.
wi_demote :: (x: f64) -> u64 {
  if x != x { return WI_NAN32; }
  if abs(x) >= 3.4028235677973366e38 { return ifx x < 0.0 then cast(u64) 4286578688 else cast(u64) 2139095040; }
  return cast(u64) f32_bits(cast(f32) x);
}

// ---- the run ----
wi_stop :: (vm: [] WiVm, status: int) -> int { vm[0].status = status; return status; }
// An unsigned LEB128 at the program counter. The check proved it decodes; the bound is kept anyway.
wi_imm :: (b: [] u8, vm: [] WiVm) -> int {
  v := 0; shift := 0; p := vm[0].pc;
  for i: 0..<5 {
    if p < 0 || p >= b.count { vm[0].status = WI_TRAP_MALFORMED; return 0; }
    x := cast(int) b[p]; p += 1;
    v = v | ((x & 127) << shift); shift += 7;
    if x < 128 { break; }
  }
  vm[0].pc = p;
  return v;
}
wi_simm :: (b: [] u8, vm: [] WiVm, bits: int) -> u64 {
  v: u64 = 0; shift: u64 = 0; p := vm[0].pc; most := (bits + 6) / 7;
  for i: 0..<most {
    if p < 0 || p >= b.count { vm[0].status = WI_TRAP_MALFORMED; return 0; }
    x := cast(u64) b[p]; p += 1;
    v = v | ((x & 127) << shift); shift += 7;
    if x < 128 {
      if shift < 64 && (x & 64) != 0 { v = v | (cast(u64) WI_ALL << shift); }
      break;
    }
  }
  vm[0].pc = p;
  return ifx bits == 32 then v & WI_LOW else v;
}
// Starts a call of function `func` (in the module's whole index space) with these arguments and budget.
// False when a call is already in progress, the function is an import or the arguments do not fit.
wi_call :: (m: [] WmModule, vm: [] WiVm, func: int, args: [] u64, fuel: int) -> bool {
  imports := cast(int) m[0].n_imports;
  if vm[0].status == WI_IMPORT || func < imports || func >= imports + cast(int) m[0].n_funcs { return false; }
  fn := m[0].funcs[func - imports]; np := cast(int) m[0].types[fn.type].np; locals := cast(int) fn.locals;
  if args.count != np || np + locals > WI_STACK { return false; }
  for a, i: args { vm[0].stack[i] = a; }
  for i: np..<np + locals { vm[0].stack[i] = 0; }
  vm[0].sp = np + locals; vm[0].fp = 1; vm[0].lp = 0;
  vm[0].frames[0] = WiFrame.{func = cast(s32) func, ret = -1, locals = 0, labels = 0};
  vm[0].pc = cast(int) fn.body; vm[0].fuel = fuel; vm[0].status = WI_FUEL;
  return true;
}
// While the status is WI_IMPORT: the import's number (in the module's import order) and its arguments.
wi_arg :: (m: [] WmModule, vm: [] WiVm, i: int) -> u64 {
  if vm[0].status != WI_IMPORT || vm[0].import < 0 || vm[0].import >= cast(int) m[0].n_imports { return 0; }
  np := cast(int) m[0].types[m[0].import_type[vm[0].import]].np;
  at := vm[0].sp - np + i;
  if i < 0 || i >= np || at < 0 || at >= WI_STACK { return 0; }
  return vm[0].stack[at];
}
// Answers the import the run stopped at: its arguments leave the stack and its result, if its
// signature has one, takes their place. Then wi_run goes on.
wi_answer :: (m: [] WmModule, vm: [] WiVm, result: u64) {
  if vm[0].status != WI_IMPORT || vm[0].import < 0 || vm[0].import >= cast(int) m[0].n_imports { return; }
  t := m[0].types[m[0].import_type[vm[0].import]]; np := cast(int) t.np;
  if vm[0].sp < np { vm[0].status = WI_TRAP_MALFORMED; return; }
  vm[0].sp -= np;
  if t.result != 0 {
    if vm[0].sp >= WI_STACK { vm[0].status = WI_TRAP_STACK; return; }
    vm[0].stack[vm[0].sp] = ifx t.result == 127 || t.result == 125 then result & WI_LOW else result;
    vm[0].sp += 1;
  }
  vm[0].status = WI_FUEL;
}
// After WI_DONE: the call's result (0 when its signature has none).
wi_result :: (vm: [] WiVm) -> u64 {
  if vm[0].status != WI_DONE || vm[0].sp < 1 { return 0; }
  return vm[0].stack[vm[0].sp - 1];
}
// Charges the call's budget from outside (an import's cost). False when that empties it.
wi_charge :: (vm: [] WiVm, cost: int) -> bool {
  vm[0].fuel -= cost;
  return vm[0].fuel >= 0;
}

// A branch to the label `depth` blocks out. Returns false after setting a trap status.
wi_branch :: (m: [] WmModule, vm: [] WiVm, depth: int) -> bool {
  if vm[0].fp < 1 { vm[0].status = WI_TRAP_MALFORMED; return false; }
  frame := vm[0].frames[vm[0].fp - 1];
  mine := vm[0].lp - cast(int) frame.labels;
  if depth < 0 || depth > mine { vm[0].status = WI_TRAP_MALFORMED; return false; }
  if depth == mine { return wi_return(m, vm); }
  at := vm[0].lp - 1 - depth;
  if at < 0 || at >= WI_LABELS { vm[0].status = WI_TRAP_MALFORMED; return false; }
  label := vm[0].labels[at]; arity := cast(int) label.arity; height := cast(int) label.height;
  if vm[0].sp - arity < height || height < 0 || height + arity > WI_STACK { vm[0].status = WI_TRAP_MALFORMED; return false; }
  for i: 0..<arity { vm[0].stack[height + i] = vm[0].stack[vm[0].sp - arity + i]; }
  vm[0].sp = height + arity;
  vm[0].pc = cast(int) label.cont;
  vm[0].lp = ifx label.loop then at + 1 else at;
  return true;
}
// Returns from the current function. False when the run is over: status is WI_DONE or a trap.
wi_return :: (m: [] WmModule, vm: [] WiVm) -> bool {
  if vm[0].fp < 1 { vm[0].status = WI_TRAP_MALFORMED; return false; }
  frame := vm[0].frames[vm[0].fp - 1];
  index := cast(int) frame.func - cast(int) m[0].n_imports;
  if index < 0 || index >= cast(int) m[0].n_funcs { vm[0].status = WI_TRAP_MALFORMED; return false; }
  results := ifx m[0].types[m[0].funcs[index].type].result != 0 then 1 else 0;
  base := cast(int) frame.locals;
  if vm[0].sp - results < base || base < 0 || base + results > WI_STACK { vm[0].status = WI_TRAP_MALFORMED; return false; }
  if results == 1 { vm[0].stack[base] = vm[0].stack[vm[0].sp - 1]; }
  vm[0].sp = base + results; vm[0].lp = cast(int) frame.labels; vm[0].fp -= 1;
  if vm[0].fp == 0 { vm[0].status = WI_DONE; return false; }
  vm[0].pc = cast(int) frame.ret;
  return true;
}
// The address of a memory access of `size` bytes: the operand plus the instruction's offset, or -1
// (with WI_TRAP_MEMORY) when any byte of it lies outside the memory.
wi_address :: (b: [] u8, vm: [] WiVm, base: u64, size: int) -> int {
  align := wi_imm(b, vm); offset := wi_imm(b, vm);
  at := cast(int) (base & WI_LOW) + offset;
  if at < 0 || at + size > vm[0].mem_n { vm[0].status = WI_TRAP_MEMORY; return -1; }
  return at;
}
wi_read :: (vm: [] WiVm, at: int, size: int) -> u64 {
  v: u64 = 0;
  for i: 0..<size { v = v | (cast(u64) vm[0].mem[at + i] << cast(u64) (i * 8)); }
  return v;
}
wi_write :: (vm: [] WiVm, at: int, size: int, v: u64) {
  wi_touch(vm, at, size);
  for i: 0..<size { vm[0].mem[at + i] = cast(u8) ((v >> cast(u64) (i * 8)) & 255); }
}
// Sign-extends the low `bits` of x to 64 bits.
wi_extend :: (x: u64, bits: int) -> u64 {
  shift := cast(u64) (64 - bits);
  return wi_shr_s(x << shift, shift, 64);
}

// A 32-bit integer instruction with two operands (0x6a to 0x78). ok[0] false with a status on a trap.
wi_i32 :: (vm: [] WiVm, op: int, a: u64, b: u64) -> u64 {
  if op == 106 { return (a + b) & WI_LOW; }
  if op == 107 { return (a + 4294967296 - b) & WI_LOW; }
  if op == 108 { return mul_wrap(a, b) & WI_LOW; }
  if op == 109 || op == 111 {
    x := wi_s32(a); y := wi_s32(b);
    if y == 0 { vm[0].status = WI_TRAP_DIVIDE; return 0; }
    if op == 109 { if x == -2147483648 && y == -1 { vm[0].status = WI_TRAP_DIVIDE; return 0; } return wi_from_s(x / y) & WI_LOW; }
    return wi_from_s(x % y) & WI_LOW;
  }
  if op == 110 || op == 112 {
    if b == 0 { vm[0].status = WI_TRAP_DIVIDE; return 0; }
    return ifx op == 110 then a / b else a % b;
  }
  if op == 113 { return a & b; }
  if op == 114 { return a | b; }
  if op == 115 { return a ^ b; }
  k := b & 31;
  if op == 116 { return (a << k) & WI_LOW; }
  if op == 117 { return wi_shr_s(a, k, 32); }
  if op == 118 { return a >> k; }
  if op == 119 { return cast(u64) rotl(cast,trunc(u32) a, cast,trunc(u32) k); }
  return cast(u64) rotr(cast,trunc(u32) a, cast,trunc(u32) k);
}
// The same for 64 bits (0x7c to 0x8a), numbered as the 32-bit ones.
wi_i64 :: (vm: [] WiVm, op: int, a: u64, b: u64) -> u64 {
  if op == 106 { return add_wrap(a, b); }
  if op == 107 { return sub_wrap(a, b); }
  if op == 108 { return mul_wrap(a, b); }
  if op == 109 || op == 111 {
    x := wi_s64(a); y := wi_s64(b);
    if y == 0 { vm[0].status = WI_TRAP_DIVIDE; return 0; }
    if y == -1 {
      if op == 111 { return 0; }
      if a == 9223372036854775808 { vm[0].status = WI_TRAP_DIVIDE; return 0; }
      return sub_wrap(0, a);
    }
    return wi_from_s(ifx op == 109 then x / y else x % y);
  }
  if op == 110 || op == 112 {
    if b == 0 { vm[0].status = WI_TRAP_DIVIDE; return 0; }
    return ifx op == 110 then a / b else a % b;
  }
  if op == 113 { return a & b; }
  if op == 114 { return a | b; }
  if op == 115 { return a ^ b; }
  k := b & 63;
  if op == 116 { return a << k; }
  if op == 117 { return wi_shr_s(a, k, 64); }
  if op == 118 { return a >> k; }
  if op == 119 { return rotl(a, k); }
  return rotr(a, k);
}
// Integer comparisons 0x46 to 0x4f (and 0x51 to 0x5a, numbered the same), on values already widened.
wi_compare :: (op: int, a: u64, b: u64, sa: int, sb: int) -> u64 {
  if op == 70 { return wi_bool(a == b); }
  if op == 71 { return wi_bool(a != b); }
  if op == 72 { return wi_bool(sa < sb); }
  if op == 73 { return wi_bool(a < b); }
  if op == 74 { return wi_bool(sa > sb); }
  if op == 75 { return wi_bool(a > b); }
  if op == 76 { return wi_bool(sa <= sb); }
  if op == 77 { return wi_bool(a <= b); }
  if op == 78 { return wi_bool(sa >= sb); }
  return wi_bool(a >= b);
}
// Float instructions with one operand (f32 0x8b to 0x91, f64 0x99 to 0x9f, numbered from 0), in f64.
wi_float1 :: (k: int, x: f64) -> f64 {
  if k == 2 { return wi_ceil64(x); }
  if k == 3 { return floor(x); }
  if k == 4 { return wi_trunc64(x); }
  if k == 5 { return wi_nearest64(x); }
  return sqrt(x);
}
// A float to integer conversion (0xa8 to 0xb1 by kind): signed or not, to 32 or 64 bits.
wi_to_int :: (vm: [] WiVm, x: f64, signed: bool, bits: int) -> u64 {
  if x != x { vm[0].status = WI_TRAP_CONVERT; return 0; }
  if signed {
    low: f64 = -9223372036854777856.0; high: f64 = 9223372036854775808.0;
    if bits == 32 { low = -2147483649.0; high = 2147483648.0; }
    if !(x > low && x < high) { vm[0].status = WI_TRAP_CONVERT; return 0; }
    r := wi_from_s(cast(int) wi_trunc64(x));
    return ifx bits == 32 then r & WI_LOW else r;
  }
  top: f64 = 18446744073709551616.0;
  if bits == 32 { top = 4294967296.0; }
  if !(x > -1.0 && x < top) { vm[0].status = WI_TRAP_CONVERT; return 0; }
  return cast(u64) wi_trunc64(x);
}

// Runs the call in progress until it returns, stops at an import, traps or spends its budget; the
// status. `b` and `jump` are the module's bytes and the block targets the check wrote for them.
wi_run :: (b: [] u8, m: [] WmModule, jump: [] s32, vm: [] WiVm) -> int {
  if vm[0].status != WI_FUEL || vm[0].fp < 1 { return vm[0].status; }
  if vm[0].fuel <= 0 { return WI_FUEL; }
  imports := cast(int) m[0].n_imports;
  vm[0].status = WI_DONE;   // "running": any trap below replaces it, and only a return keeps it
  running := true;
  while running {
    if vm[0].fuel <= 0 { return wi_stop(vm, WI_FUEL); }
    vm[0].fuel -= 1;
    at := vm[0].pc;
    if at < 0 || at >= b.count || at + 1 >= jump.count { return wi_stop(vm, WI_TRAP_MALFORMED); }
    op := cast(int) b[at]; vm[0].pc = at + 1;
    sp := vm[0].sp;
    floor_at := cast(int) vm[0].frames[vm[0].fp - 1].locals;
    if sp < floor_at || sp > WI_STACK { return wi_stop(vm, WI_TRAP_MALFORMED); }
    if op == 32 || op == 33 || op == 34 {
      // local.get, local.set, local.tee
      slot := floor_at + wi_imm(b, vm);
      if slot < 0 || slot >= sp { return wi_stop(vm, WI_TRAP_MALFORMED); }
      if op == 32 {
        if sp >= WI_STACK { return wi_stop(vm, WI_TRAP_STACK); }
        vm[0].stack[sp] = vm[0].stack[slot]; vm[0].sp = sp + 1;
      } else {
        if sp - 1 <= slot { return wi_stop(vm, WI_TRAP_MALFORMED); }
        vm[0].stack[slot] = vm[0].stack[sp - 1];
        if op == 33 { vm[0].sp = sp - 1; }
      }
    } else if op == 65 || op == 66 || op == 67 || op == 68 {
      // constants
      if sp >= WI_STACK { return wi_stop(vm, WI_TRAP_STACK); }
      v: u64 = 0;
      if op == 65 { v = wi_simm(b, vm, 32); }
      else if op == 66 { v = wi_simm(b, vm, 64); }
      else {
        width := ifx op == 67 then 4 else 8; p := vm[0].pc;
        if p + width > b.count { return wi_stop(vm, WI_TRAP_MALFORMED); }
        for i: 0..<width { v = v | (cast(u64) b[p + i] << cast(u64) (i * 8)); }
        vm[0].pc = p + width;
      }
      vm[0].stack[sp] = v; vm[0].sp = sp + 1;
    } else if op >= 40 && op <= 53 {
      // loads
      if sp - 1 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      size := 4; extend := 0;
      if op == 41 || op == 43 { size = 8; }
      else if op == 44 || op == 48 { size = 1; extend = 8; }
      else if op == 45 || op == 49 { size = 1; }
      else if op == 46 || op == 50 { size = 2; extend = 16; }
      else if op == 47 || op == 51 { size = 2; }
      else if op == 52 { extend = 32; }
      where := wi_address(b, vm, vm[0].stack[sp - 1], size);
      if where < 0 { return vm[0].status; }
      v := wi_read(vm, where, size);
      if extend != 0 { v = wi_extend(v, extend); if op < 48 { v = v & WI_LOW; } }
      vm[0].stack[sp - 1] = v;
    } else if op >= 54 && op <= 62 {
      // stores
      if sp - 2 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      size := 4;
      if op == 55 || op == 57 { size = 8; }
      else if op == 58 || op == 60 { size = 1; }
      else if op == 59 || op == 61 { size = 2; }
      where := wi_address(b, vm, vm[0].stack[sp - 2], size);
      if where < 0 { return vm[0].status; }
      wi_write(vm, where, size, vm[0].stack[sp - 1]);
      vm[0].sp = sp - 2;
    } else if op >= 69 && op <= 196 {
      // numeric instructions
      one := op == 69 || op == 80 || (op >= 103 && op <= 105) || (op >= 121 && op <= 123) || (op >= 139 && op <= 145) || (op >= 153 && op <= 159) || op >= 167;
      need := ifx one then 1 else 2;
      if sp - need < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      x := vm[0].stack[sp - need]; y := vm[0].stack[sp - 1]; r: u64 = 0;
      if op == 69 { r = wi_bool((x & WI_LOW) == 0); }
      else if op <= 79 { r = wi_compare(op, x & WI_LOW, y & WI_LOW, wi_s32(x), wi_s32(y)); }
      else if op == 80 { r = wi_bool(x == 0); }
      else if op <= 90 { r = wi_compare(op - 11, x, y, wi_s64(x), wi_s64(y)); }
      else if op <= 102 {
        // f32 0x5b to 0x60 and f64 0x61 to 0x66: eq ne lt gt le ge
        k := ifx op <= 96 then op - 91 else op - 97;
        p := ifx op <= 96 then cast(f64) wi_f32(x) else wi_f64(x); q := ifx op <= 96 then cast(f64) wi_f32(y) else wi_f64(y);
        r = wi_bool(ifx k == 0 then p == q else ifx k == 1 then p != q else ifx k == 2 then p < q else ifx k == 3 then p > q else ifx k == 4 then p <= q else p >= q);
      }
      else if op == 103 { r = wi_clz(x & WI_LOW, 32); }
      else if op == 104 { r = wi_ctz(x & WI_LOW, 32); }
      else if op == 105 { r = wi_popcnt(x & WI_LOW); }
      else if op <= 120 { r = wi_i32(vm, op, x & WI_LOW, y & WI_LOW); }
      else if op == 121 { r = wi_clz(x, 64); }
      else if op == 122 { r = wi_ctz(x, 64); }
      else if op == 123 { r = wi_popcnt(x); }
      else if op <= 138 { r = wi_i64(vm, op - 18, x, y); }
      else if op <= 152 {
        // f32: abs neg ceil floor trunc nearest sqrt | add sub mul div min max copysign
        k := op - 139; p := wi_f32(x); q := wi_f32(y);
        if k == 0 { r = x & 2147483647; }
        else if k == 1 { r = (x ^ 2147483648) & WI_LOW; }
        else if k <= 6 { r = wi_of32(cast(f32) wi_float1(k, cast(f64) p)); }
        else if k == 7 { r = wi_of32(p + q); }
        else if k == 8 { r = wi_of32(p - q); }
        else if k == 9 { r = wi_of32(p * q); }
        else if k == 10 { r = wi_of32(p / q); }
        else if k == 11 { r = wi_demote(wi_f64(wi_min64(cast(f64) p, cast(f64) q))); }
        else if k == 12 { r = wi_demote(wi_f64(wi_max64(cast(f64) p, cast(f64) q))); }
        else { r = (x & 2147483647) | (y & 2147483648); }
      }
      else if op <= 166 {
        k := op - 153; p := wi_f64(x); q := wi_f64(y);
        if k == 0 { r = x & 9223372036854775807; }
        else if k == 1 { r = x ^ 9223372036854775808; }
        else if k <= 6 { r = wi_of64(wi_float1(k, p)); }
        else if k == 7 { r = wi_of64(p + q); }
        else if k == 8 { r = wi_of64(p - q); }
        else if k == 9 { r = wi_of64(p * q); }
        else if k == 10 { r = wi_of64(p / q); }
        else if k == 11 { r = wi_min64(p, q); }
        else if k == 12 { r = wi_max64(p, q); }
        else { r = (x & 9223372036854775807) | (y & 9223372036854775808); }
      }
      else if op == 167 { r = x & WI_LOW; }                                     // i32.wrap_i64
      else if op == 168 { r = wi_to_int(vm, cast(f64) wi_f32(x), true, 32); }
      else if op == 169 { r = wi_to_int(vm, cast(f64) wi_f32(x), false, 32); }
      else if op == 170 { r = wi_to_int(vm, wi_f64(x), true, 32); }
      else if op == 171 { r = wi_to_int(vm, wi_f64(x), false, 32); }
      else if op == 172 { r = wi_extend(x, 32); }                                // i64.extend_i32_s
      else if op == 173 { r = x & WI_LOW; }
      else if op == 174 { r = wi_to_int(vm, cast(f64) wi_f32(x), true, 64); }
      else if op == 175 { r = wi_to_int(vm, cast(f64) wi_f32(x), false, 64); }
      else if op == 176 { r = wi_to_int(vm, wi_f64(x), true, 64); }
      else if op == 177 { r = wi_to_int(vm, wi_f64(x), false, 64); }
      else if op == 178 { r = wi_of32(cast(f32) wi_s32(x)); }                    // f32.convert_i32_s
      else if op == 179 { r = wi_of32(cast(f32) (x & WI_LOW)); }
      else if op == 180 { r = wi_of32(cast(f32) wi_s64(x)); }
      else if op == 181 { r = wi_of32(cast(f32) x); }
      else if op == 182 { r = wi_demote(wi_f64(x)); }
      else if op == 183 { r = wi_of64(cast(f64) wi_s32(x)); }
      else if op == 184 { r = wi_of64(cast(f64) (x & WI_LOW)); }
      else if op == 185 { r = wi_of64(cast(f64) wi_s64(x)); }
      else if op == 186 { r = wi_of64(cast(f64) x); }
      else if op == 187 { r = wi_of64(cast(f64) wi_f32(x)); }
      else if op == 188 || op == 190 { r = x & WI_LOW; }                         // reinterpret between i32 and f32
      else if op == 189 || op == 191 { r = x; }
      else if op == 192 { r = wi_extend(x, 8) & WI_LOW; }
      else if op == 193 { r = wi_extend(x, 16) & WI_LOW; }
      else if op == 194 { r = wi_extend(x, 8); }
      else if op == 195 { r = wi_extend(x, 16); }
      else { r = wi_extend(x, 32); }
      if vm[0].status != WI_DONE { return vm[0].status; }
      vm[0].stack[sp - need] = r; vm[0].sp = sp - need + 1;
    } else if op == 2 || op == 3 || op == 4 {
      // block, loop, if
      if vm[0].pc >= b.count { return wi_stop(vm, WI_TRAP_MALFORMED); }
      result := b[vm[0].pc] != 64; vm[0].pc += 1;
      if op == 4 {
        if sp - 1 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
        sp -= 1; vm[0].sp = sp;
      }
      if vm[0].lp >= WI_LABELS { return wi_stop(vm, WI_TRAP_STACK); }
      vm[0].labels[vm[0].lp] = WiLabel.{cont = jump[at + 1], height = cast(s32) sp, arity = ifx result && op != 3 then cast(s32) 1 else cast(s32) 0, loop = op == 3};
      vm[0].lp += 1;
      if op == 4 && (vm[0].stack[sp] & WI_LOW) == 0 { vm[0].pc = cast(int) jump[at]; }
    } else if op == 5 {
      vm[0].pc = cast(int) jump[at];
    } else if op == 11 {
      if vm[0].lp > cast(int) vm[0].frames[vm[0].fp - 1].labels { vm[0].lp -= 1; }
      else if !wi_return(m, vm) { return vm[0].status; }
    } else if op == 12 {
      d := wi_imm(b, vm);
      if !wi_branch(m, vm, d) { return vm[0].status; }
    } else if op == 13 {
      d := wi_imm(b, vm);
      if sp - 1 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      vm[0].sp = sp - 1;
      if (vm[0].stack[sp - 1] & WI_LOW) != 0 { if !wi_branch(m, vm, d) { return vm[0].status; } }
    } else if op == 14 {
      n := wi_imm(b, vm);
      if sp - 1 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      vm[0].sp = sp - 1;
      pick := cast(int) (vm[0].stack[sp - 1] & WI_LOW); d := 0;
      if pick > n { pick = n; }
      // The check bounded the table inside the function; each step charges the budget.
      for i: 0..<pick + 1 { d = wi_imm(b, vm); vm[0].fuel -= 1; }
      if vm[0].status != WI_DONE { return vm[0].status; }
      if !wi_branch(m, vm, d) { return vm[0].status; }
    } else if op == 15 {
      if !wi_return(m, vm) { return vm[0].status; }
    } else if op == 16 {
      callee := wi_imm(b, vm);
      if callee < imports {
        vm[0].import = callee;
        return wi_stop(vm, WI_IMPORT);
      }
      if callee >= imports + cast(int) m[0].n_funcs { return wi_stop(vm, WI_TRAP_MALFORMED); }
      fn := m[0].funcs[callee - imports]; np := cast(int) m[0].types[fn.type].np; locals := cast(int) fn.locals;
      if sp - np < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      if vm[0].fp >= WI_FRAMES || sp + locals > WI_STACK { return wi_stop(vm, WI_TRAP_STACK); }
      for i: sp..<sp + locals { vm[0].stack[i] = 0; }
      vm[0].frames[vm[0].fp] = WiFrame.{func = cast(s32) callee, ret = cast(s32) vm[0].pc, locals = cast(s32) (sp - np), labels = cast(s32) vm[0].lp};
      vm[0].fp += 1; vm[0].sp = sp + locals; vm[0].pc = cast(int) fn.body;
    } else if op == 26 {
      if sp - 1 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      vm[0].sp = sp - 1;
    } else if op == 27 {
      if sp - 3 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      if (vm[0].stack[sp - 1] & WI_LOW) == 0 { vm[0].stack[sp - 3] = vm[0].stack[sp - 2]; }
      vm[0].sp = sp - 2;
    } else if op == 35 || op == 36 {
      g := wi_imm(b, vm);
      if g < 0 || g >= WM_GLOBALS { return wi_stop(vm, WI_TRAP_MALFORMED); }
      if op == 35 {
        if sp >= WI_STACK { return wi_stop(vm, WI_TRAP_STACK); }
        vm[0].stack[sp] = vm[0].globals[g]; vm[0].sp = sp + 1;
      } else {
        if sp - 1 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
        vm[0].globals[g] = vm[0].stack[sp - 1]; vm[0].sp = sp - 1;
      }
    } else if op == 63 {
      vm[0].pc += 1;
      if sp >= WI_STACK { return wi_stop(vm, WI_TRAP_STACK); }
      vm[0].stack[sp] = cast(u64) (vm[0].mem_n / WM_PAGE); vm[0].sp = sp + 1;
    } else if op == 64 {
      // memory.grow: a script's memory never grows; the answer is -1, or for growth by no pages the
      // size, as every engine answers it (WebAssembly lets a grow fail; growing by nothing does not).
      vm[0].pc += 1;
      if sp - 1 < floor_at { return wi_stop(vm, WI_TRAP_MALFORMED); }
      vm[0].stack[sp - 1] = ifx (vm[0].stack[sp - 1] & WI_LOW) == 0 then cast(u64) (vm[0].mem_n / WM_PAGE) else WI_LOW;
    } else if op == 0 {
      return wi_stop(vm, WI_TRAP_UNREACHABLE);
    } else if op != 1 {
      return wi_stop(vm, WI_TRAP_MALFORMED);
    }
    if vm[0].status != WI_DONE { return vm[0].status; }
  }
  return vm[0].status;
}

#load "interp-checks.coax" #test;
