// Checks of a world's script rows (rows.coax).
RK_HASH :: "528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5";
#test "a row reads to its slot, name, hash and whom it drives" {
  r: [1] ScriptRow;
  #assert srw_read(1, "raider", RK_HASH, "kind 1", r[..]) == SRW_OK && r[0].ok && r[0].slot == 0 && r[0].by_kind && r[0].n == 1;
  #assert cast(string) r[0].name[0..<r[0].name_n] == "raider" && cast(string) r[0].hash[..] == RK_HASH;
  #assert srw_read(SH_SCRIPTS, "a-2", RK_HASH, "who 99", r[..]) == SRW_OK && !r[0].by_kind && r[0].n == 99 && r[0].slot == SH_SCRIPTS - 1;
  #assert srw_read(2, "x", RK_HASH, "kind 0", r[..]) == SRW_OK && srw_read(2, "x", RK_HASH, "kind 255", r[..]) == SRW_OK;
}
#test "each bad cell has its own reason, and leaves no row" {
  r: [1] ScriptRow;
  #assert srw_read(0, "a", RK_HASH, "kind 1", r[..]) == SRW_BAD_ID && !r[0].ok && srw_read(SH_SCRIPTS + 1, "a", RK_HASH, "kind 1", r[..]) == SRW_BAD_ID;
  names := [5] string.["", "Raider", "9lives", "a_b", "a b"];
  for name: names { #assert srw_read(1, name, RK_HASH, "kind 1", r[..]) == SRW_BAD_NAME && !r[0].ok; }
  hashes := [4] string.["", "528d", "528D98A6985890F0D3D78E3DF31BFFA680719EA61722E87D80C6E16166C437A5", "g28d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5"];
  for hash: hashes { #assert srw_read(1, "a", hash, "kind 1", r[..]) == SRW_BAD_HASH; }
  targets := [11] string.["", "kind", "kind ", "kind 256", "kind -1", "kind 01", "who 0", "who 100", "all", "foe 1", "kind 1 "];
  for target: targets { #assert srw_read(1, "a", RK_HASH, target, r[..]) == SRW_BAD_FOR && !r[0].ok; }
  for why: 1..<5 { #assert srw_why(why).count > 20; }
  #assert srw_why(SRW_OK) == "" && srw_why(9) == "";
}
#test "a row for the actor wins over a row for its kind, then the lowest ID" {
  rows: [4] ScriptRow; one: [1] ScriptRow;
  ok := srw_read(3, "c", RK_HASH, "kind 1", one[..]); rows[0] = one[0];
  ok = srw_read(2, "b", RK_HASH, "kind 1", one[..]); rows[1] = one[0];
  ok = srw_read(4, "d", RK_HASH, "who 7", one[..]); rows[2] = one[0];
  ok = srw_read(1, "a", RK_HASH, "kind 2", one[..]); rows[3] = one[0];
  #assert srw_pick(rows[..], 1, 3) == 1 && srw_pick(rows[..], 1, 7) == 3 && srw_pick(rows[..], 2, 0) == 0 && srw_pick(rows[..], 5, 9) == -1;
  #assert srw_pick(rows[..], 2, 7) == 3 && srw_pick(rows[0..<0], 1, 1) == -1;
  #assert srw_drives(rows[2], 9, 7) && !srw_drives(rows[2], 9, 0) && !srw_drives(ScriptRow.{}, 0, 0);
}
// A content document with a scripts table between two others, as a world's tables hold it.
RK_OTHER :: "628d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5";
RK_DOC :: "aethyr.content.v1 demo 3\nreach 4000\ntable point id name:text x:cm z:cm\n1|Old oak|-1200|350\ntable scripts id name:text hash:text for:text\n1|pacer|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|kind 1\n3|guard|628d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|who 2\ntable zone id name:text\n1|Gate\n";
// RK_DOC with its first `was` replaced by `with`, into out.
rk_swap :: (was: string, with: string, out: [] u8) -> string {
  s := RK_DOC;
  for a: 0..<s.count - was.count + 1 {
    if s[a..<a + was.count] != was { continue; }
    n := ct_put(out, 0, s[0..<a]); n = ct_put(out, n, with); n = ct_put(out, n, s[a + was.count..<s.count]);
    return cast(string) out[0..<n];
  }
  return "";
}
#test "a scan reads every row of the scripts table; a document with no such table names none" {
  d: [1] ContentDoc; rows: [SH_SCRIPTS] ScriptRow; bad: [2] int; o: [1024] u8;
  #assert ct_read(d[..], RK_DOC) && srw_scan(d[..], rows[..], bad[..]) == 2 && bad[0] == 0 && bad[1] == SRW_OK;
  #assert rows[0].ok && rows[0].slot == 0 && rows[0].by_kind && rows[0].n == 1 && cast(string) rows[0].name[0..<rows[0].name_n] == "pacer" && cast(string) rows[0].hash[..] == RK_HASH;
  #assert rows[1].ok && rows[1].slot == 2 && !rows[1].by_kind && rows[1].n == 2 && cast(string) rows[1].hash[..] == RK_OTHER;
  #assert srw_names(rows[0..<2], RK_HASH) && srw_names(rows[0..<2], RK_OTHER) && !srw_names(rows[0..<1], RK_OTHER) && !srw_names(rows[0..<0], RK_HASH) && !srw_names(rows[0..<2], "");
  none := "aethyr.content.v1 demo 3\nreach 4000\ntable point id name:text x:cm z:cm\n1|Old oak|-1200|350\n";
  #assert ct_read(d[..], none) && srw_scan(d[..], rows[..], bad[..]) == 0;
  // a table with its head and no rows names none
  #assert ct_read(d[..], rk_swap("1|pacer|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|kind 1\n3|guard|628d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|who 2\n", "", o[..])) && srw_scan(d[..], rows[..], bad[..]) == 0;
}
#test "a scan refuses a scripts table of another shape, and a row that does not read, by its ID and why" {
  d: [1] ContentDoc; rows: [SH_SCRIPTS] ScriptRow; bad: [2] int; o: [1024] u8;
  shapes := [4] string.["table scripts id name:text hash:text", "table scripts id name:text hash:text for:int", "table scripts id name:text code:text for:text", "table scripts id hash:text name:text for:text"];
  for shape: shapes {
    text := rk_swap("table scripts id name:text hash:text for:text", shape, o[..]);
    if shape == shapes[0] { text = "aethyr.content.v1 demo 3\nreach 4000\ntable scripts id name:text hash:text\n1|pacer|x\n"; }
    if shape == shapes[1] { text = "aethyr.content.v1 demo 3\nreach 4000\ntable scripts id name:text hash:text for:int\n1|pacer|x|1\n"; }
    #assert ct_read(d[..], text) && srw_scan(d[..], rows[..], bad[..]) == SRW_SCAN_TABLE;
  }
  #assert ct_read(d[..], rk_swap("3|guard", "9|guard", o[..])) && srw_scan(d[..], rows[..], bad[..]) == SRW_SCAN_ROW && bad[0] == 9 && bad[1] == SRW_BAD_ID;
  #assert ct_read(d[..], rk_swap("3|guard", "3|Guard", o[..])) && srw_scan(d[..], rows[..], bad[..]) == SRW_SCAN_ROW && bad[0] == 3 && bad[1] == SRW_BAD_NAME;
  #assert ct_read(d[..], rk_swap("|528d", "|528D", o[..])) && srw_scan(d[..], rows[..], bad[..]) == SRW_SCAN_ROW && bad[0] == 1 && bad[1] == SRW_BAD_HASH;
  #assert ct_read(d[..], rk_swap("who 2", "all", o[..])) && srw_scan(d[..], rows[..], bad[..]) == SRW_SCAN_ROW && bad[0] == 3 && bad[1] == SRW_BAD_FOR;
  // more rows than the caller has room for: the first row past it is refused by its ID
  #assert ct_read(d[..], RK_DOC) && srw_scan(d[..], rows[0..<1], bad[..]) == SRW_SCAN_ROW && bad[0] == 3 && bad[1] == SRW_BAD_ID;
}
