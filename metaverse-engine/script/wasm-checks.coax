// Checks of the module check (wasm.coax), on modules made by wasm-make.coax and then damaged.
#load "wasm-make.coax";

wk_make :: (out: [] u8, imports: [] int, tick: [] u8) -> int {
  echo := WB_ECHO;
  return wb_module(out, imports, tick, 0, echo[..]);
}
// The offset of the first section with this id, or -1.
wk_section :: (b: [] u8, id: int) -> int {
  cur: [1] WmCur; cur[0] = WmCur.{at = 8, end = b.count, ok = true};
  while cur[0].at < b.count {
    at := cur[0].at; got := wm_byte(b, cur[..]); size := wm_u32(b, cur[..]);
    if !cur[0].ok { return -1; }
    if got == id { return at; }
    cur[0].at += size;
  }
  return -1;
}

#test "a made module passes, and the description names its face, memory and powers" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule;
  rows := [3] int.[SA_X, SA_MOVE, SA_STRIKE]; nothing := WB_NOTHING;
  n := wk_make(b[..], rows[..], nothing[..]);
  #assert n > 0 && wm_check(b[0..<n], m[..], jump[..]);
  #assert m[0].code == WM_OK && m[0].n_imports == 3 && m[0].n_funcs == 6 && m[0].pages == 1 && m[0].n_globals == 1 && m[0].n_data == 1;
  #assert m[0].powers == 7 && m[0].handlers == 1;
  #assert m[0].import_row[0] == SA_X && m[0].import_row[1] == SA_MOVE && m[0].import_row[2] == SA_STRIKE;
  #assert m[0].entry[RS_ABI] == 3 && m[0].entry[RS_SLOTS] == 6 && m[0].entry[RS_FIRST_HANDLER + RH_TICK] == 7 && m[0].entry[RS_FIRST_HANDLER + RH_HIT] == -1;
  #assert m[0].globals[0].writable && m[0].globals[0].init == WB_STACK && m[0].data[0].to == 16 && m[0].data[0].n == 2 && b[m[0].data[0].at] == 'h';
  none: [1] int;
  n = wk_make(b[..], none[0..<0], nothing[..]);
  #assert wm_check(b[0..<n], m[..], jump[..]) && m[0].powers == 0 && m[0].n_imports == 0 && m[0].entry[RS_ABI] == 0;
}
#test "size, magic and truncation refuse with their codes" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule; big: [WM_BYTES + 1] u8; big_jump: [WM_BYTES + 1] s32;
  none: [1] int; nothing := WB_NOTHING;
  n := wk_make(b[..], none[0..<0], nothing[..]);
  #assert !wm_check(big[..], m[..], big_jump[..]) && m[0].code == WM_TOO_BIG;
  #assert !wm_check(b[0..<n], m[..], jump[0..<n - 1]) && m[0].code == WM_TOO_BIG;
  #assert !wm_check(b[0..<7], m[..], jump[..]) && m[0].code == WM_MAGIC;
  saved := b[4]; b[4] = 2;
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_MAGIC && m[0].at == 4;
  b[4] = saved;
  // Every proper prefix is refused, and none reads past its end; but for the one that ends where the data
  // section would begin: a module without data is whole.
  data_at := wk_section(b[0..<n], 11);
  #assert data_at > 8;
  for cut: 8..<n {
    passed := wm_check(b[0..<cut], m[..], jump[..]);
    if cut == data_at { #assert passed && m[0].n_data == 0; } else { #assert !passed && m[0].code != WM_OK; }
  }
  #assert wm_check(b[0..<n], m[..], jump[..]);
}
#test "an import outside the API refuses: its module, its name, its signature, its kind" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule;
  rows := [1] int.[SA_X]; nothing := WB_NOTHING;
  n := wk_make(b[..], rows[..], nothing[..]);
  at := wk_section(b[0..<n], 2);
  #assert at > 0 && wm_check(b[0..<n], m[..], jump[..]);
  // The section: id, size, count, 3 "env", 4 "sa_x", kind, type.
  #assert b[at + 4] == 'e' && b[at + 8] == 's' && b[at + 11] == 'x';
  b[at + 4] = 'f';
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_IMPORT;
  b[at + 4] = 'e'; b[at + 11] = 'q';
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_IMPORT;
  b[at + 11] = 'y';   // sa_y has the same signature: still a row
  #assert wm_check(b[0..<n], m[..], jump[..]) && m[0].import_row[0] == SA_Y;
  b[at + 11] = 'x'; b[at + 13] = 0;   // type 0 is () -> i32, not sa_x's
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_IMPORT;
  b[at + 13] = 3; b[at + 12] = 2;     // a memory import
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code != WM_OK;
  b[at + 12] = 0;
  #assert wm_check(b[0..<n], m[..], jump[..]);
}
#test "memory needs a maximum within the limit" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule; none: [1] int; nothing := WB_NOTHING;
  n := wk_make(b[..], none[0..<0], nothing[..]);
  at := wk_section(b[0..<n], 5);
  // id, size, count 1, flags 1, min 1, max 1.
  #assert at > 0 && b[at + 3] == 1 && b[at + 5] == 1;
  b[at + 5] = cast(u8) WM_PAGES; #assert wm_check(b[0..<n], m[..], jump[..]) && m[0].pages == 1;
  b[at + 5] = cast(u8) (WM_PAGES + 1); #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_MEMORY;
  b[at + 5] = 1; b[at + 4] = 0; #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_MEMORY;
  b[at + 4] = 2; #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_MEMORY;
  b[at + 4] = 1; b[at + 2] = 2; #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code != WM_OK;
}
#test "sections come once, in order; start, elements and a data count are refused; one empty table is admitted" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule; none: [1] int; nothing := WB_NOTHING;
  n := wk_make(b[..], none[0..<0], nothing[..]);
  ids := [3] int.[8, 9, 12];
  at := wk_section(b[0..<n], 6);
  for id: ids {
    b[at] = cast(u8) id;
    #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_SECTION && m[0].at == at;
  }
  // The global section's bytes read as a table section: one entry, but not of function references.
  b[at] = 4;
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code != WM_OK;
  // The linker's table (one funcref table, 1 to 1) before the memory section passes.
  tabled: [1100] u8; t := 0; mem_at := wk_section(b[0..<n], 5); b[at] = 6;
  for i: 0..<mem_at { tabled[t] = b[i]; t += 1; }
  table := [7] u8.[4, 5, 1, 112, 1, 1, 1];
  for v: table { tabled[t] = v; t += 1; }
  for i: mem_at..<n { tabled[t] = b[i]; t += 1; }
  table_jump: [1100] s32;
  #assert wm_check(tabled[0..<t], m[..], table_jump[..]);
  tabled[mem_at + 2] = 2;   // two tables
  #assert !wm_check(tabled[0..<t], m[..], table_jump[..]) && m[0].code == WM_SECTION;
  b[at] = 3;   // a second function section
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_SECTION;
  b[at] = 6;
  // A custom section anywhere is skipped.
  with: [1100] u8; k := 0;
  for i: 0..<8 { with[k] = b[i]; k += 1; }
  custom := [6] u8.[0, 4, 1, 'n', 7, 7];
  for v: custom { with[k] = v; k += 1; }
  for i: 8..<n { with[k] = b[i]; k += 1; }
  wide: [1100] s32;
  #assert wm_check(with[0..<k], m[..], wide[..]);
}
#test "an export outside the face refuses, and so does a face without a handler" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule; none: [1] int; nothing := WB_NOTHING;
  n := wk_make(b[..], none[0..<0], nothing[..]);
  at := wk_section(b[0..<n], 7);
  // id, size, count, 6 "memory" kind index, 6 "rs_abi" ...
  #assert at > 0 && b[at + 4] == 'm' && b[at + 13] == 'r' && b[at + 16] == 'a';
  b[at + 16] = 'x';   // rs_xbi
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_EXPORT;
  b[at + 16] = 'a'; b[at + 20] = 4;   // rs_abi names the tick function: wrong signature
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_EXPORT;
  b[at + 20] = 0;
  #assert wm_check(b[0..<n], m[..], jump[..]);
  // Rename rs_on_tick to rs_on_use: the signature (i64, i32, f32) is not on_use's (i64, i32, i64).
  tick := at + 2;
  while tick + 9 < n && !(b[tick] == 'o' && b[tick + 1] == 'n' && b[tick + 2] == '_' && b[tick + 3] == 't') { tick += 1; }
  #assert b[tick + 3] == 't' && b[tick + 6] == 'k';
  b[tick + 3] = 'h'; b[tick + 4] = 'i'; b[tick + 5] = 't'; b[tick + 6] = 's';   // rs_on_hits: unknown
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_EXPORT;
}
#test "instructions outside the profile and indices that do not exist refuse" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule; none: [1] int;
  bodies := [12] [6] u8.[
    [6] u8.[17, 0, 0, 11, 0, 0],      // call_indirect
    [6] u8.[32, 3, 26, 11, 0, 0],     // local.get 3: tick has locals 0 to 2
    [6] u8.[35, 1, 26, 11, 0, 0],     // global.get 1
    [6] u8.[16, 6, 26, 11, 0, 0],     // call 6: six functions, 0 to 5
    [6] u8.[12, 1, 11, 0, 0, 0],      // br 1 at depth 0
    [6] u8.[2, 64, 12, 2, 11, 11],    // br 2 at depth 1
    [6] u8.[252, 10, 0, 0, 11, 0],    // memory.copy
    [6] u8.[5, 11, 0, 0, 0, 0],       // else without if
    [6] u8.[2, 64, 11, 11, 11, 0],    // an end too many
    [6] u8.[2, 64, 1, 1, 1, 1],       // no end
    [6] u8.[2, 110, 11, 11, 0, 0],    // a block type that is not a value type
    [6] u8.[65, 128, 128, 128, 128, 16]   // i32.const that does not fit 32 bits
  ];
  lens := [12] int.[4, 4, 4, 4, 3, 6, 5, 2, 5, 6, 4, 6];
  for body, i: bodies {
    code := body;
    n := wk_make(b[..], none[0..<0], code[0..<lens[i]]);
    #assert n > 0 && !wm_check(b[0..<n], m[..], jump[..]) && (m[0].code == WM_CODE || m[0].code == WM_MALFORMED);
  }
  // global.set on an immutable global: flip the made module's global to immutable.
  set := [5] u8.[65, 0, 36, 0, 11];
  n := wk_make(b[..], none[0..<0], set[..]);
  #assert wm_check(b[0..<n], m[..], jump[..]);
  at := wk_section(b[0..<n], 6);
  b[at + 4] = 0;
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_CODE;
}
#test "block targets: a false if goes past its else, an else to its end, a block to after its end" {
  b: [1024] u8; jump: [1024] s32; m: [1] WmModule; none: [1] int;
  // 0: i32.const 1; 2: if; 4: nop; 5: else; 6: nop; 7: end; 8: block; 10: loop; 12: br 1; 14: end; 15: end; 16: end
  code := [17] u8.[65, 1, 4, 64, 1, 5, 1, 11, 2, 64, 3, 64, 12, 1, 11, 11, 11];
  n := wk_make(b[..], none[0..<0], code[..]);
  #assert wm_check(b[0..<n], m[..], jump[..]);
  base := cast(int) m[0].funcs[WB_TICK].body;
  #assert jump[base + 2] == cast(s32) (base + 6) && jump[base + 3] == cast(s32) (base + 8) && jump[base + 5] == cast(s32) (base + 7);
  #assert jump[base + 9] == cast(s32) (base + 16) && jump[base + 11] == cast(s32) (base + 12);
  // An if without an else: false goes to its end.
  plain := [6] u8.[65, 0, 4, 64, 11, 11];
  n = wk_make(b[..], none[0..<0], plain[..]);
  #assert wm_check(b[0..<n], m[..], jump[..]);
  base = cast(int) m[0].funcs[WB_TICK].body;
  #assert jump[base + 2] == cast(s32) (base + 4) && jump[base + 3] == cast(s32) (base + 5);
}
#test "nesting and locals stop at their limits" {
  b: [2048] u8; jump: [2048] s32; m: [1] WmModule; none: [1] int; echo := WB_ECHO;
  deep: [3 * WM_NEST + 4] u8; k := 0;
  for i: 0..<WM_NEST { deep[k] = 2; deep[k + 1] = 64; k += 2; }
  for i: 0..<WM_NEST + 1 { deep[k] = 11; k += 1; }
  n := wb_module(b[..], none[0..<0], deep[0..<k], 0, echo[..]);
  #assert n > 0 && wm_check(b[0..<n], m[..], jump[..]);
  k = 0;
  for i: 0..<WM_NEST + 1 { deep[k] = 2; deep[k + 1] = 64; k += 2; }
  for i: 0..<WM_NEST + 2 { deep[k] = 11; k += 1; }
  n = wb_module(b[..], none[0..<0], deep[0..<k], 0, echo[..]);
  #assert n > 0 && !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_LIMIT;
  nothing := WB_NOTHING;
  n = wb_module(b[..], none[0..<0], nothing[..], WM_LOCALS - 3, echo[..]);
  #assert wm_check(b[0..<n], m[..], jump[..]) && m[0].funcs[WB_TICK].locals == WM_LOCALS - 3;
  n = wb_module(b[..], none[0..<0], nothing[..], WM_LOCALS - 2, echo[..]);
  #assert !wm_check(b[0..<n], m[..], jump[..]) && m[0].code == WM_LIMIT;
}
#test "LEB128 readers: bounds, widths and signs" {
  cur: [1] WmCur;
  a := [5] u8.[255, 255, 255, 255, 15];
  cur[0] = WmCur.{at = 0, end = 5, ok = true}; #assert wm_u32(a[..], cur[..]) == 4294967295 && cur[0].ok && cur[0].at == 5;
  a[4] = 16; cur[0] = WmCur.{at = 0, end = 5, ok = true}; v := wm_u32(a[..], cur[..]); #assert !cur[0].ok;
  a[4] = 15; cur[0] = WmCur.{at = 0, end = 4, ok = true}; v = wm_u32(a[..], cur[..]); #assert !cur[0].ok;
  one := [1] u8.[127];
  cur[0] = WmCur.{at = 0, end = 1, ok = true}; #assert wm_signed(one[..], cur[..], 32) == 4294967295 && cur[0].ok;
  cur[0] = WmCur.{at = 0, end = 1, ok = true}; #assert wm_signed(one[..], cur[..], 64) == 18446744073709551615 && cur[0].ok;
  low := [5] u8.[128, 128, 128, 128, 120];   // -2147483648
  cur[0] = WmCur.{at = 0, end = 5, ok = true}; #assert wm_signed(low[..], cur[..], 32) == 2147483648 && cur[0].ok;
  low[4] = 8;   // +2147483648: does not fit a signed 32
  cur[0] = WmCur.{at = 0, end = 5, ok = true}; s := wm_signed(low[..], cur[..], 32); #assert !cur[0].ok;
  wide := [10] u8.[128, 128, 128, 128, 128, 128, 128, 128, 128, 127];   // the least i64
  cur[0] = WmCur.{at = 0, end = 10, ok = true}; #assert wm_signed(wide[..], cur[..], 64) == 9223372036854775808 && cur[0].ok;
  cur[0] = WmCur.{at = 0, end = 0, ok = true}; #assert wm_byte(a[..], cur[..]) == 0 && !cur[0].ok;
}
