// Checks of a world's scripts as bytes (world.coax).
SwkWork :: struct { w: [1] ScriptWorld; b: [2048] u8; f: [1] ScriptFrame; frame: [SF_BYTES] u8; out: [SR_BYTES] u8; r: [1] ScriptRun; text: [SW_STATUS] u8; }
#test "a module loads into a place, a frame's bytes run it, and the status names it" #steps 400000000 {
  k: [1] SwkWork; rows := [2] int.[SA_X, SA_MOVE]; echo := WB_ECHO;
  tick := [13] u8.[32, 0, 32, 0, 16, 0, 32, 2, 32, 2, 16, 1, 11];   // sa_move(me, sa_x(me), dt, dt)
  n := wb_module(k[0].b[..], rows[..], tick[..], 0, echo[..]);
  #assert sw_load(k[0].w[..], 2, "mover", k[0].b[0..<n], "[]") == 0 && k[0].w[0].slots[2].loaded && !k[0].w[0].slots[0].loaded;
  k[0].f[0] = ScriptFrame.{tick = 1, seed = 5, dt = 0.5, n_things = 2};
  k[0].f[0].things[0] = ScriptThing.{id = 10, script = 2, alive = true, x = 4.0, speed = 9.0};
  k[0].f[0].things[1] = ScriptThing.{id = 11, script = 0, alive = true};   // place 0 holds no script: nothing runs for it
  fn := sf_write(k[0].f[..], k[0].frame[..]);
  rn := sw_tick(k[0].w[..], k[0].frame[0..<fn], k[0].out[..]);
  #assert rn > 0 && sr_read(k[0].out[0..<rn], k[0].r[..]);
  #assert k[0].r[0].n_commands == 1 && k[0].r[0].commands[0].op == SA_MOVE && k[0].r[0].commands[0].thing == 10 && k[0].r[0].commands[0].a == 4.0 && k[0].r[0].calls == 1 && k[0].r[0].failed == 0;
  text := sw_status(k[0].w[..], k[0].text[..]);
  head := "{\"schema\":\"world.script-status.v1\",\"ticks\":1,\"call_fuel\":20000,\"tick_fuel\":400000,\"tick_left\":";
  #assert text.count > head.count && text[0..<head.count] == head;
  nodes: [64] JvNode; d: [1] Jv; word: [80] u8;
  #assert jv_parse(d[..], text, nodes[..]);
  s := jv_at(d[0], jv_get(d[0], 0, "scripts"), 0);
  #assert jv_len(d[0], jv_get(d[0], 0, "scripts")) == 1 && jv_int(d[0], jv_get(d[0], s, "at"), -1) == 2 && jv_int(d[0], jv_get(d[0], s, "calls"), -1) == 1 && jv_int(d[0], jv_get(d[0], s, "things"), -1) == 1;
  wn := jv_str(d[0], jv_get(d[0], s, "name"), word[..]);
  #assert cast(string) word[0..<wn] == "mover" && jv_str(d[0], jv_get(d[0], s, "hash"), word[..]) == 64 && jv_int(d[0], jv_get(d[0], s, "peak"), 0) > 0;
  // The status reads back: the place, the name, the calls and the costliest call; nothing failed.
  st: [1] ScriptStatus;
  #assert sw_status_read(text, st[..]) && st[0].n == 1 && st[0].call_fuel == SH_CALL_FUEL && st[0].rows[0].at == 2 && cast(string) st[0].rows[0].name[0..<st[0].rows[0].name_n] == "mover";
  #assert st[0].rows[0].calls == 1 && st[0].rows[0].failures == 0 && st[0].rows[0].things == 1 && st[0].rows[0].peak > 0 && st[0].rows[0].last == SD_NONE && st[0].rows[0].handler == -1 && !st[0].rows[0].off;
  #assert !sw_status_read("", st[..]) && !sw_status_read("{\"schema\":\"world.scripts.v1\",\"scripts\":[]}", st[..]) && !st[0].ok;
  failed := "{\"schema\":\"world.script-status.v1\",\"ticks\":9,\"call_fuel\":20000,\"tick_fuel\":400000,\"tick_left\":1,\"scripts\":[{\"at\":0,\"name\":\"a\",\"hash\":\"528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5\",\"off\":true,\"things\":5,\"calls\":40,\"failures\":3,\"spent\":900,\"peak\":20000,\"last\":\"engine.diagnostic.script-over-budget.v1\",\"handler\":\"on_tick\",\"line\":14,\"status\":\"\"}]}";
  #assert sw_status_read(failed, st[..]) && st[0].rows[0].off && st[0].rows[0].last == SD_OVER_BUDGET && st[0].rows[0].handler == RH_TICK && st[0].rows[0].line == 14 && st[0].rows[0].failures == 3;
  // Bytes that are not a frame run nothing.
  #assert sw_tick(k[0].w[..], k[0].frame[0..<fn - 1], k[0].out[..]) == -1 && k[0].w[0].ticks == 1;
  // A refused module leaves the running one; a bad place, name or fields are refused before anything is checked.
  k[0].b[4] = 7;
  #assert sw_load(k[0].w[..], 2, "mover", k[0].b[0..<n], "") == SD_REFUSED && sw_refusal(k[0].w[..]).detail == WM_MAGIC && k[0].w[0].slots[2].loaded;
  k[0].b[4] = 1;
  #assert sw_load(k[0].w[..], SH_SCRIPTS, "mover", k[0].b[0..<n], "") == -1 && sw_load(k[0].w[..], 0, "Mover", k[0].b[0..<n], "") == -1 && sw_load(k[0].w[..], 0, "mover", k[0].b[0..<n], "{}") == -1;
  sw_unload(k[0].w[..], 2);
  rn = sw_tick(k[0].w[..], k[0].frame[0..<fn], k[0].out[..]);
  #assert rn == SR_HEAD && sr_read(k[0].out[0..<rn], k[0].r[..]) && k[0].r[0].calls == 0;
}
