// What a room shard and the API say to each other outside the session wire (Protocol E7 and E8,
// GitHub #13250): the one codec. The profile is proto/verse/room-reports-v1.json, checked by
// coax/web/room/report-profile.coax; docs/protocol/room-reports-v1.md says what each line means.
//
//   vitals      POST /api/playtest/room-vitals      "t MS\no SHARD GEN BATCH\nPID HP MAX XP WANTED REV AT [OWNER] [c=CLASS]\n..."
//               its receipt                         "receipt GEN BATCH CODES\n" (a d s u x f, one a line)
//   directory   POST /api/playtest/room-directory   "t MS\ns SHARD FREE\n[g GEN [d]\n][e URL\n]r CODE PLAYERS PID...\n[h PLAYERS TICK_US\n]"
//   drain       the text a drain's MAC covers        "drain SHARD AT WAIT"
//   control     GET /api/playtest/room-control       the ask's signed text "t MS"; the answer's lines
//               pvp, edit, kick, hold, place, flag, dice (the event and levels lines are
//               coax/web/room/room-events.coax's)
//   checkpoint  POST /api/playtest/room-checkpoint   the capture is character-checkpoint.coax's; its
//               receipt is {"v":2,"status":"applied","owner":1,"process":2,"rev":3,"accepted_at":4}
//
// Writers: the room (coax/web/room/room-vitals.coax, room-directory.coax, room-control.coax), the
// room's local stand-in for the API (room-vitals.coax rm_vitals_local, room-dev.coax) and the API
// (coax/web/api/player.c through ticket-sign.coax: the two receipts). Readers: the room (the
// receipts and the control answer) and the API (the vitals and directory posts, "the API's readers"
// below: player.c room_vitals and rooms.c report call them through ticket-sign.coax). SQL builds
// the control answer; its allowlist line says so.
//
// A writer takes the buffer and where to go on, and returns the new end, or -1 when it did not fit
// (and -1 again from every later call, so a caller checks once).
//   coax/bin/coax test metaverse-engine/session/room-report.coax --library
#load "../../coax/lib/json/json.coax";

room_report_put :: (b: [] u8, n: int, s: string) -> int #effects(all) {
  if n < 0 || n + s.count > b.count { return -1; }
  for i: 0..<s.count { b[n + i] = s[i]; }
  return n + s.count;
}
// A whole number in decimal; a negative one is written 0.
room_report_int :: (b: [] u8, n: int, x: int) -> int #effects(all) {
  if n < 0 { return -1; }
  d: [20] u8; dn := 0; e := ifx x < 0 then 0 else x;
  while e > 0 || dn == 0 { d[dn] = cast(u8) ('0' + e % 10); dn += 1; e = e / 10; }
  if n + dn > b.count { return -1; }
  for j: 0..<dn { b[n + j] = d[dn - 1 - j]; }
  return n + dn;
}
// 1 to `most` decimal digits as a number, or -1.
room_report_num :: (t: string, most: int) -> int #effects(all) {
  if t.count == 0 || t.count > most { return -1; }
  x := 0;
  for c: t { if c < '0' || c > '9' { return -1; } x = x * 10 + cast(int) (c - '0'); }
  return x;
}
// The word that starts at `at`: up to the next space or the line's end.
room_report_word :: (line: string, at: int) -> string #effects(all) {
  i := at;
  while i < line.count && line[i] != ' ' { i += 1; }
  return line[at..<i];
}

// "t MS": the first line of a vitals or directory post (the caller adds its line end), and the whole
// text a control ask's MAC covers.
room_report_stamp :: (b: [] u8, n: int, ms: int) -> int #effects(all) {
  return room_report_int(b, room_report_put(b, n, "t "), ms);
}

// ---- vitals ------------------------------------------------------------------------------------------

// "t MS\no SHARD GEN BATCH\n"
room_report_vitals_head :: (b: [] u8, ms: int, shard: int, gen: int, batch: int) -> int #effects(all) {
  n := room_report_stamp(b, 0, ms);
  n = room_report_put(b, n, "\no "); n = room_report_int(b, n, shard);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, gen);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, batch);
  return room_report_put(b, n, "\n");
}
// "PID HP MAX XP WANTED REV AT[ OWNER][ c=CLASS]\n": OWNER when it is above 0, the class when it has one.
room_report_vitals_line :: (b: [] u8, at: int, pid: string, hp: int, max: int, xp: int, wanted: int, rev: int, rev_at: int, owner: int, klass: string) -> int #effects(all) {
  n := room_report_put(b, at, pid);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, hp);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, max);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, xp);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, wanted);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, rev);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, rev_at);
  if owner > 0 { n = room_report_put(b, n, " "); n = room_report_int(b, n, owner); }
  if klass.count > 0 { n = room_report_put(b, n, " c="); n = room_report_put(b, n, klass); }
  return room_report_put(b, n, "\n");
}
// "receipt GEN BATCH CODES\n", the API's 200 to a vitals post: one code a line, in the post's order.
room_report_receipt :: (b: [] u8, gen: int, batch: int, codes: string) -> int #export_c #effects(all) {
  n := room_report_put(b, 0, "receipt "); n = room_report_int(b, n, gen);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, batch);
  n = room_report_put(b, n, " "); n = room_report_put(b, n, codes);
  return room_report_put(b, n, "\n");
}
// A 2xx body to a vitals post. kind: ROOM_RECEIPT (gen, batch and the codes' place in the body),
// ROOM_RECEIPT_KEPT (an API from before receipts: {"kept":N}, every line kept) or ROOM_RECEIPT_NONE.
ROOM_RECEIPT_NONE :: 0;
ROOM_RECEIPT :: 1;
ROOM_RECEIPT_KEPT :: 2;
RoomReceipt :: struct { kind: int; gen: int; batch: int; codes_at: int; codes_n: int; }
room_report_receipt_read :: (body: string) -> RoomReceipt #effects(all) {
  r := RoomReceipt.{kind = ROOM_RECEIPT_NONE, gen = -1, batch = -1};
  if body.count > 8 && body[0..<8] == "{\"kept\":" { r.kind = ROOM_RECEIPT_KEPT; return r; }
  if !(body.count > 8 && body[0..<8] == "receipt ") { return r; }
  fa: [4] int; fe: [4] int; fn := 0; at := 8; j := 8;
  while j <= body.count && fn < 4 {
    if j == body.count || body[j] == ' ' || body[j] == '\n' { fa[fn] = at; fe[fn] = j; fn += 1; at = j + 1; if j < body.count && body[j] == '\n' { break; } }
    j += 1;
  }
  if fn < 2 { return r; }
  r.kind = ROOM_RECEIPT;
  r.gen = room_report_num(body[fa[0]..<fe[0]], 18); r.batch = room_report_num(body[fa[1]..<fe[1]], 18);
  if fn >= 3 { r.codes_at = fa[2]; r.codes_n = fe[2] - fa[2]; }
  return r;
}

// ---- directory ---------------------------------------------------------------------------------------

// "s SHARD FREE\n"
room_report_dir_shard :: (b: [] u8, at: int, shard: int, free: int) -> int #effects(all) {
  n := room_report_put(b, at, "s "); n = room_report_int(b, n, shard); n = room_report_put(b, n, " "); n = room_report_int(b, n, free);
  return room_report_put(b, n, "\n");
}
// "g GEN\n", or "g GEN d\n" while the shard drains or is out of rotation
room_report_dir_gen :: (b: [] u8, at: int, gen: int, draining: bool) -> int #effects(all) {
  n := room_report_put(b, at, "g "); n = room_report_int(b, n, gen);
  return room_report_put(b, n, ifx draining then " d\n" else "\n");
}
// "e URL\n"
room_report_dir_endpoint :: (b: [] u8, at: int, url: string) -> int #effects(all) {
  return room_report_put(b, room_report_put(b, room_report_put(b, at, "e "), url), "\n");
}
// "r CODE PLAYERS", then room_report_dir_pid for each ticketed or held player, then room_report_dir_end
room_report_dir_room :: (b: [] u8, at: int, code: string, players: int) -> int #effects(all) {
  n := room_report_put(b, at, "r "); n = room_report_put(b, n, code); n = room_report_put(b, n, " ");
  return room_report_int(b, n, players);
}
room_report_dir_pid :: (b: [] u8, at: int, pid: string) -> int #effects(all) { return room_report_put(b, room_report_put(b, at, " "), pid); }
room_report_dir_end :: (b: [] u8, at: int) -> int #effects(all) { return room_report_put(b, at, "\n"); }
// "h PLAYERS TICK_P95_US\n"
room_report_dir_health :: (b: [] u8, at: int, players: int, tick_us: int) -> int #effects(all) {
  n := room_report_put(b, at, "h "); n = room_report_int(b, n, players); n = room_report_put(b, n, " "); n = room_report_int(b, n, tick_us);
  return room_report_put(b, n, "\n");
}
// "drain SHARD AT WAIT": what the MAC of POST /api/room/sK/drain covers
room_report_drain :: (b: [] u8, shard: int, at_ms: int, wait: int) -> int #effects(all) {
  n := room_report_put(b, 0, "drain "); n = room_report_int(b, n, shard); n = room_report_put(b, n, " "); n = room_report_int(b, n, at_ms);
  return room_report_int(b, room_report_put(b, n, " "), wait);
}

// ---- control -----------------------------------------------------------------------------------------

ROOM_CONTROL_OTHER :: 0;   // not one of these lines, or one with a field missing
ROOM_CONTROL_PVP :: 1;     // "pvp 0|1"                    a: 1 on
ROOM_CONTROL_EDIT :: 2;    // "edit STAMP"                 a: the stamp, -1 when it is no number
ROOM_CONTROL_KICK :: 3;    // "kick PID"                   the word: the player
ROOM_CONTROL_HOLD :: 4;    // "hold CODE SEAT STAMP"       the word: the room; a: the seat, b: the stamp
ROOM_CONTROL_PLACE :: 5;   // "place CODE SEAT BOAT STAMP" the word: the room; a: the seat, b: the boat, c: the stamp
ROOM_CONTROL_FLAG :: 6;    // "flag NAME VALUE"            the word: the name; a: the value, -1 none or no number
ROOM_CONTROL_DICE :: 7;    // "dice fixed" or "dice random" a: 1 fixed
RoomControlLine :: struct { kind: int; word_at: int; word_n: int; a: int; b: int; c: int; }
// One line of the API's control answer. A number that is no number, or longer than 15 digits, is -1.
room_report_control_read :: (line: string) -> RoomControlLine #effects(all) {
  r := RoomControlLine.{kind = ROOM_CONTROL_OTHER, a = -1, b = -1, c = -1};
  if line == "dice fixed" { r.kind = ROOM_CONTROL_DICE; r.a = 1; return r; }
  if line == "dice random" { r.kind = ROOM_CONTROL_DICE; r.a = 0; return r; }
  if line.count > 4 && line[0..<4] == "pvp " { r.kind = ROOM_CONTROL_PVP; r.a = ifx line[4..<line.count] == "1" then 1 else 0; return r; }
  if line.count > 5 && line[0..<5] == "edit " { r.kind = ROOM_CONTROL_EDIT; r.a = room_report_num(line[5..<line.count], 15); return r; }
  if line.count > 5 && line[0..<5] == "kick " { w := room_report_word(line, 5); r.kind = ROOM_CONTROL_KICK; r.word_at = 5; r.word_n = w.count; return r; }
  if line.count > 5 && line[0..<5] == "flag " {
    w := room_report_word(line, 5);
    r.kind = ROOM_CONTROL_FLAG; r.word_at = 5; r.word_n = w.count;
    if 5 + w.count + 1 < line.count { r.a = room_report_num(line[5 + w.count + 1..<line.count], 15); }
    return r;
  }
  hold := line.count > 5 && line[0..<5] == "hold ";
  place := line.count > 6 && line[0..<6] == "place ";
  if hold || place {
    start := ifx hold then 5 else 6;
    w := room_report_word(line, start);
    at := start + w.count + 1;
    if at >= line.count { return r; }
    f := room_report_word(line, at); a := room_report_num(f, 15);
    at += f.count + 1;
    if at >= line.count { return r; }
    f = room_report_word(line, at); b := room_report_num(f, 15);
    if hold { r.kind = ROOM_CONTROL_HOLD; r.word_at = start; r.word_n = w.count; r.a = a; r.b = b; return r; }
    at += f.count + 1;
    if at >= line.count { return r; }
    r.kind = ROOM_CONTROL_PLACE; r.word_at = start; r.word_n = w.count; r.a = a; r.b = b; r.c = room_report_num(room_report_word(line, at), 15);
    return r;
  }
  return r;
}
// The answer's lines, as the API writes them (each ends its line).
room_report_control_pvp :: (b: [] u8, at: int, on: bool) -> int #effects(all) { return room_report_put(b, at, ifx on then "pvp 1\n" else "pvp 0\n"); }
room_report_control_edit :: (b: [] u8, at: int, stamp: int) -> int #effects(all) { return room_report_put(b, room_report_int(b, room_report_put(b, at, "edit "), stamp), "\n"); }
room_report_control_kick :: (b: [] u8, at: int, pid: string) -> int #effects(all) { return room_report_put(b, room_report_put(b, room_report_put(b, at, "kick "), pid), "\n"); }
room_report_control_flag :: (b: [] u8, at: int, name: string, value: int) -> int #effects(all) {
  n := room_report_put(b, at, "flag "); n = room_report_put(b, n, name); n = room_report_put(b, n, " ");
  return room_report_put(b, room_report_int(b, n, value), "\n");
}
room_report_control_hold :: (b: [] u8, at: int, code: string, seat: int, stamp: int) -> int #effects(all) {
  n := room_report_put(b, at, "hold "); n = room_report_put(b, n, code); n = room_report_put(b, n, " "); n = room_report_int(b, n, seat);
  return room_report_put(b, room_report_int(b, room_report_put(b, n, " "), stamp), "\n");
}
room_report_control_place :: (b: [] u8, at: int, code: string, seat: int, boat: int, stamp: int) -> int #effects(all) {
  n := room_report_put(b, at, "place "); n = room_report_put(b, n, code); n = room_report_put(b, n, " "); n = room_report_int(b, n, seat);
  n = room_report_put(b, n, " "); n = room_report_int(b, n, boat);
  return room_report_put(b, room_report_int(b, room_report_put(b, n, " "), stamp), "\n");
}
room_report_control_dice :: (b: [] u8, at: int, fixed: bool) -> int #effects(all) { return room_report_put(b, at, ifx fixed then "dice fixed\n" else "dice random\n"); }

// ---- the checkpoint's receipt ------------------------------------------------------------------------

ROOM_CHECKPOINT_STATUS :: 24;
RoomCheckpointReceipt :: struct { ok: bool; v: int; owner: int; process: int; rev: int; accepted_at: int; status: [ROOM_CHECKPOINT_STATUS] u8; status_n: int; }
room_report_checkpoint_status :: (r: [] RoomCheckpointReceipt) -> string #effects(all) { return cast(string) r[0].status[0..<r[0].status_n]; }
// {"v":2,"status":"applied","owner":1,"process":2,"rev":3,"accepted_at":4}
room_report_checkpoint_receipt :: (b: [] u8, v: int, status: string, owner: int, process: int, rev: int, accepted_at: int) -> int #export_c #effects(all) {
  o: [1] Jo; jo_start(o[..], b); jo_obj(o[..]);
  jo_key(o[..], "v"); jo_int(o[..], v); jo_key(o[..], "status"); jo_str(o[..], status);
  jo_key(o[..], "owner"); jo_int(o[..], owner); jo_key(o[..], "process"); jo_int(o[..], process);
  jo_key(o[..], "rev"); jo_int(o[..], rev); jo_key(o[..], "accepted_at"); jo_int(o[..], accepted_at); jo_end(o[..]);
  return ifx o[0].bad then -1 else o[0].n;
}
// A body that is JSON: ok, with each member it has (a missing number is 0; a status that is missing,
// no string or longer than ROOM_CHECKPOINT_STATUS bytes is "").
room_report_checkpoint_receipt_read :: (body: string, r: [] RoomCheckpointReceipt) -> bool #effects(all) {
  r[0] = RoomCheckpointReceipt.{};
  nodes: [32] JvNode; d: [1] Jv;
  if !jv_parse(d[..], body, nodes[..]) { return false; }
  wn := jv_str(d[0], jv_get(d[0], 0, "status"), r[0].status[..]);
  r[0].status_n = ifx wn >= 0 then wn else 0;
  r[0].v = jv_int(d[0], jv_get(d[0], 0, "v"), 0); r[0].owner = jv_int(d[0], jv_get(d[0], 0, "owner"), 0);
  r[0].process = jv_int(d[0], jv_get(d[0], 0, "process"), 0); r[0].rev = jv_int(d[0], jv_get(d[0], 0, "rev"), 0);
  r[0].accepted_at = jv_int(d[0], jv_get(d[0], 0, "accepted_at"), 0);
  r[0].ok = true;
  return true;
}

// ---- the API's readers -------------------------------------------------------------------------------
//
// The API read both posts with C's sscanf and atoi until Protocol wave 2 (#13250), and what is saved
// for a player hangs on what it took from each text. So these read as glibc's sscanf and atoi do,
// for every text and not only a room's: a number may follow white space of any kind (a line end too,
// so a number may be taken from a later line), may have a sign, and one too large is LONG_MAX or
// LONG_MIN ("%lld") or the low 32 bits of that ("%d", atoi); a word is at most 47 bytes and the rest
// of a longer one is read as the next field; a text ends at its first NUL. Do not make them stricter.

// The text as C sees it: up to its first NUL.
room_report_c_text :: (t: string) -> string #effects(all) {
  for i: 0..<t.count { if t[i] == 0 { return t[0..<i]; } }
  return t;
}
// C's isspace
room_report_c_space :: (c: u8) -> bool #effects(all) { return c == ' ' || (c >= 9 && c <= 13); }
ROOM_SCAN_MAX :: 9223372036854775807;
RoomScan :: struct { at: int; v: int; }
// scanf's "%lld" (and strtoll) at s.at: 1 with the number in s.v and s.at after it, 0 when no number
// is there (a sign alone too), -1 when the text ends first. Too large a number is the nearest end.
room_report_scan_num :: (t: string, s: [] RoomScan) -> int #effects(all) {
  i := s[0].at;
  while i < t.count && room_report_c_space(t[i]) { i += 1; }
  if i >= t.count { return -1; }
  neg := t[i] == '-';
  if t[i] == '-' || t[i] == '+' { i += 1; }
  first := i; x := 0; sig := 0; over := false;
  while i < t.count && t[i] >= '0' && t[i] <= '9' {
    d := cast(int) (t[i] - '0');
    if sig > 0 || d > 0 {
      // 18 digits always fit; the 19th does up to 9223372036854775807 (the 8 of LONG_MIN is the end it clamps to)
      if sig < 18 { x = x * 10 + d; }
      else if sig == 18 && (x < 922337203685477580 || (x == 922337203685477580 && d <= 7)) { x = x * 10 + d; }
      else { over = true; }
      sig += 1;
    }
    i += 1;
  }
  if i == first { return 0; }
  if over { s[0].v = ifx neg then -ROOM_SCAN_MAX - 1 else ROOM_SCAN_MAX; }
  else { s[0].v = ifx neg then -x else x; }
  s[0].at = i;
  return 1;
}
// What C's (int) keeps of a long: its low 32 bits, signed.
room_report_c_int :: (v: int) -> int #effects(all) {
  m := v % 4294967296;
  if m < 0 { m += 4294967296; }
  return ifx m >= 2147483648 then m - 4294967296 else m;
}
// atoi at `at`: the number there as an int, 0 when there is none.
room_report_atoi :: (t: string, at: int) -> int #effects(all) {
  s: [1] RoomScan; s[0].at = at;
  return ifx room_report_scan_num(t, s[..]) == 1 then room_report_c_int(s[0].v) else 0;
}
// Where the next line end is at or after `at`, or -1.
room_report_line_end :: (t: string, at: int) -> int #effects(all) {
  i := at;
  while i < t.count { if t[i] == '\n' { return i; } i += 1; }
  return -1;
}

// A vitals post's head, as sscanf("t %lld") and, after the first line end, sscanf("o %d %lld %lld")
// took it. stamped: the first gave a time (at). owned: the second gave all three (shard, gen, batch),
// so the lines have operation IDs and the answer is a receipt. lines: the line end the player lines
// follow (the first after the o line's start when owned, else the first), -1 none.
RoomVitalsHead :: struct { stamped: bool; owned: bool; at: int; shard: int; gen: int; batch: int; lines: int; }
room_report_vitals_head_read :: (body: string, h: [] RoomVitalsHead) #export_c #effects(all) {
  h[0] = RoomVitalsHead.{lines = -1};
  t := room_report_c_text(body);
  s: [1] RoomScan;
  if t.count > 0 && t[0] == 't' {
    s[0].at = 1;
    if room_report_scan_num(t, s[..]) == 1 { h[0].stamped = true; h[0].at = s[0].v; }
  }
  o := room_report_line_end(t, 0);
  h[0].lines = o;
  if o < 0 || o + 1 >= t.count || t[o + 1] != 'o' { return; }
  s[0].at = o + 2;
  if room_report_scan_num(t, s[..]) != 1 { return; }
  h[0].shard = room_report_c_int(s[0].v);
  if room_report_scan_num(t, s[..]) != 1 { return; }
  h[0].gen = s[0].v;
  if room_report_scan_num(t, s[..]) != 1 { return; }
  h[0].batch = s[0].v;
  h[0].owned = true;
  h[0].lines = room_report_line_end(t, o + 1);
}
// One player line, as sscanf("%47s %d %d %d %d %lld %lld %lld") took it from the line's first 159
// bytes (owned), or sscanf("%47s %d %d %d") from its first 127 (a post without operation IDs).
// got: how many fields it took, in order pid, hp, max, xp, wanted, rev, at (when), owner; -1 an empty
// line. A field not taken keeps 0, but xp and owner -1. klass: what follows the first " c=" in those
// bytes, to their end (has_class). pid and klass end in a 0 byte. next: the line end the next line
// follows, -1 none.
ROOM_VITALS_PID :: 48;
ROOM_VITALS_ONE :: 160;
ROOM_VITALS_ONE_LEGACY :: 128;
RoomVitalsLine :: struct { got: int; hp: int; max: int; xp: int; wanted: int; rev: int; when: int; owner: int; next: int; has_class: bool; pid: [ROOM_VITALS_PID] u8; klass: [ROOM_VITALS_ONE] u8; }
// The line that follows the line end at `from` (RoomVitalsHead.lines, then RoomVitalsLine.next):
// false when there is none (no line end, or the text ends after it).
room_report_vitals_line_read :: (body: string, from: int, owned: bool, l: [] RoomVitalsLine) -> bool #export_c #effects(all) {
  l[0] = RoomVitalsLine.{got = -1, xp = -1, owner = -1, next = -1};
  t := room_report_c_text(body);
  if from < 0 || from + 1 >= t.count { return false; }
  start := from + 1;
  next := room_report_line_end(t, start);
  l[0].next = next;
  end := ifx next < 0 then t.count else next;
  most := ifx owned then ROOM_VITALS_ONE - 1 else ROOM_VITALS_ONE_LEGACY - 1;
  if end - start > most { end = start + most; }
  one := t[start..<end];
  i := 0;
  while i < one.count && room_report_c_space(one[i]) { i += 1; }
  if i >= one.count { return true; }
  pn := 0;
  while i < one.count && pn < ROOM_VITALS_PID - 1 && !room_report_c_space(one[i]) { l[0].pid[pn] = one[i]; pn += 1; i += 1; }
  s: [1] RoomScan; s[0].at = i;
  got := 1;
  fields := ifx owned then 8 else 4;
  while got < fields {
    if room_report_scan_num(one, s[..]) != 1 { break; }
    v := s[0].v;
    if got == 1 { l[0].hp = room_report_c_int(v); }
    else if got == 2 { l[0].max = room_report_c_int(v); }
    else if got == 3 { l[0].xp = room_report_c_int(v); }
    else if got == 4 { l[0].wanted = room_report_c_int(v); }
    else if got == 5 { l[0].rev = v; }
    else if got == 6 { l[0].when = v; }
    else { l[0].owner = v; }
    got += 1;
  }
  l[0].got = got;
  if owned {
    c := 0;
    while c + 3 <= one.count {
      if one[c] == ' ' && one[c + 1] == 'c' && one[c + 2] == '=' {
        l[0].has_class = true;
        for k: c + 3..<one.count { l[0].klass[k - c - 3] = one[k]; }
        break;
      }
      c += 1;
    }
  }
  return true;
}

// A directory post as rooms.c took it. kept gets the post without its "e " and "h " lines (what
// verse.room_report reads), and the result is its length, -1 when kept is too small (the post's
// length always fits). shard: atoi after the last "s " line's key, 0 when there is none. endpoint:
// the last "e " line's URL that is wss://NAME.openagents.com[:PORT]/api/room/s.../ in printable
// ASCII without a quote or backslash and under ROOM_DIR_ENDPOINT bytes, ending in a 0 byte ("" none).
// players, tick_us: the last "h " line's two numbers as sscanf("%d %d") took them, both -1 when it
// did not take two (or there is no such line).
ROOM_DIR_ENDPOINT :: 200;
RoomDirPost :: struct { shard: int; players: int; tick_us: int; endpoint_n: int; endpoint: [ROOM_DIR_ENDPOINT] u8; }
room_report_dir_endpoint_ok :: (u: string) -> bool #effects(all) {
  m := u.count;
  if !(m < ROOM_DIR_ENDPOINT && m > 6 && u[0..<6] == "wss://") { return false; }
  slash := -1;
  for i: 6..<m { if u[i] == '/' { slash = i; break; } }
  hn := ifx slash < 0 then 0 else slash - 6;
  for i: 0..<hn { if u[6 + i] == ':' { hn = i; break; } }
  if !(slash >= 0 && hn > 15 && u[6 + hn - 15..<6 + hn] == ".openagents.com") { return false; }
  if !(slash + 11 <= m && u[slash..<slash + 11] == "/api/room/s" && u[m - 1] == '/') { return false; }
  for c: u { if !(c > ' ' && c < 127 && c != '"' && c != '\\') { return false; } }
  return true;
}
room_report_dir_read :: (body: string, kept: [] u8, d: [] RoomDirPost) -> int #export_c #effects(all) {
  d[0] = RoomDirPost.{players = -1, tick_us = -1};
  t := room_report_c_text(body);
  w := 0; at := 0;
  while at < t.count {
    nl := room_report_line_end(t, at);
    end := ifx nl < 0 then t.count else nl + 1;   // the line with its line end
    key := at + 1 < t.count && t[at + 1] == ' ';
    if key && t[at] == 'e' {
      u := t[at + 2..<(ifx nl < 0 then end else end - 1)];
      if room_report_dir_endpoint_ok(u) {
        for i: 0..<ROOM_DIR_ENDPOINT { d[0].endpoint[i] = ifx i < u.count then u[i] else 0; }
        d[0].endpoint_n = u.count;
      }
    } else if key && t[at] == 'h' {
      s: [1] RoomScan; s[0].at = at + 2;
      d[0].players = -1; d[0].tick_us = -1;
      if room_report_scan_num(t, s[..]) == 1 {
        p := room_report_c_int(s[0].v);
        if room_report_scan_num(t, s[..]) == 1 { d[0].players = p; d[0].tick_us = room_report_c_int(s[0].v); }
      }
    } else {
      if key && t[at] == 's' { d[0].shard = room_report_atoi(t, at + 2); }
      if w + (end - at) > kept.count { return -1; }
      for i: at..<end { kept[w] = t[i]; w += 1; }
    }
    at = end;
  }
  return w;
}
// Whether every line that starts with `key` names `shard` (atoi right after the key), and one does.
room_report_names_shard :: (body: string, key: string, shard: int) -> bool #effects(all) {
  t := room_report_c_text(body);
  seen := 0; at := 0;
  while at < t.count {
    if at + key.count <= t.count && t[at..<at + key.count] == key {
      if room_report_atoi(t, at + key.count) != shard { return false; }
      seen += 1;
    }
    nl := room_report_line_end(t, at);
    if nl < 0 { break; }
    at = nl + 1;
  }
  return seen > 0;
}
// A directory post's "s " lines all name this shard, and it has one: a shard's own key reports for
// that shard only (#13260).
room_report_dir_names_shard :: (body: string, shard: int) -> bool #export_c #effects(all) { return room_report_names_shard(body, "s ", shard); }
// The same of a stats post's "shard=" lines (POST /api/playtest/room-stats; its other lines are SQL's).
room_report_stats_names_shard :: (body: string, shard: int) -> bool #export_c #effects(all) { return room_report_names_shard(body, "shard=", shard); }

#test "a vitals post, its receipt and what an older API answered" {
  b: [256] u8;
  n := room_report_vitals_head(b[..], 600000, 1, 777, 1);
  n = room_report_vitals_line(b[..], n, "p-a", 17, 30, 0, 0, 1, 600000, 0, "");
  n = room_report_vitals_line(b[..], n, "p-b", 9, 22, 120, 2, 4, 600500, 3, "wizard");
  #assert cast(string) b[0..<n] == "t 600000\no 1 777 1\np-a 17 30 0 0 1 600000\np-b 9 22 120 2 4 600500 3 c=wizard\n";
  #assert room_report_vitals_line(b[0..<20], 0, "p-a", 17, 30, 0, 0, 1, 600000, 0, "") == -1 && room_report_vitals_line(b[..], -1, "p", 1, 1, 0, 0, 1, 1, 0, "") == -1;
  n = room_report_receipt(b[..], 777, 1, "af");
  body := cast(string) b[0..<n];
  #assert body == "receipt 777 1 af\n";
  r := room_report_receipt_read(body);
  #assert r.kind == ROOM_RECEIPT && r.gen == 777 && r.batch == 1 && body[r.codes_at..<r.codes_at + r.codes_n] == "af";
  r = room_report_receipt_read("receipt 777 2 ");
  #assert r.kind == ROOM_RECEIPT && r.batch == 2 && r.codes_n == 0;
  r = room_report_receipt_read("receipt 777 x a");
  #assert r.kind == ROOM_RECEIPT && r.batch == -1;
  #assert room_report_receipt_read("{\"kept\":1}").kind == ROOM_RECEIPT_KEPT && room_report_receipt_read("{\"error\":\"down\"}").kind == ROOM_RECEIPT_NONE && room_report_receipt_read("receipt 7").kind == ROOM_RECEIPT_NONE && room_report_receipt_read("").kind == ROOM_RECEIPT_NONE;
}
#test "a directory post's lines and a drain's text" {
  b: [256] u8;
  n := room_report_put(b[..], room_report_stamp(b[..], 0, 990000), "\n");
  n = room_report_dir_shard(b[..], n, 3, 4); n = room_report_dir_gen(b[..], n, 777, true); n = room_report_dir_endpoint(b[..], n, "wss://room.openagents.com/api/room/s3/");
  n = room_report_dir_room(b[..], n, "everglade2-1", 2); n = room_report_dir_pid(b[..], n, "p-a"); n = room_report_dir_pid(b[..], n, "p-b"); n = room_report_dir_end(b[..], n);
  n = room_report_dir_health(b[..], n, 2, 1800);
  #assert cast(string) b[0..<n] == "t 990000\ns 3 4\ng 777 d\ne wss://room.openagents.com/api/room/s3/\nr everglade2-1 2 p-a p-b\nh 2 1800\n";
  n = room_report_dir_gen(b[..], 0, 777, false);
  #assert cast(string) b[0..<n] == "g 777\n" && room_report_dir_health(b[..], 0, 0, -1) == 6 && cast(string) b[0..<6] == "h 0 0\n";
  n = room_report_drain(b[..], 3, 990000, 600);
  #assert cast(string) b[0..<n] == "drain 3 990000 600" && room_report_drain(b[0..<10], 3, 990000, 600) == -1;
}
#test "the API reads a room's vitals post: the head, each line, the owner and the class" {
  // a room server's post (proto/verse/room-reports-v1.json, vitals 0)
  post := "t 1794552522401\no 1 1794552384531 7\np-raidcheck-1794552383-0 57 57 0 0 1 1794552478286\np-raidcheck-1794552383-1 57 57 0 0 2 1794552478286\np-raidcheck-1794552383-2 57 57 0 0 3 1794552478286\np-raidcheck-1794552383-3 57 57 0 0 4 1794552478286\n";
  h: [1] RoomVitalsHead; l: [1] RoomVitalsLine;
  room_report_vitals_head_read(post, h[..]);
  #assert h[0].stamped && h[0].at == 1794552522401 && h[0].owned && h[0].shard == 1 && h[0].gen == 1794552384531 && h[0].batch == 7 && h[0].lines == 35;
  from := h[0].lines; n := 0;
  while room_report_vitals_line_read(post, from, true, l[..]) {
    #assert l[0].got == 7 && cast(string) l[0].pid[0..<23] == "p-raidcheck-1794552383-" && l[0].pid[23] == cast(u8) ('0' + n) && l[0].pid[24] == 0;
    #assert l[0].hp == 57 && l[0].max == 57 && l[0].xp == 0 && l[0].wanted == 0 && l[0].rev == n + 1 && l[0].when == 1794552478286 && l[0].owner == -1 && !l[0].has_class;
    from = l[0].next; n += 1;
  }
  #assert n == 4 && from == post.count - 1;
  // what the writer gives, read back: an owner, a class
  b: [256] u8;
  m := room_report_vitals_head(b[..], 600000, 3, 777, 2);
  m = room_report_vitals_line(b[..], m, "p-a", 17, 30, 0, 0, 1, 600000, 0, "");
  m = room_report_vitals_line(b[..], m, "p-b", 9, 22, 120, 2, 4, 600500, 3, "wizard");
  text := cast(string) b[0..<m];
  room_report_vitals_head_read(text, h[..]);
  #assert h[0].stamped && h[0].at == 600000 && h[0].owned && h[0].shard == 3 && h[0].gen == 777 && h[0].batch == 2;
  #assert room_report_vitals_line_read(text, h[0].lines, true, l[..]) && l[0].got == 7 && cast(string) l[0].pid[0..<4] == "p-a\0" && l[0].hp == 17 && l[0].max == 30 && l[0].when == 600000 && !l[0].has_class;
  #assert room_report_vitals_line_read(text, l[0].next, true, l[..]) && l[0].got == 8 && cast(string) l[0].pid[0..<4] == "p-b\0" && l[0].hp == 9 && l[0].max == 22 && l[0].xp == 120 && l[0].wanted == 2 && l[0].rev == 4 && l[0].when == 600500 && l[0].owner == 3;
  #assert l[0].has_class && cast(string) l[0].klass[0..<7] == "wizard\0";
  #assert !room_report_vitals_line_read(text, l[0].next, true, l[..]) && !room_report_vitals_line_read(text, -1, true, l[..]);
  // a post from before operation IDs: "PID HP MAX [XP]"
  old := "t 600000\np-a 17 30 5\np-b 9 22\n\nx\n";
  room_report_vitals_head_read(old, h[..]);
  #assert h[0].stamped && !h[0].owned && h[0].lines == 8;
  #assert room_report_vitals_line_read(old, 8, false, l[..]) && l[0].got == 4 && l[0].hp == 17 && l[0].max == 30 && l[0].xp == 5;
  #assert room_report_vitals_line_read(old, l[0].next, false, l[..]) && l[0].got == 3 && l[0].hp == 9 && l[0].max == 22 && l[0].xp == -1;
  #assert room_report_vitals_line_read(old, l[0].next, false, l[..]) && l[0].got == -1;   // an empty line
  #assert room_report_vitals_line_read(old, l[0].next, false, l[..]) && l[0].got == 1 && !room_report_vitals_line_read(old, l[0].next, false, l[..]);
}
#test "the API's readers take what sscanf and atoi took: white space, signs, long words, numbers too large, a NUL" {
  h: [1] RoomVitalsHead; l: [1] RoomVitalsLine; s: [1] RoomScan;
  // "t %lld": the t, then a number after any white space; nothing else is a time
  room_report_vitals_head_read("t5", h[..]); #assert h[0].stamped && h[0].at == 5 && !h[0].owned && h[0].lines == -1;
  room_report_vitals_head_read("t \n\t+7\no1 2 3", h[..]); #assert h[0].stamped && h[0].at == 7 && !h[0].owned && h[0].lines == 2;
  room_report_vitals_head_read(" t 5", h[..]); #assert !h[0].stamped && h[0].at == 0;
  room_report_vitals_head_read("t -", h[..]); #assert !h[0].stamped;
  room_report_vitals_head_read("t x", h[..]); #assert !h[0].stamped;
  room_report_vitals_head_read("", h[..]); #assert !h[0].stamped && h[0].lines == -1;
  // the o line's numbers may stand on later lines; the player lines then follow the line end after the o
  room_report_vitals_head_read("t 5\no 1\n2\n3\np 1 1", h[..]); #assert h[0].owned && h[0].shard == 1 && h[0].gen == 2 && h[0].batch == 3 && h[0].lines == 7;
  room_report_vitals_head_read("t 5\no 1 2\n", h[..]); #assert !h[0].owned && h[0].lines == 3;
  room_report_vitals_head_read("t 5\n o 1 2 3\n", h[..]); #assert !h[0].owned;
  room_report_vitals_head_read("t 5\no 4294967297 -9223372036854775809 9223372036854775808\n", h[..]);
  #assert h[0].owned && h[0].shard == 1 && h[0].gen == -9223372036854775807 - 1 && h[0].batch == 9223372036854775807;
  // a text ends at its first NUL
  room_report_vitals_head_read("t 5\no 1 2\0 3\n", h[..]); #assert h[0].stamped && !h[0].owned;
  // numbers: %lld clamps, %d keeps the low 32 bits of the clamped long
  s[0].at = 0; #assert room_report_scan_num("  -0012x", s[..]) == 1 && s[0].v == -12 && s[0].at == 7;
  s[0].at = 0; #assert room_report_scan_num("9223372036854775807", s[..]) == 1 && s[0].v == 9223372036854775807;
  s[0].at = 0; #assert room_report_scan_num("9223372036854775808", s[..]) == 1 && s[0].v == 9223372036854775807;
  s[0].at = 0; #assert room_report_scan_num("-9223372036854775808", s[..]) == 1 && s[0].v == -9223372036854775807 - 1;
  s[0].at = 0; #assert room_report_scan_num("000000000000000000000000000012", s[..]) == 1 && s[0].v == 12;
  s[0].at = 0; #assert room_report_scan_num("99999999999999999999999", s[..]) == 1 && s[0].v == 9223372036854775807;
  s[0].at = 0; #assert room_report_scan_num("+", s[..]) == 0 && room_report_scan_num("-x", s[..]) == 0 && room_report_scan_num("x", s[..]) == 0 && room_report_scan_num(" \n", s[..]) == -1 && room_report_scan_num("", s[..]) == -1;
  #assert room_report_c_int(2147483647) == 2147483647 && room_report_c_int(2147483648) == -2147483648 && room_report_c_int(4294967297) == 1 && room_report_c_int(-1) == -1 && room_report_c_int(-2147483649) == 2147483647;
  #assert room_report_c_int(9223372036854775807) == -1 && room_report_c_int(-9223372036854775807 - 1) == 0;
  #assert room_report_atoi("s \n 42 7", 1) == 42 && room_report_atoi("s x", 1) == 0 && room_report_atoi("s -3", 1) == -3 && room_report_atoi("s 99999999999999999999", 1) == -1 && room_report_atoi("s", 1) == 0;
  // a word is 47 bytes at most: the rest of a longer one is read as HP (and here is no number)
  long := "t 5\no 1 2 3\n0123456789012345678901234567890123456789012345678 5 6\n";
  #assert room_report_vitals_line_read(long, 11, true, l[..]) && l[0].got == 4 && l[0].pid[46] == '6' && l[0].pid[47] == 0 && l[0].hp == 78 && l[0].max == 5 && l[0].xp == 6;
  long = "t 5\no 1 2 3\n01234567890123456789012345678901234567890123456x 5 6\n";
  #assert room_report_vitals_line_read(long, 11, true, l[..]) && l[0].got == 1 && l[0].hp == 0;
  // fields after tabs, with signs; a number too large for an int
  odd := "t 5\no 1 2 3\n \tp-a\t+17 -30 4294967296 0 1 600000 0 c=a c=b\n";
  #assert room_report_vitals_line_read(odd, 11, true, l[..]) && l[0].got == 8 && l[0].hp == 17 && l[0].max == -30 && l[0].xp == 0 && l[0].owner == 0 && l[0].has_class && cast(string) l[0].klass[0..<6] == "a c=b\0";
  // only a line's first 159 bytes are read (127 without operation IDs): a class past them is not seen, one across them is cut
  b: [400] u8; n := room_report_put(b[..], 0, "t 5\no 1 2 3\np 1 2 3 4 5 6 7");
  while n < 12 + 156 { b[n] = ' '; n += 1; }
  n = room_report_put(b[..], n, " c=wizard\nq 1\n");
  #assert room_report_vitals_line_read(cast(string) b[0..<n], 11, true, l[..]) && l[0].got == 8 && l[0].owner == 7 && l[0].has_class && l[0].klass[0] == 0 && l[0].next == 12 + 165;
  n = room_report_put(b[..], 12 + 157, " c=wizard\n");
  #assert room_report_vitals_line_read(cast(string) b[0..<n], 11, true, l[..]) && !l[0].has_class;
  lb: [200] u8; k := room_report_put(lb[..], 0, "t 5\np 1 2");
  while k < 4 + 126 { lb[k] = ' '; k += 1; }
  k = room_report_put(lb[..], k, "34\n");
  #assert room_report_vitals_line_read(cast(string) lb[0..<k], 3, false, l[..]) && l[0].got == 4 && l[0].xp == 3 && l[0].next == 4 + 128;
}
#test "the API reads a room's directory post: the shard, the endpoint, the health, and the post without them" {
  // a room's post (proto/verse/room-reports-v1.json, directory 0 and 6)
  post := "t 1000000\ns 2 4\ng 777\ne wss://room.openagents.com/api/room/s2/\nh 0 640\n";
  kept: [256] u8; d: [1] RoomDirPost;
  n := room_report_dir_read(post, kept[..], d[..]);
  #assert cast(string) kept[0..<n] == "t 1000000\ns 2 4\ng 777\n" && d[0].shard == 2 && d[0].players == 0 && d[0].tick_us == 640;
  #assert cast(string) d[0].endpoint[0..<d[0].endpoint_n] == "wss://room.openagents.com/api/room/s2/" && d[0].endpoint[d[0].endpoint_n] == 0;
  #assert room_report_dir_names_shard(post, 2) && !room_report_dir_names_shard(post, 3) && room_report_dir_read(post, kept[0..<10], d[..]) == -1;
  post = "t 990500\ns 3 3\nr everglade2-2 2 p-00000000000000a1 p-00000000000000a2\n";
  n = room_report_dir_read(post, kept[..], d[..]);
  #assert cast(string) kept[0..<n] == post && d[0].shard == 3 && d[0].players == -1 && d[0].tick_us == -1 && d[0].endpoint_n == 0 && d[0].endpoint[0] == 0;
  // endpoints the API does not take (the line is taken out all the same)
  bad := [9] string.["e ws://room.openagents.com/api/room/s2/", "e wss://room.openagents.org/api/room/s2/", "e wss://.openagents.com/api/room/s2/", "e wss://room.openagents.com/api/room/s2", "e wss://room.openagents.com/api/rooms/2/",
    "e wss://room.openagents.com/api/room/s2/\"/", "e wss://room.openagents.com/x/api/room/s2/", "e wss://room.openagents.com", "e "];
  for i: 0..<bad.count { n = room_report_dir_read(bad[i], kept[..], d[..]); #assert n == 0 && d[0].endpoint_n == 0; }
  n = room_report_dir_read("e wss://room.openagents.com:8443/api/room/s12/\ne wss://x/\n", kept[..], d[..]);
  #assert n == 0 && cast(string) d[0].endpoint[0..<d[0].endpoint_n] == "wss://room.openagents.com:8443/api/room/s12/";   // a later one that is refused leaves the earlier
  // the health line: two numbers or none; the last line counts; a number may come from the next line
  n = room_report_dir_read("h 2 1800\nh 3\n", kept[..], d[..]); #assert n == 0 && d[0].players == -1 && d[0].tick_us == -1;
  n = room_report_dir_read("h 2 1800\nh x\n", kept[..], d[..]); #assert d[0].players == -1 && d[0].tick_us == -1;
  n = room_report_dir_read("h 2\n7\n", kept[..], d[..]); #assert d[0].players == 2 && d[0].tick_us == 7 && cast(string) kept[0..<n] == "7\n";
  // the s line: atoi, the last line counts, a line that only looks like one does not
  n = room_report_dir_read("s 2 4\ns 7x\ns\n ss 9\n", kept[..], d[..]); #assert d[0].shard == 7 && n == 19;
  n = room_report_dir_read("s x\0s 5\n", kept[..], d[..]); #assert d[0].shard == 0 && n == 3;
  #assert room_report_dir_names_shard("s 2 4\nr a 1\ns 2\n", 2) && !room_report_dir_names_shard("s 2 4\ns 3\n", 2) && !room_report_dir_names_shard("t 5\n", 0) && room_report_dir_names_shard("s x", 0) && !room_report_dir_names_shard("", 0);
  #assert room_report_stats_names_shard("shard=2 at=5\nx=1\nshard=2\n", 2) && !room_report_stats_names_shard("shard=2\nshard=1\n", 2) && !room_report_stats_names_shard("s 2\n", 2) && !room_report_stats_names_shard(" shard=2\n", 2);
}
#test "the control answer's lines, written and read" {
  b: [256] u8;
  n := room_report_control_pvp(b[..], 0, true); n = room_report_control_edit(b[..], n, 1762190001000); n = room_report_control_kick(b[..], n, "p-a");
  n = room_report_control_flag(b[..], n, "closed-s2", 1); n = room_report_control_hold(b[..], n, "pair-1", 0, 7); n = room_report_control_place(b[..], n, "pair-1", 1, 2, 9);
  n = room_report_control_dice(b[..], n, true);
  #assert cast(string) b[0..<n] == "pvp 1\nedit 1762190001000\nkick p-a\nflag closed-s2 1\nhold pair-1 0 7\nplace pair-1 1 2 9\ndice fixed\n";
  r := room_report_control_read("pvp 1"); #assert r.kind == ROOM_CONTROL_PVP && r.a == 1 && room_report_control_read("pvp 0").a == 0 && room_report_control_read("pvp yes").a == 0 && room_report_control_read("pvp ").kind == ROOM_CONTROL_OTHER;
  r = room_report_control_read("edit 1762190001000"); #assert r.kind == ROOM_CONTROL_EDIT && r.a == 1762190001000 && room_report_control_read("edit x").a == -1 && room_report_control_read("edit 1234567890123456").a == -1;
  line := "kick p-a"; r = room_report_control_read(line); #assert r.kind == ROOM_CONTROL_KICK && line[r.word_at..<r.word_at + r.word_n] == "p-a";
  line = "flag closed-s2 1"; r = room_report_control_read(line); #assert r.kind == ROOM_CONTROL_FLAG && line[r.word_at..<r.word_at + r.word_n] == "closed-s2" && r.a == 1;
  r = room_report_control_read("flag closed"); #assert r.kind == ROOM_CONTROL_FLAG && r.a == -1 && room_report_control_read("flag closed x").a == -1;
  line = "hold pair-1 0 7"; r = room_report_control_read(line); #assert r.kind == ROOM_CONTROL_HOLD && line[r.word_at..<r.word_at + r.word_n] == "pair-1" && r.a == 0 && r.b == 7;
  #assert room_report_control_read("hold pair-1 0").kind == ROOM_CONTROL_OTHER && room_report_control_read("hold pair-1").kind == ROOM_CONTROL_OTHER;
  line = "place pair-1 1 2 9"; r = room_report_control_read(line); #assert r.kind == ROOM_CONTROL_PLACE && line[r.word_at..<r.word_at + r.word_n] == "pair-1" && r.a == 1 && r.b == 2 && r.c == 9;
  #assert room_report_control_read("place pair-1 1 2").kind == ROOM_CONTROL_OTHER;
  #assert room_report_control_read("dice fixed").a == 1 && room_report_control_read("dice random").a == 0 && room_report_control_read("dice").kind == ROOM_CONTROL_OTHER;
  #assert room_report_control_read("event 1 2 3").kind == ROOM_CONTROL_OTHER && room_report_control_read("").kind == ROOM_CONTROL_OTHER;
}
#test "a checkpoint's receipt reads back to the same bytes" {
  b: [256] u8; back: [256] u8; r: [1] RoomCheckpointReceipt;
  n := room_report_checkpoint_receipt(b[..], 2, "applied", 3, 1762190000000, 5, 1762190001000);
  body := cast(string) b[0..<n];
  #assert body == "{\"v\":2,\"status\":\"applied\",\"owner\":3,\"process\":1762190000000,\"rev\":5,\"accepted_at\":1762190001000}";
  #assert room_report_checkpoint_receipt_read(body, r[..]) && r[0].v == 2 && room_report_checkpoint_status(r[..]) == "applied" && r[0].owner == 3 && r[0].process == 1762190000000 && r[0].rev == 5 && r[0].accepted_at == 1762190001000;
  m := room_report_checkpoint_receipt(back[..], r[0].v, room_report_checkpoint_status(r[..]), r[0].owner, r[0].process, r[0].rev, r[0].accepted_at);
  #assert cast(string) back[0..<m] == body && room_report_checkpoint_receipt(back[0..<20], 2, "applied", 3, 4, 5, 6) == -1;
  #assert room_report_checkpoint_receipt_read("{\"kept\":1}", r[..]) && r[0].v == 0 && room_report_checkpoint_status(r[..]) == "";
  #assert !room_report_checkpoint_receipt_read("receipt 1 2 a", r[..]) && !r[0].ok;
}
