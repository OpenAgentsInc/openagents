// Authored dialogue as a tree (engine): numbered lines a character says, and the choices a player
// answers with, each leading to another line or ending the talk. The game writes the tree; this only
// walks it and says whether it is whole. Text is display data, never a simulation command.
//   coax/bin/coax test --library metaverse-engine/talk/tree.coax
#module "metaverse.engine.talk.tree";

TALK_TREE_END :: -1;       // a choice that ends the talk
TALK_TREE_CHOICES :: 6;    // choices offered at one line at most
TALK_TREE_LINES :: 32;     // lines in a tree at most
TalkTreeChoice :: struct { from: int; text: string; to: int; }

// The choices offered at line `at`, in the order written: their indices into choices go in out;
// returns how many.
talk_tree_offered :: (choices: [] TalkTreeChoice, at: int, out: [] int) -> int {
  n := 0;
  for i: 0..<choices.count { if choices[i].from == at && n < out.count { out[n] = i; n += 1; } }
  return n;
}
// Where the k-th choice offered at line `at` leads: a line, or TALK_TREE_END; `at` itself when there
// is no such choice.
talk_tree_pick :: (choices: [] TalkTreeChoice, at: int, k: int) -> int {
  o: [TALK_TREE_CHOICES] int; n := talk_tree_offered(choices, at, o[..]);
  if k < 0 || k >= n { return at; }
  return choices[o[k]].to;
}
// Whole: between 1 and TALK_TREE_LINES lines; every line offers 1 to TALK_TREE_CHOICES choices; every
// choice leads to a line or ends; every line is reached from line 0; and some choice ends the talk.
talk_tree_whole :: (lines: int, choices: [] TalkTreeChoice) -> bool {
  if lines < 1 || lines > TALK_TREE_LINES { return false; }
  ends := false;
  for c: choices {
    if c.from < 0 || c.from >= lines || c.text.count == 0 { return false; }
    if c.to == TALK_TREE_END { ends = true; } else if c.to < 0 || c.to >= lines { return false; }
  }
  if !ends { return false; }
  for at: 0..<lines {
    o: [TALK_TREE_CHOICES + 1] int; n := talk_tree_offered(choices, at, o[..]);
    if n < 1 || n > TALK_TREE_CHOICES { return false; }
  }
  seen: [TALK_TREE_LINES] bool; todo: [TALK_TREE_LINES] int; tn := 1; seen[0] = true; todo[0] = 0;
  while tn > 0 {
    tn -= 1; at := todo[tn];
    for c: choices { if c.from == at && c.to >= 0 && !seen[c.to] { seen[c.to] = true; todo[tn] = c.to; tn += 1; } }
  }
  for at: 0..<lines { if !seen[at] { return false; } }
  return true;
}

#test "a tree offers each line's choices in order, and a pick leads where its choice says" {
  t := [4] TalkTreeChoice.[
    TalkTreeChoice.{from = 0, text = "Ask", to = 1}, TalkTreeChoice.{from = 0, text = "Bye", to = TALK_TREE_END},
    TalkTreeChoice.{from = 1, text = "Back", to = 0}, TalkTreeChoice.{from = 1, text = "Bye", to = TALK_TREE_END}];
  o: [TALK_TREE_CHOICES] int;
  #assert talk_tree_offered(t[..], 0, o[..]) == 2 && o[0] == 0 && o[1] == 1;
  #assert talk_tree_offered(t[..], 1, o[..]) == 2 && o[0] == 2 && o[1] == 3;
  #assert talk_tree_pick(t[..], 0, 0) == 1 && talk_tree_pick(t[..], 0, 1) == TALK_TREE_END && talk_tree_pick(t[..], 1, 0) == 0;
  #assert talk_tree_pick(t[..], 0, 2) == 0 && talk_tree_pick(t[..], 1, -1) == 1;   // no such choice: stay
  #assert talk_tree_whole(2, t[..]);
}
#test "a tree is not whole with a line no one reaches, a line with no choice, a choice to nowhere, or no way out" {
  a := [2] TalkTreeChoice.[TalkTreeChoice.{from = 0, text = "Bye", to = TALK_TREE_END}, TalkTreeChoice.{from = 1, text = "Bye", to = TALK_TREE_END}];
  #assert !talk_tree_whole(2, a[..]) && talk_tree_whole(1, a[0..<1]);   // line 1 unreached
  b := [1] TalkTreeChoice.[TalkTreeChoice.{from = 0, text = "On", to = 1}];
  #assert !talk_tree_whole(2, b[..]);                                     // line 1 offers nothing, nothing ends
  c := [2] TalkTreeChoice.[TalkTreeChoice.{from = 0, text = "On", to = 5}, TalkTreeChoice.{from = 0, text = "Bye", to = TALK_TREE_END}];
  #assert !talk_tree_whole(1, c[..]);                                     // to a line that isn't there
  d := [1] TalkTreeChoice.[TalkTreeChoice.{from = 0, text = "Again", to = 0}];
  #assert !talk_tree_whole(1, d[..]);                                     // no way out
  e := [1] TalkTreeChoice.[TalkTreeChoice.{from = 0, text = "", to = TALK_TREE_END}];
  #assert !talk_tree_whole(1, e[..]) && !talk_tree_whole(0, a[0..<0]);
  f: [TALK_TREE_CHOICES + 1] TalkTreeChoice; for i: 0..<f.count { f[i] = TalkTreeChoice.{from = 0, text = "Bye", to = TALK_TREE_END}; }
  #assert !talk_tree_whole(1, f[..]) && talk_tree_whole(1, f[0..<TALK_TREE_CHOICES]);   // too many at one line
}
