// The checks' side of metaverse-engine/world/cells.coax: a grid world, and a loader outside the step that
// answers late, out of order, wrongly and not at all, through the replay gate. Only the checks call it.

// A manifest of cells x0..x1 by z0..z1 (inclusive), each digest from its key.
cw_grid :: (w: [] CellWorld, x0: int, x1: int, z0: int, z1: int) {
  w[0] = CellWorld.{};
  for cz: z0..<z1 + 1 { for cx: x0..<x1 + 1 {
    w[0].manifest[w[0].n] = CellEntry.{cx = cx, cz = cz, digest = cw_content(cx, cz)}; w[0].n += 1;
  } }
}
cw_content :: (cx: int, cz: int) -> int { return 1000 + (cx + 50) * 100 + (cz + 50); }

// Every level change one step makes.
cw_changes :: (before: [] int, w: [] CellWorld) -> int {
  n := 0;
  for i: 0..<w[0].n { if before[i] != w[0].cells[i].level { n += 1; } before[i] = w[0].cells[i].level; }
  return n;
}
// Answers every load asked this step at once.
cw_load_all :: (w: [] CellWorld, st: CellStep) {
  for k: 0..<st.asked_n { i := st.asked[k]; v := cell_complete(w, cell_answer(w[0].cells[i].request, 1, i, w[0].manifest[i].digest, false)); }
}

// Answers every load in flight.
cw_answer_loading :: (w: [] CellWorld) {
  for i: 0..<w[0].n { if w[0].cells[i].level == CELL_LOADING { v := cell_complete(w, cell_answer(w[0].cells[i].request, 1, i, w[0].manifest[i].digest, false)); } }
}
// Answers only the loads of cells with an even key: the odd ones are late.
cw_late :: (w: [] CellWorld, st: CellStep) {
  for k: 0..<st.asked_n {
    i := st.asked[k];
    if w[0].manifest[i].cx % 2 == 0 { v := cell_complete(w, cell_answer(w[0].cells[i].request, 1, i, w[0].manifest[i].digest, false)); }
  }
}

// The loader: each asked load answers `delay` steps later (2 to 9 by request), every seventh fails,
// every eleventh loads the wrong content.
CwLoad :: struct { event: ReplayEvent; due: int; }
CwRun :: struct {
  b: [1] ReplayBacking;
  w: [1] CellWorld;
  q: [128] CwLoad; q_n: int; sender: int;
  ok: int; refused: int; most_resident: int; most_loading: int; woke: int;
}
cw_step :: (r: [] CwRun, s: ReplaySession) {
  t := replay_tick(s);
  if !replay_playing(s) {
    // the loader hands in what is due, latest requests first: out of the order asked
    for k: 0..<r[0].q_n {
      j := r[0].q_n - 1 - k;
      if r[0].q[j].due != t { continue; }
      r[0].sender += 1; e := r[0].q[j].event; e.request = r[0].sender;
      v := replay_offer(s, e);
    }
  }
  while true {
    take := replay_take(s);
    if !take.ok { break; }
    if cell_complete(r[0].w[..], take.event) == CELL_OK { r[0].ok += 1; }
  }
  x := 32.0 + f64(t) * 2; z := 32.0;
  st := cell_step(r[0].w[..], x, z);
  r[0].woke += st.woke;
  if !replay_playing(s) {
    for k: 0..<st.asked_n {
      i := st.asked[k]; req := r[0].w[0].cells[i].request;
      if r[0].q_n < r[0].q.count {
        dg := ifx req % 11 == 0 then 1 else r[0].w[0].manifest[i].digest;
        r[0].q[r[0].q_n] = CwLoad.{event = cell_answer(req, 0, i, dg, req % 7 == 0), due = t + 2 + req % 8};
        r[0].q_n += 1;
      }
    }
  }
  if cell_resident_count(r[0].w[..]) > r[0].most_resident { r[0].most_resident = cell_resident_count(r[0].w[..]); }
  if cell_loading_count(r[0].w[..]) > r[0].most_loading { r[0].most_loading = cell_loading_count(r[0].w[..]); }
  replay_stepped(s, cell_digest(r[0].w[..]));
}
