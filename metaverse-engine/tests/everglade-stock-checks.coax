#test "stock golden observation keeps a real comparison refusal distinct from incomplete execution" {
  #assert eg_stock_complete(0,0,false,false,true,true,true,true);
  #assert eg_stock_complete(0,1,false,false,true,true,true,true);
  #assert !eg_stock_complete(-1,0,false,false,true,true,true,true);
  #assert !eg_stock_complete(1,0,false,false,true,true,true,true);
  #assert !eg_stock_complete(0,-1,false,false,true,true,true,true);
  #assert !eg_stock_complete(0,2,false,false,true,true,true,true);
  #assert !eg_stock_complete(0,0,true,false,true,true,true,true);
  #assert !eg_stock_complete(0,0,false,true,true,true,true,true);
  #assert !eg_stock_complete(0,0,false,false,false,true,true,true);
  #assert !eg_stock_complete(0,0,false,false,true,false,true,true);
  #assert !eg_stock_complete(0,0,false,false,true,true,false,true);
  #assert !eg_stock_complete(0,0,false,false,true,true,true,false);
}
#test "stock golden retains only the single complete actual failed-shot report field" {
  #assert eg_stock_shot("ok")=="";
  #assert eg_stock_shot("6 allowed; this shot: /tmp/coax-golden-actual/everglade.png)")=="/tmp/coax-golden-actual/everglade.png";
  #assert eg_stock_shot("; this shot: /tmp/a)")=="/tmp/a";
  #assert eg_stock_shot("; this shot: )")=="";
  #assert eg_stock_shot("; this shot: /tmp/a")=="";
  #assert eg_stock_shot("; this shot: a); this shot: b)")=="";
  #assert eg_stock_shot("; this shot: /tmp/a\n)")=="";
  #assert eg_stock_shot("; this shot: /tmp/a\r)")=="";
  #assert eg_stock_shot("; this shot: /tmp/a\0)")=="";
}
