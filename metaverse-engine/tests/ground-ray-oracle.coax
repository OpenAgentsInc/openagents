// Independent brute-force triangle intersections. No traversal, height sampling or DDA.
GroundOracleRay :: struct { hit: bool; t: f64; }
GroundRayOraclePoint :: struct { x: f64; y: f64; z: f64; }

ground_ray_oracle_triangle :: (a: GroundRayOraclePoint, b: GroundRayOraclePoint, c: GroundRayOraclePoint,
    o: WorldPoint, d: WorldPoint, far: f64) -> GroundOracleRay {
  // Moller-Trumbore's determinant solve for the complete triangle, unlike the production
  // path's height intervals and vertical gaps. Vertices are the actual rendered f32 words.
  ax := b.x - a.x; ay := b.y - a.y; az := b.z - a.z;
  bx := c.x - a.x; by := c.y - a.y; bz := c.z - a.z;
  px := f64(d.y) * bz - f64(d.z) * by;
  py := f64(d.z) * bx - f64(d.x) * bz;
  pz := f64(d.x) * by - f64(d.y) * bx;
  determinant := ax * px + ay * py + az * pz;
  if determinant == 0 { return GroundOracleRay.{}; }
  tx := f64(o.x) - a.x; ty := f64(o.y) - a.y; tz := f64(o.z) - a.z;
  u := (tx * px + ty * py + tz * pz) / determinant;
  qx := ty * az - tz * ay; qy := tz * ax - tx * az; qz := tx * ay - ty * ax;
  v := (f64(d.x) * qx + f64(d.y) * qy + f64(d.z) * qz) / determinant;
  t := (bx * qx + by * qy + bz * qz) / determinant;
  if u < 0 || v < 0 || u + v > 1 || t < 0 || t > far { return GroundOracleRay.{}; }
  return GroundOracleRay.{hit = true, t = t};
}

ground_ray_oracle_case :: (seed: int) {
  g := Ground.{n = 2, rows = 3, cell = 0.1, west = 100.1, south = -12.3};
  h: [12] f32;
  for k: 0..<12 { h[k] = f32((k * 13 + seed * 7) % 19 - 9) * 0.25; }
  east := g.west + f32(g.n) * g.cell; north := g.south + f32(g.rows) * g.cell;
  ox := g.west + (east - g.west) * f32((seed * 11) % 31 + 1) / 33;
  oz := g.south + (north - g.south) * f32((seed * 17) % 31 + 1) / 33;
  end_x := g.west + (east - g.west) * f32((seed * 23) % 31 + 1) / 33;
  end_z := g.south + (north - g.south) * f32((seed * 29) % 31 + 1) / 33;
  o := world_point(ox, 10, oz); d := world_point(end_x - ox, -20, end_z - oz);
  far := ifx seed % 3 == 0 then 0.3 else 0.8;
  expected: GroundOracleRay;
  for j: 0..<3 { for i: 0..<2 {
    x0 := f64(g.west + f32(i) * g.cell); x1 := f64(g.west + f32(i + 1) * g.cell);
    z0 := f64(g.south + f32(j) * g.cell); z1 := f64(g.south + f32(j + 1) * g.cell);
    a := GroundRayOraclePoint.{x = x0, y = f64(h[j * 3 + i]), z = z0};
    c := GroundRayOraclePoint.{x = x1, y = f64(h[(j + 1) * 3 + i + 1]), z = z1};
    for triangle: 0..<2 {
      b := GroundRayOraclePoint.{x = x1, y = f64(h[j * 3 + i + 1]), z = z0};
      if triangle == 1 { b = GroundRayOraclePoint.{x = x0, y = f64(h[(j + 1) * 3 + i]), z = z1}; }
      candidate := ground_ray_oracle_triangle(a, b, c, o, d, far);
      if candidate.hit && (!expected.hit || candidate.t < expected.t) { expected = candidate; }
    }
  } }
  actual := ground_ray(g, h[..], o, d, far, 32);
  #assert actual.status == GroundRayStatus.ok && actual.hit == expected.hit;
  if actual.hit {
    #assert abs(actual.t - expected.t) < 0.0000000001;
    n := actual.normal;
    #assert abs(n.x * n.x + n.y * n.y + n.z * n.z - 1) < 0.000001;
    #assert n.x * d.x + n.y * d.y + n.z * d.z <= 0.000001;
  }
}
