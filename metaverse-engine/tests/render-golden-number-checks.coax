#test "golden frame Number controls preserve whole decimal exponent and radix spellings" {for text,i:[12]string.["1","600","+2","2.0","2e0","0.2e1","0x10","0X258","0b101","0o10"," 2 ","00000000000000000000000000000000002"] {#assert gg_integer(text,600)==[12]int.[1,600,2,2,2,2,16,600,5,8,2,2][i];}}
#test "golden Number integer admission preserves exact IEEE rounding intervals" {#assert gg_integer("1.0000000000000001",600)==1;#assert gg_integer("0.99999999999999999",600)==1;#assert gg_integer("600.00000000000005",600)==600;#assert gg_integer("599.99999999999995",600)==600;#assert gg_integer("1.0000000000000002",600)== -1;#assert gg_integer("600.0000000000001",600)== -1;#assert gg_integer("599.9999999999999",600)== -1;#assert gg_integer("0.5",600)== -1;}
#test "golden Number refuses noninteger nonfinite sign and malformed spellings" {for text:[20]string.["","0","601","-1","-0","1.5","Infinity","NaN","1e999999","1e-999999","+0x2","0x","0b2","0o8","1x",".","1e","1e+","--1","1.2.3"] {#assert gg_integer(text,600)== -1;}#assert gg_integer("8192",8192)==8192 && gg_integer("8193",8192)== -1;}

#test "golden Number trims ECMAScript Unicode whitespace and guards scalar indexes" {#assert gg_integer("﻿ 2 　",600)==2;#assert gg_space_len("x",-1)==0 && gg_space_len("x",1)==0;#assert gg_integer("1",0)== -1 && gg_integer("1",8193)== -1;}

#test "golden bounded Number includes signed exponent lowercase and uppercase radix endpoints" {for text,i:[15]string.["2E0","2e+0","20e-1","200e-2","0.000002e6","0x1","0xAf","0XAF","0B10","0O10","0x258","0x259","0xg","1e:","1e-"] {#assert gg_integer(text,600)==[15]int.[2,2,2,2,2,1,175,175,2,8,600,-1,-1,-1,-1][i];}}
#forall "golden ASCII whitespace classes are exactly ECMAScript's six bytes" byte:0..<128 {raw:=[1]u8.[cast(u8)byte];expected:=byte==9 || byte==10 || byte==11 || byte==12 || byte==13 || byte==32;#assert (gg_space_len(cast(string)raw[..],0)==1)==expected;}
#test "golden decimal helpers refuse malformed and overflowing scratch views" {out:[80]u8;#assert !gg_decimal("1",out[0..<0]).valid;#assert !gg_decimal("1:",out[..]).valid;#assert !gg_decimal("1e/",out[..]).valid;#assert !gg_decimal("1e10000000",out[..]).valid;#assert gg_integer(" \t\n\r ",600)== -1;#assert gg_integer(".",600)== -1;}
#test "golden IEEE midpoint 1 lower" {out:[80]u8;value:=gg_bound(1,false,out[..]);#assert value.valid && value.digits=="999999999999999944488848768742172978818416595458984375" && value.shift== -54;small:[1]u8;#assert !gg_bound(1,false,small[..]).valid;#assert gg_bound(1,false,out[0..<54]).valid;}
#test "golden IEEE midpoint 1 lower is an inclusive integer tie" {#assert gg_integer("0.999999999999999944488848768742172978818416595458984375",600)==1;}
#test "golden IEEE midpoint 1 upper" {out:[80]u8;value:=gg_bound(1,true,out[..]);#assert value.valid && value.digits=="100000000000000011102230246251565404236316680908203125" && value.shift== -53;small:[1]u8;#assert !gg_bound(1,true,small[..]).valid;#assert gg_bound(1,true,out[0..<54]).valid;}
#test "golden IEEE midpoint 1 upper is an inclusive integer tie" {#assert gg_integer("1.00000000000000011102230246251565404236316680908203125",600)==1;}
#test "golden IEEE midpoint 512 lower" {out:[80]u8;value:=gg_bound(512,false,out[..]);#assert value.valid && value.digits=="511999999999999971578290569595992565155029296875" && value.shift== -45;small:[1]u8;#assert !gg_bound(512,false,small[..]).valid;#assert gg_bound(512,false,out[0..<48]).valid;}
#test "golden IEEE midpoint 512 lower is an inclusive integer tie" {#assert gg_integer("511.999999999999971578290569595992565155029296875",600)==512;}
#test "golden IEEE midpoint 512 upper" {out:[80]u8;value:=gg_bound(512,true,out[..]);#assert value.valid && value.digits=="51200000000000005684341886080801486968994140625" && value.shift== -44;small:[1]u8;#assert !gg_bound(512,true,small[..]).valid;#assert gg_bound(512,true,out[0..<47]).valid;}
#test "golden IEEE midpoint 512 upper is an inclusive integer tie" {#assert gg_integer("512.00000000000005684341886080801486968994140625",600)==512;}
#test "golden IEEE midpoint 600 lower" {out:[80]u8;value:=gg_bound(600,false,out[..]);#assert value.valid && value.digits=="59999999999999994315658113919198513031005859375" && value.shift== -44;small:[1]u8;#assert !gg_bound(600,false,small[..]).valid;#assert gg_bound(600,false,out[0..<47]).valid;}
#test "golden IEEE midpoint 600 lower is an inclusive integer tie" {#assert gg_integer("599.99999999999994315658113919198513031005859375",600)==600;}
#test "golden IEEE midpoint 600 upper" {out:[80]u8;value:=gg_bound(600,true,out[..]);#assert value.valid && value.digits=="60000000000000005684341886080801486968994140625" && value.shift== -44;small:[1]u8;#assert !gg_bound(600,true,small[..]).valid;#assert gg_bound(600,true,out[0..<47]).valid;}
#test "golden IEEE midpoint 600 upper is an inclusive integer tie" {#assert gg_integer("600.00000000000005684341886080801486968994140625",600)==600;}
#test "golden exact decimal ordering handles equal padded prefixes and both orders" {ab:[80]u8;bb:[80]u8;a:=gg_decimal("1.23",ab[..]);b:=gg_decimal("1.2300",bb[..]);#assert gg_decimal_compare(a,b)==0;b=gg_decimal("1.2301",bb[..]);#assert gg_decimal_compare(a,b)== -1 && gg_decimal_compare(b,a)==1;b=gg_decimal("1.229",bb[..]);#assert gg_decimal_compare(a,b)==1 && gg_decimal_compare(b,a)== -1;b=gg_decimal("0.123",bb[..]);#assert gg_decimal_compare(a,b)==1 && gg_decimal_compare(b,a)== -1;}

#test "golden positive count minimum exact decimals and exponent capacity" {#assert gg_integer("1",1)==1 && gg_integer("2",2)==2;#assert gg_integer("+",600)== -1 && gg_integer("0.01",600)== -1;#assert gg_integer("600.99999999999999",600)== -1;#assert gg_integer("0.0000000001e10",600)==1;out:[80]u8;#assert !gg_decimal("1e:",out[..]).valid;v:=gg_decimal("1e999999",out[..]);#assert v.valid && v.shift==999999;#assert !gg_decimal("1e1000000",out[..]).valid;#assert !gg_bound(0,true,out[..]).valid && !gg_bound(8193,false,out[..]).valid;#assert gg_integer("1.99999999999999999",600)==2;}

#test "golden exponent leading zeros never consume its significant exponent budget" {#assert gg_integer("2e0000000000000000000000000000000",600)==2;}

#test "golden integer controls preserve leading zero aliases across the full argument store" {text:[100001]u8;for i:0..<100000 {text[i]='0';}text[100000]='2';#assert gg_integer(cast(string)text[..],600)==2;}

#test "golden whitespace refuses nonspace Unicode and incomplete UTF8 boundaries" {#assert gg_space_len("é",0)==0;raw:=[2]u8.[50,194];#assert gg_integer(cast(string)raw[..],600)== -1;}
#test "golden Number parser enforces every small base limit before another digit" {#assert gg_integer("0x5",4)== -1 && gg_integer("0o5",4)== -1 && gg_integer("0b101",4)== -1;#assert gg_integer("0x4",4)==4 && gg_integer("0o4",4)==4 && gg_integer("0b100",4)==4;#assert gg_integer("0x1",1)==1 && gg_integer("0x2",1)== -1 && gg_integer("0x0f",1)== -1;#assert gg_integer("0x2000",8192)==8192 && gg_integer("0x2001",8192)== -1;}
