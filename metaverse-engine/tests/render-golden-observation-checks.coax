GG_TEST_HOST :: "head\nconst readback = probe && ++frames >= 1 && !gpu.probed ? readBack(encoder, texture) : null;\nmid\nif (readback) report(readback, texture);\nmore\n  const x0 = Math.floor(w * 0.3)tail";
#test "golden observation anchors preserve exact historical instrumentation bytes" {out:[16384]u8;scratch:[16384]u8;n:=gg_instrument(GG_TEST_HOST,out[..],scratch[..]);hash:[64]u8;#assert n>=0 && S_hex(S_hash(cast(string)out[0..<n]),hash[..]) && cast(string)hash[..]=="0b6a6ec6483c467984cf8c28ac41e6a9589b99dcd5124674c01c3684a52a2fb0";#assert gg_instrument("missing",out[..],scratch[..])== -1;small:[1]u8;#assert gg_instrument(GG_TEST_HOST,small[..],scratch[..])== -1;}
#test "golden HTML transformations preserve first-match and global legacy attribute semantics" {out:[4096]u8;scratch:[4096]u8;text:="<canvas data-app=\"fixture\" data-render=\"old.json\" data-render-profile=\"7\"></canvas>";n:=gg_page(text,false,out[..],scratch[..]);#assert n>=0 && cast(string)out[0..<n]=="<canvas data-app=\"fixture\" data-wasm=\"/producer.wasm\" data-render=\"/package/render.json\" data-render-profile=\"7\"></canvas>";n=gg_page(text,true,out[..],scratch[..]);#assert n>=0 && cast(string)out[0..<n]=="<canvas data-app=\"fixture\" data-wasm=\"/producer.wasm\"></canvas>";text="data-wasm=\"old\" data-wasm=\"second\" data-render=\"one\" data-render=\"two\"";n=gg_page(text,false,out[..],scratch[..]);#assert n>=0 && cast(string)out[0..<n]=="data-wasm=\"/producer.wasm\" data-wasm=\"second\" data-render=\"/package/render.json\" data-render=\"two\"";n=gg_page("no attributes",true,out[..],scratch[..]);#assert n>=0 && cast(string)out[0..<n]=="no attributes";}
#test "golden source replacement requires exactly one complete nonoverlapping anchor" {out:[64]u8;#assert gg_replace_once("abc","abc","x",out[..])==1 && out[0]=='x';#assert gg_replace_once("abcabc","abc","x",out[..])== -1;#assert gg_replace_once("abc","","x",out[..])== -1;#assert gg_replace_once("abc","absent","x",out[..])== -1;#assert gg_replace_once("xabcx","abc","",out[..])==2 && cast(string)out[0..<2]=="xx";#assert gg_replace_once("abc","abc","xx",out[0..<1])== -1;}

#test "golden instrumentation refuses either missing later anchor and exact short final output" {out:[16384]u8;scratch:[16384]u8;w:[1]Jo;source:[4096]u8;jo_start(w[..],source[..]);jo_put(w[..],GG_ANCHOR_0);jo_put(w[..],GG_ANCHOR_2);#assert gg_instrument(jo_text(w[..]),out[..],scratch[..])== -1;jo_start(w[..],source[..]);jo_put(w[..],GG_ANCHOR_0);jo_put(w[..],GG_ANCHOR_1);#assert gg_instrument(jo_text(w[..]),out[..],scratch[..])== -1;n:=gg_instrument(GG_TEST_HOST,out[..],scratch[..]);#assert n>0 && gg_instrument(GG_TEST_HOST,out[0..<n-1],scratch[..])== -1;}
#test "golden legacy HTML requires whitespace and observes both scan parities and Unicode" {out:[4096]u8;scratch:[4096]u8;for text,i:[6]string.[" data-render=\"x\"","x data-render=\"x\"","xx data-render=\"x\"","data-render=\"x\""," data-render=\"x\"","data-wasm=\"old\""] {n:=gg_page(text,true,out[..],scratch[..]);expected:=[6]string.["","x","xx","data-render=\"x\"","","data-wasm=\"/producer.wasm\""][i];#assert n==expected.count && cast(string)out[0..<n]==expected;}}
#test "golden incomplete attributes copy unchanged and every helper capacity failure refuses" {out:[256]u8;scratch:[256]u8;#assert !gg_attribute("data-app=\"unterminated","data-app=\"",0).valid;#assert gg_attribute_replace("data-wasm=\"x\"","data-wasm=\"","long",false,out[0..<1])== -1;#assert gg_legacy_attributes("text",out[0..<1])== -1;#assert gg_page("data-app=\"x\"",false,out[0..<0],scratch[..])== -1;#assert gg_page("data-app=\"x\"",false,out[..],scratch[0..<0])== -1;#assert gg_page("data-app=\"x\"",false,out[0..<12],scratch[..])== -1;#assert gg_page("",false,out[..],scratch[..])==0;#assert gg_page("data-wasm=\"unterminated",false,out[..],scratch[..])=="data-wasm=\"unterminated".count;}
