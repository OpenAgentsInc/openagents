#test "golden query matches probe set ordering duplicates spaces and byte escapes" {out:[4096]u8;for text,i:[5]string.["","?a=hello+world&probe=x&a=%26&golden=keep&probe=again","p%72obe=1&x=%FF%C0%AF&empty&%00=~","=&&=&a=%","x=é&golden=1"] {n:=gg_query(text,out[..]);#assert n>=0 && cast(string)out[0..<n]==[5]string.["probe=&golden=&probe-manual=","a=hello+world&probe=&a=%26&golden=&probe-manual=","probe=&x=%EF%BF%BD%EF%BF%BD%EF%BF%BD&empty=&%00=%7E&golden=&probe-manual=","=&=&a=%25&probe=&golden=&probe-manual=","x=%C3%A9&golden=&probe=&probe-manual="][i];}small:[1]u8;#assert gg_query("",small[..])== -1;}
#test "golden percent decoder preserves invalid escapes literal plus and exact capacity" {out:[256]u8;n:=gg_percent("A%00%2f%2F+%zz%",out[..]);#assert n==9 && cast(string)out[0..<n]=="A\0// %zz%";#assert gg_percent("",out[0..<0])==0;#assert gg_percent("x",out[0..<0])== -1;#assert gg_percent("%41",out[0..<1])==1 && out[0]=='A';}
#forall "golden UTF8 decodes every isolated byte with the standard replacement" byte:0..<256 {raw:=[1]u8.[cast(u8)byte];out:[4]u8;n:=gg_utf8(cast(string)raw[..],out[..]);if byte<128 {#assert n==1 && out[0]==cast(u8)byte;}else {#assert n==3 && cast(string)out[0..<n]=="�";}}
#test "golden UTF8 preserves valid boundary scalars and BOM without stripping" {raw:=[8][4]u8.[[4]u8.[194,128,0,0],[4]u8.[223,191,0,0],[4]u8.[224,160,128,0],[4]u8.[237,159,191,0],[4]u8.[239,191,189,0],[4]u8.[240,144,128,128],[4]u8.[244,143,191,191],[4]u8.[239,187,191,0]];lengths:=[8]int.[2,2,3,3,3,4,4,3];out:[32]u8;for i:0..<8 {n:=gg_utf8(cast(string)raw[i][0..<lengths[i]],out[..]);#assert n==lengths[i] && cast(string)out[0..<n]==cast(string)raw[i][0..<lengths[i]];}#assert gg_utf8("x",out[0..<0])== -1 && gg_utf8("",out[0..<0])==0;}
#test "golden UTF8 replacement reconsumes bad continuations and incomplete prefixes" {raw:=[8][4]u8.[[4]u8.[224,128,128,0],[4]u8.[225,128,0,0],[4]u8.[240,144,128,0],[4]u8.[237,160,128,0],[4]u8.[244,144,128,128],[4]u8.[192,175,0,0],[4]u8.[128,0,0,0],[4]u8.[225,128,65,0]];lengths:=[8]int.[3,2,3,3,4,2,1,3];expected:=[8]string.["���","�","�","���","����","��","�","�A"];out:[32]u8;for i:0..<8 {n:=gg_utf8(cast(string)raw[i][0..<lengths[i]],out[..]);#assert n==expected[i].count && cast(string)out[0..<n]==expected[i];}}
#test "golden form encoder uses the exact URLSearchParams safe byte alphabet" {bytes:[256]u8;o:[1]Jo;jo_start(o[..],bytes[..]);gg_form(o[..],"AZaz09*-._ ~+/?&=é\0");#assert !o[0].bad && jo_text(o[..])=="AZaz09*-._+%7E%2B%2F%3F%26%3D%C3%A9%00";}

#test "golden incomplete and partially valid percent escapes remain literal" {out:[32]u8;for text:[4]string.["%4","%4z","%z4","%"] {n:=gg_percent(text,out[..]);#assert n==text.count && cast(string)out[0..<n]==text;}n:=gg_query("?",out[..]);#assert n=="probe=&golden=&probe-manual=".count && cast(string)out[0..<n]=="probe=&golden=&probe-manual=";}
#test "golden Unicode continuation guards preserve replacement and reset scalar state" {out:[64]u8;n:=gg_utf8("é☃",out[..]);#assert n=="é☃".count && cast(string)out[0..<n]=="é☃";raw:=[4][4]u8.[[4]u8.[245,128,128,128],[4]u8.[240,128,128,128],[4]u8.[225,192,128,0],[4]u8.[225,128,192,0]];counts:=[4]int.[4,4,3,3];expected:=[4]string.["����","����","���","��"];for i:0..<4 {n=gg_utf8(cast(string)raw[i][0..<counts[i]],out[..]);#assert n==expected[i].count && cast(string)out[0..<n]==expected[i];}}
#forall "golden form byte alphabet and uppercase escapes are exact" value:0..<256 {allowed:="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789*-._";safe:=false;for c:allowed {if c==cast(u8)value {safe=true;}}bytes:=[1]u8.[cast(u8)value];out:[3]u8;o:[1]Jo;jo_start(o[..],out[..]);gg_form(o[..],cast(string)bytes[..]);if safe {#assert o[0].n==1 && out[0]==cast(u8)value;}else if value==32 {#assert jo_text(o[..])=="+";}else {digits:="0123456789ABCDEF";#assert o[0].n==3 && out[0]=='%' && out[1]==digits[value/16] && out[2]==digits[value%16];}}
#test "golden form scratch capacity failures refuse both keys and values" {out:[256]u8;raw:[32]u8;clean:[32]u8;#assert gg_query_into("A",out[..],raw[0..<0],clean[..])== -1;#assert gg_query_into("A",out[..],raw[..],clean[0..<0])== -1;#assert gg_query_into("a=AB",out[..],raw[0..<1],clean[..])== -1;#assert gg_query_into("a=%C2%80",out[..],raw[..],clean[0..<1])== -1;}
