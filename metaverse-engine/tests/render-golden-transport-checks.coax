#test "golden binary transport covers empty, exact chunks and the full declared viewport" {#assert gg_parts(-1)== -1 && gg_parts(536870913)== -1;#assert gg_parts(0)==1 && gg_parts(1)==1 && gg_parts(67108864)==1 && gg_parts(67108865)==2 && gg_parts(536870912)==8;#assert gg_chunk(0,0)==0 && gg_chunk(67108865,0)==67108864 && gg_chunk(67108865,1)==1 && gg_chunk(536870912,7)==67108864;#assert gg_chunk(0,-1)== -1 && gg_chunk(0,1)== -1 && gg_chunk(-1,0)== -1;}
#test "golden path resolution is lexical like Node, preserving symlink spellings" {out:[4096]u8;#assert gg_resolve("/work/repo","/tmp/a/../file",out[..])=="/tmp/file";#assert gg_resolve("/work/repo","a//b/./../c/",out[..])=="/work/repo/a/c";#assert gg_resolve("/work/repo","../../../../",out[..])=="/";#assert gg_resolve("/work/repo","",out[..])=="/work/repo";#assert gg_resolve("relative","a",out[..])=="";#assert gg_resolve("/a","b",out[0..<3])=="";#assert gg_resolve("/a","b",out[0..<4])=="/a/b";zero:=[2]u8.['a',0];#assert gg_resolve("/a",cast(string)zero[..],out[..])=="";}
GG_REUSE_TEST :: "{\"route\":\"legacy\",\"frames\":2,\"start\":false,\"query\":\"q\",\"width\":16,\"height\":8,\"source_changes\":[],\"errors\":[],\"exceptions\":[],\"legacy_shader_override\":null,\"legacy_particle_override\":null,\"source_inputs\":{\"/retired/producer.wasm\":\"digest\"}}";
#test "golden reuse admits the original controls and archived sources without reopening them" {nodes:[256]JvNode;d:[1]Jv;#assert jv_parse(d[..],GG_REUSE_TEST,nodes[..]);p:=GgOptions.{frames=2,width=16,height=8,query="q"};#assert gg_reuse(d[0],"legacy",p,"","","digest");#assert !gg_reuse(d[0],"generic",p,"","","digest") && !gg_reuse(d[0],"legacy",p,"","","other");p.start=true;#assert !gg_reuse(d[0],"legacy",p,"","","digest");p.start=false;p.frames=3;#assert !gg_reuse(d[0],"legacy",p,"","","digest");p.frames=2;p.width=8;#assert !gg_reuse(d[0],"legacy",p,"","","digest");p.width=16;p.height=16;#assert !gg_reuse(d[0],"legacy",p,"","","digest");p.height=8;p.query="different";#assert !gg_reuse(d[0],"legacy",p,"","","digest");p.query="q";#assert !gg_reuse(d[0],"legacy",p,"/shader","","digest") && !gg_reuse(d[0],"legacy",p,"","/particles","digest");}
#test "golden reuse rejects each retained validation event and distinguishes missing shader from null" {for bad:0..<3 {raw:[2048]u8;o:[1]Jo;jo_start(o[..],raw[..]);jo_put(o[..],"{\"route\":\"legacy\",\"frames\":2,\"start\":false,\"query\":\"q\",\"width\":16,\"height\":8,\"legacy_shader_override\":null,\"source_inputs\":{\"p.wasm\":\"digest\"}");for key,i:[3]string.["source_changes","errors","exceptions"] {jo_put(o[..],",");jo_str(o[..],key);jo_put(o[..],ifx i==bad then ":[1]" else ":[]");}jo_put(o[..],"}");nodes:[256]JvNode;d:[1]Jv;#assert jv_parse(d[..],jo_text(o[..]),nodes[..]);#assert !gg_reuse(d[0],"legacy",GgOptions.{frames=2,width=16,height=8,query="q"},"","","digest");}nodes:[128]JvNode;d:[1]Jv;#assert jv_parse(d[..],"{\"route\":\"legacy\",\"frames\":90,\"start\":false,\"source_changes\":[],\"errors\":[],\"exceptions\":[],\"source_inputs\":{\"p.wasm\":\"d\"}}",nodes[..]);#assert !gg_reuse(d[0],"legacy",GgOptions.{},"","","d");}
#test "golden POST acknowledgement binds path, publication, counts, bytes and identity" {raw:="{\"status\":200,\"ok\":true,\"sent_bytes\":3,\"receipt\":{\"schema\":\"aethyr.render-test-origin.post.v1\",\"status\":200,\"published\":true,\"staging_removed\":true,\"path\":\"/upload\",\"file\":\"/capture/part.bin\",\"declared_bytes\":3,\"received_bytes\":3,\"stored_bytes\":3,\"sha256\":\"hash\"}}";nodes:[256]JvNode;d:[1]Jv;#assert jv_parse(d[..],raw,nodes[..]);#assert gg_ack(d[0],"/upload","/capture/part.bin",3,"hash");#assert !gg_ack(d[0],"/other","/capture/part.bin",3,"hash") && !gg_ack(d[0],"/upload","/other",3,"hash") && !gg_ack(d[0],"/upload","/capture/part.bin",2,"hash") && !gg_ack(d[0],"/upload","/capture/part.bin",3,"other");for key:[9]string.["status","ok","sent_bytes","published","staging_removed","declared_bytes","received_bytes","stored_bytes","schema"] {changed:[2048]u8;w:[1]Jo;jo_start(w[..],changed[..]);for c,i:raw {if i>0 && rtq_find(raw,key,i)==i {jo_put(w[..],"bad");}jo_put(w[..],cast(string)raw[i..<i+1]);}#assert jv_parse(d[..],jo_text(w[..]),nodes[..]) && !gg_ack(d[0],"/upload","/capture/part.bin",3,"hash");}}
#test "golden lexical root, first component and exact OS path endpoints stay bounded" {out:[8192]u8;#assert gg_resolve("","/a",out[..])=="" && gg_resolve("/","a",out[..])=="/a" && gg_resolve("/cwd","/",out[..])=="/" && gg_resolve("/a","..",out[..])=="/";long:[8193]u8;long[0]='/';for k:1..<long.count {long[k]='a';}#assert gg_resolve("/",cast(string)long[0..<4096],out[..]).count==4096 && gg_resolve("/",cast(string)long[0..<4097],out[..])=="" && gg_resolve("/",cast(string)long[..],out[..])=="";}
#test "golden reuse nullish defaults and route override controls retain original distinctions" {nodes:[256]JvNode;d:[1]Jv;raw:="{\"route\":\"generic\",\"frames\":90,\"start\":false,\"source_changes\":[],\"errors\":[],\"exceptions\":[],\"source_inputs\":{\"p.wasm\":\"d\"}}";#assert jv_parse(d[..],raw,nodes[..]) && gg_reuse(d[0],"generic",GgOptions.{},"/ignored","/ignored","d");#assert gg_nullable(d[0],-1,"",true) && !gg_nullable(d[0],-1,"",false) && !gg_nullable(d[0],-1,"x",true);#assert gg_control_int(d[0],"missing",320,320) && !gg_control_int(d[0],"missing",320,321) && !gg_required_int(d[0],"missing",1);#assert jv_parse(d[..],"{\"route\":\"legacy\",\"frames\":1e0,\"start\":true,\"width\":null,\"height\":null,\"query\":null,\"source_changes\":[],\"errors\":[],\"exceptions\":[],\"source_inputs\":{\"p.wasm\":\"d\"},\"legacy_shader_override\":\"/scene\",\"legacy_particle_override\":\"/particles\"}",nodes[..]);p:=GgOptions.{start=true,frames=1};#assert gg_reuse(d[0],"legacy",p,"/scene","/particles","d") && !gg_reuse(d[0],"legacy",p,"/different","/particles","d") && !gg_reuse(d[0],"legacy",p,"/scene","/different","d");p.query="x";#assert !gg_reuse(d[0],"legacy",p,"/scene","/particles","d");#assert jv_parse(d[..],"{\"route\":\"legacy\",\"frames\":90,\"start\":false,\"query\":\"\",\"source_changes\":[],\"errors\":[],\"exceptions\":[],\"source_inputs\":{\"p.wasm\":\"d\"},\"legacy_shader_override\":null}",nodes[..]) && gg_reuse(d[0],"legacy",GgOptions.{},"","","d");}
#test "golden zero-byte POST requires every explicit byte count" {raw:="{\"status\":200,\"ok\":true,\"sent_bytes\":0,\"receipt\":{\"schema\":\"aethyr.render-test-origin.post.v1\",\"status\":200,\"published\":true,\"staging_removed\":true,\"path\":\"/upload\",\"file\":\"/capture/part.bin\",\"declared_bytes\":0,\"received_bytes\":0,\"stored_bytes\":0,\"sha256\":\"hash\"}}";nodes:[256]JvNode;d:[1]Jv;#assert jv_parse(d[..],raw,nodes[..]) && gg_ack(d[0],"/upload","/capture/part.bin",0,"hash");for key:[4]string.["sent_bytes","declared_bytes","received_bytes","stored_bytes"] {out:[2048]u8;o:[1]Jo;jo_start(o[..],out[..]);for c,i:raw {if rtq_find(raw,key,i)==i {jo_put(o[..],"missing_");}jo_put(o[..],cast(string)raw[i..<i+1]);}#assert jv_parse(d[..],jo_text(o[..]),nodes[..]) && !gg_ack(d[0],"/upload","/capture/part.bin",0,"hash");}}
#test "golden POST HTTP status is a typed exact successful number" {for value:[4]string.["201","\"200\"","0","null"] {raw:[2048]u8;o:[1]Jo;jo_start(o[..],raw[..]);jo_put(o[..],"{\"status\":");jo_put(o[..],value);jo_put(o[..],",\"ok\":true,\"sent_bytes\":0,\"receipt\":{\"schema\":\"aethyr.render-test-origin.post.v1\",\"status\":200,\"published\":true,\"staging_removed\":true,\"path\":\"/u\",\"file\":\"/f\",\"declared_bytes\":0,\"received_bytes\":0,\"stored_bytes\":0,\"sha256\":\"h\"}}");nodes:[256]JvNode;d:[1]Jv;#assert jv_parse(d[..],jo_text(o[..]),nodes[..]) && !gg_ack(d[0],"/u","/f",0,"h");}}
#test "golden output admission permits only a successful empty directory inventory" {#assert gg_output_fresh(0) && !gg_output_fresh(1) && !gg_output_fresh(-1) && !gg_output_fresh(8192);}
