rh_install :: (options:RhOptions,entry:RhEntry,out:[]u8)->int {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);keys:=[8]string.["start","half","pendingIndex","pendingLayer","pendingPack","textureStream","physical","mediaVideo"];values:=[8]bool.[options.start,options.half,options.pendingIndex,options.pendingLayer,options.pendingPack,options.textureStream,options.physical,options.mediaVideo];for key,k:keys {jo_key(o[..],key);jo_bool(o[..],values[k]);}if entry.autoentry {jo_key(o[..],"autoentry");jo_bool(o[..],true);}jo_key(o[..],"pw");jo_int(o[..],options.pw);jo_key(o[..],"ph");jo_int(o[..],options.ph);jo_key(o[..],"textureNames");jo_arr(o[..]);for k:0..<256 {name:[128]u8;w:[1]Jo;jo_start(w[..],name[..]);jo_put(w[..],"texture-");jo_int(w[..],k);jo_put(w[..],".bin");jo_str(o[..],jo_text(w[..]));}jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
rh_open :: (c:[]Cdp,s:[]RhSession,options:RhOptions,entry:RhEntry,dpr:string,browser:[]u8)->int {
  if !cdp_launch_background(c,1,1,"aethyr-render-host-coax-") {return -1;}version:=cdp_call(c,"Browser.getVersion","{}",30000);n:=rh_save_value(c,version,browser);if n<1 {return -1;}for method:[3]string.["Page.enable","Runtime.enable","Log.enable"] {if cdp_call(c,method,"{}",30000)<0 {return -1;}}
