  jo_key(o[..],"pins");jo_arr(o[..]);for file:[4]string.[wasm,html,prepared,manifest] {hash:[64]u8;if !rtq_input_add(inputs,file) || !rtq_hash_file(file,hash[..]) {return false;}jo_obj(o[..]);jo_key(o[..],"file");jo_str(o[..],file);jo_key(o[..],"sha256");jo_str(o[..],cast(string)hash[..]);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);return !o[0].bad && rto_saved(work,"origin-config.json",jo_text(o[..]));
