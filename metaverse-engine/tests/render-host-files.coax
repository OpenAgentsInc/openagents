  effects:[131072]u8;en:=fs_read(RH_EFFECTS,effects[..]);install:[32768]u8;in:=rh_install(options,entry,install[..]);if en<1 || in<1 {return -1;}preload:[262144]u8;w:[1]Jo;jo_start(w[..],preload[..]);jo_put(w[..],cast(string)effects[0..<en]);jo_put(w[..],";renderHostInstall(");jo_put(w[..],cast(string)install[0..<in]);jo_put(w[..],");");jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"source");jo_str(o[..],jo_text(w[..]));jo_end(o[..]);if o[0].bad || cdp_call(c,"Page.addScriptToEvaluateOnNewDocument",jo_text(o[..]),30000)<0 {return -1;}
  url:[512]u8;jo_start(w[..],url[..]);jo_put(w[..],"http://127.0.0.1:");jo_int(w[..],s[0].port);jo_put(w[..],"/?probe&golden");if entry.manual {jo_put(w[..],"&probe-manual");}jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],jo_text(w[..]));jo_end(o[..]);if cdp_call(c,"Page.navigate",jo_text(o[..]),30000)<0 {return -1;}return n;
}
rh_key :: (c:[]Cdp)->bool {for kind:[2]string.["keyDown","keyUp"] {data:[1024]u8;o:[1]Jo;jo_start(o[..],data[..]);jo_obj(o[..]);jo_key(o[..],"type");jo_str(o[..],kind);jo_key(o[..],"key");jo_str(o[..],"Enter");jo_key(o[..],"code");jo_str(o[..],"Enter");jo_key(o[..],"windowsVirtualKeyCode");jo_int(o[..],13);jo_key(o[..],"nativeVirtualKeyCode");jo_int(o[..],13);jo_end(o[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(o[..]),30000)<0 {return false;}}return true;}
rh_artifacts :: (c:[]Cdp,s:[]RhSession,status:string,manifest:string,inputs:[]RtqInputs)->bool {
