    if k==1 {jo_key(o[..],"text");jo_str(o[..],"");}else {jo_key(o[..],ifx k<4 then "file" else "directory");jo_str(o[..],ifx k==0 then prepared else ifx k==2 then wasm else ifx k==3 then (ifx options.mediaVideo then fs_join(video,"fixture.webm",paths[4][..]) else fs_join(surface,"apps/openagents-web/og/default.jpg",paths[4][..])) else ifx k==4 then fs_join(surface,"coax/web",paths[4][..]) else ifx k==5 then package else fs_join(surface,"apps/openagents-web",paths[4][..]));}if k==0 || k==3 {jo_key(o[..],"mime");jo_str(o[..],ifx k==0 then "text/html" else ifx options.mediaVideo then "video/webm" else "application/octet-stream");}jo_end(o[..]);
