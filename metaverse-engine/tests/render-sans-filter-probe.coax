// Exercises the production owned filter, including every physical mip. UV/LOD
// are per-draw uniforms so raster interpolation cannot hide a filter difference.
#load "../render/sans-filter.coax";
render_sans_probe_vs :: (vertex:u32,instance:u32)->V4 {
 sf_points:=[3]V2.[v2(-1,1),v2(3,1),v2(-1,-3)];sf_p:=sf_points[cast(int)vertex];return v4(sf_p.x,sf_p.y,0.5,1);
}
render_sans_probe_fs :: (position:V4,u:[]f32,filter_image:Tex2D,filter_sampler:Sampler)->V4 {
 return render_sans_sample(filter_image,v2(u[0],u[1]),u[2]);
}
