#load "../move/walk.coax" as walk;
#load "../physics/collide.coax" as collision;


#test "fast locomotion retains the fixed clock and collision travel contract through substeps" {
  w:walk.World; w.locomotion.walk_speed=14; w.locomotion.run_speed=30;
  p:=walk.walk_input(walk.walk_place(0,0,0,0),0,1,0,0,true,false,0,0);
  for i:0..<64 { p=walk.advance_scaled_in(w,p,f32(walk.STEP)); }
  #assert p.body.clock.ticks==64 && p.body.collision_status==collision.CollideStatus.ok && p.body.pos.z>10;
  wall:=[6]f32.[-3,0,2,3,3,2.05]; w.walls=wall[..];
  p=walk.walk_input(walk.walk_place(0,0,0,0),0,1,0,0,true,false,0,0);
  for i:0..<64 { p=walk.advance_scaled_in(w,p,f32(walk.STEP)); }
  #assert p.body.clock.ticks==64 && p.body.collision_status==collision.CollideStatus.ok && p.body.pos.z<=f32(1.70001);
}
#test "ordinary locomotion stays identical through the substep adapter" {
  w:walk.World; a:=walk.walk_input(walk.walk_place(0,0,0,0),0,1,0,0,true,true,0,0); a.cam.dist=1; b:=a;
  for i:0..<32 { a=walk.advance_in(w,a,f32(walk.STEP)); b=walk.advance_scaled_in(w,b,f32(walk.STEP)); }
  #assert walk.walker_same(a,b) && a.cam.target.z==b.cam.target.z;
  #assert a.cam.prev_target.x==b.cam.prev_target.x && a.cam.prev_target.y==b.cam.prev_target.y && a.cam.prev_target.z==b.cam.prev_target.z && a.cam.prev_dist==b.cam.prev_dist && a.body.prev_face==b.body.prev_face;
}

#test "a refused scaled tick keeps the same interpolation history as an ordinary refused tick" {
  w:walk.World; p:=walk.walk_input(walk.walk_place(0,0,0,0),0,1,0,0,true,false,0,0);
  for i:0..<8 { p=walk.advance_in(w,p,f32(walk.STEP)); }
  w.collision.max_passes=0;
  a:=walk.advance_in(w,p,f32(walk.STEP)); b:=walk.advance_scaled_in(w,p,f32(walk.STEP));
  #assert walk.walker_same(a,b) && a.body.prev_pos.z==b.body.prev_pos.z && a.cam.prev_target.z==b.cam.prev_target.z;
}

#test "the substep entry independently refuses invalid tuning and an unpaid long travel interval" {
  w:walk.World; p:=walk.walk_input(walk.walk_place(0,0,0,0),0,1,0,0,true,false,0,0);
  w.locomotion.walk_speed=14; w.locomotion.run_speed=30;
  q:=walk.body_substep(w,p.body,f32(walk.STEP));
  #assert q.collision_status==collision.CollideStatus.bad_profile && q.pos.z==p.body.pos.z;
  #assert walk.advance_in(w,p,f32(walk.STEP)).body.collision_status==collision.CollideStatus.bad_profile;
  w.locomotion.run_speed=7.5; w.locomotion.walk_speed=3.5; w.locomotion.jump_speed= -1;
  #assert walk.body_substep(w,p.body,f32(walk.STEP)/2).collision_status==collision.CollideStatus.bad_profile;
}
