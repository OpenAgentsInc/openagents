// SDK conversion writes only to an owned private staging directory. Failure
// removes it; the caller publishes nothing until the shared readers succeed.
ai_import_files :: (file:string,name:string,destination:string,rate:f32,sdk_root:string)->AiResult {
 format:=ai_format(file);if format==5 {return ai_import_unreal(file,name,destination,rate);}if format!=4 {return ai_import_data(file,name,destination,rate,"",AssetId.{},"");}
 result:AiResult;if !anim_name_ok(name) {result.err="rig-name";return result;}source:[67108864]u8;n:=fs_read(file,source[..]);if n<1 {result.err="source-read-or-capacity";return result;}identity:=asset_id(cast(string)source[0..<n]);home:[4096]u8;path:[4096]u8;folder:[4096]u8;current:=proc_getenv("HOME",home[..]);
 for part:[4]string.[".openagents","aethyrforge","animation-lab","source-imports"] {next:=fs_join(current,part,path[..]);if fs_kind(next)!=FS_DIR && !fs_mkdir(next) {result.err="sdk-staging-parent";return result;}for c,k:next {folder[k]=c;}current=cast(string)folder[0..<next.count];}
 leaf:[128]u8;o:[1]PnOut;o[0].buf=leaf[..];pn_put(o[..],"fbx-");pn_putint(o[..],proc_now_ns());stage_buf:[4096]u8;stage:=fs_join(current,pn_text(o[..]),stage_buf[..]);if !fs_mkdir(stage) {result.err="sdk-staging";return result;}defer {removed:=fs_remove(stage);}
 output:[4096]u8;gltf:=fs_join(stage,"character.gltf",output[..]);script_path:[4096]u8;script:=fs_join(sdk_root,"metaverse-engine/tools/anim-blender-export.py",script_path[..]);program:[4096]u8;blender:=proc_getenv("OPENAGENTS_BLENDER",program[..]);if blender=="" {blender="/Applications/Blender.app/Contents/MacOS/Blender";}args:=[9]string.[blender,"--background","--factory-startup","--python",script,"--",file,gltf,""];stdout:[8192]u8;stderr:[8192]u8;run:=proc_run(args[0..<8],600000,stdout[..],stderr[..]);if run.status!=0 || run.timed_out {result.err="fbx-sdk-export";return result;}
 return ai_import_data(gltf,name,destination,rate,file,identity,"fbx");
}

// The mesh reader owns the rig and geometry. Each separately exported SDK
// sequence resolves source nodes by name onto that admitted mesh skeleton.
ai_unreal_clips :: (source:string,folder:string,name:string,rate:f32,w:[]AiIO)->string {
 text:[262144]u8;n:=fs_read(source,text[..]);if n<1 {return "unreal-source-read";}plan:[1]AuSource;if au_source(cast(string)text[0..<n],plan[..])!=0 {return "unreal-source-schema";}
 saved:[64]AnimClip;count:=0;manifest:[1]Jo;jo_start(manifest[..],w[0].sequence_manifest[..]);jo_arr(manifest[..]);
 for k:0..<plan[0].clips {a:=plan[0].clip[k];if a.face {return "unreal-face-samples-not-supported";}leaf:[128]u8;o:[1]PnOut;o[0].buf=leaf[..];pn_put(o[..],cast(string)a.name.bytes[0..<a.name.n]);pn_put(o[..],".gltf");path:[4096]u8;file:=fs_join(folder,pn_text(o[..]),path[..]);n=fs_read(file,w[0].input[..]);if n<1 {return "unreal-animation-read";}
  d:[1]Jv;if !jv_parse(d[..],cast(string)w[0].input[0..<n],w[0].nodes[..]) {return "unreal-animation-json";}g:=[1]AgFile.[AgFile.{d=d[0]}];if jv_len(d[0],ag_get(g[..],0,"buffers"))!=1 {return "unreal-animation-buffers";}buffer:=ag_top(g[..],"buffers",0);uri:[256]u8;un:=jv_str(d[0],ag_get(g[..],buffer,"uri"),uri[..]);if un<1 || !ai_buffer_name(cast(string)uri[0..<un]) {return "unreal-animation-uri";}binary_path:[4096]u8;bn:=fs_read(fs_join(folder,cast(string)uri[0..<un],binary_path[..]),w[0].binary[..]);if bn<1 || bn!=ag_required(g[..],buffer,"byteLength") {return "unreal-animation-binary";}g[0].binary=w[0].binary[0..<bn];jo_obj(manifest[..]);jo_key(manifest[..],"asset");jo_str(manifest[..],cast(string)a.path[0..<a.path_n]);jo_key(manifest[..],"name");aw_name(manifest[..],a.name);digest:[64]u8;#assert asset_hex(asset_id(cast(string)w[0].input[0..<n]),digest[..]);jo_key(manifest[..],"gltf_sha256");jo_str(manifest[..],cast(string)digest[..]);#assert asset_hex(asset_id(cast(string)w[0].binary[0..<bn]),digest[..]);jo_key(manifest[..],"binary_sha256");jo_str(manifest[..],cast(string)digest[..]);jo_end(manifest[..]);
  scene:[1]AgScene;scene[0].nodes=jv_len(d[0],ag_get(g[..],0,"nodes"));if scene[0].nodes<1 || scene[0].nodes>512 {return "unreal-animation-nodes";}r:=w[0].build[0].library[0].rig[..];seen:[512]bool;
  for node:0..<scene[0].nodes {label:=ag_name(g[..],ag_top(g[..],"nodes",node),"name","joint-",node);joint:=anim_find(r[0].names[0..<r[0].joints],label);if joint<0 || seen[joint] {return "unreal-animation-joint";}seen[joint]=true;scene[0].node_joint[node]=joint;}
  e:=ag_animations(g[..],scene[..],rate,w[0].output[..],w[0].build[..]);if e!="" {return e;}if w[0].build[0].library[0].count!=1 {return "unreal-animation-count";}saved[count]=w[0].build[0].library[0].clips[0];saved[count].name=a.name;count+=1;
 }
 jo_end(manifest[..]);if manifest[0].bad {return "unreal-manifest-capacity";}w[0].sequence_manifest_n=manifest[0].n;for k:0..<count {w[0].build[0].library[0].clips[k]=saved[k];}w[0].build[0].library[0].count=count;return "";
}
ai_import_unreal :: (file:string,name:string,destination:string,rate:f32)->AiResult {
 result:AiResult;source:[262144]u8;n:=fs_read(file,source[..]);if n<1 {result.err="unreal-source-read";return result;}plan:[1]AuSource;if au_source(cast(string)source[0..<n],plan[..])!=0 {result.err="unreal-source-schema";return result;}
 if plan[0].profile!=0 || plan[0].meshes!=1 {result.err="unreal-profile-requires-compatibility-export";return result;}for k:0..<plan[0].clips {if plan[0].clip[k].face {result.err="unreal-face-samples-not-supported";return result;}}
 home:[4096]u8;root:[4096]u8;folder:[4096]u8;current:=proc_getenv("HOME",home[..]);for part:[4]string.[".openagents","aethyrforge","animation-lab","source-imports"] {next:=fs_join(current,part,root[..]);if fs_kind(next)!=FS_DIR && !fs_mkdir(next) {result.err="sdk-staging-parent";return result;}for c,k:next {folder[k]=c;}current=cast(string)folder[0..<next.count];}
 leaf:[128]u8;o:[1]PnOut;o[0].buf=leaf[..];pn_put(o[..],"unreal-");pn_putint(o[..],proc_now_ns());stage_path:[4096]u8;stage:=fs_join(current,pn_text(o[..]),stage_path[..]);plugin_buf:[4096]u8;plugin:=proc_getenv("OPENAGENTS_UNREAL_SDK",plugin_buf[..]);if plugin=="" {result.err="unreal-sdk-build-required";return result;}
