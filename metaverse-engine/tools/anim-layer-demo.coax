// Author a private study performance and measure every annotated contact.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../verse/animlab/layer-demo.coax";
#load "../anim/write.coax";
#load "../anim/export-policy.coax";
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=2 {print("usage: anim-layer-demo PRIVATE.bundle NEW_PRIVATE_DIR\n");return 2;}bytes:[67108864]u8;n:=fs_read(args_at(args[..],0),bytes[..]);if n<1 {return 1;}library:[1]AnimLibrary;#assert anim_bundle_load(bytes[0..<n],library[..])==0;demo:[1]AlLayerDemo;e:=al_demo(library[..],demo[..]);if e!=0 {print("demo refused code=%\n",e);return 1;}r:=library[0].rig[..];clips:=library[0].clips;clip_count:=library[0].count;clips[clip_count]=demo[0].clip;p:=demo[0].performance;
 receipt:[4096]u8;o:[1]Jo;jo_start(o[..],receipt[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.layers.demo.v1");jo_key(o[..],"recipe");jo_str(o[..],"walk-face-contacts.v1");hash:[64]u8;#assert asset_hex(asset_id(cast(string)bytes[0..<n]),hash[..]);jo_key(o[..],"input_bundle_sha256");jo_str(o[..],cast(string)hash[..]);jo_key(o[..],"contact_method");jo_str(o[..],"source foot joint within 2 cm of clip minimum, vertical speed <= 0.15 m/s, full-weight base interval only, gaps shorter than 0.15 s merged before target selection");jo_key(o[..],"base_blends_seconds");aw_number(o[..],0.15);jo_key(o[..],"contact_limit_cm");jo_int(o[..],1);jo_key(o[..],"boundary_limit_degrees");aw_number(o[..],0.25);jo_key(o[..],"boundary_limit_cm");aw_number(o[..],0.25);jo_end(o[..]);receipt_n:=o[0].n;clips[clip_count].receipt=asset_id(jo_text(o[..]));
 report:[262144]u8;jo_start(o[..],report[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.layers.check.v1");jo_key(o[..],"contact_sample_hz");jo_int(o[..],120);jo_key(o[..],"contacts");jo_arr(o[..]);a:[1]AnimSample;b:[1]AnimSample;max_off:f32=0;max_on:f32=0;max_path:f32=0;unreachable:=0;
 for k:0..<demo[0].count {contact:=demo[0].contacts[k];off:f32=0;on:f32=0;off_path:f32=0;on_path:f32=0;previous_a:Point;previous_b:Point;samples:=0;
  start:=cast(f32)contact.first/demo[0].clip.rate;duration:=contact.end-start;count:=cast(int)(duration*120)+2;epsilon:=lo(0.0001,duration*0.5);
  for tick:0..<count {time:=start+(duration-epsilon)*cast(f32)tick/cast(f32)(count-1);layer_evaluate(r,p,clips[0..<clip_count+1],library[0].packs[..],time,0,a[..]);b[0]=a[0];solved:=fixup_evaluate(r,p,clips[0..<clip_count+1],time,0,b[..]);unreachable+=solved.unreachable;pa:=a[0].position[contact.joint];pb:=b[0].position[contact.joint];off=hi(off,length(sub(pa,contact.target))*100);on=hi(on,length(sub(pb,contact.target))*100);if samples>0 {off_path+=length(sub(pa,previous_a))*100;on_path+=length(sub(pb,previous_b))*100;}previous_a=pa;previous_b=pb;samples+=1;}
  max_off=hi(max_off,off);max_on=hi(max_on,on);max_path=hi(max_path,on_path);jo_obj(o[..]);jo_key(o[..],"contact");jo_int(o[..],k);jo_key(o[..],"joint_index");jo_int(o[..],contact.joint);jo_key(o[..],"samples");jo_int(o[..],samples);jo_key(o[..],"off_cm");aw_number(o[..],off);jo_key(o[..],"on_cm");aw_number(o[..],on);jo_key(o[..],"off_path_cm");aw_number(o[..],off_path);jo_key(o[..],"on_path_cm");aw_number(o[..],on_path);jo_end(o[..]);
 }jo_end(o[..]);jump:f32=0;jump_cm:f32=0;boundary_layer:= -1;boundary_edge:= -1;
 for k:0..<p.count {l:=p.layers[k];for time,edge:[4]f32.[l.start,l.start+l.blend_in,l.end-l.blend_out,l.end] {left:=hi(0,time-0.0001);right:=time+0.0001;layer_evaluate(r,p,clips[0..<clip_count+1],library[0].packs[..],left,0,a[..]);left_report:=fixup_evaluate(r,p,clips[0..<clip_count+1],left,0,a[..]);layer_evaluate(r,p,clips[0..<clip_count+1],library[0].packs[..],right,0,b[..]);right_report:=fixup_evaluate(r,p,clips[0..<clip_count+1],right,0,b[..]);for j:0..<r[0].joints {if rt_rotation_error(a[0].rotation[j],b[0].rotation[j])>jump {boundary_layer=k;boundary_edge=edge;}jump=hi(jump,rt_rotation_error(a[0].rotation[j],b[0].rotation[j]));jump_cm=hi(jump_cm,length(sub(a[0].position[j],b[0].position[j]))*100);}}}
 jo_key(o[..],"max_off_cm");aw_number(o[..],max_off);jo_key(o[..],"max_on_cm");aw_number(o[..],max_on);jo_key(o[..],"max_on_path_cm");aw_number(o[..],max_path);jo_key(o[..],"unreachable_samples");jo_int(o[..],unreachable);jo_key(o[..],"boundary_epsilon_seconds");aw_number(o[..],0.0001);jo_key(o[..],"max_boundary_degrees");aw_number(o[..],jump);jo_key(o[..],"max_boundary_cm");aw_number(o[..],jump_cm);jo_end(o[..]);#assert !o[0].bad;report_n:=o[0].n;
 performance_text:[262144]u8;clip_text:[262144]u8;pn:=aw_performance(performance_text[..],p,r[0],clips[0..<clip_count+1]);#assert asset_hex(library[0].packs[0].id,hash[..]);cn:=aw_clip(clip_text[..],clips[clip_count],r[0],cast(string)hash[..]);#assert pn>0 && cn>0;admitted:[1]AnimPerformance;admitted_clip:[1]AnimClip;#assert anim_clip_load(cast(string)clip_text[0..<cn],library[0].packs[..],library[0].rig[..],admitted_clip[..])==0;clips[clip_count]=admitted_clip[0];#assert anim_performance_load(cast(string)performance_text[0..<pn],library[0].rig[..],clips[0..<clip_count+1],admitted[..])==0;
 home:[4096]u8;root:[4096]u8;canonical:[4096]u8;parent:[4096]u8;path:[4096]u8;private_root:=fs_realpath(fs_join(proc_getenv("HOME",home[..]),".openagents",root[..]),canonical[..]);request:=args_at(args[..],1);canonical_parent:=fs_realpath(fs_dir(request),parent[..]);leaf:=fs_base(request);#assert anim_export_path(canonical_parent,private_root,leaf);destination:[4096]u8;dest:=fs_join(canonical_parent,leaf,destination[..]);lock_path:[4096]u8;#assert fs_try_lock(fs_join(canonical_parent,".anim-export.lock",lock_path[..]));defer {released:=fs_unlock();}#assert fs_kind(dest)==FS_NONE && fs_mkdir(dest);#assert fs_write(fs_join(dest,"performance.json",path[..]),cast(string)performance_text[0..<pn]);#assert fs_write(fs_join(dest,"contact.clip.json",path[..]),cast(string)clip_text[0..<cn]);#assert fs_write(fs_join(dest,"report.json",path[..]),cast(string)report[0..<report_n]);#assert fs_write(fs_join(dest,"receipt.json",path[..]),cast(string)receipt[0..<receipt_n]);#assert asset_hex(asset_id(cast(string)report[0..<report_n]),hash[..]);
 print("layers=% contacts=% off_cm=% on_cm=% on_path_cm=% unreachable=% boundary_degrees=% boundary_cm=% boundary_layer=% boundary_edge=% report_sha256=%\n",p.count,demo[0].count,max_off,max_on,max_path,unreachable,jump,jump_cm,boundary_layer,boundary_edge,cast(string)hash[..]);return ifx demo[0].count>0 && max_on<1 && max_path<1 && jump<0.25 && jump_cm<0.25 then 0 else 1;
}
