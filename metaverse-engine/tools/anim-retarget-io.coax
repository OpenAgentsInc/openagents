// Native effects around shared document admission, retargeting and writers.
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../metaverse/animlab/mannequin.coax";
#load "../anim/retarget-clip.coax";
#load "../anim/export-policy.coax";
ArResult :: struct {code:int;frames:int;joints:int;bytes:int;paired:int;dropped_curves:int;dropped_events:int;}
ArWork :: struct {
 source_bytes:[67108864]u8;target_bytes:[67108864]u8;output:[67108864]u8;made:[262144]u8;
 source_text:[262144]u8;target_text:[262144]u8;clip_text:[262144]u8;rig_text:[262144]u8;next_text:[262144]u8;report:[262144]u8;receipt:[4096]u8;
 source:[1]AnimRig;target:[1]AnimRig;packed:[1]AnimRig;clip:[1]AnimClip;loaded:[1]AnimClip;factory:[1]AnimLibrary;
}
ar_error :: (code:int)->string {if code<=10 {return anim_error_name(code);}if code==91 {return "output already exists";}if code==92 {return "output must be a new directory under ~/.openagents";}return "could not read or write animation files";}
ar_read_pack :: (file:string,text:string,out:[]u8,identity:[]AssetId)->int {
 nodes:[32768]JvNode;d:[1]Jv;if anim_json(text,d[..],nodes[..])!=0 {return -1;}part:=jv_get(d[0],0,"rest");if !anim_hash(d[0],jv_get(d[0],part,"pack"),identity) {return -1;}hash:[64]u8;#assert asset_hex(identity[0],hash[..]);name:[68]u8;for c,k:hash {name[k]=c;}for c,k:".bin" {name[64+k]=c;}path:[4096]u8;n:=fs_read(fs_join(fs_dir(file),cast(string)name[..],path[..]),out);if n<1 || !asset_same(asset_id(cast(string)out[0..<n]),identity[0]) {return -1;}return n;
}
ar_references :: (r:[]AnimRig,pack:int) {for k:0..<r[0].sections {r[0].meshes[k].vertices.pack=pack;r[0].meshes[k].indices.pack=pack;}for k:0..<r[0].morph_count {r[0].morphs[k].data.pack=pack;}if r[0].dna.pack>=0 {r[0].dna.pack=pack;}}
ar_file :: (root:string,name:string,bytes:string)->bool {path:[4096]u8;file:=fs_join(root,name,path[..]);return file!="" && fs_write(file,bytes);}
anim_retarget_files :: (clip_file:string,source_rig_file:string,target_rig_file:string,destination:string)->ArResult {
 result:ArResult;result.code=90;w:[1]ArWork;path:[4096]u8;source_path:=source_rig_file;
 if source_path=="" {source_path=fs_join(fs_dir(clip_file),"rig.json",path[..]);if fs_kind(source_path)!=FS_FILE {source_path=fs_join(fs_dir(clip_file),"echo.rig.json",path[..]);}}
 rn:=fs_read(source_path,w[0].source_text[..]);cn:=fs_read(clip_file,w[0].clip_text[..]);if rn<1 || cn<1 {return result;}ids:[2]AssetId;sn:=ar_read_pack(source_path,cast(string)w[0].source_text[0..<rn],w[0].source_bytes[..],ids[..]);if sn<1 {return result;}
 packs:=[2]AnimPack.[AnimPack.{id=ids[0],bytes=w[0].source_bytes[0..<sn]},AnimPack.{}];e:=anim_rig_load(cast(string)w[0].source_text[0..<rn],packs[0..<1],w[0].source[..]);if e!=0 {result.code=e;return result;}
 if target_rig_file=="mannequin" {al_mannequin(w[0].factory[..],w[0].made[..]);w[0].target[0]=w[0].factory[0].rig[0];packs[1]=w[0].factory[0].packs[0];ar_references(w[0].target[..],1);}
 else {tn:=fs_read(target_rig_file,w[0].target_text[..]);if tn<1 {return result;}bn:=ar_read_pack(target_rig_file,cast(string)w[0].target_text[0..<tn],w[0].target_bytes[..],ids[1..<2]);if bn<1 {return result;}packs[1]=AnimPack.{id=ids[1],bytes=w[0].target_bytes[0..<bn]};e=anim_rig_load(cast(string)w[0].target_text[0..<tn],packs[..],w[0].target[..]);if e!=0 {result.code=e;return result;}}
 e=anim_clip_load(cast(string)w[0].clip_text[0..<cn],packs[..],w[0].source[..],w[0].clip[..]);if e!=0 {result.code=e;return result;}plan:[1]RtPlan;e=rt_plan(w[0].source[0],w[0].target[0],plan[..]);if e!=0 {result.code=e;return result;}
 layout:=aw_pack_rig(w[0].target[0],packs[..],w[0].output[..],w[0].packed[..]);if layout.bytes<0 {result.code=ANIM_CAPACITY;return result;}baked:=rt_bake(w[0].source[0],w[0].target[0],w[0].clip[0],packs[..],plan[0],w[0].output[..],layout.bytes,asset_id(""));if baked.bytes<0 {result.code=ANIM_CAPACITY;return result;}
 output_pack:=AnimPack.{id=asset_id(cast(string)w[0].output[0..<baked.bytes]),bytes=w[0].output[0..<baked.bytes]};hash:[64]u8;#assert asset_hex(output_pack.id,hash[..]);h:=cast(string)hash[..];o:[1]Jo;jo_start(o[..],w[0].report[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.retarget.report.v1");jo_key(o[..],"mapping");jo_str(o[..],"canonical-anchor.v1");jo_key(o[..],"source");aw_name(o[..],w[0].source[0].name);jo_key(o[..],"target");aw_name(o[..],w[0].target[0].name);jo_key(o[..],"paired_anchors");jo_int(o[..],plan[0].paired);jo_key(o[..],"root_scale");aw_number(o[..],plan[0].root_scale);jo_key(o[..],"leg_scale_available");jo_bool(o[..],plan[0].scaled);jo_key(o[..],"pack");jo_str(o[..],h);jo_key(o[..],"dropped_curves");jo_int(o[..],baked.dropped_curves);jo_key(o[..],"dropped_events");jo_int(o[..],baked.dropped_events);jo_key(o[..],"dropped_root");jo_bool(o[..],baked.dropped_root);
 jo_key(o[..],"unmapped");jo_arr(o[..]);for j:0..<w[0].target[0].joints {if plan[0].source_for_target[j]<0 {aw_name(o[..],w[0].target[0].names[j]);}}jo_end(o[..]);jo_key(o[..],"source_joints");jo_arr(o[..]);for j:0..<w[0].source[0].joints {slot:=rt_anchor_slot(plan[0].source,j);jo_obj(o[..]);jo_key(o[..],"joint");aw_name(o[..],w[0].source[0].names[j]);jo_key(o[..],"declared_slot");jo_int(o[..],w[0].source[0].mapped[j]);jo_key(o[..],"paired_anchor");jo_bool(o[..],slot>=0 && plan[0].target.joints[slot]>=0);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);if o[0].bad {result.code=ANIM_CAPACITY;return result;}report_n:=o[0].n;
 jo_start(o[..],w[0].receipt[..]);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.export.v1");jo_key(o[..],"converter");jo_str(o[..],"anim-retarget.v1");jo_key(o[..],"rig_file");jo_str(o[..],"rig.json");jo_key(o[..],"body_clips");jo_int(o[..],1);jo_key(o[..],"face_clips");jo_int(o[..],0);jo_key(o[..],"pack");jo_str(o[..],h);jo_key(o[..],"root_scale");aw_number(o[..],plan[0].root_scale);jo_key(o[..],"translations");jo_str(o[..],"root-only");source_hash:[64]u8;#assert asset_hex(asset_id(cast(string)w[0].clip_text[0..<cn]),source_hash[..]);jo_key(o[..],"input_clip_sha256");jo_str(o[..],cast(string)source_hash[..]);#assert asset_hex(packs[0].id,source_hash[..]);jo_key(o[..],"input_pack_sha256");jo_str(o[..],cast(string)source_hash[..]);#assert asset_hex(packs[1].id,source_hash[..]);jo_key(o[..],"target_pack_sha256");jo_str(o[..],cast(string)source_hash[..]);#assert asset_hex(w[0].clip[0].receipt,source_hash[..]);jo_key(o[..],"prior_receipt_sha256");jo_str(o[..],cast(string)source_hash[..]);#assert asset_hex(asset_id(cast(string)w[0].report[0..<report_n]),source_hash[..]);jo_key(o[..],"report_sha256");jo_str(o[..],cast(string)source_hash[..]);jo_end(o[..]);if o[0].bad {result.code=ANIM_CAPACITY;return result;}receipt_n:=o[0].n;baked.clip.receipt=asset_id(jo_text(o[..]));baked.clip.source=packs[0].id;
 rig_n:=aw_rig(w[0].rig_text[..],w[0].packed[0],layout,h);clip_n:=aw_clip(w[0].next_text[..],baked.clip,w[0].packed[0],h);output_packs:=[1]AnimPack.[output_pack];if rig_n<1 || clip_n<1 {result.code=ANIM_CAPACITY;return result;}e=anim_rig_load(cast(string)w[0].rig_text[0..<rig_n],output_packs[..],w[0].target[..]);if e==0 {e=anim_clip_load(cast(string)w[0].next_text[0..<clip_n],output_packs[..],w[0].target[..],w[0].loaded[..]);}if e!=0 {result.code=e;return result;}
 // Resolve the existing parent before creating anything. This also refuses
 // an output that traverses a symlink outside the private asset root.
 owner_home:[4096]u8;root_buf:[4096]u8;canonical_root:[4096]u8;parent_buf:[4096]u8;out_buf:[4096]u8;home_path:=proc_getenv("HOME",owner_home[..]);private_root:=fs_realpath(fs_join(home_path,".openagents",root_buf[..]),canonical_root[..]);parent:=fs_realpath(fs_dir(destination),parent_buf[..]);leaf:=fs_base(destination);if !anim_export_path(parent,private_root,leaf) {result.code=92;return result;}dest:=fs_join(parent,leaf,out_buf[..]);lock_path:[4096]u8;if !fs_try_lock(fs_join(parent,".anim-export.lock",lock_path[..])) {result.code=91;return result;}defer {released:=fs_unlock();}if fs_kind(dest)!=FS_NONE {result.code=91;return result;}if !fs_mkdir(dest) {return result;}
 filename:[68]u8;for c,k:hash {filename[k]=c;}for c,k:".bin" {filename[64+k]=c;}if !ar_file(dest,cast(string)filename[..],cast(string)w[0].output[0..<baked.bytes]) || !ar_file(dest,"rig.json",cast(string)w[0].rig_text[0..<rig_n]) || !ar_file(dest,"clip-0.json",cast(string)w[0].next_text[0..<clip_n]) || !ar_file(dest,"report.json",cast(string)w[0].report[0..<report_n]) || !ar_file(dest,"receipt.json",cast(string)w[0].receipt[0..<receipt_n]) {return result;}
 result.code=0;result.frames=baked.clip.frames;result.joints=baked.clip.joint_count;result.bytes=baked.bytes;result.paired=plan[0].paired;result.dropped_curves=baked.dropped_curves;result.dropped_events=baked.dropped_events;return result;
}
