// tool.sh: stack-gib 2
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "anim-scene-io.coax";
#load "../../verse/animlab/check.coax";
tool_main :: ()->int #export_c #effects(all) {a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}bytes:[67108864]u8;n:=ap_file(args_at(a[..],0),bytes[..]);p:[1]SceneProject;if n<1 || !project_load(bytes[0..<n],p[..]) {return 1;}out:[262144]u8;n=scene_check(p[..],out[..]);if n<0 {return 1;}print("%\n",cast(string)out[0..<n]);return 0;}
