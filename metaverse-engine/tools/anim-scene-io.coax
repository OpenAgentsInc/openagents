// Native file effects around the shared ALP1 admission. A project manifest
// supplies local files; only fully admitted immutable bytes reach playback.
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../metaverse/animlab/project.coax";
#load "../../coax/lib/text/ph_num.coax";
#load "../../metaverse-engine/anim/write.coax";
ap_file :: (file:string,out:[]u8)->int {
 // An explicitly published local edit head shadows its immutable source.
 // Invalid or missing version bytes refuse rather than playing stale source.
 history_file:=file;history_real:[4096]u8;canonical_history:=fs_realpath(file,history_real[..]);if canonical_history!="" {history_file=canonical_history;}history:[4096]u8;hn:=history_file.count+13;if hn<=history.count {for c,k:history_file {history[k]=c;}for c,k:".anim-history" {history[history_file.count+k]=c;}root:=cast(string)history[0..<hn];head_path:[4096]u8;head:=fs_join(root,"head",head_path[..]);if fs_kind(head)!=FS_NONE {hash:[64]u8;count:=fs_read(head,hash[..]);id:[1]AssetId;if count!=64 || !asset_parse(cast(string)hash[..],id[..]) {return -1;}leaf:[69]u8;for c,k:hash {leaf[k]=c;}for c,k:".json" {leaf[64+k]=c;}version_path:[4096]u8;receipt:[8192]u8;rn:=fs_read(fs_join(root,cast(string)leaf[..],version_path[..]),receipt[..]);if rn<1 || !asset_same(asset_id(cast(string)receipt[0..<rn]),id[0]) {return -1;}rnodes:[1024]JvNode;rd:[1]Jv;content:[1]AssetId;if anim_json(cast(string)receipt[0..<rn],rd[..],rnodes[..])!=0 || !anim_schema(rd[0],"anim.version.v1") || !anim_hash(rd[0],jv_get(rd[0],0,"content"),content[..]) {return -1;}for c,k:".alp" {leaf[64+k]=c;}size:=fs_read(fs_join(root,cast(string)leaf[0..<68],version_path[..]),out);if size<1 || !asset_same(asset_id(cast(string)out[0..<size]),content[0]) || !project_valid(out[0..<size]) {return -1;}return size;}}
 n:=fs_read(file,out);if n>0 && project_valid(out[0..<n]) {return n;}
 mode:=0;selected_name:AnimName;selected_rig:AnimName;selected_camera:AnimName;selected_length:f32=0;preview_scene:[8192]u8;preview_cut:[4096]u8;preview_scene_n:=0;preview_cut_n:=0;
 if n>0 && n<=262144 {input_nodes:[32768]JvNode;input:[1]Jv;if anim_json(cast(string)out[0..<n],input[..],input_nodes[..])==0 {mode=ifx anim_schema(input[0],"anim.performance.v1") then 1 else ifx anim_schema(input[0],"anim.scene.v1") then 2 else ifx anim_schema(input[0],"anim.cut.v1") then 3 else 0;selected_name=anim_name(input[0],jv_get(input[0],0,"name"));selected_rig=anim_name(input[0],jv_get(input[0],0,"rig"));selected_length=cast(f32)anim_number(input[0],jv_get(input[0],0,"length"),0.001,600).value;selected_camera=anim_name(input[0],jv_get(input[0],jv_at(input[0],jv_get(input[0],0,"cameras"),0),"name"));}}
 if mode==1 {preview_scene_n=ap_preview_scene(preview_scene[..],selected_name,selected_rig,selected_length);selected_name=anim_named("performance-preview");selected_camera=anim_named("preview");}if mode==1 || mode==2 {preview_cut_n=ap_preview_cut(preview_cut[..],selected_name,selected_camera,selected_length);}
 path:[4096]u8;manifest:[262144]u8;root:=fs_dir(file);name:=fs_base(file);manifest_file:=file;
 if name!="project.json" {manifest_file=fs_join(root,"project.json",path[..]);}
 mn:=fs_read(manifest_file,manifest[..]);if mn<1 {return -1;}nodes:[32768]JvNode;d:[1]Jv;if anim_json(cast(string)manifest[0..<mn],d[..],nodes[..])!=0 || !anim_schema(d[0],"anim.project.v1") || !anim_keys(d[0],0,"schema|libraries|performances|scene|cut|voices") {return -1;}
 libs:=jv_get(d[0],0,"libraries");perfs:=jv_get(d[0],0,"performances");voices:=jv_get(d[0],0,"voices");counts:=[3]int.[jv_len(d[0],libs),jv_len(d[0],perfs),jv_len(d[0],voices)];if jv_kind(d[0],libs)!=JV_ARRAY || jv_kind(d[0],perfs)!=JV_ARRAY || jv_kind(d[0],voices)!=JV_ARRAY || counts[0]<1 || counts[0]>2 || counts[1]<1 || counts[1]>16 || counts[2]>32 {return -1;}
 if mode==1 {counts[2]=0;}total:=counts[0]+counts[1]+counts[2]+2;cursor:=20+total*8;if cursor>out.count {return -1;}part:=0;leaf:[4096]u8;
 for category:0..<5 {list:=ifx category==0 then libs else ifx category==1 then perfs else voices;count:=ifx category==0 then counts[0] else ifx category==1 then counts[1] else ifx category==4 then counts[2] else 1;
  for k:0..<count {node:=ifx category==2 then jv_get(d[0],0,"scene") else ifx category==3 then jv_get(d[0],0,"cut") else jv_at(d[0],list,k);ln:=jv_str(d[0],node,leaf[..]);if ln<1 {return -1;}source:=fs_join(root,cast(string)leaf[0..<ln],path[..]);if (mode==2 && category==2) || (mode==3 && category==3) {source=file;}size:=0;if (mode==1 && category==2) || ((mode==1 || mode==2) && category==3) {part_text:=ifx category==2 then preview_scene[0..<preview_scene_n] else preview_cut[0..<preview_cut_n];if cursor+part_text.count>out.count {return -1;}for value,j:part_text {out[cursor+j]=value;}size=part_text.count;}else {size=fs_read(source,out[cursor..<out.count]);}if size<1 {return -1;}anim_bundle_put(out,20+part*8,cast(u32)cursor);anim_bundle_put(out,24+part*8,cast(u32)size);cursor+=size;part+=1;}
 }
 for value,k:[5]u32.[0x31504c41,cast(u32)cursor,cast(u32)counts[0],cast(u32)counts[1],cast(u32)counts[2]] {anim_bundle_put(out,k*4,value);}return ifx project_valid(out[0..<cursor]) then cursor else -1;
}

ap_preview_scene :: (out:[]u8,name:AnimName,rig:AnimName,length:f32)->int {
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.scene.v1");jo_key(o[..],"name");jo_str(o[..],"performance-preview");jo_key(o[..],"length");aw_number(o[..],length);jo_key(o[..],"style");jo_str(o[..],"realistic");jo_key(o[..],"stage");jo_raw(o[..],"{\"realm\":\"animation-lab\",\"place\":\"studio\",\"time\":0.5,\"weather\":\"clear\"}");jo_key(o[..],"cast");jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"name");jo_str(o[..],"actor");jo_key(o[..],"rig");aw_name(o[..],rig);jo_key(o[..],"look");jo_str(o[..],"default");jo_key(o[..],"performance");aw_name(o[..],name);jo_key(o[..],"path");jo_raw(o[..],"[{\"at\":0,\"position\":[0,0,0],\"yaw\":0}]");jo_end(o[..]);jo_end(o[..]);for field:[4]string.["props","effects","lights","sounds"] {jo_key(o[..],field);jo_raw(o[..],"[]");}jo_key(o[..],"cameras");jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"name");jo_str(o[..],"preview");jo_key(o[..],"fov");aw_number(o[..],0.8);jo_key(o[..],"focus");jo_int(o[..],4);jo_key(o[..],"keys");jo_arr(o[..]);for time,k:[2]f32.[0,length] {jo_obj(o[..]);jo_key(o[..],"at");aw_number(o[..],time);jo_key(o[..],"eye");jo_raw(o[..],"[3,2,4]");jo_key(o[..],"look");jo_raw(o[..],"[0,1,0]");jo_key(o[..],"cut");jo_bool(o[..],k==0);jo_key(o[..],"ease");jo_int(o[..],0);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
ap_preview_cut :: (out:[]u8,scene:AnimName,camera:AnimName,length:f32)->int {
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],"anim.cut.v1");jo_key(o[..],"name");jo_str(o[..],"preview");jo_key(o[..],"scene");aw_name(o[..],scene);jo_key(o[..],"fps");jo_int(o[..],24);jo_key(o[..],"shots");jo_arr(o[..]);jo_obj(o[..]);jo_key(o[..],"name");jo_str(o[..],"preview");jo_key(o[..],"camera");aw_name(o[..],camera);jo_key(o[..],"from");jo_int(o[..],0);jo_key(o[..],"to");aw_number(o[..],length);jo_key(o[..],"transition");jo_str(o[..],"cut");jo_key(o[..],"blend");jo_int(o[..],0);jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
