// A content tables file as a Coax string (#13381, #13404): the copy of its tables a page is built
// with. A game's content check (everglade/model/tools/content-check.coax,
// verse/splice/tools/content-check.coax) writes `head`, which ends by opening a string constant,
// then the file's bytes with a backslash, a quote and a newline escaped and nothing else changed,
// then the closing quote. The same bytes in give the same file out, so a check compares the two.
//   coax/bin/coax test metaverse-engine/tools/content-carry.coax --library

// The carried file into out; "" when out is too small.
content_carry :: (head: string, raw: string, out: [] u8) -> string {
  k := 0;
  if head.count + 2 * raw.count + 3 > out.count { return ""; }
  for ch: head { out[k] = ch; k += 1; }
  for ch: raw {
    if ch == '\\' || ch == '"' { out[k] = '\\'; out[k + 1] = ch; k += 2; }
    else if ch == '\n' { out[k] = '\\'; out[k + 1] = 'n'; k += 2; }
    else { out[k] = ch; k += 1; }
  }
  for ch: "\";\n" { out[k] = ch; k += 1; }
  return cast(string) out[0..<k];
}

#test "a carried file keeps its bytes: a quote, a backslash and a newline are escaped, and a small buffer gives nothing" {
  o: [64] u8;
  #assert content_carry("X :: \"", "a|\"b\"\n\\c\n", o[..]) == "X :: \"a|\\\"b\\\"\\n\\\\c\\n\";\n";
  #assert content_carry("X :: \"", "", o[..]) == "X :: \"\";\n";
  small: [10] u8; #assert content_carry("X :: \"", "ab", small[..]) == "";
}
