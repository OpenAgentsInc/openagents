// Edits a content tables file through the Metaverse Engine's edit log (#13294; metaverse-engine/editor/content-edit.coax):
// each edit is one typed step, and the file is written, at its next revision, only when every table
// still holds its rules.
// Usage: coax/web/tool.sh metaverse-engine/tools/content-edit.coax FILE check
//        coax/web/tool.sh metaverse-engine/tools/content-edit.coax FILE EDIT...
//   EDIT: row TABLE 'ID|CELL|...'   a row added or changed
//         drop TABLE ID             a row taken away
//         table NAME 'id COL:KIND ...;sum COL by COL N'   a table added, or its columns changed
// Everglade's own rules for its tables: coax/web/tool.sh everglade/model/tools/content-check.coax FILE
#import "Basic";
#load "../editor/content-edit.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 2 { tool_errln("usage: content-edit FILE check | FILE (row TABLE ROW | drop TABLE ID | table NAME HEADER)..."); return 2; }
  raw: [CT_BODY] u8; n := fs_read(args_at(a[..], 0), raw[..]);
  d: [1] ForgeDoc;
  if n <= 0 || !forge_content_open(d[..], cast(string) raw[0..<n]) { tool_errln("content-edit: the file is not a content document"); return 1; }
  if args_at(a[..], 1) == "check" { print("content: revision %, holds its rules\n", d[0].rev); return 0; }
  at := 1;
  while at < args_count(a[..]) {
    if at + 2 >= args_count(a[..]) { tool_errln("content-edit: an edit is three words"); return 2; }
    what := args_at(a[..], at); table := args_at(a[..], at + 1); arg := args_at(a[..], at + 2);
    done := false;
    if what == "row" { done = forge_content_row(d[..], table, arg); }
    if what == "drop" { done = forge_content_drop(d[..], table, ct_num(arg).v); }
    if what == "table" { done = forge_content_table(d[..], table, arg); }
    if !done { tool_err("content-edit: nothing changed by: "); tool_err(what); tool_err(" "); tool_err(table); tool_err(" "); tool_errln(arg); return 1; }
    at += 3;
  }
  out: [CT_BODY] u8;
  text := forge_content_text(d[..], d[0].rev + 1, out[..]);
  if text.count == 0 { tool_errln("content-edit: the tables would not hold their rules (a dangling ID, a place out of reach, a sum that is wrong, or a row that is not its table's); nothing written"); return 1; }
  if !fs_write(args_at(a[..], 0), text) { tool_errln("content-edit: cannot write the file"); return 1; }
  print("content: revision % written\n", d[0].rev + 1);
  return 0;
}
