// Checks proto/aethyr/content-v1.json against metaverse-engine/content/tables.coax, the content document's one
// codec (#13294): each fixture reads and writes back its own bytes; each rejected body does not read;
// the profile names itself, its version and this check.
// Usage: coax/web/tool.sh metaverse-engine/tools/content-profile.coax proto/aethyr/content-v1.json
#import "Basic";
#load "../content/tables.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";

CNP_FILE :: 262144;
CNP_CHECK :: "coax/web/tool.sh metaverse-engine/tools/content-profile.coax proto/aethyr/content-v1.json";

cnp_str :: (d: Jv, at: int, out: [] u8) -> string {
  n := jv_str(d, at, out);
  return ifx n >= 0 then cast(string) out[0..<n] else "";
}
cnp_check :: (profile_json: string) -> bool #effects(all) {
  nodes: [1024] JvNode; da: [1] Jv;
  if !jv_parse(da[..], profile_json, nodes[..]) { return false; }
  d := da[0];
  nb: [128] u8; cb: [256] u8; ib: [64] u8;
  if cnp_str(d, jv_get(d, 0, "profile"), nb[..]) != "aethyr-content-v1" || cnp_str(d, jv_get(d, 0, "id"), ib[..]) != CT_MAGIC || jv_int(d, jv_get(d, 0, "version"), 0) != 1 { return false; }
  if cnp_str(d, jv_get(d, 0, "check"), cb[..]) != CNP_CHECK { return false; }
  fxs := jv_get(d, 0, "fixtures");
  if jv_kind(d, fxs) != JV_ARRAY || jv_len(d, fxs) < 2 { return false; }
  doc: [1] ContentDoc;
  for i: 0..<jv_len(d, fxs) {
    wb: [CT_BODY] u8; ob: [CT_BODY] u8;
    wire := cnp_str(d, jv_get(d, jv_at(d, fxs, i), "wire"), wb[..]);
    if wire.count == 0 || !ct_read(doc[..], wire) || ct_write(doc[..], ob[..]) != wire { return false; }
  }
  rej := jv_get(d, 0, "rejected");
  if jv_kind(d, rej) != JV_ARRAY || jv_len(d, rej) < 4 { return false; }
  for i: 0..<jv_len(d, rej) {
    rb: [CT_BODY] u8;
    n := jv_str(d, jv_at(d, rej, i), rb[..]);
    if n < 0 || ct_read(doc[..], cast(string) rb[0..<n]) { return false; }
  }
  return true;
}

#test "content profile tool refuses a profile that is not one" {
  #assert !cnp_check("{}") && !cnp_check("bad");
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: content-profile FILE.json"); return 2; }
  raw: [CNP_FILE] u8; n := fs_read(args_at(a[..], 0), raw[..]);
  if n <= 0 { tool_errln("content-profile: cannot read JSON"); return 2; }
  if !cnp_check(cast(string) raw[0..<n]) { print("aethyr-content-v1: profile fails\n"); return 1; }
  print("aethyr-content-v1: profile holds\n");
  return 0;
}
