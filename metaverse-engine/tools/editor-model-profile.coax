// Checks proto/world/model-v1.json against metaverse-engine/editor/shell-model.coax, the one codec
// of what a page tells the editor shell (GitHub #13416): the pinned model reads as what the
// profile says of it and writes back the same bytes; the empty one reads; each rejected body
// does not; the limits are the module's; the profile names itself, its version and this check.
// Usage: coax/web/tool.sh metaverse-engine/tools/editor-model-profile.coax proto/world/model-v1.json
#import "Basic";
#load "../editor/shell-model.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";

EMP_CHECK :: "coax/web/tool.sh metaverse-engine/tools/editor-model-profile.coax proto/world/model-v1.json";
EmpWork :: struct { m: [1] EdModel; wire: [EM_BYTES] u8; out: [EM_BYTES] u8; scratch: [EM_BYTES] u8; }
emp_str :: (d: Jv, at: int, out: [] u8) -> string {
  n := jv_str(d, at, out);
  return ifx n >= 0 then cast(string) out[0..<n] else "";
}
emp_check :: (profile_json: string, w: [] EmpWork) -> bool {
  nodes: [640] JvNode; da: [1] Jv;
  if !jv_parse(da[..], profile_json, nodes[..]) { return false; }
  d := da[0]; m := w[0].m[..];
  nb: [128] u8; cb: [256] u8;
  if emp_str(d, jv_get(d, 0, "profile"), nb[..]) != "editor-model-v1" || jv_int(d, jv_get(d, 0, "version"), 0) != 1 || emp_str(d, jv_get(d, 0, "check"), cb[..]) != EMP_CHECK { return false; }
  if emp_str(d, jv_get(d, 0, "schema"), nb[..]) != EM_SCHEMA { return false; }
  lim := jv_get(d, 0, "limits");
  if jv_int(d, jv_get(d, lim, "entities"), 0) != EM_ENTS || jv_int(d, jv_get(d, lim, "kinds"), 0) != EM_KINDS || jv_int(d, jv_get(d, lim, "cells"), 0) != EM_CELLS { return false; }
  if jv_int(d, jv_get(d, lim, "name_bytes"), 0) != EM_NAME || jv_int(d, jv_get(d, lim, "value_bytes"), 0) != EM_VALUE || jv_int(d, jv_get(d, lim, "refusal_bytes"), 0) != EM_WORDS || jv_int(d, jv_get(d, lim, "bytes"), 0) != EM_BYTES { return false; }
  one := jv_get(d, 0, "model");
  wire := emp_str(d, jv_get(d, one, "wire"), w[0].wire[..]);
  if wire.count == 0 || !em_read(m, wire, w[0].scratch[..]) || em_write(m, w[0].out[..]) != wire { return false; }
  world := m[0].world; lanes := WE_LANE;
  if emp_str(d, jv_get(d, one, "world"), nb[..]) != cast(string) world[0..<m[0].world_n] || emp_str(d, jv_get(d, one, "lane"), nb[..]) != lanes[m[0].lane] { return false; }
  if jv_int(d, jv_get(d, one, "rev"), -1) != m[0].rev || jv_int(d, jv_get(d, one, "undo"), -1) != m[0].undo || jv_int(d, jv_get(d, one, "redo"), -1) != m[0].redo || jv_int(d, jv_get(d, one, "selected"), -1) != m[0].sel { return false; }
  if jv_int(d, jv_get(d, one, "kinds"), -1) != m[0].nk || jv_int(d, jv_get(d, one, "entities"), -1) != m[0].ne || jv_int(d, jv_get(d, one, "cells"), -1) != m[0].nc || m[0].no_n == 0 { return false; }
  tb := m[0].table;
  if emp_str(d, jv_get(d, one, "table"), nb[..]) != cast(string) tb[0..<m[0].table_n] || m[0].table_n == 0 { return false; }
  if jv_int(d, jv_get(d, one, "templates"), -1) != m[0].nt || jv_int(d, jv_get(d, lim, "templates"), 0) != EM_TEMPLATES || jv_int(d, jv_get(d, lim, "parts_bytes"), 0) != EM_PARTS { return false; }
  here := jv_get(d, one, "here");
  if !m[0].here || jv_int(d, jv_at(d, here, 0), 0) != m[0].here_x || jv_int(d, jv_at(d, here, 1), 0) != m[0].here_z { return false; }
  // a world kept on this device: how many things it holds and takes, its kinds in all, its land's brushes and materials
  if jv_int(d, jv_get(d, lim, "materials"), 0) != EM_MATS { return false; }
  loc := jv_get(d, 0, "local");
  lw := emp_str(d, jv_get(d, loc, "wire"), w[0].wire[..]);
  if lw.count == 0 || !em_read(m, lw, w[0].scratch[..]) || em_write(m, w[0].out[..]) != lw || !m[0].local || !m[0].all || !m[0].land || !m[0].here { return false; }
  lworld := m[0].world;
  if emp_str(d, jv_get(d, loc, "world"), nb[..]) != cast(string) lworld[0..<m[0].world_n] { return false; }
  if jv_int(d, jv_at(d, jv_get(d, loc, "all"), 0), -1) != m[0].all_n || jv_int(d, jv_at(d, jv_get(d, loc, "all"), 1), -1) != m[0].all_cap || jv_int(d, jv_get(d, loc, "kinds"), -1) != m[0].kinds_all { return false; }
  if jv_int(d, jv_at(d, jv_get(d, loc, "land"), 0), -1) != m[0].land_lo || jv_int(d, jv_at(d, jv_get(d, loc, "land"), 1), -1) != m[0].land_hi || jv_int(d, jv_get(d, loc, "materials"), -1) != m[0].nm { return false; }
  // NPCs' plans by time of day (#13466)
  if jv_int(d, jv_get(d, lim, "actors"), 0) != EM_ACTORS || jv_int(d, jv_get(d, lim, "plans"), 0) != EM_PLANS || jv_int(d, jv_get(d, lim, "route_bytes"), 0) != EM_ROUTE { return false; }
  act := jv_get(d, 0, "actors");
  aw := emp_str(d, jv_get(d, act, "wire"), w[0].wire[..]);
  if aw.count == 0 || !em_read(m, aw, w[0].scratch[..]) || em_write(m, w[0].out[..]) != aw { return false; }
  ck := m[0].clock;
  if jv_int(d, jv_get(d, act, "actors"), -1) != m[0].na || jv_int(d, jv_get(d, act, "plans"), -1) != m[0].np || jv_int(d, jv_get(d, act, "selected"), -1) != m[0].asel || emp_str(d, jv_get(d, act, "clock"), nb[..]) != cast(string) ck[0..<m[0].clock_n] { return false; }
  // realm scripts (#13467)
  if jv_int(d, jv_get(d, lim, "scripts"), 0) != EM_SCRIPTS || jv_int(d, jv_get(d, lim, "script_kinds"), 0) != EM_SKINDS || jv_int(d, jv_get(d, lim, "script_name_bytes"), 0) != EM_SNAME { return false; }
  scr := jv_get(d, 0, "scripts");
  sw := emp_str(d, jv_get(d, scr, "wire"), w[0].wire[..]);
  if sw.count == 0 || !em_read(m, sw, w[0].scratch[..]) || em_write(m, w[0].out[..]) != sw { return false; }
  stb := m[0].stable;
  if jv_int(d, jv_get(d, scr, "kinds"), -1) != m[0].nsk || jv_int(d, jv_get(d, scr, "rows"), -1) != m[0].ns || emp_str(d, jv_get(d, scr, "table"), nb[..]) != cast(string) stb[0..<m[0].stable_n] { return false; }
  // lists of switches and a world of one lane (#13478)
  if jv_int(d, jv_get(d, lim, "lists"), 0) != EM_LISTS || jv_int(d, jv_get(d, lim, "switches"), 0) != EM_SWITCHES || jv_int(d, jv_get(d, lim, "label_bytes"), 0) != EM_LABEL { return false; }
  lst := jv_get(d, 0, "lists");
  lsw := emp_str(d, jv_get(d, lst, "wire"), w[0].wire[..]);
  if lsw.count == 0 || !em_read(m, lsw, w[0].scratch[..]) || em_write(m, w[0].out[..]) != lsw { return false; }
  if jv_int(d, jv_get(d, lst, "lists"), -1) != m[0].nl || jv_int(d, jv_get(d, lst, "switches"), -1) != m[0].nw || jv_kind(d, jv_get(d, lst, "at_once")) != JV_TRUE || !m[0].at_once { return false; }
  empty := emp_str(d, jv_get(d, jv_get(d, 0, "empty"), "wire"), w[0].wire[..]);
  if empty.count == 0 || !em_read(m, empty, w[0].scratch[..]) || m[0].ne != 0 || m[0].lane != 1 { return false; }
  rej := jv_get(d, 0, "rejected");
  if jv_kind(d, rej) != JV_ARRAY || jv_len(d, rej) < 6 { return false; }
  for i: 0..<jv_len(d, rej) {
    n := jv_str(d, jv_at(d, rej, i), w[0].wire[..]);
    if n < 0 || em_read(m, cast(string) w[0].wire[0..<n], w[0].scratch[..]) { return false; }
  }
  return true;
}
#test "model profile tool refuses a profile that is not one" { w: [1] EmpWork; #assert !emp_check("{}", w[..]) && !emp_check("bad", w[..]); }

EmpMain :: struct { w: [1] EmpWork; raw: [65536] u8; }
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; h: [1] EmpMain;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: editor-model-profile FILE.json"); return 2; }
  n := fs_read(args_at(a[..], 0), h[0].raw[..]);
  if n <= 0 { tool_errln("editor-model-profile: cannot read JSON"); return 2; }
  if !emp_check(cast(string) h[0].raw[0..<n], h[0].w[..]) { print("editor-model-v1: profile fails\n"); return 1; }
  print("editor-model-v1: profile holds\n");
  return 0;
}
