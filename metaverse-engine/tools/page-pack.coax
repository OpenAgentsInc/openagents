// Write a VPK1 asset pack as a range-addressable VPK3 file (metaverse-engine/editor/page-pack.coax, #13001)
// and read it back: every page inflated, admitted by its SHA-256, and the image compared with the
// pack byte for byte. The output is the same for the same pack, so a build rewrites it only when
// the pack changed.
//   coax/web/tool.sh metaverse-engine/tools/page-pack.coax IN.pack OUT.vpk3 [--defer sounds|layers|none]
//   coax/web/tool.sh metaverse-engine/tools/page-pack.coax --check IN.pack OUT.vpk3
// --defer names the entries that are not roots (default: sounds), so a client publishes the pack
// without them and they follow. A pack's cells entry (kind 8: a world's content by cell, GitHub
// #13280) is never a root unless --defer none: a host fetches a cell's pages when the cell is asked
// for. Exit 1 when the pack is refused or the file doesn't read back.
// tool.sh: release
#import "Basic";
#load "../editor/page-pack.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";

PPT_MAX :: 67108864;

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { return 2; }
  check := args_has(a[..], "--check");
  paths: [2] string; n := 0; defer_kinds := (1 << PACK_SOUND) | (1 << PACK_CELLS);
  i := 0;
  while i < args_count(a[..]) {
    s := args_at(a[..], i);
    if s == "--check" { i += 1; continue; }
    if s == "--defer" && i + 1 < args_count(a[..]) {
      d := args_at(a[..], i + 1);
      defer_kinds = ifx d == "none" then 0 else ifx d == "layers" then (1 << PACK_LAYER) | (1 << PACK_SOUND) | (1 << PACK_CELLS) else (1 << PACK_SOUND) | (1 << PACK_CELLS);
      i += 2; continue;
    }
    if n == 2 { n = 3; break; }
    paths[n] = s; n += 1; i += 1;
  }
  if n != 2 { tool_errln("usage: page-pack [--check] IN.pack OUT.vpk3 [--defer sounds|layers|none]"); return 2; }
  image: [PPT_MAX] u8; file: [PPT_MAX] u8; back: [PPT_MAX] u8; scratch: [PPK_PAGE_MAX + 65536] u8; w: [1] DeflateWork;
  size := fs_read(paths[0], image[..]);
  if size < 0 { print("FAIL %: can't read it (missing, or over % bytes)\n", paths[0], PPT_MAX); return 1; }
  p := cast(string) image[0..<size];
  wrote := 0;
  if check {
    wrote = fs_read(paths[1], file[..]);
    if wrote < 0 { print("FAIL %: can't read it\n", paths[1]); return 1; }
  } else {
    starts: [PPK_PAGES] int; roots: [PPK_PAGES] bool; entries: [PPK_PAGES] int;
    pages := ppk_plan(p, PPK_PAGE, defer_kinds, starts[..], roots[..], entries[..]);
    if pages < 0 { print("FAIL %: not a pack this format can page\n", paths[0]); return 1; }
    wrote = ppk_write(p, starts[0..<pages], roots[0..<pages], entries[0..<pages], file[..], scratch[..], w[..]);
    if wrote < 0 { print("FAIL %: can't write it\n", paths[1]); return 1; }
  }
  l: [1] PpkLoad;
  got := ppk_read_all(file[0..<wrote], back[..], l[..]);
  if got != size || cast(string) back[0..<got] != p { print("FAIL %: doesn't read back as %\n", paths[1], paths[0]); return 1; }
  if !check {
    same := fs_size(paths[1]) == wrote;
    if same { same = fs_read(paths[1], back[..]) == wrote && cast(string) back[0..<wrote] == cast(string) file[0..<wrote]; }
    if !same && !fs_write(paths[1], cast(string) file[0..<wrote]) { print("FAIL %: can't write it\n", paths[1]); return 1; }
  }
  m := l[0].m; deflated := 0; for k: 0..<m.pages { if m.page[k].codec == PPK_DEFLATE { deflated += 1; } }
  print("%: % pages (% roots, % deflated), % bytes for a %-byte image (% per mille)\n", paths[1], m.pages, m.roots, deflated, wrote, size, wrote * 1000 / size);
  return 0;
}
