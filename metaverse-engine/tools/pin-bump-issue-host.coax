// The effects of metaverse-engine/tools/pin-bump-issue.coax (GitHub #13665): gh and git as child
// processes, and the program's main. What the issue says is decided in pin-bump-issue.coax with its
// checks; this file only reads what gh and git answer and prints or opens the issue.
// Runs argv to its end; its stdout into out. The status, or -1 when it didn't start.
pb_run :: (argv: [] string, out: [] u8, got: [] int) -> int {
  e: [8192] u8;
  r := proc_run(argv, 120000, out, e[..]);
  got[0] = r.out_n;
  if r.started != 0 { return -1; }
  if r.status != 0 && r.err_n > 0 { tool_errln(cast(string) e[0..<r.err_n]); }
  return ifx r.timed_out then -1 else r.status;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; if !args_load(a[..]) { return 2; }
  pr := args_value(a[..], "--pr", ""); commit := args_value(a[..], "--commit", ""); dry := args_has(a[..], "--dry-run");
  if (pr == "") == (commit == "") || (pr != "" && pb_number(pr) == 0) {
    tool_errln("usage: coax/web/tool.sh metaverse-engine/tools/pin-bump-issue.coax --pr N | --commit SHA [--dry-run]");
    return 2;
  }
  m: PbMerge; out: [262144] u8; files: [262144] u8; got: [1] int;
  if pr != "" {
    view := [8] string.["gh", "pr", "view", pr, "--repo", PB_REPO, "--json", "state,mergeCommit,author,title,files"];
    jq := "--jq";
    full := [10] string.[view[0], view[1], view[2], view[3], view[4], view[5], view[6], view[7], jq, ".state, (.mergeCommit.oid // \"\"), .author.login, .title, (.files | map(.path) | join(\"\\n\"))"];
    if pb_run(full[..], out[..], got[..]) != 0 { tool_errln("pin-bump-issue: gh could not read the pull request"); return 1; }
    text := cast(string) out[0..<got[0]];
    if pb_line(text, 0) != "MERGED" { tool_errln("pin-bump-issue: the pull request is not merged"); return 1; }
    m.pull = pb_number(pr); m.commit = pb_line(text, 1); m.login = pb_line(text, 2); m.title = pb_line(text, 3);
    // the paths are every line after the title
    at := 0; for i: 0..<4 { while at < text.count && text[at] != '\n' { at += 1; } at += 1; }
    m.files = ifx at < text.count then cast(string) text[at..<text.count] else "";
    if m.commit.count == 0 { tool_errln("pin-bump-issue: the pull request has no merge commit"); return 1; }
  } else {
    show := [5] string.["git", "log", "-1", "--format=%H%n%an%n%ae%n%s", commit];
    if pb_run(show[..], out[..], got[..]) != 0 { tool_errln("pin-bump-issue: git does not know that commit (git fetch origin main)"); return 1; }
    text := cast(string) out[0..<got[0]];
    m.commit = pb_line(text, 0); m.name = pb_line(text, 1); m.title = pb_line(text, 3);
    who := [1] string.[""];
    m.pull = pb_pull_of_subject(m.title, who[..]);
    m.login = ifx who[0].count > 0 then who[0] else pb_login_of_email(pb_line(text, 2));
    // the first parent's view: a squash, a rebase or a merge commit's whole change
    first: [1] PbText; pb_add(first[..], m.commit); pb_add(first[..], "^1");
    diff := [5] string.["git", "diff", "--name-only", pb_text(first[..]), m.commit];
    if pb_run(diff[..], files[..], got[..]) != 0 { tool_errln("pin-bump-issue: git could not list the commit's files"); return 1; }
    m.files = cast(string) files[0..<got[0]];
  }
  t: [1] PbText; pb_title(m, t[..]); b: [1] PbText; pb_body(m, b[..]);
  if dry { print("%\n\n%", pb_text(t[..]), pb_text(b[..])); return 0; }
  create := [8] string.["gh", "issue", "create", "--repo", PB_TARGET, "--title", pb_text(t[..]), "--body"];
  argv := [9] string.[create[0], create[1], create[2], create[3], create[4], create[5], create[6], create[7], pb_text(b[..])];
  if pb_run(argv[..], out[..], got[..]) != 0 { tool_errln("pin-bump-issue: gh could not open the issue"); return 1; }
  print("%\n", cast(string) out[0..<got[0]]);
  return 0;
}
