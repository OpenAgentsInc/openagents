// Build one shared journey for native and Wasm and compare every output bit.
// Chrome runs through the existing muted, headless CDP host.
#load "../../coax/web/wasm-chrome.coax";
#load "../../coax/lib/sys/proc-raw.coax";
#load "../../coax/lib/crypto/sha256-kernel.coax";

qwh_run :: (args: [] string, output: [] u8) -> int {
  errors: [8192] u8;
  env: [1] string;
  r := proc_run_bytes(args, env[0..<0], 180000, output, errors[..]);
  if r.started != 0 || r.status != 0 || r.cut {
    print("process % started % status % cut %\n", args[0], r.started, r.status, r.cut);
    tool_errln(cast(string) errors[0..<r.err_n]); return -1;
  }
  return r.out_n;
}
tool_main :: () -> int #export_c #effects(all) {
  temp: [1024] u8; native_path: [1100] u8; wasm_path: [1100] u8;
  dir := fs_temp("aethyr-query-world-", temp[..]);
  if dir.count == 0 { return 1; }
  defer { removed := fs_remove(dir); }
  native := fs_join(dir, "journey", native_path[..]); wasm := fs_join(dir, "journey.wasm", wasm_path[..]);
  output: [1048576] u8;
  print("building native semantic journey\n");
  build := [7] string.["coax/bin/coax", "build", "metaverse-engine/examples/query-world.coax", "--opt", "2", "-o", native];
  if qwh_run(build[..], output[..]) < 0 { return 1; }
  print("building Wasm semantic journey\n");
  wasm_build := [4] string.["coax/web/wasm.sh", "metaverse-engine/examples/query-world.coax", "metaverse-engine/tests/query-world-face.c", wasm];
  if qwh_run(wasm_build[..], output[..]) < 0 { return 1; }
  invoke := [1] string.[native]; n := qwh_run(invoke[..], output[..]);
  if n < 0 { return 1; }
  expected: [14] int; count := 0; begin := 0;
  for i: 0..<n {
    if output[i] == '\n' {
      if count >= 14 { return 1; }
      expected[count] = wc_parse(cast(string) output[begin..<i]); count += 1; begin = i + 1;
    }
  }
  if count != 14 || begin != n || expected[0] != 1 || expected[11] != 1 || expected[12] != 1 || expected[13] != 12 {
    print("native transcript refused: count % tail %/% first % last %\n", count, begin, n, expected[0], expected[11]); return 1;
  }
  bytes: [16777216] u8; size := fs_read(wasm, bytes[..]); if size <= 0 { return 1; }
  digest: [64] u8;
  if !S_hex(S_hash(cast(string) bytes[0..<size]), digest[..]) { return 1; }
  print("Wasm sha256 %\n", cast(string) digest[..]);
  c: [1] Cdp; defer { cdp_close(c[..]); }
  print("running muted headless Wasm semantic journey\n");
  if !wc_open(c[..]) || !wc_file(c[..], "query", cast(string) bytes[0..<size]) || wc_load(c[..], "query", 512, "{}", WC_ZERO) != "ok" {
    tool_errln(cdp_error(c[..])); return 1;
  }
  print("browser %\n", wc_eval(c[..], "navigator.userAgent"));
  for i: 0..<14 {
    digits: [24] u8; args: [32] u8;
    parts := [2] string.[wc_dec(digits[..], i), "n"];
    observed := wc_call(c[..], "query_world_word", wc_cat(args[..], parts[..]));
    if observed.count == 0 || wc_parse(observed) != expected[i] { print("word % differs: native % browser %\n", i, expected[i], observed); return 1; }
    print("word % %\n", i, expected[i]);
  }
  print("PASS native/Wasm semantic query journey: 14 exact words, wasm % bytes\n", size);
  return 0;
}
