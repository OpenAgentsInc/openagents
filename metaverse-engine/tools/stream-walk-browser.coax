// Drive the actual HTTP/WebGPU consumer in muted headless Chrome.
// tool.sh: stack-gib 1
#load "../../coax/web/wasm-chrome.coax";
#load "../core/assets.coax" as assets;
#load "../../coax/lib/image/pillow.coax";
#load "../render/tests/compare-frames-policy.coax" as comparison;
#load "stream-walk-faults.coax";
ceil :: (x: f64) -> f64 #foreign #effects(all);
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 3 || args_count(a[..]) > 5 { tool_errln("usage: stream-walk-browser BASE_URL SCENE_JSON OUTPUT_JSON [--short|--route|--route-high|--cancel-stall|--recover|--recover-high|--upload-failure|--corrupt-source|--oversize-source|--cancel-replay|--out-of-order|--corrupt-pack|--constructor-failure] [TRANSPORT_SHA]"); return 2; }
  high := args_count(a[..]) >= 4 && (args_at(a[..], 3) == "--route-high" || args_at(a[..], 3) == "--recover-high");
  route := args_count(a[..]) >= 4 && (args_at(a[..], 3) == "--route" || args_at(a[..], 3) == "--route-high");
  cancel_stall := args_count(a[..]) >= 4 && args_at(a[..], 3) == "--cancel-stall";
  recover := args_count(a[..]) >= 4 && (args_at(a[..], 3) == "--recover" || args_at(a[..], 3) == "--recover-high");
  upload_failure := args_count(a[..]) >= 4 && args_at(a[..], 3) == "--upload-failure";
  fault := args_count(a[..]) >= 4 && (args_at(a[..], 3) == "--corrupt-source" || args_at(a[..], 3) == "--oversize-source" || args_at(a[..], 3) == "--cancel-replay" || args_at(a[..], 3) == "--out-of-order" || args_at(a[..], 3) == "--corrupt-pack" || args_at(a[..],3)=="--constructor-failure");
  if args_count(a[..]) >= 4 && !route && !cancel_stall && !recover && !upload_failure && !fault && args_at(a[..],3)!="--short" { return 2; }
  data: [65536] u8; n := fs_read(args_at(a[..], 1), data[..]); if n < 1 { return 1; }
  d: [1] Jv; nodes: [4096] JvNode; if !jv_parse(d[..], cast(string) data[0..<n], nodes[..]) { return 1; }
  manifest := jv_at(d[0], jv_get(d[0], 0, "manifests"), ifx high then 1 else 0); root: [64] u8;
  if jv_str(d[0], jv_get(d[0], manifest, "sha256"), root[..]) != 64 { return 1; }
  hex: [64] u8; if !assets.asset_hex(assets.asset_id(cast(string) data[0..<n]), hex[..]) { return 1; }
  digits: [32] u8; url: [4096] u8;
  pieces := [8] string.[args_at(a[..], 0), "/metaverse-engine/host/tests/stream-walk.html?root=", cast(string) root[..], "&scene_sha=", cast(string) hex[..], "&scene_bytes=", wc_dec(digits[..], n), ifx high then "&tier=1" else "&tier=0"];
  prefix := wc_cat(url[..], pieces[..]); bound_url:[4096]u8; bound_parts:=[3]string.[prefix,"&transport_sha=",ifx args_count(a[..])==5 then args_at(a[..],4) else ""]; target:=ifx args_count(a[..])==5 then wc_cat(bound_url[..],bound_parts[..]) else prefix; c: [1] Cdp;
  if !cdp_launch(c[..], 640, 360, "aethyr-stream-walk-") { tool_errln(cdp_error(c[..])); return 1; }
  defer { cdp_close(c[..]); }
  if fault && !swf_install(c[..]) { return 1; }
  parameters: [8192] u8; j: [1] Jo; jo_start(j[..], parameters[..]); jo_obj(j[..]); jo_key(j[..], "url"); jo_str(j[..], target); jo_end(j[..]);
  if cdp_call(c[..], "Page.navigate", jo_text(j[..]), CDP_CALL_MS) < 0 { return 1; }
  deadline := proc_now_ms() + 30000; ready := false;
  while proc_now_ms() < deadline {
    result := wc_eval(c[..], "window.streamError||window.streamReady||false");
    if result == "true" { ready = true; break; }
    if result != "false" && result != "" { tool_errln(result); return 1; }
    proc_sleep(50);
  }
  if !ready { tool_errln(cdp_error(c[..])); return 1; }
  if fault {
    raw: [64] u8; item := jv_at(d[0], jv_get(d[0], 0, "resources"), ifx args_at(a[..], 3) == "--corrupt-pack" then 0 else 5);
    if jv_str(d[0], jv_get(d[0], item, "container_sha256"), raw[..]) != 64 { return 1; }
    return swf_run(c[..], args_at(a[..], 3), args_at(a[..], 2), cast(string) raw[..]);
  }
  if upload_failure {
    result := cdp_evaluate(c[..], "(async()=>{const original=GPUQueue.prototype.writeBuffer;let injected=false;GPUQueue.prototype.writeBuffer=function(buffer,offset,data,...rest){if(!injected&&buffer.size===24){injected=true;return original.call(this,buffer,buffer.size,data,...rest);}return original.call(this,buffer,offset,data,...rest);};try{const frames=[];for(let i=0;i<32;i++){frames.push(await streamWalk.step(62500000,0));await streamWalk.settle();}const records=frames.flatMap(f=>f.records),failed=records.filter(r=>+r[1]===0&&+r[6]===6),key=r=>r.slice(2,5).join('/');const staleReady=failed.some(f=>records.some(r=>+r[1]===2&&key(r)===key(f)));const retired=failed.every(f=>records.some(r=>+r[1]===1&&key(r)===key(f)&&+r[6]===0));const retried=failed.every(f=>records.some(r=>+r[1]===2&&r[2]===f[2]&&BigInt(r[3])>BigInt(f[3])&&r.slice(7,15).join('/')===f.slice(7,15).join('/')));const before=streamWalk.stats();return {injected,failed:failed.length,failedOwners:failed.map(r=>+r[2]),staleReady,retired,retried,frames:frames.map(f=>[f.frameNs,f.direction,f.tick,...f.position,f.active,f.drawn,f.updated,f.declared,f.cpu,f.gpuBytes,f.frameMs,f.records,f.stepDigests.join('')]),legs:[{cells:streamWalk.cells()}],records,allocations:frames.filter(f=>f.allocations.length).map(f=>({tick:f.tick,events:f.allocations})),stages:frames.flatMap(f=>f.stages),before,cleanup:await streamWalk.close(),profile:streamWalk.profile,adapter:streamWalk.adapter};}catch(e){return {error:String(e),stack:e.stack,stats:streamWalk.stats()};}finally{GPUQueue.prototype.writeBuffer=original;}})()");
    if result < 0 { tool_errln(cdp_error(c[..])); return 1; }
    doc := cdp_doc(c[..]); report: [262144] u8; jo_start(j[..], report[..]); jv_write(doc, result, j[..]);
    if j[0].bad || !fs_write(args_at(a[..], 2), jo_text(j[..])) { return 1; }
    ok := jv_bool(doc, jv_get(doc, result, "injected")) && jv_int(doc, jv_get(doc, result, "failed"), 0) == 1 && !jv_bool(doc, jv_get(doc, result, "staleReady")) && jv_bool(doc, jv_get(doc, result, "retired")) && jv_bool(doc, jv_get(doc, result, "retried"));
    owners := jv_get(doc, result, "failedOwners"); ok = ok && jv_len(doc, owners) == 1 && jv_int(doc, jv_at(doc, owners, 0), -1) == 1;
    before := jv_get(doc, result, "before"); ok = ok && jv_int(doc, jv_get(doc, before, "loadFailures"), -1) == 1 && jv_len(doc, jv_get(doc, before, "gpuErrors")) == 0;
    cleanup := jv_get(doc, result, "cleanup"); info := jv_get(doc, cleanup, "info");
    for field: [8] int.[8, 10, 11, 12, 13, 14, 22, 23] { if jv_int(doc, jv_at(doc, info, field), -1) != 0 { ok = false; } }
    if ok {ok=swf_transport(c[..],args_at(a[..],2));}
    print("Actual GPU validation failure retires its attempt before a new generation becomes ready: %\n", ok); return ifx ok then 0 else 1;
  }
  if recover {
    result := cdp_evaluate(c[..], "(async()=>{try{const app=streamWalk;for(let i=0;i<10;i++){await app.step(15625000,0);await app.settle();}const cells=app.cells(),before=await app.capture();const original=window.fetch;let network=0;window.fetch=()=>{network++;return Promise.reject(Error('source unavailable during device replacement'));};let recovery;try{recovery=await Promise.race([app.recover(),new Promise((_,r)=>setTimeout(()=>r(Error('GPU replacement exceeded 10 s')),10000))]);}finally{window.fetch=original;}const after=await app.capture(),samePixels=before.data===after.data,sameCells=JSON.stringify(cells)===JSON.stringify(app.cells());const digest=async data=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',Uint8Array.from(atob(data),c=>c.charCodeAt(0))))).map(x=>x.toString(16).padStart(2,'0')).join('');const beforeSHA=await digest(before.data),afterSHA=await digest(after.data);const frames=[];for(let i=0;i<8;i++){frames.push(await app.step(15625000,1));await app.settle();}return {recovery,samePixels,sameCells,beforeSHA,afterSHA,network,continued:frames.at(-1).position[2]>56,cleanup:await app.close(),adapter:app.adapter,profile:app.profile};}catch(e){return {error:String(e),stack:e.stack,stats:streamWalk.stats()};}})()");
    if result < 0 { tool_errln(cdp_error(c[..])); return 1; }
    doc := cdp_doc(c[..]); report: [65536] u8; jo_start(j[..], report[..]); jv_write(doc, result, j[..]);
    if j[0].bad || !fs_write(args_at(a[..], 2), jo_text(j[..])) { return 1; }
    ok := jv_bool(doc, jv_get(doc, result, "samePixels")) && jv_bool(doc, jv_get(doc, result, "sameCells")) && jv_bool(doc, jv_get(doc, result, "continued")) && jv_int(doc, jv_get(doc, result, "network"), -1) == 0;
    r := jv_get(doc, result, "recovery"); ok = ok && jv_int(doc, jv_get(doc, r, "epoch"), 0) == 2 && jv_int(doc, jv_get(doc, r, "uploaded"), 0) > 0;
    ok = ok && jv_int(doc, jv_get(doc, r, "uploaded"), -1) == jv_int(doc, jv_get(doc, r, "granted"), -2);
    elapsed := args_number(jv_raw(doc, jv_get(doc, r, "ms"))); if !elapsed.ok || elapsed.value < 0 || elapsed.value >= 10000 { ok = false; }
    before_hash: [64] u8; after_hash: [64] u8;
    if jv_str(doc, jv_get(doc, result, "beforeSHA"), before_hash[..]) != 64 || jv_str(doc, jv_get(doc, result, "afterSHA"), after_hash[..]) != 64 || cast(string) before_hash[..] != cast(string) after_hash[..] { ok = false; }
    for field: [10] int.[0, 8, 10, 12, 13, 14, 20, 21, 22, 23] { if jv_int(doc, jv_at(doc, jv_get(doc, r, "before"), field), -1) != jv_int(doc, jv_at(doc, jv_get(doc, r, "after"), field), -2) { ok = false; } }
    cleanup := jv_get(doc, result, "cleanup"); info := jv_get(doc, cleanup, "info");
    for field: [8] int.[8, 10, 11, 12, 13, 14, 22, 23] { if jv_int(doc, jv_at(doc, info, field), -1) != 0 { ok = false; } }
    if ok {ok=swf_transport(c[..],args_at(a[..],2));}
    print("Actual device replacement preserves pixels state and CPU owners without source requests: %\n", ok); return ifx ok then 0 else 1;
  }
  if cancel_stall {
    // Resource requests begin on the first paid frame, so install the
    // actual browser stream fault after startup and before that frame.
    script := "(()=>{const original=window.fetch;let held=false;window.fetch=async function(...args){const r=await original.apply(this,args);if(!held&&String(args[0]).endsWith('.raw')){held=true;const bytes=new Uint8Array(await r.arrayBuffer());window.streamHeldURL=String(args[0]);return new Response(new ReadableStream({start(c){c.enqueue(bytes);},cancel(){window.streamHeldCancelled=true;}}),{status:200});}return r;};return true;})()";
    if wc_eval(c[..], script) != "true" { return 1; }
    result := cdp_evaluate(c[..], "(async()=>{const frames=[];for(let i=0;i<16;i++){frames.push(await streamWalk.step(15625000,0));await new Promise(r=>setTimeout(r,10));}const before=streamWalk.stats();const cleanup=await Promise.race([streamWalk.close(),new Promise(r=>setTimeout(()=>r(null),5000))]);return {heldURL:window.streamHeldURL,cancelled:window.streamHeldCancelled===true,closed:cleanup!==null,before,cleanup,records:frames.flatMap(f=>f.records)};})()");
    if result < 0 { tool_errln(cdp_error(c[..])); return 1; }
    doc := cdp_doc(c[..]); report: [65536] u8; jo_start(j[..], report[..]); jv_write(doc, result, j[..]);
    if j[0].bad || !fs_write(args_at(a[..], 2), jo_text(j[..])) { return 1; }
    ok := jv_bool(doc, jv_get(doc, result, "closed")) && jv_bool(doc, jv_get(doc, result, "cancelled"));
    cleanup := jv_get(doc, result, "cleanup"); info := jv_get(doc, cleanup, "info");
    for field: [8] int.[8, 10, 11, 12, 13, 14, 22, 23] { if jv_int(doc, jv_at(doc, info, field), -1) != 0 { ok = false; } }
    transport := jv_get(doc, cleanup, "transport");
    for key: [5] string.["owners", "loading", "published", "readers", "sdkPending"] { if jv_int(doc, jv_get(doc, transport, key), -1) != 0 { ok = false; } }
    records := jv_get(doc, result, "records");
    for i: 0..<jv_len(doc, records) { r := jv_at(doc, records, i); if wc_parse(jv_raw(doc, jv_at(doc, r, 1))) == 2 && wc_parse(jv_raw(doc, jv_at(doc, r, 2))) == 5 { ok = false; } }
    print("Stalled complete-prefix stream cancelled and all owners drained: %\n", ok); return ifx ok then 0 else 1;
  }
  if wc_eval(c[..], "(()=>{const app=streamWalk;window.streamWalkPhysical=[];window.streamWalkStages=[];window.streamWalk={...app,async step(...args){const f=await app.step(...args);if(f.allocations.length)streamWalkPhysical.push({observedAfterTick:f.tick,events:f.allocations});streamWalkStages.push(...f.stages);return f;}};return true;})()") != "true" { return 1; }
  expression := ifx route then "(async()=>{try{const app=streamWalk,frames=[],legs=[];for(let i=0;i<6;i++){frames.push(await app.step(15625000,0));await app.settle();}const initial=app.cells();for(const direction of [1,-1]){for(let i=0;i<1600;i++){frames.push(await app.step(62500000,direction));if(i%20===0)await app.settle();}legs.push({last:frames.at(-1),cells:app.cells(),stats:app.stats()});}const before=app.stats(),last=frames.at(-1);if(!(legs[0].last.position[2]>704&&last.position[2]<64&&app.cells()[0][2]>initial[0][2]&&before.drawnCommands>0))throw Error('whole corridor/persistent return observation failed');if(frames.some(f=>f.declared>32768||f.active>4))throw Error('resident byte/actor cap exceeded');const samples=frames.map(f=>[f.frameNs,f.direction,f.tick,...f.position,f.active,f.drawn,f.updated,f.declared,f.cpu,f.gpuBytes,f.frameMs,f.records,f.stepDigests.join('')]);window.streamWalkObserved={frames:samples,before,last,legs,initial};return {ready:true,last,before,legs,adapter:app.adapter};}catch(e){return {error:String(e),stack:e.stack,stats:streamWalk.stats()};}})()" else "(async()=>{try{const app=streamWalk,frames=[];for(let i=0;i<6;i++){frames.push(await app.step(15625000,0));await app.settle();}for(let i=0;i<160;i++){frames.push(await app.step(62500000,1));if(i%20===0)await app.settle();}const before=app.stats();const last=frames.at(-1);if(!(last.position[2]>64&&before.drawnCommands>0&&before.info[15]>0))throw Error('actual walking/drawing/allocation observation failed');if(frames.some(f=>f.declared>32768))throw Error('resident byte cap exceeded');window.streamWalkObserved={frames,before,last};return {ready:true,last,before,adapter:app.adapter};}catch(e){return {error:String(e),stack:e.stack,stats:streamWalk.stats()};}})()";
  result := cdp_evaluate(c[..], expression); if result < 0 { tool_errln(cdp_error(c[..])); return 1; }
  report: [262144] u8; jo_start(j[..], report[..]); jv_write(cdp_doc(c[..]), result, j[..]);
  print("%\n", jo_text(j[..]));
  if !fs_write(args_at(a[..], 2), jo_text(j[..])) { return 1; }
  if jv_get(cdp_doc(c[..]), result, "error") >= 0 { return 1; }
  // Linux's headless NVIDIA canvas can be omitted from a compositor
  // screenshot. Read the actual owned GPU color target instead.
  result = cdp_evaluate(c[..], "streamWalk.capture()"); if result < 0 { tool_errln(cdp_error(c[..])); return 1; }
  capture := cdp_doc(c[..]); width := jv_int(capture, jv_get(capture, result, "width"), 0); height := jv_int(capture, jv_get(capture, result, "height"), 0);
  stride := jv_int(capture, jv_get(capture, result, "rowBytes"), 0); format_text: [64] u8;
  format_n := jv_str(capture, jv_get(capture, result, "format"), format_text[..]);
  format := ifx cast(string) format_text[0..<format_n] == "bgra8unorm" then 3 else ifx cast(string) format_text[0..<format_n] == "rgba8unorm" then 2 else -1;
  if format < 0 || width < 1 || height < 1 || width * height > 1048576 || stride < width * 4 || stride % 4 != 0 { return 1; }
  encoded: [8388608] u8; raw: [4194304] u8; pixels: [4194304] u8;
  encoded_n := jv_str(capture, jv_get(capture, result, "data"), encoded[..]);
  raw_n := b64_decode(cast(string) encoded[0..<encoded_n], raw[..]); if raw_n != stride * height { return 1; }
  distinct := false;
  for y: 0..<height { for x: 0..<width { for channel: 0..<4 {
    value := cast(u8) (comparison.cf_value(raw[0..<raw_n], format, y * (stride / 4) + x, channel) * 255 + 0.5);
    pixels[(y * width + x) * 4 + channel] = value; if value != pixels[channel] { distinct = true; }
  } } }
  if !distinct { tool_errln("actual GPU readback is a flat frame"); return 1; }
  z: [1] PiZ; filtered: [4198400] u8; shot: [8388608] u8;
  shot_n := pi_png(pi_img(pixels[..], width, height, 4), z[..], filtered[..], shot[..]);
  path: [4096] u8; suffix := [2] string.[args_at(a[..], 2), ".png"];
  if shot_n < 1 || !fs_write(wc_cat(path[..], suffix[..]), cast(string) shot[0..<shot_n]) { return 1; }
  result = cdp_evaluate(c[..], "(async()=>{try{const cleanup=window.streamWalkCleanup=await streamWalk.close();return {profile:streamWalk.profile,adapter:streamWalk.adapter,cleanup,frames:streamWalkObserved.frames,before:streamWalkObserved.before,last:streamWalkObserved.last,legs:streamWalkObserved.legs,initial:streamWalkObserved.initial};}catch(e){return {error:String(e),stack:e.stack};}})()");
  if result < 0 { tool_errln(cdp_error(c[..])); return 1; }
  large: [4194304] u8; jo_start(j[..], large[..]); jv_write(cdp_doc(c[..]), result, j[..]);
  if j[0].bad || !fs_write(args_at(a[..], 2), jo_text(j[..])) || jv_get(cdp_doc(c[..]),result,"error")>=0 { return 1; }
  for part: 0..<3 {
    expression = ifx part == 0 then "[...streamWalkPhysical,...streamWalkCleanup.closingFrames.filter(f=>f.allocations.length).map(f=>({observedAfterTick:f.tick,events:f.allocations}))]" else ifx part == 1 then "[...streamWalkStages,...streamWalkCleanup.closingFrames.flatMap(f=>f.stages)]" else "streamWalk.transportBinding?.()??null";
    result = cdp_evaluate(c[..], expression); if result < 0 { return 1; }
    jo_start(j[..], report[..]); jv_write(cdp_doc(c[..]), result, j[..]); suffix = [2] string.[args_at(a[..], 2), ifx part == 0 then ".allocations.json" else ifx part == 1 then ".stages.json" else ".transport.json"];
    if j[0].bad || !fs_write(wc_cat(path[..], suffix[..]), jo_text(j[..])) { return 1; }
  }
  print("PASS actual HTTP sources, shared cell/walker, WebGPU draw and physical cleanup\n"); return 0;
}
