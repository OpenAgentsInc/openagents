// Build and run the native CPU/allocator replay observer. Product logic and
// orchestration are Coax; the linked C file performs SDK memory effects.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
swnt_run :: (argv: [] string, save: string) -> bool {
  out: [33554432] u8; err: [65536] u8; r := proc_run(argv, 180000, out[..], err[..]);
  if r.started != 0 || r.status != 0 || r.cut || r.timed_out {
    tool_errln(cast(string) err[0..<r.err_n]); tool_errln(cast(string) out[0..<r.out_n]); return false;
  }
  if save.count > 0 { return fs_write(save, cast(string) out[0..<r.out_n]); }
  print("%", cast(string) out[0..<r.out_n]); return true;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) < 3 || args_count(a[..]) > 4 { tool_errln("usage: stream-walk-native SCENE_DIR BROWSER_TRACE_JSON NEW_OUTPUT_DIR [--sanitize]"); return 2; }
  sanitize := args_count(a[..]) == 4;
  if sanitize && args_at(a[..], 3) != "--sanitize" { return 2; }
  dir := args_at(a[..], 2); paths: [5] [4096] u8;
  if fs_exists(dir) { tool_errln("native receipt directory must be new"); return 2; }
  if !fs_mkdir(dir) { return 1; } dir = fs_realpath(dir, paths[0][..]);
  source := fs_join(dir, "replay.c", paths[1][..]); header := fs_join(dir, "stream-walk.h", paths[2][..]); exe := fs_join(dir, "replay", paths[3][..]); report := fs_join(dir, "replay.json", paths[4][..]);
  emit := [6] string.["coax/bin/coax", "c", "metaverse-engine/host/tests/stream-walk-replay.coax", "--library", "--header", header];
  if !swnt_run(emit[..], source) { return 1; }
  base := [20] string.["gcc", "-std=gnu11", "-O2", "-ffp-contract=off", "-fno-fast-math", "-fno-builtin-pow", "-I", dir, "-I", "coax/platform", source,
    "metaverse-engine/host/tests/stream-walk-face.c", "coax/platform/tool-native.c", "coax/platform/process-native.c", "coax/platform/store-file-native.c", "coax/platform/read-file-native.c", "-lpthread", "-lm", "-o", exe];
  cc: [24] string; for item, i: base { cc[i] = item; } count := 20;
  if sanitize { cc[2] = "-O1"; cc[20] = "-g"; cc[21] = "-fsanitize=address,undefined"; cc[22] = "-fno-omit-frame-pointer"; cc[23] = "-fno-sanitize-recover=all"; count = 24; }
  if !swnt_run(cc[0..<count], "") { return 1; }
  run := [4] string.[exe, args_at(a[..], 0), args_at(a[..], 1), report];
  if !swnt_run(run[..], "") { return 1; }
  print("Native replay receipt: %\n", report); return 0;
}
