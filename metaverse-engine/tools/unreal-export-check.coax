// Reads an export bundle back with the Metaverse Engine's own glTF reader (metaverse-engine/anim/gltf-access.coax, not
// the writer's code) and checks world.glb against manifest.json: its SHA-256, the mesh count,
// each mesh's vertex and triangle counts and bounds, every index in range, and the totals.
// docs/unreal/2026-11-12-aethyr-to-unreal-exporter-spec.md, step 1 (GitHub #13400).
//   coax/web/tool.sh metaverse-engine/tools/unreal-export-check.coax BUNDLE_DIR
// tool.sh: stack-gib 1
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/crypto/sha256-memory.coax";
#load "../anim/import-container.coax";
#load "../anim/gltf-access.coax";

// A manifest number ("-12.500000") in millionths.
xc_micro :: (raw: string) -> int {
  neg := raw.count > 0 && raw[0] == '-'; i := ifx neg then 1 else 0; whole := 0; frac := 0; digits := 0; dot := false;
  while i < raw.count {
    c := raw[i]; i += 1;
    if c == '.' { dot = true; continue; }
    if c < '0' || c > '9' { break; }
    if !dot { whole = whole * 10 + cast(int) (c - '0'); } else if digits < 6 { frac = frac * 10 + cast(int) (c - '0'); digits += 1; }
  }
  while digits < 6 { frac *= 10; digits += 1; }
  v := whole * 1000000 + frac;
  return ifx neg then -v else v;
}
xc_near :: (v: f32, raw: string) -> bool {
  want := xc_micro(raw); got := cast(int) floor(cast(f64) v * 1000000 + 0.5);
  d := got - want; if d < 0 { d = -d; }
  return d <= 2 + (ifx want < 0 then -want else want) / 1000000;   // six decimals of a 32-bit float
}
xc_fail :: (why: string, name: string) -> int #effects(all) { print("unreal-export-check: FAIL % %\n", why, name); return 1; }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { print("usage: unreal-export-check BUNDLE_DIR\n"); return 2; }
  dir := args_at(a[..], 0); path: [4096] u8;
  mtext: [1048576] u8; mn := fs_read(fs_join(dir, "manifest.json", path[..]), mtext[..]);
  if mn < 1 { return xc_fail("cannot read", "manifest.json"); }
  md: [1] Jv; mnodes: [65536] JvNode;
  if !jv_parse(md[..], cast(string) mtext[0..<mn], mnodes[..]) { return xc_fail("not JSON", "manifest.json"); }
  m := md[0];
  if jv_int(m, jv_get(m, 0, "aexport"), -1) != 1 { return xc_fail("unknown version", "manifest.json aexport"); }
  mw := jv_get(m, 0, "world"); mgroups := jv_get(m, mw, "groups");

  glb: [8388608] u8; gn := fs_read(fs_join(dir, "world.glb", path[..]), glb[..]);
  if gn < 1 { return xc_fail("cannot read", "world.glb"); }
  if gn != jv_int(m, jv_get(m, mw, "bytes"), -1) { return xc_fail("size differs from the manifest", "world.glb"); }
  digest: [32] u8; state: [SHA_STATE_BYTES] u8; ok := sha256_init(state[..]) == SHA_OK; at := 0;
  while ok && at < gn { n := gn - at; if n > 65536 { n = 65536; } ok = sha256_update(state[..], glb[at..<at + n]) == SHA_OK; at += n; }
  ok = ok && sha256_final(state[..], digest[..]) == SHA_OK;
  want: [80] u8; wn := jv_str(m, jv_get(m, mw, "sha256"), want[..]);
  if !ok || wn != 64 { return xc_fail("no hash", "world.glb"); }
  for b, k: digest {
    h := cast(int) b >> 4; l := cast(int) b & 15;
    if want[k * 2] != cast,trunc(u8) (ifx h < 10 then 48 + h else 87 + h) || want[k * 2 + 1] != cast,trunc(u8) (ifx l < 10 then 48 + l else 87 + l) { return xc_fail("SHA-256 differs from the manifest", "world.glb"); }
  }

  c := ai_glb(glb[0..<gn]);
  if !c.ok { return xc_fail("not a glTF binary", "world.glb"); }
  g: [1] AgFile; gd: [1] Jv; gnodes: [65536] JvNode;
  if !jv_parse(gd[..], cast(string) glb[c.json_first..<c.json_first + c.json_size], gnodes[..]) { return xc_fail("JSON chunk does not parse", "world.glb"); }
  g[0].d = gd[0]; g[0].binary = glb[c.binary_first..<c.binary_first + c.binary_size]; g[0].bad = false;
  meshes := jv_len(g[0].d, ag_get(g[..], 0, "meshes"));
  if meshes != jv_len(m, mgroups) { return xc_fail("mesh count differs from the manifest", "world.glb"); }
  triangles := 0; vertices := 0; lo: [3] f32; hi: [3] f32; name: [64] u8; mname: [64] u8;
  for k: 0..<meshes {
    mesh := ag_top(g[..], "meshes", k); mg := jv_at(m, mgroups, k);
    nn := jv_str(g[0].d, ag_get(g[..], mesh, "name"), name[..]); mm := jv_str(m, jv_get(m, mg, "name"), mname[..]);
    label := cast(string) name[0..<(ifx nn > 0 then nn else 0)];
    if nn != mm || nn < 1 { return xc_fail("name differs from the manifest", label); }
    for i: 0..<nn { if name[i] != mname[i] { return xc_fail("name differs from the manifest", label); } }
    prim := jv_at(g[0].d, ag_get(g[..], mesh, "primitives"), 0); attrs := ag_get(g[..], prim, "attributes");
    pos := ag_accessor(g[..], ag_int(g[..], attrs, "POSITION", -1)); nor := ag_accessor(g[..], ag_int(g[..], attrs, "NORMAL", -1));
    col := ag_accessor(g[..], ag_int(g[..], attrs, "COLOR_0", -1)); uv := ag_accessor(g[..], ag_int(g[..], attrs, "TEXCOORD_0", -1));
    idx := ag_accessor(g[..], ag_int(g[..], prim, "indices", -1));
    if !pos.ok || !nor.ok || !col.ok || !uv.ok || !idx.ok || g[0].bad { return xc_fail("an accessor does not read", label); }
    if pos.components != 3 || nor.components != 3 || col.components != 4 || uv.components != 2 || nor.count != pos.count || col.count != pos.count || uv.count != pos.count { return xc_fail("attribute shapes differ", label); }
    if pos.count != jv_int(m, jv_get(m, mg, "vertices"), -1) || idx.count != jv_int(m, jv_get(m, mg, "triangles"), -1) * 3 { return xc_fail("counts differ from the manifest", label); }
    glo: [3] f32; ghi: [3] f32;
    for v: 0..<pos.count { for e: 0..<3 {
      x := ag_value(g[..], pos, v, e);
      if v == 0 || x < glo[e] { glo[e] = x; }
      if v == 0 || x > ghi[e] { ghi[e] = x; }
    } }
    mlo := jv_get(m, mg, "min"); mhi := jv_get(m, mg, "max");
    for e: 0..<3 {
      if !xc_near(glo[e], jv_raw(m, jv_at(m, mlo, e))) || !xc_near(ghi[e], jv_raw(m, jv_at(m, mhi, e))) { return xc_fail("bounds differ from the manifest", label); }
      if k == 0 || glo[e] < lo[e] { lo[e] = glo[e]; }
      if k == 0 || ghi[e] > hi[e] { hi[e] = ghi[e]; }
    }
    for i: 0..<idx.count { v := cast(int) ag_value(g[..], idx, i, 0); if v < 0 || v >= pos.count { return xc_fail("an index is out of range", label); } }
    for v: 0..<pos.count {
      nx := ag_value(g[..], nor, v, 0); ny := ag_value(g[..], nor, v, 1); nz := ag_value(g[..], nor, v, 2); sq := nx * nx + ny * ny + nz * nz;
      if sq < 0.98 || sq > 1.02 { return xc_fail("a normal is not unit length", label); }
      for e: 0..<4 { x := ag_value(g[..], col, v, e); if x < 0 || x > 1 { return xc_fail("a colour is out of range", label); } }
    }
    triangles += idx.count / 3; vertices += pos.count;
  }
  if triangles != jv_int(m, jv_get(m, mw, "triangles"), -1) || vertices != jv_int(m, jv_get(m, mw, "vertices"), -1) { return xc_fail("totals differ from the manifest", "world.glb"); }
  wlo := jv_get(m, mw, "min"); whi := jv_get(m, mw, "max");
  for e: 0..<3 { if !xc_near(lo[e], jv_raw(m, jv_at(m, wlo, e))) || !xc_near(hi[e], jv_raw(m, jv_at(m, whi, e))) { return xc_fail("world bounds differ from the manifest", "world.glb"); } }
  print("unreal-export-check: ok, % meshes, % triangles, % vertices, bounds (% % %) to (% % %)\n", meshes, triangles, vertices, lo[0], lo[1], lo[2], hi[0], hi[1], hi[2]);
  return 0;
}
