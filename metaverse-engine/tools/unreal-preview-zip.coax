// The bounded ZIP subset used by a Windows IoStore shipping export. Inspect
// the central directory first. Only the selected container members are ever
// decompressed, and the caller chooses every path written to disk.
#load "../../coax/lib/image/png.coax";

UZ_ARCHIVE_LIMIT :: 1073741824; // 1 GiB
UZ_MEMBER_LIMIT :: 268435456;   // 256 MiB, compressed and expanded
UZ_DIRECTORY_LIMIT :: 4194304;
UZ_ENTRIES :: 4096;
UZ_NAME :: 512;

UzEntry :: struct {
  name: [UZ_NAME] u8; n: int; directory: bool;
  offset: int; compressed: int; bytes: int; flags: int; method: int; crc: int;
}
UzCatalog :: struct { entries: [UZ_ENTRIES] UzEntry; order: [UZ_ENTRIES] int; n: int; }
UzEnd :: struct { entries: int; at: int; bytes: int; error: string; }
UzIo :: struct { toc: int = -1; data: int = -1; global_toc: int = -1; global_data: int = -1; error: string; }

uz_le :: (b: [] u8, at: int, n: int) -> int {
  v := 0;
  for i: 0..<n { v |= cast(int) b[at + i] << (8 * i); }
  return v;
}
uz_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
uz_suffix :: (s: string, suffix: string) -> bool {
  return s.count >= suffix.count && s[s.count - suffix.count..<s.count] == suffix;
}
uz_name :: (z: [] UzCatalog, i: int) -> string { return cast(string) z[0].entries[i].name[0..<z[0].entries[i].n]; }

// ASCII names only in this profile, which also rules out Unicode aliases
// when unpacking on a filesystem that folds case or normalizes names.
uz_path :: (raw: [] u8, out: [] u8) -> int {
  if raw.count == 0 || raw.count > out.count { return -1; }
  from := 0;
  for i: 0..<raw.count + 1 {
    end := i == raw.count;
    c := ifx end then '/' else ifx raw[i] == '\\' then '/' else raw[i];
    if c == '/' {
      if end && from == i && i > 0 { return i - 1; } // a directory entry
      if i == from || out[from] == ' ' || out[i - 1] == ' ' || out[i - 1] == '.' { return -1; }
      from = i + 1;
    } else if c < 32 || c > 126 || c == ':' || c == '"' || c == '<' || c == '>' || c == '|' || c == '?' || c == '*' {
      return -1;
    }
    if !end { out[i] = c; }
  }
  return raw.count;
}

uz_end :: (tail: [] u8, archive_bytes: int) -> UzEnd {
  if tail.count < 22 { return UzEnd.{error = "not a ZIP: missing end of central directory"}; }
  i := tail.count - 22;
  while i >= 0 {
    if uz_le(tail, i, 4) == 0x06054b50 && i + 22 + uz_le(tail, i + 20, 2) == tail.count {
      n := uz_le(tail, i + 10, 2); size := uz_le(tail, i + 12, 4); at := uz_le(tail, i + 16, 4);
      if uz_le(tail, i + 4, 4) != 0 || uz_le(tail, i + 8, 2) != n { return UzEnd.{error = "split ZIP archives are unsupported"}; }
      if n == 65535 || size == 0xffffffff || at == 0xffffffff { return UzEnd.{error = "ZIP64 archives are unsupported"}; }
      if n > UZ_ENTRIES || size > UZ_DIRECTORY_LIMIT { return UzEnd.{error = "ZIP directory exceeds 4096 entries or 4 MiB"}; }
      if at + size != archive_bytes - tail.count + i { return UzEnd.{error = "invalid ZIP central directory range"}; }
      return UzEnd.{entries = n, at = at, bytes = size};
    }
    i -= 1;
  }
  return UzEnd.{error = "not a ZIP: missing end of central directory"};
}

// Case-folded ordering puts duplicate paths and nested paths together.
uz_compare :: (a: string, b: string) -> int {
  n := ifx a.count < b.count then a.count else b.count;
  for i: 0..<n {
    l := uz_lower(a[i]); r := uz_lower(b[i]);
    if l != r { return cast(int) l - cast(int) r; }
  }
  return a.count - b.count;
}
uz_catalog :: (dir: [] u8, end: UzEnd, z: [] UzCatalog) -> string {
  z[0].n = end.entries;
  at := 0;
  for i: 0..<end.entries {
    if at + 46 > dir.count || uz_le(dir, at, 4) != 0x02014b50 { return "invalid ZIP central directory entry"; }
    name_n := uz_le(dir, at + 28, 2);
    next := at + 46 + name_n + uz_le(dir, at + 30, 2) + uz_le(dir, at + 32, 2);
    if next > dir.count { return "truncated ZIP central directory entry"; }
    if uz_le(dir, at + 34, 2) != 0 { return "split or ZIP64 entry is unsupported"; }
    raw := dir[at + 46..<at + 46 + name_n];
    e := z[0].entries[i..<i + 1];
    n := uz_path(raw, e[0].name[..]);
    if n < 0 { return "unsafe ZIP member path: use relative ASCII paths up to 512 bytes with no dot components"; }
    e[0].n = n;
    e[0].directory = n < raw.count;
    mode := uz_le(dir, at + 40, 2) & 0xf000;
    dos := uz_le(dir, at + 38, 2);
    if (dos & 0x400) != 0 || (mode != 0 && mode != (ifx e[0].directory then 0x4000 else 0x8000)) {
      return "ZIP contains a link, reparse point, or non-regular member";
    }
    e[0].offset = uz_le(dir, at + 42, 4);
    e[0].compressed = uz_le(dir, at + 20, 4);
    e[0].bytes = uz_le(dir, at + 24, 4);
    e[0].method = uz_le(dir, at + 10, 2);
    e[0].flags = uz_le(dir, at + 8, 2);
    e[0].crc = uz_le(dir, at + 16, 4);
    if e[0].bytes == 0xffffffff || e[0].offset + 30 + e[0].compressed > end.at { return "ZIP64 or invalid ZIP local member range"; }
    j := i;
    name := uz_name(z, i);
    while j > 0 && uz_compare(name, uz_name(z, z[0].order[j - 1])) < 0 {
      z[0].order[j] = z[0].order[j - 1]; j -= 1;
    }
    z[0].order[j] = i;
    at = next;
  }
  if at != dir.count { return "extra bytes in ZIP central directory"; }
  for i: 1..<end.entries {
    if uz_compare(uz_name(z, z[0].order[i - 1]), uz_name(z, z[0].order[i])) == 0 { return "duplicate ZIP member path after slash and case normalization"; }
  }
  return "";
}

uz_lookup :: (z: [] UzCatalog, path: string) -> int {
  for i: 0..<z[0].n { if !z[0].entries[i].directory && uz_name(z, i) == path { return i; } }
  return -1;
}
uz_companion :: (z: [] UzCatalog, i: int) -> int {
  b: [UZ_NAME] u8;
  path := uz_name(z, i); n := path.count;
  for k: 0..<n - 4 { b[k] = path[k]; }
  for c, k: "ucas" { b[n - 4 + k] = c; }
  return uz_lookup(z, cast(string) b[0..<n]);
}
uz_io :: (z: [] UzCatalog) -> UzIo {
  r: UzIo;
  bool_source := false; bool_pak := false;
  for i: 0..<z[0].n {
    if z[0].entries[i].directory { continue; }
    name := uz_name(z, i);
    if uz_suffix(name, ".uproject") { bool_source = true; }
    if uz_suffix(name, ".pak") { bool_pak = true; }
    if !uz_suffix(name, ".utoc") { continue; }
    if fs_base(name) == "global.utoc" {
      if r.global_toc >= 0 { return UzIo.{error = "more than one global IoStore table"}; }
      r.global_toc = i;
    } else {
      if r.toc >= 0 { return UzIo.{error = "multiple game IoStore containers are unsupported in this preview"}; }
      r.toc = i;
    }
  }
  if bool_source { return UzIo.{error = "source project ZIP: this preview takes a cooked Windows IoStore build"}; }
  if r.toc < 0 {
    return UzIo.{error = ifx bool_pak then "Pak-only shipping ZIP is unsupported: it needs a game .utoc and .ucas pair" else "no game IoStore .utoc found in the ZIP"};
  }
  r.data = uz_companion(z, r.toc);
  if r.data < 0 { return UzIo.{error = "the game .utoc has no matching .ucas in the ZIP"}; }
  if r.global_toc >= 0 {
    if fs_dir(uz_name(z, r.toc)) != fs_dir(uz_name(z, r.global_toc)) { return UzIo.{error = "the global IoStore pair is not beside the game container"}; }
    r.global_data = uz_companion(z, r.global_toc);
    if r.global_data < 0 { return UzIo.{error = "global.utoc has no matching global.ucas in the ZIP"}; }
  }
  for i: 0..<z[0].n {
    if i != r.data && i != r.global_data && !z[0].entries[i].directory && uz_suffix(uz_name(z, i), ".ucas") {
      return UzIo.{error = "extra IoStore .ucas data, such as a split container, is unsupported"};
    }
  }
  return r;
}

uz_data_at :: (head: [] u8, e: UzEntry, dir_at: int) -> int {
  if head.count < 30 || uz_le(head, 0, 4) != 0x04034b50 { return -1; }
  if uz_le(head, 6, 2) != e.flags || uz_le(head, 8, 2) != e.method { return -1; }
  if (e.flags & 8) == 0 && (uz_le(head, 14, 4) != e.crc || uz_le(head, 18, 4) != e.compressed || uz_le(head, 22, 4) != e.bytes) { return -1; }
  at := e.offset + 30 + uz_le(head, 26, 2) + uz_le(head, 28, 2);
  return ifx at + e.compressed <= dir_at then at else -1;
}
uz_decode :: (raw: [] u8, data: [] u8, e: UzEntry) -> bool {
  if e.method == 0 {
    if data.count != raw.count { return false; }
    for c, i: raw { data[i] = c; }
  } else if e.method != 8 || inflate(raw, data) != data.count { return false; }
  return png_crc(data) == e.crc;
}

uz_toc_error :: (b: [] u8) -> string {
  if b.count < 144 || cast(string) b[0..<16] != "-==--==--==--==-" { return "not an IoStore table"; }
  if b[16] != 8 || uz_le(b, 20, 4) != 144 { return "unsupported IoStore header (expected version 8, UE 5.9 profile)"; }
  if uz_le(b, 52, 4) != 1 { return "partitioned IoStore containers are unsupported"; }
  if (b[80] & 6) != 0 { return "encrypted or signed IoStore containers are unsupported"; }
  if (b[80] & 0xf0) != 0 { return "unsupported IoStore container flags"; }
  return "";
}
