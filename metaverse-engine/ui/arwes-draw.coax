// The HUD's side of the ARWES specimens: the display list arwes-paint.coax
// paints, written as the HUD's twelve-float stroke/atlas records (modes 5, 6
// and 7 add radial, solid rectangle and filled circle primitives in
// demos/hud/gpu.coax). The specimens are drawn once, in arwes-paint.coax;
// openagents.com/components draws the same primitives with the component
// shader. License and source mappings: arwes/LICENSE and arwes/SOURCES.md.
// No DOM/SVG/Canvas2D runtime.
#load "draw.coax";
#load "arwes-paint.coax";

#test "Arwes GPU primitives refuse short buffers without publishing partial records" {
  out:[144]f32;p:=HdPen.{d=2,top=0,bottom=400};b:=HudBox.{x=10,y=20,width=100,height=80};
  c:=AxColor.{r=1,g=1,b=1,a=0.5};
  #assert aw_quad(out[0..<60],0,b,60,60,20,c,p,5)==0 && out[0]==0;
  #assert aw_quad(out[..],0,b,60,60,20,c,p,5)==6 && out[11]==5 && out[6]==0.5;
  #assert out[0]==20 && out[1]==40 && out[4]==40;
}
#test "drawn source paths and particles stay bounded on a tiny consumer buffer" {
  out:[1440]f32;p:=HdPen.{d=1,cyan=true,top=0,bottom=500};b:=HudBox.{x=10,y=20,width=240,height=140};
  t:[1]AwTestPaint;w:[1]AwPaint;
  for kind:0..<14 {
    aw_test_paint(t[..],w[..]);aw_hud_inks(w[..],p);
    aw_specimen(w[..],kind,b,aw_test_spec(true,2));
    n:=aw_hud(w[..],out[..],0,p);
    #assert n>=0 && n<=120 && n%6==0;
  }
}
#test "the HUD's inks are its pen's, so the records keep the HUD's colours" {
  t:[1]AwTestPaint;w:[1]AwPaint;
  aw_test_paint(t[..],w[..]);aw_hud_inks(w[..],HdPen.{d=1,cyan=true,top=0,bottom=500});
  k:=hd_ink(HdPen.{d=1,cyan=true,top=0,bottom=500},2);
  #assert w[0].ink[2].r==k.red && w[0].ink[2].b==k.blue && w[0].cyan;
  aw_hud_inks(w[..],HdPen.{d=1,top=0,bottom=500});
  #assert !w[0].cyan && w[0].ink[2].r==HUD_GREY_WHITE;
}
aw_color :: (p:HdPen,kind:int,alpha:f32)->AxColor {
  k:=hd_ink(p,kind);return AxColor.{r=k.red,g=k.green,b=k.blue,a=alpha};
}
// b is a clipped rectangle; cx/cy/radius retain the original radial origin.
aw_quad :: (out:[]f32,at:int,b:HudBox,cx:f32,cy:f32,radius:f32,c:AxColor,p:HdPen,mode:f32)->int {
  if at<0 || (at+6)*12>out.count || b.width<=0 || b.height<=0 {return at;}
  top:=ax_max(b.y,p.top);bottom:=ax_min(b.y+b.height,p.bottom);if bottom<=top {return at;}
  xs:=[6]f32.[b.x,b.x+b.width,b.x+b.width,b.x,b.x+b.width,b.x];
  ys:=[6]f32.[top,top,bottom,top,bottom,bottom];
  for i:0..<6 {o:=(at+i)*12;out[o]=xs[i]*p.d;out[o+1]=ys[i]*p.d;
    out[o+2]=(xs[i]-cx)*p.d;out[o+3]=(ys[i]-cy)*p.d;out[o+4]=radius*p.d;out[o+5]=0;
    out[o+6]=c.a;out[o+7]=0;out[o+8]=c.r;out[o+9]=c.g;out[o+10]=c.b;out[o+11]=mode;}
  return at+6;
}
aw_disc :: (out:[]f32,at:int,b:HudBox,cx:f32,cy:f32,r:f32,c:AxColor,p:HdPen,soft:bool)->int {
  left:=ax_max(b.x,cx-r);right:=ax_min(b.x+b.width,cx+r);top:=ax_max(b.y,cy-r);bottom:=ax_min(b.y+b.height,cy+r);
  return aw_quad(out,at,HudBox.{x=left,y=top,width=right-left,height=bottom-top},cx,cy,r,c,p,ifx soft then 5.0f32 else 7.0f32);
}
aw_clip_line :: (a:HudCoord,b:HudCoord,box:HudBox)->HudBox {
  low:=0.0f32;high:=1.0f32;dx:=b.x-a.x;dy:=b.y-a.y;empty:HudBox;
  if dx==0 {if a.x<box.x || a.x>box.x+box.width {return empty;}}
  else {start:=(box.x-a.x)/dx;end:=(box.x+box.width-a.x)/dx;low=ax_max(low,ax_min(start,end));high=ax_min(high,ax_max(start,end));}
  if dy==0 {if a.y<box.y || a.y>box.y+box.height {return empty;}}
  else {start:=(box.y-a.y)/dy;end:=(box.y+box.height-a.y)/dy;low=ax_max(low,ax_min(start,end));high=ax_min(high,ax_max(start,end));}
  if high<=low {return empty;}return HudBox.{x=a.x+dx*low,y=a.y+dy*low,width=dx*(high-low),height=dy*(high-low)};
}
aw_stroke :: (out:[]f32,at:int,a:HudCoord,b:HudCoord,box:HudBox,p:HdPen,kind:int,alpha:f32,stroke:f32)->int {
  clip:=box;top:=ax_max(box.y,p.top);bottom:=ax_min(box.y+box.height,p.bottom);clip.y=top;clip.height=bottom-top;
  if clip.height<=0 {return at;}r:=aw_clip_line(a,b,clip);if r.width==0 && r.height==0 {return at;}
  k:=hd_ink(p,kind);
  if lit(out,at,r.x*p.d,r.y*p.d,(r.x+r.width)*p.d,(r.y+r.height)*p.d,ax_max(0.4,stroke*0.5)*p.d,alpha,1.5*p.d,k.red,k.green,k.blue,0) {return at+6;}return at;
}
// Even/odd scan conversion preserves concave frame fills without a fan that
// covers clipped corners. Bounded rows are at most two logical points apart.
aw_fill :: (out:[]f32,at:int,points:[]AfPoint,box:HudBox,p:HdPen,kind:int,alpha:f32)->int {
  if points.count<3 {return at;}v:=at;rows:=cast(int)(-floor(-box.height/2));if rows>256 {rows=256;}if rows<1 {return at;}
  step:=box.height/cast(f32)rows;
  for row:0..<rows {
    y:=box.y+(cast(f32)row+0.5)*step;cross:[256]f32;n:=0;
    for i:0..<points.count {j:=(i+1)%points.count;a:=points[i];b:=points[j];
      if (a.y<=y && b.y>y) || (b.y<=y && a.y>y) {if n<256 {cross[n]=a.x+(y-a.y)*(b.x-a.x)/(b.y-a.y);n+=1;}}
    }
    for i:0..<n {for j:i+1..<n {if cross[j]<cross[i] {tmp:=cross[i];cross[i]=cross[j];cross[j]=tmp;}}}
    i:=0;while i+1<n {
      left:=ax_max(box.x,cross[i]);right:=ax_min(box.x+box.width,cross[i+1]);
      v=aw_quad(out,v,HudBox.{x=left,y=y-step*0.5,width=right-left,height=step},0,0,0,aw_color(p,kind,alpha),p,6);i+=2;
    }
  }return v;
}

// The pen's inks, as the specimens paint with them: the records then carry
// exactly the HUD's colours (hd_ink).
aw_hud_inks :: (w:[]AwPaint,p:HdPen) {
  for kind:0..<4 {k:=hd_ink(p,kind);w[0].ink[kind]=Rgba.{r=k.red,g=k.green,b=k.blue,a=1};}
  w[0].cyan=p.cyan;
}
aw_hud_color :: (p:HdPen,q:Prim)->AxColor {
  if q.id<0 {return AxColor.{r=q.fill.r,g=q.fill.g,b=q.fill.b,a=q.fill.a};}
  return aw_color(p,q.id,q.fill.a);
}
// The specimens' primitives (arwes-paint.coax) as twelve-float records at
// at, with the pen p. Returns the record count so far.
aw_hud :: (w:[]AwPaint,out:[]f32,at:int,p:HdPen)->int {
  v:=at;clip:HudBox;points:[256]AfPoint;
  for k:0..<w[0].n {
    q:=w[0].list[k];
    if q.kind==PRIM_CLIP {if q.on {clip=HudBox.{x=q.x,y=q.y,width=q.w,height=q.h};}continue;}
    if q.kind==PRIM_LINE {
      if q.c==0 {v=aw_stroke(out,v,HudCoord.{x=q.x,y=q.y},HudCoord.{x=q.a,y=q.b},clip,p,q.id,q.fill.a,q.border);}
      else {v=hd_line(out,v,q.x,q.y,q.a,q.b,p,q.id,q.fill.a);}
    } else if q.kind==PRIM_BOX {v=aw_quad(out,v,HudBox.{x=q.x,y=q.y,width=q.w,height=q.h},0,0,0,aw_hud_color(p,q),p,6);}
    else if q.kind==PRIM_SHADOW {v=aw_disc(out,v,clip,q.x,q.y,q.radius,aw_hud_color(p,q),p,q.c>0);}
    else if q.kind==PRIM_POLY {
      m:=0;j:=0;while j+1<q.pts.count && m<256 {points[m]=AfPoint.{x=q.pts[j],y=q.pts[j+1]};m+=1;j+=2;}
      v=aw_fill(out,v,points[0..<m],clip,p,q.id,q.fill.a);
    } else if q.kind==PRIM_TEXT {
      if q.on {
        ink:=hd_ink(p,q.off);ink.scale=1;width:=ink_width(q.text,q.c,0.22,0.72,ink);
        v=hd_text_fit(out,v,q.text,q.a-width*0.5,q.b,q.c,q.d,p,q.off);
      } else {v=hd_text_fit(out,v,q.text,q.a,q.b,q.c,q.d,p,q.off);}
    }
  }
  return v;
}
