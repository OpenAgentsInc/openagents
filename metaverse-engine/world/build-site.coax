// Staged construction (engine): a structure is built in stages, and each stage adds parts. A part
// is a form (a pole, a wall along a line or an arc, a roof slope, a slab...) made of a material
// (bark poles, woven withies, clay daub, fieldstone, dressed stone, reed thatch, leafy boughs...).
// Drawing a structure at stage k draws every part of stages 1 to k, so a half-built hut looks
// half-built. Parts are authored in the building's own frame (front +z, the ground at y 0) and
// placed with metaverse-engine/world/building.coax's BuildingFrame, turned in quarters.
//
// This file is what the room and the walker need: the parts and their colliders. A collider
// matches what you see: a woven or daubed wall blocks you, the posts of a bare frame block only
// where each post stands, so you walk between them, and a low roof slope blocks where it comes
// down below your head. Nothing above head height is a collider. The meshes (the withies, the
// thatch courses, the stones) are metaverse-engine/world/build-site-mesh.coax, which the scene packer runs.
// The game owns the structures (Everglade: everglade/world/housewright.coax).
#module "aethyr.buildsite";
#load "building.coax" as building;

// The forms.
BS_POLE :: 0;        // a round pole from (x0, y0, z0) to (x1, y1, z1), radius t
BS_BEAM :: 1;        // a squared, pegged timber between the same points, half its width t
BS_WALL :: 2;        // a wall along (x0, z0) to (x1, z1), from y0 up to y1, t thick
BS_RING :: 3;        // a wall along an arc: centre (x0, z0), radius x1, angles z1 to a (0 is +z), y0 to y1, t thick
BS_SHED :: 4;        // one roof slope over x0..x1: its high edge at z0 (height y1), its low edge at z1 (height y0), t thick
BS_GABLE :: 5;       // two slopes over x0..x1, z0..z1: eaves at y0, the ridge at y1 along x (along z when a is 1)
BS_CONE :: 6;        // a round roof: centre (x0, z0), eave radius x1 at y0, apex y1
BS_SLAB :: 7;        // a block from (x0, y0, z0) to (x1, y1, z1)
BS_TRENCH :: 8;      // a drainage ditch along (x0, z0) to (x1, z1), t wide, its spoil banked outside
BS_STONES :: 9;      // loose stones in a ring: centre (x0, z0), radius x1, each stone t across
BS_GABLE_END :: 10;  // a triangular wall along (x0, z0) to (x1, z1): base y0, apex y1 over its middle
BS_KIT :: 11;        // a kit piece the game names (mat is its index): at (x0, y0, z0), turned x1 quarters; t its collider (0 none, 1 a 2 m wall module, 2 a door module)

// The materials. On a wall form: BARK is a row of posts (t their radius), WITHY woven wattle, DAUB
// clay over it, FIELDSTONE dry-stacked stones, ASHLAR dressed stone, PLANK boards. On a roof form:
// BARK is rafter poles, TIMBER sawn rafters, REED thatch, LEAF boughs.
BS_BARK :: 0;
BS_TIMBER :: 1;
BS_WITHY :: 2;
BS_DAUB :: 3;
BS_FIELDSTONE :: 4;
BS_ASHLAR :: 5;
BS_REED :: 6;
BS_LEAF :: 7;
BS_EARTH :: 8;
BS_FLAG :: 9;        // flagstones: a hearth, a stone floor
BS_PLANK :: 10;
BS_HIDE :: 11;       // a hide door flap
BS_MATERIALS :: 12;

BS_HEAD :: 1.9;      // nothing wholly above this height is a collider: you pass under it
BS_PART_BOXES :: 32; // the most boxes one part gives

BuildPart :: struct {stage:int;form:int;mat:int;x0:f32;y0:f32;z0:f32;x1:f32;y1:f32;z1:f32;t:f32;a:f32;}

// A part from a table row: stage, form, mat, x0, y0, z0, x1, y1, z1, t, a.
bs_row :: (r:[11]f32)->BuildPart {
 return BuildPart.{stage=int(r[0]),form=int(r[1]),mat=int(r[2]),x0=r[3],y0=r[4],z0=r[5],x1=r[6],y1=r[7],z1=r[8],t=r[9],a=r[10]};
}
bs_solid :: (mat:int)->bool {return mat==BS_WITHY || mat==BS_DAUB || mat==BS_FIELDSTONE || mat==BS_ASHLAR || mat==BS_PLANK || mat==BS_TIMBER;}

// A point along a wall's line or arc, s from 0 to 1, and the line's length.
bs_path :: (p:BuildPart,s:f32)->[2]f32 {
 if p.form==BS_RING {a:=p.z1+(p.a-p.z1)*s;return [2]f32.[p.x0+p.x1*sin(a),p.z0+p.x1*cos(a)];}
 return [2]f32.[p.x0+(p.x1-p.x0)*s,p.z0+(p.z1-p.z0)*s];
}
bs_path_len :: (p:BuildPart)->f32 {
 if p.form==BS_RING {return abs(p.a-p.z1)*p.x1;}
 dx:=p.x1-p.x0;dz:=p.z1-p.z0;return sqrt(dx*dx+dz*dz);
}
// How many posts a BARK wall stands, ends included, about a metre apart.
bs_posts :: (p:BuildPart)->int {n:=int(bs_path_len(p)/1.05+0.999);return ifx n<1 then 2 else n+1;}

bs_box_put :: (out:[]f32,n:int,b:[6]f32)->int {
 if b[1]>=BS_HEAD || n>=out.count/6 {return n;}
 for k:0..<6 {out[n*6+k]=b[k];}return n+1;
}
bs_lo :: (a:f32,b:f32)->f32 {return ifx a<b then a else b;}
bs_hi :: (a:f32,b:f32)->f32 {return ifx a>b then a else b;}

#test "a woven wall blocks along its line, a row of posts only at each post" {
 w:=BuildPart.{stage=1,form=BS_WALL,mat=BS_WITHY,x0= -2,z0=1,x1=2,z1=1,y0=0,y1=2,t=0.12};
 b:[BS_PART_BOXES*6]f32;n:=bs_boxes(w,b[..],0);#assert n==1 && b[0]== -2 && b[3]==2 && b[2]<1 && b[5]>1 && b[4]==2;
 p:=w;p.mat=BS_BARK;p.t=0.08;n=bs_boxes(p,b[..],0);#assert n==bs_posts(p) && n==5;
 for i:0..<n-1 {#assert b[(i+1)*6]-b[i*6+3]>0.6;}   // room for you between two posts
 // a gable end above your head is no collider
 g:=w;g.form=BS_GABLE_END;g.y0=2.4;g.y1=4;#assert bs_boxes(g,b[..],0)==0;
}
#test "a ring wall closes its arc and leaves its doorway open" {
 r:=BuildPart.{stage=1,form=BS_RING,mat=BS_WITHY,x0=0,z0=0,x1=1.5,z1=0.4,a=6.2831853-0.4,y0=0,y1=1.8,t=0.1};
 b:[BS_PART_BOXES*6]f32;n:=bs_boxes(r,b[..],0);#assert n>12;
 for k:0..<40 {a:=0.5+f32(k)*0.13;x:=1.5*sin(a);z:=1.5*cos(a);hit:=false;for i:0..<n {if x>=b[i*6] && x<=b[i*6+3] && z>=b[i*6+2] && z<=b[i*6+5] {hit=true;}}#assert hit;}
 for i:0..<n {#assert !(0>b[i*6]-0.3 && 0<b[i*6+3]+0.3 && 1.5>b[i*6+2]-0.3 && 1.5<b[i*6+5]+0.3);}
}
#test "a lean-to's slope blocks only where it comes below your head" {
 s:=BuildPart.{stage=1,form=BS_SHED,mat=BS_LEAF,x0= -1.5,x1=1.5,z0=0.9,y1=2.3,z1= -1.1,y0=0,t=0.1};
 b:[BS_PART_BOXES*6]f32;n:=bs_boxes(s,b[..],0);#assert n>2;
 front:=false;back:=false;for i:0..<n {if b[i*6+5]>0.85 {front=true;}if b[i*6+2]< -1.05 {back=true;}}#assert !front && back;
}
// The colliders of one part, as boxes (x0, y0, z0, x1, y1, z1) in the building's frame, written
// from box n of `out`; returns the count after them.
bs_boxes :: (p:BuildPart,out:[]f32,n:int)->int {
 c:=n;
 if p.form==BS_WALL || p.form==BS_RING || p.form==BS_GABLE_END {
  if p.mat==BS_BARK {k:=bs_posts(p);for i:0..<k {q:=bs_path(p,f32(i)/f32(k-1));c=bs_box_put(out,c,[6]f32.[q[0]-p.t,p.y0,q[1]-p.t,q[0]+p.t,p.y1,q[1]+p.t]);}return c;}
  if !bs_solid(p.mat) {return c;}
  // a straight wall grows only across its line, so it ends where its line ends and an opening
  // between two walls is as wide as the gap between their lines; an arc's chords grow both ways
  top:=ifx p.form==BS_GABLE_END then p.y0+(p.y1-p.y0)*0.5 else p.y1;h:=p.t*0.5;
  k:=ifx p.form==BS_RING then int(bs_path_len(p)/0.4)+1 else 1;
  for i:0..<k {a:=bs_path(p,f32(i)/f32(k));b:=bs_path(p,f32(i+1)/f32(k));
   dx:=b[0]-a[0];dz:=b[1]-a[1];l:=sqrt(dx*dx+dz*dz);hx:=h;hz:=h;if p.form!=BS_RING && l>0.0001 {hx=h*abs(dz)/l;hz=h*abs(dx)/l;}
   c=bs_box_put(out,c,[6]f32.[bs_lo(a[0],b[0])-hx,p.y0,bs_lo(a[1],b[1])-hz,bs_hi(a[0],b[0])+hx,top,bs_hi(a[1],b[1])+hz]);}
  return c;
 }
 if p.form==BS_POLE || p.form==BS_BEAM {
  if (p.y0>=BS_HEAD && p.y1>=BS_HEAD) || p.mat==BS_HIDE || p.mat==BS_LEAF {return c;}   // a door flap or a spray gives way
  // the stretch of it below your head
  s0:f32=0;s1:f32=1;dy:=p.y1-p.y0;
  if abs(dy)>0.0001 {s:=(BS_HEAD-p.y0)/dy;if dy>0 {s1=bs_lo(1,s);}else {s0=bs_hi(0,s);}}
  ax:=p.x0+(p.x1-p.x0)*s0;az:=p.z0+(p.z1-p.z0)*s0;ay:=p.y0+dy*s0;bx:=p.x0+(p.x1-p.x0)*s1;bz:=p.z0+(p.z1-p.z0)*s1;by:=p.y0+dy*s1;
  return bs_box_put(out,c,[6]f32.[bs_lo(ax,bx)-p.t,bs_lo(ay,by)-p.t,bs_lo(az,bz)-p.t,bs_hi(ax,bx)+p.t,bs_hi(ay,by)+p.t,bs_hi(az,bz)+p.t]);
 }
 if p.form==BS_SHED {
  // strips down the slope; one blocks where its low side is below your head
  for i:0..<6 {sa:=f32(i)/6;sb:=f32(i+1)/6;za:=p.z0+(p.z1-p.z0)*sa;zb:=p.z0+(p.z1-p.z0)*sb;ha:=p.y1+(p.y0-p.y1)*sa;hb:=p.y1+(p.y0-p.y1)*sb;
   if bs_lo(ha,hb)>=BS_HEAD-0.2 {continue;}
   c=bs_box_put(out,c,[6]f32.[bs_lo(p.x0,p.x1),0,bs_lo(za,zb),bs_hi(p.x0,p.x1),bs_hi(ha,hb)+p.t,bs_hi(za,zb)]);}
  return c;
 }
 if p.form==BS_SLAB {return bs_box_put(out,c,[6]f32.[bs_lo(p.x0,p.x1),p.y0,bs_lo(p.z0,p.z1),bs_hi(p.x0,p.x1),p.y1,bs_hi(p.z0,p.z1)]);}
 if p.form==BS_KIT && p.t>0 {
  // a 2 m kit wall module 0.4 m thick and 3.1 m tall, turned x1 quarters about its place; a door
  // module keeps only its two jambs
  f:=building.BuildingFrame.{x=p.x0,z=p.z0,turn=int(p.x1)};
  if p.t<1.5 {return bs_box_put(out,c,building.building_box(f,[6]f32.[-1,p.y0,-0.2,1,p.y0+3.1,0.2]));}
  c=bs_box_put(out,c,building.building_box(f,[6]f32.[-1,p.y0,-0.2,-0.78,p.y0+3.1,0.2]));
  return bs_box_put(out,c,building.building_box(f,[6]f32.[0.78,p.y0,-0.2,1,p.y0+3.1,0.2]));
 }
 return c;
}
// The same boxes placed in the world at the frame (y still from the frame's ground).
bs_world_boxes :: (f:building.BuildingFrame,p:BuildPart,out:[]f32,n:int)->int {
 c:=bs_boxes(p,out,n);
 for i:n..<c {b:=building.building_box(f,[6]f32.[out[i*6],out[i*6+1],out[i*6+2],out[i*6+3],out[i*6+4],out[i*6+5]]);for k:0..<6 {out[i*6+k]=b[k];}}
 return c;
}
#test "boxes turn with the building" {
 p:=BuildPart.{stage=1,form=BS_SLAB,mat=BS_EARTH,x0=0,x1=1,y0=0,y1=0.1,z0=0,z1=2};
 b:[6]f32;n:=bs_world_boxes(building.BuildingFrame.{x=10,z=5,turn=1},p,b[..],0);
 #assert n==1 && b[0]==10 && b[3]==12 && b[2]==4 && b[5]==5;
}

// ---- Build progress (#13106): a structure's build is one number, its progress from 0 to its last
// stage. Progress k (a whole number) draws exactly stage k. Between k and k+1 the parts of stage
// k+1 arrive one by one in their order in the parts list (the game lists each stage's parts in
// the order they go up: corner posts before the posts between them, the low course before the
// high one), each taking a share of the stage's time by how much work it is (bs_work). A part's
// fraction runs 0 to 1 as it grows (bs_fraction); how each form grows is bs_pose (a pole stands
// up, a kit piece lifts) and the reveal keys the mesher gives its vertices (build-site-mesh.coax).
// Colliders stay at whole stages: use stage floor(progress).

bs_clamp01 :: (x:f32)->f32 {return ifx x<0 then 0.0f32 else ifx x>1 then 1.0f32 else x;}
bs_ease :: (x:f32)->f32 {t:=bs_clamp01(x);return t*t*(3-2*t);}
// The rows and courses a wall is built in, and its top over its middle.
bs_wall_top :: (p:BuildPart)->f32 {return ifx p.form==BS_GABLE_END then p.y0+(p.y1-p.y0)*0.5 else p.y1;}
bs_courses :: (p:BuildPart)->int {
 h:=bs_wall_top(p)-p.y0;step:=ifx p.mat==BS_WITHY then 0.062f32 else ifx p.mat==BS_PLANK then 0.2f32 else ifx p.mat==BS_DAUB then 0.4f32 else 0.3f32;
 n:=int(h/step+0.5);return ifx n<1 then 1 else n;
}
// How much work a part is, in rough worker-hours: what shares out a stage's time.
bs_area :: (p:BuildPart)->f32 {
 f:=p.form;
 if f==BS_WALL || f==BS_RING || f==BS_GABLE_END {return bs_path_len(p)*(bs_wall_top(p)-p.y0);}
 if f==BS_CONE {l:=sqrt(p.x1*p.x1+(p.y1-p.y0)*(p.y1-p.y0));return 3.1415927*p.x1*l;}
 if f==BS_SHED {dz:=p.z1-p.z0;dy:=p.y1-p.y0;return abs(p.x1-p.x0)*sqrt(dz*dz+dy*dy);}
 if f==BS_GABLE {w:=ifx p.a>0.5 then abs(p.z1-p.z0) else abs(p.x1-p.x0);d:=ifx p.a>0.5 then abs(p.x1-p.x0)*0.5 else abs(p.z1-p.z0)*0.5;h:=p.y1-p.y0;return 2*w*sqrt(d*d+h*h);}
 if f==BS_SLAB {return abs(p.x1-p.x0)*abs(p.z1-p.z0);}
 return 0;
}
bs_work :: (p:BuildPart)->f32 {
 f:=p.form;m:=p.mat;w:f32=1;
 if f==BS_POLE {dx:=p.x1-p.x0;dy:=p.y1-p.y0;dz:=p.z1-p.z0;w=0.4+0.25*sqrt(dx*dx+dy*dy+dz*dz);}
 else if f==BS_BEAM {dx:=p.x1-p.x0;dy:=p.y1-p.y0;dz:=p.z1-p.z0;w=0.6+0.3*sqrt(dx*dx+dy*dy+dz*dz);}
 else if f==BS_WALL || f==BS_RING || f==BS_GABLE_END {a:=bs_area(p);
  w=ifx m==BS_BARK then 0.6*f32(bs_posts(p)) else ifx m==BS_FIELDSTONE || m==BS_ASHLAR then 2.2*a*(0.4+p.t) else ifx m==BS_WITHY then 1.1*a else ifx m==BS_DAUB then 0.9*a else 0.5*a;}
 else if f==BS_SHED || f==BS_GABLE || f==BS_CONE {a:=bs_area(p);w=ifx m==BS_REED then 0.8*a else ifx m==BS_LEAF then 0.35*a else 0.25*a;}
 else if f==BS_SLAB {a:=bs_area(p);w=ifx m==BS_FLAG then 1.2*a else ifx m==BS_PLANK then 0.6*a else 0.25*a;}
 else if f==BS_TRENCH {w=1.2*bs_path_len(p);}
 else if f==BS_STONES {w=0.15*6.2831853*p.x1/(p.t*1.1);}
 else if f==BS_KIT {w=1.5;}
 return ifx w<0.3 then 0.3f32 else w;
}
// The stage being built at a progress (1 to last), and how far through it (0 to 1). At a whole
// number k this is stage k+1 at 0, so nothing of it shows yet.
bs_stage_at :: (progress:f32)->int {return int(floor(progress))+1;}
// Every part's fraction at a progress, into out (one per part). Parts must be in stage order.
bs_fractions :: (parts:[]BuildPart,progress:f32,out:[]f32) {
 s:=bs_stage_at(progress);t:=progress-floor(progress);total:f32=0;
 for i:0..<parts.count {if parts[i].stage==s {total+=bs_work(parts[i]);}}
 at:f32=0;
 for i:0..<parts.count {p:=parts[i];
  if p.stage<s {out[i]=1;}else if p.stage>s {out[i]=0;}
  else {w:=bs_work(p);out[i]=ifx total>0 then bs_clamp01((t*total-at)/w) else 0.0f32;at+=w;}}
}
// One part's fraction (bs_fractions, for one part).
bs_fraction :: (parts:[]BuildPart,i:int,progress:f32)->f32 {
 s:=bs_stage_at(progress);p:=parts[i];if p.stage<s {return 1;}if p.stage>s {return 0;}
 t:=progress-floor(progress);total:f32=0;at:f32=0;
 for j:0..<parts.count {if parts[j].stage==s {if j<i {at+=bs_work(parts[j]);}total+=bs_work(parts[j]);}}
 return ifx total>0 then bs_clamp01((t*total-at)/bs_work(p)) else 0.0f32;
}
// Whether a part is drawn at a progress. A woven wall is hidden once the daub over it (a later
// part on the same line) is finished.
bs_shown :: (parts:[]BuildPart,frac:[]f32,i:int)->bool {
 if frac[i]<=0 {return false;}p:=parts[i];if p.mat!=BS_WITHY {return true;}
 for j:0..<parts.count {q:=parts[j];if q.mat==BS_DAUB && frac[j]>=1 && q.form==p.form && q.x0==p.x0 && q.z0==p.z0 && q.x1==p.x1 && q.z1==p.z1 {return false;}}
 return true;
}

// Where the work is on a part at fraction f, in the building's frame: the foot of a pole being
// stood up, the next withy or stone along its course, the thatch course being laid, the edge of a
// floor being filled. A builder stands by it and carries the next piece there.
bs_spot :: (p:BuildPart,f:f32)->[3]f32 {
 g:=bs_clamp01(f);fm:=p.form;
 if fm==BS_POLE || fm==BS_BEAM {lo:=ifx p.y0<=p.y1 then 0 else 1;
  if fm==BS_BEAM && abs(p.y1-p.y0)<0.5 {return [3]f32.[(p.x0+p.x1)*0.5,bs_lo(p.y0,p.y1)*bs_ease((g-0.35)/0.65),(p.z0+p.z1)*0.5];}
  return ifx lo==0 then [3]f32.[p.x0,p.y0,p.z0] else [3]f32.[p.x1,p.y1,p.z1];}
 if fm==BS_WALL || fm==BS_RING || fm==BS_GABLE_END {
  if p.mat==BS_BARK {k:=bs_posts(p);i:=int(g*f32(k));if i>=k {i=k-1;}q:=bs_path(p,f32(i)/f32(k-1));return [3]f32.[q[0],p.y0,q[1]];}
  c:=bs_courses(p);r:=g*f32(c);row:=int(r);if row>=c {row=c-1;}s:=r-f32(row);if row%2==1 {s=1-s;}
  q:=bs_path(p,bs_clamp01(s));return [3]f32.[q[0],p.y0+(bs_wall_top(p)-p.y0)*(f32(row)+0.5)/f32(c),q[1]];}
 if fm==BS_CONE {a:=g*6.2831853*4;r:=p.x1*(1-g);return [3]f32.[p.x0+r*sin(a),p.y0+(p.y1-p.y0)*g,p.z0+r*cos(a)];}
 if fm==BS_SHED {return [3]f32.[(p.x0+p.x1)*0.5,p.y0+(p.y1-p.y0)*g,p.z1+(p.z0-p.z1)*g];}
 if fm==BS_GABLE {if p.a>0.5 {return [3]f32.[p.x0+(p.x1-p.x0)*0.5*g,p.y0+(p.y1-p.y0)*g,(p.z0+p.z1)*0.5];}return [3]f32.[(p.x0+p.x1)*0.5,p.y0+(p.y1-p.y0)*g,p.z0+(p.z1-p.z0)*0.5*g];}
 if fm==BS_SLAB {return [3]f32.[p.x0+(p.x1-p.x0)*g,p.y1,(p.z0+p.z1)*0.5];}
 if fm==BS_TRENCH {q:=bs_path(p,g);return [3]f32.[q[0],0,q[1]];}
 if fm==BS_STONES {a:=g*6.2831853;return [3]f32.[p.x0+p.x1*sin(a),p.y0,p.z0+p.x1*cos(a)];}
 return [3]f32.[p.x0,p.y0,p.z0];
}
// The part arriving at a progress: the one growing now (fraction between 0 and 1), or at a whole
// stage the first part of the next stage, at 0; part -1 when the structure is done.
BuildArrival :: struct {part:int;frac:f32;mat:int;spot:[3]f32;}
bs_arrival :: (parts:[]BuildPart,progress:f32)->BuildArrival {
 s:=bs_stage_at(progress);t:=progress-floor(progress);total:f32=0;
 for i:0..<parts.count {if parts[i].stage==s {total+=bs_work(parts[i]);}}
 at:f32=0;
 for i:0..<parts.count {p:=parts[i];if p.stage!=s {continue;}w:=bs_work(p);f:=bs_clamp01((t*total-at)/w);at+=w;
  if f<1 {return BuildArrival.{part=i,frac=f,mat=bs_material(p),spot=bs_spot(p,f)};}}
 return BuildArrival.{part= -1,mat= -1};
}
// What a part is made of, counted: its material (a kit piece counts as boards), and how many
// pieces of it (posts, withies, stones, bundles of reed, boughs, clay loads, boards).
bs_material :: (p:BuildPart)->int {return ifx p.form==BS_KIT then BS_PLANK else p.mat;}
bs_units :: (p:BuildPart)->f32 {
 f:=p.form;m:=p.mat;
 if f==BS_POLE || f==BS_BEAM || f==BS_KIT {return 1;}
 if f==BS_TRENCH {return 0;}
 if f==BS_STONES {return f32(int(6.2831853*p.x1/(p.t*1.1)+0.5));}
 a:=bs_area(p);
 if f==BS_WALL || f==BS_RING || f==BS_GABLE_END {
  if m==BS_BARK {return f32(bs_posts(p));}
  if m==BS_WITHY {return f32(bs_courses(p))*bs_hi(1,bs_path_len(p)/3);}
  if m==BS_FIELDSTONE {return f32(int(a*p.t/0.02+0.5));}
  if m==BS_ASHLAR {return f32(int(a/0.12+0.5));}
  if m==BS_DAUB {return f32(int(a/0.5+0.5));}
  return f32(int(a/0.2+0.5));
 }
 if f==BS_SHED || f==BS_GABLE || f==BS_CONE {
  if m==BS_REED {return f32(int(a/0.25+0.5));}
  if m==BS_LEAF {return f32(int(a/0.15+0.5));}
  w:=ifx f==BS_CONE then 6.2831853*p.x1 else ifx f==BS_SHED then abs(p.x1-p.x0) else (ifx p.a>0.5 then abs(p.z1-p.z0) else abs(p.x1-p.x0))*2;
  return f32(int(w/(ifx f==BS_CONE then 0.9f32 else 0.45f32)+1.5));
 }
 if f==BS_SLAB {if m==BS_EARTH {return 0;}return f32(int(a/(ifx m==BS_LEAF then 0.15f32 else 0.2f32)+0.5));}
 return 0;
}
// The pieces of each material used by a progress (out: BS_MATERIALS counts, the arriving part
// counted by its fraction). At the last stage this is the structure's whole bill; what is left in
// the pile is the bill less what is used.
bs_used :: (parts:[]BuildPart,progress:f32,out:[]f32) {
 for k:0..<BS_MATERIALS {out[k]=0;}
 s:=bs_stage_at(progress);t:=progress-floor(progress);total:f32=0;
 for i:0..<parts.count {if parts[i].stage==s {total+=bs_work(parts[i]);}}
 at:f32=0;
 for i:0..<parts.count {p:=parts[i];f:f32=0;
  if p.stage<s {f=1;}else if p.stage==s {w:=bs_work(p);f=bs_clamp01((t*total-at)/w);at+=w;}
  out[bs_material(p)]+=bs_units(p)*f;}
}

// How a pole, beam or kit piece moves as it arrives, as a matrix in the building's frame
// (columns x, y, z, then the translation): a pole is carried in lying beside its hole and stands up
// on its foot; a beam is carried in lying under its place and lifted to it; a kit piece lifts from
// below into its place. Every other form stays put (identity) and grows by its reveal keys.
bs_pose :: (p:BuildPart,f:f32)->[12]f32 {
 id:=[12]f32.[1,0,0,0,1,0,0,0,1,0,0,0];g:=bs_clamp01(f);if g>=1 {return id;}
 if p.form==BS_KIT {s:=bs_ease(g/0.8);id[10]= -(1-s)*2.2;return id;}
 if p.form!=BS_POLE && p.form!=BS_BEAM {return id;}
 // the foot (its lower end) and the way it runs from there
 ax:=p.x0;ay:=p.y0;az:=p.z0;dx:=p.x1-p.x0;dy:=p.y1-p.y0;dz:=p.z1-p.z0;if dy<0 {ax=p.x1;ay=p.y1;az=p.z1;dx= -dx;dy= -dy;dz= -dz;}
 l:=sqrt(dx*dx+dy*dy+dz*dz);if l<0.0001 {return id;}
 h:=sqrt(dx*dx+dz*dz);s:=bs_ease((g-0.35)/0.65);
 if dy/l<0.35 {
  // a beam: lowered to the ground under its place, then raised
  id[10]= -(ay-p.t)*(1-s);return id;
 }
 // a pole: turned down about its foot to lie along the ground, away from the middle
 ox:=dx;oz:=dz;if h<0.05 {ox=ax;oz=az;ol:=sqrt(ox*ox+oz*oz);if ol<0.01 {ox=1;oz=0;ol=1;}ox/=ol;oz/=ol;}else {ox/=h;oz/=h;}
 // rotation axis: horizontal, square to the lying direction
 kx:=oz;kz:= -ox;a:=(1-s)*(1.5707963-bs_elevation(dy,h));if h<0.05 {a=(1-s)*1.5707963;}
 c:=cos(a);sn:=sin(a);t:=1-c;
 // Rodrigues' rotation about (kx, 0, kz)
 m:=[9]f32.[t*kx*kx+c,sn*kz,t*kx*kz, -sn*kz,c,sn*kx, t*kx*kz,-sn*kx,t*kz*kz+c];
 for k:0..<9 {id[k]=m[k];}
 // keep the foot in place, and carry it in from a little way out first
 slide:=(1-bs_ease(g/0.35))*1.5;fy:=ay-(1-s)*(ay-p.t);
 id[9]=ax-(m[0]*ax+m[3]*ay+m[6]*az)+ox*slide;id[10]=fy-(m[1]*ax+m[4]*ay+m[7]*az);id[11]=az-(m[2]*ax+m[5]*ay+m[8]*az)+oz*slide;
 return id;
}
// The angle up from level of a run of dy over h (h > 0), in radians.
bs_elevation :: (dy:f32,h:f32)->f32 {
 big:=dy>h;z:=ifx big then h/dy else dy/h;a:=z*(0.9998660+z*z*(-0.3302995+z*z*(0.1801410+z*z*(-0.0851330+z*z*0.0208351))));
 return ifx big then 1.5707963-a else a;
}
bs_pose_point :: (m:[12]f32,x:f32,y:f32,z:f32)->[3]f32 {return [3]f32.[m[0]*x+m[3]*y+m[6]*z+m[9],m[1]*x+m[4]*y+m[7]*z+m[10],m[2]*x+m[5]*y+m[8]*z+m[11]];}

#test "progress k draws stage k exactly: every part of stages 1 to k whole, none after" {
 parts:=[6]BuildPart.[BuildPart.{stage=1,form=BS_POLE,mat=BS_BARK,y1=2,t=0.06},BuildPart.{stage=1,form=BS_WALL,mat=BS_WITHY,x0= -1,x1=1,y1=1.5,t=0.1},
  BuildPart.{stage=2,form=BS_WALL,mat=BS_DAUB,x0= -1,x1=1,y1=1.5,t=0.2},BuildPart.{stage=2,form=BS_SLAB,mat=BS_FLAG,x1=1,y1=0.05,z1=1},
  BuildPart.{stage=3,form=BS_CONE,mat=BS_REED,x1=1.5,y0=1.5,y1=3,t=0.25},BuildPart.{stage=3,form=BS_KIT,mat=0,t=1}];
 fr:[6]f32;
 for k:0..<4 {bs_fractions(parts[..],f32(k),fr[..]);for i:0..<6 {want:=ifx parts[i].stage<=k then 1.0f32 else 0.0f32;#assert fr[i]==want && bs_fraction(parts[..],i,f32(k))==want;}}
 // the woven wall is hidden once its daub is done, as the whole-stage drawing hides it
 bs_fractions(parts[..],2,fr[..]);#assert !bs_shown(parts[..],fr[..],1) && bs_shown(parts[..],fr[..],2);
 bs_fractions(parts[..],1.5,fr[..]);#assert bs_shown(parts[..],fr[..],1);
}
#test "within a stage parts arrive one by one in their order" {
 parts:=[4]BuildPart.[BuildPart.{stage=1,form=BS_POLE,mat=BS_BARK,x0= -1,x1= -1,y1=2,t=0.06},BuildPart.{stage=1,form=BS_POLE,mat=BS_BARK,x0=1,x1=1,y1=2,t=0.06},
  BuildPart.{stage=1,form=BS_BEAM,mat=BS_BARK,x0= -1,x1=1,y0=2,y1=2,t=0.05},BuildPart.{stage=2,form=BS_SHED,mat=BS_LEAF,x0= -1,x1=1,z0=0,z1= -1,y1=2,t=0.1}];
 fr:[4]f32;last:= -1;
 for k:1..<40 {v:=f32(k)/40;bs_fractions(parts[..],v,fr[..]);
  // no part starts before the one ahead of it is whole
  for i:1..<3 {#assert fr[i]==0 || fr[i-1]==1;}
  a:=bs_arrival(parts[..],v);#assert a.part>=last;last=a.part;#assert a.part<0 || (fr[a.part]==a.frac && a.frac<1);}
 a:=bs_arrival(parts[..],0);#assert a.part==0 && a.frac==0;
 a=bs_arrival(parts[..],1);#assert a.part==3 && a.frac==0;
 a=bs_arrival(parts[..],2);#assert a.part== -1;
}
#test "materials used grow to the whole bill and count the arriving part by its fraction" {
 parts:=[3]BuildPart.[BuildPart.{stage=1,form=BS_RING,mat=BS_BARK,x1=1.5,z1=0.4,a=5.9,y1=1.8,t=0.065},BuildPart.{stage=2,form=BS_RING,mat=BS_WITHY,x1=1.5,z1=0.4,a=5.9,y1=1.75,t=0.1},
  BuildPart.{stage=3,form=BS_CONE,mat=BS_REED,x1=1.9,y0=1.4,y1=3.6,t=0.28}];
 u:[BS_MATERIALS]f32;bs_used(parts[..],0,u[..]);for k:0..<BS_MATERIALS {#assert u[k]==0;}
 bs_used(parts[..],3,u[..]);#assert u[BS_BARK]==f32(bs_posts(parts[0])) && u[BS_WITHY]>20 && u[BS_REED]>20;
 h:[BS_MATERIALS]f32;bs_used(parts[..],1.5,h[..]);#assert h[BS_BARK]==u[BS_BARK] && abs(h[BS_WITHY]-u[BS_WITHY]*0.5)<0.01 && h[BS_REED]==0;
}
#test "a pole lies by its hole, then stands on its foot; a beam lifts; a kit piece rises" {
 p:=BuildPart.{stage=1,form=BS_POLE,mat=BS_BARK,x0=1,y0=0,z0=0,x1=1,y1=2,z1=0,t=0.06};
 m:=bs_pose(p,0.2);top:=bs_pose_point(m,1,2,0);#assert abs(top[1]-0.06)<0.01 && top[0]>2.5;   // lying, outward, still being carried in
 m=bs_pose(p,0.6);top=bs_pose_point(m,1,2,0);foot:=bs_pose_point(m,1,0,0);#assert top[1]>0.3 && top[1]<1.95 && abs(foot[0]-1)<0.01;
 m=bs_pose(p,1);top=bs_pose_point(m,1,2,0);#assert top[0]==1 && top[1]==2;
 b:=BuildPart.{stage=1,form=BS_BEAM,mat=BS_TIMBER,x0= -1,y0=2.4,x1=1,y1=2.4,t=0.1};m=bs_pose(b,0.1);#assert abs(bs_pose_point(m,0,2.4,0)[1]-0.1)<0.01;
 m=bs_pose(b,0.7);y:=bs_pose_point(m,0,2.4,0)[1];#assert y>0.1 && y<2.4;
 k:=BuildPart.{stage=1,form=BS_KIT,x0=1,y0=0.3,z0=2,t=1};m=bs_pose(k,0.3);#assert m[10]<0;m=bs_pose(k,1);#assert m[10]==0;
 s:=BuildPart.{stage=1,form=BS_SLAB,mat=BS_FLAG,x1=1,y1=0.05,z1=1};m=bs_pose(s,0.5);#assert m[0]==1 && m[9]==0 && m[10]==0;
}
#test "the work spot follows each form's growth" {
 w:=BuildPart.{stage=1,form=BS_WALL,mat=BS_FIELDSTONE,x0= -2,x1=2,y0=0,y1=0.9,t=0.5};
 a:=bs_spot(w,0.05);b:=bs_spot(w,0.95);#assert a[1]<b[1] && a[0]< -1;   // the low course first, from its start
 s:=BuildPart.{stage=1,form=BS_SLAB,mat=BS_EARTH,x0= -1,x1=1,y1=0.04,z0= -1,z1=1};#assert bs_spot(s,0)[0]== -1 && bs_spot(s,1)[0]==1;
 c:=BuildPart.{stage=1,form=BS_CONE,mat=BS_REED,x1=1.9,y0=1.4,y1=3.6};#assert bs_spot(c,0)[1]==1.4 && abs(bs_spot(c,1)[1]-3.6)<0.001;
}
