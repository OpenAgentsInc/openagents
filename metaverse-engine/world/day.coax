// The day adapter for the environment resolver (lighting plan Phase 1 step 4, GitHub #13064;
// docs/metaverse/lighting/README.md). It is not a second clock: it reads the simulation tick through the
// clock modes metaverse-engine/world/style-clock.coax already has (fixed, cycle and real: StyleClock,
// verse_style_clock, verse_style_clock_at) and the room server's day (coax/web/room/room-sky.coax:
// W's TICK, HZ and DAY), and gives the EnvironmentState day that metaverse-engine/world/environment.coax
// env_resolve takes.
//
// A DayClock is explicit about everything a day comes from:
//   mode    fixed (the time never moves), cycle (one day every `seconds`, STYLE_CYCLE_SECONDS for the
//           realms' shared 48-minute day) or real (one day every 86,400 s)
//   source  authored (a realm's or a capture's pinned clock), authority (the room server or the
//           simulation that owns the world) or local (this visitor's page clock: host.js's now= and
//           day= facts)
//   hz      simulation ticks per second
//   epoch   the simulation tick at which the time of day is `at`
// The day at tick T is `at` for fixed, else at + (T - epoch) / (hz * seconds), a count of days whose
// fraction is the time of day (0 midnight, .5 noon), so midnight wraps where env_day_time puts it.
//
// A shared (multiplayer) world never silently uses a visitor's local wall clock: a cycle or real
// clock whose source is local is refused there (DayRefusal.local_clock). A fixed clock reads no clock
// at all, so it is admitted anywhere. The room's clock is anchored at the tick of the day's midnight
// (day_from_room), so every seat that hears W, whenever it joined, holds the same clock and resolves
// the same day at the same tick.
//
// Nothing here draws, and nothing here changes the simulation: every procedure is a pure function of
// its inputs.
//   coax/bin/coax test metaverse-engine/world/day.coax
//   coax/bin/coax mutate metaverse-engine/world/day.coax --root-only
#module "aethyr.world.day";
#authority;
#load "environment.coax" as env;
#load "style-clock.coax";

DAY_VERSION :: 1;
DAY_REAL_SECONDS :: 86400.0;
DAY_HZ_MAX :: 1000;
DAY_SECONDS_MIN :: 1.0;
DAY_SECONDS_MAX :: 864000000.0;          // ten thousand real days
DAY_TICK_MAX :: 9007199254740992;        // 2^53: ticks stay exact in an f64

DayMode :: enum u8 { fixed; cycle; real; }
DaySource :: enum u8 { authored; authority; local; }
DayWorld :: enum u8 { solo; shared; }
DayRefusal :: enum u8 { none; version; rate; nonfinite; range; length; local_clock; }

DayClock :: struct {
  version: u32;
  mode: DayMode;
  source: DaySource;
  hz: u32;          // ticks per second
  epoch: s64;       // the tick at which the time of day is `at`
  at: f64;          // the time of day at `epoch`, [0, 1]
  seconds: f64;     // seconds a day lasts (cycle and real)
}
DayRead :: struct { refusal: DayRefusal; day: f64; }
DayState :: struct { refusal: DayRefusal; state: env.EnvironmentState; }

// ---- checks (written before the code below)

// The time of day of a day, wrapped as env_day_time does, in f64.
day_frac :: (d: f64) -> f64 #effects(all) { return d - floor(d); }

#test "fixed holds its time at every tick, and a cycle and a real day turn on the simulation tick" {
  f := day_fixed(0.25, 30);
  #assert f.epoch == 0 && f.mode == DayMode.fixed && f.source == DaySource.authored && f.seconds == DAY_REAL_SECONDS && f.hz == 30;
  for i: 0..<6 {
    t := [6] s64.[0, 1, 29, 86400, 1000000, 9007199254740991][i];
    r := day_at(f, DayWorld.shared, t);
    #assert r.refusal == DayRefusal.none && r.day == 0.25;
  }
  c := day_cycle(0.5, 30, 100, DaySource.authority);
  #assert c.mode == DayMode.cycle && c.seconds == STYLE_CYCLE_SECONDS && c.hz == 30 && c.epoch == 100 && c.at == 0.5 && c.version == DAY_VERSION;
  #assert day_at(c, DayWorld.shared, 100).day == 0.5;
  // a quarter of the 48-minute day is 720 s, 21,600 ticks at 30 Hz; a whole one is 86,400
  #assert day_at(c, DayWorld.shared, 100 + 21600).day == 0.75;
  #assert day_at(c, DayWorld.shared, 100 + 86400).day == 1.5;
  #assert day_at(c, DayWorld.shared, 100 - 43200).day == 0;
  #assert day_at(c, DayWorld.shared, 115).day == 0.5 + 15.0 / (30.0 * STYLE_CYCLE_SECONDS);
  r := day_real(0.75, 120, 7, DaySource.authority);
  #assert r.mode == DayMode.real && r.seconds == DAY_REAL_SECONDS && r.hz == 120;
  #assert day_at(r, DayWorld.shared, 7 + 120 * 21600).day == 1;
  #assert day_at(r, DayWorld.shared, 8).day == 0.75 + 1.0 / (120.0 * 86400.0);
}
#test "the clocks read metaverse/style-preset's modes: the same time of day as verse_style_clock_at" {
  cases := [4] string.["fixed:0.25", "cycle", "real", "noon"];
  for k: 0..<4 {
    sc := verse_style_clock(cases[k], "1700000000000", "0.6");
    c := day_from_style(sc, 30, 500, DaySource.local);
    #assert c.at == cast(f64) sc.at && c.epoch == 500 && c.hz == 30;
    #assert (c.mode == DayMode.fixed) == (sc.mode == STYLE_CLOCK_FIXED) && (c.mode == DayMode.cycle) == (sc.mode == STYLE_CLOCK_CYCLE) && (c.mode == DayMode.real) == (sc.mode == STYLE_CLOCK_REAL);
    #assert (c.source == DaySource.authored) == (sc.mode == STYLE_CLOCK_FIXED);
    for i: 0..<5 {
      seconds := [5] f64.[0, 1, 720, 2879, 50000][i];
      r := day_at(c, DayWorld.solo, 500 + cast(s64) (seconds * 30));
      #assert r.refusal == DayRefusal.none && abs(day_frac(r.day) - (cast(f64) verse_style_clock_at(sc, cast(f32) seconds))) <= 0.0002;
    }
  }
  #assert day_from_style(verse_style_clock("fixed:0.25", "", ""), 30, 0, DaySource.local).mode == DayMode.fixed;
  #assert day_from_style(verse_style_clock("cycle", "5", ""), 30, 0, DaySource.local).seconds == STYLE_CYCLE_SECONDS;
  #assert day_from_style(verse_style_clock("real", "", "0.1"), 30, 0, DaySource.local).seconds == DAY_REAL_SECONDS;
  #assert day_from_style(verse_style_clock("cycle", "5", ""), 30, 0, DaySource.authority).source == DaySource.authority;
}
#test "a shared world never uses a visitor's local wall clock; a fixed one, an authority's or a solo page's is fine" {
  local_cycle := day_cycle(0.3, 30, 0, DaySource.local);
  local_real := day_real(0.3, 30, 0, DaySource.local);
  #assert day_at(local_cycle, DayWorld.shared, 10).refusal == DayRefusal.local_clock && day_at(local_real, DayWorld.shared, 10).refusal == DayRefusal.local_clock;
  #assert day_at(local_cycle, DayWorld.shared, 10).day == 0 && day_check(local_real, DayWorld.shared) == DayRefusal.local_clock;
  #assert day_at(local_cycle, DayWorld.solo, 10).refusal == DayRefusal.none && day_at(local_real, DayWorld.solo, 10).refusal == DayRefusal.none;
  #assert day_at(day_cycle(0.3, 30, 0, DaySource.authority), DayWorld.shared, 10).refusal == DayRefusal.none;
  #assert day_at(day_real(0.3, 30, 0, DaySource.authored), DayWorld.shared, 10).refusal == DayRefusal.none;
  f := day_fixed(0.3, 30); f.source = DaySource.local;
  #assert day_at(f, DayWorld.shared, 10).refusal == DayRefusal.none;
  // a visitor's page clock in a room is refused, not quietly drawn
  page := day_from_style(verse_style_clock("real", "", "0.9"), 30, 0, DaySource.local);
  #assert day_state(page, DayWorld.shared, 10, 0).refusal == DayRefusal.local_clock && day_state(page, DayWorld.shared, 10, 0).state.version == 0;
}
#test "malformed clocks and ticks are refused, each for its reason" {
  ok := day_cycle(0.5, 30, 100, DaySource.authority);
  #assert day_check(ok, DayWorld.shared) == DayRefusal.none;
  for f: 0..<16 {
    c := ok; want := DayRefusal.range;
    if f == 0 { c.version = 0; want = DayRefusal.version; }
    else if f == 1 { c.version = 2; want = DayRefusal.version; }
    else if f == 2 { c.hz = 0; want = DayRefusal.rate; }
    else if f == 3 { c.hz = DAY_HZ_MAX + 1; want = DayRefusal.rate; }
    else if f == 4 { c.at = 0.0 / 0.0; want = DayRefusal.nonfinite; }
    else if f == 5 { c.seconds = 1.0 / 0.0; want = DayRefusal.nonfinite; }
    else if f == 6 { c.at = -0.000001; }
    else if f == 7 { c.at = 1.000001; }
    else if f == 8 { c.epoch = -1; }
    else if f == 9 { c.epoch = DAY_TICK_MAX; }
    else if f == 10 { c.seconds = 0.999; want = DayRefusal.length; }
    else if f == 11 { c.seconds = DAY_SECONDS_MAX * 1.000001; want = DayRefusal.length; }
    else if f == 12 { c.mode = DayMode.real; c.seconds = 86399; want = DayRefusal.length; }
    else if f == 13 { c.mode = DayMode.real; c.seconds = 86401; want = DayRefusal.length; }
    else if f == 14 { c.at = 1.0 / 0.0; want = DayRefusal.nonfinite; }
    else { c.seconds = 0.0 / 0.0; want = DayRefusal.nonfinite; }
    #assert day_check(c, DayWorld.solo) == want && day_at(c, DayWorld.solo, 100).refusal == want && day_at(c, DayWorld.solo, 100).day == 0;
  }
  // the bounds themselves are admitted
  for f: 0..<7 {
    c := ok;
    if f == 0 { c.hz = 1; } else if f == 1 { c.hz = DAY_HZ_MAX; } else if f == 2 { c.at = 0; } else if f == 3 { c.at = 1; }
    else if f == 4 { c.epoch = 0; } else if f == 5 { c.epoch = DAY_TICK_MAX - 1; } else { c.seconds = DAY_SECONDS_MIN; }
    #assert day_check(c, DayWorld.solo) == DayRefusal.none;
  }
  c := ok; c.seconds = DAY_SECONDS_MAX; #assert day_check(c, DayWorld.solo) == DayRefusal.none;
  c = ok; c.mode = DayMode.real; c.seconds = DAY_REAL_SECONDS; #assert day_check(c, DayWorld.solo) == DayRefusal.none;
  #assert day_at(ok, DayWorld.solo, -1).refusal == DayRefusal.range && day_at(ok, DayWorld.solo, DAY_TICK_MAX).refusal == DayRefusal.range;
  #assert day_at(ok, DayWorld.solo, 0).refusal == DayRefusal.none && day_at(ok, DayWorld.solo, DAY_TICK_MAX - 1).refusal == DayRefusal.none;
  // a fixed clock still checks its tick, so a caller's bad tick never passes silently
  #assert day_at(day_fixed(0.5, 30), DayWorld.solo, -1).refusal == DayRefusal.range;
}
#test "midnight wraps through the adapter: the day's fraction and the profile's cross-midnight segment" {
  // 0.99 of a 48-minute day at tick 0; 0.02 of a day later (1,728 ticks at 30 Hz) it is 0.01 of the next
  c := day_cycle(0.99, 30, 0, DaySource.authority);
  a := day_state(c, DayWorld.shared, 0, 7); b := day_state(c, DayWorld.shared, 1728, 7);
  #assert a.refusal == DayRefusal.none && b.refusal == DayRefusal.none && a.state.version == env.ENV_VERSION && a.state.profile == 7;
  #assert a.state.day == 0.99 && abs(b.state.day - (1.01)) <= 0.0000000001 && abs(cast(f64) env.env_day_time(b.state.day) - (0.01)) <= 0.000001;
  set: [1] env.EnvironmentSet; set[0] = env.env_test_set();
  ra := env.env_resolve(set[..], a.state); rb := env.env_resolve(set[..], b.state);
  #assert ra.refusal == env.EnvRefusal.none && rb.refusal == env.EnvRefusal.none;
  // env_test_set's profile 7 runs .75 -> 1.1 across midnight: both sides are that one segment
  #assert ra.env.from == 2 && ra.env.to == 0 && rb.env.from == 2 && rb.env.to == 0 && rb.env.weight > ra.env.weight;
  // exactly at midnight and on through it the weight keeps rising
  m := day_at(c, DayWorld.shared, 864).day;
  #assert m == 1 && env.env_day_time(m) == 0;
  // a room day near its end wraps the same way
  room := day_from_room(5000, 30, 2879960, 2880000);
  #assert day_frac(day_at(room, DayWorld.shared, 5000).day) == 86399.0 / 86400.0 && day_frac(day_at(room, DayWorld.shared, 5001).day) == 0;
}
#test "the room's clock: every seat that hears W, whenever it joined, holds the same clock" {
  // the server's day turns every WIRE_DAY_MS (2,880,000 ms, the 48-minute cycle) and its tick at EG_HZ (30)
  span := cast(s64) (STYLE_CYCLE_SECONDS * 1000);
  #assert span == 2880000;
  base := cast(s64) 1234567;       // ms into the day at the room's tick 0, a whole tick's ms
  base = base / 100 * 100;
  first := day_from_room(90, 30, (base + 90 * 1000 / 30) % span, span);
  #assert first.mode == DayMode.cycle && first.source == DaySource.authority && first.at == 0 && first.seconds == 2880 && first.hz == 30;
  #assert day_check(first, DayWorld.shared) == DayRefusal.none;
  for j: 0..<5 {
    tick := [5] s64.[91, 4000, 86399, 86400 * 3 + 17, 999999][j];
    ms := (base + tick * 1000 / 30) % span;   // the server's W at that tick (integer ms, as the wire has it)
    late := day_from_room(tick, 30, ms, span);
    #assert day_clock_same(late, first);
    for t: 0..<3 {
      at := tick + [3] s64.[0, 1, 54321][t];
      #assert day_at(late, DayWorld.shared, at).day == day_at(first, DayWorld.shared, at).day;
    }
    #assert abs(day_frac(day_at(late, DayWorld.shared, tick).day) - (cast(f64) ms / cast(f64) span)) <= 0.000006;
  }
  // malformed headers are refused, never drawn
  #assert day_check(day_from_room(10, 30, -1, span), DayWorld.shared) == DayRefusal.range;
  #assert day_check(day_from_room(10, 30, span, span), DayWorld.shared) == DayRefusal.range;
  #assert day_check(day_from_room(10, 30, span - 1, span), DayWorld.shared) == DayRefusal.none;
  #assert day_check(day_from_room(10, 30, 0, 0), DayWorld.shared) != DayRefusal.none;
  #assert day_check(day_from_room(10, 0, 0, span), DayWorld.shared) == DayRefusal.rate;
  // the midnight anchor rounds the header's ms to the nearest tick
  #assert day_from_room(100, 30, 16, span).epoch == 100 && day_from_room(100, 30, 17, span).epoch == 99 && day_from_room(100, 30, 34, span).epoch == 99;
  // the anchor is the first midnight at or after tick 0, whichever day the header falls in
  #assert day_from_room(10, 30, 1000, span).epoch == 86400 - 20 && day_from_room(86400 * 5 + 40, 30, 0, span).epoch == 40;
  #assert day_from_room(86400 * 5 + 40, 30, 1000, span).epoch == 10;
  // a day that is not a whole number of ticks is refused (7 Hz: 20,160 ticks; 7.0001 s is not whole)
  #assert day_check(day_from_room(10, 7, 0, 7001), DayWorld.shared) == DayRefusal.range && day_check(day_from_room(10, 7, 0, 8000), DayWorld.shared) == DayRefusal.none;
  #assert day_from_room(10, 7, 0, 8000).epoch == 10 && day_from_room(10, 7, 0, 8000).seconds == 8;
  // a refused header's clock is at -1 from tick 0; the shortest whole day (one tick) is admitted
  #assert day_from_room(10, 30, -1, span).at == -1 && day_from_room(10, 30, -1, span).epoch == 0 && day_from_room(10, 1, 0, 999).at == -1;
  #assert day_check(day_from_room(10, 1, 0, 1000), DayWorld.shared) == DayRefusal.none && day_from_room(10, 1, 0, 1000).epoch == 0;
  // rounding to the nearest tick: half a tick rounds up
  #assert day_from_room(1000, 1, 499, 86400000).epoch == 1000 && day_from_room(1000, 1, 500, 86400000).epoch == 999;
}
#test "fixed-state replay: the same clock, tick and profile give the same state, in any order" {
  c := day_cycle(0.4, 30, 77, DaySource.authority);
  first: [8] f64; second: [8] f64;
  for i: 0..<8 { first[i] = day_state(c, DayWorld.shared, 77 + cast(s64) i * 9001, 3).state.day; }
  i := 7; while i >= 0 { second[i] = day_state(c, DayWorld.shared, 77 + cast(s64) i * 9001, 3).state.day; i -= 1; }
  for k: 0..<8 { #assert first[k] == second[k]; }
  #assert day_clock_same(c, c);
  for f: 0..<7 {
    d := c;
    if f == 0 { d.version = 2; } else if f == 1 { d.mode = DayMode.real; } else if f == 2 { d.source = DaySource.local; }
    else if f == 3 { d.hz = 31; } else if f == 4 { d.epoch = 78; } else if f == 5 { d.at = 0.41; } else { d.seconds = 2881; }
    #assert !day_clock_same(c, d) && !day_clock_same(d, c);
  }
}

// ---- the clocks

day_fixed :: (at: f64, hz: u32) -> DayClock #effects(all) {
  return DayClock.{version = DAY_VERSION, mode = DayMode.fixed, source = DaySource.authored, hz = hz, epoch = 0, at = at, seconds = DAY_REAL_SECONDS};
}
day_cycle :: (at: f64, hz: u32, epoch: s64, source: DaySource) -> DayClock #effects(all) {
  return DayClock.{version = DAY_VERSION, mode = DayMode.cycle, source = source, hz = hz, epoch = epoch, at = at, seconds = STYLE_CYCLE_SECONDS};
}
day_real :: (at: f64, hz: u32, epoch: s64, source: DaySource) -> DayClock #effects(all) {
  return DayClock.{version = DAY_VERSION, mode = DayMode.real, source = source, hz = hz, epoch = epoch, at = at, seconds = DAY_REAL_SECONDS};
}
// A page's StyleClock (verse_style_clock: realms.json "clock", host.js's now= and day=) held from
// tick `epoch`: its time of day then is the clock's `at`. A fixed clock is authored; a cycle or real
// one comes from `source` (local when it is the page's own facts).
day_from_style :: (c: StyleClock, hz: u32, epoch: s64, source: DaySource) -> DayClock #effects(all) {
  at := cast(f64) c.at;
  if c.mode == STYLE_CLOCK_CYCLE { return day_cycle(at, hz, epoch, source); }
  if c.mode == STYLE_CLOCK_REAL { return day_real(at, hz, epoch, source); }
  f := day_fixed(at, hz); f.epoch = epoch;
  return f;
}
// The room server's day (W: TICK, HZ and DAY, ms into a day `len_ms` long, room-sky.coax), anchored at
// the tick of a midnight: the header's ms rounded to the nearest tick, taken back from its tick, and
// reduced to the first day of ticks, so the clock is the same whichever W a seat heard. A day must be a
// whole number of ticks; a header out of range or a day that is not gives a clock day_check refuses.
day_from_room :: (tick: s64, hz: u32, day_ms: s64, len_ms: s64) -> DayClock #effects(all) {
  per := len_ms * cast(s64) hz; days := per / 1000;
  c := day_cycle(0, hz, 0, DaySource.authority);
  c.seconds = cast(f64) len_ms / 1000;
  if day_ms < 0 || day_ms >= len_ms || per % 1000 != 0 || days <= 0 { c.at = -1; return c; }
  c.epoch = ((tick - (day_ms * cast(s64) hz + 500) / 1000) % days + days) % days;
  return c;
}

// ---- admission and the day

day_finite :: (x: f64) -> bool #effects(all) { return x - x == 0; }
day_check :: (c: DayClock, world: DayWorld) -> DayRefusal #effects(all) {
  if c.version != DAY_VERSION { return DayRefusal.version; }
  if c.hz == 0 || c.hz > DAY_HZ_MAX { return DayRefusal.rate; }
  if !day_finite(c.at) || !day_finite(c.seconds) { return DayRefusal.nonfinite; }
  if c.at < 0 || c.at > 1 || c.epoch < 0 || c.epoch >= DAY_TICK_MAX { return DayRefusal.range; }
  if c.seconds < DAY_SECONDS_MIN || c.seconds > DAY_SECONDS_MAX { return DayRefusal.length; }
  if c.mode == DayMode.real && c.seconds != DAY_REAL_SECONDS { return DayRefusal.length; }
  if world == DayWorld.shared && c.mode != DayMode.fixed && c.source == DaySource.local { return DayRefusal.local_clock; }
  return DayRefusal.none;
}
// The day (a count of days; its fraction is the time of day) at simulation tick `tick`.
day_at :: (c: DayClock, world: DayWorld, tick: s64) -> DayRead #effects(all) {
  out: DayRead;
  out.refusal = day_check(c, world);
  if out.refusal == DayRefusal.none && (tick < 0 || tick >= DAY_TICK_MAX) { out.refusal = DayRefusal.range; }
  if out.refusal != DayRefusal.none { return out; }
  out.day = c.at;
  if c.mode != DayMode.fixed { out.day = c.at + cast(f64) (tick - c.epoch) / (cast(f64) c.hz * c.seconds); }
  return out;
}
// The EnvironmentState env_resolve takes at `tick` for `profile` (0: the set's default).
day_state :: (c: DayClock, world: DayWorld, tick: s64, profile: u32) -> DayState #effects(all) {
  out: DayState;
  r := day_at(c, world, tick);
  out.refusal = r.refusal;
  if r.refusal != DayRefusal.none { return out; }
  out.state = env.EnvironmentState.{version = env.ENV_VERSION, profile = profile, day = r.day};
  return out;
}
day_clock_same :: (a: DayClock, b: DayClock) -> bool #effects(all) {
  return a.version == b.version && a.mode == b.mode && a.source == b.source && a.hz == b.hz && a.epoch == b.epoch && a.at == b.at && a.seconds == b.seconds;
}
