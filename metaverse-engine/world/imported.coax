// An imported world: the reader (imported-read.coax) and the shared walker's World over a map's colliders.
// A realm that walks an imported pack loads this file; one with its own World loads imported-read.coax.
//   coax/bin/coax test metaverse-engine/world/imported.coax
#load "imported-read.coax";
#load "../move/walk.coax" as walker;

// The shared walker's World over a map's colliders (c must stay put while the World is used).
iw_walker :: (w: [] IwWorld, map: int, c: [] IwColliders) -> walker.World #effects(all) {
  return walker.World.{ground = w[0].maps[map].fall - 1000, room = 400, walls = c[0].walls[0..<c[0].nw * 6], floors = c[0].floors[0..<c[0].nf * STAND_FLOATS],
    hulls = c[0].hulls[0..<c[0].hull_words], bodies = c[0].bodies[0..<c[0].nb * 7]};
}

#load "imported-checks.coax" #test;
