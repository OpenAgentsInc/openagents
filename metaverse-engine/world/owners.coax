// Two adjacent simulation owners, qualified before any dynamic partitioning (GitHub #12851). This
// is a finite prototype, not a claim of unlimited density: two cells side by side, split at x = 0,
// each stepped by its own owner (side 0 for x < 0, side 1 for x >= 0), with a link between them
// that delivers a message OW_LINK ticks later, or never while the neighbour is down.
//
// The contract:
// - Ownership is the directory's: one (owner, generation) a entity, changed only by a
//   compare-and-set (ow_cas). An owner writes only the entities the directory gives it. A message
//   that carries an older generation than the directory's is fenced and counted: an old owner that
//   resumes from stale state can't change the world.
// - Each owner keeps read-only replicas of the neighbour's entities within OW_BORDER of the line,
//   refreshed each tick with their age. A replica is for range and sight checks only: observing
//   state never gives write authority, and a replica older than OW_STALE ticks is not used.
// - An interaction across the line is routed to the target's owner as a request carrying the
//   attacker's position and generation. The target's owner checks range against its own
//   authoritative target (with OW_SLACK metres for the link's lag) and applies requests in one
//   order: by the tick they were sent, then by attacker id. Same-side hits take the same path with
//   no link delay, so the rules are the same either side of the line.
// - An entity that crosses the line is handed off: the directory moves to the neighbour first,
//   then its state follows; it does not step while in flight (the handoff's cost, counted in
//   ticks). If the directory can't be reached, or the neighbour is down, the split is refused and
//   the entity stays at the line under its owner.
// - An entity in a fight (it hit or was hit in the last OW_ENGAGED ticks) stays with its owner up
//   to OW_OVERREACH metres past the line: a tightly coupled group is kept under one owner rather
//   than split mid-fight. Past the overreach it stops at that edge until the fight ends.
//
// ow_run measures messages, replica age, handoff ticks and the fairness of a fight across the line
// against the same fight inside one owner; the checks inject an old owner's resume, a lost
// neighbour, stale replicas and a failed cutover.
//   coax/bin/coax test metaverse-engine/world/owners.coax --library
//   coax/bin/coax mutate metaverse-engine/world/owners.coax --library

#module "metaverse.engine.world.owners";
#authority;

// book:begin owners-profile
OW_MAX :: 12;            // entities in the prototype
OW_QUEUE :: 512;         // messages in flight at once
OW_LINK :: 3;            // ticks a message takes between owners
OW_BORDER :: 20.0;       // metres from the line that an owner replicates to its neighbour
OW_STALE :: 8;           // ticks after which a replica is not used
OW_RANGE :: 6.0;         // metres a hit reaches
OW_SLACK :: 1.0;         // metres the target's owner allows for the link's lag
OW_ENGAGED :: 16;        // ticks after a hit that an entity counts as in a fight
OW_OVERREACH :: 12.0;    // metres past the line an owner keeps a fighting entity
OW_HIT_EVERY :: 8;       // ticks between one entity's hits

OW_REPLICA :: 1; OW_HIT :: 2; OW_HANDOFF :: 3;

OwEntity :: struct { x: f32; z: f32; vx: f32; hp: int = 10; target: int = -1; engaged: int = -1000; }
OwMessage :: struct { due: int; to: int; kind: int; id: int; gen: int; sent: int; e: OwEntity; attacker: int; ax: f32; az: f32; }
OwSide :: struct {
  up: bool = true;
  own: [OW_MAX] bool;              // what this owner writes: the directory gave it these
  ent: [OW_MAX] OwEntity;          // its entities' state (and, where !own, its last replica)
  seen: [OW_MAX] int;              // the tick each replica was sent (or the entity spawned)
  gen: [OW_MAX] int;               // the generation each entity has here
}
OwWorld :: struct {
  sides: [2] OwSide;
  dir_owner: [OW_MAX] int; dir_gen: [OW_MAX] int; dir_up: bool = true;
  in_flight: [OW_MAX] bool;        // handed off, state not yet arrived
  q: [OW_QUEUE] OwMessage; q_n: int;
  n: int; tick: int; link: int = OW_LINK;
  // what the run measured
  messages: int; most_age: int; handoffs: int; flight_ticks: int; refused_splits: int; kept: int;
  fenced: int; misrouted: int; stale_refused: int; out_of_range: int; hits: int; lost_messages: int;
  order: int;                      // the hits applied, in order, as one number: (order * 31 + attacker + 1) mod 1000003
}
// book:end owners-profile

ow_side_of :: (x: f32) -> int #effects(all) { return ifx x < 0 then 0 else 1; }
ow_abs :: (a: f32) -> f32 #effects(all) { return abs(a); }
ow_most :: (a: int, b: int) -> int #effects(all) { return cast(int) ((f32(a + b) + abs(f32(a - b))) / 2); }
ow_dist :: (ax: f32, az: f32, bx: f32, bz: f32) -> f32 #effects(all) { dx := ax - bx; dz := az - bz; return sqrt(dx * dx + dz * dz); }

// Adds an entity on the side its position is on.
ow_add :: (w: [] OwWorld, e: OwEntity) -> int #effects(all) {
  if w[0].n >= OW_MAX { return -1; }
  i := w[0].n; w[0].n += 1;
  s := ow_side_of(e.x);
  w[0].dir_owner[i] = s; w[0].dir_gen[i] = 0;
  for k: 0..<2 { w[0].sides[k].seen[i] = w[0].tick; w[0].sides[k].ent[i] = e; }   // both saw it spawn
  w[0].sides[s].own[i] = true;
  return i;
}

// book:begin owners-directory
// The directory's one write: entity i from (from, gen) to `to` at gen + 1. False, and nothing
// changes, if the directory is down or doesn't hold (from, gen).
ow_cas :: (w: [] OwWorld, i: int, from: int, gen: int, to: int) -> bool #effects(all) {
  if !w[0].dir_up || w[0].dir_owner[i] != from || w[0].dir_gen[i] != gen { return false; }
  w[0].dir_owner[i] = to; w[0].dir_gen[i] = gen + 1;
  return true;
}
// book:end owners-directory

// Queues a message `delay` ticks away: its slot, or -1 (and counted lost) when the queue is full.
// Messages between owners (any delay) are counted; a side's message to itself is not.
ow_send :: (w: [] OwWorld, to: int, kind: int, id: int, gen: int, e: OwEntity, delay: int) -> int #effects(all) {
  if w[0].q_n >= OW_QUEUE { w[0].lost_messages += 1; return -1; }
  k := w[0].q_n;
  w[0].q[k] = OwMessage.{due = w[0].tick + delay, to = to, kind = kind, id = id, gen = gen, sent = w[0].tick, e = e};
  w[0].q_n += 1;
  if delay > 0 { w[0].messages += 1; }
  return k;
}

// book:begin owners-receive
// Side s takes what is due to it: replicas, handoffs, and hits in one order (sent tick, then
// attacker). A down side receives nothing; what was due to it is lost.
ow_receive :: (w: [] OwWorld, s: int) #effects(all) {
  hits: [OW_QUEUE] OwMessage; hit_n := 0;
  keep := 0;
  for k: 0..<w[0].q_n {
    m := w[0].q[k];
    if m.to != s || m.due > w[0].tick { w[0].q[keep] = m; keep += 1; continue; }
    if !w[0].sides[s].up { w[0].lost_messages += 1; continue; }
    if m.kind != OW_HIT && m.gen < w[0].dir_gen[m.id] { w[0].fenced += 1; continue; }   // an old owner's
    if m.kind == OW_REPLICA {
      if !w[0].sides[s].own[m.id] && m.sent > w[0].sides[s].seen[m.id] { w[0].sides[s].ent[m.id] = m.e; w[0].sides[s].seen[m.id] = m.sent; w[0].sides[s].gen[m.id] = m.gen; }
    } else if m.kind == OW_HANDOFF {
      // once: a handoff sent again (a stale copy of the old owner) finds its entity already landed
      if w[0].in_flight[m.id] && w[0].dir_owner[m.id] == s && w[0].dir_gen[m.id] == m.gen {
        w[0].sides[s].own[m.id] = true; w[0].sides[s].ent[m.id] = m.e; w[0].sides[s].gen[m.id] = m.gen;
        w[0].in_flight[m.id] = false;
      } else { w[0].fenced += 1; }
    } else { hits[hit_n] = m; hit_n += 1; }
  }
  // hits, sorted by (sent, attacker): an insertion sort
  for a: 1..<hit_n {
    v := hits[a]; b := a - 1;
    while b >= 0 && (hits[b].sent > v.sent || (hits[b].sent == v.sent && hits[b].attacker > v.attacker)) { hits[b + 1] = hits[b]; b -= 1; }
    hits[b + 1] = v;
  }
  for h: 0..<hit_n {
    m := hits[h];
    t := m.id;
    if m.gen < w[0].dir_gen[m.attacker] { w[0].fenced += 1; continue; }   // from an attacker's old owner
    if !w[0].sides[s].own[t] { w[0].misrouted += 1; continue; }          // the target moved on: the hit misses
    te := w[0].sides[s].ent[t];
    if te.hp <= 0 { continue; }
    if ow_dist(m.ax, m.az, te.x, te.z) > OW_RANGE + OW_SLACK { w[0].out_of_range += 1; continue; }
    w[0].sides[s].ent[t].hp -= 1; w[0].sides[s].ent[t].engaged = w[0].tick; w[0].hits += 1;
    w[0].order = (w[0].order * 31 + m.attacker + 1) % 1000003;
  }
  w[0].q_n = keep;
}
// book:end owners-receive

// book:begin owners-step
// Side s steps the entities it owns: hits it may make (from its own state or a fresh replica),
// movement, the line, and its replicas to the neighbour.
ow_step_side :: (w: [] OwWorld, s: int) #effects(all) {
  sd := w[0].sides[s..<s + 1];
  if !sd[0].up { return; }
  other := 1 - s;
  for i: 0..<w[0].n {
    if !sd[0].own[i] || w[0].dir_owner[i] != s || w[0].dir_gen[i] != sd[0].gen[i] { continue; }   // only what the directory gives it
    e := sd[0].ent[i];
    if e.hp <= 0 { continue; }
    t := e.target;
    if t >= 0 && (w[0].tick + i) % OW_HIT_EVERY == 0 {
      fresh := sd[0].own[t] || w[0].tick - sd[0].seen[t] <= OW_STALE;
      te := sd[0].ent[t];
      if !fresh { w[0].stale_refused += 1; }
      else if te.hp > 0 && ow_dist(e.x, e.z, te.x, te.z) <= OW_RANGE {
        to := ifx sd[0].own[t] then s else other;
        k := ow_send(w, to, OW_HIT, t, sd[0].gen[i], te, ifx to == s then 0 else w[0].link);
        if k >= 0 { w[0].q[k].attacker = i; w[0].q[k].ax = e.x; w[0].q[k].az = e.z; }
        e.engaged = w[0].tick;
      }
    }
    fighting := w[0].tick - e.engaged <= OW_ENGAGED;
    nx := e.x + e.vx;
    if fighting && ow_abs(nx) > OW_OVERREACH && ow_side_of(nx) != s { nx = e.x; }   // the fight stays whole
    e.x = nx;
    if ow_side_of(e.x) != s {
      if fighting { w[0].kept += 1; }
      else if w[0].sides[other].up && ow_cas(w, i, s, sd[0].gen[i], other) {
        sd[0].own[i] = false; w[0].in_flight[i] = true; w[0].handoffs += 1;
        sd[0].ent[i] = e; sd[0].seen[i] = w[0].tick;   // what it handed over is its replica now
        _ := ow_send(w, other, OW_HANDOFF, i, sd[0].gen[i] + 1, e, w[0].link);
      } else {
        // the split is refused: it stays on this side of the line
        w[0].refused_splits += 1; e.x = ifx s == 0 then -0.001 else 0;
      }
    }
    if sd[0].own[i] { sd[0].ent[i] = e; }
    if sd[0].own[i] && ow_abs(e.x) <= OW_BORDER { _ := ow_send(w, other, OW_REPLICA, i, sd[0].gen[i], e, w[0].link); }
  }
}
// One tick: both sides receive, then both step; replica age measured after.
ow_tick :: (w: [] OwWorld) #effects(all) {
  ow_receive(w, 0); ow_receive(w, 1);
  ow_step_side(w, 0); ow_step_side(w, 1);
  for i: 0..<w[0].n {
    if w[0].in_flight[i] { w[0].flight_ticks += 1; }
    for s: 0..<2 {
      if w[0].sides[s].own[i] { continue; }
      other_has := w[0].sides[1 - s].own[i] && ow_abs(w[0].sides[1 - s].ent[i].x) <= OW_BORDER;
      age := w[0].tick - w[0].sides[s].seen[i];
      if other_has && w[0].sides[s].up && w[0].sides[1 - s].up { w[0].most_age = ow_most(w[0].most_age, age); }
    }
  }
  w[0].tick += 1;
}
// book:end owners-step

// Entity i's state as its directory owner has it, and how many sides think they own it.
ow_truth :: (w: [] OwWorld, i: int) -> OwEntity #effects(all) { return w[0].sides[w[0].dir_owner[i]].ent[i]; }
ow_claims :: (w: [] OwWorld, i: int) -> int #effects(all) {
  n := 0;
  for s: 0..<2 { if w[0].sides[s].own[i] && w[0].dir_owner[i] == s && w[0].dir_gen[i] == w[0].sides[s].gen[i] { n += 1; } }
  return n;
}

// ---- checks
#load "../tests/owners-oracle.coax" #test;

#test "owners: a fight across the line at zero link delay is the fight inside one owner" {
  w: [1] OwWorld;
  inside := ow_fight(w[..], -6, -2, 0, 600);
  ha := ow_truth(w[..], 0).hp; hb := ow_truth(w[..], 1).hp;
  across := ow_fight(w[..], -2, 2, 0, 600);
  #assert inside > 0 && inside == across && ow_truth(w[..], 0).hp == ha && ow_truth(w[..], 1).hp == hb;
  #assert w[0].hits > 0 && w[0].fenced == 0 && w[0].stale_refused == 0;
}

#test "owners: across a link the fight costs at most the link per hit, and replicas stay fresh" {
  w: [1] OwWorld;
  inside := ow_fight(w[..], -6, -2, OW_LINK, 600);
  across := ow_fight(w[..], -2, 2, OW_LINK, 600);
  #assert across >= inside && across <= inside + OW_LINK;
  #assert w[0].most_age <= OW_LINK && w[0].hits >= 10 && w[0].out_of_range == 0 && w[0].messages <= 2 * w[0].tick + w[0].hits;
}

#test "owners: a crowd crossing the line is handed off once each, never owned twice" {
  w: [1] OwWorld; ow_crowd(w[..]);
  for t: 0..<120 { ow_tick(w[..]); #assert ow_one_owner(w[..]); }
  #assert w[0].handoffs == 8 && w[0].flight_ticks == 8 * OW_LINK && w[0].most_age <= 2 * OW_LINK;
  for i: 0..<4 { #assert w[0].dir_owner[i] == 1 && ow_truth(w[..], i).x > 0 && w[0].dir_gen[i] == 1; }
  for i: 4..<8 { #assert w[0].dir_owner[i] == 0 && ow_truth(w[..], i).x < 0; }
}

#test "owners: a fight near the line stays under one owner, up to the overreach" {
  w: [1] OwWorld; w[0] = OwWorld.{};
  a := ow_add(w[..], OwEntity.{x = -3, vx = 0.2, target = 1}); b := ow_add(w[..], OwEntity.{x = -1, vx = 0.2, target = 0});
  for t: 0..<60 { ow_tick(w[..]); #assert ow_one_owner(w[..]); }
  #assert w[0].kept > 0 && w[0].dir_owner[a] == 0 && w[0].dir_owner[b] == 0 && ow_truth(w[..], b).x <= OW_OVERREACH;
  // when the fight ends, the survivor crosses
  for t: 0..<400 { ow_tick(w[..]); #assert ow_one_owner(w[..]); }
  #assert ow_truth(w[..], a).hp <= 0 || ow_truth(w[..], b).hp <= 0;
  #assert w[0].dir_owner[a] == 1 || w[0].dir_owner[b] == 1;
}

#test "owners: an old owner's writes, sent again after the realm moved on, change nothing" {
  ref: [1] OwWorld; ow_crowd(ref[..]);
  for t: 0..<120 { ow_tick(ref[..]); }
  w: [1] OwWorld; ow_crowd(w[..]);
  old: [OW_QUEUE] OwMessage; old_n := 0;
  for t: 0..<120 {
    if t == 30 { for k: 0..<w[0].q_n { if w[0].q[k].to == 1 { old[old_n] = w[0].q[k]; old_n += 1; } } }
    if t == 80 {
      // a stale copy of side 0 sends what it sent at tick 30 again
      for k: 0..<old_n { m := old[k]; m.due = w[0].tick + OW_LINK; w[0].q[w[0].q_n] = m; w[0].q_n += 1; }
    }
    ow_tick(w[..]);
    #assert ow_one_owner(w[..]);
  }
  #assert old_n > 0 && w[0].fenced > ref[0].fenced;
  for i: 0..<w[0].n { #assert ow_truth(w[..], i).x == ow_truth(ref[..], i).x && w[0].dir_owner[i] == ref[0].dir_owner[i]; }
}

#test "owners: a lost neighbour stops hits across the line and refuses splits; a lost directory refuses splits" {
  w: [1] OwWorld; w[0] = OwWorld.{};
  a := ow_add(w[..], OwEntity.{x = -2, target = 1}); b := ow_add(w[..], OwEntity.{x = 2, target = 0});
  c := ow_add(w[..], OwEntity.{x = -10, z = 30, vx = 0.5});
  for t: 0..<10 { ow_tick(w[..]); }
  w[0].sides[1].up = false;
  hp := ow_truth(w[..], b).hp;
  for t: 0..<60 { ow_tick(w[..]); }
  #assert w[0].stale_refused > 0 && w[0].lost_messages > 0 && ow_truth(w[..], b).hp == hp;
  #assert w[0].refused_splits > 0 && w[0].dir_owner[c] == 0 && ow_truth(w[..], c).x < 0;
  w[0].sides[1].up = true;
  for t: 0..<10 { ow_tick(w[..]); }
  #assert w[0].dir_owner[c] == 1 && ow_one_owner(w[..]);
  // the directory down: no handoff
  d: [1] OwWorld; d[0] = OwWorld.{};
  e := ow_add(d[..], OwEntity.{x = -1, vx = 0.5});
  d[0].dir_up = false;
  for t: 0..<20 { ow_tick(d[..]); }
  #assert d[0].dir_owner[e] == 0 && d[0].refused_splits > 0 && ow_truth(d[..], e).x < 0 && ow_one_owner(d[..]);
  #assert !ow_cas(d[..], e, 0, 0, 1);
  d[0].dir_up = true;
  #assert !ow_cas(d[..], e, 1, 0, 0) && !ow_cas(d[..], e, 0, 1, 1) && ow_cas(d[..], e, 0, 0, 1) && d[0].dir_gen[e] == 1;
}

#test "owners: the prototype holds OW_MAX entities and its queue" {
  w: [1] OwWorld; w[0] = OwWorld.{};
  for k: 0..<OW_MAX { #assert ow_add(w[..], OwEntity.{x = f32(k) - 6}) == k; }
  #assert ow_add(w[..], OwEntity.{}) == -1 && ow_side_of(-0.001) == 0 && ow_side_of(0) == 1 && ow_abs(-2) == 2 && ow_dist(0, 0, 3, 4) == 5;
  w[0].q_n = OW_QUEUE;
  #assert ow_send(w[..], 0, OW_REPLICA, 0, 0, OwEntity.{}, 1) == -1;
  #assert w[0].lost_messages == 1 && w[0].q_n == OW_QUEUE;
}

#test "owners: adding, sending and the directory's counters, one at a time" {
  #assert ow_dist(0, 1, 0, 4) == 3 && ow_abs(0) == 0 && ow_abs(3) == 3 && ow_most(2, 5) == 5 && ow_most(5, 2) == 5 && ow_most(4, 4) == 4;
  w: [1] OwWorld; w[0] = OwWorld.{};
  w[0].tick = 5; w[0].dir_gen[0] = 7;
  #assert ow_add(w[..], OwEntity.{x = -1, hp = 4}) == 0;
  #assert w[0].dir_gen[0] == 0 && w[0].dir_owner[0] == 0 && w[0].sides[0].seen[0] == 5 && w[0].sides[1].seen[0] == 5 && w[0].sides[1].ent[0].hp == 4;
  #assert w[0].sides[0].own[0] && !w[0].sides[1].own[0];
  #assert ow_send(w[..], 0, OW_HIT, 0, 0, OwEntity.{}, 0) == 0 && w[0].messages == 0;
  #assert ow_send(w[..], 1, OW_REPLICA, 0, 0, OwEntity.{}, 3) == 1 && w[0].messages == 1 && w[0].q[1].due == 8 && w[0].q[1].sent == 5 && w[0].q_n == 2;
  #assert ow_send(w[..], 1, OW_REPLICA, 0, 0, OwEntity.{}, 1) == 2 && w[0].messages == 2;
  // what a side receives: only what is due to it; a down side loses it
  w[0].q_n = 0;
  _ := ow_send(w[..], 1, OW_REPLICA, 0, 0, OwEntity.{}, 0); _ = ow_send(w[..], 1, OW_REPLICA, 0, 0, OwEntity.{}, 2); _ = ow_send(w[..], 0, OW_REPLICA, 0, 0, OwEntity.{}, 0);
  w[0].sides[1].up = false;
  ow_receive(w[..], 1);
  #assert w[0].lost_messages == 1 && w[0].q_n == 2 && w[0].q[0].due == 7 && w[0].q[1].to == 0;
  // claims: owning it is not enough without the directory
  w[0].dir_owner[0] = 1;
  #assert ow_claims(w[..], 0) == 0;
  w[0].dir_owner[0] = 0;
  #assert ow_claims(w[..], 0) == 1;
}

#test "owners: replicas, handoffs and fences, as received" {
  w: [1] OwWorld; w[0] = OwWorld.{};
  _ := ow_add(w[..], OwEntity.{x = -1});
  w[0].dir_gen[0] = 2; w[0].sides[0].gen[0] = 2;
  w[0].tick = 6;
  _ = ow_send(w[..], 1, OW_REPLICA, 0, 1, OwEntity.{x = -9}, 0);    // an older generation's: fenced
  _ = ow_send(w[..], 1, OW_REPLICA, 0, 2, OwEntity.{x = -3}, 0);
  ow_receive(w[..], 1);
  #assert w[0].fenced == 1 && w[0].sides[1].ent[0].x == -3 && w[0].sides[1].seen[0] == 6 && w[0].sides[1].gen[0] == 2;
  // not newer than what it has: kept as it was
  _ = ow_send(w[..], 1, OW_REPLICA, 0, 2, OwEntity.{x = -4}, 0);
  w[0].tick = 7; w[0].q[0].sent = 6;
  ow_receive(w[..], 1);
  #assert w[0].sides[1].ent[0].x == -3;
  w[0].q[0] = OwMessage.{due = 7, to = 1, kind = OW_REPLICA, id = 0, gen = 2, sent = 5, e = OwEntity.{x = -5}}; w[0].q_n = 1;
  ow_receive(w[..], 1);
  #assert w[0].sides[1].ent[0].x == -3 && w[0].q_n == 0;
  // the owner's own entity takes no replica
  _ = ow_send(w[..], 0, OW_REPLICA, 0, 2, OwEntity.{x = -8}, 0);
  w[0].sides[0].seen[0] = 0; w[0].sides[0].ent[0].x = -1;
  ow_receive(w[..], 0);
  #assert w[0].sides[0].ent[0].x == -1;
  // a handoff lands once
  w[0].in_flight[0] = true; w[0].dir_owner[0] = 1; w[0].dir_gen[0] = 3;
  _ = ow_send(w[..], 1, OW_HANDOFF, 0, 3, OwEntity.{x = 1, hp = 6}, 0);
  _ = ow_send(w[..], 1, OW_HANDOFF, 0, 3, OwEntity.{x = 2}, 0);
  ow_receive(w[..], 1);
  #assert w[0].sides[1].own[0] && w[0].sides[1].ent[0].x == 1 && w[0].sides[1].ent[0].hp == 6 && w[0].sides[1].gen[0] == 3 && !w[0].in_flight[0] && w[0].fenced == 2;
  // a hit with an old generation is not fenced by the target's generation
  w[0].dir_gen[1] = 0; _ = ow_add(w[..], OwEntity.{x = 2});
  _ = ow_send(w[..], 1, OW_HIT, 0, 0, OwEntity.{}, 0);
  w[0].q[0].attacker = 1; w[0].q[0].ax = 1; w[0].q[0].az = 0;
  ow_receive(w[..], 1);
  #assert w[0].fenced == 2 && w[0].hits == 1 && w[0].sides[1].ent[0].hp == 5;
}

// A hit on entity 0 at side 0, sent at `sent` from `attacker` standing at (ax, 0).
ow_hit_at :: (w: [] OwWorld, sent: int, attacker: int, ax: f32) #effects(all) {
  w[0].tick = sent;
  k := ow_send(w, 0, OW_HIT, 0, 0, OwEntity.{}, 0);
  w[0].q[k].attacker = attacker; w[0].q[k].ax = ax;
}
#test "owners: hits apply in (sent, attacker) order, once each, within range, from current owners" {
  w: [1] OwWorld; w[0] = OwWorld.{};
  t := ow_add(w[..], OwEntity.{x = -1, hp = 10});
  for k: 0..<4 { _ := ow_add(w[..], OwEntity.{x = -2}); }
  ow_hit_at(w[..], 2, 3, -2); ow_hit_at(w[..], 1, 2, -2); ow_hit_at(w[..], 1, 1, -2); ow_hit_at(w[..], 2, 1, -2);
  w[0].tick = 3;
  ow_receive(w[..], 0);
  o := 0;
  for a: 0..<4 { att := [4] int.[1, 2, 1, 3][a]; o = (o * 31 + att + 1) % 1000003; }
  #assert w[0].order == o && w[0].hits == 4 && w[0].sides[0].ent[t].hp == 6 && w[0].sides[0].ent[t].engaged == 3;
  // from an attacker's old owner: fenced; at the reach plus the slack: lands; past it: out of range
  w[0].dir_gen[4] = 1;
  ow_hit_at(w[..], 4, 4, -2); ow_hit_at(w[..], 4, 2, -1 - OW_RANGE - OW_SLACK); ow_hit_at(w[..], 4, 3, -1.5 - OW_RANGE - OW_SLACK);
  w[0].tick = 4;
  ow_receive(w[..], 0);
  #assert w[0].fenced == 1 && w[0].hits == 5 && w[0].out_of_range == 1 && w[0].sides[0].ent[t].hp == 5;
  // a target down to its last point takes one hit and no more
  w[0].sides[0].ent[t].hp = 1;
  ow_hit_at(w[..], 5, 1, -2); ow_hit_at(w[..], 5, 2, -2);
  ow_receive(w[..], 0);
  #assert w[0].hits == 6 && w[0].sides[0].ent[t].hp == 0 && w[0].out_of_range == 1;
  // equal keys keep the order they came in: here an in-range hit first, so the out-of-range one finds
  // the target down
  w[0].sides[0].ent[t].hp = 1;
  ow_hit_at(w[..], 7, 1, -2); ow_hit_at(w[..], 7, 1, -30);
  ow_receive(w[..], 0);
  #assert w[0].out_of_range == 1 && w[0].sides[0].ent[t].hp == 0;
  // of equal ticks, the lower attacker first, though it came second
  w[0].sides[0].ent[t].hp = 1;
  ow_hit_at(w[..], 8, 2, -30); ow_hit_at(w[..], 8, 1, -2);
  ow_receive(w[..], 0);
  #assert w[0].out_of_range == 1 && w[0].sides[0].ent[t].hp == 0;
  w[0].sides[0].ent[t].hp = 1;
  ow_hit_at(w[..], 9, 1, -2); ow_hit_at(w[..], 9, 2, -30);
  ow_receive(w[..], 0);
  #assert w[0].out_of_range == 1;
  // the order number wraps at 1000003
  w[0].sides[0].ent[t].hp = 5; w[0].order = 1000002;
  ow_hit_at(w[..], 10, 3, -2);
  ow_receive(w[..], 0);
  #assert w[0].order == (1000002 * 31 + 4) % 1000003;
  // a target that moved on: missed
  w[0].sides[0].own[t] = false;
  before := w[0].hits;
  ow_hit_at(w[..], 11, 1, -2);
  ow_receive(w[..], 0);
  #assert w[0].misrouted == 1 && w[0].hits == before;
}

#test "owners: what a side steps, and when it hits" {
  w: [1] OwWorld; w[0] = OwWorld.{};
  a := ow_add(w[..], OwEntity.{x = -5, vx = -1});
  b := ow_add(w[..], OwEntity.{x = -6, vx = -1, hp = 0});
  c := ow_add(w[..], OwEntity.{x = -7, vx = -1});
  w[0].dir_gen[c] = 1;   // its directory moved on
  ow_step_side(w[..], 0);
  #assert w[0].sides[0].ent[a].x == -6 && w[0].sides[0].ent[b].x == -6 && w[0].sides[0].ent[c].x == -7;
  w[0].dir_gen[c] = 0; w[0].dir_owner[c] = 1;
  ow_step_side(w[..], 0);
  #assert w[0].sides[0].ent[c].x == -7;
  // hits every OW_HIT_EVERY ticks, offset by the attacker's index, within the reach
  h: [1] OwWorld; h[0] = OwWorld.{};
  _ := ow_add(h[..], OwEntity.{x = -30, z = 3});
  x := ow_add(h[..], OwEntity.{x = -30 - OW_RANGE, z = 3, target = 0});
  h[0].tick = OW_HIT_EVERY - 1;
  ow_step_side(h[..], 0);
  #assert h[0].q_n == 1 && h[0].q[0].kind == OW_HIT && h[0].q[0].attacker == x && h[0].q[0].due == h[0].tick && h[0].q[0].ax == -30 - OW_RANGE && h[0].q[0].az == 3 && h[0].messages == 0;
  #assert h[0].sides[0].ent[x].engaged == h[0].tick;
  h[0].tick = OW_HIT_EVERY; ow_step_side(h[..], 0);
  #assert h[0].q_n == 1;
  h[0].sides[0].ent[x].x = -30.5 - OW_RANGE; h[0].tick = 2 * OW_HIT_EVERY - 1; ow_step_side(h[..], 0);
  #assert h[0].q_n == 1;
  h[0].sides[0].ent[x].x = -30 - OW_RANGE; h[0].sides[0].ent[0].hp = 0; h[0].tick = 3 * OW_HIT_EVERY - 1; ow_step_side(h[..], 0);
  #assert h[0].q_n == 1;
  // the first entity hits on the tick itself, and a target on the other side is sent a link away
  f: [1] OwWorld; f[0] = OwWorld.{};
  p := ow_add(f[..], OwEntity.{x = -1, target = 1});
  _ = ow_add(f[..], OwEntity.{x = 1});
  f[0].tick = OW_HIT_EVERY; f[0].sides[0].seen[1] = OW_HIT_EVERY - OW_STALE;
  ow_step_side(f[..], 0);
  #assert f[0].q[0].kind == OW_HIT && f[0].q[0].to == 1 && f[0].q[0].due == OW_HIT_EVERY + OW_LINK && f[0].messages >= 1;
  // a replica older than OW_STALE is not used
  f[0].tick = 2 * OW_HIT_EVERY; f[0].sides[0].seen[1] = 2 * OW_HIT_EVERY - OW_STALE - 1; f[0].q_n = 0;
  ow_step_side(f[..], 0);
  #assert f[0].stale_refused == 1 && f[0].q_n <= 1 && (f[0].q_n == 0 || f[0].q[0].kind == OW_REPLICA);
  // an entity's own target: no target, no hit
  n: [1] OwWorld; n[0] = OwWorld.{};
  _ = ow_add(n[..], OwEntity.{x = -30});
  ow_step_side(n[..], 0);
  #assert n[0].q_n == 0;
}

#test "owners: crossing the line: kept in a fight, handed off, or refused" {
  // a fight: OW_ENGAGED ticks after its last hit it still counts
  w: [1] OwWorld; w[0] = OwWorld.{};
  a := ow_add(w[..], OwEntity.{x = -0.5, vx = 1});
  w[0].tick = 100; w[0].sides[0].ent[a].engaged = 100 - OW_ENGAGED;
  ow_step_side(w[..], 0);
  #assert w[0].kept == 1 && w[0].dir_owner[a] == 0 && w[0].sides[0].own[a] && w[0].sides[0].ent[a].x == 0.5;
  // past the overreach it stops; up to it, it moves; on its own side, nothing holds it
  w[0].sides[0].ent[a].x = 11.5; w[0].sides[0].ent[a].vx = 0.5; w[0].sides[0].ent[a].engaged = 100;
  ow_step_side(w[..], 0);
  #assert w[0].sides[0].ent[a].x == 12;
  ow_step_side(w[..], 0);
  #assert w[0].sides[0].ent[a].x == 12 && w[0].kept == 3;
  g := ow_add(w[..], OwEntity.{x = -13, vx = -1, engaged = 100});
  ow_step_side(w[..], 0);
  #assert w[0].sides[0].ent[g].x == -14;
  // not in a fight (one tick longer ago): handed off
  h: [1] OwWorld; h[0] = OwWorld.{};
  b := ow_add(h[..], OwEntity.{x = -0.5, vx = 1});
  h[0].tick = 100; h[0].sides[0].ent[b].engaged = 100 - OW_ENGAGED - 1;
  ow_step_side(h[..], 0);
  #assert h[0].kept == 0 && h[0].handoffs == 1 && !h[0].sides[0].own[b] && h[0].in_flight[b] && h[0].dir_owner[b] == 1 && h[0].dir_gen[b] == 1;
  #assert h[0].sides[0].ent[b].x == 0.5 && h[0].sides[0].seen[b] == 100 && h[0].q_n == 1 && h[0].q[0].kind == OW_HANDOFF && h[0].q[0].gen == 1 && h[0].q[0].due == 100 + OW_LINK;
  // the neighbour down: refused, at the line on its own side, from either side
  r: [1] OwWorld; r[0] = OwWorld.{};
  c := ow_add(r[..], OwEntity.{x = -0.5, vx = 1, engaged = -1000});
  d := ow_add(r[..], OwEntity.{x = 0.5, vx = -1, engaged = -1000});
  r[0].sides[1].up = false;
  ow_step_side(r[..], 0);
  #assert r[0].refused_splits == 1 && r[0].sides[0].ent[c].x == -0.001 && r[0].dir_owner[c] == 0;
  r[0].sides[1].up = true; r[0].sides[0].up = false;
  ow_step_side(r[..], 1);
  #assert r[0].refused_splits == 2 && r[0].sides[1].ent[d].x == 0;
  // replicas reach exactly OW_BORDER from the line, and the age a side holds is measured both ways
  e: [1] OwWorld; e[0] = OwWorld.{};
  _ := ow_add(e[..], OwEntity.{x = -OW_BORDER});
  _ = ow_add(e[..], OwEntity.{x = -OW_BORDER - 0.5});
  ow_step_side(e[..], 0);
  #assert e[0].q_n == 1 && e[0].q[0].id == 0 && e[0].q[0].kind == OW_REPLICA && e[0].q[0].to == 1;
  m: [1] OwWorld; m[0] = OwWorld.{};
  _ = ow_add(m[..], OwEntity.{x = OW_BORDER});
  _ = ow_add(m[..], OwEntity.{x = OW_BORDER + 0.5});
  m[0].tick = 5;
  m[0].dir_up = false;
  ow_tick(m[..]);
  #assert m[0].most_age == 5;
  far_age: [1] OwWorld; far_age[0] = OwWorld.{};
  _ = ow_add(far_age[..], OwEntity.{x = OW_BORDER + 0.5});
  far_age[0].tick = 5;
  ow_tick(far_age[..]);
  #assert far_age[0].most_age == 0;
  #assert ow_claims(m[..], 0) == 1;
}
