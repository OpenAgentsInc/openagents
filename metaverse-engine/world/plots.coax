// Plots and the build sites on them (engine): a square grid of plots in a realm, each with a stable
// id, an outline on the ground and an owner, and on each plot at most one build site with its own
// start time, tier and work time. A site's progress is one number from 0 to its tier's stage count
// (metaverse-engine/world/build-site.coax draws a structure at any value of it), worked out from the world's
// clock, so a room, a page and a recorded clip all agree on how far each house has come.
//
// The contract:
// - A plot's id is its place in the grid, 0 to n*n-1, row by row from the grid's north-west corner
//   (-x, -z). It never changes. Players see it as id + 1.
// - The grid is the zone's: its centre, its side count, its plot size and its pitch (centre to
//   centre). The lanes between plots are pitch - size wide.
// - An owner is a player id and a name. A plot is claimed by a compare-and-set: it succeeds only on
//   a free plot, by a player who holds no other plot (one plot each, at first), and it is the only
//   write to an owner.
// - A site is placed only on a claimed plot, by its owner, and only one to a plot. Its start time
//   and work time are in seconds of world time; its progress is 0 before it starts and its stage
//   count once its work time has passed, and in between rises evenly.
// - A plot's outline can draw itself on: at a fraction from 0 to 1 it is drawn that far round its
//   edge, from its north-west corner, clockwise seen from above.
//   coax/bin/coax test metaverse-engine/world/plots.coax --library

#module "metaverse.engine.world.plots";

PL_MAX :: 64;        // the most plots one grid holds (8 by 8)
PL_NAME :: 24;       // the longest owner name kept, in bytes

PlotGrid :: struct {x:f32;z:f32;n:int;size:f32;pitch:f32;}
PlotOwner :: struct {player:int = -1;name:[PL_NAME]u8;name_n:int;}
// A build site: tier (the game's), the stages it has, when its work starts and how long it takes,
// and the quarters its front is turned.
PlotSite :: struct {on:bool;tier:int;stages:int;start:f32;work:f32;turn:int;}
PlotBook :: struct {g:PlotGrid;owner:[PL_MAX]PlotOwner;site:[PL_MAX]PlotSite;refused:int;}

pl_count :: (g:PlotGrid)->int {return g.n*g.n;}
// A plot's centre in the world.
pl_centre :: (g:PlotGrid,id:int)->[2]f32 {
 h:=f32(g.n-1)*0.5;return [2]f32.[g.x+(f32(id%g.n)-h)*g.pitch,g.z+(f32(id/g.n)-h)*g.pitch];
}
// The plot a world point is on, or -1 in a lane or outside the grid.
pl_at :: (g:PlotGrid,x:f32,z:f32)->int {
 h:=f32(g.n)*0.5*g.pitch;cx:=x-g.x+h;cz:=z-g.z+h;
 if cx<0 || cz<0 || cx>=f32(g.n)*g.pitch || cz>=f32(g.n)*g.pitch {return -1;}
 i:=int(cx/g.pitch);j:=int(cz/g.pitch);
 lane:=(g.pitch-g.size)*0.5;ox:=cx-f32(i)*g.pitch;oz:=cz-f32(j)*g.pitch;
 if ox<lane || ox>g.pitch-lane || oz<lane || oz>g.pitch-lane {return -1;}
 return j*g.n+i;
}
// How far a grid reaches from its centre to its farthest plot corner.
pl_reach :: (g:PlotGrid)->f32 {h:=f32(g.n-1)*0.5*g.pitch+g.size*0.5;return sqrt(2*h*h);}

// A plot's outline drawn a fraction round its edge, as up to 4 segments (x0, z0, x1, z1) written to
// `out`; returns how many.
pl_outline :: (g:PlotGrid,id:int,frac:f32,out:[]f32)->int {
 c:=pl_centre(g,id);h:=g.size*0.5;
 k:=[5][2]f32.[[2]f32.[c[0]-h,c[1]-h],[2]f32.[c[0]+h,c[1]-h],[2]f32.[c[0]+h,c[1]+h],[2]f32.[c[0]-h,c[1]+h],[2]f32.[c[0]-h,c[1]-h]];
 f:=ifx frac<0 then 0.0f32 else ifx frac>1 then 1.0f32 else frac;along:=f*4;n:=0;
 for s:0..<4 {if along<=f32(s) {break;}t:=ifx along>=f32(s+1) then 1.0f32 else along-f32(s);
  out[n*4]=k[s][0];out[n*4+1]=k[s][1];out[n*4+2]=k[s][0]+(k[s+1][0]-k[s][0])*t;out[n*4+3]=k[s][1]+(k[s+1][1]-k[s][1])*t;n+=1;}
 return n;
}

pl_book :: (g:PlotGrid)->PlotBook {b:PlotBook;b.g=g;return b;}
pl_holds :: (b:[]PlotBook,player:int)->int {for i:0..<pl_count(b[0].g) {if b[0].owner[i].player==player {return i;}}return -1;}
pl_owner_name :: (b:[]PlotBook,id:int)->string {o:=b[0].owner[id..<id+1];return cast(string)o[0].name[0..<o[0].name_n];}
// The owner's one write: plot id to player, named `name`. False, counted, and nothing changes if the
// plot is taken or out of the grid, or the player already holds a plot.
pl_claim :: (b:[]PlotBook,id:int,player:int,name:string)->bool {
 if id<0 || id>=pl_count(b[0].g) || player<0 || b[0].owner[id].player>=0 || pl_holds(b,player)>=0 {b[0].refused+=1;return false;}
 b[0].owner[id].player=player;n:=ifx name.count>PL_NAME then PL_NAME else name.count;
 for i:0..<n {b[0].owner[id].name[i]=name[i];}b[0].owner[id].name_n=n;
 return true;
}
// Places a site on plot id for its owner: false, counted, if the player doesn't own it or it holds
// a site already.
pl_site :: (b:[]PlotBook,id:int,player:int,s:PlotSite)->bool {
 if id<0 || id>=pl_count(b[0].g) || b[0].owner[id].player!=player || player<0 || b[0].site[id].on || s.stages<1 || s.work<=0 {b[0].refused+=1;return false;}
 b[0].site[id]=s;b[0].site[id].on=true;return true;
}
// A site's progress at world time `now`: 0 to its stage count.
pl_progress :: (s:PlotSite,now:f32)->f32 {
 if !s.on || now<=s.start {return 0;}
 if now>=s.start+s.work {return f32(s.stages);}
 return f32(s.stages)*(now-s.start)/s.work;
}
// The whole stage a site has finished at `now` (what its colliders keep to), 0 before its first.
pl_stage_done :: (s:PlotSite,now:f32)->int {return int(floor(pl_progress(s,now)+0.0001));}
// The time at which every site on the book is finished, or 0 if it has none.
pl_all_done :: (b:[]PlotBook)->f32 {t:f32=0;for i:0..<pl_count(b[0].g) {s:=b[0].site[i];if s.on && s.start+s.work>t {t=s.start+s.work;}}return t;}

#test "plots are numbered row by row from the north-west and found again from a point" {
 g:=PlotGrid.{x=34,z= -114,n=4,size=10,pitch=12};
 #assert pl_count(g)==16;c:=pl_centre(g,0);#assert c[0]==16 && c[1]== -132;c=pl_centre(g,3);#assert c[0]==52 && c[1]== -132;c=pl_centre(g,15);#assert c[0]==52 && c[1]== -96;
 for i:0..<16 {p:=pl_centre(g,i);#assert pl_at(g,p[0],p[1])==i && pl_at(g,p[0]+4.9,p[1]-4.9)==i;}
 #assert pl_at(g,22,-126)== -1 && pl_at(g,34,-114)== -1 && pl_at(g,0,-114)== -1 && pl_at(g,34,-140)== -1;   // lanes and outside
 #assert abs(pl_reach(g)-32.527)<0.01;
}
#test "an outline draws on clockwise from its north-west corner" {
 g:=PlotGrid.{n=2,size=10,pitch=12};o:[16]f32;
 #assert pl_outline(g,0,0,o[..])==0;
 n:=pl_outline(g,0,0.125,o[..]);#assert n==1 && o[0]== -11 && o[1]== -11 && o[2]== -6 && o[3]== -11;
 n=pl_outline(g,0,0.6,o[..]);#assert n==3 && o[8]== -1 && o[9]== -1 && abs(o[10]+5)<0.0001 && o[11]== -1;
 n=pl_outline(g,0,1,o[..]);#assert n==4 && o[14]== -11 && o[15]== -11;
}
#test "a plot is claimed once, by a player holding no other, and only its owner places one site" {
 b:[1]PlotBook;b[0]=pl_book(PlotGrid.{n=4,size=10,pitch=12});
 #assert pl_claim(b[..],5,7,"Aldric Fenwood") && pl_owner_name(b[..],5)=="Aldric Fenwood";
 #assert !pl_claim(b[..],5,8,"Brin") && !pl_claim(b[..],6,7,"Aldric again") && !pl_claim(b[..],16,8,"Brin") && !pl_claim(b[..],-1,8,"Brin");
 #assert b[0].refused==4 && pl_holds(b[..],7)==5 && pl_holds(b[..],8)== -1;
 #assert pl_claim(b[..],6,8,"a name far longer than the twenty-four bytes kept") && pl_owner_name(b[..],6).count==PL_NAME;
 s:=PlotSite.{tier=1,stages=4,start=100,work=1200};
 #assert !pl_site(b[..],5,8,s) && !pl_site(b[..],0,7,s) && pl_site(b[..],5,7,s) && !pl_site(b[..],5,7,s);
 #assert b[0].refused==7 && pl_all_done(b[..])==1300;
}
#test "a site's progress rises evenly from its start to its stage count and stays there" {
 s:=PlotSite.{on=true,tier=2,stages=7,start=60,work=3600};
 #assert pl_progress(s,0)==0 && pl_progress(s,60)==0 && pl_progress(s,60+1800)==3.5 && pl_progress(s,3660)==7 && pl_progress(s,99999)==7;
 #assert pl_stage_done(s,60+1800)==3 && pl_stage_done(s,3660)==7 && pl_stage_done(s,61)==0;
 off:=s;off.on=false;#assert pl_progress(off,2000)==0;
}
