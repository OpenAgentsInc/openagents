// Portals (GitHub #13485): a way from one place in a world to another that you take with the use
// key, such as the door of a vehicle that opens onto a room inside it, kept as rows of a realm's
// content table and edited like any cell (world.edit.v1 `cell`), so undo, the revision fence and the
// server's checks hold for a portal as for every edit. This file is the row's one codec and the rule
// for which portal you stand at; the realm moves you.
//
//   table portals id name:text from:text to:text yaw:int r:int
//   ID|NAME|FROM|TO|YAW|R
//   ID     1 and up
//   NAME   what the use key's prompt says: "Enter the rover", 1 to 32 bytes
//   FROM   where you take it: "kind K", beside any placed thing of the realm's kind K (a content ID),
//          or "at X Z", at a point in whole centimetres
//   TO     where it takes you: "X Z", whole centimetres; or "ride X Z": the vehicle you are in takes
//          you there, a drive you watch from outside it (the realm draws and times the ride)
//   YAW    the way you face there, whole degrees, -179 to 180
//   R      how near FROM counts, centimetres, 50 to 1000. For a placed thing it is measured from the
//          thing's middle, so a long thing needs a long reach
// A pair of rows makes a way there and back: a vehicle's kind into a room, and a point by the room's
// door out again beside the vehicle. Nothing here reads the world: the realm says where you stand and
// where its placed things are, and asks prt_pick which portal you take.
//   coax/bin/coax test metaverse-engine/world/portal.coax --library
#load "../content/tables.coax";
#load "interact.coax";

PRT_TABLE :: "table portals id name:text from:text to:text yaw:int r:int";
PRT_NAME :: 32;           // bytes of a portal's name
PRT_MAX :: 16;            // portals a world keeps
PRT_REACH :: 1000000;     // centimetres either way a point may be
PRT_R_MIN :: 50; PRT_R_MAX :: 1000;
PRT_KIND_MAX :: 1000000;  // a content ID

Portal :: struct {
  ok: bool; id: int;
  name: [PRT_NAME] u8; name_n: int;
  kind: int;               // FROM "kind K": K; 0 for a point
  x: int; z: int;          // FROM "at X Z": the point, centimetres
  to_x: int; to_z: int;    // TO, centimetres
  ride: bool;              // TO "ride X Z": a drive there, not a step through a door
  yaw: int;                // degrees
  r: int;                  // reach, centimetres
}
PRT_OK :: 0; PRT_BAD_ID :: 1; PRT_BAD_NAME :: 2; PRT_BAD_FROM :: 3; PRT_BAD_TO :: 4; PRT_BAD_YAW :: 5; PRT_BAD_R :: 6;

prt_why :: (why: int) -> string {
  if why == PRT_BAD_ID { return "a portal's ID is 1 and up"; }
  if why == PRT_BAD_NAME { return "a portal's NAME is what the use key's prompt says: 1 to 32 bytes"; }
  if why == PRT_BAD_FROM { return "FROM is kind K (a content ID) or at X Z (whole centimetres)"; }
  if why == PRT_BAD_TO { return "TO is X Z, or ride X Z for a drive there: whole centimetres"; }
  if why == PRT_BAD_YAW { return "YAW is whole degrees, -179 to 180"; }
  if why == PRT_BAD_R { return "R is how near FROM counts: 50 to 1000 centimetres"; }
  return "";
}

// Whole numbers split by single spaces: exactly `want` of them, each within PRT_REACH, into v.
prt_numbers :: (s: string, v: [] int, want: int) -> bool {
  if s.count == 0 || ct_parts(s, ' ') != want { return false; }
  for k: 0..<want {
    n := ct_num(ct_part(s, ' ', k));
    if !n.ok || n.v < -PRT_REACH || n.v > PRT_REACH { return false; }
    v[k] = n.v;
  }
  return true;
}
// Reads a row's cells into p. PRT_OK, or why not; p is not ok unless it reads.
prt_read :: (id: int, name: string, from: string, to: string, yaw: int, r: int, p: [] Portal) -> int {
  p[0] = Portal.{};
  if id < 1 { return PRT_BAD_ID; }
  if name.count < 1 || name.count > PRT_NAME { return PRT_BAD_NAME; }
  v: [2] int;
  if from.count > 5 && from[0..<5] == "kind " {
    n := ct_num(from[5..<from.count]);
    if !n.ok || n.v < 1 || n.v > PRT_KIND_MAX || from[5] == '-' { return PRT_BAD_FROM; }
    p[0].kind = n.v;
  } else if from.count > 3 && from[0..<3] == "at " && prt_numbers(from[3..<from.count], v[..], 2) {
    p[0].x = v[0]; p[0].z = v[1];
  } else { return PRT_BAD_FROM; }
  ride := to.count > 5 && to[0..<5] == "ride ";
  if !prt_numbers(ifx ride then to[5..<to.count] else to, v[..], 2) { return PRT_BAD_TO; }
  if yaw < -179 || yaw > 180 { return PRT_BAD_YAW; }
  if r < PRT_R_MIN || r > PRT_R_MAX { return PRT_BAD_R; }
  p[0].id = id; p[0].to_x = v[0]; p[0].to_z = v[1]; p[0].ride = ride; p[0].yaw = yaw; p[0].r = r;
  for c, i: name { p[0].name[i] = c; }
  p[0].name_n = name.count;
  p[0].ok = true;
  return PRT_OK;
}
prt_name :: (p: [] Portal, k: int) -> string { return cast(string) p[k].name[0..<p[k].name_n]; }

// Reads table t of a content document into out (at most out.count rows). The rows read, or -(row + 1)
// for the first that does not, with its reason in why[0].
prt_scan :: (d: [] ContentDoc, t: int, out: [] Portal, why: [] int) -> int {
  n := ct_rows(d, t);
  if n > out.count { why[0] = PRT_BAD_ID; return -(out.count + 1); }
  for r: 0..<n {
    w := prt_read(ct_get(d, t, r, 0), ct_str(d, t, r, 1), ct_str(d, t, r, 2), ct_str(d, t, r, 3), ct_get(d, t, r, 4), ct_get(d, t, r, 5), out[r..<r + 1]);
    if w != PRT_OK { why[0] = w; return -(r + 1); }
  }
  why[0] = PRT_OK;
  return n;
}

// A placed thing as the realm tells it: its kind and where it stands, metres.
PortalThing :: struct { kind: int; x: f32; z: f32; }
// Which portal you take standing at (x, z), metres: the one whose FROM is nearest within its reach
// (interact.coax's rule), or -1. A kind's portal counts at every placed thing of that kind.
prt_pick :: (p: [] Portal, n: int, things: [] PortalThing, x: f32, z: f32) -> int {
  best := -1; bd: f32 = 0;
  for k: 0..<n {
    if !p[k].ok { continue; }
    reach := cast(f32) p[k].r / 100;
    if p[k].kind == 0 {
      s := [1] InteractSpot.[InteractSpot.{x = cast(f32) p[k].x / 100, z = cast(f32) p[k].z / 100, reach = reach}];
      if interact_pick(s[..], x, z) == 0 { d := prt_d2(s[0].x, s[0].z, x, z); if best < 0 || d < bd { best = k; bd = d; } }
      continue;
    }
    for t: things {
      if t.kind != p[k].kind { continue; }
      s := [1] InteractSpot.[InteractSpot.{x = t.x, z = t.z, reach = reach}];
      if interact_pick(s[..], x, z) == 0 { d := prt_d2(t.x, t.z, x, z); if best < 0 || d < bd { best = k; bd = d; } }
    }
  }
  return best;
}
prt_d2 :: (ax: f32, az: f32, bx: f32, bz: f32) -> f32 { return (ax - bx) * (ax - bx) + (az - bz) * (az - bz); }

#test "a portal row reads: a kind or a point, where it goes, the way you face and its reach" {
  p: [1] Portal;
  #assert prt_read(1, "Enter the rover", "kind 120", "-9000 25000", 180, 600, p[..]) == PRT_OK;
  #assert p[0].ok && p[0].kind == 120 && p[0].to_x == -9000 && p[0].to_z == 25000 && p[0].yaw == 180 && p[0].r == 600 && prt_name(p[..], 0) == "Enter the rover";
  #assert prt_read(2, "Leave the rover", "at -9000 24600", "1200 3000", -179, 50, p[..]) == PRT_OK;
  #assert p[0].kind == 0 && p[0].x == -9000 && p[0].z == 24600 && p[0].to_x == 1200 && p[0].r == 50;
  #assert prt_read(3, "x", "at 0 0", "0 0", 0, 1000, p[..]) == PRT_OK && !p[0].ride;
  // a drive: the vehicle takes you there (#13505)
  #assert prt_read(4, "Drive to the garage", "kind 125", "ride 0 1000", 180, 300, p[..]) == PRT_OK;
  #assert p[0].ride && p[0].to_x == 0 && p[0].to_z == 1000 && p[0].kind == 125;
}
#test "a portal row that does not read says why, and is not ok" {
  p: [1] Portal;
  #assert prt_read(0, "a", "kind 1", "0 0", 0, 100, p[..]) == PRT_BAD_ID && !p[0].ok;
  #assert prt_read(1, "", "kind 1", "0 0", 0, 100, p[..]) == PRT_BAD_NAME;
  #assert prt_read(1, "abcdefghijklmnopqrstuvwxyzabcdefg", "kind 1", "0 0", 0, 100, p[..]) == PRT_BAD_NAME;
  #assert prt_read(1, "abcdefghijklmnopqrstuvwxyzabcdef", "kind 1", "0 0", 0, 100, p[..]) == PRT_OK;
  bad_from := [9] string.["", "kind", "kind ", "kind 0", "kind -1", "kind x", "at 1", "at 1 2 3", "near 1 2"];
  for f: bad_from { #assert prt_read(1, "a", f, "0 0", 0, 100, p[..]) == PRT_BAD_FROM && !p[0].ok; }
  #assert prt_read(1, "a", "kind 1000001", "0 0", 0, 100, p[..]) == PRT_BAD_FROM && prt_read(1, "a", "kind 1000000", "0 0", 0, 100, p[..]) == PRT_OK;
  #assert prt_read(1, "a", "at 1000001 0", "0 0", 0, 100, p[..]) == PRT_BAD_FROM && prt_read(1, "a", "at -1000000 0", "0 0", 0, 100, p[..]) == PRT_OK;
  bad_to := [10] string.["", "1", "1 2 3", "x 1", "1  2", "1000001 0", "ride", "ride ", "ride 1", "drive 1 2"];
  for t: bad_to { #assert prt_read(1, "a", "kind 1", t, 0, 100, p[..]) == PRT_BAD_TO; }
  #assert prt_read(1, "a", "kind 1", "0 0", -180, 100, p[..]) == PRT_BAD_YAW && prt_read(1, "a", "kind 1", "0 0", 181, 100, p[..]) == PRT_BAD_YAW;
  #assert prt_read(1, "a", "kind 1", "0 0", 0, 49, p[..]) == PRT_BAD_R && prt_read(1, "a", "kind 1", "0 0", 0, 1001, p[..]) == PRT_BAD_R;
  for w: 1..<7 { #assert prt_why(w).count > 0; }
  #assert prt_why(PRT_OK) == "";
}
#test "you take the nearest portal in reach: at any thing of its kind, or at its point" {
  p: [3] Portal;
  _ := prt_read(1, "Enter the rover", "kind 120", "-9000 25000", 180, 600, p[0..<1]);
  _ = prt_read(2, "Leave the rover", "at -9000 24600", "1200 3000", 0, 100, p[1..<2]);
  _ = prt_read(3, "Hatch", "kind 7", "0 0", 0, 200, p[2..<3]);
  things := [3] PortalThing.[PortalThing.{kind = 120, x = 12, z = 30}, PortalThing.{kind = 7, x = 14, z = 30}, PortalThing.{kind = 120, x = 50, z = 50}];
  #assert prt_pick(p[..], 3, things[..], 12, 35.5) == 0;            // 5.5 m from the rover: within 6
  #assert prt_pick(p[..], 3, things[..], 12, 36.5) == -1;           // past it
  #assert prt_pick(p[..], 3, things[..], 50, 54) == 0;              // the other rover of that kind
  #assert prt_pick(p[..], 3, things[..], 14, 31) == 2;              // the hatch is nearer than the rover
  #assert prt_pick(p[..], 3, things[..], -90, 246.5) == 1 && prt_pick(p[..], 3, things[..], -90, 247.5) == -1;
  #assert prt_pick(p[..], 2, things[..], 14, 31) == 0;              // only the rows given count
  #assert prt_pick(p[..], 3, things[0..<0], 12, 35) == -1;          // no rover placed: no way in
}
#test "a content table of portals reads every row, or names the first that does not" {
  d: [1] ContentDoc; out: [4] Portal; why: [1] int;
  text := "aethyr.content.v1 w 1\nreach 30000\ntable portals id name:text from:text to:text yaw:int r:int\n1|In|kind 120|-9000 25000|180|600\n2|Out|at -9000 24600|1200 3000|0|100\n";
  #assert ct_read(d[..], text) && prt_scan(d[..], 0, out[..], why[..]) == 2 && why[0] == PRT_OK && out[1].x == -9000;
  bad := "aethyr.content.v1 w 1\nreach 30000\ntable portals id name:text from:text to:text yaw:int r:int\n1|In|kind 120|-9000 25000|180|600\n2|Out|at 1|1200 3000|0|100\n";
  #assert ct_read(d[..], bad) && prt_scan(d[..], 0, out[..], why[..]) == -2 && why[0] == PRT_BAD_FROM;
  #assert ct_read(d[..], text) && prt_scan(d[..], 0, out[0..<1], why[..]) == -2;
}
