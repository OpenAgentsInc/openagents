// Character Create's Nature glade, composed against Quaternius Preview_1.jpg.
// Coax owns the composition, terrain, palette and deterministic planting.
#module "metaverse.characterglade";

#test "glade preserves a level character clearing and winds the path through the hills" {
  #assert cg_height(0,0)==0 && cg_height(1,0)==0;
  #assert cg_height(-10,-20)>2 && cg_height(18,-30)>1;
  #assert cg_path(cg_path_x(-12),-12)>0.99 && cg_path(14,-12)<0.01;
}
#test "glade composition puts green woods left and autumn birches right" {
  a:=cg_item(0);b:=cg_item(7);
  #assert a.kind==0 && a.x<0 && b.kind==1 && b.x>0;
  #assert cg_item(16).kind==2;
}
CgItem :: struct {kind:int;variant:int;x:f32;z:f32;scale:f32; yaw:f32;lift:f32;vertical:f32;tint:[3]f32;}
CG_ITEMS :: 27;
cg_path_x :: (z:f32)->f32 {return 2.1*sin(z*0.27)+0.9-(ifx z>0 then z*0.55 else 0.0);}
cg_path :: (x:f32,z:f32)->f32 {
 d:=abs(x-cg_road_x(z));spread:=0.50+abs(z)*0.08;main:=exp(-d*d/(ifx spread>1.9 then 1.9 else spread))*(1-cg_ramp(-48,-54,z));
 branch_d:=z+10+1.4*(x+2);branch_fade:=(-x-0.5)/1.5;branch:=exp(-branch_d*branch_d/4.0)*(ifx branch_fade<0 then 0 else ifx branch_fade>1 then 1 else branch_fade);
 return ifx main>branch then main else branch;
}
cg_height :: (x:f32,z:f32)->f32 {
  away:=sqrt(x*x+z*z);if away<2 {return 0;}
  h:=4.0*exp(-((x+11)*(x+11)/110+(z+22)*(z+22)/95))+5.8*exp(-((x-17)*(x-17)/160+(z+33)*(z+33)/180));
  h+=11.2*exp(-((x+8)*(x+8)/120+(z+34)*(z+34)/70));
  fade:=ifx away<5 then (away-2)/3 else 1;
  return cg_road_ground(x,z,h*fade);
}
#test "glade rear ridge is golden while foreground woods remain green" {
 #assert cg_autumn(-4,-30)>0.8 && cg_autumn(-6,-5)==0;
}
cg_autumn :: (x:f32,z:f32)->f32 {
 side:=(x+z*0.1-1)/16;rear:=(-z-16)/13;wood:=(x+12)/5;
 a:=ifx side>0 then side else 0;b:=(ifx rear<0 then 0 else ifx rear>1 then 1 else rear)*(ifx wood<0 then 0 else ifx wood>1 then 1 else wood);
 v:=ifx a>b then a else b;return ifx v>1 then 1 else v;
}
cg_hash :: (a:f32,b:f32)->f32 {v:=sin(a*127.1+b*311.7)*43758.5453;return v-floor(v);}
cg_item :: (i:int)->CgItem {
  // x, z, scale, yaw, source variant. The rocks form the stepped left cliff.
  p:=[27][5]f32.[
    [5]f32.[-10.5,-9,0.42,1.1,2],[5]f32.[-6,-13,0.48,1.5,1],[5]f32.[-15,-18,0.55,2.4,2],[5]f32.[-4,-18,0.36,0.4,3],[5]f32.[-16,-17,0.45,1.0,4],[5]f32.[-13,-19,0.45,2,0],[5]f32.[-7,-30,0.45,0.3,1],
    [5]f32.[2.2,-0.5,0.16,0.1,0],[5]f32.[6,-13,0.42,1.3,1],[5]f32.[5,-24,0.40,0.8,2],[5]f32.[15,-26,0.5,2.1,3],[5]f32.[1.6,-21,0.48,1,4],[5]f32.[9,-32.2,0.5,1.7,0],[5]f32.[20,-18,0.5,2,2],[5]f32.[23.5,-31.5,0.5,0.5,3],[5]f32.[-1.8,-19,0.5,1.4,1],
    [5]f32.[-9,-18,1.25,0.1,1],[5]f32.[-14,-23,2.8,0.5,3],[5]f32.[-7,-20,1.4,2.4,1],[5]f32.[-9,-13,0.65,1.8,1],[5]f32.[1.1,-2.5,0.27,0.5,0],[5]f32.[-3.6,-4,0.18,2.1,3],[5]f32.[1.75,0.9,0.18,1.3,3],[5]f32.[1.8,-13,0.26,0.1,0],[5]f32.[6,-5,0.23,1.8,2],[5]f32.[-22,-19,0.40,0.8,0],[5]f32.[-28,-27,0.65,1.5,4]];
  r:CgItem;r.kind=ifx i<7 || i>=25 then 0 else ifx i<16 || i==24 then 1 else ifx i==17 || i==21 || i==22 then 3 else 2;r.variant=int(p[i][4]);r.x=p[i][0];r.z=p[i][1];r.scale=p[i][2];r.yaw=p[i][3];r.lift=ifx i==17 then 1.7 else ifx i==24 then 0.3 else 0.0;r.vertical=ifx i==0 then 1.56 else ifx i==7 then 1.58 else ifx i==17 then 0.90 else ifx i>=25 then 1.6 else ifx i==20 then 0.815 else 1.0;
  r.tint=ifx r.kind==1 then (ifx i==24 then [3]f32.[1.0,0.30,0.035] else ifx i==9 then [3]f32.[1.0,0.65,0.12] else ifx i==15 then [3]f32.[1.0,0.55,0.10] else ifx i==7 || i%3==0 then [3]f32.[1.0,0.22,0.025] else ifx i%3==1 then [3]f32.[1.0,0.55,0.09] else [3]f32.[1.0,0.72,0.18]) else ifx r.kind==0 then [3]f32.[0.50,0.80,0.10] else ifx i==20 then [3]f32.[0.43,0.47,0.28] else ifx i==22 then [3]f32.[0.64,0.67,0.53] else [3]f32.[0.69,0.73,0.48];return r;
}

#test "glade composition retains every visible source tree" {
 for i:0..<CG_ITEMS {#assert cg_visible(cg_item(i));}
}
// Every authored tree now stays in front of the cliff or on its visible rim.
cg_visible :: (item:CgItem)->bool {return item.scale>0;}
#test "glade canopy normals remain unit length even near their center" {
 a:=cg_canopy_normal(0.001,0,0);b:=cg_canopy_normal(0,0,0);
 #assert a[0]==1 && a[1]==0 && a[2]==0;
 #assert b[0]==0 && b[1]==1 && b[2]==0;
}
cg_canopy_normal :: (x:f32,y:f32,z:f32)->[3]f32 {
 magnitude:=sqrt(x*x+y*y+z*z);if magnitude<0.000001 {return [3]f32.[0,1,0];}
 return [3]f32.[x/magnitude,y/magnitude,z/magnitude];
}

#test "glade reference places the near birch and right rock in the foreground" {
 tree:=cg_item(7);rock:=cg_item(20);#assert tree.z> -1 && tree.scale<0.3 && rock.z> -4 && rock.scale<0.3;
 #assert cg_path(cg_path_x(-30),-30)<0.001 && cg_height(-5,-32)>6;
}

#test "glade bare path forks toward the left foreground" {#assert cg_path(-6.5,-3.7)>0.95 && cg_path(-6.5,-10)<0.1;}

#test "glade hero cliff cap has a broad level crown and a supported base" {
 #assert cg_cliff_cap_y(0)==0 && abs(cg_cliff_cap_y(1.2)-1.8)<0.0001;
 #assert cg_cliff_cap_y(1.96)<1.85 && cg_cliff_cap_y(1.96)>cg_cliff_cap_y(1.2);
 #assert cg_cliff_cap_y(-0.5)== -0.75;
}
cg_cliff_cap_y :: (y:f32)->f32 {return ifx y<=1.2 then y*1.5 else 1.8+(y-1.2)*0.05;}

#test "glade crown lobes form deterministic bounded local volumes" {
 p:=[24]f64.[-4,0,0,-4,1,0,-3,0,0,-3,1,0,3,0,0,3,1,0,4,0,0,4,1,0];
 a:=cg_crown_centres(p[..],8);b:=cg_crown_centres(p[..],8);
 for i:0..<8 {for k:0..<3 {#assert a[i][k]==b[i][k] && abs(a[i][k])<=4;}}
 n:=cg_crown_lobe(4.5,0.5,0,a);#assert n[0]>0 && abs(n[0]*n[0]+n[1]*n[1]+n[2]*n[2]-1)<0.0001;
}
cg_crown_centres :: (p:[]f64,n:int)->[8][3]f32 {
 centers:[8][3]f32;
 // Farthest-point initialisation spans the crown without a random seed.
 for k:0..<3 {centers[0][k]=f32(p[k]);}
 for c:1..<8 {far:f32= -1;pick:=0;
  for v:0..<n {nearest:f32=1000000;for j:0..<c {d:f32=0;for k:0..<3 {q:=f32(p[v*3+k])-centers[j][k];d+=q*q;}if d<nearest {nearest=d;}}if nearest>far {far=nearest;pick=v;}}
  for k:0..<3 {centers[c][k]=f32(p[pick*3+k]);}
 }
 for step:0..<4 {sums:[8][3]f32;counts:[8]int;
  for v:0..<n {nearest:f32=1000000;which:=0;for j:0..<8 {d:f32=0;for k:0..<3 {q:=f32(p[v*3+k])-centers[j][k];d+=q*q;}if d<nearest {nearest=d;which=j;}}
   counts[which]+=1;for k:0..<3 {sums[which][k]+=f32(p[v*3+k]);}
  }
  for j:0..<8 {if counts[j]>0 {for k:0..<3 {centers[j][k]=sums[j][k]/f32(counts[j]);}}}
 }
 return centers;
}
cg_crown_near :: (x:f32,y:f32,z:f32,centers:[8][3]f32)->int {
 nearest:f32=1000000;which:=0;
 for j:0..<8 {dx:=x-centers[j][0];dy:=y-centers[j][1];dz:=z-centers[j][2];d:=dx*dx+dy*dy+dz*dz;if d<nearest {nearest=d;which=j;}}return which;
}
cg_crown_lobe :: (x:f32,y:f32,z:f32,centers:[8][3]f32)->[3]f32 {
 which:=cg_crown_near(x,y,z,centers);return cg_canopy_normal(x-centers[which][0],y-centers[which][1],z-centers[which][2]);
}

// ---- The road to Everglade (Character Create's USE IN EVERGLADE walk)
// The meadow path continues past the rear birches, through a notch cut in the back ridge, to the
// gate of a walled town on a level plateau beyond it. Each is a pure function of position, so the
// packed ground, the walk and its camera all read the same road. The foreground is unchanged.
CG_GATE_Z :: -34.5;
CG_PLATEAU :: 1.8;
#test "glade road continues the meadow path through the ridge to the gate and leaves the clearing alone" {
 for i:0..<16 {z:= -14-f32(i)*2;#assert cg_path(cg_road_x(z),z)>0.95;}
 for i:0..<14 {z:=2-f32(i);#assert cg_road_x(z)==cg_path_x(z);}
 #assert cg_road_ground(0,-5,1.5)==1.5 && cg_road_ground(-6,-10,2)==2 && cg_road_ground(-12,-12,3)==3;
 notch:=cg_height(cg_road_x(-30),-30);#assert notch>1 && notch<2.1 && cg_height(cg_road_x(-30)+7,-30)>notch+1.5;
 #assert abs(cg_height(cg_road_x(CG_GATE_Z),CG_GATE_Z)-CG_PLATEAU)<0.05;
 // The grade climbs gently: never steeper than one in four along the walk.
 for i:0..<60 {z:= -12-f32(i)*0.5;a:=cg_height(cg_walk_x(z),z);b:=cg_height(cg_walk_x(z-0.5),z-0.5);#assert abs(a-b)<0.125;}
}
cg_ramp :: (a:f32,b:f32,x:f32)->f32 {t:=(x-a)/(b-a);t=ifx t<0 then 0 else ifx t>1 then 1 else t;return t*t*(3-2*t);}
cg_road_x :: (z:f32)->f32 {b:=cg_ramp(-13,-19,z);return cg_path_x(z)*(1-b)+(3.3+0.3*sin((z+21)*0.25))*b;}
// The walk itself: from the character's spot onto the path, around the flat path stone, then the road.
cg_walk_x :: (z:f32)->f32 {return cg_road_x(z)*cg_ramp(0,-3.5,z)-1.2*exp(-(z+13)*(z+13)/2.56);}
cg_road_ground :: (x:f32,z:f32,h:f32)->f32 {
 corridor:=(1-cg_ramp(2.0,5.0,abs(x-cg_road_x(z))))*cg_ramp(-14,-18,z)*(1-cg_ramp(-56,-62,z));
 g:=h+(0.83+(CG_PLATEAU-0.83)*cg_ramp(-16,-33,z)-h)*corridor;
 ex:=(x-9)/13;ez:=(z+46.5)/12.5;g=g+(CG_PLATEAU-g)*(1-cg_ramp(0.85,1.2,sqrt(ex*ex+ez*ez)));
 // Low far hills close the horizon behind the town.
 return g+cg_ramp(-62,-98,z)*(6.5+3.0*sin(x*0.09+1.3));
}
#test "glade walk keeps clear of every tree and rock" {
 for i:0..<CG_ITEMS {item:=cg_item(i);near:f32=1000;
  for k:0..<400 {z:=f32(k)*(CG_GATE_Z-4)/400;dx:=cg_walk_x(z)-item.x;dz:=z-item.z;d:=sqrt(dx*dx+dz*dz);if d<near {near=d;}}
  #assert near>0.95;
 }
}

// The town: stone walls with a gate on the road, towers, a keep and plaster houses with tiled roofs,
// the look of Everglade's own gate. Shapes: 0 stone wall (merlons along its top), 1 house (gable
// roof), 2 square tower (pyramid roof), 3 round tower (cone roof), 4 timber lintel over the gate.
CgBlock :: struct {shape:int;x:f32;z:f32;w:f32;d:f32;h:f32;roof:f32;lift:f32;yaw:f32;}
CG_CITY :: 24;
cg_city :: (i:int)->CgBlock {
 g:=cg_road_x(CG_GATE_Z);z:f32=CG_GATE_Z;q:=1.5707964f32;
 p:=[24][9]f32.[
  [9]f32.[0,(g-5.7)*0.5,z,g+2.3,1.2,4.6,0,0,0],[9]f32.[0,(g+22.7)*0.5,z,19.3-g,1.2,4.6,0,0,0],
  [9]f32.[0,21,-45.75,22.5,1.2,4.6,0,0,q],[9]f32.[0,9,-57,24,1.2,4.6,0,0,0],[9]f32.[0,-3,-45.75,22.5,1.2,4.6,0,0,q],
  [9]f32.[2,g-2.9,z,2.4,2.4,7.0,2.2,0,0],[9]f32.[2,g+2.9,z,2.4,2.4,7.0,2.2,0,0],[9]f32.[4,g,z,3.6,1.3,1.1,0,3.7,0],
  [9]f32.[3,21,z,3.2,3.2,8.5,3.0,0,0],[9]f32.[3,21,-57,3.2,3.2,8.0,3.0,0,0],[9]f32.[3,-3,-57,3.2,3.2,8.0,3.0,0,0],
  [9]f32.[2,11,-47,4.6,4.6,13,4.2,0,0],[9]f32.[3,5.5,-51.5,3.6,3.6,11,4.0,0,0],
  [9]f32.[1,8.6,-39,4.5,4.0,3.6,2.2,0,0],[9]f32.[1,14.2,-39.2,5.0,4.0,3.8,2.3,0,0],[9]f32.[1,18.4,-42.5,5.0,3.6,3.4,2.0,0,q],
  [9]f32.[1,-0.2,-39.5,3.0,4.4,3.4,2.0,0,0],[9]f32.[1,8.2,-44.5,5.0,4.0,3.6,2.2,0,q],[9]f32.[1,15.6,-47.5,4.5,4.0,3.8,2.2,0,0],
  [9]f32.[1,0.2,-46.5,4.0,4.0,3.5,2.2,0,0],[9]f32.[1,17.2,-53,5.0,4.0,3.6,2.2,0,0],[9]f32.[1,10.8,-54,4.5,4.0,3.5,2.0,0,0],
  [9]f32.[1,0.8,-53,4.6,4.0,3.6,2.2,0,q],[9]f32.[3,21,-46,3.0,3.0,7.5,2.6,0,0]];
 r:CgBlock;r.shape=int(p[i][0]);r.x=p[i][1];r.z=p[i][2];r.w=p[i][3];r.d=p[i][4];r.h=p[i][5];r.roof=p[i][6];r.lift=p[i][7];r.yaw=p[i][8];return r;
}
// Half extents on the ground's x and z axes (yaw is 0 or a quarter turn).
cg_city_half :: (b:CgBlock)->[2]f32 {turned:=abs(sin(b.yaw))>0.5;return ifx turned then [2]f32.[b.d*0.5,b.w*0.5] else [2]f32.[b.w*0.5,b.d*0.5];}
#test "glade town leaves the gate open on the road and stands behind the ridge" {
 g:=cg_road_x(CG_GATE_Z);
 for i:0..<CG_CITY {b:=cg_city(i);e:=cg_city_half(b);#assert b.w>0 && b.d>0 && b.h>0;
  #assert b.z+e[1]<=CG_GATE_Z+1.7;
  if b.shape==4 {#assert abs(b.x-g)<0.01 && b.lift>3;continue;}
  // Nothing but the lintel stands on the last stretch of the walk or the plaza inside the gate.
  for k:0..<40 {z:=CG_GATE_Z+3-f32(k)*0.2;x:=cg_walk_x(z);#assert abs(x-b.x)>e[0]+1.2 || abs(z-b.z)>e[1]+0.4;}
 }
 // The opening between the gate towers is wider than three metres.
 #assert cg_city(6).x-cg_city(5).x-2.4>3.0 && cg_city(1).x-cg_city(1).w*0.5-(cg_city(0).x+cg_city(0).w*0.5)>3.0;
}
