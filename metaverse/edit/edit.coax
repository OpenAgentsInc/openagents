// One edit layer every realm loads (byo-every-realm; docs/metaverse/realm-edit.md): the list of what
// is in the realm and what its owner asked for,
// lifted out of Build your own realm (apps/openagents-web/builder.coax, myrealm.coax) so a hand-built
// realm and a made one edit the same way.
//
// The server decides everything (coax/web/api/migrations/0050_realm_edit.sql): GET
// /api/playtest/realms/<slug> says the viewer's role, the board's rows and the tools the realm's code
// honours. An owner or an admin gets EDIT; it opens one pane at a time (the panes rule,
// metaverse/fairy-forest/README.md): FEATURES (each row IN IT or NOT IN IT YET, the asks, talking or
// typing revises the board through the model). A visitor gets
// nothing from here but the realm's own tools.
//
// What is a world edit lives in the editor shell, not here (#13506): switching the board's rows and the
// visitors' tools, and placing and taking away things, are `cell`, `spawn` and `despawn` edits of the realm's
// world, made in the shell (?edit; FEATURES' OPEN THE EDITOR goes there). What has no world edit stays here:
// lore and quests (YOUR COMPUTER and YOUR AGENT are Settings, This machine's: #13529). A visitor's proposal waits for its owner in the shell's agent strip,
// with ACCEPT and DECLINE (#13527). A spoken switch (redit_heard, redit_switch) is a cell edit of the world's rows
// table (#13514).
//
// THE ASKS AND THE REALM'S VOICE are turns of the editor shell's agent strip (#13528, #13542;
// docs/metaverse/realm-edit.md): the shell tells the strip's agent the realm's lists and its asks
// (world.turn.v1, from the model realm-page.coax writes with the asks this layer reads), and the agent
// answers with tools. A hosted turn's realm steps come back from the shell as one action of lines
// (REDIT_MSG_REALM, shell.coax ES_REALM): this layer carries each out as the server's own request (an ask
// added, the board revised, an ask or a row deleted, a look at the screen) and hands what came of it to the
// strip in words (REDIT_ACT_AGENT). The strip's composer holds the voice: HOLD TO TALK under EDIT is gone.
//
// A realm keeps one RealmEdit in its state and wires a few hooks (redit_message, redit_key,
// redit_pointer, redit_step, redit_hud, redit_take_action; apps/openagents-web/edit-face.h sends its
// one request). It reads redit_row_on to switch its features, redit_tool for a visitor's tool, and
// redit_changed when the server's answer changed the realm. Drawing uses font.coax (draw_text,
// measure, Ink) and the realm's own `lit`; plates are left in plate_box for the realm's `plate`.
// HTTP flags and fact_of are analytics.coax's.
//
// The panes for what you work on (ff-panes; coax/web/api/migrations/0055_realm_panes.sql): a realm
// says which of its characters you are by (redit_near); with EDIT open the layer brings up that
// character's LORE (saved with the character, brought back next time) and, from it, the QUEST form
// (who gives it, what is asked, three steps, what you get), whose save makes the quest. Everyone
// reads both (redit_lore, redit_quest*), so a realm's characters can know their lore and give their
// quests.
//
// YOUR COMPUTER and YOUR AGENT are Settings, This machine's now (apps/openagents-web/machine-web.coax, #13529).
//   coax/bin/coax test metaverse/edit/edit_test.coax

#load "edit-text.coax";   // the small helpers: redit_put, redit_copy, redit_word
#load "../../metaverse-engine/editor/spec.coax";   // the spec's lines (GET /api/playtest/realms/<slug>): one reader
#load "../../metaverse-engine/editor/change.coax";   // the edits' bodies (edits.proto): one writer
#load "../../metaverse-engine/editor/lists.coax";   // the feature list's and the panes' lines: one reader
#load "realm-page.coax";   // the realm's world: followed by an editor's page, told to the editor shell (#13478)

REDIT_ROWS :: 16; REDIT_KEY :: 32; REDIT_LABEL :: 48;
REDIT_TOOLS :: 6; REDIT_THING :: 16;
REDIT_PLACED :: 64; REDIT_PLATES :: 8;
REDIT_SLUG :: 64; REDIT_URL :: 200; REDIT_BODY :: 1400; REDIT_TYPED :: 200; REDIT_NOTE :: 100; REDIT_OUT :: 32;
REDIT_UNKNOWN :: 0; REDIT_VISITOR :: 1; REDIT_ADMIN :: 2; REDIT_OWNER :: 3;
REDIT_SHUT :: 0; REDIT_BOARD :: 1; REDIT_LORE_PANE :: 4; REDIT_QUEST_PANE :: 5;   // 6 and 7 were YOUR COMPUTER and YOUR AGENT (#13529)
REQ_E_NONE :: 0; REQ_E_SPEC :: 1; REQ_E_SWITCH :: 2; REQ_E_REVISE :: 6;
REQ_E_PANES :: 8; REQ_E_LORE :: 9; REQ_E_QUEST :: 10; REQ_E_ASKS :: 11; REQ_E_ADD :: 12; REQ_E_DELETE :: 13;
REQ_E_LOOK :: 15;   // a look: the strip's question about the screen, with the frame
REQ_E_SWITCH_REV :: 17;   // a row switched: the realm's world's revision first, then the cell edit (#13514)
// buttons: EDIT, the tab (FEATURES), SAVE, LORE <-> QUEST (6 and 7 were the cards', #13527; 4, 5, 10, 11 and 17
// the asks' and the voice's, #13528)
RB_EDIT :: 0; RB_TAB :: 1; RB_SAVE :: 8; RB_SWAP :: 9;
// (12 to 16 and 18 to 21 were YOUR COMPUTER's and YOUR AGENT's, which are Settings' now: #13529)
// FEATURES' OPEN THE EDITOR: this page again with ?edit, where the shell switches, sets and places (#13506)
RB_OPEN :: 22; RB_N :: 23;
REDIT_ACT_GO :: 1;     // coax/web/host.js: navigates to the outbox's path
REDIT_ACT_COPY :: 2;   // coax/web/host.js: the outbox's text to the clipboard
// What its owner asked for (migrations/0078_realm_asks.sql): the asks, each applied, waiting (NOT APPLIED) or removing.
// They are told to the editor shell's agent strip (realm-page.coax rp_asks), not listed here (#13528).
REDIT_ASKS :: 24; REDIT_WORDS :: 120;
ASK_WAITING :: 0; ASK_APPLIED :: 1; ASK_REMOVING :: 2;
// The panes' fields: a character's lore, then the quest's ask, three steps and reward.
RF_LORE :: 0; RF_ASK :: 1; RF_STEP :: 2; RF_REWARD :: 5; RF_N :: 6;
REDIT_LORES :: 12; REDIT_QUESTS :: 12; REDIT_DRAFT :: 400; REDIT_PART :: 160;
REDIT_MSG_TEXT :: 1; REDIT_FACTS :: 600;
REDIT_MSG_BATCH :: 520;   // the editor shell's world.edit.v1 batch (metaverse-engine/editor/shell.coax ES_BATCH)
REDIT_HTTP_FRAME :: 32;   // coax/web/HTTP.md: the next frame drawn goes with the JSON body as its "image"
REDIT_REPLY :: 300;       // a look's answer (the server keeps 300 characters)
// The agent strip's realm steps (metaverse-engine/editor/shell.coax ES_REALM), and what came of them, in words,
// for the strip (coax/web/host.js hands page action 34 to the chat module).
REDIT_MSG_REALM :: 530; REDIT_ACT_AGENT :: 34;
REDIT_JOBS :: 16;         // realm steps waiting to go (a plan holds at most 16: turn.coax WP_STEPS)
REDIT_JOB_ASK :: 1; REDIT_JOB_REVISE :: 2; REDIT_JOB_UNASK :: 3; REDIT_JOB_UNROW :: 4; REDIT_JOB_LOOK :: 5;
REDIT_SAID :: 1200;       // bytes of words waiting for the strip
REDIT_KEY_ESCAPE :: -1; REDIT_KEY_ENTER :: -2; REDIT_KEY_BACKSPACE :: -3;
REDIT_TOOL_NAMES :: [REDIT_TOOLS] string.["build", "fly", "jump", "map", "talk", "voice"];

RBox :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }

RealmEdit :: struct {
  slug: [REDIT_SLUG] u8; slug_n: int;
  ready: bool; failed: bool; changed: bool; version: int;
  role: int;
  tool_has: [REDIT_TOOLS] bool; tool_on: [REDIT_TOOLS] bool;
  row_n: int; row_key: [REDIT_ROWS * REDIT_KEY] u8; row_key_n: [REDIT_ROWS] int;
  row_label: [REDIT_ROWS * REDIT_LABEL] u8; row_label_n: [REDIT_ROWS] int; row_on: [REDIT_ROWS] bool;
  placed_n: int; placed_thing: [REDIT_PLACED * REDIT_THING] u8; placed_thing_n: [REDIT_PLACED] int;
  placed_x: [REDIT_PLACED] f32; placed_z: [REDIT_PLACED] f32; placed_yaw: [REDIT_PLACED] f32;
  // the screen
  pane: int; time: f32; width: f32; height: f32; dpr: f32;
  boxes: [RB_N] RBox; shown: [RB_N] bool; rows: [REDIT_ROWS] RBox; row_shown: [REDIT_ROWS] bool;
  press: int; finger: int;
  plate_n: int; plate_box: [REDIT_PLATES] RBox; plate_alpha: [REDIT_PLATES] f32; plate_look: [REDIT_PLATES] f32;
  note: [REDIT_NOTE] u8; note_n: int; note_at: f32;
  // typing (LORE's and QUEST's fields)
  typing: bool; typed: [REDIT_TYPED] u8; typed_n: int;
  // the one request in flight, and what to send next
  req_url: [REDIT_URL] u8; req_url_n: int; req_body: [REDIT_BODY] u8; req_body_n: int; req_flags: int;
  req_ready: bool; req_id: int; req_what: int; req_at: f32;
  spec_due: bool; asked: bool;
  watched_at: f32; spec_sum: int; spec_sum2: int; spec_len: int;   // the last spec read: an unchanged one changes nothing
  switch_row: int; switch_on: bool; switch_rev: int; switch_tries: int; switch_last: int;
  page: [REDIT_URL] u8; page_n: int; go_due: bool;   // this page's path (the url fact), and OPEN THE EDITOR asked
  out: [REDIT_OUT] u8; out_n: int;
  // the panes for what you work on: who you are by, whose panes are up, what everyone reads, the drafts
  near: [REDIT_KEY] u8; near_n: int; near_name: [REDIT_LABEL] u8; near_name_n: int;
  focus: [REDIT_KEY] u8; focus_n: int; focus_name: [REDIT_LABEL] u8; focus_name_n: int;
  lore_n: int; lore_who: [REDIT_LORES * REDIT_KEY] u8; lore_who_n: [REDIT_LORES] int;
  lore_text: [REDIT_LORES * REDIT_DRAFT] u8; lore_text_n: [REDIT_LORES] int;
  quest_n: int; quest_giver: [REDIT_QUESTS * REDIT_KEY] u8; quest_giver_n: [REDIT_QUESTS] int;
  quest_part: [REDIT_QUESTS * 5 * REDIT_PART] u8; quest_part_n: [REDIT_QUESTS * 5] int;   // ask, three steps, reward
  panes_due: bool; panes_asked: bool; panes_version: int; save_due: int;   // save_due: REQ_E_LORE or REQ_E_QUEST
  draft: [RF_N * REDIT_DRAFT] u8; draft_n: [RF_N] int; dirty: bool;
  field: int; field_press: int; fbox: [RF_N] RBox; fshown: [RF_N] bool;   // field: the one you type into + 1 (0: none, the board's words)
  type_box: RBox;   // where what you type is drawn: a phone's keyboard field goes there
  // what its owner asked for: read once a world asks for them (asks_wanted), again after each change; asks_v
  // moves with each read, so the world is told again
  ask_n: int; ask_id: [REDIT_ASKS] int; ask_state: [REDIT_ASKS] int;
  ask_words: [REDIT_ASKS * REDIT_WORDS] u8; ask_words_n: [REDIT_ASKS] int; asks_due: bool; asks_wanted: bool; asks_v: int;
  // the agent strip's realm steps waiting to go, a job each, and the words for the strip of what came of them
  job_n: int; job_what: [REDIT_JOBS] int; job_text: [REDIT_JOBS * REDIT_TYPED] u8; job_text_n: [REDIT_JOBS] int;
  said: [REDIT_SAID] u8; said_n: int;
  // the realm's world, for someone who may edit and opened the page with ?edit (realm-page.coax, #13478):
  // shell_asked, the host asked for the editor; world_at, the layer's clock at the world's last step;
  // world_version, the spec's version the world was read at (a board changed by any road is read again)
  world: [1] RealmPage; shell_asked: bool; world_at: f32; world_version: int;
}

// The small helpers (redit_put, redit_copy, redit_word...) are edit-text.coax's.

// ---- what a realm reads

redit_may :: (e: [] RealmEdit) -> bool { return e[0].role >= REDIT_ADMIN; }
redit_key_of :: (e: [] RealmEdit, i: int) -> string { return cast(string) e[0].row_key[i * REDIT_KEY..<i * REDIT_KEY + e[0].row_key_n[i]]; }
redit_label_of :: (e: [] RealmEdit, i: int) -> string { return cast(string) e[0].row_label[i * REDIT_LABEL..<i * REDIT_LABEL + e[0].row_label_n[i]]; }
redit_row :: (e: [] RealmEdit, key: string) -> int { for i: 0..<e[0].row_n { if redit_key_of(e, i) == key { return i; } } return -1; }
// Is a feature on: true until the server says it is off.
redit_row_on :: (e: [] RealmEdit, key: string) -> bool { i := redit_row(e, key); return i < 0 || e[0].row_on[i]; }
redit_tool_of :: (name: string) -> int { for i: 0..<REDIT_TOOLS { if REDIT_TOOL_NAMES[i] == name { return i; } } return -1; }
// May whoever is here use a tool: an owner or admin always; a visitor while it is on.
redit_tool :: (e: [] RealmEdit, name: string) -> bool {
  t := redit_tool_of(name);
  if t < 0 { return false; }
  if redit_may(e) { return true; }
  return !e[0].tool_has[t] || e[0].tool_on[t];
}
redit_placed_thing :: (e: [] RealmEdit, i: int) -> string { return cast(string) e[0].placed_thing[i * REDIT_THING..<i * REDIT_THING + e[0].placed_thing_n[i]]; }
// The server changed the realm since the last time a realm asked: switch its features again.
redit_changed :: (e: [] RealmEdit) -> bool { c := e[0].changed; e[0].changed = false; return c; }
redit_typing :: (e: [] RealmEdit) -> bool { return e[0].typing; }
redit_open :: (e: [] RealmEdit) -> bool { return e[0].pane != REDIT_SHUT; }
// Where what you type is drawn (a phone's keyboard field goes there), while redit_typing.
redit_type_box :: (e: [] RealmEdit) -> RBox { return e[0].type_box; }

// ---- the panes everyone reads: lore and quests
redit_lore_who :: (e: [] RealmEdit, i: int) -> string { return cast(string) e[0].lore_who[i * REDIT_KEY..<i * REDIT_KEY + e[0].lore_who_n[i]]; }
// A character's lore ("" none).
redit_lore :: (e: [] RealmEdit, p_who: string) -> string {
  for i: 0..<e[0].lore_n { if redit_lore_who(e, i) == p_who { return cast(string) e[0].lore_text[i * REDIT_DRAFT..<i * REDIT_DRAFT + e[0].lore_text_n[i]]; } }
  return "";
}
redit_quest_giver :: (e: [] RealmEdit, q: int) -> string { return cast(string) e[0].quest_giver[q * REDIT_KEY..<q * REDIT_KEY + e[0].quest_giver_n[q]]; }
// The quest a character gives (its index), -1 none.
redit_quest :: (e: [] RealmEdit, p_giver: string) -> int { for q: 0..<e[0].quest_n { if redit_quest_giver(e, q) == p_giver { return q; } } return -1; }
// A quest's p_part: 0 what is asked, 1 to 3 the steps ("" none), 4 what you get.
redit_quest_part :: (e: [] RealmEdit, q: int, p_part: int) -> string {
  if q < 0 || q >= e[0].quest_n || p_part < 0 || p_part > 4 { return ""; }
  at := (q * 5 + p_part) * REDIT_PART;
  return cast(string) e[0].quest_part[at..<at + e[0].quest_part_n[q * 5 + p_part]];
}
// ---- what its owner asked for
redit_ask_words :: (e: [] RealmEdit, a: int) -> string { return cast(string) e[0].ask_words[a * REDIT_WORDS..<a * REDIT_WORDS + e[0].ask_words_n[a]]; }
redit_ask_of :: (e: [] RealmEdit, id: int) -> int { for a: 0..<e[0].ask_n { if e[0].ask_id[a] == id { return a; } } return -1; }
// The list: "ask ID applied|waiting|removing ask|remove WORDS", newest first.
redit_read_asks :: (e: [] RealmEdit, text: string) {
  e[0].ask_n = 0;
  i := 0;
  while i < text.count && e[0].ask_n < REDIT_ASKS {
    end := redit_line_end(text, i); line := text[i..<end]; i = end + 1;
    ak := editor_read_ask(line);   // metaverse-engine/editor/lists.coax, the feature list's one reader
    if !ak.ok { continue; }
    a := e[0].ask_n;
    e[0].ask_id[a] = ak.id;
    st := ak.state;
    e[0].ask_state[a] = ifx st == "applied" then ASK_APPLIED else ifx st == "removing" then ASK_REMOVING else ASK_WAITING;
    e[0].ask_words_n[a] = redit_copy(e[0].ask_words[a * REDIT_WORDS..<(a + 1) * REDIT_WORDS], ak.words);
    if e[0].ask_id[a] > 0 && e[0].ask_words_n[a] > 0 { e[0].ask_n = a + 1; }
  }
  e[0].asks_v += 1;
}

redit_draft :: (e: [] RealmEdit, f: int) -> string { return cast(string) e[0].draft[f * REDIT_DRAFT..<f * REDIT_DRAFT + e[0].draft_n[f]]; }
redit_field_cap :: (f: int) -> int { return ifx f == RF_LORE then REDIT_DRAFT else ifx f == RF_ASK then REDIT_PART else 100; }
// The drafts become what is saved for the character whose panes are up.
redit_load_drafts :: (e: [] RealmEdit) {
  p_who := cast(string) e[0].focus[0..<e[0].focus_n];
  e[0].draft_n[RF_LORE] = redit_copy(e[0].draft[0..<REDIT_DRAFT], redit_lore(e, p_who));
  q := redit_quest(e, p_who);
  for f: 1..<RF_N { e[0].draft_n[f] = redit_copy(e[0].draft[f * REDIT_DRAFT..<f * REDIT_DRAFT + redit_field_cap(f)], redit_quest_part(e, q, f - 1)); }
  e[0].dirty = false;
}
// The panes' p_lines: "lore WHO|TEXT" and "quest GIVER|ASK|STEP|STEP|STEP|REWARD".
redit_read_panes :: (e: [] RealmEdit, text: string) {
  e[0].lore_n = 0; e[0].quest_n = 0;
  i := 0;
  while i < text.count {
    end := redit_line_end(text, i); line := text[i..<end]; i = end + 1;
    pn := editor_read_pane(line);   // metaverse-engine/editor/lists.coax, the panes' one reader
    if pn.kind == EDITOR_PANE_LORE && pn.fields >= 2 && e[0].lore_n < REDIT_LORES {
      l := e[0].lore_n;
      e[0].lore_who_n[l] = redit_copy(e[0].lore_who[l * REDIT_KEY..<(l + 1) * REDIT_KEY], pn.who);
      // the lore itself may hold no bar (the server makes them spaces): the rest after the first
      e[0].lore_text_n[l] = redit_copy(e[0].lore_text[l * REDIT_DRAFT..<(l + 1) * REDIT_DRAFT], pn.text);
      if e[0].lore_who_n[l] > 0 { e[0].lore_n = l + 1; }
    } else if pn.kind == EDITOR_PANE_QUEST && pn.fields == 6 && e[0].quest_n < REDIT_QUESTS {
      q := e[0].quest_n;
      e[0].quest_giver_n[q] = redit_copy(e[0].quest_giver[q * REDIT_KEY..<(q + 1) * REDIT_KEY], pn.who);
      for p: 0..<5 { at := (q * 5 + p) * REDIT_PART; e[0].quest_part_n[q * 5 + p] = redit_copy(e[0].quest_part[at..<at + REDIT_PART], pn.parts[p]); }
      if e[0].quest_giver_n[q] > 0 { e[0].quest_n = q + 1; }
    }
  }
  e[0].panes_version += 1;
}
// A realm whose characters know their lore and give quests reads the panes (once; again after each save).
redit_read_panes_too :: (e: [] RealmEdit) { if !e[0].panes_asked { e[0].panes_asked = true; e[0].panes_due = true; } }
// Bring up a character's panes (its lore p_first).
redit_focus :: (e: [] RealmEdit, p_who: string, p_name: string) {
  e[0].focus_n = redit_copy(e[0].focus[..], p_who);
  e[0].focus_name_n = redit_copy(e[0].focus_name[..], p_name);
  redit_upper(e[0].focus_name[..], e[0].focus_name_n);
  redit_load_drafts(e); redit_read_panes_too(e);
  e[0].pane = REDIT_LORE_PANE; e[0].typing = false; e[0].field = 0;
}
// The realm says, each frame, which of its characters you are by ("" none: whose panes are up stays).
// With EDIT open and nothing being typed, coming to a new one brings up its lore.
redit_near :: (e: [] RealmEdit, p_who: string, p_name: string) {
  if cast(string) e[0].near[0..<e[0].near_n] == p_who { return; }
  e[0].near_n = redit_copy(e[0].near[..], p_who);
  e[0].near_name_n = redit_copy(e[0].near_name[..], p_name);
  if p_who.count == 0 || !redit_may(e) || e[0].pane == REDIT_SHUT || e[0].typing || e[0].dirty { return; }
  if cast(string) e[0].focus[0..<e[0].focus_n] != p_who { redit_focus(e, p_who, p_name); }
}
redit_save :: (e: [] RealmEdit) {
  if !redit_may(e) || e[0].focus_n == 0 { return; }
  e[0].typing = false; e[0].field = 0;
  e[0].save_due = ifx e[0].pane == REDIT_QUEST_PANE then REQ_E_QUEST else REQ_E_LORE;
}

redit_note :: (e: [] RealmEdit, text: string) { e[0].note_n = redit_copy(e[0].note[..], text); e[0].note_at = e[0].time; }

// ---- starting

redit_start :: (e: [] RealmEdit, slug: string) {
  if !redit_slug_ok(slug) || cast(string) e[0].slug[0..<e[0].slug_n] == slug { return; }
  e[0].slug_n = redit_copy(e[0].slug[..], slug);
  e[0].req_id = -1; e[0].press = -1; e[0].finger = -1; e[0].switch_row = -1; e[0].switch_rev = -1; e[0].switch_last = -1;
  e[0].spec_due = true; e[0].field = 0; e[0].field_press = 0; e[0].job_n = 0; e[0].said_n = 0;
}

// ---- the spec (verse.edit_spec), a line each

redit_read :: (e: [] RealmEdit, text: string) -> bool {
  got := false;
  e[0].role = REDIT_VISITOR; e[0].row_n = 0; e[0].placed_n = 0;
  for i: 0..<REDIT_TOOLS { e[0].tool_has[i] = false; e[0].tool_on[i] = false; }
  owner := false;
  // each line and its fields come from metaverse-engine/editor/spec.coax, the spec's one reader
  i := 0;
  while i < text.count {
    l := editor_spec_line(text, i); i = l.next;
    if l.kind == SPEC_END { break; }
    if l.kind == SPEC_REALM { got = true; continue; }
    if l.kind == SPEC_OWNER { owner = editor_spec_on(l); continue; }
    if l.kind == SPEC_ROLE {
      r := editor_spec_word(l.line, 1);
      e[0].role = ifx r == "owner" then REDIT_OWNER else ifx r == "admin" then REDIT_ADMIN else REDIT_VISITOR;
      continue;
    }
    if l.kind == SPEC_TOOL {
      tl := editor_spec_tool(l);
      t := redit_tool_of(tl.name);
      if t >= 0 { e[0].tool_has[t] = true; e[0].tool_on[t] = tl.on; }
      continue;
    }
    if l.kind == SPEC_ROW && e[0].row_n < REDIT_ROWS {
      rw := editor_spec_row(l);
      r := e[0].row_n;
      e[0].row_key_n[r] = redit_copy(e[0].row_key[r * REDIT_KEY..<(r + 1) * REDIT_KEY], rw.key);
      e[0].row_on[r] = rw.on;
      e[0].row_label_n[r] = redit_copy(e[0].row_label[r * REDIT_LABEL..<(r + 1) * REDIT_LABEL], rw.label);
      redit_upper(e[0].row_label[r * REDIT_LABEL..<(r + 1) * REDIT_LABEL], e[0].row_label_n[r]);
      if e[0].row_key_n[r] > 0 { e[0].row_n = r + 1; }
      continue;
    }
    if l.kind == SPEC_PLACED && e[0].placed_n < REDIT_PLACED {
      pl := editor_spec_placed(l);
      p := e[0].placed_n;
      e[0].placed_thing_n[p] = redit_copy(e[0].placed_thing[p * REDIT_THING..<(p + 1) * REDIT_THING], pl.thing);
      e[0].placed_x[p] = redit_number(pl.x); e[0].placed_z[p] = redit_number(pl.z);
      e[0].placed_yaw[p] = redit_number(pl.yaw);
      e[0].placed_n = p + 1;
    }
  }
  // a made realm's spec says owner 1 to its owner and admins before it says the role
  if owner && e[0].role < REDIT_ADMIN { e[0].role = REDIT_ADMIN; }
  if !redit_may(e) { e[0].pane = REDIT_SHUT; e[0].typing = false; }
  return got;
}

// The board's rows after a revision ("plan ID" then "row ..." lines).
redit_read_rows :: (e: [] RealmEdit, text: string) {
  n := 0;
  i := 0;
  while i < text.count {
    l := editor_spec_line(text, i); i = l.next;
    if l.kind == SPEC_END { break; }
    if l.kind != SPEC_ROW { continue; }
    rw := editor_spec_row(l);
    r := redit_row(e, rw.key);
    if r >= 0 { was := e[0].row_on[r]; e[0].row_on[r] = rw.on; if was != e[0].row_on[r] { n += 1; } }
  }
}

// ---- requests: one at a time (apps/openagents-web/edit-face.h sends it, then says its id)

redit_busy :: (e: [] RealmEdit) -> bool { return e[0].req_ready || e[0].req_id >= 0; }
redit_requested :: (e: [] RealmEdit, id: int) #export_c #effects(all) {
  e[0].req_ready = false; e[0].req_id = id;
  if id < 0 {
    if e[0].req_what == REQ_E_SPEC && !e[0].ready { e[0].failed = true; }
    e[0].req_what = REQ_E_NONE;
  }
}
redit_ask :: (e: [] RealmEdit, what: int, tail: string, body_n: int, p_post: bool) {
  n := redit_put(e[0].req_url[..], 0, "/api/playtest/realms/");
  n = redit_put(e[0].req_url[..], n, cast(string) e[0].slug[0..<e[0].slug_n]);
  e[0].req_url_n = redit_put(e[0].req_url[..], n, tail);
  e[0].req_body_n = body_n;
  e[0].req_flags = (ifx p_post then HTTP_POST else 0) | HTTP_ANSWER | TRACK_KEY;
  e[0].req_what = what; e[0].req_ready = true; e[0].req_at = e[0].time;
}
// A request to the realm's world, /api/worlds/SLUG then `tail`, with the player's key (a made realm's maker may
// have no account); a body that did not fit is not sent.
redit_world_ask :: (e: [] RealmEdit, what: int, tail: string, body_n: int, p_post: bool) {
  if body_n < 0 { e[0].switch_row = -1; redit_note(e, "Not switched. Try again."); return; }
  n := redit_put(e[0].req_url[..], 0, "/api/worlds/");
  n = redit_put(e[0].req_url[..], n, cast(string) e[0].slug[0..<e[0].slug_n]);
  e[0].req_url_n = redit_put(e[0].req_url[..], n, tail);
  e[0].req_body_n = body_n;
  e[0].req_flags = (ifx p_post then HTTP_POST else 0) | HTTP_ANSWER | TRACK_KEY;
  e[0].req_what = what; e[0].req_ready = true; e[0].req_at = e[0].time;
}
// An edit's body from metaverse-engine/editor/change.coax (edits.proto) goes out; one too long for the page's
// buffer is not sent.
redit_send :: (e: [] RealmEdit, what: int, tail: string, body_n: int) {
  if body_n < 0 { redit_note(e, "That's too long. Say it shorter."); return; }
  redit_ask(e, what, tail, body_n, true);
}
// A JSON string, its quotes and backslashes escaped, control bytes dropped.
redit_quote :: (buf: [] u8, at: int, text: string) -> int {
  n := redit_put(buf, at, "\"");
  for i: 0..<text.count {
    c := text[i];
    if c < 32 { continue; }
    if c == '"' || c == '\\' { n = redit_put(buf, n, "\\"); }
    if n + 2 >= buf.count { break; }
    buf[n] = c; n += 1;
  }
  return redit_put(buf, n, "\"");
}
redit_next :: (e: [] RealmEdit) {
  if redit_busy(e) || e[0].slug_n == 0 { return; }
  b := e[0].req_body[..];
  if e[0].spec_due { e[0].spec_due = false; e[0].asked = true; redit_ask(e, REQ_E_SPEC, "", 0, false); return; }
  if e[0].job_n > 0 && redit_may(e) { redit_job_go(e); return; }
  if e[0].save_due == REQ_E_LORE {
    e[0].save_due = 0;
    redit_send(e, REQ_E_LORE, "/lore", editor_lore_body(0, cast(string) e[0].focus[0..<e[0].focus_n], redit_draft(e, RF_LORE), true, b));
    return;
  }
  if e[0].save_due == REQ_E_QUEST {
    e[0].save_due = 0;
    steps: [3] string; for t: 0..<3 { steps[t] = redit_draft(e, RF_STEP + t); }
    redit_send(e, REQ_E_QUEST, "/quest", editor_quest_body(0, cast(string) e[0].focus[0..<e[0].focus_n], redit_draft(e, RF_ASK), steps[..], redit_draft(e, RF_REWARD), true, b));
    return;
  }
  if e[0].switch_row >= 0 {
    // a row switched is a cell edit of the realm's world (/api/worlds/SLUG, metaverse/edit/realm-world.coax): the
    // rows table is the board in the spec's order, so row r is the table's row r + 1. Its revision is read first;
    // a batch from a revision another change passed is read and sent once more.
    r := e[0].switch_row;
    if e[0].switch_rev < 0 { redit_world_ask(e, REQ_E_SWITCH_REV, "?lane=dev", 0, false); return; }
    e[0].switch_row = -1; e[0].switch_last = r;
    edit := WorldEdit.{ok = true, op = WE_CELL, id = r + 1};
    edit.table_n = ct_copy(edit.table[..], "rows"); edit.name_n = ct_copy(edit.name[..], "on"); edit.text_n = ct_copy(edit.text[..], ifx e[0].switch_on then "1" else "0");
    ed := [1] WorldEdit.[edit];
    batch := we_batch_write(e[0].switch_rev, WB_APPLY, ed[..], 1, b);
    e[0].switch_rev = -1;
    redit_world_ask(e, REQ_E_SWITCH, "", ifx batch.count == 0 then -1 else batch.count, true);
    return;
  }
  if e[0].asks_due && redit_may(e) { e[0].asks_due = false; redit_ask(e, REQ_E_ASKS, "/asks", 0, false); return; }
  if e[0].panes_due && e[0].ready { e[0].panes_due = false; redit_ask(e, REQ_E_PANES, "/panes", 0, false); return; }
  // edits from elsewhere (the CLI, Coder, another tab): an owner's page reads its spec again every second
  if e[0].ready && redit_may(e) && !e[0].typing && e[0].time - e[0].watched_at > REDIT_WATCH {
    e[0].watched_at = e[0].time; e[0].asked = true; redit_ask(e, REQ_E_SPEC, "", 0, false);
  }
}
REDIT_WATCH :: 1.0f32;

// ---- the agent strip's realm steps (#13528)

// The shell's action of realm steps (shell.coax ES_REALM), a step a line, each a job in order: "ask WORDS",
// "revise WORDS", "unask ID", "unrow TABLE ROW" (only the rows table: the board) or "look WORDS". The lines are
// the shell's typed plan (world.plan.v1's steps) written by its one writer; a line that is not one is dropped.
redit_realm :: (e: [] RealmEdit, text: string) {
  if !redit_may(e) { redit_said(e, "Only the world's owner and admins change its list of asks."); return; }
  i := 0;
  while i < text.count {
    end := redit_line_end(text, i); line := text[i..<end]; i = end + 1;
    verb := redit_word(line, 0); rest := redit_rest(line, 1);
    what := ifx verb == "ask" then REDIT_JOB_ASK else ifx verb == "revise" then REDIT_JOB_REVISE else ifx verb == "unask" then REDIT_JOB_UNASK
            else ifx verb == "unrow" then REDIT_JOB_UNROW else ifx verb == "look" then REDIT_JOB_LOOK else 0;
    if what == 0 || rest.count == 0 || rest.count > REDIT_TYPED || e[0].job_n >= REDIT_JOBS { continue; }
    j := e[0].job_n;
    e[0].job_what[j] = what; e[0].job_text_n[j] = redit_copy(e[0].job_text[j * REDIT_TYPED..<(j + 1) * REDIT_TYPED], rest);
    e[0].job_n = j + 1;
  }
}
redit_job_text :: (e: [] RealmEdit, j: int) -> string { return cast(string) e[0].job_text[j * REDIT_TYPED..<j * REDIT_TYPED + e[0].job_text_n[j]]; }
// The first job goes as the server's request; the rest move up.
redit_job_go :: (e: [] RealmEdit) {
  what := e[0].job_what[0]; words: [REDIT_TYPED] u8; wn := redit_copy(words[..], redit_job_text(e, 0));
  for j: 1..<e[0].job_n { e[0].job_what[j - 1] = e[0].job_what[j]; e[0].job_text_n[j - 1] = redit_copy(e[0].job_text[(j - 1) * REDIT_TYPED..<j * REDIT_TYPED], redit_job_text(e, j)); }
  e[0].job_n -= 1;
  w := cast(string) words[0..<wn]; b := e[0].req_body[..];
  if what == REDIT_JOB_ASK { redit_send(e, REQ_E_ADD, "/asks", editor_words_body(0, "words", w, true, b)); return; }
  if what == REDIT_JOB_REVISE { redit_send(e, REQ_E_REVISE, "/revise", editor_words_body(0, "prompt", w, true, b)); return; }
  tail: [REDIT_KEY + 24] u8; m := 0;
  if what == REDIT_JOB_UNASK {
    id := redit_int(w);
    if id < 1 { return; }
    m = redit_put(tail[..], 0, "/asks/"); m = redit_put_int(tail[..], m, id);
  } else if what == REDIT_JOB_UNROW {
    // the rows table is the board in the spec's order: its row r is the spec's row r - 1
    r := redit_int(redit_word(w, 1)) - 1;
    if redit_word(w, 0) != "rows" || r < 0 || r >= e[0].row_n { redit_said(e, "That row can't be deleted here."); return; }
    m = redit_put(tail[..], 0, "/rows/"); m = redit_put(tail[..], m, redit_key_of(e, r));
  } else if what == REDIT_JOB_LOOK {
    n := redit_put(b, 0, "{\"question\":"); n = redit_quote(b, n, w);
    e[0].req_body_n = redit_put(b, n, "}");
    p := redit_put(e[0].req_url[..], 0, "/api/playtest/realm/");
    p = redit_put(e[0].req_url[..], p, cast(string) e[0].slug[0..<e[0].slug_n]);
    e[0].req_url_n = redit_put(e[0].req_url[..], p, "/look");
    e[0].req_flags = HTTP_POST | HTTP_ANSWER | TRACK_KEY | REDIT_HTTP_FRAME;
    e[0].req_what = REQ_E_LOOK; e[0].req_ready = true; e[0].req_at = e[0].time;
    return;
  }
  if m > 0 { m = redit_put(tail[..], m, "/delete"); redit_ask(e, REQ_E_DELETE, cast(string) tail[0..<m], 0, true); }
}
// Words for the strip: what came of a realm step, a sentence each, joined while the strip has not taken them.
redit_said :: (e: [] RealmEdit, words: string) {
  redit_note(e, words);
  if words.count == 0 { return; }
  n := e[0].said_n;
  if n > 0 { n = redit_put(e[0].said[..], n, " "); }
  if n + words.count > REDIT_SAID { return; }
  e[0].said_n = redit_put(e[0].said[..], n, words);
}
// The realm's asks, for a world that tells them to the editor shell: asked for once, then written into the world's
// page whenever they were read again (realm-page.coax rp_asks).
redit_asks_to :: (e: [] RealmEdit, w: [] RealmPage) {
  if !w[0].on || !redit_may(e) { return; }
  if !e[0].asks_wanted { e[0].asks_wanted = true; e[0].asks_due = true; }
  if w[0].asks && w[0].asks_v == e[0].asks_v { return; }
  rp_asks_begin(w, e[0].asks_v);
  for a: 0..<e[0].ask_n {
    st := ifx e[0].ask_state[a] == ASK_APPLIED then RP_ASK_APPLIED else ifx e[0].ask_state[a] == ASK_REMOVING then RP_ASK_REMOVING else RP_ASK_WAITING;
    rp_ask(w, e[0].ask_id[a], st, cast(string) e[0].ask_words[a * REDIT_WORDS..<a * REDIT_WORDS + e[0].ask_words_n[a]]);
  }
  rp_asks_end(w);
}
// Two sums of a spec's bytes: the same three numbers mean the same spec.
redit_same_spec :: (e: [] RealmEdit, text: string) -> bool {
  a := 0; b := 0;
  for i: 0..<text.count { a = (a * 131 + cast(int) text[i]) % 1000000007; b = (b * 257 + cast(int) text[i]) % 998244353; }
  unchanged := e[0].spec_len == text.count && e[0].spec_sum == a && e[0].spec_sum2 == b;
  e[0].spec_len = text.count; e[0].spec_sum = a; e[0].spec_sum2 = b;
  return unchanged;
}

// redit_has (does our server's answer hold a field) is edit-text.coax's.
redit_status :: (text: string) -> int { return redit_int(text[0..<redit_line_end(text, 0)]); }
redit_body :: (text: string) -> string { e := redit_line_end(text, 0); return ifx e + 1 <= text.count then text[e + 1..<text.count] else ""; }

redit_answer :: (e: [] RealmEdit, text: string) {
  what := e[0].req_what;
  e[0].req_id = -1; e[0].req_what = REQ_E_NONE;
  status := redit_status(text); p_body := redit_body(text);
  if what == REQ_E_SPEC {
    if status == 200 && redit_same_spec(e, p_body) && e[0].ready { return; }
    if status == 200 && redit_read(e, p_body) {
      first := !e[0].ready;
      e[0].ready = true; e[0].changed = true; e[0].version += 1;
      if e[0].asks_wanted { e[0].asks_due = true; }   // a change from elsewhere (the CLI, Coder) may be an ask
    } else if !e[0].ready { e[0].failed = true; }
    return;
  }
  if what == REQ_E_LOOK {
    p_said := redit_json_text(p_body, "reply");
    redit_said(e, ifx status == 200 && p_said.count > 0 then p_said else ifx status == 429 then "One at a time: ask again in a moment."
                  else ifx status == 401 || status == 403 then "Only its owner and admins ask that." else "We couldn't see the screen. Try again.");
    return;
  }
  if what == REQ_E_SWITCH_REV {
    // the world's state (world.state.v1, its one codec); the page's world buffers are scratch between its answers
    w := e[0].world[..];
    v := ifx status == 200 then we_state_read(p_body, w[0].sdoc[..], w[0].sdid[..], w[0].sscratch[..]) else WorldState.{};
    if v.ok && v.rev >= 0 { e[0].switch_rev = v.rev; return; }
    e[0].switch_row = -1; e[0].switch_tries = 0; redit_note(e, "Not switched. Try again."); e[0].spec_due = true;
    return;
  }
  if what == REQ_E_SWITCH {
    // changed since its revision was read (409): once more from the revision there now
    if status == 409 && e[0].switch_tries < 1 && e[0].switch_last >= 0 { e[0].switch_tries += 1; e[0].switch_row = e[0].switch_last; return; }
    e[0].switch_tries = 0; e[0].switch_last = -1;
    if status != 200 { redit_note(e, "Not switched. Try again."); }
    e[0].spec_due = true;
    return;
  }
  if what == REQ_E_ADD {
    if status == 200 {
      redit_read_rows(e, p_body);
      p_first := p_body[0..<redit_line_end(p_body, 0)];
      redit_said(e, ifx editor_read_ask(p_first).state == "applied" then "Added to the list and applied: it's in the world now." else "Added to the list. It isn't applied yet: it waits on the list for code.");
      e[0].spec_due = true; e[0].asks_due = true;
    }
    else if status == 429 { redit_said(e, "One at a time: ask again in a moment."); }
    else if status == 403 { redit_said(e, "Only its owner and admins change it."); }
    else { redit_said(e, ifx p_body.count > 0 && p_body.count < 60 then p_body else "That ask didn't go on the list. Try again."); }
    return;
  }
  if what == REQ_E_ASKS { if status == 200 { redit_read_asks(e, p_body); } return; }
  if what == REQ_E_DELETE {
    if status == 200 { redit_said(e, ifx editor_change_deleted(p_body) then "Deleted." else "Off now; its code comes out next."); }
    else if status == 403 { redit_said(e, "Only its owner and admins change it."); }
    else { redit_said(e, "Not deleted. Try again."); }
    e[0].spec_due = true; e[0].asks_due = true;
    return;
  }
  if what == REQ_E_REVISE {
    if status == 200 { redit_read_rows(e, p_body); redit_said(e, "The board is revised: the world has it now."); e[0].spec_due = true; }
    else if status == 429 { redit_said(e, "One at a time: ask again in a moment."); }
    else if status == 403 { redit_said(e, "Only its owner and admins change it."); }
    else { redit_said(e, ifx p_body.count > 0 && p_body.count < 60 then p_body else "The board wasn't revised. Try again."); }
    return;
  }
  if what == REQ_E_PANES {
    if status == 200 { redit_read_panes(e, p_body); if !e[0].dirty && !e[0].typing && e[0].focus_n > 0 { redit_load_drafts(e); } }
    return;
  }
  if what == REQ_E_LORE || what == REQ_E_QUEST {
    if status == 200 {
      e[0].dirty = false; e[0].panes_due = true;
      p_gone := ifx what == REQ_E_LORE then redit_draft(e, RF_LORE).count == 0 else redit_draft(e, RF_ASK).count == 0;
      redit_note(e, ifx what == REQ_E_LORE then (ifx p_gone then "Lore cleared." else "Lore saved.") else (ifx p_gone then "Quest taken away." else "Quest saved: it is in the world now."));
    } else if status == 403 { redit_note(e, "Only its owner and admins change it."); }
    else if status == 409 { redit_note(e, "This world is full of them."); }
    else { redit_note(e, "Not saved. Try again."); }
    return;
  }
}

// ---- in from the host: true when it was this layer's

redit_message :: (e: [] RealmEdit, kind: int, text: string) -> bool #export_c #effects(all) {
  if kind == REDIT_FACTS {
    p_page := redit_page_of(fact_of(text, "url"));
    if p_page.count + 6 <= REDIT_URL { e[0].page_n = redit_copy(e[0].page[..], p_page); }
    return false; }
  if kind >= HTTP_KIND && kind < HTTP_KIND + 8 && e[0].req_id >= 0 && kind - HTTP_KIND == e[0].req_id { redit_answer(e, text); return true; }
  if kind == REDIT_MSG_TEXT && e[0].typing && e[0].field > 0 {
    f := e[0].field - 1; cap := redit_field_cap(f);
    for i: 0..<text.count { if e[0].draft_n[f] < cap && text[i] >= 32 && text[i] != '|' { e[0].draft[f * REDIT_DRAFT + e[0].draft_n[f]] = text[i]; e[0].draft_n[f] += 1; e[0].dirty = true; } }
    return true;
  }
  if kind == REDIT_MSG_TEXT && e[0].typing {
    for i: 0..<text.count { if e[0].typed_n < REDIT_TYPED && text[i] >= 32 { e[0].typed[e[0].typed_n] = text[i]; e[0].typed_n += 1; } }
    return true;
  }
  return false;
}
// ---- actions out: the realm passes them on from its own p_outbox

RAct :: struct { kind: int; n: int; }
redit_take_action :: (e: [] RealmEdit, p_outbox: [] u8) -> RAct {
  if e[0].go_due {
    e[0].go_due = false;
    m := redit_put(p_outbox, 0, cast(string) e[0].page[0..<e[0].page_n]); m = redit_put(p_outbox, m, "?edit");
    return RAct.{kind = REDIT_ACT_GO, n = m};
  }
  // what came of the strip's realm steps, for the strip (the outbox holds what fits; the rest is dropped)
  if e[0].said_n > 0 {
    m := redit_put(p_outbox, 0, cast(string) e[0].said[0..<e[0].said_n]); e[0].said_n = 0;
    return RAct.{kind = REDIT_ACT_AGENT, n = m};
  }
  return RAct.{kind = 0, n = 0};
}

// ---- toggles

redit_switch :: (e: [] RealmEdit, r: int) {
  if !redit_may(e) || r < 0 || r >= e[0].row_n || e[0].switch_row >= 0 { return; }
  e[0].row_on[r] = !e[0].row_on[r];
  e[0].switch_row = r; e[0].switch_on = e[0].row_on[r];
  e[0].changed = true; e[0].version += 1;
}
// What a realm's voice or typing heard, as the server's selector picked it (migrations/0104): switch one
// of the realm's rows, or show one of these panes (edit, settings, ideas, close). Any realm's page hands
// these here; the reply, a plain sentence to show and speak, goes into out. -1: not one of these.
redit_heard :: (e: [] RealmEdit, word: string, key: string, on: bool, pane_said: string, out: [] u8) -> int {
  if word != "switch" && word != "show" { return -1; }
  if !redit_may(e) { return redit_put(out, 0, "Only the world's owner can change that."); }
  if word == "switch" {
    r := redit_row(e, key);
    if r < 0 { return redit_put(out, 0, "This world has no such switch."); }
    if e[0].row_on[r] != on { redit_switch(e, r); }
    n := redit_put(out, 0, redit_label_of(e, r));
    for i: 1..<n { if out[i] >= 'A' && out[i] <= 'Z' { out[i] = out[i] + 32; } }   // the board's capitals, said as a sentence
    return redit_put(out, n, ifx on then ": on." else ": off.");
  }
  // a pane already open stays open (redit_pane toggles)
  if pane_said == "close" { if e[0].pane != REDIT_SHUT { redit_pane(e, e[0].pane); } return redit_put(out, 0, "Closed."); }
  if pane_said == "settings" { redit_open_editor(e); return redit_put(out, 0, "The settings are in the editor: opening it."); }
  if pane_said == "ideas" { redit_open_editor(e); return redit_put(out, 0, "Visitors' ideas wait in the editor: opening it."); }
  if e[0].pane != REDIT_BOARD { redit_pane(e, REDIT_BOARD); }
  return redit_put(out, 0, "Here's the edit panel.");
}

// A string field of our server's JSON ("" none): its replies hold no quotes (verse.voice_edit_reply).
redit_json_text :: (text: string, key: string) -> string {
  at := redit_json_at(text, key);
  if at < 0 || at >= text.count || text[at] != '"' { return ""; }
  e := at + 1; while e < text.count && text[e] != '"' { e += 1; }
  return text[at + 1..<e];
}
// Where a key's value starts, past the colon and spaces (-1 none).
redit_json_at :: (text: string, key: string) -> int {
  n := key.count + 2;
  if text.count < n { return -1; }
  for i: 0..<text.count - n + 1 {
    if text[i] != '"' || text[i + n - 1] != '"' || text[i + 1..<i + n - 1] != key { continue; }
    j := i + n; while j < text.count && text[j] == ' ' { j += 1; }
    if j >= text.count || text[j] != ':' { continue; }
    j += 1; while j < text.count && text[j] == ' ' { j += 1; }
    return j;
  }
  return -1;
}
// OPEN THE EDITOR: this page again with ?edit (the host opens the shell over it). Nothing without the page's path.
redit_open_editor :: (e: [] RealmEdit) { if redit_may(e) && e[0].page_n > 0 { e[0].go_due = true; } }
// The page's path from its url fact (scheme and host, query and hash dropped): "" when it has none.
redit_page_of :: (url: string) -> string {
  a := 0;
  for i: 0..<url.count { if i + 2 < url.count && url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/' { a = i + 3; while a < url.count && url[a] != '/' { a += 1; } break; } }
  if a >= url.count || url[a] != '/' { return ""; }
  b := a; while b < url.count && url[b] != '?' && url[b] != '#' { b += 1; }
  return url[a..<b];
}
redit_pane :: (e: [] RealmEdit, pane: int) {
  if !redit_may(e) { return; }
  e[0].pane = ifx e[0].pane == pane then REDIT_SHUT else pane;
  e[0].typing = false; e[0].field = 0;
}
redit_toggle :: (e: [] RealmEdit) {
  if e[0].pane != REDIT_SHUT { e[0].pane = REDIT_SHUT; e[0].typing = false; e[0].field = 0; return; }
  e[0].typing = false;
  // by a character: its lore comes up; anywhere else, the board
  if redit_may(e) && e[0].near_n > 0 { redit_focus(e, cast(string) e[0].near[0..<e[0].near_n], cast(string) e[0].near_name[0..<e[0].near_name_n]); return; }
  redit_pane(e, REDIT_BOARD);
}
redit_send_typed :: (e: [] RealmEdit) {
  w := cast(string) e[0].typed[0..<e[0].typed_n];
  e[0].typing = false;
  e[0].typed_n = 0;
}

// Each frame: the clock and the next request.
redit_step :: (e: [] RealmEdit, time: f32, width: f32, height: f32, dpr: f32) {
  e[0].time = time; e[0].width = width; e[0].height = height; e[0].dpr = redit_hi(dpr, 0.5);
  if e[0].note_n > 0 && time - e[0].note_at > 6 { e[0].note_n = 0; }
  redit_next(e);
}

// ---- the realm's world, for a face that opts in (apps/openagents-web/edit-face.h, EDIT_FACE_WORLD): its
// step, its messages, its one request, and what the editor shell is told (docs/protocol/editor-model-v1.md),
// all from the realm's page in its world (realm-page.coax), which My Realm also holds. The host opens the shell
// for whoever may edit. Nothing above calls these, so a realm whose face does not opt in (Everglade, whose
// board belongs with its own world, #13477; My Realm, which follows its world itself) asks its world nothing.
// A frame's turn, on the layer's clock: the world is opened only for a visitor who may edit, on a page the host
// asked for the editor (opened with ?edit).
redit_world_step :: (e: [] RealmEdit) #export_c #effects(all) {
  w := e[0].world[..];
  dt := e[0].time - e[0].world_at; e[0].world_at = e[0].time;
  if !w[0].on {
    if !e[0].shell_asked || !redit_may(e) || e[0].slug_n == 0 || !rp_open(w, cast(string) e[0].slug[0..<e[0].slug_n]) { return; }
    e[0].world_version = e[0].version;
    rp_cards_for(w, true);   // its owner's or an admin's: the visitors' proposals wait in the shell's agent strip (#13527)
  }
  // the spec was read again (a revise, a row deleted, the CLI): so are the world's state and tables
  if e[0].version != e[0].world_version { e[0].world_version = e[0].version; wf_reopen(w[0].f[..]); }
  redit_asks_to(e, w);   // the asks, for the strip's turn
  rp_step(w, ifx dt < 0 then 0 else (ifx dt > 0.25 then 0.25 else dt));
}
// A message for the page: the world's answers, and the editor shell's batches (520), selection (521), Add
// (523, planned from redit_here) and the strip's realm steps (530); its batches are the page's own writes. True
// when it was the world's.
redit_world_message :: (e: [] RealmEdit, kind: int, text: string) -> bool #export_c #effects(all) {
  if kind >= HTTP_KIND && kind < HTTP_KIND + 8 { return rp_answer(e[0].world[..], kind - HTTP_KIND, text); }
  if kind == REDIT_MSG_REALM { redit_realm(e, text); return true; }
  if kind == RP_BATCH_KIND || kind == RP_SELECT || kind == RP_ADD { return rp_message(e[0].world[..], kind, text); }
  return false;
}
// A message for a realm whose board the editor shell edits: the world's first, then the layer's own. Such a
// realm hands its messages here where another hands them to redit_message.
redit_message_shell :: (e: [] RealmEdit, kind: int, text: string) -> bool #export_c #effects(all) {
  if redit_world_message(e, kind, text) { return true; }
  return redit_message(e, kind, text);
}
// Where the player stands, in metres, each frame: the shell's Add places things there (realm-page.coax rp_here).
redit_here :: (e: [] RealmEdit, x: f32, z: f32) { if e[0].world[0].on { rp_here(e[0].world[..], x, z); } }
redit_world_wants :: (e: [] RealmEdit) -> bool #export_c #effects(all) { return rp_wants(e[0].world[..]); }
redit_world_url :: (e: [] RealmEdit) -> string #export_c #effects(all) { return rp_url(e[0].world[..]); }
redit_world_body :: (e: [] RealmEdit) -> string #export_c #effects(all) { return rp_body(e[0].world[..]); }
// the player's key goes with every request: a maker with no account is known to the realm's world only by it
redit_world_flags :: (e: [] RealmEdit) -> int #export_c #effects(all) { return rp_flags(e[0].world[..]) | TRACK_KEY; }
redit_world_sent :: (e: [] RealmEdit, id: int) #export_c #effects(all) { rp_sent(e[0].world[..], id); }
// The host asks these only on a page opened with ?edit (coax/web/host.js editorOpen, editorCarry): being asked is
// how the layer knows the editor is wanted. The model is "" until the world was opened.
redit_edit_rev :: (e: [] RealmEdit) -> int #export_c #effects(all) { e[0].shell_asked = true; return rp_rev(e[0].world[..]); }
redit_edit_model :: (e: [] RealmEdit) -> string #export_c #effects(all) { return ifx e[0].world[0].on then rp_model(e[0].world[..]) else ""; }
// Whether the shell opens over this page: the realm's server said this visitor may edit it (its owner, its
// admins and the site's). The host asks again until it does (coax/web/host.js, coaxial_edit_own).
redit_edit_own :: (e: [] RealmEdit) -> bool #export_c #effects(all) { e[0].shell_asked = true; return redit_may(e); }

// ---- input: 0 not this layer's, 1 used, 2 typed text the host should send (the realm does nothing with it)

redit_key :: (e: [] RealmEdit, key: int, p_down: bool) -> int {
  if e[0].typing && e[0].field > 0 {
    if !p_down { return 2; }
    f := e[0].field - 1;
    if key == REDIT_KEY_ENTER || key == REDIT_KEY_ESCAPE { e[0].typing = false; e[0].field = 0; return 1; }
    if key == REDIT_KEY_BACKSPACE {
      if e[0].draft_n[f] > 0 { e[0].dirty = true; e[0].draft_n[f] -= 1; while e[0].draft_n[f] > 0 && (e[0].draft[f * REDIT_DRAFT + e[0].draft_n[f]] & 0xC0) == 0x80 { e[0].draft_n[f] -= 1; } }
      return 1;
    }
    return 2;
  }
  if e[0].typing {
    if !p_down { return 2; }
    if key == REDIT_KEY_ENTER { redit_send_typed(e); return 1; }
    if key == REDIT_KEY_ESCAPE { e[0].typing = false; e[0].typed_n = 0; return 1; }
    if key == REDIT_KEY_BACKSPACE { if e[0].typed_n > 0 { e[0].typed_n -= 1; while e[0].typed_n > 0 && (e[0].typed[e[0].typed_n] & 0xC0) == 0x80 { e[0].typed_n -= 1; } } return 1; }
    return 2;
  }
  if e[0].pane == REDIT_SHUT { return 0; }
  if key == REDIT_KEY_ESCAPE && p_down { redit_toggle(e); return 1; }
  return 0;
}
redit_inside :: (b: RBox, x: f32, y: f32) -> bool { return x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
redit_button_at :: (e: [] RealmEdit, x: f32, y: f32) -> int { for i: 0..<RB_N { if e[0].shown[i] && redit_inside(e[0].boxes[i], x, y) { return i; } } return -1; }
redit_field_at :: (e: [] RealmEdit, x: f32, y: f32) -> int { for f: 0..<RF_N { if e[0].fshown[f] && redit_inside(e[0].fbox[f], x, y) { return f; } } return -1; }
// Over the layer: the pane's plate or a button.
redit_over :: (e: [] RealmEdit, x: f32, y: f32) -> bool {
  if redit_button_at(e, x, y) >= 0 { return true; }
  for i: 0..<e[0].plate_n { if redit_inside(e[0].plate_box[i], x, y) { return true; } }
  return redit_field_at(e, x, y) >= 0;
}
redit_press :: (e: [] RealmEdit, b: int) {
  if b == RB_EDIT { redit_toggle(e); return; }
  if b >= RB_TAB && b < RB_TAB + 3 { p := b - RB_TAB + 1; if e[0].pane != p { redit_pane(e, p); } return; }
  if b == RB_SAVE { redit_save(e); return; }
  if b == RB_OPEN { redit_open_editor(e); return; }
  if b == RB_SWAP { e[0].pane = ifx e[0].pane == REDIT_LORE_PANE then REDIT_QUEST_PANE else REDIT_LORE_PANE; e[0].typing = false; e[0].field = 0; }
}
redit_pointer :: (e: [] RealmEdit, x: f32, y: f32, phase: int, id: int) -> bool {
  if !redit_may(e) { return false; }
  if phase == 0 {
    b := redit_button_at(e, x, y);
    if b >= 0 { e[0].press = b; e[0].finger = id; return true; }
    f := redit_field_at(e, x, y);
    if f >= 0 { e[0].field_press = f + 1; e[0].finger = id; return true; }
    return redit_over(e, x, y);
  }
  if id != e[0].finger || (e[0].press < 0 && e[0].field_press == 0) { return phase != 1 && redit_over(e, x, y); }
  if phase == 1 { return true; }
  b := e[0].press; fp := e[0].field_press;
  e[0].press = -1; e[0].finger = -1; e[0].field_press = 0;
  if fp > 0 && phase != 3 && redit_field_at(e, x, y) == fp - 1 { e[0].typing = true; e[0].field = fp; e[0].typed_n = 0; return true; }
  if phase == 3 { return true; }
  if b >= 0 && redit_button_at(e, x, y) == b { redit_press(e, b); }
  return true;
}

// ---- the look: Filament on the Metaverse HUD's plates (gold and parchment, as every realm's HUD)

REDIT_GAP :: 0.5; REDIT_SPACE :: 1.2;
redit_ink :: (k: f32, light: f32, r: f32, g: f32, b: f32) -> Ink {
  return Ink.{core = 0.55 * k, light = light, glow = 1.2 * k, red = r, green = g, blue = b, mode = 0, scale = k};
}
redit_gold :: (k: f32, light: f32) -> Ink { return redit_ink(k, light, 0.80, 0.64, 0.36); }
redit_parch :: (k: f32, light: f32) -> Ink { return redit_ink(k, light, 0.91, 0.863, 0.753); }
redit_width :: (text: string, cap: f32) -> f32 { return measure(text, REDIT_GAP, REDIT_SPACE, false) * cap; }
redit_plate :: (e: [] RealmEdit, b: RBox, p_alpha: f32, look: f32) {
  if e[0].plate_n >= REDIT_PLATES { return; }
  p := e[0].plate_n;
  e[0].plate_box[p] = b; e[0].plate_alpha[p] = p_alpha; e[0].plate_look[p] = look; e[0].plate_n = p + 1;
}
redit_text :: (e: [] RealmEdit, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink, room: f32) -> int {
  c := cap; w := redit_width(text, c);
  if room > 0 && w > room { c = c * room / w; }
  return draw_text(out, at, text, floor(x), floor(base), c, REDIT_GAP, REDIT_SPACE, k, false, false);
}
// Text at its size, cut with "..." where it runs past room (a step or a request can be long).
redit_clip :: (e: [] RealmEdit, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink, room: f32) -> int {
  if redit_width(text, cap) <= room { return redit_text(e, out, at, text, x, base, cap, k, room); }
  p_cut: [204] u8;
  p_m := redit_put(p_cut[..], 0, text[0..<redit_fit(text, 0, cap, room - redit_width("...", cap))]);
  p_m = redit_put(p_cut[..], redit_least(p_m, 200), "...");
  return redit_text(e, out, at, cast(string) p_cut[0..<p_m], x, base, cap, k, room);
}
redit_button :: (e: [] RealmEdit, out: [] f32, at: int, b: int, p_box: RBox, label: string, on: bool) -> int {
  k := e[0].dpr;
  e[0].boxes[b] = p_box; e[0].shown[b] = true;
  redit_plate(e, p_box, 0.88, ifx on || e[0].press == b then 2.0f32 else 1.0f32);
  ts := 8.5 * k; room := p_box.x1 - p_box.x0 - 12 * k;
  tw := redit_lo(redit_width(label, ts), room);
  return redit_text(e, out, at, label, (p_box.x0 + p_box.x1 - tw) / 2, p_box.y1 - (p_box.y1 - p_box.y0 - ts) / 2, ts, redit_gold(k, 0.95), room);
}
redit_check :: (out: [] f32, at: int, x: f32, y: f32, size: f32, on: bool, k: f32) -> int {
  n := at;
  r := 0.8 * k; g := 0.9 * k;
  if lit(out, n, x, y, x + size, y, r, 0.8, g, 0.80, 0.64, 0.36, 0) { n += 6; }
  if lit(out, n, x + size, y, x + size, y + size, r, 0.8, g, 0.80, 0.64, 0.36, 0) { n += 6; }
  if lit(out, n, x + size, y + size, x, y + size, r, 0.8, g, 0.80, 0.64, 0.36, 0) { n += 6; }
  if lit(out, n, x, y + size, x, y, r, 0.8, g, 0.80, 0.64, 0.36, 0) { n += 6; }
  if on {
    if lit(out, n, x + size * 0.2, y + size * 0.55, x + size * 0.42, y + size * 0.78, 1.1 * k, 1.0, 1.4 * k, 0.91, 0.47, 0.17, 0) { n += 6; }
    if lit(out, n, x + size * 0.42, y + size * 0.78, x + size * 0.82, y + size * 0.22, 1.1 * k, 1.0, 1.4 * k, 0.91, 0.47, 0.17, 0) { n += 6; }
  }
  return n;
}

// EDIT in the p_box the realm gives (an owner's or admin's only), and the open pane under it. Returns
// the vertices drawn so far; the plates to draw are plate_box[0..<plate_n].
redit_hud :: (e: [] RealmEdit, out: [] f32, at: int, anchor: RBox) -> int {
  e[0].plate_n = 0;
  for i: 0..<RB_N { e[0].shown[i] = false; }
  for i: 0..<REDIT_ROWS { e[0].row_shown[i] = false; }
  for f: 0..<RF_N { e[0].fshown[f] = false; }
  if !e[0].ready || !redit_may(e) { return at; }
  k := e[0].dpr;
  n := redit_button(e, out, at, RB_EDIT, anchor, ifx e[0].pane != REDIT_SHUT then "DONE" else "EDIT", e[0].pane != REDIT_SHUT);
  if e[0].pane == REDIT_SHUT { return n; }
  p_phone := e[0].width < 640 * k;
  pw := ifx p_phone then e[0].width - 24 * k else redit_lo(360 * k, e[0].width - 24 * k);
  x0 := ifx p_phone then 12 * k else redit_hi(12 * k, anchor.x1 - pw);
  y0 := anchor.y1 + 10 * k;
  y1 := redit_lo(e[0].height - 12 * k, y0 + 520 * k);
  x1 := x0 + pw;
  redit_plate(e, RBox.{x0 = x0, y0 = y0, x1 = x1, y1 = y1}, 0.9, 0);
  pad := 14 * k;
  // the tabs: one pane at a time
  tabs := [1] string.["FEATURES"];   // SETTINGS and IDEAS are the editor's (#13506, #13527); COMPUTER and AGENT are Settings' (#13529)
  p_tab_of: [1] int; p_tabs := 1;   // which of tabs each shown tab is
  tw := (pw - 2 * pad - f32(p_tabs - 1) * 6 * k) / f32(p_tabs);
  for p_ti: 0..<p_tabs {
    t := p_tab_of[p_ti];
    bx := x0 + pad + f32(p_ti) * (tw + 6 * k);
    label := tabs[t];
    p_tb := RB_TAB + t;
    p_tp := t + 1;
    n = redit_button(e, out, n, p_tb, RBox.{x0 = bx, y0 = y0 + pad, x1 = bx + tw, y1 = y0 + pad + 30 * k}, label, e[0].pane == p_tp);
  }
  y := y0 + pad + 30 * k + 18 * k;
  room := pw - 2 * pad;
  if e[0].pane == REDIT_BOARD { n = redit_board(e, out, n, x0 + pad, y, room, y1 - pad); }
  else if e[0].pane == REDIT_LORE_PANE { n = redit_lore_pane(e, out, n, x0 + pad, y, room, y1 - pad); }
  else if e[0].pane == REDIT_QUEST_PANE { n = redit_quest_pane(e, out, n, x0 + pad, y, room, y1 - pad); }
  if e[0].note_n > 0 {
    n = redit_text(e, out, n, cast(string) e[0].note[0..<e[0].note_n], x0 + pad, y1 - pad, 7 * k, redit_parch(k, 0.9), room);
  }
  return n;
}

// A board's row in plain words: in the realm, or not in it yet.
redit_tag :: (on: bool) -> string { return ifx on then "IN IT" else "NOT IN IT YET"; }

// The board's row i: a bullet, its name, and IN IT or NOT IN IT YET (the editor switches it; the agent strip
// adds, revises and deletes, #13528).
redit_item :: (e: [] RealmEdit, out: [] f32, at: int, i: int, x: f32, y: f32, room: f32) -> int {
  k := e[0].dpr; p_h := 26 * k; p_cap := 7.5 * k; p_tag_cap := 6.5 * k;
  p_words := redit_label_of(e, i);
  p_on := e[0].row_on[i];
  p_tag := redit_tag(p_on);
  p_tw := redit_width(p_tag, p_tag_cap);
  p_tx := x + room - p_tw;
  n := redit_text(e, out, at, p_tag, p_tx, y + (p_h + p_tag_cap) / 2, p_tag_cap, ifx p_on then redit_gold(k, 0.95) else redit_parch(k, 0.5), 0);
  // the bullet
  p_cy := y + p_h / 2;
  if lit(out, n, x + 2 * k, p_cy, x + 3.5 * k, p_cy, 1.6 * k, 0.95, 1.2 * k, 0.80, 0.64, 0.36, 0) { n += 6; }
  p_text_room := p_tx - 10 * k - (x + 12 * k);
  p_end := redit_fit(p_words, 0, p_cap, p_text_room);
  p_shown: [REDIT_LABEL + 4] u8;
  p_m := redit_copy(p_shown[..], p_words);
  if p_end < p_words.count { p_m = redit_put(p_shown[..], redit_fit(p_words, 0, p_cap, p_text_room - redit_width("...", p_cap)), "..."); }
  e[0].rows[i] = RBox.{x0 = x - 4 * k, y0 = y, x1 = p_tx - 4 * k, y1 = y + p_h}; e[0].row_shown[i] = true;
  return redit_text(e, out, n, cast(string) p_shown[0..<p_m], x + 12 * k, y + (p_h + p_cap) / 2, p_cap, redit_parch(k, ifx p_on then 0.95f32 else 0.6f32), p_text_room);
}

// FEATURES: what the realm has, each IN IT or NOT IN IT YET, as many as fit (the editor has them all), and
// OPEN THE EDITOR, where they are switched and its agent takes asks.
redit_board :: (e: [] RealmEdit, out: [] f32, at: int, x: f32, y: f32, room: f32, bottom: f32) -> int {
  k := e[0].dpr;
  n := at; p_yy := y;
  if e[0].row_n == 0 { n = redit_text(e, out, n, "NOTHING IN IT YET", x, p_yy + 10 * k, 8 * k, redit_parch(k, 0.8), room); p_yy += 26 * k; }
  p_open := e[0].page_n > 0;   // OPEN THE EDITOR, on a page that knows its path
  p_fit := redit_hi_int(1, cast(int) ((bottom - (ifx p_open then 92.0f32 else 56.0f32) * k - y) / (30 * k)));
  p_shown := redit_least(e[0].row_n, p_fit);
  if p_shown < e[0].row_n { p_fit = redit_hi_int(1, p_fit - 1); p_shown = redit_least(e[0].row_n, p_fit); }
  for p_i: 0..<p_shown { n = redit_item(e, out, n, p_i, x, p_yy, room); p_yy += 30 * k; }
  if p_shown < e[0].row_n {
    p_lab: [40] u8;
    p_m := redit_put(p_lab[..], 0, "AND "); p_m = redit_put_int(p_lab[..], p_m, e[0].row_n - p_shown); p_m = redit_put(p_lab[..], p_m, " MORE IN THE EDITOR");
    n = redit_text(e, out, n, cast(string) p_lab[0..<p_m], x, p_yy + 10 * k, 6.5 * k, redit_parch(k, 0.7), room);
    p_yy += 22 * k;
  }
  p_yy += 6 * k;
  // switching the rows, the tools visitors get, placing, and the agent that takes asks: the editor's (#13506, #13528)
  if p_open { n = redit_button(e, out, n, RB_OPEN, RBox.{x0 = x, y0 = p_yy, x1 = x + room, y1 = p_yy + 32 * k}, "OPEN THE EDITOR", false); }
  return n;
}

// ---- the panes for what you work on

// A field's outline (brighter while you type in it).
redit_frame :: (out: [] f32, at: int, b: RBox, bright: bool, k: f32) -> int {
  n := at; a := ifx bright then 0.95f32 else 0.45f32;
  if lit(out, n, b.x0, b.y0, b.x1, b.y0, 0.7 * k, a, 0.8 * k, 0.80, 0.64, 0.36, 0) { n += 6; }
  if lit(out, n, b.x1, b.y0, b.x1, b.y1, 0.7 * k, a, 0.8 * k, 0.80, 0.64, 0.36, 0) { n += 6; }
  if lit(out, n, b.x1, b.y1, b.x0, b.y1, 0.7 * k, a, 0.8 * k, 0.80, 0.64, 0.36, 0) { n += 6; }
  if lit(out, n, b.x0, b.y1, b.x0, b.y0, 0.7 * k, a, 0.8 * k, 0.80, 0.64, 0.36, 0) { n += 6; }
  return n;
}
// Where a line of text this wide breaks: the last space that fits (or as much as fits).
redit_fit :: (text: string, from: int, cap: f32, room: f32) -> int {
  e := from; p_best := -1;
  while e < text.count {
    e += 1;
    while e < text.count && (text[e] & 0xC0) == 0x80 { e += 1; }
    if redit_width(text[from..<e], cap) > room { break; }
    if e == text.count { return e; }
    if text[e] == ' ' { p_best = e; }
  }
  if p_best > from { return p_best; }
  return redit_hi_int(from + 1, e - 1);
}
redit_hi_int :: (a: int, b: int) -> int { if a > b { return a; } return b; }
// Text wrapped in a box, at most `p_lines` p_lines: the last ones when it runs over (so what you type shows).
redit_wrap :: (e: [] RealmEdit, out: [] f32, at: int, text: string, x: f32, y: f32, cap: f32, room: f32, p_lines: int, k: Ink) -> int {
  p_starts: [64] int; m := 0; i := 0;
  while i < text.count && m < 64 {
    while i < text.count && text[i] == ' ' { i += 1; }
    if i >= text.count { break; }
    p_starts[m] = i; m += 1;
    i = redit_fit(text, i, cap, room);
  }
  p_first := redit_hi_int(0, m - p_lines);
  n := at;
  for l: p_first..<m {
    end := ifx l + 1 < m then p_starts[l + 1] else text.count;
    n = redit_text(e, out, n, text[p_starts[l]..<end], x, y + f32(l - p_first) * cap * 1.7 + cap, cap, redit_parch(e[0].dpr, 0.95), room);
  }
  return n;
}
// A field: its p_words (or what to write, dim), the cursor while you type, its outline to tap.
redit_field :: (e: [] RealmEdit, out: [] f32, at: int, f: int, b: RBox, empty: string, p_lines: int) -> int {
  k := e[0].dpr; cap := 7.5 * k;
  e[0].fbox[f] = b; e[0].fshown[f] = true;
  on := e[0].typing && e[0].field == f + 1;
  if on { e[0].type_box = b; }
  n := redit_frame(out, at, b, on, k);
  p_words := redit_draft(e, f);
  if p_words.count == 0 && !on { return redit_text(e, out, n, empty, b.x0 + 8 * k, b.y0 + 8 * k + cap, cap, redit_parch(k, 0.45), b.x1 - b.x0 - 16 * k); }
  shown: [REDIT_DRAFT + 1] u8; m := redit_copy(shown[..], p_words);
  if on { shown[m] = '_'; m += 1; }
  return redit_wrap(e, out, n, cast(string) shown[0..<m], b.x0 + 8 * k, b.y0 + 7 * k, cap, b.x1 - b.x0 - 16 * k, p_lines, redit_parch(k, 0.95));
}
redit_title :: (e: [] RealmEdit, out: [] f32, at: int, a: string, b: string, x: f32, y: f32, room: f32) -> int {
  line: [96] u8;
  m := redit_put(line[..], 0, a); m = redit_put(line[..], m, b);
  redit_upper(line[..], m);
  return redit_text(e, out, at, cast(string) line[0..<m], x, y + 10 * e[0].dpr, 8.5 * e[0].dpr, redit_gold(e[0].dpr, 0.95), room);
}
// LORE: the character's story, saved with it. SAVE, and QUEST for the form.
redit_lore_pane :: (e: [] RealmEdit, out: [] f32, at: int, x: f32, y: f32, room: f32, bottom: f32) -> int {
  k := e[0].dpr;
  n := redit_title(e, out, at, cast(string) e[0].focus_name[0..<e[0].focus_name_n], "'S LORE", x, y, room);
  p_tall := redit_lo(150 * k, bottom - y - 90 * k);
  p_lines := redit_hi_int(1, cast(int) ((p_tall - 14 * k) / (7.5 * k * 1.7)));
  n = redit_field(e, out, n, RF_LORE, RBox.{x0 = x, y0 = y + 22 * k, x1 = x + room, y1 = y + 22 * k + p_tall}, "WRITE WHO THEY ARE", p_lines);
  yy := y + 22 * k + p_tall + 12 * k;
  half := (room - 8 * k) / 2;
  n = redit_button(e, out, n, RB_SAVE, RBox.{x0 = x, y0 = yy, x1 = x + half, y1 = yy + 32 * k}, ifx e[0].dirty then "SAVE" else "SAVED", e[0].dirty);
  return redit_button(e, out, n, RB_SWAP, RBox.{x0 = x + half + 8 * k, y0 = yy, x1 = x + room, y1 = yy + 32 * k}, "QUEST", false);
}
// QUEST: p_who gives it, what is asked, three steps, what you get. SAVE makes it; an empty ask takes it away.
redit_quest_pane :: (e: [] RealmEdit, out: [] f32, at: int, x: f32, y: f32, room: f32, bottom: f32) -> int {
  k := e[0].dpr;
  p_had := redit_quest(e, cast(string) e[0].focus[0..<e[0].focus_n]) >= 0;
  n := redit_title(e, out, at, cast(string) e[0].focus_name[0..<e[0].focus_name_n], ifx p_had then "'S QUEST" else " GIVES A QUEST", x, y, room);
  p_labels := [5] string.["ASK", "STEP 1", "STEP 2", "STEP 3", "REWARD"];
  p_empties := [5] string.["WHAT THEY ASK", "A STEP", "A STEP", "A STEP", "WHAT YOU GET"];
  lw := 56 * k; yy := y + 22 * k;
  for p: 0..<5 {
    p_tall := ifx p == 0 then 40 * k else 26 * k;
    if yy + p_tall > bottom - 50 * k { break; }
    n = redit_text(e, out, n, p_labels[p], x, yy + 10 * k + 6.5 * k, 6.5 * k, redit_parch(k, 0.7), lw - 6 * k);
    n = redit_field(e, out, n, RF_ASK + p, RBox.{x0 = x + lw, y0 = yy, x1 = x + room, y1 = yy + p_tall}, p_empties[p], ifx p == 0 then 2 else 1);
    yy += p_tall + 6 * k;
  }
  yy += 6 * k;
  half := (room - 8 * k) / 2;
  n = redit_button(e, out, n, RB_SAVE, RBox.{x0 = x, y0 = yy, x1 = x + half, y1 = yy + 32 * k}, ifx e[0].dirty then "SAVE QUEST" else "SAVED", e[0].dirty);
  return redit_button(e, out, n, RB_SWAP, RBox.{x0 = x + half + 8 * k, y0 = yy, x1 = x + room, y1 = yy + 32 * k}, "LORE", false);
}

// What a headless check reads (a realm's probe passes f - its base): 4 * b + 0..3 the button b's box
// in device pixels (-1 while it isn't shown), 96 the pane open, 98 typing (88, 89 and 97 were YOUR AGENT's and
// YOUR COMPUTER's, #13529).
redit_probe :: (e: [] RealmEdit, f: int) -> int {
  if f == 96 { return e[0].pane; }
  if f == 98 { return ifx e[0].typing then 1 else 0; }
  b := f / 4; side := f % 4;
  if f < 0 || b >= RB_N || !e[0].shown[b] { return -1; }
  bx := e[0].boxes[b];
  v := ifx side == 0 then bx.x0 else ifx side == 1 then bx.y0 else ifx side == 2 then bx.x1 else bx.y1;
  return cast(int) v;
}
