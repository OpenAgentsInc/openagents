// Checks for the shared edit layer (edit.coax), loaded the way a realm loads it: Filament and the
// page's analytics first, a realm's `lit`, then the layer.
//   coax/bin/coax test metaverse/edit/edit_test.coax

#load "../../metaverse-engine/ui/font.coax";
#load "../../coax/web/analytics.coax";
#load "edit.coax";

VERTEX_FLOATS :: 16;
lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

HAND :: "200\nrealm the-grid\nrole admin\nowner 1\ntool map 1\ntool jump 0\nthing crate\nrow robots 1 Robots walking their rounds\nrow names 0 Place names in the air\nplaced crate 2.5 -3 0.5\nwaiting 2\n";
VISITOR :: "200\nrealm the-grid\nrole visitor\nowner 0\ntool map 1\ntool jump 0\nrow robots 0 Robots walking their rounds\n";
MADE :: "200\nrealm moonlit-marsh\nname Moonlit Marsh\nstyle painterly\nowner 1\ntool build 0\ntool fly 1\nfeature water large\nwaiting 0\nrole owner\nrow water 1 Large pond\nrow props:wagon 0 A wagon\n";

url_is :: (e: [] RealmEdit, text: string) -> bool { return cast(string) e[0].req_url[0..<e[0].req_url_n] == text; }
body_is :: (e: [] RealmEdit, text: string) -> bool { return cast(string) e[0].req_body[0..<e[0].req_body_n] == text; }
answer :: (e: [] RealmEdit, id: int, text: string) -> bool { redit_requested(e, id); return redit_message(e, HTTP_KIND + id, text); }
opened :: (e: [] RealmEdit, slug: string, spec: string) {
  redit_start(e, slug);
  redit_step(e, 1, 1440, 900, 1);
  _ := answer(e, 0, spec);
}
tap :: (e: [] RealmEdit, b: RBox) -> bool {
  x := (b.x0 + b.x1) / 2; y := (b.y0 + b.y1) / 2;
  _ := redit_pointer(e, x, y, 0, 1);
  return redit_pointer(e, x, y, 2, 1);
}
ANCHOR :: RBox.{x0 = 1300, y0 = 16, x1 = 1380, y1 = 54};

#test "the spec: the role, the rows, the tools its code honours, what was placed" {
  e: [1] RealmEdit;
  redit_start(e[..], "the-grid");
  redit_step(e[..], 0, 1440, 900, 1);
  #assert e[0].req_ready && url_is(e[..], "/api/playtest/realms/the-grid") && (e[0].req_flags & HTTP_POST) == 0;
  #assert answer(e[..], 3, HAND) && e[0].ready && e[0].role == REDIT_ADMIN && redit_may(e[..]);
  #assert e[0].row_n == 2 && redit_row_on(e[..], "robots") && !redit_row_on(e[..], "names") && redit_row_on(e[..], "anything-else");
  #assert redit_label_of(e[..], 0) == "ROBOTS WALKING THEIR ROUNDS";
  #assert e[0].tool_has[3] && e[0].tool_on[3] && e[0].tool_has[2] && !e[0].tool_on[2] && !e[0].tool_has[0];
  #assert e[0].placed_n == 1 && redit_placed_thing(e[..], 0) == "crate" && e[0].placed_x[0] == 2.5 && e[0].placed_z[0] == -3;
  #assert redit_changed(e[..]) && !redit_changed(e[..]);
  // visitors' waiting ideas are no business of the layer's: they are turns of the editor's agent strip (#13527)
  #assert !e[0].req_ready || !url_is(e[..], "/api/playtest/realms/the-grid/proposals");
  // a visitor's tools are what the owner gave; an owner or admin may use every one
  v: [1] RealmEdit;
  opened(v[..], "the-grid", VISITOR);
  #assert v[0].role == REDIT_VISITOR && !redit_may(v[..]) && redit_tool(v[..], "map") && !redit_tool(v[..], "jump") && redit_tool(v[..], "fly");
  #assert redit_tool(e[..], "jump") && !redit_row_on(v[..], "robots");
}

#test "a made realm's spec: owner 1 before the role, and keys with a colon" {
  e: [1] RealmEdit;
  opened(e[..], "moonlit-marsh", MADE);
  #assert e[0].role == REDIT_OWNER && e[0].row_n == 2 && redit_key_of(e[..], 1) == "props:wagon" && !redit_row_on(e[..], "props:wagon");
}

#test "only an owner or admin gets EDIT; it opens one pane at a time" {
  v: [1] RealmEdit;
  out: [20000 * VERTEX_FLOATS] f32;
  opened(v[..], "the-grid", VISITOR);
  #assert redit_hud(v[..], out[..], 0, ANCHOR) == 0 && !v[0].shown[RB_EDIT];
  #assert !redit_pointer(v[..], 1340, 30, 0, 1);
  e: [1] RealmEdit;
  opened(e[..], "the-grid", HAND);
  n := redit_hud(e[..], out[..], 0, ANCHOR);
  #assert n > 0 && e[0].shown[RB_EDIT] && !e[0].shown[RB_TAB] && e[0].plate_n == 1;
  #assert tap(e[..], e[0].boxes[RB_EDIT]) && e[0].pane == REDIT_BOARD;
  n = redit_hud(e[..], out[..], 0, ANCHOR);
  #assert e[0].row_shown[0] && e[0].row_shown[1];
  #assert e[0].plate_n <= REDIT_PLATES;
  for b: 0..<RB_N { if e[0].shown[b] { #assert e[0].boxes[b].x1 <= 1440 && e[0].boxes[b].y1 <= 900 && e[0].boxes[b].x0 >= 0; } }
  // no SETTINGS tab: the visitors' tools are the editor's (#13506); and a page that does not know its path offers no OPEN THE EDITOR
  #assert !e[0].shown[RB_TAB + 1] && !e[0].shown[RB_TAB + 2] && !e[0].shown[RB_OPEN];
  // Esc closes it
  #assert redit_key(e[..], REDIT_KEY_ESCAPE, true) == 1 && e[0].pane == REDIT_SHUT;
  #assert redit_key(e[..], 'w', true) == 0;
}

#test "a tap on a row switches nothing: switching is the editor's, and OPEN THE EDITOR goes to this page with ?edit" {
  e: [1] RealmEdit;
  out: [20000 * VERTEX_FLOATS] f32; o: [REDIT_OUT] u8;
  opened(e[..], "the-grid", HAND);
  _ := answer(e[..], -1, "");   // the first read after the spec refused: nothing in flight
  e[0].req_ready = false; e[0].req_id = -1;
  #assert !redit_message(e[..], REDIT_FACTS, "url=https://openagents.com/realms/the-grid?x=1#top\n");
  #assert cast(string) e[0].page[0..<e[0].page_n] == "/realms/the-grid";
  redit_toggle(e[..]);
  _n := redit_hud(e[..], out[..], 0, ANCHOR);
  _ = redit_changed(e[..]);
  #assert tap(e[..], e[0].rows[0]) && redit_row_on(e[..], "robots") && !redit_changed(e[..]);
  redit_step(e[..], 2, 1440, 900, 1);
  #assert !e[0].req_ready || !url_is(e[..], "/api/playtest/realms/the-grid/switch");
  #assert e[0].shown[RB_OPEN] && tap(e[..], e[0].boxes[RB_OPEN]);
  a := redit_take_action(e[..], o[..]);
  #assert a.kind == REDIT_ACT_GO && cast(string) o[0..<a.n] == "/realms/the-grid?edit" && redit_take_action(e[..], o[..]).kind == 0;
  // the page's path from its url fact
  #assert redit_page_of("http://127.0.0.1:9000/fairy") == "/fairy" && redit_page_of("https://openagents.com") == "" && redit_page_of("") == "";
  // a visitor gets no OPEN THE EDITOR
  v: [1] RealmEdit; opened(v[..], "the-grid", VISITOR);
  _ = redit_message(v[..], REDIT_FACTS, "url=https://openagents.com/realms/the-grid\n");
  redit_open_editor(v[..]); #assert redit_take_action(v[..], o[..]).kind == 0;
}

// The strip's words for what came of its realm steps, as the realm takes them from the layer's actions.
said_is :: (e: [] RealmEdit, text: string) -> bool {
  ob: [REDIT_SAID] u8;
  a := redit_take_action(e, ob[..]);
  return a.kind == REDIT_ACT_AGENT && cast(string) ob[0..<a.n] == text;
}
#test "the agent strip's realm steps: an ask, a revision, an ask and a row deleted and a look each go as the server's request, and what came of them is the strip's words" {
  e: [1] RealmEdit;
  opened(e[..], "the-grid", HAND);
  // the shell's action of the plan's realm steps (shell.coax ES_REALM): a step a line; lines that are not one are dropped
  #assert redit_world_message(e[..], REDIT_MSG_REALM, "ask a ghost cat by the gate\nrevise no \"robots\" at night\nunask 9\nunrow rows 1\nlook what's that dark strip\nfly 3\nunrow tools 1\n");
  #assert e[0].job_n == 6;
  redit_step(e[..], 2, 1440, 900, 1);
  #assert url_is(e[..], "/api/playtest/realms/the-grid/asks") && body_is(e[..], "{\"words\":\"a ghost cat by the gate\"}") && (e[0].req_flags & HTTP_POST) != 0;
  #assert answer(e[..], 4, "200\nask 7 waiting\nplan 7\nrow robots 1 Robots walking their rounds\n") && e[0].asks_due && e[0].spec_due;
  #assert said_is(e[..], "Added to the list. It isn't applied yet: it waits on the list for code.") && redit_take_action(e[..], e[0].out[..]).kind == 0;
  e[0].spec_due = false; e[0].asks_due = false;
  redit_step(e[..], 3, 1440, 900, 1);
  #assert url_is(e[..], "/api/playtest/realms/the-grid/revise") && body_is(e[..], "{\"prompt\":\"no \\\"robots\\\" at night\"}");
  #assert answer(e[..], 4, "200\nplan 8\nrow robots 0 Robots walking their rounds\nrow names 1 Place names in the air\n") && !redit_row_on(e[..], "robots");
  e[0].spec_due = false;
  redit_step(e[..], 4, 1440, 900, 1);
  #assert url_is(e[..], "/api/playtest/realms/the-grid/asks/9/delete") && answer(e[..], 4, "200\n{\"deleted\": 9, \"reverted\": 0}") && e[0].asks_due;
  // the words join while the strip has not taken them
  #assert said_is(e[..], "The board is revised: the world has it now. Deleted.");
  e[0].spec_due = false; e[0].asks_due = false;
  // a row of the board: the rows table's row 1 is the spec's first row
  redit_step(e[..], 5, 1440, 900, 1);
  #assert url_is(e[..], "/api/playtest/realms/the-grid/rows/robots/delete") && answer(e[..], 4, "403\n{}") && said_is(e[..], "Only its owner and admins change it.");
  e[0].spec_due = false; e[0].asks_due = false;
  // a look: the question again at /look with the frame on screen (the host's flag 32); its answer is the strip's
  redit_step(e[..], 6, 1440, 900, 1);
  #assert url_is(e[..], "/api/playtest/realm/the-grid/look") && body_is(e[..], "{\"question\":\"what's that dark strip\"}") && (e[0].req_flags & REDIT_HTTP_FRAME) != 0;
  #assert answer(e[..], 4, "200\n{\"edit\": \"chat\", \"reply\": \"That is the edge of the sky dome.\"}") && said_is(e[..], "That is the edge of the sky dome.");
  // a row of another list has no delete here: said, and nothing sent
  redit_step(e[..], 7, 1440, 900, 1);
  #assert e[0].job_n == 0 && said_is(e[..], "That row can't be deleted here.");
  // a visitor's realm steps are refused in words, and none goes
  v: [1] RealmEdit;
  opened(v[..], "the-grid", VISITOR);
  #assert redit_world_message(v[..], REDIT_MSG_REALM, "ask a dragon\n") && v[0].job_n == 0 && said_is(v[..], "Only the world's owner and admins change its list of asks.");
}

#test "FEATURES: the board's rows, IN IT or NOT IN IT YET, and OPEN THE EDITOR; the asks, DELETE, ADD and the voice are the editor's agent's" {
  e: [1] RealmEdit;
  out: [40000 * VERTEX_FLOATS] f32;
  opened(e[..], "the-grid", HAND);
  _f := redit_message(e[..], REDIT_FACTS, "url=https://openagents.com/realms/the-grid\nvoice=made-realm\n");
  redit_toggle(e[..]);
  #assert e[0].pane == REDIT_BOARD && !e[0].asks_due;   // nobody asked for the asks: the layer reads none
  _ := redit_hud(e[..], out[..], 0, ANCHOR);
  #assert e[0].row_shown[0] && e[0].row_shown[1] && e[0].shown[RB_OPEN] && e[0].plate_n <= REDIT_PLATES;
  for b: 0..<RB_N { if e[0].shown[b] { #assert b == RB_EDIT || b == RB_TAB || b == RB_OPEN; } }
  // shut, nothing under EDIT; V and Enter are the realm's own keys
  redit_toggle(e[..]);
  _ = redit_hud(e[..], out[..], 0, ANCHOR);
  for b: 0..<RB_N { #assert !e[0].shown[b] || b == RB_EDIT; }
  #assert redit_key(e[..], 'v', true) == 0 && redit_key(e[..], REDIT_KEY_ENTER, true) == 0 && !redit_typing(e[..]);
}

#test "FEATURES on a phone: everything fits the width, and a long board says how many more the editor has" {
  e: [1] RealmEdit;
  out: [40000 * VERTEX_FLOATS] f32;
  redit_start(e[..], "the-grid");
  redit_step(e[..], 1, 390 * 3, 700 * 3, 3);
  spec: [2048] u8; n := ct_put(spec[..], 0, "200\nrealm the-grid\nrole admin\nowner 1\n");
  for r: 0..<REDIT_ROWS { n = ct_put(spec[..], n, "row r"); n = ct_put_int(spec[..], n, r); n = ct_put(spec[..], n, " 1 A feature of the realm\n"); }
  _s := answer(e[..], 0, cast(string) spec[0..<n]);
  #assert e[0].row_n == REDIT_ROWS;
  redit_toggle(e[..]);
  anchor := RBox.{x0 = 390 * 3 - 100 * 3, y0 = 16 * 3, x1 = 390 * 3 - 16 * 3, y1 = 54 * 3};
  _ := redit_hud(e[..], out[..], 0, anchor);
  for b: 0..<RB_N { if e[0].shown[b] { #assert e[0].boxes[b].x0 >= 0 && e[0].boxes[b].x1 <= 390 * 3 && e[0].boxes[b].y1 <= 700 * 3; } }
  for r: 0..<REDIT_ROWS { if e[0].row_shown[r] { #assert e[0].rows[r].x0 >= 0 && e[0].rows[r].x1 <= 390 * 3 && e[0].rows[r].y1 <= 700 * 3; } }
  #assert e[0].row_shown[0];
}

#test "everyone reads the lore and quests; EDIT by a character opens the board, and the shell shows its lore" {
  e: [1] RealmEdit;
  out: [60000] f32;
  opened(e[..], "fairy-forest", "200\nrealm fairy-forest\nrole admin\nowner 1\nwaiting 0\n");
  redit_read_panes_too(e[..]);
  redit_near(e[..], "bramble", "Bramble");
  #assert e[0].pane == REDIT_SHUT && cast(string) e[0].near[0..<e[0].near_n] == "bramble";
  // the panes are read for the realm's characters, by a GET
  redit_step(e[..], 2, 1440, 900, 1);
  #assert url_is(e[..], "/api/playtest/realms/fairy-forest/panes") && (e[0].req_flags & HTTP_POST) == 0;
  #assert answer(e[..], 1, "200\nlore bramble|Hoards acorns.\nquest pip|Find my lily pad|Look by the reeds|||A song\n");
  #assert redit_lore(e[..], "bramble") == "Hoards acorns." && redit_lore(e[..], "pip") == "";
  #assert redit_quest(e[..], "pip") == 0 && redit_quest_part(e[..], 0, 1) == "Look by the reeds" && redit_quest_part(e[..], 0, 4) == "A song" && redit_quest(e[..], "bramble") < 0;
  // the world's lore and quests changed (an edit in the shell): the panes are read again
  redit_world_chars(e[..], 1);
  #assert e[0].panes_due;
  redit_world_chars(e[..], 1);
  redit_step(e[..], 3, 1440, 900, 1);
  #assert url_is(e[..], "/api/playtest/realms/fairy-forest/panes") && answer(e[..], 2, "200\nlore bramble|Hoards acorns. Fears owls.\n");
  #assert redit_lore(e[..], "bramble") == "Hoards acorns. Fears owls." && redit_quest(e[..], "pip") < 0 && !e[0].panes_due;
  redit_world_chars(e[..], 1);
  #assert !e[0].panes_due;
  // EDIT by a character opens the board: its lore and quest are the editor shell's to write
  redit_toggle(e[..]);
  #assert e[0].pane == REDIT_BOARD;
  _ := redit_hud(e[..], out[..], 0, ANCHOR);
  // a realm that reads no panes is not made to by a change
  n: [1] RealmEdit;
  opened(n[..], "fairy-forest", "200\nrealm fairy-forest\nrole admin\nowner 1\nwaiting 0\n");
  redit_world_chars(n[..], 4);
  #assert !n[0].panes_due;
  // a visitor gets no EDIT, but reads the quests
  v: [1] RealmEdit;
  opened(v[..], "fairy-forest", "200\nrealm fairy-forest\nrole visitor\nowner 0\n");
  redit_read_panes_too(v[..]);
  redit_near(v[..], "bramble", "Bramble");
  redit_toggle(v[..]);
  #assert v[0].pane == REDIT_SHUT;
  redit_step(v[..], 2, 1440, 900, 1);
  #assert url_is(v[..], "/api/playtest/realms/fairy-forest/panes") && answer(v[..], 1, "200\nquest bramble|Find acorns||Fill the basket||A lucky acorn\n");
  #assert redit_quest(v[..], "bramble") == 0 && redit_quest_part(v[..], 0, 0) == "Find acorns" && redit_quest_part(v[..], 0, 1) == "";
}
#test "the character the player is by goes to the realm's world page, and the shell's model says its lore and quest" {
  e: [1] RealmEdit;
  redit_start(e[..], "moonlit-marsh");
  wstep(e[..], 0);
  #assert answer(e[..], 3, MADE) && redit_edit_own(e[..]);
  wstep(e[..], 0.016); redit_world_sent(e[..], 6);
  st: [512] u8; n := ct_put(st[..], 0, "200\n");
  made := we_state_write(WorldState.{lane = WL_DEV, rev = 2, dev = 2, undo = 1}, "moonlit-marsh", "", "", st[n..<st.count]);
  #assert wmsg(e[..], HTTP_KIND + 6, cast(string) st[0..<n + made.count]);
  wstep(e[..], 0.032); redit_world_sent(e[..], 7);
  redit_near(e[..], "bramble", "Bramble");
  #assert wmsg(e[..], HTTP_KIND + 7, "200\naethyr.content.v1 realm 1\nreach 40000\ntable kinds id name:text\ntable lore id who:text text:text\n1|bramble|Hoards acorns.\ntable quests id giver:text ask:text s1:text s2:text s3:text reward:text\ntable rows id key:text on:int label:text\n1|water|1|Large pond\ntable tools id name:text on:int\n");
  #assert redit_has(redit_edit_model(e[..]), "\nchars lore quests\nchar bramble Bramble\ncl 1 Hoards acorns.\ncq 1\n");
  // walking away: the tables alone
  redit_near(e[..], "", "");
  #assert redit_has(redit_edit_model(e[..]), "\nchars lore quests\n") && !redit_has(redit_edit_model(e[..]), "\nchar ");
}
#test "the panel speaks plainly: IN IT, NOT IN IT YET, IDEAS for visitors' cards" {
  #assert redit_tag(true) == "IN IT" && redit_tag(false) == "NOT IN IT YET";
}

#test "edits from elsewhere show up: an owner's page reads its spec again every second; the same spec changes nothing" {
  e: [1] RealmEdit;
  opened(e[..], "the-grid", HAND);
  e[0].asks_due = false; e[0].panes_due = false; e[0].req_ready = false; e[0].req_id = -1;
  _ := redit_changed(e[..]);
  v := e[0].version;
  redit_step(e[..], 3, 1440, 900, 1);
  #assert e[0].req_ready && url_is(e[..], "/api/playtest/realms/the-grid");
  #assert answer(e[..], 1, HAND) && e[0].version == v && redit_row_on(e[..], "robots");
  redit_step(e[..], 3.5, 1440, 900, 1);
  #assert !e[0].req_ready;   // not yet a second
  redit_step(e[..], 4.2, 1440, 900, 1);
  #assert e[0].req_ready && answer(e[..], 2, "200\nrealm the-grid\nrole admin\nowner 1\ntool map 1\ntool jump 0\nthing crate\nrow robots 0 Robots walking their rounds\nrow names 0 Place names in the air\n");
  #assert e[0].version == v + 1 && !redit_row_on(e[..], "robots") && redit_changed(e[..]);
  // a visitor's page doesn't
  w: [1] RealmEdit;
  opened(w[..], "the-grid", VISITOR);
  w[0].req_ready = false; w[0].req_id = -1;
  redit_step(w[..], 9, 1440, 900, 1);
  #assert !w[0].req_ready || !url_is(w[..], "/api/playtest/realms/the-grid");
}

reads :: (out: [] u8, n: int, text: string) -> bool {
  if n != text.count || n > out.count { return false; }
  for i: 0..<n { if out[i] != text[i] { return false; } }
  return true;
}
#test "what the voice heard: switch a row by its id, show a pane, a visitor told no" {
  e: [1] RealmEdit;
  out: [160] u8;
  opened(e[..], "the-grid", HAND);
  e[0].req_ready = false; e[0].req_id = -1;
  #assert redit_heard(e[..], "place", "", false, "", out[..]) == -1;
  n := redit_heard(e[..], "switch", "robots", false, "", out[..]);
  #assert reads(out[..], n, "Robots walking their rounds: off.");
  #assert !redit_row_on(e[..], "robots");
  #assert e[0].switch_row == 0;
  e[0].switch_row = -1;
  n = redit_heard(e[..], "switch", "robots", false, "", out[..]);
  #assert e[0].switch_row == -1 && reads(out[..], n, "Robots walking their rounds: off.");   // already off: nothing sent
  n = redit_heard(e[..], "switch", "dragons", true, "", out[..]);
  #assert reads(out[..], n, "This world has no such switch.");
  _ := redit_heard(e[..], "show", "", false, "edit", out[..]);
  #assert e[0].pane == REDIT_BOARD;
  n = redit_heard(e[..], "show", "", false, "settings", out[..]);
  #assert e[0].pane == REDIT_BOARD && reads(out[..], n, "The settings are in the editor: opening it.");
  n = redit_heard(e[..], "show", "", false, "ideas", out[..]);
  #assert e[0].pane == REDIT_BOARD && reads(out[..], n, "Visitors' ideas wait in the editor: opening it.");
  _ = redit_heard(e[..], "show", "", false, "close", out[..]);
  #assert e[0].pane == REDIT_SHUT;
  v: [1] RealmEdit;
  opened(v[..], "the-grid", VISITOR);
  n = redit_heard(v[..], "switch", "robots", true, "", out[..]);
  #assert reads(out[..], n, "Only the world's owner can change that.") && !redit_row_on(v[..], "robots");
}
#test "a pane asked for by voice while open stays open" {
  e: [1] RealmEdit;
  out: [160] u8;
  opened(e[..], "the-grid", HAND);
  _ := redit_heard(e[..], "show", "", false, "edit", out[..]);
  _ = redit_heard(e[..], "show", "", false, "edit", out[..]);
  #assert e[0].pane == REDIT_BOARD;
}

#test "a spoken switch is a cell edit of the realm's world: its revision read, then the batch from it, once more on a 409" {
  e: [1] RealmEdit;
  out: [160] u8;
  opened(e[..], "moonlit-marsh", MADE);
  e[0].asks_due = false;
  n := redit_heard(e[..], "switch", "water", false, "", out[..]);
  #assert reads(out[..], n, "Large pond: off.") && !redit_row_on(e[..], "water") && e[0].switch_row == 0;
  // the switch is a cell edit of the realm's world (#13514): its revision read, then the batch from it; a batch
  // another change passed (409) is made once more from the revision there now
  redit_step(e[..], 3, 1440, 900, 1);
  #assert url_is(e[..], "/api/worlds/moonlit-marsh?lane=dev") && (e[0].req_flags & HTTP_POST) == 0 && (e[0].req_flags & TRACK_KEY) != 0;
  sb: [2048] u8; st: [1024] u8; bb: [1024] u8;
  #assert answer(e[..], 2, cast(string) sb[0..<ct_put(sb[..], ct_put(sb[..], 0, "200\n"), rp_test_state(7, st[..]))]);
  cell := WorldEdit.{ok = true, op = WE_CELL, id = 1};
  cell.table_n = ct_copy(cell.table[..], "rows"); cell.name_n = ct_copy(cell.name[..], "on"); cell.text_n = ct_copy(cell.text[..], "0");
  cells := [1] WorldEdit.[cell];
  redit_step(e[..], 3.1, 1440, 900, 1);
  #assert url_is(e[..], "/api/worlds/moonlit-marsh") && (e[0].req_flags & HTTP_POST) != 0 && body_is(e[..], we_batch_write(7, WB_APPLY, cells[..], 1, bb[..]));
  #assert answer(e[..], 2, "409\n{\"error\":\"changed since\"}") && e[0].switch_row == 0;
  redit_step(e[..], 3.2, 1440, 900, 1);
  #assert url_is(e[..], "/api/worlds/moonlit-marsh?lane=dev") && answer(e[..], 2, cast(string) sb[0..<ct_put(sb[..], ct_put(sb[..], 0, "200\n"), rp_test_state(8, st[..]))]);
  redit_step(e[..], 3.3, 1440, 900, 1);
  #assert body_is(e[..], we_batch_write(8, WB_APPLY, cells[..], 1, bb[..])) && answer(e[..], 2, "200\n{}") && e[0].spec_due && e[0].switch_row == -1;
}

// The realm's world for the editor shell (realm-page.coax, #13478), stepped as a face that opts in steps it
// (edit-face.h, EDIT_FACE_WORLD): the layer's step, then the world's; a message is offered to the world first.
wstep :: (e: [] RealmEdit, time: f32) { redit_step(e, time, 1440, 900, 1); redit_world_step(e); }
wmsg :: (e: [] RealmEdit, kind: int, text: string) -> bool { return redit_world_message(e, kind, text) || redit_message(e, kind, text); }
#test "an owner's page the host asks for the editor follows the realm's world and tells the shell its board; a visitor's asks nothing" {
  e: [1] RealmEdit;
  redit_start(e[..], "moonlit-marsh");
  wstep(e[..], 0);
  // the host asks whether this visitor may edit (the page was opened with ?edit). Before the server says who this
  // is, nothing is asked of the world, and the host is told nobody may edit
  #assert !redit_edit_own(e[..]) && !redit_world_wants(e[..]) && redit_edit_model(e[..]) == "";
  #assert answer(e[..], 3, MADE) && redit_may(e[..]) && redit_edit_own(e[..]);
  wstep(e[..], 0.016);
  #assert redit_world_wants(e[..]) && redit_world_url(e[..]) == "/api/worlds/moonlit-marsh?lane=dev" && (redit_world_flags(e[..]) & TRACK_KEY) != 0 && redit_world_body(e[..]) == "";
  redit_world_sent(e[..], 6);
  st: [512] u8; n := ct_put(st[..], 0, "200\n");
  made := we_state_write(WorldState.{lane = WL_DEV, rev = 2, dev = 2, undo = 1}, "moonlit-marsh", "", "", st[n..<st.count]);
  // an answer that is the world's is the layer's; one for another request is not
  #assert made.count > 0 && !wmsg(e[..], HTTP_KIND + 5, "200\n{}") && wmsg(e[..], HTTP_KIND + 6, cast(string) st[0..<n + made.count]);
  wstep(e[..], 0.032);
  #assert redit_world_wants(e[..]) && redit_world_url(e[..]) == "/api/worlds/moonlit-marsh/content?lane=dev";
  redit_world_sent(e[..], 7);
  #assert wmsg(e[..], HTTP_KIND + 7, "200\naethyr.content.v1 realm 1\nreach 40000\ntable kinds id name:text\n1|crate\n2|barrel\ntable rows id key:text on:int label:text\n1|water|1|Large pond\n2|props:wagon|0|A wagon\ntable things id kind:ref.kinds x:cm z:cm turn:int size:int\n1|2|250|-300|0|100\ntable tools id name:text on:int\n1|build|0\n2|fly|1\n");
  #assert redit_edit_model(e[..]) == "editor.model.v1 moonlit-marsh dev 2 1 0 0\ncols\nk 1 crate\nk 2 barrel\ne 1 2 250 0 -300 0 100\natonce\nlist rows on Features\nsw 1 1 Large pond\nsw 2 0 A wagon\nlist tools on Tools visitors get\nsw 1 0 build\nsw 2 1 fly\nasks\n";
  // the world asked for the asks (#13528): the layer reads them, and the shell's model lists them for the strip's turn
  wstep(e[..], 0.04);
  #assert e[0].asks_wanted && url_is(e[..], "/api/playtest/realms/moonlit-marsh/asks") && (e[0].req_flags & HTTP_POST) == 0;
  #assert answer(e[..], 4, "200\nask 9 waiting ask a ghost cat by the gate\nask 4 applied ask no robots at night\nask 2 removing ask a bell\n");
  #assert e[0].ask_n == 3 && e[0].ask_state[2] == ASK_REMOVING;
  wstep(e[..], 0.041);
  #assert redit_has(redit_edit_model(e[..]), "\nasks\nq 9 waiting a ghost cat by the gate\nq 4 applied no robots at night\nq 2 removing a bell\n");

  rev := redit_edit_rev(e[..]); #assert rev > 0 && redit_edit_rev(e[..]) == rev;   // it moves only when the model does
  // the shell's batch (message 520) is the page's own write
  batch := "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"cell\",\"table\":\"rows\",\"row\":2,\"col\":\"on\",\"v\":\"1\"}]}";
  #assert wmsg(e[..], REDIT_MSG_BATCH, batch);
  wstep(e[..], 0.048);
  #assert redit_world_wants(e[..]) && redit_world_url(e[..]) == "/api/worlds/moonlit-marsh" && redit_world_body(e[..]) == batch && (redit_world_flags(e[..]) & HTTP_POST) != 0;
  // the shell's selection (521) and, from where the player stands (redit_here), its Add (523): the world's too
  #assert wmsg(e[..], 521, "1") && ct_part(redit_edit_model(e[..]), '\n', 0) == "editor.model.v1 moonlit-marsh dev 2 1 0 1";
  redit_here(e[..], 4.2, 7.9);
  #assert redit_has(redit_edit_model(e[..]), "\nhere 400 800\n");
  #assert wmsg(e[..], 523, "add 2 1");   // the batch above is still on its way: the Add says so, and sends nothing
  #assert redit_has(redit_edit_model(e[..]), "\nno The last change is still on its way. Try again.\n");
  // a spec changed elsewhere (the CLI, Coder) reads the asks again
  e[0].spec_due = true; wstep(e[..], 0.05);
  #assert url_is(e[..], "/api/playtest/realms/moonlit-marsh") && answer(e[..], 5, "200\nrealm moonlit-marsh\nrole owner\nowner 1\nrow water 0 Large pond\n") && e[0].asks_due;
  // a visitor's page, and an owner's without ?edit, ask the world for nothing and take no batch
  v: [1] RealmEdit;
  redit_start(v[..], "the-grid");
  wstep(v[..], 0);
  #assert answer(v[..], 3, VISITOR) && !redit_may(v[..]) && !redit_edit_own(v[..]);
  for k: 1..<100 { wstep(v[..], cast(f32) k * 0.05); }
  #assert !redit_world_wants(v[..]) && redit_edit_model(v[..]) == "" && !wmsg(v[..], REDIT_MSG_BATCH, batch);
  o: [1] RealmEdit;
  // an owner's page the host never asks (no ?edit) asks the world for nothing
  redit_start(o[..], "moonlit-marsh");
  wstep(o[..], 0);
  #assert answer(o[..], 3, MADE) && redit_may(o[..]);
  for k: 1..<100 { wstep(o[..], cast(f32) k * 0.05); }
  #assert !redit_world_wants(o[..]) && !o[0].world[0].on && !wmsg(o[..], REDIT_MSG_BATCH, batch);
  // a realm whose face does not opt in never steps the world: the layer alone asks it nothing and leaves the shell's batch alone
  n2: [1] RealmEdit;
  redit_start(n2[..], "moonlit-marsh");
  redit_step(n2[..], 0, 1440, 900, 1);
  #assert answer(n2[..], 3, MADE) && redit_may(n2[..]);
  for k: 1..<100 { redit_step(n2[..], cast(f32) k * 0.05, 1440, 900, 1); }
  #assert !redit_world_wants(n2[..]) && !n2[0].world[0].on && !redit_message(n2[..], REDIT_MSG_BATCH, batch);
}
