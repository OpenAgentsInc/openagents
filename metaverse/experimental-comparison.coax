// Optional private specimen gallery. Positions are shared with the retained
// research pack recipe; labels appear only when its catalog marker is loaded.
#module "metaverse.experimentalcomparison";

#test "ten comparison stations are distinct, paired and away from spawn" {
 for i:0..<CMP_N {p:=cmp_site(i);#assert p.z>=8 && abs(p.left_x-p.right_x)>2 && p.span>0;
  for j:0..<i {q:=cmp_site(j);#assert p.x!=q.x || p.z!=q.z;}
 }#assert cmp_site(0).title=="01 BARREL" && cmp_site(9).title=="10 IMP";
}
CMP_N :: 10;
CmpSite :: struct {x:f32;z:f32;left_x:f32;right_x:f32;span:f32;title:string;}
cmp_site :: (i:int)->CmpSite {
 titles:=[10]string.["01 BARREL","02 CHEST","03 CHAIR","04 TABLE","05 BRAZIER / TORCH","06 PILLAR","07 TREE","08 ROCK","09 LONGSWORD","10 IMP"];
 spans:=[10]f32.[1.0,1.2,1.4,2.0,1.7,2.6,3.5,1.6,1.4,1.4];
 n:=ifx i<0 then 0 else ifx i>=CMP_N then CMP_N-1 else i;x:=18.0f32+f32(n%5)*6.5;
 return CmpSite.{x=x,z=8+f32(n/5)*8,left_x=x-1.4,right_x=x+1.4,span=spans[n],title=titles[n]};
}
