// Native component chain: physical contact -> bounded identity -> shared strike/HP.
#load "../rules/srd/battle.coax";
#load "experimental-hostiles.coax" as hostile;

contact_health_probe :: () -> bool {
  h: [1] hostile.Hostiles; hostile.hostile_test_start(h[..]); h[0].shared=true;
  for i: 0..<hostile.HS_N { h[0].enemies[i].dead=true; }
  h[0].enemies[0].dead=false; h[0].enemies[0].x=0; h[0].enemies[0].z=1; h[0].enemies[0].swing=0.34;
  before := h[0].dice[0].state; hostile.hostile_tick(h[..],0,0,0,0.05);
  if h[0].contacts[0].count!=1 || h[0].dice[0].state!=before || h[0].hp!=44 { return false; }
  hostile.hostile_damage(h[..],5,0,0,0);
  if h[0].hp!=44 || h[0].hits!=0 { return false; }
  actor := hostile.hc_take(h[0].contacts[..]);
  if actor!=0 || hostile.hc_take(h[0].contacts[..]) != -1 { return false; }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  _ := rs_add(b[..],rs_fighter("Hero",0,1),1,1);
  foe := rs_add(b[..],rs_guard("Enemy",1),2,1);
  b[0].c[0].ac=10; b[0].c[0].hp=20; b[0].c[0].hp_max=30; b[0].c[0].temp=10;
  rs_start_turn(b[..],foe);
  a := RsStatAttack.{id="probe",name="Strike",bonus=3,dice=1,sides=6,flat=1,kind=RS_PIERCING,ability=RS_STR,reach=5};
  if !rs_stat_attack(b[..],foe,0,a) || b[0].c[0].hp!=20 || b[0].c[0].temp!=6 { return false; }
  return b[0].turn.action && !rs_stat_attack(b[..],foe,0,a);
}
#test "native contact and health witness uses shared damage after contact-only physics" { #assert contact_health_probe(); }
