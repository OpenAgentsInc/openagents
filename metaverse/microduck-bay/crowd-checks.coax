// Checks for crowd.coax over a small made-up catalog: an open floor with one blocked block.
#load "../../coax/lib/json/json.coax";
mbc_catalog :: (out: [] u8, blocked: bool, battery: int) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "pack x\nduck 620\nbench -2000 9450 2020 10960 675\nrecipe RECIPE_MICRODUCK ITEM_BODY_MICRODUCK ITEM_BATTERY 1 ITEM_SCRAP_PART 3\n");
  jo_put(o[..], "item ITEM_BATTERY "); o[0].keyed = true; jo_int(o[..], battery); jo_put(o[..], " BATTERY\nitem ITEM_SCRAP_PART 64 SCRAP_PART\ngrid -11500 -20600 250 96 165\n");
  for k: 0..<MB_NZ {
    jo_put(o[..], "g ");
    // a block from x -1 to 1, z -1 to 1 (cells 42..49, rows 78..85)
    for i: 0..<MB_NX { jo_put(o[..], ifx blocked && i >= 42 && i < 50 && k >= 78 && k < 86 then "#" else "."); }
    jo_put(o[..], "\n");
  }
  return jo_text(o[..]);
}
#test "the bay's catalog gives the recipe, the items and the walkable grid" {
  b: [400000] u8; s: [1] MbBay;
  #assert mb_read(s[..], mbc_catalog(b[..], true, 16));
  #assert mb_recipe_text(s[..]) == "RECIPE_MICRODUCK" && s[0].item_n == 2;
  #assert mb_item_text(s[..], 0) == "BATTERY" && s[0].items[0].need == 1 && s[0].items[0].stack == 16 && s[0].items[0].have == 2;
  #assert mb_item_text(s[..], 1) == "SCRAP PART" && s[0].items[1].need == 3 && s[0].items[1].stack == 64 && s[0].items[1].have == 6;
  #assert abs(s[0].height - 0.62) < 0.001 && abs(s[0].bench_z0 - 9.45) < 0.001 && abs(s[0].gx + 11.5) < 0.001;
  #assert !mb_open(s[..], 0, 0) && mb_open(s[..], 3, 3) && !mb_open(s[..], 0, 20) && !mb_open(s[..], -10.5, 0);
  t: [1] MbBay; #assert !mb_read(t[..], "pack x\n") && !t[0].ready;
}
#test "thirty ducks spawn apart on open floor and stay on it while they wander" {
  b: [400000] u8; s: [1] MbBay;
  #assert mb_read(s[..], mbc_catalog(b[..], true, 16));
  mb_spawn(s[..], 30); #assert s[0].count == 30;
  mb_spawn(s[..], 99); #assert s[0].count == 30;
  for i: 0..<30 { #assert mb_open(s[..], s[0].ducks[i].x, s[0].ducks[i].z); }
  mb_mode(s[..], MB_WANDER);
  moved := 0;
  for f: 0..<1200 { mb_tick(s[..], 1.0 / 60.0); for i: 0..<30 { #assert mb_open(s[..], s[0].ducks[i].x, s[0].ducks[i].z); moved += s[0].ducks[i].draws; } }
  #assert moved > 30 * 300;
  mb_mode(s[..], MB_STOP); x := s[0].ducks[3].x;
  for f: 0..<60 { mb_tick(s[..], 1.0 / 60.0); }
  for i: 0..<30 { #assert s[0].ducks[i].draws == 0; }
  mb_spawn(s[..], 10); #assert s[0].count == 10;
  _ := x;
}
#test "in a line each duck follows the one ahead" {
  b: [400000] u8; s: [1] MbBay;
  #assert mb_read(s[..], mbc_catalog(b[..], false, 16));
  mb_spawn(s[..], 10); mb_mode(s[..], MB_LINE);
  for f: 0..<3600 { mb_tick(s[..], 1.0 / 60.0); }
  for i: 1..<10 { dx := s[0].ducks[i].x - s[0].ducks[i - 1].x; dz := s[0].ducks[i].z - s[0].ducks[i - 1].z; #assert dx * dx + dz * dz < 1.6 * 1.6; }
}
#test "crafting takes the recipe's parts, adds a duck at the bench and refuses when short" {
  b: [400000] u8; s: [1] MbBay;
  #assert mb_read(s[..], mbc_catalog(b[..], false, 4));
  #assert mb_craft(s[..]) && s[0].count == 1 && s[0].crafted == 1 && s[0].items[0].have == 1 && s[0].items[1].have == 3;
  #assert s[0].ducks[0].z < 9.45 && s[0].ducks[0].moving;
  #assert mb_craft(s[..]) && s[0].items[0].have == 0 && s[0].items[1].have == 0;
  #assert !mb_craft(s[..]) && s[0].count == 2 && mb_said(s[..]) == "NOT ENOUGH BATTERY";
  for k: 0..<9 { mb_refill(s[..]); }
  #assert s[0].items[0].have == 4 && s[0].items[1].have == 27;   // the battery stops at its stack of 4
  mb_reset(s[..]); #assert s[0].items[0].have == 2 && s[0].crafted == 0 && s[0].mode == MB_STOP;
}
