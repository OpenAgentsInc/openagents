// Native NWN UI atlas metadata and canvas quads. Original pixels stay private.
#module "verse.nights.ui";
Sprite ::struct {layer:int;x:int;y:int;w:int;h:int;advance:int;name:[32]u8;name_n:int;present:bool;}
UI ::struct {sprites:[64]Sprite;glyphs:[256]Sprite;sprite_n:int;glyph_n:int;declared:[124]bool;bad:bool;ready:bool;}
Rect ::struct {x:f32;y:f32;w:f32;h:f32;}
number :: (t:string)->int {if t.count==0 {return -1;}v:=0;for i:0..<t.count {if t[i]<'0' || t[i]>'9' {return -1;}d:=int(t[i]-'0');if v>(65535-d)/10 {return -1;}v=v*10+d;}return v;}
catalog :: (s:[]UI,t:string) {
 s[0]=UI.{};at:=0;while at<t.count {end:=at;while end<t.count && t[end]!='\n' {end+=1;}row:=t[at..<end];at=end+1;p:=0;w:[10]string;wn:=0;overflow:=false;
 while p<row.count {while p<row.count && (row[p]==' ' || row[p]=='\t' || row[p]=='\r') {p+=1;}if p==row.count {break;}q:=p;while p<row.count && row[p]!=' ' && row[p]!='\t' && row[p]!='\r' {p+=1;}if wn<10 {w[wn]=row[q..<p];wn+=1;}else {overflow=true;}}
 if wn>=2 && w[0]=="T" {layer:=number(w[1]);if layer>=0 && layer<124 {s[0].declared[layer]=true;}continue;}
 if wn<2 || w[1]!="nights" || (w[0]!="I" && w[0]!="G") {continue;}glyph:=w[0]=="G";
 if overflow || wn!=(ifx glyph then 9 else 8) {s[0].bad=true;continue;}layer:=number(w[3]);x:=number(w[4]);y:=number(w[5]);width:=number(w[6]);height:=number(w[7]);
 if layer<0 || layer>=124 || x<0 || y<0 || width<1 || height<1 || x>1024-width || y>1024-height {s[0].bad=true;continue;}r:=Sprite.{layer=layer,x=x,y=y,w=width,h=height,present=true};
 if glyph {code:=number(w[2]);advance:=number(w[8]);if code<0 || code>=256 || advance<0 || advance>128 {s[0].bad=true;continue;}if s[0].glyphs[code].present {s[0].bad=true;continue;}r.advance=advance;s[0].glyphs[code]=r;s[0].glyph_n+=1;}
 else {if w[2].count==0 || w[2].count>31 || s[0].sprite_n>=64 {s[0].bad=true;continue;}duplicate:=false;for i:0..<s[0].sprite_n {old:=s[0].sprites[i];if cast(string)old.name[0..<old.name_n]==w[2] {duplicate=true;}}if duplicate {s[0].bad=true;continue;}r.name_n=w[2].count;for i:0..<r.name_n {r.name[i]=w[2][i];}s[0].sprites[s[0].sprite_n]=r;s[0].sprite_n+=1;}
 }
 for i:0..<s[0].sprite_n {if !s[0].declared[s[0].sprites[i].layer] {s[0].bad=true;}}for i:0..<256 {if s[0].glyphs[i].present && !s[0].declared[s[0].glyphs[i].layer] {s[0].bad=true;}}
 complete:=true;for i:32..<127 {if !s[0].glyphs[i].present {complete=false;}}
 s[0].ready= !s[0].bad && complete && find(s,"panel").present && find(s,"button").present && find(s,"slot").present;
}
find :: (s:[]UI,name:string)->Sprite {for i:0..<s[0].sprite_n {r:=s[0].sprites[i];if cast(string)r.name[0..<r.name_n]==name {return r;}}return Sprite.{};}
quad :: (out:[]f32,at:int,r:Rect,s:Sprite)->int {
 if !s.present || r.w<=0 || r.h<=0 || at<0 || (at+6)*16>out.count {return at;}
 for i:0..<6 {right:=i==1 || i==2 || i==4;bottom:=i==2 || i==4 || i==5;o:=(at+i)*16;for j:0..<16 {out[o+j]=0;}
 out[o]=r.x+(ifx right then r.w else 0.0f32);out[o+1]=r.y+(ifx bottom then r.h else 0.0f32);out[o+2]=(f32(s.x)+(ifx right then f32(s.w) else 0.0f32))/1024;out[o+3]=(f32(s.y)+(ifx bottom then f32(s.h) else 0.0f32))/1024;out[o+4]=f32(s.layer);for j:8..<12 {out[o+j]=1;}}
 return at+6;
}
sprite :: (s:[]UI,out:[]f32,at:int,name:string,r:Rect)->int {return quad(out,at,r,find(s,name));}
text_width :: (s:[]UI,t:string,scale:f32)->f32 {v:=0.0f32;for i:0..<t.count {g:=s[0].glyphs[int(t[i])];if g.present {v+=f32(g.advance)*scale;}}return v;}
text :: (s:[]UI,out:[]f32,at:int,t:string,x:f32,y:f32,scale:f32,max_width:f32)->int {
 n:=at;pen:=x;for i:0..<t.count {code:=int(t[i]);g:=s[0].glyphs[code];if !g.present {g=s[0].glyphs[63];}if pen+f32(g.w)*scale>x+max_width {break;}n=quad(out,n,Rect.{x=pen,y=y,w=f32(g.w)*scale,h=f32(g.h)*scale},g);pen+=f32(g.advance)*scale;}return n;
}
center_text :: (s:[]UI,out:[]f32,at:int,t:string,r:Rect,scale:f32)->int {width:=text_width(s,t,scale);x:=r.x+(ifx width<r.w then (r.w-width)*0.5f32 else 4.0f32*scale);return text(s,out,at,t,x,r.y+(r.h-17*scale)*0.5f32,scale,r.w-8*scale);}
contains :: (r:Rect,x:f32,y:f32)->bool {return r.w>0 && r.h>0 && x>=r.x && x<r.x+r.w && y>=r.y && y<r.y+r.h;}
// Native frame corners remain their original size; only its interior/edges grow.
panel :: (s:[]UI,out:[]f32,at:int,r:Rect,scale:f32)->int {
 source:=find(s,"panel");if !source.present {return at;}border:=8;bw:=8*scale;if r.w<bw*2 || r.h<bw*2 || source.w<16 || source.h<16 {return quad(out,at,r,source);}n:=at;
 for row:0..<3 {for col:0..<3 {part:=source;part.x=source.x+(ifx col==0 then 0 else ifx col==1 then border else source.w-border);part.y=source.y+(ifx row==0 then 0 else ifx row==1 then border else source.h-border);part.w=ifx col==1 then source.w-border*2 else border;part.h=ifx row==1 then source.h-border*2 else border;
 target:=Rect.{x=r.x+(ifx col==0 then 0.0f32 else ifx col==1 then bw else r.w-bw),y=r.y+(ifx row==0 then 0.0f32 else ifx row==1 then bw else r.h-bw),w=ifx col==1 then r.w-2*bw else bw,h=ifx row==1 then r.h-2*bw else bw};if row==1 && col==1 {tile_w:=f32(part.w)*scale;tile_h:=f32(part.h)*scale;for ty:0..<32 {oy:=f32(ty)*tile_h;if oy>=target.h {break;}for tx:0..<32 {ox:=f32(tx)*tile_w;if ox>=target.w {break;}tw:=ifx target.w-ox<tile_w then target.w-ox else tile_w;th:=ifx target.h-oy<tile_h then target.h-oy else tile_h;crop:=part;crop.w=int(tw/scale);crop.h=int(th/scale);n=quad(out,n,Rect.{x=target.x+ox,y=target.y+oy,w=tw,h=th},crop);}}}else {n=quad(out,n,target,part);}}}
 return n;
}
#test "Nights native UI parser bounds and reset never retain stale atlas entries" {
 s:[1]UI;catalog(s[..],"I nights panel 119 0 0 32 32\nG nights 65 119 32 0 9 17 10\n");#assert s[0].sprite_n==1 && s[0].glyph_n==1 && !s[0].ready;
 catalog(s[..],"I nights panel 124 0 0 32 32\n");#assert s[0].bad && s[0].sprite_n==0 && s[0].glyph_n==0;
 catalog(s[..],"G nights 256 119 0 0 8 17 8\n");#assert s[0].bad;
 catalog(s[..],"I nights panel 119 1010 0 32 32\n");#assert s[0].bad;
}
#test "Nights native glyph quads carry source UV layer alpha and bounded output" {
 s:[1]UI;catalog(s[..],"G nights 65 119 32 64 9 17 10\n");out:[6*16]f32;n:=text(s[..],out[..],0,"AA",5,6,1,100);#assert n==6 && out[0]==5 && out[1]==6 && out[4]==119 && out[11]==1;
 #assert out[2]==32.0f32/1024 && out[3]==64.0f32/1024 && out[16]==14;#assert text_width(s[..],"AA",1)==20;
 #assert contains(Rect.{x=0,y=0,w=20,h=20},19,19) && !contains(Rect.{x=0,y=0,w=20,h=20},20,20);
}

#test "Nights UI readiness requires complete native ASCII and an actually declared atlas" {
 bytes:[8192]u8;n:=0;prefix:="I nights panel 119 0 0 32 32\nI nights button 119 32 0 32 32\nI nights slot 119 64 0 32 32\n";
 for i:0..<prefix.count {bytes[n]=prefix[i];n+=1;}row:="G nights 000 119 0 32 8 17 8\n";
 for code:32..<127 {for j:0..<row.count {bytes[n+j]=row[j];}bytes[n+9]=u8(48+code/100);bytes[n+10]=u8(48+(code/10)%10);bytes[n+11]=u8(48+code%10);n+=row.count;}
 s:[1]UI;catalog(s[..],cast(string)bytes[0..<n]);#assert !s[0].ready && s[0].bad;
 declaration:="T 119 nwn/native-ui 249\n";for i:0..<declaration.count {bytes[n]=declaration[i];n+=1;}catalog(s[..],cast(string)bytes[0..<n]);#assert s[0].ready && s[0].glyph_n==95;
 catalog(s[..],"T 119 nwn/native-ui 249\nI nights panel 119 0 0 32 32\n");#assert !s[0].ready && s[0].glyph_n==0;
}
