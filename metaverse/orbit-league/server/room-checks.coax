// Orbit League's room checks (metaverse/orbit-league/server/room.coax, #13347). They run in the room's suite
// (coax test --library coax/web/room/room.coax), through the generic host's exports.

#test "network diagnostics expose an authoritative Orbit room's selected contract without inventing counters" {
  v:[1]RmServer;rm_init(v[..]);
  #assert rm_join(v[..],0,"GET /api/room/orbit-league-v2/observed HTTP/1.1\r\n\r\n")>=0;
  r:=v[0].conns[0].room;rm_heard(v[..],0,"H 2 1 1 1");
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,r,0)==1;
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,r,1)==60;
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,r,4)==NET_COLLIDE_VEHICLE;
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,r,5)==NET_DURABLE_NONE;
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,r,8)==1;
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,r,9)==0;
  rm_heard(v[..],0,"I 1 0 0 0 0 0 0");rm_tick(v[..]);
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,r,9)==1;
  #assert rm_net_observation(v[..],RM_REALM_ORBIT_AUTH,-1,0)==-1;
  #assert rm_net_rooms(RM_REALM_ORBIT_AUTH)==OLR_ROOMS;
}

#test "profiles (#12845): client-reported Orbit cars cannot qualify the whole realm as authoritative" {
  #assert !net_authoritative(olr_beat());
}

#test "Orbit v2 (#12845): the room ignores reported transforms and steps admitted controls" #steps 2000000000 {
  v:[1]RmServer;rm_init(v[..]);rm_clock(v[..],0,1762190000000);
  #assert rm_join(v[..],0,"GET /api/room/orbit-league-v2/qualified HTTP/1.1\r\n\r\n")==0;
  r:=v[0].conns[0].room;before:=v[0].games.orbit.rooms[r].cars[0];
  rm_heard(v[..],0,"H 2 1 1 1");
  buf:[256]u8;buf[0]='c';forged:=before;forged.pos.x=100;
  n:=room_put_body(buf[..],1,forged);rm_heard(v[..],0,cast(string)buf[0..<n]);
  #assert v[0].games.orbit.rooms[r].cars[0].pos.x==before.pos.x;
  v[0].games.orbit.rooms[r].s[0].phase=PHASE_PLAY;
  rm_heard(v[..],0,"I 1 1000 0 0 3 10 0");
  for t:0..<30 {rm_clock(v[..],t*1000/60,1762190000000+t*1000/60);rm_tick(v[..]);}
  #assert v[0].games.orbit.rooms[r].cars[0].pos.z>before.pos.z+0.1;
  n=rm_state(v[..],0);#assert n>0 && v[0].out[0]=='S';
  snapshot:=orb_snapshot_read(cast(string)v[0].out[0..<n]);
  #assert snapshot.ok && snapshot.h[3]==1 && snapshot.h[4]==10 && snapshot.present[0] && snapshot.present[1] && !snapshot.present[2];
  #assert snapshot.v[ORB_FIELDS+13]==3 && cast(int)snapshot.v[ORB_FIELDS+ORB_LIFE]==v[0].conns[0].gen.value;
  place:=v[0].games.orbit.rooms[r].cars[0].pos;input_buf:[128]u8;
  for seq:2..<1002 {
    fields:=[7]int.[seq,1000,0,0,3,20,0];count:=net_record_write('I',fields[..],input_buf[..]);
    rm_heard(v[..],0,cast(string)input_buf[0..<count]);
  }
  #assert v[0].games.orbit.rooms[r].auth[0].ack[0]==1 && v[0].games.orbit.rooms[r].cars[0].pos.z==place.z;
  // a thousand controls buy one tick's steps: the newest ORB_QUEUE wait, a tick keeps ORB_QUEUE_KEEP and steps one
  #assert v[0].games.orbit.rooms[r].auth[0].queued[0]==ORB_QUEUE;
  rm_tick(v[..]);#assert v[0].games.orbit.rooms[r].auth[0].ack[0]==1000 && v[0].games.orbit.rooms[r].auth[0].accepted==2;
  #assert d3_dist(v[0].games.orbit.rooms[r].cars[0].pos,place)<2;
  rm_tick(v[..]);#assert v[0].games.orbit.rooms[r].auth[0].ack[0]==1001 && v[0].games.orbit.rooms[r].auth[0].queued[0]==0;
  rm_heard(v[..],0,"I 2 -1000 0 0 3 20 0");#assert v[0].games.orbit.rooms[r].auth[0].input[0].throttle==1000;
  // The same room name on the frozen profile has a separate world and retains its reported body.
  #assert rm_join(v[..],1,"GET /api/room/orbit-league/qualified HTTP/1.1\r\n\r\n")==0;
  old:=v[0].conns[1].room;#assert old!=r;
  rm_heard(v[..],1,cast(string)buf[0..<room_put_body(buf[..],1,forged)]);
  #assert v[0].games.orbit.rooms[old].cars[0].pos.x==100;
  #assert rm_join(v[..],2,"GET /api/room/orbit-league-v2/qualified HTTP/1.1\r\n\r\n")==1;
  rm_heard(v[..],2,"H 2 1 2 1");n=rm_state(v[..],2);
  #assert cast(string)v[0].out[0..<n]=="R 2";
}

#test "Orbit v2 (#13277): a seat's controls are stepped one a tick in the order sent, and the last holds when none waits" #steps 2000000000 {
  v:[1]RmServer;rm_init(v[..]);rm_clock(v[..],0,1762190000000);
  #assert rm_join(v[..],0,"GET /api/room/orbit-league-v2/queued HTTP/1.1\r\n\r\n")==0;
  r:=v[0].conns[0].room;rm_heard(v[..],0,"H 2 1 1 1");
  v[0].games.orbit.rooms[r].s[0].phase=PHASE_PLAY;
  // two arrive in one tick (a late packet and the next): each has its tick
  rm_heard(v[..],0,"I 1 1000 0 0 0 10 0");rm_heard(v[..],0,"I 2 -1000 500 0 0 20 0");
  #assert v[0].games.orbit.rooms[r].auth[0].queued[0]==2 && v[0].games.orbit.rooms[r].auth[0].ack[0]==0;
  rm_tick(v[..]);
  #assert v[0].games.orbit.rooms[r].auth[0].ack[0]==1 && v[0].games.orbit.rooms[r].auth[0].input[0].throttle==1000 && v[0].games.orbit.rooms[r].auth[0].echo[0]==10;
  rm_tick(v[..]);
  #assert v[0].games.orbit.rooms[r].auth[0].ack[0]==2 && v[0].games.orbit.rooms[r].auth[0].input[0].steer==500 && v[0].games.orbit.rooms[r].auth[0].echo[0]==20;
  // none waits: the last one holds, and nothing new is acknowledged
  rm_tick(v[..]);
  #assert v[0].games.orbit.rooms[r].auth[0].ack[0]==2 && v[0].games.orbit.rooms[r].auth[0].input[0].seq==2 && v[0].games.orbit.rooms[r].auth[0].queued[0]==0;
  // an older or repeated number is refused while newer ones wait
  rm_heard(v[..],0,"I 5 0 0 0 0 30 0");rm_heard(v[..],0,"I 4 0 0 0 0 30 0");rm_heard(v[..],0,"I 5 0 0 0 0 30 0");
  #assert v[0].games.orbit.rooms[r].auth[0].queued[0]==1 && v[0].games.orbit.rooms[r].auth[0].refused==2;
}

#test "a room's path names it; anything else is no room" {
  name: [ROOM_NAME] u8;
  n := olr_path_room("GET /api/room/orbit-league/Topher-1 HTTP/1.1\r\n", name[..]);
  #assert n == 8 && cast(string) name[0..<n] == "topher-1";
  #assert olr_path_room("GET /api/room/orbit-league/a?x=1 HTTP/1.1\r\n", name[..]) == 1;
  #assert olr_path_room("GET /api/room/other/a HTTP/1.1\r\n", name[..]) == 0;
  #assert olr_path_room("GET /api/room/orbit-league/ HTTP/1.1\r\n", name[..]) == 0;
  #assert olr_path_room("GET /api/room/orbit-league/a/b HTTP/1.1\r\n", name[..]) == 0;
  #assert olr_path_room("POST /api/room/orbit-league/a HTTP/1.1\r\n", name[..]) == 0;
}
#test "players join by name, four to a room; both hear the same ball, each the other's car" {
  v: [1] RmServer;
  rm_init(v[..]);
  req := "GET /api/room/orbit-league/one HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..], 0, req) == 0 && rm_join(v[..], 1, req) == 1;
  #assert rm_join(v[..], 2, "GET /api/room/orbit-league/two HTTP/1.1\r\n\r\n") == 0;
  #assert rm_join(v[..], 3, req) == 2 && rm_join(v[..], 4, req) == 3 && rm_join(v[..], 5, req) == -1;
  #assert rm_join(v[..], 6, "GET /nope HTTP/1.1\r\n\r\n") == -1;
  rm_left(v[..], 4); rm_left(v[..], 3);
  // a kickoff, then seat 0 drives through the ball
  for t: 0..<cast(int) (KICKOFF * 60.0 + 3.0) { rm_tick(v[..]); }
  for t: 0..<30 {
    car := vehicle_body(v[0].games.orbit.rooms[0].s[0].spec, CAR_MASS, d3(0.0, 0.9, -6.0 + cast(f64) t * 20.0 / 60.0), DQ.{});
    car.vel = d3(0.0, 0.0, 20.0);
    buf: [256] u8; buf[0] = 'c'; k := room_put_body(buf[..], 1, car);
    rm_heard(v[..], 0, cast(string) buf[0..<k]);
    rm_tick(v[..]);
  }
  #assert v[0].games.orbit.rooms[0].s[0].bodies[BALL].vel.z > 15.0;
  // both hear it: seat 0 as it is, seat 1 turned round
  a: [1] OrbitLeague; b: [1] OrbitLeague;
  game_reset(a[..]); game_reset(b[..]); a[0].online = true; b[0].online = true;
  n := rm_state(v[..], 0); room_take_legacy(a[..], cast(string) v[0].out[0..<n]);
  n = rm_state(v[..], 1); room_take_legacy(b[..], cast(string) v[0].out[0..<n]);
  ba := a[0].bodies[BALL]; bb := b[0].bodies[BALL];
  #assert ba.vel.z > 15.0 && abs(ba.pos.z + bb.pos.z) < 0.002 && abs(ba.pos.x + bb.pos.x) < 0.002 && abs(ba.pos.y - bb.pos.y) < 0.002;
  #assert a[0].seat == 0 && b[0].seat == 1 && abs(b[0].bodies[BOT].pos.z + v[0].games.orbit.rooms[0].cars[0].pos.z) < 0.002;
  // the other room is its own
  #assert rm_state(v[..], 2) > 0 && v[0].games.orbit.rooms[1].s[0].bodies[BALL].vel.z == 0.0;
  // everyone leaves: the room closes at the next tick
  rm_left(v[..], 0); rm_left(v[..], 1); rm_tick(v[..]);
  #assert !v[0].games.orbit.rooms[0].live && rm_players(v[..]) == 1;
}

// Its budget: the 2v2 room's three bots drive and the ball steps at 120 Hz
// through the ten-second wait, the kickoff and 1.5 s of play, 870 ticks of
// about 172,000 steps each (149,997,566 measured).
#test "QUICK MATCH: two players asking for a 1v1 land in the same match, a third starts the next; a 2v2 waits, then bots take its empty seats and drive (ol-quick-match)" #steps 200000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  q1 := "GET /api/room/orbit-league/quick-1v1 HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..], 0, q1) == 0 && rm_join(v[..], 1, q1) == 1;
  #assert v[0].conns[0].room == v[0].conns[1].room && v[0].games.orbit.rooms[v[0].conns[0].room].quick == 2;
  // full: it stops waiting and counts down
  #assert v[0].games.orbit.rooms[v[0].conns[0].room].s[0].phase_t >= 0.0;
  #assert rm_join(v[..], 2, q1) == 0 && v[0].conns[2].room != v[0].conns[0].room;
  // a 2v2 with one player: it waits, then three bots play
  q2 := "GET /api/room/orbit-league/quick-2v2 HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..], 3, q2) == 0;
  r := v[0].conns[3].room;
  #assert v[0].games.orbit.rooms[r].quick == ROOM_PLAYERS && v[0].games.orbit.rooms[r].s[0].phase_t < 0.0;
  n := rm_state(v[..], 3);
  a: [1] OrbitLeague; game_reset(a[..]); a[0].online = true; a[0].no_bot = true;
  room_take_legacy(a[..], cast(string) v[0].out[0..<n]);
  #assert a[0].cars_n == CARS && a[0].phase == PHASE_KICKOFF && a[0].phase_t < 0.0;
  // the 1v1 players are done: they leave, and their rooms close on the next tick
  r1 := v[0].conns[0].room; r2 := v[0].conns[2].room;
  rm_left(v[..], 0); rm_left(v[..], 1); rm_left(v[..], 2);
  rm_tick(v[..]);
  #assert !v[0].games.orbit.rooms[r1].live && !v[0].games.orbit.rooms[r2].live && v[0].games.orbit.rooms[r].live;
  for t: 1..<cast(int) ((QUICK_WAIT + KICKOFF + 1.5) * 60.0) { rm_tick(v[..]); }
  m := v[0].games.orbit.rooms[r];
  #assert m.s[0].phase == PHASE_PLAY;
  for seat: 1..<ROOM_PLAYERS { #assert d3_len(m.cars[seat].vel) > 3.0 && m.cars[seat].pos.y > 0.0 && m.cars[seat].pos.y < 3.0; }
}

#test "QUICK MATCH: a second player a second later joins the waiting match and its countdown starts (ol-quick-match)" {
  v: [1] RmServer;
  rm_init(v[..]);
  q1 := "GET /api/room/orbit-league/quick-1v1 HTTP/1.1\r\n\r\n";
  // a room slot used before: its kickoff count carries on
  r0 := olr_find(v[0].games.orbit.rooms[..], "old"); v[0].games.orbit.rooms[r0].live = false;
  #assert rm_join(v[..], 0, q1) == 0 && v[0].games.orbit.rooms[v[0].conns[0].room].s[0].kicks > 1;
  for t: 0..<90 { rm_tick(v[..]); }
  #assert rm_join(v[..], 1, q1) == 1;
  #assert v[0].conns[0].room == v[0].conns[1].room;
  #assert v[0].games.orbit.rooms[v[0].conns[0].room].s[0].phase_t >= 0.0;
  for t: 0..<3 { rm_tick(v[..]); }
  n := rm_state(v[..], 1);
  a: [1] OrbitLeague; game_reset(a[..]); a[0].online = true; a[0].no_bot = true;
  room_take_legacy(a[..], cast(string) v[0].out[0..<n]);
  #assert a[0].phase_t >= 0.0;
}

#test "a player's paint reaches the other player with their car; a new player in the seat starts unpainted (ol-paint)" {
  v: [1] RmServer;
  rm_init(v[..]);
  req := "GET /api/room/orbit-league/paint-1 HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..], 0, req) == 0 && rm_join(v[..], 1, req) == 1;
  a: [1] OrbitLeague; game_reset(a[..]); a[0].online = true; a[0].no_bot = true; a[0].paint = 3 + 8 * 2;
  buf: [256] u8; k := 0;
  buf[k] = 'c'; k += 1;
  k = room_put_body(buf[..], k, a[0].bodies[YOU]); k = room_put_int(buf[..], k, 1000); k = room_put_int(buf[..], k, a[0].paint);
  rm_heard(v[..], 0, cast(string) buf[0..<k]);
  rm_tick(v[..]);
  n := rm_state(v[..], 1);
  b: [1] OrbitLeague; game_reset(b[..]); b[0].online = true; b[0].no_bot = true;
  room_take_legacy(b[..], cast(string) v[0].out[0..<n]);
  #assert b[0].paints[1] == 3 + 8 * 2 && b[0].seat == 1;
  // and its own state skips itself whatever its paint
  n = rm_state(v[..], 0);
  room_take_legacy(a[..], cast(string) v[0].out[0..<n]);
  #assert a[0].seat == 0 && a[0].paints[1] == 0 && a[0].cars_n == 2;
  rm_left(v[..], 0);
  #assert rm_join(v[..], 2, req) == 0 && v[0].games.orbit.rooms[v[0].conns[2].room].paint[0] == 0;
}

#test "an Orbit League room beside a relay room plays as before: the relay never ticks it, and the games' tick never steps a relay room (room-relay)" {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 0, 7);
  #assert rm_join(v[..], 0, "GET /api/room/relay/hold-the-stair/K7Q2 HTTP/1.1\r\n\r\n") == 0;
  #assert rm_join(v[..], 1, "GET /api/room/orbit-league/one HTTP/1.1\r\n\r\n") == 0;
  rm_tick(v[..]);
  #assert rm_state(v[..], 0) == 0 && rm_state(v[..], 1) > 0 && v[0].games.orbit.rooms[0].live;
  rm_left(v[..], 1); rm_tick(v[..]);
  #assert !v[0].games.orbit.rooms[0].live && v[0].relays[v[0].conns[0].relay].live;
}
