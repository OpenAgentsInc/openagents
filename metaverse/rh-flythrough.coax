// Metaverse Engine 3D Flythrough realm data & Catmull-Rom spline camera for the
// Riemann Hypothesis Proof Workbench (OpenAgents Desktop Gym -> Lean · RH -> 1. 3D Flythrough).
//
// Reuses:
//   - metaverse-engine/cam/flyover.coax (Catmull-Rom spline flyover camera `fly_parse` / `fly_shot`)
//   - coax/lib/lean/rh-math.coax (real Riemann-Siegel Hardy Z(t) & |zeta(s)|, exact Robin 5040
//     divisor ratios, and Alpoge's 8-stage sqrt(X) theta-lift chain vs 2/3 barrier)
//
//   coax/bin/coax test metaverse/rh-flythrough.coax --library
#load "../metaverse-engine/cam/flyover.coax";
#load "../coax/lib/lean/rh-math.coax";
#load "../coax/lib/json/json.coax";

RH3D_STATIONS :: 8;
RH3D_DURATION :: 62.0f32;

// 10-key Metaverse Engine Catmull-Rom flyover spline (Y-up meters, matching metaverse-engine/cam/flyover.coax):
//   t=0..49s glides smoothly through all 8 stations (X = -42 .. +42, 12m apart along Z = 0),
//   t=55s sweeps high into a full panoramic vista of all 8 stations end-to-end,
//   t=62s loops cleanly back toward Station 1 (Prime Music / Zeta Terrain).
RH3D_FLY_PATH :: "0,-49,8.5,15,-42,2.6,0~7,-34,7.2,13.5,-30,2.8,0~14,-21,7.5,14,-18,3.2,0~21,-8,8.5,15,-6,3.8,0~28,6,11.5,18,6,4.5,0~35,19,8.0,14.5,18,3.2,0~42,32,8.5,15,30,3.6,0~49,47,10.5,16,42,5.5,0~55,0,32.0,74,0,3.0,0~62,-49,8.5,15,-42,2.6,0";

Rh3dStation :: struct {
  x: f32;
  y: f32;
  z: f32;
  time_s: f32;
  eye_x: f32;
  eye_y: f32;
  eye_z: f32;
  short_name: string;
  badge: string;
  title: string;
  subtitle: string;
  plain_english: string;
  why_it_matters: string;
  analogy: string;
  next_link: string;
  module_name: string;
}

rh3d_station :: (idx: int) -> Rh3dStation {
  if idx == 0 {
    return Rh3dStation.{
