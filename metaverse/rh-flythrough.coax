      eye_x = -49.0f32, eye_y = 8.5f32, eye_z = 15.0f32,
      short_name = "1. Prime Music",
      badge = "167-YEAR MYSTERY · $1M PRIZE",
      title = "1. The 167-Year Mystery: Do Primes Have a Hidden Rhythm?",
      subtitle = "Unsolved from 1859 until Nov 20, 2026 · Clay $1,000,000 Millennium Prize",
      plain_english = "The glowing wireframe hills are Riemann's zeta wave computed live in Coax. Every place the wave dives straight down to zero shoots up a glowing gold spike — and every single spike lines up dead-center on that one golden glass wall (Re = 1/2).",
      why_it_matters = "Prime numbers (2, 3, 5, 7, 11...) are the atoms of math and internet encryption, yet they look totally chaotic. In 1859 Riemann discovered these zero spikes act like hidden sound notes predicting where primes appear. Proving NO zero ever drifts off this wall settles the distribution of primes forever and turns hundreds of 'assuming RH' theorems across math and computer science into proven fact.",
      analogy = "Like discovering that static noise on a radio is actually a hidden symphony — and proving every single musical note in the universe is tuned to the exact same frequency line.",
      next_link = "Checking an infinite wave sounds impossible. Next: a surprisingly simple whole-number gut-check that is 100% equivalent to RH.",
      module_name = "Statements",
    };
  }
  if idx == 1 {
    return Rh3dStation.{
      x = -30.0f32, y = 2.8f32, z = 0.0f32, time_s = 7.0f32,
      eye_x = -34.0f32, eye_y = 7.2f32, eye_z = 13.5f32,
      short_name = "2. 5040 Test",
      badge = "THE WHOLE-NUMBER GUT CHECK",
      title = "2. The 5,040 Test: A Whole-Number Check Anyone Can Understand",
      subtitle = "Guy Robin (1984): RH is 100% identical to a simple ceiling on divisors past 5,040",
      plain_english = "Each pillar is a whole number, and its height measures how rich its list of divisors is. Early rebel numbers (red bars on the left) poke right through the cyan glass ceiling. The blazing gold tower is 5,040 — the very last rebel. Every number to the right stays safely under the glass.",
      why_it_matters = "This does two huge things: it translates abstract complex waves into plain whole-number arithmetic, and it gives the Lean proof an independent sanity check (Challenge.lean). Skeptics can inspect this short statement and know immediately the proof really proves the famous Riemann Hypothesis — no hidden definitions or loopholes.",
      analogy = "Like checking whether a 100-story skyscraper is truly straight using a pocket bubble level: if even ONE number larger than 5,040 ever broke the cyan ceiling, RH would collapse.",
      next_link = "Stating RH simply is one thing; proving it was a 167-year brick wall. Next: the infamous 2/3 barrier that stopped everyone cold.",
      module_name = "Challenge",
    };
  }
  if idx == 2 {
    return Rh3dStation.{
      x = -18.0f32, y = 3.2f32, z = 0.0f32, time_s = 14.0f32,
      eye_x = -21.0f32, eye_y = 7.5f32, eye_z = 14.0f32,
      short_name = "3. 2/3 Wall",
      badge = "THE HISTORIC BREAKTHROUGH",
      title = "3. The Breakthrough: Smashing the 100-Year '2/3' Brick Wall",
      subtitle = "Classical math stalled below 2/3 for a century; Alpoge's 8-step chain vaults clean over it",
      plain_english = "The glowing red horizontal slab is the infamous 2/3 density wall. Notice the dim red columns behind it — a century of older proof methods — all stalling underneath. Front and center, the glowing cyan staircase climbs 8 stages straight through the gap and punches well past 2/3.",
      why_it_matters = "THIS is the exact lightning bolt that cracked RH open. Older techniques could squeeze most zeros near the line, but always hit a hard ceiling at 2/3 — leaving room for rogue zeros to hide off the wall. Levent Alpoge chained square-root cancellation with 8 iterated mirror-symmetry boosts that finally clear 2/3 and eliminate every hiding spot.",
      analogy = "Like trying to reach orbit when every rocket fuel on Earth tops out at 66% escape velocity. Alpoge built an 8-stage booster that finally breaks out into orbit.",
      next_link = "How does that 8-stage mathematical booster actually work? Next: step inside the Mirror-Symmetry Engine Room.",
      module_name = "Supplements.ThetaPairLifts",
    };
  }
  if idx == 3 {
    return Rh3dStation.{
      x = -6.0f32, y = 3.8f32, z = 0.0f32, time_s = 21.0f32,
      eye_x = -8.0f32, eye_y = 8.5f32, eye_z = 15.0f32,
      short_name = "4. Mirror Bridge",
      badge = "HOW THE ENGINE WORKS",
      title = "4. The Engine Room: Turning Chaotic Primes Into Smooth Geometry",
      subtitle = "44,578 Supplements files translating primes into waves on curved mirror-symmetric spaces",
