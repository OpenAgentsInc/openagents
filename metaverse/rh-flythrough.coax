      analogy = "Bitcoin's 'don't trust, verify' applied to pure math: it doesn't matter whether a human or an AI typed the proof — four tiny independent referee programs verified every single atom of logic.",
      next_link = "Follow the final glowing conduit to the Summit — where 813,182 proven theorems lock into 4 legendary lines of code.",
      module_name = "BuildAid.D1",
    };
  }
  return Rh3dStation.{
    x = 42.0f32, y = 5.5f32, z = 0.0f32, time_s = 49.0f32,
    eye_x = 47.0f32, eye_y = 10.5f32, eye_z = 16.0f32,
    short_name = "8. Solved Q.E.D.",
    badge = "HISTORY MADE · NOV 21, 2026",
    title = "8. The Summit: Main.riemannHypothesis — 167 Years Later, Q.E.D.",
    subtitle = "813,182 machine-verified theorems snap into 4 final lines in src/Main.lean",
    plain_english = "Every glowing conduit from all 7 stations converges into this terraced obsidian ziggurat and shoots straight up the golden light needle through double cyan halo rings into the Q.E.D. crown — the final 4-line theorem sealing the proof.",
    why_it_matters = "Two world-changing milestones just landed on the same day: (1) The most famous unsolved math problem since 1859 ($1M Millennium Prize) is now certified truth, instantly promoting hundreds of conditional theorems in math and algorithms into unconditional facts. (2) It proves human insight + AI scale + formal Lean verification can solve and certify problems at a scale no human team could ever audit alone.",
    analogy = "The Moon landing for mathematics — except anyone with a laptop can download the code, run a verifier, and prove to themselves beyond a shadow of a doubt that it's 100% true.",
    next_link = "Click OVERVIEW to see the full 8-step story end-to-end, SOURCE to inspect real Lean files, or jump to Tabs 2–6 to run your own live checks!",
    module_name = "Main",
