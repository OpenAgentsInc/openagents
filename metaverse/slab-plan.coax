// SLAB's platform plan as data (docs/research/ocean/slab-world-spec.md, sections 3.1 and 7):
// the `prime` monolith's hull and the masses on its deck, as simple solids the SLAB Simulation
// realm (apps/openagents-web/slab.coax) packs into its uniforms and slab.wgsl traces. Units are
// metres; +Y is up; the origin is the platform's centre at the calm waterline; +X runs along the
// length toward the bow (east), +Z north. The layout follows the concept image (slab.jpeg):
// industry and its smoking stacks at the west end, a dense tower cluster in the middle, and at the
// east end classical temples in cypress groves, a domed civic hall, a fountain plaza and a long
// canal lined with trees.
//
// A record is 8 floats: min x, y, z, kind, then max x, y, z, shape. Kinds pick the paint and the
// info card (SLAB_KIND_*); shapes pick the solid traced inside the record's box:
//   0 box, 1 upright cylinder (inscribed), 2 gabled hall (ridge along X), 3 gabled hall (ridge
//   along Z), 4 grove (cypresses on a 7 m grid over a lawn), 5 grove with a clear glade in its
//   middle, 6 dome (the hemisphere inscribed on the box's floor).
// The hull's six pieces come first. Records are grouped ten at a time (slab_groups) so the tracer
// can skip a whole district with one box test.

#load "../metaverse-engine/render/noise.coax";
#load "hull.coax";

// The hull's figures are metaverse/hull.coax's: the plan draws what the ledger weighs.
SLAB_LENGTH :: f32(HULL_PRIME_L);     // L, along X: 1,000 m
SLAB_BEAM :: f32(HULL_PRIME_B);       // B, along Z: 600 m
SLAB_DEPTH :: f32(HULL_PRIME_DECK);   // keel to deck, 143 m: the concept image's wall, 118 m over the water
SLAB_DRAFT :: f32(HULL_PRIME_DRAFT);  // T: 25 m
SLAB_CORNER :: f32(HULL_PRIME_CORNER);   // plan corner radius: the image's corners are sharp
SLAB_DECK :: SLAB_DEPTH - SLAB_DRAFT;   // the deck's height over the calm water: 118 m
SLAB_HULL_TOP :: f32(HULL_PRIME_HULL - HULL_PRIME_DRAFT);   // the watertight hull's top over the calm water: 25 m;
                                        // the upper structure carries the deck from here
SLAB_RECORD :: 8;
SLAB_MAX_BOXES :: 152;   // includes the port and construction fleet alongside the city
SLAB_PIPE_RADIUS :: 3.35f32; SLAB_PIPE_LENGTH :: 1000.0f32;
SLAB_HULL_PIECES :: 6;
SLAB_GROUP :: 10;           // records a group
SLAB_MAX_GROUPS :: 16;
SLAB_GROUP_FLOATS :: 8;     // a group: min xyz, first record; max xyz, record count
SLAB_TREE_CELL :: 7.0f32;   // a grove's grid
SLAB_GLADE :: 0.36f32;      // the share of a glade grove's half sizes left clear in its middle

SLAB_KIND_HULL :: 0;
SLAB_KIND_PLANT :: 2;      // OTEC turbine halls and heat exchangers
SLAB_KIND_INDUSTRY :: 3;
SLAB_KIND_DATA :: 4;
SLAB_KIND_TOWER :: 5;
SLAB_KIND_STACK :: 6;
SLAB_KIND_PARK :: 7;
SLAB_KIND_CONTAINERS :: 8;
SLAB_KIND_CIVIC :: 9;
SLAB_KIND_TANK :: 10;
SLAB_KIND_MEDICAL :: 11;
SLAB_KIND_CRANE :: 12;
SLAB_KIND_COOLING :: 13;
SLAB_KIND_POOL :: 14;      // moonpools, the canal and the fountain's basin: open water
SLAB_KIND_GROVE :: 15;
SLAB_KIND_TEMPLE :: 16;
SLAB_KIND_PLAZA :: 17;
SLAB_KIND_COLONNADE :: 18;
SLAB_KIND_FOUNTAIN :: 19;
SLAB_KIND_DESAL :: 20;
SLAB_KIND_PIPE :: 21;      // the OTEC cold-water pipes, hanging 1,000 m down through the moonpools
SLAB_KIND_STATUE :: 27;    // 22 to 26 are slab-construction.coax's caissons, lifts, boats, cabins and cargo
SLAB_KIND_DOME :: 28;      // a Silone dome module (spec 3.2)
SLAB_KIND_BRIDGE :: 29;    // a bridge between two domes of the cluster (spec 3.3)
SLAB_KIND_POWERSHIP :: 30; // the 160 m nuclear powership moored off the dome layouts (spec 3.4)
SLAB_KIND_CABLE :: 31;     // its power cable to the nearest dome
SLAB_KINDS :: 32;

SLAB_BOX :: 0;
SLAB_CYLINDER :: 1;
SLAB_GABLE_X :: 2;
SLAB_GABLE_Z :: 3;
SLAB_GROVE :: 4;
SLAB_GLADE_GROVE :: 5;
SLAB_DOME :: 6;
// 7 to 10 are slab-construction.coax's hawsers: a capsule between two of the box's corners
SLAB_TEMPLE :: 11;         // a Greek temple: steps, peristyle, cella, entablature, pedimented roof along its longer side
SLAB_THOLOS :: 12;         // a round temple: steps, a ring of columns, a domed cella
SLAB_STATUES :: 13;        // a row of statues on pedestals along both long edges of the box, SLAB_STATUE_GAP apart
SLAB_STATUE_GAP :: 12.0f32;
SLAB_SILONE :: 14;         // a Silone dome module: its submerged base ring, 5 stepped terraces, the lantern
SLAB_BRIDGE :: 15;         // 15 to 18: an 8 m bridge deck between two of the box's corners (as the hawsers)
SLAB_DOME_R :: 60.96f32;   // 400 ft across
SLAB_DOME_DRAFT :: 12.0f32; SLAB_DOME_FREEBOARD :: 4.0f32;
SLAB_TERRACE :: 6.0f32;    // each terrace 6 m high and 6 m deep, 5 of them: the cap rises 30 m
SLAB_LANTERN_R :: 4.0f32; SLAB_LANTERN_TALL :: 10.0f32;
SLAB_BRIDGE_HALF :: 4.0f32; SLAB_BRIDGE_DEPTH :: 1.2f32;
SLAB_STATUE_TALL :: 4.2f32;  // a 1.8 m pedestal, a 2.4 m figure

// Whether (x, z) lies within r of a statue's pedestal in a row over (x0, z0)-(x1, z1). The shader
// (gpu/slab.coax slab_statues_hit) places the same statues: along the longer side every
// SLAB_STATUE_GAP from the row's start, 1.5 m in from each long edge, 1.6 m square.
slab_statue_near :: (x0: f32, z0: f32, x1: f32, z1: f32, x: f32, z: f32, r: f32) -> bool {
  along_x := x1 - x0 >= z1 - z0;
  a := ifx along_x then x else z; la := ifx along_x then x0 else z0; ha := ifx along_x then x1 else z1;
  i := floor((a - la) / SLAB_STATUE_GAP);
  if i < 0 || i >= floor((ha - la) / SLAB_STATUE_GAP) { return false; }
  c := la + SLAB_STATUE_GAP * (i + 0.5f32);
  across := ifx along_x then z else x;
  s0 := (ifx along_x then z0 else x0) + 1.5f32; s1 := (ifx along_x then z1 else x1) - 1.5f32;
  return abs(a - c) < 0.8f32 + r && (abs(across - s0) < 0.8f32 + r || abs(across - s1) < 0.8f32 + r);
}
// The powership: 160 m long and 32 m in the beam, its long side 300 m off a dome's rim along
// -x, drawing 8 m with 8 m of freeboard; four modules' halls and stacks on deck, the bridge aft,
// and the cable from its side to the dome's rim (a capsule, as the hawsers draw).
SLAB_SHIP_LONG :: 160.0f32;
SLAB_SHIP_BEAM :: 32.0f32;
SLAB_SHIP_OFF :: 300.0f32;
slab_powership :: (out: [] f32, n: int, rim_x: f32, cz: f32) -> int {
  x1 := rim_x - SLAB_SHIP_OFF; x0 := x1 - SLAB_SHIP_BEAM;
  z0 := cz - SLAB_SHIP_LONG / 2; z1 := cz + SLAB_SHIP_LONG / 2;
  k := SLAB_KIND_POWERSHIP;
  m := slab_put(out, n, x0, -8, z0, x1, 8, z1, k, SLAB_BOX);
  m = slab_put(out, m, x0 + 3, 8, z1 - 30, x1 - 3, 26, z1 - 6, k, SLAB_BOX);            // the bridge and quarters, aft
  for i: 0..<4 {
    hz := z0 + 10 + f32(i) * 26;
    m = slab_put(out, m, x0 + 4, 8, hz, x1 - 4, 18, hz + 22, k, SLAB_GABLE_X);           // a module's turbine hall
    m = slab_put(out, m, x0 + 13, 18, hz + 8, x0 + 19, 34, hz + 14, k, SLAB_CYLINDER);   // and its stack
  }
  // the cable: from the ship's side at its deck down to the dome's rim at its deck
  return slab_put(out, m, x1, 4, cz - 0.5, rim_x, 8, cz + 0.5, SLAB_KIND_CABLE, 7);
}
// A Silone dome module centred on (cx, cz), its waterline at y: the box runs from the keel to
// the lantern's top (the shader, gpu/slab.coax slab_silone_hit, steps the terraces inside it).
slab_silone :: (out: [] f32, n: int, cx: f32, y: f32, cz: f32) -> int {
  top := y + SLAB_DOME_FREEBOARD + 5 * SLAB_TERRACE + SLAB_LANTERN_TALL;
  return slab_put(out, n, cx - SLAB_DOME_R, y - SLAB_DOME_DRAFT, cz - SLAB_DOME_R, cx + SLAB_DOME_R, top, cz + SLAB_DOME_R, SLAB_KIND_DOME, SLAB_SILONE);
}
// A bridge deck from seat a to seat b: the box holds the deck's width and depth round the segment,
// and the shape says which corners its ends lie toward (bit 1: a's x is the box's high x; bit 2:
// a's z the high z). a is the higher end.
slab_bridge :: (out: [] f32, n: int, ax0: f32, ay0: f32, az0: f32, bx0: f32, by0: f32, bz0: f32) -> int {
  swap := by0 > ay0;
  ax := ifx swap then bx0 else ax0; ay := ifx swap then by0 else ay0; az := ifx swap then bz0 else az0;
  bx := ifx swap then ax0 else bx0; by := ifx swap then ay0 else by0; bz := ifx swap then az0 else bz0;
  m := SLAB_BRIDGE_HALF + 0.5f32; my := SLAB_BRIDGE_DEPTH;
  shape := SLAB_BRIDGE + (ifx ax > bx then 1 else 0) + (ifx az > bz then 2 else 0);
  return slab_put(out, n, lo_f32p(ax, bx) - m, by - my, lo_f32p(az, bz) - m, hi_f32p(ax, bx) + m, ay + my, hi_f32p(az, bz) + m, SLAB_KIND_BRIDGE, shape);
}
lo_f32p :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi_f32p :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
slab_statues :: (out: [] f32, n: int, x0: f32, z0: f32, x1: f32, z1: f32) -> int {
  return slab_put(out, n, x0, SLAB_DECK, z0, x1, SLAB_DECK + SLAB_STATUE_TALL, z1, SLAB_KIND_STATUE, SLAB_STATUES);
}

slab_put :: (out: [] f32, n: int, x0: f32, y0: f32, z0: f32, x1: f32, y1: f32, z1: f32, kind: int, shape: int) -> int {
  if n >= SLAB_MAX_BOXES || (n + 1) * SLAB_RECORD > out.count { return n; }
  at := n * SLAB_RECORD;
  out[at] = x0; out[at + 1] = y0; out[at + 2] = z0; out[at + 3] = f32(kind);
  out[at + 4] = x1; out[at + 5] = y1; out[at + 6] = z1; out[at + 7] = f32(shape);
  return n + 1;
}
// A mass standing on the deck: its footprint and height.
slab_mass :: (out: [] f32, n: int, x0: f32, z0: f32, x1: f32, z1: f32, height: f32, kind: int) -> int {
  return slab_put(out, n, x0, SLAB_DECK, z0, x1, SLAB_DECK + height, z1, kind, SLAB_BOX);
}
// A solid of any shape standing on the deck.
slab_shape :: (out: [] f32, n: int, x0: f32, z0: f32, x1: f32, z1: f32, height: f32, kind: int, shape: int) -> int {
  return slab_put(out, n, x0, SLAB_DECK, z0, x1, SLAB_DECK + height, z1, kind, shape);
}
// An upright cylinder on the deck at (x, z).
slab_drum :: (out: [] f32, n: int, x: f32, z: f32, radius: f32, height: f32, kind: int) -> int {
  return slab_put(out, n, x - radius, SLAB_DECK, z - radius, x + radius, SLAB_DECK + height, z + radius, kind, SLAB_CYLINDER);
}
// A dome of radius r whose rim sits at height `base` over the deck, centred on (x, z).
slab_dome :: (out: [] f32, n: int, x: f32, z: f32, radius: f32, base: f32, kind: int) -> int {
  return slab_put(out, n, x - radius, SLAB_DECK + base, z - radius, x + radius, SLAB_DECK + base + radius, z + radius, kind, SLAB_DOME);
}

// The twenty towers (offices and housing), 80 to 180 m, as the concept image's dense cluster.
// The towers (the concept image's glass cluster behind the canal): place, half sizes and height.
TOWERS :: 23;
TOWER_X :: [23] f32.[-300, -215, -130, -45, 40, 125, -260, -175, -90, -5, 80, 160, -300, -215, -130, -45, 40, 125, -255, -170, -85, 0, 85];
TOWER_Z :: [23] f32.[18, 22, 14, 24, 16, 20, -60, -56, -64, -58, -62, -54, -140, -136, -144, -138, -142, -134, -222, -218, -226, -220, -224];
TOWER_HX :: [23] f32.[12, 14, 11, 15, 13, 11, 14, 12, 16, 15, 13, 11, 12, 15, 16, 14, 12, 13, 11, 13, 15, 14, 12];
TOWER_HZ :: [23] f32.[14, 11, 15, 12, 11, 13, 12, 15, 14, 13, 15, 12, 14, 12, 13, 15, 14, 11, 13, 15, 12, 13, 14];
TOWER_HEIGHTS :: [23] f32.[90, 120, 160, 140, 110, 85, 135, 175, 205, 185, 150, 100, 110, 165, 195, 180, 160, 120, 95, 140, 170, 150, 115];
// The chimneys at the west end, the four tallest smoking (the concept image's power station).
STACKS :: 8;
STACK_X :: [8] f32.[-472, -456, -462, -444, -432, -448, -436, -404];
STACK_Z :: [8] f32.[150, 128, 86, 60, 40, 2, -20, -40];
STACK_H :: [8] f32.[70, 74, 92, 95, 82, 95, 78, 92];

// Writes the `prime` plan into out (SLAB_RECORD floats a record); returns the record count. The
// layout follows the concept image (docs/research/ocean/slab.jpeg), its features placed on the
// deck by back-projecting them through the image's camera, fitted to the hull's corners.
slab_plan :: (out: [] f32) -> int {
  n := 0;
  hl := SLAB_LENGTH / 2; hb := SLAB_BEAM / 2; r := SLAB_CORNER;
  keel := -SLAB_DRAFT;
  // The hull: a rectangle in plan with barely rounded corners, as two crossed boxes and four corner drums.
  n = slab_put(out, n, -hl, keel, -hb + r, hl, SLAB_DECK, hb - r, SLAB_KIND_HULL, SLAB_BOX);
  n = slab_put(out, n, -hl + r, keel, -hb, hl - r, SLAB_DECK, hb, SLAB_KIND_HULL, SLAB_BOX);
  for c: 0..<4 {
    cx := ifx c & 1 == 0 then -hl + r else hl - r;
    cz := ifx c & 2 == 0 then -hb + r else hb - r;
    n = slab_put(out, n, cx - r, keel, cz - r, cx + r, SLAB_DECK, cz + r, SLAB_KIND_HULL, SLAB_CYLINDER);
  }
  // The west end: the OTEC plant's power station. Turbine halls along the north edge, the power
  // block and process units behind the chimneys, a tank farm and desalination at the south.
  n = slab_shape(out, n, -470, 170, -340, 265, 30, SLAB_KIND_PLANT, SLAB_GABLE_X);
  n = slab_shape(out, n, -330, 185, -210, 260, 22, SLAB_KIND_PLANT, SLAB_GABLE_X);
  n = slab_shape(out, n, -200, 190, -95, 255, 18, SLAB_KIND_PLANT, SLAB_GABLE_X);
  n = slab_mass(out, n, -372, -60, -300, 140, 36, SLAB_KIND_PLANT);
  n = slab_mass(out, n, -290, -30, -232, 95, 26, SLAB_KIND_INDUSTRY);
  n = slab_mass(out, n, -470, -270, -345, -120, 28, SLAB_KIND_INDUSTRY);
  n = slab_mass(out, n, -480, -105, -455, -70, 14, SLAB_KIND_DESAL);
  for i: 0..<STACKS { n = slab_drum(out, n, STACK_X[i], STACK_Z[i], ifx STACK_H[i] > 90 then 5.5f32 else 4.5f32, STACK_H[i], SLAB_KIND_STACK); }
  // the moonpools and the cold-water pipes: 6.7 m wide, from the keel to 1,000 m down (spec 6.1)
  for i: 0..<4 {
    z := -225.0f32 + f32(i) * 150;
    n = slab_put(out, n, -395, SLAB_DECK - 0.5f32, z - 6, -383, SLAB_DECK + 0.05f32, z + 6, SLAB_KIND_POOL, SLAB_CYLINDER);
  }
  for i: 0..<4 {
    z := -225.0f32 + f32(i) * 150;
    n = slab_put(out, n, -389 - SLAB_PIPE_RADIUS, keel - SLAB_PIPE_LENGTH, z - SLAB_PIPE_RADIUS, -389 + SLAB_PIPE_RADIUS, keel, z + SLAB_PIPE_RADIUS, SLAB_KIND_PIPE, SLAB_CYLINDER);
  }
  for i: 0..<4 { n = slab_drum(out, n, ifx i < 2 then -320.0f32 else -290.0f32, -255.0f32 + f32(i % 2) * 30, 11, 18, SLAB_KIND_TANK); }
  // Classical halls between the turbine halls and the towers.
  n = slab_shape(out, n, -300, 110, -205, 165, 16, SLAB_KIND_COLONNADE, SLAB_TEMPLE);
  n = slab_shape(out, n, -190, 110, -90, 165, 18, SLAB_KIND_COLONNADE, SLAB_TEMPLE);
  // The towers: glass, 85 to 205 m, the tall ones stepped back for their top fifth.
  for i: 0..<TOWERS {
    x := TOWER_X[i]; z := TOWER_Z[i]; w := TOWER_HX[i]; h := TOWER_HZ[i]; top := TOWER_HEIGHTS[i];
    if top >= 150 {
      base := top * 0.8f32;
      n = slab_mass(out, n, x - w, z - h, x + w, z + h, base, SLAB_KIND_TOWER);
      n = slab_put(out, n, x - w * 0.7f32, SLAB_DECK + base, z - h * 0.7f32, x + w * 0.7f32, SLAB_DECK + top, z + h * 0.7f32, SLAB_KIND_TOWER, SLAB_BOX);
    } else {
      n = slab_mass(out, n, x - w, z - h, x + w, z + h, top, SLAB_KIND_TOWER);
    }
  }
  // The temple fronts along the canal's south bank, pediments to the water.
  for i: 0..<5 {
    x0 := -60.0f32 + f32(i) * 54;
    n = slab_shape(out, n, x0, 58, x0 + 42, 115, 24.0f32 + f32(i % 2) * 4, SLAB_KIND_COLONNADE, SLAB_TEMPLE);
  }
  // The canal, X -70 to 205, a row of cypresses on each bank.
  n = slab_put(out, n, -70, SLAB_DECK - 1.5f32, 140, 205, SLAB_DECK + 0.05f32, 162, SLAB_KIND_POOL, SLAB_BOX);
  n = slab_shape(out, n, -70, 126, 205, 132.5f32, 12, SLAB_KIND_GROVE, SLAB_GROVE);
  n = slab_shape(out, n, -70, 168, 205, 174.5f32, 12, SLAB_KIND_GROVE, SLAB_GROVE);
  // The rotunda at the canal's west end: a drum under a dome, its portico to the east.
  n = slab_drum(out, n, -45, 215, 22, 20, SLAB_KIND_CIVIC);
  n = slab_dome(out, n, -45, 215, 22, 20, SLAB_KIND_CIVIC);
  n = slab_shape(out, n, -26, 201, 8, 229, 19, SLAB_KIND_TEMPLE, SLAB_TEMPLE);
  // The parterre between the canal and the north edge, and its pool.
  n = slab_shape(out, n, 20, 186, 122, 272, 12, SLAB_KIND_GROVE, SLAB_GLADE_GROVE);
  n = slab_shape(out, n, 132, 186, 228, 272, 12, SLAB_KIND_GROVE, SLAB_GLADE_GROVE);
  n = slab_put(out, n, 40, SLAB_DECK - 1.0f32, 250, 102, SLAB_DECK + 0.05f32, 264, SLAB_KIND_POOL, SLAB_BOX);
  // The temple garden, X 230 to 475: the great temple, two smaller ones and a tholos in cypress
  // groves, and the round fountain plaza by the north edge with its column.
  n = slab_shape(out, n, 232, -150, 470, -12, 13, SLAB_KIND_GROVE, SLAB_GLADE_GROVE);
  n = slab_shape(out, n, 232, -8, 268, 100, 13, SLAB_KIND_GROVE, SLAB_GROVE);
  n = slab_shape(out, n, 412, 104, 472, 180, 13, SLAB_KIND_GROVE, SLAB_GROVE);
  n = slab_shape(out, n, 232, 108, 318, 180, 13, SLAB_KIND_GROVE, SLAB_GLADE_GROVE);
  n = slab_shape(out, n, 232, 190, 335, 272, 13, SLAB_KIND_GROVE, SLAB_GROVE);
  n = slab_shape(out, n, 430, 190, 472, 272, 13, SLAB_KIND_GROVE, SLAB_GROVE);
  n = slab_shape(out, n, 366, 10, 404, 74, 24, SLAB_KIND_TEMPLE, SLAB_TEMPLE);
  n = slab_shape(out, n, 322, 58, 348, 94, 17, SLAB_KIND_TEMPLE, SLAB_TEMPLE);
  n = slab_shape(out, n, 275, 20, 297, 52, 14, SLAB_KIND_TEMPLE, SLAB_TEMPLE);
  n = slab_shape(out, n, 423, 78, 441, 96, 14, SLAB_KIND_TEMPLE, SLAB_THOLOS);
  n = slab_drum(out, n, 382, 225, 40, 0.25f32, SLAB_KIND_PLAZA);
  n = slab_drum(out, n, 382, 225, 14, 0.7f32, SLAB_KIND_POOL);
  n = slab_drum(out, n, 382, 225, 1.6f32, 24, SLAB_KIND_FOUNTAIN);
  // The east end's south side: data halls with their chimneys, cooling, desalination tanks, the
  // hospital, the miners' containers, and a colonnaded hall on the east edge.
  n = slab_mass(out, n, 40, -270, 110, -200, 26, SLAB_KIND_DATA);
  n = slab_mass(out, n, 120, -262, 190, -196, 32, SLAB_KIND_DATA);
  n = slab_drum(out, n, 62, -186, 3, 44, SLAB_KIND_INDUSTRY);
  n = slab_drum(out, n, 158, -184, 3, 40, SLAB_KIND_INDUSTRY);
  n = slab_mass(out, n, 200, -232, 250, -205, 6, SLAB_KIND_COOLING);
  n = slab_drum(out, n, 222, -186, 9, 24, SLAB_KIND_TANK);
  n = slab_drum(out, n, 246, -176, 7, 28, SLAB_KIND_TANK);
  n = slab_mass(out, n, 262, -240, 335, -170, 18, SLAB_KIND_MEDICAL);
  for row: 0..<5 {
    z := -280.0f32 + f32(row) * 9;
    n = slab_put(out, n, 160, SLAB_DECK, z, 296, SLAB_DECK + 2.9f32, z + 2.4f32, SLAB_KIND_CONTAINERS, SLAB_BOX);
  }
  n = slab_shape(out, n, 348, -268, 468, -172, 22, SLAB_KIND_COLONNADE, SLAB_TEMPLE);
  // The concept image's statues: rows along the canal's banks, round the parterres and the
  // fountain plaza, on the temple garden's walk, and along the north and east promenades.
  n = slab_statues(out, n, -70, 134, 205, 168);
  n = slab_statues(out, n, 20, 180, 228, 278);
  n = slab_statues(out, n, 342, 185, 422, 265);
  n = slab_statues(out, n, 318, 100, 412, 140);
  n = slab_statues(out, n, -90, 286, 490, 296);
  n = slab_statues(out, n, 486, -290, 496, 290);
  return n;
}

// Whether a record lies inside the hull's plan (the cranes' booms may overhang the dock edge by 10 m).
slab_inside :: (out: [] f32, i: int) -> bool {
  at := i * SLAB_RECORD;
  reach := ifx cast(int) out[at + 3] == SLAB_KIND_CRANE then 10.0f32 else 0.0f32;
  return out[at] >= -SLAB_LENGTH / 2 && out[at + 4] <= SLAB_LENGTH / 2 && out[at + 2] >= -SLAB_BEAM / 2 - reach && out[at + 6] <= SLAB_BEAM / 2;
}

// Groups the records ten at a time after the hull's pieces (the hull is one group of its own):
// a group's box bounds its records, so the tracer tests a district once. Returns the group count.
slab_groups :: (records: [] f32, n: int, out: [] f32) -> int {
  g := 0; first := 0;
  while first < n && g < SLAB_MAX_GROUPS && (g + 1) * SLAB_GROUP_FLOATS <= out.count {
    count := ifx first == 0 then SLAB_HULL_PIECES else SLAB_GROUP;
    if first + count > n { count = n - first; }
    lo := [3] f32.[1e9, 1e9, 1e9]; hi := [3] f32.[-1e9, -1e9, -1e9];
    for i: first..<first + count {
      at := i * SLAB_RECORD;
      for a: 0..<3 {
        if records[at + a] < lo[a] { lo[a] = records[at + a]; }
        if records[at + 4 + a] > hi[a] { hi[a] = records[at + 4 + a]; }
      }
    }
    o := g * SLAB_GROUP_FLOATS;
    out[o] = lo[0] - 0.5f32; out[o + 1] = lo[1] - 0.5f32; out[o + 2] = lo[2] - 0.5f32; out[o + 3] = f32(first);
    out[o + 4] = hi[0] + 0.5f32; out[o + 5] = hi[1] + 0.5f32; out[o + 6] = hi[2] + 0.5f32; out[o + 7] = f32(count);
    g += 1; first += count;
  }
  return g;
}

// A grove's tree in cell (cx, cz) of SLAB_TREE_CELL: whether it stands, and its place and size.
// The shader (slab.wgsl slab_tree) makes the same trees from the same hash (render_noise2, bit
// for bit on both sides), so the walk's collisions and the picture agree.
SlabTree :: struct { stands: bool; x: f32; z: f32; radius: f32; height: f32; }
slab_hash :: (x: f32, z: f32) -> f32 { return render_noise2(x, z); }
slab_tree :: (cx: f32, cz: f32) -> SlabTree {
  a := slab_hash(cx, cz); b := slab_hash(cx + 17.0f32, cz - 9.0f32); c := slab_hash(cx - 31.0f32, cz + 5.0f32);
  return SlabTree.{stands = a > 0.4f32,
    x = (cx + 0.5f32) * SLAB_TREE_CELL + (b - 0.5f32) * 2.2f32,
    z = (cz + 0.5f32) * SLAB_TREE_CELL + (c - 0.5f32) * 2.2f32,
    radius = 1.5f32 + 0.8f32 * b, height = 7.0f32 + 6.0f32 * c};
}

#test "SLAB's plan fits its table and its hull" {
  boxes: [SLAB_MAX_BOXES * SLAB_RECORD] f32;
  n := slab_plan(boxes[..]);
  #assert n > SLAB_HULL_PIECES && n < SLAB_MAX_BOXES;
  for i: 0..<n {
    at := i * SLAB_RECORD;
    #assert boxes[at] < boxes[at + 4] && boxes[at + 1] < boxes[at + 5] && boxes[at + 2] < boxes[at + 6];
    #assert slab_inside(boxes[..], i);
    #assert cast(int) boxes[at + 3] < SLAB_KINDS && cast(int) boxes[at + 7] <= SLAB_STATUES;   // the plan has no domes or bridges
  }
  // the hull spans keel to deck: 143 m deep, 25 m draft, 118 m of wall as the image draws it; the
  // watertight hull under it tops out 25 m over the water (hull.coax)
  #assert boxes[1] == -25 && boxes[5] == 118 && SLAB_HULL_TOP == 25;
  #assert f64(boxes[5] - boxes[1]) == hull_prime().deck && f64(boxes[5]) == hull_ledger(hull_prime()).deck_height;
  // the tallest tower is 205 m over the deck; eight stacks of 70-95 m (the concept image's)
  tallest := 0.0f32; stacks := 0;
  for i: SLAB_HULL_PIECES..<n {
    at := i * SLAB_RECORD;
    if boxes[at + 5] - SLAB_DECK > tallest { tallest = boxes[at + 5] - SLAB_DECK; }
    if cast(int) boxes[at + 3] == SLAB_KIND_STACK { stacks += 1; #assert boxes[at + 5] - SLAB_DECK >= 70 && boxes[at + 5] - SLAB_DECK <= 95; }
  }
  #assert tallest == 205 && stacks == 8;
}

#test "SLAB's groups bound every record once" {
  boxes: [SLAB_MAX_BOXES * SLAB_RECORD] f32;
  groups: [SLAB_MAX_GROUPS * SLAB_GROUP_FLOATS] f32;
  n := slab_plan(boxes[..]);
  g := slab_groups(boxes[..], n, groups[..]);
  #assert g > 1 && g <= SLAB_MAX_GROUPS;
  covered := 0;
  for k: 0..<g {
    o := k * SLAB_GROUP_FLOATS;
    first := cast(int) groups[o + 3]; count := cast(int) groups[o + 7];
    #assert first == covered;
    for i: first..<first + count {
      at := i * SLAB_RECORD;
      for a: 0..<3 { #assert boxes[at + a] >= groups[o + a] && boxes[at + 4 + a] <= groups[o + 4 + a]; }
    }
    covered += count;
  }
  #assert covered == n;
}

#test "A grove's trees stay inside their cells" {
  for cx: -5..<5 { for cz: -5..<5 {
    t := slab_tree(f32(cx), f32(cz));
    #assert t.x - t.radius > f32(cx) * SLAB_TREE_CELL - 0.01f32 && t.x + t.radius < f32(cx + 1) * SLAB_TREE_CELL + 0.01f32;
    #assert t.z - t.radius > f32(cz) * SLAB_TREE_CELL - 0.01f32 && t.z + t.radius < f32(cz + 1) * SLAB_TREE_CELL + 0.01f32;
    #assert t.height >= 7 && t.height <= 13;
  } }
}

#test "Every statue stands on open deck: not in water, a building or a grove" {
  boxes: [SLAB_MAX_BOXES * SLAB_RECORD] f32;
  n := slab_plan(boxes[..]);
  rows := 0; statues := 0;
  for i: SLAB_HULL_PIECES..<n {
    at := i * SLAB_RECORD;
    if cast(int) boxes[at + 7] != SLAB_STATUES { continue; }
    rows += 1;
    x0 := boxes[at]; z0 := boxes[at + 2]; x1 := boxes[at + 4]; z1 := boxes[at + 6];
    along_x := x1 - x0 >= z1 - z0;
    la := ifx along_x then x0 else z0; ha := ifx along_x then x1 else z1;
    count := cast(int) floor((ha - la) / SLAB_STATUE_GAP);
    for k: 0..<count {
      c := la + SLAB_STATUE_GAP * (f32(k) + 0.5f32);
      for side: 0..<2 {
        across := ifx side == 0 then (ifx along_x then z0 else x0) + 1.5f32 else (ifx along_x then z1 else x1) - 1.5f32;
        x := ifx along_x then c else across; z := ifx along_x then across else c;
        #assert slab_statue_near(x0, z0, x1, z1, x, z, 0);
        statues += 1;
        for j: SLAB_HULL_PIECES..<n {
          bt := j * SLAB_RECORD;
          kind := cast(int) boxes[bt + 3];
          if j == i || kind == SLAB_KIND_PLAZA || kind == SLAB_KIND_STATUE { continue; }
          #assert !(x + 0.8f32 > boxes[bt] && x - 0.8f32 < boxes[bt + 4] && z + 0.8f32 > boxes[bt + 2] && z - 0.8f32 < boxes[bt + 6]);
        }
      }
    }
  }
  #assert rows == 6 && statues > 200;
}

#test "A bridge record gives back its two seats as the shader decodes them" {
  out: [4 * SLAB_RECORD] f32;
  seats := [4] [6] f32.[[6] f32.[10, 5, 20, -30, 2, -40], [6] f32.[-30, 2, 20, 10, 5, -40], [6] f32.[0, 1, 0, 70, 3, 5], [6] f32.[70, 3, 5, 0, 1, 0]];
  for k: 0..<4 {
    q := seats[k];
    n := slab_bridge(out[..], k, q[0], q[1], q[2], q[3], q[4], q[5]);
    #assert n == k + 1;
    at := k * SLAB_RECORD; sh := cast(int) out[at + 7] - SLAB_BRIDGE;
    #assert sh >= 0 && sh <= 3 && cast(int) out[at + 3] == SLAB_KIND_BRIDGE;
    m := SLAB_BRIDGE_HALF + 0.5f32;
    ax := ifx sh & 1 == 1 then out[at + 4] - m else out[at] + m;
    az := ifx sh & 2 == 2 then out[at + 6] - m else out[at + 2] + m;
    ay := out[at + 5] - SLAB_BRIDGE_DEPTH;
    bx := out[at] + out[at + 4] - ax; bz := out[at + 2] + out[at + 6] - az; by := out[at + 1] + SLAB_BRIDGE_DEPTH;
    // the higher seat comes back as a
    hi_first := q[1] >= q[4];
    ex := ifx hi_first then q[0] else q[3]; ez := ifx hi_first then q[2] else q[5];
    fx := ifx hi_first then q[3] else q[0]; fz := ifx hi_first then q[5] else q[2];
    #assert abs(ax - ex) < 0.001 && abs(az - ez) < 0.001 && abs(bx - fx) < 0.001 && abs(bz - fz) < 0.001;
    #assert abs(ay - hi_f32p(q[1], q[4])) < 0.001 && abs(by - lo_f32p(q[1], q[4])) < 0.001;
  }
  n := slab_silone(out[..], 0, 0, 0, 0);
  #assert n == 1 && out[1] == -12 && out[5] == 44 && abs(out[4] - 60.96f32) < 0.001;
}
