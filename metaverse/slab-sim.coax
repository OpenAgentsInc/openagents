// SLAB's simulation (docs/research/ocean/slab-world-spec.md, sections 3.1, 4, 5 and 6): the
// sites and sea states, the sun over a site, the hull's motion on the waves and its moorings, and
// the power systems on board (OTEC, the nuclear option, the data halls, desalination, industry,
// the hotel load and the bitcoin miners) with the dispatcher that sheds them. No platform effects:
// the SLAB Simulation realm (apps/openagents-web/slab.coax) steps it and draws what it says.
//
// The hull is the `prime` monolith, a rigid body in heave, roll and pitch, plus surge and sway on
// its moorings. Its size, mass and centre of gravity come from metaverse/hull.coax's ledger. Buoyancy comes from columns: the sea's height at each column's centre, a 25 m
// grid under the hull (960 columns), summed into a force and two moments (spec 4.1, linearised
// about the design draft), with added mass and radiation damping at zeta = 0.08 (spec 4.2). Wind,
// current and sixteen taut mooring lines hold it in the horizontal (spec 4.3, 4.4).
// Units: metres, seconds, kilograms, newtons; MW and degrees C in the systems.
//   coax/bin/coax test metaverse/slab-sim.coax

#load "../metaverse-engine/core/angle.coax";
#load "hull.coax";

SIM_PI :: 3.14159265358979;
sim_max :: (a: f64, b: f64) -> f64 { return ifx a > b then a else b; }
sim_min :: (a: f64, b: f64) -> f64 { return ifx a < b then a else b; }
sim_atan2 :: (y: f64, x: f64) -> f64 { return f64(angle_atan2(f32(y), f32(x))); }
sim_clamp :: (a: f64, lo: f64, hi: f64) -> f64 { return sim_min(hi, sim_max(lo, a)); }
SIM_RHO :: HULL_SEA;       // sea water, kg/m^3
SIM_G :: HULL_G;
SIM_RHO_AIR :: 1.225;

// ---------------------------------------------------------------- sites and sea states (spec 5)
SITE_GUAM :: 0; SITE_PUERTO_RICO :: 1; SITE_KONA :: 2; SITE_EQUATOR :: 3; SITE_CALIFORNIA :: 4;
SITE_TEXAS :: 5; SITE_FJORD :: 6;   // where the timelapse builds it, and where a hull this deep could be joined
SITES :: 7;
SimSite :: struct {
  key: string; name: string;
  latitude: f64;            // degrees north
  surface_min: f64; surface_max: f64;   // surface water over the year, degrees C
  sourced: bool;            // the range is sourced (else a planning value)
  sea: int;                 // the default sea state
  storms: string;
  depth: f64 = 1500.0;      // the water under it, m (NOAA ETOPO1 at the place: metaverse/slab-where.coax)
}
sim_site :: (i: int) -> SimSite {
  if i == SITE_PUERTO_RICO { return SimSite.{key = "puerto-rico", name = "PUERTO RICO, OFF YABUCOA", latitude = 18.0, surface_min = 26.5, surface_max = 29.0, sea = SEA_TRADE, storms = "HURRICANES, EARTHQUAKES", depth = 1440}; }
  if i == SITE_KONA { return SimSite.{key = "kona", name = "KONA, NELHA", latitude = 19.7, surface_min = 24.0, surface_max = 27.0, sea = SEA_TRADE, storms = "RARE HURRICANES", depth = 1725}; }
  if i == SITE_EQUATOR { return SimSite.{key = "equator", name = "EQUATOR, NEAR BAKER ISLAND", latitude = 0.2, surface_min = 28.0, surface_max = 29.5, sea = SEA_TRADE, storms = "NONE: HURRICANE-FREE BELT", depth = 1448}; }
  if i == SITE_CALIFORNIA { return SimSite.{key = "california", name = "CALIFORNIA, SAN CLEMENTE BASIN", latitude = 32.8, surface_min = 15.2, surface_max = 20.9, sourced = true, sea = SEA_WINTER, storms = "WINTER STORMS", depth = 607}; }
  // the Gulf of Mexico 40 nautical miles off Port Aransas, where the timelapse's tow ends; and Yrkefjorden,
  // where Norway's deep concrete platforms were mated. Surface water: NASA JPL MUR SST monthly means, 2015 to 2024
  if i == SITE_TEXAS { return SimSite.{key = "texas", name = "TEXAS, 40 NM OFF PORT ARANSAS", latitude = 27.55, surface_min = 20.5, surface_max = 29.9, sourced = true, sea = SEA_TRADE, storms = "HURRICANES, JUNE TO NOVEMBER", depth = 89}; }
  if i == SITE_FJORD { return SimSite.{key = "fjord", name = "NORWAY, YRKEFJORDEN", latitude = 59.42, surface_min = 5.2, surface_max = 16.3, sourced = true, sea = SEA_CALM, storms = "SHELTERED: WINTER GALES OUTSIDE", depth = 134}; }
  return SimSite.{key = "guam", name = "GUAM, WEST COAST", latitude = 13.4, surface_min = 27.7, surface_max = 29.2, sourced = true, sea = SEA_TRADE, storms = "TYPHOONS", depth = 1408};
}

SEA_CALM :: 0; SEA_TRADE :: 1; SEA_EQUATOR_MAX :: 2; SEA_WINTER :: 3; SEA_GALE :: 4; SEA_HURRICANE :: 5;
SEAS :: 6;
SimSea :: struct { key: string; name: string; hs: f64; wind: f64; }
// Each sea's wind gives its significant height under Pierson-Moskowitz, Hs = 0.21 U^2 / g.
sim_sea :: (i: int) -> SimSea {
  if i == SEA_CALM { return SimSea.{key = "calm", name = "CALM", hs = 0.5, wind = 4.8}; }
  if i == SEA_EQUATOR_MAX { return SimSea.{key = "equator-max", name = "EQUATOR MAX", hs = 2.8, wind = 11.4}; }
  if i == SEA_WINTER { return SimSea.{key = "winter", name = "WINTER", hs = 4.0, wind = 13.7}; }
  if i == SEA_GALE { return SimSea.{key = "gale", name = "GALE", hs = 10.0, wind = 21.6}; }
  if i == SEA_HURRICANE { return SimSea.{key = "hurricane", name = "HURRICANE", hs = 14.0, wind = 25.6}; }
  return SimSea.{key = "trade", name = "TRADE WIND", hs = 1.5, wind = 8.4};
}

// The surface temperature in month m (0 January to 12), a sine through the site's range,
// coldest in mid February (spec 5.1).
sim_surface :: (s: SimSite, month: f64) -> f64 {
  mid := (s.surface_min + s.surface_max) * 0.5; amp := (s.surface_max - s.surface_min) * 0.5;
  return mid - amp * cos(2.0 * SIM_PI * (month - 1.5) / 12.0);
}
SIM_DEEP :: 5.0;          // deep water at 1,000 m, every site (a planning value)
SIM_COLD_DEPTH :: 1000.0; // the cold-water pipes' intake: a site shallower than this has no cold water to pump

// ---------------------------------------------------------------- the sun
// The sun's direction (x east, y up, z north) at a latitude, on a month (0..12) at an hour (local
// solar time), from the declination and hour angle.
SimSun :: struct { x: f64; y: f64; z: f64; elevation: f64; }
sim_sun :: (latitude: f64, month: f64, hour: f64) -> SimSun {
  day := month * 30.44;
  decl := -23.44 * SIM_PI / 180.0 * cos(2.0 * SIM_PI * (day + 10.0) / 365.0);
  lat := latitude * SIM_PI / 180.0;
  h := (hour - 12.0) * 15.0 * SIM_PI / 180.0;
  e := -cos(decl) * sin(h);
  n := sin(decl) * cos(lat) - cos(decl) * sin(lat) * cos(h);
  u := sin(decl) * sin(lat) + cos(decl) * cos(lat) * cos(h);
  l := sqrt(e * e + n * n + u * u);
  out := SimSun.{x = e / l, y = u / l, z = n / l};
  out.elevation = sim_atan2(out.y, sqrt(sim_max(0, 1 - out.y * out.y)));
  return out;
}

// ---------------------------------------------------------------- power systems (spec 6)
POWER_OTEC :: 0; POWER_NUCLEAR :: 1; POWER_HYBRID :: 2;
SimPlant :: struct {
  power: int;                // POWER_*
  otec_scale: f64 = 1.0;     // ?otec=
  modules: int = 4;          // nuclear modules (?modules=), when the option has them
  refuelling: int;           // modules offline
  pipe_tripped: bool;
  swac: bool;                // seawater cooling of the data halls
  warming: f64 = 0.5;        // cold-pipe warming, degrees C
  halving: bool;
  demo10: bool;              // ?plant=demo10: the report's 10 MW demonstration (spec 6.5)
  jth: f64 = 15.0;           // fleet efficiency, J/TH
  bitcoin: f64 = 65118.0;    // $ (Luxor's 16 November 2026 snapshot)
  network: f64 = 967.0;      // EH/s
  fees: f64 = 0.0229;        // BTC a block
  pool: f64 = 0.02;
  // the tenants' sizes (the picture's unless a visitor changes them: metaverse/slab-whatif.coax)
  data_mw: f64 = SIM_DATA;   // the data halls' load, MW (0: none aboard)
  desal_mw: f64 = SIM_DESAL;
  industry_mw: f64 = SIM_INDUSTRY;
  miners: int = SIM_CONTAINERS;   // mining containers, 1 MW each
}
SimPower :: struct {
  dt: f64;                   // the plant's inlet delta T
  surface: f64;
  otec_gross: f64; otec_parasitic: f64; otec_net: f64;
  nuclear_net: f64; nuclear_gross: f64; modules_on: int;
  supply: f64;               // net power on board
  hotel: f64; data: f64; data_on_backup: bool; desal: f64; industry: f64; mining: f64;
  data_load: f64; fixed: f64;
  containers: int;           // miners running
  hashrate: f64;             // EH/s
  revenue: f64;              // $ / facility MWh
  budget: f64;               // $ / MWh left to pay for power
  shed: bool;                // anything shed (the panel goes amber)
  condenser_flow: f64;       // each module's condenser seawater, m^3/s
  cold_flow: f64;            // OTEC cold water, m^3/s
  cooling_share: f64;        // the data halls' share of the cold flow with seawater cooling
  no_cold: bool;             // the water is too shallow for the cold-water pipes: no OTEC here
  margin: f64;               // demo10: the uncommitted margin, MW
  scale: f64;                // the OTEC plant's scale this ran at
}
SIM_OTEC_GROSS :: 171.4;  SIM_OTEC_PARASITIC :: 51.4;  SIM_OTEC_DT :: 24.0;
SIM_MODULE_GROSS :: 50.0; SIM_MODULE_HOUSE :: 2.0; SIM_MODULE_THERMAL :: 160.0;
SIM_DATA :: 120.0; SIM_DATA_SWAC :: 110.0; SIM_DESAL :: 15.0; SIM_INDUSTRY :: 20.0; SIM_HOTEL :: 8.0;
SIM_CONTAINERS :: 50;
// The 10 MW demonstration's allocation (otec.md section 10): 3 MW of IT at PUE 1.15; utility,
// industry and water; up to 1 MW of curtailable mining; the rest an uncommitted margin.
SIM_DEMO_NET :: 10.0; SIM_DEMO_IT :: 3.45; SIM_DEMO_UTILITY :: 4.0; SIM_DEMO_MINING :: 1.0;

sim_otec_net :: (dt: f64, scale: f64) -> f64 {
  gross := SIM_OTEC_GROSS * scale * (dt / SIM_OTEC_DT) * (dt / SIM_OTEC_DT);
  return sim_max(0, gross - SIM_OTEC_PARASITIC * scale);
}
// Mining revenue in $ per facility MWh (otec.md section 8): R = 6B(S + f)(1 - p) / (e u H).
sim_revenue :: (p: SimPlant) -> f64 {
  subsidy := ifx p.halving then 1.5625 else 3.125;
  return 6.0 * p.bitcoin * (subsidy + p.fees) * (1.0 - p.pool) / (p.jth * 1.05 * p.network);
}
sim_power :: (p: SimPlant, site: SimSite, month: f64) -> SimPower {
  o: SimPower;
  o.surface = sim_surface(site, month);
  o.dt = o.surface - (SIM_DEEP + p.warming);
  o.no_cold = site.depth < SIM_COLD_DEPTH;
  if p.power != POWER_NUCLEAR && !o.no_cold {
    scale := p.otec_scale;
    if p.demo10 {
      // scaled so the plant nets 10 MW at the site's best delta T
      best := site.surface_max - (SIM_DEEP + p.warming);
      full := sim_otec_net(best, 1);
      scale = ifx full > 0 then SIM_DEMO_NET / full else 0;
    }
    o.scale = scale;
    o.otec_gross = SIM_OTEC_GROSS * scale * (o.dt / SIM_OTEC_DT) * (o.dt / SIM_OTEC_DT);
    o.otec_parasitic = SIM_OTEC_PARASITIC * scale;
    o.otec_net = sim_max(0, o.otec_gross - o.otec_parasitic);
    if p.pipe_tripped { o.otec_net *= 0.75; }
    if p.swac { o.otec_net *= 0.99; }
    o.cold_flow = 282.0 * scale * (ifx p.pipe_tripped then 0.75 else 1.0);
  }
  if p.power != POWER_OTEC {
    total := ifx p.power == POWER_HYBRID then 2 else p.modules;
    o.modules_on = total - p.refuelling;
    if o.modules_on < 0 { o.modules_on = 0; }
    o.nuclear_gross = SIM_MODULE_GROSS * f64(o.modules_on);
    o.nuclear_net = (SIM_MODULE_GROSS - SIM_MODULE_HOUSE) * f64(o.modules_on);
    o.condenser_flow = (SIM_MODULE_THERMAL - SIM_MODULE_GROSS) / (4.1 * 10.0);
  }
  o.supply = o.otec_net + o.nuclear_net;
  if p.demo10 {
    // the demonstration's campus: IT first, then utility, industry and water, then the miners;
    // whatever is left is the margin
    left := o.supply;
    o.data_load = SIM_DEMO_IT; o.fixed = SIM_DEMO_IT + SIM_DEMO_UTILITY;
    o.data = sim_min(SIM_DEMO_IT, left); left -= o.data; o.data_on_backup = o.data < SIM_DEMO_IT;
    o.industry = sim_min(SIM_DEMO_UTILITY, sim_max(left, 0)); left -= o.industry;
    o.mining = sim_min(SIM_DEMO_MINING, sim_max(left, 0)); left -= o.mining;
    o.containers = ifx o.mining >= SIM_DEMO_MINING then 1 else 0;
    o.margin = sim_max(left, 0);
    o.shed = o.data_on_backup || o.industry < SIM_DEMO_UTILITY || o.mining < SIM_DEMO_MINING;
    o.hashrate = o.mining / 1.05 / p.jth;
    o.revenue = sim_revenue(p);
    o.budget = o.revenue - 48.27;
    return o;
  }
  o.data_load = (ifx p.swac then SIM_DATA_SWAC else SIM_DATA) * p.data_mw / SIM_DATA;
  o.fixed = SIM_HOTEL + o.data_load + p.desal_mw + p.industry_mw;
  o.cooling_share = ifx p.swac && o.cold_flow > 0 then 2.93 / o.cold_flow else 0;
  // dispatch: the hotel, the data centre (on backup when it can't have all it needs), desalination,
  // industry, then the miners in 1 MW steps
  left := o.supply;
  o.hotel = sim_min(SIM_HOTEL, left); left -= o.hotel;
  // the data centre takes what it can; its batteries and generators carry the rest (spec 6.2)
  o.data = sim_min(o.data_load, sim_max(left, 0)); left -= o.data;
  o.data_on_backup = o.data < o.data_load;
  o.desal = sim_min(p.desal_mw, sim_max(left, 0)); left -= o.desal;
  o.industry = sim_min(p.industry_mw, sim_max(left, 0)); left -= o.industry;
  o.containers = cast(int) floor(sim_max(left, 0));
  if o.containers > p.miners { o.containers = p.miners; }
  o.mining = f64(o.containers);
  o.shed = o.data_on_backup || o.desal < p.desal_mw || o.industry < p.industry_mw || o.containers < p.miners;
  o.hashrate = o.mining / 1.05 / p.jth;   // MW / (J/TH) = TH/s * 1e6, so EH/s
  o.revenue = sim_revenue(p);
  o.budget = o.revenue - 40.27 - 8.0;
  return o;
}
// The power a layout opens on (spec 6.7). The monolith opens on hybrid: the report's 120 MW ocean
// thermal plant with two modules carries every fixed load at Guam all year, so the first reading
// of the panel is a platform that works. The domes are under the hull the modules need, so they
// open on OTEC, with no powership unless one is asked for.
sim_opening_power :: (prime: bool) -> int { return ifx prime then POWER_HYBRID else POWER_OTEC; }
// A fixed load is short: the data halls on backup, or desalination or industry shed. Miners
// below their 50 are not: they are the flexible buyer of what is left (spec 6.3).
sim_fixed_short :: (p: SimPlant, o: SimPower) -> bool {
  if p.demo10 { return o.data_on_backup || o.industry < SIM_DEMO_UTILITY; }
  return o.data_on_backup || o.desal < SIM_DESAL || o.industry < SIM_INDUSTRY;
}

// ---------------------------------------------------------------- the hull (spec 3.1, 4)
// prime's figures are hull.coax's: SIM_D is the watertight hull's depth (the deck stands on the
// upper structure, HULL_PRIME_DECK over the keel), and the centre of gravity is the ledger's.
SIM_L :: HULL_PRIME_L; SIM_B :: HULL_PRIME_B; SIM_T :: HULL_PRIME_DRAFT; SIM_D :: HULL_PRIME_HULL; SIM_CORNER :: HULL_PRIME_CORNER;
SIM_CA_HEAVE :: 1.0; SIM_CA_ROT :: 0.3; SIM_ZETA :: 0.08;
SIM_COLUMN :: 25.0;       // the buoyancy columns' grid
SIM_COLUMNS_X :: 40; SIM_COLUMNS_Z :: 24;
SIM_STEP :: 1.0 / 60.0;   // the hull's fixed step
SIM_LINES :: 16;
SIM_DEPTH :: 1500.0;      // the site's water
SIM_ANCHOR :: 2000.0;     // anchors this far out from the fairleads
SIM_T0 :: 4.0e6; SIM_K1 :: 0.05e6;   // N, N/m
SIM_BREAK :: 40.0e6;
SIM_WAVE_DECAY :: 25.0;    // 1/k of a 160 m wave, m
SIM_CURRENT :: 0.5;       // m/s from the east

SimHull :: struct {
  round: bool;                  // a Silone dome (spec 3.2) rather than the prime monolith
  cx: f64; cz: f64;             // where its anchors' centre sits (a cluster's dome), m
  free: bool;                   // no moorings of its own (a cluster's centre dome)
  push_x: f64; push_z: f64;     // other forces this step (a cluster's bridges), N
  heave: f64; heave_v: f64;     // m over the design draft's waterline, and its rate
  roll: f64; roll_v: f64;       // rad about +X (the north side down)
  pitch: f64; pitch_v: f64;     // rad about +Z (the east end up)
  surge: f64; surge_v: f64;     // m east of the anchors' centre
  sway: f64; sway_v: f64;       // m north
  clock: f64;                   // time not yet stepped
  time: f64;
  tension: f64;                 // the most-loaded line now, N
  wind_force: f64;              // N
  accel: f64;                   // the deck's vertical acceleration at the centre, m/s^2
  trace: [60] f32;              // heave over the last minute, a second a sample
  traced: f64;
  // flooding and ballast (spec 4.5): a holed cell fills through its hole to the outside waterline;
  // the pumps move ballast from the damaged corner to the opposite one to take the heel out
  holed: bool;
  flood: f64;                   // m^3 in the holed cell
  pumping: bool;
  moved: f64;                   // m^3 of ballast pumped from the damaged corner to the opposite one
}
// A hull's shape and what follows from it (spec 3.1, 3.2, 4.2, 4.3).
SimShape :: struct {
  round: bool;
  l: f64; b: f64;               // prime's length and beam, m
  r: f64;                       // the dome's radius, m
  t: f64; d: f64; kg: f64;      // draft, the watertight hull's depth, centre of gravity over the keel
  ca_heave: f64; ca_rot: f64;
  k_roll: f64; k_pitch: f64;    // radii of gyration
  lines: int; anchor: f64; t0: f64; k1: f64;
  windage: f64;                 // the side-on projected height of hull and buildings, m
  cell: f64;                    // the holed compartment's plan area, m^2
  cell_h: f64;                  // and its height over the keel, m
  hole_x: f64; hole_z: f64;     // its centroid
}
SIM_DOME_R :: 60.96;          // 400 ft across
SIM_DOME_CORE :: 15.0;        // the central core's radius
sim_prime_shape :: () -> SimShape {
  return SimShape.{l = SIM_L, b = SIM_B, t = SIM_T, d = SIM_D, kg = hull_ledger(hull_prime()).kg, ca_heave = SIM_CA_HEAVE, ca_rot = SIM_CA_ROT,
    k_roll = 0.35 * SIM_B, k_pitch = 0.29 * SIM_L, lines = 16, anchor = SIM_ANCHOR, t0 = SIM_T0, k1 = SIM_K1, windage = SIM_WINDAGE,
    cell = SIM_CELL * SIM_CELL, cell_h = SIM_D, hole_x = SIM_HOLE_X, hole_z = SIM_HOLE_Z};
}
// One Silone dome: 12 m draft, 4 m of base ring above it, KG 10 m, 8 lines at 45 degrees with a
// quarter of prime's line stiffness. The holed compartment is one of the 8 sectors outside the core
// below the waterline (spec 3.2), the south-west one; its centroid lies 41.5 m out.
sim_dome_shape :: () -> SimShape {
  r := SIM_DOME_R; c := SIM_DOME_CORE;
  cell := SIM_PI * (r * r - c * c) / 8.0;
  half := SIM_PI / 8.0;
  out := 2.0 / 3.0 * (r * r * r - c * c * c) / (r * r - c * c) * sin(half) / half;
  return SimShape.{round = true, l = 2.0 * r, b = 2.0 * r, r = r, t = 12.0, d = 16.0, kg = 10.0, ca_heave = 1.5, ca_rot = 0.3,
    k_roll = 0.45 * r, k_pitch = 0.45 * r, lines = 8, anchor = 1800.0, t0 = SIM_T0 / 4.0, k1 = SIM_K1 / 4.0, windage = 24.0,
    cell = cell, cell_h = 12.0, hole_x = -out * 0.7071067811865476, hole_z = -out * 0.7071067811865476};
}
sim_shape :: (h: SimHull) -> SimShape { return ifx h.round then sim_dome_shape() else sim_prime_shape(); }
// The hull's constants.
sim_awp_of :: (sh: SimShape) -> f64 {
  if sh.round { return SIM_PI * sh.r * sh.r; }
  return sh.l * sh.b - (4.0 - SIM_PI) * SIM_CORNER * SIM_CORNER;
}
sim_mass_of :: (sh: SimShape) -> f64 { return SIM_RHO * sim_awp_of(sh) * sh.t; }
// The metacentric heights: KB + BM - KG (a cylinder's BM is r^2 / 4T, a barge's B^2 / 12T).
sim_gm_t_of :: (sh: SimShape) -> f64 { bm := ifx sh.round then sh.r * sh.r / (4.0 * sh.t) else sh.b * sh.b / (12.0 * sh.t); return sh.t / 2.0 + bm - sh.kg; }
sim_gm_l_of :: (sh: SimShape) -> f64 { bm := ifx sh.round then sh.r * sh.r / (4.0 * sh.t) else sh.l * sh.l / (12.0 * sh.t); return sh.t / 2.0 + bm - sh.kg; }
sim_heave_period_of :: (sh: SimShape) -> f64 { return 2.0 * SIM_PI * sqrt(sim_mass_of(sh) * (1.0 + sh.ca_heave) / (SIM_RHO * SIM_G * sim_awp_of(sh))); }
sim_roll_inertia_of :: (sh: SimShape) -> f64 { return sim_mass_of(sh) * sh.k_roll * sh.k_roll * (1.0 + sh.ca_rot); }
sim_pitch_inertia_of :: (sh: SimShape) -> f64 { return sim_mass_of(sh) * sh.k_pitch * sh.k_pitch * (1.0 + sh.ca_rot); }
sim_roll_period_of :: (sh: SimShape) -> f64 { return 2.0 * SIM_PI * sqrt(sim_roll_inertia_of(sh) / (sim_mass_of(sh) * SIM_G * sim_gm_t_of(sh))); }
sim_pitch_period_of :: (sh: SimShape) -> f64 { return 2.0 * SIM_PI * sqrt(sim_pitch_inertia_of(sh) / (sim_mass_of(sh) * SIM_G * sim_gm_l_of(sh))); }
// prime's, as section 3.1 gives them
sim_awp :: () -> f64 { return sim_awp_of(sim_prime_shape()); }
sim_mass :: () -> f64 { return sim_mass_of(sim_prime_shape()); }
sim_gm_t :: () -> f64 { return sim_gm_t_of(sim_prime_shape()); }
sim_gm_l :: () -> f64 { return sim_gm_l_of(sim_prime_shape()); }
sim_heave_period :: () -> f64 { return sim_heave_period_of(sim_prime_shape()); }
sim_roll_inertia :: () -> f64 { return sim_roll_inertia_of(sim_prime_shape()); }
sim_pitch_inertia :: () -> f64 { return sim_pitch_inertia_of(sim_prime_shape()); }
sim_roll_period :: () -> f64 { return sim_roll_period_of(sim_prime_shape()); }
sim_pitch_period :: () -> f64 { return sim_pitch_period_of(sim_prime_shape()); }

sim_wrap :: (i: int, m: int) -> int { r := i % m; return ifx r < 0 then r + m else r; }
// The sea's height at (x, z) from a wrapped n x n tile of heights over `patch` metres.
sim_sea_at :: (heights: [] f32, n: int, patch: f64, x: f64, z: f64) -> f64 {
  if n <= 0 || heights.count < n * n || patch <= 0 { return 0; }
  qx := x / patch * f64(n) - 0.5; qz := z / patch * f64(n) - 0.5;
  fx := qx - floor(qx); fz := qz - floor(qz);
  ix := cast(int) floor(qx); iz := cast(int) floor(qz);
  m := n;
  a := f64(heights[sim_wrap(iz, m) * m + sim_wrap(ix, m)]); b := f64(heights[sim_wrap(iz, m) * m + sim_wrap(ix + 1, m)]);
  c := f64(heights[sim_wrap(iz + 1, m) * m + sim_wrap(ix, m)]); d := f64(heights[sim_wrap(iz + 1, m) * m + sim_wrap(ix + 1, m)]);
  return (a * (1 - fx) + b * fx) * (1 - fz) + (c * (1 - fx) + d * fx) * fz;
}
// The buoyancy columns (spec 4.1): prime's 25 m grid, or the dome's polar grid of 12 rings by 32
// sectors, each with its own area. (x, z, area) of column i.
SIM_RINGS :: 12; SIM_SECTORS :: 32;
sim_columns :: (sh: SimShape) -> int { return ifx sh.round then SIM_RINGS * SIM_SECTORS else SIM_COLUMNS_X * SIM_COLUMNS_Z; }
sim_column :: (round: bool, rad: f64, i: int) -> [3] f64 {
  if round {
    ring := i / SIM_SECTORS; k := i % SIM_SECTORS;
    r0 := rad * f64(ring) / f64(SIM_RINGS); r1 := rad * f64(ring + 1) / f64(SIM_RINGS);
    a := (f64(k) + 0.5) * 2.0 * SIM_PI / f64(SIM_SECTORS); rm := (r0 + r1) * 0.5;
    return [3] f64.[rm * cos(a), rm * sin(a), SIM_PI * (r1 * r1 - r0 * r0) / f64(SIM_SECTORS)];
  }
  ix := i / SIM_COLUMNS_Z; j := i % SIM_COLUMNS_Z;
  return [3] f64.[-SIM_L / 2.0 + (f64(ix) + 0.5) * SIM_COLUMN, -SIM_B / 2.0 + (f64(j) + 0.5) * SIM_COLUMN, SIM_COLUMN * SIM_COLUMN];
}

// A mooring line's fairlead and anchor. prime: four lines a corner, fanned 30 degrees apart about
// the corner's diagonal, fairleads at the keel's corners. The dome: eight lines 45 degrees apart.
SimLine :: struct { fx: f64; fz: f64; ax: f64; az: f64; rest: f64; }
sim_line_of :: (sh: SimShape, i: int) -> SimLine {
  fx := 0.0; fz := 0.0; a := 0.0;
  if sh.round {
    a = (f64(i) + 0.5) * SIM_PI / 4.0;
    fx = cos(a) * (sh.r - 2.0); fz = sin(a) * (sh.r - 2.0);
  } else {
    corner := i / 4; k := i % 4;
    sx := ifx corner & 1 == 0 then -1.0 else 1.0;
    sz := ifx corner & 2 == 0 then -1.0 else 1.0;
    fx = sx * (sh.l / 2.0 - 12.0); fz = sz * (sh.b / 2.0 - 12.0);
    diag := sim_atan2(sz * sh.b, sx * sh.l);
    a = diag + (f64(k) - 1.5) * 30.0 * SIM_PI / 180.0;
  }
  ax := fx + cos(a) * sh.anchor; az := fz + sin(a) * sh.anchor;
  return SimLine.{fx = fx, fz = fz, ax = ax, az = az, rest = sqrt(sh.anchor * sh.anchor + (SIM_DEPTH - sh.t) * (SIM_DEPTH - sh.t))};
}
sim_line :: (i: int) -> SimLine { return sim_line_of(sim_prime_shape(), i); }
// A line's tension at an extension x beyond its rest length: T0 + k1 x + k3 x^3, the cubic chosen
// so the line reaches its breaking load at 150 m.
sim_tension_of :: (sh: SimShape, x: f64) -> f64 {
  k3 := (SIM_BREAK - sh.t0 - sh.k1 * 150.0) / (150.0 * 150.0 * 150.0);
  e := sim_max(x, -sh.t0 / sh.k1);
  return sim_max(0, sh.t0 + sh.k1 * e + k3 * e * e * e);
}
sim_tension :: (x: f64) -> f64 { return sim_tension_of(sim_prime_shape(), x); }

// The moorings' horizontal force on the hull at an offset (surge, sway), and the peak tension.
SimMooring :: struct { fx: f64; fz: f64; peak: f64; }
sim_mooring_of :: (sh: SimShape, surge: f64, sway: f64) -> SimMooring {
  o: SimMooring;
  for i: 0..<sh.lines {
    l := sim_line_of(sh, i);
    dx := l.ax - (l.fx + surge); dz := l.az - (l.fz + sway); dy := SIM_DEPTH - sh.t;
    span := sqrt(dx * dx + dz * dz + dy * dy);
    t := sim_tension_of(sh, span - l.rest);
    o.fx += t * dx / span; o.fz += t * dz / span;
    if t > o.peak { o.peak = t; }
  }
  return o;
}
sim_mooring :: (surge: f64, sway: f64) -> SimMooring { return sim_mooring_of(sim_prime_shape(), surge, sway); }

// The wind's force on the hull and the buildings over it (spec 4.4), toward (dx, dz).
SIM_WINDAGE :: 85.0;      // m of freeboard and buildings, the side-on projected height
sim_wind_of :: (sh: SimShape, u: f64, dx: f64, dz: f64) -> [2] f64 {
  area := (abs(dz) * sh.l + abs(dx) * sh.b) * sh.windage;
  f := 0.5 * SIM_RHO_AIR * 1.0 * area * u * u;
  return [2] f64.[f * dx, f * dz];
}
sim_wind :: (u: f64, dx: f64, dz: f64) -> [2] f64 { return sim_wind_of(sim_prime_shape(), u, dx, dz); }

// The steady offset under a beam wind of u m/s with no waves (spec 4.4): where the moorings'
// pull meets the wind's force, by bisection.
SimOffset :: struct { offset: f64; tension: f64; force: f64; }
sim_offset :: (u: f64) -> SimOffset {
  f := sim_wind(u, 0, 1)[1];
  lo := 0.0; hi := 300.0;
  for i: 0..<40 {
    mid := (lo + hi) * 0.5;
    if sim_mooring(0, mid).fz + f > 0 { lo = mid; } else { hi = mid; }
  }
  return SimOffset.{offset = lo, tension = sim_mooring(0, lo).peak, force = f};
}
// Cell A1, the south-west corner cell (columns A-T west to east, rows 1-12 south to north).
SIM_CELL :: HULL_PRIME_CELL;
SIM_HOLE_X :: -SIM_L / 2.0 + SIM_CELL / 2.0; SIM_HOLE_Z :: -SIM_B / 2.0 + SIM_CELL / 2.0;
SIM_HOLE_AREA :: 4.0;         // m^2 (spec 4.5)
SIM_PUMPS :: 80.0;            // 8 pumps of 10 m^3/s
// The world runs a flood and the pumps this many times faster than real time, so a holed cell
// fills in about a minute (the 4 m^2 orifice itself takes about 24 minutes).
SIM_FLOOD_LAPSE :: 24.0;
// The flood's and the ballast's water this step: the cell fills by the orifice law
// Q = A sqrt(2 g dh), dh the outside waterline over the water inside.
sim_flood :: (h: SimHull, dt: f64) -> SimHull {
  o := h; sh := sim_shape(h);
  if o.holed {
    inside := o.flood / sh.cell;
    // the outside waterline at the cell, over the keel: the draft less the hull's rise there
    outside := sh.t - (h.heave - h.roll * sh.hole_z + h.pitch * sh.hole_x);
    dh := outside - inside;
    q := ifx dh > 0 then SIM_HOLE_AREA * sqrt(2.0 * SIM_G * dh) else -SIM_HOLE_AREA * sqrt(2.0 * SIM_G * -dh);
    o.flood = sim_clamp(o.flood + q * dt * SIM_FLOOD_LAPSE, 0, sh.cell * sh.cell_h);
  }
  if o.pumping {
    // enough to balance the flood's moments: half its water moved to the opposite corner
    target := o.flood / 2.0;
    step := SIM_PUMPS * dt * SIM_FLOOD_LAPSE;
    o.moved = ifx o.moved < target then sim_min(target, o.moved + step) else sim_max(target, o.moved - step);
  }
  return o;
}
// One fixed step of the hull on a sea of `heights` (cascade 0's tile at this tick), with the wind.
sim_hull_step :: (h0: SimHull, heights: [] f32, n: int, patch: f64, wind: f64, wdx: f64, wdz: f64, dt: f64) -> SimHull {
  h := sim_flood(h0, dt);
  o := h; sh := sim_shape(h);
  m := sim_mass_of(sh); awp := sim_awp_of(sh);
  // column buoyancy: the sea's rise at each column over the hull's own draft change
  // and the wave's horizontal push (Froude-Krylov): the pressure gradient under a sloping surface,
  // over the column's depth with a 160 m wave's decay. A long hull's slopes cancel; a dome's do not.
  force := 0.0; mroll := 0.0; mpitch := 0.0; wave_x := 0.0; wave_z := 0.0;
  deep := SIM_WAVE_DECAY * (1.0 - exp(-sh.t / SIM_WAVE_DECAY));
  if n > 0 { for i: 0..<sim_columns(sh) {
    c := sim_column(sh.round, sh.r, i);
    wx := c[0] + h.cx + h.surge; wz := c[1] + h.cz + h.sway;
    eta := sim_sea_at(heights, n, patch, wx, wz);
    p := SIM_RHO * SIM_G * eta * c[2];
    force += p; mroll -= p * c[1]; mpitch += p * c[0];
    sx := (sim_sea_at(heights, n, patch, wx + 5.0, wz) - sim_sea_at(heights, n, patch, wx - 5.0, wz)) / 10.0;
    sz := (sim_sea_at(heights, n, patch, wx, wz + 5.0) - sim_sea_at(heights, n, patch, wx, wz - 5.0)) / 10.0;
    wave_x -= SIM_RHO * SIM_G * sx * c[2] * deep; wave_z -= SIM_RHO * SIM_G * sz * c[2] * deep;
  } }
  // the floodwater's weight at the holed cell; the moved ballast leaves it and lands opposite
  wf := SIM_RHO * SIM_G * h.flood; wm := SIM_RHO * SIM_G * h.moved;
  force -= wf; mroll += wf * sh.hole_z; mpitch -= wf * sh.hole_x;
  mroll -= 2.0 * wm * sh.hole_z; mpitch += 2.0 * wm * sh.hole_x;
  // heave: buoyancy of the columns' rise, the hydrostatic spring, damping
  kh := SIM_RHO * SIM_G * awp; mh := m * (1.0 + sh.ca_heave);
  ch := 2.0 * SIM_ZETA * sqrt(kh * mh);
  ah := (force - kh * h.heave - ch * h.heave_v) / mh;
  // roll and pitch; the floodwater's mass joins the displacement that rights the hull
  md := m + SIM_RHO * h.flood;
  kr := md * SIM_G * sim_gm_t_of(sh); ir := sim_roll_inertia_of(sh); cr := 2.0 * SIM_ZETA * sqrt(kr * ir);
  kp := md * SIM_G * sim_gm_l_of(sh); ip := sim_pitch_inertia_of(sh); cp := 2.0 * SIM_ZETA * sqrt(kp * ip);
  ar := (mroll - kr * h.roll - cr * h.roll_v) / ir;
  ap := (mpitch - kp * h.pitch - cp * h.pitch_v) / ip;
  // surge and sway: wind, current, moorings, drag on the hull's motion
  w := sim_wind_of(sh, wind, wdx, wdz);
  cur := 0.5 * SIM_RHO * 1.0 * sh.b * sh.t * SIM_CURRENT * SIM_CURRENT;   // from the east, pushing west
  moor: SimMooring;
  if !h.free { moor = sim_mooring_of(sh, h.surge, h.sway); }
  // (the lines are laid symmetrically, so their pulls at rest cancel)
  ms := m * 1.1;
  sx := 0.5 * SIM_RHO * 1.0 * sh.b * sh.t; sz := 0.5 * SIM_RHO * 1.0 * sh.l * sh.t;
  lin := 2.0e7 * m / sim_mass();
  fsx := w[0] - cur + moor.fx + h.push_x + wave_x - sx * h.surge_v * abs(h.surge_v) - lin * h.surge_v;
  fsz := w[1] + moor.fz + h.push_z + wave_z - sz * h.sway_v * abs(h.sway_v) - lin * h.sway_v;
  // semi-implicit Euler
  o.heave_v += ah * dt; o.heave += o.heave_v * dt;
  o.roll_v += ar * dt; o.roll += o.roll_v * dt;
  o.pitch_v += ap * dt; o.pitch += o.pitch_v * dt;
  o.surge_v += fsx / ms * dt; o.surge += o.surge_v * dt;
  o.sway_v += fsz / ms * dt; o.sway += o.sway_v * dt;
  o.tension = moor.peak;
  o.wind_force = sqrt(w[0] * w[0] + w[1] * w[1]);
  o.accel = ah;
  o.time += dt;
  return o;
}
// A frame's time: the fixed steps due (at most 8; a long hitch does not replay seconds).
sim_hull_advance :: (h: SimHull, heights: [] f32, n: int, patch: f64, wind: f64, wdx: f64, wdz: f64, frame: f64) -> SimHull {
  o := h;
  o.clock += sim_max(frame, 0);
  steps := 0;
  while o.clock >= SIM_STEP && steps < 8 {
    clock := o.clock - SIM_STEP;
    o = sim_hull_step(o, heights, n, patch, wind, wdx, wdz, SIM_STEP);
    o.clock = clock; steps += 1;
  }
  if steps == 8 { o.clock = sim_min(o.clock, SIM_STEP); }
  if o.time - o.traced >= 1.0 {
    for i: 0..<59 { o.trace[i] = o.trace[i + 1]; }
    o.trace[59] = f32(o.heave); o.traced = o.time;
  }
  return o;
}

// ---------------------------------------------------------------- the cluster (spec 3.3)
// Seven domes in a hexagon 130 m apart, each its own rigid body; 8 m bridges join neighbours
// (6 spokes from the centre, 6 round the ring), hinged at each end with a sliding joint in the
// middle. The sliding joint takes up length on a soft buffer, with stops at +-1.5 m; across the
// bridge it is stiff. The centre dome has no moorings of its own.
SIM_DOMES :: 7; SIM_BRIDGES :: 12;
SIM_SPACING :: 130.0;
SIM_SLIDE :: 1.5;             // the sliding joint's travel each way, m
SIM_BRIDGE_AXIAL :: 2.0e6; SIM_BRIDGE_STOP :: 2.0e8; SIM_BRIDGE_ACROSS :: 5.0e7;   // N/m
SIM_BRIDGE_DAMP :: 2.0e7;     // N s/m
SimCluster :: struct {
  domes: [7] SimHull;
  slide: [12] f64;              // each bridge's sliding joint now, m (+ longer)
  hinge: [12] f64;              // each bridge's tilt now, rad
  most_slide: f64; most_hinge: f64;
  clock: f64;
}
sim_dome_at :: (i: int) -> [2] f64 {
  if i == 0 { return [2] f64.[0, 0]; }
  a := f64(i - 1) * SIM_PI / 3.0;
  return [2] f64.[cos(a) * SIM_SPACING, sin(a) * SIM_SPACING];
}
sim_bridge :: (i: int) -> [2] int {
  if i < 6 { return [2] int.[0, i + 1]; }
  return [2] int.[i - 5, ifx i == 11 then 1 else i - 4];
}
sim_cluster_new :: () -> SimCluster {
  c: SimCluster;
  for i: 0..<SIM_DOMES { at := sim_dome_at(i); c.domes[i].round = true; c.domes[i].cx = at[0]; c.domes[i].cz = at[1]; c.domes[i].free = i == 0; }
  return c;
}
// A dome's rim point toward (ux, uz), its plan position and height, with the dome's motion.
// A dome's bridge seat toward (ux, uz): on its rim at deck height, 4 m over the waterline and
// 6 m over its centre of gravity, so roll and pitch swing it sideways as well as up.
SIM_SEAT :: 6.0;
sim_rim :: (h: SimHull, ux: f64, uz: f64) -> [3] f64 {
  x := ux * SIM_DOME_R; z := uz * SIM_DOME_R;
  return [3] f64.[h.cx + h.surge + x - h.pitch * SIM_SEAT, 4.0 + h.heave - h.roll * z + h.pitch * x, h.cz + h.sway + z + h.roll * SIM_SEAT];
}
sim_cluster_step :: (c0: SimCluster, heights: [] f32, n: int, patch: f64, wind: f64, wdx: f64, wdz: f64, dt: f64) -> SimCluster {
  c := c0;
  for i: 0..<SIM_DOMES { c.domes[i].push_x = 0; c.domes[i].push_z = 0; }
  for k: 0..<SIM_BRIDGES {
    ab := sim_bridge(k); a := c.domes[ab[0]]; b := c.domes[ab[1]];
    ux := b.cx - a.cx; uz := b.cz - a.cz; ul := sqrt(ux * ux + uz * uz); ux /= ul; uz /= ul;
    pa := sim_rim(a, ux, uz); pb := sim_rim(b, -ux, -uz);
    gap := SIM_SPACING - 2.0 * SIM_DOME_R;
    dx := pb[0] - pa[0]; dy := pb[1] - pa[1]; dz := pb[2] - pa[2];
    // the sliding joint takes up the bridge's whole length change, the tilt's included
    along := sqrt(dx * dx + dy * dy + dz * dz) - gap;
    across := -dx * uz + dz * ux;
    va := (b.surge_v - a.surge_v) * ux + (b.sway_v - a.sway_v) * uz;
    vc := -(b.surge_v - a.surge_v) * uz + (b.sway_v - a.sway_v) * ux;
    over := sim_max(abs(along) - SIM_SLIDE, 0) * (ifx along > 0 then 1.0 else -1.0);
    fa := SIM_BRIDGE_AXIAL * along + SIM_BRIDGE_STOP * over + SIM_BRIDGE_DAMP * va;
    fc := SIM_BRIDGE_ACROSS * across + SIM_BRIDGE_DAMP * vc;
    fx := fa * ux - fc * uz; fz := fa * uz + fc * ux;
    c.domes[ab[0]].push_x += fx; c.domes[ab[0]].push_z += fz;
    c.domes[ab[1]].push_x -= fx; c.domes[ab[1]].push_z -= fz;
    c.slide[k] = along;
    c.hinge[k] = sim_atan2(dy, gap);
    c.most_slide = sim_max(c.most_slide, abs(along));
    c.most_hinge = sim_max(c.most_hinge, abs(c.hinge[k]));
  }
  for i: 0..<SIM_DOMES { c.domes[i] = sim_hull_step(c.domes[i], heights, n, patch, wind, wdx, wdz, dt); }
  return c;
}
sim_cluster_advance :: (c0: SimCluster, heights: [] f32, n: int, patch: f64, wind: f64, wdx: f64, wdz: f64, frame: f64) -> SimCluster {
  c := c0;
  c.clock += sim_max(frame, 0);
  steps := 0;
  while c.clock >= SIM_STEP && steps < 4 {
    clock := c.clock - SIM_STEP;
    c = sim_cluster_step(c, heights, n, patch, wind, wdx, wdz, SIM_STEP);
    c.clock = clock; steps += 1;
  }
  if steps == 4 { c.clock = sim_min(c.clock, SIM_STEP); }
  return c;
}

// ---------------------------------------------------------------- hull bending (spec 4.6, S7)
// Visual only: the hull stays rigid in the physics. The first free-free beam mode along X,
// phi = (cosh bx + cos bx - sigma (sinh bx + sin bx)) / 2 (1 at the ends), with bL = 4.730, driven
// by the sea's column loads; the rigid terms drop out because the mode is orthogonal to them.
SIM_BEND_BL :: 4.730040745; SIM_BEND_SIGMA :: 0.982502215;
SIM_E :: 35.0e9;              // prestressed concrete, Pa
// The hull girder's second moment about its neutral axis: the 50 m watertight hull's (hull.coax).
sim_section_i :: () -> f64 { return hull_section_i(hull_prime()); }
sim_bend_mode :: (x: f64) -> f64 {
  b := SIM_BEND_BL / SIM_L; t := b * (x + SIM_L / 2.0);
  ch := (exp(t) + exp(-t)) / 2.0; sh := (exp(t) - exp(-t)) / 2.0;
  return (ch + cos(t) - SIM_BEND_SIGMA * (sh + sin(t))) / 2.0;
}
// The mode's amplitude at the ends (m, + the ends up) for the sea under the hull now: the modal
// force over the modal stiffness EI b^4 L / 4, quasi-static (the mode rings far faster than waves).
sim_bending :: (heights: [] f32, n: int, patch: f64, h: SimHull) -> f64 {
  if n <= 0 { return 0; }
  f := 0.0; col := SIM_COLUMN * SIM_COLUMN;
  for i: 0..<SIM_COLUMNS_X {
    x := -SIM_L / 2.0 + (f64(i) + 0.5) * SIM_COLUMN;
    phi := sim_bend_mode(x); row := 0.0;
    for j: 0..<SIM_COLUMNS_Z {
      z := -SIM_B / 2.0 + (f64(j) + 0.5) * SIM_COLUMN;
      row += sim_sea_at(heights, n, patch, x + h.surge, z + h.sway);
    }
    f += SIM_RHO * SIM_G * row * col * phi;
  }
  b := SIM_BEND_BL / SIM_L;
  return f / (SIM_E * sim_section_i() * b * b * b * b * SIM_L / 4.0);
}
// ---------------------------------------------------------------- checks (spec section 9)
#test "the hydrostatics match section 3.1 and the hull's ledger" {
  led := hull_ledger(hull_prime()); sh := sim_prime_shape();
  // the body the simulation steps is the ledger's: the same mass, draft, centre of gravity and GM
  #assert abs(sim_mass() - led.mass) < 1.0 && abs(sim_mass() / 1e9 - 15.375) < 0.001;
  #assert sh.t == led.draft && sh.kg == led.kg && sh.d == hull_prime().hull && abs(sim_awp() - hull_awp(hull_prime())) < 1e-6;
  #assert abs(sim_gm_t() - led.gm_t) < 1e-9 && abs(sim_gm_l() - led.gm_l) < 1e-9;
  #assert abs(sim_gm_t() - 1159.0) < 0.5 && abs(sim_gm_l() - 3292.3) < 0.5;   // KG 53.5 m
  #assert abs(sim_heave_period() - 14.2) < 0.1;               // C_a = 1
  #assert abs(sim_heave_period() - hull_heave_period(hull_prime(), led, SIM_CA_HEAVE)) < 1e-9;
  // section 3.1's periods are without added inertia; the body rings with it (C_a 0.3)
  #assert abs(sim_roll_period() / sqrt(1.0 + SIM_CA_ROT) - 12.4) < 0.1 && abs(sim_pitch_period() / sqrt(1.0 + SIM_CA_ROT) - 10.1) < 0.1;
  #assert abs(sim_roll_period() - hull_rock_period(sh.k_roll, led.gm_t, SIM_CA_ROT)) < 1e-9;
}
#test "1: calm equilibrium holds the design draft with no heel or trim" {
  h: SimHull; empty: [1] f32;
  for i: 0..<600 { h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP); }
  #assert abs(h.heave) < 0.25 && abs(h.roll) * 180 / SIM_PI < 0.01 && abs(h.pitch) * 180 / SIM_PI < 0.01;
}
#test "2: heave free decay rings at its period with zeta 0.08" {
  h := SimHull.{heave = 1}; empty: [1] f32;
  last := 1.0; ups := 0; first := 0.0; second := 0.0; peak1 := 0.0; peak2 := 0.0; rising := false;
  for i: 0..<6000 {
    h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP);
    if h.heave_v > 0 && !rising { rising = true; }
    if h.heave_v <= 0 && rising {
      rising = false; ups += 1;
      if ups == 1 { first = h.time; peak1 = h.heave; }
      if ups == 2 { second = h.time; peak2 = h.heave; }
    }
    last = h.heave;
  }
  period := second - first;
  #assert abs(period - sim_heave_period()) < 0.15 * sim_heave_period();
  zeta := log(peak1 / peak2) / (2.0 * SIM_PI);
  #assert abs(zeta - SIM_ZETA) < 0.03;
}
#test "3: roll free decay at section 3's period" {
  h := SimHull.{roll = 0.5 * SIM_PI / 180.0}; empty: [1] f32;
  crossings := 0; t0 := 0.0; t2 := 0.0; prev := h.roll;
  for i: 0..<3000 {
    h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP);
    if (prev > 0) != (h.roll > 0) { crossings += 1; if crossings == 1 { t0 = h.time; } if crossings == 3 { t2 = h.time; } }
    prev = h.roll;
  }
  #assert abs((t2 - t0) - sim_roll_period()) < 0.15 * sim_roll_period();
}
#test "4: the hull averages a short sea away" {
  // a 100 m wave (an 8 s sea) of 1.5 m crest to trough, across the hull
  n := 64; tile: [4096] f32;
  for j: 0..<n { for i: 0..<n { tile[j * n + i] = f32(0.75 * sin(2.0 * SIM_PI * f64(i) / 16.0)); } }
  h: SimHull; most := 0.0;
  for k: 0..<1200 { h = sim_hull_step(h, tile[..], n, 400, 0, 1, 0, SIM_STEP); most = sim_max(most, abs(h.heave)); }
  #assert most < 0.15;   // under 10% of the 1.5 m sea
}
#test "6: a 20 m/s beam wind holds within 5% of depth and under breaking load" {
  o := sim_offset(20);
  #assert abs(o.force / 1e6 - 20.8) < 0.5;
  #assert o.offset < 75 && o.tension < SIM_BREAK;
}
#test "7: the OTEC model matches section 6.1 and the sites their ranges" {
  table := [8] f64.[24, 23, 22, 21, 20, 19, 16, 12];
  want := [8] f64.[120.0, 106.0, 92.6, 79.8, 67.6, 56.0, 24.8, 0];
  for i: 0..<8 { #assert abs(sim_otec_net(table[i], 1) - want[i]) < 0.5; }
  #assert abs(sim_otec_net(20, 1) / 120.0 - 0.563) < 0.002;
  lows := [7] f64.[95, 80, 50, 99, 0, 0, 0]; highs := [7] f64.[116, 113, 86, 120, 0, 0, 0];
  p: SimPlant;
  for s: 0..<SITES {
    lo := 1e9; hi := -1e9;
    for m: 0..<120 { o := sim_power(p, sim_site(s), f64(m) * 0.1); lo = sim_min(lo, o.otec_net); hi = sim_max(hi, o.otec_net); }
    #assert abs(lo - lows[s]) < 1.0 && abs(hi - highs[s]) < 1.0;
  }
  #assert sim_power(p, sim_site(SITE_CALIFORNIA), 1.5).otec_net == 0;
  // California's basin is 607 m deep and the Gulf berth 89 m: no cold water, whatever the surface is.
  // In 1,500 m California's August water would still net only 19 MW
  cal := sim_site(SITE_CALIFORNIA); gulf := sim_power(p, sim_site(SITE_TEXAS), 7.5);
  #assert sim_power(p, cal, 7.5).no_cold && gulf.no_cold && gulf.otec_net == 0 && gulf.cold_flow == 0 && gulf.surface > 29.5;
  cal.depth = 1500;
  #assert abs(sim_power(p, cal, 7.5).otec_net - 19) < 1.0 && !sim_power(p, sim_site(SITE_GUAM), 7.5).no_cold;
}
#test "8: dispatch sheds mining, then industry, then desalination" {
  p: SimPlant;
  o := sim_power(p, sim_site(SITE_GUAM), 1.5);
  #assert o.containers == 0 && o.industry == 0 && o.desal == 0 && o.data_on_backup && o.shed;
  big := p; big.otec_scale = 1.4;
  aug := sim_power(big, sim_site(SITE_GUAM), 7.5);   // 162 MW: the miners go first, then some industry
  #assert aug.data == SIM_DATA && aug.desal == SIM_DESAL && aug.industry < SIM_INDUSTRY && aug.industry > 0 && aug.containers == 0;
  p.otec_scale = 1.75;
  for m: 0..<12 { q := sim_power(p, sim_site(SITE_GUAM), f64(m) + 0.5); #assert q.industry == SIM_INDUSTRY && q.desal == SIM_DESAL && !q.data_on_backup; }
}
#test "8b: a tenant's size is the plant's to set: none aboard asks for nothing, twice as much sheds sooner" {
  p: SimPlant;
  base := sim_power(p, sim_site(SITE_GUAM), 7.5);
  none := p; none.data_mw = 0; none.desal_mw = 0; none.industry_mw = 0; none.miners = 0;
  o := sim_power(none, sim_site(SITE_GUAM), 7.5);
  #assert o.data_load == 0 && o.fixed == SIM_HOTEL && o.data == 0 && o.containers == 0 && !o.shed && !o.data_on_backup;
  big := p; big.data_mw = 240; big.power = POWER_OTEC;
  q := sim_power(big, sim_site(SITE_GUAM), 7.5);
  #assert q.data_load == 240 && q.data_on_backup && q.shed && q.containers == 0;
  half := p; half.miners = 10;
  #assert sim_power(half, sim_site(SITE_GUAM), 7.5).containers <= 10 && base.data_load == SIM_DATA;
}
#test "11: mining revenue and the power budget" {
  p: SimPlant;
  #assert abs(sim_revenue(p) - 79.1) < 0.5 && abs(sim_revenue(p) - 48.27 - 30.7) < 0.5;
  q := p; q.halving = true;
  #assert abs(sim_revenue(q) / sim_revenue(p) - 0.503) < 0.005;
  o := sim_power(SimPlant.{power = POWER_NUCLEAR}, sim_site(SITE_GUAM), 6);
  #assert abs(o.mining / 1.05 / p.jth - 1.84) < 0.05;   // 29 MW of miners: 1.84 EH/s
}
#test "12: a pipe trip cuts OTEC's net by a quarter" {
  p: SimPlant; a := sim_power(p, sim_site(SITE_GUAM), 6); p.pipe_tripped = true; b := sim_power(p, sim_site(SITE_GUAM), 6);
  #assert abs(b.otec_net / a.otec_net - 0.75) < 0.02;
}
#test "13: nuclear dispatch at California, refuelling, and hybrid at Guam" {
  p := SimPlant.{power = POWER_NUCLEAR};
  for m: 0..<12 { o := sim_power(p, sim_site(SITE_CALIFORNIA), f64(m)); #assert o.supply == 192 && o.containers == 29; }
  p.refuelling = 1;
  o := sim_power(p, sim_site(SITE_CALIFORNIA), 1);
  #assert o.supply == 144 && o.containers == 0 && abs(SIM_INDUSTRY - o.industry - 19) < 0.01;
  h := SimPlant.{power = POWER_HYBRID};
  lo := 1e9; hi := -1e9;
  for m: 0..<120 { q := sim_power(h, sim_site(SITE_GUAM), f64(m) * 0.1); lo = sim_min(lo, q.supply); hi = sim_max(hi, q.supply); }
  #assert abs(lo - 191) < 1.0 && abs(hi - 212) < 1.0;
}
#test "the opening power carries every fixed load at Guam all year; ocean thermal power alone does not" {
  #assert sim_opening_power(true) == POWER_HYBRID && sim_opening_power(false) == POWER_OTEC;
  p := SimPlant.{power = sim_opening_power(true)};
  for m: 0..<120 {
    q := sim_power(p, sim_site(SITE_GUAM), f64(m) * 0.1);
    #assert !sim_fixed_short(p, q) && q.industry == SIM_INDUSTRY && q.desal == SIM_DESAL && q.data == SIM_DATA;
    #assert q.containers >= 28 && q.containers < SIM_CONTAINERS && q.shed;   // the miners take what is left: not a fault
  }
  june := sim_power(p, sim_site(SITE_GUAM), 5.5);
  #assert abs(june.supply - 206.5) < 0.5 && june.containers == 43;
  // the lesson, one step away: the same city on the 120 MW plant alone
  p.power = POWER_OTEC;
  alone := sim_power(p, sim_site(SITE_GUAM), 5.5);
  #assert sim_fixed_short(p, alone) && abs(alone.supply - 110.5) < 0.5 && alone.industry == 0 && alone.containers == 0;
  // and where the sea is cold, the modules alone can't carry it either
  p.power = POWER_HYBRID;
  #assert sim_fixed_short(p, sim_power(p, sim_site(SITE_CALIFORNIA), 1.5));
  // the demonstration's own campus is judged by its own loads
  demo := SimPlant.{demo10 = true};
  #assert !sim_fixed_short(demo, sim_power(demo, sim_site(SITE_GUAM), 7.5));
}
#test "the 10 MW demonstration nets 10 MW at its best and keeps a 1.55 MW margin" {
  p := SimPlant.{demo10 = true};
  hi := 0.0; lo := 1e9; best: SimPower;
  for m: 0..<120 { o := sim_power(p, sim_site(SITE_GUAM), f64(m) * 0.1); if o.supply > hi { hi = o.supply; best = o; } lo = sim_min(lo, o.supply); }
  #assert abs(hi - 10.0) < 0.01;
  #assert abs(best.data - 3.45) < 1e-9 && abs(best.industry - 4.0) < 1e-9 && abs(best.mining - 1.0) < 1e-9 && abs(best.margin - 1.55) < 0.01;
  // in the coldest month the margin goes first, then the miners
  cold := sim_power(p, sim_site(SITE_GUAM), 1.5);
  #assert cold.supply < 10 && cold.data == 3.45 && cold.margin < 1.55;
  #assert abs(best.scale - 10.0 / sim_otec_net(sim_site(SITE_GUAM).surface_max - SIM_DEEP - 0.5, 1)) < 1e-9;
}
#test "S7: bending is zero on a flat or level sea and follows a hog" {
  #assert abs(sim_section_i() / 1e6 - 1.04) < 0.01;      // the 50 m watertight hull's girder
  #assert abs(sim_bend_mode(-SIM_L / 2.0) - 1.0) < 1e-6 && abs(sim_bend_mode(SIM_L / 2.0) - 1.0) < 1e-4;
  h: SimHull; n := 8; flat: [64] f32; level: [64] f32;
  for i: 0..<64 { level[i] = 1.5; }
  #assert sim_bending(flat[..], n, 4000, h) == 0 && abs(sim_bending(level[..], n, 4000, h)) < 1e-3;
  // a crest under the middle (a hog): the ends drop
  hog: [64] f32;
  for j: 0..<n { for i: 0..<n { hog[j * n + i] = f32(2.0 * cos(2.0 * SIM_PI * (f64(i) + 0.5) / f64(n))); } }
  #assert sim_bending(hog[..], n, 2000, h) < -0.001;
}
#test "5: holing cell A1 on prime sinks it 0.10 m and heels it 0.06 degrees, and it stays afloat" #steps 2000000000 {
  h := SimHull.{holed = true}; empty: [1] f32;
  for i: 0..<9000 { h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP); }
  // about 64,000 m^3 of water: the cell filled to the outside waterline
  #assert abs(h.flood - 64000.0) < 2000.0;
  #assert abs(-h.heave - 0.10) < 0.03;
  heel := abs(h.roll) * 180.0 / SIM_PI;
  #assert abs(heel - 0.06) < 0.03 && h.heave > -SIM_D + SIM_T;
  // the pumps take the heel and trim back out
  h.pumping = true;
  for i: 0..<9000 { h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP); }
  #assert abs(h.roll) * 180.0 / SIM_PI < 0.005 && abs(h.pitch) * 180.0 / SIM_PI < 0.005;
}
#test "the dome's hydrostatics match section 3.2" {
  sh := sim_dome_shape();
  #assert abs(sim_mass_of(sh) / 1e9 - 0.1436) < 0.002;      // 144,000 t
  #assert abs(sim_gm_t_of(sh) - 73.4) < 0.5;                 // BM 77.4 m, GM about 73 m
  #assert sim_heave_period_of(sh) > 6.9 && sim_heave_period_of(sh) < 12.0;
  // 6.4 s without added mass (section 3.2's figure); the model's Ca 0.3 makes it 7.3 s
  #assert abs(2.0 * SIM_PI * sh.k_roll / sqrt(SIM_G * sim_gm_t_of(sh)) - 6.4) < 0.1;
  #assert abs(sim_roll_period_of(sh) - 7.3) < 0.1;
  #assert abs(sh.cell * sh.t - 16450.0) < 200.0;             // a sector to the waterline
}
#test "1 (dome): calm equilibrium holds the 12 m draft with no heel or trim" {
  h := SimHull.{round = true}; empty: [1] f32;
  for i: 0..<600 { h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP); }
  #assert abs(h.heave) < 0.12 && abs(h.roll) * 180 / SIM_PI < 0.01 && abs(h.pitch) * 180 / SIM_PI < 0.01;
}
#test "3 (dome): roll free decay from 3 degrees at section 3.2's period" {
  h := SimHull.{round = true, roll = 3.0 * SIM_PI / 180.0}; empty: [1] f32;
  crossings := 0; t0 := 0.0; t2 := 0.0; prev := h.roll;
  for i: 0..<1500 {
    h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP);
    if (prev > 0) != (h.roll > 0) { crossings += 1; if crossings == 1 { t0 = h.time; } if crossings == 3 { t2 = h.time; } }
    prev = h.roll;
  }
  #assert abs((t2 - t0) - sim_roll_period_of(sim_dome_shape())) < 0.15 * sim_roll_period_of(sim_dome_shape());
  #assert abs((t2 - t0) - 6.4) < 0.15 * 6.4;
}
#test "4 (dome): a dome rides the short sea that prime averages away" {
  n := 64; tile: [4096] f32;
  for j: 0..<n { for i: 0..<n { tile[j * n + i] = f32(0.75 * sin(2.0 * SIM_PI * f64(i) / 16.0)); } }
  p: SimHull; d := SimHull.{round = true}; most_p := 0.0; most_d := 0.0;
  for k: 0..<1200 {
    p = sim_hull_step(p, tile[..], n, 400, 0, 1, 0, SIM_STEP); most_p = sim_max(most_p, abs(p.heave));
    d = sim_hull_step(d, tile[..], n, 400, 0, 1, 0, SIM_STEP); most_d = sim_max(most_d, abs(d.heave));
  }
  #assert most_d > most_p;
}
#test "5 (dome): one flooded sector heels a dome 3.4 degrees and it stays afloat" #steps 2000000000 {
  h := SimHull.{round = true, holed = true}; empty: [1] f32;
  for i: 0..<9000 { h = sim_hull_step(h, empty[..], 0, 1, 0, 1, 0, SIM_STEP); }
  #assert abs(h.flood * SIM_RHO / 1000.0 - 18000.0) < 2500.0;   // about 18,000 t
  heel := sqrt(h.roll * h.roll + h.pitch * h.pitch) * 180.0 / SIM_PI;
  #assert abs(heel - 3.4) < 0.7;
  #assert h.heave > -4.0;                                       // under the 4 m of freeboard
}
#test "S5: in Silone's 5.2 m design wave the cluster's bridges hinge about 45 degrees and slide to their stops" #steps 4000000000 {
  // a 5.2 m crest-to-trough swell 160 m long running east, over the 400 m tile
  n := 64; tile: [4096] f32;
  for j: 0..<n { for i: 0..<n { tile[j * n + i] = f32(2.6 * sin(2.0 * SIM_PI * f64(i) / 25.6)); } }
  c := sim_cluster_new(); tilt := 0.0;
  for k: 0..<900 {
    c = sim_cluster_step(c, tile[..], n, 400, 11.4, 1, 0, SIM_STEP);
    if k == 300 { c.most_slide = 0; c.most_hinge = 0; }
    if k > 300 { for q: 0..<SIM_DOMES { tilt = sim_max(tilt, abs(c.domes[q].pitch) * 180.0 / SIM_PI); } }
  }
  // each dome pitches under 5 degrees, but 5 degrees lifts a rim 5 m and the rims are 8 m apart
  hd := c.most_hinge * 180.0 / SIM_PI;
  #assert tilt < 5.0 && hd > 30.0 && hd < 55.0;
  // the 3D span grows by 2-2.5 m, past the sliding joints' 1.5 m: the stops take the rest
  #assert c.most_slide > SIM_SLIDE && c.most_slide < 2.5;
  // the centre dome, held only by its bridges, stays in the middle
  #assert abs(c.domes[0].surge) < 60.0 && abs(c.domes[0].sway) < 60.0;
}
#test "14: each module's figures" {
  o := sim_power(SimPlant.{power = POWER_NUCLEAR}, sim_site(SITE_GUAM), 0);
  #assert o.nuclear_gross / 4 == 50 && o.nuclear_net / 4 == 48;
  #assert abs(SIM_MODULE_GROSS / SIM_MODULE_THERMAL - 0.3125) < 1e-9 && abs(o.condenser_flow - 2.68) < 0.05;
}
#test "the sun sets in the west-north-west at Guam in June" {
  s := sim_sun(13.4, 5.5, 18.0);
  #assert s.elevation > 0 && s.elevation < 0.3 && s.x < -0.8 && s.z > 0;
  noon := sim_sun(13.4, 5.5, 12.0);
  #assert noon.elevation > 1.3;
}
