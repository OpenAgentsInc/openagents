// The checks of the enemies' attacks (#13552, splice-battle.coax): each attack winds up, locks, strikes and
// recovers; a dodge after the lock works; attacks share a lane; what she sees and hears of a hit or a miss.
// splice-game.coax loads this file with `#load ... #test;`.

// A foe on foot after her, `d` m ahead of her (she faces +Z from the origin of the mine at dusk).
ack_foe :: (g: [] SpGame, i: int, d: f32) {
  g_stage(g, 7); g[0].px = 0; g[0].pz = -20; g[0].yaw = 0;
  g[0].fout[i] = false; g[0].fhp[i] = 3; g[0].fhost[i] = true; g[0].fx[i] = 0; g[0].fz[i] = -20 + d;
}
// Steps foe i's blow for `s` seconds.
ack_blow :: (g: [] SpGame, i: int, s: f32) { for k: 0..<cast(int) (s / 0.02 + 0.5) { g[0].t += 0.02; _ := sb_blow(g, i, dist2(g[0].px, g[0].pz, g[0].fx[i], g[0].fz[i]), false, 0.02); } }

#test "a foe's blow on foot: it winds up following her, locks, strikes only its wedge, and recovers; standing still is a hit" {
  g := [1] SpGame.[SpGame.{}];
  ack_foe(g[..], 5, 1.4);
  hearts := g[0].hearts;
  #assert sb_blow(g[..], 5, 1.4, false, 0.02) && g[0].ak[0].ft[5] > 0;   // it starts its wind-up: no damage yet
  ack_blow(g[..], 5, 0.3); #assert g[0].hearts == hearts && tg_at(SB_BLOW, g[0].ak[0].ft[5]).phase == TG_WIND;
  // she steps to the side while it winds up: it turns to follow her
  g[0].px = 0.6; ack_blow(g[..], 5, 0.2);
  #assert abs(g[0].ak[0].fa[5] - atan2(0.6, -1.4)) < 0.01;
  ack_blow(g[..], 5, 0.5);   // through the lock and the blow
  #assert g[0].hearts == hearts - 1 && g[0].ak[0].cue_t > 0 && g[0].ak[0].cue_hit;
  g[0].px = 5; ack_blow(g[..], 5, 1.0); #assert g[0].ak[0].ft[5] == 0;   // recovered, and she is out of its reach: it stops
}
#test "a dodge after the lock works: the aim stays where it locked, and the miss says DODGED" {
  g := [1] SpGame.[SpGame.{}];
  ack_foe(g[..], 5, 1.4);
  hearts := g[0].hearts;
  _ := sb_blow(g[..], 5, 1.4, false, 0.02);
  ack_blow(g[..], 5, SB_BLOW.wind + 0.05);   // locked now
  aim := g[0].ak[0].fa[5];
  g[0].px = 1.6; ack_blow(g[..], 5, 0.05);    // a quick step to the side
  #assert g[0].ak[0].fa[5] == aim;            // no more tracking
  ack_blow(g[..], 5, 0.4);
  #assert g[0].hearts == hearts && g[0].ak[0].cue_t > 0 && !g[0].ak[0].cue_hit;
}
#test "two foes on her at once never land together: the second's blow waits for a gap after the first" {
  g := [1] SpGame.[SpGame.{}];
  ack_foe(g[..], 5, 1.4); g[0].fout[6] = false; g[0].fhp[6] = 3; g[0].fhost[6] = true; g[0].fx[6] = 1.2; g[0].fz[6] = -19.4;
  #assert sb_blow(g[..], 5, 1.4, false, 0.02);
  #assert !sb_blow(g[..], 6, 1.3, false, 0.02) && g[0].ak[0].ft[6] == 0;
  // the second may start only once its release comes SB_GAP after the first's impact
  first_end := tg_release(SB_BLOW, 0) + SB_BLOW.hit;
  started := -1.0f32;
  for k: 0..<200 { g[0].t += 0.02; _ := sb_blow(g[..], 5, 1.4, false, 0.02); if started < 0 && sb_blow(g[..], 6, 1.3, false, 0.02) { started = cast(f32) (k + 1) * 0.02; } }
  #assert started > 0 && started + tg_release(SB_BLOW, 0) >= first_end + SB_GAP - 0.03;
}
#test "the tail sweep: it locks before it swings, jumping over it is a miss, and it rests after with its tail down" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10); for i: 0..<3 { g[0].stun[i] = 0; }
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  #assert t[0].kind == SBF_BOSS;
  g[0].boss_t = sb_sweep_from() + SB_SWEEP.wind + 0.05;   // locked
  t[0].think = 10; y0 := t[0].dino_yaw; x0 := t[0].dino_x;
  t[0].mech_x += 3; g_step(g[..], 0.02);
  #assert t[0].dino_yaw == y0 && t[0].dino_x == x0;   // locked: it no longer turns to the mech or moves
  // she stands in its half circle, in the air over the tail as it passes: no hit, DODGED at its end
  g[0].ak[0].sweep_aim = true; g[0].ak[0].sweep_hit = false; hearts := g[0].hearts;
  g[0].boss_t = T_SWEEP_EVERY + 0.01;
  #assert !sb_in_arc(t[0].dino_x, t[0].dino_z, sb_arm_angle(g[..]), t[0].dino_x + 50, t[0].dino_z);
  for i: 0..<cast(int) (T_SWEEP_TIME / 0.02) + 2 {
    a := sb_arm_angle(g[..]); g[0].px = t[0].dino_x + sin(a) * 4; g[0].pz = t[0].dino_z + cos(a) * 4;   // where the tail is
    sb_sweep(g[..], t[0].dino_x, t[0].dino_z, 0.0001);   // the arc at her, with her on the ground: hit
    if i == 0 { #assert g[0].hearts == hearts - 1; g[0].hearts = hearts; g[0].hit_cool = 0; g[0].ak[0].sweep_hit = false; }
    g[0].air_x = g[0].px; g[0].air_z = g[0].pz; g[0].air[0].y = 1.0; g[0].air[0].prev_y = 1.0; g[0].air[0].vy = 0; g[0].air[0].on_ground = false;   // and from now on over it
    sb_sweep(g[..], t[0].dino_x, t[0].dino_z, 0.02);
  }
  #assert g[0].hearts == hearts && g[0].ak[0].cue_t > 0 && !g[0].ak[0].cue_hit;
  #assert tg_at(SB_SWEEP, g[0].boss_t - sb_sweep_from()).phase == TG_REST;
}
#test "the charge's lane follows her while it winds up and locks before the rush: stepping out of it after the lock is safe" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10); for i: 0..<3 { g[0].stun[i] = 0; }
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  t[0].half = true; t[0].think = 10; g[0].px = t[0].dino_x + 6; g[0].pz = t[0].dino_z;
  t[0].mech_x = t[0].dino_x - 6; t[0].mech_z = t[0].dino_z - 6;
  t[0].charge_t = SB_CHARGE_EVERY; g[0].ak[0] = SpAttacks.{}; g_step(g[..], 0.02); g_step(g[..], 0.02);
  #assert t[0].wind > 0 && t[0].rush_dx > 0.9;
  g[0].pz = t[0].dino_z + 2; g_step(g[..], 0.02); #assert t[0].rush_dz > 0.1;   // it follows her
  for i: 0..<200 { if t[0].wind <= SB_CHARGE.lock { break; } g_step(g[..], 0.02); }
  dx := t[0].rush_dx; dz := t[0].rush_dz; hearts := g[0].hearts;
  g[0].px = t[0].dino_x; g[0].pz = t[0].dino_z + 5;   // she leaves the lane after it locked
  for i: 0..<200 { g_step(g[..], 0.02); if t[0].daze > 0 { break; } }
  #assert t[0].daze > 0 && g[0].hearts == hearts && abs(t[0].rush_dx - dx) < 0.001 && abs(t[0].rush_dz - dz) < 0.001;
}
// One step of driving toward the drive's garage end at a steady `want` m/s: W tops the speed up, A and D
// hold the heading. `dodge` 1 brakes (S), 2 swerves away from the raider mech, instead of all that.
ak_drive :: (g: [] SpGame, want: f32, dodge: int) {
  d := g[0].dv[0]; t := g[0].bt[0];
  turn := atan2(d.bx - d.sx, d.bz - d.sz) - d.syaw;
  while turn > PI { turn -= TAU; } while turn < -PI { turn += TAU; }
  side := (t.rm_x - d.sx) * cos(d.syaw) - (t.rm_z - d.sz) * sin(d.syaw);   // > 0: the mech is on the side A turns to
  left := ifx dodge == 2 then side < 0 else turn > 0.05;
  right := ifx dodge == 2 then side > 0 else turn < -0.05;
  _ := g_key(g, 'w', dodge != 1 && dv_speed(g) < want); _ = g_key(g, 's', dodge == 1);
  _ = g_key(g, 'a', left); _ = g_key(g, 'd', right);
  g_step(g, 0.02);
}
#test "the raider mech's claws on the drive: two, locked on Sniper's pace and heading; steady driving is a hit, braking with S or swerving away at the lock a miss" #steps 800000000 {
  g := [1] SpGame.[SpGame.{}];
  for k: 0..<3 {
    g[0] = SpGame.{};
    g_reset(g[..]); _ := spw_shipped(g[..]);
    g_begin(g[..]); g[0].have[H_DRILL] = true;
    tr := g_shipped_at(g[..], 123); g[0].px = tr.x + 2.2; g[0].pz = tr.z; _ = g_key(g[..], 'e', true);
    dk := g_shipped_at(g[..], 125); g[0].px = dk.x - 1.2; g[0].pz = dk.z; #assert g_key(g[..], 'e', true) && g[0].mode == M_DRIVE;
    t := g[0].bt[..]; a := g[0].ak[..];
    // she drives off at a steady 8 m/s; the raider mech comes up beside Sniper on the hunt
    for i: 0..<250 { ak_drive(g[..], 8, 0); }
    #assert abs(dv_speed(g[..]) - 8) < 1;
    b := sb_road_beside(g[..], SB_RM_SIDE); t[0].rm_x = b.x; t[0].rm_z = b.z; t[0].rm_hunt = true; t[0].rm_gone = false; t[0].rm_claw = SB_RM_CLAW_EVERY;
    for i: 0..<300 { ak_drive(g[..], 8, 0); if a[0].claw_t >= 0 || g[0].mode != M_DRIVE { break; } }
    #assert a[0].claw_t >= 0 && g[0].mode == M_DRIVE;   // beside Sniper it winds up its first claw
    hp := t[0].bots[SB_SNIPER].vit.hp; dodged := 0; landed := 0;
    for i: 0..<300 {
      ph := tg_at(SB_CLAW, a[0].claw_t).phase;
      cue := a[0].cue_t;
      ak_drive(g[..], 8, ifx ph == TG_LOCK || ph == TG_HIT then k else 0);   // the dodge, just as each claw locks
      if a[0].cue_t > cue { if a[0].cue_hit { landed += 1; } else { dodged += 1; } }
      if a[0].claw_t < 0 { break; }
    }
    if k == 0 { #assert landed == 2 && t[0].bots[SB_SNIPER].vit.hp < hp; }
    if k > 0 { #assert dodged == 2 && t[0].bots[SB_SNIPER].vit.hp == hp; }
  }
}
#test "a foe's card in a bot battle winds up before it lands" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 20);
  t := g[0].bt[..];
  t[0].think = 0; hp := sb_rec(g[..], SB_SNIPER).vit.hp;
  g_step(g[..], 0.02);
  #assert g[0].ak[0].card_t >= 0 && sb_rec(g[..], SB_SNIPER).vit.hp == hp;   // winding up: nothing yet
  for i: 0..<cast(int) (tg_release(SB_CARD, 0) / 0.02) + 2 { g_step(g[..], 0.02); }
  #assert sb_rec(g[..], SB_SNIPER).vit.hp < hp;
}
#test "a wind-up off to her right is heard on the right, and an attack winding up is listed for the screen's edge" {
  g := [1] SpGame.[SpGame.{}]; g[0].snd[0].all_on = true;
  ack_foe(g[..], 5, 1.4); g[0].fx[5] = 1.4; g[0].fz[5] = -20;   // beside her
  _ := sb_blow(g[..], 5, 1.4, false, 0.02);
  o: [256] u8; n := snd_text(g[..], o[..]);
  #assert sck_has(cast(string) o[0..<n], "attack-wind 0.420 -0.");   // +X is her left when she faces +Z: panned left
  xs: [FOES + 2] f32; zs: [FOES + 2] f32;
  #assert sb_threats(g[..], xs[..], zs[..]) == 1 && xs[0] == 1.4;
}
#test "a calm Imperial shows how far it senses her before she commits: the real distance, wider with Heat; raiders show none" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 8);
  i := F_RAIDERS; g[0].fout[i] = false; g[0].fhost[i] = false; g[0].fflee[i] = false; g[0].fpose[i] = 0;
  see := mp_notice(sc_plan(g[0].c[..], i, g_phase(g[..])));
  #assert see > 0;
  r := d_noticed(g[..], see);
  g[0].px = g[0].fx[i] + r + 3; g[0].pz = g[0].fz[i];
  #assert sb_sense_r(g[..], i) == r;
  g[0].heat += 40; #assert sb_sense_r(g[..], i) > r;   // more Heat: it senses her from further
  g[0].px = g[0].fx[i] + 60; #assert sb_sense_r(g[..], i) == 0;   // far off: no ring
  g[0].px = g[0].fx[i] + r; g[0].fhost[i] = true; #assert sb_sense_r(g[..], i) == 0;   // it has seen her: the fight is on
  #assert sb_sense_r(g[..], 0) == 0;   // a raider shows none
}
#test "the sweep clip's spot: standing still the tail finds her; one jump a quarter second before it reaches her clears it; a jump far too early lands in it" #steps 400000000 {
  g := [1] SpGame.[SpGame.{}];
  for k: 0..<3 {
    g[0] = SpGame.{}; g_stage(g[..], 10); sb_sweep_spot(g[..]);
    hearts := g[0].hearts; dodged := false; struck := false; jumped := false; held := 1.0f32;
    lead := ifx k == 1 then 0.6f32 else 1.9f32;   // radians of swing before it reaches her: at about 2.4 rad/s, 0.25 s or 0.8 s
    for i: 0..<500 {
      cue := g[0].ak[0].cue_t; t := g[0].bt[..];
      ph := tg_at(SB_SWEEP, g[0].boss_t - sb_sweep_from()).phase;
      gap := atan2(g[0].px - t[0].dino_x, g[0].pz - t[0].dino_z) - sb_arm_angle(g[..]);
      while gap < 0 { gap += TAU; } while gap > TAU { gap -= TAU; }
      if k > 0 && !jumped && (ph == TG_LOCK || ph == TG_HIT) && gap < lead { jumped = true; held = 0; }
      _ = g_key(g[..], ' ', jumped && held < 0.4); held += 0.02;   // held through the rise (a tap only hops: feel.coax FL_CUT)
      g_step(g[..], 0.02);
      if g[0].ak[0].cue_t > cue { if g[0].ak[0].cue_hit { struck = true; } else { dodged = true; } }
      if ph == TG_REST { break; }
    }
    if k != 1 { #assert struck && g[0].hearts < hearts; }
    if k == 1 { #assert jumped && dodged && !struck && g[0].hearts == hearts; }
  }
}
