// The follow camera's checks (camera.coax, playtest 2). splice-game.coax loads this file with `#load ... #test;`.

// Steps `frames` of 1/60 s and keeps the worst: the largest change in a step of the eye's distance
// from her head or its height over it (a jump), the nearest it came to her head, and whether it was
// ever inside a body.
CcWatch :: struct { jump: f32; near: f32 = 1000; in_body: bool; moved: f32; }
cc_watch :: (g: [] SpGame, frames: int, w: CcWatch) -> CcWatch {
  out := w; c0 := g_camera(g); p0 := cm_pivot(g);
  r0 := length(sub(c0.eye, p0)); y0 := c0.eye.y - p0.y; e0 := c0.eye;
  for i: 0..<frames {
    g_step(g, 1.0f32 / 60);
    c := g_camera(g); p := cm_pivot(g);
    r := length(sub(c.eye, p)); y := c.eye.y - p.y;
    out.jump = hi(out.jump, hi(abs(r - r0), abs(y - y0)));
    out.near = lo(out.near, r);
    out.moved = hi(out.moved, length(sub(c.eye, e0)));
    if cm_body_at(g, c.eye.x, c.eye.y, c.eye.z, 0) { out.in_body = true; }
    r0 = r; y0 = y; e0 = c.eye;
  }
  return out;
}
CC_SLACK :: 0.05f32;   // m: the room is found to a few centimetres
cc_farm :: (g: [] SpGame) { g_reset(g); _ := spw_shipped(g); g_begin(g); }

#test "playtest 2: at the solar farm the camera never moves with no input, and walking and turning among the pieces it eases" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  cc_farm(g[..]);
  w := cc_watch(g[..], 600, CcWatch.{});
  #assert w.moved == 0;   // ten seconds standing: not a hair
  for a: 0..<4 {
    cc_farm(g[..]);
    g[0].yaw = f32(a) * 1.571 + 0.785; g[0].fwd = true; g[0].turn_l = true;
    w = cc_watch(g[..], 240, CcWatch.{});
    // past the panels, the chargers and the rover train: no step jumps a quarter metre, and she never fills the view
    #assert w.jump < 0.25 && w.near >= CM_MIN - CC_SLACK && !w.in_body;
  }
}
#test "playtest 2: while Digger drills the rock wall the camera keeps its distance and does not jump, and over her head with her back to the wall" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); _ := spw_shipped(g[..]); g_stage(g[..], 5);
  for i: 0..<5 { g[0].have[i] = true; }
  for i: 0..<3 { g[0].slot[i] = true; }
  g[0].bot = true; g_bot_home(g[..]);
  g[0].strip[0] = H_MOVE; g[0].strip[1] = H_DRILL; g[0].strip_n = 2;
  g[0].px = 0; g[0].pz = g[0].at.rubble_z + 1.5; g[0].yaw = PI; g_bot_home(g[..]);   // at the wall
  g_deploy(g[..]); w := cc_watch(g[..], 600, CcWatch.{});                            // Digger runs past her and drills
  #assert w.jump < 0.25 && w.near >= CM_MIN - CC_SLACK && !w.in_body;
  // her back to the wall, a step from it: the camera is over her head, not in it
  g[0].yaw = 0; g[0].cam[0].ready = false;
  _ = cc_watch(g[..], 60, CcWatch.{});
  c := g_camera(g[..]); #assert length(sub(c.eye, cm_pivot(g[..]))) >= CM_MIN - CC_SLACK && c.eye.y > cm_pivot(g[..]).y + 2;
}
#test "playtest 2: on the hoverboard the camera is pulled back, and in a tight spot it rises before it comes in" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  cc_farm(g[..]);
  #assert g_board_given(g[..]);
  g_board_key(g[..]); g[0].fwd = true;
  w := cc_watch(g[..], 120, CcWatch.{});
  #assert g_riding(g[..]) && cm_want(g[..]) >= 6.5 + CM_BOARD_BACK && w.near >= CM_MIN - CC_SLACK;   // further back than on foot
  // on the board against the rock wall in the tunnel: never her head filling the view
  g_reset(g[..]); _ = spw_shipped(g[..]); g_stage(g[..], 5); g[0].px = 0; g[0].pz = g[0].at.rubble_z + 1.6;
  g_board_key(g[..]); g[0].turn_l = true;
  w = cc_watch(g[..], 160, CcWatch.{});
  #assert w.near >= CM_MIN - CC_SLACK && !w.in_body;
}
#test "#13552: turning on the spot in the hallway to the lab, the camera stays behind her at CM_MIN or more, under the roof, never over her head" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); _ := spw_shipped(g[..]); g_stage(g[..], 7);
  g[0].px = 0; g[0].pz = g[0].at.gar_z - ga_back(g[..]) - GA_HALL_LONG * 0.5; g[0].yaw = PI * 0.5;
  g[0].cam[0].ready = false; g[0].turn_l = true;
  steep := 0.0f32; w := CcWatch.{};
  for i: 0..<240 {
    w = cc_watch(g[..], 1, w);
    c := g_camera(g[..]); p := cm_pivot(g[..]); r := length(sub(c.eye, p));
    steep = hi(steep, (c.eye.y - p.y) / hi(r, 0.01));
    #assert c.eye.y < CM_HALL_ROOF - CM_CLEAR + CC_SLACK;
  }
  // sideways the walls are 2.3 m off the boom: it rises only as far as CM_MIN needs, well short of overhead
  #assert w.near >= CM_MIN - CC_SLACK && !w.in_body && steep < 0.8;
}
#test "playtest 2: the drill mech is about twice her height, follows at her side clear of her, and the camera is never inside it" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);
  t := g[0].bt[..];
  g[0].px = t[0].mech_x + 2; g[0].pz = t[0].mech_z;
  #assert g_key(g[..], 'e', true) && t[0].mech_core;
  #assert SB_MECH_TOP < T_BOT_TOP * 4 && SB_MECH_TOP > 1.7 * 2;
  for i: 0..<30 { g_step(g[..], 1.0f32 / 60); }   // it steps off her first
  closest := 1000.0f32; w := CcWatch.{};
  for leg: 0..<4 {
    g[0].fwd = true; g[0].turn_l = leg % 2 == 0; g[0].turn_r = leg == 1;
    for i: 0..<45 { w = cc_watch(g[..], 1, w); closest = lo(closest, dist2(t[0].mech_x, t[0].mech_z, g[0].px, g[0].pz)); }
    g[0].fwd = false; g[0].turn_l = false; g[0].turn_r = false;
    for i: 0..<20 { w = cc_watch(g[..], 1, w); closest = lo(closest, dist2(t[0].mech_x, t[0].mech_z, g[0].px, g[0].pz)); }
  }
  #assert closest >= SB_MECH_R + T_RADIUS;
  #assert !w.in_body;
  #assert w.near >= CM_MIN - CC_SLACK;
  // standing, it settles at her left, a stride out from its own side
  for i: 0..<120 { g_step(g[..], 1.0f32 / 30); }
  h := sb_mech_spot(g[..]); #assert dist2(t[0].mech_x, t[0].mech_z, h.x, h.z) < 0.5;
}

#test "#13552: the wheel zooms the camera in to a stop clear of her head and out to half again, and keeps through a reset" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  cc_farm(g[..]); rest := cm_want(g[..]);
  for i: 0..<40 { cm_wheel(g[..], -120); }   // forty notches in
  #assert cm_want(g[..]) == CM_ZOOM_NEAR;
  w := cc_watch(g[..], 120, CcWatch.{});
  #assert w.near >= CM_MIN - CC_SLACK && w.near < CM_ZOOM_NEAR + 0.3 && !w.in_body;   // in close, never in her head
  for i: 0..<40 { cm_wheel(g[..], 120); }
  #assert abs(cm_want(g[..]) - rest * CM_ZOOM_FAR) < 0.01;
  cm_wheel(g[..], -120); z := g[0].zoom; cc_farm(g[..]);
  #assert g[0].zoom == z && g[0].zoom < CM_ZOOM_FAR;   // a respawn keeps it
}
#test "owner's rule: Digger and the drill mech follow at her side, never between the camera and her, as she turns" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7); g[0].px = 0; g[0].pz = -48; g_bot_home(g[..]);
  in_line := 0; frames := 0;
  for leg: 0..<4 {
    g[0].turn_l = leg % 2 == 0; g[0].turn_r = leg % 2 == 1; g[0].fwd = leg >= 2;
    for i: 0..<90 {
      g_step(g[..], 1.0f32 / 60); frames += 1;
      if cm_in_line(cm_line(g[..]), g[0].bot_x, g[0].bot_z, T_BOT_R) { in_line += 1; }
      #assert dist2(g[0].bot_x, g[0].bot_z, g[0].px, g[0].pz) >= T_BOT_R + T_RADIUS;
    }
  }
  #assert in_line * 20 < frames;   // he steps out of the line at once: under a twentieth of the time, while she spins
  // standing, the drill mech a few metres straight behind her steps out to her side
  t := g[0].bt[..]; t[0].mech_core = true; t[0].mech_used = true;
  g[0].turn_l = false; g[0].turn_r = false; g[0].fwd = false;
  t[0].mech_x = g[0].px - sin(g[0].yaw) * 4.5; t[0].mech_z = g[0].pz - cos(g[0].yaw) * 4.5;
  #assert cm_in_line(cm_line(g[..]), t[0].mech_x, t[0].mech_z, SB_MECH_R);
  for i: 0..<120 { g_step(g[..], 1.0f32 / 60); }
  #assert !cm_in_line(cm_line(g[..]), t[0].mech_x, t[0].mech_z, SB_MECH_R) && dist2(t[0].mech_x, t[0].mech_z, g[0].px, g[0].pz) >= SB_MECH_R + T_RADIUS;
}
#test "#13552: in the boss fight the camera frames her and the boss low, never inside its body, its tail or the lab's ceiling" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  for k: 0..<8 {
    for h: 0..<2 {
      g_reset(g[..]); _ := spw_shipped(g[..]); g_stage(g[..], 10); g[0].stun[0] = 100;   // the boss held still
      t := g[0].bt[0]; a := f32(k) * PI * 0.25;
      g[0].px = t.dino_x + sin(a) * 7; g[0].pz = t.dino_z + cos(a) * 7;   // 7 m from it, all round
      g[0].yaw = ifx h == 0 then atan2(t.dino_x - g[0].px, t.dino_z - g[0].pz) else atan2(g[0].px - t.dino_x, g[0].pz - t.dino_z);
      w := cc_watch(g[..], 40, CcWatch.{});
      c := g_camera(g[..]); d := sub(c.at, c.eye); dl := length(d);
      #assert !w.in_body && w.near >= CM_MIN - CC_SLACK && c.eye.y < CM_LAB_ROOF - CM_CLEAR;
      #assert -d.y / dl < 0.3;   // looking down under about 17 degrees, not on top of the fight
      if h == 0 {
        // facing it: she and the boss both near the middle of the view
        bv := sub(v3(t.dino_x, 1.8, t.dino_z), c.eye); hv := sub(v3(g[0].px, cm_feet(g[..]) + 1, g[0].pz), c.eye);
        #assert dot(bv, d) / (length(bv) * dl) > 0.95 && dot(hv, d) / (length(hv) * dl) > 0.95;
      }
    }
  }
  // the fight running, she circles it: never inside the boss as it turns and charges
  g_reset(g[..]); _ := spw_shipped(g[..]); g_stage(g[..], 10);
  t := g[0].bt[0]; g[0].px = t.dino_x + 7; g[0].pz = t.dino_z; g[0].fwd = true; g[0].turn_l = true;
  w := cc_watch(g[..], 300, CcWatch.{});
  #assert !w.in_body && w.near >= CM_MIN - 0.1;   // as it swings into the boom, the boom eases out from it a few centimetres late
}

#test "#13552: her back to Sniper's shell, the camera stays low behind her and the shell fades; walking off, it comes back" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  cc_farm(g[..]);
  rv := cm_rover(g[..]); #assert rv.ok;
  hx := g[0].c[0].pieces[rv.row].hx;
  g[0].px = rv.x + cos(rv.yaw) * (hx + 0.6); g[0].pz = rv.z - sin(rv.yaw) * (hx + 0.6); g[0].yaw = rv.yaw + PI * 0.5;   // facing away from its side
  g[0].cam[0].ready = false;
  w := cc_watch(g[..], 90, CcWatch.{});
  c := g_camera(g[..]); p := cm_pivot(g[..]); r := length(sub(c.eye, p));
  #assert g[0].cam[0].ghost && g[0].cam[0].fade == 1 && (c.eye.y - p.y) / r < 0.8 && w.near >= CM_MIN - CC_SLACK;   // low, not overhead
  // the shell is drawn live, dissolved, and not also in the place store
  buf: [400000] u32; pen := [1] Pen.[Pen.{}];
  g_live(g[..], buf[..], pen[..]);
  smoke := 0; for i: 0..<pen[0].n { if buf[i * VERTEX_WORDS + 4] >> 24 == cast(u32) MAT_SMOKE && f32_from_bits(buf[i * VERTEX_WORDS + 5]) < 0.3 { smoke += 1; } }
  #assert smoke > 100;
  d := [1] SpLayerDraw.[SpLayerDraw.{}]; places: [SD_PLACE_WORDS] u32; sd_places(d[..], g[..], places[..]);
  low := 0; for k: 0..<d[0].place_n { if f32_from_bits(places[k * SD_ROW + 1]) < -100 { low += 1; } }
  #assert low == 1;
  // a few steps away from it: the camera no longer sees through it, and it fades back in
  g[0].fwd = true; _ = cc_watch(g[..], 60, CcWatch.{}); g[0].fwd = false;
  _ = cc_watch(g[..], 30, CcWatch.{});
  #assert !g[0].cam[0].ghost && g[0].cam[0].fade == 0;
}
#test "#13552: a change of camera blends from the view last drawn, a far one cuts; walking widens the view a little, a hit kicks it, and reduced motion keeps it still" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}];
  cc_farm(g[..]); g[0].have[H_DRILL] = true;
  tr := g_shipped_at(g[..], 123); g[0].px = tr.x + 2.2; g[0].pz = tr.z;
  #assert g_key(g[..], 'e', true) && sp_in_room(g[..]);
  dk := g_shipped_at(g[..], 125); g[0].px = dk.x - 1.2; g[0].pz = dk.z;
  for i: 0..<3 { g_step(g[..], 1.0f32 / 60); cm_seen(g[..], g_camera(g[..])); }
  g[0].dr[0].map = false;
  #assert g_key(g[..], 'e', true) && g[0].mode == M_DRIVE;
  g_step(g[..], 1.0f32 / 60);
  #assert g[0].cam[0].bl == 0;   // the cabin's desk to the road outside: a cut
  _ = g_key(g[..], 'w', true);
  for i: 0..<150 { g_step(g[..], 1.0f32 / 60); cm_seen(g[..], g_camera(g[..])); }
  _ = g_key(g[..], 'w', false);
  #assert g_camera(g[..]).fov > 0.8 + CM_DRIVE_FOV * 0.2;   // at speed the drive's view is wider
  for i: 0..<120 { _ = g_key(g[..], 's', true); g_step(g[..], 1.0f32 / 60); cm_seen(g[..], g_camera(g[..])); }
  _ = g_key(g[..], 's', false);
  // E parks Sniper and she steps out: the drive's camera eases round to hers, no snap
  was := g_camera(g[..]).eye;
  #assert g_key(g[..], 'e', true) && g[0].mode == M_PLAY;
  g_step(g[..], 1.0f32 / 60);
  #assert g[0].cam[0].bl > 0.9 && length(sub(g_camera(g[..]).eye, was)) < 1;
  most := 0.0f32; e0 := g_camera(g[..]).eye;
  for i: 0..<45 { g_step(g[..], 1.0f32 / 60); e := g_camera(g[..]).eye; most = hi(most, length(sub(e, e0))); e0 = e; cm_seen(g[..], g_camera(g[..])); }
  #assert g[0].cam[0].bl == 0 && most < 1;
  // walking: a little wider; a hit kicks the view sideways for a moment, then it is still again
  g[0].fwd = true; for i: 0..<60 { g_step(g[..], 1.0f32 / 60); } g[0].fwd = false;
  #assert g_camera(g[..]).fov > CM_FOV + CM_RUN_FOV * 0.5;
  for i: 0..<90 { g_step(g[..], 1.0f32 / 60); }
  #assert g_camera(g[..]).fov < CM_FOV + 0.002;
  a := g_camera(g[..]).eye; g[0].hit_cool = 0; g_hurt(g[..]);
  for i: 0..<3 { g_step(g[..], 1.0f32 / 60); }
  #assert length(sub(g_camera(g[..]).eye, a)) > 0.02;
  for i: 0..<30 { g_step(g[..], 1.0f32 / 60); }
  #assert length(sub(g_camera(g[..]).eye, a)) < 0.001;
  // reduced motion, switched on the pause screen: no kick, no widening, and a new run keeps it
  hv: [1] HvCheck; d_pause(g[..]); _ := hv_draw(g[..], hv[..]);
  i := hv_btn(g[..], CM_CALM_KEY); #assert i >= 0 && !g[0].calm;
  bx := (g[0].btn[i * 4] + g[0].btn[i * 4 + 2]) * 0.5; by := (g[0].btn[i * 4 + 1] + g[0].btn[i * 4 + 3]) * 0.5;
  #assert g_pointer(g[..], bx, by, 0) && g[0].calm && g[0].dr[0].paused;   // the click switches it and the game stays paused
  #assert g_pointer(g[..], bx, by + 400, 0) && !g[0].dr[0].paused;          // a click anywhere else resumes
  a = g_camera(g[..]).eye; g[0].hit_cool = 0; g_hurt(g[..]);
  g[0].fwd = true; for k: 0..<3 { g_step(g[..], 1.0f32 / 60); } g[0].fwd = false;
  #assert g[0].cam[0].kick_t >= CM_KICK_TIME || g[0].cam[0].kick == 0;
  for k: 0..<60 { g_step(g[..], 1.0f32 / 60); }
  #assert g_camera(g[..]).fov == CM_FOV;
  cc_farm(g[..]); #assert g[0].calm;
}
