// Splice Bots' follow camera (playtest 2): the one camera behind her on foot and on the hoverboard,
// in every zone. splice-game.coax g_camera hands its walking case here.
//
// It is a boom from her head out behind her. Each step (cm_step) it looks for room along that
// boom in three dimensions: a piece blocks it only up to the piece's top (sl_inside_at), so the
// eye passes over the farm's low panels, and a tall wall, the garage's rock, Digger, the drill mech
// and the boss all stop it. Where the boom has no room it swings up before it comes in, and never
// nearer her head than CM_MIN where any way has room, so she never fills the view. The boom's angle
// and length ease on a critically damped spring (the engine's, metaverse-engine/cam/follow.coax),
// and nothing moves it but her: standing still, the camera stands still. Drawn, the eye is never
// further out than the room the boom has this frame (cm_room), so it is never inside a wall or a body.
//   coax/bin/coax test metaverse/splice-bots/splice-bots.coax

#load "../../metaverse-engine/cam/follow.coax" as cmf;

CM_CLEAR :: 0.3f32;     // m the eye keeps from a wall or a body
CM_EARLY :: 0.6f32;     // m wider the step looks, so the boom starts to move before the eye meets anything
CM_MIN :: 2.6f32;       // m: the nearest the eye comes to her head while any way out has room
CM_START :: 0.5f32;     // m out from her head the boom is first looked along (her own head is not in its way)
CM_SAMPLE :: 0.4f32;    // m between the points the boom is looked at
CM_RISE_STEP :: 0.2f32;
CM_RISE_MAX :: 1.55f32; // radians: the steepest the boom swings up to find room, over her head (her back to a tall wall)
CM_OVER :: 0.75f32;     // radians the boom swings up to see over a big body ahead
CM_RISE_TIME :: 0.3f32; // s: the spring's time for the boom's angle
CM_OUT_TIME :: 0.45f32; // s: backing out once a wall lets go
CM_IN_TIME :: 0.12f32;  // s: coming in before a wall
CM_CUT :: 6.0f32;       // m: further than this in a step is a cut, and the camera starts where it should be
CM_LOOK_AHEAD :: 0.3f32; // s of her turning the boom looks ahead
CM_HEAD :: 1.7f32;      // m: the boom's pivot, her head, over her feet
CM_FOV :: 0.82f32;
CM_BOARD_BACK :: 1.5f32; // m further back on the hoverboard, before its speed pulls it back more
CM_FOOT_TIME :: 0.15f32; // s: the spring's time for the height it follows (landings, ramps, the board's hover)
CM_ZOOM_NEAR :: 3.0f32;  // m: the nearest the wheel brings the eye to her head; she stays in view, never first person
CM_ZOOM_FAR :: 1.6f32;   // the furthest the wheel takes the boom, times its rest
CM_ZOOM_STEP :: 0.0012f32; // the boom's change a CSS pixel of wheel
CM_BLEND :: 0.6f32;      // s: one camera eases into the next (on foot, the drive, the bay, a scripted shot)
CM_BLEND_FAR :: 25.0f32; // m: an eye further than this from the last is a cut (a door, the desk to the road)
CM_RUN_FOV :: 0.035f32;  // radians wider at her walking speed (T_WALK)
CM_DRIVE_FOV :: 0.1f32;  // radians wider at Sniper's top speed
CM_FOV_TIME :: 0.35f32;  // s: the speed's widening eases in and out over about this
CM_KICK_HARD :: 10.0f32; // m/s down: a landing harder than this kicks (a normal jump lands at 9)
CM_KICK_LAND :: 0.025f32; // m of kick per m/s past CM_KICK_HARD, at most CM_KICK_MAX
CM_KICK_HIT :: 0.09f32;  // m: a hit on her, sideways
CM_KICK_CLAW :: 0.16f32; // m: a claw on Sniper, sideways (the drive's camera is 13 m out)
CM_KICK_MAX :: 0.14f32;
CM_KICK_TIME :: 0.32f32; // s a kick lasts
CM_KICK_RATE :: 34.0f32; // radians a second it swings
CM_FADE_TIME :: 0.2f32;  // s: Sniper's shell fades out of the camera's way, or back
CM_FADE_LEFT :: 0.0f32;  // of the shell left at most fade: none, since at the lens any speck is a blot
CM_GHOST_GAIN :: 0.2f32; // radians lower the boom must sit to see through the shell rather than go over it

// The camera's eased state, in the game (SpGame.cam).
SpCam :: struct {
  ready: bool;              // eased at least once since she was put somewhere
  rise: f32; rise_v: f32;   // the boom's angle up from level (radians), and its spring's speed
  dist: f32; dist_v: f32;   // its length (m)
  over: f32; over_v: f32;   // how far it has swung up for a big body ahead, 0 to 1
  x: f32; z: f32; yaw: f32; // where she was and faced at the last step
  yaw_v: f32;               // how fast she turns (radians a second), eased
  foot: f32; foot_v: f32;   // the height it follows (cm_feet), eased
  ghost: bool; fade: f32;   // it sees through Sniper's shell, and how faded the shell is (0 to 1)
  src: int; bl: f32; bl_from: CamNow;   // which camera was last drawn (g_cam_src), the blend's share left and where it started
  last: CamNow; seen: bool;             // the view last drawn
  run: f32;                             // the speed's widening, eased (radians)
  kick: f32; kick_t: f32; kick_side: bool;   // the impact kick: its size, its time and whether it is sideways
  hearts: int; snip: f32;               // her hearts and Sniper's health at the last step
}

// One spring step of `time` seconds: the engine's critically damped spring, whose time is 0.1 s,
// run on a clock scaled to `time`.
cm_ease :: (cur: f32, vel: [] f32, dest: f32, dt: f32, time: f32) -> f32 {
  k := f32(cmf.FOLLOW_SPRING_TIME) / time;
  a := cmf.follow_spring_axis(cur, vel[0] / k, dest, dt * k);
  vel[0] = a.vel * k;
  return a.at;
}

// Her height the camera follows: the jump's third, sinking as she sneaks, the board's hover.
cm_foot_goal :: (g: [] SpGame) -> f32 {
  // with reduced motion it holds her take-off height through a jump, so a landing has nothing to settle
  y := (ifx g[0].calm && g_airborne(g) then lo(g_feet_y(g), g[0].air_from) else g_cam_y(g)) - d_crouch(g);
  if g_riding(g) { y += board_lift(g[0].board[0]); }
  return y;
}
// That height eased on CM_FOOT_TIME: a jump stays steady in the frame, and landing on a panel or
// stepping down a ramp the view settles instead of popping.
cm_feet :: (g: [] SpGame) -> f32 {
  c := g[0].cam[0];
  if !c.ready || dist2(c.x, c.z, g[0].px, g[0].pz) > CM_CUT { return cm_foot_goal(g); }
  return c.foot;
}
cm_pivot :: (g: [] SpGame) -> Point { return v3(g[0].px, cm_feet(g) + CM_HEAD, g[0].pz); }
// How far out the boom rests before the wheel: closer in the dome village, pulled back at speed on the board.
cm_reach :: (g: [] SpGame) -> f32 {
  r := ifx g[0].zone == Z_VILLAGE then 4.0f32 else 6.5f32;
  if g[0].zone == Z_MINE && sp_in_room(g) { r = DV_ROOM_REACH; }   // in the rover's cabin: in close (drive.coax)
  if g_riding(g) { r += CM_BOARD_BACK + board_back(g[0].board[0]); }
  return r + CM_BOSS_BACK * cm_boss_ahead(g);   // back a little to take the boss in too
}
// How far out the boom wants to be: the rest scaled by the wheel, never nearer than CM_ZOOM_NEAR.
cm_want :: (g: [] SpGame) -> f32 { return hi(CM_ZOOM_NEAR, cm_reach(g) * g[0].zoom); }
// The wheel or two fingers on a trackpad (CSS pixels, down is out): the boom in or out, a notch
// about an eighth. In, it stops CM_ZOOM_NEAR from her head: the view never goes into her.
cm_wheel :: (g: [] SpGame, dy: f32) {
  if g[0].mode != M_PLAY && g[0].mode != M_RIDE { return; }
  z := g[0].zoom * (1 + clamp(dy * CM_ZOOM_STEP, -0.3, 0.3));
  g[0].zoom = clamp(z, CM_ZOOM_NEAR / cm_reach(g), CM_ZOOM_FAR);
}
// The boom's resting angle: a little over her head, more as the view looks down.
cm_base :: (g: [] SpGame, want: f32) -> f32 {
  lift := ifx g[0].zone == Z_VILLAGE then 0.18f32 else 0.33f32;
  return atan2(0.2 + want * (lift + g[0].pitch * 0.6), want);
}
cm_dir :: (yaw: f32, rise: f32) -> Point { c := cos(rise); return v3(-sin(yaw) * c, sin(rise), -cos(yaw) * c); }

// Whether the camera at (x, y, z), padded, is in something: the ground, the village dome's wall, the
// rock round the garage, a placed piece or wall up to its top, or a body.
cm_blocked :: (g: [] SpGame, x: f32, y: f32, z: f32, pad: f32, roof: f32) -> bool {
  if y < g_ground(g, x, z) + pad || y > roof - pad { return true; }
  if g[0].zone == Z_VILLAGE && g_inside(g, x, z) { return true; }
  q := ga_push(g, x, z, pad); if q.x != x || q.z != z { return true; }
  if g[0].zone == Z_MINE { q = ga_lab_push(g, x, z, pad); if q.x != x || q.z != z { return true; } }   // the lab's round wall
  if sl_inside_at(g, x, y, z, pad) && !(g[0].cam[0].ghost && cm_rover_has(g, x, y, z, pad)) { return true; }
  return cm_body_at(g, x, y, z, pad);
}
// The bodies that move: Digger beside her, the drill mech, and in its chamber the boss.
cm_body_at :: (g: [] SpGame, x: f32, y: f32, z: f32, pad: f32) -> bool {
  if g[0].zone != Z_MINE { return false; }
  if g[0].bot && y < T_BOT_TOP + pad && dist2(x, z, g[0].bot_x, g[0].bot_z) < T_BOT_R + pad { return true; }
  if y < SB_MECH_TOP + pad && dist2(x, z, g[0].bt[0].mech_x, g[0].bt[0].mech_z) < SB_MECH_R + pad { return true; }   // its fields, not a copy of the battle
  if (g[0].wall_gone || g[0].boss_down) && y < CM_BOSS_TOP + pad && cm_boss_in(g, x, z, pad) { return true; }
  return false;
}
// The boss's body, or only the round she collides with (layer.coax, 2.1 m) when she stands in its
// reach (at its tail, at a weak point): the camera is never put out of her own head by it.
cm_boss_in :: (g: [] SpGame, x: f32, z: f32, pad: f32) -> bool {
  t := g[0].bt[0];
  if dist2(x, z, t.dino_x, t.dino_z) < CM_BOSS_CORE + pad { return true; }
  if sb_boss_gap(g, g[0].px, g[0].pz, false) < CM_CLEAR { return false; }
  return sb_boss_gap(g, x, z, false) < pad;
}
// The boss as the camera meets it: the long collider she and Digger stop against, its body and its
// swaying tail out to the tip (splice-battle.coax sb_boss_gap; its head stands over the boom), up to CM_BOSS_TOP (SB_BOSS_TALL).
CM_BOSS_TOP :: SB_BOSS_TALL + 0.3;
CM_BOSS_CORE :: SB_BOSS_R - T_RADIUS; // m: the round she collides with, less her own radius (layer.coax sl_round of SK_BOSS)
CM_BOSS_BACK :: 1.5f32;  // m further back with the boss ahead
CM_BOSS_LOOK :: 0.6f32;  // how far the look turns toward the point between her and the boss
CM_BOSS_RISE :: 0.2f32;  // radians the boom swings up by the boss while coming in still leaves CM_MIN
// How much the standing boss is ahead of her and near, 0 to 1: the camera frames the two of them.
cm_boss_ahead :: (g: [] SpGame) -> f32 {
  t := g[0].bt[0]; dx := t.dino_x - g[0].px; dz := t.dino_z - g[0].pz; d := sqrt(dx * dx + dz * dz);
  if d < 0.001 { return 0; }
  return cm_boss_near(g) * clamp((dx * sin(g[0].yaw) + dz * cos(g[0].yaw)) / d * 2, 0, 1);
}
// How near the standing boss is, 0 to 1 (1 within 14 m). Near it the boom comes in before it
// swings up, so the camera stays low enough to read the fight rather than look down on it.
cm_boss_near :: (g: [] SpGame) -> f32 {
  if g[0].zone != Z_MINE || !g[0].wall_gone || g[0].boss_down { return 0; }
  t := g[0].bt[0];
  return clamp((22 - dist2(t.dino_x, t.dino_z, g[0].px, g[0].pz)) / 8, 0, 1);
}
// The ceiling over her, if she is indoors: the rover's cabin (drive.coax), the lab's at 9 m and
// the hallway's into it at 10 m (garage.coax). Under one, the eye never shows the sky.
CM_LAB_ROOF :: 9.0f32; CM_HALL_ROOF :: 10.0f32;
cm_roof :: (g: [] SpGame) -> f32 {
  if g[0].zone != Z_MINE { return 1000000; }
  if sp_in_room(g) { return DV_ROOM_H; }
  if !ga_in_lab(g, g[0].px, g[0].pz) { return 1000000; }
  return ifx g[0].pz < g[0].at.gar_z - ga_back(g) - GA_HALL_LONG then CM_LAB_ROOF else CM_HALL_ROOF;
}
// How far out along `dir` from `from` the camera has room, up to `far`, keeping `pad` from what it meets.
cm_room :: (g: [] SpGame, from: Point, dir: Point, far: f32, pad: f32) -> f32 {
  roof := cm_roof(g);
  if roof > 1000 && cm_open(g, from, dir, far, pad) { return far; }   // nothing near the boom at all: one look, not a march
  // near her head the pad narrows, so a wall she stands beside is not in the boom's way
  d := CM_START; free := 0.0f32;
  while true {
    if d > far { d = far; }
    if cm_hit(g, from, dir, d, pad, roof) {
      // between the last free point and this one, halved four times: the room changes smoothly, not a sample at a time
      hit := d;
      for k: 0..<5 { m := (free + hit) * 0.5; if cm_hit(g, from, dir, m, pad, roof) { hit = m; } else { free = m; } }
      return free;
    }
    free = d;
    if d >= far { return far; }
    d += CM_SAMPLE;
  }
  return far;
}
cm_hit :: (g: [] SpGame, from: Point, dir: Point, d: f32, pad: f32, roof: f32) -> bool {
  return cm_blocked(g, from.x + dir.x * d, from.y + dir.y * d, from.z + dir.z * d, lo(pad, 0.1 + d * 0.25), roof);
}
// Whether nothing the camera meets is anywhere near the boom from `from` along `dir` for `far`
// metres: no collider within its reach whose top is above the boom's foot, no body near its line,
// the garage's rock and the ground well clear. Most steps in the open answer here with one look.
cm_open :: (g: [] SpGame, from: Point, dir: Point, far: f32, pad: f32) -> bool {
  if g[0].zone == Z_VILLAGE || dir.y < 0 { return false; }
  half := far * 0.5; mx := from.x + dir.x * half; mz := from.z + dir.z * half; r := half + pad;
  ids: [SL_NEAR] int; n := sl_near(g, mx, mz, r, ids[..]);
  for i: 0..<n {
    s := ids[i]; kind := sl_i(g, WI_KIND, s); gate := kind == SK_RUBBLE || kind == SK_BOSS_WALL;
    if !sl_solid(g, s, !gate) { continue; }
    top := ifx gate then SL_GATE_TOP else sl_f(g, WF_Y, s) + sl_f(g, WF_HEIGHT, s);
    if top + pad >= from.y { return false; }   // it may reach the boom: look properly
  }
  ex := from.x + dir.x * far; ez := from.z + dir.z * far;
  if from.y < g_ground(g, from.x, from.z) + 1 || from.y + dir.y * far < g_ground(g, ex, ez) + pad + 0.5 { return false; }
  if g[0].zone == Z_MINE {
    d := dist2(mx, mz, g[0].at.gar_x, g[0].at.gar_z);
    if d + r >= ga_back(g) - 0.5 && d - r <= ga_back(g) + GA_BACK * 2 + 0.5 { return false; }   // near the garage's back wall
    t := g[0].bt[0];
    if g[0].bot && cm_flat_gap(from.x, from.z, ex, ez, g[0].bot_x, g[0].bot_z) < T_BOT_R + pad { return false; }
    if cm_flat_gap(from.x, from.z, ex, ez, t.mech_x, t.mech_z) < SB_MECH_R + pad { return false; }
    if (g[0].wall_gone || g[0].boss_down) && cm_flat_gap(from.x, from.z, ex, ez, t.dino_x, t.dino_z) < SB_BOSS_REACH + pad { return false; }
  }
  return true;
}
// How far the point (px, pz) is from the segment a-b, on the ground.
cm_flat_gap :: (ax: f32, az: f32, bx: f32, bz: f32, px: f32, pz: f32) -> f32 {
  dx := bx - ax; dz := bz - az; l := dx * dx + dz * dz;
  k := ifx l < 0.000001 then 0.0f32 else clamp(((px - ax) * dx + (pz - az) * dz) / l, 0, 1);
  return dist2(px, pz, ax + dx * k, az + dz * k);
}
// Where the boom should be: of the angles from its rest up, the one that costs least, a metre of
// length lost against CM_RISE_COST metres for each radian it swings up and CM_STAY for each radian
// away from where it is now, so it rises over a low thing rather than pump in and out, and holds
// its choice. It looks wider than the draw does (CM_EARLY), and also where she is turning to
// (`ahead` radians of yaw), so it moves before the boom meets anything.
CmAim :: struct { rise: f32; dist: f32; }
CM_RISE_COST :: 3.0f32; CM_STAY :: 1.5f32; CM_SHORT :: 4.0f32;
// Past CM_STEEP radians each radian costs CM_STEEP_COST more where a lower angle keeps CM_MIN: in a
// hallway or beside a wall it rises only as far as CM_MIN needs, and over her head only with her back to the wall.
CM_STEEP :: 0.8f32; CM_STEEP_COST :: 6.0f32;
cm_aim :: (g: [] SpGame, over: f32, now: f32, ahead: f32) -> CmAim {
  p := cm_pivot(g); want := cm_want(g); base := cm_base(g, want) + over * CM_OVER;
  best := CmAim.{rise = base, dist = -1}; cost := 1000000.0f32; low_kept := false;
  near_boss := cm_boss_near(g); rise_cost := CM_RISE_COST * (1 + near_boss);
  a := base;
  while a <= CM_RISE_MAX + 0.001 {
    if (a - base) * CM_RISE_COST >= cost { break; }   // no steeper angle can cost less
    // by the boss it swings up over it only where coming in would bring it nearer than CM_MIN
    if near_boss > 0.5 && a - base > CM_BOSS_RISE && best.dist >= CM_MIN { break; }
    dir := cm_dir(g[0].yaw, a);
    room := cm_room(g, p, dir, want, CM_CLEAR + CM_EARLY);
    if abs(ahead) > 0.05 { room = lo(room, cm_room(g, p, cm_dir(g[0].yaw + ahead, a), want, CM_CLEAR + CM_EARLY)); }
    // the early look never brings it nearer than CM_MIN where the draw's own room allows that
    kept := room >= CM_MIN; if kept && a <= CM_STEEP { low_kept = true; }
    if room < CM_MIN { room = lo(cm_room(g, p, dir, want, CM_CLEAR), CM_MIN); }
    // short of CM_MIN costs CM_SHORT times as much: she must not fill the view; by the boss, rising
    // costs double, but not where it is what keeps CM_MIN
    c := (want - room) + hi(0, CM_MIN - room) * CM_SHORT + (a - base) * (ifx kept then rise_cost else CM_RISE_COST) + (ifx low_kept then hi(0, a - CM_STEEP) * CM_STEEP_COST else 0.0f32) + (ifx now < 0 then 0.0f32 else abs(a - now) * CM_STAY);
    if c < cost { cost = c; best = CmAim.{rise = a, dist = room}; }
    if a < CM_RISE_MAX && a + CM_RISE_STEP > CM_RISE_MAX { a = CM_RISE_MAX; } else { a += CM_RISE_STEP; }
  }
  return best;
}
// A step of the camera: the boom eases toward where it should be. Put somewhere (a respawn, a door,
// the run's start), it starts there.
cm_step :: (g: [] SpGame, dt: f32) {
  c := g[0].cam[..];
  over := g_big_ahead(g, g[0].px, g[0].pz, sin(g[0].yaw), cos(g[0].yaw));
  cut := !c[0].ready || dist2(c[0].x, c[0].z, g[0].px, g[0].pz) > CM_CUT;
  foot := cm_foot_goal(g);
  if cut { c[0].foot = foot; c[0].foot_v = 0; }
  else { f := [1] f32.[c[0].foot_v]; c[0].foot = cm_ease(c[0].foot, f[..], foot, dt, CM_FOOT_TIME); c[0].foot_v = f[0]; }
  c[0].ready = true; c[0].x = g[0].px; c[0].z = g[0].pz;   // cm_pivot follows the eased height from here
  if cut { c[0].over = over; c[0].over_v = 0; }
  else { v := [1] f32.[c[0].over_v]; c[0].over = cm_ease(c[0].over, v[..], over, dt, CM_RISE_TIME); c[0].over_v = v[0]; }
  // how fast she turns, eased, for the look ahead
  turn := ifx cut then 0.0f32 else atan2(sin(g[0].yaw - c[0].yaw), cos(g[0].yaw - c[0].yaw)) / hi(dt, 0.001);
  c[0].yaw_v = ifx cut then 0.0f32 else c[0].yaw_v + (turn - c[0].yaw_v) * lo(1, dt * 12);
  now := ifx cut then -1.0f32 else c[0].rise; ahead := clamp(c[0].yaw_v * CM_LOOK_AHEAD, -0.8, 0.8);
  was := c[0].ghost; c[0].ghost = false;
  aim := cm_aim(g, c[0].over, now, ahead);
  // her back to Sniper's shell: rather than go over her head and look down, the boom stays low and the shell fades
  if aim.rise > CM_STEEP - (ifx was then 0.25f32 else 0.0f32) && cm_rover_near(g) {
    c[0].ghost = true;
    low := cm_aim(g, c[0].over, now, ahead);
    if low.rise < aim.rise - CM_GHOST_GAIN || (was && low.rise < aim.rise) { aim = low; } else { c[0].ghost = false; }
  }
  c[0].fade = clamp(c[0].fade + (ifx c[0].ghost then dt else -dt) / CM_FADE_TIME, 0, 1);
  if cut {
    c[0].rise = aim.rise; c[0].dist = aim.dist; c[0].rise_v = 0; c[0].dist_v = 0;
  } else {
    // pulled in short of CM_MIN (a body swept in behind her), it swings up as fast as it came in
    up_time := ifx c[0].dist < CM_MIN && aim.rise > c[0].rise then CM_IN_TIME else CM_RISE_TIME;
    v := [1] f32.[c[0].rise_v]; c[0].rise = cm_ease(c[0].rise, v[..], aim.rise, dt, up_time); c[0].rise_v = v[0];
    w := [1] f32.[c[0].dist_v]; c[0].dist = cm_ease(c[0].dist, w[..], aim.dist, dt, ifx aim.dist < c[0].dist then CM_IN_TIME else CM_OUT_TIME); c[0].dist_v = w[0];
  }
  c[0].ready = true; c[0].x = g[0].px; c[0].z = g[0].pz; c[0].yaw = g[0].yaw;
}
// The camera behind her, as drawn: the eased boom, never further out than its room this frame.
cm_follow :: (g: [] SpGame) -> CamNow {
  c := g[0].cam[0];
  if !c.ready || dist2(c.x, c.z, g[0].px, g[0].pz) > CM_CUT {
    // not stepped since she was put here (a still, a check): where the step would ease to
    c.over = g_big_ahead(g, g[0].px, g[0].pz, sin(g[0].yaw), cos(g[0].yaw));
    a := cm_aim(g, c.over, -1, 0); c.rise = a.rise; c.dist = a.dist;
  }
  p := cm_pivot(g); dir := cm_dir(g[0].yaw, c.rise);
  d := lo(c.dist, cm_room(g, p, dir, c.dist, CM_CLEAR));
  // a wall swept in faster than the boom eased (she turned with her back to it): up, not into her head
  need := lo(c.dist, CM_MIN);
  if d < need {
    a := c.rise + CM_RISE_STEP; best := d; best_dir := dir;
    while a <= CM_RISE_MAX + CM_RISE_STEP && best < need {
      e := cm_dir(g[0].yaw, lo(a, CM_RISE_MAX)); r := lo(c.dist, cm_room(g, p, e, c.dist, CM_CLEAR));
      if r > best { best = r; best_dir = e; }
      a += CM_RISE_STEP;
    }
    d = best; dir = best_dir; c.rise = hi(c.rise, atan2(dir.y, sqrt(dir.x * dir.x + dir.z * dir.z)));
  }
  eye := v3(p.x + dir.x * d, p.y + dir.y * d, p.z + dir.z * d);
  // the look: ahead of her at chest height; swung up, it comes back toward her so she stays in view
  y := cm_feet(g);
  ahead := v3(g[0].px + sin(g[0].yaw) * 3, y + 1.5, g[0].pz + cos(g[0].yaw) * 3);
  k := clamp((c.rise - cm_base(g, cm_want(g))) / 0.8, 0, 1) * 0.7;
  at := v3(ahead.x + (g[0].px - ahead.x) * k, ahead.y + (y + 1.1 - ahead.y) * k, ahead.z + (g[0].pz - ahead.z) * k);
  // the standing boss ahead: the look goes part way to it, so the two of them are in the frame
  b := cm_boss_ahead(g) * CM_BOSS_LOOK;
  if b > 0 {
    t := g[0].bt[0]; mid := v3((g[0].px + t.dino_x) * 0.5, y + 1.8, (g[0].pz + t.dino_z) * 0.5);
    at = v3(at.x + (mid.x - at.x) * b, at.y + (mid.y - at.y) * b, at.z + (mid.z - at.z) * b);
  }
  if g_riding(g) {
    // the sense of speed: a wider view and a shake, from the engine's board
    bd := g[0].board[0]; s := board_shake(bd, g[0].t);
    if g[0].calm { return CamNow.{eye = eye, at = at, fov = CM_FOV}; }   // reduced motion: no shake, no widening
    return CamNow.{eye = v3(eye.x + s[0], eye.y + s[1], eye.z + s[2]), at = at, fov = board_fov(bd, CM_FOV)};
  }
  return CamNow.{eye = eye, at = at, fov = CM_FOV};
}

// A body of radius r at (x, z) pushed off her: never nearer her middle than r, her own circle and a hand.
CM_HAND :: 0.3f32;
cm_keep_off :: (g: [] SpGame, x: f32, z: f32, r: f32) -> Point {
  dx := x - g[0].px; dz := z - g[0].pz; d := sqrt(dx * dx + dz * dz); keep := r + T_RADIUS + CM_HAND;
  if d >= keep { return v3(x, 0, z); }
  if d < 0.0001 { dx = cos(g[0].yaw); dz = -sin(g[0].yaw); d = 1; }   // on her: out to her left
  return v3(g[0].px + dx / d * keep, 0, g[0].pz + dz / d * keep);
}

// Whether the eye is so near her head that her body would fill the view: then it is not drawn.
CM_TOO_NEAR :: 1.2f32;
cm_too_near :: (g: [] SpGame) -> bool {
  if g[0].mode != M_PLAY { return false; }
  return length(sub(g_camera(g).eye, cm_pivot(g))) < CM_TOO_NEAR;
}

// The camera's own stills (g_stage, the page's message 640): 30 the solar farm on foot among the
// pieces, 31 Digger drilling the rock wall, 32 the hoverboard at speed, 33 the drill mech following.
cm_stage :: (g: [] SpGame, n: int) {
  if n < 30 || n > 33 { return; }
  if n == 30 || n == 32 {
    g_reset(g); g_begin(g); g[0].yaw += 2.3; g_bot_home(g);
    if n == 32 { g_board_key(g); g[0].fwd = true; }
    return;
  }
  g_stage_set(g, 5); g_foes(g);
  for i: 0..<5 { g[0].have[i] = true; g[0].taken[i] = true; }
  for i: 0..<3 { g[0].slot[i] = true; }
  g[0].bot = true; g[0].strip[0] = H_MOVE; g[0].strip[1] = H_DRILL; g[0].strip_n = 2;
  if n == 31 { g[0].px = 1.2; g[0].pz = g[0].at.rubble_z + 3.5; g[0].yaw = PI - 0.4; g_bot_home(g); g_deploy(g); return; }
  // 33: past the rock wall at dusk, Digger's core in the mech, which stands at her left
  g_stage_set(g, 7); g_foes(g);
  g[0].px = g[0].at.gar_x + 6; g[0].pz = g[0].at.gar_z + 20; g[0].yaw = PI;   // the open field in the garage's ring
  g[0].bot_x = g[0].px + 6; g[0].bot_z = g[0].pz + 8;   // Digger's body waits where the core came out
  t := g[0].bt[..]; t[0].mech_core = true; t[0].mech_used = true;
  h := sb_mech_spot(g); t[0].mech_x = h.x; t[0].mech_z = h.z; t[0].mech_yaw = g[0].yaw;
}

// ---- Sniper's shell is seen through, not climbed over (#13552): with her back to it the boom stays
// low and the shell dissolves (the cel shader's smoke material) instead of the view going overhead.
CmRover :: struct { ok: bool; x: f32; y: f32; z: f32; yaw: f32; row: int; }
// Sniper as it stands while she is on foot: parked where she left it, or the farm's rover.
cm_rover :: (g: [] SpGame) -> CmRover {
  row := sc_piece(g[0].c[..], SP_ROVER_KIND);
  if g[0].zone != Z_MINE || g[0].mode == M_DRIVE || row < 0 { return CmRover.{}; }
  if dv_away(g) { return CmRover.{ok = true, x = g[0].at.rover_x, z = g[0].at.rover_z, yaw = g[0].at.rover_yaw, row = row}; }
  id := dv_train(g); i := ifx id < 0 then -1 else sl_item(g, id);
  if i < 0 { return CmRover.{}; }
  e := g[0].layer[0].items[i];
  return CmRover.{ok = true, x = e.x, y = e.y, z = e.z, yaw = e.yaw, row = row};
}
cm_rover_near :: (g: [] SpGame) -> bool { r := cm_rover(g); return r.ok && cm_rover_has(g, g[0].px, g_feet_y(g) + 1, g[0].pz, 2.5); }
// Whether (x, y, z), padded, is inside the shell as it is drawn.
cm_rover_has :: (g: [] SpGame, x: f32, y: f32, z: f32, pad: f32) -> bool {
  r := cm_rover(g);
  if !r.ok || y > r.y + g[0].c[0].pieces[r.row].top + pad { return false; }
  o := sl_foot(g, r.row, r.x, r.z, r.yaw);
  return sl_seg_seg(SlSeg.{ax = x, az = z, bx = x, bz = z, r = pad}, o) < pad + o.r;
}
cm_faded :: (g: [] SpGame) -> bool { return g[0].cam[0].fade > 0.01; }
// The shell's vertices from..<to in the live store, dissolved as far as the camera has faded it.
cm_dissolve :: (g: [] SpGame, buf: [] u32, from: int, to: int) {
  if !cm_faded(g) { return; }
  left := f32_bits(1 - g[0].cam[0].fade * (1 - CM_FADE_LEFT));
  for i: from..<to { o := i * VERTEX_WORDS; buf[o + 4] = (buf[o + 4] & 0xFFFFFF) | (cast(u32) MAT_SMOKE << 24); buf[o + 5] = left; }
}

// ---- One camera blends into the next, the speed widens the view, and impacts kick it (#13552)
// Each step before the run moves: a change of camera starts a blend from the view last drawn (a cut
// when that view is further than CM_BLEND_FAR); her hearts, Sniper's health and her landing kick it.
cm_tick :: (g: [] SpGame, dt: f32) {
  c := g[0].cam[..]; src := g_cam_src(g);
  if src != c[0].src && c[0].seen && length(sub(c[0].last.eye, g_camera_raw(g).eye)) < CM_BLEND_FAR { c[0].bl = 1; c[0].bl_from = c[0].last; }
  c[0].src = src; c[0].bl = hi(0, c[0].bl - dt / CM_BLEND); c[0].kick_t += dt;
  j := g[0].air[0];
  if j.landed && j.impact > CM_KICK_HARD && g[0].mode == M_PLAY { cm_kick(g, (j.impact - CM_KICK_HARD) * CM_KICK_LAND, false); }
  if g[0].hearts < c[0].hearts { cm_kick(g, CM_KICK_HIT, true); }
  hp := g[0].bt[0].bots[SB_SNIPER].vit.hp;
  if hp < c[0].snip && g[0].mode == M_DRIVE { cm_kick(g, CM_KICK_CLAW, true); }
  c[0].hearts = g[0].hearts; c[0].snip = hp;
  // the widening: at her walking speed on foot, at Sniper's top speed on the drive (the board has its own)
  want := ifx g[0].calm then 0.0f32 else ifx g[0].mode == M_DRIVE then CM_DRIVE_FOV * clamp(abs(dv_speed(g)) / DV_TOP, 0, 1) else ifx g[0].mode == M_PLAY && !g_riding(g) then CM_RUN_FOV * clamp(g[0].fl[0].speed / T_WALK, 0, 1) else 0.0f32;
  c[0].run += (want - c[0].run) * lo(1, dt * 3 / CM_FOV_TIME);
}
// A kick of `size` metres, down (a landing) or sideways (a hit); none with reduced motion.
cm_kick :: (g: [] SpGame, size: f32, side: bool) {
  c := g[0].cam[..];
  if g[0].calm || (c[0].kick_t < CM_KICK_TIME && c[0].kick > size) { return; }
  c[0].kick = lo(size, CM_KICK_MAX * (ifx side then 1.2f32 else 1.0f32)); c[0].kick_t = 0; c[0].kick_side = side;
}
// The drawn view: the blend from the last camera, the widening and the kick on the camera's own view.
cm_mix :: (g: [] SpGame, raw: CamNow) -> CamNow {
  c := g[0].cam[0]; v := raw;
  if c.bl > 0 { k := 1 - c.bl; k = k * k * (3 - 2 * k); v = CamNow.{eye = mix(c.bl_from.eye, v.eye, k), at = mix(c.bl_from.at, v.at, k), fov = lerp(c.bl_from.fov, v.fov, k)}; }
  v.fov += c.run;
  if c.kick_t < CM_KICK_TIME && !g[0].calm {
    u := 1 - c.kick_t / CM_KICK_TIME; a := c.kick * u * u * sin(c.kick_t * CM_KICK_RATE);
    d := sub(v.at, v.eye); s := unit_or(v3(d.z, 0, -d.x), v3(1, 0, 0));
    off := ifx c.kick_side then times(s, a) else v3(0, -a, 0);
    v.eye = add(v.eye, off); v.at = add(v.at, off);
  }
  return v;
}
// The page drew view v: the next change of camera blends from it.
cm_seen :: (g: [] SpGame, v: CamNow) { g[0].cam[0].last = v; g[0].cam[0].seen = true; }
// Reduced motion on the pause screen: a click on its row switches it (hud.coax hv_pause).
CM_CALM_KEY :: 2001;
cm_calm_click :: (g: [] SpGame, x: f32, y: f32) -> bool {
  i := hv_btn(g, CM_CALM_KEY);
  if i < 0 || !in_box(g[0].btn[..], i * 4, x, y) { return false; }
  g[0].calm = !g[0].calm; return true;
}

// ---- What walks with her keeps out of the camera's way (owner's rule, playtest 2): Digger and the
// drill mech follow at her side or a little ahead, never between the camera and her.
CM_LINE_PAD :: 0.4f32;   // m kept between a body and the camera's line to her
// The camera's line to her, on the ground: from her to under the eye, and its length.
CmLine :: struct { x: f32; z: f32; dx: f32; dz: f32; span: f32; }
cm_line :: (g: [] SpGame) -> CmLine {
  c := g[0].cam[0];
  out := ifx c.ready then c.dist * cos(c.rise) else cm_want(g);   // the eased boom, flat
  dx := -sin(g[0].yaw) * out; dz := -cos(g[0].yaw) * out; span := sqrt(dx * dx + dz * dz);
  if span < 0.0001 { return CmLine.{x = g[0].px, z = g[0].pz}; }
  return CmLine.{x = g[0].px, z = g[0].pz, dx = dx / span, dz = dz / span, span = span};
}
// How far along the line and to its side (positive to its left, seen from her) a point is.
cm_along :: (l: CmLine, x: f32, z: f32) -> f32 { return (x - l.x) * l.dx + (z - l.z) * l.dz; }
cm_side :: (l: CmLine, x: f32, z: f32) -> f32 { return (x - l.x) * l.dz - (z - l.z) * l.dx; }
// Whether a body of radius r at (x, z) stands in the camera's line to her.
cm_in_line :: (l: CmLine, x: f32, z: f32, r: f32) -> bool {
  if l.span < 0.0001 { return false; }   // the camera at her head: no line to stand in
  a := cm_along(l, x, z);
  if a < 0 || a > l.span + r { return false; }
  return abs(cm_side(l, x, z)) < r + CM_LINE_PAD;
}
// Where a body of radius r at (bx, bz) goes to follow her: `side` metres to her left and `ahead`
// ahead, or as far to her right when it is on her right, so it never crosses her or the line to
// reach a spot; the other side when its own spot is in the line. A body standing in the line first
// steps out of it, sideways and up toward her, to the side it is on.
cm_follow_spot :: (g: [] SpGame, bx: f32, bz: f32, r: f32, side: f32, ahead: f32) -> Point {
  y := g[0].yaw; l := cm_line(g);
  left := v3(g[0].px + sin(y) * ahead + cos(y) * side, 0, g[0].pz + cos(y) * ahead - sin(y) * side);
  right := v3(g[0].px + sin(y) * ahead - cos(y) * side, 0, g[0].pz + cos(y) * ahead + sin(y) * side);
  if l.span < 0.0001 { return left; }
  s := cm_side(l, bx, bz);
  if cm_in_line(l, bx, bz, r) {
    // out past the line by more than a follower stops short of its spot, and up toward her as it goes
    a := cm_along(l, bx, bz) * 0.5; k := ifx s >= 0 then 1.0f32 else -1.0f32; out := r + CM_LINE_PAD + CM_HAND * 2;
    return v3(l.x + l.dx * a + l.dz * out * k, 0, l.z + l.dz * a - l.dx * out * k);
  }
  // the spot on the side it is on, so it never crosses her or the line to reach the other
  on_left := (s >= 0) == (cm_side(l, left.x, left.z) >= 0);
  pick := ifx on_left || abs(s) < 0.05 then left else right;
  if cm_in_line(l, pick.x, pick.z, r) { pick = ifx pick.x == left.x && pick.z == left.z then right else left; }
  return pick;
}
// How fast a follower goes, times its pace: as fast as it can while it stands in the camera's line.
cm_follow_pace :: (g: [] SpGame, bx: f32, bz: f32, r: f32, pace: f32) -> f32 { return ifx cm_in_line(cm_line(g), bx, bz, r) then 1.6f32 else pace; }
