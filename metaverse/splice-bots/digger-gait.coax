// The Digger's walk as the game drives it (digger.coax draws it; GitHub #13505).
// The Digger's stride from how far he went since the last frame drawn: the phase moves with the
// ground covered (a stride about 1.1 m) and the amount eases toward his speed over a quarter second.
DG_TURN_EASE :: 9.0f32;   // how fast his drawn heading follows his heading (a second)
dg_gait :: (g: [] SpGame, t: f32) {
  dt := t - g[0].dg_t; dx := g[0].bot_x - g[0].dg_x; dz := g[0].bot_z - g[0].dg_z;
  g[0].dg_t = t; g[0].dg_x = g[0].bot_x; g[0].dg_z = g[0].bot_z;
  d := sqrt(dx * dx + dz * dz);
  if dt <= 0 || dt > 0.5 || d > 3 { g[0].dg_yaw = g[0].bot_yaw; return; }   // a jump back to the checkpoint is not a step
  // he turns toward his heading rather than snapping to it, and a turn on the spot is steps too
  dy := g[0].bot_yaw - g[0].dg_yaw; dy = atan2(sin(dy), cos(dy));
  turn := dy * clamp01(dt * DG_TURN_EASE); g[0].dg_yaw += turn;
  d += abs(turn) * 0.35;   // metres a foot moves as he turns
  g[0].dg_walk += d * 2 * PI / 1.1;
  if g[0].dg_walk > 2 * PI * 64 { g[0].dg_walk -= 2 * PI * 64; }
  want := clamp01(d / dt / 4);
  g[0].dg_amp += (want - g[0].dg_amp) * clamp01(dt * (ifx want < g[0].dg_amp then 7.0f32 else 4.0f32));   // he stops crisper than he sets off
}
