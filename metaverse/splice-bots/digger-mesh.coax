// The Digger's mesh (GitHub #13505): the designer's Tripo model, decimated to 29998 triangles (normals
// smooth by angle) and baked to one flat base colour in Blender, each triangle given the nearest of four
// cel fills (yellow, ink, cream, steel) so the game's cel pass and ink overlay light it as they light
// the kit. Written by metaverse/splice-bots/tools/digger-rig.py from the rigged model's source
// (metaverse/splice-bots/assets/digger-rigged.glb); do not edit by hand. Model units: 1 = 0.981 m long,
// the nose (the drill box) ahead (+z).
// The triangles are one bit stream a fill, read in order as digger.coax draws them (the script says
// how a corner is written): a corner copies the vertex an earlier corner wrote, or is a new vertex.
// DGM_FILL_END[k] is where fill k's triangles end, DGM_BODY_END[k] where its legs' begin, and
// DGM_FILL_CHAR[k] the character fill k's stream starts on; the stream is dgm_s's pieces of DGM_PIECE.
DGM_SPAN :: 0.600;
DGM_NB :: 7; DGM_KD :: 3; DGM_KP :: 3; DGM_RING :: 4096;
DGM_VERTS :: 27321; DGM_TRIS :: 29998; DGM_CHARS :: 196360;
DGM_FILL_END :: [4] int.[4086, 29195, 29998, 29998];
DGM_BODY_END :: [4] int.[3293, 15713, 29698, 29998];
DGM_FILL_CHAR :: [5] int.[0, 27440, 190094, 196360, 196360];
DGM_BONES :: 12;
// Each bone: its parent (-1: none), its pivot (where it turns) in model units.
DGM_PARENT :: [DGM_BONES] int.[-1, 0, 1, 1, 1, 1, 1, 1, 4, 5, 6, 7];
DGM_PIVOT :: (b: int) -> Point {
  pivots := [DGM_BONES] Point.[v3(0.0000, 0.0000, 0.0000), v3(0.0000, 0.4200, -0.2600), v3(0.0000, 0.4200, 0.2800), v3(0.0000, 0.4400, -0.3000), v3(-0.1402, 0.3800, 0.0921), v3(0.1396, 0.3800, 0.0944), v3(-0.1039, 0.3800, -0.2925), v3(0.1028, 0.3800, -0.2952), v3(-0.1402, 0.1900, 0.0848), v3(0.1396, 0.1900, 0.0876), v3(-0.1039, 0.1900, -0.3206), v3(0.1028, 0.1900, -0.3238)];
  return pivots[b];
}
DGM_PIECE :: 8192;
dgm_s :: (k: int) -> string {
