// The Digger's mesh (GitHub #13505): the designer's Tripo model, decimated to 6633 triangles and baked to one
// flat base colour in Blender, each triangle given the nearest of four cel fills (yellow, ink, cream,
// steel) so the game's cel pass and ink overlay light it as they light the kit. Written by
// metaverse/splice-bots/tools/digger-rig.py from metaverse/splice-bots/assets/digger-rigged.glb's
// source; do not edit by hand. Model units: 1 = 0.977 m long, the nose (the drill box) ahead (+z).
// A vertex is 9 characters of the base64 alphabet: x, y, z as two each (12 bits over DGM_SPAN), the
// normal as two (octahedral, 6 bits each) and its bone as one. A triangle is 9: three 18-bit indices.
// The tables are in pieces of DGM_PIECE records (dgm_v, dgm_t). The triangles are sorted by fill: DGM_FILL_END[k] is where fill k ends.
DGM_SPAN :: 0.600;
DGM_VERTS :: 3375; DGM_TRIS :: 6633;
DGM_FILL_END :: [4] int.[1113, 6442, 6633, 6633];
DGM_BONES :: 12;
// Each bone: its parent (-1: none), its pivot (where it turns) in model units.
DGM_PARENT :: [DGM_BONES] int.[-1, 0, 1, 1, 1, 1, 1, 1, 4, 5, 6, 7];
DGM_PIVOT :: (b: int) -> Point {
  pivots := [DGM_BONES] Point.[v3(0.0000, 0.0000, 0.0000), v3(0.0000, 0.4200, -0.2600), v3(0.0000, 0.4200, 0.2800), v3(0.0000, 0.4400, -0.3000), v3(-0.1486, 0.3800, 0.0880), v3(0.1434, 0.3800, 0.0822), v3(-0.1070, 0.3800, -0.2882), v3(0.1001, 0.3800, -0.2885), v3(-0.1486, 0.1900, 0.0800), v3(0.1434, 0.1900, 0.0732), v3(-0.1070, 0.1900, -0.3155), v3(0.1001, 0.1900, -0.3158)];
  return pivots[b];
}
DGM_PIECE :: 900;   // records in one piece of a table
dgm_v :: (k: int) -> string {
  if k == 0 { return ""; }
  if k == 1 { return ""; }
  if k == 2 { return ""; }
  if k == 3 { return ""; }
  return "";
}
dgm_t :: (k: int) -> string {
  if k == 0 { return ""; }
  if k == 1 { return ""; }
  if k == 2 { return ""; }
  if k == 3 { return ""; }
  if k == 4 { return ""; }
  if k == 5 { return ""; }
  if k == 6 { return ""; }
  if k == 7 { return ""; }
  return "";
}
