// Commanding Digger (GitHub #13552, lane D): what the crosshair has selected, whether he can do it,
// his answer, the marker on his target, and how he moves while he does it.
//
//   Selecting   like a block game on a controller: look at it. The selection is forgiving (a cone that
//               widens with distance) and sticky: what is selected keeps a wider cone (T_AIM_KEEP), so
//               two things close together never flicker. The reticle names the command it would give
//               (DIG, PICK UP, ATTACK) or why not (BAG FULL, NO WAY THERE, ...), and corners frame it.
//   Answering   every click is answered at once: a nod and a click sound when he takes it, a head shake,
//               a glitch sound and the reason when he can't (down, bag full, nothing there, no way
//               there, a wall only the drill mech breaks, a cut with parts missing).
//   The marker  a ring on the target's ground: it snaps in (taken), turns dashed (on his way), pulses
//               (at work), opens out green (done); a cross for a refusal.
//   Drilling    a drill card: he rears back as the bit spins up (T_BITE of the card), bites in with the
//               drill sound, shudders while the rock shakes, chips and loosens, then the break throws
//               him back and he settles. DRILL+ spins faster, shakes harder and breaks through in
//               T_PLUS_CARD of a card.
//   Attention   standing, his nose and sensor turn to her; on an order, to his target.
// The numbers are in the README's Digger tunables table.

T_AIM_KEEP :: 1.6f32;     // what is selected keeps a cone this many times wider
T_LEASH :: 45.0f32;       // metres from her: past this Digger lets an order go (the pointer reaches T_POINT_FAR)
T_ACK :: 0.35f32;         // seconds the marker snaps in before it shows his progress
T_NOD :: 0.5f32;          // seconds of his nod, or his head shake
T_MARK_FADE :: 0.8f32;    // seconds a done marker opens out, or a refusal's cross shows
T_BITE :: 0.18f32;        // the share of a drill card before the bit meets the rock
T_PLUS_CARD :: 0.7f32;    // DRILL+ breaks through in this share of a card
T_KICK :: 0.45f32;        // seconds of a strike's lunge or the break's recoil, back to standing
T_BURST :: 1.2f32;        // seconds the broken rubble flies
T_LOOK_EASE :: 6.0f32;    // how fast his nose turns to what he looks at (a second)
T_PATH_STEP :: 0.5f32;    // metres between the checks along his way to a target
// an order's state, for the marker
OS_NONE :: 0; OS_TAKEN :: 1; OS_GO :: 2; OS_WORK :: 3; OS_DONE :: 4; OS_NO :: 5;

// Where a target is, how big, and whether it is still there.
DAt :: struct { x: f32; y: f32; z: f32; s: f32; ok: bool; }
d_at :: (g: [] SpGame, kind: int, i: int) -> DAt {
  mine := g[0].zone == Z_MINE;
  if kind == DP_PICK && i >= 0 && i < PICKS { return DAt.{x = pick_x(g, i), y = 0.75, z = pick_z(g, i), s = 0.9, ok = !g[0].taken[i] && pick_zone(g, i) == g[0].zone}; }
  if kind == DP_SENSOR { m := d_sensor_at(g); return DAt.{x = m.x, y = 0.75, z = m.z, s = 0.9, ok = d_sensor_here(g)}; }
  if kind == DP_FOE && i >= 0 && i < FOES { return DAt.{x = g[0].fx[i], y = 1.0, z = g[0].fz[i], s = 1.0, ok = mine && g_foe_in(g, i)}; }
  if kind == DP_DIG && i == 0 { return DAt.{x = 0, y = 1.5, z = g[0].at.rubble_z, s = 3.0, ok = mine && !g[0].rubble_gone}; }
  if kind == DP_DIG && i == 1 { return DAt.{x = 0, y = 2.0, z = g[0].at.wall_z, s = 4.0, ok = mine && g[0].rubble_gone && !g[0].wall_gone}; }
  return DAt.{};
}
// What the crosshair is on: the thing nearest the ray for its size, the selected one with a wider cone.
d_pointed :: (g: [] SpGame) -> DPoint {
  // along the middle of the view, or the host's aim (message 622: from the eye in first person, her head in third)
  v := d_view(g);
  if g[0].haim_on { v = g[0].haim; v.w = g[0].dr[0].sw; v.h = g[0].dr[0].sh; }
  r := vp_ray(v, g[0].dr[0].sw * 0.5, g[0].dr[0].sh * 0.5);
  out := DPoint.{kind = DP_NONE, i = -1};
  if !r.ok { return out; }
  best := [1] f32.[2]; sel := g[0].dr[0].sel;
  for kind: DP_PICK..<DP_SENSOR + 1 {
    n := ifx kind == DP_PICK then PICKS else ifx kind == DP_FOE then FOES else ifx kind == DP_DIG then 2 else 1;
    for j: 0..<n {
      i := ifx kind == DP_SENSOR then PICKS else j;
      a := d_at(g, kind, i);
      keep := ifx sel.kind == kind && sel.i == i then T_AIM_KEEP else 1.0f32;
      if a.ok && d_aim(r, a.x, a.y, a.z, a.s, keep, best[..]) { out = DPoint.{kind = kind, i = i}; }
    }
  }
  return out;
}
// Digger's way to a target, straight from him: false when something solid stands in it.
d_path :: (g: [] SpGame, p: DPoint) -> bool {
  a := d_at(g, p.kind, p.i); bx := g[0].bot_x; bz := g[0].bot_z;
  e := dist2(bx, bz, a.x, a.z) - 1.2;   // he stops short of it
  s := T_PATH_STEP;
  while s < e {
    u := s / (e + 1.2);
    if g_inside(g, bx + (a.x - bx) * u, bz + (a.z - bz) * u) { return false; }
    s += T_PATH_STEP;
  }
  return true;
}
// Why Digger can't take an order at p, or DS_NONE when he can.
DS_BLOCKED :: 25; DS_MECH :: 26; DS_PARTS :: 27;
d_can :: (g: [] SpGame, p: DPoint) -> int {
  if d_down(g) { return DS_DOWN; }
  if p.kind == DP_NONE { return DS_NOTHING; }
  if p.kind == DP_PICK && !d_fits(g, d_kind_of(p.i)) { return DS_FULL; }
  if p.kind == DP_DIG && p.i == 1 { return DS_MECH; }
  if p.kind == DP_DIG && !(g[0].slot[0] && g[0].slot[1] && g[0].slot[2] && g[0].strip_n > 0) { return DS_PARTS; }
  if p.kind != DP_DIG && !d_path(g, p) { return DS_BLOCKED; }
  return DS_NONE;
}
// The reticle's word: the command it would give, or why not.
d_label :: (p: DPoint, why: int) -> string {
  if why == DS_DOWN { return "DIGGER DOWN"; }
  if why == DS_FULL { return "BAG FULL"; }
  if why == DS_MECH { return "DRILL MECH ONLY"; }
  if why == DS_PARTS { return "NEEDS PARTS"; }
  if why == DS_BLOCKED { return "NO WAY THERE"; }
  return ifx p.kind == DP_DIG then "DIG" else ifx p.kind == DP_FOE then "ATTACK" else "PICK UP";
}
// His answer to a command: taken (a nod, a click, the marker snapping in) or refused (a shake, a
// glitch, a cross on the target, and the reason).
d_ack :: (g: [] SpGame, p: DPoint, why: int) {
  d := g[0].dr[..]; yes := why == DS_NONE;
  d[0].o_ack = 0; d[0].o_yes = yes; d[0].o_t = 0; d[0].o_kind = p.kind; d[0].o_i = p.i;
  a := d_at(g, p.kind, p.i);
  d[0].o_x = a.x; d[0].o_z = a.z; d[0].o_r = 0.4 + a.s * 0.9;
  d[0].o_st = ifx yes then OS_TAKEN else ifx p.kind == DP_NONE then OS_NONE else OS_NO;
  snd_play(g, ifx yes then SND_SLOT_CLICK else SND_GLITCH);
  if yes { return; }
  if why == DS_MECH { g_say(g, SBM_NEED_MECH); } else if why == DS_PARTS { g_say(g, MSG_NEED); } else { d_say(g, why); }
}
d_ord_set :: (g: [] SpGame, s: int) { g[0].dr[0].o_st = s; g[0].dr[0].o_t = 0; }
// Each step: the selection under the crosshair, the order's state, and where he looks.
d_ord_tick :: (g: [] SpGame, dt: f32) {
  d := g[0].dr[..];
  d[0].o_t += dt; d[0].o_ack += dt; d[0].o_kick += dt;
  d[0].sel = ifx g[0].mode == M_PLAY && g[0].bot then d_pointed(g) else DPoint.{kind = DP_NONE, i = -1};
  // where he looks: his target while he has an order, her while he stands, ahead while he walks
  lx := g[0].px; lz := g[0].pz; w := 1 - clamp01(g[0].dg_amp * 2.5);
  if d[0].o_st >= OS_TAKEN && d[0].o_st <= OS_WORK { lx = d[0].o_x; lz = d[0].o_z; w = 1; }
  f := frame_at(v3(0, 0, 0), g[0].dg_yaw); dx := lx - g[0].bot_x; dz := lz - g[0].bot_z;
  want := clamp(atan2(dx * f.x.x + dz * f.x.z, dx * f.z.x + dz * f.z.z), -0.55, 0.55) * w;
  d[0].o_look += (want - d[0].o_look) * clamp01(dt * T_LOOK_EASE);
  s := d[0].o_st;
  if s == OS_DONE || s == OS_NO { if d[0].o_t > T_MARK_FADE { d_ord_set(g, OS_NONE); } return; }
  if s == OS_NONE { return; }
  k := d[0].o_kind;
  if k == DP_DIG && g[0].bot_state == BOT_FAIL { d_ord_set(g, OS_NO); return; }   // a bad cut
  on := ifx k == DP_DIG then g[0].bot_state == BOT_GO || g[0].bot_state == BOT_RUN
        else d[0].task == (ifx k == DP_FOE then DJ_FIGHT else DJ_FETCH) && d[0].task_i == d[0].o_i;
  if !on { d_ord_set(g, OS_DONE); return; }
  a := d_at(g, k, d[0].o_i); if a.ok { d[0].o_x = a.x; d[0].o_z = a.z; }   // a robot moves: the marker goes with it
  near := ifx k == DP_FOE then T_STRIKE_REACH else T_FETCH_REACH;
  work := ifx k == DP_DIG then g[0].bot_state == BOT_RUN else dist2(g[0].bot_x, g[0].bot_z, d[0].o_x, d[0].o_z) <= near + 0.3;
  want_s := ifx work then OS_WORK else OS_GO;
  if (s != OS_TAKEN || d[0].o_t >= T_ACK) && s != want_s { d_ord_set(g, want_s); }
}

// ---- the drill card, in its phases
// The drill card under way: its share done (0 to 1), or -1 when he is not drilling.
d_drill_card :: (g: [] SpGame) -> int { return ifx g[0].bot_state == BOT_RUN && g[0].bot_step >= 0 && g[0].bot_step < g[0].strip_n then g[0].strip[g[0].bot_step] else -1; }
d_card_len :: (card: int) -> f32 { return ifx card == H_PLUS then T_CARD_TIME * T_PLUS_CARD else T_CARD_TIME; }
d_drill_u :: (g: [] SpGame) -> f32 {
  c := d_drill_card(g);
  face := ifx g[0].bot_wall then g[0].at.wall_z + 1 else g[0].at.rubble_z + 1;
  if (c != H_DRILL && c != H_PLUS) || g[0].bot_z - face > T_DRILL_REACH { return -1; }
  return clamp01(g[0].bot_t / d_card_len(c));
}
// His body this frame: the nod or shake, the drill's windup, bite and shudder, a strike's lunge or
// the break's recoil, and where he looks (digger.coax dg_pose).
d_act :: (g: [] SpGame) -> DgAct {
  d := g[0].dr[0]; t := g[0].t; a := DgAct.{turn = d.o_look};
  if d.o_ack < T_NOD {
    u := d.o_ack / T_NOD;
    if d.o_yes { a.nod = 0.25 * sin(u * TAU) * (1 - u * 0.5); } else { a.turn += 0.32 * sin(u * 3 * TAU) * (1 - u); }
  }
  u := d_drill_u(g);
  if u >= 0 {
    f := ifx d_drill_card(g) == H_PLUS then 1.6f32 else 1.0f32;
    if u < T_BITE { w := u / T_BITE; a.pitch = -0.14 * w; a.push = -0.06 * w; }   // he rears back as the bit spins up
    else {
      e := clamp01((u - T_BITE) * 16);   // and bites in, shuddering harder as the rock gives
      a.push = 0.10 * e + 0.012 * f * sin(t * 41); a.pitch = 0.05 * e + 0.025 * f * (0.4 + u) * sin(t * 53);
    }
  }
  if d.o_kick < T_KICK { b := sin(PI * d.o_kick / T_KICK) * (1 - 0.5 * d.o_kick / T_KICK); a.push += d.o_kd * 0.16 * b; a.pitch += d.o_kd * 0.12 * b; }
  return a;
}
// The drill bit's spin a second: up to speed through the windup, faster with DRILL+.
d_spin_rate :: (g: [] SpGame) -> f32 {
  u := d_drill_u(g);
  if u < 0 { return ifx d_drill_card(g) == H_DRILL || d_drill_card(g) == H_PLUS then 22.0f32 else 0.0f32; }
  return 22 * (0.25 + 0.75 * clamp01(u / T_BITE)) * (ifx d_drill_card(g) == H_PLUS then 1.6f32 else 1.0f32);
}
// The break: he is thrown back (harder with DRILL+) and the rubble flies.
d_broke :: (g: [] SpGame, plus: bool) { d := g[0].dr[..]; d[0].o_kick = 0; d[0].o_kd = ifx plus then -1.5f32 else -1.0f32; d[0].o_burst = 0; d[0].o_plus = plus; }

// ---- drawing
// The marker on his target's ground, by the order's state.
d_mark_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  d := g[0].dr[0]; s := d.o_st;
  if s == OS_NONE { return; }
  t := g[0].t; u := d.o_t; r := d.o_r; y := ground_y(g, d.o_x, d.o_z) + 0.05;
  if s == OS_NO {
    if fract(t * 6) > 0.75 { return; }
    kit_pen(p, 242, MAT_GLOW, t3(0.92, 0.22, 0.16));
    for k: 0..<2 { box(buf, p, frame_at(v3(d.o_x, y, d.o_z), PI * (0.25 + 0.5 * cast(f32) k)), r * 0.6, 0.03, 0.09); }
    return;
  }
  c := t3(1.0, 0.50, 0.16); w := 0.07f32; spin := 0.0f32; dash := false;
  if s == OS_TAKEN { r *= 1 + 0.6 * clamp01(1 - u / T_ACK); w = 0.1; }
  if s == OS_GO { dash = true; spin = t * 1.6; }
  if s == OS_WORK { r *= 1 + 0.07 * sin(t * 12); w = 0.1; c = t3(1.0, 0.68, 0.22); }
  if s == OS_DONE { e := clamp01(u / T_MARK_FADE); r *= 1 + e * 0.8; w = 0.09 * (1 - e) + 0.01; c = t3(0.45, 0.86, 0.50); }
  kit_pen(p, 242, MAT_GLOW, c);
  for j: 0..<16 {
    if dash && j % 2 == 1 { continue; }
    a := spin + TAU * cast(f32) j / 16;
    box(buf, p, frame_at(v3(d.o_x + sin(a) * r, y, d.o_z + cos(a) * r), a), r * PI / 16 * (ifx dash then 0.8f32 else 1.05f32), 0.03, w);
  }
}
// Chips off the rock face while the bit is in it, more with DRILL+.
d_chips_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  u := d_drill_u(g);
  if u < T_BITE || g[0].bot_wall { return; }
  t := g[0].t; plus := d_drill_card(g) == H_PLUS; rz := g[0].at.rubble_z + 1.0;
  kit_pen(p, 243, MAT_WORLD, ifx plus then t3(0.62, 0.70, 0.86) else t3(0.70, 0.52, 0.40));
  for j: 0..<(ifx plus then 14 else 8) {
    f := cast(f32) j + 130; v := fract(t * 2.4 + kit_rand(f));
    x := g[0].bot_x + (kit_rand(f + 1) - 0.5) * 2.4 * v;
    ball(buf, p, v3(x, 0.8 + 2.6 * v - 4.9 * v * v, rz + v * (0.8 + kit_rand(f + 2) * 1.2)), (0.05 + kit_rand(f + 3) * 0.05) * (ifx plus then 1.4f32 else 1.0f32), 4);
  }
}
// The broken rubble flying: its rocks thrown into the tunnel and down, gone in T_BURST.
d_burst_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  d := g[0].dr[0];
  if d.o_burst >= T_BURST || !g[0].rubble_gone || g[0].zone != Z_MINE { return; }
  u := d.o_burst; e := 1 - u / T_BURST; rz := g[0].at.rubble_z; m := ifx d.o_plus then 1.4f32 else 1.0f32;
  kit_pen(p, 244, MAT_WORLD, t3(0.56, 0.36, 0.28));
  for j: 0..<18 {
    f := cast(f32) j + 160;
    y := hi(0.15, 0.6 + kit_rand(f) * 4.6 + kit_rand(f + 1) * 3 * m * u - 4.9 * u * u);
    ball(buf, p, v3(-2.6 + kit_rand(f + 2) * 5.2 + (kit_rand(f + 3) - 0.5) * 4 * m * u, y, rz - (1.5 + kit_rand(f + 4) * 4) * m * u), (0.2 + kit_rand(f + 5) * 0.35) * e, 5);
  }
}
// The selection on screen: corners round the selected thing, and under the reticle the command it
// would give (orange) or why not (pale).
d_select_hud :: (g: [] SpGame, out: [] f32, q: Ui, at: int, cx: f32, cy: f32) -> int {
  n := at; k := q.k; d := g[0].dr[0];
  if d.sel.kind == DP_NONE { return n; }
  why := d_can(g, d.sel); c := ifx why == DS_NONE then HEAT() else PAPER();
  a := d_at(g, d.sel.kind, d.sel.i); v := d_view(g);
  s0 := vp_project(v, a.x, a.y, a.z); s1 := vp_project(v, a.x, a.y + a.s * 0.55, a.z);
  if s0.ok && s1.ok {
    h := clamp(abs(s1.y - s0.y), 16 * k, q.h * 0.3); l := h * 0.4;
    for sx: 0..<2 { for sy: 0..<2 {
      x := s0.x + (cast(f32) sx * 2 - 1) * h; y := s0.y + (cast(f32) sy * 2 - 1) * h;
      n = ui_seg(out, n, x, y, x - (cast(f32) sx * 2 - 1) * l, y, 1.6 * k, c, 0.95);
      n = ui_seg(out, n, x, y, x, y - (cast(f32) sy * 2 - 1) * l, 1.6 * k, c, 0.95);
    } }
  }
  t := d_label(d.sel, why); w := ui_w(F_MONO, t, 8 * k) * 0.5 + 8 * k; y := cy + 30 * k;
  n = ui_seg(out, n, cx - w + 7 * k, y, cx + w - 7 * k, y, 9 * k, INK(), 0.85);
  return ui_mid(out, n, t, cx, y + 3.5 * k, 8 * k, c);
}

#test "Digger's orders: the selection holds against a nearer neighbour, far fights last, refusals say why" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 8); g[0].mode = M_PLAY; g[0].look_free = false;
  g[0].px = 0; g[0].pz = -10; g[0].yaw = PI; g_bot_home(g[..]);
  #assert g_foe_in(g[..], 5) && g_foe_in(g[..], 6);
  // two robots side by side on the crosshair's ray, 6 the nearer to it
  r := vp_ray(d_view(g[..]), g[0].dr[0].sw * 0.5, g[0].dr[0].sh * 0.5);
  t := ifx abs(r.d.y) > 0.01 then clamp((1 - r.o.y) / r.d.y, 6, 20) else 12.0f32;
  sl := sqrt(r.d.x * r.d.x + r.d.z * r.d.z); sx := -r.d.z / sl; sz := r.d.x / sl;
  px := r.o.x + r.d.x * t; pz := r.o.z + r.d.z * t;
  g[0].fx[5] = px + sx * 0.35; g[0].fz[5] = pz + sz * 0.35; g[0].fx[6] = px - sx * 0.25; g[0].fz[6] = pz - sz * 0.25;
  #assert d_pointed(g[..]).kind == DP_FOE && d_pointed(g[..]).i == 6;   // fresh: the nearer one
  g[0].dr[0].sel = DPoint.{kind = DP_FOE, i = 5};
  #assert d_pointed(g[..]).i == 5;                                         // selected: it stays
  // a robot far off: he goes to it and doesn't give up on the way
  g[0].fx[6] = 200; g[0].fz[6] = 200;
  g[0].fx[5] = g[0].px; g[0].fz[5] = g[0].pz - 35;
  d := g[0].dr[..]; d[0].task = DJ_FIGHT; d[0].task_i = 5;
  z0 := g[0].bot_z;
  for i: 0..<20 { d_bot(g[..], 0.05); }
  #assert d[0].task == DJ_FIGHT && g[0].bot_z < z0 - 3;
  d_task_end(g[..]);
  // a robot behind something solid: no way there
  found := false; qx := 0.0f32; qz := 0.0f32;
  for i: 0..<60 { for j: 0..<60 {
    if found { break; }
    x := -60 + cast(f32) i * 2; z := -60 + cast(f32) j * 2;
    if g_inside(g[..], x, z) && !g_inside(g[..], x - 4, z) && !g_inside(g[..], x + 4, z) && !g_inside(g[..], x + 6, z) { found = true; qx = x; qz = z; }
  } }
  #assert found;
  g[0].bot_x = qx - 4; g[0].bot_z = qz; g[0].fx[5] = qx + 4; g[0].fz[5] = qz;
  #assert d_can(g[..], DPoint.{kind = DP_FOE, i = 5}) == DS_BLOCKED;
  g[0].fx[5] = qx - 6; #assert d_can(g[..], DPoint.{kind = DP_FOE, i = 5}) == DS_NONE;
  #assert d_label(DPoint.{kind = DP_FOE, i = 5}, DS_NONE) == "ATTACK" && d_label(DPoint.{kind = DP_DIG, i = 1}, DS_MECH) == "DRILL MECH ONLY";
}
#test "Digger's orders: a click is answered at once, the marker goes taken, on his way, done; the hallway wall is refused up front" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].mode = M_PLAY; g[0].look_free = false;
  g[0].px = pick_x(g[..], H_DRILL); g[0].pz = pick_z(g[..], H_DRILL) + 9; g[0].yaw = PI; g_bot_home(g[..]);
  #assert d_point(g[..]) == DP_PICK && g[0].dr[0].o_st == OS_TAKEN && g[0].dr[0].o_ack == 0 && g[0].snd[0].fired[SND_SLOT_CLICK] == 1;
  seen: [6] bool;
  for i: 0..<300 { g_step(g[..], 0.02); seen[g[0].dr[0].o_st] = true; if g[0].have[H_DRILL] && g[0].dr[0].o_st == OS_NONE { break; } }
  #assert g[0].have[H_DRILL] && seen[OS_GO] && seen[OS_DONE];
  // nothing there: a shake and the reason, no marker
  g[0].yaw = 0; g[0].px = 0; g[0].pz = 4;
  #assert d_point(g[..]) == DP_NONE && g[0].dr[0].say == DS_NOTHING && !g[0].dr[0].o_yes && g[0].snd[0].fired[SND_GLITCH] >= 1;
  // the hallway wall: only the drill mech breaks it, so he says so and stays
  for i: 0..<3 { g[0].have[i] = true; g[0].slot[i] = true; }
  g[0].strip[0] = H_MOVE; g[0].strip[1] = H_DRILL; g[0].strip_n = 2; g[0].rubble_gone = true;
  g[0].px = 0; g[0].pz = g[0].at.wall_z + 8; g[0].yaw = PI; g_bot_home(g[..]);
  #assert d_pointed(g[..]).kind == DP_DIG && d_pointed(g[..]).i == 1;
  #assert d_point(g[..]) == DP_NONE && g[0].msg == SBM_NEED_MECH && g[0].bot_state == BOT_FOLLOW && g[0].dr[0].o_st == OS_NO;
}
#test "Digger's drill: it bites in after its windup with the drill sound, DRILL+ breaks through sooner and throws him back harder" #steps 200000000 {
  #assert d_card_len(H_PLUS) < d_card_len(H_DRILL);
  for plus: 0..<2 {
    g := [1] SpGame.[SpGame.{}];
    g_stage(g[..], 5);
    for i: 0..<5 { g[0].have[i] = true; } for i: 0..<3 { g[0].slot[i] = true; }
    g[0].bot = true; g[0].px = 0; g[0].pz = g[0].at.rubble_z + 6; g_bot_home(g[..]);
    g[0].strip[0] = H_MOVE; g[0].strip[1] = ifx plus == 1 then H_PLUS else H_DRILL; g[0].strip_n = 2;
    g_deploy(g[..]);
    drilled := 0.0f32; bit := false;
    for i: 0..<600 {
      if g[0].rubble_gone { break; }
      u := d_drill_u(g[..]);
      if u >= 0 { drilled += 0.02; if u < T_BITE { #assert g[0].snd[0].fired[SND_DRILL] == 0; } else { bit = true; } }
      g_bot(g[..], 0.02);
    }
    #assert g[0].rubble_gone && bit && g[0].snd[0].fired[SND_DRILL] == 1;
    #assert abs(drilled - d_card_len(g[0].strip[1])) < 0.1;
    #assert g[0].dr[0].o_kick == 0 && g[0].dr[0].o_kd == (ifx plus == 1 then -1.5f32 else -1.0f32);
    a := d_act(g[..]); #assert a.push == 0;   // the recoil starts from standing
    g[0].dr[0].o_kick = T_KICK * 0.5; a = d_act(g[..]); #assert a.push < 0 && a.pitch < 0;   // thrown back, nose up
  }
}
