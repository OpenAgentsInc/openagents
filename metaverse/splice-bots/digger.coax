// The Digger drawn from the designer's model (GitHub #13505): a yellow and black dog-bot on four legs
// with the drill box for a nose, its triangles from digger-mesh.coax. Its rig is the mesh's bones
// (a root, the body, the nose, the rear sensor, and each leg's thigh and shin), turned here each
// frame: the walk swings the legs in diagonal pairs and bobs the body, and standing it breathes and
// the sensor looks about. Each triangle is drawn with the cel kit's pen in one of four fills, so the
// game's cel pass and ink overlay light it as they light the kit, and the Unreal exporter bakes it
// from these vertices as it bakes every thing (splice-export.coax).
//   coax/bin/coax test metaverse/splice-bots/splice-bots.coax --only "the Digger's mesh"
#load "digger-mesh.coax";

DG_LONG :: 2.54;   // metres from tail to nose at scale 1 (the old kit Digger was 2.4 m to its drill's tip)
DG_EYE_GLOW :: 0.035;

// A bone's place: where its model points go (t + x p.x + y p.y + z p.z).
DgXf :: struct { x: Point; y: Point; z: Point; t: Point; }
dg_at :: (m: DgXf, p: Point) -> Point { return add(m.t, add(times(m.x, p.x), add(times(m.y, p.y), times(m.z, p.z)))); }
dg_dir :: (m: DgXf, p: Point) -> Point { return add(times(m.x, p.x), add(times(m.y, p.y), times(m.z, p.z))); }
// The parent's place after a turn by a about the unit axis k through c, then a shift d.
dg_child :: (parent: DgXf, k: Point, a: f32, c: Point, d: Point) -> DgXf {
  rx := turn(v3(1, 0, 0), k, a); ry := turn(v3(0, 1, 0), k, a); rz := turn(v3(0, 0, 1), k, a);
  rc := add(times(rx, c.x), add(times(ry, c.y), times(rz, c.z)));
  return DgXf.{x = dg_dir(parent, rx), y = dg_dir(parent, ry), z = dg_dir(parent, rz), t = dg_at(parent, add(sub(c, rc), d))};
}
// The mesh's stream (digger-mesh.coax): the piece being read, the next character, and the bits of
// the characters read that are not taken yet.
DgRd :: struct { piece: string; pk: int; ci: int; acc: int; nb: int; }
dg_rd_at :: (r: [] DgRd, c: int) { r[0].pk = c / DGM_PIECE; r[0].piece = dgm_s(r[0].pk); r[0].ci = c; r[0].acc = 0; r[0].nb = 0; }
// The next n bits, the high bit first. A character is 6: 64 to 126 for 0 to 62, '!' for 63, '#' for 28.
dg_bits :: (r: [] DgRd, n: int) -> int {
  while r[0].nb < n {
    o := r[0].ci - r[0].pk * DGM_PIECE;
    if o >= DGM_PIECE { r[0].pk += 1; r[0].piece = dgm_s(r[0].pk); o = 0; }
    c := cast(int) r[0].piece[o]; r[0].ci += 1;
    v := ifx c >= 64 then c - 64 else ifx c == 33 then 63 else 28;
    r[0].acc = ((r[0].acc & ((1 << r[0].nb) - 1)) << 6) | v; r[0].nb += 6;
  }
  r[0].nb -= n;
  return (r[0].acc >> r[0].nb) & ((1 << n) - 1);
}
// An Exp-Golomb number of order k, and a zigzagged one's sign.
dg_eg :: (r: [] DgRd, k: int) -> int {
  z := 0;
  while dg_bits(r, 1) == 0 { z += 1; }
  return ((1 << (z + k)) | dg_bits(r, z + k)) - (1 << k);
}
dg_unz :: (v: int) -> int { return ifx (v & 1) == 0 then v >> 1 else -((v + 1) >> 1); }
// An octahedral normal of DGM_NB bits a component, in model space.
dg_normal :: (ox: int, oz: int) -> Point {
  m := cast(f32) ((1 << DGM_NB) - 1);
  x := cast(f32) ox / m * 2 - 1; z := cast(f32) oz / m * 2 - 1;
  y := 1 - abs(x) - abs(z);
  if y < 0 { px := x; x = (1 - abs(z)) * (ifx px >= 0 then 1.0f32 else -1.0f32); z = (1 - abs(px)) * (ifx z >= 0 then 1.0f32 else -1.0f32); }
  l := sqrt(x * x + y * y + z * z);
  return ifx l > 0.0001 then v3(x / l, y / l, z / l) else v3(0, 1, 0);
}
// A bone's place this frame folded into the frame and the scale: a vertex's world point is
// a + ux qx + uy qy + uz qz from its 12-bit model place q, and its normal rx nx + ry ny + rz nz.
DgBone :: struct { a: Point; ux: Point; uy: Point; uz: Point; rx: Point; ry: Point; rz: Point; }
dg_bone_in :: (f: Frame, m: DgXf, k: f32, lift: f32) -> DgBone {
  q := k * 2 * DGM_SPAN / 4095;
  rx := fd(f, m.x.x, m.x.y, m.x.z); ry := fd(f, m.y.x, m.y.y, m.y.z); rz := fd(f, m.z.x, m.z.y, m.z.z);
  a := add(fp(f, m.t.x * k, (m.t.y + lift) * k, m.t.z * k), times(add(rx, rz), -k * DGM_SPAN));
  return DgBone.{a = a, ux = times(rx, q), uy = times(ry, q), uz = times(rz, q), rx = rx, ry = ry, rz = rz};
}

// The bones' places for this frame. walk: the stride's phase (radians); amp: how much he walks
// (0 standing, 1 at a run); t: seconds, for the standing breath and the sensor's look.
dg_pose :: (xf: [] DgXf, walk: f32, amp: f32, t: f32) {
  X := v3(1, 0, 0); Y := v3(0, 1, 0); none := v3(0, 0, 0);
  xf[0] = DgXf.{x = X, y = Y, z = v3(0, 0, 1), t = none};
  bob := (1 - amp) * 0.006 * sin(t * 2.2) + amp * 0.012 * abs(sin(walk));
  xf[1] = dg_child(xf[0], X, amp * 0.03 * sin(walk * 2), DGM_PIVOT(1), v3(0, bob, 0));
  xf[2] = dg_child(xf[1], X, (1 - amp) * 0.05 * sin(t * 1.3), DGM_PIVOT(2), none);
  xf[3] = dg_child(xf[1], Y, (1 - amp) * 0.35 * sin(t * 0.6), DGM_PIVOT(3), none);
  for leg: 0..<4 {
    ph := walk + ifx leg == 0 || leg == 3 then 0.0f32 else PI;   // front left with hind right, front right with hind left
    xf[4 + leg] = dg_child(xf[1], X, amp * 0.45 * sin(ph), DGM_PIVOT(4 + leg), none);
    xf[8 + leg] = dg_child(xf[4 + leg], X, -amp * 0.35 * hi(0, sin(ph + PI / 2)), DGM_PIVOT(8 + leg), none);
  }
}

// The fills: the model's yellow, its black, its cream plates and its steel.
dg_fill :: (k: int) -> KitTint {
  if k == 0 { return kit_tint(0.96, 0.70, 0.16); }
  if k == 1 { return kit_tint(0.17, 0.16, 0.17); }
  if k == 2 { return kit_tint(0.90, 0.86, 0.76); }
  return kit_tint(0.46, 0.46, 0.48);
}
dg_fill_mat :: (k: int) -> int { return ifx k == 1 then MAT_CLOTH else ifx k == 3 then MAT_FLAT else MAT_SKIN; }

// The Digger at frame f, scale s (DG_LONG metres long at 1), using objects obj to obj + 7. He is
// always drawn whole, so a half-built Digger reads as the dog he will be (playtest 2): a part not
// spliced in yet (the treads, his legs; the drill arm; the battery that lights his eyes) is drawn in
// the flat grey of an empty slot (DG_GHOST). spin turns the drill.
DG_GHOST :: () -> KitTint { return kit_tint(0.60, 0.60, 0.62); }
// Recolour the vertices from `from` to the pen's end in the grey (object obj, flat).
dg_grey :: (buf: [] u32, p: [] Pen, obj: int, from: int, m: CastMono) {
  n := p[0].n;
  ca_pen(p, obj, MAT_FLAT, DG_GHOST(), m);
  c := byte_of(p[0].r) | (byte_of(p[0].g) << 8) | (byte_of(p[0].b) << 16) | (cast(u32) (p[0].mat & 255) << 24);
  for v: from..<n {
    i := v * VERTEX_WORDS;
    buf[i + 3] = (buf[i + 3] & 0x00ffffff) | (cast(u32) (obj & 255) << 24);
    buf[i + 4] = c;
  }
}
dg_draw :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, glow: KitTint, arm: bool, treads: bool, battery: bool, spin: f32, m: CastMono, walk: f32, amp: f32, t: f32) {
  xf: [DGM_BONES] DgXf;
  dg_pose(xf[..], walk, ifx treads then clamp01(amp) else 0, t);
  k := s * DG_LONG;   // model units to metres
  lift := 0.0f32;
  bones: [DGM_BONES] DgBone;
  for b: 0..<DGM_BONES { bones[b] = dg_bone_in(f, xf[b], k, lift); }
  // Each fill's stream in order (digger-mesh.coax). A corner copies the vertex written d corners back,
  // or is a new vertex. The places (x, y, z, bone) of the last DGM_RING corners are kept for the new
  // ones' guesses; bone -1: a corner copied from further back, whose place is not kept.
  rd: [1] DgRd; ring: [DGM_RING * 4] s32;
  for fill: 0..<4 {
    start := ifx fill == 0 then 0 else DGM_FILL_END[fill - 1];
    stop := DGM_FILL_END[fill];
    leg := ifx treads then stop else DGM_BODY_END[fill];   // without treads, his legs (the fill's tail) go grey
    if stop <= start { continue; }
    ca_pen(p, obj + fill, dg_fill_mat(fill), dg_fill(fill), m);
    dg_rd_at(rd[..], DGM_FILL_CHAR[fill]);
    first := p[0].n; cur := 0; grey := -1;
    lx := 2048; ly := 1024; lz := 2048; lb := 1;   // the fill's last new vertex
    for tn: start..<stop {
      if !room(buf, p, 3) { return; }
      if tn == leg { grey = p[0].n; }
      gx := lx; gy := ly; gz := lz; gb := lb;   // the guess: the triangle's last corner with a place, or lx..lb
      for c: 0..<3 {
        slot := (cur % DGM_RING) * 4;
        if dg_bits(rd[..], 1) == 1 {
          d := dg_eg(rd[..], DGM_KD) + 1;
          src := (first + cur - d) * VERTEX_WORDS; dst := p[0].n * VERTEX_WORDS;
          for w: 0..<VERTEX_WORDS { buf[dst + w] = buf[src + w]; }
          p[0].n += 1;
          if d <= DGM_RING { o := ((cur - d) % DGM_RING) * 4; for w: 0..<4 { ring[slot + w] = ring[o + w]; } } else { ring[slot + 3] = -1; }
        } else {
          qx := 0; qy := 0; qz := 0; qb := 0;
          if dg_bits(rd[..], 1) == 1 {
            o := ((cur - dg_eg(rd[..], DGM_KD) - 1) % DGM_RING) * 4;
            qx = cast(int) ring[o]; qy = cast(int) ring[o + 1]; qz = cast(int) ring[o + 2]; qb = cast(int) ring[o + 3];
          } else {
            qx = gx + dg_unz(dg_eg(rd[..], DGM_KP)); qy = gy + dg_unz(dg_eg(rd[..], DGM_KP)); qz = gz + dg_unz(dg_eg(rd[..], DGM_KP));
            qb = ifx dg_bits(rd[..], 1) == 1 then gb else dg_bits(rd[..], 4);
          }
          ox := dg_bits(rd[..], DGM_NB); oz := dg_bits(rd[..], DGM_NB);
          ring[slot] = cast(s32) qx; ring[slot + 1] = cast(s32) qy; ring[slot + 2] = cast(s32) qz; ring[slot + 3] = cast(s32) qb;
          lx = qx; ly = qy; lz = qz; lb = qb;
          bn := bones[qb]; n := dg_normal(ox, oz);
          at := add(bn.a, add(times(bn.ux, cast(f32) qx), add(times(bn.uy, cast(f32) qy), times(bn.uz, cast(f32) qz))));
          vtx(buf, p, at, add(times(bn.rx, n.x), add(times(bn.ry, n.y), times(bn.rz, n.z))));
        }
        if ring[slot + 3] >= 0 { gx = cast(int) ring[slot]; gy = cast(int) ring[slot + 1]; gz = cast(int) ring[slot + 2]; gb = cast(int) ring[slot + 3]; }
        cur += 1;
      }
    }
    // the legs decode in the fill's stream (their corners copy earlier ones), so they are recoloured after
    if grey >= 0 { dg_grey(buf, p, obj + 6, grey, m); }
  }
  nose := xf[2];
  {   // the drill, out of the nose box's front; grey until the arm is spliced in
    a := dg_at(nose, v3(0, 0.36, 0.48)); b := dg_at(nose, v3(0, 0.36, 0.66));
    ap := fp(f, a.x * k, (a.y + lift) * k, a.z * k); bp := fp(f, b.x * k, (b.y + lift) * k, b.z * k);
    g := frame_turn(frame_along(ap, bp, fd(f, 1, 0, 0)), 1, spin);
    if arm { ca_pen(p, obj + 4, MAT_SKIN, dg_fill(0), m); } else { ca_pen(p, obj + 6, MAT_FLAT, DG_GHOST(), m); }
    tube(buf, p, kit_at(g, 0, 0.02 * k, 0), 0.17 * k, 0.05 * k, 0.05 * k, 0.004 * k, 0.004 * k, 6, true);
    if arm { ca_pen(p, obj + 5, MAT_CLOTH, CAST_INK(), m); }
    tube(buf, p, g, 0.025 * k, 0.055 * k, 0.055 * k, 0.06 * k, 0.06 * k, 10, true);
  }
  {   // the eyes on the nose box, lit by his cells; grey and dark without them
    if battery { ca_pen(p, obj + 7, MAT_GLOW, glow, m); } else { ca_pen(p, obj + 6, MAT_FLAT, DG_GHOST(), m); }
    for side: 0..<2 {
      e := dg_at(nose, v3((cast(f32) side - 0.5) * 0.12, 0.43, 0.485));
      ball(buf, p, fp(f, e.x * k, (e.y + lift) * k, e.z * k), DG_EYE_GLOW * k * 0.5, 6);
    }
  }
}


#test "the Digger's mesh: every triangle comes out of its stream, inside his box, and without treads his legs are drawn grey" #steps 2000000000 #traversal 2000000000 {
  buf: [DGM_TRIS * 3 * VERTEX_WORDS + 4000 * VERTEX_WORDS] u32;
  whole := [1] Pen.[Pen.{}];
  dg_draw(buf[..], whole[..], frame_at(v3(0, 0, 0), 0), 1, 10, CAST_AMBER(), false, true, false, 0, cast_colour(), 0, 0, 0);
  #assert !whole[0].over && whole[0].n > DGM_TRIS * 3;   // the mesh, then the grey drill and eyes
  for i: 0..<DGM_TRIS * 3 {
    x := f32_from_bits(buf[i * VERTEX_WORDS]); y := f32_from_bits(buf[i * VERTEX_WORDS + 1]); z := f32_from_bits(buf[i * VERTEX_WORDS + 2]);
    #assert abs(x) < 0.3 * DG_LONG && y > -0.01 && y < 0.7 * DG_LONG && abs(z) < 0.55 * DG_LONG;
  }
  body := 0; for k: 0..<4 { body += DGM_BODY_END[k] - (ifx k == 0 then 0 else DGM_FILL_END[k - 1]); }
  had: [DGM_TRIS * 3 * VERTEX_WORDS + 4000 * VERTEX_WORDS] u32;
  for i: 0..<whole[0].n * VERTEX_WORDS { had[i] = buf[i]; }
  half := [1] Pen.[Pen.{}];
  dg_draw(buf[..], half[..], frame_at(v3(0, 0, 0), 0), 1, 10, CAST_AMBER(), false, false, false, 0, cast_colour(), 0, 0, 0);
  #assert half[0].n == whole[0].n;   // the whole dog, no stands
  grey := 0; for i: 0..<half[0].n { if buf[i * VERTEX_WORDS + 4] != had[i * VERTEX_WORDS + 4] { grey += 1; } }
  #assert grey == (DGM_TRIS - body) * 3;   // exactly his legs
  // a store too small stops cleanly
  small := [1] Pen.[Pen.{}];
  dg_draw(buf[0..<3000 * VERTEX_WORDS], small[..], frame_at(v3(0, 0, 0), 0), 1, 10, CAST_AMBER(), true, true, true, 0, cast_colour(), 0.5, 1, 0);
  #assert small[0].over && small[0].n <= 3000;
}
