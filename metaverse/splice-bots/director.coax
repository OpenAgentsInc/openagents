// The Director's systems (GitHub #13505, part A): her keys, Digger at her side, what she carries,
// how far Imperial robots sense her, and the health of everyone.
//
//   Sneak       off for now: Shift does nothing until she has a crouch animation (#13552). The stance
//               (metaverse-engine/move/stance.coax) keeps the sneak's rules for when it comes back.
//   Hoverboard  everything on Q (#13505, Nov 13): Q calls the board up at casual speed, then each Q
//               switches casual and fast; a double tap of Q is super fast; holding Q steps off (the
//               engine's board, metaverse-engine/action/hoverboard.coax, and its board_super_cms).
//   Digger      follows her and picks up any part in his sensor's range himself; she can't choose. A
//               better sensor (the landmark LM_SENSOR) widens his range. A left click points him at
//               what is under the crosshair: he digs it, picks it up or attacks it. At zero health he
//               powers down; E tows him, and Sniper's charger charges him back up (the engine's
//               vitals, metaverse-engine/action/vitals.coax). A battery cell she carries charges him
//               full wherever he is: E beside him, CHARGE on the bot wheel, or a click on her CELLS.
//   Inventory   I: a grid of T_ROOM slots (the engine's carry, metaverse-engine/action/carry.coax).
//               Hardware spliced into Digger and cards on his strip are his, not hers. A click on a
//               slot drops what is in it at her feet; Digger leaves it until she walks away from it.
//   Heat        never cools below T_HEAT_PIECE for each banned piece with her; the more Heat, the
//               farther robots sense her.
//   Map         M: the deep-garage map: the garage's ring of lettered sections, the way in, the hallway
//               and how deep it goes. Sniper puts it up at the rover's desk (drive.coax dv_desk).
//   Outfit      O in the rover's room: the next outfit of the wardrobe (drive.coax dv_outfit).
//   Pause       Esc, or the pointer let go while she plays: the game stops and lists the controls.
//   Moves       1 to 4 in play are a bot's battle moves: d_take_move hands the battle each press.
//
// Health: her bar is her hearts (T_HEARTS); every bot's bar is drawn over it. At zero she is back
// at Sniper with the inventory she had when she last left it (g_keep runs while she is at Sniper).
#load "../../metaverse-engine/move/stance.coax";
#load "../../metaverse-engine/action/carry.coax";
#load "../../metaverse-engine/action/vitals.coax";
#load "../../metaverse-engine/ui/wheel.coax";   // Hold R: the bot wheel
#load "digger-orders.coax";   // commanding him: the selection, his answer, the marker, the drill's phases (#13552)

T_ROOM :: 6;                 // inventory slots
T_SENSE :: 4.0f32;           // metres: Digger's sensor range, the one number a level's metrics room shows
T_SENSOR_DIG :: 1.2f32;      // seconds Digger's drill takes to dig the buried sensor out
T_SENSE_UP :: T_SENSE * 2;   // with the better sensor: twice as far
T_FETCH_REACH :: 0.8f32;     // metres: near enough to pick a part up
T_STRIKE :: 0.9f32;          // seconds between Digger's strikes, and a foe's back at him
T_STRIKE_REACH :: 1.4f32;    // metres
T_DIGGER_HP :: 10.0f32;
T_FOE_HIT :: 2.0f32;         // an Imperial robot's strike on Digger (a raider's is half)
T_CHARGE :: 0.2f32;          // the share of his health Sniper's charger gives back a second
T_CHARGE_RANGE :: 6.0f32;    // metres from Sniper: at the charger
T_TOW_REACH :: 2.4f32;       // metres: E tows Digger from this near, or gives him a battery cell
T_CELL_RATE :: 0.8f32;       // the share of his health a battery cell gives back a second, until he is full
T_FOE_STUN :: 4.0f32;        // seconds an F stun holds a robot
T_POINT_FAR :: 40.0f32;      // metres the pointer reaches
T_GIVE_UP_FIGHT :: 25.0f32;  // metres from her: the bot wheel's reach (ATTACK, CHARGE); an order lasts to T_LEASH
T_CROUCH :: 0.35f32;         // metres the view sinks while sneaking
T_Q_TAP :: 0.3f32;           // seconds: a second Q within this of the last is a double tap (super fast)
T_Q_OFF :: 0.5f32;           // seconds: Q held this long on the board steps off
LM_SENSOR :: 31;             // where the better sensor lies (optional: no landmark, no sensor)
// what a slot holds: the haves (H_*), and these
DK_CELL :: 7; DK_SCRAP :: 8;
// Digger's own errands, over the game's BOT_* states
DJ_NONE :: 0; DJ_FETCH :: 1; DJ_FIGHT :: 2; DJ_TOW :: 3;
// what the pointer found
DP_NONE :: 0; DP_PICK :: 1; DP_FOE :: 2; DP_DIG :: 3; DP_SENSOR :: 4;
// the Director's own lines
DS_NONE :: 0; DS_FULL :: 1; DS_DOWN :: 2; DS_NOTHING :: 3; DS_TOW :: 4; DS_UP :: 5; DS_SENSOR :: 6; DS_BAY :: 7; DS_DROP :: 8;
DS_KEEP :: 9; DS_STUN :: 10; DS_FETCH :: 11; DS_FIGHT :: 12; DS_POWERED :: 13; DS_HERE :: 14; DS_DIG :: 15; DS_MOVE :: 16;
DS_FOLLOW :: 17; DS_NO_PART :: 18; DS_NO_FOE :: 19; DS_NO_DIG :: 20;
DS_CELL :: 21; DS_NO_CELL :: 22; DS_CELL_FULL :: 23; DS_CELL_FAR :: 24;
// the bot wheel's choices (Hold R), clockwise from the top
DW_DIG :: 0; DW_PICK :: 1; DW_ATTACK :: 2; DW_FOLLOW :: 3; DW_CHARGE :: 4; DW_N :: 5;
DW_WORDS :: [DW_N] string.["DIG", "PICK UP", "ATTACK", "FOLLOW", "CHARGE"];

SpDir :: struct {
  st: Stance;
  bag: bool; map: bool; paused: bool;
  task: int; task_i: int; task_t: f32;       // Digger's errand, what it is for, and its strike timer
  hp: Vitals = Vitals.{hp = T_DIGGER_HP, most = T_DIGGER_HP};
  cell: bool;                             // a battery cell she gave him is charging him, until he is full
  sensor: bool;                           // the better sensor is fitted
  left: [PICKS] bool;                     // dropped by her: Digger leaves it until she has walked away
  full_said: [PICKS] bool;                // "inventory full" said for this part, once until it fits again
  say: int; say_t: f32;
  move: int; moves: int;                  // the last battle move key (1 to 4) and presses not yet taken
  q_held: bool; q_since: f32 = 1000; q_hold: f32 = -1;   // Q is down, seconds since its last press, how long held (-1: this press won't step off)
  super: bool;                            // the board rides super fast (a double tap of Q)
  q_fast: bool;                           // Q has the board fast (Q switches it); Ctrl held or a double tap of W rides very fast too
  wheel: Wheel;                           // Hold R: the bot wheel, open while R is held (metaverse-engine/ui/wheel.coax)
  sw: f32 = 1280; sh: f32 = 800;          // the screen at the last frame: the pointer's crosshair
  sel: DPoint = DPoint.{kind = DP_NONE, i = -1};   // what the crosshair has selected (digger-orders.coax)
  o_st: int; o_t: f32 = 9; o_kind: int; o_i: int = -1;   // the last order's state (OS_*), seconds in it, and its target
  o_x: f32; o_z: f32; o_r: f32 = 1;       // its marker
  o_yes: bool; o_ack: f32 = 9;            // taken (a nod) or refused (a shake), seconds since
  o_kick: f32 = 9; o_kd: f32; o_burst: f32 = 9; o_plus: bool;   // a strike's lunge (+) or the break's recoil (-), the rubble flying
  o_look: f32;                            // his nose turned toward what he looks at
  bag_x: f32; bag_y: f32; bag_s: f32; bag_gap: f32;   // the grid as last drawn, for a click
}

d_say :: (g: [] SpGame, m: int) { g[0].dr[0].say = m; g[0].dr[0].say_t = 3.0; }
d_text :: (m: int) -> string {
  if m == DS_FULL { return "Inventory full. Press I and drop something."; }
  if m == DS_DOWN { return "Digger is powered down. Tow him to Sniper with E."; }
  if m == DS_NOTHING { return "Look at rock, a part or a robot to give Digger an order."; }
  if m == DS_BLOCKED { return "Digger can't get there. Something is in the way."; }
  if m == DS_TOW { return "Towing Digger. Sniper's charger will fix him."; }
  if m == DS_UP { return "Digger is charged and back on his treads."; }
  if m == DS_SENSOR { return "Digger drilled out a better sensor. He senses twice as far."; }
  if m == DS_NEED_DRILL { return "It's buried. Splice the DRILL card into Digger and he can dig it out."; }
  if m == DS_BAY { return "The edit bay is inside Sniper."; }
  if m == DS_DROP { return "Dropped. Digger leaves it until you walk away."; }
  if m == DS_KEEP { return "That stays with you."; }
  if m == DS_STUN { return "Stunned."; }
  if m == DS_FETCH { return "Digger goes for it."; }
  if m == DS_FIGHT { return "Digger goes to attack."; }
  if m == DS_POWERED { return "Digger powered down."; }
  if m == DS_HERE { return "Drop it where Digger can find it again."; }
  if m == DS_DIG { return "Digger digs."; }
  if m == DS_MOVE { return "No battle. Moves 1 to 4 are for bot battles."; }
  if m == DS_FOLLOW { return "Digger follows you."; }
  if m == DS_NO_PART { return "No part in Digger's range."; }
  if m == DS_NO_FOE { return "No robot near to attack."; }
  if m == DS_NO_DIG { return "Nothing here for Digger to dig."; }
  if m == DS_CELL { return "Battery cell in. Digger charges up."; }
  if m == DS_NO_CELL { return "No battery cell to give him."; }
  if m == DS_CELL_FULL { return "Digger's battery is full."; }
  if m == DS_CELL_FAR { return "Digger is too far. Go to him."; }
  return "";
}

// ---- what she carries
d_kind_of :: (pick: int) -> int { return ifx pick >= PICK_CELL then DK_CELL else ifx pick == PICK_PLUS then H_PLUS else pick; }
d_stack :: (kind: int) -> int { return ifx kind == DK_CELL then 4 else ifx kind == DK_SCRAP then 9 else 1; }
d_on_strip :: (g: [] SpGame, card: int) -> bool { for i: 0..<g[0].strip_n { if g[0].strip[i] == card { return true; } } return false; }
// Her inventory as slots, in a fixed order: hardware not spliced in, cards not on Digger's strip,
// the core, battery cells and robot pieces. Banned: DRILL+ and the core.
d_carry :: (g: [] SpGame) -> Carry {
  c := [1] Carry.[carry_make(T_ROOM)];
  for i: 0..<3 { if g[0].have[i] && !g[0].slot[i] { _ := carry_put(c[..], i, false, 1); } }
  for i: H_MOVE..<H_CORE { if g[0].have[i] && !d_on_strip(g, i) { _ := carry_put(c[..], i, i == H_PLUS, 1); } }
  if g[0].have[H_CORE] { _ := carry_put(c[..], H_CORE, true, 1); }
  for i: 0..<g[0].cells { _ := carry_put(c[..], DK_CELL, false, d_stack(DK_CELL)); }
  for i: 0..<g[0].scrap { _ := carry_put(c[..], DK_SCRAP, false, d_stack(DK_SCRAP)); }
  return c[0];
}
d_fits :: (g: [] SpGame, kind: int) -> bool { return carry_fits(d_carry(g), kind, d_stack(kind)); }
d_kind_name :: (kind: int) -> string {
  if kind == DK_CELL { return "CELLS"; }
  if kind == DK_SCRAP { return "ROBOT PIECES"; }
  if kind == H_CORE { return "BANNED CORE"; }
  return item_name(kind);
}
// The banned pieces with her (in her inventory or spliced into Digger): each holds Heat up.
d_banned :: (g: [] SpGame) -> int { return (ifx g[0].have[H_PLUS] then 1 else 0) + (ifx g[0].have[H_CORE] then 1 else 0); }
d_heat_floor :: (g: [] SpGame) -> f32 { return lo(T_HEAT_MAX - 1, cast(f32) d_banned(g) * T_HEAT_PIECE); }
// Drops slot `i` of the grid at her feet. Cells go back on the ground where she stands; robot pieces
// are left behind; the core stays with her.
d_drop :: (g: [] SpGame, i: int) -> bool {
  c := [1] Carry.[d_carry(g)];
  if i < 0 || i >= c[0].n { return false; }
  kind := c[0].items[i].kind;
  if kind == H_CORE { d_say(g, DS_KEEP); return false; }
  if kind == DK_SCRAP { g[0].scrap = 0; d_say(g, DS_DROP); return true; }
  if g[0].zone != Z_MINE { d_say(g, DS_HERE); return false; }
  k := 0;
  for p: 0..<PICKS {
    if !g[0].taken[p] || d_kind_of(p) != kind || pick_zone(g, p) != Z_MINE { continue; }
    if kind == DK_CELL && k >= g[0].cells { break; }   // a cell given to Digger is spent: it is not put back
    a := cast(f32) k * 2.1;
    g[0].at.pick_x[p] = g[0].px + sin(g[0].yaw + a) * 0.9; g[0].at.pick_z[p] = g[0].pz + cos(g[0].yaw + a) * 0.9;
    g[0].taken[p] = false; g[0].dr[0].left[p] = true; k += 1;
    if kind != DK_CELL { g[0].have[kind] = false; break; }
  }
  if kind == DK_CELL { g[0].cells = 0; }
  if k == 0 { return false; }
  d_say(g, DS_DROP);
  return true;
}

// ---- Digger
d_down :: (g: [] SpGame) -> bool { return g[0].dr[0].hp.down; }
d_towing :: (g: [] SpGame) -> bool { return g[0].dr[0].task == DJ_TOW; }
d_range :: (g: [] SpGame) -> f32 { return ifx g[0].dr[0].sensor then T_SENSE_UP else T_SENSE; }
// He is on an errand of his own, or powered down: the game's follow leaves him be (g_bot).
d_busy :: (g: [] SpGame) -> bool { return d_down(g) || g[0].dr[0].task != DJ_NONE; }
d_sensor_at :: (g: [] SpGame) -> ScMark { return sc_mark(g[0].c[..], LM_SENSOR); }
d_sensor_here :: (g: [] SpGame) -> bool { m := d_sensor_at(g); return m.id == LM_SENSOR && !g[0].dr[0].sensor && g[0].zone == Z_MINE; }
// The part nearest Digger within his range that he may take: not one she dropped and still stands
// by, and one that fits. A part that doesn't fit is said once.
d_sense :: (g: [] SpGame) -> int {
  d := g[0].dr[..]; best := -1; bd := d_range(g);
  for i: 0..<PICKS {
    if g[0].taken[i] || pick_zone(g, i) != g[0].zone { continue; }
    if d[0].left[i] { if dist2(g[0].px, g[0].pz, pick_x(g, i), pick_z(g, i)) > d_range(g) + 1 { d[0].left[i] = false; } continue; }
    e := dist2(g[0].bot_x, g[0].bot_z, pick_x(g, i), pick_z(g, i));
    if e >= bd { continue; }
    if !d_fits(g, d_kind_of(i)) { if !d[0].full_said[i] { d[0].full_said[i] = true; d_say(g, DS_FULL); } continue; }
    d[0].full_said[i] = false; bd = e; best = i;
  }
  if d_sensor_here(g) && g_spliced(g) { m := d_sensor_at(g); if dist2(g[0].bot_x, g[0].bot_z, m.x, m.z) < bd { best = PICKS; } }   // buried: dug out with the drill
  return best;
}
d_fetch_at :: (g: [] SpGame, i: int) -> [2] f32 {
  if i == PICKS { m := d_sensor_at(g); return [2] f32.[m.x, m.z]; }
  return [2] f32.[pick_x(g, i), pick_z(g, i)];
}
d_sensor_digging :: (g: [] SpGame) -> bool { d := g[0].dr[0]; return d.task == DJ_FETCH && d.task_i == PICKS && d.task_t > 0; }
d_task_end :: (g: [] SpGame) { g[0].dr[0].task = DJ_NONE; g[0].dr[0].task_i = -1; g[0].dr[0].task_t = 0; }
// Digger takes a hit of `points` (a foe's strike, a battle's move): at zero he powers down where he is.
d_bot_hurt :: (g: [] SpGame, points: f32) {
  if d_down(g) { return; }
  g[0].dr[0].hp = vitals_hit(g[0].dr[0].hp, points);
  if d_down(g) { d_task_end(g); g[0].bot_state = BOT_FOLLOW; d_say(g, DS_POWERED); }
}
d_at_charger :: (g: [] SpGame) -> bool {
  if g[0].zone == Z_RAIL { c := rail_at(g, g[0].rail_s); return dist2(g[0].bot_x, g[0].bot_z, c.x, c.z) < T_CHARGE_RANGE; }
  return g[0].zone == Z_MINE && dist2(g[0].bot_x, g[0].bot_z, g[0].at.rover_x, g[0].at.rover_z) < T_CHARGE_RANGE;
}
// He wants charge, and no cell is charging him already.
d_needs_charge :: (g: [] SpGame) -> bool { d := g[0].dr[0]; return g[0].bot && !d.cell && (d.hp.down || d.hp.hp < d.hp.most); }
// E would give him a cell: she has one, he wants it, and he is beside her.
d_cell_here :: (g: [] SpGame) -> bool { return g[0].cells > 0 && d_needs_charge(g) && dist2(g[0].px, g[0].pz, g[0].bot_x, g[0].bot_z) <= T_TOW_REACH; }
// One of her battery cells into Digger, if he is within `reach` metres of her: it charges him full
// (a powered-down Digger powers up), T_CELL_RATE of his health a second. False, and said why, when not.
d_give_cell :: (g: [] SpGame, reach: f32) -> bool {
  if !g[0].bot { return false; }
  if g[0].cells <= 0 { d_say(g, DS_NO_CELL); return false; }
  if !d_needs_charge(g) { d_say(g, ifx g[0].dr[0].cell then DS_CELL else DS_CELL_FULL); return false; }
  if dist2(g[0].px, g[0].pz, g[0].bot_x, g[0].bot_z) > reach { d_say(g, DS_CELL_FAR); return false; }
  g[0].cells -= 1; g[0].dr[0].cell = true; d_say(g, DS_CELL);
  return true;
}
// A step of Digger's own: charging from a cell or at Sniper, being towed, fetching, fighting, or looking for parts.
d_bot :: (g: [] SpGame, dt: f32) {
  if !g[0].bot { return; }
  d := g[0].dr[..];
  if d[0].cell {
    was := d_down(g);
    d[0].hp = vitals_charge(d[0].hp, T_CELL_RATE, dt);
    if d[0].hp.hp >= d[0].hp.most { d[0].cell = false; }
    if was && !d_down(g) { d_task_end(g); g[0].bot_state = BOT_FOLLOW; d_say(g, DS_UP); }
    if d_down(g) { return; }
  }
  if d_down(g) || d[0].hp.hp < d[0].hp.most {
    if d_at_charger(g) {
      was := d_down(g);
      d[0].hp = vitals_charge(d[0].hp, T_CHARGE, dt);
      if was && !d_down(g) { d_task_end(g); g[0].bot_state = BOT_FOLLOW; d_say(g, DS_UP); }
    }
  }
  if d[0].task == DJ_TOW {
    if !d_down(g) { d_task_end(g); return; }
    tx := g[0].px - sin(g[0].yaw) * 1.3; tz := g[0].pz - cos(g[0].yaw) * 1.3;
    left := bot_toward(g, tx, tz, T_FOLLOW, dt);
    if left > 12 { g[0].bot_x = tx; g[0].bot_z = tz; }
    return;
  }
  if d_down(g) || g[0].bot_state != BOT_FOLLOW { return; }
  if d[0].task == DJ_FETCH {
    i := d[0].task_i;
    gone := ifx i == PICKS then !d_sensor_here(g) else g[0].taken[i];
    if gone || dist2(g[0].px, g[0].pz, g[0].bot_x, g[0].bot_z) > T_LEASH { d_task_end(g); return; }
    at := d_fetch_at(g, i);
    if bot_toward(g, at[0], at[1], T_BOT_GO, dt) > T_FETCH_REACH { return; }
    if i == PICKS {
      // the first splice's payoff: his drill digs the sensor out (spins up with its sound, shudders, then the
      // break throws him back) and he senses twice as far
      if d[0].task_t == 0 { snd_play(g, SND_DRILL); }
      d[0].task_t += dt; g[0].bot_spin += dt * 22;
      if d[0].task_t < T_SENSOR_DIG { return; }
      d[0].sensor = true; d_say(g, DS_SENSOR); d[0].o_kick = 0; d[0].o_kd = -1;
    }
    else if d_fits(g, d_kind_of(i)) { g_take(g, i); }
    else { d_say(g, DS_FULL); }
    d_task_end(g);
    return;
  }
  if d[0].task == DJ_FIGHT {
    f := d[0].task_i;
    if f < 0 || f >= FOES || !g_foe_in(g, f) || dist2(g[0].px, g[0].pz, g[0].fx[f], g[0].fz[f]) > T_LEASH { d_task_end(g); return; }
    if bot_toward(g, g[0].fx[f], g[0].fz[f], T_BOT_GO, dt) > T_STRIKE_REACH { return; }
    d[0].task_t += dt;
    if d[0].task_t < T_STRIKE { return; }
    d[0].task_t = 0; d[0].o_kick = 0; d[0].o_kd = 1; snd_play(g, SND_HIT);   // his strike: a lunge
    // the foe turns on Digger, not on her: it stops for the exchange and strikes him back
    g[0].fhp[f] -= 1; g[0].fhost[f] = false; g[0].fstag[f] = hi(g[0].fstag[f], 0.3); g[0].flash = 0.15;
    if g[0].fhp[f] <= 0 {
      // down: a robot piece, if there is room for it
      if d_fits(g, DK_SCRAP) { g[0].scrap += 1; g[0].heat = lo(T_HEAT_MAX, g[0].heat + T_HEAT_SCRAP); g_say(g, MSG_FOE); } else { d_say(g, DS_FULL); }
      d_task_end(g);
      return;
    }
    if g[0].fstag[f] <= 0.3 { d_bot_hurt(g, ifx f >= F_RAIDERS then T_FOE_HIT else T_FOE_HIT * 0.5); }   // a stunned one can't
    return;
  }
  i := d_sense(g);
  if i >= 0 { d[0].task = DJ_FETCH; d[0].task_i = i; }
}

// ---- pointing Digger: the left click, at what is under the crosshair
d_view :: (g: [] SpGame) -> VpView {
  if g[0].hview_on { v := g[0].hview; v.w = g[0].dr[0].sw; v.h = g[0].dr[0].sh; return v; }   // the host's own view (message 622)
  c := g_camera(g);
  return VpView.{ex = c.eye.x, ey = c.eye.y, ez = c.eye.z, ax = c.at.x, ay = c.at.y, az = c.at.z, fov = c.fov, w = g[0].dr[0].sw, h = g[0].dr[0].sh};
}
DPoint :: struct { kind: int; i: int = -1; }
// How far off the ray a thing is, for its size and distance (keep widens it: what is selected): best keeps the least.
d_aim :: (r: VpRay, x: f32, y: f32, z: f32, size: f32, keep: f32, best: [] f32) -> bool {
  dx := x - r.o.x; dy := y - r.o.y; dz := z - r.o.z;
  t := dx * r.d.x + dy * r.d.y + dz * r.d.z;
  if t < 0 || t > T_POINT_FAR { return false; }
  ox := dx - r.d.x * t; oy := dy - r.d.y * t; oz := dz - r.d.z * t;
  off := sqrt(ox * ox + oy * oy + oz * oz) / ((size + 0.03 * t) * keep);
  if off > 1 || off >= best[0] { return false; }
  best[0] = off;
  return true;
}
// The left click in play: Digger digs, picks up or attacks what she points at.
d_point :: (g: [] SpGame) -> int {
  if !g[0].bot { return DP_NONE; }
  p := d_pointed(g); d := g[0].dr[..];
  why := d_can(g, p);
  d_ack(g, p, why);   // answered at once: taken, or refused with the reason (digger-orders.coax)
  if why != DS_NONE { return DP_NONE; }
  if p.kind == DP_DIG { d_task_end(g); d_say(g, DS_DIG); g_deploy(g); return p.kind; }
  if g[0].bot_state != BOT_FOLLOW { g[0].bot_state = BOT_FOLLOW; }   // called off his cut
  if p.kind == DP_FOE { d[0].task = DJ_FIGHT; d[0].task_i = p.i; d[0].task_t = T_STRIKE * 0.5; d_say(g, DS_FIGHT); return p.kind; }
  if p.kind == DP_PICK { d[0].left[p.i] = false; }   // pointed at: no longer left
  d[0].task = DJ_FETCH; d[0].task_i = p.i; d_say(g, DS_FETCH);
  return p.kind;
}

// ---- keys, the pointer and the step
// Rover: where the edit bay is. Inside Sniper, or at its door until the rover's room is built.
d_in_rover :: (g: [] SpGame) -> bool { return g[0].zone == Z_MINE && (near_rover(g, T_USE_RANGE) || sp_in_room(g)); }   // at Sniper, or in its room (drive.coax)
d_cursor :: (g: [] SpGame) -> bool { d := g[0].dr[0]; return d.paused || d.bag; }
d_pause :: (g: [] SpGame) {
  d := g[0].dr[..]; d[0].paused = true; d[0].bag = false; d[0].map = false; d[0].wheel = Wheel.{};
  g[0].fwd = false; g[0].back = false; g[0].left = false; g[0].right = false; g[0].turn_l = false; g[0].turn_r = false;
  d[0].st = Stance.{since = d[0].st.since};
}
d_resume :: (g: [] SpGame) { g[0].dr[0].paused = false; g[0].look_free = false; }
d_map_close :: (g: [] SpGame) { g[0].dr[0].map = false; g[0].look_free = false; }
// A battle move key, handed to the battle once (part C's battles take them here).
d_take_move :: (g: [] SpGame) -> int { d := g[0].dr[..]; if d[0].moves == 0 { return 0; } d[0].moves -= 1; return d[0].move; }
// A key of the Director's: 1 it is taken, 0 it is ignored, -1 it is the game's.
d_key :: (g: [] SpGame, key: int, down: bool) -> int {
  d := g[0].dr[..];
  if d[0].paused {
    if down && (key == -1 || key == -2 || key == 'p' || key == 'P') { d_resume(g); }
    return ifx down then 1 else -1;
  }
  if d[0].map && down && (key == 'm' || key == 'M' || key == -1 || key == 'e' || key == 'E') { d_map_close(g); return 1; }   // the map closes with M, Esc or E
  if key == -13 { return ifx g[0].mode == M_PLAY then 1 else 0; }   // Shift: no sneak or crouch until she has an animation for it (#13552)
  if key == -14 { d[0].st = stance_hold(d[0].st, down); return ifx g[0].mode == M_PLAY then 1 else 0; }   // Ctrl: very fast on the board
  if key == 'w' || key == 'W' || key == -6 { d[0].st = stance_forward(d[0].st, down); return -1; }   // a double tap of W: very fast on the board; W still walks
  if key == 'q' || key == 'Q' { return d_board_q(g, down); }
  if key == 'r' || key == 'R' { return d_wheel_key(g, down); }
  if d[0].wheel.open && down && key >= '1' && key < '1' + DW_N { d[0].wheel = wheel_set(d[0].wheel, key - '1'); return 1; }
  if !down || g[0].mode != M_PLAY { return -1; }
  if key == 'i' || key == 'I' { d[0].bag = !d[0].bag; d[0].map = false; return 1; }
  if key == 'm' || key == 'M' { d[0].map = !d[0].map; d[0].bag = false; return 1; }
  if key == -1 { if d[0].bag || d[0].map { d[0].bag = false; d[0].map = false; g[0].look_free = false; } else { d_pause(g); } return 1; }
  if key >= '1' && key <= '4' {
    d[0].move = key - '0'; d[0].moves = ifx d[0].moves < 8 then d[0].moves + 1 else 8;
    return 1;
  }
  if key == -15 && !d_in_rover(g) { d_say(g, DS_BAY); return 1; }
  return -1;
}
// Q, everything the board does: up at casual, then casual and fast in turn, super fast on a double
// tap, and held (d_pre) off. A key's repeats while it is held are not presses.
d_board_q :: (g: [] SpGame, down: bool) -> int {
  d := g[0].dr[..];
  if !down { d[0].q_held = false; d[0].q_hold = -1; return 0; }
  if d[0].q_held { return 1; }
  d[0].q_held = true;
  if g[0].mode != M_PLAY || !g_board_given(g) { return 0; }
  b := g[0].board[..];
  if !g_riding(g) { g_board_key(g); d[0].q_fast = false; b[0].fast = false; d[0].super = false; d[0].q_since = 0; d[0].q_hold = -1; return 1; }
  if d[0].q_since <= T_Q_TAP { d[0].super = true; d[0].q_fast = true; }
  else if d[0].q_fast { d[0].q_fast = false; d[0].super = false; }
  else { d[0].q_fast = true; }
  b[0].fast = d[0].q_fast || stance_fast(d[0].st);
  d[0].q_since = 0; d[0].q_hold = 0;
  return 1;
}
// Hold R: the bot wheel opens; the pointer (or 1 to 5) picks what Digger does; letting go confirms it.
d_wheel_key :: (g: [] SpGame, down: bool) -> int {
  d := g[0].dr[..];
  if !down {
    if !d[0].wheel.open { return -1; }
    pick := wheel_close(d[0].wheel); d[0].wheel = Wheel.{};
    if pick >= 0 { d_order(g, pick); }
    return 1;
  }
  if d[0].wheel.open { return 1; }   // a key repeat
  if g[0].mode != M_PLAY || !g[0].bot || d[0].paused { return -1; }   // the game's (R restarts after the ending)
  d[0].bag = false; d[0].map = false;
  d[0].wheel = wheel_open(DW_N);
  return 1;
}
// The pointer moves the wheel's choice while it is open: true when it took the movement.
d_wheel_look :: (g: [] SpGame, dx: f32, dy: f32) -> bool {
  d := g[0].dr[..];
  if !d[0].wheel.open { return false; }
  d[0].wheel = wheel_move(d[0].wheel, dx, dy);
  return true;
}
// What the wheel's choice has Digger do: dig the way ahead, fetch the nearest part in his range,
// attack the nearest robot near her, come back to her side, or take one of her battery cells.
d_order :: (g: [] SpGame, pick: int) {
  d := g[0].dr[..];
  if !g[0].bot { return; }
  if pick == DW_CHARGE { _ := d_give_cell(g, T_GIVE_UP_FIGHT); return; }
  if d_down(g) { d_say(g, DS_DOWN); return; }
  if pick == DW_FOLLOW { d_task_end(g); g[0].bot_state = BOT_FOLLOW; d_say(g, DS_FOLLOW); return; }
  if pick == DW_DIG {
    if g[0].zone != Z_MINE || (g[0].rubble_gone && g[0].wall_gone) { d_say(g, DS_NO_DIG); return; }
    d_task_end(g); d_say(g, DS_DIG); g_deploy(g);
    if g[0].bot_state == BOT_GO { d_ack(g, DPoint.{kind = DP_DIG, i = ifx g[0].rubble_gone then 1 else 0}, DS_NONE); }
    return;
  }
  if g[0].bot_state != BOT_FOLLOW { g[0].bot_state = BOT_FOLLOW; }   // called off his cut
  if pick == DW_PICK {
    i := d_sense(g);
    if i < 0 { d_say(g, DS_NO_PART); return; }
    if i < PICKS { d[0].left[i] = false; }
    d[0].task = DJ_FETCH; d[0].task_i = i; d_say(g, DS_FETCH); d_ack(g, DPoint.{kind = ifx i == PICKS then DP_SENSOR else DP_PICK, i = i}, DS_NONE); return;
  }
  if pick == DW_ATTACK {
    best := -1; bd := T_GIVE_UP_FIGHT;
    if g[0].zone == Z_MINE { for i: 0..<FOES { if g_foe_in(g, i) { e := dist2(g[0].px, g[0].pz, g[0].fx[i], g[0].fz[i]); if e < bd { bd = e; best = i; } } } }
    if best < 0 { d_say(g, DS_NO_FOE); return; }
    d[0].task = DJ_FIGHT; d[0].task_i = best; d[0].task_t = T_STRIKE * 0.5; d_say(g, DS_FIGHT); d_ack(g, DPoint.{kind = DP_FOE, i = best}, DS_NONE); return;
  }
}
// The wheel, in the middle of the screen: four choices round a ring, the one picked lit.
// The wheel, in the middle of the screen, in the HUD's frame (hud.coax).
d_wheel_draw :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, at: int) -> int { return hv_wheel(g, out, u, at, q); }
// E at a powered-down Digger: a battery cell into him if she has one, else tow him (or let him go).
d_use :: (g: [] SpGame) -> bool {
  if !g[0].bot || !d_down(g) || dist2(g[0].px, g[0].pz, g[0].bot_x, g[0].bot_z) > T_TOW_REACH { return false; }
  if d_cell_here(g) { return d_give_cell(g, T_TOW_REACH); }
  d := g[0].dr[..];
  if d[0].task == DJ_TOW { d_task_end(g); } else { d[0].task = DJ_TOW; d_say(g, DS_TOW); }
  return true;
}
// The pointer in play: true when the Director's systems took it.
d_pointer :: (g: [] SpGame, x: f32, y: f32, phase: int) -> bool {
  d := g[0].dr[..];
  if d[0].map { if phase == 0 { d_map_close(g); } return true; }   // a click closes the map
  if g[0].mode != M_PLAY { return false; }
  if d[0].paused { if phase == 0 { d_resume(g); } return true; }
  if d[0].bag {
    if phase != 0 { return true; }
    i := carry_hit(T_ROOM, 3, d[0].bag_x, d[0].bag_y, d[0].bag_s, d[0].bag_gap, x, y);
    if i >= 0 {
      c := d_carry(g);
      // her cells charge Digger when he wants charge; anything else, and cells when he is full, drop
      if i < c.n && c.items[i].kind == DK_CELL && d_needs_charge(g) { _ := d_give_cell(g, T_GIVE_UP_FIGHT); } else { _ := d_drop(g, i); }
    }
    return true;
  }
  if phase == 0 && !g[0].look_free { _ := d_point(g); return true; }
  return false;
}
// The pointer let go while she plays (Escape frees it in a browser): pause.
d_lock :: (g: [] SpGame, status: int) {
  d := g[0].dr[0];
  if status == 0 && d.map { d_map_close(g); return; }   // Esc frees the pointer in a browser before its key arrives: it closes the map
  if status == 0 && g[0].mode == M_PLAY && !g[0].look_free && !d.bag && !d.map { d_pause(g); }
}
// A step in play, before the walk: the stance's time, the board's speed, the toast.
d_pre :: (g: [] SpGame, dt: f32) {
  d := g[0].dr[..];
  d[0].st = stance_tick(d[0].st, dt);
  if d[0].q_since < 1000 { d[0].q_since += dt; }
  if d[0].q_held && d[0].q_hold >= 0 && g_riding(g) {
    d[0].q_hold += dt;
    if d[0].q_hold >= T_Q_OFF { g_board_key(g); d[0].q_hold = -1; d[0].super = false; d[0].q_fast = false; g[0].board[0].fast = false; }
  }
  if !g_riding(g) { d[0].super = false; d[0].q_fast = false; }
  else { g[0].board[0].fast = d[0].q_fast || stance_fast(d[0].st); }   // Q's fast, or Ctrl held, or a double tap of W held
  if d[0].say_t > 0 { d[0].say_t -= dt; if d[0].say_t <= 0 { d[0].say = DS_NONE; } }
}
// After the walk: Heat's floor and Digger.
d_post :: (g: [] SpGame, dt: f32) {
  if g[0].heat < d_heat_floor(g) { g[0].heat = d_heat_floor(g); }
  d_bot(g, dt);
  d_ord_tick(g, dt);   // the selection, the order's marker, where he looks (digger-orders.coax)
  g[0].dr[0].o_burst += dt;
}
d_pace :: (g: [] SpGame) -> f32 { return stance_pace(g[0].dr[0].st); }
d_sneaking :: (g: [] SpGame) -> bool { return g[0].dr[0].st.sneak && g[0].mode == M_PLAY && !g_riding(g); }
// How far a foe that notices from `see` metres senses her: grown by Heat, halved while she sneaks.
d_noticed :: (g: [] SpGame, see: f32) -> f32 { return stance_noticed(g[0].dr[0].st, see, g[0].heat * T_NOTICE_HEAT); }
d_crouch :: (g: [] SpGame) -> f32 { return ifx d_sneaking(g) then T_CROUCH else 0.0f32; }
d_respawn :: (g: [] SpGame) {
  d := g[0].dr[..];
  d_task_end(g); d[0].bag = false; d[0].map = false; d[0].cell = false; d[0].o_st = OS_NONE;
  for i: 0..<PICKS { d[0].left[i] = false; d[0].full_said[i] = false; }
}

// ---- drawing
// The better sensor, where it lies, and Digger out on the rail stop.
d_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  t := g[0].t;
  if d_sensor_here(g) {
    m := d_sensor_at(g);
    f := frame_at(v3(m.x, 0.8 + sin(t * 2.2) * 0.12, m.z), t * 1.4);
    kit_pen(p, 240, MAT_SKIN, t3(0.93, 0.88, 0.76)); box(buf, p, f, 0.22, 0.12, 0.22);
    kit_pen(p, 241, MAT_GLOW, t3(1.0, 0.72, 0.30)); ball(buf, p, v3(m.x, 1.0 + sin(t * 2.2) * 0.12, m.z), 0.12, 8);
  }
  if g[0].zone == Z_MINE { d_chips_live(g, buf, p); d_burst_live(g, buf, p); }
  d_mark_live(g, buf, p);   // the order's marker (digger-orders.coax)
}
d_tint :: (g: [] SpGame, c: KitTint) -> KitTint { return ifx d_down(g) then t3(0.30, 0.28, 0.27) else c; }
// A bar: an ink outline, filled `share` of the way in `c`, cut into `cuts` segments when above 1.
d_bar :: (out: [] f32, n: int, x0: f32, y0: f32, x1: f32, y1: f32, share: f32, cuts: int, c: KitTint, k: f32) -> int {
  m := n;
  if share > 0.001 { m = ui_seg(out, m, x0 + 2 * k, (y0 + y1) * 0.5, x0 + 2 * k + (x1 - x0 - 4 * k) * lo(share, 1), (y0 + y1) * 0.5, (y1 - y0) * 0.5 - 2 * k, c, 1); }
  m = ui_box(out, m, x0, y0, x1, y1, 1.5 * k, INK());
  for i: 1..<cuts { x := x0 + (x1 - x0) * cast(f32) i / cast(f32) cuts; m = ui_seg(out, m, x, y0, x, y1, 0.8 * k, INK(), 1); }
  return m;
}
// Her health, Digger's, her inventory's room and his sensor, top left. The height it takes.
d_vitals :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, at: int) -> int {
  n := at; k := q.k; pad := 18 * k; ink := INK(); paper := PAPER(); buf: [64] u8;
  x1 := pad + 272 * k; y1 := pad + 92 * k; d := g[0].dr[0];
  ui_panel(g, u, pad, pad, x1, y1, paper, 0.96);
  n = ui_box(out, n, pad, pad, x1, y1, 3 * k, ink);
  n = ui_text(out, n, "YOU", pad + 12 * k, pad + 22 * k, 8.5 * k, ink);
  n = d_bar(out, n, pad + 86 * k, pad + 11 * k, x1 - 12 * k, pad + 27 * k, cast(f32) g[0].hearts / cast(f32) T_HEARTS, T_HEARTS, HEAT(), k);
  n = ui_text(out, n, "DIGGER", pad + 12 * k, pad + 46 * k, 8.5 * k, ink);
  if d.hp.down { n = ui_text(out, n, "DOWN", pad + 62 * k, pad + 46 * k, 7.5 * k, HEAT()); }
  n = d_bar(out, n, pad + 86 * k, pad + 35 * k, x1 - 12 * k, pad + 51 * k, vitals_share(d.hp), 1, ifx d.hp.down then HEAT() else GLOW_INK(), k);
  c := d_carry(g);
  n = ui_text(out, n, num(buf[..], "I BAG ", c.n, ""), pad + 12 * k, pad + 76 * k, 7.5 * k, ink);
  n = ui_text(out, n, num(buf[..], "/ ", T_ROOM, ""), pad + 66 * k, pad + 76 * k, 7.5 * k, ink);
  n = ui_text(out, n, num(buf[..], "SENSOR ", cast(int) d_range(g), " M"), pad + 104 * k, pad + 76 * k, 7.5 * k, ifx d.sensor then GLOW_INK() else ink);
  if d_sneaking(g) { n = ui_right(out, n, "SNEAKING", x1 - 12 * k, pad + 76 * k, 7.5 * k, HEAT()); }
  return n;
}
// Health bars over every bot in sight: the foes and Digger.
d_plates :: (g: [] SpGame, out: [] f32, q: Ui, at: int) -> int {
  n := at; k := q.k;
  if g[0].zone != Z_MINE && g[0].zone != Z_RAIL { return n; }
  v := d_view(g);
  for i: 0..<FOES + 1 {
    x := 0.0f32; z := 0.0f32; share := 0.0f32; c := HEAT(); top := 2.3f32;
    if i < FOES {
      if g[0].zone != Z_MINE || !g_foe_in(g, i) { continue; }
      x = g[0].fx[i]; z = g[0].fz[i]; share = cast(f32) g[0].fhp[i] / cast(f32) (ifx i < F_RAIDERS then T_RAIDER_HP else T_IMPERIAL_HP);
      top = ifx i < F_RAIDERS then 2.3f32 else 2.0f32;
    } else {
      if !g[0].bot { continue; }
      x = g[0].bot_x; z = g[0].bot_z; share = vitals_share(g[0].dr[0].hp); c = ifx d_down(g) then HEAT() else GLOW_INK(); top = 1.7;
    }
    if dist2(v.ex, v.ez, x, z) > 28 { continue; }
    s := vp_project(v, x, top, z);
    if !s.ok || s.x < 0 || s.x > q.w || s.y < 0 || s.y > q.h { continue; }
    half := 26 * k;
    n = ui_seg(out, n, s.x - half, s.y, s.x + half, s.y, 4.5 * k, PAPER(), 0.9);
    n = d_bar(out, n, s.x - half, s.y - 4 * k, s.x + half, s.y + 4 * k, share, 1, c, k);
  }
  return n;
}
// The inventory grid, in the middle of the screen.
d_bag :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, at: int) -> int {
  n := at; k := q.k; ink := INK(); paper := PAPER(); buf: [64] u8; d := g[0].dr[..];
  s := 104 * k; gap := 10 * k; cols := 3; rows := (T_ROOM + cols - 1) / cols;
  gw := cast(f32) cols * s + cast(f32) (cols - 1) * gap; gh := cast(f32) rows * s + cast(f32) (rows - 1) * gap;
  x0 := q.w * 0.5 - gw * 0.5; y0 := q.h * 0.5 - gh * 0.5 + 10 * k;
  d[0].bag_x = x0; d[0].bag_y = y0; d[0].bag_s = s; d[0].bag_gap = gap;
  ui_panel(g, u, x0 - 24 * k, y0 - 70 * k, x0 + gw + 24 * k, y0 + gh + 74 * k, paper, 0.98);
  n = ui_box(out, n, x0 - 24 * k, y0 - 70 * k, x0 + gw + 24 * k, y0 + gh + 74 * k, 3 * k, ink);
  c := d_carry(g);
  n = ui_title(out, n, "INVENTORY", x0, y0 - 34 * k, 13 * k, ink);
  b2: [32] u8;
  n = ui_right(out, n, num(buf[..], "", c.n, num(b2[..], " / ", T_ROOM, "")), x0 + gw, y0 - 34 * k, 10 * k, ink);
  for i: 0..<T_ROOM {
    b := carry_cell(i, cols, x0, y0, s, gap);
    if i >= c.n { n = ui_box(out, n, b.x0, b.y0, b.x1, b.y1, 1.5 * k, SHADE()); continue; }
    one := c.items[i]; col := ifx one.banned then GLOW_INK() else ink;
    n = ui_box(out, n, b.x0, b.y0, b.x1, b.y1, 2.5 * k, col);
    icon := ifx one.kind == H_TREADS then 1 else ifx one.kind == H_BATTERY || one.kind == DK_CELL then 2 else ifx one.kind == H_CORE then 4 else ifx one.kind == DK_SCRAP then 3 else 0;
    n = ui_icon(out, n, icon, (b.x0 + b.x1) * 0.5, b.y0 + 36 * k, 30 * k, col, k);
    n = ui_mid(out, n, d_kind_name(one.kind), (b.x0 + b.x1) * 0.5, b.y1 - 26 * k, 7 * k, col);
    if one.count > 1 { n = ui_right(out, n, num(buf[..], "x", one.count, ""), b.x1 - 8 * k, b.y1 - 9 * k, 8 * k, col); }
  }
  n = ui_mid(out, n, ifx d_needs_charge(g) && g[0].cells > 0 then "Click CELLS to charge Digger, another slot to drop it." else "Click a slot to drop it. I or Esc closes.", q.w * 0.5, y0 + gh + 30 * k, 8 * k, ink);
  n = ui_mid(out, n, num(buf[..], "Digger picks up every part within ", cast(int) d_range(g), " m of him."), q.w * 0.5, y0 + gh + 52 * k, 8 * k, ink);
  return n;
}
// The deep-garage map: the walls from above, Sniper, Digger, her, and what is still in the way.
d_map :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, at: int) -> int {
  n := at; k := q.k; ink := INK(); paper := PAPER();
  if g[0].zone != Z_MINE {
    ui_panel(g, u, q.w * 0.5 - 220 * k, q.h * 0.5 - 40 * k, q.w * 0.5 + 220 * k, q.h * 0.5 + 64 * k, paper, 0.98);
    n = ui_mid(out, n, "The map shows the garage. You're not there yet.", q.w * 0.5, q.h * 0.5 + 4 * k, 9 * k, ink);
    return d_map_hint(out, n, q.w * 0.5, q.h * 0.5 + 38 * k, k);
  }
  // the bounds: every wall but the map's edge
  lx := 1e9f32; hx := -1e9f32; lz := 1e9f32; hz := -1e9f32;
  room := dv_room(g);   // the rover's cabin is not on the map
  for i: 0..<g[0].wall_n { o := i * 5; if g[0].walls[o + 4] <= 0 && (g[0].walls[o + 1] - g[0].walls[o] > 30 || g[0].walls[o + 3] - g[0].walls[o + 2] > 30) { continue; } if dv_room_has(room, g[0].walls[o], g[0].walls[o + 2]) { continue; } lx = lo(lx, g[0].walls[o]); hx = hi(hx, g[0].walls[o + 1]); lz = lo(lz, g[0].walls[o + 2]); hz = hi(hz, g[0].walls[o + 3]); }
  // and the garage's ring (garage.coax), whose walls are its own colliders
  gx := g[0].at.gar_x; gz := g[0].at.gar_z; rb := ga_back(g); rf := g[0].at.gar_r;
  lx = lo(lx, gx - rb); hx = hi(hx, gx + rb); lz = lo(lz, gz - rb); hz = hi(hz, gz + rb);
  if hx <= lx || hz <= lz { return n; }
  // between the HUD panels: clear of the top bars and the bottom cards and objective
  bh := q.h - 400 * k; bw := hi(q.w * 0.3, lo(q.w * 0.6, q.w - 960 * k)); sc := lo(bh / (hz - lz), bw / (hx - lx)); mw := (hx - lx) * sc; mh := (hz - lz) * sc;
  x0 := q.w * 0.5 - mw * 0.5; y0 := q.h * 0.5 - mh * 0.5 + 16 * k;
  ph := hi(mw * 0.5 + 30 * k, 300 * k);   // half the panel: wide enough for the title and the close hint
  ui_panel(g, u, q.w * 0.5 - ph, y0 - 70 * k, q.w * 0.5 + ph, y0 + mh + 50 * k, paper, 0.98);
  n = ui_box(out, n, q.w * 0.5 - ph, y0 - 70 * k, q.w * 0.5 + ph, y0 + mh + 50 * k, 3 * k, ink);
  n = ui_title(out, n, "DEEP GARAGE MAP", q.w * 0.5 - ph + 30 * k, y0 - 36 * k, 13 * k, ink);
  n = d_map_hint(out, n, q.w * 0.5 + ph - 20 * k - d_map_hint_w(k) * 0.5, y0 - 41 * k, k);
  // north (lower z) is up: x right, z down the page reversed
  for i: 0..<g[0].wall_n {
    o := i * 5; if g[0].walls[o + 4] <= 0 || dv_room_has(room, g[0].walls[o], g[0].walls[o + 2]) { continue; }
    a := x0 + (g[0].walls[o] - lx) * sc; b := x0 + (g[0].walls[o + 1] - lx) * sc;
    c := y0 + (hz - g[0].walls[o + 3]) * sc; e := y0 + (hz - g[0].walls[o + 2]) * sc;
    n = ui_box(out, n, a, c, b, e, 1.5 * k, ink);
  }
  // the ring: the field's edge, the bays' back wall, a line at each pier, and each section's letters;
  // the way in (A1) in orange, the empty section where the drill mech stands in blue
  h := ga_span() * 0.5; nm: [2] u8;
  for k2: 0..<GA_SECTIONS {
    a := ga_angle(k2);
    for j: 0..<3 {
      s0 := a - h + ga_span() * cast(f32) j / 3; s1 := s0 + ga_span() / 3;
      for r: [2] f32.[rf, rb] {
        if r == rb && ga_gap(k2) > 0 && j == 1 { continue; }   // the tunnel and the hallway open the back wall
        n = ui_seg(out, n, x0 + (gx + sin(s0) * r - lx) * sc, y0 + (hz - gz - cos(s0) * r) * sc, x0 + (gx + sin(s1) * r - lx) * sc, y0 + (hz - gz - cos(s1) * r) * sc, 1.2 * k, ink, 1);
      }
    }
    b := a + h;
    n = ui_seg(out, n, x0 + (gx + sin(b) * rf - lx) * sc, y0 + (hz - gz - cos(b) * rf) * sc, x0 + (gx + sin(b) * rb - lx) * sc, y0 + (hz - gz - cos(b) * rb) * sc, 1 * k, ink, 1);
    c := ga_pt(g, a, (rf + rb) * 0.5, 0);
    col := ifx k2 == GA_ENTRY then HEAT() else ifx k2 == GA_EMPTY then GLOW_INK() else ink;
    n = ui_mid(out, n, ga_name(k2, nm[..]), x0 + (c.x - lx) * sc, y0 + (hz - c.z) * sc + 3 * k, 6.5 * k, col);
  }
  in_at := ga_pt(g, ga_angle(GA_ENTRY), rb + 12, 0);
  n = ui_mid(out, n, "WAY IN", x0 + (in_at.x - lx) * sc, y0 + (hz - in_at.z) * sc + 3 * k, 7 * k, HEAT());
  px := x0 + (g[0].px - lx) * sc; pz := y0 + (hz - g[0].pz) * sc;
  rx := x0 + (g[0].at.rover_x - lx) * sc; rz := y0 + (hz - g[0].at.rover_z) * sc;
  n = ui_box(out, n, rx - 6 * k, rz - 9 * k, rx + 6 * k, rz + 9 * k, 3 * k, ink); n = ui_text(out, n, "SNIPER", rx + 10 * k, rz + 4 * k, 7 * k, ink);
  if !g[0].rubble_gone { yy := y0 + (hz - g[0].at.rubble_z) * sc; n = ui_seg(out, n, x0 + (-3 - lx) * sc, yy, x0 + (3 - lx) * sc, yy, 3 * k, t3(0.56, 0.36, 0.28), 1); }
  if !g[0].wall_gone { yy := y0 + (hz - g[0].at.wall_z) * sc; n = ui_seg(out, n, x0 + (-4 - lx) * sc, yy, x0 + (4 - lx) * sc, yy, 3 * k, GLOW_INK(), 1); }
  bz := y0 + (hz - g[0].at.boss_z) * sc; bx := x0 + (g[0].at.boss_x - lx) * sc;
  n = ui_mid(out, n, "DEEPER", bx, bz + 4 * k, 8 * k, GLOW_INK());
  if g[0].bot { n = ui_seg(out, n, x0 + (g[0].bot_x - lx) * sc, y0 + (hz - g[0].bot_z) * sc, x0 + (g[0].bot_x - lx) * sc, y0 + (hz - g[0].bot_z) * sc, 4 * k, GLOW_INK(), 1); }
  if g[0].px >= lx && g[0].px <= hx && g[0].pz >= lz && g[0].pz <= hz {   // she is on the map (not still at the farm)
    n = ui_seg(out, n, px, pz, px, pz, 6 * k, HEAT(), 1);
    n = ui_seg(out, n, px, pz, px + sin(g[0].yaw) * 14 * k, pz - cos(g[0].yaw) * 14 * k, 1.5 * k, HEAT(), 1);
  }
  n = ui_mid(out, n, "You (orange) · Digger (blue)", q.w * 0.5, y0 + mh + 32 * k, 8 * k, ink);
  return n;
}
// The map's close hint, centred on cx: a dark bar with the keys on a cream chip (the HUD's key chip,
// hud.coax hv_prompt) and CLOSE.
D_MAP_HINT :: "M / ESC";
d_map_hint_w :: (k: f32) -> f32 { return ui_w(F_TITLE, D_MAP_HINT, 8 * k) + 16 * k + 12 * k + ui_w(F_TITLE, "CLOSE", 10 * k) + 28 * k; }
d_map_hint :: (out: [] f32, at: int, cx: f32, cy: f32, k: f32) -> int {
  n := at; kc := 8 * k; vc := 10 * k;
  kw := ui_w(F_TITLE, D_MAP_HINT, kc) + 16 * k;
  bw := d_map_hint_w(k); x0 := cx - bw * 0.5;
  n = hv_rect(out, n, x0, cy - 20 * k, x0 + bw, cy + 20 * k, HV_PANEL(), 0.95);
  kx := x0 + 14 * k;
  n = hv_rect(out, n, kx, cy - 11 * k, kx + kw, cy + 11 * k, HV_CREAM(), 1);
  n = hv_mid(out, n, F_TITLE, D_MAP_HINT, kx + kw * 0.5, cy + 4 * k, kc, HV_PANEL(), 1);
  return hv_text(out, n, F_TITLE, "CLOSE", kx + kw + 12 * k, cy + 5 * k, vc, HV_CREAM(), 1);
}
// The controls, as the sheet maps them: shown on the pause screen.
D_KEYS :: 16;
d_controls :: () -> [D_KEYS * 2] string {
  return [D_KEYS * 2] string.[
    "W A S D", "Walk", "Mouse", "Look; scroll to zoom", "Space", "Jump; again in the air to jump higher",
    "Q", "Hoverboard on, then casual or fast", "Hold Ctrl or W W", "Hoverboard very fast; Q Q super fast, hold Q off",
    "E", "Interact, enter the rover, swap a core, tow or charge Digger", "Tab", "Edit bay, inside Sniper", "I", "Inventory",
    "Left click", "Point Digger: dig, pick up, attack", "F", "Stun a robot within 2 m", "1 2 3 4", "Battle moves",
    "Hold R", "Bot wheel: dig, pick up, attack, follow, charge", "M", "Map", "O", "Change outfit, inside Sniper", "Esc", "Pause", "G", "Graybox"];
}
d_pause_screen :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, at: int) -> int { return hv_pause(g, out, u, at, q); }   // hud.coax
// The Director's HUD: her panel top left, the bars over the bots, her line, and the grid, the map
// or the pause screen when one is open. The game's HUD draws the rest.
d_hud :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, at: int) -> int {
  n := at; d := g[0].dr[0];
  g[0].dr[0].sw = q.w; g[0].dr[0].sh = q.h;
  if !d.paused && !d.bag && !d.map { n = d_plates(g, out, q, n); }   // under an open window the bars would show through
  // the crosshair Digger is pointed with
  if g[0].mode == M_PLAY && !d.paused && !d.bag && !d.map && g[0].bot {
    k := q.k; cx := q.w * 0.5; cy := q.h * 0.5; c := ifx d.sel.kind != DP_NONE && d_can(g, d.sel) == DS_NONE then HEAT() else INK();
    n = ui_seg(out, n, cx - 9 * k, cy, cx - 3 * k, cy, 1.2 * k, c, 0.9); n = ui_seg(out, n, cx + 3 * k, cy, cx + 9 * k, cy, 1.2 * k, c, 0.9);
    n = ui_seg(out, n, cx, cy - 9 * k, cx, cy - 3 * k, 1.2 * k, c, 0.9); n = ui_seg(out, n, cx, cy + 3 * k, cx, cy + 9 * k, 1.2 * k, c, 0.9);
    n = d_select_hud(g, out, q, n, cx, cy);   // what is selected and the command it gives (digger-orders.coax)
  }
  if d.say != DS_NONE && !d.paused {
    t := d_text(d.say); k := q.k; mw := ui_w(F_MONO, t, 10 * k) + 40 * k; y0 := q.h * 0.3 + 60 * k;
    n = ui_seg(out, n, q.w * 0.5 - mw * 0.5 + 18 * k, y0, q.w * 0.5 + mw * 0.5 - 18 * k, y0, 18 * k, INK(), 0.92);
    n = ui_mid(out, n, t, q.w * 0.5, y0 + 4 * k, 10 * k, PAPER());
  }
  if d.wheel.open && !d.paused { n = d_wheel_draw(g, out, u, q, n); }
  if d.bag { n = d_bag(g, out, u, q, n); }
  if d.map { n = d_map(g, out, u, q, n); }
  if d.paused { n = d_pause_screen(g, out, u, q, n); }
  return n;
}
