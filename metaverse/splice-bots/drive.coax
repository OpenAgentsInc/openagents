// The drive (#13505): Sniper takes you from the solar farm to the garage. A world's portal whose TO is
// "ride X Z" (metaverse-engine/world/portal.coax) is a drive, not a door: you watch the rover from
// outside as it goes from where you boarded it to where it parks (the Rover landmark), then you step out
// at X Z. It is a short drive, and the run's beats move the day on where it ends (the garage yard's
// beat: day to dusk). Sniper only goes once Digger can drill: the DRILL card is in hand.
//
// Inside the rover: the room a vehicle's door opens onto is the area holding that door portal's TO.
// The edit bay and the outfit change are there (director.coax asks sp_in_room).

#load "../../metaverse-engine/physics/vehicle.coax";   // Sniper on the drive: the engine's wheeled vehicle

M_DRIVE :: 9;                     // splice-game.coax's modes, then front.coax's 7 and 8
MSG_NO_DRILL :: 40;               // the drive asked for before the DRILL card is found
MSG_MAP :: 41;                    // Sniper puts the deep-garage map up at the desk
MSG_OUTFIT :: 42;                 // she changed her outfit in the rover's room
MSG_EDGE :: 43;                   // past the plain's edge: turned back (plain.coax)
// The road (layout per the level spec, #13552): out of the farm the way the rover faces (south), a dip
// across the middle of the plain, and up into the garage's least-used opening heading DV_IN_DEG. She
// drives it herself; the curve is the line the raider mech keeps watch beside and the checks drive.
DV_PULL_OUT :: 0.22f32; DV_PULL_IN :: 0.35f32;   // of the way: the curve's pulls out of the start and into the parking
DV_IN_DEG :: 105;                 // degrees: the way Sniper drives in to park, east and a little north
// The raider mech's chase on the drive (splice-battle.coax sb_rm_step): it keeps watch beside the road a
// little past halfway, at the road's low point, and gives chase when Sniper comes within DV_RM_NOTICE, at
// SB_RM_CHASE, slower than Sniper's top speed (outrun it at speed: it gives up DV_RM_GIVE_UP behind), and
// turns back near the garage. E beside it battles it from Sniper, and Sniper holds still to fight.
DV_RM_AT :: 0.6f32; DV_RM_QUIT :: 0.92f32;   // of the way: where it keeps watch, where it turns back
DV_RM_NOTICE :: 45.0f32; DV_RM_GIVE_UP :: 60.0f32;   // m: on the drive she can pass it anywhere across the desert

SpDrive :: struct {
  t: f32; span: f32;              // seconds into the drive, and how long it takes
  ax: f32; az: f32;               // where it starts (where you boarded the rover)
  cx: f32; cz: f32; dx: f32; dz: f32;   // the curve's two pulls: out of the start, into the parking
  bx: f32; bz: f32;               // where it parks
  out_x: f32; out_z: f32; out_deg: int;   // where you step out, and the way you face
  vx: f32; vz: f32; vyaw: f32; boarded: bool;   // the rover you last went into: where it stood
  vid: int;                                       // and its piece's item ID in the layer (hidden while it drives)
  shown: bool;                                    // Sniper has put the deep-garage map up at the desk this run
  sx: f32; sz: f32; syaw: f32;                    // Sniper on the drive, and where it is parked once she has driven it
  away: bool;                                     // she has driven it away from the farm's charger
  hid: int = -1; hid_gen: int; hid_built: int;   // dv_hidden as of the last step, and the World and layer it was taken out of
  brake: bool;                                    // Space held: the handbrake
}
// Sniper as the engine's vehicle on the drive (metaverse-engine/physics/vehicle.coax): apart from SpDrive, so
// the rest of the game's reads of the drive stay small.
SpVehicle :: struct { spec: VehicleSpec; body: RigidBody; vs: VehicleState; }

// The ID of the smallest area that holds (x, z), or 0: the farm's desert, the rover's room, the garage yard.
sc_area_at :: (g: [] SpGame, x: f32, z: f32) -> int { return sc_area_in(g[0].c[..], x, z); }
// Inside the rover's room: in the area that holds the TO of a door portal from a vehicle's kind.
sp_in_room :: (g: [] SpGame) -> bool {
  c := g[0].c[..];
  for k: 0..<c[0].portal_n {
    p := c[0].portals[k];
    if !p.ok || p.kind == 0 || p.ride { continue; }
    tx := sc_m(p.to_x); tz := sc_m(p.to_z);
    for a: 0..<c[0].area_n { if sc_area_holds(c, a, tx, tz) && sc_area_holds(c, a, g[0].px, g[0].pz) { return true; } }
  }
  return false;
}
// The rover's room is a level of its own (playtest 2): a closed cabin round that area, half a metre in
// from its edges: a floor, four solid walls with no gap and a ceiling, so nothing of the world outside
// shows and no one walks out. Its windows (placed Window wall pieces) show a painted desert on the
// wall behind them. E at its door (the leave portal) goes back out beside Sniper.
DV_ROOM_IN :: 0.5f32;             // m: the cabin's inside, in from the area's edges
DV_ROOM_H :: 4.2f32;              // m: its ceiling
DV_ROOM_T :: 0.3f32;              // m: its walls' thickness
DV_ROOM_REACH :: 3.6f32;          // m: the camera stays this near her inside, under the ceiling
DV_FRONT_Y0 :: 0.85f32; DV_FRONT_Y1 :: 2.7f32;   // m: the front window's sill and head
DV_BAY_HX :: 1.8f32; DV_BAY_D :: 0.8f32; DV_BAY_H :: 0.95f32;   // m: the edit bay console's half width, depth and height
DV_WINDOW_KIND :: 127;            // the Window wall piece: a painted desert behind each one in the cabin
SpRoom :: struct { ok: bool; x0: f32; x1: f32; z0: f32; z1: f32; door_x: f32; door_z: f32; door: bool; }
// The cabin: the inside of the area that holds a vehicle door's TO, and the leave portal's point in it.
dv_room :: (g: [] SpGame) -> SpRoom {
  c := g[0].c[..]; r := SpRoom.{};
  for k: 0..<c[0].portal_n {
    p := c[0].portals[k];
    if !p.ok || p.kind == 0 || p.ride { continue; }
    tx := sc_m(p.to_x); tz := sc_m(p.to_z);
    for a: 0..<c[0].area_n {
      m := c[0].areas[a];
      if m.r > 0 || !sc_area_holds(c, a, tx, tz) { continue; }
      r = SpRoom.{ok = true, x0 = m.x - m.hx + DV_ROOM_IN, x1 = m.x + m.hx - DV_ROOM_IN, z0 = m.z - m.hz + DV_ROOM_IN, z1 = m.z + m.hz - DV_ROOM_IN};
      for j: 0..<c[0].portal_n {
        q := c[0].portals[j];
        if !q.ok || q.kind != 0 || q.ride { continue; }
        if sc_area_holds(c, a, sc_m(q.x), sc_m(q.z)) { r.door = true; r.door_x = sc_m(q.x); r.door_z = sc_m(q.z); }
      }
      return r;
    }
  }
  return r;
}
dv_room_has :: (r: SpRoom, x: f32, z: f32) -> bool { return r.ok && x > r.x0 - DV_ROOM_T - 0.01 && x < r.x1 + DV_ROOM_T + 0.01 && z > r.z0 - DV_ROOM_T - 0.01 && z < r.z1 + DV_ROOM_T + 0.01; }
// The cabin's walls as colliders (g_layout), as tall as its ceiling so the camera meets them too, corners
// closed. They are drawn apart (dv_room_draw), not as the mine's rock walls.
dv_room_walls :: (g: [] SpGame) {
  r := dv_room(g); t := DV_ROOM_T; H := DV_ROOM_H;
  if !r.ok { return; }
  g_wall(g, r.x0 - t, r.x1 + t, r.z0 - t, r.z0, H); g_wall(g, r.x0 - t, r.x1 + t, r.z1, r.z1 + t, H);
  g_wall(g, r.x0 - t, r.x0, r.z0, r.z1, H); g_wall(g, r.x1, r.x1 + t, r.z0, r.z1, H);
  cx := (r.x0 + r.x1) * 0.5;
  g_wall(g, cx - DV_BAY_HX, cx + DV_BAY_HX, r.z1 - DV_BAY_D, r.z1, DV_BAY_H);   // the edit bay's console
}
// The cabin drawn into the world (g_world): its floor, walls, ceiling, the ribs of the hull, the lights
// and the door.
dv_room_draw :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  r := dv_room(g); t := DV_ROOM_T; H := DV_ROOM_H;
  if !r.ok { return; }
  cx := (r.x0 + r.x1) * 0.5; cz := (r.z0 + r.z1) * 0.5; hx := (r.x1 - r.x0) * 0.5; hz := (r.z1 - r.z0) * 0.5;
  // the floor: deck plates under everything, so there is no void below
  kit_pen(p, 81, MAT_WORLD, t3(0.42, 0.38, 0.40));
  block(buf, p, cx, -0.3, cz, hx + t, 0.3, hz + t);
  kit_pen(p, 82, MAT_FLAT, t3(0.34, 0.30, 0.33));
  for i: 1..<cast(int) (hx * 2) { block(buf, p, r.x0 + cast(f32) i, 0, cz, 0.012, 0.006, hz); }
  // the walls, closed all round, and the ceiling
  wall := t3(0.88, 0.82, 0.72);
  kit_pen(p, 83, MAT_WORLD, wall);
  block(buf, p, cx, 0, r.z0 - t * 0.5, hx + t, H, t * 0.5); block(buf, p, cx, 0, r.z1 + t * 0.5, hx + t, H, t * 0.5);
  block(buf, p, r.x0 - t * 0.5, 0, cz, t * 0.5, H, hz);
  // the front (the right wall, +x): one big window across all of it, the wall only under and over it
  block(buf, p, r.x1 + t * 0.5, 0, cz, t * 0.5, DV_FRONT_Y0, hz); block(buf, p, r.x1 + t * 0.5, DV_FRONT_Y1, cz, t * 0.5, H - DV_FRONT_Y1, hz);
  dv_front_view(buf, p, r.x1 + t * 0.6, r.z0, r.z1);
  kit_pen(p, 96, MAT_SKIN, HEAT());   // its orange frame: sill, head and three mullions
  block(buf, p, r.x1 - 0.06, DV_FRONT_Y0 - 0.08, cz, 0.12, 0.08, hz); block(buf, p, r.x1 - 0.04, DV_FRONT_Y1, cz, 0.08, 0.08, hz);
  for i: 1..<4 { block(buf, p, r.x1 - 0.03, DV_FRONT_Y0, r.z0 + (r.z1 - r.z0) * cast(f32) i / 4, 0.05, DV_FRONT_Y1 - DV_FRONT_Y0, 0.05); }
  // the corners rounded off: a panel across each, so the cabin is a rounded rectangle
  kit_pen(p, 83, MAT_WORLD, wall);
  for c: 0..<4 {
    sx := ifx c % 2 == 0 then 1.0f32 else -1.0f32; sz := ifx c < 2 then 1.0f32 else -1.0f32;
    x := ifx c % 2 == 0 then r.x0 else r.x1; z := ifx c < 2 then r.z0 else r.z1;
    box(buf, p, kit_at(frame_at(v3(x + sx * 0.32, 0, z + sz * 0.32), ifx sx * sz > 0 then PI * 0.25 else -PI * 0.25), 0, H * 0.5, 0), 0.5, H * 0.5, 0.1);
  }
  dv_bay_console(buf, p, cx, r.z1);
  kit_pen(p, 84, MAT_FLAT, t3(0.80, 0.75, 0.68));
  block(buf, p, cx, H, cz, hx + t, 0.2, hz + t);
  // the hull's ribs across the ceiling and down the walls, and a dark baseboard
  kit_pen(p, 85, MAT_FLAT, t3(0.70, 0.62, 0.54));   // flat: the ribs cast no stripes of shadow
  n := cast(int) (hx / 1.5);
  for i: 0..<n + 1 {
    x := r.x0 + 0.1 + (r.x1 - r.x0 - 0.2) * cast(f32) i / cast(f32) hi_int(n, 1);
    block(buf, p, x, H - 0.25, cz, 0.08, 0.25, hz);
    block(buf, p, x, 2.75, r.z0 + 0.06, 0.08, H - 2.75, 0.06); block(buf, p, x, 2.75, r.z1 - 0.06, 0.08, H - 2.75, 0.06);
  }
  kit_pen(p, 86, MAT_CLOTH, t3(0.20, 0.17, 0.20));
  block(buf, p, cx, 0, r.z0 + 0.02, hx, 0.12, 0.02); block(buf, p, cx, 0, r.z1 - 0.02, hx, 0.12, 0.02);
  block(buf, p, r.x0 + 0.02, 0, cz, 0.02, 0.12, hz); block(buf, p, r.x1 - 0.02, 0, cz, 0.02, 0.12, hz);
  // warm light strips under the ceiling
  kit_pen(p, 87, MAT_GLOW, t3(1.0, 0.86, 0.62));
  block(buf, p, cx, H - 0.06, cz - hz * 0.4, hx * 0.8, 0.05, 0.08); block(buf, p, cx, H - 0.06, cz + hz * 0.4, hx * 0.8, 0.05, 0.08);
  // the door out: a hatch in the wall it stands by, a lamp over it
  if r.door {
    f := dv_room_face(r, r.door_x, r.door_z);
    kit_pen(p, 88, MAT_SKIN, t3(0.72, 0.36, 0.26));
    box(buf, p, kit_at(f, 0, 1.1, 0.03), 0.7, 1.1, 0.03);
    kit_pen(p, 89, MAT_CLOTH, t3(0.20, 0.17, 0.20));
    box(buf, p, kit_at(f, 0, 2.24, 0.05), 0.8, 0.05, 0.05); box(buf, p, kit_at(f, -0.75, 1.1, 0.05), 0.05, 1.15, 0.05); box(buf, p, kit_at(f, 0.75, 1.1, 0.05), 0.05, 1.15, 0.05);
    box(buf, p, kit_at(f, 0.5, 1.05, 0.08), 0.03, 0.12, 0.03);
    kit_pen(p, 95, MAT_GLOW, HEAT());
    box(buf, p, kit_at(f, 0, 2.45, 0.05), 0.25, 0.05, 0.04);
  }
}
// A frame on the cabin's wall nearest (x, z), facing into the room (+z ahead), its x along the wall.
dv_room_face :: (r: SpRoom, x: f32, z: f32) -> Frame {
  d := [4] f32.[z - r.z0, r.z1 - z, x - r.x0, r.x1 - x];
  k := 0; for i: 1..<4 { if d[i] < d[k] { k = i; } }
  if k == 0 { return frame_at(v3(x, 0, r.z0), 0); }
  if k == 1 { return frame_at(v3(x, 0, r.z1), PI); }
  if k == 2 { return frame_at(v3(r.x0, 0, z), PI * 0.5); }
  return frame_at(v3(r.x1, 0, z), -PI * 0.5);
}
// The front window's painted view, a flat desert seen out of the right wall from z0 to z1: the sky, a
// low sun, far mesas, the dunes and the sand. It stands in the wall, so nothing outside shows.
dv_front_view :: (buf: [] u32, p: [] Pen, x: f32, z0: f32, z1: f32) {
  f := frame_at(v3(x, 0, (z0 + z1) * 0.5), -PI * 0.5); hw := (z1 - z0) * 0.5;
  y0 := DV_FRONT_Y0; y1 := DV_FRONT_Y1;
  kit_pen(p, 191, MAT_FLAT, t3(0.98, 0.84, 0.64)); box(buf, p, kit_at(f, 0, (y0 + y1) * 0.5, 0), hw, (y1 - y0) * 0.5, 0.01);
  kit_pen(p, 192, MAT_FLAT, t3(0.99, 0.93, 0.80)); box(buf, p, kit_at(f, hw * 0.35, y1 - 0.42, 0.015), 0.25, 0.25, 0.004);
  kit_pen(p, 193, MAT_FLAT, t3(0.72, 0.56, 0.74));
  box(buf, p, kit_at(f, -hw * 0.55, y0 + 0.62, 0.02), 1.1, 0.3, 0.004); box(buf, p, kit_at(f, -hw * 0.1, y0 + 0.55, 0.02), 0.7, 0.2, 0.004); box(buf, p, kit_at(f, hw * 0.6, y0 + 0.58, 0.02), 1.3, 0.24, 0.004);
  kit_pen(p, 194, MAT_FLAT, t3(0.93, 0.74, 0.50)); box(buf, p, kit_at(f, 0, y0 + 0.28, 0.025), hw, 0.28, 0.004);
  kit_pen(p, 195, MAT_FLAT, t3(0.86, 0.62, 0.42)); box(buf, p, kit_at(f, -hw * 0.2, y0 + 0.1, 0.03), hw * 0.7, 0.1, 0.004);
}
// The edit bay's console at the middle of the back of the cabin (the wall at z1): a wide desk with
// six slots along its top, one a part, and a screen over it. Tab opens the bay.
dv_bay_console :: (buf: [] u32, p: [] Pen, cx: f32, z1: f32) {
  zc := z1 - DV_BAY_D * 0.5;
  kit_pen(p, 92, MAT_SKIN, t3(0.30, 0.30, 0.36)); block(buf, p, cx, 0, zc, DV_BAY_HX, DV_BAY_H - 0.06, DV_BAY_D * 0.5);
  kit_pen(p, 93, MAT_FLAT, t3(0.88, 0.82, 0.72)); block(buf, p, cx, DV_BAY_H - 0.06, zc, DV_BAY_HX + 0.04, 0.06, DV_BAY_D * 0.5 + 0.04);
  for i: 0..<6 {
    x := cx - DV_BAY_HX + DV_BAY_HX * (cast(f32) i + 0.5) / 3;
    kit_pen(p, 94, MAT_FLAT, t3(0.14, 0.13, 0.16)); block(buf, p, x, DV_BAY_H, zc - 0.05, 0.2, 0.012, 0.2);
    kit_pen(p, 97, MAT_GLOW, CAST_CYAN()); block(buf, p, x, DV_BAY_H, zc + 0.17, 0.2, 0.016, 0.022);
  }
  kit_pen(p, 98, MAT_GLOW, t3(0.36, 0.78, 0.86)); block(buf, p, cx, DV_BAY_H + 0.45, z1 - 0.04, DV_BAY_HX * 0.6, 0.45, 0.02);
}
// Each frame (g_live): behind every window in the cabin, a painted desert on the wall: the sky, far
// mesas, the dunes and the sand.
dv_room_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  r := dv_room(g);
  if !r.ok { return; }
  for i: 0..<g[0].layer[0].st[0].n {
    e := g[0].layer[0].items[i];
    if e.mesh != DV_WINDOW_KIND || !dv_room_has(r, e.x, e.z) { continue; }
    f := dv_room_face(r, e.x, e.z);
    s := cast(f32) i * 1.7;
    kit_pen(p, 191, MAT_FLAT, t3(0.98, 0.84, 0.64)); box(buf, p, kit_at(f, 0, 1.75, 0.01), 1.25, 0.6, 0.005);
    kit_pen(p, 192, MAT_FLAT, t3(0.99, 0.93, 0.80)); box(buf, p, kit_at(f, 0.3 * sin(s), 2.0, 0.015), 0.22, 0.22, 0.004);   // the sun, low and pale
    kit_pen(p, 193, MAT_FLAT, t3(0.72, 0.56, 0.74));
    box(buf, p, kit_at(f, -0.55 + 0.2 * sin(s), 1.42, 0.02), 0.42, 0.22, 0.004); box(buf, p, kit_at(f, 0.5 - 0.2 * cos(s), 1.38, 0.02), 0.55, 0.16, 0.004);
    kit_pen(p, 194, MAT_FLAT, t3(0.93, 0.74, 0.50)); box(buf, p, kit_at(f, 0, 1.08, 0.025), 1.25, 0.2, 0.004);
    kit_pen(p, 195, MAT_FLAT, t3(0.86, 0.62, 0.42)); box(buf, p, kit_at(f, 0.35 * cos(s), 0.88, 0.03), 0.9, 0.1, 0.004);
  }
}

// The item ID of the placed piece hidden now (-1: none): the rover she boarded while she drives it, and
// the rover at the farm's charger once Sniper has left the farm (it is parked where she left it).
dv_hidden :: (g: [] SpGame) -> int {
  if !g[0].dv[0].away { return ifx g[0].mode == M_DRIVE && g[0].dv[0].boarded then g[0].dv[0].vid else -1; }
  return dv_train(g);
}
// The item ID of the first placed piece of the kind a door into the rover's room opens from (-1: none).
dv_train :: (g: [] SpGame) -> int {
  c := g[0].c[..];
  for k: 0..<c[0].portal_n {
    p := c[0].portals[k];
    if !p.ok || p.kind == 0 || p.ride { continue; }
    for i: 0..<g[0].layer[0].st[0].n { e := g[0].layer[0].items[i]; if e.mesh == p.kind { return e.id; } }
  }
  return -1;
}
// Each step, the World's colliders follow Sniper: parked, it is a body where she left it (none at the
// farm, none while she drives it); the hidden rover piece's collider is taken out, so nothing invisible
// blocks there.
dv_sync :: (g: [] SpGame) {
  hid := dv_hidden(g);
  want := g[0].dv[0].away && g[0].mode != M_DRIVE;
  if hid < 0 && !want && g[0].ws[0].rover < 0 { g[0].dv[0].hid = -1; return; }   // at the farm: nothing to do
  d := g[0].dv[..]; w := sl_world(g);
  if want && g[0].ws[0].rover < 0 {
    // the train as it is drawn, every car end to end, as tall as its roofs: she, Digger and the camera meet it (#13552)
    x := g[0].at.rover_x; z := g[0].at.rover_z; y := g[0].at.rover_yaw; row := sc_piece(g[0].c[..], SP_ROVER_KIND);
    g[0].ws[0].rover = ifx row >= 0 then sl_piece_body(g, SK_WALL, -2, row, x, 0, z, y) else sl_round(g, SK_WALL, -2, x, 0, z, y, SH_ALONG_Z, DV_HALF_W, DV_HALF_L - DV_HALF_W, DV_TOP_H);
    _ := world_commit(w);
  } else if !want && g[0].ws[0].rover >= 0 {
    world_despawn(w, world_at(w, g[0].ws[0].rover)); g[0].ws[0].rover = -1; _ := world_commit(w);
  }
  if hid >= 0 && (d[0].hid != hid || d[0].hid_gen != g[0].ws[0].builds || d[0].hid_built != g[0].layer[0].built) {
    for s: 0..<world_high(w) {
      h := world_at(w, s);
      if h != ENTITY_NONE && world_i(w, WI_KIND, s) >= SK_PIECE && world_i(w, WI_ROW, s) == hid { world_despawn(w, h); }
    }
    _ := world_commit(w);
    d[0].hid_gen = g[0].ws[0].builds; d[0].hid_built = g[0].layer[0].built;
  }
  d[0].hid = hid;
}

// Going through portal w: a door remembers the vehicle it is in (the nearest placed thing of its kind);
// a drive starts. False when the drive is refused (no DRILL card yet): you stay where you are.
dv_through :: (g: [] SpGame, w: int) -> bool {
  p := g[0].c[0].portals[w];
  d := g[0].dv[..];
  if !p.ride {
    if p.kind > 0 {
      best: f32 = -1;
      for i: 0..<g[0].layer[0].st[0].n {
        e := g[0].layer[0].items[i];
        if e.mesh != p.kind { continue; }
        r := dist2(g[0].px, g[0].pz, e.x, e.z);
        if best < 0 || r < best { best = r; d[0].vx = e.x; d[0].vz = e.z; d[0].vyaw = e.yaw; d[0].vid = e.id; d[0].boarded = true; }
      }
      if dv_away(g) { d[0].vx = g[0].at.rover_x; d[0].vz = g[0].at.rover_z; d[0].vyaw = g[0].at.rover_yaw; }   // the door of Sniper parked where she left it
    }
    if p.kind == 0 && dv_away(g) && sp_in_room(g) { dv_step_out(g); return true; }   // out of the cabin: beside Sniper where it is parked
    g_go(g, sc_m(p.to_x), sc_m(p.to_z), p.yaw); g[0].flash = 0.3;
    return true;
  }
  if !g[0].have[H_DRILL] { g_say(g, MSG_NO_DRILL); return false; }
  dv_start(g, sc_m(p.to_x), sc_m(p.to_z), p.yaw);
  return true;
}
// She drives Sniper herself (playtest 2): E at the desk takes the wheel of the rover she boarded. W and S
// drive and brake, A and D steer, Space is the handbrake, and the rover is the engine's wheeled vehicle
// (metaverse-engine/physics/vehicle.coax: one chassis on four sprung wheels over the flat ground). It is
// held out of the world's colliders and the solar farm's lines: a step that would put it into one is
// taken back and it stops, so it never drives through a wall, a piece or a building. E gets out:
// Sniper parks where it stands, she steps out beside it, and the edit bay, its charger and its door
// are where it is parked. The route the raider mech keeps watch beside is the line from where she took
// the wheel to the garage's parking (the Rover landmark), and the compass on the drive points there.
dv_start :: (g: [] SpGame, out_x: f32, out_z: f32, deg: int) {
  d := g[0].dv[..];
  bx := sc_mark(g[0].c[..], LM_ROVER).x; bz := sc_mark(g[0].c[..], LM_ROVER).z;
  if sc_mark(g[0].c[..], LM_ROVER).id != LM_ROVER { bx = g[0].at.rover_x; bz = g[0].at.rover_z; }
  ax := ifx d[0].boarded then d[0].vx else bx; az := ifx d[0].boarded then d[0].vz else bz + 60;
  l := hi(dist2(ax, az, bx, bz), 1);
  ux := (bx - ax) / l; uz := (bz - az) / l;
  fx := ifx d[0].boarded then sin(d[0].vyaw) else ux; fz := ifx d[0].boarded then cos(d[0].vyaw) else uz;
  if fx * ux + fz * uz < 0 { fx = -fx; fz = -fz; }   // a rover drives off forward, whichever end its row calls the front
  d[0].ax = ax; d[0].az = az; d[0].bx = bx; d[0].bz = bz;
  iy := sl_rad(DV_IN_DEG);
  d[0].cx = ax + fx * l * DV_PULL_OUT; d[0].cz = az + fz * l * DV_PULL_OUT;
  d[0].dx = bx - sin(iy) * l * DV_PULL_IN; d[0].dz = bz - cos(iy) * l * DV_PULL_IN;
  d[0].out_x = out_x; d[0].out_z = out_z; d[0].out_deg = deg;
  d[0].t = 0; d[0].span = 1;
  g[0].veh[0].spec = dv_spec();
  g[0].veh[0].body = vehicle_body(g[0].veh[0].spec, DV_MASS, d3(f64(ax), DV_RIDE_Y, f64(az)), dq_y(f64(atan2(fx, fz))));
  g[0].veh[0].vs = VehicleState.{};
  g[0].mode = M_DRIVE; g[0].flash = 0.3;
  g[0].fwd = false; g[0].back = false; g[0].left = false; g[0].right = false; d[0].brake = false;
  dv_pose(g);
  dv_rm_watch(g);
}
DV_MASS :: 1000.0;                // kg: the engine's roadster's, so it handles as that one does
DV_RIDE_Y :: 1.0;                 // m: the chassis's middle, sitting on its springs
DV_TOP :: 24.0f32;                // m/s: Sniper's top speed, past the raider mech's chase (SB_RM_CHASE)
DV_STEPS :: 120.0f32;             // physics steps a second
DV_HALF_W :: 1.5f32; DV_HALF_L :: 2.4f32;   // m: the cast's rover's footprint, for tables with no rover train row; she steps out DV_HALF_W + DV_OUT from its middle
DV_TOP_H :: 2.0f32;               // m: that rover's height to the camera and the party
DV_OUT :: 2.2f32;                 // m: she steps out this far to Sniper's left, inside the rover prompt's range (T_USE_RANGE)
DV_CRAWL :: 4.0f32;               // m/s: in a battle with the raider mech Sniper crawls, no faster
dv_spec :: () -> VehicleSpec { v := vehicle_roadster(); v.top_speed = f64(DV_TOP); v.jump = 0; return v; }
// Sniper's pose on the drive, from its body: the game's own place and heading follow it.
dv_pose :: (g: [] SpGame) {
  d := g[0].dv[..]; b := g[0].veh[0].body;
  f := rigid_axis(b, D3_Z);
  d[0].sx = cast(f32) (b.pos.x); d[0].sz = cast(f32) (b.pos.z);
  if abs(f.x) + abs(f.z) > 0.001 { d[0].syaw = atan2(cast(f32) f.x, cast(f32) f.z); }
  g[0].px = d[0].sx; g[0].pz = d[0].sz; g[0].yaw = d[0].syaw; g[0].pitch = 0;
}
// Sniper's footprint at (x, z) heading yaw: the stadium round the rover train as it is drawn, every
// car from the cab's nose to the last car's ramp (its pieces row, as its collider at the farm and parked).
dv_seg :: (g: [] SpGame, x: f32, z: f32, yaw: f32) -> SlSeg {
  row := sc_piece(g[0].c[..], SP_ROVER_KIND);
  if row < 0 { return sl_seg_of(x, z, yaw, SH_ALONG_Z, DV_HALF_W, DV_HALF_L - DV_HALF_W); }
  return sl_foot(g, row, x, z, yaw);
}
// Whether Sniper at (x, z), yaw, meets something: a collider (the rover she boarded at the farm is not
// counted: she drives out of it) or a line of the solar farm.
dv_blocked :: (g: [] SpGame, x: f32, z: f32, yaw: f32) -> bool {
  d := g[0].dv[0];
  e := dv_seg(g, x, z, yaw);
  if sl_touch(g, e, SK_WALL, false, true, ifx d.boarded then d.vid else -1) >= 0 { return true; }
  // the solar farm's lines: circles of its radius down its length, no further apart than that radius, so every car is held
  n := 1 + cast(int) (dist2(e.ax, e.az, e.bx, e.bz) / e.r + 0.999);
  for i: 0..<n + 1 {
    u := cast(f32) i / cast(f32) n;
    q := v3(e.ax + (e.bx - e.ax) * u, 0, e.az + (e.bz - e.az) * u); r := ff_push(q.x, q.z, e.r);
    if abs(r.x - q.x) + abs(r.z - q.z) > 0.0001 { return true; }
  }
  return false;
}
// The raider mech keeps watch beside the route (once beaten, it stays down).
dv_rm_watch :: (g: [] SpGame) {
  t := g[0].bt[..];
  if t[0].rm_down { return; }
  c := dv_at(g, DV_RM_AT); y := dv_yaw(g, DV_RM_AT);
  t[0].rm_x = c.x - cos(y) * SB_RM_WATCH; t[0].rm_z = c.z + sin(y) * SB_RM_WATCH; t[0].rm_yaw = y + PI * 0.5;
  t[0].rm_hunt = false; t[0].rm_gone = false; t[0].rm_claw = 0;
}
// The raider mech is on her: hunting, and up.
dv_chased :: (g: [] SpGame) -> bool { t := g[0].bt[0]; return t.rm_hunt && !t.rm_down; }
// The rover's speed along its heading, m/s.
dv_speed :: (g: [] SpGame) -> f32 { return cast(f32) (vehicle_forward_speed(g[0].veh[0].body)); }
// Keys on the drive: W and S drive and brake (S backs up once stopped), A and D steer, Space is the
// handbrake, E gets out (when the raider mech is not in reach of a battle: splice-battle.coax takes it then).
dv_key :: (g: [] SpGame, key: int, down: bool) -> bool {
  if key == 'w' || key == 'W' || key == -6 { g[0].fwd = down; return true; }
  if key == 's' || key == 'S' || key == -7 { g[0].back = down; return true; }
  if key == 'a' || key == 'A' || key == -4 { g[0].left = down; return true; }
  if key == 'd' || key == 'D' || key == -5 { g[0].right = down; return true; }
  if key == ' ' { g[0].dv[0].brake = down; return true; }
  if down && (key == 'e' || key == 'E') { dv_arrive(g); return true; }
  return true;
}
// Where the rover is on its route (the line from where she took the wheel to the parking), s from 0 to
// 1: the raider mech keeps watch beside it. A cubic curve, eased at both ends.
dv_at :: (g: [] SpGame, s: f32) -> Point {
  d := g[0].dv[0];
  k := clamp(s, 0, 1); k = k * k * (3 - 2 * k);
  u := 1 - k;
  x := u * u * u * d.ax + 3 * u * u * k * d.cx + 3 * u * k * k * d.dx + k * k * k * d.bx;
  z := u * u * u * d.az + 3 * u * u * k * d.cz + 3 * u * k * k * d.dz + k * k * k * d.bz;
  return v3(x, 0, z);
}
dv_yaw :: (g: [] SpGame, s: f32) -> f32 {
  a := dv_at(g, lo(s, 0.995)); b := dv_at(g, lo(s, 0.995) + 0.005);
  if dist2(a.x, a.z, b.x, b.z) < 0.0001 { return 0.2; }
  return atan2(b.x - a.x, b.z - a.z);
}
// How far along the route she is: 0 where she took the wheel, 1 at the parking.
dv_s :: (g: [] SpGame) -> f32 {
  d := g[0].dv[0];
  l := hi(dist2(d.ax, d.az, d.bx, d.bz), 1);
  return clamp(1 - dist2(d.sx, d.sz, d.bx, d.bz) / l, 0, 1);
}
// A step of the drive: her keys into the vehicle, the engine's steps, and any step into the world taken
// back. In a battle with the raider mech Sniper crawls (splice-battle.coax).
dv_step :: (g: [] SpGame, dt: f32) {
  d := g[0].dv[..];
  fight := sb_fighting(g) && abs(dv_speed(g)) > DV_CRAWL;
  input := VehicleInput.{throttle = ifx fight then 0.0 else f64((ifx g[0].fwd then 1.0f32 else 0.0f32) - (ifx g[0].back then 1.0f32 else 0.0f32)),
                         steer = f64((ifx g[0].right then 1.0f32 else 0.0f32) - (ifx g[0].left then 1.0f32 else 0.0f32)),
                         handbrake = d[0].brake || fight, jump = false};
  ground := [1] Plane.[plane(D3_Y, 0.0)];
  n := cast(int) (dt * DV_STEPS + 0.999); if n < 1 { n = 1; } if n > 12 { n = 12; }
  h := f64(dt) / f64(n);
  for i: 0..<n {
    was := g[0].veh[0].body;
    out := vehicle_step(g[0].veh[0].body, g[0].veh[0].spec, g[0].veh[0].vs, input, ground[..], d3(0.0, -9.81, 0.0), h);
    store := [1] RigidBody.[out.body]; store[0].sleeping = false;
    w := rigid_world(h, store[..]); w = rigid_step(w, D3_ZERO);
    b := vehicle_collide(store[0], g[0].veh[0].spec, ground[..], 0.1, 0.6);
    f := rigid_axis(b, D3_Z);
    if dv_blocked(g, cast(f32) (b.pos.x), cast(f32) (b.pos.z), atan2(cast(f32) f.x, cast(f32) f.z)) {
      b = was; b.vel = D3_ZERO; b.omega = D3_ZERO;   // into a wall: it stops there
    }
    g[0].veh[0].body = b; g[0].veh[0].vs = out.state;
  }
  dv_pose(g);
  g_beats(g);
  sb_ride(g, dt);   // the raider mech's chase, and a battle with it from Sniper (splice-battle.coax)
}
// Out of the cabin once Sniper has left the farm: beside it where it is parked.
dv_step_out :: (g: [] SpGame) {
  p := dv_door(g);
  g_go(g, p.x, p.z, 0); g[0].yaw = g[0].at.rover_yaw; g_bot_home(g); g[0].flash = 0.3;
}
// Sniper's door where it is parked: at its left, or its right when something stands there.
dv_door :: (g: [] SpGame) -> Point {
  y := g[0].at.rover_yaw; ox := -cos(y); oz := sin(y); out := DV_HALF_W + DV_OUT;
  x := g[0].at.rover_x + ox * out; z := g[0].at.rover_z + oz * out;
  if sl_touch(g, sl_seg_of(x, z, 0, SH_ALONG_Z, T_RADIUS, 0), SK_WALL, false, true, -1) >= 0 { x = g[0].at.rover_x - ox * out; z = g[0].at.rover_z - oz * out; }
  return v3(x, 0, z);
}
// On foot from (x, z) to Sniper's door, round the train when (x, z) is on its other side
// (#13552): an 18 m train is walked round, never through. dv_round_end: which end to go round, -1 for
// none (the way is clear); dv_round_at: the point past that end on the door's side (side 1) or the other.
dv_round_end :: (g: [] SpGame, x: f32, z: f32) -> int {
  d := dv_door(g); o := dv_seg(g, g[0].at.rover_x, g[0].at.rover_z, g[0].at.rover_yaw);
  sx := d.x - g[0].at.rover_x; sz := d.z - g[0].at.rover_z;
  if (x - g[0].at.rover_x) * sx + (z - g[0].at.rover_z) * sz > 0 { return -1; }   // on the door's side of it already
  near := ifx dist2(x, z, o.ax, o.az) < dist2(x, z, o.bx, o.bz) then 0 else 1;
  return ifx dv_round_free(g, near) || !dv_round_free(g, 1 - near) then near else 1 - near;   // the nearer end, unless something stands past it (a wall at its cab)
}
dv_round_at :: (g: [] SpGame, e: int, side: f32) -> Point {
  d := dv_door(g); o := dv_seg(g, g[0].at.rover_x, g[0].at.rover_z, g[0].at.rover_yaw);
  rx := g[0].at.rover_x; rz := g[0].at.rover_z;
  ex := ifx e == 0 then o.ax else o.bx; ez := ifx e == 0 then o.az else o.bz;
  ux := ex - rx; uz := ez - rz; l := hi(dist2(ex, ez, rx, rz), 0.01); out := o.r + T_RADIUS + 1.5;
  return v3(ex + ux / l * out + (d.x - rx) * side, 0, ez + uz / l * out + (d.z - rz) * side);
}
dv_round_free :: (g: [] SpGame, e: int) -> bool {
  for k: 0..<2 {
    p := dv_round_at(g, e, ifx k == 0 then 1.0f32 else -1.0f32);
    if sl_touch(g, SlSeg.{ax = p.x, az = p.z, bx = p.x, bz = p.z, r = T_RADIUS + 0.2}, SK_WALL, false, true, -1) >= 0 { return false; }
  }
  return true;
}
// E on the drive: Sniper parks where it stands and she steps out at its left, clear of it.
dv_arrive :: (g: [] SpGame) {
  d := g[0].dv[..];
  d[0].boarded = false; d[0].away = true;
  if sb_fighting(g) && g[0].bt[0].kind == SBF_DESERT { sb_finish(g); }   // a battle on the road ends where she parks
  g[0].bt[0].rm_hunt = false; g[0].fwd = false; g[0].back = false; g[0].left = false; g[0].right = false; d[0].brake = false;
  g[0].mode = M_PLAY;
  dv_park(g, d[0].sx, d[0].sz, d[0].syaw);
  dv_step_out(g);   // at its left, as she sat facing ahead
  // parked near the garage's least-used opening, she faces it, not open ground
  w := dv_way_in(g);
  if dist2(g[0].px, g[0].pz, w.x, w.z) < DV_FACE_NEAR { g[0].yaw = atan2(w.x - g[0].px, w.z - g[0].pz); g_bot_home(g); }
  g_beats(g);   // where you step out: the garage yard's beat makes it dusk
  if g[0].phase != PH_DAY && g[0].leave_at <= 0 { g[0].leave_at = g[0].t; }   // and the raiders are on their way out as she arrives
}
// Sniper parked at (x, z), heading yaw: the game's rover place (the edit bay, the charger, the compass's
// ROVER), its collider and its door are there now.
dv_park :: (g: [] SpGame, x: f32, z: f32, yaw: f32) {
  d := g[0].dv[..];
  d[0].sx = x; d[0].sz = z; d[0].syaw = yaw; d[0].away = true;
  g[0].at.rover_x = x; g[0].at.rover_z = z; g[0].at.rover_yaw = yaw;
  sl_body_to(g, g[0].ws[0].rover, x, z, yaw);
  dv_sync(g);
}
// Sniper has left the solar farm (she drove it, or a still stands past the drive): it is parked at the
// game's rover place, and the rover at the farm's charger is gone from there.
dv_away :: (g: [] SpGame) -> bool { return g[0].dv[0].away; }
// Where Sniper is: parked where she left it, or the rover at the farm's charger.
dv_sniper :: (g: [] SpGame) -> Point {
  if g[0].mode == M_DRIVE { return v3(g[0].dv[0].sx, 0, g[0].dv[0].sz); }
  if !dv_away(g) { id := dv_train(g); if id >= 0 { e := g[0].layer[0].items[sl_item(g, id)]; return v3(e.x, 0, e.z); } }
  return v3(g[0].at.rover_x, 0, g[0].at.rover_z);
}
// A scripted host (the Unreal bridge's run, 611) puts Sniper at (x, z) on the drive, facing the garage's parking.
dv_place :: (g: [] SpGame, x: f32, z: f32) {
  d := g[0].dv[..];
  y := atan2(d[0].bx - x, d[0].bz - z);
  g[0].veh[0].body = vehicle_body(g[0].veh[0].spec, DV_MASS, d3(f64(x), DV_RIDE_Y, f64(z)), dq_y(f64(y)));
  g[0].veh[0].vs = VehicleState.{};
  dv_pose(g);
}
DV_FACE_NEAR :: 90.0f32;   // m: stepping out this near the way in, she faces it
// The garage's least-used opening: the mouth of the old entrance bay's tunnel through the back wall (A1).
dv_way_in :: (g: [] SpGame) -> Point { return ga_pt(g, ga_angle(GA_ENTRY), ga_back(g) + GA_BACK * 2, 0); }
// Whether she faces the way in, within a tenth of a turn.
dv_facing_in :: (g: [] SpGame) -> bool {
  w := dv_way_in(g);
  a := atan2(w.x - g[0].px, w.z - g[0].pz) - g[0].yaw;
  while a > PI { a -= TAU; } while a < -PI { a += TAU; }
  return abs(a) < TAU * 0.05;
}
// The camera outside: behind the rover and above it, looking down the road ahead.
dv_camera :: (g: [] SpGame) -> CamNow {
  d := g[0].dv[0]; y := d.syaw;
  fx := sin(y); fz := cos(y);
  return CamNow.{eye = v3(d.sx - fx * 13, 5.6, d.sz - fz * 13), at = v3(d.sx + fx * 8, 1.4, d.sz + fz * 8), fov = 0.8};
}
// Drive Sniper with the keys (W, A, D, S) to within `near` of (x, z), at most `secs`: whether it got
// there, stopped. The checks' and the stills' way of driving, as a player does. To the parking it
// keeps to the road (dv_at) until DV_ROAD_OFF from it: the whole train, 18 m long, does not turn in
// the mine mouth's corner the straight line would take it into (#13552).
DV_ROAD_OFF :: 25.0f32;
dv_keys_to :: (g: [] SpGame, x: f32, z: f32, near: f32, secs: f32) -> bool {
  still: f32 = 0; best := 1e9f32; back: f32 = 0;
  road := dist2(x, z, g[0].dv[0].bx, g[0].dv[0].bz) < 0.01; u: f32 = 0; bd := 1e9f32;
  for k: 0..<101 { q := dv_at(g, cast(f32) k * 0.01); r := dist2(q.x, q.z, g[0].dv[0].sx, g[0].dv[0].sz); if r < bd { bd = r; u = cast(f32) k * 0.01; } }
  for i: 0..<cast(int) (secs / 0.02) {
    d := g[0].dv[0]; r := dist2(d.sx, d.sz, x, z);
    if r < near && abs(dv_speed(g)) < 0.5 { for k: [4] int.['w', 's', 'a', 'd'] { _ := g_key(g, k, false); } return true; }
    ax := x; az := z;
    if road && r > DV_ROAD_OFF {
      bd = 1e9; at := u;
      for k: 0..<11 { v := clamp01(u + cast(f32) k * 0.01); q := dv_at(g, v); e := dist2(q.x, q.z, d.sx, d.sz); if e < bd { bd = e; at = v; } }
      u = at; c := dv_at(g, clamp01(u + 0.05)); ax = c.x; az = c.z;
    }
    turn := atan2(ax - d.sx, az - d.sz) - d.syaw;
    while turn > PI { turn -= TAU; } while turn < -PI { turn += TAU; }
    if back > 0 {
      back -= 0.02;   // stuck on something: back up, steering the other way
    } else {
      go := r > near && (r > 30 || dv_speed(g) < 3 + r * 0.3);
      _ := g_key(g, 'w', go); _ = g_key(g, 's', !go && dv_speed(g) > 0.5); _ = g_key(g, 'a', turn > 0.05); _ = g_key(g, 'd', turn < -0.05);
      if r < best - 0.5 { best = r; still = 0; } else { still += 0.02; }
      if still > 2 && r > near { still = 0; back = 1.5; _ = g_key(g, 'w', false); _ = g_key(g, 's', true); _ = g_key(g, 'a', turn < 0); _ = g_key(g, 'd', turn > 0); }
    }
    g_step(g, 0.02);
    if g[0].mode != M_DRIVE { return false; }
  }
  return false;
}
dv_draw :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  d := g[0].dv[0];
  g_draw_rover(g, buf, p, v3(d.sx, 0.2, d.sz), d.syaw);
}

// At the desk (where the world's drive portal is): the first time she comes to it, Sniper puts the
// deep-garage map up on the screens (director.coax d_map; M opens and closes it as anywhere).
dv_desk :: (g: [] SpGame) {
  if g[0].mode != M_PLAY || g[0].dv[0].shown { return; }
  w := g_portal(g);
  if w < 0 || !g[0].c[0].portals[w].ride { return; }
  g[0].dv[0].shown = true; g[0].dr[0].map = true; g[0].dr[0].bag = false; g_say(g, MSG_MAP);
}
// O in the rover's room: the next of the wardrobe's outfits on her character (metaverse-engine/kit/
// crew-wardrobe.coax, through the creation screen's own step, crew-player.coax cp_step). The character
// this browser keeps is written again, so the outfit stays on.
dv_outfit :: (g: [] SpGame) -> bool {
  if g[0].mode != M_PLAY || !sp_in_room(g) { return false; }
  f := g[0].fr[..];
  f[0].doc[0] = cp_step(f[0].doc[0], CP_OUTFIT, 1); f[0].doc_gen += 1;
  f[0].crew_n = hi_int(cd_write(f[0].doc[0], f[0].crew_text[..]), 0); if f[0].crew_n > 0 { f[0].crew_put = 1; }
  g_say(g, MSG_OUTFIT);
  return true;
}
// The room's own keys, under the prompt: the wardrobe and the map, with the outfit she has on.
dv_room_hint :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, at: int) -> int {
  if g[0].mode != M_PLAY || !sp_in_room(g) || g[0].dr[0].bag || g[0].dr[0].map { return at; }
  k := q.k; buf: [48] u8;
  t := cp_value(g[0].fr[0].doc[0], CP_OUTFIT, buf[..]);
  line: [96] u8; n := ct_put(line[..], 0, "O  Change outfit (now: "); n = ct_put(line[..], n, t); n = ct_put(line[..], n, ")   M  Deep-garage map");
  if n > line.count { return at; }
  s := cast(string) line[0..<n]; y := q.h - 18 * k - 92 * k; w := ui_w(F_MONO, s, 9 * k) + 36 * k;
  ui_panel(g, u, q.w * 0.5 - w * 0.5, y - 20 * k, q.w * 0.5 + w * 0.5, y + 10 * k, INK(), 0.86);
  return ui_mid(out, at, s, q.w * 0.5, y, 9 * k, PAPER());
}

// Moments for stills and checks (g_stage): 25, a drive two fifths of the way (the world's first ride
// portal: none, no drive); 26, the empty section where the drill mech stands; 27, the field at dusk,
// facing the blocked hallway straight across from the entry; 28, inside Sniper's cabin at its door;
// 29, beside the rover train at the solar farm, its charger cable in view.
dv_stage :: (g: [] SpGame, n: int) {
  if n == 25 {
    g[0].have[H_DRILL] = true; g[0].phase = PH_DAY;
    c := g[0].c[..];
    for k: 0..<c[0].portal_n {
      p := c[0].portals[k];
      if !p.ok || !p.ride { continue; }
      g[0].dv[0].boarded = false;
      dv_start(g, sc_m(p.to_x), sc_m(p.to_z), p.yaw);
      on := dv_at(g, 0.4); dv_place(g, on.x, on.z);
      return;
    }
  }
  if n == 26 { ga_look_into(g, ga_in_bay(g, sc_mark(g[0].c[..], 81).x, sc_mark(g[0].c[..], 81).z)); }
  if n == 27 { g[0].px = 0; g[0].pz = g[0].at.wall_z + 40; g[0].yaw = PI; g[0].pitch = 0; }
  if n == 28 {   // inside Sniper's cabin by day, a few steps in from its door, looking at the front
    r := dv_room(g);
    if r.ok && r.door { g[0].phase = PH_DAY; g[0].mode = M_PLAY; g[0].px = r.door_x + 4.5; g[0].pz = r.door_z; g[0].yaw = PI * 0.5; g[0].pitch = 0; g_bot_home(g); }
  }
  if n == 29 {   // the solar farm by day, beside Sniper's rover train and the charger plugged into it
    tr := g_shipped_at(g, 123);
    g[0].phase = PH_DAY; g[0].mode = M_PLAY; g[0].px = tr.x - 7.0; g[0].pz = tr.z + 3.0;
    g[0].yaw = angle_atan2(tr.x - 2.0 - g[0].px, tr.z + 0.4 - g[0].pz); g[0].pitch = 0; g_bot_home(g);
  }
  if n == 50 || n == 51 {   // Sniper parked by the garage at dusk, and she walks at its third car's side (50) or at its back, its ramp (51)
    g[0].zone = Z_MINE; g[0].mode = M_PLAY; g[0].phase = PH_DUSK; dv_park(g, g[0].at.rover_x, g[0].at.rover_z, g[0].at.rover_yaw);
    y := g[0].at.rover_yaw; fx := sin(y); fz := cos(y); lx := -cos(y); lz := sin(y);
    m := (TRAIN_CAB + cast(f32) TRAIN_CARS * (TRAIN_CAR + TRAIN_GAP)) * 0.5 + 0.7 - TRAIN_CAB - TRAIN_GAP * 2 - TRAIN_CAR * 1.5;
    if n == 50 { g[0].px = g[0].at.rover_x + fx * m + lx * 4.5; g[0].pz = g[0].at.rover_z + fz * m + lz * 4.5; g[0].yaw = atan2(-lx, -lz); }
    else { g[0].px = g[0].at.rover_x - fx * 13; g[0].pz = g[0].at.rover_z - fz * 13; g[0].yaw = y; }
    g[0].pitch = 0; g_bot_home(g); g[0].fwd = true;
  }
  if g[0].phase != PH_DAY && g[0].mode != M_DRIVE && !g[0].dv[0].away { dv_park(g, g[0].at.rover_x, g[0].at.rover_z, g[0].at.rover_yaw); }   // past the drive: Sniper is parked by the garage
}

// While it drives: a strip along the bottom, who drives and where, and the key that gets you there now.
dv_overlay :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui) -> int {
  k := q.k; n := 0;
  ui_panel(g, u, -20, q.h - 120 * k, q.w + 20, q.h + 20, INK(), 0.82);
  chase := dv_chased(g) || sb_fighting(g);
  n = ui_mid(out, n, ifx chase then "A RAIDER MECH GIVES CHASE" else "DRIVE SNIPER TO THE GARAGE", q.w * 0.5, q.h - 78 * k, 14 * k, PAPER());
  line := ifx sb_fighting(g) then "1-4: Sniper's battle moves" else ifx chase then "Hold W: outrun it    E: battle it from Sniper" else "W S: drive    A D: steer    Space: handbrake    E: park and get out";
  n = ui_mid(out, n, line, q.w * 0.5, q.h - 44 * k, 10 * k, PAPER());
  if chase { n = sb_hud(g, out, u, q, n); }   // the health bars over Sniper and the raider mech, and the battle's panel
  n = hv_compass(g, out, n, q);   // and the compass, to the garage
  return n;
}

#test "a drive: no DRILL card, no drive; then she drives the rover from where she boarded it to the parking with W, A and D, the camera outside, and E parks it and lets her out beside it (#13505, playtest 2)" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}]; k: [1] FlowTest;
  g_stage(g[..], 0);
  bare := sc_bare_flow(k[0].o[4][..]);   // the shipped tables' areas, without their own rows
  t := sc_swap2(bare, "table portals id name:text from:text to:text yaw:int r:int\n", "table portals id name:text from:text to:text yaw:int r:int\n1|Enter the rover|kind 116|-50000 76000|0|400\n2|Drive to the garage|at -50000 76300|ride 0 1000|180|200\n", k[0].o[0][..]);
  t = sc_swap2(t, "table beats id area:int from:text to:text\n", "table beats id area:int from:text to:text\n1|7|day|dusk\n", k[0].o[2][..]);
  t = sc_swap2(t, "table starts id when:text at:text yaw:int\n", "table starts id when:text at:text yaw:int\n1|day|-80000 -10000|90\n", k[0].o[3][..]);
  #assert sc_load(g[0].c[..], t) && g_places(g[..]);
  g_reset(g[..]); g_begin(g[..]);
  #assert g[0].mode == M_PLAY && g[0].phase == PH_DAY && g[0].pz == -100;
  // a crate stands for the rover at the farm; E beside it takes you into the room
  #assert sl_place(g[..], 116, -79500, -10000, 90).ok;
  g[0].px = -795; g[0].pz = -103; #assert !sp_in_room(g[..]);
  #assert g_key(g[..], 'e', true) && g[0].px == -500 && g[0].pz == 760 && sp_in_room(g[..]) && g[0].dv[0].boarded;
  // at the desk: no DRILL card, no drive
  g[0].px = -500; g[0].pz = 763;
  #assert g_key(g[..], 'e', true) && g[0].mode == M_PLAY && g[0].msg == MSG_NO_DRILL && msg_text(g[..]).count > 10;
  g[0].have[H_DRILL] = true;
  #assert g_key(g[..], 'e', true) && g[0].mode == M_DRIVE && !sp_in_room(g[..]);
  start := dv_at(g[..], 0); end := dv_at(g[..], 1);
  #assert dist2(start.x, start.z, -795, -100) < 0.01 && dist2(end.x, end.z, g[0].at.rover_x, g[0].at.rover_z) < 0.01;
  #assert dist2(g[0].dv[0].sx, g[0].dv[0].sz, -795, -100) < 0.5;   // at the wheel of the rover she boarded
  cam := dv_camera(g[..]); #assert cam.eye.y > 4;   // outside, above the road
  // no keys, no drive: it stands on its springs
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert g[0].mode == M_DRIVE && dist2(g[0].dv[0].sx, g[0].dv[0].sz, -795, -100) < 0.5;
  // W drives it ahead
  _ := g_key(g[..], 'w', true); for i: 0..<100 { g_step(g[..], 0.02); } _ = g_key(g[..], 'w', false);
  #assert dv_speed(g[..]) > 5 && dist2(g[0].dv[0].sx, g[0].dv[0].sz, -795, -100) > 5;
  #assert dv_keys_to(g[..], g[0].dv[0].bx, g[0].dv[0].bz, 6, 120) && g[0].phase == PH_DUSK;   // into the garage yard: dusk
  px := g[0].dv[0].sx; pz := g[0].dv[0].sz;
  #assert g_key(g[..], 'e', true) && g[0].mode == M_PLAY && g[0].at.rover_x == px && g[0].at.rover_z == pz;   // parked where she stopped
  #assert dist2(g[0].px, g[0].pz, px, pz) < DV_HALF_W + DV_OUT + 0.1 && near_rover(g[..], T_USE_RANGE);
  // the stills: on the way, the drill mech's section, the field facing the hallway
  g_stage(g[..], 25); #assert g[0].mode == M_DRIVE && g[0].have[H_DRILL] && g[0].phase == PH_DAY && dv_s(g[..]) > 0.3;
  g_stage(g[..], 26); #assert g[0].mode == M_PLAY && ga_section_of(g[..], g[0].px, g[0].pz) == GA_EMPTY;
  g_stage(g[..], 27); #assert ga_section_of(g[..], 0, g[0].at.wall_z - 10) == GA_HALLWAY;
}
#test "parked where she left it, Sniper's collider is the rover train as it is drawn: walking into each car, the back ones too, stops her, Digger and the camera meet it, and its door still lets her in and out (#13552)" #steps 400000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); #assert spw_shipped(g[..]) == SPW_SHIPPED_N;
  g_begin(g[..]); g[0].have[H_DRILL] = true;
  tr := g_shipped_at(g[..], 123); g[0].px = tr.x + 2.2; g[0].pz = tr.z;
  #assert g_key(g[..], 'e', true);
  dk := g_shipped_at(g[..], 125); g[0].px = dk.x - 1.2; g[0].pz = dk.z;
  #assert g_key(g[..], 'e', true) && g[0].mode == M_DRIVE;
  #assert dv_keys_to(g[..], g[0].dv[0].bx, g[0].dv[0].bz, 6, 120);   // the whole train's footprint still drives to the parking
  #assert g_key(g[..], 'e', true) && g[0].mode == M_PLAY && g[0].ws[0].rover >= 0;
  row := sc_piece(g[0].c[..], SP_ROVER_KIND); #assert row >= 0;
  rx := g[0].at.rover_x; rz := g[0].at.rover_z; y := g[0].at.rover_yaw;
  foot := sl_foot(g[..], row, rx, rz, y); o := sl_seg(g[..], g[0].ws[0].rover);
  #assert sl_seg_seg(foot, o) < 0.001 && abs(o.r - foot.r) < 0.001 && abs(dist2(o.ax, o.az, o.bx, o.bz) - dist2(foot.ax, foot.az, foot.bx, foot.bz)) < 0.001;
  #assert dist2(o.ax, o.az, o.bx, o.bz) + o.r * 2 > TRAIN_CAB + cast(f32) TRAIN_CARS * (TRAIN_CAR + TRAIN_GAP);   // every car, end to end
  fx := sin(y); fz := cos(y); lx := -cos(y); lz := sin(y);   // ahead along the train, and to its left
  // each car's middle, as kit_train lays them out: the cab, then the box cars behind it
  zf := (TRAIN_CAB + cast(f32) TRAIN_CARS * (TRAIN_CAR + TRAIN_GAP)) * 0.5 + 0.7;
  for k: 0..<TRAIN_CARS + 1 {
    l := ifx k == 0 then TRAIN_CAB else TRAIN_CAR;
    m := zf - l * 0.5; zf = zf - l - TRAIN_GAP;
    cx := rx + fx * m; cz := rz + fz * m;
    for side: 0..<2 {
      s := ifx side == 0 then 1.0f32 else -1.0f32;
      g[0].px = cx + lx * s * 5; g[0].pz = cz + lz * s * 5; g[0].yaw = atan2(cx - g[0].px, cz - g[0].pz); g[0].pitch = 0;
      _ := g_key(g[..], 'w', true); for i: 0..<150 { g_step(g[..], 0.02); } _ = g_key(g[..], 'w', false);
      d := sl_seg_seg(SlSeg.{ax = g[0].px, az = g[0].pz, bx = g[0].px, bz = g[0].pz}, o);
      #assert d > o.r + T_RADIUS - 0.05 && d < o.r + T_RADIUS + 0.3;   // she walked up to its side and no further in
    }
    #assert dist2(sl_push(g[..], cx, cz, 0.45, true).x, sl_push(g[..], cx, cz, 0.45, true).z, cx, cz) > 0.5;   // Digger is held out too
    #assert sl_inside_at(g[..], cx, 1.5, cz, 0.3) && sl_inside_at(g[..], cx, 2.7, cz, 0.3) && !sl_inside_at(g[..], cx, 3.6, cz, 0.3);   // and the camera, to its roofs
  }
  // walking at its back, onto the last car's ramp, she stops at it
  bx := rx - fx * 12; bz := rz - fz * 12;
  g[0].px = bx; g[0].pz = bz; g[0].yaw = y; _ := g_key(g[..], 'w', true); for i: 0..<150 { g_step(g[..], 0.02); } _ = g_key(g[..], 'w', false);
  d := sl_seg_seg(SlSeg.{ax = g[0].px, az = g[0].pz, bx = g[0].px, bz = g[0].pz}, o);
  #assert d > o.r + T_RADIUS - 0.05 && dist2(g[0].px, g[0].pz, rx, rz) > 9;
  // the stills of it: walking at its third car's side, and at its ramp, she stops at it
  for n: [2] int.[50, 51] {
    g_stage(g[..], n); #assert g[0].fwd && g[0].ws[0].rover >= 0;
    for i: 0..<150 { g_step(g[..], 0.02); }
    q := sl_seg(g[..], g[0].ws[0].rover); e := sl_seg_seg(SlSeg.{ax = g[0].px, az = g[0].pz, bx = g[0].px, bz = g[0].pz}, q);
    #assert e > q.r + T_RADIUS - 0.05 && e < q.r + T_RADIUS + 0.3;
  }
  _ = g_key(g[..], 'w', false); g[0].fwd = false;
  // its door, the edit bay and the charger: beside its middle as before (parked as the stills park it)
  rx = g[0].at.rover_x; rz = g[0].at.rover_z; y = g[0].at.rover_yaw; lx = -cos(y); lz = sin(y); o = sl_seg(g[..], g[0].ws[0].rover);
  g[0].px = rx + lx * 3; g[0].pz = rz + lz * 3; g_bot_home(g[..]);
  #assert near_rover(g[..], T_USE_RANGE) && g_key(g[..], 'e', true) && sp_in_room(g[..]);
  r := dv_room(g[..]); g[0].px = r.door_x; g[0].pz = r.door_z;
  #assert g_key(g[..], 'e', true) && !sp_in_room(g[..]) && near_rover(g[..], T_USE_RANGE);
  #assert sl_seg_seg(SlSeg.{ax = g[0].px, az = g[0].pz, bx = g[0].px, bz = g[0].pz}, o) > o.r + T_RADIUS - 0.01;   // she steps out clear of it
}
