// The solar farm's field (#13505; layout per the level spec, #13552): four long rows of solar banks
// stacked north to south in the farm's west and north, with wide aisles between them to run, jump and
// board through. A row is FF_PER lines of banks FF_LINE_DZ m apart, each FF_RUN banks long from FF_XW
// eastward. They are shipped code, not pieces of the world's layer: a fresh world has them, and an edit
// never moves them. One bank's mesh (metaverse-engine/kit/props.coax kit_solar_bank) is written once
// into the piece store after the kinds' meshes, and the field is one draw of FF_BANKS instances whose
// rows sit in the place store after the layer's rows and the player's (layer-draw.coax).
//
// Nothing in the field is tall: the low sun (FF_SUN), its long shadows over a wider shadow map
// (FF_SHADOW_HALF) and the dust haze (ff_style) give it its scale. A walker is held out of a line as
// from a wall (ff_push), without a collider each, and a bank's top is a floor she lands on (ff_floors).
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax

FF_PANELS :: 10;                 // panels in one bank: 21 m
FF_PITCH :: 21.4f32;             // m from one bank's middle to the next along a line
FF_RUN :: 7;                     // banks in a line: a row about 150 m long
FF_ROWS :: 4;                    // rows, north to south
FF_PER :: 3;                     // lines of banks in a row
FF_LINE_DZ :: 3.0f32;            // m between a row's lines: a hop from one bank to the next
FF_ROW_DZ :: 20.0f32;            // m from one row's middle to the next: an aisle about 13 m wide
FF_XW :: -940.0f32;              // m: the rows' west end
FF_ZN :: -186.0f32;              // m: the north row's middle line
FF_HZ :: 0.6f32;                 // m: a line's half depth on the ground
FF_TOP :: 1.07f32;               // m: a bank's glass at its middle; it rises north at SOLAR_TILT, where she lands on it
FF_BANKS :: FF_RUN * FF_ROWS * FF_PER;
FF_SHOW_X :: -560.0f32;          // m: the field is drawn west of this, where it can be seen
FF_SHADOW_HALF :: 30.0f32;       // m: the shadow map's half width at the farm (the anime pass's is 26)
// the sun at the farm by day: low in the north-east, about 19 degrees up, so every bank's shadow runs
// near three times its height across the aisle
FF_SUN :: () -> Point { return unit_or(v3(0.55, 0.34, 0.8), v3(0, 1, 0)); }

// The far x of a line's east end.
ff_x1 :: () -> f32 { return FF_XW + cast(f32) FF_RUN * FF_PITCH; }
// Line k's z (0 the north row's first line): its row's middle, less or plus a line.
ff_line_z :: (k: int) -> f32 { return FF_ZN + cast(f32) (k / FF_PER) * FF_ROW_DZ + cast(f32) (k % FF_PER - FF_PER / 2) * FF_LINE_DZ; }
// Where bank i stands: line by line from the north, west bank first.
ff_bank_at :: (i: int) -> Point { return v3(FF_XW + (cast(f32) (i % FF_RUN) + 0.5) * FF_PITCH, 0, ff_line_z(i / FF_RUN)); }
// The field is drawn: on foot, in a banner or on the drive, out at the farm (not in Sniper's room).
ff_shown :: (g: [] SpGame) -> bool {
  m := g[0].mode;
  if m != M_PLAY && m != M_BANNER && m != M_DRIVE { return false; }
  return g[0].zone == Z_MINE && g[0].px < FF_SHOW_X && !sp_in_room(g);
}
// The farm by day: the low sun, its long shadows and the dust haze.
ff_day :: (g: [] SpGame) -> bool { return ff_shown(g) && g_phase(g) == PH_DAY; }
// The line nearest (x, z) along z, or -1 off the rows' length.
ff_line :: (x: f32, z: f32, r: f32) -> int {
  if x < FF_XW - r || x > ff_x1() + r { return -1; }
  row := clamp_i(cast(int) floor((z - FF_ZN) / FF_ROW_DZ + 0.5), 0, FF_ROWS - 1);
  return row * FF_PER + clamp_i(cast(int) floor((z - FF_ZN - cast(f32) row * FF_ROW_DZ) / FF_LINE_DZ + 0.5) + FF_PER / 2, 0, FF_PER - 1);
}

// A walker of radius r at (x, z) held out of the field's lines: along z out of a line's band, or past
// its end along x when that is the shorter way. (x, z) as it was when it is in none.
ff_push :: (x: f32, z: f32, r: f32) -> Point {
  k := ff_line(x, z, r);
  if k < 0 { return v3(x, 0, z); }
  zc := ff_line_z(k); dz := z - zc;
  pz := FF_HZ + r - abs(dz);
  if pz <= 0 { return v3(x, 0, z); }
  inner := x - (FF_XW - r); outer := ff_x1() + r - x;
  if lo(inner, outer) < pz { return v3(ifx inner < outer then FF_XW - r else ff_x1() + r, 0, z); }
  return v3(x, 0, ifx dz < 0 then zc - FF_HZ - r else zc + FF_HZ + r);
}
// The aisles as a graph, for a walker that goes round the rows (Digger, director.coax d_route): a node at
// each end of each aisle, FF_END m past the rows' ends, the aisle north of the north row and south of the
// south row too; links along each aisle and round each end from one aisle to the next. Node 2a is aisle
// a's west end, 2a + 1 its east end, the aisles from the north (metaverse-engine/world/path-graph.coax).
FF_AISLES :: FF_ROWS + 1;
FF_NODES :: FF_AISLES * 2;
FF_LINKS :: FF_AISLES + FF_ROWS * 2;
FF_END :: 4.0f32;                // m past a row's end where its aisles' corner stands
ff_aisle_z :: (a: int) -> f32 { return FF_ZN + (cast(f32) a - 0.5) * FF_ROW_DZ; }
ff_aisles :: (nodes: [] f32, links: [] int) {
  for a: 0..<FF_AISLES {
    nodes[a * 4] = FF_XW - FF_END; nodes[a * 4 + 1] = ff_aisle_z(a);
    nodes[a * 4 + 2] = ff_x1() + FF_END; nodes[a * 4 + 3] = ff_aisle_z(a);
    links[a * 2] = a * 2; links[a * 2 + 1] = a * 2 + 1;   // along the aisle
  }
  for r: 0..<FF_ROWS {
    k := FF_AISLES * 2 + r * 4;
    links[k] = r * 2; links[k + 1] = r * 2 + 2;           // round the row's west end
    links[k + 2] = r * 2 + 1; links[k + 3] = r * 2 + 3;   // and its east end
  }
}
// (x, z) out of a row's whole band (its lines and the gaps between them), to its nearer side or past
// its nearer end: where a walker that can't climb onto the glass waits for her when she is on it.
ff_off_rows :: (x: f32, z: f32, r: f32) -> Point {
  if x < FF_XW - r || x > ff_x1() + r { return v3(x, 0, z); }
  row := clamp_i(cast(int) floor((z - FF_ZN) / FF_ROW_DZ + 0.5), 0, FF_ROWS - 1);
  zc := FF_ZN + cast(f32) row * FF_ROW_DZ; half := cast(f32) (FF_PER / 2) * FF_LINE_DZ + FF_HZ + r;
  dz := z - zc; pz := half - abs(dz);
  if pz <= 0 { return v3(x, 0, z); }
  inner := x - (FF_XW - r); outer := ff_x1() + r - x;
  if lo(inner, outer) < pz { return v3(ifx inner < outer then FF_XW - r else ff_x1() + r, 0, z); }
  return v3(x, 0, ifx dz < 0 then zc - half else zc + half);
}
// The low edge of a bank's glass: below it she is held out of the line, above it she stands on it.
ff_low :: () -> f32 { return FF_TOP - FF_HZ * sin(SOLAR_TILT) / cos(SOLAR_TILT); }
// The top of the line under (x, z) as a floor (metaverse-engine/physics/stand.coax), after k in out: how
// many floors out holds now.
ff_floors :: (x: f32, z: f32, out: [] f32, k: int) -> int {
  l := ff_line(x, z, 0);
  if l < 0 || abs(z - ff_line_z(l)) > FF_HZ + 1 || (k + 1) * STAND_FLOATS > out.count { return k; }
  t := FF_HZ * sin(SOLAR_TILT) / cos(SOLAR_TILT);   // the glass rises toward the line's north side, as kit_solar_bank tilts it
  stand_put_quad(out, k, FF_XW, ff_line_z(l) - FF_HZ, ff_x1() - FF_XW, 0, 0, FF_HZ * 2, FF_TOP + t, 0, -2 * t);
  return k + 1;
}

// The bank's mesh, after the kinds' meshes in the piece store (layer-draw.coax sd_meshes).
ff_mesh :: (pieces: [] u32, pen: [] Pen) {
  kit_solar_bank(pieces, pen, frame_at(v3(0, 0, 0), 0), 1, PIECE_OBJ, sp_tint(1845312), sp_tint(12107464), INK(), FF_PANELS);
}
// The field's rows from row `at` of the place store: how many it wrote (0 when they don't all fit).
ff_rows :: (places: [] u32, at: int) -> int {
  if (at + FF_BANKS) * SD_ROW > places.count { return 0; }
  for i: 0..<FF_BANKS {
    c := ff_bank_at(i); o := (at + i) * SD_ROW;
    places[o] = f32_bits(c.x); places[o + 1] = 0; places[o + 2] = f32_bits(c.z); places[o + 3] = 0;
    places[o + 4] = f32_bits(1); places[o + 5] = 0; places[o + 6] = 0; places[o + 7] = 0;
  }
  return FF_BANKS;
}
// The field's one draw, when it is shown: how many draw records there are now.
ff_draws :: (g: [] SpGame, d: [] SpLayerDraw, draws: [] u32, at: int) -> int {
  if d[0].ff_n == 0 || d[0].ff_count == 0 || !ff_shown(g) || (at + 1) * 4 > draws.count { return at; }
  draws[at * 4] = cast(u32) d[0].ff_first; draws[at * 4 + 1] = cast(u32) d[0].ff_count;
  draws[at * 4 + 2] = 0x80000000 | cast(u32) (SD_BASE + d[0].ff_row0); draws[at * 4 + 3] = cast(u32) d[0].ff_n;
  return at + 1;
}
// The farm's day air over the style block (u from U_STYLE): dust haze from 50 m that the far rows
// fade into, a warm band low toward the sun, and a pale horizon of the same dust.
ff_style :: (st: [] f32) {
  if st.count < STYLE_FLOATS { return; }
  st[FF_HAZE] = 50; st[FF_HAZE + 1] = 0.006; st[FF_HAZE + 2] = 0.8;
  st[FF_HAZE_COLOUR] = 0.93; st[FF_HAZE_COLOUR + 1] = 0.80; st[FF_HAZE_COLOUR + 2] = 0.64;
  st[FF_HAZE_KEY] = 1.0; st[FF_HAZE_KEY + 1] = 0.78; st[FF_HAZE_KEY + 2] = 0.52; st[FF_HAZE_KEY + 3] = 0.55;
  st[FF_HORIZON] = 0.94; st[FF_HORIZON + 1] = 0.82; st[FF_HORIZON + 2] = 0.66;
}
// The style block's rows ff_style writes: metaverse/style-preset.coax's SU_HAZE, SU_HAZE_COLOUR,
// SU_HAZE_KEY and SU_HORIZON (that file is the face's, animelab-style.coax; the game loads only
// animelab.coax's STYLE_FLOATS and SU_KEY_DIR).
FF_HAZE :: 36; FF_HAZE_COLOUR :: 40; FF_HAZE_KEY :: 44; FF_HORIZON :: 52;

#test "the farm's field: four long rows in the farm's north-west, wide aisles between them, a walker held out of every line and landing on its top" {
  // every bank on its line, inside the farm, west of where Sniper stands; four rows of three lines
  for i: 0..<FF_BANKS {
    c := ff_bank_at(i);
    #assert c.x > FF_XW && c.x < ff_x1() && ff_line(c.x, c.z, 0) == i / FF_RUN && c.z >= FF_ZN - FF_LINE_DZ && c.z <= FF_ZN + 3 * FF_ROW_DZ + FF_LINE_DZ;
  }
  #assert FF_ROWS == 4 && ff_x1() - FF_XW > 140 && FF_ROW_DZ - (FF_PER - 1) * FF_LINE_DZ - FF_HZ * 2 > 12;   // long rows, aisles over 12 m
  // the start, the parts and Sniper are clear of the rows (content/splice.content)
  #assert ff_push(-790, -100, 0.45).z == -100 && ff_line(-772, -128, 0.45) < 0 && ff_push(-812, -92, 0.45).z == -92;
  // on a line: pushed off it along z; at its west end: back out along x; in an aisle: free
  zc := ff_line_z(4);
  q := ff_push(-850, zc + 0.1, 0.3);
  #assert q.x == -850 && abs(q.z - (zc + FF_HZ + 0.3)) < 0.001;
  q = ff_push(-850, zc - 0.1, 0.3); #assert abs(q.z - (zc - FF_HZ - 0.3)) < 0.001;
  q = ff_push(FF_XW + 0.1, zc, 0.3); #assert abs(q.x - (FF_XW - 0.3)) < 0.001 && q.z == zc;
  q = ff_push(-850, FF_ZN + FF_ROW_DZ * 0.5, 0.3); #assert q.z == FF_ZN + FF_ROW_DZ * 0.5;
  // a bank's top is a floor; the aisle has none
  fl: [STAND_FLOATS * 2] f32;
  #assert ff_floors(-850, zc, fl[..], 0) == 1 && ff_floors(-850, FF_ZN + FF_ROW_DZ * 0.5, fl[..], 0) == 0 && ff_floors(-700, zc, fl[..], 0) == 0;
  // the bank is low, light and on the ground
  buf: [24000 * VERTEX_WORDS] u32; pen := [1] Pen.[Pen.{}];
  ff_mesh(buf[..], pen[..]);
  r := kit_reach(buf[..], pen[0].n);
  #assert !pen[0].over && r.top < 1.5 && r.low > -0.06 && pen[0].n / 3 < 2000;
  #assert FF_SUN().y < 0.36 && FF_SUN().y > 0.15;   // a low sun
}
