// The solar farm's field (#13505, playtest 2: "expansive and impactful, like a wide shot from a Dune
// movie"). Past the plain round the spawn, long regular lines of solar banks run east and west to
// the edge of the ground: FF_LINES lines FF_DZ m apart, each FF_RUN banks long, on both sides. They
// are shipped code, not pieces of the world's layer: a fresh world has them, and an edit never moves
// them. One bank's mesh (metaverse-engine/kit/props.coax kit_solar_bank) is written once into the
// piece store after the kinds' meshes, and the field is one draw of FF_BANKS instances whose rows sit
// in the place store after the layer's rows and the player's (layer-draw.coax).
//
// Nothing in the field is tall: the scale comes from the rows' length, the low sun (FF_SUN) and its
// long shadows over a wider shadow map (FF_SHADOW_HALF), and the dust haze the rows fade into
// (ff_style). A walker is held out of a line as from a wall (ff_push), without a collider each.
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax

FF_PANELS :: 10;                 // panels in one bank: 21 m
FF_PITCH :: 21.4f32;             // m from one bank's middle to the next along a line
FF_RUN :: 10;                    // banks in a line on one side
FF_LINES :: 27;                  // lines on each side
FF_X0 :: 64.0f32;                // m from x = 0 to a line's inner end: the plain round the spawn and the day patrols is clear
FF_Z0 :: 296.0f32;               // m: the southmost line
FF_DZ :: 6.0f32;                 // m between lines: the low sun's shadows nearly fill the aisle
FF_HZ :: 0.6f32;                 // m: a line's half depth on the ground
FF_BANKS :: 2 * FF_RUN * FF_LINES;
FF_SHOW_Z :: 150.0f32;           // m: the field is drawn north of this, where it can be seen
FF_SHADOW_HALF :: 30.0f32;       // m: the shadow map's half width at the farm (the anime pass's is 26)
// the sun at the farm by day: low in the north-east, about 19 degrees up, so every bank's shadow runs
// near three times its height across the aisle
FF_SUN :: () -> Point { return unit_or(v3(0.55, 0.34, 0.8), v3(0, 1, 0)); }

// The far x of a line's outer end.
ff_x1 :: () -> f32 { return FF_X0 + cast(f32) FF_RUN * FF_PITCH; }
// Where bank i stands: east side first, line by line from the south, inner bank first.
ff_bank_at :: (i: int) -> Point {
  side := ifx i < FF_RUN * FF_LINES then 1.0f32 else -1.0f32;
  r := i % (FF_RUN * FF_LINES); line := r / FF_RUN; b := r % FF_RUN;
  return v3(side * (FF_X0 + (cast(f32) b + 0.5) * FF_PITCH), 0, FF_Z0 + cast(f32) line * FF_DZ);
}
// The field is drawn: on foot, in a banner or on the drive, out at the farm (not in Sniper's room).
ff_shown :: (g: [] SpGame) -> bool {
  m := g[0].mode;
  if m != M_PLAY && m != M_BANNER && m != M_DRIVE { return false; }
  return g[0].zone == Z_MINE && g[0].pz > FF_SHOW_Z && !sp_in_room(g);
}
// The farm by day: the low sun, its long shadows and the dust haze.
ff_day :: (g: [] SpGame) -> bool { return ff_shown(g) && g_phase(g) == PH_DAY; }

// A walker of radius r at (x, z) held out of the field's lines: along z out of a line's band, or past
// its end along x when that is the shorter way. (x, z) as it was when it is in none.
ff_push :: (x: f32, z: f32, r: f32) -> Point {
  ax := abs(x); x1 := ff_x1();
  if ax < FF_X0 - r || ax > x1 + r { return v3(x, 0, z); }
  k := cast(int) floor((z - FF_Z0) / FF_DZ + 0.5);
  if k < 0 || k >= FF_LINES { return v3(x, 0, z); }
  zc := FF_Z0 + cast(f32) k * FF_DZ; dz := z - zc;
  pz := FF_HZ + r - abs(dz);
  if pz <= 0 { return v3(x, 0, z); }
  inner := ax - (FF_X0 - r); outer := x1 + r - ax;
  if lo(inner, outer) < pz {
    s := ifx x < 0 then -1.0f32 else 1.0f32;
    return v3(ifx inner < outer then s * (FF_X0 - r) else s * (x1 + r), 0, z);
  }
  return v3(x, 0, ifx dz < 0 then zc - FF_HZ - r else zc + FF_HZ + r);
}

// The bank's mesh, after the kinds' meshes in the piece store (layer-draw.coax sd_meshes).
ff_mesh :: (pieces: [] u32, pen: [] Pen) {
  kit_solar_bank(pieces, pen, frame_at(v3(0, 0, 0), 0), 1, PIECE_OBJ, sp_tint(1845312), sp_tint(12107464), INK(), FF_PANELS);
}
// The field's rows from row `at` of the place store: how many it wrote (0 when they don't all fit).
ff_rows :: (places: [] u32, at: int) -> int {
  if (at + FF_BANKS) * SD_ROW > places.count { return 0; }
  for i: 0..<FF_BANKS {
    c := ff_bank_at(i); o := (at + i) * SD_ROW;
    places[o] = f32_bits(c.x); places[o + 1] = 0; places[o + 2] = f32_bits(c.z); places[o + 3] = 0;
    places[o + 4] = f32_bits(1); places[o + 5] = 0; places[o + 6] = 0; places[o + 7] = 0;
  }
  return FF_BANKS;
}
// The field's one draw, when it is shown: how many draw records there are now.
ff_draws :: (g: [] SpGame, d: [] SpLayerDraw, draws: [] u32, at: int) -> int {
  if d[0].ff_n == 0 || d[0].ff_count == 0 || !ff_shown(g) || (at + 1) * 4 > draws.count { return at; }
  draws[at * 4] = cast(u32) d[0].ff_first; draws[at * 4 + 1] = cast(u32) d[0].ff_count;
  draws[at * 4 + 2] = 0x80000000 | cast(u32) (SD_BASE + d[0].ff_row0); draws[at * 4 + 3] = cast(u32) d[0].ff_n;
  return at + 1;
}
// The farm's day air over the style block (u from U_STYLE): dust haze from 50 m that the far rows
// fade into, a warm band low toward the sun, and a pale horizon of the same dust.
ff_style :: (st: [] f32) {
  if st.count < STYLE_FLOATS { return; }
  st[FF_HAZE] = 50; st[FF_HAZE + 1] = 0.006; st[FF_HAZE + 2] = 0.8;
  st[FF_HAZE_COLOUR] = 0.93; st[FF_HAZE_COLOUR + 1] = 0.80; st[FF_HAZE_COLOUR + 2] = 0.64;
  st[FF_HAZE_KEY] = 1.0; st[FF_HAZE_KEY + 1] = 0.78; st[FF_HAZE_KEY + 2] = 0.52; st[FF_HAZE_KEY + 3] = 0.55;
  st[FF_HORIZON] = 0.94; st[FF_HORIZON + 1] = 0.82; st[FF_HORIZON + 2] = 0.66;
}
// The style block's rows ff_style writes: metaverse/style-preset.coax's SU_HAZE, SU_HAZE_COLOUR,
// SU_HAZE_KEY and SU_HORIZON (that file is the face's, animelab-style.coax; the game loads only
// animelab.coax's STYLE_FLOATS and SU_KEY_DIR).
FF_HAZE :: 36; FF_HAZE_COLOUR :: 40; FF_HAZE_KEY :: 44; FF_HORIZON :: 52;

#test "the farm's field: long regular lines east and west past a clear plain, nothing tall, and a walker held out of every line" {
  // every bank on the ground, on its line, past the plain, inside the ground's edge
  for i: 0..<FF_BANKS {
    c := ff_bank_at(i);
    #assert abs(c.x) > FF_X0 && abs(c.x) < 280 && c.z >= FF_Z0 && c.z <= FF_Z0 + cast(f32) (FF_LINES - 1) * FF_DZ;
  }
  #assert ff_bank_at(0).x > 0 && ff_bank_at(FF_BANKS - 1).x < 0 && ff_x1() < 280;
  // the plain round the spawn and the road south are clear
  #assert ff_push(10, 348, 0.3).x == 10 && ff_push(10, 348, 0.3).z == 348 && ff_push(3, 200, 0.3).z == 200;
  // on a line: pushed off it along z; at its inner end: back out along x
  zc := FF_Z0 + 5 * FF_DZ;
  q := ff_push(120, zc + 0.1, 0.3);
  #assert q.x == 120 && abs(q.z - (zc + FF_HZ + 0.3)) < 0.001;
  q = ff_push(-120, zc - 0.1, 0.3);
  #assert abs(q.z - (zc - FF_HZ - 0.3)) < 0.001;
  q = ff_push(FF_X0 - 0.1, zc, 0.3);
  #assert abs(q.x - (FF_X0 - 0.3)) < 0.001 && q.z == zc;
  // in the aisle between two lines: free
  q = ff_push(150, zc + FF_DZ * 0.5, 0.3); #assert q.z == zc + FF_DZ * 0.5;
  // the bank is low, light and on the ground
  buf: [24000 * VERTEX_WORDS] u32; pen := [1] Pen.[Pen.{}];
  ff_mesh(buf[..], pen[..]);
  r := kit_reach(buf[..], pen[0].n);
  #assert !pen[0].over && r.top < 1.5 && r.low > -0.06 && pen[0].n / 3 < 2000;
  #assert FF_SUN().y < 0.36 && FF_SUN().y > 0.15;   // a low sun
}
