// The front door's checks (front.coax, #13482): the title's menu by keys and by the pointer, NEW RUN
// to the creation screen and on to play, Escape back, the credits, the kept run read and written
// whole, CONTINUE, the autosave, and the host's storage answers.
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax

fc_fresh :: (g: [] SpGame) { g[0] = SpGame.{}; g_reset(g); fr_start(g); g[0].fr[0].kept_n = 0; fr_rows_build(g); }
// Two characters are the same when their records are.
fc_same :: (a: CrewDoc, b: CrewDoc) -> bool {
  x: [CD_TEXT] u8; y: [CD_TEXT] u8; n := cd_write(a, x[..]); m := cd_write(b, y[..]);
  return n > 0 && n == m && cast(string) x[0..<n] == cast(string) y[0..<m];
}
// A storage answer as the host writes it: the 16-byte header, then the bytes.
fc_answer :: (out: [] u8, status: int, text: string) -> string {
  for i: 0..<16 { out[i] = 0; }
  out[4] = cast(u8) status; out[8] = cast(u8) (text.count & 255); out[9] = cast(u8) (text.count >> 8);
  for i: 0..<text.count { out[16 + i] = text[i]; }
  return cast(string) out[0..<16 + text.count];
}

#test "the title: NEW RUN by Enter, the creation screen, Escape back, then USE THIS CHARACTER plays" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]);
  m := g[0].fr[0].menu[..];
  // no run kept: CONTINUE is not shown, and the focus starts on NEW RUN
  #assert g[0].mode == M_TITLE && scr_focused(m) == FR_NEW && !m[0].shown[0];
  #assert !g_key(g[..], -1, true) && g[0].mode == M_TITLE;   // Escape on the title does nothing
  #assert g_key(g[..], -2, true) && g[0].mode == M_CREW && scr_focused(g[0].fr[0].rows[..]) == FR_USE;
  #assert g_key(g[..], -1, true) && g[0].mode == M_TITLE;   // Escape: back to the title
  #assert g_key(g[..], -2, true) && g[0].mode == M_CREW;
  // up to the first row (Body) and change it: the character changes, and so does its record
  for i: 0..<FR_FIELDS.count { _ := g_key(g[..], -6, true); }
  #assert scr_focused(g[0].fr[0].rows[..]) == CP_BODY;
  before := g[0].fr[0].doc_gen; was := g[0].fr[0].doc[0].body.v[CB_HEIGHT];
  #assert g_key(g[..], 'd', true) && g[0].fr[0].doc_gen == before + 1;
  _ = g_key(g[..], -7, true); _ = g_key(g[..], -7, true);   // down to Height
  #assert scr_focused(g[0].fr[0].rows[..]) == CP_HEIGHT;
  h := g[0].fr[0].doc[0].body.v[CB_HEIGHT];
  #assert g_key(g[..], -5, true) && g[0].fr[0].doc[0].body.v[CB_HEIGHT] == h + CP_HEIGHT_STEP;
  // down to USE THIS CHARACTER: play starts in the village at dawn, the character is kept and the old run let go
  for i: 0..<4 { _ = g_key(g[..], -7, true); }
  #assert scr_focused(g[0].fr[0].rows[..]) == FR_USE;
  #assert g_key(g[..], -2, true) && g[0].mode == M_PLAY && g[0].zone == Z_VILLAGE && g[0].phase == PH_DAWN;
  #assert g[0].fr[0].crew_put == 1 && g[0].fr[0].crew_n > 0 && g[0].fr[0].run_put == 1 && g[0].fr[0].run_n == 0;
  r := [1] CdRead.[cd_read(cast(string) g[0].fr[0].crew_text[0..<g[0].fr[0].crew_n])];
  #assert r[0].ok && r[0].doc.body.v[CB_HEIGHT] == h + CP_HEIGHT_STEP;
  // the walking keys walk now, not move a menu
  #assert g_key(g[..], 'w', true) && g[0].fwd;
}

#test "the credits: the table's lines, and Escape or BACK returns" {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]);
  #assert g[0].c[0].credits >= 3 && sc_credit(g[0].c[..], 0).count > 0;
  _ := g_key(g[..], -7, true);
  #assert scr_focused(g[0].fr[0].menu[..]) == FR_CREDITS;
  #assert g_key(g[..], -2, true) && g[0].mode == M_CREDITS;
  #assert g_key(g[..], -1, true) && g[0].mode == M_TITLE;
  _ = g_key(g[..], -2, true);
  #assert g[0].mode == M_CREDITS && g_key(g[..], -2, true) && g[0].mode == M_TITLE;   // BACK, the one row
}

#test "the pointer: hovering a row focuses it, a press picks it, and a press on a value row's arrow steps it" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]);
  g[0].fr[0].w = 1280; g[0].fr[0].h = 720;
  f := fr_frame(g[..]); m := g[0].fr[0].menu[..];
  b := scr_row_box(f, m, 2);   // CREDITS, the third row of the table (CONTINUE's place is kept, hidden)
  #assert g_pointer(g[..], (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5, 1) && scr_focused(m) == FR_CREDITS;
  n := scr_row_box(f, m, 1);
  #assert g_pointer(g[..], (n.x0 + n.x1) * 0.5, (n.y0 + n.y1) * 0.5, 0) && g[0].mode == M_CREW;
  f = fr_frame(g[..]); rows := g[0].fr[0].rows[..];
  l := scr_arrow_box(f, rows, 1, false);   // Outfit's left arrow
  was := g[0].fr[0].doc[0];
  #assert g_pointer(g[..], (l.x0 + l.x1) * 0.5, (l.y0 + l.y1) * 0.5, 0) && g[0].mode == M_CREW;
  #assert fc_same(g[0].fr[0].doc[0], cp_step(was, CP_OUTFIT, -1));
  // a press away from every row does nothing
  #assert !g_pointer(g[..], 1200, 40, 0) && g[0].mode == M_CREW;
}

#test "the kept run is read whole or not at all, and says how far it got" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]);
  g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true; g_enter_mine(g[..]);
  g[0].have[H_ARM] = true; g[0].taken[H_ARM] = true; g[0].scrap = 2; g_keep(g[..]);
  g[0].rubble_gone = true;
  t: [FR_RUN_TEXT] u8; n := fr_run_write(g[..], t[..]);
  #assert n > 0;
  r := fr_run_read(cast(string) t[0..<n]);
  #assert r.ok && r.save.have[H_ARM] && r.save.have[H_BATTERY] && r.save.scrap == 2 && r.open[0] && !r.open[1];
  #assert r.percent == 5 * 100 / 12;   // battery, the mine, the battery in hand, the arm, the rubble
  // every shorter text, and one changed byte in each field, is refused
  for k: 0..<n { #assert !fr_run_read(cast(string) t[0..<k]).ok; }
  bad: [FR_RUN_TEXT] u8; for i: 0..<n { bad[i] = t[i]; }
  bad[n - 2] = '7';
  #assert !fr_run_read(cast(string) bad[0..<n]).ok;
  #assert !fr_run_read("splice.run.v2\nhave 0000000\n").ok;
}

#test "CONTINUE: shown with a run kept, focused first, and back at the mine's checkpoint with its inventory" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]);
  g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true; g_enter_mine(g[..]);
  g[0].have[H_ARM] = true; g[0].taken[H_ARM] = true; g_keep(g[..]); g[0].rubble_gone = true;
  t: [FR_RUN_TEXT] u8; n := fr_run_write(g[..], t[..]);
  // a new page: the host answers the run's read (slot 1)
  h := [1] SpGame.[SpGame.{}]; g_reset(h[..]); fr_start(h[..]);
  a: [256] u8;
  fr_stored(h[..], 1, fc_answer(a[..], 0, cast(string) t[0..<n]));
  #assert h[0].fr[0].run[0].ok && h[0].fr[0].kept_n == n;
  fr_rows_build(h[..]);
  #assert h[0].fr[0].menu[0].shown[0] && scr_focused(h[0].fr[0].menu[..]) == FR_CONTINUE;
  #assert g_key(h[..], -2, true) && h[0].mode == M_PLAY && h[0].zone == Z_MINE && h[0].phase == PH_DUSK;
  #assert h[0].have[H_ARM] && h[0].rubble_gone && !h[0].have[H_DRILL] && h[0].pz == h[0].at.start_z;
  // a missing record: no run, and CONTINUE stays hidden
  k := [1] SpGame.[SpGame.{}]; g_reset(k[..]); fr_start(k[..]);
  fr_stored(k[..], 1, fc_answer(a[..], 1, ""));
  #assert !k[0].fr[0].run[0].ok && k[0].fr[0].kept_n == 0;
  fr_rows_build(k[..]);
  #assert !k[0].fr[0].menu[0].shown[0] && scr_focused(k[0].fr[0].menu[..]) == FR_NEW;
}

#test "the host is asked for the character and the run, and the run is kept each second it changed in the mine" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}]; g_reset(g[..]); fr_start(g[..]);
  #assert fr_store_wants(g[..]) == FR_ASK_CREW;
  fr_store_asked(g[..], FR_ASK_CREW, true);
  #assert fr_store_wants(g[..]) == FR_ASK_RUN;
  fr_store_asked(g[..], FR_ASK_RUN, true);
  #assert fr_store_wants(g[..]) == 0;
  // the character the crew page kept is the one you play as
  d := cd_first(); d = cp_step(d, CP_OUTFIT, 1);
  ct: [CD_TEXT] u8; cn := cd_write(d, ct[..]);
  a: [CD_TEXT + 16] u8;
  fr_stored(g[..], 0, fc_answer(a[..], 0, cast(string) ct[0..<cn]));
  #assert fc_same(g[0].fr[0].doc[0], d);
  fr_stored(g[..], 1, fc_answer(a[..], 1, ""));
  // in the mine, a second after the checkpoint changed, the run is kept; again only when it changes
  g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true; g_enter_mine(g[..]);
  for i: 0..<60 { fr_autosave(g[..], 0.02); }
  #assert fr_store_wants(g[..]) == FR_KEEP_RUN;
  fr_store_asked(g[..], FR_KEEP_RUN, true);
  fr_stored(g[..], 1, fc_answer(a[..], 0, ""));
  #assert g[0].fr[0].run[0].ok && g[0].fr[0].kept_n > 0 && fr_store_wants(g[..]) == 0;
  for i: 0..<60 { fr_autosave(g[..], 0.02); }
  #assert fr_store_wants(g[..]) == 0;
  // SCENE RESTORED lets the run go
  g[0].mode = M_RESTORED; fr_autosave(g[..], 0.02);
  #assert fr_store_wants(g[..]) == FR_KEEP_RUN && g[0].fr[0].run_n == 0;
}

#test "each front screen draws inside the panel budget, and the title's rows follow the menu table" #steps 400000000 {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]);
  out: [200000] f32; u: [UNIFORM_FLOATS] f32;
  modes := [3] int.[M_TITLE, M_CREW, M_CREDITS];
  for m: modes { g[0].mode = m; n := fr_overlay(g[..], out[..], u[..], 1280, 720); #assert n > 0 && g[0].panels <= PANELS; g[0].panels = 0; }
  // the menu table reordered (credits before new run): the rows follow
  g[0].c[0].menu[1] = FR_CREDITS; g[0].c[0].menu[2] = FR_NEW;
  g[0].fr[0].touched = false; g[0].mode = M_TITLE; fr_rows_build(g[..]);
  #assert g[0].fr[0].menu[0].id[1] == FR_CREDITS && scr_focused(g[0].fr[0].menu[..]) == FR_CREDITS;
}

fc_cell :: (table: string, row: int, col: string, value: string) -> WorldEdit {
  e := WorldEdit.{ok = true, op = WE_CELL, id = row};
  e.table_n = ct_copy(e.table[..], table); e.name_n = ct_copy(e.name[..], col); e.text_n = ct_copy(e.text[..], value);
  return e;
}
#test "the title's menu is a world cell: a label edited is the label shown, and a key the game has no screen for is refused" #steps 400000000 #traversal 400000000 {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]); ct := [1] SpwTables.[SpwTables.{}];
  #assert spw_cell(g[..], ct[..], fc_cell("menu", 3, "label", "THE CREDITS")).ok;
  #assert sc_menu_label(g[0].c[..], 2) == "THE CREDITS" && g[0].c[0].menu[2] == FR_CREDITS;
  #assert !spw_cell(g[..], ct[..], fc_cell("menu", 3, "key", "settings")).ok && g[0].c[0].menu[2] == FR_CREDITS;
  // the camera's path past the rover is a cell too: the first point's seconds
  #assert spw_cell(g[..], ct[..], fc_cell("dolly", 1, "secs", "4")).ok && g[0].c[0].dolly[6] == 4 && fr_dolly(g[0].c[..], 0)[2] == 15;
}

#test "you are drawn as your character: one pose on the creation screen, the walk filled in two a frame, and a store too small stops cleanly" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}]; fc_fresh(g[..]);
  d := [1] SpLayerDraw.[SpLayerDraw.{mesh_n = 100, mesh_gen = 1, place_n = 2}];
  pieces: [60000 * VERTEX_WORDS] u32; places: [SD_PLACE_WORDS] u32; draws: [64] u32;
  // the title draws no player
  #assert fr_player(g[..], d[..], pieces[..], places[..], draws[..], 3) == 3;
  // the creation screen: one pose, after the kinds' meshes, standing on the stand
  g[0].mode = M_CREW;
  #assert fr_player(g[..], d[..], pieces[..], places[..], draws[..], 3) == 4;
  #assert g[0].fr[0].posed_n == 1 && g[0].fr[0].pose_first[0] == 100 && g[0].fr[0].pose_count[0] > 6000 && g[0].fr[0].row;
  #assert draws[12] == 100 && draws[14] == (0x80000000 | cast(u32) (SD_BASE + 2)) && draws[15] == 1;
  s := fr_stand(g[..]);
  #assert abs(f32_from_bits(places[2 * SD_ROW]) - s.x) < 0.001 && abs(f32_from_bits(places[2 * SD_ROW + 2]) - s.z) < 0.001;
  // play: the walk's poses two a frame until the store is full; then none is tried again
  g[0].mode = M_PLAY;
  for i: 0..<8 { _ := fr_player(g[..], d[..], pieces[..], places[..], draws[..], 3); }
  n := g[0].fr[0].posed_n;
  #assert g[0].fr[0].posed_over && n >= 2 && n < FR_POSES && g[0].fr[0].pose_n == g[0].fr[0].pose_first[n - 1] + g[0].fr[0].pose_count[n - 1] - 100;
  gen := g[0].fr[0].pose_gen;
  _ = fr_player(g[..], d[..], pieces[..], places[..], draws[..], 3);
  #assert g[0].fr[0].pose_gen == gen && abs(f32_from_bits(places[2 * SD_ROW]) - g[0].px) < 0.001;
  // a new character writes its poses again
  g[0].fr[0].doc[0] = cp_step(g[0].fr[0].doc[0], CP_OUTFIT, 1); g[0].fr[0].doc_gen += 1;
  _ = fr_player(g[..], d[..], pieces[..], places[..], draws[..], 3);
  #assert g[0].fr[0].pose_gen == gen + 1 && g[0].fr[0].posed_n <= 2;
}
