// Splice Bots' front door (GitHub #13482): the title screen, character creation, the credits, and the
// run this browser keeps. Each screen is the engine's one screen format (metaverse-engine/ui/screen.coax:
// a dark panel down the left over the world, the title at its top, the content under it, the key
// hints at the bottom right) drawn in Splice's tactical look; the player is the crew character you
// made (metaverse-engine/kit/crew-player.coax), drawn from its document with the smuggler's gameplay.
//
// What a maker or an agent changes without code is data: the menu's rows and their order (the
// `menu` table), the credits (`credits`) and the title camera's path past the rover (`dolly`), all
// in content/splice.content and editable as world cells (docs/protocol/world-edit-v1.md).
//
//   title     CONTINUE (only with a run kept, and how far it got), NEW RUN, CREDITS: keys or pointer
//   NEW RUN   the creation screen: body, outfit, height, skin, hair and face on the crew document;
//             USE THIS CHARACTER keeps it (the crew page's record) and starts a run
//   CONTINUE  the kept run, from its last checkpoint outside the mine, as the kept character
//   CREDITS   the credits table; Escape or BACK returns
// This file is loaded by splice-game.coax and draws with its ui_* calls.
#load "../../metaverse-engine/ui/screen.coax";
#load "../../metaverse-engine/kit/crew-player.coax";

M_CREW :: 7; M_CREDITS :: 8;            // splice-game.coax's modes go on from M_RIDE
FR_CONTINUE :: 1; FR_NEW :: 2; FR_CREDITS :: 3;   // a menu row's key (content.coax SC_MENU_KEYS: its place + 1)
FR_USE :: 100; FR_BACK :: 101;          // the creation screen's two plain rows; its value rows are the CP_* fields
FR_FIELDS :: [6] int.[CP_BODY, CP_OUTFIT, CP_HEIGHT, CP_SKIN, CP_HAIR, CP_MARK];
FR_POSES :: 10;                         // the walk cycle's poses, written once a character
FR_OBJ :: 246;                          // the player's first object number (objects 246 to 255)
FR_RUN_TEXT :: 192;
FR_RUN_HEAD :: "splice.run.v1";
FR_STORE_SPACE :: "splice"; FR_STORE_KEY :: "run";   // this browser's kept run (coax/web/STORAGE.md), slot 1
FR_SAVE_EVERY :: 1.0f32;                // seconds between looks at whether the checkpoint changed

// A kept run: the checkpoint's inventory (SpSave), what is open (the rubble, the boss wall, the
// banned bot down, the core taken), and how far the run got.
SpRun :: struct { ok: bool; save: SpSave; open: [4] bool; percent: int; }
SpFront :: struct {
  started: bool; touched: bool;          // the menu was moved by the player (so CONTINUE's arrival doesn't take the focus)
  menu: [1] ScrMenu; rows: [1] ScrMenu; back: [1] ScrMenu;
  doc: [1] CrewDoc; doc_gen: int;        // the character you play as, and its changes
  w: f32; h: f32;                        // the screen the last frame was drawn on
  turn: f32;                             // the creation screen's turntable
  spin: bool; spin_x: f32; spin_hold: f32;   // a drag turning it by hand, where the pointer was, and seconds before it turns on its own again
  run: [1] SpRun;                        // the run this browser keeps
  // this browser's storage: 0 nothing to do, 1 to ask, 2 asked (crew: slot 0, run: slot 1)
  crew_get: int; crew_put: int; run_get: int; run_put: int;
  crew_text: [CD_TEXT] u8; crew_n: int;
  run_text: [FR_RUN_TEXT] u8; run_n: int;   // the run being kept
  kept: [FR_RUN_TEXT] u8; kept_n: int;      // the run last kept (-1 not read yet)
  save_t: f32;
  // the player's poses in the piece store (layer-draw.coax): for which character and which meshes, and where
  posed_doc: int = -1; posed_mesh: int = -1; posed_gray: bool; posed_n: int; posed_over: bool;
  pose_first: [FR_POSES] int; pose_count: [FR_POSES] int; pose_n: int; pose_gen: int; row_gen: int; row: bool;
}

fr_start :: (g: [] SpGame) {
  f := g[0].fr[..];
  if f[0].started { return; }
  f[0].started = true; f[0].doc[0] = cd_first(); f[0].doc_gen = 1; f[0].w = 1280; f[0].h = 720;
  f[0].crew_get = 1; f[0].run_get = 1; f[0].kept_n = -1;
}
fr_front :: (g: [] SpGame) -> bool { m := g[0].mode; return m == M_TITLE || m == M_CREW || m == M_CREDITS; }

// ---- the kept run: a few lines of text

fr_bits :: (out: [] u8, n: int, b: [] bool) -> int { m := n; for v: b { m = ct_put(out, m, ifx v then "1" else "0"); } return m; }
// The run as g's checkpoint holds it, into out; its length.
fr_run_write :: (g: [] SpGame, out: [] u8) -> int {
  s := g[0].save;
  n := ct_put(out, 0, FR_RUN_HEAD); n = ct_put(out, n, "\nhave "); n = fr_bits(out, n, s.have[..]);
  n = ct_put(out, n, "\ntaken "); n = fr_bits(out, n, s.taken[..]);
  n = ct_put(out, n, "\nslot "); n = fr_bits(out, n, s.slot[..]);
  n = ct_put(out, n, "\nstrip");
  for i: 0..<3 { n = ct_put(out, n, " "); n = ct_put_int(out, n, s.strip[i]); }
  n = ct_put(out, n, " "); n = ct_put_int(out, n, s.strip_n);
  n = ct_put(out, n, "\nheld "); n = ct_put_int(out, n, s.scrap); n = ct_put(out, n, " "); n = ct_put_int(out, n, s.cells);
  open := [4] bool.[g[0].rubble_gone, g[0].wall_gone, g[0].boss_down, g[0].core_taken];
  n = ct_put(out, n, "\nopen "); n = fr_bits(out, n, open[..]);
  n = ct_put(out, n, "\n");
  return ifx n > out.count then 0 else n;
}
// A line "KEY VALUE" at i: the value, and where the next line starts (-1: not this key).
FrLine :: struct { v: string; next: int = -1; }
fr_line :: (t: string, i: int, key: string) -> FrLine {
  if i < 0 || i + key.count + 1 > t.count || t[i..<i + key.count] != key || t[i + key.count] != ' ' { return FrLine.{}; }
  e := i + key.count + 1; while e < t.count && t[e] != '\n' { e += 1; }
  if e >= t.count { return FrLine.{}; }
  return FrLine.{v = t[i + key.count + 1..<e], next = e + 1};
}
fr_read_bits :: (v: string, b: [] bool) -> bool {
  if v.count != b.count { return false; }
  for i: 0..<v.count { if v[i] != '0' && v[i] != '1' { return false; } b[i] = v[i] == '1'; }
  return true;
}
// Whole numbers apart by single spaces, each 0 to most, exactly as many as out holds.
fr_read_ints :: (v: string, out: [] int, most: int) -> bool {
  k := 0; i := 0;
  while i < v.count {
    if k >= out.count || v[i] < '0' || v[i] > '9' { return false; }
    x := 0; while i < v.count && v[i] >= '0' && v[i] <= '9' { x = x * 10 + cast(int) v[i] - 48; if x > most { return false; } i += 1; }
    out[k] = x; k += 1;
    if i < v.count { if v[i] != ' ' || i + 1 >= v.count { return false; } i += 1; }
  }
  return k == out.count;
}
// A kept run read whole, or not ok: a run of another version, a line missing or out of range is
// never half-read.
fr_run_read :: (t: string) -> SpRun {
  r: SpRun; bad: SpRun;
  h := FR_RUN_HEAD;
  if t.count < h.count + 1 || t[0..<h.count] != h || t[h.count] != '\n' { return bad; }
  a := fr_line(t, h.count + 1, "have"); if !fr_read_bits(a.v, r.save.have[..]) { return bad; }
  a = fr_line(t, a.next, "taken"); if !fr_read_bits(a.v, r.save.taken[..]) { return bad; }
  a = fr_line(t, a.next, "slot"); if !fr_read_bits(a.v, r.save.slot[..]) { return bad; }
  strip: [4] int;
  a = fr_line(t, a.next, "strip"); if !fr_read_ints(a.v, strip[..], HAVES - 1) || strip[3] > 3 { return bad; }
  for i: 0..<3 { r.save.strip[i] = strip[i]; } r.save.strip_n = strip[3];
  held: [2] int;
  a = fr_line(t, a.next, "held"); if !fr_read_ints(a.v, held[..], 99) { return bad; }
  r.save.scrap = held[0]; r.save.cells = held[1];
  a = fr_line(t, a.next, "open"); if !fr_read_bits(a.v, r.open[..]) || a.next != t.count { return bad; }
  r.ok = true; r.percent = fr_percent(r);
  return r;
}
// How far a run got, of the twelve beats from the battery by the rail to the core in hand.
fr_percent :: (r: SpRun) -> int {
  s := r.save; done := 2;   // the battery found and the mine reached: a run is kept from the mine's gate
  for i: 0..<5 { if s.have[i] { done += 1; } }
  if s.slot[0] && s.slot[1] && s.slot[2] { done += 1; }
  if r.open[0] { done += 1; }
  if s.have[H_PLUS] || s.taken[PICK_PLUS] { done += 1; }
  if r.open[1] { done += 1; }
  if r.open[2] { done += 1; }
  return lo_int(done, 12) * 100 / 12;
}
lo_int :: (a: int, b: int) -> int { return ifx a < b then a else b; }
// Continue the kept run: back at the checkpoint outside the mine with its inventory, as the kept character.
fr_continue :: (g: [] SpGame) {
  r := g[0].fr[0].run[0];
  g_reset(g);
  g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true; g[0].pinged = true;
  g_enter_mine(g);
  g[0].save = r.save;
  g[0].rubble_gone = r.open[0]; g[0].wall_gone = r.open[1]; g[0].boss_down = r.open[2]; g[0].core_taken = r.open[3];
  if g[0].rubble_gone { g[0].phase = PH_DUSK; }
  if g[0].boss_down { g[0].phase = PH_NIGHT; }   // after the boss it is night (#13505)
  g_respawn(g);
  g[0].mode = M_PLAY; g[0].look_free = false;
}
// Each second of a run in the mine, the checkpoint is kept when it changed; a run restored is let go.
fr_autosave :: (g: [] SpGame, dt: f32) {
  f := g[0].fr[..];
  if !f[0].started || f[0].kept_n < 0 || f[0].run_put != 0 { return; }
  if g[0].mode == M_RESTORED {
    if f[0].kept_n > 0 { f[0].run_n = 0; f[0].run_put = 1; }
    return;
  }
  if g[0].zone != Z_MINE || (g[0].mode != M_PLAY && g[0].mode != M_BAY) { return; }
  f[0].save_t += dt;
  if f[0].save_t < FR_SAVE_EVERY { return; }
  f[0].save_t = 0;
  n := fr_run_write(g, f[0].run_text[..]);
  if n > 0 && (n != f[0].kept_n || cast(string) f[0].run_text[0..<n] != cast(string) f[0].kept[0..<n]) { f[0].run_n = n; f[0].run_put = 1; }
}

// ---- this browser's storage (the page's exports, splice-bots.coax; the host, coax/web/STORAGE.md)

FR_ASK_CREW :: 1; FR_KEEP_CREW :: 2; FR_ASK_RUN :: 3; FR_KEEP_RUN :: 4;
// What the page wants of the host next, or 0.
fr_store_wants :: (g: [] SpGame) -> int {
  f := g[0].fr[..];
  if !f[0].started { return 0; }
  if f[0].crew_get == 1 { return FR_ASK_CREW; }
  if f[0].run_get == 1 { return FR_ASK_RUN; }
  if f[0].crew_put == 1 && f[0].crew_get == 0 { return FR_KEEP_CREW; }
  if f[0].run_put == 1 && f[0].run_get == 0 { return FR_KEEP_RUN; }
  return 0;
}
fr_store_asked :: (g: [] SpGame, which: int, accepted: bool) {
  f := g[0].fr[..]; v := ifx accepted then 2 else 0;
  if which == FR_ASK_CREW { f[0].crew_get = v; } if which == FR_KEEP_CREW { f[0].crew_put = v; }
  if which == FR_ASK_RUN { f[0].run_get = v; if !accepted { f[0].kept_n = 0; } }
  if which == FR_KEEP_RUN { f[0].run_put = v; }
}
fr_store_text :: (g: [] SpGame, which: int) -> string {
  f := g[0].fr[..];
  return ifx which == FR_KEEP_CREW then cast(string) f[0].crew_text[0..<f[0].crew_n] else ifx which == FR_KEEP_RUN then cast(string) f[0].run_text[0..<f[0].run_n] else "";
}
// The host's answer in slot 0 (the character) or 1 (the run): 16 bytes (token, status, length,
// needed), then a read's bytes. A record that doesn't read leaves the first character or no run.
fr_stored :: (g: [] SpGame, slot: int, body: string) {
  f := g[0].fr[..];
  if body.count < 16 { return; }
  status := cast(int) body[4] | (cast(int) body[5] << 8);
  size := cast(int) body[8] | (cast(int) body[9] << 8) | (cast(int) body[10] << 16);
  have := status == 0 && size >= 0 && 16 + size <= body.count;
  text := ifx have then cast(string) body[16..<16 + size] else "";
  if slot == 0 {
    if f[0].crew_put == 2 { f[0].crew_put = 0; return; }
    f[0].crew_get = 0;
    r := [1] CdRead.[cd_read(text)];
    if have && r[0].ok { f[0].doc[0] = r[0].doc; f[0].doc_gen += 1; }
    return;
  }
  if f[0].run_put == 2 {
    f[0].run_put = 0;
    if status == 0 { f[0].kept_n = f[0].run_n; for i: 0..<f[0].run_n { f[0].kept[i] = f[0].run_text[i]; } f[0].run[0] = fr_run_read(cast(string) f[0].run_text[0..<f[0].run_n]); }
    return;
  }
  f[0].run_get = 0;
  f[0].run[0] = fr_run_read(text);
  f[0].kept_n = ifx f[0].run[0].ok then text.count else 0;
  for i: 0..<lo_int(f[0].kept_n, FR_RUN_TEXT) { f[0].kept[i] = text[i]; }
}

// ---- keys and the pointer

fr_rows_build :: (g: [] SpGame) {
  f := g[0].fr[..]; c := g[0].c[..];
  m := f[0].menu[..]; was := scr_focused(m); scr_menu_clear(m);
  for r: 0..<c[0].menu_n { k := c[0].menu[r]; _ := scr_menu_add(m, k, k != FR_CONTINUE || f[0].run[0].ok, false); }
  scr_focus(m, ifx f[0].touched && was >= 0 then was else FR_CONTINUE);
  rows := f[0].rows[..]; at := scr_focused(rows); scr_menu_clear(rows);
  for k: FR_FIELDS { _ = scr_menu_add(rows, k, true, true); }
  _ = scr_menu_add(rows, FR_USE, true, false); _ = scr_menu_add(rows, FR_BACK, true, false);
  scr_focus(rows, ifx at >= 0 then at else FR_USE);
  b := f[0].back[..]; scr_menu_clear(b); _ = scr_menu_add(b, FR_BACK, true, false); scr_focus(b, FR_BACK);
}
fr_spec :: (mode: int) -> ScrSpec {
  if mode == M_CREW { return ScrSpec.{body = 196, row = 44, gap = 8}; }
  if mode == M_CREDITS { return ScrSpec.{body = 560}; }
  return scr_title_spec();
}
fr_frame :: (g: [] SpGame) -> ScrFrame { return scr_frame(g[0].fr[0].w, g[0].fr[0].h, fr_spec(g[0].mode)); }
fr_menu :: (g: [] SpGame) -> [] ScrMenu {
  f := g[0].fr[..];
  return ifx g[0].mode == M_CREW then f[0].rows[..] else ifx g[0].mode == M_CREDITS then f[0].back[..] else f[0].menu[..];
}
fr_act :: (g: [] SpGame, a: ScrAct) -> bool {
  f := g[0].fr[..];
  if a.act == SCR_NONE { return false; }
  if a.act == SCR_FOCUS { f[0].touched = true; return true; }
  if g[0].mode == M_TITLE {
    if a.act != SCR_PICK { return true; }
    if a.id == FR_CONTINUE && f[0].run[0].ok { fr_continue(g); }
    if a.id == FR_NEW { g[0].mode = M_CREW; f[0].turn = 0; scr_focus(f[0].rows[..], FR_USE); }
    if a.id == FR_CREDITS { g[0].mode = M_CREDITS; }
    return true;
  }
  if a.act == SCR_BACK || a.id == FR_BACK { g[0].mode = M_TITLE; return true; }
  if g[0].mode == M_CREW {
    if a.act == SCR_LEFT || a.act == SCR_RIGHT { f[0].doc[0] = cp_step(f[0].doc[0], a.id, ifx a.act == SCR_LEFT then -1 else 1); f[0].doc_gen += 1; return true; }
    if a.act == SCR_PICK && a.id == FR_USE {
      // keep the character (the crew page's record too), let the old run go, and start a new one
      f[0].crew_n = hi_int(cd_write(f[0].doc[0], f[0].crew_text[..]), 0); if f[0].crew_n > 0 { f[0].crew_put = 1; }
      f[0].run_n = 0; f[0].run_put = 1; f[0].run[0] = SpRun.{};
      g_begin(g);   // the dome village, or the world's first start row (#13485)
    }
  }
  return true;
}
hi_int :: (a: int, b: int) -> int { return ifx a > b then a else b; }
fr_key :: (g: [] SpGame, key: int) -> bool {
  fr_start(g);
  fr_rows_build(g);
  if g[0].mode == M_TITLE && key == SCR_KEY_ESC { return false; }   // nothing to go back to
  return fr_act(g, scr_key(fr_menu(g), key));
}
fr_pointer :: (g: [] SpGame, x: f32, y: f32, phase: int) -> bool {
  fr_start(g);
  fr_rows_build(g);
  f := g[0].fr[..];
  // the creation screen: a drag off the rows turns the character by hand (#13505 playtest)
  if g[0].mode == M_CREW && f[0].spin {
    if phase == 1 { f[0].turn += (x - f[0].spin_x) * FR_SPIN; f[0].spin_x = x; f[0].spin_hold = FR_SPIN_HOLD; return true; }
    if phase == 2 || phase == 3 { f[0].spin = false; f[0].spin_hold = FR_SPIN_HOLD; return true; }
  }
  took := fr_act(g, scr_point(fr_frame(g), fr_menu(g), x, y, phase));
  if !took && phase == 0 && g[0].mode == M_CREW { f[0].spin = true; f[0].spin_x = x; f[0].spin_hold = FR_SPIN_HOLD; return true; }
  return took;
}
FR_SPIN :: 0.012f32;      // radians a pixel of drag turns the character
FR_SPIN_HOLD :: 3.0f32;   // seconds after a drag before the turntable turns on its own again
// The turntable's step: on its own, unless a drag holds it.
fr_spin_step :: (g: [] SpGame, dt: f32) {
  f := g[0].fr[..];
  if f[0].spin { return; }
  if f[0].spin_hold > 0 { f[0].spin_hold -= dt; return; }
  f[0].turn += dt * 0.35;
}
#test "the character screen: a drag off the rows turns the character by hand, and the turntable waits before it turns on its own" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); g[0].mode = M_CREW; fr_start(g[..]);
  t0 := g[0].fr[0].turn;
  #assert fr_pointer(g[..], 1200, 400, 0) && g[0].fr[0].spin;
  #assert fr_pointer(g[..], 1300, 400, 1) && abs(g[0].fr[0].turn - (t0 + 100 * FR_SPIN)) < 0.001;
  #assert fr_pointer(g[..], 1300, 400, 2) && !g[0].fr[0].spin;
  t1 := g[0].fr[0].turn; g_step(g[..], 1.0); #assert g[0].fr[0].turn == t1;
  g_step(g[..], 2.5); g_step(g[..], 0.5); #assert g[0].fr[0].turn > t1;
}

// ---- the camera: the rover on the rail and the dolly past it, or the character on its stand

// Where the title's rover is on the rail: a slow drive, round again at the end.
fr_rail_s :: (g: [] SpGame) -> f32 { return 20 + fmod_pos(g[0].t * 3.0, T_RAIL - 40); }
fmod_pos :: (a: f32, b: f32) -> f32 { return a - floor(a / b) * b; }
// The dolly's place at time t: the rows' points in turn, eased between, the last back to the first.
fr_dolly :: (c: [] SpContent, t: f32) -> [6] f32 {
  out: [6] f32; n := c[0].dolly_n;
  if n < 1 { return out; }
  total := 0.0f32; for r: 0..<n { total += c[0].dolly[r * 7 + 6]; }
  at := fmod_pos(t, total);
  for r: 0..<n {
    nx := (r + 1) % n; leg := hi(c[0].dolly[r * 7 + 6], 0.1);   // a row's seconds: from its point to the next
    if at > leg && r < n - 1 { at -= leg; continue; }
    k := clamp(at / leg, 0, 1); k = k * k * (3 - 2 * k);
    for i: 0..<6 { out[i] = lerp(c[0].dolly[r * 7 + i], c[0].dolly[nx * 7 + i], k); }
    return out;
  }
  return out;
}
// The stand the creation screen shows the character on: beside the rail, the rover behind.
fr_stand :: (g: [] SpGame) -> Point { c := rail_at(g, 12); return v3(c.x + 4.5, 0, c.z); }
// A view moved so its subject stands in the middle of what the panel leaves free.
fr_framed :: (g: [] SpGame, eye: Point, at: Point, fov: f32) -> CamNow {
  f := fr_frame(g);
  share := (scr_free_x(f) - f.w * 0.5) / (f.w * 0.5);
  d := sub(at, eye); dist := length(d);
  right := unit_or(cross(d, v3(0, 1, 0)), v3(1, 0, 0));
  shift := dist * tan(fov * 0.5) * (f.w / hi(f.h, 1)) * share;
  return CamNow.{eye = eye, at = sub(at, times(right, shift)), fov = fov};
}
fr_camera :: (g: [] SpGame) -> CamNow {
  if g[0].mode == M_CREW {
    s := fr_stand(g); h := cast(f32) g[0].fr[0].doc[0].body.v[CB_HEIGHT] * 0.01;
    return fr_framed(g, v3(s.x, h * 0.62, s.z - 4.4), v3(s.x, h * 0.55, s.z), 0.6);
  }
  rs := fr_rail_s(g); c := rail_at(g, rs); y := rail_yaw(g, rs);
  d := fr_dolly(g[0].c[..], g[0].t);
  x := v3(cos(y), 0, -sin(y)); z := v3(sin(y), 0, cos(y));
  eye := add(add(c, times(x, d[0])), add(v3(0, d[1], 0), times(z, d[2])));
  at := add(add(c, times(x, d[3])), add(v3(0, d[4], 0), times(z, d[5])));
  return fr_framed(g, eye, at, 0.7);
}
// What the front screens draw live: the rover on the rail (the title and the credits), or parked by
// the stand (the creation screen; the character is the page's instance, fr_player).
fr_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  rs := ifx g[0].mode == M_CREW then 0.0f32 else fr_rail_s(g);
  c := rail_at(g, rs);
  g_draw_rover(buf, p, v3(c.x, 0.2, c.z), rail_yaw(g, rs));
}

// ---- the player: the character's walk cycle in the piece store, one instance a frame

// The poses into the piece store after the kinds' meshes, when the character or the meshes changed;
// then the player's row after the placed pieces' rows, and its draw. The draws' count after it.
fr_player :: (g: [] SpGame, d: [] SpLayerDraw, pieces: [] u32, places: [] u32, draws: [] u32, at: int) -> int {
  fr_start(g);
  f := g[0].fr[..]; f[0].row = false;
  crew := g[0].mode == M_CREW;
  walking := g[0].mode == M_PLAY || g[0].mode == M_BANNER;
  if !crew && !walking { return at; }
  if walking && g[0].hide[TK_SMUGGLER] { return at; }   // a host draws you itself (splice_thing_hide)
  if g[0].hit_cool > 0 && fract(g[0].t * 8) < 0.5 && !crew { return at; }
  need := ifx crew then 1 else FR_POSES;
  if f[0].posed_doc != f[0].doc_gen || f[0].posed_mesh != d[0].mesh_gen || f[0].posed_gray != g[0].gray { f[0].posed_n = 0; f[0].pose_n = 0; f[0].posed_over = false; }
  // at most two poses a frame (a pose is a whole dressed figure): play starts on the first and the walk fills in
  if f[0].posed_n < need && !f[0].posed_over {
    pen := [1] Pen.[Pen.{n = ifx f[0].posed_n == 0 then d[0].mesh_n else f[0].pose_first[f[0].posed_n - 1] + f[0].pose_count[f[0].posed_n - 1], graybox = g[0].gray}];
    wrote := 0;
    while f[0].posed_n < need && wrote < 2 {
      i := f[0].posed_n; f[0].pose_first[i] = pen[0].n; wrote += 1;
      cp_write(pieces, pen[..], frame_at(v3(0, 0, 0), 0), f[0].doc[0], cp_pose_stride(i, FR_POSES), FR_OBJ);
      if pen[0].over { f[0].posed_over = true; pen[0].n = f[0].pose_first[i]; break; }
      f[0].pose_count[i] = pen[0].n - f[0].pose_first[i]; f[0].posed_n += 1;
    }
    f[0].pose_n = pen[0].n - d[0].mesh_n; f[0].pose_gen += 1;
    f[0].posed_doc = f[0].doc_gen; f[0].posed_mesh = d[0].mesh_gen; f[0].posed_gray = g[0].gray;
  }
  if f[0].posed_n < 1 || (at + 1) * 4 > draws.count || (d[0].place_n + 1) * SD_ROW > places.count { return at; }
  // in the air on a jump the figure holds the stride's widest pose, a leap (the rig has no jump clip)
  stride := ifx g_airborne(g) then PI * 0.5f32 else g[0].stride;
  pose := ifx crew then 0 else lo_int(cp_pose_of(stride, FR_POSES), f[0].posed_n - 1);
  x := g[0].px; z := g[0].pz; yaw := g_face(g);
  y := g_feet_y(g);
  if g_riding(g) { y += board_lift(g[0].board[0]) + 0.075; }   // on the hoverboard's deck (#13485)
  if crew { s := fr_stand(g); x = s.x; z = s.z; y = 0; yaw = PI + f[0].turn; }
  o := d[0].place_n * SD_ROW;
  places[o] = f32_bits(x); places[o + 1] = f32_bits(y); places[o + 2] = f32_bits(z); places[o + 3] = 0;
  places[o + 4] = f32_bits(cos(yaw)); places[o + 5] = f32_bits(sin(yaw)); places[o + 6] = 0; places[o + 7] = 0;
  f[0].row = true; f[0].row_gen += 1;
  draws[at * 4] = cast(u32) f[0].pose_first[pose]; draws[at * 4 + 1] = cast(u32) f[0].pose_count[pose];
  draws[at * 4 + 2] = 0x80000000 | cast(u32) (SD_BASE + d[0].place_n); draws[at * 4 + 3] = 1;
  return at + 1;
}

// ---- the screens, in Splice's tactical look (the v2 boards: a dark panel, cream type, orange marks)

FR_PANEL :: () -> KitTint { return t3(0.078, 0.075, 0.063); }
FR_RULE :: () -> KitTint { return t3(0.247, 0.227, 0.200); }
FR_CREAM :: () -> KitTint { return t3(0.937, 0.910, 0.847); }
FR_ORANGE :: () -> KitTint { return t3(0.941, 0.541, 0.235); }
FR_MUTED :: () -> KitTint { return t3(0.659, 0.620, 0.561); }
FR_HINT :: () -> KitTint { return t3(0.812, 0.776, 0.714); }
FR_EDGE :: () -> KitTint { return t3(0.353, 0.325, 0.290); }

// The frame every screen shares: the panel and its edge, the kicker in orange, the title, the rule under it.
// A second title line (second, "" for none) sits under the first at the same size: SPLICE / BOTS fits the
// panel's 336 px at the board's 56 px, where one line would not.
fr_head :: (g: [] SpGame, out: [] f32, u: [] f32, n: int, f: ScrFrame, kicker: string, title: string, second: string, em: f32) -> int {
  k := f.k; m := n;
  ui_panel(g, u, f.panel.x0 - 2, f.panel.y0 - 2, f.panel.x1, f.panel.y1 + 2, FR_PANEL(), 0.95);
  m = ui_seg(out, m, f.panel.x1, 0, f.panel.x1, f.h, 0.5 * k, FR_RULE(), 1);
  m = fr_tracked(out, m, kicker, f.left, f.top + 9 * k, 8.4 * k, 3 * k, FR_ORANGE());
  base := f.top + 22 * k + em * k * 0.86;
  m = ui_put(out, m, F_TITLE, title, f.left, base, em * TITLE_CAP * k, FR_CREAM(), 1);
  if second.count > 0 { base += em * k * 0.93; m = ui_put(out, m, F_TITLE, second, f.left, base, em * TITLE_CAP * k, FR_CREAM(), 1); }
  m = ui_seg(out, m, f.left + 1.5 * k, base + 11 * k, f.left + 62.5 * k, base + 11 * k, 1.5 * k, FR_ORANGE(), 1);
  return m;
}
// Mono type spaced apart by track pixels a letter (the boards' kickers).
fr_tracked :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, track: f32, c: KitTint) -> int {
  m := n; at := x; i := 0;
  while i < t.count {
    d := decode(t, i); one := t[i..<i + d.len]; i += d.len;
    m = ui_put(out, m, F_MONO, one, at, base, cap, c, 1);
    at += ui_w(F_MONO, one, cap) + track;
  }
  return m;
}
// A row: the focused one filled in cream with dark type, the others outlined.
fr_row :: (g: [] SpGame, out: [] f32, u: [] f32, n: int, f: ScrFrame, b: ScrBox, label: string, focused: bool) -> int {
  k := f.k; m := n;
  if focused { ui_panel(g, u, b.x0, b.y0, b.x1, b.y1, FR_CREAM(), 1); }
  else { m = ui_box(out, m, b.x0, b.y0, b.x1, b.y1, 1 * k, FR_EDGE()); }
  cap := 12.5 * k;
  return ui_put(out, m, F_TITLE, label, b.x0 + 20 * k, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, ifx focused then FR_PANEL() else FR_CREAM(), 1);
}
// The key hints at the bottom right: a cream cap with the key in dark type, and its word.
fr_hints :: (g: [] SpGame, out: [] f32, u: [] f32, n: int, f: ScrFrame, keys: [] string, words: [] string) -> int {
  k := f.k; m := n; cap := 8.4 * k; pad := 6 * k;
  cw: [SCR_HINTS] f32; ww: [SCR_HINTS] f32; c := lo_int(keys.count, SCR_HINTS);
  for i: 0..<c { cw[i] = ui_w(F_MONO, keys[i], cap) + 12 * k; ww[i] = ui_w(F_MONO, words[i], cap); }
  // a dark band under the hints, so they read over a bright world as they do on the boards
  x0 := scr_hint_x(f, cw[..], ww[..], c, 0, pad, 20 * k);
  ui_panel(g, u, x0 - 12 * k, f.hint_y1 - 29 * k, f.hint_x1 + 12 * k, f.hint_y1 + 10 * k, FR_PANEL(), 0.72);
  for i: 0..<c {
    x := scr_hint_x(f, cw[..], ww[..], c, i, pad, 20 * k);
    y1 := f.hint_y1; y0 := y1 - 19 * k;
    ui_panel(g, u, x, y0, x + cw[i], y1, FR_CREAM(), 1);
    m = ui_put(out, m, F_MONO, keys[i], x + 6 * k, y1 - 5.5 * k, cap, FR_PANEL(), 1);
    m = ui_put(out, m, F_MONO, words[i], x + cw[i] + pad, y1 - 5.5 * k, cap, FR_HINT(), 1);
  }
  return m;
}
fr_overlay :: (g: [] SpGame, out: [] f32, u: [] f32, w: f32, h: f32) -> int {
  fr_start(g);
  fs := g[0].fr[..]; fs[0].w = w; fs[0].h = h;
  fr_rows_build(g);
  f := fr_frame(g); k := f.k; n := 0; c := g[0].c[..];
  buf: [64] u8;
  name := cd_name(fs[0].doc[..]);
  if g[0].mode == M_CREW {
    n = fr_head(g, out, u, n, f, "NEW RUN // REEL 01", "CHARACTER", "", 30);
    rows := fs[0].rows[..];
    for i: 0..<rows[0].n {
      b := scr_row_box(f, rows, i); id := rows[0].id[i]; on := rows[0].focus == i;
      if id == FR_USE { n = fr_row(g, out, u, n, f, b, "USE THIS CHARACTER", on); continue; }
      if id == FR_BACK { n = fr_row(g, out, u, n, f, b, "BACK", on); continue; }
      names := CP_FIELD_NAMES;
      n = fr_row(g, out, u, n, f, b, upper(names[id], buf[..]), on);
      ink := ifx on then FR_PANEL() else FR_CREAM();
      l := scr_arrow_box(f, rows, i, false); r := scr_arrow_box(f, rows, i, true);
      vb: [32] u8; v := upper(cp_value(fs[0].doc[0], id, vb[..]), buf[..]);
      cy := (b.y0 + b.y1) * 0.5 + 4.2 * k;
      n = ui_put(out, n, F_MONO, "<", l.x0 + 8 * k, cy, 8.4 * k, ink, 1);
      n = ui_put(out, n, F_MONO, ">", r.x1 - 16 * k, cy, 8.4 * k, ink, 1);
      n = ui_put(out, n, F_MONO, v, (l.x0 + r.x1) * 0.5 - ui_w(F_MONO, v, 8.4 * k) * 0.5 + 4 * k, cy, 8.4 * k, ink, 1);
    }
    nb: [48] u8; nl := ct_put(nb[..], 0, "PLAYING AS "); nl = ct_put(nb[..], nl, name);
    n = ui_put(out, n, F_MONO, upper(cast(string) nb[0..<lo_int(nl, nb.count)], buf[..]), f.left, f.foot, 8.4 * k, FR_MUTED(), 1);
    keys := [3] string.["ENTER", "A D", "ESC"]; words := [3] string.["SELECT", "CHANGE", "BACK"];
    return fr_hints(g, out, u, n, f, keys[..], words[..]);
  }
  if g[0].mode == M_CREDITS {
    n = fr_head(g, out, u, n, f, "REEL 01 // CREDITS", "CREDITS", "", 30);
    for i: 0..<c[0].credits { n = ui_put(out, n, F_MONO, sc_credit(c, i), f.left, 214 * k + cast(f32) i * 26 * k, 8.4 * k, ifx i < 2 then FR_CREAM() else FR_HINT(), 1); }
    n = fr_row(g, out, u, n, f, scr_row_box(f, fs[0].back[..], 0), "BACK", true);
    keys := [2] string.["ENTER", "ESC"]; words := [2] string.["SELECT", "BACK"];
    return fr_hints(g, out, u, n, f, keys[..], words[..]);
  }
  // the title: REEL 01 is Splice's one reel; the menu is the table's rows
  n = fr_head(g, out, u, n, f, "REEL 024 // DIRECTOR'S CUT", "SPLICE", "BOTS", 56);
  m := fs[0].menu[..];
  for i: 0..<m[0].n {
    if !m[0].shown[i] { continue; }
    b := scr_row_box(f, m, i); on := m[0].focus == i;
    for r: 0..<c[0].menu_n { if c[0].menu[r] == m[0].id[i] { n = fr_row(g, out, u, n, f, b, sc_menu_label(c, r), on); } }
    if m[0].id[i] == FR_CONTINUE {
      t := num(buf[..], "REEL 01 · ", fs[0].run[0].percent, "%");
      n = ui_put(out, n, F_MONO, t, b.x1 - 20 * k - ui_w(F_MONO, t, 8.4 * k), (b.y0 + b.y1) * 0.5 + 4.2 * k, 8.4 * k, ifx on then FR_PANEL() else FR_HINT(), 1);
    }
  }
  nb: [48] u8; nl := ct_put(nb[..], 0, "PLAYING AS "); nl = ct_put(nb[..], nl, name);
  n = ui_put(out, n, F_MONO, upper(cast(string) nb[0..<lo_int(nl, nb.count)], buf[..]), f.left, f.foot - 21 * k, 8.4 * k, FR_MUTED(), 1);
  n = ui_put(out, n, F_MONO, "WEB BUILD · REEL 01 OF 1", f.left, f.foot, 8.4 * k, FR_MUTED(), 1);
  keys := [1] string.["ENTER"]; words := [1] string.["SELECT"];
  return fr_hints(g, out, u, n, f, keys[..], words[..]);
}
// t in capitals (ASCII), into buf.
upper :: (t: string, buf: [] u8) -> string {
  n := lo_int(t.count, buf.count);
  for i: 0..<n { ch := t[i]; buf[i] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; }
  return cast(string) buf[0..<n];
}
