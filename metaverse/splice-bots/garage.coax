// The raider mine garage (GitHub #13505, slice 1 part B; layout per the level spec, #13552): a round pit
// dug into the desert and open to the sky, its middle a field about 270 m across (the rave floor, a purple
// circle at its centre), and bays round its edge, half under the rim, in 24 named sections (GA_NAMES, the
// one table of their names), each a quarter of an hour round the clock. North is -z. The player comes in
// from the south, where Sniper parks, through the least-used opening (the mine mouth, the scrap room and
// the tunnel) and the raiders' rock wall, into the old entrance bay A1 at 6 o'clock. C1 at 3 o'clock is
// the section the raiders left empty on their dusk trip, where the drill mech waits; G1 at 9 o'clock is
// the work bay with its catwalk. Straight across from A1, E1 at 12 o'clock opens on a hallway north into
// the mountain, blocked until the drill mech breaks it; past it is the old-world lab, round
// and white, the hallway coming in at its south (#13552).
//
// Where it stands and how big it is are the landmark "Garage" (its middle, and the field's radius); the
// bays, the rim and the hallway are measured from it. Its walls are colliders in the World (layer.coax
// sl_build calls ga_colliders): a pier between each two bays and a back wall behind each bay, as
// stadiums that turn with the ring. Its triangles are written once with the designed world (g_world).
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax
#load "../../metaverse-engine/kit/stencil.coax";

GA_SECTIONS :: 24;             // eight letters, three sections each: L1, L2 and the one between L and the next letter
GA_BAY :: 20.0f32;             // m: a bay's depth, from the field's edge to its back wall
GA_PIER :: 2.5f32;             // m: half a pier's thickness
GA_BACK :: 2.5f32;             // m: half the back wall's thickness
GA_ROOF :: 11.0f32;            // m: a bay's roof
GA_LEDGE :: 2.0f32;            // m: the roof's slab
GA_RIM :: 24.0f32;             // m: the rim over the field
GA_CENTRE :: 45.0f32;          // m: the purple circle at the rave floor's centre
GA_SET :: 8.0f32;              // m: how far the rim's wall stands back from the field's edge
GA_BERM :: 46.0f32;            // m: the rim's slope down to the desert outside
GA_DOOR :: 3.0f32;             // m: half the width of the entry's tunnel
GA_HALL :: 3.2f32;             // m: half the width of the hallway into the mountain (the boss wall reaches into its sides)
GA_HALL_LONG :: 32.0f32;       // m: the hallway's length, from the back wall to the lab
GA_ROCK_SKIN :: 0.15f32;       // m: the hallway's and the lab's white walls stand this far in front of the rock round them (the layout's walls, their bands 12 cm proud)
GA_LAB_R :: 24.0f32;           // m: the round lab's radius, inside its wall; its middle is the boss's
GA_LAB_TALL :: 9.0f32;         // m: its ceiling
GA_LAB_SIDES :: 24;            // its round wall in straight pieces; the one at the south is the hallway's mouth
GA_LAB_X :: GA_LAB_R; GA_LAB_Z :: GA_LAB_R * 2;   // m: the square of rock round it, half its width and its depth
GA_ENTRY :: 0;                 // A1: the old entrance bay, north, where the tunnel comes in
GA_EMPTY :: 6;                 // C1, due east: the section the raiders left empty, where the drill mech stands (layout per the level spec, #13552)
GA_HALLWAY :: 12;              // E1: straight across from A1, the hallway into the mountain
LM_GARAGE :: 80;               // the landmark: the field's middle, and its radius
GA_X :: 0.0f32; GA_Z :: -195.0f32; GA_R :: 135.0f32;   // where it is when the tables have no landmark for it

// ---- where things are
ga_span :: () -> f32 { return TAU / cast(f32) GA_SECTIONS; }
// Section k's middle, as an angle round the field: 0 is north (+z), a quarter turn is east (+x).
ga_angle :: (k: int) -> f32 { return cast(f32) k * ga_span(); }
// Where the hallway opens into the lab: the one join between the two.
ga_lab_mouth :: (g: [] SpGame) -> f32 { return g[0].at.gar_z - ga_back(g) - GA_HALL_LONG; }
// The lab's middle, its radius north of the mouth.
ga_lab_mid :: (g: [] SpGame) -> Point { return v3(g[0].at.gar_x, 0, ga_lab_mouth(g) - GA_LAB_R); }
// The point on a circle round c at angle a (0 south, toward +z; a quarter turn east, +x), y up.
ga_round :: (c: Point, a: f32, r: f32, y: f32) -> Point { return v3(c.x + sin(a) * r, y, c.z + cos(a) * r); }
// The lab's round wall: a body of radius r inside it stays r in front of the wall, except through the
// hallway's mouth at its south. A body just past the wall is put back in; one further out is not the lab's.
ga_lab_push :: (g: [] SpGame, x: f32, z: f32, r: f32) -> Point {
  c := ga_lab_mid(g); dx := x - c.x; dz := z - c.z; d := sqrt(dx * dx + dz * dz);
  edge := GA_LAB_R - r;
  if d <= edge || d > GA_LAB_R + GA_BACK * 2 + r { return v3(x, 0, z); }
  if dz > 0 && abs(dx) <= GA_HALL - r { return v3(x, 0, z); }   // the mouth
  return v3(c.x + dx / d * edge, 0, c.z + dz / d * edge);
}
ga_back :: (g: [] SpGame) -> f32 { return g[0].at.gar_r + GA_BAY; }
// The foot of the rim's slope outside, where the desert starts.
ga_foot :: (g: [] SpGame) -> f32 { return ga_shell_in(g) + GA_BERM; }
// The yard outside the mine mouth, where Sniper parks (#13552): open sky from the mine mouth's face out
// to the desert, between the ends of the mouth's walls (g_layout). The outer shell's slope is cut round
// it, drawn and solid alike, so the parked rover train stands in the open and the camera has room.
GA_YARD_X :: 44.0f32;          // m: half its width, to the ends of the mine mouth's walls
GA_YARD_IN :: 38.0f32;         // m: from the back wall out to the mine mouth's face, where the yard starts
ga_shell_in :: (g: [] SpGame) -> f32 { return ga_back(g) + GA_BACK + 6; }   // the rim's edge, where the shell starts down
ga_yard_z :: (g: [] SpGame) -> f32 { return ga_back(g) + GA_YARD_IN; }      // the mine mouth's face, out from the field's middle
// Whether (x, z) is in the yard, kept r in from its sides.
ga_in_yard :: (g: [] SpGame, x: f32, z: f32, r: f32) -> bool { return z - g[0].at.gar_z > ga_yard_z(g) && abs(x - g[0].at.gar_x) < GA_YARD_X - r; }
// The yard's half angle round the entry's middle on the circle r out from the field's middle: where the
// circle crosses the mouth's face, or nearer the desert a side (0 short of the face).
ga_yard_cut :: (g: [] SpGame, r: f32) -> f32 {
  f := ga_yard_z(g);
  if r <= f { return 0; }
  a := atan2(sqrt(r * r - f * f), f);
  if r > GA_YARD_X { a = lo(a, atan2(GA_YARD_X, sqrt(r * r - GA_YARD_X * GA_YARD_X))); }
  return a;
}
// The outer shell's top at (x, z) as it is drawn (buildings.coax bl_course): a course's tread from the
// rim's edge down to the desert, 0 off it, in the entry's cut, over the yard, and over the hallway and
// the lab (the mountain's, with their own walls and roofs).
ga_shell_y :: (g: [] SpGame, x: f32, z: f32) -> f32 {
  dx := x - g[0].at.gar_x; dz := z - g[0].at.gar_z; d := sqrt(dx * dx + dz * dz); ro := ga_shell_in(g);
  if d < ro || d >= ga_foot(g) || ga_in_yard(g, x, z, 0) { return 0; }
  if dz < 1 - ga_back(g) && abs(dx) < GA_LAB_X + 8 { return 0; }
  if abs(atan2(dx, dz) - ga_angle(GA_ENTRY)) < GA_DOOR / ro { return 0; }
  run := GA_BERM / cast(f32) BL_COURSES;
  return GA_RIM - GA_RIM / cast(f32) BL_COURSES * cast(f32) clamp_i(cast(int) floor((d - ro) / run), 0, BL_COURSES - 1);
}
// The highest the shell stands within r of (x, z), for the camera: its top there and r to each side.
ga_shell_near :: (g: [] SpGame, x: f32, z: f32, r: f32) -> f32 {
  return hi(hi(ga_shell_y(g, x, z), hi(ga_shell_y(g, x - r, z), ga_shell_y(g, x + r, z))), hi(ga_shell_y(g, x, z - r), ga_shell_y(g, x, z + r)));
}
// Whether (x, z) is in the mountain: the hallway past the back wall, or the old-world lab past it.
// Indoors, lit white whatever the time of day.
ga_in_lab :: (g: [] SpGame, x: f32, z: f32) -> bool {
  back := g[0].at.gar_z - ga_back(g); end := back - GA_HALL_LONG;
  return z < back - GA_BACK && z > end - GA_LAB_Z && abs(x - g[0].at.gar_x) < GA_LAB_X;
}
// The point r metres from the field's middle at angle a, y up.
ga_pt :: (g: [] SpGame, a: f32, r: f32, y: f32) -> Point { return v3(g[0].at.gar_x + sin(a) * r, y, g[0].at.gar_z + cos(a) * r); }
// Where in section k a thing stands `r` metres out (its middle line).
ga_at :: (g: [] SpGame, k: int, r: f32) -> Point { return ga_pt(g, ga_angle(k), r, 0); }
// A bay's middle.
ga_bay_at :: (g: [] SpGame, k: int) -> Point { return ga_at(g, k, g[0].at.gar_r + GA_BAY * 0.5); }
// The section's name: A1, A2, AB, B1, B2, BC, ... H1, H2, HA.
// The sections' names, A1 at 6 o'clock and on round past 3 o'clock (C1): the letters are not fixed yet,
// so they live here and nowhere else.
GA_NAMES :: [GA_SECTIONS] string.["A1", "A2", "AB", "B1", "B2", "BC", "C1", "C2", "CD", "D1", "D2", "DE", "E1", "E2", "EF", "F1", "F2", "FG", "G1", "G2", "GH", "H1", "H2", "HA"];
ga_name :: (k: int, out: [] u8) -> string { return ifx k < 0 || k >= GA_SECTIONS then "" else GA_NAMES[k]; }
// The section a point is in, by its angle round the field (0 to 23), and how far out it is.
ga_section_of :: (g: [] SpGame, x: f32, z: f32) -> int {
  a := atan2(x - g[0].at.gar_x, z - g[0].at.gar_z) + ga_span() * 0.5;
  while a < 0 { a += TAU; } while a >= TAU { a -= TAU; }
  return clamp_i(cast(int) floor(a / ga_span()), 0, GA_SECTIONS - 1);
}
ga_reach :: (g: [] SpGame, x: f32, z: f32) -> f32 { return dist2(x, z, g[0].at.gar_x, g[0].at.gar_z); }
// The bay you stand in (its section), or -1 on the field or outside the garage.
ga_in_bay :: (g: [] SpGame, x: f32, z: f32) -> int {
  r := ga_reach(g, x, z);
  if r < g[0].at.gar_r || r > ga_back(g) { return -1; }
  return ga_section_of(g, x, z);
}
// Whether (x, z) is on the field or in a bay: inside the garage.
ga_inside :: (g: [] SpGame, x: f32, z: f32) -> bool { return ga_reach(g, x, z) <= ga_back(g); }
// The gap in section k's back wall (half its width in metres; 0 for none): the entry's tunnel, the hallway.
ga_gap :: (k: int) -> f32 { return ifx k == GA_ENTRY then GA_DOOR else ifx k == GA_HALLWAY then GA_HALL else 0.0f32; }
clamp_i :: (v: int, a: int, b: int) -> int { return ifx v < a then a else ifx v > b then b else v; }

// ---- the colliders
GA_ROW :: 1000;   // a pier's row in the World: GA_ROW + 3k to + 3k + 2, its three parts (the pier after section k)
// A passage through each pier near the back wall, so the bays join up all the way round: the night's
// long way back runs through them, under the roofs, out of the rave's sight (#13552).
GA_PASS :: 1.7f32;          // m: half the passage's width
GA_PASS_H :: 3.6f32;        // m: its lintel
ga_pass_r :: (g: [] SpGame) -> f32 { return ga_back(g) - 7; }   // its middle, out from the field's middle
// A stadium from a to b, `half` thick, `tall` high: a wall the walking rules push you out of.
ga_wall :: (g: [] SpGame, row: int, ax: f32, az: f32, bx: f32, bz: f32, half: f32, tall: f32) {
  dx := bx - ax; dz := bz - az; l := sqrt(dx * dx + dz * dz) * 0.5;
  if l < 0.01 { return; }
  _ := sl_round(g, SK_WALL, row, (ax + bx) * 0.5, 0, (az + bz) * 0.5, atan2(dx, dz), SH_ALONG_Z, half, l, tall);
}
// The piers between the bays, each from the field's edge to the back wall in two halves (so no part
// reaches further than a cell's half diagonal): World entities, so an edit can't stand a piece in one.
ga_colliders :: (g: [] SpGame) {
  rf := g[0].at.gar_r; rb := ga_back(g); h := ga_span() * 0.5;
  for k: 0..<GA_SECTIONS {
    // each part a stadium whose round ends reach GA_PIER past its line: the field's edge, and the passage's two sides
    b := ga_angle(k) + h; r0 := ga_pass_r(g) - GA_PASS - GA_PIER; mid := (rf + GA_PIER + r0) * 0.5;
    p0 := ga_pt(g, b, rf + GA_PIER, 0); p1 := ga_pt(g, b, mid, 0); p2 := ga_pt(g, b, r0, 0); p3 := ga_pt(g, b, ga_pass_r(g) + GA_PASS + GA_PIER, 0); p4 := ga_pt(g, b, rb, 0);
    ga_wall(g, GA_ROW + k * 3, p0.x, p0.z, p1.x, p1.z, GA_PIER, GA_ROOF);
    ga_wall(g, GA_ROW + k * 3 + 1, p1.x, p1.z, p2.x, p2.z, GA_PIER, GA_ROOF);
    ga_wall(g, GA_ROW + k * 3 + 2, p3.x, p3.z, p4.x, p4.z, GA_PIER, GA_ROOF);
  }
}
// The back wall behind the bays is round: a body of radius r inside the garage stays r in front of it,
// except through the entry's tunnel and the hallway, which open in it. (x, z) as pushed back in.
ga_push :: (g: [] SpGame, x: f32, z: f32, r: f32) -> Point {
  dx := x - g[0].at.gar_x; dz := z - g[0].at.gar_z; d := sqrt(dx * dx + dz * dz);
  edge := ga_back(g) - r;
  if d <= edge || d > ga_back(g) + GA_BACK * 2 + r { return v3(x, 0, z); }
  k := ga_section_of(g, x, z);
  if ga_gap(k) > 0 {
    // across the section's middle line: within the gap, less the body, you go on through
    a := ga_angle(k); side := dx * cos(a) - dz * sin(a);
    if abs(side) <= ga_gap(k) - r { return v3(x, 0, z); }
  }
  return v3(g[0].at.gar_x + dx / d * edge, 0, g[0].at.gar_z + dz / d * edge);
}
// Whether a footprint reaching r round (x, z) is in the rock round the garage: past the back wall in
// the berm, outside the entry's mouth (north of the ring, its own walls) and the hallway and the lab
// (south of it, theirs). A piece is not set there (layer.coax).
ga_rock :: (g: [] SpGame, x: f32, z: f32, r: f32) -> bool {
  dx := x - g[0].at.gar_x; dz := z - g[0].at.gar_z; d := sqrt(dx * dx + dz * dz);
  back := ga_back(g); ax := abs(x - g[0].at.gar_x);
  if z < g[0].at.gar_z - back - GA_HALL_LONG && ax < GA_LAB_X + r { c := ga_lab_mid(g); return dist2(x, z, c.x, c.z) > GA_LAB_R - r; }   // the round lab, and the rock round it
  if d <= back - r || d >= back + GA_BERM { return false; }
  if z > g[0].at.gar_z + back - r { return false; }                                  // the tunnel and the mine mouth
  if z < g[0].at.gar_z - back + r && ax < GA_HALL { return false; }                  // the hallway
  return true;
}
// The hallway into the mountain and the lab past it: walls as the layout's boxes (g_wall).
ga_layout :: (g: [] SpGame) {
  back := g[0].at.gar_z - ga_back(g);            // the back wall's z, straight across from the entry
  end := back - GA_HALL_LONG;                     // where the hallway opens into the lab
  g_wall(g, -GA_HALL - 10, -GA_HALL, end, back + 1.5, 16);
  g_wall(g, GA_HALL, GA_HALL + 10, end, back + 1.5, 16);
  g_wall(g, -GA_LAB_X - 8, -GA_HALL, end, end + 2, 12); g_wall(g, GA_HALL, GA_LAB_X + 8, end, end + 2, 12);   // the rock either side of the hallway, behind the lab's round wall (ga_lab_push)
  g_wall(g, -GA_LAB_X - 8, -GA_LAB_X, end - GA_LAB_Z, end, 12); g_wall(g, GA_LAB_X, GA_LAB_X + 8, end - GA_LAB_Z, end, 12);
  g_wall(g, -GA_LAB_X - 8, GA_LAB_X + 8, end - GA_LAB_Z - 6, end - GA_LAB_Z, 12);
}

// ---- the triangles
// Colours: the pit's concrete and rust, the raiders' yellow, the Empire's white.
GA_CONCRETE :: () -> KitTint { return kit_tint(0.56, 0.56, 0.55); }   // poured grey concrete, not canyon rock (#13505)
GA_RUST :: () -> KitTint { return kit_tint(0.15, 0.15, 0.16); }     // black-stained concrete
GA_DIRT :: () -> KitTint { return kit_tint(0.86, 0.66, 0.48); }
GA_YELLOW :: () -> KitTint { return kit_tint(0.96, 0.76, 0.16); }
GA_DARK :: () -> KitTint { return kit_tint(0.10, 0.08, 0.08); }
GA_PANEL :: () -> KitTint { return kit_tint(0.93, 0.90, 0.84); }
GA_LETTER :: () -> KitTint { return kit_tint(0.78, 0.16, 0.12); }
// A strip between two arcs round the field, from angle a0 to a1 in `steps` quads: (r0, y0) to (r1, y1).
// Its face points up, or toward the field for a wall (out from the field for a slope going down and
// out); `under` turns it the other way (a roof's underside, a wall's back).
ga_strip :: (g: [] SpGame, buf: [] u32, p: [] Pen, a0: f32, a1: f32, r0: f32, y0: f32, r1: f32, y1: f32, steps: int, under: bool) {
  for i: 0..<steps {
    s0 := a0 + (a1 - a0) * cast(f32) i / cast(f32) steps; s1 := a0 + (a1 - a0) * cast(f32) (i + 1) / cast(f32) steps;
    A0 := ga_pt(g, s0, r0, y0); A1 := ga_pt(g, s1, r0, y0); B1 := ga_pt(g, s1, r1, y1); B0 := ga_pt(g, s0, r1, y1);
    if under { quad(buf, p, A0, A1, B1, B0); } else { quad(buf, p, A0, B0, B1, A1); }
  }
}
// How far out the face of a strip ga_strip drew at radius r stands at angle a. Its quads are chords, so
// between their corners they stand inside the arc: by r (1 - cos(half a quad's angle)), 15 cm at the
// middle of a back wall's quad. Anything set on a curved wall is measured from this, not from r.
ga_face :: (a0: f32, a1: f32, r: f32, steps: int, a: f32) -> f32 {
  w := (a1 - a0) / cast(f32) steps;
  i := clamp_i(cast(int) floor((a - a0) / w), 0, steps - 1);
  return r * cos(w * 0.5) / cos(a - (a0 + w * (cast(f32) i + 0.5)));
}
// A thing on a wall stands this far off the wall's face. The depth buffer's step grows with the square of
// the distance, about 6 cm across the field (300 m); nearer than this, the two faces fight from the far
// side and the wall shows through the thing in crawling hatches (the bay mouths did, 5 cm off).
GA_OFF_WALL :: 0.25f32;
// A box standing on the ground in the ring's frame: at angle a, r out, turned to face the field.
ga_frame :: (g: [] SpGame, a: f32, r: f32, y: f32) -> Frame { return frame_at(ga_pt(g, a, r, y), a + PI); }
ga_draw :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  rf := g[0].at.gar_r; rb := ga_back(g); h := ga_span() * 0.5;
  // the field: packed dirt, with the rings the mechs' tracks have worn into it
  kit_pen(p, 200, MAT_WORLD, GA_DIRT());
  ga_strip(g, buf, p, 0, TAU, 0, 0.01, rf + 0.5, 0.01, 72, false);
  kit_pen(p, 201, MAT_WORLD, kit_tint(0.76, 0.56, 0.42));
  for i: 0..<3 { r := rf * (0.3 + cast(f32) i * 0.24); ga_strip(g, buf, p, 0, TAU, r, 0.015, r + 1.2, 0.015, 72, false); }
  // the centre: a purple circle in the middle of the rave floor
  kit_pen(p, 199, MAT_FLAT, kit_tint(0.56, 0.42, 0.66));
  ga_strip(g, buf, p, 0, TAU, 0, 0.02, GA_CENTRE, 0.02, 48, false);
  name: [2] u8;
  for k: 0..<GA_SECTIONS {
    a := ga_angle(k); a0 := a - h; a1 := a + h;
    gap := ga_gap(k) / rb;
    bay := ks_begin(p);   // the bay, to the pier after it: the kit slot garage_bay (kits.coax)
    // the bay's floor, its back wall (around the gap, if any) and the way out at its back
    kit_pen(p, 202, MAT_WORLD, GA_CONCRETE());
    ga_strip(g, buf, p, a0, a1, rf, 0.012, rb, 0.012, 3, false);
    kit_pen(p, 203 + k % 2, MAT_WORLD, ifx k % 3 == 1 then GA_RUST() else kit_tint(0.46, 0.46, 0.46));
    if gap > 0 {
      ga_strip(g, buf, p, a0, a - gap, rb, 0, rb, GA_ROOF, 2, false); ga_strip(g, buf, p, a + gap, a1, rb, 0, rb, GA_ROOF, 2, false);
      ga_strip(g, buf, p, a - gap, a + gap, rb, GA_ROOF - 3, rb, GA_ROOF, 1, false);   // the lintel over the opening
    } else {
      ga_strip(g, buf, p, a0, a1, rb, 0, rb, GA_ROOF, 3, false);
      // its old way outside, shut: a grey roll-up door in the back wall, from inside the wall to GA_OFF_WALL
      // off its face, so only the two real openings (the entry and the hallway) are dark (#13552)
      face := ga_face(a0, a1, rb, 3, a) - GA_OFF_WALL;
      kit_pen(p, 205, MAT_FLAT, kit_tint(0.42, 0.42, 0.44));
      box(buf, p, ga_frame(g, a, (face + rb) * 0.5, 3.2), 3.0, 3.2, (rb - face) * 0.5);
      kit_pen(p, 206, MAT_FLAT, GA_YELLOW());
      box(buf, p, ga_frame(g, a, (face - 0.1 + rb) * 0.5, 6.6), 3.4, 0.25, (rb - face + 0.1) * 0.5);
    }
    // the roof's slab, its underside, and the yellow and black band along its edge
    kit_pen(p, 207, MAT_WORLD, kit_tint(0.40, 0.40, 0.41));
    ga_strip(g, buf, p, a0, a1, rf - 0.6, GA_ROOF + GA_LEDGE, rb + GA_BACK, GA_ROOF + GA_LEDGE, 3, false);
    ga_strip(g, buf, p, a0, a1, rf - 0.6, GA_ROOF, rb, GA_ROOF, 3, true);
    for j: 0..<12 {
      kit_pen(p, 208 + j % 2, MAT_FLAT, ifx j % 2 == 0 then GA_YELLOW() else GA_DARK());
      ga_strip(g, buf, p, a0 + (a1 - a0) * cast(f32) j / 12, a0 + (a1 - a0) * cast(f32) (j + 1) / 12, rf - 0.6, GA_ROOF, rf - 0.6, GA_ROOF + GA_LEDGE, 1, false);
    }
    // two lamps under the roof
    kit_pen(p, 210, MAT_GLOW, kit_tint(1.0, 0.82, 0.48));
    for j: 0..<2 { o := ifx j == 0 then -0.45f32 else 0.45f32; c := ga_pt(g, a + h * o, rf + GA_BAY * 0.45, GA_ROOF - 0.4); block(buf, p, c.x, c.y, c.z, 1.6, 0.25, 0.4); }
    // the pier after it: a buttress from the floor to the rim, wider at its foot
    b := a1; pf := ga_frame(g, b, rf + GA_BAY * 0.5, 0);
    kit_pen(p, 211, MAT_WORLD, GA_CONCRETE());
    pr := ga_pass_r(g); i0 := rf - 1.5; i1 := pr - GA_PASS; o1 := rb + 1.5;
    box(buf, p, frame_move(pf, ga_pt(g, b, (i0 + i1) * 0.5, GA_ROOF * 0.5 + 1)), GA_PIER, GA_ROOF * 0.5 + 1, (i1 - i0) * 0.5);
    box(buf, p, frame_move(pf, ga_pt(g, b, (pr + GA_PASS + o1) * 0.5, GA_ROOF * 0.5 + 1)), GA_PIER, GA_ROOF * 0.5 + 1, (o1 - pr - GA_PASS) * 0.5);
    box(buf, p, frame_move(pf, ga_pt(g, b, pr, (GA_PASS_H + GA_ROOF + 2) * 0.5)), GA_PIER, (GA_ROOF + 2 - GA_PASS_H) * 0.5, GA_PASS);
    kit_pen(p, 212, MAT_FLAT, GA_YELLOW());
    box(buf, p, frame_move(pf, ga_pt(g, b, rf - 1.55, 1.2)), GA_PIER + 0.1, 1.2, 0.1);   // on the pier's face to the field
    ks_end(g, KS_GARAGE_BAY, p, bay);
    // the rim's wall over the bays, set back, with the section's letters on a white panel
    kit_pen(p, 213 + k % 2, MAT_WORLD, ifx k % 4 == 1 then GA_RUST() else kit_tint(0.50, 0.50, 0.50));
    ga_strip(g, buf, p, a0, a1, rf + GA_SET, GA_ROOF + GA_LEDGE, rf + GA_SET, GA_RIM, 3, false);
    kit_pen(p, 215, MAT_FLAT, GA_PANEL());
    box(buf, p, ga_frame(g, a, rf + GA_SET - 0.2, 18.5), 6.5, 4.2, 0.2);
    kit_stencil(buf, p, ga_frame(g, a, rf + GA_SET - 0.45, 15.8), ga_name(k, name[..]), 5.4, 0.12, 216, GA_LETTER());
    // the rim: its walk, a post with a lamp at each pier, and the long slope down to the desert outside
    // at the entry (A1) the rim and its slope are cut open down to the desert: the way in you see from outside
    ro := ga_shell_in(g); cut := ifx k == GA_ENTRY then GA_DOOR / ro else 0.0f32;
    kit_pen(p, 217, MAT_WORLD, kit_tint(0.36, 0.36, 0.37));
    if cut > 0 { ga_strip(g, buf, p, a0, a - cut, rf + GA_SET, GA_RIM, ro, GA_RIM, 2, false); ga_strip(g, buf, p, a + cut, a1, rf + GA_SET, GA_RIM, ro, GA_RIM, 2, false); }
    else { ga_strip(g, buf, p, a0, a1, rf + GA_SET, GA_RIM, ro, GA_RIM, 3, false); }
    bl_shell(g, buf, p, k, a0, a1, ro);   // the outer shell down to the desert, printed, and the entry's bay (buildings.coax)
    kit_pen(p, 219, MAT_CLOTH, GA_DARK());
    tube(buf, p, frame_at(ga_pt(g, a1, rf + GA_SET + 0.6, GA_RIM), 0), 4.0, 0.12, 0.12, 0.1, 0.1, 5, true);
    kit_pen(p, 220, MAT_GLOW, kit_tint(1.0, 0.86, 0.50));
    ball(buf, p, ga_pt(g, a1, rf + GA_SET + 0.6, GA_RIM + 4.2), 0.4, 6);
  }
  // the hallway into the mountain, past section E1: the white lab's own walls, unlit by the sky, so neither dusk nor night tints them
  back := g[0].at.gar_z - rb; end := back - GA_HALL_LONG;
  kit_pen(p, 221, MAT_FLAT, kit_tint(0.90, 0.90, 0.88));
  // in front of the rock's face and its bands (the layout's walls, which g_world draws purple in the same place):
  // level with it the rock won the depth test and the hallway showed lavender from the lab's mouth
  w := GA_HALL + 5 - GA_ROCK_SKIN;
  block(buf, p, -w, 0, (back + end + 1) * 0.5, 5, 12, (GA_HALL_LONG + 1) * 0.5); block(buf, p, w, 0, (back + end + 1) * 0.5, 5, 12, (GA_HALL_LONG + 1) * 0.5);
  block(buf, p, 0, 10, (back + end) * 0.5, GA_HALL + 0.1, 4, GA_HALL_LONG * 0.5);
  ga_draw_lab(g, buf, p);
}
// The old-world lab (#13552): a round white room, the hallway coming in at its south. Its floor, its
// round wall in GA_LAB_SIDES pieces (none at the mouth) and its ceiling; round the wall, four old machines
// with the past's light-blue glow, and over the mouth a glowing band, the only blue but the boss's.
ga_draw_lab :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  c := ga_lab_mid(g); r := GA_LAB_R; da := TAU / cast(f32) GA_LAB_SIDES; up := v3(0, 1, 0); dn := v3(0, -1, 0);
  kit_pen(p, 222, MAT_FLOOR, kit_tint(0.90, 0.92, 0.94));
  for i: 0..<GA_LAB_SIDES { a := cast(f32) i * da; tri(buf, p, v3(c.x, 0.02, c.z), ga_round(c, a - da * 0.5, r + 1, 0.02), ga_round(c, a + da * 0.5, r + 1, 0.02), up, up, up); }
  kit_pen(p, 223, MAT_FLAT, kit_tint(0.94, 0.95, 0.96));
  half := (r + 1) * tan(da * 0.5) + 0.05;
  // in from the rock's square round it, which meets the round wall at its east, north and west and showed lavender there
  for i: 1..<GA_LAB_SIDES { a := cast(f32) i * da; box(buf, p, frame_at(ga_round(c, a, r + 0.5 - GA_ROCK_SKIN, GA_LAB_TALL * 0.5), a), half, GA_LAB_TALL * 0.5, 0.5); }
  kit_pen(p, 224, MAT_FLAT, kit_tint(0.86, 0.88, 0.90));
  for i: 0..<GA_LAB_SIDES { a := cast(f32) i * da; tri(buf, p, v3(c.x, GA_LAB_TALL, c.z), ga_round(c, a + da * 0.5, r + 1, GA_LAB_TALL), ga_round(c, a - da * 0.5, r + 1, GA_LAB_TALL), dn, dn, dn); }
  block(buf, p, c.x, GA_LAB_TALL, c.z + r, GA_HALL + 0.5, 3, 1);   // the lintel over the mouth
  // the old machines, white, each with a glowing screen toward the room: NE, NW, SW and SE
  for i: 0..<4 {
    a := PI * 0.25 + cast(f32) i * PI * 0.5; f := frame_at(ga_round(c, a, r - 2.2, 0), a);
    kit_pen(p, 226, MAT_FLAT, kit_tint(0.96, 0.97, 0.98)); box(buf, p, frame_move(f, fp(f, 0, 0.7, 0)), 1.8, 0.7, 1.1); box(buf, p, frame_move(f, fp(f, 0, 2.0, 0.6)), 1.6, 0.6, 0.4);
    kit_pen(p, 225, MAT_GLOW, GLOW()); box(buf, p, frame_move(f, fp(f, 0, 2.0, 0.18)), 1.3, 0.42, 0.04);
  }
  kit_pen(p, 225, MAT_GLOW, GLOW());
  block(buf, p, c.x, GA_LAB_TALL - 1.6, c.z + r - 0.1, GA_HALL + 0.3, 0.12, 0.08);
}

// The lamps of the three bays nearest you, into the light slots 2, 3 and 5 (g_lights); in the lab, its
// white ceiling lights in the same slots.
ga_lights :: (g: [] SpGame, l: [] f32) {
  if ga_in_lab(g, g[0].px, g[0].pz) {
    c := ga_lab_mid(g);
    slots := [3] int.[2, 3, 5];
    for i: 0..<3 { light_put(l, slots[i], v3(c.x, GA_LAB_TALL - 0.8, c.z + GA_LAB_R * 0.6 * cast(f32) (1 - i)), 22, 1.0, 1.0, 1.0, 1.1); }
    return;
  }
  if !ga_inside(g, g[0].px, g[0].pz) { return; }
  k := ga_section_of(g, g[0].px, g[0].pz);
  slots := [3] int.[2, 3, 5];
  for i: 0..<3 {
    s := (k + i - 1 + GA_SECTIONS) % GA_SECTIONS;
    c := ga_at(g, s, g[0].at.gar_r + GA_BAY * 0.45);
    light_put(l, slots[i], v3(c.x, GA_ROOF - 1.2, c.z), 16, 1.0, 0.80, 0.45, 1.2);
  }
}
// Stand at the mouth of section k's bay, looking in (for the stills of a moment, g_stage).
ga_look_into :: (g: [] SpGame, k: int) {
  c := ga_at(g, k, g[0].at.gar_r - 6);
  g[0].px = c.x; g[0].pz = c.z; g[0].yaw = ga_angle(k); g[0].pitch = 0;
}

#test "a thing on the garage's curved back wall stands GA_OFF_WALL off the wall as drawn, not off its arc: the bay mouths' wall showed through them in crawling hatches from across the field" {
  rb := GA_R + GA_BAY; h := ga_span() * 0.5;
  // a quad's corner is on the arc; its middle is inside it by r (1 - cos(half its angle)), 15 cm here
  #assert abs(ga_face(-h, h, rb, 3, -h) - rb) < 0.001 && abs(ga_face(-h, h, rb, 3, h / 3) - rb) < 0.001;
  sag := rb - ga_face(-h, h, rb, 3, 0);
  #assert sag > 0.14 && sag < 0.16 && abs(sag - rb * (1 - cos(h / 3))) < 0.001;
  // the mouth stands off the wall by more than the depth buffer's step across the field (about 6 cm)
  #assert GA_OFF_WALL >= 0.2;
}
#test "the boss lab is round with the hallway at its south, the boss in its middle facing east, its tail sweep over the north half, and every weak point in reach" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 34);
  t := g[0].bt[..]; c := ga_lab_mid(g[..]);
  // the boss's home is the lab's middle, and it faces east (+x)
  #assert abs(c.x - g[0].at.boss_x) < 0.01 && abs(c.z - g[0].at.boss_z) < 0.01 && t[0].dino_yaw == SB_BOSS_FACE;
  // the round wall: a walker going north, east or west stops GA_LAB_R in; through the mouth at the south it walks on
  for a: [3] f32.[PI, PI * 0.5, PI * 1.5] {
    q := ga_lab_push(g[..], c.x + sin(a) * (GA_LAB_R + 0.5), c.z + cos(a) * (GA_LAB_R + 0.5), T_RADIUS);
    #assert abs(dist2(q.x, q.z, c.x, c.z) - (GA_LAB_R - T_RADIUS)) < 0.01;
  }
  m := ga_lab_push(g[..], c.x + 1, ga_lab_mouth(g[..]) + 0.5, T_RADIUS); #assert m.x == c.x + 1 && m.z == ga_lab_mouth(g[..]) + 0.5;
  inside := ga_lab_push(g[..], c.x + 5, c.z - 5, T_RADIUS); #assert inside.x == c.x + 5 && inside.z == c.z - 5;
  // halfway through its sweep the tail is due north of it (-z); its flank weak point is on that side
  g[0].boss_t = T_SWEEP_EVERY + T_SWEEP_TIME * 0.5; a := sb_arm_angle(g[..]);
  #assert abs(sin(a)) < 0.01 && cos(a) < -0.99 && sb_weak_at(g[..], 1).z < c.z - 1;
  // F reaches each weak point from where its collider (its body's round, its tail's stadium) holds a walker off it
  for i: 0..<3 {
    w := sb_weak_at(g[..], i); g[0].px = w.x + 0.01; g[0].pz = w.z + 0.01; g_collide(g[..]);
    #assert sb_boss_gap(g[..], g[0].px, g[0].pz, false) >= T_RADIUS - 0.001 && dist2(g[0].px, g[0].pz, w.x, w.z) < T_STUN_RANGE;
  }
  // the boss stands in the lab with room round it, and is bigger than the drill mech
  #assert SB_BOSS_R + SB_BOSS_LONG * 0.5 < GA_LAB_R && SB_BOSS_TALL > SB_MECH_TOP;
  // phase one: moved off its spot, it walks back and turns east again
  g_stage(g[..], 35); t[0].dino_x = c.x + 1; t[0].dino_yaw = 0; g[0].boss_t = 0;
  for i: 0..<300 { t[0].think = 10; t[0].idle = 0; g_step(g[..], 0.02); }   // neither side's cards: no hits, no stuns
  #assert dist2(t[0].dino_x, t[0].dino_z, c.x, c.z) < 0.06 && abs(t[0].dino_yaw - SB_BOSS_FACE) < 0.01;
}
