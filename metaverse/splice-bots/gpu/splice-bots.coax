// Splice's shaders (splice-bots.coax, docs/metaverse/art-styles.md, Anime): the same anime scene, ink and
// post pass as Anime Lab, so this file loads Anime Lab's. build.sh writes apps/openagents-web/splice-bots.wgsl
// from it with coax/web/wgsl-module.coax (splice-bots.module and splice-bots.bindings: Anime Lab's bindings and the
// edit layer's two stores).
// No WGSL is written by hand.
//
// Two things are Splice's own: the placed pieces' instances (shadow_vs, scene_vs, below) and the overlay (fx_fs). Anime Lab's overlay is light on dark (its blend
// keeps the brighter colour). Splice's interface is ink on cream paper, so its overlay writes
// straight alpha and the page asks the host for source-over blending (coaxial_fx_alpha_v1):
// a stroke is a solid shape with no glow, and text takes its ink's colour in one of two faces.
#load "../../../apps/openagents-web/gpu/animelab.coax";
#load "../../../metaverse-engine/render/graybox.coax";

// Graybox (the G key; splice-bots.coax sets a speed below zero): grays, with orange, yellow and cyan kept.
// The meshes are already gray (Pen.graybox); this takes the sky, the tinted light and the interface.
sp_gray_on :: (u:[]f32)->bool {return u[AL_FX+2]<(-0.5f32);}
sp_gray :: (c:V3,warm:f32,cyan:f32)->V3 {
  k:f32=graybox_keep(c.x,c.y,c.z,warm,cyan);
  g:f32=graybox_gray(c.x,c.y,c.z);
  return v3(mix(g,c.x,k),mix(g,c.y,k),mix(g,c.z,k));
}
// ---- the edit layer's placed pieces (metaverse/splice-bots/layer-draw.coax): a retained scene. Each kind
// of piece's mesh is written once into `pieces`, standing at the origin; a placed piece is a row
// of `places` (x, y, z, 0, cos turn, sin turn, 0, 0). Instance 0 draws the world's store and
// instance 1 the live store, as Anime Lab's stages do; instance 2 + r draws the piece store
// through row r. An edit changes rows only.
sp_row :: (instance:u32)->u32 {return mul_wrap(sub_wrap(instance,cast(u32)2),cast(u32)8);}
// A point or a direction of the mesh, turned about y by the row's turn.
sp_turn :: (p:V3,r:u32,places:[]u32)->V3 {
  c:f32=al_word(add_wrap(r,cast(u32)4),places);
  s:f32=al_word(add_wrap(r,cast(u32)5),places);
  return v3((p.x*c)+(p.z*s),p.y,(p.z*c)-(p.x*s));
}
// A row's squash (word 3: y by 1 - k, across by 1 + k/2) and lean (words 6 and 7: sheared by height),
// before its turn: the player's landing and turns (feel.coax). Every other row has them 0.
sp_place :: (id:u32,instance:u32,pieces:[]u32,places:[]u32)->V3 {
  b:u32=mul_wrap(id,cast(u32)6);
  r:u32=sp_row(instance);
  p:V3=v3(al_word(b,pieces),al_word(add_wrap(b,cast(u32)1),pieces),al_word(add_wrap(b,cast(u32)2),pieces));
  k:f32=al_word(add_wrap(r,cast(u32)3),places);
  w:f32=1.0f32+(k*0.5f32);
  q:V3=v3((p.x*w)+(p.y*al_word(add_wrap(r,cast(u32)6),places)),p.y*(1.0f32-k),(p.z*w)+(p.y*al_word(add_wrap(r,cast(u32)7),places)));
  t:V3=sp_turn(q,r,places);
  return v3(t.x+al_word(r,places),t.y+al_word(add_wrap(r,cast(u32)1),places),t.z+al_word(add_wrap(r,cast(u32)2),places));
}
shadow_vs :: (id:u32,instance:u32,u:[]f32,world:[]u32,live:[]u32,pieces:[]u32,places:[]u32)->AnimelabShade {
  if (instance<cast(u32)2) {return animelab_shadow_vs(id,instance,u,world,live);}
  o:AnimelabShade;
  mat:u32=pieces[cast(int)add_wrap(mul_wrap(id,cast(u32)6),cast(u32)4)]>>24;
  o.pos=al_rows(u,AL_SHADOW,sp_place(id,instance,pieces,places));
  // glow, flat marks, ink strokes and smoke cast no shadow
  if ((mat==3)||(mat==4)||(mat==7)||(mat==8)||(mat==9)) {
    o.pos=v4(0.0f32,0.0f32,-2.0f32,1.0f32);
  }
  return o;
}
scene_vs :: (id:u32,instance:u32,u:[]f32,world:[]u32,live:[]u32,pieces:[]u32,places:[]u32)->AnimelabS {
  if (instance<cast(u32)2) {return animelab_scene_vs(id,instance,u,world,live);}
  o:AnimelabS;
  b:u32=mul_wrap(id,cast(u32)6);
  n4:V4=wg_unpack4x8unorm(pieces[cast(int)add_wrap(b,cast(u32)3)]);
  c4:V4=wg_unpack4x8unorm(pieces[cast(int)add_wrap(b,cast(u32)4)]);
  w:V3=sp_place(id,instance,pieces,places);
  o.world=w;
  o.pos=al_rows(u,4,w);
  o.normal=sp_turn(v3((n4.x*2.0f32)-1.0f32,(n4.y*2.0f32)-1.0f32,(n4.z*2.0f32)-1.0f32),sp_row(instance),places);
  o.colour=v3(al_decode1(c4.x),al_decode1(c4.y),al_decode1(c4.z));
  o.mat=floor((c4.w*255.0f32)+0.5f32);
  o.obj=floor((n4.w*255.0f32)+0.5f32);
  o.param=f32_from_bits(pieces[cast(int)add_wrap(b,cast(u32)5)]);
  return o;
}

post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_aux:Tex2D,post_depth:TexDepth,post_lin:Sampler)->V4 {
  c:V4=animelab_post_fs(pos,u,post_light,post_quarter,post_eighth,post_aux,post_depth,post_lin);
  if (sp_gray_on(u)) {
    g:V3=sp_gray(v3(c.x,c.y,c.z),0.62f32,0.38f32);
    return v4(g.x,g.y,g.z,1.0f32);
  }
  return c;
}

fx_fs :: (v:AnimelabV,u:[]f32,sans_atlas:Tex2D,sans_sampler:Sampler)->V4 {
  tint:V3=v3(v.tint.x,v.tint.y,v.tint.z);
  if (sp_gray_on(u)) {tint=sp_gray(tint,0.62f32,0.38f32);}
  // text: mode 4 is the reading face (IBM Plex Mono, the atlas's red), mode 5 the title face
  // (Michroma, its green); the page declares both (realms.json ui_font_src, ui_title_font_src)
  if ((v.tint.w>3.5f32)&&(v.tint.w<5.5f32)) {
    lod:f32=st_sat(wg_log2(64.0f32/fmax(v.shape.x,1.0f32))/4.0f32)*4.0f32;
    g:V4=gpu_sample_level(sans_atlas,sans_sampler,v.place,lod);
    face:f32=ifx v.tint.w>4.5f32 then g.y else g.x;
    return v4(tint.x,tint.y,tint.z,pow(face,0.85f32)*fmin(v.shape.z*1.15f32,1.0f32));
  }
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=sqrt((along*along)+(v.place.y*v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
  return v4(tint.x,tint.y,tint.z,core*fmin(v.shape.z,1.0f32));
}
