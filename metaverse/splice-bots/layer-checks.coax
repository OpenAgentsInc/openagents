// The checks of Splice's colliders and edit layer (layer.coax, pieces.coax; GitHub #13404).
// splice-game.coax loads this file with `#load "layer-checks.coax" #test;`.

// The game as a check starts it: in the mine, by the rover, in daylight.
lc_mine :: (g: [] SpGame) { g_stage(g, 5); }

// The walk the game had before its walls were World colliders: a circle pushed out of each box of
// the layout in turn, then the rubble, the boss wall and the banned bot. The oracle the new walk
// is compared with.
lc_old_push :: (q: Point, x0: f32, x1: f32, z0: f32, z1: f32, r: f32) -> Point {
  cx := clamp(q.x, x0, x1); cz := clamp(q.z, z0, z1);
  dx := q.x - cx; dz := q.z - cz; d := sqrt(dx * dx + dz * dz);
  if d >= r { return q; }
  if d > 0.0001 { return v3(cx + dx / d * r, 0, cz + dz / d * r); }
  l := q.x - x0; rr := x1 - q.x; f := q.z - z0; b := z1 - q.z;
  m := lo(lo(l, rr), lo(f, b));
  if m == l { return v3(x0 - r, 0, q.z); }
  if m == rr { return v3(x1 + r, 0, q.z); }
  if m == f { return v3(q.x, 0, z0 - r); }
  return v3(q.x, 0, z1 + r);
}
lc_old_collide :: (g: [] SpGame, x: f32, z: f32) -> Point {
  q := v3(x, 0, z);
  for i: 0..<g[0].wall_n { o := i * 5; q = lc_old_push(q, g[0].walls[o], g[0].walls[o + 1], g[0].walls[o + 2], g[0].walls[o + 3], T_RADIUS); }
  if !g[0].rubble_gone { q = lc_old_push(q, -3, 3, g[0].at.rubble_z - 1, g[0].at.rubble_z + 1, T_RADIUS); }
  if !g[0].wall_gone { q = lc_old_push(q, -4, 4, g[0].at.wall_z - 1, g[0].at.wall_z + 1, T_RADIUS); }
  q = ga_push(g, q.x, q.z, T_RADIUS);   // the garage's round back wall (garage.coax)
  dx := q.x - g[0].at.boss_x; dz := q.z - g[0].at.boss_z; d := sqrt(dx * dx + dz * dz);
  if d < 2.1 && d > 0.001 { q = v3(g[0].at.boss_x + dx / d * 2.1, 0, g[0].at.boss_z + dz / d * 2.1); }
  return q;
}

#test "the walls are World entities: every wall is there, a long one in parts, and none was refused" {
  g := [1] SpGame.[SpGame.{}];
  lc_mine(g[..]);
  w := sl_world(g[..]);
  #assert world_ready(w) && g[0].ws[0].refused == 0 && g[0].wall_n == 24 && g[0].wall_n <= WALLS;
  seen: [WALLS] int; gates := 0; boss := 0; stop := 0; piers := 0;
  for s: 0..<world_high(w) {
    #assert world_at(w, s) != ENTITY_NONE && world_has(w, s, WORLD_TRANSFORM | WORLD_BODY | WORLD_KIND | WORLD_ROW) && !world_has(w, s, WORLD_HEALTH);
    kind := world_i(w, WI_KIND, s); row := world_i(w, WI_ROW, s);
    if kind == SK_WALL && row >= 0 && row < WALLS { seen[row] += 1; }
    if kind == SK_WALL && row >= GA_ROW { piers += 1; }
    if kind == SK_WALL && row < 0 { stop += 1; }
    if kind == SK_RUBBLE || kind == SK_BOSS_WALL { gates += 1; }
    if kind == SK_BOSS { boss += 1; }
    #assert world_f(w, WF_RADIUS, s) <= SL_CELL * 0.71;   // no part reaches further than a cell's half diagonal
  }
  for i: 0..<g[0].wall_n { #assert seen[i] >= 1; }
  #assert seen[0] == 3 && gates == 2 && boss == 1 && stop == 1;   // the mine mouth's 40 m wall in three parts
  #assert piers == GA_SECTIONS * 2;   // the garage's piers, each in two parts (garage.coax)
  #assert world_count(w) > 90 && world_count(w) < SL_CAP - SL_ITEMS && g[0].ws[0].reach < SL_CELL;
}
#test "a step asks the index, not the list: it looks at a few entities of more than ninety" {
  g := [1] SpGame.[SpGame.{}];
  lc_mine(g[..]);
  w := sl_world(g[..]);
  before := w.grid.n[SPATIAL_VISITS];   // the index counts every entity a question looks at
  g[0].px = -3.9; g[0].pz = -6; g_collide(g[..]);
  #assert w.grid.n[SPATIAL_VISITS] - before <= 24 && world_count(w) > 90 && g[0].ws[0].crowded == 0;
}
// Every 2.4 m by 3 m across the mine, the garage's field (not its bays), the hallway and the lab, with the rubble and the boss
// wall shut and then open: the World's walk puts the smuggler where the old list's walk did,
// wherever a step can take a walker (up to 0.6 m into a wall).
#test "the World's walk is the old wall list's walk, to a tenth of a millimetre inside no wall" #steps 2000000000 #traversal 1000000000 {
  g := [1] SpGame.[SpGame.{}];
  lc_mine(g[..]);
  for pass: 0..<2 {
    g[0].rubble_gone = pass == 1; g[0].wall_gone = pass == 1;
    free := 0; pushed := 0;
    for i: 0..<120 { for k: 0..<150 {
      x := -144.2 + cast(f32) i * 2.4; z := -430.3 + cast(f32) k * 3.0;
      ring := dist2(x, z, g[0].at.gar_x, g[0].at.gar_z);
      if ring > g[0].at.gar_r - 2 && ring < ga_back(g[..]) + 2 * GA_BACK + 1 { continue; }   // the bays: their piers are World colliders only
      g[0].px = x; g[0].pz = z; g_collide(g[..]);
      old := lc_old_collide(g[..], x, z);
      moved := dist2(x, z, old.x, old.z);
      if moved > 0.6 { continue; }   // set deeper inside a wall than a step can take a walker
      #assert dist2(g[0].px, g[0].pz, old.x, old.z) < 0.0001;
      if moved == 0 { free += 1; } else { pushed += 1; }
    } }
    #assert free > 6000 && pushed > 60;
  }
}
#test "a placed piece is a collider: it stops the smuggler at its footprint, and not once it is removed" {
  g := [1] SpGame.[SpGame.{}];
  lc_mine(g[..]);
  w := sl_world(g[..]); count := world_count(w);
  e := sl_place(g[..], 117, 2000, 1000, 0);          // a small crate east of the rover: 0.6 m to each side, 0.47 m ahead
  #assert e.ok && e.id == 0 && world_count(w) == count + 1 && g[0].layer[0].rev == 1;
  g[0].px = 20; g[0].pz = 10 + 0.6; g_collide(g[..]);           // from the north: its long side
  #assert abs(g[0].pz - (10 + 0.47 + T_RADIUS)) < 0.001 && g[0].px == 20;
  g[0].px = 20 + 0.8; g[0].pz = 10; g_collide(g[..]);           // from the east: its rounded end
  #assert abs(g[0].px - (20 + 0.6 + T_RADIUS)) < 0.001;
  g[0].px = 20 + 2; g[0].pz = 10; g_collide(g[..]); #assert g[0].px == 22;
  // turned a quarter, its long side faces east
  #assert sl_turn(g[..], 0, 90).ok;
  g[0].px = 20 + 0.6; g[0].pz = 10; g_collide(g[..]);
  #assert abs(g[0].px - (20 + 0.47 + T_RADIUS)) < 0.001;
  #assert sl_remove(g[..], 0).ok && world_count(w) == count;
  g[0].px = 20; g[0].pz = 10; g_collide(g[..]); #assert g[0].px == 20 && g[0].pz == 10;
  g[0].px = 0; g[0].pz = 9;
  // scenery: no hit points, and the party's people and the camera meet only what is tall
  #assert sl_place(g[..], 101, 2000, 1000, 0).ok && sl_inside(g[..], 20, 10, 0.3) && !sl_inside(g[..], 25, 10, 0.3);
  s := world_high(w) - 1; #assert world_i(w, WI_KIND, s) == 101 && !world_has(w, s, WORLD_HEALTH);
}
#test "undo and redo walk the layer's log, and a reset keeps the layer" {
  g := [1] SpGame.[SpGame.{}];
  lc_mine(g[..]);
  w := sl_world(g[..]); count := world_count(w);
  #assert sl_undo(g[..]).v.why == SL_NOTHING && sl_redo(g[..]).v.why == SL_NOTHING;
  a := sl_place(g[..], 117, 2000, 1000, 0); b := sl_place(g[..], 113, 2400, 1000, 45);
  #assert a.ok && b.ok && b.id == 1 && world_count(w) == count + 2;
  #assert sl_move(g[..], 1, 2400, 1200).ok && g[0].layer[0].items[1].z == 12;
  #assert sl_undo(g[..]).ok && g[0].layer[0].items[1].z == 10;
  #assert sl_undo(g[..]).ok && world_count(w) == count + 1 && sl_redo(g[..]).ok && sl_redo(g[..]).ok && g[0].layer[0].items[1].z == 12;
  rev := g[0].layer[0].rev;
  g_reset(g[..]);
  #assert g[0].layer[0].st[0].n == 2 && g[0].layer[0].rev == rev && world_count(sl_world(g[..])) == count + 2 && g[0].mode == M_TITLE;
  // an undo that would put a piece back where you now stand is refused, and nothing changes
  lc_mine(g[..]);
  #assert sl_remove(g[..], 0).ok;
  g[0].px = 20; g[0].pz = 10;
  u := sl_undo(g[..]);
  #assert !u.ok && u.v.why == SL_PLAYER && g[0].layer[0].st[0].n == 1;
  sl_clear(g[..]); #assert g[0].layer[0].st[0].n == 0 && world_count(sl_world(g[..])) == count;
}
#test "an edit is refused past the map's edge, in a kept-clear zone (named), on the player, and inside what stands there" {
  g := [1] SpGame.[SpGame.{}]; o: [160] u8;
  lc_mine(g[..]);
  #assert sl_place(g[..], 999, 2000, 1000, 0).v.why == SL_NO_PIECE;
  #assert sl_place(g[..], 117, 2000, 1000, 181).v.why == SL_TURN && sl_place(g[..], 117, 2000, 1000, -180).v.why == SL_TURN;
  // the edge: outside every area, and half over the mine's
  #assert sl_place(g[..], 117, 17000, 1000, 0).v.why == SL_EDGE && sl_place(g[..], 117, 15980, 1000, 0).v.why == SL_EDGE && sl_place(g[..], 117, -10000, 13600, 0).v.why == SL_EDGE;
  #assert sl_why(g[..], SlVerdict.{why = SL_EDGE}, o[..]).count > 20;
  // a kept-clear zone, by name: the scanner gate's corridor, a pickup's reach, the Digger's lane
  v := sl_place(g[..], 117, 17500, -6700, 0).v;
  #assert v.why == SL_KEPT && sl_why(g[..], v, o[..]) == "in the kept-clear zone 'Scanner gate'";
  v = sl_place(g[..], 117, -1200, 34200, 0).v;
  #assert v.why == SL_KEPT && sl_why(g[..], v, o[..]) == "in the kept-clear zone 'Drill arm'";
  v = sl_place(g[..], 113, 0, 300, 0).v;
  #assert v.why == SL_KEPT && sl_why(g[..], v, o[..]) == "in the kept-clear zone 'Mine mouth lane'";
  // a footprint that only reaches into a zone is refused too; a step further out it stands
  #assert sl_place(g[..], 117, -1200 - 220 - 55, 34200, 0).v.why == SL_KEPT && sl_place(g[..], 117, -1200 - 220 - 65, 34200, 0).ok;
  // on the player
  g[0].px = 20; g[0].pz = 10;
  v = sl_place(g[..], 117, 2050, 1000, 0).v;
  #assert v.why == SL_PLAYER && sl_why(g[..], v, o[..]) == "on top of the player";
  // inside a wall, the rover, another placed piece
  v = sl_place(g[..], 117, -2000, -600, 0).v;
  #assert v.why == SL_COLLIDER && sl_why(g[..], v, o[..]) == "inside a wall or a thing that already stands there";
  #assert sl_place(g[..], 117, 780, 760, 0).v.why == SL_COLLIDER;
  first := sl_place(g[..], 117, 2500, 1500, 0); #assert first.ok;
  v = sl_place(g[..], 117, 2580, 1500, 0).v;
  #assert v.why == SL_COLLIDER && sl_why(g[..], v, o[..]) == "inside the placed piece 1";
  // a move is checked the same way, and a piece does not block its own move
  #assert sl_move(g[..], first.id, 2530, 1500).ok && sl_move(g[..], first.id, 0, 300).v.why == SL_KEPT && sl_move(g[..], 77, 0, 0).v.why == SL_NO_ITEM;
  #assert g[0].layer[0].items[1].x == 25.3;
}
// Two games given the same edits hold the same World, a step at a time; a different edit differs.
#test "the same edits give the same digest at every step, and the digest covers the layer" {
  a := [1] SpGame.[SpGame.{}]; b := [1] SpGame.[SpGame.{}];
  lc_mine(a[..]); lc_mine(b[..]);
  #assert sl_digest(a[..]) == sl_digest(b[..]);
  base := sl_digest(a[..]);
  #assert sl_place(a[..], 117, 2000, 1000, 0).ok; #assert sl_digest(a[..]) != base;
  #assert sl_place(b[..], 117, 2000, 1000, 0).ok; #assert sl_digest(a[..]) == sl_digest(b[..]);
  #assert sl_place(a[..], 103, 2600, 1400, 30).ok && sl_place(b[..], 103, 2600, 1400, 30).ok && sl_digest(a[..]) == sl_digest(b[..]);
  #assert sl_turn(a[..], 1, -60).ok && sl_digest(a[..]) != sl_digest(b[..]);
  #assert sl_turn(b[..], 1, -60).ok && sl_digest(a[..]) == sl_digest(b[..]);
  #assert sl_remove(a[..], 0).ok && sl_remove(b[..], 0).ok && sl_digest(a[..]) == sl_digest(b[..]) && sl_digest(a[..]) != base;
  // a different piece in the same place, and the same piece a centimetre away, are different worlds
  #assert sl_place(a[..], 117, 3000, 1000, 0).ok && sl_place(b[..], 116, 3000, 1000, 0).ok && sl_digest(a[..]) != sl_digest(b[..]);
  was := sl_digest(a[..]);
  #assert sl_move(a[..], 2, 3001, 1000).ok && sl_digest(a[..]) != was && sl_undo(a[..]).ok && sl_digest(a[..]) != was;   // rebuilt: new entities
}
// "No invisible blockers": a row's footprint and height are what its kit piece's triangles measure.
#test "every piece's footprint is the footprint of the triangles it writes" {
  c: [1] SpContent; w: [1] SpMeshScratch;
  #assert sc_load(c[..], SC_SHIPPED);
  for r: 0..<c[0].piece_n {
    p := c[0].pieces[r];
    m := sp_piece_measure(w[..], p.kit, p.scale);
    #assert !m.over && m.n >= 3;
    #assert abs(m.hx - p.hx) <= 0.015 && abs(m.hz - p.hz) <= 0.015 && abs(m.top - p.top) <= 0.015;
  }
}

// A designer adds kinds through the tables: the piece store's share for kinds holds the shipped
// kinds and one more kind of every kit at size 1 (#13485), so a scene of new kinds draws them all
// and the player's walk poses still fit after them.
#test "the piece store holds every shipped kind and one of each kit beside them" #steps 60000000 {
  c: [1] SpContent; w: [1] SpMeshScratch;
  #assert sc_load(c[..], SC_SHIPPED);
  n := 0;
  for r: 0..<c[0].piece_n { n += sp_piece_measure(w[..], c[0].pieces[r].kit, c[0].pieces[r].scale).n; }
  for k: 0..<PK_KITS { n += sp_piece_measure(w[..], k, 1).n; }
  #assert n <= SD_KIND_VERTS && SD_KIND_VERTS * VERTEX_WORDS < SD_PIECE_WORDS;
}

// ---- the layer's draw (layer-draw.coax)
LcDraw :: struct { d: [1] SpLayerDraw; pieces: [SD_PIECE_WORDS] u32; places: [SD_PLACE_WORDS] u32; direct: [PIECE_VERTS * VERTEX_WORDS] u32; draws: [4 * (2 + SC_PIECE_MAX)] u32; }
#test "each kind's mesh is written once, and an edit writes rows only: a kind's instances are one draw" {
  g := [1] SpGame.[SpGame.{}]; b: [1] LcDraw;
  lc_mine(g[..]);
  d := b[0].d[..];
  sd_meshes(d, g[..], b[0].pieces[..], ""); sd_places(d, g[..], b[0].places[..]);
  #assert d[0].mesh_gen == 1 && !d[0].over && d[0].place_gen == 1 && d[0].place_n == 0 && sd_draws(d, g[..], b[0].draws[..], 2) == 2;
  at := 0;
  for r: 0..<g[0].c[0].piece_n { #assert d[0].first[r] == at && d[0].count[r] >= 3 && d[0].count[r] % 3 == 0; at += d[0].count[r]; }
  #assert at == d[0].mesh_n && d[0].mesh_n * VERTEX_WORDS <= SD_PIECE_WORDS;
  // two palms and a rover: the rover's kind comes first in the pieces table, so its row does
  #assert sl_place(g[..], 113, 2000, 1000, 0).ok && sl_place(g[..], 101, 2600, 1400, 90).ok && sl_place(g[..], 113, 2000, 1400, 0).ok;
  sd_meshes(d, g[..], b[0].pieces[..], ""); sd_places(d, g[..], b[0].places[..]);
  #assert d[0].mesh_gen == 1 && d[0].place_gen == 2 && d[0].place_n == 3;
  rover := sc_piece(g[0].c[..], 101); palm := sc_piece(g[0].c[..], 113);
  #assert d[0].row0[rover] == 0 && d[0].rows[rover] == 1 && d[0].row0[palm] == 1 && d[0].rows[palm] == 2;
  n := sd_draws(d, g[..], b[0].draws[..], 2);
  #assert n == 4;
  #assert b[0].draws[8] == cast(u32) d[0].first[rover] && b[0].draws[9] == cast(u32) d[0].count[rover] && b[0].draws[10] == (0x80000000 | 2) && b[0].draws[11] == 1;
  #assert b[0].draws[12] == cast(u32) d[0].first[palm] && b[0].draws[13] == cast(u32) d[0].count[palm] && b[0].draws[14] == (0x80000000 | 3) && b[0].draws[15] == 2;
  #assert f32_from_bits(b[0].places[0]) == 26 && f32_from_bits(b[0].places[2]) == 14 && abs(f32_from_bits(b[0].places[4])) < 0.0001 && abs(f32_from_bits(b[0].places[5]) - 1) < 0.0001;
  #assert f32_from_bits(b[0].places[8]) == 20 && f32_from_bits(b[0].places[10]) == 10 && f32_from_bits(b[0].places[18]) == 14;
  // nothing changed: nothing is written; a move writes the rows; the graybox writes the meshes
  sd_meshes(d, g[..], b[0].pieces[..], ""); sd_places(d, g[..], b[0].places[..]); #assert d[0].mesh_gen == 1 && d[0].place_gen == 2;
  #assert sl_move(g[..], 0, 2050, 1000).ok;
  sd_meshes(d, g[..], b[0].pieces[..], ""); sd_places(d, g[..], b[0].places[..]);
  #assert d[0].mesh_gen == 1 && d[0].place_gen == 3 && f32_from_bits(b[0].places[8]) == 20.5;
  g[0].gray = true; sd_meshes(d, g[..], b[0].pieces[..], ""); #assert d[0].mesh_gen == 2;
  // a layer with more pieces than the place store has rows draws what fits, and no more
  small: [SD_ROW * 2] u32; d[0].place_rev = -1; sd_places(d, g[..], small[..]); #assert d[0].place_n == 2 && d[0].rows[palm] == 1;
}
// An instance is the mesh at the origin put through its row. For a kit piece built wholly on its
// frame (a crate, a dome house) every vertex lands where the kit writes it when it draws the piece
// standing there. A machine's balls and round masts are written unturned by the kits, so an
// instance turns their facets with the piece: the same shape, the same middle.
#test "a placed piece's instance is the piece drawn where it stands" {
  g := [1] SpGame.[SpGame.{}]; b: [1] LcDraw;
  lc_mine(g[..]);
  d := b[0].d[..]; c := g[0].c[..];
  #assert sl_place(g[..], 116, 2600, 1400, 70).ok && sl_place(g[..], 114, 3200, 600, 180).ok && sl_place(g[..], 101, 2000, 1000, -135).ok && sl_place(g[..], 103, 2000, 1600, 45).ok;
  sd_meshes(d, g[..], b[0].pieces[..], ""); sd_places(d, g[..], b[0].places[..]);
  for i: 0..<4 {
    item := g[0].layer[0].items[i]; r := sc_piece(c, item.mesh); p := c[0].pieces[r];
    row := d[0].row0[r];
    pen := [1] Pen.[Pen.{}];
    sp_piece_write(b[0].direct[..], pen[..], p.kit, p.scale, frame_at(v3(item.x, item.y, item.z), item.yaw), PIECE_OBJ, sp_tint(p.a), sp_tint(p.b), sp_tint(p.c), INK());
    #assert pen[0].n == d[0].count[r] && !pen[0].over;
    mx: f32 = 0; my: f32 = 0; mz: f32 = 0; far: f32 = 0;
    for v: 0..<pen[0].n {
      m := (d[0].first[r] + v) * VERTEX_WORDS; o := v * VERTEX_WORDS;
      at := sd_apply(v3(f32_from_bits(b[0].pieces[m]), f32_from_bits(b[0].pieces[m + 1]), f32_from_bits(b[0].pieces[m + 2])), b[0].places[row * SD_ROW..<row * SD_ROW + SD_ROW]);
      dx := at.x - f32_from_bits(b[0].direct[o]); dy := at.y - f32_from_bits(b[0].direct[o + 1]); dz := at.z - f32_from_bits(b[0].direct[o + 2]);
      mx += dx; my += dy; mz += dz; far = hi(far, sqrt(dx * dx + dy * dy + dz * dz));
    }
    n := cast(f32) pen[0].n;
    #assert abs(mx / n) < 0.002 && abs(my / n) < 0.002 && abs(mz / n) < 0.002;
    if i < 2 { #assert far < 0.0001; } else { #assert far < 0.9; }
  }
}
