// How Splice's edit layer is drawn (GitHub #13404; AAA P6.1, a retained scene): each kind of
// piece's cel mesh is written once into the piece store and stays on the GPU, and a placed piece
// is one row of the place store: where it stands and its turn. The page draws a kind's instances
// in one draw (splice-bots.coax, gpu/splice-bots.coax's scene_vs). An edit writes rows; it never writes the
// designed world's store, and it never writes a mesh again.
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax
SD_ROW :: 8;            // words a placed piece: x, y, z, squash, cos turn, sin turn, lean x, lean z (f32 bits; the player's only, else 0)
SD_BASE :: 2;           // a placed piece's instance number is SD_BASE + its row: 0 and 1 are the world's and the live store's
SD_PIECE_WORDS :: (SD_KIND_VERTS + FR_POSES * CW_BUDGET) * VERTEX_WORDS;   // the piece store: every kind's mesh, then the player's walk poses (front.coax)
SD_KIND_VERTS :: 100000;   // the kinds' meshes' share of it: the shipped kinds (the solar farm's and Sniper's room's with them, #13505) and one of each kit at size 1 take about 82,000 vertices (#13485)
SD_PLACE_WORDS :: (SL_ITEMS + 1 + FF_BANKS) * SD_ROW;   // the place store: a row a placed piece, the player's, then the solar farm's field (farm.coax)

SpLayerDraw :: struct {
  first: [SC_PIECE_MAX] int; count: [SC_PIECE_MAX] int;   // each kind's vertices in the piece store, by its row of the pieces table
  mesh_n: int;            // vertices in the piece store
  mesh_gen: int;          // counts the piece store's writes: once, and again when the graybox is switched
  meshed: bool; meshed_gray: bool; over: bool;
  meshed_pack: int;       // the import pack the meshes were written from (pieces.coax SpImports gen)
  row0: [SC_PIECE_MAX] int; rows: [SC_PIECE_MAX] int;     // each kind's rows in the place store
  place_n: int;           // rows in the place store
  place_rev: int = -1;    // the layer revision the rows were written from
  place_shown: int = -1;  // and the count of arrival steps (layer.coax sl_rise): a rising piece's row is written each frame
  place_hid: int = -1;    // and the piece hidden then (drive.coax dv_hidden: the rover that drives you)
  place_gen: int;         // counts the place store's writes
  ff_first: int; ff_count: int;   // the solar farm's bank mesh in the piece store, after the kinds' (farm.coax)
  ff_row0: int; ff_n: int;        // and the field's rows in the place store, after the player's row (0 rows: they did not fit)
}

// Every kind's mesh into the piece store, standing at the origin and facing +z. It writes only
// when nothing is written yet, the graybox was switched or the world's import pack changed.
// pack: the world's import pack ("": none), which a kind whose kit is a pack mesh draws from; a
// mesh the pack does not have draws nothing until it does.
sd_meshes :: (d: [] SpLayerDraw, g: [] SpGame, pieces: [] u32, pack: string) {
  if d[0].meshed && d[0].meshed_gray == g[0].gray && d[0].meshed_pack == g[0].imp[0].gen { return; }
  c := g[0].c[..];
  pen := [1] Pen.[Pen.{graybox = g[0].gray}];
  for r: 0..<c[0].piece_n {
    p := c[0].pieces[r];
    d[0].first[r] = pen[0].n;
    if p.kit == PK_MESH { _ := sp_mesh_write(pieces, pen[..], pack, sc_piece_mesh(c, r), p.scale, PIECE_OBJ + (r % 8) * 8, sp_tint(p.a)); }
    else { sp_piece_write(pieces, pen[..], p.kit, p.scale, frame_at(v3(0, 0, 0), 0), PIECE_OBJ + (r % 8) * 8, sp_tint(p.a), sp_tint(p.b), sp_tint(p.c), INK()); }
    d[0].count[r] = pen[0].n - d[0].first[r];
  }
  d[0].ff_first = pen[0].n; ff_mesh(pieces, pen[..]); d[0].ff_count = pen[0].n - d[0].ff_first;   // the solar farm's bank (farm.coax)
  d[0].mesh_n = pen[0].n; d[0].over = pen[0].over;
  d[0].meshed = true; d[0].meshed_gray = g[0].gray; d[0].meshed_pack = g[0].imp[0].gen; d[0].mesh_gen += 1;
}
// The layer's placed pieces into the place store, a kind's rows together, by item ID within a
// kind. It writes only when the layer's revision is not the one the rows were written from.
sd_places :: (d: [] SpLayerDraw, g: [] SpGame, places: [] u32) {
  hid := dv_hidden(g);
  if d[0].place_rev == g[0].layer[0].rev && d[0].place_shown == g[0].layer[0].shown && d[0].place_hid == hid { return; }
  c := g[0].c[..]; n := 0;
  for r: 0..<c[0].piece_n {
    d[0].row0[r] = n;
    for i: 0..<g[0].layer[0].st[0].n {
      item := g[0].layer[0].items[i];
      if item.mesh != c[0].pieces[r].id || (n + 1) * SD_ROW > places.count { continue; }
      o := n * SD_ROW;
      sunk := ifx item.id == hid then 1000.0f32 else sl_sunk(g, item.id, c[0].pieces[r].top);   // the rover driving you is not also parked
      places[o] = f32_bits(item.x); places[o + 1] = f32_bits(item.y - sunk); places[o + 2] = f32_bits(item.z); places[o + 3] = 0;
      places[o + 4] = f32_bits(cos(item.yaw)); places[o + 5] = f32_bits(sin(item.yaw)); places[o + 6] = 0; places[o + 7] = 0;
      n += 1;
    }
    d[0].rows[r] = n - d[0].row0[r];
  }
  d[0].ff_row0 = n + 1; d[0].ff_n = ff_rows(places, n + 1);   // the field after the player's row (front.coax fr_player writes row n)
  d[0].place_n = n; d[0].place_rev = g[0].layer[0].rev; d[0].place_shown = g[0].layer[0].shown; d[0].place_hid = hid; d[0].place_gen += 1;
}
// The layer's draws into `draws` from record `at` (four words a record: first vertex, vertices,
// the store's flag and the first instance, instances): one for each kind that has a placed piece.
// How many records there are now.
sd_draws :: (d: [] SpLayerDraw, g: [] SpGame, draws: [] u32, at: int) -> int {
  n := at;
  for r: 0..<g[0].c[0].piece_n {
    if d[0].rows[r] == 0 || d[0].count[r] == 0 || (n + 1) * 4 > draws.count { continue; }
    draws[n * 4] = cast(u32) d[0].first[r]; draws[n * 4 + 1] = cast(u32) d[0].count[r];
    draws[n * 4 + 2] = 0x80000000 | cast(u32) (SD_BASE + d[0].row0[r]); draws[n * 4 + 3] = cast(u32) d[0].rows[r];
    n += 1;
  }
  return n;
}
// Where the shader puts a mesh's point for a row of the place store (gpu/splice-bots.coax sp_place has
// the same lines): turned about y, then moved. A piece's own +z is (sin turn, cos turn).
sd_apply :: (p: Point, row: [] u32) -> Point {
  c := f32_from_bits(row[4]); s := f32_from_bits(row[5]);
  // first squashed (y by 1 - k, across by 1 + k/2) and leaned (sheared by height), then turned and moved
  k := f32_from_bits(row[3]); w := 1 + k * 0.5;
  q := v3(p.x * w + p.y * f32_from_bits(row[6]), p.y * (1 - k), p.z * w + p.y * f32_from_bits(row[7]));
  return v3(q.x * c + q.z * s + f32_from_bits(row[0]), q.y + f32_from_bits(row[1]), q.z * c - q.x * s + f32_from_bits(row[2]));
}

// A charger standing within SD_CABLE metres of a rover train is plugged into it (playtest 2): a
// cable runs from the charger's outlet, sags close to the ground, and climbs to the nearest point on
// the train's side. Drawn live, so a charger moved in the editor takes its cable with it.
SD_CABLE :: 4.0f32;
sd_kit_of :: (g: [] SpGame, mesh: int) -> int { r := sc_piece(g[0].c[..], mesh); return ifx r < 0 then -1 else g[0].c[0].pieces[r].kit; }
sd_scale_of :: (g: [] SpGame, mesh: int) -> f32 { r := sc_piece(g[0].c[..], mesh); return ifx r < 0 then 1.0f32 else g[0].c[0].pieces[r].scale; }
sd_cables :: (g: [] SpGame, buf: [] u32, p: [] Pen) -> int {
  n := g[0].layer[0].st[0].n; drawn := 0;
  for i: 0..<n {
    c := g[0].layer[0].items[i];
    if sd_kit_of(g, c.mesh) != PK_CHARGER { continue; }
    cs := sd_scale_of(g, c.mesh);
    a := fp(frame_at(v3(c.x, c.y, c.z), c.yaw), 0.3 * cs, 0.9 * cs, -0.05 * cs);
    for j: 0..<n {
      t := g[0].layer[0].items[j];
      if sd_kit_of(g, t.mesh) != PK_TRAIN { continue; }
      ts := sd_scale_of(g, t.mesh); tf := frame_at(v3(t.x, t.y, t.z), t.yaw);
      long := TRAIN_CAB + cast(f32) TRAIN_CARS * (TRAIN_CAR + TRAIN_GAP);
      zf := long * 0.5 + 0.7;
      d := sub(a, tf.o); lx := dot(d, tf.x); lz := dot(d, tf.z);
      bx := clamp(lx, -1.2 * ts, 1.2 * ts); bz := clamp(lz, (zf - long + 0.4) * ts, (zf - 0.4) * ts);
      if (lx - bx) * (lx - bx) + (lz - bz) * (lz - bz) > SD_CABLE * SD_CABLE { continue; }
      b := fp(tf, bx, 1.0 * ts, bz);
      sag := lo(a.y, b.y) - c.y - 0.06;
      side := unit_or(cross(sub(b, a), v3(0, 1, 0)), v3(1, 0, 0));
      kit_pen(p, 97, MAT_CLOTH, INK());
      prev := a; k := 14;
      for s: 1..<k + 1 {
        u := cast(f32) s / cast(f32) k;
        q := add(add(a, times(sub(b, a), u)), v3(0, -sag * sin(PI * u), 0));
        limb(buf, p, prev, q, 0.05, 0.05, side, 6);
        prev = q;
      }
      box(buf, p, frame_at(b, t.yaw), 0.09, 0.09, 0.09);   // the socket on the train's side
      drawn += 1;
    }
  }
  return drawn;
}
