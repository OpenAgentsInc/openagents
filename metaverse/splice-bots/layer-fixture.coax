// Splice's fixture layer (GitHub #13404): a piece beside every kept-clear zone that has open
// ground beside it, as the typed edits that place them. The checks play the whole run and walk the
// whole way with it in (walk-checks.coax), and a developer's page loads it to see placed pieces in
// the world: http://127.0.0.1:8800/worlds/splice-bots?layer=fixture (splice-bots.coax; the dev server only).
//
// One row a piece: the kept-clear zone it stands beside (its content ID), the piece (its content
// ID), where it stands in centimetres, and its turn in degrees. The hallway and the lab have no
// row: their walls, the boss wall and each other are all that is beside them, which walk-checks.coax holds ("no spot within a metre of
// the boss chamber").
SL_FIXTURE_N :: 29;
SL_FIXTURE :: [SL_FIXTURE_N * 5] int.[
  1, 113, 17700, -7800, 0,        // the village start: a palm
  2, 113, 17720, -7060, 0,        // the scanner gate
  3, 113, 16490, 10000, 0,        // the rail track
  4, 110, -83700, -10200, 0,      // the Battery: a turbine beside the farm's hardware
  5, 113, 210, 960, 0,            // the mine start
  6, 117, 280, 150, 0,            // the rover's door: a small crate
  7, 113, 320, 760, 0,            // the checkpoint post
  8, 113, -83540, -11000, 0,      // the drill arm
  9, 113, -84300, -10860, 0,      // the treads
  10, 117, -80900, -9720, 0,      // the MOVE card
  11, 113, -81500, -8740, 0,      // the DRILL card
  12, 113, -230, -600, 0,         // the mine mouth's lane
  13, 113, -220, -2200, 0,        // the scrap room's lane
  14, 113, 360, -4090, 0,         // the rubble and the tunnel
  15, 113, -3391, -7186, 0,       // HA's bay mouth
  16, 112, -3831, -5544, 120,     // battery cell 1: a raider in HA
  17, 113, -9263, -10577, 0,      // H1's bay mouth
  18, 117, -10465, -9375, 45,     // battery cell 2
  19, 113, -12654, -16449, 0,     // G2's bay mouth
  20, 118, -14392, -16014, -140,  // the DRILL+ part: a banned bot standing guard
  21, 117, 3631, -5554, 0,        // the stash crate's side
  22, 113, 13690, -20250, 0,      // the south ramp
  23, 113, 14030, -19500, 0,      // the catwalk
  24, 113, 13690, -18750, 0,      // the north ramp
  25, 113, 11345, -13290, 0,      // B2's bay mouth
  26, 103, 12817, -12570, -60,    // battery cell 3: a crab-bot in B2
  27, 113, 230, -34600, 0,        // the drill line
  28, 117, -240, -34920, 0,       // the boss wall
  31, 113, 14006, -24053, 0];     // the drill mech's bay
// Places the fixture's pieces, each through the check: how many stand, or minus the row the check
// refused, less one.
sl_fixture :: (g: [] SpGame) -> int {
  for i: 0..<SL_FIXTURE_N {
    o := i * 5;
    if !sl_place(g, SL_FIXTURE[o + 1], SL_FIXTURE[o + 2], SL_FIXTURE[o + 3], SL_FIXTURE[o + 4]).ok { return -i - 1; }
  }
  return SL_FIXTURE_N;
}
