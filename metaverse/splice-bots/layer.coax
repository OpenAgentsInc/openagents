// Splice's colliders and its edit layer (GitHub #13404; docs/audits/2026-11-12-chat-and-world-building.md,
// slice 0).
//
// Everything that blocks is an entity in a Metaverse Engine World (metaverse-engine/core/world.coax): the
// mine's walls, the rubble and the boss wall, the banned bot, the rover at the rail stop and every
// placed piece. An entity carries a transform, a body, a kind and a row; this file adds a shape
// beside those columns. A walker's step asks the World's spatial index (metaverse-engine/core/spatial.coax)
// for what stands near, then the shared walking rules (metaverse-engine/physics/collide.coax) push it out.
// No list is scanned: a wall longer than a cell is several entities, a cell each, that all carry
// the whole wall's box, so the wall pushes as one box whichever part the index found.
//
// The edit layer is a scene of placed things in the engine's edit log (metaverse-engine/editor/edit.coax
// EditorScene): each edit is one typed step with its inverse, undo and redo walk the log, and the
// World's placed pieces are built from the scene's items in ID order each time the layer's
// revision changes. A placed piece is scenery: it has no AI and no hit points. It names its row
// of the `pieces` content table by content ID (content.coax).
//
// An edit is checked before it is taken (sl_check): the piece must stand inside an area, clear of
// every kept-clear zone, of you and of what already stands there. A refusal names what it hit.
// The walk replay (walk.coax) is the second check, made when a layer is saved.
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax
#load "../../metaverse-engine/core/world.coax";
#load "../../metaverse-engine/physics/collide.coax";
#load "../../metaverse-engine/editor/edit.coax";

SL_CAP :: 256;            // entities: about 105 for the designed world, the rest for placed pieces
SL_LISTS :: 256;          // the spatial index's lists
SL_CELL :: 16.0f32;       // m: a cell's side, and the longest a wall's entity is
SL_ITEMS :: 64;           // placed pieces a layer holds
SL_OPS :: 256; SL_STEPS :: 64;   // the layer's edit log
SL_NEAR :: 64;            // entities one question looks at
SL_TOP :: 2.0f32;         // m: how tall a collider stands to a walker
SL_MID :: 0.9f32;         // m: a walker's middle, where a rounded collider's axis lies
SL_SLACK :: 1.5f32;        // m: a question looks this much further still, for what a push out of one wall brings near
SL_RISE :: 8;             // pieces that can be arriving at once; one more takes the oldest's place
SL_RISE_TIME :: 0.7f32;   // s: how long a piece takes to rise
SL_TALL :: 1.0f32;        // m: taller than this blocks the camera and the party's people too

// What an entity is (the World's kind column). A placed piece's kind is its content ID.
SK_WALL :: 1; SK_RUBBLE :: 2; SK_BOSS_WALL :: 3; SK_BOSS :: 4; SK_PIECE :: 100;
// Its shape, on the ground: a box (half sizes ex, ez), or a stadium: a segment of half length ez
// along its own z axis (or its x axis), grown by the radius ex.
SH_BOX :: 0; SH_ALONG_Z :: 1; SH_ALONG_X :: 2;

SlWorld :: struct {
  gen: [SL_CAP] int; live: [SL_CAP] bool; born: [SL_CAP] bool; doomed: [SL_CAP] bool;
  ids: [SL_CAP] int; free: [SL_CAP] int; spawns: [SL_CAP] int; en: [ENTITY_COUNTERS] int;
  has: [SL_CAP] int; f: [WORLD_F * SL_CAP] f32; i: [WORLD_I * SL_CAP] int;
  head: [SL_LISTS] int; next: [SL_CAP] int; prev: [SL_CAP] int; at: [SL_CAP] int;
  cx: [SL_CAP] int; cz: [SL_CAP] int; gx: [SL_CAP] f32; gz: [SL_CAP] f32; cell: [1] f32; gn: [SPATIAL_COUNTERS] int;
  sys_id: [1] int; sys_reads: [1] int; sys_writes: [1] int;
  seen: [WORLD_COMPONENTS] int; n: [WORLD_COUNTERS] int;
  // Splice's own columns, one element a slot
  ox: [SL_CAP] f32; oz: [SL_CAP] f32;                        // the shape's middle (a long wall's parts share the wall's)
  ex: [SL_CAP] f32; ez: [SL_CAP] f32; shape: [SL_CAP] int;
  reach: f32;      // the furthest any collider reaches from where it stands: a question looks this much further
  refused: int;    // spawns the World had no slot for
  crowded: int;    // questions that met more than SL_NEAR entities
  boss: int = -1;  // the banned bot's slot: a body that moves (sl_body_to)
}
SlLayer :: struct {
  st: [1] EditorSceneState;
  items: [SL_ITEMS] EditorItem;
  ops: [SL_OPS] EditorItemOp;
  steps: [SL_STEPS] EditorStep;
  rev: int;        // counts the layer's changes: an edit, an undo, a redo
  head: int;       // the world document's revision the layer stands at (world.coax): 0 with no document
  // pieces arriving: a piece an outside edit placed rises out of the ground (world.coax spw_page_events)
  rise_id: [SL_RISE] int; rise_t: [SL_RISE] f32; rise_n: int;
  shown: int;      // counts changes to how the pieces are drawn that are not edits: a rise's step
  built: int;      // the revision the World's placed pieces were built from
}

// The World over a store of Splice's size (the game's, or a scratch one a document is read into).
slw_world :: (ws: [] SlWorld) -> World {
  return World.{
    ents = EntityStore.{gen = ws[0].gen[..], live = ws[0].live[..], born = ws[0].born[..], doomed = ws[0].doomed[..],
      ids = ws[0].ids[..], free = ws[0].free[..], spawns = ws[0].spawns[..], n = ws[0].en[..]},
    has = ws[0].has[..], f = ws[0].f[..], i = ws[0].i[..],
    grid = SpatialGrid.{head = ws[0].head[..], next = ws[0].next[..], prev = ws[0].prev[..], at = ws[0].at[..],
      cx = ws[0].cx[..], cz = ws[0].cz[..], x = ws[0].gx[..], z = ws[0].gz[..], cell = ws[0].cell[..], n = ws[0].gn[..]},
    sys_id = ws[0].sys_id[..], sys_reads = ws[0].sys_reads[..], sys_writes = ws[0].sys_writes[..],
    seen = ws[0].seen[..], n = ws[0].n[..]};
}
sl_world :: (g: [] SpGame) -> World { return slw_world(g[0].ws[..]); }
// A column's element, read straight from the store. Between steps the realm owns the columns
// (world.coax), and a walker's questions are asked between steps.
sl_f :: (g: [] SpGame, col: int, s: int) -> f32 { return g[0].ws[0].f[col * SL_CAP + s]; }
sl_i :: (g: [] SpGame, col: int, s: int) -> int { return g[0].ws[0].i[col * SL_CAP + s]; }
sl_grid :: (g: [] SpGame) -> SpatialGrid {
  return SpatialGrid.{head = g[0].ws[0].head[..], next = g[0].ws[0].next[..], prev = g[0].ws[0].prev[..], at = g[0].ws[0].at[..],
    cx = g[0].ws[0].cx[..], cz = g[0].ws[0].cz[..], x = g[0].ws[0].gx[..], z = g[0].ws[0].gz[..], cell = g[0].ws[0].cell[..], n = g[0].ws[0].gn[..]};
}
sl_scene :: (g: [] SpGame) -> EditorScene {
  return EditorScene.{st = g[0].layer[0].st[..], items = g[0].layer[0].items[..], ops = g[0].layer[0].ops[..], steps = g[0].layer[0].steps[..]};
}

// ---- the collider set

// One collider into the World: its slot, or -1 when the World is full (counted). It stands in the
// index at (x, z) and reaches `reach` from there; its shape's middle is (ox, oz). It is alive, and
// in the index, from the next world_commit.
sl_spawn :: (g: [] SpGame, kind: int, row: int, x: f32, y: f32, z: f32, yaw: f32, reach: f32, shape: int, ox: f32, oz: f32, ex: f32, ez: f32, tall: f32) -> int {
  w := sl_world(g);
  made := world_spawn(w, WORLD_TRANSFORM | WORLD_BODY | WORLD_KIND | WORLD_ROW);
  if made.handle == ENTITY_NONE { g[0].ws[0].refused += 1; return -1; }
  s := entity_slot(made.handle);
  _ := world_set_f(w, WF_X, s, x); _ = world_set_f(w, WF_Y, s, y); _ = world_set_f(w, WF_Z, s, z); _ = world_set_f(w, WF_YAW, s, yaw);
  _ = world_set_f(w, WF_RADIUS, s, reach); _ = world_set_f(w, WF_HEIGHT, s, tall);
  _ = world_set_i(w, WI_KIND, s, kind); _ = world_set_i(w, WI_ROW, s, row);
  g[0].ws[0].ox[s] = ox; g[0].ws[0].oz[s] = oz; g[0].ws[0].ex[s] = ex; g[0].ws[0].ez[s] = ez; g[0].ws[0].shape[s] = shape;
  if reach > g[0].ws[0].reach { g[0].ws[0].reach = reach; }
  return s;
}
// A round body: a stadium of radius r and half length l standing at (x, z).
sl_round :: (g: [] SpGame, kind: int, row: int, x: f32, y: f32, z: f32, yaw: f32, shape: int, r: f32, l: f32, tall: f32) -> int {
  return sl_spawn(g, kind, row, x, y, z, yaw, r + l, shape, x, z, r, l, tall);
}
// A box from (x0, z0) to (x1, z1): one entity a cell's side or less each way, so the index finds
// a long wall from near any part of it. Each part carries the whole box.
sl_box :: (g: [] SpGame, kind: int, row: int, x0: f32, x1: f32, z0: f32, z1: f32, tall: f32) {
  nx := cast(int) floor((x1 - x0) / SL_CELL); nz := cast(int) floor((z1 - z0) / SL_CELL);
  if cast(f32) nx * SL_CELL < x1 - x0 { nx += 1; } if cast(f32) nz * SL_CELL < z1 - z0 { nz += 1; }
  if nx < 1 { nx = 1; } if nz < 1 { nz = 1; }
  wx := (x1 - x0) / cast(f32) nx; wz := (z1 - z0) / cast(f32) nz;
  for i: 0..<nx { for k: 0..<nz {
    _ := sl_spawn(g, kind, row, x0 + (cast(f32) i + 0.5) * wx, 0, z0 + (cast(f32) k + 0.5) * wz, 0, sqrt(wx * wx + wz * wz) * 0.5,
                  SH_BOX, (x0 + x1) * 0.5, (z0 + z1) * 0.5, (x1 - x0) * 0.5, (z1 - z0) * 0.5, tall);
  } }
}
// The designed world's colliders, from the layout's walls (g_layout) and the places: the walls,
// the rubble and the boss wall (which open), the banned bot (a round body) and the rover where
// the sensor ping stops item. Then the layer's placed pieces.
sl_build :: (g: [] SpGame) {
  w := sl_world(g);
  g[0].ws[0].reach = 0; g[0].ws[0].refused = 0; g[0].ws[0].crowded = 0;
  for s: 0..<SL_CAP { g[0].ws[0].ox[s] = 0; g[0].ws[0].oz[s] = 0; g[0].ws[0].ex[s] = 0; g[0].ws[0].ez[s] = 0; g[0].ws[0].shape[s] = 0; }
  _ := world_init(w, SL_CELL);
  for i: 0..<g[0].wall_n { o := i * 5; sl_box(g, SK_WALL, i, g[0].walls[o], g[0].walls[o + 1], g[0].walls[o + 2], g[0].walls[o + 3], g[0].walls[o + 4]); }
  ga_colliders(g);   // the garage's piers (garage.coax)
  sl_box(g, SK_RUBBLE, 0, -3, 3, g[0].at.rubble_z - 1, g[0].at.rubble_z + 1, 0);
  sl_box(g, SK_BOSS_WALL, 0, -4, 4, g[0].at.wall_z - 1, g[0].at.wall_z + 1, 0);
  g[0].ws[0].boss = sl_round(g, SK_BOSS, 0, g[0].at.boss_x, 0, g[0].at.boss_z, 0, SH_ALONG_Z, 2.1 - T_RADIUS, 0, 0);
  c := rail_at(g, T_RAIL_PING);
  sl_box(g, SK_WALL, -1, c.x - 1.5, c.x + 1.5, c.z - 2.4, c.z + 2.4, 0);
  _ = world_commit(w);
  g[0].layer[0].built = -1;
  sl_sync(g);
}
// A body that moves (the banned bot, splice-battle.coax): its transform and its shape's middle go where it
// stands, and the World's commit puts it in the index there, so a walker is pushed out of it where it is drawn.
sl_body_to :: (g: [] SpGame, s: int, x: f32, z: f32, yaw: f32) {
  w := sl_world(g);
  if s < 0 || s >= SL_CAP || world_at(w, s) == ENTITY_NONE { return; }
  if sl_f(g, WF_X, s) == x && sl_f(g, WF_Z, s) == z && sl_f(g, WF_YAW, s) == yaw { return; }
  _ := world_set_f(w, WF_X, s, x); _ = world_set_f(w, WF_Z, s, z); _ = world_set_f(w, WF_YAW, s, yaw);
  g[0].ws[0].ox[s] = x; g[0].ws[0].oz[s] = z;
  _ = world_commit(w);
}
// The World's placed pieces are the layer's items, in ID order: built again whenever the layer's
// revision is not the one they were built from.
sl_sync :: (g: [] SpGame) {
  if g[0].layer[0].built == g[0].layer[0].rev { return; }
  w := sl_world(g); c := g[0].c[..];
  for s: 0..<world_high(w) {
    h := world_at(w, s);
    if h != ENTITY_NONE && world_i(w, WI_KIND, s) >= SK_PIECE { world_despawn(w, h); }
  }
  _ := world_commit(w);
  for i: 0..<g[0].layer[0].st[0].n {
    item := g[0].layer[0].items[i];
    row := sc_piece(c, item.mesh);
    if row < 0 { continue; }
    p := c[0].pieces[row];
    if p.hz >= p.hx { _ = sl_round(g, item.mesh, item.id, item.x, item.y, item.z, item.yaw, SH_ALONG_Z, p.hx, p.hz - p.hx, p.top); }
    else { _ = sl_round(g, item.mesh, item.id, item.x, item.y, item.z, item.yaw, SH_ALONG_X, p.hz, p.hx - p.hz, p.top); }
  }
  _ = world_commit(w);
  g[0].layer[0].built = g[0].layer[0].rev;
}
// Whether slot s blocks now: the rubble and the boss wall stop blocking once the Digger opens
// them. `tall`: only what stands taller than SL_TALL (what the camera and the party's people meet).
sl_solid :: (g: [] SpGame, s: int, tall: bool) -> bool {
  kind := sl_i(g, WI_KIND, s);
  if kind == SK_RUBBLE && g[0].rubble_gone { return false; }
  if kind == SK_BOSS_WALL && g[0].wall_gone { return false; }
  return !tall || sl_f(g, WF_HEIGHT, s) > SL_TALL;
}
// The entities that may be within r of (x, z), by slot ascending, into ids: how many. The World's
// index answers (metaverse-engine/core/spatial.coax): only the cells the radius overlaps are looked at.
sl_near :: (g: [] SpGame, x: f32, z: f32, r: f32, ids: [] int) -> int {
  n := spatial_query(sl_grid(g), x, z, r + g[0].ws[0].reach + SL_SLACK, ids);
  if n > ids.count { n = ids.count; g[0].ws[0].crowded += 1; }
  for i: 1..<n { v := ids[i]; k := i; while k > 0 && ids[k - 1] > v { ids[k] = ids[k - 1]; k -= 1; } ids[k] = v; }
  return n;
}
// A stadium's two ends on the ground.
SlSeg :: struct { ax: f32; az: f32; bx: f32; bz: f32; r: f32; }
sl_seg_of :: (x: f32, z: f32, yaw: f32, shape: int, r: f32, l: f32) -> SlSeg {
  dx := sin(yaw); dz := cos(yaw);
  if shape == SH_ALONG_X { dx = cos(yaw); dz = -sin(yaw); }
  return SlSeg.{ax = x - dx * l, az = z - dz * l, bx = x + dx * l, bz = z + dz * l, r = r};
}
sl_seg :: (g: [] SpGame, s: int) -> SlSeg {
  return sl_seg_of(sl_f(g, WF_X, s), sl_f(g, WF_Z, s), sl_f(g, WF_YAW, s), g[0].ws[0].shape[s], g[0].ws[0].ex[s], g[0].ws[0].ez[s]);
}
// Whether slot s is a further part of the wall the slot before it in ids is a part of.
sl_same_wall :: (g: [] SpGame, ids: [] int, i: int) -> bool {
  if i == 0 || g[0].ws[0].shape[ids[i]] != SH_BOX || g[0].ws[0].shape[ids[i - 1]] != SH_BOX { return false; }
  return sl_i(g, WI_KIND, ids[i]) == sl_i(g, WI_KIND, ids[i - 1]) && sl_i(g, WI_ROW, ids[i]) == sl_i(g, WI_ROW, ids[i - 1]);
}
// Where a walker of radius r that stepped to (x, z) stands once every collider near it has pushed
// it out: the boxes in the layout's order (a wall once, whichever of its parts were found), then
// the round bodies. The pushing is the engine's (collide_walls, collide_bodies).
sl_push :: (g: [] SpGame, x: f32, z: f32, r: f32, tall: bool) -> Point { return sl_push_over(g, x, z, r, tall, -SL_UNDER); }
// The same for a walker whose feet are at height `feet`: a placed piece whose top is under them
// (a jump took you over it, or you stand on it) does not push. Walls, the gates and the banned
// bot always do.
SL_UNDER :: 1000.0f32;
SL_ON_TOP :: 0.05f32;     // m: feet this near a piece's top stand on it
sl_under :: (g: [] SpGame, s: int, feet: f32) -> bool {
  return sl_i(g, WI_KIND, s) >= SK_PIECE && sl_f(g, WF_Y, s) + sl_f(g, WF_HEIGHT, s) <= feet + SL_ON_TOP;
}
sl_push_over :: (g: [] SpGame, x: f32, z: f32, r: f32, tall: bool, feet: f32) -> Point {
  ids: [SL_NEAR] int; n := sl_near(g, x, z, r, ids[..]);
  boxes: [SL_NEAR * QUERY_BOX] f32; nb := 0;
  caps: [SL_NEAR * QUERY_CAPSULE] f32; nc := 0;
  for i: 0..<n {
    s := ids[i];
    if !sl_solid(g, s, tall) || sl_same_wall(g, ids[..], i) || sl_under(g, s, feet) { continue; }
    if g[0].ws[0].shape[s] == SH_BOX {
      cx := g[0].ws[0].ox[s]; cz := g[0].ws[0].oz[s]; ex := g[0].ws[0].ex[s]; ez := g[0].ws[0].ez[s]; o := nb * QUERY_BOX;
      boxes[o] = cx - ex; boxes[o + 1] = 0; boxes[o + 2] = cz - ez; boxes[o + 3] = cx + ex; boxes[o + 4] = SL_TOP; boxes[o + 5] = cz + ez;
      nb += 1;
    } else {
      e := sl_seg(g, s); o := nc * QUERY_CAPSULE;
      caps[o] = e.ax; caps[o + 1] = SL_MID; caps[o + 2] = e.az; caps[o + 3] = e.bx; caps[o + 4] = SL_MID; caps[o + 5] = e.bz; caps[o + 6] = e.r;
      nc += 1;
    }
  }
  if nb == 0 && nc == 0 { return v3(x, 0, z); }
  p := CollideProfile.{radius = r};
  st := CollideState.{feet = world_point(x, 0, z)};
  st = collide_walls(Colliders.{boxes = boxes[0..<nb * QUERY_BOX], ground_enabled = false}, p, st);
  st = collide_bodies(Colliders.{capsules = caps[0..<nc * QUERY_CAPSULE], ground_enabled = false}, p, st, 0, 0).state;
  return v3(st.feet.x, 0, st.feet.z);
}
// The tops of the placed pieces near (x, z), as the engine's floors (metaverse-engine/physics/stand.coax,
// STAND_FLOATS numbers each) into out: how many. A piece's top is the rectangle round its stadium,
// at its height over where it stands. The engine's jump lands you on them (splice-game.coax g_jump).
sl_floors :: (g: [] SpGame, x: f32, z: f32, out: [] f32) -> int {
  ids: [SL_NEAR] int; n := sl_near(g, x, z, 1, ids[..]);
  k := 0;
  for i: 0..<n {
    s := ids[i];
    if sl_i(g, WI_KIND, s) < SK_PIECE || (k + 1) * STAND_FLOATS > out.count { continue; }
    e := sl_seg(g, s);
    lx := e.bx - e.ax; lz := e.bz - e.az; long := sqrt(lx * lx + lz * lz);
    dx := sin(sl_f(g, WF_YAW, s)); dz := cos(sl_f(g, WF_YAW, s));
    if long > 0.0001 { dx = lx / long; dz = lz / long; }
    half := long * 0.5 + e.r;
    mx := (e.ax + e.bx) * 0.5; mz := (e.az + e.bz) * 0.5;
    // corner, the side along the stadium, the side across it (to its right: (dz, -dx))
    ox := mx - dx * half - dz * e.r; oz := mz - dz * half + dx * e.r;
    stand_put_quad(out, k, ox, oz, dx * half * 2, dz * half * 2, dz * e.r * 2, -dx * e.r * 2, sl_f(g, WF_Y, s) + sl_f(g, WF_HEIGHT, s), 0, 0);
    k += 1;
  }
  return k;
}
// How far the segment a-b is from a box on the ground (0 when it touches or crosses it), by the
// engine's box and segment rules.
sl_seg_box :: (e: SlSeg, cx: f32, cz: f32, ex: f32, ez: f32) -> f32 {
  b := QueryBox.{low = world_point(cx - ex, -1, cz - ez), high = world_point(cx + ex, 1, cz + ez), ok = true};
  d := lo(query_footprint(b, e.ax, e.az), query_footprint(b, e.bx, e.bz));
  lx := e.bx - e.ax; lz := e.bz - e.az; long := sqrt(lx * lx + lz * lz);
  if long < 0.0001 || d == 0 { return d; }
  if query_enter_box(b.low, b.high, world_point(e.ax, 0, e.az), world_point(lx / long, 0, lz / long), long).hit { return 0; }
  for k: 0..<4 {
    px := ifx k % 2 == 0 then cx - ex else cx + ex; pz := ifx k < 2 then cz - ez else cz + ez;
    q := query_nearest(world_point(e.ax, 0, e.az), world_point(e.bx, 0, e.bz), world_point(px, 0, pz));
    d = lo(d, sqrt((q.x - px) * (q.x - px) + (q.z - pz) * (q.z - pz)));
  }
  return d;
}
sl_seg_seg :: (a: SlSeg, b: SlSeg) -> f32 {
  c := collide_closest(world_point(a.ax, 0, a.az), world_point(a.bx, 0, a.bz), world_point(b.ax, 0, b.az), world_point(b.bx, 0, b.bz), 0.000001);
  return sqrt((c.p.x - c.q.x) * (c.p.x - c.q.x) + (c.p.z - c.q.z) * (c.p.z - c.q.z));
}
// The first collider (by slot) the stadium e overlaps, or -1. Only kinds from `from` up count
// (SK_WALL: everything; SK_PIECE: placed pieces only). `gates`: the rubble and the boss wall count
// while they stand; without it they never do (a placed piece must not rely on a wall that
// opens). `skip`: a placed piece's item ID that is not counted (itself, when it moves), or -1.
sl_touch :: (g: [] SpGame, e: SlSeg, from: int, tall: bool, gates: bool, skip: int) -> int {
  mx := (e.ax + e.bx) * 0.5; mz := (e.az + e.bz) * 0.5;
  half := sqrt((e.bx - e.ax) * (e.bx - e.ax) + (e.bz - e.az) * (e.bz - e.az)) * 0.5;
  ids: [SL_NEAR] int; n := sl_near(g, mx, mz, e.r + half, ids[..]);
  for i: 0..<n {
    s := ids[i]; kind := sl_i(g, WI_KIND, s);
    if kind < from || ((kind == SK_RUBBLE || kind == SK_BOSS_WALL) && !gates) { continue; }
    if !sl_solid(g, s, tall) { continue; }
    if kind >= SK_PIECE && sl_i(g, WI_ROW, s) == skip { continue; }
    if g[0].ws[0].shape[s] == SH_BOX {
      if sl_seg_box(e, g[0].ws[0].ox[s], g[0].ws[0].oz[s], g[0].ws[0].ex[s], g[0].ws[0].ez[s]) < e.r { return s; }
    } else {
      o := sl_seg(g, s);
      if sl_seg_seg(e, o) < e.r + o.r { return s; }
    }
  }
  return -1;
}
// Whether the point (x, z), padded, is inside something tall: what the camera asks.
sl_inside :: (g: [] SpGame, x: f32, z: f32, pad: f32) -> bool {
  return sl_touch(g, SlSeg.{ax = x, az = z, bx = x, bz = z, r = pad}, SK_WALL, true, true, -1) >= 0;
}
// The World and Splice's own columns as one number: equal collider sets give equal digests, so a
// replay of the same edits compares it a step at a time.
sl_digest :: (g: [] SpGame) -> int {
  w := sl_world(g);
  h := world_digest(w);
  for s: 0..<world_high(w) {
    if world_at(w, s) == ENTITY_NONE { continue; }
    h = entity_mix(h, cast(int) f32_bits(g[0].ws[0].ox[s])); h = entity_mix(h, cast(int) f32_bits(g[0].ws[0].oz[s]));
    h = entity_mix(h, cast(int) f32_bits(g[0].ws[0].ex[s])); h = entity_mix(h, cast(int) f32_bits(g[0].ws[0].ez[s])); h = entity_mix(h, g[0].ws[0].shape[s]);
  }
  return h;
}

// ---- the check

SL_OK :: 0;
SL_NO_PIECE :: 1;    // no row of the pieces table has this content ID
SL_EDGE :: 2;        // past the map's edge: inside no area
SL_KEPT :: 3;        // in a kept-clear zone (`which`: its row)
SL_PLAYER :: 4;      // on top of you
SL_COLLIDER :: 5;    // inside something that already stands there (`which`: its slot)
SL_FULL :: 6;        // the layer holds SL_ITEMS pieces
SL_NO_ITEM :: 7;     // no placed piece has this ID
SL_TURN :: 8;        // a turn is -179 to 180 whole degrees
SL_NOTHING :: 9;     // nothing to undo or redo, or the edit changes nothing
SlVerdict :: struct { why: int; which: int = -1; }

// A piece's footprint where it would stand: the stadium inside its measured box.
sl_foot :: (g: [] SpGame, row: int, x: f32, z: f32, yaw: f32) -> SlSeg {
  p := g[0].c[0].pieces[row];
  if p.hz >= p.hx { return sl_seg_of(x, z, yaw, SH_ALONG_Z, p.hx, p.hz - p.hx); }
  return sl_seg_of(x, z, yaw, SH_ALONG_X, p.hz, p.hx - p.hz);
}
// Whether the stadium lies wholly inside an area: a circle, or a box.
sl_in_area :: (e: SlSeg, a: ScZone) -> bool {
  if a.r > 0 { return dist2(e.ax, e.az, a.x, a.z) + e.r <= a.r && dist2(e.bx, e.bz, a.x, a.z) + e.r <= a.r; }
  return abs(e.ax - a.x) <= a.hx - e.r && abs(e.az - a.z) <= a.hz - e.r && abs(e.bx - a.x) <= a.hx - e.r && abs(e.bz - a.z) <= a.hz - e.r;
}
// May piece `piece` (a content ID) stand at (x, z) turned yaw? `skip`: the placed piece it is (a
// move), or -1 (a new one).
sl_check :: (g: [] SpGame, piece: int, x: f32, z: f32, yaw: f32, skip: int) -> SlVerdict {
  c := g[0].c[..];
  row := sc_piece(c, piece);
  if row < 0 { return SlVerdict.{why = SL_NO_PIECE}; }
  e := sl_foot(g, row, x, z, yaw);
  inside := false;
  for a: 0..<c[0].area_n { inside = inside || sl_in_area(e, c[0].areas[a]); }
  if !inside { return SlVerdict.{why = SL_EDGE}; }
  for k: 0..<c[0].kept_n {
    zn := c[0].kept[k];
    if sl_seg_box(e, zn.x, zn.z, zn.hx, zn.hz) < e.r + zn.r { return SlVerdict.{why = SL_KEPT, which = k}; }
  }
  if sl_seg_seg(e, SlSeg.{ax = g[0].px, az = g[0].pz, bx = g[0].px, bz = g[0].pz}) < e.r + T_RADIUS { return SlVerdict.{why = SL_PLAYER}; }
  if ga_rock(g, e.ax, e.az, e.r) || ga_rock(g, e.bx, e.bz, e.r) { return SlVerdict.{why = SL_COLLIDER, which = -1}; }   // the garage's rock (garage.coax)
  hit := sl_touch(g, e, SK_WALL, false, false, skip);
  if hit >= 0 { return SlVerdict.{why = SL_COLLIDER, which = hit}; }
  return SlVerdict.{};
}
// A refusal in words, into out: what an agent or a person is told.
sl_why :: (g: [] SpGame, v: SlVerdict, out: [] u8) -> string {
  n := 0;
  if v.why == SL_OK { n = ct_put(out, n, "ok"); }
  if v.why == SL_NO_PIECE { n = ct_put(out, n, "no piece has that content ID"); }
  if v.why == SL_EDGE { n = ct_put(out, n, "past the map's edge: a piece stands inside the dome village, the gate corridor, the rail stop or the mine"); }
  if v.why == SL_KEPT { n = ct_put(out, n, "in the kept-clear zone '"); n = ct_put(out, n, sc_kept_name(g[0].c[..], v.which)); n = ct_put(out, n, "'"); }
  if v.why == SL_PLAYER { n = ct_put(out, n, "on top of the player"); }
  if v.why == SL_COLLIDER {
    w := sl_world(g); kind := ifx v.which >= 0 then world_i(w, WI_KIND, v.which) else SK_WALL;
    if kind >= SK_PIECE { n = ct_put(out, n, "inside the placed piece "); n = ct_put_int(out, n, world_i(w, WI_ROW, v.which)); }
    else { n = ct_put(out, n, ifx kind == SK_BOSS then "inside the banned bot" else "inside a wall or a thing that already stands there"); }
  }
  if v.why == SL_FULL { n = ct_put(out, n, "the layer is full"); }
  if v.why == SL_NO_ITEM { n = ct_put(out, n, "no placed piece has that ID"); }
  if v.why == SL_TURN { n = ct_put(out, n, "a turn is -179 to 180 whole degrees"); }
  if v.why == SL_NOTHING { n = ct_put(out, n, "nothing to change"); }
  return ifx n > out.count then "" else cast(string) out[0..<n];
}

// ---- the edits: whole centimetres and whole degrees, as every realm document keeps them

SlEdit :: struct { ok: bool; id: int = -1; v: SlVerdict; }
sl_rad :: (deg: int) -> f32 { return cast(f32) deg * PI / 180; }
sl_done :: (g: [] SpGame, id: int) -> SlEdit { g[0].layer[0].rev += 1; sl_sync(g); return SlEdit.{ok = true, id = id}; }
sl_no :: (why: int) -> SlEdit { return SlEdit.{v = SlVerdict.{why = why}}; }
// Place piece `piece` (a content ID) at (x, z) centimetres, turned `deg` degrees: its item ID.
sl_place :: (g: [] SpGame, piece: int, x_cm: int, z_cm: int, deg: int) -> SlEdit {
  if deg != editor_turn(deg) { return sl_no(SL_TURN); }
  if g[0].layer[0].st[0].n >= SL_ITEMS { return sl_no(SL_FULL); }
  x := sc_m(x_cm); z := sc_m(z_cm);
  v := sl_check(g, piece, x, z, sl_rad(deg), -1);
  if v.why != SL_OK { return SlEdit.{v = v}; }
  id := editor_scene_place(sl_scene(g), piece, x, ground_y(g, x, z), z, sl_rad(deg), 1);
  if id < 0 { return sl_no(SL_FULL); }
  return sl_done(g, id);
}
sl_item :: (g: [] SpGame, id: int) -> int { return editor_scene_find(sl_scene(g), id); }
sl_move :: (g: [] SpGame, id: int, x_cm: int, z_cm: int) -> SlEdit {
  i := sl_item(g, id);
  if i < 0 { return sl_no(SL_NO_ITEM); }
  item := g[0].layer[0].items[i]; x := sc_m(x_cm); z := sc_m(z_cm);
  v := sl_check(g, item.mesh, x, z, item.yaw, id);
  if v.why != SL_OK { return SlEdit.{v = v}; }
  if !editor_scene_move(sl_scene(g), id, x, ground_y(g, x, z), z) { return sl_no(SL_NOTHING); }
  return sl_done(g, id);
}
sl_turn :: (g: [] SpGame, id: int, deg: int) -> SlEdit {
  i := sl_item(g, id);
  if i < 0 { return sl_no(SL_NO_ITEM); }
  if deg != editor_turn(deg) { return sl_no(SL_TURN); }
  item := g[0].layer[0].items[i];
  v := sl_check(g, item.mesh, item.x, item.z, sl_rad(deg), id);
  if v.why != SL_OK { return SlEdit.{v = v}; }
  if !editor_scene_rotate(sl_scene(g), id, sl_rad(deg)) { return sl_no(SL_NOTHING); }
  return sl_done(g, id);
}
sl_remove :: (g: [] SpGame, id: int) -> SlEdit {
  if !editor_scene_delete(sl_scene(g), id) { return sl_no(SL_NO_ITEM); }
  return sl_done(g, id);
}
// Whether every placed piece still passes the check where it stands (each against the others).
sl_all_ok :: (g: [] SpGame) -> SlVerdict {
  for i: 0..<g[0].layer[0].st[0].n {
    item := g[0].layer[0].items[i];
    v := sl_check(g, item.mesh, item.x, item.z, item.yaw, item.id);
    if v.why != SL_OK { return v; }
  }
  return SlVerdict.{};
}
// Undo and redo walk the layer's log. A step that would leave a piece where the check refuses it
// (you stand there now) is taken back, and refused with that reason.
sl_undo :: (g: [] SpGame) -> SlEdit {
  if !editor_scene_undo(sl_scene(g)) { return sl_no(SL_NOTHING); }
  g[0].layer[0].rev += 1; sl_sync(g);
  v := sl_all_ok(g);
  if v.why == SL_OK { return SlEdit.{ok = true}; }
  _ := editor_scene_redo(sl_scene(g)); g[0].layer[0].rev += 1; sl_sync(g);
  return SlEdit.{v = v};
}
sl_redo :: (g: [] SpGame) -> SlEdit {
  if !editor_scene_redo(sl_scene(g)) { return sl_no(SL_NOTHING); }
  g[0].layer[0].rev += 1; sl_sync(g);
  v := sl_all_ok(g);
  if v.why == SL_OK { return SlEdit.{ok = true}; }
  _ := editor_scene_undo(sl_scene(g)); g[0].layer[0].rev += 1; sl_sync(g);
  return SlEdit.{v = v};
}
// An empty layer with no history.
sl_clear :: (g: [] SpGame) {
  editor_scene_reset(sl_scene(g));
  g[0].layer[0].rev += 1; sl_sync(g);
}

// ---- arriving: a placed piece rises out of the ground where it will stand

// Piece `id` starts to arrive.
sl_rise :: (g: [] SpGame, id: int) {
  l := g[0].layer[..];
  if l[0].rise_n == SL_RISE { for k: 0..<SL_RISE - 1 { l[0].rise_id[k] = l[0].rise_id[k + 1]; l[0].rise_t[k] = l[0].rise_t[k + 1]; } l[0].rise_n -= 1; }
  l[0].rise_id[l[0].rise_n] = id; l[0].rise_t[l[0].rise_n] = 0; l[0].rise_n += 1; l[0].shown += 1;
}
// A frame's step of every arrival; one that is done is forgotten.
sl_rise_step :: (g: [] SpGame, dt: f32) {
  l := g[0].layer[..];
  if l[0].rise_n == 0 { return; }
  n := 0;
  for k: 0..<l[0].rise_n {
    t := l[0].rise_t[k] + dt;
    if t >= SL_RISE_TIME { continue; }
    l[0].rise_id[n] = l[0].rise_id[k]; l[0].rise_t[n] = t; n += 1;
  }
  l[0].rise_n = n; l[0].shown += 1;
}
// How far below where it stands piece `id` is drawn now, for a piece `top` metres tall: its whole
// height and a little when it starts, easing to nothing; 0 for a piece that is not arriving.
sl_sunk :: (g: [] SpGame, id: int, top: f32) -> f32 {
  for k: 0..<g[0].layer[0].rise_n {
    if g[0].layer[0].rise_id[k] != id { continue; }
    left := 1 - g[0].layer[0].rise_t[k] / SL_RISE_TIME;
    return (top + 0.3) * left * left;
  }
  return 0;
}
