// Outcome replay for Splice (GitHub #13438; docs/research/summer-what-to-adapt.md S5;
// docs/metaverse/outcome-replay.md): a recorded run of operations is replayed into a fresh World,
// and four things are checked apart, because each can be wrong while the others are right:
//   live     the World a page holds after taking each saved edit as it came (spw_edit, sure)
//   saved    the document the server saved, opened again in a fresh game, and written again
//   errors   every batch of the run was taken: none refused, no document failed to open
//   probes   what the run was for: a thing stands where it was put, a body is stopped there (a
//            collider query), a place stays free, and the run can still be walked (the game's
//            own step and collision ran the whole way)
// A recorded run is its batches (world.edit.v1, as `coax serve` and the API keep a world's steps)
// and its probes. A probe that fails says which link broke, by the why chain's codes
// (metaverse-engine/agent/why.coax, #13429): not in the layer's state, not spawned in the World, or
// no collider.
// Each check is also run against a broken variant, which must fail it (replay-checks.coax): a
// check that can't fail proves nothing.
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax --only "outcome replay"
//   coax/web/tool.sh metaverse/splice-bots/tools/replay.coax DIR/splice     a world kept by `coax serve`

OC_LIVE :: 0; OC_SAVED :: 1; OC_ERRORS :: 2; OC_PROBES :: 3;
OC_NAMES :: [4] string.["live", "saved", "errors", "probes"];
// ok: each check's verdict. at: the batch or probe the first failure is at (-1: none).
// why: for a failed probe, the why chain's code.
SprOutcome :: struct { ok: [4] bool; at: [4] int; why: int; pieces: int; head: int; }
spr_holds :: (o: SprOutcome) -> bool { return o.ok[OC_LIVE] && o.ok[OC_SAVED] && o.ok[OC_ERRORS] && o.ok[OC_PROBES]; }

// A probe, four numbers: what, and three of its own.
PR_STANDS :: 1;    // thing N (its number on the wire) is of content ID K: N, K, 0
PR_BLOCKS :: 2;    // a body can't stand at X Z centimetres: X, Z, 0
PR_FREE :: 3;      // a body can stand at X Z: X, Z, 0
PR_WALKS :: 4;     // the run's whole way can be walked: 0, 0, 0
PR_COUNT :: 5;     // the layer holds N things: N, 0, 0
PR_PLAN :: 6;      // actor N (1 to 9) does DO at WHEN (content.coax plans; ai/npc-plan.coax NPD_*): N, WHEN, DO
PR_CLOCK :: 7;     // the editor's time of day is W (-1 the story's, 0 dawn to 3 night): W, 0, 0
SPR_PROBE :: 4;

// How a replay is broken on purpose, for the checks of the checks.
SB_NONE :: 0;
SB_LIVE :: 1;      // the page misses the run's last edit
SB_SAVED :: 2;     // the saved document (and tables) are the ones before the run's last batch
SB_ERRORS :: 3;    // a batch the world refuses is slipped into the run
SB_PROBES :: 4;    // a placed thing's collider is taken out of the World
// page: the live page's content tables, which take the run's cell edits (a foe's plan, the editor's clock).
// saved: the tables the server saved, opened again beside the saved document.
SprWork :: struct { live: [1] SpGame; again: [1] SpGame; want: [1] SlLayer; x: [1] SpwWork; page: [1] SpwTables; saved: [1] SpwTables; before: [SPW_TABLES] u8; before_n: int; doc: [SPW_DOC] u8; next: [SPW_DOC] u8; prev: [SPW_DOC] u8; did: [WE_BATCH_BODY] u8; inv: [WE_BATCH_BODY] u8; why: [240] u8; e: [WE_BATCH] WorldEdit; }

// The why chain for a placed thing as a replay can judge it (no page: nothing is drawn): the
// layer's state, the World's entity, and its collider. The code of the first link that failed.
spr_why :: (g: [] SpGame, id: int) -> int {
  w: [1] Why; nb: [16] u8;
  why_begin(w[..], sy_text_i(nb[..], "piece-", id, ""));
  at := sl_item(g, id);
  if at < 0 || sc_piece(g[0].c[..], g[0].layer[0].items[ifx at < 0 then 0 else at].mesh) < 0 { why_fail(w[..], WHY_NOT_IN_STATE, "layer.items", "an item", "none"); return w[0].code; }
  why_pass(w[..], WHY_STATE);
  item := g[0].layer[0].items[at];
  s := sy_slot(g, item.mesh, item.id);
  if g[0].layer[0].built != g[0].layer[0].rev { why_fail(w[..], WHY_SPAWN_PENDING, "layer.built", "the layer's revision", "an older one"); return w[0].code; }
  if s < 0 { why_fail(w[..], WHY_DESPAWNED, "world.slots", "an entity", "none"); return w[0].code; }
  why_pass(w[..], WHY_SPAWNED);
  why_skip(w[..], WHY_VIEW); why_skip(w[..], WHY_DRAWN); why_skip(w[..], WHY_ASSET);
  if g[0].ws[0].ex[s] <= 0 { why_fail(w[..], WHY_COLLIDER_MISSING, "world.shape", "a radius above 0 m", "0 m"); return w[0].code; }
  why_pass(w[..], WHY_COLLIDER);
  return w[0].code;
}
// The probes against a game: the first that fails (its index into o.at) and why.
spr_probe :: (g: [] SpGame, k: [] SwWalker, probes: [] int, o: [] SprOutcome) {
  o[0].ok[OC_PROBES] = true;
  for i: 0..<probes.count / SPR_PROBE {
    what := probes[i * SPR_PROBE]; a := probes[i * SPR_PROBE + 1]; b := probes[i * SPR_PROBE + 2];
    ok := true; why := WHY_OK;
    if what == PR_STANDS {
      at := sl_item(g, a - 1);
      ok = at >= 0 && g[0].layer[0].items[at].mesh == b && spr_why(g, a - 1) == WHY_OK;
      if !ok { why = ifx at >= 0 && g[0].layer[0].items[at].mesh != b then WHY_NOT_IN_STATE else spr_why(g, a - 1); }
    }
    if what == PR_BLOCKS || what == PR_FREE {
      free := sw_free(g, sc_m(a), sc_m(b));
      ok = free == (what == PR_FREE);
      if !ok { why = ifx what == PR_BLOCKS then WHY_COLLIDER_MISSING else WHY_OK; }
    }
    if what == PR_COUNT { ok = g[0].layer[0].st[0].n == a; if !ok { why = WHY_NOT_IN_STATE; } }
    if what == PR_PLAN { ok = spr_plan_holds(g, a, b, probes[i * SPR_PROBE + 3]); if !ok { why = WHY_NOT_IN_STATE; } }
    if what == PR_CLOCK { ok = g[0].c[0].clock == a; if !ok { why = WHY_NOT_IN_STATE; } }
    if what == PR_WALKS {
      keep := g[0].layer[0];
      ok = sw_replay(g, k).why == SW_OK;
      g_reset(g); g[0].layer[0] = keep; g[0].px = g[0].at.bay_x; g[0].pz = g[0].at.bay_z; spw_build(g);
      if !ok { why = WHY_SYSTEM_PAUSED; }
    }
    if !ok { o[0].ok[OC_PROBES] = false; o[0].at[OC_PROBES] = i; o[0].why = why; return; }
  }
}
// Whether actor `who` (1 to 9) does `act` at `when` in a game's tables.
spr_plan_holds :: (g: [] SpGame, who: int, when: int, act: int) -> bool {
  if who < 1 || who > FOES { return false; }
  p := sc_plan(g[0].c[..], who - 1, when);
  return p.ok && p.act == act;
}
// The plan and clock probes of `probes` against a game: the index of the first that fails, or -1.
spr_plans_fail :: (g: [] SpGame, probes: [] int) -> int {
  for i: 0..<probes.count / SPR_PROBE {
    k := i * SPR_PROBE;
    if probes[k] == PR_PLAN && !spr_plan_holds(g, probes[k + 1], probes[k + 2], probes[k + 3]) { return i; }
    if probes[k] == PR_CLOCK && g[0].c[0].clock != probes[k + 1] { return i; }
  }
  return -1;
}
// Whether a game's layer holds exactly the things of `want`, under the same numbers.
spr_same :: (g: [] SpGame, want: [] SlLayer) -> bool {
  if g[0].layer[0].st[0].n != want[0].st[0].n { return false; }
  for i: 0..<want[0].st[0].n { if !editor_same_item(g[0].layer[0].items[i], want[0].items[i]) { return false; } }
  return true;
}
// Replays `batches` from the empty world, and checks the four outcomes against `probes`.
// `broken`: SB_NONE, or the variant that must fail one check.
// What the run should leave is worked out apart from Splice: each batch as it was taken is folded
// into a plain scene by the wire's own rules (world-edit.coax we_scene_apply). The page's layer
// and the saved document's are each held to that, not to each other.
spr_replay :: (t: [] SprWork, batches: [] string, probes: [] int, broken: int) -> SprOutcome {
  oa := [1] SprOutcome.[SprOutcome.{}]; for k: 0..<4 { oa[0].at[k] = -1; }
  server := t[0].again[..];
  empty := spw_empty(server, t[0].x[0].k[..], t[0].doc[..]);
  doc := empty; prev := empty;
  want := EditorScene.{st = t[0].want[0].st[..], items = t[0].want[0].items[..], ops = t[0].want[0].ops[..], steps = t[0].want[0].steps[..]};
  editor_scene_reset(want);
  // the page: a fresh game that opened the empty document and takes each saved edit as it comes
  live := t[0].live[..];
  t[0].x[0].ct[0].text_n = 0; t[0].x[0].ct[0].open = false; t[0].x[0].ct[0].changed = false;
  t[0].page[0].text_n = 0; t[0].page[0].open = false; t[0].saved[0].text_n = 0; t[0].saved[0].open = false;
  g_reset(live); live[0].px = live[0].at.bay_x; live[0].pz = live[0].at.bay_z;
  oa[0].ok[OC_ERRORS] = spw_pieces(live, t[0].x[0].k[..], empty) == SPW_OK;
  sl_sync(live);
  page_ok := true;
  for i: 0..<batches.count {
    t[0].before_n = ct_copy(t[0].before[..], spw_tables_text(t[0].x[0].ct[..]));
    b := spw_batch(server, t[0].x[..], doc, batches[i], false, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
    if b.status != SPB_OK { oa[0].ok[OC_ERRORS] = false; if oa[0].at[OC_ERRORS] < 0 { oa[0].at[OC_ERRORS] = i; } continue; }
    // the saved document moves on; the one before it is kept for the broken variant
    for k: 0..<doc.count { t[0].prev[k] = doc[k]; } prev = cast(string) t[0].prev[0..<doc.count];
    for k: 0..<b.doc { t[0].doc[k] = t[0].next[k]; } doc = cast(string) t[0].doc[0..<b.doc];
    // the batch as it was taken (every spawn numbered), an edit at a time: into what is wanted, and into the page
    taken := we_batch_read(cast(string) t[0].did[0..<b.did], t[0].e[..]);
    last := broken == SB_LIVE && i == batches.count - 1;
    for k: 0..<taken.n {
      if t[0].e[k].op == WE_CELL {
        // a cell of the tables (a foe's plan, the clock): no thing moves; the page's tables take it
        if last && k == taken.n - 1 { continue; }
        if !spw_take(live, t[0].page[..], t[0].e[k], true).ok { page_ok = false; if oa[0].at[OC_LIVE] < 0 { oa[0].at[OC_LIVE] = i; } }
        continue;
      }
      if !we_scene_apply(want, t[0].e[k]).ok { oa[0].ok[OC_ERRORS] = false; if oa[0].at[OC_ERRORS] < 0 { oa[0].at[OC_ERRORS] = i; } }
      if last && k == taken.n - 1 { continue; }
      if !spw_edit(live, t[0].e[k], true).ok { page_ok = false; if oa[0].at[OC_LIVE] < 0 { oa[0].at[OC_LIVE] = i; } }
    }
  }
  if broken == SB_ERRORS {
    // a piece of no kind: the world refuses it, and the run did not go as recorded
    t[0].e[0] = WorldEdit.{op = WE_SPAWN, kind = 999, scale = 100};
    bad := we_batch_write(0, WB_APPLY, t[0].e[..], 1, t[0].inv[..]);
    for k: 0..<bad.count { t[0].prev[k] = bad[k]; }   // the batch's bytes, out of the buffers the call writes
    b := spw_batch(server, t[0].x[..], doc, cast(string) t[0].prev[0..<bad.count], false, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
    if b.status != SPB_OK { oa[0].ok[OC_ERRORS] = false; oa[0].at[OC_ERRORS] = batches.count; }
  }
  if broken == SB_SAVED { doc = prev; }
  // live: the page took every edit, and holds what the run should leave
  oa[0].ok[OC_LIVE] = page_ok && spr_same(live, t[0].want[..]) && spr_plans_fail(live, probes) < 0;
  if !oa[0].ok[OC_LIVE] && oa[0].at[OC_LIVE] < 0 { oa[0].at[OC_LIVE] = batches.count - 1; }
  // saved: the document opens in a fresh game, holds what the run should leave, and writes its own bytes again
  // the saved tables (when the run changed them) open first, as the server opens a world, and hold the plans
  g_reset(server); server[0].px = server[0].at.bay_x; server[0].pz = server[0].at.bay_z;
  tables := ifx broken == SB_SAVED then cast(string) t[0].before[0..<t[0].before_n] else spw_tables_text(t[0].x[0].ct[..]);
  tables_ok := t[0].x[0].ct[0].text_n == 0 || spw_tables_open(server, t[0].saved[..], tables);
  opened := tables_ok && spw_open(server, t[0].x[0].k[..], doc) == SPW_OK;
  oa[0].ok[OC_SAVED] = opened && spr_same(server, t[0].want[..]) && spw_save(server, t[0].x[0].k[..], t[0].next[..]) == doc && spr_plans_fail(server, probes) < 0;
  if !oa[0].ok[OC_SAVED] { oa[0].at[OC_SAVED] = batches.count - 1; }
  oa[0].pieces = live[0].layer[0].st[0].n; oa[0].head = server[0].layer[0].head;
  if broken == SB_PROBES && live[0].layer[0].st[0].n > 0 {
    // the first placed thing loses its collider: it is in the layer, and the World has no shape for it
    item := live[0].layer[0].items[0];
    s := sy_slot(live, item.mesh, item.id);
    if s >= 0 { live[0].ws[0].ex[s] = 0; live[0].ws[0].ez[s] = 0; }
  }
  spr_probe(live, t[0].x[0].w[..], probes, oa[..]);
  return oa[0];
}
// The outcome in words, into out: a line a check, and for a failed probe the link that broke.
spr_report :: (o: SprOutcome, out: [] u8) -> string {
  n := 0;
  for k: 0..<4 {
    n = ct_put(out, n, OC_NAMES[k]); n = ct_put(out, n, ifx o.ok[k] then ": holds" else ": fails");
    if !o.ok[k] && o.at[k] >= 0 { n = ct_put(out, n, ifx k == OC_PROBES then " at probe " else " at batch "); n = ct_put_int(out, n, o.at[k]); }
    if k == OC_PROBES && !o.ok[k] && o.why != WHY_OK { n = ct_put(out, n, " ("); n = ct_put(out, n, why_id(o.why)); n = ct_put(out, n, ")"); }
    n = ct_put(out, n, "\n");
  }
  return ifx n > out.count then "" else cast(string) out[0..<n];
}
// The probes a run earns by itself, when none were recorded with it: the things it leaves are
// counted, each stands and stops a body where it stands, and the run can be walked. Into out
// (SPR_PROBE numbers a probe): how many numbers.
spr_probes_of :: (want: [] SlLayer, out: [] int) -> int {
  n := 0; count := want[0].st[0].n;
  if out.count < (2 * count + 2) * SPR_PROBE { return 0; }
  out[0] = PR_COUNT; out[1] = count; out[2] = 0; out[3] = 0; n = SPR_PROBE;
  for i: 0..<count {
    item := want[0].items[i];
    out[n] = PR_STANDS; out[n + 1] = item.id + 1; out[n + 2] = item.mesh; out[n + 3] = 0; n += SPR_PROBE;
    out[n] = PR_BLOCKS; out[n + 1] = we_cm(item.x); out[n + 2] = we_cm(item.z); out[n + 3] = 0; n += SPR_PROBE;
  }
  out[n] = PR_WALKS; out[n + 1] = 0; out[n + 2] = 0; out[n + 3] = 0;
  return n + SPR_PROBE;
}
// The probes a run earns when it changed the tables: the editor's time of day, and every actor's plan
// at each time of day, as the saved tables hold them, appended at `at` (numbers into out). How many numbers out holds then; `at`
// when the run left the tables as shipped or out has no room.
SPR_PLANS :: FOES * NPL_WHENS + 1;
spr_plan_probes_of :: (t: [] SprWork, out: [] int, at: int) -> int {
  if t[0].x[0].ct[0].text_n == 0 || out.count < at + SPR_PLANS * SPR_PROBE { return at; }
  c: [1] SpContent;
  if !sc_load(c[..], spw_tables_text(t[0].x[0].ct[..])) { return at; }
  out[at] = PR_CLOCK; out[at + 1] = c[0].clock; out[at + 2] = 0; out[at + 3] = 0;
  n := at + SPR_PROBE;
  for who: 1..<FOES + 1 { for when: 0..<NPL_WHENS {
    p := sc_plan(c[..], who - 1, when);
    out[n] = PR_PLAN; out[n + 1] = who; out[n + 2] = when; out[n + 3] = p.act; n += SPR_PROBE;
  } }
  return n;
}
