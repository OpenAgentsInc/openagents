// Splice Bots rules: the rock wall's state (SpliceRockWall.h, W-06; GDD 04 8.4 UE-WALL-01..05, UE-AI-18;
// GDD 02 19.5 Digger drills the first wall for T_CARD_TIME 2.4 s). Only a drill hurts it; chunks break
// one at a time in break order, damage over a chunk's health carrying to the next.
#load "heat.coax";   // sr_mini, sr_maxi

SR_WALL_HIT_DRILL :: 0; SR_WALL_HIT_ATTACK :: 1;
SR_WALL_DEFAULT_CHUNKS :: 20;      // UE-WALL-01 allows 12 to 20
SR_WALL_DIG_SECONDS :: 2.4;
SR_WALL_DRILL_DPS :: 10.0;         // INFERRED unit
SR_WALL_DEFAULT_CHUNK_HEALTH :: SR_WALL_DIG_SECONDS * SR_WALL_DRILL_DPS / 20.0;
SR_WALL_CHUNKS_MAX :: 40;

SrRockWall :: struct {
  n: int;
  health: [SR_WALL_CHUNKS_MAX] f32;     // 0 means broken
  start_health: f32 = SR_WALL_DEFAULT_CHUNK_HEALTH;
  order_n: int;
  break_order: [SR_WALL_CHUNKS_MAX] int; // a permutation of 0..n-1
  drill_dps: f32 = SR_WALL_DRILL_DPS;
  opening_chunks: int;                   // the opening exists once the first this many of break_order are gone
  cursor: int;
}
// As InitWithOrder: the order given (bad and repeated indices dropped, the missing appended in index order).
sr_rock_wall_init_with_order :: (count: int, chunk_health: f32, drill_dps: f32, order: [] const int, opening_chunks: int) -> SrRockWall {
  w: SrRockWall;
  w.n = sr_mini(sr_maxi(count, 0), SR_WALL_CHUNKS_MAX);
  w.start_health = ifx chunk_health > 0.0001 then chunk_health else 0.0001;
  for i: 0..<w.n { w.health[i] = w.start_health; }
  w.drill_dps = ifx drill_dps > 0.0 then drill_dps else 0.0;
  used: [SR_WALL_CHUNKS_MAX] bool;
  for k: order { if k >= 0 && k < w.n && !used[k] { used[k] = true; w.break_order[w.order_n] = k; w.order_n += 1; } }
  for i: 0..<w.n { if !used[i] { w.break_order[w.order_n] = i; w.order_n += 1; } }
  w.opening_chunks = sr_mini(sr_maxi(opening_chunks, 0), w.n);
  return w;
}
// Same health for each chunk, order 0..count-1, every chunk required.
sr_rock_wall_init :: (count: int, chunk_health: f32, drill_dps: f32) -> SrRockWall {
  none := [1] int.[0];
  return sr_rock_wall_init_with_order(count, chunk_health, drill_dps, none[0..<0], count);
}
sr_rock_wall_chunk_broken :: (w: SrRockWall, i: int) -> bool { return i >= 0 && i < w.n && w.health[i] <= 0.0; }
sr_rock_wall_num_broken :: (w: SrRockWall) -> int { n := 0; for i: 0..<w.n { if w.health[i] <= 0.0 { n += 1; } } return n; }
sr_rock_wall_is_open :: (w: SrRockWall) -> bool { for i: 0..<w.opening_chunks { if w.health[w.break_order[i]] > 0.0 { return false; } } return true; }
// Share of the required chunks' health drilled away, 0..1 (UE-WALL-02).
sr_rock_wall_progress :: (w: SrRockWall) -> f32 {
  if w.opening_chunks <= 0 { return 1.0; }
  done : f32 = 0.0;
  for i: 0..<w.opening_chunks { h := w.health[w.break_order[i]] / w.start_health; done += 1.0 - (ifx h < 0.0 then 0.0 else ifx h > 1.0 then 1.0 else h); }
  p := done / cast(f32) w.opening_chunks;
  return ifx p < 0.0 then 0.0 else ifx p > 1.0 then 1.0 else p;
}
// A hit: a drill of `amount` seconds does amount * dps to the chunk at the cursor, the rest carrying on.
// Broken chunks are appended to broken (broken_n[0] counts them). Returns how many broke.
sr_rock_wall_apply :: (w: [] SrRockWall, kind: int, amount: f32, broken: [] int, broken_n: [] int) -> int {
  if kind != SR_WALL_HIT_DRILL || amount <= 0.0 || w[0].drill_dps <= 0.0 { return 0; }
  damage := amount * w[0].drill_dps; broke := 0;
  while damage > 0.0 && w[0].cursor < w[0].order_n {
    chunk := w[0].break_order[w[0].cursor];
    h := w[0].health[chunk];
    if h <= 0.0 { w[0].cursor += 1; continue; }
    taken := ifx h < damage then h else damage;
    h -= taken; damage -= taken;
    if h <= 0.0001 {
      h = 0.0;
      if broken_n[0] < broken.count { broken[broken_n[0]] = chunk; broken_n[0] += 1; }
      broke += 1; w[0].cursor += 1;
    }
    w[0].health[chunk] = h;
  }
  return broke;
}
