// Parity checks for time-of-day.coax: SpliceTests/Rules/SpliceTimeOfDayTests.cpp.
// rules.coax loads this file with `#load ... #test;`.

#test "Splice.Rules.TimeOfDay.DriveTurnsDayToDusk" {
  t := sr_time_of_day_tuning();
  #assert sr_step_beats(t, SR_PHASE_DAY, -790.0, -100.0) == SR_PHASE_DAY;
  #assert sr_step_beats(t, SR_PHASE_DAY, -561.0, -100.0) == SR_PHASE_DAY;
  #assert sr_step_beats(t, SR_PHASE_DAY, -560.0, -100.0) == SR_PHASE_DUSK;
  #assert sr_step_beats(t, SR_PHASE_DAY, -370.0, 500.0) == SR_PHASE_DUSK;
  #assert sr_step_beats(t, SR_PHASE_DAY, -370.0, 701.0) == SR_PHASE_DAY;
  #assert sr_step_beats(t, SR_PHASE_DAY, 0.0, 3.0) == SR_PHASE_DUSK;
}
#test "Splice.Rules.TimeOfDay.BeatsNeverMoveBack" {
  t := [1] SrTimeOfDayTuning.[sr_time_of_day_tuning()];
  #assert sr_step_beats(t[0], SR_PHASE_DUSK, -790.0, -100.0) == SR_PHASE_DUSK;
  #assert sr_step_beats(t[0], SR_PHASE_NIGHT, -370.0, 0.0) == SR_PHASE_NIGHT;
  _ = sr_time_beats_add(t[..], SrTimeBeat.{min_x = -1000.0, max_x = 1000.0, min_z = -1000.0, max_z = 1000.0, from = SR_PHASE_NIGHT, to = SR_PHASE_DAY});
  #assert sr_step_beats(t[0], SR_PHASE_NIGHT, 0.0, 0.0) == SR_PHASE_NIGHT;
}
#test "Splice.Rules.TimeOfDay.BlendOverFourSeconds" {
  t := sr_time_of_day_tuning();
  b := [1] SrTimeBlend.[sr_time_settled(SR_PHASE_DAY)];
  #assert sr_time_is_settled(b[0]) && sr_time_weight(b[0], SR_PHASE_DAY) == 1.0;
  sr_time_set_target(b[..], SR_PHASE_DUSK);
  dt : f32 = 1.0 / 60.0;
  for i: 0..<120 { sr_time_step(t, b[..], dt); }
  #assert abs(sr_time_weight(b[0], SR_PHASE_DUSK) - 0.5) < 0.001 && abs(sr_time_weight(b[0], SR_PHASE_DAY) - 0.5) < 0.001 && !sr_time_is_settled(b[0]);
  for i: 0..<121 { sr_time_step(t, b[..], dt); }
  #assert sr_time_is_settled(b[0]) && sr_time_weight(b[0], SR_PHASE_DAY) == 0.0;
  k := sr_blended_key_direction(b[0], false); d := sr_key_direction(SR_PHASE_DUSK, false);
  #assert abs(k.x - d.x) < 0.0001 && abs(k.y - d.y) < 0.0001 && abs(k.z - d.z) < 0.0001;
}
#test "Splice.Rules.TimeOfDay.ChangeMidBlendKeepsTheMix" {
  t := sr_time_of_day_tuning();
  b := [1] SrTimeBlend.[sr_time_settled(SR_PHASE_DAY)];
  sr_time_set_target(b[..], SR_PHASE_DUSK); sr_time_step(t, b[..], 2.0);
  sr_time_set_target(b[..], SR_PHASE_NIGHT);
  #assert abs(sr_time_weight(b[0], SR_PHASE_DUSK) - 0.5) < 0.00001;
  sr_time_step(t, b[..], 1.0);
  #assert abs(sr_time_weight(b[0], SR_PHASE_NIGHT) - 0.25) < 0.00001;
  #assert abs(sr_time_weight(b[0], SR_PHASE_DAY) - 0.375) < 0.00001 && abs(sr_time_weight(b[0], SR_PHASE_DUSK) - 0.375) < 0.00001;
  sum : f32 = 0.0; for w: b[0].weights { sum += w; }
  #assert abs(sum - 1.0) < 0.00001;
  sr_time_step(t, b[..], 10.0);
  #assert sr_time_is_settled(b[0]);
}
#test "Splice.Rules.TimeOfDay.KeyLightAndClock" {
  for i: 0..<SR_PHASE_COUNT { d := sr_key_direction(i, false); #assert abs(d3_len(d) - 1.0) < 0.0001 && d.y > 0.0; }
  farm := (PI_D / 2.0 - acos_d(sr_key_direction(SR_PHASE_DAY, true).y)) * 180.0 / PI_D;
  plain := (PI_D / 2.0 - acos_d(sr_key_direction(SR_PHASE_DAY, false).y)) * 180.0 / PI_D;
  #assert abs(farm - 19.3) < 0.5 && abs(plain - 41.3) < 0.5;
  #assert sr_time_clock(SR_PHASE_DUSK) == 0.78 && sr_time_clock(SR_PHASE_NIGHT) == 0.0;
}
#test "Splice.Rules.TimeOfDay.HallwayOpensNight" {
  #assert sr_after_hallway_opened(SR_PHASE_DAY) == SR_PHASE_NIGHT && sr_after_hallway_opened(SR_PHASE_NIGHT) == SR_PHASE_NIGHT;
  #assert sr_hallway_plugs_cleared(3, 0) && !sr_hallway_plugs_cleared(0, 0) && !sr_hallway_plugs_cleared(3, 1);
  #assert sr_entered_lab_from_ring("l_lab", "L_RING") && !sr_entered_lab_from_ring("L_Lab", "L_Farm");
}
