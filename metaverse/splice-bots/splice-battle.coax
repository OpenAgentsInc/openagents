// Splice Bots' battles, the drill mech, the boss and the ending (slice 1, part C, #13505).
//
// Bots fight Pokémon-style on the engine's bot battles (metaverse-engine/action/bot-battle.coax): each
// bot holds up to four software cards, which are its moves (keys 1 to 4); its battery is its energy and
// big moves cost more charge; every bot has a health bar, and a bot at zero powers down until it is
// repaired at Sniper's charger. A core swap in a battle works like switching: E moves Digger's core
// between the bodies on your side.
//
//   the drill mech   a giant raider mech with a drill arm, left in an empty ring section. E beside it
//                    swaps Digger's brain core in (quick, no edit bay): its lights turn Digger's, it
//                    follows you as Digger did, and E at the blocked hallway has it drill through.
//   the raider mech  on the drive across the desert a raider mech gives chase: outrun it (W), or battle
//                    it from Sniper (E while it is near), Sniper fielded with its cards.
//   the boss         a dinosaur-shaped bot glowing blue, behind the hallway. The drill mech battles it
//                    (1 to 4). It sweeps its arm, then below half health it charges. A hit that stuns it,
//                    a daze after a charge, or its health run out opens its three weak points: stun all
//                    three (F) and it powers down, drops its banned core, and night falls. You lose if
//                    your health or the mech's runs out.
//   the ending       the core spliced at Sniper's edit bay plays a 15-second memory hologram, then
//                    SCENE RESTORED, then the mission's teaser.
//
// Places come from the landmarks table where it has rows for them (LM_MECH, LM_RAIDER_MECH), so the
// realm tooling can move them; without rows they stand where this file puts them.
#load "../../metaverse-engine/action/bot-battle.coax";
#load "../../metaverse-engine/action/telegraph.coax";   // an attack's beats: wind-up, lock, impact, recovery (#13552)

// The bots the game keeps between battles: their health and battery outlive a fight.
SB_DIGGER :: 0; SB_MECH :: 1; SB_SNIPER :: 2; SB_RAIDER :: 3; SB_BOSS :: 4; SB_BOTS :: 5;
// Cards: the realm's ids for the moves. MOVE, DRILL and DRILL+ are Digger's cards (the software in his
// core); the rest are the bodies' own.
SBC_MOVE :: 1; SBC_DRILL :: 2; SBC_PLUS :: 3; SBC_SLAM :: 4; SBC_STOMP :: 5; SBC_FLARE :: 6; SBC_ARM :: 7; SBC_CLAW :: 8; SBC_BITE :: 9; SBC_TAIL :: 10;
// What a battle is: none, the raider mech against Sniper, the boss against the drill mech.
SBF_NONE :: 0; SBF_DESERT :: 1; SBF_BOSS :: 2;
LM_MECH :: 81; LM_RAIDER_MECH :: 92;      // where the drill mech waits (the tables' "Drill mech", in the empty section, C1), where the raider mech keeps watch
// The messages (msg_text hands MSG >= SBM_FIRST here).
SBM_FIRST :: 50; SBM_CORE_IN :: 50; SBM_CORE_OUT :: 51; SBM_DRILLING :: 52; SBM_NEED_MECH :: 53; SBM_HUNT :: 54;
SBM_RM_GONE :: 56; SBM_RM_DOWN :: 57; SBM_SNIPER_DOWN :: 58; SBM_BOSS :: 59; SBM_CHARGES :: 60; SBM_OPEN :: 61; SBM_SHUT :: 62;
SBM_REPAIR :: 63; SBM_DIGGER_DOWN :: 64; SBM_SWAP :: 65; SBM_REFUSED :: 66; SBM_MECH_DOWN :: 67; SBM_CORE_DROP :: 68; SBM_LEAD :: 69;

// Tuning.
SB_MECH_REACH :: 3.5f32;    // E this near the mech swaps the core
SB_HALL_REACH :: 6.0f32;    // E this near the blocked hallway has the mech drill
SB_DRILL_TIME :: 3.0f32;    // seconds the mech drills the hallway
SB_AUTO_DRILL :: 10.0f32;   // m: the mech with Digger's core this near the blocked hallway starts drilling it on its own (#13505 playtest 2)
// The drill mech's size (playtest 2: at 1.25 it stood on top of her): about twice her height, and
// its body's radius and top as the camera and her keep clear of them.
SB_MECH_S :: 0.95f32; SB_MECH_R :: 1.85f32; SB_MECH_TOP :: 4.6f32;
SB_MECH_SPEED :: 7.0f32; SB_BODY_SPEED :: 5.0f32;
// The raider mech's chase on the drive: it keeps watch beside the route, a third of the way from the rail stop to the
// garage; it gives chase when Sniper passes within SB_RM_NOTICE, runs beside it at SB_RM_SIDE, claws it within
// SB_RM_CLAW_REACH, gives up when Sniper gets SB_RM_GIVE_UP away (top speed outruns it) and turns back near the garage.
SB_RM_CHASE :: 16.0f32;     // m/s: faster than Sniper's cruise (T_RAIL_SPEED), slower than its top speed (T_RAIL_FAST)
SB_RM_NOTICE :: 16.0f32; SB_RM_GIVE_UP :: 20.0f32; SB_RM_WATCH :: 12.0f32; SB_RM_SIDE :: 2.9f32;
SB_RM_CLAW_REACH :: 4.5f32; SB_RM_CLAW_EVERY :: 1.3f32; SB_RM_QUIT :: 12.0f32;   // m before the garage it turns back
SB_SNIPER_REACH :: 12.0f32; // E on the drive starts the battle while the raider mech is this near Sniper
SB_THINK :: 0.7f32;         // seconds between a foe's moves
SB_AUTO :: 2.0f32;          // seconds without a move key before your fielded bot fights on its own
SB_REPAIR :: 1.5f32;        // seconds at Sniper's charger to repair a bot
SB_CHARGE_EVERY :: 5.0f32; SB_CHARGE_SPEED :: 14.0f32; SB_CHARGE_TIME :: 1.2f32; SB_DAZE :: 2.6f32;
SB_SWEEP_HIT :: 3; SB_CHARGE_HIT :: 6;
SB_RESTORED :: 3.0f32;      // seconds SCENE RESTORED holds before the mission's teaser
SB_DINO_S :: 0.8f32;        // the dinosaur's scale: 3.7 m tall, 7 m long

// ---- Enemy attacks (#13552, lane E): every timing in one table, in seconds. Each attack winds up (it still
// turns to follow), locks (its aim is fixed: a dodge from here on works), strikes, and recovers (its
// opening). The README's "Enemy attacks" gives each value and why.
SB_BLOW :: TgBeats.{wind = 0.6, lock = 0.25, hit = 0.15, rest = 0.9};                      // a raider or Imperial robot on foot
SB_SWEEP :: TgBeats.{wind = T_SWEEP_WARN, lock = 0.3, hit = T_SWEEP_TIME, rest = 1.1};      // the boss's tail sweep (phase one)
SB_CHARGE :: TgBeats.{wind = 0.7, lock = 0.4, hit = SB_CHARGE_TIME, rest = SB_DAZE};       // the boss's charge (phase two): the daze is its recovery
SB_CLAW :: TgBeats.{wind = 0.55, lock = 0.25, hit = 0.12, hold = 0.4, rest = 1.3, n = 2};  // the raider mech's two claws on the drive
SB_CARD :: TgBeats.{wind = 0.5, lock = 0.2, hit = 0.1, rest = 0.3};                        // a foe's card in a bot battle
SB_GAP :: 0.45f32;          // s: the least time from one impact's end to the next release, whoever attacks
SB_BLOW_START :: 1.7f32;    // m: a foe after her starts its blow this near
SB_BLOW_REACH :: 1.6f32; SB_BLOW_HALF :: 0.75f32;   // m and radians to each side: the blow's wedge
SB_JUMP_CLEAR :: 0.45f32;   // m: feet this high clear the tail sweep
SB_TAIL_W :: 0.7f32;        // m to each side of the tail's line that it hits her: its drawn width plus her body
SB_CLAW_R :: 2.4f32;        // m: the claw's ring round where it locked on Sniper
SB_CHARGE_W :: 2.4f32;      // m: the charge's half width, its reach on her
SB_CUE :: 0.9f32;           // s: HIT or DODGED shows over her

// The enemies' attacks (#13552), kept apart from the battles' state: the lane they share, each foe's blow (its
// clock, 0 idle, and its aim), the raider mech's claws (clock, -1 idle, the spot it locked, Sniper's place a
// step ago), a foe's card winding up in a battle (clock, -1 idle, the card's slot), whether her sweep or charge
// was aimed at her and landed, and the last attack on her, landed or dodged, with where it came from.
SpAttacks :: struct {
  lane: [1] TgLane; ft: [FOES] f32; fa: [FOES] f32; claw_t: f32 = -1; claw_x: f32; claw_z: f32; was_x: f32; was_z: f32;
  card_t: f32 = -1; card_k: int; sweep_aim: bool; sweep_hit: bool;
  cue_t: f32; cue_hit: bool; cue_x: f32; cue_z: f32;
}

SpBattle :: struct {
  bots: [SB_BOTS] BbBot;
  fight: [1] BbBattle; kind: int; crew: [BB_CREW] int; crew_n: int; foe: int = -1;
  think: f32;                 // to the foe's next move
  idle: f32;                  // seconds since your last move key: past SB_AUTO your fielded bot fights on its own
  hit_t: f32; hit_side: int; hit_dmg: int;   // the last hit, for its number over the bot
  // the drill mech: where it stands, whether Digger's core is in it (and ever was), the hallway's drilling
  mech_x: f32; mech_z: f32; mech_yaw: f32; mech_core: bool; mech_used: bool; drill_t: f32; mech_step: f32;
  // the raider mech on the drive: chasing, given up (it does not come back this drive), down; its next claw
  rm_x: f32; rm_z: f32; rm_yaw: f32; rm_hunt: bool; rm_gone: bool; rm_down: bool; rm_step: f32; rm_claw: f32;
  // the boss: where it stands and faces, its charge (wind-up, rush, daze) and whether its second phase began
  dino_x: f32; dino_z: f32; dino_yaw: f32; charge_t: f32; wind: f32; rush: f32; rush_dx: f32; rush_dz: f32; rush_hit: bool; daze: f32; half: bool; swept: bool;
  repair_t: f32;
  refusal: int;                // why the last press of yours was refused (BbVerdict)
  end_t: f32; teaser: bool;   // the ending: time on SCENE RESTORED, and the mission's teaser after it
}

// ---- the bots and their cards
sb_feel :: (id: int, sound: string, m: DeedMove) -> DeedFeel { return DeedFeel.{anim = id, fx = id, sound = sound, move = m}; }
// Card `id` in body `body`: the drill mech's giant arm drills harder and further than Digger's.
sb_card :: (id: int, body: int) -> BbCard {
  big := body == SB_MECH;
  if id == SBC_MOVE { return bb_card(id, ifx big then 2 else 1, 8, 0.6, ifx big then 5.0f32 else 3.0f32, 0, sb_feel(id, "ram", DeedMove.lunge)); }
  if id == SBC_DRILL { return bb_card(id, ifx big then 6 else 3, 30, 2.2, ifx big then 5.5f32 else 2.8f32, ifx big then 3.0f32 else 1.5f32, sb_feel(id, "drill", DeedMove.plant)); }
  if id == SBC_PLUS { return bb_card(id, ifx big then 9 else 5, 50, 3.2, ifx big then 5.5f32 else 2.8f32, ifx big then 4.0f32 else 2.5f32, sb_feel(id, "drill", DeedMove.plant)); }
  if id == SBC_SLAM { return bb_card(id, 4, 15, 1.2, 5.5, 0.5, sb_feel(id, "slam", DeedMove.step)); }
  if id == SBC_STOMP { return bb_card(id, 2, 10, 1.6, 7.0, 1.0, sb_feel(id, "stomp", DeedMove.plant)); }
  if id == SBC_FLARE { return bb_card(id, 1, 25, 4.0, 16.0, 1.5, sb_feel(id, "flare", DeedMove.still)); }
  if id == SBC_ARM { return bb_card(id, 3, 12, 1.0, 6.0, 0, sb_feel(id, "arm", DeedMove.still)); }
  if id == SBC_CLAW { return bb_card(id, 3, 14, 1.3, 4.5, 0, sb_feel(id, "claw", DeedMove.lunge)); }
  if id == SBC_BITE { return bb_card(id, 5, 30, 2.6, 6.0, 0, sb_feel(id, "bite", DeedMove.lunge)); }
  return bb_card(SBC_TAIL, 3, 16, 1.8, 7.5, 0.6, sb_feel(SBC_TAIL, "tail", DeedMove.plant));
}
sb_card_name :: (id: int) -> string {
  names := [11] string.["", "MOVE", "DRILL", "DRILL+", "SLAM", "STOMP", "FLARE", "ARM", "CLAW", "BITE", "TAIL"];
  return ifx id >= 1 && id <= 10 then names[id] else "";
}
sb_bot_name :: (b: int) -> string { names := [SB_BOTS] string.["DIGGER", "DRILL MECH", "SNIPER", "RAIDER MECH", "THE BOSS"]; return ifx b >= 0 && b < SB_BOTS then names[b] else ""; }
// Digger's cards: the ones spliced onto his strip, each once, in order (his core's software).
sb_core_cards :: (g: [] SpGame, out: [] int) -> int {
  n := 0;
  for i: 0..<g[0].strip_n {
    c := g[0].strip[i]; id := ifx c == H_MOVE then SBC_MOVE else ifx c == H_DRILL then SBC_DRILL else ifx c == H_PLUS then SBC_PLUS else 0;
    seen := false; for k: 0..<n { if out[k] == id { seen = true; } }
    if id > 0 && !seen && n < out.count { out[n] = id; n += 1; }
  }
  return n;
}
// A body's cards as it is now: Digger's and the mech's come from Digger's core (the mech adds its own
// two), the others are their bodies' own.
sb_arm :: (g: [] SpGame, b: int) {
  bot := g[0].bt[0].bots[b..<b + 1];
  bb_clear(bot);
  ids: [BB_CARDS] int; n := 0;
  if b == SB_DIGGER || b == SB_MECH { n = sb_core_cards(g, ids[..]); }
  if b == SB_MECH { for extra: [2] int.[SBC_SLAM, SBC_STOMP] { if n < BB_CARDS { ids[n] = extra; n += 1; } } }
  if b == SB_SNIPER { ids[0] = SBC_MOVE; ids[1] = SBC_ARM; ids[2] = SBC_FLARE; n = 3; }
  if b == SB_RAIDER { ids[0] = SBC_CLAW; ids[1] = SBC_STOMP; n = 2; }
  if b == SB_BOSS { ids[0] = SBC_BITE; ids[1] = SBC_TAIL; n = 2; }
  for i: 0..<n { _ := bb_give(bot, sb_card(ids[i], b)); }
}
sb_mark :: (g: [] SpGame, id: int, x: f32, z: f32) -> Point { m := sc_mark(g[0].c[..], id); return ifx m.id == id then v3(m.x, 0, m.z) else v3(x, 0, z); }
// A new run's bots: everyone whole, the drill mech empty in its section, the raider mech at its watch, the boss at home.
sb_reset :: (g: [] SpGame) {
  t := g[0].bt[..];
  t[0] = SpBattle.{};
  t[0].bots[SB_DIGGER] = bb_bot(SB_DIGGER, 12, 60, 8); t[0].bots[SB_DIGGER].vit = g[0].dr[0].hp;   // his health is the Director's (director.coax)
  t[0].bots[SB_MECH] = bb_bot(SB_MECH, 45, 100, 12);
  t[0].bots[SB_SNIPER] = bb_bot(SB_SNIPER, 24, 80, 10);
  t[0].bots[SB_RAIDER] = bb_bot(SB_RAIDER, 16, 60, 8);
  t[0].bots[SB_BOSS] = bb_bot(SB_BOSS, 70, 120, 10);
  // in the empty section's bay (C1), facing the field; without a row, the middle of that bay
  h := ga_bay_at(g, GA_EMPTY); m := sb_mark(g, LM_MECH, h.x, h.z); t[0].mech_x = m.x; t[0].mech_z = m.z;
  t[0].mech_yaw = atan2(g[0].at.gar_x - m.x, g[0].at.gar_z - m.z);
  sb_rm_home(g);
  sb_dino_home(g);
  g[0].ak[0] = SpAttacks.{};
}
// Where along the route it keeps watch, and where it turns back.
sb_rm_watch_s :: () -> f32 { return T_RAIL_PING + (T_RAIL - T_RAIL_PING) * 0.3; }
sb_rm_quit_s :: () -> f32 { return T_RAIL - SB_RM_QUIT; }
// A point beside the route at s: `side` metres to the rover's right (ahead is (sin yaw, cos yaw), right (-cos yaw, sin yaw)).
sb_beside :: (g: [] SpGame, s: f32, side: f32) -> Point { c := rail_at(g, s); y := rail_yaw(g, s); return v3(c.x - cos(y) * side, 0, c.z + sin(y) * side); }
sb_rm_post :: (g: [] SpGame) -> Point { p := sb_beside(g, sb_rm_watch_s(), SB_RM_WATCH); return sb_mark(g, LM_RAIDER_MECH, p.x, p.z); }
sb_rm_home :: (g: [] SpGame) { p := sb_rm_post(g); t := g[0].bt[..]; t[0].rm_x = p.x; t[0].rm_z = p.z; t[0].rm_yaw = rail_yaw(g, sb_rm_watch_s()) + PI * 0.5; t[0].rm_hunt = false; t[0].rm_gone = false; t[0].rm_claw = 0; }
sb_dino_home :: (g: [] SpGame) {
  t := g[0].bt[..];
  t[0].dino_x = g[0].at.boss_x; t[0].dino_z = g[0].at.boss_z; t[0].dino_yaw = 0;
  t[0].charge_t = 0; t[0].wind = 0; t[0].rush = 0; t[0].daze = 0; t[0].half = false;
  sb_dino_body(g);
}
// The boss's collider (layer.coax) stands where the boss does: the engine's World moves its body with it.
sb_dino_body :: (g: [] SpGame) { t := g[0].bt[0]; sl_body_to(g, g[0].ws[0].boss, t.dino_x, t.dino_z, t.dino_yaw); }
// The stills and checks stand in a moment of the run (g_stage): from the boss chamber on, Digger's core is in the mech
// beside you. Two moments of the battles' own: 20, Sniper battling the raider mech on the drive at dusk; 21, the boss
// below half health, about to charge.
sb_stage :: (g: [] SpGame, n: int) {
  t := g[0].bt[..];
  if n == 20 {
    g[0].zone = Z_RAIL; g[0].phase = PH_DUSK; g[0].pinged = true; g[0].taken[H_BATTERY] = true; g[0].have[H_BATTERY] = true;
    g[0].mode = M_RIDE; g[0].rail_s = sb_rm_watch_s() + 25; g[0].rail_v = T_RAIL_SLOW;
    r := sb_beside(g, g[0].rail_s, SB_RM_SIDE); t[0].rm_x = r.x; t[0].rm_z = r.z; t[0].rm_yaw = rail_yaw(g, g[0].rail_s); t[0].rm_hunt = true;
    crew := [1] int.[SB_SNIPER]; sb_begin(g, SBF_DESERT, crew[..], SB_RAIDER);
    return;
  }
  if n == 21 { g[0].wall_gone = true; g[0].px = 1.5; g[0].pz = g[0].at.wall_z - 2.5; g[0].yaw = PI; g[0].heat = 40; g[0].have[H_PLUS] = true; g[0].taken[PICK_PLUS] = true; }
  if n < 10 || (n > 12 && n != 21) { return; }
  t[0].mech_core = true; t[0].mech_used = true; t[0].mech_x = g[0].px + 3.5; t[0].mech_z = g[0].pz - 3; t[0].mech_yaw = PI;   // ahead of her, toward the boss
  if n == 21 { t[0].bots[SB_BOSS].vit.hp = 30; t[0].half = true; t[0].charge_t = SB_CHARGE_EVERY - 1.5; }
}

// ---- where things are
sb_desert :: (g: [] SpGame) -> bool { return g[0].zone == Z_RAIL; }
// On the road, where the raider mech hunts: the rail ride (M_RIDE), or the drive from the solar farm to the garage (M_DRIVE, drive.coax).
sb_road :: (g: [] SpGame) -> bool { return g[0].mode == M_DRIVE || (sb_desert(g) && g[0].mode == M_RIDE); }
sb_road_yaw :: (g: [] SpGame) -> f32 { if g[0].mode == M_DRIVE { return g[0].dv[0].syaw; } return rail_yaw(g, g[0].rail_s); }
sb_road_beside :: (g: [] SpGame, side: f32) -> Point { c := sb_sniper_at(g); y := sb_road_yaw(g); return v3(c.x - cos(y) * side, 0, c.z + sin(y) * side); }
// Near the road's end it turns back; it runs at its own speed on the rail, and a pace above the rover's cruise on the drive.
sb_road_end :: (g: [] SpGame) -> bool { if g[0].mode == M_DRIVE { return dv_s(g) >= DV_RM_QUIT; } return g[0].rail_s >= sb_rm_quit_s(); }
sb_rm_speed :: (g: [] SpGame) -> f32 { return SB_RM_CHASE; }
// How near it notices Sniper, and how far behind it gives up: on the drive she can pass it anywhere across the desert.
sb_rm_notice :: (g: [] SpGame) -> f32 { return ifx g[0].mode == M_DRIVE then DV_RM_NOTICE else SB_RM_NOTICE; }
sb_rm_give_up :: (g: [] SpGame) -> f32 { return ifx g[0].mode == M_DRIVE then DV_RM_GIVE_UP else SB_RM_GIVE_UP; }
sb_sniper_at :: (g: [] SpGame) -> Point { if g[0].mode == M_DRIVE { return v3(g[0].dv[0].sx, 0, g[0].dv[0].sz); } if g[0].zone == Z_RAIL { return rail_at(g, g[0].rail_s); } return v3(g[0].at.rover_x, 0, g[0].at.rover_z); }
sb_in_chamber :: (g: [] SpGame, z: f32) -> bool { return g[0].zone == Z_MINE && g[0].wall_gone && z < g[0].at.wall_z - 1.5; }
// The boss's frame, and its three weak points on its body: the neck, the left flank and the root of the tail.
sb_dino_frame :: (g: [] SpGame) -> Frame { return frame_at(v3(g[0].bt[0].dino_x, 0, g[0].bt[0].dino_z), g[0].bt[0].dino_yaw); }
sb_weak_at :: (g: [] SpGame, i: int) -> Point {
  f := sb_dino_frame(g); s := SB_DINO_S;
  if i == 0 { return fp(f, 0, 3.3 * s, 2.2 * s); }
  if i == 1 { return fp(f, -1.25 * s, 2.5 * s, 0); }
  return fp(f, 0, 2.7 * s, -2.4 * s);
}
// The boss's weak points can be stunned while it reels from a hit, is dazed after a charge, or has no health left.
sb_open :: (g: [] SpGame) -> bool {
  t := g[0].bt[0]; b := sb_boss(g);
  return !g[0].boss_down && g[0].wall_gone && (t.daze > 0 || b.vit.down || (t.kind == SBF_BOSS && t.fight[0].now < b.stun_until));
}
// The boss's record: in the battle while one is on, else the kept one.
sb_boss :: (g: [] SpGame) -> BbBot { t := g[0].bt[0]; return ifx t.kind == SBF_BOSS then bb_active(t.fight[0], 1) else t.bots[SB_BOSS]; }
// The weak point in F's reach, or -1.
sb_weak_near :: (g: [] SpGame) -> int {
  if !sb_open(g) { return -1; }
  for i: 0..<3 { w := sb_weak_at(g, i); if g[0].stun[i] <= 0 && dist2(g[0].px, g[0].pz, w.x, w.z) < T_STUN_RANGE { return i; } }
  return -1;
}
// Where the banned core lies once the boss is down: under its chest.
sb_core_at :: (g: [] SpGame) -> Point { return fp(sb_dino_frame(g), 0, 0, 1.6); }
// Digger's body sits still while his core is in the mech, or a battle has him fielded. Powered down,
// the Director's tow and charger have him (director.coax).
sb_holds_digger :: (g: [] SpGame) -> bool {
  t := g[0].bt[0];
  if t.kind != SBF_NONE && t.fight[0].on && sb_fielded(g) == SB_DIGGER { return true; }
  return t.mech_core;
}
// The bot fielded on your side, or -1.
sb_fielded :: (g: [] SpGame) -> int { t := g[0].bt[0]; if t.kind == SBF_NONE { return -1; } return t.crew[t.fight[0].sides[0].active]; }
sb_fighting :: (g: [] SpGame) -> bool { return g[0].bt[0].kind != SBF_NONE; }
sb_body_at :: (g: [] SpGame, b: int) -> Point {
  t := g[0].bt[0];
  if b == SB_DIGGER { return v3(g[0].bot_x, 0, g[0].bot_z); }
  if b == SB_MECH { return v3(t.mech_x, 0, t.mech_z); }
  if b == SB_SNIPER { return sb_sniper_at(g); }
  if b == SB_RAIDER { return v3(t.rm_x, 0, t.rm_z); }
  return v3(t.dino_x, 0, t.dino_z);
}

// ---- battles
// Begins a battle: your crew (by bot) against one foe. Each body's cards are what it holds now.
sb_begin :: (g: [] SpGame, kind: int, crew: [] int, foe: int) {
  t := g[0].bt[..];
  t[0].bots[SB_DIGGER].vit = g[0].dr[0].hp;
  mine: [BB_CREW] BbBot; n := 0;
  for b: crew { if n < BB_CREW { sb_arm(g, b); mine[n] = t[0].bots[b]; t[0].crew[n] = b; n += 1; } }
  t[0].crew_n = n;
  sb_arm(g, foe);
  theirs := [1] BbBot.[t[0].bots[foe]];
  bb_begin(t[0].fight[..], mine[0..<n], theirs[..]);
  t[0].kind = kind; t[0].foe = foe; t[0].think = SB_THINK; g[0].ak[0].card_t = -1;
}
// The battle's records back into the kept bots, and the battle over.
sb_finish :: (g: [] SpGame) {
  t := g[0].bt[..];
  if t[0].kind == SBF_NONE { return; }
  f := t[0].fight[0];
  for i: 0..<t[0].crew_n { t[0].bots[t[0].crew[i]] = f.sides[0].bots[i]; }
  if t[0].foe >= 0 { t[0].bots[t[0].foe] = f.sides[1].bots[0]; }
  bb_end(t[0].fight[..]); t[0].kind = SBF_NONE; t[0].foe = -1;
}
// The fielded bot's distance to the foe.
sb_gap :: (g: [] SpGame) -> f32 {
  me := sb_body_at(g, sb_fielded(g)); foe := sb_body_at(g, g[0].bt[0].foe);
  return dist2(me.x, me.z, foe.x, foe.z);
}
// Keys 1 to 4 in a battle: your fielded bot uses that card on the foe. True when a battle took the key.
sb_move :: (g: [] SpGame, slot: int) -> bool {
  if !sb_fighting(g) { return false; }
  t := g[0].bt[..];
  t[0].idle = 0;
  h := bb_use(t[0].fight[..], 0, slot, sb_gap(g));
  if h.verdict == BbVerdict.ok { t[0].hit_t = 0.9; t[0].hit_side = 1; t[0].hit_dmg = h.damage; g[0].flash = 0.15; }
  else if h.verdict != BbVerdict.cooling && h.verdict != BbVerdict.waiting { g_say(g, SBM_REFUSED); g[0].msg_t = 1.2; t[0].refusal = cast(int) h.verdict; }
  return true;
}
// E in a battle: Digger's core goes to the next body on your side (switching).
sb_swap :: (g: [] SpGame) -> bool {
  t := g[0].bt[..];
  if !sb_fighting(g) { return false; }
  to := bb_next(t[0].fight[0].sides[0]);
  if to >= 0 && bb_swap(t[0].fight[..], 0, to) {
    b := t[0].crew[to];
    if b == SB_DIGGER || b == SB_MECH { t[0].mech_core = b == SB_MECH; }
    g_say(g, SBM_SWAP);
  }
  return true;
}

// ---- input
// E: a core swap in a battle; the drill mech; the hallway; battle the raider mech from Sniper. True when one of these took it.
sb_use :: (g: [] SpGame) -> bool {
  t := g[0].bt[..];
  if g[0].mode != M_PLAY { return false; }
  if sb_fighting(g) { return sb_swap(g); }
  if g[0].zone == Z_MINE {
    // the banned core in reach comes first
    co := sb_core_at(g);
    if (g[0].boss_down && !g[0].core_taken && dist2(g[0].px, g[0].pz, co.x, co.z) < T_PICK_RANGE) { return false; }
    // the hallway: the mech, with Digger's core, drills it down
    if !g[0].wall_gone && t[0].drill_t <= 0 && dist2(g[0].px, g[0].pz, 0, g[0].at.wall_z + 1) < SB_HALL_REACH {
      if t[0].mech_core && dist2(t[0].mech_x, t[0].mech_z, 0, g[0].at.wall_z + 1) < 14 { t[0].drill_t = SB_DRILL_TIME; g_say(g, SBM_DRILLING); }
      else { g_say(g, SBM_NEED_MECH); }
      return true;
    }
    // the mech: Digger's core in, or back out
    if g[0].bot && !d_down(g) && dist2(g[0].px, g[0].pz, t[0].mech_x, t[0].mech_z) < SB_MECH_REACH {
      // until the hallway is open the core stays in: an E beside the mech (it walks close behind you) never
      // leaves it empty on the way, which stranded the playtest's run (#13505 playtest 2)
      if t[0].mech_core && !g[0].wall_gone { g_say(g, SBM_LEAD); return true; }
      t[0].mech_core = !t[0].mech_core; t[0].mech_used = true; g[0].flash = 0.25;
      if !t[0].mech_core { g_bot_home(g); }
      g_say(g, ifx t[0].mech_core then SBM_CORE_IN else SBM_CORE_OUT);
      return true;
    }
  }
  return false;
}
// The raider mech near enough on the drive to battle it from Sniper.
sb_can_battle_rm :: (g: [] SpGame) -> bool {
  t := g[0].bt[0];
  if !sb_road(g) || sb_fighting(g) || !t.rm_hunt || t.rm_down || t.bots[SB_SNIPER].vit.down { return false; }
  s := sb_sniper_at(g);
  return dist2(t.rm_x, t.rm_z, s.x, s.z) < SB_SNIPER_REACH;
}
// A key on the drive (M_RIDE): E battles the raider mech from Sniper, and in that battle 1 to 4 are Sniper's cards.
// True when the chase took it.
sb_ride_key :: (g: [] SpGame, key: int, down: bool) -> bool {
  if !down || !sb_road(g) { return false; }
  if key >= '1' && key <= '4' { return sb_move(g, key - '1'); }
  if key == 'e' || key == 'E' {
    if sb_fighting(g) { return true; }
    if !sb_can_battle_rm(g) { return false; }
    crew := [1] int.[SB_SNIPER]; sb_begin(g, SBF_DESERT, crew[..], SB_RAIDER);
    return true;
  }
  return false;
}
// F: a weak point of the boss's in reach. True when it took it.
sb_stun :: (g: [] SpGame) -> bool {
  t := g[0].bt[..];
  i := sb_weak_near(g);
  if i >= 0 {
    g[0].stun[i] = T_STUN_TIME; g[0].flash = 0.25; g_say(g, MSG_STUN);
    if t[0].kind == SBF_BOSS { bb_stun(t[0].fight[..], 1, deed_tick(1.0)); }
    if g[0].stun[0] > 0 && g[0].stun[1] > 0 && g[0].stun[2] > 0 { sb_boss_down(g); }
    return true;
  }
  return false;
}
// All three weak points down: it powers down, drops its banned core, and night falls.
sb_boss_down :: (g: [] SpGame) {
  sb_finish(g);
  g[0].boss_down = true; g[0].phase = PH_NIGHT; g[0].flash = 0.6; g_say(g, SBM_CORE_DROP);
  g[0].bt[0].daze = 0; g[0].bt[0].rush = 0; g[0].bt[0].wind = 0;
}
// Keys 1 to 4 in play: the Director hands each press over once (d_take_move); a battle makes it a move.
sb_keys :: (g: [] SpGame) {
  for i: 0..<8 { m := d_take_move(g); if m <= 0 { return; } _ := sb_move(g, m - 1); }
}
// Digger's health is the Director's (dr.hp, director.coax): the battle reads it before a step and,
// while he is in a battle's crew, writes his hits back after it.
sb_digger_in :: (g: [] SpGame) {
  t := g[0].bt[..];
  t[0].bots[SB_DIGGER].vit = g[0].dr[0].hp;
  if t[0].kind == SBF_NONE { return; }
  for i: 0..<t[0].crew_n { if t[0].crew[i] == SB_DIGGER { t[0].fight[0].sides[0].bots[i].vit = g[0].dr[0].hp; } }
}
sb_digger_out :: (g: [] SpGame) {
  t := g[0].bt[..];
  if t[0].kind != SBF_NONE { for i: 0..<t[0].crew_n { if t[0].crew[i] == SB_DIGGER { t[0].bots[SB_DIGGER] = t[0].fight[0].sides[0].bots[i]; } } }
  g[0].dr[0].hp = t[0].bots[SB_DIGGER].vit;
}

// ---- a step
sb_toward :: (x: [] f32, z: [] f32, yaw: [] f32, tx: f32, tz: f32, speed: f32, stop: f32, dt: f32) -> f32 {
  dx := tx - x[0]; dz := tz - z[0]; d := sqrt(dx * dx + dz * dz);
  if d <= stop || d < 0.0001 { return d; }
  k := lo(d - stop, speed * dt);
  x[0] += dx / d * k; z[0] += dz / d * k;
  yaw[0] = atan2(dx, dz);
  return d - k;
}
sb_step :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  if t[0].hit_t > 0 { t[0].hit_t -= dt; }
  if g[0].ak[0].cue_t > 0 { g[0].ak[0].cue_t -= dt; }
  sb_digger_in(g);
  sb_keys(g);
  // a run kept from the boss chamber on (front.coax): Digger's core is in the mech, beside the open hallway
  if g[0].wall_gone && !g[0].boss_down && !t[0].mech_used { t[0].mech_used = true; t[0].mech_core = true; t[0].mech_x = 2.5; t[0].mech_z = g[0].at.wall_z - 2; }
  sb_mech_step(g, dt);
  sb_boss_step(g, dt);
  sb_battle_step(g, dt);
  sb_repair_step(g, dt);
  sb_digger_out(g);
}
// The drill mech: it follows you while Digger's core is in it, and drills the hallway when asked.
sb_mech_step :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  mx := [1] f32.[t[0].mech_x]; mz := [1] f32.[t[0].mech_z]; my := [1] f32.[t[0].mech_yaw];
  if t[0].drill_t > 0 {
    // to the hallway's face, then the drill turns until it gives
    left := sb_toward(mx[..], mz[..], my[..], 0, g[0].at.wall_z + 2.6, SB_MECH_SPEED, 0.05, dt);
    if left <= 0.1 { my[0] = PI; t[0].drill_t -= dt; }
    if t[0].drill_t <= 0 { g[0].wall_gone = true; g[0].flash = 0.6; g_say(g, MSG_BROKE); g[0].bt[0].drill_t = 0; }
  } else if t[0].mech_core && g[0].zone == Z_MINE && !g[0].wall_gone && !sb_fighting(g) && dist2(mx[0], mz[0], 0, g[0].at.wall_z + 1) < SB_AUTO_DRILL {
    // led to the blocked hallway, it starts drilling it on its own: no key to find (#13505 playtest 2)
    t[0].drill_t = SB_DRILL_TIME; g_say(g, SBM_DRILLING);
  } else if t[0].mech_core && g[0].zone == Z_MINE && !(sb_fighting(g) && sb_fielded(g) == SB_MECH) {
    // at your left, its own width and a stride out, a little ahead (playtest 2: behind you it stood on
    // top of you and in the camera's way)
    h := sb_mech_spot(g); tx := h.x; tz := h.z;
    _ := sb_toward(mx[..], mz[..], my[..], tx, tz, SB_MECH_SPEED * clamp(dist2(mx[0], mz[0], tx, tz) / 3, 0.2, 1.6), 0.3, dt);
    q := cm_keep_off(g, mx[0], mz[0], SB_MECH_R); mx[0] = q.x; mz[0] = q.z;
  }
  if dist2(mx[0], mz[0], t[0].mech_x, t[0].mech_z) > 0.001 { t[0].mech_step += dt * 5; }
  t[0].mech_x = mx[0]; t[0].mech_z = mz[0]; t[0].mech_yaw = my[0];
}
// Where the mech follows: at her left, its radius and SB_MECH_GAP out from her, SB_MECH_AHEAD ahead.
SB_MECH_GAP :: 1.4f32; SB_MECH_AHEAD :: 0.6f32;
sb_mech_spot :: (g: [] SpGame) -> Point {
  y := g[0].yaw; side := SB_MECH_R + SB_MECH_GAP;
  return v3(g[0].px + sin(y) * SB_MECH_AHEAD + cos(y) * side, 0, g[0].pz + cos(y) * SB_MECH_AHEAD - sin(y) * side);
}
// The drive (M_RIDE, splice-game.coax g_step): the raider mech's chase and a battle with it from Sniper.
sb_ride :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  if t[0].hit_t > 0 { t[0].hit_t -= dt; }
  if g[0].ak[0].cue_t > 0 { g[0].ak[0].cue_t -= dt; }
  sb_rm_step(g, dt);
  sb_battle_step(g, dt);
}
// Sniper's speed on the drive: in a battle it holds to its slow speed, so the battle has the road to the garage.
sb_ride_pace :: (g: [] SpGame, want: f32) -> f32 { return ifx sb_fighting(g) then T_RAIL_SLOW else want; }
// The raider mech on the drive: it keeps watch beside the route, gives chase when Sniper passes, runs beside
// it and claws it, gives up when Sniper outruns it, and turns back near the garage. In a battle it keeps
// beside Sniper and fights with its cards (sb_battle_step).
sb_rm_step :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  if !sb_road(g) || t[0].rm_down { return; }
  s := sb_sniper_at(g); d := dist2(s.x, s.z, t[0].rm_x, t[0].rm_z);
  if t[0].rm_hunt && sb_road_end(g) {
    sb_finish(g); t[0].rm_hunt = false; t[0].rm_gone = true; g_say(g, SBM_RM_GONE);
  } else if !t[0].rm_hunt && !t[0].rm_gone && d < sb_rm_notice(g) && !sb_road_end(g) && !t[0].bots[SB_SNIPER].vit.down {
    t[0].rm_hunt = true; t[0].rm_claw = SB_RM_CLAW_EVERY; g_say(g, SBM_HUNT);
  } else if t[0].rm_hunt && !sb_fighting(g) && d > sb_rm_give_up(g) {
    t[0].rm_hunt = false; t[0].rm_gone = true; g_say(g, SBM_RM_GONE);
  }
  if !t[0].rm_hunt { return; }
  rx := [1] f32.[t[0].rm_x]; rz := [1] f32.[t[0].rm_z]; ry := [1] f32.[t[0].rm_yaw];
  b := sb_road_beside(g, SB_RM_SIDE);
  _ := sb_toward(rx[..], rz[..], ry[..], b.x, b.z, sb_rm_speed(g), 0.05, dt);
  if dist2(rx[0], rz[0], b.x, b.z) < 0.5 { ry[0] = sb_road_yaw(g); }   // alongside: it runs the way Sniper drives
  if dist2(rx[0], rz[0], t[0].rm_x, t[0].rm_z) > 0.001 { t[0].rm_step += dt * 7; }
  t[0].rm_x = rx[0]; t[0].rm_z = rz[0]; t[0].rm_yaw = ry[0];
  sb_claws(g, s, rx[0], rz[0], dt);
}
// Out of a battle, beside Sniper, the raider mech claws twice (SB_CLAW): it winds up, and each claw locks on
// the spot Sniper is heading for at its pace then; W pressed or let go as it locks takes Sniper out of
// the spot. Between the claws it keeps its arm up (another is coming); after the second it drops it.
sb_claws :: (g: [] SpGame, s: Point, rx: f32, rz: f32, dt: f32) {
  t := g[0].bt[..];
  vx := (s.x - g[0].ak[0].was_x) / hi(dt, 0.001); vz := (s.z - g[0].ak[0].was_z) / hi(dt, 0.001);
  g[0].ak[0].was_x = s.x; g[0].ak[0].was_z = s.z;
  if sb_fighting(g) { g[0].ak[0].claw_t = -1; return; }
  a := g[0].ak[0].claw_t;
  if a < 0 {
    if dist2(s.x, s.z, rx, rz) > SB_RM_CLAW_REACH { return; }
    t[0].rm_claw -= dt;
    if t[0].rm_claw > 0 || !sb_claim(g, SB_CLAW) { return; }
    t[0].rm_claw = SB_RM_CLAW_EVERY; g[0].ak[0].claw_t = 0; sb_wind(g, rx, rz); return;
  }
  b := a + dt; g[0].ak[0].claw_t = b;
  now := tg_at(SB_CLAW, b);
  if now.phase == TG_WIND || now.phase == TG_HOLD {
    // aiming: where Sniper will be when this claw lands, at its pace now
    lead := tg_release(SB_CLAW, ifx now.phase == TG_HOLD then now.k + 1 else 0) - b;
    g[0].ak[0].claw_x = s.x + vx * lead; g[0].ak[0].claw_z = s.z + vz * lead;
  }
  if tg_struck(SB_CLAW, a, b) >= 0 {
    if dist2(s.x, s.z, g[0].ak[0].claw_x, g[0].ak[0].claw_z) < SB_CLAW_R {
      // outrunning is the default: out of a battle its claws scratch, but never take Sniper below a third of
      // its health; only a battle she starts with E can put Sniper down (#13505 playtest)
      dmg := sb_card(SBC_CLAW, SB_RAIDER).power;
      v := t[0].bots[SB_SNIPER].vit;
      if v.hp - cast(f32) dmg >= v.most / 3 { _ := bb_hurt(t[0].bots[SB_SNIPER..<SB_SNIPER + 1], dmg); }
      g[0].flash = hi(g[0].flash, 0.2); sb_cue(g, true, rx, rz);
    } else { sb_cue(g, false, rx, rz); }
  }
  if b >= tg_len(SB_CLAW) { g[0].ak[0].claw_t = -1; }
}
// The boss. Its battle begins when you and the mech with Digger's core are in its chamber. Phase one: it
// sweeps its arm round. Below half health, phase two: it winds up, charges, and is dazed after. Its own
// moves come every SB_THINK while a battle is on. Weak points wake after T_STUN_TIME.
sb_boss_step :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  if g[0].zone != Z_MINE || !g[0].wall_gone || g[0].boss_down { return; }
  for i: 0..<3 { if g[0].stun[i] > 0 { g[0].stun[i] -= dt; if g[0].stun[i] <= 0 { g_say(g, MSG_WAKE); } } }
  if t[0].kind == SBF_NONE && sb_in_chamber(g, g[0].pz) && (t[0].mech_core || g[0].bot) && !t[0].bots[SB_MECH].vit.down {
    crew := [2] int.[SB_MECH, SB_DIGGER];
    sb_begin(g, SBF_BOSS, crew[..], SB_BOSS);
    if !t[0].mech_core { _ := bb_swap(t[0].fight[..], 0, 1); t[0].fight[0].sides[0].swap_until = 0; }
    g_say(g, SBM_BOSS);
  }
  if t[0].kind != SBF_BOSS { return; }
  b := bb_active(t[0].fight[0], 1);
  if b.vit.down { t[0].rush = 0; t[0].wind = 0; return; }   // no health left: it slumps and its weak points stay open
  stunned := t[0].fight[0].now < b.stun_until;
  if !t[0].half && bb_health(b) <= 0.5 { t[0].half = true; t[0].charge_t = 0; g_say(g, SBM_CHARGES); }
  dx := [1] f32.[t[0].dino_x]; dz := [1] f32.[t[0].dino_z]; dy := [1] f32.[t[0].dino_yaw];
  target := sb_body_at(g, sb_fielded(g));
  if t[0].daze > 0 { t[0].daze -= dt; if t[0].daze <= 0 { g_say(g, SBM_SHUT); } }
  else if t[0].rush > 0 {
    // the charge: straight on until its time is up or it meets the chamber's wall; anyone in its path is hit once
    dx[0] += t[0].rush_dx * SB_CHARGE_SPEED * dt; dz[0] += t[0].rush_dz * SB_CHARGE_SPEED * dt; t[0].rush -= dt;
    wall := dx[0] < -7 || dx[0] > 7 || dz[0] > g[0].at.wall_z - 3 || dz[0] < ga_lab_back(g);
    dx[0] = clamp(dx[0], -7, 7); dz[0] = clamp(dz[0], ga_lab_back(g), g[0].at.wall_z - 3);
    if !t[0].rush_hit && dist2(g[0].px, g[0].pz, dx[0], dz[0]) < SB_CHARGE_W { t[0].rush_hit = true; g[0].ak[0].sweep_hit = true; sb_hurt(g, dx[0], dz[0]); }
    me := sb_body_at(g, sb_fielded(g));
    if !t[0].rush_hit && dist2(me.x, me.z, dx[0], dz[0]) < 3.2 { t[0].rush_hit = true; _ := bb_strike(t[0].fight[..], 0, SB_CHARGE_HIT); t[0].hit_t = 0.9; t[0].hit_side = 0; t[0].hit_dmg = SB_CHARGE_HIT; }
    if t[0].rush <= 0 || wall {
      t[0].rush = 0; t[0].daze = SB_DAZE; g_say(g, SBM_OPEN);
      if g[0].ak[0].sweep_aim && !g[0].ak[0].sweep_hit { sb_cue(g, false, dx[0], dz[0]); }   // she stepped out of its lane
    }
  } else if t[0].wind > 0 {
    // the wind-up: its head lowers at her and its lane follows her until it locks (SB_CHARGE.lock before the rush)
    t[0].wind -= dt;
    if t[0].wind > SB_CHARGE.lock {
      dy[0] = atan2(g[0].px - dx[0], g[0].pz - dz[0]);
      d := hi(0.01, dist2(g[0].px, g[0].pz, dx[0], dz[0])); t[0].rush_dx = (g[0].px - dx[0]) / d; t[0].rush_dz = (g[0].pz - dz[0]) / d;
      g[0].ak[0].sweep_aim = false; g[0].ak[0].sweep_hit = false;
    } else if !g[0].ak[0].sweep_aim { g[0].ak[0].sweep_aim = sb_in_lane(g, g[0].px, g[0].pz, SB_CHARGE_W * 1.5); }
    if t[0].wind <= 0 { t[0].rush = SB_CHARGE_TIME; t[0].rush_hit = false; }
  } else if !stunned {
    sw := g[0].boss_t - sb_sweep_from(); ph := ifx t[0].half then TG_IDLE else tg_at(SB_SWEEP, sw).phase;
    // it faces the mech and closes in on it, until a sweep locks: from then it stands and follows no one
    if ph == TG_IDLE || ph == TG_WIND {
      _ := sb_toward(dx[..], dz[..], dy[..], target.x, target.z, ifx t[0].half then 2.4f32 else 1.4f32, 4.5, dt);
      dx[0] = clamp(dx[0], -7, 7); dz[0] = clamp(dz[0], ga_lab_back(g), g[0].at.wall_z - 3);
    }
    if t[0].half {
      t[0].charge_t += dt;
      if t[0].charge_t >= SB_CHARGE_EVERY && sb_claim(g, SB_CHARGE) { t[0].charge_t = 0; t[0].wind = SB_CHARGE.wind + SB_CHARGE.lock; sb_wind(g, dx[0], dz[0]); }
    } else { sb_sweep(g, dx[0], dz[0], dt); }
  }
  t[0].dino_x = dx[0]; t[0].dino_z = dz[0]; t[0].dino_yaw = dy[0];
  sb_dino_body(g);
}
sb_arm_angle :: (g: [] SpGame) -> f32 { return g[0].bt[0].dino_yaw + boss_arm(g) - 2.6; }
// Whether (x, z) is where the tail is now: within SB_TAIL_W of its line from the hips out to T_ARM, the
// width drawn plus her body, so the blow lands where the tail is seen and a jump only has to clear it as it passes.
sb_in_arc :: (cx: f32, cz: f32, a: f32, x: f32, z: f32) -> bool {
  rx := x - cx; rz := z - cz; along := rx * sin(a) + rz * cos(a); across := rx * cos(a) - rz * sin(a);
  return along > 0 && along < T_ARM && abs(across) < SB_TAIL_W;
}
sb_in_wedge :: (cx: f32, cz: f32, yaw: f32, half: f32, r: f32, x: f32, z: f32) -> bool {
  diff := atan2(x - cx, z - cz) - yaw;
  while diff > PI { diff -= TAU; } while diff < -PI { diff += TAU; }
  return dist2(x, z, cx, cz) < r && abs(diff) < half;
}
// Phase one's tail sweep (SB_SWEEP on the boss's clock boss_t, as the stills draw it): it winds up, locks
// where it stands, then its tail swings low from behind it round its left side to its head (the half of
// the room on that side). Jumping clears it; you or the mech in its arc on the ground are hit. Then it
// rests, tail down: the opening.
sb_sweep_from :: () -> f32 { return T_SWEEP_EVERY - SB_SWEEP.wind - SB_SWEEP.lock; }
sb_sweep :: (g: [] SpGame, x: f32, z: f32, dt: f32) {
  t := g[0].bt[..];
  from := sb_sweep_from(); a := g[0].boss_t - from; nt := g[0].boss_t + dt;
  if a < 0 && nt - from >= 0 {
    if sb_claim(g, SB_SWEEP) { sb_wind(g, x, z); g[0].ak[0].sweep_aim = false; g[0].ak[0].sweep_hit = false; } else { nt = from - 0.0001; }
  }
  g[0].boss_t = nt; b := nt - from;
  ph := tg_at(SB_SWEEP, b).phase;
  if ph == TG_LOCK && dist2(g[0].px, g[0].pz, x, z) < T_ARM + 1 { g[0].ak[0].sweep_aim = true; }
  if ph == TG_HIT {
    arm := sb_arm_angle(g);
    if sb_in_arc(x, z, arm, g[0].px, g[0].pz) && g_feet_y(g) - g_ground(g, g[0].px, g[0].pz) < SB_JUMP_CLEAR {
      if !g[0].ak[0].sweep_hit { sb_hurt(g, x, z); } g[0].ak[0].sweep_hit = true;
    }
    me := sb_body_at(g, sb_fielded(g));
    if !t[0].swept && sb_in_wedge(x, z, arm, 0.4, T_ARM, me.x, me.z) { t[0].swept = true; _ := bb_strike(t[0].fight[..], 0, SB_SWEEP_HIT); t[0].hit_t = 0.9; t[0].hit_side = 0; t[0].hit_dmg = SB_SWEEP_HIT; }
  }
  if tg_ended(SB_SWEEP, a, b) >= 0 && g[0].ak[0].sweep_aim && !g[0].ak[0].sweep_hit { sb_cue(g, false, x, z); }
  if b >= tg_len(SB_SWEEP) { g[0].boss_t = 0; t[0].swept = false; }
}
// Whether (x, z) lies in the charge's lane, `w` m to each side.
sb_in_lane :: (g: [] SpGame, x: f32, z: f32, w: f32) -> bool {
  t := g[0].bt[..]; ex := x - t[0].dino_x; ez := z - t[0].dino_z;
  along := ex * t[0].rush_dx + ez * t[0].rush_dz; across := ex * t[0].rush_dz - ez * t[0].rush_dx;
  return along > -w && along < SB_CHARGE_SPEED * SB_CHARGE_TIME && abs(across) < w;
}

// ---- What she sees and hears of an attack (#13552)
// May an attack begin now: the lane every foe shares, so two blows never land together.
sb_claim :: (g: [] SpGame, b: TgBeats) -> bool { return tg_claim(g[0].ak[0].lane[..], g[0].t, b, SB_GAP); }
// A wind-up begins: heard from where it is.
sb_wind :: (g: [] SpGame, x: f32, z: f32) { snd_play_at(g, SND_ATTACK_WIND, x, z); }
// A blow that landed on her or missed her: HIT or DODGED over her a moment, its sound from where it came.
sb_cue :: (g: [] SpGame, hit: bool, x: f32, z: f32) {
  t := g[0].bt[..];
  g[0].ak[0].cue_t = SB_CUE; g[0].ak[0].cue_hit = hit; g[0].ak[0].cue_x = x; g[0].ak[0].cue_z = z;
  snd_play_at(g, ifx hit then SND_HIT else SND_ATTACK_MISS, x, z);
}
// A blow from (x, z) lands on her (unless she is still shaking off the last one).
// Its flash is kept short, so it never hides the next warning.
sb_hurt :: (g: [] SpGame, x: f32, z: f32) { if g[0].hit_cool <= 0 { g_hurt(g); g[0].flash = lo(g[0].flash, 0.18); sb_cue(g, true, x, z); } }
// A foe on foot after her (raider or Imperial robot): near enough, and when the lane is free, it winds up its
// blow (SB_BLOW) turning to follow her, locks its aim, strikes the wedge ahead of it and recovers. Only the
// wedge hurts. Returns whether it is busy with a blow: it stands its ground until it is done. A script's
// strike (scripts.coax) starts one too.
sb_blow :: (g: [] SpGame, i: int, d: f32, spoke: bool, dt: f32) -> bool {
  t := g[0].bt[..]; a := g[0].ak[0].ft[i];
  if a <= 0 {
    want := g[0].fhost[i] && d < SB_BLOW_START && (!spoke || g[0].sstrike[i] == g[0].steps);
    if !want || !sb_claim(g, SB_BLOW) { return false; }
    g[0].ak[0].ft[i] = 0.0001; g[0].ak[0].fa[i] = atan2(g[0].px - g[0].fx[i], g[0].pz - g[0].fz[i]); sb_wind(g, g[0].fx[i], g[0].fz[i]); return true;
  }
  b := a + dt; g[0].ak[0].ft[i] = b;
  if tg_tracks(SB_BLOW, b) { g[0].ak[0].fa[i] = atan2(g[0].px - g[0].fx[i], g[0].pz - g[0].fz[i]); }
  g[0].fyaw[i] = g[0].ak[0].fa[i];
  if tg_struck(SB_BLOW, a, b) >= 0 {
    if sb_in_wedge(g[0].fx[i], g[0].fz[i], g[0].ak[0].fa[i], SB_BLOW_HALF, SB_BLOW_REACH, g[0].px, g[0].pz) { sb_hurt(g, g[0].fx[i], g[0].fz[i]); }
    else if d < SB_BLOW_REACH * 2 { sb_cue(g, false, g[0].fx[i], g[0].fz[i]); }
  }
  if b >= tg_len(SB_BLOW) { g[0].ak[0].ft[i] = 0; }
  return true;
}
// A battle in progress: the clock, the foe's moves, the fielded bots closing in, and how it ends.
sb_battle_step :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  if t[0].kind == SBF_NONE { return; }
  f := t[0].fight[..];
  bb_step(f, dt);
  // your fielded body closes in on the foe (Sniper stays where it is parked)
  me := sb_fielded(g); foe := sb_body_at(g, t[0].foe);
  if me == SB_DIGGER {
    bx := [1] f32.[g[0].bot_x]; bz := [1] f32.[g[0].bot_z]; by := [1] f32.[g[0].bot_yaw];
    _ := sb_toward(bx[..], bz[..], by[..], foe.x, foe.z, SB_BODY_SPEED, 2.2, dt);
    g[0].bot_x = bx[0]; g[0].bot_z = bz[0]; g[0].bot_yaw = by[0];
  }
  if me == SB_MECH {
    mx := [1] f32.[t[0].mech_x]; mz := [1] f32.[t[0].mech_z]; my := [1] f32.[t[0].mech_yaw];
    _ := sb_toward(mx[..], mz[..], my[..], foe.x, foe.z, SB_BODY_SPEED, 4.2, dt);
    t[0].mech_x = mx[0]; t[0].mech_z = mz[0]; t[0].mech_yaw = my[0];
  }
  // your side fights on its own when you leave it be (#13505 playtest): past SB_AUTO without a move key,
  // the fielded bot uses its strongest ready card, so the mech is seen to land its hits; 1 to 4 still pick
  t[0].idle += dt;
  if t[0].idle >= SB_AUTO {
    k := bb_pick(f[0], 0, sb_gap(g));
    if k >= 0 { h := bb_use(f, 0, k, sb_gap(g)); if h.verdict == BbVerdict.ok { t[0].idle = SB_AUTO - SB_THINK; t[0].hit_t = 0.9; t[0].hit_side = 1; t[0].hit_dmg = h.damage; g[0].flash = hi(g[0].flash, 0.12); } }
  }
  // the foe's move: its strongest ready card, not while it charges, sweeps, is dazed or the stun holds it.
  // A card winds up first (SB_CARD), shown and heard, and lands at its release
  t[0].think -= dt;
  sw := tg_at(SB_SWEEP, g[0].boss_t - sb_sweep_from()).phase;
  busy := t[0].kind == SBF_BOSS && (t[0].rush > 0 || t[0].wind > 0 || t[0].daze > 0 || (!t[0].half && sw != TG_IDLE));
  if g[0].ak[0].card_t >= 0 {
    a := g[0].ak[0].card_t; b := a + dt; g[0].ak[0].card_t = b;
    if tg_struck(SB_CARD, a, b) >= 0 { h := bb_use(f, 1, g[0].ak[0].card_k, sb_gap(g)); if h.verdict == BbVerdict.ok { t[0].hit_t = 0.9; t[0].hit_side = 0; t[0].hit_dmg = h.damage; g[0].flash = hi(g[0].flash, 0.2); } }
    if b >= tg_len(SB_CARD) { g[0].ak[0].card_t = -1; t[0].think = SB_THINK; }
  } else if t[0].think <= 0 && !busy {
    t[0].think = SB_THINK;
    k := bb_pick(f[0], 1, sb_gap(g));
    if k >= 0 && sb_claim(g, SB_CARD) { g[0].ak[0].card_t = 0; g[0].ak[0].card_k = k; at := sb_body_at(g, t[0].foe); sb_wind(g, at.x, at.z); }
  }
  // a fielded bot down: the next one standing comes in; Digger down is said
  if bb_active(f[0], 0).vit.down {
    if sb_fielded(g) == SB_DIGGER { g_say(g, SBM_DIGGER_DOWN); }
    nx := bb_next(f[0].sides[0]);
    if nx >= 0 && bb_swap(f, 0, nx) { b := t[0].crew[nx]; if b == SB_MECH || b == SB_DIGGER { t[0].mech_core = b == SB_MECH; } }
  }
  // the end: the foe down, or your side down (the mech down in the boss's battle is a loss)
  mech_lost := t[0].kind == SBF_BOSS && f[0].sides[0].bots[0].vit.down;
  if f[0].winner == 0 && t[0].kind == SBF_DESERT {
    sb_finish(g); t[0].rm_down = true; t[0].rm_hunt = false; g[0].scrap += 1; g_say(g, SBM_RM_DOWN);
  } else if (f[0].winner == 1 || mech_lost) && t[0].kind == SBF_DESERT {
    sb_finish(g); t[0].rm_hunt = false; t[0].rm_gone = true; g_say(g, SBM_SNIPER_DOWN);
  } else if (f[0].winner == 1 || mech_lost) && t[0].kind == SBF_BOSS {
    sb_finish(g); g_say(g, SBM_MECH_DOWN);
    g[0].mode = M_BANNER; g[0].banner = B_CUT; g[0].banner_t = T_BANNER;
  }
}
// Sniper's charger: standing by the rover out of a battle repairs Sniper after a
// moment. Digger charges there on the Director's charger (d_bot, director.coax).
sb_repair_step :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  if sb_fighting(g) { t[0].repair_t = 0; return; }
  hurt := t[0].bots[SB_SNIPER].vit.hp < t[0].bots[SB_SNIPER].vit.most;
  if !hurt || !near_rover(g, T_COOL_RANGE) { t[0].repair_t = 0; return; }
  t[0].repair_t += dt;
  if t[0].repair_t < SB_REPAIR { return; }
  t[0].repair_t = 0;
  bb_repair(t[0].bots[SB_SNIPER..<SB_SNIPER + 1]);
  g_say(g, SBM_REPAIR);
}
// Back at the checkpoint after a loss: the boss is whole again at home, the mech repaired with Digger's core
// at the open hallway, and the raider mech back on watch.
sb_respawn :: (g: [] SpGame) {
  t := g[0].bt[..];
  sb_finish(g);
  g[0].ak[0] = SpAttacks.{}; t[0].wind = 0; t[0].rush = 0; t[0].daze = 0;
  t[0].bots[SB_BOSS] = bb_bot(SB_BOSS, 70, 120, 10); sb_dino_home(g);
  for i: 0..<3 { g[0].stun[i] = 0; }
  bb_repair(t[0].bots[SB_MECH..<SB_MECH + 1]); bb_repair(t[0].bots[SB_SNIPER..<SB_SNIPER + 1]);
  if g[0].wall_gone && !g[0].boss_down { t[0].mech_core = true; t[0].mech_x = 2.5; t[0].mech_z = g[0].at.wall_z + 3; }
  if !t[0].rm_down { sb_rm_home(g); }
}

// ---- words
sb_msg_text :: (g: [] SpGame) -> string {
  m := g[0].msg; t := g[0].bt[0];
  if m == SBM_CORE_IN { return "Digger's core is in the drill mech. It follows you."; }
  if m == SBM_CORE_OUT { return "Digger's core is back in Digger."; }
  if m == SBM_DRILLING { return "The drill mech drills the hallway."; }
  if m == SBM_NEED_MECH { return ifx t.mech_core then "Bring the drill mech right up to the hallway." else "Only the big drill mech can break this."; }
  if m == SBM_LEAD { return "Lead the mech to the blocked hallway, across the field. It drills it when it gets there."; }
  if m == SBM_HUNT { return "A raider mech gives chase. Hold W to outrun it, or press E to battle it."; }
  if m == SBM_RM_GONE { return "The raider mech gave up."; }
  if m == SBM_RM_DOWN { return "The raider mech powers down. Robot piece taken."; }
  if m == SBM_SNIPER_DOWN { return "Sniper is down. The raider mech drives off with its loot."; }
  if m == SBM_BOSS { return "The boss wakes. The mech fights; when it reels, stun its weak points with F."; }
  if m == SBM_CHARGES { return "Half its health gone. Now it charges."; }
  if m == SBM_OPEN { return "It's dazed. Stun its weak points with F."; }
  if m == SBM_SHUT { return "Its weak points close."; }
  if m == SBM_REPAIR { return "You waited at the charger: Sniper is back to full health and charge."; }
  if m == SBM_DIGGER_DOWN { return "Digger powers down. Repair him at Sniper's charger."; }
  if m == SBM_SWAP { return ifx sb_fielded(g) >= 0 then (ifx sb_fielded(g) == SB_MECH then "Core swap: the drill mech." else ifx sb_fielded(g) == SB_SNIPER then "Swap: Sniper." else "Core swap: Digger.") else ""; }
  if m == SBM_REFUSED { return sb_refusal(t.refusal); }
  if m == SBM_MECH_DOWN { return "The drill mech is down."; }
  if m == SBM_CORE_DROP { return "It drops its banned core: old-world tech the Empire forbids, so carrying it raises Heat. Splice it in Sniper to see what it remembers."; }
  return "";
}
sb_refusal :: (v: int) -> string {
  if v == cast(int) BbVerdict.no_charge { return "Battery too low for that card."; }
  if v == cast(int) BbVerdict.far { return "Out of reach. Get closer."; }
  if v == cast(int) BbVerdict.locked { return "Stunned. It can't move."; }
  if v == cast(int) BbVerdict.no_card { return "No card in that slot."; }
  if v == cast(int) BbVerdict.swapping { return "Swapping cores."; }
  if v == cast(int) BbVerdict.down { return "Powered down."; }
  return "Not now.";
}
sb_objective :: (g: [] SpGame) -> string {
  t := g[0].bt[0];
  if sb_fighting(g) && t.kind == SBF_DESERT { return "Battle the raider mech: 1-4."; }
  if sb_road(g) && t.rm_hunt && !t.rm_down { return "Outrun the raider mech (W), or battle it (E)."; }
  if g[0].zone != Z_MINE || g[0].have[H_CORE] || g[0].boss_down { return ""; }
  if g[0].wall_gone { return ifx sb_open(g) then "Stun its 3 weak points with F." else "Battle the boss: 1-4. Open its weak points."; }
  if t.drill_t > 0 { return "The mech is drilling."; }
  if t.mech_core { return "Lead the mech to the blocked hallway (E1), across the field."; }
  if g[0].rubble_gone && g[0].bot { return "Find the drill mech in section C1. Swap Digger's core into it."; }
  return "";
}
// The key prompt for what is in reach, or "" (the HUD's prompt line).
SbPrompt :: struct { text: string; key: string; }
sb_prompt :: (g: [] SpGame) -> SbPrompt {
  t := g[0].bt[0];
  // the boss: her part is the weak points; the mech fights on its own (1 to 4 pick its moves)
  if sb_fighting(g) && t.kind == SBF_BOSS {
    if sb_open(g) { return ifx sb_weak_near(g) >= 0 then SbPrompt.{text = "Stun the weak point", key = "F"} else SbPrompt.{text = "Weak points open: run to a glowing one", key = "F"}; }
    return SbPrompt.{text = "The mech fights. When the boss reels, stun its weak points", key = "1-4"};
  }
  if sb_fighting(g) { nx := bb_next(t.fight[0].sides[0]); if nx >= 0 { return SbPrompt.{text = ifx t.crew[nx] == SB_MECH then "Swap the core into the drill mech" else ifx t.crew[nx] == SB_DIGGER then "Swap the core into Digger" else "Swap to Sniper", key = "E"}; } return SbPrompt.{text = "Battle moves", key = "1-4"}; }
  if g[0].zone == Z_MINE {
    if g[0].boss_down && !g[0].core_taken { c := sb_core_at(g); if dist2(g[0].px, g[0].pz, c.x, c.z) < T_PICK_RANGE { return SbPrompt.{text = "PICK UP · Banned core", key = "E"}; } }
    if !g[0].wall_gone && t.drill_t <= 0 && dist2(g[0].px, g[0].pz, 0, g[0].at.wall_z + 1) < SB_HALL_REACH { return SbPrompt.{text = ifx t.mech_core then "Drill the hallway with the mech" else "Blocked hallway", key = "E"}; }
    if g[0].bot && dist2(g[0].px, g[0].pz, t.mech_x, t.mech_z) < SB_MECH_REACH && !(t.mech_core && !g[0].wall_gone) { return SbPrompt.{text = ifx t.mech_core then "Swap the core back into Digger" else "Swap Digger's core into the drill mech", key = "E"}; }
  }
  if sb_can_battle_rm(g) { return SbPrompt.{text = "Battle the raider mech from Sniper", key = "E"}; }
  return SbPrompt.{};
}

// ---- drawn
SB_YELLOW :: () -> KitTint { return kit_tint(0.93, 0.74, 0.20); }   // the raiders' colour
sb_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  t := g[0].bt[0]; tm := g[0].t;
  if g[0].zone == Z_MINE {
    // the drill mech: raider yellow, dead lenses until Digger's core lights them in his amber; the drill turns as it works
    f := frame_at(v3(t.mech_x, ground_y(g, t.mech_x, t.mech_z), t.mech_z), t.mech_yaw);
    lit := t.mech_core; glow := ifx lit then CAST_AMBER() else kit_tint(0.30, 0.30, 0.32);
    kit_mech(buf, p, f, SB_MECH_S, 220, SB_YELLOW(), glow, INK(), glow);
    spin := ifx t.drill_t > 0 || (sb_fighting(g) && sb_fielded(g) == SB_MECH) then tm * 20 else 0.0f32;
    sb_drill(buf, p, f, SB_MECH_S, 224, spin);
    if lit { kit_pen(p, 227, MAT_GLOW, CAST_AMBER()); ball(buf, p, fp(f, -0.4 * SB_MECH_S, 3.7 * SB_MECH_S, 1.12 * SB_MECH_S), 0.16, 10); }
    // the boss: a dinosaur glowing blue; grey once it is down. Its weak points: armoured blue, bright and
    // pulsing while open, dark once stunned
    if g[0].wall_gone || g[0].boss_down {
      down := g[0].boss_down;
      df := sb_dino_frame(g);
      struck := t.kind == SBF_BOSS && t.hit_side == 1 && t.hit_t > 0.55;   // a hit landing: it jolts back
      reel := ifx (sb_open(g) || struck) && !down then sin(tm * 30) * (ifx struck then 0.18f32 else 0.05f32) else 0.0f32;
      df = frame_move(df, v3(df.o.x + reel, df.o.y, df.o.z));
      bk := g_thing(g, p, TK_BOSS, ifx down then 1 else 0, df, SB_DINO_S, tm);
      if bk >= 0 {
        // its jaw: wide as it winds up a charge or a card (BITE, TAIL), slack while it rests after a sweep
        sw := ifx t.half || t.kind != SBF_BOSS then TG_IDLE else tg_at(SB_SWEEP, g[0].boss_t - sb_sweep_from()).phase;
        cw := g[0].ak[0].card_t >= 0 && tg_at(SB_CARD, g[0].ak[0].card_t).phase <= TG_LOCK;
        jaw := ifx down then 0.1f32 else ifx t.wind > 0 || cw then 1.0f32 else ifx sw == TG_REST then 0.05f32 else 0.3f32 + abs(sin(tm * 1.7)) * 0.3f32;
        if sw == TG_REST || sw == TG_LOCK { df = frame_turn(df, 0, ifx sw == TG_REST then 0.1f32 else -0.06f32); }   // its head sags as it rests; it braces as it locks
        stride := ifx t.rush > 0 then tm * 14 else ifx down then 0.0f32 else tm * 3;
        if down { df = frame_turn(df, 2, 0.12); }
        kit_dino(buf, p, df, SB_DINO_S, 230, ifx down then kit_tint(0.55, 0.56, 0.60) else ifx struck then kit_tint(1.0, 0.86, 0.62) else kit_tint(0.86, 0.90, 0.95), INK(), ifx down then kit_tint(0.30, 0.32, 0.36) else GLOW(), jaw, stride, sin(tm * 1.3));
        g_thing_end(g, p, bk);
      }
      if !down {
        open := sb_open(g);
        for i: 0..<3 {
          w := sb_weak_at(g, i);
          if g[0].stun[i] > 0 { kit_pen(p, 240 + i, MAT_SKIN, kit_tint(0.30, 0.30, 0.34)); ball(buf, p, w, 0.32, 10); }
          else if open { kit_pen(p, 240 + i, MAT_GLOW, GLOW()); ball(buf, p, w, 0.36 + abs(sin(tm * 8 + f32(i))) * 0.1, 12); }
          else { kit_pen(p, 240 + i, MAT_SKIN, GLOW_INK()); ball(buf, p, w, 0.3, 8); }
        }
        // phase one's tail sweep: its tail swings low round from its hips, tapering to the tip, curved
        // against the swing, orange in the warning (#13505 playtest: a tail, not a swung bat)
        if !t.half && sb_fighting(g) && g[0].boss_t > sb_sweep_from() {
          a := sb_arm_angle(g); warn := g[0].boss_t <= T_SWEEP_EVERY;
          kit_pen(p, 236, ifx warn then MAT_GLOW else MAT_SKIN, ifx warn then HEAT() else kit_tint(0.86, 0.90, 0.95));
          root := fp(df, 0, 1.5 * SB_DINO_S, -1.4 * SB_DINO_S);
          tip := v3(t.dino_x + sin(a) * T_ARM, 0.5, t.dino_z + cos(a) * T_ARM);
          side := v3(cos(a), 0, -sin(a));   // across the swing: the tail lags behind it
          prev := root; segs := 5;
          for i: 1..<segs + 1 {
            k := f32(i) / f32(segs); bend := k * (1 - k) * 2.4;
            q := v3(root.x + (tip.x - root.x) * k + side.x * bend, root.y + (tip.y - root.y) * k, root.z + (tip.z - root.z) * k + side.z * bend);
            limb(buf, p, prev, q, 0.55 * (1.15 - k * 0.85), 0.55 * (1.15 - k) + 0.06, v3(0, 1, 0), 8);
            prev = q;
          }
        }
      }
      if down && !g[0].core_taken { c := sb_core_at(g); kit_pen(p, 245, MAT_GLOW, GLOW()); ball(buf, p, v3(c.x, 0.9 + sin(tm * 2) * 0.15, c.z), 0.4, 12); }
    }
  }
  if sb_desert(g) && (g[0].mode == M_PLAY || g[0].mode == M_RIDE) { sb_draw_rm(g, buf, p); }
  if g[0].zone == Z_MINE { sb_warns(g, buf, p); }
}
// ---- The attacks' poses and warnings (#13552)
// A foe on foot as its blow goes: it rears back winding up, crouches still as it locks, lunges through
// the blow, and slumps a moment after (its opening). `face` is where it faces otherwise.
sb_face :: (g: [] SpGame, i: int, face: f32) -> f32 { return ifx g[0].ak[0].ft[i] > 0 then g[0].ak[0].fa[i] else face; }
sb_blow_pose :: (g: [] SpGame, i: int, f: Frame) -> Frame {
  a := g[0].ak[0].ft[i];
  if a <= 0 { return f; }
  now := tg_at(SB_BLOW, a); k := now.share;
  lean := 0.0f32; ahead := 0.0f32; down := 0.0f32;
  if now.phase == TG_WIND { lean = -0.35 * k; }
  else if now.phase == TG_LOCK { lean = -0.35 + 0.15 * k; down = 0.12; }
  else if now.phase == TG_HIT { lean = 0.45; ahead = 0.55 * k; }
  else { lean = 0.3 * (1 - k); ahead = 0.55 * (1 - k); down = 0.1 * (1 - k); }
  m := frame_move(f, fp(f, 0, -down, ahead));
  return frame_turn(m, 0, lean);
}
// A warning's outline on the ground: dashes while the attack winds up (it may still turn), a solid line once
// it is locked. The same shape the blow hits.
sb_marks :: (g: [] SpGame, buf: [] u32, p: [] Pen, pts: [] f32, n: int, locked: bool) {
  for k: 0..<n {
    if !locked && k % 2 == 1 { continue; }
    x := pts[k * 2]; z := pts[k * 2 + 1]; w := ifx locked then 0.12f32 else 0.08f32;
    block(buf, p, x, g_ground(g, x, z) + 0.02, z, w, 0.03, w);
  }
}
// The warnings in the mine: each foe's blow wedge, the tail sweep's half circle and the charge's lane, each
// with an inner outline that grows to the edge as the release comes.
sb_warns :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  t := g[0].bt[..]; pts: [480] f32;
  kit_pen(p, 237, MAT_GLOW, HEAT());
  for i: 0..<FOES {
    a := g[0].ak[0].ft[i];
    if a <= 0 || !g_foe_in(g, i) { continue; }
    now := tg_at(SB_BLOW, a);
    if now.phase != TG_WIND && now.phase != TG_LOCK { continue; }
    grow := ifx now.phase == TG_WIND then now.share else 1.0f32;
    n := tg_wedge(g[0].fx[i], g[0].fz[i], g[0].ak[0].fa[i], SB_BLOW_HALF, SB_BLOW_REACH, 0.18, pts[..]); sb_marks(g, buf, p, pts[..], n, now.phase == TG_LOCK);
    n = tg_wedge(g[0].fx[i], g[0].fz[i], g[0].ak[0].fa[i], SB_BLOW_HALF, hi(0.2, SB_BLOW_REACH * grow), 0.3, pts[..]); sb_marks(g, buf, p, pts[..], n, false);
  }
  if t[0].kind != SBF_BOSS { return; }
  if !t[0].half {
    now := tg_at(SB_SWEEP, g[0].boss_t - sb_sweep_from());
    if now.phase == TG_WIND || now.phase == TG_LOCK {
      grow := ifx now.phase == TG_WIND then now.share else 1.0f32; side := t[0].dino_yaw + PI * 1.5;
      n := tg_wedge(t[0].dino_x, t[0].dino_z, side, PI * 0.5, T_ARM, 0.4, pts[..]); sb_marks(g, buf, p, pts[..], n, now.phase == TG_LOCK);
      n = tg_wedge(t[0].dino_x, t[0].dino_z, side, PI * 0.5, hi(0.5, T_ARM * grow), 0.6, pts[..]); sb_marks(g, buf, p, pts[..], n, false);
    }
  } else if t[0].wind > 0 {
    locked := t[0].wind <= SB_CHARGE.lock; grow := ifx locked then 1.0f32 else 1 - (t[0].wind - SB_CHARGE.lock) / SB_CHARGE.wind;
    l := 0.0f32;   // the lane runs until the chamber's walls stop it
    while l < SB_CHARGE_SPEED * SB_CHARGE_TIME { x := t[0].dino_x + t[0].rush_dx * l; z := t[0].dino_z + t[0].rush_dz * l; if x < -7 || x > 7 || z > g[0].at.wall_z - 3 || z < ga_lab_back(g) { break; } l += 0.5; }
    n := tg_lane(t[0].dino_x, t[0].dino_z, t[0].rush_dx, t[0].rush_dz, l, SB_CHARGE_W, 0.45, pts[..]); sb_marks(g, buf, p, pts[..], n, locked);
    n = tg_lane(t[0].dino_x, t[0].dino_z, t[0].rush_dx, t[0].rush_dz, hi(0.5, l * grow), SB_CHARGE_W * 0.5, 0.7, pts[..]); sb_marks(g, buf, p, pts[..], n, false);
  }
  // a foe's card winding up: a ring under the bot it is for
  if g[0].ak[0].card_t >= 0 && tg_at(SB_CARD, g[0].ak[0].card_t).phase <= TG_LOCK {
    at := sb_body_at(g, sb_fielded(g));
    n := tg_wedge(at.x, at.z, 0, PI, 2.2, 0.35, pts[..]); sb_marks(g, buf, p, pts[..], n, tg_at(SB_CARD, g[0].ak[0].card_t).phase == TG_LOCK);
  }
}
// A dev build's clip of the tail sweep (splice-bots.coax ?stage=10n, attack-checks.coax): the boss at home with
// a whole sweep ahead, the drill mech 4 m south of it and held back (it never fights on its own), so the boss
// stays, facing it; she stands 5 m west of it, in the tail's half circle, facing it.
sb_sweep_spot :: (g: [] SpGame) {
  t := g[0].bt[..]; sb_dino_home(g);
  g[0].px = g[0].at.boss_x - 5; g[0].pz = g[0].at.boss_z; g[0].yaw = PI * 0.5; g[0].boss_t = 0;
  t[0].mech_used = true; t[0].mech_core = true; t[0].mech_x = g[0].at.boss_x; t[0].mech_z = g[0].at.boss_z + 4; t[0].idle = -100000;
}
// An Imperial robot, the tougher foe, shows how far it senses her before she commits: while it is calm and
// she is within SB_SENSE_SHOW m of that line, a ring of short posts on the ground at the real distance
// (d_noticed: its plan's notice, more with Heat, half while she sneaks). Raiders show none.
SB_SENSE_SHOW :: 6.0f32;
sb_sense_r :: (g: [] SpGame, i: int) -> f32 {
  if i < F_RAIDERS || g[0].fhost[i] || g[0].fflee[i] || g[0].fpose[i] == MP_SLEEP { return 0; }
  see := mp_notice(sc_plan(g[0].c[..], i, g_phase(g)));
  if see <= 0 { return 0; }
  r := d_noticed(g, see);
  return ifx dist2(g[0].px, g[0].pz, g[0].fx[i], g[0].fz[i]) < r + SB_SENSE_SHOW then r else 0.0f32;
}
sb_sense_ring :: (g: [] SpGame, buf: [] u32, p: [] Pen, i: int) {
  r := sb_sense_r(g, i);
  if r <= 0 { return; }
  dots: [240] f32;
  kit_pen(p, 179, MAT_GLOW, HEAT());
  n := mp_ring(g[0].fx[i], g[0].fz[i], r, 0.9, dots[..]);
  for k: 0..<n { block(buf, p, dots[k * 2], ground_y(g, dots[k * 2], dots[k * 2 + 1]) + 0.02, dots[k * 2 + 1], 0.06, 0.22, 0.06); }
}
// The raider mech: yellow, an orange eye while it hunts, grey once down; it bounds along as it runs.
// On the drive (drive.coax) it is drawn while it is up, or near Sniper once down.
sb_draw_rm :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  t := g[0].bt[0];
  if g[0].mode == M_DRIVE && t.rm_down { s := sb_sniper_at(g); if dist2(s.x, s.z, t.rm_x, t.rm_z) > 80 { return; } }
  bob := ifx t.rm_hunt then abs(sin(t.rm_step)) * 0.12 else 0.0f32;
  f := frame_at(v3(t.rm_x, bob, t.rm_z), t.rm_yaw);
  if t.rm_down { f = frame_turn(f, 0, -0.35); }
  eye := ifx t.rm_down then kit_tint(0.3, 0.3, 0.32) else ifx t.rm_hunt then HEAT() else SB_YELLOW();
  // its claws (SB_CLAW): raised high winding up and held up between the two, swung through to Sniper on each,
  // and hanging low after the second, its lean gone slack: the opening
  now := tg_at(SB_CLAW, g[0].ak[0].claw_t); k := now.share;
  up := 0.0f32; reach := 0.0f32;
  if now.phase == TG_WIND || now.phase == TG_HOLD { up = ifx now.phase == TG_WIND then k else 1.0f32; }
  else if now.phase == TG_LOCK { up = 1.15; }
  else if now.phase == TG_HIT { up = 1 - k * 1.6; reach = 1; }
  else if now.phase == TG_REST { up = -0.6 * (1 - k); }
  if sb_fighting(g) && g[0].ak[0].card_t >= 0 { c := tg_at(SB_CARD, g[0].ak[0].card_t); if c.phase == TG_WIND { up = c.share; } if c.phase == TG_LOCK { up = 1.15; } }   // a card winding up raises it too
  if now.phase == TG_REST { f = frame_turn(f, 0, 0.18 * (1 - k)); }
  kit_mech(buf, p, f, 0.8, 250, ifx t.rm_down then kit_tint(0.55, 0.52, 0.46) else SB_YELLOW(), HEAT(), INK(), eye);
  kit_pen(p, 254, MAT_SKIN, INK());
  sh := fp(f, 1.5 * 0.8, 1.0 * 0.8, 0.3 * 0.8);
  tip := ifx reach > 0 then v3(g[0].ak[0].claw_x, 0.9, g[0].ak[0].claw_z) else fp(f, 1.3 * 0.8, (0.9 + up * 1.6) * 0.8, (1.6 - up * 0.5) * 0.8);
  limb(buf, p, sh, tip, 0.18, 0.06, v3(0, 1, 0), 6);
  // where a claw will land: a ring round the spot it aims at, dashed while it aims, solid once locked
  if now.phase == TG_WIND || now.phase == TG_LOCK || now.phase == TG_HOLD {
    pts: [160] f32; kit_pen(p, 237, MAT_GLOW, HEAT());
    n := tg_wedge(g[0].ak[0].claw_x, g[0].ak[0].claw_z, 0, PI, SB_CLAW_R, 0.5, pts[..]);
    for j: 0..<n { if now.phase != TG_LOCK && j % 2 == 1 { continue; } w := ifx now.phase == TG_LOCK then 0.16f32 else 0.1f32; block(buf, p, pts[j * 2], 0.03, pts[j * 2 + 1], w, 0.04, w); }
  }
}
// The drill on a mech's right arm, pointing ahead; `spin` turns its flutes.
sb_drill :: (buf: [] u32, p: [] Pen, f: Frame, s: f32, obj: int, spin: f32) {
  base := fp(f, 1.8 * s, 1.0 * s, 0.9 * s); tip := fp(f, 1.8 * s, 1.0 * s, 3.1 * s);
  kit_pen(p, obj, MAT_SKIN, kit_tint(0.62, 0.62, 0.66));
  limb(buf, p, base, tip, 0.48 * s, 0.04 * s, fd(f, cos(spin), sin(spin), 0), 8);
  kit_pen(p, obj + 1, MAT_CLOTH, INK());
  for i: 0..<3 { k := 0.25 + f32(i) * 0.25; a := spin + f32(i) * 2.1; c := v3(base.x + (tip.x - base.x) * k, base.y + (tip.y - base.y) * k, base.z + (tip.z - base.z) * k); r := 0.48 * s * (1 - k); ball(buf, p, add(c, times(fd(f, cos(a), sin(a), 0), r)), 0.07 * s, 6); }
}

// ---- the interface: the battle's panels and a health bar over every bot
sb_bar :: (out: [] f32, n: int, x0: f32, y: f32, x1: f32, k: f32, share: f32, c: KitTint) -> int {
  m := ui_box(out, n, x0, y - 5 * k, x1, y + 5 * k, 1.5 * k, INK());
  if share > 0.01 { m = ui_seg(out, m, x0 + 4 * k, y, x0 + 4 * k + (x1 - x0 - 8 * k) * clamp(share, 0, 1), y, 2.5 * k, c, 1); }
  return m;
}
// A bot's bar over its head (when it is on screen).
sb_head_bar :: (g: [] SpGame, out: [] f32, u: [] f32, n: int, q: Ui, b: BbBot, at: Point, c: KitTint) -> int {
  sp := screen_of(u, at, q.w, q.h);
  if !sp.ahead || sp.x < 0 || sp.x > q.w || sp.y < 0 || sp.y > q.h { return n; }
  k := q.k; w := 70 * k;
  ui_panel(g, u, sp.x - w * 0.5 - 4 * k, sp.y - 9 * k, sp.x + w * 0.5 + 4 * k, sp.y + 9 * k, PAPER(), 0.85);
  return sb_bar(out, n, sp.x - w * 0.5, sp.y, sp.x + w * 0.5, k, ifx b.vit.down then 0.0f32 else bb_health(b), c);
}
// The record a bar shows: the battle's while it fights, else the kept one.
sb_rec :: (g: [] SpGame, b: int) -> BbBot {
  t := g[0].bt[0];
  if t.kind != SBF_NONE {
    if b == t.foe { return t.fight[0].sides[1].bots[0]; }
    for i: 0..<t.crew_n { if t.crew[i] == b { return t.fight[0].sides[0].bots[i]; } }
  }
  return t.bots[b];
}
sb_hud :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, n0: int) -> int {
  n := n0; t := g[0].bt[0]; k := q.k; w := q.w; h := q.h; pad := 18 * k; ink := INK(); paper := PAPER();
  mine := kit_tint(0.20, 0.52, 0.36);
  buf: [64] u8;
  // a bar over the battle's bots (the Director's plates draw Digger's and the foot foes', director.coax)
  if g[0].zone == Z_MINE {
    if t.mech_used || dist2(g[0].px, g[0].pz, t.mech_x, t.mech_z) < 20 { n = sb_head_bar(g, out, u, n, q, sb_rec(g, SB_MECH), v3(t.mech_x, 5.1 * SB_MECH_S, t.mech_z), mine); }
    if g[0].wall_gone && !g[0].boss_down { n = sb_head_bar(g, out, u, n, q, sb_rec(g, SB_BOSS), v3(t.dino_x, 4.4, t.dino_z), GLOW_INK()); }
  }
  if (sb_desert(g) && (g[0].mode == M_PLAY || g[0].mode == M_RIDE)) || (g[0].mode == M_DRIVE && (t.rm_hunt || sb_fighting(g))) {
    s := sb_sniper_at(g);
    n = sb_head_bar(g, out, u, n, q, sb_rec(g, SB_SNIPER), v3(s.x, 3.2, s.z), mine);
    if !t.rm_down && (t.rm_hunt || sb_fighting(g)) { n = sb_head_bar(g, out, u, n, q, sb_rec(g, SB_RAIDER), v3(t.rm_x, 4.4, t.rm_z), HEAT()); }
  }
  n = sb_attack_hud(g, out, u, q, n);
  if t.kind == SBF_NONE { return n; }
  f := t.fight[0];
  // the foe: its name and health, under the time of day
  foe := bb_active(f, 1);
  fx0 := w * 0.5 - 220 * k; fx1 := w * 0.5 + 220 * k; fy := pad + 88 * k;   // under the compass and its objective (hud.coax)
  ui_panel(g, u, fx0, fy, fx1, fy + 52 * k, paper, 0.96);
  n = ui_box(out, n, fx0, fy, fx1, fy + 52 * k, 3 * k, ink);
  n = ui_title(out, n, sb_bot_name(t.foe), fx0 + 14 * k, fy + 22 * k, 10 * k, ifx t.foe == SB_BOSS then GLOW_INK() else ink);
  n = ui_right(out, n, num(buf[..], "", bb_hp(foe), num_tail(foe)), fx1 - 14 * k, fy + 22 * k, 9 * k, ink);
  n = sb_bar(out, n, fx0 + 14 * k, fy + 38 * k, fx1 - 14 * k, k, bb_health(foe), ifx t.foe == SB_BOSS then GLOW() else HEAT());
  if t.foe == SB_BOSS { n = ui_mid(out, n, ifx t.half then "PHASE 2 · IT CHARGES" else "PHASE 1 · ITS TAIL SWEEPS", w * 0.5, fy + 22 * k, 8 * k, ifx t.half then HEAT() else ink); }
  // yours: the fielded bot, its health and battery, and its four cards on keys 1 to 4
  me := bb_active(f, 0); who := sb_fielded(g);
  mx0 := w * 0.5 - 220 * k; mx1 := w * 0.5 + 220 * k; my0 := h - pad - 100 * k; my1 := h - pad;
  ui_panel(g, u, mx0, my0, mx1, my1, paper, 0.97);
  n = ui_box(out, n, mx0, my0, mx1, my1, 3 * k, ink);
  n = ui_title(out, n, sb_bot_name(who), mx0 + 14 * k, my0 + 22 * k, 9.5 * k, ink);
  n = ui_text(out, n, "HP", mx0 + 170 * k, my0 + 22 * k, 8 * k, ink);
  n = sb_bar(out, n, mx0 + 192 * k, my0 + 18 * k, mx0 + 330 * k, k, bb_health(me), mine);
  n = ui_text(out, n, "BATTERY", mx0 + 340 * k, my0 + 22 * k, 8 * k, ink);
  n = sb_bar(out, n, mx0 + 400 * k, my0 + 18 * k, mx1 - 14 * k, k, bb_battery(me), CAST_AMBER());
  sw := (mx1 - mx0 - 28 * k - 30 * k) / 4;
  for i: 0..<4 {
    x0 := mx0 + 14 * k + f32(i) * (sw + 10 * k); x1 := x0 + sw; y0 := my0 + 36 * k; y1 := my1 - 12 * k;
    l := bb_look(f, 0, i);
    if !l.held { n = ui_box(out, n, x0, y0, x1, y1, 1.5 * k, SHADE()); n = ui_mid(out, n, "NO CARD", (x0 + x1) * 0.5, y1 - 14 * k, 7 * k, SHADE()); n = ui_cap(out, n, num(buf[..], "", i + 1, ""), x0 + 8 * k, y0 + 6 * k, 20 * k, SHADE()); continue; }
    c := me.cards[i];
    ready := l.cool <= 0 && l.paid && l.grey <= 0;
    blue := c.id == SBC_PLUS;
    n = ui_fill(out, n, x0, y0, x1, y1, ifx l.grey > 0 then HEAT() else ifx ready then (ifx blue then GLOW() else ink) else SHADE());
    // the cooldown drains from the right
    if l.cool > 0 { n = ui_fill(out, n, x1 - (x1 - x0) * l.cool, y0, x1, y1, t3(0.55, 0.50, 0.44)); }
    fg := ifx ready && !blue then paper else ink;
    n = ui_cap(out, n, num(buf[..], "", i + 1, ""), x0 + 8 * k, y0 + 6 * k, 20 * k, fg);
    n = ui_title(out, n, sb_card_name(c.id), x0 + 32 * k, y0 + 22 * k, 7.5 * k, fg);
    n = ui_text(out, n, num(buf[..], "", c.cost, " BAT"), x0 + 10 * k, y1 - 10 * k, 7 * k, ifx l.paid then fg else HEAT());   // the battery charge it costs
    n = ui_right(out, n, num(buf[..], "", c.power, " DMG"), x1 - 8 * k, y1 - 10 * k, 7 * k, fg);
  }
  // the last hit's number, over the bot it struck
  if t.hit_t > 0 && t.hit_dmg > 0 {
    at := ifx t.hit_side == 1 then sb_body_at(g, t.foe) else sb_body_at(g, who);
    sp := screen_of(u, v3(at.x, (ifx t.hit_side == 1 && t.foe == SB_BOSS then 5.0f32 else 3.6f32) + (0.9 - t.hit_t) * 1.2, at.z), w, h);
    if sp.ahead { n = ui_title_mid(out, n, num(buf[..], "-", t.hit_dmg, ""), sp.x, sp.y, 16 * k, ifx t.hit_side == 1 then HEAT() else ink); }
  }
  return n;
}
// What she sees of the attacks on the HUD (#13552): HIT or DODGED over her a moment after a blow, and a
// marker at the screen's edge toward each attack winding up off screen, before it can land.
sb_attack_hud :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui, n0: int) -> int {
  n := n0; t := g[0].bt[..]; k := q.k;
  if g[0].ak[0].cue_t > 0 {
    me := ifx g[0].mode == M_DRIVE || g[0].mode == M_RIDE then sb_sniper_at(g) else v3(g[0].px, 0, g[0].pz);
    sp := screen_of(u, v3(me.x, 2.3 + (SB_CUE - g[0].ak[0].cue_t) * 0.6, me.z), q.w, q.h);
    if sp.ahead {
      word := ifx g[0].ak[0].cue_hit then "HIT" else "DODGED"; c := 13 * k;
      ui_panel(g, u, sp.x - ui_w(F_TITLE, word, c) * 0.5 - 8 * k, sp.y - c - 7 * k, sp.x + ui_w(F_TITLE, word, c) * 0.5 + 8 * k, sp.y + 7 * k, PAPER(), 0.9);
      n = ui_title_mid(out, n, word, sp.x, sp.y, c, ifx g[0].ak[0].cue_hit then HEAT() else INK());
    }
  }
  xs: [FOES + 2] f32; zs: [FOES + 2] f32; m := sb_threats(g, xs[..], zs[..]);
  for i: 0..<m {
    at := v3(xs[i], 1.5, zs[i]); sp := screen_of(u, at, q.w, q.h);
    if !sp.ahead {
      // behind the camera: toward its side, mirrored by tg_edge
      ex := at.x - u[U_EYE]; ez := at.z - u[U_EYE + 2];
      sp.x = q.w * 0.5 - (ex * u[U_RIGHT] + ez * u[U_RIGHT + 2]) * 1000; sp.y = q.h * 0.5 - 1;
    }
    e := tg_edge(sp.x, sp.y, sp.ahead, q.w, q.h, 48 * k);
    if e[2] <= 0 { continue; }
    // never on the top's compass, objective or boss bar (hud.coax hv_compass): below them on the edge it points from
    top := ro_safe(q.w, q.h).y0 + 130 * k;
    e[1] = hi(e[1], top);
    // a chevron pointing out toward it, on a paper disc, with a mark
    dx := e[0] - q.w * 0.5; dy := e[1] - q.h * 0.5; l := hi(0.001, sqrt(dx * dx + dy * dy)); dx /= l; dy /= l;
    tx := e[0] + dx * 16 * k; ty := e[1] + dy * 16 * k; bx := e[0] - dx * 4 * k; by := e[1] - dy * 4 * k;
    ui_panel(g, u, e[0] - 20 * k, e[1] - 20 * k, e[0] + 20 * k, e[1] + 20 * k, PAPER(), 0.92);
    n = ui_seg(out, n, bx - dy * 14 * k, by + dx * 14 * k, tx, ty, 2.6 * k, HEAT(), 1);
    n = ui_seg(out, n, bx + dy * 14 * k, by - dx * 14 * k, tx, ty, 2.6 * k, HEAT(), 1);
    n = ui_title_mid(out, n, "!", e[0] - dx * 8 * k, e[1] - dy * 8 * k + 6 * k, 14 * k, INK());
  }
  return n;
}
// Where each attack winding up or locked on her comes from now: the foes' blows, the boss's sweep, charge or
// card, the raider mech's claws or card.
sb_threats :: (g: [] SpGame, xs: [] f32, zs: [] f32) -> int {
  t := g[0].bt[..]; m := 0;
  for i: 0..<FOES { if g[0].ak[0].ft[i] > 0 && g_foe_in(g, i) && tg_at(SB_BLOW, g[0].ak[0].ft[i]).phase <= TG_LOCK { xs[m] = g[0].fx[i]; zs[m] = g[0].fz[i]; m += 1; } }
  boss := t[0].kind == SBF_BOSS && (t[0].wind > 0 || (g[0].ak[0].card_t >= 0 && tg_at(SB_CARD, g[0].ak[0].card_t).phase <= TG_LOCK) || (!t[0].half && tg_at(SB_SWEEP, g[0].boss_t - sb_sweep_from()).phase == TG_WIND) || (!t[0].half && tg_at(SB_SWEEP, g[0].boss_t - sb_sweep_from()).phase == TG_LOCK));
  if boss { xs[m] = t[0].dino_x; zs[m] = t[0].dino_z; m += 1; }
  c := tg_at(SB_CLAW, g[0].ak[0].claw_t).phase;
  rm := c == TG_WIND || c == TG_LOCK || c == TG_HOLD || (t[0].kind == SBF_DESERT && g[0].ak[0].card_t >= 0 && tg_at(SB_CARD, g[0].ak[0].card_t).phase <= TG_LOCK);
  if rm { xs[m] = t[0].rm_x; zs[m] = t[0].rm_z; m += 1; }
  return m;
}
num_tail :: (b: BbBot) -> string { return ifx b.vit.down then " · DOWN" else " HP"; }

// ---- the ending: the memory hologram, SCENE RESTORED, the mission's teaser
// The hologram (15 seconds): the empty throne room in orbit, machines still stamping out mandates;
// from second 8 a star map lights up, the planets that were cut off.
SB_MAP_AT :: 8.0f32;
sb_memory_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  t := g[0].mem_t; tm := g[0].t; blue := GLOW(); deep := GLOW_INK();
  mx := g[0].at.mem_x; mz := g[0].at.mem_z;
  m := cast_mono(blue); dim := cast_mono(deep);
  if t < SB_MAP_AT {
    // the dais and the empty throne, a window onto the planet's curve and the stars
    ca_pen(p, 300, MAT_FLAT, blue, dim);
    block(buf, p, mx, 0, mz - 6, 4.5, 0.5, 2.5); block(buf, p, mx, 0.5, mz - 6.4, 3.0, 0.4, 1.6);
    ca_pen(p, 301, MAT_GLOW, blue, m);
    box(buf, p, frame_at(v3(mx, 2.0, mz - 6.6), 0), 0.9, 1.1, 0.6);
    box(buf, p, frame_at(v3(mx, 3.6, mz - 7.05), 0), 0.9, 1.9, 0.15);
    for s: 0..<2 { sx := ifx s == 0 then -1.0f32 else 1.0f32; box(buf, p, frame_at(v3(mx + sx * 0.95, 2.8, mz - 6.6), 0), 0.12, 0.35, 0.6); }
    ca_pen(p, 302, MAT_FLAT, blue, dim);
    for i: 0..<9 { a := (f32(i) - 4) * 0.13; quad(buf, p, v3(mx + sin(a) * 30, 7 + (1 - cos(a)) * 60, mz - 13.5), v3(mx + sin(a + 0.13) * 30, 7 + (1 - cos(a + 0.13)) * 60, mz - 13.5), v3(mx + sin(a + 0.13) * 30, 4.5, mz - 13.5), v3(mx + sin(a) * 30, 4.5, mz - 13.5)); }
    ca_pen(p, 303, MAT_GLOW, blue, m);
    for i: 0..<24 { ball(buf, p, v3(mx - 16 + kit_rand(f32(i)) * 32, 9 + kit_rand(f32(i) + 40) * 10, mz - 13.4), 0.07 + kit_rand(f32(i) + 9) * 0.06, 4); }
    // the machines down both sides: a press stamps each mandate, and the mandates ride a belt away
    for side: 0..<2 {
      sx := ifx side == 0 then -1.0f32 else 1.0f32;
      for j: 0..<3 {
        x := mx + sx * (6 + f32(j) * 3.2); z := mz - 2 - f32(j) * 1.5; ph := fract(tm * 0.9 + f32(j) * 0.33 + f32(side) * 0.5);
        stamp := ifx ph < 0.2 then ph / 0.2 else ifx ph < 0.35 then 1.0f32 else 1 - (ph - 0.35) / 0.65;
        ca_pen(p, 304, MAT_FLAT, blue, dim);
        box(buf, p, frame_at(v3(x - 1.1, 2.0, z), 0), 0.25, 2.0, 0.6); box(buf, p, frame_at(v3(x + 1.1, 2.0, z), 0), 0.25, 2.0, 0.6);
        box(buf, p, frame_at(v3(x, 4.1, z), 0), 1.35, 0.25, 0.7); box(buf, p, frame_at(v3(x, 0.45, z), 0), 1.3, 0.45, 0.8);
        ca_pen(p, 305, MAT_GLOW, blue, m);
        box(buf, p, frame_at(v3(x, 3.4 - stamp * 2.3, z), 0), 0.8, 0.35, 0.5);
        // the mandates: glowing tablets sliding off toward the throne
        for q: 0..<3 { s := fract(tm * 0.3 + f32(q) / 3 + f32(j) * 0.1); box(buf, p, frame_at(v3(x - sx * s * 5, 0.95, z + 0.2), 0), 0.35, 0.03, 0.5); }
      }
    }
  } else {
    // the star map: suns and their planets lighting one by one, lines from the old capital; the cut-off ones dark-ringed
    k := clamp((t - SB_MAP_AT) / 5, 0, 1);
    ca_pen(p, 310, MAT_GLOW, blue, m);
    ball(buf, p, v3(mx, 4.2, mz - 6), 0.5, 12);
    for i: 0..<14 {
      if f32(i) / 14 > k { continue; }
      a := f32(i) * 2.399; r := 2.5 + sqrt(f32(i)) * 3.2;
      at := v3(mx + cos(a) * r, 4.2 + sin(a * 1.7) * 1.6 + sin(a) * r * 0.25, mz - 6 + sin(a) * r * 0.35);
      ca_pen(p, 311, MAT_GLOW, blue, m);
      ball(buf, p, at, 0.22 + kit_rand(f32(i)) * 0.18, 8);
      ca_pen(p, 312, MAT_FLAT, blue, dim);
      limb(buf, p, v3(mx, 4.2, mz - 6), at, 0.02, 0.02, v3(0, 1, 0), 4);
      if i % 3 == 1 { ca_pen(p, 313, MAT_GLOW, HEAT(), cast_colour()); for s: 0..<8 { b := f32(s) * TAU / 8 + tm * 0.5; ball(buf, p, v3(at.x + cos(b) * 0.6, at.y + sin(b) * 0.6, at.z), 0.05, 4); } }
    }
  }
}
// The camera on the hologram: a slow push toward the throne, then back for the star map.
sb_memory_camera :: (g: [] SpGame) -> CamNow {
  t := g[0].mem_t; mx := g[0].at.mem_x; mz := g[0].at.mem_z;
  if t < SB_MAP_AT { k := t / SB_MAP_AT; return CamNow.{eye = v3(mx + 2 - k * 2, 3.0 + k * 0.4, mz + 11 - k * 4), at = v3(mx, 3.0, mz - 6), fov = 0.8}; }
  k := clamp((t - SB_MAP_AT) / (T_MEMORY - SB_MAP_AT), 0, 1);
  return CamNow.{eye = v3(mx + sin(k * 0.6) * 6, 5.0, mz + 10 - k * 2), at = v3(mx, 4.2, mz - 6), fov = 0.85};
}
sb_caption :: (t: f32) -> string {
  c := cast(int) (t / 5);
  return ifx c == 0 then "The orders kept coming. No one was giving them." else ifx c == 1 then "The Emperor has been gone for years. Only his machines remained." else "Someone has to tell the others, Director.";
}
sb_memory_overlay :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui) -> int {
  n := 0; k := q.k; w := q.w; h := q.h;
  for i: 0..<40 { y := (f32(i) + fract(g[0].t * 0.4)) * h / 40; n = ui_seg(out, n, 0, y, w, y, 1 * k, t3(0.02, 0.05, 0.12), 0.35); }
  ui_panel(g, u, -20, h - 150 * k, w + 20, h + 20, t3(0.02, 0.05, 0.12), 0.8);
  n = ui_mid(out, n, sb_caption(g[0].mem_t), w * 0.5, h - 86 * k, 15 * k, GLOW());
  n = ui_title_mid(out, n, "CLICK TO SKIP", w * 0.5, h - 44 * k, 8 * k, GLOW());
  fade := hi(1 - g[0].mem_t / T_FADE, (g[0].mem_t - (T_MEMORY - T_FADE)) / T_FADE);
  if fade > 0 { ui_panel(g, u, -20, -20, w + 20, h + 20, t3(0, 0, 0), lo(fade, 1)); }
  return n;
}
// SCENE RESTORED, then after SB_RESTORED (or a click) the mission's teaser with RESTART.
sb_end_step :: (g: [] SpGame, dt: f32) {
  t := g[0].bt[..];
  if g[0].mode != M_RESTORED { t[0].end_t = 0; t[0].teaser = false; return; }
  t[0].end_t += dt;
  if t[0].end_t >= SB_RESTORED { t[0].teaser = true; }
}
// Enter or a click on SCENE RESTORED goes on to the teaser; true when it took the key.
sb_restored_key :: (g: [] SpGame, key: int) -> bool {
  if g[0].mode != M_RESTORED || g[0].bt[0].teaser || key != -2 { return false; }
  g[0].bt[0].teaser = true;
  return true;
}
sb_restored_overlay :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui) -> int {
  n := 0; k := q.k; w := q.w; h := q.h; ink := INK(); paper := PAPER();
  ui_panel(g, u, -20, -20, w + 20, h + 20, ink, 1);
  n = ui_sprockets(out, n, 0, w, 32 * k, 16 * k, paper); n = ui_sprockets(out, n, 0, w, h - 32 * k, 16 * k, paper);
  if !g[0].bt[0].teaser {
    n = ui_title_mid(out, n, "SCENE RESTORED", w * 0.5, h * 0.46, 44 * k, paper);
    n = ui_mid(out, n, "Director's Cut · 1 of ? erased scenes", w * 0.5, h * 0.55, 12 * k, GLOW());
    return n;
  }
  n = ui_mid(out, n, "NEXT", w * 0.5, h * 0.28, 12 * k, GLOW());
  n = ui_title_mid(out, n, "THE MISSION", w * 0.5, h * 0.38, 40 * k, paper);
  n = ui_mid(out, n, "The Emperor is gone. Nobody has told the other planets,", w * 0.5, h * 0.47, 13 * k, paper);
  n = ui_mid(out, n, "or the other communities on Earth. Someone has to.", w * 0.5, h * 0.51, 13 * k, paper);
  n = ui_mid(out, n, "Sniper is fuelled. The map is open.", w * 0.5, h * 0.57, 11 * k, GLOW());
  n = ui_button(g, out, n, "RESTART", w * 0.5 - 130 * k, h * 0.66, w * 0.5 + 130 * k, h * 0.66 + 48 * k, 1, -2);
  return n;
}
