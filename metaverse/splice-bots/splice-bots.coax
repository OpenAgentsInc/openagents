// 12, Sky city (pins 11, 12): lavender towers in a canyon, airships and birds over it.
sp_skycity :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.72, 0.62, 0.80), false);
  kit_canyon(buf, p, 2, sc(0.66, 0.56, 0.80), sc(0.80, 0.66, 0.78), 1200, 26, -110, -10, 30);
  kit_towers(buf, p, 4, sc(0.90, 0.82, 0.86), sc(0.58, 0.70, 0.84), 1210, 7, 0, -50, 12, 18, 40);
  kit_airship(buf, p, frame_at(v3(-6, 30, -30), 1.3), 1.8, 10, sc(0.94, 0.86, 0.72), sc(0.98, 0.94, 0.88), sink());
  kit_airship(buf, p, frame_at(v3(12, 40, -60), -1.9), 1.4, 13, sc(0.94, 0.86, 0.72), sc(0.86, 0.44, 0.40), sink());
  for i: 0..<7 {
    k := cast(f32) i;
    kit_bird(buf, p, frame_at(v3(-4 + k * 2.4, 22 + kit_rand(k + 1220) * 6, -12 - kit_rand(k + 1230) * 8), 0.2), 0.8, 16, sink());
  }
  sp_robot(buf, p, frame_at(v3(0, 0, 6), 0.1), 1);
}
// 13, Big mech (pins 15, 30): a round white mech with orange plates and a tracked rover on snow.
sp_mech :: (buf: [] u32, p: [] Pen) {
