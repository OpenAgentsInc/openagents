  tube(buf, p, frame_at(v3(0, 46, -40), 0), 12, 1.6, 1.6, 0.02, 0.02, 10, true);
  kit_pen(p, 6, MAT_FLAT, sc(0.20, 0.30, 0.52));
  for r: 0..<4 { tube(buf, p, frame_at(v3(0, 10 + cast(f32) r * 9, -40), 0), 1.2, 3.6 - cast(f32) r * 0.45, 3.6 - cast(f32) r * 0.45, 3.5 - cast(f32) r * 0.45, 3.5 - cast(f32) r * 0.45, 10, true); }
  sp_robot(buf, p, frame_at(v3(2.2, 0, -4), 2.8), 0.9);
}
// 15, Coral sea (pin 7): a red-orange sea at dusk, birds, and the robot on a rock at the shore.
sp_sea :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.82, 0.52, 0.42), false);
  kit_sea(buf, p, 2, sc(0.86, 0.36, 0.30), sc(0.98, 0.80, 0.66), 0.05, -6, 1500);
