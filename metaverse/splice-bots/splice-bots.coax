  block(buf, p, 0, 0, -24, 14, 22, 2);
  block(buf, p, -13, 0, -22, 2.4, 26, 2.4);
  block(buf, p, 13, 0, -22, 2.4, 26, 2.4);
  kit_banner(buf, p, frame_at(v3(0, 16, -21.8), 0), 4, sc(0.24, 0.40, 0.80), sc(1.0, 0.86, 0.50), 6, 9);
  kit_moon(buf, p, 6, sc(1.0, 0.92, 0.70), v3(-24, 34, -60), 6);
  sp_robot(buf, p, frame_at(v3(-1, 0, 5), 3.0), 1);
}

// 17 to 23, the cast (splice-cast.coax) to review: the five of the slice on plinths under a big empty
// sky, at their sizes in the game. 17 is the line-up, 18 to 22 one each, 23 the line-up from behind.
SP_CAST :: 17;
cast_spot :: (who: int) -> Point { return ifx who == 0 then v3(-9.0, 0.25, 0) else ifx who == 1 then v3(-5.6, 0.25, 0) else ifx who == 2 then v3(0.2, 0.25, 0) else ifx who == 3 then v3(5.6, 0.25, 0) else v3(11.0, 0.25, -1.5); }
sp_cast :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.93, 0.84, 0.68), false);
  kit_mesas(buf, p, 2, sc(0.74, 0.62, 0.78), 7, 1700, 120, 34, 10, 24);
  kit_dunes(buf, p, 3, sc(0.95, 0.78, 0.56), 8, 1710, 60, -70, -30, 6, 12);
  for who: 0..<5 {
    at := cast_spot(who); r := ifx who == 2 then 3.6f32 else ifx who == 4 then 3.4f32 else ifx who == 1 then 2.3f32 else 1.2f32;
    kit_pen(p, 4 + who, MAT_WORLD, sc(0.80, 0.70, 0.56));
    tube(buf, p, frame_at(v3(at.x, 0, at.z), 0), 0.25, r + 0.15, r + 0.15, r, r, 24, true);
  }
  c := cast_colour();
  cast_smuggler(buf, p, frame_at(cast_spot(0), 0.35), 1, 20, 0.6, c);
  cast_digger(buf, p, frame_at(cast_spot(1), 0.55), 1, 40, CAST_AMBER(), true, true, true, 0.4, c);
  cast_rover(buf, p, frame_at(cast_spot(2), 0.95), 1.5, 60, 0, c);
  cast_raider(buf, p, frame_at(cast_spot(3), -0.3), 1, 80, sc(1.0, 0.36, 0.62), 0.5, c);
  cast_boss(buf, p, frame_at(cast_spot(4), -0.35), 1, 100, sc(0.22, 0.34, 0.56), sc(0.12, 0.14, 0.24), CAST_CYAN(), true, c);
}

SP_SCENES :: 24;
// Each scene's world, written once when the scene is chosen.
sp_build_world :: (buf: [] u32, p: [] Pen, scene: int) {
  if scene == 1 { sp_arch(buf, p); } else if scene == 2 { sp_crabs(buf, p); } else if scene == 3 { sp_walker(buf, p); }
  else if scene == 4 { sp_terraces(buf, p); } else if scene == 5 { sp_pack(buf, p); } else if scene == 6 { sp_canyon(buf, p); }
  else if scene == 7 { sp_palace(buf, p); } else if scene == 8 { sp_spider(buf, p); } else if scene == 9 { sp_tanks(buf, p); }
  else if scene == 10 { sp_caravan(buf, p); } else if scene == 11 { sp_windmill(buf, p); } else if scene == 12 { sp_skycity(buf, p); }
  else if scene == 13 { sp_mech(buf, p); } else if scene == 14 { sp_spire(buf, p); } else if scene == 15 { sp_sea(buf, p); }
  else if scene == 16 { sp_stairs(buf, p); } else if scene >= SP_CAST { sp_cast(buf, p); } else { sp_dunes(buf, p); }
}
scam :: (ex: f32, ey: f32, ez: f32, ax: f32, ay: f32, az: f32, fov: f32) -> CamNow { return CamNow.{eye = v3(ex, ey, ez), at = v3(ax, ay, az), fov = fov}; }
// Each scene's camera (one fixed view per scene).
sp_camera :: (scene: int) -> CamNow {
  if scene == 1 { return scam(0, 2.2, 21, 0, 4.2, -1, 0.62); }
  if scene == 2 { return scam(0, 3.4, 13, 0, 1.0, -1, 0.6); }
  if scene == 3 { return scam(-9, 3.2, 17, 0, 4.2, 0, 0.62); }
  if scene == 4 { return scam(-14, 7, 34, 0, 6, 0, 0.6); }
  if scene == 5 { return scam(-6, 2.2, 22, 1, 7, -6, 0.7); }
  if scene == 6 { return scam(0, 1.6, 14, 0, 9, -20, 0.75); }
  if scene == 7 { return scam(6, 3, 24, -1, 4, -10, 0.62); }
  if scene == 8 { return scam(-4, 3.2, 13, 0.5, 1.4, 0, 0.62); }
  if scene == 9 { return scam(0, 2.2, 12, 0.6, 0.9, -0.5, 0.62); }
  if scene == 10 { return scam(2, 2.4, 22, -2, 3, -8, 0.6); }
  if scene == 11 { return scam(4, 1.2, 14, -2, 6, -4, 0.75); }
  if scene == 12 { return scam(0, 2, 20, 0, 16, -30, 0.85); }
  if scene == 13 { return scam(-4, 2.4, 15, 0.5, 2.4, 0, 0.62); }
  if scene == 14 { return scam(3, 1.6, 12, 0, 18, -40, 0.8); }
  if scene == 15 { return scam(-5, 2.6, 12, 0, 2.6, -6, 0.62); }
  if scene == 16 { return scam(5, 4.5, 22, 0, 8, -14, 0.7); }
  if scene == 17 { return scam(1.8, 1.2, 26, 1.8, 4.8, 0, 0.6); }
  if scene == 18 { return scam(-7.6, 1.7, 4.9, -9.0, 1.42, 0, 0.6); }
  if scene == 19 { return scam(-7.9, 1.9, 4.9, -5.4, 1.2, 0.4, 0.6); }
  if scene == 20 { return scam(5.0, 3.2, 10.5, 0.2, 2.2, 0, 0.6); }
  if scene == 21 { return scam(4.4, 1.7, 4.8, 5.6, 1.42, 0, 0.6); }
  if scene == 22 { return scam(8.0, 2.4, 12.0, 11.0, 3.2, -1.5, 0.6); }
  if scene == 23 { return scam(1.8, 1.2, -27, 1.8, 4.8, 0, 0.6); }
  return scam(-5.6, 2.6, 13, 0.5, 1.7, 0, 0.52);
}
slook :: (variant: int, clock: f32, kx: f32, ky: f32, kz: f32) -> SpLook { return SpLook.{variant = variant, clock = clock, key = unit_or(v3(kx, ky, kz), v3(0, 1, 0))}; }
// Each scene's look: a noon pastoral for the bright pins, dusk for the sunset ones, neon for night.
sp_look :: (scene: int) -> SpLook {
  if scene == 23 { return slook(SP_PASTORAL, 0.5, 0.45, 0.62, 0.64); }
  if scene == 5 || scene == 7 || scene == 9 || scene == 10 || scene == 13 || scene >= SP_CAST { return slook(SP_PASTORAL, 0.5, -0.45, 0.62, -0.64); }
  if scene == 6 || scene == 12 || scene == 16 { return slook(SP_PASTORAL, 0.62, -0.6, 0.45, -0.66); }
  if scene == 8 { return slook(SP_NEON, 0.0, 0.5, 0.4, -0.76); }
  if scene == 11 || scene == 15 { return slook(SP_DUSK, 0.80, 0.55, 0.2, -0.81); }
  if scene == 14 { return slook(SP_ACTION, 0.0, -0.4, 0.5, -0.77); }
  return slook(SP_DUSK, 0.78, -0.5, 0.27, -0.82);
}
splice_variant :: (s: [] Splice) -> int #export_c #effects(all) { if !s[0].gallery { return g_variant(s[0].game[..]); } return sp_look(s[0].scene).variant; }
splice_clock :: (s: [] Splice) -> f32 #export_c #effects(all) { if !s[0].gallery { return g_clock(s[0].game[..]); } return sp_look(s[0].scene).clock; }

// The page's facts (kind 600) carry the URL: ?scene=N picks the scene, 0 to SP_SCENES - 1; anything else is 0.
// The n-th whole number in text ("-1250 300": 0 gives -1250, 1 gives 300); 0 when there is none.
// Whether text has `part` in it.
sp_has :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 { if cast(string) text[i..<i + part.count] == part { return true; } }
  return false;
}
sp_whole :: (text: string, n: int) -> int {
  i := 0; k := 0;
  while i < text.count {
    while i < text.count && text[i] != '-' && (text[i] < '0' || text[i] > '9') { i += 1; }
    if i >= text.count { break; }
    neg := text[i] == '-'; if neg { i += 1; }
    v := 0; while i < text.count && text[i] >= '0' && text[i] <= '9' { v = v * 10 + cast(int) (text[i] - '0'); i += 1; }
    if k == n { return ifx neg then -v else v; }
    k += 1;
  }
  return 0;
}
// A fact of the run for a host's checks and logs: 0 mode, 1 zone, 2 phase, 3 hearts, 4 Heat,
// 5 robot pieces, 6 cells, 7 the rubble is gone, 8 the boss wall is gone, 9 the boss is down,
// 10 graybox, 11 to 17 a part or card is held (H_ARM to H_CORE). -1 for anything else.
splice_fact :: (s: [] Splice, k: int) -> int #export_c #effects(all) {
  if s.count < 1 || s[0].gallery { return -1; }
  g := s[0].game[..];
  if k == 0 { return g[0].mode; } if k == 1 { return g[0].zone; } if k == 2 { return g[0].phase; }
  if k == 3 { return g[0].hearts; } if k == 4 { return cast(int) floor(g[0].heat + 0.5); }
  if k == 5 { return g[0].scrap; } if k == 6 { return g[0].cells; }
  if k == 7 { return ifx g[0].rubble_gone then 1 else 0; } if k == 8 { return ifx g[0].wall_gone then 1 else 0; }
  if k == 9 { return ifx g[0].boss_down then 1 else 0; } if k == 10 { return ifx g[0].gray then 1 else 0; }
  if k >= 11 && k < 11 + HAVES { return ifx g[0].have[k - 11] then 1 else 0; }
  return -1;
}
// The world's one request at a time, for the face to hand to the host (coaxial_http), and the
// host's id for its answer (world-follow.coax).
splice_req_wants :: (s: [] Splice) -> bool #export_c #effects(all) { return s.count > 0 && s[0].follow == 2 && wf_wants(s[0].page[0].f[..]); }
splice_req_url :: (s: [] Splice) -> string #export_c #effects(all) { return wf_url(s[0].page[0].f[..]); }
splice_req_body :: (s: [] Splice) -> string #export_c #effects(all) { return wf_body(s[0].page[0].f[..], s[0].page[0].batch[..]); }
splice_req_flags :: (s: [] Splice) -> int #export_c #effects(all) { return wf_flags(s[0].page[0].f[..]); }
splice_req_sent :: (s: [] Splice, id: int) #export_c #effects(all) { wf_sent(s[0].page[0].f[..], id); }
// A new engine started on this state (the host calls the face's coaxial_page at each load): the
// request the old engine had out is asked again at once (#13457).
splice_engine_started :: (s: [] Splice) #export_c #effects(all) { if s.count > 0 { wf_engine_started(s[0].page[0].f[..]); } }
// What the editor shell is told (world.coax spw_model, editor.model.v1), and a count that changes when it does.
splice_edit_model :: (s: [] Splice) -> string #export_c #effects(all) { return ifx s.count > 0 && s[0].follow == 2 then spw_model(s[0].game[..], s[0].page[..]) else ""; }
splice_edit_rev :: (s: [] Splice) -> int #export_c #effects(all) {
  if s.count < 1 || s[0].follow != 2 { return 0; }
  _ := spw_model(s[0].game[..], s[0].page[..]);
  return s[0].page[0].model_rev;
}
// A fact of the page's place in the world, for a host's checks (coaxial.fieldProbe): 0 the revision
// it stands at (-1: no document yet), 1 outside edits carried out, 2 placed pieces, 3 pieces rising
// in, 4 the follower's status (world-follow.coax WFS_*), 5 documents read, 6 requests sent, 7 and 8
// where you stand (x and z, centimetres), 9 import packs read, 10 the meshes the pack has, 11 packs
// refused, 12 vertices in the piece store, 13 the pack's bytes; from 100,
// a fact of the run (splice_fact k - 100).
splice_world_fact :: (s: [] Splice, k: int) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  if k >= 100 { return splice_fact(s, k - 100); }
  f := s[0].page[0].f[..]; l := s[0].game[0].layer[..];
  if k == 0 { return ifx s[0].follow == 2 then f[0].rev else -1; }
  if k == 1 { return f[0].taken; } if k == 2 { return l[0].st[0].n; } if k == 3 { return l[0].rise_n; }
  if k == 4 { return f[0].status; } if k == 5 { return s[0].page[0].loads; } if k == 6 { return f[0].sent; }
  if k == 7 { return we_cm(s[0].game[0].px); } if k == 8 { return we_cm(s[0].game[0].pz); }
  if k == 9 { return s[0].game[0].imp[0].gen; } if k == 10 { return s[0].game[0].imp[0].n; } if k == 11 { return s[0].imports_refused; }
  if k == 12 { return s[0].ld[0].mesh_n; } if k == 13 { return s[0].imports_n; }
  return -1;
}
// The world's import pack as it arrived (the page's data asset, GitHub #13420): read whole
// (pack.coax, then the importer's catalog) and copied into `kept`, which the face hands to each
// frame; or refused, and the copy from before stays. A kind whose kit is a pack mesh is meshed
// again from it (layer-draw.coax).
splice_imports :: (s: [] Splice, incoming: string, kept: [] u8) -> bool #export_c #effects(all) {
  if s.count < 1 || incoming.count == 0 { return false; }
  t := [1] SpImports.[s[0].game[0].imp[0]];
  if incoming.count > kept.count || !sp_imports_read(t[..], incoming) { s[0].imports_refused += 1; return false; }
  for c, k: incoming { kept[k] = c; }
  s[0].imports_n = incoming.count; s[0].game[0].imp[0] = t[0];
  return true;
}
splice_message :: (s: [] Splice, kind: int, body: string) #export_c #effects(all) {
  // this browser's storage answers (coax/web/STORAGE.md): slot 0 your character, slot 1 the kept run (front.coax)
  if (kind == 768 || kind == 769) && s.count > 0 && !s[0].gallery { fr_stored(s[0].game[..], kind - 768, body); return; }
  if kind == 700 && s.count > 0 { s[0].frame_answer = false; splice_drive(s, body); return; }
  if kind == 721 && s.count > 0 { s[0].frame_isolated = sp_whole(body, 0) == 1; s[0].frame_opaque = sp_whole(body, 1) == 1; return; }
  if kind == 720 && s.count > 0 { splice_framed(s, body); return; }
  // the world's answers (512 + the host's id: "STATUS\n" then the body), and the dev server's word that it was written
  if kind >= 512 && kind < 520 && s.count > 0 && s[0].follow == 2 { _ := spw_page_answer(s[0].game[..], s[0].page[..], kind - 512, body); return; }
  if kind == 614 && s.count > 0 && s[0].follow == 2 { wf_nudge(s[0].page[0].f[..], body); return; }
  // the editor shell's actions (metaverse-engine/editor/shell.coax): 520 a batch of edits, sent as this page's own write; 521 the piece to select
  if kind == 520 && s.count > 0 && s[0].edit && s[0].follow == 2 { _ := spw_shell_batch(s[0].page[..], body); return; }
  if kind == 521 && s.count > 0 && s[0].edit { spw_select(s[0].game[..], s[0].page[..], sp_whole(body, 0)); return; }
  // "add KIND COUNT": several of a kind, planned from the point last tapped (world.coax spw_plan_add)
  if kind == 523 && s.count > 0 && s[0].edit && s[0].follow == 2 && ct_part(body, ' ', 0) == "add" && ct_parts(body, ' ') == 3 {
    k := ct_num(ct_part(body, ' ', 1)); c := ct_num(ct_part(body, ' ', 2));
    if k.ok && c.ok { _ := spw_plan_add(s[0].game[..], s[0].page[..], s[0].vw[..], PlaceView.{view_x = s[0].vview.ax, view_z = s[0].vview.az, yaw = s[0].vp[0].fyaw}, k.v, c.v); }
    return;
  }
  // "mesh NAME HX HZ TOP": the shell imported a mesh into the world's pack; its row of the pieces table is this page's write (world.coax spw_import_kind)
  if kind == 525 && s.count > 0 && s[0].edit && s[0].follow == 2 { _ := spw_import_kind(s[0].page[..], body); return; }
  if kind == 522 && s.count > 0 && s[0].edit { _ := vp_act(s[0].vp[..], body, s[0].vview); return; }   // the viewport's tool, grid, camera and clock
  // "actor N": the foe to show (0: none); its route and notice range are drawn and the camera flies to it (#13466)
  if kind == 527 && s.count > 0 && s[0].edit && ct_part(body, ' ', 0) == "actor" {
    g := s[0].game[..]; s[0].started = true;
    spw_actor(g, s[0].page[..], sp_whole(body, 0));
    if s[0].page[0].actor > 0 { spv_frame_foe(g, s[0].vp[..], s[0].vview, s[0].page[0].actor - 1); }
    return;
  }
  if kind == 610 && s.count > 0 && body.count > 0 {   // a moment of the game to stand in: "0" to "10"
    n := 0;
    for i: 0..<body.count { d := cast(int) body[i] - 48; if d >= 0 && d <= 9 { n = n * 10 + d; } }
    s[0].started = true; g_stage(s[0].game[..], n);
    return;
  }
  // A scripted host places the smuggler (metaverse-engine/export/unreal/aethyr_script.c, the Unreal bridge's
  // run): 611 "x z" in centimetres, 612 "i" beside foe i, 613 "i" at the boss's weak point i.
  if kind >= 611 && kind <= 613 && s.count > 0 && s[0].started && !s[0].gallery {
    g := s[0].game[..];
    if kind == 611 { g[0].px = cast(f32) sp_whole(body, 0) / 100; g[0].pz = cast(f32) sp_whole(body, 1) / 100; }
    i := sp_whole(body, 0);
    if kind == 612 && i >= 0 && i < FOES { g[0].px = g[0].fx[i] + 1; g[0].pz = g[0].fz[i]; }
    if kind == 613 && i >= 0 && i < 3 { w := weak_at(g, i); g[0].px = w.x; g[0].pz = w.z + 0.1; g_collide(g); }
    return;
  }
  if kind != 600 || s.count < 1 { return; }
  // the dev server's page (coax serve: this computer's address) may ask for the fixture layer,
  // ?layer=fixture, to see placed pieces in the world; no other address loads it
  s[0].dev = sp_has(body, "://127.0.0.1") || sp_has(body, "://localhost");
  // the page follows the world `splice` (world.coax): its dev lane for someone who edits (?edit), else live
  s[0].edit = sp_has(body, "?edit") || sp_has(body, "&edit");
  if s[0].follow == 0 { s[0].follow = 1; }
  if s[0].dev && s[0].fixture == 0 && (sp_has(body, "?layer=fixture") || sp_has(body, "&layer=fixture")) { s[0].fixture = 1; }
  gray := "gray";   // ?gray opens in graybox
  for i: 0..<body.count { if i + gray.count <= body.count && i > 0 && (body[i - 1] == '?' || body[i - 1] == '&') && cast(string) body[i..<i + gray.count] == gray { s[0].game[0].gray = true; } }
  target := "scene=";
  for i: 0..<body.count {
    hit := true;
    for j: 0..<target.count {
      if i + j >= body.count || body[i + j] != target[j] { hit = false; break; }
    }
    if hit {
      s[0].gallery = true;
      n := 0; digits := 0; at := i + target.count;
      while at < body.count && digits < 3 {
        d := cast(int) body[at] - 48;
        if d < 0 || d > 9 { break; }
        n = n * 10 + d; digits += 1; at += 1;
      }
      s[0].scene = ifx digits > 0 && n < SP_SCENES then n else 0;
      return;
    }
  }
}

// Shadows follow what the camera looks at (Anime Lab's are fixed on its courtyard).
sp_shadow_rows :: (u: [] f32, l: Point, c: Point) {
  z := unit_or(l, v3(0, 1, 0));
  r := unit_or(cross(v3(0, 1, 0), z), v3(1, 0, 0));
  up := cross(z, r);
  k := 1 / SHADOW_HALF;
  put4(u, U_SHADOW, r.x * k, r.y * k, r.z * k, -dot(r, c) * k);
  put4(u, U_SHADOW + 4, up.x * k, up.y * k, up.z * k, -dot(up, c) * k);
  d := -0.5 / SHADOW_DEEP;
  put4(u, U_SHADOW + 8, z.x * d, z.y * d, z.z * d, 0.5 - dot(z, c) * d);
  put4(u, U_SHADOW + 12, 0, 0, 0, 1);
}

// The frame: the anime look over the world. The game steps, writes what moves and draws its
// interface; a still scene has one fixed camera and no interface.
splice_frame :: (s: [] Splice, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool,
                 world: [] u32, live: [] u32, pieces: [] u32, places: [] u32, style: [] f32, imports: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || u.count < UNIFORM_FLOATS || !(width >= 1) || !(height >= 1) { return 0; }
  g := s[0].game[..];
  if !s[0].started { s[0].started = true; s[0].time = 0; g_reset(g); }
  if !s[0].gallery && s[0].built_gray != g[0].gray { s[0].world_built = false; s[0].built_gray = g[0].gray; }
  if !s[0].world_built || (s[0].gallery && s[0].built_scene != s[0].scene) {
    pen := [1] Pen.[Pen.{graybox = !s[0].gallery && g[0].gray}];
    if s[0].gallery { sp_build_world(world, pen[..], s[0].scene); } else { g_world(g, world, pen[..]); }
    s[0].world_n = pen[0].n; s[0].world_built = true; s[0].built_scene = s[0].scene;
    s[0].over = pen[0].over; s[0].world_gen += 1;
  }
  step := ifx still then 0.0f32 else clamp(dt, 0, 0.1);
  s[0].held = still; s[0].aspect = width / height;
  s[0].time += step;
  t := s[0].time;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  for i: 0..<lo_i(style.count, STYLE_FLOATS) { u[U_STYLE + i] = style[i]; }
  view := sp_camera(s[0].scene); key := sp_look(s[0].scene).key; flash := 0.0f32;
  s[0].live_n = 0;
  if !s[0].gallery {
    // the world: opened once the page's facts came, then its one request at a time and any piece rising in
    // until the world's document comes, or when no world answers (nothing published, a page with no API), the
    // layer holds the shipped pieces: the solar farm, Sniper's rover train and its room, so a new run can play (#13505)
    if !s[0].shipped_in && s[0].fixture == 0 && g[0].layer[0].st[0].n == 0 { s[0].shipped_in = true; _ := spw_shipped(g); }
    if s[0].follow == 1 {
      s[0].follow = ifx spw_page_open(g, s[0].page[..], ifx s[0].edit then WL_DEV else WL_LIVE) then 2 else 3;
      s[0].page[0].f[0].tables = true;   // this page reads the world's own content tables (#13419)
    }
    // tables that changed (the world's own read, or a cell edited): the kinds' meshes and the designed world are written again
    if s[0].tables_seen != s[0].page[0].tables_gen { s[0].tables_seen = s[0].page[0].tables_gen; s[0].ld[0].meshed = false; s[0].world_built = false; }
    if s[0].follow == 2 { wf_step(s[0].page[0].f[..], step); }
    sl_rise_step(g, step);
    // the editor's clock (pause, step) and hands: while a tool is picked, the camera flies or the World is
    // simulated, the player's keys do not reach the game
    vp := s[0].vp[..];
    if !vp_hands(vp) { g[0].fwd = false; g[0].back = false; g[0].left = false; g[0].right = false; g[0].turn_l = false; g[0].turn_r = false; }
    // the editor's time of day is the world's clock table; Simulate runs the foes as if no one were there (#13466)
    if s[0].edit {
      g[0].unseen = vp[0].sim || s[0].page[0].actor > 0;   // an actor shown is looked at, not met
      if s[0].clock_seen != g[0].c[0].clock || s[0].foes_seen != s[0].page[0].tables_gen {
        s[0].clock_seen = g[0].c[0].clock; s[0].foes_seen = s[0].page[0].tables_gen;
        g[0].view = g[0].c[0].clock; g_foes(g);
      }
    }
    s[0].sdt = vp_run_dt(vp, step);
    g_step(g, s[0].sdt);
    view = g_camera(g); key = g_key_light(g); flash = g[0].flash;
    seen := VpView.{ex = view.eye.x, ey = view.eye.y, ez = view.eye.z, ax = view.at.x, ay = view.at.y, az = view.at.z, fov = view.fov, w = width, h = height};
    if vp[0].fly {
      k := s[0].vkeys;
      vp_fly_step(vp, step, (ifx k[0] then 1.0f32 else 0.0f32) - (ifx k[1] then 1.0f32 else 0.0f32), (ifx k[3] then 1.0f32 else 0.0f32) - (ifx k[2] then 1.0f32 else 0.0f32), (ifx k[5] then 1.0f32 else 0.0f32) - (ifx k[4] then 1.0f32 else 0.0f32), false);
      seen = vp_fly_view(vp, seen);
      view.eye = v3(seen.ex, seen.ey, seen.ez); view.at = v3(seen.ax, seen.ay, seen.az);
    }
    s[0].vview = seen;
    pen := [1] Pen.[Pen.{graybox = g[0].gray}];
    g_live(g, live, pen[..]);
    s[0].live_n = pen[0].n;
    s[0].live_over = pen[0].over;
    drv_frame(s[0].drive[..], width, height, dpr, false); sy_list(g, s[0].drive[..]);
    lights: [LIGHTS * LIGHT_FLOATS] f32;
    g_lights(g, lights[..]);
    for i: 0..<LIGHTS * LIGHT_FLOATS { u[U_LIGHTS + i] = lights[i]; }
  }
  view_rows(u, view, width / height);
  if style.count >= STYLE_FLOATS { u[U_STYLE + SU_KEY_DIR] = key.x; u[U_STYLE + SU_KEY_DIR + 1] = key.y; u[U_STYLE + SU_KEY_DIR + 2] = key.z; u[U_STYLE + SU_KEY_DIR + 3] = 0; }
  if s[0].gallery { shadow_rows(u, key); } else { sp_shadow_rows(u, key, view.at); }
  put4(u, U_SIZE, width, height, t, dpr);
  ink := hi(1, lo(width, height) / 720);
  // a hit or a breakthrough flashes; speed lines only on the hoverboard at speed (#13485), and a speed
  // below zero asks its post and overlay passes for the graybox (gpu/splice-bots.coax)
  lines := ifx !s[0].gallery && g_riding(g) && g[0].mode == M_PLAY then board_lines(g[0].board[0]) * 0.8f32 else 0.0f32;
  put4(u, U_FX, flash, 0, ifx !s[0].gallery && g[0].gray then -1.0f32 else lines, ink);
  put4(u, U_DRAW, 0, 0, 0, -1);
  put4(u, U_MISC, ifx animelab_phone(width, dpr) then 1.0f32 else 0.0f32, 0.5, 0.45, 1);
  s[0].draws[0] = 0; s[0].draws[1] = cast(u32) s[0].world_n; s[0].draws[2] = 0x80000000; s[0].draws[3] = 1;
  s[0].draws[4] = 0; s[0].draws[5] = cast(u32) s[0].live_n; s[0].draws[6] = 0x80000001; s[0].draws[7] = 1;
  s[0].draw_n = ifx s[0].gallery then 1 else 2;
  if s[0].gallery { return 0; }   // a still scene has no interface
  // the edit layer, retained: the kinds' meshes are written once, the placed pieces' rows when the
  // layer changes, and each kind with a placed piece is one more draw of its instances
  if s[0].fixture == 1 { s[0].fixture = 2; _ := sl_fixture(g); }
  sd_meshes(s[0].ld[..], g, pieces, cast(string) imports[0..<ifx s[0].imports_n > imports.count then 0 else s[0].imports_n]); sd_places(s[0].ld[..], g, places);
  s[0].draw_n = sd_draws(s[0].ld[..], g, s[0].draws[..], 2);
  s[0].draw_n = fr_player(g, s[0].ld[..], pieces, places, s[0].draws[..], s[0].draw_n);   // you, as your character (front.coax)
  n := g_overlay(g, out, u, width, height);
  // the selected piece is outlined where it stands, or where a drag would leave it
  if s[0].edit {
    mark := spv_mark(g, s[0].page[..], s[0].vp[..], s[0].vview);
    if mark.ok { n = ui_box(out, n, mark.x0, mark.y0, mark.x1, mark.y1, 3 * lo(width / 1280, height / 800), INK()); }
  }
  return n;
}
splice_key :: (s: [] Splice, key: int, down: bool) -> bool #export_c #effects(all) {
  if s[0].gallery { return false; }
  if down && (key == 'g' || key == 'G') { s[0].game[0].gray = !s[0].game[0].gray; return true; }   // graybox, in any mode
  if !s[0].started { return false; }
  // hands off: the keys fly the camera (W S A D, Q down, E up) or do nothing
  if s[0].edit && !vp_hands(s[0].vp[..]) {
    names := "wsadqe"; caps := "WSADQE";
    for i: 0..<6 { if key == cast(int) names[i] || key == cast(int) caps[i] { s[0].vkeys[i] = down; return s[0].vp[0].fly; } }
    return false;
  }
  return g_key(s[0].game[..], key, down);
}
// Mouse look (the host holds the pointer while you walk): 0 a still scene, 1 the cursor is free, 2 hold it.
splice_mouselook :: (s: [] Splice) -> int #export_c #effects(all) {
  if s[0].gallery || !s[0].started { return 0; }
  if s[0].edit && !vp_hands(s[0].vp[..]) { return 1; }   // a tool is picked: the cursor is free
  return g_mouselook(s[0].game[..]);
}
splice_look :: (s: [] Splice, dx: f32, dy: f32) #export_c #effects(all) { if !s[0].gallery && s[0].started { g_look(s[0].game[..], dx, dy); } }
splice_lock :: (s: [] Splice, status: int) #export_c #effects(all) { if !s[0].gallery && s[0].started { g_lock(s[0].game[..], status); } }
splice_pointer :: (s: [] Splice, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  if s[0].gallery || !s[0].started { return false; }
  if s[0].edit && !vp_hands(s[0].vp[..]) { spv_pointer(s[0].game[..], s[0].page[..], s[0].vp[..], s[0].vw[..], s[0].vview, x, y, phase); return true; }
  return g_pointer(s[0].game[..], x, y, phase);
}

// ---- realm scripts (#13467; scripts.coax; coax/web/host.js "A realm's scripts")
SPLICE_SCRIPTS_URL :: "/api/worlds/splice-bots/scripts";
// The scripts the world's tables name, as the page's script loader reads them
// (metaverse-engine/script/loader.coax): the list's address, then "AT HASH" a row. "" when it names none.
splice_script_wants :: (s: [] Splice) -> string #export_c #effects(all) {
  if s.count == 0 || s[0].gallery || s[0].game[0].c[0].script_n == 0 { return ""; }
  n := ct_put(s[0].swants[..], 0, SPLICE_SCRIPTS_URL); n = ct_put(s[0].swants[..], n, "\n");
  for r: 0..<s[0].game[0].c[0].script_n {
    row := s[0].game[0].c[0].scripts[r];
    n = ct_put_int(s[0].swants[..], n, row.slot); n = ct_put(s[0].swants[..], n, " "); n = ct_put(s[0].swants[..], n, cast(string) row.hash[..]); n = ct_put(s[0].swants[..], n, "\n");
  }
  return ifx n > s[0].swants.count then "" else cast(string) s[0].swants[0..<n];
}
// The frame for the step just taken (script.frame.v1) into out: its length, 0 when no script would run.
splice_script_frame :: (s: [] Splice, out: [] u8) -> int #export_c #effects(all) {
  if s.count == 0 || s[0].gallery || !s[0].started || s[0].game[0].c[0].script_n == 0 { return 0; }
  sps_frame(s[0].game[..], s[0].sf[..], s[0].sdt);
  n := sf_write(s[0].sf[..], out);
  return ifx n > 0 then n else 0;
}
// A tick's result (script.result.v1): what each script said for the next step. False for bytes that are not one.
splice_script_result :: (s: [] Splice, bytes: [] u8) -> bool #export_c #effects(all) {
  if s.count == 0 || !sr_read(bytes, s[0].sr[..]) { return false; }
  sps_apply(s[0].game[..], s[0].sr[..]);
  return true;
}
coaxial_splice_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_splice_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_splice_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }
// For a host that draws some kinds of thing itself and plays sounds (splice-game.coax, "Things
// and events"). The list is the last frame's: kind, variant, x, y, z, yaw, scale, phase each.
splice_things :: (s: [] Splice, out: [] f32) -> int #export_c #effects(all) {
  if s.count < 1 || s[0].gallery { return 0; }
  g := s[0].game[..]; n := g[0].thing_n;
  if n * THING_FLOATS > out.count { n = out.count / THING_FLOATS; }
  for i: 0..<n * THING_FLOATS { out[i] = g[0].things[i]; }
  return n;
}
// Where thing k's vertices are in the live store: its first vertex, and how many (0 when hidden).
splice_thing_first :: (s: [] Splice, k: int) -> int #export_c #effects(all) { return ifx s.count > 0 && k >= 0 && k < s[0].game[0].thing_n then s[0].game[0].thing_first[k] else 0; }
splice_thing_count :: (s: [] Splice, k: int) -> int #export_c #effects(all) { return ifx s.count > 0 && k >= 0 && k < s[0].game[0].thing_n then s[0].game[0].thing_count[k] else 0; }
splice_thing_hide :: (s: [] Splice, kind: int, hide: bool) #export_c #effects(all) { if s.count > 0 && kind >= 0 && kind < TK_KINDS { s[0].game[0].hide[kind] = hide; } }
// What has happened since the last call, oldest first; the list is emptied.
splice_events :: (s: [] Splice, out: [] f32) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  g := s[0].game[..]; n := g[0].event_n; if n > out.count { n = out.count; }
  for i: 0..<n { out[i] = cast(f32) g[0].events[i]; }
  g[0].event_n = 0;
  return n;
}
// The page's sound lines since the last call (sound.coax snd_text): NAME GAIN PAN, ~NAME GAIN PAN for a loop.
splice_sounds :: (s: [] Splice, out: [] u8) -> int #export_c #effects(all) { return ifx s.count < 1 || s[0].gallery then 0 else snd_text(s[0].game[..], out); }
splice_world_n :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].world_n; }
splice_world_version :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].world_gen; }
splice_live_n :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].live_n; }
splice_draw_count :: (s: [] Splice) -> int #export_c #effects(all) { return ifx !s[0].world_built then 0 else s[0].draw_n; }
// The edit layer's two stores: the kinds' meshes (vertices, and a count of its writes) and the
// placed pieces' rows (SD_ROW words each, and a count of their writes).
// After the kinds' meshes, the player's walk poses; after the placed pieces' rows, the player's row (front.coax fr_player).
splice_piece_n :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].ld[0].mesh_n + s[0].game[0].fr[0].pose_n; }
splice_piece_version :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].ld[0].mesh_gen + s[0].game[0].fr[0].pose_gen; }
splice_place_n :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].ld[0].place_n + (ifx s[0].game[0].fr[0].row then 1 else 0); }
splice_place_version :: (s: [] Splice) -> int #export_c #effects(all) { return s[0].ld[0].place_gen + s[0].game[0].fr[0].row_gen; }
// This browser's storage (coax/web/STORAGE.md; front.coax): what to ask the host next (0 nothing,
// 1 read your character, 2 keep it, 3 read the kept run, 4 keep it), the bytes to keep, and whether the host took it.
splice_store_wants :: (s: [] Splice) -> int #export_c #effects(all) { return ifx s.count < 1 || s[0].gallery || !s[0].started then 0 else fr_store_wants(s[0].game[..]); }
splice_store_text :: (s: [] Splice, which: int) -> string #export_c #effects(all) { return fr_store_text(s[0].game[..], which); }
splice_store_asked :: (s: [] Splice, which: int, accepted: bool) #export_c #effects(all) { fr_store_asked(s[0].game[..], which, accepted); }
splice_piece_words :: () -> int #export_c #effects(all) { return SD_PIECE_WORDS; }
splice_place_words :: () -> int #export_c #effects(all) { return SD_PLACE_WORDS; }

#test "a scripted host's numbers parse, signs and all, and a missing one is 0" {
  #assert sp_whole("-1250 300", 0) == -1250 && sp_whole("-1250 300", 1) == 300 && sp_whole("7", 0) == 7 && sp_whole("7", 1) == 0 && sp_whole("", 0) == 0;
}
#test "two digit scenes parse, and an unknown scene is the first" {
  s := [1] Splice.[Splice.{}];
  splice_message(s[..], 600, "https://x/worlds/splice-bots?scene=16");
  #assert s[0].scene == 16;
  splice_message(s[..], 600, "?scene=7&x=1");
  #assert s[0].scene == 7;
  splice_message(s[..], 600, "?scene=99");
  #assert s[0].scene == 0;
}

#test "in the site's frame Splice answers hello and a driver's ask, and refuses everything else" {
  s := [1] Splice.[Splice.{}];
  s[0].started = true; g_stage(s[0].game[..], 5);
  // the host says what the frame is before each message; then the message
  splice_message(s[..], 720, "realm-frame.v1 hello");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 ready splice 0 0";
  splice_message(s[..], 721, "1 1"); splice_message(s[..], 720, "realm-frame.v1 hello");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 ready splice 1 1";
  splice_message(s[..], 721, "1 0"); splice_message(s[..], 720, "realm-frame.v1 hello");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 ready splice 1 0";
  // an ask is the driver's command; its answer carries the asker's number
  splice_message(s[..], 720, "realm-frame.v1 ask 41 why foe-9");
  a := rf_read(splice_drive_out(s[..]));
  #assert a.kind == RF_ANSWER && a.seq == 41 && cp_has(a.text, "why foe-9: not-in-state\n") && cp_has(a.text, "code: engine.diagnostic.not-in-state.v1\n");
  splice_message(s[..], 720, "realm-frame.v1 ask 0 why caps");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 answer 0\ncaps: none\n";
  // what is not a message for a realm is refused, and says why; nothing of it runs
  splice_message(s[..], 720, "why you");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 refused not realm-frame.v1";
  splice_message(s[..], 720, "realm-frame.v1 ready splice 1 1");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 refused not a message for a realm";
  splice_message(s[..], 720, "realm-frame.v1 answer 1\nx");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 refused not a message for a realm";
  splice_message(s[..], 720, "realm-frame.v2 hello");
  #assert splice_drive_out(s[..]) == "realm-frame.v1 refused not realm-frame.v1";
  // a driver's own command after it reads the driver's answer again, not the frame's
  splice_message(s[..], 700, "why caps");
  #assert splice_drive_out(s[..]) == "caps: none\n";
}
#test "G turns the graybox on and off, and a new run keeps it" {
  s := [1] Splice.[Splice.{}];
  #assert(splice_key(s[..], 'g', true));
  #assert(s[0].game[0].gray);
  g_reset(s[0].game[..]);
  #assert(s[0].game[0].gray);
  #assert(splice_key(s[..], 'G', true));
  #assert(!s[0].game[0].gray);
  splice_message(s[..], 600, "https://x/worlds/splice-bots?gray");
  #assert(s[0].game[0].gray);
}

// The frame's stores at check size: the world and what moves, the kinds' meshes, the placed pieces' rows.
SpFrameCheck :: struct { s: [1] Splice; out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32; world: [SP_WORLD_WORDS * VERTEX_WORDS] u32; live: [SP_WORLD_WORDS * VERTEX_WORDS] u32;
                         pieces: [SD_PIECE_WORDS] u32; places: [SD_PLACE_WORDS] u32; style: [STYLE_FLOATS] f32; imports: [8192] u8; }
sp_check_frame :: (b: [] SpFrameCheck) -> int #effects(all) {
  return splice_frame(b[0].s[..], b[0].out[..], b[0].u[..], 1280, 720, 1, 0.016, false, b[0].world[..], b[0].live[..], b[0].pieces[..], b[0].places[..], b[0].style[..], b[0].imports[..]);
}
#test "only the dev server's page loads the fixture layer, and placed pieces are draws of instances: the world's store is not written again" #steps 2000000000 #traversal 2000000000 {
  b: [1] SpFrameCheck; s := b[0].s[..];
  // the site's own address asks in vain
  splice_message(s, 600, "https://openagents.com/worlds/splice-bots?layer=fixture");
  #assert !s[0].dev && s[0].fixture == 0;
  _ := sp_check_frame(b[..]);
  // until a world's document comes, the layer holds the shipped pieces (#13505)
  #assert s[0].game[0].layer[0].st[0].n == SPW_SHIPPED_N && splice_place_n(s) == SPW_SHIPPED_N && splice_piece_n(s) > 20000 && splice_piece_version(s) == 1 && !s[0].ld[0].over;
  world := splice_world_version(s); #assert world == 1;
  // the dev server's does
  splice_message(s, 600, "http://127.0.0.1:8800/worlds/splice-bots?layer=fixture");
  #assert s[0].dev && s[0].fixture == 1;
  _ = sp_check_frame(b[..]);
  #assert s[0].fixture == 2 && s[0].game[0].layer[0].st[0].n == SPW_SHIPPED_N + SL_FIXTURE_N && splice_place_n(s) == SPW_SHIPPED_N + SL_FIXTURE_N && splice_place_version(s) == 2;
  kinds := 0; inst := 0;
  for r: 0..<s[0].game[0].c[0].piece_n { if s[0].ld[0].rows[r] > 0 { kinds += 1; inst += s[0].ld[0].rows[r]; } }
  #assert kinds >= 6 && inst == SPW_SHIPPED_N + SL_FIXTURE_N && splice_draw_count(s) == 2 + kinds;
  for k: 2..<splice_draw_count(s) { #assert (s[0].draws[k * 4 + 2] & 0x80000000) != 0 && (s[0].draws[k * 4 + 2] & 0x7fffffff) >= 2 && s[0].draws[k * 4 + 3] >= 1; }
  // the designed world's store and the kinds' meshes were written once; frames that change nothing write nothing
  _ = sp_check_frame(b[..]); _ = sp_check_frame(b[..]);
  #assert splice_world_version(s) == world && splice_piece_version(s) == 1 && splice_place_version(s) == 2;
  // an edit writes the rows, and only them
  #assert sl_remove(s[0].game[..], 3).ok;
  _ = sp_check_frame(b[..]);
  #assert splice_world_version(s) == world && splice_piece_version(s) == 1 && splice_place_version(s) == 3 && splice_place_n(s) == SPW_SHIPPED_N + SL_FIXTURE_N - 1;
  splice_message(s, 600, "http://localhost:8800/worlds/splice-bots?x=1&layer=fixture"); #assert s[0].fixture == 2;
  #assert sp_has("abc", "bc") && sp_has("abc", "") && !sp_has("ab", "abc") && !sp_has("abc", "bd");
}

#test "a host that draws you itself hides the smuggler, and your character is not drawn" #steps 4000000000 #traversal 4000000000 {
  b: [1] SpFrameCheck; s := b[0].s[..];
  _ := sp_check_frame(b[..]);
  g_stage(s[0].game[..], 5);
  _ = sp_check_frame(b[..]); _ = sp_check_frame(b[..]);
  #assert s[0].game[0].mode == M_PLAY && s[0].game[0].fr[0].row;
  n := splice_draw_count(s);
  splice_thing_hide(s, TK_SMUGGLER, true);
  _ = sp_check_frame(b[..]);
  #assert !s[0].game[0].fr[0].row && splice_draw_count(s) == n - 1;
  splice_thing_hide(s, TK_SMUGGLER, false);
  _ = sp_check_frame(b[..]);
  #assert s[0].game[0].fr[0].row && splice_draw_count(s) == n;
}

#test "the page takes the world's import pack whole or keeps the copy from before" #steps 8000000000 #traversal 4000000000 {
  k: [1] SitPack; pack := sit_pack(k[..]);
  b: [1] SpFrameCheck; s := b[0].s[..];
  #assert splice_imports(s, pack, b[0].imports[..]) && s[0].imports_n == pack.count && s[0].game[0].imp[0].n == 1 && s[0].game[0].imp[0].gen == 1 && cast(string) b[0].imports[0..<pack.count] == pack;
  #assert splice_world_fact(s, 9) == 1 && splice_world_fact(s, 10) == 1 && splice_world_fact(s, 11) == 0 && splice_world_fact(s, 13) == pack.count;
  #assert !splice_imports(s, "not a pack", b[0].imports[..]) && !splice_imports(s, pack[0..<pack.count - 4], b[0].imports[..]) && s[0].imports_refused == 2 && s[0].game[0].imp[0].gen == 1 && cast(string) b[0].imports[0..<pack.count] == pack;
  #assert !splice_imports(s, "", b[0].imports[..]) && s[0].imports_refused == 2 && !splice_imports(s, pack, b[0].imports[0..<pack.count - 1]) && s[0].imports_refused == 3 && s[0].imports_n == pack.count;
  g_reset(s[0].game[..]); #assert s[0].game[0].imp[0].n == 1;   // the meshes are the world's, not the run's
}
