  kit_arch_round(buf, p, frame_at(v3(2, 0, -14), 0), 2, sc(0.80, 0.30, 0.22), 30, 22, 4.5, 6, 18);
  kit_mesas(buf, p, 3, sc(0.85, 0.45, 0.32), 6, 500, -90, 26, 18, 34);
  kit_rocks(buf, p, 4, sc(0.72, 0.34, 0.26), 18, 510, 0, -4, 6, 26, 0.5, 2.2);
  kit_beast(buf, p, frame_at(v3(-1, 0, -2), 1.1), 1, 10, sc(0.92, 0.86, 0.74), sink(), sc(0.62, 0.48, 0.36), true);
  sp_robot(buf, p, frame_at(v3(4.5, 0, 3), -0.5), 0.6);
}
// 6, Yellow canyon (pins 1, 10): a deep ochre canyon, the robot small on its floor, a moon above.
sp_canyon :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.95, 0.78, 0.40), false);
  kit_canyon(buf, p, 2, sc(0.96, 0.74, 0.30), sc(0.90, 0.62, 0.26), 600, 12, -90, 10, 26);
  kit_rocks(buf, p, 4, sc(0.82, 0.55, 0.25), 16, 610, 0, -10, 2, 18, 0.4, 1.4);
  kit_moon(buf, p, 5, sc(0.98, 0.95, 0.85), v3(-6, 52, -120), 7);
  sp_robot(buf, p, frame_at(v3(0.5, 0, 0), 0.2), 1);
}
// 7, Palace (pin 6): sage-green domed houses and palms by a sea, the robot on the shore.
sp_palace :: (buf: [] u32, p: [] Pen) {
  kit_ground(buf, p, 1, sc(0.90, 0.80, 0.60), false);
  kit_sea(buf, p, 2, sc(0.30, 0.62, 0.66), sc(0.94, 0.96, 0.92), 0.05, -16, 700);
  wall := sc(0.86, 0.84, 0.72); dome := sc(0.55, 0.72, 0.58);
  kit_dome_house(buf, p, frame_at(v3(-11, 0, -10), 0.2), 3, wall, dome, 6, 5);
  kit_dome_house(buf, p, frame_at(v3(-1, 0, -16), 0), 3, wall, dome, 9, 7);
  kit_dome_house(buf, p, frame_at(v3(9, 0, -11), -0.3), 3, wall, dome, 5, 4);
  kit_towers(buf, p, 5, wall, dome, 710, 2, 2, -26, 8, 12, 16);
  for i: 0..<6 {
    k := cast(f32) i;
    kit_palm(buf, p, frame_at(v3(-14 + k * 5.6, 0, -1.5 - kit_rand(k + 720) * 4), kit_rand(k + 730) * 6), 0.9 + kit_rand(k + 740) * 0.4, 7, sc(0.62, 0.46, 0.32), sc(0.36, 0.58, 0.34));
  }
  sp_robot(buf, p, frame_at(v3(1.5, 0, 5), -0.3), 0.8);
}
// 8, Spider (pin 26): an orange spider bot crossing dark cinder ground at dusk, the robot facing it.
