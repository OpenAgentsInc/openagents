// Exports Splice for Unreal (docs/unreal/2026-11-12-aethyr-to-unreal-exporter-spec.md, GitHub
// #13400): the static world as glTF, and a manifest of what the importer builds around it
// (collision boxes, placements, tuning, key codes, reference shots). It runs the game's own
// layout and world code and re-describes nothing. Same source, same bytes; it refuses a folder
// that exists. Run from the repository root:
//   coax/web/tool.sh metaverse/splice-bots/splice-export.coax NEW_DIR
// The tuning and placement lists below name the game's constants one by one: a constant added
// to splice-game.coax is not exported until it is listed here.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/proc.coax";
#load "splice-game.coax";
#load "../../metaverse-engine/export/bundle.coax";

// The level's kit slots are kits.coax's (KS_ROWS): the manifest's `kits` names each, lists its places
// and the world groups that hold its blockout (the marked triangles, grouped apart), so the importer
// can put a kit.NAME row's mesh at the places and drop those groups.

ceil :: (x: f64) -> f64 #foreign #effects(all);   // libm's, for the PNG writer (coax/lib/image/pillow.coax)

SX_SHOTS :: 6;
sx_shot :: (g: [] SpGame, i: int) -> ExCam {
  if i == 0 { return ExCam.{eye = v3(g[0].at.rover_x - 3, 3.2, g[0].at.rover_z + 15), at = v3(g[0].at.rover_x - 3, 1.8, g[0].at.rover_z - 2), fov = 0.7}; }    // the rover at the mine
  if i == 1 { return ExCam.{eye = v3(0, 3.5, 14), at = v3(0, 1.5, -10), fov = 0.82}; }                                      // the mine mouth
  if i == 2 { return ExCam.{eye = v3(0, 2.6, -16), at = v3(0, 1.5, g[0].at.rubble_z), fov = 0.82}; }                                // the tunnel
  if i == 3 { return ExCam.{eye = v3(9, 5, -43), at = v3(-9, 1, -55), fov = 0.82}; }                                        // the party hall
  if i == 4 { return ExCam.{eye = v3(0, 4, g[0].at.wall_z - 1.5), at = v3(g[0].at.boss_x, 2, g[0].at.boss_z - 4), fov = 0.82}; }                    // the boss chamber
  return ExCam.{eye = v3(g[0].at.vil_x + 14, 6, g[0].at.vil_z + 18), at = v3(g[0].at.vil_x, 2, g[0].at.vil_z), fov = 0.82};                                 // the dome village
}
sx_shot_name :: (i: int) -> string { names := [SX_SHOTS] string.["rover", "mine-mouth", "tunnel", "party-hall", "boss-chamber", "village"]; return names[i]; }
sx_mat_name :: (m: int) -> string { names := [11] string.["world", "skin", "hair", "glow", "flat", "floor", "made", "ink", "smoke", "window", "cloth"]; return ifx m >= 0 && m < 11 then names[m] else "unknown"; }
sx_pick_name :: (i: int) -> string { names := [PICKS] string.["drill-arm", "treads", "battery", "card-move", "card-drill", "drill-plus", "cell-0", "cell-1", "cell-2", "cell-3"]; return names[i]; }

sx_place :: (o: [] Jo, kind: string, name: string, x: f32, y: f32, z: f32) #effects(all) {
  jo_obj(o); ex_str(o, "kind", kind); ex_str(o, "name", name); ex_p3(o, "at", x, y, z); jo_end(o);
}
sx_tune :: (o: [] Jo, name: string, v: f32) #effects(all) { ex_num(o, name, v); }
sx_file_name :: (prefix: string, i: int, tail: string, out: [] u8) -> string {
  n := 0; for c: prefix { out[n] = c; n += 1; }
  out[n] = cast,trunc(u8) (48 + i); n += 1;
  for c: tail { out[n] = c; n += 1; }
  return cast(string) out[0..<n];
}

// A source file of the repository into the bundle's rules/, under the same name or another.
sx_copy :: (from: string, dir: string, name: string, work: [] u8) -> bool #effects(all) {
  p0: [4096] u8; p1: [4096] u8;
  n := fs_read(from, work);
  return n > 0 && fs_write(fs_join(fs_join(dir, "rules", p0[..]), name, p1[..]), cast(string) work[0..<n]);
}
// The world's C: what `coax c UNIT --library` prints, and its header, into rules/.
sx_emit :: (unit: string, dir: string, c_name: string, h_name: string, work: [] u8) -> bool #effects(all) {
  p0: [4096] u8; p1: [4096] u8; p2: [4096] u8; err: [65536] u8;
  rules := fs_join(dir, "rules", p0[..]);
  argv := [8] string.["coax/bin/coax", "c", unit, "--library", "--build-profile", "release", "--header", fs_join(rules, h_name, p1[..])];
  r := proc_run(argv[..], 600000, work, err[..]);
  return r.started == 0 && r.status == 0 && !r.cut && r.out_n > 0 && fs_write(fs_join(rules, c_name, p2[..]), cast(string) work[0..<r.out_n]);
}

sx_put :: (out: [] u8, n: int, s: string) -> int { if n < 0 || n + s.count > out.count { return -1; } for i: 0..<s.count { out[n + i] = s[i]; } return n + s.count; }
// `text` as a C string constant NAME at out[n..]: pieces of at most 2,000 characters (a compiler's
// limit on one literal), each quote, backslash and line end escaped. The new end, or -1 when it does not fit.
sx_c_string :: (out: [] u8, at: int, name: string, text: string) -> int {
  n := at;
  n = sx_put(out, n, "static const char "); n = sx_put(out, n, name); n = sx_put(out, n, "[] =\n  \"");
  piece := 0;
  for c: text {
    if n < 0 || n + 8 > out.count { return -1; }
    if piece >= 2000 { n = sx_put(out, n, "\"\n  \""); piece = 0; }
    if c == '\n' { n = sx_put(out, n, "\\n"); piece += 2; continue; }
    if c == '"' || c == '\\' { out[n] = '\\'; n += 1; piece += 1; }
    if c != '\r' { out[n] = c; n += 1; piece += 1; }
  }
  return sx_put(out, n, "\";\n");
}

// ---- the moving things, each kind and variant as its own mesh in its own space
SX_BAKE :: 22;
SxBake :: struct { kind: int; variant: int; stage: int; name: string; }
sx_bakes :: () -> [SX_BAKE] SxBake {
  return [SX_BAKE] SxBake.[
    SxBake.{kind = TK_SMUGGLER, variant = 0, stage = 5, name = "thing_smuggler_v0"},
    SxBake.{kind = TK_DIGGER, variant = 0, stage = 7, name = "thing_digger_v0"}, SxBake.{kind = TK_DIGGER, variant = 1, stage = 7, name = "thing_digger_v1"},
    SxBake.{kind = TK_RAIDER, variant = 0, stage = 8, name = "thing_raider_v0"}, SxBake.{kind = TK_RAIDER, variant = 1, stage = 8, name = "thing_raider_v1"},
    SxBake.{kind = TK_IMPERIAL, variant = 0, stage = 8, name = "thing_imperial_v0"}, SxBake.{kind = TK_IMPERIAL, variant = 1, stage = 8, name = "thing_imperial_v1"},
    SxBake.{kind = TK_DJ, variant = 0, stage = 8, name = "thing_dj_v0"},
    SxBake.{kind = TK_BOSS, variant = 0, stage = 8, name = "thing_boss_v0"}, SxBake.{kind = TK_BOSS, variant = 1, stage = 8, name = "thing_boss_v1"},
    SxBake.{kind = TK_ROVER, variant = 0, stage = 3, name = "thing_rover_v0"},
    SxBake.{kind = TK_PICKUP, variant = 0, stage = 5, name = "thing_pickup_v0"}, SxBake.{kind = TK_PICKUP, variant = 1, stage = 5, name = "thing_pickup_v1"},
    SxBake.{kind = TK_PICKUP, variant = 3, stage = 5, name = "thing_pickup_v3"}, SxBake.{kind = TK_PICKUP, variant = 4, stage = 5, name = "thing_pickup_v4"},
    SxBake.{kind = TK_PICKUP, variant = 5, stage = 5, name = "thing_pickup_v5"}, SxBake.{kind = TK_PICKUP, variant = 6, stage = 5, name = "thing_pickup_v6"},
    SxBake.{kind = TK_PICKUP, variant = 7, stage = 5, name = "thing_pickup_v7"}, SxBake.{kind = TK_PICKUP, variant = 8, stage = 5, name = "thing_pickup_v8"},
    SxBake.{kind = TK_PICKUP, variant = 9, stage = 5, name = "thing_pickup_v9"},
    SxBake.{kind = TK_RAIDER, variant = 0, stage = 16, name = ""}, SxBake.{kind = TK_RAIDER, variant = 0, stage = 16, name = ""}];   // the last two are unused room
}
sx_kind_name :: (k: int) -> string { names := [TK_KINDS] string.["smuggler", "digger", "raider", "imperial", "dj", "boss", "rover", "pickup"]; return names[k]; }
// One thing as the game draws it at a moment of the run, moved into its own space (its place at
// the origin, facing +z) and appended to `baked`. Returns the vertices appended, 0 when the game
// did not draw that kind and variant there.
sx_bake :: (b: SxBake, live: [] u32, baked: [] u32, at: int) -> int #effects(all) {
  g: [1] SpGame; g_stage(g[..], b.stage);
  if b.kind == TK_DIGGER && b.variant == 1 { g[0].have[H_PLUS] = true; }
  if b.variant == 1 && (b.kind == TK_RAIDER || b.kind == TK_IMPERIAL) { for i: 0..<FOES { g[0].fhost[i] = true; } }
  if b.kind == TK_BOSS { g[0].wall_gone = true; }   // the boss stands past the hallway: drawn once it is open
  if b.kind == TK_BOSS && b.variant == 1 { g[0].boss_down = true; }
  pen: [1] Pen; g_live(g[..], live, pen[..]);
  for k: 0..<g[0].thing_n {
    o := k * THING_FLOATS;
    if cast(int) g[0].things[o] != b.kind || cast(int) g[0].things[o + 1] != b.variant || g[0].thing_count[k] < 3 { continue; }
    n := g[0].thing_count[k]; first := g[0].thing_first[k];
    if (at + n) * VERTEX_WORDS > baked.count { return 0; }
    origin := v3(g[0].things[o + 2], g[0].things[o + 3], g[0].things[o + 4]); f := frame_at(origin, g[0].things[o + 5]);
    for v: 0..<n {
      i := (first + v) * VERTEX_WORDS; j := (at + v) * VERTEX_WORDS;
      d := sub(v3(f32_from_bits(live[i]), f32_from_bits(live[i + 1]), f32_from_bits(live[i + 2])), origin);
      baked[j] = f32_bits(dot(d, f.x)); baked[j + 1] = f32_bits(d.y); baked[j + 2] = f32_bits(dot(d, f.z));
      packed := live[i + 3];
      nn := v3(cast(f32) (packed & 255) / 255 * 2 - 1, cast(f32) ((packed >> 8) & 255) / 255 * 2 - 1, cast(f32) ((packed >> 16) & 255) / 255 * 2 - 1);
      baked[j + 3] = byte_of(dot(nn, f.x) * 0.5 + 0.5) | (byte_of(nn.y * 0.5 + 0.5) << 8) | (byte_of(dot(nn, f.z) * 0.5 + 0.5) << 16) | (packed & 0xFF000000);
      baked[j + 4] = live[i + 4]; baked[j + 5] = live[i + 5];
    }
    return n;
  }
  return 0;
}

// You, as the game draws you at a moment of the run: your character's first walk pose, which
// front.coax fr_player writes into the piece store already in its own space (the origin, facing +z).
sx_bake_you :: (b: SxBake, pieces: [] u32, baked: [] u32, at: int) -> int #effects(all) {
  g: [1] SpGame; g_stage(g[..], b.stage);
  d: [1] SpLayerDraw; places: [SD_PLACE_WORDS] u32; draws: [4] u32;
  _ := fr_player(g[..], d[..], pieces, places[..], draws[..], 0);
  f := g[0].fr[..];
  if f[0].posed_n < 1 { return 0; }
  n := f[0].pose_count[0]; first := f[0].pose_first[0];
  if n < 3 || (at + n) * VERTEX_WORDS > baked.count { return 0; }
  for w: 0..<n * VERTEX_WORDS { baked[at * VERTEX_WORDS + w] = pieces[first * VERTEX_WORDS + w]; }
  return n;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 1 || args_count(a[..]) > 2 { print("usage: splice-export NEW_DIR [WORLD_DIR]   (run from the repository root)\n"); return 2; }
  dir := args_at(a[..], 0);
  world_dir := ifx args_count(a[..]) == 2 then args_at(a[..], 1) else "";
  if fs_exists(dir) { print("splice-export: % exists; give a folder that does not\n", dir); return 1; }

  // the game's own world: reset (which lays out the walls), then the world's triangles
  g: [1] SpGame; g_reset(g[..]);
  // a baked world's content tables are the world's: its walls, places and placements as the page draws them with them
  wt: [1] SpwTables; tables: [65536] u8; wtn := 0;
  if world_dir != "" {
    p0: [4096] u8;
    wtn = fs_read(fs_join(world_dir, "splice-bots.live.tables", p0[..]), tables[..]);
    if wtn < 1 || !spw_tables_open(g[..], wt[..], cast(string) tables[0..<wtn]) { print("splice-export: % has no splice-bots.live.tables this build reads\n", world_dir); return 1; }
  }
  world: [150000 * VERTEX_WORDS] u32; pen: [1] Pen;   // the page's store: splice-bots.coax SP_WORLD_WORDS vertices
  g_world(g[..], world[..], pen[..]);
  if pen[0].over || pen[0].n < 3 { print("splice-export: the world did not fit its store\n"); return 1; }
  vertices := pen[0].n;

  glb: [16777216] u8; scratch: [16777216] u8; groups: [GLB_GROUPS] GlbGroup;   // things.glb holds the Digger twice at about 90,000 vertices
  // each kit slot's blockout, as g_world marked it, grouped apart: slot k is tag k + 1 (kits.coax)
  marks := g[0].kit[0];
  if marks.over { print("splice-export: the world marked more kit slot runs than kits.coax KS_MARKS\n"); return 1; }
  tags: [KS_MARKS] GlbTag;
  for i: 0..<marks.n { tags[i] = GlbTag.{first = marks.m[i].first, count = marks.m[i].count, tag = marks.m[i].slot + 1}; }
  w := glb_world_tagged(world[..], vertices, EX_CELL, tags[0..<marks.n], glb[..], scratch[..], groups[..]);
  if !w.ok { print("splice-export: the glTF writer refused the world\n"); return 1; }

  path: [4096] u8; name: [64] u8; hex: [64] u8;
  if !fs_mkdir(dir) || !fs_mkdir(fs_join(dir, "shots", path[..])) || !fs_mkdir(fs_join(dir, "fonts", path[..])) { print("splice-export: could not make the folder\n"); return 1; }
  if !ex_put(dir, "world.glb", glb[0..<w.bytes]) { print("splice-export: could not write world.glb\n"); return 1; }

  json: [1048576] u8; o: [1] Jo; jo_start(o[..], json[..]); j := o[..];
  jo_obj(j);
  ex_int(j, "aexport", EX_VERSION);
  jo_key(j, "game"); jo_obj(j); ex_str(j, "id", "splice"); ex_str(j, "name", "Splice"); ex_str(j, "source", "metaverse/splice-bots/splice-game.coax"); jo_end(j);
  // The Metaverse Engine: metres, right-handed, y up (glTF's own convention). Measured with Unreal 5.9's default
  // glTF import (GitHub #13399): Unreal X = x, Y = z, Z = y, centimetres.
  jo_key(j, "axes"); jo_obj(j); ex_str(j, "aethyr", "metres, right-handed, y up"); ex_str(j, "unreal_x", "x"); ex_str(j, "unreal_y", "z"); ex_str(j, "unreal_z", "y"); ex_num(j, "unreal_units_per_metre", 100); jo_end(j);

  jo_key(j, "world"); jo_obj(j);
  sha := ex_sha(glb[0..<w.bytes], hex[..]);
  if sha == "" { print("splice-export: could not hash world.glb\n"); return 1; }
  ex_str(j, "file", "world.glb"); ex_str(j, "sha256", sha); ex_int(j, "bytes", w.bytes);
  ex_num(j, "cell_metres", EX_CELL); ex_int(j, "triangles", w.triangles); ex_int(j, "source_vertices", w.vertices); ex_int(j, "vertices", w.welded);
  ex_p3(j, "min", w.lo[0], w.lo[1], w.lo[2]); ex_p3(j, "max", w.hi[0], w.hi[1], w.hi[2]);
  ex_str(j, "attributes", "POSITION, NORMAL, COLOR_0 (linear), TEXCOORD_0 (x: the cel vertex parameter, y: its object number), TEXCOORD_1 (x: the material class)");
  jo_key(j, "groups"); jo_arr(j);
  for gi: 0..<w.groups {
    gr := groups[gi];
    jo_obj(j); ex_str(j, "name", glb_name(gr, name[..])); if gr.tag > 0 { ex_str(j, "kit", ks_name(gr.tag - 1)); } ex_str(j, "material", sx_mat_name(gr.mat)); ex_int(j, "material_id", gr.mat); ex_int(j, "cell_x", gr.cx); ex_int(j, "cell_z", gr.cz);
    ex_int(j, "vertices", gr.vertices); ex_int(j, "triangles", gr.triangles); ex_p3(j, "min", gr.lo[0], gr.lo[1], gr.lo[2]); ex_p3(j, "max", gr.hi[0], gr.hi[1], gr.hi[2]);
    jo_end(j);
  }
  jo_end(j); jo_end(j);

  jo_key(j, "materials"); jo_arr(j);
  for m: 0..<11 { used := 0; for gi: 0..<w.groups { if groups[gi].mat == m { used += groups[gi].triangles; } } jo_obj(j); ex_int(j, "id", m); ex_str(j, "name", sx_mat_name(m)); ex_int(j, "triangles", used); jo_end(j); }
  jo_end(j);

  // collision: the rules' own boxes. A height of 0 is a box the world draws another way (the
  // rover, the crate, the stage, the catwalk's rail, the edge of the map): it still blocks.
  jo_key(j, "collision"); jo_obj(j);
  jo_key(j, "boxes"); jo_arr(j);
  for i: 0..<g[0].wall_n { k := i * 5; jo_obj(j); ex_num(j, "x0", g[0].walls[k]); ex_num(j, "x1", g[0].walls[k + 1]); ex_num(j, "z0", g[0].walls[k + 2]); ex_num(j, "z1", g[0].walls[k + 3]); ex_num(j, "height", g[0].walls[k + 4]); jo_end(j); }
  jo_end(j);
  jo_key(j, "deck"); jo_obj(j); ex_num(j, "x", g[0].at.deck_x); ex_num(j, "x_far", 20); ex_num(j, "z0", g[0].at.deck_z0); ex_num(j, "z1", g[0].at.deck_z1); ex_num(j, "y", DECK_Y); ex_num(j, "ramp", RAMP); ex_num(j, "ramp_run", 3); jo_end(j);
  ex_num(j, "player_radius", T_RADIUS);
  jo_end(j);

  jo_key(j, "placements"); jo_arr(j);
  sx_place(j, "start", "mine-start", g[0].at.start_x, 0, g[0].at.start_z);
  sx_place(j, "start", "village-start", g[0].at.vil_x, 0, g[0].at.vil_z - 3);
  sx_place(j, "rover", "rover", g[0].at.rover_x, 0, g[0].at.rover_z);
  sx_place(j, "checkpoint", "post", g[0].at.post_x, 0, g[0].at.post_z);
  sx_place(j, "crate", "stash-crate", g[0].at.crate_x, 0, g[0].at.crate_z);
  sx_place(j, "rubble", "rubble", 0, 0, g[0].at.rubble_z);
  sx_place(j, "boss-wall", "boss-wall", 0, 0, g[0].at.wall_z);
  sx_place(j, "boss", "boss", g[0].at.boss_x, 0, g[0].at.boss_z);
  for i: 0..<3 { p := weak_at(g[..], i); sx_place(j, "weak-point", sx_file_name("weak-", i, "", name[..]), p.x, p.y, p.z); }
  sx_place(j, "stage", "edit-bay", g[0].at.bay_x, 0, g[0].at.bay_z);
  sx_place(j, "stage", "memory", g[0].at.mem_x, 0, g[0].at.mem_z);
  sx_place(j, "village", "village", g[0].at.vil_x, 0, g[0].at.vil_z);
  sx_place(j, "scanner", "scanner-gate", g[0].at.vil_x, 0, g[0].at.scan_z);
  for i: 0..<PICKS { sx_place(j, "pickup", sx_pick_name(i), pick_x(g[..], i), 0, pick_z(g[..], i)); }
  for i: 0..<FOES {
    kind := ifx i < F_RAIDERS then "raider" else "imperial";
    sx_place(j, kind, sx_file_name(ifx i < F_RAIDERS then "raider-" else "imperial-", i, "-a", name[..]), foe_ax(g[..], i), 0, foe_az(g[..], i));
    sx_place(j, kind, sx_file_name(ifx i < F_RAIDERS then "raider-" else "imperial-", i, "-b", name[..]), foe_bx(g[..], i), 0, foe_bz(g[..], i));
  }
  for i: 0..<7 { p := rail_at(g[..], cast(f32) i * 50); sx_place(j, "rail", sx_file_name("rail-", i, "", name[..]), p.x, p.y, p.z); }
  jo_end(j);

  jo_key(j, "tuning"); jo_obj(j);
  sx_tune(j, "T_WALK", T_WALK); sx_tune(j, "T_TURN", T_TURN); sx_tune(j, "T_LOOK", T_LOOK); sx_tune(j, "T_RADIUS", T_RADIUS);
  sx_tune(j, "T_HEAT_PIECE", T_HEAT_PIECE); sx_tune(j, "T_HEAT_MAX", T_HEAT_MAX); sx_tune(j, "T_HEAT_COOL", T_HEAT_COOL); sx_tune(j, "T_COOL_RANGE", T_COOL_RANGE);
  sx_tune(j, "T_HEARTS", cast(f32) T_HEARTS); sx_tune(j, "T_HIT_COOL", T_HIT_COOL);
  sx_tune(j, "T_NOTICE", T_NOTICE); sx_tune(j, "T_NOTICE_HEAT", T_NOTICE_HEAT); sx_tune(j, "T_RAIDER_SPEED", T_RAIDER_SPEED); sx_tune(j, "T_RAIDER_WANDER", T_RAIDER_WANDER); sx_tune(j, "T_GIVE_UP", T_GIVE_UP); sx_tune(j, "SB_BLOW_REACH", SB_BLOW_REACH);
  sx_tune(j, "T_USE_RANGE", T_USE_RANGE); sx_tune(j, "T_PICK_RANGE", T_PICK_RANGE); sx_tune(j, "T_SAVE_RANGE", T_SAVE_RANGE); sx_tune(j, "T_CARD_TIME", T_CARD_TIME);
  sx_tune(j, "T_MOVE_SHORT", T_MOVE_SHORT); sx_tune(j, "T_MOVE_MAX", T_MOVE_MAX); sx_tune(j, "T_DRILL_REACH", T_DRILL_REACH); sx_tune(j, "T_BAD_CUT", T_BAD_CUT);
  sx_tune(j, "T_SWEEP_EVERY", T_SWEEP_EVERY); sx_tune(j, "T_SWEEP_TIME", T_SWEEP_TIME); sx_tune(j, "T_SWEEP_WARN", T_SWEEP_WARN); sx_tune(j, "T_ARM", T_ARM);
  sx_tune(j, "T_STUN_RANGE", T_STUN_RANGE); sx_tune(j, "T_STUN_TIME", T_STUN_TIME);
  sx_tune(j, "SB_BOSS_LONG", SB_BOSS_LONG); sx_tune(j, "SB_BOSS_TALL", SB_BOSS_TALL); sx_tune(j, "GA_LAB_R", GA_LAB_R);   // the boss and its lab, for the metrics room (#13552)
  sx_tune(j, "T_HIT_RANGE", T_HIT_RANGE); sx_tune(j, "T_STAGGER", T_STAGGER); sx_tune(j, "T_KNOCK", T_KNOCK); sx_tune(j, "T_RAIDER_HP", cast(f32) T_RAIDER_HP); sx_tune(j, "T_IMPERIAL_HP", cast(f32) T_IMPERIAL_HP); sx_tune(j, "T_IMPERIAL_SPEED", T_IMPERIAL_SPEED); sx_tune(j, "T_PATROL", T_PATROL);
  sx_tune(j, "T_HEAT_SCRAP", T_HEAT_SCRAP); sx_tune(j, "T_FOLLOW", T_FOLLOW); sx_tune(j, "T_BOT_GO", T_BOT_GO);
  sx_tune(j, "T_BANNER", T_BANNER); sx_tune(j, "T_MEMORY", T_MEMORY); sx_tune(j, "T_FADE", T_FADE); sx_tune(j, "T_PASS", T_PASS);
  sx_tune(j, "T_RAIL", T_RAIL); sx_tune(j, "T_RAIL_PING", T_RAIL_PING); sx_tune(j, "T_RAIL_SPEED", T_RAIL_SPEED); sx_tune(j, "T_RAIL_SLOW", T_RAIL_SLOW); sx_tune(j, "T_RAIL_FAST", T_RAIL_FAST);
  jo_end(j);

  // where the uniform block a frame writes holds what a host reads (animelab.coax U_*; floats)
  jo_key(j, "uniforms"); jo_obj(j);
  ex_int(j, "floats", UNIFORM_FLOATS); ex_int(j, "eye", U_EYE); ex_int(j, "forward", U_FWD); ex_int(j, "right", U_RIGHT); ex_int(j, "up", U_UP);
  ex_int(j, "fx", U_FX); ex_int(j, "draw", U_DRAW); ex_int(j, "misc", U_MISC);
  ex_int(j, "panels", U_PANELS); ex_int(j, "panel_count", PANELS); ex_int(j, "panel_floats", PANEL_FLOATS);
  ex_int(j, "lights", U_LIGHTS); ex_int(j, "light_count", 8); ex_int(j, "style", U_STYLE);
  jo_end(j);

  // ---- the moving things: one mesh for each kind and variant, and the names a host knows them by
  things_n := 0;
  {
    live: [150000 * VERTEX_WORDS] u32; baked: [400000 * VERTEX_WORDS] u32; pieces: [SD_PIECE_WORDS] u32;   // baked: every thing, the Digger about 90,000 vertices each time
    bakes := sx_bakes(); parts: [SX_BAKE] GlbPart; at := 0;
    for b: bakes {
      if b.name == "" { continue; }
      n := ifx b.kind == TK_SMUGGLER then sx_bake_you(b, pieces[..], baked[..], at) else sx_bake(b, live[..], baked[..], at);
      if n < 3 { print("splice-export: the game did not draw % where the exporter looked\n", b.name); return 1; }
      parts[things_n] = GlbPart.{name = b.name, first = at, count = n}; things_n += 1; at += n;
    }
    tgroups: [SX_BAKE] GlbGroup;
    tw := glb_parts(baked[..], parts[0..<things_n], glb[..], scratch[..], tgroups[..]);
    if !tw.ok || !ex_put(dir, "things.glb", glb[0..<tw.bytes]) { print("splice-export: could not write things.glb\n"); return 1; }
    tsha := ex_sha(glb[0..<tw.bytes], hex[..]);
    jo_key(j, "things"); jo_obj(j);
    ex_str(j, "file", "things.glb"); ex_str(j, "sha256", tsha); ex_int(j, "bytes", tw.bytes);
    ex_str(j, "about", "each kind and variant as the game draws it at rest, in its own space: its place at the origin, facing +z; a host places it at a listed thing's place and yaw");
    jo_key(j, "kinds"); jo_arr(j); for k: 0..<TK_KINDS { jo_str(j, sx_kind_name(k)); } jo_end(j);
    ex_int(j, "thing_floats", THING_FLOATS);
    jo_key(j, "meshes"); jo_arr(j);
    k := 0;
    for b: bakes {
      if b.name == "" { continue; }
      jo_obj(j); ex_str(j, "name", b.name); ex_str(j, "kind", sx_kind_name(b.kind)); ex_int(j, "kind_id", b.kind); ex_int(j, "variant", b.variant);
      ex_int(j, "vertices", tgroups[k].vertices); ex_int(j, "triangles", tgroups[k].triangles); ex_p3(j, "min", tgroups[k].lo[0], tgroups[k].lo[1], tgroups[k].lo[2]); ex_p3(j, "max", tgroups[k].hi[0], tgroups[k].hi[1], tgroups[k].hi[2]);
      jo_end(j); k += 1;
    }
    jo_end(j); jo_end(j);
  }
  // the level's kit slots (kits.coax): an overrides row kit.NAME puts its mesh at each of the slot's places,
  // and the slot's blockout (its groups) is dropped. A slot with no places is not placed yet.
  jo_key(j, "kits"); jo_obj(j);
  pl: [KS_PLACE_MAX] KsPlace;
  for k: 0..<KS_N {
    jo_key(j, ks_name(k)); jo_obj(j); ex_str(j, "about", ks_about(k));
    jo_key(j, "places"); jo_arr(j);
    for i: 0..<ks_places(g[..], k, pl[..]) { jo_obj(j); ex_p3(j, "at", pl[i].x, pl[i].y, pl[i].z); ex_num(j, "yaw", pl[i].yaw); ex_num(j, "open", pl[i].open); jo_end(j); }
    jo_end(j);
    jo_key(j, "groups"); jo_arr(j);
    for gi: 0..<w.groups { if groups[gi].tag == k + 1 { jo_str(j, glb_name(groups[gi], name[..])); } }
    jo_end(j);
    jo_end(j);
  }
  jo_end(j);
  // what aethyr_events reports, by number
  jo_key(j, "events"); jo_obj(j);
  ex_int(j, "bad-cut", MSG_BAD_CUT); ex_int(j, "rubble-open", MSG_OPEN); ex_int(j, "wall-broke", MSG_BROKE); ex_int(j, "boss-down", MSG_DOWN); ex_int(j, "hurt", MSG_HIT);
  ex_int(j, "stun", MSG_STUN); ex_int(j, "picked-up", MSG_PICK); ex_int(j, "core", MSG_CORE); ex_int(j, "ping", MSG_PING); ex_int(j, "foe-down", MSG_FOE);
  ex_int(j, "cell", MSG_CELL); ex_int(j, "smack", MSG_SMACK); ex_int(j, "splice-core", EV_SPLICE_CORE); ex_int(j, "restored", EV_RESTORED);
  // each sound by its name in the sound table (sound.coax): an overrides row event.NAME plays it; a loop's event is its start
  for k: 0..<SND_COUNT { ex_int(j, SND_ROWS[k].name, SND_EVENT_BASE + k); }
  jo_end(j);

  // the codes g_key takes: a letter is its character code, the rest are these
  jo_key(j, "keys"); jo_obj(j);
  ex_int(j, "enter", -2); ex_int(j, "left", -4); ex_int(j, "right", -5); ex_int(j, "up", -6); ex_int(j, "down", -7); ex_int(j, "space", 32);
  ex_str(j, "letters", "the character code: w a s d e f g c x and 1 2 3");
  jo_end(j);

  jo_key(j, "fonts"); jo_arr(j); jo_str(j, "fonts/IBMPlexMono-Medium.ttf"); jo_str(j, "fonts/Michroma-Regular.ttf"); jo_end(j);

  jo_key(j, "shots"); jo_obj(j);
  ex_int(j, "width", EX_SHOT_W); ex_int(j, "height", EX_SHOT_H);
  ex_str(j, "about", "the static world from each camera, flat vertex colour, both faces drawn, no shading or sky; fov is the vertical angle in radians");
  jo_key(j, "list"); jo_arr(j);
  for i: 0..<SX_SHOTS {
    c := sx_shot(g[..], i); file := sx_file_name("shots/shot-", i, ".png", name[..]);
    covered := ex_shot(world[..], vertices, c, dir, file);
    if covered < 0 { print("splice-export: could not write %\n", file); return 1; }
    jo_obj(j); ex_str(j, "name", sx_shot_name(i)); ex_str(j, "file", file); ex_point(j, "eye", c.eye); ex_point(j, "at", c.at); ex_num(j, "fov", c.fov); ex_int(j, "covered_pixels", covered); jo_end(j);
  }
  jo_end(j); jo_end(j);
  jo_end(j);
  if o[0].bad { print("splice-export: the manifest did not fit\n"); return 1; }
  if !ex_put(dir, "manifest.json", json[0..<o[0].n]) { print("splice-export: could not write manifest.json\n"); return 1; }

  font: [524288] u8; fonts := [2] string.["IBMPlexMono-Medium.ttf", "Michroma-Regular.ttf"];
  for f: fonts {
    n := fs_read(fs_join("apps/openagents-web/realms/splice-bots/assets/fonts", f, path[..]), font[..]);
    out_path: [4096] u8;
    if n < 1 || !fs_write(fs_join(fs_join(dir, "fonts", path[..]), f, out_path[..]), cast(string) font[0..<n]) { print("splice-export: could not copy the font % (run from the repository root)\n", f); return 1; }
  }
  // ---- the rules: the game as C behind the native host interface, the scripted run, and the
  // lines that run prints when the C is built and run here (what any host must print too)
  work: [8388608] u8;   // the rules' C: 4.2 MB on 2026-11-13
  if !fs_mkdir(fs_join(dir, "rules", path[..])) { print("splice-export: could not make rules/\n"); return 1; }
  if !sx_emit("metaverse/splice-bots/splice-bots.coax", dir, "splice.c", "splice.h", work[..]) || !sx_emit("apps/openagents-web/animelab-style.coax", dir, "animelab-style.c", "Animelab-style.h", work[..]) {
    print("splice-export: the Coax compiler did not emit the rules' C (run from the repository root)\n"); return 1;
  }
  if !sx_copy("metaverse/splice-bots/splice-ue-face.c", dir, "splice-ue-face.c", work[..]) || !sx_copy("metaverse-engine/export/unreal/aethyr_host.h", dir, "aethyr_host.h", work[..]) ||
     !sx_copy("metaverse-engine/export/unreal/aethyr_script.c", dir, "aethyr_script.c", work[..]) || !sx_copy("metaverse/splice-bots/splice-run.aescript", dir, "run.aescript", work[..]) {
    print("splice-export: could not copy the host interface into rules/\n"); return 1;
  }
  // the world as the jam build plays it, with no server (WORLD_DIR, a dev server's build/.worlds): the live
  // lane's document as the API answers it, and its content tables. The face answers the page's requests from them.
  if world_dir != "" {
    doc: [131072] u8; state: [262144] u8; text: [524288] u8;
    p0: [4096] u8; p2: [4096] u8;
    dn := fs_read(fs_join(world_dir, "splice-bots.live", p0[..]), doc[..]);
    if dn < 1 { print("splice-export: % has no splice-bots.live\n", world_dir); return 1; }
    pins := spw_pins(g[..]);
    v := WorldState.{lane = WL_LIVE, rev = 1, dev = 1, live = 1, when = 0};
    v.build[0] = pins.engine; v.build[1] = pins.rules; v.build[2] = pins.content; v.build[3] = pins.wire;
    st := we_state_write(v, SPW_ID, cast(string) doc[0..<dn], "", state[..]);
    if st.count == 0 { print("splice-export: the world's document did not make a state\n"); return 1; }
    n := 0;
    head := "/* Generated by splice-export: the world `splice-bots` as its live lane answers, for a host with no server. */\n";
    for c: head { text[n] = c; n += 1; }
    n = sx_c_string(text[..], n, "AETHYR_WORLD_STATE", st);
    n = sx_c_string(text[..], n, "AETHYR_WORLD_TABLES", cast(string) tables[0..<wtn]);
    if n < 0 || !fs_write(fs_join(fs_join(dir, "rules", p0[..]), "aethyr_world.h", p2[..]), cast(string) text[0..<n]) { print("splice-export: could not write the world header\n"); return 1; }
  }
  {
    // the script as a C string, for a host with no files (the web build)
    sn := fs_read("metaverse/splice-bots/splice-run.aescript", work[..]);
    text: [262144] u8; tn := 0;
    head := "/* Generated by splice-export: run.aescript as a C string. */\nstatic const char AETHYR_RUN_SCRIPT[] =\n  \"";
    for c: head { text[tn] = c; tn += 1; }
    for i: 0..<sn {
      c := work[i];
      if c == '\n' { tail := "\\n\"\n  \""; for t: tail { text[tn] = t; tn += 1; } continue; }
      if c == '"' || c == '\\' { text[tn] = '\\'; tn += 1; }
      if c != '\r' { text[tn] = c; tn += 1; }
    }
    tail := "\";\n"; for t: tail { text[tn] = t; tn += 1; }
    p0: [4096] u8; p1: [4096] u8;
    if sn < 1 || !fs_write(fs_join(fs_join(dir, "rules", p0[..]), "aethyr_run_script.h", p1[..]), cast(string) text[0..<tn]) { print("splice-export: could not write the script header\n"); return 1; }
  }
  {
    r0: [4096] u8; r1: [4096] u8; r2: [4096] u8; r3: [4096] u8; r4: [4096] u8; r5: [4096] u8; r6: [4096] u8; i0: [4200] u8; err: [65536] u8;
    rules := fs_join(dir, "rules", r0[..]);
    exe := fs_join(rules, "aethyr-script.tmp", r1[..]);
    inc: [4200] u8; n := 0; for c: "-I" { inc[n] = c; n += 1; } for c: rules { inc[n] = c; n += 1; }
    cb: [4096] u8; clang := fs_clang(proc_getenv("CLANG", cb[..]));
    if clang == "" { print("splice-export: no clang (set CLANG to one, or install /usr/bin/clang)\n"); return 1; }
    cc := [16] string.[clang, "-std=c11", "-O1", "-ffp-contract=off", "-fno-fast-math", "-w", "-DAETHYR_SCRIPT_MAIN", cast(string) inc[0..<n],
                       fs_join(rules, "splice.c", r2[..]), fs_join(rules, "animelab-style.c", r3[..]), fs_join(rules, "splice-ue-face.c", r4[..]), fs_join(rules, "aethyr_script.c", r5[..]), "-o", exe, "-lm", "-Wno-everything"];
    built := proc_run(cc[..], 600000, work[..], err[..]);
    if built.started != 0 || built.status != 0 { print("splice-export: clang could not build the rules for the reference run\n%\n", cast(string) err[0..<built.err_n]); return 1; }
    run := [2] string.[exe, fs_join(rules, "run.aescript", r6[..])];
    ran := proc_run(run[..], 600000, work[..], err[..]);
    removed := fs_remove(exe);
    if ran.started != 0 || ran.status != 0 || ran.out_n < 1 { print("splice-export: the scripted run failed here:\n%\n", cast(string) work[0..<ran.out_n]); return 1; }
    if !fs_write(fs_join(rules, "run.expected", i0[..]), cast(string) work[0..<ran.out_n]) { print("splice-export: could not write run.expected\n"); return 1; }
  }
  print("splice-export: % groups, % triangles, % vertices welded from %, world.glb % bytes\n", w.groups, w.triangles, w.welded, w.vertices, w.bytes);
  return 0;
}
