  #assert g_key(h[..], 'e', true) && sp_in_room(h[..]);
}
#test "Sniper's room: O changes her outfit from the wardrobe and keeps it; at the desk Sniper puts the deep-garage map up once, and M toggles it (#13505)" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); #assert spw_shipped(g[..]) == SPW_SHIPPED_N;
  g_begin(g[..]); fr_start(g[..]);
  // outside the room O does nothing
  #assert !g_key(g[..], 'o', true);
  tr := g_shipped_at(g[..], 123); g[0].px = tr.x + 2.2; g[0].pz = tr.z;
  #assert g_key(g[..], 'e', true) && sp_in_room(g[..]);
  was := cw_outfit_of(g[0].fr[0].doc[0].wear); gen := g[0].fr[0].doc_gen;
  #assert g_key(g[..], 'o', true) && g[0].msg == MSG_OUTFIT && g[0].fr[0].doc_gen == gen + 1;
  #assert cw_outfit_of(g[0].fr[0].doc[0].wear) == (was + 1) % CW_OUTFITS && g[0].fr[0].crew_put == 1 && g[0].fr[0].crew_n > 0;
  // the desk: Sniper shows the map the first time, with its line; M closes it, and it is not forced open again
  dk := g_shipped_at(g[..], 125); g[0].px = dk.x - 1.2; g[0].pz = dk.z;
  #assert !g[0].dr[0].map;
  g_step(g[..], 0.02);
  #assert g[0].dr[0].map && g[0].msg == MSG_MAP && g[0].dv[0].shown;
  #assert g_key(g[..], 'm', true) && !g[0].dr[0].map;
  g_step(g[..], 0.02); #assert !g[0].dr[0].map;
  #assert g_key(g[..], 'm', true) && g[0].dr[0].map;
  // the map draws the garage's ring: its letters are written
  out: [60000] f32; u: [UNIFORM_FLOATS] f32;
  n := d_map(g[..], out[..], u[..], Ui.{w = 1440, h = 900, k = 1}, 0);
  #assert n > 24 * 2 * 6;
  // the scripted run's way (splice-run.aescript): a few frames at the desk, E closes the map, and E again takes the wheel
  g[0].dv[0].shown = false; g[0].dr[0].map = false; g[0].have[H_DRILL] = true;
  g[0].px = dk.x - 1.2; g[0].pz = dk.z;
  for i: 0..<2 { g_step(g[..], 0.05); }
  #assert g[0].dr[0].map && g_key(g[..], 'e', true) && !g[0].dr[0].map;
  for i: 0..<2 { g_step(g[..], 0.05); }
  #assert g_key(g[..], 'e', true) && g[0].mode == M_DRIVE;
}
#test "Sniper's cabin is a closed level: she walks into its walls on every side and stays in, the camera stays under its ceiling, and only E at its door takes her out beside Sniper (playtest 2)" #steps 400000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); #assert spw_shipped(g[..]) == SPW_SHIPPED_N;
  g_begin(g[..]); fr_start(g[..]);
  tr := g_shipped_at(g[..], 123); g[0].px = tr.x + 2.2; g[0].pz = tr.z;
  #assert g_key(g[..], 'e', true) && sp_in_room(g[..]);
  r := dv_room(g[..]);
  #assert r.ok && r.door && r.x1 - r.x0 >= 11 && r.z1 - r.z0 >= 8.5;   // roomier than before: 12 m by 9 m
  // the layout (front +x on the right, the top the low-z wall): the door in the back wall, the bunk
  // top-left, the desk top-right, the workbench arm right by the front, the window strips on the top wall
  cx := (r.x0 + r.x1) * 0.5; cz := (r.z0 + r.z1) * 0.5;
  bk := g_shipped_at(g[..], 124); dk := g_shipped_at(g[..], 125); am := g_shipped_at(g[..], 126);
  #assert r.door_x < r.x0 + 1 && abs(r.door_z - cz) < 0.5;
  #assert bk.x < cx - 3 && bk.z < cz && dk.x > cx + 2 && dk.z < cz && am.x > cx + 3 && am.z >= cz - 0.5;
  strips := 0;
  for i: 0..<g[0].layer[0].st[0].n { e := g[0].layer[0].items[i]; if e.mesh == DV_WINDOW_KIND && dv_room_has(r, e.x, e.z) { #assert e.z < r.z0 + 0.5; strips += 1; } }
  #assert strips == 2;
  // eight ways from the middle, a long walk each: she never leaves the cabin
  for k: 0..<8 {
    g[0].px = (r.x0 + r.x1) * 0.5; g[0].pz = (r.z0 + r.z1) * 0.5 + 1; g[0].yaw = cast(f32) k * TAU / 8; g[0].pitch = 0;
    _ = g_key(g[..], 'w', true);
    for i: 0..<300 { g_step(g[..], 0.02); }
    _ = g_key(g[..], 'w', false);
    #assert sp_in_room(g[..]) && g[0].px > r.x0 && g[0].px < r.x1 && g[0].pz > r.z0 && g[0].pz < r.z1;
    c := g_camera(g[..]);
    #assert c.eye.x > r.x0 && c.eye.x < r.x1 && c.eye.z > r.z0 && c.eye.z < r.z1 && c.eye.y < DV_ROOM_H && c.eye.y > 0;
  }
  // the still at the cabin's door looks in from inside it
  g_stage(g[..], 28); r = dv_room(g[..]);
  #assert sp_in_room(g[..]) && g[0].mode == M_PLAY;
  c0 := g_camera(g[..]);
  #assert c0.eye.x > r.x0 && c0.eye.x < r.x1 && c0.eye.z > r.z0 && c0.eye.z < r.z1 && c0.eye.y < DV_ROOM_H;
  // E at the door: outside by the rover train
  g[0].px = r.door_x + 0.3; g[0].pz = r.door_z; g[0].dr[0].map = false;
  #assert g_key(g[..], 'e', true) && !sp_in_room(g[..]) && dist2(g[0].px, g[0].pz, tr.x, tr.z) < 10;
}
sp_map_up :: (g: [] SpGame) -> bool { g[0].dr[0].map = true; g[0].look_free = false; return g[0].dr[0].map; }
#test "the deep-garage map closes with M, Esc, E, a click, or Esc freeing the pointer, and says so on it (playtest 2)" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); #assert spw_shipped(g[..]) == SPW_SHIPPED_N;
  g_begin(g[..]); fr_start(g[..]);
  #assert sp_map_up(g[..]) && g_key(g[..], 'm', true) && !g[0].dr[0].map && !g[0].dr[0].paused;
  #assert sp_map_up(g[..]) && g_key(g[..], -1, true) && !g[0].dr[0].map && !g[0].dr[0].paused;
  #assert sp_map_up(g[..]) && g_key(g[..], 'e', true) && !g[0].dr[0].map && g[0].mode == M_PLAY;
  #assert sp_map_up(g[..]) && g_pointer(g[..], 300, 300, 0) && !g[0].dr[0].map;
  #assert sp_map_up(g[..]); g_lock(g[..], 0); #assert !g[0].dr[0].map && !g[0].dr[0].paused;
  // in the drive's mode too: the map is never stuck open
  #assert sp_map_up(g[..]); g[0].mode = M_RIDE; #assert g_key(g[..], 'm', true) && !g[0].dr[0].map; g[0].mode = M_PLAY;
  // the hint is on it, in the garage and before it
  out: [60000] f32; u: [UNIFORM_FLOATS] f32;
  g[0].dr[0].map = true;
  a := d_map(g[..], out[..], u[..], Ui.{w = 1440, h = 900, k = 1}, 0);
  b := d_map_hint(out[..], 0, 700, 400, 1);
  #assert b > 0 && a >= b;
}
#test "the drive: the rover she boarded is hidden while she drives it, and once it has left the farm it is parked where she stopped; she steps out facing the way in (#13505)" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]); #assert spw_shipped(g[..]) == SPW_SHIPPED_N;
  g_begin(g[..]); g[0].have[H_DRILL] = true;
  tr := g_shipped_at(g[..], 123); g[0].px = tr.x + 2.2; g[0].pz = tr.z;
  #assert g_key(g[..], 'e', true) && dv_hidden(g[..]) == -1;
  dk := g_shipped_at(g[..], 125); g[0].px = dk.x - 1.2; g[0].pz = dk.z;
  #assert g_key(g[..], 'e', true) && g[0].mode == M_DRIVE;
  #assert dv_hidden(g[..]) >= 0 && g[0].layer[0].items[editor_scene_find(sl_scene(g[..]), dv_hidden(g[..]))].mesh == 123;
  // the parked Sniper is not written live while it drives, and is once you are out
  buf: [400000] u32; pen := [1] Pen.[Pen.{}];
  g_live(g[..], buf[..], pen[..]); driving := pen[0].n;
  one := [1] Pen.[Pen.{}]; g_draw_rover(g[..], buf[..], one[..], v3(0, 0.2, 0), 0);
  rm := [1] Pen.[Pen.{}]; sb_draw_rm(g[..], buf[..], rm[..]); #assert rm[0].n > 0;
  #assert driving == one[0].n + rm[0].n;   // only the rover on the road and the raider mech on watch beside it: no second, parked one
  #assert dv_keys_to(g[..], g[0].dv[0].bx, g[0].dv[0].bz, 6, 120);
  #assert g_key(g[..], 'e', true) && g[0].mode == M_PLAY && dv_hidden(g[..]) == dv_train(g[..]) && dv_train(g[..]) >= 0 && dv_facing_in(g[..]) && g[0].phase == PH_DUSK;
  w := dv_way_in(g[..]); #assert dist2(w.x, w.z, 0, g[0].at.gar_z + ga_back(g[..]) + GA_BACK * 2) < 0.01;
  pen[0] = Pen.{}; g_live(g[..], buf[..], pen[..]);
  #assert pen[0].n > one[0].n;   // out of it, Sniper stands parked by the garage
  // the place store sinks the boarded piece only while it drives
  d := [1] SpLayerDraw.[SpLayerDraw.{}]; places: [SD_PLACE_WORDS] u32;
  g[0].mode = M_DRIVE; g[0].dv[0].boarded = true; sd_places(d[..], g[..], places[..]);
  low := 0; for r: 0..<d[0].place_n { if f32_from_bits(places[r * SD_ROW + 1]) < -100 { low += 1; } }
  #assert low == 1;
  g[0].mode = M_PLAY; g[0].dv[0].boarded = false; sd_places(d[..], g[..], places[..]);
  low = 0; for r: 0..<d[0].place_n { if f32_from_bits(places[r * SD_ROW + 1]) < -100 { low += 1; } }
  #assert low == 1;   // and parked: the farm's rover is gone from there
  // E at Sniper where it is parked opens its cabin, and the cabin's door lets her out beside it again
  g[0].px = g[0].at.rover_x + 3; g[0].pz = g[0].at.rover_z;
  #assert g_key(g[..], 'e', true) && sp_in_room(g[..]);
  r := dv_room(g[..]); g[0].px = r.door_x; g[0].pz = r.door_z;
  #assert g_key(g[..], 'e', true) && !sp_in_room(g[..]) && near_rover(g[..], T_USE_RANGE);
}
#test "the old-world lab and its hallway are lit white at night, never the night's neon (#13505)" {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10);   // past the boss wall
  g[0].phase = PH_NIGHT;
  back := g[0].at.gar_z - ga_back(g[..]); end := back - GA_HALL_LONG;
  g[0].px = 0; g[0].pz = end - 10;
  #assert ga_in_lab(g[..], g[0].px, g[0].pz) && g_variant(g[..]) == 0 && g_clock(g[..]) == 0.5;
  g[0].pz = back - 10;   // the hallway
  #assert g_indoors(g[..]) && g_variant(g[..]) == 0;
  // the lab's lights are white; out on the field it is night again
  l: [LIGHTS * LIGHT_FLOATS] f32; g[0].pz = end - 10; ga_lights(g[..], l[..]);
  o := 2 * LIGHT_FLOATS; #assert l[o + 4] == 1 && l[o + 5] == 1 && l[o + 6] == 1 && l[o + 7] > 0;
  g[0].px = 0; g[0].pz = g[0].at.gar_z;
  #assert !g_indoors(g[..]) && g_variant(g[..]) == 3;
}
#test "dragging a card onto a timeline slot places it there" {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 6);
  g[0].btn_n = 1; g[0].btn[0] = 0; g[0].btn[1] = 0; g[0].btn[2] = 10; g[0].btn[3] = 10; g[0].btn_key[0] = 1000 + H_DRILL;
  o := 4 * 4; g[0].drop[o] = 100; g[0].drop[o + 1] = 100; g[0].drop[o + 2] = 200; g[0].drop[o + 3] = 200;   // the cards row's slot 02
  #assert g_pointer(g[..], 5, 5, 0) && g[0].drag == H_DRILL;
  #assert g_pointer(g[..], 150, 150, 1);
  #assert g_pointer(g[..], 150, 150, 2) && g[0].drag == -1 && g[0].strip_n == 2 && g[0].strip[1] == H_DRILL;
}

// ---- SPLICE UI v2 (hud.coax, #13505): the HUD and the edit bay, drawn at 1440 x 900
HvCheck :: struct { out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32; }
hv_draw :: (g: [] SpGame, b: [] HvCheck) -> int { return g_overlay(g, b[0].out[..], b[0].u[..], 1440, 900); }
hv_tick :: (g: [] SpGame, b: [] HvCheck, frames: int) { for i: 0..<frames { g[0].t += 0.1; _ := hv_draw(g, b); } }
hv_btn :: (g: [] SpGame, key: int) -> int { for i: 0..<g[0].btn_n { if g[0].btn_key[i] == key { return i; } } return -1; }
hv_press :: (g: [] SpGame, i: int) -> bool { o := i * 4; return g_pointer(g, (g[0].btn[o] + g[0].btn[o + 2]) * 0.5, (g[0].btn[o + 1] + g[0].btn[o + 3]) * 0.5, 0); }
hv_drop_on :: (g: [] SpGame, d: int) -> bool {
  o := d * 4; x := (g[0].drop[o] + g[0].drop[o + 2]) * 0.5; y := (g[0].drop[o + 1] + g[0].drop[o + 3]) * 0.5;
  return g_pointer(g, x, y, 1) && g_pointer(g, x, y, 2);
}
#test "SPLICE UI v2 HUD: H hides it, a pickup is a toast that fades, the gauges stay out while full or cool and come back when they change (#13505)" #steps 2000000000 #traversal 1000000000 {
  g := [1] SpGame.[SpGame.{}]; b: [1] HvCheck;
  g_stage(g[..], 8);   // the rave at night: three hearts, Digger charged, Heat 20
  hv_tick(g[..], b[..], 5);
  #assert g[0].hv[0].hearts.alpha == 0 && g[0].hv[0].battery.alpha == 0 && g[0].hv[0].heat.alpha == 0;
  shown := hv_draw(g[..], b[..]);
  #assert g_key(g[..], 'h', true) && g[0].hv[0].hidden && hv_draw(g[..], b[..]) < shown;
  #assert g_key(g[..], 'H', true) && !g[0].hv[0].hidden && hv_draw(g[..], b[..]) == shown;
  // a hit brings the hearts in, and they go once the hold is over
  g[0].hearts = 2; hv_tick(g[..], b[..], 8);
  #assert g[0].hv[0].hearts.alpha == 1;
  g[0].hearts = T_HEARTS; hv_tick(g[..], b[..], 50);
  #assert g[0].hv[0].hearts.alpha == 0;
  // warm Heat stays in
  g[0].heat = 45; hv_tick(g[..], b[..], 60);
  #assert g[0].hv[0].heat.alpha == 1 && hv_band(g[0].heat) == "WARM";
  // the blue piece: an orange toast with its Heat, not a line in the middle; it fades on its own
  g_take(g[..], PICK_PLUS);
  t := g[0].hv[0].toasts[0];
  #assert t.n == 1 && t.what[0] == MSG_PICK && hv_toast_banned(t.what[0], t.extra[0]) && hv_toast_tag(t.what[0], t.extra[0]) == "HEAT +25" && hv_toasted(g[0].msg);
  g_take(g[..], PICK_CELL + 1);
  #assert g[0].hv[0].toasts[0].n == 2 && hv_toast_name(g[0].hv[0].toasts[0].what[0], g[0].hv[0].toasts[0].extra[0]) == "BATTERY CELL";
  hv_tick(g[..], b[..], 40);
  #assert g[0].hv[0].toasts[0].n == 0;
  // the objective on the compass, its distance, and the reel line
  buf: [64] u8;
  #assert hv_far(buf[..], 2400) == "2.4 KM" && hv_far(buf[..], 240) == "240 M" && hv_reel(g[..], buf[..]) == "REEL 03 · NIGHT";
  g_stage(g[..], 7);
  #assert hv_goal(g[..]).name == "DRILL MECH" && hv_goal(g[..]).ok;
  g[0].have[H_PLUS] = true;
  #assert hv_goal(g[..]).name == "DRILL MECH";   // the DRILL+ is no step: the goal stays the drill mech (#13505 playtest 2)
  // the hoverboard's panel and its keys
  #assert HV_BOARD_HINT == "Q board · hold Ctrl or double-tap W: very fast";
  // BAD CUT: Esc quits to the title; its buttons are RESPAWN AT ROVER and QUIT TO TITLE
  g_stage(g[..], 14); _ = hv_draw(g[..], b[..]);
  #assert hv_btn(g[..], -2) >= 0 && hv_btn(g[..], -1) >= 0 && hv_kept(g[..], buf[..]) == "Digger · drill arm · treads · battery · 2 cards";
  #assert g_key(g[..], -1, true) && g[0].mode == M_TITLE;
  // the wheel and the pause screen draw in the same frame
  g_stage(g[..], 8); g[0].dr[0].wheel = wheel_open(DW_N); #assert hv_draw(g[..], b[..]) > 0;
  g[0].dr[0].wheel = Wheel.{}; d_pause(g[..]); #assert hv_draw(g[..], b[..]) > 0;
  // the prompt: the verb in capitals, what it is for after it
  #assert hv_upper(buf[..], "Tow") == "TOW";
}
#test "SPLICE UI v2 edit bay: press an item to see its card, drag it onto a hardware slot or the behavior strip; PLAY TEST runs Digger, SPLICE + RESTORE needs the core (#13505)" #steps 2000000000 #traversal 1000000000 {
  g := [1] SpGame.[SpGame.{}]; b: [1] HvCheck;
  g_stage(g[..], 6);   // in the bay: the arm spliced, MOVE on the strip; treads, battery and DRILL carried
  _ := hv_draw(g[..], b[..]);
  #assert d_carry(g[..]).n == 3 && hv_btn(g[..], 1000 + H_TREADS) >= 0 && hv_btn(g[..], -2) >= 0 && hv_btn(g[..], 'x') < 0;
  // the treads onto BODY
  #assert hv_press(g[..], hv_btn(g[..], 1000 + H_TREADS)) && g[0].drag == H_TREADS;
  _ = hv_draw(g[..], b[..]);
  #assert g[0].hv[0].pick == H_TREADS;
  #assert hv_drop_on(g[..], H_TREADS) && g[0].slot[H_TREADS] && g[0].drag == -1;
  // DRILL into the strip's second slot
  _ = hv_draw(g[..], b[..]);
  #assert hv_press(g[..], hv_btn(g[..], 1000 + H_DRILL)) && hv_drop_on(g[..], 4);
  #assert g[0].strip_n == 2 && g[0].strip[1] == H_DRILL;
  // the battery onto BATTERY builds him; PLAY TEST sends him off
  _ = hv_draw(g[..], b[..]);
  #assert hv_press(g[..], hv_btn(g[..], 1000 + H_BATTERY)) && hv_drop_on(g[..], H_BATTERY) && g[0].bot;
  _ = hv_draw(g[..], b[..]);
  #assert hv_press(g[..], hv_btn(g[..], -2)) && g[0].mode == M_PLAY && g[0].bot_state == BOT_GO;
  // with the core: SPLICE + RESTORE
  g_stage(g[..], 9); g[0].have[H_CORE] = true; g[0].core_taken = true;
  _ = hv_draw(g[..], b[..]);
  #assert hv_btn(g[..], 'x') >= 0 && hv_press(g[..], hv_btn(g[..], 'x')) && g[0].mode == M_MEMORY;
}

// ---- Battles, the drill mech, the boss and the ending (splice-battle.coax, #13505 part C)
#test "the drill mech: it waits in the empty section C1, E swaps Digger's core in, its lights turn his, it follows you, and led to the blocked hallway it drills it on its own (#13505 playtest 2)" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);   // dusk past the rubble, Digger built with MOVE and DRILL
  t := g[0].bt[..];
  #assert !t[0].mech_core && !sb_holds_digger(g[..]);
  // in the empty section, far from the entry: the compass points at it
  #assert ga_in_bay(g[..], t[0].mech_x, t[0].mech_z) == GA_EMPTY && dist2(t[0].mech_x, t[0].mech_z, 0, g[0].at.rubble_z) > 100;
  #assert hv_goal(g[..]).name == "DRILL MECH" && sb_objective(g[..]) == "Find the drill mech in section C1. Swap Digger's core into it.";
  g[0].px = 1; g[0].pz = g[0].at.wall_z + 3;                              // the hallway without the mech: nothing
  #assert g_key(g[..], 'e', true) && g[0].msg == SBM_NEED_MECH && t[0].drill_t == 0;
  g[0].px = t[0].mech_x + 2; g[0].pz = t[0].mech_z;
  #assert sb_prompt(g[..]).text == "Swap Digger's core into the drill mech";
  #assert g_key(g[..], 'e', true) && t[0].mech_core && sb_holds_digger(g[..]) && g[0].msg == SBM_CORE_IN;
  #assert hv_goal(g[..]).name == "BLOCKED HALLWAY" && hv_goal(g[..]).z == g[0].at.wall_z + 1;
  // an E beside it on the way leaves the core in: it can't be left empty before the hallway
  #assert g_key(g[..], 'e', true) && t[0].mech_core && g[0].msg == SBM_LEAD && sb_prompt(g[..]).text == "";
  // it follows; led to the hallway it starts drilling with no key, and the hallway gives
  g[0].px = 1; g[0].pz = g[0].at.wall_z + 3;
  for i: 0..<900 { g_step(g[..], 0.1); if t[0].drill_t > 0 { break; } }
  #assert t[0].drill_t > 0 && g[0].msg == SBM_DRILLING;
  for i: 0..<400 { g_step(g[..], 0.02); }
  #assert g[0].wall_gone && t[0].drill_t == 0;
  // once the hallway is open, E beside it swaps the core back: Digger follows, the mech stays
  g[0].px = t[0].mech_x + 2; g[0].pz = t[0].mech_z;
  #assert g_key(g[..], 'e', true) && !t[0].mech_core && !sb_holds_digger(g[..]);
}
// The drive's second leg, just short of where the raider mech keeps watch, Sniper at its cruising speed.
sb_drive_check :: (g: [] SpGame) {
  g_stage(g, 3);
  g[0].pinged = true; g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true;
  g[0].rail_s = sb_rm_watch_s() - 30; g[0].rail_v = T_RAIL_SPEED;
}
// The playtest's fixes (#13505): she faces the way she walks, a second Space in the air jumps higher,
// the raider mech's claws out of a battle never put Sniper down, and going down says so plainly.
#test "playtest: she turns to face the way she walks (never backwards), a double jump goes higher, the raider mech can't claw Sniper down out of a battle" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].px = 0; g[0].pz = 0; g[0].yaw = PI;
  #assert g_key(g[..], 's', true);
  for i: 0..<40 { g_step(g[..], 0.02); }
  d := g_face(g[..]) - (g[0].yaw + PI); #assert abs(atan2(sin(d), cos(d))) < 0.05;   // walking toward the view: she faces it
  _ = g_key(g[..], 's', false); #assert g_key(g[..], 'd', true);
  for i: 0..<40 { g_step(g[..], 0.02); }
  d = g_face(g[..]) - (g[0].yaw - PI * 0.5); #assert abs(atan2(sin(d), cos(d))) < 0.05;
  _ = g_key(g[..], 'd', false);
  // a jump, and a jump with a second Space in the air
  one := 0.0f32;
  for k: 0..<2 {
    g_stage(g[..], 5); g[0].px = 0; g[0].pz = 0; g_step(g[..], 0.02);
    _ = g_key(g[..], ' ', true); g_step(g[..], 0.02);
    top := 0.0f32;
    for i: 0..<120 {   // held through each rise (a tap hops lower: feel.coax FL_CUT)
      if i == 11 { _ = g_key(g[..], ' ', false); }
      if k == 1 && i == 12 { _ = g_key(g[..], ' ', true); }
      if i == 40 { _ = g_key(g[..], ' ', false); }
      g_step(g[..], 0.02); top = hi(top, g_feet_y(g[..]));
    }
    if k == 0 { one = top; } else { #assert top > one * 1.6; }
  }
  // the raider mech beside Sniper, out of a battle: its claws stop at a third of Sniper's health
  t := g[0].bt[..];
  g_stage(g[..], 4); g[0].mode = M_PLAY; sb_drive_check(g[..]);
  for i: 0..<3000 { g_step(g[..], 0.02); if g[0].mode != M_RIDE { break; } }
  most := t[0].bots[SB_SNIPER].vit.most;
  #assert !sb_fighting(g[..]) && !t[0].bots[SB_SNIPER].vit.down && t[0].bots[SB_SNIPER].vit.hp >= most / 3 - 0.01;
}
#test "the raider mech gives chase on the drive: top speed outruns it, beside Sniper it claws it, near the garage it turns back, and E battles it from Sniper with cards on keys 1 to 4" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  t := g[0].bt[..];
  // on foot at the rail stop it only keeps watch
  g_stage(g[..], 4); g[0].mode = M_PLAY;
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !t[0].rm_hunt;
  // on the drive it gives chase once Sniper passes its watch
  sb_drive_check(g[..]);
  #assert !t[0].rm_hunt && g[0].mode == M_RIDE;
  for i: 0..<400 { g_step(g[..], 0.02); if t[0].rm_hunt { break; } }
  #assert t[0].rm_hunt && g[0].msg == SBM_HUNT && g[0].mode == M_RIDE && sb_objective(g[..]) == "Outrun the raider mech (W), or battle it (E).";
  // top speed (W) outruns it: 20 m behind it gives up, and it does not come back this drive
  #assert g_key(g[..], 'w', true);
  for i: 0..<600 { g_step(g[..], 0.02); if !t[0].rm_hunt { break; } }
  #assert !t[0].rm_hunt && t[0].rm_gone && !t[0].rm_down && g[0].msg == SBM_RM_GONE;
  _ := g_key(g[..], 'w', false);
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !t[0].rm_hunt;
  // at cruising speed it catches up, runs beside Sniper and claws it
  sb_drive_check(g[..]);
  most := t[0].bots[SB_SNIPER].vit.most;
  for i: 0..<600 { g_step(g[..], 0.02); if t[0].bots[SB_SNIPER].vit.hp < most { break; } }
  b := sb_beside(g[..], g[0].rail_s, SB_RM_SIDE);
  #assert t[0].rm_hunt && t[0].bots[SB_SNIPER].vit.hp == most - cast(f32) sb_card(SBC_CLAW, SB_RAIDER).power && dist2(t[0].rm_x, t[0].rm_z, b.x, b.z) < 1;
  #assert sb_can_battle_rm(g[..]) && sb_prompt(g[..]).text == "Battle the raider mech from Sniper";
  // E while it is near: a battle, Sniper fielded with its three cards, and Sniper slows to its slow speed
  #assert g_key(g[..], 'e', true) && sb_fighting(g[..]) && t[0].kind == SBF_DESERT && sb_fielded(g[..]) == SB_SNIPER && g[0].mode == M_RIDE;
  t[0].think = 100;   // the raider mech holds its moves while this check reads Sniper's
  #assert sb_prompt(g[..]).text == "Battle moves" && sb_prompt(g[..]).key == "1-4";   // not W and S: the battle holds Sniper's speed
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert abs(g[0].rail_v - T_RAIL_SLOW) < 0.01 && dist2(t[0].rm_x, t[0].rm_z, sb_sniper_at(g[..]).x, sb_sniper_at(g[..]).z) < SB_RM_SIDE + 0.5;
  // keys 1 to 4 on the drive are Sniper's cards
  hp := sb_rec(g[..], SB_RAIDER).vit.hp; ch := sb_rec(g[..], SB_SNIPER).charge;
  #assert g_key(g[..], '2', true);
  #assert sb_rec(g[..], SB_RAIDER).vit.hp == hp - 3 && sb_rec(g[..], SB_SNIPER).charge == ch - 12;   // ARM: 3 damage, 12 charge
  #assert g_key(g[..], '2', true) && sb_rec(g[..], SB_RAIDER).vit.hp == hp - 3;                     // cooling: nothing
  #assert g_key(g[..], '4', true) && g[0].msg == SBM_REFUSED && t[0].refusal == cast(int) BbVerdict.no_card;   // Sniper holds three cards
  t[0].think = SB_THINK;   // and fights back from here
  for i: 0..<1500 { if t[0].rm_down { break; } _ = g_key(g[..], '1' + i % 3, true); g_step(g[..], 0.02); }
  #assert t[0].rm_down && !sb_fighting(g[..]) && g[0].scrap == 1 && g[0].msg == SBM_RM_DOWN && g[0].mode == M_RIDE;
  #assert sb_rec(g[..], SB_SNIPER).vit.hp < most - 3;   // it fought back
  // near the garage a chase still on turns back, and a battle on ends
  sb_drive_check(g[..]);
  g[0].rail_s = sb_rm_quit_s() - 3; r := sb_beside(g[..], g[0].rail_s, SB_RM_SIDE); t[0].rm_x = r.x; t[0].rm_z = r.z; t[0].rm_hunt = true;
  #assert g_key(g[..], 'e', true) && sb_fighting(g[..]);
  for i: 0..<200 { g_step(g[..], 0.02); if !t[0].rm_hunt { break; } }
  #assert !t[0].rm_hunt && !sb_fighting(g[..]) && g[0].msg == SBM_RM_GONE;
  for i: 0..<300 { g_step(g[..], 0.02); }
  #assert g[0].zone == Z_MINE && !sb_fighting(g[..]);
}
#test "the boss's collider moves with the boss: a walker is pushed out of it where it stands, and not where it started" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10);
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  #assert t[0].kind == SBF_BOSS && g[0].ws[0].boss >= 0;
  // where it starts: the collider holds a walker off it
  g[0].px = g[0].at.boss_x + 0.5; g[0].pz = g[0].at.boss_z; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, t[0].dino_x, t[0].dino_z) >= SB_BOSS_R - 0.001;
  // it moves (here, put across the chamber; a charge or a step does the same): the collider is where it stands
  t[0].dino_x = 4.5; t[0].dino_z = -69; t[0].think = 10; t[0].mech_x = 4.5; t[0].mech_z = -64.6;
  g_step(g[..], 0.02);
  w := sl_world(g[..]); s := g[0].ws[0].boss;
  #assert world_f(w, WF_X, s) == t[0].dino_x && world_f(w, WF_Z, s) == t[0].dino_z;
  g[0].px = t[0].dino_x - 0.4; g[0].pz = t[0].dino_z + 0.3; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, t[0].dino_x, t[0].dino_z) >= SB_BOSS_R - 0.001;
  // and where it started a walker stands free
  g[0].px = g[0].at.boss_x; g[0].pz = g[0].at.boss_z + 0.2; g_collide(g[..]);
  #assert g[0].px == g[0].at.boss_x && g[0].pz == g[0].at.boss_z + 0.2;
  // a charge carries the collider along with it
  t[0].half = true; t[0].wind = 0; t[0].rush = SB_CHARGE_TIME; t[0].rush_dx = -1; t[0].rush_dz = 0; t[0].rush_hit = true;
  x0 := t[0].dino_x; g_step(g[..], 0.02); g_step(g[..], 0.02);
  #assert t[0].dino_x < x0 && world_f(w, WF_X, s) == t[0].dino_x && world_f(w, WF_Z, s) == t[0].dino_z;
  // back at the checkpoint after a loss: it is home, and so is its collider
  sb_respawn(g[..]);
  #assert world_f(w, WF_X, s) == g[0].at.boss_x && world_f(w, WF_Z, s) == g[0].at.boss_z;
}
#test "the hit cooldown counts down everywhere: on foot in the mine, on foot on the desert route, and on the drive" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  for k: 0..<3 {
    if k == 0 { g_stage(g[..], 5); }
    if k == 1 { g_stage(g[..], 4); g[0].mode = M_PLAY; }
    if k == 2 { g_stage(g[..], 3); }
    hearts := g[0].hearts;
    g_hurt(g[..]);
    #assert g[0].hearts == hearts - 1 && g[0].hit_cool == T_HIT_COOL;
    g_hurt(g[..]);
    #assert g[0].hearts == hearts - 1;   // within the cooldown a second hit does nothing
    for i: 0..<cast(int) (T_HIT_COOL / 0.02) + 2 { g_step(g[..], 0.02); }
    #assert g[0].hit_cool == 0;
    g_hurt(g[..]);
    #assert g[0].hearts == hearts - 2;   // after it, a hit lands again
  }
}
#test "playtest: in the boss battle the mech lands its hits on its own, the boss jolts, and the prompt says her part: stun the weak points with F" #steps 250000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10); for i: 0..<3 { g[0].stun[i] = 0; }
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  #assert t[0].kind == SBF_BOSS && sb_prompt(g[..]).key == "1-4";
  hp := sb_rec(g[..], SB_BOSS).vit.hp; landed := false;
  for i: 0..<1000 { g_step(g[..], 0.02); if t[0].hit_side == 1 && t[0].hit_t > 0.55 { landed = true; } }   // the mech walks from the hallway to the boss holding the lab's middle
  #assert sb_rec(g[..], SB_BOSS).vit.hp < hp && landed;   // no key pressed: the mech still hits it
  // reeling: the prompt sends her to a weak point, and beside one it says F
  t[0].daze = 3; t[0].rush = 0; t[0].wind = 0;
  #assert sb_open(g[..]) && sb_prompt(g[..]).key == "F";
  w := weak_at(g[..], 0); g[0].px = w.x + 0.3; g[0].pz = w.z + 0.3;
  #assert sb_prompt(g[..]).text == "Stun the weak point";
}
