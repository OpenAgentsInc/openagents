// Splice, the vertical slice (openagents.com/worlds/splice-bots): scavenge banned robot parts, splice
// them in the rover's edit bay, and restore a scene the Emperor erased. The run follows the game
// design document (Tier 1 and Tier 2): title, dome village and scanner gate at dawn, the rail
// drive with one sensor ping, the day mine, dusk, the raiders' party at night, the boss wall, the
// banned bot, the memory, SCENE RESTORED.
//
// This file is the game: its tuning, its world, its rules and its interface (the Game UI board:
// ink on cream paper, orange for danger, blue for banned tech, Michroma and IBM Plex Mono). The
// engine draws it: the cel kits (metaverse-engine/kit/), the cel mesh writers and Anime Lab's uniform
// layout, style and shader.
#load "../../apps/openagents-web/animelab.coax";
#load "../../metaverse-engine/kit/land.coax";
#load "../../metaverse-engine/move/jump.coax";   // the engine's jump: the press, gravity and where you land
#load "content.coax";
#load "layer.coax";
#load "garage.coax";             // the raider mine garage: the ring of lettered bays, the hallway and the lab (#13505)
#load "drive.coax";              // the drive from the solar farm to the garage, and the rover's room (#13505)
#load "walk.coax";
#load "layer-fixture.coax";
#load "layer-draw.coax";
#load "world.coax";
#load "scripts.coax";              // the foes' realm scripts: the frame out, the commands in (#13467)
#load "director.coax";             // the Director's keys, Digger's pickups, the inventory, Heat's sensing and health (#13505)
#load "sound.coax";                // the sound table and the moments each sound plays (#13505)
#load "sound-checks.coax" #test;
#load "layer-checks.coax" #test;   // the colliders' and the layer's checks
#load "walk-checks.coax" #test;    // the walk replay's, the fixture layer's and the kept-clear zones' checks
#load "replay.coax";
#load "replay-checks.coax" #test;   // the outcome replay's checks, and each check's broken variant
#load "world-checks.coax" #test;   // the world document's and the saved batch's checks
#load "splice-cast.coax";
#load "front.coax";                 // the title, character creation and the kept run (#13482)
#load "front-checks.coax" #test;
#load "why.coax";                  // the answers to `why ID` (metaverse-engine/agent/why.coax, #13429)
#load "why-checks.coax" #test;
#load "imports-checks.coax" #test;   // a piece kind whose mesh is a mesh of the world's import pack (#13420)
#load "splice-battle.coax";        // bot battles, the drill mech, the boss and the ending (#13505 part C)

// ---- Tuning (the document's DA_Tuning): every number the run is balanced with
T_WALK :: 5.6f32; T_TURN :: 2.5f32; T_LOOK :: 0.0032f32; T_RADIUS :: 0.45f32;
T_HEAT_PIECE :: 25.0f32; T_HEAT_MAX :: 100.0f32; T_HEAT_COOL :: 5.0f32; T_COOL_RANGE :: 6.0f32;
T_HEARTS :: 3; T_HIT_COOL :: 1.0f32;
T_NOTICE :: 5.0f32; T_NOTICE_HEAT :: 0.07f32; T_RAIDER_SPEED :: 3.5f32; T_RAIDER_WANDER :: 1.2f32; T_GIVE_UP :: 15.0f32; T_RAIDER_REACH :: 0.95f32;
T_USE_RANGE :: 4.5f32;        // the rover prompt's range
T_PICK_RANGE :: 2.2f32; T_SAVE_RANGE :: 5.0f32;
T_CARD_TIME :: 2.4f32;        // the Digger's card interval
T_MOVE_SHORT :: 1.9f32; T_MOVE_MAX :: 5.0f32; T_DRILL_REACH :: 2.6f32; T_BAD_CUT :: 2.0f32;
T_SWEEP_EVERY :: 4.6f32; T_SWEEP_TIME :: 1.3f32; T_SWEEP_WARN :: 0.9f32; T_ARM :: 6.2f32;
T_STUN_RANGE :: 2.0f32; T_STUN_TIME :: 12.0f32;
T_CALL :: 12.0f32;            // a foe whose plan says call brings the others within this many metres
T_HIT_RANGE :: 2.2f32; T_STAGGER :: 0.6f32; T_KNOCK :: 1.3f32; T_RAIDER_HP :: 2; T_IMPERIAL_HP :: 3; T_IMPERIAL_SPEED :: 3.0f32; T_PATROL :: 1.8f32;
T_HEAT_SCRAP :: 10.0f32;      // a robot piece taken in a fight
T_FOLLOW :: 7.5f32; T_BOT_GO :: 6.5f32;   // the Digger: keeping up with you, and driving to its work
T_BANNER :: 2.0f32; T_MEMORY :: 15.0f32; T_FADE :: 1.2f32; T_PASS :: 2.2f32;
T_RAIL :: 300.0f32; T_RAIL_PING :: 150.0f32; T_RAIL_SPEED :: 11.0f32; T_RAIL_SLOW :: 5.0f32; T_RAIL_FAST :: 20.0f32;

// ---- Places: read from the landmarks table (content.coax, metaverse/splice-bots/content/splice.content),
// by content ID. The game keeps them as it used them: metres.
LM_ROVER :: 1; LM_POST :: 2; LM_CRATE :: 3; LM_START :: 4; LM_RUBBLE :: 5; LM_WALL :: 6; LM_BOSS :: 7; LM_DECK_S :: 8; LM_DECK_N :: 9;
LM_DANCE :: 16; LM_BAY :: 10; LM_MEM :: 11; LM_VIL :: 12; LM_SCAN :: 13; LM_RAIL :: 14; LM_VIL_START :: 15; LM_RAIL_STOP :: 18;
LM_PICK :: 21;                    // the pickups, in their order: LM_PICK + i
LM_FOE :: 41; LM_FOE_TURN :: 51;  // where foe i stands (LM_FOE + i), and where an Imperial robot's patrol turns (LM_FOE_TURN + i)
DECK_Y :: 0.9f32; RAMP :: 3.0f32;
SpPlaces :: struct {
  rover_x: f32; rover_z: f32; post_x: f32; post_z: f32; crate_x: f32; crate_z: f32; start_x: f32; start_z: f32;
  rubble_z: f32; wall_z: f32; boss_x: f32; boss_z: f32;
  deck_x: f32; deck_z0: f32; deck_z1: f32;
  bay_x: f32; bay_z: f32; mem_x: f32; mem_z: f32;         // two stages behind the mesas
  vil_x: f32; vil_z: f32; vil_r: f32; scan_z: f32;        // the dome village and its scanner gate
  rail_x: f32; rail_z: f32;                               // the rail line runs north from the gate
  pick_x: [PICKS] f32; pick_z: [PICKS] f32;
  foe_ax: [FOES] f32; foe_az: [FOES] f32; foe_bx: [FOES] f32; foe_bz: [FOES] f32;
  dance_x: f32; dance_z: f32;                             // the dance floor, where the rave's stage stands beside
  gar_x: f32; gar_z: f32; gar_r: f32;                     // the garage's field: its middle and radius (garage.coax)
}

M_TITLE :: 0; M_PLAY :: 1; M_BAY :: 2; M_BANNER :: 3; M_MEMORY :: 4; M_RESTORED :: 5; M_RIDE :: 6;
Z_VILLAGE :: 0; Z_RAIL :: 1; Z_MINE :: 2;
PH_DAWN :: 0; PH_DAY :: 1; PH_DUSK :: 2; PH_NIGHT :: 3;
// what you carry: hardware, cards, and the core
H_ARM :: 0; H_TREADS :: 1; H_BATTERY :: 2; H_MOVE :: 3; H_DRILL :: 4; H_PLUS :: 5; H_CORE :: 6; HAVES :: 7;
// the pickups on the ground: five parts and cards (the Battery lies by the rail line), the one blue
// piece (the special part, DRILL+) hidden in the party's vault, and four battery cells
PICKS :: 10; PICK_PLUS :: 5; PICK_CELL :: 6;
// the party's people: five raiders dancing, four Imperial robots on patrol
FOES :: 9; F_RAIDERS :: 5;
WALLS :: 44; BUTTONS :: 12;
BOT_FOLLOW :: 0; BOT_GO :: 1; BOT_RUN :: 2; BOT_FAIL :: 3;
MSG_NONE :: 0; MSG_BAD_CUT :: 1; MSG_AIR :: 2; MSG_WEAK :: 3; MSG_OPEN :: 4; MSG_NEED :: 5; MSG_BROKE :: 7; MSG_DOWN :: 8; MSG_HIT :: 9; MSG_STUN :: 10; MSG_PICK :: 11; MSG_BANNED :: 12; MSG_CORE :: 13; MSG_PING :: 14; MSG_WAKE :: 15; MSG_FIRST :: 16; MSG_FOE :: 17; MSG_CELL :: 18; MSG_SMACK :: 19;
B_SWEEP :: 1; B_CUT :: 2;

// What a checkpoint keeps: the inventory you had at the post by the rover.
SpSave :: struct { have: [HAVES] bool; taken: [PICKS] bool; slot: [3] bool; strip: [3] int; strip_n: int; scrap: int; cells: int; }

SpGame :: struct {
  ws: [1] SlWorld;            // the colliders: a World of entities (layer.coax)
  layer: [1] SlLayer;         // the edit layer: placed pieces, as typed edits (layer.coax)
  c: [1] SpContent;           // the content tables (content.coax): outlive a reset
  imp: [1] SpImports;         // the world's import pack's meshes (pieces.coax): outlive a reset
  at: SpPlaces;               // the landmarks the game reads, from them
  gray: bool;                 // graybox (G): the world in grays, orange, yellow and cyan kept; outlives a reset
  mode: int; zone: int; phase: int; t: f32;
  px: f32; pz: f32; yaw: f32; pitch: f32; stride: f32;
  face_off: f32;               // her body's turn from the view's yaw: she turns to face the way she walks (g_face)
  fwd: bool; back: bool; left: bool; right: bool; turn_l: bool; turn_r: bool;
  look_free: bool;             // the cursor is free (Escape, or the browser refused to hold it)
  jump: bool;                  // Space is held: on foot you jump, on the hoverboard it hops
  air: [1] Jump;               // your height: the engine's jump lifts you, brings you down and lands you on the ground or a piece (g_jump)
  air_x: f32; air_z: f32;      // where it was last stepped: the run putting you somewhere else puts you on the ground there
  air_from: f32;               // the floor you last stood on: the camera rises only a little above it in a jump
  board: [1] Board;            // the hoverboard (metaverse-engine/action/hoverboard.coax), when the world's board table gives one (#13485)
  hearts: int; heat: f32; hit_cool: f32;
  have: [HAVES] bool; taken: [PICKS] bool;
  scrap: int; cells: int;      // robot pieces won in fights, battery cells found: to trade for battery juice later
  slot: [3] bool;              // the Digger's hardware slots: arm, treads, battery
  strip: [3] int; strip_n: int;
  save: SpSave;
  rubble_gone: bool; wall_gone: bool; at_crate: bool;
  bot: bool;                   // the Digger is built (its three slots are filled): it follows you
  bot_state: int; bot_x: f32; bot_z: f32; bot_yaw: f32; bot_from: f32; bot_step: int; bot_t: f32; bot_fail: f32; bot_wall: bool; bot_spin: f32;
  fx: [FOES] f32; fz: [FOES] f32; fhp: [FOES] int; fhost: [FOES] bool; fstag: [FOES] f32;
  fyaw: [FOES] f32; fflee: [FOES] bool; fpose: [FOES] int;
  fout: [FOES] bool;           // out of the garage at this time of day: its plan stands it beyond the ring (g_plan_out)   // where each faces, whether it runs from you, and its plan's pose (ai/plan.coax MP_*)
  // realm scripts (scripts.coax, #13467): the foes' steps so far; for each foe, where its script said to walk
  // and how fast, the step that word is for and the step it asked to strike on; the strikes on foes this step
  // (for on_hit); and how many calls and diagnostics the scripts have made
  steps: int; sx: [FOES] f32; sz: [FOES] f32; ss: [FOES] f32; sword: [FOES] int; sstrike: [FOES] int;
  shit: [SPS_HITS] int; shit_n: int; scalls: int; sdiags: int;
  // the editor's (?edit): its time of day (-1 the story's; content.coax SC_CLOCK_WORD), the foe whose plan
  // is drawn (-1 none), and whether the World runs with nobody in it for the foes to see (Simulate). Each outlives a reset
  view: int = -1; shown: int = -1; unseen: bool;
  stun: [3] f32; boss_t: f32; boss_down: bool; core_taken: bool;
  rail_s: f32; rail_v: f32; pinged: bool; pass_t: f32;
  banner: int; banner_t: f32; msg: int; msg_t: f32; mem_t: f32; flash: f32;
  walls: [WALLS * 5] f32; wall_n: int;
  btn: [BUTTONS * 4] f32; btn_key: [BUTTONS] int; btn_n: int;
  drag: int; drag_x: f32; drag_y: f32; drag_far: bool;   // the edit bay: what is being dragged (-1 nothing; 0..5 a have)
  drop: [6 * 4] f32;           // the timeline's slots this frame: three parts, three cards
  panels: int; last_pick: int;
  // What moves, by kind, this frame (g_thing), for a host that draws some kinds itself, and what
  // has happened since a host last asked (g_event). Neither changes what the page draws.
  things: [THINGS * THING_FLOATS] f32; thing_first: [THINGS] int; thing_count: [THINGS] int; thing_n: int;
  hide: [TK_KINDS] bool;       // kinds a host draws itself: listed, but not written to the live store; outlives a reset
  events: [EVENTS] int; event_n: int;
  fr: [1] SpFront;             // the front door (front.coax): the menus, your character, the kept run; outlives a reset
  dv: [1] SpDrive;             // the drive to the garage (drive.coax)
  dr: [1] SpDir;               // the Director's systems (director.coax): her stance, Digger's errands and health, the grid, the map, pause
  bt: [1] SpBattle;            // the bots' battles, the drill mech, the raider mech, the boss and the ending (splice-battle.coax)
  snd: [1] SpSound;            // what sounds, and what the page is told to play (sound.coax)
}

// ---- Things and events, for a host that shows the game with its own models and sounds
// (the Unreal bridge, docs/unreal/2026-11-12-aethyr-to-unreal-exporter-spec.md step 3).
// A thing: kind, variant, x, y, z, yaw, scale, and the phase of its movement.
TK_SMUGGLER :: 0; TK_DIGGER :: 1; TK_RAIDER :: 2; TK_IMPERIAL :: 3; TK_DJ :: 4; TK_BOSS :: 5; TK_ROVER :: 6; TK_PICKUP :: 7; TK_KINDS :: 8;
THINGS :: 48; THING_FLOATS :: 8; EVENTS :: 16;
EV_SPLICE_CORE :: 100; EV_RESTORED :: 101; EV_DEPLOY :: 102;   // below 100 an event is the message it came with (MSG_*)

// Before a thing's shapes: lists it, and says whether to write them (-1: a host draws this kind).
g_thing :: (g: [] SpGame, p: [] Pen, kind: int, variant: int, f: Frame, scale: f32, phase: f32) -> int {
  k := g[0].thing_n;
  if k >= THINGS { return ifx g[0].hide[kind] then -1 else THINGS; }   // past the list: drawn as ever, not listed
  o := k * THING_FLOATS;
  g[0].things[o] = cast(f32) kind; g[0].things[o + 1] = cast(f32) variant;
  g[0].things[o + 2] = f.o.x; g[0].things[o + 3] = f.o.y; g[0].things[o + 4] = f.o.z;
  g[0].things[o + 5] = atan2(f.z.x, f.z.z); g[0].things[o + 6] = scale; g[0].things[o + 7] = phase;
  g[0].thing_first[k] = p[0].n; g[0].thing_count[k] = 0; g[0].thing_n = k + 1;
  return ifx g[0].hide[kind] then -1 else k;
}
// After a thing's shapes: how many vertices it wrote.
g_thing_end :: (g: [] SpGame, p: [] Pen, k: int) { if k >= 0 && k < THINGS { g[0].thing_count[k] = p[0].n - g[0].thing_first[k]; } }
g_event :: (g: [] SpGame, e: int) { if g[0].event_n < EVENTS { g[0].events[g[0].event_n] = e; g[0].event_n += 1; } snd_event(g, e); }

// ---- Colours (the Game UI board): paper, shade, ink, heat orange, glow blue
PAPER :: () -> KitTint { return kit_tint(0.918, 0.859, 0.769); }
SHADE :: () -> KitTint { return kit_tint(0.863, 0.788, 0.675); }
INK :: () -> KitTint { return kit_tint(0.118, 0.106, 0.094); }
HEAT :: () -> KitTint { return kit_tint(0.722, 0.263, 0.122); }
GLOW :: () -> KitTint { return kit_tint(0.310, 0.702, 0.851); }
GLOW_INK :: () -> KitTint { return kit_tint(0.122, 0.373, 0.502); }
t3 :: (r: f32, g: f32, b: f32) -> KitTint { return kit_tint(r, g, b); }

// ---- The mine's walls: boxes x0, x1, z0, z1, height. They are drawn from this list, and each is a
// collider in the World (sl_build).
g_wall :: (g: [] SpGame, x0: f32, x1: f32, z0: f32, z1: f32, h: f32) {
  n := g[0].wall_n;
  if n >= WALLS { return; }
  g[0].walls[n * 5] = x0; g[0].walls[n * 5 + 1] = x1; g[0].walls[n * 5 + 2] = z0; g[0].walls[n * 5 + 3] = z1; g[0].walls[n * 5 + 4] = h;
  g[0].wall_n = n + 1;
}
g_layout :: (g: [] SpGame) {
  g[0].wall_n = 0;
  g_wall(g, -44, -4, -10, -2, 9); g_wall(g, 4, 44, -10, -2, 10);            // the mine mouth
  g_wall(g, -44, -9, -24, -10, 11); g_wall(g, 9, 44, -24, -10, 10);         // the scrap room
  g_wall(g, -44, -3, -40, -24, 12); g_wall(g, 3, 44, -40, -24, 12);         // the tunnel
  // the garage's hallway into the mountain and the lab past it (garage.coax); the ring itself is its own colliders
  ga_layout(g);
  g_wall(g, g[0].at.dance_x - 13.4, g[0].at.dance_x - 9.9, g[0].at.dance_z - 5.5, g[0].at.dance_z + 5.5, 0);   // the main stage (drawn apart)
  g_wall(g, g[0].at.rover_x - 1.5, g[0].at.rover_x + 1.5, g[0].at.rover_z - 2.4, g[0].at.rover_z + 2.4, 0); // the rover (drawn apart)
  g_wall(g, g[0].at.crate_x - 0.9, g[0].at.crate_x + 0.9, g[0].at.crate_z - 0.7, g[0].at.crate_z + 0.7, 0); // the stash crate
  g_wall(g, g[0].at.deck_x - 0.12, g[0].at.deck_x + 0.12, g[0].at.deck_z0 + RAMP, g[0].at.deck_z1 - RAMP, 0);   // the catwalk's rail, between its two ramps
  g_wall(g, -60, 60, 20, 24, 0); g_wall(g, -64, -44, -40, 24, 0); g_wall(g, 44, 64, -40, 24, 0);   // the edge of the map outside the mouth
  sl_build(g);   // the walls become colliders in the World (layer.coax), with the layer's placed pieces
}
pick_x :: (g: [] SpGame, i: int) -> f32 { return g[0].at.pick_x[i]; }
pick_z :: (g: [] SpGame, i: int) -> f32 { return g[0].at.pick_z[i]; }
pick_zone :: (i: int) -> int { return ifx i == H_BATTERY then Z_RAIL else Z_MINE; }
// Where each of the party's people stands (a raider dances there) or patrols between (an Imperial robot).
foe_ax :: (g: [] SpGame, i: int) -> f32 { return g[0].at.foe_ax[i]; }
foe_az :: (g: [] SpGame, i: int) -> f32 { return g[0].at.foe_az[i]; }
foe_bx :: (g: [] SpGame, i: int) -> f32 { return g[0].at.foe_bx[i]; }
foe_bz :: (g: [] SpGame, i: int) -> f32 { return g[0].at.foe_bz[i]; }
// The places, from the tables: false when the tables did not load or a landmark the game needs is not in them.
g_places :: (g: [] SpGame) -> bool {
  c := g[0].c[..]; a: SpPlaces; ok := c[0].ok;
  need := [17] int.[LM_DANCE, LM_ROVER, LM_POST, LM_CRATE, LM_START, LM_RUBBLE, LM_WALL, LM_BOSS, LM_DECK_S, LM_DECK_N, LM_BAY, LM_MEM, LM_VIL, LM_SCAN, LM_RAIL, LM_VIL_START, LM_RAIL_STOP];
  for id: need { ok = ok && sc_mark(c, id).id == id; }
  m := sc_mark(c, LM_ROVER); a.rover_x = m.x; a.rover_z = m.z;
  m = sc_mark(c, LM_POST); a.post_x = m.x; a.post_z = m.z;
  m = sc_mark(c, LM_CRATE); a.crate_x = m.x; a.crate_z = m.z;
  m = sc_mark(c, LM_START); a.start_x = m.x; a.start_z = m.z;
  a.rubble_z = sc_mark(c, LM_RUBBLE).z; a.wall_z = sc_mark(c, LM_WALL).z;
  m = sc_mark(c, LM_BOSS); a.boss_x = m.x; a.boss_z = m.z;
  m = sc_mark(c, LM_DECK_S); a.deck_x = m.x; a.deck_z0 = m.z; a.deck_z1 = sc_mark(c, LM_DECK_N).z;
  m = sc_mark(c, LM_BAY); a.bay_x = m.x; a.bay_z = m.z;
  m = sc_mark(c, LM_MEM); a.mem_x = m.x; a.mem_z = m.z;
  m = sc_mark(c, LM_VIL); a.vil_x = m.x; a.vil_z = m.z; a.vil_r = m.r;
  a.scan_z = sc_mark(c, LM_SCAN).z;
  m = sc_mark(c, LM_RAIL); a.rail_x = m.x; a.rail_z = m.z;
  for i: 0..<PICKS { m = sc_mark(c, LM_PICK + i); ok = ok && m.id == LM_PICK + i; a.pick_x[i] = m.x; a.pick_z[i] = m.z; }
  for i: 0..<FOES {
    m = sc_mark(c, LM_FOE + i); ok = ok && m.id == LM_FOE + i; a.foe_ax[i] = m.x; a.foe_az[i] = m.z; a.foe_bx[i] = m.x; a.foe_bz[i] = m.z;
    t := sc_mark(c, LM_FOE_TURN + i);
    if t.id == LM_FOE_TURN + i { a.foe_bx[i] = t.x; a.foe_bz[i] = t.z; }
  }
  // the garage (garage.coax): from its landmark when the tables have one
  m = sc_mark(c, LM_DANCE); a.dance_x = m.x; a.dance_z = m.z;
  m = sc_mark(c, LM_GARAGE); a.gar_x = GA_X; a.gar_z = GA_Z; a.gar_r = GA_R;
  if m.id == LM_GARAGE && m.r > 10 { a.gar_x = m.x; a.gar_z = m.z; a.gar_r = m.r; }
  g[0].at = a;
  return ok;
}
g_foes :: (g: [] SpGame) {
  for i: 0..<FOES {
    g[0].fx[i] = foe_ax(g, i); g[0].fz[i] = foe_az(g, i); g[0].fhp[i] = ifx i < F_RAIDERS then T_RAIDER_HP else T_IMPERIAL_HP; g[0].fhost[i] = false; g[0].fstag[i] = 0;
    g[0].fflee[i] = false; g[0].fyaw[i] = 0;
    // where its plan for the time of day starts it (the shipped plans start each where its landmark is)
    pl := sc_plan(g[0].c[..], i, g_phase(g));
    if pl.ok && pl.n > 0 { g[0].fx[i] = mp_m(pl.x[0]); g[0].fz[i] = mp_m(pl.z[0]); }
    g[0].fout[i] = g_plan_out(g, pl);
  }
}
// The time of day the foes keep and the light is: the editor's when it set one, else the story's phase.
g_phase :: (g: [] SpGame) -> int { return ifx g[0].view >= 0 then g[0].view else g[0].phase; }
// The boss's weak points ride on its body (splice-battle.coax).
weak_at :: (g: [] SpGame, i: int) -> Point { return sb_weak_at(g, i); }
// The rail line: s metres along it, a gentle curve north.
rail_at :: (g: [] SpGame, s: f32) -> Point { return v3(g[0].at.rail_x + sin(s * 0.03) * 8, 0, g[0].at.rail_z + s); }
rail_yaw :: (g: [] SpGame, s: f32) -> f32 { a := rail_at(g, s); b := rail_at(g, s + 1); return atan2(b.x - a.x, b.z - a.z); }

g_keep :: (g: [] SpGame) {
  for i: 0..<HAVES { g[0].save.have[i] = g[0].have[i]; }
  for i: 0..<PICKS { g[0].save.taken[i] = g[0].taken[i]; }
  for i: 0..<3 { g[0].save.slot[i] = g[0].slot[i]; g[0].save.strip[i] = g[0].strip[i]; }
  g[0].save.strip_n = g[0].strip_n; g[0].save.scrap = g[0].scrap; g[0].save.cells = g[0].cells;
}
// Back at Sniper, the rover, which is the checkpoint (#13505), with the inventory you had when you last left it: what was picked up
// since is lost and lies where it was.
g_respawn :: (g: [] SpGame) {
  // beside Sniper, the rover: the checkpoint
  g[0].zone = Z_MINE; g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z; g[0].yaw = PI; g[0].pitch = 0; g[0].hearts = T_HEARTS; g[0].heat = 0; g[0].hit_cool = 0;
  for i: 0..<HAVES { g[0].have[i] = g[0].save.have[i]; }
  for i: 0..<PICKS { g[0].taken[i] = g[0].save.taken[i]; }
  for i: 0..<3 { g[0].slot[i] = g[0].save.slot[i]; g[0].strip[i] = g[0].save.strip[i]; }
  g[0].strip_n = g[0].save.strip_n; g[0].scrap = g[0].save.scrap; g[0].cells = g[0].save.cells;
  if g[0].core_taken && !g[0].have[H_CORE] { g[0].core_taken = false; }
  // a world whose starts table has a row for this time of day sends you back there (flow.coax)
  k := flw_at(g[0].c[0].starts[..], g[0].c[0].start_n, g[0].phase);
  if k >= 0 { s := g[0].c[0].starts[k]; g[0].px = sc_m(s.x); g[0].pz = sc_m(s.z); g[0].yaw = sl_rad(s.yaw); }
  g_foes(g);
  g[0].bot = true; g_bot_home(g); d_respawn(g);
  sb_respawn(g);   // the boss whole again, the mech repaired (splice-battle.coax)
}
g_reset :: (g: [] SpGame) {
  gray := g[0].gray;   // the graybox toggle is the viewer's, not the run's
  hide: [TK_KINDS] bool; for k: 0..<TK_KINDS { hide[k] = g[0].hide[k]; }   // and what a host draws is the host's
  tables := g[0].c[0];   // the content tables are read once
  layer := g[0].layer[0];   // the edit layer is the world's, not the run's
  imports := g[0].imp[0];   // and so are the meshes it imported
  view := g[0].view; shown := g[0].shown; unseen := g[0].unseen;   // and the editor's clock, its shown foe and Simulate
  front := g[0].fr[0];   // and the front door: your character and the run this browser keeps
  sound := g[0].snd[0];   // and what the page has been told to play (sound.coax)
  g[0] = SpGame.{};
  g[0].fr[0] = front;
  g[0].snd[0] = sound; g[0].snd[0].ready = false;
  g[0].view = view; g[0].shown = shown; g[0].unseen = unseen;
  g[0].imp[0] = imports;
  g[0].gray = gray;
  if tables.ok { g[0].c[0] = tables; } else { _ := sc_load(g[0].c[..], SC_SHIPPED); }
  _ := g_places(g);
  g[0].layer[0] = layer;
  for k: 0..<TK_KINDS { g[0].hide[k] = hide[k]; }
  g_layout(g);
  g[0].mode = M_TITLE; g[0].zone = Z_VILLAGE; g[0].phase = PH_DAWN; g[0].drag = -1;
  g[0].px = g[0].at.vil_x; g[0].pz = g[0].at.vil_z - 3; g[0].yaw = 0; g[0].hearts = T_HEARTS; g[0].rail_v = T_RAIL_SPEED;
  g_foes(g);
  g[0].bot = true; g_bot_home(g);   // Digger is with her from the first step (director.coax)
  sb_reset(g);
}
g_say :: (g: [] SpGame, m: int) { g[0].msg = m; g[0].msg_t = 3.5; g_event(g, m); }
// The Digger beside you: where it stands when it is not at work.
g_bot_home :: (g: [] SpGame) { g[0].bot_state = BOT_FOLLOW; g[0].bot_x = g[0].px - sin(g[0].yaw) * 1.7 - cos(g[0].yaw) * 1.1; g[0].bot_z = g[0].pz - cos(g[0].yaw) * 1.7 + sin(g[0].yaw) * 1.1; g[0].bot_yaw = g[0].yaw; }
g_enter_mine :: (g: [] SpGame) { g[0].zone = Z_MINE; g[0].mode = M_PLAY; g[0].phase = PH_DAY; g[0].px = g[0].at.start_x; g[0].pz = g[0].at.start_z; g[0].yaw = PI; g[0].pitch = 0; g_bot_home(g); g_keep(g); }
// A new run (front.coax), or a restored one: the dome village at dawn, or where the world's starts table says the run starts
// (metaverse-engine/world/flow.coax, #13485): out in the open at that row's time of day.
g_begin :: (g: [] SpGame) {
  g[0].mode = M_PLAY; g[0].look_free = false;
  k := flw_first(g[0].c[0].starts[..], g[0].c[0].start_n);
  if k < 0 { return; }
  s := g[0].c[0].starts[k];
  g[0].zone = Z_MINE; g[0].phase = s.when; g_go(g, sc_m(s.x), sc_m(s.z), s.yaw);
  // a world that starts past the rail starts with the rail's Battery: the edit bay needs it for Digger's cut
  g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true;
  g_foes(g); g_keep(g);
}
// Stand at (x, z) metres facing `deg` degrees, the Digger beside you.
g_go :: (g: [] SpGame, x: f32, z: f32, deg: int) { g[0].px = x; g[0].pz = z; g[0].yaw = sl_rad(deg); g[0].pitch = 0; g_bot_home(g); }
// The portal you stand at (metaverse-engine/world/portal.coax), or -1: its FROM is a placed piece's kind or a point.
g_portal :: (g: [] SpGame) -> int {
  if g[0].zone != Z_MINE || g[0].c[0].portal_n == 0 { return -1; }
  things: [SL_ITEMS] PortalThing; n := 0;
  for i: 0..<g[0].layer[0].st[0].n { e := g[0].layer[0].items[i]; if n < SL_ITEMS { things[n] = PortalThing.{kind = e.mesh, x = e.x, z = e.z}; n += 1; } }
  return prt_pick(g[0].c[0].portals[..], g[0].c[0].portal_n, things[0..<n], g[0].px, g[0].pz);
}

// ---- Collision: the smuggler is a circle. The dome village's round room and the ground round the
// rail stop hold it in; everything else that blocks is a collider in the World (layer.coax): the
// walls, the rubble and the boss wall until they open, the banned bot, the stopped rover and
// every placed piece.
dist2 :: (ax: f32, az: f32, bx: f32, bz: f32) -> f32 { return sqrt((ax - bx) * (ax - bx) + (az - bz) * (az - bz)); }
g_collide :: (g: [] SpGame) {
  if g[0].zone == Z_VILLAGE {
    // the dome's round floor, and the gate's corridor out of it
    d := dist2(g[0].px, g[0].pz, g[0].at.vil_x, g[0].at.vil_z);
    if d > g[0].at.vil_r - 0.7 {
      if g[0].pz > g[0].at.vil_z + 5.5 && abs(g[0].px - g[0].at.vil_x) < 1.6 { g[0].px = clamp(g[0].px, g[0].at.vil_x - 1.0, g[0].at.vil_x + 1.0); }
      else { k := (g[0].at.vil_r - 0.7) / d; g[0].px = g[0].at.vil_x + (g[0].px - g[0].at.vil_x) * k; g[0].pz = g[0].at.vil_z + (g[0].pz - g[0].at.vil_z) * k; }
    }
  }
  if g[0].zone == Z_RAIL {
    // on foot at the sensor ping: the ground round the stopped rover
    c := rail_at(g, T_RAIL_PING); d := dist2(g[0].px, g[0].pz, c.x, c.z);
    if d > 26 { g[0].px = c.x + (g[0].px - c.x) * 26 / d; g[0].pz = c.z + (g[0].pz - c.z) * 26 / d; }
  }
  q := sl_push_over(g, g[0].px, g[0].pz, T_RADIUS, false, g_feet_y(g)); g[0].px = q.x; g[0].pz = q.z;   // a piece under your feet lets you over it
  q = ga_push(g, g[0].px, g[0].pz, T_RADIUS); g[0].px = q.x; g[0].pz = q.z;   // the garage's round back wall (garage.coax)
}
g_inside :: (g: [] SpGame, x: f32, z: f32) -> bool {
  if g[0].zone == Z_VILLAGE && dist2(x, z, g[0].at.vil_x, g[0].at.vil_z) > g[0].at.vil_r - 0.5 && !(z > g[0].at.vil_z + 5 && abs(x - g[0].at.vil_x) < 1.5) { return true; }
  if ga_push(g, x, z, 0.3).x != x || ga_push(g, x, z, 0.3).z != z { return true; }   // behind the garage's back wall
  return sl_inside(g, x, z, 0.3);
}
// The catwalk: a deck along the party's east wall, a ramp at each end.
on_deck :: (g: [] SpGame, x: f32, z: f32) -> bool { return x > g[0].at.deck_x - 0.2 && z > g[0].at.deck_z0 && z < g[0].at.deck_z1; }
ground_y :: (g: [] SpGame, x: f32, z: f32) -> f32 {
  if z <= g[0].at.deck_z0 || z >= g[0].at.deck_z1 || x < g[0].at.deck_x - 3 || x > g[0].at.deck_x + 12 { return 0; }
  if x >= g[0].at.deck_x { return DECK_Y; }
  ramp := z < g[0].at.deck_z0 + RAMP || z > g[0].at.deck_z1 - RAMP;
  if ramp { return clamp((x - (g[0].at.deck_x - 3)) / 3, 0, 1) * DECK_Y; }
  return 0;
}
near_rover :: (g: [] SpGame, r: f32) -> bool {
  if g[0].zone == Z_RAIL { c := rail_at(g, g[0].rail_s); return dist2(g[0].px, g[0].pz, c.x, c.z) < r; }
  return g[0].zone == Z_MINE && dist2(g[0].px, g[0].pz, g[0].at.rover_x, g[0].at.rover_z) < r;
}
near_crate :: (g: [] SpGame, r: f32) -> bool { return g[0].zone == Z_MINE && dist2(g[0].px, g[0].pz, g[0].at.crate_x, g[0].at.crate_z) < r; }
// The pickup within reach, or -1.
g_reach :: (g: [] SpGame) -> int {
  best := -1; bd := T_PICK_RANGE;
  for i: 0..<PICKS {
    if g[0].taken[i] || pick_zone(i) != g[0].zone { continue; }
    d := dist2(g[0].px, g[0].pz, pick_x(g, i), pick_z(g, i));
    if d < bd { bd = d; best = i; }
  }
  return best;
}
g_weak_near :: (g: [] SpGame) -> int { return sb_weak_near(g); }   // only while they are open (splice-battle.coax)

// ---- The Digger's run: its cards in order, one every T_CARD_TIME
g_deploy :: (g: [] SpGame) {
  if d_down(g) { d_say(g, DS_DOWN); return; }
  if !g[0].bot || !(g[0].slot[0] && g[0].slot[1] && g[0].slot[2]) || g[0].strip_n == 0 { g_say(g, MSG_NEED); return; }
  // the Digger leaves your side and drives to its work
  g[0].bot_state = BOT_GO; g[0].bot_wall = g[0].rubble_gone; g[0].bot_step = -1; g[0].bot_fail = 0; g[0].mode = M_PLAY;
}
bot_toward :: (g: [] SpGame, tx: f32, tz: f32, speed: f32, dt: f32) -> f32 {
  dx := tx - g[0].bot_x; dz := tz - g[0].bot_z; d := sqrt(dx * dx + dz * dz);
  if d < 0.0001 { return 0; }
  step := lo(d, speed * dt);
  g[0].bot_x += dx / d * step; g[0].bot_z += dz / d * step;
  if d > 0.25 { g[0].bot_yaw = atan2(dx, dz); }
  return d - step;
}
g_bot :: (g: [] SpGame, dt: f32) {
  if !g[0].bot || (d_busy(g) && g[0].bot_state == BOT_FOLLOW) { return; }   // on an errand of his own, or powered down (director.coax)
  if sb_holds_digger(g) { return; }   // his core is in the drill mech, or he is fielded in a battle (splice-battle.coax)
  face := ifx g[0].bot_wall then g[0].at.wall_z + 1 else g[0].at.rubble_z + 1;
  if g[0].bot_state == BOT_FOLLOW {
    // always next to you: a step behind and to your right
    tx := g[0].px - sin(g[0].yaw) * 1.7 - cos(g[0].yaw) * 1.1; tz := g[0].pz - cos(g[0].yaw) * 1.7 + sin(g[0].yaw) * 1.1;
    d := dist2(g[0].bot_x, g[0].bot_z, tx, tz);
    if d > 0.15 { left := bot_toward(g, tx, tz, T_FOLLOW * clamp(d / 1.5, 0.15, 1.6), dt); if left > 12 { g[0].bot_x = tx; g[0].bot_z = tz; } }
    return;
  }
  if g[0].bot_state == BOT_FAIL { g[0].bot_fail -= dt; if g[0].bot_fail <= 0 { g[0].bot_state = BOT_FOLLOW; } return; }
  if g[0].bot_state == BOT_GO {
    // out to the middle of the cut first, then down it to where the cards begin
    start := face + T_MOVE_SHORT + T_MOVE_MAX;
    if g[0].bot_z > -1.5 && abs(g[0].bot_x) > 0.3 { left := bot_toward(g, 0, g[0].bot_z, T_BOT_GO, dt); return; }
    if bot_toward(g, 0, start, T_BOT_GO, dt) < 0.05 { g[0].bot_state = BOT_RUN; g[0].bot_from = g[0].bot_z; g[0].bot_t = T_CARD_TIME - 0.6; g[0].bot_step = -1; g[0].bot_yaw = PI; }
    return;
  }
  cleared := ifx g[0].bot_wall then g[0].wall_gone else g[0].rubble_gone;
  if cleared { g[0].bot_state = BOT_FOLLOW; return; }
  card := ifx g[0].bot_step >= 0 && g[0].bot_step < g[0].strip_n then g[0].strip[g[0].bot_step] else -1;
  // MOVE drives forward to just short of what is in the way, at most T_MOVE_MAX
  if card == H_MOVE { g[0].bot_z = hi(hi(face + T_MOVE_SHORT, g[0].bot_from - T_MOVE_MAX), g[0].bot_z - dt * 4.2); }
  if card == H_DRILL || card == H_PLUS { g[0].bot_spin += dt * 22; }
  g[0].bot_t += dt;
  if g[0].bot_t < T_CARD_TIME { return; }
  g[0].bot_t = 0;
  // the card that just finished decides what happened
  if card == H_MOVE { g[0].bot_from = g[0].bot_z; }
  if card == H_DRILL || card == H_PLUS {
    if g[0].bot_z - face > T_DRILL_REACH { g_say(g, MSG_AIR); }
    else if g[0].bot_wall { g_say(g, SBM_NEED_MECH); g[0].bot_state = BOT_FOLLOW; return; }   // only the drill mech breaks the hallway
    else { g[0].rubble_gone = true; g[0].phase = PH_DUSK; g[0].flash = 0.5; g_say(g, MSG_OPEN); g[0].bot_state = BOT_FOLLOW; return; }
  }
  g[0].bot_step += 1;
  if g[0].bot_step >= g[0].strip_n { g[0].bot_state = BOT_FAIL; g[0].bot_fail = T_BAD_CUT; if g[0].msg == MSG_NONE || g[0].msg_t < 2.5 { g_say(g, MSG_BAD_CUT); } }
}

// ---- A step of the world
g_hurt :: (g: [] SpGame) {
  if g[0].hit_cool > 0 { return; }
  g[0].hearts -= 1; g[0].hit_cool = T_HIT_COOL; g[0].flash = 0.35; g_say(g, MSG_HIT);
  if g[0].hearts <= 0 { g[0].mode = M_BANNER; g[0].banner = B_CUT; g[0].banner_t = T_BANNER; }
}
g_foe_walls :: (g: [] SpGame, i: int) {
  q := sl_push(g, g[0].fx[i], g[0].fz[i], 0.45, true);
  q = ga_push(g, q.x, q.z, 0.45);
  g[0].fx[i] = q.x; g[0].fz[i] = q.z;
}
boss_arm :: (g: [] SpGame) -> f32 { if g[0].boss_t <= T_SWEEP_EVERY { return 2.6; } return 2.6 + (g[0].boss_t - T_SWEEP_EVERY) / T_SWEEP_TIME * TAU; }
g_walk :: (g: [] SpGame, dt: f32) {
  turn := (ifx g[0].turn_l then 1.0f32 else 0.0f32) - (ifx g[0].turn_r then 1.0f32 else 0.0f32);
  go := (ifx g[0].fwd then 1.0f32 else 0.0f32) - (ifx g[0].back then 0.6f32 else 0.0f32);
  side := (ifx g[0].right then 0.8f32 else 0.0f32) - (ifx g[0].left then 0.8f32 else 0.0f32);
  g[0].yaw += turn * T_TURN * dt;
  // ahead is (sin yaw, cos yaw); to the right of it is (-cos yaw, sin yaw)
  pace := T_WALK * d_pace(g);   // sneaking is slower (director.coax)
  g[0].px += (sin(g[0].yaw) * go - cos(g[0].yaw) * side) * pace * dt;
  g[0].pz += (cos(g[0].yaw) * go + sin(g[0].yaw) * side) * pace * dt;
  if go != 0 || side != 0 {
    g[0].stride += dt * 9;
    // she turns to face the way she walks, never walking backwards (#13505 playtest): her body eases
    // toward the move's direction, measured from the view
    want := atan2(-side, go); d := want - g[0].face_off; d = atan2(sin(d), cos(d));
    g[0].face_off += d * lo(1, 12 * dt);
  }
  g_collide(g);
}
// Which way her body faces: the view's yaw turned by the way she last walked.
g_face :: (g: [] SpGame) -> f32 { return ifx g_riding(g) then g[0].yaw else g[0].yaw + g[0].face_off; }
// ---- The hoverboard (#13485): the world's board table gives it (realm world-board), B calls it up
// at casual, Q switches casual and fast, Q Q is super fast and holding Q steps off (director.coax);
// W and S speed up and slow, A and D carve, Space hops.
// The engine's board (metaverse-engine/action/hoverboard.coax) steps it; Splice Bots' own colliders push it.
g_board_tune :: (g: [] SpGame) -> MountTune {
  b := g[0].c[0].board;
  return board_tune(b.casual, ifx g[0].dr[0].super then board_super_cms(b.fast) else b.fast);   // a double tap of Q: super fast (director.coax)
}
g_board_given :: (g: [] SpGame) -> bool { return g[0].c[0].board.ok && g[0].c[0].board.on; }
g_riding :: (g: [] SpGame) -> bool { return board_riding(g[0].board[0]); }
g_board_key :: (g: [] SpGame) {
  if g_riding(g) { board_down(g[0].board[..]); return; }
  if g_board_given(g) { board_up(g[0].board[..], 0, g[0].px, g[0].pz, g[0].yaw); g[0].stride = 0; }   // you stand on it
}
g_ride :: (g: [] SpGame, dt: f32) {
  b := g[0].board[..];
  // the run put you somewhere else (a respawn, the mine's mouth): the board comes with you
  if dist2(b[0].m.x, b[0].m.z, g[0].px, g[0].pz) > 1 { board_up(b, 0, g[0].px, g[0].pz, g[0].yaw); }
  b[0].m.face = g[0].yaw;   // the mouse turns it too
  go := (ifx g[0].fwd then 1.0f32 else 0.0f32) - (ifx g[0].back then 1.0f32 else 0.0f32);
  turn := (ifx g[0].right || g[0].turn_r then 1.0f32 else 0.0f32) - (ifx g[0].left || g[0].turn_l then 1.0f32 else 0.0f32);
  none: [6] f32;
  board_step(b, g_board_tune(g), go, turn, g[0].jump, dt, none[..], 0);
  g[0].px = b[0].m.x; g[0].pz = b[0].m.z;
  g_collide(g);
  board_resolve(b, g[0].px, g[0].pz, dt);
  g[0].yaw = b[0].m.face;
}
// ---- The jump: Space on foot. The engine's jump (metaverse-engine/move/jump.coax, the walker's own
// rules) takes the press, lifts you at the walker's jump speed, brings you down by its gravity and
// lands you on the floor under you: the ground, or the top of a placed piece (sl_floors, asked as
// the walker asks: query_stand_checked). A piece under your feet lets you over it (g_collide).
// Splice's walk still moves you across; the jump moves you up and down.
SP_FLOORS :: 8;
// The ground under (x, z): the catwalk's deck and ramps in the mine, flat elsewhere.
g_ground :: (g: [] SpGame, x: f32, z: f32) -> f32 { return ifx g[0].zone == Z_MINE then ground_y(g, x, z) else 0.0f32; }
// Whether the jump is where you are: not when the run put you somewhere else, or you ride.
g_air_here :: (g: [] SpGame) -> bool { return !g_riding(g) && dist2(g[0].air_x, g[0].air_z, g[0].px, g[0].pz) <= 1; }
// Your feet's height as drawn: the jump's in the air or on a piece, else the ground's.
g_feet_y :: (g: [] SpGame) -> f32 {
  gr := g_ground(g, g[0].px, g[0].pz);
  if !g_air_here(g) { return gr; }
  return hi(gr, jump_feet(g[0].air[0]));
}
// The height the camera follows: your feet standing or falling below where you stood, and only a
// third of a jump's rise above it, so the view stays steady (and under the dome's roof).
SP_CAM_RISE :: 0.35f32;
g_cam_y :: (g: [] SpGame) -> f32 {
  y := g_feet_y(g);
  if !g_airborne(g) || y <= g[0].air_from { return y; }
  return g[0].air_from + (y - g[0].air_from) * SP_CAM_RISE;
}
// In the air on a jump (or falling off a piece).
g_airborne :: (g: [] SpGame) -> bool { return g_air_here(g) && jump_airborne(g[0].air[0]); }
// Space, on foot in play: a press the jump's next step takes. A release anywhere ends the hold.
g_jump_key :: (g: [] SpGame, down: bool) {
  if down && (g[0].mode != M_PLAY || g_riding(g)) { return; }
  g[0].air[0] = jump_press(g[0].air[0], down);
}
g_jump :: (g: [] SpGame, dt: f32) {
  j := g[0].air[..]; x := g[0].px; z := g[0].pz;
  gr := g_ground(g, x, z);
  if !g_air_here(g) { presses := j[0].presses; j[0] = jump_place(gr); j[0].presses = presses; }
  g[0].air_x = x; g[0].air_z = z;
  floors: [SP_FLOORS * STAND_FLOATS] f32;
  c := Colliders.{ground = gr, floors = floors[0..<sl_floors(g, x, z, floors[..]) * STAND_FLOATS]};
  under := query_stand_checked(c, x, z, j[0].y, T_RADIUS);
  loc: LocomotionProfile;   // the engine's published walking numbers: a 7.5 m/s jump, 24 m/s^2
  j[0].air_jumps = 1;       // a second Space in the air jumps higher (#13505 playtest)
  j[0] = jump_advance(j[0], loc, ifx under.status == QueryStatus.ok then hi(gr, under.y) else gr, dt);
  // standing: on the floor exactly (the catwalk's ramps), not eased onto it
  if j[0].on_ground && under.status == QueryStatus.ok { j[0].y = hi(gr, under.y); }
  if j[0].on_ground { g[0].air_from = j[0].y; }
}
// The walk, or the board when you ride one.
g_move :: (g: [] SpGame, dt: f32) { if g_riding(g) { g_ride(g, dt); } else { g_walk(g, dt); g_jump(g, dt); } }
g_step :: (g: [] SpGame, dt: f32) {
  snd_tick(g, dt);   // what sounds: what changed since the last step, and the loops for where you are (sound.coax)
  g[0].t += dt;
  // off the board when play stops (the edit bay, the rail, a banner, the front screens) or the world takes it away
  if g_riding(g) && (g[0].mode != M_PLAY || !g_board_given(g)) { board_down(g[0].board[..]); }
  fr_autosave(g, dt);   // the run this browser keeps (front.coax)
  if fr_front(g) { if g[0].mode == M_CREW { fr_spin_step(g, dt); } return; }
  if g[0].msg_t > 0 { g[0].msg_t -= dt; if g[0].msg_t <= 0 { g[0].msg = MSG_NONE; } }
  if g[0].flash > 0 { g[0].flash = hi(0, g[0].flash - dt * 1.6); }
  if g[0].hit_cool > 0 { g[0].hit_cool = hi(0, g[0].hit_cool - dt); }   // the hit cooldown counts down everywhere: the mine, the desert, the drive
  if g[0].mode == M_BANNER { g[0].banner_t -= dt; if g[0].banner_t <= 0 { g_respawn(g); g[0].mode = M_PLAY; } return; }
  sb_end_step(g, dt);   // SCENE RESTORED, then the mission's teaser
  if g[0].mode == M_MEMORY { g[0].mem_t += dt; if g[0].mem_t >= T_MEMORY { g[0].mode = M_RESTORED; g_event(g, EV_RESTORED); } return; }
  if g[0].mode == M_BAY { if g[0].heat > 0 { g[0].heat = hi(0, g[0].heat - T_HEAT_COOL * dt); } return; }
  if g[0].mode == M_DRIVE { dv_step(g, dt); return; }   // Sniper drives (drive.coax)
  if g[0].mode == M_RIDE {
    // the rover follows the rail; W and S change its speed; the sensor ping stops it halfway
    want := ifx g[0].fwd then T_RAIL_FAST else ifx g[0].back then T_RAIL_SLOW else T_RAIL_SPEED;
    want = sb_ride_pace(g, want);   // a battle with the raider mech holds Sniper to its slow speed (splice-battle.coax)
    g[0].rail_v += clamp(want - g[0].rail_v, -8 * dt, 8 * dt);
    g[0].rail_s += g[0].rail_v * dt;
    if !g[0].pinged && g[0].rail_s >= T_RAIL_PING {
      g[0].rail_s = T_RAIL_PING; g[0].pinged = true; g[0].mode = M_PLAY; g_say(g, MSG_PING);
      c := rail_at(g, T_RAIL_PING); g[0].px = c.x + 2.6; g[0].pz = c.z; g[0].yaw = PI * 0.5; g[0].pitch = 0;
    }
    sb_ride(g, dt);   // the raider mech's chase, and a battle with it from Sniper (splice-battle.coax)
    if g[0].rail_s >= T_RAIL { g_enter_mine(g); }
    return;
  }
  if g[0].mode != M_PLAY || g[0].dr[0].paused { return; }
  d_pre(g, dt);   // the stance's time and the board's speed (director.coax)
  if g[0].zone == Z_VILLAGE {
    if g[0].pass_t > 0 { g[0].pass_t -= dt; if g[0].pass_t <= 0 { g[0].zone = Z_RAIL; g[0].mode = M_RIDE; g[0].phase = PH_DAY; g[0].rail_s = 0; } return; }
    g_move(g, dt);
    if g[0].pz > g[0].at.scan_z { g[0].pass_t = T_PASS; }   // through the scanner beam: Heat is cool, pass
    return;
  }
  g_move(g, dt);
  sb_step(g, dt);   // battles, the drill mech, the raider mech and the boss (splice-battle.coax)
  if g[0].zone == Z_RAIL { d_post(g, dt); g_bot(g, dt); return; }
  g_beats(g);   // and where the world's beats table moves the day on (flow.coax)
  // Sniper keeps what you carry: at zero you are back with what you had when you last left it
  if near_rover(g, T_SAVE_RANGE) { g_keep(g); }
  // Heat cools only at Sniper, the rover (5 a second, #13505); at the top (100) the Emperor's sweep comes
  if g[0].heat > 0 && near_rover(g, T_COOL_RANGE) { g[0].heat = hi(0, g[0].heat - T_HEAT_COOL * dt); }
  if g[0].heat >= T_HEAT_MAX { g[0].mode = M_BANNER; g[0].banner = B_SWEEP; g[0].banner_t = T_BANNER; return; }
  // the party: each foe keeps its plan for the time of day (content.coax plans, metaverse-engine/ai/plan.coax).
  // As shipped, raiders dance where they stand and fight only if you hit them; Imperial robots patrol,
  // notice you (from further at higher Heat), chase, and give up at the catwalk or far away
  g_foes_step(g, dt);
  d_post(g, dt);   // Heat's floor, and Digger's own errands (director.coax)
  g_bot(g, dt);
}

// The foes on their plans. A foe that notices you does what its plan says on seeing you: chases, calls
// the others near it too, flees, or ignores you; one in a fight or on the run gives up past T_GIVE_UP or at
// the catwalk, and a guard past twice its notice from its post. Simulating (unseen), nobody is there to see.
// A plan is out of the garage when every point of its route lies beyond the ring and its bays (the
// garage's landmark and radius, ga_inside): the raiders scavenging the desert at dusk, the Imperial
// robots recharging at the solar farm (#13505). A foe out of the garage is not there: it isn't drawn,
// senses no one and can't be pointed at or stunned. Going out or coming back in, it is where its plan starts.
g_plan_out :: (g: [] SpGame, pl: NplPlan) -> bool {
  if !pl.ok || pl.n <= 0 || pl.act == NPD_FOLLOW { return false; }
  for k: 0..<pl.n { if ga_inside(g, mp_m(pl.x[k]), mp_m(pl.z[k])) { return false; } }
  return true;
}
// A foe that is in play: not beaten, and not out of the garage.
g_foe_in :: (g: [] SpGame, i: int) -> bool { return g[0].fhp[i] > 0 && !g[0].fout[i]; }
g_foes_step :: (g: [] SpGame, dt: f32) {
  safe := sps_safe(g);
  g[0].steps += 1;
  for i: 0..<FOES {
    if g[0].fhp[i] <= 0 { continue; }
    {
      po := sc_plan(g[0].c[..], i, g_phase(g)); out := g_plan_out(g, po);
      if out != g[0].fout[i] {
        g[0].fout[i] = out; g[0].fhost[i] = false; g[0].fflee[i] = false; g[0].fstag[i] = 0;
        if po.ok && po.n > 0 { g[0].fx[i] = mp_m(po.x[0]); g[0].fz[i] = mp_m(po.z[0]); }
      }
      if out { continue; }
    }
    if g[0].fstag[i] > 0 { g[0].fstag[i] -= dt; continue; }
    imperial := i >= F_RAIDERS;
    pl := sc_plan(g[0].c[..], i, g_phase(g));
    d := dist2(g[0].px, g[0].pz, g[0].fx[i], g[0].fz[i]);
    see := mp_notice(pl);
    // A foe whose script spoke for this step does what it said (scripts.coax); any other reacts by its plan.
    spoke := sps_spoke(g, i);
    if !spoke && see > 0 && !g[0].unseen && !g[0].fhost[i] && !g[0].fflee[i] && !safe && d < d_noticed(g, see) {
      if pl.on == NPO_FLEE { g[0].fflee[i] = true; } else { g[0].fhost[i] = true; }
      if pl.on == NPO_CALL { for j: 0..<FOES { if j != i && g_foe_in(g, j) && dist2(g[0].fx[i], g[0].fz[i], g[0].fx[j], g[0].fz[j]) < T_CALL { g[0].fhost[j] = true; g[0].fflee[j] = false; } } }
    }
    if !spoke && g[0].fhost[i] && (safe || d > T_GIVE_UP || g[0].unseen) { g[0].fhost[i] = false; }
    if !spoke && g[0].fflee[i] && (d > T_GIVE_UP || g[0].unseen) { g[0].fflee[i] = false; }
    if !spoke && g[0].fhost[i] && pl.act == NPD_GUARD && pl.n > 0 && dist2(g[0].fx[i], g[0].fz[i], mp_m(pl.x[0]), mp_m(pl.z[0])) > hi(2 * see, 4) { g[0].fhost[i] = false; }
    lead := ifx pl.act == NPD_FOLLOW && pl.lead >= 1 && pl.lead <= FOES then pl.lead - 1 else i;
    gl := mp_goal(pl, g[0].t, cast(f32) i * 1.7, i, g[0].fx[lead], g[0].fz[lead], g[0].fyaw[lead]);
    tx := gl.x; tz := gl.z; sp := gl.speed;
    g[0].fpose[i] = gl.pose;
    if !pl.ok { tx = foe_ax(g, i); tz = foe_az(g, i); sp = T_PATROL; }
    run := ifx imperial then T_IMPERIAL_SPEED else T_RAIDER_SPEED;
    if g[0].fhost[i] { tx = g[0].px; tz = g[0].pz; sp = run; g[0].fpose[i] = MP_WALK; }
    if g[0].fflee[i] { k := 6 / hi(d, 0.1); tx = g[0].fx[i] + (g[0].fx[i] - g[0].px) * k; tz = g[0].fz[i] + (g[0].fz[i] - g[0].pz) * k; sp = run; g[0].fpose[i] = MP_WALK; }
    if spoke { tx = g[0].sx[i]; tz = g[0].sz[i]; sp = lo(g[0].ss[i], run); }
    ex := tx - g[0].fx[i]; ez := tz - g[0].fz[i]; el := sqrt(ex * ex + ez * ez);
    if el > 0.05 {
      g[0].fx[i] += ex / el * lo(sp * dt, el); g[0].fz[i] += ez / el * lo(sp * dt, el);
      if sp * dt > 0.0001 { g[0].fyaw[i] = atan2(ex, ez); }
    } else if gl.look { g[0].fyaw[i] = atan2(gl.look_x - g[0].fx[i], gl.look_z - g[0].fz[i]); }
    g_foe_walls(g, i);
    if g[0].fhost[i] && d < T_RAIDER_REACH && (!spoke || g[0].sstrike[i] == g[0].steps) { g_hurt(g); }
  }
}

// The world's beats (metaverse-engine/world/flow.coax, #13485): standing in a beat's area at its FROM, the
// time of day becomes its TO, and the foes take their plans for it from where they stand.
g_beats :: (g: [] SpGame) {
  c := g[0].c[..];
  if c[0].beat_n == 0 { return; }
  inside: [FLW_MAX] bool;
  for k: 0..<c[0].beat_n {
    for a: 0..<c[0].area_n {
      m := c[0].areas[a];
      if m.id != c[0].beats[k].area { continue; }
      inside[k] = ifx m.r > 0 then dist2(g[0].px, g[0].pz, m.x, m.z) <= m.r else abs(g[0].px - m.x) <= m.hx && abs(g[0].pz - m.z) <= m.hz;
    }
  }
  g[0].phase = flw_step(c[0].beats[..], c[0].beat_n, inside[..], g[0].phase);
}

// ---- Input
g_open_bay :: (g: [] SpGame) -> bool {
  if g[0].zone != Z_MINE { return false; }
  // the edit bay is inside Sniper, and only there (director.coax d_in_rover)
  if d_in_rover(g) { g[0].at_crate = false; g[0].mode = M_BAY; g[0].drag = -1; g[0].dr[0].bag = false; g[0].dr[0].map = false; snd_bay(g); return true; }
  return false;
}
// Put what you carry on the timeline: hardware into its slot, a card onto the strip (at a slot, or the next free one).
g_place :: (g: [] SpGame, item: int, at: int) {
  if item < 0 || item > H_PLUS || !g[0].have[item] { return; }
  snd_play(g, SND_SLOT_CLICK);
  if item <= H_BATTERY {
    g[0].slot[item] = true;
    if !g[0].bot && g[0].slot[0] && g[0].slot[1] && g[0].slot[2] { g[0].bot = true; g_bot_home(g); }   // built: it follows you from now on
    return;
  }
  if at >= 0 && at < g[0].strip_n { g[0].strip[at] = item; return; }
  if g[0].strip_n < 3 { g[0].strip[g[0].strip_n] = item; g[0].strip_n += 1; }
}
g_take :: (g: [] SpGame, i: int) {
  g[0].taken[i] = true; g[0].last_pick = i;
  if i >= PICK_CELL { g[0].cells += 1; g_say(g, MSG_CELL); return; }
  if i < PICK_PLUS { g[0].have[i] = true; g_say(g, MSG_PICK); return; }
  // the one blue piece: the special part, banned tech
  g[0].have[H_PLUS] = true; g[0].heat = lo(T_HEAT_MAX, g[0].heat + T_HEAT_PIECE); g_say(g, MSG_PICK);
}
g_foe_near :: (g: [] SpGame) -> int {
  best := -1; bd := T_STUN_RANGE;
  if g[0].zone != Z_MINE { return -1; }
  for i: 0..<FOES { if g_foe_in(g, i) { d := dist2(g[0].px, g[0].pz, g[0].fx[i], g[0].fz[i]); if d < bd { bd = d; best = i; } } }
  return best;
}
// F: stun a weak point of the banned bot, or a robot within 2 m: it stands still for T_FOE_STUN.
// Fights are Digger's now (director.coax: a left click points him at a foe).
g_stun :: (g: [] SpGame) {
  if sb_stun(g) { return; }   // the boss's weak points, the raider mech (splice-battle.coax)
  f := g_foe_near(g);
  if f < 0 { return; }
  g[0].fstag[f] = T_FOE_STUN; g[0].flash = 0.2; d_say(g, DS_STUN);
  if g[0].shit_n < SPS_HITS { g[0].shit[g[0].shit_n] = f; g[0].shit_n += 1; }   // its script hears of it (on_hit)
}
// E: interact. Tow a powered-down Digger, go through a portal, take the banned core, board the rover
// at the ping. Parts are Digger's to pick up (director.coax); the edit bay is Tab, inside Sniper.
g_use :: (g: [] SpGame) {
  if d_use(g) { return; }
  if sb_use(g) { return; }   // a core swap, the drill mech, the hallway, a battle from Sniper (splice-battle.coax)
  // a portal of the world's (a vehicle's door into a room, the room's door out): through it
  w := g_portal(g);
  if w >= 0 { _ := dv_through(g, w); return; }   // a door, or a drive (drive.coax)
  if g[0].zone == Z_MINE && g[0].boss_down && !g[0].core_taken && dist2(g[0].px, g[0].pz, sb_core_at(g).x, sb_core_at(g).z) < T_PICK_RANGE { g[0].core_taken = true; g[0].have[H_CORE] = true; g_say(g, MSG_CORE); return; }
  if g[0].zone == Z_RAIL && near_rover(g, T_USE_RANGE) { if g[0].have[H_BATTERY] { g[0].mode = M_RIDE; } else { g_say(g, MSG_FIRST); } return; }
}
// A key the page uses returns true (the browser then keeps it from scrolling or moving focus).
g_key :: (g: [] SpGame, key: int, down: bool) -> bool {
  if fr_front(g) { return down && fr_key(g, key); }   // the title, creation and credits screens (front.coax)
  if sb_ride_key(g, key, down) { return true; }   // on the drive: E battles the raider mech, 1 to 4 are Sniper's cards (splice-battle.coax)
  if g[0].mode == M_DRIVE { if down && (key == ' ' || key == -2) { dv_arrive(g); } return true; }   // Space or Enter: there now
  mine := d_key(g, key, down);   // the Director's keys first: Shift, Q, I, M, Esc, 1 to 4 (director.coax)
  if mine >= 0 { return mine == 1; }
  if key == 'w' || key == 'W' || key == -6 { g[0].fwd = down; return true; }
  if key == 's' || key == 'S' || key == -7 { g[0].back = down; return true; }
  if key == 'a' || key == 'A' { g[0].left = down; return true; }
  if key == 'd' || key == 'D' { g[0].right = down; return true; }
  if key == -4 { g[0].turn_l = down; return true; }
  if key == -5 { g[0].turn_r = down; return true; }
  if key == ' ' { g[0].jump = down; g_jump_key(g, down); if g[0].mode == M_PLAY { return true; } }   // on foot you jump, on the board it hops
  if !down { return false; }
  enter := key == -2 || key == ' ';
  if sb_restored_key(g, key) { return true; }   // SCENE RESTORED goes on to the mission's teaser
  if g[0].mode == M_RESTORED { if enter || key == 'r' || key == 'R' { g_reset(g); g_begin(g); return true; } return false; }
  if g[0].mode == M_MEMORY { g[0].mode = M_RESTORED; return true; }
  if g[0].mode == M_BAY {
    if key == -15 || key == -1 || key == 'e' || key == 'E' { g[0].mode = M_PLAY; g[0].look_free = false; return true; }
    if key == '1' { g_place(g, H_MOVE, -1); return true; }
    if key == '2' { g_place(g, H_DRILL, -1); return true; }
    if key == '3' { g_place(g, H_PLUS, -1); return true; }
    if key == '4' { g_place(g, H_ARM, -1); return true; }
    if key == '5' { g_place(g, H_TREADS, -1); return true; }
    if key == '6' { g_place(g, H_BATTERY, -1); return true; }
    if key == 'c' || key == 'C' || key == -3 { g[0].strip_n = 0; return true; }
    if key == 'x' || key == 'X' { if g[0].have[H_CORE] { g[0].mode = M_MEMORY; g[0].mem_t = 0; g_event(g, EV_SPLICE_CORE); } return true; }
    if enter { g_deploy(g); return true; }
    return false;
  }
  if g[0].mode == M_PLAY {
    if key == 'e' || key == 'E' { g_use(g); return true; }
    if key == -15 { return g_open_bay(g) || true; }
    if key == 'f' || key == 'F' { g_stun(g); return true; }
  }
  return false;
}
in_box :: (b: [] f32, o: int, x: f32, y: f32) -> bool { return x >= b[o] && x <= b[o + 2] && y >= b[o + 1] && y <= b[o + 3]; }
g_pointer :: (g: [] SpGame, x: f32, y: f32, phase: int) -> bool {
  if fr_front(g) { return fr_pointer(g, x, y, phase); }
  if d_pointer(g, x, y, phase) { return true; }   // pause, the grid, and pointing Digger (director.coax)
  if g[0].mode == M_BAY {
    // drag a part or a card from its list onto the timeline; a click with no drag places it too
    if phase == 1 && g[0].drag >= 0 { if abs(x - g[0].drag_x) + abs(y - g[0].drag_y) > 6 { g[0].drag_far = true; } g[0].drag_x = x; g[0].drag_y = y; return true; }
    if (phase == 2 || phase == 3) && g[0].drag >= 0 {
      item := g[0].drag; g[0].drag = -1;
      if !g[0].drag_far { g_place(g, item, -1); return true; }
      for i: 0..<6 {
        if !in_box(g[0].drop[..], i * 4, x, y) { continue; }
        if i < 3 && item == i { g_place(g, item, -1); }
        if i >= 3 && item >= H_MOVE { g_place(g, item, i - 3); }
      }
      return true;
    }
  }
  if phase != 0 { return false; }
  if g[0].mode == M_MEMORY || g[0].mode == M_RESTORED { return g_key(g, -2, true); }
  if g[0].mode == M_PLAY || g[0].mode == M_RIDE { g[0].look_free = false; return false; }   // a click takes the pointer back for looking
  for i: 0..<g[0].btn_n {
    if !in_box(g[0].btn[..], i * 4, x, y) { continue; }
    k := g[0].btn_key[i];
    if k >= 1000 { g[0].drag = k - 1000; g[0].drag_x = x; g[0].drag_y = y; g[0].drag_far = false; return true; }
    return g_key(g, k, true);
  }
  return false;
}
// Mouse look: the pointer is held while you walk (2) and free in menus and the edit bay (1).
g_mouselook :: (g: [] SpGame) -> int { return ifx (g[0].mode == M_PLAY || g[0].mode == M_RIDE) && !g[0].look_free && !d_cursor(g) then 2 else 1; }
g_look :: (g: [] SpGame, dx: f32, dy: f32) {
  if g[0].mode != M_PLAY && g[0].mode != M_RIDE { return; }
  if d_wheel_look(g, dx, dy) { return; }   // Hold R: the pointer picks on the bot wheel (director.coax)
  g[0].yaw -= dx * T_LOOK; g[0].pitch = clamp(g[0].pitch + dy * T_LOOK, -0.35, 0.7);
}
g_lock :: (g: [] SpGame, status: int) { d_lock(g, status); g[0].look_free = status != 1; }

// A moment of the run to stand in (the page's message 610, "N"): for stills and checks of each beat.
g_stage :: (g: [] SpGame, n: int) { g_stage_set(g, n); if g[0].bot { g_bot_home(g); } sb_stage(g, n); dv_stage(g, n); }
g_stage_set :: (g: [] SpGame, n: int) {
  g_reset(g); g[0].mode = M_PLAY;
  if n == 0 { g[0].mode = M_TITLE; return; }
  if n == 1 { return; }
  if n == 2 { g[0].pz = g[0].at.scan_z + 0.2; g[0].pass_t = T_PASS; return; }
  if n == 3 { g[0].zone = Z_RAIL; g[0].mode = M_RIDE; g[0].phase = PH_DAY; g[0].rail_s = 60; return; }
  if n == 4 { g[0].zone = Z_RAIL; g[0].phase = PH_DAY; g[0].rail_s = T_RAIL_PING; g[0].pinged = true; c := rail_at(g, T_RAIL_PING); g[0].px = c.x + 9; g[0].pz = c.z + 8; g[0].yaw = 0.7; g_say(g, MSG_PING); return; }
  g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true; g[0].pinged = true;
  g_enter_mine(g);
  if n == 5 { return; }
  for i: 0..<5 { g[0].have[i] = true; g[0].taken[i] = true; }
  if n == 6 { g[0].slot[0] = true; g[0].strip[0] = H_MOVE; g[0].strip_n = 1; g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z; g[0].mode = M_BAY; return; }
  for i: 0..<3 { g[0].slot[i] = true; }
  g[0].bot = true; g[0].strip[0] = H_MOVE; g[0].strip[1] = H_DRILL; g[0].strip_n = 2; g_keep(g);
  g[0].rubble_gone = true; g[0].phase = PH_DUSK; g[0].px = 0; g[0].pz = -29;
  if n == 7 { return; }
  g[0].phase = PH_NIGHT; g[0].px = g[0].at.dance_x + 7; g[0].pz = g[0].at.dance_z + 7; g[0].yaw = PI + 0.5; g[0].scrap = 2; g[0].cells = 1; g[0].taken[PICK_CELL] = true; g[0].heat = 20;
  if n == 8 { return; }
  g[0].taken[PICK_PLUS] = true; g[0].have[H_PLUS] = true; g[0].heat = 45; g[0].px = g[0].at.crate_x + 3; g[0].pz = g[0].at.crate_z; g[0].strip[1] = H_PLUS;
  if n == 9 { g[0].at_crate = true; g[0].mode = M_BAY; return; }
  g[0].wall_gone = true; g[0].px = 1.5; g[0].pz = g[0].at.wall_z - 2.5; g[0].yaw = PI; g[0].heat = 40; g[0].boss_t = T_SWEEP_EVERY - 0.3; g[0].stun[0] = 8;
  if n == 10 { return; }
  if n == 11 { g[0].have[H_CORE] = true; g[0].mode = M_MEMORY; g[0].mem_t = 6; }
  if n == 12 { g[0].mode = M_RESTORED; g[0].mem_t = T_MEMORY; }
  if n == 13 { g[0].mode = M_BANNER; g[0].banner = B_SWEEP; g[0].banner_t = 100; }
  if n == 14 { g[0].mode = M_BANNER; g[0].banner = B_CUT; g[0].banner_t = 100; }
  if n == 15 { g[0].px = g[0].at.deck_x + 1.5; g[0].pz = (g[0].at.deck_z0 + g[0].at.deck_z1) * 0.5; g[0].yaw = PI; }
  if n >= 16 { g[0].wall_gone = false; g[0].have[H_PLUS] = false; g[0].taken[PICK_PLUS] = false; g[0].heat = 20; }
  if n == 16 { ga_look_into(g, 19); }                                         // the vault bay (G2) and its one blue piece
  if n == 17 { ga_look_into(g, 23); }                                         // the bar bay (HA)
  if n == 18 { g[0].px = g[0].at.dance_x + 12; g[0].pz = g[0].at.dance_z + 14; g[0].yaw = PI + 0.7; }   // the rave: stage, DJ, dance floor
  if n == 19 { ga_look_into(g, 4); }                                          // the lounge bay (B2)
}

// ---- The world, written once
// A place beside the dance floor: the rave was laid out round a floor at (-1.6, -51.2), and stands round
// the floor's landmark wherever it is now.
dn :: (g: [] SpGame, x: f32, y: f32, z: f32) -> Point { return v3(g[0].at.dance_x + x + 1.6, y, g[0].at.dance_z + z + 51.2); }
dn_block :: (g: [] SpGame, buf: [] u32, p: [] Pen, x: f32, y0: f32, z: f32, hx: f32, h: f32, hz: f32) { c := dn(g, x, y0, z); block(buf, p, c.x, y0, c.z, hx, h, hz); }
g_world :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  kit_pen(p, 1, MAT_WORLD, t3(0.90, 0.68, 0.48));
  quad(buf, p, v3(-260, 0, -480), v3(280, 0, -480), v3(280, 0, 520), v3(-260, 0, 520));
  kit_mesas(buf, p, 2, t3(0.72, 0.56, 0.74), 9, 40, 92, 26, 14, 30);
  kit_dunes(buf, p, 3, t3(0.93, 0.74, 0.50), 12, 50, 40, 28, 60, 5, 11);
  kit_rocks(buf, p, 4, t3(0.66, 0.36, 0.28), 14, 60, 0, 8, 5, 16, 0.3, 1.0);
  kit_mesas(buf, p, 5, t3(0.62, 0.46, 0.60), 11, 140, -470, 36, 40, 70);   // the mountain past the garage, where the hallway goes
  for i: 0..<g[0].wall_n {
    o := i * 5; h := g[0].walls[o + 4];
    if h < 1 { continue; }
    deep := g[0].walls[o + 3] <= -40;
    face := ifx deep then t3(0.62, 0.42, 0.56) else t3(0.84, 0.46, 0.32);
    band := ifx deep then t3(0.50, 0.32, 0.50) else t3(0.72, 0.34, 0.26);
    kit_wall(buf, p, 6 + (i % 4) * 2, face, band, g[0].walls[o], g[0].walls[o + 1], g[0].walls[o + 2], g[0].walls[o + 3], h, cast(f32) i * 17);
  }
  ga_draw(g, buf, p);   // the garage: the field, the ring of lettered bays, the rim, the hallway and the lab (garage.coax)
  // the rover (the hidden edit bay) parked at the mine, the checkpoint post, the stash crate
  cast_rover(buf, p, frame_at(v3(g[0].at.rover_x, 0, g[0].at.rover_z), 0.2), 1.5, 180, 0, cast_colour());
  kit_pen(p, 25, MAT_SKIN, t3(0.93, 0.88, 0.76));
  tube(buf, p, frame_at(v3(g[0].at.post_x, 0, g[0].at.post_z), 0), 3.2, 0.14, 0.14, 0.1, 0.1, 8, true);
  kit_pen(p, 26, MAT_GLOW, t3(1.0, 0.72, 0.30));
  ball(buf, p, v3(g[0].at.post_x, 3.4, g[0].at.post_z), 0.3, 10);
  kit_crate(buf, p, frame_at(v3(g[0].at.crate_x, 0, g[0].at.crate_z), 0), 27, t3(0.70, 0.52, 0.36), INK(), GLOW(), 1.5);
  kit_rocks(buf, p, 30, t3(0.52, 0.36, 0.34), 14, 70, 0, -17, 5, 8.2, 0.4, 1.1);
  // the work bay's catwalk (section C1): a deck along the bay, a ramp at each end, a rail between them
  kit_pen(p, 32, MAT_WORLD, t3(0.48, 0.36, 0.44));
  block(buf, p, g[0].at.deck_x + 2, 0, (g[0].at.deck_z0 + g[0].at.deck_z1) * 0.5, 2, DECK_Y, (g[0].at.deck_z1 - g[0].at.deck_z0) * 0.5);
  for i: 0..<2 {
    z0 := ifx i == 0 then g[0].at.deck_z0 else g[0].at.deck_z1 - RAMP; z1 := z0 + RAMP;
    quad(buf, p, v3(g[0].at.deck_x - 3, 0.02, z0), v3(g[0].at.deck_x - 3, 0.02, z1), v3(g[0].at.deck_x, DECK_Y, z1), v3(g[0].at.deck_x, DECK_Y, z0));
  }
  kit_pen(p, 33, MAT_CLOTH, INK());
  for i: 0..<7 { tube(buf, p, frame_at(v3(g[0].at.deck_x, DECK_Y, g[0].at.deck_z0 + RAMP + cast(f32) i * 2.0), 0), 1.0, 0.06, 0.06, 0.06, 0.06, 6, true); }
  block(buf, p, g[0].at.deck_x, DECK_Y + 0.95, (g[0].at.deck_z0 + g[0].at.deck_z1) * 0.5, 0.05, 0.08, (g[0].at.deck_z1 - g[0].at.deck_z0) * 0.5 - RAMP);
  // the rave in the middle of the field: the main stage on the floor's west side, the DJ's booth, speaker
  // stacks and a truss of lamps (dn: a place beside the dance floor)
  kit_pen(p, 35, MAT_CLOTH, t3(0.14, 0.11, 0.18));
  dn_block(g, buf, p, -13.25, 0, -51.5, 1.75, 1.0, 5.5);
  kit_pen(p, 36, MAT_WORLD, t3(0.30, 0.22, 0.36));
  dn_block(g, buf, p, -12.6, 1.0, -51.5, 0.5, 1.0, 1.6);
  kit_pen(p, 38, MAT_GLOW, t3(0.36, 0.86, 0.96));
  dn_block(g, buf, p, -12.05, 1.2, -51.5, 0.03, 0.6, 1.4);
  for i: 0..<2 {
    z := ifx i == 0 then -47.0f32 else -56.0f32;
    kit_pen(p, 35, MAT_CLOTH, INK());
    dn_block(g, buf, p, -13.2, 1.0, z, 1.0, 3.4, 0.8);
    kit_pen(p, 36, MAT_GLOW, t3(1.0, 0.36, 0.62));
    ball(buf, p, dn(g, -12.2, 3.6, z), 0.5, 10); ball(buf, p, dn(g, -12.2, 2.1, z), 0.6, 10);
  }
  kit_pen(p, 39, MAT_CLOTH, INK());
  dn_block(g, buf, p, -12.5, 6.4, -51.5, 0.12, 0.12, 5.5);
  for i: 0..<6 { kit_pen(p, 34, MAT_GLOW, ifx i % 2 == 0 then t3(1.0, 0.36, 0.62) else t3(0.36, 0.86, 0.96)); ball(buf, p, dn(g, -12.5, 6.1, -56 + cast(f32) i * 1.8), 0.26, 8); }
  // the vault bay: a plinth for the one blue piece, and a ring of pylons round it
  kit_pen(p, 75, MAT_WORLD, t3(0.26, 0.22, 0.38));
  block(buf, p, pick_x(g, PICK_PLUS), 0, pick_z(g, PICK_PLUS), 0.7, 0.45, 0.7);
  for i: 0..<4 { kit_pen(p, 76, MAT_GLOW, GLOW_INK()); tube(buf, p, frame_at(v3(pick_x(g, PICK_PLUS) - 1.2 + cast(f32) (i % 2) * 2.4, 0, pick_z(g, PICK_PLUS) - 1.2 + cast(f32) (i / 2) * 2.4), 0), 3.0, 0.1, 0.1, 0.1, 0.1, 6, true); }
  // the blue glow: a beam over the boss chamber, seen from the passage
  kit_pen(p, 37, MAT_GLOW, GLOW());
  tube(buf, p, frame_at(v3(g[0].at.boss_x, 8, g[0].at.boss_z), 0), 60, 0.5, 0.5, 0.2, 0.2, 8, false);
  // the edit bay's stage: a paper floor and backdrop the Digger stands on
  kit_pen(p, 40, MAT_FLAT, PAPER());
  block(buf, p, g[0].at.bay_x, 0, g[0].at.bay_z, 11, 0.05, 11);
  kit_pen(p, 41, MAT_FLAT, SHADE());
  block(buf, p, g[0].at.bay_x, 0, g[0].at.bay_z - 6, 14, 12, 0.3); block(buf, p, g[0].at.bay_x - 8, 0, g[0].at.bay_z, 0.3, 12, 14); block(buf, p, g[0].at.bay_x + 8, 0, g[0].at.bay_z, 0.3, 12, 14);
  // the memory's stage: the old world's factory floor, in the dark
  kit_pen(p, 42, MAT_FLAT, t3(0.03, 0.06, 0.14));
  block(buf, p, g[0].at.mem_x, 0, g[0].at.mem_z, 34, 0.05, 16); block(buf, p, g[0].at.mem_x, 0, g[0].at.mem_z - 14, 40, 22, 0.4);
  kit_pen(p, 43, MAT_GLOW, GLOW_INK());
  for i: 0..<9 { k := cast(f32) i; block(buf, p, g[0].at.mem_x - 16 + k * 4, 0.05, g[0].at.mem_z, 0.04, 0.02, 13); block(buf, p, g[0].at.mem_x, 0.05, g[0].at.mem_z - 12 + k * 3, 28, 0.02, 0.04); }
  for i: 0..<4 { k := cast(f32) i; block(buf, p, g[0].at.mem_x - 12 + k * 8, 0, g[0].at.mem_z - 9, 1.2, 9, 1.2); }
  // the dome village: a ring of wall panels (one left open for the gate), a faceted roof, a bed,
  // and the gate's corridor with its scanner beam
  wall := t3(0.93, 0.88, 0.78); trim := t3(0.55, 0.72, 0.62);
  for i: 1..<12 {
    a := cast(f32) i * TAU / 12;
    kit_pen(p, 46 + (i % 2), MAT_WORLD, ifx i % 2 == 0 then wall else t3(0.88, 0.82, 0.72));
    box(buf, p, frame_at(v3(g[0].at.vil_x + sin(a) * g[0].at.vil_r, 1.7, g[0].at.vil_z + cos(a) * g[0].at.vil_r), a), 1.95, 1.7, 0.2);
  }
  kit_pen(p, 48, MAT_SKIN, trim);
  tube(buf, p, frame_at(v3(g[0].at.vil_x, 3.4, g[0].at.vil_z), 0), 3.6, g[0].at.vil_r + 0.5, g[0].at.vil_r + 0.5, 0.6, 0.6, 12, true);
  kit_pen(p, 49, MAT_FLOOR, t3(0.80, 0.70, 0.58));
  quad(buf, p, v3(g[0].at.vil_x - 8, 0.02, g[0].at.vil_z - 8), v3(g[0].at.vil_x + 8, 0.02, g[0].at.vil_z - 8), v3(g[0].at.vil_x + 8, 0.02, g[0].at.vil_z + 14), v3(g[0].at.vil_x - 8, 0.02, g[0].at.vil_z + 14));
  kit_pen(p, 50, MAT_CLOTH, t3(0.76, 0.34, 0.20));
  block(buf, p, g[0].at.vil_x - 3.5, 0, g[0].at.vil_z - 3.5, 1.0, 0.5, 1.9);
  kit_pen(p, 51, MAT_SKIN, wall);
  block(buf, p, g[0].at.vil_x - 3.5, 0.5, g[0].at.vil_z - 4.8, 0.7, 0.18, 0.4);
  kit_crate(buf, p, frame_at(v3(g[0].at.vil_x + 3.6, 0, g[0].at.vil_z - 3), 0.4), 52, t3(0.70, 0.52, 0.36), INK(), t3(1.0, 0.72, 0.30), 1.2);
  kit_pen(p, 56, MAT_WORLD, wall);
  block(buf, p, g[0].at.vil_x - 1.9, 0, g[0].at.vil_z + 9.2, 0.25, 3.4, 2.6); block(buf, p, g[0].at.vil_x + 1.9, 0, g[0].at.vil_z + 9.2, 0.25, 3.4, 2.6);
  block(buf, p, g[0].at.vil_x, 3.0, g[0].at.vil_z + 9.2, 2.15, 0.4, 2.6);
  kit_pen(p, 57, MAT_GLOW, t3(0.40, 0.90, 0.70));
  for i: 0..<7 { block(buf, p, g[0].at.vil_x, 0.3 + cast(f32) i * 0.4, g[0].at.scan_z, 1.65, 0.05, 0.03); }   // the beam: thin bars you can see through
  // the rail line: sleepers and two rails for T_RAIL metres, a marker post at the sensor ping
  for i: 0..<100 {
    s := cast(f32) i * 3; c := rail_at(g, s);
    kit_pen(p, 58, MAT_CLOTH, t3(0.40, 0.28, 0.24));
    box(buf, p, frame_at(v3(c.x, 0.06, c.z), rail_yaw(g, s)), 1.5, 0.06, 0.22);
  }
  kit_pen(p, 59, MAT_SKIN, t3(0.60, 0.60, 0.66));
  for i: 0..<50 {
    s := cast(f32) i * 6; a := rail_at(g, s); b := rail_at(g, s + 6); y := rail_yaw(g, s + 3);
    for side: 0..<2 {
      o := ifx side == 0 then -1.0f32 else 1.0f32;
      limb(buf, p, v3(a.x + cos(y) * o, 0.16, a.z - sin(y) * o), v3(b.x + cos(y) * o, 0.16, b.z - sin(y) * o), 0.07, 0.07, v3(0, 1, 0), 4);
    }
  }
  kit_mesas(buf, p, 60, t3(0.86, 0.50, 0.40), 5, 90, 270, 30, 12, 26);
  kit_dunes(buf, p, 62, t3(0.93, 0.74, 0.50), 10, 110, 16, 0, 240, 4, 9);
  kit_rocks(buf, p, 63, t3(0.66, 0.36, 0.28), 20, 120, pick_x(g, H_BATTERY), pick_z(g, H_BATTERY), 3, 14, 0.3, 1.2);
  kit_pen(p, 64, MAT_SKIN, t3(0.93, 0.88, 0.76));
  tube(buf, p, frame_at(v3(pick_x(g, H_BATTERY) + 1.2, 0, pick_z(g, H_BATTERY) + 0.8), 0), 2.6, 0.1, 0.1, 0.07, 0.07, 6, true);
  kit_pen(p, 65, MAT_GLOW, HEAT());
  ball(buf, p, v3(pick_x(g, H_BATTERY) + 1.2, 2.8, pick_z(g, H_BATTERY) + 0.8), 0.26, 10);
}

// ---- What moves, written every frame
g_draw_rover :: (buf: [] u32, p: [] Pen, at: Point, yaw: f32) {
  cast_rover(buf, p, frame_at(at, yaw), 1.5, 150, at.x + at.z, cast_colour());   // the wheels turn as it travels
}
g_live :: (g: [] SpGame, buf: [] u32, p: [] Pen) {
  t := g[0].t; blue := GLOW();
  g[0].thing_n = 0;
  if fr_front(g) { fr_live(g, buf, p); return; }
  if g[0].mode == M_MEMORY { sb_memory_live(g, buf, p); return; }   // the hologram (splice-battle.coax)
  if g[0].mode == M_BAY {
    // the Digger on the bay's stage, wearing the hardware spliced into it
    cast_digger(buf, p, frame_at(v3(g[0].at.bay_x, 0.05, g[0].at.bay_z), 0.7 + sin(t * 0.5) * 0.25), 1.15, 50, ifx g[0].have[H_PLUS] then blue else CAST_AMBER(),
                g[0].slot[0], g[0].slot[1], g[0].slot[2], t * 3, cast_colour());
    return;
  }
  if g[0].mode == M_DRIVE { dv_draw(g, buf, p); return; }
  if g[0].zone == Z_RAIL {
    c := rail_at(g, g[0].rail_s);
    rk := g_thing(g, p, TK_ROVER, 0, frame_at(v3(c.x, 0.2, c.z), rail_yaw(g, g[0].rail_s)), 1.5, g[0].rail_s);
    if rk >= 0 { g_draw_rover(buf, p, v3(c.x, 0.2, c.z), rail_yaw(g, g[0].rail_s)); g_thing_end(g, p, rk); }
    if !g[0].taken[H_BATTERY] {
      at := v3(pick_x(g, H_BATTERY), 0.75 + sin(t * 2.2) * 0.12, pick_z(g, H_BATTERY));
      kit_pen(p, 72, MAT_SKIN, t3(1.0, 0.72, 0.30)); box(buf, p, frame_at(at, t * 1.2), 0.26, 0.34, 0.2);
    }
    if g[0].mode == M_RIDE { sb_live(g, buf, p); return; }   // the raider mech on the drive
    if g[0].bot { cast_digger(buf, p, frame_at(v3(g[0].bot_x, 0, g[0].bot_z), g[0].bot_yaw), 0.85, 190, d_tint(g, CAST_AMBER()), true, true, true, 0, cast_colour()); }
  }
  // the smuggler
  y := g_feet_y(g);
  blink := g[0].hit_cool > 0 && fract(t * 8) < 0.5;
  if !blink {
    // the smuggler: listed here, drawn as your character from its walk poses in the piece store (front.coax fr_player)
    pf := frame_at(v3(g[0].px, y, g[0].pz), g_face(g));
    bd := g[0].board[0]; riding := g_riding(g);
    if riding {
      // on the board: its deck hovers and bobs, the nose lifts as it speeds up, and the rider leans into the carve
      df := frame_turn(frame_turn(frame_at(v3(g[0].px, y + board_lift(bd), g[0].pz), g[0].yaw), 2, bd.lean), 0, -bd.nose);
      pf = kit_at(df, 0, 0.075, 0);
    }
    sk := g_thing(g, p, TK_SMUGGLER, 0, pf, 0.85, g[0].stride);
    // the board under you, in the live store (the character stands on it: fr_player lifts it by the hover)
    if riding && sk >= 0 { kit_hoverboard(buf, p, frame_move(pf, fp(pf, 0, -0.075, 0)), 1, 196, INK(), HEAT(), blue, bd.rush + 0.15); }
    g_thing_end(g, p, sk);
  }
  sb_live(g, buf, p);   // the drill mech, the raider mech, the boss (splice-battle.coax)
  if g[0].zone != Z_MINE { return; }
  if g[0].have[H_CORE] { kit_pen(p, 66, MAT_GLOW, blue); ball(buf, p, v3(g[0].px - sin(g[0].yaw) * 0.45, y + 1.2, g[0].pz - cos(g[0].yaw) * 0.45), 0.24, 10); }
  // pickups: hardware in sand and orange, cards as film frames, banned tech glowing blue
  for i: 0..<PICKS {
    if g[0].taken[i] || pick_zone(i) != Z_MINE { continue; }
    at := v3(pick_x(g, i), ground_y(g, pick_x(g, i), pick_z(g, i)) + 0.75 + sin(t * 2.2 + cast(f32) i) * 0.12, pick_z(g, i));
    f := frame_at(at, t * 1.2 + cast(f32) i);
    pk := g_thing(g, p, TK_PICKUP, i, f, 1, t);
    if pk < 0 { continue; }
    if i == PICK_PLUS { f = frame_move(f, v3(at.x, at.y + 0.55, at.z)); kit_pen(p, 70 + i, MAT_GLOW, blue); box(buf, p, frame_turn(f, 0, 0.6), 0.3, 0.3, 0.3); }
    else if i >= PICK_CELL { kit_pen(p, 70 + i, MAT_GLOW, t3(1.0, 0.72, 0.30)); box(buf, p, f, 0.14, 0.26, 0.14); kit_pen(p, 80 + i, MAT_CLOTH, INK()); box(buf, p, kit_at(f, 0, 0.3, 0), 0.07, 0.05, 0.07); }
    else if i >= H_MOVE {
      kit_pen(p, 70 + i, MAT_FLAT, INK()); box(buf, p, f, 0.42, 0.3, 0.03);
      kit_pen(p, 80 + i, MAT_FLAT, PAPER()); box(buf, p, f, 0.3, 0.2, 0.04);
    } else {
      kit_pen(p, 70 + i, MAT_SKIN, t3(0.93, 0.88, 0.76));
      if i == H_ARM { tube(buf, p, frame_turn(f, 0, 1.2), 0.9, 0.3, 0.3, 0.02, 0.02, 6, true); } else { box(buf, p, f, 0.2, 0.28, 0.6); }
    }
    g_thing_end(g, p, pk);
  }
  d_live(g, buf, p);   // the better sensor (director.coax)
  // the rubble and the boss wall, until the Digger opens them
  if !g[0].rubble_gone {
    kit_pen(p, 90, MAT_WORLD, t3(0.56, 0.36, 0.28));
    for i: 0..<25 { k := cast(f32) i; ellipsoid(buf, p, frame_at(v3(-2.6 + cast(f32) (i % 5) * 1.3, 0.6 + cast(f32) (i / 5) * 1.25, g[0].at.rubble_z + (kit_rand(k) - 0.5) * 0.8), kit_rand(k + 5) * 6), 0.85, 0.72, 0.8, 7, 4, 0); }
  }
  if !g[0].wall_gone {
    kit_pen(p, 92, MAT_WORLD, t3(0.34, 0.26, 0.40)); block(buf, p, 0, 0, g[0].at.wall_z, 4, 9, 1);
    kit_pen(p, 93, MAT_GLOW, blue);
    for i: 0..<3 { block(buf, p, -2.4 + cast(f32) i * 2.4, 1 + cast(f32) i * 1.6, g[0].at.wall_z + 1.02, 0.07, 2.4, 0.02); }
  }
  if g[0].bot {
    shake := ifx g[0].bot_state == BOT_FAIL then sin(t * 40) * 0.06 else 0.0f32;
    df := frame_at(v3(g[0].bot_x + shake, ground_y(g, g[0].bot_x, g[0].bot_z), g[0].bot_z), g[0].bot_yaw);
    dk := g_thing(g, p, TK_DIGGER, ifx g[0].have[H_PLUS] then 1 else 0, df, 0.85, t);
    if dk >= 0 {
    cast_digger(buf, p, df, 0.85, 190, d_tint(g, ifx sb_holds_digger(g) && sb_fielded(g) != SB_DIGGER then t3(0.32, 0.32, 0.34) else ifx g[0].have[H_PLUS] then blue else CAST_AMBER()), true, true, true, g[0].bot_spin, cast_colour());   // his lights go dark while his core is in the drill mech
    g_thing_end(g, p, dk); }
  }
  // the party's people: raiders dancing where they stand, Imperial robots on patrol
  for i: 0..<FOES {
    if !g_foe_in(g, i) { continue; }
    face := atan2(g[0].px - g[0].fx[i], g[0].pz - g[0].fz[i]);
    fy := ground_y(g, g[0].fx[i], g[0].fz[i]);
    reel := ifx g[0].fstag[i] > 0 then sin(t * 50) * 0.08 else 0.0f32;
    pose := g[0].fpose[i];
    if i < F_RAIDERS {
      // a raider: dancing (a bounce and a sway) until someone starts a fight, or as its plan says: asleep on
      // its back, standing, or walking where it faces
      dance := !g[0].fhost[i] && !g[0].fflee[i] && pose == MP_DANCE;
      beat := t * 7.5 + cast(f32) i * 1.3;
      f := frame_at(v3(g[0].fx[i] + reel, fy + (ifx dance then abs(sin(beat)) * 0.22 else 0.0f32), g[0].fz[i]), ifx dance then sin(beat * 0.5) * 0.9 + cast(f32) i else ifx g[0].fhost[i] then face else g[0].fyaw[i]);
      if pose == MP_SLEEP && !g[0].fhost[i] && !g[0].fflee[i] { f = g_lying(v3(g[0].fx[i], fy + 0.18, g[0].fz[i]), g[0].fyaw[i]); }
      still := pose == MP_SLEEP || pose == MP_STAND;
      fk := g_thing(g, p, TK_RAIDER, ifx g[0].fhost[i] then 1 else 0, f, 0.95, ifx dance then beat else ifx still then 0.0f32 else t * 9);
      if fk >= 0 {
      cast_raider(buf, p, f, 0.95, 100 + i * 5, ifx g[0].fhost[i] then t3(1.0, 0.30, 0.12) else t3(1.0, 0.36, 0.62), ifx dance then beat else ifx still && !g[0].fhost[i] then 0.0f32 else t * 9, cast_colour());
      g_thing_end(g, p, fk); }
    } else {
      // an Imperial robot: white plates, an orange band, a red eye once it has seen you; it faces where it walks
      f := frame_at(v3(g[0].fx[i] + reel, fy, g[0].fz[i]), ifx g[0].fhost[i] then face else g[0].fyaw[i]);
      if pose == MP_SLEEP && !g[0].fhost[i] && !g[0].fflee[i] { f = g_lying(v3(g[0].fx[i], fy + 0.2, g[0].fz[i]), g[0].fyaw[i]); }
      ik := g_thing(g, p, TK_IMPERIAL, ifx g[0].fhost[i] then 1 else 0, f, 0.8, t);
      if ik >= 0 {
      kit_robot(buf, p, f, 0.8, 100 + i * 5, t3(0.92, 0.93, 0.96), HEAT(), ifx g[0].fhost[i] then t3(1.0, 0.22, 0.12) else t3(0.95, 0.95, 1.0), t3(0.20, 0.20, 0.28), ifx g[0].fhost[i] then 0.7 else 0.0f32);
      g_thing_end(g, p, ik); }
    }
  }
  // the editor's shown foe: its route as dots on the ground, its notice as a ring round it (?edit)
  if g[0].shown >= 0 && g[0].shown < FOES && g[0].fhp[g[0].shown] > 0 { g_plan_marks(g, buf, p, g[0].shown); }
  // the DJ at the booth, the dance floor's tiles changing colour on the beat, beams from the truss
  dj := frame_at(dn(g, -13.6, 1.0 + abs(sin(t * 7.5)) * 0.12, -51.5), PI * 0.5);
  jk := g_thing(g, p, TK_DJ, 0, dj, 1.2, t * 7.5);
  if jk >= 0 {
  kit_figure(buf, p, dj, 1.2, 160, t3(0.36, 0.86, 0.96), t3(0.90, 0.72, 0.58), INK(), t3(1.0, 0.36, 0.62), t * 7.5);
  g_thing_end(g, p, jk); }
  step := cast(int) (t * 1.9);
  for i: 0..<20 {
    c := (i + (i / 5) + step) % 3;
    kit_pen(p, 165 + (i % 3), MAT_GLOW, ifx c == 0 then t3(0.80, 0.22, 0.52) else ifx c == 1 then t3(0.20, 0.60, 0.74) else t3(0.42, 0.26, 0.66));
    dn_block(g, buf, p, -8 + cast(f32) (i % 5) * 3.2, 0.02, -56 + cast(f32) (i / 5) * 3.2, 1.5, 0.03, 1.5);
  }
  for i: 0..<4 {
    a := t * 0.9 + cast(f32) i * 1.6;
    kit_pen(p, 170 + i, MAT_GLOW, ifx i % 2 == 0 then t3(1.0, 0.36, 0.62) else t3(0.36, 0.86, 0.96));
    limb(buf, p, dn(g, -12.5, 6.1, -55 + cast(f32) i * 2.4), dn(g, -4 + sin(a) * 6, 0.1, -50 + cos(a * 0.7) * 5), 0.05, 0.3, v3(0, 1, 0), 6);
  }
}

// The party's lamps (up to eight point lights): the stage in magenta, the dance floor in cyan,
// each room in its own colour, and the blue glow of the vault and the boss chamber.
g_lights :: (g: [] SpGame, l: [] f32) {
  if g[0].zone != Z_MINE || (g[0].mode != M_PLAY && g[0].mode != M_BANNER) { return; }
  t := g[0].t; beat := 0.75 + 0.25 * abs(sin(t * 7.5));
  light_put(l, 0, dn(g, -10, 4, -51.5), 13, 1.0, 0.30, 0.62, 1.7 * beat);
  light_put(l, 1, dn(g, -1 + sin(t * 0.9) * 5, 3, -50 + cos(t * 0.63) * 4), 10, 0.30, 0.86, 0.96, 1.5 * beat);
  ga_lights(g, l);   // the bays nearest you (garage.coax)
  light_put(l, 4, v3(pick_x(g, PICK_PLUS), 2.2, pick_z(g, PICK_PLUS)), 10, 0.31, 0.70, 0.85, ifx g[0].taken[PICK_PLUS] then 0.5f32 else 2.0f32);
  light_put(l, 6, v3(g[0].at.boss_x, 4, g[0].at.boss_z + 3), 12, 0.31, 0.70, 0.85, 1.4);
  light_put(l, 7, v3(g[0].at.crate_x, 2, g[0].at.crate_z), 5, 0.31, 0.70, 0.85, 1.0);
}

// A body lying on its back where it stands, its head toward yaw.
g_lying :: (o: Point, yaw: f32) -> Frame {
  head := v3(sin(yaw), 0, cos(yaw)); up := v3(0, 1, 0);
  return Frame.{o = o, x = cross(head, up), y = head, z = up};
}
// The shown foe's plan, drawn in the scene for the editor: dots along its route (or round a wander's area),
// a post at each point, and a ring as far as it notices you.
g_plan_marks :: (g: [] SpGame, buf: [] u32, p: [] Pen, i: int) {
  pl := sc_plan(g[0].c[..], i, g_phase(g));
  dots: [240] f32;
  kit_pen(p, 178, MAT_GLOW, GLOW());
  n := mp_dots(pl, 0.7, dots[..]);
  for k: 0..<n { block(buf, p, dots[k * 2], ground_y(g, dots[k * 2], dots[k * 2 + 1]) + 0.02, dots[k * 2 + 1], 0.09, 0.05, 0.09); }
  if pl.act != NPD_WANDER && pl.act != NPD_FOLLOW { for k: 0..<pl.n { x := mp_m(pl.x[k]); z := mp_m(pl.z[k]); block(buf, p, x, ground_y(g, x, z), z, 0.08, 1.1, 0.08); } }
  see := mp_notice(pl);
  if see > 0 {
    kit_pen(p, 179, MAT_GLOW, HEAT());
    n = mp_ring(g[0].fx[i], g[0].fz[i], see, 0.8, dots[..]);
    for k: 0..<n { block(buf, p, dots[k * 2], ground_y(g, dots[k * 2], dots[k * 2 + 1]) + 0.02, dots[k * 2 + 1], 0.07, 0.04, 0.07); }
  }
}

// ---- The camera and the look
g_camera :: (g: [] SpGame) -> CamNow {
  t := g[0].t;
  if g[0].mode == M_BAY { return CamNow.{eye = v3(g[0].at.bay_x + 3.4, 2.4, g[0].at.bay_z + 8.6), at = v3(g[0].at.bay_x, 0.6, g[0].at.bay_z), fov = 0.62}; }
  if g[0].mode == M_MEMORY || g[0].mode == M_RESTORED { return sb_memory_camera(g); }
  if fr_front(g) { return fr_camera(g); }   // the rover on the rail and the dolly past it (front.coax)
  if g[0].mode == M_DRIVE { return dv_camera(g); }   // outside the rover (drive.coax)
  if g[0].mode == M_RIDE {
    c := rail_at(g, g[0].rail_s); y := rail_yaw(g, g[0].rail_s);
    return CamNow.{eye = v3(c.x - sin(y) * 10, 4.6 + g[0].pitch * 4, c.z - cos(y) * 10), at = v3(c.x + sin(y) * 6, 2.0, c.z + cos(y) * 6), fov = 0.82};
  }
  y := g_cam_y(g) - d_crouch(g);   // sneaking, the view sinks
  bd := g[0].board[0]; riding := g_riding(g);
  if riding { y += board_lift(bd); }   // on the board you ride its hover
  head := v3(g[0].px, y + 1.7, g[0].pz);
  back := v3(-sin(g[0].yaw), 0, -cos(g[0].yaw));
  reach := (ifx g[0].zone == Z_VILLAGE then 4.0f32 else 6.5f32) + (ifx riding then board_back(bd) else 0.0f32);   // pulled back at speed
  for i: 1..<14 { d := cast(f32) i * 0.5; if d > reach { break; } if g_inside(g, head.x + back.x * d, head.z + back.z * d) || g_big_at(g, head.x + back.x * d, head.z + back.z * d, 0.8) { reach = hi(0.8, d - 0.6); break; } }
  lift := ifx g[0].zone == Z_VILLAGE then 0.18f32 else 0.33f32;
  // a big body ahead (the drill mech, the boss): the view rises to see over it (#13505 playtest)
  over := g_big_ahead(g, head.x, head.z, -back.x, -back.z);
  eye := v3(head.x + back.x * reach, y + 1.9 + reach * (lift + g[0].pitch * 0.6) + over * 4.5, head.z + back.z * reach);
  if riding {
    // the sense of speed: a wider view and a shake, from the engine's board
    k := board_shake(bd, t); eye = v3(eye.x + k[0], eye.y + k[1], eye.z + k[2]);
    return CamNow.{eye = eye, at = v3(head.x - back.x * 3, y + 1.5, head.z - back.z * 3), fov = board_fov(bd, 0.82)};
  }
  return CamNow.{eye = eye, at = v3(head.x - back.x * 3, y + 1.5, head.z - back.z * 3), fov = 0.82};
}
// The big bodies the camera keeps clear of: the drill mech and, in its chamber, the boss. Whether
// (x, z) is within `pad` of one.
g_big_at :: (g: [] SpGame, x: f32, z: f32, pad: f32) -> bool {
  if g[0].zone != Z_MINE { return false; }
  t := g[0].bt[0];
  if dist2(x, z, t.mech_x, t.mech_z) < 2.4 + pad { return true; }
  if (g[0].wall_gone || g[0].boss_down) && dist2(x, z, t.dino_x, t.dino_z) < 3.2 + pad { return true; }
  return false;
}
// How much a big body stands in the view ahead, 0 to 1: one within 12 m ahead and near the line of
// sight blocks what is behind it, so the camera rises over it.
g_big_ahead :: (g: [] SpGame, x: f32, z: f32, fx: f32, fz: f32) -> f32 {
  if g[0].zone != Z_MINE { return 0; }
  t := g[0].bt[0]; best := 0.0f32;
  for k: 0..<2 {
    if k == 1 && !(g[0].wall_gone || g[0].boss_down) { continue; }
    bx := ifx k == 0 then t.mech_x else t.dino_x; bz := ifx k == 0 then t.mech_z else t.dino_z; r := ifx k == 0 then 2.4f32 else 3.2f32;
    along := (bx - x) * fx + (bz - z) * fz;
    if along < 0 || along > 12 { continue; }
    off := abs((bx - x) * fz - (bz - z) * fx);
    if off < r + 1.5 { best = hi(best, lo(1, (r + 1.5 - off) / 1.5) * lo(1, (12 - along) / 4)); }
  }
  return best;
}
// The time-of-day presets (dawn, day, dusk, night) as an anime variant and clock.
g_variant :: (g: [] SpGame) -> int {
  if g[0].mode == M_BAY { return 0; }
  if g[0].mode == M_MEMORY || g[0].mode == M_RESTORED { return 3; }
  if fr_front(g) { return 2; }
  ph := g_phase(g);
  return ifx ph <= PH_DAY then 0 else ifx ph == PH_DUSK then 2 else 3;
}
g_clock :: (g: [] SpGame) -> f32 {
  v := g_variant(g);
  if v == 0 { return ifx g_phase(g) == PH_DAWN && g[0].mode != M_BAY then 0.29f32 else 0.5f32; }
  return ifx v == 2 then 0.78f32 else 0.0f32;
}
g_key_light :: (g: [] SpGame) -> Point {
  v := g_variant(g);
  if v == 0 && g_phase(g) == PH_DAWN && g[0].mode != M_BAY { return unit_or(v3(0.7, 0.28, 0.6), v3(0, 1, 0)); }
  if v == 0 { return unit_or(v3(-0.45, 0.66, 0.6), v3(0, 1, 0)); }
  if v == 2 { return unit_or(v3(-0.6, 0.3, 0.74), v3(0, 1, 0)); }
  return unit_or(v3(0.4, 0.5, 0.77), v3(0, 1, 0));
}

// ---- The interface: ink on paper, in two faces
// Text is set in the page's own fonts (realms.json): IBM Plex Mono for labels, numbers and
// captions, Michroma for banners, titles and buttons. The host draws both into the sans atlas
// (the reading face and the title face); these are their advance widths, in thousandths of an em.
F_MONO :: 0; F_TITLE :: 1;
MONO_ADVANCE :: 600; MONO_CAP :: 0.698f32; TITLE_CAP :: 0.75f32;
TITLE_SCALE :: 0.7f32;        // realms.json ui_title_font_scale: Michroma is drawn smaller so W fits its cell
TITLE_TRACK :: 0.07f32;       // wide tracking, ems
MICHROMA :: [95] int.[284, 277, 375, 750, 1046, 1889, 1188, 219, 375, 375, 691, 684, 219, 500, 219, 500, 951, 951, 951, 951, 1000, 951, 951, 969, 951, 969, 219, 219, 684, 684, 684, 906, 1094, 1062, 1031, 1047, 1078, 875, 844, 1063, 1066, 281, 837, 984, 812, 1371, 1133, 1047, 972, 1047, 1019, 1046, 936, 1035, 1000, 1625, 1062, 1062, 999, 406, 500, 406, 531, 531, 469, 762, 800, 767, 800, 765, 516, 787, 783, 219, 328, 690, 281, 1208, 782, 782, 800, 800, 481, 776, 633, 782, 775, 1094, 795, 766, 719, 469, 219, 469, 684];
face_em :: (face: int, cap: f32) -> f32 { return cap / (ifx face == F_TITLE then TITLE_CAP else MONO_CAP); }
face_advance :: (face: int, code: u32, em: f32) -> f32 {
  if face == F_MONO { return cast(f32) MONO_ADVANCE / 1000 * em; }
  w := ifx code >= 32 && code <= 126 then MICHROMA[cast(int) code - 32] else 531;
  return (cast(f32) w / 1000 + TITLE_TRACK) * em;
}
ui_w :: (face: int, t: string, cap: f32) -> f32 {
  em := face_em(face, cap); w := 0.0f32; i := 0;
  while i < t.count { d := decode(t, i); i += d.len; w += face_advance(face, d.code, em); }
  return w;
}
// One textured quad a glyph, as font.coax draw_sans lays them out, with this face's widths.
ui_put :: (out: [] f32, n: int, face: int, t: string, x: f32, base: f32, cap: f32, c: KitTint, a: f32) -> int {
  em := face_em(face, cap);
  s := em / (SANS_EM * (ifx face == F_TITLE then TITLE_SCALE else 1.0f32));
  w := SANS_CELL * cast(f32) SANS_COLUMNS; h := SANS_CELL * cast(f32) SANS_ROWS;
  y0 := floor(base + 0.5) - SANS_BASE * s;
  v := n; pen := x; i := 0;
  while i < t.count {
    d := decode(t, i); i += d.len;
    gl := sans_index(d.code);
    if gl < 0 { gl = sans_index('?'); }
    if d.code != 32 {
      if (v + 6) * VERTEX_FLOATS > out.count { return v; }
      cx := cast(f32) (gl % SANS_COLUMNS) * SANS_CELL; cy := cast(f32) (gl / SANS_COLUMNS) * SANS_CELL;
      x0 := pen - SANS_LEFT * s; x1 := x0 + SANS_CELL * s; y1 := y0 + SANS_CELL * s;
      qx := [6] f32.[x0, x1, x1, x0, x1, x0];
      qy := [6] f32.[y0, y0, y1, y0, y1, y1];
      ux := [6] f32.[cx, cx + SANS_CELL, cx + SANS_CELL, cx, cx + SANS_CELL, cx];
      uy := [6] f32.[cy, cy, cy + SANS_CELL, cy, cy + SANS_CELL, cy + SANS_CELL];
      for q: 0..<6 {
        o := (v + q) * VERTEX_FLOATS;
        out[o] = qx[q]; out[o + 1] = qy[q]; out[o + 2] = ux[q] / w; out[o + 3] = uy[q] / h;
        out[o + 4] = s * SANS_EM; out[o + 5] = 0; out[o + 6] = a; out[o + 7] = 0;
        out[o + 8] = c.r; out[o + 9] = c.g; out[o + 10] = c.b; out[o + 11] = ifx face == F_TITLE then 5.0f32 else 4.0f32;
      }
      v += 6;
    }
    pen += face_advance(face, d.code, em);
  }
  return v;
}
Ui :: struct { w: f32; h: f32; k: f32; }
ui_panel :: (g: [] SpGame, u: [] f32, x0: f32, y0: f32, x1: f32, y1: f32, c: KitTint, a: f32) {
  if g[0].panels >= PANELS { return; }
  o := U_PANELS + g[0].panels * PANEL_FLOATS;
  put4(u, o, x0, y0, x1, y1); put4(u, o + 4, c.r, c.g, c.b, a);
  g[0].panels += 1;
}
ui_seg :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, half: f32, c: KitTint, a: f32) -> int {
  if lit(out, n, ax, ay, bx + 0.01, by, half, a, 1.5, c.r, c.g, c.b, 0) { return n + 6; }
  return n;
}
ui_box :: (out: [] f32, n: int, x0: f32, y0: f32, x1: f32, y1: f32, w: f32, c: KitTint) -> int {
  m := n;
  m = ui_seg(out, m, x0, y0, x1, y0, w * 0.5, c, 1); m = ui_seg(out, m, x0, y1, x1, y1, w * 0.5, c, 1);
  m = ui_seg(out, m, x0, y0, x0, y1, w * 0.5, c, 1); m = ui_seg(out, m, x1, y0, x1, y1, w * 0.5, c, 1);
  return m;
}
// A dashed outline: locked or special (SPLICE CORE, DRILL+).
ui_dash :: (out: [] f32, n: int, x0: f32, y0: f32, x1: f32, y1: f32, w: f32, c: KitTint) -> int {
  m := n; step := w * 5;
  x := x0; while x < x1 { e := lo(x + step * 0.6, x1); m = ui_seg(out, m, x, y0, e, y0, w * 0.5, c, 1); m = ui_seg(out, m, x, y1, e, y1, w * 0.5, c, 1); x += step; }
  y := y0; while y < y1 { e := lo(y + step * 0.6, y1); m = ui_seg(out, m, x0, y, x0, e, w * 0.5, c, 1); m = ui_seg(out, m, x1, y, x1, e, w * 0.5, c, 1); y += step; }
  return m;
}
// A filled, round-ended box.
ui_fill :: (out: [] f32, n: int, x0: f32, y0: f32, x1: f32, y1: f32, c: KitTint) -> int {
  half := (y1 - y0) * 0.5;
  return ui_seg(out, n, x0 + half, y0 + half, x1 - half, y0 + half, half, c, 1);
}
ui_text :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, c: KitTint) -> int { return ui_put(out, n, F_MONO, t, x, base, cap, c, 1); }
ui_mid :: (out: [] f32, n: int, t: string, cx: f32, base: f32, cap: f32, c: KitTint) -> int { return ui_put(out, n, F_MONO, t, cx - ui_w(F_MONO, t, cap) * 0.5, base, cap, c, 1); }
ui_right :: (out: [] f32, n: int, t: string, x1: f32, base: f32, cap: f32, c: KitTint) -> int { return ui_put(out, n, F_MONO, t, x1 - ui_w(F_MONO, t, cap), base, cap, c, 1); }
ui_title :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, c: KitTint) -> int { return ui_put(out, n, F_TITLE, t, x, base, cap, c, 1); }
ui_title_mid :: (out: [] f32, n: int, t: string, cx: f32, base: f32, cap: f32, c: KitTint) -> int { return ui_put(out, n, F_TITLE, t, cx - ui_w(F_TITLE, t, cap) * 0.5, base, cap, c, 1); }
// A key cap: an ink border with a thicker bottom edge, as wide as its label needs.
cap_w :: (t: string, s: f32) -> f32 { return hi(s, ui_w(F_MONO, t, s * 0.4) + s * 0.5); }
ui_cap :: (out: [] f32, n: int, t: string, x: f32, y: f32, s: f32, c: KitTint) -> int {
  w := cap_w(t, s);
  m := ui_box(out, n, x, y, x + w, y + s, s * 0.09, c);
  m = ui_seg(out, m, x, y + s + s * 0.07, x + w, y + s + s * 0.07, s * 0.08, c, 1);
  return ui_mid(out, m, t, x + w * 0.5, y + s * 0.7, s * 0.4, c);
}
ui_heart :: (out: [] f32, n: int, cx: f32, cy: f32, s: f32, full: bool, back: KitTint) -> int {
  m := n;
  for pass: 0..<2 {
    c := ifx pass == 0 then INK() else ifx full then HEAT() else back;
    r := ifx pass == 0 then s * 0.30 else s * 0.30 - s * 0.07;
    m = ui_seg(out, m, cx - s * 0.24, cy - s * 0.12, cx, cy + s * 0.3, r, c, 1);
    m = ui_seg(out, m, cx + s * 0.24, cy - s * 0.12, cx, cy + s * 0.3, r, c, 1);
  }
  return m;
}
// The icon set: two-pixel strokes. 0 drill, 1 treads, 2 battery, 3 stun, 4 core, 5 heat.
ui_icon :: (out: [] f32, n: int, kind: int, cx: f32, cy: f32, s: f32, c: KitTint, k: f32) -> int {
  m := n; w := 1.1 * k; h := s * 0.5;
  if kind == 0 { m = ui_seg(out, m, cx - h, cy - h * 0.6, cx - h, cy + h * 0.6, w, c, 1); m = ui_seg(out, m, cx - h, cy - h * 0.6, cx + h, cy, w, c, 1); m = ui_seg(out, m, cx - h, cy + h * 0.6, cx + h, cy, w, c, 1); m = ui_seg(out, m, cx - h * 0.3, cy - h * 0.4, cx - h * 0.3, cy + h * 0.4, w, c, 1); }
  if kind == 1 { m = ui_seg(out, m, cx - h * 0.6, cy - h * 0.5, cx + h * 0.6, cy - h * 0.5, w, c, 1); m = ui_seg(out, m, cx - h * 0.6, cy + h * 0.5, cx + h * 0.6, cy + h * 0.5, w, c, 1); m = ui_seg(out, m, cx - h, cy, cx - h * 0.6, cy - h * 0.5, w, c, 1); m = ui_seg(out, m, cx - h, cy, cx - h * 0.6, cy + h * 0.5, w, c, 1); m = ui_seg(out, m, cx + h, cy, cx + h * 0.6, cy - h * 0.5, w, c, 1); m = ui_seg(out, m, cx + h, cy, cx + h * 0.6, cy + h * 0.5, w, c, 1); m = ui_seg(out, m, cx - h * 0.4, cy, cx - h * 0.4, cy, w * 1.4, c, 1); m = ui_seg(out, m, cx + h * 0.4, cy, cx + h * 0.4, cy, w * 1.4, c, 1); }
  if kind == 2 { m = ui_box(out, m, cx - h * 0.9, cy - h * 0.55, cx + h * 0.7, cy + h * 0.55, w * 2, c); m = ui_seg(out, m, cx + h * 0.95, cy - h * 0.2, cx + h * 0.95, cy + h * 0.2, w, c, 1); m = ui_seg(out, m, cx - h * 0.45, cy, cx - h * 0.05, cy, w * 1.6, c, 1); }
  if kind == 3 { m = ui_seg(out, m, cx + h * 0.3, cy - h, cx - h * 0.4, cy + h * 0.1, w, c, 1); m = ui_seg(out, m, cx - h * 0.4, cy + h * 0.1, cx + h * 0.4, cy - h * 0.1, w, c, 1); m = ui_seg(out, m, cx + h * 0.4, cy - h * 0.1, cx - h * 0.3, cy + h, w, c, 1); }
  if kind == 4 { for i: 0..<8 { a0 := cast(f32) i * TAU / 8; a1 := a0 + TAU / 8; m = ui_seg(out, m, cx + cos(a0) * h, cy + sin(a0) * h, cx + cos(a1) * h, cy + sin(a1) * h, w, c, 1); } m = ui_seg(out, m, cx, cy, cx, cy, h * 0.35, c, 1); }
  if kind == 5 { m = ui_seg(out, m, cx, cy - h, cx - h * 0.6, cy + h * 0.3, w, c, 1); m = ui_seg(out, m, cx, cy - h, cx + h * 0.6, cy + h * 0.3, w, c, 1); m = ui_seg(out, m, cx - h * 0.6, cy + h * 0.3, cx, cy + h, w, c, 1); m = ui_seg(out, m, cx + h * 0.6, cy + h * 0.3, cx, cy + h, w, c, 1); }
  return m;
}
g_hot :: (g: [] SpGame, x0: f32, y0: f32, x1: f32, y1: f32, key: int) {
  if g[0].btn_n >= BUTTONS { return; }
  o := g[0].btn_n * 4; g[0].btn[o] = x0; g[0].btn[o + 1] = y0; g[0].btn[o + 2] = x1; g[0].btn[o + 3] = y1; g[0].btn_key[g[0].btn_n] = key; g[0].btn_n += 1;
}
// A button: 0 primary (ink fill, paper text), 1 secondary (ink outline), 2 special (blue outline),
// 3 locked (blue dashed outline).
ui_button :: (g: [] SpGame, out: [] f32, n: int, t: string, x0: f32, y0: f32, x1: f32, y1: f32, kind: int, key: int) -> int {
  m := n; cy := (y0 + y1) * 0.5; half := (y1 - y0) * 0.5;
  line := ifx kind >= 2 then GLOW_INK() else INK();
  if kind == 3 { m = ui_dash(out, m, x0, y0, x1, y1, half * 0.14, line); }
  else {
    m = ui_fill(out, m, x0, y0, x1, y1, line);
    if kind != 0 { m = ui_fill(out, m, x0 + half * 0.14, y0 + half * 0.14, x1 - half * 0.14, y1 - half * 0.14, PAPER()); }
  }
  m = ui_title_mid(out, m, t, (x0 + x1) * 0.5, cy + half * 0.25, half * 0.5, ifx kind == 0 then PAPER() else line);
  if key != 0 && kind != 3 { g_hot(g, x0, y0, x1, y1, key); }
  return m;
}
// Film-strip sprocket holes along a bar.
ui_sprockets :: (out: [] f32, n: int, x0: f32, x1: f32, y: f32, s: f32, c: KitTint) -> int {
  m := n; x := x0 + s * 1.5;
  while x < x1 - s { m = ui_seg(out, m, x, y, x + s * 0.5, y, s * 0.36, c, 1); x += s * 2.4; }
  return m;
}
num :: (buf: [] u8, a: string, v: int, b: string) -> string { n := tput(buf, 0, a); n = tput_int(buf, n, v); n = tput(buf, n, b); return cast(string) buf[0..<n]; }
card_name :: (c: int) -> string { return ifx c == H_MOVE then "MOVE" else ifx c == H_DRILL then "DRILL" else "DRILL+"; }
item_name :: (i: int) -> string { return ifx i == H_ARM then "DRILL ARM" else ifx i == H_TREADS then "TREADS" else ifx i == H_BATTERY then "BATTERY" else card_name(i); }
pick_name :: (i: int) -> string { return ifx i == PICK_PLUS then "DRILL+ special part +25 HEAT" else ifx i >= PICK_CELL then "Battery cell" else ifx i == H_MOVE then "MOVE card" else ifx i == H_DRILL then "DRILL card" else ifx i == H_ARM then "Drill Arm" else ifx i == H_TREADS then "Treads" else "Battery"; }
msg_text :: (g: [] SpGame) -> string {
  m := g[0].msg;
  if m >= SBM_FIRST { return sb_msg_text(g); }   // the battles' (splice-battle.coax)
  if m == MSG_BAD_CUT { return "Bad cut. Re-edit at the rover."; }
  if m == MSG_AIR { return "The Digger drilled air. It was out of reach."; }
  if m == MSG_WEAK { return "DRILL can't break this wall. It needs DRILL+."; }
  if m == MSG_OPEN { return "The tunnel is open. Dusk falls."; }
  if m == MSG_NEED { return "The Digger needs its arm, treads, battery and a card."; }
  if m == MSG_BROKE { return "The wall is down."; }
  if m == MSG_DOWN { return "The banned bot powers down. Take its core."; }
  if m == MSG_HIT { return "Hit. One heart lost."; }
  if m == MSG_STUN { return "Weak point stunned."; }
  if m == MSG_WAKE { return "A weak point woke up."; }
  if m == MSG_FOE { return "Down. Robot piece taken. +10 Heat."; }
  if m == MSG_SMACK { return "Hit. Once more."; }
  if m == MSG_CELL { return "Battery cell found."; }
  if m == MSG_CORE { return "You have the core. Get it to the rover."; }
  if m == MSG_PING { return "Sensor ping. Something is buried near the marker."; }
  if m == MSG_FIRST { return "The sensor found something. Let Digger get it first."; }
  if m == MSG_NO_DRILL { return "Sniper: not without a drill. Find the DRILL card first."; }
  if m == MSG_PICK {
    i := g[0].last_pick;
    return ifx i == H_ARM then "Drill Arm found." else ifx i == H_TREADS then "Treads found." else ifx i == H_BATTERY then "Battery found." else ifx i == H_MOVE then "Card found: MOVE." else ifx i == H_DRILL then "Card found: DRILL." else "DRILL+ found. +25 Heat.";
  }
  return "";
}
objective :: (g: [] SpGame) -> string {
  o := sb_objective(g); if o != "" { return o; }   // the mech, the raider mech, the boss (splice-battle.coax)
  if g[0].zone == Z_VILLAGE { return "Leave through the scanner gate."; }
  if g[0].zone == Z_RAIL {
    if g[0].mode == M_RIDE { return "Ride the rail to the mine."; }
    return ifx g[0].have[H_BATTERY] then "Get back in the rover." else "Find what the sensor pinged.";
  }
  if g[0].mode == M_DRIVE { return "Sniper drives you to the garage."; }
  if g[0].have[H_CORE] { return "Carry the core to the rover."; }
  if g[0].boss_down { return "Take the core."; }
  if g[0].wall_gone { return "Stun all 3 weak points."; }
  if g[0].have[H_PLUS] { return "Splice DRILL+ in the rover."; }
  if g[0].rubble_gone { return "Find the blue glow."; }
  if g[0].have[H_ARM] && g[0].have[H_TREADS] && g[0].have[H_BATTERY] && g[0].have[H_MOVE] && g[0].have[H_DRILL] { return "Splice the Digger at the rover."; }
  return "Walk near parts: Digger takes them.";
}

g_hud :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui) -> int {
  n := 0; k := q.k; w := q.w; h := q.h; pad := 18 * k; ink := INK(); paper := PAPER();
  buf: [96] u8;
  // top left: her health, Digger's, her inventory and his sensor (director.coax)
  if g[0].dr[0].paused { return d_hud(g, out, u, q, n); }
  n = d_vitals(g, out, u, q, n);
  // under them: the hoverboard, when the world gives one: what it is doing, and its keys
  if g_board_given(g) && g[0].mode == M_PLAY {
    y0 := pad + 100 * k; bd := g[0].board[0]; on := g_riding(g);
    ui_panel(g, u, pad, y0, pad + 272 * k, y0 + 50 * k, ifx on then ink else paper, 0.96);
    n = ui_box(out, n, pad, y0, pad + 272 * k, y0 + 50 * k, 3 * k, ink);
    fg := ifx on then paper else ink;
    what := ifx !on then "BOARD OFF" else ifx g[0].dr[0].super then "BOARD · SUPER FAST" else ifx bd.fast then "BOARD · FAST" else "BOARD · CASUAL";
    n = ui_text(out, n, what, pad + 12 * k, y0 + 20 * k, 9.5 * k, ifx on && bd.fast then HEAT() else fg);
    if on { n = ui_right(out, n, num(buf[..], "", cast(int) (abs(bd.m.speed) * 3.6 + 0.5), " km/h"), pad + 260 * k, y0 + 20 * k, 9.5 * k, fg); }
    n = ui_text(out, n, ifx on then "Q fast · Q Q super-fast · hold Q off" else "Q board · Q Q super-fast", pad + 12 * k, y0 + 40 * k, 7.5 * k, fg);
  }
  // top centre: the phase, four chips on an ink bar
  bw := 380 * k; bx := w * 0.5 - bw * 0.5;
  ui_panel(g, u, bx, pad, bx + bw, pad + 38 * k, ink, 0.97);
  names := [4] string.["DAWN", "DAY", "DUSK", "NIGHT"];
  for i: 0..<4 {
    cx := bx + (cast(f32) i + 0.5) * bw / 4; on := i == g_phase(g);   // the editor's time of day, when one is set
    if on { n = ui_fill(out, n, cx - 40 * k, pad + 6 * k, cx + 40 * k, pad + 32 * k, HEAT()); n = ui_fill(out, n, cx - 37.5 * k, pad + 8.5 * k, cx + 37.5 * k, pad + 29.5 * k, SHADE()); }
    n = ui_mid(out, n, names[i], cx, pad + 23.5 * k, 9.5 * k, ifx on then ink else SHADE());
  }
  // top right: Heat, in three bands
  hx := w - pad - 350 * k;
  ui_panel(g, u, hx, pad, w - pad, pad + 86 * k, paper, 0.96);
  n = ui_box(out, n, hx, pad, w - pad, pad + 86 * k, 3 * k, ink);
  n = ui_icon(out, n, 5, hx + 22 * k, pad + 19 * k, 16 * k, HEAT(), k);
  n = ui_text(out, n, num(buf[..], "HEAT ", cast(int) g[0].heat, " / 100"), hx + 38 * k, pad + 24 * k, 10.5 * k, ink);
  band := ifx g[0].heat >= 66 then "WANTED" else ifx g[0].heat >= 33 then "WARM" else "COOL";
  n = ui_right(out, n, band, w - pad - 14 * k, pad + 24 * k, 10.5 * k, ifx g[0].heat >= 33 then HEAT() else ink);
  b0 := hx + 14 * k; b1 := w - pad - 14 * k; by := pad + 46 * k;
  n = ui_box(out, n, b0, by - 9 * k, b1, by + 9 * k, 2 * k, ink);
  if g[0].heat > 1 { n = ui_seg(out, n, b0 + 7 * k, by, b0 + 7 * k + (b1 - b0 - 14 * k) * g[0].heat / T_HEAT_MAX, by, 5.5 * k, HEAT(), 1); }
  n = ui_seg(out, n, b0 + (b1 - b0) / 3, by - 9 * k, b0 + (b1 - b0) / 3, by + 9 * k, 1 * k, ink, 1);
  n = ui_seg(out, n, b0 + (b1 - b0) * 2 / 3, by - 9 * k, b0 + (b1 - b0) * 2 / 3, by + 9 * k, 1 * k, ink, 1);
  n = ui_text(out, n, "+25 per banned piece · cools at the rover", b0, pad + 74 * k, 7.5 * k, ink);
  // bottom left: the Digger's cards
  cy0 := h - pad - 92 * k;
  ui_panel(g, u, pad, cy0, pad + 360 * k, h - pad, paper, 0.96);
  n = ui_box(out, n, pad, cy0, pad + 360 * k, h - pad, 3 * k, ink);
  n = ui_text(out, n, "DIGGER · CARDS", pad + 14 * k, cy0 + 24 * k, 9.5 * k, ink);
  for i: 0..<3 {
    c := H_MOVE + i; x0 := pad + (14 + cast(f32) i * 112) * k; y0 := cy0 + 38 * k; x1 := x0 + 104 * k; blue := c == H_PLUS;
    if g[0].have[c] { n = ui_button(g, out, n, card_name(c), x0, y0, x1, y0 + 38 * k, ifx blue then 2 else 0, 0); }
    else if blue { n = ui_dash(out, n, x0, y0, x1, y0 + 38 * k, 1.5 * k, GLOW_INK()); n = ui_mid(out, n, "NOT FOUND", (x0 + x1) * 0.5, y0 + 23 * k, 7.5 * k, GLOW_INK()); }
    else { n = ui_box(out, n, x0, y0, x1, y0 + 38 * k, 1.5 * k, ink); n = ui_mid(out, n, "NOT FOUND", (x0 + x1) * 0.5, y0 + 23 * k, 7.5 * k, ink); }
  }
  // bottom right: the objective and its checklist
  ox := w - pad - 400 * k;
  ui_panel(g, u, ox, cy0, w - pad, h - pad, paper, 0.96);
  n = ui_box(out, n, ox, cy0, w - pad, h - pad, 3 * k, ink);
  n = ui_text(out, n, "OBJECTIVE", ox + 14 * k, cy0 + 24 * k, 9.5 * k, ink);
  n = ui_text(out, n, objective(g), ox + 14 * k, cy0 + 50 * k, 9 * k, ink);
  parts := (ifx g[0].have[H_ARM] then 1 else 0) + (ifx g[0].have[H_TREADS] then 1 else 0) + (ifx g[0].have[H_BATTERY] then 1 else 0);
  if g[0].zone == Z_MINE && g[0].rubble_gone { n = ui_text(out, n, num(buf[..], "Robot pieces ", g[0].scrap, ""), ox + 14 * k, cy0 + 74 * k, 9 * k, ink); n = ui_text(out, n, num(buf[..], "Cells ", g[0].cells, " / 4"), ox + 190 * k, cy0 + 74 * k, 9 * k, ink); }
  else if g[0].zone == Z_MINE { n = ui_text(out, n, num(buf[..], "Parts ", parts, " / 3"), ox + 14 * k, cy0 + 74 * k, 9 * k, ink); n = ui_text(out, n, num(buf[..], "Cards ", (ifx g[0].have[H_MOVE] then 1 else 0) + (ifx g[0].have[H_DRILL] then 1 else 0), " / 2"), ox + 150 * k, cy0 + 74 * k, 9 * k, ink); }
  // bottom centre: the key prompt
  prompt := ""; key := "E"; reach := g_reach(g);
  if g[0].mode == M_RIDE { prompt = "Speed up · slow down"; key = "W S"; }
  else if reach >= 0 && g[0].bot && !d_down(g) { prompt = "Digger picks it up"; key = "AUTO"; }
  else if g[0].bot && d_down(g) && dist2(g[0].px, g[0].pz, g[0].bot_x, g[0].bot_z) < T_TOW_REACH { prompt = ifx d_towing(g) then "Let go of Digger" else "Tow Digger to Sniper"; }
  else if g_weak_near(g) >= 0 { prompt = "Stun the weak point"; key = "F"; }
  else if g_foe_near(g) >= 0 { prompt = ifx g_foe_near(g) < F_RAIDERS then "Stun the raider" else "Stun the Imperial robot"; key = "F"; }
  else if g[0].zone == Z_MINE && g[0].boss_down && !g[0].core_taken && dist2(g[0].px, g[0].pz, sb_core_at(g).x, sb_core_at(g).z) < T_PICK_RANGE { prompt = "PICK UP · Banned core"; }
  else if g[0].zone == Z_RAIL && near_rover(g, T_USE_RANGE) { prompt = "Board the rover"; }
  else if g_portal(g) >= 0 { prompt = prt_name(g[0].c[0].portals[..], g_portal(g)); }
  else if d_in_rover(g) { prompt = "Open the edit bay"; key = "TAB"; }
  sp := sb_prompt(g); if sp.text != "" && reach < 0 { prompt = sp.text; key = sp.key; }   // the battles' (splice-battle.coax)
  if g[0].dr[0].bag || g[0].dr[0].map { prompt = ""; }   // an open window covers the prompt
  n = sb_hud(g, out, u, q, n);   // health bars over the bots, and a battle's panels
  if prompt != "" {
    extra := ifx reach >= 0 then pick_name(reach) else "";
    cw := cap_w(key, 26 * k); pw0 := ui_w(F_MONO, prompt, 10.5 * k);
    pw := pw0 + cw + 44 * k + (ifx extra != "" then ui_w(F_MONO, extra, 10.5 * k) + 30 * k else 0.0f32);
    x0 := w * 0.5 - pw * 0.5; y0 := h - pad - 150 * k;
    ui_panel(g, u, x0, y0, x0 + pw, y0 + 46 * k, paper, 0.96);
    n = ui_box(out, n, x0, y0, x0 + pw, y0 + 46 * k, 3 * k, ink);
    n = ui_cap(out, n, key, x0 + 12 * k, y0 + 9 * k, 26 * k, ink);
    n = ui_text(out, n, prompt, x0 + cw + 26 * k, y0 + 29 * k, 10.5 * k, ink);
    if extra != "" { n = ui_text(out, n, "·", x0 + cw + 36 * k + pw0, y0 + 29 * k, 10.5 * k, ink); n = ui_text(out, n, extra, x0 + cw + 54 * k + pw0, y0 + 29 * k, 10.5 * k, ifx reach == PICK_PLUS then GLOW_INK() else ink); }
  }
  // the scanner gate: Heat is cool, pass
  if g[0].zone == Z_VILLAGE && (g[0].pass_t > 0 || g[0].pz > g[0].at.vil_z + 4) {
    x0 := w * 0.5 - 250 * k; y0 := h * 0.24;
    ui_panel(g, u, x0, y0, x0 + 500 * k, y0 + 118 * k, paper, 0.97);
    n = ui_box(out, n, x0, y0, x0 + 500 * k, y0 + 118 * k, 3 * k, ink);
    n = ui_title_mid(out, n, ifx g[0].pass_t > 0 then "HEAT: COOL. PASS." else "SCANNER GATE", w * 0.5, y0 + 40 * k, 15 * k, ink);
    n = ui_box(out, n, x0 + 40 * k, y0 + 56 * k, x0 + 460 * k, y0 + 72 * k, 2 * k, ink);
    n = ui_mid(out, n, "Walk through the beam to start the rail drive", w * 0.5, y0 + 98 * k, 8.5 * k, ink);
  }
  // centre: what just happened
  m := msg_text(g);
  if m != "" {
    mw := ui_w(F_MONO, m, 12 * k) + 48 * k; x0 := w * 0.5 - mw * 0.5; y0 := h * 0.3 + (ifx g[0].zone == Z_VILLAGE then 140 * k else 0.0f32);
    bad := g[0].msg == MSG_BAD_CUT || g[0].msg == MSG_AIR || g[0].msg == MSG_WEAK || g[0].msg == MSG_HIT || g[0].msg == MSG_NEED || g[0].msg == MSG_WAKE;
    ui_panel(g, u, x0, y0, x0 + mw, y0 + 50 * k, ifx bad then HEAT() else ink, 0.96);
    n = ui_mid(out, n, m, w * 0.5, y0 + 31 * k, 12 * k, paper);
  }
  return d_hud(g, out, u, q, n);   // the bars over the bots, her line, the grid and the map (director.coax)
}

g_bay :: (g: [] SpGame, out: [] f32, u: [] f32, q: Ui) -> int {
  n := 0; k := q.k; w := q.w; h := q.h; ink := INK(); paper := PAPER(); blue := GLOW_INK();
  buf: [96] u8;
  lx := 300 * k; rx := w - 300 * k; top := 66 * k; bot := h - 300 * k; mx := (lx + rx) * 0.5;
  g[0].btn_n = 0;
  // paper round a window onto the Digger's stage
  ui_panel(g, u, -20, -20, w + 20, top, ink, 1);
  ui_panel(g, u, -20, top, lx, h + 20, paper, 1);
  ui_panel(g, u, rx, top, w + 20, h + 20, paper, 1);
  ui_panel(g, u, lx - 10, bot, rx + 10, h + 20, paper, 1);
  // header: the bay, the bot and where you are, Heat, EXIT [TAB]
  n = ui_title(out, n, "EDIT BAY", 24 * k, 42 * k, 15 * k, paper);
  n = ui_text(out, n, ifx g[0].at_crate then "DIGGER · STASH CRATE" else "DIGGER · ROVER", 290 * k, 40 * k, 10 * k, SHADE());
  n = ui_mid(out, n, num(buf[..], "HEAT ", cast(int) g[0].heat, ifx g[0].heat > 0 then " · COOLING" else " · COOL"), w * 0.5 + 110 * k, 40 * k, 10 * k, ifx g[0].heat > 0 then t3(0.95, 0.52, 0.30) else SHADE());
  tw := cap_w("TAB", 26 * k);
  n = ui_right(out, n, "EXIT", w - 36 * k - tw, 40 * k, 10 * k, paper);
  n = ui_cap(out, n, "TAB", w - 24 * k - tw, 18 * k, 26 * k, paper);
  g_hot(g, w - 130 * k, 0, w, top, -15);
  // left: the parts you carry (drag one onto the timeline, or click it)
  n = ui_title(out, n, "PARTS", 24 * k, top + 38 * k, 10 * k, ink);
  for i: 0..<3 {
    y := top + (58 + cast(f32) i * 56) * k; x1 := lx - 24 * k;
    n = ui_box(out, n, 24 * k, y, x1, y + 46 * k, 2 * k, ink);
    n = ui_icon(out, n, i, 46 * k, y + 23 * k, 18 * k, ink, k);
    n = ui_text(out, n, item_name(i), 66 * k, y + 28 * k, 9.5 * k, ink);
    state := ifx g[0].slot[i] then "SPLICED" else ifx g[0].have[i] then "CARRIED" else "NOT FOUND";
    n = ui_right(out, n, state, x1 - 12 * k, y + 28 * k, 7.5 * k, ifx g[0].have[i] then ink else HEAT());
    if g[0].have[i] && !g[0].slot[i] { g_hot(g, 24 * k, y, x1, y + 46 * k, 1000 + i); }
  }
  y := top + 246 * k;
  n = ui_text(out, n, num(buf[..], "Robot pieces ", g[0].scrap, ""), 24 * k, y, 9 * k, ink); n = ui_text(out, n, num(buf[..], "Cells ", g[0].cells, ""), 190 * k, y, 9 * k, ink);
  if g[0].have[H_CORE] { n = ui_icon(out, n, 4, 34 * k, y + 22 * k, 16 * k, blue, k); n = ui_text(out, n, "Banned core · ready", 52 * k, y + 26 * k, 9 * k, blue); }
  // the window: a REC mark, SPLICE and SPLICE CORE
  n = ui_box(out, n, lx, top, rx, bot, 3 * k, ink);
  if fract(g[0].t) < 0.6 { n = ui_seg(out, n, lx + 24 * k, top + 26 * k, lx + 24 * k, top + 26 * k, 7 * k, HEAT(), 1); }
  n = ui_text(out, n, "REC", lx + 40 * k, top + 31 * k, 10 * k, ink);
  n = ui_button(g, out, n, "SPLICE", mx - 290 * k, bot - 58 * k, mx - 60 * k, bot - 14 * k, 0, -2);
  n = ui_button(g, out, n, "SPLICE CORE", mx - 30 * k, bot - 58 * k, mx + 290 * k, bot - 14 * k, ifx g[0].have[H_CORE] then 2 else 3, 'x');
  // right: the cards you carry
  n = ui_title(out, n, "CARDS", rx + 24 * k, top + 38 * k, 10 * k, ink);
  desc := [3] string.["Follow the path", "Breaks rubble", "Special part · drills hardest"];
  for i: 0..<3 {
    c := H_MOVE + i; y0 := top + (58 + cast(f32) i * 74) * k; has := g[0].have[c]; col := ifx c == H_PLUS then blue else ink;
    if c == H_PLUS && !has { n = ui_dash(out, n, rx + 24 * k, y0, w - 24 * k, y0 + 62 * k, 2 * k, col); } else { n = ui_box(out, n, rx + 24 * k, y0, w - 24 * k, y0 + 62 * k, 2 * k, col); }
    n = ui_title(out, n, card_name(c), rx + 38 * k, y0 + 26 * k, 9.5 * k, col);
    n = ui_text(out, n, ifx has then desc[i] else "NOT FOUND", rx + 38 * k, y0 + 47 * k, 6.6 * k, ifx has then col else HEAT());
    if has { g_hot(g, rx + 24 * k, y0, w - 24 * k, y0 + 62 * k, 1000 + c); }
  }
  // bottom: the film-strip timeline, a PARTS row and a CARDS row, slots 01 to 03
  sy := bot + 16 * k; sh := 210 * k; s0 := lx + 10 * k; s1 := rx - 10 * k;
  ui_panel(g, u, s0, sy, s1, sy + sh, ink, 1);
  n = ui_sprockets(out, n, s0, s1, sy + 12 * k, 10 * k, paper);
  n = ui_sprockets(out, n, s0, s1, sy + sh - 12 * k, 10 * k, paper);
  lab := 78 * k; sw := (s1 - s0 - lab - 24 * k) / 3;
  nums := [3] string.["01", "02", "03"];
  for row: 0..<2 {
    y0 := sy + (ifx row == 0 then 28 * k else 108 * k); y1 := y0 + 72 * k;
    n = ui_text(out, n, ifx row == 0 then "PARTS" else "CARDS", s0 + 16 * k, (y0 + y1) * 0.5 + 4 * k, 8 * k, paper);
    for i: 0..<3 {
      x0 := s0 + lab + cast(f32) i * sw + 6 * k; x1 := x0 + sw - 12 * k;
      d := (row * 3 + i) * 4; g[0].drop[d] = x0; g[0].drop[d + 1] = y0; g[0].drop[d + 2] = x1; g[0].drop[d + 3] = y1;
      full := ifx row == 0 then g[0].slot[i] else i < g[0].strip_n;
      if full {
        item := ifx row == 0 then i else g[0].strip[i];
        n = ui_fill(out, n, x0, y0, x1, y1, ifx item == H_PLUS then GLOW() else paper);
        if row == 0 { n = ui_icon(out, n, i, x0 + 44 * k, (y0 + y1) * 0.5, 20 * k, ink, k); n = ui_text(out, n, item_name(i), x0 + 64 * k, (y0 + y1) * 0.5 + 5 * k, 8 * k, ink); }
        else { n = ui_title_mid(out, n, card_name(item), (x0 + x1) * 0.5, (y0 + y1) * 0.5 + 6 * k, 11 * k, ink); }
      } else {
        n = ui_box(out, n, x0, y0, x1, y1, 1.5 * k, SHADE());
        if row == 0 { n = ui_mid(out, n, item_name(i), (x0 + x1) * 0.5, (y0 + y1) * 0.5 + 4 * k, 7.5 * k, SHADE()); }
      }
      n = ui_text(out, n, nums[i], x0 + 26 * k, y0 + 16 * k, 6.5 * k, ifx full then ink else SHADE());
    }
  }
  by := sy + sh + 14 * k;
  n = ui_button(g, out, n, "CLEAR STRIP", lx + 10 * k, by, lx + 270 * k, by + 40 * k, 1, 'c');
  n = ui_right(out, n, "Drag parts and cards onto the timeline.", rx - 10 * k, by + 17 * k, 7.5 * k, ink);
  n = ui_right(out, n, "Cards play left to right.", rx - 10 * k, by + 34 * k, 7.5 * k, ink);
  m := msg_text(g);
  if m != "" { n = ui_mid(out, n, m, mx, top + 70 * k, 10 * k, ifx g[0].msg == MSG_NEED then HEAT() else blue); }
  // what is being dragged follows the pointer
  if g[0].drag >= 0 {
    t := item_name(g[0].drag); dw := ui_w(F_MONO, t, 10 * k) + 36 * k;
    n = ui_fill(out, n, g[0].drag_x - dw * 0.5, g[0].drag_y - 20 * k, g[0].drag_x + dw * 0.5, g[0].drag_y + 20 * k, ifx g[0].drag == H_PLUS then GLOW_INK() else ink);
    n = ui_mid(out, n, t, g[0].drag_x, g[0].drag_y + 5 * k, 10 * k, paper);
  }
  return n;
}

g_overlay :: (g: [] SpGame, out: [] f32, u: [] f32, w: f32, h: f32) -> int {
  q := Ui.{w = w, h = h, k = lo(w / 1280, h / 800)}; k := q.k; n := 0;
  ink := INK(); paper := PAPER();
  g[0].panels = 0;
  if g[0].mode == M_PLAY || g[0].mode == M_RIDE { g[0].btn_n = 0; return g_hud(g, out, u, q); }
  if g[0].mode == M_BAY { return g_bay(g, out, u, q); }
  g[0].btn_n = 0;
  if g[0].mode == M_DRIVE { return dv_overlay(g, out, u, q); }
  if fr_front(g) { return fr_overlay(g, out, u, w, h); }   // the title, creation and credits screens (front.coax)
  if g[0].mode == M_BANNER {
    sweep := g[0].banner == B_SWEEP;
    ui_panel(g, u, -20, -20, w + 20, h + 20, ifx sweep then HEAT() else ink, 1);
    if sweep {
      n = ui_title_mid(out, n, "IMPERIAL SWEEP", w * 0.5, h * 0.46, 40 * k, paper);
      n = ui_mid(out, n, "Heat hit 100. Back at Sniper.", w * 0.5, h * 0.56, 12 * k, paper);
    } else {
      for i: 0..<3 { n = ui_heart(out, n, w * 0.5 + (cast(f32) i - 1) * 70 * k, h * 0.32, 52 * k, false, ink); }
      n = ui_title_mid(out, n, "YOU WENT DOWN", w * 0.5, h * 0.5, 40 * k, paper);
      n = ui_mid(out, n, "Back at Sniper with what you had when you last left it.", w * 0.5, h * 0.585, 12 * k, paper);
      n = ui_mid(out, n, "Banned pieces since then are lost.", w * 0.5, h * 0.625, 12 * k, paper);
    }
    return n;
  }
  if g[0].mode == M_MEMORY { return sb_memory_overlay(g, out, u, q); }   // the hologram and its captions (splice-battle.coax)
  return sb_restored_overlay(g, out, u, q);   // SCENE RESTORED, then the mission's teaser
}

// The landmarks moved from constants to the content tables (#13404): every value is the one the run
// was built and balanced with.
#test "the tables' places are the values the run was built with" {
  g := [1] SpGame.[SpGame.{}];
  g_reset(g[..]);
  #assert g[0].c[0].ok && g_places(g[..]);
  a := g[0].at;
  #assert a.rover_x == 6.0 && a.rover_z == 5.0 && a.post_x == 2.6 && a.post_z == 6.5 && abs(a.crate_x - 38.31) < 0.001 && abs(a.crate_z + 52.04) < 0.001 && a.start_x == 0.0 && a.start_z == 9.0;
  #assert a.rubble_z == -34.0 && a.wall_z == -351.0 && a.boss_x == 0.0 && a.boss_z == -406.0;
  #assert a.deck_x == 141.0 && a.deck_z0 == -204.0 && a.deck_z1 == -186.0 && DECK_Y == 0.9 && RAMP == 3.0;
  #assert a.bay_x == -100.0 && a.bay_z == 136.0 && a.mem_x == -100.0 && a.mem_z == 200.0;
  #assert a.vil_x == 175.0 && a.vil_z == -75.0 && a.vil_r == 7.0 && a.scan_z == -65.0 && a.rail_x == 175.0 && a.rail_z == -55.0;
  // the mine's picks stand in the garage's bays (#13505)
  px := [PICKS] f32.[-6, 6, 187, 5, 0, -143.92, -38.31, -104.65, 128.17, 143]; pz := [PICKS] f32.[-14, -13, 95, -20, -17, -156.44, -52.04, -90.35, -121, -199.5];
  for i: 0..<PICKS { #assert abs(pick_x(g[..], i) - px[i]) < 0.001 && abs(pick_z(g[..], i) - pz[i]) < 0.001; }
  // the rave round the garage's middle
  ax := [FOES] f32.[-4.4, 0.6, 5.6, -1.4, -20.4, 10.1, -22.4, -22.4, -36.4]; az := [FOES] f32.[-191.8, -195.8, -190.8, -188.8, -187.8, -188.8, -189.8, -200.8, -190.8];
  bx := [FOES] f32.[-4.4, 0.6, 5.6, -1.4, -20.4, 10.1, -17.4, -27.4, -36.4]; bz := [FOES] f32.[-191.8, -195.8, -190.8, -188.8, -187.8, -200.8, -189.8, -200.8, -200.8];
  for i: 0..<FOES { #assert abs(foe_ax(g[..], i) - ax[i]) < 0.001 && abs(foe_az(g[..], i) - az[i]) < 0.001 && abs(foe_bx(g[..], i) - bx[i]) < 0.001 && abs(foe_bz(g[..], i) - bz[i]) < 0.001; }
  // the village start and the rail stop are worked out from other places; their landmarks say the same
  c := g[0].c[..];
  #assert g[0].px == sc_mark(c, LM_VIL_START).x && g[0].pz == sc_mark(c, LM_VIL_START).z;
  stop := rail_at(g[..], T_RAIL_PING);
  #assert abs(stop.x + 2.6 - sc_mark(c, LM_RAIL_STOP).x) < 0.01 && stop.z == sc_mark(c, LM_RAIL_STOP).z;
  // the tables outlive a reset, and a landmark the game needs must be in them
  g_reset(g[..]); #assert g[0].c[0].ok && g[0].at.rover_x == 6.0;
  g[0].c[0].mark_n = 3; #assert !g_places(g[..]);
}
#test "the right cut opens the rubble and the wrong cut does not" {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  for i: 0..<5 { g[0].have[i] = true; }
  for i: 0..<3 { g[0].slot[i] = true; }
  g[0].bot = true; g_bot_home(g[..]);
  g[0].strip[0] = H_DRILL; g[0].strip[1] = H_MOVE; g[0].strip_n = 2;
  g_deploy(g[..]);
  #assert g[0].bot_state == BOT_GO;          // it leaves your side for its work
  for i: 0..<400 { g_bot(g[..], 0.05); }
  #assert !g[0].rubble_gone && g[0].bot_state == BOT_FOLLOW && dist2(g[0].bot_x, g[0].bot_z, g[0].px, g[0].pz) < 3;   // and comes back
  g[0].strip[0] = H_MOVE; g[0].strip[1] = H_DRILL;
  g_deploy(g[..]);
  for i: 0..<400 { g_bot(g[..], 0.05); }
  #assert g[0].rubble_gone && g[0].phase == PH_DUSK;
  // the blocked hallway: no card of Digger's breaks it, DRILL+ neither; only the drill mech (splice-battle.coax)
  g[0].px = 3; g[0].pz = g[0].at.wall_z + 14; g_bot_home(g[..]);
  g_deploy(g[..]);
  for i: 0..<400 { g_bot(g[..], 0.05); }
  #assert !g[0].wall_gone && g[0].msg == SBM_NEED_MECH;
  g[0].have[H_PLUS] = true; g[0].strip[1] = H_PLUS;
  g_deploy(g[..]);
  for i: 0..<400 { g_bot(g[..], 0.05); }
  #assert !g[0].wall_gone && g[0].msg == SBM_NEED_MECH;
}
#test "the Digger will not deploy until all three hardware slots are filled" {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  for i: 0..<5 { g[0].have[i] = true; }
  g_place(g[..], H_MOVE, -1); g_place(g[..], H_ARM, -1); g_place(g[..], H_TREADS, -1);
  g_deploy(g[..]);
  #assert g[0].bot && g[0].bot_state == BOT_FOLLOW && g[0].msg == MSG_NEED;   // Digger is with you, but can't dig yet
  g_place(g[..], H_BATTERY, -1);
  #assert g[0].bot && g[0].bot_state == BOT_FOLLOW;
  g_deploy(g[..]);
  #assert g[0].bot_state == BOT_GO;
}
#test "a fight Digger wins drops a robot piece; Heat 100 brings the sweep; Sniper gives back only what it kept" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 8);          // night: two robot pieces and a cell, none of them kept at Sniper
  g[0].heat = 90; g[0].px = g[0].fx[0] + 3; g[0].pz = g[0].fz[0]; g_bot_home(g[..]);
  g[0].dr[0].task = DJ_FIGHT; g[0].dr[0].task_i = 0;   // pointed at raider 1 (d_point)
  for i: 0..<200 { g_step(g[..], 0.02); if g[0].mode != M_PLAY { break; } }
  #assert g[0].fhp[0] == 0 && g[0].scrap == 3 && g[0].mode == M_BANNER && g[0].banner == B_SWEEP;
  #assert g[0].dr[0].hp.hp < T_DIGGER_HP && !d_down(g[..]);   // it struck back once
  for i: 0..<300 { g_step(g[..], 0.02); }
  #assert g[0].mode == M_PLAY && g[0].heat == 0 && g[0].scrap == 0 && g[0].cells == 0 && !g[0].taken[PICK_CELL] && g[0].fhp[0] == T_RAIDER_HP;
  #assert g[0].have[H_MOVE] && g[0].slot[0] && g[0].pz == g[0].at.rover_z && g[0].bot;
}
#test "raiders dance until hit; an Imperial robot notices and chases" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 8); g[0].heat = 0;
  g[0].px = g[0].fx[1] + 1.5; g[0].pz = g[0].fz[1];
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !g[0].fhost[1] && g[0].hearts == T_HEARTS && dist2(g[0].fx[1], g[0].fz[1], foe_ax(g[..], 1), foe_az(g[..], 1)) < 0.1;
  g[0].px = g[0].fx[5] - 3; g[0].pz = g[0].fz[5] + 1;       // on the floor beside its patrol (the catwalk would be safe)
  g_step(g[..], 0.02);
  #assert g[0].fhost[5];
}
#test "walls stop the smuggler, and the catwalk is reached by its ramps" {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  g[0].px = -3.9; g[0].pz = -6; g_collide(g[..]);          // pressed against the mine mouth's left wall
  #assert g[0].px >= -4 + T_RADIUS - 0.001;
  g[0].px = 0; g[0].pz = g[0].at.rubble_z + 1.2; g_collide(g[..]);    // the rubble blocks the tunnel until it is drilled
  #assert g[0].pz >= g[0].at.rubble_z + 1 + T_RADIUS - 0.001;
  g[0].px = g[0].at.deck_x - 0.3; g[0].pz = (g[0].at.deck_z0 + g[0].at.deck_z1) * 0.5; g_collide(g[..]);    // the rail between the ramps
  #assert g[0].px <= g[0].at.deck_x - 0.12 - T_RADIUS + 0.001;
  g[0].px = g[0].at.deck_x - 0.3; g[0].pz = g[0].at.deck_z1 - 1; g_collide(g[..]);   // a ramp is open
  #assert g[0].px == g[0].at.deck_x - 0.3 && ground_y(g[..], g[0].at.deck_x, g[0].at.deck_z1 - 1) == DECK_Y && ground_y(g[..], g[0].at.deck_x - 1.5, (g[0].at.deck_z0 + g[0].at.deck_z1) * 0.5) == 0;
}
#test "a stunned weak point wakes, so all three must be down together" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10); g[0].stun[0] = 0; g[0].boss_t = 0;
  g_step(g[..], 0.02);
  w := weak_at(g[..], 0); g[0].px = w.x; g[0].pz = w.z + 1.0;
  _ = g_key(g[..], 'f', true);
  #assert g[0].stun[0] <= 0;                                // shut while it stands firm
  g[0].bt[0].daze = 2;                                      // dazed (after a charge): they open
  #assert g_key(g[..], 'f', true) && g[0].stun[0] > 0 && !g[0].boss_down;
  g[0].px = 9; g[0].pz = -64;                               // out of the arm's reach
  for i: 0..<700 { g_step(g[..], 0.02); }
  #assert g[0].stun[0] <= 0;
}
// Hold W from the mine's start: through the mouth and the scrap room to the rubble.
#test "walking forward from the start reaches the rubble and stops there" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  #assert g_key(g[..], 'w', true);
  for i: 0..<600 { g_step(g[..], 0.02); }
  #assert abs(g[0].px) < 0.01 && abs(g[0].pz - (g[0].at.rubble_z + 1 + T_RADIUS)) < 0.01;
}
// The hoverboard (#13485): only when the world's board table gives it; everything on Q (#13505).
sp_q :: (g: [] SpGame) -> bool { t := g_key(g, 'q', true); _ := g_key(g, 'q', false); return t; }
#test "the board: Q calls it only when the world gives one, Q switches casual and fast, Q Q is super fast, holding Q steps off; Ctrl and W W do nothing" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  g[0].c[0].board = board_row_read(1, "off", 700, 2200);
  #assert !g_board_given(g[..]) && !sp_q(g[..]) && !g_riding(g[..]);   // no board: Q does nothing
  g[0].c[0].board = board_row_read(1, "on", 700, 2200);
  #assert sp_q(g[..]) && g_riding(g[..]) && !g[0].board[0].fast && !g[0].dr[0].super;
  // the open ground of the mine's mouth toward the scrap room: casual first
  g[0].px = 0; g[0].pz = -3; g[0].yaw = PI; g[0].board[0].m.x = 0; g[0].board[0].m.z = -3;
  #assert g_key(g[..], 'w', true);
  for i: 0..<60 { g_step(g[..], 1.0f32 / 60); }
  #assert abs(g[0].board[0].m.speed - 7) < 0.01 && g[0].pz < -6;
  // the rubble stops it head on, and its speed goes into the wall
  for i: 0..<600 { g_step(g[..], 1.0f32 / 60); }
  #assert g[0].pz >= g[0].at.rubble_z + 1 + T_RADIUS - 0.01 && g[0].board[0].m.speed < 1;
  // Ctrl and a double tap of W are no longer the board's
  _ = g_key(g[..], -14, true); _ = g_key(g[..], 'w', false); _ = g_key(g[..], 'w', true); _ = g_key(g[..], 'w', false); _ = g_key(g[..], 'w', true);
  g_step(g[..], 1.0f32 / 60); #assert !g[0].board[0].fast; _ = g_key(g[..], -14, false);
  // Q: fast, and the view widens
  #assert sp_q(g[..]); g_step(g[..], 1.0f32 / 60);
  #assert g[0].board[0].fast && !g[0].dr[0].super && g_camera(g[..]).fov == board_fov(g[0].board[0], 0.82);
  for i: 0..<30 { g_step(g[..], 1.0f32 / 60); }
  #assert sp_q(g[..]); g_step(g[..], 1.0f32 / 60);
  #assert !g[0].board[0].fast;   // Q again: casual
  for i: 0..<30 { g_step(g[..], 1.0f32 / 60); }
  // a double tap: super fast, its tune past very fast
  #assert sp_q(g[..]); g_step(g[..], 1.0f32 / 60); #assert sp_q(g[..]); g_step(g[..], 1.0f32 / 60);
  #assert g[0].dr[0].super && g[0].board[0].fast && g_board_tune(g[..]).gallop > 22.1;
  // a key repeat while Q is held is not a press
  for i: 0..<30 { g_step(g[..], 1.0f32 / 60); }
  #assert g_key(g[..], 'q', true) && !g[0].dr[0].super && g_key(g[..], 'q', true) && !g[0].dr[0].super && g_riding(g[..]);
  // held: off the board where it is, and walking takes over
  z := g[0].pz;
  for i: 0..<40 { g_step(g[..], 1.0f32 / 60); }
  #assert !g_riding(g[..]) && abs(g[0].pz - z) < 0.5;
  _ = g_key(g[..], 'q', false);
  // the edit bay, or the world taking the board away, puts you on your feet
  #assert sp_q(g[..]) && g_riding(g[..]);
  g[0].c[0].board = board_row_read(1, "off", 700, 2200); g_step(g[..], 1.0f32 / 60); #assert !g_riding(g[..]) && !sp_q(g[..]);
}
#test "the board at very fast reaches its speed on the open desert, carves, and the view widens" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].zone = Z_RAIL; g[0].mode = M_PLAY;
  c := rail_at(g[..], T_RAIL_PING); g[0].px = c.x + 6; g[0].pz = c.z - 20; g[0].yaw = 0;   // beside the stopped rover
  g[0].c[0].board = board_row_read(1, "on", 700, 2200);
  // Q up, Q fast
  #assert sp_q(g[..]); g_step(g[..], 1.0f32 / 60); g_step(g[..], 1.0f32 / 60); g_step(g[..], 1.0f32 / 60);
  for i: 0..<20 { g_step(g[..], 1.0f32 / 60); }
  #assert sp_q(g[..]) && g_key(g[..], 'w', true);
  top := 0.0f32; for i: 0..<150 { g_step(g[..], 1.0f32 / 60); if g[0].board[0].m.speed > top { top = g[0].board[0].m.speed; } }
  #assert top > 15 && g[0].board[0].rush > 0.3 && g_camera(g[..]).fov > 0.85;
  y0 := g[0].yaw; #assert g_key(g[..], 'd', true);
  for i: 0..<20 { g_step(g[..], 1.0f32 / 60); }
  #assert g[0].yaw < y0 && g[0].board[0].lean > 0.1;
}
// ---- The Director's systems (director.coax, #13505 part A)
#test "Shift sneaks: she walks slower and an Imperial robot senses her from half as far; Heat makes it farther" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].px = 0; g[0].pz = 0; g[0].yaw = PI;
  #assert g_key(g[..], 'w', true);
  for i: 0..<50 { g_step(g[..], 0.02); }
  walked := -g[0].pz;
  _ = g_key(g[..], 'w', false); g[0].pz = 0;
  #assert g_key(g[..], -13, true) && d_sneaking(g[..]) && g_key(g[..], 'w', true);
  for i: 0..<50 { g_step(g[..], 0.02); }
  #assert abs(walked - T_WALK) < 0.05 && abs(-g[0].pz - T_WALK * STANCE_SNEAK_PACE) < 0.05;
  #assert g_camera(g[..]).eye.y < 4.0;   // the view sinks
  _ = g_key(g[..], 'w', false);
  // an Imperial robot that notices from 5 m: at 4 m it sees her standing, not sneaking; with Heat it does again
  h := [1] SpGame.[SpGame.{}];
  g_stage(h[..], 8); h[0].heat = 0;
  h[0].px = h[0].fx[5] - 4; h[0].pz = h[0].fz[5];
  #assert g_key(h[..], -13, true);
  g_step(h[..], 0.02);
  #assert !h[0].fhost[5] && d_noticed(h[..], 5) == 2.5;
  h[0].heat = 60; h[0].px = h[0].fx[5] - 4; h[0].pz = h[0].fz[5];
  g_step(h[..], 0.02);
  #assert h[0].fhost[5];
  #assert g_key(h[..], -13, false) && !d_sneaking(h[..]) && d_noticed(h[..], 5) == 5 + 60 * T_NOTICE_HEAT;
}
#test "Heat never cools below what the banned pieces with her hold it at" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].have[H_PLUS] = true; g[0].heat = 60;
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z;
  for i: 0..<600 { g_step(g[..], 0.02); }
  #assert g[0].heat == T_HEAT_PIECE && d_banned(g[..]) == 1;
  g[0].have[H_CORE] = true; g_step(g[..], 0.02);
  #assert g[0].heat == 2 * T_HEAT_PIECE;
}
#test "Digger picks up any part in his sensor's range himself; a better sensor widens it" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  g[0].taken[H_TREADS] = true; g[0].taken[H_DRILL] = true;   // out of the way: the arm, the sensor and the MOVE card are left
  #assert g[0].bot && !d_down(g[..]) && d_range(g[..]) == T_SENSE;
  // the Drill Arm 8 m west of her in the scrap room (Digger is a step behind her): out of his range, so it stays
  g[0].px = pick_x(g[..], H_ARM) + 8; g[0].pz = pick_z(g[..], H_ARM); g[0].yaw = -PI / 2; g_bot_home(g[..]);
  for i: 0..<150 { g_step(g[..], 0.02); }
  #assert !g[0].have[H_ARM] && !g[0].taken[H_ARM] && dist2(g[0].bot_x, g[0].bot_z, pick_x(g[..], H_ARM), pick_z(g[..], H_ARM)) > T_SENSE;
  // a few steps nearer: he goes for it and it is hers
  g[0].px = pick_x(g[..], H_ARM) + 1.8;
  for i: 0..<150 { g_step(g[..], 0.02); if g[0].have[H_ARM] { break; } }
  #assert g[0].have[H_ARM] && g[0].taken[H_ARM] && g[0].dr[0].task == DJ_NONE && d_carry(g[..]).n == 2;   // the Battery and the arm
  // the better sensor lies in the scrap room; he fits it himself, and it isn't in her inventory
  m := sc_mark(g[0].c[..], LM_SENSOR);
  #assert m.id == LM_SENSOR && d_sensor_here(g[..]);
  g[0].px = m.x + 1; g[0].pz = m.z + 2; g[0].yaw = 0; g_bot_home(g[..]);
  for i: 0..<200 { g_step(g[..], 0.02); if g[0].dr[0].sensor { break; } }
  #assert g[0].dr[0].sensor && d_range(g[..]) == T_SENSE_UP && !d_sensor_here(g[..]) && d_carry(g[..]).n == 2;
  // now the MOVE card over 7 m from him is in his range
  g[0].px = pick_x(g[..], H_MOVE); g[0].pz = pick_z(g[..], H_MOVE) + 5.5; g[0].yaw = PI; g_bot_home(g[..]);
  #assert dist2(g[0].bot_x, g[0].bot_z, pick_x(g[..], H_MOVE), pick_z(g[..], H_MOVE)) > 7;
  for i: 0..<200 { g_step(g[..], 0.02); if g[0].have[H_MOVE] { break; } }
  #assert g[0].have[H_MOVE];
}
#test "the inventory has T_ROOM slots: a full one leaves parts on the ground, a drop makes room, and Digger leaves what she dropped" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  for i: 0..<5 { if i != H_TREADS { g[0].have[i] = true; g[0].taken[i] = true; } }
  g[0].scrap = 1; g[0].cells = 1; g[0].taken[PICK_CELL] = true;
  c := d_carry(g[..]);
  #assert c.n == T_ROOM && carry_free(c) == 0 && c.items[0].kind == H_ARM && c.items[c.n - 1].kind == DK_SCRAP;
  // the Treads in reach: he leaves them, and says so
  g[0].px = pick_x(g[..], H_TREADS) - 1.5; g[0].pz = pick_z(g[..], H_TREADS) + 1; g_bot_home(g[..]);
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !g[0].have[H_TREADS] && g[0].dr[0].say == DS_FULL;
  // I opens the grid, the cursor is free, and a click on the first slot drops the Drill Arm at her feet
  #assert g_key(g[..], 'i', true) && g[0].dr[0].bag && g_mouselook(g[..]) == 1;
  d := g[0].dr[0]; b := carry_cell(0, 3, d.bag_x, d.bag_y, d.bag_s, d.bag_gap);
  #assert g_pointer(g[..], (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5, 0);
  #assert !g[0].have[H_ARM] && !g[0].taken[H_ARM] && g[0].dr[0].left[H_ARM] && dist2(pick_x(g[..], H_ARM), pick_z(g[..], H_ARM), g[0].px, g[0].pz) < 1;
  #assert g_key(g[..], -1, true) && !g[0].dr[0].bag && !g[0].dr[0].paused;   // Esc closes the grid
  // now the Treads fit, and the dropped arm stays where she left it
  for i: 0..<150 { g_step(g[..], 0.02); }
  #assert g[0].have[H_TREADS] && !g[0].have[H_ARM];
  // the core stays with her
  g[0].have[H_CORE] = true; c = d_carry(g[..]);
  for i: 0..<c.n { if c.items[i].kind == H_CORE { #assert !d_drop(g[..], i) && g[0].have[H_CORE]; } }
}
#test "a left click points Digger: he fetches a part, digs the rubble and fights a foe" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5);
  // the DRILL card 5.8 m ahead, under the crosshair
  g[0].px = pick_x(g[..], H_DRILL); g[0].pz = pick_z(g[..], H_DRILL) + 5.8; g[0].yaw = PI; g_bot_home(g[..]);
  g[0].look_free = false;
  #assert d_pointed(g[..]).kind == DP_PICK && d_pointed(g[..]).i == H_DRILL;
  #assert g_pointer(g[..], 0, 0, 0) && g[0].dr[0].task == DJ_FETCH;
  for i: 0..<200 { g_step(g[..], 0.02); if g[0].have[H_DRILL] { break; } }
  #assert g[0].have[H_DRILL];
  // nothing there
  g[0].yaw = 0; g[0].px = 0; g[0].pz = 4;
  #assert d_point(g[..]) == DP_NONE && g[0].dr[0].say == DS_NOTHING;
  // the rubble: with his parts and a cut, he goes to dig it
  for i: 0..<3 { g[0].have[i] = true; g[0].slot[i] = true; }
  g[0].have[H_MOVE] = true; g[0].strip[0] = H_MOVE; g[0].strip[1] = H_DRILL; g[0].strip_n = 2;
  g[0].px = 0; g[0].pz = g[0].at.rubble_z + 4; g[0].yaw = PI; g_bot_home(g[..]);
  #assert d_point(g[..]) == DP_DIG && g[0].bot_state == BOT_GO;
  // a foe under the crosshair: he fights it
  g[0].bot_state = BOT_FOLLOW;
  g[0].fx[5] = 0; g[0].fz[5] = -18; g[0].px = 0; g[0].pz = -18 + 5.8; g[0].yaw = PI; g_bot_home(g[..]);
  #assert d_point(g[..]) == DP_FOE && g[0].dr[0].task == DJ_FIGHT && g[0].dr[0].task_i == 5;
}
#test "F stuns a robot within 2 m and does no harm; past 2 m it does nothing" {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 8);
  g[0].px = g[0].fx[5] - 1.8; g[0].pz = g[0].fz[5];
  #assert g_key(g[..], 'f', true) && g[0].fstag[5] == T_FOE_STUN && g[0].fhp[5] == T_IMPERIAL_HP;
  g[0].px = g[0].fx[6] - 2.3; g[0].pz = g[0].fz[6];
  #assert g_key(g[..], 'f', true) && g[0].fstag[6] == 0;
}
#test "Digger at zero powers down where he is; E tows him, and Sniper's charger brings him back up" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].px = 0; g[0].pz = -14; g_bot_home(g[..]);
  d_bot_hurt(g[..], 4);
  #assert !d_down(g[..]) && vitals_share(g[0].dr[0].hp) == 0.6;
  d_bot_hurt(g[..], 7);
  #assert d_down(g[..]) && d_point(g[..]) == DP_NONE && g[0].dr[0].say == DS_DOWN;
  x := g[0].bot_x; z := g[0].bot_z;
  for i: 0..<50 { g_step(g[..], 0.02); }
  #assert g[0].bot_x == x && g[0].bot_z == z;   // he stays put
  g_deploy(g[..]);
  #assert g[0].bot_state == BOT_FOLLOW;          // and digs nothing
  #assert g_key(g[..], 'e', true) && g[0].dr[0].task == DJ_TOW;
  // she walks him to Sniper
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z + 2;
  for i: 0..<400 { g_step(g[..], 0.02); }
  #assert !d_down(g[..]) && g[0].dr[0].hp.hp == T_DIGGER_HP && g[0].dr[0].task == DJ_NONE;
}
#test "at zero health she is back at Sniper with what she had when she last left it: banned pieces since are lost" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z; g_step(g[..], 0.02);   // at Sniper: kept
  g[0].px = 0; g[0].pz = -40; g_step(g[..], 0.02);                                 // and away
  g_take(g[..], PICK_PLUS); g_take(g[..], PICK_CELL);
  #assert g[0].have[H_PLUS] && g[0].cells == 1;
  for i: 0..<T_HEARTS { g[0].hit_cool = 0; g_hurt(g[..]); }
  #assert g[0].mode == M_BANNER && g[0].banner == B_CUT;
  for i: 0..<200 { g_step(g[..], 0.02); }
  #assert g[0].mode == M_PLAY && g[0].px == g[0].at.rover_x - 3 && g[0].pz == g[0].at.rover_z && g[0].hearts == T_HEARTS;
  #assert !g[0].have[H_PLUS] && !g[0].taken[PICK_PLUS] && g[0].cells == 0 && g[0].have[H_MOVE] && g[0].strip_n == 2;
}
#test "the key map: I, M, Esc pauses and resumes, Tab only in Sniper, 1 to 4 go to the battle, and the pointer let go pauses" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].px = 0; g[0].pz = 0;
  #assert g_key(g[..], 'm', true) && g[0].dr[0].map && g_key(g[..], 'i', true) && g[0].dr[0].bag && !g[0].dr[0].map;
  #assert g_key(g[..], 'i', true) && !g[0].dr[0].bag;
  // Esc: paused, nothing moves, and Esc again plays
  #assert g_key(g[..], 'w', true) && g_key(g[..], -1, true) && g[0].dr[0].paused && g_mouselook(g[..]) == 1;
  z := g[0].pz; for i: 0..<20 { g_step(g[..], 0.02); }
  #assert g[0].pz == z && !g[0].fwd;
  #assert g_key(g[..], 'w', true) && g[0].pz == z;   // keys wait
  #assert g_key(g[..], -1, true) && !g[0].dr[0].paused && g_mouselook(g[..]) == 2;
  // the pointer let go while she plays: paused; a click plays again
  g_lock(g[..], 0);
  #assert g[0].dr[0].paused;
  #assert g_pointer(g[..], 10, 10, 0) && !g[0].dr[0].paused;
  // Tab: the edit bay, but only in Sniper
  #assert g_key(g[..], -15, true) && g[0].mode == M_PLAY && g[0].dr[0].say == DS_BAY;
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z;
  #assert g_key(g[..], -15, true) && g[0].mode == M_BAY;
  #assert g_key(g[..], -15, true) && g[0].mode == M_PLAY;
  // 1 to 4: a bot's moves, handed to the battle once each
  #assert g_key(g[..], '2', true) && g_key(g[..], '4', true) && d_take_move(g[..]) == 4 && d_take_move(g[..]) == 4 && d_take_move(g[..]) == 0;
  // B no longer calls the board
  #assert !g_key(g[..], 'b', true) && !g_riding(g[..]);
}
// The jump: Space on foot is the engine walker's jump (metaverse-engine/move/walk.coax), onto the ground and onto pieces.
#test "Space jumps on foot: up about a metre and back down, onto a small crate and off it; on the board it hops the board, and in the bay it still splices" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].mode = M_PLAY;
  g[0].px = 20; g[0].pz = 12; g[0].yaw = PI;   // open ground east of the rover, facing south
  for i: 0..<10 { g_step(g[..], 1.0f32 / 60); }
  #assert !g_airborne(g[..]) && g_feet_y(g[..]) == 0;
  // a press lifts you; holding it never jumps again; you land where you jumped
  #assert g_key(g[..], ' ', true);
  peak := 0.0f32; frames := 0; landed := -1; eye0 := g_camera(g[..]).eye.y; eye := eye0;
  for i: 0..<90 {
    g_step(g[..], 1.0f32 / 60); peak = hi(peak, g[0].air[0].y); eye = hi(eye, g_camera(g[..]).eye.y);
    if g_airborne(g[..]) { frames += 1; } else if frames > 0 && landed < 0 { landed = i; }
  }
  #assert peak > 1.1 && peak < 1.25 && frames > 30 && frames < 45 && landed > 0;
  #assert eye - eye0 > 0.2 && eye - eye0 < 0.5;   // the view rises a third of the jump: steady, and under the dome's roof   // the walker's 7.5 m/s and 24 m/s^2: 1.17 m, 0.63 s
  #assert g[0].air[0].on_ground && g[0].air[0].y == 0 && g[0].air[0].presses.taken == 1 && g[0].px == 20 && g[0].pz == 12;
  _ = g_key(g[..], ' ', false);
  // a small crate (0.85 m tall) just south: walking stops at it, a jump goes over and lands on its top
  #assert sl_place(g[..], 117, 2000, 1060, 0).ok;
  _ = g_key(g[..], 'w', true);
  for i: 0..<40 { g_step(g[..], 1.0f32 / 60); }
  #assert abs(g[0].pz - (10.6 + 0.47 + T_RADIUS)) < 0.01 && g_feet_y(g[..]) == 0;   // stopped by its side
  _ = g_key(g[..], 'w', false); _ = g_key(g[..], ' ', true);
  for i: 0..<12 { g_step(g[..], 1.0f32 / 60); }   // up past its top
  #assert g_feet_y(g[..]) > 0.9;
  _ = g_key(g[..], 'w', true); _ = g_key(g[..], ' ', false);
  for i: 0..<10 { g_step(g[..], 1.0f32 / 60); }
  _ = g_key(g[..], 'w', false);
  for i: 0..<60 { g_step(g[..], 1.0f32 / 60); }
  #assert g[0].pz < 10.6 + 0.47 && g[0].pz > 10.6 - 0.47 && g[0].air[0].on_ground && abs(g_feet_y(g[..]) - 0.85) < 0.01;   // standing on it
  // walking on off its far side drops you to the ground
  _ = g_key(g[..], 'w', true);
  for i: 0..<20 { g_step(g[..], 1.0f32 / 60); }
  _ = g_key(g[..], 'w', false);
  for i: 0..<30 { g_step(g[..], 1.0f32 / 60); }
  #assert g[0].pz < 10.6 - 0.47 - T_RADIUS && g[0].air[0].on_ground && g_feet_y(g[..]) == 0;
  // on the hoverboard Space hops the board, not you
  g[0].c[0].board = board_row_read(1, "on", 700, 2200);
  #assert sp_q(g[..]) && g_riding(g[..]);
  taken := g[0].air[0].presses.taken;
  #assert g_key(g[..], ' ', true);
  for i: 0..<6 { g_step(g[..], 1.0f32 / 60); }
  #assert mount_jumping(g[0].board[0].m) && g_feet_y(g[..]) == 0 && g[0].air[0].presses.taken == taken;
  _ = g_key(g[..], ' ', false);
  #assert g_key(g[..], 'q', true);   // held: off the board
  for i: 0..<40 { g_step(g[..], 1.0f32 / 60); }
  _ = g_key(g[..], 'q', false); #assert !g_riding(g[..]);
  // in the edit bay Space is still SPLICE: it deploys the Digger (here, with no hardware, it says what it needs)
  g[0].mode = M_BAY; g[0].msg = MSG_NONE;
  #assert g_key(g[..], ' ', true) && g[0].mode == M_BAY && g[0].msg == MSG_NEED && g[0].air[0].presses.waiting == 0;
}
// The whole run with the keys a player presses; long walks are stood in for by placing the smuggler.
// 0 when it plays from the title to SCENE RESTORED and back, else the number of the beat that failed.
// The game keeps its edit layer through the run's reset, so this plays whatever layer g holds.
g_play_run :: (g: [] SpGame) -> int {
  g_reset(g);
  // the title's NEW RUN, then USE THIS CHARACTER on the creation screen
  if !(g_key(g, -2, true) && g[0].mode == M_CREW) { return 1; }
  if !(g_key(g, -2, true) && g[0].mode == M_PLAY && g[0].zone == Z_VILLAGE && g[0].phase == PH_DAWN) { return 1; }
  // the village: walk out through the scanner gate
  if !(g_key(g, 'w', true)) { return 2; }
  for i: 0..<500 { g_step(g, 0.02); }
  if !(g[0].zone == Z_RAIL && g[0].mode == M_RIDE && g[0].phase == PH_DAY) { return 3; }
  // the rail: the ping stops the rover; the Battery is at the marker
  for i: 0..<600 { g_step(g, 0.02); if g[0].mode == M_PLAY { break; } }   // off at the ping: the raider mech hears it too
  if !(g[0].mode == M_PLAY && g[0].rail_s == T_RAIL_PING) { return 4; }
  if !(g_key(g, 'w', false)) { return 5; }
  if !(g_key(g, 'e', true) && g[0].mode == M_PLAY) { return 6; }   // no boarding without what the sensor found
  // Digger picks up what his sensor finds: she only walks near it. On foot at the stop nothing hunts her
  g[0].px = pick_x(g, H_BATTERY); g[0].pz = pick_z(g, H_BATTERY) - 1;
  for i: 0..<200 { g_step(g, 0.02); if g[0].have[H_BATTERY] { break; } }
  if !(g[0].have[H_BATTERY] && g[0].hearts == T_HEARTS && !g[0].bt[0].rm_hunt) { return 7; }
  c := rail_at(g, T_RAIL_PING); g[0].px = c.x + 2.6; g[0].pz = c.z;
  if !(g_key(g, 'e', true) && g[0].mode == M_RIDE) { return 8; }
  // the drive: a raider mech gives chase, and she battles it from Sniper with Sniper's cards, keys 1 to 3
  for i: 0..<1000 { if sb_can_battle_rm(g) { break; } g_step(g, 0.02); }
  if !(g[0].bt[0].rm_hunt && g[0].mode == M_RIDE && g[0].msg == SBM_HUNT) { return 42; }
  if !(g_key(g, 'e', true) && sb_fighting(g) && sb_fielded(g) == SB_SNIPER) { return 43; }
  for i: 0..<2000 { if g[0].bt[0].rm_down { break; } _ = g_key(g, '1' + i % 3, true); g_step(g, 0.02); }
  if !(g[0].bt[0].rm_down && !sb_fighting(g) && g[0].scrap == 1 && g[0].mode == M_RIDE) { return 44; }
  for i: 0..<1000 { g_step(g, 0.02); }
  if !(g[0].zone == Z_MINE && g[0].mode == M_PLAY && g[0].pz == g[0].at.start_z) { return 9; }
  // the day mine: four pickups, then the edit bay
  picks := [4] int.[H_ARM, H_TREADS, H_MOVE, H_DRILL];
  for i: 0..<4 {
    g[0].px = pick_x(g, picks[i]); g[0].pz = pick_z(g, picks[i]) + 1;
    for j: 0..<200 { g_step(g, 0.02); if g[0].have[picks[i]] { break; } }
    if !(g[0].have[picks[i]]) { return 10; }
  }
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z; g_step(g, 0.02);
  if !(g_key(g, -15, true) && g[0].mode == M_BAY) { return 11; }
  if !(g_key(g, '4', true)) { return 12; } if !(g_key(g, '5', true)) { return 13; } if !(g_key(g, '6', true)) { return 14; }
  if !(g_key(g, '1', true)) { return 15; } if !(g_key(g, '2', true)) { return 16; } if !(g_key(g, -2, true)) { return 17; }
  if !(g[0].bot && g[0].bot_state == BOT_GO) { return 18; }
  for i: 0..<1500 { g_step(g, 0.02); }
  if !(g[0].rubble_gone && g[0].phase == PH_DUSK && g[0].bot_state == BOT_FOLLOW) { return 19; }
  // into the garage: still dusk (night falls with the boss). Its bays: a cell in HA, a fight, the one blue piece in G2.
  g[0].px = 0; g[0].pz = -37; g_step(g, 0.02);
  if !(g[0].phase == PH_DUSK) { return 20; }
  g[0].px = pick_x(g, PICK_CELL) + 1; g[0].pz = pick_z(g, PICK_CELL) - 1;
  for i: 0..<200 { g_step(g, 0.02); if g[0].cells == 1 { break; } }
  if !(g[0].cells == 1) { return 21; }
  // sneaking (Shift) is there, and the garage at dusk is quiet: the raiders are out scavenging and the
  // Imperial robots recharging at the solar farm, so no one is in the ring or its bays (#13505)
  if !(g_key(g, -13, true) && d_sneaking(g)) { return 22; }
  g[0].px = g[0].at.dance_x + 2; g[0].pz = g[0].at.dance_z; g_bot_home(g); g_step(g, 0.02);
  for i: 0..<FOES { if g_foe_in(g, i) || ga_inside(g, g[0].fx[i], g[0].fz[i]) || g[0].fhost[i] { return 23; } }
  _ = g_key(g, -13, false);
  g[0].px = pick_x(g, PICK_PLUS) + 1; g[0].pz = pick_z(g, PICK_PLUS) + 1;
  for i: 0..<200 { g_step(g, 0.02); if g[0].have[H_PLUS] { break; } }
  if !(g[0].have[H_PLUS] && g[0].heat == T_HEAT_PIECE) { return 24; }   // the one banned piece: +25 Heat
  g[0].heat = 40; g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z;
  for i: 0..<200 { g_step(g, 0.02); }
  if !(abs(g[0].heat - T_HEAT_PIECE) < 0.01) { return 25; }   // Heat cools at Sniper, to the banned piece's floor
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z; g_step(g, 0.02);
  if !(g_key(g, -15, true) && g[0].mode == M_BAY) { return 26; }   // the edit bay is in Sniper
  if !(g_key(g, 'c', true)) { return 27; } if !(g_key(g, '1', true)) { return 28; } if !(g_key(g, '3', true)) { return 29; } if !(g_key(g, -2, true)) { return 30; }
  for i: 0..<300 { g_step(g, 0.02); }   // Digger goes to the hallway and comes back: only the drill mech breaks it
  // the drill mech: Digger's core in, it follows her to the blocked hallway and drills it down
  g[0].px = g[0].bt[0].mech_x + 2; g[0].pz = g[0].bt[0].mech_z;
  if !(g_key(g, 'e', true) && g[0].bt[0].mech_core) { return 31; }
  g[0].px = 1; g[0].pz = g[0].at.wall_z + 3;
  for i: 0..<600 { g_step(g, 0.1); if i >= 40 && dist2(g[0].bt[0].mech_x, g[0].bt[0].mech_z, 0, g[0].at.wall_z + 1) < 12 { break; } }   // it walks over from the empty section
  if !(g_key(g, 'e', true) && g[0].bt[0].drill_t > 0) { return 32; }
  for i: 0..<400 { g_step(g, 0.02); }
  if !(g[0].wall_gone) { return 33; }
  // the boss: the mech battles it with keys 1 to 4; while it reels she stuns its three weak points
  g[0].px = 1.5; g[0].pz = g[0].at.wall_z - 3;
  for i: 0..<6000 {
    g_step(g, 0.02);
    if g[0].mode != M_PLAY || g[0].boss_down { break; }
    _ = g_key(g, '1' + i % 4, true);
    if sb_open(g) {
      for k: 0..<3 { if g[0].stun[k] <= 0 { w := weak_at(g, k); g[0].px = w.x + 0.3; g[0].pz = w.z + 0.3; _ = g_key(g, 'f', true); } }
      g[0].px = 1.5; g[0].pz = g[0].at.wall_z - 3;
    }
  }
  if !(g[0].boss_down && g[0].phase == PH_NIGHT && g[0].hearts > 0 && !sb_fighting(g)) { return 34; }
  co := sb_core_at(g); g[0].px = co.x; g[0].pz = co.z + 0.5;
  if !(g_key(g, 'e', true) && g[0].have[H_CORE]) { return 35; }
  // night: back to Sniper on foot by the shortcut through the rave, where the Imperial robots patrol (#13505)
  wk := [1] SwWalker.[SwWalker.{}];
  if !sp_night_walk(g, wk[..], false) { return 42; }
  if !(g[0].zone == Z_MINE && near_rover(g, T_SAVE_RANGE) && g[0].have[H_CORE]) { return 43; }
  // the ending (#13505): SPLICE CORE in Sniper's edit bay plays the 15-second hologram, then SCENE RESTORED, then the teaser
  if !(g_key(g, -15, true) && g[0].mode == M_BAY) { return 36; } if !(g_key(g, 'x', true)) { return 37; }
  if !(g[0].mode == M_MEMORY) { return 38; }
  for i: 0..<740 { g_step(g, 0.02); }
  if !(g[0].mode == M_MEMORY) { return 38; }   // the hologram holds its 15 seconds
  for i: 0..<20 { g_step(g, 0.02); }
  if !(g[0].mode == M_RESTORED && !g[0].bt[0].teaser) { return 39; }
  for i: 0..<cast(int) (SB_RESTORED / 0.02) + 2 { g_step(g, 0.02); }
  if !(g[0].mode == M_RESTORED && g[0].bt[0].teaser) { return 39; }
  if !(g_key(g, 'r', true)) { return 40; }
  if !(g[0].mode == M_PLAY && g[0].zone == Z_VILLAGE && !g[0].rubble_gone && g[0].hearts == T_HEARTS) { return 41; }
  return 0;
}
// Checkpoint and repair (#13505): Sniper is the checkpoint. Standing by it keeps what she carries; at
// zero she is back beside it with that, and banned pieces picked up since are lost. Heat cools 5 a
// second at Sniper and nowhere else, each banned piece is +25 and holds Heat up, and 100 is the top.
// Digger at zero powers down and Sniper's charger repairs him.
#test "checkpoint and repair: Sniper keeps her inventory, a respawn is beside it without the banned pieces picked up since, Heat cools 5 a second only there, and Sniper's charger repairs Digger" #steps 400000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);   // in the mine at dusk with Digger, his parts and cards
  #assert T_HEAT_COOL == 5 && T_HEAT_PIECE == 25 && T_HEAT_MAX == 100;
  // at Sniper: what she carries is kept
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z; g_step(g[..], 0.02);
  #assert !g[0].save.have[H_PLUS];
  // out in the garage she picks up the DRILL+ (+25 Heat); it doesn't cool away from Sniper, not even at the stash crate
  g[0].px = pick_x(g[..], PICK_PLUS) + 1; g[0].pz = pick_z(g[..], PICK_PLUS) + 1;
  for i: 0..<200 { g_step(g[..], 0.02); if g[0].have[H_PLUS] { break; } }
  #assert g[0].have[H_PLUS] && g[0].heat == T_HEAT_PIECE;
  g[0].heat = 60; g[0].px = g[0].at.crate_x + 2; g[0].pz = g[0].at.crate_z;
  for i: 0..<50 { g_step(g[..], 0.02); }
  #assert g[0].heat == 60;
  // at Sniper it cools 5 a second, down to the piece's 25
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z;
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert abs(g[0].heat - 50) < 0.2;
  for i: 0..<500 { g_step(g[..], 0.02); }
  #assert abs(g[0].heat - T_HEAT_PIECE) < 0.01 && g[0].save.have[H_PLUS];   // kept: it was with her at Sniper
  // a second banned piece picked up away from Sniper (the core) is lost at zero; the kept DRILL+ isn't
  g[0].px = 0; g[0].pz = -100; g_step(g[..], 0.02);
  g[0].have[H_CORE] = true; g[0].core_taken = true; g_step(g[..], 0.02);
  #assert g[0].heat >= 2 * T_HEAT_PIECE;
  g[0].hearts = 0; g_respawn(g[..]);
  #assert dist2(g[0].px, g[0].pz, g[0].at.rover_x, g[0].at.rover_z) < T_SAVE_RANGE && g[0].have[H_PLUS] && !g[0].have[H_CORE] && !g[0].core_taken && g[0].hearts == T_HEARTS;
  // Heat at the top: the sweep, and back at Sniper
  g[0].px = 0; g[0].pz = -100; g[0].heat = T_HEAT_MAX; g_step(g[..], 0.02);
  #assert g[0].mode == M_BANNER && g[0].banner == B_SWEEP;
  for i: 0..<400 { g_step(g[..], 0.02); if g[0].mode == M_PLAY { break; } }
  #assert g[0].mode == M_PLAY && dist2(g[0].px, g[0].pz, g[0].at.rover_x, g[0].at.rover_z) < T_SAVE_RANGE;
  // Digger at zero powers down where he is; towed to Sniper, its charger repairs him
  g[0].px = 0; g[0].pz = -60; g_bot_home(g[..]); g_step(g[..], 0.02);
  d_bot_hurt(g[..], T_DIGGER_HP);
  #assert d_down(g[..]);
  g[0].bot_x = g[0].at.rover_x - 2; g[0].bot_z = g[0].at.rover_z; g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z + 1;
  for i: 0..<400 { g_step(g[..], 0.02); if !d_down(g[..]) { break; } }
  #assert !d_down(g[..]);
}
// The night return (#13505): after the boss, back to Sniper on foot, the long way round the field's
// edge under the rim, past the bays, or the shortcut across the field through the rave, where the
// Imperial robots patrol. Each is a list of places, walked with the walk replay's walker (walk.coax).
SP_RAVE_WAY :: 5;
sp_rave_way :: (g: [] SpGame, i: int) -> Point {
  c := g[0].c[..];
  ids := [SP_RAVE_WAY] int.[73, 16, 63, 62, 61];   // the hallway's mouth, the dance floor, the field by A1, the tunnel, Sniper's door
  m := sc_mark(c, ids[i]); return v3(m.x, 0, m.z);
}
SP_LONG_WAY :: 10;
sp_long_way :: (g: [] SpGame, i: int) -> Point {
  c := g[0].c[..];
  if i == 0 { m := sc_mark(c, 73); return v3(m.x, 0, m.z); }
  if i >= SP_LONG_WAY - 3 { ids := [3] int.[63, 62, 61]; m := sc_mark(c, ids[i - (SP_LONG_WAY - 3)]); return v3(m.x, 0, m.z); }
  // round the east side of the field, a few metres in from the bays: from the hallway's side (south) to the entry's (north)
  return ga_pt(g, PI - cast(f32) i * PI / cast(f32) (SP_LONG_WAY - 3), g[0].at.gar_r - 6, 0);
}
sp_way_at :: (g: [] SpGame, long: bool, i: int) -> Point { return ifx long then sp_long_way(g, i) else sp_rave_way(g, i); }
sp_way_n :: (long: bool) -> int { return ifx long then SP_LONG_WAY else SP_RAVE_WAY; }
// Walks from the core to Sniper's door one way; false when a place on it can't be reached.
sp_night_walk :: (g: [] SpGame, k: [] SwWalker, long: bool) -> bool {
  for i: 0..<sp_way_n(long) { p := sp_way_at(g, long, i); if !sw_walk(g, k, p.x, p.z, 1.2) { return false; } }
  return true;
}
// The nearest any leg of a way comes to a segment from (ax, az) to (bx, bz).
sp_seg_gap :: (px: f32, pz: f32, ax: f32, az: f32, bx: f32, bz: f32) -> f32 {
  dx := bx - ax; dz := bz - az; l := dx * dx + dz * dz;
  t := ifx l > 0.0001 then lo(1, hi(0, ((px - ax) * dx + (pz - az) * dz) / l)) else 0.0f32;
  return dist2(px, pz, ax + dx * t, az + dz * t);
}
sp_way_gap :: (g: [] SpGame, long: bool, i: int) -> f32 {
  pl := sc_plan(g[0].c[..], i, PH_NIGHT); best := 1e9f32;
  for w: 0..<sp_way_n(long) - 1 {
    a := sp_way_at(g, long, w); b := sp_way_at(g, long, w + 1);
    n := cast(int) (dist2(a.x, a.z, b.x, b.z) / 0.5) + 1;
    for s: 0..<n + 1 {
      f := cast(f32) s / cast(f32) n; x := a.x + (b.x - a.x) * f; z := a.z + (b.z - a.z) * f;
      for q: 0..<pl.n { e := ifx q + 1 < pl.n then q + 1 else q; best = lo(best, sp_seg_gap(x, z, mp_m(pl.x[q]), mp_m(pl.z[q]), mp_m(pl.x[e]), mp_m(pl.z[e]))); }
    }
  }
  return best;
}
#test "the night return: both ways back to Sniper walk through; the rave's way crosses the Imperial robots' night patrols, the long way stays out of their sensing" #steps 4000000000 #traversal 2000000000 {
  g := [1] SpGame.[SpGame.{}]; k := [1] SwWalker.[SwWalker.{}];
  // after the boss: night, the core and the DRILL+ with her (Heat 50, two banned pieces)
  for long: [2] bool.[false, true] {
    g_stage(g[..], 10); g[0].boss_down = true; g[0].phase = PH_NIGHT; g[0].have[H_CORE] = true; g[0].heat = 50;
    co := sb_core_at(g[..]); g[0].px = co.x; g[0].pz = co.z + 0.5; g_step(g[..], 0.02);
    #assert sp_night_walk(g[..], k[..], long) && near_rover(g[..], T_SAVE_RANGE);
  }
  // every patrol point is ground a foe stands on, and the sensing at Heat 50: 8.5 m walking, half sneaking
  far := d_noticed(g[..], T_NOTICE); #assert abs(far - 8.5) < 0.01;
  crossed := 0;
  for i: F_RAIDERS..<FOES {
    pl := sc_plan(g[0].c[..], i, PH_NIGHT);
    for q: 0..<pl.n { s := sl_push(g[..], mp_m(pl.x[q]), mp_m(pl.z[q]), 0.45, true); #assert abs(s.x - mp_m(pl.x[q])) < 0.01 && abs(s.z - mp_m(pl.z[q])) < 0.01; }
    #assert sp_way_gap(g[..], true, i) > far + 20;     // the long way: well out of sensing
    if sp_way_gap(g[..], false, i) < 0.5 { crossed += 1; }   // the rave: its patrol walks across the way
  }
  #assert crossed >= 2;
}
// The garage at dusk is quiet (#13505): the raiders are out scavenging and the Imperial robots recharging
// at the solar farm, so no plan puts anyone in the ring or its bays; at night they are back, the
// raiders at the party (passive) and the Imperial robots patrolling the rave.
#test "the garage at dusk: every foe's dusk plan is out of the ring, no one is there to see or sense her; at night the rave has its patrols" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);
  #assert g[0].phase == PH_DUSK && g[0].zone == Z_MINE;
  for i: 0..<FOES { #assert g_plan_out(g[..], sc_plan(g[0].c[..], i, PH_DUSK)) && !g_plan_out(g[..], sc_plan(g[0].c[..], i, PH_NIGHT)); }
  // across the field to the dance floor and round the ring's edge with two banned pieces' Heat: nobody comes
  g[0].heat = 50; g[0].have[H_PLUS] = true; g[0].have[H_CORE] = true;
  g[0].px = g[0].at.dance_x + 1; g[0].pz = g[0].at.dance_z;
  for i: 0..<200 { g_step(g[..], 0.02); }
  for k: 0..<GA_SECTIONS { e := ga_at(g[..], k, g[0].at.gar_r - 4); g[0].px = e.x; g[0].pz = e.z; for i: 0..<20 { g_step(g[..], 0.02); } }
  for i: 0..<FOES { #assert !g_foe_in(g[..], i) && !ga_inside(g[..], g[0].fx[i], g[0].fz[i]) && !g[0].fhost[i]; }
  #assert g[0].hearts == T_HEARTS && g_foe_near(g[..]) < 0;
  // night falls: everyone is back in the garage where the night plan starts it, the Imperial robots on patrol by the rave
  g[0].phase = PH_NIGHT; g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z; g_step(g[..], 0.02);
  for i: 0..<FOES {
    #assert g_foe_in(g[..], i) && ga_inside(g[..], g[0].fx[i], g[0].fz[i]);
    pl := sc_plan(g[0].c[..], i, PH_NIGHT);
    if i >= F_RAIDERS { #assert pl.act == NPD_PATROL && pl.notice > 0 && dist2(g[0].fx[i], g[0].fz[i], g[0].at.dance_x, g[0].at.dance_z) < 40; }
    else { #assert pl.notice == 0; }   // raiders party, passive
  }
}
#test "the run plays from the title to SCENE RESTORED" #steps 800000000 {
  g := [1] SpGame.[SpGame.{}];
  #assert g_play_run(g[..]) == 0;
}
FlowTest :: struct { o: [4] [CT_BODY] u8; }
#test "a world's starts, beats and portals: the run starts where a row says, the day moves on in an area, and E at a placed piece's kind takes you through (#13485)" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}]; k := [1] FlowTest.[FlowTest.{}];
  t := sc_swap("table starts id when:text at:text yaw:int\n", "table starts id when:text at:text yaw:int\n1|day|1500 3500|180\n", k[0].o[0][..]);
  t = sc_swap2(t, "table beats id area:int from:text to:text\n", "table beats id area:int from:text to:text\n1|5|day|dusk\n", k[0].o[1][..]);
  t = sc_swap2(t, "4|Mine|0|-20500|16000|22500|0\n", "4|Mine|0|-20500|16000|22500|0\n5|Mine mouth|0|-1000|800|800|0\n", k[0].o[2][..]);
  t = sc_swap2(t, "table portals id name:text from:text to:text yaw:int r:int\n", "table portals id name:text from:text to:text yaw:int r:int\n1|Enter the crate|kind 116|-1000 2500|90|300\n", k[0].o[3][..]);
  g_stage(g[..], 0);
  #assert sc_load(g[0].c[..], t) && g_places(g[..]);
  g_reset(g[..]);
  #assert g[0].mode == M_TITLE;
  g_begin(g[..]);   // NEW RUN on the title (front.coax)
  #assert g[0].mode == M_PLAY && g[0].zone == Z_MINE && g[0].phase == PH_DAY && g[0].px == 15 && g[0].pz == 35 && abs(g[0].yaw - PI) < 0.001;
  #assert g[0].have[H_BATTERY] && g[0].taken[H_BATTERY];   // past the rail, with the rail's Battery: the edit bay can build Digger's cut
  // walking into the mine mouth by day: dusk; and it stays dusk
  g[0].px = 0; g[0].pz = -6; g_step(g[..], 0.02);
  #assert g[0].phase == PH_DUSK;
  g[0].pz = 20; g_step(g[..], 0.02);
  #assert g[0].phase == PH_DUSK;
  // a respawn at a time of day with a start row goes there; at one without, to the checkpoint
  g[0].phase = PH_DAY; g_respawn(g[..]);
  #assert g[0].px == 15 && g[0].pz == 35;
  g[0].phase = PH_NIGHT; g_respawn(g[..]);
  #assert g[0].pz == g[0].at.rover_z && g[0].px == g[0].at.rover_x - 3;   // beside Sniper
  // E beside a placed crate takes you to the portal's place, facing its way; away from it, nothing
  #assert sl_place(g[..], 116, 2000, 1500, 0).ok;
  g[0].px = 20; g[0].pz = 12.8;
  #assert g_portal(g[..]) == 0 && g_key(g[..], 'e', true) && g[0].px == -10 && g[0].pz == 25 && abs(g[0].yaw - PI / 2) < 0.001;
  g[0].px = 20; g[0].pz = 11.5;
  #assert g_portal(g[..]) == -1;
  // a world with no rows plays as it always did: the dome village at dawn
  g2 := [1] SpGame.[SpGame.{}];
  g_stage(g2[..], 0);
  #assert g_key(g2[..], -2, true) && g2[0].zone == Z_VILLAGE && g2[0].phase == PH_DAWN && g_portal(g2[..]) == -1 && !g2[0].have[H_BATTERY];
}
#test "dragging a card onto a timeline slot places it there" {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 6);
  g[0].btn_n = 1; g[0].btn[0] = 0; g[0].btn[1] = 0; g[0].btn[2] = 10; g[0].btn[3] = 10; g[0].btn_key[0] = 1000 + H_DRILL;
  o := 4 * 4; g[0].drop[o] = 100; g[0].drop[o + 1] = 100; g[0].drop[o + 2] = 200; g[0].drop[o + 3] = 200;   // the cards row's slot 02
  #assert g_pointer(g[..], 5, 5, 0) && g[0].drag == H_DRILL;
  #assert g_pointer(g[..], 150, 150, 1);
  #assert g_pointer(g[..], 150, 150, 2) && g[0].drag == -1 && g[0].strip_n == 2 && g[0].strip[1] == H_DRILL;
}

// ---- Battles, the drill mech, the boss and the ending (splice-battle.coax, #13505 part C)
#test "the drill mech: E swaps Digger's core in, its lights turn his, it follows you, and only it drills the blocked hallway" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);   // dusk past the rubble, Digger built with MOVE and DRILL
  t := g[0].bt[..];
  #assert !t[0].mech_core && !sb_holds_digger(g[..]);
  g[0].px = 1; g[0].pz = g[0].at.wall_z + 3;                              // the hallway without the mech: nothing
  #assert g_key(g[..], 'e', true) && g[0].msg == SBM_NEED_MECH && t[0].drill_t == 0;
  g[0].px = t[0].mech_x + 2; g[0].pz = t[0].mech_z;
  #assert sb_prompt(g[..]).text == "Swap Digger's core into the drill mech";
  #assert g_key(g[..], 'e', true) && t[0].mech_core && sb_holds_digger(g[..]) && g[0].msg == SBM_CORE_IN;
  bx := g[0].bot_x; bz := g[0].bot_z;
  g[0].px = 0; g[0].pz = -48;
  for i: 0..<200 { g_step(g[..], 0.02); }
  #assert dist2(t[0].mech_x, t[0].mech_z, g[0].px, g[0].pz) < 5 && g[0].bot_x == bx && g[0].bot_z == bz;   // the mech follows; Digger's body waits
  g[0].px = 1; g[0].pz = g[0].at.wall_z + 3;
  for i: 0..<600 { g_step(g[..], 0.1); if i >= 20 && dist2(t[0].mech_x, t[0].mech_z, 0, g[0].at.wall_z + 1) < 12 { break; } }   // it walks over from the empty section
  #assert g_key(g[..], 'e', true) && t[0].drill_t > 0 && g[0].msg == SBM_DRILLING;
  for i: 0..<400 { g_step(g[..], 0.02); }
  #assert g[0].wall_gone && t[0].drill_t == 0;
  // E beside it again swaps the core back: Digger follows, the mech stays
  g[0].px = t[0].mech_x + 2; g[0].pz = t[0].mech_z;
  #assert g_key(g[..], 'e', true) && !t[0].mech_core && !sb_holds_digger(g[..]);
}
// The drive's second leg, just short of where the raider mech keeps watch, Sniper at its cruising speed.
sb_drive_check :: (g: [] SpGame) {
  g_stage(g, 3);
  g[0].pinged = true; g[0].have[H_BATTERY] = true; g[0].taken[H_BATTERY] = true;
  g[0].rail_s = sb_rm_watch_s() - 30; g[0].rail_v = T_RAIL_SPEED;
}
// The playtest's fixes (#13505): she faces the way she walks, a second Space in the air jumps higher,
// the raider mech's claws out of a battle never put Sniper down, and going down says so plainly.
#test "playtest: she turns to face the way she walks (never backwards), a double jump goes higher, the raider mech can't claw Sniper down out of a battle" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 5); g[0].px = 0; g[0].pz = 0; g[0].yaw = PI;
  #assert g_key(g[..], 's', true);
  for i: 0..<40 { g_step(g[..], 0.02); }
  d := g_face(g[..]) - (g[0].yaw + PI); #assert abs(atan2(sin(d), cos(d))) < 0.05;   // walking toward the view: she faces it
  _ = g_key(g[..], 's', false); #assert g_key(g[..], 'd', true);
  for i: 0..<40 { g_step(g[..], 0.02); }
  d = g_face(g[..]) - (g[0].yaw - PI * 0.5); #assert abs(atan2(sin(d), cos(d))) < 0.05;
  _ = g_key(g[..], 'd', false);
  // a jump, and a jump with a second Space in the air
  one := 0.0f32;
  for k: 0..<2 {
    g_stage(g[..], 5); g[0].px = 0; g[0].pz = 0; g_step(g[..], 0.02);
    _ = g_key(g[..], ' ', true); g_step(g[..], 0.02); _ = g_key(g[..], ' ', false);
    top := 0.0f32;
    for i: 0..<120 {
      if k == 1 && i == 12 { _ = g_key(g[..], ' ', true); }
      if k == 1 && i == 14 { _ = g_key(g[..], ' ', false); }
      g_step(g[..], 0.02); top = hi(top, g_feet_y(g[..]));
    }
    if k == 0 { one = top; } else { #assert top > one * 1.6; }
  }
  // the raider mech beside Sniper, out of a battle: its claws stop at a third of Sniper's health
  t := g[0].bt[..];
  g_stage(g[..], 4); g[0].mode = M_PLAY; sb_drive_check(g[..]);
  for i: 0..<3000 { g_step(g[..], 0.02); if g[0].mode != M_RIDE { break; } }
  most := t[0].bots[SB_SNIPER].vit.most;
  #assert !sb_fighting(g[..]) && !t[0].bots[SB_SNIPER].vit.down && t[0].bots[SB_SNIPER].vit.hp >= most / 3 - 0.01;
}
#test "the raider mech gives chase on the drive: top speed outruns it, beside Sniper it claws it, near the garage it turns back, and E battles it from Sniper with cards on keys 1 to 4" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  t := g[0].bt[..];
  // on foot at the rail stop it only keeps watch
  g_stage(g[..], 4); g[0].mode = M_PLAY;
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !t[0].rm_hunt;
  // on the drive it gives chase once Sniper passes its watch
  sb_drive_check(g[..]);
  #assert !t[0].rm_hunt && g[0].mode == M_RIDE;
  for i: 0..<400 { g_step(g[..], 0.02); if t[0].rm_hunt { break; } }
  #assert t[0].rm_hunt && g[0].msg == SBM_HUNT && g[0].mode == M_RIDE && sb_objective(g[..]) == "Outrun the raider mech (W), or battle it (E).";
  // top speed (W) outruns it: 20 m behind it gives up, and it does not come back this drive
  #assert g_key(g[..], 'w', true);
  for i: 0..<600 { g_step(g[..], 0.02); if !t[0].rm_hunt { break; } }
  #assert !t[0].rm_hunt && t[0].rm_gone && !t[0].rm_down && g[0].msg == SBM_RM_GONE;
  _ := g_key(g[..], 'w', false);
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !t[0].rm_hunt;
  // at cruising speed it catches up, runs beside Sniper and claws it
  sb_drive_check(g[..]);
  most := t[0].bots[SB_SNIPER].vit.most;
  for i: 0..<600 { g_step(g[..], 0.02); if t[0].bots[SB_SNIPER].vit.hp < most { break; } }
  b := sb_beside(g[..], g[0].rail_s, SB_RM_SIDE);
  #assert t[0].rm_hunt && t[0].bots[SB_SNIPER].vit.hp == most - cast(f32) sb_card(SBC_CLAW, SB_RAIDER).power && dist2(t[0].rm_x, t[0].rm_z, b.x, b.z) < 1;
  #assert sb_can_battle_rm(g[..]) && sb_prompt(g[..]).text == "Battle the raider mech from Sniper";
  // E while it is near: a battle, Sniper fielded with its three cards, and Sniper slows to its slow speed
  #assert g_key(g[..], 'e', true) && sb_fighting(g[..]) && t[0].kind == SBF_DESERT && sb_fielded(g[..]) == SB_SNIPER && g[0].mode == M_RIDE;
  t[0].think = 100;   // the raider mech holds its moves while this check reads Sniper's
  #assert sb_prompt(g[..]).text == "Battle moves" && sb_prompt(g[..]).key == "1-4";   // not W and S: the battle holds Sniper's speed
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert abs(g[0].rail_v - T_RAIL_SLOW) < 0.01 && dist2(t[0].rm_x, t[0].rm_z, sb_sniper_at(g[..]).x, sb_sniper_at(g[..]).z) < SB_RM_SIDE + 0.5;
  // keys 1 to 4 on the drive are Sniper's cards
  hp := sb_rec(g[..], SB_RAIDER).vit.hp; ch := sb_rec(g[..], SB_SNIPER).charge;
  #assert g_key(g[..], '2', true);
  #assert sb_rec(g[..], SB_RAIDER).vit.hp == hp - 3 && sb_rec(g[..], SB_SNIPER).charge == ch - 12;   // ARM: 3 damage, 12 charge
  #assert g_key(g[..], '2', true) && sb_rec(g[..], SB_RAIDER).vit.hp == hp - 3;                     // cooling: nothing
  #assert g_key(g[..], '4', true) && g[0].msg == SBM_REFUSED && t[0].refusal == cast(int) BbVerdict.no_card;   // Sniper holds three cards
  t[0].think = SB_THINK;   // and fights back from here
  for i: 0..<1500 { if t[0].rm_down { break; } _ = g_key(g[..], '1' + i % 3, true); g_step(g[..], 0.02); }
  #assert t[0].rm_down && !sb_fighting(g[..]) && g[0].scrap == 1 && g[0].msg == SBM_RM_DOWN && g[0].mode == M_RIDE;
  #assert sb_rec(g[..], SB_SNIPER).vit.hp < most - 3;   // it fought back
  // near the garage a chase still on turns back, and a battle on ends
  sb_drive_check(g[..]);
  g[0].rail_s = sb_rm_quit_s() - 3; r := sb_beside(g[..], g[0].rail_s, SB_RM_SIDE); t[0].rm_x = r.x; t[0].rm_z = r.z; t[0].rm_hunt = true;
  #assert g_key(g[..], 'e', true) && sb_fighting(g[..]);
  for i: 0..<200 { g_step(g[..], 0.02); if !t[0].rm_hunt { break; } }
  #assert !t[0].rm_hunt && !sb_fighting(g[..]) && g[0].msg == SBM_RM_GONE;
  for i: 0..<300 { g_step(g[..], 0.02); }
  #assert g[0].zone == Z_MINE && !sb_fighting(g[..]);
}
#test "the boss's collider moves with the boss: a walker is pushed out of it where it stands, and not where it started" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10);
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  #assert t[0].kind == SBF_BOSS && g[0].ws[0].boss >= 0;
  // where it starts: the collider holds a walker off it
  g[0].px = g[0].at.boss_x + 0.5; g[0].pz = g[0].at.boss_z; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, t[0].dino_x, t[0].dino_z) >= 2.1 - 0.001;
  // it moves (here, put across the chamber; a charge or a step does the same): the collider is where it stands
  t[0].dino_x = 4.5; t[0].dino_z = -69; t[0].think = 10; t[0].mech_x = 4.5; t[0].mech_z = -64.6;
  g_step(g[..], 0.02);
  w := sl_world(g[..]); s := g[0].ws[0].boss;
  #assert world_f(w, WF_X, s) == t[0].dino_x && world_f(w, WF_Z, s) == t[0].dino_z;
  g[0].px = t[0].dino_x - 0.4; g[0].pz = t[0].dino_z + 0.3; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, t[0].dino_x, t[0].dino_z) >= 2.1 - 0.001;
  // and where it started a walker stands free
  g[0].px = g[0].at.boss_x; g[0].pz = g[0].at.boss_z + 0.2; g_collide(g[..]);
  #assert g[0].px == g[0].at.boss_x && g[0].pz == g[0].at.boss_z + 0.2;
  // a charge carries the collider along with it
  t[0].half = true; t[0].wind = 0; t[0].rush = SB_CHARGE_TIME; t[0].rush_dx = -1; t[0].rush_dz = 0; t[0].rush_hit = true;
  x0 := t[0].dino_x; g_step(g[..], 0.02); g_step(g[..], 0.02);
  #assert t[0].dino_x < x0 && world_f(w, WF_X, s) == t[0].dino_x && world_f(w, WF_Z, s) == t[0].dino_z;
  // back at the checkpoint after a loss: it is home, and so is its collider
  sb_respawn(g[..]);
  #assert world_f(w, WF_X, s) == g[0].at.boss_x && world_f(w, WF_Z, s) == g[0].at.boss_z;
}
#test "the hit cooldown counts down everywhere: on foot in the mine, on foot on the desert route, and on the drive" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  for k: 0..<3 {
    if k == 0 { g_stage(g[..], 5); }
    if k == 1 { g_stage(g[..], 4); g[0].mode = M_PLAY; }
    if k == 2 { g_stage(g[..], 3); }
    hearts := g[0].hearts;
    g_hurt(g[..]);
    #assert g[0].hearts == hearts - 1 && g[0].hit_cool == T_HIT_COOL;
    g_hurt(g[..]);
    #assert g[0].hearts == hearts - 1;   // within the cooldown a second hit does nothing
    for i: 0..<cast(int) (T_HIT_COOL / 0.02) + 2 { g_step(g[..], 0.02); }
    #assert g[0].hit_cool == 0;
    g_hurt(g[..]);
    #assert g[0].hearts == hearts - 2;   // after it, a hit lands again
  }
}
#test "playtest: in the boss battle the mech lands its hits on its own, the boss jolts, and the prompt says her part: stun the weak points with F" #steps 100000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10); for i: 0..<3 { g[0].stun[i] = 0; }
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  #assert t[0].kind == SBF_BOSS && sb_prompt(g[..]).key == "1-4";
  hp := sb_rec(g[..], SB_BOSS).vit.hp; landed := false;
  for i: 0..<400 { g_step(g[..], 0.02); if t[0].hit_side == 1 && t[0].hit_t > 0.55 { landed = true; } }
  #assert sb_rec(g[..], SB_BOSS).vit.hp < hp && landed;   // no key pressed: the mech still hits it
  // reeling: the prompt sends her to a weak point, and beside one it says F
  t[0].daze = 3; t[0].rush = 0; t[0].wind = 0;
  #assert sb_open(g[..]) && sb_prompt(g[..]).key == "F";
  w := weak_at(g[..], 0); g[0].px = w.x + 0.3; g[0].pz = w.z + 0.3;
  #assert sb_prompt(g[..]).text == "Stun the weak point";
}
#test "playtest: the camera rises over the drill mech or the boss when one stands ahead, and never sits inside one" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7); g[0].px = 0; g[0].pz = -120; g[0].yaw = PI; g[0].pitch = 0;
  t := g[0].bt[..];
  t[0].mech_x = 60; t[0].mech_z = -120;   // away
  low := g_camera(g[..]).eye.y;
  t[0].mech_x = 0; t[0].mech_z = -125;    // 5 m ahead, in the line of sight
  #assert g_big_ahead(g[..], 0, -120, 0, -1) > 0.9 && g_camera(g[..]).eye.y > low + 3;
  t[0].mech_x = 0; t[0].mech_z = -116;    // just behind her: the camera comes in front of it
  e := g_camera(g[..]).eye; #assert !g_big_at(g[..], e.x, e.z, 0);
}
#test "Hold R: the bot wheel opens, the mouse or 1 to 4 picks, and letting go has Digger dig, pick up, attack or follow" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7); g[0].px = 0; g[0].pz = -20; g_bot_home(g[..]); g_step(g[..], 0.02);
  y0 := g[0].yaw;
  #assert g_key(g[..], 'r', true) && g[0].dr[0].wheel.open;
  g_look(g[..], 0, 80);   // the mouse down: ATTACK, and the view does not turn
  #assert wheel_pick(g[0].dr[0].wheel) == DW_ATTACK && g[0].yaw == y0;
  #assert g_key(g[..], 'r', false) && !g[0].dr[0].wheel.open && g[0].dr[0].say == DS_NO_FOE;   // dusk: no one to attack
  // 4 picks FOLLOW
  #assert g_key(g[..], 'r', true) && g_key(g[..], '4', true) && g_key(g[..], 'r', false) && g[0].dr[0].say == DS_FOLLOW && g[0].bot_state == BOT_FOLLOW;
  // up: DIG; the way is open here at dusk, so the boss wall: he drives to his work
  #assert g_key(g[..], 'r', true); g_look(g[..], 0, -80); #assert g_key(g[..], 'r', false) && g[0].bot_state == BOT_GO;
  // right: PICK UP the nearest part in his range
  g_key_wheel_follow(g[..]);
  g[0].taken[PICK_CELL] = false; g[0].px = pick_x(g[..], PICK_CELL) + 1; g[0].pz = pick_z(g[..], PICK_CELL); g_bot_home(g[..]);
  g[0].bot_x = pick_x(g[..], PICK_CELL) + 1.5; g[0].bot_z = pick_z(g[..], PICK_CELL);
  #assert g_key(g[..], 'r', true); g_look(g[..], 80, 0); #assert g_key(g[..], 'r', false) && (g[0].dr[0].task == DJ_FETCH || g[0].dr[0].say == DS_NO_PART);
  // let go in the middle: nothing
  #assert g_key(g[..], 'r', true) && g_key(g[..], 'r', false) && !g[0].dr[0].wheel.open;
}
g_key_wheel_follow :: (g: [] SpGame) { _ := g_key(g, 'r', true); _ = g_key(g, '4', true); _ = g_key(g, 'r', false); }
#test "the boss: phase one sweeps, phase two charges below half health and is dazed after; its weak points open only while it reels; three stuns power it down and night falls" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10); for i: 0..<3 { g[0].stun[i] = 0; }
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  #assert t[0].kind == SBF_BOSS && sb_fielded(g[..]) == SB_MECH && !sb_open(g[..]) && g[0].msg == SBM_BOSS;
  // phase one: the sweep catches the mech in its arc
  g[0].boss_t = T_SWEEP_EVERY + 0.05; a := sb_arm_angle(g[..]);
  t[0].mech_x = t[0].dino_x + sin(a) * 4; t[0].mech_z = t[0].dino_z + cos(a) * 4; t[0].think = 10;
  hp := sb_rec(g[..], SB_MECH).vit.hp;
  g_step(g[..], 0.02);
  #assert sb_rec(g[..], SB_MECH).vit.hp == hp - SB_SWEEP_HIT && !t[0].half;
  // phase two below half health: it winds up, charges, and is dazed after; dazed, its weak points open
  t[0].fight[0].sides[1].bots[0].vit.hp = 30; g[0].px = 4; g[0].pz = -76;
  g_step(g[..], 0.02);
  #assert t[0].half && g[0].msg == SBM_CHARGES;
  t[0].charge_t = SB_CHARGE_EVERY; g_step(g[..], 0.02);
  #assert t[0].wind > 0;
  rushed := false; for i: 0..<300 { g_step(g[..], 0.02); if t[0].rush > 0 { rushed = true; } if t[0].daze > 0 { break; } }
  #assert rushed && t[0].daze > 0 && sb_open(g[..]);
  for k: 0..<3 { w := weak_at(g[..], k); g[0].px = w.x + 0.3; g[0].pz = w.z + 0.3; #assert g_key(g[..], 'f', true); }
  #assert g[0].boss_down && g[0].phase == PH_NIGHT && !sb_fighting(g[..]) && g[0].msg == SBM_CORE_DROP;
  co := sb_core_at(g[..]); g[0].px = co.x; g[0].pz = co.z + 0.5;
  #assert g_key(g[..], 'e', true) && g[0].have[H_CORE];
}
#test "losing to the boss: the mech's health running out is a cut, and the boss is whole again after" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 10);
  t := g[0].bt[..];
  g_step(g[..], 0.02);
  #assert t[0].kind == SBF_BOSS;
  t[0].fight[0].sides[1].bots[0].vit.hp = 20;
  #assert bb_strike(t[0].fight[..], 0, 100);
  g_step(g[..], 0.02);
  #assert g[0].mode == M_BANNER && g[0].banner == B_CUT && !sb_fighting(g[..]);
  for i: 0..<200 { g_step(g[..], 0.02); }
  #assert g[0].mode == M_PLAY && t[0].bots[SB_BOSS].vit.hp == 70 && t[0].bots[SB_MECH].vit.hp == 45 && t[0].mech_core && g[0].wall_gone;
}
#test "a bot's cards are its moves, big moves cost more charge, and Digger's health is the Director's, and Sniper at zero powers down until its charger repairs it" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);
  t := g[0].bt[..];
  sb_arm(g[..], SB_DIGGER); sb_arm(g[..], SB_MECH);
  d := t[0].bots[SB_DIGGER]; m := t[0].bots[SB_MECH];
  #assert d.card_n == 2 && d.cards[0].id == SBC_MOVE && d.cards[1].id == SBC_DRILL && d.cards[1].cost > d.cards[0].cost;
  #assert m.card_n == 4 && m.cards[1].id == SBC_DRILL && m.cards[1].power > d.cards[1].power && m.cards[2].id == SBC_SLAM;
  // Digger's health is the Director's bar: a battle's hit on him lands there
  crew := [1] int.[SB_DIGGER]; sb_begin(g[..], SBF_DESERT, crew[..], SB_RAIDER);
  hp := g[0].dr[0].hp.hp;
  #assert !bb_strike(t[0].fight[..], 0, 3);
  sb_digger_out(g[..]);
  #assert g[0].dr[0].hp.hp == hp - 3 && sb_holds_digger(g[..]);
  sb_finish(g[..]);
  // Sniper at zero powers down until it stands by its own charger with her
  #assert bb_hurt(t[0].bots[SB_SNIPER..<SB_SNIPER + 1], 99) && t[0].bots[SB_SNIPER].vit.down;
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z;
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !t[0].bots[SB_SNIPER].vit.down && t[0].bots[SB_SNIPER].vit.hp == 24 && g[0].msg == SBM_REPAIR;
}
#test "the battles' own stills: 20 is Sniper battling the raider mech on the drive, 21 the boss in phase two" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 20);
  #assert g[0].zone == Z_RAIL && g[0].mode == M_RIDE && g[0].phase == PH_DUSK && sb_fighting(g[..]) && g[0].bt[0].kind == SBF_DESERT && sb_fielded(g[..]) == SB_SNIPER;
  g_stage(g[..], 21);
  #assert !sb_fighting(g[..]) && g[0].wall_gone;
  for i: 0..<5 { g_step(g[..], 0.02); }
  #assert g[0].bt[0].kind == SBF_BOSS && g[0].bt[0].half;
  for i: 0..<150 { g_step(g[..], 0.02); if g[0].bt[0].wind > 0 || g[0].bt[0].rush > 0 { break; } }
  #assert g[0].bt[0].wind > 0 || g[0].bt[0].rush > 0;
}
#test "the ending: three captions over the 15-second hologram, then SCENE RESTORED, then the mission's teaser with RESTART" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  #assert sb_caption(1) == "The orders kept coming. No one was giving them." && sb_caption(7) == "The Emperor has been gone for years. Only his machines remained." && sb_caption(12) == "Someone has to tell the others, Director.";
  g_stage(g[..], 11);
  #assert g[0].mode == M_MEMORY && g[0].mem_t == 6;
  for i: 0..<460 { g_step(g[..], 0.02); }
  #assert g[0].mode == M_RESTORED && !g[0].bt[0].teaser;
  for i: 0..<160 { g_step(g[..], 0.02); }
  #assert g[0].bt[0].teaser;
  #assert g_key(g[..], -2, true) && g[0].mode == M_PLAY;   // RESTART
  // a click on SCENE RESTORED goes on to the teaser at once, and the next starts again
  g_stage(g[..], 12);
  #assert g_key(g[..], -2, true) && g[0].mode == M_RESTORED && g[0].bt[0].teaser;
  #assert g_key(g[..], -2, true) && g[0].mode == M_PLAY;
}

#test "the raider mine garage: a ring of lettered bays round a field 270 m across, the entry, the empty section and the hallway where the sheet has them (#13505)" #steps 400000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);
  a := g[0].at; o: [2] u8;
  #assert a.gar_x == 0 && a.gar_z == -195 && a.gar_r == 135;
  // the sections' names, in order round the field
  #assert ga_name(0, o[..]) == "A1" && ga_name(1, o[..]) == "A2" && ga_name(2, o[..]) == "AB" && ga_name(7, o[..]) == "C2" && ga_name(12, o[..]) == "E1" && ga_name(23, o[..]) == "HA" && ga_name(24, o[..]) == "";
  // the entry faces the mine mouth, the hallway is straight across, the drill mech stands in the empty one
  #assert ga_section_of(g[..], 0, -50) == GA_ENTRY && ga_section_of(g[..], 0, -340) == GA_HALLWAY;
  mech := sc_mark(g[0].c[..], 81);
  #assert mech.id == 81 && ga_in_bay(g[..], mech.x, mech.z) == GA_EMPTY;
  // the back wall holds you in a bay, and opens only at the entry's tunnel and the hallway
  q := ga_push(g[..], 100, -195 + 0.0, T_RADIUS);   // on the field: nothing
  #assert q.x == 100;
  b := ga_back(g[..]);
  q = ga_push(g[..], b + 1, -195, T_RADIUS);        // past the back wall in C1: put back in front of it
  #assert abs(q.x - (b - T_RADIUS)) < 0.01;
  q = ga_push(g[..], 0, -195 + b + 1, T_RADIUS);    // through the entry's gap: on
  #assert q.z == -195 + b + 1;
  q = ga_push(g[..], 0, -195 - b - 1, T_RADIUS);    // into the hallway: on
  #assert q.z == -195 - b - 1;
  q = ga_push(g[..], 3.2, -195 + b + 1, T_RADIUS);  // beside the gap: back
  #assert q.z < -195 + b;
  // the piers stand between the bays: you are pushed out of one, and walk freely down a bay's middle
  g[0].px = ga_pt(g[..], ga_angle(3) + ga_span() * 0.5, a.gar_r + 8, 0).x; g[0].pz = ga_pt(g[..], ga_angle(3) + ga_span() * 0.5, a.gar_r + 8, 0).z;
  x0 := g[0].px; z0 := g[0].pz; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, x0, z0) > GA_PIER;
  m := ga_bay_at(g[..], 3); g[0].px = m.x; g[0].pz = m.z; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, m.x, m.z) < 0.001 && ga_in_bay(g[..], m.x, m.z) == 3 && ga_inside(g[..], m.x, m.z);
  // rock round the ring takes no piece; the field, the tunnel and the lab are not rock
  #assert ga_rock(g[..], 0, -195 + b + 5, 0.5) == false && ga_rock(g[..], b + 5, -195, 0.5) && !ga_rock(g[..], 50, -195, 0.5) && !ga_rock(g[..], 0, -406, 0.5);
}
