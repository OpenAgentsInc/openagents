  #assert g[0].mode == M_PLAY && t[0].bots[SB_BOSS].vit.hp == 70 && t[0].bots[SB_MECH].vit.hp == 45 && t[0].mech_core && g[0].wall_gone;
}
#test "a bot's cards are its moves, big moves cost more charge, and Digger's health is the Director's, and Sniper at zero powers down until its charger repairs it" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);
  t := g[0].bt[..];
  sb_arm(g[..], SB_DIGGER); sb_arm(g[..], SB_MECH);
  d := t[0].bots[SB_DIGGER]; m := t[0].bots[SB_MECH];
  #assert d.card_n == 2 && d.cards[0].id == SBC_MOVE && d.cards[1].id == SBC_DRILL && d.cards[1].cost > d.cards[0].cost;
  #assert m.card_n == 4 && m.cards[1].id == SBC_DRILL && m.cards[1].power > d.cards[1].power && m.cards[2].id == SBC_SLAM;
  // Digger's health is the Director's bar: a battle's hit on him lands there
  crew := [1] int.[SB_DIGGER]; sb_begin(g[..], SBF_DESERT, crew[..], SB_RAIDER);
  hp := g[0].dr[0].hp.hp;
  #assert !bb_strike(t[0].fight[..], 0, 3);
  sb_digger_out(g[..]);
  #assert g[0].dr[0].hp.hp == hp - 3 && sb_holds_digger(g[..]);
  sb_finish(g[..]);
  // Sniper at zero powers down until it stands by its own charger with her
  #assert bb_hurt(t[0].bots[SB_SNIPER..<SB_SNIPER + 1], 99) && t[0].bots[SB_SNIPER].vit.down;
  g[0].px = g[0].at.rover_x - 3; g[0].pz = g[0].at.rover_z;
  for i: 0..<100 { g_step(g[..], 0.02); }
  #assert !t[0].bots[SB_SNIPER].vit.down && t[0].bots[SB_SNIPER].vit.hp == 24 && g[0].msg == SBM_REPAIR;
}
// The checks' driver on the road: W up to `top` m/s, and A or D toward the road (dv_at) a stretch past the
// nearest of its points at or after u; the new u.
dv_road_step :: (g: [] SpGame, u: f32, top: f32) -> f32 {
  d := g[0].dv[0]; at := u; bd: f32 = 1e9;
  for k: 0..<11 { v := clamp01(u + cast(f32) k * 0.01); q := dv_at(g, v); r := dist2(q.x, q.z, d.sx, d.sz); if r < bd { bd = r; at = v; } }
  c := dv_at(g, clamp01(at + 0.05));
  turn := atan2(c.x - d.sx, c.z - d.sz) - d.syaw;
  while turn > PI { turn -= TAU; } while turn < -PI { turn += TAU; }
  _ := g_key(g, 'w', dv_speed(g) < top); _ = g_key(g, 's', false); _ = g_key(g, 'a', turn > 0.05); _ = g_key(g, 'd', turn < -0.05);
  g_step(g, 0.02);
  return at;
}
#test "the raider mech gives chase on the drive from the solar farm to the garage: W outruns it, Space can't skip it, and E battles it from Sniper (#13505)" #steps 1200000000 {
  g := [1] SpGame.[SpGame.{}];
  for run: 0..<2 {
    g[0] = SpGame.{};
    g_reset(g[..]); #assert spw_shipped(g[..]) == SPW_SHIPPED_N;
    g_begin(g[..]); g[0].have[H_DRILL] = true;
    tr := g_shipped_at(g[..], 123); g[0].px = tr.x + 2.2; g[0].pz = tr.z;
    #assert g_key(g[..], 'e', true);
    dk := g_shipped_at(g[..], 125); g[0].px = dk.x - 1.2; g[0].pz = dk.z;
    #assert g_key(g[..], 'e', true) && g[0].mode == M_DRIVE;
    t := g[0].bt[..];
    #assert !t[0].rm_hunt && !t[0].rm_gone && !t[0].rm_down;   // on watch beside the road
    bx := g[0].dv[0].bx; bz := g[0].dv[0].bz;
    u: f32 = 0;
    for i: 0..<6000 { u = dv_road_step(g[..], u, 16); if t[0].rm_hunt || g[0].mode != M_DRIVE { break; } }
    #assert t[0].rm_hunt && g[0].msg == SBM_HUNT && g[0].mode == M_DRIVE && sb_objective(g[..]) == "Outrun the raider mech (W), or battle it (E).";
    #assert g_key(g[..], ' ', true) && g_key(g[..], ' ', false) && g[0].mode == M_DRIVE;   // Space is the handbrake: no skipping past it
    if run == 0 {
      // W: Sniper drives faster than it runs, and it gives up
      for i: 0..<6000 { u = dv_road_step(g[..], u, DV_TOP); if !t[0].rm_hunt { break; } }
      #assert !t[0].rm_hunt && t[0].rm_gone && !t[0].rm_down && g[0].msg == SBM_RM_GONE && !t[0].bots[SB_SNIPER].vit.down;
    } else {
      // E beside Sniper: a battle on the road, 1 to 4 are Sniper's cards, and she slows to a crawl
      for k: [4] int.['w', 's', 'a', 'd'] { _ := g_key(g[..], k, false); }   // she lets it come to her
      for i: 0..<2000 { g_step(g[..], 0.02); if sb_can_battle_rm(g[..]) || g[0].mode != M_DRIVE { break; } }
      #assert sb_can_battle_rm(g[..]);
      #assert g_key(g[..], 'e', true) && sb_fighting(g[..]) && t[0].kind == SBF_DESERT && sb_fielded(g[..]) == SB_SNIPER && g[0].mode == M_DRIVE;
      _ = g_key(g[..], 'w', true); for i: 0..<150 { g_step(g[..], 0.02); } _ = g_key(g[..], 'w', false);
      #assert dv_speed(g[..]) < DV_CRAWL + 0.5;   // in a battle Sniper crawls
      #assert g_key(g[..], '1', true);
    }
    for i: 0..<6000 { u = dv_road_step(g[..], u, DV_TOP); if u > 0.95 || g[0].mode != M_DRIVE { break; } }
    #assert dv_keys_to(g[..], bx, bz, 6, 240) && g_key(g[..], 'e', true);
    #assert g[0].mode == M_PLAY && g[0].phase == PH_DUSK && !sb_fighting(g[..]) && !t[0].rm_hunt;
  }
}
#test "the battles' own stills: 20 is Sniper battling the raider mech on the drive, 21 the boss in phase two" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 20);
  #assert g[0].zone == Z_RAIL && g[0].mode == M_RIDE && g[0].phase == PH_DUSK && sb_fighting(g[..]) && g[0].bt[0].kind == SBF_DESERT && sb_fielded(g[..]) == SB_SNIPER;
  g_stage(g[..], 21);
  #assert !sb_fighting(g[..]) && g[0].wall_gone;
  for i: 0..<5 { g_step(g[..], 0.02); }
  #assert g[0].bt[0].kind == SBF_BOSS && g[0].bt[0].half;
  for i: 0..<150 { g_step(g[..], 0.02); if g[0].bt[0].wind > 0 || g[0].bt[0].rush > 0 { break; } }
  #assert g[0].bt[0].wind > 0 || g[0].bt[0].rush > 0;
}
#test "the ending: three captions over the 15-second hologram, then SCENE RESTORED, then the mission's teaser with RESTART" #steps 60000000 {
  g := [1] SpGame.[SpGame.{}];
  #assert sb_caption(1) == "The orders kept coming. No one was giving them." && sb_caption(7) == "The Emperor has been gone for years. Only his machines remained." && sb_caption(12) == "Someone has to tell the others, Director.";
  g_stage(g[..], 11);
  #assert g[0].mode == M_MEMORY && g[0].mem_t == 6;
  for i: 0..<460 { g_step(g[..], 0.02); }
  #assert g[0].mode == M_RESTORED && !g[0].bt[0].teaser;
  for i: 0..<160 { g_step(g[..], 0.02); }
  #assert g[0].bt[0].teaser;
  #assert g_key(g[..], -2, true) && g[0].mode == M_PLAY;   // RESTART
  // a click on SCENE RESTORED goes on to the teaser at once, and the next starts again
  g_stage(g[..], 12);
  #assert g_key(g[..], -2, true) && g[0].mode == M_RESTORED && g[0].bt[0].teaser;
  #assert g_key(g[..], -2, true) && g[0].mode == M_PLAY;
}

#test "the raider mine garage: a ring of lettered bays round a field 270 m across, the entry, the empty section and the hallway where the sheet has them (#13505)" #steps 400000000 {
  g := [1] SpGame.[SpGame.{}];
  g_stage(g[..], 7);
  a := g[0].at; o: [2] u8;
  #assert a.gar_x == 0 && a.gar_z == -195 && a.gar_r == 135;
  // the sections' names, in order round the field
  #assert ga_name(0, o[..]) == "A1" && ga_name(1, o[..]) == "A2" && ga_name(2, o[..]) == "AB" && ga_name(7, o[..]) == "C2" && ga_name(12, o[..]) == "E1" && ga_name(23, o[..]) == "HA" && ga_name(24, o[..]) == "";
  // the entry faces the mine mouth, the hallway is straight across, the drill mech stands in the empty one
  #assert ga_section_of(g[..], 0, -50) == GA_ENTRY && ga_section_of(g[..], 0, -340) == GA_HALLWAY;
  mech := sc_mark(g[0].c[..], 81);
  #assert mech.id == 81 && ga_in_bay(g[..], mech.x, mech.z) == GA_EMPTY;
  // the back wall holds you in a bay, and opens only at the entry's tunnel and the hallway
  q := ga_push(g[..], 100, -195 + 0.0, T_RADIUS);   // on the field: nothing
  #assert q.x == 100;
  b := ga_back(g[..]);
  q = ga_push(g[..], b + 1, -195, T_RADIUS);        // past the back wall in C1: put back in front of it
  #assert abs(q.x - (b - T_RADIUS)) < 0.01;
  q = ga_push(g[..], 0, -195 + b + 1, T_RADIUS);    // through the entry's gap: on
  #assert q.z == -195 + b + 1;
  q = ga_push(g[..], 0, -195 - b - 1, T_RADIUS);    // into the hallway: on
  #assert q.z == -195 - b - 1;
  q = ga_push(g[..], 3.2, -195 + b + 1, T_RADIUS);  // beside the gap: back
  #assert q.z < -195 + b;
  // the piers stand between the bays: you are pushed out of one, and walk freely down a bay's middle
  g[0].px = ga_pt(g[..], ga_angle(3) + ga_span() * 0.5, a.gar_r + 8, 0).x; g[0].pz = ga_pt(g[..], ga_angle(3) + ga_span() * 0.5, a.gar_r + 8, 0).z;
  x0 := g[0].px; z0 := g[0].pz; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, x0, z0) > GA_PIER;
  m := ga_bay_at(g[..], 3); g[0].px = m.x; g[0].pz = m.z; g_collide(g[..]);
  #assert dist2(g[0].px, g[0].pz, m.x, m.z) < 0.001 && ga_in_bay(g[..], m.x, m.z) == 3 && ga_inside(g[..], m.x, m.z);
  // rock round the ring takes no piece; the field, the tunnel and the lab are not rock
  #assert ga_rock(g[..], 0, -195 + b + 5, 0.5) == false && ga_rock(g[..], b + 5, -195, 0.5) && !ga_rock(g[..], 50, -195, 0.5) && !ga_rock(g[..], 0, -406, 0.5);
}
