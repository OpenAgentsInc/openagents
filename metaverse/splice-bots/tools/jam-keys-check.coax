// The jam page played with real keys in headless Chrome (GitHub #13653): /worlds/splice-bots-jam with
// the private pack, keys sent as the browser's own key events (Input.dispatchKeyEvent), and her place
// read back from the page (coaxial.fieldProbe 7 and 8: x and z in centimetres; 14: her feet's height).
//   coax/web/tool.sh metaverse/splice-bots/tools/jam-keys-check.coax URL OUT.png
// URL is the page with ?pack=splice-bots-jam&stage=1 on a dev server (coax/web/serve.sh). It prints the
// readings and exits 0 when the run starts at the jam farm's player start, W walks her, S brings her
// back and Space lifts her.
//
// Why a page check needs focus emulation: a headless page has no focus, and the host lets go of every
// held key when the page has no focus (host.js hostLifeEvent: a blur clears the game's keys, so W pressed
// in a script never walks). Emulation.setFocusEmulationEnabled gives the page focus, as a person's
// window has.
#import "Basic";
#load "../../../coax/lib/media/media.coax";

jk_key :: (c: [] Cdp, key: string, code: string, vk: int, down: bool) {
  p: [1024] u8; j: [1] Jo; jo_start(j[..], p[..]); jo_obj(j[..]);
  jo_key(j[..], "type"); jo_str(j[..], ifx down then (ifx key.count == 1 then "keyDown" else "rawKeyDown") else "keyUp");
  jo_key(j[..], "key"); jo_str(j[..], key); jo_key(j[..], "code"); jo_str(j[..], code);
  jo_key(j[..], "windowsVirtualKeyCode"); jo_int(j[..], vk);
  if down && key.count == 1 { jo_key(j[..], "text"); jo_str(j[..], key); }
  jo_end(j[..]);
  #assert cdp_call(c, "Input.dispatchKeyEvent", jo_text(j[..]), CDP_CALL_MS) >= 0;
}
jk_eval :: (c: [] Cdp, js: string) { if cdp_evaluate(c, js) < 0 { print("evaluate failed: %\n", js); } }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 2 { print("usage: jam-keys-check URL OUT.png\n"); return 2; }
  c: [1] Cdp;
  if !cdp_launch(c[..], 1280, 720, "coax-jam-keys-") { return 3; }
  #assert cdp_call(c[..], "Page.enable", "", CDP_CALL_MS) >= 0;
  #assert cdp_call(c[..], "Emulation.setFocusEmulationEnabled", "{\"enabled\":true}", CDP_CALL_MS) >= 0;
  o: MediaShotOptions; o.wait = 8000; o.script = "globalThis.J={focus:document.hasFocus()};1";
  value: [65536] u8; build: [256] u8;
  shot := media_shot(c[..], args_at(a[..], 0), args_at(a[..], 1), ArgsSize.{ok = true, w = 1280, h = 720}, o, value[..], build[..]);
  if shot.status != 0 { cdp_close(c[..]); print("the page did not load (status %)\n", shot.status); return 4; }
  // the pack is large: wait until the game plays in the jam world, then read where she starts
  jam := false;
  for k: 0..<240 { v: [64] u8; n := media_value(c[..], "String(coaxial.fieldProbe(15))", v[..]); if n > 0 && v[0] == '1' { jam = true; break; } proc_sleep(250); }
  if !jam { cdp_close(c[..]); print("the page never played in the jam world (no pack?)\n"); return 7; }
  proc_sleep(500);
  jk_eval(c[..], "J.start=[coaxial.fieldProbe(7),coaxial.fieldProbe(8),coaxial.fieldProbe(14)];1");
  // W held 1.5 s: she walks forward
  jk_key(c[..], "w", "KeyW", 87, true); proc_sleep(1500); jk_key(c[..], "w", "KeyW", 87, false); proc_sleep(300);
  jk_eval(c[..], "J.walked=[coaxial.fieldProbe(7),coaxial.fieldProbe(8)];1");
  // S held 1.5 s: she walks back
  jk_key(c[..], "s", "KeyS", 83, true); proc_sleep(1500); jk_key(c[..], "s", "KeyS", 83, false); proc_sleep(300);
  jk_eval(c[..], "J.back=[coaxial.fieldProbe(7),coaxial.fieldProbe(8)];1");
  // Space: she jumps; her feet's highest over 0.8 s
  jk_eval(c[..], "J.peak=coaxial.fieldProbe(14);1");
  jk_key(c[..], " ", "Space", 32, true);
  for k: 0..<20 { proc_sleep(40); jk_eval(c[..], "J.peak=Math.max(J.peak,coaxial.fieldProbe(14));1"); }
  jk_key(c[..], " ", "Space", 32, false); proc_sleep(800);
  vn := media_value(c[..], "(()=>{const d=(p,q)=>Math.hypot(p[0]-q[0],p[1]-q[1]);J.walk_cm=Math.round(d(J.start,J.walked));J.back_cm=Math.round(d(J.walked,J.back));J.jump_cm=J.peak-J.start[2];J.ok=J.focus&&Math.hypot(J.start[0]+84000,J.start[1]+13600)<300&&J.walk_cm>300&&J.back_cm>150&&J.jump_cm>50;return JSON.stringify(J)})()", value[..]);
  cdp_close(c[..]);
  if vn < 0 { return 5; }
  result := cast(string) value[0..<vn]; print("%\n", result);
  for k: 0..<result.count - 8 { if result[k..<k + 9] == "\"ok\":true" { return 0; } }
  return 6;
}
