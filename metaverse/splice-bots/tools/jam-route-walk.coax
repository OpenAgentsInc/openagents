// tool.sh: stack-gib 1
// The route walk over an imported world (the importer's spec, section 8: "no invisible blockers"): in each
// map, the shared walker starts at the player start and walks straight at every named spot in name order
// (the ring's route_long_01 to _25 come one after another), with the realm's own colliders
// (metaverse-engine/world/imported.coax). When something stops it, the collider it touches is named, and it
// must be one you can see: a collider whose drawn instance (the P line of the same name) covers it.
// A collider with no drawn instance is an invisible blocker, and the walk fails.
//
//   coax/web/tool.sh metaverse/splice-bots/tools/jam-route-walk.coax PACK [--route ROUTE_PACK]
//
// --route takes the spots from another pack of the same levels: the editor route's bundle has only
// player starts, and the data route's has the jam's markers. Its maps pair with PACK's by exact id
// (JRW_SHARED); a map with no pair walks its own spots.
//
// It prints a line a map (legs, reached, stopped by something you can see, stopped by nothing you can see)
// and each stop, and exits 1 on an invisible blocker.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../metaverse-engine/editor/pack.coax";
#load "../../../metaverse-engine/world/imported.coax";

JRW_REACH :: 0.6;        // m across the ground: a spot is reached
JRW_LEG :: 60.0;         // s a leg may take
JRW_STUCK :: 2.0;        // s without 0.25 m of progress: stopped
JRW_TOUCH :: 0.08;       // m past the capsule's radius a collider counts as the one touched
JRW_SLACK :: 0.10;       // m a collider may reach past its drawn instance (the importer's CV_SLACK)

// The collider of map `map` nearest the body (by its bounds), and how far.
JrwNear :: struct { shape: int = -1; gap: f32 = 1e30; }
jrw_bounds :: (w: [] IwWorld, k: int, lo: [] f32, hi: [] f32) #effects(all) {
  sh := w[0].shapes[k]; v := w[0].pool[sh.at..<sh.at + sh.n];
  for c: 0..<3 { lo[c] = 1e30; hi[c] = -1e30; }
  if sh.kind == IW_BOX { for c: 0..<3 { lo[c] = v[c]; hi[c] = v[c + 3]; } return; }
  if sh.kind == IW_FLOOR {
    for corner: 0..<4 {
      x := v[0] + (ifx corner & 1 != 0 then v[2] else 0.0f32) + (ifx corner & 2 != 0 then v[4] else 0.0f32);
      z := v[1] + (ifx corner & 1 != 0 then v[3] else 0.0f32) + (ifx corner & 2 != 0 then v[5] else 0.0f32);
      y := v[6] + (ifx corner & 1 != 0 then v[7] else 0.0f32) + (ifx corner & 2 != 0 then v[8] else 0.0f32);
      p := [3] f32.[x, y, z]; for c: 0..<3 { lo[c] = walker.lo(lo[c], p[c]); hi[c] = walker.hi(hi[c], p[c]); }
    }
    return;
  }
  if sh.kind == IW_CAPSULE { for c: 0..<3 { lo[c] = walker.lo(v[c], v[c + 3]) - v[6]; hi[c] = walker.hi(v[c], v[c + 3]) + v[6]; } return; }
  // a hull: its height is given; across the ground, the corners its faces meet at are in the planes
  lo[1] = v[1]; hi[1] = v[2];
  faces := cast(int) v[0];
  for i: 0..<faces { for j: i + 1..<faces {
    a := 3 + i * 4; b := 3 + j * 4;
    det := v[a] * v[b + 2] - v[a + 2] * v[b];
    if abs(det) < 0.000001 || abs(v[a + 1]) > 0.5 || abs(v[b + 1]) > 0.5 { continue; }
    x := (v[a + 3] * v[b + 2] - v[a + 2] * v[b + 3]) / det; z := (v[a] * v[b + 3] - v[a + 3] * v[b]) / det;
    inside := true;
    for f: 0..<faces { at := 3 + f * 4; if abs(v[at + 1]) < 0.5 && v[at] * x + v[at + 2] * z > v[at + 3] + 0.0001 { inside = false; } }
    if inside { lo[0] = walker.lo(lo[0], x); hi[0] = walker.hi(hi[0], x); lo[2] = walker.lo(lo[2], z); hi[2] = walker.hi(hi[2], z); }
  } }
}
jrw_touch :: (w: [] IwWorld, map: int, x: f32, y: f32, z: f32) -> JrwNear #effects(all) {
  r: JrwNear;
  for k: 0..<w[0].nshape {
    if w[0].shapes[k].map != map || w[0].shapes[k].kind == IW_FLOOR { continue; }
    lo: [3] f32; hi: [3] f32; jrw_bounds(w, k, lo[..], hi[..]);
    if y + 1.8 < lo[1] || y > hi[1] - 0.01 { continue; }     // above or below the body
    dx := walker.hi(walker.hi(lo[0] - x, x - hi[0]), 0.0f32); dz := walker.hi(walker.hi(lo[2] - z, z - hi[2]), 0.0f32);
    gap := sqrt(dx * dx + dz * dz);
    if gap < r.gap { r.gap = gap; r.shape = k; }
  }
  return r;
}
// Whether collider k is covered by a drawn instance of the same name: its bounds inside the instance's
// world bounds (its section's box through its transform) and JRW_SLACK.
jrw_visible :: (w: [] IwWorld, cat: string, k: int, name: string) -> bool #effects(all) {
  lo: [3] f32; hi: [3] f32; jrw_bounds(w, k, lo[..], hi[..]);
  at := 0;
  while at < cat.count {
    e := at; while e < cat.count && cat[e] != '\n' { e += 1; }
    line := cat[at..<e]; at = e + 1;
    if iw_field(line, 0) != "P" || iw_field(line, 16) != name || cast(int) iw_num(iw_field(line, 1)).v != w[0].shapes[k].map { continue; }
    section := cast(int) iw_num(iw_field(line, 2)).v;
    // the section's local box from its M line
    sb: [6] f32; found := false; m := 0; at2 := 0;
    while at2 < cat.count && !found {
      e2 := at2; while e2 < cat.count && cat[e2] != '\n' { e2 += 1; }
      l2 := cat[at2..<e2]; at2 = e2 + 1;
      if iw_field(l2, 0) == "M" { if m == section { for c: 0..<6 { sb[c] = cast(f32) iw_num(iw_field(l2, 5 + c)).v; } found = true; } m += 1; }
    }
    if !found { return false; }
    q := [4] f32.[cast(f32) iw_num(iw_field(line, 6)).v, cast(f32) iw_num(iw_field(line, 7)).v, cast(f32) iw_num(iw_field(line, 8)).v, cast(f32) iw_num(iw_field(line, 9)).v];
    rows := iw_rows(q); wl: [3] f32; wh: [3] f32;
    for c: 0..<3 { wl[c] = 1e30; wh[c] = -1e30; }
    for corner: 0..<8 {
      pl := [3] f32.[sb[ifx corner & 1 != 0 then 3 else 0], sb[ifx corner & 2 != 0 then 4 else 1], sb[ifx corner & 4 != 0 then 5 else 2]];
      for r: 0..<3 {
        v := cast(f32) iw_num(iw_field(line, 10 + r)).v;
        for c: 0..<3 { v += rows.r[r * 3 + c] * cast(f32) iw_num(iw_field(line, 13 + c)).v * pl[c]; }
        wl[r] = walker.lo(wl[r], v); wh[r] = walker.hi(wh[r], v);
      }
    }
    ok := true; for c: 0..<3 { if lo[c] < wl[c] - JRW_SLACK || hi[c] > wh[c] + JRW_SLACK { ok = false; } }
    if ok { return true; }
  }
  return false;
}
jrw_after :: (a: string, b: string) -> bool #effects(all) {
  n := ifx a.count < b.count then a.count else b.count;
  for k: 0..<n { if a[k] != b[k] { return a[k] > b[k]; } }
  return a.count > b.count;
}
// The collider's name: the last field of its col line (the k-th col line of the catalog).
jrw_shape_name :: (cat: string, k: int) -> string #effects(all) {
  at := 0; n := 0;
  while at < cat.count {
    e := at; while e < cat.count && cat[e] != '\n' { e += 1; }
    line := cat[at..<e]; at = e + 1;
    if iw_field(line, 0) == "col" { if n == k { return iw_field(line, iw_fields(line) - 1); } n += 1; }
  }
  return "";
}

// The jam's four levels in the data route's ids and the editor route's.
JRW_SHARED :: [4] [2] string.[
  [2] string.["/Data/level_layout/farm", "/Game/World/Graybox/L_Farm"], [2] string.["/Data/level_layout/lab", "/Game/World/Graybox/L_Lab"],
  [2] string.["/Data/level_layout/plain", "/Game/World/Graybox/L_Plain"], [2] string.["/Data/level_layout/ring", "/Game/World/Graybox/L_Ring"]];
jrw_pair :: (w: [] IwWorld, m: int, r: [] IwWorld) -> int #effects(all) {
  id := cast(string) w[0].maps[m].id[0..<w[0].maps[m].id_n];
  for pr: JRW_SHARED { if pr[1] == id || pr[0] == id {
    for k: 0..<r[0].nm { rid := cast(string) r[0].maps[k].id[0..<r[0].maps[k].id_n]; if rid == pr[0] || rid == pr[1] { return k; } }
  } }
  return -1;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  routed := args_load(a[..]) && args_count(a[..]) == 3 && args_at(a[..], 1) == "--route";
  if !routed && args_count(a[..]) != 1 { print("usage: jam-route-walk PACK [--route ROUTE_PACK]\n"); return 2; }
  pack_b: [268435456] u8; path := args_at(a[..], 0); pn := fs_size(path);
  if pn < 0 || pn > pack_b.count || fs_read(path, pack_b[0..<pn]) != pn { tool_errln("jam-route-walk: could not read the pack"); return 1; }
  pack := cast(string) pack_b[0..<pn]; rd: [1] PackRead;
  if !pack_read(pack, rd[..]) { tool_err("jam-route-walk: the pack is refused: "); tool_errln(rd[0].why); return 1; }
  cat := pack_bytes(pack, rd[..], 0);
  w: [1] IwWorld;
  if !iw_admit(w[..], cat) { tool_err("jam-route-walk: the world is refused: "); tool_errln(w[0].why); return 1; }
  rw: [1] IwWorld;
  if routed {
    route_b: [67108864] u8; rp := args_at(a[..], 2); rn := fs_size(rp);
    if rn < 0 || rn > route_b.count || fs_read(rp, route_b[0..<rn]) != rn { tool_errln("jam-route-walk: could not read the route pack"); return 1; }
    rpk := cast(string) route_b[0..<rn]; rr: [1] PackRead;
    if !pack_read(rpk, rr[..]) || !iw_admit(rw[..], pack_bytes(rpk, rr[..], 0)) { tool_errln("jam-route-walk: the route pack is refused"); return 1; }
  }
  c: [1] IwColliders; invisible := 0;
  for m: 0..<w[0].nm {
    iw_colliders(w[..], m, c[..]); world := iw_walker(w[..], m, c[..]);
    src := w[..]; sm := m;
    if routed { pm := jrw_pair(w[..], m, rw[..]); if pm >= 0 { src = rw[..]; sm = pm; } }
    order: [IW_SPOTS] int; n := 0;
    for k: 0..<src[0].nspot { if src[0].spots[k].map == sm && src[0].spots[k].kind != IW_SPOT_START { order[n] = k; n += 1; } }
    for x: 1..<n { k := x; while k > 0 && jrw_after(cast(string) src[0].spots[order[k - 1]].name[0..<src[0].spots[order[k - 1]].name_n], cast(string) src[0].spots[order[k]].name[0..<src[0].spots[order[k]].name_n]) { t := order[k]; order[k] = order[k - 1]; order[k - 1] = t; k -= 1; } }
    mp := w[0].maps[m];
    p := walker.place_in(world, mp.spawn[0], mp.spawn[1], mp.spawn[2], mp.yaw);
    reached := 0; seen := 0; unseen := 0; fell := 0;
    for leg: 0..<n {
      s := src[0].spots[order[leg]]; best: f32 = 1e30; since: f32 = 0; t: f32 = 0; stopped := false;
      while t < JRW_LEG {
        dx := s.at[0] - p.body.pos.x; dz := s.at[2] - p.body.pos.z; d := sqrt(dx * dx + dz * dz);
        if d < JRW_REACH { break; }
        if d < best - 0.25 { best = d; since = 0; }
        if since > JRW_STUCK { stopped = true; break; }
        // steer: the camera faces the spot, and you walk forward
        p.cam.theta = walker.atan2(-dx, -dz);
        p = walker.walk_input(p, 0, 1, 0, 0, false, false, 0, 0);
        p.cam.theta = walker.atan2(-dx, -dz);
        p = walker.advance_in(world, p, 1.0 / 64.0);
        t += 1.0 / 64.0; since += 1.0 / 64.0;
        if p.body.pos.y < mp.fall { break; }
      }
      name := cast(string) s.name[0..<s.name_n];
      if p.body.pos.y < mp.fall { fell += 1; print("  % %: fell out of the world on the way to %\n", m, iw_map_name(w[..], m), name); }
      else if stopped {
        near := jrw_touch(w[..], m, p.body.pos.x, p.body.pos.y, p.body.pos.z);
        if near.shape >= 0 && near.gap < 0.3 + JRW_TOUCH {
          sn := jrw_shape_name(cat, near.shape);
          if jrw_visible(w[..], cat, near.shape, sn) { seen += 1; print("  % %: on the way to %, stopped by %, which you can see\n", m, iw_map_name(w[..], m), name, sn); }
          else { unseen += 1; print("  % %: on the way to %, stopped by %, which nothing draws: an invisible blocker\n", m, iw_map_name(w[..], m), name, sn); }
        } else { seen += 1; print("  % %: on the way to %, stopped where no collider touches (a ledge or a corner)\n", m, iw_map_name(w[..], m), name); }
      } else if t < JRW_LEG { reached += 1; }
      else { print("  % %: % not reached in % s\n", m, iw_map_name(w[..], m), name, JRW_LEG); }
      // the next leg starts at this spot, on the ground under it (as the level puts its markers)
      p = walker.place_in(world, s.at[0], s.at[1], s.at[2], 0);
    }
    print("jam-route-walk: map % %: % legs, % reached, % stopped by something you can see, % by something you can't, % fell (% colliders, % over the walker's arrays)\n",
      m, iw_map_name(w[..], m), n, reached, seen, unseen, fell, c[0].nw + c[0].nf + c[0].nh + c[0].nb, c[0].over);
    invisible += unseen;
    if c[0].over > 0 { invisible += 1; }
  }
  if invisible > 0 { tool_errln("jam-route-walk: an invisible blocker, or colliders the walker could not take"); return 1; }
  print("jam-route-walk: no invisible blockers\n");
  return 0;
}
