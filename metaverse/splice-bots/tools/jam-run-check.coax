// tool.sh: stack-gib 1
// tool.sh: run-steps 250000000
// The jam run on a real pack (GitHub #13653; docs/unreal/2026-11-16-splice-bots-jam-port-plan.md, Acceptance):
// the game in the jam world (jam/jam-world.coax) read off PACK, a private pack the importer wrote
// (metaverse-engine/tools/unreal-level-import.coax), played three ways:
//   - the whole run, title to SCENE RESTORED and back (splice-game.coax g_play_run; long walks are
//     stood in for by placing her);
//   - from the farm's player start to Sniper with real keys (the mouse turns, W walks), against the
//     jam's own colliders;
//   - from the garage's door to the boss's fall with real keys (sp_keys_play), against them too;
//   - the jam's farm rules with real keys and clicks (jrc_farm_rules, jam/jam-farm.coax): a battery from a
//     charge point, the farm robot hit down and harvested with a held click.
//
//   coax/web/tool.sh metaverse/splice-bots/tools/jam-run-check.coax PACK [CHARS] [--tables TABLES]
//
// With CHARS, the characters pack (tools/jam-chars-pack.coax), it also checks the cast (jrc_chars):
// the Director with her ten clips, the six raider bodies, the 16 raiders in the ring that wear them, and the
// crowd's cards the audience stands at.
// With --tables TABLES, the tables pack (tools/jam-tables-pack.coax), the farm's rules play with the jam's Data
// tables (jam/jam-data.coax) and it checks them (jrc_tables): the farm's pickups take their items from the
// pickups table, and the story's first cards show with words from the strings table.
//
// It prints the route it read and a line a run: 0 is a pass, else the number of the beat that failed
// (the beats are numbered in g_run_to_garage, g_run_from_garage and sp_keys_play). It exits 1 when a run
// fails. The pack is the owner's content: read here, never written or copied.
#import "Basic";
#load "../splice-game.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../metaverse-engine/editor/pack.coax";
#load "../jam/jam-chars.coax";


jrc_line :: (what: string, r: int) { print("%: % %\n", what, r, ifx r == 0 then "(pass)" else "(failed at that beat)"); }

// ---- the jam's farm rules (jam/jam-farm.coax), with the keys and the mouse: walk to the nearest charge point
// and click it for a battery, walk to the farm's Imperial robot, click it down, hold the click to harvest it.
// 0 is a pass, else the beat that failed.
jrc_walk :: (g: [] SpGame, tx: f32, tz: f32, near: f32, secs: f32) -> bool {
  // straight at it, hopping the solar lines in the way as a player does (Space held 0.3 s of every 0.6 s)
  k := [1] SpKeys.[SpKeys.{}];
  for i: 0..<cast(int) (secs / 0.05) {
    _ := g_key(g, ' ', i % 12 < 6);
    _ = sp_keys_toward(g, k[..], tx, tz, 0.05);
    if dist2(g[0].px, g[0].pz, tx, tz) < near { break; }
  }
  sp_keys_free(g); _ := g_key(g, ' ', false); for i: 0..<40 { g_step(g, 0.02); }   // let go, and land
  g_look(g, -angle_wrap(ro_bearing(g[0].px, g[0].pz, tx, tz) - g[0].yaw) / T_LOOK, 0);   // face it with the mouse
  return dist2(g[0].px, g[0].pz, tx, tz) < near + 0.5;
}
jrc_click :: (g: [] SpGame, hold: f32) -> bool {
  r := g_pointer(g, 640, 360, 0);
  for i: 0..<cast(int) (hold / 0.02) { g_step(g, 0.02); }
  _ := g_pointer(g, 640, 360, 2); g_step(g, 0.02);
  return r;
}
jrc_farm_rules :: (g: [] SpGame, tables: string) -> int {
  g_reset(g); if tables != "" { sjx_data(g, tables); }
  if !(g_key(g, -2, true) && g_key(g, -2, true) && g[0].mode == M_PLAY && sjx_on(g)) { return 1; }
  x := g[0].jx[0];
  if x.charge_n == 0 || x.bot_n == 0 { return 2; }
  // the nearest charge point: a click, a battery
  best := 0; bd := 1e9f32;
  for i: 0..<x.charge_n { a := g[0].jr[0].actors[x.charge_actor[i]]; d := dist2(g[0].px, g[0].pz, a.x, a.z); if d < bd { bd = d; best = i; } }
  c := g[0].jr[0].actors[x.charge_actor[best]];
  if !jrc_walk(g, c.x, c.z, 1.8, 90) { print("  she stopped at (%, %); the charge point is at (%, %)\n", g[0].px, g[0].pz, c.x, c.z); return 3; }
  if !(jrc_click(g, 0.1) && sjx_count(g, ITEM_BATTERY) == 1) { return 4; }
  // the farm robot: clicked down (her hits, 0.35 s apart), then a held click harvests it
  for tries: 0..<60 {
    b := g[0].jx[0].bots[0];
    if b.robot.powered_down { break; }
    if !jrc_walk(g, b.x, b.z, 2.6, 60) { print("  she stopped at (%, %); the robot is at (%, %); mode %, look_free %, paused %, feet %\n", g[0].px, g[0].pz, b.x, b.z, g[0].mode, g[0].look_free, g[0].dr[0].paused, g_feet_y(g)); return 5; }
    _ := jrc_click(g, 0.4);
  }
  b := g[0].jx[0].bots[0];
  if !b.robot.powered_down { return 6; }
  if !jrc_walk(g, b.x, b.z, 2.6, 30) { return 7; }
  _ := jrc_click(g, 1.2);
  if !(g[0].jx[0].bots[0].harvested && sjx_count(g, ITEM_SMALL_CORE) == 1 && sjx_count(g, ITEM_IMPERIAL_PART) == 3) { return 8; }
  print("  her hotbar: % scrap, % battery, % core, % Imperial parts; Heat %\n", sjx_count(g, ITEM_SCRAP_PART), sjx_count(g, ITEM_BATTERY), sjx_count(g, ITEM_SMALL_CORE), sjx_count(g, ITEM_IMPERIAL_PART), g[0].jx[0].heat);
  return 0;
}

// ---- the characters pack (jam/jam-chars.coax): her body and the raiders' for the jam's ring. 0 is a pass,
// else 1 to 5: not read, no Director or a clip of hers missing, a raider body missing, fewer than 16 raiders,
// no crowd cards in the ring for the audience to stand at.
jrc_chars :: (path: string, j: [] SjJam) -> int {
  b: [16777216] u8; n := fs_size(path);
  if n < 0 || n > b.count || fs_read(path, b[0..<n]) != n { tool_errln("jam-run-check: could not read the characters pack"); return 1; }
  pack := cast(string) b[0..<n]; rd: [1] PackRead;
  if !pack_read(pack, rd[..]) { tool_err("jam-run-check: the characters pack is refused: "); tool_errln(rd[0].why); return 1; }
  c: [1] SjcCast;
  if !sjc_read(c[..], pack_bytes(pack, rd[..], 0)) { tool_err("jam-run-check: not a characters pack: "); tool_errln(c[0].why); return 1; }
  print("characters: %, % clips, % palette frames\n", c[0].n, c[0].clip_n, c[0].frames);
  her := sjc_find(c[..], "director");
  if her < 0 { print("  no director\n"); return 2; }
  for r: 0..<SJC_ROLES { if c[0].chars[her].clip[r] < 0 { print("  the director has no %\n", SJC_ROLE[r]); return 2; } }
  names := [6] string.["raider-1", "raider-2", "raider-3", "raider-4", "raider-5", "raider-6"];
  for k: 0..<6 { if sjc_find(c[..], names[k]) < 0 { print("  no %\n", names[k]); return 3; } }
  ring := 0;
  for i: 0..<SJ_ACTORS { if sj_nth(j, SJ_RAIDER, SJ_RING, i) < 0 { break; } ring += 1; }
  print("raiders in the ring: %\n", ring);
  // the crowd's cards (the page stands raiders where they are) and the unposed Director (the page hides it)
  cards := 0; figures := 0;
  for i: 0..<j[0].n { a := j[0].actors[i]; if a.kind == SJ_CROWD && a.route == SJ_RING { cards += a.parts; } if a.kind == SJ_FIGURE { figures += 1; } }
  print("the crowd's cards in the ring: %; unposed Directors, hidden: %\n", cards, figures);
  return ifx ring < 16 then 4 else ifx cards < 1 then 5 else 0;
}

// ---- the jam's Data tables (jam/jam-data.coax, jam/jam-story.coax): the farm's pickups take their items from
// the pickups table (more than scrap: batteries, cards, banned pieces), and in play the story's first tutorial
// card shows after 5 s and Sniper's after 6, with words from the strings table. 0 is a pass.
jrc_tables :: (g: [] SpGame, tables: string) -> int {
  g_reset(g); sjx_data(g, tables);
  if !(g_key(g, -2, true) && g_key(g, -2, true) && g[0].mode == M_PLAY && sjx_on(g)) { return 1; }
  x := g[0].jx[0]; kinds := 0; seen: [16] string;
  for k: 0..<x.pick_n {
    item := x.pick_item[k]; new := true;
    for q: 0..<kinds { if seen[q] == item { new = false; } }
    if new && kinds < 16 { seen[kinds] = item; kinds += 1; print("  a farm pickup: %\n", item); }
  }
  if kinds < 2 { return 2; }
  for i: 0..<cast(int) (6.2 / 0.02) { g_step(g, 0.02); }
  t := sjs_now(g, SR_LANE_TUTORIAL); sn := sjs_now(g, SR_LANE_SNIPER);
  print("  cards: tutorial \"%\", Sniper \"%\"\n", t, sn);
  if t.count == 0 { return 3; }
  if sn.count == 0 { return 4; }
  return 0;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { return 2; }
  pos: [2] string; pn_ := 0; tables_path := "";
  for i: 0..<args_count(a[..]) {
    v := args_at(a[..], i);
    if v == "--tables" && i + 1 < args_count(a[..]) { tables_path = args_at(a[..], i + 1); continue; }
    if i > 0 && args_at(a[..], i - 1) == "--tables" { continue; }
    if pn_ < 2 { pos[pn_] = v; } pn_ += 1;
  }
  if pn_ < 1 || pn_ > 2 { print("usage: jam-run-check PACK [CHARS] [--tables TABLES]\n"); return 2; }
  tables_b: [1048576] u8; tables := "";
  if tables_path != "" {
    tn := fs_size(tables_path);
    if tn < 0 || tn > tables_b.count || fs_read(tables_path, tables_b[0..<tn]) != tn { tool_errln("jam-run-check: could not read the tables pack"); return 1; }
    trd: [1] PackRead;
    if !pack_read(cast(string) tables_b[0..<tn], trd[..]) { tool_err("jam-run-check: the tables pack is refused: "); tool_errln(trd[0].why); return 1; }
    tables = pack_bytes(cast(string) tables_b[0..<tn], trd[..], 0);
  }
  pack_b: [268435456] u8; path := pos[0]; pn := fs_size(path);
  if pn < 0 || pn > pack_b.count || fs_read(path, pack_b[0..<pn]) != pn { tool_errln("jam-run-check: could not read the pack"); return 1; }
  pack := cast(string) pack_b[0..<pn]; rd: [1] PackRead;
  if !pack_read(pack, rd[..]) { tool_err("jam-run-check: the pack is refused: "); tool_errln(rd[0].why); return 1; }
  cat := pack_bytes(pack, rd[..], 0);
  s := [1] SjStore.[SjStore.{}];
  if !sj_load(s[..], cat) { tool_err("jam-run-check: no jam world: "); tool_errln(s[0].jam[0].why); return 1; }
  j := s[0].jam[0];
  for r: 0..<SJ_MAPS {
    c := s[0].cols[r];
    if j.map[r] < 0 { print("%: not in the pack\n", SJ_MAP_IDS[r]); continue; }
    print("%: % boxes, % solids, % floors, % over the arrays, %\n", SJ_MAP_IDS[r], c.nw, c.nh, c.nf, c.over, ifx j.spawn[r].ok then "a player start" else "no player start");
  }
  for k: 0..<SJ_KINDS { print("% %\n", SJ_CLASS[k], j.count[k]); }
  print("colliders of walls always open left out (the farm's block over the garage, its mountains over the lab): %; gates of a second kind on one map: %\n", s[0].stand_ins, s[0].mixed);
  failed := false;
  // the whole run
  g := [1] SpGame.[SpGame.{}]; g_reset(g[..]); _ := spw_shipped(g[..]);
  sj_bind(g[..], s[..]);
  r := g_play_run(g[..]); jrc_line("the whole run", r); failed = failed || r != 0;
  if r != 0 { print("  she stopped at (%, %), zone %, phase %\n", g[0].px, g[0].pz, g[0].zone, g[0].phase); }
  // the farm's start to Sniper's door with the keys
  g_reset(g[..]);
  ok := g_key(g[..], -2, true) && g_key(g[..], -2, true) && g[0].mode == M_PLAY;
  tr := g_shipped_at(g[..], 123); k := [1] SpKeys.[SpKeys.{}]; d: f32 = 1e9;
  for i: 0..<cast(int) (120 / 0.05) { d = sp_keys_toward(g[..], k[..], tr.x + 2.2, tr.z, 0.05); if dist2(g[0].px, g[0].pz, tr.x, tr.z) < T_SAVE_RANGE { break; } }
  sp_keys_free(g[..]);
  r = ifx ok && dist2(g[0].px, g[0].pz, tr.x, tr.z) < T_SAVE_RANGE then 0 else 1;
  if r != 0 { print("  she stopped at (%, %); Sniper is at (%, %)\n", g[0].px, g[0].pz, tr.x, tr.z); }
  print("the farm's start to Sniper with the keys: % m from the door's mark\n", cast(int) d); jrc_line("the farm's start to Sniper", r); failed = failed || r != 0;
  // the garage's door to the boss with the keys
  g_reset(g[..]);
  r = g_run_to_garage(g[..]);
  if r == 0 { r = sp_keys_play(g[..]); }
  jrc_line("the garage's door to the boss with the keys", r);
  print("  the boss: % health; it bit % times and hit her % (jam/jam-boss.coax)\n", g[0].bt[0].bots[SB_BOSS].vit.most, g[0].jx[0].bite[0].bites, g[0].jx[0].bite[0].hits);
  if r != 0 { print("  she stopped at (%, %), zone %\n", g[0].px, g[0].pz, g[0].zone); }
  failed = failed || r != 0;
  // the jam's farm rules with the keys and the mouse
  r = jrc_farm_rules(g[..], tables); jrc_line("the farm's rules: a charge point, the farm robot down and harvested", r); failed = failed || r != 0;
  // the route walk (jam/jam-walk.coax): every stop explained by a collider the realm draws
  failed = jrc_route_walk(g[..], s[..], cat) || failed;
  // the characters: her body and the raiders' (jam/jam-chars.coax)
  if tables != "" { r = jrc_tables(g[..], tables); jrc_line("the Data tables: the pickups' items and the story's cards", r); failed = failed || r != 0; }
  if pn_ == 2 { r = jrc_chars(pos[1], s[0].jam[..]); jrc_line("the characters: the Director, six raiders, 16 in the ring", r); failed = failed || r != 0; }
  return ifx failed then 1 else 0;
}
// The route walk scene by scene, and a solar bank stood against and on: whether anything failed.
jrc_route_walk :: (g: [] SpGame, s: [] SjStore, cat: string) -> bool #effects(all) {
  bad := false; w := [1] SjWalk.[SjWalk.{}];
  for k: 0..<SJW_SCENES {
    g_reset(g);
    sjw_scene(g, s, w[..], k);
    print("the route walk, %: % steps, % stops by % blockers, % invisible, % of % legs missed\n", SJW_SCENE_NAMES[k], w[0].steps, w[0].stops, w[0].ns, w[0].invisible, w[0].missed, w[0].legs);
    for i: 0..<w[0].ns {
      b := w[0].seen[i];
      if b.drawn { continue; }
      print("  invisible: % at (%, %), % steps: ", ifx b.what == SJW_JAM then "a route map's collider" else ifx b.what == SJW_GAME then "a game collider" else "nothing found", b.x, b.z, b.hits);
      if b.what == SJW_JAM { print("% % % %\n", SJ_MAP_IDS[b.map], b.shape, b.index, jrc_actor(cat, s[0].jam[0].map[b.map], b.actor)); } else { print("kind % row %\n", b.kind, b.index); }
    }
    for i: 0..<lo_int(w[0].missed, SJW_MISSES) { o := i * 4; print("  a missed leg left her at (%, %) on the way to (%, %)\n", w[0].miss[o], w[0].miss[o + 1], w[0].miss[o + 2], w[0].miss[o + 3]); }
    for i: 0..<w[0].ns { b := w[0].seen[i]; if b.drawn && b.what == SJW_JAM && b.hits > 200 { print("  drawn: %, % steps from (%, %)\n", jrc_actor(cat, s[0].jam[0].map[b.map], b.actor), b.hits, b.x, b.z); } }
    bad = bad || w[0].invisible > 0 || w[0].missed > 0 || w[0].over > 0;
  }
  g_reset(g); w[0] = SjWalk.{};
  r := sjw_bank(g, s, w[..], FF_XW + FF_PITCH * 2.5, ff_line_z(2));
  print("a solar bank: % (%)\n", r, ifx r == 0 then "its posts and glass stop her, she lands on its glass and stands there" else "failed");
  g_reset(g);
  m := sjw_mech(g, s, w[..]);
  print("the drill mech's path, its bay to the barricade: % (%), % steps, never more than % m from her, % steps in a wall\n", m, ifx m == 0 then "the jam's walls hold it and it drills" else "failed", w[0].steps, cast(int) w[0].mech_far, w[0].mech_in);
  for i: 0..<lo_int(w[0].missed, SJW_MISSES) { o := i * 4; print("  a missed leg left her at (%, %) on the way to (%, %)\n", w[0].miss[o], w[0].miss[o + 1], w[0].miss[o + 2], w[0].miss[o + 3]); }
  return bad || r != 0 || m != 0;
}
// The name of map m's collider actor with this hash, from the catalog's col lines.
jrc_actor :: (cat: string, m: int, actor: u32) -> string #effects(all) {
  from := 0;
  for at: 0..<cat.count + 1 {
    if at < cat.count && cat[at] != '\n' { continue; }
    line := cat[from..<at]; from = at + 1;
    if iw_field(line, 0) != "col" || cast(int) sj_num(iw_field(line, 1)) != m { continue; }
    name := iw_actor_name(iw_field(line, iw_fields(line) - 1));
    if iw_hash(name) == actor { return name; }
  }
  return "(none)";
}
