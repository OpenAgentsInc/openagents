// Splice's answers to `why ID` (GitHub #13429): the chain of metaverse-engine/agent/why.coax walked
// for the things an agent asks about, from the game's own state. Nothing here changes the game.
//
//   you          the smuggler
//   piece-N      the placed piece with layer item id N (layer.coax)
//   foe-N        raider or Imperial robot N (0 to FOES - 1)
//   rubble       the mine's rubble, which the Digger opens
//   boss-wall    the boss wall, which the Digger opens
//   caps         the limits the game applied this run: slots, rows, stores, a held frame
//
// What each link reads:
//   state     the layer's items and the pieces table; the foes' list; the page being the game
//   spawned   the World of colliders (sl_sync builds placed pieces at the layer's revision)
//   view      the camera's frame this frame (animelab.coax NEAR and FAR, the camera's angle)
//   drawn     the place store's rows and the draw records (layer-draw.coax); the mode and the
//             kinds a host hides for what moves
//   asset     the kind's mesh in the piece store
//   collider  the World entity's shape, and whether it blocks now
//   system    whether the game's step ran this frame, and the mode
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax --only why
#load "../../metaverse-engine/agent/why.coax";

// What the page knows that the game doesn't: the frame's shape, whether it holds still, and its stores' room.
SyPage :: struct {
  aspect: f32 = 1.7778;
  held: bool;            // the frame didn't step (a still or a golden frame)
  gallery: bool;         // ?scene=N: the page is a still scene, not the game
  places_cap: int = SL_ITEMS * SD_ROW;   // the placed pieces' rows (the place store's last row is the player's)
  draws_cap: int = 4 * (2 + SC_PIECE_MAX);
  world_over: bool; live_over: bool;   // the world's or the live store's writer ran out of room
  store_cap: int = 150000;             // vertices either store holds (splice-bots.coax SP_WORLD_WORDS)
}

SY_MODES :: [9] string.["title", "play", "bay", "banner", "memory", "restored", "ride", "character", "credits"];
sy_mode :: (m: int) -> string { return ifx m >= 0 && m < SY_MODES.count then SY_MODES[m] else "?"; }
// "piece-12" with head "piece-" is 12; -1 when it isn't that.
sy_number :: (id: string, head: string) -> int {
  if id.count <= head.count || id.count > head.count + 6 || id[0..<head.count] != head { return -1; }
  v := 0;
  for i: head.count..<id.count { d := cast(int) id[i] - 48; if d < 0 || d > 9 { return -1; } v = v * 10 + d; }
  return v;
}
sy_text_i :: (out: [] u8, a: string, v: int, b: string) -> string {
  n := drv_put_s(out, 0, a); n = drv_put_i(out, n, v); n = drv_put_s(out, n, b);
  return cast(string) out[0..<n];
}
// The view link for a point: inside the camera's frame, between the near and far planes.
sy_view :: (w: [] Why, g: [] SpGame, pg: SyPage, p: Point) {
  c := g_camera(g);
  f := unit_or(sub(c.at, c.eye), v3(0, 0, -1));
  r := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0));
  up := cross(r, f);
  d := sub(p, c.eye);
  depth := dot(d, f); side := dot(d, r); rise := dot(d, up);
  t := tan(c.fov * 0.5);
  if depth < NEAR { why_fail_m(w, WHY_NOT_IN_VIEW, "camera.depth", "at least", NEAR, depth); return; }
  if depth > FAR { why_fail_m(w, WHY_NOT_IN_VIEW, "camera.depth", "at most", FAR, depth); return; }
  // two metres of grace: a thing whose middle is just past the edge still shows
  if abs(side) > depth * t * pg.aspect + 2 { why_fail(w, WHY_NOT_IN_VIEW, "camera.frame", "inside the frame", ifx side > 0 then "past its right edge" else "past its left edge"); return; }
  if abs(rise) > depth * t + 2 { why_fail(w, WHY_NOT_IN_VIEW, "camera.frame", "inside the frame", ifx rise > 0 then "above its top edge" else "below its bottom edge"); return; }
  why_pass(w, WHY_VIEW);
}
// The system link for what the game's step moves.
sy_system :: (w: [] Why, g: [] SpGame, pg: SyPage) {
  if pg.held { why_fail(w, WHY_SYSTEM_PAUSED, "frame.step", "above 0 s", "0 s: the page holds this frame still"); return; }
  if g[0].mode != M_PLAY { why_fail(w, WHY_SYSTEM_PAUSED, "game.mode", "play", sy_mode(g[0].mode)); return; }
  why_pass(w, WHY_SYSTEM);
}
// The drawn link for what moves (the live store): the mode shows it, no host hides its kind, the store had room.
sy_live :: (w: [] Why, g: [] SpGame, pg: SyPage, kind: int, in_mine: bool) {
  m := g[0].mode;
  if m == M_BAY || m == M_MEMORY || m == M_RESTORED || (m == M_RIDE && g[0].zone == Z_RAIL) { why_fail(w, WHY_DRAW_HIDDEN, "game.mode", "play", sy_mode(m)); return; }
  if in_mine && g[0].zone != Z_MINE { why_fail(w, WHY_DRAW_HIDDEN, "game.zone", "the mine", ifx g[0].zone == Z_VILLAGE then "the village" else "the rail"); return; }
  if g[0].hide[kind] { why_fail(w, WHY_DRAW_HIDDEN, "game.hide", "false", "true: a host draws this kind itself"); return; }
  if pg.live_over { why_fail(w, WHY_DRAW_DROPPED, "live.vertices", "room in the live store", "the store is full"); return; }
  why_pass(w, WHY_DRAWN);
}
// The World slot of the live entity with this kind and row, or -1.
sy_slot :: (g: [] SpGame, kind: int, row: int) -> int {
  w := sl_world(g);
  for s: 0..<world_high(w) {
    if world_at(w, s) != ENTITY_NONE && world_i(w, WI_KIND, s) == kind && world_i(w, WI_ROW, s) == row { return s; }
  }
  return -1;
}

sy_you :: (w: [] Why, g: [] SpGame, pg: SyPage) {
  why_pass(w, WHY_STATE); why_pass(w, WHY_SPAWNED);
  y := g_feet_y(g);
  sy_view(w, g, pg, v3(g[0].px, y + 1, g[0].pz));
  sy_live(w, g, pg, TK_SMUGGLER, false);
  why_skip(w, WHY_ASSET);          // drawn from the cast's shapes each frame: nothing to load
  why_pass(w, WHY_COLLIDER);       // a walker: a circle of T_RADIUS, pushed out by the World
  sy_system(w, g, pg);
}
sy_foe :: (w: [] Why, g: [] SpGame, pg: SyPage, i: int) {
  b: [WHY_TEXT] u8;
  if i < 0 || i >= FOES { why_fail(w, WHY_NOT_IN_STATE, "game.foes", sy_text_i(b[..], "a foe from 0 to ", FOES - 1, ""), "none with that number"); return; }
  why_pass(w, WHY_STATE);
  if g[0].fhp[i] <= 0 { why_fail(w, WHY_DESPAWNED, "game.fhp", "above 0", "0: it was beaten"); return; }
  why_pass(w, WHY_SPAWNED);
  sy_view(w, g, pg, v3(g[0].fx[i], ground_y(g, g[0].fx[i], g[0].fz[i]) + 1, g[0].fz[i]));
  sy_live(w, g, pg, ifx i < F_RAIDERS then TK_RAIDER else TK_IMPERIAL, true);
  why_skip(w, WHY_ASSET);
  why_pass(w, WHY_COLLIDER);       // touched by distance (T_RAIDER_REACH, T_HIT_RANGE), not by a World shape
  sy_system(w, g, pg);
}
// The rubble or the boss wall: a World box that stops blocking, and stops being drawn, once the Digger opens it.
sy_gate :: (w: [] Why, g: [] SpGame, pg: SyPage, kind: int, gone: bool, z: f32, field: string) {
  why_pass(w, WHY_STATE);
  s := sy_slot(g, kind, 0);
  if s < 0 { why_fail_i(w, WHY_SPAWN_REFUSED, "world.slots", "at most", SL_CAP, SL_CAP + g[0].ws[0].refused); return; }
  why_pass(w, WHY_SPAWNED);
  sy_view(w, g, pg, v3(0, 2, z));
  if why_failed(w) { return; }
  if gone { why_fail(w, WHY_DRAW_HIDDEN, field, "false", "true: the Digger opened it"); return; }
  sy_live(w, g, pg, TK_PICKUP, true);
  why_skip(w, WHY_ASSET);
  if why_failed(w) { return; }
  why_judge(w, WHY_COLLIDER, sl_solid(g, s, false), WHY_COLLIDER_OPEN, field, "false", "true");
  why_skip(w, WHY_SYSTEM);         // scenery: no system moves it
}
sy_piece :: (w: [] Why, g: [] SpGame, d: [] SpLayerDraw, pg: SyPage, id: int) {
  b: [WHY_TEXT] u8; a: [WHY_TEXT] u8;
  c := g[0].c[..]; l := g[0].layer[..];
  at := sl_item(g, id);
  if at < 0 { why_fail(w, WHY_NOT_IN_STATE, "layer.items", sy_text_i(b[..], "an item with id ", id, ""), sy_text_i(a[..], "none (", l[0].st[0].n, " items)")); return; }
  item := l[0].items[at];
  row := sc_piece(c, item.mesh);
  if row < 0 { why_fail(w, WHY_NOT_IN_STATE, "content.pieces", sy_text_i(b[..], "a row with id ", item.mesh, ""), "none"); return; }
  why_pass(w, WHY_STATE);
  if l[0].built != l[0].rev { why_fail_i(w, WHY_SPAWN_PENDING, "layer.built", "revision", l[0].rev, l[0].built); return; }
  s := sy_slot(g, item.mesh, item.id);
  if s < 0 { why_fail_i(w, WHY_SPAWN_REFUSED, "world.slots", "at most", SL_CAP, SL_CAP + g[0].ws[0].refused); return; }
  why_pass(w, WHY_SPAWNED);
  sy_view(w, g, pg, v3(item.x, item.y + c[0].pieces[row].top * 0.5, item.z));
  if why_failed(w) { return; }
  // drawn: the place store's rows are the layer's revision, and this item's row and its kind's draw record had room
  if d[0].place_rev != l[0].rev { why_fail_i(w, WHY_DRAW_PENDING, "draw.place_rev", "revision", l[0].rev, d[0].place_rev); return; }
  before := 0;
  for i: 0..<at { if l[0].items[i].mesh == item.mesh { before += 1; } }
  if before >= d[0].rows[row] { why_fail_i(w, WHY_DRAW_DROPPED, "draw.place_rows", "at most", pg.places_cap / SD_ROW, d[0].row0[row] + before + 1); return; }
  record := SD_BASE;
  for r: 0..<row { if d[0].rows[r] > 0 && d[0].count[r] > 0 { record += 1; } }
  if d[0].count[row] > 0 && (record + 1) * 4 > pg.draws_cap { why_fail_i(w, WHY_DRAW_DROPPED, "draw.records", "at most", pg.draws_cap / 4, record + 1); return; }
  why_pass(w, WHY_DRAWN);
  // asset: the kind's mesh, written once into the piece store
  if !d[0].meshed { why_fail(w, WHY_ASSET_LOADING, "draw.meshed", "true", "false: the first frame writes the meshes"); return; }
  if d[0].count[row] == 0 {
    if d[0].over { why_fail_i(w, WHY_ASSET_FAILED, "draw.mesh_n", "at most", SD_PIECE_WORDS / VERTEX_WORDS, d[0].mesh_n); return; }
    why_fail(w, WHY_ASSET_MISSING, "content.pieces.kit", "a kit piece with vertices", "0 vertices"); return;
  }
  why_pass(w, WHY_ASSET);
  if g[0].ws[0].ex[s] <= 0 { why_fail(w, WHY_COLLIDER_MISSING, "world.shape", "a radius above 0 m", "0 m"); return; }
  why_pass(w, WHY_COLLIDER);
  why_skip(w, WHY_SYSTEM);         // a placed piece is scenery: it has no AI and no hit points
}

// The caps the game applied, as why_cap lines.
sy_caps :: (g: [] SpGame, d: [] SpLayerDraw, pg: SyPage, out: [] u8) -> string {
  lines: [WHY_OUT] u8; n := 0;
  n = why_cap(lines[..], n, WHY_BUDGET_HIT, "world.slots", SL_CAP, g[0].ws[0].refused);
  n = why_cap(lines[..], n, WHY_BUDGET_HIT, "world.near", SL_NEAR, g[0].ws[0].crowded);
  rows := 0; for r: 0..<g[0].c[0].piece_n { rows += d[0].rows[r]; }
  n = why_cap(lines[..], n, WHY_BUDGET_HIT, "draw.place_rows", pg.places_cap / SD_ROW, ifx d[0].place_rev == g[0].layer[0].rev then g[0].layer[0].st[0].n - rows else 0);
  n = why_cap(lines[..], n, WHY_BUDGET_HIT, "draw.mesh_n", SD_PIECE_WORDS / VERTEX_WORDS, ifx d[0].over then 1 else 0);
  n = why_cap(lines[..], n, WHY_BUDGET_HIT, "world.vertices", pg.store_cap, ifx pg.world_over then 1 else 0);
  n = why_cap(lines[..], n, WHY_BUDGET_HIT, "live.vertices", pg.store_cap, ifx pg.live_over then 1 else 0);
  if pg.held { n = why_paused(lines[..], n, "frame.step", "above 0 s", "0 s: the page holds this frame still"); }
  return why_caps_answer(lines[..], 0, n, out);
}
// What an agent's `tree` lists of Splice this frame (metaverse-engine/agent/drive.coax): you first, then
// the foes still standing, the placed pieces by item id, and the two gates while they are shut. The
// ids are the ones `why` takes.
sy_list :: (g: [] SpGame, v: [] Drive) {
  if !v[0].on { return; }
  y := g_feet_y(g);
  drv_add(v, DRV_PLAYER, "you", -1, "Smuggler", g[0].px, y, g[0].pz, g[0].hearts, T_HEARTS, false);
  if g[0].zone != Z_MINE { return; }
  for i: 0..<FOES {
    if g[0].fhp[i] <= 0 { continue; }
    drv_add(v, DRV_MONSTER, "foe", i, ifx i < F_RAIDERS then "Raider" else "Imperial robot", g[0].fx[i], ground_y(g, g[0].fx[i], g[0].fz[i]), g[0].fz[i],
            g[0].fhp[i], ifx i < F_RAIDERS then T_RAIDER_HP else T_IMPERIAL_HP, false);
  }
  for i: 0..<g[0].layer[0].st[0].n {
    item := g[0].layer[0].items[i];
    drv_add(v, DRV_OBJECT, "piece", item.id, sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], item.mesh)), item.x, item.y, item.z, -1, -1, false);
  }
  if !g[0].rubble_gone { drv_add(v, DRV_OBJECT, "rubble", -1, "Rubble", 0, 0, g[0].at.rubble_z, -1, -1, false); }
  if !g[0].wall_gone { drv_add(v, DRV_OBJECT, "boss-wall", -1, "Boss wall", 0, 0, g[0].at.wall_z, -1, -1, false); }
}
// One command from a driver (coax drive, message 700), at the game's clock: `why` is answered here,
// what the engine's driver reads (tree, layout, status, quiet, target, stop) by it, and a world
// operation is refused by name: Splice's walk isn't steered by the driver yet.
sy_drive :: (g: [] SpGame, d: [] SpLayerDraw, pg: SyPage, v: [] Drive, text: string, now: f32) -> string {
  op := drv_word(text, 0);
  v[0].on = true;
  if op == "why" {
    a := sy_why(g, d, pg, text, v[0].out[..]);
    // the tree's own cap is reported with the game's
    if why_asks(text) == "caps" && v[0].lost > 0 {
      lines: [WHY_OUT] u8; n := drv_put_s(lines[..], 0, a);
      // drop the header line; why_caps_answer writes it again with the new count
      from := 0; while from < n && lines[from] != '\n' { from += 1; } from += 1;
      n = why_cap(lines[..], n, WHY_BUDGET_HIT, "tree.entities", DRV_ENTS, v[0].lost);
      a = why_caps_answer(lines[..], from, n, v[0].out[..]);
    }
    return drv_say(v, a.count);
  }
  if op == "walk-to" || op == "face" || op == "use" || op == "mount" {
    return drv_say3(v, "Splice Bots takes no world operations from a driver yet (", op, "); it answers tree, layout, target ID, status, why ID and why caps");
  }
  return drv_command(v, text, now);
}
// One `why` command's answer into out. `text` is the command ("why piece-3").
sy_why :: (g: [] SpGame, d: [] SpLayerDraw, pg: SyPage, text: string, out: [] u8) -> string {
  id := why_asks(text);
  if id == "-" { n := drv_put_s(out, 0, "unknown operation; this realm answers: why ID, why caps\n"); return cast(string) out[0..<n]; }
  if id == "" { n := drv_put_s(out, 0, "why takes an id: you, piece-N, foe-N, rubble, boss-wall, or caps\n"); return cast(string) out[0..<n]; }
  if id == "caps" { return sy_caps(g, d, pg, out); }
  w: [1] Why;
  why_begin(w[..], id);
  if pg.gallery { why_fail(w[..], WHY_NOT_IN_STATE, "page.scene", "the game", "a still scene (?scene=N)"); }
  else if id == "you" { sy_you(w[..], g, pg); }
  else if id == "rubble" { sy_gate(w[..], g, pg, SK_RUBBLE, g[0].rubble_gone, g[0].at.rubble_z, "game.rubble_gone"); }
  else if id == "boss-wall" { sy_gate(w[..], g, pg, SK_BOSS_WALL, g[0].wall_gone, g[0].at.wall_z, "game.wall_gone"); }
  else if sy_number(id, "piece-") >= 0 { sy_piece(w[..], g, d, pg, sy_number(id, "piece-")); }
  else if sy_number(id, "foe-") >= 0 { sy_foe(w[..], g, pg, sy_number(id, "foe-")); }
  else { why_fail(w[..], WHY_NOT_IN_STATE, "id", "you, piece-N, foe-N, rubble or boss-wall", id); }
  return why_answer(w[..], out);
}
