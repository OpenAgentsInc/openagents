// The checks of Splice as a world with an ID (world.coax; GitHub #13412). splice-game.coax loads this
// file with `#load ... #test;`.

SpwTest :: struct { g: [1] SpGame; x: [1] SpwWork; doc: [SPW_DOC] u8; next: [SPW_DOC] u8; third: [SPW_DOC] u8; did: [WE_BATCH_BODY] u8; inv: [WE_BATCH_BODY] u8; back: [WE_BATCH_BODY] u8; why: [240] u8; }
spt_why :: (t: [] SpwTest, b: SpwBatch) -> string { return cast(string) t[0].why[0..<b.why]; }
// Two places the fixture layer uses: a palm by the scanner gate, a small crate by the rover's door.
SPT_TWO :: "{\"schema\":\"world.edit.v1\",\"rev\":0,\"do\":\"apply\",\"edits\":[{\"op\":\"spawn\",\"id\":0,\"kind\":113,\"x\":17720,\"y\":0,\"z\":-7060,\"yaw\":0,\"scale\":100},{\"op\":\"spawn\",\"id\":0,\"kind\":117,\"x\":280,\"y\":0,\"z\":150,\"yaw\":0,\"scale\":100}]}";

#test "Splice Bots' world: the empty document opens, a batch places pieces, and the document it saves opens to the same bytes" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..];
  empty := spw_empty(g, t[0].x[0].k[..], t[0].doc[..]);
  #assert empty.count > 0 && spw_open(g, t[0].x[0].k[..], empty) == SPW_OK && g[0].layer[0].head == 0 && g[0].layer[0].st[0].n == 0;
  b := spw_batch(g, t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && b.edits == 2 && b.doc > 0 && b.at == -1;
  doc := cast(string) t[0].next[0..<b.doc];
  // the batch as taken numbers its spawns; its inverse removes them, the last first
  #assert cast(string) t[0].did[0..<b.did] == "{\"schema\":\"world.edit.v1\",\"rev\":0,\"do\":\"apply\",\"edits\":[{\"op\":\"spawn\",\"id\":1,\"kind\":113,\"x\":17720,\"y\":0,\"z\":-7060,\"yaw\":0,\"scale\":100},{\"op\":\"spawn\",\"id\":2,\"kind\":117,\"x\":280,\"y\":0,\"z\":150,\"yaw\":0,\"scale\":100}]}";
  #assert cast(string) t[0].inv[0..<b.inv] == "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"despawn\",\"id\":2},{\"op\":\"despawn\",\"id\":1}]}";
  #assert spw_open(g, t[0].x[0].k[..], doc) == SPW_OK && g[0].layer[0].head == 2 && g[0].layer[0].st[0].n == 2 && g[0].layer[0].st[0].next_id == 2 && g[0].layer[0].items[1].mesh == 117;
  #assert spw_save(g, t[0].x[0].k[..], t[0].third[..]) == doc;
  // a second host given the same edits one at a time holds the same bytes
  h := [1] SpGame.[SpGame.{}]; g_reset(h[..]); h[0].px = h[0].at.bay_x; h[0].pz = h[0].at.bay_z;
  #assert spw_open(h[..], t[0].x[0].k[..], empty) == SPW_OK;
  e: [WE_BATCH] WorldEdit; n := we_batch_read(SPT_TWO, e[..]).n;
  for i: 0..<n { #assert spw_edit(h[..], e[i], false).ok; }
  h[0].layer[0].head = 2; spw_build(h[..]);
  #assert spw_save(h[..], t[0].x[0].k[..], t[0].third[..]) == doc && sl_digest(h[..]) == sl_digest(g);
  // and a page that follows the saved edits, keeping its run, holds the same pieces
  p := [1] SpGame.[SpGame.{}]; g_reset(p[..]); p[0].px = 177.2; p[0].pz = -70.6;   // you stand where the palm goes
  #assert we_batch_read(cast(string) t[0].did[0..<b.did], e[..]).ok;
  for i: 0..<n { r := spw_edit(p[..], e[i], true); #assert r.ok && r.id == i + 1; }
  #assert p[0].layer[0].st[0].n == 2 && editor_same_item(p[0].layer[0].items[0], g[0].layer[0].items[0]) && editor_same_item(p[0].layer[0].items[1], g[0].layer[0].items[1]);
  #assert !spw_edit(p[..], e[0], false).ok && spw_pins(p[..]).content == p[0].c[0].rev && spw_pins(p[..]).engine == SPW_ENGINE && spw_pins(p[..]).rules == SPW_RULES && spw_pins(p[..]).wire == SPW_WIRE;
}
#test "Splice Bots' world: a document saved under the world's old ID opens, and is saved again under its new one (#13486)" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..];
  empty := spw_empty(g, t[0].x[0].k[..], t[0].doc[..]);
  head := "world.doc.v1 splice-bots\n";
  #assert empty.count > head.count && cast(string) empty[0..<head.count] == head;
  b := spw_batch(g, t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && b.doc > head.count;
  doc := cast(string) t[0].next[0..<b.doc];
  old: [SPW_DOC] u8; other: [SPW_DOC] u8;
  n := ct_put(old[..], 0, "world.doc.v1 splice\n"); n = ct_put(old[..], n, doc[head.count..<doc.count]);
  m := ct_put(other[..], 0, "world.doc.v1 everglade\n"); m = ct_put(other[..], m, doc[head.count..<doc.count]);
  #assert spw_open(g, t[0].x[0].k[..], cast(string) old[0..<n]) == SPW_OK && g[0].layer[0].st[0].n == 2 && spw_save(g, t[0].x[0].k[..], t[0].third[..]) == doc;
  #assert spw_pieces(g, t[0].x[0].k[..], cast(string) other[0..<m]) == SPW_NOT_DOC;
  #assert spw_named("splice-bots") && spw_named("splice") && !spw_named("everglade") && !spw_named("") && !spw_named("Splice");
}
#test "Splice Bots' world: a stale batch, a refused edit and what is no batch change nothing, and a refusal names the zone" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..];
  empty := spw_empty(g, t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(g, t[0].x[..], empty, sc_edit_swap(SPT_TWO, "\"rev\":0", "\"rev\":1", t[0].back[..]), true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_STALE && b.doc == 0 && b.edits == 0;
  // the same body, not fenced (a stored step taken again), is taken
  #assert spw_batch(g, t[0].x[..], empty, sc_edit_swap(SPT_TWO, "\"rev\":0", "\"rev\":1", t[0].back[..]), false, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]).status == SPB_OK;
  // the second edit stands in the scanner gate's kept-clear zone: the whole batch is refused, and it says which edit and why
  b = spw_batch(g, t[0].x[..], empty, sc_edit_swap(SPT_TWO, "\"x\":280,\"y\":0,\"z\":150", "\"x\":17500,\"y\":0,\"z\":-6700", t[0].back[..]), true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && b.at == 1 && b.doc == 0 && spt_why(t[..], b) == "in the kept-clear zone 'Scanner gate'";
  b = spw_batch(g, t[0].x[..], empty, sc_edit_swap(SPT_TWO, "\"kind\":113", "\"kind\":999", t[0].back[..]), true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && b.at == 0 && spt_why(t[..], b) == "no piece has that content ID";
  b = spw_batch(g, t[0].x[..], empty, sc_edit_swap(SPT_TWO, "\"scale\":100", "\"scale\":150", t[0].back[..]), true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && spt_why(t[..], b) == "Splice Bots' pieces keep their size";
  // what Splice does not take, each in words
  no := [5] string.["{\"op\":\"scale\",\"id\":1,\"scale\":150}", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":300,\"z\":-200,\"r\":450,\"v\":80,\"mat\":3}", "{\"op\":\"cell\",\"table\":\"landmarks\",\"row\":16,\"col\":\"name\",\"v\":\"x\"}", "{\"op\":\"set\",\"id\":1,\"col\":\"hp\",\"v\":3}", "{\"op\":\"spawn\",\"id\":9,\"kind\":113,\"x\":17720,\"y\":0,\"z\":-7060,\"yaw\":0,\"scale\":100}"];
  codes := [5] int.[SPE_SIZE, SPE_LAND, SPE_TABLES, SPE_COLUMN, SPE_ID];
  #assert spw_open(g, t[0].x[0].k[..], empty) == SPW_OK && spw_edit(g, we_read("{\"op\":\"spawn\",\"id\":0,\"kind\":113,\"x\":17720,\"y\":0,\"z\":-7060,\"yaw\":0,\"scale\":100}"), false).ok;
  for i: 0..<5 { r := spw_edit(g, we_read(no[i]), false); #assert !r.ok && r.why == codes[i] && spw_why(g, r, t[0].why[..]).count > 10; }
  #assert !spw_edit(g, we_read("{\"op\":\"move\",\"id\":7,\"x\":0,\"y\":0,\"z\":0}"), false).ok && !spw_edit(g, WorldEdit.{}, false).ok && !spw_edit(g, WorldEdit.{}, true).ok && g[0].layer[0].st[0].n == 1;
  // what is no batch, a document that is none, and an undo (the caller's to turn into a stored step)
  #assert spw_batch(g, t[0].x[..], empty, "{}", true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]).status == SPB_BATCH;
  #assert spw_batch(g, t[0].x[..], empty, WE_UNDO_FIXTURE, false, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]).status == SPB_BATCH;
  b = spw_batch(g, t[0].x[..], "world.doc.v1 splice\n", SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_DOC && spt_why(t[..], b) == "that is not Splice Bots' world document";
  b = spw_batch(g, t[0].x[..], empty, "{\"schema\":\"world.edit.v1\",\"rev\":0,\"do\":\"original\",\"edits\":[]}", true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_NOTHING && spt_why(t[..], b) == "nothing to change";
  small: [64] u8;
  #assert spw_batch(g, t[0].x[..], empty, SPT_TWO, true, small[..], t[0].did[..], t[0].inv[..], t[0].why[..]).status == SPB_ROOM && spw_batch(g, t[0].x[..], empty, SPT_TWO, true, t[0].next[..], small[..], t[0].inv[..], t[0].why[..]).status == SPB_ROOM;
}
#test "Splice Bots' world: a batch's inverse takes it back, a move and a turn are edits, and ORIGINAL removes every piece and comes back whole" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..];
  empty := spw_empty(g, t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(g, t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK;
  two := cast(string) t[0].next[0..<b.doc];
  // a move, a turn and a set of x on piece 2; the inverse says where it stood
  m := spw_batch(g, t[0].x[..], two, "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"move\",\"id\":2,\"x\":300,\"y\":0,\"z\":120},{\"op\":\"rotate\",\"id\":2,\"yaw\":45},{\"op\":\"set\",\"id\":2,\"col\":\"x\",\"v\":310},{\"op\":\"set\",\"id\":2,\"col\":\"yaw\",\"v\":50}]}", true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert m.status == SPB_OK && m.edits == 4;
  #assert cast(string) t[0].inv[0..<m.inv] == "{\"schema\":\"world.edit.v1\",\"rev\":6,\"do\":\"apply\",\"edits\":[{\"op\":\"rotate\",\"id\":2,\"yaw\":45},{\"op\":\"move\",\"id\":2,\"x\":300,\"y\":0,\"z\":120},{\"op\":\"rotate\",\"id\":2,\"yaw\":0},{\"op\":\"move\",\"id\":2,\"x\":280,\"y\":0,\"z\":150}]}";
  moved := cast(string) t[0].third[0..<m.doc];
  // the inverse, taken unfenced as an undo is, gives the two pieces back where they stood
  u := spw_batch(g, t[0].x[..], moved, cast(string) t[0].inv[0..<m.inv], false, t[0].doc[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert u.status == SPB_OK && u.edits == 4;
  undone := cast(string) t[0].doc[0..<u.doc];
  #assert spw_open(g, t[0].x[0].k[..], undone) == SPW_OK && g[0].layer[0].head == 10 && we_cm(g[0].layer[0].items[1].x) == 280 && we_cm(g[0].layer[0].items[1].z) == 150 && we_deg(g[0].layer[0].items[1].yaw) == 0;
  // ORIGINAL: both pieces go, the newest first; its inverse brings each back under its number
  o := spw_batch(g, t[0].x[..], undone, "{\"schema\":\"world.edit.v1\",\"rev\":10,\"do\":\"original\",\"edits\":[]}", true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert o.status == SPB_OK && o.edits == 2 && cast(string) t[0].did[0..<o.did] == "{\"schema\":\"world.edit.v1\",\"rev\":10,\"do\":\"apply\",\"edits\":[{\"op\":\"despawn\",\"id\":2},{\"op\":\"despawn\",\"id\":1}]}";
  bare := cast(string) t[0].third[0..<o.doc];
  #assert spw_open(g, t[0].x[0].k[..], bare) == SPW_OK && g[0].layer[0].st[0].n == 0 && g[0].layer[0].st[0].next_id == 2 && g[0].layer[0].head == 12;
  r := spw_batch(g, t[0].x[..], bare, cast(string) t[0].inv[0..<o.inv], false, t[0].doc[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert r.status == SPB_OK && spw_open(g, t[0].x[0].k[..], cast(string) t[0].doc[0..<r.doc]) == SPW_OK && g[0].layer[0].st[0].n == 2 && g[0].layer[0].items[0].id == 0 && g[0].layer[0].items[1].id == 1 && g[0].layer[0].items[1].mesh == 117 && g[0].layer[0].head == 14;
  // a new piece after that never takes a number given before
  n := spw_batch(g, t[0].x[..], cast(string) t[0].doc[0..<r.doc], "{\"schema\":\"world.edit.v1\",\"rev\":14,\"do\":\"apply\",\"edits\":[{\"op\":\"despawn\",\"id\":2},{\"op\":\"spawn\",\"id\":0,\"kind\":117,\"x\":280,\"y\":0,\"z\":150,\"yaw\":0,\"scale\":100}]}", true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert n.status == SPB_OK && cast(string) t[0].inv[0..<n.inv] == "{\"schema\":\"world.edit.v1\",\"rev\":16,\"do\":\"apply\",\"edits\":[{\"op\":\"despawn\",\"id\":3},{\"op\":\"spawn\",\"id\":2,\"kind\":117,\"x\":280,\"y\":0,\"z\":150,\"yaw\":0,\"scale\":100}]}";
}
#test "Splice Bots' world: a document this build would not write is refused, and a batch that stops the walk is not saved" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..];
  empty := spw_empty(g, t[0].x[0].k[..], t[0].doc[..]);
  // a World that was edited in place (its slots' generations moved on) is a true document of a
  // World, with its own digest, but not the one a fresh game builds from the pieces
  e: [WE_BATCH] WorldEdit; n := we_batch_read(SPT_TWO, e[..]).n;
  #assert spw_open(g, t[0].x[0].k[..], empty) == SPW_OK;
  for i: 0..<n { #assert spw_edit(g, e[i], false).ok; }
  g[0].layer[0].head = 2;
  worn := spw_save(g, t[0].x[0].k[..], t[0].next[..]);
  #assert worn.count > 0 && spw_open(g, t[0].x[0].k[..], worn) == SPW_NOT_BUILT && spw_open_why(SPW_NOT_BUILT).count > 0 && spw_open_why(SPW_OK) == "";
  // another world's document, another content revision, and what is no document
  #assert spw_pieces(g, t[0].x[0].k[..], "") == SPW_NOT_DOC && spw_open_why(SPW_NOT_DOC) != spw_open_why(SPW_CONTENT) && spw_open_why(SPW_FULL).count > 0;
  g[0].c[0].rev += 1;
  #assert spw_pieces(g, t[0].x[0].k[..], empty) == SPW_CONTENT;
  g[0].c[0].rev -= 1;
  // with the scanner gate's kept-clear zone out of the tables the check lets a wall into the gate, and the walk refuses the batch
  sc_drop_kept(g[0].c[..], 1);
  b := spw_batch(g, t[0].x[..], empty, "{\"schema\":\"world.edit.v1\",\"rev\":0,\"do\":\"apply\",\"edits\":[{\"op\":\"spawn\",\"id\":0,\"kind\":116,\"x\":17500,\"y\":0,\"z\":-6700,\"yaw\":0,\"scale\":100}]}", true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_WALK && b.doc == 0 && spt_why(t[..], b).count > 20;
}

// ---- a page that follows the world (#13413)

SptPage :: struct { g: [1] SpGame; p: [1] SpwPage; t: [1] SpwTest; state: [SPW_DOC * 2] u8; ev: [WE_EVENT_BODY * 4] u8; }
// A lane's answer as the route writes it: "200\n" and the state with a document.
spt_state :: (x: [] SptPage, lane: int, rev: int, doc: string) -> string {
  v := WorldState.{lane = lane, rev = rev, dev = rev, live = ifx lane == WL_LIVE then rev else 0};
  n := ct_put(x[0].state[..], 0, "200\n");
  made := we_state_write(v, SPW_ID, doc, "", x[0].state[n..<x[0].state.count]);
  return cast(string) x[0].state[0..<n + made.count];
}
// Events' lines for a batch's edits from revision `from`, after "200\n".
spt_events :: (x: [] SptPage, batch: string, from: int) -> string {
  e: [WE_BATCH] WorldEdit; b := we_batch_read(batch, e[..]); o: [WE_EVENT_BODY] u8;
  n := ct_put(x[0].ev[..], 0, "200\n");
  for i: 0..<b.n { n = ct_put(x[0].ev[..], n, we_event_write(900 + i, SPW_ID, from + i, e[i], 1762190000000, o[..])); n = ct_put(x[0].ev[..], n, "\n"); }
  return cast(string) x[0].ev[0..<n];
}
// The follower asks, the "host" takes it under id 1, and the answer is `text`: what it answered.
spt_round :: (x: [] SptPage, dt: f32, text: string) -> int {
  f := x[0].p[0].f[..];
  wf_step(f, dt);
  if !wf_wants(f) { return -1; }
  wf_sent(f, 1);
  return spw_page_answer(x[0].g[..], x[0].p[..], 1, text);
}
#test "a page follows the world: it reads the document mid-run and keeps the run, takes outside edits in order through the edit log, and a placed piece rises in" #steps 4000000000 #traversal 2000000000 {
  x := [1] SptPage.[SptPage.{}]; g := x[0].g[..]; t := x[0].t[..]; f := x[0].p[0].f[..];
  empty := spw_empty(t[0].g[..], t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(t[0].g[..], t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  two := cast(string) t[0].next[0..<b.doc];
  // the page is in the mine, mid-run, carrying the arm
  g_reset(g); g_stage(g, 5); g[0].have[H_ARM] = true; g[0].heat = 37; px := g[0].px; pz := g[0].pz; stage_mode := g[0].mode;
  #assert spw_page_open(g, x[0].p[..], WL_DEV) && f[0].status == WFS_OPENING;
  #assert spt_round(x[..], 0.016, spt_state(x[..], WL_DEV, 2, two)) == WFQ_DOC;
  #assert f[0].status == WFS_FOLLOWING && f[0].rev == 2 && g[0].layer[0].head == 2 && g[0].layer[0].st[0].n == 2 && x[0].p[0].loads == 1;
  #assert g[0].px == px && g[0].pz == pz && g[0].have[H_ARM] && g[0].heat == 37 && g[0].mode == stage_mode && g[0].zone == Z_MINE;
  count := world_count(sl_world(g));
  // an outside batch (a second tab, the CLI): a move of piece 2 and a new crab-bot, as events 3 and 4
  out := "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"move\",\"id\":2,\"x\":300,\"y\":0,\"z\":120},{\"op\":\"spawn\",\"id\":3,\"kind\":103,\"x\":10253,\"y\":0,\"z\":-9247,\"yaw\":-60,\"scale\":100}]}";
  #assert spt_round(x[..], 1.1, spt_events(x[..], out, 3)) == WFQ_EVENTS;
  #assert f[0].rev == 4 && f[0].taken == 2 && g[0].layer[0].head == 4 && g[0].layer[0].st[0].n == 3 && we_cm(g[0].layer[0].items[1].x) == 300 && g[0].layer[0].items[2].mesh == 103;
  #assert world_count(sl_world(g)) == count + 1 && g[0].px == px && g[0].have[H_ARM] && g[0].zone == Z_MINE;
  // the new piece rises: drawn below where it stands, less each frame, then where it stands; the moved one does not
  top := g[0].c[0].pieces[sc_piece(g[0].c[..], 103)].top;
  #assert g[0].layer[0].rise_n == 1 && sl_sunk(g, 2, top) > top && sl_sunk(g, 1, top) == 0;
  shown := g[0].layer[0].shown; sl_rise_step(g, 0.35);
  #assert sl_sunk(g, 2, top) > 0 && sl_sunk(g, 2, top) < top * 0.5 && g[0].layer[0].shown == shown + 1;
  sl_rise_step(g, 0.4); #assert g[0].layer[0].rise_n == 0 && sl_sunk(g, 2, top) == 0;
  sl_rise_step(g, 0.4); #assert g[0].layer[0].shown == shown + 2;
  // UNDO works on an outside edit: it is a step of the layer's own log
  #assert sl_undo(g).ok && g[0].layer[0].st[0].n == 2 && sl_redo(g).ok && g[0].layer[0].st[0].n == 3;
  // events the page has already taken are passed over; one out of order sends it back to the document
  #assert spt_round(x[..], 1.1, spt_events(x[..], out, 3)) == WFQ_EVENTS && f[0].rev == 4 && f[0].reopened == 0;
  #assert spt_round(x[..], 1.1, spt_events(x[..], "{\"schema\":\"world.edit.v1\",\"rev\":5,\"do\":\"apply\",\"edits\":[{\"op\":\"despawn\",\"id\":1}]}", 6)) == WFQ_EVENTS;
  #assert f[0].rev == 4 && f[0].reopened == 1 && g[0].layer[0].st[0].n == 3;
  // the document again: the page stands at its revision, the run still as it was
  #assert spt_round(x[..], 0.016, spt_state(x[..], WL_DEV, 2, two)) == WFQ_DOC && f[0].rev == 2 && g[0].layer[0].st[0].n == 2 && g[0].px == px && x[0].p[0].loads == 2;
  // an event the layer can't take (no such piece) does the same; what is no answer is asked again
  #assert spt_round(x[..], 1.1, spt_events(x[..], "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"despawn\",\"id\":9}]}", 3)) == WFQ_EVENTS && f[0].reopened == 2 && f[0].rev == 2;
  #assert spt_round(x[..], 0.016, "200\n{}") == WFQ_DOC && f[0].rev == 2 && x[0].p[0].loads == 2;
  // the nudge: the page asks in the next frame
  #assert spt_round(x[..], WF_RETRY + 0.1, spt_state(x[..], WL_DEV, 2, two)) == WFQ_DOC;
  wf_nudge(f, SPW_ID);
  #assert spt_round(x[..], 0.016, spt_events(x[..], out, 3)) == WFQ_EVENTS && f[0].rev == 4;
}
#test "a page that plays follows live: a publish for now is read at once on its own pins, one for the next session is not" #steps 4000000000 #traversal 2000000000 {
  x := [1] SptPage.[SptPage.{}]; g := x[0].g[..]; t := x[0].t[..]; f := x[0].p[0].f[..]; o: [WE_PUBLISHED_BODY] u8; ev: [WE_PUBLISHED_BODY + 8] u8;
  empty := spw_empty(t[0].g[..], t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(t[0].g[..], t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  two := cast(string) t[0].next[0..<b.doc];
  g_reset(g);
  #assert spw_page_open(g, x[0].p[..], WL_LIVE);
  #assert spt_round(x[..], 0.016, "404\n{\"error\":\"nothing is published yet\"}") == WFQ_DOC && f[0].status == WFS_NOTHING && g[0].layer[0].st[0].n == 0;
  #assert spt_round(x[..], WF_IDLE + 1, "") == -1;   // the turn that decides to look again
  #assert spt_round(x[..], 0.016, spt_state(x[..], WL_LIVE, 1, empty)) == WFQ_DOC && f[0].status == WFS_FOLLOWING && f[0].rev == 1;
  mine := spw_pins(g);
  v := WorldPublished.{seq = 5, rev = 2, from = 2, when = WU_NEXT, engine = mine.engine, rules = mine.rules, content = mine.content, wire = mine.wire, at = 1762190000000};
  // for the next session: the page keeps what it joined
  n := ct_put(ev[..], 0, "200\n"); n = ct_put(ev[..], n, we_published_write(v, SPW_ID, o[..])); n = ct_put(ev[..], n, "\n");
  #assert spt_round(x[..], WF_POLL_LIVE + 0.1, cast(string) ev[0..<n]) == WFQ_EVENTS && f[0].rev == 2 && f[0].reopened == 0 && g[0].layer[0].st[0].n == 0;
  // for now, on this build's pins: the page reads the new document
  v.rev = 3; v.when = WU_NOW;
  n = ct_put(ev[..], 0, "200\n"); n = ct_put(ev[..], n, we_published_write(v, SPW_ID, o[..])); n = ct_put(ev[..], n, "\n");
  #assert spt_round(x[..], WF_POLL_LIVE + 0.1, cast(string) ev[0..<n]) == WFQ_EVENTS && f[0].rev == 3 && f[0].reopened == 1;
  #assert spt_round(x[..], 0.016, spt_state(x[..], WL_LIVE, 3, two)) == WFQ_DOC && g[0].layer[0].st[0].n == 2 && f[0].rev == 3;
  // for now, but for another build: not this session's
  v.rev = 4; v.wire = mine.wire + 1;
  n = ct_put(ev[..], 0, "200\n"); n = ct_put(ev[..], n, we_published_write(v, SPW_ID, o[..])); n = ct_put(ev[..], n, "\n");
  #assert spt_round(x[..], WF_POLL_LIVE + 0.1, cast(string) ev[0..<n]) == WFQ_EVENTS && f[0].rev == 4 && f[0].reopened == 1 && g[0].layer[0].st[0].n == 2;
  // a page told to reload stops asking
  #assert spw_page_open(g, x[0].p[..], WL_LIVE) && spt_round(x[..], 0.016, "409\n{\"error\":\"reload\"}") == WFQ_DOC && f[0].status == WFS_RELOAD && spt_round(x[..], 60, "") == -1;
}

SptShell :: struct { m: [1] EdModel; scratch: [EM_BYTES] u8; name: [EM_NAME] u8; }

#test "the editor shell is told the page's world: its pieces by kind, the selection, what a write made undoable, and a refusal; and only when one of them changed" #steps 4000000000 #traversal 2000000000 {
  x := [1] SptPage.[SptPage.{}]; g := x[0].g[..]; t := x[0].t[..]; p := x[0].p[..]; f := p[0].f[..];
  k := [1] SptShell.[SptShell.{}]; m := k[0].m[..];
  empty := spw_empty(t[0].g[..], t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(t[0].g[..], t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  g_reset(g);
  #assert spw_page_open(g, p, WL_DEV) && spt_round(x[..], 0.016, spt_state(x[..], WL_DEV, 2, cast(string) t[0].next[0..<b.doc])) == WFQ_DOC;
  // the model reads: two pieces, each of a kind the content names, and the columns a piece's edit may set
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]) && p[0].model_rev == 1;
  #assert m[0].ne == 2 && m[0].rev == 2 && m[0].lane == 0 && m[0].sel == 0 && m[0].nk == g[0].c[0].piece_n && m[0].nc == 7 * m[0].nk && m[0].no_n == 0;
  mt := m[0].table; c0 := m[0].c_col[0]; v0 := m[0].c_val[0];
  #assert cast(string) mt[0..<m[0].table_n] == "pieces" && cast(string) c0[0..<m[0].c_col_n[0]] == "name" && cast(string) v0[0..<m[0].c_val_n[0]] == sc_piece_name(g[0].c[..], 0) && m[0].c_kind[0] == g[0].c[0].pieces[0].id;
  #assert m[0].e_id[0] == 1 && m[0].e_kind[0] == 113 && m[0].e_x[0] == 17720 && m[0].e_z[0] == -7060 && m[0].e_id[1] == 2 && m[0].e_kind[1] == 117;
  #assert m[0].cols[WEC_X] && m[0].cols[WEC_Z] && m[0].cols[WEC_YAW] && !m[0].cols[WEC_Y] && !m[0].cols[WEC_KIND];
  #assert em_kind_name(m, 113, k[0].name[..]).count > 0 && em_kind_name(m, 113, k[0].name[..]) == sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], 113));
  // asked again with nothing changed, it is the same bytes and the same count
  again := spw_model(g, p);
  #assert p[0].model_rev == 1 && again.count == p[0].model_n;
  // a selection: a piece that is there; one that is not selects nothing
  spw_select(g, p, 2);
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]) && m[0].sel == 2 && p[0].model_rev == 2;
  spw_select(g, p, 9);
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]) && m[0].sel == 0;
  // the shell's batch goes as this page's own write; while it is in flight a second is said, not sent
  move := "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"set\",\"id\":2,\"col\":\"x\",\"v\":300}]}";
  #assert spw_shell_batch(p, move) && wf_body(f, p[0].batch[..]) == "" && f[0].body_n == move.count;
  #assert !spw_shell_batch(p, move) && em_read(m, spw_model(g, p), k[0].scratch[..]) && m[0].no_n > 0;
  // the write stood: its answer says one step can be undone, and its event moves the piece in the model
  did := "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"move\",\"id\":2,\"x\":300,\"y\":0,\"z\":150}]}";
  v := WorldState.{lane = WL_DEV, rev = 3, dev = 3, undo = 1};
  n := ct_put(x[0].state[..], 0, "200\n");
  made := we_state_write(v, SPW_ID, "", did, x[0].state[n..<x[0].state.count]);
  f[0].refused_n = 0;
  #assert made.count > 0 && spt_round(x[..], 0.016, cast(string) x[0].state[0..<n + made.count]) == WFQ_POST && f[0].undo == 1 && p[0].own_rev == 3;
  #assert spt_round(x[..], 0.016, spt_events(x[..], did, 3)) == WFQ_EVENTS && f[0].rev == 3;
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]) && m[0].rev == 3 && m[0].undo == 1 && m[0].redo == 0 && m[0].e_x[1] == 300 && m[0].no_n == 0;
  // a refusal from the server is in the model, in its words
  #assert spw_shell_batch(p, move);
  #assert spt_round(x[..], 0.016, "422\n{\"error\":\"in the kept-clear zone 'Scanner gate'\",\"edit\":0}") == WFQ_POST;
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]);
  no := m[0].no;
  #assert cast(string) no[0..<m[0].no_n] == "in the kept-clear zone 'Scanner gate'";
  // an edit from elsewhere leaves undo and redo open: the server answers what they do
  out := "{\"schema\":\"world.edit.v1\",\"rev\":3,\"do\":\"apply\",\"edits\":[{\"op\":\"despawn\",\"id\":1}]}";
  #assert spt_round(x[..], 1.1, spt_events(x[..], out, 4)) == WFQ_EVENTS && f[0].rev == 4;
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]) && m[0].ne == 1 && m[0].undo == 1 && m[0].redo == 1 && m[0].e_id[0] == 2;
  // the foes and their plans by time of day, the clock the story's, no foe shown (#13466)
  pt := m[0].ptable; ck := m[0].clock; an := m[0].a_name[5]; pr := m[0].p_route[em_plan_at(m, 6, "dusk")];
  #assert m[0].na == FOES && m[0].np == FOES * 4 && m[0].asel == 0 && cast(string) pt[0..<m[0].ptable_n] == "plans" && cast(string) ck[0..<m[0].clock_n] == "story";
  #assert cast(string) an[0..<m[0].a_name_n[5]] == "Imperial 1" && cast(string) pr[0..<m[0].p_route_n[em_plan_at(m, 6, "dusk")]] == "1010 -18880, 1010 -20080";
  // a foe shown: the model says so, the game draws its plan, and a page in the village goes to the mine
  spw_actor(g, p, 6);
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]) && m[0].asel == 6 && g[0].shown == 5 && g[0].zone == Z_MINE;
  spw_actor(g, p, 10);
  #assert em_read(m, spw_model(g, p), k[0].scratch[..]) && m[0].asel == 0 && g[0].shown == -1;
}

SptView :: struct { vp: [1] Viewport; w: [1] SpvWork; }

#test "the viewport on Splice: a tap picks the piece under it through query_ray or nothing, and marks here; a move drag is one snapped move sent as the page's write; the selected piece has a mark on the screen" #steps 4000000000 #traversal 2000000000 {
  x := [1] SptPage.[SptPage.{}]; g := x[0].g[..]; t := x[0].t[..]; p := x[0].p[..]; f := p[0].f[..];
  k := [1] SptView.[SptView.{}]; vp := k[0].vp[..]; w := k[0].w[..];
  empty := spw_empty(t[0].g[..], t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(t[0].g[..], t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  g_reset(g);
  #assert spw_page_open(g, p, WL_DEV) && spt_round(x[..], 0.016, spt_state(x[..], WL_DEV, 2, cast(string) t[0].next[0..<b.doc])) == WFQ_DOC;
  // the pieces are boxes a ray can hit, each under its number on the wire
  c := spv_boxes(g, w);
  #assert w[0].n == 2 && w[0].ids[0] == 1 && w[0].ids[1] == 2 && c.boxes.count == 2 * QUERY_BOX && w[0].boxes[QUERY_BOX + 3] > w[0].boxes[QUERY_BOX] && w[0].boxes[QUERY_BOX + 4] > w[0].boxes[QUERY_BOX + 1];
  item := g[0].layer[0].items[1];
  v := VpView.{ex = item.x, ey = item.y + 6, ez = item.z - 6, ax = item.x, ay = item.y + 0.3, az = item.z, fov = 0.8, w = 1000, h = 500};
  at := vp_project(v, item.x, item.y + 0.3, item.z);
  #assert at.ok && vp_act(vp, "tool select", v) && !spv_mark(g, p, vp, v).ok;
  spv_pointer(g, p, vp, w, v, at.x, at.y, 0); spv_pointer(g, p, vp, w, v, at.x, at.y, 2);
  #assert p[0].sel == 2 && p[0].here && p[0].here_x > 180 && p[0].here_x < 380 && p[0].here_z > 50 && p[0].here_z < 250;
  // the selected piece's mark holds its middle on the screen
  m := spv_mark(g, p, vp, v);
  #assert m.ok && m.x0 < at.x && m.x1 > at.x && m.y0 < at.y && m.y1 > at.y && m.x1 - m.x0 < 400;
  // a tap on the ground beside it selects nothing, and is the new here
  spv_pointer(g, p, vp, w, v, 950, 400, 0); spv_pointer(g, p, vp, w, v, 950, 400, 2);
  #assert p[0].sel == 0 && p[0].here && (p[0].here_x < 180 || p[0].here_x > 380) && !spv_mark(g, p, vp, v).ok;
  // the model tells the shell both
  km := [1] SptShell.[SptShell.{}];
  #assert em_read(km[0].m[..], spw_model(g, p), km[0].scratch[..]) && km[0].m[0].here && km[0].m[0].here_x == p[0].here_x && km[0].m[0].sel == 0;
  // a move drag: the piece is selected, then dragged a hand to the side; the write that goes is one move, on the grid
  spv_pointer(g, p, vp, w, v, at.x, at.y, 0); spv_pointer(g, p, vp, w, v, at.x, at.y, 2);
  #assert p[0].sel == 2 && vp_act(vp, "tool move", v) && f[0].body_n == 0;
  spv_pointer(g, p, vp, w, v, at.x, at.y, 0); spv_pointer(g, p, vp, w, v, at.x + 60, at.y, 1);
  moved := spv_mark(g, p, vp, v);
  #assert vp_dragging(vp) && moved.ok && moved.x0 != m.x0;
  spv_pointer(g, p, vp, w, v, at.x + 60, at.y, 2);
  e: [WE_BATCH] WorldEdit;
  sent := we_batch_read(cast(string) p[0].batch[0..<f[0].body_n], e[..]);
  #assert sent.ok && sent.rev == 2 && sent.what == WB_APPLY && sent.n == 1 && e[0].op == WE_MOVE && e[0].id == 2 && e[0].x != 280 && e[0].x % 50 == 0 && e[0].z == 150;
  // a cancel sends nothing, and a tool that holds nothing looks around when the camera flies
  f[0].body_n = 0;
  spv_pointer(g, p, vp, w, v, at.x, at.y, 0); spv_pointer(g, p, vp, w, v, at.x + 90, at.y, 1); spv_pointer(g, p, vp, w, v, at.x + 90, at.y, 3);
  #assert f[0].body_n == 0 && !vp[0].down;
  #assert vp_act(vp, "tool select", v) && vp_act(vp, "fly on", v);
  yaw := vp[0].fyaw;
  spv_pointer(g, p, vp, w, v, 500, 250, 0); spv_pointer(g, p, vp, w, v, 560, 250, 1); spv_pointer(g, p, vp, w, v, 560, 250, 2);
  #assert vp[0].fyaw != yaw && f[0].body_n == 0;
}

SptCell :: struct { c: [1] SpContent; keep: [SPW_TABLES] u8; two: [SPW_DOC] u8; after: [SPW_DOC] u8; }
// A batch of one cell edit from a revision.
spt_cell :: (out: [] u8, rev: int, table: string, row: int, col: string, value: string) -> string {
  e: [1] WorldEdit;
  e[0] = WorldEdit.{ok = true, op = WE_CELL, id = row};
  e[0].table_n = ct_copy(e[0].table[..], table); e[0].name_n = ct_copy(e[0].name[..], col); e[0].text_n = ct_copy(e[0].text[..], value);
  return we_batch_write(rev, WB_APPLY, e[..], 1, out);
}

#test "Splice Bots' world: a cell of the content tables is an edit: it is saved with the tables, its inverse takes it back, and what the column, the rules or a placed piece refuses changes nothing" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..]; x := t[0].x[..]; k := [1] SptCell.[SptCell.{}]; body: [WE_BATCH_BODY] u8;
  empty := spw_empty(g, x[0].k[..], t[0].doc[..]);
  b := spw_batch(g, x, empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  two := cast(string) k[0].two[0..<ct_copy(k[0].two[..], cast(string) t[0].next[0..<b.doc])];   // kept: the out buffers are written again below
  #assert b.status == SPB_OK && !x[0].ct[0].changed;
  // the small crate's name: one cell, saved as the tables' new text at the same revision
  b = spw_batch(g, x, two, spt_cell(body[..], 2, "pieces", 117, "name", "Tiny crate"), true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && b.edits == 1 && x[0].ct[0].changed && x[0].ct[0].open;
  text := cast(string) k[0].keep[0..<ct_copy(k[0].keep[..], spw_tables_text(x[0].ct[..]))];   // kept: the work's own text changes with its next batch
  #assert sc_load(k[0].c[..], text) && k[0].c[0].rev == g[0].c[0].rev && sc_piece_name(k[0].c[..], sc_piece(k[0].c[..], 117)) == "Tiny crate" && sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], 117)) == "Tiny crate";
  // the document's revision moved on; its pieces did not
  after := cast(string) k[0].after[0..<ct_copy(k[0].after[..], cast(string) t[0].third[0..<b.doc])];
  #assert after != two && g[0].layer[0].head == 3 && g[0].layer[0].st[0].n == 2;
  // the batch that takes it back is a cell edit too, and leaves the shipped tables
  inv := cast(string) t[0].inv[0..<b.inv];
  b = spw_batch(g, x, after, inv, true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_OK && spw_tables_text(x[0].ct[..]) == SC_SHIPPED && sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], 117)) == "Small crate";
  // a work that is given the world's own tables reads them: the name edited before is the one the game has
  y := [1] SpwWork.[SpwWork.{}];
  y[0].ct[0].text_n = ct_copy(y[0].ct[0].text[..], text);
  b = spw_batch(g, y[..], after, spt_cell(body[..], 3, "pieces", 116, "name", "Big crate"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_OK && sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], 117)) == "Tiny crate" && sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], 116)) == "Big crate";
  // tables that are not this build's are refused whole
  z := [1] SpwWork.[SpwWork.{}];
  z[0].ct[0].text_n = ct_copy(z[0].ct[0].text[..], "aethyr.content.v1 other 1\nreach 100\n");
  b = spw_batch(g, z[..], after, spt_cell(body[..], 3, "pieces", 116, "name", "Big crate"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_DOC && spt_why(t[..], b).count > 20;
  // no such column; a value its column does not take; a size the rules refuse; each in words, and nothing changed
  w := [1] SpwWork.[SpwWork.{}];
  b = spw_batch(g, w[..], two, spt_cell(body[..], 2, "pieces", 117, "colour", "red"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && b.at == 0 && spt_why(t[..], b) == "no such table, row or column, or a value that column does not take" && !w[0].ct[0].changed;
  b = spw_batch(g, w[..], two, spt_cell(body[..], 2, "pieces", 117, "scale", "lots"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && !w[0].ct[0].changed;
  b = spw_batch(g, w[..], two, spt_cell(body[..], 2, "pieces", 117, "scale", "5"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && spt_why(t[..], b) == "the tables' rules do not hold with that value" && !w[0].ct[0].changed && spw_tables_text(w[0].ct[..]) == SC_SHIPPED;
  // a kind grown until the piece of it that is placed no longer fits where it stands: the layer's own refusal
  b = spw_batch(g, w[..], two, spt_cell(body[..], 2, "pieces", 117, "hx", "9000"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && spt_why(t[..], b).count > 10 && !w[0].ct[0].changed && sc_piece(g[0].c[..], 117) >= 0;
  hx := g[0].c[0].pieces[sc_piece(g[0].c[..], 117)].hx;
  #assert hx < 1;
}

#test "Splice Bots' world: a foe's plan and the editor's clock are cells: taken, saved and taken back; a route out of the mine, in a wall or of the wrong shape is refused in words (#13466)" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..]; x := t[0].x[..]; k := [1] SptCell.[SptCell.{}]; body: [WE_BATCH_BODY] u8;
  empty := spw_empty(g, x[0].k[..], t[0].doc[..]);
  // Imperial 1 at dusk guards the tunnel mouth; the editor shows dusk
  b := spw_batch(g, x, empty, spt_cell(body[..], 0, "plans", 62, "do", "guard"), true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && sc_plan(g[0].c[..], 5, 2).act == NPD_GUARD;
  one := cast(string) k[0].two[0..<ct_copy(k[0].two[..], cast(string) t[0].next[0..<b.doc])];
  b = spw_batch(g, x, one, spt_cell(body[..], 1, "clock", 1, "when", "dusk"), true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && g[0].c[0].clock == 2;
  two := cast(string) k[0].after[0..<ct_copy(k[0].after[..], cast(string) t[0].next[0..<b.doc])];
  // the tables as saved read back with both
  text := cast(string) k[0].keep[0..<ct_copy(k[0].keep[..], spw_tables_text(x[0].ct[..]))];
  #assert sc_load(k[0].c[..], text) && k[0].c[0].clock == 2 && sc_plan(k[0].c[..], 5, 2).act == NPD_GUARD;
  // its inverse puts the realm's own clock back
  inv := cast(string) t[0].inv[0..<b.inv];
  b = spw_batch(g, x, two, inv, true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_OK && g[0].c[0].clock == -1;
  // the dome village has no foes: a route there is refused, and says where a route may go
  w := [1] SpwWork.[SpwWork.{}];
  b = spw_batch(g, w[..], empty, spt_cell(body[..], 0, "plans", 62, "route", "17720 -7060, 17720 -6000"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && spt_why(t[..], b) == "plan 62: a foe's route stays in the mine (x -16000 to 16000, z -43000 to 2000 centimetres) or an area added after it (ID 5 and up); the dome village, the gate corridor and the rail stop are stages of their own, with no foes in them" && !w[0].ct[0].changed;
  b = spw_batch(g, w[..], empty, spt_cell(body[..], 0, "plans", 62, "do", "stand"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && spt_why(t[..], b) == "plan 62: stand, dance, sleep and wander take one point, guard one or two (the post, then where it looks), patrol 2 to 8";
  b = spw_batch(g, w[..], empty, spt_cell(body[..], 0, "clock", 1, "when", "noon"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && !w[0].ct[0].changed;
  // a point in the mine where no one can stand: the route is refused, naming the plan
  wx := 0; wz := 0;
  for i: 0..<40 { for j: 0..<40 {
    if wx == 0 { px := -16000 + i * 800; pz := -43000 + j * 1125; q := sl_push(g, mp_m(px), mp_m(pz), 0.3, true);
      if abs(q.x - mp_m(px)) > 0.01 || abs(q.z - mp_m(pz)) > 0.01 { wx = px; wz = pz; } }
  } }
  #assert wx != 0;
  rt: [64] u8; n := ct_put_int(rt[..], 0, wx); n = ct_put(rt[..], n, " "); n = ct_put_int(rt[..], n, wz); n = ct_put(rt[..], n, ", 1010 -20080");
  b = spw_batch(g, w[..], empty, spt_cell(body[..], 0, "plans", 62, "route", cast(string) rt[0..<n]), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  why := spt_why(t[..], b);
  #assert b.status == SPB_REFUSED && !w[0].ct[0].changed && ct_parts(why, ' ') == 21 && ct_part(why, ' ', 0) == "plan" && ct_part(why, ' ', 1) == "62:";
  #assert ct_num(ct_part(why, ' ', 5)).v == wx && ct_num(ct_part(why, ' ', 6)).v == wz && ct_part(why, ' ', 3) == "route's" && ct_part(why, ' ', 12) == "nearest";
  // the nearest place it names is one a foe can stand: a route through it is taken
  nx := ct_num(ct_part(why, ' ', 19)).v; nz := ct_num(ct_part(why, ' ', 20)).v;
  n = ct_put_int(rt[..], 0, nx); n = ct_put(rt[..], n, " "); n = ct_put_int(rt[..], n, nz); n = ct_put(rt[..], n, ", 1010 -20080");
  b = spw_batch(g, w[..], empty, spt_cell(body[..], 0, "plans", 62, "route", cast(string) rt[0..<n]), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_OK;
}

#test "a page reads the world's own tables after its document, and a cell event changes them in place: the run goes on and the kind's new name is the one it has" #steps 4000000000 #traversal 2000000000 {
  x := [1] SptPage.[SptPage.{}]; g := x[0].g[..]; t := x[0].t[..]; p := x[0].p[..]; f := p[0].f[..];
  k := [1] SptCell.[SptCell.{}]; body: [WE_BATCH_BODY] u8; ans: [SPW_TABLES + 8] u8;
  empty := spw_empty(t[0].g[..], t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(t[0].g[..], t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  two := cast(string) k[0].two[0..<ct_copy(k[0].two[..], cast(string) t[0].next[0..<b.doc])];
  // the server's tables after one cell edit
  b = spw_batch(t[0].g[..], t[0].x[..], two, spt_cell(body[..], 2, "pieces", 117, "name", "Tiny crate"), true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  edited := cast(string) k[0].keep[0..<ct_copy(k[0].keep[..], spw_tables_text(t[0].x[0].ct[..]))];
  three := cast(string) k[0].after[0..<ct_copy(k[0].after[..], cast(string) t[0].third[0..<b.doc])];
  #assert b.status == SPB_OK && edited != SC_SHIPPED;
  // the page opens mid-run on the document at revision 3, then asks for the tables before any event
  g_reset(g); g_stage(g, 5); g[0].heat = 37; px := g[0].px;
  #assert spw_page_open(g, p, WL_DEV);
  f[0].tables = true;
  #assert spt_round(x[..], 0.016, spt_state(x[..], WL_DEV, 3, three)) == WFQ_DOC && f[0].rev == 3 && !f[0].tabled;
  n := ct_put(ans[..], 0, "200\n"); n = ct_put(ans[..], n, edited);
  #assert spt_round(x[..], 0.016, cast(string) ans[0..<n]) == WFQ_TABLES && f[0].tabled && p[0].tables_gen == 1;
  #assert sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], 117)) == "Tiny crate" && g[0].px == px && g[0].heat == 37 && g[0].layer[0].st[0].n == 2;
  // the same tables again change nothing; tables that are not this build's are not read
  #assert !spw_page_tables(g, p, edited) && !spw_page_tables(g, p, "aethyr.content.v1 other 1\nreach 100\n") && p[0].tables_gen == 1;
  // an outside cell edit arrives as event 4: the tables change in place
  out := spt_cell(body[..], 3, "pieces", 116, "name", "Big crate");
  #assert spt_round(x[..], 1.1, spt_events(x[..], out, 4)) == WFQ_EVENTS && f[0].rev == 4 && p[0].tables_gen == 2;
  #assert sc_piece_name(g[0].c[..], sc_piece(g[0].c[..], 116)) == "Big crate" && g[0].px == px && g[0].layer[0].head == 4;
  // and the shell is told the new names
  km := [1] SptShell.[SptShell.{}];
  #assert em_read(km[0].m[..], spw_model(g, p), km[0].scratch[..]) && em_kind_name(km[0].m[..], 116, km[0].name[..]) == "Big crate" && em_kind_name(km[0].m[..], 117, km[0].name[..]) == "Tiny crate";
  // a cell event the tables refuse sends the page back to the document
  bad := spt_cell(body[..], 4, "pieces", 116, "colour", "red");
  #assert spt_round(x[..], 1.1, spt_events(x[..], bad, 5)) == WFQ_EVENTS && f[0].rev == 4 && f[0].reopened == 1;
}

#test "Splice Bots' world: a script row is a cell edit, told to the shell with the kinds a script may drive; a row with no text takes it away, and a row that does not read is refused in words (#13467)" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; g := t[0].g[..]; x := t[0].x[..]; k := [1] SptCell.[SptCell.{}]; body: [WE_BATCH_BODY] u8; p := [1] SpwPage.[SpwPage.{}];
  empty := spw_empty(g, x[0].k[..], t[0].doc[..]);
  q := [1] SptShell.[SptShell.{}]; m := q[0].m[..];
  #assert em_read(m, spw_model(g, p[..]), q[0].scratch[..]) && m[0].ns == 0 && m[0].nsk == 2 && m[0].sk_id[0] == SPS_KIND_RAIDER && cast(string) m[0].stable[0..<m[0].stable_n] == "scripts";
  b := spw_batch(g, x, empty, spt_cell(body[..], 0, "scripts", 1, "*", "1|my-raider|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|kind 1"), true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && g[0].c[0].script_n == 1 && g[0].c[0].scripts[0].by_kind && sps_script(g, 0) == 0 && sps_script(g, FOES - 1) == -1;
  p[0].tables_gen += 1;
  #assert em_read(m, spw_model(g, p[..]), q[0].scratch[..]) && m[0].ns == 1 && m[0].s_id[0] == 1 && cast(string) m[0].s_name[0][0..<m[0].s_name_n[0]] == "my-raider" && cast(string) m[0].s_for[0][0..<m[0].s_for_n[0]] == "kind 1";
  one := cast(string) k[0].two[0..<ct_copy(k[0].two[..], cast(string) t[0].next[0..<b.doc])];
  // a hash that is not one is refused, naming the row
  b = spw_batch(g, x, one, spt_cell(body[..], 1, "scripts", 2, "*", "2|scout|528d|who 9"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && spt_why(t[..], b) == "script 2: a script's HASH is its module's SHA-256: 64 lowercase hex digits" && g[0].c[0].script_n == 1;
  // the row with no text: the script stops, and the foes walk their plans
  b = spw_batch(g, x, one, spt_cell(body[..], 1, "scripts", 1, "*", ""), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_OK && g[0].c[0].script_n == 0 && sps_script(g, 0) == -1;
}

#test "the planner's catalogue from the pieces table, several of a kind planned from the tapped point as one batch, and a template: saved as a row, told to the shell, placed and taken back as one step" #steps 4000000000 #traversal 2000000000 {
  x := [1] SptPage.[SptPage.{}]; g := x[0].g[..]; t := x[0].t[..]; p := x[0].p[..]; f := p[0].f[..];
  k := [1] SptCell.[SptCell.{}]; body: [WE_BATCH_BODY] u8; vw := [1] SptView.[SptView.{}]; e: [WE_BATCH] WorldEdit;
  empty := spw_empty(t[0].g[..], t[0].x[0].k[..], t[0].doc[..]);
  b := spw_batch(t[0].g[..], t[0].x[..], empty, SPT_TWO, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  two := cast(string) k[0].two[0..<ct_copy(k[0].two[..], cast(string) t[0].next[0..<b.doc])];
  g_reset(g);
  #assert spw_page_open(g, p, WL_DEV) && spt_round(x[..], 0.016, spt_state(x[..], WL_DEV, 2, two)) == WFQ_DOC;
  // the catalogue: a crate's footprint is its longer half side, a palm grows
  #assert spw_kind(g, 117).radius > 0.59 && spw_kind(g, 117).radius < 0.61 && !spw_kind(g, 117).natural && spw_kind(g, 113).natural && spw_kind(g, 999).radius == 0.5;
  // three small crates from a point by the second piece: one batch of three spawns, each on its own spot
  #assert !spw_plan_add(g, p, vw[0].w[..], PlaceView.{}, 117, 3);
  p[0].here = true; p[0].here_x = 700; p[0].here_z = 150;
  #assert spw_plan_add(g, p, vw[0].w[..], PlaceView.{}, 117, 3) && !spw_plan_add(g, p, vw[0].w[..], PlaceView.{}, 999, 3);
  sent := we_batch_read(cast(string) p[0].batch[0..<f[0].body_n], e[..]);
  #assert sent.ok && sent.rev == 2 && sent.n == 3 && e[0].op == WE_SPAWN && e[0].kind == 117 && e[2].kind == 117 && e[0].id == 0;
  #assert (e[0].x != e[1].x || e[0].z != e[1].z) && (e[1].x != e[2].x || e[1].z != e[2].z) && e[0].x > 300 && e[0].x < 1100 && e[0].z > -250 && e[0].z < 550;
  f[0].body_n = 0;
  // in the mine's yard, three planned beside a piece that stands there: the server takes the batch whole (none touches another)
  yard := "{\"schema\":\"world.edit.v1\",\"rev\":2,\"do\":\"apply\",\"edits\":[{\"op\":\"spawn\",\"id\":0,\"kind\":116,\"x\":17350,\"y\":0,\"z\":-7350,\"yaw\":0,\"scale\":100}]}";
  b = spw_batch(t[0].g[..], t[0].x[..], two, yard, true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  with := cast(string) k[0].after[0..<ct_copy(k[0].after[..], cast(string) t[0].third[0..<b.doc])];
  #assert b.status == SPB_OK && spt_round(x[..], 1.1, spt_events(x[..], yard, 3)) == WFQ_EVENTS && f[0].rev == 3 && g[0].layer[0].st[0].n == 3;
  p[0].here_x = 17500; p[0].here_z = -7450;
  #assert spw_plan_add(g, p, vw[0].w[..], PlaceView.{}, 117, 3);
  planned := cast(string) k[0].keep[0..<ct_copy(k[0].keep[..], cast(string) p[0].batch[0..<f[0].body_n])];
  b = spw_batch(t[0].g[..], t[0].x[..], with, planned, true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && b.edits == 3 && t[0].g[0].layer[0].st[0].n == 6;
  f[0].body_n = 0;
  // the two placed pieces saved as a template: a whole-row cell edit the tables take
  row := "1|Two crates|117 -75 -75 0 100,117 75 75 90 100";
  b = spw_batch(t[0].g[..], t[0].x[..], two, spt_cell(body[..], 2, "templates", 1, "*", row), true, t[0].third[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  three := cast(string) k[0].after[0..<ct_copy(k[0].after[..], cast(string) t[0].third[0..<b.doc])];
  tables := cast(string) k[0].keep[0..<ct_copy(k[0].keep[..], spw_tables_text(t[0].x[0].ct[..]))];
  #assert b.status == SPB_OK && t[0].x[0].ct[0].changed && tables.count > SC_SHIPPED.count;
  // a template whose part is no piece is refused by the tables' rules
  b = spw_batch(t[0].g[..], t[0].x[..], three, spt_cell(body[..], 3, "templates", 2, "*", "2|Bad|999 0 0 0 100"), true, t[0].next[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_REFUSED && spt_why(t[..], b) == "the tables' rules do not hold with that value";
  // the page reads the world's tables and tells the shell the template
  #assert spw_page_tables(g, p, tables);
  km := [1] SptShell.[SptShell.{}]; m := km[0].m[..];
  #assert em_read(m, spw_model(g, p), km[0].scratch[..]) && m[0].nt == 1 && m[0].t_id[0] == 1;
  tt := m[0].ttable; tn := m[0].t_name[0];
  #assert cast(string) tt[0..<m[0].ttable_n] == "templates" && cast(string) tn[0..<m[0].t_name_n[0]] == "Two crates";
  // placed in the mine's yard: one batch of two spawns, and one inverse that takes both back
  parts: [PL_PARTS] PlacePart; scratch: [PL_TEMPLATE] u8; tp := m[0].t_parts[0];
  n := pl_template_read(cast(string) tp[0..<m[0].t_parts_n[0]], parts[..], scratch[..]);
  #assert n == 2;
  for i: 0..<n { at := pl_template_at(parts[i], 17575, -7425, 0); e[i] = WorldEdit.{ok = true, op = WE_SPAWN, id = 0, kind = at.kind, x = at.x, z = at.z, yaw = at.yaw}; }
  place := we_batch_write(3, WB_APPLY, e[..], n, body[..]);
  b = spw_batch(t[0].g[..], t[0].x[..], three, place, true, t[0].next[..], t[0].did[..], t[0].inv[..], t[0].why[..]);
  #assert b.status == SPB_OK && b.edits == 2 && t[0].g[0].layer[0].st[0].n == 4 && t[0].g[0].layer[0].head == 5;
  placed := t[0].g[0].layer[0].items[3];
  #assert we_cm(placed.x) == 17650 && we_cm(placed.z) == -7350 && we_deg(placed.yaw) == 90 && placed.mesh == 117;
  four := cast(string) k[0].two[0..<ct_copy(k[0].two[..], cast(string) t[0].next[0..<b.doc])];
  undo := cast(string) t[0].inv[0..<b.inv];
  b = spw_batch(t[0].g[..], t[0].x[..], four, undo, false, t[0].third[..], t[0].did[..], t[0].back[..], t[0].why[..]);
  #assert b.status == SPB_OK && b.edits == 2 && t[0].g[0].layer[0].st[0].n == 2;
}
#test "a world's tables saved at an earlier revision of the shipped ones open at the shipped one, their rows kept; a later one does not open (#13505)" #steps 200000000 {
  g := [1] SpGame.[SpGame.{}]; ct := [1] SpwTables.[SpwTables.{}]; o: [1] [CT_BODY] u8; head: [64] u8;
  shipped: [1] SpContent; #assert sc_load(shipped[..], SC_SHIPPED) && shipped[0].rev > 2;
  n := ct_put(head[..], 0, "aethyr.content.v1 splice "); n = ct_put_int(head[..], n, shipped[0].rev); n = ct_put(head[..], n, "\n");
  older := sc_swap(cast(string) head[0..<n], "aethyr.content.v1 splice 2\n", o[0][..]);
  #assert older.count > 0 && spw_tables_open(g[..], ct[..], older) && g[0].c[0].rev == shipped[0].rev && spw_tables_text(ct[..]) == SC_SHIPPED;
  later: [1] [CT_BODY] u8; m := ct_put(later[0][..], 0, "aethyr.content.v1 splice "); m = ct_put_int(later[0][..], m, shipped[0].rev + 1); m = ct_put(later[0][..], m, "\n");
  newer := sc_swap(cast(string) head[0..<n], cast(string) later[0][0..<m], o[0][..]);
  r := shipped[0].rev; #assert newer.count > 0 && sc_rev_of(newer) == r + 1 && sc_upgrade_rev(newer, o[0][..]) == newer;   // Splice's tables, one revision on
  g2 := [1] SpGame.[SpGame.{}]; ct2 := [1] SpwTables.[SpwTables.{}];
  #assert !spw_tables_open(g2[..], ct2[..], newer);
}
