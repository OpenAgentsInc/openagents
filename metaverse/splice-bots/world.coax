// Splice as a world with an ID (GitHub #13412, the browser editor's E3;
// docs/editor/2026-11-12-browser-editor.md): its document, and its edits as the wire carries them.
//
// The world's ID is `splice`. Its document (metaverse-engine/editor/world-doc.coax, world.doc.v1) is
// the game's World saved whole: the designed world's colliders and every placed piece, with the
// shapes Splice keeps beside the World's columns, the content tables' revision the pieces name
// rows of, and the edit log's head. A placed piece is the entity whose kind is its content ID and
// whose row is its number in the layer.
//
// The document is always the one a fresh game builds from the layer's pieces (spw_build), so two
// hosts given the same edits hold the same bytes, and a document that is not what this build
// makes from its own pieces (a wall moved, a collider that is not its piece's) is refused
// (spw_open). The server and the page run this same file: the server carries a batch out with it
// (world-api.coax, through coax/web/api/worlds.c), so they cannot disagree about where a thing stands.
//
// An edit is checked as every Splice edit is (layer.coax sl_check: an area, the kept-clear zones,
// what stands there), and a batch is saved only when the run can still be walked (walk.coax).
// A refusal is in words, naming the zone or the place.
//   coax/bin/coax test metaverse/splice-bots/splice-game.coax
#load "../../metaverse-engine/editor/world-doc.coax";
#load "../../metaverse-engine/editor/world-live.coax";
#load "../../metaverse-engine/editor/world-follow.coax";
#load "../../metaverse-engine/editor/shell-model.coax";
#load "../../metaverse-engine/editor/viewport.coax";
#load "../../metaverse-engine/editor/world-alias.coax";   // the ID the world had before Splice Bots (#13486)

SPW_ID :: "splice-bots";
// Whether a document or an event names this world: by its ID, or by the ID it had before (world-alias.coax),
// which documents and events saved before the rename still carry.
spw_named :: (id: string) -> bool { was := world_was(SPW_ID); return id == SPW_ID || (was.count > 0 && id == was); }
spw_doc_named :: (d: WorldDoc) -> bool { w := d.world; return spw_named(cast(string) w[0..<d.world_n]); }
spw_event_named :: (v: WorldEvent) -> bool { w := v.world; return spw_named(cast(string) w[0..<v.world_n]); }
SPW_ENGINE :: 1;     // the document's reader: raised when world.doc.v1's reading here changes
SPW_RULES :: 1;      // Splice's edit rules (sl_check, the walk): raised when an edit a build took is one another refuses
SPW_WIRE :: 1;       // world.edit.v1
SPW_OWN :: 5;        // Splice's own columns: the shape's middle (x, z), its half sizes (x, z) as bits, and the shape
SPW_DOC :: 131072;   // bytes a document may take (wd_bytes(SL_CAP, SPW_OWN) and room to spare)

// The game's World, and room to read a document into without touching it.
SpwScratch :: struct { ws: [1] SlWorld; own: [SL_CAP * SPW_OWN] int; text: [SPW_DOC] u8; }

// The pins of this build's Splice: what a session carries (world-live.coax).
spw_pins :: (g: [] SpGame) -> WorldPins { return WorldPins.{engine = SPW_ENGINE, rules = SPW_RULES, content = g[0].c[0].rev, wire = SPW_WIRE}; }
spw_own :: (ws: [] SlWorld, own: [] int) {
  for s: 0..<SL_CAP {
    own[s * SPW_OWN] = cast(int) f32_bits(ws[0].ox[s]); own[s * SPW_OWN + 1] = cast(int) f32_bits(ws[0].oz[s]);
    own[s * SPW_OWN + 2] = cast(int) f32_bits(ws[0].ex[s]); own[s * SPW_OWN + 3] = cast(int) f32_bits(ws[0].ez[s]); own[s * SPW_OWN + 4] = ws[0].shape[s];
  }
}
// The designed world's colliders and the layer's pieces, built from nothing: the World every host
// builds from these pieces. The run's own state (where you stand, what you carry) is not touched.
spw_build :: (g: [] SpGame) { sl_build(g); }
// The game's World as its document at the layer's head, into out ("" when it does not fit).
// The same bytes on every host only after spw_build.
spw_save :: (g: [] SpGame, k: [] SpwScratch, out: [] u8) -> string {
  spw_own(g[0].ws[..], k[0].own[..]);
  return world_save(sl_world(g), SPW_ID, g[0].c[0].rev, g[0].layer[0].head, g[0].layer[0].st[0].next_id + 1, k[0].own[..], SPW_OWN, out);
}

SPW_OK :: 0;
SPW_NOT_DOC :: 1;     // not a world document, or not Splice's
SPW_CONTENT :: 2;     // made with another revision of the content tables
SPW_NOT_BUILT :: 3;   // not the World this build makes from the document's own pieces
SPW_FULL :: 4;        // more pieces than a layer holds
// The layer's pieces read from a document: the layer holds them under their numbers, with no
// history, at the document's head. The World is not built (spw_build, or sl_sync on a page that
// keeps its run). A document refused leaves the layer as it was.
spw_pieces :: (g: [] SpGame, k: [] SpwScratch, text: string) -> int {
  w := slw_world(k[0].ws[..]);
  if !world_init(w, SL_CELL) { return SPW_NOT_DOC; }
  d := world_load(w, text, k[0].own[..], SPW_OWN);
  if !d.ok || !spw_doc_named(d) { return SPW_NOT_DOC; }
  if d.content != g[0].c[0].rev { return SPW_CONTENT; }
  count := 0;
  for s: 0..<world_high(w) { if world_at(w, s) != ENTITY_NONE && world_i(w, WI_KIND, s) >= SK_PIECE { count += 1; } }
  if count > SL_ITEMS { return SPW_FULL; }
  // every piece has a number below the document's next, and no two share one
  for s: 0..<world_high(w) {
    if world_at(w, s) == ENTITY_NONE || world_i(w, WI_KIND, s) < SK_PIECE { continue; }
    row := world_i(w, WI_ROW, s);
    if row < 0 || row + 1 >= d.next { return SPW_NOT_DOC; }
    for o: 0..<s { if world_at(w, o) != ENTITY_NONE && world_i(w, WI_KIND, o) >= SK_PIECE && world_i(w, WI_ROW, o) == row { return SPW_NOT_DOC; } }
  }
  scene := sl_scene(g);
  editor_scene_reset(scene);
  for s: 0..<world_high(w) {
    if world_at(w, s) == ENTITY_NONE || world_i(w, WI_KIND, s) < SK_PIECE { continue; }
    item := EditorItem.{id = world_i(w, WI_ROW, s), mesh = world_i(w, WI_KIND, s), x = world_f(w, WF_X, s), y = world_f(w, WF_Y, s), z = world_f(w, WF_Z, s), yaw = world_f(w, WF_YAW, s)};
    _ := editor_scene_apply(scene, EditorItemOp.{kind = EDITOR_SCENE_PLACE, has = true, a = item});
  }
  g[0].layer[0].st[0].next_id = d.next - 1;
  g[0].layer[0].head = d.head;
  g[0].layer[0].rev += 1;
  return SPW_OK;
}
// A document opened on a game for the server: its pieces, the World built from them, and the
// bytes compared: SPW_NOT_BUILT for a document this build would not have written.
spw_open :: (g: [] SpGame, k: [] SpwScratch, text: string) -> int {
  v := spw_pieces(g, k, text);
  if v != SPW_OK { return v; }
  spw_build(g);
  saved := spw_save(g, k, k[0].text[..]);
  if saved != text && !spw_saved_as(saved, text) { return SPW_NOT_BUILT; }
  return SPW_OK;
}
// Whether saved is text with the world's old ID in its first line read as its ID: a document kept
// from before the rename (world-alias.coax, #13486) is the same world.
spw_saved_as :: (saved: string, text: string) -> bool {
  was := world_was(SPW_ID); head := "world.doc.v1 ";
  if was.count == 0 { return false; }
  a := head.count + SPW_ID.count + 1; b := head.count + was.count + 1;
  if saved.count < a || text.count < b || saved.count - a != text.count - b { return false; }
  if cast(string) saved[0..<head.count] != head || cast(string) text[0..<head.count] != head { return false; }
  if cast(string) saved[head.count..<a - 1] != SPW_ID || cast(string) text[head.count..<b - 1] != was || saved[a - 1] != '\n' || text[b - 1] != '\n' { return false; }
  return cast(string) saved[a..<saved.count] == cast(string) text[b..<text.count];
}
spw_open_why :: (v: int) -> string {
  if v == SPW_NOT_DOC { return "that is not Splice Bots' world document"; }
  if v == SPW_CONTENT { return "the document was made with another revision of Splice Bots' content tables"; }
  if v == SPW_NOT_BUILT { return "the document is not the world Splice Bots builds from its own pieces"; }
  if v == SPW_FULL { return "the document holds more pieces than Splice Bots keeps"; }
  return "";
}

// ---- an edit

SPE_SIZE :: 20;      // Splice's pieces keep their size
SPE_LAND :: 21;      // Splice has no land to shape
SPE_COLUMN :: 22;    // a placed piece has no such column to set
SPE_TABLES :: 23;    // the content tables change with a build
SPE_ID :: 24;        // a spawn asks for a number that is taken, or was never given
// What an edit did: the piece it made or changed (its number on the wire, 1 and up), the edit as
// it was taken (a spawn with its number filled in) and the edit that takes it back; or why not
// (`why`: an SL_ or SPE_ number; `v`: the layer's verdict when the check refused).
SpwEdit :: struct { ok: bool; id: int; did: WorldEdit; inv: WorldEdit; why: int; v: SlVerdict; }
spw_no :: (why: int) -> SpwEdit { return SpwEdit.{why = why, v = SlVerdict.{why = why}}; }
spw_from :: (e: WorldEdit, r: SlEdit, id: int, inv: WorldEdit) -> SpwEdit {
  if !r.ok { return SpwEdit.{why = r.v.why, v = r.v}; }
  return SpwEdit.{ok = true, id = id, did = e, inv = inv};
}
// One edit carried out on the layer, checked as every Splice edit is. `sure`: the edit was saved
// by the server already (a page following a revision): it is taken where it stands, and the
// check that would refuse it for where you stand is not asked.
spw_edit :: (g: [] SpGame, e: WorldEdit, sure: bool) -> SpwEdit {
  if !we_valid(e) { return spw_no(SL_NOTHING); }
  if e.op == WE_TERRAIN { return spw_no(SPE_LAND); }
  if e.op == WE_CELL { return spw_no(SPE_TABLES); }
  if e.op == WE_SCALE || (e.op == WE_SPAWN && e.scale != 100) { return spw_no(SPE_SIZE); }
  if sure {
    // the server's World took it: the layer's log takes it as it is
    a := we_scene_apply(sl_scene(g), e);
    if !a.ok { return spw_no(SL_NOTHING); }
    g[0].layer[0].rev += 1; sl_sync(g);
    did := e; did.id = a.id;
    return SpwEdit.{ok = true, id = a.id, did = did, inv = a.inv};
  }
  if e.op == WE_SPAWN {
    did := e;
    if e.id == 0 {
      r := sl_place(g, e.kind, e.x, e.z, e.yaw);
      if !r.ok { return spw_from(e, r, 0, e); }
      did.id = r.id + 1; did.y = we_cm(g[0].layer[0].items[sl_item(g, r.id)].y);
      return SpwEdit.{ok = true, id = r.id + 1, did = did, inv = WorldEdit.{ok = true, op = WE_DESPAWN, id = r.id + 1}};
    }
    // a piece under a number: one brought back (an undo of its removal: a number once given, now
    // free), or the very next number the world would give (a recorded batch taken again from the
    // start). Never a number further on, and never one that is taken
    if e.id > g[0].layer[0].st[0].next_id + 1 || sl_item(g, e.id - 1) >= 0 { return spw_no(SPE_ID); }
    if g[0].layer[0].st[0].n >= SL_ITEMS { return spw_no(SL_FULL); }
    v := sl_check(g, e.kind, sc_m(e.x), sc_m(e.z), sl_rad(e.yaw), -1);
    if v.why != SL_OK { return SpwEdit.{why = v.why, v = v}; }
    did.y = we_cm(ground_y(g, sc_m(e.x), sc_m(e.z)));
    a := we_scene_apply(sl_scene(g), did);
    if !a.ok { return spw_no(SPE_ID); }
    g[0].layer[0].rev += 1; sl_sync(g);
    return SpwEdit.{ok = true, id = e.id, did = did, inv = a.inv};
  }
  i := sl_item(g, e.id - 1);
  if i < 0 { return spw_no(SL_NO_ITEM); }
  was := g[0].layer[0].items[i];
  inv := WorldEdit.{ok = true, op = e.op, id = e.id};
  if e.op == WE_DESPAWN { return spw_from(e, sl_remove(g, e.id - 1), e.id, we_spawn_of(was)); }
  if e.op == WE_MOVE {
    inv.x = we_cm(was.x); inv.y = we_cm(was.y); inv.z = we_cm(was.z);
    r := sl_move(g, e.id - 1, e.x, e.z);
    did := e; if r.ok { did.y = we_cm(g[0].layer[0].items[sl_item(g, e.id - 1)].y); }
    return spw_from(did, r, e.id, inv);
  }
  if e.op == WE_ROTATE { inv.yaw = we_deg(was.yaw); return spw_from(e, sl_turn(g, e.id - 1, e.yaw), e.id, inv); }
  // a set of where it stands or how it is turned is a move or a turn; a piece has no other column an edit sets
  if e.op == WE_SET && (e.col == WEC_X || e.col == WEC_Z) {
    m := WorldEdit.{ok = true, op = WE_MOVE, id = e.id, x = ifx e.col == WEC_X then e.v else we_cm(was.x), z = ifx e.col == WEC_Z then e.v else we_cm(was.z)};
    if !we_valid(m) { return spw_no(SL_EDGE); }
    return spw_edit(g, m, false);
  }
  if e.op == WE_SET && e.col == WEC_YAW {
    if !we_turn_ok(e.v) { return spw_no(SL_TURN); }
    return spw_edit(g, WorldEdit.{ok = true, op = WE_ROTATE, id = e.id, yaw = e.v}, false);
  }
  return spw_no(SPE_COLUMN);
}
// A refusal in words, into out.
spw_why :: (g: [] SpGame, r: SpwEdit, out: [] u8) -> string {
  if r.why == SPE_SIZE { return "Splice Bots' pieces keep their size"; }
  if r.why == SPE_LAND { return "Splice Bots has no land to shape"; }
  if r.why == SPE_COLUMN { return "a placed piece can be moved and turned; it has nothing else to set"; }
  if r.why == SPE_TABLES { return "Splice Bots' content tables change with a build, not with an edit"; }
  if r.why == SPE_ID { return "that number is not free for a piece"; }
  if r.why == SPE_CELL { return "no such table, row or column, or a value that column does not take"; }
  if r.why == SPE_RULES { return "the tables' rules do not hold with that value"; }
  if r.why == SPE_NO_MESH { return "the world's pack has no mesh of that name: import it first"; }
  if r.why == SPE_PLAN { return "a foe's plan or the editor's clock does not hold"; }
  if r.why == SPE_FOOT { return "a pack mesh's footprint is its bounds: hx, hz and top are not this mesh's at that size"; }
  return sl_why(g, r.v, out);
}

// ---- the content tables, edited (GitHub #13419, the browser editor's E10)

SPW_KINDS :: "pieces";   // the table a placed piece's kind is a row of
SPW_PLANS :: "plans";   // the table the foes' plans are rows of (#13466)
SPW_CLOCK :: "clock";   // the table whose row 1 is the editor's time of day
SPW_SCRIPTS :: "scripts";   // the table the world's realm scripts are rows of (#13467)
SPW_TEMPLATES :: "templates";   // the table a saved group of pieces is a row of (place.coax pl_template_*)
SPW_TABLES :: 16384;   // bytes the content tables' document may take (the shipped one is about 4,000)
SPE_CELL :: 25;      // no such table, row or column, or a value the column does not take
SPE_RULES :: 26;     // the tables' rules do not hold with that value
SPE_NO_MESH :: 27;   // a row names a mesh the world's import pack does not have
SPE_FOOT :: 28;      // a row's footprint is not its pack mesh's bounds at the row's size
// A world's content tables as they are edited: the document on the edit log
// (metaverse-engine/editor/content-edit.coax), and its text as it was last opened or changed.
// The tables keep the revision they shipped with: an edit changes cells, never what a build reads.
SpwTables :: struct { d: [1] EditorDoc; text: [SPW_TABLES] u8; text_n: int; open: bool; changed: bool; why: [240] u8; why_n: int; }
SPE_PLAN :: 29;      // a foe's plan or the clock does not hold: the words are the tables' (SpwTables.why)
// Opens the tables from text ("": the ones the build shipped with) into the edit log and the game.
// False, and nothing changed, for anything but Splice's content at this build's revision (tables
// saved at an earlier one are lifted to it: sc_upgrade_rev, #13505).
spw_tables_open :: (g: [] SpGame, ct: [] SpwTables, text: string) -> bool {
  up: [SPW_TABLES] u8; up2: [SPW_TABLES] u8;
  // tables saved before the plans and the clock, or before the front door's menu, credits and dolly, get the shipped ones
  up3: [SPW_TABLES] u8;   // and tables saved when the map reached less far reach as far as the shipped ones
  up4: [SPW_TABLES] u8;   // and tables saved at an earlier revision are at the shipped one
  from := sc_upgrade_rev(sc_upgrade_reach(sc_upgrade_front(sc_upgrade(ifx text.count == 0 then SC_SHIPPED else text, up[..]), up2[..]), up3[..]), up4[..]);
  read: [1] SpContent; shipped: [1] SpContent;
  if from.count > SPW_TABLES || !sc_load(read[..], from) || !sc_load(shipped[..], SC_SHIPPED) || read[0].rev != shipped[0].rev { return false; }
  if !editor_content_open(ct[0].d[..], from) { return false; }
  g[0].c[0] = read[0];
  ct[0].text_n = ct_copy(ct[0].text[..], from); ct[0].open = true; ct[0].changed = false;
  return g_places(g);
}
spw_tables_text :: (ct: [] SpwTables) -> string { return cast(string) ct[0].text[0..<ct[0].text_n]; }
// A row that draws a pack mesh, against the world's import pack: the pack has the mesh, and the
// row's footprint and height are the mesh's bounds at the row's size, in centimetres that cover
// them ("no invisible blockers": a collider is what you see). SL_OK for a row that holds, for a
// kit piece's row and for no row (one an edit dropped); else what does not hold.
spw_mesh_held :: (g: [] SpGame, c: [] SpContent, id: int) -> int {
  r := sc_piece(c, id);
  if r < 0 || c[0].pieces[r].kit != PK_MESH { return SL_OK; }
  p := c[0].pieces[r];
  k := sp_import(g[0].imp[..], sc_piece_mesh(c, r));
  if k < 0 { return SPE_NO_MESH; }
  m := g[0].imp[0].m[k]; scale := cast(int) floor(p.scale * 1000 + 0.5);
  if we_cm(p.hx) != sp_import_cm(m.hx, scale) || we_cm(p.hz) != sp_import_cm(m.hz, scale) || we_cm(p.top) != sp_import_cm(m.top, scale) { return SPE_FOOT; }
  return SL_OK;
}
// One cell edit carried out on the tables, checked as a content document is: the cell is one its
// column takes, the tables' rules hold, the game reads them, and every placed piece still stands
// where the layer's check lets it. Refused, nothing is changed. The World is built again from the
// new tables (a piece's size is its kind's).
spw_cell :: (g: [] SpGame, ct: [] SpwTables, e: WorldEdit) -> SpwEdit {
  if !we_valid(e) || e.op != WE_CELL { return spw_no(SL_NOTHING); }
  if !ct[0].open && !spw_tables_open(g, ct, "") { return spw_no(SPE_RULES); }   // tables nobody has edited yet: the shipped ones
  a := we_content_apply(ct[0].d[..], e);
  if !a.ok { return spw_no(SPE_CELL); }
  out: [SPW_TABLES] u8; read: [1] SpContent;
  made := editor_content_text(ct[0].d[..], g[0].c[0].rev, out[..]);
  if made.count == 0 || !sc_load(read[..], made) {
    _ := we_content_apply(ct[0].d[..], a.inv);
    // a plan's refusal says which plan and why, in the tables' own words (content.coax sc_plans_words)
    ct[0].why_n = sc_plans_words(made, ct[0].why[..]).count;
    return spw_no(ifx ct[0].why_n > 0 then SPE_PLAN else SPE_RULES);
  }
  // and no point of a foe's route stands inside a wall
  wall := spw_plan_wall(g, read[..]);
  if wall.id > 0 {
    _ := we_content_apply(ct[0].d[..], a.inv);
    // the words name the point and the nearest place a foe can stand, so the next try can be right
    w := ct[0].why[..];
    n := ct_put(w, 0, "plan "); n = ct_put_int(w, n, wall.id); n = ct_put(w, n, ": the route's point "); n = ct_put_int(w, n, wall.x); n = ct_put(w, n, " "); n = ct_put_int(w, n, wall.z);
    n = ct_put(w, n, " stands inside a wall; the nearest place a foe can stand is "); n = ct_put_int(w, n, wall.near_x); n = ct_put(w, n, " "); n = ct_put_int(w, n, wall.near_z);
    ct[0].why_n = ifx n > ct[0].why.count then 0 else n;
    return spw_no(SPE_PLAN);
  }
  edited := e; kinds := cast(string) edited.table[0..<edited.table_n] == SPW_KINDS;
  if g[0].imp[0].checked && kinds {
    held := spw_mesh_held(g, read[..], e.id);   // the row this edit wrote
    if held != SL_OK { _ := we_content_apply(ct[0].d[..], a.inv); return spw_no(held); }
  }
  keep := g[0].c[0];
  g[0].c[0] = read[0];
  placed := g_places(g);
  sl_sync(g);
  v := sl_all_ok(g);
  if !placed || v.why != SL_OK {
    g[0].c[0] = keep; _ := g_places(g); sl_sync(g);
    _ := we_content_apply(ct[0].d[..], a.inv);
    return ifx placed then SpwEdit.{why = v.why, v = v} else spw_no(SPE_RULES);
  }
  ct[0].text_n = ct_copy(ct[0].text[..], made); ct[0].changed = true;
  g[0].layer[0].rev += 1;
  return SpwEdit.{ok = true, id = e.id, did = e, inv = a.inv};
}
// The first plan with a point of its route inside a wall (a collider of the designed world or a
// placed piece): its ID (0: none), the point and the nearest place a foe can stand, centimetres. A
// wander's area may hold walls: its middle is held, not its edge.
SpwWall :: struct { id: int; x: int; z: int; near_x: int; near_z: int; }
spw_plan_wall :: (g: [] SpGame, c: [] SpContent) -> SpwWall {
  for k: 0..<SC_PLAN_MAX {
    p := c[0].plans[k];
    for i: 0..<p.n {
      x := mp_m(p.x[i]); z := mp_m(p.z[i]); q := sl_push(g, x, z, 0.3, true);
      if abs(q.x - x) > 0.01 || abs(q.z - z) > 0.01 {
        near := spw_stand_near(g, c, x, z);
        return SpwWall.{id = npl_id(p.who, p.when), x = p.x[i], z = p.z[i], near_x = we_cm(near.x), near_z = we_cm(near.z)};
      }
    }
  }
  return SpwWall.{};
}
// The nearest place to (x, z) a foe can stand on the ground foes walk (the mine and the areas added
// after it, content.coax sc_foe_ground): rings half a metre apart, 16 points each, out to 12 metres;
// the mine's middle when none holds.
SpwAt :: struct { x: f32; z: f32; }
spw_foe_ground :: (c: [] SpContent, x: f32, z: f32) -> bool {
  for a: 0..<c[0].area_n {
    m := c[0].areas[a];
    if m.id < SC_FOE_AREA { continue; }
    if m.r > 0 { if dist2(x, z, m.x, m.z) <= m.r - 0.5 { return true; } }
    else if x >= m.x - m.hx + 0.5 && x <= m.x + m.hx - 0.5 && z >= m.z - m.hz + 0.5 && z <= m.z + m.hz - 0.5 { return true; }
  }
  return false;
}
spw_stand_near :: (g: [] SpGame, c: [] SpContent, x: f32, z: f32) -> SpwAt {
  lo_x: f32 = -44; hi_x: f32 = 44; lo_z: f32 = -82; hi_z: f32 = 20;
  for a: 0..<c[0].area_n { m := c[0].areas[a]; if m.id == SC_FOE_AREA { lo_x = m.x - m.hx + 0.5; hi_x = m.x + m.hx - 0.5; lo_z = m.z - m.hz + 0.5; hi_z = m.z + m.hz - 0.5; } }
  for ring: 1..<25 {
    d := cast(f32) ring * 0.5;
    for k: 0..<16 {
      t := cast(f32) k * 0.3926991;
      px := x + d * cos(t); pz := z + d * sin(t);
      if spw_foe_ground(c, px, pz) {
        q := sl_push(g, px, pz, 0.3, true);
        if abs(q.x - px) < 0.005 && abs(q.z - pz) < 0.005 { return SpwAt.{x = px, z = pz}; }
      }
    }
  }
  return SpwAt.{x = (lo_x + hi_x) / 2, z = (lo_z + hi_z) / 2};
}

// An edit of either kind: a cell on the tables, anything else on the layer.
spw_take :: (g: [] SpGame, ct: [] SpwTables, e: WorldEdit, sure: bool) -> SpwEdit {
  if e.op == WE_CELL { return spw_cell(g, ct, e); }
  return spw_edit(g, e, sure);
}

// ---- a batch, as the server saves it

SPB_OK :: 0;
SPB_DOC :: 1;        // the document did not open (spw_open)
SPB_BATCH :: 2;      // the body is not a batch
SPB_STALE :: 3;      // made from another revision than the document's head
SPB_REFUSED :: 4;    // an edit was refused: which, and why in words
SPB_WALK :: 5;       // every edit stood, but the run can no longer be walked
SPB_NOTHING :: 6;    // nothing to do
SPB_ROOM :: 7;       // an answer did not fit
// What a batch did. doc, did, inv: how many bytes of each out buffer hold the new document, the
// batch as it was taken (every spawn numbered; an ORIGINAL as its removals) and the batch that
// takes it back (the inverses, last first). edits: how many edits were taken. at: the edit refused.
SpwBatch :: struct { status: int; doc: int; did: int; inv: int; why: int; edits: int; at: int = -1; }
// ct: the world's content tables: the caller puts their text in (none: the shipped ones) and reads it back when a batch changed them.
SpwWork :: struct { e: [WE_BATCH] WorldEdit; did: [WE_BATCH] WorldEdit; inv: [WE_BATCH] WorldEdit; k: [1] SpwScratch; w: [1] SwWalker; ct: [1] SpwTables; }
// Carries a batch out on the document `doc`, on a game of its own (g is reset; the caller keeps
// nothing in it). `fenced`: the batch must name the document's head (a page's or an agent's
// edits); without it the revision is not asked (a stored step taken again by an undo or a redo,
// which the caller has fenced already). Nothing is half done: a batch refused changes no answer.
spw_batch :: (g: [] SpGame, x: [] SpwWork, doc: string, body: string, fenced: bool, out_doc: [] u8, out_did: [] u8, out_inv: [] u8, out_why: [] u8) -> SpwBatch {
  b := SpwBatch.{};
  g_reset(g);
  // the world's own tables when the caller gave them; without, the game's (the shipped ones)
  if x[0].ct[0].text_n > 0 && !spw_tables_open(g, x[0].ct[..], spw_tables_text(x[0].ct[..])) {
    b.status = SPB_DOC; b.why = ct_put(out_why, 0, "the world's content tables are not ones this build reads");
    return b;
  }
  g[0].px = g[0].at.bay_x; g[0].pz = g[0].at.bay_z;   // nobody stands in the server's world
  opened := spw_open(g, x[0].k[..], doc);
  if opened != SPW_OK {
    b.status = SPB_DOC; b.why = ct_put(out_why, 0, spw_open_why(opened));
    return b;
  }
  head := g[0].layer[0].head;
  batch := we_batch_read(body, x[0].e[..]);
  if !batch.ok || batch.what == WB_UNDO || batch.what == WB_REDO { b.status = SPB_BATCH; return b; }
  if fenced && batch.rev != head { b.status = SPB_STALE; return b; }
  n := batch.n;
  if batch.what == WB_ORIGINAL {
    // the designed world again: every placed piece removed, the newest first
    n = g[0].layer[0].st[0].n;
    if n > WE_BATCH { n = WE_BATCH; }
    for i: 0..<n { x[0].e[i] = WorldEdit.{ok = true, op = WE_DESPAWN, id = g[0].layer[0].items[g[0].layer[0].st[0].n - 1 - i].id + 1}; }
  }
  if n == 0 { b.status = SPB_NOTHING; b.why = ct_put(out_why, 0, "nothing to change"); return b; }
  for i: 0..<n {
    r := spw_take(g, x[0].ct[..], x[0].e[i], false);
    if !r.ok {
      b.status = SPB_REFUSED; b.at = i;
      wb: [200] u8;
      b.why = ct_put(out_why, 0, ifx r.why == SPE_PLAN then cast(string) x[0].ct[0].why[0..<x[0].ct[0].why_n] else spw_why(g, r, wb[..]));
      return b;
    }
    x[0].did[i] = r.did; x[0].inv[n - 1 - i] = r.inv;
  }
  // the second check: the run's whole way on foot against the layer as it would be saved
  if g[0].layer[0].st[0].n > 0 || x[0].ct[0].changed {
    keep := g[0].layer[0];
    walk := sw_replay(g, x[0].w[..]);
    if walk.why != SW_OK {
      b.status = SPB_WALK;
      wb: [200] u8; b.why = ct_put(out_why, 0, sw_why(g, walk, wb[..]));
      return b;
    }
    g_reset(g); g[0].layer[0] = keep;
  }
  g[0].layer[0].head = head + n;
  spw_build(g);
  made := spw_save(g, x[0].k[..], out_doc);
  did := we_batch_write(head, WB_APPLY, x[0].did[..], n, out_did);
  inv := we_batch_write(head + n, WB_APPLY, x[0].inv[..], n, out_inv);
  if made.count == 0 || did.count == 0 || inv.count == 0 || b.why > out_why.count { b.status = SPB_ROOM; return b; }
  b.doc = made.count; b.did = did.count; b.inv = inv.count; b.edits = n;
  return b;
}
// The pieces a world holds before its first edit (#13505): the solar farm where a run starts (its
// panels, chargers and mesas, Sniper's rover train, a raider mech out in the desert and two at the
// garage's mouth) and the rover's room (its windows, the loft bunk, the desk, the workbench arm and
// the sofa). One row a piece: its kind (content ID), where it stands in centimetres, its turn in degrees.
SPW_SHIPPED_N :: 33;
SPW_SHIPPED :: [SPW_SHIPPED_N * 4] int.[
  120, 1800, 33600, 0,
  120, 1800, 34100, 0,
  120, 1800, 34600, 0,
  120, 1800, 35100, 0,
  120, 3300, 33600, 0,
  120, 3300, 34100, 0,
  120, 3300, 34600, 0,
  120, 3300, 35100, 0,
  121, 2000, 36000, 180,
  121, 2400, 36000, 180,
  121, 2800, 36000, 180,
  121, 3200, 36000, 180,
  123, 300, 34800, 0,
  122, -5000, 39000, 20,
  122, 4800, 39200, -30,
  122, -5200, 33500, 60,
  122, 1500, 39300, 10,
  108, -3500, 38300, 150,
  108, -1100, 600, 90,
  108, 1100, 600, -90,
  127, -10310, 26330, 0,
  127, -10000, 26330, 0,
  127, -9690, 26330, 0,
  127, -10310, 25670, 0,
  127, -9690, 25670, 0,
  127, -10430, 25845, 90,
  127, -9570, 25845, 90,
  127, -10430, 26155, 90,
  127, -9570, 26155, 90,
  124, -10250, 25850, 0,
  125, -9730, 25860, 180,
  126, -9760, 26160, -90,
  128, -10250, 26170, 90];
// The shipped pieces placed into the layer, each through the layer's check: how many stand, or minus
// the row the check refused, less one.
spw_shipped :: (g: [] SpGame) -> int {
  for i: 0..<SPW_SHIPPED_N {
    o := i * 4;
    if !sl_place(g, SPW_SHIPPED[o], SPW_SHIPPED[o + 1], SPW_SHIPPED[o + 2], SPW_SHIPPED[o + 3]).ok { return -i - 1; }
  }
  return SPW_SHIPPED_N;
}
// The document of Splice with nothing placed, at head 0.
spw_empty :: (g: [] SpGame, k: [] SpwScratch, out: [] u8) -> string {
  g_reset(g);
  editor_scene_reset(sl_scene(g)); g[0].layer[0].head = 0; g[0].layer[0].rev += 1;
  spw_build(g);
  return spw_save(g, k, out);
}
// What a world is before its first edit, at head 0: the shipped pieces (spw_shipped) and nothing else,
// so a new world starts a run at the solar farm with no step to apply ("": one would not stand).
spw_fresh :: (g: [] SpGame, k: [] SpwScratch, out: [] u8) -> string {
  g_reset(g);
  editor_scene_reset(sl_scene(g)); g[0].layer[0].rev += 1;
  if spw_shipped(g) != SPW_SHIPPED_N { return ""; }
  g[0].layer[0].head = 0;
  spw_build(g);
  return spw_save(g, k, out);
}

// ---- a page that follows the world (GitHub #13413, the browser editor's E4)

SPW_INBOX :: 131072;   // bytes one answer may be: the page's inbox (splice-face.c)
// What a page keeps to follow the world: its place (world-follow.coax) and room to read an answer.
SpwPage :: struct {
  f: [1] WorldFollow; k: [1] SpwScratch; doc: [SPW_DOC] u8; did: [64] u8; scratch: [SPW_INBOX] u8; loads: int;
  batch: [WE_BATCH_BODY] u8;   // the follower's room for a batch on its way (world-follow.coax wf_post)
  // what the editor shell is told (shell-model.coax, GitHub #13416): the selected piece's number on the
  // wire (0: none), the revision this page's last write made, and the model with what it was made from
  ct: [1] SpwTables;   // the world's content tables as this page has them (the shipped ones until the world's are read)
  tables_gen: int;     // counts the changes to them the page must draw: a read of other tables, or a cell event
  sel: int; own_rev: int = -1;
  here: bool; here_x: int; here_z: int;   // the last point tapped on the ground (viewport.coax), centimetres
  actor: int;   // the selected foe (1 to FOES; 0: none): the page draws its route and notice range (#13466)
  model: [EM_BYTES] u8; model_n: int; model_rev: int; model_key: [12] int;
}
// The page opens the world on a lane: dev for someone who edits, live for someone who plays.
spw_page_open :: (g: [] SpGame, p: [] SpwPage, lane: int) -> bool { return wf_open(p[0].f[..], SPW_ID, lane, spw_pins(g)); }
// The lane's document, answered: its pieces become the layer's, and the run goes on as it was
// (where you stand, what you carry, the stage). True when the page now stands at its revision.
spw_page_doc :: (g: [] SpGame, p: [] SpwPage, a: WfAnswer) -> bool {
  f := p[0].f[..];
  if a.status != 200 { wf_not_loaded(f, a.status); return false; }
  v := we_state_read(a.body, p[0].doc[..], p[0].did[..], p[0].scratch[..]);
  if !v.ok || v.doc_n == 0 || spw_pieces(g, p[0].k[..], cast(string) p[0].doc[0..<v.doc_n]) != SPW_OK { wf_not_loaded(f, 0); return false; }
  g[0].layer[0].rise_n = 0;
  sl_sync(g);
  wf_loaded(f, v); p[0].loads += 1;
  return true;
}
// The lane's events, answered: each is carried out in order through the layer's edit log, so UNDO
// works on it as on the page's own. A piece an event places rises in. An event out of order, or
// one the layer can't take, sends the page back to the document. How many were carried out.
spw_page_events :: (g: [] SpGame, p: [] SpwPage, a: WfAnswer) -> int {
  f := p[0].f[..]; took := 0;
  if a.status != 200 { return 0; }
  for k: 0..<ct_parts(a.body, '\n') {
    line := wf_line(a.body, k);
    if line.count == 0 { continue; }
    kind := we_event_kind(line);
    if kind == 1 && f[0].lane == WL_DEV {
      v := we_event_read(line);
      if v.ok && v.rev <= f[0].rev { continue; }   // one the page has taken already
      if !we_take(f[0].rev, v) || !spw_event_named(v) { wf_reopen(f); break; }
      r := spw_take(g, p[0].ct[..], v.edit, true);
      if !r.ok { wf_reopen(f); break; }
      if v.edit.op == WE_CELL { p[0].tables_gen += 1; }
      if v.edit.op == WE_SPAWN { sl_rise(g, r.id - 1); }
      wf_took(f); g[0].layer[0].head = f[0].rev; took += 1;
    } else if kind == 2 && f[0].lane == WL_LIVE {
      v := we_published_read(line);
      if v.ok && v.rev <= f[0].rev { continue; }
      if !v.ok || v.rev != f[0].rev + 1 { wf_reopen(f); break; }
      // a publish reaches this session now only when it said so and this build reads it (world-live.coax);
      // otherwise the page keeps what it joined until its next session
      wf_took(f);
      if wl_follow(v.when, f[0].pins, WorldPins.{engine = v.engine, rules = v.rules, content = v.content, wire = v.wire}) { wf_reopen(f); break; }
    } else { wf_reopen(f); break; }
  }
  return took;
}
// The lane's content tables, answered: when they are not the ones the page has, the page reads
// them and its World is built from them where it stands (a piece's size is its kind's). True when
// they changed. Tables this build does not read leave the page with the ones it has.
spw_page_tables :: (g: [] SpGame, p: [] SpwPage, text: string) -> bool {
  have := ifx p[0].ct[0].open then spw_tables_text(p[0].ct[..]) else SC_SHIPPED;
  if text == have || !spw_tables_open(g, p[0].ct[..], text) { return false; }
  sl_sync(g); g[0].layer[0].rev += 1; p[0].tables_gen += 1;
  return true;
}
// An answer from the host for request `host_id`: the document, events or a write's answer, each
// carried out. What it answered (WFQ_NONE: not the world's).
spw_page_answer :: (g: [] SpGame, p: [] SpwPage, host_id: int, text: string) -> int {
  a := wf_answer(p[0].f[..], host_id, text);
  if a.what == WFQ_DOC { ok := spw_page_doc(g, p, a); }
  if a.what == WFQ_EVENTS { n := spw_page_events(g, p, a); }
  if a.what == WFQ_TABLES {
    if a.status == 200 { _ := spw_page_tables(g, p, a.body); }
    wf_tabled(p[0].f[..]);
  }
  if a.what == WFQ_POST {
    wf_posted(p[0].f[..], a);
    // a write that stood says what can now be undone and redone (it carries no document: its batch goes where one would)
    if a.status == 200 {
      v := we_state_read(a.body, p[0].did[..], p[0].doc[..], p[0].scratch[..]);
      if v.ok { p[0].f[0].undo = v.undo; p[0].f[0].redo = v.redo; p[0].own_rev = v.rev; }
    }
  }
  return a.what;
}

// ---- what the editor shell is told (GitHub #13416, the browser editor's E7)

// The shell selects a piece by its number on the wire; 0, or a number no piece has, selects nothing.
spw_select :: (g: [] SpGame, p: [] SpwPage, id: int) { p[0].sel = ifx id > 0 && sl_item(g, id - 1) >= 0 then id else 0; }
// The page's model for the shell, made again only when what it is made from changed: the layer,
// the page's place in the world, the selection or the last refusal. model_rev counts the makings.
// A piece can be moved and turned (spw_edit), so those are the columns an edit may set.
spw_model :: (g: [] SpGame, p: [] SpwPage) -> string {
  f := p[0].f[..]; l := g[0].layer[..]; c := g[0].c[..];
  if p[0].sel > 0 && sl_item(g, p[0].sel - 1) < 0 { p[0].sel = 0; }
  // edits from elsewhere may have changed what can be undone: the buttons stay open and the server answers
  if f[0].lane == WL_DEV && f[0].rev > p[0].own_rev && p[0].own_rev >= 0 {
    if f[0].undo < 1 { f[0].undo = 1; } if f[0].redo < 1 { f[0].redo = 1; }
    p[0].own_rev = f[0].rev;
  }
  key: [12] int;
  key[10] = p[0].tables_gen * 16 + p[0].actor; key[11] = c[0].clock;
  key[8] = ifx p[0].here then p[0].here_x else -1; key[9] = ifx p[0].here then p[0].here_z else -1;
  key[0] = l[0].rev; key[1] = f[0].rev; key[2] = f[0].undo; key[3] = f[0].redo; key[4] = p[0].sel;
  key[5] = f[0].refused_n * 1000 + f[0].refused_status; key[6] = f[0].status; key[7] = f[0].sent;
  same := p[0].model_n > 0;
  for k: 0..<7 { if key[k] != p[0].model_key[k] { same = false; } }
  for k: 8..<12 { if key[k] != p[0].model_key[k] { same = false; } }
  // (a refusal in the same words as the last is a new one when a request went between them)
  if key[7] != p[0].model_key[7] && f[0].refused_n > 0 { same = false; }
  if same { return cast(string) p[0].model[0..<p[0].model_n]; }
  p[0].model_key = key;
  out := p[0].model[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true; cols[WEC_Z] = true; cols[WEC_YAW] = true;
  n := em_begin(out, SPW_ID, f[0].lane, ifx f[0].rev < 0 then 0 else f[0].rev, f[0].undo, f[0].redo, p[0].sel);
  n = em_cols(out, n, cols[..]);
  n = em_table(out, n, SPW_KINDS);
  n = em_templates(out, n, SPW_TEMPLATES);
  for r: 0..<c[0].piece_n { n = em_kind(out, n, c[0].pieces[r].id, sc_piece_name(c, r)); }
  for i: 0..<l[0].st[0].n {
    item := l[0].items[i];
    n = em_entity(out, n, item.id + 1, item.mesh, we_cm(item.x), we_cm(item.y), we_cm(item.z), we_deg(item.yaw), 100);
  }
  // each kind's row of the pieces table, cell by cell as the tables hold it: the shell edits them (a cell edit, spw_cell)
  tables := ifx p[0].ct[0].open then spw_tables_text(p[0].ct[..]) else SC_SHIPPED;
  head := ""; inside := false; saved := false;
  for k: 0..<ct_parts(tables, '\n') {
    line := ct_part(tables, '\n', k);
    if ct_part(line, ' ', 0) == "table" { inside = ct_part(line, ' ', 1) == SPW_KINDS; saved = ct_part(line, ' ', 1) == SPW_TEMPLATES; head = line; continue; }
    row := ct_num(ct_part(line, '|', 0));
    // a saved group: its row is ID|NAME|PARTS
    if saved && row.ok && ct_parts(line, '|') == 3 { n = em_template(out, n, row.v, ct_part(line, '|', 1), ct_part(line, '|', 2)); }
    if !inside || !row.ok { continue; }
    // the header is "table NAME id COL:KIND ...": column c of a row is its word c + 2
    for ci: 1..<ct_parts(line, '|') {
      col := ct_part(ct_part(head, ' ', ci + 2), ':', 0); val := ct_part(line, '|', ci);
      if col.count > 0 && val.count > 0 { n = em_cell(out, n, row.v, col, val); }
    }
  }
  n = spw_model_plans(g, p, tables, out, n);
  n = spw_model_scripts(g, out, n);
  if p[0].here { n = em_here(out, n, p[0].here_x, p[0].here_z); }
  if f[0].refused_n > 0 { n = em_no(out, n, wf_refused(f)); }
  p[0].model_n = ifx n > out.count then 0 else n;
  p[0].model_rev += 1;
  return cast(string) p[0].model[0..<p[0].model_n];
}
// The foes' plans for the shell (#13466): the plans and clock tables, the clock, each foe by its name in the actors table, each
// plan as its row holds it, and the selected foe.
spw_model_plans :: (g: [] SpGame, p: [] SpwPage, tables: string, out: [] u8, at: int) -> int {
  c := g[0].c[..]; words := SC_CLOCK_WORD;
  n := em_plans(out, at, SPW_PLANS);
  n = em_clock(out, n, SPW_CLOCK, words[c[0].clock + 1]);
  for i: 0..<FOES { n = em_actor(out, n, i + 1, cast(string) c[0].actor[i][0..<c[0].actor_n[i]]); }
  inside := false;
  for k: 0..<ct_parts(tables, '\n') {
    line := ct_part(tables, '\n', k);
    if ct_part(line, ' ', 0) == "table" { inside = ct_part(line, ' ', 1) == SPW_PLANS; continue; }
    if !inside || ct_parts(line, '|') != 8 { continue; }
    // id|who|when|do|route|speed|notice|on
    n = em_plan(out, n, ct_num(ct_part(line, '|', 1)).v, ct_part(line, '|', 2), ct_part(line, '|', 3), ct_num(ct_part(line, '|', 5)).v, ct_num(ct_part(line, '|', 6)).v, ct_part(line, '|', 7), ct_part(line, '|', 4));
  }
  if p[0].actor > 0 { n = em_asel(out, n, p[0].actor); }
  return n;
}
// The world's realm scripts for the shell (#13467): the scripts table, the two kinds a script may drive, as a
// person reads them, and each row as the tables hold it.
spw_model_scripts :: (g: [] SpGame, out: [] u8, at: int) -> int {
  c := g[0].c[..]; target: [12] u8;
  n := em_scripts(out, at, SPW_SCRIPTS);
  n = em_script_kind(out, n, SPS_KIND_RAIDER, "Raiders");
  n = em_script_kind(out, n, SPS_KIND_IMPERIAL, "Imperial robots");
  for r: 0..<c[0].script_n {
    row := c[0].scripts[r];
    if !row.ok { continue; }
    k := ct_put(target[..], 0, ifx row.by_kind then "kind " else "who "); k = ct_put_int(target[..], k, row.n);
    n = em_script(out, n, row.slot + 1, cast(string) row.name[0..<row.name_n], cast(string) row.hash[..], cast(string) target[0..<k]);
  }
  return n;
}
// The shell selects a foe by its number (1 to FOES; 0 or any other: none). The game draws its route
// and notice range, and a foe stands in the mine: a page elsewhere goes there.
spw_actor :: (g: [] SpGame, p: [] SpwPage, id: int) {
  p[0].actor = ifx id >= 1 && id <= FOES then id else 0;
  g[0].shown = p[0].actor - 1;
  if p[0].actor > 0 && g[0].zone != Z_MINE { g_enter_mine(g); }
}
// The view of foe i: the player stands ten metres off the middle of its route at this time of day,
// where one can stand, facing it, and the fly camera looks down at the route from above that place,
// so the foe, its route and its notice ring are in the frame.
spv_frame_foe :: (g: [] SpGame, vp: [] Viewport, seen: VpView, i: int) {
  pl := sc_plan(g[0].c[..], i, g_phase(g));
  x := g[0].fx[i]; z := g[0].fz[i]; n := 1;
  for k: 0..<pl.n { x += mp_m(pl.x[k]); z += mp_m(pl.z[k]); n += 1; }
  x = x / cast(f32) n; z = z / cast(f32) n;
  at := sl_push(g, x, z + 10, 0.4, true);
  g[0].px = at.x; g[0].pz = at.z; g[0].yaw = atan2(x - at.x, z - at.z); g[0].pitch = 0;
  // the camera above where the player stands (a place one can stand is not inside a wall), looking down at the route
  v := seen; v.ex = at.x; v.ey = 7; v.ez = at.z; v.ax = x; v.ay = 0; v.az = z;
  vp_fly_from(vp, v); vp[0].fly = true;
}
// The shell's batch (world.edit.v1), sent as this page's own write. False while one is in flight.
spw_shell_batch :: (p: [] SpwPage, body: string) -> bool {
  f := p[0].f[..];
  if wf_post(f, p[0].batch[..], body) { return true; }
  f[0].refused_n = em_copy(f[0].refused[..], "The last change is still on its way. Try again."); f[0].refused_status = 1;
  return false;
}

// ---- an imported mesh becomes a kind (GitHub #13420, the browser editor's E11)

// The row of the pieces table for a pack mesh, into out ("": it does not fit, or the tables have
// no look to give it): the row that already draws the mesh, with the footprint the mesh has at
// that row's size, or a new row after the last, the mesh's name at its own size in the tables'
// first look. hx, hz and top are the mesh's reach in millimetres (pack-import-read.coax pi_reach).
spw_mesh_row :: (tables: string, mesh: string, hx: int, hz: int, top: int, out: [] u8) -> string {
  kb: [5 + PIP_NAME] u8;   // PK_PACK, then a name
  kn := ct_put(kb[..], 0, PK_PACK); kn = ct_put(kb[..], kn, mesh);
  if mesh.count == 0 || kn > kb.count || pk_mesh(cast(string) kb[0..<kn]) != mesh { return ""; }
  kit := cast(string) kb[0..<kn];
  table := ""; found := ""; last := 200; look := "";
  for k: 0..<ct_parts(tables, '\n') {
    line := ct_part(tables, '\n', k);
    if ct_part(line, ' ', 0) == "table" { table = ct_part(line, ' ', 1); continue; }
    row := ct_num(ct_part(line, '|', 0));
    if !row.ok { continue; }
    if table == "looks" && look.count == 0 { look = ct_part(line, '|', 0); }
    if table != SPW_KINDS || ct_parts(line, '|') != 8 { continue; }
    if row.v > last { last = row.v; }
    if ct_part(line, '|', 2) == kit { found = line; }
  }
  scale := ifx found.count > 0 then ct_num(ct_part(found, '|', 3)).v else 1000;
  n := 0;
  if found.count > 0 { for c: 0..<5 { n = ct_put(out, n, ct_part(found, '|', c)); n = ct_put(out, n, "|"); } }
  else {
    if look.count == 0 { return ""; }
    n = ct_put_int(out, 0, last + 1); n = ct_put(out, n, "|"); n = ct_put(out, n, mesh); n = ct_put(out, n, "|"); n = ct_put(out, n, kit); n = ct_put(out, n, "|1000|"); n = ct_put(out, n, look); n = ct_put(out, n, "|");
  }
  n = ct_put_int(out, n, sp_import_cm(hx, scale)); n = ct_put(out, n, "|"); n = ct_put_int(out, n, sp_import_cm(hz, scale)); n = ct_put(out, n, "|"); n = ct_put_int(out, n, sp_import_cm(top, scale));
  return ifx n > out.count then "" else cast(string) out[0..<n];
}
// "mesh NAME HX HZ TOP" from the editor's shell: a mesh is in the world's import pack. Its row
// (spw_mesh_row) is sent as this page's own cell edit, so the server holds it to the pack and every
// open page takes it in place. False when the words are not that, or a write is still on its way.
spw_import_kind :: (p: [] SpwPage, body: string) -> bool {
  f := p[0].f[..];
  hx := ct_num(ct_part(body, ' ', 2)); hz := ct_num(ct_part(body, ' ', 3)); top := ct_num(ct_part(body, ' ', 4));
  if ct_parts(body, ' ') != 5 || ct_part(body, ' ', 0) != "mesh" || !hx.ok || !hz.ok || !top.ok || hx.v < 1 || hz.v < 1 || top.v < 1 { return false; }
  rb: [WE_TEXT] u8;
  row := spw_mesh_row(ifx p[0].ct[0].open then spw_tables_text(p[0].ct[..]) else SC_SHIPPED, ct_part(body, ' ', 1), hx.v, hz.v, top.v, rb[..]);
  if row.count == 0 { return false; }
  e: [1] WorldEdit;
  e[0] = WorldEdit.{ok = true, op = WE_CELL, id = ct_num(ct_part(row, '|', 0)).v};
  e[0].table_n = ct_copy(e[0].table[..], SPW_KINDS); e[0].name_n = ct_copy(e[0].name[..], "*"); e[0].text_n = ct_copy(e[0].text[..], row);
  out: [WE_LINE + 200] u8;
  if wf_post(f, p[0].batch[..], we_batch_write(ifx f[0].rev < 0 then 0 else f[0].rev, WB_APPLY, e[..], 1, out[..])) { return true; }
  f[0].refused_n = em_copy(f[0].refused[..], "The mesh is in the pack, but the last change is still on its way. Import it again to make it a kind."); f[0].refused_status = 1;
  return false;
}

// ---- the viewport's tools on Splice (GitHub #13417, the browser editor's E8; metaverse-engine/editor/viewport.coax)

// The placed pieces as boxes for a pick: each piece's footprint as it is turned, as tall as its kind.
SpvWork :: struct { boxes: [SL_ITEMS * QUERY_BOX] f32; ids: [SL_ITEMS] int; n: int; }
spv_boxes :: (g: [] SpGame, w: [] SpvWork) -> Colliders {
  l := g[0].layer[..]; c := g[0].c[..]; n := 0;
  for i: 0..<l[0].st[0].n {
    item := l[0].items[i];
    r := sc_piece(c, item.mesh);
    if r < 0 || n >= SL_ITEMS { continue; }
    pc := c[0].pieces[r];
    ex := abs(cos(item.yaw)) * pc.hx + abs(sin(item.yaw)) * pc.hz; ez := abs(sin(item.yaw)) * pc.hx + abs(cos(item.yaw)) * pc.hz;
    o := n * QUERY_BOX;
    w[0].boxes[o] = item.x - ex; w[0].boxes[o + 1] = item.y; w[0].boxes[o + 2] = item.z - ez;
    w[0].boxes[o + 3] = item.x + ex; w[0].boxes[o + 4] = item.y + pc.top; w[0].boxes[o + 5] = item.z + ez;
    w[0].ids[n] = item.id + 1; n += 1;
  }
  w[0].n = n;
  return Colliders.{ground = ground_y(g, g[0].px, g[0].pz), boxes = w[0].boxes[0..<n * QUERY_BOX]};
}
// The selected piece as the gizmo holds it (id 0: none).
spv_thing :: (g: [] SpGame, p: [] SpwPage) -> VpThing {
  i := ifx p[0].sel > 0 then sl_item(g, p[0].sel - 1) else -1;
  if i < 0 { return VpThing.{}; }
  item := g[0].layer[0].items[i];
  return VpThing.{id = p[0].sel, x = we_cm(item.x), y = we_cm(item.y), z = we_cm(item.z), yaw = we_deg(item.yaw), scale = 100};
}
// The pointer in the world while a tool is picked: a tap selects the piece under it (or nothing) and
// marks the point as "here"; a drag with the move, turn or size tool ends as one edit, sent as this
// page's own write; with the camera flying, a drag that holds nothing looks around.
spv_pointer :: (g: [] SpGame, p: [] SpwPage, vp: [] Viewport, w: [] SpvWork, v: VpView, x: f32, y: f32, phase: int) {
  if phase == 0 { vp_press(vp, x, y, spv_thing(g, p)); return; }
  if phase == 1 {
    if vp[0].down && !vp[0].holding && vp[0].fly { vp_fly_look(vp, x - vp[0].x, y - vp[0].y); }
    vp_drag(vp, v, x, y);
    return;
  }
  if phase == 3 { vp_cancel(vp); return; }
  r := vp_release(vp);
  if r.tap {
    ray := vp_ray(v, r.x, r.y);
    hit := query_ray(spv_boxes(g, w), ray.o, ray.d, VP_FAR);
    spw_select(g, p, ifx hit.hit && hit.shape == QueryShape.box && hit.index >= 0 && hit.index < w[0].n then w[0].ids[hit.index] else 0);
    if hit.hit { vp_here(vp, VpSpot.{ok = true, x = ray.o.x + ray.d.x * hit.t, z = ray.o.z + ray.d.z * hit.t}); }
    p[0].here = vp[0].here_ok; p[0].here_x = vp[0].here_x; p[0].here_z = vp[0].here_z;
    return;
  }
  if !r.edit.ok { return; }
  edits: [1] WorldEdit; edits[0] = r.edit; out: [WE_LINE + 128] u8;
  _ := spw_shell_batch(p, we_batch_write(p[0].f[0].rev, WB_APPLY, edits[..], 1, out[..]));
}
// Where the selected piece is on the screen, as a box round it (x0, y0, x1, y1), for the page to
// outline: where it stands, or where a drag would leave it. Not ok with nothing selected or it out of view.
SpvMark :: struct { ok: bool; x0: f32; y0: f32; x1: f32; y1: f32; }
spv_mark :: (g: [] SpGame, p: [] SpwPage, vp: [] Viewport, v: VpView) -> SpvMark {
  th := spv_thing(g, p);
  if th.id == 0 { return SpvMark.{}; }
  i := sl_item(g, th.id - 1); r := sc_piece(g[0].c[..], g[0].layer[0].items[i].mesh);
  if r < 0 { return SpvMark.{}; }
  pc := g[0].c[0].pieces[r];
  at := ifx vp_dragging(vp) then vp[0].now else th;
  k := cast(f32) at.scale / 100; reach := hi(pc.hx, pc.hz) * k;
  cx := cast(f32) at.x / 100; cy := cast(f32) at.y / 100; cz := cast(f32) at.z / 100;
  m := SpvMark.{x0 = 1000000, y0 = 1000000, x1 = -1000000, y1 = -1000000};
  for c: 0..<8 {
    px := vp_project(v, cx + (ifx (c & 1) != 0 then reach else -reach), cy + (ifx (c & 2) != 0 then pc.top * k else 0.0f32), cz + (ifx (c & 4) != 0 then reach else -reach));
    if !px.ok { return SpvMark.{}; }
    m.x0 = lo(m.x0, px.x); m.y0 = lo(m.y0, px.y); m.x1 = hi(m.x1, px.x); m.y1 = hi(m.y1, px.y);
  }
  m.ok = true;
  return m;
}

// ---- the placement planner on Splice (GitHub #13414, the browser editor's E5; metaverse-engine/editor/place.coax)

// What the planner asks of a piece's kind, from the pieces table: its footprint's reach, and
// whether it grows (a palm is turned any which way; a made thing faces the camera).
spw_kind :: (g: [] SpGame, kind: int) -> PlaceKind {
  r := sc_piece(g[0].c[..], kind);
  if r < 0 { return PlaceKind.{}; }
  pc := g[0].c[0].pieces[r];
  return PlaceKind.{radius = hi(pc.hx, pc.hz), natural = pc.kit == PK_PALM};
}
SPW_ROOM :: 1.35;   // how much wider than its footprint's corner a piece is planned, so the planner's spacing never lets two touch
spw_round :: (g: [] SpGame, kind: int) -> f32 {
  r := sc_piece(g[0].c[..], kind);
  if r < 0 { return 0.5; }
  pc := g[0].c[0].pieces[r];
  return sqrt(pc.hx * pc.hx + pc.hz * pc.hz) * SPW_ROOM;
}
// `count` pieces of a kind planned from the point last tapped, clear of each other, as one batch of
// spawns sent as this page's own write (one step: one undo takes them all back). The server checks
// each where it stands, as any edit. False when there is no point, no such kind, or the batch did not go.
spw_plan_add :: (g: [] SpGame, p: [] SpwPage, w: [] SpvWork, v: PlaceView, kind: int, count: int) -> bool {
  if !p[0].here || sc_piece(g[0].c[..], kind) < 0 || count < 1 || count > WE_BATCH { return false; }
  l := g[0].layer[..];
  // the server refuses a piece that touches another, so each is planned as a circle round its whole footprint,
  // with room to spare, clear of the others and of what stands
  stood: [SL_ITEMS] PlaceSpot; ns := 0;
  for i: 0..<l[0].st[0].n { item := l[0].items[i]; stood[ns] = PlaceSpot.{x = item.x, z = item.z, r = spw_round(g, item.mesh), ok = true}; ns += 1; }
  out: [WE_BATCH] PlaceOut;
  at := PlaceSpot.{x = cast(f32) p[0].here_x / 100, z = cast(f32) p[0].here_z / 100, ok = true};
  kd := spw_kind(g, kind); kd.radius = spw_round(g, kind);
  n := pl_plan(kd, at, v, PlaceAsk.{count = count, nudge = true, clear = true, seed = l[0].rev * 7919 + kind}, stood[0..<ns], out[..]);
  edits: [WE_BATCH] WorldEdit;
  for i: 0..<n { edits[i] = WorldEdit.{ok = true, op = WE_SPAWN, id = 0, kind = kind, x = vp_cm(out[i].x), z = vp_cm(out[i].z), yaw = vp_wrap(we_deg(out[i].yaw))}; }
  body: [WE_BATCH_BODY] u8;
  return n > 0 && spw_shell_batch(p, we_batch_write(p[0].f[0].rev, WB_APPLY, edits[..], n, body[..]));
}
