// Splice's content tables (GitHub #13404; docs/audits/2026-11-12-chat-and-world-building.md, slice
// 0): what may be placed in Splice, where its named places are and where nothing may be built,
// as data. The document is metaverse-engine/content/tables.coax's (profile aethyr-content-v1); the tables
// are metaverse/splice/content/splice.content, which the Metaverse Engine's table editor
// (metaverse-engine/editor/content-edit.coax) edits, and a page is built with the copy in content/shipped.coax.
//
//   actors      id name                     the name of each foe a plan names (WHO): the editor's Actors list
//                                           and `realm world-foes` show them; rows 1 to 9
//   areas       id name x z hx hz r         where a piece may stand at all: a circle (r) or a box (hx, hz)
//   kept_clear  id name x z hx hz r         where the run needs room: a box (hx, hz) grown by r, so a
//                                           circle is hx 0, hz 0 and a radius
//   landmarks   id name x z r               a named place and its radius (a pickup's reach, a door's width)
//   looks       id name a b c               three colours of Splice's palette, red green blue bytes in one number
//   pieces      id name kit scale look hx hz top   a placeable piece: the engine kit piece it draws
//                                           (pieces.coax PK_NAME), its size in thousandths, its look,
//                                           and its footprint: how far its body reaches to each
//                                           side (hx) and ahead (hz), and how tall it is (top)
//   templates   id name parts               a group of pieces saved to be placed again as one edit
//                                           (metaverse-engine/editor/place.coax pl_template_*): each part
//                                           a piece's ID and where it stands from the group's middle
//   plans       id who when do route speed notice on   how each of the party's people moves at each
//                                           time of day (metaverse-engine/ai/npc-plan.coax, #13466):
//                                           WHO 1 to 5 the raiders, 6 to 9 the Imperial robots; ID is
//                                           WHO * 10 + the time of day (dawn 0, day 1, dusk 2, night 3);
//                                           every foe has a plan for each time of day, and its route
//                                           stays in the mine (the area SC_FOE_AREA)
//   scripts     id name hash for            the realm scripts the world runs (metaverse-engine/script/rows.coax,
//                                           #13467): a script's name, its module's SHA-256 and whom it
//                                           drives: "kind 1" the raiders, "kind 2" the Imperial robots, or
//                                           "who N" one foe. No row: every foe walks its plan alone
//   menu        id key label                the title screen's menu, top to bottom by ID (front.coax): KEY is
//                                           continue, new or credits, each at most once and new always;
//                                           LABEL is what the row says
//   credits     id line                     the credits screen's lines, top to bottom by ID
//   dolly       id x y z ax ay az secs      the title screen's camera path past the rover on the rail: where
//                                           the camera is and what it looks at, in centimetres from the
//                                           rover (x its right, z ahead), and the seconds it takes to come
//                                           there from the row before; the last row runs back to the first
//   clock       id when                     the editor's time of day (row 1): story (the run's own), or
//                                           dawn, day, dusk or night. Only an editor (?edit) reads it;
//                                           play keeps the story's phases
//   portals     id name from to yaw r       a way from one place to another you take with E, such as a
//                                           vehicle's door into a room (metaverse-engine/world/portal.coax,
//                                           #13485): from "kind K" (a placed piece of kind K) or "at X Z"
//   starts      id when at yaw              where a run starts, and where a respawn at a time of day goes
//                                           (metaverse-engine/world/flow.coax, #13485)
//   beats       id area from to             the time of day moves on (FROM to TO) where the player stands
//                                           in an area (flow.coax, #13485)
//   board       id on casual fast           the player's hoverboard (row 1, metaverse-engine/action/hoverboard.coax,
//                                           #13485): on or off, and its casual and very fast speeds in
//                                           centimetres a second. `openagents realm world-board` sets it
// The actors, plans, clock, scripts, portals, starts, beats and board tables came after revision 2 shipped. Tables saved at revision 2 without them
// read with the shipped ones put in (sc_upgrade), so every saved world document still opens.
// Places and lengths are centimetres. `looks` is a table of its own because a table has eight
// columns at most. An edit or a save names a piece by its ID; names are for people and agents.
//   coax/bin/coax test metaverse/splice/content.coax --library
#load "../../metaverse-engine/content/tables.coax";
#load "../../metaverse-engine/editor/place.coax";
#load "pieces.coax";
#load "content/shipped.coax";
#load "../../metaverse-engine/ai/plan.coax";   // the foes' plans (npc-plan.coax) and where they take them
#load "../../metaverse-engine/script/rows.coax";   // the world's script rows (#13467)
#load "../../metaverse-engine/world/portal.coax";  // the world's portals (#13485)
#load "../../metaverse-engine/world/flow.coax";    // where a run starts and where the day moves on (#13485)
#load "../../metaverse-engine/action/hoverboard.coax";   // the board table's row (#13485)

SC_TABLES :: 17;
SC_ACTORS :: 0; SC_AREAS :: 1; SC_BEATS :: 2; SC_BOARD :: 3; SC_CLOCK :: 4; SC_CREDITS :: 5; SC_DOLLY :: 6; SC_KEPT :: 7; SC_MARKS :: 8; SC_LOOKS :: 9; SC_MENU :: 10; SC_PIECES :: 11; SC_PLANS :: 12; SC_PORTALS :: 13; SC_SCRIPTS :: 14; SC_STARTS :: 15; SC_TEMPLATES :: 16;
SC_TEMPLATE_MAX :: 32;   // templates a world keeps
SC_HEAD :: [SC_TABLES] string.[
  "table actors id name:text",
  "table areas id name:text x:cm z:cm hx:int hz:int r:int",
  FLW_BEATS,
  BOARD_TABLE,
  "table clock id when:text",
  "table credits id line:text",
  "table dolly id x:cm y:cm z:cm ax:cm ay:cm az:cm secs:int",
  "table kept_clear id name:text x:cm z:cm hx:int hz:int r:int",
  "table landmarks id name:text x:cm z:cm r:int",
  "table looks id name:text a:int b:int c:int",
  "table menu id key:text label:text",
  "table pieces id name:text kit:text scale:int look:ref.looks hx:int hz:int top:int",
  "table plans id who:int when:text do:text route:text speed:int notice:int on:text",
  PRT_TABLE,
  SRW_TABLE,
  FLW_STARTS,
  "table templates id name:text parts:text"];
SC_TABLE_NAME :: [SC_TABLES] string.["actors", "areas", "beats", "board", "clock", "credits", "dolly", "kept_clear", "landmarks", "looks", "menu", "pieces", "plans", "portals", "scripts", "starts", "templates"];
SC_NAME :: 24;          // bytes of a row's name kept for a refusal or a listing
SC_AREA_MAX :: 8; SC_KEPT_MAX :: 48; SC_MARK_MAX :: 96; SC_PIECE_MAX :: 32;
SC_SCALE_MIN :: 100; SC_SCALE_MAX :: 4000;   // a piece's size, thousandths
SC_FOES :: 9;           // the party's people a plan names: raiders 1 to 5, Imperial robots 6 to 9
SC_PLAN_MAX :: SC_FOES * NPL_WHENS;
SC_FOE_AREA :: 4;       // the mine: foes walk in it and in every area added after it (5 and up); 1 to 3 are stages with no foes
SC_MENU_KEYS :: [3] string.["continue", "new", "credits"];   // what a menu row does (front.coax FR_*: its place here plus 1)
SC_MENU_MAX :: 6; SC_CREDIT_MAX :: 12; SC_DOLLY_MAX :: 8; SC_LINE :: 48;   // rows the game keeps, and the bytes of a label or a line
SC_CLOCKS :: 5;
SC_CLOCK_WORD :: [SC_CLOCKS] string.["story", "dawn", "day", "dusk", "night"];   // the editor's clock: -1 (the story's), then PH_DAWN..PH_NIGHT

// A zone: a box (half sizes hx, hz) round (x, z), grown by r. Metres.
ScZone :: struct { id: int; x: f32; z: f32; hx: f32; hz: f32; r: f32; name: [SC_NAME] u8; name_n: int; }
ScMark :: struct { id: int; x: f32; z: f32; r: f32; name: [SC_NAME] u8; name_n: int; }
ScPiece :: struct { id: int; kit: int; scale: f32; a: int; b: int; c: int; hx: f32; hz: f32; top: f32; name: [SC_NAME] u8; name_n: int; mesh: [PIP_NAME] u8; mesh_n: int; }   // mesh: a pack mesh's name (kit PK_MESH)
// The tables as the game reads them each frame: metres, kit numbers, colours.
SpContent :: struct {
  ok: bool; rev: int;
  areas: [SC_AREA_MAX] ScZone; area_n: int;
  kept: [SC_KEPT_MAX] ScZone; kept_n: int;
  marks: [SC_MARK_MAX] ScMark; mark_n: int;
  pieces: [SC_PIECE_MAX] ScPiece; piece_n: int;
  plans: [SC_PLAN_MAX] NplPlan;   // by (WHO - 1) * 4 + the time of day
  clock: int = -1;                // the editor's time of day: -1 the story's, else 0 dawn to 3 night
  actor: [SC_FOES] [SC_NAME] u8; actor_n: [SC_FOES] int;   // each foe's name (the actors table)
  scripts: [SH_SCRIPTS] ScriptRow; script_n: int;          // the scripts the world runs (the scripts table)
  board: BoardRow;                                         // the player's hoverboard (the board table)
  // the front screens (front.coax): the menu's rows (each a key, 1 + its place in SC_MENU_KEYS, and its label),
  // the credits' lines, and the title camera's path (metres from the rover, and seconds a leg)
  menu: [SC_MENU_MAX] int; menu_label: [SC_MENU_MAX] [SC_LINE] u8; menu_label_n: [SC_MENU_MAX] int; menu_n: int;
  credit: [SC_CREDIT_MAX] [SC_LINE] u8; credit_n: [SC_CREDIT_MAX] int; credits: int;
  dolly: [SC_DOLLY_MAX * 7] f32; dolly_n: int;
  portals: [PRT_MAX] Portal; portal_n: int;                // the ways from one place to another (the portals table)
  starts: [FLW_MAX] FlowStart; start_n: int;               // where a run starts (the starts table)
  beats: [FLW_MAX] FlowBeat; beat_n: int;                  // where the day moves on (the beats table)
}

sc_m :: (cm: int) -> f32 { return cast(f32) cm / 100; }
sc_name :: (dst: [] u8, s: string) -> int {
  n := ifx s.count < dst.count then s.count else dst.count;
  for i: 0..<n { dst[i] = s[i]; }
  return n;
}
sc_zone :: (d: [] ContentDoc, t: int, r: int) -> ScZone {
  z := ScZone.{id = ct_get(d, t, r, 0), x = sc_m(ct_get(d, t, r, 2)), z = sc_m(ct_get(d, t, r, 3)), hx = sc_m(ct_get(d, t, r, 4)), hz = sc_m(ct_get(d, t, r, 5)), r = sc_m(ct_get(d, t, r, 6))};
  z.name_n = sc_name(z.name[..], ct_str(d, t, r, 1));
  return z;
}
// Whether d is Splice's content: a document that read, with exactly Splice's tables and columns,
// no more rows than the game keeps, every piece a kit piece of a size the kits take with a
// footprint, and every area a circle or a box, not both.
sc_ok :: (d: [] ContentDoc) -> bool {
  if !d[0].ok || d[0].t_n != SC_TABLES { return false; }
  for t: 0..<SC_TABLES {
    hb: [320] u8;
    if cast(string) hb[0..<ct_put_table(d, t, hb[..], 0)] != SC_HEAD[t] { return false; }
  }
  if ct_rows(d, SC_AREAS) > SC_AREA_MAX || ct_rows(d, SC_KEPT) > SC_KEPT_MAX || ct_rows(d, SC_MARKS) > SC_MARK_MAX || ct_rows(d, SC_PIECES) > SC_PIECE_MAX { return false; }
  for r: 0..<ct_rows(d, SC_AREAS) {
    box := ct_get(d, SC_AREAS, r, 4) > 0 && ct_get(d, SC_AREAS, r, 5) > 0; round := ct_get(d, SC_AREAS, r, 6) > 0;
    if box == round || (round && (ct_get(d, SC_AREAS, r, 4) != 0 || ct_get(d, SC_AREAS, r, 5) != 0)) { return false; }
  }
  for r: 0..<ct_rows(d, SC_LOOKS) { for k: 2..<5 { if ct_get(d, SC_LOOKS, r, k) > 0xFFFFFF { return false; } } }
  for r: 0..<ct_rows(d, SC_PIECES) {
    s := ct_get(d, SC_PIECES, r, 3);
    if pk_of(ct_str(d, SC_PIECES, r, 2)) < 0 || s < SC_SCALE_MIN || s > SC_SCALE_MAX || ct_get(d, SC_PIECES, r, 5) < 1 || ct_get(d, SC_PIECES, r, 6) < 1 || ct_get(d, SC_PIECES, r, 7) < 1 { return false; }
  }
  // a template's parts read as parts, and each is a piece the tables have
  if ct_rows(d, SC_TEMPLATES) > SC_TEMPLATE_MAX { return false; }
  for r: 0..<ct_rows(d, SC_TEMPLATES) {
    parts: [PL_PARTS] PlacePart; scratch: [PL_TEMPLATE] u8;
    n := pl_template_read(ct_str(d, SC_TEMPLATES, r, 2), parts[..], scratch[..]);
    if n < 1 || ct_str(d, SC_TEMPLATES, r, 1).count == 0 { return false; }
    for k: 0..<n { if ct_find(d, SC_PIECES, parts[k].kind) < 0 || parts[k].scale != 100 { return false; } }
  }
  return sc_plans_why(d) == SCP_OK;
}
// Why the plans or the clock do not hold (SCP_OK when they do): a plan's own reason (SCP_PLAN + an
// NPL_ code, npc-plan.coax), a point outside the mine, a foe without a plan for a time of day, or a
// clock that is not one of SC_CLOCK_WORD. `row`: the plan row it was, when one.
SCP_OK :: 0; SCP_PLAN :: 40; SCP_OUTSIDE :: 60; SCP_MISSING :: 61; SCP_CLOCK :: 62; SCP_ACTORS :: 63;
SCP_BOARD :: 64;    // + a BRW_ code (metaverse-engine/action/hoverboard.coax): the board's row does not hold
SCP_SCRIPT :: 70;   // + an SRW_ code (metaverse-engine/script/rows.coax): a script row that does not read
SCP_SCRIPT_WHO :: 78;   // a script row for a foe the world does not have
SCP_MENU :: 80; SCP_CREDITS :: 81; SCP_DOLLY :: 82;   // the front screens' tables (front.coax)
// Why the front screens' tables do not hold: a menu row whose key is not one the game knows, a key
// twice, no "new" row, a label that is empty or too long; too many credits or a line too long; a
// camera path with no row, too many, or a leg that takes no time.
sc_front_why :: (d: [] ContentDoc) -> int {
  n := ct_rows(d, SC_MENU); keys := SC_MENU_KEYS; seen: [3] bool;
  if n < 1 || n > SC_MENU_MAX { return SCP_MENU; }
  for r: 0..<n {
    k := -1; for w, i: keys { if ct_str(d, SC_MENU, r, 1) == w { k = i; } }
    l := ct_str(d, SC_MENU, r, 2);
    if k < 0 || seen[k] || l.count < 1 || l.count > SC_LINE { return SCP_MENU; }
    seen[k] = true;
  }
  if !seen[1] { return SCP_MENU; }
  if ct_rows(d, SC_CREDITS) > SC_CREDIT_MAX { return SCP_CREDITS; }
  for r: 0..<ct_rows(d, SC_CREDITS) { if ct_str(d, SC_CREDITS, r, 1).count > SC_LINE { return SCP_CREDITS; } }
  if ct_rows(d, SC_DOLLY) < 1 || ct_rows(d, SC_DOLLY) > SC_DOLLY_MAX { return SCP_DOLLY; }
  for r: 0..<ct_rows(d, SC_DOLLY) { if ct_get(d, SC_DOLLY, r, 7) < 1 { return SCP_DOLLY; } }
  return SCP_OK;
}
SCP_PORTAL :: 90;   // + a PRT_ code (metaverse-engine/world/portal.coax): a portal row that does not read
SCP_PORTAL_KIND :: 98;   // a portal from a kind the pieces table does not have
SCP_START :: 100;   // + an FLW_ code (metaverse-engine/world/flow.coax): a start row that does not read
SCP_BEAT :: 110;    // + an FLW_ code: a beat row that does not read
ScPlanWhy :: struct { why: int; id: int; }
sc_plans_check :: (d: [] ContentDoc) -> ScPlanWhy {
  front := sc_front_why(d);
  if front != SCP_OK { return ScPlanWhy.{why = front}; }
  if ct_rows(d, SC_ACTORS) != SC_FOES { return ScPlanWhy.{why = SCP_ACTORS}; }
  for r: 0..<SC_FOES { if ct_get(d, SC_ACTORS, r, 0) != r + 1 { return ScPlanWhy.{why = SCP_ACTORS}; } }
  if ct_rows(d, SC_CLOCK) != 1 || ct_get(d, SC_CLOCK, 0, 0) != 1 { return ScPlanWhy.{why = SCP_CLOCK}; }
  words := SC_CLOCK_WORD; known := false;
  for w: words { if ct_str(d, SC_CLOCK, 0, 1) == w { known = true; } }
  if !known { return ScPlanWhy.{why = SCP_CLOCK, id = 1}; }
  if ct_rows(d, SC_BOARD) != 1 { return ScPlanWhy.{why = SCP_BOARD + BRW_ID}; }
  bw := board_row_why(ct_get(d, SC_BOARD, 0, 0), ct_str(d, SC_BOARD, 0, 1), ct_get(d, SC_BOARD, 0, 2), ct_get(d, SC_BOARD, 0, 3));
  if bw != BRW_OK { return ScPlanWhy.{why = SCP_BOARD + bw}; }
  if ct_rows(d, SC_SCRIPTS) > SH_SCRIPTS { return ScPlanWhy.{why = SCP_SCRIPT + SRW_BAD_ID}; }
  for r: 0..<ct_rows(d, SC_SCRIPTS) {
    row: [1] ScriptRow; id := ct_get(d, SC_SCRIPTS, r, 0);
    why := srw_read(id, ct_str(d, SC_SCRIPTS, r, 1), ct_str(d, SC_SCRIPTS, r, 2), ct_str(d, SC_SCRIPTS, r, 3), row[..]);
    if why != SRW_OK { return ScPlanWhy.{why = SCP_SCRIPT + why, id = id}; }
    if !row[0].by_kind && row[0].n > SC_FOES { return ScPlanWhy.{why = SCP_SCRIPT_WHO, id = id}; }
  }
  if ct_rows(d, SC_PORTALS) > PRT_MAX { return ScPlanWhy.{why = SCP_PORTAL + PRT_BAD_ID}; }
  for r: 0..<ct_rows(d, SC_PORTALS) {
    p: [1] Portal; id := ct_get(d, SC_PORTALS, r, 0);
    why := prt_read(id, ct_str(d, SC_PORTALS, r, 1), ct_str(d, SC_PORTALS, r, 2), ct_str(d, SC_PORTALS, r, 3), ct_get(d, SC_PORTALS, r, 4), ct_get(d, SC_PORTALS, r, 5), p[..]);
    if why != PRT_OK { return ScPlanWhy.{why = SCP_PORTAL + why, id = id}; }
    if p[0].kind > 0 && ct_find(d, SC_PIECES, p[0].kind) < 0 { return ScPlanWhy.{why = SCP_PORTAL_KIND, id = id}; }
  }
  if ct_rows(d, SC_STARTS) > FLW_MAX || ct_rows(d, SC_BEATS) > FLW_MAX { return ScPlanWhy.{why = SCP_START + FLW_TOO_MANY}; }
  for r: 0..<ct_rows(d, SC_STARTS) {
    s: [1] FlowStart; id := ct_get(d, SC_STARTS, r, 0);
    why := flw_start_read(id, ct_str(d, SC_STARTS, r, 1), ct_str(d, SC_STARTS, r, 2), ct_get(d, SC_STARTS, r, 3), s[..]);
    if why != FLW_OK { return ScPlanWhy.{why = SCP_START + why, id = id}; }
  }
  for r: 0..<ct_rows(d, SC_BEATS) {
    b: [1] FlowBeat; id := ct_get(d, SC_BEATS, r, 0); area := ct_get(d, SC_BEATS, r, 1);
    why := flw_beat_read(id, area, ct_str(d, SC_BEATS, r, 2), ct_str(d, SC_BEATS, r, 3), ct_find(d, SC_AREAS, area) >= 0, b[..]);
    if why != FLW_OK { return ScPlanWhy.{why = SCP_BEAT + why, id = id}; }
  }
  if ct_find(d, SC_AREAS, SC_FOE_AREA) < 0 || ct_rows(d, SC_PLANS) > SC_PLAN_MAX { return ScPlanWhy.{why = SCP_MISSING}; }
  for r: 0..<ct_rows(d, SC_PLANS) {
    p: [1] NplPlan; id := ct_get(d, SC_PLANS, r, 0);
    why := npl_read(id, ct_get(d, SC_PLANS, r, 1), ct_str(d, SC_PLANS, r, 2), ct_str(d, SC_PLANS, r, 3), ct_str(d, SC_PLANS, r, 4), ct_get(d, SC_PLANS, r, 5), ct_get(d, SC_PLANS, r, 6), ct_str(d, SC_PLANS, r, 7), SC_FOES, p[..]);
    if why != NPL_OK { return ScPlanWhy.{why = SCP_PLAN + why, id = id}; }
    for k: 0..<p[0].n {
      if !sc_foe_ground(d, p[0].x[k], p[0].z[k]) { return ScPlanWhy.{why = SCP_OUTSIDE, id = id}; }
    }
  }
  // every foe at every time of day: rows ascend by ID, so they are exactly 10, 11, ... 93 with none between
  if ct_rows(d, SC_PLANS) != SC_PLAN_MAX { return ScPlanWhy.{why = SCP_MISSING}; }
  for r: 0..<SC_PLAN_MAX { if ct_get(d, SC_PLANS, r, 0) != npl_id(r / NPL_WHENS + 1, r % NPL_WHENS) { return ScPlanWhy.{why = SCP_MISSING, id = npl_id(r / NPL_WHENS + 1, r % NPL_WHENS)}; } }
  return ScPlanWhy.{};
}
sc_plans_why :: (d: [] ContentDoc) -> int { return sc_plans_check(d).why; }
// Whether (x, z), centimetres, is ground the foes walk: inside the mine (area SC_FOE_AREA) or an area
// added after it. A box is (hx, hz) round its middle and a circle is r round it.
sc_foe_ground :: (d: [] ContentDoc, x: int, z: int) -> bool {
  for r: 0..<ct_rows(d, SC_AREAS) {
    if ct_get(d, SC_AREAS, r, 0) < SC_FOE_AREA { continue; }
    ax := ct_get(d, SC_AREAS, r, 2); az := ct_get(d, SC_AREAS, r, 3); hx := ct_get(d, SC_AREAS, r, 4); hz := ct_get(d, SC_AREAS, r, 5); rr := ct_get(d, SC_AREAS, r, 6);
    if rr > 0 { if (x - ax) * (x - ax) + (z - az) * (z - az) <= rr * rr { return true; } }
    else if x >= ax - hx && x <= ax + hx && z >= az - hz && z <= az + hz { return true; }
  }
  return false;
}
// Why tables in text do not hold as plans, in words into out ("" when they do, or they are no content document).
sc_plans_words :: (text: string, out: [] u8) -> string {
  d: [1] ContentDoc;
  if !ct_read(d[..], text) || d[0].t_n != SC_TABLES { return ""; }
  c := sc_plans_check(d[..]);
  if c.why == SCP_OK { return ""; }
  n := 0;
  if c.id > 0 && c.why != SCP_CLOCK {
    n = ct_put(out, 0, ifx c.why >= SCP_BEAT then "beat " else ifx c.why >= SCP_START then "start " else ifx c.why >= SCP_PORTAL then "portal " else ifx c.why >= SCP_SCRIPT then "script " else "plan ");
    n = ct_put_int(out, n, c.id); n = ct_put(out, n, ": ");
  }
  if c.why >= SCP_PORTAL && c.why < SCP_PORTAL_KIND { n = ct_put(out, n, prt_why(c.why - SCP_PORTAL)); }
  if c.why == SCP_PORTAL_KIND { n = ct_put(out, n, "FROM names a kind the pieces table has"); }
  if c.why >= SCP_START && c.why < SCP_BEAT { n = ct_put(out, n, flw_why(c.why - SCP_START)); }
  if c.why >= SCP_BEAT { n = ct_put(out, n, flw_why(c.why - SCP_BEAT)); }
  if c.why >= SCP_SCRIPT && c.why < SCP_SCRIPT_WHO { n = ct_put(out, n, srw_why(c.why - SCP_SCRIPT)); }
  if c.why == SCP_SCRIPT_WHO { n = ct_put(out, n, "FOR names a foe the world has: who 1 to 9"); }
  if c.why >= SCP_PLAN && c.why < SCP_OUTSIDE { n = ct_put(out, n, npl_why(c.why - SCP_PLAN)); }
  if c.why == SCP_OUTSIDE {
    a := ct_find(d[..], SC_AREAS, SC_FOE_AREA);
    n = ct_put(out, n, "a foe's route stays in the mine (x ");
    n = ct_put_int(out, n, ct_get(d[..], SC_AREAS, a, 2) - ct_get(d[..], SC_AREAS, a, 4)); n = ct_put(out, n, " to "); n = ct_put_int(out, n, ct_get(d[..], SC_AREAS, a, 2) + ct_get(d[..], SC_AREAS, a, 4));
    n = ct_put(out, n, ", z "); n = ct_put_int(out, n, ct_get(d[..], SC_AREAS, a, 3) - ct_get(d[..], SC_AREAS, a, 5)); n = ct_put(out, n, " to "); n = ct_put_int(out, n, ct_get(d[..], SC_AREAS, a, 3) + ct_get(d[..], SC_AREAS, a, 5));
    n = ct_put(out, n, " centimetres) or an area added after it (ID 5 and up); the dome village, the gate corridor and the rail stop are stages of their own, with no foes in them");
  }
  if c.why == SCP_MENU { n = ct_put(out, n, "the menu's rows are continue, new and credits, each at most once and new always, each with a label of 1 to 48 bytes"); }
  if c.why == SCP_CREDITS { n = ct_put(out, n, "the credits are at most 12 lines of at most 48 bytes"); }
  if c.why == SCP_DOLLY { n = ct_put(out, n, "the title camera's path has 1 to 8 rows, each taking 1 second or more"); }
  if c.why == SCP_MISSING { n = ct_put(out, n, "every foe keeps a plan for dawn, day, dusk and night: set a plan's cells, never drop its row"); }
  if c.why == SCP_CLOCK { n = ct_put(out, n, "the clock's row 1 is story, dawn, day, dusk or night"); }
  if c.why > SCP_BOARD && c.why < SCP_SCRIPT { n = ct_put(out, n, board_row_words(c.why - SCP_BOARD)); }
  if c.why == SCP_ACTORS { n = ct_put(out, n, "the actors table names foes 1 to 9, one row each: rename one, never drop or add a row"); }
  return ifx n > out.count then "" else cast(string) out[0..<n];
}
// Tables saved at revision 2 before some of Splice's tables were (the actors, plans, clock, scripts,
// portals, starts, beats and board came later): the same tables with each missing one put in, as shipped,
// where it sorts, into out. Tables that have them all, that hold a table Splice does not have, or
// are not Splice's at all, come back as they were.
sc_upgrade :: (text: string, out: [] u8) -> string {
  if text.count == 0 { return text; }
  first := sc_at(text, "\ntable ");
  if first < 0 || sc_at(text, "\ntable areas ") < 0 || sc_at(text, "\ntable kept_clear ") < 0 || sc_at(text, "\ntable templates ") < 0 { return text; }
  names := SC_TABLE_NAME;
  have := 0; missing := false;
  for name: names { if sc_shipped_table(text, name).count > 0 { have += 1; } else { missing = true; } }
  tables := 0;
  for a: 0..<text.count - 6 { if text[a] == '\n' && text[a + 1..<a + 7] == "table " { tables += 1; } }
  if !missing || tables != have { return text; }
  n := ct_put(out, 0, text[0..<first + 1]);
  for name: names {
    blk := sc_shipped_table(text, name);
    if blk.count == 0 { blk = sc_shipped_table(SC_SHIPPED, name); }
    n = ct_put(out, n, blk);
    if blk.count > 0 && blk[blk.count - 1] != '\n' { n = ct_put(out, n, "\n"); }
  }
  return ifx n > out.count then text else cast(string) out[0..<n];
}
// Tables saved before the front screens' were (the credits, dolly and menu tables, #13482): each one
// missing is put in where it sorts, from the shipped tables. Tables that have them all, or are not
// Splice's (no templates table at their end), come back as they were.
SC_FRONT_TABLES :: [3] string.["credits", "dolly", "menu"];
sc_upgrade_front :: (text: string, out: [] u8) -> string {
  if text.count == 0 || sc_at(text, "\ntable templates ") < 0 { return text; }
  names := SC_FRONT_TABLES; missing := false;
  for nm: names { if sc_at(text, sc_head_of(nm)) < 0 { missing = true; } }
  if !missing { return text; }
  n := 0; at := 0;
  for nm: names {
    if sc_at(text, sc_head_of(nm)) >= 0 { continue; }
    // before the first table whose name sorts after this one
    before := text.count - 1; i := ifx at > 0 then at - 1 else 0;
    while i + 7 < text.count {
      if text[i] == '\n' && text[i + 1..<i + 7] == "table " {
        e := i + 7; while e < text.count && text[e] != ' ' && text[e] != '\n' { e += 1; }
        if sc_after(text[i + 7..<e], nm) { before = i; break; }
      }
      i += 1;
    }
    n = ct_put(out, n, text[at..<before + 1]); n = ct_put(out, n, sc_shipped_table(SC_SHIPPED, nm)); at = before + 1;
  }
  n = ct_put(out, n, text[at..<text.count]);
  return ifx n > out.count then text else cast(string) out[0..<n];
}
// "\ntable NAME ", for a table name of at most 24 bytes.
SC_HEADS :: [3] string.["\ntable credits ", "\ntable dolly ", "\ntable menu "];
sc_head_of :: (nm: string) -> string { names := SC_FRONT_TABLES; heads := SC_HEADS; for w, i: names { if w == nm { return heads[i]; } } return "\ntable ?"; }
// Whether name a sorts after b, byte by byte.
sc_after :: (a: string, b: string) -> bool {
  for i: 0..<(ifx a.count < b.count then a.count else b.count) { if a[i] != b[i] { return a[i] > b[i]; } }
  return a.count > b.count;
}
// Where `what` first stands in s, or -1.
sc_at :: (s: string, what: string) -> int {
  for a: 0..<s.count - what.count + 1 { if s[a] == what[0] && s[a..<a + what.count] == what { return a; } }
  return -1;
}
// A table of tables as text, its header and rows ("" when it has none of that name).
sc_shipped_table :: (s: string, name: string) -> string {
  hb: [40] u8; hn := ct_put(hb[..], 0, "\ntable "); hn = ct_put(hb[..], hn, name); hn = ct_put(hb[..], hn, " ");
  a := sc_at(s, cast(string) hb[0..<hn]);
  if a < 0 { return ""; }
  rest := s[a + 1..<s.count]; e := sc_at(rest, "\ntable ");
  return ifx e < 0 then rest else rest[0..<e + 1];
}

// The tables in text into c; false, and c not ok, for anything but Splice's content.
sc_load :: (c: [] SpContent, text: string) -> bool {
  c[0].ok = false; c[0].area_n = 0; c[0].kept_n = 0; c[0].mark_n = 0; c[0].piece_n = 0; c[0].portal_n = 0; c[0].start_n = 0; c[0].beat_n = 0;
  d: [1] ContentDoc; up: [CT_BODY] u8; up2: [CT_BODY] u8;
  if !ct_read(d[..], sc_upgrade_front(sc_upgrade(text, up[..]), up2[..])) || !sc_ok(d[..]) { return false; }
  c[0].rev = d[0].rev;
  for r: 0..<ct_rows(d[..], SC_AREAS) { c[0].areas[r] = sc_zone(d[..], SC_AREAS, r); }
  c[0].area_n = ct_rows(d[..], SC_AREAS);
  for r: 0..<ct_rows(d[..], SC_KEPT) { c[0].kept[r] = sc_zone(d[..], SC_KEPT, r); }
  c[0].kept_n = ct_rows(d[..], SC_KEPT);
  for r: 0..<ct_rows(d[..], SC_MARKS) {
    m := ScMark.{id = ct_get(d[..], SC_MARKS, r, 0), x = sc_m(ct_get(d[..], SC_MARKS, r, 2)), z = sc_m(ct_get(d[..], SC_MARKS, r, 3)), r = sc_m(ct_get(d[..], SC_MARKS, r, 4))};
    m.name_n = sc_name(m.name[..], ct_str(d[..], SC_MARKS, r, 1));
    c[0].marks[r] = m;
  }
  c[0].mark_n = ct_rows(d[..], SC_MARKS);
  for r: 0..<ct_rows(d[..], SC_PIECES) {
    look := ct_find(d[..], SC_LOOKS, ct_get(d[..], SC_PIECES, r, 4));
    p := ScPiece.{id = ct_get(d[..], SC_PIECES, r, 0), kit = pk_of(ct_str(d[..], SC_PIECES, r, 2)), scale = cast(f32) ct_get(d[..], SC_PIECES, r, 3) / 1000,
                  a = ct_get(d[..], SC_LOOKS, look, 2), b = ct_get(d[..], SC_LOOKS, look, 3), c = ct_get(d[..], SC_LOOKS, look, 4),
                  hx = sc_m(ct_get(d[..], SC_PIECES, r, 5)), hz = sc_m(ct_get(d[..], SC_PIECES, r, 6)), top = sc_m(ct_get(d[..], SC_PIECES, r, 7))};
    p.name_n = sc_name(p.name[..], ct_str(d[..], SC_PIECES, r, 1));
    mesh := pk_mesh(ct_str(d[..], SC_PIECES, r, 2));
    for ch, i: mesh { p.mesh[i] = ch; }
    p.mesh_n = mesh.count;
    c[0].pieces[r] = p;
  }
  c[0].piece_n = ct_rows(d[..], SC_PIECES);
  for r: 0..<ct_rows(d[..], SC_PLANS) {
    p: [1] NplPlan;
    _ := npl_read(ct_get(d[..], SC_PLANS, r, 0), ct_get(d[..], SC_PLANS, r, 1), ct_str(d[..], SC_PLANS, r, 2), ct_str(d[..], SC_PLANS, r, 3), ct_str(d[..], SC_PLANS, r, 4), ct_get(d[..], SC_PLANS, r, 5), ct_get(d[..], SC_PLANS, r, 6), ct_str(d[..], SC_PLANS, r, 7), SC_FOES, p[..]);
    c[0].plans[r] = p[0];
  }
  c[0].clock = -1;
  words := SC_CLOCK_WORD;
  for w, k: words { if ct_str(d[..], SC_CLOCK, 0, 1) == w { c[0].clock = k - 1; } }
  for r: 0..<SC_FOES { c[0].actor_n[r] = sc_name(c[0].actor[r][..], ct_str(d[..], SC_ACTORS, r, 1)); }
  c[0].board = board_row_read(ct_get(d[..], SC_BOARD, 0, 0), ct_str(d[..], SC_BOARD, 0, 1), ct_get(d[..], SC_BOARD, 0, 2), ct_get(d[..], SC_BOARD, 0, 3));
  c[0].script_n = ct_rows(d[..], SC_SCRIPTS);
  for r: 0..<c[0].script_n {
    row: [1] ScriptRow;
    _ := srw_read(ct_get(d[..], SC_SCRIPTS, r, 0), ct_str(d[..], SC_SCRIPTS, r, 1), ct_str(d[..], SC_SCRIPTS, r, 2), ct_str(d[..], SC_SCRIPTS, r, 3), row[..]);
    c[0].scripts[r] = row[0];
  }
  c[0].menu_n = ct_rows(d[..], SC_MENU);
  for r: 0..<c[0].menu_n {
    keys := SC_MENU_KEYS;
    for w, i: keys { if ct_str(d[..], SC_MENU, r, 1) == w { c[0].menu[r] = i + 1; } }
    c[0].menu_label_n[r] = sc_name(c[0].menu_label[r][..], ct_str(d[..], SC_MENU, r, 2));
  }
  c[0].credits = ct_rows(d[..], SC_CREDITS);
  for r: 0..<c[0].credits { c[0].credit_n[r] = sc_name(c[0].credit[r][..], ct_str(d[..], SC_CREDITS, r, 1)); }
  c[0].dolly_n = ct_rows(d[..], SC_DOLLY);
  for r: 0..<c[0].dolly_n { for k: 0..<6 { c[0].dolly[r * 7 + k] = sc_m(ct_get(d[..], SC_DOLLY, r, k + 1)); } c[0].dolly[r * 7 + 6] = cast(f32) ct_get(d[..], SC_DOLLY, r, 7); }
  why: [1] int;
  c[0].portal_n = prt_scan(d[..], SC_PORTALS, c[0].portals[..], why[..]);
  c[0].start_n = ct_rows(d[..], SC_STARTS);
  for r: 0..<c[0].start_n { _ := flw_start_read(ct_get(d[..], SC_STARTS, r, 0), ct_str(d[..], SC_STARTS, r, 1), ct_str(d[..], SC_STARTS, r, 2), ct_get(d[..], SC_STARTS, r, 3), c[0].starts[r..<r + 1]); }
  c[0].beat_n = ct_rows(d[..], SC_BEATS);
  for r: 0..<c[0].beat_n { area := ct_get(d[..], SC_BEATS, r, 1); _ := flw_beat_read(ct_get(d[..], SC_BEATS, r, 0), area, ct_str(d[..], SC_BEATS, r, 2), ct_str(d[..], SC_BEATS, r, 3), true, c[0].beats[r..<r + 1]); }
  c[0].ok = true;
  return true;
}
sc_menu_label :: (c: [] SpContent, r: int) -> string { return ifx r < 0 || r >= c[0].menu_n then "" else cast(string) c[0].menu_label[r][0..<c[0].menu_label_n[r]]; }
sc_credit :: (c: [] SpContent, r: int) -> string { return ifx r < 0 || r >= c[0].credits then "" else cast(string) c[0].credit[r][0..<c[0].credit_n[r]]; }
// The landmark with this ID (rows ascend by ID), or one at the origin with ID 0.
sc_mark :: (c: [] SpContent, id: int) -> ScMark {
  lo := 0; hi := c[0].mark_n;
  while lo < hi { mid := lo + (hi - lo) / 2; if c[0].marks[mid].id < id { lo = mid + 1; } else { hi = mid; } }
  if lo < c[0].mark_n && c[0].marks[lo].id == id { return c[0].marks[lo]; }
  return ScMark.{};
}
// The row of the landmark with this ID, or -1; and a row's name.
sc_mark_row :: (c: [] SpContent, id: int) -> int {
  for r: 0..<c[0].mark_n { if c[0].marks[r].id == id { return r; } }
  return -1;
}
sc_mark_name :: (c: [] SpContent, row: int) -> string { return ifx row < 0 || row >= c[0].mark_n then "" else cast(string) c[0].marks[row].name[0..<c[0].marks[row].name_n]; }
// The row of the piece with this content ID, or -1.
sc_piece :: (c: [] SpContent, id: int) -> int {
  for r: 0..<c[0].piece_n { if c[0].pieces[r].id == id { return r; } }
  return -1;
}
sc_kept_name :: (c: [] SpContent, row: int) -> string { return ifx row < 0 || row >= c[0].kept_n then "" else cast(string) c[0].kept[row].name[0..<c[0].kept[row].name_n]; }
sc_area_name :: (c: [] SpContent, row: int) -> string { return ifx row < 0 || row >= c[0].area_n then "" else cast(string) c[0].areas[row].name[0..<c[0].areas[row].name_n]; }
// The pack mesh a row draws ("": a kit piece).
sc_piece_mesh :: (c: [] SpContent, row: int) -> string { return ifx row < 0 || row >= c[0].piece_n then "" else cast(string) c[0].pieces[row].mesh[0..<c[0].pieces[row].mesh_n]; }
sc_piece_name :: (c: [] SpContent, row: int) -> string { return ifx row < 0 || row >= c[0].piece_n then "" else cast(string) c[0].pieces[row].name[0..<c[0].pieces[row].name_n]; }
// The tables without kept-clear zone `row`: what the mutant check plays against.
sc_drop_kept :: (c: [] SpContent, row: int) {
  if row < 0 || row >= c[0].kept_n { return; }
  for r: row..<c[0].kept_n - 1 { c[0].kept[r] = c[0].kept[r + 1]; }
  c[0].kept_n -= 1;
}

#test "Splice's shipped tables read: areas, kept-clear zones, landmarks and pieces, each by its ID" {
  c: [1] SpContent;
  #assert sc_load(c[..], SC_SHIPPED) && c[0].ok && c[0].rev >= 1;
  #assert c[0].area_n == 4 && c[0].kept_n >= 20 && c[0].mark_n >= 40 && c[0].piece_n >= 15 && c[0].piece_n <= 30;
  rover := sc_mark(c[..], 1);
  #assert rover.id == 1 && sc_mark_name(c[..], sc_mark_row(c[..], 1)) == "Rover" && sc_mark_row(c[..], 19) == -1 && sc_kept_name(c[..], 0) == "Village start" && sc_area_name(c[..], 3) == "Mine" && rover.x == 6 && rover.z == 5 && rover.r == 4.5;
  #assert sc_mark(c[..], 0).id == 0 && sc_mark(c[..], 9999).id == 0 && sc_mark(c[..], 19).id == 0;
  p := sc_piece(c[..], 101);
  #assert p >= 0 && sc_piece_name(c[..], p) == "Parked rover" && c[0].pieces[p].kit == PK_ROVER && c[0].pieces[p].scale == 1.5 && c[0].pieces[p].a == 0xEDE0C2;
  #assert sc_piece(c[..], 100) == -1 && sc_piece_name(c[..], -1) == "";
  n := c[0].kept_n; first := c[0].kept[1].id;
  sc_drop_kept(c[..], 0);
  #assert c[0].kept_n == n - 1 && c[0].kept[0].id == first;
  sc_drop_kept(c[..], 99); #assert c[0].kept_n == n - 1;
}
#test "tables that are not Splice's are refused: a missing table, an unknown kit, a piece with no footprint, an area that is both shapes" {
  c: [1] SpContent; o: [CT_BODY] u8;
  #assert !sc_load(c[..], "aethyr.content.v1 splice 1\nreach 30000\n") && !c[0].ok;
  #assert !sc_load(c[..], sc_swap("|rover|1500|", "|rocket|1500|", o[..]));
  #assert !sc_load(c[..], sc_swap("|rover|1500|1|165|240|375", "|rover|1500|1|0|240|375", o[..]));
  #assert !sc_load(c[..], sc_swap("|rover|1500|1|165|240|375", "|rover|99|1|165|240|375", o[..]));
  #assert !sc_load(c[..], sc_swap("1|Dome village|17500|-7500|0|0|630", "1|Dome village|17500|-7500|10|10|630", o[..]));
  #assert !sc_load(c[..], sc_swap("1|Dome village|17500|-7500|0|0|630", "1|Dome village|17500|-7500|0|0|0", o[..]));
  #assert sc_load(c[..], sc_swap("|rover|1500|1|165|240|375", "|rover|1500|2|165|240|375", o[..]));
}
// SC_SHIPPED with its first `was` replaced by `with`, into out ("" when `was` is not in it).
sc_swap :: (was: string, with: string, out: [] u8) -> string {
  s := SC_SHIPPED;
  for a: 0..<s.count - was.count + 1 {
    if s[a..<a + was.count] != was { continue; }
    n := ct_put(out, 0, s[0..<a]); n = ct_put(out, n, with); n = ct_put(out, n, s[a + was.count..<s.count]);
    return cast(string) out[0..<n];
  }
  return "";
}

// s with its first `was` replaced by `with`, into out ("" when `was` is not in it).
sc_swap2 :: (s: string, was: string, with: string, out: [] u8) -> string {
  for a: 0..<s.count - was.count + 1 {
    if s[a..<a + was.count] != was { continue; }
    n := ct_put(out, 0, s[0..<a]); n = ct_put(out, n, with); n = ct_put(out, n, s[a + was.count..<s.count]);
    return cast(string) out[0..<n];
  }
  return "";
}

ScTemplateTest :: struct { c: [1] SpContent; text: [CT_BODY] u8; }
// The shipped tables with one row more at their end (the templates table is last).
sc_test_with :: (t: [] ScTemplateTest, row: string) -> string {
  n := ct_put(t[0].text[..], 0, SC_SHIPPED); n = ct_put(t[0].text[..], n, row); n = ct_put(t[0].text[..], n, "\n");
  return cast(string) t[0].text[0..<n];
}

#test "a template is a named group of pieces the tables have: parts that are not parts, a piece that is not there, a size and a template with no name are refused" {
  t: [1] ScTemplateTest; c := t[0].c[..];
  #assert sc_load(c, sc_test_with(t[..], "1|Crate stack|116 -50 0 0 100,117 50 0 90 100"));
  #assert !sc_load(c, sc_test_with(t[..], "1|Crate stack|116 -50 0 0")) && !sc_load(c, sc_test_with(t[..], "1|Crate stack|999 0 0 0 100"));
  #assert !sc_load(c, sc_test_with(t[..], "1|Crate stack|116 0 0 0 150")) && !sc_load(c, sc_test_with(t[..], "1||116 0 0 0 100")) && !sc_load(c, sc_test_with(t[..], "1|Crate stack|"));
  #assert sc_load(c, SC_SHIPPED) && c[0].rev == 2;
}

// Foe i's plan (0 to SC_FOES - 1) at time of day `when` (PH_DAWN to PH_NIGHT, npc-plan.coax NPL_WHEN's order).
sc_plan :: (c: [] SpContent, i: int, when: int) -> NplPlan {
  k := i * NPL_WHENS + (ifx when < 0 then 0 else ifx when >= NPL_WHENS then NPL_WHENS - 1 else when);
  return ifx k < 0 || k >= SC_PLAN_MAX then NplPlan.{} else c[0].plans[k];
}

#test "the shipped plans are the run as it always played: raiders dance at their spots, robots patrol their posts, the clock is the story's" {
  c: [1] SpContent;
  #assert sc_load(c[..], SC_SHIPPED) && c[0].clock == -1;
  for i: 0..<SC_FOES { for w: 0..<NPL_WHENS {
    p := sc_plan(c[..], i, w); m := sc_mark(c[..], 41 + i);
    #assert p.ok && p.who == i + 1 && p.when == w && p.x[0] == sc_cm(m.x) && p.z[0] == sc_cm(m.z) && p.speed == 180 && p.on == NPO_CHASE;
    if i < 5 { #assert p.act == NPD_DANCE && p.notice == 0 && p.n == 1; }
    else { t := sc_mark(c[..], 51 + i); #assert p.act == NPD_PATROL && p.notice == 500 && p.n == 2 && p.x[1] == sc_cm(t.x) && p.z[1] == sc_cm(t.z); }
  } }
  #assert !sc_plan(c[..], 9, 0).ok && !sc_plan(c[..], -1, 0).ok && sc_plan(c[..], 0, 7).when == 3 && sc_plan(c[..], 0, -2).when == 0;
}
#test "a plan that leaves the mine, a dropped plan and a clock that is no time of day are refused, each with its words" {
  c: [1] SpContent; o: [CT_BODY] u8; w: [300] u8;
  #assert sc_load(c[..], sc_swap("\n1|story\n", "\n1|dusk\n", o[..])) && c[0].clock == 2;
  #assert sc_load(c[..], sc_swap("\n1|story\n", "\n1|dawn\n", o[..])) && c[0].clock == 0;
  #assert !sc_load(c[..], sc_swap("\n1|story\n", "\n1|noon\n", o[..])) && sc_plans_words(sc_swap("\n1|story\n", "\n1|noon\n", o[..]), w[..]) == "the clock's row 1 is story, dawn, day, dusk or night";
  bad := sc_swap("62|6|dusk|patrol|850 -4500, 850 -5700|", "62|6|dusk|patrol|17500 -6700, 850 -5700|", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "plan 62: a foe's route stays in the mine (x -4400 to 4400, z -8200 to 2000 centimetres) or an area added after it (ID 5 and up); the dome village, the gate corridor and the rail stop are stages of their own, with no foes in them";
  // an area added after the mine is ground the foes walk too: a box, or a circle
  far := sc_swap("62|6|dusk|patrol|850 -4500, 850 -5700|", "62|6|dusk|patrol|850 -4500, 1500 4000|", o[..]);
  #assert !sc_load(c[..], far);
  w2: [CT_BODY] u8; desert := sc_swap2(far, "4|Mine|0|-3100|4400|5100|0\n", "4|Mine|0|-3100|4400|5100|0\n5|Desert|0|5000|3000|3000|0\n", w2[..]);
  #assert sc_load(c[..], desert) && sc_plan(c[..], 5, 2).z[1] == 4000;
  w3: [CT_BODY] u8; round := sc_swap2(far, "4|Mine|0|-3100|4400|5100|0\n", "4|Mine|0|-3100|4400|5100|0\n5|Solar farm|1500|4000|0|0|500\n", w3[..]);
  #assert sc_load(c[..], round);
  w4: [CT_BODY] u8; edge := sc_swap2(far, "4|Mine|0|-3100|4400|5100|0\n", "4|Mine|0|-3100|4400|5100|0\n5|Solar farm|1500|4500|0|0|499\n", w4[..]);
  #assert !sc_load(c[..], edge);
  bad = sc_swap("62|6|dusk|patrol|", "62|6|dusk|fly|", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "plan 62: DO is stand, dance, sleep, guard, patrol, wander or follow";
  bad = sc_swap("62|6|dusk|patrol|850 -4500, 850 -5700|180|500|chase\n", "", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "every foe keeps a plan for dawn, day, dusk and night: set a plan's cells, never drop its row";
  good := sc_swap("62|6|dusk|patrol|850 -4500, 850 -5700|180|500|chase", "62|6|dusk|guard|0 -3700, 0 -3000|0|800|call", o[..]);
  #assert sc_load(c[..], good) && sc_plan(c[..], 5, 2).act == NPD_GUARD && sc_plans_words(good, w[..]) == "" && sc_plans_words("oops", w[..]) == "";
}
#test "tables saved before the actors, the plans and the clock read with the shipped ones put in" {
  c: [1] SpContent; o: [CT_BODY] u8; up: [CT_BODY] u8; t: [CT_BODY] u8;
  // the revision-2 tables as they were saved: no clock, no plans
  old := sc_swap(sc_shipped_table(SC_SHIPPED, "clock"), "", o[..]);
  n := ct_put(t[..], 0, old); old = cast(string) t[0..<n];
  old = sc_cut(old, sc_shipped_table(SC_SHIPPED, "plans"), o[..]);
  n = ct_put(t[..], 0, old); old = cast(string) t[0..<n];
  old = sc_cut(old, sc_shipped_table(SC_SHIPPED, "actors"), o[..]);
  #assert old.count < SC_SHIPPED.count && sc_upgrade(old, up[..]) == SC_SHIPPED && sc_load(c[..], old) && c[0].plans[0].ok && c[0].clock == -1;
  nm := c[0].actor[5];
  #assert cast(string) nm[0..<c[0].actor_n[5]] == "Imperial 1";
  // tables saved after the plans came and before the actors did: only the actors are put in
  later := sc_cut(SC_SHIPPED, sc_shipped_table(SC_SHIPPED, "actors"), o[..]);
  #assert later.count < SC_SHIPPED.count && sc_upgrade(later, up[..]) == SC_SHIPPED;
  // the actors renamed: kept; one dropped: refused, in words
  #assert sc_load(c[..], sc_swap("\n6|Imperial 1\n", "\n6|Sergeant Bolt\n", o[..])) && cast(string) c[0].actor[5][0..<c[0].actor_n[5]] == "Sergeant Bolt";
  w: [300] u8; bad := sc_swap("\n6|Imperial 1\n", "\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the actors table names foes 1 to 9, one row each: rename one, never drop or add a row";
  bad = sc_swap("\n9|Imperial 4\n", "\n9|Imperial 4\n10|Imperial 5\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the actors table names foes 1 to 9, one row each: rename one, never drop or add a row";
  #assert sc_upgrade(SC_SHIPPED, up[..]) == SC_SHIPPED && sc_upgrade("", up[..]) == "";
  #assert sc_shipped_table(SC_SHIPPED, "templates") == "table templates id name:text parts:text\n" && sc_shipped_table(SC_SHIPPED, "nope") == "";
  // tables saved before the scripts table came (#13467): it is put in, empty, after the plans; alone, or with the plans missing too
  before := sc_cut(SC_SHIPPED, sc_shipped_table(SC_SHIPPED, "scripts"), o[..]);
  #assert before.count < SC_SHIPPED.count && sc_upgrade(before, up[..]) == SC_SHIPPED && sc_load(c[..], before) && c[0].script_n == 0;
  n = ct_put(t[..], 0, before); before = cast(string) t[0..<n];
  before = sc_cut(before, sc_shipped_table(SC_SHIPPED, "plans"), o[..]);
  #assert sc_upgrade(before, up[..]) == SC_SHIPPED;
}
#test "the board's row: off as shipped, on with two speeds, and a row that does not hold is refused in words; tables saved before it get it" {
  c: [1] SpContent; o: [CT_BODY] u8; w: [300] u8; up: [CT_BODY] u8;
  #assert sc_load(c[..], SC_SHIPPED) && c[0].board.ok && !c[0].board.on && c[0].board.casual == BOARD_CASUAL && c[0].board.fast == BOARD_FAST;
  on := sc_swap("\n1|off|700|2200\n", "\n1|on|900|2600\n", o[..]);
  #assert sc_load(c[..], on) && c[0].board.on && c[0].board.casual == 900 && c[0].board.fast == 2600;
  bad := sc_swap("\n1|off|700|2200\n", "\n1|on|900|800\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the very fast speed is faster than the casual one, and at most 6000 centimetres a second";
  bad = sc_swap("\n1|off|700|2200\n", "\n1|maybe|900|2600\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the board is on or off";
  bad = sc_swap("\n1|off|700|2200\n", "\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the board table has one row, row 1";
  before := sc_cut(SC_SHIPPED, sc_shipped_table(SC_SHIPPED, "board"), o[..]);
  #assert before.count < SC_SHIPPED.count && sc_upgrade(before, up[..]) == SC_SHIPPED && sc_load(c[..], before) && c[0].board.ok && !c[0].board.on;
}
#test "a script row names a module by its hash and whom it drives; a row that does not read is refused in words" {
  c: [1] SpContent; o: [CT_BODY] u8; w: [300] u8;
  head := "table scripts id name:text hash:text for:text\n";
  one := "table scripts id name:text hash:text for:text\n1|splice-raider|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|kind 1\n2|scout|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|who 9\n";
  good := sc_swap(head, one, o[..]);
  #assert sc_load(c[..], good) && c[0].script_n == 2 && c[0].scripts[0].ok && c[0].scripts[0].by_kind && c[0].scripts[0].n == 1 && c[0].scripts[1].slot == 1 && !c[0].scripts[1].by_kind;
  #assert srw_pick(c[0].scripts[0..<c[0].script_n], 1, 3) == 0 && srw_pick(c[0].scripts[0..<c[0].script_n], 2, 9) == 1 && srw_pick(c[0].scripts[0..<c[0].script_n], 2, 6) == -1;
  bad := sc_swap(head, "table scripts id name:text hash:text for:text\n1|splice-raider|528d|kind 1\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "script 1: a script's HASH is its module's SHA-256: 64 lowercase hex digits";
  bad = sc_swap(head, "table scripts id name:text hash:text for:text\n9|a|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|kind 1\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "script 9: a script's ID is 1 to 8: a world runs at most 8 scripts";
  bad = sc_swap(head, "table scripts id name:text hash:text for:text\n1|a|528d98a6985890f0d3d78e3df31bffa680719ea61722e87d80c6e16166c437a5|who 10\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "script 1: FOR names a foe the world has: who 1 to 9";
  #assert sc_load(c[..], SC_SHIPPED) && c[0].script_n == 0;
}
// s with its first `was` taken out, into out.
sc_cut :: (s: string, was: string, out: [] u8) -> string {
  for a: 0..<s.count - was.count + 1 {
    if s[a..<a + was.count] != was { continue; }
    n := ct_put(out, 0, s[0..<a]); n = ct_put(out, n, s[a + was.count..<s.count]);
    return cast(string) out[0..<n];
  }
  return s;
}
sc_cm :: (m: f32) -> int { return cast(int) floor(m * 100 + 0.5); }
#test "the front screens' tables read, tables saved before them read with the shipped ones put in, and a bad row is refused in words" #steps 100000000 {
  c: [1] SpContent; o: [CT_BODY] u8; up: [CT_BODY] u8; t: [CT_BODY] u8; w: [300] u8;
  #assert sc_load(c[..], SC_SHIPPED) && c[0].menu_n == 3 && c[0].menu[0] == 1 && c[0].menu[1] == 2 && c[0].menu[2] == 3 && sc_menu_label(c[..], 1) == "NEW RUN" && sc_menu_label(c[..], 9) == "";
  #assert c[0].credits >= 3 && sc_credit(c[..], 0).count > 0 && sc_credit(c[..], -1) == "" && c[0].dolly_n >= 1 && c[0].dolly[6] >= 1;
  // saved before the three came: each put in where it sorts
  old := sc_cut(SC_SHIPPED, sc_shipped_table(SC_SHIPPED, "menu"), o[..]);
  n := ct_put(t[..], 0, old); old = cast(string) t[0..<n];
  old = sc_cut(old, sc_shipped_table(SC_SHIPPED, "credits"), o[..]);
  n = ct_put(t[..], 0, old); old = cast(string) t[0..<n];
  old = sc_cut(old, sc_shipped_table(SC_SHIPPED, "dolly"), o[..]);
  #assert old.count < SC_SHIPPED.count && sc_upgrade_front(old, up[..]) == SC_SHIPPED && sc_load(c[..], old) && c[0].menu_n == 3;
  // and saved before the clock and the plans too
  n = ct_put(t[..], 0, old); old = cast(string) t[0..<n];
  old = sc_cut(old, sc_shipped_table(SC_SHIPPED, "clock"), o[..]);
  #assert sc_load(c[..], old) && c[0].clock == -1 && c[0].dolly_n >= 1;
  #assert sc_upgrade_front(SC_SHIPPED, up[..]) == SC_SHIPPED && sc_upgrade_front("", up[..]) == "" && sc_upgrade_front("nope", up[..]) == "nope";
  #assert sc_after("menu", "dolly") && !sc_after("dolly", "menu") && sc_after("menus", "menu") && !sc_after("menu", "menu");
  // a menu reordered and relabelled reads; one without NEW RUN, with a key twice or a key it doesn't know is refused
  good := sc_swap("1|continue|CONTINUE\n2|new|NEW RUN\n", "1|new|START\n2|continue|CONTINUE\n", o[..]);
  #assert sc_load(c[..], good) && c[0].menu[0] == 2 && sc_menu_label(c[..], 0) == "START";
  bad := sc_swap("2|new|NEW RUN\n", "2|credits|NEW RUN\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the menu's rows are continue, new and credits, each at most once and new always, each with a label of 1 to 48 bytes";
  #assert !sc_load(c[..], sc_swap("2|new|NEW RUN\n", "2|settings|NEW RUN\n", o[..])) && !sc_load(c[..], sc_swap("2|new|NEW RUN\n", "2|new|\n", o[..]));
  bad = sc_swap("|0|150|0|12\n", "|0|150|0|0\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the title camera's path has 1 to 8 rows, each taking 1 second or more";
  bad = sc_swap("2|BY OPENAGENTS\n", "2|BY OPENAGENTS, AND A LINE LONGER THAN THE SCREEN TAKES\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "the credits are at most 12 lines of at most 48 bytes";
}

#test "portals, starts and beats read from their tables; a row that does not read, or names what the tables lack, is refused in words" {
  c: [1] SpContent; o: [CT_BODY] u8; w: [300] u8;
  #assert sc_load(c[..], SC_SHIPPED) && c[0].portal_n == 0 && c[0].start_n == 0 && c[0].beat_n == 0;
  ph := "table portals id name:text from:text to:text yaw:int r:int\n";
  good := sc_swap(ph, "table portals id name:text from:text to:text yaw:int r:int\n1|Enter the rover|kind 101|-9000 25000|180|600\n2|Leave the rover|at -9000 24600|1200 3000|0|100\n", o[..]);
  #assert sc_load(c[..], good) && c[0].portal_n == 2 && c[0].portals[0].kind == 101 && c[0].portals[1].x == -9000 && prt_name(c[0].portals[..], 0) == "Enter the rover";
  bad := sc_swap(ph, "table portals id name:text from:text to:text yaw:int r:int\n1|Enter|kind 999|0 0|0|600\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "portal 1: FROM names a kind the pieces table has";
  bad = sc_swap(ph, "table portals id name:text from:text to:text yaw:int r:int\n1|Enter|kind 101|0 0|0|5000\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "portal 1: R is how near FROM counts: 50 to 1000 centimetres";
  sh := "table starts id when:text at:text yaw:int\n";
  good = sc_swap(sh, "table starts id when:text at:text yaw:int\n1|day|1500 3500|180\n", o[..]);
  #assert sc_load(c[..], good) && c[0].start_n == 1 && c[0].starts[0].when == 1 && c[0].starts[0].x == 1500 && flw_first(c[0].starts[..], c[0].start_n) == 0;
  bad = sc_swap(sh, "table starts id when:text at:text yaw:int\n1|noon|1500 3500|180\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "start 1: a time of day is dawn, day, dusk or night";
  bh := "table beats id area:int from:text to:text\n";
  good = sc_swap(bh, "table beats id area:int from:text to:text\n1|4|day|dusk\n", o[..]);
  #assert sc_load(c[..], good) && c[0].beat_n == 1 && c[0].beats[0].area == 4 && c[0].beats[0].to == 2;
  bad = sc_swap(bh, "table beats id area:int from:text to:text\n1|9|day|dusk\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "beat 1: AREA is the ID of one of the world's areas";
  bad = sc_swap(bh, "table beats id area:int from:text to:text\n1|4|night|dusk\n", o[..]);
  #assert !sc_load(c[..], bad) && sc_plans_words(bad, w[..]) == "beat 1: a beat moves the day on: TO comes after FROM (dawn, day, dusk, night)";
}
#test "tables saved before the portals, starts and beats read with them put in, empty, where they sort" {
  c: [1] SpContent; o: [CT_BODY] u8; up: [CT_BODY] u8; t: [CT_BODY] u8;
  old := sc_cut(SC_SHIPPED, sc_shipped_table(SC_SHIPPED, "portals"), o[..]);
  n := ct_put(t[..], 0, old); old = cast(string) t[0..<n];
  old = sc_cut(old, sc_shipped_table(SC_SHIPPED, "starts"), o[..]);
  n = ct_put(t[..], 0, old); old = cast(string) t[0..<n];
  old = sc_cut(old, sc_shipped_table(SC_SHIPPED, "beats"), o[..]);
  #assert old.count < SC_SHIPPED.count && sc_upgrade(old, up[..]) == SC_SHIPPED && sc_load(c[..], old) && c[0].portal_n == 0;
  // a table Splice does not have: the text is left as it was, and does not load
  odd := sc_swap("table templates id name:text parts:text\n", "table templates id name:text parts:text\ntable zebras id name:text\n", o[..]);
  n = ct_put(t[..], 0, odd); odd = cast(string) t[0..<n];
  odd = sc_cut(odd, sc_shipped_table(SC_SHIPPED, "beats"), o[..]);
  #assert sc_upgrade(odd, up[..]) == odd && !sc_load(c[..], odd);
}
