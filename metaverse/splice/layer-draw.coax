// How Splice's edit layer is drawn (GitHub #13404; AAA P6.1, a retained scene): each kind of
// piece's cel mesh is written once into the piece store and stays on the GPU, and a placed piece
// is one row of the place store: where it stands and its turn. The page draws a kind's instances
// in one draw (splice.coax, gpu/splice.coax's scene_vs). An edit writes rows; it never writes the
// designed world's store, and it never writes a mesh again.
//   coax/bin/coax test metaverse/splice/splice-game.coax
SD_ROW :: 8;            // words a placed piece: x, y, z, 0, cos turn, sin turn, 0, 0 (f32 bits)
SD_BASE :: 2;           // a placed piece's instance number is SD_BASE + its row: 0 and 1 are the world's and the live store's
SD_PIECE_WORDS :: 40000 * VERTEX_WORDS;   // the piece store: every kind's mesh
SD_PLACE_WORDS :: SL_ITEMS * SD_ROW;      // the place store

SpLayerDraw :: struct {
  first: [SC_PIECE_MAX] int; count: [SC_PIECE_MAX] int;   // each kind's vertices in the piece store, by its row of the pieces table
  mesh_n: int;            // vertices in the piece store
  mesh_gen: int;          // counts the piece store's writes: once, and again when the graybox is switched
  meshed: bool; meshed_gray: bool; over: bool;
  meshed_pack: int;       // the import pack the meshes were written from (pieces.coax SpImports gen)
  row0: [SC_PIECE_MAX] int; rows: [SC_PIECE_MAX] int;     // each kind's rows in the place store
  place_n: int;           // rows in the place store
  place_rev: int = -1;    // the layer revision the rows were written from
  place_shown: int = -1;  // and the count of arrival steps (layer.coax sl_rise): a rising piece's row is written each frame
  place_gen: int;         // counts the place store's writes
}

// Every kind's mesh into the piece store, standing at the origin and facing +z. It writes only
// when nothing is written yet, the graybox was switched or the world's import pack changed.
// pack: the world's import pack ("": none), which a kind whose kit is a pack mesh draws from; a
// mesh the pack does not have draws nothing until it does.
sd_meshes :: (d: [] SpLayerDraw, g: [] SpGame, pieces: [] u32, pack: string) {
  if d[0].meshed && d[0].meshed_gray == g[0].gray && d[0].meshed_pack == g[0].imp[0].gen { return; }
  c := g[0].c[..];
  pen := [1] Pen.[Pen.{graybox = g[0].gray}];
  for r: 0..<c[0].piece_n {
    p := c[0].pieces[r];
    d[0].first[r] = pen[0].n;
    if p.kit == PK_MESH { _ := sp_mesh_write(pieces, pen[..], pack, sc_piece_mesh(c, r), p.scale, PIECE_OBJ + (r % 8) * 8, sp_tint(p.a)); }
    else { sp_piece_write(pieces, pen[..], p.kit, p.scale, frame_at(v3(0, 0, 0), 0), PIECE_OBJ + (r % 8) * 8, sp_tint(p.a), sp_tint(p.b), sp_tint(p.c), INK()); }
    d[0].count[r] = pen[0].n - d[0].first[r];
  }
  d[0].mesh_n = pen[0].n; d[0].over = pen[0].over;
  d[0].meshed = true; d[0].meshed_gray = g[0].gray; d[0].meshed_pack = g[0].imp[0].gen; d[0].mesh_gen += 1;
}
// The layer's placed pieces into the place store, a kind's rows together, by item ID within a
// kind. It writes only when the layer's revision is not the one the rows were written from.
sd_places :: (d: [] SpLayerDraw, g: [] SpGame, places: [] u32) {
  if d[0].place_rev == g[0].layer[0].rev && d[0].place_shown == g[0].layer[0].shown { return; }
  c := g[0].c[..]; n := 0;
  for r: 0..<c[0].piece_n {
    d[0].row0[r] = n;
    for i: 0..<g[0].layer[0].st[0].n {
      item := g[0].layer[0].items[i];
      if item.mesh != c[0].pieces[r].id || (n + 1) * SD_ROW > places.count { continue; }
      o := n * SD_ROW;
      places[o] = f32_bits(item.x); places[o + 1] = f32_bits(item.y - sl_sunk(g, item.id, c[0].pieces[r].top)); places[o + 2] = f32_bits(item.z); places[o + 3] = 0;
      places[o + 4] = f32_bits(cos(item.yaw)); places[o + 5] = f32_bits(sin(item.yaw)); places[o + 6] = 0; places[o + 7] = 0;
      n += 1;
    }
    d[0].rows[r] = n - d[0].row0[r];
  }
  d[0].place_n = n; d[0].place_rev = g[0].layer[0].rev; d[0].place_shown = g[0].layer[0].shown; d[0].place_gen += 1;
}
// The layer's draws into `draws` from record `at` (four words a record: first vertex, vertices,
// the store's flag and the first instance, instances): one for each kind that has a placed piece.
// How many records there are now.
sd_draws :: (d: [] SpLayerDraw, g: [] SpGame, draws: [] u32, at: int) -> int {
  n := at;
  for r: 0..<g[0].c[0].piece_n {
    if d[0].rows[r] == 0 || d[0].count[r] == 0 || (n + 1) * 4 > draws.count { continue; }
    draws[n * 4] = cast(u32) d[0].first[r]; draws[n * 4 + 1] = cast(u32) d[0].count[r];
    draws[n * 4 + 2] = 0x80000000 | cast(u32) (SD_BASE + d[0].row0[r]); draws[n * 4 + 3] = cast(u32) d[0].rows[r];
    n += 1;
  }
  return n;
}
// Where the shader puts a mesh's point for a row of the place store (gpu/splice.coax sp_place has
// the same lines): turned about y, then moved. A piece's own +z is (sin turn, cos turn).
sd_apply :: (p: Point, row: [] u32) -> Point {
  c := f32_from_bits(row[4]); s := f32_from_bits(row[5]);
  return v3(p.x * c + p.z * s + f32_from_bits(row[0]), p.y + f32_from_bits(row[1]), p.z * c - p.x * s + f32_from_bits(row[2]));
}
