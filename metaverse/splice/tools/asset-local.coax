// A world's imported assets on this computer (GitHub #13420, the browser editor's E11): what
// `coax serve` answers for /api/worlds/splice/assets... on the dev server, so the editor imports
// a dropped file before anything is deployed. The file is packed by the editor's importer
// (metaverse-engine/editor/pack-import.coax) under Splice's limits (pieces.coax sp_import_limits),
// and the pack and the dropped file are kept by content hash (asset-store.coax). Everyone on
// this computer is the admin: the dev server listens on 127.0.0.1 only.
//
//   coax/web/tool.sh metaverse/splice/tools/asset-local.coax DIR METHOD URL [BODY_FILE]
//   GET  /api/worlds/splice/assets          the world's assets and the limits (world.assets.v1)
//   GET  /api/worlds/splice/assets/pack     the import pack's bytes (404: it has imported nothing)
//   POST /api/worlds/splice/assets          an import (world.asset.import.v1: a line, then the
//                                           file's bytes): the list again, with what it did
// It prints the status, a newline, and the answer's bytes, and exits 0 when it answered. A
// refused import is 422 with the words ({"error":WORDS}), and nothing is kept. A mesh that
// replaces one the world has pieces of must fit where they stand (world-api.coax
// splice_world_mesh_fits): its kind's row is tried with the new bounds first.
// tool.sh: stack-gib 1
#import "Basic";
#load "../world-api.coax";
#load "../../../metaverse-engine/editor/pack-import.coax";
#load "../../../metaverse-engine/editor/asset-wire.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/args.coax";
#load "asset-store.coax";

AL_BODY :: SP_IMPORT_FILE * 2 + 512;   // a body is read past the file limit, so an oversize file is refused in words
AL_NODES :: 32768;
AlWork :: struct {
  body: [AL_BODY + 1] u8; old: [SP_IMPORT_PACK] u8; out: [SP_IMPORT_PACK] u8;
  vertices: [SP_IMPORT_PACK] u8; indices: [SP_IMPORT_PACK] u8; catalog: [16384] u8; nodes: [AL_NODES] JvNode; hash: [64] u8;
  answer: [WAS_BYTES] u8; words: [600] u8;
  doc: [SPW_DOC] u8; tables: [SPW_TABLES] u8;   // the world as it stands (world-local.coax's files), for a replaced mesh
}
al_say :: (status: int, body: string) -> int { print("%\n%", status, body); return 0; }
al_refuse :: (w: [] AlWork, status: int, words: string) -> int { return al_say(status, we_refusal_write(words, -1, w[0].words[..])); }
// The world's assets as a list, into the answer: the pack's own account, each asset with the file it came from.
al_list :: (w: [] AlWork, id: string, pack: string, did: [] PiDid) -> string {
  lim := sp_import_limits(); o := w[0].answer[..];
  p: [1] PiPack; r: [1] PackRead; why: [1] string; hb: [64] u8;
  if !pi_open(pack, p[..], r[..], why[..]) { return ""; }
  hash := ifx pack.count > 0 && asset_hex(asset_id(pack), hb[..]) then cast(string) hb[..] else "";
  n := was_begin(o, id, hash, pack.count, lim);
  for k: 0..<PIP_LICENCES { n = was_add_licence(o, n, k, PIP_LICENCE[k]); }
  for kind: PIP_MESH..<PIP_SOUND + 1 {
    count := ifx kind == PIP_MESH then p[0].mesh_n else ifx kind == PIP_TEXTURE then p[0].texture_n else p[0].sound_n;
    for k: 0..<count {
      name := ifx kind == PIP_MESH then p[0].meshes[k].name else ifx kind == PIP_TEXTURE then p[0].textures[k].name else p[0].sounds[k].name;
      source := ifx kind == PIP_MESH then p[0].meshes[k].source else ifx kind == PIP_TEXTURE then p[0].textures[k].source else p[0].sounds[k].source;
      from := pi_origin(p[..], kind, name);
      if from < 0 { return ""; }
      m := p[0].meshes[ifx kind == PIP_MESH then k else 0];
      n = was_add(o, n, kind, name, source, p[0].origins[from].bytes, pi_bytes(p[..], kind, k), p[0].origins[from].hash,
                 ifx kind == PIP_MESH then pi_reach(m, 0) else 0, ifx kind == PIP_MESH then pi_reach(m, 2) else 0, ifx kind == PIP_MESH then pi_reach(m, 1) else 0);
    }
  }
  if did.count > 0 && did[0].ok { n = was_add_did(o, n, did[0].kind, cast(string) did[0].name[0..<did[0].name_n], did[0].replaced); }
  return ifx n > o.count then "" else cast(string) o[0..<n];
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 3 || args_count(a[..]) > 4 { tool_errln("usage: asset-local DIR METHOD URL [BODY_FILE]"); return 2; }
  w := [1] AlWork.[AlWork.{}];
  dir := args_at(a[..], 0); method := args_at(a[..], 1); url := args_at(a[..], 2);
  root := "/api/worlds/";
  if dir.count == 0 || url.count <= root.count || url[0..<root.count] != root { return al_refuse(w[..], 404, "not found"); }
  rest := url[root.count..<url.count];
  path := ct_part(rest, '?', 0);
  id := ct_part(path, '/', 0); tail := path[id.count..<path.count];
  if id != SPW_ID || (tail != "/assets" && tail != "/assets/pack") || (method != "GET" && method != "POST") || (method == "POST" && tail != "/assets") { return al_refuse(w[..], 404, "no such world"); }
  ok := fs_mkdir(dir);
  old := as_pack(dir, id, w[0].old[..]);
  none: [1] PiDid;
  if method == "GET" && tail == "/assets/pack" {
    if old.count == 0 { return al_refuse(w[..], 404, "this world has imported nothing"); }
    return al_say(200, old);
  }
  if method == "GET" {
    list := al_list(w[..], id, old, none[..]);
    return ifx list.count == 0 then al_refuse(w[..], 500, "not read") else al_say(200, list);
  }
  sent := ifx args_count(a[..]) == 4 then fs_size(args_at(a[..], 3)) else 0;
  if sent > AL_BODY {
    // too large to read at all: said with the limit, as the importer says it of a file it read
    o := w[0].answer[..]; k := pi_put(o, 0, "That file is "); k = pi_put_int(o, k, pi_kb(sent)); k = pi_put(o, k, " KB. A file can be "); k = pi_put_int(o, k, pi_kb(SP_IMPORT_FILE)); k = pi_put(o, k, " KB at most.");
    return al_refuse(w[..], 422, cast(string) o[0..<k]);
  }
  n := ifx args_count(a[..]) == 4 then fs_read(args_at(a[..], 3), w[0].body[..]) else 0;
  head := was_import_read(cast(string) w[0].body[0..<ifx n < 0 then 0 else n]);
  if !head.ok { return al_refuse(w[..], 400, "send a world.asset.import.v1 body: a line that names the licence and the file, then the file's bytes"); }
  did: [1] PiDid;
  room := PiRoom.{vertices = w[0].vertices[..], indices = w[0].indices[..], catalog = w[0].catalog[..], nodes = w[0].nodes[..], hash = w[0].hash[..]};
  file := PiFile.{name = head.name, data = w[0].body[head.at..<n], licence = head.licence};
  made := pi_import(old, id, file, sp_import_limits(), room, w[0].out[..], did[..]);
  if made < 0 { return al_refuse(w[..], 422, pi_why(did[..])); }
  pack := cast(string) w[0].out[0..<made];
  // a mesh replaced where the world has pieces of it: its new shape must fit where they stand, or nothing changes
  if did[0].ok && did[0].kind == PIP_MESH && did[0].replaced {
    pb: [AS_PATH] u8; why: [240] u8; wn: [1] int; m := [1] PiMesh.[PiMesh.{lo = did[0].lo, hi = did[0].hi}];
    dn := fs_read(as_path(dir, id, ".dev", "", pb[..]), w[0].doc[..]);
    if dn <= 0 { dn = splice_world_empty(w[0].doc[..]); }
    tn := fs_read(as_path(dir, id, ".dev.tables", "", pb[..]), w[0].tables[..]);
    if !splice_world_mesh_fits(cast(string) w[0].doc[0..<ifx dn < 0 then 0 else dn], cast(string) w[0].tables[0..<ifx tn < 0 then 0 else tn], pack, cast(string) did[0].name[0..<did[0].name_n],
                               pi_reach(m[0], 0), pi_reach(m[0], 2), pi_reach(m[0], 1), why[..], wn[..]) {
      o := w[0].answer[..]; k := pi_put_name(o, 0, head.name); k = pi_put(o, k, " does not fit where its kind already stands: "); k = pi_put(o, k, cast(string) why[0..<wn[0]]); k = pi_put(o, k, ". Move or remove that piece, then import it again.");
      return al_refuse(w[..], 422, ifx k > o.count then "That mesh does not fit where its kind already stands." else cast(string) o[0..<k]);
    }
  }
  hb: [64] u8; fb: [64] u8;
  kept := as_keep(dir, id, ".pack.", pack, hb[..]);
  if kept.count == 0 || as_keep(dir, id, ".file.", cast(string) file.data, fb[..]).count == 0 || !as_point(dir, id, kept) { return al_refuse(w[..], 500, "not saved"); }
  list := al_list(w[..], id, pack, did[..]);
  return ifx list.count == 0 then al_refuse(w[..], 500, "not read") else al_say(200, list);
}
