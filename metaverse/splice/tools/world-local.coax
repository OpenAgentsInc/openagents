// A world's routes on this computer, with files for rows (GitHub #13413, the browser editor's E4):
// what `coax serve` answers for /api/worlds/splice... on the dev server, so a page, a second tab,
// the CLI and `coax drive` reach one world before anything is deployed. It is the API's route
// (coax/web/api/worlds.c) with the same Coax: the routes' rules are world-policy.coax's, an edit is
// carried out by Splice's own code (world.coax spw_batch), and every byte is world-edit.coax's.
// Only where the rows live differs: files under DIR, one world a prefix.
//   DIR/ID.row            the row's numbers, a line
//   DIR/ID.dev .live .prev    the lanes' documents
//   DIR/ID.step.N.did .inv    the undo log's steps
//   DIR/ID.dev.events .live.events   the lanes' events, a line each
// Everyone on this computer is the admin: the dev server listens on 127.0.0.1 only.
//
//   coax/web/tool.sh metaverse/splice/tools/world-local.coax DIR METHOD URL [BODY_FILE]
// It prints the status, a newline, and the answer's bytes (the routes' own: world.state.v1, a
// refusal, or event lines), and exits 0 when it answered.
// tool.sh: run-steps 250000000
#import "Basic";
#load "../world-api.coax";
#load "../../../coax/web/api/world-policy.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
cxproc_wall_us :: () -> int #foreign #effects(all);

WL_ROW :: 15;   // dev_rev done steps live_rev live_from live_when live pins (4) prev_rev prev pins (4)
R_DEV :: 0; R_DONE :: 1; R_STEPS :: 2; R_LIVE :: 3; R_FROM :: 4; R_WHEN :: 5; R_LIVE_PINS :: 6; R_PREV :: 10; R_PREV_PINS :: 11;
WlLocal :: struct {
  dir: [512] u8; dir_n: int; id: [WE_WORLD] u8; id_n: int;
  row: [WL_ROW] int;
  path: [700] u8;
  doc: [SPW_DOC] u8; out_doc: [SPW_DOC] u8; did: [WE_BATCH_BODY] u8; inv: [WE_BATCH_BODY] u8; body: [WE_BATCH_BODY] u8; step: [WE_BATCH_BODY] u8;
  answer: [SPW_DOC * 2 + WE_BATCH_BODY] u8; events: [262144] u8;
}
wl_id :: (t: [] WlLocal) -> string { return cast(string) t[0].id[0..<t[0].id_n]; }
// DIR/ID then the parts, in t's path buffer.
wl_path :: (t: [] WlLocal, a: string, n: int, b: string) -> string {
  k := ct_put(t[0].path[..], 0, cast(string) t[0].dir[0..<t[0].dir_n]); k = ct_put(t[0].path[..], k, "/"); k = ct_put(t[0].path[..], k, wl_id(t)); k = ct_put(t[0].path[..], k, a);
  if n >= 0 { k = wd_put_int(t[0].path[..], k, n); }
  k = ct_put(t[0].path[..], k, b);
  return ifx k > t[0].path.count then "" else cast(string) t[0].path[0..<k];
}
wl_row_read :: (t: [] WlLocal) {
  for k: 0..<WL_ROW { t[0].row[k] = 0; }
  t[0].row[R_FROM] = -1;
  b: [512] u8; n := fs_read(wl_path(t, ".row", -1, ""), b[..]);
  if n <= 0 { return; }
  line := ct_part(cast(string) b[0..<n], '\n', 0);
  if ct_parts(line, ' ') != WL_ROW { return; }
  for k: 0..<WL_ROW { v := wd_num(ct_part(line, ' ', k)); if v.ok { t[0].row[k] = v.v; } }
}
wl_row_write :: (t: [] WlLocal) -> bool {
  b: [512] u8; n := 0;
  for k: 0..<WL_ROW { if k > 0 { n = ct_put(b[..], n, " "); } n = wd_put_int(b[..], n, t[0].row[k]); }
  n = ct_put(b[..], n, "\n");
  return n <= b.count && fs_write(wl_path(t, ".row", -1, ""), cast(string) b[0..<n]);
}
// A lane's document as kept, or Splice with nothing placed.
wl_doc :: (t: [] WlLocal, lane: string) -> string {
  n := fs_read(wl_path(t, lane, -1, ""), t[0].doc[..]);
  if n > 0 { return cast(string) t[0].doc[0..<n]; }
  n = splice_world_empty(t[0].doc[..]);
  return ifx n > 0 then cast(string) t[0].doc[0..<n] else "";
}
wl_say :: (status: int, body: string) -> int { print("%\n%", status, body); return 0; }
wl_refuse :: (t: [] WlLocal, status: int, words: string, edit: int) -> int {
  n := wr_refusal(words, edit, t[0].answer[..]);
  return wl_say(status, cast(string) t[0].answer[0..<ifx n < 0 then 0 else n]);
}
wl_state :: (t: [] WlLocal, lane: int, rev: int, pins: [] int, doc: string, did: string) -> int {
  r := t[0].row[..];
  n := wr_state(wl_id(t), lane, rev, pins[0], pins[1], pins[2], pins[3], r[R_DEV], r[R_LIVE], r[R_WHEN], r[R_DONE], r[R_STEPS] - r[R_DONE], doc, did, t[0].answer[..]);
  if n < 0 { return wl_refuse(t, 500, "not written", -1); }
  return wl_say(200, cast(string) t[0].answer[0..<n]);
}
// A query's value ("" when it has none): a=1&b=2.
wl_query :: (query: string, name: string) -> string {
  for k: 0..<ct_parts(query, '&') {
    part := ct_part(query, '&', k);
    if ct_part(part, '=', 0) == name && ct_parts(part, '=') == 2 { return ct_part(part, '=', 1); }
  }
  return "";
}
wl_get :: (t: [] WlLocal, query: string) -> int {
  r := t[0].row[..]; mine: [4] int; here: [4] int; sent := true;
  names := [4] string.["engine", "rules", "content", "wire"];
  for k: 0..<4 { v := wd_num(wl_query(query, names[k])); if !v.ok { sent = false; } else { mine[k] = v.v; } }
  lane := wr_lane(wl_query(query, "lane"));
  join := wr_join(sent, mine[0], mine[1], mine[2], mine[3], r[R_LIVE] > 0, r[R_LIVE_PINS], r[R_LIVE_PINS + 1], r[R_LIVE_PINS + 2], r[R_LIVE_PINS + 3],
                  r[R_PREV] > 0, r[R_PREV_PINS], r[R_PREV_PINS + 1], r[R_PREV_PINS + 2], r[R_PREV_PINS + 3]);
  verdict := wr_read(wr_loads(wl_id(t)), lane, join);
  if verdict != WR_OK { return wl_refuse(t, wr_status(verdict), wr_words(verdict), -1); }
  if wr_is_dev(lane) { ok := splice_world_pins(here[..]); return wl_state(t, lane, r[R_DEV], here[..], wl_doc(t, ".dev"), ""); }
  if wr_previous(join) { return wl_state(t, lane, r[R_PREV], r[R_PREV_PINS..<R_PREV_PINS + 4], wl_doc(t, ".prev"), ""); }
  return wl_state(t, lane, r[R_LIVE], r[R_LIVE_PINS..<R_LIVE_PINS + 4], wl_doc(t, ".live"), "");
}
wl_events :: (t: [] WlLocal, query: string) -> int {
  lane := wr_lane(wl_query(query, "lane"));
  if wr_read(true, lane, WJ_LIVE) != WR_OK { return wl_refuse(t, 400, wr_words(WR_LANE), -1); }
  after := wd_num(wl_query(query, "after"));
  n := fs_read(wl_path(t, ifx wr_is_dev(lane) then ".dev.events" else ".live.events", -1, ""), t[0].events[..]);
  text := cast(string) t[0].events[0..<ifx n < 0 then 0 else n];
  // an event's line is its revision's: line k holds revision k + 1
  at := 0; line := 0; from := text.count;
  want := ifx after.ok then after.v else 0;
  while at < text.count && line < want { while at < text.count && text[at] != '\n' { at += 1; } at += 1; line += 1; }
  if at < from { from = at; }
  return wl_say(200, text[from..<text.count]);
}
wl_post :: (t: [] WlLocal, body: string) -> int {
  r := t[0].row[..]; head: [3] int; here: [4] int; n: [6] int; why: [240] u8;
  batch_ok := wr_batch(body, head[..]);
  what := head[1];
  verdict := wr_write(true, true, true, wr_authored(wl_id(t), what), batch_ok, what, head[0], r[R_DEV], r[R_DONE], r[R_STEPS]);
  if verdict != WR_OK { return wl_refuse(t, wr_status(verdict), wr_words(verdict), -1); }
  now := cxproc_wall_us() / 1000; seq := now;   // a line's place is its order here; the number only has to rise
  if !splice_world_pins(here[..]) { return wl_refuse(t, 500, "not read", -1); }
  if wr_publishes(what) {
    when := wr_when(what); has_live := r[R_LIVE] > 0;
    v := wr_publish(when, head[0], r[R_DEV], r[R_FROM], here[0], here[1], here[2], here[3], has_live, r[R_LIVE_PINS], r[R_LIVE_PINS + 1], r[R_LIVE_PINS + 2], r[R_LIVE_PINS + 3]);
    if v != WP_OK { return wl_refuse(t, wr_publish_status(v), wr_publish_words(v), -1); }
    if wr_keeps(has_live, here[0], here[1], here[2], here[3], r[R_LIVE_PINS], r[R_LIVE_PINS + 1], r[R_LIVE_PINS + 2], r[R_LIVE_PINS + 3]) {
      kept := wl_doc(t, ".live");
      if !fs_write(wl_path(t, ".prev", -1, ""), kept) { return wl_refuse(t, 500, "not saved", -1); }
      r[R_PREV] = r[R_LIVE]; for k: 0..<4 { r[R_PREV_PINS + k] = r[R_LIVE_PINS + k]; }
    }
    doc := wl_doc(t, ".dev");
    r[R_LIVE] += 1; r[R_FROM] = r[R_DEV]; r[R_WHEN] = when; for k: 0..<4 { r[R_LIVE_PINS + k] = here[k]; }
    en := wr_published(seq, wl_id(t), r[R_LIVE], r[R_DEV], when, here[0], here[1], here[2], here[3], now, t[0].step[..]);
    if en < 0 || !fs_write(wl_path(t, ".live", -1, ""), doc) || !fs_append(wl_path(t, ".live.events", -1, ""), cast(string) t[0].step[0..<en]) || !fs_append(wl_path(t, ".live.events", -1, ""), "\n") || !wl_row_write(t) {
      return wl_refuse(t, 500, "not saved", -1);
    }
    return wl_state(t, wr_lane("live"), r[R_LIVE], here[..], "", "");
  }
  text := body; fenced := true;
  step := wr_step(what, r[R_DONE]);
  if step >= 0 {
    sn := fs_read(wl_path(t, ".step.", step, ifx wr_backward(what) then ".inv" else ".did"), t[0].step[..]);
    if sn <= 0 { return wl_refuse(t, 500, "not read", -1); }
    text = cast(string) t[0].step[0..<sn]; fenced = false;
  }
  doc := wl_doc(t, ".dev");
  status := splice_world_batch(doc, text, fenced, t[0].out_doc[..], t[0].did[..], t[0].inv[..], why[..], n[..]);
  if status != SPB_OK { return wl_refuse(t, splice_world_status(status), ifx n[3] > 0 then cast(string) why[0..<n[3]] else splice_world_words(status), n[5]); }
  did := cast(string) t[0].did[0..<n[1]];
  if step < 0 {
    if !fs_write(wl_path(t, ".step.", r[R_DONE], ".did"), did) || !fs_write(wl_path(t, ".step.", r[R_DONE], ".inv"), cast(string) t[0].inv[0..<n[2]]) { return wl_refuse(t, 500, "not saved", -1); }
  }
  ev: [WE_EVENT_BODY + 2] u8; edit: [WE_LINE] u8;
  for i: 0..<n[4] {
    en := wr_batch_edit(did, i, edit[..]);
    vn := ifx en > 0 then wr_event(seq + i, wl_id(t), r[R_DEV] + 1 + i, cast(string) edit[0..<en], now, ev[..]) else -1;
    if vn < 0 { return wl_refuse(t, 500, "not saved", -1); }
    ev[vn] = '\n';
    if !fs_append(wl_path(t, ".dev.events", -1, ""), cast(string) ev[0..<vn + 1]) { return wl_refuse(t, 500, "not saved", -1); }
  }
  r[R_STEPS] = wr_steps(what, r[R_DONE], r[R_STEPS]); r[R_DONE] = wr_done(what, r[R_DONE]); r[R_DEV] += n[4];
  if !fs_write(wl_path(t, ".dev", -1, ""), cast(string) t[0].out_doc[0..<n[0]]) || !wl_row_write(t) { return wl_refuse(t, 500, "not saved", -1); }
  return wl_state(t, wr_lane("dev"), r[R_DEV], here[..], "", did);
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 3 || args_count(a[..]) > 4 { tool_errln("usage: world-local DIR METHOD URL [BODY_FILE]"); return 2; }
  t := [1] WlLocal.[WlLocal.{}];
  dir := args_at(a[..], 0); method := args_at(a[..], 1); url := args_at(a[..], 2);
  t[0].dir_n = ct_copy(t[0].dir[..], dir);
  root := "/api/worlds/";
  if t[0].dir_n == 0 || url.count <= root.count || url[0..<root.count] != root { return wl_refuse(t[..], 404, "not found", -1); }
  rest := url[root.count..<url.count];
  path := ct_part(rest, '?', 0); query := ifx ct_parts(rest, '?') > 1 then rest[path.count + 1..<rest.count] else "";
  id := ct_part(path, '/', 0); tail := ifx ct_parts(path, '/') > 1 then path[id.count..<path.count] else "";
  if id != SPW_ID || (tail != "" && tail != "/events") || (method != "GET" && method != "POST") || (tail != "" && method != "GET") { return wl_refuse(t[..], 404, wr_words(WR_NO_WORLD), -1); }
  t[0].id_n = ct_copy(t[0].id[..], id);
  ok := fs_mkdir(dir);
  wl_row_read(t[..]);
  if tail == "/events" { return wl_events(t[..], query); }
  if method == "GET" { return wl_get(t[..], query); }
  n := ifx args_count(a[..]) == 4 then fs_read(args_at(a[..], 3), t[0].body[..]) else 0;
  return wl_post(t[..], cast(string) t[0].body[0..<ifx n < 0 then 0 else n]);
}
