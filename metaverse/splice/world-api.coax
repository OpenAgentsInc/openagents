// Splice's world for the API (GitHub #13412): what coax/web/api/worlds.c calls to carry a batch out
// on the world `splice`. It is Splice's own Coax, the code the page runs (world.coax, layer.coax,
// walk.coax), built into the API as the unit splice-world (coax/web/api/api-sources.sh), so the
// server and the page cannot disagree about where a piece may stand. worlds.c moves text in and
// out; nothing here reads a database or a clock.
//   coax/bin/coax test metaverse/splice/world-api.coax --only "the API's"
#load "splice-game.coax";

// The document of Splice with nothing placed into out: its length, or -1.
splice_world_empty :: (out: [] u8) -> int #export_c #effects(all) {
  g := [1] SpGame.[SpGame.{}]; k: [1] SpwScratch;
  made := spw_empty(g[..], k[..], out);
  return ifx made.count == 0 then -1 else made.count;
}
// This build's pins into out (engine, rules, content, wire): what a revision saved here is read by.
splice_world_pins :: (out: [] int) -> bool #export_c #effects(all) {
  if out.count < 4 { return false; }
  g := [1] SpGame.[SpGame.{}]; g_reset(g[..]);
  p := spw_pins(g[..]);
  out[0] = p.engine; out[1] = p.rules; out[2] = p.content; out[3] = p.wire;
  return true;
}
// Splice's content tables (aethyr.content.v1) into out: their length, or -1. What a caller reads
// to aim an edit: the pieces by content ID, the landmarks, the kept-clear zones and the areas.
splice_world_content :: (out: [] u8) -> int #export_c #effects(all) {
  n := ct_put(out, 0, SC_SHIPPED);
  return ifx n > out.count then -1 else n;
}
// A batch carried out on a document and the world's content tables (world.coax spw_batch): its
// status (SPB_*). tables: the world's own ("": the ones the build shipped with). n takes seven
// numbers: the bytes of the new document, of the batch as taken and of its inverse, of the words
// of a refusal, how many edits were taken, which edit was refused (-1: none), and the bytes of
// the tables in out_tables when the batch changed them (0: it did not).
splice_world_batch :: (doc: string, tables: string, body: string, fenced: bool, out_doc: [] u8, out_tables: [] u8, out_did: [] u8, out_inv: [] u8, out_why: [] u8, n: [] int) -> int #export_c #effects(all) {
  return splice_world_batch_packed(doc, tables, "", body, fenced, out_doc, out_tables, out_did, out_inv, out_why, n);
}
// The same with the world's import pack ("": it has imported nothing): a row of the pieces table
// that draws a pack mesh is held to the pack (world.coax spw_mesh_rows). A pack that does not
// read is SPB_DOC.
splice_world_batch_packed :: (doc: string, tables: string, pack: string, body: string, fenced: bool, out_doc: [] u8, out_tables: [] u8, out_did: [] u8, out_inv: [] u8, out_why: [] u8, n: [] int) -> int #export_c #effects(all) {
  if n.count < 7 || tables.count > SPW_TABLES { return SPB_ROOM; }
  g := [1] SpGame.[SpGame.{}]; x := [1] SpwWork.[SpwWork.{}];
  for k: 0..<7 { n[k] = 0; } n[5] = -1;
  if !sp_imports_read(g[0].imp[..], pack) { n[3] = ct_put(out_why, 0, "the world's import pack does not read"); if n[3] > out_why.count { n[3] = 0; } return SPB_DOC; }
  g[0].imp[0].checked = true;
  x[0].ct[0].text_n = ct_copy(x[0].ct[0].text[..], tables);
  b := spw_batch(g[..], x[..], doc, body, fenced, out_doc, out_did, out_inv, out_why);
  n[0] = b.doc; n[1] = b.did; n[2] = b.inv; n[3] = ifx b.why > out_why.count then 0 else b.why; n[4] = b.edits; n[5] = b.at; n[6] = 0;
  if b.status == SPB_OK && x[0].ct[0].changed {
    made := spw_tables_text(x[0].ct[..]);
    if made.count > out_tables.count { return SPB_ROOM; }
    n[6] = ct_copy(out_tables, made);
  }
  return b.status;
}
// Whether a mesh of the world's import pack may take new bounds (its reach in millimetres) where
// the world stands: the row of the pieces table that draws it is written again for those bounds
// (world.coax spw_mesh_row) and carried out on the document with the new pack, in a copy; nothing is
// saved. True when no row draws the mesh, the bounds are the ones its row has, or the row stands. False with why in words when a placed
// piece would no longer fit. An import asks this before it replaces a mesh, so a pack never holds
// a mesh larger than the colliders the world has for it.
splice_world_mesh_fits :: (doc: string, tables: string, pack: string, mesh: string, hx: int, hz: int, top: int, out_why: [] u8, why_n: [] int) -> bool #export_c #effects(all) {
  why_n[0] = 0;
  rb: [WE_TEXT] u8; t := [1] SpwTest0.[SpwTest0.{}]; n: [7] int;
  mine := ifx tables.count > 0 then tables else SC_SHIPPED;
  row := spw_mesh_row(mine, mesh, hx, hz, top, rb[..]);
  if row.count == 0 { return true; }
  // the same bounds as the row has: nothing about where its pieces stand changes
  for k: 0..<ct_parts(mine, '\n') { if ct_part(mine, '\n', k) == row { return true; } }
  id := ct_num(ct_part(row, '|', 0)).v;
  c: [1] SpContent;
  if !sc_load(c[..], mine) || sc_piece(c[..], id) < 0 { return true; }   // a new kind: nothing stands as it yet
  e: [1] WorldEdit;
  e[0] = WorldEdit.{ok = true, op = WE_CELL, id = id};
  e[0].table_n = ct_copy(e[0].table[..], SPW_KINDS); e[0].name_n = ct_copy(e[0].name[..], "*"); e[0].text_n = ct_copy(e[0].text[..], row);
  body := we_batch_write(0, WB_APPLY, e[..], 1, t[0].body[..]);
  status := splice_world_batch_packed(doc, tables, pack, body, false, t[0].doc[..], t[0].tables[..], t[0].did[..], t[0].inv[..], out_why, n[..]);
  if status == SPB_OK || status == SPB_NOTHING { return true; }
  why_n[0] = n[3];
  return false;
}
SpwTest0 :: struct { doc: [SPW_DOC] u8; tables: [SPW_TABLES] u8; did: [WE_BATCH_BODY] u8; inv: [WE_BATCH_BODY] u8; body: [WE_LINE + 200] u8; }
// What Splice holds a world's imports to (pieces.coax sp_import_limits), for a caller that packs
// them: the file, the pack, a mesh's triangles and a texture's side.
splice_world_import_limits :: () -> PipLimits #effects(all) { return sp_import_limits(); }
// The world's content tables as a page reads them: its own, or the ones the build shipped with
// when it has none. -1 for tables this build does not read.
splice_world_tables :: (tables: string, out: [] u8) -> int #export_c #effects(all) {
  if tables.count == 0 { return splice_world_content(out); }
  g := [1] SpGame.[SpGame.{}]; ct := [1] SpwTables.[SpwTables.{}];
  if !spw_tables_open(g[..], ct[..], tables) || tables.count > out.count { return -1; }
  return ct_copy(out, tables);
}
// The world as a conversation's card names it (world.card.v1, GitHub #13418): its name, and how many
// things a document holds with the world's own tables ("": the ones the build shipped with). -1
// for a document or tables this build does not read.
splice_world_name :: () -> string #export_c #effects(all) { return "Splice"; }
splice_world_things :: (doc: string, tables: string) -> int #export_c #effects(all) {
  if tables.count > SPW_TABLES { return -1; }
  g := [1] SpGame.[SpGame.{}]; x := [1] SpwWork.[SpwWork.{}];
  g_reset(g[..]);
  x[0].ct[0].text_n = ct_copy(x[0].ct[0].text[..], tables);
  if tables.count > 0 && !spw_tables_open(g[..], x[0].ct[..], tables) { return -1; }
  if spw_pieces(g[..], x[0].k[..], doc) != SPW_OK { return -1; }
  w := slw_world(x[0].k[0].ws[..]);
  count := 0;
  for s: 0..<world_high(w) { if world_at(w, s) != ENTITY_NONE && world_i(w, WI_KIND, s) >= SK_PIECE { count += 1; } }
  return count;
}
// What the API answers for a status: 200 saved; 400 no batch; 409 stale; 422 refused, with words;
// 500 the stored document did not open or an answer did not fit.
splice_world_status :: (status: int) -> int #export_c #effects(all) {
  if status == SPB_OK { return 200; }
  if status == SPB_BATCH { return 400; }
  if status == SPB_STALE { return 409; }
  if status == SPB_REFUSED || status == SPB_WALK || status == SPB_NOTHING { return 422; }
  return 500;
}
// The words for a status that came with none of its own.
splice_world_words :: (status: int) -> string #export_c #effects(all) {
  if status == SPB_BATCH { return "send a world.edit.v1 batch of edits"; }
  if status == SPB_STALE { return "the world changed since you read it: read it again"; }
  if status == SPB_NOTHING { return "nothing to change"; }
  return "not saved";
}

#test "the API's Splice: the empty document, the pins, and a batch through the exported calls" #steps 4000000000 #traversal 2000000000 {
  t := [1] SpwTest.[SpwTest.{}]; n: [7] int; pins: [4] int; tb: [SPW_TABLES] u8; own: [SPW_TABLES] u8; body: [WE_BATCH_BODY] u8;
  cn := splice_world_content(t[0].third[..]); cd: [1] ContentDoc;
  #assert cn > 0 && ct_read(cd[..], cast(string) t[0].third[0..<cn]) && ct_table(cd[..], "pieces") >= 0 && ct_table(cd[..], "landmarks") >= 0 && ct_table(cd[..], "kept_clear") >= 0 && splice_world_content(t[0].third[0..<64]) == -1;
  e := splice_world_empty(t[0].doc[..]);
  #assert e > 0 && splice_world_empty(t[0].doc[0..<64]) == -1 && splice_world_pins(pins[..]) && pins[0] == SPW_ENGINE && pins[1] == SPW_RULES && pins[2] >= 1 && pins[3] == SPW_WIRE && !splice_world_pins(pins[0..<3]);
  empty := cast(string) t[0].doc[0..<e];
  s := splice_world_batch(empty, "", SPT_TWO, true, t[0].next[..], tb[..], t[0].did[..], t[0].inv[..], t[0].why[..], n[..]);
  #assert s == SPB_OK && n[0] > 0 && n[1] > 0 && n[2] > 0 && n[3] == 0 && n[4] == 2 && n[5] == -1 && n[6] == 0;
  two := n[0];
  #assert splice_world_name() == "Splice" && splice_world_things(empty, "") == 0 && splice_world_things(cast(string) t[0].next[0..<two], "") == 2 && splice_world_things("not a document", "") == -1 && splice_world_things(empty, "not tables") == -1;
  s = splice_world_batch(cast(string) t[0].next[0..<two], "", sc_edit_swap(SPT_TWO, "\"rev\":0", "\"rev\":2", t[0].back[..]), true, t[0].third[..], tb[..], t[0].did[..], t[0].inv[..], t[0].why[..], n[..]);
  #assert s == SPB_REFUSED && n[0] == 0 && n[5] == 0 && cast(string) t[0].why[0..<n[3]] == "inside the placed piece 0";
  // a cell edit answers the world's tables as they now are; given back, they are the ones the next batch and a page read
  s = splice_world_batch(cast(string) t[0].next[0..<two], "", spt_cell(body[..], 2, "pieces", 117, "name", "Tiny crate"), true, t[0].third[..], tb[..], t[0].did[..], t[0].inv[..], t[0].why[..], n[..]);
  #assert s == SPB_OK && n[6] > 3000 && n[4] == 1;
  mine := cast(string) tb[0..<n[6]]; three := n[0];
  on := splice_world_tables(mine, own[..]);
  #assert on == mine.count && cast(string) own[0..<on] == mine && splice_world_tables("", own[..]) == cn && splice_world_tables("not tables", own[..]) == -1 && splice_world_tables(mine, own[0..<64]) == -1;
  s = splice_world_batch(cast(string) t[0].third[0..<three], mine, spt_cell(body[..], 3, "pieces", 117, "name", "Small crate"), true, t[0].next[..], own[..], t[0].did[..], t[0].inv[..], t[0].why[..], n[..]);
  shipped := cast(string) own[0..<n[6]];
  #assert s == SPB_OK && n[6] == cn && splice_world_content(t[0].doc[..]) == cn && shipped == cast(string) t[0].doc[0..<cn];
  #assert splice_world_batch(empty, "not tables", SPT_TWO, true, t[0].next[..], tb[..], t[0].did[..], t[0].inv[..], t[0].why[..], n[..]) == SPB_DOC;
  #assert splice_world_batch(empty, "", SPT_TWO, true, t[0].next[..], tb[..], t[0].did[..], t[0].inv[..], t[0].why[..], n[0..<6]) == SPB_ROOM;
  #assert splice_world_status(SPB_OK) == 200 && splice_world_status(SPB_BATCH) == 400 && splice_world_status(SPB_STALE) == 409 && splice_world_status(SPB_REFUSED) == 422 && splice_world_status(SPB_WALK) == 422 && splice_world_status(SPB_NOTHING) == 422 && splice_world_status(SPB_DOC) == 500 && splice_world_status(SPB_ROOM) == 500;
  #assert splice_world_words(SPB_STALE).count > 20 && splice_world_words(SPB_BATCH).count > 20 && splice_world_words(SPB_NOTHING) == "nothing to change" && splice_world_words(SPB_DOC) == "not saved";
}
#load "world-assets.coax";   // a world's imports for its server: the list, a file named before it is sent, an import (#13420)
#load "imports-api-checks.coax" #test;   // a row that draws a pack mesh, held to the world's import pack (#13420)
#load "world-assets-checks.coax" #test;   // the list, a file named before it is sent, an import (#13420)
