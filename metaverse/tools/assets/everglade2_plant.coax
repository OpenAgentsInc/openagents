// Everglade II's planting into its pack (docs/metaverse/fast-loads.md, #13150): IN.pack's catalog with
// the woods e2_plant plants (everglade/world/plant.coax) as P lines, written to OUT.pack. The page
// takes the woods from them instead of planting for 1.8 s on its first frame. apps/openagents-web/
// build.sh runs it on the tracked everglade2.pack before page-pack writes the .vpk3, so the lines
// are always this tree's planting. Any P lines IN already holds are replaced. The rest of the pack
// is copied byte for byte; each entry keeps its row, at its new offset. The pack written is sealed
// (metaverse-engine/editor/pack-seal.coax, #13304): the admission's pack_read took it, or nothing is written.
// Run: coax/web/tool.sh metaverse/tools/assets/everglade2_plant.coax IN.pack OUT.pack
// tool.sh: release
// tool.sh: stack-gib 8
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/args.coax";
#load "../../../everglade/world/plant.coax";
#load "../../../metaverse-engine/editor/pack-seal.coax";

E2PP_MAX :: 67108864;
E2PP_VPK1 :: 0x314b5056;
E2PP_VPK2 :: 0x324b5056;
e2pp_u32 :: (b:[]u8,at:int)->int {return cast(int)b[at]|(cast(int)b[at+1]<<8)|(cast(int)b[at+2]<<16)|(cast(int)b[at+3]<<24);}
e2pp_put :: (b:[]u8,at:int,v:int) {for k:0..<4 {b[at+k]=cast(u8)((v>>(k*8))&255);}}
// The catalog without its P lines into out: the length, or -1 when out is too small.
e2pp_strip :: (cat:string,out:[]u8)->int {
 n:=0;at:=0;
 while at<cat.count {
  e:=at;while e<cat.count && cat[e]!='\n' {e+=1;}
  if !(e-at>1 && cat[at]=='P' && cat[at+1]==' ') {
   if n+e-at+1>out.count {return -1;}
   for q:at..<e {out[n]=cat[q];n+=1;}
   if e<cat.count {out[n]='\n';n+=1;}
  }
  at=e+1;
 }
 return n;
}
// IN's pack with the catalog's body replaced by body into out (each entry 4-byte aligned, as the pack
// tools write them): the size, -1 refused. Its "bytes" line is the seal's to state.
e2pp_rewrite :: (pack:[]u8,body:string,out:[]u8)->int {
 if pack.count<32 || (e2pp_u32(pack,0)!=E2PP_VPK1 && e2pp_u32(pack,0)!=E2PP_VPK2) {return -1;}
 ne:=e2pp_u32(pack,4);table:=e2pp_u32(pack,16);
 if ne<1 || table<32 || table+ne*48>pack.count {return -1;}
 at:=table+ne*48;if at>out.count {return -1;}
 for k:0..<at {out[k]=pack[k];}
 cat_row:=-1;
 for i:0..<ne {r:=table+i*48;kind:=int(pack[r]);off:=e2pp_u32(pack,r+4);size:=e2pp_u32(pack,r+8);
  if off<0 || size<0 || off+size>pack.count {return -1;}
  start:=at;
  if kind==1 {if cat_row>=0 || at+body.count>out.count {return -1;}cat_row=r;for ch:body {out[at]=ch;at+=1;}}
  else {if at+size>out.count {return -1;}for k:0..<size {out[at]=pack[off+k];at+=1;}}
  e2pp_put(out,r+4,start);e2pp_put(out,r+8,at-start);
  for k:at..<((at+3)/4)*4 {if k<out.count {out[k]=0;}}at=((at+3)/4)*4;
 }
 if cat_row<0 || at>out.count {return -1;}
 e2pp_put(out,8,at);
 return at;
}
#test "a pack's catalog takes the P lines; its other entries and their order stay" {
 // a two-entry pack: the catalog, then four vertex bytes
 cat:="bytes 0000000000\nC glade/environment 9 12 250 100 8 0\nP AAAA\n";
 p:[256]u8;e2pp_put(p[..],0,E2PP_VPK1);e2pp_put(p[..],4,2);e2pp_put(p[..],16,32);
 at:=32+96;p[32]=1;e2pp_put(p[..],36,at);e2pp_put(p[..],40,cat.count);for ch:cat {p[at]=ch;at+=1;}at=((at+3)/4)*4;
 p[80]=2;e2pp_put(p[..],84,at);e2pp_put(p[..],88,4);for k:0..<4 {p[at+k]=cast(u8)(200+k);}at+=4;e2pp_put(p[..],8,at);
 sb:[256]u8;sn:=e2pp_strip(cat,sb[..]);#assert cast(string)sb[0..<sn]=="bytes 0000000000\nC glade/environment 9 12 250 100 8 0\n";
 for ch:"P QUJD\n" {sb[sn]=ch;sn+=1;}
 o:[512]u8;n:=e2pp_rewrite(p[0..<at],cast(string)sb[0..<sn],o[..]);#assert n==at;
 #assert e2pp_u32(o[..],8)==n && o[32]==1 && o[80]==2;
 vo:=e2pp_u32(o[..],84);#assert e2pp_u32(o[..],88)==4 && vo%4==0 && o[vo]==200 && o[vo+3]==203 && vo+4==n;
 co:=e2pp_u32(o[..],36);cl:=e2pp_u32(o[..],40);c2:=cast(string)o[co..<co+cl];
 #assert c2[0..<17]=="bytes 0000000000\n";
 e2pp_put(o[..],0,E2PP_VPK2);#assert e2pp_rewrite(o[0..<n],cast(string)sb[0..<sn],p[..])==n;
 e2pp_put(o[..],0,0x334b5056);#assert e2pp_rewrite(o[0..<n],cast(string)sb[0..<sn],p[..])== -1;e2pp_put(o[..],0,E2PP_VPK1);
 #assert c2[cl-7..<cl]=="P QUJD\n";
 // not a pack, or one without a catalog
 #assert e2pp_rewrite(o[0..<16],"",p[..])== -1;
 o[32]=3;#assert e2pp_rewrite(o[0..<n],"x",p[..])== -1;
}
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=2 {tool_errln("everglade2 plant: IN.pack OUT.pack");return 2;}
 pack:[E2PP_MAX]u8;out:[E2PP_MAX]u8;
 size:=fs_read(args_at(args[..],0),pack[..]);if size<32 {tool_errln("everglade2 plant: can't read the pack");return 1;}
 ne:=e2pp_u32(pack[..],4);table:=e2pp_u32(pack[..],16);cat:="";
 for i:0..<ne {r:=table+i*48;if int(pack[r])==1 {off:=e2pp_u32(pack[..],r+4);cat=cast(string)pack[off..<off+e2pp_u32(pack[..],r+8)];}}
 items:[E2_ITEMS*E2_ITEM_FLOATS]f32;kinds:[E2_ITEMS]u8;first:[E2P_CELLS+1]int;
 n:=e2_plant(items[..],kinds[..],first[..]);
 body:[16777216]u8;bn:=e2pp_strip(cat,body[..]);if bn<0 {tool_errln("everglade2 plant: the catalog is too long");return 1;}
 if bn>0 && body[bn-1]!='\n' {body[bn]='\n';bn+=1;}
 ln:=e2p_lines(items[..],kinds[..],first[..],n,body[bn..<body.count]);if ln<0 {tool_errln("everglade2 plant: the lines overflow");return 1;}
 at:=e2pp_rewrite(pack[0..<size],cast(string)body[0..<bn+ln],out[..]);
 if at<0 {tool_errln("everglade2 plant: the pack is refused, or it grows past 64 MiB");return 1;}
 sealed:[E2PP_MAX]u8;catalog:[20971520]u8;read:[1]PackRead;
 sn:=pack_seal(cast(string)out[0..<at],false,catalog[..],sealed[..],read[..]);
 if sn<0 {tool_err("everglade2 plant: the planted pack isn't one the admission takes: ");tool_errln(read[0].why);return 1;}
 if !fs_write(args_at(args[..],1),cast(string)sealed[0..<sn]) {return 1;}
 print("Everglade2 planting: % pieces, % bytes of P lines; the pack % bytes, sealed\n",n,ln,sn);return 0;
}
