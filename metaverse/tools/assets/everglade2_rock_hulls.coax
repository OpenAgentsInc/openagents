// Everglade II's rock colliders from the rocks' own meshes (docs/verse/everglade2.md): for each Stylized
// Nature rock the page plants or the glade composes, its convex hull, as the vertices and outward face
// planes metaverse-engine/physics/query.coax's hulls take. The hull's vertices are the mesh's own: the mesh's farthest
// vertex along each of a fixed set of directions round it (every 22.5 degrees round, from under it to
// over it), so the hull sits inside the drawn rock and touches it all round. Glade Rock_Medium_4s west
// of x -10 are drawn with their tops capped (metaverse/character-glade.coax cg_cliff_cap_y), so that one
// has its own capped hull. It prints everglade/world/rock-hulls.coax:
//   coax/web/tool.sh metaverse/tools/assets/everglade2_rock_hulls.coax SOURCE_ROOT > everglade/world/rock-hulls.coax
// SOURCE_ROOT is the Stylized Nature original in the asset registry (the folder holding glTF/).
// tool.sh: release
// tool.sh: stack-gib 8
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../humans/ph_gltf.coax";
#load "../../character-glade.coax";

RH_MODELS :: 7;
RH_NAME :: [7] string.["Rock_Medium_1", "Rock_Medium_2", "Rock_Medium_3", "Rock_Medium_4", "Rock_Big_1", "Rock_Big_2", "Rock_Medium_4"];
RH_CAPPED :: 6;            // the glade's capped cliff
RH_AROUND :: 16;           // directions round
RH_ELEVATIONS :: [6] f64.[-45, 0, 20, 40, 60, 78];
RH_POINTS :: 160;
RH_FACES :: 128;           // metaverse-engine/physics/query.coax QUERY_HULL_FACES_MAX
RH_MESH :: 200000;

rh_dot :: (a: [3] f64, b: [3] f64) -> f64 { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
rh_sub :: (a: [3] f64, b: [3] f64) -> [3] f64 { return [3] f64.[a[0] - b[0], a[1] - b[1], a[2] - b[2]]; }
rh_cross :: (a: [3] f64, b: [3] f64) -> [3] f64 { return [3] f64.[a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]; }
rh_int :: (v: f64, unit: f64) -> int { return int(floor(v * unit + 0.5)); }

// The directions the hull's vertices are picked along: round at each elevation, and straight up and down.
rh_directions :: (out: [] [3] f64) -> int {
  n := 0;
  for e: 0..<RH_ELEVATIONS.count { el := RH_ELEVATIONS[e] * 3.14159265358979 / 180;
    for a: 0..<RH_AROUND { az := f64(a) * 6.28318530717959 / f64(RH_AROUND); out[n] = [3] f64.[cos(el) * cos(az), sin(el), cos(el) * sin(az)]; n += 1; } }
  out[n] = [3] f64.[0, 1, 0]; out[n + 1] = [3] f64.[0, -1, 0];
  return n + 2;
}
#test "the directions go all round and from under to over" {
  d: [RH_POINTS] [3] f64; n := rh_directions(d[..]);
  #assert n == RH_AROUND * 6 + 2;
  for i: 0..<n { #assert abs(rh_dot(d[i], d[i]) - 1) < 0.000001; }
}
// The hull's points: the mesh's farthest vertex along each direction, each once.
rh_pick :: (mesh: [] [3] f64, nv: int, out: [] [3] f64) -> int {
  d: [RH_POINTS] [3] f64; nd := rh_directions(d[..]); picked: [RH_POINTS] int; n := 0;
  for i: 0..<nd {
    best := 0; far := rh_dot(mesh[0], d[i]);
    for v: 1..<nv { s := rh_dot(mesh[v], d[i]); if s > far { far = s; best = v; } }
    seen := false; for j: 0..<n { if picked[j] == best { seen = true; } }
    if !seen { picked[n] = best; out[n] = mesh[best]; n += 1; }
  }
  return n;
}
// The hull's faces: each plane through three of the points with every point on its inner side, once,
// as an outward unit normal and its offset.
rh_faces :: (p: [] [3] f64, n: int, out: [] [4] f64) -> int {
  size := 0.0; for i: 0..<n { for k: 0..<3 { size = ifx abs(p[i][k]) > size then abs(p[i][k]) else size; } }
  eps := size * 0.000001; nf := 0;
  for i: 0..<n { for j: i + 1..<n { for k: j + 1..<n {
    c := rh_cross(rh_sub(p[j], p[i]), rh_sub(p[k], p[i])); l := sqrt(rh_dot(c, c));
    if l < eps * size { continue; }
    u := [3] f64.[c[0] / l, c[1] / l, c[2] / l]; d := rh_dot(u, p[i]);
    above := false; below := false;
    for q: 0..<n { s := rh_dot(u, p[q]) - d; if s > eps { above = true; } if s < -eps { below = true; } if above && below { break; } }
    if above && below { continue; }
    if above { u = [3] f64.[-u[0], -u[1], -u[2]]; d = -d; }
    known := false;
    for f: 0..<nf { if out[f][0] * u[0] + out[f][1] * u[1] + out[f][2] * u[2] > 1 - 0.0000001 && abs(out[f][3] - d) < eps * 10 { known = true; break; } }
    if known { continue; }
    if nf >= out.count { ph_die("rock hull: more faces than a hull holds"); }
    out[nf] = [4] f64.[u[0], u[1], u[2], d]; nf += 1;
  }}}
  return nf;
}
#test "a cube's hull is its six faces, its corners picked from its mesh" {
  m: [9] [3] f64; for i: 0..<8 { m[i] = [3] f64.[ifx i & 1 != 0 then 1.0 else -1.0, ifx i & 2 != 0 then 2.0 else 0.0, ifx i & 4 != 0 then 1.0 else -1.0]; }
  m[8] = [3] f64.[0, 1, 0];   // inside: never picked
  p: [RH_POINTS] [3] f64; n := rh_pick(m[..], 9, p[..]); #assert n == 8;
  f: [RH_FACES] [4] f64; nf := rh_faces(p[..], n, f[..]); #assert nf == 6;
  for i: 0..<nf { for q: 0..<n { #assert rh_dot([3] f64.[f[i][0], f[i][1], f[i][2]], p[q]) - f[i][3] < 0.000001; } }
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args; if !args_load(args[..]) || args_count(args[..]) != 1 { tool_errln("usage: everglade2_rock_hulls SOURCE_ROOT"); return 2; }
  root := args_at(args[..], 0); g: [1] Gltf; t: [1] Txt;
  first_v: [RH_MODELS + 1] int; first_f: [RH_MODELS + 1] int; bounds: [RH_MODELS] [6] f64;
  verts: [RH_MODELS * RH_POINTS] [3] f64; faces: [RH_MODELS * RH_FACES] [4] f64; nv := 0; nf := 0;
  for m: 0..<RH_MODELS {
    gl_load(g[..], txt_cat3(t[..], root, "/glTF/", txt_cat(t[..], RH_NAME[m], ".gltf")));
    mesh: [RH_MESH] [3] f64; count := 0;
    for mi: 0..<g[0].nx[GA_MESH] { prims := gl_get(g[..], gl_at(g[..], GA_MESH, mi), "primitives");
      for pi: 0..<jv_len(g[0].d[0], prims) {
        attrs := gl_get(g[..], jv_at(g[0].d[0], prims, pi), "attributes"); pos: [196608] f64;
        k := gl_acc(g[..], gl_int(g[..], attrs, "POSITION", 0), pos[..]).count;
        for v: 0..<k { if count >= RH_MESH { ph_die("rock hull: mesh too big"); }
          y := pos[v * 3 + 1]; if m == RH_CAPPED { y = f64(cg_cliff_cap_y(f32(y))); }
          mesh[count] = [3] f64.[pos[v * 3], y, pos[v * 3 + 2]]; count += 1; } } }
    if count < 4 { ph_die("rock hull: a mesh with no volume"); }
    bounds[m] = [6] f64.[mesh[0][0], mesh[0][1], mesh[0][2], mesh[0][0], mesh[0][1], mesh[0][2]];
    for v: 0..<count { for k: 0..<3 { if mesh[v][k] < bounds[m][k] { bounds[m][k] = mesh[v][k]; } if mesh[v][k] > bounds[m][k + 3] { bounds[m][k + 3] = mesh[v][k]; } } }
    first_v[m] = nv; first_f[m] = nf;
    n := rh_pick(mesh[..], count, verts[nv..<nv + RH_POINTS]);
    k := rh_faces(verts[nv..<nv + n], n, faces[nf..<nf + RH_FACES]);
    nv += n; nf += k;
  }
  first_v[RH_MODELS] = nv; first_f[RH_MODELS] = nf;
  print("// Generated by metaverse/tools/assets/everglade2_rock_hulls.coax from the Stylized Nature rock meshes: don't edit.\n");
  print("// Each rock's convex hull in its model's space, 0.1 mm units: its vertices (picked from the mesh) and its\n// outward face planes (unit normal and offset, millionths). The mesh's own bounds, for the check.\n");
  print("E2_HULL_MODELS :: %;\n", RH_MODELS);
  print("E2_HULL_FIRST_V :: [%] int.[", RH_MODELS + 1); for m: 0..<RH_MODELS + 1 { if m > 0 { print(","); } print("%", first_v[m]); } print("];\n");
  print("E2_HULL_FIRST_F :: [%] int.[", RH_MODELS + 1); for m: 0..<RH_MODELS + 1 { if m > 0 { print(","); } print("%", first_f[m]); } print("];\n");
  print("E2_HULL_MESH_BOUNDS :: [%] int.[\n", RH_MODELS * 6);
  for m: 0..<RH_MODELS { for k: 0..<6 { print("%,", rh_int(bounds[m][k], 10000)); } print("   // %", RH_NAME[m]); if m == RH_CAPPED { print(", capped"); } print("\n"); }
  print("];\nE2_HULL_V :: [%] int.[\n", nv * 3);
  for v: 0..<nv { print("%,%,%,", rh_int(verts[v][0], 10000), rh_int(verts[v][1], 10000), rh_int(verts[v][2], 10000)); if v % 6 == 5 { print("\n"); } }
  print("];\nE2_HULL_F :: [%] int.[\n", nf * 4);
  for f: 0..<nf { print("%,%,%,%,", rh_int(faces[f][0], 1000000), rh_int(faces[f][1], 1000000), rh_int(faces[f][2], 1000000), rh_int(faces[f][3], 1000000)); if f % 5 == 4 { print("\n"); } }
  print("];\n");
  return 0;
}
