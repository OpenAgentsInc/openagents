// Convert the pinned Pollen/NVIDIA assembly with the engine's existing glTF importer and VPK1 writer.
// No upstream program is run. Output geometry is CC BY-NC-SA 4.0; see the registry package.
#import "Basic";
#load "../../../metaverse-engine/editor/pack-import.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/proc.coax";
#load "../../../coax/lib/sys/args.coax";
#load "../../../coax/lib/image/pillow.coax";
ceil :: (x: f64) -> f64 #foreign #effects(all);

MD_SOURCE :: "https://raw.githubusercontent.com/NV-DLI/Microduck-Workshop/b283d134f52db75f747581f9ed47f64f3f94df7b/web/assets/robot/microduck.glb";
MD_SHA :: "eea0931fefde8b2d352eaaa73b5e380f2790f63fb716a8c1a2ce219ffe58c1ac";
MD_BUDGET :: 64000000;

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) || args_count(args[..]) != 2 { tool_errln("usage: microduck-pack SOURCE.glb|--fetch OUT.pack"); return 2; }
  source := args_at(args[..], 0);
  if source == "--fetch" {
    source = "/tmp/openagents-microduck.glb";
    command := [7] string.["curl", "--fail", "--location", "--silent", MD_SOURCE, "--output", source];
    stdout: [4096] u8; stderr: [4096] u8;
    got := proc_run(command[..], 120000, stdout[..], stderr[..]);
    if got.started != 0 || got.status != 0 || got.timed_out { tool_errln("Microduck source download failed"); return 1; }
  }
  data: [16000000] u8; n := fs_read(source, data[..]); hash: [64] u8;
  if n != 11893404 || !asset_hex_of(cast(string) data[0..<n], hash[..]) || cast(string) hash[..] != MD_SHA { tool_errln("Microduck source digest differs from its pin"); return 1; }
  vertices: [48000000] u8; indices: [24000000] u8; nodes: [65536] JvNode;
  room := PiRoom.{vertices = vertices[..], indices = indices[..], nodes = nodes[..]}; made: [1] PiMade;
  why := pi_glb(data[0..<n], PipLimits.{triangles = 2000000}, room, 0, 0, made[..]);
  if why != "" || made[0].vertices == 0 { tool_errln(why); return 1; }
  // Preserve the source assembly coordinates, including its floor and metre scale.
  // The shared browser scene layout always binds a layer array, even for vertex-colour art.
  pixel := [4] u8.[255, 255, 255, 255]; z: [1] PiZ; filtered: [5] u8; png: [256] u8;
  png_n := pi_png(pi_img(pixel[..], 1, 1, 4), z[..], filtered[..], png[..]);
  if png_n < 1 { return 1; }
  catalog: [4096] u8; sources: [4] PackSource; total := 0;
  for pass: 0..<5 {
    at := pi_put(catalog[..], 0, "pack microduck\nbudget 64000000\nbytes ");
    at = pi_put_int(catalog[..], at, total);
    at = pi_put(catalog[..], at, "\nL 0 Pollen Robotics / NVIDIA DLI|CC BY-NC-SA 4.0|https://creativecommons.org/licenses/by-nc-sa/4.0/\nM microduck 0 ");
    at = pi_put_int(catalog[..], at, made[0].indices);
    at = pi_put(catalog[..], at, " 0\nT 0 neutral 0\n");
    sources[0] = PackSource.{kind = PACK_CATALOG, licence = PACK_MANY, name = "catalog", data = cast(string) catalog[0..<at]};
    sources[1] = PackSource.{kind = PACK_VERTICES, licence = PACK_MANY, name = "vertices", data = cast(string) vertices[0..<made[0].vertices * PI_VERTEX]};
    sources[2] = PackSource.{kind = PACK_INDICES, licence = PACK_MANY, name = "indices", data = cast(string) indices[0..<made[0].indices * 4]};
    sources[3] = PackSource.{kind = PACK_LAYER, licence = 0, name = "neutral", data = cast(string) png[0..<png_n]};
    total = pack_size(sources[..]);
  }
  out: [MD_BUDGET] u8; size := pack_write(sources[..], MD_BUDGET, out[..]); read: [1] PackRead;
  if size < 1 || !pack_read(cast(string) out[0..<size], read[..]) { tool_errln(read[0].why); return 1; }
  if !fs_write(args_at(args[..], 1), cast(string) out[0..<size]) { tool_errln("cannot write Microduck pack"); return 1; }
  if !asset_hex_of(cast(string) out[0..<size], hash[..]) { return 1; }
  print("Microduck: % vertices, % triangles, % bytes, SHA256 %\n", made[0].vertices, made[0].indices / 3, size, cast(string) hash[..]);
  return 0;
}
