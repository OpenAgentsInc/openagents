// The Ranger's kit for a pack that only has the guard's Sword (Everglade II): Experimental's
// glade/weapon4..6 (character_glade_pack.coax gp_weapons: the Bow_Wooden without its string, the
// string alone, and the Arrow), copied out of its glade.pack vertex for vertex and re-marked as a model
// shaded by its vertex colour alone (kind 9, everglade2_pack.coax GP_E2_MODEL), so the held bow, its
// string and the nocked arrow are the ones Experimental draws. Loaded by character_glade_pack.coax:
//   gzip -dc realms/everglade-experimental/assets/glade.pack.gz > /tmp/glade.pack
//   coax/web/tool.sh metaverse/tools/assets/character_glade_pack.coax --append-weapons IN.pack OUT.pack /tmp/glade.pack

GP_WEAPON_KIT :: [3]int.[4,5,6];
GP_WEAPON_KIND :: 9;
GP_WEAPON_SOURCE :: 253;   // the Ultimate RPG's licence row, already in Everglade II's catalog

// Row "C NAME FIRST COUNT SOURCE WORD ..." of a catalog: its four numbers, or count -1 when absent.
GpRow :: struct {first:int;count:int = -1;word:int;}
gp_catalog_row :: (cat:string,name:string)->GpRow {
  r:GpRow;at:=0;
  while at<cat.count {
    end:=at;while end<cat.count && cat[end]!='\n' {end+=1;}
    line:=cat[at..<end];at=end+1;
    if line.count<=name.count+3 || line[0..<2]!="C " || line[2..<2+name.count]!=name || line[2+name.count]!=' ' {continue;}
    v:[4]int;p:=3+name.count;
    for k:0..<4 {n:=0;while p<line.count && line[p]>='0' && line[p]<='9' {n=n*10+int(line[p]-'0');p+=1;}v[k]=n;p+=1;}
    r.first=v[0];r.count=v[1];r.word=v[3];return r;
  }
  return r;
}
#test "a catalog row's first, count and vertex word" {
  cat:="L 253 x\nC glade/weapon1 3167143 2616 253 2525712 0 0\nC glade/weapon4 10 20 253 800 0 0\n";
  a:=gp_catalog_row(cat,"glade/weapon4");#assert a.first==10 && a.count==20 && a.word==800;
  b:=gp_catalog_row(cat,"glade/weapon1");#assert b.first==3167143 && b.count==2616 && b.word==2525712;
  #assert gp_catalog_row(cat,"glade/weapon6").count<0 && gp_catalog_row(cat,"glade/weapon").count<0;
}

// Copy the kit out of `glade` (an uncompressed glade.pack's bytes) into w. Its indices count from
// `shift`: where w's vertices land, counted from the vertex base the target's weapon records use.
gp_weapon_meshes :: (w:[]Gp,glade:[]u8,shift:int,first:[]int,count:[]int)->bool {
  if glade.count<32 || cast(string)glade[0..<4]!="VPK1" {return false;}
  table:=gl_u32(glade,16);entries:=gl_u32(glade,4);
  if table!=32 || entries<3 || glade[table]!=1 || glade[table+48]!=2 || glade[table+96]!=3 {return false;}
  cat:=cast(string)glade[gl_u32(glade,table+4)..<gl_u32(glade,table+4)+gl_u32(glade,table+8)];
  vat:=gl_u32(glade,table+48+4);vn:=gl_u32(glade,table+48+8);iat:=gl_u32(glade,table+96+4);in:=gl_u32(glade,table+96+8);
  for k:0..<GP_WEAPON_KIT.count {
    pb:[32]u8;s:[1]Sb;s[0]=sb(pb[..]);sb_put(s[..],"glade/weapon");sb_int(s[..],GP_WEAPON_KIT[k]);
    r:=gp_catalog_row(cat,sb_text(s[..]));
    if r.count<=0 || r.count%3!=0 || (r.first+r.count)*4>in || r.word%8!=0 {return false;}
    lo:=1<<30;hi:=-1;
    for q:0..<r.count {v:=r.word/8+gl_u32(glade,iat+(r.first+q)*4);if v<lo {lo=v;}if v>hi {hi=v;}}
    if (hi+1)*32>vn || w[0].nv+hi-lo+1>GP_VERTS {return false;}
    base:=w[0].nv;
    for v:lo..<hi+1 {
      at:=vat+v*32;to:=w[0].nv*32;for b:0..<32 {w[0].v[to+b]=glade[at+b];}
      gp_word(w[0].v[..],to+12,(cast(u32)gl_u32(glade,at+12)&0x00ffffff)|(cast(u32)GP_WEAPON_KIND<<24));
      gp_word(w[0].v[..],to+24,0);gp_word(w[0].v[..],to+28,f32_bits(1));w[0].nv+=1;
    }
    first[k]=w[0].ni;
    for t:0..<r.count/3 {
      c:[3]int;for j:0..<3 {c[j]=shift+base+r.word/8+gl_u32(glade,iat+(r.first+t*3+j)*4)-lo;}
      gp_tri(w,c[0],c[1],c[2]);
    }
    count[k]=w[0].ni-first[k];
  }
  return true;
}

gp_weapon_catalog :: (c:[]Sb,first:[]int,count:[]int,index_base:int,vertex_word:int) {
  for k:0..<GP_WEAPON_KIT.count {
    sb_put(c,"C glade/weapon");sb_int(c,GP_WEAPON_KIT[k]);sb_byte(c,' ');
    sb_int(c,index_base+first[k]);sb_byte(c,' ');sb_int(c,count[k]);
    sb_byte(c,' ');sb_int(c,GP_WEAPON_SOURCE);
    sb_byte(c,' ');sb_int(c,vertex_word);sb_put(c," 0 0\n");
  }
}
