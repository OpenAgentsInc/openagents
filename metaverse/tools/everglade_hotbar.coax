// Everglade's spell bar art, as the previous engine drew it.
//
//   coax/web/tool.sh metaverse/tools/everglade_hotbar.coax
//
// The old engine's Everglade bar (`git show 0b401561a0^:crates/verse-zone-everglade/
// src/zones/everglade/hotbar.rs`) drew each slot as a game-icons.net SVG, rasterized white,
// tinted and laid over a dark slot (`crates/verse-content/src/compiler/icons.rs` rasterize), its
// key in Paper Mono, and a slot's card (`crates/verse-core/src/tooltip.rs`) in Paper Mono on a
// dark notched panel. The page draws pictures through the host's media (coax/web/host.js
// coaxial_media), so this writes those pictures (the drawing is hotbar.coax's):
//
//   apps/openagents-web/realms/everglade/hotbar/NAME-SIZE.jpg      a slot's icon and key, SIZE px a side
//   apps/openagents-web/realms/everglade/hotbar/NAME-bare-SIZE.jpg the icon without its key, for a slot moved
//   apps/openagents-web/realms/everglade/hotbar/key-R-C-SIZE.jpg   the key tab of row R, column C, drawn over a moved slot
//   apps/openagents-web/realms/everglade/hotbar/NAME-card-Sx.jpg   a slot's card at S device px a CSS px
//   apps/openagents-web/old/v1/everglade-hotbar.coax                       their names and sizes, for the page
//
// The druid's bar, the Warlock's (wl-*) and Character Create's classes' slot 1 (cl-*, #13024).
//
// It needs rsvg-convert. The icons' credits are in assets/metaverse/icons/game-icons/CREDITS.md, and
// the realm's licences page lists them.
//
// It replaced everglade_hotbar.py (#12859). On the same inputs it writes the same files and the
// same table, except the text: the Python drew Paper Mono through FreeType, which ran the font's
// hinting instructions, and hotbar.coax draws the outlines as they are. Measured on every picture
// (decoded, against the Python's): the bare icons are the same bytes; on the cards, key tabs and
// keyed icons, pixels differ by a mean of 2.2 levels a channel, 1.3% of channels by more than 48
// (single pixels at glyph edges, up to 227).
#import "Basic";
#load "hotbar.coax";

EG_OUT :: "apps/openagents-web/realms/everglade/hotbar";
EG_TABLE :: "apps/openagents-web/old/v1/everglade-hotbar.coax";
// The keys' labels by place (row * 12 + column): the row's modifier and the column's key. A slot
// moved on the bar (everglade-arrange.coax) takes the key of the place it is moved to.
EG_ROW_MARK :: [4] string.["", "S", "C", "A"];
EG_COL_KEY :: "1234567890-=";

// Each slot in the bar's order: its name, SVG, tint, key, card title, sentence and details.
// The four spells' sentences and details are the old dev bar's (hotbar.rs SLOTS), with this
// realm's cast bars (everglade/legacy/v1/srd5.coax) and reach. Tints are icons.rs's.
eg_slots :: (s: [] HbSlot) -> int {
  s[0] = HbSlot.{name = "meteor-swarm", svg = "lorc/meteor-impact.svg", tint = [3] f64.[1.0, 0.42, 0.18], key = "1", title = "Meteor Swarm",
    body = "Calls down six blazing meteors on a circle of ground you choose, blasting apart the town's buildings they reach; R restores the town.",
    n = 4, dt = [6] string.["Key 1", "No mana, no cooldown", "2.5 s cast", "140 m range", "", ""], dc = [6] int.[0, 1, 2, 3, 0, 0]};
  s[1] = HbSlot.{name = "thunderbolt", svg = "lorc/lightning-frequency.svg", tint = [3] f64.[1.0, 0.9, 0.5], key = "2", title = "Thunderbolt",
    body = "Calls one huge bolt of lightning down on the wall or ground you choose, blasting a hole through the building it strikes; R restores the town.",
    n = 4, dt = [6] string.["Key 2", "No mana, no cooldown", "1.2 s cast", "140 m range", "", ""], dc = [6] int.[0, 1, 2, 3, 0, 0]};
  s[2] = HbSlot.{name = "mega-thunderbolt", svg = "lorc/lightning-frequency.svg", tint = [3] f64.[0.82, 0.48, 1.0], key = "3", title = "Mega Thunderbolt",
    body = "Calls down a bolt five times as destructive as the Thunderbolt on the wall or ground you choose, tearing through the building it strikes; R restores the town.",
    n = 4, dt = [6] string.["Key 3", "No mana, no cooldown", "0.5 s cast", "140 m range", "", ""], dc = [6] int.[0, 1, 2, 3, 0, 0]};
  s[3] = HbSlot.{name = "water-orb", svg = "lorc/frozen-orb.svg", tint = [3] f64.[0.35, 0.72, 1.0], key = "4", title = "Water Orb",
    body = "Gathers an orb of water over you and throws it at the spot you choose, where it bursts and sends loose things rolling without breaking them.",
    n = 4, dt = [6] string.["Key 4", "No mana, no cooldown", "0.6 s cast", "140 m range", "", ""], dc = [6] int.[0, 1, 2, 3, 0, 0]};
  s[4] = HbSlot.{name = "reverse-gravity", svg = "delapouite/gravitation.svg^", tint = [3] f64.[0.76, 0.62, 1.0], key = "5", title = "Reverse Gravity",
    body = "Gravity flips in a 50-foot cylinder around you: you, the loose things in it and the townsfolk who fail to grab hold fall upward and hover near its top until you press again.",
