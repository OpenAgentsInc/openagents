  s[41] = HbSlot.{name = "speak-with-animals", svg = "lorc/parrot-head.svg", tint = [3] f64.[0.9, 0.6, 1.0], key = "A9", title = "Speak with Animals",
    body = "For 10 minutes you understand the town's beasts and they you: the cats, the ducks and any frog say their piece. Press again to end it.",
    n = 4, dt = [6] string.["Alt+9", "No mana, no cooldown", "Ritual", "10 minutes", "", ""], dc = [6] int.[0, 1, 3, 2, 0, 0]};
  s[42] = HbSlot.{name = "wild-resurgence", svg = "lorc/cycle.svg", tint = [3] f64.[0.45, 0.95, 0.4], key = "A0", title = "Wild Resurgence",
    body = "A spell slot spent for a use of Wild Shape, taken at once: you are a wolf with 9 temporary hit points, a bite at whoever you click in reach. Press again to end it.",
    n = 3, dt = [6] string.["Alt+0", "No mana, no cooldown", "No action", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[43] = HbSlot.{name = "ray-of-frost", svg = "lorc/fire-ray.svg", tint = [3] f64.[0.65, 0.92, 1.0], key = "A-", title = "Ray of Frost",
    body = "Click someone within 60 feet: a spell attack, 2d8 cold on a hit, and their speed is 10 feet less until your next turn. It stays picked, a ray each second.",
    n = 4, dt = [6] string.["Alt+-", "No mana, no cooldown", "60 ft range", "Cantrip", "", ""], dc = [6] int.[0, 1, 3, 3, 0, 0]};
  s[44] = HbSlot.{name = "fog-cloud", svg = "lorc/dust-cloud.svg", tint = [3] f64.[0.72, 0.86, 1.0], key = "A=", title = "Fog Cloud",
    body = "A sphere of fog 20 feet round where you click: no one sees through it, the watch neither. In it, they lose you. Press again to end it.",
    n = 4, dt = [6] string.["Alt+=", "No mana, no cooldown", "120 ft range", "Concentration, up to 1 hour", "", ""], dc = [6] int.[0, 1, 3, 2, 0, 0]};
  s[45] = HbSlot.{name = "hold-person", svg = "delapouite/frozen-body.svg", tint = [3] f64.[0.76, 0.62, 1.0], key = "=", title = "Hold Person",
    body = "Click someone within 60 feet: a Wisdom save or they are paralyzed, still as stone, and your attacks at them have advantage. They save again each round. Press again to end it.",
    n = 4, dt = [6] string.["Key =", "No mana, no cooldown", "60 ft range", "Concentration, up to 1 minute", "", ""], dc = [6] int.[0, 1, 3, 2, 0, 0]};
  s[46] = HbSlot.{name = "cone-of-cold", svg = "lorc/icicles-aura.svg", tint = [3] f64.[0.65, 0.92, 1.0], key = "S=", title = "Cone of Cold",
    body = "A 60-foot cone of frost from you the way you click: 8d8 cold to each creature in it, half on a Constitution save.",
    n = 3, dt = [6] string.["Shift+=", "No mana, no cooldown", "60 ft cone", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[47] = HbSlot.{name = "rebuild", svg = "lorc/claw-hammer.svg", tint = [3] f64.[0.86, 0.7, 0.36], key = "R", title = "Repair",
    body = "Face something broken or burning within 60 feet: a building, a house, a stretch of the palisade, a tree, a placed crate. After a moment's work it stands whole again, for everyone. Moving or getting hurt stops it.",
    n = 3, dt = [6] string.["Key R", "60 ft range", "1.5 s · again after 8 s", "", "", ""], dc = [6] int.[0, 3, 2, 0, 0, 0]};
  s[48] = HbSlot.{name = "next-row", svg = "delapouite/plain-arrow.svg^", tint = [3] f64.[0.76, 0.62, 1.0], key = "", title = "Next row",
    body = "Shows the bar's next row of spells.",
    n = 0, dt = [6] string.["", "", "", "", "", ""], dc = [6] int.[0, 0, 0, 0, 0, 0]};
  return 49;
}
eg_warlock :: (s: [] HbSlot) -> int {
  s[0] = HbSlot.{name = "wl-eldritch-blast", svg = "lorc/beam-wake.svg", tint = [3] f64.[0.78, 0.5, 1.0], key = "1", title = "Eldritch Blast",
    body = "Four beams of crackling force at the creature or spot you choose, each its own ranged spell attack: 1d10 + 5 Force on a hit (Agonizing Blast). The beams break the walls and roofs they strike.",
    n = 3, dt = [6] string.["Key 1", "No mana, no cooldown", "Cantrip · 120 ft", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[1] = HbSlot.{name = "wl-fireball", svg = "lorc/fireball.svg", tint = [3] f64.[1.0, 0.55, 0.2], key = "2", title = "Fireball",
    body = "A bright streak bursts in a 20-foot-radius sphere at the point you choose: 10d6 Fire to each creature in it, half on a Dexterity save. It sets alight the flammable things it reaches.",
    n = 3, dt = [6] string.["Key 2", "No mana, no cooldown", "5th-level slot · 150 ft", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[2] = HbSlot.{name = "wl-blight", svg = "lorc/dust-cloud.svg", tint = [3] f64.[0.62, 0.92, 0.55], key = "3", title = "Blight",
    body = "Necromantic energy washes over one creature you choose within 30 feet: 9d8 Necrotic, half on a Constitution save.",
    n = 3, dt = [6] string.["Key 3", "No mana, no cooldown", "5th-level slot · 30 ft", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[3] = HbSlot.{name = "wl-circle-of-death", svg = "lorc/fire-ring.svg", tint = [3] f64.[0.62, 0.92, 0.55], key = "4", title = "Circle of Death",
    body = "Negative energy ripples out in a 60-foot-radius sphere from the point you choose: 8d8 Necrotic to each creature in it, half on a Constitution save.",
    n = 3, dt = [6] string.["Key 4", "No mana, no cooldown", "Mystic Arcanum · 150 ft", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[4] = HbSlot.{name = "wl-finger-of-death", svg = "lorc/spectre.svg", tint = [3] f64.[0.62, 0.92, 0.55], key = "5", title = "Finger of Death",
    body = "7d8 + 30 Necrotic to one creature you choose within 60 feet, half on a Constitution save. A Humanoid it kills rises at the start of your next turn as your Zombie, and goes for whoever you next aim harm at.",
    n = 3, dt = [6] string.["Key 5", "No mana, no cooldown", "Mystic Arcanum · 60 ft", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[5] = HbSlot.{name = "wl-dimension-door", svg = "lorc/vortex.svg", tint = [3] f64.[0.78, 0.5, 1.0], key = "6", title = "Dimension Door",
    body = "You teleport to the spot you choose within 500 feet, a rooftop too.",
    n = 3, dt = [6] string.["Key 6", "No mana, no cooldown", "5th-level slot · 500 ft", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[6] = HbSlot.{name = "wl-rebuild", svg = "lorc/claw-hammer.svg", tint = [3] f64.[0.86, 0.7, 0.36], key = "R", title = "Repair",
    body = "Face something broken or burning within 60 feet: a building, a house, a stretch of the palisade, a tree, a placed crate. After a moment's work it stands whole again, for everyone. Moving or getting hurt stops it.",
    n = 3, dt = [6] string.["Key R", "60 ft range", "1.5 s · again after 8 s", "", "", ""], dc = [6] int.[0, 3, 2, 0, 0, 0]};
  s[7] = HbSlot.{name = "wl-chill-touch", svg = "lorc/glowing-hands.svg", tint = [3] f64.[0.62, 0.92, 0.55], key = "7", title = "Chill Touch",
    body = "The chill of the grave in your hand: a melee spell attack against a creature within reach, 1d10 Necrotic on a hit, more dice at levels 5, 11 and 17, and it can't regain Hit Points until the end of your next turn.",
    n = 3, dt = [6] string.["Key 7", "No mana, no cooldown", "Cantrip · Touch", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  s[8] = HbSlot.{name = "wl-hex", svg = "lorc/pentagram-rose.svg", tint = [3] f64.[0.78, 0.5, 1.0], key = "8", title = "Hex",
    body = "A Bonus Action: you curse a creature you can see within 90 feet. While you concentrate, your attacks that hit it deal 1d6 more Necrotic, and it has Disadvantage on checks with one ability you choose.",
    n = 3, dt = [6] string.["Key 8", "No mana, no cooldown", "1st-level slot · 90 ft", "", "", ""], dc = [6] int.[0, 1, 3, 0, 0, 0]};
  return 9;
}

// Character Create's twelve classes (everglade-classes.coax, #13024): each class's slot 1, its SRD 5.2.1
// cantrip or signature level 1 action, key 1. Its text is the SRD's, cut to what the slot does here.
eg_classes :: (s: [] HbSlot) -> int {
  s[0] = HbSlot.{name = "cl-rage", svg = "delapouite/angry-eyes.svg", tint = [3] f64.[1.0, 0.42, 0.3], key = "1", title = "Rage",
    body = "A Bonus Action: you fly into a Rage. While it lasts you have Resistance to Bludgeoning, Piercing and Slashing damage, +2 damage on attacks that use Strength, and Advantage on Strength checks and saving throws.",
    n = 3, dt = [6] string.["Key 1", "Bonus Action · Self", "Barbarian level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[1] = HbSlot.{name = "cl-vicious-mockery", svg = "lorc/screaming.svg", tint = [3] f64.[0.95, 0.5, 0.9], key = "1", title = "Vicious Mockery",
    body = "You unleash a string of insults at a creature you can see within 60 feet. It makes a Wisdom saving throw; on a failure it takes 1d6 Psychic damage and has Disadvantage on its next attack roll before the end of its next turn.",
    n = 3, dt = [6] string.["Key 1", "Cantrip · 60 ft", "Bard level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[2] = HbSlot.{name = "cl-sacred-flame", svg = "lorc/sun-radiations.svg", tint = [3] f64.[1.0, 0.9, 0.55], key = "1", title = "Sacred Flame",
    body = "Flame-like radiance descends on a creature you can see within 60 feet. It makes a Dexterity saving throw; on a failure it takes 1d8 Radiant damage. Cover doesn't protect it.",
    n = 3, dt = [6] string.["Key 1", "Cantrip · 60 ft", "Cleric level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[3] = HbSlot.{name = "cl-starry-wisp", svg = "lorc/star-swirl.svg", tint = [3] f64.[0.7, 0.82, 1.0], key = "1", title = "Starry Wisp",
    body = "You launch a mote of light at a creature or object within 60 feet: a ranged spell attack, 1d8 Radiant damage on a hit. Until the end of your next turn it glows with Dim Light in a 10-foot radius and can't go Invisible.",
    n = 3, dt = [6] string.["Key 1", "Cantrip · 60 ft", "Druid level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[4] = HbSlot.{name = "cl-second-wind", svg = "lorc/heart-bottle.svg", tint = [3] f64.[0.6, 0.88, 1.0], key = "1", title = "Second Wind",
    body = "A Bonus Action: you draw on a limited well of physical and mental stamina and regain Hit Points equal to 1d10 plus your Fighter level.",
    n = 3, dt = [6] string.["Key 1", "Bonus Action · Self", "Fighter level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[5] = HbSlot.{name = "cl-martial-arts", svg = "lorc/punch-blast.svg", tint = [3] f64.[1.0, 0.82, 0.5], key = "1", title = "Martial Arts",
    body = "An Unarmed Strike at a creature within 5 feet: your Martial Arts die, 1d6, plus your Dexterity modifier in Bludgeoning damage on a hit.",
    n = 3, dt = [6] string.["Key 1", "Action · 5 ft", "Monk level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[6] = HbSlot.{name = "cl-lay-on-hands", svg = "zeromancer/heart-plus.svg", tint = [3] f64.[1.0, 0.85, 0.4], key = "1", title = "Lay On Hands",
    body = "A Bonus Action: you touch a creature and draw on your pool of healing, 5 times your Paladin level, to restore Hit Points to it. Here it heals you.",
    n = 3, dt = [6] string.["Key 1", "Bonus Action · Self", "Paladin level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[7] = HbSlot.{name = "cl-hunters-mark", svg = "lorc/on-target.svg", tint = [3] f64.[0.5, 0.95, 0.55], key = "1", title = "Hunter's Mark",
    body = "A Bonus Action: you magically mark a creature you can see within 90 feet as your quarry. While you concentrate, you deal an extra 1d6 Force damage to it whenever you hit it with an attack roll.",
    n = 3, dt = [6] string.["Key 1", "1st-level slot · 90 ft", "Ranger level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[8] = HbSlot.{name = "cl-sneak-attack", svg = "lorc/cloak-dagger.svg", tint = [3] f64.[0.66, 0.45, 0.95], key = "1", title = "Sneak Attack",
    body = "A Shortbow shot at a creature within 80 feet. Once a turn, an attack with Advantage, or with an ally of yours next to the target, deals an extra 1d6 damage.",
    n = 3, dt = [6] string.["Key 1", "Action · 80 ft", "Rogue level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[9] = HbSlot.{name = "cl-sorcerer-fire-bolt", svg = "lorc/fire-ray.svg", tint = [3] f64.[1.0, 0.55, 0.2], key = "1", title = "Fire Bolt",
    body = "You hurl a mote of fire at a creature or object within 120 feet: a ranged spell attack, 1d10 Fire damage on a hit. A flammable object hit by it starts burning if it isn't being worn or carried.",
    n = 3, dt = [6] string.["Key 1", "Cantrip · 120 ft", "Sorcerer level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[10] = HbSlot.{name = "cl-eldritch-blast", svg = "lorc/beam-wake.svg", tint = [3] f64.[0.78, 0.5, 1.0], key = "1", title = "Eldritch Blast",
    body = "A beam of crackling energy at a creature or object within 120 feet: a ranged spell attack, 1d10 Force damage on a hit. It makes more beams at levels 5, 11 and 17.",
    n = 3, dt = [6] string.["Key 1", "Cantrip · 120 ft", "Warlock level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  s[11] = HbSlot.{name = "cl-wizard-fire-bolt", svg = "lorc/wizard-staff.svg", tint = [3] f64.[1.0, 0.55, 0.2], key = "1", title = "Fire Bolt",
    body = "You hurl a mote of fire at a creature or object within 120 feet: a ranged spell attack, 1d10 Fire damage on a hit. A flammable object hit by it starts burning if it isn't being worn or carried.",
    n = 3, dt = [6] string.["Key 1", "Cantrip · 120 ft", "Wizard level 1", "", "", ""], dc = [6] int.[0, 3, 1, 0, 0, 0]};
  return 12;
}

// These never move: R's Repair and a phone's row switcher keep no bare icon.
eg_moves :: (name: string) -> bool { return name == "rebuild" || name == "next-row"; }

eg_card_sizes :: (hb: []Hb, buf: []u8, dir: string, slots: []HbSlot, ws: []int, hs: []int, at: []int) -> bool {
  scales := HB_SCALES; sizes := HB_SIZES;
  for s: slots {
    nm: [256] u8;
    for size: sizes {
      d: [24] u8; t: [1] HbText; hb_put(t[..], s.name); hb_put(t[..], "-"); hb_put(t[..], hb_int(d[..], size)); hb_put(t[..], ".jpg");
      if !hb_save(hb, hb_icon(hb, buf, s.svg, s.tint, s.key, size, false), dir, cast(string) t[0].b[0..<t[0].n]) { return false; }
    }
    for sc: scales {
      d: [24] u8; t: [1] HbText; hb_put(t[..], s.name); hb_put(t[..], "-card-"); hb_put(t[..], hb_int(d[..], sc)); hb_put(t[..], "x.jpg");
      im := hb_card(hb, buf, s.title, s.body, s.n, s.dt, s.dc, sc);
      if !hb_save(hb, im, dir, cast(string) t[0].b[0..<t[0].n]) { return false; }
      ws[at[0]] = im.w; hs[at[0]] = im.h; at[0] += 1;
    }
  }
  return true;
}

tool_main :: () -> int #export_c #effects(all) {
  hbs: [1] Hb; hb := hbs[..];
  cwd: [4096] u8; root := fs_cwd(cwd[..]);
  if !fs_exists(fs_join(root, EG_TABLE, hb[0].path[..])) { tool_errln("everglade_hotbar: run it from the repository's root"); return 2; }
  if !hb_init(hb, root) { return 1; }
  defer { ok := fs_remove(hb[0].tmp); }
  outp: [4096] u8; dir := fs_join(root, EG_OUT, outp[..]);
  if !fs_mkdir(dir) && fs_kind(dir) <= 0 { tool_errln("everglade_hotbar: can't make the hotbar directory"); return 1; }
  slots: [64] HbSlot; n := eg_slots(slots[..]);
  warlock: [16] HbSlot; wn := eg_warlock(warlock[..]);
  classes: [16] HbSlot; kn := eg_classes(classes[..]);
  buf: [12582912] u8;
  sizes := HB_SIZES;
  // bare icons beside the keyed ones, for the slots that can move
  for s: slots[0..<n] {
    if eg_moves(s.name) { continue; }
    for size: sizes {
      d: [24] u8; t: [1] HbText; hb_put(t[..], s.name); hb_put(t[..], "-bare-"); hb_put(t[..], hb_int(d[..], size)); hb_put(t[..], ".jpg");
      if !hb_save(hb, hb_icon(hb, buf[..], s.svg, s.tint, s.key, size, true), dir, cast(string) t[0].b[0..<t[0].n]) { return 1; }
    }
  }
  cw: [256] int; ch: [256] int; cn: [1] int;
  if !eg_card_sizes(hb, buf[..], dir, slots[0..<n], cw[..], ch[..], cn[..]) { return 1; }
  ww: [64] int; wh: [64] int; wcn: [1] int;
  if !eg_card_sizes(hb, buf[..], dir, warlock[0..<wn], ww[..], wh[..], wcn[..]) { return 1; }
  kw: [64] int; kh: [64] int; kcn: [1] int;
  if !eg_card_sizes(hb, buf[..], dir, classes[0..<kn], kw[..], kh[..], kcn[..]) { return 1; }
  marks := EG_ROW_MARK;
  for mark, r: marks {
    for c: 0..<EG_COL_KEY.count {
      kb: [8] u8; k := 0; for x: mark { kb[k] = x; k += 1; } kb[k] = EG_COL_KEY[c]; k += 1;
      for size: sizes {
        d: [24] u8; t: [1] HbText; hb_put(t[..], "key-"); hb_put(t[..], hb_int(d[..], r)); hb_put(t[..], "-"); hb_put(t[..], hb_int(d[..], c));
        hb_put(t[..], "-"); hb_put(t[..], hb_int(d[..], size)); hb_put(t[..], ".jpg");
        if !hb_save(hb, hb_key_tab(hb, buf[..], cast(string) kb[0..<k], size), dir, cast(string) t[0].b[0..<t[0].n]) { return 1; }
      }
    }
  }
  tw: [8] int; th: [8] int; tk := 0;
  for keyn: 1..<3 {
    for size: sizes { wh2 := hb_tab_size(hb, ifx keyn == 1 then "1" else "11", size); tw[tk] = wh2[0]; th[tk] = wh2[1]; tk += 1; }
  }
  names: [64] string; for s, i: slots[0..<n] { names[i] = s.name; }
  wnames: [16] string; for s, i: warlock[0..<wn] { wnames[i] = s.name; }
  knames: [16] string; for s, i: classes[0..<kn] { knames[i] = s.name; }
  t: [1] HbText;
  hb_put(t[..], "// Everglade's spell bar pictures (realms/everglade/hotbar/), as the previous engine drew the bar:\n");
  hb_put(t[..], "// written by metaverse/tools/everglade_hotbar.coax, do not edit. Each slot's name, the icon sizes\n");
  hb_put(t[..], "// (px a side), and each slot's card at 1x, 2x and 3x (device px, slot * 3 + scale - 1).\n");
  hb_put(t[..], "HB_SLOTS :: "); hb_put_int(t[..], n); hb_put(t[..], ";\n");
  hb_put(t[..], "HB_NAME :: "); hb_put_names(t[..], names[0..<n]);
  hb_put(t[..], "HB_SIZES :: 4;\nHB_SIZE :: "); hb_put_list(t[..], "int", sizes[..]);
  hb_put(t[..], "HB_CARD_W :: "); hb_put_list(t[..], "f32", cw[0..<cn[0]]);
  hb_put(t[..], "HB_CARD_H :: "); hb_put_list(t[..], "f32", ch[0..<cn[0]]);
  hb_put(t[..], "// A key's tab (key-R-C-SIZE.jpg, a moved slot's), px at each icon size: one character's, then two's.\n");
  hb_put(t[..], "HB_TAB_W :: "); hb_put_list(t[..], "f32", tw[0..<tk]);
  hb_put(t[..], "HB_TAB_H :: "); hb_put_list(t[..], "f32", th[0..<tk]);
  hb_put(t[..], "// The Warlock's bar (everglade-warlock.coax): its slots' names and cards, as above.\n");
  hb_put(t[..], "WL_HB_SLOTS :: "); hb_put_int(t[..], wn); hb_put(t[..], ";\n");
  hb_put(t[..], "WL_HB_NAME :: "); hb_put_names(t[..], wnames[0..<wn]);
  hb_put(t[..], "WL_HB_CARD_W :: "); hb_put_list(t[..], "f32", ww[0..<wcn[0]]);
  hb_put(t[..], "WL_HB_CARD_H :: "); hb_put_list(t[..], "f32", wh[0..<wcn[0]]);
  hb_put(t[..], "// Character Create's classes' slot 1 (everglade-classes.coax), in fivebar.coax FB_CL order, as above.\n");
  hb_put(t[..], "CL_HB_SLOTS :: "); hb_put_int(t[..], kn); hb_put(t[..], ";\n");
  hb_put(t[..], "CL_HB_NAME :: "); hb_put_names(t[..], knames[0..<kn]);
  hb_put(t[..], "CL_HB_CARD_W :: "); hb_put_list(t[..], "f32", kw[0..<kcn[0]]);
  hb_put(t[..], "CL_HB_CARD_H :: "); hb_put_list(t[..], "f32", kh[0..<kcn[0]]);
  tp: [4096] u8;
  if !fs_write(fs_join(root, EG_TABLE, tp[..]), cast(string) t[0].b[0..<t[0].n]) { tool_errln("everglade_hotbar: can't write the table"); return 1; }
  print("% slots: 4 icon sizes and 3 cards each into %\n", n, EG_OUT);
  return 0;
}
