    body = "Hold to rise up to 18 m over the ground and let go to hover there; tap while hovering to fall, or hold X to sink.",
    n = 3, dt = [6] string.["Key 7", "No mana, no cooldown", "10 minutes", "", "", ""], dc = [6] int.[0, 1, 2, 0, 0, 0]};
  s[7] = HbSlot.{name = "feather-fall", svg = "lorc/feather.svg", tint = [3] f64.[0.76, 0.62, 1.0], key = "8", title = "Feather Fall",
    body = "Cast while falling to slow your descent, and that of up to five falling townsfolk near you, to a gentle drift until you land; press again to end it.",
    n = 3, dt = [6] string.["Key 8", "No mana, no cooldown", "1 minute", "", "", ""], dc = [6] int.[0, 1, 2, 0, 0, 0]};
  s[8] = HbSlot.{name = "gust-of-wind", svg = "lorc/wind-slap.svg", tint = [3] f64.[0.6, 0.95, 0.9], key = "9", title = "Gust of Wind",
    body = "A line of strong wind 60 feet long blows from you the way you face: it pushes townsfolk 15 feet unless they stand firm, sends loose debris and floats flying, and clears smoke; press again to end it.",
