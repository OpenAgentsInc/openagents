// The hotbar pictures' drawing, shared by Everglade's bar (everglade_hotbar.coax) and 5E MMO's
// (fivemmo_hotbar.coax), as the previous engine drew its bar: a game-icons.net SVG rasterized
// white (rsvg-convert), tinted and laid over a dark slot (`crates/verse-content/src/compiler/
// icons.rs` rasterize), its key on a dark notched tab, and a slot's card
// (`crates/verse-core/src/tooltip.rs`) in Paper Mono on a dark notched panel. Pictures are
// JPEGs (quality 90, chroma at full size).
//
// It draws as Pillow drew it for the Python tools it replaces (#12859): the same sizes, wrap,
// rounding (Python's, half to even), polygon and rectangle fills, masks and blends, and the same
// JPEG bytes for the same pixels. Text is the one difference: coax/lib/text/ttf.coax draws Paper
// Mono without running its hinting instructions, where FreeType ran them, so a glyph's edges can
// sit a fraction of a pixel apart (see everglade_hotbar.coax for the measured tolerance).
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/image/png.coax";
#load "../../coax/lib/image/jpeg_enc.coax";
#load "../../coax/lib/text/ttf.coax";

HB_FONT :: "assets/metaverse/fonts/paper-mono/PaperMono-Medium.ttf";
HB_ICONS :: "assets/metaverse/icons/game-icons";
HB_PADDING :: 0.12;                 // icons.rs PADDING
HB_SIZES :: [4] int.[48, 72, 96, 128];
HB_SCALES :: [3] int.[1, 2, 3];
HB_MAX_PX :: 4194304;               // the largest picture, pixels
// tooltip.rs metrics, in CSS px at 1x
HB_MAX_WIDTH :: 360.0; HB_PAD_X :: 9.0; HB_PAD_Y :: 7.0; HB_GAP :: 3.0; HB_FONT_PX :: 14.0;
// A detail's colour: the key's, mana's, time's or a rule's (tooltip.rs palette); the separator.
HB_KEY :: 0; HB_MANA :: 1; HB_TIME :: 2; HB_RULE :: 3; HB_SEPARATOR :: 4;

// A slot: its name, SVG (ending in "^": drawn upside down), tint, key, card title, sentence and
// details (text and colour each).
HbSlot :: struct { name: string; svg: string; tint: [3] f64; key: string; title: string; body: string; n: int; dt: [6] string; dc: [6] int; }

// An RGB picture in a caller's buffer.
HbImg :: struct { px: []u8; w: int; h: int; }
Hb :: struct {
  root: string; tmp: string;
  font: TtfFont; font_data: [1048576] u8;
  raster: [1] TtfRaster;
  mask: [HB_MAX_PX] u8;          // a text line's coverage, or a tab's
  png: [4194304] u8; png_work: [8388608] u8; png_rgba: [4194304] u8;
  jpg: [8388608] u8;
  path: [4096] u8; path2: [4096] u8;
  failed: bool;
}

// Python's round(): to the nearest whole number, a half to the even one.
hb_round :: (x: f64) -> int {
  f := floor(x); d := x - f; i := cast(int) f;
  if d > 0.5 { return i + 1; }
  if d < 0.5 { return i; }
  return ifx i % 2 == 0 then i else i + 1;
}
hb_ceil :: (x: f64) -> int { f := floor(x); i := cast(int) f; return ifx f < x then i + 1 else i; }
// A colour channel (0..1) as a byte, as the Python's byte().
hb_byte :: (v: f64) -> int { r := hb_round(v * 255.0); return ifx r < 0 then 0 else (ifx r > 255 then 255 else r); }
// The old HUD's colours are linear: its batch wrote them to an sRGB target, which encoded them.
hb_srgb :: (c: f64) -> f64 { return ifx c <= 0.0031308 then 12.92 * c else 1.055 * pow(c, 1.0 / 2.4) - 0.055; }
hb_colour :: (k: int) -> [3] f64 {
  if k == HB_KEY { return [3] f64.[0.78, 0.68, 0.48]; }
  if k == HB_MANA { return [3] f64.[0.62, 0.78, 1.0]; }
  if k == HB_TIME { return [3] f64.[0.64, 0.8, 0.5]; }
  if k == HB_RULE { return [3] f64.[0.8, 0.7, 0.95]; }
  return [3] f64.[0.46, 0.39, 0.24];
}
// Characters in UTF-8 text (Python's len), and the bytes of its first n characters.
hb_chars :: (s: string) -> int { n := 0; for c: s { if (cast(int) c & 192) != 128 { n += 1; } } return n; }
hb_prefix :: (s: string, n: int) -> int {
  k := 0; i := 0;
  while i < s.count {
    if (cast(int) s[i] & 192) != 128 { if k == n { return i; } k += 1; }
    i += 1;
  }
  return s.count;
}

hb_init :: (hb: []Hb, root: string) -> bool {
  hb[0].root = root;
  f := fs_join(root, HB_FONT, hb[0].path[..]);
  n := fs_read(f, hb[0].font_data[..]);
  if n <= 0 { tool_errln("hotbar: can't read the font"); return false; }
  hb[0].font = ttf_open(hb[0].font_data[0..<n]);
  if !hb[0].font.ok { tool_errln("hotbar: the font isn't TrueType"); return false; }
  hb[0].tmp = fs_temp("hotbar-", hb[0].path2[..]);
  return hb[0].tmp != "";
}

// ---- text: the atlas's metrics at px (ui.rs rasterize) and a line drawn
HbMetrics :: struct { px: int; advance: int; line: int; ascent: int; }
hb_metrics :: (hb: []Hb, px: int) -> HbMetrics {
  f := hb[0].font; m: HbMetrics; m.px = px;
  m.advance = hb_ceil(cast(f64) ttf_advance26(f, ttf_glyph(f, 'M'), px) / 64.0);
  m.line = hb_ceil(cast(f64) (px * (f.ascender - f.descender + f.line_gap)) / cast(f64) f.upm);
  m.ascent = hb_ceil(cast(f64) (px * f.ascender) / cast(f64) f.upm);
  return m;
}
// Pillow's BLEND: (a * (255 - m) + b * m) / 255, rounded as its DIV255.
hb_blend :: (m: int, a: int, b: int) -> int { t := a * (255 - m) + b * m + 128; return ((t >> 8) + t) >> 8; }
// ui.rs text: the pen at x, the baseline at y + ascent, both whole pixels.
hb_text :: (hb: []Hb, im: HbImg, m: HbMetrics, x: f64, y: f64, line: string, colour: [3] f64) {
  px := hb_round(x); base := hb_round(y + cast(f64) m.ascent);
  y0 := base - 2 * m.px; if y0 < 0 { y0 = 0; }
  y1 := base + 2 * m.px; if y1 > im.h { y1 = im.h; }
  if y1 <= y0 { return; }
  for i: y0 * im.w..<y1 * im.w { hb[0].mask[i] = 0; }
  mk: TtfMask; mk.px = hb[0].mask[0..<im.w * im.h]; mk.w = im.w; mk.h = im.h;
  pen := ttf_text(hb[0].font, line, m.px, px, base, mk, hb[0].raster[..]);
  ink: [3] int; for c: 0..<3 { ink[c] = hb_byte(hb_srgb(colour[c])); }
  for i: y0 * im.w..<y1 * im.w {
    a := cast(int) hb[0].mask[i];
    if a == 0 { continue; }
    for c: 0..<3 { im.px[3 * i + c] = cast(u8) hb_blend(a, cast(int) im.px[3 * i + c], ink[c]); }
  }
}

// ---- fills, as Pillow's ImageDraw fills
hb_fill :: (im: HbImg, rgb: [3] int) { for i: 0..<im.w * im.h { for c: 0..<3 { im.px[3 * i + c] = cast(u8) rgb[c]; } } }
// rectangle([x0, y0, x1, y1]), both corners inside
hb_rect :: (im: HbImg, x0_in: int, y0_in: int, x1_in: int, y1_in: int, rgb: [3] int) {
  x0 := ifx x0_in < 0 then 0 else x0_in; x1 := ifx x1_in >= im.w then im.w - 1 else x1_in;
  y0 := ifx y0_in < 0 then 0 else y0_in; y1 := ifx y1_in >= im.h then im.h - 1 else y1_in;
  for y: y0..<y1 + 1 { for x: x0..<x1 + 1 { for c: 0..<3 { im.px[3 * (y * im.w + x) + c] = cast(u8) rgb[c]; } } }
}
// A row of a one-byte mask from x0 to x1, clipped (Draw.c hline8).
hb_hline :: (mask: []u8, w: int, h: int, x0_in: int, y: int, x1_in: int, ink: int) {
  if y < 0 || y >= h { return; }
  x0 := x0_in; x1 := x1_in;
  if x0 < 0 { x0 = 0; } else if x0 >= w { return; }
  if x1 < 0 { return; } else if x1 >= w { x1 = w - 1; }
  for x: x0..<x1 + 1 { mask[y * w + x] = cast(u8) ink; }
}
HbEdge :: struct { xmin: int; xmax: int; ymin: int; ymax: int; x0: int; y0: int; dx: f32; }
hb_edge :: (x0: int, y0: int, x1: int, y1: int) -> HbEdge {
  e: HbEdge;
  e.xmin = ifx x0 <= x1 then x0 else x1; e.xmax = ifx x0 <= x1 then x1 else x0;
  e.ymin = ifx y0 <= y1 then y0 else y1; e.ymax = ifx y0 <= y1 then y1 else y0;
  e.dx = ifx y0 == y1 then 0.0f32 else cast(f32) (x1 - x0) / cast(f32) (y1 - y0);
  e.x0 = x0; e.y0 = y0;
  return e;
}
hb_roundf :: (x: f32) -> f32 { return ifx x >= 0.0 then floor(x + 0.5f32) else -floor(-x + 0.5f32); }
hb_round_up :: (f: f32) -> int { return ifx f >= 0.0 then cast(int) floor(f + 0.5f32) else -(cast(int) floor(abs(f) + 0.5f32)); }
hb_round_down :: (f: f32) -> int {
  if f >= 0.0 { g := f - 0.5f32; c := floor(g); if c < g { c += 1.0; } return cast(int) c; }
  g := abs(f) - 0.5f32; c := floor(g); if c < g { c += 1.0; } return -(cast(int) c);
}
hb_at :: (e: HbEdge, y: int) -> f32 { return cast(f32) (y - e.y0) * e.dx + cast(f32) e.x0; }
// A filled polygon (whole-pixel points) into a one-byte mask: Draw.c ImagingDrawPolygon and
// polygon_generic, the scan line with its corner rules, in floats as there.
hb_polygon :: (mask: []u8, w: int, h: int, xs: []int, ys: []int, ink: int) {
  n := xs.count; e: [32] HbEdge; k := 0;
  i := 0;
  while i < n - 1 {
    x0 := xs[i]; y0 := ys[i]; x1 := xs[i + 1]; y1 := ys[i + 1];
    if y0 == y1 && i != 0 && y0 == ys[i - 1] {
      if x1 > x0 && x0 > xs[i - 1] { e[k - 1].xmax = x1; i += 1; continue; }
      if x1 < x0 && x0 < xs[i - 1] { e[k - 1].xmin = x1; i += 1; continue; }
    }
    e[k] = hb_edge(x0, y0, x1, y1); k += 1; i += 1;
  }
  if xs[i] != xs[0] || ys[i] != ys[0] { e[k] = hb_edge(xs[i], ys[i], xs[0], ys[0]); k += 1; }
  table: [32] int; tn := 0; ymin := h - 1; ymax := 0;
  for j: 0..<k {
    if ymin > e[j].ymin { ymin = e[j].ymin; }
    if ymax < e[j].ymax { ymax = e[j].ymax; }
    if e[j].ymin == e[j].ymax { hb_hline(mask, w, h, e[j].xmin, e[j].ymin, e[j].xmax, ink); continue; }
    table[tn] = j; tn += 1;
  }
  if ymin < 0 { ymin = 0; }
  if ymax > h { ymax = h; }
  hits: [64] f32;
  y := ymin;
  while y <= ymax {
    jn := 0;
    for t: 0..<tn {
      cur := e[table[t]];
      if y >= cur.ymin && y <= cur.ymax {
        hits[jn] = hb_at(cur, y); jn += 1;
        if y == cur.ymax && y < ymax { hits[jn] = hits[jn - 1]; jn += 1; }
        else if (y == cur.ymin || y == cur.ymax) && cur.dx != 0.0 {
          for o: 0..<t {
            other := e[table[o]];
            if (y != other.ymin && y != other.ymax) || other.dx == 0.0 { continue; }
            if hb_roundf(hits[jn - 1]) == hb_roundf(hb_at(other, y)) {
              off := ifx y == cur.ymax then -1 else 1;
              adj := hb_at(cur, y + off);
              if y + off >= other.ymin && y + off <= other.ymax {
                adj2 := hb_at(other, y + off);
                if hits[jn - 1] > adj + 1.0 && hits[jn - 1] > adj2 + 1.0 { hits[jn - 1] = hb_roundf(ifx adj > adj2 then adj else adj2) + 1.0; }
                else if hits[jn - 1] < adj - 1.0 && hits[jn - 1] < adj2 - 1.0 { hits[jn - 1] = hb_roundf(ifx adj < adj2 then adj else adj2) - 1.0; }
                break;
              }
            }
          }
        }
      }
    }
    // sorted (insertion; qsort's order of equal values doesn't matter)
    for a: 1..<jn { v := hits[a]; b := a - 1; while b >= 0 && hits[b] > v { hits[b + 1] = hits[b]; b -= 1; } hits[b + 1] = v; }
    q := 1;
    while q < jn { hb_hline(mask, w, h, hb_round_up(hits[q - 1]), y, hb_round_down(hits[q]), ink); q += 2; }
    y += 1;
  }
}

// ---- tabs, icons and cards
hb_tab_px :: (size: int) -> int { s := cast(f64) size / 36.0; p := hb_round(8.5 * s); return ifx p < 7 then 7 else p; }
// The dark tab a key sits on, px: its width and height at an icon size px a side.
hb_tab_size :: (hb: []Hb, key: string, size: int) -> [2] int {
  s := cast(f64) size / 36.0; m := hb_metrics(hb, hb_tab_px(size));
  return [2] int.[m.advance * hb_chars(key) + hb_round(3.0 * s), m.ascent + hb_round(2.2 * s)];
}
hb_draw_tab :: (hb: []Hb, im: HbImg, key: string, size: int) {
  s := cast(f64) size / 36.0; m := hb_metrics(hb, hb_tab_px(size));
  wh := hb_tab_size(hb, key, size); w := wh[0]; h := wh[1];
  for i: 0..<im.w * im.h { hb[0].mask[i] = 0; }
  cut := hb_round(2.5 * s);
  xs := [5] int.[0, w, w, w - cut, 0]; ys := [5] int.[0, 0, h - cut, h, h];
  hb_polygon(hb[0].mask[0..<im.w * im.h], im.w, im.h, xs[..], ys[..], hb_round(255.0 * 0.82));
  dark := [3] int.[hb_byte(0.03), hb_byte(0.035), hb_byte(0.045)];
  for i: 0..<im.w * im.h {
    a := cast(int) hb[0].mask[i];
    for c: 0..<3 { im.px[3 * i + c] = cast(u8) hb_blend(a, cast(int) im.px[3 * i + c], dark[c]); }
  }
  hb_text(hb, im, m, cast(f64) hb_round(1.5 * s), cast(f64) hb_round(1.0 * s), key, [3] f64.[0.75, 0.75, 0.75]);
}
hb_background :: () -> [3] int { return [3] int.[hb_byte(18.0 / 255.0), hb_byte(21.0 / 255.0), hb_byte(29.0 / 255.0)]; }
// A key's tab alone, over the slot's dark ground (a moved slot's key: the key stays with the place).
hb_key_tab :: (hb: []Hb, buf: []u8, key: string, size: int) -> HbImg {
  wh := hb_tab_size(hb, key, size);
  im: HbImg; im.w = wh[0]; im.h = wh[1]; im.px = buf[0..<3 * im.w * im.h];
  hb_fill(im, hb_background());
  hb_draw_tab(hb, im, key, size);
  return im;
}
// The white artwork's coverage at size by size, padded as icons.rs pads it, into cover.
hb_svg_coverage :: (hb: []Hb, svg: string, size: int, cover: []u8) -> bool {
  inner := hb_round(cast(f64) size * (1.0 - 2.0 * HB_PADDING));
  n: [32] u8; ns := hb_int(n[..], inner);
  dir := fs_join(hb[0].root, HB_ICONS, hb[0].path[..]);
  src: [4096] u8; sp := fs_join(dir, svg, src[..]);
  png: [4096] u8; pp := fs_join(hb[0].tmp, "icon.png", png[..]);
  argv := [8] string.["rsvg-convert", "-w", ns, "-h", ns, "-a", "-o", pp];
  all: [9] string; for a, i: argv { all[i] = a; } all[8] = sp;
  out: [256] u8; err: [4096] u8;
  r := proc_run(all[..], 60000, out[..], err[..]);
  if r.started != 0 || r.status != 0 { tool_err("hotbar: rsvg-convert failed on "); tool_errln(svg); return false; }
  k := fs_read(pp, hb[0].png[..]);
  if k <= 0 { return false; }
  info := png_info(hb[0].png[0..<k]);
  if png_decode(hb[0].png[0..<k], hb[0].png_work[..], hb[0].png_rgba[..]) != PNG_OK { tool_err("hotbar: can't read rsvg-convert's picture of "); tool_errln(svg); return false; }
  for i: 0..<size * size { cover[i] = 0; }
  at := hb_round(cast(f64) size * HB_PADDING);
  ox := at + (inner - info.w) / 2; oy := at + (inner - info.h) / 2;
  for y: 0..<info.h {
    for x: 0..<info.w {
      tx := ox + x; ty := oy + y;
      if tx < 0 || ty < 0 || tx >= size || ty >= size { continue; }
      cover[ty * size + tx] = hb[0].png_rgba[4 * (y * info.w + x) + 3];
    }
  }
  return true;
}
// A slot's icon: the art tinted over the slot's ground, and (unless bare) its key's tab.
hb_icon :: (hb: []Hb, buf: []u8, svg_in: string, tint: [3] f64, key: string, size: int, bare: bool) -> HbImg {
  im: HbImg; im.w = size; im.h = size; im.px = buf[0..<3 * size * size];
  flip := svg_in.count > 0 && svg_in[svg_in.count - 1] == '^';
  svg := ifx flip then svg_in[0..<svg_in.count - 1] else svg_in;
  cover: [16384] u8;
  if !hb_svg_coverage(hb, svg, size, cover[..]) { hb[0].failed = true; return im; }
  bg := [3] f64.[18.0 / 255.0, 21.0 / 255.0, 29.0 / 255.0];
  for y: 0..<size {
    sy := ifx flip then size - 1 - y else y;
    for x: 0..<size {
      c := cast(f64) cover[sy * size + x] / 255.0;
      for k: 0..<3 { im.px[3 * (y * size + x) + k] = cast(u8) hb_byte(bg[k] * (1.0 - c) + tint[k] * c); }
    }
  }
  // the key small in the top left corner on a dark tab (the owner, October 30: big keys over the
  // top right of the icons collided with the art and could not be read); bare: the icon alone
  if !bare { hb_draw_tab(hb, im, key, size); }
  return im;
}

// ui.rs wrap, for a monospace face: the lines into out (start and end of each); their count.
hb_wrap :: (words: string, width: f64, advance: int, starts: []int, ends: []int, text: []u8, used: []int) -> int {
  // the lines are built into text (a word can be cut), each [starts[k], ends[k])
  n := 0; line_s := used[0]; line_e := used[0];
  at := 0;
  while true {
    e := at; while e < words.count && words[e] != ' ' { e += 1; }
    w0 := at; w1 := e;
    while true {
      wl := hb_chars(cast(string) words[w0..<w1]);
      ll := hb_chars(cast(string) text[line_s..<line_e]);
      cand := ifx line_e == line_s then wl else ll + 1 + wl;
      if cast(f64) (cand * advance) <= width {
        if line_e != line_s { text[line_e] = ' '; line_e += 1; }
        for i: w0..<w1 { text[line_e] = words[i]; line_e += 1; }
        break;
      }
      if line_e != line_s {
        starts[n] = line_s; ends[n] = line_e; n += 1;
        line_s = line_e; line_e = line_s;
        continue;
      }
      per := cast(int) floor(width / cast(f64) advance); if per < 1 { per = 1; }
      cutb := w0 + hb_prefix(cast(string) words[w0..<w1], per);
      for i: w0..<cutb { text[line_e] = words[i]; line_e += 1; }
      starts[n] = line_s; ends[n] = line_e; n += 1;
      line_s = line_e; line_e = line_s;
      w0 = cutb;
      if w0 >= w1 { break; }
    }
    if e >= words.count { break; }
    at = e + 1;
  }
  if line_e != line_s || n == 0 { starts[n] = line_s; ends[n] = line_e; n += 1; }
  used[0] = line_e;
  return n;
}
hb_notched :: (im: HbImg, x: int, y: int, ww: int, hh: int, r: int, colour: [3] f64) {
  fill: [3] int; for c: 0..<3 { fill[c] = hb_byte(hb_srgb(colour[c])); }
  hb_rect(im, x + r, y, x + ww - r - 1, y + hh - 1, fill);
  hb_rect(im, x, y + r, x + ww - 1, y + hh - r - 1, fill);
}
// tooltip.rs measure and draw at scale device px a CSS px, as an opaque picture. Details' colours
// as HbSlot's; key details are left out (the slot shows the key).
hb_card :: (hb: []Hb, buf: []u8, title: string, body: string, nd: int, dt: [6] string, dc: [6] int, scale: int) -> HbImg {
  sc := cast(f64) scale;
  m := hb_metrics(hb, hb_round(HB_FONT_PX * sc));
  pad_x := HB_PAD_X * sc; pad_y := HB_PAD_Y * sc; gap := HB_GAP * sc;
  inner := HB_MAX_WIDTH * sc - 2.0 * pad_x;
  text: [8192] u8; used: [1] int;
  ts: [64] int; te: [64] int; bs: [64] int; be: [64] int;
  nt := hb_wrap(title, inner, m.advance, ts[..], te[..], text[..], used[..]);
  nb := ifx body.count > 0 then hb_wrap(body, inner, m.advance, bs[..], be[..], text[..], used[..]) else 0;
  // the details' rows: a row's first detail, its count, and its length in characters
  row_first: [8] int; row_n: [8] int; row_len: [8] int; rows := 0;
  dot := " · ";
  for k: 0..<nd {
    if dc[k] == HB_KEY { continue; }
    piece := hb_chars(dt[k]) * m.advance;
    if rows > 0 && cast(f64) (row_len[rows - 1] * m.advance + hb_chars(dot) * m.advance + piece) <= inner {
      row_n[rows - 1] += 1; row_len[rows - 1] += hb_chars(dot) + hb_chars(dt[k]);
    } else { row_first[rows] = k; row_n[rows] = 1; row_len[rows] = hb_chars(dt[k]); rows += 1; }
  }
  width := 0;
  for i: 0..<nt { v := hb_chars(cast(string) text[ts[i]..<te[i]]) * m.advance; if v > width { width = v; } }
  for i: 0..<nb { v := hb_chars(cast(string) text[bs[i]..<be[i]]) * m.advance; if v > width { width = v; } }
  for i: 0..<rows { v := row_len[i] * m.advance; if v > width { width = v; } }
  lines := nt + nb + rows;
  height := cast(f64) (lines * m.line) + cast(f64) (lines - 1) * gap;
  wf := cast(f64) width; if inner < wf { wf = inner; }
  im: HbImg; im.w = hb_ceil(wf + 2.0 * pad_x); im.h = hb_ceil(height + 2.0 * pad_y);
  im.px = buf[0..<3 * im.w * im.h];
  shadow: [3] int; sh := [3] f64.[0.05, 0.03, 0.012];
  for c: 0..<3 { shadow[c] = hb_byte(hb_srgb(sh[c])); }
  hb_fill(im, shadow);
  hb_notched(im, 0, 0, im.w, im.h, hb_round(2.0 * sc), [3] f64.[0.55, 0.45, 0.28]);
  r1 := hb_round(sc);
  hb_notched(im, r1, r1, im.w - 2 * r1, im.h - 2 * r1, r1, [3] f64.[0.04, 0.03, 0.018]);
  y := pad_y;
  title_c := [3] f64.[0.98, 0.82, 0.38]; body_c := [3] f64.[0.88, 0.82, 0.68];
  for i: 0..<nt {
    t := cast(string) text[ts[i]..<te[i]];
    hb_text(hb, im, m, pad_x, y, t, title_c);
    hb_text(hb, im, m, pad_x + sc, y, t, title_c);
    y += cast(f64) m.line + gap;
  }
  for i: 0..<nb { hb_text(hb, im, m, pad_x, y, cast(string) text[bs[i]..<be[i]], body_c); y += cast(f64) m.line + gap; }
  for r: 0..<rows {
    pen := pad_x; k := row_first[r]; shown := 0;
    while shown < row_n[r] {
      if dc[k] == HB_KEY { k += 1; continue; }
      if shown > 0 { hb_text(hb, im, m, pen, y, dot, hb_colour(HB_SEPARATOR)); pen += cast(f64) (hb_chars(dot) * m.advance); }
      hb_text(hb, im, m, pen, y, dt[k], hb_colour(dc[k]));
      pen += cast(f64) (hb_chars(dt[k]) * m.advance);
      shown += 1; k += 1;
    }
    y += cast(f64) m.line + gap;
  }
  return im;
}

// ---- writing
hb_int :: (out: []u8, v_in: int) -> string {
  v := v_in; d: [24] u8; k := 0; neg := v < 0; if neg { v = -v; }
  while true { d[k] = cast,trunc(u8) (48 + v % 10); k += 1; v /= 10; if v == 0 { break; } }
  n := 0; if neg { out[0] = '-'; n = 1; }
  while k > 0 { k -= 1; out[n] = d[k]; n += 1; }
  return cast(string) out[0..<n];
}
// A picture saved as a JPEG (Pillow's quality=90, subsampling=0) at DIR/NAME.
hb_save :: (hb: []Hb, im: HbImg, dir: string, name: string) -> bool {
  if hb[0].failed { return false; }
  n := jpe_encode(im.px, im.w, im.h, 3, 90, false, false, hb[0].jpg[..]);
  if n < 0 { tool_err("hotbar: can't encode "); tool_errln(name); return false; }
  p: [4096] u8; path := fs_join(dir, name, p[..]);
  if !fs_write(path, cast(string) hb[0].jpg[0..<n]) { tool_err("hotbar: can't write "); tool_errln(path); return false; }
  return true;
}
// Text joined into a buffer, for the table file.
HbText :: struct { b: [262144] u8; n: int; }
hb_put :: (t: []HbText, s: string) { for c: s { if t[0].n < 262144 { t[0].b[t[0].n] = c; t[0].n += 1; } } }
hb_put_int :: (t: []HbText, v: int) { d: [24] u8; hb_put(t, hb_int(d[..], v)); }
// "[N] TYPE.[a, b, ...]" of ints.
hb_put_list :: (t: []HbText, kind: string, v: []int) {
  hb_put(t, "["); hb_put_int(t, v.count); hb_put(t, "] "); hb_put(t, kind); hb_put(t, ".[");
  for x, i: v { if i > 0 { hb_put(t, ", "); } hb_put_int(t, x); }
  hb_put(t, "];\n");
}
hb_put_names :: (t: []HbText, names: []string) {
  hb_put(t, "["); hb_put_int(t, names.count); hb_put(t, "] string.[");
  for x, i: names { if i > 0 { hb_put(t, ", "); } hb_put(t, "\""); hb_put(t, x); hb_put(t, "\""); }
  hb_put(t, "];\n");
}

#test "Python's rounding, and its ceil" {
  #assert hb_round(0.5) == 0 && hb_round(1.5) == 2 && hb_round(2.5) == 2 && hb_round(2.51) == 3 && hb_round(-0.5) == 0 && hb_round(-1.5) == -2;
  #assert hb_ceil(2.0) == 2 && hb_ceil(2.1) == 3 && hb_byte(1.2) == 255 && hb_byte(-0.1) == 0;
  #assert hb_chars("a · b") == 5 && hb_prefix("·ab", 1) == 2;
}
