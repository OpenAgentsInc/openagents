// The characters' data layers (#13012): appends the Quaternius Fantasy Source normal and ORM maps,
// and the base bodies' normal and roughness maps, to a people pack as linear data layers (entry
// kind 6, "dataN"), with one catalog row each, "D <index> <name> <licence>". Hosts upload them to
// their own rgba8unorm array, never sRGB-decoded (coax/web/host.js, the data layers); the table
// that names them per colour layer is metaverse-engine/character/material.coax. They go between the colour
// layers and the sounds, the order metaverse-engine/editor/pack.coax admits.
// Each map is resized to 512 (Lanczos) and stored as PNG, lossless. The normal maps are the ones the
// source's glTF exports name (normalTexture), so they are glTF's OpenGL convention, green up the
// image; they are stored as they are. (The Normals-UnrealEngine copies are the same maps with green
// inverted. ph_pack's green_up slope test misreads Knight and Noble, so it is not used here.)
// Run (SOURCE is the Fantasy Source's folder, the one holding Textures/):
//   coax/web/tool.sh metaverse/tools/humans/pack_material_layers.coax SOURCE IN.pack OUT.pack
// tool.sh: release
// tool.sh: stack-gib 8
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "ph_pack.coax";
#load "ph_face.coax";
#load "ph_outfits.coax";

ML_SIDE :: 512;
ML_LICENCE :: 6;   // the people pack's "Quaternius Modular Character Outfits - Fantasy Source"
ML_MAPS :: 14;
// the catalog names and their paths under SOURCE/Textures
ML_NAMES :: [ML_MAPS] string.["T_Knight_Normal","T_Knight_ORM","T_Noble_Normal","T_Noble_ORM","T_Peasant_Normal","T_Peasant_ORM","T_Ranger_Normal","T_Ranger_ORM","T_Wizard_Normal","T_Wizard_ORM","T_Regular_Female_Normal","T_Regular_Female_Roughness","T_Regular_Male_Normal","T_Regular_Male_Roughness"];
ML_PATHS :: [ML_MAPS] string.["Knight/T_Knight_Normal.png","Knight/T_Knight_ORM.png","Noble/T_Noble_Normal.png","Noble/T_Noble_ORM.png","Peasant/T_Peasant_Normal.png","Peasant/T_Peasant_ORM.png","Ranger/T_Ranger_Normal.png","Ranger/T_Ranger_ORM.png","Wizard/T_Wizard_Normal.png","Wizard/T_Wizard_ORM.png","Base/T_Regular_Female_Normal.png","Base/T_Regular_Female_Roughness.png","Base/T_Regular_Male_Normal.png","Base/T_Regular_Male_Roughness.png"];
ML_DATA_KIND :: 6;
ML_OUT :: 100663296;
Ml :: struct {old:[67108864]u8;out:[ML_OUT]u8;maps:[ML_MAPS][1048576]u8;mapn:[ML_MAPS]int;}
ml_word :: (b:[]u8,at:int,v:u32) {for k:0..<4 {b[at+k]=cast,trunc(u8)(v>>cast(u32)(k*8));}}
ml_u32 :: (b:[]u8,at:int)->int {return cast(int)b[at]|(cast(int)b[at+1]<<8)|(cast(int)b[at+2]<<16)|(cast(int)b[at+3]<<24);}
ml_entry :: (out:[]u8,row:int,kind:int,licence:int,name:string,offset:int,size:int) {
 for k:0..<48 {out[row+k]=0;}out[row]=cast(u8)kind;out[row+1]=cast(u8)licence;ml_word(out,row+4,cast(u32)offset);ml_word(out,row+8,cast(u32)size);for i:0..<name.count {if i<31 {out[row+16+i]=name[i];}}
}
// One map at ML_SIDE, RGB PNG.
ml_map :: (path:string,iw:[]ImgWork,out:[]u8)->int {
 im:=img_to(img_load(path,iw),3);
 if im.w!=ML_SIDE || im.h!=ML_SIDE {im=img_resize(im,ML_SIDE,ML_SIDE,PI_LANCZOS,iw);}
 n:=pi_png(im,iw[0].z[..],iw[0].work[..],iw[0].out[..]);if n<0 || n>out.count {return -1;}
 for i:0..<n {out[i]=iw[0].out[i];}
 return n;
}
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=3 {tool_errln("pack_material_layers: SOURCE IN.pack OUT.pack");return 2;}
 m:[1]Ml;iw:[1]ImgWork;root:=args_at(args[..],0);oldn:=fs_read(args_at(args[..],1),m[0].old[..]);
 if oldn<32 || cast(string)m[0].old[0..<4]!="VPK1" || ml_u32(m[0].old[..],8)!=oldn {tool_errln("pack_material_layers: IN is not a whole VPK1 pack");return 1;}
 old:=m[0].old[0..<oldn];ne:=ml_u32(old,4);budget:=ml_u32(old,12);table:=ml_u32(old,16);cat:="";
 for i:0..<ne {r:=table+i*48;kind:=cast(int)old[r];off:=ml_u32(old,r+4);size:=ml_u32(old,r+8);if kind==1 {cat=cast(string)old[off..<off+size];}if kind==ML_DATA_KIND {tool_errln("pack_material_layers: IN already has data layers");return 1;}}
 if cat.count==0 {tool_errln("pack_material_layers: IN has no catalog");return 1;}
 for i:0..<ML_MAPS {
  pb:[1024]u8;path:=cast(string)pb[0..<0];n:=0;for c:root {pb[n]=c;n+=1;}for c:"/Textures/" {pb[n]=c;n+=1;}for c:ML_PATHS[i] {pb[n]=c;n+=1;}path=cast(string)pb[0..<n];
  m[0].mapn[i]=ml_map(path,iw[..],m[0].maps[i][..]);
  if m[0].mapn[i]<0 {tool_err("pack_material_layers: couldn't encode ");tool_errln(path);return 1;}
  print("D % % % bytes\n",i,ML_NAMES[i],m[0].mapn[i]);
 }
 // the catalog with its D rows after the rest, and its byte count patched below
 // (4 MiB: Everglade II's catalog carries its ground record in G lines, #13059)
 cb:[4194304]u8;c:[1]Sb;c[0]=sb(cb[..]);at:=0;
 while at<cat.count {e:=at;while e<cat.count && cat[e]!='\n' {e+=1;}line:=cat[at..<e];at=e+1;if line.count==0 {continue;}if starts(line,"bytes ") {sb_put(c[..],"bytes 0000000000\n");}else {sb_put(c[..],line);sb_byte(c[..],'\n');}}
 for i:0..<ML_MAPS {sb_put(c[..],"D ");sb_int(c[..],i);sb_byte(c[..],' ');sb_put(c[..],ML_NAMES[i]);sb_byte(c[..],' ');sb_int(c[..],ML_LICENCE);sb_byte(c[..],'\n');}
 if c[0].n>=cb.count {tool_errln("pack_material_layers: the catalog doesn't fit its buffer");return 1;}
 // The data layers go after the colour layers and before the sounds: a paged pack (VPK3) defers
 // its sounds, so every entry before them is a root and lands first.
 ins:=ne;for i:0..<ne {if ins==ne && cast(int)old[table+i*48]==5 {ins=i;}}
 count:=ne+ML_MAPS;o:=m[0].out[..];w:=32+count*48;
 ml_word(o,0,0x314b5056);ml_word(o,4,cast(u32)count);ml_word(o,16,32);ml_word(o,20,cast(u32)w);
 for j:0..<count {
  if j>=ins && j<ins+ML_MAPS {i:=j-ins;start:=w;for k:0..<m[0].mapn[i] {o[w]=m[0].maps[i][k];w+=1;}nb:[16]u8;s:[1]Sb;s[0]=sb(nb[..]);sb_put(s[..],"data");sb_int(s[..],i);ml_entry(o,32+j*48,ML_DATA_KIND,ML_LICENCE,sb_text(s[..]),start,w-start);w=((w+3)/4)*4;continue;}
  i:=ifx j<ins then j else j-ML_MAPS;r:=table+i*48;kind:=cast(int)old[r];off:=ml_u32(old,r+4);size:=ml_u32(old,r+8);start:=w;
  if kind==1 {for ch:sb_text(c[..]) {o[w]=ch;w+=1;}} else {if w+size>ML_OUT {tool_errln("pack_material_layers: too big");return 1;}for k:0..<size {o[w]=old[off+k];w+=1;}}
  for k:0..<48 {o[32+j*48+k]=old[r+k];}ml_word(o,32+j*48+4,cast(u32)start);ml_word(o,32+j*48+8,cast(u32)(w-start));w=((w+3)/4)*4;
 }
 cat_start:=ml_u32(o,36);cat_size:=ml_u32(o,40);for k:cat_start..<cat_start+cat_size-16 {if cast(string)o[k..<k+6]=="bytes " {value:=w;for j:0..<10 {o[k+15-j]=cast(u8)(48+value%10);value/=10;}break;}}
 ml_word(o,8,cast(u32)w);
 if w>budget {print("pack_material_layers: % bytes is over the pack's budget of %\n",w,budget);return 1;}
 ml_word(o,12,cast(u32)budget);
 if !fs_write(args_at(args[..],2),cast(string)o[0..<w]) {return 1;}
 print("pack_material_layers: % data layers, % bytes (budget %)\n",ML_MAPS,w,budget);return 0;
}
