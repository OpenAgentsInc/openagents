// A MetaHuman face rig for MetaHuman Lab, from the DNA's rig behaviour.
//
// The tables come from dna_behavior (its behavior.txt and targets.bin, made from the head DNA by
// OpenRigLogic's reader). This evaluates them the way OpenRigLogic does, as a reference, and
// packs them into one block the lab's Coax port evaluates every frame (metahumanlab.coax,
// face_*). The evaluation follows OpenRigLogic (MIT, Copyright (c) 2026 Epic Games, Inc.):
//
//   controls    raw controls set by an expression; each pose-space corrective (PSD) is its weight
//               times the product of its inputs clamped to 0..1, capped at 1
//   joints      each joint group adds values x inputs (row-major, outputs x inputs, the LOD 0 rows)
//               to its output attributes (joint * 9 + tx ty tz rx ry rz sx sy sz); a joint's local
//               transform is its neutral translation and Euler rotation (degrees, x then y then z)
//               plus those deltas, scale 1 plus its delta
//   blendshapes each channel's weight is its input control; a target adds its deltas times that
//               weight to its mesh's points, before the joints skin them
//
// The data is private (a MetaHuman's): never committed, never used to train AI models.
// Also here: the DNA dumps' OBJ and skin files (metahuman.obj, metahuman.skin_file).

// ---- a DNA dump's OBJ (cm) and skin file
OBJ_V :: 200000; OBJ_F :: 200000; OBJ_C :: 800000;
Obj :: struct {
  nv: int; v: [OBJ_V][3] f64; nt: int; vt: [OBJ_V][2] f64; nn: int; vn: [OBJ_V][3] f64;
  nf: int; fs: [OBJ_F + 1] int; nc: int; c: [OBJ_C][3] int;    // per face its corners (pi, ti, ni) from fs[f]
}
OBJ_TEXT :: 67108864;
ObjText :: struct { b: [OBJ_TEXT] u8; }
obj_read :: (path: string, o: []Obj, t: []ObjText) {
  n := fs_read(path, t[0].b[..]);
  if n < 0 || n >= OBJ_TEXT { ph_die2("metahuman: can't read ", path); }
  o[0].nv = 0; o[0].nt = 0; o[0].nn = 0; o[0].nf = 0; o[0].nc = 0; o[0].fs[0] = 0;
  l: [1] Lines; l[0].text = cast(string) t[0].b[0..<n];
  while !lines_done(l[0]) {
    line := lines_next(l[..]);
    if starts(line, "v ") {
      w: [1] Words; w[0] = words(line); x := word(w[..]);
      if o[0].nv >= OBJ_V { ph_die("metahuman: an OBJ past the port's points"); }
      o[0].v[o[0].nv] = [3] f64.[pf(word(w[..])), pf(word(w[..])), pf(word(w[..]))]; o[0].nv += 1;
    } else if starts(line, "vt ") {
      w: [1] Words; w[0] = words(line); x := word(w[..]);
      if o[0].nt >= OBJ_V { ph_die("metahuman: an OBJ past the port's uvs"); }
      o[0].vt[o[0].nt] = [2] f64.[pf(word(w[..])), pf(word(w[..]))]; o[0].nt += 1;
    } else if starts(line, "vn ") {
      w: [1] Words; w[0] = words(line); x := word(w[..]);
      if o[0].nn >= OBJ_V { ph_die("metahuman: an OBJ past the port's normals"); }
      o[0].vn[o[0].nn] = [3] f64.[pf(word(w[..])), pf(word(w[..])), pf(word(w[..]))]; o[0].nn += 1;
    } else if starts(line, "f ") {
      w: [1] Words; w[0] = words(line); x := word(w[..]);
      while true {
        c := word(w[..]);
        if c.count == 0 { break; }
        q := [3] int.[-1, -1, -1]; k := 0; s := 0;
        for i: 0..<c.count + 1 {
          if i == c.count || c[i] == '/' { if i > s && k < 3 { q[k] = pint(c[s..<i]) - 1; } k += 1; s = i + 1; }
        }
        if o[0].nc >= OBJ_C { ph_die("metahuman: an OBJ past the port's corners"); }
        o[0].c[o[0].nc] = q; o[0].nc += 1;
      }
      if o[0].nf >= OBJ_F { ph_die("metahuman: an OBJ past the port's faces"); }
      o[0].nf += 1; o[0].fs[o[0].nf] = o[0].nc;
    }
  }
}
// a skin file: per point its (joint, weight) pairs
SKIN_P :: 200000; SKIN_E :: 2000000;
Skin :: struct { n: int; s: [SKIN_P + 1] int; ne: int; j: [SKIN_E] int; w: [SKIN_E] f64; }
skin_read :: (path: string, sk: []Skin, t: []ObjText) {
  n := fs_read(path, t[0].b[..]);
  if n < 0 || n >= OBJ_TEXT { ph_die2("metahuman: can't read ", path); }
  sk[0].n = 0; sk[0].ne = 0; sk[0].s[0] = 0;
  l: [1] Lines; l[0].text = cast(string) t[0].b[0..<n];
  while !lines_done(l[0]) {
    line := lines_next(l[..]);
    w: [1] Words; w[0] = words(line);
    first := word(w[..]);
    if first.count == 0 { continue; }
    k := pint(first);
    for i: 0..<k {
      if sk[0].ne >= SKIN_E { ph_die("metahuman: a skin past the port's table"); }
      sk[0].j[sk[0].ne] = pint(word(w[..])); sk[0].w[sk[0].ne] = pf(word(w[..])); sk[0].ne += 1;
    }
    if sk[0].n >= SKIN_P { ph_die("metahuman: a skin past the port's points"); }
    sk[0].n += 1; sk[0].s[sk[0].n] = sk[0].ne;
  }
}
// metahuman.unit: a short vector stays as it is
mh_unit :: (a: [3] f64) -> [3] f64 { l := sqrt(vdot(a, a)); if l > 0.000000000001 { return [3] f64.[a[0] / l, a[1] / l, a[2] / l]; } return a; }
// position_normals(): per point the sum of its corners' normals, unit
position_normals :: (o: []Obj, out: [][3] f64) {
  for i: 0..<o[0].nv { out[i] = vzero(); }
  for f: 0..<o[0].nf { for e: o[0].fs[f]..<o[0].fs[f + 1] { c := o[0].c[e]; out[c[0]] = vadd(out[c[0]], o[0].vn[c[2]]); } }
  for i: 0..<o[0].nv { out[i] = mh_unit(out[i]); }
}

// ---- the face rig
FACE_MESHES :: [7] string.["head_lod0_mesh", "teeth_lod0_mesh", "eyeLeft_lod0_mesh", "eyeRight_lod0_mesh", "eyelashes_lod0_mesh", "eyeshell_lod0_mesh", "eyeEdge_lod0_mesh"];
DELTA_MIN :: 0.01; DELTA_UNIT :: 0.001; INFLUENCES :: 6; LEAN_DELTA_MIN :: 0.03; VISEME_MOVE_MIN :: 0.3;
FR_RAW :: 4096; FR_PSD :: 8192; FR_PSDI :: 65536; FR_G :: 1024; FR_GI :: 262144; FR_GV :: 4194304; FR_J :: 1024; FR_M :: 64;
FR_T :: 8192; FR_D :: 4000000; FR_P :: 120000; FR_PS :: 1200000;
FaceRig :: struct {
  ok: bool;
  text: [1] ObjText;
  nraw: int; raw: [FR_RAW] string; rawb: [262144] u8;
  controls: int;
  npsd: int; psd_out: [FR_PSD] int; psd_w: [FR_PSD] f64; psd_f: [FR_PSD + 1] int; psd_in: [FR_PSDI] int;
  ng: int; g_in_f: [FR_G + 1] int; g_out_f: [FR_G + 1] int; g_val_f: [FR_G + 1] int; gi: [FR_GI] int; go: [FR_GI] int; gv: [FR_GV] f64;
  nj: int; jpar: [FR_J] int; jt: [FR_J][3] f64; jr: [FR_J][3] f64;
  nm: int; mesh: [FR_M] string; meshb: [4096] u8;
  chan_ctl: [65536] int;
  // targets: per target its mesh, control channel, deltas
  ntg: int; tg_m: [FR_T] int; tg_c: [FR_T] int; tg_f: [FR_T + 1] int; dv: [FR_D] int; dd: [FR_D][3] f64;
  // the face meshes: points, normals, skins (in FACE_MESHES order)
  np: int; first: [7] int; pts: [FR_P][3] f64; nrm: [FR_P][3] f64; ps: [FR_P + 1] int; pj: [FR_PS] int; pw: [FR_PS] f64;
  index: [7] int;           // FACE_MESHES' DNA mesh index
  // scratch
  c: [65536] f64; c0: [65536] f64; attr: [FR_J * 9] f64; on: [65536] bool;
  q: [FR_P][3] f64;
}
fr_nums :: (line: string, out: []f64) -> int {
  w: [1] Words; w[0] = words(line); x := word(w[..]); y := word(w[..]);
  n := 0;
  while true { s := word(w[..]); if s.count == 0 { break; } if n >= out.count { ph_die("metahuman: a behavior line past the port's table"); } out[n] = pf(s); n += 1; }
  return n;
}
fr_ints :: (line: string, out: []int) -> int {
  w: [1] Words; w[0] = words(line); x := word(w[..]); y := word(w[..]);
  n := 0;
  while true { s := word(w[..]); if s.count == 0 { break; } if n >= out.count { ph_die("metahuman: a behavior line past the port's table"); } out[n] = pint(s); n += 1; }
  return n;
}
FrTmp :: struct { a: [FR_GV] f64; i: [FR_GI] int; o: [FR_GI] int; j: [FR_GI] int; psd_r: [FR_PSDI] int; psd_c: [FR_PSDI] int; psd_v: [FR_PSDI] f64; bin: [65536] int; bout: [65536] int; }
// Behavior + targets + the face meshes (head: the DNA dump's head directory); false without the tables
face_load :: (fr: []FaceRig, head: string, txt: []Txt, ob: []Obj, sk: []Skin, tmp: []FrTmp) -> bool {
  fr[0].ok = false;
  bpath := txt_cat(txt, head, "/behavior.txt"); tpath := txt_cat(txt, head, "/targets.bin");
  if !fs_exists(bpath) || !fs_exists(tpath) { print("metahuman: no face rig (dna_behavior's behavior.txt and targets.bin are missing)\n"); return false; }
  n := fs_read(bpath, fr[0].text[0].b[..]);
  if n < 0 || n >= OBJ_TEXT { ph_die("metahuman: can't read behavior.txt"); }
  l: [1] Lines; l[0].text = cast(string) fr[0].text[0].b[0..<n];
  first := lines_next(l[..]);
  w: [1] Words; w[0] = words(first); x := word(w[..]); y := word(w[..]);
  fr[0].nraw = 0; at := 0;
  while true {
    s := word(w[..]); if s.count == 0 { break; }
    for i: 0..<s.count { fr[0].rawb[at + i] = s[i]; }
    fr[0].raw[fr[0].nraw] = cast(string) fr[0].rawb[at..<at + s.count]; at += s.count; fr[0].nraw += 1;
  }
  npr := 0; npc := 0; npv := 0; nbi := 0; nbo := 0;
  fr[0].ng = 0; fr[0].nj = 0; fr[0].nm = 0; fr[0].g_in_f[0] = 0; fr[0].g_out_f[0] = 0; fr[0].g_val_f[0] = 0;
  mat := 0;
  while !lines_done(l[0]) {
    line := lines_next(l[..]);
    ww: [1] Words; ww[0] = words(line); k := word(ww[..]);
    if k == "psdrows" { npr = fr_ints(line, tmp[0].psd_r[..]); }
    else if k == "psdcols" { npc = fr_ints(line, tmp[0].psd_c[..]); }
    else if k == "psdvalues" { npv = fr_nums(line, tmp[0].psd_v[..]); }
    else if k == "lods" {
      lods: [16] int; nl := fr_ints(line, lods[..]);
      g := fr[0].ng;
      ni := fr_ints(lines_next(l[..]), tmp[0].i[..]);
      no := fr_ints(lines_next(l[..]), tmp[0].o[..]);
      nvv := fr_nums(lines_next(l[..]), tmp[0].a[..]);
      x2 := lines_next(l[..]);    // the group's joints
      rows := lods[0];
      if fr[0].g_in_f[g] + ni > FR_GI || fr[0].g_out_f[g] + rows > FR_GI || fr[0].g_val_f[g] + rows * ni > FR_GV || g >= FR_G { ph_die("metahuman: joint groups past the port's tables"); }
      for i: 0..<ni { fr[0].gi[fr[0].g_in_f[g] + i] = tmp[0].i[i]; }
      for i: 0..<rows { fr[0].go[fr[0].g_out_f[g] + i] = tmp[0].o[i]; }
      for i: 0..<rows * ni { fr[0].gv[fr[0].g_val_f[g] + i] = tmp[0].a[i]; }
      fr[0].g_in_f[g + 1] = fr[0].g_in_f[g] + ni; fr[0].g_out_f[g + 1] = fr[0].g_out_f[g] + rows; fr[0].g_val_f[g + 1] = fr[0].g_val_f[g] + rows * ni;
      fr[0].ng += 1;
    }
    else if k == "bscin" { nbi = fr_ints(line, tmp[0].bin[..]); }
    else if k == "bscout" { nbo = fr_ints(line, tmp[0].bout[..]); }
    else if k == "mesh" { nm := word(ww[..]); for i: 0..<nm.count { fr[0].meshb[mat + i] = nm[i]; } fr[0].mesh[fr[0].nm] = cast(string) fr[0].meshb[mat..<mat + nm.count]; mat += nm.count; fr[0].nm += 1; }
    else if k == "joint" {
      nm := word(ww[..]); j := fr[0].nj;
      fr[0].jpar[j] = pint(word(ww[..]));
      for c: 0..<3 { fr[0].jt[j][c] = pf(word(ww[..])); }
      for c: 0..<3 { fr[0].jr[j][c] = pf(word(ww[..])); }
      fr[0].nj += 1;
    }
  }
  mx := fr[0].nraw - 1;
  for i: 0..<npr { mx = imax(mx, tmp[0].psd_r[i]); } for i: 0..<npc { mx = imax(mx, tmp[0].psd_c[i]); }
  for i: 0..<nbi { mx = imax(mx, tmp[0].bin[i]); }
  for i: 0..<fr[0].g_in_f[fr[0].ng] { mx = imax(mx, fr[0].gi[i]); }
  fr[0].controls = 1 + mx;
  if fr[0].controls > 65536 { ph_die("metahuman: controls past the port's table"); }
  // the PSDs, by output: weight the product of the entries' values, inputs in order
  order: [FR_PSDI] int; m := imin(imin(npr, npc), npv);
  for i: 0..<m { order[i] = i; }
  // stable sort by row (sorted(psd.items()) after insertion: entries keep their order per row)
  for i: 1..<m { xo := order[i]; j := i - 1; while j >= 0 && tmp[0].psd_r[order[j]] > tmp[0].psd_r[xo] { order[j + 1] = order[j]; j -= 1; } order[j + 1] = xo; }
  fr[0].npsd = 0; fr[0].psd_f[0] = 0;
  for q: 0..<m {
    i := order[q]; r := tmp[0].psd_r[i];
    if fr[0].npsd == 0 || fr[0].psd_out[fr[0].npsd - 1] != r {
      fr[0].psd_out[fr[0].npsd] = r; fr[0].psd_w[fr[0].npsd] = 1.0; fr[0].npsd += 1; fr[0].psd_f[fr[0].npsd] = fr[0].psd_f[fr[0].npsd - 1];
    }
    p := fr[0].npsd - 1;
    fr[0].psd_w[p] = fr[0].psd_w[p] * tmp[0].psd_v[i];
    fr[0].psd_in[fr[0].psd_f[p + 1]] = tmp[0].psd_c[i]; fr[0].psd_f[p + 1] += 1;
  }
  for i: 0..<65536 { fr[0].chan_ctl[i] = -1; }
  for i: 0..<imin(nbi, nbo) { fr[0].chan_ctl[tmp[0].bout[i]] = tmp[0].bin[i]; }
  // targets.bin
  tn := fs_read(tpath, fr[0].text[0].b[..]);
  if tn < 0 || tn >= OBJ_TEXT { ph_die("metahuman: can't read targets.bin"); }
  b := fr[0].text[0].b[0..<tn];
  pos := 0; fr[0].ntg = 0; nd := 0; fr[0].tg_f[0] = 0;
  while pos < tn {
    mm := u16_at(b, pos); cnt_t := gl_u32(b, pos + 2); pos += 6;
    for e: 0..<cnt_t {
      ch := u16_at(b, pos); cnt := gl_u32(b, pos + 2); pos += 6;
      ia := pos; pos += 4 * cnt; da := pos; pos += 12 * cnt;
      if fr[0].ntg >= FR_T { ph_die("metahuman: targets past the port's table"); }
      t := fr[0].ntg;
      fr[0].tg_m[t] = mm; fr[0].tg_c[t] = ch;
      for i: 0..<cnt {
        d := [3] f64.[cast(f64) f32_from_bits(cast(u32) gl_u32(b, da + 12 * i)), cast(f64) f32_from_bits(cast(u32) gl_u32(b, da + 12 * i + 4)), cast(f64) f32_from_bits(cast(u32) gl_u32(b, da + 12 * i + 8))];
        if abs(d[0]) + abs(d[1]) + abs(d[2]) >= DELTA_MIN {
          if nd >= FR_D { ph_die("metahuman: target deltas past the port's table"); }
          fr[0].dv[nd] = gl_u32(b, ia + 4 * i); fr[0].dd[nd] = d; nd += 1;
        }
      }
      fr[0].ntg += 1; fr[0].tg_f[fr[0].ntg] = nd;
    }
  }
  // the face meshes
  fr[0].np = 0; fr[0].ps[0] = 0; ne := 0;
  for mi: 0..<7 {
    name := FACE_MESHES[mi];
    obj_read(txt_cat3(txt, head, "/", txt_cat(txt, name, ".obj")), ob, fr[0].text[..]);
    skin_read(txt_cat3(txt, head, "/", txt_cat(txt, name, ".skin.txt")), sk, fr[0].text[..]);
    fr[0].first[mi] = fr[0].np;
    if fr[0].np + ob[0].nv > FR_P { ph_die("metahuman: face points past the port's table"); }
    position_normals(ob, fr[0].nrm[fr[0].np..<fr[0].np + ob[0].nv]);
    for i: 0..<ob[0].nv {
      p := fr[0].np + i;
      fr[0].pts[p] = ob[0].v[i];
      for e: sk[0].s[i]..<sk[0].s[i + 1] { if ne >= FR_PS { ph_die("metahuman: face skins past the port's table"); } fr[0].pj[ne] = sk[0].j[e]; fr[0].pw[ne] = sk[0].w[e]; ne += 1; }
      fr[0].ps[p + 1] = ne;
    }
    fr[0].np += ob[0].nv;
    fr[0].index[mi] = -1;
    for q: 0..<fr[0].nm { if fr[0].mesh[q] == name { fr[0].index[mi] = q; break; } }
    if fr[0].index[mi] < 0 { ph_die2("metahuman: the face rig has no mesh ", name); }
  }
  fr[0].ok = true;
  return true;
}
u16_at :: (b: []u8, at: int) -> int { return cast(int) b[at] | (cast(int) b[at + 1] << 8); }
// the control index of CTRL_expressions.NAME
fr_control :: (fr: []FaceRig, name: string) -> int {
  for i: 0..<fr[0].nraw { r := fr[0].raw[i]; if r.count == 17 + name.count && starts(r, "CTRL_expressions.") && r[17..<r.count] == name { return i; } }
  ph_die2("metahuman: no control CTRL_expressions.", name);
  return -1;
}
// evaluate(): the controls (fr.c) for raw values; attributes (fr.attr) when joints
fr_evaluate :: (fr: []FaceRig, rk: []int, rv: []f64, joints: bool) {
  for i: 0..<fr[0].controls { fr[0].c[i] = 0.0; }
  for i: 0..<rk.count { fr[0].c[rk[i]] = rv[i]; }
  for p: 0..<fr[0].npsd {
    v := fr[0].psd_w[p];
    for e: fr[0].psd_f[p]..<fr[0].psd_f[p + 1] { v *= vmin(vmax(fr[0].c[fr[0].psd_in[e]], 0.0), 1.0); }
    fr[0].c[fr[0].psd_out[p]] = vmin(1.0, v);
  }
  if !joints { return; }
  for i: 0..<fr[0].nj * 9 { fr[0].attr[i] = 0.0; }
  for g: 0..<fr[0].ng {
    i0 := fr[0].g_in_f[g]; n := fr[0].g_in_f[g + 1] - i0;
    any := false; for k: 0..<n { if fr[0].c[fr[0].gi[i0 + k]] != 0.0 { any = true; } }
    if !any { continue; }
    o0 := fr[0].g_out_f[g]; v0 := fr[0].g_val_f[g];
    for r: 0..<fr[0].g_out_f[g + 1] - o0 {
      s: [1] PnSum;
      for k: 0..<n { pn_add(s[..], fr[0].gv[v0 + r * n + k] * fr[0].c[fr[0].gi[i0 + k]]); }
      o := fr[0].go[o0 + r];
      fr[0].attr[o] = fr[0].attr[o] + (ifx n == 0 then 0.0 else pn_total(s[0]));
    }
  }
}
FrPose :: struct { R: [FR_J][3][3] f64; t: [FR_J][3] f64; }
// the joints' world transforms from fr.attr
fr_world :: (fr: []FaceRig, W: []FrPose) {
  for j: 0..<fr[0].nj {
    a := 9 * j;
    r := fr[0].jr[j]; t := fr[0].jt[j];
    R := euler_xyz(r[0] + fr[0].attr[a + 3], r[1] + fr[0].attr[a + 4], r[2] + fr[0].attr[a + 5]);
    s := [3] f64.[1.0 + fr[0].attr[a + 6], 1.0 + fr[0].attr[a + 7], 1.0 + fr[0].attr[a + 8]];
    for i: 0..<3 { for k: 0..<3 { R[i][k] = R[i][k] * s[k]; } }
    lt := [3] f64.[t[0] + fr[0].attr[a], t[1] + fr[0].attr[a + 1], t[2] + fr[0].attr[a + 2]];
    p := fr[0].jpar[j];
    if p < 0 { W[0].R[j] = R; W[0].t[j] = lt; }
    else {
      W[0].R[j] = mmul3(W[0].R[p], R);
      pt := W[0].t[p]; PR := W[0].R[p];
      for i: 0..<3 { W[0].t[j][i] = pt[i] + pn_sum3(PR[i][0] * lt[0], PR[i][1] * lt[1], PR[i][2] * lt[2]); }
    }
  }
}
// metahuman.euler_xyz (face_rig.euler): Rz Ry Rx, degrees
euler_xyz :: (rx: f64, ry: f64, rz: f64) -> [3][3] f64 {
  d := PH_PI / 180.0;
  cx := cos(rx * d); sx := sin(rx * d); cy := cos(ry * d); sy := sin(ry * d); cz := cos(rz * d); sz := sin(rz * d);
  m: [3][3] f64;
  m[0] = [3] f64.[cy * cz, cz * sx * sy - cx * sz, cx * cz * sy + sx * sz];
  m[1] = [3] f64.[cy * sz, cx * cz + sx * sy * sz, (0.0 - cz) * sx + cx * sy * sz];
  m[2] = [3] f64.[0.0 - sy, cy * sx, cx * cy];
  return m;
}
// skinned() of the head mesh's points for raw controls: the farthest a point moves (cm)
fr_reach :: (fr: []FaceRig, rk: []int, rv: []f64, W: []FrPose, W0: []FrPose) -> f64 {
  fr_evaluate(fr, rk[0..<0], rv[0..<0], true); fr_world(fr, W0);
  fr_evaluate(fr, rk, rv, true); fr_world(fr, W);
  hm := fr[0].index[0]; n := fr[0].first[1];
  for i: 0..<n { fr[0].q[i] = fr[0].pts[i]; }
  for t: 0..<fr[0].ntg {
    if fr[0].tg_m[t] != hm { continue; }
    ctl := fr[0].chan_ctl[fr[0].tg_c[t]];
    w := fr[0].c[ctl];
    if w == 0.0 { continue; }
    for e: fr[0].tg_f[t]..<fr[0].tg_f[t + 1] { v := fr[0].dv[e]; for i: 0..<3 { fr[0].q[v][i] = fr[0].q[v][i] + w * fr[0].dd[e][i]; } }
  }
  far := 0.0; first := true;
  for p: 0..<n {
    x := fr[0].q[p]; q := [3] f64.[0.0, 0.0, 0.0];
    for e: fr[0].ps[p]..<fr[0].ps[p + 1] {
      j := fr[0].pj[e]; w := fr[0].pw[e];
      R := W[0].R[j]; t := W[0].t[j]; R0 := W0[0].R[j]; t0 := W0[0].t[j];
      y: [3] f64;
      for i: 0..<3 { y[i] = pn_sum3(R0[0][i] * (x[0] - t0[0]), R0[1][i] * (x[1] - t0[1]), R0[2][i] * (x[2] - t0[2])); }
      for i: 0..<3 { q[i] = q[i] + w * (t[i] + pn_sum3(R[i][0] * y[0], R[i][1] * y[1], R[i][2] * y[2])); }
    }
    d := pn_dist3(q, fr[0].pts[p]);
    if first || d > far { far = d; } first = false;
  }
  return far;
}

// ---- the expressions (raw controls by name)

EXPR_NAMES :: [27] string.["neutral", "smile", "frown", "surprise", "talk", "blink", "jaw",
  "rest", "mbp", "fv", "th", "dtnl", "kg", "sz", "chj", "r", "aa", "ee", "ih", "oh", "oo",
  "calm", "worried", "urgent", "angry", "cheerful", "grim"];
Expr :: struct { n: int; k: [32] string; v: [32] f64; kb: [1024] u8; nb: int; }
ex_add :: (e: []Expr, name: string, v: f64) {
  for i: 0..<e[0].n { if e[0].k[i] == name { e[0].v[i] = v; return; } }
  for i: 0..<name.count { e[0].kb[e[0].nb + i] = name[i]; }
  e[0].k[e[0].n] = cast(string) e[0].kb[e[0].nb..<e[0].nb + name.count]; e[0].nb += name.count; e[0].v[e[0].n] = v; e[0].n += 1;
}
// both(): the same value on each side (L R), or each quarter of the lips (UL UR DL DR) for NAME*4
ex_both :: (e: []Expr, names: string, v: f64) {
  w: [1] Words; w[0] = words(names);
  while true {
    n := word(w[..]); if n.count == 0 { break; }
    b: [64] u8;
    if ends(n, "*4") {
      for q: [4] string.["UL", "UR", "DL", "DR"] { ex_add(e, cat2(b[..], n[0..<n.count - 2], q), v); }
    } else { ex_add(e, cat2(b[..], n, "L"), v); ex_add(e, cat2(b[..], n, "R"), v); }
  }
}
expression :: (k: int, e: []Expr) {
  e[0].n = 0; e[0].nb = 0;
  nm := EXPR_NAMES[k];
  if nm == "smile" { ex_add(e, "mouthCornerPullL", 0.85); ex_add(e, "mouthCornerPullR", 0.85); ex_add(e, "eyeCheekRaiseL", 0.45); ex_add(e, "eyeCheekRaiseR", 0.45); ex_add(e, "mouthStretchL", 0.15); ex_add(e, "mouthStretchR", 0.15); ex_add(e, "noseNasolabialDeepenL", 0.3); ex_add(e, "noseNasolabialDeepenR", 0.3); }
  else if nm == "frown" { ex_add(e, "browDownL", 0.8); ex_add(e, "browDownR", 0.8); ex_add(e, "browLateralL", 0.5); ex_add(e, "browLateralR", 0.5); ex_add(e, "mouthCornerDepressL", 0.6); ex_add(e, "mouthCornerDepressR", 0.6); ex_add(e, "noseWrinkleL", 0.25); ex_add(e, "noseWrinkleR", 0.25); ex_add(e, "eyeSquintInnerL", 0.3); ex_add(e, "eyeSquintInnerR", 0.3); }
  else if nm == "surprise" { ex_add(e, "browRaiseInL", 0.9); ex_add(e, "browRaiseInR", 0.9); ex_add(e, "browRaiseOuterL", 0.9); ex_add(e, "browRaiseOuterR", 0.9); ex_add(e, "eyeWidenL", 0.6); ex_add(e, "eyeWidenR", 0.6); ex_add(e, "jawOpen", 0.35); }
  else if nm == "talk" { ex_add(e, "mouthLipsTogetherUL", 0.0); }
  else if nm == "blink" { ex_add(e, "eyeBlinkL", 1.0); ex_add(e, "eyeBlinkR", 1.0); }
  else if nm == "jaw" { ex_add(e, "jawOpen", 1.0); }
  else if nm == "mbp" { ex_both(e, "mouthLipsTogether*4", 1.0); ex_both(e, "mouthPress*4", 0.35); ex_add(e, "jawOpen", 0.03); }
  else if nm == "fv" { ex_both(e, "mouthLowerLipBite", 0.55); ex_both(e, "mouthLowerLipTowardsTeeth", 0.6); ex_both(e, "mouthUpperLipRaise", 0.2); ex_add(e, "jawOpen", 0.08); }
  else if nm == "th" { ex_add(e, "jawOpen", 0.18); ex_add(e, "tongueOut", 0.4); ex_add(e, "tongueTipUp", 0.3); ex_both(e, "mouthStretch", 0.1); }
  else if nm == "dtnl" { ex_add(e, "jawOpen", 0.2); ex_add(e, "tongueTipUp", 0.7); ex_add(e, "tongueUp", 0.3); ex_both(e, "mouthStretch", 0.12); }
  else if nm == "kg" { ex_add(e, "jawOpen", 0.26); ex_add(e, "tongueUp", 0.45); ex_both(e, "mouthStretch", 0.15); }
  else if nm == "sz" { ex_add(e, "jawOpen", 0.07); ex_both(e, "mouthStretch", 0.35); ex_both(e, "mouthUpperLipRaise", 0.18); ex_both(e, "mouthLowerLipDepress", 0.18); }
  else if nm == "chj" { ex_add(e, "jawOpen", 0.12); ex_both(e, "mouthFunnel*4", 0.5); ex_both(e, "mouthUpperLipRaise", 0.2); ex_both(e, "mouthLowerLipDepress", 0.15); }
  else if nm == "r" { ex_add(e, "jawOpen", 0.15); ex_both(e, "mouthFunnel*4", 0.3); ex_both(e, "mouthCornerNarrow", 0.3); }
  else if nm == "aa" { ex_add(e, "jawOpen", 0.6); ex_both(e, "mouthLowerLipDepress", 0.2); ex_both(e, "mouthUpperLipRaise", 0.1); }
  else if nm == "ee" { ex_add(e, "jawOpen", 0.15); ex_both(e, "mouthStretch", 0.45); ex_both(e, "mouthCornerWide", 0.35); ex_both(e, "mouthCornerPull", 0.15); }
  else if nm == "ih" { ex_add(e, "jawOpen", 0.28); ex_both(e, "mouthStretch", 0.25); }
  else if nm == "oh" { ex_add(e, "jawOpen", 0.4); ex_both(e, "mouthFunnel*4", 0.55); ex_both(e, "mouthLipsPurse*4", 0.15); }
  else if nm == "oo" { ex_add(e, "jawOpen", 0.12); ex_both(e, "mouthLipsPurse*4", 0.7); ex_both(e, "mouthFunnel*4", 0.4); ex_both(e, "mouthLipsTowards*4", 0.3); }
  else if nm == "worried" { ex_both(e, "browRaiseIn", 0.75); ex_both(e, "browLateral", 0.35); ex_both(e, "eyeWiden", 0.15); }
  else if nm == "urgent" { ex_both(e, "browRaiseIn", 0.6); ex_both(e, "browRaiseOuter", 0.5); ex_both(e, "eyeWiden", 0.45); }
  else if nm == "angry" { ex_both(e, "browDown", 0.8); ex_both(e, "browLateral", 0.5); ex_both(e, "eyeSquintInner", 0.35); ex_both(e, "noseWrinkle", 0.2); }
  else if nm == "cheerful" { ex_both(e, "eyeCheekRaise", 0.4); ex_both(e, "mouthCornerPull", 0.35); }
  else if nm == "grim" { ex_both(e, "browDown", 0.45); ex_both(e, "mouthCornerDepress", 0.3); }
}
EXPRS :: 27;
// an expression's controls: indices and values
ex_controls :: (fr: []FaceRig, k: int, rk: []int, rv: []f64) -> int {
  e: [1] Expr; expression(k, e[..]);
  for i: 0..<e[0].n { rk[i] = fr_control(fr, e[0].k[i]); rv[i] = e[0].v[i]; }
  return e[0].n;
}
// face()'s checks: blink and jaw move the head; each viseme but rest moves the mouth
face_checks :: (fr: []FaceRig, W: []FrPose, W0: []FrPose) {
  rk: [32] int; rv: [32] f64;
  for k: 0..<EXPRS {
    nm := EXPR_NAMES[k];
    viseme := k >= 7 && k <= 20;
    if !(nm == "blink" || nm == "jaw" || (viseme && nm != "rest")) { continue; }
    n := ex_controls(fr, k, rk[..], rv[..]);
    far := fr_reach(fr, rk[0..<n], rv[0..<n], W, W0);
    lb: [256] u8; o: [1] Sb; o[0] = sb(lb[..]);
    if viseme { sb_put(o[..], "face rig: viseme "); } else { sb_put(o[..], "face rig: "); }
    sb_put(o[..], nm); sb_put(o[..], " moves the head's points up to "); sb_fixed(o[..], far, 2); sb_put(o[..], " cm"); sb_line(o[..]);
    if !viseme && far < 0.5 { ph_die2("metahuman: the face rig barely moves the face: ", nm); }
    if viseme && far < VISEME_MOVE_MIN { ph_die2("metahuman: the face rig's viseme barely moves the mouth: ", nm); }
  }
}
// face_rig.check order: blink, jaw, then the visemes (face() prints them in that order)
// active_controls(): the controls the lab can ever set (fr.on)
active_controls :: (fr: []FaceRig) {
  for i: 0..<fr[0].controls { fr[0].on[i] = false; }
  ak: [32] int; av: [32] f64; bk: [32] int; bv: [32] f64; rk: [64] int; rv: [64] f64;
  for a: 0..<EXPRS {
    na := ex_controls(fr, a, ak[..], av[..]);
    for b: 0..<EXPRS {
      nb := ex_controls(fr, b, bk[..], bv[..]);
      n := 0;
      for i: 0..<na { rk[n] = ak[i]; rv[n] = av[i]; n += 1; }
      for i: 0..<nb {
        f := -1; for z: 0..<n { if rk[z] == bk[i] { f = z; } }
        if f < 0 { rk[n] = bk[i]; rv[n] = vmin(1.0, 0.0 + bv[i]); n += 1; } else { rv[f] = vmin(1.0, rv[f] + bv[i]); }
      }
      fr_evaluate(fr, rk[0..<n], rv[0..<n], false);
      for i: 0..<fr[0].controls { if abs(fr[0].c[i]) > 0.000001 { fr[0].on[i] = true; } }
    }
  }
}
// the block (face_rig.pack): the face pieces in pack order give each face vertex its point
FB :: struct { b: []u8; n: int; }
fb_u32 :: (o: []FB, v: int) { if o[0].n + 4 > o[0].b.count { ph_die("pack_human: a face block past the port's buffer"); } put_u32(o[0].b, o[0].n, v); o[0].n += 4; }
fb_f32 :: (o: []FB, v: f64) { fb_u32(o, cast(int) f32_bits(cast(f32) v)); }
fb_u16 :: (o: []FB, v: int) { if o[0].n + 2 > o[0].b.count { ph_die("pack_human: a face block past the port's buffer"); } o[0].b[o[0].n] = cast(u8) (v & 255); o[0].b[o[0].n + 1] = cast(u8) ((v >> 8) & 255); o[0].n += 2; }
face_block :: (fr: []FaceRig, pk: []Pack, st: []Store, order: []int, lean: bool, out: []u8) -> int {
  if !fr[0].ok { return 0; }
  if lean { active_controls(fr); }
  o: [1] FB; o[0].b = out; o[0].n = 0;
  out[0] = 'F'; out[1] = 'R'; out[2] = 'G'; out[3] = '1'; o[0].n = 4;
  // the groups kept (lean: the inputs the expressions set, the outputs they move)
  keep_g: [FR_G] bool; ng := 0;
  for g: 0..<fr[0].ng {
    keep_g[g] = true;
    if lean {
      i0 := fr[0].g_in_f[g]; n := fr[0].g_in_f[g + 1] - i0; o0 := fr[0].g_out_f[g]; v0 := fr[0].g_val_f[g];
      nc := 0; for k: 0..<n { if fr[0].on[fr[0].gi[i0 + k]] { nc += 1; } }
      nr := 0;
      for r: 0..<fr[0].g_out_f[g + 1] - o0 { any := false; for k: 0..<n { if fr[0].on[fr[0].gi[i0 + k]] && fr[0].gv[v0 + r * n + k] != 0.0 { any = true; } } if any { nr += 1; } }
      keep_g[g] = nc > 0 && nr > 0;
    }
    if keep_g[g] { ng += 1; }
  }
  // the targets kept
  ntl := 0;
  for mi: 0..<7 {
    m := fr[0].index[mi];
    for t: 0..<fr[0].ntg {
      if fr[0].tg_m[t] != m { continue; }
      if fr_target_count(fr, t, lean) > 0 { ntl += 1; }
    }
  }
  nvp := 0;
  for q: order { p := pk[0].pieces[q]; if p.face.count > 0 { nvp += p.vn; } }
  fb_u32(o[..], fr[0].controls); fb_u32(o[..], fr[0].nraw); fb_u32(o[..], fr[0].npsd); fb_u32(o[..], ng); fb_u32(o[..], fr[0].nj);
  fb_u32(o[..], fr[0].np); fb_u32(o[..], nvp); fb_u32(o[..], ntl); fb_u32(o[..], EXPRS);
  for p: 0..<fr[0].npsd {
    fb_u32(o[..], fr[0].psd_out[p]); fb_f32(o[..], fr[0].psd_w[p]); fb_u32(o[..], fr[0].psd_f[p + 1] - fr[0].psd_f[p]);
    for e: fr[0].psd_f[p]..<fr[0].psd_f[p + 1] { fb_u32(o[..], fr[0].psd_in[e]); }
  }
  for g: 0..<fr[0].ng {
    if !keep_g[g] { continue; }
    i0 := fr[0].g_in_f[g]; n := fr[0].g_in_f[g + 1] - i0; o0 := fr[0].g_out_f[g]; nr0 := fr[0].g_out_f[g + 1] - o0; v0 := fr[0].g_val_f[g];
    cols: [4096] int; nc := 0; rows: [65536] int; nr := 0;
    for k: 0..<n { if !lean || fr[0].on[fr[0].gi[i0 + k]] { cols[nc] = k; nc += 1; } }
    for r: 0..<nr0 {
      keep := !lean;
      if lean { for z: 0..<nc { if fr[0].gv[v0 + r * n + cols[z]] != 0.0 { keep = true; } } }
      if keep { rows[nr] = r; nr += 1; }
    }
    fb_u32(o[..], nr); fb_u32(o[..], nc);
    for z: 0..<nc { fb_u32(o[..], fr[0].gi[i0 + cols[z]]); }
    for z: 0..<nr { fb_u32(o[..], fr[0].go[o0 + rows[z]]); }
    for y: 0..<nr { for z: 0..<nc { fb_f32(o[..], fr[0].gv[v0 + rows[y] * n + cols[z]]); } }
  }
  for j: 0..<fr[0].nj {
    fb_u32(o[..], fr[0].jpar[j] & 4294967295);
    for c: 0..<3 { fb_f32(o[..], fr[0].jt[j][c]); } for c: 0..<3 { fb_f32(o[..], fr[0].jr[j][c]); }
  }
  for p: 0..<fr[0].np {
    for c: 0..<3 { fb_f32(o[..], fr[0].pts[p][c]); } for c: 0..<3 { fb_f32(o[..], fr[0].nrm[p][c]); }
    // the six heaviest (stable), over their own sum
    a := fr[0].ps[p]; n := fr[0].ps[p + 1] - a;
    ix: [64] int; for i: 0..<n { ix[i] = a + i; }
    for i: 1..<n { x := ix[i]; j := i - 1; while j >= 0 && fr[0].pw[ix[j]] < fr[0].pw[x] { ix[j + 1] = ix[j]; j -= 1; } ix[j + 1] = x; }
    m := imin(n, INFLUENCES);
    s: [1] PnSum; for i: 0..<m { pn_add(s[..], fr[0].pw[ix[i]]); }
    tot := ifx m == 0 then 0.0 else pn_total(s[0]); if tot == 0.0 { tot = 1.0; }
    for i: 0..<INFLUENCES {
      if i < m { fb_u16(o[..], fr[0].pj[ix[i]]); fb_u16(o[..], 0); fb_f32(o[..], fr[0].pw[ix[i]] / tot); }
      else { fb_u16(o[..], 0); fb_u16(o[..], 0); fb_f32(o[..], 0.0); }
    }
  }
  for q: order {
    p := pk[0].pieces[q];
    if p.face.count == 0 { continue; }
    mi := -1; for z: 0..<7 { if FACE_MESHES[z] == p.face { mi = z; } }
    for i: p.vf..<p.vf + p.vn { fb_u32(o[..], fr[0].first[mi] + st[0].v[i].pt); }
  }
  for mi: 0..<7 {
    m := fr[0].index[mi];
    for t: 0..<fr[0].ntg {
      if fr[0].tg_m[t] != m { continue; }
      n := fr_target_count(fr, t, lean);
      if n == 0 { continue; }
      fb_u32(o[..], fr[0].chan_ctl[fr[0].tg_c[t]]); fb_u32(o[..], fr[0].first[mi]); fb_u32(o[..], n);
      for e: fr[0].tg_f[t]..<fr[0].tg_f[t + 1] {
        d := fr[0].dd[e];
        if lean && !(abs(d[0]) + abs(d[1]) + abs(d[2]) >= LEAN_DELTA_MIN) { continue; }
        fb_u16(o[..], fr[0].dv[e]);
        for c: 0..<3 { fb_u16(o[..], imax(-32767, imin(32767, pn_round(d[c] / DELTA_UNIT))) & 65535); }
      }
    }
  }
  rk: [32] int; rv: [32] f64;
  for k: 0..<EXPRS {
    n := ex_controls(fr, k, rk[..], rv[..]);
    nm := EXPR_NAMES[k];
    for i: 0..<16 { if o[0].n >= out.count { ph_die("pack_human: a face block past the port's buffer"); } out[o[0].n] = ifx i < nm.count then nm[i] else 0; o[0].n += 1; }
    // a dict: a repeated control keeps its last value, in its first place; then sorted by control
    uk: [32] int; uv: [32] f64; nu := 0;
    for i: 0..<n { f := -1; for z: 0..<nu { if uk[z] == rk[i] { f = z; } } if f < 0 { uk[nu] = rk[i]; uv[nu] = rv[i]; nu += 1; } else { uv[f] = rv[i]; } }
    for i: 1..<nu { xk := uk[i]; xv := uv[i]; j := i - 1; while j >= 0 && uk[j] > xk { uk[j + 1] = uk[j]; uv[j + 1] = uv[j]; j -= 1; } uk[j + 1] = xk; uv[j + 1] = xv; }
    fb_u32(o[..], nu);
    for i: 0..<nu { fb_u32(o[..], uk[i]); fb_f32(o[..], uv[i]); }
  }
  return o[0].n;
}
// a target's deltas as packed (lean: only a set control's, without the small ones)
fr_target_count :: (fr: []FaceRig, t: int, lean: bool) -> int {
  if !lean { return fr[0].tg_f[t + 1] - fr[0].tg_f[t]; }
  if !fr[0].on[fr[0].chan_ctl[fr[0].tg_c[t]]] { return 0; }
  n := 0;
  for e: fr[0].tg_f[t]..<fr[0].tg_f[t + 1] { d := fr[0].dd[e]; if abs(d[0]) + abs(d[1]) + abs(d[2]) >= LEAN_DELTA_MIN { n += 1; } }
  return n;
}
