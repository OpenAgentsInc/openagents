// Original source compound layer -> float32 triangle stream.
// tool.sh: stack-gib 2
#load "kokiri-compound.coax";
tool_main :: ()->int #export_c #effects(all) {args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=3 {print("usage: COMPOUND SECTION_INDEX OUTPUT_TRIANGLES\n");return 2;}data:[67108864]u8;out:[134217728]u8;stats:[1]KcStats;chain:[1]KcTransform;n:=fs_read(args_at(args[..],0),data[..]);if n<=0 {return 3;}b:=data[0..<n];h:=kokiri_phive(b);#assert h.ok && h.kind==2;section:=0;for c:args_at(args[..],1) {#assert c>='0' && c<='9';section=section*10+cast(int)c-48;}#assert section>=0 && section<h.count;p:=h.offset[section];#assert h.size[section]>=64 && scan_u32(b,p+4)==0x30474154 && cast(string)b[p+16..<p+24]=="20250200";size:=kokiri_be32(b,p+24)&0x3fffffff;end:=p+24+size;#assert kokiri_span(b.count,p+24,size);kc_shape(b,p+32,end,chain[0..<0],0,out[..],stats[..]);s:=stats[0];#assert fs_write(args_at(args[..],2),cast(string)out[0..<s.triangles*36]);print("section=% instances=% triangles=% bounds=[%,%,%][%,%,%]\n",section,s.instances,s.triangles,s.low.x,s.low.y,s.low.z,s.high.x,s.high.y,s.high.z);for k:0..<256 {if s.unsupported[k]>0 {print("unsupported_type=% count=%\n",k,s.unsupported[k]);}}return 0;}
