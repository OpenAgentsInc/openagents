// Read only Phive layer/material names from the original Bootup SARC.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "kokiri-byml.coax";
kpc_node :: (b:[]u8,n:KbNode,key:string,depth:int) {#assert depth<16;if n.kind==0xc1 || n.kind==0xc0 {print("depth=% key=% kind=% count=%\n",depth,key,n.kind,kb_count(b,n));for k:0..<kb_count(b,n) {name:=ifx n.kind==0xc1 then kb_key(b,n,k) else "[]";kpc_node(b,kb_at(b,n,k),name,depth+1);}}else if n.kind==0xa0 {print("depth=% key=% string=%\n",depth,key,kb_string(b,n));}else {print("depth=% key=% kind=% raw=%\n",depth,key,n.kind,n.value);}}
tool_main :: ()->int #export_c #effects(all) {a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}data:[8388608]u8;n:=fs_read(args_at(a[..],0),data[..]);#assert n>0;config:=kb_sarc(data[0..<n],"Phive/Config/PhiveConfig.byml");#assert config.count>0;root:=kb_root(config);masks:=kb_get(config,root,"LayerHitMaskEntityCollection");for k:0..<kb_count(config,masks) {entry:=kb_at(config,masks,k);name:=kb_string(config,kb_get(config,entry,"ComponentName"));mask:=kb_get(config,entry,"MaskValue");#assert mask.kind==0xd5 && ob_span(config.count,mask.value,8);print("ENTITY_MASK name=% low=% high=%\n",name,scan_u32(config,mask.value),scan_u32(config,mask.value+4));}names:=kb_get(config,root,"LayerEntityCollection");set:=kb_get(config,kb_get(config,root,"LayerEntityParamTableSet"),"Default");table:=kb_get(config,set,"LayerEntityFilterTable");row:=kb_at(config,table,3);for k:0..<kb_count(config,row) {print("PLAYER_LAYER name=% filter=%\n",kb_string(config,kb_at(config,names,k)),kb_int(kb_at(config,row,k)));}return 0;}
