// Source SDK samples + Valley glTF morphs -> private named EFC1 stream and GPU CSR deltas.
// tool.sh: stack-gib 2
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/json/json.coax";
#load "../../metaverse-engine/render/geometry/scan.coax";
#load "../../coax/lib/text/ph_num.coax";
#load "../../metaverse-engine/anim/face-pack.coax";
#load "../../metaverse-engine/tools/echo-gltf.coax";
#test "Slay bindings resolve case independently of the SDK FName pool" {a:=[2]SfName.[sf_name("FACIAL_C_Jaw"),sf_name("jawOpen")];#assert sf_find(a[..],"facial_c_jaw")==0 && sf_find(a[..],"JAWOPEN")==1 && sf_find(a[..],"unknown")== -1;}
#test "source left-handed centimetres become the existing glTF local coordinates" {p:=sf_local([10]f32.[1,2,3,0.1,0.2,0.3,0.9,1,1,1]);#assert p[0]==0.01 && p[1]==0.03 && p[2]==0.02 && p[3]== -0.1 && p[4]== -0.3 && p[5]== -0.2 && p[6]==0.9;}
#load "slay-source.coax";
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=3 {return 2;}
 source:=args_at(args[..],0);slay:=args_at(args[..],1);dest:=args_at(args[..],2);g:[1]EpJson;j:[1]EpJson;path:[4096]u8;
 targets:[256]SfName;rig:[334]SfName;bones:[64]SfName;bone_ids:[64]int;curves:[256]SfName;curve_ids:[256]int;
 sf_json(j[..],slay,"receipt.json");names:=ep_get(j[..],0,"/Game/AncientContent/Characters/Echo/Meshes/Echo");nt:=ep_len(j[..],names);#assert nt==181;
 for k:0..<nt {targets[k]=sf_name(ep_text(j[..],ep_item(j[..],names,k),"name"));}
 ep_load(g[..],source,"Echo.gltf");skin:=ep_top(g[..],"skins",0);joints:=ep_get(g[..],skin,"joints");#assert ep_len(g[..],joints)==134;
 for k:0..<134 {node:=ep_top(g[..],"nodes",jv_int(g[0].d[0],ep_item(g[..],joints,k),-1));rig[k]=sf_name(ep_text(g[..],node,"name"));}
 ep_load(g[..],source,"Echo_Hair.gltf");skin=ep_top(g[..],"skins",0);joints=ep_get(g[..],skin,"joints");#assert ep_len(g[..],joints)==200;
 for k:0..<200 {node:=ep_top(g[..],"nodes",jv_int(g[0].d[0],ep_item(g[..],joints,k),-1));name:=ep_text(g[..],node,"name");text:[64]u8;for c,i:"groom." {text[i]=c;}for c,i:name {#assert i+6<64;text[i+6]=c;}rig[134+k]=sf_name(cast(string)text[0..<name.count+6]);}
 sf_json(j[..],slay,"TF0100_Echo_Face.samples.json");raw_bones:=ep_get(j[..],0,"bones");#assert ep_len(j[..],raw_bones)==18;nb:=0;
 for k:0..<18 {name:=ep_text(j[..],ep_item(j[..],raw_bones,k),"name");id:=sf_find(rig[0..<134],name);if id<0 {#assert name=="facial_c_skull" || name=="facial_c_chin";print("Unused source skeleton leaf absent from both mesh reference skeletons: %\n",name);continue;}bones[nb]=sf_name(name);bone_ids[nb]=id;nb+=1;}#assert nb==16;
 raw_curves:=ep_get(j[..],0,"curves");ncurves:=0;
 for k:0..<ep_len(j[..],raw_curves) {name:=ep_text(j[..],ep_item(j[..],raw_curves,k),"name");id:=sf_find(targets[0..<nt],name);if id<0 {print("Unmapped SDK curve (not a mesh target): %\n",name);continue;}curves[ncurves]=sf_name(name);curve_ids[ncurves]=id;ncurves+=1;}#assert ncurves==125;
 out:[FACE_PACK_CAP]u8;f:=FacePack.{targets=nt,vertices=313371,clips=20,bones=nb,curves=ncurves,joints=334,target_table=80};
 f.rig_names=f.target_table+nt*80;f.bone_table=f.rig_names+334*64;f.curve_table=f.bone_table+nb*68;f.clip_table=f.curve_table+ncurves*68;f.delta_table=f.clip_table+20*80;
 for k:0..<nt {sf_write_name(out[..],f.target_table+k*80,targets[k]);}
 for k:0..<334 {sf_write_name(out[..],f.rig_names+k*64,rig[k]);}
 for k:0..<nb {at:=f.bone_table+k*68;sf_write_name(out[..],at,bones[k]);face_put(out[..],at+64,cast(u32)bone_ids[k]);}
 for k:0..<ncurves {at:=f.curve_table+k*68;sf_write_name(out[..],at,curves[k]);face_put(out[..],at+64,cast(u32)curve_ids[k]);}
 ep_load(g[..],source,"Echo.gltf");primitives:=ep_get(g[..],ep_top(g[..],"meshes",0),"primitives");p:[4194304]u8;n:[4194304]u8;at:=f.delta_table;deltas:=0;
 for target:0..<nt {descriptor:=f.target_table+target*80;face_put(out[..],descriptor+64,cast(u32)deltas);base:=0;
  for primitive:0..<ep_len(g[..],primitives) {pr:=ep_item(g[..],primitives,primitive);morph:=ep_item(g[..],ep_get(g[..],pr,"targets"),target);pa:=ep_read(g[..],ep_int(g[..],morph,"POSITION",-1),p[..]);na:=ep_read(g[..],ep_int(g[..],morph,"NORMAL",-1),n[..]);#assert pa.count==na.count && pa.component==5126 && na.component==5126 && pa.components==3 && na.components==3;
   for vertex:0..<pa.count {active:=false;for axis:0..<3 {if (scan_u32(p[..],vertex*12+axis*4)&0x7fffffff)!=0 || (scan_u32(n[..],vertex*12+axis*4)&0x7fffffff)!=0 {active=true;}}
    if !active {continue;}#assert at+32<=out.count;face_put(out[..],at,cast(u32)(base+vertex));face_put(out[..],at+4,cast(u32)target);for axis:0..<3 {face_put(out[..],at+8+axis*4,scan_u32(p[..],vertex*12+axis*4));face_put(out[..],at+20+axis*4,scan_u32(n[..],vertex*12+axis*4));}at+=32;deltas+=1;
   }base+=pa.count;
  }face_put(out[..],descriptor+68,cast(u32)(deltas-cast(int)face_word(out[..],descriptor+64)));
 }#assert deltas==564903;f.deltas=deltas;f.data=at;
 sf_json(j[..],slay,"receipt.json");clips:=ep_get(j[..],0,"clips");clip_names:[20]SfName;for k:0..<20 {clip_names[k]=sf_name(ep_text(j[..],ep_item(j[..],clips,k),"name"));}
 for clip:0..<20 {name:=clip_names[clip];file:[128]u8;for c,k:name.bytes[0..<name.n] {file[k]=c;}suffix:=".samples.json";for c,k:suffix {file[name.n+k]=c;}
  // Unreal asset filenames are case-preserving on disk; rebuild the known source spelling.
  file[0]='T';file[1]='F';for k:0..<name.n {if k>=7 && name.bytes[k]=='e' && name.bytes[k+1]=='c' {file[k]='E';}if k>=7 && name.bytes[k]=='f' && name.bytes[k+1]=='a' {file[k]='F';}}
  sf_json(j[..],slay,cast(string)file[0..<name.n+suffix.count]);frames:=ep_int(j[..],0,"frames",0);rate:=cast(f32)ep_int(j[..],0,"fps_numerator",0)/cast(f32)ep_int(j[..],0,"fps_denominator",0);#assert frames>=2 && frames<=2000 && rate==24;
  desc:=f.clip_table+clip*80;sf_write_name(out[..],desc,name);face_put(out[..],desc+64,cast(u32)frames);face_put(out[..],desc+68,f32_bits(rate));face_put(out[..],desc+72,cast(u32)at);weights:=at;at+=frames*ncurves*4;face_put(out[..],desc+76,cast(u32)at);poses:=at;at+=frames*nb*28;#assert at<=out.count;
  tracks:=ep_get(j[..],0,"curves");found:[256]bool;
  for k:0..<ep_len(j[..],tracks) {row:=ep_item(j[..],tracks,k);id:=sf_find(curves[0..<ncurves],ep_text(j[..],row,"name"));if id<0 {continue;}#assert !found[id];found[id]=true;values:=ep_get(j[..],row,"values");#assert ep_len(j[..],values)==frames;node:=j[0].nodes[values].first;for frame:0..<frames {face_put(out[..],weights+(frame*ncurves+id)*4,f32_bits(sf_value(j[..],node)));node=j[0].nodes[node].next;}}
  for k:0..<ncurves {#assert found[k];}
  tracks=ep_get(j[..],0,"bones");#assert ep_len(j[..],tracks)==18;found_bones:[64]bool;
  for k:0..<18 {row:=ep_item(j[..],tracks,k);bone_name:=ep_text(j[..],row,"name");id:=sf_find(bones[0..<nb],bone_name);if id<0 {#assert bone_name=="facial_c_skull" || bone_name=="facial_c_chin";continue;}#assert !found_bones[id];found_bones[id]=true;values:=ep_get(j[..],row,"values");#assert ep_len(j[..],values)==frames*10;node:=j[0].nodes[values].first;for frame:0..<frames {raw:[10]f32;for v:0..<10 {raw[v]=sf_value(j[..],node);node=j[0].nodes[node].next;}local:=sf_local(raw);for v:0..<7 {face_put(out[..],poses+((frame*nb+id)*7+v)*4,f32_bits(local[v]));}}}
  for k:0..<nb {#assert found_bones[k];}
  print("Face % frames=% rate=% mapped_curves=% bones=%\n",cast(string)name.bytes[0..<name.n],frames,rate,ncurves,nb);
 }
 header:=[17]u32.[0x31434645,1,cast(u32)at,cast(u32)nt,313371,cast(u32)deltas,20,cast(u32)nb,cast(u32)ncurves,334,80,cast(u32)f.rig_names,cast(u32)f.bone_table,cast(u32)f.curve_table,cast(u32)f.clip_table,cast(u32)f.delta_table,cast(u32)f.data];for x,k:header {face_put(out[..],k*4,x);}
 #assert face_valid(out[0..<at]);#assert fs_write(ep_path(dest,"echo.face",path[..]),cast(string)out[0..<at]);
 // GPU CSR: per mesh vertex a first/count pair; each entry has target + position/normal delta.
 ranges:[313371*8]u8;cursor:[313371]int;
 for k:0..<deltas {id:=cast(int)face_word(out[..],f.delta_table+k*32);cursor[id]+=1;}
 start:=0;for vertex:0..<313371 {count:=cursor[vertex];scan_put(ranges[..],vertex*8,cast(u32)start);scan_put(ranges[..],vertex*8+4,cast(u32)count);cursor[vertex]=start;start+=count;}#assert start==deltas;
 gpu:[2000000*28]u8;for k:0..<deltas {src:=f.delta_table+k*32;id:=cast(int)face_word(out[..],src);dst:=cursor[id]*28;cursor[id]+=1;for word:0..<7 {scan_put(gpu[..],dst+word*4,face_word(out[..],src+4+word*4));}}
 #assert fs_write(ep_path(dest,"echo.morph",path[..]),cast(string)gpu[0..<deltas*28]);#assert fs_write(ep_path(dest,"echo.morph-ranges",path[..]),cast(string)ranges[..]);
 print("Face pack bytes=% morph_entries=% gpu_bytes=%\n",at,deltas,deltas*28);return 0;
}
