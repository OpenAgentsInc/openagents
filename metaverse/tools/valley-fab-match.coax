// Match Quixel import IDs against public Fab file metadata; catalog only.
// No account tokens, purchases, entitlement changes or asset downloads.
// tool.sh: tls
// coax/web/tool.sh metaverse/tools/valley-fab-match.coax OUTPUT_JSON ID...
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/net/http.coax";
#test "Fab source matching requires an exact delimited ID and safe input" {
  #assert vf_id_ok("uk4sehs") && vf_id_ok("ubhvccfda") && !vf_id_ok("") && !vf_id_ok("../../x") && !vf_id_ok("UPPERCASE");
  #assert vf_matches("desert_western_rock_small_11_uk4sehs_ue_low.zip","uk4sehs");
  #assert !vf_matches("asset_uk4sehsx_low.zip","uk4sehs") && !vf_matches("uk4sehs_low.zip","uk4sehs");
}
vf_id_ok :: (s:string)->bool {if s.count<6 || s.count>12 {return false;}for c:s {if !((c>='a' && c<='z') || (c>='0' && c<='9')) {return false;}}return true;}
vf_matches :: (name:string,id:string)->bool {for k:1..<name.count-id.count {if name[k-1]=='_' && name[k..<k+id.count]==id && name[k+id.count]=='_' {return true;}}return false;}
vf_string :: (doc:Jv,object:int,key:string,out:[]u8)->string {n:=jv_str(doc,jv_get(doc,object,key),out);return ifx n<0 then "" else cast(string)out[0..<n];}
vf_url :: (parts:[]string,out:[]u8)->string {at:=0;for part:parts {for c:part {if at>=out.count {return "";}out[at]=c;at+=1;}}return cast(string)out[0..<at];}
vf_get :: (url:string,body:[]u8)->int {
  w:[1]HttpWork;headers:=[2]string.["Accept: application/json","User-Agent: OpenAgents-ValleyLab-Catalog/1.0"];
  r:=http_do(w[..],"GET",url,headers[..],"",10000,0,body);if r.error!=HTTP_OK || r.code!=200 {print("catalog HTTP error=% status=%\n",r.error,r.code);return -1;}return r.n;
}
vf_match :: (id:string,out:[]Jo) {
  body:[1048576]u8;url:[2048]u8;parts:=[2]string.["https://www.fab.com/i/listings/search?q=",id];n:=vf_get(vf_url(parts[..],url[..]),body[..]);
  jo_obj(out);jo_key(out,"quixel_id");jo_str(out,id);jo_key(out,"matches");jo_arr(out);
  if n>=0 {doc:[1]Jv;nodes:[8192]JvNode;if jv_parse(doc[..],cast(string)body[0..<n],nodes[..]) {
    results:=jv_get(doc[0],0,"results");uids:[3][64]u8;length:[3]int;count:=jv_len(doc[0],results);if count>3 {count=3;}
    for k:0..<count {length[k]=jv_str(doc[0],jv_get(doc[0],jv_at(doc[0],results,k),"uid"),uids[k][..]);}
    for k:0..<count {if length[k]<=0 {continue;}uid:=cast(string)uids[k][0..<length[k]];
      parts2:=[3]string.["https://www.fab.com/i/listings/",uid,"/asset-formats/gltf"];n=vf_get(vf_url(parts2[..],url[..]),body[..]);if n<0 {continue;}
      if !jv_parse(doc[..],cast(string)body[0..<n],nodes[..]) {continue;}files:=jv_get(doc[0],0,"files");matched:=false;name_buf:[1024]u8;
      for f:0..<jv_len(doc[0],files) {name:=vf_string(doc[0],jv_at(doc[0],files,f),"name",name_buf[..]);if vf_matches(name,id) {matched=true;}}
      if !matched {continue;}
      jo_obj(out);jo_key(out,"listing_uid");jo_str(out,uid);parts3:=[2]string.["https://www.fab.com/listings/",uid];jo_key(out,"url");jo_str(out,vf_url(parts3[..],url[..]));jo_key(out,"matched_gltf_files");jo_arr(out);
      for f:0..<jv_len(doc[0],files) {file:=jv_at(doc[0],files,f);name:=vf_string(doc[0],file,"name",name_buf[..]);if !vf_matches(name,id) {continue;}jo_obj(out);jo_key(out,"name");jo_str(out,name);jo_key(out,"file_uid");tmp:[64]u8;jo_str(out,vf_string(doc[0],file,"uid",tmp[..]));jo_key(out,"bytes");jo_int(out,jv_int(doc[0],jv_get(doc[0],file,"size"),-1));jo_end(out);}jo_end(out);
      parts4:=[2]string.["https://www.fab.com/i/listings/",uid];n=vf_get(vf_url(parts4[..],url[..]),body[..]);
      if n>=0 && jv_parse(doc[..],cast(string)body[0..<n],nodes[..]) {title:[512]u8;jo_key(out,"title");jo_str(out,vf_string(doc[0],0,"title",title[..]));jo_key(out,"licenses");jo_arr(out);licenses:=jv_get(doc[0],0,"licenses");
        for l:0..<jv_len(doc[0],licenses) {license:=jv_at(doc[0],licenses,l);jo_obj(out);jo_key(out,"name");jo_str(out,vf_string(doc[0],license,"name",name_buf[..]));price:=jv_get(doc[0],license,"priceTier");jo_key(out,"price");value:=jv_get(doc[0],price,"price");if value>=0 {jv_write(doc[0],value,out);}else {jo_null(out);}jo_key(out,"currency");jo_str(out,vf_string(doc[0],price,"currencyCode",name_buf[..]));jo_end(out);}jo_end(out);
      }jo_end(out);print("matched % -> %\n",id,uid);break;
    }
  }}jo_end(out);jo_key(out,"search_candidate_limit");jo_int(out,3);jo_end(out);
}
tool_main :: ()->int #export_c #effects(all) {
  args:[1]Args;if !args_load(args[..]) || args_count(args[..])<2 || args_count(args[..])>17 {return 2;}for k:1..<args_count(args[..]) {if !vf_id_ok(args_at(args[..],k)) {return 2;}}
  bytes:[262144]u8;j:[1]Jo;jo_start(j[..],bytes[..]);jo_obj(j[..]);jo_key(j[..],"schema");jo_str(j[..],"valley.fab-source-matches.v1");jo_key(j[..],"scope");jo_str(j[..],"Public metadata only; exact ID in source archive filenames; no purchases or authenticated downloads");jo_key(j[..],"assets");jo_arr(j[..]);for k:1..<args_count(args[..]) {vf_match(args_at(args[..],k),j[..]);}jo_end(j[..]);jo_end(j[..]);
  return ifx !j[0].bad && fs_write(args_at(args[..],0),jo_text(j[..])) then 0 else 1;
}
