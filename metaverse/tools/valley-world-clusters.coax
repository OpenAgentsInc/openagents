// Append VWH1 to the immutable source catalogue without reimporting geometry or textures.
// tool.sh: stack-gib 2
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../valley/source-clusters.coax";
#load "../valley/world-hierarchy.coax";
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=2 {return 2;}root:=args_at(args[..],0);dest:=args_at(args[..],1);path:[4096]u8;
 catalog:[WH_CAP]u8;v:[268435456]u8;i:[134217728]u8;b:[WH_CAP]u8;nodes:[131072]SourceCluster;active:[65536]int;
 cn:=fs_read(fs_join(root,"world.catalog",path[..]),catalog[..]);vn:=fs_read(fs_join(root,"world.vertices",path[..]),v[..]);in:=fs_read(fs_join(root,"world.indices",path[..]),i[..]);rig:=10142528;#assert cn>=rig+64;
 n:=cast(int)scan_u32(catalog[..],rig+8);core:=rig+VW_HEADER+VW_POINTS*4+n*32;#assert core<=cn && vw_catalog_valid(catalog[rig..<core]) && vn==cast(int)scan_u32(catalog[..],rig+12) && in==cast(int)scan_u32(catalog[..],rig+16);
 models:[512][6]int;mapping:[VW_DRAWS]int;nm:=0;
 for k:0..<n {p:=rig+VW_HEADER+VW_POINTS*4+k*32;first:=cast(int)scan_u32(catalog[..],p);count:=cast(int)scan_u32(catalog[..],p+4);found:= -1;for m:0..<nm {if models[m][0]==first && models[m][1]==count {found=m;}}
  if found<0 {#assert nm<512;found=nm;models[nm][0]=first;models[nm][1]=count;nm+=1;}mapping[k]=found;
 }
 no:=32+nm*24;nn:=0;leaves:=0;word:=cast(int)scan_u32(catalog[..],rig+44);matrix:=cast(int)scan_u32(catalog[..],rig+48)*4;#assert matrix<=vn;
 for m:0..<nm {count:=source_clusters(nodes[..],active[..],v[0..<matrix],i[0..<in],word,models[m][0],models[m][1]);#assert count>0 && nn+count<=262144;models[m][2]=nn;models[m][3]=count;models[m][4]=nn+count-1;models[m][5]=(count+1)/2;leaves+=(count+1)/2;
  for k:0..<count {a:=nodes[k];p:=no+(nn+k)*48;#assert p+48<=b.count;scan_put(b[..],p,cast(u32)a.first);scan_put(b[..],p+4,cast(u32)a.count);scan_put(b[..],p+8,ifx a.left<0 then 0xffffffff else cast(u32)(nn+a.left));scan_put(b[..],p+12,ifx a.right<0 then 0xffffffff else cast(u32)(nn+a.right));scan_write_point(b[..],p+16,a.low);scan_write_point(b[..],p+28,a.high);scan_put(b[..],p+40,cast(u32)a.height);scan_put(b[..],p+44,cast(u32)a.vertices);}
  nn+=count;print("Cluster model %/% leaves=% nodes=%\n",m+1,nm,(count+1)/2,count);
 }
 io:=no+nn*48;size:=io+n*52;#assert core+size<=catalog.count;for value,k:[8]u32.[0x31485756,1,cast(u32)nm,cast(u32)nn,cast(u32)n,32,cast(u32)no,cast(u32)io] {scan_put(b[..],k*4,value);}
 for m:0..<nm {for j:0..<6 {scan_put(b[..],32+m*24+j*4,cast(u32)models[m][j]);}}
 for k:0..<n {p:=io+k*52;scan_put(b[..],p,cast(u32)mapping[k]);for j:0..<48 {b[p+4+j]=v[matrix+k*96+j];}}
 #assert wh_valid(b[0..<size],n,in/4);for k:0..<size {catalog[core+k]=b[k];}#assert fs_write(dest,cast(string)catalog[0..<core+size]);print("VWH1 models=% leaves=% nodes=% bytes=% catalogue=%\n",nm,leaves,nn,size,core+size);return 0;
}
