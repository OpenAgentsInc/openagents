// Original CC0 4-Movement Symphonic Starter Suite for OpenAgents Music Studio.
// Demonstrates the exact harmonic/tempo architecture of the 4-song mashup blueprint:
//   Movement I  (Bars 1-8):   Intimate Light     - Db Major, 64 BPM (Piano, Clarinet, Cello, Harp)
//   Movement II (Bars 9-16):  Velvet Nocturne    - Db Major (same key!), 64 -> 72 BPM (Strings, Celesta, Bassoon)
//   Movement III(Bars 17-24): Gothic Descent     - D Minor (+1 semitone shock!), 72 -> 122 BPM (Pipe Organ, Ostinato, Timpani)
//   Movement IV (Bars 25-32): Bolero Obsession   - F Minor (chromatic mediant Dm->Fm!), 122 -> 132 BPM (Plucked Strings, Brass, Winds)
//   Movement V  (Bars 33-40): Grand Reprise      - Fm -> bVI (Db Major) -> Dm Cadence, 132 -> 68 BPM (Full Orchestra + Choir)
// Zero copyrighted melodies: 100% original CC0 chord progressions & motifs ready to play, visualize, and remix immediately!
//   coax/bin/coax test music/starter.coax --library
#load "transport.coax";

B :: 3840;   // 1 bar = 4 beats * 960 PPQ
Q :: 960;    // quarter note
E :: 480;    // eighth note
S :: 240;    // sixteenth note

ms_chord :: (p: [] MusicProject, tr: u8, tick: s64, dur: s64, vel: u8, n0: u8, n1: u8, n2: u8, n3: u8) {
  if n0 > 0 { _ = music_add_note_raw(p, tr, n0, vel, tick, dur); }
  if n1 > 0 { _ = music_add_note_raw(p, tr, n1, vel, tick, dur); }
  if n2 > 0 { _ = music_add_note_raw(p, tr, n2, vel, tick, dur); }
  if n3 > 0 { _ = music_add_note_raw(p, tr, n3, vel, tick, dur); }
}

ms_arp :: (p: [] MusicProject, tr: u8, bar_tick: s64, step: s64, vel: u8, notes: [] u8) {
  for i: 0..<notes.count {
    _ = music_add_note_raw(p, tr, notes[i], vel, bar_tick + cast(s64) i * step, step * 2);
  }
}

music_load_phantom_suite_starter :: (p: [] MusicProject) {
  if p.count != 1 { return; }
  music_project_init(p, "Gothic Opera 4-Movement Mashup Starter");

  // 10-track pit orchestra (GM program numbers for MuseScore_General.sf2 & macOS DLS).
  t_piano  := cast,trunc(u8) music_add_track(p, "Grand / Elec Piano", MSEC_KEYS,    0,  0, -0.08, 0.30);
  t_organ  := cast,trunc(u8) music_add_track(p, "Gothic Pipe Organ",  MSEC_ORGAN,  19,  1,  0.00, 0.52);
  t_vln1   := cast,trunc(u8) music_add_track(p, "Violins I (Lead)",   MSEC_STRINGS,48,  2, -0.55, 0.38);
  t_vln2   := cast,trunc(u8) music_add_track(p, "Violins II / Viola", MSEC_STRINGS,49,  3, -0.18, 0.38);
  t_celli  := cast,trunc(u8) music_add_track(p, "Celli & Bass",       MSEC_STRINGS,42,  4,  0.32, 0.34);
  t_clar   := cast,trunc(u8) music_add_track(p, "Solo Clarinet/Winds",MSEC_WINDS,  71,  5, -0.14, 0.34);
  t_horn   := cast,trunc(u8) music_add_track(p, "French Horns/Brass", MSEC_BRASS,  60,  6,  0.34, 0.45);
  t_harp   := cast,trunc(u8) music_add_track(p, "Concert Harp",       MSEC_HARP,   46,  7, -0.45, 0.38);
  t_celes  := cast,trunc(u8) music_add_track(p, "Celesta / Choir",    MSEC_CHOIR,  52,  8,  0.00, 0.55);
  t_timp   := cast,trunc(u8) music_add_track(p, "Timpani / Drums",    MSEC_PERC,   47, 10, -0.10, 0.44);

  // Set balanced track gains.
  p[0].tracks[t_piano].gain = 0.85;
  p[0].tracks[t_organ].gain = 0.92;
  p[0].tracks[t_vln1].gain  = 0.82;
  p[0].tracks[t_vln2].gain  = 0.72;
  p[0].tracks[t_celli].gain = 0.86;
  p[0].tracks[t_clar].gain  = 0.84;
  p[0].tracks[t_horn].gain  = 0.84;
  p[0].tracks[t_harp].gain  = 0.78;
  p[0].tracks[t_celes].gain = 0.76;
  p[0].tracks[t_timp].gain  = 0.90;

  // 5-movement markers (toolbar Jump [1]..[5] + dynamic Piano Roll scale highlighting).
  _ = music_add_marker(p, 0 * B,  1, false, 4, 4, 1, "1: All I Ask Axis (Db Maj)");
  _ = music_add_marker(p, 8 * B,  1, false, 4, 4, 2, "2: Nocturne Axis (Db Maj)");
  _ = music_add_marker(p, 16 * B, 2, true,  4, 4, 3, "3: Phantom Organ (D Min)");
  _ = music_add_marker(p, 24 * B, 5, true,  4, 4, 4, "4: Point of No Return (F Min)");
  _ = music_add_marker(p, 32 * B, 1, false, 4, 4, 5, "5: Grand Reprise (Db -> Dm)");

  // Piecewise Tempo Map: 64 -> ramp 72 -> ramp 122 -> 132 -> ritardando 68 BPM.
  _ = music_set_tempo_point(p, 0 * B,  64000, false);
  _ = music_set_tempo_point(p, 7 * B,  64000, true);
  _ = music_set_tempo_point(p, 8 * B,  72000, false);
  _ = music_set_tempo_point(p, 15 * B, 72000, true);
  _ = music_set_tempo_point(p, 16 * B, 122000, false);
  _ = music_set_tempo_point(p, 23 * B, 122000, true);
  _ = music_set_tempo_point(p, 24 * B, 132000, false);
  _ = music_set_tempo_point(p, 31 * B, 132000, true);
  _ = music_set_tempo_point(p, 32 * B, 72000, false);
  _ = music_set_tempo_point(p, 37 * B, 72000, true);
  _ = music_set_tempo_point(p, 39 * B, 58000, false);

  // =========================================================================
  // MOVEMENT I (Bars 0..7): Db Major @ 64 BPM — Intimate Piano, Clarinet, Cello, Harp
  // Progression: Db -> Bbm -> Gb -> Ab -> Db -> Fm -> Gb -> Ab7
  // =========================================================================
  m1_bass := [8] u8.[37, 34, 42, 44, 37, 41, 42, 44]; // Db2, Bb1, Gb2, Ab2, Db2, F2, Gb2, Ab2
  m1_c0   := [8] u8.[49, 46, 54, 56, 49, 53, 54, 56];
  m1_c1   := [8] u8.[53, 49, 58, 60, 53, 56, 58, 60];
  m1_c2   := [8] u8.[56, 53, 61, 63, 56, 60, 61, 63];
  for b: 0..<8 {
    bt := cast(s64) b * B;
    // Warm electric/grand piano broken chord bed
    ms_chord(p, t_piano, bt, B - 60, 72, m1_c0[b], m1_c1[b], m1_c2[b], 0);
    _ = music_add_note_raw(p, t_piano, m1_bass[b], 74, bt, B - 60);
    // Solo cello lyrical pedal & sighing fifths
    _ = music_add_note_raw(p, t_celli, m1_bass[b] + 12, 70, bt, B - 40);
    // Concert harp shimmering upward arpeggio
    arp := [8] u8.[m1_c0[b], m1_c1[b], m1_c2[b], m1_c0[b] + 12, m1_c1[b] + 12, m1_c2[b] + 12, m1_c1[b] + 12, m1_c0[b] + 12];
    ms_arp(p, t_harp, bt, E, 62, arp[..]);
  }
  // Original lyrical solo clarinet melody in Db Major (bars 0..7)
  _ = music_add_note_raw(p, t_clar, 65, 84, 0 * B + 0 * Q, Q * 2); // F4
  _ = music_add_note_raw(p, t_clar, 68, 88, 0 * B + 2 * Q, Q);     // Ab4
  _ = music_add_note_raw(p, t_clar, 73, 92, 0 * B + 3 * Q, Q);     // Db5
  _ = music_add_note_raw(p, t_clar, 70, 86, 1 * B + 0 * Q, Q * 3); // Bb4
  _ = music_add_note_raw(p, t_clar, 68, 80, 1 * B + 3 * Q, Q);     // Ab4
  _ = music_add_note_raw(p, t_clar, 66, 84, 2 * B + 0 * Q, Q * 2); // Gb4
  _ = music_add_note_raw(p, t_clar, 65, 82, 2 * B + 2 * Q, Q);     // F4
  _ = music_add_note_raw(p, t_clar, 63, 80, 2 * B + 3 * Q, Q);     // Eb4
  _ = music_add_note_raw(p, t_clar, 68, 88, 3 * B + 0 * Q, B - 120); // Ab4
  _ = music_add_note_raw(p, t_clar, 65, 86, 4 * B + 0 * Q, Q * 2);
  _ = music_add_note_raw(p, t_clar, 68, 90, 4 * B + 2 * Q, Q);
  _ = music_add_note_raw(p, t_clar, 75, 94, 4 * B + 3 * Q, Q);     // Eb5
  _ = music_add_note_raw(p, t_clar, 72, 90, 5 * B + 0 * Q, Q * 3); // C5
  _ = music_add_note_raw(p, t_clar, 70, 86, 5 * B + 3 * Q, Q);     // Bb4
  _ = music_add_note_raw(p, t_clar, 73, 92, 6 * B + 0 * Q, Q * 2); // Db5
  _ = music_add_note_raw(p, t_clar, 70, 86, 6 * B + 2 * Q, Q * 2);
  _ = music_add_note_raw(p, t_clar, 68, 88, 7 * B + 0 * Q, B - 80);

  // =========================================================================
  // MOVEMENT II (Bars 8..15): Db Major (Same Key!) @ 72 BPM — Nocturne Strings + Celesta
  // Builds tension on bar 15 with chromatic pedal lifting into D minor!
  // =========================================================================
  m2_bass := [8] u8.[37, 37, 34, 42, 39, 44, 41, 45]; // ends on A2(45) dominant into D minor!
  m2_c0   := [8] u8.[49, 49, 46, 54, 51, 56, 53, 57];
  m2_c1   := [8] u8.[53, 54, 53, 58, 54, 60, 56, 61]; // A major triad (A-C#-E) on bar 15!
  m2_c2   := [8] u8.[56, 56, 58, 61, 58, 63, 60, 64];
  for k: 0..<8 {
    bt := cast(s64) (8 + k) * B;
    vel := cast,trunc(u8) (76 + k * 5);
    ms_chord(p, t_vln2, bt, B - 40, vel, m2_c0[k], m2_c1[k], m2_c2[k], 0);
    _ = music_add_note_raw(p, t_celli, m2_bass[k], cast,trunc(u8) (vel + 4), bt, B - 40);
    _ = music_add_note_raw(p, t_celli, m2_bass[k] + 12, vel, bt, B - 40);
    arp := [8] u8.[m2_c0[k], m2_c1[k], m2_c2[k], m2_c0[k] + 12, m2_c2[k], m2_c1[k], m2_c0[k] + 12, m2_c1[k] + 12];
    ms_arp(p, t_harp, bt, E, 68, arp[..]);
    if k >= 4 {
      ms_chord(p, t_horn, bt, B - 80, cast,trunc(u8) (vel + 6), m2_c0[k], m2_c2[k], 0, 0);
    }
  }
  // Soaring romantic Violin I nocturne line + Choir shimmer
  _ = music_add_note_raw(p, t_vln1, 68, 86, 8 * B, Q * 2);
  _ = music_add_note_raw(p, t_vln1, 73, 92, 8 * B + 2 * Q, Q * 2);
  _ = music_add_note_raw(p, t_vln1, 75, 94, 9 * B, Q * 3);
  _ = music_add_note_raw(p, t_vln1, 73, 90, 9 * B + 3 * Q, Q);
  _ = music_add_note_raw(p, t_vln1, 77, 98, 10 * B, Q * 2);       // F5
  _ = music_add_note_raw(p, t_vln1, 75, 94, 10 * B + 2 * Q, Q * 2);
  _ = music_add_note_raw(p, t_vln1, 73, 96, 11 * B, B - 80);
  _ = music_add_note_raw(p, t_vln1, 78, 102, 12 * B, Q * 2);      // Gb5
  _ = music_add_note_raw(p, t_vln1, 77, 98, 12 * B + 2 * Q, Q * 2);
  _ = music_add_note_raw(p, t_vln1, 80, 108, 13 * B, B - 80);     // Ab5 romantic climax!
  _ = music_add_note_raw(p, t_celes, 80, 90, 13 * B, B - 80);
  _ = music_add_note_raw(p, t_vln1, 77, 102, 14 * B, B - 80);
  // Bar 15: Dramatic timpani crescendo + A7 dominant lift into D minor!
  _ = music_add_note_raw(p, t_vln1, 76, 110, 15 * B, Q * 2);      // E5 -> A5
  _ = music_add_note_raw(p, t_vln1, 81, 118, 15 * B + 2 * Q, Q * 2);
  for s: 0..<16 {
    _ = music_add_note_raw(p, t_timp, 45, cast,trunc(u8) (52 + s * 4), 15 * B + cast(s64) s * S, S);
  }

  // =========================================================================
  // MOVEMENT III (Bars 16..23): D Minor @ 122 BPM — Gothic Pipe Organ & Staccato Strings
  // Original gothic descending chromatic organ motif (D - C# - C - B - Bb -> A) + driving ostinato!
  // =========================================================================
  for k: 0..<8 {
    bt := cast(s64) (16 + k) * B;
    // Iconic gothic descending chromatic Pipe Organ stabs on even bars, turnaround on odd bars
    if k % 2 == 0 {
      ms_chord(p, t_organ, bt + 0 * Q, Q + E, 118, 38, 50, 62, 69); // D octave + A
      ms_chord(p, t_organ, bt + 3 * E, E,     112, 37, 49, 61, 0);  // C#
      ms_chord(p, t_organ, bt + 2 * Q, E,     112, 36, 48, 60, 0);  // C
      ms_chord(p, t_organ, bt + 5 * E, E,     112, 35, 47, 59, 0);  // B
      ms_chord(p, t_organ, bt + 3 * Q, Q,     120, 34, 46, 58, 65); // Bb power chord
    } else {
      ms_chord(p, t_organ, bt + 0 * Q, Q * 2, 110, 34, 46, 58, 62); // Bb
      ms_chord(p, t_organ, bt + 2 * Q, Q,     112, 36, 48, 60, 64); // C
      ms_chord(p, t_organ, bt + 3 * Q, Q,     118, 38, 50, 62, 65); // Dm hit
    }
    // Driving 8th-note staccato string & cello ostinato
    root := ifx k % 2 == 0 then cast(u8) 50 else ifx k == 7 then cast(u8) 53 else cast(u8) 46; // pivots to F on bar 23!
    for e: 0..<8 {
      acc := ifx e % 2 == 0 then cast(u8) 104 else cast(u8) 82;
      _ = music_add_note_raw(p, t_celli, root, acc, bt + cast(s64) e * E, E - 90);
      _ = music_add_note_raw(p, t_vln2, cast,trunc(u8) (root + 12), cast,trunc(u8) (acc - 8), bt + cast(s64) e * E, E - 100);
    }
    // Theatrical timpani beats 1 & 3 (+ drive on 4)
    _ = music_add_note_raw(p, t_timp, 38, 114, bt + 0 * Q, Q);
    _ = music_add_note_raw(p, t_timp, 45, 102, bt + 2 * Q, Q);
    _ = music_add_note_raw(p, t_timp, 38, 108, bt + 3 * Q, E);
    // Bold French Horn theme over bars 18..23 (sustained common-tone F on bar 23!)
    if k >= 2 && k < 7 {
      ms_chord(p, t_horn, bt, Q * 3, 104, 62, 65, 69, 0);
    }
  }
  // Common-tone F pivot (bar 23) launching D minor -> F minor chromatic mediant!
  _ = music_add_note_raw(p, t_horn, 65, 116, 23 * B, B);
  _ = music_add_note_raw(p, t_vln1, 77, 114, 23 * B, B);
  _ = music_add_note_raw(p, t_celes, 65, 96, 23 * B, B);

  // =========================================================================
  // MOVEMENT IV (Bars 24..31): F Minor @ 132 BPM — Sultry Bolero / Tango Obsession
  // Tip: Click "-3 st (Fm -> Dm)" in Remix Panel to audition layered directly in D minor!
  // Progression: Fm -> Db -> Bbm -> C7 (repeated with rising dramatic intensity)
  // =========================================================================
  m4_root := [8] u8.[41, 37, 34, 36, 41, 37, 34, 36]; // F2, Db2, Bb1, C2
  m4_top  := [8] u8.[65, 68, 70, 72, 77, 73, 70, 72];
  for k: 0..<8 {
    bt := cast(s64) (24 + k) * B;
    r := m4_root[k];
    // Bolero/tango syncopated bass & plucked/piano pulse (1, 2+, 3, 4)
    _ = music_add_note_raw(p, t_celli, r, 108, bt + 0 * Q, Q + E - 60);
    _ = music_add_note_raw(p, t_celli, r + 7, 94, bt + 3 * E, E - 40);
    _ = music_add_note_raw(p, t_celli, r + 12, 102, bt + 2 * Q, Q - 60);
    _ = music_add_note_raw(p, t_celli, r + 7, 98, bt + 3 * Q, Q - 60);

    // Syncopated rhythmic stabs on Piano + Strings
    third := ifx k % 4 == 1 || k % 4 == 3 then cast(u8) 4 else cast(u8) 3; // Major on Db/C7, minor on Fm/Bbm
    ms_chord(p, t_piano, bt + E, E - 60, 96, cast,trunc(u8) (r + 12), cast,trunc(u8) (r + 12 + third), cast,trunc(u8) (r + 19), 0);
    ms_chord(p, t_piano, bt + 5 * E, E - 60, 100, cast,trunc(u8) (r + 12), cast,trunc(u8) (r + 12 + third), cast,trunc(u8) (r + 19), 0);
    ms_chord(p, t_vln2, bt, Q * 2, 92, cast,trunc(u8) (r + 12), cast,trunc(u8) (r + 12 + third), cast,trunc(u8) (r + 19), 0);

    // Urgent woodwind + violin counter-melody
    _ = music_add_note_raw(p, t_clar, m4_top[k], 104, bt, Q + E);
    _ = music_add_note_raw(p, t_clar, cast,trunc(u8) (m4_top[k] - 1), 98, bt + 3 * E, E);
    _ = music_add_note_raw(p, t_clar, cast,trunc(u8) (m4_top[k] + 2), 108, bt + 2 * Q, Q * 2 - 60);
    if k >= 4 {
      _ = music_add_note_raw(p, t_vln1, cast,trunc(u8) (m4_top[k] + 12), 112, bt, Q * 3);
      ms_chord(p, t_horn, bt, B - 120, 108, cast,trunc(u8) (r + 12), cast,trunc(u8) (r + 19), 0, 0);
    }
    _ = music_add_note_raw(p, t_timp, r, 104, bt, Q);
    _ = music_add_note_raw(p, t_timp, r, 96, bt + 5 * E, E);
  }

  // =========================================================================
  // MOVEMENT V (Bars 32..39): Grand Reprise Finale — Fm -> bVI (Db Major!) -> Final Dm Organ Cadence
  // =========================================================================
  m5_bass := [8] u8.[37, 34, 42, 44, 37, 45, 38, 38]; // Db, Bbm, Gb, Ab, Db, A7, Dm, Dm!
  m5_c0   := [8] u8.[49, 46, 54, 56, 49, 57, 50, 50];
  m5_c1   := [8] u8.[53, 49, 58, 60, 53, 61, 53, 53];
  m5_c2   := [8] u8.[56, 53, 61, 63, 56, 64, 57, 57];
  m5_lead := [8] u8.[77, 73, 78, 80, 85, 81, 74, 74]; // Soars to Db6(85) -> A5 -> D5 final chord!
  for k: 0..<8 {
    bt := cast(s64) (32 + k) * B;
    vel := ifx k < 6 then cast(u8) 114 else ifx k == 6 then cast(u8) 96 else cast(u8) 78;
    ms_chord(p, t_vln2, bt, B - 40, vel, m5_c0[k], m5_c1[k], m5_c2[k], 0);
    ms_chord(p, t_celes, bt, B - 40, cast,trunc(u8) (vel - 6), m5_c0[k] + 12, m5_c1[k] + 12, m5_c2[k] + 12, 0);
    _ = music_add_note_raw(p, t_celli, m5_bass[k], vel, bt, B - 40);
    _ = music_add_note_raw(p, t_vln1, m5_lead[k], vel, bt, B - 60);
    if k < 6 {
      ms_chord(p, t_horn, bt, B - 80, vel, m5_c0[k], m5_c2[k], 0, 0);
      arp := [8] u8.[m5_c0[k], m5_c1[k], m5_c2[k], m5_c0[k] + 12, m5_c1[k] + 12, m5_c2[k] + 12, m5_c1[k] + 12, m5_c2[k] + 12];
      ms_arp(p, t_harp, bt, E, 86, arp[..]);
      _ = music_add_note_raw(p, t_timp, m5_bass[k], 116, bt, Q * 2);
    } else {
      // Hushed final Gothic Pipe Organ & Piano D-minor cadence!
      ms_chord(p, t_organ, bt, B - 40, vel, m5_bass[k], m5_c0[k], m5_c1[k], m5_c2[k]);
      ms_chord(p, t_piano, bt, B - 40, 74, m5_c0[k], m5_c1[k], m5_c2[k], m5_lead[k]);
    }
  }

  _ = music_tempo_bake(p[0].tempos[..], p[0].tempo_count, p[0].sample_rate);
}

// ---- Checks ----

#test "4-movement symphonic starter builds 10 orchestral tracks, 5 markers, and baked tempo map" {
  p: [1] MusicProject;
  music_load_phantom_suite_starter(p[..]);
  #assert p[0].track_count == 10 && p[0].marker_count == 5 && p[0].tempo_count == 11;
  #assert music_live_note_count(p[..]) > 350;
  #assert music_bpm_at_tick(p[0].tempos[..], p[0].tempo_count, 0) == 64000;
  #assert music_bpm_at_tick(p[0].tempos[..], p[0].tempo_count, 16 * B) == 122000;
  #assert music_bpm_at_tick(p[0].tempos[..], p[0].tempo_count, 24 * B) == 132000;
  // Total duration of 40 bars across 64..132 BPM should be roughly 95-125 seconds @ 48 kHz.
  end_s := music_tick_to_sample(p[0].tempos[..], p[0].tempo_count, p[0].sample_rate, 40 * B);
  #assert end_s > 48000 * 80 && end_s < 48000 * 140;
}
