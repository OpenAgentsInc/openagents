{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openagents.cj-card.v1",
  "title": "NIP-CJ conversation card feedback (27000)",
  "description": "A closed, typed display record the client renders with its own controls. Every number comes from a record the worker verified.",
  "oneOf": [
    {
      "$ref": "#/$defs/tool"
    },
    {
      "$ref": "#/$defs/draft"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/news"
    },
    {
      "$ref": "#/$defs/check"
    },
    {
      "$ref": "#/$defs/credit"
    },
    {
      "$ref": "#/$defs/capability"
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "media_type"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "sources": {
          "type": "array"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pubkey",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "pubkey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "kind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "coordinate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 68,
          "maxLength": 200
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "event": {
          "$ref": "#/$defs/event"
        }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_passed",
        "baseline_passed",
        "total"
      ],
      "properties": {
        "subject_passed": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_passed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication",
        "headline",
        "verdict"
      ],
      "properties": {
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "pubkey": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "const": 3189
            }
          }
        },
        "headline": {
          "$ref": "#/$defs/headline"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "name",
        "summary",
        "definition",
        "latest"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "tool"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "maxLength": 400
        },
        "definition": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/definition"
            }
          ]
        },
        "latest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/line"
            }
          ]
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "draft"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "draft"
        },
        "draft": {
          "type": "object",
          "required": [
            "v",
            "tool",
            "cases"
          ],
          "properties": {
            "v": {
              "const": "openagents.eval-draft.v1"
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "request",
        "where",
        "completed",
        "planned"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "run"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "pubkey": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "const": 25920
            }
          }
        },
        "where": {
          "enum": [
            "hosted",
            "connected_computer"
          ]
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "planned": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "headline",
        "verdict",
        "report",
        "publication"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "result"
        },
        "headline": {
          "$ref": "#/$defs/headline"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "report": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "object",
              "required": [
                "schema"
              ],
              "properties": {
                "schema": {
                  "const": "openagents.eval-report.v1"
                }
              }
            }
          ]
        },
        "publication": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "pubkey",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                },
                "pubkey": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                },
                "kind": {
                  "const": 3189
                }
              }
            }
          ]
        }
      }
    },
    "news": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "items"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "news"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "line",
              "event",
              "path"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "line": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "event": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "pubkey",
                      "kind"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64
                      },
                      "pubkey": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64
                      },
                      "kind": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      }
                    }
                  }
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                ]
              }
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "null"
                  },
                  "path": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "object"
                  },
                  "path": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "tool",
        "publication",
        "headline",
        "verdict",
        "confirms",
        "disputes"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "check"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "pubkey": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "const": 3189
            }
          }
        },
        "headline": {
          "$ref": "#/$defs/headline"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "confirms": {
          "type": "integer",
          "minimum": 0
        },
        "disputes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "total",
        "awards"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "credit"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "awards": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "role",
              "xp",
              "title",
              "award"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "confirmed"
                ]
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "xp": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "award": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "pubkey",
                      "kind"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64
                      },
                      "pubkey": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64
                      },
                      "kind": {
                        "const": 3193
                      }
                    }
                  }
                ]
              }
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "confirmed"
                  },
                  "award": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "pending"
                  },
                  "award": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requires",
        "type",
        "card",
        "status",
        "closest",
        "add"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        },
        "type": {
          "const": "card"
        },
        "card": {
          "const": "capability"
        },
        "status": {
          "const": "missing"
        },
        "closest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "summary",
                "reach"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "reach": {
                  "enum": [
                    "chat",
                    "coder"
                  ]
                }
              }
            }
          ]
        },
        "add": {
          "enum": [
            "author",
            "gym"
          ]
        }
      }
    }
  }
}
