// Chapter 83: an attested endpoint checked against its release head, and a
// sealed vault object opened through a key slot. Key 1 publishes a release
// (3202) and a release head (30202) for the vault workload; key 3, the
// endpoint key, publishes an attested endpoint (30203) whose evidence is a
// Confidential Space token naming the release's image and the binding; key
// 2 owns a tier-user vault whose nostr key slot is sealed to itself with
// NIP-44. Keys are the scalars 1 to 4, TEST ONLY; the token is a TEST TOKEN,
// not signed by Google, and the vault secrets are hashes of fixed phrases.
// coax/tests/nostr/att_vault_reference.py wrote every record (BIP-340 aux
// 0); they are copied here as a relay and a blob store would hand them over.
#load "../../coax/lib/nostr/att.coax";
#load "../../coax/lib/nostr/vault.coax";
#load "../../coax/lib/nostr/nip44-key.coax";
#load "../../coax/lib/nostr/event.coax";
#import "Basic";

