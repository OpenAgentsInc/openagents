  want.containers[0].members[0] = MpPlaced.{coordinate = "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz", resolved = true};
  want.containers[1].project = "30621:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:borrowed"; want.containers[1].count = 1;
  want.containers[1].members[0] = MpPlaced.{coordinate = "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz", resolved = true};
  #assert same_collection(mp_fold(repos[0..<1], projects[..]), want);
}
#test "MP fold fixture exhaustive_enumeration_across_pages_with_tied_timestamps" {
  repos: [3] MpRepo;
  repos[0] = mp_repo("30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz"); repos[0].live = true; repos[0].hidden = false; repos[0].created_at = 1000;
  repos[1] = mp_repo("30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz-infra"); repos[1].live = true; repos[1].hidden = false; repos[1].created_at = 1000;
  repos[2] = mp_repo("30617:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:buzz-mobile"); repos[2].live = true; repos[2].hidden = false; repos[2].created_at = 1000;
  projects: [2] MpProject;
  projects[0] = mp_project("30621:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:platform", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  projects[0].unlisted = false; projects[0].live = true; projects[0].hidden = false; projects[0].created_at = 900;
  projects[0] = with_member(projects[0], "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz");
  projects[0] = with_member(projects[0], "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz-infra");
  projects[1] = mp_project("30621:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:mobile", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
  projects[1].unlisted = false; projects[1].live = true; projects[1].hidden = false; projects[1].created_at = 900;
  projects[1] = with_member(projects[1], "30617:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:buzz-mobile");
  want: MpCollection; want.count = 2; want.card_count = 0;
  want.containers[0].project = "30621:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:platform"; want.containers[0].count = 2;
  want.containers[0].members[0] = MpPlaced.{coordinate = "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz", resolved = true};
  want.containers[0].members[1] = MpPlaced.{coordinate = "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz-infra", resolved = true};
  want.containers[1].project = "30621:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:mobile"; want.containers[1].count = 1;
  want.containers[1].members[0] = MpPlaced.{coordinate = "30617:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:buzz-mobile", resolved = true};
  // Served in pages of 2 and gathered with the composite cursor first.
  seen := paged(repos[0..<3], projects[..], 2);
  #assert seen.pages == 3 && seen.heads == 5;
  for i: 0..<3 { repos[i].live = repos[i].live && seen.repo[i] == 1; }
  for i: 0..<2 { projects[i].live = projects[i].live && seen.project[i] == 1; }
  #assert same_collection(mp_fold(repos[0..<3], projects[..]), want);
}
