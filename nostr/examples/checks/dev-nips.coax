// Every case of nostr/nips/block/NIP-MP.fold-fixtures.json, transcribed.
#test "MP fold fixture owner_project_claims_own_repository" {
  repos: [1] MpRepo;
  repos[0] = mp_repo("30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz"); repos[0].live = true; repos[0].hidden = false; repos[0].created_at = 0;
  projects: [1] MpProject;
  projects[0] = mp_project("30621:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:platform", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  projects[0].unlisted = false; projects[0].live = true; projects[0].hidden = false; projects[0].created_at = 0;
  projects[0] = with_member(projects[0], "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz");
  want: MpCollection; want.count = 1; want.card_count = 0;
  want.containers[0].project = "30621:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:platform"; want.containers[0].count = 1;
  want.containers[0].members[0] = MpPlaced.{coordinate = "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz", resolved = true};
  #assert same_collection(mp_fold(repos[0..<1], projects[..]), want);
}
#test "MP fold fixture stranger_project_does_not_claim" {
  repos: [1] MpRepo;
  repos[0] = mp_repo("30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz"); repos[0].live = true; repos[0].hidden = false; repos[0].created_at = 0;
  projects: [1] MpProject;
  projects[0] = mp_project("30621:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:borrowed", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
  projects[0].unlisted = false; projects[0].live = true; projects[0].hidden = false; projects[0].created_at = 0;
  projects[0] = with_member(projects[0], "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz");
  want: MpCollection; want.count = 1; want.card_count = 1;
  want.containers[0].project = "30621:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:borrowed"; want.containers[0].count = 1;
  want.containers[0].members[0] = MpPlaced.{coordinate = "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz", resolved = true};
  want.cards[0] = "30617:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:buzz";
  #assert same_collection(mp_fold(repos[0..<1], projects[..]), want);
}
