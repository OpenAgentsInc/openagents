// The checks of relay-admit.coax. They live apart so that running the
// example doesn't also run them.
// Checks: coax test nostr/examples/checks/relay-admit.coax --run-steps 250000000
#load "../relay-admit.coax";

// The session's events, signed by coax/tests/nostr/nip59_reference.py's
// pure-Python BIP-340 signer and event writer (hashlib and integers; it
// shares no code with Coax) with the same key, aux and fields as the
// example: signed(key, aux, created_at, kind, tags, content).
PY_WORKED :: "{\"id\":\"0753e8ad491d16259792761362658889e960a29e0829af2aefe981bdf8560b60\",\"pubkey\":\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\",\"created_at\":1793491200,\"kind\":1,\"tags\":[],\"content\":\"hello relay\",\"sig\":\"025bc40033dfbca3ef4e8e50f83799d8ed3090bf79083ec74c32ad187cdddb178707c7dbde6224f0c4af344669b033b93b6c61dfa8f59927016decdc735f6d7a\"}";
PY_EDGE :: "{\"id\":\"39c49b2b67c1d83c2b96d97b8da63bf25e5b7d74779eaa63c50087f3831615cb\",\"pubkey\":\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\",\"created_at\":1793492100,\"kind\":1,\"tags\":[],\"content\":\"edge\",\"sig\":\"7602f074f3b44488325a8cbc0aa219f1489b9b850227f6c33079f9176cb6401234cc0db2edde4e4964e77332106f458a219cfd8d3e6c7d6856884acfcc888721\"}";
PY_FUTURE :: "{\"id\":\"64cb2f8c3ec65ae79800cf23d3b7abf1301d7d15b55b82378e236381416f7173\",\"pubkey\":\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\",\"created_at\":1793492101,\"kind\":1,\"tags\":[],\"content\":\"early\",\"sig\":\"1b9e3070cb9fb75ce17875caf955098954c8f914c7366ec50c66a3c41b4848fcc50ae5495b25a5c7c17b708d57ed4a175b8532c4acdfd5fcd8788307962738c1\"}";
PY_AUTH :: "{\"id\":\"b2cbcf494538d05be55b66d37484b2f47f7edd3e5a15c37e43a5486087ef6db9\",\"pubkey\":\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\",\"created_at\":1793491200,\"kind\":22242,\"tags\":[[\"relay\",\"ws://127.0.0.1:7777\"],[\"challenge\",\"c\"]],\"content\":\"\",\"sig\":\"84d9dd0b179b38d4ce2b9e2ce394444897c1c69877e1ebf333da5f8ff506826efadf02e3da418fcf48f10995844f928b3e97ede5363d337a275aae45a083e583\"}";
PY_EXPIRED :: "{\"id\":\"8f3e5212002db0bed22938b6303cef64560015027171e1c2ae5549ee9ab3a63a\",\"pubkey\":\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\",\"created_at\":1793491140,\"kind\":1,\"tags\":[[\"expiration\",\"1793491200\"]],\"content\":\"gone\",\"sig\":\"91e0bebc2fa329b51e651850e2605d3f1f6eb21ee917d90ecec96661f69acd7c3f5e6080290317df9b3883981ba0fa674019386096a748a3597ac70cf1d27c89\"}";
PY_EPHEMERAL :: "{\"id\":\"f032419da3fccec2680604b493d9ea451bed31b941a51d169d34359510be5dde\",\"pubkey\":\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\",\"created_at\":1793491200,\"kind\":20001,\"tags\":[],\"content\":\"typing\",\"sig\":\"807d46d4dd98fbd6b15826bc94b50d833ecee9c786a9fdaa803764740ef4db5ee5c94f201837e285f1a42cb8b55f29919b82f05378460c1c8f4a72bac609295d\"}";
PY_PROFILE_NEW :: "{\"id\":\"3df0dfbcbbf71ddb7b7008929de734d949e12b2981c8acd97912df09736ce5f7\",\"pubkey\":\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\",\"created_at\":1793491200,\"kind\":0,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"new\\\"}\",\"sig\":\"e7b6c3b3d06442e1eaa3cac0a8e5c5fbce5e9a0fbc6c212cb3609f35bcd8c794dcbd63d65c71f7ec0839b2ac4881a975fbd95f34adaa818d5e2241ea728e54f1\"}";
