// The checks of store-events.coax. They live apart so that running the
// example doesn't also run them.
// Checks: coax test nostr/examples/checks/store-events.coax --run-steps 250000000
#load "../store-events.coax";

// The example's events, signed by coax/tests/nostr/nip59_reference.py's
// pure-Python BIP-340 signer and event writer (hashlib and integers; it
// shares no code with Coax) with the same key, aux and fields as the
// example. PY_MOVED is PY_NOTE rewritten by Python's json with "content"
// first.
