// Chapter 98: a project folded from its signed events, and a captured relay folded and compared.
#load "../../apps/openagents-web/project-fold.coax";
#load "../../coax/lib/nostr/event.coax";
#import "Basic";

// The project's owner signs with BIP-340 test vector 0's published secret
// key, 3; "someone else" with vector 1's. Never sign with a real key in an
// example. The events were signed once with coax/lib/nostr/event_sign.coax
// and are copied here as a relay would send them.
OWNER :: "f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9";
EVENTS :: [13] string.[
  "{\"id\":\"7d1c4fcbaed86a0d0ef849977fb5a7933e0202b9e677ff276dec2090a5dbb57d\",\"pubkey\":\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\",\"created_at\":1761686400,\"kind\":30621,\"tags\":[[\"d\",\"tea\"],[\"name\",\"Tea tools\"]],\"content\":\"\",\"sig\":\"de8b99ae2d785617c54cff0a8db7cc2a3f625495fbb44cabe7129f18937f54f3e1fae60b92a5f61ecd384c55e58bea5cb9da38e48394a03ee833dad8ba2fab30\"}",
