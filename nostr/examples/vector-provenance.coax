    "NIST CAVS 11.0 byte-oriented SHA vectors (archive identity pinned)",
    "git:d17cc89fa5c8f4f4d378b5385ebf75da5d0926c9"];
// Only the NIST record comes from an archive; it pins the archive's digest.
PIN_ARCHIVE :: [14] string.["", "", "", "", "", "", "", "", "", "", "", "",
    "929ef80b7b3418aca026643f6f248815913b60e01741a44bba9e118067f4c9b8", ""];
