{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openagents.eval-draft.v1",
  "title": "NIP-CJ test-set draft (a conversation request's draft and a draft card)",
  "description": "At most 64 KiB of canonical JSON. A tool is a catalog tool (catalog set, skill null, uses empty) or a chat-made tool (catalog null, skill set).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "tool",
    "cases"
  ],
  "properties": {
    "v": {
      "const": "openagents.eval-draft.v1"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "catalog",
        "skill",
        "uses"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "maxLength": 400
        },
        "catalog": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/definition"
            }
          ]
        },
        "skill": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          ]
        },
        "uses": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 68,
            "maxLength": 200
          }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "catalog": {
              "type": "object"
            },
            "skill": {
              "type": "null"
            },
            "uses": {
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "catalog": {
              "type": "null"
            },
            "skill": {
              "type": "string"
            }
          }
        }
      ]
    },
    "cases": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "prompt",
          "graders"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "should-fire",
              "should-not-fire"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "graders": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "text"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "media_type"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "sources": {
          "type": "array"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pubkey",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "pubkey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "kind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "coordinate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 68,
          "maxLength": 200
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "event": {
          "$ref": "#/$defs/event"
        }
      }
    }
  }
}
