{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openagents.registry.v1",
  "title": "Curator-signed EXT registry catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "requires",
    "registry",
    "revision",
    "as_of",
    "valid_until",
    "title",
    "description",
    "entries"
  ],
  "properties": {
    "v": {
      "const": "openagents.registry.v1"
    },
    "requires": {
      "type": "array",
      "maxItems": 0
    },
    "registry": {
      "type": "string",
      "minLength": 66,
      "maxLength": 129
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "as_of": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "valid_until": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "release",
          "manifest",
          "title",
          "summary"
        ],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 66,
            "maxLength": 129
          },
          "release": {
            "$ref": "#/$defs/event"
          },
          "manifest": {
            "$ref": "#/$defs/artifact"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "summary": {
            "type": "string",
            "maxLength": 2048
          },
          "configuration": {
            "$ref": "#/$defs/artifact"
          },
          "evaluation": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/event"
                },
                {
                  "$ref": "#/$defs/artifact"
                }
              ]
            }
          },
          "meta": {
            "type": "object"
          }
        }
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pubkey",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "pubkey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "kind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "coordinate": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "media_type"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
