{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openagents.xp-quest.v1",
  "title": "NIP-XP quest version (kind 30193) body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "requires",
    "type",
    "id",
    "version",
    "season",
    "title",
    "objective",
    "acceptance",
    "reference",
    "award",
    "completions"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "requires": {
      "type": "array",
      "maxItems": 0
    },
    "type": {
      "const": "quest"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "opens_at",
        "closes_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "opens_at": {
          "type": "integer",
          "minimum": 0
        },
        "closes_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "acceptance": {
      "anyOf": [
        {
          "$ref": "#/$defs/kb-transfer"
        },
        {
          "$ref": "#/$defs/reproduce"
        },
        {
          "$ref": "#/$defs/playtest"
        },
        {
          "$ref": "#/$defs/eval-check"
        },
        {
          "$ref": "#/$defs/eval-adopt"
        }
      ]
    },
    "reference": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "usd",
            "seconds",
            "source"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "usd": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "seconds": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "source": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              ]
            }
          }
        }
      ]
    },
    "award": {
      "anyOf": [
        {
          "$ref": "#/$defs/kb-transfer-award"
        },
        {
          "$ref": "#/$defs/reproduce-award"
        },
        {
          "$ref": "#/$defs/playtest-award"
        },
        {
          "$ref": "#/$defs/eval-check-award"
        },
        {
          "$ref": "#/$defs/eval-adopt-award"
        }
      ]
    },
    "completions": {
      "enum": [
        "first",
        "per-awardee"
      ]
    },
    "max_awards": {
      "description": "Required under per-awardee and absent under first: the most live awards the quest version pays. Only the reproduce rule takes per-awardee, and only its reproducer role may carry XP.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "$defs": {
    "kb-transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "task",
        "min_pass_rate",
        "max_usd_per_run"
      ],
      "properties": {
        "rule": {
          "const": "kb-transfer"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "min_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_usd_per_run": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      }
    },
    "reproduce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "task",
        "recipe",
        "claim"
      ],
      "properties": {
        "rule": {
          "const": "reproduce"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recipe": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "pubkey": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "const": 3189
            }
          }
        }
      }
    },
    "kb-transfer-award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "runner"
      ],
      "properties": {
        "author": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "runner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "reproduce-award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimant",
        "reproducer"
      ],
      "properties": {
        "claimant": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "reproducer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "playtest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "contribution",
        "builds",
        "max_awards"
      ],
      "properties": {
        "rule": {
          "const": "playtest"
        },
        "contribution": {
          "enum": [
            "feedback",
            "bug",
            "design",
            "verified-fix",
            "session",
            "diary"
          ]
        },
        "builds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "max_awards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "severities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "enum": [
              "p0",
              "p1",
              "p2",
              "p3"
            ]
          }
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "format": {
          "enum": [
            "unmoderated",
            "moderated",
            "group"
          ]
        }
      }
    },
    "playtest-award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tester",
        "triager"
      ],
      "properties": {
        "tester": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "triager": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "eval-check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "suite",
        "subject",
        "max_awards"
      ],
      "properties": {
        "rule": {
          "const": "eval-check"
        },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "pubkey": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "const": 3184
            }
          }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "pubkey": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "const": 3184
            }
          }
        },
        "max_awards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "eval-adopt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "defaults",
        "subject"
      ],
      "properties": {
        "rule": {
          "const": "eval-adopt"
        },
        "defaults": {
          "type": "string",
          "minLength": 66,
          "maxLength": 130
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "pubkey": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "const": 3184
            }
          }
        }
      }
    },
    "eval-check-award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checker",
        "evaluator",
        "suite-author"
      ],
      "properties": {
        "checker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "evaluator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "suite-author": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "eval-adopt-award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension-author",
        "suite-author",
        "evaluator"
      ],
      "properties": {
        "extension-author": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "suite-author": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "evaluator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
