// Antigravity host control-plane extensions served over both local service.sock and
// sealed NIP-44 Tailscale RPC (via DmRequest/DmView):
// - Artifacts listing & chunked reading (#14014)
// - Swarm & multi-agent subagent/board/workflow inspection (#14015)
// - Scheduled tasks & persistent Antigravity /automation sidecars (#14016)
// - Antigravity permissions, sandbox, MCP, skills, rules, agents, hooks, plugins & credits config (#14017, #14018)

dm_ext_ends_with :: (s: string, suf: string) -> bool {
  if suf.count > s.count { return false; }
  off := s.count - suf.count;
  for i: 0..<suf.count { if s[off + i] != suf[i] { return false; } }
  return true;
}

dm_ext_contains :: (s: string, sub: string) -> bool {
  if sub.count == 0 { return true; }
  if sub.count > s.count { return false; }
  for i: 0..<(s.count - sub.count + 1) {
    ok := true;
    for j: 0..<sub.count { if s[i + j] != sub[j] { ok = false; break; } }
    if ok { return true; }
  }
  return false;
}

dm_ext_safe_id :: (s: string) -> bool {
  if s.count < 1 || s.count > 128 { return false; }
  for c: s {
    if c == '/' || c == '\\' || c < 32 || c == 127 { return false; }
  }
  if s == "." || s == ".." || dm_ext_contains(s, "..") { return false; }
  return true;
}

dm_ext_brain_dir :: (sid: string, out: [] u8) -> string {
  if !dm_ext_safe_id(sid) { return ""; }
  hb: [1024] u8; home := ph_home(hb[..]);
  if home.count == 0 { return ""; }
  roots := [4] string.[
    "/.gemini/antigravity/brain/",
    "/.gemini/antigravity-acp/brain/",
    "/.gemini/antigravity-cli/brain/",
    "/.openagents/brain/",
  ];
  for r: roots {
    n := hs_cat(out, 0, home);
    n = hs_cat(out, n, r);
    n = hs_cat(out, n, sid);
    p := cast(string) out[0..<n];
    if fs_exists(p) { return p; }
  }
  // Fallback to default path even if not yet created
  n := hs_cat(out, 0, home);
  n = hs_cat(out, n, "/.gemini/antigravity/brain/");
  n = hs_cat(out, n, sid);
  return cast(string) out[0..<n];
}

dm_ext_artifact_kind :: (name: string) -> string {
  if name == "implementation_plan.md" { return "plan|Implementation Plan"; }
  if name == "walkthrough.md" { return "walkthrough|Walkthrough"; }
  if name == "task.md" { return "task|Task Checklist"; }
  if dm_ext_ends_with(name, ".html") || dm_ext_ends_with(name, ".htm") { return "html|Generative UI Widget"; }
  if dm_ext_ends_with(name, ".png") || dm_ext_ends_with(name, ".jpg") || dm_ext_ends_with(name, ".jpeg") || dm_ext_ends_with(name, ".webp") { return "image|Screenshot Artifact"; }
  if dm_ext_ends_with(name, ".mp4") || dm_ext_ends_with(name, ".webm") { return "video|Browser Recording"; }
  if dm_ext_contains(name, "learn") { return "learning|Learning Proposal"; }
  if dm_ext_ends_with(name, ".md") { return "markdown|Markdown Artifact"; }
  return "";
}

dm_ext_push_meta :: (v: [] DmView, id: string, title: string, folder: string, pinned: bool, archived: bool, updated: int) {
  if v[0].nmeta >= DM_META_MAX { return; }
  idx := v[0].nmeta;
  v[0].meta[idx] = DmSessionMeta.{};
  v[0].meta[idx].ni = ea_copy(v[0].meta[idx].id[..], hs_cut(id, 128));
  v[0].meta[idx].nt = ea_copy(v[0].meta[idx].title[..], hs_cut(title, 256));
  v[0].meta[idx].nf = ea_copy(v[0].meta[idx].folder[..], hs_cut(folder, 1024));
  v[0].meta[idx].pinned = pinned;
  v[0].meta[idx].archived = archived;
  v[0].meta[idx].updated = updated;
  v[0].nmeta += 1;
}

// #14014: ListArtifacts in <brain>/<session_id>/ (plus metadata sidecars)
dm_ext_list_artifacts :: (q: [] DmRequest, v: [] DmView) {
  sid := cast(string) q[0].session[0..<q[0].ns];
  dirb: [1400] u8;
  dir := dm_ext_brain_dir(sid, dirb[..]);
  if dir.count == 0 || !fs_exists(dir) {
    v[0].nst = ea_copy(v[0].status[..], "empty");
    return;
  }
  names: [1] FsList;
  k := fs_list(dir, names[..]);
  for i: 0..<k {
    if v[0].nmeta >= DM_META_MAX { break; }
    name := fs_entry(names[..], i);
    if name.count == 0 || name[0] == '.' || dm_ext_ends_with(name, ".metadata.json") { continue; }
    kind := dm_ext_artifact_kind(name);
    if kind.count == 0 { continue; }
    // Check optional <name>.metadata.json for summary / requestFeedback
    mp: [1600] u8;
    mn := hs_cat(mp[..], 0, dir);
    mn = hs_cat(mp[..], mn, "/");
    mn = hs_cat(mp[..], mn, name);
    fp := cast(string) mp[0..<mn];
    mtime := fs_mtime_ns(fp) / 1000000000;
    mn = hs_cat(mp[..], mn, ".metadata.json");
    summary: [1024] u8; sn := 0;
    req_fb := name == "implementation_plan.md";
    if fs_exists(cast(string) mp[0..<mn]) {
      mb: [4096] u8; mlen := fs_read(cast(string) mp[0..<mn], mb[..]);
      if mlen > 0 {
        mstr := cast(string) mb[0..<mlen];
        sn = sched_jstr(mstr, "summary", summary[..]);
        if sn < 0 { sn = 0; }
        if dm_ext_contains(mstr, "\"requestFeedback\":true") || dm_ext_contains(mstr, "\"RequestFeedback\":true") { req_fb = true; }
      }
    }
    dm_ext_push_meta(v, name, kind, cast(string) summary[0..<sn], req_fb, false, mtime);
  }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14014: ReadArtifact (chunked across foreman.prompt + meta[1..n].folder, base64 for images)
dm_ext_read_artifact :: (q: [] DmRequest, v: [] DmView) {
  sid := cast(string) q[0].session[0..<q[0].ns];
  name := cast(string) q[0].title[0..<q[0].ntl];
  if !dm_ext_safe_id(name) { dm_fail(v, "workspace_refused"); return; }
  dirb: [1400] u8;
  dir := dm_ext_brain_dir(sid, dirb[..]);
  if dir.count == 0 { dm_fail(v, "not_found"); return; }
  fpb: [1600] u8;
  fn := hs_cat(fpb[..], 0, dir);
  fn = hs_cat(fpb[..], fn, "/");
  fn = hs_cat(fpb[..], fn, name);
  fp := cast(string) fpb[0..<fn];
  raw: [49152] u8;
  n := fs_read(fp, raw[..]);
  if n < 0 { dm_fail(v, "not_found"); return; }
  is_img := dm_ext_ends_with(name, ".png") || dm_ext_ends_with(name, ".jpg") || dm_ext_ends_with(name, ".jpeg") || dm_ext_ends_with(name, ".webp");
  mime := ifx dm_ext_ends_with(name, ".png") then "image/png"
    else ifx dm_ext_ends_with(name, ".jpg") || dm_ext_ends_with(name, ".jpeg") then "image/jpeg"
    else ifx dm_ext_ends_with(name, ".webp") then "image/webp"
    else ifx dm_ext_ends_with(name, ".html") || dm_ext_ends_with(name, ".htm") then "text/html"
    else "text/markdown";
  dm_ext_push_meta(v, name, mime, fp, false, is_img, n);
  content_buf: [49152] u8;
  cn := 0;
  if is_img {
    cap_n := ifx n > 30000 then 30000 else n;
    enc := base64_encode_checked(cast(string) raw[0..<cap_n], content_buf[..], false);
    if enc.error == 0 { cn = enc.written; }
  } else {
    cn = ifx n > 48000 then 48000 else n;
    for i: 0..<cn { content_buf[i] = raw[i]; }
  }
  first := ifx cn > 4000 then 4000 else cn;
  v[0].foreman[0].np = ea_copy(v[0].foreman[0].prompt[..], cast(string) content_buf[0..<first]);
  off := first;
  chunk_idx := 1;
  while off < cn && v[0].nmeta < DM_META_MAX {
    take := ifx cn - off > 1000 then 1000 else cn - off;
    cb: [32] u8; ci := hs_cat(cb[..], 0, "chunk:"); ci = hs_cat(cb[..], ci, hs_itoa(chunk_idx, cb[ci..<cb.count]));
    dm_ext_push_meta(v, cast(string) cb[0..<ci], "chunk", cast(string) content_buf[off..<off + take], false, false, off);
    off += take;
    chunk_idx += 1;
  }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14015: ReadSwarm (live subagents from daemon runs + swarm board/members/workflow logs under brain dir)
dm_ext_read_swarm :: (h: [] HsHost, q: [] DmRequest, v: [] DmView) {
  sid := cast(string) q[0].session[0..<q[0].ns];
  runs: [DK_RUNS] DkInfo;
  nr := dk_all(runs[..]);
  active_subs := 0;
  for i: 0..<nr {
    r := runs[i..<i + 1];
    sess := cast(string) r[0].session[0..<r[0].nsession];
    if sid.count > 0 && sess != sid && !dm_ext_contains(sess, sid) { continue; }
    rid := cast(string) r[0].id[..];
    if rid == sid { continue; }
    running := dk_running(r);
    if running { active_subs += 1; }
    idb: [128] u8; in_ := hs_cat(idb[..], 0, "subagent:"); in_ = hs_cat(idb[..], in_, rid);
    tb: [256] u8; tn := hs_cat(tb[..], 0, ifx r[0].nmo > 0 then cast(string) r[0].model[0..<r[0].nmo] else "antigravity");
    tn = hs_cat(tb[..], tn, "|");
    tn = hs_cat(tb[..], tn, ifx running then "active" else "stopped");
    dm_ext_push_meta(v, cast(string) idb[0..<in_], cast(string) tb[0..<tn], cast(string) r[0].cwd[0..<r[0].ncwd], running, false, r[0].started);
  }
  // Scan <brain>/<sid>/.system_generated/logs/ or swarm files if present
  if sid.count > 0 {
    dirb: [1400] u8;
    bdir := dm_ext_brain_dir(sid, dirb[..]);
    if bdir.count > 0 {
      sdir: [1600] u8; sn := hs_cat(sdir[..], 0, bdir); sn = hs_cat(sdir[..], sn, "/.system_generated");
      if fs_exists(cast(string) sdir[0..<sn]) {
        // Look for swarm-board.jsonl or workflow-phases.json
        bp: [1700] u8; bn := hs_cat(bp[..], 0, cast(string) sdir[0..<sn]); bn = hs_cat(bp[..], bn, "/swarm-board.jsonl");
        if fs_exists(cast(string) bp[0..<bn]) {
          raw: [16384] u8; rn := fs_read(cast(string) bp[0..<bn], raw[..]);
          if rn > 0 {
            at := 0; post_idx := 0;
            while at < rn && v[0].nmeta < DM_META_MAX {
              end := at; while end < rn && raw[end] != 10 { end += 1; }
              if end > at {
                line := cast(string) raw[at..<end];
                pidb: [48] u8; pn := hs_cat(pidb[..], 0, "post:"); pn = hs_cat(pidb[..], pn, hs_itoa(post_idx, pidb[pn..<pidb.count]));
                who: [64] u8; wn := sched_jstr(line, "author", who[..]);
                if wn < 1 { wn = ea_copy(who[..], "coordinator"); }
                msg: [1024] u8; mn := sched_jstr(line, "message", msg[..]);
                if mn < 1 { mn = ea_copy(msg[..], hs_cut(line, 1000)); }
                dm_ext_push_meta(v, cast(string) pidb[0..<pn], cast(string) who[0..<wn], cast(string) msg[0..<mn], false, false, post_idx);
                post_idx += 1;
              }
              at = end + 1;
            }
          }
        }
      }
    }
  }
  o: [1] Jo; jb: [1024] u8; jo_start(o[..], jb[..]);
  jo_obj(o[..]);
  jo_key(o[..], "session_id"); jo_str(o[..], sid);
  jo_key(o[..], "active_subagents"); jo_int(o[..], active_subs);
  jo_key(o[..], "total_entries"); jo_int(o[..], v[0].nmeta);
  jo_end(o[..]);
  if !o[0].bad { v[0].foreman[0].np = ea_copy(v[0].foreman[0].prompt[..], cast(string) jb[0..<o[0].n]); }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14016: ListAutomations (scheduled-tasks.json + ~/.gemini/config/sidecars/*/sidecar.json)
dm_ext_list_automations :: (v: [] DmView) {
  // 1. coder-host scheduled tasks
  pb: [1400] u8;
  path := sc_desktop_file("scheduled-tasks.json", pb[..]);
  if path.count > 0 && fs_exists(path) {
    raw: [65536] u8; rn := fs_read(path, raw[..]);
    if rn > 0 {
      tasks: [SC_TASKS_MAX] ScTask;
      count := sc_tasks_load(cast(string) raw[0..<rn], tasks[..]);
      for i: 0..<count {
        t := tasks[i];
        idb: [128] u8; in_ := hs_cat(idb[..], 0, "sched:"); in_ = hs_cat(idb[..], in_, cast(string) t.id[0..<t.id_n]);
        tb: [256] u8; tn := hs_cat(tb[..], 0, cast(string) t.name[0..<t.name_n]);
        tn = hs_cat(tb[..], tn, "|"); tn = hs_cat(tb[..], tn, cast(string) t.cron[0..<t.cron_n]);
        tn = hs_cat(tb[..], tn, "|antigravity");
        fb: [1024] u8; fn := hs_cat(fb[..], 0, cast(string) t.folder[0..<t.folder_n]);
        fn = hs_cat(fb[..], fn, "|"); fn = hs_cat(fb[..], fn, cast(string) t.prompt[0..<t.prompt_n]);
        fn = hs_cat(fb[..], fn, "|"); fn = hs_cat(fb[..], fn, cast(string) t.last_chat_id[0..<t.last_chat_id_n]);
        dm_ext_push_meta(v, cast(string) idb[0..<in_], cast(string) tb[0..<tn], cast(string) fb[0..<fn], t.enabled, false, t.last_run_ms);
      }
    }
  }
  // 2. Persistent Antigravity /automation sidecars (~/.gemini/config/sidecars/*/sidecar.json)
  hb: [1024] u8; home := ph_home(hb[..]);
  if home.count > 0 {
    sdb: [1400] u8; sdn := hs_cat(sdb[..], 0, home); sdn = hs_cat(sdb[..], sdn, "/.gemini/config/sidecars");
    sdir := cast(string) sdb[0..<sdn];
    if fs_exists(sdir) {
      names: [1] FsList;
      k := fs_list(sdir, names[..]);
      for i: 0..<k {
        if v[0].nmeta >= DM_META_MAX { break; }
        ent := fs_entry(names[..], i);
        if ent.count == 0 || ent[0] == '.' { continue; }
        sp: [1600] u8; sn := hs_cat(sp[..], 0, sdir); sn = hs_cat(sp[..], sn, "/"); sn = hs_cat(sp[..], sn, ent); sn = hs_cat(sp[..], sn, "/sidecar.json");
        if !fs_exists(cast(string) sp[0..<sn]) { continue; }
        sb: [8192] u8; slen := fs_read(cast(string) sp[0..<sn], sb[..]);
        if slen < 2 { continue; }
        sstr := cast(string) sb[0..<slen];
        nm: [96] u8; nmn := sched_jstr(sstr, "name", nm[..]); if nmn < 1 { nmn = ea_copy(nm[..], ent); }
        cr: [64] u8; crn := sched_jstr(sstr, "cron", cr[..]); if crn < 1 { crn = sched_jstr(sstr, "schedule", cr[..]); }
        if crn < 1 { crn = ea_copy(cr[..], "sidecar"); }
        md: [64] u8; mdn := sched_jstr(sstr, "model", md[..]); if mdn < 1 { mdn = ea_copy(md[..], "flash"); }
        pr: [512] u8; prn := sched_jstr(sstr, "prompt", pr[..]); if prn < 0 { prn = 0; }
        en := !dm_ext_contains(sstr, "\"enabled\":false") && !dm_ext_contains(sstr, "\"paused\":true");
        idb: [128] u8; in_ := hs_cat(idb[..], 0, "sidecar:"); in_ = hs_cat(idb[..], in_, ent);
        tb: [256] u8; tn := hs_cat(tb[..], 0, cast(string) nm[0..<nmn]);
        tn = hs_cat(tb[..], tn, "|"); tn = hs_cat(tb[..], tn, cast(string) cr[0..<crn]);
        tn = hs_cat(tb[..], tn, "|"); tn = hs_cat(tb[..], tn, cast(string) md[0..<mdn]);
        fb: [1024] u8; fn := hs_cat(fb[..], 0, "|"); fn = hs_cat(fb[..], fn, cast(string) pr[0..<prn]); fn = hs_cat(fb[..], fn, "|");
        dm_ext_push_meta(v, cast(string) idb[0..<in_], cast(string) tb[0..<tn], cast(string) fb[0..<fn], en, true, 0);
      }
    }
  }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14016: ToggleAutomation (enable/pause scheduled task)
dm_ext_toggle_automation :: (q: [] DmRequest, v: [] DmView) {
  raw_id := cast(string) q[0].session[0..<q[0].ns];
  if raw_id.count == 0 { dm_fail(v, "malformed"); return; }
  id := ifx ws_has_prefix(raw_id, "sched:") then raw_id[6..<raw_id.count] else raw_id;
  pb: [1400] u8; path := sc_desktop_file("scheduled-tasks.json", pb[..]);
  if path.count == 0 || !fs_exists(path) { dm_fail(v, "not_found"); return; }
  raw: [65536] u8; rn := fs_read(path, raw[..]);
  if rn < 2 { dm_fail(v, "not_found"); return; }
  tasks: [SC_TASKS_MAX] ScTask;
  count := sc_tasks_load(cast(string) raw[0..<rn], tasks[..]);
  found := -1;
  for i: 0..<count {
    if cast(string) tasks[i].id[0..<tasks[i].id_n] == id {
      tasks[i].enabled = ifx q[0].has_pinned then q[0].pinned else !tasks[i].enabled;
      found = i;
      break;
    }
  }
  if found < 0 { dm_fail(v, "not_found"); return; }
  out: [65536] u8; on := sc_tasks_save(tasks[..], count, out[..]);
  if on < 1 || !fs_replace_durable(path, cast(string) out[0..<on]) { dm_fail(v, "storage_unavailable"); return; }
  dm_ext_list_automations(v);
  v[0].nst = ea_copy(v[0].status[..], "updated");
}

// #14016: RunAutomation (trigger immediate run via sc_launch_run)
dm_ext_run_automation :: (h: [] HsHost, q: [] DmRequest, v: [] DmView) {
  raw_id := cast(string) q[0].session[0..<q[0].ns];
  if raw_id.count == 0 { dm_fail(v, "malformed"); return; }
  id := ifx ws_has_prefix(raw_id, "sched:") then raw_id[6..<raw_id.count] else raw_id;
  pb: [1400] u8; path := sc_desktop_file("scheduled-tasks.json", pb[..]);
  if path.count == 0 || !fs_exists(path) { dm_fail(v, "not_found"); return; }
  raw: [65536] u8; rn := fs_read(path, raw[..]);
  if rn < 2 { dm_fail(v, "not_found"); return; }
  tasks: [SC_TASKS_MAX] ScTask;
  count := sc_tasks_load(cast(string) raw[0..<rn], tasks[..]);
  found := -1;
  for i: 0..<count {
    if cast(string) tasks[i].id[0..<tasks[i].id_n] == id { found = i; break; }
  }
  if found < 0 { dm_fail(v, "not_found"); return; }
  idb: [64] u8;
  run_id := sc_launch_run(
    h,
    cast(string) tasks[found].prompt[0..<tasks[found].prompt_n],
    cast(string) tasks[found].folder[0..<tasks[found].folder_n],
    idb[..]
  );
  if run_id.count == 0 { dm_fail(v, "operation_failed"); return; }
  tasks[found].last_run_ms = hs_now() * 1000;
  tasks[found].last_chat_id_n = sched_copy(tasks[found].last_chat_id[..], run_id);
  out: [65536] u8; on := sc_tasks_save(tasks[..], count, out[..]);
  if on > 0 { _ = fs_replace_durable(path, cast(string) out[0..<on]); }
  v[0].foreman[0].nw = ea_copy(v[0].foreman[0].workspace[..], run_id);
  dm_ext_list_automations(v);
  v[0].nst = ea_copy(v[0].status[..], "triggered");
}

dm_ext_scan_dir_kind :: (dir: string, prefix: string, label: string, v: [] DmView) {
  if dir.count == 0 || !fs_exists(dir) { return; }
  names: [1] FsList;
  k := fs_list(dir, names[..]);
  for i: 0..<k {
    if v[0].nmeta >= DM_META_MAX { break; }
    ent := fs_entry(names[..], i);
    if ent.count == 0 || ent[0] == '.' { continue; }
    idb: [128] u8; in_ := hs_cat(idb[..], 0, prefix); in_ = hs_cat(idb[..], in_, ent);
    dm_ext_push_meta(v, cast(string) idb[0..<in_], ent, dir, true, false, 0);
  }
}

// #14017 & #14018: ReadAntigravityConfig (settings.json, admin_settings.json, mcp_config.json, skills, rules, agents, plugins, hooks)
dm_ext_read_agy_config :: (h: [] HsHost, v: [] DmView) {
  hb: [1024] u8; home := ph_home(hb[..]);
  if home.count == 0 { dm_fail(v, "unavailable"); return; }
  // 1. Read ~/.gemini/settings.json
  sb: [1400] u8; sn := hs_cat(sb[..], 0, home); sn = hs_cat(sb[..], sn, "/.gemini/settings.json");
  raw: [32768] u8; rn := fs_read(cast(string) sb[0..<sn], raw[..]);
  tool_perm: [64] u8; tpn := ea_copy(tool_perm[..], "request-review");
  art_pol: [64] u8; apn := ea_copy(art_pol[..], "asks-for-review");
  sandbox := false;
  sandbox_proxy := false;
  use_g1 := false;
  if rn > 0 {
    s := cast(string) raw[0..<rn];
    t := sched_jstr(s, "toolPermission", tool_perm[..]); if t > 0 { tpn = t; }
    a := sched_jstr(s, "artifactReviewPolicy", art_pol[..]); if a > 0 { apn = a; }
    sandbox = dm_ext_contains(s, "\"enableTerminalSandbox\":true");
    sandbox_proxy = dm_ext_contains(s, "\"sandboxProxy\"");
    use_g1 = dm_ext_contains(s, "\"useG1Credits\":true");
    // Parse permissions.{allow,ask,deny} arrays if present
    nodes: [1024] JvNode; d: [1] Jv;
    if jv_parse(d[..], s, nodes[..]) && jv_kind(d[0], 0) == JV_OBJECT {
      perms := jv_get(d[0], 0, "permissions");
      if perms >= 0 && jv_kind(d[0], perms) == JV_OBJECT {
        kinds := [3] string.["allow", "ask", "deny"];
        for pk: kinds {
          arr := jv_get(d[0], perms, pk);
          if arr >= 0 && jv_kind(d[0], arr) == JV_ARRAY {
            alen := jv_len(d[0], arr);
            for i: 0..<alen {
              if v[0].nmeta >= DM_META_MAX { break; }
              rule: [256] u8; rln := jv_str(d[0], jv_at(d[0], arr, i), rule[..]);
              if rln > 0 {
                idb: [128] u8; in_ := hs_cat(idb[..], 0, "perm:"); in_ = hs_cat(idb[..], in_, pk);
                in_ = hs_cat(idb[..], in_, ":"); in_ = hs_cat(idb[..], in_, hs_itoa(i, idb[in_..<idb.count]));
                dm_ext_push_meta(v, cast(string) idb[0..<in_], pk, cast(string) rule[0..<rln], pk == "allow", pk == "deny", i);
              }
            }
          }
        }
      }
    }
  }
  // 2. Read-only enterprise admin_settings.json
  admin_present := fs_exists("/Library/Application Support/Google/Antigravity/admin_settings.json");
  // 3. Parse ~/.gemini/antigravity/mcp_config.json
  mp: [1400] u8; mn := hs_cat(mp[..], 0, home); mn = hs_cat(mp[..], mn, "/.gemini/antigravity/mcp_config.json");
  if fs_exists(cast(string) mp[0..<mn]) {
    mb: [32768] u8; mlen := fs_read(cast(string) mp[0..<mn], mb[..]);
    if mlen > 0 {
      nodes: [1024] JvNode; d: [1] Jv;
      if jv_parse(d[..], cast(string) mb[0..<mlen], nodes[..]) && jv_kind(d[0], 0) == JV_OBJECT {
        sv := jv_get(d[0], 0, "mcpServers");
        if sv >= 0 && jv_kind(d[0], sv) == JV_OBJECT {
          n_sv := jv_len(d[0], sv);
          for i: 0..<n_sv {
            if v[0].nmeta >= DM_META_MAX { break; }
            child := jv_at(d[0], sv, i);
            sname := jv_key(d[0], child);
            cmd: [256] u8; cn := jv_str(d[0], jv_get(d[0], child, "command"), cmd[..]);
            if cn < 1 { cn = jv_str(d[0], jv_get(d[0], child, "serverUrl"), cmd[..]); }
            if cn < 1 { cn = jv_str(d[0], jv_get(d[0], child, "url"), cmd[..]); }
            if cn < 0 { cn = 0; }
            dis := jv_kind(d[0], jv_get(d[0], child, "disabled")) == JV_TRUE;
            idb: [128] u8; in_ := hs_cat(idb[..], 0, "mcp:"); in_ = hs_cat(idb[..], in_, sname);
            dm_ext_push_meta(v, cast(string) idb[0..<in_], sname, cast(string) cmd[0..<cn], !dis, dis, 0);
          }
        }
      }
    }
  }
  // 4. Scan Skills, Rules, Custom Agents, Plugins
  db: [1400] u8;
  dn := hs_cat(db[..], 0, home); dn = hs_cat(db[..], dn, "/.gemini/antigravity/skills");
  dm_ext_scan_dir_kind(cast(string) db[0..<dn], "skill:", "skill", v);
  dn = hs_cat(db[..], 0, home); dn = hs_cat(db[..], dn, "/.gemini/antigravity/builtin/skills");
  dm_ext_scan_dir_kind(cast(string) db[0..<dn], "skill:", "builtin-skill", v);
  dn = hs_cat(db[..], 0, home); dn = hs_cat(db[..], dn, "/.gemini/antigravity/rules");
  dm_ext_scan_dir_kind(cast(string) db[0..<dn], "rule:", "rule", v);
  dn = hs_cat(db[..], 0, home); dn = hs_cat(db[..], dn, "/.gemini/antigravity/agents");
  dm_ext_scan_dir_kind(cast(string) db[0..<dn], "agent:", "agent", v);
  dn = hs_cat(db[..], 0, home); dn = hs_cat(db[..], dn, "/.gemini/config/plugins");
  dm_ext_scan_dir_kind(cast(string) db[0..<dn], "plugin:", "plugin", v);
  // Summary JSON in foreman.prompt
  o: [1] Jo; jb: [2048] u8; jo_start(o[..], jb[..]);
  jo_obj(o[..]);
  jo_key(o[..], "toolPermission"); jo_str(o[..], cast(string) tool_perm[0..<tpn]);
  jo_key(o[..], "artifactReviewPolicy"); jo_str(o[..], cast(string) art_pol[0..<apn]);
  jo_key(o[..], "enableTerminalSandbox"); jo_bool(o[..], sandbox);
  jo_key(o[..], "sandboxProxy"); jo_bool(o[..], sandbox_proxy);
  jo_key(o[..], "useG1Credits"); jo_bool(o[..], use_g1);
  jo_key(o[..], "adminSettingsPresent"); jo_bool(o[..], admin_present);
  jo_key(o[..], "agyVersion"); jo_str(o[..], cast(string) h[0].phone[0].agy_version[0..<h[0].phone[0].agy_nversion]);
  jo_key(o[..], "authMode"); jo_str(o[..], cast(string) h[0].phone[0].agy_auth_probed[0..<h[0].phone[0].agy_nauth_probed]);
  jo_end(o[..]);
  if !o[0].bad { v[0].foreman[0].np = ea_copy(v[0].foreman[0].prompt[..], cast(string) jb[0..<o[0].n]); }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14017 & #14018: UpdateAntigravityConfig (safely updates ~/.gemini/settings.json keys)
dm_ext_update_agy_config :: (h: [] HsHost, q: [] DmRequest, v: [] DmView) {
  hb: [1024] u8; home := ph_home(hb[..]);
  if home.count == 0 { dm_fail(v, "unavailable"); return; }
  patch := cast(string) q[0].text[0..<q[0].nt];
  if patch.count < 2 { dm_fail(v, "malformed"); return; }
  pnodes: [256] JvNode; pd: [1] Jv;
  if !jv_parse(pd[..], patch, pnodes[..]) || jv_kind(pd[0], 0) != JV_OBJECT { dm_fail(v, "malformed"); return; }
  // Read existing ~/.gemini/settings.json
  sb: [1400] u8; sn := hs_cat(sb[..], 0, home); sn = hs_cat(sb[..], sn, "/.gemini/settings.json");
  spath := cast(string) sb[0..<sn];
  raw: [32768] u8; rn := fs_read(spath, raw[..]);
  tool_perm: [64] u8; tpn := ea_copy(tool_perm[..], "request-review");
  art_pol: [64] u8; apn := ea_copy(art_pol[..], "asks-for-review");
  sandbox := false;
  use_g1 := false;
  if rn > 0 {
    s := cast(string) raw[0..<rn];
    t := sched_jstr(s, "toolPermission", tool_perm[..]); if t > 0 { tpn = t; }
    a := sched_jstr(s, "artifactReviewPolicy", art_pol[..]); if a > 0 { apn = a; }
    sandbox = dm_ext_contains(s, "\"enableTerminalSandbox\":true");
    use_g1 = dm_ext_contains(s, "\"useG1Credits\":true");
  }
  // Apply typed patch fields from client
  ntp := jv_get(pd[0], 0, "toolPermission");
  if ntp >= 0 { k := jv_str(pd[0], ntp, tool_perm[..]); if k > 0 { tpn = k; } }
  nap := jv_get(pd[0], 0, "artifactReviewPolicy");
  if nap >= 0 { k := jv_str(pd[0], nap, art_pol[..]); if k > 0 { apn = k; } }
  nsb := jv_get(pd[0], 0, "enableTerminalSandbox");
  if nsb >= 0 { sandbox = jv_kind(pd[0], nsb) == JV_TRUE; }
  ng1 := jv_get(pd[0], 0, "useG1Credits");
  if ng1 >= 0 { use_g1 = jv_kind(pd[0], ng1) == JV_TRUE; }
  // Write clean merged settings JSON preserving existing unrelated fields or rewriting cleanly
  out: [32768] u8; o: [1] Jo; jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "toolPermission"); jo_str(o[..], cast(string) tool_perm[0..<tpn]);
  jo_key(o[..], "artifactReviewPolicy"); jo_str(o[..], cast(string) art_pol[0..<apn]);
  jo_key(o[..], "enableTerminalSandbox"); jo_bool(o[..], sandbox);
  jo_key(o[..], "useG1Credits"); jo_bool(o[..], use_g1);
  // Preserve existing top-level keys from settings.json that we did not overwrite
  if rn > 0 {
    enodes: [1024] JvNode; ed: [1] Jv;
    if jv_parse(ed[..], cast(string) raw[0..<rn], enodes[..]) && jv_kind(ed[0], 0) == JV_OBJECT {
      elen := jv_len(ed[0], 0);
      for i: 0..<elen {
        ch := jv_at(ed[0], 0, i);
        key := jv_key(ed[0], ch);
        if key == "toolPermission" || key == "artifactReviewPolicy" || key == "enableTerminalSandbox" || key == "useG1Credits" { continue; }
        val := jv_raw(ed[0], ch);
        if val.count > 0 {
          jo_key(o[..], key);
          jo_raw(o[..], val);
        }
      }
    }
  }
  jo_end(o[..]);
  if o[0].bad || !fs_replace_durable(spath, cast(string) out[0..<o[0].n]) { dm_fail(v, "storage_unavailable"); return; }
  dm_ext_read_agy_config(h, v);
  v[0].nst = ea_copy(v[0].status[..], "updated");
}

dm_ext_tmux_target_ok :: (s: string) -> bool {
  if s.count < 1 || s.count > 96 { return false; }
  if s[0] == '-' { return false; }
  for c: s {
    ok := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
      || c == '_' || c == '.' || c == ':' || c == '-';
    if !ok { return false; }
  }
  return true;
}

dm_ext_parse_int :: (s: string, fallback: int) -> int {
  if s.count == 0 { return fallback; }
  i := 0; neg := false;
  if s[0] == '-' { neg = true; i = 1; }
  if i >= s.count { return fallback; }
  v := 0;
  while i < s.count {
    c := s[i];
    if c < '0' || c > '9' { return fallback; }
    v = v * 10 + cast(int) (c - '0');
    i += 1;
  }
  return ifx neg then -v else v;
}

dm_ext_read_usage_file :: (path: string, provider: string, profile: string, v: [] DmView, max_bp: [] int, max_lbl: [] u8, max_lbl_n: [] int) {
  raw: [8192] u8;
  rn := fs_read(path, raw[..]);
  if rn < 1 { return; }
  text := cast(string) raw[0..<rn];
  // Format written by coder/tui/usage.coax:
  // line 0: got_ms
  // line 1: plan
  // line 2+: <label> <used_bp> <reset_s>
  at := 0; line_no := 0;
  got_ms := 0;
  plan: [64] u8; pn := 0;
  best_bp := -1; best_reset := 0;
  best_win: [64] u8; bwn := 0;
  while at < text.count {
    end := at;
    while end < text.count && text[end] != 10 && text[end] != 13 { end += 1; }
    line := cast(string) text[at..<end];
    if line_no == 0 {
      got_ms = dm_ext_parse_int(line, 0);
    } else if line_no == 1 {
      pn = ea_copy(plan[..], hs_cut(line, 64));
      if pn < 0 { pn = 0; }
    } else if line.count > 0 {
      // Split on spaces: label bp reset_s
      sp1 := -1; sp2 := -1;
      for k: 0..<line.count {
        if line[k] == ' ' {
          if sp1 < 0 { sp1 = k; } else if sp2 < 0 { sp2 = k; break; }
        }
      }
      if sp1 > 0 && sp2 > sp1 + 1 && sp2 + 1 < line.count {
        wlbl := cast(string) line[0..<sp1];
        wbp := dm_ext_parse_int(cast(string) line[sp1 + 1..<sp2], -1);
        wrs := dm_ext_parse_int(cast(string) line[sp2 + 1..<line.count], 0);
        if wbp >= 0 {
          if wbp > 10000 { wbp = 10000; }
          if wbp > best_bp {
            best_bp = wbp; best_reset = wrs;
            bwn = ea_copy(best_win[..], hs_cut(wlbl, 64));
            if bwn < 0 { bwn = 0; }
          }
        }
      }
    }
    line_no += 1;
    while end < text.count && (text[end] == 10 || text[end] == 13) { end += 1; }
    at = end;
  }
  if best_bp < 0 { return; }
  idb: [128] u8; in_ := hs_cat(idb[..], 0, "quota:"); in_ = hs_cat(idb[..], in_, provider);
  in_ = hs_cat(idb[..], in_, ":"); in_ = hs_cat(idb[..], in_, profile);
  tb: [256] u8; tn := hs_cat(tb[..], 0, provider);
  tn = hs_cat(tb[..], tn, "|"); tn = hs_cat(tb[..], tn, ifx pn > 0 then cast(string) plan[0..<pn] else "Default");
  tn = hs_cat(tb[..], tn, "|observed|");
  nb: [32] u8;
  tn = hs_cat(tb[..], tn, hs_itoa(best_bp, nb[..]));
  tn = hs_cat(tb[..], tn, "|");
  tn = hs_cat(tb[..], tn, hs_itoa(best_reset, nb[..]));
  fb: [256] u8; fn := hs_cat(fb[..], 0, cast(string) best_win[0..<bwn]);
  dm_ext_push_meta(v, cast(string) idb[0..<in_], cast(string) tb[0..<tn], cast(string) fb[0..<fn], best_bp >= 10000, false, got_ms / 1000);
  if best_bp > max_bp[0] {
    max_bp[0] = best_bp;
    n := hs_cat(max_lbl, 0, provider);
    max_lbl_n[0] = n;
  }
}

// #14068: GetUsage — live OpenAgents Cloud/daily spend, $0 local compute status, and provider quotas.
dm_ext_get_usage :: (h: [] HsHost, v: [] DmView) {
  hb: [1024] u8; home := ph_home(hb[..]);
  today_micros := 0;
  today_tokens := 0;
  month_micros := 0;
  credit_msat := 0;
  allow_env: [16] u8;
  allow_harnesses := proc_getenv("OA_ALLOW_LOCAL_HARNESSES", allow_env[..]) == "1";
  wb: [1400] u8;
  local_ready := ph_inkling_weights(wb[..]).count > 0 && fs_exists(ph_inkling_weights(wb[..]));
  max_bp := [1] int.[0];
  max_lbl: [64] u8; max_lbl_n := [1] int.[0];

  if home.count > 0 {
    // 1. Optional ~/.openagents/coder/usage-daily.json written by Desktop turn telemetry
    dp: [1400] u8; dn := hs_cat(dp[..], 0, home); dn = hs_cat(dp[..], dn, "/.openagents/coder/usage-daily.json");
    if fs_exists(cast(string) dp[0..<dn]) {
      db: [16384] u8; dlen := fs_read(cast(string) dp[0..<dn], db[..]);
      if dlen > 2 {
        nodes: [256] JvNode; d: [1] Jv;
        if jv_parse(d[..], cast(string) db[0..<dlen], nodes[..]) && jv_kind(d[0], 0) == JV_OBJECT {
          today_micros = jv_int(d[0], jv_get(d[0], 0, "today_usd_micros"), 0);
          today_tokens = jv_int(d[0], jv_get(d[0], 0, "today_tokens"), 0);
          month_micros = jv_int(d[0], jv_get(d[0], 0, "month_usd_micros"), 0);
          credit_msat = jv_int(d[0], jv_get(d[0], 0, "credit_msat"), 0);
        }
      }
    }
    // 2. Always include Local Inkling $0.00 compute row
    dm_ext_push_meta(v, "quota:local:inkling-2-mini",
      ifx local_ready then "OpenAgents Local|Inkling 2 Mini ($0.00)|observed|0|0" else "OpenAgents Local|Inkling 2 Mini ($0.00)|unavailable|0|0",
      ifx local_ready then "On-device Metal GPU · $0.00" else "Weights not installed",
      false, false, hs_now());
    // 3. Cached provider quota windows (~/.openagents/coder/usage-*.txt)
    if allow_harnesses {
      provs := [3] string.["antigravity", "claude", "codex"];
      for pr: provs {
        up: [1400] u8; un := hs_cat(up[..], 0, home);
        un = hs_cat(up[..], un, "/.openagents/coder/usage-");
        un = hs_cat(up[..], un, pr);
        un = hs_cat(up[..], un, ".txt");
        if fs_exists(cast(string) up[0..<un]) {
          dm_ext_read_usage_file(cast(string) up[0..<un], pr, "Default", v, max_bp[..], max_lbl[..], max_lbl_n[..]);
        }
      }
    } else {
      // Check antigravity cache if present for legacy hosts
      up: [1400] u8; un := hs_cat(up[..], 0, home); un = hs_cat(up[..], un, "/.openagents/coder/usage-antigravity.txt");
      if fs_exists(cast(string) up[0..<un]) {
        dm_ext_read_usage_file(cast(string) up[0..<un], "antigravity", "Default", v, max_bp[..], max_lbl[..], max_lbl_n[..]);
      }
    }
  }
  o: [1] Jo; jb: [1024] u8; jo_start(o[..], jb[..]);
  jo_obj(o[..]);
  jo_key(o[..], "today_usd_micros"); jo_int(o[..], today_micros);
  jo_key(o[..], "month_usd_micros"); jo_int(o[..], month_micros);
  jo_key(o[..], "today_tokens"); jo_int(o[..], today_tokens);
  jo_key(o[..], "local_usd_micros"); jo_int(o[..], 0);
  jo_key(o[..], "credit_msat"); jo_int(o[..], credit_msat);
  jo_key(o[..], "binding_pct"); jo_int(o[..], max_bp[0] / 100);
  jo_key(o[..], "binding_label"); jo_str(o[..], cast(string) max_lbl[0..<max_lbl_n[0]]);
  jo_key(o[..], "local_ready"); jo_bool(o[..], local_ready);
  jo_key(o[..], "allow_local_harnesses"); jo_bool(o[..], allow_harnesses);
  jo_end(o[..]);
  if !o[0].bad { v[0].foreman[0].np = ea_copy(v[0].foreman[0].prompt[..], cast(string) jb[0..<o[0].n]); }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14068: ListIntrospection — discover local TUI/tmux panes and recent external harness sessions (explicit known paths only).
dm_ext_list_introspection :: (h: [] HsHost, v: [] DmView) {
  tui_count := 0;
  harness_count := 0;
  now_s := hs_now();

  // 1. Live tmux panes (TUI & Terminal)
  tb: [1024] u8;
  tmux := ph_find_on_path("tmux", tb[..]);
  if tmux.count > 0 {
    p := proc_new();
    if p >= 0 {
      defer { _ = proc_release(p); }
      ok := proc_arg(p, tmux) && proc_arg(p, "list-panes") && proc_arg(p, "-a")
        && proc_arg(p, "-F") && proc_arg(p, "#{session_name}:#{window_index}.#{pane_index}\t#{pane_current_command}\t#{pane_current_path}\t#{pane_pid}");
      if ok && proc_start(p) == 0 {
        _ = proc_close_stdin(p);
        deadline := proc_now_ms() + 1500;
        while proc_now_ms() < deadline && v[0].nmeta < DM_META_MAX {
          left := proc_left(deadline, proc_now_ms());
          ln := cxproc_read_line(p, ifx left > 200 then 200 else left);
          if ln == PROC_TIMEOUT { continue; }
          if ln < 0 { break; }
          if ln == 0 { continue; }
          linebuf: [1024] u8;
          take := ifx ln > linebuf.count then linebuf.count else ln;
          for i: 0..<take { linebuf[i] = cast(u8) cxproc_line_byte(p, i); }
          line := cast(string) linebuf[0..<take];
          // Split by tab: target \t cmd \t cwd \t pid
          t1 := -1; t2 := -1; t3 := -1;
          for i: 0..<line.count {
            if line[i] == 9 {
              if t1 < 0 { t1 = i; } else if t2 < 0 { t2 = i; } else if t3 < 0 { t3 = i; break; }
            }
          }
          if t1 > 0 && t2 > t1 {
            target := cast(string) line[0..<t1];
            cmd := cast(string) line[t1 + 1..<t2];
            cwd := ifx t3 > t2 then cast(string) line[t2 + 1..<t3] else cast(string) line[t2 + 1..<line.count];
            pid := ifx t3 > t2 && t3 + 1 < line.count then cast(string) line[t3 + 1..<line.count] else "";
            if dm_ext_tmux_target_ok(target) {
              idb: [128] u8; in_ := hs_cat(idb[..], 0, "tui:tmux:"); in_ = hs_cat(idb[..], in_, target);
              tit: [256] u8; tn := hs_cat(tit[..], 0, ifx cmd.count > 0 then cmd else "tmux");
              tn = hs_cat(tit[..], tn, " ("); tn = hs_cat(tit[..], tn, target); tn = hs_cat(tit[..], tn, ")");
              tn = hs_cat(tit[..], tn, "|tmux|running|"); tn = hs_cat(tit[..], tn, pid);
              fb: [1024] u8; fn := hs_cat(fb[..], 0, cwd); fn = hs_cat(fb[..], fn, "|Live tmux pane");
              dm_ext_push_meta(v, cast(string) idb[0..<in_], cast(string) tit[0..<tn], cast(string) fb[0..<fn], true, true, now_s);
              tui_count += 1;
            }
          }
        }
        _ = proc_wait(p, 250);
      }
    }
  }

  // 2. Local OpenAgents TUI heartbeat registry (~/.openagents/tui/sessions/*.json)
  hb: [1024] u8; home := ph_home(hb[..]);
  if home.count > 0 {
    tp: [1400] u8; tn := hs_cat(tp[..], 0, home); tn = hs_cat(tp[..], tn, "/.openagents/tui/sessions");
    tdir := cast(string) tp[0..<tn];
    if fs_exists(tdir) {
      names: [1] FsList;
      k := fs_list(tdir, names[..]);
      for i: 0..<k {
        if v[0].nmeta >= DM_META_MAX { break; }
        ent := fs_entry(names[..], i);
        if ent.count < 6 || ent[0] == '.' || !dm_ext_ends_with(ent, ".json") { continue; }
        fp: [1600] u8; fn := hs_cat(fp[..], 0, tdir); fn = hs_cat(fp[..], fn, "/"); fn = hs_cat(fp[..], fn, ent);
        mt := fs_mtime_ns(cast(string) fp[0..<fn]) / 1000000000;
        raw: [4096] u8; rn := fs_read(cast(string) fp[0..<fn], raw[..]);
        title_b: [128] u8; tbn := 0;
        cwd_b: [512] u8; cbn := 0;
        if rn > 2 {
          s := cast(string) raw[0..<rn];
          tbn = sched_jstr(s, "title", title_b[..]); if tbn < 0 { tbn = 0; }
          cbn = sched_jstr(s, "cwd", cwd_b[..]); if cbn < 0 { cbn = 0; }
        }
        stem := cast(string) ent[0..<ent.count - 5];
        idb: [128] u8; in_ := hs_cat(idb[..], 0, "tui:oa:"); in_ = hs_cat(idb[..], in_, stem);
        tit: [256] u8; ttn := hs_cat(tit[..], 0, ifx tbn > 0 then cast(string) title_b[0..<tbn] else stem);
        ttn = hs_cat(tit[..], ttn, "|tui|running|");
        fb: [1024] u8; fbn := hs_cat(fb[..], 0, cast(string) cwd_b[0..<cbn]); fbn = hs_cat(fb[..], fbn, "|OpenAgents TUI");
        dm_ext_push_meta(v, cast(string) idb[0..<in_], cast(string) tit[0..<ttn], cast(string) fb[0..<fbn], true, true, mt);
        tui_count += 1;
      }
    }

    // 3. Other local harnesses from explicit known session roots (bounded; never global walks)
    roots := [3] string.["/.claude/projects", "/.codex/sessions", "/.gemini/antigravity/conversations"];
    hnames := [3] string.["claude", "codex", "agy"];
    hlabels := [3] string.["Claude Code", "Codex CLI", "Antigravity"];
    for ri: 0..<3 {
      rp: [1400] u8; rlen := hs_cat(rp[..], 0, home); rlen = hs_cat(rp[..], rlen, roots[ri]);
      rdir := cast(string) rp[0..<rlen];
      if !fs_exists(rdir) { continue; }
      names: [1] FsList;
      k := fs_list(rdir, names[..]);
      added := 0;
      for i: 0..<k {
        if v[0].nmeta >= DM_META_MAX || added >= 8 { break; }
        ent := fs_entry(names[..], i);
        if ent.count == 0 || ent[0] == '.' || !dm_ext_safe_id(ent) { continue; }
        fp: [1600] u8; fn := hs_cat(fp[..], 0, rdir); fn = hs_cat(fp[..], fn, "/"); fn = hs_cat(fp[..], fn, ent);
        mt := fs_mtime_ns(cast(string) fp[0..<fn]) / 1000000000;
        idb: [128] u8; in_ := hs_cat(idb[..], 0, "harness:"); in_ = hs_cat(idb[..], in_, hnames[ri]);
        in_ = hs_cat(idb[..], in_, ":"); in_ = hs_cat(idb[..], in_, ent);
        tit: [256] u8; ttn := hs_cat(tit[..], 0, ent);
        ttn = hs_cat(tit[..], ttn, "|"); ttn = hs_cat(tit[..], ttn, hnames[ri]);
        ttn = hs_cat(tit[..], ttn, "|idle|");
        fb: [1024] u8; fbn := hs_cat(fb[..], 0, rdir); fbn = hs_cat(fb[..], fbn, "|"); fbn = hs_cat(fb[..], fbn, hlabels[ri]);
        dm_ext_push_meta(v, cast(string) idb[0..<in_], cast(string) tit[0..<ttn], cast(string) fb[0..<fbn], false, true, mt);
        harness_count += 1;
        added += 1;
      }
    }
  }

  o: [1] Jo; jb: [512] u8; jo_start(o[..], jb[..]);
  jo_obj(o[..]);
  jo_key(o[..], "tui_count"); jo_int(o[..], tui_count);
  jo_key(o[..], "harness_count"); jo_int(o[..], harness_count);
  jo_end(o[..]);
  if !o[0].bad { v[0].foreman[0].np = ea_copy(v[0].foreman[0].prompt[..], cast(string) jb[0..<o[0].n]); }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14068: ReadIntrospection — capture tmux pane scrollback or TUI/harness tail safely.
dm_ext_read_introspection :: (q: [] DmRequest, v: [] DmView) {
  sid := cast(string) q[0].session[0..<q[0].ns];
  if sid.count < 5 { dm_fail(v, "malformed"); return; }
  content_buf: [24576] u8;
  cn := 0;

  if ws_has_prefix(sid, "tui:tmux:") {
    target := cast(string) sid[9..<sid.count];
    if !dm_ext_tmux_target_ok(target) { dm_fail(v, "malformed"); return; }
    tb: [1024] u8;
    tmux := ph_find_on_path("tmux", tb[..]);
    if tmux.count == 0 { dm_fail(v, "not_found"); return; }
    p := proc_new();
    if p < 0 { dm_fail(v, "unavailable"); return; }
    defer { _ = proc_release(p); }
    ok := proc_arg(p, tmux) && proc_arg(p, "capture-pane") && proc_arg(p, "-p")
      && proc_arg(p, "-t") && proc_arg(p, target) && proc_arg(p, "-S") && proc_arg(p, "-120");
    if !ok || proc_start(p) != 0 { dm_fail(v, "operation_failed"); return; }
    _ = proc_close_stdin(p);
    deadline := proc_now_ms() + 2000;
    while proc_now_ms() < deadline && cn < content_buf.count - 2 {
      left := proc_left(deadline, proc_now_ms());
      ln := cxproc_read_line(p, ifx left > 200 then 200 else left);
      if ln == PROC_TIMEOUT { continue; }
      if ln < 0 { break; }
      for i: 0..<ln {
        if cn < content_buf.count - 2 { content_buf[cn] = cast(u8) cxproc_line_byte(p, i); cn += 1; }
      }
      if cn < content_buf.count - 1 { content_buf[cn] = 10; cn += 1; }
    }
    _ = proc_wait(p, 300);
  } else if ws_has_prefix(sid, "tui:oa:") {
    stem := cast(string) sid[7..<sid.count];
    if !dm_ext_safe_id(stem) { dm_fail(v, "malformed"); return; }
    hb: [1024] u8; home := ph_home(hb[..]);
    if home.count == 0 { dm_fail(v, "unavailable"); return; }
    fp: [1600] u8; fn := hs_cat(fp[..], 0, home); fn = hs_cat(fp[..], fn, "/.openagents/tui/sessions/");
    fn = hs_cat(fp[..], fn, stem); fn = hs_cat(fp[..], fn, ".json");
    rn := fs_read(cast(string) fp[0..<fn], content_buf[..]);
    if rn > 0 { cn = rn; }
  } else if ws_has_prefix(sid, "harness:") {
    cn = hs_cat(content_buf[..], 0, "External local harness session: ");
    cn = hs_cat(content_buf[..], cn, sid);
    cn = hs_cat(content_buf[..], cn, "\nType a prompt below to dispatch a command to this session over Tailscale.");
  } else {
    dm_fail(v, "not_found");
    return;
  }

  first := ifx cn > 4000 then 4000 else cn;
  v[0].foreman[0].np = ea_copy(v[0].foreman[0].prompt[..], cast(string) content_buf[0..<first]);
  off := first;
  chunk_idx := 1;
  while off < cn && v[0].nmeta < DM_META_MAX {
    take := ifx cn - off > 1000 then 1000 else cn - off;
    cb: [32] u8; ci := hs_cat(cb[..], 0, "chunk:"); ci = hs_cat(cb[..], ci, hs_itoa(chunk_idx, cb[ci..<cb.count]));
    dm_ext_push_meta(v, cast(string) cb[0..<ci], "chunk", cast(string) content_buf[off..<off + take], false, false, off);
    off += take;
    chunk_idx += 1;
  }
  v[0].nst = ea_copy(v[0].status[..], "ready");
}

// #14068: SendSessionCommand — borderless direct command dispatch over Tailscale to tmux/TUI/harness sessions.
dm_ext_send_session_command :: (h: [] HsHost, q: [] DmRequest, v: [] DmView) {
  sid := cast(string) q[0].session[0..<q[0].ns];
  prompt := cast(string) q[0].text[0..<q[0].nt];
  mode := ifx q[0].ntl > 0 then cast(string) q[0].title[0..<q[0].ntl] else "send";
  if sid.count < 5 { dm_fail(v, "malformed"); return; }
  if mode != "stop" && prompt.count == 0 { dm_fail(v, "malformed"); return; }

  if ws_has_prefix(sid, "tui:tmux:") {
    target := cast(string) sid[9..<sid.count];
    if !dm_ext_tmux_target_ok(target) { dm_fail(v, "malformed"); return; }
    tb: [1024] u8;
    tmux := ph_find_on_path("tmux", tb[..]);
    if tmux.count == 0 { dm_fail(v, "not_found"); return; }
    if mode == "stop" {
      p := proc_new();
      if p < 0 { dm_fail(v, "unavailable"); return; }
      defer { _ = proc_release(p); }
      ok := proc_arg(p, tmux) && proc_arg(p, "send-keys") && proc_arg(p, "-t") && proc_arg(p, target) && proc_arg(p, "C-c");
      if !ok || proc_start(p) != 0 { dm_fail(v, "operation_failed"); return; }
      _ = proc_wait(p, 1500);
      v[0].nst = ea_copy(v[0].status[..], "stopped");
      return;
    }
    p := proc_new();
    if p < 0 { dm_fail(v, "unavailable"); return; }
    defer { _ = proc_release(p); }
    ok := proc_arg(p, tmux) && proc_arg(p, "send-keys") && proc_arg(p, "-t") && proc_arg(p, target);
    if mode != "keys" { ok = ok && proc_arg(p, "-l"); }
    ok = ok && proc_arg(p, prompt);
    if !ok || proc_start(p) != 0 { dm_fail(v, "operation_failed"); return; }
    _ = proc_wait(p, 1500);
    if mode != "keys" {
      p2 := proc_new();
      if p2 >= 0 {
        defer { _ = proc_release(p2); }
        ok2 := proc_arg(p2, tmux) && proc_arg(p2, "send-keys") && proc_arg(p2, "-t") && proc_arg(p2, target) && proc_arg(p2, "Enter");
        if ok2 && proc_start(p2) == 0 { _ = proc_wait(p2, 1500); }
      }
    }
    v[0].nst = ea_copy(v[0].status[..], "dispatched");
    return;
  }

  if ws_has_prefix(sid, "harness:claude:") {
    cid := cast(string) sid[15..<sid.count];
    if !dm_ext_safe_id(cid) { dm_fail(v, "malformed"); return; }
    cb: [1024] u8;
    cbin := ph_find_on_path("claude", cb[..]);
    if cbin.count == 0 { dm_fail(v, "not_found"); return; }
    p := proc_new();
    if p < 0 { dm_fail(v, "unavailable"); return; }
    defer { _ = proc_release(p); }
    ok := proc_arg(p, cbin) && proc_arg(p, "--resume") && proc_arg(p, cid) && proc_arg(p, "-p") && proc_arg(p, prompt) && proc_arg(p, "--dangerously-skip-permissions");
    if !ok || proc_start(p) != 0 { dm_fail(v, "operation_failed"); return; }
    _ = proc_close_stdin(p);
    _ = proc_wait(p, 2000);
    v[0].nst = ea_copy(v[0].status[..], "dispatched");
    return;
  }

  if ws_has_prefix(sid, "harness:codex:") {
    cid := cast(string) sid[14..<sid.count];
    if !dm_ext_safe_id(cid) { dm_fail(v, "malformed"); return; }
    cb: [1024] u8;
    cbin := ph_find_on_path("codex", cb[..]);
    if cbin.count == 0 { dm_fail(v, "not_found"); return; }
    p := proc_new();
    if p < 0 { dm_fail(v, "unavailable"); return; }
    defer { _ = proc_release(p); }
    ok := proc_arg(p, cbin) && proc_arg(p, "exec") && proc_arg(p, "resume") && proc_arg(p, cid) && proc_arg(p, prompt);
    if !ok || proc_start(p) != 0 { dm_fail(v, "operation_failed"); return; }
    _ = proc_close_stdin(p);
    _ = proc_wait(p, 2000);
    v[0].nst = ea_copy(v[0].status[..], "dispatched");
    return;
  }

  dm_fail(v, "not_found");
}

dm_agy_execute :: (h: [] HsHost, q: [] DmRequest, v: [] DmView) -> bool {
  m := cast(string) q[0].method[0..<q[0].nm];
  if m == "ListArtifacts" { dm_ext_list_artifacts(q, v); return true; }
  if m == "ReadArtifact" { dm_ext_read_artifact(q, v); return true; }
  if m == "ReadSwarm" { dm_ext_read_swarm(h, q, v); return true; }
  if m == "ListAutomations" { dm_ext_list_automations(v); return true; }
  if m == "ToggleAutomation" { dm_ext_toggle_automation(q, v); return true; }
  if m == "RunAutomation" { dm_ext_run_automation(h, q, v); return true; }
  if m == "ReadAntigravityConfig" { dm_ext_read_agy_config(h, v); return true; }
  if m == "UpdateAntigravityConfig" { dm_ext_update_agy_config(h, q, v); return true; }
  if m == "GetUsage" { dm_ext_get_usage(h, v); return true; }
  if m == "ListIntrospection" { dm_ext_list_introspection(h, v); return true; }
  if m == "ReadIntrospection" { dm_ext_read_introspection(q, v); return true; }
  if m == "SendSessionCommand" { dm_ext_send_session_command(h, q, v); return true; }
  return false;
}

dm_ext_hex_digit :: (v: u8) -> u8 {
  if v < 10 { return '0' + v; }
  return 'A' + (v - 10);
}

dm_ext_url_encode :: (dst: [] u8, at: int, s: string) -> int {
  n := at;
  for i: 0..<s.count {
    b := s[i];
    unreserved := (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') || b == '-' || b == '.' || b == '_' || b == '~';
    if unreserved {
      if n < dst.count { dst[n] = b; n += 1; }
    } else if n + 3 <= dst.count {
      dst[n] = '%';
      dst[n + 1] = dm_ext_hex_digit((b >> 4) & 0xF);
      dst[n + 2] = dm_ext_hex_digit(b & 0xF);
      n += 3;
    }
  }
  return n;
}

dm_ext_tailscale_bin :: () -> string #effects(all) {
  if fs_kind("/Applications/Tailscale.app/Contents/MacOS/Tailscale") == FS_FILE {
    return "/Applications/Tailscale.app/Contents/MacOS/Tailscale";
  }
  if fs_kind("/opt/homebrew/bin/tailscale") == FS_FILE { return "/opt/homebrew/bin/tailscale"; }
  if fs_kind("/usr/local/bin/tailscale") == FS_FILE { return "/usr/local/bin/tailscale"; }
  if fs_kind("/usr/bin/tailscale") == FS_FILE { return "/usr/bin/tailscale"; }
  return "tailscale";
}

dm_cmd_pair_url :: (args: [] Args) -> int {
  addr: [256] u8; an := ea_copy(addr[..], args_value(args, "--address", ""));
  name: [128] u8; nn := ea_copy(name[..], args_value(args, "--name", ""));
  if an == 0 || nn == 0 {
    out: [16384] u8;
    p := proc_new();
    out_n := 0;
    if p >= 0 {
      defer { _ = proc_release(p); }
      ok := proc_arg(p, dm_ext_tailscale_bin()) && proc_arg(p, "status") && proc_arg(p, "--peers=false") && proc_arg(p, "--json");
      ok = ok && proc_env(p, "TAILSCALE_BE_CLI=1") && proc_env(p, "TERM=dumb") && proc_env(p, "BROWSER=/usr/bin/true");
      if ok && proc_start(p) == 0 {
        _ = proc_close_stdin(p);
        deadline := proc_now_ms() + 4000;
        while proc_now_ms() < deadline {
          left := proc_left(deadline, proc_now_ms());
          ln := cxproc_read_line(p, ifx left > 200 then 200 else left);
          if ln == PROC_TIMEOUT { continue; }
          if ln < 0 { break; }
          for i: 0..<ln { if out_n < out.count { out[out_n] = cast(u8) cxproc_line_byte(p, i); out_n += 1; } }
          if out_n < out.count { out[out_n] = 10; out_n += 1; }
        }
        if proc_wait(p, 500) != 0 { out_n = 0; }
      }
    }
    if out_n > 2 {
      raw := cast(string) out[0..<out_n];
      nodes: [2048] JvNode; d: [1] Jv;
      if jv_parse(d[..], raw, nodes[..]) && jv_kind(d[0], 0) == JV_OBJECT {
        self_n := jv_get(d[0], 0, "Self");
        if self_n >= 0 && jv_kind(d[0], self_n) == JV_OBJECT {
          if an == 0 {
            dns := jv_str(d[0], jv_get(d[0], self_n, "DNSName"), addr[..]);
            if dns > 0 {
              if addr[dns - 1] == '.' { dns -= 1; }
              an = dns;
            }
          }
          if an == 0 {
            ips := jv_get(d[0], self_n, "TailscaleIPs");
            if ips >= 0 && jv_kind(d[0], ips) == JV_ARRAY && jv_len(d[0], ips) > 0 {
              an = jv_str(d[0], jv_at(d[0], ips, 0), addr[..]);
              if an < 0 { an = 0; }
            }
          }
          if nn == 0 {
            nn = jv_str(d[0], jv_get(d[0], self_n, "HostName"), name[..]);
            if nn < 0 { nn = 0; }
          }
        }
      }
    }
  }
  if an == 0 { an = ea_copy(addr[..], "127.0.0.1"); }
  if nn == 0 { nn = ea_copy(name[..], "OpenAgents-Host"); }
  port := args_value(args, "--port", "47109");
  url: [1024] u8; un := hs_cat(url[..], 0, "openagents://pair?address=");
  un = dm_ext_url_encode(url[..], un, cast(string) addr[0..<an]);
  un = hs_cat(url[..], un, "&port=");
  un = dm_ext_url_encode(url[..], un, port);
  un = hs_cat(url[..], un, "&name=");
  un = dm_ext_url_encode(url[..], un, cast(string) name[0..<nn]);
  hs_outln(cast(string) url[0..<un]);
  return 0;
}

#test "antigravity control-plane helper guards refuse path traversal and classify artifacts (#14014, #14068)" {
  #assert dm_ext_safe_id("implementation_plan.md") && !dm_ext_safe_id("../secret") && !dm_ext_safe_id("a/b") && !dm_ext_safe_id("");
  #assert dm_ext_tmux_target_ok("main:0.1") && dm_ext_tmux_target_ok("dev_1:2.0") && !dm_ext_tmux_target_ok("-rf") && !dm_ext_tmux_target_ok("a;rm") && !dm_ext_tmux_target_ok("");
  #assert dm_ext_parse_int("4200", -1) == 4200 && dm_ext_parse_int("-5", 0) == -5 && dm_ext_parse_int("bad", 9) == 9;
  #assert dm_ext_artifact_kind("implementation_plan.md") == "plan|Implementation Plan";
  #assert dm_ext_artifact_kind("widget.html") == "html|Generative UI Widget";
  #assert dm_ext_artifact_kind("shot.png") == "image|Screenshot Artifact";
  buf: [128] u8;
  n := dm_ext_url_encode(buf[..], 0, "Mac Book (2)&x=1");
  #assert cast(string) buf[0..<n] == "Mac%20Book%20%282%29%26x%3D1";
}
