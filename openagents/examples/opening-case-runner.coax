// Runnable example for The OpenAgents Book Chapter 6: One case, every step.
// Joins the opening chapters (1-5) into one end-to-end acceptance runner over
// the real shared modules:
//   - apps/shared/chat/screen.coax (GPU composer, actions, Markdown transcript, scroll, duplicate-ID refusal)
//   - apps/shared/app/login/flow.coax (logged-out send gate, wrong-code refusal, logout fence)
//   - apps/shared/openagents-app.coax (controlled-clock streaming, Stop fence, reconnect dedupe, logout-pending)
//   coax/bin/coax run openagents/examples/opening-case-runner.coax
//   coax/bin/coax test openagents/examples/opening-case-runner.coax
#import "Basic";
#load "../../apps/shared/chat/screen.coax";
#load "../../apps/shared/app/login/flow.coax";
#load "../../apps/shared/openagents-app.coax";

// Exact operations of openagents/examples/cases/first-milestone.ops (33 ops):
// login -> empty-send refusal -> send -> 3 streamed parts -> done -> copy -> second send -> Stop -> late parts dropped.
OCR_FIRST_MILESTONE :: "tap home.login\ntype account.email you@example.com\ntap account.submit\nclock data release auth.email_start\ntype account.code 123456\ntap account.verify\nclock data release auth.email_verify\nclock data release auth.account\ntap shell.new\ntap composer.send\ntype composer.input hello\ntap composer.send\nstate turn\nclock data release chat.send\nclock data\nclock data release chat.part\nclock data release chat.part\nclock data release chat.part\nclock data release chat.done\nstate transcript\ntree\ntap reply.copy\nstate clipboard\ntype composer.input again\ntap composer.send\nclock data release chat.send\nclock data release chat.part\ntap composer.stop\nclock data release chat.part\nclock data release chat.part\nclock data release chat.done\nstate transcript\nlogs\n";

OCR_LOGOUT_PENDING :: "tap home.login\ntype account.email you@example.com\ntap account.submit\nclock data release auth.email_start\ntype account.code 123456\ntap account.verify\nclock data release auth.email_verify\nclock data release auth.account\ntap shell.new\ntype composer.input hello\ntap composer.send\nclock data release chat.send\nclock data release chat.part\ntap shell.logout\nclock data release chat.part\nclock data release auth.logout\nstate transcript\n";

OCR_RECONNECT :: "tap home.login\ntype account.email you@example.com\ntap account.submit\nclock data release auth.email_start\ntype account.code 123456\ntap account.verify\nclock data release auth.email_verify\nclock data release auth.account\ntap shell.new\ntype composer.input hello\ntap composer.send\nclock data lose chat.send\nclock data release chat.send\nstate service.messages\n";

ocr_count_ops :: (ops: string) -> int {
  count := 0;
  for k: 0..<ops.count {
    if (k == 0 || ops[k - 1] == '\n') && ops[k] != '#' && ops[k] != '\n' { count += 1; }
  }
  return count;
}

// book:begin opening-case-replay
ocr_run_suite :: (a: [] OapApp, tr: [] OapTrace) -> bool {
  // 1. First milestone (33 ops): login, empty send refusal, streamed reply, copy, Stop fence.
  a[0] = OapApp.{}; tr[0] = OapTrace.{};
  oap_play(a, OCR_FIRST_MILESTONE, tr);
  t1 := cast(string) tr[0].t[0..<tr[0].n];
  ok1 := oap_has(t1, "composer.send can't be pressed now") &&
         oap_has(t1, "you: hello\nreply: Hello! This is a fixture reply.") &&
         oap_has(t1, "released chat.part: late part dropped") &&
         oap_has(t1, "notice: Stopped");
  print("case=first-milestone ops=% ok=%\n", ocr_count_ops(OCR_FIRST_MILESTONE), ok1);

  // 2. Logout with turn pending: late parts dropped and transcript cleared.
  a[0] = OapApp.{}; tr[0] = OapTrace.{};
  oap_play(a, OCR_LOGOUT_PENDING, tr);
  t2 := cast(string) tr[0].t[0..<tr[0].n];
  ok2 := oap_has(t2, "released chat.part: late part dropped") && oap_has(t2, "> state transcript\n(empty)\n");
  print("case=logout-pending ops=% ok=%\n", ocr_count_ops(OCR_LOGOUT_PENDING), ok2);

  // 3. Reconnect with lost answer: same operation ID stores once.
  a[0] = OapApp.{}; tr[0] = OapTrace.{};
  oap_play(a, OCR_RECONNECT, tr);
  t3 := cast(string) tr[0].t[0..<tr[0].n];
  ok3 := oap_has(t3, "lost chat.send: sent again as op-1") &&
         oap_has(t3, "released chat.send: op-1 already stored; first result") &&
         oap_has(t3, "> state service.messages\n1\n");
  print("case=reconnect ops=% ok=%\n", ocr_count_ops(OCR_RECONNECT), ok3);
  return ok1 && ok2 && ok3;
}
// book:end opening-case-replay

main :: () {
  a: [1] OapApp;
  tr: [1] OapTrace;
  cases_ok := ocr_run_suite(a[..], tr[..]);

  // 4. GPU ComposerScreen opening spine (Chapters 1-3).
  s: [1] ComposerScreen;
  o: [1] CsOut;
  cs_test_atlas(s[0].atlas[..]);
  s[0].form_factor = CHAT_FORM_DESKTOP;
  _ := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  _ = cs_dispatch(s[..], ChatAction.{kind = CS_ACT_EDIT, text = "hello"});
  _ = cs_dispatch(s[..], ChatAction.{kind = CS_ACT_SEND});
  _ = cs_dispatch(s[..], ChatAction.{kind = CS_ACT_APPEND, role = CHAT_ROLE_ASSISTANT, text = "Hello! **Exact** reply."});
  _ = cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  _ = cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, true);
  print("gpu_spine messages=% pinned=% dup_refused=%\n",
    s[0].state[0].message_count, chat_state_pinned(s[0].state[..]), s[0].surface[0].refused);

  // 5. Login gate check (Chapter 5): logged-out send opens card without clearing draft.
  l: [1] LoginFlow; q: [1] LoginRequest; r: [1] LoginResult;
  lf_begin(l[..]);
  _ = lf_take(l[..], q[..]);
  r[0] = ls_result(q[0], LS_DONE, 200, false, "", "");
  _ = lf_result(l[..], r[..]);
  asked := lf_need(l[..], 1, 0) == LF_ASKED;
  print("login_gate asked=% card_open=%\n", asked, l[0].open);

  // 6. Driver refusals: unknown control, unknown op, and secret allowlist.
  a[0] = OapApp.{};
  print("refuse_control=%\n", oap_drive(a[..], "tap composer.nope"));
  print("refuse_op=%\n", oap_drive(a[..], "layout"));
  print("refuse_secret=%\n", oap_drive(a[..], "state account.token"));
  print("all_passed=%\n", cases_ok && asked && s[0].surface[0].refused == 1);
}

#test "openagents book ch6: end-to-end opening cases, gpu spine, login gate, and driver refusals" #steps 400000000 {
  a: [1] OapApp; tr: [1] OapTrace;
  oap_play(a[..], OCR_FIRST_MILESTONE, tr[..]);
  t1 := cast(string) tr[0].t[0..<tr[0].n];
  #assert oap_has(t1, "composer.send can't be pressed now");
  #assert oap_has(t1, "you: hello\nreply: Hello! This is a fixture reply.");
  #assert oap_has(t1, "released chat.part: late part dropped") && oap_has(t1, "notice: Stopped");

  a[0] = OapApp.{}; tr[0] = OapTrace.{};
  oap_play(a[..], OCR_LOGOUT_PENDING, tr[..]);
  t2 := cast(string) tr[0].t[0..<tr[0].n];
  #assert oap_has(t2, "released chat.part: late part dropped") && oap_has(t2, "> state transcript\n(empty)\n");

  a[0] = OapApp.{}; tr[0] = OapTrace.{};
  oap_play(a[..], OCR_RECONNECT, tr[..]);
  t3 := cast(string) tr[0].t[0..<tr[0].n];
  #assert oap_has(t3, "released chat.send: op-1 already stored; first result") && oap_has(t3, "> state service.messages\n1\n");

  a[0] = OapApp.{};
  #assert oap_drive(a[..], "tap composer.nope") == "no element composer.nope on this screen (tree lists them)";
  #assert oap_starts(oap_drive(a[..], "layout"), "unknown operation 'layout'");
  #assert oap_has(oap_drive(a[..], "state account.token"), "account.token is not inspectable");
}
