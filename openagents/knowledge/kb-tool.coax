// OpenAgents Shared Knowledge Base CLI & Automated QA Eval Harness (#14058).
//
// Usage:
//   coax/web/tool.sh openagents/knowledge/kb-tool.coax build [--root DIR]
//   coax/web/tool.sh openagents/knowledge/kb-tool.coax query --q "what did we decide in episode 289?" [--root DIR] [--limit N] [--kind doc|book|transcript] [--json]
//   coax/web/tool.sh openagents/knowledge/kb-tool.coax get --target docs/transcripts/289.md [--start 1] [--lines 80] [--root DIR]
//   coax/web/tool.sh openagents/knowledge/kb-tool.coax eval [--root DIR]
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "index.coax";

KbEvalCase :: struct {
  question: string;
  expect_path: string;
  expect_kind: string;
  should_refuse: bool;
}

kb_parse_int :: (s: string, fallback: int) -> int {
  if s.count == 0 { return fallback; }
  v := 0;
  for i: 0..<s.count {
    c := s[i];
    if c < '0' || c > '9' { return fallback; }
    v = v * 10 + cast(int) (c - '0');
  }
  return v;
}

kb_run_eval :: (idx: [] KbIndex) -> int {
  cases := [12] KbEvalCase.[
    KbEvalCase.{ question = "what did we decide in episode 289?", expect_path = "docs/transcripts/289.md", expect_kind = "transcript", should_refuse = false },
    KbEvalCase.{ question = "episode 290 enter the verse", expect_path = "docs/transcripts/290.md", expect_kind = "transcript", should_refuse = false },
    KbEvalCase.{ question = "how does Coax #authority work?", expect_path = "coax/book/", expect_kind = "book", should_refuse = false },
    KbEvalCase.{ question = "NIP-KB entry version 3190 head 30190 withdrawal 3191", expect_path = "NIP-KB.md", expect_kind = "doc", should_refuse = false },
    KbEvalCase.{ question = "shared knowledge base retrieval by meaning openagents book", expect_path = "openagents/book/", expect_kind = "book", should_refuse = false },
    KbEvalCase.{ question = "BM25 reciprocal rank fusion book search psionic", expect_path = "psionic/book/", expect_kind = "book", should_refuse = false },
    KbEvalCase.{ question = "worktree isolation origin/main desktop minimal AGENTS", expect_path = "AGENTS.md", expect_kind = "doc", should_refuse = false },
    KbEvalCase.{ question = "System One Front RoutePlan router decision", expect_path = "coder/book/ch013-choose-an-engine.md", expect_kind = "book", should_refuse = false },
    KbEvalCase.{ question = "Repository Map Build Test Command Reference Shared asset library", expect_path = "docs/REPO-MAP.md", expect_kind = "doc", should_refuse = false },
    KbEvalCase.{ question = "BIP-340 Schnorr signature verification bitcoin book", expect_path = "bitcoin/book/", expect_kind = "book", should_refuse = false },
    KbEvalCase.{ question = "Breez Spark Lightning x402 payment receiver", expect_path = "NIP-X402.md", expect_kind = "doc", should_refuse = false },
    KbEvalCase.{ question = "authentic Neapolitan sourdough focaccia tiramisu gelato recipe", expect_path = "", expect_kind = "", should_refuse = true },
  ];

  res: [1] KbQueryResult;
  passed := 0;
  failed := 0;
  max_lat := 0;
  sum_lat := 0;

  print("KB Eval: indexed % files, % chunks\n", idx[0].nfiles, idx[0].nchunks);
  for i: 0..<cases.count {
    c := cases[i];
    nh := kb_search(idx, c.question, 5, "", res[..]);
    lat := res[0].latency_ms;
    if lat > max_lat { max_lat = lat; }
    sum_lat += lat;

    ok := false;
    top_p := ifx nh > 0 then res[0].hits[0].hit.source_path else "<refused>";
    matched_rank := 0;
    if c.should_refuse {
      ok = nh == 0 && lat < 500;
    } else {
      for r: 0..<nh {
        if r >= 3 { break; }
        h := res[0].hits[r].hit;
        if kb_rec_contains(h.source_path, c.expect_path) && h.digest.count == 64 && h.start_line >= 1 {
          ok = true;
          matched_rank = r + 1;
          top_p = h.source_path;
          break;
        }
      }
      if lat >= 500 { ok = false; }
    }

    if ok {
      passed += 1;
      print("  PASS [%/%] (% ms, rank %) \"%\" -> %\n", i + 1, cases.count, lat, matched_rank, c.question, top_p);
    } else {
      failed += 1;
      print("  FAIL [%/%] (% ms) \"%\" expected=% got=% (nh=%)\n", i + 1, cases.count, lat, c.question, c.expect_path, top_p, nh);
      for r: 0..<nh {
        if r >= 3 { break; }
        h := res[0].hits[r].hit;
        print("       #% %:%-% (score=%, lex=%, sem=%) %\n", r + 1, h.source_path, h.start_line, h.end_line, h.score_milli, h.lexical_milli, h.semantic_milli, h.heading);
      }
    }
  }
  avg_lat := sum_lat / cases.count;
  print("Summary: %/% passed, max_latency=% ms, avg_latency=% ms (budget <500 ms)\n", passed, cases.count, max_lat, avg_lat);
  return ifx failed == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) {
    tool_errln("kb-tool: failed to load arguments");
    return 2;
  }
  argc := args_count(a[..]);
  if argc < 1 {
    print("usage: kb-tool <build|query|get|eval> [--root DIR] [--q QUERY] [--target PATH_OR_ID] [--limit N] [--kind K] [--json]\n");
    return 2;
  }

  cmd := args_at(a[..], 0);
  if cmd == "selftest" {
    if !kb_selftest_fs() {
      tool_errln("FAIL kb-tool selftest");
      return 1;
    }
    print("OK kb-tool selftest (build, hybrid search, citation digest, refusal, KnowledgeGet, cache round-trip)\n");
    return 0;
  }
  cwd_b: [FS_PATH_MAX] u8;
  root := fs_cwd(cwd_b[..]);
  query := "";
  target := "";
  kind := "";
  limit := 5;
  start_line := 1;
  max_lines := 100;
  as_json := false;
  rebuild := false;

  i := 1;
  while i < argc {
    arg := args_at(a[..], i);
    if arg == "--root" && i + 1 < argc { root = args_at(a[..], i + 1); i += 2; }
    else if (arg == "--q" || arg == "--query") && i + 1 < argc { query = args_at(a[..], i + 1); i += 2; }
    else if arg == "--target" && i + 1 < argc { target = args_at(a[..], i + 1); i += 2; }
    else if arg == "--kind" && i + 1 < argc { kind = args_at(a[..], i + 1); i += 2; }
    else if arg == "--limit" && i + 1 < argc { limit = kb_parse_int(args_at(a[..], i + 1), 5); i += 2; }
    else if arg == "--start" && i + 1 < argc { start_line = kb_parse_int(args_at(a[..], i + 1), 1); i += 2; }
    else if arg == "--lines" && i + 1 < argc { max_lines = kb_parse_int(args_at(a[..], i + 1), 100); i += 2; }
    else if arg == "--json" { as_json = true; i += 1; }
    else if arg == "--rebuild" { rebuild = true; i += 1; }
    else { i += 1; }
  }

  idx: [1] KbIndex;
  t_load := proc_now_ms();
  if !kb_build_or_load(idx[..], root, cmd == "build" || rebuild) {
    tool_errln("kb-tool: failed to build or load knowledge index");
    return 1;
  }
  load_ms := proc_now_ms() - t_load;

  if cmd == "build" {
    print("OK built knowledge index: % files, % chunks, % vocab terms, % postings (% ms)\n",
          idx[0].nfiles, idx[0].nchunks, idx[0].nvocab, idx[0].nposts, load_ms);
    return 0;
  }

  if cmd == "eval" {
    print("Index ready in % ms\n", load_ms);
    return kb_run_eval(idx[..]);
  }

  if cmd == "get" {
    if target.count == 0 { tool_errln("kb-tool get: --target required"); return 2; }
    out: [32768] u8;
    n := kb_get_entry_json(idx[..], target, start_line, max_lines, out[..]);
    if n <= 0 { tool_errln("kb-tool get: entry not found"); return 1; }
    print("%\n", cast(string) out[0..<n]);
    return 0;
  }

  if cmd == "query" {
    if query.count == 0 { tool_errln("kb-tool query: --q required"); return 2; }
    res: [1] KbQueryResult;
    nh := kb_search(idx[..], query, limit, kind, res[..]);
    if as_json {
      out: [65536] u8;
      jn := kb_format_result_json(query, res[..], out[..]);
      if jn <= 0 { tool_errln("kb-tool query: JSON serialization overflow"); return 1; }
      print("%\n", cast(string) out[0..<jn]);
      return 0;
    }
    if nh == 0 {
      print("% (% ms, load % ms)\n", KB_REFUSE_MSG, res[0].latency_ms, load_ms);
      return 0;
    }
    print("Query: \"%\" (% hits, % ms search, % ms load, % files / % chunks)\n",
          query, nh, res[0].latency_ms, load_ms, res[0].indexed_files, res[0].indexed_chunks);
    for hi: 0..<nh {
      h := res[0].hits[hi].hit;
      print("  [% ] %:%-% [%] (% | % | score=% lex=% sem=%)\n      %\n      %\n",
            hi + 1, h.source_path, h.start_line, h.end_line, h.entry_id,
            kb_rec_kind_name(h.kind), bs_status_name(h.doc_status),
            h.score_milli, h.lexical_milli, h.semantic_milli, h.heading, h.snippet);
    }
    return 0;
  }

  tool_errln("kb-tool: unknown command");
  return 2;
}
