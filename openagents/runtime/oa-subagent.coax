// OpenAgents Subagent Runtime for oa-worker (#14096).
// Implements:
//   - Custom Markdown+frontmatter agent discovery (.openagents/agents/*.md, .claude/agents/*.md)
//     merged with built-ins via 6-tier precedence (flawed_agent_source_overrides).
//   - Parallel Agent tool batching over MWW_DELEGATE (wait_all=true) + MWW_RESULTS handling.
//   - Background subagent launch (async_launched) + SendMessage + TaskStop + TaskOutput.
//   - Sidechain transcript persistence (<home>/.openagents/subagents/agent-<id>.{meta.json,jsonl}).
//   - Per-subagent & session Git worktree isolation with fail-closed cleanup
//     (flawed_wt_validate_slug, flawed_wt_flatten_slug, flawed_wt_subagent_can_delete, flawed_wt_exit_allowed).

FWW_MAX_DELEGATE_BATCH :: 12;
FWW_MAX_SUBAGENT_RECS  :: 24;

FwSubagentRec :: struct {
  active: bool;
  running: bool;
  failed: bool;
  is_bg: bool;
  one_shot: bool;
  read_only: bool;
  host_num: int;                          // 1-based host subagent index (for MWW_STOP_AGENT / resume)
  git: [8] u8; ngit: int;                 // its git rule, kept for when the chat resumes it (#14104)
  level: [12] u8; nlevel: int;            // where it ran (neon, inkling, or a Claude level), kept for the same reason
  perm_mode: [24] u8; nperm_mode: int;    // effective permissionMode persisted for disk-backed resume (#14122)
  max_turns: int;                         // frontmatter maxTurns ceiling persisted for resume (#14123)
  memory_scope: int;                      // frontmatter OA_AGENT_MEM_* scope persisted for resume (#14123)
  session_id: [128] u8; nsession_id: int; // owning session ID for session-scoped sidechain persistence (#14122)
  parent_uuid: [64] u8; nparent_uuid: int;// latest DAG leaf uuid for append-only chaining (#14122)
  output_file_size_before: int;           // file size before child launch so parent only appends fallback if child didn't (#14122)
  start_ms: int;
  agent_id: [48] u8; nagent_id: int;
  name: [64] u8; nname: int;
  subagent_type: [32] u8; nsubagent_type: int;
  desc: [160] u8; ndesc: int;
  wt_path: [256] u8; nwt_path: int;
  wt_branch: [96] u8; nwt_branch: int;
  orig_head: [64] u8; norig_head: int;
  output_file: [512] u8; noutput_file: int;
  last_prompt: [4096] u8; nlast_prompt: int;
  last_reply: [4096] u8; nlast_reply: int;
}

FwDelegateSlot :: struct {
  tool_idx: int;
  rec_idx: int;
  is_bg: bool;
}

FwLocalSubProc :: struct {
  active: bool;
  done: bool;
  is_bg: bool;
  h: int;
  rec_idx: int;
  tool_idx: int;
  calls: int;
  tokens: int;
  exit_c: int;
  reply: [4096] u8; nreply: int;
}

fww_self_worker_bin :: (out: [] u8) -> string {
  eb := fww_trim(cl_getenv("OA_WORKER_BIN", out));
  if eb.count > 0 { return eb; }
  self_p := tool_self(out);
  if self_p.count > 0 { return self_p; }
  n := fww_keep(out, "oa-worker");
  return cast(string) out[0..<n];
}

fww_hist_msg_text :: (h: [] FwHist, idx: int) -> string {
  if idx < 0 || idx >= h[0].nmsgs { return ""; }
  for bi: 0..<h[0].msgs[idx].nblocks {
    if h[0].msgs[idx].blocks[bi].kind == FWW_MB_TEXT {
      return fww_slab_str(h, h[0].msgs[idx].blocks[bi].text_at, h[0].msgs[idx].blocks[bi].text_n);
    }
  }
  return "";
}

// Checks 2-tier compaction-resistant recursion guard across parent history + flag.
fww_fork_guard_tripped :: (r: [] FwRun, h: [] FwHist) -> bool {
  if r[0].is_fork_child { return true; }
  for i: 0..<h[0].nmsgs {
    if oa_agent_fork_blocked(false, fww_hist_msg_text(h, i)) { return true; }
  }
  return false;
}

// Pure serializer for cache-exact FORK_AGENT context snapshot (#14120).
// Captures parent's exact rendered sys_prompt, packs_mask, model, effort, thinking config,
// allowed/disallowed tools, observation-mask state, full structured FwHist messages (text,
// thinking+sig, tool_use+id/name/args/sig, tool_result+id/name/text/is_error/image), and
// ordered sibling_tools [{id, name}] for 1-to-1 paired TOOL_RESULTS placeholder hydration.
fww_format_fork_context_json :: (
  r: [] FwRun,
  cfg: [] FwConfig,
  h: [] FwHist,
  sib_ids: [] string,
  sib_names: [] string,
  out_json: [] u8
) -> int {
  if r.count < 1 || cfg.count < 1 || h.count < 1 || out_json.count == 0 { return 0; }
  eff_s := ifx r[0].nlast_sent_effort > 0
           then cast(string) r[0].last_sent_effort[0..<r[0].nlast_sent_effort]
           else cast(string) r[0].effort[0..<r[0].neffort];
  think_mode := ifx r[0].last_sent_has_snapshot then r[0].last_sent_thinking_mode else cfg[0].thinking_mode;
  loc_mtok := ifx r[0].last_sent_has_snapshot then r[0].last_sent_local_max_tokens else cfg[0].local_max_tokens;
  o: [1] Jo;
  jo_start(o[..], out_json);
  jo_obj(o[..]);
  jo_key(o[..], "version"); jo_int(o[..], 2);
  jo_key(o[..], "sys_prompt"); jo_str(o[..], cast(string) r[0].sys_prompt[0..<r[0].nsys]);
  jo_key(o[..], "packs_mask"); jo_int(o[..], r[0].last_packs_mask);
  jo_key(o[..], "model"); jo_str(o[..], cast(string) r[0].model[0..<r[0].nmodel]);
  jo_key(o[..], "effort"); jo_str(o[..], eff_s);
  jo_key(o[..], "thinking_mode"); jo_int(o[..], think_mode);
  jo_key(o[..], "local_max_tokens"); jo_int(o[..], loc_mtok);
  jo_key(o[..], "allowed_tools"); jo_str(o[..], cast(string) cfg[0].allowed_tools[0..<cfg[0].nallowed]);
  jo_key(o[..], "disallowed_tools"); jo_str(o[..], cast(string) cfg[0].disallowed_tools[0..<cfg[0].ndisallowed]);
  jo_key(o[..], "exp_obs_mask"); jo_bool(o[..], h[0].exp_obs_mask);
  jo_key(o[..], "exp_obs_mask_c_pct"); jo_int(o[..], h[0].exp_obs_mask_c_pct);
  jo_key(o[..], "last_cloud_turn_ms"); jo_int(o[..], h[0].last_cloud_turn_ms);
  jo_key(o[..], "last_cached_tok"); jo_int(o[..], h[0].last_cached_tok);

  jo_key(o[..], "messages"); jo_arr(o[..]);
  for i: 0..<h[0].nmsgs {
    msg := h[0].msgs[i];
    role_s := ifx msg.role == FWW_MROLE_USER then "user"
              else ifx msg.role == FWW_MROLE_ASSISTANT then "assistant"
              else ifx msg.role == FWW_MROLE_TOOL_RESULTS then "tool_results"
              else "";
    if role_s.count == 0 { continue; }
    jo_obj(o[..]);
    jo_key(o[..], "role"); jo_str(o[..], role_s);
    jo_key(o[..], "blocks"); jo_arr(o[..]);
    for bi: 0..<msg.nblocks {
      bk := msg.blocks[bi];
      k_s := ifx bk.kind == FWW_MB_TEXT then "text"
             else ifx bk.kind == FWW_MB_THINK then "thinking"
             else ifx bk.kind == FWW_MB_TOOL_USE then "tool_use"
             else ifx bk.kind == FWW_MB_TOOL_RES then "tool_result"
             else "";
      if k_s.count == 0 { continue; }
      jo_obj(o[..]);
      jo_key(o[..], "kind"); jo_str(o[..], k_s);
      if bk.id_n > 0 { jo_key(o[..], "id"); jo_str(o[..], fww_slab_str(h, bk.id_at, bk.id_n)); }
      if bk.name_n > 0 { jo_key(o[..], "name"); jo_str(o[..], fww_slab_str(h, bk.name_at, bk.name_n)); }
      jo_key(o[..], "text"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
      if bk.sig_n > 0 { jo_key(o[..], "sig"); jo_str(o[..], fww_slab_str(h, bk.sig_at, bk.sig_n)); }
      if bk.img_n > 0 && bk.img_mime_n > 0 {
        jo_key(o[..], "img_mime"); jo_str(o[..], fww_slab_str(h, bk.img_mime_at, bk.img_mime_n));
        jo_key(o[..], "img"); jo_str(o[..], fww_slab_str(h, bk.img_at, bk.img_n));
      }
      if bk.kind == FWW_MB_TOOL_RES { jo_key(o[..], "is_error"); jo_bool(o[..], bk.is_error); }
      jo_end(o[..]);
    }
    jo_end(o[..]);
    jo_end(o[..]);
  }
  jo_end(o[..]);

  // Ordered sibling_tools matching every TOOL_USE in the trailing ASSISTANT message so
  // fww_msg_tools_valid passes 1-to-1 in the forked child (falling back to explicit args).
  jo_key(o[..], "sibling_tools"); jo_arr(o[..]);
  emitted_sibs := 0;
  if h[0].nmsgs > 0 && h[0].msgs[h[0].nmsgs - 1].role == FWW_MROLE_ASSISTANT {
    last_m := h[0].msgs[h[0].nmsgs - 1];
    for bi: 0..<last_m.nblocks {
      bk := last_m.blocks[bi];
      if bk.kind != FWW_MB_TOOL_USE { continue; }
      jo_obj(o[..]);
      jo_key(o[..], "id"); jo_str(o[..], fww_slab_str(h, bk.id_at, bk.id_n));
      nm := fww_slab_str(h, bk.name_at, bk.name_n);
      jo_key(o[..], "name"); jo_str(o[..], ifx nm.count > 0 then nm else "Agent");
      jo_end(o[..]);
      emitted_sibs += 1;
    }
  }
  if emitted_sibs == 0 {
    for k: 0..<sib_ids.count {
      jo_obj(o[..]);
      jo_key(o[..], "id"); jo_str(o[..], sib_ids[k]);
      nm := ifx k < sib_names.count && sib_names[k].count > 0 then sib_names[k] else "Agent";
      jo_key(o[..], "name"); jo_str(o[..], nm);
      jo_end(o[..]);
    }
  }
  jo_end(o[..]);

  jo_end(o[..]);
  return ifx o[0].bad then 0 else o[0].n;
}

// Pure hydrator for a forked child's exact frozen prompt-cache state & structured history (#14120).
// Uses single-pass zero-allocation Json pull parsing over `messages` and `sibling_tools`, appends
// ONE FWW_MROLE_TOOL_RESULTS message with paired {id, name, text=OA_FORK_PLACEHOLDER_RESULT} blocks,
// and runs the #authority 5-component parity gate `flawed_fork_cache_parity_ok`.
fww_apply_fork_context_json :: (
  r: [] FwRun,
  cfg: [] FwConfig,
  h: [] FwHist,
  raw: string,
  scratch: [] u8
) -> bool {
  if r.count < 1 || cfg.count < 1 || h.count < 1 { return false; }
  r[0].fork_frozen = false;
  r[0].fork_parity_ok = false;
  fww_hist_clear(h);
  if raw.count < 2 || raw[0] != '{' || scratch.count == 0 { return false; }

  ar := [1] ClArena.[ClArena.{buf = scratch}];

  // 1. Frozen system prompt
  sys_v := cl_at(raw, "sys_prompt");
  has_sys := sys_v.ok && sys_v.tok == JSON_STRING;
  ar[0].at = 0; ar[0].full = false;
  sys_s := cl_text(ar[..], raw, sys_v);
  same_sys := false;
  if has_sys && !ar[0].full && sys_s.count <= r[0].sys_prompt.count {
    r[0].nsys = fww_keep(r[0].sys_prompt[..], sys_s);
    same_sys = r[0].nsys == sys_s.count;
  }

  // 2. Frozen tool packs & allow/disallow filters
  pm_v := cl_int(raw, "packs_mask");
  has_packs := pm_v.ok;
  if has_packs { r[0].fork_packs_mask = pm_v.value; }

  al_v := cl_at(raw, "allowed_tools");
  has_al := al_v.ok && al_v.tok == JSON_STRING;
  ar[0].at = 0; ar[0].full = false;
  al_s := cl_text(ar[..], raw, al_v);
  al_ok := !has_al || (!ar[0].full && al_s.count <= r[0].fork_allowed_tools.count);
  r[0].nfork_allowed_tools = ifx has_al && al_ok then fww_keep(r[0].fork_allowed_tools[..], al_s) else 0;

  dl_v := cl_at(raw, "disallowed_tools");
  has_dl := dl_v.ok && dl_v.tok == JSON_STRING;
  ar[0].at = 0; ar[0].full = false;
  dl_s := cl_text(ar[..], raw, dl_v);
  dl_ok := !has_dl || (!ar[0].full && dl_s.count <= r[0].fork_disallowed_tools.count);
  r[0].nfork_disallowed_tools = ifx has_dl && dl_ok then fww_keep(r[0].fork_disallowed_tools[..], dl_s) else 0;
  use_exact_tools := has_packs && al_ok && dl_ok;

  // 3. Frozen model
  md_v := cl_at(raw, "model");
  has_model := md_v.ok && md_v.tok == JSON_STRING;
  ar[0].at = 0; ar[0].full = false;
  md_s := cl_text(ar[..], raw, md_v);
  same_model := false;
  if has_model && !ar[0].full && md_s.count <= r[0].model.count {
    if md_s.count > 0 { r[0].nmodel = fww_keep(r[0].model[..], md_s); }
    same_model = md_s.count == 0 || cast(string) r[0].model[0..<r[0].nmodel] == md_s;
  }

  // 4. Frozen effort & thinking mode
  ef_v := cl_at(raw, "effort");
  has_eff := ef_v.ok && ef_v.tok == JSON_STRING;
  ar[0].at = 0; ar[0].full = false;
  ef_s := cl_text(ar[..], raw, ef_v);
  tm_v := cl_int(raw, "thinking_mode");
  has_tm := tm_v.ok;
  if has_tm { r[0].fork_thinking_mode = tm_v.value; } else { r[0].fork_thinking_mode = cfg[0].thinking_mode; }
  lmt_v := cl_int(raw, "local_max_tokens");
  r[0].fork_local_max_tokens = ifx lmt_v.ok then lmt_v.value else 0;
  same_thinking := false;
  if has_tm && has_eff && !ar[0].full && ef_s.count <= r[0].effort.count {
    if ef_s.count > 0 { r[0].neffort = fww_keep(r[0].effort[..], ef_s); }
    same_thinking = ef_s.count == 0 || cast(string) r[0].effort[0..<r[0].neffort] == ef_s;
  }

  // 5. Cloned observation-mask / cache metadata + verbatim structured messages + paired sibling placeholders
  om_v := cl_bool(raw, "exp_obs_mask");
  if om_v.ok { h[0].exp_obs_mask = om_v.value; }
  oc_v := cl_int(raw, "exp_obs_mask_c_pct");
  if oc_v.ok { h[0].exp_obs_mask_c_pct = oc_v.value; }
  ct_v := cl_int(raw, "last_cloud_turn_ms");
  if ct_v.ok { h[0].last_cloud_turn_ms = ct_v.value; }
  ck_v := cl_int(raw, "last_cached_tok");
  if ck_v.ok { h[0].last_cached_tok = ck_v.value; }

  msgs_raw := cl_raw(raw, "messages");
  hist_ok := false;
  if msgs_raw.count >= 2 && msgs_raw[0] == '[' {
    hist_ok = true;
    jm: [1] Json;
    cl_parse(jm[..], msgs_raw);
    if json_next(jm[..]) == JSON_ARRAY {
      a0 := [1] int.[0];
      while true {
        tm := json_next(jm[..]);
        if tm == JSON_ARRAY_END { break; }
        if tm == JSON_ERROR || tm == JSON_END { hist_ok = false; break; }
        mv := cl_value_here(jm[..]);
        if !mv.ok { hist_ok = false; break; }
        one := cl_json(msgs_raw, mv);
        if h[0].nmsgs >= FWW_MAX_MSGS { hist_ok = false; break; }

        ar[0].at = 0; ar[0].full = false;
        role_s := cl_str(ar[..], one, "role");
        role := ifx role_s == "user" then FWW_MROLE_USER
                else ifx role_s == "assistant" then FWW_MROLE_ASSISTANT
                else ifx role_s == "tool_results" then FWW_MROLE_TOOL_RESULTS
                else 0;
        if role == 0 { continue; }

        mi := h[0].nmsgs;
        h[0].msgs[mi] = FwMsg.{role = role};
        nb := 0;
        blks_raw := cl_raw(one, "blocks");
        if blks_raw.count >= 2 && blks_raw[0] == '[' {
          jb: [1] Json;
          cl_parse(jb[..], blks_raw);
          if json_next(jb[..]) == JSON_ARRAY {
            while true {
              tb := json_next(jb[..]);
              if tb == JSON_ARRAY_END { break; }
              if tb == JSON_ERROR || tb == JSON_END { hist_ok = false; break; }
              bv := cl_value_here(jb[..]);
              if !bv.ok { hist_ok = false; break; }
              if nb >= FWW_MAX_BLOCKS { hist_ok = false; break; }
              blk_s := cl_json(blks_raw, bv);

              ar[0].at = 0; ar[0].full = false;
              ks := cl_str(ar[..], blk_s, "kind");
              bkind := ifx ks == "text" then FWW_MB_TEXT
                       else ifx ks == "thinking" then FWW_MB_THINK
                       else ifx ks == "tool_use" then FWW_MB_TOOL_USE
                       else ifx ks == "tool_result" then FWW_MB_TOOL_RES
                       else 0;
              if bkind == 0 { continue; }

              err_v := cl_bool(blk_s, "is_error");
              bk := FwBlock.{kind = bkind, is_error = err_v.ok && err_v.value};

              ar[0].at = 0; ar[0].full = false;
              id_s := cl_str(ar[..], blk_s, "id");
              if ar[0].full { hist_ok = false; break; }
              if id_s.count > 0 {
                bk.id_n = fww_slab_put(h, id_s, a0[..]); bk.id_at = a0[0];
                if bk.id_n != id_s.count { hist_ok = false; break; }
              }

              ar[0].at = 0; ar[0].full = false;
              nm_s := cl_str(ar[..], blk_s, "name");
              if ar[0].full { hist_ok = false; break; }
              if nm_s.count > 0 {
                bk.name_n = fww_slab_put(h, nm_s, a0[..]); bk.name_at = a0[0];
                if bk.name_n != nm_s.count { hist_ok = false; break; }
              }

              ar[0].at = 0; ar[0].full = false;
              tx_s := cl_str(ar[..], blk_s, "text");
              if ar[0].full { hist_ok = false; break; }
              if tx_s.count > 0 {
                bk.text_n = fww_slab_put(h, tx_s, a0[..]); bk.text_at = a0[0];
                if bk.text_n != tx_s.count { hist_ok = false; break; }
              }

              ar[0].at = 0; ar[0].full = false;
              sg_s := cl_str(ar[..], blk_s, "sig");
              if ar[0].full { hist_ok = false; break; }
              if sg_s.count > 0 {
                bk.sig_n = fww_slab_put(h, sg_s, a0[..]); bk.sig_at = a0[0];
                if bk.sig_n != sg_s.count { hist_ok = false; break; }
              }

              ar[0].at = 0; ar[0].full = false;
              im_s := cl_str(ar[..], blk_s, "img_mime");
              if ar[0].full { hist_ok = false; break; }
              if im_s.count > 0 {
                bk.img_mime_n = fww_slab_put(h, im_s, a0[..]); bk.img_mime_at = a0[0];
                if bk.img_mime_n != im_s.count { hist_ok = false; break; }
              }

              ar[0].at = 0; ar[0].full = false;
              ig_s := cl_str(ar[..], blk_s, "img");
              if ar[0].full { hist_ok = false; break; }
              if ig_s.count > 0 {
                bk.img_n = fww_slab_put(h, ig_s, a0[..]); bk.img_at = a0[0];
                if bk.img_n != ig_s.count { hist_ok = false; break; }
              }

              h[0].msgs[mi].blocks[nb] = bk;
              nb += 1;
            }
          }
        }
        if !hist_ok { break; }
        if nb > 0 {
          h[0].msgs[mi].nblocks = nb;
          h[0].nmsgs += 1;
        }
      }
    } else {
      hist_ok = false;
    }
  }
  if h[0].nmsgs == 0 { hist_ok = false; }

  // Append ONE FWW_MROLE_TOOL_RESULTS message with exact paired {id, name} for every sibling_tools[k].
  sibs_raw := cl_raw(raw, "sibling_tools");
  sibs_ok := true;
  sib_nb := 0;
  if sibs_raw.count >= 2 && sibs_raw[0] == '[' {
    js: [1] Json;
    cl_parse(js[..], sibs_raw);
    if json_next(js[..]) == JSON_ARRAY {
      mi := h[0].nmsgs;
      if mi < FWW_MAX_MSGS {
        h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS};
        a0 := [1] int.[0];
        while true {
          ts := json_next(js[..]);
          if ts == JSON_ARRAY_END { break; }
          if ts == JSON_ERROR || ts == JSON_END { sibs_ok = false; break; }
          sv := cl_value_here(js[..]);
          if !sv.ok { sibs_ok = false; break; }
          if sib_nb >= FWW_MAX_BLOCKS { sibs_ok = false; break; }
          so := cl_json(sibs_raw, sv);

          ar[0].at = 0; ar[0].full = false;
          sid := cl_str(ar[..], so, "id");
          snm := cl_str(ar[..], so, "name");
          if ar[0].full { sibs_ok = false; break; }
          if snm.count == 0 { snm = "Agent"; }

          bk := FwBlock.{kind = FWW_MB_TOOL_RES, is_error = false};
          if sid.count > 0 {
            bk.id_n = fww_slab_put(h, sid, a0[..]); bk.id_at = a0[0];
            if bk.id_n != sid.count { sibs_ok = false; break; }
          }
          bk.name_n = fww_slab_put(h, snm, a0[..]); bk.name_at = a0[0];
          if bk.name_n != snm.count { sibs_ok = false; break; }
          bk.text_n = fww_slab_put(h, OA_FORK_PLACEHOLDER_RESULT, a0[..]); bk.text_at = a0[0];
          if bk.text_n != OA_FORK_PLACEHOLDER_RESULT.count { sibs_ok = false; break; }

          h[0].msgs[mi].blocks[sib_nb] = bk;
          sib_nb += 1;
        }
        if sibs_ok && sib_nb > 0 {
          h[0].msgs[mi].nblocks = sib_nb;
          h[0].nmsgs += 1;
          if mi == 0 || h[0].msgs[mi - 1].role != FWW_MROLE_ASSISTANT || !fww_msg_tools_valid(h, h[0].msgs[mi - 1], h[0].msgs[mi]) {
            sibs_ok = false;
          }
        }
      } else {
        sibs_ok = false;
      }
    } else {
      sibs_ok = false;
    }
  }
  // If trailing parent message had TOOL_USE blocks but no matching sibling placeholders were appended, parity fails.
  if sib_nb == 0 && h[0].nmsgs > 0 && h[0].msgs[h[0].nmsgs - 1].role == FWW_MROLE_ASSISTANT && fww_msg_count_tool_use(h[0].msgs[h[0].nmsgs - 1]) > 0 {
    sibs_ok = false;
  }

  cloned_replacements := hist_ok && sibs_ok;
  parity := flawed_fork_cache_parity_ok(same_sys, use_exact_tools, same_model, same_thinking, cloned_replacements);
  r[0].fork_parity_ok = parity;
  r[0].fork_frozen = parity;
  return parity;
}

// Writes cache-exact FORK_AGENT context to <home>/.openagents/subagents/fork-<aid>.json using a
// caller-supplied large buffer (e.g. FwBufs.req_body, 6 MiB) so prompts + history never truncate.
fww_write_fork_context :: (
  home: string,
  aid: string,
  r: [] FwRun,
  cfg: [] FwConfig,
  h: [] FwHist,
  sib_ids: [] string,
  sib_names: [] string,
  work_buf: [] u8,
  out_path: [] u8
) -> int {
  if home.count == 0 || aid.count == 0 || work_buf.count == 0 { return 0; }
  db: [FS_PATH_MAX] u8;
  sdir := fww_subagent_dir(home, db[..]);
  if sdir.count == 0 { return 0; }
  pn := fww_cat(out_path, 0, sdir);
  pn = fww_cat(out_path, pn, "/fork-");
  pn = fww_cat(out_path, pn, aid);
  pn = fww_cat(out_path, pn, ".json");
  path := cast(string) out_path[0..<pn];
  jn := fww_format_fork_context_json(r, cfg, h, sib_ids, sib_names, work_buf);
  if jn <= 0 { return 0; }
  if !fs_write(path, cast(string) work_buf[0..<jn]) { return 0; }
  return pn;
}

// Hydrates a forked child's frozen prompt-cache state & history from its fork context file using
// caller-supplied large buffers (e.g. FwBufs.req_body + FwBufs.compact_buf).
fww_load_fork_context :: (
  r: [] FwRun,
  cfg: [] FwConfig,
  h: [] FwHist,
  fork_path: string,
  file_buf: [] u8,
  scratch: [] u8
) -> bool {
  if fork_path.count == 0 || fs_kind(fork_path) != FS_FILE || file_buf.count == 0 || scratch.count == 0 { return false; }
  sz := fs_size(fork_path);
  if sz <= 0 || sz > file_buf.count { return false; }
  rd := fs_read(fork_path, file_buf);
  if rd != sz { return false; }
  return fww_apply_fork_context_json(r, cfg, h, cast(string) file_buf[0..<rd], scratch);
}

// ---------------------------------------------------------------- custom agent discovery

fww_load_agent_dir :: (reg: [] OaAgentRegistry, dir: string, source_tier: u8) {
  if dir.count == 0 || fs_kind(dir) != FS_DIR { return; }
  lst: [1] FsList;
  n := fs_list(dir, lst[..]);
  for i: 0..<n {
    name := fs_entry(lst[..], i);
    if !flawed_aw_ends(name, ".md") || name.count <= 3 { continue; }
    fb: [FS_PATH_MAX] u8;
    full := fs_join(dir, name, fb[..]);
    if fs_kind(full) != FS_FILE { continue; }
    buf: [8192] u8;
    rd := fs_read(full, buf[..]);
    if rd <= 0 { continue; }
    stem := cast(string) name[0..<(name.count - 3)];
    def: [1] OaAgentDef;
    if oa_agents_parse_markdown(cast(string) buf[0..<rd], stem, source_tier, def[..]) {
      _ = oa_agents_upsert(reg, def[0]);
    }
  }
}

// Splits a colon-separated directory list (e.g. OA_AGENTS_DIR / OA_PLUGIN_AGENTS_DIR / OA_POLICY_AGENTS_DIR)
// and loads *.md agent definitions from each existing directory under `source_tier` (#14123).
fww_load_agent_dirs_colon :: (reg: [] OaAgentRegistry, colon_list: string, source_tier: u8) {
  if colon_list.count == 0 { return; }
  pos := 0;
  while pos < colon_list.count {
    end := pos;
    while end < colon_list.count && colon_list[end] != ':' { end += 1; }
    seg := fww_trim(cast(string) colon_list[pos..<end]);
    if seg.count > 0 {
      fww_load_agent_dir(reg, seg, source_tier);
    }
    pos = end + 1;
  }
}

// Scans `<home>/.openagents/plugins/*/agents` for plugin-provided agent definitions (#14123).
fww_load_plugin_agent_dirs :: (reg: [] OaAgentRegistry, home: string) {
  if home.count == 0 { return; }
  p1: [FS_PATH_MAX] u8;
  plugins_dir := fs_join(home, ".openagents/plugins", p1[..]);
  if plugins_dir.count == 0 || fs_kind(plugins_dir) != FS_DIR { return; }
  lst: [1] FsList;
  n := fs_list(plugins_dir, lst[..]);
  one_b: [FS_PATH_MAX] u8;
  ag_b: [FS_PATH_MAX] u8;
  for i: 0..<n {
    en := fs_entry(lst[..], i);
    if en.count == 0 || en[0] == '.' { continue; }
    one := fs_join(plugins_dir, en, one_b[..]);
    if one.count == 0 || fs_kind(one) != FS_DIR { continue; }
    adir := fs_join(one, "agents", ag_b[..]);
    if adir.count > 0 && fs_kind(adir) == FS_DIR {
      fww_load_agent_dir(reg, adir, FLAWED_ASRC_PLUGIN);
    }
  }
}

// 6-tier agent registry loader in ascending precedence honoring #authority flawed_agent_source_overrides (#14123):
//   1. FLAWED_ASRC_BUILTIN (1): built-in personas
//   2. FLAWED_ASRC_PLUGIN  (2): <home>/.openagents/plugins/*/agents + plugin_dirs (OA_PLUGIN_AGENTS_DIR)
//   3. FLAWED_ASRC_USER    (3): <home>/.claude/agents, <home>/.openagents/agents
//   4. FLAWED_ASRC_PROJECT (4): <cwd>/.claude/agents, <cwd>/.openagents/agents
//   5. FLAWED_ASRC_FLAG    (5): flag_dirs (OA_AGENTS_DIR)
//   6. FLAWED_ASRC_POLICY  (6): /etc/openagents/agents + policy_dirs (OA_POLICY_AGENTS_DIR)
fww_load_agent_registry_ex :: (
  reg: [] OaAgentRegistry,
  cwd: string,
  home: string,
  plugin_dirs: string,
  flag_dirs: string,
  policy_dirs: string
) {
  oa_agents_init_builtins(reg);
  pb: [FS_PATH_MAX] u8;
  // Tier 2: Plugin
  fww_load_plugin_agent_dirs(reg, home);
  fww_load_agent_dirs_colon(reg, plugin_dirs, FLAWED_ASRC_PLUGIN);
  // Tier 3: User
  if home.count > 0 {
    fww_load_agent_dir(reg, fs_join(home, ".claude/agents", pb[..]), FLAWED_ASRC_USER);
    fww_load_agent_dir(reg, fs_join(home, ".openagents/agents", pb[..]), FLAWED_ASRC_USER);
  }
  // Tier 4: Project
  if cwd.count > 0 {
    fww_load_agent_dir(reg, fs_join(cwd, ".claude/agents", pb[..]), FLAWED_ASRC_PROJECT);
    fww_load_agent_dir(reg, fs_join(cwd, ".openagents/agents", pb[..]), FLAWED_ASRC_PROJECT);
  }
  // Tier 5: CLI / env flag
  fww_load_agent_dirs_colon(reg, flag_dirs, FLAWED_ASRC_FLAG);
  // Tier 6: Managed policy
  fww_load_agent_dir(reg, "/etc/openagents/agents", FLAWED_ASRC_POLICY);
  fww_load_agent_dirs_colon(reg, policy_dirs, FLAWED_ASRC_POLICY);
}

fww_load_agent_registry :: (reg: [] OaAgentRegistry, cwd: string, home: string) {
  pl_b: [2048] u8;
  fl_b: [2048] u8;
  po_b: [2048] u8;
  plugin_dirs := fww_trim(cl_getenv("OA_PLUGIN_AGENTS_DIR", pl_b[..]));
  flag_dirs := fww_trim(cl_getenv("OA_AGENTS_DIR", fl_b[..]));
  policy_dirs := fww_trim(cl_getenv("OA_POLICY_AGENTS_DIR", po_b[..]));
  fww_load_agent_registry_ex(reg, cwd, home, plugin_dirs, flag_dirs, policy_dirs);
}

// ---------------------------------------------------------------- agent memory prompt formatting & injection (#14123)

// Pure formatter for `# Agent Memory (<mem_dir>)` + existing `MEMORY.md` truncated via #authority
// `flawed_truncate_memory_entrypoint(..., FLAWED_MAX_ENTRYPOINT_LINES, FLAWED_MAX_ENTRYPOINT_BYTES)`.
fww_format_agent_memory_section :: (mem_dir: string, read_only: bool, existing_md: string, out: [] u8, at: int) -> int {
  if mem_dir.count == 0 || !flawed_validate_memory_path(mem_dir) { return at; }
  n := fww_cat(out, at, "\n\n# Agent Memory (");
  n = fww_cat(out, n, mem_dir);
  n = fww_cat(out, n, ")\n");
  if read_only {
    n = fww_cat(out, n, "You have read-only access to this agent's persistent memory directory at `");
    n = fww_cat(out, n, mem_dir);
    n = fww_cat(out, n, "`. Consult `MEMORY.md` and topic files inside this directory for prior context.\n");
  } else {
    n = fww_cat(out, n, "You have a persistent agent memory directory at `");
    n = fww_cat(out, n, mem_dir);
    n = fww_cat(out, n, "`. You may Read, Edit, and Write `MEMORY.md` and topic files inside this directory to persist durable findings, patterns, and architectural notes across sessions. Keep `MEMORY.md` concise (under 200 lines / 25 KB) as an index.\n");
  }
  if existing_md.count > 0 {
    cut := flawed_truncate_memory_entrypoint(existing_md, FLAWED_MAX_ENTRYPOINT_LINES, FLAWED_MAX_ENTRYPOINT_BYTES);
    n = fww_cat(out, n, "\n## Existing MEMORY.md\n");
    if cut.keep_bytes > 0 {
      n = fww_cat(out, n, cast(string) existing_md[0..<cut.keep_bytes]);
    }
    if cut.truncated {
      n = fww_cat(out, n, "\n[MEMORY.md truncated at 200 lines / 25000 bytes]");
    }
    n = fww_cat(out, n, "\n");
  }
  return n;
}

// Ensures `<mem_dir>` exists on disk, reads `<mem_dir>/MEMORY.md` if present, and appends the
// formatted `# Agent Memory` section to `out[at..]` (#14123).
fww_inject_agent_memory_prompt :: (mem_dir: string, read_only: bool, out: [] u8, at: int) -> int {
  if mem_dir.count == 0 || !flawed_validate_memory_path(mem_dir) { return at; }
  _ = fs_mkdir_all(mem_dir);
  mp_b: [FS_PATH_MAX] u8;
  mp := fs_join(mem_dir, "MEMORY.md", mp_b[..]);
  md_buf: [32768] u8;
  existing := "";
  if mp.count > 0 && fs_kind(mp) == FS_FILE {
    rd := fs_read(mp, md_buf[..]);
    if rd > 0 { existing = cast(string) md_buf[0..<rd]; }
  }
  return fww_format_agent_memory_section(mem_dir, read_only, existing, out, at);
}

// Resolves canonical repository root for project/local memory scopes when running inside a linked git worktree.
fww_resolve_mem_cwd :: (cwd: string, out: [] u8) -> string {
  if cwd.count == 0 { return ""; }
  gp_b: [FS_PATH_MAX] u8;
  gp := fs_join(cwd, ".git", gp_b[..]);
  if gp.count > 0 && fs_kind(gp) == FS_FILE {
    gb: [512] u8;
    gn := fs_read(gp, gb[..]);
    if gn > 0 {
      par := fww_wt_parent_repo_from_gitdir(cast(string) gb[0..<gn], out);
      if par.count > 0 { return par; }
    }
  }
  n := fww_keep(out, cwd);
  return cast(string) out[0..<n];
}

// Hardened child-process teardown with SIGTERM -> SIGKILL escalation so subagents never leak orphans (#14123).
fww_kill_local_sub :: (r: [] FwRun, si: int) {
  if si < 0 || si >= FWW_MAX_DELEGATE_BATCH { return; }
  ph := r[0].local_subs[si].h;
  if ph >= 0 {
    _ = proc_close_stdin(ph);
    _ = proc_kill(ph, PROC_SIGTERM);
    if proc_wait(ph, 400) < 0 {
      _ = proc_kill(ph, PROC_SIGKILL);
      _ = proc_wait(ph, 400);
    }
    _ = proc_release(ph);
    r[0].local_subs[si].h = -1;
  }
  ri := r[0].local_subs[si].rec_idx;
  if r[0].local_subs[si].active && ri >= 0 && ri < r[0].nsubagents {
    r[0].subagents[ri].running = false;
  }
  r[0].local_subs[si].active = false;
  r[0].local_subs[si].done = true;
}

fww_kill_all_local_subs :: (r: [] FwRun, include_bg: bool) {
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if !r[0].local_subs[si].active && r[0].local_subs[si].h < 0 { continue; }
    if !include_bg && r[0].local_subs[si].is_bg { continue; }
    fww_kill_local_sub(r, si);
  }
}

// ---------------------------------------------------------------- sidechain persistence (session-scoped + append-only DAG JSONL, #14122)

fww_subagent_perm_mode_name :: (pm: int) -> string {
  return oa_perm_mode_to_name(pm);
}

fww_subagent_dir :: (home: string, out: [] u8) -> string {
  if home.count == 0 { return ""; }
  d1: [FS_PATH_MAX] u8;
  oa_dir := fs_join(home, ".openagents", d1[..]);
  _ = fs_mkdir(oa_dir);
  sub_dir := fs_join(oa_dir, "subagents", out);
  _ = fs_mkdir(sub_dir);
  return sub_dir;
}

// Session-scoped sidechain directory: <home>/.openagents/subagents/<sanitized_session_id>,
// falling back to legacy flat <home>/.openagents/subagents when session_id is empty/unsanitizable.
fww_subagent_session_dir :: (home: string, session_id: string, out: [] u8) -> string {
  if home.count == 0 { return ""; }
  base_b: [FS_PATH_MAX] u8;
  base_dir := fww_subagent_dir(home, base_b[..]);
  if base_dir.count == 0 { return ""; }
  san_b: [FLAWED_SUB_MAX_SESSION_LEN + 4] u8;
  san_n := flawed_subagent_sanitize_session_id(session_id, san_b[..]);
  if san_n <= 0 {
    n := fww_keep(out, base_dir);
    return cast(string) out[0..<n];
  }
  sdir := fs_join(base_dir, cast(string) san_b[0..<san_n], out);
  if sdir.count == 0 { return ""; }
  _ = fs_mkdir(sdir);
  return sdir;
}

// Pure formatter for agent-<id>.meta.json carrying full metadata for disk-backed SendMessage resume (#14122).
fww_subagent_format_meta_json :: (rec: [] FwSubagentRec, session_id: string, out: [] u8) -> int {
  if rec.count < 1 || rec[0].nagent_id <= 0 { return 0; }
  aid := cast(string) rec[0].agent_id[0..<rec[0].nagent_id];
  o: [1] Jo;
  jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "agentId"); jo_str(o[..], aid);
  jo_key(o[..], "agentType"); jo_str(o[..], cast(string) rec[0].subagent_type[0..<rec[0].nsubagent_type]);
  jo_key(o[..], "description"); jo_str(o[..], cast(string) rec[0].desc[0..<rec[0].ndesc]);
  if rec[0].nname > 0 { jo_key(o[..], "name"); jo_str(o[..], cast(string) rec[0].name[0..<rec[0].nname]); }
  if rec[0].nwt_path > 0 { jo_key(o[..], "worktreePath"); jo_str(o[..], cast(string) rec[0].wt_path[0..<rec[0].nwt_path]); }
  if rec[0].nwt_branch > 0 { jo_key(o[..], "worktreeBranch"); jo_str(o[..], cast(string) rec[0].wt_branch[0..<rec[0].nwt_branch]); }
  jo_key(o[..], "createdAt"); jo_int(o[..], rec[0].start_ms);
  jo_key(o[..], "readOnly"); jo_bool(o[..], rec[0].read_only);
  jo_key(o[..], "permissionMode"); jo_str(o[..], cast(string) rec[0].perm_mode[0..<rec[0].nperm_mode]);
  if rec[0].max_turns > 0 { jo_key(o[..], "maxTurns"); jo_int(o[..], rec[0].max_turns); }
  if rec[0].memory_scope > 0 { jo_key(o[..], "memoryScope"); jo_int(o[..], rec[0].memory_scope); }
  jo_key(o[..], "git"); jo_str(o[..], ifx rec[0].ngit > 0 then cast(string) rec[0].git[0..<rec[0].ngit] else "none");
  jo_key(o[..], "level"); jo_str(o[..], ifx rec[0].nlevel > 0 then cast(string) rec[0].level[0..<rec[0].nlevel] else "neon");
  eff_sid := ifx session_id.count > 0 then session_id else cast(string) rec[0].session_id[0..<rec[0].nsession_id];
  jo_key(o[..], "sessionId"); jo_str(o[..], eff_sid);
  jo_end(o[..]);
  return ifx o[0].bad then 0 else o[0].n;
}

// Pure parser for agent-<id>.meta.json restoring FwSubagentRec metadata (#14122).
fww_subagent_parse_meta_json :: (raw: string, jsonl_path: string, out_rec: [] FwSubagentRec) -> bool {
  if out_rec.count < 1 || raw.count < 2 { return false; }
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], raw, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  aid_b: [48] u8; aid := fww_jv_str_safe(d[0], 0, "agentId", aid_b[..]);
  if aid.count == 0 { return false; }
  at_b: [32] u8; atype := fww_jv_str_safe(d[0], 0, "agentType", at_b[..]);
  if atype.count == 0 { atype = "general-purpose"; }
  ds_b: [160] u8; desc := fww_jv_str_safe(d[0], 0, "description", ds_b[..]);
  nm_b: [64] u8; name := fww_jv_str_safe(d[0], 0, "name", nm_b[..]);
  wp_b: [256] u8; wp := fww_jv_str_safe(d[0], 0, "worktreePath", wp_b[..]);
  wb_b: [96] u8; wb := fww_jv_str_safe(d[0], 0, "worktreeBranch", wb_b[..]);
  pm_b: [24] u8; pm := fww_jv_str_safe(d[0], 0, "permissionMode", pm_b[..]);
  gt_b: [8] u8; gt := fww_jv_str_safe(d[0], 0, "git", gt_b[..]);
  lv_b: [12] u8; lv := fww_jv_str_safe(d[0], 0, "level", lv_b[..]);
  sd_b: [128] u8; sid := fww_jv_str_safe(d[0], 0, "sessionId", sd_b[..]);

  ro := jv_bool(d[0], jv_get(d[0], 0, "readOnly"));
  if !ro && (oa_ag_eq_ci(atype, "Explore") || oa_ag_eq_ci(atype, "Plan")) { ro = true; }
  created := jv_int(d[0], jv_get(d[0], 0, "createdAt"), 0);
  mt := jv_int(d[0], jv_get(d[0], 0, "maxTurns"), 0);
  ms := jv_int(d[0], jv_get(d[0], 0, "memoryScope"), 0);

  rec := FwSubagentRec.{
    active = true,
    running = false,
    failed = false,
    one_shot = oa_ag_eq_ci(atype, "Explore") || oa_ag_eq_ci(atype, "Plan"),
    read_only = ro,
    max_turns = ifx mt > 0 then mt else 0,
    memory_scope = ifx ms > 0 then ms else 0,
    start_ms = created,
  };
  rec.nagent_id = fww_keep(rec.agent_id[..], aid);
  rec.nsubagent_type = fww_keep(rec.subagent_type[..], atype);
  rec.ndesc = fww_keep(rec.desc[..], desc);
  rec.nname = fww_keep(rec.name[..], name);
  rec.nwt_path = fww_keep(rec.wt_path[..], wp);
  rec.nwt_branch = fww_keep(rec.wt_branch[..], wb);
  rec.nperm_mode = fww_keep(rec.perm_mode[..], pm);
  rec.ngit = fww_keep(rec.git[..], ifx gt.count > 0 then gt else "none");
  rec.nlevel = fww_keep(rec.level[..], ifx lv.count > 0 then lv else "neon");
  rec.nsession_id = fww_keep(rec.session_id[..], sid);
  rec.noutput_file = fww_keep(rec.output_file[..], jsonl_path);
  out_rec[0] = rec;
  return true;
}

fww_subagent_write_meta :: (home: string, session_id: string, rec: [] FwSubagentRec, out_jsonl_path: [] u8) -> int {
  if home.count == 0 || rec.count < 1 || rec[0].nagent_id <= 0 { return 0; }
  db: [FS_PATH_MAX] u8;
  sdir := fww_subagent_session_dir(home, session_id, db[..]);
  if sdir.count == 0 { return 0; }
  aid := cast(string) rec[0].agent_id[0..<rec[0].nagent_id];

  // Build meta path: <sdir>/agent-<id>.meta.json
  mp: [FS_PATH_MAX] u8;
  mn := fww_cat(mp[..], 0, sdir);
  mn = fww_cat(mp[..], mn, "/agent-");
  mn = fww_cat(mp[..], mn, aid);
  mn = fww_cat(mp[..], mn, ".meta.json");

  // Build jsonl path: <sdir>/agent-<id>.jsonl
  jn := fww_cat(out_jsonl_path, 0, sdir);
  jn = fww_cat(out_jsonl_path, jn, "/agent-");
  jn = fww_cat(out_jsonl_path, jn, aid);
  jn = fww_cat(out_jsonl_path, jn, ".jsonl");

  mb: [4096] u8;
  mlen := fww_subagent_format_meta_json(rec, session_id, mb[..]);
  if mlen > 0 {
    _ = fs_write(cast(string) mp[0..<mn], cast(string) mb[0..<mlen]);
  }
  return jn;
}

// Formats a single append-only DAG JSONL line for a structured FwMsg (with newline).
fww_subagent_format_dag_line :: (
  msg: FwMsg,
  h: [] FwHist,
  uuid: string,
  parent_uuid: string,
  agent_id: string,
  session_id: string,
  ts_ms: int,
  out: [] u8
) -> int {
  role_s := ifx msg.role == FWW_MROLE_USER then "user"
            else ifx msg.role == FWW_MROLE_ASSISTANT then "assistant"
            else ifx msg.role == FWW_MROLE_TOOL_RESULTS then "tool_results"
            else "";
  if role_s.count == 0 || uuid.count == 0 { return 0; }
  o: [1] Jo;
  jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "uuid"); jo_str(o[..], uuid);
  jo_key(o[..], "parentUuid");
  if parent_uuid.count > 0 { jo_str(o[..], parent_uuid); } else { jo_null(o[..]); }
  jo_key(o[..], "isSidechain"); jo_bool(o[..], true);
  jo_key(o[..], "agentId"); jo_str(o[..], agent_id);
  jo_key(o[..], "sessionId"); jo_str(o[..], session_id);
  jo_key(o[..], "role"); jo_str(o[..], role_s);
  jo_key(o[..], "timestamp"); jo_int(o[..], ts_ms);
  jo_key(o[..], "blocks"); jo_arr(o[..]);
  for bi: 0..<msg.nblocks {
    bk := msg.blocks[bi];
    k_s := ifx bk.kind == FWW_MB_TEXT then "text"
           else ifx bk.kind == FWW_MB_THINK then "thinking"
           else ifx bk.kind == FWW_MB_TOOL_USE then "tool_use"
           else ifx bk.kind == FWW_MB_TOOL_RES then "tool_result"
           else "";
    if k_s.count == 0 { continue; }
    jo_obj(o[..]);
    jo_key(o[..], "kind"); jo_str(o[..], k_s);
    if bk.id_n > 0 { jo_key(o[..], "id"); jo_str(o[..], fww_slab_str(h, bk.id_at, bk.id_n)); }
    if bk.name_n > 0 { jo_key(o[..], "name"); jo_str(o[..], fww_slab_str(h, bk.name_at, bk.name_n)); }
    jo_key(o[..], "text"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
    if bk.sig_n > 0 { jo_key(o[..], "sig"); jo_str(o[..], fww_slab_str(h, bk.sig_at, bk.sig_n)); }
    if bk.kind == FWW_MB_TOOL_RES { jo_key(o[..], "is_error"); jo_bool(o[..], bk.is_error); }
    jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_end(o[..]);
  if o[0].bad || o[0].n >= out.count { return 0; }
  out[o[0].n] = '\n';
  return o[0].n + 1;
}

// Formats a single append-only DAG JSONL line for a plain text user/assistant turn (with newline).
fww_subagent_format_text_dag_line :: (
  role_s: string,
  text: string,
  uuid: string,
  parent_uuid: string,
  agent_id: string,
  session_id: string,
  ts_ms: int,
  out: [] u8
) -> int {
  if role_s.count == 0 || uuid.count == 0 { return 0; }
  o: [1] Jo;
  jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "uuid"); jo_str(o[..], uuid);
  jo_key(o[..], "parentUuid");
  if parent_uuid.count > 0 { jo_str(o[..], parent_uuid); } else { jo_null(o[..]); }
  jo_key(o[..], "isSidechain"); jo_bool(o[..], true);
  jo_key(o[..], "agentId"); jo_str(o[..], agent_id);
  jo_key(o[..], "sessionId"); jo_str(o[..], session_id);
  jo_key(o[..], "role"); jo_str(o[..], role_s);
  jo_key(o[..], "timestamp"); jo_int(o[..], ts_ms);
  jo_key(o[..], "blocks"); jo_arr(o[..]);
  jo_obj(o[..]);
  jo_key(o[..], "kind"); jo_str(o[..], "text");
  jo_key(o[..], "text"); jo_str(o[..], text);
  jo_end(o[..]);
  jo_end(o[..]);
  jo_end(o[..]);
  if o[0].bad || o[0].n >= out.count { return 0; }
  out[o[0].n] = '\n';
  return o[0].n + 1;
}

fww_subagent_make_uuid :: (ts_us: int, msg_idx: int, seq: int, out: [] u8) -> int {
  n := fww_cat(out, 0, "sc-");
  n = fww_put_int(out, n, ts_us);
  n = fww_cat(out, n, "-");
  n = fww_put_int(out, n, msg_idx);
  n = fww_cat(out, n, "-");
  n = fww_put_int(out, n, seq);
  return n;
}

// Appends a live structured message from FwHist into the active child's sidechain DAG JSONL via fs_append.
fww_run_append_sidechain_msg :: (r: [] FwRun, h: [] FwHist, msg_idx: int, scratch: [] u8) {
  if r[0].nsidechain_jsonl <= 0 || msg_idx < 0 || msg_idx >= h[0].nmsgs { return; }
  path := cast(string) r[0].sidechain_jsonl[0..<r[0].nsidechain_jsonl];
  aid := cast(string) r[0].agent_id[0..<r[0].nagent_id];
  sid := cast(string) r[0].session_id[0..<r[0].nsession_id];
  par := cast(string) r[0].dag_head_uuid[0..<r[0].ndag_head_uuid];
  wall_us := cxproc_wall_us();
  ts_ms := wall_us / 1000;
  r[0].dag_seq += 1;
  ub: [64] u8;
  un := fww_subagent_make_uuid(wall_us, msg_idx, r[0].dag_seq, ub[..]);
  u_s := cast(string) ub[0..<un];
  ln := fww_subagent_format_dag_line(h[0].msgs[msg_idx], h, u_s, par, aid, sid, ts_ms, scratch);
  if ln > 0 && fs_append(path, cast(string) scratch[0..<ln]) {
    r[0].ndag_head_uuid = fww_keep(r[0].dag_head_uuid[..], u_s);
  }
}

FwDagJsonlRow :: struct {
  line_from: int;
  line_to: int;
  role: int;
  has_uuid: bool;
  uuid: [64] u8; nuuid: int;
  parent_uuid: [64] u8; nparent_uuid: int;
}

// Pure append-only DAG JSONL -> FwHist hydrator (#14122).
// - Tolerates optional UTF-8 BOM and truncated/corrupted trailing or mid-stream lines
//   (via flawed_scan_jsonl_valid_lines + per-line jv_parse guard).
// - Reconstructs the active root->leaf branch via uuid/parentUuid with cycle guard and dedup.
// - Hydrates structured blocks (text, thinking+sig, tool_use+sig, tool_result+is_error)
//   and stays backwards-compatible with legacy {"role","content"} JSONL lines.
fww_subagent_parse_jsonl_to_hist :: (
  raw: string,
  h: [] FwHist,
  scratch: [] u8,
  out_leaf_uuid: [] u8,
  out_leaf_n: [] int
) -> int {
  if out_leaf_n.count > 0 { out_leaf_n[0] = 0; }
  fww_hist_clear(h);
  if raw.count == 0 || flawed_scan_jsonl_valid_lines(raw) <= 0 { return 0; }

  entries: [FWW_MAX_MSGS] FwDagJsonlRow;
  nentries := 0;
  nodes: [1024] JvNode;
  d: [1] Jv;

  pos := 0;
  if raw.count >= 3 && raw[0] == 239 && raw[1] == 187 && raw[2] == 191 { pos = 3; }
  while pos < raw.count {
    ls := pos;
    while pos < raw.count && raw[pos] != 10 { pos += 1; }
    le := pos;
    if pos < raw.count && raw[pos] == 10 { pos += 1; }
    while le > ls && (raw[le - 1] == 13 || raw[le - 1] == 32) { le -= 1; }
    while ls < le && raw[ls] == 32 { ls += 1; }
    if le - ls < 2 || raw[ls] != '{' || raw[le - 1] != '}' { continue; }
    line := cast(string) raw[ls..<le];
    if !jv_parse(d[..], line, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { continue; }

    rb: [32] u8; role_s := fww_jv_str_safe(d[0], 0, "role", rb[..]);
    role := ifx role_s == "user" then FWW_MROLE_USER
            else ifx role_s == "assistant" then FWW_MROLE_ASSISTANT
            else ifx role_s == "tool_results" then FWW_MROLE_TOOL_RESULTS
            else 0;
    if role == 0 { continue; }

    ub: [64] u8; u_s := fww_jv_str_safe(d[0], 0, "uuid", ub[..]);
    pb: [64] u8; p_s := fww_jv_str_safe(d[0], 0, "parentUuid", pb[..]);

    // Dedup duplicate UUIDs (keep first occurrence)
    if u_s.count > 0 {
      dup := false;
      for ei: 0..<nentries {
        if entries[ei].has_uuid && entries[ei].nuuid == u_s.count && cast(string) entries[ei].uuid[0..<entries[ei].nuuid] == u_s {
          dup = true; break;
        }
      }
      if dup { continue; }
    }

    slot := nentries;
    if slot >= FWW_MAX_MSGS {
      for k: 0..<(FWW_MAX_MSGS - 1) { entries[k] = entries[k + 1]; }
      slot = FWW_MAX_MSGS - 1;
    } else {
      nentries += 1;
    }
    row := FwDagJsonlRow.{line_from = ls, line_to = le, role = role, has_uuid = u_s.count > 0};
    row.nuuid = fww_keep(row.uuid[..], u_s);
    row.nparent_uuid = fww_keep(row.parent_uuid[..], p_s);
    entries[slot] = row;
  }

  if nentries == 0 { return 0; }

  // Pass 2: Reconstruct active root->leaf chain via uuid/parentUuid (or sequential for legacy lines)
  chain: [FWW_MAX_MSGS] int;
  chain_n := 0;
  last_dag := -1;
  for ei: 0..<nentries {
    if entries[ei].has_uuid { last_dag = ei; }
  }
  if last_dag >= 0 {
    visited: [FWW_MAX_MSGS] bool;
    cur := last_dag;
    while cur >= 0 && !visited[cur] && chain_n < FWW_MAX_MSGS {
      visited[cur] = true;
      chain[chain_n] = cur;
      chain_n += 1;
      if entries[cur].nparent_uuid == 0 { break; }
      par_s := cast(string) entries[cur].parent_uuid[0..<entries[cur].nparent_uuid];
      found_p := -1;
      for ei: 0..<nentries {
        if entries[ei].has_uuid && entries[ei].nuuid == par_s.count && cast(string) entries[ei].uuid[0..<entries[ei].nuuid] == par_s {
          found_p = ei; break;
        }
      }
      cur = found_p;
    }
    // Reverse into root -> leaf order
    lo := 0; hi := chain_n - 1;
    while lo < hi {
      tmp := chain[lo]; chain[lo] = chain[hi]; chain[hi] = tmp;
      lo += 1; hi -= 1;
    }
    if out_leaf_uuid.count > 0 && out_leaf_n.count > 0 {
      out_leaf_n[0] = fww_keep(out_leaf_uuid, cast(string) entries[last_dag].uuid[0..<entries[last_dag].nuuid]);
    }
  } else {
    chain_n = nentries;
    for ei: 0..<nentries { chain[ei] = ei; }
  }

  // Pass 3: Hydrate ordered chain entries into FwHist
  for ci: 0..<chain_n {
    if h[0].nmsgs >= FWW_MAX_MSGS { break; }
    ei := chain[ci];
    line := cast(string) raw[entries[ei].line_from..<entries[ei].line_to];
    if !jv_parse(d[..], line, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { continue; }

    mi := h[0].nmsgs;
    h[0].msgs[mi] = FwMsg.{role = entries[ei].role};
    nb := 0;
    a0 := [1] int.[0];
    blks := jv_get(d[0], 0, "blocks");
    if jv_kind(d[0], blks) == JV_ARRAY {
      blen := jv_len(d[0], blks);
      for bi: 0..<blen {
        if nb >= FWW_MAX_BLOCKS { break; }
        bn := jv_at(d[0], blks, bi);
        if jv_kind(d[0], bn) != JV_OBJECT { continue; }
        kb: [32] u8; ks := fww_jv_str_safe(d[0], bn, "kind", kb[..]);
        bkind := ifx ks == "text" then FWW_MB_TEXT
                 else ifx ks == "thinking" then FWW_MB_THINK
                 else ifx ks == "tool_use" then FWW_MB_TOOL_USE
                 else ifx ks == "tool_result" then FWW_MB_TOOL_RES
                 else 0;
        if bkind == 0 { continue; }
        bk := FwBlock.{kind = bkind, is_error = jv_bool(d[0], jv_get(d[0], bn, "is_error"))};
        id_b: [128] u8; id_s := fww_jv_str_safe(d[0], bn, "id", id_b[..]);
        if id_s.count > 0 { bk.id_n = fww_slab_put(h, id_s, a0[..]); bk.id_at = a0[0]; }
        nm_b: [128] u8; nm_s := fww_jv_str_safe(d[0], bn, "name", nm_b[..]);
        if nm_s.count > 0 { bk.name_n = fww_slab_put(h, nm_s, a0[..]); bk.name_at = a0[0]; }
        tn := jv_str(d[0], jv_get(d[0], bn, "text"), scratch);
        if tn > 0 { bk.text_n = fww_slab_put(h, cast(string) scratch[0..<tn], a0[..]); bk.text_at = a0[0]; }
        sn := jv_str(d[0], jv_get(d[0], bn, "sig"), scratch);
        if sn > 0 { bk.sig_n = fww_slab_put(h, cast(string) scratch[0..<sn], a0[..]); bk.sig_at = a0[0]; }
        h[0].msgs[mi].blocks[nb] = bk;
        nb += 1;
      }
    } else {
      cn := jv_str(d[0], jv_get(d[0], 0, "content"), scratch);
      if cn >= 0 {
        bk := FwBlock.{kind = FWW_MB_TEXT};
        if cn > 0 { bk.text_n = fww_slab_put(h, cast(string) scratch[0..<cn], a0[..]); bk.text_at = a0[0]; }
        h[0].msgs[mi].blocks[0] = bk;
        nb = 1;
      }
    }
    if nb > 0 {
      h[0].msgs[mi].nblocks = nb;
      h[0].nmsgs += 1;
    }
  }
  return h[0].nmsgs;
}

// Loads a sidechain DAG JSONL transcript from disk into FwHist (reading the tail if larger than file_buf).
fww_subagent_load_jsonl :: (
  jsonl_path: string,
  h: [] FwHist,
  file_buf: [] u8,
  scratch: [] u8,
  out_leaf_uuid: [] u8,
  out_leaf_n: [] int
) -> int {
  if jsonl_path.count == 0 || fs_kind(jsonl_path) != FS_FILE || file_buf.count == 0 { return 0; }
  sz := fs_size(jsonl_path);
  if sz <= 0 { return 0; }
  rd := 0;
  start := 0;
  if sz <= file_buf.count {
    rd = fs_read(jsonl_path, file_buf);
  } else {
    rd = fs_read_at(jsonl_path, sz - file_buf.count, file_buf);
    while start < rd && file_buf[start] != '\n' { start += 1; }
    if start < rd { start += 1; }
  }
  if rd <= start { return 0; }
  return fww_subagent_parse_jsonl_to_hist(cast(string) file_buf[start..<rd], h, scratch, out_leaf_uuid, out_leaf_n);
}

// Lightweight tail scanner for metadata restore: extracts last assistant text & latest DAG leaf uuid.
fww_subagent_scan_jsonl_tail :: (
  raw: string,
  out_reply: [] u8,
  out_reply_n: [] int,
  out_leaf_uuid: [] u8,
  out_leaf_n: [] int
) {
  if out_reply_n.count > 0 { out_reply_n[0] = 0; }
  if out_leaf_n.count > 0 { out_leaf_n[0] = 0; }
  if raw.count == 0 { return; }
  nodes: [512] JvNode; d: [1] Jv;
  tb: [4096] u8;
  pos := 0;
  if raw.count >= 3 && raw[0] == 239 && raw[1] == 187 && raw[2] == 191 { pos = 3; }
  while pos < raw.count {
    ls := pos;
    while pos < raw.count && raw[pos] != 10 { pos += 1; }
    le := pos;
    if pos < raw.count && raw[pos] == 10 { pos += 1; }
    while le > ls && (raw[le - 1] == 13 || raw[le - 1] == 32) { le -= 1; }
    while ls < le && raw[ls] == 32 { ls += 1; }
    if le - ls < 2 || raw[ls] != '{' || raw[le - 1] != '}' { continue; }
    if !jv_parse(d[..], cast(string) raw[ls..<le], nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { continue; }
    ub: [64] u8; u_s := fww_jv_str_safe(d[0], 0, "uuid", ub[..]);
    if u_s.count > 0 && out_leaf_uuid.count > 0 && out_leaf_n.count > 0 {
      out_leaf_n[0] = fww_keep(out_leaf_uuid, u_s);
    }
    rb: [32] u8; role_s := fww_jv_str_safe(d[0], 0, "role", rb[..]);
    if role_s != "assistant" { continue; }
    blks := jv_get(d[0], 0, "blocks");
    if jv_kind(d[0], blks) == JV_ARRAY {
      blen := jv_len(d[0], blks);
      for bi: 0..<blen {
        bn := jv_at(d[0], blks, bi);
        kb: [24] u8; ks := fww_jv_str_safe(d[0], bn, "kind", kb[..]);
        if ks == "text" {
          tn := jv_str(d[0], jv_get(d[0], bn, "text"), tb[..]);
          if tn > 0 && out_reply.count > 0 && out_reply_n.count > 0 {
            out_reply_n[0] = fww_keep(out_reply, cast(string) tb[0..<tn]);
          }
        }
      }
    } else {
      cn := jv_str(d[0], jv_get(d[0], 0, "content"), tb[..]);
      if cn > 0 && out_reply.count > 0 && out_reply_n.count > 0 {
        out_reply_n[0] = fww_keep(out_reply, cast(string) tb[0..<cn]);
      }
    }
  }
}

fww_subagent_refresh_tail_from_disk :: (rec: [] FwSubagentRec) {
  if rec.count < 1 || rec[0].noutput_file <= 0 { return; }
  p := cast(string) rec[0].output_file[0..<rec[0].noutput_file];
  if fs_kind(p) != FS_FILE { return; }
  sz := fs_size(p);
  if sz <= 0 { return; }
  buf: [65536] u8;
  rd := 0;
  start := 0;
  if sz <= buf.count {
    rd = fs_read(p, buf[..]);
  } else {
    rd = fs_read_at(p, sz - buf.count, buf[..]);
    while start < rd && buf[start] != '\n' { start += 1; }
    if start < rd { start += 1; }
  }
  if rd <= start { return; }
  rep_n := [1] int.[0];
  leaf_n := [1] int.[0];
  fww_subagent_scan_jsonl_tail(cast(string) buf[start..<rd], rec[0].last_reply[..], rep_n[..], rec[0].parent_uuid[..], leaf_n[..]);
  if rep_n[0] > 0 { rec[0].nlast_reply = rep_n[0]; }
  if leaf_n[0] > 0 { rec[0].nparent_uuid = leaf_n[0]; }
}

// Appends a fallback user+assistant DAG turn pair via fs_append (never overwrites!) for subagents
// whose child process did not append structured turns directly (e.g. external claudeworker or mock).
fww_subagent_append_fallback_jsonl :: (r: [] FwRun, ri: int, prompt: string, reply: string) {
  if ri < 0 || ri >= r[0].nsubagents || r[0].subagents[ri].noutput_file <= 0 { return; }
  of_s := cast(string) r[0].subagents[ri].output_file[0..<r[0].subagents[ri].noutput_file];
  cur_sz := fs_size(of_s);
  if cur_sz > r[0].subagents[ri].output_file_size_before {
    // Child already appended real structured turns live; just refresh DAG head uuid.
    r[0].subagents[ri].output_file_size_before = cur_sz;
    fww_subagent_refresh_tail_from_disk(r[0].subagents[ri..<ri + 1]);
    return;
  }
  aid := cast(string) r[0].subagents[ri].agent_id[0..<r[0].subagents[ri].nagent_id];
  sid := ifx r[0].subagents[ri].nsession_id > 0
         then cast(string) r[0].subagents[ri].session_id[0..<r[0].subagents[ri].nsession_id]
         else cast(string) r[0].session_id[0..<r[0].nsession_id];
  wall_us := cxproc_wall_us();
  ts_ms := wall_us / 1000;
  r[0].dag_seq += 1;
  u1_b: [64] u8; u1_n := fww_subagent_make_uuid(wall_us, ri, r[0].dag_seq, u1_b[..]);
  u1 := cast(string) u1_b[0..<u1_n];
  r[0].dag_seq += 1;
  u2_b: [64] u8; u2_n := fww_subagent_make_uuid(wall_us + 1, ri, r[0].dag_seq, u2_b[..]);
  u2 := cast(string) u2_b[0..<u2_n];
  par := cast(string) r[0].subagents[ri].parent_uuid[0..<r[0].subagents[ri].nparent_uuid];

  buf: [32768] u8;
  n1 := fww_subagent_format_text_dag_line("user", prompt, u1, par, aid, sid, ts_ms, buf[..]);
  if n1 > 0 && fs_append(of_s, cast(string) buf[0..<n1]) {
    r[0].subagents[ri].nparent_uuid = fww_keep(r[0].subagents[ri].parent_uuid[..], u1);
  }
  n2 := fww_subagent_format_text_dag_line("assistant", reply, u2, u1, aid, sid, ts_ms + 1, buf[..]);
  if n2 > 0 && fs_append(of_s, cast(string) buf[0..<n2]) {
    r[0].subagents[ri].nparent_uuid = fww_keep(r[0].subagents[ri].parent_uuid[..], u2);
  }
  nsz := fs_size(of_s);
  if nsz > 0 { r[0].subagents[ri].output_file_size_before = nsz; }
}

// ---------------------------------------------------------------- git worktree isolation (fail-closed)

fww_keep_z :: (dst: [] u8, src: string) -> int {
  n := fww_keep(dst, src);
  if n < dst.count { dst[n] = 0; }
  return n;
}

fww_git_exec :: (cwd: string, a1: string, a2: string, a3: string, a4: string, a5: string) -> bool {
  h := proc_new();
  if h < 0 { return false; }
  ok := proc_arg(h, "git");
  if a1.count > 0 { ok = ok && proc_arg(h, a1); }
  if a2.count > 0 { ok = ok && proc_arg(h, a2); }
  if a3.count > 0 { ok = ok && proc_arg(h, a3); }
  if a4.count > 0 { ok = ok && proc_arg(h, a4); }
  if a5.count > 0 { ok = ok && proc_arg(h, a5); }
  ok = ok && proc_cwd(h, cwd);
  ran := false;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    ran = proc_wait(h, 15000) == 0;
  }
  _ = proc_release(h);
  return ran;
}

// Fail-closed read-only git probe returning both output length and exact exit==0 status.
fww_git_quick_argv :: (cwd: string, args: [] string, timeout_ms: int, out: [] u8, out_ok: [] bool) -> int {
  out_ok[0] = false;
  if cwd.count == 0 { return 0; }
  h := proc_new();
  if h < 0 { return 0; }
  ok := proc_arg(h, "git") && proc_arg(h, "--no-optional-locks");
  for a: args {
    if a.count > 0 { ok = ok && proc_arg(h, a); }
  }
  ok = ok && proc_cwd(h, cwd);
  n := 0;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    lbuf: [1024] u8;
    deadline := proc_now_ms() + timeout_ms;
    while proc_now_ms() < deadline {
      r := proc_line(h, 100, lbuf[..]);
      if r == PROC_EOF || r < 0 { break; }
      if r == PROC_TIMEOUT { continue; }
      if n + 1 < out.count {
        n = fww_cat(out, n, cast(string) lbuf[0..<r]);
        n = fww_cat(out, n, "\n");
      }
    }
    ec := proc_wait(h, 400);
    if ec == 0 { out_ok[0] = true; } else { n = 0; }
  }
  _ = proc_release(h);
  return n;
}

// Resolves canonical git toplevel (`git rev-parse --show-toplevel`) and relative subdirectory from `cwd`.
fww_wt_resolve_git_root :: (cwd: string, out_root: [] u8, out_rel: [] u8, out_rel_n: [] int) -> bool {
  if out_rel_n.count > 0 { out_rel_n[0] = 0; }
  if cwd.count == 0 || fs_kind(cwd) != FS_DIR { return false; }
  argv := [2] string.["rev-parse", "--show-toplevel"];
  tb: [FS_PATH_MAX] u8;
  ok := [1] bool.[false];
  tn := fww_git_quick_argv(cwd, argv[..], 1500, tb[..], ok[..]);
  if !ok[0] || tn <= 0 { return false; }
  top_raw := fww_trim(cast(string) tb[0..<tn]);
  if top_raw.count == 0 { return false; }
  rt_b: [FS_PATH_MAX] u8;
  rc_b: [FS_PATH_MAX] u8;
  real_top := fs_realpath(top_raw, rt_b[..]);
  if real_top.count == 0 { real_top = top_raw; }
  real_cwd := fs_realpath(cwd, rc_b[..]);
  if real_cwd.count == 0 { real_cwd = cwd; }
  rn := fww_keep_z(out_root, real_top);
  if rn != real_top.count { return false; }
  if out_rel.count > 0 && out_rel_n.count > 0 {
    sub_n := flawed_wt_rel_subdir(real_top, real_cwd, out_rel);
    if sub_n > 0 {
      out_rel_n[0] = sub_n;
      if sub_n < out_rel.count { out_rel[sub_n] = 0; }
    }
  }
  return true;
}

fww_wt_copy_file :: (src: string, dst: string) -> bool {
  sz := fs_size(src);
  if sz < 0 || sz > 16 * 1024 * 1024 { return false; }
  if sz == 0 { return fs_write(dst, ""); }
  cbuf: [32768] u8;
  off := 0;
  while off < sz {
    n := fs_read_at(src, off, cbuf[..]);
    if n <= 0 { return false; }
    ok := ifx off == 0 then fs_write(dst, cast(string) cbuf[0..<n]) else fs_append(dst, cast(string) cbuf[0..<n]);
    if !ok { return false; }
    off += n;
  }
  return true;
}

// Copies gitignored local files matched by <git_root>/.worktreeinclude into <wt_dir>.
// Enforces #authority path safety, pattern matching, and symlink containment inside repo root.
fww_wt_copy_worktreeinclude :: (git_root: string, wt_dir: string) -> int {
  if git_root.count == 0 || wt_dir.count == 0 { return 0; }
  inc_pb: [FS_PATH_MAX] u8;
  inc_path := fs_join(git_root, ".worktreeinclude", inc_pb[..]);
  if inc_path.count == 0 || fs_kind(inc_path) != FS_FILE { return 0; }
  rr_b: [FS_PATH_MAX] u8;
  rw_b: [FS_PATH_MAX] u8;
  ri_b: [FS_PATH_MAX] u8;
  real_root := fs_realpath(git_root, rr_b[..]);
  real_wt := fs_realpath(wt_dir, rw_b[..]);
  real_inc := fs_realpath(inc_path, ri_b[..]);
  if real_root.count == 0 || real_wt.count == 0 || real_inc.count == 0 { return 0; }
  if !flawed_wt_path_within_root(real_root, real_inc) { return 0; }

  inc_buf: [16384] u8;
  inc_n := fs_read(real_inc, inc_buf[..]);
  if inc_n <= 0 { return 0; }
  inc_s := cast(string) inc_buf[0..<inc_n];

  h := proc_new();
  if h < 0 { return 0; }
  ok := proc_arg(h, "git")
     && proc_arg(h, "--no-optional-locks")
     && proc_arg(h, "-c")
     && proc_arg(h, "core.quotepath=false")
     && proc_arg(h, "ls-files")
     && proc_arg(h, "--others")
     && proc_arg(h, "--ignored")
     && proc_arg(h, "--exclude-standard")
     && proc_cwd(h, real_root);
  copied := 0;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    lbuf: [FS_PATH_MAX] u8;
    src_b: [FS_PATH_MAX] u8;
    sr_b: [FS_PATH_MAX] u8;
    dst_b: [FS_PATH_MAX] u8;
    dp_b: [FS_PATH_MAX] u8;
    deadline := proc_now_ms() + 5000;
    while proc_now_ms() < deadline && copied < 256 {
      r := proc_line(h, 150, lbuf[..]);
      if r == PROC_EOF || r < 0 { break; }
      if r == PROC_TIMEOUT { continue; }
      if r > 0 && lbuf[r - 1] == '\r' { r -= 1; }
      rel := cast(string) lbuf[0..<r];
      if !flawed_wt_include_matches(inc_s, rel) { continue; }
      src_p := fs_join(real_root, rel, src_b[..]);
      if src_p.count == 0 || fs_kind(src_p) != FS_FILE { continue; }
      src_real := fs_realpath(src_p, sr_b[..]);
      if src_real.count == 0 || !flawed_wt_path_within_root(real_root, src_real) { continue; }
      dst_p := fs_join(real_wt, rel, dst_b[..]);
      if dst_p.count == 0 || fs_kind(dst_p) != FS_NONE { continue; }
      dst_dir := fs_dir(dst_p);
      if dst_dir.count > 0 && dst_dir != "." { _ = fs_mkdir_all(dst_dir); }
      real_dst_dir := fs_realpath(dst_dir, dp_b[..]);
      if real_dst_dir.count == 0 { continue; }
      if real_dst_dir != real_wt && !flawed_wt_path_within_root(real_wt, real_dst_dir) { continue; }
      if fww_wt_copy_file(src_real, dst_p) {
        copied += 1;
      }
    }
    _ = proc_wait(h, 400);
  }
  _ = proc_release(h);
  return copied;
}

// Extracts the parent repository root from a linked worktree `.git` pointer file.
fww_wt_parent_repo_from_gitdir :: (git_file_body: string, out: [] u8) -> string {
  line_end := 0;
  while line_end < git_file_body.count && git_file_body[line_end] != '\n' && git_file_body[line_end] != '\r' {
    line_end += 1;
  }
  line := fww_trim(cast(string) git_file_body[0..<line_end]);
  if !flawed_aw_starts(line, "gitdir:") { return ""; }
  gd := fww_trim(cast(string) line[7..<line.count]);
  marker := "/.git/worktrees/";
  if gd.count <= marker.count { return ""; }
  for i: 0..<(gd.count - marker.count + 1) {
    if cast(string) gd[i..<(i + marker.count)] == marker {
      n := fww_keep_z(out, cast(string) gd[0..<i]);
      return cast(string) out[0..<n];
    }
  }
  return "";
}

// Fail-closed check that HEAD has no commits missing from other branches, remotes, or tags.
fww_wt_unpushed_empty :: (wt_path: string, branch: string) -> bool {
  out: [512] u8;
  ok := [1] bool.[false];
  n := 0;
  if branch.count > 0 && branch != "HEAD" {
    ex_b: [128] u8;
    en := fww_cat(ex_b[..], 0, "--exclude=");
    en = fww_cat(ex_b[..], en, branch);
    argv7 := [7] string.["rev-list", "HEAD", "--not", cast(string) ex_b[0..<en], "--branches", "--remotes", "--tags"];
    n = fww_git_quick_argv(wt_path, argv7[..], 1500, out[..], ok[..]);
  } else {
    argv6 := [6] string.["rev-list", "HEAD", "--not", "--branches", "--remotes", "--tags"];
    n = fww_git_quick_argv(wt_path, argv6[..], 1500, out[..], ok[..]);
  }
  return ok[0] && fww_trim(cast(string) out[0..<n]).count == 0;
}

// Prunes abandoned ephemeral agent-*/worktree-* worktrees older than cutoff_ms with clean git status
// and no unpushed commits, strictly gated by #authority flawed_wt_stale_sweep_can_remove.
fww_wt_sweep_stale_in :: (wt_root: string, active_wt_path: string, now_ms: int, cutoff_ms: int) -> int {
  if wt_root.count == 0 || fs_kind(wt_root) != FS_DIR { return 0; }
  ar_b: [FS_PATH_MAX] u8;
  active_real := ifx active_wt_path.count > 0 then fs_realpath(active_wt_path, ar_b[..]) else "";
  if active_real.count == 0 { active_real = active_wt_path; }

  lst: [1] FsList;
  n := fs_list(wt_root, lst[..]);
  if n <= 0 { return 0; }

  removed := 0;
  git_checks := 0;
  ep_b: [FS_PATH_MAX] u8;
  re_b: [FS_PATH_MAX] u8;
  dg_b: [FS_PATH_MAX] u8;
  dg_body: [512] u8;
  rr_b: [FS_PATH_MAX] u8;
  sb: [1024] u8;
  br_b: [128] u8;
  st_argv := [2] string.["status", "--porcelain"];
  br_argv := [3] string.["rev-parse", "--abbrev-ref", "HEAD"];

  for i: 0..<n {
    name := fs_entry(lst[..], i);
    is_eph := flawed_wt_is_ephemeral_name(name);
    if !is_eph { continue; }
    entry_path := fs_join(wt_root, name, ep_b[..]);
    if entry_path.count == 0 || fs_kind(entry_path) != FS_DIR { continue; }
    real_entry := fs_realpath(entry_path, re_b[..]);
    if real_entry.count == 0 { real_entry = entry_path; }
    is_active := active_real.count > 0 && (real_entry == active_real || flawed_wt_path_within_root(real_entry, active_real));
    if is_active { continue; }

    mtime_ns := fs_mtime_ns(real_entry);
    mtime_ms := ifx mtime_ns > 0 then mtime_ns / 1000000 else 0;
    is_old := flawed_wt_is_older_than_cutoff(mtime_ms, now_ms, cutoff_ms);
    if !is_old { continue; }

    // Must be a linked git worktree (`.git` pointer file -> parent repo); skip non-git dirs safely.
    dg_path := fs_join(real_entry, ".git", dg_b[..]);
    if dg_path.count == 0 || fs_kind(dg_path) != FS_FILE { continue; }
    dgn := fs_read(dg_path, dg_body[..]);
    if dgn <= 0 { continue; }
    repo_root := fww_wt_parent_repo_from_gitdir(cast(string) dg_body[0..<dgn], rr_b[..]);
    if repo_root.count == 0 || fs_kind(repo_root) != FS_DIR { continue; }

    if git_checks >= 16 { break; }
    git_checks += 1;

    st_ok := [1] bool.[false];
    sn := fww_git_quick_argv(real_entry, st_argv[..], 1500, sb[..], st_ok[..]);
    status_clean := st_ok[0] && fww_trim(cast(string) sb[0..<sn]).count == 0;

    br_ok := [1] bool.[false];
    bn := fww_git_quick_argv(real_entry, br_argv[..], 1500, br_b[..], br_ok[..]);
    br := ifx br_ok[0] then fww_trim(cast(string) br_b[0..<bn]) else "";
    unpushed_empty := br_ok[0] && fww_wt_unpushed_empty(real_entry, br);

    if !flawed_wt_stale_sweep_can_remove(is_eph, is_active, is_old, status_clean, unpushed_empty) {
      continue;
    }
    _ = fww_git_exec(repo_root, "worktree", "remove", real_entry, "", "");
    _ = fww_git_exec(repo_root, "worktree", "prune", "", "", "");
    if br.count > 0 && br != "HEAD" && flawed_wt_is_ephemeral_name(br) {
      _ = fww_git_exec(repo_root, "branch", "-D", br, "", "");
    }
    if fs_kind(real_entry) == FS_NONE {
      removed += 1;
    }
  }
  return removed;
}

fww_wt_sweep_stale :: (home: string, active_wt_path: string) -> int {
  d1: [FS_PATH_MAX] u8;
  d2: [FS_PATH_MAX] u8;
  wt_root := "";
  if home.count > 0 {
    oa_d := fs_join(home, ".openagents", d1[..]);
    wt_root = fs_join(oa_d, "worktrees", d2[..]);
  } else {
    wt_root = fs_join("/tmp", "oa-worktrees", d2[..]);
  }
  wall_ms := cxproc_wall_us() / 1000;
  return fww_wt_sweep_stale_in(wt_root, active_wt_path, wall_ms, FLAWED_WT_STALE_MS);
}

// Invalidates cached git snapshot, Glob/Grep query dedup, and Read file-dedup state when cwd switches.
fww_invalidate_cwd_caches :: (r: [] FwRun) {
  r[0].ngit_snap = 0;
  r[0].ngit_snap_cwd = 0;
  for qi: 0..<r[0].query_dedup.count { r[0].query_dedup[qi] = 0; }
  r[0].query_dedup_cur = 0;
  for di: 0..<r[0].read_dedup.count { r[0].read_dedup[di] = FwReadDedup.{}; }
  r[0].read_dedup_cur[0] = 0;
}

fww_wt_create :: (cwd: string, home: string, slug: string, out_path: [] u8, out_branch: [] u8, out_head: [] u8) -> bool {
  if cwd.count == 0 || !flawed_wt_validate_slug(slug) { return false; }
  flat_b: [FLAWED_WT_MAX_SLUG_LEN + 4] u8;
  fn := flawed_wt_flatten_slug(slug, flat_b[..]);
  if fn <= 0 { return false; }
  flat := cast(string) flat_b[0..<fn];

  // Resolve canonical git toplevel and preserve relative subdirectory mapping (#14121).
  root_b: [FS_PATH_MAX] u8;
  rel_b: [FS_PATH_MAX] u8;
  rel_n := [1] int.[0];
  if !fww_wt_resolve_git_root(cwd, root_b[..], rel_b[..], rel_n[..]) { return false; }
  git_root_n := 0;
  while git_root_n < root_b.count && root_b[git_root_n] != 0 { git_root_n += 1; }
  git_root := cast(string) root_b[0..<git_root_n];
  rel_sub := cast(string) rel_b[0..<rel_n[0]];

  // Capture current HEAD commit against canonical toplevel for fail-closed commit detection.
  hb: [128] u8;
  head_argv := [2] string.["rev-parse", "HEAD"];
  head_ok := [1] bool.[false];
  hn := fww_git_quick_argv(git_root, head_argv[..], 1500, hb[..], head_ok[..]);
  head_s := fww_trim(cast(string) hb[0..<hn]);
  if !head_ok[0] || head_s.count < 7 { return false; }
  _ = fww_keep_z(out_head, head_s);

  // Opportunistically prune abandoned 30-day stale ephemeral worktrees without blocking or failing.
  _ = fww_wt_sweep_stale(home, cwd);

  // Place isolated worktrees outside the git repo under <home>/.openagents/worktrees/<flat>
  // (fallback: /tmp/oa-worktrees/<flat>) so the parent git working tree is never dirtied.
  d1: [FS_PATH_MAX] u8; d2: [FS_PATH_MAX] u8;
  wt_root := "";
  if home.count > 0 {
    oa_d := fs_join(home, ".openagents", d1[..]); _ = fs_mkdir(oa_d);
    wt_root = fs_join(oa_d, "worktrees", d2[..]); _ = fs_mkdir(wt_root);
  } else {
    wt_root = fs_join("/tmp", "oa-worktrees", d2[..]); _ = fs_mkdir(wt_root);
  }
  wt_dir_b: [FS_PATH_MAX] u8;
  wt_dir := fs_join(wt_root, flat, wt_dir_b[..]);
  if wt_dir.count == 0 { return false; }

  bn := fww_cat(out_branch, 0, "worktree-");
  bn = fww_cat(out_branch, bn, flat);
  if bn < out_branch.count { out_branch[bn] = 0; }
  branch := cast(string) out_branch[0..<bn];

  if !fww_git_exec(git_root, "worktree", "add", "-b", branch, wt_dir) || fs_kind(wt_dir) != FS_DIR {
    return false;
  }

  // Copy matching gitignored local files listed in <git_root>/.worktreeinclude (#14121).
  _ = fww_wt_copy_worktreeinclude(git_root, wt_dir);

  // Preserve relative subdirectory mapping when cwd was nested inside the repo (#14121).
  eff_b: [FS_PATH_MAX] u8;
  eff_path := wt_dir;
  if rel_sub.count > 0 {
    mapped := fs_join(wt_dir, rel_sub, eff_b[..]);
    if mapped.count > 0 && fs_kind(mapped) == FS_DIR && mapped.count <= out_path.count {
      eff_path = mapped;
    }
  }
  if fww_keep_z(out_path, eff_path) != eff_path.count { return false; }
  return true;
}

// Fail-closed cleanup wired directly to flawed_wt_subagent_can_delete (#authority in subagent.coax).
// Resolves canonical git toplevels for both `cwd` and `wt_path` so nested subdirectories work cleanly.
// Returns true iff worktree was clean and deleted; false if preserved (dirty, committed, or git error).
fww_wt_cleanup_fail_closed :: (cwd: string, wt_path: string, wt_branch: string, orig_head: string) -> bool {
  if cwd.count == 0 || wt_path.count == 0 || fs_kind(wt_path) != FS_DIR { return false; }
  repo_b: [FS_PATH_MAX] u8;
  wt_b: [FS_PATH_MAX] u8;
  dummy_rel: [1] u8;
  dummy_n := [1] int.[0];
  if !fww_wt_resolve_git_root(cwd, repo_b[..], dummy_rel[0..<0], dummy_n[..]) { return false; }
  if !fww_wt_resolve_git_root(wt_path, wt_b[..], dummy_rel[0..<0], dummy_n[..]) { return false; }
  repo_len := 0; while repo_len < repo_b.count && repo_b[repo_len] != 0 { repo_len += 1; }
  wt_len := 0; while wt_len < wt_b.count && wt_b[wt_len] != 0 { wt_len += 1; }
  repo_top := cast(string) repo_b[0..<repo_len];
  wt_top := cast(string) wt_b[0..<wt_len];
  if repo_top.count == 0 || wt_top.count == 0 || repo_top == wt_top { return false; }

  sb: [2048] u8;
  st_argv := [2] string.["status", "--porcelain"];
  st_ok := [1] bool.[false];
  sn := fww_git_quick_argv(wt_top, st_argv[..], 1500, sb[..], st_ok[..]);
  st_out := fww_trim(cast(string) sb[0..<sn]);

  // Check commits since orig_head
  cb: [256] u8;
  range_b: [160] u8;
  rn := fww_cat(range_b[..], 0, orig_head);
  rn = fww_cat(range_b[..], rn, "..HEAD");
  rev_argv := [3] string.["rev-list", "--count", cast(string) range_b[0..<rn]];
  rev_ok := [1] bool.[false];
  cn := fww_git_quick_argv(wt_top, rev_argv[..], 1500, cb[..], rev_ok[..]);
  cnt_s := fww_trim(cast(string) cb[0..<cn]);
  git_ok := st_ok[0] && rev_ok[0] && orig_head.count >= 7 && cnt_s.count > 0;
  commits := fww_parse_int(cnt_s, 1);
  has_changes := st_out.count > 0 || commits > 0;
  if !flawed_wt_subagent_can_delete(false, git_ok, has_changes) {
    return false;
  }
  _ = fww_git_exec(repo_top, "worktree", "remove", wt_top, "", "");
  _ = fww_git_exec(repo_top, "worktree", "prune", "", "", "");
  if wt_branch.count > 0 {
    _ = fww_git_exec(repo_top, "branch", "-D", wt_branch, "", "");
  }
  return true;
}

// ---------------------------------------------------------------- subagent lookup, eviction & disk fallback (#14122)

// Allocates a slot in r[0].subagents (reusing inactive slots, appending below 24, or evicting
// the oldest non-running slot when all 24 slots are occupied).
fww_alloc_subagent_slot :: (r: [] FwRun) -> int {
  for i: 0..<r[0].nsubagents {
    if !r[0].subagents[i].active { return i; }
  }
  if r[0].nsubagents < FWW_MAX_SUBAGENT_RECS {
    idx := r[0].nsubagents;
    r[0].nsubagents += 1;
    return idx;
  }
  pick := -1;
  for i: 0..<FWW_MAX_SUBAGENT_RECS {
    if !r[0].subagents[i].running {
      if pick < 0 || r[0].subagents[i].start_ms < r[0].subagents[pick].start_ms {
        pick = i;
      }
    }
  }
  if pick >= 0 { return pick; }
  pick = 0;
  for i: 1..<FWW_MAX_SUBAGENT_RECS {
    if r[0].subagents[i].start_ms < r[0].subagents[pick].start_ms { pick = i; }
  }
  return pick;
}

fww_find_subagent_rec :: (r: [] FwRun, id_or_name: string) -> int {
  if id_or_name.count == 0 { return -1; }
  for i: 0..<r[0].nsubagents {
    if !r[0].subagents[i].active { continue; }
    if oa_ag_eq_ci(cast(string) r[0].subagents[i].agent_id[0..<r[0].subagents[i].nagent_id], id_or_name) { return i; }
    if r[0].subagents[i].nname > 0 && oa_ag_eq_ci(cast(string) r[0].subagents[i].name[0..<r[0].subagents[i].nname], id_or_name) { return i; }
  }
  return -1;
}

fww_subagent_find_meta_in_dir :: (dir: string, id_or_name: string, out_rec: [] FwSubagentRec) -> bool {
  if dir.count == 0 || id_or_name.count == 0 || fs_kind(dir) != FS_DIR { return false; }
  mbuf: [4096] u8;
  // 1. Direct O(1) lookup by safe agentId: <dir>/agent-<id>.meta.json
  if flawed_subagent_id_safe(id_or_name) {
    mp: [FS_PATH_MAX] u8;
    mn := fww_cat(mp[..], 0, dir);
    mn = fww_cat(mp[..], mn, "/agent-");
    mn = fww_cat(mp[..], mn, id_or_name);
    mn = fww_cat(mp[..], mn, ".meta.json");
    mpath := cast(string) mp[0..<mn];
    if fs_kind(mpath) == FS_FILE {
      rd := fs_read(mpath, mbuf[..]);
      if rd > 0 {
        jp: [FS_PATH_MAX] u8;
        jn := fww_cat(jp[..], 0, dir);
        jn = fww_cat(jp[..], jn, "/agent-");
        jn = fww_cat(jp[..], jn, id_or_name);
        jn = fww_cat(jp[..], jn, ".jsonl");
        if fww_subagent_parse_meta_json(cast(string) mbuf[0..<rd], cast(string) jp[0..<jn], out_rec) {
          fww_subagent_refresh_tail_from_disk(out_rec);
          return true;
        }
      }
    }
  }
  // 2. Scan directory for case-insensitive agentId or friendly `name` match
  lst: [1] FsList;
  n := fs_list(dir, lst[..]);
  if n <= 0 { return false; }
  fp_b: [FS_PATH_MAX] u8;
  jp_b: [FS_PATH_MAX] u8;
  cand: [1] FwSubagentRec;
  for i: 0..<n {
    en := fs_entry(lst[..], i);
    if !flawed_subagent_is_meta_filename(en) { continue; }
    full := fs_join(dir, en, fp_b[..]);
    if full.count == 0 || fs_kind(full) != FS_FILE { continue; }
    rd := fs_read(full, mbuf[..]);
    if rd <= 0 { continue; }
    // Replace trailing ".meta.json" (10 bytes) with ".jsonl"
    jn := fww_cat(jp_b[..], 0, dir);
    jn = fww_cat(jp_b[..], jn, "/");
    jn = fww_cat(jp_b[..], jn, cast(string) en[0..<(en.count - 10)]);
    jn = fww_cat(jp_b[..], jn, ".jsonl");
    if !fww_subagent_parse_meta_json(cast(string) mbuf[0..<rd], cast(string) jp_b[0..<jn], cand[..]) { continue; }
    aid_s := cast(string) cand[0].agent_id[0..<cand[0].nagent_id];
    nm_s := cast(string) cand[0].name[0..<cand[0].nname];
    if oa_ag_eq_ci(aid_s, id_or_name) || (nm_s.count > 0 && oa_ag_eq_ci(nm_s, id_or_name)) {
      fww_subagent_refresh_tail_from_disk(cand[..]);
      out_rec[0] = cand[0];
      return true;
    }
  }
  return false;
}

// 3-tier disk lookup for evicted or cross-session subagents (#14122):
//   1. Current session subdir: <home>/.openagents/subagents/<sanitized_session_id>/
//   2. Other session subdirs under <home>/.openagents/subagents/
//   3. Legacy flat dir: <home>/.openagents/subagents/
fww_load_subagent_from_disk :: (home: string, session_id: string, id_or_name: string, out_rec: [] FwSubagentRec) -> bool {
  if home.count == 0 || id_or_name.count == 0 || out_rec.count < 1 { return false; }
  d1: [FS_PATH_MAX] u8; d2: [FS_PATH_MAX] u8;
  oa_dir := fs_join(home, ".openagents", d1[..]);
  base_dir := fs_join(oa_dir, "subagents", d2[..]);
  if base_dir.count == 0 || fs_kind(base_dir) != FS_DIR { return false; }

  // 1. Current session subdir
  san_b: [FLAWED_SUB_MAX_SESSION_LEN + 4] u8;
  san_n := flawed_subagent_sanitize_session_id(session_id, san_b[..]);
  san_s := cast(string) san_b[0..<san_n];
  if san_n > 0 {
    sd_b: [FS_PATH_MAX] u8;
    sdir := fs_join(base_dir, san_s, sd_b[..]);
    if sdir.count > 0 && fww_subagent_find_meta_in_dir(sdir, id_or_name, out_rec) { return true; }
  }

  // 2. Other session subdirs under <home>/.openagents/subagents/
  lst: [1] FsList;
  n := fs_list(base_dir, lst[..]);
  if n > 0 {
    sub_b: [FS_PATH_MAX] u8;
    for i: 0..<n {
      en := fs_entry(lst[..], i);
      if san_n > 0 && en == san_s { continue; }
      sub_p := fs_join(base_dir, en, sub_b[..]);
      if sub_p.count == 0 || fs_kind(sub_p) != FS_DIR { continue; }
      if fww_subagent_find_meta_in_dir(sub_p, id_or_name, out_rec) { return true; }
    }
  }

  // 3. Legacy flat dir <home>/.openagents/subagents/
  return fww_subagent_find_meta_in_dir(base_dir, id_or_name, out_rec);
}

// Finds a subagent in memory or restores it from disk into r[0].subagents (evicting oldest non-running if full).
fww_find_or_load_subagent_rec :: (r: [] FwRun, id_or_name: string) -> int {
  ri := fww_find_subagent_rec(r, id_or_name);
  if ri >= 0 { return ri; }
  home := cast(string) r[0].home[0..<r[0].nhome];
  sid := cast(string) r[0].session_id[0..<r[0].nsession_id];
  loaded: [1] FwSubagentRec;
  if !fww_load_subagent_from_disk(home, sid, id_or_name, loaded[..]) { return -1; }
  slot := fww_alloc_subagent_slot(r);
  r[0].subagents[slot] = loaded[0];
  return slot;
}

// ---------------------------------------------------------------- parallel Agent batch delegation

// A sub-agent's git rule (GitHub #14104). asked is the Agent call's `git` ("" when it names none):
// none unless asked, except in a worktree of its own, where a commit is how its work comes back.
// Never more than most, the owner's limit (OA_SUBAGENT_GIT_MAX).
fww_subagent_git :: (asked: string, own_worktree: bool, most: string) -> string {
  want := ifx asked == "none" || asked == "commit" || asked == "push" then asked else ifx own_worktree then "commit" else "none";
  if most == "none" { return "none"; }
  if most == "commit" && want == "push" { return "commit"; }
  return want;
}
#test "sub-agents (#14104): the git rule is none unless the call asks, commit in its own worktree, and never past the limit" {
  #assert fww_subagent_git("", false, "push") == "none" && fww_subagent_git("bogus", false, "push") == "none";
  #assert fww_subagent_git("", true, "push") == "commit" && fww_subagent_git("none", true, "push") == "none";
  #assert fww_subagent_git("commit", false, "push") == "commit" && fww_subagent_git("push", false, "push") == "push";
  #assert fww_subagent_git("push", false, "commit") == "commit" && fww_subagent_git("commit", false, "commit") == "commit";
  #assert fww_subagent_git("push", false, "none") == "none" && fww_subagent_git("", true, "none") == "none";
}

// Whether this run's model is the local one (Local picked, or Auto that chose it).
fww_run_is_local :: (r: [] FwRun) -> bool {
  m := cast(string) r[0].model[0..<r[0].nmodel];
  return m == "oa:local" || gw_is_local_model(m);
}
// Whether a message plainly tells the chat to hand its task to Claude ("Use Claude to ...",
// "Have Claude Opus review ..."). The router's model doors answer this themselves; this is for the
// offline plan, which has no such answer (GitHub #14104). Only a direct instruction counts.
fww_text_asks_for_claude :: (text: string) -> bool {
  heads := [8] string.["use claude ", "have claude ", "ask claude ", "let claude ", "delegate to claude", "delegate this to claude", "delegate it to claude", "hand this to claude"];
  for h: heads {
    if text.count < h.count { continue; }
    for i: 0..<text.count - h.count + 1 {
      if i > 0 && text[i - 1] != ' ' && text[i - 1] != '\n' && text[i - 1] != ',' && text[i - 1] != '.' { continue; }   // a word's start
      if oa_ag_eq_ci(cast(string) text[i..<i + h.count], h) { return true; }
    }
  }
  return false;
}
#test "sub-agents (#14104): only a direct instruction asks for Claude" {
  #assert fww_text_asks_for_claude("Use Claude to fix this") && fww_text_asks_for_claude("Please have Claude Opus review the diff.");
  #assert fww_text_asks_for_claude("fix it, then ask claude to check") && fww_text_asks_for_claude("Delegate this to Claude");
  #assert !fww_text_asks_for_claude("What is Claude?") && !fww_text_asks_for_claude("refuse claude tokens") && !fww_text_asks_for_claude("");
  #assert !fww_text_asks_for_claude("the claude worker crashed") && !fww_text_asks_for_claude("excuse claude ");
}

// The app's sub-agent level for a subagent_type that names Claude Code, or "" (GitHub #14104).
fww_claude_level :: (kind: string) -> string {
  if oa_ag_eq_ci(kind, "claude-haiku") { return "haiku"; }
  if oa_ag_eq_ci(kind, "claude-sonnet") || oa_ag_eq_ci(kind, "claude") || oa_ag_eq_ci(kind, "claude-code") { return "sonnet"; }
  if oa_ag_eq_ci(kind, "claude-opus") { return "opus"; }
  if oa_ag_eq_ci(kind, "claude-fable") { return "fable"; }
  return "";
}
fww_claude_has_ci :: (hay: string, needle: string) -> bool {
  if needle.count == 0 || hay.count < needle.count { return false; }
  for i: 0..<(hay.count - needle.count + 1) {
    ok := true;
    for j: 0..<needle.count {
      a := hay[i + j]; b := needle[j];
      if a >= 'A' && a <= 'Z' { a = cast(u8) (a + 32); }
      if b >= 'A' && b <= 'Z' { b = cast(u8) (b + 32); }
      if a != b { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}
// Selects the Claude sub-agent type for a router-delegated prompt (#14104).
fww_claude_subagent_type_for_text :: (tk: string) -> string {
  if fww_claude_has_ci(tk, "fable") { return "claude-fable"; }
  if fww_claude_has_ci(tk, "opus") { return "claude-opus"; }
  if fww_claude_has_ci(tk, "haiku") { return "claude-haiku"; }
  return "claude-sonnet";
}
// Pure preparation for a System One router plan that explicitly chose `claude` (#14104):
// synthesizes an Agent tool call targeting the requested Claude model and appends the
// matching assistant TOOL_USE block to history so MWW_RESULTS pairs cleanly for the parent reply.
fww_prepare_routed_claude_delegate :: (r: [] FwRun, h: [] FwHist, tk: string) -> bool {
  if r[0].is_subagent || !r[0].host_agents || !r[0].host_claude { return false; }
  if r[0].nrouted_delegate <= 0 || cast(string) r[0].routed_delegate[0..<r[0].nrouted_delegate] != "claude" { return false; }
  if tk.count == 0 || h[0].nmsgs >= FWW_MAX_MSGS { return false; }
  sub_type := fww_claude_subagent_type_for_text(tk);
  ab: [16896] u8;
  jo: [1] Jo;
  jo_start(jo[..], ab[..]);
  jo_obj(jo[..]);
  jo_key(jo[..], "description"); jo_str(jo[..], "Delegate to Claude Code");
  jo_key(jo[..], "prompt"); jo_str(jo[..], tk);
  jo_key(jo[..], "subagent_type"); jo_str(jo[..], sub_type);
  jo_end(jo[..]);
  if jo[0].bad { return false; }
  args_s := jo_text(jo[..]);
  r[0].acc[0] = FwStreamAccum.{ntools = 1, cur_tool_idx = -1};
  r[0].acc[0].tools[0].nid = fww_keep(r[0].acc[0].tools[0].id[..], "router_delegate_1");
  r[0].acc[0].tools[0].nname = fww_keep(r[0].acc[0].tools[0].name[..], "Agent");
  r[0].acc[0].tools[0].nargs = fww_keep(r[0].acc[0].tools[0].args[..], args_s);
  mi := h[0].nmsgs;
  h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  a0 := [1] int.[0];
  ub := FwBlock.{kind = FWW_MB_TOOL_USE};
  ub.id_n = fww_slab_put(h, "router_delegate_1", a0[..]); ub.id_at = a0[0];
  ub.name_n = fww_slab_put(h, "Agent", a0[..]); ub.name_at = a0[0];
  ub.text_n = fww_slab_put(h, args_s, a0[..]); ub.text_at = a0[0];
  h[0].msgs[mi].blocks[0] = ub;
  h[0].nmsgs += 1;
  r[0].next_tool_idx = 0;
  return true;
}
// Launches a router-selected Claude delegation through the standard MWW_DELEGATE pipeline (#14104).
fww_start_routed_claude_delegate :: (r: [] FwRun, cfg: [] FwConfig, h: [] FwHist, b: [] FwBufs, home: string, tk: string, out: [] u8) -> bool {
  if !fww_prepare_routed_claude_delegate(r, h, tk) { return false; }
  return fww_start_delegate_batch(r, cfg, h, b, home, 0, 1, out);
}
#test "sub-agents (#14104): only a subagent_type that names Claude Code has a Claude level" {
  #assert fww_claude_level("claude-haiku") == "haiku" && fww_claude_level("Claude-Sonnet") == "sonnet" && fww_claude_level("claude") == "sonnet";
  #assert fww_claude_level("claude-opus") == "opus" && fww_claude_level("claude-fable") == "fable";
  #assert fww_claude_level("Explore") == "" && fww_claude_level("general-purpose") == "" && fww_claude_level("") == "" && fww_claude_level("haiku") == "";
  #assert fww_claude_subagent_type_for_text("Use Claude Haiku to count lines") == "claude-haiku";
  #assert fww_claude_subagent_type_for_text("Ask Claude Opus to review") == "claude-opus";
  #assert fww_claude_subagent_type_for_text("Use Claude Fable on this proof") == "claude-fable";
  #assert fww_claude_subagent_type_for_text("Use Claude to fix this") == "claude-sonnet";
}

// Launches all consecutive Agent/Task tool calls [batch_start..<batch_end) in parallel.
// When r[0].host_agents is true, delegates over MWW_DELEGATE (wait_all=true) to the host.
// When r[0].host_agents is false (standalone CLI/SDK mode), spawns child oa-worker subprocesses
// directly in parallel and polls them non-blockingly in fww_poll_local_subagents (#14096).
// Returns true if waiting asynchronously for foreground subagent results.
fww_start_delegate_batch :: (r: [] FwRun, cfg: [] FwConfig, h: [] FwHist, b: [] FwBufs, home: string, batch_start: int, batch_end: int, out: [] u8) -> bool {
  count := batch_end - batch_start;
  if count <= 0 { return false; }
  if count > FWW_MAX_DELEGATE_BATCH { count = FWW_MAX_DELEGATE_BATCH; }

  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];
  tasks_buf: [131072] u8;
  jo: [1] Jo;
  jo_start(jo[..], tasks_buf[..]);
  jo_arr(jo[..]);

  // Collect sibling tool_use {id, name} pairs for cache-exact FORK_AGENT placeholder parity
  sib_ids: [FWW_MAX_DELEGATE_BATCH] string;
  sib_names: [FWW_MAX_DELEGATE_BATCH] string;
  for k: 0..<count {
    tidx := batch_start + k;
    sib_ids[k] = cast(string) r[0].acc[0].tools[tidx].id[0..<r[0].acc[0].tools[tidx].nid];
    sib_names[k] = cast(string) r[0].acc[0].tools[tidx].name[0..<r[0].acc[0].tools[tidx].nname];
  }

  r[0].ndelegate_slots = 0;
  now_ms := proc_now_ms();
  launched_host := 0;
  any_local_fg := false;
  self_b: [FS_PATH_MAX] u8;
  self_bin := ifx !r[0].host_agents then fww_self_worker_bin(self_b[..]) else "";

  for k: 0..<count {
    tidx := batch_start + k;
    args := cast(string) r[0].acc[0].tools[tidx].args[0..<r[0].acc[0].tools[tidx].nargs];
    nodes: [256] JvNode; d: [1] Jv;
    desc_b: [160] u8; prompt_b: [16384] u8; type_b: [64] u8;
    model_b: [64] u8; name_b: [64] u8; iso_b: [32] u8; mode_b: [32] u8;
    dn := 0; pn := 0; tn := 0; mn := 0; nn := 0; ison := 0; modn := 0;
    git_b: [16] u8; gitn := 0;
    req_bg := false; req_fork := false;
    if jv_parse(d[..], args, nodes[..]) {
      dn = jv_str(d[0], jv_get(d[0], 0, "description"), desc_b[..]);
      pn = jv_str(d[0], jv_get(d[0], 0, "prompt"), prompt_b[..]);
      tn = jv_str(d[0], jv_get(d[0], 0, "subagent_type"), type_b[..]);
      mn = jv_str(d[0], jv_get(d[0], 0, "model"), model_b[..]);
      nn = jv_str(d[0], jv_get(d[0], 0, "name"), name_b[..]);
      ison = jv_str(d[0], jv_get(d[0], 0, "isolation"), iso_b[..]);
      gitn = jv_str(d[0], jv_get(d[0], 0, "git"), git_b[..]);
      modn = jv_str(d[0], jv_get(d[0], 0, "mode"), mode_b[..]);
      req_bg = jv_bool(d[0], jv_get(d[0], 0, "run_in_background"));
      req_fork = jv_bool(d[0], jv_get(d[0], 0, "fork"));
    }
    if dn < 0 { dn = 0; } if pn < 0 { pn = 0; } if tn < 0 { tn = 0; }
    if mn < 0 { mn = 0; } if nn < 0 { nn = 0; } if ison < 0 { ison = 0; } if modn < 0 { modn = 0; }
    desc_s := cast(string) desc_b[0..<dn];
    prompt_s := cast(string) prompt_b[0..<pn];
    type_s := ifx tn > 0 then cast(string) type_b[0..<tn] else "general-purpose";
    is_fork := req_fork || oa_ag_eq_ci(type_s, "fork");
    model_s := cast(string) model_b[0..<mn];
    name_s := cast(string) name_b[0..<nn];
    iso_s := cast(string) iso_b[0..<ison];
    mode_req_s := cast(string) mode_b[0..<modn];

    // A task for Claude Code runs in Claude Code or fails with why; it never runs on another model.
    claude_level := fww_claude_level(type_s);
    if claude_level.count > 0 && !r[0].host_claude {
      r[0].acc[0].tools[tidx].done = true;
      r[0].acc[0].tools[tidx].is_error = true;
      r[0].acc[0].tools[tidx].nres = fww_keep(r[0].acc[0].tools[tidx].res[..], ifx !cfg[0].allow_local_harnesses
        then "Delegating to Claude is turned off. To turn it on, open Settings > Agent and turn on \"Allow delegating to other local harnesses\"."
        else "Claude Code is not available on this computer. Install the claude command and sign in to it.");
      continue;
    }

    // 2-tier compaction-resistant recursive fork guard (#14096)
    if is_fork && fww_fork_guard_tripped(r, h) {
      r[0].acc[0].tools[tidx].done = true;
      r[0].acc[0].tools[tidx].is_error = true;
      r[0].acc[0].tools[tidx].nres = fww_keep(r[0].acc[0].tools[tidx].res[..], "Recursive FORK_AGENT blocked (compaction-resistant guard).");
      continue;
    }
    // Resolve persona from registry (defaulting to general-purpose)
    def_idx := oa_agents_find(r[0].agent_reg[..], type_s);
    if def_idx < 0 { def_idx = oa_agents_find(r[0].agent_reg[..], "general-purpose"); }
    def := r[0].agent_reg[0].defs[ifx def_idx >= 0 then def_idx else 0];
    if model_s.count == 0 && def.nmodel > 0 {
      model_s = cast(string) def.model[0..<def.nmodel];
    }

    // Generate stable agentId & allocate record
    r[0].agent_seq += 1;
    aid_b: [48] u8;
    aid_n := oa_agent_make_id(ifx is_fork then "fork" else type_s, now_ms + r[0].agent_seq * 97, r[0].agent_seq * 31 + k, aid_b[..]);
    aid_s := cast(string) aid_b[0..<aid_n];

    is_bg := oa_agent_should_run_async(false, req_bg, def, false, false);
    want_wt := oa_ag_eq_ci(iso_s, "worktree") || def.isolation_worktree;
    // What the delegation asks for wins; a custom agent file's own `git:` is the default under it.
    git_s := fww_subagent_git(ifx gitn > 0 then cast(string) git_b[0..<gitn] else cast(string) def.git[0..<def.ngit], want_wt, cast(string) cfg[0].subagent_git_max[0..<cfg[0].nsubagent_git_max]);

    rec_idx := fww_alloc_subagent_slot(r);
    req_pm := oa_parse_perm_mode_name(mode_req_s);
    eff_pm := oa_agent_resolve_perm_mode(cfg[0].permission_mode, req_pm, def.permission_mode);
    eff_perm_mode := oa_perm_mode_to_name(eff_pm);
    child_max_turns := ifx is_fork then 0 else def.max_turns;
    child_mem_scope := ifx is_fork then OA_AGENT_MEM_NONE else def.memory_scope;
    sid_s := cast(string) r[0].session_id[0..<r[0].nsession_id];
    r[0].subagents[rec_idx] = FwSubagentRec.{
      active = true, running = true, is_bg = is_bg,
      one_shot = def.one_shot && !is_fork, read_only = def.read_only && !is_fork,
      max_turns = child_max_turns, memory_scope = child_mem_scope,
      host_num = r[0].agent_seq, start_ms = now_ms,
    };
    r[0].subagents[rec_idx].nagent_id = fww_keep(r[0].subagents[rec_idx].agent_id[..], aid_s);
    r[0].subagents[rec_idx].nname = fww_keep(r[0].subagents[rec_idx].name[..], name_s);
    r[0].subagents[rec_idx].nsubagent_type = fww_keep(r[0].subagents[rec_idx].subagent_type[..], ifx is_fork then "fork" else type_s);
    r[0].subagents[rec_idx].ndesc = fww_keep(r[0].subagents[rec_idx].desc[..], desc_s);
    r[0].subagents[rec_idx].ngit = fww_keep(r[0].subagents[rec_idx].git[..], git_s);
    r[0].subagents[rec_idx].nlevel = fww_keep(r[0].subagents[rec_idx].level[..], ifx claude_level.count > 0 then claude_level else ifx fww_run_is_local(r) then "inkling" else "neon");
    r[0].subagents[rec_idx].nperm_mode = fww_keep(r[0].subagents[rec_idx].perm_mode[..], eff_perm_mode);
    r[0].subagents[rec_idx].nsession_id = fww_keep(r[0].subagents[rec_idx].session_id[..], sid_s);

    // Optional git worktree isolation
    if want_wt {
      slug_b: [64] u8;
      sn := fww_cat(slug_b[..], 0, "agent-");
      sn = fww_cat(slug_b[..], sn, aid_s);
      if fww_wt_create(cwd, home, cast(string) slug_b[0..<sn], r[0].subagents[rec_idx].wt_path[..], r[0].subagents[rec_idx].wt_branch[..], r[0].subagents[rec_idx].orig_head[..]) {
        wp := cast(string) r[0].subagents[rec_idx].wt_path[..];
        wpn := 0; while wpn < wp.count && wp[wpn] != 0 { wpn += 1; }
        r[0].subagents[rec_idx].nwt_path = wpn;
        wb := cast(string) r[0].subagents[rec_idx].wt_branch[..];
        wbn := 0; while wbn < wb.count && wb[wbn] != 0 { wbn += 1; }
        r[0].subagents[rec_idx].nwt_branch = wbn;
        oh := cast(string) r[0].subagents[rec_idx].orig_head[..];
        ohn := 0; while ohn < oh.count && oh[ohn] != 0 { ohn += 1; }
        r[0].subagents[rec_idx].norig_head = ohn;
      }
    }

    r[0].subagents[rec_idx].noutput_file = fww_subagent_write_meta(home, sid_s, r[0].subagents[rec_idx..<rec_idx + 1], r[0].subagents[rec_idx].output_file[..]);
    of_s_init := cast(string) r[0].subagents[rec_idx].output_file[0..<r[0].subagents[rec_idx].noutput_file];
    r[0].subagents[rec_idx].output_file_size_before = ifx of_s_init.count > 0 && fs_kind(of_s_init) == FS_FILE then fs_size(of_s_init) else 0;

    // Optional cache-exact FORK_AGENT context file + sentinel-wrapped directive (+ worktree path notice)
    fork_path_b: [FS_PATH_MAX] u8;
    fork_path_n := 0;
    eff_prompt_b: [18432] u8;
    eff_prompt := ifx prompt_s.count > 0 then prompt_s else desc_s;
    wt_path_s := cast(string) r[0].subagents[rec_idx].wt_path[0..<r[0].subagents[rec_idx].nwt_path];
    if is_fork {
      fork_path_n = fww_write_fork_context(home, aid_s, r, cfg, h, sib_ids[0..<count], sib_names[0..<count], b[0].req_body[..], fork_path_b[..]);
      fpn := oa_agent_format_fork_directive_ex(eff_prompt, want_wt, cwd, wt_path_s, eff_prompt_b[..]);
      eff_prompt = cast(string) eff_prompt_b[0..<fpn];
    }
    r[0].subagents[rec_idx].nlast_prompt = fww_keep(r[0].subagents[rec_idx].last_prompt[..], eff_prompt);
    fork_path_s := cast(string) fork_path_b[0..<fork_path_n];

    // Resolve child model, effort, and tool filters: FORK_AGENT preserves exact parent parameters
    // (no high->medium downgrade, no subagent_effort override, no OA_GENERAL_DISALLOWED stripping).
    parent_model_s := cast(string) r[0].model[0..<r[0].nmodel];
    parent_effort_s := ifx r[0].nlast_sent_effort > 0
                       then cast(string) r[0].last_sent_effort[0..<r[0].nlast_sent_effort]
                       else cast(string) r[0].effort[0..<r[0].neffort];
    child_model := ifx is_fork then parent_model_s
                   else ifx model_s.count > 0 then model_s
                   else parent_model_s;
    child_eff := ifx is_fork then parent_effort_s
                 else ifx cfg[0].nsubagent_effort > 0 then cast(string) cfg[0].subagent_effort[0..<cfg[0].nsubagent_effort]
                 else ifx def.read_only then "low"
                 else ifx cast(string) r[0].effort[0..<r[0].neffort] == "high" then "medium"
                 else cast(string) r[0].effort[0..<r[0].neffort];
    child_allowed := ifx is_fork then cast(string) cfg[0].allowed_tools[0..<cfg[0].nallowed]
                     else cast(string) def.allowed_tools[0..<def.nallowed];
    child_disallowed := ifx is_fork then cast(string) cfg[0].disallowed_tools[0..<cfg[0].ndisallowed]
                        else cast(string) def.disallowed_tools[0..<def.ndisallowed];

    if !r[0].host_agents {
      // Standalone headless mode: spawn child oa-worker subprocess directly
      slot := -1;
      for si: 0..<FWW_MAX_DELEGATE_BATCH { if !r[0].local_subs[si].active { slot = si; break; } }
      eff_cwd := ifx r[0].subagents[rec_idx].nwt_path > 0 then wt_path_s else cwd;
      ph := ifx slot >= 0 then proc_new() else -1;
      started := false;
      if ph >= 0 {
        ok := proc_arg(ph, self_bin) && proc_cwd(ph, eff_cwd);
        if ok && proc_start(ph) == 0 {
          tb: [32768] u8;
          mt := McTask.{
            task = eff_prompt, session = ifx sid_s.count > 0 then sid_s else aid_s, cwd = eff_cwd,
            local = is_fork && fww_run_is_local(r),
            sandbox = "danger-full-access", ceiling = 3, gated = false,
            edits = !(def.read_only && !is_fork), unlimited = true, no_ask = true, no_steer = false,
            model = child_model,
            effort = child_eff,
            mode = eff_perm_mode,
            subagent_type = ifx is_fork then "fork" else type_s,
            agent_id = aid_s,
            allowed_tools = child_allowed,
            disallowed_tools = child_disallowed,
            omit_claudemd = !is_fork && oa_agent_should_trim_claudemd(def),
            read_only = def.read_only && !is_fork,
            is_subagent = true,
            is_fork = is_fork,
            fork_context_path = fork_path_s,
            transcript_path = of_s_init,
            max_turns = child_max_turns,
            is_async = is_bg,
            memory_scope = child_mem_scope,
            git = git_s,
          };
          tn_w := mww_task(tb[..], mt);
          if tn_w > 0 && proc_send(ph, cast(string) tb[0..<tn_w]) {
            started = true;
            r[0].local_subs[slot] = FwLocalSubProc.{
              active = true, done = false, is_bg = is_bg,
              h = ph, rec_idx = rec_idx, tool_idx = tidx,
            };
          } else {
            _ = proc_release(ph);
          }
        } else {
          _ = proc_release(ph);
        }
      }
      if !started {
        r[0].subagents[rec_idx].running = false;
        r[0].acc[0].tools[tidx].done = true;
        r[0].acc[0].tools[tidx].is_error = true;
        r[0].acc[0].tools[tidx].nres = fww_keep(r[0].acc[0].tools[tidx].res[..], "Failed to spawn standalone subagent subprocess.");
      } else if is_bg {
        of_s := cast(string) r[0].subagents[rec_idx].output_file[0..<r[0].subagents[rec_idx].noutput_file];
        r[0].acc[0].tools[tidx].nres = oa_agent_format_async_result(aid_s, desc_s, of_s, r[0].acc[0].tools[tidx].res[..]);
        r[0].acc[0].tools[tidx].is_error = false;
        r[0].acc[0].tools[tidx].done = true;
      } else {
        any_local_fg = true;
      }
      continue;
    }

    // Desktop host mode: append task object to MWW_DELEGATE tasks JSON array
    jo_obj(jo[..]);
    // A chat on the local model has local sub-agents: a computer with no cloud sign-in can still delegate.
    jo_key(jo[..], "level"); jo_str(jo[..], ifx claude_level.count > 0 then claude_level else ifx fww_run_is_local(r) then "inkling" else "neon");
    jo_key(jo[..], "task"); jo_str(jo[..], eff_prompt);
    jo_key(jo[..], "subagent_type"); jo_str(jo[..], ifx is_fork then "fork" else type_s);
    if desc_s.count > 0 { jo_key(jo[..], "description"); jo_str(jo[..], desc_s); }
    jo_key(jo[..], "agent_id"); jo_str(jo[..], aid_s);
    if is_fork {
      if child_model.count > 0 { jo_key(jo[..], "model"); jo_str(jo[..], child_model); }
      if child_eff.count > 0 { jo_key(jo[..], "effort"); jo_str(jo[..], child_eff); }
    } else if model_s.count > 0 {
      jo_key(jo[..], "model"); jo_str(jo[..], model_s);
    }
    if is_bg {
      jo_key(jo[..], "run_in_background"); jo_bool(jo[..], true);
      jo_key(jo[..], "is_async"); jo_bool(jo[..], true);
    }
    if child_allowed.count > 0 { jo_key(jo[..], "allowed_tools"); jo_str(jo[..], child_allowed); }
    if child_disallowed.count > 0 { jo_key(jo[..], "disallowed_tools"); jo_str(jo[..], child_disallowed); }
    if !is_fork && oa_agent_should_trim_claudemd(def) { jo_key(jo[..], "omit_claudemd"); jo_bool(jo[..], true); }
    if def.read_only && !is_fork { jo_key(jo[..], "read_only"); jo_bool(jo[..], true); }
    jo_key(jo[..], "git"); jo_str(jo[..], git_s);
    if eff_perm_mode.count > 0 { jo_key(jo[..], "mode"); jo_str(jo[..], eff_perm_mode); }
    if child_max_turns > 0 { jo_key(jo[..], "max_turns"); jo_int(jo[..], child_max_turns); }
    if child_mem_scope > 0 { jo_key(jo[..], "memory_scope"); jo_int(jo[..], child_mem_scope); }
    if of_s_init.count > 0 { jo_key(jo[..], "transcript_path"); jo_str(jo[..], of_s_init); }
    if is_fork { jo_key(jo[..], "is_fork"); jo_bool(jo[..], true); }
    if fork_path_s.count > 0 { jo_key(jo[..], "fork_context_path"); jo_str(jo[..], fork_path_s); }
    if r[0].subagents[rec_idx].nwt_path > 0 {
      jo_key(jo[..], "worktree_path"); jo_str(jo[..], cast(string) r[0].subagents[rec_idx].wt_path[0..<r[0].subagents[rec_idx].nwt_path]);
      jo_key(jo[..], "worktree_branch"); jo_str(jo[..], cast(string) r[0].subagents[rec_idx].wt_branch[0..<r[0].subagents[rec_idx].nwt_branch]);
      if r[0].subagents[rec_idx].norig_head > 0 {
        jo_key(jo[..], "worktree_orig_head"); jo_str(jo[..], cast(string) r[0].subagents[rec_idx].orig_head[0..<r[0].subagents[rec_idx].norig_head]);
      }
    }
    jo_end(jo[..]);

    r[0].delegate_slots[r[0].ndelegate_slots] = FwDelegateSlot.{tool_idx = tidx, rec_idx = rec_idx, is_bg = is_bg};
    r[0].ndelegate_slots += 1;
    launched_host += 1;
  }
  jo_end(jo[..]);

  if !r[0].host_agents {
    r[0].next_tool_idx = batch_start + count;
    if any_local_fg {
      r[0].waiting_local_delegate = true;
      return true;
    }
    return false;
  }

  if launched_host == 0 {
    r[0].next_tool_idx = batch_start + count;
    return false;
  }

  if jo[0].bad {
    for k: 0..<count {
      tidx := batch_start + k;
      if r[0].acc[0].tools[tidx].done { continue; }
      r[0].acc[0].tools[tidx].done = true;
      r[0].acc[0].tools[tidx].is_error = true;
      r[0].acc[0].tools[tidx].nres = fww_keep(r[0].acc[0].tools[tidx].res[..], "Subagent delegation payload exceeded buffer.");
    }
    return false;
  }

  if r[0].ndelegate_slots == 0 { return false; }   // every call of the batch was refused above

  r[0].next_ticket += 1;
  r[0].delegate_ticket = r[0].next_ticket;
  r[0].waiting_delegate = true;
  r[0].next_tool_idx = batch_start + count;
  fww_send(out, mww_delegate_ex(out, jo_text(jo[..]), r[0].delegate_ticket, true));
  _ = cfg;
  return true;
}

// Shared single-line drain for standalone local subagent subprocesses (used by polling AND blocking TaskOutput).
// Returns: 0 = PROC_TIMEOUT (no line ready), 1 = line processed, 2 = subprocess finished/EOF (done=true, reaped).
fww_local_sub_step :: (r: [] FwRun, si: int, timeout_ms: int, active_io: [] bool) -> int {
  ph := r[0].local_subs[si].h;
  if ph < 0 { r[0].local_subs[si].done = true; return 2; }
  lbuf: [16384] u8;
  ln := proc_line(ph, timeout_ms, lbuf[..]);
  if ln == PROC_TIMEOUT { return 0; }
  if ln == PROC_TOO_LONG { active_io[0] = true; return 1; }
  if ln == PROC_EOF || ln < 0 {
    _ = proc_wait(ph, 500);
    _ = proc_release(ph);
    r[0].local_subs[si].h = -1;
    r[0].local_subs[si].done = true;
    if r[0].local_subs[si].nreply == 0 { r[0].local_subs[si].exit_c = 1; }
    active_io[0] = true;
    return 2;
  }
  active_io[0] = true;
  abuf: [16384] u8;
  ar := [1] ClArena.[ClArena.{buf = abuf[..]}];
  l: [1] MwwLine;
  ans_b: [256] u8;
  kind := mww_read(ar[..], cast(string) lbuf[0..<ln], l[..]);
  if kind == MWW_ASK && l[0].ticket.ok {
    an := mww_answer(ans_b[..], true, l[0].ticket.value, "");
    if an > 0 { _ = proc_send(ph, cast(string) ans_b[0..<an]); }
  } else if kind == MWW_PERMIT && l[0].ticket.ok {
    // Standalone headless subagents cannot prompt interactively; fail closed so child never deadlocks (#14123).
    an := mww_answer(ans_b[..], false, l[0].ticket.value, "Standalone subagent cannot prompt interactively.");
    if an > 0 { _ = proc_send(ph, cast(string) ans_b[0..<an]); }
  } else if kind == MWW_COMMAND || kind == MWW_VIEW {
    r[0].local_subs[si].calls += 1;
  } else if kind == MWW_ATTEMPT {
    if l[0].input_tokens.ok && l[0].input_tokens.value > 0 { r[0].local_subs[si].tokens += l[0].input_tokens.value; }
    if l[0].output_tokens.ok && l[0].output_tokens.value > 0 { r[0].local_subs[si].tokens += l[0].output_tokens.value; }
  } else if kind == MWW_REPLY && l[0].text.count > 0 {
    r[0].local_subs[si].nreply = fww_keep(r[0].local_subs[si].reply[..], l[0].text);
  } else if kind == MWW_ENDED {
    if l[0].text.count > 0 { r[0].local_subs[si].nreply = fww_keep(r[0].local_subs[si].reply[..], l[0].text); }
    r[0].local_subs[si].exit_c = ifx l[0].ending == "finished" || l[0].ending == "asked" then 0 else 1;
    _ = proc_kill(ph, PROC_SIGTERM);
    if proc_wait(ph, 500) < 0 { _ = proc_kill(ph, PROC_SIGKILL); _ = proc_wait(ph, 400); }
    _ = proc_release(ph);
    r[0].local_subs[si].h = -1;
    r[0].local_subs[si].done = true;
    return 2;
  }
  return 1;
}

// Updates FwSubagentRec state, append-only fallback JSONL, and fail-closed worktree cleanup for a completed local child.
fww_finalize_local_sub_rec :: (r: [] FwRun, si: int, out_wt_kept: [] bool) {
  out_wt_kept[0] = false;
  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];
  ri := r[0].local_subs[si].rec_idx;
  rep_s := cast(string) r[0].local_subs[si].reply[0..<r[0].local_subs[si].nreply];
  r[0].subagents[ri].running = false;
  r[0].subagents[ri].failed = r[0].local_subs[si].exit_c != 0;
  r[0].subagents[ri].nlast_reply = fww_keep(r[0].subagents[ri].last_reply[..], rep_s);
  pr_s := ifx r[0].subagents[ri].nlast_prompt > 0
          then cast(string) r[0].subagents[ri].last_prompt[0..<r[0].subagents[ri].nlast_prompt]
          else cast(string) r[0].subagents[ri].desc[0..<r[0].subagents[ri].ndesc];
  fww_subagent_append_fallback_jsonl(r, ri, pr_s, rep_s);
  if r[0].subagents[ri].nwt_path > 0 {
    wp := cast(string) r[0].subagents[ri].wt_path[0..<r[0].subagents[ri].nwt_path];
    wb := cast(string) r[0].subagents[ri].wt_branch[0..<r[0].subagents[ri].nwt_branch];
    oh := cast(string) r[0].subagents[ri].orig_head[0..<r[0].subagents[ri].norig_head];
    if !fww_wt_cleanup_fail_closed(cwd, wp, wb, oh) {
      out_wt_kept[0] = true;
    } else {
      r[0].subagents[ri].nwt_path = 0;
      r[0].subagents[ri].nwt_branch = 0;
    }
  }
}

// Polls standalone child oa-worker subprocesses non-blockingly; returns ended reason if turn completes.
fww_poll_local_subagents :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, out: [] u8, active_io: [] bool) -> string {
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if !r[0].local_subs[si].active || r[0].local_subs[si].done { continue; }
    for step: 0..<32 {
      rc := fww_local_sub_step(r, si, 0, active_io);
      if rc != 1 { break; }
    }

    // Handle completed background standalone subagent -> automatic <task-notification>
    if r[0].local_subs[si].done && r[0].local_subs[si].is_bg {
      wt_kept := [1] bool.[false];
      fww_finalize_local_sub_rec(r, si, wt_kept[..]);
      ri := r[0].local_subs[si].rec_idx;
      aid_s := cast(string) r[0].subagents[ri].agent_id[0..<r[0].subagents[ri].nagent_id];
      desc_s := cast(string) r[0].subagents[ri].desc[0..<r[0].subagents[ri].ndesc];
      of_s := cast(string) r[0].subagents[ri].output_file[0..<r[0].subagents[ri].noutput_file];
      rep_s := cast(string) r[0].local_subs[si].reply[0..<r[0].local_subs[si].nreply];
      dur_ms := ifx r[0].subagents[ri].start_ms > 0 then proc_now_ms() - r[0].subagents[ri].start_ms else 0;
      nb: [6144] u8;
      nn := oa_agent_format_task_notification(aid_s, ifx r[0].local_subs[si].exit_c == 0 then "completed" else "failed", desc_s, rep_s, of_s, r[0].local_subs[si].tokens, r[0].local_subs[si].calls, dur_ms, nb[..]);
      if nn > 0 && r[0].active {
        _ = mc_steer_add(st, aid_s, cast(string) nb[0..<nn]);
      }
      r[0].local_subs[si].active = false;
    }
  }

  if !r[0].waiting_local_delegate { return ""; }

  // Check if all foreground standalone subagents have finished
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if r[0].local_subs[si].active && !r[0].local_subs[si].is_bg && !r[0].local_subs[si].done {
      return "";
    }
  }

  // Finalize all foreground standalone subagents and advance parent tools
  r[0].waiting_local_delegate = false;
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if !r[0].local_subs[si].active || r[0].local_subs[si].is_bg { continue; }
    wt_kept := [1] bool.[false];
    fww_finalize_local_sub_rec(r, si, wt_kept[..]);
    ri := r[0].local_subs[si].rec_idx;
    tidx := r[0].local_subs[si].tool_idx;
    aid_s := cast(string) r[0].subagents[ri].agent_id[0..<r[0].subagents[ri].nagent_id];
    rep_s := cast(string) r[0].local_subs[si].reply[0..<r[0].local_subs[si].nreply];
    wt_kept_path := ifx wt_kept[0] then cast(string) r[0].subagents[ri].wt_path[0..<r[0].subagents[ri].nwt_path] else "";
    wt_kept_branch := ifx wt_kept[0] then cast(string) r[0].subagents[ri].wt_branch[0..<r[0].subagents[ri].nwt_branch] else "";
    def := OaAgentDef.{one_shot = r[0].subagents[ri].one_shot};
    dur_ms := ifx r[0].subagents[ri].start_ms > 0 then proc_now_ms() - r[0].subagents[ri].start_ms else 0;
    r[0].acc[0].tools[tidx].nres = oa_agent_format_sync_result(def, aid_s, rep_s, r[0].local_subs[si].tokens, r[0].local_subs[si].calls, dur_ms, wt_kept_path, wt_kept_branch, r[0].acc[0].tools[tidx].res[..]);
    r[0].acc[0].tools[tidx].is_error = r[0].local_subs[si].exit_c != 0;
    r[0].acc[0].tools[tidx].done = true;
    r[0].local_subs[si].active = false;
  }
  return fww_advance_tools(r, cfg, auth, h, b, st, out);
}

// Returns true if any standalone local subagent subprocess is still running.
fww_has_active_local_subs :: (r: [] FwRun) -> bool {
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if r[0].local_subs[si].active && !r[0].local_subs[si].done { return true; }
  }
  return false;
}

// Polls background standalone subagents while the parent turn is idle and enqueues
// automatic <task-notification> into MwQueue so fww_dispatch wakes the parent turn (#14096).
fww_poll_idle_local_bg :: (r: [] FwRun, q: [] MwQueue, f: [] FwFollow, out: [] u8, active_io: [] bool) {
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if !r[0].local_subs[si].active || !r[0].local_subs[si].is_bg || r[0].local_subs[si].done { continue; }
    for step: 0..<32 {
      rc := fww_local_sub_step(r, si, 0, active_io);
      if rc != 1 { break; }
    }
    if r[0].local_subs[si].done {
      wt_kept := [1] bool.[false];
      fww_finalize_local_sub_rec(r, si, wt_kept[..]);
      ri := r[0].local_subs[si].rec_idx;
      aid_s := cast(string) r[0].subagents[ri].agent_id[0..<r[0].subagents[ri].nagent_id];
      desc_s := cast(string) r[0].subagents[ri].desc[0..<r[0].subagents[ri].ndesc];
      of_s := cast(string) r[0].subagents[ri].output_file[0..<r[0].subagents[ri].noutput_file];
      rep_s := cast(string) r[0].local_subs[si].reply[0..<r[0].local_subs[si].nreply];
      dur_ms := ifx r[0].subagents[ri].start_ms > 0 then proc_now_ms() - r[0].subagents[ri].start_ms else 0;
      nb: [6144] u8;
      nn := oa_agent_format_task_notification(aid_s, ifx r[0].local_subs[si].exit_c == 0 then "completed" else "failed", desc_s, rep_s, of_s, r[0].local_subs[si].tokens, r[0].local_subs[si].calls, dur_ms, nb[..]);
      if nn > 0 && f[0].nlast > 0 {
        // Reuse the last parent task template with the notification text so fww_dispatch starts a wake-up turn
        msg_b: [MWQ_MESSAGE] u8;
        ntxt := cast(string) nb[0..<nn];
        tw := fww_task_with(f, ntxt, msg_b[..]);
        if tw.count > 0 && mwq_add(q, aid_s, ntxt, tw).count == 0 {
          fww_queue_changed(q, f, out);
        }
      }
      r[0].local_subs[si].active = false;
    }
  }
}

// Processes MWW_RESULTS from the host for the active parallel Agent batch.
fww_finish_delegate_results :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, results_json: string, out: [] u8) -> string {
  r[0].waiting_delegate = false;
  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];
  ar_buf: [65536] u8;
  ar := [1] ClArena.[ClArena.{buf = ar_buf[..]}];
  nitems := ifx results_json.count > 1 && results_json[0] == '[' then cl_count(results_json) else 0;

  for q: 0..<r[0].ndelegate_slots {
    slot := r[0].delegate_slots[q];
    tidx := slot.tool_idx;
    ri := slot.rec_idx;
    ar[0].at = 0; ar[0].full = false;
    exit_c := 0;
    reply_s := "";
    status_s := "";
    calls := 0; tokens := 0; dur_ms := 0;
    if q < nitems {
      one := cl_json(results_json, cl_item(results_json, q));
      ex := cl_int(one, "exit");
      if ex.ok { exit_c = ex.value; }
      reply_s = cl_str(ar[..], one, "output");
      status_s = cl_str(ar[..], one, "status");
      cc := cl_int(one, "calls"); if cc.ok { calls = cc.value; }
      tk := cl_int(one, "tokens"); if tk.ok { tokens = tk.value; }
      dm := cl_int(one, "duration_ms"); if dm.ok { dur_ms = dm.value; }
    } else {
      exit_c = 1;
      reply_s = "Subagent returned no result.";
    }

    aid_s := cast(string) r[0].subagents[ri].agent_id[0..<r[0].subagents[ri].nagent_id];
    desc_s := cast(string) r[0].subagents[ri].desc[0..<r[0].subagents[ri].ndesc];
    of_s := cast(string) r[0].subagents[ri].output_file[0..<r[0].subagents[ri].noutput_file];

    if status_s == "async_launched" || slot.is_bg {
      r[0].subagents[ri].is_bg = true;
      r[0].acc[0].tools[tidx].nres = oa_agent_format_async_result(aid_s, desc_s, of_s, r[0].acc[0].tools[tidx].res[..]);
      r[0].acc[0].tools[tidx].is_error = false;
      r[0].acc[0].tools[tidx].done = true;
      continue;
    }

    r[0].subagents[ri].running = false;
    r[0].subagents[ri].failed = exit_c != 0;
    r[0].subagents[ri].nlast_reply = fww_keep(r[0].subagents[ri].last_reply[..], reply_s);
    pr_s := ifx r[0].subagents[ri].nlast_prompt > 0
            then cast(string) r[0].subagents[ri].last_prompt[0..<r[0].subagents[ri].nlast_prompt]
            else desc_s;
    fww_subagent_append_fallback_jsonl(r, ri, pr_s, reply_s);

    // Fail-closed worktree cleanup if isolated
    wt_kept_path := "";
    wt_kept_branch := "";
    if r[0].subagents[ri].nwt_path > 0 {
      wp := cast(string) r[0].subagents[ri].wt_path[0..<r[0].subagents[ri].nwt_path];
      wb := cast(string) r[0].subagents[ri].wt_branch[0..<r[0].subagents[ri].nwt_branch];
      oh := cast(string) r[0].subagents[ri].orig_head[0..<r[0].subagents[ri].norig_head];
      if !fww_wt_cleanup_fail_closed(cwd, wp, wb, oh) {
        wt_kept_path = wp;
        wt_kept_branch = wb;
      } else {
        r[0].subagents[ri].nwt_path = 0;
        r[0].subagents[ri].nwt_branch = 0;
      }
    }

    def := OaAgentDef.{one_shot = r[0].subagents[ri].one_shot};
    if dur_ms <= 0 && r[0].subagents[ri].start_ms > 0 {
      dur_ms = proc_now_ms() - r[0].subagents[ri].start_ms;
    }
    r[0].acc[0].tools[tidx].nres = oa_agent_format_sync_result(
      def, aid_s, reply_s, tokens, calls, dur_ms, wt_kept_path, wt_kept_branch, r[0].acc[0].tools[tidx].res[..]
    );
    r[0].acc[0].tools[tidx].is_error = exit_c != 0;
    r[0].acc[0].tools[tidx].done = true;
  }

  r[0].ndelegate_slots = 0;
  return fww_advance_tools(r, cfg, auth, h, b, st, out);
}

// ---------------------------------------------------------------- SendMessage / TaskStop / TaskOutput / Worktree tools

fww_tool_task_stop :: (r: [] FwRun, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [64] JvNode; d: [1] Jv;
  tb: [64] u8; tn := 0;
  if jv_parse(d[..], args_json, nodes[..]) {
    tn = jv_str(d[0], jv_get(d[0], 0, "task_id"), tb[..]);
  }
  if tn <= 0 { is_err[0] = true; return fww_keep(out_res, "TaskStop requires task_id."); }
  tid := cast(string) tb[0..<tn];
  ri := fww_find_subagent_rec(r, tid);
  if ri < 0 { is_err[0] = true; return fww_keep(out_res, "No subagent found with that task_id."); }
  r[0].subagents[ri].running = false;
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if r[0].local_subs[si].active && r[0].local_subs[si].rec_idx == ri {
      fww_kill_local_sub(r, si);
    }
  }
  if r[0].host_agents && r[0].subagents[ri].host_num > 0 {
    fww_send(wire_out, mww_stop_agent(wire_out, r[0].subagents[ri].host_num));
  }
  n := fww_cat(out_res, 0, "Stopped subagent ");
  return fww_cat(out_res, n, tid);
}

// Pure parser for TaskOutput arguments: task_id, block (default true), timeout ms (clamped via #authority).
fww_parse_task_output_args :: (args_json: string, out_tid: [] u8, out_tid_n: [] int, out_wait_ms: [] int) -> bool {
  out_tid_n[0] = 0;
  out_wait_ms[0] = 0;
  nodes: [64] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  tn := jv_str(d[0], jv_get(d[0], 0, "task_id"), out_tid);
  if tn <= 0 { return false; }
  out_tid_n[0] = tn;
  blk_n := jv_get(d[0], 0, "block");
  block := true;
  if blk_n >= 0 {
    if jv_kind(d[0], blk_n) == JV_FALSE { block = false; }
    else if jv_kind(d[0], blk_n) == JV_TRUE { block = true; }
  }
  to_n := jv_get(d[0], 0, "timeout");
  has_to := to_n >= 0 && jv_kind(d[0], to_n) == JV_NUMBER;
  raw_to := ifx has_to then jv_int(d[0], to_n, 0) else 0;
  out_wait_ms[0] = flawed_task_output_effective_timeout_ms(block, has_to, raw_to);
  return true;
}

fww_tool_task_output :: (r: [] FwRun, args_json: string, out_res: [] u8, is_err: [] bool) -> int {
  is_err[0] = false;
  tb: [64] u8; tn := [1] int.[0]; wait_ms := [1] int.[0];
  if !fww_parse_task_output_args(args_json, tb[..], tn[..], wait_ms[..]) {
    is_err[0] = true;
    return fww_keep(out_res, "TaskOutput requires task_id.");
  }
  tid := cast(string) tb[0..<tn[0]];
  ri := fww_find_or_load_subagent_rec(r, tid);
  if ri < 0 { is_err[0] = true; return fww_keep(out_res, "No subagent found with that task_id."); }

  timed_out := false;
  if wait_ms[0] > 0 && !r[0].host_agents && r[0].subagents[ri].running {
    // Locate matching active local subprocess and block-wait up to remaining deadline (#14122).
    si_match := -1;
    for si: 0..<FWW_MAX_DELEGATE_BATCH {
      if r[0].local_subs[si].active && !r[0].local_subs[si].done && r[0].local_subs[si].rec_idx == ri && r[0].local_subs[si].h >= 0 {
        si_match = si; break;
      }
    }
    if si_match >= 0 {
      deadline := proc_now_ms() + wait_ms[0];
      io_flag := [1] bool.[false];
      while !r[0].local_subs[si_match].done {
        rem := deadline - proc_now_ms();
        if rem <= 0 { timed_out = true; break; }
        step_ms := ifx rem < 200 then rem else 200;
        rc := fww_local_sub_step(r, si_match, step_ms, io_flag[..]);
        if rc == 2 { break; }
      }
      if r[0].local_subs[si_match].done {
        wt_kept := [1] bool.[false];
        fww_finalize_local_sub_rec(r, si_match, wt_kept[..]);
        r[0].local_subs[si_match].active = false;
      } else if r[0].local_subs[si_match].nreply > 0 {
        r[0].subagents[ri].nlast_reply = fww_keep(r[0].subagents[ri].last_reply[..], cast(string) r[0].local_subs[si_match].reply[0..<r[0].local_subs[si_match].nreply]);
      }
    }
  }

  n := fww_cat(out_res, 0, "agentId: ");
  n = fww_cat(out_res, n, cast(string) r[0].subagents[ri].agent_id[0..<r[0].subagents[ri].nagent_id]);
  n = fww_cat(out_res, n, "\nstatus: ");
  n = fww_cat(out_res, n, ifx r[0].subagents[ri].running then "running" else ifx r[0].subagents[ri].failed then "failed" else "completed");
  if timed_out && r[0].subagents[ri].running {
    n = fww_cat(out_res, n, "\ntimed_out: true");
  }
  if r[0].subagents[ri].noutput_file > 0 {
    n = fww_cat(out_res, n, "\noutput_file: ");
    n = fww_cat(out_res, n, cast(string) r[0].subagents[ri].output_file[0..<r[0].subagents[ri].noutput_file]);
  }
  if r[0].subagents[ri].nlast_reply > 0 {
    n = fww_cat(out_res, n, "\n\n");
    n = fww_cat(out_res, n, cast(string) r[0].subagents[ri].last_reply[0..<r[0].subagents[ri].nlast_reply]);
  }
  return n;
}

fww_tool_send_message :: (r: [] FwRun, tidx: int, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> bool {
  is_err[0] = false;
  nodes: [64] JvNode; d: [1] Jv;
  to_b: [64] u8; msg_b: [4096] u8;
  ton := 0; mn := 0;
  if jv_parse(d[..], args_json, nodes[..]) {
    ton = jv_str(d[0], jv_get(d[0], 0, "to"), to_b[..]);
    mn = jv_str(d[0], jv_get(d[0], 0, "message"), msg_b[..]);
  }
  if ton <= 0 || mn <= 0 {
    is_err[0] = true;
    r[0].acc[0].tools[tidx].nres = fww_keep(out_res, "SendMessage requires both `to` and `message`.");
    r[0].acc[0].tools[tidx].is_error = true;
    r[0].acc[0].tools[tidx].done = true;
    return false;
  }
  to_s := cast(string) to_b[0..<ton];
  msg_s := cast(string) msg_b[0..<mn];
  ri := fww_find_or_load_subagent_rec(r, to_s);
  if ri < 0 {
    is_err[0] = true;
    r[0].acc[0].tools[tidx].nres = fww_keep(out_res, "No subagent found matching `to`.");
    r[0].acc[0].tools[tidx].is_error = true;
    r[0].acc[0].tools[tidx].done = true;
    return false;
  }

  aid_s := cast(string) r[0].subagents[ri].agent_id[0..<r[0].subagents[ri].nagent_id];
  stype_s := ifx r[0].subagents[ri].nsubagent_type > 0
             then cast(string) r[0].subagents[ri].subagent_type[0..<r[0].subagents[ri].nsubagent_type]
             else "general-purpose";
  of_s := cast(string) r[0].subagents[ri].output_file[0..<r[0].subagents[ri].noutput_file];
  has_jsonl := of_s.count > 0 && fs_kind(of_s) == FS_FILE && fs_size(of_s) > 0;
  pm_s := cast(string) r[0].subagents[ri].perm_mode[0..<r[0].subagents[ri].nperm_mode];
  git_s := mc_gg_publish_rule(cast(string) r[0].subagents[ri].git[0..<r[0].subagents[ri].ngit]);
  sid_s := ifx r[0].subagents[ri].nsession_id > 0
           then cast(string) r[0].subagents[ri].session_id[0..<r[0].subagents[ri].nsession_id]
           else cast(string) r[0].session_id[0..<r[0].nsession_id];
  r[0].subagents[ri].nlast_prompt = fww_keep(r[0].subagents[ri].last_prompt[..], msg_s);
  r[0].subagents[ri].output_file_size_before = ifx has_jsonl then fs_size(of_s) else 0;

  // Lookup persona definition to restore tool filters, maxTurns, and memoryScope on resume
  def_idx := oa_agents_find(r[0].agent_reg[..], stype_s);
  allowed_s := ifx def_idx >= 0 then cast(string) r[0].agent_reg[0].defs[def_idx].allowed_tools[0..<r[0].agent_reg[0].defs[def_idx].nallowed] else "";
  disallowed_s := ifx def_idx >= 0 then cast(string) r[0].agent_reg[0].defs[def_idx].disallowed_tools[0..<r[0].agent_reg[0].defs[def_idx].ndisallowed] else "";
  res_max_turns := ifx r[0].subagents[ri].max_turns > 0 then r[0].subagents[ri].max_turns else ifx def_idx >= 0 then r[0].agent_reg[0].defs[def_idx].max_turns else 0;
  res_mem_scope := ifx r[0].subagents[ri].memory_scope > 0 then r[0].subagents[ri].memory_scope else ifx def_idx >= 0 then r[0].agent_reg[0].defs[def_idx].memory_scope else 0;

  if !r[0].host_agents {
    // Standalone headless mode: steer running local child if active, else respawn hydrating DAG JSONL.
    for si: 0..<FWW_MAX_DELEGATE_BATCH {
      if r[0].local_subs[si].active && !r[0].local_subs[si].done && r[0].local_subs[si].rec_idx == ri && r[0].local_subs[si].h >= 0 {
        sb: [4608] u8;
        sn := mww_steer(sb[..], "sm", msg_s, 0);
        if sn > 0 && proc_send(r[0].local_subs[si].h, cast(string) sb[0..<sn]) {
          r[0].acc[0].tools[tidx].nres = fww_keep(out_res, "Steered running subagent.");
          r[0].acc[0].tools[tidx].is_error = false;
          r[0].acc[0].tools[tidx].done = true;
          return false;
        }
      }
    }
    slot := -1;
    for si: 0..<FWW_MAX_DELEGATE_BATCH { if !r[0].local_subs[si].active { slot = si; break; } }
    self_b: [FS_PATH_MAX] u8;
    self_bin := fww_self_worker_bin(self_b[..]);
    wt_cand := ifx r[0].subagents[ri].nwt_path > 0 then cast(string) r[0].subagents[ri].wt_path[0..<r[0].subagents[ri].nwt_path] else "";
    eff_cwd := ifx wt_cand.count > 0 && fs_kind(wt_cand) == FS_DIR then wt_cand else cast(string) r[0].cwd[0..<r[0].ncwd];
    comb: [6144] u8;
    resume_prompt := msg_s;
    if !has_jsonl {
      cn := fww_cat(comb[..], 0, "Continuing previous subagent session.\nPrevious findings:\n");
      cn = fww_cat(comb[..], cn, cast(string) r[0].subagents[ri].last_reply[0..<r[0].subagents[ri].nlast_reply]);
      cn = fww_cat(comb[..], cn, "\n\nFollow-up message:\n");
      cn = fww_cat(comb[..], cn, msg_s);
      resume_prompt = cast(string) comb[0..<cn];
    }
    ph := ifx slot >= 0 then proc_new() else -1;
    started := false;
    if ph >= 0 {
      if proc_arg(ph, self_bin) && proc_cwd(ph, eff_cwd) && proc_start(ph) == 0 {
        tb: [16384] u8;
        mt := McTask.{
          task = resume_prompt, session = ifx sid_s.count > 0 then sid_s else aid_s, cwd = eff_cwd,
          sandbox = "danger-full-access", ceiling = 3, gated = false,
          edits = !r[0].subagents[ri].read_only, unlimited = true, no_ask = true, no_steer = false,
          model = cast(string) r[0].model[0..<r[0].nmodel],
          effort = cast(string) r[0].effort[0..<r[0].neffort],
          mode = pm_s,
          subagent_type = stype_s, agent_id = aid_s,
          allowed_tools = allowed_s, disallowed_tools = disallowed_s,
          read_only = r[0].subagents[ri].read_only, is_subagent = true,
          git = git_s,
          resume_transcript_path = ifx has_jsonl then of_s else "",
          transcript_path = of_s,
          max_turns = res_max_turns,
          memory_scope = res_mem_scope,
        };
        tn_w := mww_task(tb[..], mt);
        if tn_w > 0 && proc_send(ph, cast(string) tb[0..<tn_w]) {
          started = true;
          r[0].subagents[ri].running = true;
          r[0].subagents[ri].failed = false;
          r[0].subagents[ri].start_ms = proc_now_ms();
          r[0].local_subs[slot] = FwLocalSubProc.{
            active = true, done = false, is_bg = false,
            h = ph, rec_idx = ri, tool_idx = tidx,
          };
          r[0].waiting_local_delegate = true;
        } else {
          _ = proc_release(ph);
        }
      } else {
        _ = proc_release(ph);
      }
    }
    if !started {
      is_err[0] = true;
      r[0].acc[0].tools[tidx].nres = fww_keep(out_res, "Failed to spawn standalone subagent resume process.");
      r[0].acc[0].tools[tidx].is_error = true;
      r[0].acc[0].tools[tidx].done = true;
      return false;
    }
    return true;
  }

  // Desktop host mode: build a single-task MWW_DELEGATE resume/follow-up
  tasks_buf: [8192] u8;
  jo: [1] Jo;
  jo_start(jo[..], tasks_buf[..]);
  jo_arr(jo[..]);
  jo_obj(jo[..]);
  // A resumed sub-agent runs where it first ran, under the git rule it first had.
  jo_key(jo[..], "level"); jo_str(jo[..], ifx r[0].subagents[ri].nlevel > 0 then cast(string) r[0].subagents[ri].level[0..<r[0].subagents[ri].nlevel] else "neon");
  jo_key(jo[..], "git"); jo_str(jo[..], git_s);   // already under the owner's limit
  if r[0].subagents[ri].running && r[0].subagents[ri].host_num > 0 {
    jo_key(jo[..], "resume"); jo_int(jo[..], r[0].subagents[ri].host_num);
    jo_key(jo[..], "task"); jo_str(jo[..], msg_s);
  } else {
    if has_jsonl {
      jo_key(jo[..], "task"); jo_str(jo[..], msg_s);
      jo_key(jo[..], "resume_transcript_path"); jo_str(jo[..], of_s);
    } else {
      comb: [6144] u8;
      cn := fww_cat(comb[..], 0, "Continuing previous subagent session.\nPrevious findings:\n");
      cn = fww_cat(comb[..], cn, cast(string) r[0].subagents[ri].last_reply[0..<r[0].subagents[ri].nlast_reply]);
      cn = fww_cat(comb[..], cn, "\n\nFollow-up message:\n");
      cn = fww_cat(comb[..], cn, msg_s);
      jo_key(jo[..], "task"); jo_str(jo[..], cast(string) comb[0..<cn]);
    }
    if of_s.count > 0 { jo_key(jo[..], "transcript_path"); jo_str(jo[..], of_s); }
    jo_key(jo[..], "subagent_type"); jo_str(jo[..], stype_s);
    jo_key(jo[..], "agent_id"); jo_str(jo[..], aid_s);
    if r[0].subagents[ri].read_only { jo_key(jo[..], "read_only"); jo_bool(jo[..], true); }
    if pm_s.count > 0 { jo_key(jo[..], "mode"); jo_str(jo[..], pm_s); }
    if res_max_turns > 0 { jo_key(jo[..], "max_turns"); jo_int(jo[..], res_max_turns); }
    if res_mem_scope > 0 { jo_key(jo[..], "memory_scope"); jo_int(jo[..], res_mem_scope); }
    if allowed_s.count > 0 { jo_key(jo[..], "allowed_tools"); jo_str(jo[..], allowed_s); }
    if disallowed_s.count > 0 { jo_key(jo[..], "disallowed_tools"); jo_str(jo[..], disallowed_s); }
    if r[0].subagents[ri].nwt_path > 0 {
      jo_key(jo[..], "worktree_path"); jo_str(jo[..], cast(string) r[0].subagents[ri].wt_path[0..<r[0].subagents[ri].nwt_path]);
    }
  }
  jo_end(jo[..]);
  jo_end(jo[..]);

  r[0].next_ticket += 1;
  r[0].delegate_ticket = r[0].next_ticket;
  r[0].waiting_delegate = true;
  r[0].delegate_slots[0] = FwDelegateSlot.{tool_idx = tidx, rec_idx = ri, is_bg = false};
  r[0].ndelegate_slots = 1;
  fww_send(wire_out, mww_delegate_ex(wire_out, jo_text(jo[..]), r[0].delegate_ticket, true));
  return true;
}

fww_tool_enter_worktree :: (r: [] FwRun, args_json: string, out_res: [] u8, is_err: [] bool) -> int {
  is_err[0] = false;
  if r[0].session_wt_active {
    is_err[0] = true;
    return fww_keep(out_res, "Already inside an active session worktree. Call ExitWorktree first.");
  }
  nodes: [64] JvNode; d: [1] Jv;
  nb: [64] u8; nn := 0;
  if jv_parse(d[..], args_json, nodes[..]) {
    nn = jv_str(d[0], jv_get(d[0], 0, "name"), nb[..]);
  }
  slug := ifx nn > 0 then cast(string) nb[0..<nn] else "session-wt";
  if !flawed_wt_validate_slug(slug) {
    is_err[0] = true;
    return fww_keep(out_res, "Invalid worktree slug name (allowed: A-Z, a-z, 0-9, '.', '_', '-', '/'; max 64 bytes).");
  }
  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];
  home_s := cast(string) r[0].home[0..<r[0].nhome];
  wt_p: [FS_PATH_MAX] u8;
  wt_br: [96] u8;
  wt_hd: [64] u8;
  if !fww_wt_create(cwd, home_s, slug, wt_p[..], wt_br[..], wt_hd[..]) {
    is_err[0] = true;
    return fww_keep(out_res, "Failed to create git worktree.");
  }
  wpn := 0; while wpn < wt_p.count && wt_p[wpn] != 0 { wpn += 1; }
  wbn := 0; while wbn < wt_br.count && wt_br[wbn] != 0 { wbn += 1; }
  ohn := 0; while ohn < wt_hd.count && wt_hd[ohn] != 0 { ohn += 1; }
  entered_path := cast(string) wt_p[0..<wpn];

  r[0].norig_cwd = fww_keep(r[0].orig_cwd[..], cwd);
  r[0].ncwd = fww_keep(r[0].cwd[..], entered_path);
  r[0].nsession_wt_branch = fww_keep_z(r[0].session_wt_branch[..], cast(string) wt_br[0..<wbn]);
  r[0].nsession_wt_orig_head = fww_keep_z(r[0].session_wt_orig_head[..], cast(string) wt_hd[0..<ohn]);
  wt_root_b: [FS_PATH_MAX] u8;
  dummy_rel: [1] u8;
  dummy_n := [1] int.[0];
  if fww_wt_resolve_git_root(entered_path, wt_root_b[..], dummy_rel[0..<0], dummy_n[..]) {
    wrn := 0; while wrn < wt_root_b.count && wt_root_b[wrn] != 0 { wrn += 1; }
    r[0].nsession_wt_root = fww_keep_z(r[0].session_wt_root[..], cast(string) wt_root_b[0..<wrn]);
  } else {
    r[0].nsession_wt_root = fww_keep_z(r[0].session_wt_root[..], entered_path);
  }
  r[0].session_wt_active = true;
  fww_invalidate_cwd_caches(r);
  n := fww_cat(out_res, 0, "Entered isolated git worktree at ");
  n = fww_cat(out_res, n, entered_path);
  n = fww_cat(out_res, n, " (branch ");
  n = fww_cat(out_res, n, cast(string) r[0].session_wt_branch[0..<r[0].nsession_wt_branch]);
  return fww_cat(out_res, n, ").");
}

fww_tool_exit_worktree :: (r: [] FwRun, args_json: string, out_res: [] u8, is_err: [] bool) -> int {
  is_err[0] = false;
  nodes: [64] JvNode; d: [1] Jv;
  ab: [32] u8; an := 0; discard := false;
  if jv_parse(d[..], args_json, nodes[..]) {
    an = jv_str(d[0], jv_get(d[0], 0, "action"), ab[..]);
    discard = jv_bool(d[0], jv_get(d[0], 0, "discard_changes"));
  }
  act := cast(string) ab[0..<an];
  is_remove := act == "remove";
  wt_path := cast(string) r[0].cwd[0..<r[0].ncwd];
  orig_cwd := cast(string) r[0].orig_cwd[0..<r[0].norig_cwd];
  orig_head := cast(string) r[0].session_wt_orig_head[0..<r[0].nsession_wt_orig_head];

  wt_top_b: [FS_PATH_MAX] u8;
  repo_top_b: [FS_PATH_MAX] u8;
  dummy_rel: [1] u8;
  dummy_n := [1] int.[0];
  wt_top := "";
  if fww_wt_resolve_git_root(wt_path, wt_top_b[..], dummy_rel[0..<0], dummy_n[..]) {
    wn := 0; while wn < wt_top_b.count && wt_top_b[wn] != 0 { wn += 1; }
    wt_top = cast(string) wt_top_b[0..<wn];
  } else if r[0].nsession_wt_root > 0 {
    wt_top = cast(string) r[0].session_wt_root[0..<r[0].nsession_wt_root];
  } else {
    wt_top = wt_path;
  }
  repo_top := orig_cwd;
  if fww_wt_resolve_git_root(orig_cwd, repo_top_b[..], dummy_rel[0..<0], dummy_n[..]) {
    rn0 := 0; while rn0 < repo_top_b.count && repo_top_b[rn0] != 0 { rn0 += 1; }
    repo_top = cast(string) repo_top_b[0..<rn0];
  }

  sb: [2048] u8; cb: [256] u8; rb: [160] u8;
  st_argv := [2] string.["status", "--porcelain"];
  st_ok := [1] bool.[false];
  sn := fww_git_quick_argv(wt_top, st_argv[..], 1500, sb[..], st_ok[..]);
  st_out := fww_trim(cast(string) sb[0..<sn]);
  rn := fww_cat(rb[..], 0, orig_head); rn = fww_cat(rb[..], rn, "..HEAD");
  rev_argv := [3] string.["rev-list", "--count", cast(string) rb[0..<rn]];
  rev_ok := [1] bool.[false];
  cn := fww_git_quick_argv(wt_top, rev_argv[..], 1500, cb[..], rev_ok[..]);
  cnt_s := fww_trim(cast(string) cb[0..<cn]);
  git_ok := st_ok[0] && rev_ok[0] && orig_head.count >= 7 && cnt_s.count > 0;
  changed_files := ifx st_out.count > 0 then 1 else 0;
  commits := fww_parse_int(cnt_s, 1);

  if !flawed_wt_exit_allowed(r[0].session_wt_active, is_remove, discard, git_ok, orig_head.count >= 7, changed_files, commits) {
    is_err[0] = true;
    return fww_keep(out_res, "ExitWorktree refused (fail-closed): no active worktree or uncommitted/committed changes exist without discard_changes: true.");
  }
  br_b: [96] u8;
  br_n := fww_keep_z(br_b[..], cast(string) r[0].session_wt_branch[0..<r[0].nsession_wt_branch]);
  wt_branch := cast(string) br_b[0..<br_n];

  r[0].ncwd = fww_keep(r[0].cwd[..], orig_cwd);
  r[0].session_wt_active = false;
  r[0].nsession_wt_branch = 0;
  r[0].nsession_wt_orig_head = 0;
  r[0].nsession_wt_root = 0;
  fww_invalidate_cwd_caches(r);
  if is_remove {
    if wt_top.count > 0 && repo_top.count > 0 && wt_top != repo_top {
      _ = fww_git_exec(repo_top, "worktree", "remove", "--force", wt_top, "");
      _ = fww_git_exec(repo_top, "worktree", "prune", "", "", "");
      if wt_branch.count > 0 {
        _ = fww_git_exec(repo_top, "branch", "-D", wt_branch, "", "");
      }
    }
    return fww_keep(out_res, "Exited and removed session worktree.");
  }
  return fww_keep(out_res, "Exited session worktree (kept on disk).");
}
