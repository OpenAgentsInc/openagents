fww_fc :: (b: [] FwBufs) -> FlawedFileCache {
  return FlawedFileCache.{entries = b[0].fc_entries[..], slab = b[0].fc_slab[..], state = b[0].fc_state[..]};
}

fww_gw_name :: (backend: int) -> string {
  if backend == FLAWED_BE_LOCAL { return "psionic"; }
  if backend == FLAWED_BE_OURS { return "ours"; }
  if backend == FLAWED_BE_VERTEX { return "vertex"; }
  if backend == FLAWED_BE_GEMINI { return "gemini"; }
  return "openrouter";
}

// Compute turn cost in micro-USD (#14070):
// - Local Psionic Metal / Inkling models ALWAYS cost $0 unconditionally.
// - OpenAgents Cloud (FLAWED_BE_OURS) uses OpenAgents retail pricing ("ours" rate card).
// - Developer BYO backends use their gateway rate card (falling back to vertex).
fww_turn_cost_micros :: (backend: int, model: string, in_tok: int, cache_read: int, out_tok: int) -> int {
  if backend == FLAWED_BE_LOCAL || gw_is_local_model(model) { return 0; }
  gwn := fww_gw_name(backend);
  rf := gw_rate(gwn, model);
  if !rf.ok && backend == FLAWED_BE_OURS { rf = gw_rate("ours", "google/gemini-4-neon"); }
  if !rf.ok { rf = gw_rate("vertex", model); }
  if !rf.ok { return 0; }
  return gw_card_cost(rf.rate, in_tok, cache_read, 0, out_tok);
}

fww_emit_attempt :: (r: [] FwRun, auth: [] FwAuth, outcome: string, status: int, cost_micros: int, out: [] u8) {
  gw_name := fww_gw_name(auth[0].backend);
  mdl := ifx r[0].acc[0].nresp_model > 0 then cast(string) r[0].acc[0].resp_model[0..<r[0].acc[0].nresp_model] else cast(string) r[0].model[0..<r[0].nmodel];
  eff := cast(string) r[0].effort[0..<r[0].neffort];
  in_t := r[0].acc[0].in_tok;
  vals := [7] int.[
    ifx in_t > 0 then in_t else -1,
    ifx r[0].acc[0].out_tok > 0 then r[0].acc[0].out_tok else -1,
    ifx r[0].acc[0].cache_read > 0 then r[0].acc[0].cache_read else -1,
    -1,
    ifx r[0].acc[0].cache_write > 0 then r[0].acc[0].cache_write else -1,
    cost_micros,
    cost_micros,
  ];
  fww_send(out, mww_attempt(out, gw_name, mdl, eff, outcome, status, vals[..]));
  if outcome == "done" {
    now_ms := proc_now_ms();
    ttft := ifx r[0].first_tok_ms >= r[0].req_start_ms && r[0].first_tok_ms > 0 then r[0].first_tok_ms - r[0].req_start_ms else -1;
    if ttft == 0 { ttft = 1; }
    dec := ifx r[0].first_tok_ms > 0 && now_ms > r[0].first_tok_ms then now_ms - r[0].first_tok_ms else -1;
    if ttft > 0 || (r[0].acc[0].out_tok > 0 && dec > 0) {
      fww_send(out, mww_stats(out, ttft, dec, r[0].acc[0].out_tok));
    }
  }
}

// True FLAWED_THINK_ADAPTIVE step effort: keeps full requested effort ("high") across all core
// coding, debugging, and first post-edit audit steps; steps down to "medium" on cold Turn-1
// discovery, calm_steps cooldown after a heavy (>=90s) thinking turn or spiral, post-audit green
// follow-up steps, or once >=65% of an optional wall-clock budget has elapsed; and "low" once the
// anti-runaway finish guard triggers or >=85% of budget elapsed while already green.
fww_adaptive_effort :: (thinking_mode: int, raw_effort: string, step_num: int, nmsgs: int, has_edited: bool, last_bash_ok: bool, last_step_had_err: bool, audit_done: bool, finish_nudged: bool, calm_steps: int, elapsed_s: int, budget_s: int, bare_mode: bool) -> string {
  if thinking_mode != FLAWED_THINK_ADAPTIVE || bare_mode { return raw_effort; }
  if raw_effort == "high" || raw_effort == "xhigh" || raw_effort == "max" {
    if step_num == 1 && nmsgs <= 1 { return "medium"; }
    if has_edited && last_bash_ok && !last_step_had_err {
      if finish_nudged { return "low"; }
      if budget_s >= 120 && elapsed_s * 100 >= budget_s * 85 { return "low"; }
      if audit_done { return "medium"; }
    }
    if calm_steps > 0 { return "medium"; }
    if budget_s >= 120 && elapsed_s * 100 >= budget_s * 65 { return "medium"; }
  }
  return raw_effort;
}

// Pure check for cloud SSE dead-stream watchdog (aborts & retries only on >=150s of total silence with
// zero parsed content/thought/tool deltas, never interrupting active thinking or multi-edit tool batches).
fww_stream_stalled :: (streaming: bool, is_local: bool, stall_recoveries: int, last_rx_ms: int, now_ms: int) -> bool {
  if !streaming || is_local || stall_recoveries >= 1 || last_rx_ms <= 0 { return false; }
  return now_ms - last_rx_ms >= 150000;
}

// Pure check for cloud pure-thinking runaway spiral guard: triggers ONLY when zero visible text and
// zero tool calls have been emitted while active thinking (>=16K summarized thought chars) exceeds
// >=38K thought chars or the dynamic decode-time cap measured strictly from first_tok_ms (immune to
// API queueing/TTFT spikes: 205s default so healthy first-turn deep design up to ~180s completes
// uninterrupted, tightened to 40% of remaining wall budget clamped to [90s, 205s] when FLAWED_BUDGET_S
// is active). Preserves scratchpad conclusions and sets calm_steps=2 on recovery.
fww_think_spiral :: (streaming: bool, is_local: bool, recoveries: int, ntext: int, ntools: int, nthink: int, first_tok_ms: int, turn_start_ms: int, budget_s: int, now_ms: int) -> bool {
  if !streaming || is_local || recoveries >= 2 || ntext > 0 || ntools > 0 || nthink < 16000 { return false; }
  if nthink >= 38000 { return true; }
  cap_ms := 205000;
  if budget_s >= 120 && turn_start_ms > 0 && first_tok_ms >= turn_start_ms {
    rem_ms := budget_s * 1000 - (first_tok_ms - turn_start_ms);
    dyn_ms := (rem_ms * 40) / 100;
    if dyn_ms < 90000 { dyn_ms = 90000; }
    if dyn_ms < cap_ms { cap_ms = dyn_ms; }
  }
  return first_tok_ms > 0 && now_ms - first_tok_ms >= cap_ms;
}

// System One Front v2alpha1 routing for Auto mode (#14056):
// Calls elephant-1 or gemini-decision-1 when configured via OA_AGENT_ROUTER_DOOR,
// with deterministic offline #authority policy.coax fallback.
fww_route_auto_plan_v2 :: (
  tk: string, repo: string, active_pack: string, active_tier: string,
  local_ready: bool, cloud_ready: bool, door_pref: string,
  allow_local_harnesses: bool, claude_ready: bool, out_plan: [] Rtr2Plan
) {
  q: [1] Rtr2PlanRequest;
  q[0] = Rtr2PlanRequest.{
    text = tk,
    repo = repo,
    local_inkling_ready = local_ready,
    cloud_ready = cloud_ready,
    user_compute_pref = "auto",
    allow_local_harnesses = allow_local_harnesses
  };
  if claude_ready {
    q[0].available_delegates[0] = "claude";
    q[0].navailable_delegates = 1;
  }
  if active_pack.count > 0 {
    q[0].active_packs[0] = active_pack;
    q[0].nactive_packs = 1;
  }
  q[0].active_compute_tier = active_tier;

  if door_pref == "elephant" {
    e: [1] Rtr2Eligible; w: [1] Rtr2Work;
    if rtr2_begin_elephant(q[..], e[..], out_plan, w[..]).count > 0 {
      gout: [32768] u8; err: [2048] u8;
      c := SoClient.{url = RTR2_ELEPHANT_URL, key_env = "", timeout_s = 3};
      sr := so_post(c, w[0].request, gout[..], err[..]);
      if sr.problem.count == 0 && sr.status == 200 { sr.problem = so_check(w[0].so_body[..], sr.body); sr.usage = so_usage(sr.body); }
      rtr2_finish_elephant(q[..], e[..], sr, out_plan, w[..]);
      return;
    }
  } else if door_pref == "google" {
    e: [1] Rtr2Eligible; w: [1] Rtr2Work;
    if rtr2_begin(q[..], e[..], out_plan, w[..], GD_MODEL).count > 0 {
      c: [1] SoClient; kb: [512] u8;
      why := agr_gemini_keyed(c[..], kb[..]);
      if why.count == 0 {
        gout: [32768] u8; err: [2048] u8; ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
        gr := gd_send(c[0], w[0].body[..], w[0].request, gout[..], err[..], ar[..]);
        for i: 0..<kb.count { kb[i] = 0; }
        rtr2_finish(q[..], e[..], gr, out_plan, w[..]);
        return;
      }
      for i: 0..<kb.count { kb[i] = 0; }
    }
  }
  rtr2_decide_offline(q[..], out_plan);
}

fww_route_auto_plan_ex :: (
  tk: string, repo: string, active_pack: string, active_tier: string,
  local_ready: bool, cloud_ready: bool, door_pref: string, allow_local_harnesses: bool, out_plan: [] Rtr2Plan
) {
  fww_route_auto_plan_v2(tk, repo, active_pack, active_tier, local_ready, cloud_ready, door_pref, allow_local_harnesses, false, out_plan);
}

fww_route_auto_plan :: (
  tk: string, repo: string, active_pack: string, active_tier: string,
  local_ready: bool, cloud_ready: bool, door_pref: string, out_plan: [] Rtr2Plan
) {
  fww_route_auto_plan_ex(tk, repo, active_pack, active_tier, local_ready, cloud_ready, door_pref, false, out_plan);
}

// Pure check: scratch files under /tmp or /var/tmp do not count as deliverable workspace edits.
fww_is_scratch_path :: (path: string) -> bool {
  return flawed_aw_starts(path, "/tmp/") || flawed_aw_starts(path, "/var/tmp/") || flawed_aw_starts(path, "/private/tmp/");
}

// Launch one streaming LLM request for the current history. Returns "" on success or error reason.
fww_start_request :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, out: [] u8) -> string {
  r[0].acc[0] = FwStreamAccum.{cur_tool_idx = -1};
  r[0].first_tok_ms = 0;
  r[0].req_start_ms = proc_now_ms();
  r[0].stream_last_rx_ms = r[0].req_start_ms;

  is_local := auth[0].backend == FLAWED_BE_LOCAL;
  is_gem := flawed_wire_is_gemini(auth[0].backend);
  local_ctx := fww_env_int("PSIONIC_CTX", 32768);
  if local_ctx < 4096 { local_ctx = 4096; }
  if local_ctx > 131072 { local_ctx = 131072; }
  if r[0].effective_ctx_cap > 0 && r[0].effective_ctx_cap < local_ctx {
    local_ctx = r[0].effective_ctx_cap;
  }
  ctx_win := ifx is_local then local_ctx else (ifx r[0].effective_ctx_cap > 0 then r[0].effective_ctx_cap else 1048576);

  raw_m := cast(string) r[0].model[0..<r[0].nmodel];
  mdl_b: [128] u8;
  wire_model := "";
  if auth[0].backend == FLAWED_BE_OURS {
    n := flawed_wire_ours_model(raw_m, mdl_b[..]);
    wire_model = cast(string) mdl_b[0..<n];
  } else if auth[0].backend == FLAWED_BE_OPENROUTER {
    n := flawed_wire_openrouter_model(raw_m, mdl_b[..]);
    wire_model = cast(string) mdl_b[0..<n];
  } else if is_local {
    lb: [128] u8;
    pm := fww_trim(cl_getenv("PSIONIC_MODEL", lb[..]));
    if pm.count > 0 {
      wire_model = pm;
    } else {
      stripped := flawed_wire_strip_model(raw_m);
      wire_model = ifx flawed_aw_starts(stripped, "inkling-2-mini") then stripped else "inkling-2-mini";
    }
  } else {
    n := flawed_wire_gemini_model(raw_m, mdl_b[..]);
    wire_model = cast(string) mdl_b[0..<n];
  }
  r[0].acc[0].nresp_model = fww_keep(r[0].acc[0].resp_model[..], wire_model);
  raw_eff := cast(string) r[0].effort[0..<r[0].neffort];
  req_elapsed_s := ifx r[0].turn_start_ms > 0 then (r[0].req_start_ms - r[0].turn_start_ms) / 1000 else 0;
  eff := ifx is_gem
         then fww_adaptive_effort(cfg[0].thinking_mode, raw_eff, r[0].step_num, h[0].nmsgs, r[0].has_edited, r[0].last_bash_ok, r[0].last_step_had_err, r[0].audit_done, r[0].finish_nudged, r[0].calm_steps, req_elapsed_s, cfg[0].budget_s, cfg[0].bare_mode)
         else raw_eff;
  // On 32K local Inkling 2 Mini in adaptive mode, map default "high" to "low" (gBench-proven Pareto champion: 100% seal_tools, 29-45% faster, no 8K thinking spirals).
  if is_local && ctx_win <= 32768 && cfg[0].thinking_mode == FLAWED_THINK_ADAPTIVE && !cfg[0].bare_mode && eff == "high" {
    eff = "low";
  }
  if is_gem && r[0].force_low_once && cfg[0].thinking_mode == FLAWED_THINK_ADAPTIVE && !cfg[0].bare_mode {
    eff = "low";
  }
  r[0].force_low_once = false;
  if r[0].calm_steps > 0 { r[0].calm_steps -= 1; }
  base_sys_b: [4096] u8;
  full_sys := cast(string) r[0].sys_prompt[0..<r[0].nsys];
  sys := full_sys;
  cwd_now := cast(string) r[0].cwd[0..<r[0].ncwd];
  if is_local && ctx_win <= 32768 {
    platform := ifx tool_os() == TOOL_LINUX then "Linux" else "macOS";
    ln_sys := fww_build_local_coding_system_prompt_core(cfg, cwd_now, platform, base_sys_b[..]);
    if r[0].nactive_pack > 0 && cast(string) r[0].active_pack[0..<r[0].nactive_pack] == "knowledge" {
      ln_sys = fww_cat(base_sys_b[..], ln_sys, "\n\n[Knowledge Pack Active] Answer questions about docs, books, transcripts, or past decisions using KnowledgeSearch (and KnowledgeGet for exact excerpts) in one fast turn with file:line citations instead of running repo-wide Grep/Bash loops.\n");
    }
    is_cap_pack := r[0].nactive_pack > 0 && cast(string) r[0].active_pack[0..<r[0].nactive_pack] == "capability_author";
    mh_str := cast(string) r[0].missing_cap_hint[0..<r[0].nmissing_cap_hint];
    ln_sys = fww_append_cap_author_prompt(base_sys_b[..], ln_sys, mh_str, is_cap_pack);
    sk_lu_b: [FS_PATH_MAX] u8; sk_lw_b: [FS_PATH_MAX] u8; sk_lp_b: [1024] u8;
    sk_lu := fww_cap_skills_dir(cast(string) r[0].home[0..<r[0].nhome], sk_lu_b[..]);
    sk_lw := ifx cwd_now.count > 0 then fs_join(cwd_now, ".claude/skills", sk_lw_b[..]) else "";
    sk_ln := ce_build_skills_prompt(sk_lu, sk_lw, 1024, sk_lp_b[..]);
    if sk_ln > 0 { ln_sys = fww_cat(base_sys_b[..], ln_sys, cast(string) sk_lp_b[0..<sk_ln]); }
    sys = cast(string) base_sys_b[0..<ln_sys];
    max_sys := ifx r[0].ctx_recoveries >= 2 then 2048 else 4096;
    if sys.count > max_sys {
      sc := fww_utf8_cut(sys, max_sys);
      sys = cast(string) sys[0..<sc];
    }
  }
  no_tools := fww_turn_no_tools(r[0].force_wrapup_once);
  include_coax_intel := !no_tools && !(is_local && ctx_win <= 32768) && fww_is_coax_repo(cwd_now);
  packs_mask := ifx no_tools then 0 else fww_active_packs(cwd_now, include_coax_intel);
  if !no_tools && !r[0].is_subagent && cfg[0].subagents_enabled { packs_mask |= OA_PACK_AGENTS; }
  eff_cfg: [1] FwConfig;
  eff_cfg[0] = cfg[0];
  if r[0].is_subagent {
    if r[0].nsubagent_allowed > 0 {
      eff_cfg[0].nallowed = fww_keep(eff_cfg[0].allowed_tools[..], cast(string) r[0].subagent_allowed[0..<r[0].nsubagent_allowed]);
    }
    if r[0].nsubagent_disallowed > 0 {
      if eff_cfg[0].ndisallowed > 0 {
        eff_cfg[0].ndisallowed = fww_cat(eff_cfg[0].disallowed_tools[..], eff_cfg[0].ndisallowed, ",");
      }
      eff_cfg[0].ndisallowed = fww_cat(eff_cfg[0].disallowed_tools[..], eff_cfg[0].ndisallowed, cast(string) r[0].subagent_disallowed[0..<r[0].nsubagent_disallowed]);
    }
  }
  no_think := r[0].force_no_think_once;
  r[0].force_no_think_once = false;

  // Multi-layer pre-flight compaction, hard context-fit guarantee, & structural history sanitizer!
  _ = fww_ensure_context_fits(h, sys.count, ctx_win, is_local, no_tools, cfg[0].auto_compact, b[0].compact_buf[..]);
  fww_hist_sanitize(h, b[0].compact_buf[..]);
  r[0].last_req_est_bytes = fww_estimate_prompt_bytes(h, sys.count, is_local, no_tools);

  bn := ifx is_gem
        then fww_build_gemini_body_packs(eff_cfg[..], h, eff, sys, no_tools, packs_mask, b[0].req_body[..])
        else fww_build_openai_body_packs(eff_cfg[..], h, wire_model, eff, sys, is_local, local_ctx, no_tools, no_think, packs_mask, b[0].req_body[..]);
  if bn <= 0 {
    _ = fww_emergency_compact(h, 2, ctx_win, b[0].compact_buf[..]);
    fww_hist_sanitize(h, b[0].compact_buf[..]);
    r[0].last_req_est_bytes = fww_estimate_prompt_bytes(h, sys.count, is_local, no_tools);
    bn = ifx is_gem
         then fww_build_gemini_body_packs(eff_cfg[..], h, eff, sys, no_tools, packs_mask, b[0].req_body[..])
         else fww_build_openai_body_packs(eff_cfg[..], h, wire_model, eff, sys, is_local, local_ctx, no_tools, no_think, packs_mask, b[0].req_body[..]);
  }
  if bn <= 0 {
    _ = fww_emergency_compact(h, 3, ctx_win, b[0].compact_buf[..]);
    fww_hist_sanitize(h, b[0].compact_buf[..]);
    r[0].last_req_est_bytes = fww_estimate_prompt_bytes(h, sys.count, is_local, no_tools);
    bn = ifx is_gem
         then fww_build_gemini_body_packs(eff_cfg[..], h, eff, sys, no_tools, packs_mask, b[0].req_body[..])
         else fww_build_openai_body_packs(eff_cfg[..], h, wire_model, eff, sys, is_local, local_ctx, no_tools, no_think, packs_mask, b[0].req_body[..]);
  }
  if bn <= 0 { return "Request body exceeded buffer capacity (try /compact)."; }

  ub: [512] u8;
  lbase_b: [512] u8;
  lbase := fww_trim(cl_getenv("PSIONIC_BASE_URL", lbase_b[..]));
  vx_proj := cast(string) auth[0].vx_project[0..<auth[0].nvx_project];
  vx_loc := cast(string) auth[0].vx_location[0..<auth[0].nvx_location];
  ep_base := cast(string) cfg[0].base_url[0..<cfg[0].nbase_url];
  if auth[0].backend == FLAWED_BE_OURS && ep_base.count == 0 && cfg[0].ncloud_origin > 0 {
    ep_base = cast(string) cfg[0].cloud_origin[0..<cfg[0].ncloud_origin];
  }
  un := flawed_wire_endpoint_url(auth[0].backend, ep_base, lbase, vx_proj, vx_loc, wire_model, ub[..]);
  url := cast(string) ub[0..<un];

  cli := GwClient.{url = url, connect_timeout_s = 15, max_time_s = 600};
  // Proactively refresh short-lived OAuth / Cloud tokens before every step in long multi-step turns.
  if !is_local {
    if !fww_refresh_request_auth(auth, false) && auth[0].backend == FLAWED_BE_VERTEX && auth[0].nkey == 0 {
      return "Vertex AI access token expired and could not be refreshed (check gcloud & service account).";
    }
  }
  nip98_hdr: [4096] u8;
  if is_local {
    cli.key_env = "";
    cli.key_value = "";
  } else if auth[0].backend == FLAWED_BE_OURS {
    cli.key_env = "FLAWED_REQ_KEY";
    cli.key_header = "Authorization";
    if cast(string) auth[0].source[0..<auth[0].nsource] == "ours_nostr" {
      sn := fww_sign_ours_nip98(auth, url, cast(string) b[0].req_body[0..<bn], nip98_hdr[..]);
      if sn <= 0 { return "Could not sign request for OpenAgents Cloud (run openagents login or sign in via Desktop)."; }
      cli.key_value = cast(string) nip98_hdr[0..<sn];
      cli.scheme = "";
    } else if auth[0].ours_is_header {
      cli.key_value = cast(string) auth[0].key[0..<auth[0].nkey];
      cli.scheme = "";
    } else {
      cli.key_value = cast(string) auth[0].key[0..<auth[0].nkey];
      cli.scheme = "Bearer";
    }
  } else if auth[0].backend == FLAWED_BE_GEMINI {
    cli.key_env = "FLAWED_REQ_KEY";
    cli.key_value = cast(string) auth[0].key[0..<auth[0].nkey];
    cli.key_header = "x-goog-api-key";
    cli.scheme = "";
  } else {
    // Vertex AI OAuth Bearer token or OpenRouter Bearer API key
    cli.key_env = "FLAWED_REQ_KEY";
    cli.key_value = cast(string) auth[0].key[0..<auth[0].nkey];
    cli.key_header = "Authorization";
    cli.scheme = "Bearer";
  }

  hdrs: [4] string;
  nh := 0;
  if auth[0].backend == FLAWED_BE_OPENROUTER {
    hdrs[nh] = "HTTP-Referer: https://openagents.com"; nh += 1;
    hdrs[nh] = "X-Title: OpenAgents Flawed"; nh += 1;
  }

  fww_emit_attempt(r, auth, "started", 0, 0, out);
  err := gw_start(cli, cast(string) b[0].req_body[0..<bn], hdrs[0..<nh], r[0].gw[..]);
  if err.count > 0 { return err; }
  r[0].streaming = true;
  return "";
}

// Start async Bash subprocess (respecting macOS Seatbelt sandbox & gitguard).
fww_start_bash :: (r: [] FwRun, cfg: [] FwConfig, tool_idx: int, cmd_str: string, timeout_s: int, out: [] u8) -> bool {
  r[0].cmd[0] = FwAsyncCmd.{h = -1, tool_idx = tool_idx};
  r[0].cmd[0].ncmd = fww_keep(r[0].cmd[0].cmd[..], cmd_str);
  def_t := ifx cfg[0].bash_timeout_s > 0 then cfg[0].bash_timeout_s else 60;
  ts := ifx timeout_s > 0 && timeout_s <= 300 then timeout_s else def_t;
  if cfg[0].bare_mode && cfg[0].bash_timeout_s > 0 && ts > cfg[0].bash_timeout_s { ts = cfg[0].bash_timeout_s; }
  if cfg[0].budget_s >= 120 && r[0].turn_start_ms > 0 {
    rem_s := cfg[0].budget_s - (proc_now_ms() - r[0].turn_start_ms) / 1000;
    max_cmd_s := rem_s - 25;
    if max_cmd_s < 15 { max_cmd_s = 15; }
    if ts > max_cmd_s { ts = max_cmd_s; }
  }
  r[0].cmd[0].deadline_ms = proc_now_ms() + ts * 1000;
  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];

  h := proc_new();
  if h < 0 { return false; }

  shell_bin := ifx fs_exists("/bin/bash") then "/bin/bash" else "/bin/sh";
  use_sb := flawed_should_use_sandbox(cfg[0].sandbox_mode != FLAWED_SANDBOX_OFF, false, false, false, tool_os() == TOOL_MAC, true);
  ok := true;
  if use_sb && fs_exists("/usr/bin/sandbox-exec") {
    // Workspace-writable Seatbelt profile (Ch 12): allow read + process + writes only under cwd & /tmp.
    sb_b: [4096] u8;
    sn := fww_cat(sb_b[..], 0, "(version 1)(allow default)(deny file-write*)(allow file-write* (subpath \"");
    sn = fww_cat(sb_b[..], sn, cwd);
    sn = fww_cat(sb_b[..], sn, "\") (subpath \"/tmp\") (subpath \"/private/tmp\") (subpath \"/var/folders\") (literal \"/dev/null\") (literal \"/dev/tty\"))");
    ok = proc_arg(h, "/usr/bin/sandbox-exec") && proc_arg(h, "-p") && proc_arg(h, cast(string) sb_b[0..<sn]) && proc_arg(h, shell_bin) && proc_arg(h, "-c") && proc_arg(h, cmd_str);
  } else {
    ok = proc_arg(h, shell_bin) && proc_arg(h, "-c") && proc_arg(h, cmd_str);
  }
  ok = ok && proc_cwd(h, cwd) && proc_err_to_out(h) && proc_env(h, "PYTHONUNBUFFERED=1");
  if cfg[0].git_guard {
    ok = ok && proc_env(h, "CODER_GIT_GUARD=1");
  }
  if !ok || proc_start(h) != 0 {
    _ = proc_release(h);
    return false;
  }
  _ = proc_close_stdin(h);
  r[0].cmd[0].h = h;
  r[0].cmd[0].active = true;
  r[0].next_ticket += 1;
  r[0].waiting_ask_ticket = r[0].next_ticket;
  fww_send(out, mww_ask(out, cmd_str, r[0].waiting_ask_ticket));
  return true;
}

// Extract target path or command string from a tool call's JSON arguments for permission checking.
fww_tool_target :: (name: string, args_json: string, out: [] u8) -> string {
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) { return ""; }
  n := 0;
  if name == "Bash" { n = jv_str(d[0], jv_get(d[0], 0, "command"), out); }
  else if name == "WebFetch" { n = jv_str(d[0], jv_get(d[0], 0, "url"), out); }
  else if name == "WebSearch" { n = jv_str(d[0], jv_get(d[0], 0, "query"), out); }
  else if name == "WalletPay" || name == "WalletQuote" {
    db: [512] u8; rb: [256] u8;
    dn := jv_str(d[0], jv_get(d[0], 0, "destination"), db[..]);
    amt := jv_int(d[0], jv_get(d[0], 0, "amount_sats"), 0);
    rn := jv_str(d[0], jv_get(d[0], 0, "reason"), rb[..]);
    if dn > 0 { n = fww_cat(out, n, cast(string) db[0..<dn]); }
    if amt > 0 { n = fww_cat(out, n, " ("); n = fww_put_int(out, n, amt); n = fww_cat(out, n, " sats)"); }
    if rn > 0 { n = fww_cat(out, n, " — "); n = fww_cat(out, n, cast(string) rb[0..<rn]); }
  }
  else if name == "OpenAgentsCli" {
    sb: [64] u8; vb: [256] u8;
    sn := jv_str(d[0], jv_get(d[0], 0, "subcommand"), sb[..]);
    if sn > 0 { n = fww_cat(out, n, cast(string) sb[0..<sn]); }
    arr := jv_get(d[0], 0, "args");
    if jv_kind(d[0], arr) == JV_ARRAY && jv_len(d[0], arr) > 0 {
      vn := jv_str(d[0], jv_at(d[0], arr, 0), vb[..]);
      if vn > 0 { n = fww_cat(out, n, " "); n = fww_cat(out, n, cast(string) vb[0..<vn]); }
    }
  }
  else if name == "GameBuilder" {
    ab: [64] u8; tb: [512] u8;
    an := jv_str(d[0], jv_get(d[0], 0, "action"), ab[..]);
    if an > 0 { n = fww_cat(out, n, cast(string) ab[0..<an]); }
    tn := jv_str(d[0], jv_get(d[0], 0, "target"), tb[..]);
    if tn > 0 { n = fww_cat(out, n, " "); n = fww_cat(out, n, cast(string) tb[0..<tn]); }
  }
  else if name == "KnowledgeSearch" {
    n = jv_str(d[0], jv_get(d[0], 0, "query"), out);
  }
  else if name == "KnowledgeGet" {
    n = jv_str(d[0], jv_get(d[0], 0, "target"), out);
  }
  else if oa_member_is_session_tool(name) {
    n = jv_str(d[0], jv_get(d[0], 0, "session_id"), out);
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "title"), out); }
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "kind"), out); }
  }
  else if name == "CapabilityDraft" || name == "CapabilityEval" {
    n = jv_str(d[0], jv_get(d[0], 0, "slug"), out);
  }
  else {
    n = jv_str(d[0], jv_get(d[0], 0, "file_path"), out);
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "file"), out); }
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "path"), out); }
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "target"), out); }
  }
  return ifx n > 0 then cast(string) out[0..<n] else "";
}

// PMCoder (arXiv:2608.06811 III-E) Edit Integrity Grounding: zero-LLM-cost syntax check after Edit/Write.
fww_edit_integrity_json_ok :: (body: string) -> bool {
  if body.count == 0 || body.count > 65536 { return true; }
  nodes: [4096] JvNode; d: [1] Jv;
  return jv_parse(d[..], body, nodes[..]);
}

fww_edit_integrity_check :: (cwd: string, raw_path: string, out_res: [] u8, at: int) -> int {
  if raw_path.count == 0 || at + 256 >= out_res.count { return at; }
  ext_b: [32] u8;
  ext := fww_path_ext_lower(raw_path, ext_b[..]);
  if ext != "json" && ext != "py" { return at; }
  full_b: [FS_PATH_MAX] u8;
  full := fww_resolve_path(cwd, raw_path, full_b[..]);
  if full.count == 0 { return at; }

  if ext == "json" {
    fbuf: [65536] u8;
    fn := fs_read(full, fbuf[..]);
    if fn > 0 && fn < fbuf.count && !fww_edit_integrity_json_ok(cast(string) fbuf[0..<fn]) {
      rn := fww_cat(out_res, at, "\n[Edit Integrity WARNING: ");
      rn = fww_cat(out_res, rn, raw_path);
      rn = fww_cat(out_res, rn, " contains invalid JSON syntax after edit. Fix the JSON syntax immediately before continuing.]");
      return rn;
    }
    return at;
  }

  // Python AST syntax check (argv-only, zero .pyc side effects, ~20ms)
  ph := proc_new();
  if ph < 0 { return at; }
  py_chk := "import ast,sys\ntry:\n ast.parse(open(sys.argv[1],'rb').read(),sys.argv[1])\nexcept SyntaxError as e:\n print(f'SyntaxError line {e.lineno}: {e.msg}')\n sys.exit(1)\n";
  ok := proc_arg(ph, "python3") && proc_arg(ph, "-c") && proc_arg(ph, py_chk) && proc_arg(ph, full) && proc_cwd(ph, cwd);
  eb: [512] u8;
  en := 0;
  bad := false;
  if ok && proc_start(ph) == 0 {
    _ = proc_close_stdin(ph);
    lbuf: [512] u8;
    deadline := proc_now_ms() + 1500;
    while proc_now_ms() < deadline && en + 1 < eb.count {
      r := proc_line(ph, 100, lbuf[..]);
      if r == PROC_EOF || r < 0 { break; }
      if r == PROC_TIMEOUT { continue; }
      en = fww_cat(eb[..], en, cast(string) lbuf[0..<r]);
      en = fww_cat(eb[..], en, " ");
    }
    ec := proc_wait(ph, 400);
    if ec != 0 { bad = true; }
  }
  _ = proc_release(ph);
  if bad {
    rn := fww_cat(out_res, at, "\n[Edit Integrity WARNING: Python syntax error in ");
    rn = fww_cat(out_res, rn, raw_path);
    if en > 0 {
      rn = fww_cat(out_res, rn, ": ");
      rn = fww_cat(out_res, rn, fww_trim(cast(string) eb[0..<en]));
    }
    rn = fww_cat(out_res, rn, " — fix this syntax error immediately before running tests.]");
    return rn;
  }
  return at;
}

// Edit-Induced Dependency Mismatch (arXiv:2611.29242) Post-Edit Consumer Impact Hint (OA_EXP_DEP_SYNC):
// Extracts modified/added code identifiers from an Edit diff and scans sibling source files in cwd
// to surface untouched consumer paths in-distribution (zero LLM calls, zero subprocesses, cache-safe).
fww_dep_is_ident_char :: (c: u8) -> bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

fww_dep_is_stopword :: (s: string) -> bool {
  if s.count < 4 || s.count > 48 { return true; }
  if s[0] >= '0' && s[0] <= '9' { return true; }
  return s == "return" || s == "import" || s == "from" || s == "class" || s == "async" || s == "await"
      || s == "const" || s == "export" || s == "struct" || s == "string" || s == "float" || s == "false"
      || s == "true" || s == "None" || s == "True" || s == "False" || s == "self" || s == "this"
      || s == "while" || s == "break" || s == "continue" || s == "raise" || s == "except" || s == "finally"
      || s == "yield" || s == "assert" || s == "print" || s == "super" || s == "value" || s == "error"
      || s == "result" || s == "index" || s == "count" || s == "length" || s == "default" || s == "other"
      || s == "function" || s == "interface" || s == "public" || s == "private" || s == "static" || s == "typedef"
      || s == "kwargs" || s == "args" || s == "dict" || s == "list" || s == "tuple" || s == "bool" || s == "Optional";
}

fww_dep_str_has_ident :: (hay: string, ident: string) -> bool {
  if ident.count == 0 || hay.count < ident.count { return false; }
  i := 0;
  lim := hay.count - ident.count;
  while i <= lim {
    m := true;
    for j: 0..<ident.count {
      if hay[i + j] != ident[j] { m = false; break; }
    }
    if m {
      left_ok := i == 0 || !fww_dep_is_ident_char(hay[i - 1]);
      right_ok := i + ident.count >= hay.count || !fww_dep_is_ident_char(hay[i + ident.count]);
      if left_ok && right_ok { return true; }
    }
    i += 1;
  }
  return false;
}

fww_dep_extract_symbols :: (old_s: string, new_s: string, out_buf: [] u8, starts: [] int, lens: [] int, max_syms: int) -> int {
  nsyms := 0;
  ob_at := 0;
  // Pass 1: identifiers added in new_s (not in old_s) — e.g. new fields, keys, arguments, methods.
  // Pass 2: identifiers defined in old_s or new_s (following def/class/fn/func) whose contract may have changed.
  for pass: 0..<2 {
    src := ifx pass == 0 then new_s else old_s;
    i := 0;
    while i < src.count && nsyms < max_syms {
      while i < src.count && !fww_dep_is_ident_char(src[i]) { i += 1; }
      st := i;
      while i < src.count && fww_dep_is_ident_char(src[i]) { i += 1; }
      if i <= st { continue; }
      tok := cast(string) src[st..<i];
      if fww_dep_is_stopword(tok) { continue; }
      take := false;
      if pass == 0 {
        if !fww_dep_str_has_ident(old_s, tok) { take = true; }
        else if st >= 4 && cast(string) src[st - 4..<st] == "def " { take = true; }
        else if st >= 6 && cast(string) src[st - 6..<st] == "class " { take = true; }
        else if st >= 3 && cast(string) src[st - 3..<st] == "fn " { take = true; }
      } else {
        if !fww_dep_str_has_ident(new_s, tok) { take = true; }
        else if st >= 4 && cast(string) src[st - 4..<st] == "def " { take = true; }
        else if st >= 6 && cast(string) src[st - 6..<st] == "class " { take = true; }
      }
      if !take { continue; }
      dup := false;
      for k: 0..<nsyms {
        if cast(string) out_buf[starts[k]..<starts[k] + lens[k]] == tok { dup = true; break; }
      }
      if dup || ob_at + tok.count + 2 > out_buf.count { continue; }
      starts[nsyms] = ob_at;
      lens[nsyms] = tok.count;
      for j: 0..<tok.count { out_buf[ob_at + j] = tok[j]; }
      ob_at += tok.count;
      nsyms += 1;
    }
  }
  return nsyms;
}

fww_dep_is_source_ext :: (ext: string) -> bool {
  return ext == "py" || ext == "coax" || ext == "ts" || ext == "tsx" || ext == "js" || ext == "rs" || ext == "go";
}

fww_tp_has_hash :: (slots: [] int, n: int, h: int) -> bool {
  if h == 0 { return false; }
  lim := ifx n < slots.count then n else slots.count;
  for i: 0..<lim { if slots[i] == h { return true; } }
  return false;
}

fww_tp_add_hash :: (slots: [] int, n: [] int, h: int) {
  if h == 0 || fww_tp_has_hash(slots, n[0], h) { return; }
  if n[0] < slots.count {
    slots[n[0]] = h;
    n[0] += 1;
  }
}

fww_dep_sync_check :: (cwd: string, raw_path: string, args_json: string, edited_hashes: [] int, nedited: int, out_res: [] u8, at: int) -> int {
  if raw_path.count == 0 || cwd.count == 0 || at + 384 >= out_res.count { return at; }
  ext_b: [32] u8;
  ext := fww_path_ext_lower(raw_path, ext_b[..]);
  if !fww_dep_is_source_ext(ext) { return at; }
  // Skip test files — editing a test rarely has downstream production consumers.
  base := fww_path_basename(raw_path);
  if flawed_aw_starts(base, "test_") || fww_contains_ci(base, "_test.") || fww_contains_ci(base, ".test.") { return at; }

  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) { return at; }
  old_b: [4096] u8; new_b: [4096] u8;
  on := jv_str(d[0], jv_get(d[0], 0, "old_string"), old_b[..]);
  nn := jv_str(d[0], jv_get(d[0], 0, "new_string"), new_b[..]);
  if on <= 0 && nn <= 0 { return at; }

  sym_buf: [512] u8;
  starts: [8] int;
  lens: [8] int;
  nsyms := fww_dep_extract_symbols(cast(string) old_b[0..<on], cast(string) new_b[0..<nn], sym_buf[..], starts[..], lens[..], 4);
  edit_full_b: [FS_PATH_MAX] u8;
  edit_full := fww_resolve_path(cwd, raw_path, edit_full_b[..]);
  // Also harvest top-level class/def/struct declarations from the edited file itself so narrow field-addition edits
  // still find downstream consumers referencing the enclosing type/function (e.g. AggNode in transformer.py).
  if nsyms < 8 && edit_full.count > 0 {
    ebuf: [16384] u8;
    en := fs_read(edit_full, ebuf[..]);
    if en > 0 && en < ebuf.count {
      nsyms_base := nsyms;
      // Scan line starts for "class ", "def ", "fn ", or " :: struct"
      eb_s := cast(string) ebuf[0..<en];
      ob_at := ifx nsyms > 0 then starts[nsyms - 1] + lens[nsyms - 1] else 0;
      p := 0;
      while p < eb_s.count && nsyms < 8 {
        ls := p;
        while p < eb_s.count && eb_s[p] != '\n' { p += 1; }
        le := p;
        if p < eb_s.count && eb_s[p] == '\n' { p += 1; }
        line := cast(string) eb_s[ls..<le];
        name_st := -1;
        if flawed_aw_starts(line, "class ") { name_st = 6; }
        else if flawed_aw_starts(line, "def ") { name_st = 4; }
        else if flawed_aw_starts(line, "fn ") { name_st = 3; }
        if name_st >= 0 && name_st < line.count {
          ne := name_st;
          while ne < line.count && fww_dep_is_ident_char(line[ne]) { ne += 1; }
          if ne > name_st {
            tok := cast(string) line[name_st..<ne];
            if !fww_dep_is_stopword(tok) && ob_at + tok.count + 2 <= sym_buf.count {
              dup := false;
              for k: 0..<nsyms {
                if cast(string) sym_buf[starts[k]..<starts[k] + lens[k]] == tok { dup = true; break; }
              }
              if !dup {
                starts[nsyms] = ob_at;
                lens[nsyms] = tok.count;
                for j: 0..<tok.count { sym_buf[ob_at + j] = tok[j]; }
                ob_at += tok.count;
                nsyms += 1;
              }
            }
          }
        }
      }
      _ = nsyms_base;
    }
  }
  if nsyms == 0 { return at; }

  // Walk sibling source files in cwd (capped at 40 files, zero subprocesses).
  list_b: [4096] u8;
  lat := [1] int.[0];
  lhits := [1] int.[0];
  pat_b: [32] u8;
  pn := fww_cat(pat_b[..], 0, "*.");
  pn = fww_cat(pat_b[..], pn, ext);
  fww_glob_walk(cwd, "", cast(string) pat_b[0..<pn], 0, list_b[..], lat[..], lhits[..], 40);
  if lat[0] <= 0 { return at; }

  hits_b: [768] u8;
  hn := 0;
  nfiles_hit := 0;
  fbuf: [32768] u8;
  pos := 0;
  while pos < lat[0] && nfiles_hit < 5 {
    nl := pos;
    while nl < lat[0] && list_b[nl] != '\n' { nl += 1; }
    rel := cast(string) list_b[pos..<nl];
    pos = nl + 1;
    if rel.count == 0 { continue; }
    rb := fww_path_basename(rel);
    if flawed_aw_starts(rb, "test_") || fww_contains_ci(rb, "_test.") || fww_contains_ci(rb, ".test.") { continue; }
    cand_b: [FS_PATH_MAX] u8;
    cand := fww_resolve_path(cwd, rel, cand_b[..]);
    if cand == edit_full { continue; }
    if fww_tp_has_hash(edited_hashes, nedited, fww_str_hash(cand)) { continue; }
    fn := fs_read(cand, fbuf[..]);
    if fn <= 0 || fn >= fbuf.count { continue; }
    body := cast(string) fbuf[0..<fn];
    matched_sym := "";
    for k: 0..<nsyms {
      sy := cast(string) sym_buf[starts[k]..<starts[k] + lens[k]];
      if fww_dep_str_has_ident(body, sy) { matched_sym = sy; break; }
    }
    if matched_sym.count > 0 {
      if nfiles_hit > 0 { hn = fww_cat(hits_b[..], hn, ", "); }
      hn = fww_cat(hits_b[..], hn, rel);
      hn = fww_cat(hits_b[..], hn, " (");
      hn = fww_cat(hits_b[..], hn, matched_sym);
      hn = fww_cat(hits_b[..], hn, ")");
      nfiles_hit += 1;
    }
  }
  if nfiles_hit == 0 { return at; }

  rn := fww_cat(out_res, at, "\n[Consumer Impact (DepSync): edited symbol(s) also referenced in untouched file(s): ");
  rn = fww_cat(out_res, rn, cast(string) hits_b[0..<hn]);
  rn = fww_cat(out_res, rn, ". Inspect every consumer path (transformers, handlers, serializers, alternate callers) before finishing — do not rely on pre-edit assumptions.]");
  return rn;
}

// ToolPulse (arXiv:2611.19275 Eq. 8-9) Error Signature for Failure Inertia detection:
// Normalizes digits out of the diagnostic line so identical failures at slightly shifted lines/PIDs still match.
fww_tp_err_sig :: (tool_name: string, res: string) -> int {
  if res.count == 0 { return fww_str_hash(tool_name); }
  // Pick the first line containing a diagnostic keyword, or fall back to the first non-empty line.
  best_s := 0;
  best_e := 0;
  first_s := 0;
  first_e := 0;
  p := 0;
  while p < res.count {
    ls := p;
    while p < res.count && res[p] != '\n' { p += 1; }
    le := p;
    if p < res.count && res[p] == '\n' { p += 1; }
    line := fww_trim(cast(string) res[ls..<le]);
    if line.count == 0 { continue; }
    if first_e == 0 { first_s = ls; first_e = le; }
    if fww_contains_ci(line, "error") || fww_contains_ci(line, "exception") || fww_contains_ci(line, "failed")
       || fww_contains_ci(line, "not found") || fww_contains_ci(line, "denied") || fww_contains_ci(line, "mismatch") {
      best_s = ls;
      best_e = le;
      break;
    }
  }
  if best_e == 0 { best_s = first_s; best_e = first_e; }
  norm: [256] u8;
  nn := fww_cat(norm[..], 0, tool_name);
  nn = fww_cat(norm[..], nn, "|");
  for i: best_s..<best_e {
    if nn >= norm.count { break; }
    c := res[i];
    if c >= '0' && c <= '9' { continue; }
    if c == '\r' || c == '\t' { c = ' '; }
    norm[nn] = c;
    nn += 1;
  }
  return fww_str_hash(cast(string) norm[0..<nn]);
}

// Unfaithful Work Reports (arXiv:2611.25760) + Epistemic Guard (arXiv:2611.27095) End-of-Turn Receipt Grounding:
// Verifies final assistant claims about passing tests/checks or completed file edits against deterministic turn receipts.
fww_faith_claims_tests_pass :: (reply: string) -> bool {
  // Guard against negated statements ("tests did not pass", "failing tests")
  if fww_contains_ci(reply, "did not pass") || fww_contains_ci(reply, "do not pass")
     || fww_contains_ci(reply, "not passing") || fww_contains_ci(reply, "still fail")
     || fww_contains_ci(reply, "tests fail") || fww_contains_ci(reply, "test fail") {
    return false;
  }
  return fww_contains_ci(reply, "all tests pass") || fww_contains_ci(reply, "tests pass")
      || fww_contains_ci(reply, "tests are passing") || fww_contains_ci(reply, "all checks pass")
      || fww_contains_ci(reply, "unit tests pass") || fww_contains_ci(reply, "test suite pass")
      || fww_contains_ci(reply, "0 failed") || fww_contains_ci(reply, "all green")
      || fww_contains_ci(reply, "passed successfully") || fww_contains_ci(reply, "verified passing");
}

fww_faith_check_reply :: (reply: string, has_edited: bool, ran_test: bool, last_test_ok: bool, edited_after_test: bool, failed_edit_path: string, out_msg: [] u8) -> int {
  if reply.count == 0 { return 0; }
  if fww_faith_claims_tests_pass(reply) {
    if ran_test && !last_test_ok {
      return fww_keep(out_msg, "[Receipt Grounding Check (FaithCheck)] Your reply states that tests/checks pass, but the most recent Bash command in this turn exited with an error. Run the test suite to verify the actual current status, fix any failure, and report only verified tool results.");
    }
    if edited_after_test {
      return fww_keep(out_msg, "[Receipt Grounding Check (FaithCheck)] Your reply states that tests pass, but you edited file(s) AFTER your last Bash verification command. Re-run the test suite now against the current files on disk before reporting that tests pass.");
    }
    if !ran_test {
      return fww_keep(out_msg, "[Receipt Grounding Check (FaithCheck)] Your reply states that tests/checks pass, but no Bash test/verification command was executed in this turn. Either run the test command now to verify, or state plainly that tests were not run.");
    }
  }
  if failed_edit_path.count > 0 {
    fb := fww_path_basename(failed_edit_path);
    if fb.count > 0 && fww_contains_ci(reply, fb)
       && (fww_contains_ci(reply, "updated") || fww_contains_ci(reply, "fixed") || fww_contains_ci(reply, "edited") || fww_contains_ci(reply, "modified") || fww_contains_ci(reply, "applied")) {
      rn := fww_cat(out_msg, 0, "[Receipt Grounding Check (FaithCheck)] Your reply claims ");
      rn = fww_cat(out_msg, rn, fb);
      rn = fww_cat(out_msg, rn, " was updated/fixed, but the last Edit/Write to that file FAILED and no subsequent edit succeeded. Re-inspect and apply the edit cleanly (or report the failure honestly) before concluding.");
      return rn;
    }
  }
  return 0;
}

// Execute one tool call (after permission check passed). Returns true if async (Bash running).
fww_exec_tool_now :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, idx: int, out: [] u8) -> bool {
  name := cast(string) r[0].acc[0].tools[idx].name[0..<r[0].acc[0].tools[idx].nname];
  args := cast(string) r[0].acc[0].tools[idx].args[0..<r[0].acc[0].tools[idx].nargs];
  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];
  is_err := [1] bool.[false];

  if r[0].subagent_read_only {
    if name == "Edit" || name == "Write" || name == "CoaxReplace" || name == "WalletPay" || name == "EnterWorktree" || name == "ExitWorktree" || name == "CapabilityDraft" || name == "CapabilityEval" {
      r[0].acc[0].tools[idx].done = true;
      r[0].acc[0].tools[idx].is_error = true;
      r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Tool denied: this subagent is strictly read-only.");
      return false;
    }
  }

  if name == "SendMessage" {
    return fww_tool_send_message(r, idx, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }

  if name == "Bash" {
    nodes: [128] JvNode; d: [1] Jv;
    cb: [FWW_CMD_MAX] u8;
    cn := 0; timeout_s := 0;
    if jv_parse(d[..], args, nodes[..]) {
      cn = jv_str(d[0], jv_get(d[0], 0, "command"), cb[..]);
      timeout_s = jv_int(d[0], jv_get(d[0], 0, "timeout"), 0);
      if timeout_s > 1000 { timeout_s = timeout_s / 1000; } // accept ms or seconds
    }
    if cn <= 0 {
      r[0].acc[0].tools[idx].done = true;
      r[0].acc[0].tools[idx].is_error = true;
      r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Bash requires command.");
      return false;
    }
    if r[0].subagent_read_only && !oa_agent_bash_readonly_safe(cast(string) cb[0..<cn]) {
      r[0].acc[0].tools[idx].done = true;
      r[0].acc[0].tools[idx].is_error = true;
      r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Bash command denied: this subagent is strictly read-only.");
      return false;
    }
    if r[0].nsubagent_git > 0 {
      gwb: [600] u8;
      gw := mc_gg_refuse_publish(cwd, cast(string) cb[0..<cn], cast(string) r[0].home[0..<r[0].nhome], cast(string) r[0].subagent_git[0..<r[0].nsubagent_git], gwb[..]);
      if gw.count > 0 {
        r[0].acc[0].tools[idx].done = true;
        r[0].acc[0].tools[idx].is_error = true;
        r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], gw);
        return false;
      }
    }
    if fww_start_bash(r, cfg, idx, cast(string) cb[0..<cn], timeout_s, out) {
      return true;
    }
    r[0].acc[0].tools[idx].done = true;
    r[0].acc[0].tools[idx].is_error = true;
    r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Failed to spawn shell process.");
    return false;
  }

  rn := 0;
  is_local := auth[0].backend == FLAWED_BE_LOCAL;
  if name == "Read" {
    img_at := r[0].acc[0].ntool_img_slab;
    img_avail := r[0].acc[0].tool_img_slab.count - img_at;
    if img_avail < 0 { img_avail = 0; }
    img_mime_n := [1] int.[0];
    img_b64_n := [1] int.[0];
    rn = fww_tool_read(
      cwd, args, fww_fc(b), r[0].read_dedup[..], r[0].read_dedup_cur[..], h[0].compact_count, is_local,
      b[0].file_buf[..], r[0].acc[0].tools[idx].res[..],
      r[0].acc[0].tools[idx].img_mime[..], img_mime_n[..],
      r[0].acc[0].tool_img_slab[img_at..<img_at + img_avail], img_b64_n[..],
      is_err[..], out
    );
    if img_b64_n[0] > 0 && img_mime_n[0] > 0 {
      r[0].acc[0].tools[idx].nimg_mime = img_mime_n[0];
      r[0].acc[0].tools[idx].img_at = img_at;
      r[0].acc[0].tools[idx].nimg = img_b64_n[0];
      r[0].acc[0].ntool_img_slab = img_at + img_b64_n[0];
    }
    if !is_err[0] && cfg[0].exp_toolpulse {
      tp_b: [512] u8; full_b: [FS_PATH_MAX] u8;
      tp := fww_tool_target(name, args, tp_b[..]);
      fp := fww_resolve_path(cwd, tp, full_b[..]);
      if fp.count > 0 {
        nv := [1] int.[r[0].ntp_viewed];
        fww_tp_add_hash(r[0].tp_viewed_files[..], nv[..], fww_str_hash(fp));
        r[0].ntp_viewed = nv[0];
      }
    }
  }
  else if name == "Edit" {
    tp_b: [512] u8; full_b: [FS_PATH_MAX] u8;
    tp := fww_tool_target(name, args, tp_b[..]);
    fp := fww_resolve_path(cwd, tp, full_b[..]);
    blind_edit := cfg[0].exp_toolpulse && fp.count > 0 && !fww_tp_has_hash(r[0].tp_viewed_files[..], r[0].ntp_viewed, fww_str_hash(fp));
    rn = fww_tool_edit(cwd, args, fww_fc(b), r[0].read_dedup[..], b[0].file_buf[..], b[0].edit_buf[..], r[0].acc[0].tools[idx].res[..], is_err[..], out);
    if !is_err[0] {
      for qi: 0..<r[0].query_dedup.count { r[0].query_dedup[qi] = 0; }
      if fp.count > 0 {
        ne := [1] int.[r[0].ndep_edited];
        fww_tp_add_hash(r[0].dep_edited_hashes[..], ne[..], fww_str_hash(fp));
        r[0].ndep_edited = ne[0];
      }
      if cfg[0].exp_edit_ground {
        rn = fww_edit_integrity_check(cwd, tp, r[0].acc[0].tools[idx].res[..], rn);
      }
      if cfg[0].exp_dep_sync {
        rn = fww_dep_sync_check(cwd, tp, args, r[0].dep_edited_hashes[..], r[0].ndep_edited, r[0].acc[0].tools[idx].res[..], rn);
      }
    }
    if blind_edit {
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], rn, "\n[ToolPulse: Blind Edit — you edited ");
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], rn, tp);
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], rn, " without reading it first. Inspect the file with Read before making further edits.]");
    }
  }
  else if name == "Write" {
    tp_b: [512] u8; full_b: [FS_PATH_MAX] u8;
    tp := fww_tool_target(name, args, tp_b[..]);
    fp := fww_resolve_path(cwd, tp, full_b[..]);
    rn = fww_tool_write(cwd, args, fww_fc(b), r[0].read_dedup[..], b[0].edit_buf[..], r[0].acc[0].tools[idx].res[..], is_err[..], out);
    if !is_err[0] {
      for qi: 0..<r[0].query_dedup.count { r[0].query_dedup[qi] = 0; }
      if fp.count > 0 {
        ne := [1] int.[r[0].ndep_edited];
        fww_tp_add_hash(r[0].dep_edited_hashes[..], ne[..], fww_str_hash(fp));
        r[0].ndep_edited = ne[0];
        if cfg[0].exp_toolpulse {
          nv := [1] int.[r[0].ntp_viewed];
          fww_tp_add_hash(r[0].tp_viewed_files[..], nv[..], fww_str_hash(fp));
          r[0].ntp_viewed = nv[0];
        }
      }
      if cfg[0].exp_edit_ground {
        rn = fww_edit_integrity_check(cwd, tp, r[0].acc[0].tools[idx].res[..], rn);
      }
    }
  }
  else if name == "Glob" || name == "Grep" {
    qh := fww_tool_sig_hash(name, args);
    q_dup := false;
    for qi: 0..<r[0].query_dedup.count { if r[0].query_dedup[qi] == qh { q_dup = true; break; } }
    if q_dup {
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], 0, "Identical ");
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], rn, name);
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], rn, " query already ran earlier with no file edits since — refer to the earlier result above and move forward.");
    } else {
      rn = ifx name == "Glob"
           then fww_tool_glob(cwd, args, r[0].acc[0].tools[idx].res[..], is_err[..], out)
           else fww_tool_grep(cwd, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
      if !is_err[0] {
        r[0].query_dedup[r[0].query_dedup_cur % r[0].query_dedup.count] = qh;
        r[0].query_dedup_cur = (r[0].query_dedup_cur + 1) % r[0].query_dedup.count;
      }
    }
  }
  else if name == "TodoWrite" { rn = fww_tool_todos(args, r[0].acc[0].tools[idx].res[..], is_err[..], out); }
  else if name == "WebFetch" { rn = fww_tool_webfetch(args, auth, b[0].file_buf[..], r[0].acc[0].tools[idx].res[..], is_err[..], out); }
  else if name == "WebSearch" { rn = fww_tool_websearch(args, auth, b[0].file_buf[..], r[0].acc[0].tools[idx].res[..], is_err[..], out); }
  else if fww_is_coax_intel_tool(name) {
    rn = fww_tool_coax_intel(cwd, name, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
    if name == "CoaxReplace" && !is_err[0] {
      for qi: 0..<r[0].query_dedup.count { r[0].query_dedup[qi] = 0; }
    }
  }
  else if oa_member_is_wallet_tool(name) {
    rn = fww_tool_wallet(name, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else if oa_member_is_cli_tool(name) {
    rn = fww_tool_cli(cwd, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else if oa_member_is_metaverse_tool(name) {
    rn = fww_tool_metaverse(cwd, name, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else if oa_member_is_knowledge_tool(name) {
    rn = fww_tool_knowledge(cwd, name, args, b[0].kb_idx[..], r[0].acc[0].tools[idx].res[..], is_err[..]);
  }
  else if oa_member_is_capability_tool(name) {
    rn = fww_tool_capability(cwd, cast(string) r[0].home[0..<r[0].nhome], name, args, r[0].acc[0].tools[idx].res[..], is_err[..]);
  }
  else if oa_member_is_session_tool(name) {
    rn = fww_tool_session(name, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else if name == "TaskStop" {
    rn = fww_tool_task_stop(r, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else if name == "TaskOutput" {
    rn = fww_tool_task_output(r, args, r[0].acc[0].tools[idx].res[..], is_err[..]);
  }
  else if name == "EnterWorktree" {
    rn = fww_tool_enter_worktree(r, args, r[0].acc[0].tools[idx].res[..], is_err[..]);
    if !is_err[0] { flawed_fc_reset(fww_fc(b)); }
  }
  else if name == "ExitWorktree" {
    rn = fww_tool_exit_worktree(r, args, r[0].acc[0].tools[idx].res[..], is_err[..]);
    if !is_err[0] { flawed_fc_reset(fww_fc(b)); }
  }
  else {
    is_err[0] = true;
    rn = fww_keep(r[0].acc[0].tools[idx].res[..], "Unknown tool.");
  }
  r[0].acc[0].tools[idx].nres = rn;
  r[0].acc[0].tools[idx].is_error = is_err[0];
  r[0].acc[0].tools[idx].done = true;
  return false;
}

// Advance tool execution queue; when all tools finish, append tool_results to history and start next LLM step.
fww_advance_tools :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, out: [] u8) -> string {
  while r[0].next_tool_idx < r[0].acc[0].ntools {
    idx := r[0].next_tool_idx;
    if r[0].acc[0].tools[idx].done { r[0].next_tool_idx += 1; continue; }

    name := cast(string) r[0].acc[0].tools[idx].name[0..<r[0].acc[0].tools[idx].nname];
    args := cast(string) r[0].acc[0].tools[idx].args[0..<r[0].acc[0].tools[idx].nargs];

    // Parallel Agent/Task delegation batching (#14096): collect consecutive Agent calls & launch simultaneously
    if name == "Agent" || name == "Task" {
      if r[0].is_subagent {
        r[0].acc[0].tools[idx].done = true;
        r[0].acc[0].tools[idx].is_error = true;
        r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Nested subagent delegation is disabled inside subagents to prevent unbounded recursion.");
        r[0].next_tool_idx += 1;
        continue;
      }
      batch_end := idx + 1;
      while batch_end < r[0].acc[0].ntools && (batch_end - idx) < FWW_MAX_DELEGATE_BATCH {
        if r[0].acc[0].tools[batch_end].done { break; }
        nm_next := cast(string) r[0].acc[0].tools[batch_end].name[0..<r[0].acc[0].tools[batch_end].nname];
        if nm_next != "Agent" && nm_next != "Task" { break; }
        batch_end += 1;
      }
      home_s := cast(string) r[0].home[0..<r[0].nhome];
      if fww_start_delegate_batch(r, cfg, h, home_s, idx, batch_end, out) {
        return ""; // waiting asynchronously for MWW_RESULTS or local subprocesses
      }
      r[0].next_tool_idx = batch_end;
      continue;
    }

    tb: [2048] u8;
    target := fww_tool_target(name, args, tb[..]);
    full_b: [FS_PATH_MAX] u8;
    check_target := ifx (name == "Edit" || name == "Write") && target.count > 0 then fww_resolve_path(cast(string) r[0].cwd[0..<r[0].ncwd], target, full_b[..]) else target;
    beh := flawed_wire_tool_permission(name, check_target, cfg[0].permission_mode, cfg[0].bypass_danger, r[0].session_allow);
    if beh == FLAWED_PBEH_DENY {
      r[0].acc[0].tools[idx].done = true;
      r[0].acc[0].tools[idx].is_error = true;
      r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Permission denied by active OpenAgents permission mode.");
      r[0].next_tool_idx += 1;
      continue;
    }
    if beh == FLAWED_PBEH_ASK {
      r[0].next_ticket += 1;
      r[0].permit_ticket = r[0].next_ticket;
      r[0].permit_tool_idx = idx;
      r[0].waiting_permit = true;
      is_sensitive := oa_member_is_bypass_immune(name, check_target);
      ttl_b: [160] u8;
      tn := fww_cat(ttl_b[..], 0, ifx is_sensitive then "Approve sensitive action: " else "Allow OpenAgents to run ");
      tn = fww_cat(ttl_b[..], tn, name);
      opts := ifx is_sensitive
              then "[{\"optionId\":\"allow_once\",\"name\":\"Approve once\",\"kind\":\"allow_once\"}]"
              else "[{\"optionId\":\"allow_once\",\"name\":\"Allow once\",\"kind\":\"allow_once\"},{\"optionId\":\"allow_session\",\"name\":\"Allow for session\",\"kind\":\"allow_always\"}]";
      fww_send(out, mww_permit(out, r[0].permit_ticket, false, cast(string) ttl_b[0..<tn], target, opts));
      return "";
    }
    r[0].next_tool_idx += 1;
    if fww_exec_tool_now(r, cfg, auth, h, b, idx, out) {
      return ""; // async Bash running
    }
  }

  // H3: Stuck / duplicate tool-call loop guard
  if r[0].acc[0].ntools == 1 {
    nm0 := cast(string) r[0].acc[0].tools[0].name[0..<r[0].acc[0].tools[0].nname];
    ar0 := cast(string) r[0].acc[0].tools[0].args[0..<r[0].acc[0].tools[0].nargs];
    th := fww_tool_sig_hash(nm0, ar0);
    if th == r[0].last_tool_hash {
      r[0].dup_tool_streak += 1;
      r[0].acc[0].tools[0].nres = fww_cat(r[0].acc[0].tools[0].res[..], r[0].acc[0].tools[0].nres,
        "\n[OpenAgents loop guard: you already ran this exact tool call above. Do not repeat it — try a genuinely different approach or synthesize your final answer now.]");
    } else {
      r[0].last_tool_hash = th;
      r[0].dup_tool_streak = 0;
    }
  } else {
    r[0].last_tool_hash = 0;
    r[0].dup_tool_streak = 0;
  }

  // Decide before appending tool results whether the next step must be a graceful final wrap-up (H2 + H3 + H8)
  r[0].step_num += 1;
  max_t := ifx cfg[0].max_turns > 0 then cfg[0].max_turns else 64;
  hit_last_turn := r[0].step_num >= max_t;
  hit_soft_time := r[0].soft_deadline_ms > 0 && proc_now_ms() >= r[0].soft_deadline_ms;
  hit_dup_limit := r[0].dup_tool_streak >= 2;
  need_wrapup := hit_last_turn || hit_soft_time || hit_dup_limit;

  // Track edit progress, bash verification status, & Stage-B per-turn aggregate tool-result budget
  // (Claude Code toolResultStorage.ts pattern: Read ALWAYS opts out — maxResultSizeChars: Infinity!)
  step_had_edit := false;
  step_had_bash := false;
  step_bash_ok := true;
  step_had_err := false;
  step_tot_bytes := 0;
  non_read_bytes := 0;
  non_read_cnt := 0;
  for ti: 0..<r[0].acc[0].ntools {
    nm_ti := cast(string) r[0].acc[0].tools[ti].name[0..<r[0].acc[0].tools[ti].nname];
    err_ti := r[0].acc[0].tools[ti].is_error;
    ar_ti := cast(string) r[0].acc[0].tools[ti].args[0..<r[0].acc[0].tools[ti].nargs];
    pt_b: [512] u8;
    tgt_ti := fww_tool_target(nm_ti, ar_ti, pt_b[..]);
    if err_ti { step_had_err = true; }
    if (nm_ti == "Edit" || nm_ti == "Write") && !err_ti {
      if cfg[0].exp_memtrace || cfg[0].exp_compact_preserve {
        fww_trace_record_file(h, cast(string) r[0].cwd[0..<r[0].ncwd], tgt_ti, true);
      }
      if cfg[0].exp_pmcoder && tgt_ti.count > 0 {
        eh := fww_trace_hash_bytes(tgt_ti);
        if eh == r[0].pm_last_edit_hash { r[0].pm_same_file_churn += 1; }
        else { r[0].pm_last_edit_hash = eh; r[0].pm_same_file_churn = 1; }
      }
      if cfg[0].exp_toolpulse {
        // State-changing action resets Failure Inertia (ToolPulse Eq. 9: z_j in L_change)
        r[0].tp_last_err_sig = 0;
        r[0].tp_err_inertia_cnt = 0;
      }
      if cfg[0].exp_faith_check {
        r[0].faith_edited_after_test = true;
        if r[0].nfaith_failed_edit_path > 0 && fww_path_basename(tgt_ti) == fww_path_basename(cast(string) r[0].faith_failed_edit_path[0..<r[0].nfaith_failed_edit_path]) {
          r[0].nfaith_failed_edit_path = 0;
        }
      }
      if !fww_is_scratch_path(tgt_ti) {
        step_had_edit = true;
      }
    } else if (nm_ti == "Edit" || nm_ti == "Write") && err_ti {
      if cfg[0].exp_faith_check && tgt_ti.count > 0 {
        r[0].nfaith_failed_edit_path = fww_keep(r[0].faith_failed_edit_path[..], tgt_ti);
      }
    } else if nm_ti == "Read" && !err_ti && (cfg[0].exp_memtrace || cfg[0].exp_compact_preserve) {
      fww_trace_record_file(h, cast(string) r[0].cwd[0..<r[0].ncwd], tgt_ti, false);
    }
    if nm_ti == "Bash" {
      step_had_bash = true;
      if err_ti { step_bash_ok = false; }
      if cfg[0].exp_memtrace || cfg[0].exp_compact_preserve {
        fww_trace_record_cmd(h, tgt_ti, !err_ti);
      }
      if cfg[0].exp_faith_check {
        r[0].faith_ran_test = true;
        r[0].faith_last_test_ok = !err_ti;
        r[0].faith_edited_after_test = false;
      }
    }
    if cfg[0].exp_toolpulse && err_ti {
      esig := fww_tp_err_sig(nm_ti, cast(string) r[0].acc[0].tools[ti].res[0..<r[0].acc[0].tools[ti].nres]);
      if esig != 0 && esig == r[0].tp_last_err_sig {
        r[0].tp_err_inertia_cnt += 1;
        r[0].acc[0].tools[ti].nres = fww_cat(r[0].acc[0].tools[ti].res[..], r[0].acc[0].tools[ti].nres,
          "\n[ToolPulse: Failure Inertia — identical error repeated with no code change in between. Diagnose the root cause and apply a concrete change before retrying.]");
      } else {
        r[0].tp_last_err_sig = esig;
        r[0].tp_err_inertia_cnt = 0;
      }
    }
    nb_ti := r[0].acc[0].tools[ti].nres;
    step_tot_bytes += nb_ti;
    if nm_ti != "Read" {
      non_read_bytes += nb_ti;
      non_read_cnt += 1;
    }
  }
  if step_had_edit { r[0].has_edited = true; r[0].last_bash_ok = false; }
  else if !r[0].has_edited { r[0].read_only_steps += 1; }
  if step_had_bash {
    r[0].last_bash_ok = step_bash_ok;
    if cfg[0].exp_pmcoder {
      if step_bash_ok { r[0].pm_fail_streak = 0; } else { r[0].pm_fail_streak += 1; }
    }
  }
  r[0].last_step_had_err = step_had_err;
  if r[0].has_edited { r[0].post_edit_steps += 1; }
  r[0].turn_tool_bytes += step_tot_bytes;

  // All tool calls finished! Compute exact slab bytes needed so TOOL_RESULTS NEVER truncates id/name/output/image.
  tr_need := 16384;
  for ti: 0..<r[0].acc[0].ntools {
    tr_need += r[0].acc[0].tools[ti].nid + r[0].acc[0].tools[ti].nname + r[0].acc[0].tools[ti].nres
             + r[0].acc[0].tools[ti].nimg_mime + r[0].acc[0].tools[ti].nimg;
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 1 || h[0].nslab + tr_need >= FWW_SLAB {
    _ = fww_hist_compact(h, b[0].compact_buf[..]);
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 1 || h[0].nslab + tr_need >= FWW_SLAB {
    _ = fww_emergency_compact(h, 2, 0, b[0].compact_buf[..]);
  }
  if h[0].nmsgs < FWW_MAX_MSGS {
    mi := h[0].nmsgs;
    h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS};
    nb := 0;
    is_local_tr := auth[0].backend == FLAWED_BE_LOCAL;
    turn_budget := ifx is_local_tr then FWW_TURN_TOOLS_BUDGET_LOCAL else FWW_TURN_TOOLS_BUDGET_CLOUD;
    per_non_read_cap := ifx is_local_tr then FWW_LOCAL_TOOL_OUT_MAX else FWW_TOOL_OUT_MAX;
    if non_read_bytes > turn_budget && non_read_cnt > 1 {
      share := turn_budget / non_read_cnt;
      min_share := ifx is_local_tr then 4096 else 10240;
      if share < min_share { share = min_share; }
      if share < per_non_read_cap { per_non_read_cap = share; }
    }
    for i: 0..<r[0].acc[0].ntools {
      if nb >= FWW_MAX_BLOCKS { break; }
      a0 := [1] int.[0];
      id_s := cast(string) r[0].acc[0].tools[i].id[0..<r[0].acc[0].tools[i].nid];
      nm_s := cast(string) r[0].acc[0].tools[i].name[0..<r[0].acc[0].tools[i].nname];
      res_s := cast(string) r[0].acc[0].tools[i].res[0..<r[0].acc[0].tools[i].nres];
      // Claude Code invariant: Read is self-bounded (FWW_READ_CLOUD_BYTES / FWW_LOCAL_TOOL_OUT_MAX) and opts out of Stage B!
      if nm_s != "Read" && res_s.count > per_non_read_cap {
        why_s := ifx is_local_tr then "truncated for 32K local context; use targeted filters;" else "trimmed by per-turn tool-result budget; use narrower Grep path/glob or concise Bash output;";
        sn := fww_shrink_head_tail(b[0].compact_buf[..], 0, res_s, per_non_read_cap, why_s);
        res_s = cast(string) b[0].compact_buf[0..<sn];
      }
      // Hard slab guard: reserve space for remaining tools' id+name+metadata so name/id can NEVER be clipped.
      rem_tools := r[0].acc[0].ntools - i;
      reserve := rem_tools * 512 + 8192;
      avail_res := FWW_SLAB - h[0].nslab - id_s.count - nm_s.count - reserve;
      if avail_res < 256 { avail_res = 256; }
      if res_s.count > avail_res {
        sn := fww_shrink_head_tail(b[0].compact_buf[..], 0, res_s, avail_res, "trimmed for history slab;");
        res_s = cast(string) b[0].compact_buf[0..<sn];
      }
      bk := FwBlock.{kind = FWW_MB_TOOL_RES, is_error = r[0].acc[0].tools[i].is_error};
      bk.id_n = fww_slab_put(h, id_s, a0[..]); bk.id_at = a0[0];
      bk.name_n = fww_slab_put(h, nm_s, a0[..]); bk.name_at = a0[0];
      bk.text_n = fww_slab_put(h, res_s, a0[..]); bk.text_at = a0[0];
      if r[0].acc[0].tools[i].nimg > 0 && r[0].acc[0].tools[i].nimg_mime > 0 {
        im_s := cast(string) r[0].acc[0].tools[i].img_mime[0..<r[0].acc[0].tools[i].nimg_mime];
        idb_s := cast(string) r[0].acc[0].tool_img_slab[r[0].acc[0].tools[i].img_at..<r[0].acc[0].tools[i].img_at + r[0].acc[0].tools[i].nimg];
        if h[0].nslab + im_s.count + idb_s.count + reserve < FWW_SLAB {
          bk.img_mime_n = fww_slab_put(h, im_s, a0[..]); bk.img_mime_at = a0[0];
          bk.img_n = fww_slab_put(h, idb_s, a0[..]); bk.img_at = a0[0];
        }
      }
      h[0].msgs[mi].blocks[nb] = bk;
      nb += 1;
    }
    // Cache-safe time-aware & wall-budget-aware <system-reminder> pacing nudges (folded into last functionResponse on Gemini)
    if !cfg[0].bare_mode && !need_wrapup && nb < FWW_MAX_BLOCKS {
      elapsed_s := ifx r[0].turn_start_ms > 0 then (proc_now_ms() - r[0].turn_start_ms) / 1000 else 0;
      bs := cfg[0].budget_s;
      nudge := "";
      nbuf: [512] u8;
      // Optional wall-budget checkpoints (when FLAWED_BUDGET_S > 0, e.g. timed CI/benchmark runs)
      if bs >= 120 {
        rem_s := ifx bs > elapsed_s then bs - elapsed_s else 0;
        if r[0].time_warn_stage < 4 && elapsed_s * 100 >= bs * 90 {
          r[0].time_warn_stage = 4;
          r[0].calm_steps = 2;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>FINAL time checkpoint (~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          if r[0].has_edited && r[0].last_bash_ok && !r[0].last_step_had_err {
            r[0].finish_nudged = true;
            nn = fww_cat(nbuf[..], nn, "s left): your checks are green. Stop here and reply concisely NOW — do NOT run sleeps, slow commands, or extra checks.</system-reminder>");
          } else {
            nn = fww_cat(nbuf[..], nn, "s left): write/finalize your deliverable outputs IMMEDIATELY, run at most one quick (<15s) smoke check (no long sleeps), and conclude now.</system-reminder>");
          }
          nudge = cast(string) nbuf[0..<nn];
        } else if r[0].time_warn_stage < 3 && elapsed_s * 100 >= bs * 80 {
          r[0].time_warn_stage = 3;
          r[0].calm_steps = 2;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>Time budget checkpoint (~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          if r[0].has_edited && r[0].last_bash_ok && !r[0].last_step_had_err {
            if !r[0].audit_nudged {
              r[0].audit_nudged = true;
              nn = fww_cat(nbuf[..], nn, "s left): your initial check passed. Run ONE fast adversarial/edge-case test checking every explicit requirement and varied inputs (not just default fixtures), fix any gap immediately, clean up temp files, and conclude before the deadline.</system-reminder>");
            } else {
              r[0].finish_nudged = true;
              nn = fww_cat(nbuf[..], nn, "s left): your workspace edits and post-audit checks are green. Clean up any stray temporary files if needed and conclude concisely now.</system-reminder>");
            }
          } else if !r[0].has_edited {
            nn = fww_cat(nbuf[..], nn, "s left): stop all exploration/probing immediately, write your complete deliverable solution files (or apply live target changes) in THIS turn, and run one fast end-to-end verification check.</system-reminder>");
          } else {
            nn = fww_cat(nbuf[..], nn, "s left): prioritize fixing the remaining failing check directly in this turn and re-run fast verification immediately.</system-reminder>");
          }
          nudge = cast(string) nbuf[0..<nn];
        } else if !r[0].has_edited && r[0].time_warn_stage < 2 && elapsed_s * 100 >= bs * 60 {
          r[0].time_warn_stage = 2;
          r[0].calm_steps = 2;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>Urgent time checkpoint (");
          nn = fww_put_int(nbuf[..], nn, elapsed_s);
          nn = fww_cat(nbuf[..], nn, "s elapsed, ~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          nn = fww_cat(nbuf[..], nn, "s remaining, zero deliverable workspace files edited yet): stop incremental probe scripts now. Immediately write/apply your deliverable solution in THIS turn and verify end-to-end.</system-reminder>");
          nudge = cast(string) nbuf[0..<nn];
        } else if !r[0].has_edited && r[0].time_warn_stage < 1 && elapsed_s * 100 >= bs * 35 {
          r[0].time_warn_stage = 1;
          r[0].calm_steps = 1;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>Time checkpoint (");
          nn = fww_put_int(nbuf[..], nn, elapsed_s);
          nn = fww_cat(nbuf[..], nn, "s elapsed, ~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          nn = fww_cat(nbuf[..], nn, "s remaining, no workspace edits yet): stop running probe-by-probe commands. Synthesize what you know, apply your concrete deliverable edits/writes (or target changes) now, and iterate from end-to-end test output.</system-reminder>");
          nudge = cast(string) nbuf[0..<nn];
        }
      }
      if nudge.count == 0 {
        if !r[0].has_edited {
          if r[0].nudge_stage == 2 && (r[0].read_only_steps >= 13 || (elapsed_s >= 320 && r[0].read_only_steps >= 9)) {
            r[0].nudge_stage = 3;
            nudge = "<system-reminder>Urgent pacing alert: stop further read-only exploration now. Emit your concrete Edit/Write in THIS turn and run the targeted verification command.</system-reminder>";
          } else if r[0].nudge_stage == 1 && (r[0].read_only_steps >= 10 || (elapsed_s >= 220 && r[0].read_only_steps >= 7)) {
            r[0].nudge_stage = 2;
            nudge = "<system-reminder>Pacing alert: stop searching peripheral files or running tiny probe scripts. Apply your concrete Edit/Write on the target file(s) in this turn (batching independent edits) and test against real execution.</system-reminder>";
          } else if r[0].nudge_stage == 0 && (r[0].read_only_steps >= 6 || (r[0].read_only_steps >= 4 && elapsed_s >= 120)) {
            r[0].nudge_stage = 1;
            nudge = "<system-reminder>Exploration checkpoint: you have inspected the relevant files across multiple read-only turns. Synthesize the general invariant, apply your Edit/Write changes now, and validate with automated tests. (If the user only asked a question, answer concisely now.)</system-reminder>";
          }
        } else if r[0].last_bash_ok && !r[0].last_step_had_err {
          if !r[0].audit_nudged {
            r[0].audit_nudged = true;
            nudge = "<system-reminder>Your initial check passed. Before finishing, critically challenge your patch from first principles: (1) does it hold for the general invariant across multiple sequential, concurrent, or interleaved operations and edge cases (such as multi-step state transitions, deletions, and boundary or malformed inputs), not only the minimal repro? (2) are all explicit specification constraints and error paths verified by an automated check (re-running your full test suite after any edit and cleaning up temporary test files inside the workspace afterward)? If everything holds, conclude concisely.</system-reminder>";
          } else {
            r[0].audit_done = true;
            if !r[0].finish_nudged && (r[0].post_edit_steps >= 7 || elapsed_s >= 420) {
              r[0].finish_nudged = true;
              nudge = "<system-reminder>Your edits and post-audit verification checks are green. Stop here and reply concisely — do NOT run redundant extra checks or gold-plate.</system-reminder>";
            }
          }
        }
      }
      if nudge.count == 0 && cfg[0].exp_pmcoder {
        if (r[0].pm_fail_streak >= 2 || (r[0].pm_same_file_churn >= 2 && step_had_err)) && r[0].pm_backtracks < 3 {
          r[0].pm_backtracks += 1;
          nudge = "<system-reminder>[PMCoder Phase: BACKTRACK] Repeated test failure or single-file edit churn detected. STOP patching local symptoms. Run `git diff`, trace the shared root invariant across ALL coupled files/modules in the repo, and fix the underlying invariant cleanly before re-running the full test suite. Do not conclude while tests fail.</system-reminder>";
        } else if r[0].has_edited && !r[0].last_bash_ok && !step_had_bash && r[0].post_edit_steps >= 2 && r[0].pm_backtracks == 0 {
          nudge = "<system-reminder>[PMCoder Phase: VERIFICATION] You have edited files without fresh verification. Run the full test/reproduction command now to ground your changes against execution.</system-reminder>";
        }
      }
      if nudge.count > 0 {
        a0 := [1] int.[0];
        nb_rem := FwBlock.{kind = FWW_MB_TEXT};
        nb_rem.text_n = fww_slab_put(h, nudge, a0[..]); nb_rem.text_at = a0[0];
        h[0].msgs[mi].blocks[nb] = nb_rem;
        nb += 1;
      }
    }
    // Inject any pending mid-turn steers right into this user turn!
    if st[0].n > 0 && nb < FWW_MAX_BLOCKS {
      jb: [MWQ_MESSAGE] u8;
      stxt := mc_steer_join(st, jb[..]);
      if stxt.count > 0 {
        a0 := [1] int.[0];
        sb := FwBlock.{kind = FWW_MB_TEXT};
        sb.text_n = fww_slab_put(h, stxt, a0[..]); sb.text_at = a0[0];
        h[0].msgs[mi].blocks[nb] = sb;
        nb += 1;
        _ = mc_steer_take(st, r[0].step_num);
      }
    }
    // Inject graceful wrap-up instruction on final turn / soft deadline / duplicate-loop cap
    if need_wrapup && !r[0].force_wrapup_once && nb < FWW_MAX_BLOCKS {
      a0 := [1] int.[0];
      wb := FwBlock.{kind = FWW_MB_TEXT};
      wmsg := "Wrap-up turn: do not call any more tools. Using all computations and tool outputs above, write your complete, concise final answer now in the exact format requested by the user.";
      wb.text_n = fww_slab_put(h, wmsg, a0[..]); wb.text_at = a0[0];
      h[0].msgs[mi].blocks[nb] = wb;
      nb += 1;
    }
    h[0].msgs[mi].nblocks = nb;
    h[0].nmsgs += 1;
    fww_run_append_sidechain_msg(r, h, mi, b[0].compact_buf[..]);
  }

  if need_wrapup {
    if r[0].force_wrapup_once {
      r[0].active = false;
      fww_send(out, mww_ended(out, "finished", "Reached Flawed max turns limit."));
      return "finished";
    }
    r[0].force_wrapup_once = true;
    if hit_soft_time && auth[0].backend == FLAWED_BE_LOCAL {
      r[0].force_no_think_once = true;
    }
  }
  if cfg[0].max_budget_micros > 0 && r[0].turn_cost_micros >= cfg[0].max_budget_micros {
    r[0].active = false;
    fww_send(out, mww_ended(out, "finished", "Reached Flawed max budget limit."));
    return "finished";
  }

  err := fww_start_request(r, cfg, auth, h, b, out);
  if err.count > 0 {
    r[0].active = false;
    fww_send(out, mww_ended(out, "failed", err));
    return "failed";
  }
  return "";
}

// Extract readable error.message from single-object or Gemini array error response body.
fww_extract_err_msg :: (raw_body: string, out: [] u8) -> int {
  t := fww_trim(raw_body);
  if t.count == 0 { return 0; }
  nodes: [256] JvNode; d: [1] Jv;
  if jv_parse(d[..], t, nodes[..]) {
    root := 0;
    if jv_kind(d[0], 0) == JV_ARRAY && jv_len(d[0], 0) > 0 { root = jv_at(d[0], 0, 0); }
    em := jv_path(d[0], root, "error.message");
    if em < 0 { em = jv_get(d[0], root, "message"); }
    if em >= 0 {
      n := jv_str(d[0], em, out);
      if n > 0 { return n; }
    }
  }
  return fww_keep(out, t);
}

// Commit finished assistant stream into history, then either run tools or end turn.
fww_finish_stream :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, out: [] u8) -> string {
  status := r[0].gw[0].status;
  exit_code := r[0].gw[0].exit;
  gw_close(r[0].gw[..]);
  r[0].streaming = false;
  r[0].last_req_dur_ms = ifx r[0].req_start_ms > 0 then proc_now_ms() - r[0].req_start_ms else 0;

  // Check transport / HTTP error with reactive context-overflow compaction + Ch 05 retry policy
  if status < 200 || status >= 300 || r[0].acc[0].saw_error {
    if r[0].acc[0].nerr == 0 && r[0].acc[0].nerr_body > 0 {
      r[0].acc[0].nerr = fww_extract_err_msg(cast(string) r[0].acc[0].err_body[0..<r[0].acc[0].nerr_body], r[0].acc[0].err_msg[..]);
    }
    err_s := cast(string) r[0].acc[0].err_msg[0..<r[0].acc[0].nerr];
    is_sig_err := fww_contains_ci(err_s, "thought signature")
               || fww_contains_ci(err_s, "thought_signature")
               || fww_contains_ci(err_s, "thoughtsignature");
    is_invalid_arg := (status == 400 || r[0].acc[0].saw_error)
                   && (fww_contains_ci(err_s, "invalid argument")
                    || fww_contains_ci(err_s, "proto is invalid"));
    is_struct_err := is_sig_err
                  || fww_contains_ci(err_s, "ending with a model turn")
                  || fww_contains_ci(err_s, "function call turn")
                  || fww_contains_ci(err_s, "function response turn")
                  || fww_contains_ci(err_s, "must alternate")
                  || fww_contains_ci(err_s, "tool_call_id")
                  || (is_invalid_arg && h[0].nmsgs > 1);
    if (fww_is_context_overflow_err(err_s) || is_struct_err) && r[0].ctx_recoveries < 3 {
      r[0].ctx_recoveries += 1;
      if fww_is_context_overflow_err(err_s) {
        parsed_lim := fww_parse_ctx_limit_from_err(err_s);
        if parsed_lim >= 2048 && (r[0].effective_ctx_cap == 0 || parsed_lim < r[0].effective_ctx_cap) {
          r[0].effective_ctx_cap = parsed_lim;
        }
        _ = fww_emergency_compact(h, r[0].ctx_recoveries, r[0].effective_ctx_cap, b[0].compact_buf[..]);
      } else if is_sig_err && r[0].ctx_recoveries == 1 {
        // Surgical signature repair: preserve full conversation history instead of wiping 50K+ tokens!
        if h[0].nslab + 64 >= FWW_SLAB { _ = fww_hist_compact(h, b[0].compact_buf[..]); }
        fww_hist_strip_thought_sigs(h);
      } else {
        // Structural turn mismatch / Vertex INVALID_ARGUMENT on multi-turn history: collapse to clean summary USER turn!
        _ = fww_emergency_compact(h, 3, r[0].effective_ctx_cap, b[0].compact_buf[..]);
      }
      fww_hist_sanitize(h, b[0].compact_buf[..]);
      r[0].retry[0] = FlawedRetryState.{max_retries = 3};
      fww_emit_attempt(r, auth, "retried", status, 0, out);
      err2 := fww_start_request(r, cfg, auth, h, b, out);
      if err2.count == 0 { return ""; }
    }
    transient_sse := r[0].acc[0].saw_error && fww_is_transient_sse_err(err_s);
    auth_err := fww_is_auth_err(status, err_s);
    eff_status := ifx transient_sse then 503
                  else ifx auth_err && status == 200 then 401
                  else ifx status > 0 then status else 503;
    ri := FlawedRetryInput.{
      status = eff_status,
      is_foreground = true,
      retry_after_ms = -1,
    };
    dec := flawed_eval_retry(r[0].retry[..], ri);
    if dec.action == FLAWED_RETRY_SLEEP && (!r[0].acc[0].saw_error || transient_sse || auth_err) {
      if dec.rebuild_client || auth_err {
        _ = fww_refresh_request_auth(auth, true);
      }
      fww_emit_attempt(r, auth, "retried", eff_status, 0, out);
      r[0].retry_at_ms = proc_now_ms() + dec.delay_ms;
      return "";
    }
    fww_emit_attempt(r, auth, "failed", status, 0, out);
    eb: [640] u8;
    en := 0;
    if r[0].acc[0].nerr > 0 {
      en = fww_cat(eb[..], 0, cast(string) r[0].acc[0].err_msg[0..<r[0].acc[0].nerr]);
    } else if status == 401 || status == 403 {
      en = fww_cat(eb[..], 0, "Authentication failed (HTTP ");
      en = fww_put_int(eb[..], en, status);
      en = fww_cat(eb[..], en, "). Check your Vertex AI / Gemini credentials in Settings → Flawed.");
    } else if status > 0 {
      en = fww_cat(eb[..], 0, "API request failed with HTTP ");
      en = fww_put_int(eb[..], en, status);
    } else {
      en = fww_cat(eb[..], 0, "Could not reach API server (curl exit ");
      en = fww_put_int(eb[..], en, exit_code);
      en = fww_cat(eb[..], en, ").");
    }
    r[0].active = false;
    fww_send(out, mww_ended(out, "failed", cast(string) eb[0..<en]));
    return "failed";
  }

  // Account cost via coax/lib/gateway/card.coax ($0 for Local Psionic Metal; OpenAgents retail for FLAWED_BE_OURS; #14070)
  rm_cost := ifx r[0].acc[0].nresp_model > 0 then cast(string) r[0].acc[0].resp_model[0..<r[0].acc[0].nresp_model] else flawed_wire_strip_model(cast(string) r[0].model[0..<r[0].nmodel]);
  cost := fww_turn_cost_micros(auth[0].backend, rm_cost, r[0].acc[0].in_tok, r[0].acc[0].cache_read, r[0].acc[0].out_tok);
  r[0].ctx_recoveries = 0;
  r[0].retry[0] = FlawedRetryState.{max_retries = 3};
  r[0].turn_cost_micros += cost;
  h[0].total_in += r[0].acc[0].in_tok;
  h[0].total_out += r[0].acc[0].out_tok;
  h[0].total_cached += r[0].acc[0].cache_read;
  h[0].total_cost_micros += cost;
  if r[0].acc[0].in_tok > 0 {
    h[0].last_in_tok = r[0].acc[0].in_tok;
    h[0].last_in_bytes = r[0].last_req_est_bytes;
  }
  if auth[0].backend != FLAWED_BE_LOCAL {
    now_fin := proc_now_ms();
    h[0].last_cloud_turn_ms = now_fin;
    if r[0].acc[0].cache_read > 0 { h[0].last_cached_tok = r[0].acc[0].cache_read; }
    // Adaptive thinking cooldown: measured strictly on actual decode duration (excluding TTFT queue wait).
    // After a heavy (>=120s decode) deep-reasoning step, run the next 2 execution/testing steps at medium
    // effort so back-to-back 150-185s rumination loops don't starve edit-test-fix iteration.
    dec_fin_ms := ifx r[0].first_tok_ms > 0 && now_fin > r[0].first_tok_ms then now_fin - r[0].first_tok_ms else 0;
    if cfg[0].thinking_mode == FLAWED_THINK_ADAPTIVE && !cfg[0].bare_mode && dec_fin_ms >= 120000 && r[0].calm_steps < 2 {
      r[0].calm_steps = 2;
    }
  }
  fww_emit_attempt(r, auth, "done", status, cost, out);

  // Append assistant message to history (compute exact slab headroom so ASSISTANT + TOOL_USE names/args/sigs never clip!)
  asst_need := r[0].acc[0].nthink + r[0].acc[0].ntext + r[0].acc[0].nsig * 2 + 8192;
  for t: 0..<r[0].acc[0].ntools {
    asst_need += r[0].acc[0].tools[t].nid + r[0].acc[0].tools[t].nname + r[0].acc[0].tools[t].nargs + r[0].acc[0].tools[t].nsig;
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 2 || h[0].nslab + asst_need >= FWW_SLAB {
    _ = fww_hist_compact(h, b[0].compact_buf[..]);
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 2 || h[0].nslab + asst_need >= FWW_SLAB {
    _ = fww_emergency_compact(h, 2, 0, b[0].compact_buf[..]);
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 2 || h[0].nslab + asst_need >= FWW_SLAB {
    _ = fww_emergency_compact(h, 3, 0, b[0].compact_buf[..]);
  }
  if h[0].nmsgs < FWW_MAX_MSGS {
    mi := h[0].nmsgs;
    h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_ASSISTANT};
    nb := 0;
    a0 := [1] int.[0];
    if r[0].acc[0].nthink > 0 && nb < FWW_MAX_BLOCKS {
      tb := FwBlock.{kind = FWW_MB_THINK};
      tb.text_n = fww_slab_put(h, cast(string) r[0].acc[0].think[0..<r[0].acc[0].nthink], a0[..]); tb.text_at = a0[0];
      if r[0].acc[0].nsig > 0 { tb.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].sig[0..<r[0].acc[0].nsig], a0[..]); tb.sig_at = a0[0]; }
      h[0].msgs[mi].blocks[nb] = tb; nb += 1;
    }
    if (r[0].acc[0].ntext > 0 || (r[0].acc[0].nsig > 0 && r[0].acc[0].ntools == 0)) && nb < FWW_MAX_BLOCKS {
      xb := FwBlock.{kind = FWW_MB_TEXT};
      xb.text_n = fww_slab_put(h, cast(string) r[0].acc[0].text[0..<r[0].acc[0].ntext], a0[..]); xb.text_at = a0[0];
      if r[0].acc[0].nsig > 0 && r[0].acc[0].ntools == 0 { xb.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].sig[0..<r[0].acc[0].nsig], a0[..]); xb.sig_at = a0[0]; }
      h[0].msgs[mi].blocks[nb] = xb; nb += 1;
    }
    for t: 0..<r[0].acc[0].ntools {
      if nb >= FWW_MAX_BLOCKS { break; }
      ub := FwBlock.{kind = FWW_MB_TOOL_USE};
      ub.id_n = fww_slab_put(h, cast(string) r[0].acc[0].tools[t].id[0..<r[0].acc[0].tools[t].nid], a0[..]); ub.id_at = a0[0];
      ub.name_n = fww_slab_put(h, cast(string) r[0].acc[0].tools[t].name[0..<r[0].acc[0].tools[t].nname], a0[..]); ub.name_at = a0[0];
      ub.text_n = fww_slab_put(h, cast(string) r[0].acc[0].tools[t].args[0..<r[0].acc[0].tools[t].nargs], a0[..]); ub.text_at = a0[0];
      if r[0].acc[0].tools[t].nsig > 0 {
        sa := r[0].acc[0].tools[t].sig_at;
        sn := r[0].acc[0].tools[t].nsig;
        ub.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].tool_sig_slab[sa..<sa + sn], a0[..]); ub.sig_at = a0[0];
      } else if t == 0 && r[0].acc[0].nsig > 0 {
        ub.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].sig[0..<r[0].acc[0].nsig], a0[..]); ub.sig_at = a0[0];
      }
      h[0].msgs[mi].blocks[nb] = ub; nb += 1;
    }
    if nb > 0 {
      h[0].msgs[mi].nblocks = nb;
      h[0].nmsgs += 1;
      fww_run_append_sidechain_msg(r, h, mi, b[0].compact_buf[..]);
    }
  }

  // If tool calls were emitted, run them!
  if r[0].acc[0].ntools > 0 {
    r[0].next_tool_idx = 0;
    return fww_advance_tools(r, cfg, auth, h, b, st, out);
  }

  // H1: Automatic bounded recovery when a turn ends with empty visible text (e.g. max_tokens exhausted inside thinking).
  if r[0].acc[0].ntext == 0 && r[0].acc[0].stop_reason != FLAWED_STOP_REFUSAL && r[0].recoveries < 3 && h[0].nmsgs < FWW_MAX_MSGS {
    r[0].recoveries += 1;
    hit_think_cap := r[0].acc[0].stop_reason == FLAWED_STOP_MAX_TOKENS || r[0].acc[0].nthink > 8192;
    if hit_think_cap && auth[0].backend != FLAWED_BE_LOCAL {
      // Step down thinkingLevel one notch for the next 2 steps to break consecutive 32K thinking spirals.
      r[0].calm_steps = 2;
    }
    rb: [3072] u8;
    rn := 0;
    if r[0].acc[0].nthink > 0 {
      tlen := r[0].acc[0].nthink;
      tfrom := ifx tlen > 1800 then tlen - 1800 else 0;
      rn = fww_cat(rb[..], rn, "Your previous step hit the output token limit while reasoning without emitting tool calls or a reply. End of your scratchpad:\n\n");
      rn = fww_cat(rb[..], rn, cast(string) r[0].acc[0].think[tfrom..<tlen]);
      rn = fww_cat(rb[..], rn, "\n\nDo NOT re-derive from scratch. Keep reasoning brief and immediately emit your concrete Edit/Write/Bash tool calls to implement and test your changes (or, if already verified, write your concise final answer now).");
    } else {
      rn = fww_cat(rb[..], rn, "Your previous response was empty. Immediately emit your next concrete tool call or write your concise final answer.");
    }
    fww_hist_push_user(h, cast(string) rb[0..<rn]);
    if auth[0].backend == FLAWED_BE_LOCAL {
      r[0].force_no_think_once = true;
    }
    if r[0].recoveries >= 3 || (r[0].recoveries >= 2 && r[0].has_edited && r[0].last_bash_ok) {
      r[0].force_wrapup_once = true;
    }
    err := fww_start_request(r, cfg, auth, h, b, out);
    if err.count == 0 { return ""; }
  }

  // End-of-turn Receipt Grounding Check (OA_EXP_FAITH_CHECK: arXiv:2611.25760 + Epistemic Guard 2611.27095):
  // If final assistant prose asserts tests pass or an edit succeeded in contradiction to executed tool receipts,
  // trigger at most ONE silent verification/correction turn.
  if cfg[0].exp_faith_check && r[0].faith_retries == 0 && !r[0].force_wrapup_once
     && r[0].acc[0].ntext > 0 && h[0].nmsgs < FWW_MAX_MSGS - 2 {
    fmsg: [512] u8;
    f_reply := cast(string) r[0].acc[0].text[0..<r[0].acc[0].ntext];
    f_fail_p := cast(string) r[0].faith_failed_edit_path[0..<r[0].nfaith_failed_edit_path];
    fn := fww_faith_check_reply(f_reply, r[0].has_edited, r[0].faith_ran_test, r[0].faith_last_test_ok, r[0].faith_edited_after_test, f_fail_p, fmsg[..]);
    if fn > 0 {
      r[0].faith_retries += 1;
      fww_hist_push_user(h, cast(string) fmsg[0..<fn]);
      err := fww_start_request(r, cfg, auth, h, b, out);
      if err.count == 0 { return ""; }
    }
  }

  // Otherwise finish the turn!
  r[0].active = false;
  final_txt := cast(string) r[0].acc[0].text[0..<r[0].acc[0].ntext];
  fww_send(out, mww_ended(out, "finished", final_txt));
  return "finished";
}

// Poll active stream, retry backoff, or active Bash subprocess. Returns (emitted_activity, ended_string).
fww_poll_step :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, out: [] u8, active_io: [] bool) -> string {
  active_io[0] = false;
  if !r[0].active { return ""; }

  // 1. Waiting for retry backoff timer
  if r[0].retry_at_ms > 0 {
    if proc_now_ms() >= r[0].retry_at_ms {
      r[0].retry_at_ms = 0;
      err := fww_start_request(r, cfg, auth, h, b, out);
      if err.count > 0 {
        r[0].active = false;
        fww_send(out, mww_ended(out, "failed", err));
        return "failed";
      }
      active_io[0] = true;
    }
    return "";
  }

  // 2. Poll any standalone headless subagent subprocesses (foreground & background)
  ls_end := fww_poll_local_subagents(r, cfg, auth, h, b, st, out, active_io);
  if ls_end.count > 0 { return ls_end; }

  // 2b. Waiting for interactive permission card answer or delegated subagent results
  if r[0].waiting_permit || r[0].waiting_delegate || r[0].waiting_local_delegate { return ""; }

  // 3. Active async Bash subprocess
  if r[0].cmd[0].active {
    lbuf: [4096] u8;
    for step: 0..<64 {
      ln := proc_line(r[0].cmd[0].h, 0, lbuf[..]);
      if ln == PROC_TIMEOUT { break; }
      if ln == PROC_EOF || ln < 0 {
        exit_c := proc_wait(r[0].cmd[0].h, 2000);
        _ = proc_release(r[0].cmd[0].h);
        r[0].cmd[0].h = -1;
        r[0].cmd[0].active = false;
        ti := r[0].cmd[0].tool_idx;
        cmd_s := cast(string) r[0].cmd[0].cmd[0..<r[0].cmd[0].ncmd];
        _ = fww_cmd_finalize(r[0].cmd[..]);
        out_s := cast(string) r[0].cmd[0].out[0..<r[0].cmd[0].nout];
        fww_send(out, mww_command(out, cmd_s, exit_c, r[0].cmd[0].timed_out, out_s));
        r[0].acc[0].tools[ti].nres = fww_cmd_tool_result(r[0].cmd[..], exit_c, r[0].cmd[0].timed_out, r[0].acc[0].tools[ti].res[..]);
        r[0].acc[0].tools[ti].is_error = exit_c != 0 || r[0].cmd[0].timed_out;
        r[0].acc[0].tools[ti].done = true;
        active_io[0] = true;
        return fww_advance_tools(r, cfg, auth, h, b, st, out);
      }
      active_io[0] = true;
      fww_cmd_push_line(r[0].cmd[..], cast(string) lbuf[0..<ln]);
    }
    if proc_now_ms() >= r[0].cmd[0].deadline_ms {
      r[0].cmd[0].timed_out = true;
      _ = proc_kill(r[0].cmd[0].h, PROC_SIGTERM);
      if proc_wait(r[0].cmd[0].h, 400) < 0 { _ = proc_kill(r[0].cmd[0].h, PROC_SIGKILL); _ = proc_wait(r[0].cmd[0].h, 400); }
      _ = proc_release(r[0].cmd[0].h);
      r[0].cmd[0].h = -1;
      r[0].cmd[0].active = false;
      ti := r[0].cmd[0].tool_idx;
      cmd_s := cast(string) r[0].cmd[0].cmd[0..<r[0].cmd[0].ncmd];
      _ = fww_cmd_finalize(r[0].cmd[..]);
      out_s := cast(string) r[0].cmd[0].out[0..<r[0].cmd[0].nout];
      fww_send(out, mww_command(out, cmd_s, 124, true, out_s));
      r[0].acc[0].tools[ti].nres = fww_cmd_tool_result(r[0].cmd[..], 124, true, r[0].acc[0].tools[ti].res[..]);
      r[0].acc[0].tools[ti].is_error = true;
      r[0].acc[0].tools[ti].done = true;
      return fww_advance_tools(r, cfg, auth, h, b, st, out);
    }
    return "";
  }

  // 4. Active streaming HTTP SSE response (drain up to 32 SSE lines per tick with zero lag!)
  if !r[0].streaming { return ""; }
  is_gem := flawed_wire_is_gemini(auth[0].backend);
  for step: 0..<32 {
    rd := gw_poll_wait(r[0].gw[..], b[0].sse_line[..], 0);
    if rd.kind == GW_IDLE { break; }
    active_io[0] = true;
    if rd.kind == GW_END {
      return fww_finish_stream(r, cfg, auth, h, b, st, out);
    }
    if rd.kind != GW_LINE { continue; }
    // Collect non-2xx error body (including multi-line Vertex JSON arrays) for clean reporting
    if r[0].gw[0].status >= 400 {
      if rd.text.count > 0 {
        r[0].acc[0].nerr_body = fww_cat(r[0].acc[0].err_body[..], r[0].acc[0].nerr_body, rd.text);
        r[0].acc[0].nerr_body = fww_cat(r[0].acc[0].err_body[..], r[0].acc[0].nerr_body, "\n");
      }
      continue;
    }
    // Feed line through SSE parser (or direct data: prefix)
    data := "";
    if flawed_aw_starts(rd.text, "data: ") {
      data = cast(string) rd.text[6..<rd.text.count];
    } else if flawed_aw_starts(rd.text, "data:") {
      data = cast(string) rd.text[5..<rd.text.count];
    } else {
      continue;
    }
    data = fww_trim(data);
    if data.count == 0 { continue; }

    ev: [1] FlawedWireSseEvent;
    if is_gem {
      sig_n := [1] int.[0];
      for pi: 0..<FWW_MAX_BLOCKS {
        nparts := flawed_wire_parse_gemini_sse(data, pi, ev[..], b[0].ev_txt[..], b[0].sig_buf[..], sig_n[..]);
        if nparts < 0 { break; }
        if ev[0].stop_reason != FLAWED_STOP_NONE { r[0].acc[0].stop_reason = ev[0].stop_reason; }
        if ev[0].input_tokens > 0 { r[0].acc[0].in_tok = ev[0].input_tokens; }
        if ev[0].output_tokens > 0 { r[0].acc[0].out_tok = ev[0].output_tokens; }
        if ev[0].cache_read_tokens > 0 { r[0].acc[0].cache_read = ev[0].cache_read_tokens; }
        k := ev[0].kind;
        if k == FLAWED_SSE_THINK_DELTA {
          if ev[0].text_n > 0 {
            now_rx := proc_now_ms();
            if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
            r[0].stream_last_rx_ms = now_rx;
            piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
            r[0].acc[0].nthink = fww_cat(r[0].acc[0].think[..], r[0].acc[0].nthink, piece);
            if !cfg[0].thinking_hidden { fww_send(out, mww_thought(out, piece)); }
          }
          if sig_n[0] > 0 { r[0].acc[0].nsig = fww_keep(r[0].acc[0].sig[..], cast(string) b[0].sig_buf[0..<sig_n[0]]); }
        } else if k == FLAWED_SSE_TEXT_DELTA {
          if ev[0].text_n > 0 {
            now_rx := proc_now_ms();
            if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
            r[0].stream_last_rx_ms = now_rx;
            piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
            r[0].acc[0].ntext = fww_cat(r[0].acc[0].text[..], r[0].acc[0].ntext, piece);
            fww_send(out, mww_reply(out, piece));
          }
          if sig_n[0] > 0 { r[0].acc[0].nsig = fww_keep(r[0].acc[0].sig[..], cast(string) b[0].sig_buf[0..<sig_n[0]]); }
        } else if k == FLAWED_SSE_SIG_DELTA {
          if sig_n[0] > 0 { r[0].acc[0].nsig = fww_keep(r[0].acc[0].sig[..], cast(string) b[0].sig_buf[0..<sig_n[0]]); }
        } else if k == FLAWED_SSE_OAI_TOOL_DELTA {
          if r[0].acc[0].ntools < FWW_MAX_TOOLS_CALL {
            now_rx := proc_now_ms();
            if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
            r[0].stream_last_rx_ms = now_rx;
            ti := r[0].acc[0].ntools;
            r[0].acc[0].tools[ti] = FwPendingTool.{};
            if ev[0].id_n > 0 {
              r[0].acc[0].tools[ti].nid = fww_keep(r[0].acc[0].tools[ti].id[..], cast(string) ev[0].id_buf[0..<ev[0].id_n]);
            } else {
              idn := fww_cat(r[0].acc[0].tools[ti].id[..], 0, "call_");
              idn = fww_put_int(r[0].acc[0].tools[ti].id[..], idn, r[0].step_num);
              idn = fww_cat(r[0].acc[0].tools[ti].id[..], idn, "_");
              r[0].acc[0].tools[ti].nid = fww_put_int(r[0].acc[0].tools[ti].id[..], idn, ti);
            }
            if ev[0].name_n > 0 { r[0].acc[0].tools[ti].nname = fww_keep(r[0].acc[0].tools[ti].name[..], cast(string) ev[0].name_buf[0..<ev[0].name_n]); }
            if ev[0].text_n > 0 { r[0].acc[0].tools[ti].nargs = fww_keep(r[0].acc[0].tools[ti].args[..], cast(string) b[0].ev_txt[0..<ev[0].text_n]); }
            if sig_n[0] > 0 {
              at := r[0].acc[0].ntool_sig_slab;
              if at + sig_n[0] <= r[0].acc[0].tool_sig_slab.count {
                for si: 0..<sig_n[0] { r[0].acc[0].tool_sig_slab[at + si] = b[0].sig_buf[si]; }
                r[0].acc[0].tools[ti].sig_at = at;
                r[0].acc[0].tools[ti].nsig = sig_n[0];
                r[0].acc[0].ntool_sig_slab = at + sig_n[0];
              }
            }
            r[0].acc[0].ntools += 1;
          }
        } else if k == FLAWED_SSE_ERROR {
          r[0].acc[0].saw_error = true;
          r[0].acc[0].nerr = fww_keep(r[0].acc[0].err_msg[..], cast(string) b[0].ev_txt[0..<ev[0].text_n]);
        }
        if pi + 1 >= nparts { break; }
      }
      continue;
    }

    if !flawed_wire_parse_openai_sse(data, ev[..], b[0].ev_txt[..]) { continue; }
    if ev[0].stop_reason != FLAWED_STOP_NONE { r[0].acc[0].stop_reason = ev[0].stop_reason; }
    if ev[0].input_tokens > 0 { r[0].acc[0].in_tok = ev[0].input_tokens; }
    if ev[0].output_tokens > 0 { r[0].acc[0].out_tok = ev[0].output_tokens; }
    if ev[0].cache_read_tokens > 0 { r[0].acc[0].cache_read = ev[0].cache_read_tokens; }
    k := ev[0].kind;
    if k == FLAWED_SSE_THINK_DELTA {
      if ev[0].text_n > 0 {
        now_rx := proc_now_ms();
        if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
        r[0].stream_last_rx_ms = now_rx;
        piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
        r[0].acc[0].nthink = fww_cat(r[0].acc[0].think[..], r[0].acc[0].nthink, piece);
        if !cfg[0].thinking_hidden {
          fww_send(out, mww_thought(out, piece));
        }
      }
    } else if k == FLAWED_SSE_TEXT_DELTA {
      if ev[0].text_n > 0 {
        now_rx := proc_now_ms();
        if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
        r[0].stream_last_rx_ms = now_rx;
        piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
        r[0].acc[0].ntext = fww_cat(r[0].acc[0].text[..], r[0].acc[0].ntext, piece);
        fww_send(out, mww_reply(out, piece));
      }
    } else if k == FLAWED_SSE_OAI_TOOL_DELTA {
      ti := ev[0].block_index;
      if ti >= 0 && ti < FWW_MAX_TOOLS_CALL {
        now_rx := proc_now_ms();
        if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
        r[0].stream_last_rx_ms = now_rx;
        if ti >= r[0].acc[0].ntools {
          for fill: r[0].acc[0].ntools..<ti + 1 { r[0].acc[0].tools[fill] = FwPendingTool.{}; }
          r[0].acc[0].ntools = ti + 1;
        }
        if ev[0].id_n > 0 { r[0].acc[0].tools[ti].nid = fww_keep(r[0].acc[0].tools[ti].id[..], cast(string) ev[0].id_buf[0..<ev[0].id_n]); }
        if ev[0].name_n > 0 { r[0].acc[0].tools[ti].nname = fww_cat(r[0].acc[0].tools[ti].name[..], r[0].acc[0].tools[ti].nname, cast(string) ev[0].name_buf[0..<ev[0].name_n]); }
        if ev[0].text_n > 0 { r[0].acc[0].tools[ti].nargs = fww_cat(r[0].acc[0].tools[ti].args[..], r[0].acc[0].tools[ti].nargs, cast(string) b[0].ev_txt[0..<ev[0].text_n]); }
      }
    } else if k == FLAWED_SSE_ERROR {
      r[0].acc[0].saw_error = true;
      r[0].acc[0].nerr = fww_keep(r[0].acc[0].err_msg[..], cast(string) b[0].ev_txt[0..<ev[0].text_n]);
    } else if k == FLAWED_SSE_MSG_STOP {
      return fww_finish_stream(r, cfg, auth, h, b, st, out);
    }
  }
  // Cloud pure-thinking runaway spiral guard: break out of pathological zero-tool thinking loops
  // while preserving the tail of the model's analysis (folded cleanly into the active user/tool_results turn)
  // and stepping down calm_steps so it emits concrete edits now!
  if fww_think_spiral(r[0].streaming, auth[0].backend == FLAWED_BE_LOCAL, r[0].recoveries, r[0].acc[0].ntext, r[0].acc[0].ntools, r[0].acc[0].nthink, r[0].first_tok_ms, r[0].turn_start_ms, cfg[0].budget_s, proc_now_ms()) {
    gw_close(r[0].gw[..]);
    r[0].streaming = false;
    r[0].recoveries += 1;
    r[0].calm_steps = 2;
    if r[0].recoveries >= 2 { r[0].force_low_once = true; }
    fww_emit_attempt(r, auth, "retried", 499, 0, out);
    if h[0].nmsgs > 0 {
      rb: [4096] u8;
      rn := 0;
      tlen := r[0].acc[0].nthink;
      tfrom := ifx tlen > 2800 then tlen - 2800 else 0;
      rn = fww_cat(rb[..], rn, "<system-reminder>Your internal thinking ran very long without emitting any tool calls. End of your analysis:\n\n");
      rn = fww_cat(rb[..], rn, cast(string) r[0].acc[0].think[tfrom..<tlen]);
      rn = fww_cat(rb[..], rn, "\n\nStop re-deriving from scratch. Immediately emit your concrete Edit/Write/Bash tool calls now and iterate from real test output.</system-reminder>");
      snudge := cast(string) rb[0..<rn];
      li := h[0].nmsgs - 1;
      if h[0].msgs[li].role == FWW_MROLE_TOOL_RESULTS && h[0].msgs[li].nblocks < FWW_MAX_BLOCKS {
        a0 := [1] int.[0];
        nb_sp := FwBlock.{kind = FWW_MB_TEXT};
        nb_sp.text_n = fww_slab_put(h, snudge, a0[..]); nb_sp.text_at = a0[0];
        h[0].msgs[li].blocks[h[0].msgs[li].nblocks] = nb_sp;
        h[0].msgs[li].nblocks += 1;
      } else if h[0].msgs[li].role == FWW_MROLE_USER && h[0].msgs[li].nblocks > 0 {
        prev := fww_slab_str(h, h[0].msgs[li].blocks[0].text_at, h[0].msgs[li].blocks[0].text_n);
        cn := fww_cat(b[0].compact_buf[..], 0, prev);
        cn = fww_cat(b[0].compact_buf[..], cn, "\n\n");
        cn = fww_cat(b[0].compact_buf[..], cn, snudge);
        a0 := [1] int.[0];
        h[0].msgs[li].blocks[0].text_n = fww_slab_put(h, cast(string) b[0].compact_buf[0..<cn], a0[..]);
        h[0].msgs[li].blocks[0].text_at = a0[0];
      }
    }
    err := fww_start_request(r, cfg, auth, h, b, out);
    if err.count > 0 {
      r[0].active = false;
      fww_send(out, mww_ended(out, "failed", err));
      return "failed";
    }
    active_io[0] = true;
    return "";
  }
  // Cloud SSE dead-stream watchdog: recover cleanly only if a stream goes completely silent for >=150s
  // with zero parsed content/thought/tool deltas (never aborts active reasoning or multi-edit batches).
  if fww_stream_stalled(r[0].streaming, auth[0].backend == FLAWED_BE_LOCAL, r[0].stall_recoveries, r[0].stream_last_rx_ms, proc_now_ms()) {
    gw_close(r[0].gw[..]);
    r[0].streaming = false;
    r[0].stall_recoveries += 1;
    fww_emit_attempt(r, auth, "retried", 504, 0, out);
    if h[0].nmsgs > 0 {
      li := h[0].nmsgs - 1;
      snudge := "<system-reminder>Your previous response stalled silently for over 150s without emitting a tool call or reply. Avoid rewriting large unmodified blocks in a single Edit — keep reasoning brief and immediately emit smaller, surgical parallel Edit calls (or your concise final answer).</system-reminder>";
      if h[0].msgs[li].role == FWW_MROLE_TOOL_RESULTS && h[0].msgs[li].nblocks < FWW_MAX_BLOCKS {
        a0 := [1] int.[0];
        nb_st := FwBlock.{kind = FWW_MB_TEXT};
        nb_st.text_n = fww_slab_put(h, snudge, a0[..]); nb_st.text_at = a0[0];
        h[0].msgs[li].blocks[h[0].msgs[li].nblocks] = nb_st;
        h[0].msgs[li].nblocks += 1;
      } else if h[0].msgs[li].role == FWW_MROLE_USER && h[0].msgs[li].nblocks > 0 {
        prev := fww_slab_str(h, h[0].msgs[li].blocks[0].text_at, h[0].msgs[li].blocks[0].text_n);
        cn := fww_cat(b[0].compact_buf[..], 0, prev);
        cn = fww_cat(b[0].compact_buf[..], cn, "\n\n");
        cn = fww_cat(b[0].compact_buf[..], cn, snudge);
        a0 := [1] int.[0];
        h[0].msgs[li].blocks[0].text_n = fww_slab_put(h, cast(string) b[0].compact_buf[0..<cn], a0[..]);
        h[0].msgs[li].blocks[0].text_at = a0[0];
      }
    }
    err := fww_start_request(r, cfg, auth, h, b, out);
    if err.count > 0 {
      r[0].active = false;
      fww_send(out, mww_ended(out, "failed", err));
      return "failed";
    }
    active_io[0] = true;
  }
  return "";
}

fww_stop_active :: (r: [] FwRun, out: [] u8) {
  if r[0].streaming { gw_close(r[0].gw[..]); r[0].streaming = false; }
  if r[0].cmd[0].active {
    _ = proc_kill(r[0].cmd[0].h, PROC_SIGTERM);
    if proc_wait(r[0].cmd[0].h, 400) < 0 { _ = proc_kill(r[0].cmd[0].h, PROC_SIGKILL); _ = proc_wait(r[0].cmd[0].h, 400); }
    _ = proc_release(r[0].cmd[0].h);
    r[0].cmd[0].h = -1;
    r[0].cmd[0].active = false;
  }
  // Stop foreground standalone subagents; background subagents have unlinked abort (#14096)
  for si: 0..<FWW_MAX_DELEGATE_BATCH {
    if r[0].local_subs[si].active && !r[0].local_subs[si].is_bg {
      if r[0].local_subs[si].h >= 0 {
        _ = proc_kill(r[0].local_subs[si].h, PROC_SIGTERM);
        _ = proc_wait(r[0].local_subs[si].h, 400);
        _ = proc_release(r[0].local_subs[si].h);
        r[0].local_subs[si].h = -1;
      }
      r[0].local_subs[si].active = false;
      r[0].local_subs[si].done = true;
    }
  }
  r[0].waiting_permit = false;
  r[0].waiting_delegate = false;
  r[0].waiting_local_delegate = false;
  r[0].retry_at_ms = 0;
  r[0].active = false;
  fww_send(out, mww_ended(out, "stopped", ""));
}

// Handle inline slash commands (/compact, /clear, /cost, /status). Returns true if handled locally.
// Unwrap Desktop's "Skills installed on this computer...\n\nThe message:\n" prefix so slash commands
// (/compact, /clear, /cost, /status) work identically whether or not skills are mounted.
fww_unwrap_slash_cmd :: (tk: string) -> string {
  marker := "\n\nThe message:\n";
  if flawed_aw_starts(tk, "Skills installed on this computer.") && tk.count > marker.count {
    lim := tk.count - marker.count;
    for p: 0..<lim {
      ok := true;
      for j: 0..<marker.count { if tk[p + j] != marker[j] { ok = false; break; } }
      if ok { return fww_trim(cast(string) tk[p + marker.count..<tk.count]); }
    }
  }
  return fww_trim(tk);
}

fww_handle_slash :: (tk: string, r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, out: [] u8) -> bool {
  cmd := fww_unwrap_slash_cmd(tk);
  if cmd == "/clear" {
    fww_hist_clear(h);
    fww_hist_clear_traces(h);
    for di: 0..<r[0].read_dedup.count { r[0].read_dedup[di] = FwReadDedup.{}; }
    r[0].ngit_snap = 0; r[0].ngit_snap_cwd = 0;
    fww_send(out, mww_ended(out, "finished", "Cleared Flawed conversation history."));
    return true;
  }
  if cmd == "/compact all" {
    if fww_hist_compact_ex(h, -1, 0, 0, 0, 10240, b[0].compact_buf[..]) {
      fww_send(out, mww_ended(out, "finished", "Compacted full conversation history."));
    } else {
      fww_send(out, mww_ended(out, "finished", "Conversation is already empty."));
    }
    return true;
  }
  if cmd == "/compact" {
    if fww_hist_compact(h, b[0].compact_buf[..]) {
      fww_send(out, mww_ended(out, "finished", "Compacted conversation history."));
    } else {
      fww_send(out, mww_ended(out, "finished", "Conversation is already compact (fewer than 5 messages)."));
    }
    return true;
  }
  if cmd == "/cost" {
    rb: [512] u8;
    n := fww_cat(rb[..], 0, "**Flawed Session Usage**\n- Input tokens: ");
    n = fww_put_int(rb[..], n, h[0].total_in);
    n = fww_cat(rb[..], n, "\n- Cached input tokens: ");
    n = fww_put_int(rb[..], n, h[0].total_cached);
    n = fww_cat(rb[..], n, "\n- Output tokens: ");
    n = fww_put_int(rb[..], n, h[0].total_out);
    n = fww_cat(rb[..], n, "\n- Estimated cost: $");
    cents := (h[0].total_cost_micros + 5000) / 10000;
    n = fww_put_int(rb[..], n, cents / 100);
    n = fww_cat(rb[..], n, ".");
    if cents % 100 < 10 { n = fww_cat(rb[..], n, "0"); }
    n = fww_put_int(rb[..], n, cents % 100);
    fww_send(out, mww_ended(out, "finished", cast(string) rb[0..<n]));
    return true;
  }
  if cmd == "/status" {
    rb: [1024] u8;
    n := fww_cat(rb[..], 0, "**Flawed Runtime Status**\n- Model: `");
    n = fww_cat(rb[..], n, cast(string) r[0].model[0..<r[0].nmodel]);
    n = fww_cat(rb[..], n, "`\n- Effort: `");
    n = fww_cat(rb[..], n, cast(string) r[0].effort[0..<r[0].neffort]);
    n = fww_cat(rb[..], n, "`\n- Auth: ");
    n = fww_cat(rb[..], n, cast(string) auth[0].label[0..<auth[0].nlabel]);
    n = fww_cat(rb[..], n, "\n- Messages in context: ");
    n = fww_put_int(rb[..], n, h[0].nmsgs);
    n = fww_cat(rb[..], n, "\n- Auto-compactions this session: ");
    n = fww_put_int(rb[..], n, h[0].compact_count);
    fww_send(out, mww_ended(out, "finished", cast(string) rb[0..<n]));
    return true;
  }
  return false;
}

// ---------------------------------------------------------------- follow-up / queue / steer helpers

fww_src_name :: (src: int) -> string {
  if src == FWW_SRC_QUEUE { return "queue"; }
  if src == FWW_SRC_RESUBMIT { return "resubmit"; }
  return "message";
}

fww_queue_changed :: (q: [] MwQueue, f: [] FwFollow, o: [] u8) {
  _ = mwq_save(q, f[0].qbuf[..]);
  fww_send(o, mwq_line(q, o));
}

fww_task_with :: (f: [] FwFollow, text: string, out: [] u8) -> string {
  if f[0].nlast == 0 { return ""; }
  ab: [MWQ_MESSAGE] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  t: [1] McTask;
  last := cast(string) f[0].last[0..<f[0].nlast];
  if !mww_task_read(ar[..], last, t[..]) {
    t[0] = McTask.{cwd = cl_str(ar[..], last, "cwd"), session = cl_str(ar[..], last, "session"), sandbox = "danger-full-access"};
  }
  t[0].task = text;
  n := mww_task(out, t[0]);
  return ifx n < 2 then "" else cast(string) out[0..<n - 1];
}

fww_turn_begin :: (f: [] FwFollow, msg: string, o: [] u8) {
  f[0].turn += 1;
  fww_send(o, mww_turn(o, f[0].turn, fww_src_name(f[0].src), cast(string) f[0].src_id[0..<f[0].nsrc_id], cast(string) f[0].src_text[0..<f[0].nsrc_text]));
  f[0].nlast = ifx msg.count <= f[0].last.count then fww_keep(f[0].last[..], msg) else 0;
  st := cl_bool(msg, "steerable");
  f[0].steerable = !st.ok || st.value;
  f[0].starting = true;
  f[0].src = FWW_SRC_MESSAGE; f[0].nsrc_id = 0; f[0].nsrc_text = 0;
}

fww_drained :: (st: [] McSteers, f: [] FwFollow, o: [] u8) {
  for i: 0..<st[0].nd {
    fww_send(o, mww_steered(o, mc_steer_done_id(st, i), "applied", f[0].turn, "", st[0].done[i].step, ""));
  }
  st[0].nd = 0;
}

fww_turn_end :: (ending: string, st: [] McSteers, q: [] MwQueue, f: [] FwFollow, o: [] u8) {
  f[0].starting = false;
  mwq_ended(q);
  if st[0].n > 0 && f[0].resubmit_due {
    jb: [MWQ_MESSAGE] u8; text := mc_steer_join(st, jb[..]);
    m := fww_task_with(f, text, f[0].resubmit[..]);
    f[0].nresubmit = m.count;
    if m.count > 0 {
      f[0].nsrc_id = fww_keep(f[0].src_id[..], mc_steer_id(st, 0));
      f[0].nsrc_text = fww_keep(f[0].src_text[..], text);
      for i: 0..<st[0].n { fww_send(o, mww_steered(o, mc_steer_id(st, i), "resubmitted", f[0].turn, "", 0, "")); }
      mc_steer_clear(st);
    }
  }
  i := st[0].n - 1;
  while i >= 0 {
    mb: [MWQ_MESSAGE] u8; m := fww_task_with(f, mc_steer_text(st, i), mb[..]);
    why := ifx m.count > 0 then mwq_add_first(q, mc_steer_id(st, i), mc_steer_text(st, i), m) else "invalid";
    fww_send(o, mww_steered(o, mc_steer_id(st, i), ifx why.count == 0 then "queued" else "rejected", f[0].turn, why, 0, ""));
    i -= 1;
  }
  mc_steer_clear(st);
  f[0].resubmit_due = false;
  if ending == "stopped" && f[0].nresubmit == 0 && !f[0].force_head { mwq_pause(q, "interrupted"); }
  else if ending == "failed" || ending == "no_capacity" { mwq_pause(q, "error"); }
  fww_queue_changed(q, f, o);
}

fww_dispatch :: (q: [] MwQueue, f: [] FwFollow, line: [] u8, o: [] u8) -> int {
  if f[0].nresubmit > 0 {
    n := fww_keep(line, cast(string) f[0].resubmit[0..<f[0].nresubmit]);
    f[0].nresubmit = 0; f[0].src = FWW_SRC_RESUBMIT;
    return n;
  }
  if q[0].n == 0 || (q[0].paused && !f[0].force_head) { return 0; }
  n := fww_keep(line, mwq_message(q, 0));
  f[0].src = FWW_SRC_QUEUE;
  f[0].nsrc_id = fww_keep(f[0].src_id[..], mwq_id(q, 0));
  f[0].nsrc_text = fww_keep(f[0].src_text[..], mwq_text(q, 0));
  f[0].force_head = false;
  _ = mwq_start_head(q);
  fww_queue_changed(q, f, o);
  return n;
}

fww_steer :: (running: bool, req: [] MwwRequest, st: [] McSteers, f: [] FwFollow, o: [] u8) {
  why := "";
  if !running || f[0].starting { why = "no_active_turn"; }
  else if req[0].turn.ok && req[0].turn.value != f[0].turn { why = "expected_turn_mismatch"; }
  else if !f[0].steerable && !req[0].parent { why = "active_turn_not_steerable"; }
  else { why = mc_steer_add(st, req[0].id, req[0].text); }
  fww_send(o, mww_steered(o, req[0].id, ifx why.count == 0 then "accepted" else "rejected", f[0].turn, why, 0, ifx why.count == 0 then req[0].text else ""));
}

fww_queue_op :: (running: bool, req: [] MwwRequest, q: [] MwQueue, f: [] FwFollow, home: string, o: [] u8) -> bool {
  op := req[0].op; id := req[0].id; why := "";
  stop := false;
  if op == "open" {
    pb: [4096] u8; path := mwq_path(home, req[0].key, pb[..]);
    if path.count == 0 { why = "invalid"; }
    else if cast(string) q[0].path[0..<q[0].npath] != path {
      _ = mwq_save(q, f[0].qbuf[..]);
      if q[0].npath == 0 && q[0].n > 0 { q[0].npath = fww_keep(q[0].path[..], path); }
      else { _ = mwq_load(q, path, f[0].qbuf[..], f[0].qarena[..]); }
    }
  }
  else if op == "add" {
    msg_use := req[0].message;
    tmp_mb: [MWQ_MESSAGE] u8;
    if msg_use.count == 0 && req[0].text.count > 0 && f[0].nlast > 0 {
      msg_use = fww_task_with(f, req[0].text, tmp_mb[..]);
    }
    why = mwq_add(q, id, req[0].text, msg_use);
  }
  else if op == "update" { why = mwq_update(q, id, req[0].text, req[0].message); }
  else if op == "delete" { why = mwq_delete(q, id); }
  else if op == "move" { why = mwq_move(q, id, ifx req[0].to.ok then req[0].to.value else 0); }
  else if op == "promote" {
    why = mwq_move(q, id, 0);
    if why.count == 0 && req[0].now { f[0].force_head = true; stop = running; }
  }
  else if op == "pause" { mwq_pause(q, "user"); }
  else if op == "resume" { mwq_resume(q); }
  else if op == "clear" { mwq_clear(q); }
  else if op != "list" { why = "invalid"; }
  if why.count > 0 { fww_send(o, mww_queue_refused(o, op, id, why)); return false; }
  fww_queue_changed(q, f, o);
  return stop;
}

fww_flag_asked :: (flag: string) -> bool {
  a: [1] Args;
  if !args_load(a[..]) { return false; }
  for i: 0..<args_count(a[..]) { if args_at(a[..], i) == flag { return true; } }
  return false;
}

fww_auth_asked :: () -> bool {
  return fww_flag_asked("--auth");
}

#load "oa-subagent.coax";
#load "oa-serve.coax";

// ---------------------------------------------------------------- main event loop

tool_main :: () -> int #export_c #effects(all) {
  if fww_flag_asked("--selftest-coax-intel") {
    cwd_b: [FS_PATH_MAX] u8;
    cwd := fs_cwd(cwd_b[..]);
    if !fww_is_coax_repo(cwd) {
      print("FAIL: not a Coax repo: %\n", cwd);
      return 1;
    }
    res_b: [32768] u8;
    empty_wire: [1] u8;
    is_err := [1] bool.[false];

    n1 := fww_tool_coax_intel(cwd, "CoaxDefines", "{\"name\":\"rp_put\"}", res_b[..], is_err[..], empty_wire[0..<0]);
    if is_err[0] || !fww_contains_ci(cast(string) res_b[0..<n1], "coax/lib/repo/lines.coax") {
      print("FAIL: CoaxDefines rp_put: %\n", cast(string) res_b[0..<n1]);
      return 1;
    }
    print("OK CoaxDefines rp_put (% bytes)\n", n1);

    n2 := fww_tool_coax_intel(cwd, "CoaxUses", "{\"name\":\"rp_put\",\"file\":\"coax/lib/repo/lines.coax\"}", res_b[..], is_err[..], empty_wire[0..<0]);
    if is_err[0] || !fww_contains_ci(cast(string) res_b[0..<n2], "coax/lib/repo/lines.coax") {
      print("FAIL: CoaxUses rp_put: %\n", cast(string) res_b[0..<n2]);
      return 1;
    }
    print("OK CoaxUses rp_put (% bytes)\n", n2);

    n3 := fww_tool_coax_intel(cwd, "CoaxCheck", "{\"file\":\"coax/lib/repo/lines.coax\"}", res_b[..], is_err[..], empty_wire[0..<0]);
    if is_err[0] || n3 <= 0 {
      print("FAIL: CoaxCheck lines.coax: %\n", cast(string) res_b[0..<n3]);
      return 1;
    }
    print("OK CoaxCheck coax/lib/repo/lines.coax (% bytes)\n", n3);
    return 0;
  }

  if fww_flag_asked("--selftest-knowledge") {
    cwd_b: [FS_PATH_MAX] u8;
    cwd := fs_cwd(cwd_b[..]);
    kb_idx: [1] KbIndex;
    res_b: [49152] u8;
    is_err := [1] bool.[false];
    n1 := fww_tool_knowledge(cwd, "KnowledgeSearch", "{\"query\":\"what did we decide in episode 289?\",\"limit\":3}", kb_idx[..], res_b[..], is_err[..]);
    s1 := cast(string) res_b[0..<n1];
    if is_err[0] || n1 <= 0 || !fww_contains_ci(s1, "docs/transcripts/289.md") {
      print("FAIL: KnowledgeSearch episode 289: %\n", s1);
      return 1;
    }
    print("OK KnowledgeSearch episode 289 (% bytes)\n", n1);
    n2 := fww_tool_knowledge(cwd, "KnowledgeSearch", "{\"query\":\"how does Coax #authority work?\",\"limit\":3}", kb_idx[..], res_b[..], is_err[..]);
    s2 := cast(string) res_b[0..<n2];
    if is_err[0] || n2 <= 0 || !fww_contains_ci(s2, "coax/book/") {
      print("FAIL: KnowledgeSearch #authority: %\n", s2);
      return 1;
    }
    print("OK KnowledgeSearch #authority (% bytes)\n", n2);
    n3 := fww_tool_knowledge(cwd, "KnowledgeGet", "{\"target\":\"docs.transcripts.289\",\"start_line\":1,\"max_lines\":15}", kb_idx[..], res_b[..], is_err[..]);
    s3 := cast(string) res_b[0..<n3];
    if is_err[0] || n3 <= 0 || !fww_contains_ci(s3, "Episode 289") {
      print("FAIL: KnowledgeGet docs.transcripts.289: %\n", s3);
      return 1;
    }
    print("OK KnowledgeGet docs.transcripts.289 (% bytes)\n", n3);
    return 0;
  }

  if fww_flag_asked("--selftest-capability") {
    tmp_b: [FS_PATH_MAX] u8;
    tmp := fs_temp("oa-cap-e2e-", tmp_b[..]);
    if tmp.count == 0 { print("FAIL: fs_temp failed\n"); return 1; }
    defer { _ = fs_remove(tmp); }
    cwd_b: [FS_PATH_MAX] u8;
    cwd := fs_cwd(cwd_b[..]);

    // 1. Missing capability detection on "turn my meeting notes into Linear tickets"
    kw_b: [64] u8; kw_n := [1] int.[0];
    hint := fww_detect_missing_capability("turn my meeting notes into Linear tickets", kw_b[..], kw_n[..]);
    if hint != "web_automation" || cast(string) kw_b[0..<kw_n[0]] != "linear" {
      print("FAIL: missing capability detection got hint=% kw=%\n", hint, cast(string) kw_b[0..<kw_n[0]]);
      return 1;
    }
    sku_b: [FS_PATH_MAX] u8; sku := fs_join(tmp, ".claude/skills", sku_b[..]);
    if ce_skills_dir_covers(sku, "linear") {
      print("FAIL: linear should not be covered before promotion\n");
      return 1;
    }
    // Verify interview protocol prompt is emitted for missing capability
    ip_b: [4096] u8;
    ip_n := fww_append_cap_author_prompt(ip_b[..], 0, hint, true);
    if !fww_contains_ci(cast(string) ip_b[0..<ip_n], "CapabilityDraft") || !fww_contains_ci(cast(string) ip_b[0..<ip_n], "CapabilityEval") {
      print("FAIL: interview prompt missing CapabilityDraft/CapabilityEval\n");
      return 1;
    }
    print("OK 1/5 missing capability detected (hint=% kw=%)\n", hint, cast(string) kw_b[0..<kw_n[0]]);

    // 2. Draft candidate SKILL.md via CapabilityDraft tool (using tmp as home -> isolated skills & staging)
    res_b: [16384] u8;
    is_err := [1] bool.[false];
    n_dr := fww_tool_capability(cwd, tmp, "CapabilityDraft",
      "{\"slug\":\"linear-meeting-tickets\",\"goal\":\"Turn meeting notes into structured Linear tickets\",\"inputs\":\"raw meeting notes markdown\",\"outputs\":\"Linear issue JSON payloads\",\"nongoals\":\"never delete existing issues\"}",
      res_b[..], is_err[..]);
    if is_err[0] || !fww_contains_ci(cast(string) res_b[0..<n_dr], "linear-meeting-tickets/SKILL.md") {
      print("FAIL: CapabilityDraft: %\n", cast(string) res_b[0..<n_dr]);
      return 1;
    }
    print("OK 2/5 CapabilityDraft wrote staged SKILL.md\n");

    // 3. Real two-arm ATIF-v1.8 comparison & #authority promotion via CapabilityEval
    n_ev := fww_tool_capability(cwd, tmp, "CapabilityEval",
      "{\"slug\":\"linear-meeting-tickets\",\"pos_base\":\"exit 1\",\"pos_cand\":\"printf '{\\\"title\\\":\\\"Ship Phase 4B\\\"}' | grep -q title\",\"neg_base\":\"exit 0\",\"neg_cand\":\"exit 0\"}",
      res_b[..], is_err[..]);
    ev_s := cast(string) res_b[0..<n_ev];
    if is_err[0] || !fww_contains_ci(ev_s, "**PROMOTED**") || !fww_contains_ci(ev_s, "ATIF-v1.8 Digest") || !fww_contains_ci(ev_s, "\"atif_verified\":true") {
      print("FAIL: CapabilityEval promotion: %\n", ev_s);
      return 1;
    }
    print("OK 3/5 CapabilityEval two-arm ATIF-v1.8 verified & PROMOTED\n");

    // 4. Immediate next-turn activation: skill is now in prompt, CapabilityList, and covers "linear"
    if !ce_skills_dir_covers(sku, "linear") {
      print("FAIL: promoted skill does not cover linear on next turn\n");
      return 1;
    }
    c_cfg: [1] FwConfig;
    fww_load_config(c_cfg[..]);
    sys_b: [65536] u8;
    sys_n := fww_build_system_prompt(c_cfg[..], tmp, tmp, sys_b[..]);
    if !fww_contains_ci(cast(string) sys_b[0..<sys_n], "Active Local Skills") || !fww_contains_ci(cast(string) sys_b[0..<sys_n], "linear-meeting-tickets") {
      print("FAIL: next-turn system prompt did not immediately activate linear-meeting-tickets\n");
      return 1;
    }
    n_ls := fww_tool_capability(cwd, tmp, "CapabilityList", "{}", res_b[..], is_err[..]);
    if is_err[0] || !fww_contains_ci(cast(string) res_b[0..<n_ls], "linear-meeting-tickets") || !fww_contains_ci(cast(string) res_b[0..<n_ls], "\"atif_verified\":true") {
      print("FAIL: CapabilityList: %\n", cast(string) res_b[0..<n_ls]);
      return 1;
    }
    print("OK 4/5 Next turn immediately sees linear-meeting-tickets in system prompt & CapabilityList\n");

    // 5. Failing/regressed candidate is REJECTED by #authority gate with preserved ATIF digest
    _ = fww_tool_capability(cwd, tmp, "CapabilityDraft",
      "{\"slug\":\"linear-broken\",\"goal\":\"Broken candidate\"}", res_b[..], is_err[..]);
    n_rej := fww_tool_capability(cwd, tmp, "CapabilityEval",
      "{\"slug\":\"linear-broken\",\"pos_base\":\"exit 0\",\"pos_cand\":\"exit 0\",\"neg_base\":\"exit 0\",\"neg_cand\":\"exit 1\"}",
      res_b[..], is_err[..]);
    rej_s := cast(string) res_b[0..<n_rej];
    if is_err[0] || !fww_contains_ci(rej_s, "**REJECTED**") || !fww_contains_ci(rej_s, "\"promoted\":false") || !fww_contains_ci(rej_s, "\"atif_verified\":true") {
      print("FAIL: CapabilityEval rejection: %\n", rej_s);
      return 1;
    }
    bad_p_b: [FS_PATH_MAX] u8;
    if fs_exists(fs_join(sku, "linear-broken", bad_p_b[..])) {
      print("FAIL: rejected skill was erroneously installed\n");
      return 1;
    }
    exp_p_b: [FS_PATH_MAX] u8;
    if !fs_exists(fs_join(tmp, ".openagents/capabilities/experiments/linear-broken-rejected.atif.jsonl", exp_p_b[..])) {
      print("FAIL: rejected ATIF log missing\n");
      return 1;
    }
    print("OK 5/5 Regressed candidate REJECTED with preserved ATIF-v1.8 digest\n");
    return 0;
  }

  if fww_flag_asked("--selftest-worktree") {
    tmp_b: [FS_PATH_MAX] u8;
    tmp := fs_temp("oa-wt-e2e-", tmp_b[..]);
    if tmp.count == 0 { print("FAIL: fs_temp failed\n"); return 1; }
    defer { _ = fs_remove(tmp); }

    repo_b: [FS_PATH_MAX] u8; repo := fs_join(tmp, "repo", repo_b[..]);
    home_b: [FS_PATH_MAX] u8; home_d := fs_join(tmp, "home", home_b[..]);
    sub_b: [FS_PATH_MAX] u8; sub := fs_join(repo, "sub/dir", sub_b[..]);
    certs_b: [FS_PATH_MAX] u8; certs := fs_join(repo, "certs", certs_b[..]);
    out_sec_b: [FS_PATH_MAX] u8; out_sec := fs_join(tmp, "outside.secret", out_sec_b[..]);
    _ = fs_mkdir_all(sub);
    _ = fs_mkdir_all(home_d);
    _ = fs_mkdir_all(certs);
    if !fs_write(out_sec, "TOP_SECRET_OUTSIDE\n") { print("FAIL: write outside.secret\n"); return 1; }

    // Init temp git repo
    if !fww_git_exec(repo, "init", "-q", "", "", "") { print("FAIL: git init\n"); return 1; }
    _ = fww_git_exec(repo, "config", "user.email", "test@openagents.com", "", "");
    _ = fww_git_exec(repo, "config", "user.name", "OA Test", "", "");
    p1_b: [FS_PATH_MAX] u8;
    _ = fs_write(fs_join(sub, "nested.txt", p1_b[..]), "hello nested\n");
    _ = fs_write(fs_join(repo, ".gitignore", p1_b[..]), ".env.*\ncerts/\nignored.skip\n");
    _ = fs_write(fs_join(repo, ".worktreeinclude", p1_b[..]), "# local overrides\n.env.*\n!*.example\ncerts/\n../outside.secret\n/etc/passwd\n");
    if !fww_git_exec(repo, "add", ".", "", "", "") { print("FAIL: git add\n"); return 1; }
    if !fww_git_exec(repo, "commit", "-q", "-m", "init", "") { print("FAIL: git commit\n"); return 1; }

    // Create gitignored local files + an escaping symlink `.env.evil -> outside.secret`
    _ = fs_write(fs_join(repo, ".env.local", p1_b[..]), "API_KEY=local123\n");
    _ = fs_write(fs_join(repo, ".env.example", p1_b[..]), "API_KEY=example\n");
    _ = fs_write(fs_join(certs, "dev.pem", p1_b[..]), "CERT_DATA\n");
    _ = fs_write(fs_join(repo, "ignored.skip", p1_b[..]), "SKIP_ME\n");
    evil_b: [FS_PATH_MAX] u8; evil_p := fs_join(repo, ".env.evil", evil_b[..]);
    lh := proc_new();
    if lh >= 0 && proc_arg(lh, "/bin/ln") && proc_arg(lh, "-s") && proc_arg(lh, out_sec) && proc_arg(lh, evil_p) && proc_start(lh) == 0 {
      _ = proc_wait(lh, 2000);
    }
    if lh >= 0 { _ = proc_release(lh); }

    // 1. Canonical git-root resolution, subdir mapping, and .worktreeinclude safe copy
    wp1: [FS_PATH_MAX] u8; wb1: [96] u8; wh1: [64] u8;
    if !fww_wt_create(sub, home_d, "agent-inc1", wp1[..], wb1[..], wh1[..]) {
      print("FAIL 1: fww_wt_create from nested subdir failed\n"); return 1;
    }
    wp1n := 0; while wp1n < wp1.count && wp1[wp1n] != 0 { wp1n += 1; }
    wb1n := 0; while wb1n < wb1.count && wb1[wb1n] != 0 { wb1n += 1; }
    wh1n := 0; while wh1n < wh1.count && wh1[wh1n] != 0 { wh1n += 1; }
    wt1_eff := cast(string) wp1[0..<wp1n];
    wt1_br := cast(string) wb1[0..<wb1n];
    wt1_hd := cast(string) wh1[0..<wh1n];
    if !flawed_aw_ends(wt1_eff, "/sub/dir") || fs_kind(wt1_eff) != FS_DIR {
      print("FAIL 1: expected subdir-mapped wt path ending in /sub/dir, got %\n", wt1_eff); return 1;
    }
    wt1_root_b: [FS_PATH_MAX] u8; wt1_rel_b: [256] u8; wt1_rel_n := [1] int.[0];
    if !fww_wt_resolve_git_root(wt1_eff, wt1_root_b[..], wt1_rel_b[..], wt1_rel_n[..]) {
      print("FAIL 1: fww_wt_resolve_git_root failed on wt1_eff\n"); return 1;
    }
    wr1n := 0; while wr1n < wt1_root_b.count && wt1_root_b[wr1n] != 0 { wr1n += 1; }
    wt1_root := cast(string) wt1_root_b[0..<wr1n];
    if cast(string) wt1_rel_b[0..<wt1_rel_n[0]] != "sub/dir" {
      print("FAIL 1: expected rel sub/dir, got %\n", cast(string) wt1_rel_b[0..<wt1_rel_n[0]]); return 1;
    }
    chk_buf: [256] u8;
    env_rd := fs_read(fs_join(wt1_root, ".env.local", p1_b[..]), chk_buf[..]);
    if env_rd <= 0 || cast(string) chk_buf[0..<env_rd] != "API_KEY=local123\n" {
      print("FAIL 1: .env.local not copied into worktree\n"); return 1;
    }
    cert_rd := fs_read(fs_join(wt1_root, "certs/dev.pem", p1_b[..]), chk_buf[..]);
    if cert_rd <= 0 || cast(string) chk_buf[0..<cert_rd] != "CERT_DATA\n" {
      print("FAIL 1: certs/dev.pem not copied into worktree\n"); return 1;
    }
    if fs_kind(fs_join(wt1_root, ".env.example", p1_b[..])) != FS_NONE {
      print("FAIL 1: negated .env.example was copied\n"); return 1;
    }
    if fs_kind(fs_join(wt1_root, "ignored.skip", p1_b[..])) != FS_NONE {
      print("FAIL 1: unmatched ignored.skip was copied\n"); return 1;
    }
    if fs_kind(fs_join(wt1_root, ".env.evil", p1_b[..])) != FS_NONE {
      print("FAIL 1: escaping symlink .env.evil was copied\n"); return 1;
    }
    print("OK 1/4 canonical git-root subdir mapping + .worktreeinclude safe copy & symlink escape refusal\n");

    // 2. Fail-closed cleanup from nested subdir (dirty preserved, committed preserved, clean removed + branch deleted)
    _ = fs_write(fs_join(wt1_root, "dirty.txt", p1_b[..]), "dirty\n");
    if fww_wt_cleanup_fail_closed(sub, wt1_eff, wt1_br, wt1_hd) {
      print("FAIL 2: dirty worktree should not be removed\n"); return 1;
    }
    _ = fww_git_exec(wt1_root, "add", "dirty.txt", "", "", "");
    _ = fww_git_exec(wt1_root, "commit", "-q", "-m", "wt commit", "");
    if fww_wt_cleanup_fail_closed(sub, wt1_eff, wt1_br, wt1_hd) {
      print("FAIL 2: committed worktree should not be removed\n"); return 1;
    }
    wp2: [FS_PATH_MAX] u8; wb2: [96] u8; wh2: [64] u8;
    if !fww_wt_create(sub, home_d, "agent-clean1", wp2[..], wb2[..], wh2[..]) {
      print("FAIL 2: create agent-clean1 failed\n"); return 1;
    }
    wp2n := 0; while wp2n < wp2.count && wp2[wp2n] != 0 { wp2n += 1; }
    wb2n := 0; while wb2n < wb2.count && wb2[wb2n] != 0 { wb2n += 1; }
    wh2n := 0; while wh2n < wh2.count && wh2[wh2n] != 0 { wh2n += 1; }
    if !fww_wt_cleanup_fail_closed(sub, cast(string) wp2[0..<wp2n], cast(string) wb2[0..<wb2n], cast(string) wh2[0..<wh2n]) {
      print("FAIL 2: clean worktree from nested subdir should be removed\n"); return 1;
    }
    if fs_kind(cast(string) wp2[0..<wp2n]) != FS_NONE {
      print("FAIL 2: clean worktree dir still exists\n"); return 1;
    }
    ref_b: [128] u8; ref_ok := [1] bool.[false];
    ref_n := fww_cat(ref_b[..], 0, "refs/heads/"); ref_n = fww_cat(ref_b[..], ref_n, cast(string) wb2[0..<wb2n]);
    ver_argv := [3] string.["rev-parse", "--verify", cast(string) ref_b[0..<ref_n]];
    _ = fww_git_quick_argv(repo, ver_argv[..], 1500, chk_buf[..], ref_ok[..]);
    if ref_ok[0] { print("FAIL 2: ephemeral branch still exists after clean cleanup\n"); return 1; }
    print("OK 2/4 fail-closed subagent cleanup from nested subdir\n");

    // 3. EnterWorktree / ExitWorktree cache invalidation, fail-closed refusal, and branch deletion
    r_wt: [1] FwRun;
    r_wt[0].ncwd = fww_keep(r_wt[0].cwd[..], sub);
    r_wt[0].nhome = fww_keep(r_wt[0].home[..], home_d);
    r_wt[0].ngit_snap = fww_keep(r_wt[0].git_snap[..], "stale-snap");
    r_wt[0].ngit_snap_cwd = fww_keep(r_wt[0].git_snap_cwd[..], sub);
    r_wt[0].query_dedup[0] = 12345; r_wt[0].query_dedup_cur = 1;
    r_wt[0].read_dedup[0] = FwReadDedup.{path_hash = 999, offset = 1, end_line = 10};
    r_wt[0].read_dedup_cur[0] = 1;
    res_b: [1024] u8; is_err := [1] bool.[false];
    // Failed EnterWorktree must NOT clobber caches
    _ = fww_tool_enter_worktree(r_wt[..], "{\"name\":\"../bad\"}", res_b[..], is_err[..]);
    if !is_err[0] || r_wt[0].ngit_snap == 0 || r_wt[0].query_dedup[0] != 12345 || r_wt[0].read_dedup[0].path_hash != 999 {
      print("FAIL 3: failed EnterWorktree should fail without invalidating caches\n"); return 1;
    }
    // Successful EnterWorktree switches to subdir-mapped cwd AND invalidates all caches
    _ = fww_tool_enter_worktree(r_wt[..], "{\"name\":\"sess-a\"}", res_b[..], is_err[..]);
    if is_err[0] || !r_wt[0].session_wt_active || !flawed_aw_ends(cast(string) r_wt[0].cwd[0..<r_wt[0].ncwd], "/sub/dir") {
      print("FAIL 3: EnterWorktree failed or bad cwd: %\n", cast(string) r_wt[0].cwd[0..<r_wt[0].ncwd]); return 1;
    }
    if r_wt[0].ngit_snap != 0 || r_wt[0].ngit_snap_cwd != 0 || r_wt[0].query_dedup[0] != 0 || r_wt[0].read_dedup[0].path_hash != 0 {
      print("FAIL 3: EnterWorktree did not invalidate caches\n"); return 1;
    }
    // Dirty worktree -> ExitWorktree(action="remove") without discard_changes must refuse fail-closed
    sess_root_b: [FS_PATH_MAX] u8;
    srn := fww_keep(sess_root_b[..], cast(string) r_wt[0].session_wt_root[0..<r_wt[0].nsession_wt_root]);
    sess_root := cast(string) sess_root_b[0..<srn];
    _ = fs_write(fs_join(sess_root, "untracked.tmp", p1_b[..]), "x\n");
    r_wt[0].ngit_snap = fww_keep(r_wt[0].git_snap[..], "wt-snap");
    r_wt[0].ngit_snap_cwd = fww_keep(r_wt[0].git_snap_cwd[..], sess_root);
    r_wt[0].query_dedup[0] = 54321;
    r_wt[0].read_dedup[0] = FwReadDedup.{path_hash = 777, offset = 1, end_line = 20};
    _ = fww_tool_exit_worktree(r_wt[..], "{\"action\":\"remove\"}", res_b[..], is_err[..]);
    if !is_err[0] || !r_wt[0].session_wt_active || r_wt[0].ngit_snap == 0 {
      print("FAIL 3: ExitWorktree should fail closed on dirty tree without discard_changes\n"); return 1;
    }
    // ExitWorktree(action="remove", discard_changes=true) restores cwd, invalidates caches, removes dir AND branch!
    _ = fww_tool_exit_worktree(r_wt[..], "{\"action\":\"remove\",\"discard_changes\":true}", res_b[..], is_err[..]);
    if is_err[0] || r_wt[0].session_wt_active || cast(string) r_wt[0].cwd[0..<r_wt[0].ncwd] != sub {
      print("FAIL 3: ExitWorktree(remove, discard) failed\n"); return 1;
    }
    if r_wt[0].ngit_snap != 0 || r_wt[0].ngit_snap_cwd != 0 || r_wt[0].query_dedup[0] != 0 || r_wt[0].read_dedup[0].path_hash != 0 {
      print("FAIL 3: ExitWorktree did not invalidate caches\n"); return 1;
    }
    if fs_kind(sess_root) != FS_NONE {
      print("FAIL 3: session worktree dir still exists after remove\n"); return 1;
    }
    ver_sess := [3] string.["rev-parse", "--verify", "refs/heads/worktree-sess-a"];
    _ = fww_git_quick_argv(repo, ver_sess[..], 1500, chk_buf[..], ref_ok[..]);
    if ref_ok[0] { print("FAIL 3: session branch worktree-sess-a still exists after ExitWorktree(remove)\n"); return 1; }
    print("OK 3/4 EnterWorktree/ExitWorktree cache invalidation + fail-closed exit + ephemeral branch deletion\n");

    // 4. 30-day stale worktree sweeper
    wt_root_b: [FS_PATH_MAX] u8; wt_root := fs_join(home_d, ".openagents/worktrees", wt_root_b[..]);
    _ = fs_mkdir_all(wt_root);
    s_old_a: [FS_PATH_MAX] u8; s_old_w: [FS_PATH_MAX] u8; s_act: [FS_PATH_MAX] u8; s_feat: [FS_PATH_MAX] u8; s_dirty: [FS_PATH_MAX] u8; s_nongit: [FS_PATH_MAX] u8;
    tb_br: [96] u8; tb_hd: [64] u8;
    _ = fww_wt_create(repo, home_d, "agent-old1", s_old_a[..], tb_br[..], tb_hd[..]);
    _ = fww_wt_create(repo, home_d, "worktree-old2", s_old_w[..], tb_br[..], tb_hd[..]);
    _ = fww_wt_create(repo, home_d, "agent-active1", s_act[..], tb_br[..], tb_hd[..]);
    _ = fww_wt_create(repo, home_d, "my-feature", s_feat[..], tb_br[..], tb_hd[..]);
    _ = fww_wt_create(repo, home_d, "agent-dirty1", s_dirty[..], tb_br[..], tb_hd[..]);
    _ = fs_write(fs_join(wt_root, "agent-dirty1/dirty.txt", p1_b[..]), "dirty\n");
    _ = fs_mkdir_all(fs_join(wt_root, "agent-nongit", s_nongit[..]));

    // Real current wall time: age < 30 days -> 0 removed
    wall_now_ms := cxproc_wall_us() / 1000;
    if fww_wt_sweep_stale_in(wt_root, fs_join(wt_root, "agent-active1", p1_b[..]), wall_now_ms, FLAWED_WT_STALE_MS) != 0 {
      print("FAIL 4: fresh worktrees should not be swept\n"); return 1;
    }
    // Simulated wall now = real_now + 30 days + 10s:
    // agent-old1 + worktree-old2 removed (2); agent-inc1 (committed), agent-active1 (active),
    // my-feature (non-ephemeral), agent-dirty1 (dirty), agent-nongit (non-git) all preserved!
    future_ms := wall_now_ms + FLAWED_WT_STALE_MS + 10000;
    sw := fww_wt_sweep_stale_in(wt_root, fs_join(wt_root, "agent-active1", p1_b[..]), future_ms, FLAWED_WT_STALE_MS);
    if sw != 2 {
      print("FAIL 4: expected 2 stale worktrees removed, got %\n", sw); return 1;
    }
    if fs_kind(fs_join(wt_root, "agent-old1", p1_b[..])) != FS_NONE || fs_kind(fs_join(wt_root, "worktree-old2", p1_b[..])) != FS_NONE {
      print("FAIL 4: stale clean ephemeral worktrees still on disk\n"); return 1;
    }
    if fs_kind(fs_join(wt_root, "agent-active1", p1_b[..])) != FS_DIR ||
       fs_kind(fs_join(wt_root, "my-feature", p1_b[..])) != FS_DIR ||
       fs_kind(fs_join(wt_root, "agent-dirty1", p1_b[..])) != FS_DIR ||
       fs_kind(fs_join(wt_root, "agent-inc1", p1_b[..])) != FS_DIR ||
       fs_kind(fs_join(wt_root, "agent-nongit", p1_b[..])) != FS_DIR {
      print("FAIL 4: sweeper deleted a worktree or non-git dir it should have preserved\n"); return 1;
    }
    ver_old := [3] string.["rev-parse", "--verify", "refs/heads/worktree-agent-old1"];
    _ = fww_git_quick_argv(repo, ver_old[..], 1500, chk_buf[..], ref_ok[..]);
    if ref_ok[0] { print("FAIL 4: swept branch worktree-agent-old1 still exists\n"); return 1; }
    print("OK 4/4 30-day stale worktree sweeper pruned 2 clean ephemeral worktrees and preserved active/fresh/dirty/committed/named/non-git dirs\n");
    return 0;
  }

  if fww_flag_asked("--selftest-subagent") {
    tmp_b: [FS_PATH_MAX] u8;
    tmp := fs_temp("oa-sub-e2e-", tmp_b[..]);
    if tmp.count == 0 { print("FAIL: fs_temp failed\n"); return 1; }
    defer { _ = fs_remove(tmp); }
    home_b: [FS_PATH_MAX] u8; home_d := fs_join(tmp, "home", home_b[..]);
    _ = fs_mkdir_all(home_d);

    // 1. Session-scoped metadata + append-only structured DAG JSONL + multi-turn resume append + truncated-tail tolerance
    r1: [1] FwRun; h1: [1] FwHist; b1: [1] FwBufs;
    r1[0].nhome = fww_keep(r1[0].home[..], home_d);
    r1[0].nsession_id = fww_keep(r1[0].session_id[..], "sess:alpha/1");
    rec_a: [1] FwSubagentRec;
    rec_a[0] = FwSubagentRec.{active = true, running = false, read_only = true, start_ms = 1700000001000};
    rec_a[0].nagent_id = fww_keep(rec_a[0].agent_id[..], "aexp-1111222233334444");
    rec_a[0].nname = fww_keep(rec_a[0].name[..], "scout");
    rec_a[0].nsubagent_type = fww_keep(rec_a[0].subagent_type[..], "Explore");
    rec_a[0].ndesc = fww_keep(rec_a[0].desc[..], "Inspect runtime");
    rec_a[0].nwt_path = fww_keep(rec_a[0].wt_path[..], "/tmp/wt/scout");
    rec_a[0].nwt_branch = fww_keep(rec_a[0].wt_branch[..], "worktree-scout");
    rec_a[0].nperm_mode = fww_keep(rec_a[0].perm_mode[..], "plan");
    rec_a[0].ngit = fww_keep(rec_a[0].git[..], "none");
    rec_a[0].nlevel = fww_keep(rec_a[0].level[..], "neon");
    rec_a[0].nsession_id = fww_keep(rec_a[0].session_id[..], "sess:alpha/1");
    rec_a[0].noutput_file = fww_subagent_write_meta(home_d, "sess:alpha/1", rec_a[..], rec_a[0].output_file[..]);
    jpath_a := cast(string) rec_a[0].output_file[0..<rec_a[0].noutput_file];
    if !fww_contains_ci(jpath_a, "/.openagents/subagents/sess_alpha_1/agent-aexp-1111222233334444.jsonl") {
      print("FAIL 1: unexpected session-scoped path: %\n", jpath_a); return 1;
    }

    // Child appends 4 structured turns (user -> assistant[thinking+sig+tool_use] -> tool_results[is_error] -> assistant[text])
    r1[0].nagent_id = fww_keep(r1[0].agent_id[..], "aexp-1111222233334444");
    r1[0].nsidechain_jsonl = fww_keep(r1[0].sidechain_jsonl[..], jpath_a);
    fww_hist_push_user(h1[..], "Find auth files");
    fww_run_append_sidechain_msg(r1[..], h1[..], 0, b1[0].compact_buf[..]);
    a0 := [1] int.[0];
    h1[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 2};
    tb0 := FwBlock.{kind = FWW_MB_THINK};
    tb0.text_n = fww_slab_put(h1[..], "checking wire", a0[..]); tb0.text_at = a0[0];
    tb0.sig_n = fww_slab_put(h1[..], "SIG_A1", a0[..]); tb0.sig_at = a0[0];
    tu0 := FwBlock.{kind = FWW_MB_TOOL_USE};
    tu0.id_n = fww_slab_put(h1[..], "tc_1", a0[..]); tu0.id_at = a0[0];
    tu0.name_n = fww_slab_put(h1[..], "Read", a0[..]); tu0.name_at = a0[0];
    tu0.text_n = fww_slab_put(h1[..], "{\"file_path\":\"a.coax\"}", a0[..]); tu0.text_at = a0[0];
    tu0.sig_n = fww_slab_put(h1[..], "SIG_TU1", a0[..]); tu0.sig_at = a0[0];
    h1[0].msgs[1].blocks[0] = tb0; h1[0].msgs[1].blocks[1] = tu0;
    h1[0].nmsgs = 2;
    fww_run_append_sidechain_msg(r1[..], h1[..], 1, b1[0].compact_buf[..]);
    h1[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
    tr0 := FwBlock.{kind = FWW_MB_TOOL_RES, is_error = true};
    tr0.id_n = fww_slab_put(h1[..], "tc_1", a0[..]); tr0.id_at = a0[0];
    tr0.name_n = fww_slab_put(h1[..], "Read", a0[..]); tr0.name_at = a0[0];
    tr0.text_n = fww_slab_put(h1[..], "missing file", a0[..]); tr0.text_at = a0[0];
    h1[0].msgs[2].blocks[0] = tr0;
    h1[0].nmsgs = 3;
    fww_run_append_sidechain_msg(r1[..], h1[..], 2, b1[0].compact_buf[..]);
    fww_hist_push_assistant_text(h1[..], "a.coax was missing");
    fww_run_append_sidechain_msg(r1[..], h1[..], 3, b1[0].compact_buf[..]);

    // Simulate a crash leaving a truncated trailing line, then load into a fresh resumed worker and append turn 2!
    _ = fs_append(jpath_a, "{\"uuid\":\"partial-crash\",\"role\":\"user\",\"blocks\":[");
    h2: [1] FwHist; r2: [1] FwRun; leaf_n := [1] int.[0];
    loaded_n := fww_subagent_load_jsonl(jpath_a, h2[..], b1[0].req_body[..], b1[0].compact_buf[..], r2[0].dag_head_uuid[..], leaf_n[..]);
    r2[0].ndag_head_uuid = leaf_n[0];
    if loaded_n != 4 || r2[0].ndag_head_uuid == 0 {
      print("FAIL 1: expected 4 hydrated msgs with leaf uuid, got % (leaf=%)\n", loaded_n, r2[0].ndag_head_uuid); return 1;
    }
    if h2[0].msgs[1].blocks[0].kind != FWW_MB_THINK || fww_slab_str(h2[..], h2[0].msgs[1].blocks[0].sig_at, h2[0].msgs[1].blocks[0].sig_n) != "SIG_A1" {
      print("FAIL 1: thinking/sig block lost\n"); return 1;
    }
    if h2[0].msgs[2].blocks[0].kind != FWW_MB_TOOL_RES || !h2[0].msgs[2].blocks[0].is_error {
      print("FAIL 1: tool_result is_error lost\n"); return 1;
    }
    // Resumed worker appends turn 2 (user + assistant) chained off hydrated leaf uuid!
    r2[0].nsidechain_jsonl = fww_keep(r2[0].sidechain_jsonl[..], jpath_a);
    r2[0].nagent_id = fww_keep(r2[0].agent_id[..], "aexp-1111222233334444");
    r2[0].nsession_id = fww_keep(r2[0].session_id[..], "sess:alpha/1");
    _ = fs_append(jpath_a, "\n"); // terminate truncated crash line cleanly before next append
    fww_hist_push_user(h2[..], "Check b.coax instead");
    fww_run_append_sidechain_msg(r2[..], h2[..], 4, b1[0].compact_buf[..]);
    fww_hist_push_assistant_text(h2[..], "Found b.coax!");
    fww_run_append_sidechain_msg(r2[..], h2[..], 5, b1[0].compact_buf[..]);

    h3: [1] FwHist; leaf3_b: [64] u8; leaf3_n := [1] int.[0];
    loaded3 := fww_subagent_load_jsonl(jpath_a, h3[..], b1[0].req_body[..], b1[0].compact_buf[..], leaf3_b[..], leaf3_n[..]);
    if loaded3 != 6 || fww_hist_msg_text(h3[..], 5) != "Found b.coax!" {
      print("FAIL 1: expected 6 chained msgs across initial+resumed runs, got %\n", loaded3); return 1;
    }
    print("OK 1/4 session-scoped DAG JSONL multi-turn append, crash-tail recovery, and structured FwHist hydration\n");

    // 2. Also persist a cross-session agent and a legacy flat-dir agent, then test disk-backed SendMessage after >24-slot eviction!
    rec_other: [1] FwSubagentRec;
    rec_other[0] = FwSubagentRec.{active = true, read_only = false, start_ms = 1700000002000};
    rec_other[0].nagent_id = fww_keep(rec_other[0].agent_id[..], "agen-other555566667777");
    rec_other[0].nname = fww_keep(rec_other[0].name[..], "prior-builder");
    rec_other[0].nsubagent_type = fww_keep(rec_other[0].subagent_type[..], "general-purpose");
    rec_other[0].nperm_mode = fww_keep(rec_other[0].perm_mode[..], "acceptEdits");
    rec_other[0].ngit = fww_keep(rec_other[0].git[..], "commit");
    rec_other[0].nlevel = fww_keep(rec_other[0].level[..], "neon");
    rec_other[0].noutput_file = fww_subagent_write_meta(home_d, "sess-old-99", rec_other[..], rec_other[0].output_file[..]);

    rec_flat: [1] FwSubagentRec;
    rec_flat[0] = FwSubagentRec.{active = true, read_only = true, start_ms = 1700000003000};
    rec_flat[0].nagent_id = fww_keep(rec_flat[0].agent_id[..], "aplan-flat888899990000");
    rec_flat[0].nsubagent_type = fww_keep(rec_flat[0].subagent_type[..], "Plan");
    rec_flat[0].nperm_mode = fww_keep(rec_flat[0].perm_mode[..], "plan");
    rec_flat[0].ngit = fww_keep(rec_flat[0].git[..], "none");
    rec_flat[0].nlevel = fww_keep(rec_flat[0].level[..], "inkling");
    rec_flat[0].noutput_file = fww_subagent_write_meta(home_d, "", rec_flat[..], rec_flat[0].output_file[..]);
    flat_jp := cast(string) rec_flat[0].output_file[0..<rec_flat[0].noutput_file];
    if !fww_contains_ci(flat_jp, "/.openagents/subagents/agent-aplan-flat888899990000.jsonl") {
      print("FAIL 2: empty session_id did not fall back to legacy flat dir: %\n", flat_jp); return 1;
    }

    // Fill all 24 slots in a fresh parent FwRun (none matching scout/other/flat); slot 5 is oldest non-running, slot 0 is running!
    rp: [1] FwRun;
    rp[0].nhome = fww_keep(rp[0].home[..], home_d);
    rp[0].nsession_id = fww_keep(rp[0].session_id[..], "sess:alpha/1");
    rp[0].host_agents = true;
    rp[0].nsubagents = FWW_MAX_SUBAGENT_RECS;
    for i: 0..<FWW_MAX_SUBAGENT_RECS {
      rp[0].subagents[i] = FwSubagentRec.{active = true, running = (i == 0), start_ms = 10000 + i * 100};
      rp[0].subagents[i].nagent_id = fww_keep(rp[0].subagents[i].agent_id[..], "afiller");
    }
    rp[0].subagents[5].start_ms = 500; // oldest non-running -> MUST be evicted first, NEVER running slot 0!

    // Restore scout by friendly name via SendMessage -> evicts slot 5 and emits MWW_DELEGATE with resume_transcript_path!
    wire_b: [8192] u8; res_b: [2048] u8; err_b := [1] bool.[false];
    sent := fww_tool_send_message(rp[..], 0, "{\"to\":\"scout\",\"message\":\"Follow up on b.coax\"}", res_b[..], err_b[..], wire_b[..]);
    if !sent || err_b[0] || !rp[0].waiting_delegate || rp[0].delegate_slots[0].rec_idx != 5 || !rp[0].subagents[0].running {
      print("FAIL 2: disk-backed SendMessage restore/eviction failed (slot=%)\n", rp[0].delegate_slots[0].rec_idx); return 1;
    }
    restored := rp[0].subagents[5];
    if cast(string) restored.subagent_type[0..<restored.nsubagent_type] != "Explore" ||
       !restored.read_only ||
       cast(string) restored.perm_mode[0..<restored.nperm_mode] != "plan" ||
       cast(string) restored.wt_path[0..<restored.nwt_path] != "/tmp/wt/scout" ||
       cast(string) restored.last_reply[0..<restored.nlast_reply] != "Found b.coax!" {
      print("FAIL 2: restored metadata mismatch\n"); return 1;
    }
    // Check cross-session lookup by friendly name & legacy flat-dir lookup by agent_id
    ri_other := fww_find_or_load_subagent_rec(rp[..], "prior-builder");
    ri_flat := fww_find_or_load_subagent_rec(rp[..], "aplan-flat888899990000");
    if ri_other < 0 || cast(string) rp[0].subagents[ri_other].git[0..<rp[0].subagents[ri_other].ngit] != "commit" ||
       ri_flat < 0 || cast(string) rp[0].subagents[ri_flat].level[0..<rp[0].subagents[ri_flat].nlevel] != "inkling" {
      print("FAIL 2: cross-session or legacy flat-dir lookup failed (% / %)\n", ri_other, ri_flat); return 1;
    }
    print("OK 2/4 disk-backed SendMessage lookup (session, cross-session, legacy flat) + 24-slot eviction + metadata restore\n");

    // 3. Blocking TaskOutput(block=false, block=true+short timeout, block=true+completion) on a REAL child subprocess!
    rt: [1] FwRun;
    rt[0].nhome = fww_keep(rt[0].home[..], home_d);
    rt[0].nsession_id = fww_keep(rt[0].session_id[..], "sess-to");
    rt[0].host_agents = false;
    rt[0].nsubagents = 1;
    rt[0].subagents[0] = FwSubagentRec.{active = true, running = true, is_bg = true, start_ms = proc_now_ms()};
    rt[0].subagents[0].nagent_id = fww_keep(rt[0].subagents[0].agent_id[..], "abg-9999000011112222");
    rt[0].subagents[0].ndesc = fww_keep(rt[0].subagents[0].desc[..], "bg worker");
    rt[0].subagents[0].nlast_prompt = fww_keep(rt[0].subagents[0].last_prompt[..], "Compute answer");
    rt[0].subagents[0].noutput_file = fww_subagent_write_meta(home_d, "sess-to", rt[0].subagents[0..<1], rt[0].subagents[0].output_file[..]);

    ph := proc_new();
    if ph < 0 || !proc_arg(ph, "/bin/sh") || !proc_arg(ph, "-c") ||
       !proc_arg(ph, "sleep 0.2; printf '{\"kind\":\"reply\",\"text\":\"partial\"}\\n{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"final bg answer\"}\\n'") ||
       proc_start(ph) != 0 {
      if ph >= 0 { _ = proc_release(ph); }
      print("FAIL 3: could not spawn mock child process\n"); return 1;
    }
    rt[0].local_subs[0] = FwLocalSubProc.{active = true, done = false, is_bg = true, h = ph, rec_idx = 0, tool_idx = 0};

    ob: [2048] u8; oerr := [1] bool.[false];
    // 3a. Non-blocking poll (block=false) returns immediately while child is still running
    t0 := proc_now_ms();
    n_nb := fww_tool_task_output(rt[..], "{\"task_id\":\"abg-9999000011112222\",\"block\":false}", ob[..], oerr[..]);
    if oerr[0] || !fww_contains_ci(cast(string) ob[0..<n_nb], "status: running") || (proc_now_ms() - t0) > 120 {
      print("FAIL 3a: block=false should return running immediately: %\n", cast(string) ob[0..<n_nb]);
      _ = proc_release(ph); return 1;
    }
    // 3b. Short blocking timeout (40ms) expires cleanly with timed_out: true without hanging
    n_to := fww_tool_task_output(rt[..], "{\"task_id\":\"abg-9999000011112222\",\"block\":true,\"timeout\":40}", ob[..], oerr[..]);
    if oerr[0] || !fww_contains_ci(cast(string) ob[0..<n_to], "status: running") || !fww_contains_ci(cast(string) ob[0..<n_to], "timed_out: true") {
      print("FAIL 3b: short timeout should return running + timed_out: %\n", cast(string) ob[0..<n_to]);
      _ = proc_release(ph); return 1;
    }
    // 3c. Blocking wait (timeout=3000) waits until child emits MWW_ENDED and returns completed + final reply + fallback DAG JSONL
    n_ok := fww_tool_task_output(rt[..], "{\"task_id\":\"abg-9999000011112222\",\"block\":true,\"timeout\":3000}", ob[..], oerr[..]);
    ok_s := cast(string) ob[0..<n_ok];
    if oerr[0] || rt[0].subagents[0].running || rt[0].local_subs[0].active ||
       !fww_contains_ci(ok_s, "status: completed") || !fww_contains_ci(ok_s, "final bg answer") {
      print("FAIL 3c: blocking TaskOutput did not complete cleanly: %\n", ok_s); return 1;
    }
    // Verify fallback DAG JSONL was appended on disk and loads cleanly!
    bg_of := cast(string) rt[0].subagents[0].output_file[0..<rt[0].subagents[0].noutput_file];
    h_bg: [1] FwHist; bg_leaf: [64] u8; bg_ln := [1] int.[0];
    bg_msgs := fww_subagent_load_jsonl(bg_of, h_bg[..], b1[0].req_body[..], b1[0].compact_buf[..], bg_leaf[..], bg_ln[..]);
    if bg_msgs != 2 || fww_hist_msg_text(h_bg[..], 0) != "Compute answer" || fww_hist_msg_text(h_bg[..], 1) != "final bg answer" {
      print("FAIL 3c: fallback DAG JSONL missing or mismatched (msgs=%)\n", bg_msgs); return 1;
    }
    print("OK 3/4 blocking TaskOutput (block=false, timeout expiry, blocking wait-to-completion + fallback DAG JSONL)\n");

    // 4. Verify completed fast path on disk-backed evicted agent via TaskOutput
    rt[0].nsubagents = 0; // clear memory completely
    n_disk := fww_tool_task_output(rt[..], "{\"task_id\":\"abg-9999000011112222\",\"block\":true,\"timeout\":500}", ob[..], oerr[..]);
    if oerr[0] || !fww_contains_ci(cast(string) ob[0..<n_disk], "status: completed") || !fww_contains_ci(cast(string) ob[0..<n_disk], "final bg answer") {
      print("FAIL 4: TaskOutput disk fallback after eviction failed: %\n", cast(string) ob[0..<n_disk]); return 1;
    }
    print("OK 4/4 TaskOutput disk-backed lookup after in-memory eviction\n");
    return 0;
  }

  homebuf: [4096] u8;
  home := cl_getenv("CODER_HOME", homebuf[..]);
  if home.count == 0 { home = cl_getenv("HOME", homebuf[..]); }

  cfg: [1] FwConfig;
  auth: [1] FwAuth;
  fww_load_config(cfg[..]);

  sopts: [1] FwServeOpts;
  if fws_parse_serve_args(sopts[..]) {
    return fws_serve_main(sopts[..], cfg[..], auth[..], home);
  }

  fww_resolve_auth(cfg[..], home, cast(string) cfg[0].model[0..<cfg[0].nmodel], auth[..], true);

  if fww_auth_asked() {
    ob: [512] u8;
    jo: [1] Jo;
    jo_start(jo[..], ob[..]);
    jo_obj(jo[..]);
    jo_key(jo[..], "source"); jo_str(jo[..], cast(string) auth[0].source[0..<auth[0].nsource]);
    jo_key(jo[..], "ready"); jo_bool(jo[..], auth[0].ok);
    jo_key(jo[..], "label"); jo_str(jo[..], cast(string) auth[0].label[0..<auth[0].nlabel]);
    jo_end(jo[..]);
    fww_send(ob[..], jo[0].n);
    return 0;
  }

  run: [1] FwRun;
  hist: [1] FwHist;
  bufs: [1] FwBufs;
  line: [FWW_LINE] u8; nl := 0;
  out: [FWW_LINE] u8;
  ab: [65536] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  task_buf: [32768] u8; cwd_buf: [4096] u8;
  req: [1] MwwRequest;
  st: [1] McSteers; q: [1] MwQueue; f: [1] FwFollow;

  fww_send(out[..], mww_ready(out[..]));

  while true {
    ended := "";
    polled := [1] bool.[false];
    if run[0].active {
      ended = fww_poll_step(run[..], cfg[..], auth[..], hist[..], bufs[..], st[..], out[..], polled[..]);
      fww_drained(st[..], f[..], out[..]);
    } else if fww_has_active_local_subs(run[..]) {
      fww_poll_idle_local_bg(run[..], q[..], f[..], out[..], polled[..]);
    }
    if !run[0].active && f[0].starting && ended.count == 0 { ended = "failed"; }
    if ended.count > 0 { fww_turn_end(ended, st[..], q[..], f[..], out[..]); }

    fed := false;
    if !run[0].active && nl == 0 { nl = fww_dispatch(q[..], f[..], line[..], out[..]); fed = nl > 0; }
    if !fed {
      ch := cxterm_byte(fww_poll_wait_ms(run[0].active || fww_has_active_local_subs(run[..]), polled[0]));
      if ch == -2 { break; }
      got_line := false;
      while ch >= 0 {
        if ch == 10 { got_line = true; break; }
        if nl < line.count { line[nl] = cast,trunc(u8) ch; nl += 1; }
        ch = cxterm_byte(0);
      }
      if ch == -2 && !got_line { break; }
      if !got_line { continue; }
    }
    msg := cast(string) line[0..<nl];
    nl = 0;
    ar[0].at = 0; ar[0].full = false;
    what := mww_request(ar[..], msg, req[..]);

    if what == MWW_STEER { fww_steer(run[0].active, req[..], st[..], f[..], out[..]); continue; }
    if what == MWW_QUEUE {
      if !fww_queue_op(run[0].active, req[..], q[..], f[..], home, out[..]) { continue; }
      what = MWW_STOP;
    }
    if what == MWW_INTERRUPT {
      if !run[0].active { continue; }
      f[0].resubmit_due = req[0].resubmit;
      what = MWW_STOP;
    }
    if what == MWW_STOP {
      if run[0].active {
        fww_stop_active(run[..], out[..]);
        fww_turn_end("stopped", st[..], q[..], f[..], out[..]);
      }
      continue;
    }
    if what == MWW_FORGET {
      if !run[0].active {
        fww_hist_clear(hist[..]);
        for di: 0..<run[0].read_dedup.count { run[0].read_dedup[di] = FwReadDedup.{}; }
        run[0].ngit_snap = 0; run[0].ngit_snap_cwd = 0;
        run[0].session_allow = false;
      }
      continue;
    }
    if what == MWW_RECALL {
      if !run[0].active { fww_hist_recall(hist[..], req[0].recall); }
      continue;
    }
    if what == MWW_EMBED {
      fww_send(out[..], mww_embedding_error(out[..], "embeddings are not served by flawedworker"));
      continue;
    }
    if what == MWW_RESULTS {
      if run[0].active && run[0].waiting_delegate {
        tk_ok := !req[0].ticket.ok || req[0].ticket.value == run[0].delegate_ticket;
        if tk_ok {
          e := fww_finish_delegate_results(run[..], cfg[..], auth[..], hist[..], bufs[..], st[..], req[0].results, out[..]);
          if e.count > 0 { fww_turn_end(e, st[..], q[..], f[..], out[..]); }
        }
      }
      continue;
    }
    if what == MWW_ANSWER {
      if run[0].active && run[0].waiting_permit {
        tk_ok := !req[0].ticket.ok || req[0].ticket.value == run[0].permit_ticket;
        if tk_ok {
          run[0].waiting_permit = false;
          ti := run[0].permit_tool_idx;
          if req[0].allow {
            tnm := cast(string) run[0].acc[0].tools[ti].name[0..<run[0].acc[0].tools[ti].nname];
            tar := cast(string) run[0].acc[0].tools[ti].args[0..<run[0].acc[0].tools[ti].nargs];
            ttb: [512] u8;
            ttgt := fww_tool_target(tnm, tar, ttb[..]);
            if req[0].option == "allow_session" && !oa_member_is_bypass_immune(tnm, ttgt) { run[0].session_allow = true; }
            run[0].next_tool_idx = ti + 1;
            if !fww_exec_tool_now(run[..], cfg[..], auth[..], hist[..], bufs[..], ti, out[..]) {
              e := fww_advance_tools(run[..], cfg[..], auth[..], hist[..], bufs[..], st[..], out[..]);
              if e.count > 0 { fww_turn_end(e, st[..], q[..], f[..], out[..]); }
            }
          } else {
            run[0].acc[0].tools[ti].done = true;
            run[0].acc[0].tools[ti].is_error = true;
            why := ifx req[0].why.count > 0 then req[0].why else "User denied tool permission.";
            run[0].acc[0].tools[ti].nres = fww_keep(run[0].acc[0].tools[ti].res[..], why);
            run[0].next_tool_idx = ti + 1;
            e := fww_advance_tools(run[..], cfg[..], auth[..], hist[..], bufs[..], st[..], out[..]);
            if e.count > 0 { fww_turn_end(e, st[..], q[..], f[..], out[..]); }
          }
        }
      }
      continue;
    }
    if what != MWW_TASK || run[0].active { continue; }

    fww_turn_begin(f[..], msg, out[..]);
    mw_task := req[0].task;
    mw_cwd := req[0].cwd;
    if mw_task.count > task_buf.count || mw_cwd.count == 0 || mw_cwd.count > cwd_buf.count {
      fww_send(out[..], mww_ended(out[..], "failed", "Task or workspace exceeds worker bounds."));
      fww_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }
    tn := fww_keep(task_buf[..], mw_task);
    cn := fww_keep(cwd_buf[..], mw_cwd);
    tk := cast(string) task_buf[0..<tn];
    cd := cast(string) cwd_buf[0..<cn];

    // Refresh config & model-aware auth cleanly per turn so switching Inkling <-> Neon works seamlessly.
    fww_load_config(cfg[..]);

    // Model selection: custom override > task's requested model > config default
    req_model := ifx req[0].model.count > 0 then req[0].model else cl_str(ar[..], msg, "model");
    picked_model := ifx cfg[0].ncustom_model > 0 then cast(string) cfg[0].custom_model[0..<cfg[0].ncustom_model]
                    else ifx req_model.count > 0 then req_model
                    else cast(string) cfg[0].model[0..<cfg[0].nmodel];
    picked_effort := ifx req[0].effort.count > 0 then req[0].effort else cast(string) cfg[0].effort[0..<cfg[0].neffort];

    // Detect enclosing git repository for Auto routing and cached git-snapshot capture.
    repo_b: [128] u8;
    repo_name := fww_detect_repo_name(cd, repo_b[..]);

    // System One Front v2alpha1 routing in Auto mode (#14056)
    run[0].nmissing_cap_hint = 0;
    run[0].nrouted_delegate = 0;
    if (picked_model == "oa:auto" || picked_model == "auto") && cfg[0].ncustom_model == 0 && !(tk.count > 0 && tk[0] == '/') {
      lbase_b: [512] u8;
      lbase := fww_trim(cl_getenv("PSIONIC_BASE_URL", lbase_b[..]));
      local_ready := fww_local_reachable(lbase);
      probe_auth: [1] FwAuth;
      fww_resolve_auth(cfg[..], home, "oa:cloud", probe_auth[..], true);
      cloud_ready := probe_auth[0].ok && probe_auth[0].backend != FLAWED_BE_LOCAL;
      // A Nostr CLI key counts as a cloud sign-in only when the installed CLI can sign with it:
      // an older CLI has no `nostr auth`, and the message would fail at its first request.
      if cloud_ready && probe_auth[0].backend == FLAWED_BE_OURS && probe_auth[0].nours_cli > 0 && probe_auth[0].nkey == 0 {
        try_hdr: [4096] u8;
        if fww_sign_ours_nip98(probe_auth[..], "https://openagents.com/api/v1/inference", "{}", try_hdr[..]) <= 0 { cloud_ready = false; }
        for i: 0..<try_hdr.count { try_hdr[i] = 0; }
      }
      door_b: [64] u8;
      door_pref := fww_trim(cl_getenv("OA_AGENT_ROUTER_DOOR", door_b[..]));
      plan: [1] Rtr2Plan;
      ap := cast(string) run[0].active_pack[0..<run[0].nactive_pack];
      at := cast(string) run[0].active_tier[0..<run[0].nactive_tier];
      fww_route_auto_plan_v2(tk, repo_name, ap, at, local_ready, cloud_ready, door_pref, cfg[0].allow_local_harnesses, req[0].agents && req[0].claude, plan[..]);
      // The offline plan names no delegate; a message that plainly asks for Claude gets it when Claude can run.
      if plan[0].ok && (plan[0].explicit_delegate.count == 0 || plan[0].explicit_delegate == "none")
         && req[0].agents && req[0].claude && cfg[0].allow_local_harnesses && fww_text_asks_for_claude(tk) {
        plan[0].explicit_delegate = "claude";
      }
      if plan[0].ok {
        if plan[0].npacks > 0 { run[0].nactive_pack = fww_keep(run[0].active_pack[..], plan[0].capability_packs[0]); }
        run[0].nactive_tier = fww_keep(run[0].active_tier[..], plan[0].compute_tier);
        if plan[0].explicit_delegate.count > 0 && plan[0].explicit_delegate != "none" {
          run[0].nrouted_delegate = fww_keep(run[0].routed_delegate[..], plan[0].explicit_delegate);
        }
        if plan[0].missing_capability_hint.count > 0 {
          run[0].nmissing_cap_hint = fww_keep(run[0].missing_cap_hint[..], plan[0].missing_capability_hint);
        } else if !plan[0].continue_active {
          kw_b: [64] u8; kw_n := [1] int.[0];
          off_hint := fww_detect_missing_capability(tk, kw_b[..], kw_n[..]);
          if off_hint.count > 0 {
            sku_b: [FS_PATH_MAX] u8; skw_b: [FS_PATH_MAX] u8;
            sku := fww_cap_skills_dir(home, sku_b[..]);
            skw := ifx cd.count > 0 then fs_join(cd, ".claude/skills", skw_b[..]) else "";
            kw_s := cast(string) kw_b[0..<kw_n[0]];
            if !ce_skills_dir_covers(sku, kw_s) && !ce_skills_dir_covers(skw, kw_s) {
              run[0].nmissing_cap_hint = fww_keep(run[0].missing_cap_hint[..], off_hint);
              run[0].nactive_pack = fww_keep(run[0].active_pack[..], "capability_author");
            }
          }
        }
        if plan[0].compute_tier == "local_inkling" && local_ready {
          picked_model = "oa:local";
        } else if cloud_ready {
          picked_model = "oa:cloud";
          if req[0].effort.count == 0 && plan[0].effort.count > 0 { picked_effort = plan[0].effort; }
        } else if local_ready {
          // No cloud sign-in: the local model takes the message rather than failing it.
          picked_model = "oa:local";
        }
      } else if !cloud_ready && local_ready {
        picked_model = "oa:local";
      }
    }

    fww_resolve_auth(cfg[..], home, picked_model, auth[..], false);

    run[0].ncwd = fww_keep(run[0].cwd[..], cd);
    run[0].nhome = fww_keep(run[0].home[..], home);
    if req[0].session.count > 0 {
      run[0].nsession_id = fww_keep(run[0].session_id[..], req[0].session);
    }
    if req[0].agent_id.count > 0 {
      run[0].nagent_id = fww_keep(run[0].agent_id[..], req[0].agent_id);
    }
    eff_sc_jsonl := ifx req[0].transcript_path.count > 0 then req[0].transcript_path else req[0].resume_transcript_path;
    if eff_sc_jsonl.count > 0 {
      if run[0].nsidechain_jsonl != eff_sc_jsonl.count || cast(string) run[0].sidechain_jsonl[0..<run[0].nsidechain_jsonl] != eff_sc_jsonl {
        run[0].nsidechain_jsonl = fww_keep(run[0].sidechain_jsonl[..], eff_sc_jsonl);
        run[0].ndag_head_uuid = 0;
      }
    }
    run[0].host_agents = req[0].agents;
    run[0].host_claude = req[0].agents && req[0].claude && cfg[0].allow_local_harnesses;
    run[0].is_subagent = req[0].is_subagent;
    run[0].is_fork_child = req[0].is_fork;
    run[0].subagent_read_only = req[0].read_only;
    // A sub-agent's git rule; one whose task line names none may not commit or push (#14104).
    run[0].nsubagent_git = fww_keep(run[0].subagent_git[..], ifx !req[0].is_subagent then "" else mc_gg_publish_rule(req[0].git));
    run[0].subagent_omit_claudemd = req[0].omit_claudemd;
    run[0].nsubagent_type = fww_keep(run[0].subagent_type[..], req[0].subagent_type);
    run[0].nsubagent_allowed = fww_keep(run[0].subagent_allowed[..], req[0].allowed_tools);
    run[0].nsubagent_disallowed = fww_keep(run[0].subagent_disallowed[..], req[0].disallowed_tools);
    run[0].waiting_delegate = false;
    run[0].waiting_local_delegate = false;
    run[0].ndelegate_slots = 0;
    fww_load_agent_registry(run[0].agent_reg[..], cd, home);
    if run[0].is_subagent && cfg[0].nsubagent_effort > 0 {
      picked_effort = cast(string) cfg[0].subagent_effort[0..<cfg[0].nsubagent_effort];
    }
    run[0].nmodel = fww_keep(run[0].model[..], picked_model);
    run[0].neffort = fww_keep(run[0].effort[..], picked_effort);
    run[0].step_num = 1;
    run[0].turn_cost_micros = 0;
    run[0].retry[0] = FlawedRetryState.{max_retries = 3};
    run[0].retry_at_ms = 0;
    run[0].waiting_permit = false;
    run[0].recoveries = 0;
    run[0].ctx_recoveries = 0;
    run[0].stall_recoveries = 0;
    run[0].stream_last_rx_ms = 0;
    run[0].force_wrapup_once = false;
    run[0].force_no_think_once = false;
    run[0].soft_deadline_ms = 0;
    run[0].last_tool_hash = 0;
    run[0].dup_tool_streak = 0;
    run[0].read_only_steps = 0;
    run[0].post_edit_steps = 0;
    run[0].turn_tool_bytes = 0;
    run[0].turn_start_ms = proc_now_ms();
    run[0].last_req_dur_ms = 0;
    run[0].nudge_stage = 0;
    run[0].long_think_nudges = 0;
    run[0].has_edited = false;
    run[0].last_bash_ok = false;
    run[0].last_step_had_err = false;
    run[0].audit_nudged = false;
    run[0].audit_done = false;
    run[0].finish_nudged = false;
    run[0].time_warn_stage = 0;
    run[0].calm_steps = 0;
    run[0].force_low_once = false;
    run[0].pm_fail_streak = 0;
    run[0].pm_last_edit_hash = 0;
    run[0].pm_same_file_churn = 0;
    run[0].pm_backtracks = 0;
    run[0].ndep_edited = 0;
    run[0].ntp_viewed = 0;
    run[0].tp_last_err_sig = 0;
    run[0].tp_err_inertia_cnt = 0;
    run[0].faith_retries = 0;
    run[0].faith_ran_test = false;
    run[0].faith_last_test_ok = false;
    run[0].faith_edited_after_test = false;
    run[0].nfaith_failed_edit_path = 0;
    hist[0].exp_compact_preserve = cfg[0].exp_compact_preserve;
    hist[0].exp_memtrace = cfg[0].exp_memtrace;
    hist[0].exp_obs_mask = cfg[0].exp_obs_mask;
    hist[0].exp_obs_mask_c_pct = cfg[0].exp_obs_mask_c_pct;
    if cd.count > 0 { hist[0].ntrace_cwd = fww_keep(hist[0].trace_cwd[..], cd); }
    for qi: 0..<run[0].query_dedup.count { run[0].query_dedup[qi] = 0; }

    // Handle local slash commands instantaneously
    if fww_handle_slash(tk, run[..], cfg[..], auth[..], hist[..], bufs[..], out[..]) {
      fww_turn_end("finished", st[..], q[..], f[..], out[..]);
      continue;
    }

    if !auth[0].ok {
      fww_send(out[..], mww_ended(out[..], "failed", cast(string) auth[0].label[0..<auth[0].nlabel]));
      fww_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }

    if hist[0].nmsgs >= FWW_MAX_MSGS - 4 || hist[0].nslab + tk.count + 8192 >= FWW_SLAB {
      _ = fww_hist_compact(hist[..], bufs[0].compact_buf[..]);
    }
    if hist[0].nmsgs >= FWW_MAX_MSGS - 4 || hist[0].nslab + tk.count + 8192 >= FWW_SLAB {
      _ = fww_emergency_compact(hist[..], 3, 0, bufs[0].compact_buf[..]);
    }
    if req[0].is_fork && req[0].fork_context_path.count > 0 && hist[0].nmsgs == 0 {
      _ = fww_load_fork_context(hist[..], req[0].fork_context_path);
    }
    if req[0].resume_transcript_path.count > 0 && hist[0].nmsgs == 0 {
      leaf_n := [1] int.[0];
      _ = fww_subagent_load_jsonl(req[0].resume_transcript_path, hist[..], bufs[0].req_body[..], bufs[0].compact_buf[..], run[0].dag_head_uuid[..], leaf_n[..]);
      run[0].ndag_head_uuid = leaf_n[0];
    }
    fww_hist_push_user(hist[..], tk);
    if hist[0].nmsgs > 0 {
      fww_run_append_sidechain_msg(run[..], hist[..], hist[0].nmsgs - 1, bufs[0].compact_buf[..]);
    }
    fww_hist_sanitize(hist[..], bufs[0].compact_buf[..]);
    mc_steer_clear(st[..]); st[0].nd = 0;

    // Always assemble the workspace-aware system prompt (cwd, tool guidance, instructions, and
    // cached git snapshot when inside a git repo). One-shot Explore/Plan subagents trim CLAUDE.md
    // and git snapshot via subagent_omit_claudemd; parent turns mount the active subagent catalog (#14096).
    if run[0].is_subagent && run[0].subagent_omit_claudemd {
      platform := ifx tool_os() == TOOL_LINUX then "Linux" else "macOS";
      run[0].nsys = fww_build_coding_system_prompt_core(cfg[..], cd, platform, run[0].sys_prompt[..]);
    } else {
      run[0].nsys = fww_build_system_prompt(cfg[..], cd, home, run[0].sys_prompt[..]);
      if !cfg[0].bare_mode && !run[0].is_subagent && repo_name.count > 0 {
        if run[0].ngit_snap_cwd != cd.count || cast(string) run[0].git_snap_cwd[0..<run[0].ngit_snap_cwd] != cd {
          run[0].ngit_snap = fww_capture_git_snapshot(cd, run[0].git_snap[..]);
          run[0].ngit_snap_cwd = fww_keep(run[0].git_snap_cwd[..], cd);
        }
        if run[0].ngit_snap > 0 {
          run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, cast(string) run[0].git_snap[0..<run[0].ngit_snap]);
        }
      }
    }
    if run[0].is_subagent && run[0].nsubagent_type > 0 {
      pi := oa_agents_find(run[0].agent_reg[..], cast(string) run[0].subagent_type[0..<run[0].nsubagent_type]);
      if pi >= 0 && run[0].agent_reg[0].defs[pi].nprompt > 0 {
        run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, "\n\n# Subagent Persona Instructions\n");
        run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, cast(string) run[0].agent_reg[0].defs[pi].prompt[0..<run[0].agent_reg[0].defs[pi].nprompt]);
        run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, "\n");
      }
    } else if !run[0].is_subagent && cfg[0].subagents_enabled {
      cat_b: [4096] u8;
      cn_cat := oa_agent_build_catalog_prompt(run[0].agent_reg[..], cat_b[..]);
      if cn_cat > 0 {
        run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, cast(string) cat_b[0..<cn_cat]);
      }
    }
    if run[0].nactive_pack > 0 && cast(string) run[0].active_pack[0..<run[0].nactive_pack] == "knowledge" {
      run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, "\n\n[Knowledge Pack Active] Answer questions about docs, books, transcripts, or past decisions using KnowledgeSearch (and KnowledgeGet for exact excerpts) in one fast turn with file:line citations instead of running repo-wide Grep/Bash loops.\n");
    }
    is_cap_p := run[0].nactive_pack > 0 && cast(string) run[0].active_pack[0..<run[0].nactive_pack] == "capability_author";
    run[0].nsys = fww_append_cap_author_prompt(run[0].sys_prompt[..], run[0].nsys, cast(string) run[0].missing_cap_hint[0..<run[0].nmissing_cap_hint], is_cap_p);
    if auth[0].backend != FLAWED_BE_LOCAL && cfg[0].auto_compact && hist[0].nmsgs >= 6 {
      est_tok := fww_estimate_prompt_tokens(hist[..], run[0].nsys, false, false);
      if cp_cache_status(hist[0].last_cloud_turn_ms, proc_now_ms(), 0, hist[0].last_cached_tok, est_tok, true) == CP_CACHE_EXPIRED_COMPACT {
        _ = fww_hist_compact_ex(hist[..], 0, 2, 512, 0, 0, bufs[0].compact_buf[..]);
      }
    }

    // Honor a System One router plan that explicitly delegated this turn to Claude Code (#14104).
    if fww_start_routed_claude_delegate(run[..], cfg[..], hist[..], home, tk, out[..]) {
      run[0].active = true;
      f[0].starting = false;
      continue;
    }

    err := fww_start_request(run[..], cfg[..], auth[..], hist[..], bufs[..], out[..]);
    if err.count > 0 {
      fww_send(out[..], mww_ended(out[..], "failed", err));
      fww_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }
    run[0].active = true;
    f[0].starting = false;
  }

  if run[0].active { fww_stop_active(run[..], out[..]); }
  return 0;
}

#test "flawedworker: poll wait drains streaming tokens at 0ms and SSRF guard blocks private URLs" {
  #assert fww_poll_wait_ms(false, false) == 200;
  #assert fww_poll_wait_ms(true, false) == 10;
  #assert fww_poll_wait_ms(true, true) == 0;
  #assert fww_url_safe("https://openagents.com/docs") && !fww_url_safe("http://127.0.0.1:8080/x");
  #assert !fww_url_safe("http://169.254.169.254/latest/meta-data") && !fww_url_safe("file:///etc/passwd");
}

#test "flawedworker: default config is Allow All (no permission checks) and local uncensored bodies format cleanly" {
  #assert fww_parse_permission_mode("") == FLAWED_PMODE_BYPASS && fww_parse_permission_mode("allow_all") == FLAWED_PMODE_BYPASS;
  #assert fww_parse_permission_mode("ask") == FLAWED_PMODE_DEFAULT && fww_parse_permission_mode("accept_edits") == FLAWED_PMODE_ACCEPT_EDITS;
  #assert fww_parse_permission_mode("plan") == FLAWED_PMODE_PLAN && fww_parse_permission_mode("dont_ask") == FLAWED_PMODE_DONT_ASK;
  #assert fww_local_variant_short("inkling-2-mini-uncensored-lora") == "Uncensored LoRA";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-maple") == "Uncensored (Maple)";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-q4k") == "Uncensored AD-Q4_K";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-iq3s") == "Uncensored AD-IQ3_S";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-iq2m") == "Uncensored AD-IQ2_M";
  #assert fww_local_variant_short("inkling-2-mini-abliterated-mix16g") == "Abliterated Mix-16G";
  #assert fww_local_variant_short("inkling-2-mini-abliterated-mix12g") == "Abliterated Mix-12G";
  #assert fww_local_variant_short("inkling-2-mini-custom") == "Custom Local .gguf";
  #assert fww_local_variant_short("inkling-2-mini") == "Official IQ4_NL";
  #assert fww_local_variant_short("other-id") == "other-id";

  cfg: [1] FwConfig;
  h: [1] FwHist;
  fww_hist_push_user(h[..], "hi");
  body: [16384] u8;
  n1 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-lora", "xhigh", "sys", true, 8192, false, false, body[..]);
  s1 := cast(string) body[0..<n1];
  nodes: [512] JvNode; d: [1] Jv; eb: [64] u8;
  #assert n1 > 0 && jv_parse(d[..], s1, nodes[..]);
  #assert jv_int(d[0], jv_get(d[0], 0, "max_tokens"), 0) == 4096;
  #assert jv_raw(d[0], jv_get(d[0], 0, "temperature")) == "0.6" && jv_int(d[0], jv_get(d[0], 0, "top_k"), 0) == 40;
  en1 := jv_str(d[0], jv_get(d[0], 0, "reasoning_effort"), eb[..]);
  #assert cast(string) eb[0..<en1] == "xhigh";
  #assert jv_kind(d[0], jv_get(d[0], 0, "tools")) == JV_ARRAY;

  cfg[0].thinking_mode = FLAWED_THINK_OFF;
  n2 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-q4k", "high", "sys", true, 32768, true, false, body[..]);
  s2 := cast(string) body[0..<n2];
  #assert n2 > 0 && jv_parse(d[..], s2, nodes[..]);
  #assert !jv_bool(d[0], jv_get(d[0], 0, "enable_thinking")) && jv_raw(d[0], jv_get(d[0], 0, "enable_thinking")) == "false";
  en2 := jv_str(d[0], jv_get(d[0], 0, "reasoning_effort"), eb[..]);
  #assert cast(string) eb[0..<en2] == "none";
  #assert jv_get(d[0], 0, "tools") < 0;

  // Verify H1/H2/H3/H7 harness primitives: local_max_tokens, force_no_think, Gemini NONE wrap-up, tool loop hash
  cfg[0].thinking_mode = FLAWED_THINK_ADAPTIVE;
  cfg[0].local_max_tokens = 6144;
  n3 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-lora", "low", "sys", true, 32768, false, false, body[..]);
  #assert n3 > 0 && jv_parse(d[..], cast(string) body[0..<n3], nodes[..]);
  #assert jv_int(d[0], jv_get(d[0], 0, "max_tokens"), 0) == 6144;

  n4 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-lora", "low", "sys", true, 32768, true, true, body[..]);
  #assert n4 > 0 && jv_parse(d[..], cast(string) body[0..<n4], nodes[..]);
  #assert jv_raw(d[0], jv_get(d[0], 0, "enable_thinking")) == "false" && jv_get(d[0], 0, "tools") < 0;

  // Non-coding Gemini turn (no prior tool history) omits tools + toolConfig completely;
  // wrap-up turn with prior tool history keeps tools + toolConfig NONE so Gemini accepts functionResponse history.
  ng0 := fww_build_gemini_body(cfg[..], h[..], "low", "sys", true, body[..]);
  #assert ng0 > 0 && jv_parse(d[..], cast(string) body[0..<ng0], nodes[..]);
  #assert jv_get(d[0], 0, "tools") < 0 && jv_get(d[0], 0, "toolConfig") < 0;

  hw: [1] FwHist;
  fww_hist_push_user(hw[..], "check repo");
  a0 := [1] int.[0];
  hw[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  ub := FwBlock.{kind = FWW_MB_TOOL_USE};
  ub.id_n = fww_slab_put(hw[..], "c1", a0[..]); ub.id_at = a0[0];
  ub.name_n = fww_slab_put(hw[..], "Read", a0[..]); ub.name_at = a0[0];
  ub.text_n = fww_slab_put(hw[..], "{}", a0[..]); ub.text_at = a0[0];
  hw[0].msgs[1].blocks[0] = ub;
  hw[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  rb := FwBlock.{kind = FWW_MB_TOOL_RES};
  rb.id_n = fww_slab_put(hw[..], "c1", a0[..]); rb.id_at = a0[0];
  rb.name_n = fww_slab_put(hw[..], "Read", a0[..]); rb.name_at = a0[0];
  rb.text_n = fww_slab_put(hw[..], "ok", a0[..]); rb.text_at = a0[0];
  hw[0].msgs[2].blocks[0] = rb;
  hw[0].nmsgs = 3;
  ng := fww_build_gemini_body(cfg[..], hw[..], "low", "sys", true, body[..]);
  #assert ng > 0 && jv_parse(d[..], cast(string) body[0..<ng], nodes[..]);
  #assert jv_kind(d[0], jv_get(d[0], 0, "toolConfig")) == JV_OBJECT;
  #assert fww_tool_sig_hash("Bash", "{\"command\":\"python3 a.py\"}") == fww_tool_sig_hash("Bash", "{\"command\":\"python3 a.py\"}");
  #assert fww_tool_sig_hash("Bash", "{\"command\":\"python3 a.py\"}") != fww_tool_sig_hash("Bash", "{\"command\":\"python3 b.py\"}");
}

#test "flawedworker: multi-layer compaction handles 17-command intra-turn 32K overflow, huge pastes, and HTTP 400 recovery" #steps 200000000 {
  // 1. UTF-8 safe head/tail truncation and overflow error detection + limit parsing
  #assert fww_utf8_cut("hello", 0) == 0 && fww_utf8_cut("hello", 10) == 5 && fww_utf8_cut("aéb", 2) == 1;
  #assert fww_utf8_tail_start("aéb", 2) == 3 && fww_utf8_tail_start("hello", 10) == 0;
  #assert fww_is_context_overflow_err("This model's maximum context length is 32768 tokens. However, your messages exceeded the context length.");
  #assert fww_is_context_overflow_err("prompt is too long: 41000 tokens > 32768 maximum") && fww_is_context_overflow_err("context_length_exceeded");
  #assert !fww_is_context_overflow_err("Authentication failed (HTTP 401)") && !fww_is_context_overflow_err("");
  #assert fww_parse_ctx_limit_from_err("This model's maximum context length is 32768 tokens. However, your messages exceeded the context length.") == 32768;
  #assert fww_parse_ctx_limit_from_err("Maximum context length is 8192 tokens") == 8192;
  #assert fww_parse_ctx_limit_from_err("generic error") == 0;

  // 2. Reproduce exact 17-command single-user-turn 32K local overflow scenario (>180 KB tool outputs in Turn 2)
  h: [1] FwHist;
  tmp: [524288] u8;
  fww_hist_push_user(h[..], "Look through ~/Desktop/GTA and summarize the project.");
  fww_hist_push_assistant_text(h[..], "Summary: reverse-engineered GTA VI mocap + WebGPU scenes.");
  fww_hist_push_user(h[..], "Create a new document specking out their mocap system and how to author animations.");

  big_chunk: [10240] u8;
  for i: 0..<big_chunk.count { big_chunk[i] = cast(u8) ('a' + (i % 26)); }
  big_s := cast(string) big_chunk[..];

  for step: 0..<17 {
    // Assistant tool_use
    am := h[0].nmsgs;
    h[0].msgs[am] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
    a0 := [1] int.[0];
    ub := FwBlock.{kind = FWW_MB_TOOL_USE};
    ub.id_n = fww_slab_put(h[..], "call_1", a0[..]); ub.id_at = a0[0];
    ub.name_n = fww_slab_put(h[..], "Read", a0[..]); ub.name_at = a0[0];
    ub.text_n = fww_slab_put(h[..], "{\"file_path\":\"mocap.c\"}", a0[..]); ub.text_at = a0[0];
    h[0].msgs[am].blocks[0] = ub;
    h[0].nmsgs += 1;
    // Tool result (10 KB each -> 170 KB = ~57K tokens > 32768!)
    tm := h[0].nmsgs;
    h[0].msgs[tm] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
    rb := FwBlock.{kind = FWW_MB_TOOL_RES};
    rb.id_n = fww_slab_put(h[..], "call_1", a0[..]); rb.id_at = a0[0];
    rb.name_n = fww_slab_put(h[..], "Read", a0[..]); rb.name_at = a0[0];
    rb.text_n = fww_slab_put(h[..], big_s, a0[..]); rb.text_at = a0[0];
    h[0].msgs[tm].blocks[0] = rb;
    h[0].nmsgs += 1;
  }
  #assert h[0].nmsgs == 37;
  #assert fww_estimate_prompt_tokens(h[..], 4000, true, false) > 32768;

  // Pre-flight guard MUST compact inside Turn 2 down below 32K while preserving strict role alternation & active user goal!
  #assert fww_ensure_context_fits(h[..], 4000, 32768, true, false, true, tmp[..]);
  post_tok := fww_estimate_prompt_tokens(h[..], 4000, true, false);
  #assert post_tok < 29184;
  #assert h[0].compact_count >= 1;
  #assert h[0].msgs[0].role == FWW_MROLE_USER;
  for i: 0..<h[0].nmsgs {
    // Never an orphaned TOOL_RESULTS at index 0 or after USER; never two consecutive ASSISTANT messages
    if h[0].msgs[i].role == FWW_MROLE_TOOL_RESULTS {
      #assert i > 0 && h[0].msgs[i - 1].role == FWW_MROLE_ASSISTANT;
    }
    if i > 0 && h[0].msgs[i].role == FWW_MROLE_ASSISTANT {
      #assert h[0].msgs[i - 1].role != FWW_MROLE_ASSISTANT;
    }
  }
  // Active user goal MUST still be present verbatim after compaction!
  found_goal := false;
  for i: 0..<h[0].nmsgs {
    if h[0].msgs[i].role == FWW_MROLE_USER && h[0].msgs[i].nblocks > 0 {
      ut := fww_slab_str(h[..], h[0].msgs[i].blocks[0].text_at, h[0].msgs[i].blocks[0].text_n);
      if fww_contains_ci(ut, "specking out their mocap system") { found_goal = true; }
    }
  }
  #assert found_goal;

  // Both OpenAI/Psionic and Gemini request bodies MUST serialize cleanly to valid JSON after intra-turn compaction!
  cfg: [1] FwConfig;
  body: [131072] u8;
  ob := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-maple", "high", "sys", true, 32768, false, false, body[..]);
  #assert ob > 0 && json_valid(cast(string) body[0..<ob]);
  gb := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, body[..]);
  #assert gb > 0 && json_valid(cast(string) body[0..<gb]);

  // 3. Double intra-turn compaction (run full compact again) MUST keep preserving the active user goal!
  #assert fww_hist_compact_ex(h[..], 2, 1, 512, 0, 8192, tmp[..]);
  u0 := fww_slab_str(h[..], h[0].msgs[0].blocks[0].text_at, h[0].msgs[0].blocks[0].text_n);
  #assert fww_contains_ci(u0, "specking out their mocap system") && fww_contains_ci(u0, "Read");

  // 4. Server-calibrated token estimation triggers compaction even if byte heuristic alone looks small
  h[0].last_in_tok = 29500;
  h[0].last_in_bytes = fww_estimate_prompt_bytes(h[..], 4000, true, false);
  #assert fww_estimate_prompt_tokens(h[..], 4000, true, false) >= 29500;
  #assert fww_ensure_context_fits(h[..], 4000, 32768, true, false, true, tmp[..]);
  #assert h[0].last_in_tok == 0;

  // 5. Giant single-message paste (150 KB in 1 USER message) MUST shrink below 32K even when auto_compact=false!
  fww_hist_clear(h[..]);
  huge: [150000] u8;
  for i: 0..<huge.count { huge[i] = cast(u8) ('A' + (i % 26)); }
  fww_hist_push_user(h[..], cast(string) huge[..]);
  #assert fww_estimate_prompt_tokens(h[..], 2000, true, false) > 45000;
  #assert fww_ensure_context_fits(h[..], 2000, 32768, true, false, false, tmp[..]);
  #assert fww_estimate_prompt_tokens(h[..], 2000, true, false) < 29184;

  // 6. Reactive emergency compaction level 3 collapses any history cleanly to fit even an 8K context window
  #assert fww_emergency_compact(h[..], 3, 8192, tmp[..]);
  #assert h[0].nmsgs == 1 && fww_estimate_prompt_tokens(h[..], 1024, true, true) < 4096;
}

#test "flawedworker: structural sanitizer and wire guards make model-terminated or mismatched Gemini/OpenAI requests impossible" #steps 200000000 {
  h: [1] FwHist;
  cfg: [1] FwConfig;
  tmp: [262144] u8;
  body: [131072] u8;
  nodes: [2048] JvNode;
  d: [1] Jv;
  rb: [64] u8;

  // 1. Exact FWW_MAX_MSGS saturation ending on ASSISTANT(tool_use) (build 34337 screenshot crash!)
  fww_hist_push_user(h[..], "Move the archive button to the top of the sidebar.");
  while h[0].nmsgs < FWW_MAX_MSGS {
    if h[0].nmsgs % 2 == 1 {
      mi := h[0].nmsgs;
      h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
      a0 := [1] int.[0];
      ub := FwBlock.{kind = FWW_MB_TOOL_USE};
      ub.id_n = fww_slab_put(h[..], "c1", a0[..]); ub.id_at = a0[0];
      ub.name_n = fww_slab_put(h[..], "Edit", a0[..]); ub.name_at = a0[0];
      ub.text_n = fww_slab_put(h[..], "{\"file_path\":\"zeron.coax\"}", a0[..]); ub.text_at = a0[0];
      h[0].msgs[mi].blocks[0] = ub;
      h[0].nmsgs += 1;
    } else {
      mi := h[0].nmsgs;
      h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
      a0 := [1] int.[0];
      tb := FwBlock.{kind = FWW_MB_TOOL_RES};
      tb.id_n = fww_slab_put(h[..], "c1", a0[..]); tb.id_at = a0[0];
      tb.name_n = fww_slab_put(h[..], "Edit", a0[..]); tb.name_at = a0[0];
      tb.text_n = fww_slab_put(h[..], "ok", a0[..]); tb.text_at = a0[0];
      h[0].msgs[mi].blocks[0] = tb;
      h[0].nmsgs += 1;
    }
  }
  #assert h[0].nmsgs == FWW_MAX_MSGS && h[0].msgs[h[0].nmsgs - 1].role == FWW_MROLE_ASSISTANT;
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs > 0 && h[0].nmsgs < FWW_MAX_MSGS;
  #assert h[0].msgs[0].role == FWW_MROLE_USER && h[0].msgs[h[0].nmsgs - 1].role != FWW_MROLE_ASSISTANT;
  g1 := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, body[..]);
  #assert g1 > 0 && jv_parse(d[..], cast(string) body[0..<g1], nodes[..]);
  c1 := jv_get(d[0], 0, "contents");
  cl1 := jv_len(d[0], c1);
  #assert cl1 >= 1;
  prev_r := "";
  for i: 0..<cl1 {
    rn := jv_str(d[0], jv_get(d[0], jv_at(d[0], c1, i), "role"), rb[..]);
    cur_r := cast(string) rb[0..<rn];
    if i == 0 { #assert cur_r == "user"; }
    if i == cl1 - 1 { #assert cur_r == "user"; }
    if i > 0 { #assert cur_r != prev_r; }
    prev_r = ifx cur_r == "user" then "user" else "model";
  }

  // 2. Dangling ASSISTANT(tool_use) after mid-tool stop + new USER prompt -> tool_use stripped, strict alternation
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "First task");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  a1 := [1] int.[0];
  d_ub := FwBlock.{kind = FWW_MB_TOOL_USE};
  d_ub.id_n = fww_slab_put(h[..], "call_dangling", a1[..]); d_ub.id_at = a1[0];
  d_ub.name_n = fww_slab_put(h[..], "Bash", a1[..]); d_ub.name_at = a1[0];
  d_ub.text_n = fww_slab_put(h[..], "{\"command\":\"ls\"}", a1[..]); d_ub.text_at = a1[0];
  h[0].msgs[1].blocks[0] = d_ub;
  h[0].nmsgs = 2;
  fww_hist_push_user(h[..], "Second task after stop");
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 3;
  #assert h[0].msgs[0].role == FWW_MROLE_USER && h[0].msgs[1].role == FWW_MROLE_ASSISTANT && h[0].msgs[2].role == FWW_MROLE_USER;
  #assert fww_msg_count_tool_use(h[0].msgs[1]) == 0;

  // 3. Mismatched functionCall (2) vs functionResponse (1) -> stripped cleanly
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Run two tools");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 2};
  h[0].msgs[1].blocks[0] = d_ub;
  h[0].msgs[1].blocks[1] = d_ub;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  m_tr := FwBlock.{kind = FWW_MB_TOOL_RES};
  m_tr.id_n = fww_slab_put(h[..], "call_dangling", a1[..]); m_tr.id_at = a1[0];
  m_tr.name_n = fww_slab_put(h[..], "Bash", a1[..]); m_tr.name_at = a1[0];
  m_tr.text_n = fww_slab_put(h[..], "only one", a1[..]); m_tr.text_at = a1[0];
  h[0].msgs[2].blocks[0] = m_tr;
  h[0].nmsgs = 3;
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 3 && fww_msg_count_tool_use(h[0].msgs[1]) == 0 && h[0].msgs[2].role == FWW_MROLE_USER;

  // 4. Thought-only ASSISTANT between two USER turns (H1 recovery) -> dropped & USERs merged (no [user, user]!)
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Solve hard math");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  th_b := FwBlock.{kind = FWW_MB_THINK};
  th_b.text_n = fww_slab_put(h[..], "internal scratchpad", a1[..]); th_b.text_at = a1[0];
  h[0].msgs[1].blocks[0] = th_b;
  h[0].nmsgs = 2;
  fww_hist_push_user(h[..], "Now write final answer.");
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 1 && h[0].msgs[0].role == FWW_MROLE_USER;
  m_txt := fww_slab_str(h[..], h[0].msgs[0].blocks[0].text_at, h[0].msgs[0].blocks[0].text_n);
  #assert fww_contains_ci(m_txt, "Solve hard math") && fww_contains_ci(m_txt, "Now write final answer.");

  // 5. Recall of interrupted turn (empty reply) + new user turn -> balanced user/model/user
  fww_hist_recall(h[..], "[{\"task\":\"old interrupted\",\"reply\":\"\"},{\"task\":\"done turn\",\"reply\":\"all set\"}]");
  #assert h[0].nmsgs == 4 && h[0].msgs[1].role == FWW_MROLE_ASSISTANT && h[0].msgs[3].role == FWW_MROLE_ASSISTANT;
  fww_hist_push_user(h[..], "new turn");
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 5 && h[0].msgs[4].role == FWW_MROLE_USER;

  // 6. Wire-level last-line-of-defense: calling Gemini/OpenAI body builders DIRECTLY on model-terminated history STILL ends with "user"!
  fww_hist_clear(h[..]);
  fww_hist_push_assistant_text(h[..], "stray leading assistant");
  fww_hist_push_user(h[..], "hello");
  fww_hist_push_assistant_text(h[..], "world");
  g2 := fww_build_gemini_body(cfg[..], h[..], "low", "sys", false, body[..]);
  #assert g2 > 0 && jv_parse(d[..], cast(string) body[0..<g2], nodes[..]);
  c2 := jv_get(d[0], 0, "contents");
  cl2 := jv_len(d[0], c2);
  #assert cl2 == 3;
  r0n := jv_str(d[0], jv_get(d[0], jv_at(d[0], c2, 0), "role"), rb[..]);
  #assert cast(string) rb[0..<r0n] == "user";
  r2n := jv_str(d[0], jv_get(d[0], jv_at(d[0], c2, 2), "role"), rb[..]);
  #assert cast(string) rb[0..<r2n] == "user";

  o2 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-maple", "low", "sys", true, 32768, false, false, body[..]);
  #assert o2 > 0 && jv_parse(d[..], cast(string) body[0..<o2], nodes[..]);
  ms2 := jv_get(d[0], 0, "messages");
  ml2 := jv_len(d[0], ms2);
  #assert ml2 >= 2;
  om_last := jv_str(d[0], jv_get(d[0], jv_at(d[0], ms2, ml2 - 1), "role"), rb[..]);
  #assert cast(string) rb[0..<om_last] == "user";
}

#test "flawedworker: v1 harness primitives (Read dedup/range, Edit fallback/diagnostics, Bash head+tail, signature repair)" #steps 200000000 {
  // 1. Line helpers + trimmed whitespace fallback + nearest-line diagnostics
  sample := "alpha\nbeta  \ngamma\r\ndelta\nalpha\n";
  #assert fww_count_lines(sample) == 5 && fww_count_lines("") == 0 && fww_count_lines("one") == 1;
  #assert fww_line_num_at(sample, 0) == 1 && fww_line_num_at(sample, 6) == 2;
  tf := [1] int.[0]; tt := [1] int.[0];
  #assert fww_find_trimmed_match(sample, "beta\ngamma\n", tf[..], tt[..]) == 1;
  #assert cast(string) sample[tf[0]..<tt[0]] == "beta  \ngamma\r\n";
  #assert fww_find_trimmed_match(sample, "alpha\n", tf[..], tt[..]) == 2;
  #assert fww_find_nearest_line(sample, "something_delta_missing\ngamma") == 3;

  // 2. Read dedup slot hit/miss/sub-range/epoch/invalidation
  slots: [4] FwReadDedup;
  cur := [1] int.[0];
  ph := fww_str_hash("/tmp/a.coax");
  ch := fww_str_hash("hello world");
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 0);
  fww_read_dedup_put(slots[..], cur[..], ph, 1, 500, 11, ch, 0);
  #assert fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 0);
  #assert fww_read_dedup_hit(slots[..], ph, 120, 320, 11, ch, 0); // sub-range covered!
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 600, 11, ch, 0); // extends past cached end_line
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 1); // invalidated by compaction epoch
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 12, ch, 0); // invalidated by size change
  fww_read_dedup_invalidate(slots[..], ph);
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 0);

  // 3. Streaming Bash head+tail buffer preserves BOTH first lines and final summary lines + exit code!
  cmd: [1] FwAsyncCmd;
  for i: 0..<1200 {
    lb: [96] u8;
    ln := fww_cat(lb[..], 0, "line_");
    ln = fww_put_int(lb[..], ln, i);
    ln = fww_cat(lb[..], ln, "_012345678901234567890123456789012345678901234567890123456789");
    fww_cmd_push_line(cmd[..], cast(string) lb[0..<ln]);
  }
  fn := fww_cmd_finalize(cmd[..]);
  out_s := cast(string) cmd[0].out[0..<fn];
  #assert cmd[0].omitted_bytes > 0;
  #assert fww_contains_ci(out_s, "line_0_");
  #assert fww_contains_ci(out_s, "bytes omitted in middle");
  #assert fww_contains_ci(out_s, "line_1199_");
  res_b: [FWW_TOOL_OUT_MAX] u8;
  rn1 := fww_cmd_tool_result(cmd[..], 2, false, res_b[..]);
  #assert fww_contains_ci(cast(string) res_b[0..<rn1], "[Exit code: 2]");
  empty_cmd: [1] FwAsyncCmd;
  rn2 := fww_cmd_tool_result(empty_cmd[..], 0, false, res_b[..]);
  #assert cast(string) res_b[0..<rn2] == "(command succeeded with no output)";

  // 4. Surgical thoughtSignature repair preserves all messages & swaps tool_use sig to Gemini skip sentinel
  h: [1] FwHist;
  fww_hist_push_user(h[..], "fix bug");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 2};
  a0 := [1] int.[0];
  b0 := FwBlock.{kind = FWW_MB_TEXT};
  b0.text_n = fww_slab_put(h[..], "checking", a0[..]); b0.text_at = a0[0];
  b0.sig_n = fww_slab_put(h[..], "bad_sig_text", a0[..]); b0.sig_at = a0[0];
  b1 := FwBlock.{kind = FWW_MB_TOOL_USE};
  b1.id_n = fww_slab_put(h[..], "c1", a0[..]); b1.id_at = a0[0];
  b1.name_n = fww_slab_put(h[..], "Read", a0[..]); b1.name_at = a0[0];
  b1.text_n = fww_slab_put(h[..], "{\"file_path\":\"a.coax\"}", a0[..]); b1.text_at = a0[0];
  b1.sig_n = fww_slab_put(h[..], "corrupted_sig", a0[..]); b1.sig_at = a0[0];
  h[0].msgs[1].blocks[0] = b0;
  h[0].msgs[1].blocks[1] = b1;
  h[0].nmsgs = 2;
  fww_hist_strip_thought_sigs(h[..]);
  #assert h[0].nmsgs == 2;
  #assert h[0].msgs[1].blocks[0].sig_n == 0;
  #assert fww_slab_str(h[..], h[0].msgs[1].blocks[1].sig_at, h[0].msgs[1].blocks[1].sig_n) == "skip_thought_signature_validator";

  // 5. Gemini wire serialization folds trailing FWW_MB_TEXT (<system-reminder>/steer) into last functionResponse.output
  //    so parts[] contains ONLY functionResponse parts (1-to-1 with functionCall, never HTTP 400 on Vertex AI!)
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 2};
  tr0 := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr0.id_n = fww_slab_put(h[..], "c1", a0[..]); tr0.id_at = a0[0];
  tr0.name_n = fww_slab_put(h[..], "Read", a0[..]); tr0.name_at = a0[0];
  tr0.text_n = fww_slab_put(h[..], "1\tline one", a0[..]); tr0.text_at = a0[0];
  tr1 := FwBlock.{kind = FWW_MB_TEXT};
  tr1.text_n = fww_slab_put(h[..], "<system-reminder>Edit now.</system-reminder>", a0[..]); tr1.text_at = a0[0];
  h[0].msgs[2].blocks[0] = tr0;
  h[0].msgs[2].blocks[1] = tr1;
  h[0].nmsgs = 3;
  cfg: [1] FwConfig;
  gbody: [32768] u8;
  gn := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, gbody[..]);
  nodes: [1024] JvNode; gd: [1] Jv;
  #assert gn > 0 && jv_parse(gd[..], cast(string) gbody[0..<gn], nodes[..]);
  cts := jv_get(gd[0], 0, "contents");
  #assert jv_len(gd[0], cts) == 3;
  tr_parts := jv_get(gd[0], jv_at(gd[0], cts, 2), "parts");
  #assert jv_len(gd[0], tr_parts) == 1; // strictly 1 functionResponse part, zero sibling text parts!
  fr0 := jv_get(gd[0], jv_at(gd[0], tr_parts, 0), "functionResponse");
  #assert jv_kind(gd[0], fr0) == JV_OBJECT;
  out_b: [512] u8;
  on := jv_str(gd[0], jv_get(gd[0], jv_get(gd[0], fr0, "response"), "output"), out_b[..]);
  #assert on > 0 && fww_contains_ci(cast(string) out_b[0..<on], "line one") && fww_contains_ci(cast(string) out_b[0..<on], "<system-reminder>Edit now.");

  // 6. Read auto-TOC symbol outline + true FLAWED_THINK_ADAPTIVE step effort policy
  code := "x := 1;\nfoo_bar :: (a: int) -> int {\n  return a;\n}\nMyRec :: struct {\n  v: int;\n}\n#test \"demo\" {\n  #assert true;\n}\n";
  ob: [2048] u8;
  oun := fww_append_symbol_outline(ob[..], 0, code, 2, 10);
  os := cast(string) ob[0..<oun];
  #assert fww_contains_ci(os, "L2: foo_bar ::") && fww_contains_ci(os, "L5: MyRec :: struct") && fww_contains_ci(os, "L8: #test");
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 1, 1, false, false, false, false, false, 0, 0, 0, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 3, 5, false, false, false, false, false, 0, 120, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 6, 11, true, true, false, false, false, 0, 300, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 7, 13, true, true, false, true, false, 0, 300, 600, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 8, 15, true, true, false, true, true, 0, 300, 600, false) == "low";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 5, 9, false, false, false, false, false, 2, 100, 600, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 6, 11, true, false, true, true, false, 0, 200, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 6, 11, false, false, false, false, false, 0, 390, 600, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 9, 17, true, true, false, false, false, 0, 510, 600, false) == "low";
  #assert fww_adaptive_effort(FLAWED_THINK_EXTENDED, "high", 1, 1, false, false, false, false, false, 0, 500, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 1, 1, false, false, false, false, false, 0, 500, 600, true) == "high";

  // 7. SSE dead-stream watchdog + dynamic pure-thought spiral guard + binary/UTF-8 sanitizer + fww_hist_clear telemetry reset
  #assert !fww_stream_stalled(false, false, 0, 1000, 200000);
  #assert !fww_stream_stalled(true, true, 0, 1000, 200000);
  #assert !fww_stream_stalled(true, false, 1, 1000, 200000);
  #assert !fww_stream_stalled(true, false, 0, 1000, 150999);
  #assert fww_stream_stalled(true, false, 0, 1000, 151000);
  #assert !fww_think_spiral(false, false, 0, 0, 0, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, true, 0, 0, 0, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 2, 0, 0, 60000, 1000, 1000, 600, 300000);
  #assert fww_is_transient_sse_err("This model is currently experiencing high demand. Spikes in demand are usually temporary.");
  #assert fww_is_transient_sse_err("Service UNAVAILABLE: please try again") && fww_is_transient_sse_err("RESOURCE_EXHAUSTED");
  #assert !fww_is_transient_sse_err("API key not valid") && !fww_is_transient_sse_err("");
  #assert !fww_think_spiral(true, false, 0, 1, 0, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 0, 0, 1, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 0, 0, 0, 15999, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 0, 0, 0, 34000, 1000, 1000, 600, 186000);
  #assert fww_think_spiral(true, false, 0, 0, 0, 38000, 1000, 1000, 0, 100000);
  #assert fww_think_spiral(true, false, 0, 0, 0, 18000, 1000, 1000, 0, 206000);
  // Tight remaining budget (350s elapsed of 600s -> 250s left -> 40% = 100s cap from first_tok_ms) breaks spiral early!
  #assert !fww_think_spiral(true, false, 0, 0, 0, 18000, 351000, 1000, 600, 441000);
  #assert fww_think_spiral(true, false, 0, 0, 0, 18000, 351000, 1000, 600, 452000);
  // Binary / UTF-8 sanitization preserves valid text & UTF-8 while collapsing binary/C1-control streams
  #assert !fww_is_binary_bytes("hello café 123\nworld\t!");
  bin_raw := [8] u8.['A', 0x00, 0x80, 0xFF, 0x1B, 0xC2, 0x85, 'Z'];
  #assert fww_is_binary_bytes(cast(string) bin_raw[..]);
  san_out: [128] u8;
  sn := fww_sanitize_text_line("ok\rcafé\t1", san_out[..]);
  #assert cast(string) san_out[0..<sn] == "okcafé\t1";
  sn2 := fww_sanitize_text_line(cast(string) bin_raw[..], san_out[..]);
  #assert cast(string) san_out[0..<sn2] == "A[binary]Z";
  #assert fww_is_scratch_path("/tmp/test.py") && fww_is_scratch_path("/var/tmp/x.cc") && fww_is_scratch_path("/private/tmp/a");
  #assert !fww_is_scratch_path("/app/src/main.cc") && !fww_is_scratch_path("src/lib.ts") && !fww_is_scratch_path("");
  h[0].total_in = 999; h[0].total_out = 888; h[0].compact_count = 3;
  fww_hist_clear(h[..]);
  #assert h[0].total_in == 0 && h[0].total_out == 0 && h[0].compact_count == 0;
}

#test "flawedworker: atomic compaction never corrupts TOOL_USE names/sigs on tmp_buf overflow and sanitizer rejects invalid tool pairs" #steps 200000000 {
  h: [1] FwHist;
  cfg: [1] FwConfig;
  small_tmp: [131072] u8;
  body: [262144] u8;
  nodes: [2048] JvNode;
  d: [1] Jv;
  nb: [64] u8;

  // 1. Reproduce GTA CLEANROOM: many Write TOOL_USE messages whose total TOOL_USE JSON args exceed tmp_buf (128 KiB)
  //    AND hit FWW_MAX_MSGS - 6. Layer 1 (drop_to_tail=0) MUST fail atomically without corrupting trailing blocks,
  //    and fww_ensure_context_fits MUST escalate cleanly to Layer 2 keeping intact Write names, IDs, args, and sigs!
  fww_hist_push_user(h[..], "Implement Milestone 1 issues in order.");
  h[0].total_in = 317119;
  h[0].total_cost_micros = 13734794;

  // Build a ~4 KB valid JSON Write arg string
  warg: [4096] u8;
  wn := fww_cat(warg[..], 0, "{\"file_path\":\"src/render/frame_graph.mm\",\"content\":\"");
  while wn + 16 < warg.count { wn = fww_cat(warg[..], wn, "float x = 1.0f; "); }
  wn = fww_cat(warg[..], wn, "\"}");
  warg_s := cast(string) warg[0..<wn];

  // Fill to FWW_MAX_MSGS - 5 (251 msgs -> 125 Write steps -> ~500 KB of TOOL_USE args >> 128 KiB small_tmp!)
  for step: 0..<125 {
    a0 := [1] int.[0];
    am := h[0].nmsgs;
    h[0].msgs[am] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
    ub := FwBlock.{kind = FWW_MB_TOOL_USE};
    ub.id_n = fww_slab_put(h[..], "call_w", a0[..]); ub.id_at = a0[0];
    ub.name_n = fww_slab_put(h[..], "Write", a0[..]); ub.name_at = a0[0];
    ub.text_n = fww_slab_put(h[..], warg_s, a0[..]); ub.text_at = a0[0];
    ub.sig_n = fww_slab_put(h[..], "SIG_VALID_TOKEN_XYZ", a0[..]); ub.sig_at = a0[0];
    h[0].msgs[am].blocks[0] = ub;
    h[0].nmsgs += 1;

    tm := h[0].nmsgs;
    h[0].msgs[tm] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
    rb := FwBlock.{kind = FWW_MB_TOOL_RES};
    rb.id_n = fww_slab_put(h[..], "call_w", a0[..]); rb.id_at = a0[0];
    rb.name_n = fww_slab_put(h[..], "Write", a0[..]); rb.name_at = a0[0];
    rb.text_n = fww_slab_put(h[..], "Wrote 4000 bytes.", a0[..]); rb.text_at = a0[0];
    h[0].msgs[tm].blocks[0] = rb;
    h[0].nmsgs += 1;
  }
  #assert h[0].nmsgs == 251;
  last_before := h[0].nmsgs - 2;
  #assert fww_slab_str(h[..], h[0].msgs[last_before].blocks[0].name_at, h[0].msgs[last_before].blocks[0].name_n) == "Write";

  // Layer 1 in-place microcompact MUST refuse cleanly without mutating h when fixed TOOL_USE bytes exceed tmp_buf!
  #assert !fww_hist_compact_ex(h[..], 0, 2, 512, 0, 0, small_tmp[..]);
  #assert h[0].nmsgs == 251;
  #assert fww_slab_str(h[..], h[0].msgs[last_before].blocks[0].name_at, h[0].msgs[last_before].blocks[0].name_n) == "Write";
  #assert fww_slab_str(h[..], h[0].msgs[last_before].blocks[0].sig_at, h[0].msgs[last_before].blocks[0].sig_n) == "SIG_VALID_TOKEN_XYZ";

  // Full pre-flight guard MUST escalate cleanly to Layer 2, keeping intact Write calls, preserving session telemetry,
  // and serializing a valid Vertex/Gemini request with zero empty tool names!
  #assert fww_ensure_context_fits(h[..], 4000, 1048576, false, false, true, small_tmp[..]);
  #assert h[0].nmsgs == 5 && h[0].compact_count == 1 && h[0].total_in == 317119 && h[0].total_cost_micros == 13734794;
  fww_hist_sanitize(h[..], small_tmp[..]);
  #assert h[0].nmsgs == 5;
  gn := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, body[..]);
  #assert gn > 0 && jv_parse(d[..], cast(string) body[0..<gn], nodes[..]);
  cts := jv_get(d[0], 0, "contents");
  #assert jv_len(d[0], cts) == 5;
  fc1 := jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], cts, 1), "parts"), 0), "functionCall");
  fr2 := jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], cts, 2), "parts"), 0), "functionResponse");
  n1 := jv_str(d[0], jv_get(d[0], fc1, "name"), nb[..]);
  #assert n1 == 5 && cast(string) nb[0..<n1] == "Write";
  n2 := jv_str(d[0], jv_get(d[0], fr2, "name"), nb[..]);
  #assert n2 == 5 && cast(string) nb[0..<n2] == "Write";
  sig1 := jv_str(d[0], jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], cts, 1), "parts"), 0), "thoughtSignature"), nb[..]);
  #assert cast(string) nb[0..<sig1] == "SIG_VALID_TOKEN_XYZ";

  // 2. Sanitizer rejects empty functionCall.name & mismatched functionCall/functionResponse names (Vertex 400 INVALID_ARGUMENT)
  //    while preserving any merged trailing user message ("continue")!
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Original goal");
  a1 := [1] int.[0];
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  bad_tu := FwBlock.{kind = FWW_MB_TOOL_USE};
  bad_tu.id_n = fww_slab_put(h[..], "call_bad", a1[..]); bad_tu.id_at = a1[0];
  bad_tu.name_n = 0; // simulated empty corrupted tool name
  bad_tu.text_n = fww_slab_put(h[..], "{}", a1[..]); bad_tu.text_at = a1[0];
  h[0].msgs[1].blocks[0] = bad_tu;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 2};
  bad_tr := FwBlock.{kind = FWW_MB_TOOL_RES};
  bad_tr.id_n = fww_slab_put(h[..], "call_bad", a1[..]); bad_tr.id_at = a1[0];
  bad_tr.name_n = fww_slab_put(h[..], "Bash", a1[..]); bad_tr.name_at = a1[0];
  bad_tr.text_n = fww_slab_put(h[..], "ok", a1[..]); bad_tr.text_at = a1[0];
  cont_b := FwBlock.{kind = FWW_MB_TEXT};
  cont_b.text_n = fww_slab_put(h[..], "continue", a1[..]); cont_b.text_at = a1[0];
  h[0].msgs[2].blocks[0] = bad_tr;
  h[0].msgs[2].blocks[1] = cont_b;
  h[0].nmsgs = 3;

  // Wire-level defense even if called directly before sanitize: never emits empty functionCall.name!
  gn_raw := fww_build_gemini_body(cfg[..], h[..], "low", "sys", false, body[..]);
  #assert gn_raw > 0 && jv_parse(d[..], cast(string) body[0..<gn_raw], nodes[..]);
  raw_fc := jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], jv_get(d[0], 0, "contents"), 1), "parts"), 0), "functionCall");
  rn_raw := jv_str(d[0], jv_get(d[0], raw_fc, "name"), nb[..]);
  #assert rn_raw == 4 && cast(string) nb[0..<rn_raw] == "tool";

  // Sanitizer strips the corrupted empty-name tool pair and preserves "continue" as a clean USER turn!
  #assert !fww_msg_tools_valid(h[..], h[0].msgs[1], h[0].msgs[2]);
  fww_hist_sanitize(h[..], small_tmp[..]);
  #assert h[0].nmsgs == 3;
  #assert h[0].msgs[0].role == FWW_MROLE_USER && h[0].msgs[1].role == FWW_MROLE_ASSISTANT && h[0].msgs[2].role == FWW_MROLE_USER;
  #assert fww_msg_count_tool_use(h[0].msgs[1]) == 0;
  #assert fww_slab_str(h[..], h[0].msgs[2].blocks[0].text_at, h[0].msgs[2].blocks[0].text_n) == "continue";

  // 3. Mismatched functionCall.name ("Bash") vs functionResponse.name ("tool") with matching id is also rejected!
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Run build");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  tu_m := FwBlock.{kind = FWW_MB_TOOL_USE};
  tu_m.id_n = fww_slab_put(h[..], "c1", a1[..]); tu_m.id_at = a1[0];
  tu_m.name_n = fww_slab_put(h[..], "Bash", a1[..]); tu_m.name_at = a1[0];
  tu_m.text_n = fww_slab_put(h[..], "{\"command\":\"ls\"}", a1[..]); tu_m.text_at = a1[0];
  h[0].msgs[1].blocks[0] = tu_m;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  tr_m := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr_m.id_n = fww_slab_put(h[..], "c1", a1[..]); tr_m.id_at = a1[0];
  tr_m.name_n = fww_slab_put(h[..], "tool", a1[..]); tr_m.name_at = a1[0];
  tr_m.text_n = fww_slab_put(h[..], "ok", a1[..]); tr_m.text_at = a1[0];
  h[0].msgs[2].blocks[0] = tr_m;
  h[0].nmsgs = 3;
  #assert !fww_msg_tools_valid(h[..], h[0].msgs[1], h[0].msgs[2]);
  fww_hist_sanitize(h[..], small_tmp[..]);
  #assert h[0].nmsgs == 3 && fww_msg_count_tool_use(h[0].msgs[1]) == 0 && h[0].msgs[2].role == FWW_MROLE_USER;
}

#test "flawedworker: native Read image detection, macOS screenshot thin-space fallback, dims, multimodal wire, and compaction" {
  // 1. Extension extraction & classification
  eb: [16] u8;
  #assert fww_path_ext_lower("/Users/a/Shot.PNG", eb[..]) == "png" && fww_is_image_ext("png");
  #assert fww_path_ext_lower("foo/bar.JPEG", eb[..]) == "jpeg" && fww_is_image_ext("jpeg");
  #assert fww_path_ext_lower("a.webp", eb[..]) == "webp" && fww_is_image_ext("webp");
  #assert fww_path_ext_lower("a.heic", eb[..]) == "heic" && fww_is_image_ext("heic");
  #assert !fww_is_image_ext(fww_path_ext_lower("dir.png/readme.md", eb[..]));

  // 2. macOS screenshot AM/PM space <-> U+202F narrow no-break space fallback
  ab: [256] u8; ab2: [256] u8;
  alt1 := fww_alt_screenshot_path("/Users/a/Desktop/Screenshot 2026-04-01 at 10.30.00 AM.png", ab[..]);
  #assert alt1.count > 0 && alt1 != "/Users/a/Desktop/Screenshot 2026-04-01 at 10.30.00 AM.png";
  // Round-trip back from U+202F to regular ASCII space
  alt2 := fww_alt_screenshot_path(alt1, ab2[..]);
  #assert alt2 == "/Users/a/Desktop/Screenshot 2026-04-01 at 10.30.00 AM.png";
  #assert fww_alt_screenshot_path("/Users/a/Desktop/plain.png", ab[..]).count == 0;

  // 3. Magic-byte MIME detection & pure-Coax dimension parsing (PNG, GIF, JPEG, WebP)
  png_hdr := [24] u8.[0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0, 0, 0, 13, 'I', 'H', 'D', 'R', 0, 0, 0x05, 0xA0, 0, 0, 0x03, 0x84];
  #assert fww_detect_image_mime(cast(string) png_hdr[..]) == "image/png";
  w := [1] int.[0]; hh := [1] int.[0];
  #assert fww_image_dims(cast(string) png_hdr[..], "image/png", w[..], hh[..]) && w[0] == 1440 && hh[0] == 900;

  gif_hdr := [10] u8.['G', 'I', 'F', '8', '9', 'a', 0x40, 0x01, 0xF0, 0x00];
  #assert fww_detect_image_mime(cast(string) gif_hdr[..]) == "image/gif";
  #assert fww_image_dims(cast(string) gif_hdr[..], "image/gif", w[..], hh[..]) && w[0] == 320 && hh[0] == 240;

  jpg_hdr := [11] u8.[0xFF, 0xD8, 0xFF, 0xC0, 0x00, 0x07, 0x08, 0x04, 0x38, 0x07, 0x80];
  #assert fww_detect_image_mime(cast(string) jpg_hdr[..]) == "image/jpeg";
  #assert fww_image_dims(cast(string) jpg_hdr[..], "image/jpeg", w[..], hh[..]) && w[0] == 1920 && hh[0] == 1080;

  webp_hdr := [30] u8.['R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'E', 'B', 'P', 'V', 'P', '8', 'X', 0, 0, 0, 0, 0, 0, 0, 0, 0x3F, 0x03, 0x00, 0x57, 0x02, 0x00];
  #assert fww_detect_image_mime(cast(string) webp_hdr[..]) == "image/webp";
  #assert fww_image_dims(cast(string) webp_hdr[..], "image/webp", w[..], hh[..]) && w[0] == 832 && hh[0] == 600;

  // 4. Gemini multimodal functionResponse.parts[].inlineData & OpenAI multimodal user image_url serialization
  cfg: [1] FwConfig;
  h: [1] FwHist;
  fww_hist_push_user(h[..], "Inspect screenshot.png");
  a0 := [1] int.[0];
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  tu := FwBlock.{kind = FWW_MB_TOOL_USE};
  tu.id_n = fww_slab_put(h[..], "call_img_1", a0[..]); tu.id_at = a0[0];
  tu.name_n = fww_slab_put(h[..], "Read", a0[..]); tu.name_at = a0[0];
  tu.text_n = fww_slab_put(h[..], "{\"file_path\":\"screenshot.png\"}", a0[..]); tu.text_at = a0[0];
  h[0].msgs[1].blocks[0] = tu;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  tr := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr.id_n = fww_slab_put(h[..], "call_img_1", a0[..]); tr.id_at = a0[0];
  tr.name_n = fww_slab_put(h[..], "Read", a0[..]); tr.name_at = a0[0];
  tr.text_n = fww_slab_put(h[..], "[Image: screenshot.png | image/png | 1440x900 | 1024 bytes] Image attached natively in this tool result.", a0[..]); tr.text_at = a0[0];
  tr.img_mime_n = fww_slab_put(h[..], "image/png", a0[..]); tr.img_mime_at = a0[0];
  tr.img_n = fww_slab_put(h[..], "iVBORw0KGgo=", a0[..]); tr.img_at = a0[0];
  h[0].msgs[2].blocks[0] = tr;
  h[0].nmsgs = 3;

  // Token estimate counts image as ~1600 tok (NOT base64_bytes/3)
  tok_est := fww_estimate_prompt_tokens(h[..], 100, false, false);
  #assert tok_est > 1600 && tok_est < 6000;

  body: [32768] u8;
  gn := fww_build_gemini_body(cfg[..], h[..], "low", "sys", false, body[..]);
  #assert gn > 0;
  nodes: [512] JvNode; d: [1] Jv; sb: [128] u8;
  #assert jv_parse(d[..], cast(string) body[0..<gn], nodes[..]);
  cts := jv_get(d[0], 0, "contents");
  tr_parts := jv_get(d[0], jv_at(d[0], cts, 2), "parts");
  #assert jv_len(d[0], tr_parts) == 1;
  fr := jv_get(d[0], jv_at(d[0], tr_parts, 0), "functionResponse");
  fr_parts := jv_get(d[0], fr, "parts");
  #assert jv_len(d[0], fr_parts) == 1;
  inl := jv_get(d[0], jv_at(d[0], fr_parts, 0), "inlineData");
  mn := jv_str(d[0], jv_get(d[0], inl, "mimeType"), sb[..]);
  #assert cast(string) sb[0..<mn] == "image/png";
  dn := jv_str(d[0], jv_get(d[0], inl, "data"), sb[..]);
  #assert cast(string) sb[0..<dn] == "iVBORw0KGgo=";

  // OpenAI cloud body emits role:tool text followed by multimodal role:user image_url
  on := fww_build_openai_body(cfg[..], h[..], "google/gemini-4-neon", "low", "sys", false, 0, false, false, body[..]);
  #assert on > 0 && jv_parse(d[..], cast(string) body[0..<on], nodes[..]);
  omsgs := jv_get(d[0], 0, "messages");
  #assert jv_len(d[0], omsgs) == 5; // system, user, assistant, tool, multimodal user
  mm_msg := jv_at(d[0], omsgs, 4);
  rn := jv_str(d[0], jv_get(d[0], mm_msg, "role"), sb[..]);
  #assert cast(string) sb[0..<rn] == "user";
  mc := jv_get(d[0], mm_msg, "content");
  #assert jv_len(d[0], mc) == 2;
  url_n := jv_str(d[0], jv_get(d[0], jv_get(d[0], jv_at(d[0], mc, 1), "image_url"), "url"), sb[..]);
  #assert cast(string) sb[0..<url_n] == "data:image/png;base64,iVBORw0KGgo=";

  // Local text-only body omits image_url
  ln := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini", "low", "sys", true, 32768, false, false, body[..]);
  #assert ln > 0 && jv_parse(d[..], cast(string) body[0..<ln], nodes[..]);
  #assert jv_len(d[0], jv_get(d[0], 0, "messages")) == 4;

  // 5. Compaction preserves recent image blocks and drops old image blocks
  tmp: [65536] u8;
  // Add a second tool turn so turn 1 becomes "old" when keep_recent_tools = 1
  h[0].msgs[3] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  tu2 := FwBlock.{kind = FWW_MB_TOOL_USE};
  tu2.id_n = fww_slab_put(h[..], "call_2", a0[..]); tu2.id_at = a0[0];
  tu2.name_n = fww_slab_put(h[..], "Read", a0[..]); tu2.name_at = a0[0];
  tu2.text_n = fww_slab_put(h[..], "{\"file_path\":\"shot2.png\"}", a0[..]); tu2.text_at = a0[0];
  h[0].msgs[3].blocks[0] = tu2;
  h[0].msgs[4] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  tr2 := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr2.id_n = fww_slab_put(h[..], "call_2", a0[..]); tr2.id_at = a0[0];
  tr2.name_n = fww_slab_put(h[..], "Read", a0[..]); tr2.name_at = a0[0];
  tr2.text_n = fww_slab_put(h[..], "[Image: shot2.png]", a0[..]); tr2.text_at = a0[0];
  tr2.img_mime_n = fww_slab_put(h[..], "image/jpeg", a0[..]); tr2.img_mime_at = a0[0];
  tr2.img_n = fww_slab_put(h[..], "/9j/4AAQ", a0[..]); tr2.img_at = a0[0];
  h[0].msgs[4].blocks[0] = tr2;
  h[0].nmsgs = 5;

  #assert fww_hist_compact_ex(h[..], 0, 1, 512, 0, 0, tmp[..]);
  #assert h[0].msgs[2].blocks[0].img_n == 0; // older screenshot base64 stripped
  #assert h[0].msgs[4].blocks[0].img_n == 8 && fww_slab_str(h[..], h[0].msgs[4].blocks[0].img_at, h[0].msgs[4].blocks[0].img_n) == "/9j/4AAQ"; // recent screenshot preserved!
}

#test "flawedworker: Gemini native wire mounts all 8 core tools and cwd unconditionally on every normal turn" {
  cfg: [1] FwConfig;
  cfg[0].bare_mode = true;
  cfg[0].permission_mode = FLAWED_PMODE_BYPASS;
  cfg[0].thinking_mode = FLAWED_THINK_ADAPTIVE;

  full_b: [16384] u8;
  full_n := fww_build_coding_system_prompt_core(cfg[..], "/repo/openagents", "macOS", full_b[..]);
  full_sys := cast(string) full_b[0..<full_n];
  #assert full_n > 1500 && fww_contains_ci(full_sys, "Working directory: /repo/openagents");
  #assert fww_contains_ci(full_sys, "without tools unless workspace inspection is needed");
  #assert !fww_turn_no_tools(false) && fww_turn_no_tools(true);

  // Regression matrix: basic natural-language, plural, non-jargon, and conversational prompts MUST ALWAYS
  // receive all 8 core tools in functionDeclarations and workspace cwd!
  prompts := [9] string.[
    "summarize the open issues",
    "i had a 'condensed sidebar' setting in general thats no lnoger wher what the fuck happened to it",
    "what the fuck are you talking aobut of course i mean openagents desktop WHERE EHT FUCK IS IT",
    "summarize the open PRs",
    "what changed since yesterday?",
    "why is the sidebar broken?",
    "show me the latest builds and commits",
    "Hello! Can you explain the difference between TCP and UDP?",
    "hi",
  ];
  b_wire: [32768] u8;
  nodes: [512] JvNode;
  d: [1] Jv;
  h_p: [1] FwHist;
  for pr, pi: prompts {
    fww_hist_clear(h_p[..]);
    fww_hist_push_user(h_p[..], pr);
    gn := fww_build_gemini_body_packs(cfg[..], h_p[..], "high", full_sys, fww_turn_no_tools(false), 0, b_wire[..]);
    #assert gn > 0 && jv_parse(d[..], cast(string) b_wire[0..<gn], nodes[..]);
    g_tools := jv_get(d[0], 0, "tools");
    g_decls := jv_get(d[0], jv_at(d[0], g_tools, 0), "functionDeclarations");
    #assert jv_len(d[0], g_decls) == FLAWED_WIRE_NTOOLS;
    if pi == 0 {
      core_tools := [9] string.["Read", "Edit", "Write", "Bash", "Glob", "Grep", "TodoWrite", "WebFetch", "WebSearch"];
      sb: [64] u8;
      for tn, ti: core_tools {
        nn := jv_str(d[0], jv_get(d[0], jv_at(d[0], g_decls, ti), "name"), sb[..]);
        #assert cast(string) sb[0..<nn] == tn;
      }
      #assert fww_contains_ci(cast(string) b_wire[0..<gn], "Working directory: /repo/openagents");
      // Verify WebSearch target extraction and result formatter (#14113)
      ws_tb: [128] u8;
      #assert fww_tool_target("WebSearch", "{\"query\":\"coax compiler\"}", ws_tb[..]) == "coax compiler";
      ws_out: [2048] u8;
      ws_n := fww_websearch_format_results(
        "{\"results\":[{\"title\":\"Exa Docs\",\"url\":\"https://docs.exa.ai\",\"publishedDate\":\"2026-11-10\",\"author\":\"Exa\",\"highlights\":[\"Fast semantic search.\"]}]}",
        ws_out[..],
      );
      ws_txt := cast(string) ws_out[0..<ws_n];
      #assert ws_n > 0 && fww_contains_ci(ws_txt, "Title: Exa Docs") && fww_contains_ci(ws_txt, "URL: https://docs.exa.ai") && fww_contains_ci(ws_txt, "Fast semantic search.");
      #assert fww_websearch_format_results("{\"results\":[]}", ws_out[..]) == 0;
    }
  }

  // Forced wrap-up (`force_wrapup_once = true`) still disables tool calling cleanly
  fww_hist_clear(h_p[..]);
  fww_hist_push_user(h_p[..], "summarize the open issues");
  wrap_g := fww_build_gemini_body_packs(cfg[..], h_p[..], "high", full_sys, fww_turn_no_tools(true), 0, b_wire[..]);
  #assert wrap_g > 0 && jv_parse(d[..], cast(string) b_wire[0..<wrap_g], nodes[..]) && jv_get(d[0], 0, "tools") < 0;
}

#test "flawedworker: local OpenAI wire mounts all 8 core tools unconditionally and auto-router detects git repos" {
  cfg: [1] FwConfig;
  cfg[0].bare_mode = true;
  cfg[0].permission_mode = FLAWED_PMODE_BYPASS;
  cfg[0].thinking_mode = FLAWED_THINK_ADAPTIVE;

  full_b: [16384] u8;
  loc_b: [4096] u8;
  full_n := fww_build_coding_system_prompt_core(cfg[..], "/repo/openagents", "macOS", full_b[..]);
  loc_n := fww_build_local_coding_system_prompt_core(cfg[..], "/repo/openagents", "macOS", loc_b[..]);
  loc_sys := cast(string) loc_b[0..<loc_n];
  #assert loc_n > 200 && loc_n < 1024 && loc_n * 3 < full_n;
  #assert fww_contains_ci(loc_sys, "Working directory: /repo/openagents");
  #assert fww_contains_ci(loc_sys, "rm -rf ..") && fww_contains_ci(loc_sys, "git push");
  #assert fww_contains_ci(loc_sys, "without tools unless workspace inspection is needed");

  prompts := [5] string.[
    "summarize the open issues",
    "i had a 'condensed sidebar' setting in general thats no lnoger wher what the fuck happened to it",
    "summarize the open PRs",
    "Hello! Can you explain the difference between TCP and UDP?",
    "hi",
  ];
  b_wire: [32768] u8;
  nodes: [512] JvNode;
  d: [1] Jv;
  h_p: [1] FwHist;
  for pr, pi: prompts {
    fww_hist_clear(h_p[..]);
    fww_hist_push_user(h_p[..], pr);
    on := fww_build_openai_body_packs(cfg[..], h_p[..], "inkling-2-mini", "low", loc_sys, true, 32768, fww_turn_no_tools(false), false, 0, b_wire[..]);
    #assert on > 0 && jv_parse(d[..], cast(string) b_wire[0..<on], nodes[..]);
    o_tools := jv_get(d[0], 0, "tools");
    #assert jv_len(d[0], o_tools) == FLAWED_WIRE_NTOOLS;
    if pi == 0 {
      #assert fww_contains_ci(cast(string) b_wire[0..<on], "Working directory: /repo/openagents");
      #assert !fww_contains_ci(cast(string) b_wire[0..<on], "CoaxDefines");
    }
  }

  fww_hist_clear(h_p[..]);
  fww_hist_push_user(h_p[..], "summarize the open issues");
  wrap_o := fww_build_openai_body_packs(cfg[..], h_p[..], "inkling-2-mini", "low", loc_sys, true, 32768, fww_turn_no_tools(true), false, 0, b_wire[..]);
  #assert wrap_o > 0 && jv_parse(d[..], cast(string) b_wire[0..<wrap_o], nodes[..]) && jv_get(d[0], 0, "tools") < 0;

  // Repo name detection helpers (normal clone, parent-dir walk, linked worktree gitdir pointer)
  #assert fww_path_basename("/Users/a/work/openagents/") == "openagents";
  #assert fww_path_basename("/repo") == "repo" && fww_path_basename("/") == "";
  #assert fww_parent_dir("/Users/a/work/openagents/apps/") == "/Users/a/work/openagents";
  #assert fww_parent_dir("/Users/a") == "/Users" && fww_parent_dir("/Users") == "" && fww_parent_dir("/") == "";
  #assert fww_repo_name_from_gitdir("gitdir: /Users/chris/work/openagents/.git/worktrees/3030ab32-38a5\n") == "openagents";
  #assert fww_repo_name_from_gitdir("not-a-gitdir") == "";

  // Auto-routing with detected repo routes natural-language repo prompts to coder + cloud_fast, NOT general/local
  p: [1] Rtr2Plan;
  fww_route_auto_plan("Hello there!", "", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "general" && p[0].compute_tier == "local_inkling" && p[0].effort == "low";
  fww_route_auto_plan("summarize the open issues", "openagents", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "coder" && p[0].compute_tier == "cloud_fast";
  fww_route_auto_plan("i had a 'condensed sidebar' setting in general thats no lnoger wher", "openagents", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "coder" && p[0].compute_tier == "cloud_fast";
}

#test "flawedworker: Coax intel tools, auto-router continuation, member packs, and OpenAgents Cloud pricing (#14054-#14070)" {
  cfg: [1] FwConfig;
  cfg[0].bare_mode = true;
  cfg[0].permission_mode = FLAWED_PMODE_BYPASS;
  cfg[0].thinking_mode = FLAWED_THINK_ADAPTIVE;

  full_b: [16384] u8;
  full_n := fww_build_coding_system_prompt_core(cfg[..], "/repo/openagents", "macOS", full_b[..]);
  full_sys := cast(string) full_b[0..<full_n];
  #assert fww_contains_ci(full_sys, "CoaxDefines") && fww_contains_ci(full_sys, "CoaxUses") && fww_contains_ci(full_sys, "CoaxCheck");

  // Coax compiler-backed intelligence tools mount cleanly when OA_PACK_COAX_INTEL is active
  h_code: [1] FwHist;
  fww_hist_push_user(h_code[..], "Find where rp_put is defined in coax/lib/repo/lines.coax and check it.");
  b_code: [32768] u8;
  neon_code_n := fww_build_gemini_body_ex(cfg[..], h_code[..], "high", full_sys, false, true, b_code[..]);
  #assert neon_code_n > 0 && fww_contains_ci(cast(string) b_code[0..<neon_code_n], "CoaxDefines");

  // All 12 Coax compiler-backed intelligence tools map cleanly & have proper permission tiers
  #assert fww_is_coax_intel_tool("CoaxDefines") && fww_coax_intel_subcmd("CoaxDefines") == "defines";
  #assert fww_is_coax_intel_tool("CoaxUses") && fww_coax_intel_subcmd("CoaxUses") == "uses";
  #assert fww_is_coax_intel_tool("CoaxChecks") && fww_coax_intel_subcmd("CoaxChecks") == "checks";
  #assert fww_is_coax_intel_tool("CoaxExports") && fww_coax_intel_subcmd("CoaxExports") == "exports";
  #assert fww_is_coax_intel_tool("CoaxShow") && fww_coax_intel_subcmd("CoaxShow") == "show";
  #assert fww_is_coax_intel_tool("CoaxCheck") && fww_coax_intel_subcmd("CoaxCheck") == "check";
  #assert fww_is_coax_intel_tool("CoaxExplain") && fww_coax_intel_subcmd("CoaxExplain") == "explain";
  #assert fww_is_coax_intel_tool("CoaxVocab") && fww_coax_intel_subcmd("CoaxVocab") == "vocab";
  #assert fww_is_coax_intel_tool("CoaxEffects") && fww_coax_intel_subcmd("CoaxEffects") == "effects";
  #assert fww_is_coax_intel_tool("CoaxDepends") && fww_coax_intel_subcmd("CoaxDepends") == "depends";
  #assert fww_is_coax_intel_tool("CoaxLoaders") && fww_coax_intel_subcmd("CoaxLoaders") == "loaders";
  #assert fww_is_coax_intel_tool("CoaxReplace") && fww_coax_intel_subcmd("CoaxReplace") == "replace";
  #assert !fww_is_coax_intel_tool("Read");
  #assert flawed_wire_tool_permission("CoaxDefines", "rp_put", FLAWED_PMODE_PLAN, false, false) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("CoaxReplace", "coax/lib/repo/lines.coax", FLAWED_PMODE_PLAN, false, false) == FLAWED_PBEH_DENY;
  #assert flawed_wire_tool_permission("CoaxReplace", "coax/lib/repo/lines.coax", FLAWED_PMODE_ACCEPT_EDITS, false, false) == FLAWED_PBEH_ALLOW;

  // Auto mode System One Front v2alpha1 continuation & compute tier selection (#14056)
  p: [1] Rtr2Plan;
  fww_route_auto_plan("Fix the bug in policy.coax", "", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "coder" && p[0].compute_tier == "cloud_fast";
  fww_route_auto_plan("Now run the tests", "", "coder", "cloud_deep", true, true, "", p[..]);
  #assert p[0].ok && p[0].continue_active && p[0].capability_packs[0] == "coder" && p[0].compute_tier == "cloud_deep";
  fww_route_auto_plan("Check my Lightning wallet sats", "", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "wallet";

  // System One router explicit Claude delegate preparation (#14104)
  r_del: [1] FwRun; h_del: [1] FwHist;
  fww_hist_push_user(h_del[..], "Use Claude Opus to audit this file");
  r_del[0].host_agents = true;
  r_del[0].host_claude = false;
  r_del[0].nrouted_delegate = fww_keep(r_del[0].routed_delegate[..], "claude");
  #assert !fww_prepare_routed_claude_delegate(r_del[..], h_del[..], "Use Claude Opus to audit this file");
  r_del[0].host_claude = true;
  #assert fww_prepare_routed_claude_delegate(r_del[..], h_del[..], "Use Claude Opus to audit this file");
  #assert r_del[0].acc[0].ntools == 1 && cast(string) r_del[0].acc[0].tools[0].name[0..<r_del[0].acc[0].tools[0].nname] == "Agent";
  #assert fww_contains_ci(cast(string) r_del[0].acc[0].tools[0].args[0..<r_del[0].acc[0].tools[0].nargs], "claude-opus");
  #assert h_del[0].nmsgs == 2 && h_del[0].msgs[1].role == FWW_MROLE_ASSISTANT && h_del[0].msgs[1].blocks[0].kind == FWW_MB_TOOL_USE;

  // Member tool packs (#14057): Wallet, CLI, Metaverse/GameBuilder target extraction, schema mounting, & non-bypassable policy
  tb: [512] u8;
  #assert fww_tool_target("WalletPay", "{\"destination\":\"alice@openagents.com\",\"amount_sats\":500,\"reason\":\"coffee\"}", tb[..]) == "alice@openagents.com (500 sats) — coffee";
  #assert fww_tool_target("OpenAgentsCli", "{\"subcommand\":\"vault\",\"args\":[\"get\",\"api_key\"]}", tb[..]) == "vault get";
  #assert fww_tool_target("OpenAgentsCli", "{\"subcommand\":\"tasks\",\"args\":[\"list\",\"--json\"]}", tb[..]) == "tasks list";
  #assert fww_tool_target("GameBuilder", "{\"action\":\"build\",\"target\":\"scrappers-arena/level-1\"}", tb[..]) == "build scrappers-arena/level-1";
  #assert fww_tool_target("KnowledgeSearch", "{\"query\":\"episode 289\"}", tb[..]) == "episode 289";
  #assert fww_tool_target("KnowledgeGet", "{\"target\":\"docs.transcripts.289\"}", tb[..]) == "docs.transcripts.289";
  #assert fww_tool_target("CapabilityDraft", "{\"slug\":\"linear-tickets\",\"goal\":\"x\"}", tb[..]) == "linear-tickets";
  #assert fww_tool_target("CapabilityEval", "{\"slug\":\"linear-tickets\",\"pos_base\":\"exit 1\"}", tb[..]) == "linear-tickets";

  kw_b: [64] u8; kw_n := [1] int.[0];
  #assert fww_detect_missing_capability("turn my meeting notes into Linear tickets", kw_b[..], kw_n[..]) == "web_automation" && cast(string) kw_b[0..<kw_n[0]] == "linear";
  #assert fww_detect_missing_capability("post release notes to Slack", kw_b[..], kw_n[..]) == "messaging_integration" && cast(string) kw_b[0..<kw_n[0]] == "slack";
  #assert fww_detect_missing_capability("fix bug in policy.coax", kw_b[..], kw_n[..]) == "";

  packs_all := OA_PACK_COAX_INTEL | OA_PACK_WALLET | OA_PACK_CLI | OA_PACK_METAVERSE | OA_PACK_KNOWLEDGE | OA_PACK_CAPABILITY | OA_PACK_SESSIONS;
  mp_n := fww_build_gemini_body_packs(cfg[..], h_code[..], "high", full_sys, false, packs_all, b_code[..]);
  #assert mp_n > 0;
  mp_s := cast(string) b_code[0..<mp_n];
  #assert fww_contains_ci(mp_s, "WalletStatus") && fww_contains_ci(mp_s, "WalletPay");
  #assert fww_contains_ci(mp_s, "OpenAgentsCli") && fww_contains_ci(mp_s, "MetaverseRoute") && fww_contains_ci(mp_s, "GameBuilder");
  #assert fww_contains_ci(mp_s, "KnowledgeSearch") && fww_contains_ci(mp_s, "KnowledgeGet");
  #assert fww_contains_ci(mp_s, "CapabilityDraft") && fww_contains_ci(mp_s, "CapabilityEval") && fww_contains_ci(mp_s, "CapabilityList");
  #assert fww_contains_ci(mp_s, "session_list") && fww_contains_ci(mp_s, "session_read") && fww_contains_ci(mp_s, "session_send") && fww_contains_ci(mp_s, "session_spawn") && fww_contains_ci(mp_s, "session_stop");
  #assert fww_tool_target("session_send", "{\"session_id\":\"local:tmux:dev:0.0\",\"prompt\":\"ls\"}", tb[..]) == "local:tmux:dev:0.0";
  #assert fww_tool_target("session_spawn", "{\"title\":\"Tests\",\"prompt\":\"run\"}", tb[..]) == "Tests";
  s_out: [4096] u8; s_err := [1] bool.[false]; s_empty: [1] u8;
  sn_bad := fww_tool_session("session_send", "{\"session_id\":\"\",\"prompt\":\"hi\"}", s_out[..], s_err[..], s_empty[0..<0]);
  #assert s_err[0] && sn_bad > 0 && fww_contains_ci(cast(string) s_out[0..<sn_bad], "session_id");
  sn_bad2 := fww_tool_session("session_list", "{\"kind\":\"bogus\"}", s_out[..], s_err[..], s_empty[0..<0]);
  #assert s_err[0] && sn_bad2 > 0 && fww_contains_ci(cast(string) s_out[0..<sn_bad2], "kind");

  mr_out: [4096] u8;
  mr_err := [1] bool.[false];
  empty_w: [1] u8;
  mr_n := fww_tool_metaverse("/repo", "MetaverseRoute", "{\"path\":\"assets/robot.glb\"}", mr_out[..], mr_err[..], empty_w[0..<0]);
  #assert !mr_err[0] && mr_n > 0 && fww_contains_ci(cast(string) mr_out[0..<mr_n], "\"target_pane\":\"metaverse\"") && fww_contains_ci(cast(string) mr_out[0..<mr_n], "\"tab_kind\":\"model\"");
  mr_n2 := fww_tool_metaverse("/repo", "MetaverseRoute", "{\"path\":\"../../etc/passwd.glb\"}", mr_out[..], mr_err[..], empty_w[0..<0]);
  #assert !mr_err[0] && mr_n2 > 0 && fww_contains_ci(cast(string) mr_out[0..<mr_n2], "\"target_pane\":\"reject\"");

  cli_n := fww_tool_cli("/repo", "{\"subcommand\":\"rm\",\"args\":[\"-rf\",\"/\"]}", mr_out[..], mr_err[..], empty_w[0..<0]);
  #assert mr_err[0] && cli_n > 0 && fww_contains_ci(cast(string) mr_out[0..<cli_n], "allowlist");

  // OpenAgents Cloud (FLAWED_BE_OURS) retail pricing & $0 local Inkling enforcement (#14070)
  #assert fww_gw_name(FLAWED_BE_OURS) == "ours";
  #assert fww_turn_cost_micros(FLAWED_BE_LOCAL, "inkling-2-mini", 100000, 50000, 10000) == 0;
  #assert fww_turn_cost_micros(FLAWED_BE_LOCAL, "google/gemini-4-neon", 100000, 0, 10000) == 0;
  #assert fww_turn_cost_micros(FLAWED_BE_OURS, "inkling-2-mini", 100000, 0, 10000) == 0;
  #assert fww_turn_cost_micros(FLAWED_BE_OURS, "google/gemini-4-neon", 1000000, 500000, 100000) == 3843750;
  #assert fww_turn_cost_micros(FLAWED_BE_VERTEX, "google/gemini-4-neon", 1000000, 500000, 100000) == 3075000;
}

#test "flawedworker: mid-turn Vertex OAuth & OpenAgents Cloud auth refresh heals 401s and expiry" {
  // 1) Token staleness boundary checks (45-minute proactive TTL + clock-skew guard)
  #assert fww_vertex_token_stale(0, 1000, 1001);
  #assert fww_vertex_token_stale(32, 0, 1001);
  #assert !fww_vertex_token_stale(32, 1000, 1000 + FWW_VX_TTL_MS - 1);
  #assert fww_vertex_token_stale(32, 1000, 1000 + FWW_VX_TTL_MS);
  #assert fww_vertex_token_stale(32, 5000, 4999);

  // 2) Env VERTEX_ACCESS_TOKEN retirement rule: retires on forced 401 or TTL rollover when gcloud SA exists
  #assert fww_vertex_should_retire_env(true, true, true, 0);
  #assert fww_vertex_should_retire_env(true, true, false, 32);
  #assert !fww_vertex_should_retire_env(true, true, false, 0);
  #assert !fww_vertex_should_retire_env(false, true, true, 32);
  #assert !fww_vertex_should_retire_env(true, false, true, 32);

  // 3) Auth error detection catches HTTP 401 and Google's exact expired OAuth 2 error body
  google_401 := "Request had invalid authentication credentials. Expected OAuth 2 access token, login cookie or other valid authentication credential. See https://developers.google.com/identity/sign-in/web/devconsole-project.";
  #assert fww_is_auth_err(401, "");
  #assert fww_is_auth_err(200, google_401);
  #assert fww_is_auth_err(403, "UNAUTHENTICATED: token has expired");
  #assert fww_is_auth_err(500, "invalid_grant");
  #assert !fww_is_auth_err(503, "high demand, try again");
  #assert !fww_is_auth_err(200, "ok");

  // 4) Retry policy emits rebuild_client=true on 401 and honors per-step retry budget
  rs := [1] FlawedRetryState.[FlawedRetryState.{max_retries = 3}];
  d401 := flawed_eval_retry(rs[..], FlawedRetryInput.{status = 401, is_foreground = true, retry_after_ms = -1});
  #assert d401.action == FLAWED_RETRY_SLEEP && d401.rebuild_client;

  // 5) OpenAgents Cloud login.json access token parsing & reload policy
  tb: [256] u8;
  n1 := fww_parse_ours_login_json("{\"access\":\"oa_tok_refreshed_v2\",\"refresh\":\"r1\"}", tb[..]);
  #assert n1 > 0 && cast(string) tb[0..<n1] == "oa_tok_refreshed_v2";
  #assert fww_parse_ours_login_json("{\"refresh\":\"only\"}", tb[..]) == 0;
  #assert fww_parse_ours_login_json("not-json", tb[..]) == 0;
  #assert fww_ours_should_reload_login(false, 24, true, false);
  #assert fww_ours_should_reload_login(false, 24, false, true);
  #assert !fww_ours_should_reload_login(false, 24, false, false);
  #assert !fww_ours_should_reload_login(true, 24, true, true);
  #assert !fww_ours_should_reload_login(false, 0, true, true);
}

#test "flawedworker: subagent delegation (#14096) Agent tool pack, 5x parallel Explore batch, read-only guard, and TaskOutput/TaskStop" {
  // 1) Parent turn exposes OA_PACK_AGENTS tools unconditionally; child subagent suppresses them
  cfg: [1] FwConfig;
  h: [1] FwHist;
  fww_hist_push_user(h[..], "delegate to 5 subagents very simple readonly tasks and summarize at the end");
  body: [24576] u8;
  n_par := fww_build_gemini_body_packs(cfg[..], h[..], "high", "sys", false, OA_PACK_AGENTS, body[..]);
  #assert n_par > 0 && fww_contains_ci(cast(string) body[0..<n_par], "\"name\":\"Agent\"");
  #assert fww_contains_ci(cast(string) body[0..<n_par], "\"name\":\"SendMessage\"");
  #assert fww_contains_ci(cast(string) body[0..<n_par], "\"name\":\"TaskStop\"");
  #assert fww_contains_ci(cast(string) body[0..<n_par], "\"name\":\"EnterWorktree\"");

  sub_cfg: [1] FwConfig;
  sub_cfg[0].ndisallowed = fww_keep(sub_cfg[0].disallowed_tools[..], OA_EXPLORE_DISALLOWED);
  n_sub := fww_build_gemini_body_packs(sub_cfg[..], h[..], "low", "sys", false, 0, body[..]);
  #assert n_sub > 0 && !fww_contains_ci(cast(string) body[0..<n_sub], "\"name\":\"Edit\"");
  #assert !fww_contains_ci(cast(string) body[0..<n_sub], "\"name\":\"Write\"");
  #assert !fww_contains_ci(cast(string) body[0..<n_sub], "\"name\":\"Agent\"");
  #assert fww_contains_ci(cast(string) body[0..<n_sub], "\"name\":\"Read\"");

  // 3) Read-only subagent runtime denies Edit, Write, and mutating Bash even in BYPASS mode
  r: [1] FwRun;
  r[0].subagent_read_only = true;
  r[0].ncwd = fww_keep(r[0].cwd[..], "/tmp");
  r[0].acc[0].ntools = 2;
  r[0].acc[0].tools[0].nname = fww_keep(r[0].acc[0].tools[0].name[..], "Edit");
  r[0].acc[0].tools[0].nargs = fww_keep(r[0].acc[0].tools[0].args[..], "{\"file_path\":\"a.txt\",\"old_string\":\"a\",\"new_string\":\"b\"}");
  r[0].acc[0].tools[1].nname = fww_keep(r[0].acc[0].tools[1].name[..], "Bash");
  r[0].acc[0].tools[1].nargs = fww_keep(r[0].acc[0].tools[1].args[..], "{\"command\":\"echo hi > a.txt\"}");
  auth: [1] FwAuth;
  bufs: [1] FwBufs;
  wire_out: [4096] u8;
  #assert !fww_exec_tool_now(r[..], cfg[..], auth[..], h[..], bufs[..], 0, wire_out[..]);
  #assert r[0].acc[0].tools[0].done && r[0].acc[0].tools[0].is_error;
  #assert !fww_exec_tool_now(r[..], cfg[..], auth[..], h[..], bufs[..], 1, wire_out[..]);
  #assert r[0].acc[0].tools[1].done && r[0].acc[0].tools[1].is_error;

  // 4) TaskOutput lookup & status reporting on registered subagent
  r[0].nsubagents = 1;
  r[0].subagents[0] = FwSubagentRec.{active = true, running = false, host_num = 1};
  r[0].subagents[0].nagent_id = fww_keep(r[0].subagents[0].agent_id[..], "aexplore-0123456789abcdef");
  r[0].subagents[0].nlast_reply = fww_keep(r[0].subagents[0].last_reply[..], "5 files inspected");
  is_err := [1] bool.[false];
  ob: [1024] u8;
  on := fww_tool_task_output(r[..], "{\"task_id\":\"aexplore-0123456789abcdef\"}", ob[..], is_err[..]);
  #assert !is_err[0] && on > 0 && fww_contains_ci(cast(string) ob[0..<on], "5 files inspected");
}

#test "flawedworker: cache-exact FORK_AGENT context snapshot, recursion guard & standalone subprocess state (#14096)" {
  fh_parent: [1] FwHist;
  fww_hist_push_user(fh_parent[..], "Inspect the auth layer");
  fww_hist_push_assistant_text(fh_parent[..], "Found auth in openagents/core/wire.coax");
  sibs := [2] string.["tc_a", "tc_b"];
  fb1: [4096] u8; fb2: [4096] u8;
  rd1 := fww_format_fork_context_json(fh_parent[..], sibs[..], fb1[..]);
  rd2 := fww_format_fork_context_json(fh_parent[..], sibs[..], fb2[..]);
  // Both fork context payloads are byte-identical (exact prompt-cache prefix parity across parallel fork children)
  #assert rd1 > 0 && rd1 == rd2 && cast(string) fb1[0..<rd1] == cast(string) fb2[0..<rd2];
  // Hydrate child history from fork context JSON
  fh_child: [1] FwHist;
  #assert fww_apply_fork_context_json(fh_child[..], cast(string) fb1[0..<rd1]);
  #assert fh_child[0].nmsgs == 3;
  #assert fww_contains_ci(fww_hist_msg_text(fh_child[..], 2), OA_FORK_PLACEHOLDER_RESULT);
  // Compaction-resistant recursion guard blocks nested fork via either flag OR sentinel in history
  fr: [1] FwRun;
  #assert !fww_fork_guard_tripped(fr[..], fh_parent[..]);
  fr[0].is_fork_child = true;
  #assert fww_fork_guard_tripped(fr[..], fh_parent[..]);
  fr[0].is_fork_child = false;
  dir_b: [512] u8;
  dn_f := oa_agent_format_fork_directive("check wire.coax", dir_b[..]);
  fww_hist_push_user(fh_child[..], cast(string) dir_b[0..<dn_f]);
  #assert fww_fork_guard_tripped(fr[..], fh_child[..]);
  #assert !fww_has_active_local_subs(fr[..]);
}

#test "flawedworker: WebSearch cloud base URL precedence and Exa JSON formatter (#14113)" {
  ob: [256] u8;
  n1 := fww_websearch_cloud_base("https://a.example/", "https://b.example", "https://c.example", ob[..]);
  #assert cast(string) ob[0..<n1] == "https://a.example";
  n2 := fww_websearch_cloud_base("", "http://127.0.0.1:8787/", "https://c.example", ob[..]);
  #assert cast(string) ob[0..<n2] == "http://127.0.0.1:8787";
  n3 := fww_websearch_cloud_base("", "", "https://staging.openagents.com/", ob[..]);
  #assert cast(string) ob[0..<n3] == "https://staging.openagents.com";
  n4 := fww_websearch_cloud_base("", "", "", ob[..]);
  #assert cast(string) ob[0..<n4] == "https://openagents.com";

  // Verify highlights + summary fallback formatting
  sample := "{\"results\":[{\"title\":\"Exa Search Docs\",\"url\":\"https://docs.exa.ai/reference/search\",\"publishedDate\":\"2026-08-28\",\"author\":\"Exa\",\"highlights\":[\"POST /search supports includeDomains and excludeDomains.\"]},{\"title\":\"MCP Spec\",\"url\":\"https://modelcontextprotocol.io/specification\",\"summary\":\"Streamable HTTP transport.\"}]}";
  out_b: [4096] u8;
  fn := fww_websearch_format_results(sample, out_b[..]);
  out_s := cast(string) out_b[0..<fn];
  #assert fn > 0;
  #assert fww_contains_ci(out_s, "Title: Exa Search Docs");
  #assert fww_contains_ci(out_s, "URL: https://docs.exa.ai/reference/search");
  #assert fww_contains_ci(out_s, "includeDomains and excludeDomains");
  #assert fww_contains_ci(out_s, "Streamable HTTP transport.");

  // Verify WebFetch Exa /contents formatter (full text, highlights, and clean UTF-8 truncation)
  fetch_sample := "{\"results\":[{\"title\":\"Memory Paper\",\"url\":\"https://arxiv.org/pdf/2505.00675\",\"publishedDate\":\"2025-05-01\",\"author\":\"Du et al.\",\"text\":\"Six atomic operations: Consolidation, Updating, Indexing, Forgetting, Retrieval, and Condensation.\"}]}";
  wf_b: [2048] u8;
  wfn := fww_webfetch_format_result(fetch_sample, wf_b[..]);
  wfs := cast(string) wf_b[0..<wfn];
  #assert wfn > 0;
  #assert fww_contains_ci(wfs, "# Memory Paper");
  #assert fww_contains_ci(wfs, "Six atomic operations");

  // Verify truncation does not drop content when buffer is smaller than JSON text
  tiny_b: [120] u8;
  tn := fww_webfetch_format_result(fetch_sample, tiny_b[..]);
  #assert tn > 0 && tn <= tiny_b.count;
  #assert fww_contains_ci(cast(string) tiny_b[0..<tn], "Six atomic");

  // Verify highlights-based fetch response
  hl_sample := "{\"results\":[{\"title\":\"Memory Paper\",\"url\":\"https://arxiv.org/abs/2505.00675\",\"highlights\":[\"Parametric memory lives in weights.\",\"Contextual memory lives outside weights.\"]}]}";
  hfn := fww_webfetch_format_result(hl_sample, wf_b[..]);
  hfs := cast(string) wf_b[0..<hfn];
  #assert hfn > 0;
  #assert fww_contains_ci(hfs, "Parametric memory");
  #assert fww_contains_ci(hfs, "Contextual memory");
}

#test "flawedworker: paper-lab OA_EXP_COMPACT_PRESERVE (default-on) and OA_EXP_MEMTRACE live validation" {
  // 0. Verify default enables OA_EXP_COMPACT_PRESERVE (shipped from Compact-Bench 2610.31710).
  #assert FWW_DEFAULT_EXP_COMPACT_PRESERVE == true;

  // 1. Structured entity/state-preserving compaction retains deep identifiers past byte 220 and tool output tails.
  h: [1] FwHist;
  tmp: [65536] u8;
  long_req := "Please review the repository history carefully and prepare an upcoming maintenance update. There is plenty of background narrative here so that the exact critical identifiers sit well beyond byte 240 of this message: target commit 9f4c2b8e1a for ticket OA-7429 updating config/rate_limits.json with key BURST_QUOTA_V3 set to 4250.";
  fww_hist_push_user(h[..], long_req);
  fww_hist_push_assistant_text(h[..], "Acknowledged, inspecting workspace now.");
  // Add a ToolResult with 300 bytes of banner noise followed by a critical tail token
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  a0 := [1] int.[0];
  nm_n := fww_slab_put(h[..], "Bash", a0[..]); nm_at := a0[0];
  banner := "INFO step 1/5 initializing diagnostic pipeline... INFO step 2/5 loading schema... INFO step 3/5 checking codecs... INFO step 4/5 scanning inputs... INFO step 5/5 finalizing... RESULT: DIAG_TOKEN=DELTA-8841 in parser.py";
  tx_n := fww_slab_put(h[..], banner, a0[..]); tx_at := a0[0];
  h[0].msgs[2].blocks[0] = FwBlock.{kind = FWW_MB_TOOL_RES, name_at = nm_at, name_n = nm_n, text_at = tx_at, text_n = tx_n};
  h[0].nmsgs = 3;

  // Run with OA_EXP_COMPACT_PRESERVE enabled
  h[0].exp_compact_preserve = true;
  ok_p := fww_hist_compact_ex(h[..], -1, 0, 0, 0, 10240, tmp[..]);
  #assert ok_p && h[0].nmsgs == 1;
  s_p := fww_slab_str(h[..], h[0].msgs[0].blocks[0].text_at, h[0].msgs[0].blocks[0].text_n);
  #assert fww_contains_ci(s_p, "[Preserved Exact Identifiers & Paths]");
  #assert fww_contains_ci(s_p, "9f4c2b8e1a");
  #assert fww_contains_ci(s_p, "OA-7429");
  #assert fww_contains_ci(s_p, "config/rate_limits.json");
  #assert fww_contains_ci(s_p, "BURST_QUOTA_V3");
  #assert fww_contains_ci(s_p, "4250");
  #assert fww_contains_ci(s_p, "DIAG_TOKEN=DELTA-8841");

  // 2. MemTrace state-consistency validation (pure compile-time check of edit-epoch superseding & alignment)
  h2: [1] FwHist;
  h2[0].exp_memtrace = true;
  h2[0].trace_files[0] = FwTraceFile.{disk_hash = fww_trace_hash_bytes("MAX_RETRIES = 3\n"), exists_then = true, edited = false, seq = 1};
  h2[0].trace_files[0].npath = fww_keep(h2[0].trace_files[0].path[..], "config.py");
  h2[0].ntrace_files = 1;
  h2[0].trace_cmds[0] = FwTraceCmd.{exit_ok = true, seq = 2, edit_epoch = 0, repo_hash = 0};
  h2[0].trace_cmds[0].ncmd = fww_keep(h2[0].trace_cmds[0].cmd[..], "python3 -m unittest -q");
  h2[0].ntrace_cmds = 1;
  h2[0].trace_edit_epoch = 0;
  fww_hist_push_user(h2[..], "Check config.py and run tests.");
  fww_hist_push_assistant_text(h2[..], "Tests pass.");

  rep1: [4096] u8;
  rn1 := fww_emit_memtrace_report(h2[..], rep1[..], 0, 4096);
  rs1 := cast(string) rep1[0..<rn1];
  #assert fww_contains_ci(rs1, "FILE ALIGNED");
  #assert fww_contains_ci(rs1, "CMD VALID");

  // Simulate post-test edit incrementing edit_epoch before compaction
  h2[0].trace_files[0].edited = true;
  h2[0].trace_edit_epoch = 1;
  ok_m := fww_hist_compact_ex(h2[..], -1, 0, 0, 0, 10240, tmp[..]);
  #assert ok_m && h2[0].nmsgs == 1;
  s_m := fww_slab_str(h2[..], h2[0].msgs[0].blocks[0].text_at, h2[0].msgs[0].blocks[0].text_n);
  #assert fww_contains_ci(s_m, "FILE EDITED & ALIGNED ON DISK");
  #assert fww_contains_ci(s_m, "CMD SUPERSEDED / INVALIDATED");
  // 3. Verify Desktop skills-prefixed slash command unwrapping
  #assert fww_unwrap_slash_cmd("/compact all") == "/compact all";
  #assert fww_unwrap_slash_cmd("Skills installed on this computer.\n- foo: bar\n\nThe message:\n/compact all") == "/compact all";
  #assert fww_unwrap_slash_cmd("Skills installed on this computer.\n- foo: bar\n\nThe message:\n/clear") == "/clear";

  // 4. Verify Complexity Trap (2508.21433) epoch-aligned observation masking preserves recent M tool turns & extracts anchors.
  h3: [1] FwHist;
  h3[0].exp_obs_mask = true;
  fww_hist_push_user(h3[..], "Inspect four large logs.");
  big_obs: [5000] u8;
  bn := fww_cat(big_obs[..], 0, "HEADER ");
  while bn < 4500 { bn = fww_cat(big_obs[..], bn, "verbose noise line 000000000000000000000000000000\n"); }
  bn = fww_cat(big_obs[..], bn, "CRITICAL_KEY_V9=ALPHA-9921 in services/worker.py\n");
  big_s := cast(string) big_obs[0..<bn];
  for step: 0..<4 {
    fww_hist_push_assistant_text(h3[..], "Reading log.");
    mi := h3[0].nmsgs;
    h3[0].msgs[mi] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
    a1 := [1] int.[0];
    nm_n3 := fww_slab_put(h3[..], "Read", a1[..]); nm_at3 := a1[0];
    tx_n3 := fww_slab_put(h3[..], big_s, a1[..]); tx_at3 := a1[0];
    h3[0].msgs[mi].blocks[0] = FwBlock.{kind = FWW_MB_TOOL_RES, name_at = nm_at3, name_n = nm_n3, text_at = tx_at3, text_n = tx_n3};
    h3[0].nmsgs += 1;
  }
  // Local mode keeps M=2 recent tool turns and masks the older 2 (>4096 bytes) while preserving CRITICAL_KEY_V9=ALPHA-9921.
  did_mask := fww_obs_mask_epoch(h3[..], true);
  #assert did_mask;
  old_tr := fww_slab_str(h3[..], h3[0].msgs[2].blocks[0].text_at, h3[0].msgs[2].blocks[0].text_n);
  rec_tr := fww_slab_str(h3[..], h3[0].msgs[8].blocks[0].text_at, h3[0].msgs[8].blocks[0].text_n);
  #assert flawed_aw_starts(old_tr, "[Observation masked: Read, ");
  #assert fww_contains_ci(old_tr, "CRITICAL_KEY_V9=ALPHA-9921");
  #assert fww_contains_ci(old_tr, "services/worker.py");
  #assert rec_tr.count == big_s.count;
  // Calling again immediately is a no-op (cache-stable between epochs!).
  #assert !fww_obs_mask_epoch(h3[..], true);

  // 5. Verify PMCoder III-E Edit Integrity JSON check catches malformed JSON and passes valid JSON.
  #assert fww_edit_integrity_json_ok("{\"ok\": true, \"n\": 42}");
  #assert !fww_edit_integrity_json_ok("{\"ok\": true, \"n\": 42,}");
  #assert !fww_edit_integrity_json_ok("{\"unclosed\": [1, 2");

  // 6. Verify Context Has a Price (2611.22238) break-even masking rule R*c*B > (1-c)*S:
  // Local (c=100%): any positive removal pays.
  #assert fww_obs_mask_break_even(4096, 16384, 10, 100);
  // Cloud (c=10%): removing 4KB before a 20KB suffix over 10 remaining turns loses (10*10*64 < 90*313) -> MUST NOT MASK.
  #assert !fww_obs_mask_break_even(4096, 20000, 10, 10);
  // Cloud (c=10%): removing a huge 64KB block early before a 10KB suffix over 20 remaining turns pays -> MASKS.
  #assert fww_obs_mask_break_even(65536, 10240, 20, 10);

  // 7. Verify DepSync (2611.29242) extracts added fields & modified def names from Edit diffs.
  sym_b: [256] u8; st_a: [8] int; ln_a: [8] int;
  nsy := fww_dep_extract_symbols(
    "def build_node(name):\n  return Node(name=name)",
    "def build_node(name, null_policy=None):\n  return Node(name=name, null_policy=null_policy)",
    sym_b[..], st_a[..], ln_a[..], 6
  );
  #assert nsy >= 2;
  got_np := false; got_bn := false;
  for k: 0..<nsy {
    sy := cast(string) sym_b[st_a[k]..<st_a[k] + ln_a[k]];
    if sy == "null_policy" { got_np = true; }
    if sy == "build_node" { got_bn = true; }
  }
  #assert got_np && got_bn;

  // 8. Verify ToolPulse (2611.19275) error signature normalizes line numbers for Failure Inertia.
  s_err1 := fww_tp_err_sig("Bash", "Traceback:\n  File \"a.py\", line 14\nValueError: bad quota 42\n");
  s_err2 := fww_tp_err_sig("Bash", "Traceback:\n  File \"a.py\", line 29\nValueError: bad quota 99\n");
  s_err3 := fww_tp_err_sig("Bash", "Traceback:\n  File \"a.py\", line 29\nKeyError: missing_key\n");
  #assert s_err1 != 0 && s_err1 == s_err2 && s_err1 != s_err3;

  // 9. Verify FaithCheck (2611.25760 + 2611.27095) flags ungrounded test-pass & failed-edit claims, allows honest replies.
  f_out: [512] u8;
  // Claiming tests pass when last test failed -> flagged
  #assert fww_faith_check_reply("Done! All tests pass now.", true, true, false, false, "", f_out[..]) > 0;
  // Claiming tests pass after editing post-test -> flagged
  #assert fww_faith_check_reply("Updated billing.py and all tests pass.", true, true, true, true, "", f_out[..]) > 0;
  // Claiming tests pass when no test ran -> flagged
  #assert fww_faith_check_reply("All unit tests pass.", true, false, false, true, "", f_out[..]) > 0;
  // Claiming a file was updated when its last Edit failed -> flagged
  #assert fww_faith_check_reply("I updated pricing.py cleanly.", false, false, false, false, "src/pricing.py", f_out[..]) > 0;
  // Verified passing tests after edits -> clean (0)
  #assert fww_faith_check_reply("Updated pricing.py and all tests pass.", true, true, true, false, "", f_out[..]) == 0;
  // Honest report stating tests failed -> clean (0)
  #assert fww_faith_check_reply("Tests fail with AssertionError on line 12.", true, true, false, false, "", f_out[..]) == 0;
}

#test "flawedworker: trap-safe JSON string extraction and CoaxReplace never abort on missing/null/oversized fields" {
  nodes: [64] JvNode; d: [1] Jv;
  #assert jv_parse(d[..], "{\"ok\":\"hello\",\"nil\":null,\"num\":42,\"big\":\"0123456789abcdef\"}", nodes[..]);
  small: [8] u8;
  #assert fww_jv_str_safe(d[0], 0, "ok", small[..]) == "hello";
  #assert fww_jv_str_safe(d[0], 0, "missing", small[..]) == "";
  #assert fww_jv_str_safe(d[0], 0, "nil", small[..]) == "";
  #assert fww_jv_str_safe(d[0], 0, "num", small[..]) == "";
  #assert fww_jv_str_safe(d[0], 0, "big", small[..]) == "";

  // CoaxReplace argument parser must reject missing/null/numeric/oversized text cleanly instead of slicing -1 (coax_trap).
  a1: [64] u8; sb: [64] u8; tb: [8] u8;
  o1 := [1] int.[0]; os := [1] int.[0]; ot := [1] int.[0];
  #assert jv_parse(d[..], "{\"target\":\"foo\",\"seen\":\"abc\",\"text\":null}", nodes[..]);
  #assert !fww_coax_replace_parse(d[0], a1[..], sb[..], tb[..], o1[..], os[..], ot[..]);
  #assert jv_parse(d[..], "{\"target\":\"foo\",\"seen\":\"abc\",\"text\":123}", nodes[..]);
  #assert !fww_coax_replace_parse(d[0], a1[..], sb[..], tb[..], o1[..], os[..], ot[..]);
  #assert jv_parse(d[..], "{\"target\":\"foo\",\"seen\":\"abc\",\"text\":\"0123456789\"}", nodes[..]);
  #assert !fww_coax_replace_parse(d[0], a1[..], sb[..], tb[..], o1[..], os[..], ot[..]);
  #assert jv_parse(d[..], "{\"target\":\"foo\",\"seen\":\"abc\",\"text\":\"\"}", nodes[..]);
  #assert fww_coax_replace_parse(d[0], a1[..], sb[..], tb[..], o1[..], os[..], ot[..]) && ot[0] == 0;
  #assert jv_parse(d[..], "{\"target\":\"foo\",\"seen\":\"abc\",\"text\":\"hi\"}", nodes[..]);
  #assert fww_coax_replace_parse(d[0], a1[..], sb[..], tb[..], o1[..], os[..], ot[..]) && cast(string) tb[0..<ot[0]] == "hi";
}

#test "flawedworker: worktree cache invalidation, gitdir parent repo parsing, and NUL-safe buffer writes (#14121)" {
  // 1. fww_invalidate_cwd_caches clears git snapshot, query_dedup, and read_dedup atomically
  r: [1] FwRun;
  r[0].ngit_snap = fww_keep(r[0].git_snap[..], "Branch: main");
  r[0].ngit_snap_cwd = fww_keep(r[0].git_snap_cwd[..], "/repo/sub");
  r[0].query_dedup[0] = 111;
  r[0].query_dedup[3] = 222;
  r[0].query_dedup_cur = 4;
  r[0].read_dedup[0] = FwReadDedup.{path_hash = 42, offset = 1, end_line = 50, file_sz = 100, content_hash = 77};
  r[0].read_dedup_cur[0] = 1;
  fww_invalidate_cwd_caches(r[..]);
  #assert r[0].ngit_snap == 0 && r[0].ngit_snap_cwd == 0 && r[0].query_dedup_cur == 0 && r[0].read_dedup_cur[0] == 0;
  for qi: 0..<r[0].query_dedup.count { #assert r[0].query_dedup[qi] == 0; }
  for di: 0..<r[0].read_dedup.count { #assert r[0].read_dedup[di].path_hash == 0; }

  // 2. fww_wt_parent_repo_from_gitdir extracts canonical parent repo from linked worktree pointer file
  pb: [256] u8;
  #assert fww_wt_parent_repo_from_gitdir("gitdir: /Users/dev/work/openagents/.git/worktrees/agent-1\n", pb[..]) == "/Users/dev/work/openagents";
  #assert fww_wt_parent_repo_from_gitdir("gitdir: /repo/.git/worktrees/wt\r\n", pb[..]) == "/repo";
  #assert fww_wt_parent_repo_from_gitdir("not-a-gitdir", pb[..]) == "";
  #assert fww_wt_parent_repo_from_gitdir("gitdir: /repo/.git/modules/sub", pb[..]) == "";

  // 3. fww_keep_z NUL-terminates shorter overwrites so callers never read stale suffixes
  buf: [32] u8;
  _ = fww_keep_z(buf[..], "worktree-long-branch-name");
  n := fww_keep_z(buf[..], "worktree-a");
  #assert n == 10 && buf[10] == 0 && cast(string) buf[0..<n] == "worktree-a";

  // 4. Pure #authority integration check from oa-worker
  rel_b: [64] u8;
  rn := flawed_wt_rel_subdir("/repo", "/repo/apps/desktop", rel_b[..]);
  #assert rn == 12 && cast(string) rel_b[0..<rn] == "apps/desktop";
  #assert flawed_wt_include_matches(".env.local\n!*.bak\n../escape\n", ".env.local");
  #assert !flawed_wt_include_matches(".env.local\n!*.bak\n../escape\n", "../escape");
  #assert flawed_wt_stale_sweep_can_remove(flawed_wt_is_ephemeral_name("agent-1"), false, flawed_wt_is_older_than_cutoff(100, 100 + FLAWED_WT_STALE_MS, FLAWED_WT_STALE_MS), true, true);
}

#test "flawedworker: append-only DAG JSONL round-trip, crash-tail tolerance, branching, meta restore, eviction, and TaskOutput args (#14122)" #steps 200000000 {
  // 1. Build structured multi-turn FwHist (user, assistant[thinking+sig, tool_use+sig], tool_results[tool_result+is_error], assistant[text])
  h_src: [1] FwHist;
  fww_hist_push_user(h_src[..], "Audit auth");
  a0 := [1] int.[0];
  h_src[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 2};
  th := FwBlock.{kind = FWW_MB_THINK};
  th.text_n = fww_slab_put(h_src[..], "checking wire.coax", a0[..]); th.text_at = a0[0];
  th.sig_n = fww_slab_put(h_src[..], "SIG_THINK_1", a0[..]); th.sig_at = a0[0];
  tu := FwBlock.{kind = FWW_MB_TOOL_USE};
  tu.id_n = fww_slab_put(h_src[..], "call_42", a0[..]); tu.id_at = a0[0];
  tu.name_n = fww_slab_put(h_src[..], "Read", a0[..]); tu.name_at = a0[0];
  tu.text_n = fww_slab_put(h_src[..], "{\"file_path\":\"wire.coax\"}", a0[..]); tu.text_at = a0[0];
  tu.sig_n = fww_slab_put(h_src[..], "SIG_TU_42", a0[..]); tu.sig_at = a0[0];
  h_src[0].msgs[1].blocks[0] = th;
  h_src[0].msgs[1].blocks[1] = tu;
  h_src[0].nmsgs = 2;
  h_src[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  tr := FwBlock.{kind = FWW_MB_TOOL_RES, is_error = true};
  tr.id_n = fww_slab_put(h_src[..], "call_42", a0[..]); tr.id_at = a0[0];
  tr.name_n = fww_slab_put(h_src[..], "Read", a0[..]); tr.name_at = a0[0];
  tr.text_n = fww_slab_put(h_src[..], "ENOENT", a0[..]); tr.text_at = a0[0];
  h_src[0].msgs[2].blocks[0] = tr;
  h_src[0].nmsgs = 3;
  fww_hist_push_assistant_text(h_src[..], "File missing, checked fallback.");

  // Format all 4 turns + an abandoned branch (u_dead off u1) + a duplicate u2 + a truncated trailing crash line
  jsonl: [16384] u8;
  jn := 0;
  jn += fww_subagent_format_dag_line(h_src[0].msgs[0], h_src[..], "u1", "", "aexp-abc", "sess-1", 1000, jsonl[jn..<jsonl.count]);
  // Abandoned fork off u1 (must be skipped when reconstructing chain from leaf u4!)
  jn += fww_subagent_format_text_dag_line("assistant", "ABANDONED BRANCH", "u_dead", "u1", "aexp-abc", "sess-1", 1001, jsonl[jn..<jsonl.count]);
  jn += fww_subagent_format_dag_line(h_src[0].msgs[1], h_src[..], "u2", "u1", "aexp-abc", "sess-1", 1002, jsonl[jn..<jsonl.count]);
  // Duplicate u2 (must be deduplicated, keeping original)
  jn += fww_subagent_format_text_dag_line("assistant", "DUPLICATE", "u2", "u1", "aexp-abc", "sess-1", 1003, jsonl[jn..<jsonl.count]);
  jn += fww_subagent_format_dag_line(h_src[0].msgs[2], h_src[..], "u3", "u2", "aexp-abc", "sess-1", 1004, jsonl[jn..<jsonl.count]);
  jn += fww_subagent_format_dag_line(h_src[0].msgs[3], h_src[..], "u4", "u3", "aexp-abc", "sess-1", 1005, jsonl[jn..<jsonl.count]);
  // Truncated trailing line simulating mid-write crash
  jn = fww_cat(jsonl[..], jn, "{\"uuid\":\"u5\",\"parentUuid\":\"u4\",\"role\":\"user\",\"blocks\":[");

  raw_s := cast(string) jsonl[0..<jn];
  #assert fww_contains_ci(raw_s, "\"isSidechain\":true") && fww_contains_ci(raw_s, "\"parentUuid\":null") && fww_contains_ci(raw_s, "\"sessionId\":\"sess-1\"");
  #assert flawed_scan_jsonl_valid_lines(raw_s) == 6;

  // Hydrate into fresh FwHist -> must recover exact 4-message active chain [u1, u2, u3, u4], leaf == "u4", skipping abandoned branch & crash tail!
  h_dst: [1] FwHist;
  scratch: [8192] u8;
  leaf_b: [64] u8; leaf_n := [1] int.[0];
  hydrated := fww_subagent_parse_jsonl_to_hist(raw_s, h_dst[..], scratch[..], leaf_b[..], leaf_n[..]);
  #assert hydrated == 4 && cast(string) leaf_b[0..<leaf_n[0]] == "u4";
  #assert h_dst[0].msgs[0].role == FWW_MROLE_USER && fww_hist_msg_text(h_dst[..], 0) == "Audit auth";
  #assert h_dst[0].msgs[1].role == FWW_MROLE_ASSISTANT && h_dst[0].msgs[1].nblocks == 2;
  #assert h_dst[0].msgs[1].blocks[0].kind == FWW_MB_THINK && fww_slab_str(h_dst[..], h_dst[0].msgs[1].blocks[0].text_at, h_dst[0].msgs[1].blocks[0].text_n) == "checking wire.coax";
  #assert fww_slab_str(h_dst[..], h_dst[0].msgs[1].blocks[0].sig_at, h_dst[0].msgs[1].blocks[0].sig_n) == "SIG_THINK_1";
  #assert h_dst[0].msgs[1].blocks[1].kind == FWW_MB_TOOL_USE && fww_slab_str(h_dst[..], h_dst[0].msgs[1].blocks[1].id_at, h_dst[0].msgs[1].blocks[1].id_n) == "call_42";
  #assert fww_slab_str(h_dst[..], h_dst[0].msgs[1].blocks[1].name_at, h_dst[0].msgs[1].blocks[1].name_n) == "Read";
  #assert fww_slab_str(h_dst[..], h_dst[0].msgs[1].blocks[1].sig_at, h_dst[0].msgs[1].blocks[1].sig_n) == "SIG_TU_42";
  #assert h_dst[0].msgs[2].role == FWW_MROLE_TOOL_RESULTS && h_dst[0].msgs[2].blocks[0].kind == FWW_MB_TOOL_RES && h_dst[0].msgs[2].blocks[0].is_error;
  #assert fww_slab_str(h_dst[..], h_dst[0].msgs[2].blocks[0].text_at, h_dst[0].msgs[2].blocks[0].text_n) == "ENOENT";
  #assert h_dst[0].msgs[3].role == FWW_MROLE_ASSISTANT && fww_hist_msg_text(h_dst[..], 3) == "File missing, checked fallback.";

  // Lightweight tail scanner also extracts last assistant text & leaf uuid
  rep_b: [512] u8; rep_n := [1] int.[0];
  fww_subagent_scan_jsonl_tail(raw_s, rep_b[..], rep_n[..], leaf_b[..], leaf_n[..]);
  #assert cast(string) rep_b[0..<rep_n[0]] == "File missing, checked fallback." && cast(string) leaf_b[0..<leaf_n[0]] == "u4";

  // Legacy 2-line {"role","content"} JSONL still hydrates cleanly
  legacy := "{\"role\":\"user\",\"content\":\"old prompt\"}\n{\"role\":\"assistant\",\"content\":\"old answer\"}\n";
  #assert fww_subagent_parse_jsonl_to_hist(legacy, h_dst[..], scratch[..], leaf_b[..], leaf_n[..]) == 2;
  #assert fww_hist_msg_text(h_dst[..], 0) == "old prompt" && fww_hist_msg_text(h_dst[..], 1) == "old answer";

  // 2. Metadata JSON format/parse round-trip (all 12 fields!)
  m_in: [1] FwSubagentRec;
  m_in[0] = FwSubagentRec.{active = true, read_only = true, start_ms = 1732690800123};
  m_in[0].nagent_id = fww_keep(m_in[0].agent_id[..], "aexp-deadbeef00112233");
  m_in[0].nsubagent_type = fww_keep(m_in[0].subagent_type[..], "Explore");
  m_in[0].ndesc = fww_keep(m_in[0].desc[..], "Scan core");
  m_in[0].nname = fww_keep(m_in[0].name[..], "auditor");
  m_in[0].nwt_path = fww_keep(m_in[0].wt_path[..], "/tmp/wt/auditor");
  m_in[0].nwt_branch = fww_keep(m_in[0].wt_branch[..], "worktree-auditor");
  m_in[0].nperm_mode = fww_keep(m_in[0].perm_mode[..], "plan");
  m_in[0].ngit = fww_keep(m_in[0].git[..], "commit");
  m_in[0].nlevel = fww_keep(m_in[0].level[..], "inkling");
  mb: [2048] u8;
  mn := fww_subagent_format_meta_json(m_in[..], "sess-42", mb[..]);
  #assert mn > 0;
  m_out: [1] FwSubagentRec;
  #assert fww_subagent_parse_meta_json(cast(string) mb[0..<mn], "/h/.openagents/subagents/sess-42/agent-aexp-deadbeef00112233.jsonl", m_out[..]);
  #assert cast(string) m_out[0].agent_id[0..<m_out[0].nagent_id] == "aexp-deadbeef00112233";
  #assert cast(string) m_out[0].subagent_type[0..<m_out[0].nsubagent_type] == "Explore";
  #assert cast(string) m_out[0].name[0..<m_out[0].nname] == "auditor";
  #assert cast(string) m_out[0].wt_path[0..<m_out[0].nwt_path] == "/tmp/wt/auditor";
  #assert cast(string) m_out[0].wt_branch[0..<m_out[0].nwt_branch] == "worktree-auditor";
  #assert m_out[0].start_ms == 1732690800123 && m_out[0].read_only && m_out[0].one_shot;
  #assert cast(string) m_out[0].perm_mode[0..<m_out[0].nperm_mode] == "plan";
  #assert cast(string) m_out[0].git[0..<m_out[0].ngit] == "commit";
  #assert cast(string) m_out[0].level[0..<m_out[0].nlevel] == "inkling";
  #assert cast(string) m_out[0].session_id[0..<m_out[0].nsession_id] == "sess-42";

  // 3. 24-slot eviction picks oldest non-running slot (never evicting running slots when idle slots exist)
  r_ev: [1] FwRun;
  r_ev[0].nsubagents = FWW_MAX_SUBAGENT_RECS;
  for i: 0..<FWW_MAX_SUBAGENT_RECS {
    r_ev[0].subagents[i] = FwSubagentRec.{active = true, running = (i == 0), start_ms = 5000 + i * 10};
  }
  r_ev[0].subagents[0].start_ms = 1; // running and oldest -> MUST NOT be evicted!
  r_ev[0].subagents[17].start_ms = 100; // oldest non-running -> MUST be evicted!
  #assert fww_alloc_subagent_slot(r_ev[..]) == 17;

  // 4. TaskOutput argument parsing (default block=true -> 30000ms, block=false -> 0, timeout=0 -> 0, cap 120000ms)
  tid_b: [64] u8; tid_n := [1] int.[0]; w_ms := [1] int.[0];
  #assert !fww_parse_task_output_args("{}", tid_b[..], tid_n[..], w_ms[..]);
  #assert fww_parse_task_output_args("{\"task_id\":\"a1\"}", tid_b[..], tid_n[..], w_ms[..]) && cast(string) tid_b[0..<tid_n[0]] == "a1" && w_ms[0] == FLAWED_TASK_OUTPUT_DEFAULT_TIMEOUT_MS;
  #assert fww_parse_task_output_args("{\"task_id\":\"a1\",\"block\":false,\"timeout\":5000}", tid_b[..], tid_n[..], w_ms[..]) && w_ms[0] == 0;
  #assert fww_parse_task_output_args("{\"task_id\":\"a1\",\"block\":true,\"timeout\":0}", tid_b[..], tid_n[..], w_ms[..]) && w_ms[0] == 0;
  #assert fww_parse_task_output_args("{\"task_id\":\"a1\",\"block\":true,\"timeout\":2500}", tid_b[..], tid_n[..], w_ms[..]) && w_ms[0] == 2500;
  #assert fww_parse_task_output_args("{\"task_id\":\"a1\",\"block\":true,\"timeout\":999999}", tid_b[..], tid_n[..], w_ms[..]) && w_ms[0] == FLAWED_TASK_OUTPUT_MAX_TIMEOUT_MS;
}
