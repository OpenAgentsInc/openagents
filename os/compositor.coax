CX_CLIENTS :: 32; CX_OBJS :: 4096;   // live objects a client may hold (ids are reused lowest first)
CX_SURFS :: 512; CX_POOLS :: 256; CX_BUFS :: 1024; CX_POS :: 128; CX_DUE :: 1024;
CX_MAXW :: 3840; CX_MAXH :: 2160;
// What an object id names.
K_NONE :: 0; K_DISPLAY :: 1; K_REGISTRY :: 2; K_CALLBACK :: 3; K_COMPOSITOR :: 4; K_SUBCOMP :: 5; K_SHM :: 6; K_POOL :: 7;
K_BUFFER :: 8; K_SURFACE :: 9; K_REGION :: 10; K_SEAT :: 11; K_KEYBOARD :: 12; K_POINTER :: 13; K_OUTPUT :: 14;
K_WMBASE :: 15; K_XDGSURF :: 16; K_TOPLEVEL :: 17; K_POSITIONER :: 18; K_POPUP :: 19; K_SUBSURF :: 20; K_TOUCH :: 21; K_DDM :: 22; K_DSOURCE :: 23; K_DDEV :: 24; K_DECOMGR :: 25; K_DECO :: 26;
K_DMA :: 27; K_PARAMS :: 28; K_FEEDBACK :: 29;
CX_DMA_GLOBAL :: 24; CX_DMA_SERVER :: 4244635648;
// A surface's role.
R_NONE :: 0; R_TOPLEVEL :: 1; R_SUB :: 2; R_POPUP :: 3; R_CURSOR :: 4; R_X11 :: 5;   // R_X11: an Xwayland window's surface

CxObj :: struct { kind: int; ix: int; ver: int; }
CxClient :: struct {
  used: bool; h: int;
  objs: [CX_OBJS] CxObj;
  inb: [16384] u8; nin: int;
  fds: [32] int; nfd: int;
  kbds: [8] int; nk: int; ddevs: [8] int; nd: int;
  offers: [64] int; next_offer: int;   // server-made wl_data_offer k (id CX_SERVER_ID + k): its source, or -1
  ptrs: [8] int; npt: int; outs: [8] int; outsc: [8] int; no: int;   // outsc: the screen each bound output is
}
CxPool :: struct { used: bool; client: int; fd: int; map: int; size: int; dead: bool; refs: int; }
CxBuf :: struct { used: bool; client: int; id: int; pool: int; offset: int; w: int; h: int; stride: int; fmt: int; gpu: int; }
CxParams :: struct { live: bool; client: int; consumed: bool; plane: bool; fd: int; offset: int; stride: int; hi: int; lo: int; }
CxSurf :: struct {
  used: bool; client: int; id: int;
  cur: int; pend: int; pend_set: bool;
  pfr: [16] int; npfr: int;           // frame callbacks waiting for the commit
  role: int; xdg: int; top: int; popup: int; win: int; configured: bool; entered: bool; esc: int; xwin: int;   // esc: the screen whose outputs it entered
  parent: int; sx: int; sy: int;      // a subsurface's or popup's parent surface and place
  gx: int; gy: int; gw: int; gh: int; // the window geometry inside the surface
  cw: int; ch: int; cstate: int;      // the last size and states sent
  title: [128] u8; nt: int; app: [128] u8; na: int;
  noborder: bool; ruled: bool; nofull: bool;   // what a window rule set: no border, matched already, no fullscreen asked by the client
  aspect: f32;      // width over height a resize keeps (keep_aspect_ratio), or 0
}
// A clipboard source: the client offering it and the types it offers.
CxSource :: struct { used: bool; client: int; id: int; mimes: [8] [64] u8; ml: [8] int; nm: int; }
CX_SOURCES :: 64; CX_SERVER_ID :: 4278190080;   // 0xff000000: ids the server makes start here
CxPos :: struct { used: bool; w: int; h: int; ax: int; ay: int; aw: int; ah: int; anchor: int; gravity: int; dx: int; dy: int; }
CxDue :: struct { client: int; id: int; }
// The composited screen, RGB, with room for a PPM header in front.
CxFrame :: struct { b: [CX_MAXW * CX_MAXH * 3 + 64] u8; }
CxMsg :: struct { b: [16384] u8; n: int; start: int; op: int; }
// The X11 window manager's view of Xwayland (os/xwm.coax): each X window it heard of, the wl_surface
// Xwayland named for it (WL_SURFACE_ID), and the replies it waits for.
CX_XWINS :: 64;
CxXWin :: struct {
  used: bool; id: int; sid: int; s: int; ovr: bool; mapped: bool; win: int;
  x: int; y: int; w: int; h: int;            // where an override-redirect window put itself
  sx: int; sy: int; sw: int; sh: int;        // the last place sent to a managed one
  title: [128] u8; nt: int; net_title: bool; cls: [128] u8; nc: int;
}
CxXGet :: struct { seq: int; win: int; atom: int; }
XW_ATOMS :: 6;   // WL_SURFACE_ID, WM_PROTOCOLS, WM_DELETE_WINDOW, _NET_WM_NAME, UTF8_STRING, WM_S0
CxXw :: struct {
  on: bool; up: bool; client: int; root: int; display: int; own: int; comp_seq: int;   // own: the window manager's window; comp_seq: the Composite query
  inb: [65536] u8; nin: int; o: [1] XOut;
  atoms: [XW_ATOMS] int; atom_seq: [XW_ATOMS] int;
  gets: [64] CxXGet;
  seen: [40] int; err: int; err_op: int;   // events heard by code, and the last error with its request
  wins: [CX_XWINS] CxXWin;
}
Cx :: struct {
  w: int; h: int;
  clients: [CX_CLIENTS] CxClient;
  pools: [CX_POOLS] CxPool; bufs: [CX_BUFS] CxBuf; surfs: [CX_SURFS] CxSurf; pos: [CX_POS] CxPos;
  win_surf: [WM_WINS] int;
  due: [CX_DUE] CxDue; ndue: int;
  serial: int; kfocus: int; pfocus: int; px: int; py: int;
  wm: [1] Wm;
  g: [1] CxMsg;
  row: [65536] u8;
  keymap: [131072] u8; nkeymap: int;
  line: [8192] u8; nline: int;
  held: [256] bool; swallowed: [256] bool;   // keys down, and presses a binding took
  sock: [256] u8; nsock: int; launch: [512] u8; nlaunch: int;
  sources: [CX_SOURCES] CxSource; sel: int;   // the selection: a source, or -1
  cursor: int; hot_x: int; hot_y: int;   // the pointer image a client set (a surface), or -1 for the arrow
  asking: int; armed: int; armed_until: int;   // Super+W: the window being asked about, the one a notice armed
  drag: int; drag_left: bool; drag_top: bool;   // Super + a held mouse button: 272 moves a float, 273 resizes
  dmg: [4] int; prev: [4] int; clip: [4] int;   // what changed since the last frame, the frame before's, the box being drawn
  rules: [1] CxRules;
  xw: [1] CxXw;
  quit: bool; dirty: bool; screen: bool; show_pointer: bool;
  desk_on: bool; desks: [CX_DESKS] CxDesk;   // --desk-socket: the desk protocol's clients
  ngpu: int; params: [256] CxParams;
}
CX_DESKS :: 8;
CxDesk :: struct { on: bool; buf: [8192] u8; n: int; }

cx_say :: (s: string) { b: [8192] u8; n := 0; for c: s { if n < 8190 { b[n] = c; n += 1; } } b[n] = '\n'; x := cxwl_out(b[0..<n + 1]); }
cx_rd :: (b: [] u8, at: int) -> int { return cast(int) b[at] | (cast(int) b[at + 1] << 8) | (cast(int) b[at + 2] << 16) | (cast(int) b[at + 3] << 24); }
cx_rdi :: (b: [] u8, at: int) -> int { v := cx_rd(b, at); return ifx v >= 2147483648 then v - 4294967296 else v; }
cx_min :: (a: int, b: int) -> int { return ifx a < b then a else b; }
cx_max :: (a: int, b: int) -> int { return ifx a > b then a else b; }

// ---- outgoing messages: begin, arguments, end; then flush to one client

mg_put :: (g: [] CxMsg, v: int) {
  if g[0].n + 4 > 16384 { return; }
  for i: 0..<4 { g[0].b[g[0].n + i] = cast,trunc(u8) ((v >> (8 * i)) & 255); }
  g[0].n += 4;
}
mg_begin :: (g: [] CxMsg, obj: int, op: int) { g[0].start = g[0].n; g[0].op = op; mg_put(g, obj); mg_put(g, 0); }
mg_end :: (g: [] CxMsg) {
  size := g[0].n - g[0].start; v := (size << 16) | g[0].op;
  for i: 0..<4 { g[0].b[g[0].start + 4 + i] = cast,trunc(u8) ((v >> (8 * i)) & 255); }
}
mg_str :: (g: [] CxMsg, s: string) {
  mg_put(g, s.count + 1);
  for c: s { if g[0].n < 16384 { g[0].b[g[0].n] = c; g[0].n += 1; } }
  pad := (4 - (s.count + 1) % 4) % 4;
  for i: 0..<pad + 1 { if g[0].n < 16384 { g[0].b[g[0].n] = 0; g[0].n += 1; } }
}
mg_flush :: (x: [] Cx, ci: int, fd: int) {
  if x[0].g[0].n > 0 && x[0].clients[ci].used { r := cxwl_send(x[0].clients[ci].h, x[0].g[0].b[0..<x[0].g[0].n], fd); }
  x[0].g[0].n = 0;
}
cx_serial :: (x: [] Cx) -> int { x[0].serial += 1; return x[0].serial; }
// The object id leaves the client's table, and the client hears it may reuse it.
cx_delete :: (x: [] Cx, ci: int, id: int) {
  if id <= 0 || id >= CX_OBJS { return; }
  x[0].clients[ci].objs[id].kind = K_NONE;
  g := x[0].g[..]; mg_begin(g, 1, 1); mg_put(g, id); mg_end(g); mg_flush(x, ci, -1);
}

// ---- the window policy's view: every toplevel configured to its rectangle, focus to the keyboard

cx_px :: (x: [] Cx, v: f32, full: int) -> int { return cast(int) floor(cast(f64) v * cast(f64) full); }
cx_send_configure :: (x: [] Cx, s: int, w: int, h: int, state: int) {
  ci := x[0].surfs[s].client; g := x[0].g[..]; top := x[0].surfs[s].top;
  ver := x[0].clients[ci].objs[top].ver;
  mg_begin(g, top, 0); mg_put(g, w); mg_put(g, h);
  n := 0; for b: 0..<9 { if (state >> b) & 1 == 1 && (b < 5 || ver >= 2) { n += 1; } }
  mg_put(g, n * 4); for b: 0..<9 { if (state >> b) & 1 == 1 && (b < 5 || ver >= 2) { mg_put(g, b); } }
  mg_end(g);
  mg_begin(g, x[0].surfs[s].xdg, 0); mg_put(g, cx_serial(x)); mg_end(g);
  // wl_surface.enter for the outputs of the screen it shows on, and leave for the one it left
  sc := cx_screen_of(x, wm_desk_of(x[0].wm[..], x[0].surfs[s].win));
  if !x[0].surfs[s].entered || x[0].surfs[s].esc != sc {
    for i: 0..<x[0].clients[ci].no {
      if x[0].surfs[s].entered && x[0].clients[ci].outsc[i] == x[0].surfs[s].esc { mg_begin(g, x[0].surfs[s].id, 1); mg_put(g, x[0].clients[ci].outs[i]); mg_end(g); }
      if x[0].clients[ci].outsc[i] == sc { mg_begin(g, x[0].surfs[s].id, 0); mg_put(g, x[0].clients[ci].outs[i]); mg_end(g); }
    }
    x[0].surfs[s].entered = true; x[0].surfs[s].esc = sc;
  }
  mg_flush(x, ci, -1);
  x[0].surfs[s].cw = w; x[0].surfs[s].ch = h; x[0].surfs[s].cstate = state; x[0].surfs[s].configured = true;
}
cx_keyboards :: (x: [] Cx, s: int, enter: bool) {
  if s < 0 || !x[0].surfs[s].used { return; }
  ci := x[0].surfs[s].client; g := x[0].g[..];
  for i: 0..<x[0].clients[ci].nk {
    k := x[0].clients[ci].kbds[i];
    if enter {
      mg_begin(g, k, 1); mg_put(g, cx_serial(x)); mg_put(g, x[0].surfs[s].id); mg_put(g, 0); mg_end(g);
      mg_begin(g, k, 4); mg_put(g, cx_serial(x)); mg_put(g, 0); mg_put(g, 0); mg_put(g, 0); mg_put(g, 0); mg_end(g);
    } else { mg_begin(g, k, 2); mg_put(g, cx_serial(x)); mg_put(g, x[0].surfs[s].id); mg_end(g); }
  }
  mg_flush(x, ci, -1);
}
cx_sync :: (x: [] Cx) {
  m := x[0].wm[..];
  t: [WM_WINS] WmTile; n := wm_all_windows(m, t[..]);
  focus := wm_focus(m);
  for i: 0..<n {
    s := x[0].win_surf[t[i].id]; if s < 0 { continue; }
    fr: [4] int; cx_frame(x, t[i], wm_is_fullscreen(m, t[i].id), fr[..]); w := fr[2]; h := fr[3];
    state := 0;
    if t[i].id == focus { state |= 1 << 4; }
    if wm_is_fullscreen(m, t[i].id) { state |= 1 << 2; }
    if !t[i].floating { state |= (1 << 5) | (1 << 6) | (1 << 7) | (1 << 8); }
    if x[0].surfs[s].role == R_X11 { if x[0].surfs[s].xwin >= 0 { cx_xw_place(x, x[0].surfs[s].xwin, fr[..]); } continue; }
    if !x[0].surfs[s].configured || x[0].surfs[s].cw != w || x[0].surfs[s].ch != h || x[0].surfs[s].cstate != state { cx_send_configure(x, s, w, h, state); cx_damage_all(x); }
  }
  k := ifx focus != 0 then x[0].win_surf[focus] else -1;
  if k != x[0].kfocus {
    cx_damage_all(x); cx_keyboards(x, x[0].kfocus, false); x[0].kfocus = k; cx_keyboards(x, k, true); if k >= 0 { cx_offer_selection(x, x[0].surfs[k].client); }
    if k >= 0 && x[0].surfs[k].role == R_X11 && x[0].surfs[k].xwin >= 0 { xw_focus(x[0].xw[0].o[..], x[0].xw[0].wins[x[0].surfs[k].xwin].id); cx_xw_flush(x); }
  }
}
// Where window id sits on the screen, in pixels; false when its desk is not shown.
// A tile's window rectangle in pixels, as the CoderOS Hyprland session draws it (general: gaps_in 3,
// gaps_out 6, border_size 1): 6 from a screen edge, 3 from a neighbour, then a 1-pixel border inside
// that. A fullscreen or monocle window takes the whole tile; a float keeps only its border.
CX_GAP_IN :: 3; CX_GAP_OUT :: 6; CX_BORDER :: 1;
// The screen showing desk (1..9), or the focused screen when none shows it.
cx_screen_of :: (x: [] Cx, desk: int) -> int {
  m := x[0].wm[..];
  if desk >= 1 && desk <= 9 { for i: 0..<m[0].ns { if m[0].screens[i].desk == desk - 1 { return i; } } }
  return m[0].screen;
}
// The screen under a point of the whole picture, or -1.
cx_screen_at :: (x: [] Cx, px: int, py: int) -> int {
  m := x[0].wm[..];
  for i: 0..<m[0].ns { c := m[0].screens[i]; if px >= c.x && py >= c.y && px < c.x + c.w && py < c.y + c.h { return i; } }
  return -1;
}
cx_frame :: (x: [] Cx, t: WmTile, full: bool, out: [] int) {
  s := ifx t.id > 0 && t.id < WM_WINS then x[0].win_surf[t.id] else -1;
  bare := full || (s >= 0 && x[0].surfs[s].noborder);
  c := x[0].wm[0].screens[cx_screen_of(x, t.desk)];
  x0 := c.x + cx_px(x, t.rect.x, c.w); y0 := c.y + cx_px(x, t.rect.y, c.h);
  x1 := c.x + cx_px(x, t.rect.x + t.rect.w, c.w); y1 := c.y + cx_px(x, t.rect.y + t.rect.h, c.h);
  if !full {
    if !t.floating {
      x0 += ifx x0 <= c.x then CX_GAP_OUT else CX_GAP_IN; y0 += ifx y0 <= c.y then CX_GAP_OUT else CX_GAP_IN;
      x1 -= ifx x1 >= c.x + c.w then CX_GAP_OUT else CX_GAP_IN; y1 -= ifx y1 >= c.y + c.h then CX_GAP_OUT else CX_GAP_IN;
    }
    if !bare { x0 += CX_BORDER; y0 += CX_BORDER; x1 -= CX_BORDER; y1 -= CX_BORDER; }
  }
  out[0] = x0; out[1] = y0; out[2] = cx_max(x1 - x0, 1); out[3] = cx_max(y1 - y0, 1);
}
cx_place :: (x: [] Cx, id: int, out: [] int) -> bool {
  m := x[0].wm[..];
  for sc: 0..<m[0].ns {
    t: [WM_WINS] WmTile; n := wm_tiles_on(m, sc, t[..]);
    for i: 0..<n {
      if t[i].id != id { continue; }
      t[i].desk = m[0].screens[sc].desk + 1;
      cx_frame(x, t[i], wm_is_fullscreen(m, id), out);
      return true;
    }
  }
  return false;
}

// ---- objects

cx_new_surf :: (x: [] Cx, ci: int, id: int) -> int {
  for i: 0..<CX_SURFS { if !x[0].surfs[i].used { x[0].surfs[i] = CxSurf.{used = true, client = ci, id = id, cur = -1, pend = -1, parent = -1, xwin = -1}; return i; } }
  return -1;
}
cx_release :: (x: [] Cx, b: int) {
  if b < 0 || !x[0].bufs[b].used { return; }
  g := x[0].g[..]; mg_begin(g, x[0].bufs[b].id, 0); mg_end(g); mg_flush(x, x[0].bufs[b].client, -1);
}
cx_pool_drop :: (x: [] Cx, p: int) {
  if p < 0 || !x[0].pools[p].used || !x[0].pools[p].dead || x[0].pools[p].refs > 0 { return; }
  r := cxwl_unmap(x[0].pools[p].map); r = cxwl_close_fd(x[0].pools[p].fd); x[0].pools[p].used = false;
}
cx_buf_free :: (x: [] Cx, b: int) {
  for s: 0..<CX_SURFS { if x[0].surfs[s].used { if x[0].surfs[s].cur == b { x[0].surfs[s].cur = -1; } if x[0].surfs[s].pend == b { x[0].surfs[s].pend = -1; } } }
  p := x[0].bufs[b].pool; x[0].bufs[b].used = false;
  if p < 0 { r := cxgpu_drop(x[0].bufs[b].gpu); return; }
  x[0].pools[p].refs -= 1; cx_pool_drop(x, p);
}
// A toplevel leaves the window policy.
cx_unmap :: (x: [] Cx, s: int) {
  w := x[0].surfs[s].win;
  if w != 0 { wm_close(x[0].wm[..], w); x[0].win_surf[w] = -1; x[0].surfs[s].win = 0; }
  if x[0].kfocus == s { x[0].kfocus = -1; }
  if x[0].pfocus == s { x[0].pfocus = -1; }
  x[0].surfs[s].role = R_NONE; x[0].surfs[s].configured = false;
  cx_damage_all(x); cx_sync(x);
}
cx_surf_free :: (x: [] Cx, s: int) {
  if x[0].surfs[s].xwin >= 0 { i := x[0].surfs[s].xwin; if x[0].xw[0].wins[i].s == s { x[0].xw[0].wins[i].s = -1; x[0].xw[0].wins[i].win = 0; x[0].xw[0].wins[i].sw = 0; } x[0].surfs[s].xwin = -1; }
  if x[0].surfs[s].win != 0 { cx_unmap(x, s); }
  for i: 0..<CX_SURFS { if x[0].surfs[i].used && x[0].surfs[i].parent == s { x[0].surfs[i].parent = -1; } }
  if x[0].kfocus == s { x[0].kfocus = -1; }
  if x[0].pfocus == s { x[0].pfocus = -1; }
  if x[0].cursor == s { x[0].cursor = -1; }
  x[0].surfs[s].used = false;
}
cx_drop_client :: (x: [] Cx, ci: int) {
  for s: 0..<CX_SURFS { if x[0].surfs[s].used && x[0].surfs[s].client == ci { cx_surf_free(x, s); } }
  for b: 0..<CX_BUFS { if x[0].bufs[b].used && x[0].bufs[b].client == ci { p := x[0].bufs[b].pool; if p >= 0 { x[0].pools[p].dead = true; } cx_buf_free(x, b); } }
  for p: 0..<256 { if x[0].params[p].live && x[0].params[p].client == ci { if x[0].params[p].fd >= 0 { r := cxwl_close_fd(x[0].params[p].fd); } x[0].params[p].live = false; } }
  for p: 0..<CX_POOLS { if x[0].pools[p].used && x[0].pools[p].client == ci { x[0].pools[p].dead = true; x[0].pools[p].refs = 0; cx_pool_drop(x, p); } }
  k := 0; for i: 0..<x[0].ndue { if x[0].due[i].client != ci { x[0].due[k] = x[0].due[i]; k += 1; } } x[0].ndue = k;
  for i: 0..<x[0].clients[ci].nfd { r := cxwl_close_fd(x[0].clients[ci].fds[i]); }
  for q: 0..<CX_SOURCES { if x[0].sources[q].used && x[0].sources[q].client == ci { x[0].sources[q].used = false; if x[0].sel == q { x[0].sel = -1; } } }
  r := cxwl_hangup(x[0].clients[ci].h); x[0].clients[ci].used = false;
  cx_sync(x);
}
// Takes the client's next descriptor, the one an fd argument names.
cx_take_fd :: (x: [] Cx, ci: int) -> int {
  if x[0].clients[ci].nfd == 0 { return -1; }
  fd := x[0].clients[ci].fds[0];
  for i: 0..<x[0].clients[ci].nfd - 1 { x[0].clients[ci].fds[i] = x[0].clients[ci].fds[i + 1]; }
  x[0].clients[ci].nfd -= 1;
  return fd;
}
cx_set :: (x: [] Cx, ci: int, id: int, kind: int, ix: int, ver: int) -> bool {
  if id <= 0 || id >= CX_OBJS { return false; }
  x[0].clients[ci].objs[id] = CxObj.{kind = kind, ix = ix, ver = ver};
  return true;
}
cx_globals :: (i: int) -> string {
  if i == CX_DMA_GLOBAL { return "zwp_linux_dmabuf_v1"; }
  if i > 8 { return "wl_output"; }
  if i == 1 { return "wl_compositor"; } if i == 2 { return "wl_subcompositor"; } if i == 3 { return "wl_shm"; }
  if i == 4 { return "wl_seat"; } if i == 5 { return "wl_output"; } if i == 6 { return "xdg_wm_base"; }
  if i == 7 { return "wl_data_device_manager"; } if i == 8 { return "zxdg_decoration_manager_v1"; }
  return "";
}
cx_global_ver :: (i: int) -> int { if i == CX_DMA_GLOBAL { return 4; } if i > 8 { return 3; } if i == 1 { return 4; } if i == 7 { return 3; } if i == 4 { return 5; } if i == 5 { return 3; } if i == 6 { return 2; } return 1; }
// Globals past 8 are the outputs of screens 2 and on; 5 is the first screen's.
cx_globals_n :: (x: [] Cx) -> int { return 8 + x[0].wm[0].ns - 1; }
cx_output_screen :: (name: int) -> int { return ifx name == 5 then 0 else name - 8; }
cx_global_kind :: (i: int) -> int { if i == CX_DMA_GLOBAL { return K_DMA; } if i > 8 { return K_OUTPUT; } if i == 1 { return K_COMPOSITOR; } if i == 2 { return K_SUBCOMP; } if i == 3 { return K_SHM; } if i == 4 { return K_SEAT; } if i == 5 { return K_OUTPUT; } if i == 7 { return K_DDM; } if i == 8 { return K_DECOMGR; } return K_WMBASE; }
// A popup's place relative to its parent's window geometry (xdg_positioner, without constraints).
cx_popup_place :: (p: CxPos, out: [] int) {
  a := p.anchor; gr := p.gravity;
  ax := ifx a == 3 || a == 5 || a == 6 then p.ax else ifx a == 4 || a == 7 || a == 8 then p.ax + p.aw else p.ax + p.aw / 2;
  ay := ifx a == 1 || a == 5 || a == 7 then p.ay else ifx a == 2 || a == 6 || a == 8 then p.ay + p.ah else p.ay + p.ah / 2;
  out[0] = (ifx gr == 3 || gr == 5 || gr == 6 then ax - p.w else ifx gr == 4 || gr == 7 || gr == 8 then ax else ax - p.w / 2) + p.dx;
  out[1] = (ifx gr == 1 || gr == 5 || gr == 7 then ay - p.h else ifx gr == 2 || gr == 6 || gr == 8 then ay else ay - p.h / 2) + p.dy;
}

// One request from client ci to object obj.
cx_request :: (x: [] Cx, ci: int, obj: int, op: int, a: [] u8) {
  if obj >= CX_DMA_SERVER && obj < CX_DMA_SERVER + CX_BUFS {
    b := obj - CX_DMA_SERVER;
    if op == 0 && x[0].bufs[b].used && x[0].bufs[b].client == ci && x[0].bufs[b].id == obj { cx_buf_free(x, b); }
    return;
  }
  if obj >= CX_SERVER_ID && obj < CX_SERVER_ID + 64 { cx_offer_request(x, ci, obj - CX_SERVER_ID, op, a); return; }
  if obj <= 0 || obj >= CX_OBJS { return; }
  o := x[0].clients[ci].objs[obj]; g := x[0].g[..];
  k := o.kind; at := 8;
  // what a request can change on screen: a new layout or a window going draws everything again
  if k == K_SUBSURF || k == K_TOPLEVEL || k == K_POPUP || k == K_BUFFER || k == K_DECO || (k == K_XDGSURF && op != 4) || (k == K_SURFACE && op == 0) { cx_damage_all(x); }
  if k == K_DISPLAY {
    if op == 0 { cb := cx_rd(a, at); mg_begin(g, cb, 0); mg_put(g, cxwl_ms() & 4294967295); mg_end(g); mg_flush(x, ci, -1); cx_delete(x, ci, cb); }
    else if op == 1 {
      reg := cx_rd(a, at); r := cx_set(x, ci, reg, K_REGISTRY, 0, 1);
      for i: 1..<cx_globals_n(x) + 1 { mg_begin(g, reg, 0); mg_put(g, i); mg_str(g, cx_globals(i)); mg_put(g, cx_global_ver(i)); mg_end(g); }
      if x[0].ngpu > 0 { mg_begin(g, reg, 0); mg_put(g, CX_DMA_GLOBAL); mg_str(g, cx_globals(CX_DMA_GLOBAL)); mg_put(g, 4); mg_end(g); }
      mg_flush(x, ci, -1);
    }
  } else if k == K_REGISTRY && op == 0 {
    name := cx_rd(a, at); sl := cx_rd(a, at + 4); at += 8 + sl + (4 - sl % 4) % 4;
    ver := cx_min(cx_rd(a, at), cx_global_ver(name)); id := cx_rd(a, at + 4);
    if name < 1 || (name > cx_globals_n(x) && !(name == CX_DMA_GLOBAL && x[0].ngpu > 0)) { return; }
    kind := cx_global_kind(name);
    if !cx_set(x, ci, id, kind, 0, ver) { return; }
    if kind == K_DMA {
      if ver < 4 { for i: 0..<x[0].ngpu {
        fmt := cxgpu_format(i, 0);
        mg_begin(g, id, 0); mg_put(g, fmt); mg_end(g);
        if ver >= 3 { mg_begin(g, id, 1); mg_put(g, fmt); mg_put(g, cxgpu_format(i, 1)); mg_put(g, cxgpu_format(i, 2)); mg_end(g); }
      } }
    }
    else if kind == K_SHM { mg_begin(g, id, 0); mg_put(g, 0); mg_end(g); mg_begin(g, id, 0); mg_put(g, 1); mg_end(g); }
    else if kind == K_SEAT { mg_begin(g, id, 0); mg_put(g, 3); mg_end(g); if ver >= 2 { mg_begin(g, id, 1); mg_str(g, "seat0"); mg_end(g); } }
    else if kind == K_OUTPUT {
      sc := cx_output_screen(name); c := x[0].wm[0].screens[sc];
      mg_begin(g, id, 0); mg_put(g, c.x); mg_put(g, c.y); mg_put(g, 0); mg_put(g, 0); mg_put(g, 0); mg_str(g, "Coax"); mg_str(g, cast(string) c.name[0..<c.nn]); mg_put(g, 0); mg_end(g);
      mg_begin(g, id, 1); mg_put(g, 3); mg_put(g, c.w); mg_put(g, c.h); mg_put(g, 60000); mg_end(g);
      if ver >= 2 { mg_begin(g, id, 3); mg_put(g, 1); mg_end(g); mg_begin(g, id, 2); mg_end(g); }
      if x[0].clients[ci].no < 8 { x[0].clients[ci].outs[x[0].clients[ci].no] = id; x[0].clients[ci].outsc[x[0].clients[ci].no] = sc; x[0].clients[ci].no += 1; }
    }
    mg_flush(x, ci, -1);
  } else if k == K_DMA {
    if op == 0 { cx_delete(x, ci, obj); }
    else if op == 1 && a.count == 12 {
      for p: 0..<256 { if !x[0].params[p].live {
        if cx_set(x, ci, cx_rd(a, 8), K_PARAMS, p, o.ver) { x[0].params[p] = CxParams.{live = true, client = ci, fd = -1}; }
        return;
      } }
      cx_dma_error(x, ci, obj, "DMA-BUF params exhausted");
    } else if (op == 2 && a.count == 12) || (op == 3 && a.count == 16) {
      id := cx_rd(a, 8);
      if op == 3 { so := cx_rd(a, 12); if so <= 0 || so >= CX_OBJS || x[0].clients[ci].objs[so].kind != K_SURFACE { cx_dma_error(x, ci, obj, "unknown feedback surface"); return; } }
      if cx_set(x, ci, id, K_FEEDBACK, 0, 1) { cx_dma_feedback(x, ci, id); }
    } else { cx_dma_error(x, ci, obj, "invalid DMA-BUF request"); }
  } else if k == K_FEEDBACK {
    if op == 0 { cx_delete(x, ci, obj); }
  } else if k == K_PARAMS {
    cx_dma_params(x, ci, obj, op, a);
  } else if k == K_COMPOSITOR {
    if op == 0 { id := cx_rd(a, at); s := cx_new_surf(x, ci, id); if s >= 0 { r := cx_set(x, ci, id, K_SURFACE, s, o.ver); } }
    else if op == 1 { r := cx_set(x, ci, cx_rd(a, at), K_REGION, 0, o.ver); }
    else if op == 2 { cx_delete(x, ci, obj); }
  } else if k == K_REGION || k == K_CALLBACK || k == K_TOUCH {
    if op == 0 { cx_delete(x, ci, obj); }
  } else if k == K_SUBCOMP {
    if op == 0 { cx_delete(x, ci, obj); }
    else if op == 1 {
      id := cx_rd(a, at); so := x[0].clients[ci].objs[cx_rd(a, at + 4) % CX_OBJS]; po := x[0].clients[ci].objs[cx_rd(a, at + 8) % CX_OBJS];
      if so.kind != K_SURFACE || po.kind != K_SURFACE { return; }
      x[0].surfs[so.ix].role = R_SUB; x[0].surfs[so.ix].parent = po.ix; x[0].surfs[so.ix].sx = 0; x[0].surfs[so.ix].sy = 0;
      r := cx_set(x, ci, id, K_SUBSURF, so.ix, 1);
    }
  } else if k == K_SUBSURF {
    if op == 0 { x[0].surfs[o.ix].role = R_NONE; x[0].surfs[o.ix].parent = -1; cx_delete(x, ci, obj); }
    else if op == 1 { x[0].surfs[o.ix].sx = cx_rdi(a, at); x[0].surfs[o.ix].sy = cx_rdi(a, at + 4); }
  } else if k == K_SHM {
    if op == 0 {
      id := cx_rd(a, at); size := cx_rdi(a, at + 4); fd := cx_take_fd(x, ci);
      m := cxwl_map(fd, size);
      if m < 0 { r := cxwl_close_fd(fd); return; }
      for p: 0..<CX_POOLS { if !x[0].pools[p].used { x[0].pools[p] = CxPool.{used = true, client = ci, fd = fd, map = m, size = size}; r := cx_set(x, ci, id, K_POOL, p, 1); return; } }
      r := cxwl_unmap(m); r = cxwl_close_fd(fd);
    } else if op == 1 { cx_delete(x, ci, obj); }
  } else if k == K_POOL {
    p := o.ix;
    if op == 0 {
      id := cx_rd(a, at);
      for b: 0..<CX_BUFS {
        if !x[0].bufs[b].used {
          x[0].bufs[b] = CxBuf.{used = true, client = ci, id = id, pool = p, offset = cx_rdi(a, at + 4), w = cx_rdi(a, at + 8), h = cx_rdi(a, at + 12), stride = cx_rdi(a, at + 16), fmt = cx_rd(a, at + 20)};
          x[0].pools[p].refs += 1; r := cx_set(x, ci, id, K_BUFFER, b, 1); return;
        }
      }
    } else if op == 1 { x[0].pools[p].dead = true; cx_pool_drop(x, p); cx_delete(x, ci, obj); }
    else if op == 2 { size := cx_rdi(a, at); if cxwl_remap(x[0].pools[p].map, x[0].pools[p].fd, size) == 0 { x[0].pools[p].size = size; } }
  } else if k == K_BUFFER {
    if op == 0 { cx_buf_free(x, o.ix); cx_delete(x, ci, obj); }
  } else if k == K_SURFACE {
    s := o.ix;
    if op == 0 { cx_surf_free(x, s); cx_delete(x, ci, obj); }
    else if op == 1 {
      bo := cx_rd(a, at); b := -1;
      if bo > 0 && bo < CX_OBJS && x[0].clients[ci].objs[bo].kind == K_BUFFER { b = x[0].clients[ci].objs[bo].ix; }
      if bo >= CX_DMA_SERVER && bo < CX_DMA_SERVER + CX_BUFS { bb := bo - CX_DMA_SERVER; if x[0].bufs[bb].used && x[0].bufs[bb].client == ci && x[0].bufs[bb].id == bo { b = bb; } }
      x[0].surfs[s].pend = b; x[0].surfs[s].pend_set = true;
    } else if op == 3 {
      cb := cx_rd(a, at); r := cx_set(x, ci, cb, K_CALLBACK, 0, 1);
      if x[0].surfs[s].npfr < 16 { x[0].surfs[s].pfr[x[0].surfs[s].npfr] = cb; x[0].surfs[s].npfr += 1; }
    } else if op == 6 {
      if x[0].surfs[s].pend_set {
        old := x[0].surfs[s].cur; x[0].surfs[s].cur = x[0].surfs[s].pend; x[0].surfs[s].pend_set = false;
        if old >= 0 && old != x[0].surfs[s].cur { cx_release(x, old); }
      }
      if (x[0].surfs[s].role == R_TOPLEVEL || x[0].surfs[s].role == R_X11) && x[0].surfs[s].win != 0 { cx_damage_window(x, x[0].surfs[s].win); }
      else if x[0].surfs[s].role == R_CURSOR { cx_damage_pointer(x); }
      else { cx_damage_all(x); }   // subsurfaces and popups can reach past their window
      for i: 0..<x[0].surfs[s].npfr { if x[0].ndue < CX_DUE { x[0].due[x[0].ndue] = CxDue.{client = ci, id = x[0].surfs[s].pfr[i]}; x[0].ndue += 1; } }
      x[0].surfs[s].npfr = 0;
      if x[0].surfs[s].role == R_TOPLEVEL && x[0].surfs[s].win == 0 {
        w := wm_spawn(x[0].wm[..]); x[0].surfs[s].win = w; x[0].win_surf[w] = s;
        cx_rules(x, s, w);
        cx_sync(x);
      }
    }
  } else if k == K_SEAT {
    if op == 0 { id := cx_rd(a, at); if cx_set(x, ci, id, K_POINTER, 0, o.ver) && x[0].clients[ci].npt < 8 { x[0].clients[ci].ptrs[x[0].clients[ci].npt] = id; x[0].clients[ci].npt += 1; } }
    else if op == 1 {
      id := cx_rd(a, at);
      if !cx_set(x, ci, id, K_KEYBOARD, 0, o.ver) { return; }
      if x[0].clients[ci].nk < 8 { x[0].clients[ci].kbds[x[0].clients[ci].nk] = id; x[0].clients[ci].nk += 1; }
      fd := cxwl_memfd(x[0].keymap[0..<x[0].nkeymap + 1]);
      mg_begin(g, id, 0); mg_put(g, 1); mg_put(g, x[0].nkeymap + 1); mg_end(g); mg_flush(x, ci, fd);
      if fd >= 0 { r := cxwl_close_fd(fd); }
      if o.ver >= 4 { mg_begin(g, id, 5); mg_put(g, 25); mg_put(g, 600); mg_end(g); mg_flush(x, ci, -1); }
      if x[0].kfocus >= 0 && x[0].surfs[x[0].kfocus].client == ci {
        mg_begin(g, id, 1); mg_put(g, cx_serial(x)); mg_put(g, x[0].surfs[x[0].kfocus].id); mg_put(g, 0); mg_end(g);
        mg_begin(g, id, 4); mg_put(g, cx_serial(x)); mg_put(g, 0); mg_put(g, 0); mg_put(g, 0); mg_put(g, 0); mg_end(g); mg_flush(x, ci, -1);
      }
    } else if op == 2 { r := cx_set(x, ci, cx_rd(a, at), K_TOUCH, 0, o.ver); }
    else if op == 3 { cx_delete(x, ci, obj); }
  } else if k == K_KEYBOARD {
    if op == 0 { cx_unlist(x[0].clients[ci].kbds[..], x[0].clients[ci].nk, obj); x[0].clients[ci].nk = cx_count_left(x[0].clients[ci].kbds[..], x[0].clients[ci].nk); cx_delete(x, ci, obj); }
  } else if k == K_POINTER {
    if op == 0 {   // set_cursor: only the client under the pointer may
      so := cx_rd(a, at + 4);
      if x[0].pfocus < 0 || x[0].surfs[x[0].pfocus].client != ci { return; }
      if so > 0 && so < CX_OBJS && x[0].clients[ci].objs[so].kind == K_SURFACE {
        c := x[0].clients[ci].objs[so].ix; x[0].surfs[c].role = R_CURSOR;
        x[0].cursor = c; x[0].hot_x = cx_rdi(a, at + 8); x[0].hot_y = cx_rdi(a, at + 12);
      } else { x[0].cursor = -2; }   // a null surface hides the pointer
      cx_damage_pointer(x);
    }
    if op == 1 { cx_unlist(x[0].clients[ci].ptrs[..], x[0].clients[ci].npt, obj); x[0].clients[ci].npt = cx_count_left(x[0].clients[ci].ptrs[..], x[0].clients[ci].npt); cx_delete(x, ci, obj); }
  } else if k == K_OUTPUT {
    if op == 0 {   // release: forget it, keeping each output's screen beside it
      kept := 0;
      for i: 0..<x[0].clients[ci].no { if x[0].clients[ci].outs[i] != obj { x[0].clients[ci].outs[kept] = x[0].clients[ci].outs[i]; x[0].clients[ci].outsc[kept] = x[0].clients[ci].outsc[i]; kept += 1; } }
      x[0].clients[ci].no = kept; cx_delete(x, ci, obj);
    }
  } else if k == K_WMBASE {
    if op == 0 { cx_delete(x, ci, obj); }
    else if op == 1 { for p: 0..<CX_POS { if !x[0].pos[p].used { x[0].pos[p] = CxPos.{used = true}; r := cx_set(x, ci, cx_rd(a, at), K_POSITIONER, p, o.ver); return; } } }
    else if op == 2 {
      id := cx_rd(a, at); so := x[0].clients[ci].objs[cx_rd(a, at + 4) % CX_OBJS];
      if so.kind != K_SURFACE { return; }
      x[0].surfs[so.ix].xdg = id; r := cx_set(x, ci, id, K_XDGSURF, so.ix, o.ver);
    }
  } else if k == K_XDGSURF {
    s := o.ix;
    if op == 0 { cx_delete(x, ci, obj); }
    else if op == 1 { id := cx_rd(a, at); x[0].surfs[s].role = R_TOPLEVEL; x[0].surfs[s].top = id; r := cx_set(x, ci, id, K_TOPLEVEL, s, o.ver); }
    else if op == 2 {
      id := cx_rd(a, at); par := cx_rd(a, at + 4); po := x[0].clients[ci].objs[cx_rd(a, at + 8) % CX_OBJS];
      x[0].surfs[s].role = R_POPUP; x[0].surfs[s].popup = id; x[0].surfs[s].parent = -1;
      if par > 0 && par < CX_OBJS && x[0].clients[ci].objs[par].kind == K_XDGSURF { x[0].surfs[s].parent = x[0].clients[ci].objs[par].ix; }
      r := cx_set(x, ci, id, K_POPUP, s, o.ver);
      if po.kind != K_POSITIONER { return; }
      pl: [2] int; cx_popup_place(x[0].pos[po.ix], pl[..]);
      x[0].surfs[s].sx = pl[0]; x[0].surfs[s].sy = pl[1];
      mg_begin(g, id, 0); mg_put(g, pl[0]); mg_put(g, pl[1]); mg_put(g, x[0].pos[po.ix].w); mg_put(g, x[0].pos[po.ix].h); mg_end(g);
      mg_begin(g, obj, 0); mg_put(g, cx_serial(x)); mg_end(g); mg_flush(x, ci, -1);
    } else if op == 3 { x[0].surfs[s].gx = cx_rdi(a, at); x[0].surfs[s].gy = cx_rdi(a, at + 4); x[0].surfs[s].gw = cx_rdi(a, at + 8); x[0].surfs[s].gh = cx_rdi(a, at + 12); }
  } else if k == K_TOPLEVEL {
    s := o.ix;
    if op == 0 { cx_unmap(x, s); cx_delete(x, ci, obj); }
    else if op == 2 || op == 3 {
      sl := cx_rd(a, at); n := cx_min(cx_max(sl - 1, 0), 127);
      for i: 0..<n { if op == 2 { x[0].surfs[s].title[i] = a[at + 4 + i]; } else { x[0].surfs[s].app[i] = a[at + 4 + i]; } }
      if op == 2 { x[0].surfs[s].nt = n; } else { x[0].surfs[s].na = n; }
      if x[0].surfs[s].win != 0 && !x[0].surfs[s].ruled { cx_rules(x, s, x[0].surfs[s].win); cx_sync(x); }   // a title or app id set after mapping
    } else if op == 11 || op == 12 {
      w := x[0].surfs[s].win; m := x[0].wm[..];
      if w != 0 && !x[0].surfs[s].nofull && wm_focus(m) == w && wm_is_fullscreen(m, w) != (op == 11) { wm_fullscreen(m); cx_sync(x); }
    }
  } else if k == K_POSITIONER {
    p := o.ix;
    if op == 0 { x[0].pos[p].used = false; cx_delete(x, ci, obj); }
    else if op == 1 { x[0].pos[p].w = cx_rdi(a, at); x[0].pos[p].h = cx_rdi(a, at + 4); }
    else if op == 2 { x[0].pos[p].ax = cx_rdi(a, at); x[0].pos[p].ay = cx_rdi(a, at + 4); x[0].pos[p].aw = cx_rdi(a, at + 8); x[0].pos[p].ah = cx_rdi(a, at + 12); }
    else if op == 3 { x[0].pos[p].anchor = cx_rd(a, at); }
    else if op == 4 { x[0].pos[p].gravity = cx_rd(a, at); }
    else if op == 6 { x[0].pos[p].dx = cx_rdi(a, at); x[0].pos[p].dy = cx_rdi(a, at + 4); }
  } else if k == K_DECOMGR {   // the compositor draws every window's border, so clients draw no title bar
    if op == 0 { cx_delete(x, ci, obj); }
    else if op == 1 {
      id := cx_rd(a, at); to := x[0].clients[ci].objs[cx_rd(a, at + 4) % CX_OBJS];
      if to.kind != K_TOPLEVEL { return; }
      r := cx_set(x, ci, id, K_DECO, to.ix, 1);
      mg_begin(g, id, 0); mg_put(g, 2); mg_end(g); mg_flush(x, ci, -1);
      if x[0].surfs[to.ix].configured { x[0].surfs[to.ix].cstate = -1; cx_sync(x); }   // the mode takes effect at the next configure
    }
  } else if k == K_DECO {
    if op == 0 { cx_delete(x, ci, obj); }
    else if op == 1 || op == 2 { mg_begin(g, obj, 0); mg_put(g, 2); mg_end(g); mg_flush(x, ci, -1); if x[0].surfs[o.ix].configured { x[0].surfs[o.ix].cstate = -1; cx_sync(x); } }
  } else if k == K_DDM {   // the clipboard: one selection, offered to the client with the keyboard
    if op == 0 {
      id := cx_rd(a, at);
      for q: 0..<CX_SOURCES { if !x[0].sources[q].used { x[0].sources[q].used = true; x[0].sources[q].client = ci; x[0].sources[q].id = id; x[0].sources[q].nm = 0; r := cx_set(x, ci, id, K_DSOURCE, q, o.ver); return; } }
    }
    else if op == 1 { id := cx_rd(a, at); if cx_set(x, ci, id, K_DDEV, 0, o.ver) && x[0].clients[ci].nd < 8 { x[0].clients[ci].ddevs[x[0].clients[ci].nd] = id; x[0].clients[ci].nd += 1; } }
    else if op == 2 { cx_delete(x, ci, obj); }
  } else if k == K_DSOURCE {
    q := o.ix;
    if op == 0 {
      sl := cx_rd(a, at); n := cx_min(cx_max(sl - 1, 0), 63); j := x[0].sources[q].nm;
      if j < 8 { for i: 0..<n { x[0].sources[q].mimes[j][i] = a[at + 4 + i]; } x[0].sources[q].ml[j] = n; x[0].sources[q].nm += 1; }
    } else if op == 1 {
      x[0].sources[q].used = false; cx_delete(x, ci, obj);
      if x[0].sel == q { x[0].sel = -1; if x[0].kfocus >= 0 { cx_offer_selection(x, x[0].surfs[x[0].kfocus].client); } }
    }
  } else if k == K_DDEV {
    if op == 1 {
      so := cx_rd(a, at); q := -1;
      if so > 0 && so < CX_OBJS && x[0].clients[ci].objs[so].kind == K_DSOURCE { q = x[0].clients[ci].objs[so].ix; }
      if q != x[0].sel && x[0].sel >= 0 { old := x[0].sources[x[0].sel]; mg_begin(g, old.id, 2); mg_end(g); mg_flush(x, old.client, -1); }   // cancelled
      x[0].sel = q;
      if x[0].kfocus >= 0 { cx_offer_selection(x, x[0].surfs[x[0].kfocus].client); }
    }
    else if op == 2 { cx_unlist(x[0].clients[ci].ddevs[..], x[0].clients[ci].nd, obj); x[0].clients[ci].nd = cx_count_left(x[0].clients[ci].ddevs[..], x[0].clients[ci].nd); cx_delete(x, ci, obj); }
  } else if k == K_POPUP {
    if op == 0 { x[0].surfs[o.ix].role = R_NONE; x[0].surfs[o.ix].parent = -1; cx_delete(x, ci, obj); }
  }
}
// The selection, as a new wl_data_offer on each of client ci's data devices (or none).
cx_offer_selection :: (x: [] Cx, ci: int) {
  if ci < 0 || !x[0].clients[ci].used { return; }
  g := x[0].g[..]; q := x[0].sel;
  for d: 0..<x[0].clients[ci].nd {
    dev := x[0].clients[ci].ddevs[d];
    if q < 0 || !x[0].sources[q].used { mg_begin(g, dev, 5); mg_put(g, 0); mg_end(g); continue; }
    k := x[0].clients[ci].next_offer % 64; x[0].clients[ci].next_offer += 1;
    x[0].clients[ci].offers[k] = q; id := CX_SERVER_ID + k;
    mg_begin(g, dev, 0); mg_put(g, id); mg_end(g);
    for j: 0..<x[0].sources[q].nm { mg_begin(g, id, 0); mg_str(g, cast(string) x[0].sources[q].mimes[j][0..<x[0].sources[q].ml[j]]); mg_end(g); }
    mg_begin(g, dev, 5); mg_put(g, id); mg_end(g);
  }
  mg_flush(x, ci, -1);
}
// A request to offer k: receive hands the reader's pipe to the source's client, which writes the data.
cx_offer_request :: (x: [] Cx, ci: int, k: int, op: int, a: [] u8) {
  if op == 1 {
    fd := cx_take_fd(x, ci); q := x[0].clients[ci].offers[k];
    if fd < 0 { return; }
    if q >= 0 && q < CX_SOURCES && x[0].sources[q].used {
      sl := cx_rd(a, 8); n := cx_min(cx_max(sl - 1, 0), 255); mime: [256] u8; for i: 0..<n { mime[i] = a[12 + i]; }
      g := x[0].g[..]; mg_begin(g, x[0].sources[q].id, 1); mg_str(g, cast(string) mime[0..<n]); mg_end(g); mg_flush(x, x[0].sources[q].client, fd);
    }
    r := cxwl_close_fd(fd);
  } else if op == 2 { x[0].clients[ci].offers[k] = -1; }   // a server-made id: no delete_id
}
cx_unlist :: (l: [] int, n: int, id: int) { for i: 0..<n { if l[i] == id { l[i] = 0; } } }
cx_count_left :: (l: [] int, n: int) -> int { k := 0; for i: 0..<n { if l[i] != 0 { l[k] = l[i]; k += 1; } } return k; }

// Reads what client ci sent and answers every whole request; false when it went away.
cx_read_client :: (x: [] Cx, ci: int) -> bool {
  while true {
    n := x[0].clients[ci].nin;
    got := cxwl_recv(x[0].clients[ci].h, x[0].clients[ci].inb[n..<16384]);
    for i: 0..<cxwl_fd_count() {
      fd := cxwl_fd(i);
      if x[0].clients[ci].nfd < 32 { x[0].clients[ci].fds[x[0].clients[ci].nfd] = fd; x[0].clients[ci].nfd += 1; } else { r := cxwl_close_fd(fd); }
    }
    if got < 0 { return false; }
    if got == 0 { return true; }
    x[0].clients[ci].nin += got;
    at := 0;
    while x[0].clients[ci].nin - at >= 8 {
      obj := cx_rd(x[0].clients[ci].inb[..], at); w := cx_rd(x[0].clients[ci].inb[..], at + 4);
      size := w >> 16; op := w & 65535;
      if size < 8 || size % 4 != 0 { return false; }
      if x[0].clients[ci].nin - at < size { break; }
      msg: [65536] u8; for i: 0..<size { msg[i] = x[0].clients[ci].inb[at + i]; }
      cx_request(x, ci, obj, op, msg[0..<size]);
      if !x[0].clients[ci].used { return false; }
      at += size;
    }
    rest := x[0].clients[ci].nin - at;
    for i: 0..<rest { x[0].clients[ci].inb[i] = x[0].clients[ci].inb[at + i]; }
    x[0].clients[ci].nin = rest;
  }
  return true;
}

// ---- drawing

cx_draw_surf :: (x: [] Cx, o: [] CxFrame, s: int, ox: int, oy: int, ax0: int, ay0: int, ax1: int, ay1: int) {
  cx0 := cx_max(ax0, x[0].clip[0]); cy0 := cx_max(ay0, x[0].clip[1]); cx1 := cx_min(ax1, x[0].clip[2]); cy1 := cx_min(ay1, x[0].clip[3]);
  b := x[0].surfs[s].cur;
  if b >= 0 && x[0].bufs[b].used {
    bf := x[0].bufs[b]; p: CxPool;
    if bf.pool >= 0 { p = x[0].pools[bf.pool]; }
    rowbytes := cx_min(bf.w * 4, 65536);
    // one size check for the whole buffer, then plain row copies; a buffer past its pool is not drawn
    whole := ifx bf.pool < 0 then cxgpu_capture(bf.gpu) == 0 else bf.h > 0 && bf.offset >= 0 && cxwl_fits(p.map, p.fd, bf.offset + (bf.h - 1) * bf.stride + bf.w * 4) == 1;
    rows := ifx whole then bf.h else 0;   // its subsurfaces and popups are still drawn
    for r: 0..<rows {
      dy := oy + r; if dy < cy0 || dy >= cy1 { continue; }
      c0 := cx_max(0, cx0 - ox); c1 := cx_min(bf.w, cx1 - ox);   // the columns that land inside the clip
      if c1 <= c0 { continue; }
      got := ifx bf.pool < 0 then cxgpu_read(bf.gpu, (r * bf.w + c0) * 4, x[0].row[0..<4 * (c1 - c0)]) else cxwl_read(p.map, -1, bf.offset + r * bf.stride + 4 * c0, x[0].row[0..<cx_min(4 * (c1 - c0), rowbytes)]);
      at := 3 * (dy * x[0].w + ox + c0);
      opaque := bf.fmt == 1;
      for c: 0..<got / 4 {
        q := 4 * c;
        ri := ifx bf.pool < 0 then q else q + 2; bi := ifx bf.pool < 0 then q + 2 else q;
        bb := cast(int) x[0].row[bi]; gg := cast(int) x[0].row[q + 1]; rr := cast(int) x[0].row[ri]; aa := ifx opaque then 255 else cast(int) x[0].row[q + 3];
        if aa == 255 { o[0].b[at] = x[0].row[ri]; o[0].b[at + 1] = x[0].row[q + 1]; o[0].b[at + 2] = x[0].row[bi]; }
        else if aa != 0 || rr + gg + bb != 0 {   // premultiplied: src + dst * (1 - alpha)
          k := 255 - aa;
          o[0].b[at] = cast,trunc(u8) cx_min(rr + cast(int) o[0].b[at] * k / 255, 255);
          o[0].b[at + 1] = cast,trunc(u8) cx_min(gg + cast(int) o[0].b[at + 1] * k / 255, 255);
          o[0].b[at + 2] = cast,trunc(u8) cx_min(bb + cast(int) o[0].b[at + 2] * k / 255, 255);
        }
        at += 3;
      }
    }
  }
  for i: 0..<CX_SURFS {   // subsurfaces over it, then its popups (placed from its window geometry)
    if !x[0].surfs[i].used || x[0].surfs[i].parent != s { continue; }
    if x[0].surfs[i].role == R_SUB { cx_draw_surf(x, o, i, ox + x[0].surfs[i].sx, oy + x[0].surfs[i].sy, cx0, cy0, cx1, cy1); }
  }
  for i: 0..<CX_SURFS {
    if !x[0].surfs[i].used || x[0].surfs[i].parent != s || x[0].surfs[i].role != R_POPUP { continue; }
    cx_draw_surf(x, o, i, ox + x[0].surfs[s].gx + x[0].surfs[i].sx - x[0].surfs[i].gx, oy + x[0].surfs[s].gy + x[0].surfs[i].sy - x[0].surfs[i].gy, 0, 0, x[0].w, x[0].h);
  }
}
// Damage: the box of the screen that has to be drawn again (x0, y0, x1, y1; empty when x1 <= x0).
cx_damage :: (x: [] Cx, x0: int, y0: int, x1: int, y1: int) {
  a := cx_max(x0, 0); b := cx_max(y0, 0); c := cx_min(x1, x[0].w); d := cx_min(y1, x[0].h);
  if c <= a || d <= b { return; }
  if x[0].dmg[2] <= x[0].dmg[0] { x[0].dmg[0] = a; x[0].dmg[1] = b; x[0].dmg[2] = c; x[0].dmg[3] = d; }
  else { x[0].dmg[0] = cx_min(x[0].dmg[0], a); x[0].dmg[1] = cx_min(x[0].dmg[1], b); x[0].dmg[2] = cx_max(x[0].dmg[2], c); x[0].dmg[3] = cx_max(x[0].dmg[3], d); }
  x[0].dirty = true;
}
cx_damage_all :: (x: [] Cx) { cx_damage(x, 0, 0, x[0].w, x[0].h); }
CX_POINTER_BOX :: 96;   // room for a client's cursor image around its hotspot
cx_damage_pointer :: (x: [] Cx) { if x[0].show_pointer { cx_damage(x, x[0].px - CX_POINTER_BOX, x[0].py - CX_POINTER_BOX, x[0].px + CX_POINTER_BOX, x[0].py + CX_POINTER_BOX); } }
// A window's box on the screen, border included, when its desk is shown.
cx_damage_window :: (x: [] Cx, w: int) {
  r: [4] int; if w != 0 && cx_place(x, w, r[..]) { cx_damage(x, r[0] - CX_BORDER, r[1] - CX_BORDER, r[0] + r[2] + CX_BORDER, r[1] + r[3] + CX_BORDER); }
}
cx_dot :: (x: [] Cx, o: [] CxFrame, px: int, py: int, v: u8) {
  if px < x[0].clip[0] || py < x[0].clip[1] || px >= x[0].clip[2] || py >= x[0].clip[3] { return; }
  at := 3 * (py * x[0].w + px); o[0].b[at] = v; o[0].b[at + 1] = v; o[0].b[at + 2] = v;
}
// Draws the damaged box of the screen into o (all of it after cx_damage_all) and clears the damage.
cx_composite :: (x: [] Cx, o: [] CxFrame) {
  for i: 0..<4 { x[0].clip[i] = x[0].dmg[i]; }
  x[0].dmg[0] = 0; x[0].dmg[1] = 0; x[0].dmg[2] = 0; x[0].dmg[3] = 0;
  if x[0].clip[2] <= x[0].clip[0] { return; }
  for py: x[0].clip[1]..<x[0].clip[3] { for px: x[0].clip[0]..<x[0].clip[2] { at := 3 * (py * x[0].w + px); o[0].b[at] = 24; o[0].b[at + 1] = 26; o[0].b[at + 2] = 32; } }
  for sc: 0..<x[0].wm[0].ns {
  t: [WM_WINS] WmTile; n := wm_tiles_on(x[0].wm[..], sc, t[..]);
  for i: 0..<n {
    t[i].desk = x[0].wm[0].screens[sc].desk + 1;
    s := x[0].win_surf[t[i].id]; if s < 0 { continue; }
    r: [4] int; cx_frame(x, t[i], wm_is_fullscreen(x[0].wm[..], t[i].id), r[..]);
    cx_draw_surf(x, o, s, r[0] - x[0].surfs[s].gx, r[1] - x[0].surfs[s].gy, r[0], r[1], r[0] + r[2], r[1] + r[3]);
    if !wm_is_fullscreen(x[0].wm[..], t[i].id) && !x[0].surfs[s].noborder {   // the border: white on the focused window, #4a4a4a on the rest
      v := cast,trunc(u8) (ifx t[i].id == wm_focus(x[0].wm[..]) then 255 else 74);
      for b: 0..<CX_BORDER {
        bx0 := r[0] - 1 - b; by0 := r[1] - 1 - b; bx1 := r[0] + r[2] + b; by1 := r[1] + r[3] + b;
        for px: bx0..<bx1 + 1 { cx_dot(x, o, px, by0, v); cx_dot(x, o, px, by1, v); }
        for py: by0..<by1 + 1 { cx_dot(x, o, bx0, py, v); cx_dot(x, o, bx1, py, v); }
      }
    }
  }
  }
  for i: 0..<CX_XWINS {   // X menus and tooltips (override-redirect) where they put themselves
    q := x[0].xw[0].wins[i];
    if q.used && q.ovr && q.mapped && q.s >= 0 { cx_draw_surf(x, o, q.s, q.x, q.y, 0, 0, x[0].w, x[0].h); }
  }
  if x[0].show_pointer && x[0].cursor >= 0 && x[0].surfs[x[0].cursor].used {   // the client's pointer image
    cx_draw_surf(x, o, x[0].cursor, x[0].px - x[0].hot_x, x[0].py - x[0].hot_y, 0, 0, x[0].w, x[0].h);
  } else if x[0].show_pointer && x[0].cursor == -1 {   // the pointer: a white arrow with a dark edge, 12 pixels tall
    for j: 0..<12 {
      for i: 0..<j / 2 + 1 {
        px := x[0].px + i; py := x[0].py + j;
        if px < x[0].clip[0] || py < x[0].clip[1] || px >= x[0].clip[2] || py >= x[0].clip[3] { continue; }
        edge := i == 0 || i == j / 2 || j == 11;
        at := 3 * (py * x[0].w + px); v := cast,trunc(u8) (ifx edge then 16 else 240);
        o[0].b[at] = v; o[0].b[at + 1] = v; o[0].b[at + 2] = v;
      }
    }
  }
}
// Writes the picture as a PPM: all of it drawn again when full, else only what was damaged since.
cx_shot :: (x: [] Cx, o: [] CxFrame, path: string, full: bool) -> bool {
  if full { cx_damage_all(x); }
  cx_composite(x, o);
  head: [64] u8; hn := 0;
  for c: "P6\n" { head[hn] = c; hn += 1; }
  hn = cx_num_into(head[..], hn, x[0].w); head[hn] = ' '; hn += 1; hn = cx_num_into(head[..], hn, x[0].h);
  for c: "\n255\n" { head[hn] = c; hn += 1; }
  n := 3 * x[0].w * x[0].h;
  // the header goes in front of the pixels for the write, and they move back after: the picture is kept
  i := n - 1; while i >= 0 { o[0].b[i + hn] = o[0].b[i]; i -= 1; }
  for j: 0..<hn { o[0].b[j] = head[j]; }
  ok := fs_write(path, cast(string) o[0].b[0..<n + hn]);
  for j: 0..<n { o[0].b[j] = o[0].b[j + hn]; }
  return ok;
}
cx_num_into :: (b: [] u8, at: int, value: int) -> int {
  v := value; d: [24] u8; k := 0;
  while true { d[k] = cast,trunc(u8) ('0' + v % 10); k += 1; v = v / 10; if v == 0 { break; } }
  for i: 0..<k { b[at + i] = d[k - 1 - i]; }
  return at + k;
}

// ---- keys: every press passes the CoderOS bindings first (os/modules/coderos/desktop.nix at
// 2ca255550e~1, Omarchy's tiling keys); what no binding takes goes to the focused window.

CX_SHIFT :: 1; CX_CTRL :: 4; CX_ALT :: 8; CX_SUPER :: 64;   // XKB modifier masks
cx_mask :: (x: [] Cx) -> int {
  m := 0;
  if x[0].held[42] || x[0].held[54] { m |= CX_SHIFT; }
  if x[0].held[29] || x[0].held[97] { m |= CX_CTRL; }
  if x[0].held[56] || x[0].held[100] { m |= CX_ALT; }
  if x[0].held[125] || x[0].held[126] { m |= CX_SUPER; }
  return m;
}
cx_is_mod :: (code: int) -> bool { return code == 42 || code == 54 || code == 29 || code == 97 || code == 56 || code == 100 || code == 125 || code == 126; }
cx_dir :: (code: int) -> int { if code == 105 { return WM_LEFT; } if code == 106 { return WM_RIGHT; } if code == 103 { return WM_UP; } if code == 108 { return WM_DOWN; } return -1; }
// Runs launch-dir/NAME, a client of this compositor.
cx_exec :: (x: [] Cx, name: string) {
  p: [1024] u8; n := 0;
  for i: 0..<x[0].nlaunch { p[n] = x[0].launch[i]; n += 1; }
  p[n] = '/'; n += 1; for c: name { if n < 1023 { p[n] = c; n += 1; } }
  r := cxwl_spawn(p[0..<n], x[0].sock[0..<x[0].nsock]);
  b: [256] u8; k := 0; for c: "exec " { b[k] = c; k += 1; } for c: name { if k < 200 { b[k] = c; k += 1; } }
  if r < 0 { for c: " failed" { b[k] = c; k += 1; } }
  cx_say(cast(string) b[0..<k]);
}
// What a press with these modifiers does under the CoderOS bindings: verb 0 when nothing (Hyprland
// matches the modifier set exactly). arg is a direction, a desk 0..8, or which program to start.
B_NONE :: 0; B_EXEC :: 1; B_CLOSE :: 2; B_FOCUS :: 3; B_DESK :: 4; B_TO_DESK :: 5; B_MOVE :: 6; B_RESIZE :: 7;
B_SPLIT :: 8; B_FLOAT :: 9; B_FULL :: 10; B_MAX :: 11; B_SCREEN :: 12; B_TO_SCREEN :: 13; B_DESK_TO_SCREEN :: 14; B_QUIT :: 15; B_VT :: 16;
CX_PROGRAMS :: 8;
cx_program :: (i: int) -> string {
  if i == 7 { return "battlenet"; }
  if i == 0 { return "coder"; } if i == 1 { return "pane"; } if i == 2 { return "dictation"; }
  if i == 3 { return "presentation"; } if i == 4 { return "browser"; } if i == 6 { return "camera"; } return "android";
}
CxBind :: struct { verb: int; arg: int; }
cx_bind :: (code: int, mods: int) -> CxBind {
  d := cx_dir(code); digit := ifx code >= 2 && code <= 10 then code - 2 else -1;
  S := CX_SUPER; none := CxBind.{verb = B_NONE};
  if mods == S {
    if code == 28 { return CxBind.{verb = B_EXEC, arg = 0}; }
    if code == 17 || code == 16 { return CxBind.{verb = B_CLOSE}; }
    if d >= 0 { return CxBind.{verb = B_FOCUS, arg = d}; }
    if digit >= 0 { return CxBind.{verb = B_DESK, arg = digit}; }
    if code == 36 { return CxBind.{verb = B_SPLIT}; }
    if code == 57 || code == 32 { return CxBind.{verb = B_FLOAT}; }
    if code == 33 { return CxBind.{verb = B_FULL}; }
    if code == 20 { return CxBind.{verb = B_EXEC, arg = 1}; }
    if code == 47 { return CxBind.{verb = B_EXEC, arg = 2}; }
    if code == 25 { return CxBind.{verb = B_EXEC, arg = 3}; }
    if code == 48 { return CxBind.{verb = B_EXEC, arg = 4}; }
    if code == 30 { return CxBind.{verb = B_EXEC, arg = 5}; }
    if code == 46 { return CxBind.{verb = B_EXEC, arg = 6}; }   // Super+C: the camera view
    if code == 34 { return CxBind.{verb = B_EXEC, arg = 7}; }   // Super+G: Battle.net on this desk
  }
  if mods == S | CX_SHIFT {
    if digit >= 0 { return CxBind.{verb = B_TO_DESK, arg = digit}; }
    if d >= 0 { return CxBind.{verb = B_MOVE, arg = d}; }
    if code == 18 { return CxBind.{verb = B_QUIT}; }   // Super+Shift+E: exit
  }
  if mods == S | CX_CTRL {
    if d >= 0 { return CxBind.{verb = B_RESIZE, arg = d}; }
    if code == 33 { return CxBind.{verb = B_MAX}; }
  }
  if mods == CX_CTRL | CX_ALT && code == 14 { return CxBind.{verb = B_QUIT}; }   // Ctrl+Alt+Backspace: leave, the screen goes back
  if mods == CX_CTRL | CX_ALT { f := cx_vt_key(code); if f > 0 { return CxBind.{verb = B_VT, arg = f}; } }   // Ctrl+Alt+Fn: VT n
  if mods == CX_CTRL | CX_ALT && code == 15 { return CxBind.{verb = B_SCREEN, arg = WM_NEXT}; }
  if mods == CX_CTRL | CX_ALT | CX_SHIFT && code == 15 { return CxBind.{verb = B_SCREEN, arg = WM_PREVIOUS}; }
  if d >= 0 {
    if mods == S | CX_ALT { return CxBind.{verb = B_SCREEN, arg = d}; }
    if mods == S | CX_SHIFT | CX_ALT { return CxBind.{verb = B_TO_SCREEN, arg = d}; }
    if mods == S | CX_CTRL | CX_ALT { return CxBind.{verb = B_DESK_TO_SCREEN, arg = d}; }
  }
  return none;
}
// Runs the binding a press makes; false when there is none and the key is the window's.
cx_binding :: (x: [] Cx, code: int, mods: int) -> bool {
  b := cx_bind(code, mods); m := x[0].wm[..]; v := b.verb;
  if v == B_NONE { return false; }
  if v == B_EXEC { cx_exec(x, cx_program(b.arg)); return true; }
  if v == B_CLOSE { cx_close_key(x); return true; }
  if v == B_QUIT { x[0].quit = true; return true; }
  if v == B_VT { r := cxvt_switch(b.arg); return true; }
  if v == B_FOCUS { wm_movefocus(m, b.arg); }
  else if v == B_DESK { wm_switch_workspace(m, b.arg); }
  else if v == B_TO_DESK { wm_movetoworkspace(m, b.arg); }
  else if v == B_MOVE { wm_movewindow(m, b.arg); }
  else if v == B_RESIZE { full := ifx b.arg == WM_LEFT || b.arg == WM_RIGHT then x[0].w else x[0].h; wm_resize(m, b.arg, 40.0 / cast(f32) full); }
  else if v == B_SPLIT { wm_togglesplit(m); }
  else if v == B_FLOAT { wm_togglefloating(m); }
  else if v == B_FULL { wm_fullscreen(m); }
  else if v == B_MAX { wm_maximize(m); }
  else if v == B_SCREEN { y := wm_focus_screen(m, b.arg); }
  else if v == B_TO_SCREEN { f := wm_focus(m); if f != 0 { y := wm_move_to_screen(m, f, b.arg); } }
  else if v == B_DESK_TO_SCREEN { y := wm_move_desk_to_screen(m, b.arg); }
  cx_damage_all(x); cx_sync(x);
  return true;
}
// The VT a function key names (F1..F10 are 59..68, F11 87, F12 88), 0 for any other key.
cx_vt_key :: (code: int) -> int {
  if code >= 59 && code <= 68 { return code - 58; }
  return ifx code == 87 then 11 else ifx code == 88 then 12 else 0;
}
// Another VT shows: every key held goes up for the window that has it (the keys that go up there are
// that session's), and nothing is held when this one comes back.
cx_vt_away :: (x: [] Cx) {
  for code: 0..<256 {
    if x[0].held[code] && !x[0].swallowed[code] { cx_key(x, code, false); }
    x[0].held[code] = false; x[0].swallowed[code] = false;
  }
  cx_mods(x, 0);
}
// One key going down or up, from the keyboard (evdev code).
cx_input_key :: (x: [] Cx, code: int, down: bool) {
  if code < 0 || code >= 256 { return; }
  if !down && x[0].swallowed[code] { x[0].swallowed[code] = false; x[0].held[code] = false; return; }
  before := cx_mask(x);
  x[0].held[code] = down;
  if down && !cx_is_mod(code) && cx_binding(x, code, before) { x[0].swallowed[code] = true; return; }
  cx_key(x, code, down);
  if cx_is_mod(code) && cx_mask(x) != before { cx_mods(x, cx_mask(x)); }
}
// Super+W, as os/bin/coder-close decided it: a window with Coder work in flight (a streaming turn, a
// delegation that has not reported) closes on a second press within 5 seconds, and the first press
// says what is running. `coder activity --pid P...` over the window's processes owns that rule; a
// window that cannot be asked about (no process, no coder, coder failing) closes on the first press.
CX_CONFIRM_MS :: 5000;
cx_close_key :: (x: [] Cx) {
  f := wm_focus(x[0].wm[..]); if f == 0 { return; }
  if x[0].armed == f && cxwl_ms() <= x[0].armed_until { x[0].armed = 0; cx_close_win(x, f); return; }
  if x[0].asking != 0 { return; }   // the last press is still being asked about
  s := x[0].win_surf[f]; pid := ifx s >= 0 then cxwl_peer_pid(x[0].clients[x[0].surfs[s].client].h) else -1;
  if pid <= 0 { cx_close_win(x, f); return; }
  args: [8192] u8; n := 0;
  for c: "coder\0activity" { args[n] = c; n += 1; }
  k := cxwl_tree(pid);
  for i: 0..<k {
    if n > 8100 { break; }
    args[n] = 0; n += 1; for c: "--pid" { args[n] = c; n += 1; } args[n] = 0; n += 1;
    n = cx_num_into(args[..], n, cxwl_tree_at(i));
  }
  if cxwl_ask_start(args[0..<n]) < 0 { cx_close_win(x, f); return; }
  x[0].asking = f;
}
// What the question answered: 0 means work runs (arm and say so), anything else closes.
cx_close_answer :: (x: [] Cx) {
  if x[0].asking == 0 { return; }
  out: [4096] u8; st := cxwl_ask_poll(out[..]);
  if st == -1 { return; }
  f := x[0].asking; x[0].asking = 0;
  if st != 0 { cx_close_win(x, f); return; }
  n := cxwl_ask_len(); while n > 0 && (out[n - 1] == '\n' || out[n - 1] == ' ') { n -= 1; }
  x[0].armed = f; x[0].armed_until = cxwl_ms() + CX_CONFIRM_MS;
  b: [4400] u8; k := 0;
  for c: "notice Coder is working: " { b[k] = c; k += 1; }
  for i: 0..<n { b[k] = ifx out[i] == '\n' then ' ' else out[i]; k += 1; }
  for c: " Press the close key again within 5 seconds to close this window." { b[k] = c; k += 1; }
  cx_say(cast(string) b[0..<k]);
  // on screen too, through the notification daemon, as coder-close showed it
  a: [4600] u8; an := 0;
  for c: "notify-send\0--app-name=coder\0--urgency=critical\0--hint=string:x-canonical-private-synchronous:coder-close\0Coder is working\0" { a[an] = c; an += 1; }
  for i: 25..<k { a[an] = b[i]; an += 1; }
  r := cxwl_run(a[0..<an], x[0].sock[0..<x[0].nsock]);
}
cx_close_win :: (x: [] Cx, f: int) {
  s := ifx f > 0 && f < WM_WINS then x[0].win_surf[f] else -1;
  if s >= 0 && x[0].surfs[s].role == R_X11 {   // an X window: WM_DELETE_WINDOW
    if x[0].surfs[s].xwin >= 0 { id := x[0].xw[0].wins[x[0].surfs[s].xwin].id; o := x[0].xw[0].o[..]; if x[0].xw[0].atoms[2] != 0 { xw_delete(o, id, x[0].xw[0].atoms[1], x[0].xw[0].atoms[2]); } else { xw_kill(o, id); } cx_xw_flush(x); }
    return;
  }
  if s >= 0 { g := x[0].g[..]; mg_begin(g, x[0].surfs[s].top, 1); mg_end(g); mg_flush(x, x[0].surfs[s].client, -1); }
}
// Window rules: desktop.nix's own (the camera view and the recording HUD float at the size they drew,
// with no border, pinned so they follow across desks) and then the host's `extraWindowRules`, one a
// line in LAUNCH-DIR/rules as the system writes them:
//   title|class [icase] exact=TEXT | prefix=TEXT [holds=TEXT] ... EFFECT...
// with EFFECT float, tile, center, aspect (keep_aspect_ratio), border=0, pin, nofullscreen
// (suppress_event maximize fullscreen), and %20 for a space in TEXT. A window is matched when it
// maps and again when it names itself later; the first time a rule matches, its effects apply.
CX_RULES :: 32;
CxPat :: struct { kind: int; a: [64] u8; na: int; b: [64] u8; nb: int; }   // kind 0 exact, 1 prefix, 2 prefix holding b
CxRule :: struct { by_class: bool; icase: bool; pats: [8] CxPat; np: int; floats: int; center: bool; aspect: bool; noborder: bool; pin: bool; nofull: bool; }
CxRules :: struct { r: [CX_RULES] CxRule; n: int; }
CX_BUILTIN_RULES :: "title exact=selfie float aspect border=0 pin\ntitle exact=recording-hud float border=0 pin\n";
cx_low :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
cx_eq_at :: (t: string, at: int, p: [] u8, n: int, icase: bool) -> bool {
  if at + n > t.count { return false; }
  for i: 0..<n { a := t[at + i]; b := p[i]; if icase { a = cx_low(a); b = cx_low(b); } if a != b { return false; } }
  return true;
}
cx_pat_matches :: (pat: CxPat, t: string, icase: bool) -> bool {
  pp: [1] CxPat; pp[0] = pat; p := pp[0];
  if p.kind == 0 { return t.count == p.na && cx_eq_at(t, 0, pp[0].a[..], p.na, icase); }
  if !cx_eq_at(t, 0, pp[0].a[..], p.na, icase) { return false; }
  if p.kind == 1 { return true; }
  for at: p.na..<t.count - p.nb + 1 { if cx_eq_at(t, at, pp[0].b[..], p.nb, icase) { return true; } }
  return false;
}
// Reads rule lines into rs: the count read, or -1 at the first line it cannot read.
cx_rules_parse :: (rs: [] CxRules, text: string) -> int {
  st := 0; got := 0;
  for e: 0..<text.count + 1 {
    if e < text.count && text[e] != '\n' { continue; }
    line := text[st..<e]; st = e + 1;
    w: [24] string; nw := 0; ws := 0;
    for i: 0..<line.count + 1 { if i == line.count || line[i] == ' ' { if i > ws && nw < 24 { w[nw] = line[ws..<i]; nw += 1; } ws = i + 1; } }
    if nw == 0 || w[0][0] == '#' { continue; }
    if rs[0].n >= CX_RULES || (w[0] != "title" && w[0] != "class") { return -1; }
    r: [1] CxRule; r[0].by_class = w[0] == "class"; r[0].floats = -1;
    for i: 1..<nw {
      v := w[i];
      if v == "icase" { r[0].icase = true; } else if v == "float" { r[0].floats = 1; } else if v == "tile" { r[0].floats = 0; }
      else if v == "center" { r[0].center = true; } else if v == "aspect" { r[0].aspect = true; } else if v == "border=0" { r[0].noborder = true; }
      else if v == "pin" { r[0].pin = true; } else if v == "nofullscreen" { r[0].nofull = true; }
      else if v.count > 6 && v[0..<6] == "exact=" && r[0].np < 8 { r[0].pats[r[0].np].kind = 0; r[0].pats[r[0].np].na = cx_unescape(v[6..<v.count], r[0].pats[r[0].np].a[..]); r[0].np += 1; }
      else if v.count > 7 && v[0..<7] == "prefix=" && r[0].np < 8 { r[0].pats[r[0].np].kind = 1; r[0].pats[r[0].np].na = cx_unescape(v[7..<v.count], r[0].pats[r[0].np].a[..]); r[0].np += 1; }
      else if v.count > 6 && v[0..<6] == "holds=" && r[0].np > 0 && r[0].pats[r[0].np - 1].kind == 1 { r[0].pats[r[0].np - 1].kind = 2; r[0].pats[r[0].np - 1].nb = cx_unescape(v[6..<v.count], r[0].pats[r[0].np - 1].b[..]); }
      else { return -1; }
    }
    if r[0].np == 0 { return -1; }
    rs[0].r[rs[0].n] = r[0]; rs[0].n += 1; got += 1;
  }
  return got;
}
cx_unescape :: (v: string, out: [] u8) -> int {
  n := 0; i := 0;
  while i < v.count && n < out.count {
    if v[i] == '%' && i + 2 < v.count && v[i + 1] == '2' && v[i + 2] == '0' { out[n] = ' '; i += 3; } else { out[n] = v[i]; i += 1; }
    n += 1;
  }
  return n;
}
cx_rule_matches :: (r: CxRule, title: string, app: string) -> bool {
  t := ifx r.by_class then app else title;
  for i: 0..<r.np { if cx_pat_matches(r.pats[i], t, r.icase) { return true; } }
  return false;
}
cx_rules :: (x: [] Cx, s: int, w: int) {
  if x[0].surfs[s].ruled { return; }
  t := cast(string) x[0].surfs[s].title[0..<x[0].surfs[s].nt]; ap := cast(string) x[0].surfs[s].app[0..<x[0].surfs[s].na];
  m := x[0].wm[..];
  for i: 0..<x[0].rules[0].n {
    r := x[0].rules[0].r[i];
    if !cx_rule_matches(r, t, ap) { continue; }
    x[0].surfs[s].ruled = true;
    b := x[0].surfs[s].cur; bw := 320; bh := 320;
    if x[0].surfs[s].gw > 0 { bw = x[0].surfs[s].gw; bh = x[0].surfs[s].gh; } else if b >= 0 { bw = x[0].bufs[b].w; bh = x[0].bufs[b].h; }
    if r.floats == 1 {
      y := wm_set_floating(m, w, true);
      c := m[0].screens[m[0].screen]; fw := cast(f32) bw / cast(f32) c.w; fh := cast(f32) bh / cast(f32) c.h;
      y = wm_place_float(m, w, WmRect.{x = (1.0 - fw) * 0.5, y = (1.0 - fh) * 0.5, w = fw, h = fh});
    } else if r.floats == 0 { y := wm_set_floating(m, w, false); }
    if r.pin { y := wm_set_pinned(m, w, true); }
    if r.noborder { x[0].surfs[s].noborder = true; }
    if r.aspect { x[0].surfs[s].aspect = cast(f32) bw / cast(f32) bh; }
    if r.nofull { x[0].surfs[s].nofull = true; }
  }
}
// ---- Xwayland: the X11 window manager

XW_NAMES :: 5;
cx_xw_atom_name :: (i: int) -> string {
  if i == 0 { return "WL_SURFACE_ID"; } if i == 1 { return "WM_PROTOCOLS"; } if i == 2 { return "WM_DELETE_WINDOW"; }
  if i == 3 { return "_NET_WM_NAME"; } if i == 4 { return "UTF8_STRING"; } return "WM_S0";
}
cx_xw_flush :: (x: [] Cx) {
  o := x[0].xw[0].o[..];
  if o[0].n > 0 { r := cxx_send(o[0].b[0..<o[0].n]); o[0].n = 0; if r < 0 { cx_xw_off(x); } }
}
cx_xw_off :: (x: [] Cx) {
  if !x[0].xw[0].on { return; }
  x[0].xw[0].on = false;
  for i: 0..<CX_XWINS { if x[0].xw[0].wins[i].used { cx_xw_unmanage(x, i); x[0].xw[0].wins[i].used = false; } }
  r := cxwl_xwayland_stop(); cx_say("xwayland gone");
}
cx_xw_find :: (x: [] Cx, id: int) -> int { for i: 0..<CX_XWINS { if x[0].xw[0].wins[i].used && x[0].xw[0].wins[i].id == id { return i; } } return -1; }
cx_xw_get :: (x: [] Cx, win: int, atom: int) {
  if atom == 0 { return; }
  o := x[0].xw[0].o[..]; xw_get_property(o, win, atom);
  for i: 0..<64 { if x[0].xw[0].gets[i].seq == 0 { x[0].xw[0].gets[i] = CxXGet.{seq = o[0].seq, win = win, atom = atom}; return; } }
}
// The window leaves the window policy; its surface goes back to having no role.
cx_xw_unmanage :: (x: [] Cx, i: int) {
  s := x[0].xw[0].wins[i].s;
  if s >= 0 && x[0].surfs[s].used {
    if x[0].surfs[s].win != 0 { cx_unmap(x, s); } else { x[0].surfs[s].role = R_NONE; cx_damage_all(x); }
    x[0].surfs[s].xwin = -1;
  }
  x[0].xw[0].wins[i].s = -1; x[0].xw[0].wins[i].sid = 0; x[0].xw[0].wins[i].win = 0; x[0].xw[0].wins[i].sw = 0;
}
// Copies the X window's title and class to its surface, where `list` and the window rules read them.
cx_xw_names :: (x: [] Cx, i: int) {
  s := x[0].xw[0].wins[i].s; if s < 0 { return; }
  for k: 0..<x[0].xw[0].wins[i].nt { x[0].surfs[s].title[k] = x[0].xw[0].wins[i].title[k]; } x[0].surfs[s].nt = x[0].xw[0].wins[i].nt;
  for k: 0..<x[0].xw[0].wins[i].nc { x[0].surfs[s].app[k] = x[0].xw[0].wins[i].cls[k]; } x[0].surfs[s].na = x[0].xw[0].wins[i].nc;
  if x[0].surfs[s].win != 0 && !x[0].surfs[s].ruled { cx_rules(x, s, x[0].surfs[s].win); cx_sync(x); }
}
cx_xw_reply :: (x: [] Cx, b: [] u8) {
  seq := xr_u16(b, 2);
  for i: 0..<XW_ATOMS {
    if x[0].xw[0].atom_seq[i] == seq && x[0].xw[0].atoms[i] == 0 {
      x[0].xw[0].atoms[i] = xr_u32(b, 8); x[0].xw[0].atom_seq[i] = -1;
      return;
    }
  }
  if seq == x[0].xw[0].comp_seq {   // Composite: redirect the root's children, then own WM_S0, after which X clients may connect
    x[0].xw[0].comp_seq = -1; o := x[0].xw[0].o[..];
    if b[8] == 0 { cx_say("xwayland has no Composite extension"); return; }
    major := cast(int) b[9];
    xw_composite_version(o, major); xw_composite_redirect(o, major, x[0].xw[0].root);
    xw_own_selection(o, x[0].xw[0].own, x[0].xw[0].atoms[5]);
    return;
  }
  for g: 0..<64 {
    q := x[0].xw[0].gets[g];
    if q.seq != seq { continue; }
    x[0].xw[0].gets[g].seq = 0;
    i := cx_xw_find(x, q.win); if i < 0 { return; }
    format := cast(int) b[1]; count := xr_u32(b, 16) * format / 8; count = cx_min(count, b.count - 32);
    if q.atom == XA_WM_CLASS {   // "instance\0class\0": the class is the name a rule matches
      st := 0; for k: 0..<count { if b[32 + k] == 0 { st = k + 1; break; } }
      n := 0; for k: st..<count { if b[32 + k] == 0 || n >= 128 { break; } x[0].xw[0].wins[i].cls[n] = b[32 + k]; n += 1; }
      x[0].xw[0].wins[i].nc = n;
    } else if q.atom == XA_WM_NAME || q.atom == x[0].xw[0].atoms[3] {
      if q.atom == XA_WM_NAME && x[0].xw[0].wins[i].net_title { return; }
      if q.atom != XA_WM_NAME && count <= 0 { return; }   // no _NET_WM_NAME: WM_NAME stands
      n := cx_min(count, 128); for k: 0..<n { x[0].xw[0].wins[i].title[k] = b[32 + k]; } x[0].xw[0].wins[i].nt = n;
      if q.atom != XA_WM_NAME && n > 0 { x[0].xw[0].wins[i].net_title = true; }
    }
    cx_xw_names(x, i);
    return;
  }
}
cx_xw_event :: (x: [] Cx, b: [] u8) {
  x[0].xw[0].seen[cast(int) (b[0] & 127) % 40] += 1;
  if b[0] == 0 { x[0].xw[0].err = cast(int) b[1]; x[0].xw[0].err_op = cast(int) b[10]; return; }   // an error: most often a window that went away first
  if b[0] == 1 { cx_xw_reply(x, b); return; }
  t := cast(int) (b[0] & 127); o := x[0].xw[0].o[..];
  if t == XE_CREATE {
    if xr_u32(b, 8) == x[0].xw[0].own { return; }
    for i: 0..<CX_XWINS {
      if !x[0].xw[0].wins[i].used {
        x[0].xw[0].wins[i] = CxXWin.{used = true, id = xr_u32(b, 8), s = -1, ovr = b[22] != 0, x = xr_i16(b, 12), y = xr_i16(b, 14), w = xr_u16(b, 16), h = xr_u16(b, 18)};
        return;
      }
    }
  } else if t == XE_DESTROY || t == XE_UNMAP {
    i := cx_xw_find(x, xr_u32(b, 8)); if i < 0 { return; }
    cx_xw_unmanage(x, i); x[0].xw[0].wins[i].mapped = false;
    if t == XE_DESTROY { x[0].xw[0].wins[i].used = false; }
  } else if t == XE_MAP_REQUEST {
    win := xr_u32(b, 8); xw_map(o, win);
    cx_xw_get(x, win, XA_WM_CLASS); cx_xw_get(x, win, XA_WM_NAME); cx_xw_get(x, win, x[0].xw[0].atoms[3]);
    i := cx_xw_find(x, win); if i >= 0 { xw_event_mask(o, win, XM_PROPERTY_CHANGE | XM_FOCUS_CHANGE); }
  } else if t == XE_MAP {
    i := cx_xw_find(x, xr_u32(b, 8)); if i < 0 { return; }
    x[0].xw[0].wins[i].mapped = true; x[0].xw[0].wins[i].ovr = b[12] != 0; cx_damage_all(x);
  } else if t == XE_CONFIGURE {
    i := cx_xw_find(x, xr_u32(b, 8)); if i < 0 { return; }
    if x[0].xw[0].wins[i].ovr || x[0].xw[0].wins[i].win == 0 {
      x[0].xw[0].wins[i].x = xr_i16(b, 16); x[0].xw[0].wins[i].y = xr_i16(b, 18); x[0].xw[0].wins[i].w = xr_u16(b, 20); x[0].xw[0].wins[i].h = xr_u16(b, 22);
      cx_damage_all(x);
    }
  } else if t == XE_CONFIGURE_REQUEST {
    win := xr_u32(b, 8); i := cx_xw_find(x, win);
    if i >= 0 && x[0].xw[0].wins[i].win != 0 { x[0].xw[0].wins[i].sw = 0; cx_sync(x); return; }   // a managed window keeps the place the layout gives it
    v: [7] int; v[0] = xr_i16(b, 16); v[1] = xr_i16(b, 18); v[2] = xr_u16(b, 20); v[3] = xr_u16(b, 22); v[4] = xr_u16(b, 24); v[5] = xr_u32(b, 12); v[6] = cast(int) b[1];
    xw_configure_some(o, win, xr_u16(b, 26), v[..]);
  } else if t == XE_PROPERTY {
    win := xr_u32(b, 4); atom := xr_u32(b, 8);
    if atom == XA_WM_NAME || atom == XA_WM_CLASS || (atom != 0 && atom == x[0].xw[0].atoms[3]) { cx_xw_get(x, win, atom); }
  } else if t == XE_CLIENT_MESSAGE {
    i := cx_xw_find(x, xr_u32(b, 4));
    if i >= 0 && x[0].xw[0].atoms[0] != 0 && xr_u32(b, 8) == x[0].xw[0].atoms[0] { x[0].xw[0].wins[i].sid = xr_u32(b, 12); }
  }
}
// Reads what the X server sent, ties windows to their surfaces, and puts mapped ones in the layout.
cx_xw_tick :: (x: [] Cx) {
  if !x[0].xw[0].on { return; }
  while x[0].xw[0].nin < 65536 {
    r := cxx_recv(x[0].xw[0].inb[x[0].xw[0].nin..<65536]);
    if r < 0 { cx_xw_off(x); return; }
    if r == 0 { break; }
    x[0].xw[0].nin += r;
  }
  o := x[0].xw[0].o[..];
  if !x[0].xw[0].up {
    sz := xr_setup_size(x[0].xw[0].inb[..], x[0].xw[0].nin); if sz == 0 { return; }
    root := xr_setup_root(x[0].xw[0].inb[..]); x[0].xw[0].own = xr_setup_id_base(x[0].xw[0].inb[..]) | 1;
    cx_xw_take(x, sz);
    if root < 0 { cx_say("xwayland refused the window manager"); cx_xw_off(x); return; }
    x[0].xw[0].up = true; x[0].xw[0].root = root;
    xw_event_mask(o, root, XM_SUBSTRUCTURE_REDIRECT | XM_SUBSTRUCTURE_NOTIFY | XM_PROPERTY_CHANGE);
    xw_create_window(o, x[0].xw[0].own, root);
    for i: 0..<XW_ATOMS { xw_intern_atom(o, cx_xw_atom_name(i)); x[0].xw[0].atom_seq[i] = o[0].seq; }
    xw_query_extension(o, "Composite"); x[0].xw[0].comp_seq = o[0].seq;
    cx_say("xwayland ready");
  }
  while true {
    sz := xr_size(x[0].xw[0].inb[..], x[0].xw[0].nin); if sz == 0 { break; }
    m: [65536] u8; for k: 0..<sz { m[k] = x[0].xw[0].inb[k]; }
    cx_xw_take(x, sz);
    cx_xw_event(x, m[0..<sz]);
  }
  ci := x[0].xw[0].client;
  for i: 0..<CX_XWINS {
    if !x[0].xw[0].wins[i].used { continue; }
    if x[0].xw[0].wins[i].s < 0 && x[0].xw[0].wins[i].sid != 0 && ci >= 0 {
      for s: 0..<CX_SURFS {
        if x[0].surfs[s].used && x[0].surfs[s].client == ci && x[0].surfs[s].id == x[0].xw[0].wins[i].sid && x[0].surfs[s].role == R_NONE {
          x[0].xw[0].wins[i].s = s; x[0].surfs[s].role = R_X11; x[0].surfs[s].xwin = i; cx_damage_all(x); break;
        }
      }
    }
    s := x[0].xw[0].wins[i].s;
    if s >= 0 && x[0].xw[0].wins[i].mapped && !x[0].xw[0].wins[i].ovr && x[0].xw[0].wins[i].win == 0 {
      w := wm_spawn(x[0].wm[..]); x[0].xw[0].wins[i].win = w; x[0].surfs[s].win = w; x[0].win_surf[w] = s;
      cx_xw_names(x, i); cx_rules(x, s, w); cx_sync(x);
    }
  }
  cx_xw_flush(x);
}
cx_xw_take :: (x: [] Cx, n: int) {
  rest := x[0].xw[0].nin - n;
  for k: 0..<rest { x[0].xw[0].inb[k] = x[0].xw[0].inb[n + k]; }
  x[0].xw[0].nin = rest;
}
// A managed X window's place from the layout, sent when it changes.
cx_xw_place :: (x: [] Cx, i: int, fr: [] int) {
  q := x[0].xw[0].wins[i];
  if q.sx == fr[0] && q.sy == fr[1] && q.sw == fr[2] && q.sh == fr[3] { return; }
  x[0].xw[0].wins[i].sx = fr[0]; x[0].xw[0].wins[i].sy = fr[1]; x[0].xw[0].wins[i].sw = fr[2]; x[0].xw[0].wins[i].sh = fr[3];
  xw_configure(x[0].xw[0].o[..], q.id, fr[0], fr[1], fr[2], fr[3]); cx_xw_flush(x); cx_damage_all(x);
}
cx_close_focused :: (x: [] Cx) {
  f := wm_focus(x[0].wm[..]); s := ifx f != 0 then x[0].win_surf[f] else -1;
  if s >= 0 { g := x[0].g[..]; mg_begin(g, x[0].surfs[s].top, 1); mg_end(g); mg_flush(x, x[0].surfs[s].client, -1); }
}

// ---- input from the test channel

cx_key :: (x: [] Cx, code: int, down: bool) {
  s := x[0].kfocus; if s < 0 { return; }
  ci := x[0].surfs[s].client; g := x[0].g[..];
  for i: 0..<x[0].clients[ci].nk { mg_begin(g, x[0].clients[ci].kbds[i], 3); mg_put(g, cx_serial(x)); mg_put(g, cxwl_ms() & 4294967295); mg_put(g, code); mg_put(g, ifx down then 1 else 0); mg_end(g); }
  mg_flush(x, ci, -1);
}
cx_mods :: (x: [] Cx, dep: int) {
  s := x[0].kfocus; if s < 0 { return; }
  ci := x[0].surfs[s].client; g := x[0].g[..];
  for i: 0..<x[0].clients[ci].nk { mg_begin(g, x[0].clients[ci].kbds[i], 4); mg_put(g, cx_serial(x)); mg_put(g, dep); mg_put(g, 0); mg_put(g, 0); mg_put(g, 0); mg_end(g); }
  mg_flush(x, ci, -1);
}
// The evdev key for a character on the US layout, and whether it takes Shift: a fixed table.
CX_KEYS :: "1234567890-=qwertyuiop[]asdfghjkl;'`\\zxcvbnm,./";
CX_SHIFTED :: "!@#$%^&*()_+QWERTYUIOP{}ASDFGHJKL:\"~|ZXCVBNM<>?";
// The keys run in rows: 1..= are 2..13, q..] 16..27, a..` 30..41, \\ 43, z../ 44..53.
cx_code :: (i: int) -> int { if i < 12 { return i + 2; } if i < 24 { return i + 4; } if i < 36 { return i + 6; } return i + 7; }
cx_char_key :: (c: u8, shift: [] bool) -> int {
  shift[0] = false;
  if c == ' ' { return 57; } if c == '\n' { return 28; } if c == '\t' { return 15; }
  k := CX_KEYS; for i: 0..<k.count { if k[i] == c { return cx_code(i); } }
  q := CX_SHIFTED; for i: 0..<q.count { if q[i] == c { shift[0] = true; return cx_code(i); } }
  return 0;
}
cx_pointer :: (x: [] Cx, px: int, py: int) {
  m := x[0].wm[..];
  sc := cx_screen_at(x, px, py); id := 0;
  if sc >= 0 {
    if sc != m[0].screen { m[0].screen = sc; cx_damage_all(x); }   // the pointer carries focus to the screen it enters
    c := m[0].screens[sc];
    id = wm_focus_at(m, cast(f32) (px - c.x) / cast(f32) c.w, cast(f32) (py - c.y) / cast(f32) c.h);
  }
  cx_sync(x);
  s := ifx id != 0 then x[0].win_surf[id] else -1;
  ox := 0; oy := 0; menu := false;
  for i: 0..<CX_XWINS {   // an X menu over it takes the pointer
    q := x[0].xw[0].wins[i];
    if q.used && q.ovr && q.mapped && q.s >= 0 && px >= q.x && py >= q.y && px < q.x + q.w && py < q.y + q.h { s = q.s; ox = q.x; oy = q.y; menu = true; }
  }
  g := x[0].g[..];
  if s != x[0].pfocus && x[0].pfocus >= 0 {
    pc := x[0].surfs[x[0].pfocus].client;
    for i: 0..<x[0].clients[pc].npt { p := x[0].clients[pc].ptrs[i]; mg_begin(g, p, 1); mg_put(g, cx_serial(x)); mg_put(g, x[0].surfs[x[0].pfocus].id); mg_end(g); if x[0].clients[pc].objs[p].ver >= 5 { mg_begin(g, p, 5); mg_end(g); } }
    mg_flush(x, pc, -1);
  }
  cx_damage_pointer(x); x[0].px = px; x[0].py = py; cx_damage_pointer(x);
  if s != x[0].pfocus { x[0].cursor = -1; }   // a new window sets its own pointer on enter
  if s < 0 { x[0].pfocus = -1; return; }
  if !menu { r: [4] int; if !cx_place(x, id, r[..]) { return; } ox = r[0] - x[0].surfs[s].gx; oy = r[1] - x[0].surfs[s].gy; }
  lx := (px - ox) * 256; ly := (py - oy) * 256;
  ci := x[0].surfs[s].client;
  for i: 0..<x[0].clients[ci].npt {
    p := x[0].clients[ci].ptrs[i];
    if s != x[0].pfocus { mg_begin(g, p, 0); mg_put(g, cx_serial(x)); mg_put(g, x[0].surfs[s].id); mg_put(g, lx); mg_put(g, ly); mg_end(g); }
    else { mg_begin(g, p, 2); mg_put(g, cxwl_ms() & 4294967295); mg_put(g, lx); mg_put(g, ly); mg_end(g); }
    if x[0].clients[ci].objs[p].ver >= 5 { mg_begin(g, p, 5); mg_end(g); }
  }
  mg_flush(x, ci, -1);
  x[0].pfocus = s;
}
cx_button :: (x: [] Cx, button: int, down: bool) {
  s := x[0].pfocus; if s < 0 { return; }
  ci := x[0].surfs[s].client; g := x[0].g[..];
  for i: 0..<x[0].clients[ci].npt {
    p := x[0].clients[ci].ptrs[i];
    mg_begin(g, p, 3); mg_put(g, cx_serial(x)); mg_put(g, cxwl_ms() & 4294967295); mg_put(g, button); mg_put(g, ifx down then 1 else 0); mg_end(g);
    if x[0].clients[ci].objs[p].ver >= 5 { mg_begin(g, p, 5); mg_end(g); }
  }
  mg_flush(x, ci, -1);
}
cx_wheel :: (x: [] Cx, clicks: int) {
  s := x[0].pfocus; if s < 0 { return; }
  ci := x[0].surfs[s].client; g := x[0].g[..];
  for i: 0..<x[0].clients[ci].npt {
    p := x[0].clients[ci].ptrs[i];
    mg_begin(g, p, 4); mg_put(g, cxwl_ms() & 4294967295); mg_put(g, 0); mg_put(g, -clicks * 10 * 256); mg_end(g);
    if x[0].clients[ci].objs[p].ver >= 5 { mg_begin(g, p, 5); mg_end(g); }
  }
  mg_flush(x, ci, -1);
}
// A button: with Super held, 272 drags the window under the pointer and 273 resizes it from the
// corner nearest the grab (Hyprland bindm movewindow / resizewindow); otherwise the window's.
cx_mouse_button :: (x: [] Cx, button: int, down: bool) {
  if down && x[0].drag == 0 && (cx_mask(x) & CX_SUPER) != 0 && (button == 272 || button == 273) && x[0].pfocus >= 0 {
    r: [4] int; f := wm_focus(x[0].wm[..]);
    if f != 0 && cx_place(x, f, r[..]) { x[0].drag_left = x[0].px < r[0] + r[2] / 2; x[0].drag_top = x[0].py < r[1] + r[3] / 2; }
    x[0].drag = button; return;
  }
  if !down && x[0].drag == button { x[0].drag = 0; return; }
  cx_button(x, button, down);
}
// The pointer moved by dx, dy pixels during a Super drag.
cx_drag :: (x: [] Cx, dx: int, dy: int) {
  m := x[0].wm[..]; c := m[0].screens[m[0].screen]; fx := cast(f32) dx / cast(f32) c.w; fy := cast(f32) dy / cast(f32) c.h;
  if x[0].drag == 272 { wm_drag_float(m, fx, fy); }
  else {
    wm_resize_grab(m, fx, fy, x[0].drag_left, x[0].drag_top);
    f := wm_focus(m); s := ifx f != 0 then x[0].win_surf[f] else -1;
    if s >= 0 && x[0].surfs[s].aspect > 0 {   // keep_aspect_ratio: the height follows the width, the grabbed corner moves
      r: [1] WmRect;
      if wm_rect_of(m, f, r[..]) {
        h := r[0].w * cast(f32) c.w / x[0].surfs[s].aspect / cast(f32) c.h;
        top := ifx x[0].drag_top then r[0].y + r[0].h - h else r[0].y;
        y := wm_place_float(m, f, WmRect.{x = r[0].x, y = top, w = r[0].w, h = h});
      }
    }
  }
  x[0].px = cx_max(0, cx_min(x[0].w - 1, x[0].px + dx)); x[0].py = cx_max(0, cx_min(x[0].h - 1, x[0].py + dy));
  cx_damage_all(x); cx_sync(x);
}
cx_click :: (x: [] Cx) { cx_button(x, 272, true); cx_button(x, 272, false); }
// The events the input face has ready: keys through the bindings, the mouse moving the pointer.
cx_input :: (x: [] Cx) -> bool {
  n := cxin_read(); if n < 0 { return false; }
  dx := 0; dy := 0; moved := false;
  for i: 0..<n {
    t := cxin_type(i); c := cxin_code(i); v := cxin_value(i);
    if t == 1 {
      if moved { if x[0].drag != 0 { cx_drag(x, dx, dy); } else { cx_pointer(x, cx_max(0, cx_min(x[0].w - 1, x[0].px + dx)), cx_max(0, cx_min(x[0].h - 1, x[0].py + dy))); } dx = 0; dy = 0; moved = false; }
      if c >= 272 && c <= 279 { if v != 2 { cx_mouse_button(x, c, v == 1); } }
      else if v != 2 { cx_input_key(x, c, v == 1); }   // clients repeat held keys themselves
    } else if t == 2 {
      if c == 0 { dx += v; moved = true; } else if c == 1 { dy += v; moved = true; } else if c == 8 { cx_wheel(x, v); }
    }
  }
  if moved { if x[0].drag != 0 { cx_drag(x, dx, dy); } else { cx_pointer(x, cx_max(0, cx_min(x[0].w - 1, x[0].px + dx)), cx_max(0, cx_min(x[0].h - 1, x[0].py + dy))); } }
  return true;
}
cx_num :: (s: string) -> int {
  neg := s.count > 0 && s[0] == '-'; v := 0;
  for c: s[ifx neg then 1 else 0..<s.count] { if c >= '0' && c <= '9' { v = v * 10 + cast(int) (c - '0'); } }
  return ifx neg then -v else v;
}
cx_list :: (x: [] Cx) {
  m := x[0].wm[..];
  t: [WM_WINS] WmTile; n := wm_all_windows(m, t[..]);
  for i: 0..<n {
    s := x[0].win_surf[t[i].id]; if s < 0 { continue; }
    b: [512] u8; k := 0;
    for c: "win " { b[k] = c; k += 1; } k = cx_num_into(b[..], k, t[i].id); b[k] = ' '; k += 1;
    for c: "desk " { b[k] = c; k += 1; } k = cx_num_into(b[..], k, t[i].desk); b[k] = ' '; k += 1;
    fr: [4] int; cx_frame(x, t[i], wm_is_fullscreen(m, t[i].id), fr[..]);
    k = cx_num_into(b[..], k, fr[0]); b[k] = ','; k += 1; k = cx_num_into(b[..], k, fr[1]); b[k] = ' '; k += 1;
    k = cx_num_into(b[..], k, fr[2]); b[k] = 'x'; k += 1; k = cx_num_into(b[..], k, fr[3]);
    if t[i].id == wm_focus(m) { for c: " focused" { b[k] = c; k += 1; } }
    if t[i].floating { for c: " floating" { b[k] = c; k += 1; } }
    if wm_is_fullscreen(m, t[i].id) { for c: " fullscreen" { b[k] = c; k += 1; } }
    for c: " app=" { b[k] = c; k += 1; } for j: 0..<x[0].surfs[s].na { b[k] = x[0].surfs[s].app[j]; k += 1; }
    for c: " title=" { b[k] = c; k += 1; } for j: 0..<x[0].surfs[s].nt { b[k] = x[0].surfs[s].title[j]; k += 1; }
    cx_say(cast(string) b[0..<k]);
  }
  cx_say("end");
}
// ---- the desk protocol (--desk-socket)

// The raw text of "key":"..." in a request line (no escapes are taken apart: the values the desk
// protocol sends here are names, numbers and plain commands), or "".
cx_jtext :: (line: string, key: string) -> string {
  i := 0;
  while i + key.count + 4 <= line.count {
    if line[i] == '"' && line[i + 1..<i + 1 + key.count] == key && line[i + 1 + key.count] == '"' && line[i + 2 + key.count] == ':' && line[i + 3 + key.count] == '"' {
      st := i + 4 + key.count; e := st;
      while e < line.count && line[e] != '"' { if line[e] == '\\' { e += 1; } e += 1; }
      return line[st..<cx_min(e, line.count)];
    }
    i += 1;
  }
  return "";
}
// "key":N in a request line, or fallback.
cx_jint :: (line: string, key: string, fallback: int) -> int {
  i := 0;
  while i + key.count + 3 <= line.count {
    if line[i] == '"' && line[i + 1..<i + 1 + key.count] == key && line[i + 1 + key.count] == '"' && line[i + 2 + key.count] == ':' {
      k := i + 3 + key.count; neg := false;
      if k < line.count && line[k] == '-' { neg = true; k += 1; }
      if k >= line.count || line[k] < '0' || line[k] > '9' { return fallback; }
      v := 0; while k < line.count && line[k] >= '0' && line[k] <= '9' { v = v * 10 + cast(int) (line[k] - '0'); k += 1; }
      return ifx neg then -v else v;
    }
    i += 1;
  }
  return fallback;
}
#test "request fields" {
  l := "{\"generation\":1,\"type\":\"move\",\"x\":12,\"y\":-3,\"command\":\"foot -e top\"}";
  #assert cx_jtext(l, "type") == "move" && cx_jtext(l, "command") == "foot -e top" && cx_jtext(l, "none") == "";
  #assert cx_jint(l, "x", 0) == 12 && cx_jint(l, "y", 0) == -3 && cx_jint(l, "z", 7) == 7 && cx_jint(l, "type", 9) == 9;
}
cx_put :: (b: [] u8, k: int, s: string) -> int { n := k; for c: s { if n < b.count { b[n] = c; n += 1; } } return n; }
// a JSON string's body, escaped
cx_put_json :: (b: [] u8, k: int, s: string) -> int {
  n := k;
  for c: s {
    if n + 6 >= b.count { break; }
    if c == '"' || c == '\\' { b[n] = '\\'; b[n + 1] = c; n += 2; }
    else if c < 32 { b[n] = ' '; n += 1; }
    else { b[n] = c; n += 1; }
  }
  return n;
}
cx_hex_into :: (b: [] u8, k: int, v: int) -> int {
  d: [16] u8; m := 0; u := v; hex := "0123456789abcdef";
  while true { d[m] = hex[u % 16]; m += 1; u = u / 16; if u == 0 || m == 16 { break; } }
  n := k; for i: 0..<m { if n < b.count { b[n] = d[m - 1 - i]; n += 1; } }
  return n;
}
cx_bool_into :: (b: [] u8, k: int, v: bool) -> int { return cx_put(b, k, ifx v then "true" else "false"); }
// One window as the desk protocol has it.
cx_desk_window :: (x: [] Cx, t: WmTile, b: [] u8, at: int) -> int {
  m := x[0].wm[..];
  s := x[0].win_surf[t.id];
  fr: [4] int; cx_frame(x, t, wm_is_fullscreen(m, t.id), fr[..]);
  k := cx_put(b, at, "{\"handle\":\"0x"); k = cx_hex_into(b, k, t.id);
  k = cx_put(b, k, "\",\"desk\":"); k = cx_num_into(b, k, t.desk);
  k = cx_put(b, k, ",\"screen\":\"verse\",\"at\":{\"x\":"); k = cx_num_into(b, k, fr[0]); k = cx_put(b, k, ",\"y\":"); k = cx_num_into(b, k, fr[1]);
  k = cx_put(b, k, "},\"size\":{\"width\":"); k = cx_num_into(b, k, fr[2]); k = cx_put(b, k, ",\"height\":"); k = cx_num_into(b, k, fr[3]);
  k = cx_put(b, k, "},\"class\":\""); if s >= 0 { k = cx_put_json(b, k, cast(string) x[0].surfs[s].app[0..<x[0].surfs[s].na]); }
  k = cx_put(b, k, "\",\"title\":\""); if s >= 0 { k = cx_put_json(b, k, cast(string) x[0].surfs[s].title[0..<x[0].surfs[s].nt]); }
  k = cx_put(b, k, "\",\"focused\":"); k = cx_bool_into(b, k, t.id == wm_focus(m));
  k = cx_put(b, k, ",\"floating\":"); k = cx_bool_into(b, k, t.floating);
  k = cx_put(b, k, ",\"fullscreen\":"); k = cx_bool_into(b, k, wm_is_fullscreen(m, t.id));
  return cx_put(b, k, "}");
}
cx_desk_refused :: (b: [] u8, code: string, message: string) -> int {
  k := cx_put(b, 0, "{\"generation\":1,\"type\":\"refused\",\"code\":\""); k = cx_put(b, k, code);
  k = cx_put(b, k, "\",\"message\":\""); k = cx_put_json(b, k, message); return cx_put(b, k, "\"}\n");
}
cx_desk_done :: (b: [] u8) -> int { return cx_put(b, 0, "{\"generation\":1,\"type\":\"done\"}\n"); }
// One request's answer line into b: its length.
cx_desk_answer :: (x: [] Cx, o: [] CxFrame, line: string, b: [] u8) -> int {
  if cx_jint(line, "generation", -1) != 1 { return cx_desk_refused(b, "generation", "this desk speaks generation 1"); }
  ty := cx_jtext(line, "type"); m := x[0].wm[..];
  t: [WM_WINS] WmTile; n := wm_all_windows(m, t[..]);
  if ty == "list" {
    k := cx_put(b, 0, "{\"generation\":1,\"type\":\"windows\",\"windows\":["); first := true;
    for i: 0..<n { if x[0].win_surf[t[i].id] < 0 { continue; } if !first { k = cx_put(b, k, ","); } first = false; k = cx_desk_window(x, t[i], b, k); }
    return cx_put(b, k, "]}\n");
  }
  if ty == "focused" {
    k := cx_put(b, 0, "{\"generation\":1,\"type\":\"focused\",\"window\":"); found := false;
    for i: 0..<n { if t[i].id == wm_focus(m) && x[0].win_surf[t[i].id] >= 0 { k = cx_desk_window(x, t[i], b, k); found = true; } }
    if !found { k = cx_put(b, k, "null"); }
    return cx_put(b, k, "}\n");
  }
  if ty == "screens" {
    k := cx_put(b, 0, "{\"generation\":1,\"type\":\"screens\",\"screens\":[{\"name\":\"verse\",\"at\":{\"x\":0,\"y\":0},\"size\":{\"width\":");
    k = cx_num_into(b, k, x[0].w); k = cx_put(b, k, ",\"height\":"); k = cx_num_into(b, k, x[0].h);
    k = cx_put(b, k, "},\"scale\":1.0,\"desk\":"); f := wm_focus(m); k = cx_num_into(b, k, ifx f > 0 then wm_desk_of(m, f) else 1);
    return cx_put(b, k, "}]}\n");
  }
  if ty == "open" {
    cmd := cx_jtext(line, "command");
    if cmd.count == 0 || cmd.count > 2000 { return cx_desk_refused(b, "bad_request", "open needs a command"); }
    a: [2100] u8; an := 0;
    for c: "/bin/sh\0-c\0" { a[an] = c; an += 1; } for c: cmd { a[an] = c; an += 1; } a[an] = 0; an += 1;
    r := cxwl_run(a[0..<an], x[0].sock[0..<x[0].nsock]);
    return ifx r >= 0 then cx_desk_done(b) else cx_desk_refused(b, "spawn", "the command did not start");   // cxwl_run: 0, or -errno
  }
  if ty == "move" { cx_pointer(x, cx_max(0, cx_min(x[0].w - 1, cx_jint(line, "x", 0))), cx_max(0, cx_min(x[0].h - 1, cx_jint(line, "y", 0)))); return cx_desk_done(b); }
  if ty == "click" {
    if line.count > 0 && cx_jint(line, "x", -1) >= 0 { cx_pointer(x, cx_max(0, cx_min(x[0].w - 1, cx_jint(line, "x", 0))), cx_max(0, cx_min(x[0].h - 1, cx_jint(line, "y", 0)))); }
    btn := cx_jtext(line, "button"); code := ifx btn == "right" then 273 else ifx btn == "middle" then 274 else 272;
    cx_button(x, code, true); cx_button(x, code, false); return cx_desk_done(b);
  }
  if ty == "close" {
    hd := cx_jtext(line, "handle");
    id := -1;
    if hd.count > 2 && hd[0..<2] == "0x" { id = 0; for c: hd[2..<hd.count] { d := ifx c >= '0' && c <= '9' then cast(int) (c - '0') else ifx c >= 'a' && c <= 'f' then cast(int) (c - 'a') + 10 else -1; if d < 0 { id = -1; break; } id = id * 16 + d; } }
    if id <= 0 || id >= WM_WINS || x[0].win_surf[id] < 0 { return cx_desk_refused(b, "no_such_window", "no window with that handle"); }
    cx_close_win(x, id); return cx_desk_done(b);
  }
  if ty == "shot" {
    path := cx_jtext(line, "path");
    if path.count == 0 { return cx_desk_refused(b, "bad_request", "shot needs a path"); }
    return ifx cx_shot(x, o, path, true) then cx_desk_done(b) else cx_desk_refused(b, "shot", "the shot was not written");
  }
  return cx_desk_refused(b, "not_supported", "this desk does not do that yet");
}
// A desk client's bytes: each whole line answered; a client that left is let go.
cx_desk_read :: (x: [] Cx, o: [] CxFrame, h: int) {
  d := x[0].desks[..];
  got := cxwl_desk_recv(h, d[h].buf[d[h].n..<8192]);
  if got < 0 { r := cxwl_desk_close(h); d[h].on = false; return; }
  if got == 0 { return; }
  d[h].n += got; st := 0;
  for i: 0..<d[h].n {
    if d[h].buf[i] != '\n' { continue; }
    ans: [262144] u8; an := cx_desk_answer(x, o, cast(string) d[h].buf[st..<i], ans[..]);
    if cxwl_desk_send(h, ans[0..<an]) < 0 { r := cxwl_desk_close(h); d[h].on = false; return; }
    st = i + 1;
  }
  rest := d[h].n - st; for i: 0..<rest { d[h].buf[i] = d[h].buf[st + i]; } d[h].n = rest;
  if d[h].n == 8192 { d[h].n = 0; }
}

cx_command :: (x: [] Cx, o: [] CxFrame, line: string) {
  w: [8] string; nw := 0; st := 0;
  for i: 0..<line.count + 1 { if i == line.count || line[i] == ' ' { if nw < 8 && i > st { w[nw] = line[st..<i]; nw += 1; } st = i + 1; } }
  if nw == 0 { return; }
  c := w[0]; m := x[0].wm[..];
  if c == "list" { cx_list(x); }
  else if c == "shot" && nw == 2 { cx_say(ifx cx_shot(x, o, w[1], true) then "shot" else "shot failed"); }
  else if c == "move" && nw == 3 { cx_pointer(x, cx_num(w[1]), cx_num(w[2])); cx_say("ok"); }
  else if c == "click" { cx_click(x); cx_say("ok"); }
  else if c == "keydown" && nw == 3 { cx_input_key(x, cx_num(w[1]), w[2] == "1"); cx_say("ok"); }   // one key, held (1) or let go (0)
  else if c == "button" && nw == 3 { cx_mouse_button(x, cx_num(w[1]), w[2] == "1"); cx_say("ok"); }
  else if c == "mouse" && nw == 3 {   // relative motion, as a mouse sends it
    dx := cx_num(w[1]); dy := cx_num(w[2]);
    if x[0].drag != 0 { cx_drag(x, dx, dy); } else { cx_pointer(x, cx_max(0, cx_min(x[0].w - 1, x[0].px + dx)), cx_max(0, cx_min(x[0].h - 1, x[0].py + dy))); }
    cx_say("ok");
  }
  else if c == "key" && nw == 2 { cx_input_key(x, cx_num(w[1]), true); cx_input_key(x, cx_num(w[1]), false); cx_say("ok"); }
  else if c == "chord" && nw >= 2 {   // keys pressed in order, released in reverse
    for i: 1..<nw { cx_input_key(x, cx_num(w[i]), true); }
    i := nw - 1; while i >= 1 { cx_input_key(x, cx_num(w[i]), false); i -= 1; }
    cx_say("ok");
  }
  else if c == "text" {
    text := ifx line.count > 5 then line[5..<line.count] else "";
    for ch: text {
      sh: [1] bool; code := cx_char_key(ch, sh[..]); if code == 0 { continue; }
      if sh[0] { cx_input_key(x, 42, true); }
      cx_input_key(x, code, true); cx_input_key(x, code, false);
      if sh[0] { cx_input_key(x, 42, false); }
    }
    cx_say("ok");
  }
  else if c == "close" { cx_close_focused(x); cx_say("ok"); }
  else if c == "wm" && nw >= 2 {
    cx_damage_all(x);
    v := w[1]; a1 := ifx nw > 2 then cx_num(w[2]) else 0;
    if v == "movefocus" { wm_movefocus(m, a1); } else if v == "movewindow" { wm_movewindow(m, a1); }
    else if v == "resize" && nw > 3 { wm_resize(m, a1, cast(f32) cx_num(w[3]) / 100.0); }
    else if v == "togglesplit" { wm_togglesplit(m); } else if v == "togglefloating" { wm_togglefloating(m); }
    else if v == "fullscreen" { wm_fullscreen(m); } else if v == "maximize" { wm_maximize(m); }
    else if v == "switch" { wm_switch_workspace(m, a1); } else if v == "moveto" { wm_movetoworkspace(m, a1); }
    else if v == "to_screen" { f := wm_focus(m); if f != 0 { y := wm_move_to_screen(m, f, a1); } }   // a direction: 0 left, 1 right, 4 next
    else { cx_say("unknown wm verb"); return; }
    cx_sync(x); cx_say("ok");
  }
  else if c == "frame" && nw == 2 {   // only what was damaged: says the box it drew
    d: [4] int; for i: 0..<4 { d[i] = x[0].dmg[i]; }
    ok := cx_shot(x, o, w[1], false);
    b: [128] u8; n := 0; for ch: "frame " { b[n] = ch; n += 1; }
    if d[2] <= d[0] { for ch: "nothing" { b[n] = ch; n += 1; } }
    else { n = cx_num_into(b[..], n, d[0]); b[n] = ','; n += 1; n = cx_num_into(b[..], n, d[1]); b[n] = ' '; n += 1; n = cx_num_into(b[..], n, d[2]); b[n] = ','; n += 1; n = cx_num_into(b[..], n, d[3]); }
    if !ok { for ch: " failed" { b[n] = ch; n += 1; } }
    cx_say(cast(string) b[0..<n]);
  }
  else if c == "pointer" && nw == 2 { x[0].show_pointer = w[1] == "on"; cx_say("ok"); }   // draw the pointer in shots too
  else if c == "bench" && nw == 2 {   // composites N times: the milliseconds a frame takes
    k := cx_max(cx_num(w[1]), 1); t0 := cxwl_ms();
    for i: 0..<k { cx_damage_all(x); cx_composite(x, o); }
    b: [64] u8; n := cx_num_into(b[..], 0, (cxwl_ms() - t0) * 1000 / k); for ch: " us a frame" { b[n] = ch; n += 1; }
    cx_say(cast(string) b[0..<n]);
  }
  else if c == "xlist" {   // the X windows the window manager knows: id, surface id, surface, override, mapped, window
    for i: 0..<CX_XWINS {
      q := x[0].xw[0].wins[i]; if !q.used { continue; }
      b: [256] u8; n := 0;
      for ch: "x " { b[n] = ch; n += 1; } n = cx_num_into(b[..], n, q.id); b[n] = ' '; n += 1; n = cx_num_into(b[..], n, q.sid); b[n] = ' '; n += 1;
      n = cx_num_into(b[..], n, q.s); b[n] = ' '; n += 1; n = cx_num_into(b[..], n, ifx q.ovr then 1 else 0); b[n] = ' '; n += 1;
      n = cx_num_into(b[..], n, ifx q.mapped then 1 else 0); b[n] = ' '; n += 1; n = cx_num_into(b[..], n, q.win);
      cx_say(cast(string) b[0..<n]);
    }
    b2: [512] u8; n2 := 0; for ch: "atoms" { b2[n2] = ch; n2 += 1; }
    for i: 0..<XW_ATOMS { b2[n2] = ' '; n2 += 1; n2 = cx_num_into(b2[..], n2, x[0].xw[0].atoms[i]); }
    for ch: " seen" { b2[n2] = ch; n2 += 1; }
    for i: 0..<40 { if x[0].xw[0].seen[i] > 0 { b2[n2] = ' '; n2 += 1; n2 = cx_num_into(b2[..], n2, i); b2[n2] = ':'; n2 += 1; n2 = cx_num_into(b2[..], n2, x[0].xw[0].seen[i]); } }
    for ch: " err " { b2[n2] = ch; n2 += 1; } n2 = cx_num_into(b2[..], n2, x[0].xw[0].err); b2[n2] = '/'; n2 += 1; n2 = cx_num_into(b2[..], n2, x[0].xw[0].err_op);
    cx_say(cast(string) b2[0..<n2]);
  }
  else if c == "quit" { x[0].quit = true; cx_say("bye"); }
  else if c == "gpu" {
    msg: [256] u8; n := cx_put(msg[..], 0, "gpu live "); n = cx_num_into(msg[..], n, cxgpu_stat(0));
    n = cx_put(msg[..], n, " imports "); n = cx_num_into(msg[..], n, cxgpu_stat(1));
    n = cx_put(msg[..], n, " captures "); n = cx_num_into(msg[..], n, cxgpu_stat(2)); cx_say(cast(string) msg[0..<n]);
  }
  else { cx_say("unknown command"); }
}

// "WxH,WxH": the count read into w and h, 0 for "", or -1.
cx_screens_parse :: (text: string, w: [] int, h: [] int) -> int {
  if text.count == 0 { return 0; }
  n := 0; st := 0;
  for e: 0..<text.count + 1 {
    if e < text.count && text[e] != ',' { continue; }
    p := text[st..<e]; st = e + 1; xat := -1;
    for i: 0..<p.count { if p[i] == 'x' { xat = i; } else if p[i] < '0' || p[i] > '9' { return -1; } }
    if xat <= 0 || xat == p.count - 1 || n >= w.count { return -1; }
    w[n] = cx_num(p[0..<xat]); h[n] = cx_num(p[xat + 1..<p.count]);
    if w[n] < 64 || h[n] < 64 { return -1; }
    n += 1;
  }
  return n;
}
tool_main :: () -> int #export_c {
  a: [1] Args; ok := args_load(a[..]);
  desk_sock := ""; render_node := "/dev/dri/renderD128";
  pos: [5] string; np := 0; want_screen := false; input := ""; screens := ""; want_x := false; check := false; ai := 0; leave_to := 0;
  while ok && ai < args_count(a[..]) {
    v := args_at(a[..], ai);
    if v == "--screen" { want_screen = true; }
    else if v == "--input" && ai + 1 < args_count(a[..]) { ai += 1; input = args_at(a[..], ai); }
    else if v == "--screens" && ai + 1 < args_count(a[..]) { ai += 1; screens = args_at(a[..], ai); }
    else if v == "--xwayland" { want_x = true; }
    else if v == "--render-node" && ai + 1 < args_count(a[..]) { ai += 1; render_node = args_at(a[..], ai); }
    else if v == "--leave-to" && ai + 1 < args_count(a[..]) { ai += 1; leave_to = cx_num(args_at(a[..], ai)); }
    else if v == "--check" { check = true; }
    else if v == "--desk-socket" && ai + 1 < args_count(a[..]) { ai += 1; desk_sock = args_at(a[..], ai); }   // start up (socket, keymap, rules), say ready, and leave: the update agent's trial
    else if np < 5 { pos[np] = v; np += 1; } else { ok = false; }
    ai += 1;
  }
  if !ok || (np != 3 && np != 5) { tool_errln("usage: compositor SOCKET KEYMAP LAUNCH-DIR [W H] [--screens WxH,WxH...] [--xwayland] [--screen] [--leave-to VT] [--input FILE] [--desk-socket PATH]"); return 2; }
  cc: [1] Cx; x := cc[..]; ff: [1] CxFrame; fr := ff[..];
  x[0].w = 1280; x[0].h = 720;
  if np == 5 { x[0].w = cx_num(pos[3]); x[0].h = cx_num(pos[4]); }
  // --screens: headless screens side by side, left to right, each WxH
  sw: [8] int; sh: [8] int; ns := cx_screens_parse(screens, sw[..], sh[..]);
  if ns < 0 { tool_errln("compositor: --screens is WxH,WxH... (up to 8)"); return 2; }
  if ns > 0 { x[0].w = 0; x[0].h = 0; for i: 0..<ns { x[0].w += sw[i]; x[0].h = cx_max(x[0].h, sh[i]); } }
  if want_screen {
    vt := cxvt_open();   // before the screen: the VT's switches are ours, its text off
    r := cxscr_open();
    if r < 0 { q := cxvt_close(0); }
    if r < 0 { tool_err("compositor: cannot take the screen (step "); tool_err(ifx r == -2 then "2: another program holds it; run from a free VT" else ifx r == -1 then "1: no display device" else "3-6: no usable screen or mode"); tool_errln(")"); return 1; }
    x[0].w = cxscr_width(); x[0].h = cxscr_height(); x[0].screen = true; x[0].show_pointer = true;
  }
  if want_screen || input.count > 0 {
    ip: [1024] u8; ipn := 0; for c: input { if ipn < 1024 { ip[ipn] = c; ipn += 1; } }
    r := cxin_open(ip[0..<ipn]);
    if r < 0 { tool_errln("compositor: cannot open the input"); if want_screen { r = cxscr_close(); r = cxvt_close(0); } return 1; }
  }
  x[0].px = x[0].w / 2; x[0].py = x[0].h / 2;
  for c: pos[2] { if x[0].nlaunch < 512 { x[0].launch[x[0].nlaunch] = c; x[0].nlaunch += 1; } }
  if x[0].w < 64 || x[0].h < 64 || x[0].w > CX_MAXW || x[0].h > CX_MAXH { tool_errln("compositor: the screen is 64x64 to 3840x2160"); return 2; }
  n := fs_read(pos[1], x[0].keymap[0..<131071]);
  if n <= 0 { tool_errln("compositor: cannot read the keymap"); return 1; }
  x[0].nkeymap = n; x[0].keymap[n] = 0;
  wm_new(x[0].wm[..]);
  if ns == 0 { wm_set_screen(x[0].wm[..], 0, wm_screen("headless", 0, 0, x[0].w, x[0].h)); }
  else {
    left := 0;
    for i: 0..<ns {
      if i == 0 { wm_set_screen(x[0].wm[..], 0, wm_screen("headless-1", 0, 0, sw[0], sh[0])); }
      else if wm_add_screen(x[0].wm[..], wm_screen(ifx i == 1 then "headless-2" else ifx i == 2 then "headless-3" else "headless-n", left, 0, sw[i], sh[i])) < 0 { tool_errln("compositor: too many screens"); return 2; }
      left += sw[i];
    }
  }
  for i: 0..<WM_WINS { x[0].win_surf[i] = -1; }
  x[0].kfocus = -1; x[0].pfocus = -1; x[0].sel = -1; x[0].cursor = -1;
  sock := pos[0]; sp: [256] u8; sn := 0; for c: sock { if sn < 255 { sp[sn] = c; sn += 1; } }
  for i: 0..<sn { x[0].sock[i] = sp[i]; } x[0].nsock = sn;
  r := cxwl_listen(sp[0..<sn]);
  if desk_sock.count > 0 {
    dp: [1024] u8; dn := 0; for c: desk_sock { if dn < 1023 { dp[dn] = c; dn += 1; } }
    x[0].desk_on = cxwl_desk_listen(dp[0..<dn]) == 0;
    if !x[0].desk_on { tool_errln("compositor: no desk socket there"); }
  }
  if r < 0 { tool_errln("compositor: cannot listen on the socket"); return 1; }
  x[0].xw[0].client = -1;
  if want_x {   // Xwayland, rootless, before the start list so it sees DISPLAY
    node: [256] u8; nn := cx_min(render_node.count, 255); for i: 0..<nn { node[i] = render_node[i]; }
    x[0].ngpu = cx_max(0, cxgpu_open(node[0..<nn]));
    xn := cxwl_xwayland();
    if xn < 0 { tool_errln("compositor: cannot start Xwayland"); }
    else { x[0].xw[0].on = true; x[0].xw[0].display = xn; xw_setup(x[0].xw[0].o[..]); cx_xw_flush(x); }
  }
  y := cx_rules_parse(x[0].rules[..], CX_BUILTIN_RULES);
  rp: [1024] u8; rn := 0; for i: 0..<x[0].nlaunch { rp[rn] = x[0].launch[i]; rn += 1; } for c: "/rules" { rp[rn] = c; rn += 1; }
  rt: [65536] u8; rl := fs_read(cast(string) rp[0..<rn], rt[..]);
  if rl > 0 && cx_rules_parse(x[0].rules[..], cast(string) rt[0..<rl]) < 0 { tool_errln("compositor: a line of the rules file cannot be read"); return 2; }
  cx_damage_all(x);
  cx_say("ready");
  if check { x[0].quit = true; }
  // the session's start list (Hyprland's exec-once rows), as one program the system writes
  sp2: [1024] u8; stn := 0; for i: 0..<x[0].nlaunch { sp2[stn] = x[0].launch[i]; stn += 1; } for c: "/start" { sp2[stn] = c; stn += 1; }
  if !check && cxwl_spawn(sp2[0..<stn], sp[0..<sn]) > 0 { cx_say("exec start"); }
  last := cxwl_ms(); stdin_open := true; input_open := want_screen || input.count > 0;
  while !x[0].quit {
    p := cxwl_poll(8, ifx stdin_open then 1 else 0);
    while true {
      h := cxwl_accept(); if h == -1 { break; }
      if h < 0 { continue; }
      for ci: 0..<CX_CLIENTS {
        if !x[0].clients[ci].used {
          x[0].clients[ci].used = true; x[0].clients[ci].h = h; x[0].clients[ci].nin = 0; x[0].clients[ci].nfd = 0;
          x[0].clients[ci].nk = 0; x[0].clients[ci].npt = 0; x[0].clients[ci].no = 0; x[0].clients[ci].nd = 0; x[0].clients[ci].next_offer = 0;
          for k: 0..<64 { x[0].clients[ci].offers[k] = -1; }
          for o: 0..<CX_OBJS { x[0].clients[ci].objs[o].kind = K_NONE; }
          x[0].clients[ci].objs[1] = CxObj.{kind = K_DISPLAY, ver = 1};
          if h == cxwl_xwayland_handle() { x[0].xw[0].client = ci; }
          break;
        }
      }
    }
    for ci: 0..<CX_CLIENTS { if x[0].clients[ci].used && !cx_read_client(x, ci) { if x[0].clients[ci].used { if ci == x[0].xw[0].client { cx_xw_off(x); x[0].xw[0].client = -1; } cx_drop_client(x, ci); } } }
    cx_xw_tick(x);
    if stdin_open {
      got := cxwl_stdin(x[0].line[x[0].nline..<8192]);
      if got < 0 { stdin_open = false; }
      else if got > 0 {
        x[0].nline += got; st := 0;
        for i: 0..<x[0].nline { if x[0].line[i] == '\n' { cx_command(x, fr, cast(string) x[0].line[st..<i]); st = i + 1; } }
        rest := x[0].nline - st; for i: 0..<rest { x[0].line[i] = x[0].line[st + i]; } x[0].nline = rest;
        if x[0].nline == 8192 { x[0].nline = 0; }
      }
    }
    if x[0].desk_on {
      while true { h := cxwl_desk_accept(); if h < 0 { break; } x[0].desks[h].on = true; x[0].desks[h].n = 0; }
      for h: 0..<CX_DESKS { if x[0].desks[h].on { cx_desk_read(x, fr, h); } }
    }
    cx_close_answer(x);
    if input_open && !cx_input(x) { input_open = false; cx_say("input ended"); }
    if x[0].screen {
      e := cxvt_poll();
      if e == 1 { cx_vt_away(x); cx_say("vt away"); }
      else if e == 2 { cx_damage_all(x); for i: 0..<4 { x[0].prev[i] = x[0].dmg[i]; } cx_say("vt back"); }
    }
    now := cxwl_ms();
    if now - last >= 16 {
      if x[0].screen && x[0].dirty {
        // the back buffer last showed the frame before, so it takes this damage and that frame's
        y0 := x[0].dmg[1]; y1 := x[0].dmg[3];
        if x[0].prev[3] > x[0].prev[1] { y0 = cx_min(y0, x[0].prev[1]); y1 = cx_max(y1, x[0].prev[3]); }
        for i: 0..<4 { x[0].prev[i] = x[0].dmg[i]; }   // (a frame the screen refuses is drawn again next tick)
        cx_composite(x, fr);
        if cxscr_present(fr[0].b[..], y0, y1) == 0 { x[0].dirty = false; } else { for i: 0..<4 { x[0].dmg[i] = x[0].prev[i]; } }
      }   // the frame clock: every waiting frame callback hears it
      last = now; g := x[0].g[..];
      for i: 0..<x[0].ndue {
        d := x[0].due[i];
        if !x[0].clients[d.client].used { continue; }
        mg_begin(g, d.id, 0); mg_put(g, now & 4294967295); mg_end(g); mg_flush(x, d.client, -1); cx_delete(x, d.client, d.id);
      }
      x[0].ndue = 0;
    }
  }
  for ci: 0..<CX_CLIENTS { if x[0].clients[ci].used { cx_drop_client(x, ci); } }
  r = cxwl_unlisten(sp[0..<sn]); r = cxwl_xwayland_stop();
  r = cxgpu_close();
  if input_open || want_screen || input.count > 0 { r = cxin_close(); }
  if x[0].screen { r = cxscr_close(); r = cxvt_close(leave_to); }
  return 0;
}

#test "a popup's place from its positioner" {
  pl: [2] int;
  cx_popup_place(CxPos.{w = 100, h = 50, ax = 10, ay = 20, aw = 30, ah = 40, anchor = 8, gravity = 8}, pl[..]); #assert pl[0] == 40 && pl[1] == 60;
  cx_popup_place(CxPos.{w = 100, h = 50, ax = 10, ay = 20, aw = 30, ah = 40, anchor = 5, gravity = 5, dx = 2, dy = 3}, pl[..]); #assert pl[0] == -88 && pl[1] == -27;
  cx_popup_place(CxPos.{w = 100, h = 50, ax = 0, ay = 0, aw = 30, ah = 40}, pl[..]); #assert pl[0] == -35 && pl[1] == -5;
}
#test "the CoderOS bindings" {
  #assert cx_bind(34, CX_SUPER).verb == B_EXEC && cx_program(cx_bind(34, CX_SUPER).arg) == "battlenet";
  #assert cx_bind(34, 0).verb == B_NONE;
  S := CX_SUPER;
  #assert cx_bind(28, S).verb == B_EXEC && cx_program(cx_bind(28, S).arg) == "coder" && cx_bind(28, 0).verb == B_NONE;
  #assert cx_bind(105, S).verb == B_FOCUS && cx_bind(105, S).arg == WM_LEFT && cx_bind(108, S | CX_SHIFT).verb == B_MOVE && cx_bind(108, S | CX_SHIFT).arg == WM_DOWN;
  #assert cx_bind(3, S).verb == B_DESK && cx_bind(3, S).arg == 1 && cx_bind(10, S | CX_SHIFT).verb == B_TO_DESK && cx_bind(10, S | CX_SHIFT).arg == 8;
  #assert cx_bind(17, S).verb == B_CLOSE && cx_bind(16, S).verb == B_CLOSE && cx_bind(17, S | CX_SHIFT).verb == B_NONE;
  #assert cx_bind(33, S).verb == B_FULL && cx_bind(33, S | CX_CTRL).verb == B_MAX && cx_bind(106, S | CX_CTRL).verb == B_RESIZE;
  #assert cx_bind(15, CX_CTRL | CX_ALT).arg == WM_NEXT && cx_bind(15, CX_CTRL | CX_ALT | CX_SHIFT).arg == WM_PREVIOUS && cx_bind(15, S).verb == B_NONE;
  #assert cx_bind(103, S | CX_ALT).verb == B_SCREEN && cx_bind(103, S | CX_SHIFT | CX_ALT).verb == B_TO_SCREEN && cx_bind(103, S | CX_CTRL | CX_ALT).verb == B_DESK_TO_SCREEN;
  #assert cx_bind(57, S).verb == B_FLOAT && cx_bind(32, S).verb == B_FLOAT && cx_bind(36, S).verb == B_SPLIT && cx_program(cx_bind(20, S).arg) == "pane" && cx_program(cx_bind(30, S).arg) == "android";
  #assert cx_bind(30, 0).verb == B_NONE && cx_bind(30, CX_SHIFT).verb == B_NONE;
  #assert cx_program(cx_bind(46, S).arg) == "camera" && cx_bind(18, S | CX_SHIFT).verb == B_QUIT && cx_bind(14, CX_CTRL | CX_ALT).verb == B_QUIT;
}
#test "the --screens list" {
  w: [8] int; h: [8] int;
  #assert cx_screens_parse("", w[..], h[..]) == 0 && cx_screens_parse("800x600,640x480", w[..], h[..]) == 2 && w[1] == 640 && h[0] == 600;
  #assert cx_screens_parse("800", w[..], h[..]) == -1 && cx_screens_parse("x600", w[..], h[..]) == -1 && cx_screens_parse("800x600,", w[..], h[..]) == -1 && cx_screens_parse("8x8", w[..], h[..]) == -1;
}
#test "window rules: patterns and the file format" {
  rs: [1] CxRules;
  #assert cx_rules_parse(rs[..], CX_BUILTIN_RULES) == 2 && rs[0].r[0].pin && rs[0].r[0].aspect && rs[0].r[0].noborder && rs[0].r[0].floats == 1 && !rs[0].r[1].aspect;
  #assert cx_rules_parse(rs[..], "# host\nclass icase prefix=Emulator holds=pixel tile\ntitle exact=a%20b exact=c nofullscreen center\n") == 2;
  e := rs[0].r[2]; t := rs[0].r[3];
  #assert e.by_class && e.icase && e.floats == 0 && cx_rule_matches(e, "", "emulator-Pixel_7") && !cx_rule_matches(e, "", "emulator") && !cx_rule_matches(e, "emulator-pixel", "x");
  #assert cx_rule_matches(t, "a b", "") && cx_rule_matches(t, "c", "") && !cx_rule_matches(t, "A b", "") && t.nofull && t.center;
  #assert cx_rule_matches(rs[0].r[0], "selfie", "") && !cx_rule_matches(rs[0].r[0], "selfie2", "");
  #assert cx_rules_parse(rs[..], "window exact=x\n") == -1 && cx_rules_parse(rs[..], "title float\n") == -1;
}
#test "US text to evdev keys" {
  sh: [1] bool;
  #assert cx_char_key('a', sh[..]) == 30 && !sh[0] && cx_char_key('A', sh[..]) == 30 && sh[0] && cx_char_key('!', sh[..]) == 2 && sh[0];
  #assert cx_char_key(' ', sh[..]) == 57 && cx_char_key('\n', sh[..]) == 28 && cx_char_key('/', sh[..]) == 53 && cx_char_key('|', sh[..]) == 43 && sh[0];
}
#test "outgoing messages: header size and padded strings" {
  gg: [1] CxMsg; g := gg[..];
  mg_begin(g, 7, 2); mg_str(g, "abc"); mg_put(g, 9); mg_end(g);
  #assert g[0].n == 20 && cx_rd(g[0].b[..], 0) == 7 && cx_rd(g[0].b[..], 4) == (20 << 16) | 2 && cx_rd(g[0].b[..], 8) == 4 && g[0].b[15] == 0 && cx_rd(g[0].b[..], 16) == 9;
}
