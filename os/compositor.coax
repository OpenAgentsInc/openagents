cxwl_map :: (fd: int, size: int) -> int #foreign;
cxwl_unmap :: (m: int) -> int #foreign;
cxwl_remap :: (m: int, fd: int, size: int) -> int #foreign;
cxwl_read :: (m: int, fd: int, offset: int, out: [] u8) -> int #foreign;
cxwl_memfd :: (s: [] u8) -> int #foreign;
cxwl_ms :: () -> int #foreign;
cxwl_stdin :: (out: [] u8) -> int #foreign;
cxwl_out :: (s: [] u8) -> int #foreign;
cxwl_spawn :: (path: [] u8, display: [] u8) -> int #foreign;
cxwl_fits :: (m: int, fd: int, end: int) -> int #foreign;
cxwl_peer_pid :: (h: int) -> int #foreign;
cxwl_tree :: (pid: int) -> int #foreign;
cxwl_tree_at :: (i: int) -> int #foreign;
cxwl_ask_start :: (args: [] u8) -> int #foreign;
cxwl_ask_poll :: (out: [] u8) -> int #foreign;
cxwl_ask_len :: () -> int #foreign;
cxwl_run :: (args: [] u8, display: [] u8) -> int #foreign;
cxwl_xwayland :: () -> int #foreign;
cxwl_xwayland_handle :: () -> int #foreign;
cxwl_xwayland_stop :: () -> int #foreign;
cxwl_desk_listen :: (path: [] u8) -> int #foreign;
cxwl_desk_accept :: () -> int #foreign;
cxwl_desk_recv :: (h: int, out: [] u8) -> int #foreign;
cxwl_desk_send :: (h: int, s: [] u8) -> int #foreign;
cxwl_desk_close :: (h: int) -> int #foreign;
cxx_send :: (b: [] u8) -> int #foreign;
cxx_recv :: (out: [] u8) -> int #foreign;
cxscr_open :: () -> int #foreign;
cxscr_width :: () -> int #foreign;
