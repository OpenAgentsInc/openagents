// CoderOS's CPU limits (docs/os/2026-10-30-coderos-and-coax-audit.md, step 2 row 1): the Coax
// program that replaces coderos-cpu-limits.nix's shell, run by the same systemd unit (boot, resume
// and every 5 minutes). The policy is os/cpu-limits-policy.coax (#authority); this reads and
// writes sysfs. It prints what the shell printed, so the unit's journal reads the same.
//   coax/web/tool.sh os/cpu-limits.coax [--root DIR] [--dry-run]
// --root DIR reads and writes under DIR instead of / (a copy of sysfs, for checks); --dry-run
// writes nothing and prints each write it would make, with the value there now.
#import "Basic";
#load "../coax/lib/sys/tool.coax";
#load "../coax/lib/sys/fs.coax";
#load "../coax/lib/sys/args.coax";
#load "cpu-limits-policy.coax";

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("usage: cpu-limits [--root DIR] [--dry-run]"); return 2; }
  root := args_value(a[..], "--root", "");
  dry := args_has(a[..], "--dry-run");
  b: [4] [1024] u8;
  zones := cl_cat(root, "/sys/class/powercap", b[0][..]);
  l: [1] FsList;
  n := fs_list(zones, l[..]);
  applied := 0;
  for i: 0..<ifx n > 0 then n else 0 {
    name := fs_entry(l[..], i);
    if !cl_package(name) { continue; }
    dir := fs_join(zones, name, b[1][..]);
    if !fs_exists(fs_join(dir, "name", b[2][..])) { continue; }
    for c: 0..<CL_CONSTRAINTS {
      if !cl_constraint(c) { continue; }
      lb: [64] u8;
      limit := fs_join(dir, cl_limit_name(c, lb[..]), b[2][..]);
      if !fs_exists(limit) { continue; }
      if cl_put(limit, cl_ceiling_text(), dry) { applied += 1; }
      else { now: [64] u8; print("constraint % on % is locked; leaving it at %\n", c, name, cl_text(limit, now[..])); }
    }
  }
  print("power ceiling 125 W applied to % constraint(s)\n", applied);
  pstate := cl_cat(root, "/sys/devices/system/cpu/intel_pstate/max_perf_pct", b[3][..]);
  if fs_exists(pstate) && cl_put(pstate, cl_perf_text(), dry) {
    now: [64] u8;
    print("max_perf_pct set to %\n", ifx dry then cl_perf_text() else cl_text(pstate, now[..]));
  } else { print("intel_pstate is not in use; no frequency ceiling applied\n"); }
  return 0;
}

// Writes text to a sysfs file (a dry run prints it with the value there now): whether it took.
cl_put :: (path: string, text: string, dry: bool) -> bool {
  if dry { now: [64] u8; print("would write % to % (now %)\n", text, path, cl_text(path, now[..])); return true; }
  return fs_write(path, text);
}
// A small file's text without its trailing newline, "" when unreadable.
cl_text :: (path: string, out: [] u8) -> string {
  m := fs_read(path, out);
  if m <= 0 { return ""; }
  while m > 0 && (out[m - 1] == '\n' || out[m - 1] == ' ') { m -= 1; }
  return cast(string) out[0..<m];
}
// constraint_C_power_limit_uw
cl_limit_name :: (c: int, out: [] u8) -> string {
  t := "constraint_";
  for i: 0..<t.count { out[i] = t[i]; }
  out[t.count] = cast,trunc(u8) ('0' + c);
  r := "_power_limit_uw";
  for i: 0..<r.count { out[t.count + 1 + i] = r[i]; }
  return cast(string) out[0..<t.count + 1 + r.count];
}
cl_cat :: (x: string, y: string, out: [] u8) -> string {
  if x.count + y.count > out.count { return ""; }
  for i: 0..<x.count { out[i] = x[i]; }
  for i: 0..<y.count { out[x.count + i] = y[i]; }
  return cast(string) out[0..<x.count + y.count];
}
#test "a constraint's file name" {
  b: [64] u8;
  #assert cl_limit_name(0, b[..]) == "constraint_0_power_limit_uw" && cl_limit_name(1, b[..]) == "constraint_1_power_limit_uw";
}
