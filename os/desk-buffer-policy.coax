// Admission of GPU-backed desk buffers. The driver supplies the advertised modifier catalogue;
// matching that catalogue does not authenticate a client. Import failure refuses the buffer.
#authority;

DESK_AR24 :: 875713089;
DESK_XR24 :: 875713112;

#test "RGB buffers fit the desk, including each boundary" {
  #assert desk_buffer(1, 1, 4, 0, DESK_AR24, 0, true);
  #assert desk_buffer(3840, 2160, 65536, 4294967295, DESK_XR24, 0, true);
  #assert desk_buffer(3840, 2160, 15360, 0, DESK_XR24, 0, true);
  #assert !desk_buffer(0, 1, 4, 0, DESK_AR24, 0, true);
  #assert !desk_buffer(3841, 1, 20000, 0, DESK_AR24, 0, true);
  #assert !desk_buffer(1, 0, 4, 0, DESK_AR24, 0, true);
  #assert !desk_buffer(1, 2161, 4, 0, DESK_AR24, 0, true);
}
#test "pitch offset format flags and advertised modifier are all required" {
  #assert !desk_buffer(2, 1, 7, 0, DESK_AR24, 0, true);
  #assert !desk_buffer(1, 1, 65537, 0, DESK_AR24, 0, true);
  #assert !desk_buffer(1, 1, 4, -1, DESK_AR24, 0, true);
  #assert !desk_buffer(1, 1, 4, 4294967296, DESK_AR24, 0, true);
  #assert !desk_buffer(1, 1, 4, 0, 0, 0, true);
  #assert !desk_buffer(1, 1, 4, 0, DESK_AR24, 1, true);
  #assert !desk_buffer(1, 1, 4, 0, DESK_AR24, 0, false);
}
#test "one plane, one descriptor, one use" {
  #assert desk_plane(false, false, 0, 0);
  #assert desk_plane(false, false, 0, 999);
  #assert !desk_plane(true, false, 0, 0);
  #assert !desk_plane(false, true, 0, 0);
  #assert !desk_plane(false, false, 1, 0);
  #assert !desk_plane(false, false, 0, -1);
}

desk_buffer :: (w: int, h: int, stride: int, offset: int, fmt: int, flags: int, advertised: bool) -> bool {
  if w < 1 || w > 3840 || h < 1 || h > 2160 { return false; }
  if stride < w * 4 || stride > 65536 || offset < 0 || offset > 4294967295 { return false; }
  return (fmt == DESK_AR24 || fmt == DESK_XR24) && flags == 0 && advertised;
}
desk_plane :: (used: bool, has_plane: bool, plane: int, fd: int) -> bool {
  return !used && !has_plane && plane == 0 && fd >= 0;
}
