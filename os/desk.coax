  #assert dk_request(u7[..], b[..]).bad != "" && dk_request(u8[..], b[..]).bad != "" && dk_request(u9[..], b[..]).bad != "";
  #assert dk_request(ua[..], b[..]).bad != "" && dk_request(ub[..], b[..]).bad != "" && dk_request(uc[..], b[..]).bad != "";
