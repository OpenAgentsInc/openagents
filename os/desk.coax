dk_line :: (r: Ask) -> string { return ifx r.bad == "" then cast(string) r.out[0..<r.n] else r.bad; }

// ---- the answer

// What one answer says: its type, or why it cannot be read.
DK_READ_OK :: 0;
// Checks an answer's generation and type: "" when it is `want`, else the stderr sentence and its
// exit status in code.
Verdict :: struct { say: string; code: int; }
dk_verdict :: (d: Jv, want: string, msg: [] u8) -> Verdict {
  if !d.ok || jv_kind(d, 0) != JV_OBJECT { return Verdict.{say = "error: the desk answered something this client cannot read", code = DK_UNREADABLE}; }
  ty := jv_raw(d, jv_get(d, 0, "type"));
  if ty == "refused" {
    n := jv_str(d, jv_get(d, 0, "message"), msg);
    return Verdict.{say = cast(string) msg[0..<ifx n > 0 then n else 0], code = DK_REFUSED};
  }
  if jv_int(d, jv_get(d, 0, "generation"), -1) != DK_GENERATION { return Verdict.{say = "error: this client speaks generation 1 of the desk protocol and the desk answered another", code = DK_UNREADABLE}; }
  if ty != "windows" && ty != "screens" && ty != "focused" && ty != "status" && ty != "done" { return Verdict.{say = "error: the desk answered a reply this client does not know", code = DK_UNREADABLE}; }
  if ty != want { return Verdict.{say = "error: the desk answered with a reply this verb does not take", code = DK_UNREADABLE}; }
  return Verdict.{};
}
#test "answers: refused, other generations, unknown and wrong replies" {
  nodes: [64] JvNode; d: [1] Jv; m: [256] u8;
  #assert jv_parse(d[..], "{\"generation\":1,\"type\":\"done\"}", nodes[..]) && dk_verdict(d[0], "done", m[..]).code == 0;
  #assert jv_parse(d[..], "{\"generation\":1,\"type\":\"refused\",\"code\":\"no_such_window\",\"message\":\"no window w\"}", nodes[..]);
  v := dk_verdict(d[0], "done", m[..]);
  #assert v.code == DK_REFUSED && v.say == "no window w";
  #assert jv_parse(d[..], "{\"generation\":2,\"type\":\"done\"}", nodes[..]) && dk_verdict(d[0], "done", m[..]).code == DK_UNREADABLE;
  #assert jv_parse(d[..], "{\"generation\":1,\"type\":\"party\"}", nodes[..]) && dk_verdict(d[0], "done", m[..]).code == DK_UNREADABLE;
  #assert jv_parse(d[..], "{\"generation\":1,\"type\":\"windows\",\"windows\":[]}", nodes[..]) && dk_verdict(d[0], "done", m[..]).code == DK_UNREADABLE;
  #assert dk_verdict(d[0], "windows", m[..]).code == 0;
  #assert !jv_parse(d[..], "nope", nodes[..]) && dk_verdict(d[0], "done", m[..]).code == DK_UNREADABLE;
}

// A JSON value with every object's keys in bytewise order (serde_json's map), compact.
dk_sorted :: (d: Jv, at: int, o: [] Jo) {
  k := jv_kind(d, at);
  if k == JV_OBJECT {
    kids: [256] int; n := 0;
    c := d.nodes[at].first;
    while c >= 0 && n < 256 { kids[n] = c; n += 1; c = d.nodes[c].next; }
    // insertion sort by raw key
    for i: 1..<n { j := i; while j > 0 && dk_less(jv_key(d, kids[j]), jv_key(d, kids[j - 1])) { t := kids[j]; kids[j] = kids[j - 1]; kids[j - 1] = t; j -= 1; } }
    jo_obj(o);
    for i: 0..<n { jo_value(o); jo_byte(o, '"'); jo_put(o, jv_key(d, kids[i])); jo_byte(o, '"'); jo_byte(o, ':'); o[0].keyed = true; dk_sorted(d, kids[i], o); }
    jo_end(o);
  } else if k == JV_ARRAY {
    jo_arr(o);
    c := d.nodes[at].first;
    while c >= 0 { dk_sorted(d, c, o); c = d.nodes[c].next; }
    jo_end(o);
  } else if k == JV_STRING { jo_value(o); jo_byte(o, '"'); jo_put(o, jv_raw(d, at)); jo_byte(o, '"'); }
  else { jo_raw(o, jv_raw(d, at)); }
}
dk_less :: (a: string, b: string) -> bool {
  n := ifx a.count < b.count then a.count else b.count;
  for i: 0..<n { if a[i] != b[i] { return a[i] < b[i]; } }
  return a.count < b.count;
}
#test "sorted keys, nested" {
  nodes: [64] JvNode; d: [1] Jv; b: [512] u8; o: [1] Jo;
  #assert jv_parse(d[..], "{\"name\":\"DP-1\",\"at\":{\"y\":0,\"x\":0},\"size\":{\"width\":2560,\"height\":1440},\"scale\":1.0,\"desk\":1,\"l\":[{\"b\":true,\"a\":null}]}", nodes[..]);
  jo_start(o[..], b[..]); dk_sorted(d[0], 0, o[..]);
  #assert jo_text(o[..]) == "{\"at\":{\"x\":0,\"y\":0},\"desk\":1,\"l\":[{\"a\":null,\"b\":true}],\"name\":\"DP-1\",\"scale\":1.0,\"size\":{\"height\":1440,\"width\":2560}}";
  #assert dk_less("a", "b") && dk_less("a", "ab") && !dk_less("b", "a") && !dk_less("a", "a");
}

// reading: the desks the screens and windows name, by id (a screen's desk, then each window's,
// counted), with the first screen name each gave; then the whole object with sorted keys.
dk_reading :: (screens: Jv, focused: Jv, windows: Jv, o: [] Jo) {
  ids: [64] int; names: [64] string; counts: [64] int; n := 0;
  sa := jv_get(screens, 0, "screens");
  c := ifx jv_kind(screens, sa) == JV_ARRAY then screens.nodes[sa].first else -1;
  while c >= 0 { n = dk_row(ids[..], names[..], counts[..], n, jv_int(screens, jv_get(screens, c, "desk"), 0), jv_raw(screens, jv_get(screens, c, "name")), 0); c = screens.nodes[c].next; }
  wa := jv_get(windows, 0, "windows");
  c = ifx jv_kind(windows, wa) == JV_ARRAY then windows.nodes[wa].first else -1;
  while c >= 0 { n = dk_row(ids[..], names[..], counts[..], n, jv_int(windows, jv_get(windows, c, "desk"), 0), jv_raw(windows, jv_get(windows, c, "screen")), 1); c = windows.nodes[c].next; }
  for i: 1..<n { j := i; while j > 0 && ids[j] < ids[j - 1] { ti := ids[j]; ids[j] = ids[j - 1]; ids[j - 1] = ti; tn := names[j]; names[j] = names[j - 1]; names[j - 1] = tn; tc := counts[j]; counts[j] = counts[j - 1]; counts[j - 1] = tc; j -= 1; } }
  jo_obj(o);
  jo_key(o, "desks"); jo_arr(o);
  for i: 0..<n {
    jo_obj(o); jo_key(o, "id"); jo_int(o, ids[i]);
    jo_key(o, "screen"); jo_value(o); jo_byte(o, '"'); jo_put(o, names[i]); jo_byte(o, '"');
    jo_key(o, "windows"); jo_int(o, counts[i]); jo_end(o);
  }
  jo_end(o);
  jo_key(o, "focused");
  fw := jv_get(focused, 0, "window");
  fs := ifx jv_kind(focused, fw) == JV_OBJECT then jv_get(focused, fw, "screen") else -1;
  if jv_kind(focused, fs) == JV_STRING && jv_raw(focused, fs).count > 0 { jo_value(o); jo_byte(o, '"'); jo_put(o, jv_raw(focused, fs)); jo_byte(o, '"'); } else { jo_null(o); }
  jo_key(o, "screens");
  if jv_kind(screens, sa) == JV_ARRAY { dk_sorted(screens, sa, o); } else { jo_raw(o, "[]"); }
  jo_end(o);
}
dk_row :: (ids: [] int, names: [] string, counts: [] int, n: int, id: int, screen: string, add: int) -> int {
  for i: 0..<n {
    if ids[i] == id { counts[i] += add; if names[i].count == 0 { names[i] = screen; } return n; }
  }
  if n >= ids.count { return n; }
  ids[n] = id; names[n] = screen; counts[n] = add;
  return n + 1;
}
#test "reading, as the Rust client prints it" {
  n1: [64] JvNode; n2: [64] JvNode; n3: [64] JvNode; s: [1] Jv; f: [1] Jv; w: [1] Jv; b: [1024] u8; o: [1] Jo;
  #assert jv_parse(s[..], "{\"generation\":1,\"type\":\"screens\",\"screens\":[{\"name\":\"DP-1\",\"at\":{\"x\":0,\"y\":0},\"size\":{\"width\":2560,\"height\":1440},\"scale\":1.0,\"desk\":1}]}", n1[..]);
  #assert jv_parse(f[..], "{\"generation\":1,\"type\":\"focused\",\"window\":null}", n2[..]);
  #assert jv_parse(w[..], "{\"generation\":1,\"type\":\"windows\",\"windows\":[]}", n3[..]);
  jo_start(o[..], b[..]); dk_reading(s[0], f[0], w[0], o[..]);
  #assert jo_text(o[..]) == "{\"desks\":[{\"id\":1,\"screen\":\"DP-1\",\"windows\":0}],\"focused\":null,\"screens\":[{\"at\":{\"x\":0,\"y\":0},\"desk\":1,\"name\":\"DP-1\",\"scale\":1.0,\"size\":{\"height\":1440,\"width\":2560}}]}";
  // windows on another desk and the focus on a screen
  #assert jv_parse(f[..], "{\"generation\":1,\"type\":\"focused\",\"window\":{\"screen\":\"DP-1\",\"desk\":3}}", n2[..]);
  #assert jv_parse(w[..], "{\"generation\":1,\"type\":\"windows\",\"windows\":[{\"desk\":3,\"screen\":\"DP-1\"},{\"desk\":1,\"screen\":\"DP-1\"},{\"desk\":3,\"screen\":\"\"}]}", n3[..]);
  jo_start(o[..], b[..]); dk_reading(s[0], f[0], w[0], o[..]);
  #assert jo_text(o[..]) == "{\"desks\":[{\"id\":1,\"screen\":\"DP-1\",\"windows\":1},{\"id\":3,\"screen\":\"DP-1\",\"windows\":2}],\"focused\":\"DP-1\",\"screens\":[{\"at\":{\"x\":0,\"y\":0},\"desk\":1,\"name\":\"DP-1\",\"scale\":1.0,\"size\":{\"height\":1440,\"width\":2560}}]}";
}

// ---- the socket

// One request line on the desk's socket and its answer line (without the newline) into out:
// its length, or -1 when nothing answers on the socket, -2 when it stopped answering.
dk_speak :: (socket: string, line: string, out: [] u8) -> int {
  for c: socket { r := cxsock_host_push(cast(int) c); }
  h := cxsock_connect_unix(DK_ANSWER_MS);
  if h < 0 { return -1; }
  for c: line { r := cxsock_write(h, cast(int) c); }
  r := cxsock_write(h, 10);
  if cxsock_flush(h, DK_ANSWER_MS) != 0 { x := cxsock_close(h); return -2; }
  n := 0;
  while n < out.count {
    got := cxsock_read(h, DK_ANSWER_MS);
    if got == -1 { break; }   // the end of the stream
    if got < 0 { x := cxsock_close(h); return -2; }
    done := false;
    for i: 0..<got {
      c := cxsock_byte(h, i);
      if c == 10 { done = true; break; }
      if n < out.count { out[n] = cast,trunc(u8) c; n += 1; }
    }
    if done { break; }
  }
  x := cxsock_close(h);
  return n;
}
// Whether something answers on the socket.
dk_answers :: (socket: string) -> bool {
  for c: socket { r := cxsock_host_push(cast(int) c); }
  h := cxsock_connect_unix(DK_ANSWER_MS);
  if h < 0 { return false; }
  x := cxsock_close(h);
  return true;
}

dk_unreachable :: (socket: string) {
  tool_err("error: this run names a desktop session that is no longer there. Its control socket at ");
  tool_err(socket); tool_errln(" does not answer, so the session has ended or it belongs to another user.");
}

// One verb asked and its answer parsed into d: 0, or the exit status (its sentence printed).
dk_ask :: (socket: string, line: string, want: string, text: [] u8, d: [] Jv, nodes: [] JvNode) -> int {
  n := dk_speak(socket, line, text);
  if n == -1 { dk_unreachable(socket); return DK_UNREACHABLE; }
  if n < 0 { tool_errln("error: the desk stopped answering"); return DK_UNREADABLE; }
  ok := jv_parse(d, cast(string) text[0..<n], nodes);
  m: [4096] u8;
  v := dk_verdict(d[0], want, m[..]);
  if v.code == DK_REFUSED { tool_err("error: the desk refused the request: "); tool_errln(v.say); }
  else if v.code != 0 { tool_errln(v.say); }
  return v.code;
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("usage: coder-desk VERB [ARGS...]"); return DK_USAGE; }
  argv: [32] string; nargs := args_count(a[..]);
  if nargs > 32 { tool_errln("error: too many arguments"); return DK_USAGE; }
  for i: 0..<nargs { argv[i] = args_at(a[..], i); }
  lb: [65536] u8;
  r := dk_request(argv[0..<nargs], lb[..]);
  if r.bad != "" { tool_errln(r.bad); return DK_USAGE; }
  // the desk this run is inside
  sb: [4096] u8; qb: [4096] u8; hb: [256] u8;
  socket := proc_getenv("CODER_DESK_SOCKET", sb[..]);
  if socket.count == 0 { socket = proc_getenv("CODER_QUEST_SOCKET", qb[..]); }
  if socket.count == 0 {
    if proc_getenv("HYPRLAND_INSTANCE_SIGNATURE", hb[..]).count > 0 {
      tool_errln("error: this is a Hyprland session with no desk socket; this coder-desk speaks the desk protocol only (the Rust client's Hyprland backend is not ported)");
      return DK_UNREACHABLE;
    }
    tool_errln(DK_NO_SESSION_COPY); return DK_NO_SESSION;
  }
  if !dk_answers(socket) { dk_unreachable(socket); return DK_UNREACHABLE; }
  line := cast(string) lb[0..<r.n];
  text: [DK_MAX_LINE] u8; nodes: [16384] JvNode; d: [1] Jv;
  v := r.verb;
  if v == "status" {
    print("backend: native\nsocket: %", socket);
    if dk_ask(socket, line, "status", text[..], d[..], nodes[..]) == 0 {
      print("\nhands: %", ifx jv_bool(d[0], jv_path(d[0], 0, "hands.on")) then "on" else "off");
    }
    print("\n");
    return 0;
  }
  if v == "list" || v == "screens" || v == "focused" {
    want := ifx v == "list" then "windows" else v;
    code := dk_ask(socket, line, want, text[..], d[..], nodes[..]);
    if code != 0 { return code; }
    print("%\n", jv_raw(d[0], jv_get(d[0], 0, ifx v == "list" then "windows" else ifx v == "screens" then "screens" else "window")));
    return 0;
  }
  if v == "reading" {
    t2: [65536] u8; n2: [2048] JvNode; d2: [1] Jv;   // a focused answer is one window
    t3: [DK_MAX_LINE] u8; n3: [16384] JvNode; d3: [1] Jv;
    code := dk_ask(socket, "{\"generation\":1,\"type\":\"screens\"}", "screens", text[..], d[..], nodes[..]);
    if code == 0 { code = dk_ask(socket, "{\"generation\":1,\"type\":\"focused\"}", "focused", t2[..], d2[..], n2[..]); }
    if code == 0 { code = dk_ask(socket, "{\"generation\":1,\"type\":\"list\"}", "windows", t3[..], d3[..], n3[..]); }
    if code != 0 { return code; }
    ob: [262144] u8; o: [1] Jo; jo_start(o[..], ob[..]);
    dk_reading(d[0], d2[0], d3[0], o[..]);
    if o[0].bad { tool_errln("error: this command could not write what the desk answered"); return DK_UNREADABLE; }
    print("%\n", jo_text(o[..]));
    return 0;
  }
  return dk_ask(socket, line, "done", text[..], d[..], nodes[..]);
}
