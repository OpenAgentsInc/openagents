  ua := [4] string.["press", "up", "--key", "--button"]; ub := [2] string.["list", "x"]; uc := [5] string.["move", "1", "2", "--ms", "1001"];
  #assert dk_request(u1[..], b[..]).bad != "" && dk_request(u2[..], b[..]).bad != "" && dk_request(u3[..], b[..]).bad != "";
