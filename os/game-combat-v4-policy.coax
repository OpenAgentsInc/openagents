// V4 accommodates the public API's combat-before-auto-target transition.
#authority;
#load "game-combat-policy.coax";
#test "ambient combat can wait briefly for a public target, without input or a new pull" {
  s:=CombatSample.{ok=true,flags=7,health=35,health_max=100};
  #assert c4_ambient(s,0) && c4_ambient(s,3000);
  #assert !c4_ambient(s,-1) && !c4_ambient(s,3001);
  t:=s; t.ok=false; #assert !c4_ambient(t,0);
  for flags: [6] int.[0,3,5,15,23,39] { t=s; t.flags=flags; #assert !c4_ambient(t,0); }
  t=s; t.health=34; #assert !c4_ambient(t,0);
  t=s; t.health=3480; t.health_max=10000; #assert !c4_ambient(t,0);
  t=s; t.health_max=0; #assert !c4_ambient(t,0);
  t=s; t.health=1; t.health_max=1; #assert c4_ambient(t,0);
  t=s; t.target_flags=1; #assert !c4_ambient(t,0);
  t=s; t.target_flags=64; #assert c4_ambient(t,0);
}
c4_ambient :: (s: CombatSample,age: int) -> bool {
  return s.ok && (s.flags&63)==7 && (s.target_flags&1)==0 && s.health_max>0 && s.health*100>=s.health_max*35 && age>=0 && age<=3000;
}
#test "recorded ambient transition waits then admits the automatically selected attacking troll" {
  s:=CombatSample.{ok=true,flags=7,health=103,health_max=103,level=5,class_id=9,mana=298,mana_max=298,skin=65535,target_flags=64};
  s.slots[1]=CombatSlot.{flags=3,id=686};
  #assert !cb_choose(s,false).ok && c4_ambient(s,0);
  s.health=100; s.target_flags=195; s.npc=706; s.spawn=7048943; s.target_level=3; s.target_health=71; s.target_max=71; s.extra=2; s.slots[1].flags=27;
  #assert !c4_ambient(s,250) && cb_choose(s,false).action==CT_BOLT;
}
