#authority;
#load "game-combat-v4-policy.coax";
#load "game-evidence-policy.coax";
#load "game-hunt-policy.coax";
#test "efficient scan overlaps the visible field within the existing effect bound" {
  d:=c5_scan(); #assert d.ok && d.action==CT_RIGHT && d.key==32 && d.milliseconds==300;
  #assert !c5_scanned(7) && c5_scanned(8) && c5_scanned(9);
}
c5_scan :: () -> CombatDecision { d:=cb_action(CT_RIGHT); d.milliseconds=300; return d; }
c5_scanned :: (count: int) -> bool { return count>=8; }
#test "observation-only waits use cast completion or resource ticks, subtracting work already done" {
  s:=CombatSample.{ok=true,flags=19,cast_left=1300,health=100,health_max=100,mana=100,mana_max=100};
  #assert c5_pause(s,CT_WAIT,0)==1300 && c5_pause(s,CT_WAIT,300)==1000;
  #assert c5_pause(s,CT_WAIT,1300)==0 && c5_pause(s,CT_WAIT,1301)==0;
  s.cast_left=1501; #assert c5_pause(s,CT_WAIT,0)==1500;
  s.cast_left=1500; #assert c5_pause(s,CT_WAIT,0)==1500;
  s.cast_left=500; #assert c5_pause(s,CT_WAIT,0)==500;
  s.cast_left=501; #assert c5_pause(s,CT_WAIT,0)==501;
  s.flags=3; s.mana=59; #assert c5_pause(s,CT_WAIT,0)==2000;
  s.mana=60; #assert c5_pause(s,CT_WAIT,0)==500;
  s.health=84; #assert c5_pause(s,CT_WAIT,0)==2000;
  s.health=85; #assert c5_pause(s,CT_WAIT,0)==500;
  s.health_max=10000; s.health=8480; #assert c5_pause(s,CT_WAIT,0)==2000;
  s.health_max=100; s.health=100; s.mana_max=10000; s.mana=5980; #assert c5_pause(s,CT_WAIT,0)==2000;
  s.mana=0; s.mana_max=0; #assert c5_pause(s,CT_WAIT,0)==500;
  s.health=84; #assert c5_pause(s,CT_WAIT,0)==500;
  s.mana_max=100; s.health_max=0; #assert c5_pause(s,CT_WAIT,0)==500;
  s.health_max=1; s.health=1; s.mana_max=1; s.mana=1; #assert c5_pause(s,CT_WAIT,0)==500;
  s.mana=0; #assert c5_pause(s,CT_WAIT,0)==2000;
  s.target_flags=1; #assert c5_pause(s,CT_WAIT,0)==500;
  s.target_flags=0; s.flags=7; #assert c5_pause(s,CT_WAIT,0)==500;
  s.flags=11; #assert c5_pause(s,CT_WAIT,0)==500;
  s.flags=19; s.cast_left=1; #assert c5_pause(s,CT_WAIT,0)==500;
  s.flags=1; #assert c5_pause(s,CT_WAIT,0)==500;
  s.flags=3; s.ok=false; #assert c5_pause(s,CT_WAIT,0)==500;
  s.ok=true; #assert c5_pause(s,CT_BOLT,0)==500 && c5_pause(s,CT_RIGHT,300)==500;
  #assert c5_pause(s,CT_WAIT,-1)==0;
}
c5_pause :: (s: CombatSample,action: int,age: int) -> int {
  if action!=CT_WAIT { return 500; }
  planned:=500;
  if s.ok && (s.flags&16)!=0 { planned=cast(int) clamp(cast(f32) s.cast_left,500,1500); }
  else if s.ok && (s.flags&31)==3 && (s.target_flags&1)==0 && s.health_max>0 && s.mana_max>0 && (s.health*100<s.health_max*85 || s.mana*100<s.mana_max*60) { planned=2000; }
  return ev_sleep_for(planned,age);
}
#test "area advice also detects measured low throughput after at least three kills" {
  #assert !c5_low_rate(1,1000,2) && c5_low_rate(168,191957,3);
  #assert !c5_low_rate(120,60000,3) && c5_low_rate(119,60000,3);
  #assert !c5_low_rate(0,0,3) && c5_low_rate(0,1,3);
  #assert c5_low_rate(120,60001,3) && !c5_low_rate(-1,1000,3);
}
c5_low_rate :: (xp: int,elapsed: int,kills: int) -> bool { return kills>=3 && xp>=0 && xp*60000<120*elapsed; }
#test "parking reuses bounded Aethyr routes after level completion and refuses combat or changed targets" {
  s:=CombatSample.{ok=true,flags=3,level=6}; n:=NavSample.{ok=true,alive=true,map=1426,x=1000,y=1000}; g:=NavGoal.{map=1426,x=1000,y=900};
  #assert c5_park(s,n,g).action==CT_FORWARD;
  #assert c5_park_recheck(s,s,n,g,CT_FORWARD);
  #assert c5_park_recheck(s,s,n,g,CT_BACK) && c5_park_recheck(s,s,n,g,CT_STRAFE);
  #assert !c5_park_recheck(s,s,n,g,CT_BOLT);
  g.x=900; g.y=1000; #assert c5_park(s,n,g).action==CT_LEFT && c5_park_recheck(s,s,n,g,CT_LEFT);
  #assert !c5_park_recheck(s,s,n,g,CT_BACK);
  g.x=1000; g.y=1000; #assert c5_park(s,n,g).action==CT_WAIT;
  s.target_flags=1; #assert c5_park(s,n,g).action==CT_SKIP && c5_park_recheck(s,s,n,g,CT_SKIP);
  t:=s; t.ok=false; #assert !c5_park(t,n,g).ok && !c5_park_recheck(t,s,n,g,CT_SKIP) && !c5_park_recheck(s,t,n,g,CT_SKIP);
  t=s; t.target_epoch=1; #assert !c5_park_recheck(s,t,n,g,CT_SKIP);
  t=s; t.npc=1; #assert !c5_park_recheck(s,t,n,g,CT_SKIP);
  t=s; t.spawn=1; #assert !c5_park_recheck(s,t,n,g,CT_SKIP);
  for flags:[4] int.[1,7,11,19] { t=s; t.flags=flags; #assert !c5_park(t,n,g).ok; }
  v:=n; v.map=1; #assert !c5_park(s,v,g).ok;
  v=n; v.alive=false; #assert !c5_park(s,v,g).ok;
  v=n; v.ok=false; #assert !c5_park(s,v,g).ok;
  v=n; v.combat=true; #assert !c5_park(s,v,g).ok;
  v=n; v.blocked=true; #assert !c5_park(s,v,g).ok;
}
c5_park :: (s: CombatSample,n: NavSample,g: NavGoal) -> CombatDecision {
  if !s.ok || (s.flags&31)!=3 || n.map!=1426 { return CombatDecision.{}; }
  route:=nav_route(n,g); if !route.ok { return CombatDecision.{}; }
  return ifx (s.target_flags&1)!=0 then cb_action(CT_SKIP) else hunt_action(route);
}
c5_park_recheck :: (before: CombatSample,after: CombatSample,n: NavSample,g: NavGoal,action: int) -> bool {
  if !before.ok || before.target_epoch!=after.target_epoch || before.npc!=after.npc || before.spawn!=after.spawn { return false; }
  next:=c5_park(after,n,g); return next.ok && (next.action==action || ((action==CT_BACK || action==CT_STRAFE) && next.action==CT_FORWARD));
}
#test "an errored unchanged pull can be abandoned OOC, never while casting or fighting" {
  s:=CombatSample.{ok=true,flags=3,target_flags=67,npc=706,spawn=7,target_epoch=4,target_health=71}; t:=s; t.error_serial=1;
  #assert !c5_pull_failed(s,t,4999) && c5_pull_failed(s,t,5000);
  v:=t; v.ok=false; #assert !c5_pull_failed(s,v,5000);
  v=s; v.ok=false; #assert !c5_pull_failed(v,t,5000);
  for flags:[4] int.[1,7,11,19] { v=t; v.flags=flags; #assert !c5_pull_failed(s,v,5000); }
  v=t; v.target_flags=5; #assert !c5_pull_failed(s,v,5000);
  v=t; v.target_flags=0; #assert !c5_pull_failed(s,v,5000);
  v=t; v.npc=705; #assert !c5_pull_failed(s,v,5000);
  v=t; v.spawn=8; #assert !c5_pull_failed(s,v,5000);
  v=t; v.target_epoch=5; #assert !c5_pull_failed(s,v,5000);
  v=t; v.target_health=70; #assert !c5_pull_failed(s,v,5000);
  v=t; v.cast_left=1; #assert !c5_pull_failed(s,v,5000);
  #assert !c5_pull_failed(s,s,5000);
  s.npc=0; t.npc=0; #assert !c5_pull_failed(s,t,5000);
  s.npc=1; t.npc=1; #assert c5_pull_failed(s,t,5000);
  for count:1..<5 { d:=c5_pull_recovery(count); #assert d.ok && d.action==(ifx count==4 then CT_BACK else CT_STRAFE); }
  #assert !c5_pull_recovery(0).ok && !c5_pull_recovery(5).ok;
}
c5_pull_failed :: (before: CombatSample,after: CombatSample,age: int) -> bool {
  return before.ok && after.ok && before.npc>0 && (after.flags&31)==3 && (after.target_flags&5)==1 && before.npc==after.npc && before.spawn==after.spawn && before.target_epoch==after.target_epoch
    && after.target_health==before.target_health && after.cast_left==0 && after.error_serial!=before.error_serial && age>=5000;
}
c5_pull_recovery :: (remaining: int) -> CombatDecision {
  if remaining<1 || remaining>4 { return CombatDecision.{}; } return cb_action(ifx remaining==4 then CT_BACK else CT_STRAFE);
}
#test "a short healthy combat tail waits for loot; an owned corpse can then be cleared to defend" {
  s:=CombatSample.{ok=true,flags=7,health=50,health_max=100,target_flags=71,npc=706,spawn=7,kill_npc=706,kill_spawn=7,target_epoch=4};
  #assert c5_loot_grace(s,0) && c5_loot_grace(s,1500) && !c5_loot_grace(s,1501) && !c5_loot_grace(s,-1);
  #assert c5_corpse(s) && c5_corpse_recheck(s,s);
  t:=s; t.health=49; #assert !c5_loot_grace(t,0);
  t=s; t.health=4980; t.health_max=10000; #assert !c5_loot_grace(t,0);
  t=s; t.health_max=0; #assert !c5_loot_grace(t,0);
  t=s; t.health=1; t.health_max=1; #assert c5_loot_grace(t,0);
  t=s; t.ok=false; #assert !c5_loot_grace(t,0) && !c5_corpse(t) && !c5_corpse_recheck(t,s) && !c5_corpse_recheck(s,t);
  for flags:[4] int.[1,3,15,23] { t=s; t.flags=flags; #assert !c5_corpse(t); }
  for flags:[4] int.[0,1,11,15] { t=s; t.flags=flags; #assert !c5_loot_grace(t,0); }
  t=s; t.flags=3; #assert c5_loot_grace(t,0);
  t=s; t.flags=23; #assert c5_loot_grace(t,0);
  t=s; t.health=0; #assert !c5_corpse(t);
  t=s; t.health=1; #assert c5_corpse(t);
  t=s; t.target_flags=67; #assert !c5_corpse(t);
  t=s; t.target_flags=4; #assert !c5_corpse(t);
  t=s; t.npc=0; t.kill_npc=0; #assert !c5_corpse(t);
  t=s; t.npc=1; t.kill_npc=1; #assert c5_corpse(t) && !c5_corpse_recheck(s,t);
  t=s; t.kill_npc=705; #assert !c5_corpse(t);
  t=s; t.kill_spawn=8; #assert !c5_corpse(t);
  t=s; t.spawn=8; t.kill_spawn=8; #assert !c5_corpse_recheck(s,t);
  t=s; t.target_epoch=5; #assert !c5_corpse_recheck(s,t);
}
c5_loot_grace :: (s: CombatSample,age: int) -> bool { return s.ok && (s.flags&11)==3 && s.health_max>0 && s.health*100>=s.health_max*50 && age>=0 && age<=1500; }
c5_corpse :: (s: CombatSample) -> bool { return s.ok && (s.flags&31)==7 && s.health>0 && (s.target_flags&5)==5 && s.npc>0 && s.kill_npc==s.npc && s.kill_spawn==s.spawn; }
c5_corpse_recheck :: (before: CombatSample,after: CombatSample) -> bool {
  return c5_corpse(before) && c5_corpse(after) && before.npc==after.npc && before.spawn==after.spawn && before.target_epoch==after.target_epoch;
}
#test "loot deferral distinguishes a healthy settling kill from continued combat or urgent recovery" {
  s:=CombatSample.{ok=true,flags=7,health=100,health_max=100};
  #assert !c5_defer_loot(s,1500) && c5_defer_loot(s,1501);
  s.flags=23; #assert c5_defer_loot(s,1501);
  s.flags=19; #assert c5_defer_loot(s,1501);
  s.flags=3; #assert !c5_defer_loot(s,1501);
  s.health=34; #assert c5_defer_loot(s,0);
  s.health=35; #assert !c5_defer_loot(s,1501);
  s.health=3480; s.health_max=10000; #assert c5_defer_loot(s,1501);
  s.health=0; #assert !c5_defer_loot(s,1501);
  s.health=1; s.health_max=0; #assert !c5_defer_loot(s,1501);
  s.health_max=1; #assert !c5_defer_loot(s,1501);
  s.flags=7; #assert c5_defer_loot(s,1501);
  s.health=0; #assert !c5_defer_loot(s,1501);
  s.health=1; s.health_max=0; #assert !c5_defer_loot(s,1501);
  s.health_max=1;
  s.flags=11; #assert !c5_defer_loot(s,1501);
  s.flags=7; s.ok=false; #assert !c5_defer_loot(s,1501);
}
c5_defer_loot :: (s: CombatSample,age: int) -> bool {
  return s.ok && s.health>0 && s.health_max>0 && (s.flags&11)==3
    && ((((s.flags&20)!=0) && !c5_loot_grace(s,age)) || s.health*100<s.health_max*35);
}
