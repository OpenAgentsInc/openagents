// external-combat-v1: observe, admit one bounded key, release, observe again.
#load "game-combat-observation.coax";
#load "game-combat-policy.coax";
#load "game-hunt-policy.coax";
#load "game-combat-drain.coax";
#load "game-creature-observation.coax";
#load "game-client.coax";
#load "game-policy.coax";
#load "game-combat-evidence.coax";
#load "game-evidence-policy.coax";
#load "game-evidence-v2.coax";
#load "game-loot-observation.coax";
#load "game-loot-policy.coax";
#load "game-xp-policy.coax";
#load "game-combat-v4-policy.coax";
#load "game-evidence-compact.coax";
#load "game-combat-v5-policy.coax";
#load "game-combat-v6-policy.coax";
#load "game-recording-space.coax";
CC_NAMES :: [15] string.["wait","target-next","turn-left","turn-right","approach","shadow-bolt","melee","demon-skin","food","water","clear-target","select-visible-creature","skip-target","back-away","sidestep-right"];
cc_num :: (n: int, out: [] u8) -> string { o: [1] Jo; jo_start(o[..], out); jo_int(o[..], n); return jo_text(o[..]); }
cc_record :: (path: string, line: string) -> bool {
  out: [32768] u8; if line.count >= out.count { return false; }
  for i: 0..<line.count { out[i] = line[i]; } out[line.count] = '\n';
  return fs_append_durable(path, cast(string) out[0..<line.count + 1]);
}
cc_stop :: (journal: string, reason: string) -> int {
  out: [1024] u8; o: [1] Jo; jo_start(o[..], out[..]); jo_obj(o[..]);
  jo_key(o[..], "type"); jo_str(o[..], "stop-reason"); jo_key(o[..], "reason"); jo_str(o[..], reason); jo_end(o[..]);
  saved := cc_record(journal, jo_text(o[..])); print("%\n", jo_text(o[..])); return 1;
}
cc_target :: (h: int, reply: [] u8, trace: string) -> GameTarget {
  empty: GameTarget; n := gc_exchange_logged(h, empty, "list", 0, false, 0, 0, 0, "", reply, "windows",trace);
  return ifx n > 0 then gc_target(cast(string) reply[0..<n], "World of Warcraft", 0, 0) else empty;
}
cc_key :: (h: int, t: GameTarget, d: CombatDecision, reply: [] u8, trace: string) -> bool {
  if !d.ok || d.milliseconds < 0 || d.milliseconds > 300 { return false; }
  if d.action == CT_WAIT { return true; }
  if gc_exchange_logged(h, t, "acquire", 0, false, 1000, 0, 0, "", reply, "done",trace) < 0 { return false; }
  pulse_started := proc_now_ms();
  if gc_exchange_logged(h, t, "key", d.key, true, 0, 0, 0, "", reply, "done",trace) < 0 { return false; }
  proc_sleep(ev_sleep_for(d.milliseconds,proc_now_ms() - pulse_started));
  if gc_exchange_logged(h, t, "key", d.key, false, 0, 0, 0, "", reply, "done",trace) < 0 { return false; }
  return gc_exchange_logged(h, t, "stop", 0, false, 0, 0, 0, "", reply, "done",trace) > 0;
}
cc_select :: (h: int, t: GameTarget, point: CreatureBar, reply: [] u8, trace: string) -> bool {
  if point.rows < 2 { return false; }
  if gc_exchange_logged(h,t,"acquire",0,false,1000,0,0,"",reply,"done",trace) < 0 { return false; }
  if gc_exchange_logged(h,t,"move",0,false,0,point.x,point.y,"",reply,"done",trace) < 0 { return false; }
  pulse_started := proc_now_ms();
  if gc_exchange_logged(h,t,"button",272,true,0,0,0,"",reply,"done",trace) < 0 { return false; }
  proc_sleep(ev_sleep_for(40,proc_now_ms() - pulse_started));
  if gc_exchange_logged(h,t,"button",272,false,0,0,0,"",reply,"done",trace) < 0 { return false; }
  return gc_exchange_logged(h,t,"stop",0,false,0,0,0,"",reply,"done",trace) > 0;
}
cc_loot_key :: (h: int,t: GameTarget,action: int,reply: [] u8,trace: string) -> bool {
  if action==LT_WAIT { return true; } key:=lt_key(action); duration:=lt_duration(action);
  if key==0 || duration==0 { return false; }
  if gc_exchange_logged(h,t,"acquire",0,false,1000,0,0,"",reply,"done",trace)<0 { return false; }
  began:=proc_now_ms();
  if gc_exchange_logged(h,t,"key",key,true,0,0,0,"",reply,"done",trace)<0 { return false; }
  proc_sleep(ev_sleep_for(duration,proc_now_ms()-began));
  if gc_exchange_logged(h,t,"key",key,false,0,0,0,"",reply,"done",trace)<0 { return false; }
  return gc_exchange_logged(h,t,"stop",0,false,0,0,0,"",reply,"done",trace)>0;
}
cc_run :: (h: int, t: GameTarget, dir: string, steps: int, wanted: int,minimum: int,goal_level: int,home: NavGoal,hostile_only: bool,compact: bool,efficient: bool,park: NavGoal,defensive: bool) -> int {
  paths: [6] [4096] u8;
  image := fs_join(dir, "frame.ppm", paths[0][..]); journal := fs_join(dir, "journal.jsonl", paths[1][..]); stop := fs_join(dir, "stop", paths[2][..]);
  finish := fs_join(dir, "finish", paths[3][..]);
  recheck := fs_join(dir, "recheck.ppm", paths[4][..]);
  trace := fs_join(dir,"wire.jsonl",paths[5][..]); archive_bytes := 0;
  reply: [262144] u8; out: [16384] u8; sensor: [8192] u8; navtext: [1024] u8; loottext: [2048] u8;
  previous: CombatSample; fight: CombatSample;
  engaged := false; fight_started := 0; last_progress := 0; scans := 0; kills := 0; total_xp := 0; rest_until := 0; killed_at := 0;
  roaming := false; leg := 0; travel_ticks := 0; stalled := 0; last_action := CT_WAIT; previous_nav: NavSample;
  pending_visual := false; visual_bound := false; visual_target: CombatSample; began := proc_now_ms();
  tracked_leg := -1; survey_best: f32; survey_progress := 0; recovery := 0;
  pending_loot:=false; loot_context: LootContext; loot_origin: NavSample; loot_started:=0; loot_attempts:=0; loot_restored:=false; low_kills:=0; rejected:=false;
  ambient_since:=0;
  parking:=false; park_ending:=""; park_status:=0; available:=-1;
  pull_recovery:=0;
  facing_turns:=0; facing_error:=0;
  startrow: [1] Jo; jo_start(startrow[..],out[..]); jo_obj(startrow[..]); jo_key(startrow[..],"type"); jo_str(startrow[..],"start"); jo_key(startrow[..],"schema"); jo_str(startrow[..],"external-combat-v1");
  jo_key(startrow[..],"policy"); jo_str(startrow[..],ifx defensive then "starter-warlock-v6" else ifx efficient then "starter-warlock-v5" else "starter-warlock-v4"); jo_key(startrow[..],"loot"); jo_str(startrow[..],"external-loot-v1");
  jo_key(startrow[..],"evidence"); jo_str(startrow[..],ifx compact then "external-combat-evidence-v3" else "external-combat-evidence-v2"); jo_key(startrow[..],"images"); jo_str(startrow[..],ifx compact then "every full-resolution scene as lossy WebP85, original sensor region lossless" else "all observations and rechecks, lossless checksummed PPM.zst deltas");
  jo_key(startrow[..],"archive_budget"); jo_int(startrow[..],1073741824); jo_end(startrow[..]); if !cc_record(journal,jo_text(startrow[..])) { return 1; }
  config: [1] Jo; jo_start(config[..],out[..]); jo_obj(config[..]); jo_key(config[..],"type"); jo_str(config[..],"configuration");
  jo_key(config[..],"steps"); jo_int(config[..],steps); jo_key(config[..],"kills"); jo_int(config[..],wanted); jo_key(config[..],"minimum_target_level"); jo_int(config[..],minimum); jo_key(config[..],"stop_at_player_level"); jo_int(config[..],goal_level);
  jo_key(config[..],"hostile_only_candidates"); jo_bool(config[..],hostile_only);
  jo_key(config[..],"park_enabled"); jo_bool(config[..],park.map!=0); jo_key(config[..],"park_x_u16"); jo_int(config[..],park.x); jo_key(config[..],"park_y_u16"); jo_int(config[..],park.y); jo_key(config[..],"disk_reserve_bytes"); jo_int(config[..],805306368);
  jo_key(config[..],"home_x_u16"); jo_int(config[..],home.x); jo_key(config[..],"home_y_u16"); jo_int(config[..],home.y); jo_end(config[..]); if !cc_record(journal,jo_text(config[..])) { return 1; }
  for i: 0..<steps + 100 {
    if fs_exists(stop) { return cc_stop(journal, "stop-file"); }
    current := cc_target(h, reply[..],trace);
    if current.session != t.session || current.handle != t.handle || current.revision != t.revision { return cc_stop(journal, "window-changed"); }
    capture_started := proc_now_ms();
    n := gc_exchange_logged(h, t, "shot", 0, false, 0, 0, 0, image, reply[..], "shot",trace); if n < 0 { return 1; }
    s := ct_read(image); nav := nav_read(image); loot:=lt_read(image); now := proc_now_ms();
    if i%16==0 { available=rr_read(dir); }
    saved_bytes := ifx compact then ec_archive(image,dir,journal,i+1,false,capture_started) else e2_archive(image,dir,journal,i + 1,false,capture_started); if saved_bytes < 0 { return cc_stop(journal,"recording-failed"); } archive_bytes += saved_bytes;
    o: [1] Jo; jo_start(o[..], out[..]); jo_obj(o[..]);
    jo_key(o[..], "type"); jo_str(o[..], "observation"); jo_key(o[..], "sequence"); jo_int(o[..], i + 1); jo_key(o[..], "monotonic_ms"); jo_int(o[..], now);
    jo_key(o[..], "capture"); jo_raw(o[..], cast(string) reply[0..<n]); jo_key(o[..], "sensor"); jo_raw(o[..], ct_json(s, sensor[..]));
    jo_key(o[..], "combat_sensor_valid"); jo_bool(o[..], s.ok); jo_key(o[..], "navigation_sensor_valid"); jo_bool(o[..], nav.ok);
    jo_key(o[..],"last_available_bytes"); jo_int(o[..],available);
    jo_key(o[..], "navigation"); jo_raw(o[..], nav_json(nav, navtext[..])); jo_key(o[..],"loot"); jo_raw(o[..],lt_json(loot,loottext[..])); jo_end(o[..]);
    if !cc_record(journal, jo_text(o[..])) { return 1; }
    if !s.ok || !nav.ok || !nav.alive || nav.blocked || nav.map != 1426 { return cc_stop(journal, "unavailable-dead-menu-or-map"); }
    // A development pause drains the current encounter; immediate stop remains immediate.
    endrequest := ev_endrequest(archive_bytes,1073741824,cb_endrequest(kills,wanted,fs_exists(finish) || xp_goal(s.level,goal_level)));
    if endrequest==0 && rr_low(available) { endrequest=4; }
    drain := cb_drain(engaged || pending_loot,(s.flags & 4) != 0,endrequest != 0,i,steps,now - began);
    if drain == 1 {
      ending := ifx xp_goal(s.level,goal_level) then "{\"type\":\"finished\",\"reason\":\"level-goal\"}" else ifx endrequest == 1 then "{\"type\":\"finished\",\"reason\":\"finish-file\"}" else ifx endrequest == 2 then "{\"type\":\"finished\",\"reason\":\"kill-target\"}" else ifx endrequest==4 then "{\"type\":\"finished\",\"reason\":\"disk-reserve\"}" else "{\"type\":\"finished\",\"reason\":\"archive-budget\"}";
      if park.map==0 { return ifx cc_record(journal,ending) then 0 else 1; }
      if !parking { parking=true; park_ending=ending; if !cc_record(journal,"{\"type\":\"parking-requested\"}") { return 1; } }
    }
    if drain == 2 {
      if park.map==0 { return cc_stop(journal,"observation-or-time-budget-drained"); }
      if !parking { parking=true; park_status=1; park_ending="{\"type\":\"stop-reason\",\"reason\":\"observation-or-time-budget-parked\"}"; if !cc_record(journal,"{\"type\":\"parking-requested\"}") { return 1; } }
    }
    if parking && !engaged && !pending_loot && !nav.combat && nav_route(nav,park).arrived {
      jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"parked"); jo_key(o[..],"x_u16"); jo_int(o[..],nav.x); jo_key(o[..],"y_u16"); jo_int(o[..],nav.y); jo_end(o[..]);
      return ifx cc_record(journal,jo_text(o[..])) && cc_record(journal,park_ending) then park_status else 1;
    }
    if pending_visual { pending_visual = false; visual_bound = cb_eligible(s); visual_target = s; }
    if visual_target.target_epoch != s.target_epoch || visual_target.npc != s.npc || visual_target.spawn != s.spawn || !cb_eligible(s) { visual_bound = false; }
    if i > 0 && s.serial == previous.serial { return cc_stop(journal, "stale-sensor"); }
    if !loot.ok || loot.controls!=3 || (loot.flags&133)!=5 { return cc_stop(journal,"loot-sensor-or-bindings-unavailable"); }
    if abs(cast(f32) (nav.x - home.x)) + abs(cast(f32) (nav.y - home.y)) > 1800 { return cc_stop(journal, "survey-radius"); }
    d := ifx efficient then cb_choose_profile(s,engaged,true) else cb_choose(s, engaged); baseline := d; why := "combat-policy";
    if !engaged && (s.flags&4)!=0 && (s.target_flags&1)==0 {
      if ambient_since==0 { ambient_since=now; }
      if c4_ambient(s,now-ambient_since) { d=cb_action(CT_WAIT); why="await-ambient-combat-target"; }
    } else { ambient_since=0; }
    bars := cv_candidates_kind(image,hostile_only); dims := cv_frame(image);
    jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"vision"); jo_key(o[..],"observation"); jo_int(o[..],i + 1);
    jo_key(o[..],"width"); jo_int(o[..],dims.width); jo_key(o[..],"height"); jo_int(o[..],dims.height);
    jo_key(o[..],"capacity_reached"); jo_bool(o[..],bars.count == 32); jo_key(o[..],"candidates"); jo_arr(o[..]);
    for c: 0..<bars.count { b := bars.bars[c]; jo_obj(o[..]); jo_key(o[..],"x"); jo_int(o[..],b.x); jo_key(o[..],"y"); jo_int(o[..],b.y); jo_key(o[..],"width"); jo_int(o[..],b.width); jo_key(o[..],"rows"); jo_int(o[..],b.rows); jo_end(o[..]); }
    jo_end(o[..]); jo_end(o[..]); if !cc_record(journal,jo_text(o[..])) { return 1; }
    if engaged {
      if s.target_health < previous.target_health { last_progress = now; if defensive { facing_error=s.error_serial; } }
      if cb_kill(fight, s) {
        gained := cb_xp(fight, s); kills += 1; total_xp += gained;
        jo_start(o[..], out[..]); jo_obj(o[..]); jo_key(o[..], "type"); jo_str(o[..], "verified-kill"); jo_key(o[..], "sequence"); jo_int(o[..], i + 1);
        jo_key(o[..], "npc"); jo_int(o[..], fight.npc); jo_key(o[..], "spawn"); jo_int(o[..], fight.spawn); jo_key(o[..], "gained_xp"); jo_int(o[..], gained);
        jo_key(o[..], "kills"); jo_int(o[..], kills); jo_key(o[..], "total_xp"); jo_int(o[..], total_xp); jo_key(o[..], "fight_ms"); jo_int(o[..], now - fight_started); jo_end(o[..]);
        if !cc_record(journal, jo_text(o[..])) { return 1; } print("%\n", jo_text(o[..])); engaged = false; scans = 0; roaming = false; killed_at = now; why = "verified-kill";
        low_kills+=ifx xp_low(gained) then 1 else 0;
        jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"xp-quality"); jo_key(o[..],"gained_xp"); jo_int(o[..],gained);
        jo_key(o[..],"low_xp"); jo_bool(o[..],xp_low(gained)); jo_key(o[..],"too_easy"); jo_bool(o[..],xp_easy(fight.level,fight.target_level,now-fight_started,fight.health-s.health));
        jo_key(o[..],"consider_new_area"); jo_bool(o[..],xp_area(low_kills,kills) || (efficient && c5_low_rate(total_xp,now-began,kills))); jo_key(o[..],"low_throughput"); jo_bool(o[..],efficient && c5_low_rate(total_xp,now-began,kills)); jo_key(o[..],"elapsed_ms"); jo_int(o[..],now-began); jo_key(o[..],"free_bag_slots"); jo_int(o[..],loot.free); jo_end(o[..]);
        if !cc_record(journal,jo_text(o[..])) { return 1; }
        pending_loot=true; loot_context=LootContext.{npc=fight.npc,spawn=fight.spawn,opened=loot.opened,closed=loot.closed,items=loot.items,full=loot.full,copper=loot.copper};
        loot_origin=nav; loot_started=now; loot_attempts=0; loot_restored=false; d=cb_action(CT_WAIT);
      } else if efficient && c5_pull_failed(fight,s,now-fight_started) {
        jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"blocked-pull"); jo_key(o[..],"observation"); jo_int(o[..],i+1); jo_key(o[..],"npc"); jo_int(o[..],s.npc); jo_key(o[..],"spawn"); jo_int(o[..],s.spawn); jo_key(o[..],"error_type"); jo_int(o[..],s.error_type); jo_end(o[..]);
        if !cc_record(journal,jo_text(o[..])) { return 1; } engaged=false; pull_recovery=4; d=cb_action(CT_SKIP); why="abandon-errored-ooc-pull";
      } else if cb_fight_expired(now - fight_started,now - last_progress) { return cc_stop(journal, "fight-or-damage-deadline"); }
      else if s.kill_serial != fight.kill_serial && s.kill_npc == fight.npc && s.kill_spawn == fight.spawn { d = cb_action(CT_WAIT); }
      else if s.target_epoch != fight.target_epoch || s.npc != fight.npc || s.spawn != fight.spawn { return cc_stop(journal, "engaged-target-changed"); }
      else if (s.target_flags & 4) != 0 { d = cb_action(CT_WAIT); }
      if defensive && engaged {
        if c6_needed(s,facing_error,facing_turns) { d=c6_turn(); why="combat-facing-recovery"; }
      }
    }
    if pending_loot && efficient && c5_defer_loot(s,now-loot_started) {
      jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"loot-deferred"); jo_key(o[..],"observation"); jo_int(o[..],i+1);
      jo_key(o[..],"npc"); jo_int(o[..],loot_context.npc); jo_key(o[..],"spawn"); jo_int(o[..],loot_context.spawn); jo_key(o[..],"reason"); jo_str(o[..],"continued-combat-cast-or-low-health"); jo_end(o[..]);
      if !cc_record(journal,jo_text(o[..])) { return 1; } pending_loot=false;
    }
    if pending_loot {
      distance:=cast(int) (abs(cast(f32) (nav.x-loot_origin.x))+abs(cast(f32) (nav.y-loot_origin.y)));
      la:=ifx (efficient && c5_loot_grace(s,now-loot_started)) || cb_afterkill(s,now-loot_started) then LT_WAIT else lt_choose(s,loot,loot_context,loot_attempts,loot_restored,now-loot_started,distance);
      if la>=LT_RECEIPT {
        jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"loot-outcome"); jo_key(o[..],"observation"); jo_int(o[..],i+1);
        jo_key(o[..],"result"); jo_int(o[..],la); jo_key(o[..],"npc"); jo_int(o[..],loot_context.npc); jo_key(o[..],"spawn"); jo_int(o[..],loot_context.spawn);
        jo_key(o[..],"item_events"); jo_int(o[..],(loot.items-loot_context.items+65536)%65536); jo_key(o[..],"copper_delta"); jo_int(o[..],loot.copper-loot_context.copper);
        jo_key(o[..],"free_bag_slots"); jo_int(o[..],loot.free); jo_key(o[..],"inventory_full"); jo_bool(o[..],la==LT_FULL); jo_key(o[..],"zero_free_slots"); jo_bool(o[..],loot.free==0); jo_end(o[..]);
        if !cc_record(journal,jo_text(o[..])) { return 1; } print("%\n",jo_text(o[..])); pending_loot=false;
        if la==LT_REFUSE { return cc_stop(journal,"loot-policy-refused"); }
        previous=s; previous_nav=nav; last_action=CT_WAIT; proc_sleep(500); continue;
      }
      if la!=LT_WAIT {
        checked_at:=proc_now_ms(); checked:=gc_exchange_logged(h,t,"shot",0,false,0,0,0,recheck,reply[..],"shot",trace); if checked<0 { return cc_stop(journal,"loot-recheck-capture"); }
        latest:=ct_read(recheck); fresh_loot:=lt_read(recheck); fresh_nav:=nav_read(recheck);
        bytes:=ifx compact then ec_archive(recheck,dir,journal,i+1,true,checked_at) else e2_archive(recheck,dir,journal,i+1,true,checked_at); if bytes<0 { return cc_stop(journal,"recording-failed"); } archive_bytes+=bytes;
        fresh_distance:=cast(int) (abs(cast(f32) (fresh_nav.x-loot_origin.x))+abs(cast(f32) (fresh_nav.y-loot_origin.y)));
        admitted:=fresh_nav.ok && fresh_nav.alive && !fresh_nav.blocked && fresh_nav.map==1426 && latest.target_epoch==s.target_epoch && lt_choose(latest,fresh_loot,loot_context,loot_attempts,loot_restored,proc_now_ms()-loot_started,fresh_distance)==la;
        jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"loot-recheck"); jo_key(o[..],"observation"); jo_int(o[..],i+1);
        jo_key(o[..],"admitted"); jo_bool(o[..],admitted); jo_key(o[..],"sensor"); jo_raw(o[..],ct_json(latest,sensor[..])); jo_key(o[..],"navigation"); jo_raw(o[..],nav_json(fresh_nav,navtext[..])); jo_key(o[..],"loot"); jo_raw(o[..],lt_json(fresh_loot,loottext[..])); jo_end(o[..]);
        if !cc_record(journal,jo_text(o[..])) { return 1; }
        if !admitted { previous=s; previous_nav=nav; last_action=CT_WAIT; proc_sleep(500); continue; }
      }
      jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"loot-action"); jo_key(o[..],"observation"); jo_int(o[..],i+1); jo_key(o[..],"action"); jo_int(o[..],la); jo_key(o[..],"attempt"); jo_int(o[..],loot_attempts); jo_key(o[..],"milliseconds"); jo_int(o[..],lt_duration(la)); jo_end(o[..]);
      if !cc_record(journal,jo_text(o[..])) { return 1; } applied_at:=proc_now_ms(); applied:=cc_loot_key(h,t,la,reply[..],trace);
      jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"loot-effect"); jo_key(o[..],"observation"); jo_int(o[..],i+1); jo_key(o[..],"applied"); jo_bool(o[..],applied); jo_key(o[..],"started_ms"); jo_int(o[..],applied_at); jo_key(o[..],"ended_ms"); jo_int(o[..],proc_now_ms()); jo_end(o[..]);
      if !cc_record(journal,jo_text(o[..])) { return 1; } if !applied { return cc_stop(journal,"loot-input-interrupted"); }
      if la==LT_RESTORE { loot_restored=true; } else if la!=LT_WAIT { loot_attempts+=1; }
      previous=s; previous_nav=nav; last_action=CT_WAIT; proc_sleep(500); continue;
    }
    if efficient && !engaged && c5_corpse(s) { d=cb_action(CT_CLEAR); why="clear-owned-corpse-to-defend"; }
    if parking && !engaged && !nav.combat { d=c5_park(s,nav,park); why="park-route"; }
    if !d.ok && !engaged && killed_at > 0 && cb_afterkill(s, now - killed_at) { d = cb_action(CT_WAIT); }
    if !d.ok { return cc_stop(journal, "combat-policy-refused"); }
    if !parking && !engaged && (s.flags&4)==0 && (s.target_flags&1)!=0 && (s.target_flags&4)==0 && s.target_level<minimum { d=cb_action(CT_SKIP); why="below-requested-xp-tier"; rejected=true; if efficient { scans+=1; } }
    else if !parking && rejected && !engaged && (s.target_flags&1)==0 && (s.flags&4)==0 { d=ifx efficient then c5_scan() else hunt_scan_action(true,NavRoute.{}); why="rotate-from-low-xp-target"; rejected=false; }
    if now < rest_until && (d.action == CT_FOOD || d.action == CT_WATER || d.action == CT_WAIT) { d = cb_action(CT_WAIT); why = "rest-settle"; }
    if !parking && pull_recovery>0 && !engaged && !nav.combat && (d.action==CT_TAB || d.action==CT_SKIP || d.action==CT_FORWARD || d.action==CT_BOLT) {
      d=ifx (s.target_flags&1)!=0 then cb_action(CT_SKIP) else c5_pull_recovery(pull_recovery); why="blocked-pull-recovery";
    }
    point: CreatureBar;
    if !parking && pull_recovery==0 && !engaged && (s.flags & 4) == 0 && (d.action == CT_TAB || d.action == CT_FORWARD || d.action == CT_BOLT) && !visual_bound {
      acquisition:=ifx efficient then c5_acquire(roaming,scans,(s.target_flags&1)!=0,d.action) else ifx (s.target_flags&1)!=0 then CT_SKIP else CT_SELECT;
      if acquisition==CT_SKIP { d = cb_action(CT_SKIP); why = "unbound-target"; }
      else if acquisition==CT_TAB { d=cb_action(CT_TAB); why="survey-priority"; }
      else {
        point = cv_best(bars,dims.width); why = "visible-candidate";
        if point.rows >= 2 {
          d = hunt_aim(point.x,dims.width);
        } else { d = cb_action(CT_TAB); why = "no-visible-candidate"; }
      }
    }
    survey_step := false; blocked_route := false;
    if d.action == CT_TAB {
      why = "survey-scan";
      if !roaming {
        scans += 1;
        if (ifx efficient then c5_scanned(scans) else scans>=12) { roaming = true; travel_ticks = 0; }
        else { d = ifx efficient then c5_scan() else hunt_scan_action(true,NavRoute.{}); }
      }
      if roaming {
        why = "survey-route";
        survey_step = true;
        route := nav_route(nav, hunt_goal(home, leg));
        if !route.ok { return cc_stop(journal, "invalid-survey-route"); }
        if tracked_leg != leg { tracked_leg = leg; survey_best = route.distance; survey_progress = now; }
        progress := hunt_progress(survey_best,route.distance,now - survey_progress);
        if progress == 1 { survey_best = route.distance; survey_progress = now; }
        if progress == 2 { blocked_route = true; tracked_leg = -1; }
        if route.arrived { leg = (leg + 1) % 4; roaming = false; scans = 0; d = ifx efficient then c5_scan() else hunt_scan_action(true,NavRoute.{}); }
        else {
          travel_ticks += 1;
          d = hunt_scan_action(false,route);
        }
      }
    }
    if !survey_step { tracked_leg = -1; }
    if last_action == CT_FORWARD {
      moved := abs(cast(f32) (nav.x - previous_nav.x)) + abs(cast(f32) (nav.y - previous_nav.y));
      stalled = ifx moved < 4 then stalled + 1 else 0;
      if stalled >= 3 {
        if !engaged && (s.flags & 4) == 0 { blocked_route = true; stalled = 0; }
        else { return cc_stop(journal, "approach-or-survey-blocked"); }
      }
    }
    if (recovery > 0 || blocked_route) && !engaged && (s.flags & 4) == 0 {
      why = "blocked-leg-recovery";
      plan := hunt_recovery(recovery,blocked_route); d = cb_action(plan.action); recovery = plan.remaining;
      if recovery == 0 { leg = (leg + 1) % 4; roaming = false; scans = 0; tracked_leg = -1; visual_bound = false; }
    }
    d = hunt_pull_pulse(d,visual_bound,engaged);
    new_fight := false;
    if d.action == CT_BOLT || d.action == CT_ATTACK {
      if !engaged { fight = s; engaged = true; new_fight = true; fight_started = now; last_progress = now; facing_turns=0; facing_error=s.error_serial; }
    }
    if d.action == CT_FOOD || d.action == CT_WATER { rest_until = now + 20000; }
    // Snapshot is current; no model inference or long work runs while a key is held.
    if fs_exists(stop) { return cc_stop(journal, "stop-file"); }
    if d.action != CT_WAIT {
      recheck_started := proc_now_ms();
      checked := gc_exchange_logged(h, t, "shot", 0, false, 0, 0, 0, recheck, reply[..], "shot",trace); if checked < 0 { return cc_stop(journal, "recheck-capture"); }
      latest := ct_read(recheck);
      recheck_bytes := ifx compact then ec_archive(recheck,dir,journal,i+1,true,recheck_started) else e2_archive(recheck,dir,journal,i + 1,true,recheck_started); if recheck_bytes < 0 { return cc_stop(journal,"recording-failed"); } archive_bytes += recheck_bytes;
      admitted := ifx defensive && why=="combat-facing-recovery" then c6_recheck(s,latest,d.action) else ifx efficient && d.action==CT_CLEAR && nav.combat then c5_corpse_recheck(s,latest) else ifx parking && !engaged && !nav.combat then c5_park_recheck(s,latest,nav_read(recheck),park,d.action) else ifx efficient then cb_recheck_profile(s,latest,d.action,engaged,true) else cb_recheck(s, latest, d.action, engaged);
      jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"recheck"); jo_key(o[..],"observation"); jo_int(o[..],i + 1);
      jo_key(o[..],"admitted"); jo_bool(o[..],admitted); jo_key(o[..],"sensor"); jo_raw(o[..],ct_json(latest,sensor[..]));
      jo_key(o[..],"navigation"); jo_raw(o[..],nav_json(nav_read(recheck),navtext[..])); jo_key(o[..],"loot"); jo_raw(o[..],lt_json(lt_read(recheck),loottext[..])); jo_end(o[..]); if !cc_record(journal,jo_text(o[..])) { return 1; }
      if !admitted {
        if new_fight { engaged = false; }
        saved := cc_record(journal, "{\"type\":\"action-discarded\",\"reason\":\"context-changed-before-input\"}");
        if !saved { return 1; } previous = s; previous_nav = nav; last_action = CT_WAIT; proc_sleep(500); continue;
      }
    }
    jo_start(o[..], out[..]); jo_obj(o[..]); jo_key(o[..], "type"); jo_str(o[..], "action"); jo_key(o[..], "observation"); jo_int(o[..], i + 1);
    jo_key(o[..], "name"); jo_str(o[..], CC_NAMES[d.action]); jo_key(o[..], "milliseconds"); jo_int(o[..], d.milliseconds);
    jo_key(o[..], "target_epoch"); jo_int(o[..], s.target_epoch); jo_key(o[..], "npc"); jo_int(o[..], s.npc); jo_key(o[..], "spawn"); jo_int(o[..], s.spawn);
    jo_key(o[..], "visual_target_bound"); jo_bool(o[..], visual_bound);
    jo_key(o[..],"monotonic_ms"); jo_int(o[..],proc_now_ms()); jo_key(o[..],"reason"); jo_str(o[..],why);
    jo_key(o[..],"baseline_action"); jo_int(o[..],baseline.action); jo_key(o[..],"engaged"); jo_bool(o[..],engaged);
    if defensive && why=="combat-facing-recovery" { jo_key(o[..],"facing_turn"); jo_int(o[..],facing_turns+1); jo_key(o[..],"cast_error_serial"); jo_int(o[..],s.error_serial); }
    jo_key(o[..],"roaming"); jo_bool(o[..],roaming); jo_key(o[..],"leg"); jo_int(o[..],leg); jo_key(o[..],"scans"); jo_int(o[..],scans);
    jo_key(o[..],"stalled"); jo_int(o[..],stalled); jo_key(o[..],"recovery"); jo_int(o[..],recovery); jo_key(o[..],"archive_bytes"); jo_int(o[..],archive_bytes);
    if point.rows >= 2 { jo_key(o[..], "candidate_x"); jo_int(o[..], point.x); jo_key(o[..], "candidate_y"); jo_int(o[..], point.y); jo_key(o[..], "candidate_width"); jo_int(o[..], point.width); }
    jo_end(o[..]);
    if !cc_record(journal, jo_text(o[..])) { return 1; } if d.action != CT_WAIT { print("%\n", jo_text(o[..])); }
    effect_started := proc_now_ms();
    applied := ifx d.action == CT_SELECT then cc_select(h,t,point,reply[..],trace) else cc_key(h, t, d, reply[..],trace);
    jo_start(o[..],out[..]); jo_obj(o[..]); jo_key(o[..],"type"); jo_str(o[..],"effect"); jo_key(o[..],"observation"); jo_int(o[..],i + 1);
    jo_key(o[..],"applied"); jo_bool(o[..],applied); jo_key(o[..],"started_ms"); jo_int(o[..],effect_started); jo_key(o[..],"ended_ms"); jo_int(o[..],proc_now_ms()); jo_end(o[..]);
    if !cc_record(journal,jo_text(o[..])) { return 1; }
    if !applied { return cc_stop(journal, "input-interrupted"); }
    if defensive && why=="combat-facing-recovery" { facing_turns+=1; facing_error=s.error_serial; }
    if pull_recovery>0 && (d.action==CT_BACK || d.action==CT_STRAFE) { pull_recovery-=1; }
    if d.action == CT_SELECT { pending_visual = true; }
    if !engaged && (d.action == CT_FORWARD || d.action == CT_SKIP) { visual_bound = false; }
    previous = s; previous_nav = nav; last_action = d.action; proc_sleep(ifx efficient then c5_pause(s,d.action,proc_now_ms()-now) else 500);
  }
  return cc_stop(journal, "observation-budget");
}
tool_main :: () -> int #export_c {
  a: [1] Args; if !args_load(a[..]) { return 2; }
  runtime: [4096] u8; default_socket: [4096] u8;
  socket := args_value(a[..], "--socket", fs_join(proc_getenv("XDG_RUNTIME_DIR", runtime[..]), "verse-desk.sock", default_socket[..]));
  dir := args_value(a[..], "--out", ""); steps := game_integer(args_value(a[..], "--steps", "360")); wanted := game_integer(args_value(a[..], "--kills", "3"));
  minimum:=game_integer(args_value(a[..],"--min-level","1")); goal:=game_integer(args_value(a[..],"--until-level","0"));
  defensive:=args_has(a[..],"--defensive"); if defensive && !args_has(a[..],"--efficient") { return 2; }
  hx:=game_integer(args_value(a[..],"--home-x","20300")); hy:=game_integer(args_value(a[..],"--home-y","45900"));
  px:=game_integer(args_value(a[..],"--park-x","-1")); py:=game_integer(args_value(a[..],"--park-y","-1")); parking:=args_has(a[..],"--park-x") || args_has(a[..],"--park-y"); park: NavGoal;
  if !minimum.ok || minimum.value<1 || minimum.value>5 || !goal.ok || (goal.value!=0 && goal.value!=6) || !hx.ok || !hy.ok || hx.value<0 || hy.value<0 || hx.value>64935 || hy.value>64935 { return 2; }
  if parking {
    if !args_has(a[..],"--efficient") || !px.ok || !py.ok || px.value<0 || py.value<0 || px.value>65535 || py.value>65535 || abs(cast(f32) (px.value-hx.value))+abs(cast(f32) (py.value-hy.value))>1800 { return 2; }
    park=NavGoal.{map=1426,x=px.value,y=py.value,radius=24,aspect_milli=1500};
  }
  if dir.count == 0 || dir[0] != '/' || fs_exists(dir) || !steps.ok || steps.value < 1 || steps.value > 1200 || !wanted.ok || wanted.value < 1 || wanted.value > 20 { tool_errln("usage: verse-combat --out NEW_ABSOLUTE_DIR [--socket PATH] [--steps 1..1200] [--kills 1..20] [--min-level 1..5] [--until-level 6] [--home-x X --home-y Y] [--hostile-only] [--compact] [--efficient] [--defensive]"); return 2; }
  if !fs_mkdir(dir) { return 1; } h := dc_open(socket); if h < 0 { return 1; }
  tracebuf: [4096] u8; trace := fs_join(dir,"wire.jsonl",tracebuf[..]);
  reply: [262144] u8; target := cc_target(h, reply[..],trace); home:=NavGoal.{map=1426,x=hx.value,y=hy.value,radius=24,aspect_milli=1500}; result := ifx target.handle > 0 then cc_run(h, target, dir, steps.value, wanted.value,minimum.value,goal.value,home,args_has(a[..],"--hostile-only"),args_has(a[..],"--compact"),args_has(a[..],"--efficient"),park,defensive) else 1;
  closed := cxsock_close(h); path: [4096] u8;
  after := dc_open(socket);
  if after >= 0 { info := gc_exchange_logged(after,GameTarget.{},"info",0,false,0,0,0,"",reply[..],"info",trace); closed_after := cxsock_close(after); }
  saved := cc_record(fs_join(dir, "journal.jsonl", path[..]), ifx result == 0 then "{\"type\":\"outcome\",\"status\":\"completed\"}" else "{\"type\":\"outcome\",\"status\":\"stopped\"}");
  return ifx saved then result else 1;
}
