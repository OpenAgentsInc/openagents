// Read visible neutral creature bars from the captured RGB image. No input effects.
#load "game-observation.coax";
#load "game-creature-vision.coax";
cv_frame :: (path: string) -> NavPpm {
  header: [128] u8; n := fs_read_at(path, 0, header[..]); return ifx n >= 0 then nav_ppm(cast(string) header[0..<n]) else NavPpm.{};
}
cv_candidates :: (path: string) -> CreatureBars {
  return cv_candidates_kind(path,false);
}
cv_candidates_kind :: (path: string,hostile_only: bool) -> CreatureBars {
  header: [128] u8; n := fs_read_at(path, 0, header[..]); if n < 0 { return CreatureBars.{}; }
  p := nav_ppm(cast(string) header[0..<n]);
  if p.width < 640 || p.height < 480 || fs_size(path) != p.offset + p.width * p.height * 3 { return CreatureBars.{}; }
  row: [12288] u8; bars: [1] CreatureBars;
  for q: 20..<(p.height - 180) / 2 {
    y := q * 2; if fs_read_at(path, p.offset + y * p.width * 3, row[0..<p.width * 3]) != p.width * 3 { return CreatureBars.{}; }
    cv_row_kind(row[0..<p.width * 3], y, bars[..],hostile_only);
  }
  return bars[0];
}
cv_read :: (path: string) -> CreatureBar {
  p := cv_frame(path); return cv_best(cv_candidates(path),p.width);
}
