// Recording capacity requests encounter drain; it never drops a capture silently.
#authority;
#load "../aethyr/points.coax";
#test "archive capacity drains at its inclusive bound and preserves explicit completion" {
  #assert ev_endrequest(99,100,0) == 0 && ev_endrequest(100,100,0) == 3 && ev_endrequest(101,100,0) == 3;
  #assert ev_endrequest(101,100,1) == 1 && ev_endrequest(101,100,2) == 2;
}
ev_endrequest :: (used: int, limit: int, normal: int) -> int {
  if normal != 0 { return normal; } return ifx used >= limit then 3 else 0;
}
#test "logging and transport time consume a pulse budget rather than extending its sleep" {
  #assert ev_sleep_for(300,0) == 300 && ev_sleep_for(300,299) == 1;
  #assert ev_sleep_for(300,300) == 0 && ev_sleep_for(300,301) == 0;
  #assert ev_sleep_for(40,6) == 34 && ev_sleep_for(1,0) == 1;
  #assert ev_sleep_for(0,0) == 0 && ev_sleep_for(-1,0) == 0 && ev_sleep_for(40,-1) == 0;
}
ev_sleep_for :: (planned: int, elapsed: int) -> int {
  if elapsed < 0 { return 0; }
  // Nonnegative part, without a branch whose equality case has the same result.
  remaining := cast(f32) (planned - elapsed); return cast(int) ((remaining + abs(remaining)) / 2);
}
