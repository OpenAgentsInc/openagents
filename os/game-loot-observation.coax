#load "game-combat-observation.coax";
#load "game-loot-sensor.coax";
lt_read :: (path: string) -> LootSample {
  header: [128] u8; n:=fs_read_at(path,0,header[..]); if n<0 { return LootSample.{}; } p:=nav_ppm(cast(string) header[0..<n]);
  if p.width==0 || fs_size(path)!=p.offset+p.width*p.height*3 { return LootSample.{}; }
  row: [12288] u8; other: [12288] u8; nav: [24] u8; bytes: [72] u8; last_y:=-1;
  if fs_read_at(path,p.offset+4*p.width*3,row[0..<p.width*3])!=p.width*3 { return LootSample.{}; }
  for pitch16:64..<513 {
    if 47*pitch16/32>=p.width { continue; }
    for cell:0..<8 { for c:0..<3 { nav[cell*3+c]=row[((2*cell+1)*pitch16/32)*3+c]; } }
    if !nav_sample(nav[..]).ok { continue; } y:=pitch16*7/32;
    if y!=last_y { if fs_read_at(path,p.offset+y*p.width*3,other[0..<p.width*3])!=p.width*3 { return LootSample.{}; } last_y=y; }
    for cell:0..<24 { for c:0..<3 { bytes[cell*3+c]=other[((2*cell+1)*pitch16/32)*3+c]; } }
    s:=lt_sample(bytes[..]); if s.ok { return s; }
  } return LootSample.{};
}
lt_json :: (s: LootSample,out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..],out); jo_obj(o[..]);
  names:=[28] string.["serial","flags","free","total","slots","opened","closed","items","full","copper","errors","error_type","npc","spawn","quantity","item","bags","range","other","seen_slots","seen_free","target_epoch","controls","source","time","before","spells","valid"];
  values:=[28] int.[s.serial,s.flags,s.free,s.total,s.slots,s.opened,s.closed,s.items,s.full,s.copper,s.errors,s.error_type,s.npc,s.spawn,s.quantity,s.item,s.bags,s.range,s.other,s.seen_slots,s.seen_free,s.target_epoch,s.controls,s.source,s.time,s.before,s.spells,ifx s.ok then 1 else 0];
  for i:0..<28 { jo_key(o[..],names[i]); jo_int(o[..],values[i]); } jo_end(o[..]); return jo_text(o[..]);
}
