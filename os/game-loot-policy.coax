// One observed, player-owned corpse; ordinary keys only, no persistent autowalk.
#authority;
#load "game-loot-sensor.coax";
LT_WAIT :: 0; LT_INTERACT :: 1; LT_FORWARD :: 2; LT_RESTORE :: 3; LT_CLOSE :: 4;
LT_RECEIPT :: 5; LT_EMPTY :: 6; LT_FULL :: 7; LT_TIMEOUT :: 8; LT_LOST :: 9; LT_REFUSE :: 10;
LootContext :: struct { npc: int; spawn: int; opened: int; closed: int; items: int; full: int; copper: int; }
lt_fixture :: () -> CombatSample { return CombatSample.{ok=true,flags=3,health=100,health_max=100,npc=1,spawn=2,target_flags=5}; }
#test "looting is bound to a verified corpse and public input configuration" {
  s:=lt_fixture(); l:=LootSample.{ok=true,flags=5,controls=3}; c:=LootContext.{npc=1,spawn=2};
  #assert s.health==100 && s.health_max==100;
  #assert lt_choose(s,l,c,0,false,0,0)==LT_INTERACT;
  #assert lt_choose(s,l,c,1,false,1,0)==LT_FORWARD;
  #assert lt_choose(s,l,c,2,false,1,0)==LT_INTERACT;
  #assert lt_choose(s,l,c,1,false,12000,400)==LT_FORWARD;
  #assert lt_choose(s,l,c,1,false,12001,0)==LT_TIMEOUT;
  #assert lt_choose(s,l,c,1,false,0,401)==LT_TIMEOUT;
  #assert lt_choose(s,l,c,24,false,0,0)==LT_TIMEOUT;
  #assert lt_choose(s,l,c,23,false,0,0)==LT_FORWARD;
  t:=s; t.npc=2; #assert lt_choose(t,l,c,0,false,0,0)==LT_LOST;
  t=s; t.spawn=1; #assert lt_choose(t,l,c,0,false,0,0)==LT_LOST;
  t=s; t.target_flags=1; #assert lt_choose(t,l,c,0,false,0,0)==LT_LOST;
  t=s; t.target_flags=4; #assert lt_choose(t,l,c,0,false,0,0)==LT_RESTORE;
  #assert lt_choose(t,l,c,0,true,0,0)==LT_LOST;
  t=s; t.ok=false; #assert lt_choose(t,l,c,0,false,0,0)==LT_REFUSE;
  for flags: [5] int.[0,1,7,11,19] { t=s; t.flags=flags; #assert lt_choose(t,l,c,0,false,0,0)==LT_REFUSE; }
  t=s; t.health=34; #assert lt_choose(t,l,c,0,false,0,0)==LT_REFUSE;
  t.health=35; #assert lt_choose(t,l,c,0,false,0,0)==LT_INTERACT;
  t.health_max=0; #assert lt_choose(t,l,c,0,false,0,0)==LT_REFUSE;
  t.health=1; t.health_max=1; #assert lt_choose(t,l,c,0,false,0,0)==LT_INTERACT;
  t.health=3480; t.health_max=10000; #assert lt_choose(t,l,c,0,false,0,0)==LT_REFUSE;
  v:=l; v.ok=false; #assert lt_choose(s,v,c,0,false,0,0)==LT_REFUSE;
  v=l; v.flags=1; #assert lt_choose(s,v,c,0,false,0,0)==LT_REFUSE;
  v=l; v.flags=133; #assert lt_choose(s,v,c,0,false,0,0)==LT_REFUSE;
  for controls: [9] int.[0,1,2,7,11,19,35,67,131] { v=l; v.controls=controls; #assert lt_choose(s,v,c,0,false,0,0)==LT_REFUSE; }
  c.npc=0; #assert lt_choose(s,l,c,0,false,0,0)==LT_REFUSE;
}
#test "loot outcomes require a new matching source session and observed receipt" {
  s:=lt_fixture(); l:=LootSample.{ok=true,flags=5,controls=3,opened=1,closed=1,npc=1,spawn=2,source=1}; c:=LootContext.{npc=1,spawn=2};
  #assert lt_choose(s,l,c,0,false,0,0)==LT_EMPTY;
  l.items=1; #assert lt_choose(s,l,c,0,false,0,0)==LT_RECEIPT;
  l.items=0; l.copper=1; #assert lt_choose(s,l,c,0,false,0,0)==LT_RECEIPT;
  l.copper=0; l.seen_slots=1; #assert lt_choose(s,l,c,0,false,0,0)==LT_LOST;
  l.seen_slots=0; l.closed=0; #assert lt_choose(s,l,c,0,false,0,0)==LT_WAIT;
  l.flags=7; #assert lt_choose(s,l,c,0,false,2000,0)==LT_WAIT;
  #assert lt_choose(s,l,c,0,false,2001,0)==LT_CLOSE;
  l.full=1; #assert lt_choose(s,l,c,0,false,0,0)==LT_CLOSE;
  l.flags=5; #assert lt_choose(s,l,c,0,false,0,0)==LT_FULL;
  l.npc=2; #assert lt_choose(s,l,c,0,false,0,0)==LT_LOST;
  l.npc=1; l.spawn=3; #assert lt_choose(s,l,c,0,false,0,0)==LT_LOST;
  l.spawn=2; l.source=0; #assert lt_choose(s,l,c,0,false,0,0)==LT_LOST;
  l.source=2; #assert lt_choose(s,l,c,0,false,0,0)==LT_FULL;
  l.opened=0; #assert lt_choose(s,l,c,0,false,0,0)==LT_FULL;
  l.full=0; l.free=0; #assert lt_choose(s,l,c,0,false,0,0)==LT_INTERACT;
}
lt_choose :: (s: CombatSample,l: LootSample,c: LootContext,attempts: int,restored: bool,elapsed: int,displacement: int) -> int {
  if !s.ok || !l.ok || (s.flags&31)!=3 || (l.flags&133)!=5 || l.controls!=3 || s.health_max<=0 || s.health*100<s.health_max*35 || c.npc<=0 { return LT_REFUSE; }
  if l.opened!=c.opened {
    if l.source==0 || l.npc!=c.npc || l.spawn!=c.spawn { return LT_LOST; }
    if (l.flags&2)!=0 { return ifx l.full!=c.full || elapsed>2000 then LT_CLOSE else LT_WAIT; }
    if l.full!=c.full { return LT_FULL; }
    if l.closed==c.closed { return LT_WAIT; }
    if l.items!=c.items || l.copper>c.copper { return LT_RECEIPT; }
    return ifx l.seen_slots==0 then LT_EMPTY else LT_LOST;
  }
  if l.full!=c.full { return LT_FULL; }
  if elapsed>12000 || displacement>400 || attempts>=24 { return LT_TIMEOUT; }
  if (s.target_flags&1)==0 { return ifx restored then LT_LOST else LT_RESTORE; }
  if (s.target_flags&4)==0 || s.npc!=c.npc || s.spawn!=c.spawn { return LT_LOST; }
  return ifx attempts%2==0 then LT_INTERACT else LT_FORWARD;
}
#test "loot effects have bounded exact key adapters" {
  keys:=[5] int.[0,64,17,65,1]; times:=[5] int.[0,40,200,40,40];
  for i:0..<5 { #assert lt_key(i)==keys[i] && lt_duration(i)==times[i]; }
  #assert lt_key(-1)==0 && lt_key(5)==0 && lt_duration(-1)==0 && lt_duration(5)==0;
}
lt_key :: (a: int) -> int { if a<1 || a>4 { return 0; } keys:=[4] int.[64,17,65,1]; return keys[a-1]; }
lt_duration :: (a: int) -> int { return ifx a==LT_FORWARD then 200 else ifx a>=1 && a<=4 then 40 else 0; }
