// Third public SDK strip; existing observation identities remain unchanged.
#authority;
#load "game-combat-sensor.coax";
LootSample :: struct {
  ok: bool; serial: int; flags: int; free: int; total: int; slots: int; opened: int; closed: int; items: int; full: int; copper: int;
  errors: int; error_type: int; npc: int; spawn: int; quantity: int; item: int; bags: int; range: int; other: int;
  seen_slots: int; seen_free: int; target_epoch: int; controls: int; source: int; time: int; before: int; spells: int;
}
#test "loot strip checks all fields, framing, capacity and every corrupted byte" {
  b: [72] u8; for i: 3..<68 { b[i]=cast(u8) i; }
  b[0]=86; b[1]=76; b[2]=1; b[5]=5; b[10]=0; b[11]=3; b[55]=1;
  b[64]=0; b[65]=0; b[66]=0; b[67]=15; lt_seal(b[..]);
  s:=lt_sample(b[..]); #assert s.ok && s.serial==772 && s.flags==5 && s.free==1543 && s.total==2057 && s.slots==3;
  #assert s.opened==3085 && s.closed==3599 && s.items==4113 && s.full==4627 && s.copper==336926231;
  #assert s.errors==6169 && s.error_type==6683 && s.npc==471670303 && s.spawn==539042339;
  #assert s.quantity==9253 && s.item==640100393 && s.bags==10795 && s.range==11309 && s.other==11823;
  #assert s.seen_slots==12337 && s.seen_free==12851 && s.target_epoch==13365 && s.controls==54 && s.source==1;
  #assert s.time==943274555 && s.before==1010646591 && s.spells==15;
  for i: 0..<72 { t:=b; t[i]=t[i]^1; #assert !lt_sample(t[..]).ok; }
  #assert !lt_sample(b[0..<71]).ok;
  for i: 0..<3 { t:=b; t[i]-=1; lt_seal(t[..]); #assert !lt_sample(t[..]).ok; }
  t:=b; t[5]=4; lt_seal(t[..]); #assert !lt_sample(t[..]).ok;
  t=b; t[55]=3; lt_seal(t[..]); #assert !lt_sample(t[..]).ok;
  t=b; t[6]=255; lt_seal(t[..]); #assert !lt_sample(t[..]).ok;
  t=b; t[10]=0; t[11]=33; lt_seal(t[..]); #assert !lt_sample(t[..]).ok;
  t=b; t[67]=16; lt_seal(t[..]); #assert !lt_sample(t[..]).ok;
  t=b; t[55]=0; t[11]=32; t[6]=8; t[7]=9; lt_seal(t[..]); #assert lt_sample(t[..]).ok;
  t[55]=2; t[11]=0; t[67]=0; lt_seal(t[..]); #assert lt_sample(t[..]).ok;
  t=b; t[6]=0; t[7]=2; t[8]=0; t[9]=1; lt_seal(t[..]); #assert !lt_sample(t[..]).ok;
}
lt_seal :: (b: [] u8) { crc:=png_crc(b[0..<68]); for i:0..<4 { b[68+i]=cast,trunc(u8) (crc >> ((3-i)*8)); } }
lt_sample :: (b: [] u8) -> LootSample {
  bad: LootSample;
  if b.count!=72 || b[0]!=86 || b[1]!=76 || b[2]!=1 || (b[5]&1)==0 || png_crc(b[0..<68])!=ct_uint(b,68,4) { return bad; }
  if b[55]>2 || nav_word(b,6)>nav_word(b,8) || nav_word(b,10)>32 || ct_uint(b,64,4)>15 { return bad; }
  return LootSample.{ok=true,serial=nav_word(b,3),flags=cast(int) b[5],free=nav_word(b,6),total=nav_word(b,8),slots=nav_word(b,10),opened=nav_word(b,12),closed=nav_word(b,14),items=nav_word(b,16),full=nav_word(b,18),copper=ct_uint(b,20,4),
    errors=nav_word(b,24),error_type=nav_word(b,26),npc=ct_uint(b,28,4),spawn=ct_uint(b,32,4),quantity=nav_word(b,36),item=ct_uint(b,38,4),bags=nav_word(b,42),range=nav_word(b,44),other=nav_word(b,46),seen_slots=nav_word(b,48),seen_free=nav_word(b,50),target_epoch=nav_word(b,52),controls=cast(int) b[54],source=cast(int) b[55],time=ct_uint(b,56,4),before=ct_uint(b,60,4),spells=ct_uint(b,64,4)};
}
