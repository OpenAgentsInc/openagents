// Offline codec experiment on retained captures. Never opens a game/input lease.
#import "Basic";
#load "game-evidence-v2.coax";
#load "game-client.coax";
lp_line :: (path: string,offset: int,out: [] u8) -> int {
  n:=fs_read_at(path,offset,out); if n<=0 { return -1; } for i:0..<n { if out[i]=='\n' { return i; } } return -1;
}
#test "framehash comparison reads complete hexadecimal payload digests only" {
  digest:="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  #assert lp_digest(digest)==digest && lp_digest("#comment")=="" && lp_digest("short")=="";
  #assert lp_digest("g123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")=="";
}
lp_digest :: (line: string) -> string {
  if line.count<64 || line[0]=='#' { return ""; } tail:=line[line.count-64..<line.count];
  for c:tail { if !((c>='0' && c<='9') || (c>='a' && c<='f')) { return ""; } } return tail;
}
lp_compare :: (a: string,b: string,wanted: int) -> bool {
  row: [4096] u8; hashes: [120] [64] u8; count:=0; offset:=0;
  while offset<fs_size(a) { n:=lp_line(a,offset,row[..]); if n<0 { return false; } offset+=n+1; h:=lp_digest(cast(string) row[0..<n]); if h.count==0 { continue; }
    if count==120 { return false; } for i:0..<64 { hashes[count][i]=h[i]; } count+=1;
  }
  if count!=wanted { return false; } offset=0; count=0;
  while offset<fs_size(b) { n:=lp_line(b,offset,row[..]); if n<0 { return false; } offset+=n+1; h:=lp_digest(cast(string) row[0..<n]); if h.count==0 { continue; }
    if count>=wanted || h!=cast(string) hashes[count][..] { return false; } count+=1;
  } return count==wanted;
}
tool_main :: () -> int #export_c {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..])!=3 { tool_errln("usage: lossless-probe RUN_DIR NEW_ABSOLUTE_OUT IMAGE_COUNT_1_TO_120"); return 2; }
  source:=args_at(a[..],0); dest:=args_at(a[..],1); count:=args_number(args_at(a[..],2));
  if !count.ok || count.value<1 || count.value>120 || dest.count==0 || dest[0]!='/' || fs_exists(dest) || !fs_mkdir(dest) { return 2; }
  paths: [7] [4096] u8; movie:=fs_join(dest,"lossless.mkv",paths[0][..]); before:=fs_join(dest,"source.framehash",paths[1][..]); after:=fs_join(dest,"decoded.framehash",paths[2][..]);
  scratch:=fs_join(dest,"frame.ppm",paths[3][..]); previous:=fs_join(dest,"previous.ppm",paths[4][..]); journal:=fs_join(source,"journal.jsonl",paths[5][..]); decoded:=fs_join(dest,"decoded.ppm",paths[6][..]);
  argv:=[40] string.["ffmpeg","-v","error","-nostdin","-f","image2pipe","-framerate","1","-vcodec","ppm","-i","pipe:0","-map","0:v","-c:v","libx264rgb","-preset","veryfast","-tune","zerolatency","-crf","0","-g","30","-threads","2","-pix_fmt","rgb24",movie,"-map","0:v","-c:v","rawvideo","-pix_fmt","rgb24","-f","framehash","-hash","sha256",before];
  encoder:=proc_new(); if encoder<0 { return 1; } for arg:argv { if !proc_arg(encoder,arg) { r:=proc_release(encoder); return 1; } }
  if proc_start(encoder)!=0 { r:=proc_release(encoder); return 1; }
  row: [65536] u8; chunk: [65536] u8; nodes: [4096] JvNode; parsed: [1] Jv; offset:=0; frames:=0; total:=0; raw:=0; good:=true; began:=proc_now_ms();
  while offset<fs_size(journal) && frames<cast(int) count.value {
    n:=lp_line(journal,offset,row[..]); if n<0 || !jv_parse(parsed[..],cast(string) row[0..<n],nodes[..]) { good=false; break; } offset+=n+1; d:=parsed[0];
    if jv_raw(d,jv_get(d,0,"type"))!="image" { continue; }
    seq:=jv_int(d,jv_get(d,0,"observation"),0); recheck:=jv_raw(d,jv_get(d,0,"phase"))=="recheck";
    namebuf: [128] u8; archivebuf: [4096] u8; patchbuf: [8192] u8; name:=ev_name(seq,recheck,namebuf[..]); archive:=fs_join(source,name,archivebuf[..]);
    o: [1] Jo; jo_start(o[..],patchbuf[..]); jo_put(o[..],"--patch-from="); jo_put(o[..],previous);
    plain:=[8] string.["zstd","-q","-d","-f","-o",scratch,"--",archive]; delta:=[9] string.["zstd","-q","-d","-f",jo_text(o[..]),"-o",scratch,"--",archive];
    if !(ifx e2_base(seq,recheck)>0 then e2_process(delta[..]) else e2_process(plain[..])) { good=false; break; }
    if !recheck { cp:=[3] string.["cp",scratch,previous]; if !e2_process(cp[..]) { good=false; break; } }
    size:=fs_size(scratch); at:=0; raw+=size; total+=fs_size(archive);
    while at<size { take:=ifx size-at>chunk.count then chunk.count else size-at; got:=fs_read_at(scratch,at,chunk[0..<take]);
      if got!=take || !proc_send(encoder,cast(string) chunk[0..<take]) { good=false; break; } at+=take;
    }
    if !good { break; } frames+=1;
  }
  closed:=proc_close_stdin(encoder); status:=proc_wait(encoder,30000); err: [4096] u8; message:=proc_stderr(encoder,err[..]); freed:=proc_release(encoder);
  if !good || frames!=cast(int) count.value || status!=0 { tool_errln(message); return 1; }
  verify:=[17] string.["ffmpeg","-v","error","-nostdin","-i",movie,"-map","0:v","-c:v","rawvideo","-pix_fmt","rgb24","-f","framehash","-hash","sha256",after];
  out: [4096] u8; r:=proc_run(verify[..],120000,out[..],err[..]); same:=r.started==0 && r.status==0 && lp_compare(before,after,frames);
  // Verify a complete PPM as well as every frame's RGB payload.
  filterbuf: [128] u8; number: [32] u8; o: [1] Jo; jo_start(o[..],filterbuf[..]); jo_put(o[..],"select=eq(n\\,"); jo_put(o[..],ev_number(frames-1,number[..])); jo_put(o[..],")");
  decode:=[16] string.["ffmpeg","-v","error","-nostdin","-i",movie,"-vf",jo_text(o[..]),"-frames:v","1","-pix_fmt","rgb24","-fps_mode","passthrough","-y",decoded];
  r=proc_run(decode[..],30000,out[..],err[..]); cmp:=[4] string.["cmp","--",scratch,decoded]; c:=proc_run(cmp[..],5000,out[..],err[..]); same=same && r.status==0 && c.status==0;
  print("{\"frames\":%,\"old_bytes\":%,\"raw_bytes\":%,\"lossless_bytes\":%,\"all_rgb_sha256_equal\":%,\"last_ppm_byte_equal\":%,\"elapsed_ms\":%}\n",frames,total,raw,fs_size(movie),same,c.status==0,proc_now_ms()-began);
  removed:=fs_remove(scratch); removed_previous:=fs_remove(previous); removed_decoded:=fs_remove(decoded);
  return ifx same then 0 else 1;
}
