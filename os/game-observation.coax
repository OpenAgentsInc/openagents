// Read the SDK's observation strip from an unscaled desk PPM; no input effects.
#load "../coax/lib/sys/tool.coax";
#load "../coax/lib/sys/fs.coax";
#load "../coax/lib/json/json.coax";
#load "game-sensor.coax";

NavPpm :: struct { width: int; height: int; offset: int; }
#test "the desk's exact P6 header and incomplete or oversized headers" {
  p := nav_ppm("P6\n2548 1428\n255\nrest");
  #assert p.width == 2548 && p.height == 1428 && p.offset == 17;
  for bad: [5] string.["P5\n64 64\n255\n", "P6\n63 64\n255\n", "P6\n64 4097\n255\n", "P6\n64 64\n256\n", "P6\n64 64\n255"] { #assert nav_ppm(bad).width == 0; }
}
nav_ppm :: (s: string) -> NavPpm {
  p: NavPpm;
  if s.count < 3 || s[0..<3] != "P6\n" { return p; }
  fields: [3] int; nf := 0; value := 0;
  for i: 3..<s.count {
    c := s[i];
    if c >= '0' && c <= '9' { value = value * 10 + cast(int) (c - '0'); if value > 4096 { return p; } }
    else if c == ' ' || c == '\n' {
      fields[nf] = value; nf += 1; value = 0;
      if nf == 3 {
        if fields[0] < 64 || fields[1] < 64 || fields[2] != 255 { return p; }
        return NavPpm.{width = fields[0], height = fields[1], offset = i + 1};
      }
    } else { return p; }
  }
  return p;
}
nav_read :: (path: string) -> NavSample {
  header: [128] u8; n := fs_read_at(path, 0, header[..]);
  if n < 0 { return NavSample.{}; }
  p := nav_ppm(cast(string) header[0..<n]); if p.width == 0 { return NavSample.{}; }
  if fs_size(path) != p.offset + p.width * p.height * 3 { return NavSample.{}; }
  row: [12288] u8; bytes: [24] u8;
  n = fs_read_at(path, p.offset + 4 * p.width * 3, row[0..<p.width * 3]);
  if n != p.width * 3 { return NavSample.{}; }
  // WoW applies a UI scale in addition to a frame's effective scale. Resolve the visible
  // cell pitch from the complete magic/checksum, rather than assuming physical 8px cells.
  for pitch16: 64..<513 {
    if (15 * pitch16 / 32) >= p.width { continue; }
    for cell: 0..<8 { for c: 0..<3 { bytes[3 * cell + c] = row[((2 * cell + 1) * pitch16 / 32) * 3 + c]; } }
    s := nav_sample(bytes[..]); if s.ok { return s; }
  }
  return NavSample.{};
}
nav_json :: (s: NavSample, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out); jo_obj(o[..]);
  jo_key(o[..], "source"); jo_str(o[..], "wow-public-api-strip-v1");
  jo_key(o[..], "serial"); jo_int(o[..], s.serial); jo_key(o[..], "map"); jo_int(o[..], s.map);
  jo_key(o[..], "x_u16"); jo_int(o[..], s.x); jo_key(o[..], "y_u16"); jo_int(o[..], s.y);
  jo_key(o[..], "heading_u16"); jo_int(o[..], s.heading);
  jo_key(o[..], "alive"); jo_bool(o[..], s.alive); jo_key(o[..], "combat"); jo_bool(o[..], s.combat);
  jo_key(o[..], "ui_blocked"); jo_bool(o[..], s.blocked); jo_end(o[..]); return jo_text(o[..]);
}
nav_sense_main :: () -> int {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: game-sense CAPTURE.ppm"); return 2; }
  s := nav_read(args_at(a[..], 0));
  if !s.ok { tool_errln("sense: no complete valid unscaled WoW observation strip"); return 1; }
  out: [1024] u8; print("%\n", nav_json(s, out[..])); return 0;
}
