#authority;
#load "game-policy.coax";
#test "filesystem free-space facts have exact bounded block and fragment values" {
  #assert rr_bytes("0 1")==0 && rr_bytes("1 1")==1 && rr_bytes("1000000000 1048576")==1048576000000000;
  #assert rr_bytes("1000000001 1")==-1 && rr_bytes("1 1048577")==-1 && rr_bytes("1 0")==-1;
  #assert rr_bytes("805306368 1")==805306368;
  #assert rr_bytes("123 4096")==503808 && rr_bytes("12  3")==-1 && rr_bytes("12 x")==-1;
  #assert rr_bytes("9 9")==81 && rr_bytes("1 :")==-1;
  #assert rr_bytes("-1 4096")==-1 && rr_bytes("1 -1")==-1;
  #assert rr_bytes("")==-1 && rr_bytes("12")==-1 && rr_bytes(" 12")==-1 && rr_bytes("12 ")==-1 && rr_bytes("1 2 3")==-1;
  #assert rr_low(-1) && rr_low(0) && rr_low(805306368) && !rr_low(805306369);
}
rr_bytes :: (text: string) -> int {
  a:=0; b:=0; separated:=false; digit_seen:=false;
  for c:text {
    if c==' ' { if separated || !digit_seen { return -1; } separated=true; continue; }
    if c<'0' || c>'9' { return -1; } digit:=cast(int) (c-'0');
    if separated { b=b*10+digit; if b>1048576 { return -1; } }
    else { digit_seen=true; a=a*10+digit; if a>1000000000 { return -1; } }
  }
  if b<1 { return -1; } return a*b;
}
rr_low :: (available: int) -> bool { return available<=805306368; }
