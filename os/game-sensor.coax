// Decoder for the visible WoW SDK observation strip. Only complete checked samples publish.
#authority;
NavSample :: struct { ok: bool; serial: int; map: int; x: int; y: int; heading: int; alive: bool; combat: bool; blocked: bool; }
#test "strip bytes decode independently calculated sample and reject every corrupted byte" {
  b := [24] u8.[86,78,1,0,7,3,0,1,0,128,0,0,64,0,0,32,0,0,0,0,0,0,0,144];
  // Sum 0..22 = 400, modulo 256 = 144.
  s := nav_sample(b[..]);
  #assert s.ok && s.serial == 7 && s.map == 1 && s.x == 32768 && s.y == 16384 && s.heading == 8192 && s.alive && !s.combat && !s.blocked;
  for i: 0..<24 { bad := b; bad[i] = bad[i] ^ 1; #assert !nav_sample(bad[..]).ok; }
  #assert !nav_sample(b[0..<23]).ok;
  b[5] = 5; b[23] = 146; s = nav_sample(b[..]); #assert s.ok && !s.alive && s.combat;
  b[5] = 0; b[23] = 141; #assert !nav_sample(b[..]).ok;
  b[5] = 17; b[23] = 158; #assert !nav_sample(b[..]).ok;
  b[5] = 11; b[23] = 152; #assert nav_sample(b[..]).blocked;
  b[5] = 15; b[23] = 156; #assert nav_sample(b[..]).ok;
  b[5] = 3; b[7] = 0; b[23] = 143; #assert !nav_sample(b[..]).ok;
  b[7] = 1; b[8] = 1; b[23] = 145; #assert !nav_sample(b[..]).ok;
  b[8] = 0;
  for i: [9] int.[8,11,14,17,18,19,20,21,22] { bad := b; bad[i] = 1; bad[23] = 145; #assert !nav_sample(bad[..]).ok; }
}
nav_word :: (b: [] u8, at: int) -> int { return cast(int) b[at] * 256 + cast(int) b[at + 1]; }
nav_sample :: (b: [] u8) -> NavSample {
  s: NavSample;
  if b.count != 24 || b[0] != 86 || b[1] != 78 || b[2] != 1 { return s; }
  sum := 0; for i: 0..<23 { sum += cast(int) b[i]; }
  if (sum & 255) != cast(int) b[23] || (b[5] & 1) == 0 || (b[5] >> 4) != 0 { return s; }
  for i: [9] int.[8,11,14,17,18,19,20,21,22] { if b[i] != 0 { return s; } }
  s.serial = nav_word(b, 3); s.map = nav_word(b, 6); s.x = nav_word(b, 9); s.y = nav_word(b, 12); s.heading = nav_word(b, 15);
  if s.map == 0 { return NavSample.{}; }
  s.alive = (b[5] & 2) != 0; s.combat = (b[5] & 4) != 0; s.blocked = (b[5] & 8) != 0; s.ok = true; return s;
}
