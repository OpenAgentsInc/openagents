// Passive game-only recorder: desk shots and public sensor reads, never an input lease.
#import "Basic";
#load "game-client.coax";
#load "game-combat-observation.coax";
#load "game-loot-observation.coax";
#load "game-policy.coax";
gv_run :: (dir: string, seconds: int, socket: string) -> int {
  paths: [5] [4096] u8; image := fs_join(dir,"frame.ppm",paths[0][..]); movie := fs_join(dir,"video.mp4",paths[1][..]);
  journal := fs_join(dir,"frames.jsonl",paths[2][..]); stop := fs_join(dir,"stop",paths[3][..]); trace := fs_join(dir,"wire.jsonl",paths[4][..]);
  h := dc_open(socket); if h < 0 { return 1; } reply: [262144] u8; empty: GameTarget;
  n := gc_exchange_logged(h,empty,"list",0,false,0,0,0,"",reply[..],"windows",trace); if n < 0 { c := cxsock_close(h); return 1; }
  t := gc_target(cast(string) reply[0..<n],"World of Warcraft",0,0); if t.handle <= 0 { c := cxsock_close(h); return 1; }
  argv := [27] string.["ffmpeg","-v","error","-nostdin","-f","image2pipe","-framerate","4","-use_wallclock_as_timestamps","1","-vcodec","ppm","-i","pipe:0","-fps_mode","vfr","-c:v","libx264","-preset","veryfast","-crf","20","-threads","2","-pix_fmt","yuv420p",movie];
  encoder := proc_new(); if encoder < 0 { c := cxsock_close(h); return 1; }
  ok := true; for arg: argv { ok = ok && proc_arg(encoder,arg); }
  if !ok || proc_start(encoder) != 0 { freed := proc_release(encoder); c := cxsock_close(h); return 1; }
  started := proc_now_ms(); frames := 0; late := 0; row: [32768] u8; sensor: [8192] u8; navigation: [1024] u8; loot: [2048] u8; chunk: [65536] u8;
  while proc_now_ms() - started < seconds * 1000 && !fs_exists(stop) {
    begin := proc_now_ms();
    n = gc_exchange_logged(h,t,"shot",0,false,0,0,0,image,reply[..],"shot",trace); if n < 0 { ok = false; break; }
    nodes: [256] JvNode; parsed: [1] Jv;
    if !jv_parse(parsed[..],cast(string) reply[0..<n],nodes[..]) { ok = false; break; }
    d := parsed[0]; w := jv_get(d,0,"window");
    // Never encode another window exposed by a layout/focus change.
    if !jv_bool(d,jv_get(d,w,"focused")) || jv_int(d,jv_get(d,w,"x"),-1) != 0 || jv_int(d,jv_get(d,w,"y"),-1) != 0 { ok = false; break; }
    size := fs_size(image); at := 0;
    while at < size {
      take := ifx size - at > chunk.count then chunk.count else size - at;
      got := fs_read_at(image,at,chunk[0..<take]);
      if got != take || !proc_send(encoder,cast(string) chunk[0..<take]) { ok = false; break; } at += take;
    }
    if !ok || size <= 0 { ok = false; break; }
    s := ct_read(image); nav := nav_read(image); o: [1] Jo; jo_start(o[..],row[..]); jo_obj(o[..]);
    jo_key(o[..],"type"); jo_str(o[..],"video-frame"); jo_key(o[..],"index"); jo_int(o[..],frames);
    jo_key(o[..],"started_ms"); jo_int(o[..],begin); jo_key(o[..],"ended_ms"); jo_int(o[..],proc_now_ms());
    jo_key(o[..],"capture"); jo_raw(o[..],cast(string) reply[0..<n]); jo_key(o[..],"sensor"); jo_raw(o[..],ct_json(s,sensor[..])); jo_key(o[..],"navigation"); jo_raw(o[..],nav_json(nav,navigation[..])); jo_key(o[..],"loot"); jo_raw(o[..],lt_json(lt_read(image),loot[..])); jo_end(o[..]);
    text := jo_text(o[..]); row[text.count] = '\n'; if !fs_append(journal,cast(string) row[0..<text.count + 1]) { ok = false; break; }
    frames += 1; deadline := started + frames * 250; remaining := deadline - proc_now_ms(); if remaining > 0 { proc_sleep(remaining); } else { late += 1; }
  }
  input_closed := proc_close_stdin(encoder); status := proc_wait(encoder,30000); errors: [4096] u8; message := proc_stderr(encoder,errors[..]);
  if status == PROC_RUNNING { interrupted := proc_kill(encoder,2); status = proc_wait(encoder,5000); }
  freed := proc_release(encoder); closed := cxsock_close(h); removed := fs_remove(image);
  print("{\"frames\":%,\"elapsed_ms\":%,\"late_frames\":%,\"stream_ok\":%,\"encoder_status\":%}\n",frames,proc_now_ms() - started,late,ok,status);
  if !ok || status != 0 { tool_errln(message); return 1; } return 0;
}
tool_main :: () -> int #export_c {
  a: [1] Args; if !args_load(a[..]) { return 2; } dir := args_value(a[..],"--out",""); seconds := game_integer(args_value(a[..],"--seconds","600"));
  runtime: [4096] u8; default_socket: [4096] u8; socket := args_value(a[..],"--socket",fs_join(proc_getenv("XDG_RUNTIME_DIR",runtime[..]),"verse-desk.sock",default_socket[..]));
  if dir.count == 0 || dir[0] != '/' || fs_exists(dir) || !seconds.ok || seconds.value < 1 || seconds.value > 660 || !fs_mkdir(dir) { tool_errln("usage: game-video --out NEW_ABSOLUTE_DIR [--seconds 1..660] [--socket PATH]"); return 2; }
  return gv_run(dir,seconds.value,socket);
}
