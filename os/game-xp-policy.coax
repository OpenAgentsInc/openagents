#authority;
#test "XP quality uses measured XP and fight cost, with independent area and easy-kill notes" {
  #assert xp_low(0) && xp_low(20) && !xp_low(21);
  #assert xp_easy(5,2,10000,0) && !xp_easy(5,3,10000,0);
  #assert !xp_easy(5,2,10001,0) && !xp_easy(5,2,10000,1);
  #assert !xp_area(2,3) && xp_area(3,3) && !xp_area(3,4) && xp_area(4,4);
  #assert !xp_goal(5,6) && xp_goal(6,6) && xp_goal(7,6) && !xp_goal(6,0);
  #assert xp_goal(1,1);
}
xp_low :: (gained: int) -> bool { return gained<=20; }
xp_easy :: (level: int,target: int,milliseconds: int,damage: int) -> bool { return target<=level-3 && milliseconds<=10000 && damage==0; }
xp_area :: (low: int,total: int) -> bool { return total>=3 && low==total; }
xp_goal :: (level: int,wanted: int) -> bool { return wanted>0 && level>=wanted; }
