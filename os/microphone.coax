// CoderOS screen recording: which microphone a take reads (docs/os/2026-10-30-coderos-and-coax-audit.md,
// step 2 row 4), in place of screen-record's pick_microphone (openagents 2ca255550e). The sources are
// PipeWire's Audio/Source nodes; the choice is, in order: the node a take was already reading
// (`want`, by name, then by name without its trailing ".N", which PipeWire adds when it mints a
// node again), the first whose name matches the host's pattern ($CODEROS_MICROPHONE_NODE, a
// regular expression), and the default source. `preferred` says whether the choice is the
// host's microphone (true when there is no pattern), which is what makes a take warn out loud
// when it falls back to another one, as on 2026-09-07.
//   coax/web/tool.sh os/microphone.coax pick [WANT] [--dump FILE] [--default ID]
//   coax/web/tool.sh os/microphone.coax match PATTERN NAME      what the pattern says of NAME
// It prints jq's compact object: {"id":..,"name":..,"description":..,"nick":..,"preferred":..}.
// With no --dump it runs pw-dump, and with no --default it asks wpctl for the default source.
// A pattern outside coax/lib/text/regex.coax's subset matches nothing, as an invalid one does in
// jq, and stderr says so.
#import "Basic";
#load "../coax/lib/sys/tool.coax";
#load "../coax/lib/sys/fs.coax";
#load "../coax/lib/sys/args.coax";
#load "../coax/lib/sys/proc.coax";
#load "../coax/lib/json/json.coax";
#load "../coax/lib/text/regex.coax";
#load "mic-pick.coax";

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 1 { tool_errln("usage: microphone pick [WANT] [--dump FILE] [--default ID] | match PATTERN TEXT"); return 2; }
  if args_at(a[..], 0) == "match" && args_count(a[..]) == 3 {
    // what jq's test() says of one name, for checking a host's pattern: true, false or refused
    m := rx_test(args_at(a[..], 1), args_at(a[..], 2));
    print("%\n", ifx m == RX_YES then "true" else ifx m == RX_NO then "false" else "refused");
    return ifx m == RX_REFUSED then 1 else 0;
  }
  if args_at(a[..], 0) != "pick" { tool_errln("usage: microphone pick [WANT] [--dump FILE] [--default ID] | match PATTERN TEXT"); return 2; }
  want := ifx args_count(a[..]) > 1 then args_at(a[..], 1) else "";
  dump: [4194304] u8; n := 0;
  file := args_value(a[..], "--dump", "");
  if file.count > 0 { n = fs_read(file, dump[..]); }
  else { n = mic_run("pw-dump", "", dump[..]); }
  db: [64] u8;
  def := args_value(a[..], "--default", "");
  if !args_has(a[..], "--default") {
    w: [65536] u8;
    m := mic_run("wpctl", "inspect", w[..]);
    def = mic_default(ifx m > 0 then cast(string) w[0..<m] else "", db[..]);
  }
  pb: [4096] u8;
  pattern := proc_getenv("CODEROS_MICROPHONE_NODE", pb[..]);
  nodes: [262144] JvNode; d: [1] Jv;
  ok := n > 0 && jv_parse(d[..], cast(string) dump[0..<n], nodes[..]);
  s: [MIC_MAX] Source;
  k := ifx ok then mic_sources(d[0], s[..]) else 0;
  ch := mic_pick(d[0], s[0..<k], want, pattern, def);
  if ch.refused { tool_errln("microphone: the pattern in CODEROS_MICROPHONE_NODE uses more than coax/lib/text/regex.coax's subset; it matches nothing"); }
  ob: [65536] u8; o: [1] Jo; jo_start(o[..], ob[..]);
  mic_json(d[0], s[0..<k], ch, o[..]);
  print("%\n", jo_text(o[..]));
  return 0;
}
