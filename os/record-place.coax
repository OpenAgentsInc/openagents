// CoderOS screen recording: the placement step (docs/os/2026-10-30-coderos-and-coax-audit.md, step
// 2 row 4). Reads the files screen-record writes and prints what its awk printed, so the Coax
// recorder and the shell can be compared take for take. The rules are os/record-policy.coax.
//   coax/web/tool.sh os/record-place.coax ratio CLOCK            the stretch (audio_clock_ratio)
//   coax/web/tool.sh os/record-place.coax outages PLACE VDUR [PROVEN]
//   coax/web/tool.sh os/record-place.coax shortfall PLACE VDUR [PROVEN]
//   coax/web/tool.sh os/record-place.coax end PLACE
//   coax/web/tool.sh os/record-place.coax note PLACE
//   coax/web/tool.sh os/record-place.coax delay OFFSET           adelay's samples
//   coax/web/tool.sh os/record-place.coax trend METER SOUND FPS  meter_lag_trend's line
//   coax/web/tool.sh os/record-place.coax level DB               sound_series' level for one RMS
//   coax/web/tool.sh os/record-place.coax crop HUD SW VW VH      hud_meter_crop's arithmetic
// CLOCK: `wall-microseconds<TAB>file-bytes` lines. PLACE: `offset<TAB>duration<TAB>path[<TAB>tempo]`
// lines (audio_segments' output). PROVEN: where the sound stopped for good; empty or left out
// when nothing saw it stop.
#import "Basic";
#load "../coax/lib/sys/tool.coax";
#load "../coax/lib/sys/fs.coax";
#load "../coax/lib/sys/args.coax";
#load "record-policy.coax";
#load "record-mux.coax";
#load "../coax/lib/json/json.coax";
#load "record-sync.coax";

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 2 { tool_errln("usage: record-place ratio|outages|shortfall|end|note|delay ARGS"); return 2; }
  verb := args_at(a[..], 0);
  b: [64] u8;
  if verb == "delay" { print("%", rec_delay(rec_num(args_at(a[..], 1)))); return 0; }
  if verb == "level" { print("%\n", sync_level(args_at(a[..], 1), b[..])); return 0; }
  if verb == "crop" {
    if args_count(a[..]) < 5 { return 2; }
    cb: [128] u8; c := sync_crop(args_at(a[..], 1), args_at(a[..], 2), rec_num(args_at(a[..], 3)), rec_num(args_at(a[..], 4)), cb[..]);
    print("%", c); return 0;
  }
  if verb == "trend" {
    if args_count(a[..]) < 4 { return 2; }
    m: [SYNC_TREND_MAX] f64; snd: [SYNC_TREND_MAX] f64; tb: [16777216] u8;
    nm := rp_series(args_at(a[..], 1), tb[..], m[..]); ns := rp_series(args_at(a[..], 2), tb[..], snd[..]);
    tr := sync_trend(m[0..<nm], snd[0..<ns], rec_num(args_at(a[..], 3)));
    fb: [64] u8; gb: [64] u8;
    if tr.verdict == SYNC_UNKNOWN { print("unknown\t\t\t%\t%\n", tr.used, tr.total); return 0; }
    print("%\t%\t%\t%\t%\n", ifx tr.verdict == SYNC_OK then "ok" else "drift", rec_fixed(tr.first, 3, fb[..]), rec_fixed(tr.final, 3, gb[..]), tr.used, tr.total);
    return 0;
  }
  text: [1048576] u8;
  n := fs_read(args_at(a[..], 1), text[..]);
  t := ifx n > 0 then cast(string) text[0..<n] else "";
  if verb == "ratio" {
    us: [RP_MAX] f64; by: [RP_MAX] f64; k := 0;
    f: [4] string;
    i := 0;
    while i < t.count && k < RP_MAX {
      j := i; while j < t.count && t[j] != '\n' { j += 1; }
      if rp_fields(t[i..<j], f[..]) >= 2 { us[k] = rec_num(f[0]); by[k] = rec_num(f[1]); k += 1; }
      i = j + 1;
    }
    r := rec_clock_ratio(us[0..<k], by[0..<k]);
    if r != 0.0 { print("%", rec_fixed(r, 6, b[..])); }
    return 0;
  }
  pieces: [RP_MAX] Piece; np := rp_place(t, pieces[..]);
  ps := pieces[0..<np];
  vdur := ifx args_count(a[..]) > 2 then rec_num(args_at(a[..], 2)) else 0.0;
  proven := args_count(a[..]) > 3 && args_at(a[..], 3).count > 0;
  out: [65536] u8;
  if verb == "outages" { print("%\n", rec_outages(ps, vdur, proven, out[..])); return 0; }
  if verb == "shortfall" { s := rec_shortfall(ps, vdur, proven); if s >= 0.0 { print("%", rec_fixed(s, 3, b[..])); } return 0; }
  if verb == "end" { print("%", rec_fixed(rec_end(ps), 6, b[..])); return 0; }
  if verb == "note" { print("%", rec_clock_note(ps, out[..])); return 0; }
  if verb == "mux" {
    // mux PLACE VDUR OUTPUT NOTE [SHIFT]: mux_recording's ffmpeg arguments, one a line
    if args_count(a[..]) < 5 { tool_errln("usage: record-place mux PLACE VDUR OUTPUT NOTE [SHIFT]"); return 2; }
    argv: [256] string; ab: [65536] u8;
    k := rp_mux(ps, args_at(a[..], 2), args_at(a[..], 3), args_at(a[..], 4), ifx args_count(a[..]) > 5 then args_at(a[..], 5) else "", t, argv[..], ab[..]);
    if k < 0 { return 1; }
    for i: 0..<k { print("%\n", argv[i]); }
    return 0;
  }
  tool_errln("record-place: no such step"); return 2;
}

// One number a line (awk's $1 + 0: the first field, 0 when it is not a number), into out: how many.
rp_series :: (path: string, text: [] u8, out: [] f64) -> int {
  n := fs_read(path, text); if n <= 0 { return 0; }
  k := 0; i := 0;
  while i < n && k < out.count {
    j := i; while j < n && text[j] != '\n' { j += 1; }
    a := i; while a < j && (text[a] == ' ' || text[a] == '\t') { a += 1; }
    e := a; while e < j && text[e] != ' ' && text[e] != '\t' { e += 1; }
    out[k] = ifx e > a then rec_num(cast(string) text[a..<e]) else 0.0; k += 1;
    i = j + 1;
  }
  return k;
}
