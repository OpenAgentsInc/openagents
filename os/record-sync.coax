// CoderOS screen recording: a finished take's sound checked against its picture by the HUD meter
// (screen-record's hud_meter_crop, sound_series' level, meter_lag_trend and sync_check, openagents
// 2ca255550e). The meter is the recording HUD's level strip, filmed with the screen; it draws a
// little after the sound it shows, by an amount that should hold steady over the take. A lag that
// changes by more than SYNC_FRAME_LIMIT frames from the start to the end is sound drifting
// against the picture. This is a report: the take is kept either way, and stop says it out loud.
// os/record-place.coax prints each piece (trend, level, crop) for comparison with the shell.

SYNC_WINDOW :: 20.0;        // seconds a window spans
SYNC_MAX_LAG :: 1.5;        // seconds of lag searched either way
SYNC_MIN_R :: 0.5;          // the correlation a window needs to count
SYNC_FRAME_LIMIT :: 2;      // frames of change the lag may make over the take
SYNC_TREND_MAX :: 1048576;  // frames read per series (9.7 hours at 30 fps)

Trend :: struct { verdict: int; first: f64; final: f64; used: int; total: int; }
SYNC_UNKNOWN :: 0; SYNC_OK :: 1; SYNC_DRIFT :: 2;

// Pearson's r between sound[i - d] and meter[i] over the window [s, s + w), -1 when either is flat.
sync_corr :: (sound: [] f64, meter: [] f64, s: int, w: int, d: int) -> f64 {
  sx := 0.0; sy := 0.0; sxx := 0.0; syy := 0.0; sxy := 0.0; m := 0.0;
  for i: s..<s + w {
    x := sound[i - d]; y := meter[i];
    sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; m += 1.0;
  }
  vx := sxx - sx * sx / m; vy := syy - sy * sy / m;
  if vx <= 0.000000000001 || vy <= 0.000000000001 { return -1.0; }
  return (sxy - sx * sy / m) / sqrt(vx * vy);
}

// How far the meter trails the sound at the take's start and end: each window's best shift within
// SYNC_MAX_LAG, refined between frames by a parabola through the peak, and a line through the
// windows that correlated. Unknown with fewer than three such windows.
sync_trend :: (meter: [] f64, sound: [] f64, fps: f64) -> Trend {
  n := ifx sound.count < meter.count then sound.count else meter.count;
  w := cast(int) (SYNC_WINDOW * fps); l := cast(int) (SYNC_MAX_LAG * fps);
  t: [4096] f64; g: [4096] f64; r: [4096] f64;
  used := 0; total := 0;
  if l > 2000 || w <= 0 { return Trend.{}; }
  s := l;
  while s + w + l <= n {
    total += 1;
    best := -2.0; bd := 0;
    for d: -l..<l + 1 {
      r[d + l] = sync_corr(sound, meter, s, w, d);
      if r[d + l] > best { best = r[d + l]; bd = d; }
    }
    if best >= SYNC_MIN_R && used < t.count {
      frac := 0.0;
      if bd > -l && bd < l {
        den := r[bd - 1 + l] - 2.0 * r[bd + l] + r[bd + 1 + l];
        if den < 0.0 { frac = 0.5 * (r[bd - 1 + l] - r[bd + 1 + l]) / den; }
      }
      t[used] = (cast(f64) s + cast(f64) w / 2.0) / fps;
      g[used] = (cast(f64) bd + frac) / fps;
      used += 1;
    }
    s += w;
  }
  if used < 3 { return Trend.{used = used, total = total}; }
  st := 0.0; sg := 0.0; stt := 0.0; stg := 0.0; u := cast(f64) used;
  for i: 0..<used { st += t[i]; sg += g[i]; stt += t[i] * t[i]; stg += t[i] * g[i]; }
  den := u * stt - st * st;
  slope := ifx den > 0.0 then (u * stg - st * sg) / den else 0.0;
  icpt := (sg - slope * st) / u;
  first := icpt; final := icpt + slope * (cast(f64) n / fps);
  change := final - first; if change < 0.0 { change = -change; }
  v := ifx change > cast(f64) SYNC_FRAME_LIMIT / fps then SYNC_DRIFT else SYNC_OK;
  return Trend.{verdict = v, first = first, final = final, used = used, total = total};
}
#test "a steady lag, a drifting one, and too little to say" {
  // 10 fps keeps the windows small enough for the test evaluator: 200 frames each, 15 either way
  m: [800] f64; snd: [800] f64;
  // a level that holds for four frames at a time, and a meter that draws it a frame late
  x := 7; v := 0.0;
  for i: 0..<800 { if i % 4 == 0 { x = (x * 1103515245 + 12345) % 2147483648; v = cast(f64) (x % 1000) / 1000.0; } snd[i] = v; }
  for i: 0..<800 { m[i] = ifx i >= 1 then snd[i - 1] * 100.0 else 0.0; }
  a := sync_trend(m[..], snd[..], 10.0);
  fb: [32] u8; gb: [32] u8;
  // the shell's awk printed "ok 0.100 0.100 3 3", "unknown 1 1", "drift -0.044 0.734 3 3", "unknown 0 3" for these
  #assert a.verdict == SYNC_OK && a.used == 3 && a.total == 3 && rec_fixed(a.first, 3, fb[..]) == "0.100" && rec_fixed(a.final, 3, gb[..]) == "0.100";
  c := sync_trend(m[0..<300], snd[0..<300], 10.0);
  #assert c.verdict == SYNC_UNKNOWN && c.used == 1 && c.total == 1;
  // the meter falls further behind as the take goes on: none at the start, 8 frames at the end
  for i: 0..<800 { k := i - i * 8 / 800; m[i] = snd[k] * 100.0; }
  b := sync_trend(m[..], snd[..], 10.0);
  #assert b.verdict == SYNC_DRIFT && b.used == 3 && rec_fixed(b.first, 3, fb[..]) == "-0.044" && rec_fixed(b.final, 3, gb[..]) == "0.734";
  for i: 0..<800 { m[i] = 5.0; }
  e := sync_trend(m[..], snd[..], 10.0);
  #assert e.verdict == SYNC_UNKNOWN && e.used == 0 && e.total == 3;
}

// An astats RMS level (dB, or "-inf") as the linear level sound_series printed: 0 at or below
// -120 dB, else 10^(dB/20) to eight places.
sync_level :: (db: string, out: [] u8) -> string {
  if db == "-inf" { return "0"; }
  v := rec_num(db);
  if v < -120.0 { return "0"; }
  return rec_fixed(pow(10.0, v / 20.0), 8, out);
}
#test "levels" {
  b: [64] u8;
  #assert sync_level("-inf", b[..]) == "0" && sync_level("-130.5", b[..]) == "0" && sync_level("0.000000", b[..]) == "1.00000000";
  #assert sync_level("-20.000000", b[..]) == "0.10000000" && sync_level("-120.000000", b[..]) == "0.00000100";
}

// The meter's crop in the picture, w:h:x:y, from the HUD window (coder-desk's list entry), the
// screen's width ("" when unknown) and the picture's size: the right end of the strip's middle
// row, scaled from the session's logical pixels to the picture's. "" when it falls outside.
sync_crop :: (hud: string, sw: string, vw: f64, vh: f64, out: [] u8) -> string {
  nodes: [512] JvNode; d: [1] Jv;
  if !jv_parse(d[..], hud, nodes[..]) { return ""; }
  k := 1.0;
  if sw.count > 0 {
    if !sync_number(sw) { return ""; }   // jq's tonumber fails, and the whole crop with it
    s := rec_num(sw); if s > 0.0 { k = vw / s; }
  }
  f: [4] f64; paths := [4] string.["at.x", "at.y", "size.width", "size.height"];
  for i: 0..<4 {
    at := jv_path(d[0], 0, paths[i]);
    if jv_kind(d[0], at) != JV_NUMBER { return ""; }
    f[i] = rec_num(jv_raw(d[0], at)) * k;
  }
  x := f[0]; y := f[1]; w := f[2]; h := f[3];
  cw := sync_max(floor(w * 0.015), 4.0); ch := sync_max(floor(h / 3.0), 4.0);
  cx := sync_max(floor(x + w - cw - 2.0), 0.0); cy := sync_max(floor(y + h / 3.0), 0.0);
  if cx + cw > vw || cy + ch > vh { return ""; }
  n := 0; vals := [4] f64.[cw, ch, cx, cy];
  for i: 0..<4 {
    if i > 0 { out[n] = ':'; n += 1; }
    ib: [32] u8; t := sync_int_text(cast(int) vals[i], ib[..]);
    for c: t { out[n] = c; n += 1; }
  }
  return cast(string) out[0..<n];
}
sync_max :: (a: f64, b: f64) -> f64 { return ifx a > b then a else b; }
// Whether jq's tonumber reads s: an optional sign, digits with at most one point, an exponent.
sync_number :: (s: string) -> bool {
  i := 0; digits := 0;
  if i < s.count && (s[i] == '-' || s[i] == '+') { i += 1; }
  while i < s.count && s[i] >= '0' && s[i] <= '9' { i += 1; digits += 1; }
  if i < s.count && s[i] == '.' { i += 1; while i < s.count && s[i] >= '0' && s[i] <= '9' { i += 1; digits += 1; } }
  if digits == 0 { return false; }
  if i < s.count && (s[i] == 'e' || s[i] == 'E') {
    i += 1; if i < s.count && (s[i] == '-' || s[i] == '+') { i += 1; }
    e := 0; while i < s.count && s[i] >= '0' && s[i] <= '9' { i += 1; e += 1; }
    if e == 0 { return false; }
  }
  return i == s.count;
}
sync_int_text :: (v: int, out: [] u8) -> string {
  if v == 0 { out[0] = '0'; return cast(string) out[0..<1]; }
  d: [24] u8; k := 0; x := ifx v < 0 then -v else v;
  while x > 0 { d[k] = cast,trunc(u8) ('0' + x % 10); x = x / 10; k += 1; }
  n := 0; if v < 0 { out[0] = '-'; n = 1; }
  for i: 0..<k { out[n + i] = d[k - 1 - i]; }
  return cast(string) out[0..<n + k];
}
#test "the meter's crop" {
  b: [64] u8;
  hud := "{\"title\":\"recording-hud\",\"at\":{\"x\":1200,\"y\":40},\"size\":{\"width\":400,\"height\":60}}";
  #assert sync_crop(hud, "", 1920.0, 1080.0, b[..]) == "6:20:1592:60";
  // a 2x picture of a 1280-wide session, and one where the scaled HUD falls outside it (jq: empty)
  left := "{\"at\":{\"x\":200,\"y\":40},\"size\":{\"width\":400,\"height\":60}}";
  #assert sync_crop(left, "1280", 2560.0, 1440.0, b[..]) == "12:40:1186:120" && sync_crop(hud, "1280", 2560.0, 1440.0, b[..]) == "";
  #assert sync_crop(hud, "1280", 1600.0, 1080.0, b[..]) == "";
  #assert sync_crop(hud, "wide", 1920.0, 1080.0, b[..]) == "" && sync_crop(hud, "0", 1920.0, 1080.0, b[..]) == "6:20:1592:60";
  #assert sync_crop("{\"at\":{\"x\":1},\"size\":{\"width\":4,\"height\":4}}", "", 99.0, 99.0, b[..]) == "";
  #assert sync_number("1280") && sync_number("-1.5e3") && sync_number(".5") && !sync_number("") && !sync_number("1e") && !sync_number("12px") && !sync_number(".");
}
