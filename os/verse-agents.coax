// Metaverse OS: the agents on this machine, for the Grid to show as figures (docs/os/2026-11-02-verse-os.md,
// V4). Every few seconds the session looks at where each agent writes its transcript — Claude Code
// (~/.claude/projects/PROJECT/SESSION.jsonl), Codex (~/.codex/sessions/YYYY/MM/DD/*.jsonl), Coder
// (~/.openagents/coder/sessions/*.jsonl) and Antigravity
// (~/.gemini/antigravity-cli/brain/ID/.system_generated/logs/transcript.jsonl) — and a transcript written in the last two minutes is an
// agent at work; in the last half hour, one waiting. It writes them, newest first, as
// `agent=KIND|PROJECT|STATE|MINUTES` lines, which vk-realm sends the Grid when they change
// (--agents; apps/openagents-web/newland-local.coax draws them). Only names and times: nothing of
// what a transcript says leaves its file. Loaded by os/verse-session.coax.

#load "../coax/lib/agent/observe/transcripts.coax";

cxproc_wall_us :: () -> int #foreign #effects(all);

VA_MAX :: 8;
VA_WORKING_S :: 120;    // written this recently: at work
VA_WAITING_S :: 1800;   // this recently: waiting for you
VA_WORKING :: 1; VA_WAITING :: 2;

VaAgent :: struct { kind: [16] u8; kind_n: int; project: [48] u8; project_n: int; age_s: int; path: [1024] u8; path_n: int; }
VaList :: struct { a: [VA_MAX] VaAgent; n: int; }

// A transcript's state by its age: working, waiting, or 0 (gone: not shown).
va_state :: (age_s: int) -> int {
  if age_s < 0 { return VA_WORKING; }   // a clock a little ahead of the file's: just written
  if age_s <= VA_WORKING_S { return VA_WORKING; }
  if age_s <= VA_WAITING_S { return VA_WAITING; }
  return 0;
}
#test "an agent's state by its transcript's age" {
  #assert va_state(0) == VA_WORKING && va_state(VA_WORKING_S) == VA_WORKING && va_state(VA_WORKING_S + 1) == VA_WAITING;
  #assert va_state(VA_WAITING_S) == VA_WAITING && va_state(VA_WAITING_S + 1) == 0 && va_state(-3) == VA_WORKING;
}
// Keeps the newest VA_MAX: an agent goes in by its age, the oldest falls out.
va_add :: (l: [] VaList, kind: string, project: string, age_s: int) { va_add_at(l, kind, project, age_s, ""); }
// The same, with the transcript's path (kept by the session; never sent to the realm).
va_add_at :: (l: [] VaList, kind: string, project: string, age_s: int, path: string) {
  if va_state(age_s) == 0 { return; }
  at := l[0].n;
  while at > 0 && l[0].a[at - 1].age_s > age_s { at -= 1; }
  if at >= VA_MAX { return; }
  last := ifx l[0].n < VA_MAX then l[0].n else VA_MAX - 1;
  i := last; while i > at { l[0].a[i] = l[0].a[i - 1]; i -= 1; }
  g: VaAgent;
  g.kind_n = 0; for c: kind { if g.kind_n < 16 { g.kind[g.kind_n] = c; g.kind_n += 1; } }
  g.project_n = 0; for c: project { if g.project_n < 48 && c != '|' && c != '\n' { g.project[g.project_n] = c; g.project_n += 1; } }
  g.age_s = age_s;
  g.path_n = 0; for c: path { if g.path_n < 1024 { g.path[g.path_n] = c; g.path_n += 1; } }
  l[0].a[at] = g;
  if l[0].n < VA_MAX { l[0].n += 1; }
}
#test "newest first, at most eight, the stale left out" {
  l: [1] VaList;
  va_add(l[..], "claude", "a", 50); va_add(l[..], "codex", "b", 10); va_add(l[..], "coder", "c", 100000); va_add(l[..], "claude", "d", 30);
  #assert l[0].n == 3 && l[0].a[0].age_s == 10 && l[0].a[1].age_s == 30 && l[0].a[2].age_s == 50;
  for k: 0..<10 { va_add(l[..], "claude", "x", 5); }
  #assert l[0].n == VA_MAX && l[0].a[0].age_s == 5 && l[0].a[VA_MAX - 1].age_s == 5;
  va_add(l[..], "claude", "late", 900);
  #assert l[0].a[VA_MAX - 1].age_s == 5;
}
va_put :: (out: [] u8, n: int, s: string) -> int { m := n; for c: s { if m < out.count { out[m] = c; m += 1; } } return m; }
// The lines for the Grid.
va_text :: (l: [] VaList, out: [] u8) -> int {
  n := 0;
  for k: 0..<l[0].n {
    g := l[0].a[k];
    n = va_put(out, n, "agent="); n = va_put(out, n, cast(string) g.kind[0..<g.kind_n]); n = va_put(out, n, "|");
    n = va_put(out, n, cast(string) g.project[0..<g.project_n]); n = va_put(out, n, "|");
    n = va_put(out, n, ifx va_state(g.age_s) == VA_WORKING then "working|" else "waiting|");
    nb: [24] u8; n = va_put(out, n, vs_num(ifx g.age_s > 0 then g.age_s / 60 else 0, nb[..])); n = va_put(out, n, "\n");
  }
  return n;
}
#test "the lines" {
  l: [1] VaList; va_add(l[..], "claude", "openagents", 30); va_add(l[..], "codex", "coder", 600);
  b: [512] u8; n := va_text(l[..], b[..]);
  #assert cast(string) b[0..<n] == "agent=claude|openagents|working|0\nagent=codex|coder|waiting|10\n";
}

// Every agent under home, now. Where the transcripts are is the shared walker's
// (coax/lib/agent/observe/transcripts.coax): Claude Code's sessions by project, Codex's by date,
// Coder's, Antigravity's conversations (kind antigravity, project antigravity).
va_scan :: (l: [] VaList, home: string) {
  l[0].n = 0;
  now_s := cxproc_wall_us() / 1000000;
  kinds := OB_KINDS;
  w: [1] ObWalk;
  w[0].claude = true; w[0].codex = true; w[0].coder = true; w[0].agy = true;
  ob_start(w[..], home);
  while ob_next(w[..]) {
    project := ifx w[0].kind == OB_CLAUDE then ob_project_of(ob_project(w[..])) else ob_project(w[..]);
    va_add_at(l, kinds[w[0].kind], project, now_s - w[0].mtime, ob_path(w[..]));
  }
}
