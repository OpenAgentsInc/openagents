// Verse OS: your desk as a panel over the Verse (docs/os/2026-11-02-verse-os.md, V3). Linux programs
// run on a headless Coax compositor (os/compositor.coax, its windows tiled by os/wm.coax) that the
// session's realm host starts (verse/gpu/vk-realm.c --desk); this decides how it is shown and who
// gets your input, and the host only does it:
//   - F9 opens the desk as a panel held in your view (the right part of the screen, the realm still
//     playing beside it), and closes it.
//   - F10 is flat mode: the desk fills the screen, the CoderOS desktop as it was. F10 again, or F9,
//     goes back to the Verse.
//   - F8 puts the desk in the world: on the screen the realm stands for it (the Grid's, a few metres
//     ahead), drawn where the realm says that screen is this frame, so it moves as you walk.
//     There the keyboard stays the realm's (you walk up to it); the pointer over it is the desk's.
//   - F7 is your voice: pressed, the session listens; pressed again, what you said is typed into the
//     desk's focused program (the agent you opened with T) and sent.
//   - While the desk shows docked or flat, the keyboard is the desk's (the toggles excepted); the
//     pointer is the desk's over the panel and the realm's elsewhere.
// Library: vk-realm.c calls these through the C the Coax compiler makes (verse-panel.h).

PANEL_CLOSED :: 0; PANEL_DOCKED :: 1; PANEL_FLAT :: 2; PANEL_WORLD :: 3;
PANEL_KEY_VOICE :: 65;   // evdev KEY_F7: talk to the desk's focused program (an agent), pressed again to send
PANEL_KEY_WORLD :: 66;   // evdev KEY_F8
PANEL_KEY_DOCK :: 67;    // evdev KEY_F9
PANEL_KEY_FLAT :: 68;    // evdev KEY_F10
PANEL_TO_REALM :: 0; PANEL_TO_DESK :: 1; PANEL_TOGGLE :: 2; PANEL_VOICE :: 3;
// the constants, for the host (a header carries procedures, not constants)
verse_panel_closed :: () -> int #export_c { return PANEL_CLOSED; }
verse_panel_flat :: () -> int #export_c { return PANEL_FLAT; }
verse_panel_world :: () -> int #export_c { return PANEL_WORLD; }
verse_panel_toggle :: () -> int #export_c { return PANEL_TOGGLE; }
verse_panel_to_desk :: () -> int #export_c { return PANEL_TO_DESK; }
verse_panel_voice :: () -> int #export_c { return PANEL_VOICE; }

// The mode after a key press (evdev code), and whether that key was a toggle.
verse_panel_next :: (mode: int, code: int) -> int #export_c {
  if code == PANEL_KEY_DOCK { return ifx mode == PANEL_CLOSED then PANEL_DOCKED else PANEL_CLOSED; }
  if code == PANEL_KEY_FLAT { return ifx mode == PANEL_FLAT then PANEL_CLOSED else PANEL_FLAT; }
  if code == PANEL_KEY_WORLD { return ifx mode == PANEL_WORLD then PANEL_CLOSED else PANEL_WORLD; }
  return mode;
}
// Where a key goes: the toggles are the panel's own, the rest the desk's while it shows.
verse_panel_key_to :: (mode: int, code: int) -> int #export_c {
  if code == PANEL_KEY_VOICE { return PANEL_VOICE; }   // in every mode: your voice to the desk
  if code == PANEL_KEY_DOCK || code == PANEL_KEY_FLAT || code == PANEL_KEY_WORLD { return PANEL_TOGGLE; }
  return ifx mode == PANEL_CLOSED || mode == PANEL_WORLD then PANEL_TO_REALM else PANEL_TO_DESK;
}
#test "F9 docks and closes, F10 flattens and comes back, other keys change nothing" {
  #assert verse_panel_next(PANEL_CLOSED, PANEL_KEY_DOCK) == PANEL_DOCKED && verse_panel_next(PANEL_DOCKED, PANEL_KEY_DOCK) == PANEL_CLOSED;
  #assert verse_panel_next(PANEL_FLAT, PANEL_KEY_DOCK) == PANEL_CLOSED;
  #assert verse_panel_next(PANEL_CLOSED, PANEL_KEY_FLAT) == PANEL_FLAT && verse_panel_next(PANEL_DOCKED, PANEL_KEY_FLAT) == PANEL_FLAT;
  #assert verse_panel_next(PANEL_FLAT, PANEL_KEY_FLAT) == PANEL_CLOSED;
  #assert verse_panel_next(PANEL_DOCKED, 30) == PANEL_DOCKED && verse_panel_next(PANEL_CLOSED, 1) == PANEL_CLOSED;
  #assert verse_panel_next(PANEL_CLOSED, PANEL_KEY_WORLD) == PANEL_WORLD && verse_panel_next(PANEL_WORLD, PANEL_KEY_WORLD) == PANEL_CLOSED;
  #assert verse_panel_next(PANEL_WORLD, PANEL_KEY_DOCK) == PANEL_CLOSED && verse_panel_next(PANEL_WORLD, PANEL_KEY_FLAT) == PANEL_FLAT;
}
#test "keys go to the desk while it shows" {
  #assert verse_panel_key_to(PANEL_CLOSED, 30) == PANEL_TO_REALM && verse_panel_key_to(PANEL_DOCKED, 30) == PANEL_TO_DESK;
  #assert verse_panel_key_to(PANEL_FLAT, 1) == PANEL_TO_DESK && verse_panel_key_to(PANEL_CLOSED, PANEL_KEY_DOCK) == PANEL_TOGGLE;
  #assert verse_panel_key_to(PANEL_FLAT, PANEL_KEY_FLAT) == PANEL_TOGGLE;
  #assert verse_panel_key_to(PANEL_WORLD, 17) == PANEL_TO_REALM && verse_panel_key_to(PANEL_WORLD, PANEL_KEY_WORLD) == PANEL_TOGGLE;
  #assert verse_panel_key_to(PANEL_CLOSED, PANEL_KEY_VOICE) == PANEL_VOICE && verse_panel_key_to(PANEL_FLAT, PANEL_KEY_VOICE) == PANEL_VOICE;
  #assert verse_panel_next(PANEL_DOCKED, PANEL_KEY_VOICE) == PANEL_DOCKED;
}

// The panel's rectangle on a W x H screen for a DW x DH desk, in whole pixels, as x0 y0 x1 y1 (k 0..3):
// flat, the desk fitted to the whole screen; docked, fitted to the right 62% with a 24-pixel margin.
// The desk's aspect is kept; the rest of its area is the realm's.
verse_panel_rect :: (mode: int, w: int, h: int, dw: int, dh: int, k: int) -> int #export_c {
  if mode == PANEL_WORLD { return 0; }   // the realm's to say: verse_panel_point_in
  if mode == PANEL_CLOSED || w < 1 || h < 1 || dw < 1 || dh < 1 || k < 0 || k > 3 { return 0; }
  m := ifx mode == PANEL_FLAT then 0 else 24;
  ax := ifx mode == PANEL_FLAT then 0 else w - (w * 62) / 100;
  aw := w - ax - m; ah := h - 2 * m;
  if aw < 1 || ah < 1 { return 0; }
  // fit dw x dh into aw x ah
  fw := aw; fh := (dh * aw) / dw;
  if fh > ah { fh = ah; fw = (dw * ah) / dh; }
  x0 := ax + (aw - fw) / 2; y0 := m + (ah - fh) / 2;
  r := [4] int.[x0, y0, x0 + fw, y0 + fh];
  return r[k];
}
#test "flat fills the screen at the desk's aspect; docked keeps the left of the screen for the realm" {
  #assert verse_panel_rect(PANEL_FLAT, 2560, 1440, 1280, 720, 0) == 0 && verse_panel_rect(PANEL_FLAT, 2560, 1440, 1280, 720, 2) == 2560;
  #assert verse_panel_rect(PANEL_FLAT, 2560, 1440, 1280, 720, 3) == 1440;
  #assert verse_panel_rect(PANEL_FLAT, 1600, 1600, 1280, 720, 1) == 350 && verse_panel_rect(PANEL_FLAT, 1600, 1600, 1280, 720, 3) == 1250;
  x0 := verse_panel_rect(PANEL_DOCKED, 2560, 1440, 1280, 720, 0); x1 := verse_panel_rect(PANEL_DOCKED, 2560, 1440, 1280, 720, 2);
  #assert x0 >= 2560 - (2560 * 62) / 100 && x1 <= 2560 - 24 && x1 - x0 > 1500;
  #assert verse_panel_rect(PANEL_CLOSED, 2560, 1440, 1280, 720, 2) == 0 && verse_panel_rect(PANEL_DOCKED, 0, 0, 1280, 720, 2) == 0;
  #assert verse_panel_rect(PANEL_DOCKED, 2560, 1440, 1280, 720, 4) == 0 && verse_panel_rect(PANEL_DOCKED, 30, 30, 1280, 720, 2) == 0;
}

// A screen point in the desk's pixels (k 0 x, 1 y), or -1 when it is not over the panel.
verse_panel_point :: (mode: int, w: int, h: int, dw: int, dh: int, x: int, y: int, k: int) -> int #export_c {
  x0 := verse_panel_rect(mode, w, h, dw, dh, 0); y0 := verse_panel_rect(mode, w, h, dw, dh, 1);
  x1 := verse_panel_rect(mode, w, h, dw, dh, 2); y1 := verse_panel_rect(mode, w, h, dw, dh, 3);
  if x1 <= x0 || y1 <= y0 || x < x0 || x >= x1 || y < y0 || y >= y1 { return -1; }
  return ifx k == 0 then ((x - x0) * dw) / (x1 - x0) else ((y - y0) * dh) / (y1 - y0);
}
// A screen point in the desk's pixels through the rectangle x0 y0 x1 y1 (k 0 x, 1 y), or -1 off it:
// the world's panel, wherever the realm draws it.
verse_panel_point_in :: (x0: int, y0: int, x1: int, y1: int, dw: int, dh: int, x: int, y: int, k: int) -> int #export_c {
  if x1 <= x0 || y1 <= y0 || dw < 1 || dh < 1 || x < x0 || x >= x1 || y < y0 || y >= y1 { return -1; }
  return ifx k == 0 then ((x - x0) * dw) / (x1 - x0) else ((y - y0) * dh) / (y1 - y0);
}
#test "the world's panel: a point through the realm's rectangle" {
  #assert verse_panel_point_in(100, 100, 740, 460, 1280, 720, 420, 280, 0) == 640 && verse_panel_point_in(100, 100, 740, 460, 1280, 720, 420, 280, 1) == 360;
  #assert verse_panel_point_in(100, 100, 740, 460, 1280, 720, 99, 280, 0) == -1 && verse_panel_point_in(100, 100, 100, 460, 1280, 720, 100, 280, 0) == -1;
  #assert verse_panel_rect(PANEL_WORLD, 2560, 1440, 1280, 720, 2) == 0;
}
#test "a point over the panel lands on the desk, one off it is the realm's" {
  #assert verse_panel_point(PANEL_FLAT, 2560, 1440, 1280, 720, 1280, 720, 0) == 640 && verse_panel_point(PANEL_FLAT, 2560, 1440, 1280, 720, 1280, 720, 1) == 360;
  #assert verse_panel_point(PANEL_FLAT, 2560, 1440, 1280, 720, 0, 0, 0) == 0 && verse_panel_point(PANEL_FLAT, 2560, 1440, 1280, 720, 2559, 1439, 0) == 1279;
  #assert verse_panel_point(PANEL_DOCKED, 2560, 1440, 1280, 720, 10, 700, 0) == -1;
  #assert verse_panel_point(PANEL_CLOSED, 2560, 1440, 1280, 720, 1280, 720, 0) == -1;
}

// ---- perspective: the desk on the world's screen as it slants (F8)
// The screen's corners on the display, in whole pixels: c[0..8] = bottom-left x y, bottom-right x y,
// top-right x y, top-left x y. The desk is drawn as N vertical strips, strip i of n covering this
// (k 0..3: x0 y0 x1 y1) of the display, its source the desk's columns i/n to (i+1)/n: each fitted
// between the screen's top and bottom edges where it stands, so the far side is shorter.
panel_lerp :: (a: int, b: int, t_num: int, t_den: int) -> int { return a + ((b - a) * t_num) / t_den; }
verse_panel_strip :: (blx: int, bly: int, brx: int, bry: int, trx: int, tyr: int, tlx: int, tly: int, i: int, n: int, k: int) -> int #export_c {
  if n < 1 || i < 0 || i >= n || k < 0 || k > 3 { return 0; }
  // the top and bottom edges at the strip's two sides
  tx0 := panel_lerp(tlx, trx, i, n); ty0 := panel_lerp(tly, tyr, i, n); tx1 := panel_lerp(tlx, trx, i + 1, n); ty1 := panel_lerp(tly, tyr, i + 1, n);
  bx0 := panel_lerp(blx, brx, i, n); by0 := panel_lerp(bly, bry, i, n); bx1 := panel_lerp(blx, brx, i + 1, n); by1 := panel_lerp(bly, bry, i + 1, n);
  if k == 0 { return (tx0 + bx0) / 2; }
  if k == 2 { return (tx1 + bx1) / 2; }
  if k == 1 { return (ty0 + ty1) / 2; }
  return (by0 + by1) / 2;
}
#test "strips: a square on, then a screen seen from its left" {
  // square on: 0,100 .. 400,100 .. 400,0 .. 0,0 (y down: top is 0); strip 0 of 4 is x 0..100, y 0..100
  #assert verse_panel_strip(0, 100, 400, 100, 400, 0, 0, 0, 0, 4, 0) == 0 && verse_panel_strip(0, 100, 400, 100, 400, 0, 0, 0, 0, 4, 2) == 100;
  #assert verse_panel_strip(0, 100, 400, 100, 400, 0, 0, 0, 0, 4, 1) == 0 && verse_panel_strip(0, 100, 400, 100, 400, 0, 0, 0, 0, 4, 3) == 100;
  // the right side further away: shorter (y 20..80); the last strip is shorter than the first
  h0 := verse_panel_strip(0, 100, 400, 80, 400, 20, 0, 0, 0, 4, 3) - verse_panel_strip(0, 100, 400, 80, 400, 20, 0, 0, 0, 4, 1);
  h3 := verse_panel_strip(0, 100, 400, 80, 400, 20, 0, 0, 3, 4, 3) - verse_panel_strip(0, 100, 400, 80, 400, 20, 0, 0, 3, 4, 1);
  #assert h0 > h3 && h3 > 60 - 1;
  #assert verse_panel_strip(0, 100, 400, 100, 400, 0, 0, 0, 4, 4, 0) == 0 && verse_panel_strip(0, 100, 400, 100, 400, 0, 0, 0, 0, 0, 0) == 0;
}
// A display point on the slanted screen in the desk's pixels (k 0 x, 1 y), or -1 off it: the strip it
// falls in gives x, its place between that strip's top and bottom gives y.
verse_panel_point_quad :: (blx: int, bly: int, brx: int, bry: int, trx: int, tyr: int, tlx: int, tly: int, n: int, dw: int, dh: int, x: int, y: int, k: int) -> int #export_c {
  if n < 1 || dw < 1 || dh < 1 { return -1; }
  for i: 0..<n {
    x0 := verse_panel_strip(blx, bly, brx, bry, trx, tyr, tlx, tly, i, n, 0); x1 := verse_panel_strip(blx, bly, brx, bry, trx, tyr, tlx, tly, i, n, 2);
    if x1 <= x0 || x < x0 || x >= x1 { continue; }
    y0 := verse_panel_strip(blx, bly, brx, bry, trx, tyr, tlx, tly, i, n, 1); y1 := verse_panel_strip(blx, bly, brx, bry, trx, tyr, tlx, tly, i, n, 3);
    if y1 <= y0 || y < y0 || y >= y1 { return -1; }
    if k == 0 { return (i * dw) / n + ((x - x0) * dw) / (n * (x1 - x0)); }
    return ((y - y0) * dh) / (y1 - y0);
  }
  return -1;
}
#test "a point on the slanted screen" {
  #assert verse_panel_point_quad(0, 100, 400, 100, 400, 0, 0, 0, 4, 1280, 720, 200, 50, 0) == 640;
  #assert verse_panel_point_quad(0, 100, 400, 100, 400, 0, 0, 0, 4, 1280, 720, 200, 50, 1) == 360;
  #assert verse_panel_point_quad(0, 100, 400, 100, 400, 0, 0, 0, 4, 1280, 720, 500, 50, 0) == -1 && verse_panel_point_quad(0, 100, 400, 100, 400, 0, 0, 0, 4, 1280, 720, 200, 150, 0) == -1;
  #assert verse_panel_point_quad(0, 100, 400, 80, 400, 20, 0, 0, 4, 1280, 720, 390, 10, 1) == -1;   // above the far, shorter side
}
