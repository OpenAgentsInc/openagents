{
  "name": "openagents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:vp2-node-runtime": "node scripts/vp2-node-runtime-guard.mjs",
    "build:coder-surfaces": "node scripts/coder-surfaces.mjs --write",
    "check:coder-surfaces": "node scripts/coder-surfaces.mjs",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run check:fast && pnpm run typecheck && pnpm run test:rust && pnpm run test",
    "check:fast": "vp lint --quiet && pnpm run check:all-work-contract && pnpm run check:agent-client-protocol && pnpm run check:agent-client-protocol-conformance && pnpm run check:codex-app-server-protocol && pnpm run check:ste:public && pnpm run check:ste-public-semantics && node scripts/vp1-retired-money-surface-guard.mjs . && node scripts/zero-supported-bun-guard.mjs . && node scripts/dse-single-authority-guard.mjs . && node scripts/google-cloud-authority-guard.mjs && node scripts/sarah-participant-join-authority-guard.mjs . && node scripts/uncalled-production-symbol-guard.mjs . && node scripts/cli-invocability-guard.mjs . && pnpm run check:coder-surfaces && pnpm run check:documented-route-mounts && pnpm run check:assure-repo && pnpm run check:assure-repo-audit && pnpm run check:assure-repo-drift",
    "check:afs-boundaries": "node --import tsx scripts/check-afs-boundaries.ts",
    "check:afs-apple-fm-version-drift": "node --import tsx scripts/check-afs-apple-fm-version-drift.ts",
    "check:google-cloud-authority": "node scripts/google-cloud-authority-guard.mjs",
    "check:zero-supported-bun": "node scripts/zero-supported-bun-guard.mjs .",
    "test": "vp test --run; vp_status=$?; pnpm run test:node-suites; node_status=$?; exit $((vp_status | node_status))",
    "test:node-suites": "node scripts/node-test-suites.mjs",
    "test:rust": "cargo test --workspace",
    "test:retired-clients": "vp test --run scripts/retired-clients-removal.test.ts",
    "test:github-issue-triage": "vp test --run scripts/github-issue-triage.test.ts",
    "test:khala-sync-runtime-dogfood-evidence": "vp test --run scripts/validate-khala-sync-runtime-dogfood-evidence.test.ts",
    "test:ui-velocity-receipt": "vp test --run scripts/ui-velocity-receipt.test.ts",
    "test:node-vp-inventory": "node --test scripts/node-vp-cutover-inventory.test.mjs",
    "test:sol-docs": "vp test --run scripts/check-sol-docs.test.ts",
    "test:ste": "vp test --run scripts/check-ste.test.ts",
    "test:coherence": "vp test --run scripts/grade-conversation-coherence.test.ts",
    "grade:coherence": "node --import tsx scripts/grade-conversation-coherence.ts",
    "headless:harness": "node --import tsx scripts/run-headless-harness.ts",
    "test:headless-harness": "vp test --run scripts/headless-harness.test.ts",
    "test:authority-delegation": "vp test --run scripts/check-authority-delegation.test.ts",
    "changelog": "node --import tsx scripts/changelog.ts",
    "release:impact": "node --import tsx scripts/release-impact.ts",
    "perf:ui-velocity": "node --import tsx scripts/ui-velocity-receipt.ts",
    "verify:tla": "specs/run-tlc.sh",
    "triage:issues": "node --import tsx scripts/github-issue-triage.ts",
    "scan:effect-authority-boundaries": "node --import tsx scripts/effect-authority-boundary-scan.ts",
    "generate:sol-doc-manifest": "node --import tsx scripts/generate-sol-doc-manifest.ts",
    "check:sol-doc-manifest": "node --import tsx scripts/generate-sol-doc-manifest.ts --check",
    "check:sol-docs": "node --import tsx scripts/check-sol-docs.ts",
    "generate:ste-ledger": "node --import tsx scripts/generate-ste-ledger.ts",
    "generate:ste-final-inventory": "node --import tsx scripts/generate-ste-final-inventory.ts",
    "rewrite:ste-semicolons": "node --import tsx scripts/rewrite-ste-structure.ts --write",
    "generate:ste-baseline": "node --import tsx scripts/generate-ste-ledger.ts --refresh-baseline",
    "check:ste-ledger": "node --import tsx scripts/generate-ste-ledger.ts --check",
    "check:ste": "pnpm run check:ste-ledger && node --import tsx scripts/check-ste.ts",
    "check:ste:public": "pnpm run check:ste-ledger && node --import tsx scripts/check-ste.ts --all",
    "check:ste:all": "pnpm run check:ste:public",
    "check:ste:strict": "node --import tsx scripts/check-ste.ts --strict",
    "capture:ste-public-semantics": "node --import tsx scripts/check-ste-semantic.ts --capture",
    "check:ste-public-semantics": "node --import tsx scripts/check-ste-semantic.ts",
    "capture:ste-control-semantics": "pnpm run capture:ste-public-semantics",
    "check:ste-control-semantics": "pnpm run check:ste-public-semantics",
    "check:node-vp-freeze": "node scripts/node-vp-cutover-inventory.mjs --check",
    "check:vp1-retirement": "node scripts/vp1-retired-money-surface-guard.mjs .",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "prepare": "effect-language-service patch && vp config --no-agent --no-hooks && bash scripts/enable-git-hooks.sh",
    "build": "vp run --concurrency-limit 1 -r build",
    "pack": "node --max-old-space-size=8192 scripts/build-public-cli-artifacts.mjs",
    "effectiveness:suites": "node bench/build-suites.mjs"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@openagentsinc/nip90": "workspace:*",
    "@openagentsinc/release-contract": "workspace:*",
    "@openagentsinc/runtime-platform": "workspace:*",
    "@oxlint/plugins": "1.68.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "catalog:",
    "@types/openagents-platform": "workspace:*",
    "@types/vite-plus-matchers": "workspace:*",
    "effect": "catalog:",
    "playwright": "^1.61.0",
    "tsx": "4.20.6",
    "typescript": "catalog:",
    "vite-plus": "0.2.4"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0",
  "trustedDependencies": [
    "electron",
    "@shopify/react-native-skia"
  ]
}
