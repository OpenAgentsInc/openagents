  "semanticChecks": [
    "issue_projection_work_ref_matches_snapshot_work_ref",
    "relations_do_not_mutate_endpoints",
    "assignee_and_agent_delegate_remain_distinct",
    "source_authority_revision_and_cursor_are_monotonic_per_source",
    "receipt_verification_and_owner_disposition_do_not_imply_each_other",
    "signed_workroom_event_proves_signer_and_bytes_only",
    "signed_workroom_preparation_owns_canonical_unsigned_bytes_and_relay_policy",
    "signed_workroom_commit_accepts_only_the_exact_prepared_signed_event",
    "relay_acceptance_is_transport_evidence_only",
    "workroom_audience_and_privacy_are_closed_allowlist_compatible",
    "work_command_effective_principal_and_organization_are_explicit",
    "delegation_does_not_copy_assignee_or_owner_authority",
    "revocation_fences_new_session_effects_by_generation",
    "agent_activity_preserves_provider_event_and_loss_refs",
    "work_snapshot_execution_projections_preserve_identity_generation_and_lifecycle",
    "owner_disposition_is_separate_from_completion_and_verification",
    "internal_work_has_exactly_one_writer_per_cutover_generation",
    "native_work_cutover_creates_zero_github_writes",
    "legacy_rollback_requires_complete_native_history_reconciliation",
    "organization_membership_is_explicit_and_not_inferred_from_planning_or_authorization",
    "organization_membership_reads_are_account_principal_and_generation_fenced",
    "strict_bug_ingress_is_untrusted_until_explicit_disposition",
    "strict_bug_ingress_is_delivery_idempotent_and_public_safe",
    "strict_bug_candidate_admission_does_not_grant_command_authority"
  ],
