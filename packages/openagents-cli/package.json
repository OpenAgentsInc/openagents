{
  "name": "@openagentsinc/cli",
  "version": "0.4.0",
  "private": false,
  "description": "Effect TypeScript command-line client for OpenAgents repositories",
  "keywords": [
    "cli",
    "git",
    "github",
    "import",
    "openagents",
    "repository"
  ],
  "homepage": "https://github.com/OpenAgentsInc/openagents/tree/main/packages/openagents-cli#readme",
  "bugs": {
    "url": "https://github.com/OpenAgentsInc/openagents/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAgentsInc/openagents.git",
    "directory": "packages/openagents-cli"
  },
  "bin": {
    "openagents": "dist/main.js"
  },
  "files": [
    "dist",
    "contracts",
    "README.md",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fmt": "vp fmt .",
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint .",
    "prepack": "pnpm run build",
    "test": "vp test --run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "verify:package": "node scripts/verify-packed-install.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "4.0.0-beta.94",
    "effect": "catalog:",
    "ollama": "^0.6.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "typescript": "catalog:",
    "vite-plus": "0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
