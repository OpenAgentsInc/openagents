{
  "name": "@openagentsinc/release-contract",
  "version": "0.1.0",
  "private": false,
  "description": "Ed25519 release-signing, update-manifest, ReleaseSet, and portable-evidence contracts shared by the release, update-feed, and download surfaces.",
  "files": [
    "src",
    "fixtures"
  ],
  "type": "module",
  "exports": {
    "./update-contract": "./src/update-contract.ts",
    "./release-publish": "./src/release-publish.ts",
    "./release-set-contract": "./src/release-set-contract.ts",
    "./release-staging-contract": "./src/release-staging-contract.ts",
    "./ide/portable-evidence-contract": "./src/ide/portable-evidence-contract.ts",
    "./fixtures/release-set-v1.json": "./fixtures/release-set-v1.json",
    "./fixtures/release-set-v2.json": "./fixtures/release-set-v2.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test --root ../.. --run packages/release-contract/src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
