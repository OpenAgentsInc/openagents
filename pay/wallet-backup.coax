// The wallet's backup card and daily limit as the app decides them (docs/auth/wallets-and-custody.md,
// decision D4; #13217). Swift does the effects (the network, the Keychain, the passkey prompt) and
// hands this file plain values; this file decides. The sealing and opening are
// pay/wallet-vault.coax's and coax/lib/nostr/vault-wallet.coax's.
//
//   metaverse_backup_card   what the wallet screen's backup card shows
//   metaverse_backup_newer  whether an epoch raises the highest this phone has made or opened (the rollback floor)
//   metaverse_limit_local   a payment against the limit this phone last knew, by its own count,
//                       for when our server can't be asked; nothing while logged out
//   metaverse_limit_next    what the app does with the server's answer to "may I pay?"
//
// Our server answers whether a payment needs a fresh proof that it is you; it can't stop one,
// so the app is what keeps the limit. A changed app, or the wallet's words used somewhere else,
// isn't held by it.
//   coax/bin/coax test pay/wallet-backup.coax
//   coax/bin/coax mutate pay/wallet-backup.coax
#authority;

// What the backup card shows.
VB_HIDDEN :: 0;        // nothing to say yet: an empty wallet with no backup, or "Not now"
VB_OFFER :: 1;         // the wallet holds money and has no backup: Back up
VB_OFFER_LOGIN :: 2;   // the same, logged out: Log in to back it up
VB_BACKED_UP :: 3;
VB_NOT_THIS :: 4;      // the account has a backup this phone didn't make or restore: Back up this wallet
VB_BROKEN :: 5;        // the backup's passkey left the account (only the recovery code opens it now): Back up again
// What the app does about a payment.
VL_PAY :: 0; VL_STEP_UP :: 1; VL_OVER :: 2; VL_REFUSED :: 3; VL_LOG_IN :: 4;
VL_MAX_SAT :: 2_100_000_000_000_000;

#forall "the backup card" balance: 0..<3, logged_in: bool, backup: bool, counts: bool, mine: bool, later: bool {
  c := metaverse_backup_card(balance, logged_in, backup, counts, mine, later);
  if !logged_in { #assert c == (ifx balance > 0 && !later then VB_OFFER_LOGIN else VB_HIDDEN); }
  else if backup && !counts { #assert c == VB_BROKEN; }
  else if backup && !mine { #assert c == VB_NOT_THIS; }
  else if backup { #assert c == VB_BACKED_UP; }
  else { #assert c == (ifx balance > 0 && !later then VB_OFFER else VB_HIDDEN); }
}
#test "the offer comes the moment the wallet first holds money: one sat is enough, none isn't" {
  #assert metaverse_backup_card(0, true, false, false, false, false) == VB_HIDDEN && metaverse_backup_card(1, true, false, false, false, false) == VB_OFFER;
  #assert metaverse_backup_card(-1, true, false, false, false, false) == VB_HIDDEN && metaverse_backup_card(5000, false, false, false, false, false) == VB_OFFER_LOGIN;
  // a backup that no longer works, or isn't this phone's, is said whatever the balance and never hidden by "Not now"
  #assert metaverse_backup_card(0, true, true, false, true, true) == VB_BROKEN && metaverse_backup_card(0, true, true, true, false, true) == VB_NOT_THIS;
}
#test "the rollback floor only goes up" {
  #assert metaverse_backup_newer(0, 1) && !metaverse_backup_newer(3, 2) && !metaverse_backup_newer(3, 3) && metaverse_backup_newer(3, 4) && metaverse_backup_newer(-5, 0);
}
#forall "the limit this phone last knew, by its own count" amount: 0..<6, spent: 0..<5, limit: -1..<5, logged_in: bool {
  v := metaverse_limit_local(amount, spent, limit, logged_in);
  if amount == 0 { #assert v == VL_REFUSED; }
  else if limit < 0 { #assert v == VL_PAY; }                 // this phone never had an account's limit
  else if !logged_in { #assert v == VL_LOG_IN; }             // it had one, and the login is gone: nothing pays
  else if spent + amount <= limit { #assert v == VL_PAY; }
  else { #assert v == VL_OVER; }
}
#test "the local count at the edges" {
  #assert metaverse_limit_local(20000, 0, 20000, true) == VL_PAY && metaverse_limit_local(20001, 0, 20000, true) == VL_OVER && metaverse_limit_local(1, 20000, 20000, true) == VL_OVER;
  #assert metaverse_limit_local(VL_MAX_SAT, 0, VL_MAX_SAT, true) == VL_PAY && metaverse_limit_local(VL_MAX_SAT + 1, 0, -1, true) == VL_REFUSED && metaverse_limit_local(-1, 0, -1, true) == VL_REFUSED;
  #assert metaverse_limit_local(1, -1, 5, true) == VL_REFUSED && metaverse_limit_local(1, 0, 0, true) == VL_OVER;
  // a stolen phone whose account was frozen (every login ended): not one sat, though the limit had room
  #assert metaverse_limit_local(1, 0, 20000, false) == VL_LOG_IN && metaverse_limit_local(1, 0, 0, false) == VL_LOG_IN && metaverse_limit_local(1, 0, -1, false) == VL_PAY;
}
#forall "what the app does with the server's answer" status: 0..<7, stepped: bool, can: bool, local: 0..<5 {
  s := [7] int.[0, 200, 401, 409, 400, 500, 429];
  v := metaverse_limit_next(s[status], status == 2, stepped, can, local);
  if status == 1 { #assert v == VL_PAY; }                                // the server said go
  else if status == 2 { #assert v == (ifx can && !stepped then VL_STEP_UP else VL_OVER); }   // prove it is you, once
  else if status == 3 || status == 4 { #assert v == VL_REFUSED; }        // the server refused this payment
  else { #assert v == local; }                                           // it couldn't be asked: this phone's own count
}
#test "a 401 that isn't a step-up (logged out, a login that ended) falls back to this phone's own count" {
  #assert metaverse_limit_next(401, false, false, true, VL_PAY) == VL_PAY && metaverse_limit_next(401, false, false, true, VL_OVER) == VL_OVER;
  #assert metaverse_limit_next(401, true, false, true, VL_PAY) == VL_STEP_UP && metaverse_limit_next(401, true, true, true, VL_PAY) == VL_OVER;
  #assert metaverse_limit_next(403, false, false, true, VL_PAY) == VL_REFUSED && metaverse_limit_next(503, false, false, true, VL_OVER) == VL_OVER;
  #assert metaverse_limit_next(299, false, false, true, VL_OVER) == VL_PAY && metaverse_limit_next(199, false, false, true, VL_OVER) == VL_OVER;
  #assert metaverse_limit_next(300, false, false, true, VL_OVER) == VL_OVER && metaverse_limit_next(399, false, false, true, VL_OVER) == VL_OVER;
  #assert metaverse_limit_next(499, false, false, true, VL_PAY) == VL_REFUSED && metaverse_limit_next(400, false, false, true, VL_PAY) == VL_REFUSED;
}
// balance: the wallet's sats. backup: the account has a backup. counts: one of its passkeys is
// still on the account. mine: its vault is the one this phone made or restored from. later: the
// person pressed Not now since the app started.
metaverse_backup_card :: (balance: int, logged_in: bool, backup: bool, counts: bool, mine: bool, later: bool) -> int #export_c #effects(all) {
  if logged_in && backup {
    if !counts { return VB_BROKEN; }
    if !mine { return VB_NOT_THIS; }
    return VB_BACKED_UP;
  }
  if balance <= 0 || later { return VB_HIDDEN; }
  if !logged_in { return VB_OFFER_LOGIN; }
  return VB_OFFER;
}
// Whether epoch is past the highest this phone has made or opened: then it is the new floor.
metaverse_backup_newer :: (seen: int, epoch: int) -> bool #export_c #effects(all) {
  return epoch > seen;
}

// amount: the sats about to leave. spent: sats this phone paid in the last 24 hours. limit: the
// daily limit this phone last heard from its account (-1: it never heard one). logged_in: the
// app has a login the server still takes. A phone that has heard a limit pays nothing while it
// is logged out: freezing an account ends every login, and that is what stops a stolen phone.
metaverse_limit_local :: (amount: int, spent: int, limit: int, logged_in: bool) -> int #export_c #effects(all) {
  if amount <= 0 || amount > VL_MAX_SAT || spent < 0 { return VL_REFUSED; }
  if limit < 0 { return VL_PAY; }
  if !logged_in { return VL_LOG_IN; }
  if amount > limit - spent { return VL_OVER; }
  return VL_PAY;
}
// status: the HTTP status of POST /api/wallet/spend (0: no answer). step_up: its refusal asked for
// a fresh proof. stepped: the app already proved it for this payment. can: this phone has a way to
// prove it (a passkey, or its key on the account). local: metaverse_limit_local's answer.
metaverse_limit_next :: (status: int, step_up: bool, stepped: bool, can: bool, local: int) -> int #export_c #effects(all) {
  if status >= 200 && status < 300 { return VL_PAY; }
  if status == 401 && step_up {
    if can && !stepped { return VL_STEP_UP; }
    return VL_OVER;
  }
  if status >= 400 && status < 500 && status != 401 && status != 429 { return VL_REFUSED; }
  return local;
}
