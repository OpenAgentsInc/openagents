#load "wallet-balance-wire.coax";
#load "../coax/lib/sys/fs.coax";
tool_main :: ()->int #export_c #effects(all) {
  raw:[256]u8;out:[256]u8;n:=fs_read("proto/coax-native/wallet-balance-v1.json",raw[..]);if n<1 {return 1;}
  if raw[n-1]=='\n' {n-=1;}b:=wb_decode(cast(string)raw[0..<n]);
  if b.status!=1 || b.sats<0 {return 1;}k:=wb_encode(b.status,cast(u64)b.sats,out[..]);
  if k!=n || cast(string)raw[0..<n]!=cast(string)out[0..<k] {return 1;}return 0;
}
