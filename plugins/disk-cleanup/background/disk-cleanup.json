{
  "schema": "openagents.background.rule.v1",
  "id": "disk-cleanup",
  "name": "Disk cleanup",
  "version": 1,
  "origin": {
    "kind": "file",
    "path": "background/disk-cleanup.json"
  },
  "enabled": false,
  "triggers": [
    {
      "kind": "interval",
      "every_secs": 300
    },
    {
      "kind": "threshold"
    },
    {
      "kind": "task_ended"
    },
    {
      "kind": "host_start"
    }
  ],
  "goal": {
    "start": {
      "bytes": 200000000000,
      "percent": 15
    },
    "stop": {
      "bytes": 300000000000,
      "percent": 20
    },
    "emergency": {
      "bytes": 10000000000,
      "percent": 1
    },
    "max_freed": 100000000000,
    "pressure_secs": 60
  },
  "actions": [
    {
      "kind": "delete_caches",
      "classes": [
        "ended_targets",
        "stale_targets"
      ]
    },
    {
      "kind": "prune_worktrees"
    },
    {
      "kind": "delete_caches",
      "classes": [
        "claude_worktrees"
      ]
    },
    {
      "kind": "delete_caches",
      "classes": [
        "gate_pools",
        "kache"
      ]
    },
    {
      "kind": "cargo_clean_partial"
    },
    {
      "kind": "empty_trash"
    }
  ],
  "classes": {
    "agent_targets": [
      "~/work/openagents-target-agent*"
    ],
    "checkouts": [
      "~/work/*"
    ],
    "idle_days": 3,
    "agent_idle_hours": 6,
    "checkout_days": 7,
    "keep": 0,
    "orphan_worktree_days": 7,
    "gate_idle_hours": 1,
    "claude_checkouts": [
      "~/code/*",
      "~/work/*"
    ],
    "claude_worktree_hours": 2
  },
  "safety": {
    "allow": [
      "~/.openagents/targets",
      "~/.openagents/coder-one/target",
      "~/.openagents/worktrees",
      "~/.openagents/gate",
      "~/.openagents/background/trash",
      "~/work",
      "~/code"
    ],
    "deny": [],
    "report": [
      "~/.openagents/pylon",
      "~/Library/Caches",
      "/private/var/folders"
    ]
  },
  "cooldown_secs": 600,
  "needs": {
    "delete": [
      "ended_targets",
      "stale_targets",
      "worktrees",
      "gate_pools",
      "incremental",
      "trash",
      "claude_worktrees",
      "kache"
    ],
    "tasks": true,
    "notify": true
  },
  "paused_until": 18446744073709551615
}
