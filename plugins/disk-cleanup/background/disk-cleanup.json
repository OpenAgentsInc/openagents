{
  "schema": "openagents.background.rule.v1",
  "id": "disk-cleanup",
  "name": "Disk cleanup",
  "version": 1,
  "origin": {
    "kind": "file",
    "path": "background/disk-cleanup.json"
  },
  "enabled": false,
  "triggers": [],
  "goal": {
    "start": {
      "bytes": 200000000000,
      "percent": 15
    },
    "stop": {
      "bytes": 300000000000,
      "percent": 20
    },
    "emergency": {
      "bytes": 10000000000,
      "percent": 1
    },
    "max_freed": 100000000000,
    "pressure_secs": 60
  },
  "actions": [],
  "classes": {
    "agent_targets": [
      "~/work/openagents-target-agent*"
    ],
    "checkouts": [
      "~/work/*"
    ],
    "idle_days": 3,
    "agent_idle_hours": 6,
    "checkout_days": 7,
    "keep": 0,
    "orphan_worktree_days": 7,
    "gate_idle_hours": 1,
    "claude_checkouts": [
      "~/code/*",
      "~/work/*"
    ],
    "claude_worktree_hours": 2,
    "scratch_days": 7
  },
  "safety": {
    "allow": [
      "~/.openagents/targets",
      "~/.openagents/coder-one/target",
      "~/.openagents/worktrees",
      "~/.openagents/gate",
      "~/.openagents/background/trash",
      "~/.openagents/scratch",
      "~/work",
      "~/code"
    ],
    "deny": [],
    "report": [
      "~/.openagents/pylon",
      "~/Library/Caches",
      "/private/var/folders"
    ]
  },
  "cooldown_secs": 600,
  "needs": {
    "delete": [],
    "tasks": true,
    "notify": false
  },
  "paused_until": 18446744073709551615
}
