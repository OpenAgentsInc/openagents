  "binding": {
    "name": "Work through the checkout's work list",
    "inputs": {
      "executor": "capability-slug"
    },
    "outputs": {
      "results": "list"
    },
    "steps": {
      "select": {
        "source": "work-list",
        "bounds": {
          "max_results": 6,
          "on_overflow": "refuse"
        }
      },
      "independence": {
        "question": "openagents.independence.v2",
        "bounds": {
          "refuse_below": 0.7,
          "requires_scorable_answer": true
        }
      },
      "admit": {
        "bounds": {
          "refuse_on": "cannot_enforce_intersection"
        }
      },
      "fan_out": {
        "bounds": {
          "concurrent_max": 6,
          "isolation": "worktree",
          "minutes": 30
        },
        "briefing": "You are working in a Git worktree made for this item alone. The repository's common Git directory is sealed: git commands that read or write it, including status, add, commit, and worktree, fail here, and that is by design. Do not try to unseal it, and do not touch anything outside this worktree. If your item changes files, commit it to the scratch Git directory already inside the worktree at `.coder-git`, which holds one commit of the tree as you found it: with `GIT_DIR=.coder-git` and `GIT_WORK_TREE=.` exported, run `git add -A` and `git commit`. Every git command you run needs those two variables, and your commit should hold only the files your item changed. The reviewer fetches from that scratch directory with `git fetch <worktree>/.coder-git HEAD` after you finish; nothing you commit reaches the shared repository on its own. End your reply with one line that starts with `Final answer:` followed by the answer the item asks for, in the form it asks for it. Whatever you print before that line is kept as narration; only what follows the last `Final answer:` is judged."
      },
      "accept": {
        "question": "openagents.completion.v1",
        "bounds": {
          "per_requirement": true
        }
      }
    }
  }
}
