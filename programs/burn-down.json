{
  "v": 1,
  "slug": "burn-down",
  "name": "Work through the checkout's work list",
  "summary": "Runs one delegated session per item of the work list this checkout carries (.coder/work-list.json), each in a worktree of its own, and keeps every worktree for review.",
  "inputs": {"executor": "capability-slug"},
  "outputs": {"results": "list"},
  "steps": [
    {"name": "select", "kind": "query", "source": "work-list",
     "bounds": {"max_results": 6, "on_overflow": "refuse"}},
    {"name": "independence", "kind": "decide",
     "question": "openagents.independence.v1",
     "bounds": {"refuse_below": 0.7, "requires_calibration": true}},
    {"name": "admit", "kind": "check",
     "bounds": {"refuse_on": "cannot_enforce_intersection"}},
    {"name": "fan_out", "kind": "delegate",
     "bounds": {"concurrent_max": 6, "isolation": "worktree", "minutes": 30}},
    {"name": "accept", "kind": "decide",
     "question": "openagents.completion.v1",
     "bounds": {"per_requirement": true}}
  ]
}
