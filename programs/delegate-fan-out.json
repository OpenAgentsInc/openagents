  "binding": {
    "name": "Fan out one session per task",
    "inputs": {
      "tasks": "list",
      "executor": "capability-slug"
    },
    "outputs": {
      "results": "list"
    },
    "steps": {
      "select": {
        "source": "request",
        "bounds": {
          "max_results": 12,
          "on_overflow": "refuse"
        }
      },
      "independence": {
        "question": "openagents.independence.v2",
        "bounds": {
          "refuse_below": 0.7,
          "requires_scorable_answer": true
        }
      },
      "admit": {
        "bounds": {
          "refuse_on": "cannot_enforce_intersection"
        }
      },
      "fan_out": {
        "bounds": {
          "concurrent_max": 6,
          "isolation": "worktree",
          "minutes": 60
        }
      },
      "accept": {
        "question": "openagents.completion.v1",
        "bounds": {
          "per_requirement": true
        }
      }
    }
