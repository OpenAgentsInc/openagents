  "binding": {
    "name": "Solve an issue to a pull request",
    "inputs": {
      "issue": "string",
      "repository": "string"
    },
    "outputs": {
      "pull_request": "string"
    },
    "steps": {
      "intake": {
        "source": "request",
        "bounds": {
          "max_results": 1,
          "on_overflow": "refuse"
        }
      },
      "brief": {
        "executor": "solver-briefer",
        "bounds": {
          "isolation": "worktree",
          "minutes": 15
        }
      },
      "code": {
        "executor": "solver-coder",
        "requires": [
          "brief"
        ],
        "bounds": {
          "isolation": "worktree",
          "minutes": 60
        }
      },
      "check": {
        "bounds": {
          "refuse_on": "gate_not_met",
          "max_tests": 16
        }
      },
      "land": {
        "executor": "solver-tester",
        "requires": [
          "code"
        ],
        "bounds": {
          "isolation": "worktree",
          "minutes": 30
        }
      },
      "done": {
        "question": "openagents.completion.v1",
        "requires": [
          "land"
        ],
        "bounds": {
          "refuse_below": 0.7,
          "requires_scorable_answer": true
        }
      }
    }
  }
