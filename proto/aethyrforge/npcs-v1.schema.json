    "{\"schema\":\"aethyrforge.npcs.v1\",\"version\":0,\"serial\":7,\"groups\":2,\"npcs\":[{\"id\":1,\"group\":1,\"kind\":0,\"action\":0,\"x_cm\":0,\"z_cm\":0,\"target_kind\":5,\"target_id\":9}]}",
    "{\"schema\":\"aethyrforge.npcs.v1\",\"version\":0,\"serial\":7,\"groups\":2,\"npcs\":[{\"id\":1,\"group\":1,\"kind\":0,\"action\":0,\"x_cm\":16001,\"z_cm\":0,\"target_kind\":0,\"target_id\":0}]}",
    "{\"schema\":\"aethyrforge.npcs.v1\",\"version\":0,\"serial\":7,\"groups\":2,\"npcs\":[{\"id\":1,\"group\":1,\"kind\":0,\"action\":0,\"x_cm\":0,\"target_kind\":0,\"target_id\":0}]}"
  ]
}
