{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagents.com/proto/aethyrforge/raid-command-v1.schema.json",
  "title": "Local Aethyrforge cultist event command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "base"],
  "properties": {
    "op": {"enum": ["start", "stop", "double", "wave", "set"]},
    "base": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "count": {"type": "integer", "minimum": 1, "maximum": 60}
  },
  "allOf": [
    {"if": {"properties": {"op": {"const": "set"}}}, "then": {"required": ["count"]}},
    {"if": {"properties": {"op": {"enum": ["stop", "double"]}}}, "then": {"not": {"required": ["count"]}}}
  ]
}
