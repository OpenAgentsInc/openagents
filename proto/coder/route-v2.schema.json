{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagents.com/proto/coder/route-v2.schema.json",
  "title": "Coder automatic Elephant route v2 (local JSONL)",
  "type": "object",
  "required": ["kind", "schema", "ok", "source", "model", "eligible_mask", "blocked_mask", "allowed_mask"],
  "properties": {
    "kind": {"const": "route"},
    "schema": {"const": "coder.route.v2"},
    "ok": {"type": "boolean"},
    "source": {"enum": ["local-elephant", "pylon-elephant"]},
    "model": {"enum": ["", "haiku", "sonnet", "opus"]},
    "engine": {"enum": ["claude", "codex", "micro", "psionic"]},
    "ran": {"enum": ["claude", "codex", "microcoder", "psionic"]},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "difficulty": {"type": "integer", "minimum": 0, "maximum": 4},
    "effort": {"enum": ["low", "medium", "high"]},
    "text": {"type": "string"},
    "eligible_mask": {"type": "integer", "minimum": 0, "maximum": 15},
    "blocked_mask": {"type": "integer", "minimum": 0, "maximum": 15},
    "allowed_mask": {"type": "integer", "minimum": 0, "maximum": 15}
  },
  "if": {"properties": {"ok": {"const": true}}},
  "then": {"required": ["engine", "probability", "difficulty", "effort"]},
  "else": {"required": ["text"]},
  "additionalProperties": false
}
