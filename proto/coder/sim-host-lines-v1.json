{
 "identity": "simhost-lines-v1",
 "check": "coax/web/tool.sh coax/lib/agent/device/sim-wire-checks.coax proto/coder/sim-host-lines-v1.json",
 "codec": "coax/lib/agent/device/sim-wire.coax",
 "scope": "What the iOS Simulator helper (oasim serve, coax/lib/agent/device/sim-host.coax) and its clients say over its Unix socket (~/.openagents/sim/simhost.sock, mode 0600): one JSON object a line each way. The clients are OpenAgents Desktop's pane (client app, the person) and oasim's verbs (client oasim: an agent's shell; later oasim mcp). docs/desktop/ios-simulator-spec.md section 7.4; GitHub #13811.",
 "captured": "2026-11-20, by coder/tui/simhost-check.coax (--wire-log) against a helper built from this tree, on a throwaway iPhone 17 (iOS 26.5, Xcode 26.6) the check created and deleted. Every line is what a program wrote; the check's two connections (app and agent) are kept in the order each end wrote or read them.",
 "framing": "A line ends with one line feed. Requests carry an id the reply echoes (id 0: no reply is wanted; a line the helper can't read gets an id-0 bad_args reply); events carry event and no id, and may carry op (the op they are about). Strings are escaped as coax/lib/json/json.coax jo_str writes them. A number is written bare when whole, else with up to four decimals, never with an exponent. Members are written in the codec's order (sim-wire.coax SW_F_*); the reader takes them in any order but refuses a member it does not know or one given twice.",
 "codes": [
  "no_xcode",
  "no_device",
  "not_booted",
  "contested",
  "denied",
  "no_grant",
  "interrupted",
  "out_of_bounds",
  "input_unavailable",
  "bad_args",
  "helper_down",
  "timeout",
  "install_refused"
 ],
 "ops": [
  {
   "name": "hello",
   "note": "the first line of every connection: client (app, oasim or mcp), version, and for an agent its chat, engine and working folder"
  },
  {
   "name": "subscribe",
   "note": "the app's connection hears events (ask, agent, state, revoked; in Phase 1 surface)"
  },
  {
   "name": "list",
   "note": "the iOS devices simctl lists, each with booted_by_us"
  },
  {
   "name": "boot",
   "note": "simctl boot then bootstatus -b; the reply carries udid, points and scale"
  },
  {
   "name": "screenshot",
   "note": "simctl io screenshot, then sips to scale x points; the reply carries path, points and bytes"
  },
  {
   "name": "set_appearance",
   "note": "simctl ui appearance light|dark"
  },
  {
   "name": "deny",
   "note": "the person: Don't allow (parked requests end denied)"
  },
  {
   "name": "grant",
   "note": "the person: allow a chat on a device, scope chat or once"
  },
  {
   "name": "appearance",
   "note": "the device's appearance"
  },
  {
   "name": "open_url",
   "note": "simctl openurl"
  },
  {
   "name": "launch",
   "note": "install (an .app under the chat's folder or our DerivedData), then simctl launch --terminate-running-process"
  },
  {
   "name": "shutdown",
   "note": "simctl shutdown; an agent may shut down only a device an agent booted"
  },
  {
   "name": "revoke",
   "note": "the person: Stop (the chat's grants end; its clients hear revoked)"
  },
  {
   "name": "quit",
   "note": "the helper exits after its reply"
  }
 ],
 "events": [
  {
   "name": "state",
   "note": "a device's state changed (booting, booted, shutting_down, shutdown)"
  },
  {
   "name": "ask",
   "note": "an agent's op is parked until the person answers in the app (two minutes)"
  },
  {
   "name": "agent",
   "note": "an agent's control op ran, for the badge and the transcript"
  },
  {
   "name": "revoked",
   "note": "the person stopped a chat"
  }
 ],
