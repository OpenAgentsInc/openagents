{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagents.com/proto/coder/voice-input-v1.schema.json",
  "title": "Aethyrforge finalized local voice input (native IPC)",
  "check": "coax/web/tool.sh apps/aethyrforge-desktop/voice-coder-profile.coax proto/coder/voice-input-v1.schema.json",
  "type": "object",
  "required": ["schema", "kind", "ticket"],
  "properties": {
    "schema": {"const": "aethyrforge.voice-coder.v1"},
    "kind": {"enum": ["final", "cancel"]},
    "ticket": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "text": {"type": "string"}
  },
  "if": {"properties": {"kind": {"const": "final"}}},
  "then": {"required": ["text"]},
  "additionalProperties": false,
  "examples": [
    {
      "name": "final with text",
      "message": "{\"schema\":\"aethyrforge.voice-coder.v1\",\"kind\":\"final\",\"ticket\":1,\"text\":\"hello\"}",
      "accepts": true
    },
    {
      "name": "partial",
      "message": "{\"schema\":\"aethyrforge.voice-coder.v1\",\"kind\":\"partial\",\"ticket\":1,\"text\":\"x\"}",
      "accepts": false
    },
    {
      "name": "cancel",
      "message": "{\"schema\":\"aethyrforge.voice-coder.v1\",\"kind\":\"cancel\",\"ticket\":1}",
      "accepts": true
    },
    {
      "name": "wrong schema refused",
      "message": "{\"schema\":\"wrong\",\"kind\":\"final\",\"ticket\":1,\"text\":\"x\"}",
      "accepts": false
    }
  ]
}
