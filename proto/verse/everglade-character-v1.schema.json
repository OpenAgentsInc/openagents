      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$",
      "description": "the durable identity: the account's text (decision 0006)"
    },
    "class": {
      "type": "string",
      "pattern": "^(srd-[a-z]{3,12})?$",
      "description": "set once, never changed; empty before the first seat"
    },
    "xp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999,
      "description": "only rises"
    },
    "floor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "the level the server grants without the XP; the level is srd_level_from(xp, floor, 6) and is not stored"
    },
    "known": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "description": "ability content IDs learned past the class kit, ascending, no repeats"
    },
    "bag": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "description": "item IDs (verse.items.id), ascending, no repeats: the ledger's, never a room's"
    },
    "inv": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "the ledger's inventory version"
    },
    "worn": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "description": "head, body, hands, legs, feet, neck, ring, main, off, ranged: an item ID in the bag or 0; no item twice"
    },
    "coin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999999,
      "description": "copper pieces: game currency, never money"
    },
    "quests": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "description": "(quest content ID, stage), ascending by ID, no repeats"
    }
  },
