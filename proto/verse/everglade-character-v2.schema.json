    "range": {
      "type": "array",
      "minItems": 61,
      "maxItems": 61,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9999999
      },
      "description": "the Archery Range's lasting tally (#13519, everglade/range/score.coax rg_tally_*): the longest run of hits, then for each way of shooting (on foot, from horseback, from dragonback) and each band of distance (to 15, 25, 40, 60 m, past 60) its shots, hits, points and golds. A cell's hits are at most its shots, its golds at most its hits, its points one to ten a hit; the run at most every hit. Changed only by a claim (an arrow's, or RESET's clear). A record whose tally is all 0 is written as v1"
    }
  },
