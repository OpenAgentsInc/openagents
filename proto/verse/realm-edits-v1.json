  "seed": "INSERT INTO verse.players (id, key_sha256, created_ms) VALUES ('p-edit-fixture', encode(sha256(convert_to('edit-fixture-player-key-0001', 'UTF8')), 'hex'), 1); INSERT INTO verse.worlds (id, owner_player, created_ms) VALUES ('made-edit-fixture', 'p-edit-fixture', 1); INSERT INTO verse.made_realms (slug, world, name, style, ground, time, features, tools, made_ms) VALUES ('edit-fixture', 'made-edit-fixture', 'Edit Fixture', 'lowpoly', 'grass', 'day', '[{\"feature\":\"trees\",\"variant\":\"pine\",\"count\":6},{\"feature\":\"character\",\"name\":\"Old Mott\",\"role\":\"the ferryman\"}]', '{\"fly\":true,\"jump\":true}', 1);",
  "clean": "CREATE TEMP TABLE ef AS SELECT m.slug FROM verse.made_realms m JOIN verse.worlds w ON w.id = m.world WHERE w.owner_player = 'p-edit-fixture'; DELETE FROM verse.realm_publications WHERE slug IN (SELECT slug FROM ef); DELETE FROM verse.realm_revisions WHERE slug IN (SELECT slug FROM ef); DELETE FROM verse.realm_proposals WHERE slug IN (SELECT slug FROM ef); DELETE FROM verse.realm_lore WHERE slug IN (SELECT slug FROM ef); DELETE FROM verse.realm_quests WHERE slug IN (SELECT slug FROM ef); DELETE FROM verse.made_realms WHERE slug IN (SELECT slug FROM ef); DELETE FROM verse.worlds WHERE owner_player = 'p-edit-fixture'; DELETE FROM verse.players WHERE id = 'p-edit-fixture';"
 },
