    "error": "openagents.api.v1alpha1.ErrorReply",
    "open": "openagents.verse.seat.v1alpha1.OpenRequest",
    "grant": "openagents.verse.seat.v1alpha1.Grant",
    "none": "openagents.verse.seat.v1alpha1.Grant (no member: a hosted seat's grant that could not be shown without its key)",
    "seats": "openagents.verse.seat.v1alpha1.SeatsReply",
    "kept": "openagents.verse.seat.v1alpha1.Kept",
    "closed": "openagents.verse.seat.v1alpha1.Closed (the API's .../close and the runner's /seat/close)",
