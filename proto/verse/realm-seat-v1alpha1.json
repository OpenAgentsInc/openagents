    "kept": "openagents.verse.seat.v1alpha1.Kept",
    "closed": "openagents.verse.seat.v1alpha1.Closed (the API's .../close and the runner's /seat/close)",
    "runner-open": "openagents.verse.seat.v1alpha1.RunnerOpen",
    "runner-close": "openagents.verse.seat.v1alpha1.RunnerClose",
    "runner-act": "openagents.verse.seat.v1alpha1.RunnerAct",
    "start": "openagents.verse.seat.v1alpha1.SeatStart",
