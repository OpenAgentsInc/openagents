   "name": "bad-request",
   "retry": false,
   "means": "The arguments are not a request this operation takes."
  },
  {
   "number": 6,
   "id": "realm-authoring.diagnostic.nothing-to-do.v1",
   "name": "nothing-to-do",
   "retry": false,
   "means": "There was nothing to do: nothing to undo, nothing new to publish."
  },
  {
   "number": 7,
   "id": "realm-authoring.diagnostic.no-answer.v1",
   "name": "no-answer",
   "retry": true,
   "means": "The request was sent and no answer came. It may have been saved: read the realm's revision before repeating it."
  },
  {
   "number": 8,
   "id": "realm-authoring.diagnostic.operation-failed.v1",
   "name": "operation-failed",
   "retry": true,
   "means": "The server or the tool failed. Nothing was saved."
  }
 ],
