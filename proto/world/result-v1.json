 "schema": "realm.result.v1",
 "about": "What the CLI, the realm_* MCP tools, coax drive and the editor's agent strip answer after an operation (GitHub #13436): done with the new revision, running with a job, needs approval, a dry run with its level, refused with a diagnostic code and whether a retry can help, or unknown when no answer came. Every result names the realm, the revision, the build and the page it touched (#13437). metaverse-engine/editor/op-result.coax writes and reads it and is the one list of the codes.",
 "states": [
  "done",
  "running",
  "needs-approval",
  "dry-run",
  "refused",
  "unknown"
 ],
 "levels": [
  "schema",
  "world",
  "change",
  "copy"
 ],
 "rule": "A code's number and retry are never changed, and a number is never used again.",
