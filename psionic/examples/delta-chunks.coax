#import "Basic";
#load "../lib/delta-chunks.coax";

// book:begin example
main :: () {
    print("profile delta-chunks-cpu-f64-v1, tolerance % x (1 + largest |reference value|)\n",DK_TOLERANCE);
    // The hand trace: one key and one value dimension, start state 2, two
    // tokens with q = k = 1, v = 3 then 5, beta 0.5 and gate decay 0.5.
    h:=DkChunk.{key_dim=1,value_dim=1,tokens=2,stride=3,q=0,k=1,v=2};
    conv:=[6]f64.[1,1,3, 1,1,5];one:=[2]f64.[1,1];beta:=[2]f64.[0.5,0.5];decay:=[2]f64.[0.5,0.5];
    start:=[1]f32.[2];draft:[2]f64;end:[1]f64;scratch:[16]f64;
    #assert dk_head(h,conv[..],one[..],one[..],beta[..],decay[..],start[..],draft[..],end[..],scratch[..]);
    print("decay through each token %, %; decay after token 0 through token 1 %\n",scratch[14],scratch[15],scratch[2]);
    print("solved updates u %, %; outputs %, %; carried state %\n",scratch[12],scratch[13],draft[0],draft[1],end[0]);

    // Chapter 11's step over 13 tokens is the reference; the chunked run
    // starts from the same zero state.
    print("13 tokens, 3 key heads, 6 value heads, key and value width 2:\n");
    for mi:0..<2 {
        memory:=f32(-4*mi);
        print("  log A %:\n",memory);
        sizes:=[7]int.[1,2,3,4,5,8,64];
        for si:0..<7 {
            k:=dko_check(memory,sizes[si]);
            print("    chunk %: outputs %, state %, snapshots % (% of them, histories equal %), bit for bit %\n",sizes[si],k.out,k.state,k.snapshot,k.snapshots,k.histories,k.same);
        }
    }

    // Resume from the snapshot after token 8 and compare with the run that continued.
    s:=dko_shape();input:=dko_input(-4);m:=pd_input_count(s);work:[4096]f64;
    history:[72]f32;state:[24]f32;out:[156]f32;snaps:[384]f32;
    r:=dk_prefill(s,13,4,input[..],history[..],state[..],out[..],snaps[..],work[..],false);
    #assert r.status==DkStatus.ok;
    h2:[72]f32;s2:[24]f32;rest:[60]f32;
    for i:0..<72 {h2[i]=snaps[96+i];}for i:0..<24 {s2[i]=snaps[168+i];}
    r=dk_prefill(s,5,4,input[8*m..<13*m],h2[..],s2[..],rest[..],snaps[0..<0],work[..],false);
    print("resumed at token 8 from a snapshot: outputs, state and history bit for bit %\n",dko_same(rest[..],out[96..<156]) && dko_same(s2[..],state[..]) && dko_same(h2[..],history[..]));

    elephant:=PdShape.{key_heads=16,value_heads=32,key_dim=128,value_dim=128,epsilon=0.000001f32};
    print("Elephant's shape: work at chunk 64 % f64 elements, one snapshot % f32 elements\n",dk_work_count(elephant,64),dk_snapshot_size(elephant));

    for i:0..<156 {out[i]=-7;}
    r=dk_prefill(s,13,0,input[..],history[..],state[..],out[..],snaps[..],work[..],false);
    print("refused: chunk 0: %, output %\n",r.status,out[0]);
    bits:u32=0x7f000000;bits+=0x00800000;input[5*m+3]=f32_from_bits(bits);
    r=dk_prefill(s,13,4,input[..],history[..],state[..],out[..],snaps[..],work[..],false);
    print("refused: an infinite input at token 5: %, output %, written %\n",r.status,out[0],r.written);
    input=dko_input(-4);input[9*m]=1e30;for tap:0..<4 {input[9*m+24+tap]=1e30;}
    for i:0..<24 {state[i]=0;}for i:0..<72 {history[i]=0;}
    r=dk_prefill(s,13,4,input[..],history[..],state[..],out[..],snaps[..],work[..],false);
    print("refused: a convolution past f32 at token 9: %, tokens committed %, snapshots %, state equals snapshot 2 %\n",r.status,r.written,r.snapshots,dko_same(state[..],snaps[168..<192]));
}
// book:end example
