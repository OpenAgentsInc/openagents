// W1.3 (#13916): Optimal Liveness & Slot-Reuse Scheduler + GPU Preflight Example.
// Compares W1.1 / Ch 229 greedy ASAP schedules against W1.3's formal optimal
// scheduler across Ch 229 benchmark graphs and the full Ch 226 stack+memory VM,
// verifies 54/54 bit-exact programs, runs extended Ch 230 differential fuzzing
// with 100% planted-bug detection, and verifies GPU device/envelope preflight.
#import "Basic";
#load "../platform/exec-vm-gpu-bridge.coax";

clock :: () -> int #foreign #effects(all);

main :: () {
    // 1. Ch 226 VM greedy vs optimal comparison.
    lg: [EV_VM_MAX_LAYERS]EvLayerDesc; hg: [EV_VM_MAX_HEADS]EvHeadDesc; wg: [EV_VM_MAX_WEIGHTS]f64;
    mg := ev_ch226_compile(TM_CELLS, lg[..], hg[..], wg[..]);
    #assert mg.status == EvStatus.ok;

    lo: [EV_VM_MAX_LAYERS]EvLayerDesc; ho: [EV_VM_MAX_HEADS]EvHeadDesc; wo: [EV_VM_MAX_WEIGHTS]f64;
    met: [1]EvSchedMetrics;
    mo := evs_compile_ch226_metrics(TM_CELLS, lo[..], ho[..], wo[..], met[..]);
    #assert mo.status == EvStatus.ok;

    tot_g := 0;
    for i: 0..<mg.n_layers { if mg.layers[i].kind == EvLayerKind.ffn { tot_g += mg.layers[i].units; } }
    print("Ch 226 VM Greedy  (W1.1): width %, % layers, % heads, % units (wb %), % weights\n",
        mg.width, mg.n_layers, mg.n_heads, tot_g, mg.layers[mg.n_layers - 1].units, mg.n_weights);
    print("Ch 226 VM Optimal (W1.3): width %, % layers, % heads, % units (clear %, wb %), % weights\n",
        mo.width, mo.n_layers, mo.n_heads, met[0].total_units, met[0].clear_units, met[0].wb_units, mo.n_weights);

    // 2. Verify all 54 Ch 226 programs bit-for-bit on optimal-scheduled weights.
    kv_ctx: [131072]f64;
    ex_x: [EV_VM_MAX_WIDTH]f64; ex_st: [EV_VM_MAX_WIDTH]f64; ex_h: [EV_VM_MAX_UNITS]f64;
    exec := EvExecArena.{x = ex_x[..], stage = ex_st[..], hidden = ex_h[..]};
    prog: [48]TmOp;
    t_ref: [2048]int; t_opt: [2048]int;
    o_ref: [TM_OUTPUTS]int; o_opt: [TM_OUTPUTS]int;
    total_steps := 0;
    for idx: 0..<54 {
        plen := 0;
        if idx == 0 { plen = ev_prog_squares(4, prog[..]); }
        else if idx == 1 { plen = ev_prog_sum(10, prog[..]); }
        else if idx == 2 { plen = ev_prog_fact(10, prog[..]); }
        else if idx == 3 { plen = ev_prog_memfill(5, 8, prog[..]); }
        else { plen = ev_seed_program(idx - 4, prog[..]); }
        r := tm_run(prog[0..<plen], 400, t_ref[..], o_ref[..], false);
        w := ev_ch226_run(mo, prog[0..<plen], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false);
        #assert r.status == TmStatus.ok && w.status == TmStatus.ok && r.steps == w.steps;
        #assert ev_same_digest(r.digest, w.digest);
        total_steps += w.steps;
    }
    print("Optimal Ch 226 VM: 54/54 programs verified bit-for-bit (% autoregressive steps, 0 divergences)\n", total_steps);

    // 3. Ch 229 / Ch 230 aggregate greedy vs optimal across 100 generated graphs + 100% planted-bug catch.
    gnodes: [16]GgNode;
    w1: [16384]f64; w2: [16384]f64;
    cnt := 0; wg_sum := 0; wo_sum := 0; wtg := 0; wto := 0; narrower := 0; lighter := 0;
    for seed: 1..<6 {
        for g: 0..<20 {
            c := ch_case(seed, g, gnodes[..]);
            pg := gg_compile(gnodes[0..<c.count], c.outputs[..], w1[..]);
            po := evs_compile_gg(gnodes[0..<c.count], c.outputs[..], w2[..]);
            if pg.status == GgStatus.ok && po.status == GgStatus.ok {
                cnt += 1;
                wg_sum += pg.width; wo_sum += po.width;
                wtg += pg.weights; wto += po.weights;
                if po.width < pg.width { narrower += 1; }
                if po.weights < pg.weights { lighter += 1; }
                r := evs_ch_run(gnodes[0..<c.count], c.outputs[..], c.values[0..<c.inputs], GgFault.none);
                #assert r.status != GgStatus.ok || r.where == ChWhere.none;
            }
        }
    }
    print("Ch 229/230 (% graphs): greedy width=% weights=% -> optimal width=% weights=% (narrower %, lighter %)\n",
        cnt, wg_sum, wtg, wo_sum, wto, narrower, lighter);

    // Verify 100% planted-bug catch on optimal scheduler across 10 seeds (4 GgFaults + 7 EvFaults).
    for fi: 1..<5 {
        caught := 0;
        for seed: 1..<11 {
            for g: 0..<40 {
                c := ch_case(seed, g, gnodes[..]);
                r := evs_ch_run(gnodes[0..<c.count], c.outputs[..], c.values[0..<c.inputs], cast(GgFault)fi);
                if r.status == GgStatus.ok && r.where != ChWhere.none { caught += 1; break; }
            }
        }
        #assert caught == 10;
    }
    enodes: [EVH_NODES_MAX]EvNode;
    for fi: 1..<8 {
        caught := 0;
        for seed: 1..<11 {
            for g: 0..<20 {
                c := evh_case(seed, g, enodes[..]);
                r := evs_h_run(enodes[0..<c.count], c.outputs[..], c.values[0..<c.inputs], c.kv_ctx[..], EVH_KV_COUNT, EVH_KV_SLOTS, cast(EvFault)fi);
                if r.status == EvStatus.ok && r.where != EvWhere.none { caught += 1; break; }
            }
        }
        #assert caught == 10;
    }
    print("Planted-bug verification: 4/4 Ch 229 faults and 7/7 Attention+FFN faults caught across 10/10 seeds (100%%)\n");

    // 4. Honest CPU throughput comparison: native vs greedy weights vs optimal weights.
    p0: [48]TmOp; n0 := ev_prog_squares(4, p0[..]);
    p1: [48]TmOp; n1 := ev_prog_sum(10, p1[..]);
    p2: [48]TmOp; n2 := ev_prog_fact(10, p2[..]);
    p3: [48]TmOp; n3 := ev_prog_memfill(5, 8, p3[..]);

    t0 := clock();
    ns := 0;
    for rep: 0..<400 {
        ns += tm_run(p0[0..<n0], 400, t_ref[..], o_ref[..], false).steps;
        ns += tm_run(p1[0..<n1], 400, t_ref[..], o_ref[..], false).steps;
        ns += tm_run(p2[0..<n2], 400, t_ref[..], o_ref[..], false).steps;
        ns += tm_run(p3[0..<n3], 400, t_ref[..], o_ref[..], false).steps;
    }
    nu := clock() - t0; if nu < 1 { nu = 1; }

    t1 := clock();
    gs := 0;
    for rep: 0..<10 {
        gs += ev_ch226_run(mg, p0[0..<n0], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
        gs += ev_ch226_run(mg, p1[0..<n1], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
        gs += ev_ch226_run(mg, p2[0..<n2], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
        gs += ev_ch226_run(mg, p3[0..<n3], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
    }
    gu := clock() - t1; if gu < 1 { gu = 1; }

    t2 := clock();
    os := 0;
    for rep: 0..<10 {
        os += ev_ch226_run(mo, p0[0..<n0], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
        os += ev_ch226_run(mo, p1[0..<n1], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
        os += ev_ch226_run(mo, p2[0..<n2], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
        os += ev_ch226_run(mo, p3[0..<n3], 400, t_opt[..], o_opt[..], kv_ctx[..], exec, false).steps;
    }
    ou := clock() - t2; if ou < 1 { ou = 1; }

    print("CPU benchmark (4-program Ch 226 suite): native % steps/s | greedy weights % steps/s | optimal weights % steps/s\n",
        cast(int)((f64(ns) * 1000000.0) / f64(nu)),
        cast(int)((f64(gs) * 1000000.0) / f64(gu)),
        cast(int)((f64(os) * 1000000.0) / f64(ou)));
}
