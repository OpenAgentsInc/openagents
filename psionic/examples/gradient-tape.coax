#import "Basic";
#load "../lib/tape.coax";

r4 :: (v:f64)->f64 {return floor(v*10000+0.5)/10000;}
// Run a program forward and backward from zeroed gradients; return the result.
run :: (g:[]TpNode,p:[]f64,v:[]f64,grads:[]f64)->f64 {
    for k:0..<grads.count {grads[k]=0;}
    #assert tp_forward(g,p,v,false)==TpStatus.ok && tp_backward(g,v,grads,false)==TpStatus.ok;
    return v[g.count-1];
}

// book:begin example
main :: () {
    v:[8]f64;gr:[2]f64;
    sq:=[2]TpNode.[TpNode.{op=TpOp.param},TpNode.{op=TpOp.mul,a=0,b=0}];a:=[1]f64.[3];
    print("x * x at x = 3: value %, gradient % (node 0 is read twice)\n",run(sq[..],a[..],v[..],gr[0..<1]),gr[0]);
    two:=[5]TpNode.[TpNode.{op=TpOp.param},TpNode.{op=TpOp.param},TpNode.{op=TpOp.constant,value=3},
        TpNode.{op=TpOp.mul,a=2,b=0},TpNode.{op=TpOp.add,a=3,b=1}];a[0]=5;
    sum:=run(two[..],a[..],v[..],gr[0..<1]);
    print("3a + a at a = 5, two nodes reading slot 0: value %, gradient %\n",sum,gr[0]);
    ab:=[3]TpNode.[TpNode.{op=TpOp.param,slot=0},TpNode.{op=TpOp.param,slot=1},TpNode.{op=TpOp.mul,a=0,b=1}];b:=[2]f64.[2,3];
    product:=run(ab[..],b[..],v[..],gr[..]);
    #assert tp_backward(ab[..],v[..],gr[..],false)==TpStatus.ok;
    print("a * b = % at (2, 3), backward twice without zeroing: gradient (%, %), not (3, 2)\n",product,gr[0],gr[1]);

    // Chapter 70's data and models, as programs.
    x:[9600]f64;y:[2400]f64;lat:[2400]f64;g:[2400]int;tr:[2400]int;te:[2400]int;
    #assert tb_simulate(70,300,x[..],y[..],lat[..],g[..],false).status==TbStatus.ok;
    train:=tr[0..<tb_rows(g[..],0,tr[..],false)];test:=te[0..<tb_rows(g[..],2,te[..],false)];
    mean:[4]f64;sd:[4]f64;xs:[9600]f64;
    #assert tb_fit_scale(x[..],4,train,mean[..],sd[..],false)==TbStatus.ok && tb_apply_scale(x[..],4,mean[..],sd[..],xs[..],false)==TbStatus.ok;
    nodes:[4096]TpNode;values:[4096]f64;
    logistic:=TbModel.{features=4,logistic=true};mlp:=TbModel.{features=4,hidden=8,logistic=true};
    p:[49]f64;tb_initialize(mlp,1,p[..]);hand:[49]f64;tape:[49]f64;batch:=train[0..<16];
    print("one batch of 16 rows: logistic program % nodes, hidden-layer program % nodes\n",
        tp_tabular(logistic,xs[..],y[..],batch,nodes[..],false).count,tp_tabular(mlp,xs[..],y[..],batch,nodes[..],false).count);
    tb_gradient(mlp,p[..],xs[..],y[..],batch,hand[..]);
    #assert tp_gradient(mlp,p[..],xs[..],y[..],batch,tape[..],nodes[..],values[..],false)==TpStatus.ok;
    worst:=0.0;for s:0..<49 {e:=abs(tape[s]-hand[s]);if e>worst {worst=e;}}
    print("tape against chapter 70's hand-written gradient: largest difference %\n",worst);

    c:=TbConfig.{epochs=40,batch=16,rate=0.5,init_seed=1,shuffle_seed=2};
    order:[2400]int;q:[49]f64;z:[2400]f64;ms:=[2]TbModel.[logistic,mlp];names:=[2]string.["logistic","hidden layer"];
    for k:0..<2 {
        r:=tp_train(ms[k],c,xs[..],y[..],train,q[..],order[..],nodes[..],values[..],false);
        #assert r.status==TbStatus.ok && tb_predict(ms[k],q[..],xs[..],z[..],false)==TbStatus.ok;
        print("% trained through the tape, % steps: test log loss %\n",names[k],r.steps,r4(tb_log_loss(z[..],y[..],test).value));
    }
}
// book:end example
