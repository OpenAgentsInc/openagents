#import "Basic";
#load "../lib/robotics/panda-inverse-dynamics.coax";
PidExampleWatt :: struct @unit(mass=1,length=2,time=-3,angle=0,numerator=1,denominator=1) {}
#test "Panda inverse example rounds independently known positive zero and negative displays" {
 #assert panda_inverse_micro(1.25)==1250000 && panda_inverse_micro(-1.25)== -1250000 && panda_inverse_micro(0)==0;
}
#test "Panda inverse example generalized forces and coordinate rates yield physical power" {
 h:pfku.Quantity(PmHingeGravity,f64);h.value=3;v:pfku.Quantity(PidAngularRate,f64);v.value=2;
 s:pfku.Quantity(PmSlideGravity,f64);s.value=5;w:pfku.Quantity(PidLinearRate,f64);w.value=0.4;
 power:=convert_unit(PidExampleWatt,h*v)+convert_unit(PidExampleWatt,s*w);#assert panda_inverse_micro(power.value)==8000000;
}
panda_inverse_micro :: (value:f64)->int {return cast(int)floor(value*1000000+0.5);}
main :: () {
 print("fixed Panda9 inverse force: dense moving state\n");
// book:begin inverse
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);
 v:[7]pfku.Quantity(PidAngularRate,f64);w:[2]pfku.Quantity(PidLinearRate,f64);
 a:[7]pfku.Quantity(PidAngularAcceleration,f64);b:[2]pfku.Quantity(PidLinearAcceleration,f64);
 coordinates:=[9]f64.[0.3,-0.4,0.5,-1.6,-0.7,1.2,0.9,0.017,-0.029];
 rates:=[9]f64.[0.7,-0.4,0.3,-0.6,0.5,-0.2,0.1,0.03,-0.02];
 accelerations:=[9]f64.[1.3,-2.1,0.7,-1.1,0.9,0.4,-0.8,0.2,-0.15];
 for i:0..<7 {q[i].value=coordinates[i];v[i].value=rates[i];a[i].value=accelerations[i];}
 for i:0..<2 {s[i].value=coordinates[7+i];w[i].value=rates[7+i];b[i].value=accelerations[7+i];}
 force:[1]PidOutput;#assert pid_inverse(q[..],s[..],v[..],w[..],a[..],b[..],force[..])==PfkStatus.ok;
 for i:0..<7 {print("hinge % (uJ/rad): %\n",i+1,panda_inverse_micro(force[0].hinge[i].value));}
 for i:0..<2 {print("slide % (uN): %\n",i+1,panda_inverse_micro(force[0].slide[i].value));}
// book:end inverse
 print("query only; no motor command\n");
}
