#import "Basic";
#load "../lib/next-token-trie.coax";

// book:begin example
main :: () {
    nodes:[256]RsNode;arena:[2048]u8;edges:[4096]NxEdge;ends:[64]int;accepting:[64]int;next:[131072]int;accept:[512]u8;live:[512]u8;
    w:=ns_work(nodes[..],arena[..],edges[..],ends[..],accepting[..],next[..],accept[..],live[..]);

    // The worked integer: -5..120.
    s:=nx_schema("{\"type\":\"integer\",\"minimum\":-5,\"maximum\":120}",w);g:=s.grammar;
    print("integer -5..120: % states, % edges\n",s.states,s.edges);
    probes:=[10]string.["0","1","2","10","11","12","13","120","-","-3"];
    for x:probes {t:=nx_walk(g,g.start,x);print("  % -> state % %\n",x,t,ifx t>=0 && g.accepting[t]==1 then "(complete)" else "(not complete)");}
    print("  121 -> %, 05 -> %, -0 -> %\n",nx_walk(g,g.start,"121"),nx_walk(g,g.start,"05"),nx_walk(g,g.start,"-0"));

    // The chapter's schema.
    s=nx_schema(NT_SCHEMA,w);g=s.grammar;
    print("schema: % states, % edges\n",s.states,s.edges);
    texts:=[3]string.["{\"city\":\"oslo\",\"year\":1905,\"open\":true}","{\"city\":\"\",\"year\":2100,\"open\":false}","{\"city\":\"new york city\",\"year\":1950,\"open\":true}"];
    for x:texts {print("  % -> %\n",x,nx_accepts(g,x));}

    // The Tekken vocabulary subset, its trie and one mask row per state.
    v:NtRig;n:=nt_tekken(v.pieces[..],v.ids[..],v.store[..]);end:=n-1;
    r:=nt_build(v.pieces[..],v.byte[..],v.child[..],v.sibling[..],v.first[..],v.after[..]);
    masks:[64*NT_TEKKEN]u8;stack:[64]int;tm:=nt_table(r.trie,g,end,masks[..],stack[..]);
    walked:=0;for p:v.pieces[0..<n-1] {walked+=p.count;}
    print("vocabulary: % Tekken tokens, trie of % nodes\n",n,r.trie.nodes);
    print("table: % rows, % offers, % trie nodes visited (token walks would read up to % bytes)\n",s.states,tm.kept,tm.passes,walked*s.states);
    same:=0;brute:[NT_TEKKEN]u8;
    for st:0..<s.states {_:=nx_mask(g,st,v.pieces[..],end,brute[..],false);ok:=true;for i:0..<n {if brute[i]!=masks[st*NT_TEKKEN+i] {ok=false;}}if ok {same+=1;}}
    print("rows equal to token-by-token walks: % of %\n",same,s.states);
    show:=[3]string.["","{\"city\":\"new","{\"city\":\"oslo\",\"year\":19"];
    for x:show {
        st:=nx_walk(g,g.start,x);c:=0;for i:0..<n {c+=cast(int)masks[st*NT_TEKKEN+i];}
        print("after '%', offered %:",x,c);k:=0;
        for i:0..<n {if masks[st*NT_TEKKEN+i]==1 && k<6 {print(" '%'=%",v.pieces[i],v.ids[i]);k+=1;}}
        print("\n");
    }

    // Seeded runs: random logits over the whole subset, sampled through the masks.
    tree:[256]RsNode;words:[2048]u8;_:=rs_json(NT_SCHEMA,tree[..],words[..]);
    logits:[NT_TEKKEN]f32;p:[NT_TEKKEN]f64;sw:[NT_TEKKEN]f64;o:[NT_TEKKEN]int;tp:[NT_TEKKEN]int;wk:=NxWork.{stage=sw[..],order=o[..],temporary=tp[..]};
    for seed:1..<6 {
        for k:0..<n {logits[k]=cast(f32)(4*cr_draw(CrSeed.{seed=cast(u64)(900+seed),counter=cast(u64)k}).value);}
        run:=NxRun.{limit=64,random=CrSeed.{seed=cast(u64)seed}};st:=g.start;text:[256]u8;size:=0;
        while run.stop==NxStop.running {
            x:=nt_guided(logits[..],g,st,v.pieces[..],end,masks[..],NxOptions.{},run,false,p[..],wk,false);
            if x.token!=end {for c:v.pieces[x.token] {text[size]=c;size+=1;}}
            run=x.run;st=x.state;
        }
        out:=cast(string)text[0..<size];
        print("seed %: % (% tokens, %, parses: %, validates: %)\n",seed,out,run.emitted,run.stop,nx_accepts(g,out),os_accepts(tree[..],out));
    }

    // Broken schemas.
    bad:=[4]string.["{\"type\":\"string\",\"format\":\"date\"}","{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"null\"}},\"required\":[]}","{\"type\":\"number\"}","{\"type\":\"string\",\"pattern\":\"^[a-z]+$\"}"];
    for x:bad {f:=nx_schema(x,w);print("refused %: %, keyword '%'\n",x,f.why,f.keyword);}
}
// book:end example
