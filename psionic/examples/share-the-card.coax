// Chapter 30a's schedule for the 86-token sample in 800 MiB, the room left
// beside gpt-oss-20b on a 16 GB card. Nothing runs: the plan is data.
#import "Basic";
#load "../lib/device/plan.coax";
main :: () {
    ops:[2500]DpOp;stream:[277]bool;
    plan:=dp_plan(86,49,800*1048576,stream[..],ops[..]);
    #assert plan.status==DpStatus.ok;
    launches:=0;copies:=0;bytes:=0;last:=0;
    for i:0..<plan.ops {
        if ops[i].kind==DpOpKind.launch {launches+=1;}
        if ops[i].kind==DpOpKind.copy {copies+=1;bytes+=ops[i].args[0].count;last=i;}
    }
    print("operations: %, launches: %, copies: %\n",plan.ops,launches,copies);
    print("resident: % bytes, slots: 2 of % bytes, workspace: % bytes\n",plan.resident,plan.slot,plan.workspace);
    print("copied per decision: % bytes\n",bytes);
    print("first copies: weights % and %; last: weight %, bytes % to %\n",ops[0].tensor,ops[1].tensor,ops[last].tensor,ops[last].args[0].offset,ops[last].args[0].offset+ops[last].args[0].count);
    // Everything streams: only the vectors, the workspace and the slots stay.
    vectors:=0;for w:0..<DP_WEIGHTS {if !dp_weight_bf16(w) {vectors+=dp_align(dp_weight_bytes(w));}}
    least:=plan.workspace+vectors+2*plan.slot;
    print("smallest budget: % bytes; one byte less: %\n",least,dp_plan(86,49,least-1,stream[..],ops[..]).status);
}
