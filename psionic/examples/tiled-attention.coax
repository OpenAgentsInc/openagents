#import "Basic";
#load "../lib/tiled-attention.coax";

// book:begin example
main :: () {
    print("profile tiled-attention-cpu-f64-v1, tolerance % x (1 + largest |value|)\n",TA_TOLERANCE);
    // The hand trace: one head of width 1, query 1, keys 1 0 | 3 3, values 2 4 | 6 8.
    q:=[1]f32.[1];tk:=[2]f64.[1,0];tv:=[2]f64.[2,4];scores:[2]f64;first:[3]f64;second:[3]f64;running:[3]f64;
    #assert ta_partial(1,q[..],tk[..],tv[..],0,2,TaMask.{},3,scores[..],first[..])==0;
    print("tile 1: maximum %, denominator %, value sum %\n",first[0],first[1],first[2]);
    tk[0]=3;tk[1]=3;tv[0]=6;tv[1]=8;
    #assert ta_partial(1,q[..],tk[..],tv[..],2,2,TaMask.{},3,scores[..],second[..])==0;
    print("tile 2: maximum %, denominator %, value sum %\n",second[0],second[1],second[2]);
    #assert !ta_merge(running[..],first[..]);moved:=ta_merge(running[..],second[..]);
    print("merged: maximum moved %, rescale %, denominator %, value sum %\n",moved,exp(first[0]-second[0]),running[1],running[2]);
    s:=TaShape.{heads=1,kv_heads=1,head_dim=1,tile=2};k:=[4]f32.[1,0,3,3];v:=[4]f32.[2,4,6,8];out:=[1]f32.[-7];work:[64]f64;
    r:=ta_attend(s,TaMask.{},3,1,4,q[..],k[..],v[..],q[0..<0],out[..],work[..],false);
    #assert r.status==TaStatus.ok;
    print("output %, tile loads %, rescales %\n",out[0],r.loads,r.rescales);

    print("chapter 12 dense attention, causal, window 3 and decision block 6: largest difference %\n",to_qwen_deviation());
    print("chapter 62 sinks, full and window 4: largest difference %\n",to_gpt_deviation());

    // Chunked prefill and split-K decode on chapter 62's rotated rows.
    g:=to_gpt(4);m:=to_gpt_mask(4);big:[8192]f64;whole:[1024]f32;chunked:[1024]f32;
    t:=TaShape.{heads=2,kv_heads=1,head_dim=64,tile=3};
    #assert ta_attend(t,m,0,8,8,g.q[..],g.k[..],g.v[..],g.sinks[..],whole[..],big[..],false).status==TaStatus.ok;
    cuts:=[4]int.[0,3,6,8];
    for c:0..<3 {a:=cuts[c];b:=cuts[c+1];#assert ta_attend(t,m,a,b-a,b,g.q[a*128..<b*128],g.k[0..<b*64],g.v[0..<b*64],g.sinks[..],chunked[a*128..<b*128],big[..],false).status==TaStatus.ok;}
    print("chunked prefill 3 + 3 + 2 equals whole prefill bit for bit: %\n",to_same(whole[..],chunked[..]));
    t.tile=1;one:[128]f32;split:[128]f32;
    #assert ta_attend(t,TaMask.{},7,1,8,g.q[896..<1024],g.k[..],g.v[..],g.sinks[..],one[..],big[..],false).status==TaStatus.ok;
    print("split-K decode, causal, at position 7 in 8 tiles of one key:\n");
    for splits:1..<9 {
        r=ta_decode_split(t,TaMask.{},8,splits,g.q[896..<1024],g.k[..],g.v[..],g.sinks[..],split[..],big[..],false);
        #assert r.status==TaStatus.ok;
        worst:=0.0;for i:0..<128 {d:=abs(f64(split[i])-f64(one[i]));if d>worst {worst=d;}}
        print("  % splits: bit for bit %, largest difference %, rescales %\n",splits,to_same(one[..],split[..]),worst,r.rescales);
    }

    print("tile loads, 16 rows, 2 key/value heads, 16 keys in tiles of 4:\n");
    zq:[256]f32;zk:[64]f32;zo:[256]f32;
    for gi:0..<3 {
        group:=1<<gi;u:=TaShape.{heads=2*group,kv_heads=2,head_dim=2,tile=4};
        r=ta_attend(u,TaMask.{},0,16,16,zq[0..<64*group],zk[..],zk[..],zq[0..<0],zo[0..<64*group],big[..],false);
        print("  % query heads: % loads; one copy per query head would be %\n",2*group,r.loads,2*group*4);
    }

    print("work for 64-row chunks, 8 heads over 2 key/value heads, width 64, tiles of 32 (f64 elements):\n");
    w:=TaShape.{heads=8,kv_heads=2,head_dim=64,tile=32};
    for e:0..<4 {tokens:=512<<e;
        p:=ta_plan(w,64,tokens,0);
        print("  % tokens: tiled work %; a full score matrix would hold %\n",tokens,p.work,8*tokens*tokens);
    }

    out[0]=-7;
    r=ta_attend(s,TaMask.{kind=TaMaskKind.decision,block=5},3,1,4,q[..],k[..],v[..],q[0..<0],out[..],work[..],false);
    print("refused: decision block 5 past 4 keys: %, output %\n",r.status,out[0]);
    bits:u32=0x7f000000;bits+=0x00800000;k[1]=f32_from_bits(bits);
    r=ta_attend(s,TaMask.{},3,1,4,q[..],k[..],v[..],q[0..<0],out[..],work[..],false);
    print("refused: an infinite key: %, output %\n",r.status,out[0]);
}
// book:end example
