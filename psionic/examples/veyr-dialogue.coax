// Offline replay of real held-out writing-model replies, not live inference.
#import "Basic";
#load "../../verse/characters/veyr-v2.coax";
#load "../fixtures/verse-villain/dialogue.coax";

// book:begin example
main :: () {
    print("%\nAuthored fallback: %\n",VEYR_V2.name,VEYR_V2.greet);
    for i:[3]int.[1,3,6] {
        print("Recorded held-out reply %: %\n",i+6,VEYR_RECORDED[i]);
    }
    print("Fresh dialogue: coax/web/tool.sh psionic/tools/villain-text.coax ask 'PLAYER QUESTION'\n");
}
// book:end example
