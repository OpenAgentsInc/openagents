    bytes:[8192]u8;for j:0..<8192 {bytes[j]=165;}e:=de_fixture_0(bytes[..]);
    #assert e.gate.data.count==1024;for j:0..<1024 {#assert e.gate.data[j]==DEG_0_GATE_DATA[j];}
    #assert e.gate.scales.count==64;for j:0..<64 {#assert e.gate.scales[j]==DEG_0_GATE_SCALES[j];}
    #assert e.up.data.count==1024;for j:0..<1024 {#assert e.up.data[j]==DEG_0_UP_DATA[j];}
    #assert e.up.scales.count==64;for j:0..<64 {#assert e.up.scales[j]==DEG_0_UP_SCALES[j];}
    #assert e.down.data.count==1024;for j:0..<1024 {#assert e.down.data[j]==DEG_0_DOWN_DATA[j];}
    #assert e.down.scales.count==64;for j:0..<64 {#assert e.down.scales[j]==DEG_0_DOWN_SCALES[j];}
}
