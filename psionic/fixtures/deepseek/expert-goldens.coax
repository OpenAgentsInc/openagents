#test "complete quantized expert 0 matches independent pre-down weighted FFN" {
    bytes:[8192]u8;for j:0..<8192 {bytes[j]=165;}e:=de_fixture_0(bytes[..]);x:=DEG_INPUT;work:[512]f32;wide:[64]f64;out:[65]f32;out[64]=7;
    r:=de_expert(e,x[..],0.137f32,10,out[..],DeWork.{floats=work[..],wide=wide[..]},false);#assert r.status==DsStatus.ok && r.written==64 && out[64]==7;
    #assert r.gate_clamped==4 && r.up_clamped==10;
    for j:0..<64 {#assert abs(out[j]-DEG_0_OUTPUT[j])<=0.00002f32+0.000001f32*abs(DEG_0_OUTPUT[j]);}
}
