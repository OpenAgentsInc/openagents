de_fixture_0 :: (bytes:[]u8)->DeExpert {
for j:0..<1024 {bytes[0+j]=DEG_0_GATE_DATA[j];}
for j:0..<64 {bytes[1024+j]=DEG_0_GATE_SCALES[j];}
for j:0..<1024 {bytes[1088+j]=DEG_0_UP_DATA[j];}
for j:0..<64 {bytes[2112+j]=DEG_0_UP_SCALES[j];}
for j:0..<1024 {bytes[2176+j]=DEG_0_DOWN_DATA[j];}
for j:0..<64 {bytes[3200+j]=DEG_0_DOWN_SCALES[j];}
return DeExpert.{gate=DeMatrix.{kind=DeKind.fp4,rows=32,columns=64,data=bytes[0..<1024],scales=bytes[1024..<1088]},up=DeMatrix.{kind=DeKind.fp4,rows=32,columns=64,data=bytes[1088..<2112],scales=bytes[2112..<2176]},down=DeMatrix.{kind=DeKind.fp4,rows=64,columns=32,data=bytes[2176..<3200],scales=bytes[3200..<3264]}};}
