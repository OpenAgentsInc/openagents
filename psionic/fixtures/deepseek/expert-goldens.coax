#test "expert activation grid 0 matches independent codes scales and wide values" {
    x:=DEG_QUANT_0_INPUT;out:[65]f64;stage:[64]f64;out[64]=7;
    r:=de_quantize(x[..],out[0..<64],stage[..],false);#assert r.status==DsStatus.ok && r.written==64 && out[64]==7;
    for j:0..<64 {#assert f64_bits(out[j])==f64_bits(DEG_QUANT_0_VALUES[j]);}
    for block:0..<2 {s:=de_scale(x[32*block..<32*(block+1)]);#assert s.status==DsStatus.ok && s.code==DEG_QUANT_0_SCALES[block];}
}
