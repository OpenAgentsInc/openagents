#test "hyper split ordinary matches independent Decimal 20-iteration reference" {
    r:=dh_split(DHG_SPLIT_0_MIXES,DHG_SPLIT_0_SCALE,DHG_SPLIT_0_BASE);#assert r.status==DsStatus.ok;
    for j:0..<4 {#assert abs(r.mix.pre[j]-DHG_SPLIT_0_PRE[j])<0.00000012f32 && abs(r.mix.post[j]-DHG_SPLIT_0_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r.mix.comb[j]-DHG_SPLIT_0_COMB[j])<0.00000012f32;}
}
#test "hyper split slow matches independent Decimal 20-iteration reference" {
    r:=dh_split(DHG_SPLIT_1_MIXES,DHG_SPLIT_1_SCALE,DHG_SPLIT_1_BASE);#assert r.status==DsStatus.ok;
    for j:0..<4 {#assert abs(r.mix.pre[j]-DHG_SPLIT_1_PRE[j])<0.00000012f32 && abs(r.mix.post[j]-DHG_SPLIT_1_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r.mix.comb[j]-DHG_SPLIT_1_COMB[j])<0.00000012f32;}
}
#test "hyper split saturated matches independent Decimal 20-iteration reference" {
    r:=dh_split(DHG_SPLIT_2_MIXES,DHG_SPLIT_2_SCALE,DHG_SPLIT_2_BASE);#assert r.status==DsStatus.ok;
    for j:0..<4 {#assert abs(r.mix.pre[j]-DHG_SPLIT_2_PRE[j])<0.00000012f32 && abs(r.mix.post[j]-DHG_SPLIT_2_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r.mix.comb[j]-DHG_SPLIT_2_COMB[j])<0.00000012f32;}
}
#test "six hyper subblocks use previous pre-mix and preserve the complete temporal carry" {
    state:=DHG_CHAIN_0_INPUT;carry:=dh_initial();collapsed:[3]f32;out:[12]f32;work:[12]f32;
    w0:=DHG_CHAIN_0_PROJECTION;
    r0:=dh_prepare(3,state[..],carry,DhWeights.{projection=w0[..],scale=DHG_CHAIN_0_SCALE,base=DHG_CHAIN_0_BASE},collapsed[..],work[0..<3],false);#assert r0.status==DsStatus.ok;
    for j:0..<3 {#assert abs(collapsed[j]-DHG_CHAIN_0_COLLAPSED[j])<0.000001f32;}
    for j:0..<4 {#assert abs(r0.mix.pre[j]-DHG_CHAIN_0_PRE[j])<0.00000012f32 && abs(r0.mix.post[j]-DHG_CHAIN_0_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r0.mix.comb[j]-DHG_CHAIN_0_COMB[j])<0.00000012f32;}
    y0:[3]f32;for j:0..<3 {y0[j]=collapsed[j]*0.75f32+0.0625f32;}
    f0:=dh_finish(3,state[..],y0[..],r0.mix,out[..],work[..],false);#assert f0.status==DsStatus.ok && f0.written==12;
    for j:0..<12 {#assert abs(out[j]-DHG_CHAIN_0_OUTPUT[j])<0.000002f32;}
    for j:0..<4 {#assert f0.carry.pre[j]==r0.mix.pre[j];}
    state=out;carry=f0.carry;
    w1:=DHG_CHAIN_1_PROJECTION;
    r1:=dh_prepare(3,state[..],carry,DhWeights.{projection=w1[..],scale=DHG_CHAIN_1_SCALE,base=DHG_CHAIN_1_BASE},collapsed[..],work[0..<3],false);#assert r1.status==DsStatus.ok;
    for j:0..<3 {#assert abs(collapsed[j]-DHG_CHAIN_1_COLLAPSED[j])<0.000001f32;}
    for j:0..<4 {#assert abs(r1.mix.pre[j]-DHG_CHAIN_1_PRE[j])<0.00000012f32 && abs(r1.mix.post[j]-DHG_CHAIN_1_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r1.mix.comb[j]-DHG_CHAIN_1_COMB[j])<0.00000012f32;}
    y1:[3]f32;for j:0..<3 {y1[j]=collapsed[j]*0.75f32+0.125f32;}
    f1:=dh_finish(3,state[..],y1[..],r1.mix,out[..],work[..],false);#assert f1.status==DsStatus.ok && f1.written==12;
    for j:0..<12 {#assert abs(out[j]-DHG_CHAIN_1_OUTPUT[j])<0.000002f32;}
    for j:0..<4 {#assert f1.carry.pre[j]==r1.mix.pre[j];}
    state=out;carry=f1.carry;
    w2:=DHG_CHAIN_2_PROJECTION;
    r2:=dh_prepare(3,state[..],carry,DhWeights.{projection=w2[..],scale=DHG_CHAIN_2_SCALE,base=DHG_CHAIN_2_BASE},collapsed[..],work[0..<3],false);#assert r2.status==DsStatus.ok;
    for j:0..<3 {#assert abs(collapsed[j]-DHG_CHAIN_2_COLLAPSED[j])<0.000001f32;}
    for j:0..<4 {#assert abs(r2.mix.pre[j]-DHG_CHAIN_2_PRE[j])<0.00000012f32 && abs(r2.mix.post[j]-DHG_CHAIN_2_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r2.mix.comb[j]-DHG_CHAIN_2_COMB[j])<0.00000012f32;}
    y2:[3]f32;for j:0..<3 {y2[j]=collapsed[j]*0.75f32+0.1875f32;}
    f2:=dh_finish(3,state[..],y2[..],r2.mix,out[..],work[..],false);#assert f2.status==DsStatus.ok && f2.written==12;
    for j:0..<12 {#assert abs(out[j]-DHG_CHAIN_2_OUTPUT[j])<0.000002f32;}
    for j:0..<4 {#assert f2.carry.pre[j]==r2.mix.pre[j];}
    state=out;carry=f2.carry;
    w3:=DHG_CHAIN_3_PROJECTION;
    r3:=dh_prepare(3,state[..],carry,DhWeights.{projection=w3[..],scale=DHG_CHAIN_3_SCALE,base=DHG_CHAIN_3_BASE},collapsed[..],work[0..<3],false);#assert r3.status==DsStatus.ok;
    for j:0..<3 {#assert abs(collapsed[j]-DHG_CHAIN_3_COLLAPSED[j])<0.000001f32;}
    for j:0..<4 {#assert abs(r3.mix.pre[j]-DHG_CHAIN_3_PRE[j])<0.00000012f32 && abs(r3.mix.post[j]-DHG_CHAIN_3_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r3.mix.comb[j]-DHG_CHAIN_3_COMB[j])<0.00000012f32;}
    y3:[3]f32;for j:0..<3 {y3[j]=collapsed[j]*0.75f32+0.25f32;}
    f3:=dh_finish(3,state[..],y3[..],r3.mix,out[..],work[..],false);#assert f3.status==DsStatus.ok && f3.written==12;
    for j:0..<12 {#assert abs(out[j]-DHG_CHAIN_3_OUTPUT[j])<0.000002f32;}
    for j:0..<4 {#assert f3.carry.pre[j]==r3.mix.pre[j];}
    state=out;carry=f3.carry;
    w4:=DHG_CHAIN_4_PROJECTION;
    r4:=dh_prepare(3,state[..],carry,DhWeights.{projection=w4[..],scale=DHG_CHAIN_4_SCALE,base=DHG_CHAIN_4_BASE},collapsed[..],work[0..<3],false);#assert r4.status==DsStatus.ok;
    for j:0..<3 {#assert abs(collapsed[j]-DHG_CHAIN_4_COLLAPSED[j])<0.000001f32;}
    for j:0..<4 {#assert abs(r4.mix.pre[j]-DHG_CHAIN_4_PRE[j])<0.00000012f32 && abs(r4.mix.post[j]-DHG_CHAIN_4_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r4.mix.comb[j]-DHG_CHAIN_4_COMB[j])<0.00000012f32;}
    y4:[3]f32;for j:0..<3 {y4[j]=collapsed[j]*0.75f32+0.3125f32;}
    f4:=dh_finish(3,state[..],y4[..],r4.mix,out[..],work[..],false);#assert f4.status==DsStatus.ok && f4.written==12;
    for j:0..<12 {#assert abs(out[j]-DHG_CHAIN_4_OUTPUT[j])<0.000002f32;}
    for j:0..<4 {#assert f4.carry.pre[j]==r4.mix.pre[j];}
    state=out;carry=f4.carry;
    w5:=DHG_CHAIN_5_PROJECTION;
    r5:=dh_prepare(3,state[..],carry,DhWeights.{projection=w5[..],scale=DHG_CHAIN_5_SCALE,base=DHG_CHAIN_5_BASE},collapsed[..],work[0..<3],false);#assert r5.status==DsStatus.ok;
    for j:0..<3 {#assert abs(collapsed[j]-DHG_CHAIN_5_COLLAPSED[j])<0.000001f32;}
    for j:0..<4 {#assert abs(r5.mix.pre[j]-DHG_CHAIN_5_PRE[j])<0.00000012f32 && abs(r5.mix.post[j]-DHG_CHAIN_5_POST[j])<0.00000024f32;}
    for j:0..<16 {#assert abs(r5.mix.comb[j]-DHG_CHAIN_5_COMB[j])<0.00000012f32;}
    y5:[3]f32;for j:0..<3 {y5[j]=collapsed[j]*0.75f32+0.375f32;}
    f5:=dh_finish(3,state[..],y5[..],r5.mix,out[..],work[..],false);#assert f5.status==DsStatus.ok && f5.written==12;
    for j:0..<12 {#assert abs(out[j]-DHG_CHAIN_5_OUTPUT[j])<0.000002f32;}
    for j:0..<4 {#assert f5.carry.pre[j]==r5.mix.pre[j];}
    state=out;carry=f5.carry;
    head:=dh_collapse(3,state[..],carry,collapsed[..],work[0..<3],false);#assert head.status==DsStatus.ok && head.written==3;
    for j:0..<3 {#assert abs(collapsed[j]-DHG_FINAL_COLLAPSED[j])<0.000002f32;}
}
