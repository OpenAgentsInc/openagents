#test "MLA compressed matches independent full-prefix expansion and continuation" {
    s:=MlShape.{heads=2,nope=2,rope=2,value=2,latent=3,capacity=5};w:=MLG_WEIGHTS;q:=MLG_QUERIES;z:=MLG_LATENTS;pe:=MLG_PE;
    history:[25]f32;out:[5]f32;row:[6]f32;work:[64]f32;scores:[10]f64;out[4]=-7;row[5]=-9;
    r0:=ml_attention(s,MlMode.compressed,w[..],q[0..<8],z[0..<3],pe[0..<2],history[0..<0],0,0.375,out[..],row[..],work[..],scores[..],false);
    #assert r0.status==DsStatus.ok && r0.written==4 && r0.row_written==5;
    for j:0..<4 {#assert abs(out[j]-MLG_COMPRESSED_OUTPUTS0[j])<0.0000002f32;}
    for j:0..<5 {#assert row[j]==MLG_COMPRESSED_ROWS0[j];history[0+j]=row[j];}
    for j:0..<2 {#assert abs(scores[j]-MLG_COMPRESSED_SCORES0[j])<1e-13;}
    r1:=ml_attention(s,MlMode.compressed,w[..],q[8..<16],z[3..<6],pe[2..<4],history[0..<5],1,0.375,out[..],row[..],work[..],scores[..],false);
    #assert r1.status==DsStatus.ok && r1.written==4 && r1.row_written==5;
    for j:0..<4 {#assert abs(out[j]-MLG_COMPRESSED_OUTPUTS1[j])<0.0000002f32;}
    for j:0..<5 {#assert row[j]==MLG_COMPRESSED_ROWS1[j];history[5+j]=row[j];}
    for j:0..<4 {#assert abs(scores[j]-MLG_COMPRESSED_SCORES1[j])<1e-13;}
    r2:=ml_attention(s,MlMode.compressed,w[..],q[16..<24],z[6..<9],pe[4..<6],history[0..<10],2,0.375,out[..],row[..],work[..],scores[..],false);
    #assert r2.status==DsStatus.ok && r2.written==4 && r2.row_written==5;
    for j:0..<4 {#assert abs(out[j]-MLG_COMPRESSED_OUTPUTS2[j])<0.0000002f32;}
    for j:0..<5 {#assert row[j]==MLG_COMPRESSED_ROWS2[j];history[10+j]=row[j];}
    for j:0..<6 {#assert abs(scores[j]-MLG_COMPRESSED_SCORES2[j])<1e-13;}
    r3:=ml_attention(s,MlMode.compressed,w[..],q[24..<32],z[9..<12],pe[6..<8],history[0..<15],3,0.375,out[..],row[..],work[..],scores[..],false);
    #assert r3.status==DsStatus.ok && r3.written==4 && r3.row_written==5;
    for j:0..<4 {#assert abs(out[j]-MLG_COMPRESSED_OUTPUTS3[j])<0.0000002f32;}
    for j:0..<5 {#assert row[j]==MLG_COMPRESSED_ROWS3[j];history[15+j]=row[j];}
    for j:0..<8 {#assert abs(scores[j]-MLG_COMPRESSED_SCORES3[j])<1e-13;}
    #assert out[4]==-7 && row[5]==-9;
}
#test "MLA expanded matches independent full-prefix expansion and continuation" {
