    #assert r.status==DrStatus.ok && r.experts==3 && r.profile==DrProfile.v41 && r.count==2 && r.group_count==1;
    for i:0..<2 {#assert r.ids[i]==DRG_12_IDS[i] && abs(r.weights[i]-DRG_12_WEIGHTS[i])<=1e-12*abs(DRG_12_WEIGHTS[i])+1e-300;}
    for i:0..<3 {#assert abs(scores[i]-DRG_12_SCORES[i])<=1e-12*abs(DRG_12_SCORES[i])+1e-300 && abs(ranked[i]-DRG_12_RANKED[i])<=1e-12*abs(DRG_12_RANKED[i])+1e-300;}
    for i:0..<1 {#assert r.groups[i]==DRG_12_GROUPS[i];}
    #assert r.has_margin==true && r.excluded==1 && abs(r.cutoff-0.8325546111576978)<=1e-12*abs(0.8325546111576978)+1e-300 && abs(r.runner-0.0)<=1e-12*abs(0.0)+1e-300 && abs(r.margin-0.8325546111576978)<=8.325546111576978e-13;
    #assert r.has_group_margin==false && r.group_excluded==-1 && abs(r.group_margin-0.0)<=0.0;
    #assert scores[3]==-7 && ranked[3]==-9;
}
