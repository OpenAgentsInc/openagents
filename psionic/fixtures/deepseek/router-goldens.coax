#test "independent router oracle: group ties choose lowest group and expert IDs" {
    x:=DRG_7_X;bias:=DRG_7_BIAS;scores:[17]f64;ranked:[17]f64;scores[16]=-7;ranked[16]=-9;
    r:=dr_route(DrConfig.{profile=DrProfile.v3,k=4,groups=8,selected_groups=2,scale=1.0},x[..],bias[0..<16],scores[..],ranked[..],false);
    #assert r.status==DrStatus.ok && r.experts==16 && r.profile==DrProfile.v3 && r.count==4 && r.group_count==2;
    for i:0..<4 {#assert r.ids[i]==DRG_7_IDS[i] && abs(r.weights[i]-DRG_7_WEIGHTS[i])<=1e-12*abs(DRG_7_WEIGHTS[i])+1e-300;}
