    #assert r.has_margin==false && r.excluded==-1 && abs(r.cutoff-0.5)<=1e-12*abs(0.5)+1e-300 && abs(r.runner-0.0)<=1e-12*abs(0.0)+1e-300 && abs(r.margin-0.0)<=5e-13;
    #assert r.has_group_margin==true && r.group_excluded==2 && abs(r.group_margin-0.0)<=2e-12;
    #assert scores[16]==-7 && ranked[16]==-9;
}
