DRG_1_WEIGHTS :: [8]f64.[0.3191342571988992,0.3157836661066968,0.31229343437384205,0.3191342571988992,0.30488780820630373,0.3191342571988992,0.3009704269184233,0.30866189279803646];
DRG_1_IDS :: [8]int.[236,154,72,183,226,130,144,255];
DRG_1_GROUPS :: [4]int.[7,4,2,5];
#test "independent router oracle: V3 original grouped dimensions" {
    x:=DRG_1_X;bias:=DRG_1_BIAS;scores:[257]f64;ranked:[257]f64;scores[256]=-7;ranked[256]=-9;
    r:=dr_route(DrConfig.{profile=DrProfile.v3,k=8,groups=8,selected_groups=4,scale=2.5},x[..],bias[0..<256],scores[..],ranked[..],false);
    #assert r.status==DrStatus.ok && r.experts==256 && r.profile==DrProfile.v3 && r.count==8 && r.group_count==4;
    for i:0..<8 {#assert r.ids[i]==DRG_1_IDS[i] && abs(r.weights[i]-DRG_1_WEIGHTS[i])<=1e-12*abs(DRG_1_WEIGHTS[i])+1e-300;}
    for i:0..<256 {#assert abs(scores[i]-DRG_1_SCORES[i])<=1e-12*abs(DRG_1_SCORES[i])+1e-300 && abs(ranked[i]-DRG_1_RANKED[i])<=1e-12*abs(DRG_1_RANKED[i])+1e-300;}
    for i:0..<4 {#assert r.groups[i]==DRG_1_GROUPS[i];}
    #assert r.has_margin==true && r.excluded==173 && abs(r.cutoff-0.8315047135527632)<=1e-12*abs(0.8315047135527632)+1e-300 && abs(r.runner-0.8294367777396212)<=1e-12*abs(0.8294367777396212)+1e-300 && abs(r.margin-0.002067935813142019)<=1.6609414912923842e-12;
    #assert r.has_group_margin==true && r.group_excluded==1 && abs(r.group_margin-0.0062211595976935374)<=3.4017444700884226e-12;
    #assert scores[256]==-7 && ranked[256]==-9;
