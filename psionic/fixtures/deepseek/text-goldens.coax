// Independently authored original-regex span and heap-merge vectors.
#test "DeepSeek independent regex spans 0" {table:=PT_TOY;t:=pt_layout(table[..]);text:="Hi";at:=0;
#assert ds_piece(table[..],t,text,at)==2;at=2;
}
#test "DeepSeek independent regex spans 1" {table:=PT_TOY;t:=pt_layout(table[..]);text:="ababa hello's";at:=0;
#assert ds_piece(table[..],t,text,at)==5;at=5;
#assert ds_piece(table[..],t,text,at)==11;at=11;
#assert ds_piece(table[..],t,text,at)==13;at=13;
}
#test "DeepSeek independent regex spans 2" {table:=PT_TOY;t:=pt_layout(table[..]);text:="a\nb";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==2;at=2;
#assert ds_piece(table[..],t,text,at)==3;at=3;
}
#test "DeepSeek independent regex spans 3" {table:=PT_TOY;t:=pt_layout(table[..]);text:="a\rb";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==2;at=2;
#assert ds_piece(table[..],t,text,at)==3;at=3;
}
#test "DeepSeek independent regex spans 4" {table:=PT_TOY;t:=pt_layout(table[..]);text:=" \t \nx";at:=0;
#assert ds_piece(table[..],t,text,at)==4;at=4;
#assert ds_piece(table[..],t,text,at)==5;at=5;
}
#test "DeepSeek independent regex spans 5" {table:=PT_TOY;t:=pt_layout(table[..]);text:=" \t x";at:=0;
#assert ds_piece(table[..],t,text,at)==2;at=2;
#assert ds_piece(table[..],t,text,at)==4;at=4;
}
#test "DeepSeek independent regex spans 6" {table:=PT_TOY;t:=pt_layout(table[..]);text:="a b";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==3;at=3;
}
#test "DeepSeek independent regex spans 7" {table:=PT_TOY;t:=pt_layout(table[..]);text:="  hello";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==7;at=7;
}
#test "DeepSeek independent regex spans 8" {table:=PT_TOY;t:=pt_layout(table[..]);text:="!!!\r\n";at:=0;
#assert ds_piece(table[..],t,text,at)==5;at=5;
}
#test "DeepSeek independent regex spans 9" {table:=PT_TOY;t:=pt_layout(table[..]);text:="1234567890";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==2;at=2;
#assert ds_piece(table[..],t,text,at)==3;at=3;
#assert ds_piece(table[..],t,text,at)==4;at=4;
#assert ds_piece(table[..],t,text,at)==5;at=5;
#assert ds_piece(table[..],t,text,at)==6;at=6;
#assert ds_piece(table[..],t,text,at)==7;at=7;
#assert ds_piece(table[..],t,text,at)==8;at=8;
#assert ds_piece(table[..],t,text,at)==9;at=9;
#assert ds_piece(table[..],t,text,at)==10;at=10;
}
#test "DeepSeek independent regex spans 10" {table:=PT_TOY;t:=pt_layout(table[..]);text:="'RE 've 'll 'm 'd 't 's";at:=0;
#assert ds_piece(table[..],t,text,at)==3;at=3;
#assert ds_piece(table[..],t,text,at)==5;at=5;
#assert ds_piece(table[..],t,text,at)==7;at=7;
#assert ds_piece(table[..],t,text,at)==9;at=9;
#assert ds_piece(table[..],t,text,at)==11;at=11;
#assert ds_piece(table[..],t,text,at)==13;at=13;
#assert ds_piece(table[..],t,text,at)==14;at=14;
#assert ds_piece(table[..],t,text,at)==16;at=16;
#assert ds_piece(table[..],t,text,at)==17;at=17;
#assert ds_piece(table[..],t,text,at)==19;at=19;
#assert ds_piece(table[..],t,text,at)==20;at=20;
#assert ds_piece(table[..],t,text,at)==22;at=22;
#assert ds_piece(table[..],t,text,at)==23;at=23;
}
#test "DeepSeek independent regex spans 11" {table:=PT_TOY;t:=pt_layout(table[..]);text:="é ä́";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==3;at=3;
#assert ds_piece(table[..],t,text,at)==5;at=5;
#assert ds_piece(table[..],t,text,at)==9;at=9;
}
#test "DeepSeek independent regex spans 12" {table:=PT_TOY;t:=pt_layout(table[..]);text:="'ſauce";at:=0;
#assert ds_piece(table[..],t,text,at)==3;at=3;
#assert ds_piece(table[..],t,text,at)==7;at=7;
}
#test "DeepSeek independent regex spans 13" {table:=PT_TOY;t:=pt_layout(table[..]);text:="\nhello\rworld";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==6;at=6;
#assert ds_piece(table[..],t,text,at)==7;at=7;
#assert ds_piece(table[..],t,text,at)==12;at=12;
}
#test "DeepSeek independent regex spans 14" {table:=PT_TOY;t:=pt_layout(table[..]);text:="b̈y";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==4;at=4;
}
#test "DeepSeek independent regex spans 15" {table:=PT_TOY;t:=pt_layout(table[..]);text:="!? a! 123";at:=0;
#assert ds_piece(table[..],t,text,at)==2;at=2;
#assert ds_piece(table[..],t,text,at)==4;at=4;
#assert ds_piece(table[..],t,text,at)==5;at=5;
#assert ds_piece(table[..],t,text,at)==6;at=6;
#assert ds_piece(table[..],t,text,at)==7;at=7;
#assert ds_piece(table[..],t,text,at)==8;at=8;
#assert ds_piece(table[..],t,text,at)==9;at=9;
}
#test "DeepSeek independent regex spans 16" {table:=PT_TOY;t:=pt_layout(table[..]);text:="  \t  ";at:=0;
#assert ds_piece(table[..],t,text,at)==5;at=5;
}
#test "DeepSeek independent regex spans 17" {table:=PT_TOY;t:=pt_layout(table[..]);text:="a\n\rb";at:=0;
#assert ds_piece(table[..],t,text,at)==1;at=1;
#assert ds_piece(table[..],t,text,at)==3;at=3;
#assert ds_piece(table[..],t,text,at)==4;at=4;
}
#test "DeepSeek independent regex spans 18" {table:=PT_TOY;t:=pt_layout(table[..]);text:="\r\na\nb";at:=0;
#assert ds_piece(table[..],t,text,at)==2;at=2;
#assert ds_piece(table[..],t,text,at)==3;at=3;
#assert ds_piece(table[..],t,text,at)==4;at=4;
#assert ds_piece(table[..],t,text,at)==5;at=5;
}
#test "DeepSeek independent regex spans 19" {table:=PT_TOY;t:=pt_layout(table[..]);text:=" hello";at:=0;
#assert ds_piece(table[..],t,text,at)==7;at=7;
}
#test "DeepSeek independent heap BPE 0" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==0 && r.work==0;}
#test "DeepSeek independent heap BPE 1" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"Hi",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==2 && r.work==4;#assert out[0]==72;#assert out[1]==105;}
#test "DeepSeek independent heap BPE 2" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"ababa hello's",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==4 && r.work==65;#assert out[0]==256;#assert out[1]==257;#assert out[2]==262;#assert out[3]==263;}
#test "DeepSeek independent heap BPE 3" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"a\nb",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==3 && r.work==3;#assert out[0]==97;#assert out[1]==10;#assert out[2]==98;}
#test "DeepSeek independent heap BPE 4" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"a\rb",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==3 && r.work==3;#assert out[0]==97;#assert out[1]==13;#assert out[2]==98;}
#test "DeepSeek independent heap BPE 5" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..]," \t \nx",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==5 && r.work==17;#assert out[0]==32;#assert out[1]==9;#assert out[2]==32;#assert out[3]==10;#assert out[4]==120;}
#test "DeepSeek independent heap BPE 6" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..]," \t x",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==4 && r.work==8;#assert out[0]==32;#assert out[1]==9;#assert out[2]==32;#assert out[3]==120;}
#test "DeepSeek independent heap BPE 7" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"a b",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==3 && r.work==5;#assert out[0]==97;#assert out[1]==32;#assert out[2]==98;}
#test "DeepSeek independent heap BPE 8" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"  hello",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==2 && r.work==37;#assert out[0]==32;#assert out[1]==262;}
#test "DeepSeek independent heap BPE 9" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"!!!\r\n",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==5 && r.work==25;#assert out[0]==33;#assert out[1]==33;#assert out[2]==33;#assert out[3]==13;#assert out[4]==10;}
#test "DeepSeek independent heap BPE 10" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"1234567890",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==10 && r.work==10;#assert out[0]==49;#assert out[1]==50;#assert out[2]==51;#assert out[3]==52;#assert out[4]==53;#assert out[5]==54;#assert out[6]==55;#assert out[7]==56;#assert out[8]==57;#assert out[9]==48;}
#test "DeepSeek independent heap BPE 11" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"'RE 've 'll 'm 'd 't 's",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==23 && r.work==45;#assert out[0]==39;#assert out[1]==82;#assert out[2]==69;#assert out[3]==32;#assert out[4]==39;#assert out[5]==118;#assert out[6]==101;#assert out[7]==32;#assert out[8]==39;#assert out[9]==108;#assert out[10]==108;#assert out[11]==32;#assert out[12]==39;#assert out[13]==109;#assert out[14]==32;#assert out[15]==39;#assert out[16]==100;#assert out[17]==32;#assert out[18]==39;#assert out[19]==116;#assert out[20]==32;#assert out[21]==39;#assert out[22]==115;}
#test "DeepSeek independent heap BPE 12" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"é ä́",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==7 && r.work==17;#assert out[0]==195;#assert out[1]==169;#assert out[2]==32;#assert out[3]==195;#assert out[4]==164;#assert out[5]==204;#assert out[6]==129;}
#test "DeepSeek independent heap BPE 13" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"'ſauce",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==7 && r.work==25;#assert out[0]==39;#assert out[1]==197;#assert out[2]==191;#assert out[3]==97;#assert out[4]==117;#assert out[5]==99;#assert out[6]==101;}
#test "DeepSeek independent heap BPE 14" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"\nhello\rworld",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==8 && r.work==52;#assert out[0]==10;#assert out[1]==261;#assert out[2]==13;#assert out[3]==119;#assert out[4]==111;#assert out[5]==114;#assert out[6]==108;#assert out[7]==100;}
#test "DeepSeek independent heap BPE 15" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"b̈y",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==4 && r.work==10;#assert out[0]==98;#assert out[1]==204;#assert out[2]==136;#assert out[3]==121;}
#test "DeepSeek independent heap BPE 16" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"!? a! 123",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==9 && r.work==13;#assert out[0]==33;#assert out[1]==63;#assert out[2]==32;#assert out[3]==97;#assert out[4]==33;#assert out[5]==32;#assert out[6]==49;#assert out[7]==50;#assert out[8]==51;}
#test "DeepSeek independent heap BPE 17" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"  \t  ",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==5 && r.work==25;#assert out[0]==32;#assert out[1]==32;#assert out[2]==9;#assert out[3]==32;#assert out[4]==32;}
#test "DeepSeek independent heap BPE 18" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"a\n\rb",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==4 && r.work==6;#assert out[0]==97;#assert out[1]==10;#assert out[2]==13;#assert out[3]==98;}
#test "DeepSeek independent heap BPE 19" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..],"\r\na\nb",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==5 && r.work==7;#assert out[0]==13;#assert out[1]==10;#assert out[2]==97;#assert out[3]==10;#assert out[4]==98;}
#test "DeepSeek independent heap BPE 20" {table:=PT_TOY;out:[256]int;stage:[256]int;normal:[1024]u8;scalars:[1024]int;symbols:[1024]int;r:=ds_encode(table[..]," hello",out[..],stage[..],normal[..],scalars[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==3 && r.work==49;#assert out[0]==194;#assert out[1]==160;#assert out[2]==261;}
