DVT_COMPRESSED_CACHE4 :: [50]f32.[-0.8087536692619324f32,1.4465512037277222f32,1.0695712566375732f32,-0.33572351932525635f32,-0.5315622091293335f32,1.4166953563690186f32,-1.2095425128936768f32,-0.6912886500358582f32,-0.7858484983444214f32,0.16594672203063965f32,-1.2734860181808472f32,-0.6227763295173645f32,-1.2125822305679321f32,-0.11003194004297256f32,0.8370363116264343f32,-1.0377854108810425f32,-1.2476108074188232f32,-1.0737013816833496f32,-0.7908411026000977f32,0.4338740110397339f32,-0.8694039583206177f32,1.6145347356796265f32,0.8570106029510498f32,-0.11591427773237228f32,0.45873168110847473f32,-1.5451453924179077f32,-0.15102900564670563f32,1.354303240776062f32,0.638121485710144f32,-0.642052412033081f32,0.08027639240026474f32,1.2082725763320923f32,-1.3942501544952393f32,-0.33768776059150696f32,-0.6461136937141418f32,1.7507439851760864f32,-0.9966732263565063f32,-0.2385522872209549f32,-0.6113423109054565f32,-0.5116785764694214f32,1.8152905702590942f32,-0.8963127732276917f32,-0.3330368399620056f32,-0.019833946600556374f32,-0.8045872449874878f32,-0.7948142290115356f32,-0.8554039597511292f32,1.5359328985214233f32,-0.6070552468299866f32,-0.3279300928115845f32];
#test "complete V2 tiny compressed matches independent full-prefix references" {
    data:=DVT_DATA;blocks:[2]DvBlock;experts:[3]DvExpert;
    for layer:0..<2 {blocks[layer].p[7]=data[0..<1];blocks[layer].experts=experts[0..<1];for slot:0..<3 {blocks[layer].dense.p[slot]=data[0..<1];blocks[layer].shared.p[slot]=data[0..<1];}}
    m:=dv_tiny_model(data[..],blocks[..],experts[..]);
    p:=dv_plan(m.shape,MlMode.compressed);cache:[50]f32;out:[10]f32;trace:[17]f32;routes:[3]DrRoute;
    work:[4096]f32;scores:[128]f64;acc:[4]PsionicAccumulator;draft:[2]DrRoute;
    out[9]=-7;trace[16]=-9;routes[2].count=-11;for i:0..<2 {draft[i].count=17;routes[i].count=19;}
    r0:=dv_step(m,MlMode.compressed,1,0,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r0.status==DsStatus.ok && r0.written==9 && r0.next==1;
    for i:0..<9 {#assert abs(out[i]-DVT_COMPRESSED_LOGITS0[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_COMPRESSED_TRACE0[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<1 {for j:0..<5 {#assert abs(cache[(layer*5+pos)*5+j]-DVT_COMPRESSED_CACHE0[(layer*1+pos)*5+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_COMPRESSED_IDS0_1[i] && abs(routes[1].weights[i]-DVT_COMPRESSED_WEIGHTS0_1[i])<1e-12;}
    r1:=dv_step(m,MlMode.compressed,4,1,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r1.status==DsStatus.ok && r1.written==9 && r1.next==2;
    for i:0..<9 {#assert abs(out[i]-DVT_COMPRESSED_LOGITS1[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_COMPRESSED_TRACE1[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<2 {for j:0..<5 {#assert abs(cache[(layer*5+pos)*5+j]-DVT_COMPRESSED_CACHE1[(layer*2+pos)*5+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_COMPRESSED_IDS1_1[i] && abs(routes[1].weights[i]-DVT_COMPRESSED_WEIGHTS1_1[i])<1e-12;}
    r2:=dv_step(m,MlMode.compressed,2,2,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r2.status==DsStatus.ok && r2.written==9 && r2.next==3;
    for i:0..<9 {#assert abs(out[i]-DVT_COMPRESSED_LOGITS2[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_COMPRESSED_TRACE2[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<3 {for j:0..<5 {#assert abs(cache[(layer*5+pos)*5+j]-DVT_COMPRESSED_CACHE2[(layer*3+pos)*5+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_COMPRESSED_IDS2_1[i] && abs(routes[1].weights[i]-DVT_COMPRESSED_WEIGHTS2_1[i])<1e-12;}
    r3:=dv_step(m,MlMode.compressed,7,3,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r3.status==DsStatus.ok && r3.written==9 && r3.next==4;
    for i:0..<9 {#assert abs(out[i]-DVT_COMPRESSED_LOGITS3[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_COMPRESSED_TRACE3[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<4 {for j:0..<5 {#assert abs(cache[(layer*5+pos)*5+j]-DVT_COMPRESSED_CACHE3[(layer*4+pos)*5+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_COMPRESSED_IDS3_1[i] && abs(routes[1].weights[i]-DVT_COMPRESSED_WEIGHTS3_1[i])<1e-12;}
    r4:=dv_step(m,MlMode.compressed,5,4,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r4.status==DsStatus.ok && r4.written==9 && r4.next==5;
    for i:0..<9 {#assert abs(out[i]-DVT_COMPRESSED_LOGITS4[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_COMPRESSED_TRACE4[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<5 {for j:0..<5 {#assert abs(cache[(layer*5+pos)*5+j]-DVT_COMPRESSED_CACHE4[(layer*5+pos)*5+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_COMPRESSED_IDS4_1[i] && abs(routes[1].weights[i]-DVT_COMPRESSED_WEIGHTS4_1[i])<1e-12;}
    #assert out[9]==-7 && trace[16]==-9 && routes[2].count==-11;
}
