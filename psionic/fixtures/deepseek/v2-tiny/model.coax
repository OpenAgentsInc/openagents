#test "complete V2 tiny expanded matches independent full-prefix references" {
    data:=DVT_DATA;blocks:[2]DvBlock;experts:[3]DvExpert;
    for layer:0..<2 {blocks[layer].p[7]=data[0..<1];blocks[layer].experts=experts[0..<1];for slot:0..<3 {blocks[layer].dense.p[slot]=data[0..<1];blocks[layer].shared.p[slot]=data[0..<1];}}
    m:=dv_tiny_model(data[..],blocks[..],experts[..]);
    p:=dv_plan(m.shape,MlMode.expanded);cache:[100]f32;out:[10]f32;trace:[17]f32;routes:[3]DrRoute;
    work:[4096]f32;scores:[128]f64;acc:[4]PsionicAccumulator;draft:[2]DrRoute;
    out[9]=-7;trace[16]=-9;routes[2].count=-11;for i:0..<2 {draft[i].count=17;routes[i].count=19;}
    r0:=dv_step(m,MlMode.expanded,1,0,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r0.status==DsStatus.ok && r0.written==9 && r0.next==1;
    for i:0..<9 {#assert abs(out[i]-DVT_EXPANDED_LOGITS0[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_EXPANDED_TRACE0[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<1 {for j:0..<10 {#assert abs(cache[(layer*5+pos)*10+j]-DVT_EXPANDED_CACHE0[(layer*1+pos)*10+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_EXPANDED_IDS0_1[i] && abs(routes[1].weights[i]-DVT_EXPANDED_WEIGHTS0_1[i])<1e-12;}
    r1:=dv_step(m,MlMode.expanded,4,1,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r1.status==DsStatus.ok && r1.written==9 && r1.next==2;
    for i:0..<9 {#assert abs(out[i]-DVT_EXPANDED_LOGITS1[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_EXPANDED_TRACE1[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<2 {for j:0..<10 {#assert abs(cache[(layer*5+pos)*10+j]-DVT_EXPANDED_CACHE1[(layer*2+pos)*10+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_EXPANDED_IDS1_1[i] && abs(routes[1].weights[i]-DVT_EXPANDED_WEIGHTS1_1[i])<1e-12;}
    r2:=dv_step(m,MlMode.expanded,2,2,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r2.status==DsStatus.ok && r2.written==9 && r2.next==3;
    for i:0..<9 {#assert abs(out[i]-DVT_EXPANDED_LOGITS2[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_EXPANDED_TRACE2[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<3 {for j:0..<10 {#assert abs(cache[(layer*5+pos)*10+j]-DVT_EXPANDED_CACHE2[(layer*3+pos)*10+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_EXPANDED_IDS2_1[i] && abs(routes[1].weights[i]-DVT_EXPANDED_WEIGHTS2_1[i])<1e-12;}
    r3:=dv_step(m,MlMode.expanded,7,3,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r3.status==DsStatus.ok && r3.written==9 && r3.next==4;
    for i:0..<9 {#assert abs(out[i]-DVT_EXPANDED_LOGITS3[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_EXPANDED_TRACE3[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<4 {for j:0..<10 {#assert abs(cache[(layer*5+pos)*10+j]-DVT_EXPANDED_CACHE3[(layer*4+pos)*10+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_EXPANDED_IDS3_1[i] && abs(routes[1].weights[i]-DVT_EXPANDED_WEIGHTS3_1[i])<1e-12;}
    r4:=dv_step(m,MlMode.expanded,5,4,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r4.status==DsStatus.ok && r4.written==9 && r4.next==5;
    for i:0..<9 {#assert abs(out[i]-DVT_EXPANDED_LOGITS4[i])<0.000002f32;}
    for i:0..<16 {#assert abs(trace[i]-DVT_EXPANDED_TRACE4[i])<0.000002f32;}
    for layer:0..<2 {for pos:0..<5 {for j:0..<10 {#assert abs(cache[(layer*5+pos)*10+j]-DVT_EXPANDED_CACHE4[(layer*5+pos)*10+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==2;for i:0..<2 {#assert routes[1].ids[i]==DVT_EXPANDED_IDS4_1[i] && abs(routes[1].weights[i]-DVT_EXPANDED_WEIGHTS4_1[i])<1e-12;}
    #assert out[9]==-7 && trace[16]==-9 && routes[2].count==-11;
}
