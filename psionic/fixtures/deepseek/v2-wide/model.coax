4006061553955f32,-0.9309882521629333f32,-0.7022644281387329f32,-1.1349334716796875f32,-0.9465683698654175f32,-0.4034653306007385f32,0.24454054236412048f32,0.906315803527832f32,0.08103986084461212f32,-0.5762976408004761f32,0.07170820236206055f32,0.3597620725631714f32,-0.09179246425628662f32,0.1962614208459854f32,-0.46107611060142517f32,0.18692976236343384f32,0.848704993724823f32,0.023429088294506073f32,-0.6339084506034851f32,-0.3458545506000519f32,-0.06775496155023575f32,-0.3119325041770935f32,1.3449312448501587f32,-0.0774652361869812f32];
#test "complete V2 wide expanded matches independent full-prefix references" {
    data:=DVW_DATA;blocks:[3]DvBlock;experts:[8]DvExpert;
    for layer:0..<3 {blocks[layer].p[7]=data[0..<1];blocks[layer].experts=experts[0..<1];for slot:0..<3 {blocks[layer].dense.p[slot]=data[0..<1];blocks[layer].shared.p[slot]=data[0..<1];}}
    m:=dv_wide_model(data[..],blocks[..],experts[..]);
    p:=dv_plan(m.shape,MlMode.expanded);cache:[285]f32;out:[12]f32;trace:[37]f32;routes:[4]DrRoute;
    work:[4096]f32;scores:[128]f64;acc:[6]PsionicAccumulator;draft:[3]DrRoute;
    out[11]=-7;trace[36]=-9;routes[3].count=-11;for i:0..<3 {draft[i].count=17;routes[i].count=19;}
    r0:=dv_step(m,MlMode.expanded,1,0,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r0.status==DsStatus.ok && r0.written==11 && r0.next==1;
    for i:0..<11 {#assert abs(out[i]-DVW_EXPANDED_LOGITS0[i])<0.000002f32;}
    for i:0..<36 {#assert abs(trace[i]-DVW_EXPANDED_TRACE0[i])<0.000002f32;}
    for layer:0..<3 {for pos:0..<1 {for j:0..<19 {#assert abs(cache[(layer*5+pos)*19+j]-DVW_EXPANDED_CACHE0[(layer*1+pos)*19+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==3;for i:0..<3 {#assert routes[1].ids[i]==DVW_EXPANDED_IDS0_1[i] && abs(routes[1].weights[i]-DVW_EXPANDED_WEIGHTS0_1[i])<1e-12;}
    #assert routes[2].count==3;for i:0..<3 {#assert routes[2].ids[i]==DVW_EXPANDED_IDS0_2[i] && abs(routes[2].weights[i]-DVW_EXPANDED_WEIGHTS0_2[i])<1e-12;}
    r1:=dv_step(m,MlMode.expanded,4,1,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r1.status==DsStatus.ok && r1.written==11 && r1.next==2;
    for i:0..<11 {#assert abs(out[i]-DVW_EXPANDED_LOGITS1[i])<0.000002f32;}
    for i:0..<36 {#assert abs(trace[i]-DVW_EXPANDED_TRACE1[i])<0.000002f32;}
    for layer:0..<3 {for pos:0..<2 {for j:0..<19 {#assert abs(cache[(layer*5+pos)*19+j]-DVW_EXPANDED_CACHE1[(layer*2+pos)*19+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==3;for i:0..<3 {#assert routes[1].ids[i]==DVW_EXPANDED_IDS1_1[i] && abs(routes[1].weights[i]-DVW_EXPANDED_WEIGHTS1_1[i])<1e-12;}
    #assert routes[2].count==3;for i:0..<3 {#assert routes[2].ids[i]==DVW_EXPANDED_IDS1_2[i] && abs(routes[2].weights[i]-DVW_EXPANDED_WEIGHTS1_2[i])<1e-12;}
    r2:=dv_step(m,MlMode.expanded,2,2,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r2.status==DsStatus.ok && r2.written==11 && r2.next==3;
    for i:0..<11 {#assert abs(out[i]-DVW_EXPANDED_LOGITS2[i])<0.000002f32;}
    for i:0..<36 {#assert abs(trace[i]-DVW_EXPANDED_TRACE2[i])<0.000002f32;}
    for layer:0..<3 {for pos:0..<3 {for j:0..<19 {#assert abs(cache[(layer*5+pos)*19+j]-DVW_EXPANDED_CACHE2[(layer*3+pos)*19+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==3;for i:0..<3 {#assert routes[1].ids[i]==DVW_EXPANDED_IDS2_1[i] && abs(routes[1].weights[i]-DVW_EXPANDED_WEIGHTS2_1[i])<1e-12;}
    #assert routes[2].count==3;for i:0..<3 {#assert routes[2].ids[i]==DVW_EXPANDED_IDS2_2[i] && abs(routes[2].weights[i]-DVW_EXPANDED_WEIGHTS2_2[i])<1e-12;}
    r3:=dv_step(m,MlMode.expanded,7,3,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r3.status==DsStatus.ok && r3.written==11 && r3.next==4;
    for i:0..<11 {#assert abs(out[i]-DVW_EXPANDED_LOGITS3[i])<0.000002f32;}
    for i:0..<36 {#assert abs(trace[i]-DVW_EXPANDED_TRACE3[i])<0.000002f32;}
    for layer:0..<3 {for pos:0..<4 {for j:0..<19 {#assert abs(cache[(layer*5+pos)*19+j]-DVW_EXPANDED_CACHE3[(layer*4+pos)*19+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==3;for i:0..<3 {#assert routes[1].ids[i]==DVW_EXPANDED_IDS3_1[i] && abs(routes[1].weights[i]-DVW_EXPANDED_WEIGHTS3_1[i])<1e-12;}
    #assert routes[2].count==3;for i:0..<3 {#assert routes[2].ids[i]==DVW_EXPANDED_IDS3_2[i] && abs(routes[2].weights[i]-DVW_EXPANDED_WEIGHTS3_2[i])<1e-12;}
    r4:=dv_step(m,MlMode.expanded,5,4,cache[..],DvOutput.{logits=out[..],trace=trace[..],routes=routes[..]},DvWork.{floats=work[0..<p.floats],scores=scores[0..<p.scores],accumulators=acc[..],routes=draft[..]},false);
    #assert r4.status==DsStatus.ok && r4.written==11 && r4.next==5;
    for i:0..<11 {#assert abs(out[i]-DVW_EXPANDED_LOGITS4[i])<0.000002f32;}
    for i:0..<36 {#assert abs(trace[i]-DVW_EXPANDED_TRACE4[i])<0.000002f32;}
    for layer:0..<3 {for pos:0..<5 {for j:0..<19 {#assert abs(cache[(layer*5+pos)*19+j]-DVW_EXPANDED_CACHE4[(layer*5+pos)*19+j])<0.000002f32;}}}
    #assert routes[0].count==0;
    #assert routes[1].count==3;for i:0..<3 {#assert routes[1].ids[i]==DVW_EXPANDED_IDS4_1[i] && abs(routes[1].weights[i]-DVW_EXPANDED_WEIGHTS4_1[i])<1e-12;}
    #assert routes[2].count==3;for i:0..<3 {#assert routes[2].ids[i]==DVW_EXPANDED_IDS4_2[i] && abs(routes[2].weights[i]-DVW_EXPANDED_WEIGHTS4_2[i])<1e-12;}
    #assert out[11]==-7 && trace[36]==-9 && routes[3].count==-11;
}
