#test "dense reference versus original-format model step 3" {
    data:=GT_FILE;blocks:[2]GBlock;m:=gt_model(data[..],blocks[..]);p:=g_plan(m.shape);
    cache:=GT_CACHE3;logits:[17]f32;trace:[129]f32;routes:[5]int;weights:[5]f32;
    floats:[1792]f32;scores:[8]f64;sums:[32]PsionicAccumulator;work_routes:[4]int;
    logits[16]=-7;trace[128]=-9;routes[4]=-11;weights[4]=-13;
    out:=GOutput.{logits=logits[..],trace=trace[..],routes=routes[..],weights=weights[..]};
    work:=GWork.{floats=floats[..],scores=scores[..],sums=sums[..],routes=work_routes[..]};
    r:=g_forward(m,2,3,g_macs(m.shape,3),cache[..],out,work,false);
    #assert p.status==GStatus.ok && p.floats==1792 && r.status==GStatus.ok && r.written==16 && r.next==4;
    #assert r.macs==g_macs(m.shape,3);for i:0..<1280 {#assert cache[i]==GT_AFTER3[i];}
    for i:0..<16 {#assert abs(logits[i]-GT_LOGITS3[i])<0.00002f32*(1+abs(GT_LOGITS3[i]));}
    for i:0..<128 {#assert abs(trace[i]-GT_TRACE3[i])<0.00002f32*(1+abs(GT_TRACE3[i]));}
    for i:0..<4 {#assert routes[i]==GT_ROUTES3[i] && abs(weights[i]-GT_WEIGHTS3[i])<0.0000002f32;}
    #assert logits[16]== -7 && trace[128]== -9 && routes[4]== -11 && weights[4]== -13;
}
