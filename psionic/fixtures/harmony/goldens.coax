// Owned regex/heap-byte-rank oracle; generated by tests/harmony_oracle.py.
#test "independent Harmony split and BPE case 0" {
    table:=HS_TOY;raw:=[1]u8.[0];text:=cast(string)raw[0..<0];t:=hs_layout(table[..]);out:[256]int;stage:[256]int;symbols:[1024]int;
    r:=hs_encode_checked(table[..],text,out[..],stage[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==0 && r.work==0;
}
#test "independent Harmony split and BPE case 1" {
    table:=HS_TOY;raw:=[1]u8.[97];text:=cast(string)raw[0..<1];t:=hs_layout(table[..]);out:[256]int;stage:[256]int;symbols:[1024]int;
    r:=hs_encode_checked(table[..],text,out[..],stage[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==1 && r.work==1;
    expected:=[1]int.[97];
    for i:0..<r.written {#assert out[i]==expected[i];}
    ends:=[1]int.[1];
    at:=0;for end:ends {at=hs_piece(table[..],t,text,at);#assert at==end;}
}
