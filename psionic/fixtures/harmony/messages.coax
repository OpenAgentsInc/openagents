    expected:=[40]int.[200006,115,121,115,116,101,109,200008,200007,200006,100,101,118,101,108,111,112,101,114,200008,200007,200006,117,115,101,114,200008,200007,200006,97,115,115,105,115,116,97,110,116,200008,200002];
    r:=hm_render_checked(table[..],messages[0..<4],false,tokens[..],stage[..],symbols[..],false);
    #assert r.status==HmStatus.ok && r.written==40 && r.bytes==28 && r.work==214;
    for i:0..<r.written {#assert tokens[i]==expected[i];}
    p:=hm_parse_checked(table[..],tokens[0..<40],false,records[..],draft[..],bytes[..],work[..],false);
    #assert p.status==HmStatus.ok && p.written==4 && p.consumed==40 && p.bytes==28;
    #assert records[0].role==cast(HmRole)0 && records[0].channel==cast(HmChannel)0 && records[0].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[0].name_begin..<records[0].name_end]=="";
    #assert cast(string)bytes[records[0].recipient_begin..<records[0].recipient_end]=="";
    #assert cast(string)bytes[records[0].body_begin..<records[0].body_end]=="";
    #assert records[1].role==cast(HmRole)1 && records[1].channel==cast(HmChannel)0 && records[1].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[1].name_begin..<records[1].name_end]=="";
    #assert cast(string)bytes[records[1].recipient_begin..<records[1].recipient_end]=="";
    #assert cast(string)bytes[records[1].body_begin..<records[1].body_end]=="";
    #assert records[2].role==cast(HmRole)2 && records[2].channel==cast(HmChannel)0 && records[2].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[2].name_begin..<records[2].name_end]=="";
    #assert cast(string)bytes[records[2].recipient_begin..<records[2].recipient_end]=="";
    #assert cast(string)bytes[records[2].body_begin..<records[2].body_end]=="";
    #assert records[3].role==cast(HmRole)3 && records[3].channel==cast(HmChannel)0 && records[3].ending==cast(HmEnd)1;
    #assert cast(string)bytes[records[3].name_begin..<records[3].name_end]=="";
    #assert cast(string)bytes[records[3].recipient_begin..<records[3].recipient_end]=="";
    #assert cast(string)bytes[records[3].body_begin..<records[3].body_end]=="";
}
