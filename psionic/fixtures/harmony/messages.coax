// Owned source-contract framing and independent token references.
#test "independent typed Harmony render and full parse 0" {
    table:=HS_TOY;tokens:[2048]int;stage:[2048]int;symbols:[1024]int;bytes:[4096]u8;work:[4096]u8;records:[8]HmRecord;draft:[8]HmRecord;
    messages:=[1]HmMessage.[HmMessage.{}];
    expected:=[10]int.[200006,97,115,115,105,115,116,97,110,116];
    r:=hm_render_checked(table[..],messages[0..<0],true,tokens[..],stage[..],symbols[..],false);
    #assert r.status==HmStatus.ok && r.written==10 && r.bytes==9 && r.work==81;
    for i:0..<r.written {#assert tokens[i]==expected[i];}
    p:=hm_parse_checked(table[..],tokens[0..<0],false,records[..],draft[..],bytes[..],work[..],false);
    #assert p.status==HmStatus.ok && p.written==0 && p.consumed==0 && p.bytes==0;
}
#test "independent typed Harmony render and full parse 1" {
    table:=HS_TOY;tokens:[2048]int;stage:[2048]int;symbols:[1024]int;bytes:[4096]u8;work:[4096]u8;records:[8]HmRecord;draft:[8]HmRecord;
    messages:=[3]HmMessage.[HmMessage.{role=cast(HmRole)0,channel=cast(HmChannel)0,ending=cast(HmEnd)0,name="",recipient="",body="You are ChatGPT, a large language model trained by OpenAI.\nKnowledge cutoff: 2024-06\n\nReasoning: low\n\n# Valid channels: analysis, commentary, final. Channel must be included for every message."},HmMessage.{role=cast(HmRole)1,channel=cast(HmChannel)0,ending=cast(HmEnd)0,name="",recipient="",body="# Instructions\n\nAnswer the user's questions like a robot."},HmMessage.{role=cast(HmRole)2,channel=cast(HmChannel)0,ending=cast(HmEnd)0,name="",recipient="",body="What is the capital of the largest country in the world?"}];
