#test "independent typed Harmony render and full parse 4" {
    table:=HS_TOY;tokens:[2048]int;stage:[2048]int;symbols:[1024]int;bytes:[4096]u8;work:[4096]u8;records:[8]HmRecord;draft:[8]HmRecord;
    messages:=[3]HmMessage.[HmMessage.{role=cast(HmRole)2,channel=cast(HmChannel)0,ending=cast(HmEnd)0,name="",recipient="",body="Literal <|start|> must stay text. é ≠ é"},HmMessage.{role=cast(HmRole)3,channel=cast(HmChannel)1,ending=cast(HmEnd)0,name="",recipient="",body="Let us compare."},HmMessage.{role=cast(HmRole)3,channel=cast(HmChannel)3,ending=cast(HmEnd)1,name="",recipient="",body="42."}];
    expected:=[108]int.[200006,117,115,101,114,200008,76,105,116,101,114,97,108,32,60,124,115,116,97,114,116,124,62,32,109,117,115,116,32,115,116,97,121,32,116,101,120,116,46,32,101,204,129,32,226,137,160,32,195,169,200007,200006,97,115,115,105,115,116,97,110,116,200005,97,110,97,108,121,115,105,115,200008,76,101,116,32,117,115,32,99,111,109,112,97,114,101,46,200007,200006,97,115,115,105,115,116,97,110,116,200005,102,105,110,97,108,200008,52,50,46,200002];
    r:=hm_render_checked(table[..],messages[0..<3],false,tokens[..],stage[..],symbols[..],false);
    #assert r.status==HmStatus.ok && r.written==108 && r.bytes==97 && r.work==559;
    for i:0..<r.written {#assert tokens[i]==expected[i];}
    p:=hm_parse_checked(table[..],tokens[0..<108],false,records[..],draft[..],bytes[..],work[..],false);
    #assert p.status==HmStatus.ok && p.written==3 && p.consumed==108 && p.bytes==97;
    #assert records[0].role==cast(HmRole)2 && records[0].channel==cast(HmChannel)0 && records[0].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[0].name_begin..<records[0].name_end]=="";
    #assert cast(string)bytes[records[0].recipient_begin..<records[0].recipient_end]=="";
    #assert cast(string)bytes[records[0].body_begin..<records[0].body_end]=="Literal <|start|> must stay text. é ≠ é";
    #assert records[1].role==cast(HmRole)3 && records[1].channel==cast(HmChannel)1 && records[1].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[1].name_begin..<records[1].name_end]=="";
    #assert cast(string)bytes[records[1].recipient_begin..<records[1].recipient_end]=="";
    #assert cast(string)bytes[records[1].body_begin..<records[1].body_end]=="Let us compare.";
    #assert records[2].role==cast(HmRole)3 && records[2].channel==cast(HmChannel)3 && records[2].ending==cast(HmEnd)1;
    #assert cast(string)bytes[records[2].name_begin..<records[2].name_end]=="";
    #assert cast(string)bytes[records[2].recipient_begin..<records[2].recipient_end]=="";
    #assert cast(string)bytes[records[2].body_begin..<records[2].body_end]=="42.";
}
