    r:=hm_render_checked(table[..],messages[0..<3],true,tokens[..],stage[..],symbols[..],false);
    #assert r.status==HmStatus.ok && r.written==338 && r.bytes==333 && r.work==2207;
    for i:0..<r.written {#assert tokens[i]==expected[i];}
    p:=hm_parse_checked(table[..],tokens[0..<328],false,records[..],draft[..],bytes[..],work[..],false);
    #assert p.status==HmStatus.ok && p.written==3 && p.consumed==328 && p.bytes==324;
    #assert records[0].role==cast(HmRole)0 && records[0].channel==cast(HmChannel)0 && records[0].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[0].name_begin..<records[0].name_end]=="";
    #assert cast(string)bytes[records[0].recipient_begin..<records[0].recipient_end]=="";
    #assert cast(string)bytes[records[0].body_begin..<records[0].body_end]=="You are ChatGPT, a large language model trained by OpenAI.\nKnowledge cutoff: 2024-06\n\nReasoning: low\n\n# Valid channels: analysis, commentary, final. Channel must be included for every message.";
    #assert records[1].role==cast(HmRole)1 && records[1].channel==cast(HmChannel)0 && records[1].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[1].name_begin..<records[1].name_end]=="";
    #assert cast(string)bytes[records[1].recipient_begin..<records[1].recipient_end]=="";
    #assert cast(string)bytes[records[1].body_begin..<records[1].body_end]=="# Instructions\n\nAnswer the user's questions like a robot.";
    #assert records[2].role==cast(HmRole)2 && records[2].channel==cast(HmChannel)0 && records[2].ending==cast(HmEnd)0;
    #assert cast(string)bytes[records[2].name_begin..<records[2].name_end]=="";
    #assert cast(string)bytes[records[2].recipient_begin..<records[2].recipient_end]=="";
    #assert cast(string)bytes[records[2].body_begin..<records[2].body_end]=="What is the capital of the largest country in the world?";
}
