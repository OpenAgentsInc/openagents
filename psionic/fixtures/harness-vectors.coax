    #assert nodes[13].op==GgOp.select && nodes[13].a==12 && nodes[13].b==7 && nodes[13].c==6 && nodes[13].k==0;
    #assert nodes[14].op==GgOp.relu && nodes[14].a==0 && nodes[14].b==0 && nodes[14].c==0 && nodes[14].k==0;
}
#test "independent harness case seed 1 index 65536" {
    nodes:[16]GgNode;for i:0..<16 {nodes[i]=GgNode.{op=GgOp.relu,a=5,k=9};}
    c:=ch_case(1,65536,nodes[..]);
    #assert c.count==7 && c.inputs==3 && c.outputs[0]==0 && c.outputs[1]==6;
    #assert c.values[0]==86;
    #assert c.values[1]==-71;
    #assert c.values[2]==-19;
    #assert nodes[0].op==GgOp.input && nodes[0].a==0 && nodes[0].b==0 && nodes[0].c==0 && nodes[0].k==0;
    #assert nodes[1].op==GgOp.input && nodes[1].a==0 && nodes[1].b==0 && nodes[1].c==0 && nodes[1].k==1;
    #assert nodes[2].op==GgOp.input && nodes[2].a==0 && nodes[2].b==0 && nodes[2].c==0 && nodes[2].k==2;
    #assert nodes[3].op==GgOp.sub && nodes[3].a==0 && nodes[3].b==0 && nodes[3].c==0 && nodes[3].k==0;
    #assert nodes[4].op==GgOp.eq0 && nodes[4].a==1 && nodes[4].b==0 && nodes[4].c==0 && nodes[4].k==0;
    #assert nodes[5].op==GgOp.sub && nodes[5].a==1 && nodes[5].b==3 && nodes[5].c==0 && nodes[5].k==0;
    #assert nodes[6].op==GgOp.relu && nodes[6].a==5 && nodes[6].b==0 && nodes[6].c==0 && nodes[6].k==0;
}
