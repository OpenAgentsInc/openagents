    #assert em_run(p[..],8,trace[0..<7],outputs[..],keys[..],values[..],false).status==TmStatus.capacity;
    #assert em_run(p[..],2,trace[..],outputs[..],keys[..],values[..],false).status==TmStatus.ok;
    #assert em_run(p[..],1,trace[..],outputs[..],keys[..],values[..],false).status==TmStatus.budget;
}
