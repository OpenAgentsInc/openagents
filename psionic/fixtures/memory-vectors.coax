    #assert trace[4]==1;#assert trace[5]==9;#assert trace[6]==-7;#assert trace[7]==1;
    #assert trace[8]==2;#assert trace[9]==0;#assert trace[10]==-4;#assert trace[11]==1;
    #assert trace[12]==3;#assert trace[13]==9;#assert trace[14]==-4;#assert trace[15]==2;
    #assert trace[16]==4;#assert trace[17]==0;#assert trace[18]==-1;#assert trace[19]==1;
    #assert trace[20]==5;#assert trace[21]==9;#assert trace[22]==-1;#assert trace[23]==3;
