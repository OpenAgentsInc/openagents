    r:=em_run(p[..],3,trace[..],outputs[..],keys[..],values[..],false);
    #assert r.status==TmStatus.ok;#assert r.steps==3;
    for i:0..<32 {#assert r.digest[i]==d[i];}
    #assert r.outputs==1;#assert p[r.ip].code==TmCode.ret;
    #assert outputs[0]==1;
    #assert outputs[1]==-9;#assert trace[12]==-9;
    #assert trace[0]==0;#assert trace[1]==0;#assert trace[2]==1;#assert trace[3]==1;
    #assert trace[4]==1;#assert trace[5]==9;#assert trace[6]==1;#assert trace[7]==1;
