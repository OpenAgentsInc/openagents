    #assert em_run(p[..],1,trace[..],outputs[..],keys[..],values[..],false).status==TmStatus.ok;
}
#test "independent memory fixture 26" {
    keys:[1]int;values:[1]int;
    p:=[3]TmOp.[TmOp.{code=TmCode.push,arg=1},TmOp.{code=TmCode.out,arg=0},TmOp.{code=TmCode.ret,arg=0}];
    d:=[32]u8.[54,172,193,47,132,249,67,110,175,218,230,188,136,230,232,251,173,91,155,196,80,77,4,133,166,246,117,189,140,232,244,71];trace:[16]int;outputs:[65]int;
