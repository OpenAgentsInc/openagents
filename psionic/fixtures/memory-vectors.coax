    #assert outputs[0]==-9;#assert trace[4]==-9;
    #assert trace[0]==0;#assert trace[1]==10;#assert trace[2]==0;#assert trace[3]==0;
    #assert em_run(p[..],65536,trace[0..<4],outputs[0..<1],keys[..],values[..],false).status==TmStatus.ok;
