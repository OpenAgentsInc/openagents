#test "independent memory fixture 23" {
    keys:[1]int;values:[1]int;
    p:=[7]TmOp.[TmOp.{code=TmCode.push,arg=-7},TmOp.{code=TmCode.out,arg=0},TmOp.{code=TmCode.push,arg=-4},TmOp.{code=TmCode.out,arg=0},TmOp.{code=TmCode.push,arg=-1},TmOp.{code=TmCode.out,arg=0},TmOp.{code=TmCode.ret,arg=0}];
