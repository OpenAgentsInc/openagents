    bytes:=[67]u8.[225,249,85,32,116,104,101,85,38,212,60,124,117,115,101,114,95,115,116,97,114,116,124,62,73,32,116,196,70,60,124,111,117,116,112,117,116,95,115,116,97,114,116,124,62,79,252,32,119,97,115,185,61,198,223,249,22,152,122,156,217,109,101,85,210,233,99];
