    #assert ne_golden(messages[..],prompt[..],want[0..<12],bytes[0..<13],o,53,12,NeStop.limit);
}
#test "independent generation 3: a second exchange fills the context" {
    messages:=[4]NcMessage.[NcMessage.{role=NcRole.user,text="Name 12 animals."},NcMessage.{role=NcRole.assistant,text="Cats, dogs."},NcMessage.{role=NcRole.user,text="More?"},NcMessage.{role=NcRole.assistant,text=""}];
