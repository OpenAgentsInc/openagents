    want:=[12]int.[235,195,4,85,63,59,290,34,123,156,283,270];
    bytes:=[16]u8.[235,195,4,85,63,59,32,115,116,34,123,156,32,112,105,110];
    o:=NxOptions.{temperature=1.0,top_k=40,top_p=1.0};
    #assert ne_golden(messages[..],prompt[..],want[0..<12],bytes[0..<16],o,126,12,NeStop.limit);
}
#test "independent generation 2: system turn merged, temperature 0.8, top-p 0.9" {
    messages:=[3]NcMessage.[NcMessage.{role=NcRole.system,text="Be brief."},NcMessage.{role=NcRole.user,text="12 + 345 = ?"},NcMessage.{role=NcRole.assistant,text="357"}];
    prompt:=[23]int.[320,321,66,101,265,282,101,102,46,10,10,294,32,43,32,295,53,32,61,32,63,322,323];
    want:=[12]int.[254,6,113,165,227,140,81,76,296,160,165,161];
