    #assert ne_golden(messages[..],prompt[..],want[0..<31],bytes[0..<67],o,9,40,NeStop.context);
}
#test "independent generation 4: a sampled stop token ends the reply" {
    messages:=[2]NcMessage.[NcMessage.{role=NcRole.user,text="Hi"},NcMessage.{role=NcRole.assistant,text=""}];
    prompt:=[6]int.[320,321,72,105,322,323];
