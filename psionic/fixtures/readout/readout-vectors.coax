    slots:=[3]int.[1,0,2];
    want:=[3]f64.[0.37754066879814546,0.6224593312018546,7.281815075446189e-23];
    out:[3]f64;work:[3]f64;
    r:=qr_read(cast(QrKind)0,f32_from_bits(0x40000000),logits[..],slots[..],out[..],work[..],false);
    #assert r.status==QrStatus.ok && r.written==3 && r.best==1;
    #assert abs(r.mass-1.0)<0.000000000001 && abs(r.confidence-0.4336889968027819)<0.000000000001;
    #assert abs(r.score-0.0)<0.000000000001 && abs(r.truth-0.0)<0.000000000001;
    for i:0..<3 {#assert abs(out[i]-want[i])<0.000000000001;}
}
