  "storage": "borrowed f32 views, rank 0..4, <=1048576 logical elements per input/output",
  "work_limit": 1048576,
  "gradient_work": "(na+nb)*outputs*branch_factor <= 1048576; plus the admitted forward validation",
  "forward_tolerance": "abs(got-ref)/(1+abs(ref)) <= 2e-6",
  "gradient_tolerance": "abs(got-central_difference)/(1+abs(central_difference)) <= 3e-5",
  "gradient_semantics": "wide value equations at f32 inputs before final narrowing; discrete indices/parameters have no derivative; frozen subgradients at kinks",
  "arithmetic": "f32 operands; f64 products and ordered compensated reductions; one checked f32 narrowing; no FMA/reassociation",
  "publication": "public outputs publish together; arithmetic refusal may dirty scratch; all public counts zero on refusal",
