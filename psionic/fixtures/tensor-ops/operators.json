    "sort": "stable value order, equal values lowest original axis index; indices are axis-local",
    "maximum": "lowest axis position on ties",
    "maxpool2d": "first row-major window position on ties",
    "relu": "zero derivative at zero",
    "update": "last indexed update wins; overwritten updates have zero value gradient",
    "empty": "sum identity and empty outputs supported; mean/max/softmax reduced width and mean losses must be nonempty",
    "gradient_coordinates": "dense logical input coordinates; backing-storage alias/view pullbacks and tape integration are separate",
    "outputs": "fresh/unpublished caller-owned result spans; use tensor-view scatter to replace a registered tensor"
