// Agent candidate a2: offset RMS norm, DEVICE-F32-CHUNKED-v1.
// Knob = c*1000 + m: pass 0 has c items per row, item j adding the squares
// of columns j, j+c, ... in f64 (four accumulators); pass 1 has m items per
// row, item k re-adding the row's c partials in order, forming
// inv = 1/sqrt(mean+eps) once in f64 and writing columns k, k+m, ... as
// f32(f64(x)*inv*(1+f64(scale))). Both layouts are coalesced across a warp.

a2_min :: (a:int,b:int)->int {if a<b {return a;}return b;}
a2_c :: (knob:int,width:int)->int {return a2_min(knob/1000,width);}
a2_m :: (knob:int,width:int)->int {return a2_min(knob%1000,width);}

a2_knobs :: (item:int,knobs:[]int) #export_c {
    n:=0;
    for ci:0..<3 {for mi:0..<3 {knobs[n]=(32<<ci)*1000+(64<<mi);n+=1;}}
    knobs[n]=-1;
}
a2_plan :: (item:int,rows:int,width:int,knob:int,plan:[]int) #export_c {
    c:=a2_c(knob,width);m:=a2_m(knob,width);
    plan[0]=rows*c;plan[1]=rows*m;plan[2]=rows*c;
}
a2_pass0 :: (item:int,rows:int,width:int,knob:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) #export_c {
    c:=a2_c(knob,width);r:=item/c;j:=item-r*c;at:=r*width+j;
    sum:f64=0;
    for k:0..<(width-j+c-1)/c {v:=f64(x[at+k*c]);sum+=v*v;}
    work[item]=sum;
}
a2_pass1 :: (item:int,rows:int,width:int,knob:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) #export_c {
    c:=a2_c(knob,width);m:=a2_m(knob,width);r:=item/m;k:=item-r*m;
    sum:f64=0;
    for j:0..<c {sum+=work[r*c+j];}
    inv:=1/sqrt(sum/f64(width)+f64(epsilon));
    at:=r*width;
    for t:0..<(width-k+m-1)/m {
        i:=k+t*m;
        out[at+i]=f32(f64(x[at+i])*inv*(1+f64(scale[i])));
    }
}

a2_t_run :: (knob:int,rows:int,width:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) {
    plan:[3]int;a2_plan(0,rows,width,knob,plan[..]);
    for i:0..<plan[0] {a2_pass0(plan[0]-1-i,rows,width,knob,epsilon,x,scale,work,out);}
    for i:0..<plan[1] {a2_pass1(plan[1]-1-i,rows,width,knob,epsilon,x,scale,work,out);}
}
#test "every knob writes every output within one f32 step of the f64 norm" {
    for width:1..<120 {
        if width>5 && width!=37 && width!=111 {continue;}
        rows:=3;x:[1000]f32;scale:[300]f32;
        for i:0..<rows*width {x[i]=f32((i*7)%23-11)*0.37;}
        for i:0..<width {scale[i]=f32(i%5)/4-0.5;}
        k:[64]int;a2_knobs(0,k[..]);
        for knob:k {
            if knob<0 {break;}
            out:[1000]f32;work:[3072]f64;for i:0..<1000 {out[i]=-99;}
            a2_t_run(knob,rows,width,0.000001,x[..],scale[..],work[..],out[..]);
            for r:0..<rows {
                s:f64=0;for i:0..<width {v:=f64(x[r*width+i]);s+=v*v;}
                d:=sqrt(s/f64(width)+f64(f32(0.000001)));
                for i:0..<width {
                    ref:=f64(x[r*width+i])/d*(1+f64(scale[i]));
                    #assert abs(f64(out[r*width+i])-ref)<=abs(ref)*0.00000012+1e-40;
                }
            }
        }
    }
}
