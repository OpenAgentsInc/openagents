// Agent candidate a4: offset RMS norm, DEVICE-F32-CHUNKED-v1.
// Knob = c*1000 + m (as a2). Pass 0: c items per row, item j adds the
// squares of columns j, j+c, ... in f64 with two accumulators (even and odd
// steps). Pass 1: m items per row; item k re-adds the row's c partials with
// two accumulators, forms inv = 1/sqrt(mean+eps) once in f64 and writes
// columns k, k+m, ... as f32(f64(x)*inv*(1+f64(scale))). Indices advance by
// addition instead of a 64-bit multiply per step.

a4_min :: (a:int,b:int)->int {if a<b {return a;}return b;}
a4_c :: (knob:int,width:int)->int {return a4_min(knob/1000,width);}
a4_m :: (knob:int,width:int)->int {return a4_min(knob%1000,width);}

a4_knobs :: (item:int,knobs:[]int) #export_c {
    knobs[0]=64128;knobs[1]=64256;knobs[2]=128064;knobs[3]=128128;knobs[4]=128256;
    knobs[5]=256128;knobs[6]=256256;knobs[7]=32128;knobs[8]=-1;
}
a4_plan :: (item:int,rows:int,width:int,knob:int,plan:[]int) #export_c {
    c:=a4_c(knob,width);m:=a4_m(knob,width);
    plan[0]=rows*c;plan[1]=rows*m;plan[2]=rows*c;
}
a4_pass0 :: (item:int,rows:int,width:int,knob:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) #export_c {
    c:=a4_c(knob,width);r:=item/c;j:=item-r*c;
    n:=(width-j+c-1)/c;h:=n/2;p:=r*width+j;
    s0:f64=0;s1:f64=0;
    for k:0..<h {v0:=f64(x[p]);v1:=f64(x[p+c]);s0+=v0*v0;s1+=v1*v1;p+=2*c;}
    if n%2==1 {v:=f64(x[p]);s0+=v*v;}
    work[item]=s0+s1;
}
a4_pass1 :: (item:int,rows:int,width:int,knob:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) #export_c {
    c:=a4_c(knob,width);m:=a4_m(knob,width);r:=item/m;k:=item-r*m;
    s0:f64=0;s1:f64=0;w:=r*c;
    for j:0..<c/2 {s0+=work[w];s1+=work[w+1];w+=2;}
    if c%2==1 {s0+=work[w];}
    inv:=1/sqrt((s0+s1)/f64(width)+f64(epsilon));
    at:=r*width+k;i:=k;
    for t:0..<(width-k+m-1)/m {
        out[at]=f32(f64(x[at])*inv*(1+f64(scale[i])));
        at+=m;i+=m;
    }
}

a4_t_run :: (knob:int,rows:int,width:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) {
    plan:[3]int;a4_plan(0,rows,width,knob,plan[..]);
    for i:0..<plan[0] {a4_pass0(plan[0]-1-i,rows,width,knob,epsilon,x,scale,work,out);}
    for i:0..<plan[1] {a4_pass1(plan[1]-1-i,rows,width,knob,epsilon,x,scale,work,out);}
}
#test "every knob writes every output within one f32 step of the f64 norm" {
    for width:1..<120 {
        if width>5 && width!=37 && width!=111 {continue;}
        rows:=3;x:[1000]f32;scale:[300]f32;
        for i:0..<rows*width {x[i]=f32((i*7)%23-11)*0.37;}
        for i:0..<width {scale[i]=f32(i%5)/4-0.5;}
        k:[64]int;a4_knobs(0,k[..]);
        for knob:k {
            if knob<0 {break;}
            out:[1000]f32;work:[3072]f64;for i:0..<1000 {out[i]=-99;}
            a4_t_run(knob,rows,width,0.000001,x[..],scale[..],work[..],out[..]);
            for r:0..<rows {
                s:f64=0;for i:0..<width {v:=f64(x[r*width+i]);s+=v*v;}
                d:=sqrt(s/f64(width)+f64(f32(0.000001)));
                for i:0..<width {
                    ref:=f64(x[r*width+i])/d*(1+f64(scale[i]));
                    #assert abs(f64(out[r*width+i])-ref)<=abs(ref)*0.00000012+1e-40;
                }
            }
        }
    }
}
