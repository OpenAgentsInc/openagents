// Agent candidate a5: offset RMS norm, DEVICE-F32-CHUNKED-v1.
// Knob = c*10000 + m*10 + mode. Pass 0 (as a4): c items per row add the
// squares of strided columns in f64 with two accumulators; when the scratch
// allows (rows*c + width <= 1024*rows) the pass-0 items also store
// 1+f64(scale[i]) once per column, so pass 1 loads it instead of converting
// and adding per output. Pass 1 (as a4): m items per row re-add the c
// partials, form inv = 1/sqrt(mean+eps) once and write columns k, k+m, ...
// as f32(f64(x)*inv*(1+scale)). Mode bit 1: f32->f64 widening of x by
// integer bit moves (exact; zero, subnormal, inf and NaN take the cast);
// mode bit 0: the final f64->f32 rounding (to nearest even) by integer bit
// moves (results outside the f32 normal range take the cast). Both give the
// same bits as the casts; they only move work off the f64 conversion path.

a5_min :: (a:int,b:int)->int {if a<b {return a;}return b;}
a5_c :: (knob:int,width:int)->int {return a5_min(knob/10000,width);}
a5_m :: (knob:int,width:int)->int {return a5_min((knob/10)%1000,width);}
a5_pre :: (rows:int,width:int,c:int)->bool {return rows*c+width<=rows*1024;}

a5_widen :: (v:f32)->f64 {
    b:=cast(u64)f32_bits(v);e:=(b>>23)&0xff;
    if e==0 || e==255 {return f64(v);}
    return f64_from_bits(((b>>31)<<63)|((e+896)<<52)|((b&0x7fffff)<<29));
}
a5_narrow :: (y:f64)->f32 {
    B:=f64_bits(y);E:=(B>>52)&0x7ff;
    if E<897 || E>1149 {return f32(y);}
    M:=B&0xfffffffffffff;rest:=M&0x1fffffff;
    w:=((E-896)<<23)|(M>>29);
    if rest>0x10000000 || (rest==0x10000000 && (w&1)==1) {w+=1;}
    return f32_from_bits(cast,trunc(u32)(((B>>63)<<31)|w));
}

a5_knobs :: (item:int,knobs:[]int) #export_c {
    n:=0;
    for ci:0..<2 {for mi:0..<2 {
        base:=(32<<ci)*10000+(128<<mi)*10;
        knobs[n]=base;knobs[n+1]=base+1;knobs[n+2]=base+3;n+=3;
    }}
    knobs[n]=-1;
}
a5_plan :: (item:int,rows:int,width:int,knob:int,plan:[]int) #export_c {
    c:=a5_c(knob,width);m:=a5_m(knob,width);
    plan[0]=rows*c;plan[1]=rows*m;plan[2]=rows*c;
    if a5_pre(rows,width,c) {plan[2]=rows*c+width;}
}
a5_pass0 :: (item:int,rows:int,width:int,knob:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) #export_c {
    c:=a5_c(knob,width);r:=item/c;j:=item-r*c;wide:=(knob&2)!=0;
    n:=(width-j+c-1)/c;h:=n/2;p:=r*width+j;
    s0:f64=0;s1:f64=0;
    if wide {
        for k:0..<h {v0:=a5_widen(x[p]);v1:=a5_widen(x[p+c]);s0+=v0*v0;s1+=v1*v1;p+=2*c;}
        if n%2==1 {v:=a5_widen(x[p]);s0+=v*v;}
    } else {
        for k:0..<h {v0:=f64(x[p]);v1:=f64(x[p+c]);s0+=v0*v0;s1+=v1*v1;p+=2*c;}
        if n%2==1 {v:=f64(x[p]);s0+=v*v;}
    }
    work[item]=s0+s1;
    if a5_pre(rows,width,c) {
        G:=rows*c;
        for t:0..<(width-item+G-1)/G {i:=item+t*G;work[G+i]=1+f64(scale[i]);}
    }
}
a5_pass1 :: (item:int,rows:int,width:int,knob:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) #export_c {
    c:=a5_c(knob,width);m:=a5_m(knob,width);r:=item/m;k:=item-r*m;
    s0:f64=0;s1:f64=0;w:=r*c;
    for j:0..<c/2 {s0+=work[w];s1+=work[w+1];w+=2;}
    if c%2==1 {s0+=work[w];}
    inv:=1/sqrt((s0+s1)/f64(width)+f64(epsilon));
    at:=r*width+k;n:=(width-k+m-1)/m;
    if !a5_pre(rows,width,c) {
        i:=k;
        for t:0..<n {out[at]=f32(f64(x[at])*inv*(1+f64(scale[i])));at+=m;i+=m;}
        return;
    }
    q:=rows*c+k;
    if (knob&3)==3 {
        for t:0..<n {out[at]=a5_narrow(a5_widen(x[at])*inv*work[q]);at+=m;q+=m;}
    } else if (knob&1)==1 {
        for t:0..<n {out[at]=a5_narrow(f64(x[at])*inv*work[q]);at+=m;q+=m;}
    } else {
        for t:0..<n {out[at]=f32(f64(x[at])*inv*work[q]);at+=m;q+=m;}
    }
}

a5_t_run :: (knob:int,rows:int,width:int,epsilon:f32,x:[]f32,scale:[]f32,work:[]f64,out:[]f32) {
    plan:[3]int;a5_plan(0,rows,width,knob,plan[..]);
    for i:0..<plan[0] {a5_pass0(plan[0]-1-i,rows,width,knob,epsilon,x,scale,work,out);}
    for i:0..<plan[1] {a5_pass1(plan[1]-1-i,rows,width,knob,epsilon,x,scale,work,out);}
}
#test "bit widening equals the cast" {
    vals:=[14]f32.[0,-0.0,1,-1,0.1,3.4028235e38,-3.4028235e38,1.17549435e-38,1.0e-45,-2.0e-40,1.5,123456.78,-7.0e-30,6.0e37];
    for v:vals {#assert f64_bits(a5_widen(v))==f64_bits(f64(v));}
    for i:0..<2000 {u:=(cast(u64)i*2654435761)&0xffffffff;if ((u>>23)&0xff)==255 {continue;}
        v:=f32_from_bits(cast,trunc(u32)u);
        if v!=v {continue;}
        #assert f64_bits(a5_widen(v))==f64_bits(f64(v));}
}
#test "bit narrowing equals the cast, ties and range edges included" {
    for i:0..<3000 {
        b:=((cast(u64)((i*7919)%2047))<<52)|(cast(u64)((i*1000003+12345)*7349)%0x10000000000000);y:=f64_from_bits(b);
        if y!=y || abs(y)>3.0e38 {continue;}
        #assert f32_bits(a5_narrow(y))==f32_bits(f32(y));
        // Exact ties and near ties around a random f32.
        f:=f64(f32(y));if f!=f || abs(f)>1e38 || abs(f)<1e-37 {continue;}
        fb:=f64_bits(f);
        for d:0..<5 {
            z:=f64_from_bits(fb+cast(u64)d*0x8000000-0x10000000+0x10000000);
            #assert f32_bits(a5_narrow(z))==f32_bits(f32(z));
            z2:=f64_from_bits(fb+0x10000000);#assert f32_bits(a5_narrow(z2))==f32_bits(f32(z2));
            z3:=f64_from_bits(fb+0x30000000);#assert f32_bits(a5_narrow(z3))==f32_bits(f32(z3));
        }
    }
    edge:=[8]f64.[3.4028234663852886e38,3.4028234e38,3.0e38,1.1754942807573643e-38,1.1754943508222875e-38,1.1754942e-38,-3.4028235e38,0];
    for y:edge {#assert f32_bits(a5_narrow(y))==f32_bits(f32(y));}
}
#test "every knob writes every output within one f32 step of the f64 norm" {
    for width:1..<120 {
        if width>5 && width!=37 && width!=111 {continue;}
        rows:=3;x:[1000]f32;scale:[300]f32;
        for i:0..<rows*width {x[i]=f32((i*7)%23-11)*0.37;}
        x[1]=0;x[2]=3.0e38;
        for i:0..<width {scale[i]=f32(i%5)/4-0.5;}
        k:[64]int;a5_knobs(0,k[..]);
        for knob:k {
            if knob<0 {break;}
            out:[1000]f32;work:[3500]f64;for i:0..<1000 {out[i]=-99;}
            a5_t_run(knob,rows,width,0.000001,x[..],scale[..],work[..],out[..]);
            for r:0..<rows {
                s:f64=0;for i:0..<width {v:=f64(x[r*width+i]);s+=v*v;}
                d:=sqrt(s/f64(width)+f64(f32(0.000001)));
                for i:0..<width {
                    ref:=f64(x[r*width+i])/d*(1+f64(scale[i]));
                    #assert abs(f64(out[r*width+i])-ref)<=abs(ref)*0.00000012+1e-45;
                }
            }
        }
    }
}
