// CPU binary64 row arithmetic. Admitted complete tables come from byte-lm.coax.
BgNorm :: struct {maximum:f64;sum:f64;index:int;}
#test "byte-softmax likelihood and analytic SGD match closed form and finite differences" {
 w:[65536]f64;c:[65536]int;c[1]=2;c[255]=1;n:=bg_norm(w[..],0);#assert n.maximum==0 && n.sum==256 && n.index==0;
 #assert abs(bg_count_loss(c[..],w[..],3)-log(256.0))<1e-14;
 before:=w;bg_update(c[..],w[..],3,2);#assert w[1]==2*(2.0/3.0-1.0/256.0) && w[255]==2*(1.0/3.0-1.0/256.0) && w[0]==-2.0/256.0;
 for i:0..<256 {if i==0 || i==1 || i==255 {plus:=before;minus:=before;plus[i]+=0.000001;minus[i]-=0.000001;finite:=(bg_count_loss(c[..],plus[..],3)-bg_count_loss(c[..],minus[..],3))/0.000002;#assert abs(finite+(w[i]-before[i])/2)<1e-8;}}
}
bg_norm :: (w:[]f64,at:int)->BgNorm {maximum:=w[at];index:=0;for j:1..<256 {if w[at+j]>maximum {maximum=w[at+j];index=j;}}sum:=0.0;for j:0..<256 {sum+=exp(w[at+j]-maximum);}return BgNorm.{maximum=maximum,sum=sum,index=index};}
// book:begin update
bg_update :: (counts:[]int,weights:[]f64,total:int,rate:f64) {
 for row:0..<256 {at:=row*256;n:=bg_row_count(counts,at);if n==0 {continue;}
  norm:=bg_norm(weights,at);
  for j:0..<256 {p:=exp(weights[at+j]-norm.maximum)/norm.sum;gradient:=(f64(n)*p-f64(counts[at+j]))/f64(total);weights[at+j]-=rate*gradient;}
 }
}
// book:end update
bg_count_loss :: (counts:[]int,weights:[]f64,total:int)->f64 {loss:=0.0;for row:0..<256 {at:=row*256;if bg_row_count(counts,at)==0 {continue;}norm:=bg_norm(weights,at);for j:0..<256 {if counts[at+j]!=0 {loss+=f64(counts[at+j])*(log(norm.sum)+norm.maximum-weights[at+j]);}}}return loss/f64(total);}
bg_counts :: (bytes:[]u8,counts:[]int) {for i:0..<65536 {counts[i]=0;}for i:1..<bytes.count {counts[cast(int)bytes[i-1]*256+cast(int)bytes[i]]+=1;}}
BgPick :: struct {token:u8;cutoff:f64;}
bg_sample :: (weights:[]f64,current:u8,u:f64)->BgPick {at:=cast(int)current*256;n:=bg_norm(weights,at);cdf:=0.0;for j:0..<255 {cdf+=exp(weights[at+j]-n.maximum)/n.sum;if u<cdf {return BgPick.{token=cast(u8)j,cutoff=cdf};}}return BgPick.{token=255,cutoff=1};}
#test "categorical byte endpoints cover the real vocabulary and strict CDF ties" {w:[65536]f64;#assert bg_sample(w[..],255,0).token==0 && bg_sample(w[..],0,0.00390625).token==1 && bg_sample(w[..],128,0.999999999).token==255;}

bg_row_count :: (counts:[]int,at:int)->int {n:=0;for j:0..<256 {n+=counts[at+j];}return n;}
#test "normalization chooses the first maximum and returns a stable total and last CDF cutoff" {
 w:[65536]f64;c:[65536]int;w[1]=2;w[2]=2;n:=bg_norm(w[..],0);#assert n.index==1 && n.maximum==2 && abs(n.sum-(2+254*exp(-2.0)))<1e-12;
 w[256+255]=3;#assert bg_sample(w[..],1,0.99).token==255;
 c[1]=2;c[255]=1;bg_update(c[..],w[..],3,1);#assert abs(w[1]-(2-(3/n.sum-2)/3))<1e-12;
 w[256]=0.1;pick:=bg_sample(w[..],1,0.9999999999);#assert pick.token==255 && pick.cutoff==1;
 bytes:=[2]u8.[0,255];c[0]=7;c[1]=9;c[65535]=11;bg_counts(bytes[..],c[..]);#assert c[0]==0 && c[1]==0 && c[255]==1 && c[65535]==0 && bg_row_count(c[..],0)==1;
}
