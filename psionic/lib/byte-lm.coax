#load "byte-lm-math.coax";
#load "counter-rng.coax";
#authority;
BgStatus :: enum u8 {ok;shape;steps;number;capacity;alias;state;}
BgFit :: struct {status:BgStatus;initial:f64;final:f64;updates:int;transitions:int;}
BgMetric :: struct {status:BgStatus;nats:f64;bits:f64;transitions:int;}
BgGeneration :: struct {status:BgStatus;written:int;next:CrSeed;}
#forall "byte-model count and step budgets include exact boundaries" n:0..<66 {
 #assert bg_steps(n)==(n>=1 && n<=64);
}
#test "training validation and state admission precede any public write" {
 #assert bg_data(2) && bg_data(4096) && !bg_data(1) && !bg_data(4097);
 #assert bg_weights(65536) && !bg_weights(65535) && !bg_weights(65537);
 #assert bg_rate(64) && bg_rate(0.01) && !bg_rate(0) && !bg_rate(-1) && !bg_rate(64.0001);
 #assert bg_number(4096) && bg_number(-4096) && !bg_number(4096.01) && !bg_number(-4096.01);
 #assert bg_length(0) && bg_length(256) && !bg_length(-1) && !bg_length(257);
 #assert bg_counter(18446744073709551615,0) && !bg_counter(18446744073709551615,1) && bg_counter(18446744073709551614,1) && !bg_counter(18446744073709551614,2);
 bytes:=[2]u8.[0,255];w:[1]f64;stage:[1]f64;trace:[1]f64;w[0]=-7;trace[0]=-9;
 #assert bg_fit(bytes[..],1,1,w[..],stage[..],trace[..],false).status==BgStatus.shape;
 #assert bg_fit(bytes[0..<1],1,1,w[..],stage[..],trace[..],false).status==BgStatus.shape;
 #assert bg_fit(bytes[..],1,1,w[..],stage[..],trace[..],true).status==BgStatus.alias;
 #assert bg_evaluate(w[..],bytes[..]).status==BgStatus.shape;
 #assert bg_generate(w[..],CrSeed.{},0,1,bytes[..],false).status==BgStatus.shape;
 #assert bg_generate(w[..],CrSeed.{},0,1,bytes[..],true).status==BgStatus.alias;
 #assert w[0]==-7 && trace[0]==-9 && bytes[0]==0 && bytes[1]==255;
}
#test "complete one-step training and byte evaluation match an analytic oracle" {
 bytes:=[4]u8.[0,1,0,1];w:[65536]f64;stage:[65536]f64;trace:[3]f64;trace[2]=-9;stage[0]=7;
 fit:=bg_fit(bytes[..],1,3,w[..],stage[..],trace[0..<2],false);#assert fit.status==BgStatus.ok && fit.updates==1 && fit.transitions==3 && abs(fit.initial-log(256.0))<1e-14 && fit.final<fit.initial && trace[0]==fit.initial && trace[1]==fit.final && trace[2]==-9;
 #assert w[1]==3*(2.0/3.0-2.0/768.0) && w[256]==3*(1.0/3.0-1.0/768.0) && w[65535]==0;
 m:=bg_evaluate(w[..],bytes[..]);#assert m.status==BgStatus.ok && m.transitions==3 && abs(m.nats-fit.final)<1e-14 && abs(m.bits-m.nats/log(2.0))<1e-14;
 out:=[3]u8.[77,77,77];g:=bg_generate(w[..],CrSeed.{seed=7},0,2,out[0..<2],false);#assert g.status==BgStatus.ok && g.written==2 && g.next.seed==7 && g.next.counter==2 && out[0]==95 && out[1]==4 && out[2]==77;
 #assert bg_fit(bytes[0..<1],1,3,w[..],stage[..],trace[..],false).status==BgStatus.shape;
 #assert bg_fit(bytes[..],1,3,w[..],stage[..],trace[0..<1],false).status==BgStatus.capacity;
 #assert bg_fit(bytes[..],0,3,w[..],stage[..],trace[..],false).status==BgStatus.steps;
 #assert bg_fit(bytes[..],1,0,w[..],stage[..],trace[..],false).status==BgStatus.number;
 #assert bg_fit(bytes[..],1,3,w[..],stage[0..<65535],trace[..],false).status==BgStatus.shape;
 #assert bg_evaluate(w[..],bytes[0..<1]).status==BgStatus.shape;
 #assert bg_generate(w[..],CrSeed.{},0,-1,out[..],false).status==BgStatus.shape;
 #assert bg_generate(w[..],CrSeed.{},0,4,out[..],false).status==BgStatus.capacity;
 #assert bg_generate(w[..],CrSeed.{counter=18446744073709551615},0,1,out[..],false).status==BgStatus.state;
 w[65535]=4097;#assert bg_evaluate(w[..],bytes[..]).status==BgStatus.number && bg_generate(w[..],CrSeed.{},0,1,out[..],false).status==BgStatus.number;
}
bg_data :: (n:int)->bool {return n>=2 && n<=4096;}
bg_steps :: (n:int)->bool {return n>=1 && n<=64;}
bg_weights :: (n:int)->bool {return n==65536;}
bg_rate :: (x:f64)->bool {return x>0 && x<=64;}
bg_number :: (x:f64)->bool {return x>=-4096 && x<=4096;}
bg_length :: (n:int)->bool {return n>=0 && n<=256;}
bg_counter :: (counter:u64,n:int)->bool {return cast(u64)n<=(cast(u64)18446744073709551615)-counter;}
// book:begin train
bg_fit :: (train:[]u8,steps:int,rate:f64,weights:[]f64,stage:[]f64,trace:[]f64,overlap:bool)->BgFit #export_c {
 if overlap {return BgFit.{status=BgStatus.alias};}if !bg_data(train.count) || !bg_weights(weights.count) || !bg_weights(stage.count) {return BgFit.{status=BgStatus.shape};}if !bg_steps(steps) {return BgFit.{status=BgStatus.steps};}if !bg_rate(rate) {return BgFit.{status=BgStatus.number};}if trace.count<steps+1 {return BgFit.{status=BgStatus.capacity};}
 counts:[65536]int;bg_counts(train,counts[..]);for i:0..<65536 {stage[i]=0;}losses:[65]f64;total:=train.count-1;losses[0]=bg_count_loss(counts[..],stage,total);
 for step:0..<steps {bg_update(counts[..],stage,total,rate);losses[step+1]=bg_count_loss(counts[..],stage,total);}
 for i:0..<65536 {weights[i]=stage[i];}for i:0..<steps+1 {trace[i]=losses[i];}return BgFit.{initial=losses[0],final=losses[steps],updates=steps,transitions=total};
}
// book:end train
bg_evaluate :: (weights:[]f64,bytes:[]u8)->BgMetric #export_c {
 if !bg_weights(weights.count) || !bg_data(bytes.count) {return BgMetric.{status=BgStatus.shape};}for w:weights {if !bg_number(w) {return BgMetric.{status=BgStatus.number};}}counts:[65536]int;bg_counts(bytes,counts[..]);nats:=bg_count_loss(counts[..],weights,bytes.count-1);return BgMetric.{nats=nats,bits=nats/log(2.0),transitions=bytes.count-1};
}
bg_generate :: (weights:[]f64,seed:CrSeed,start:u8,length:int,out:[]u8,overlap:bool)->BgGeneration #export_c {
 if overlap {return BgGeneration.{status=BgStatus.alias};}if !bg_weights(weights.count) || !bg_length(length) {return BgGeneration.{status=BgStatus.shape};}if out.count<length {return BgGeneration.{status=BgStatus.capacity};}if !bg_counter(seed.counter,length) {return BgGeneration.{status=BgStatus.state};}for w:weights {if !bg_number(w) {return BgGeneration.{status=BgStatus.number};}}
 stage:[256]u8;state:=seed;current:=start;for i:0..<length {draw:=cr_draw(state);current=bg_sample(weights,current,draw.value).token;stage[i]=current;state=draw.next;}for i:0..<length {out[i]=stage[i];}return BgGeneration.{written=length,next=state};
}
