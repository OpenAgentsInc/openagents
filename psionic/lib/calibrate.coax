// Chapter 156: fit our own calibration, and refuse a stale one. Per-question
// maps (a temperature, ten equal-count bins, or isotonic steps) are fitted on
// a calibration split, gated on a second split, and reported on a third, with
// reliability, expected calibration error, Brier, log loss and confident
// errors. A map names the model and question set it was fitted for, and is
// refused for any other.
// Profile cpu-f64-calibrate-v1: binary64, chapter 3's compensated accumulator
// for every sum, yes-or-no questions, 1 to 8,192 rows and 1 to 8 questions.
#load "tabular.coax";
#authority;

CfStatus :: enum u8 {ok;shape;capacity;alias;number;stale;}
CfKind :: enum u8 {none;temperature;binned;isotonic;}
// A piecewise-constant map holds knots and values: p maps to the value of the
// last knot at most p. A temperature map holds the slope a = 1/T.
CfMap :: struct {status:CfStatus;kind:CfKind;model:u64;questions:u64;question:int;slope:f64;knots:int;knot:[256]f64;value:[256]f64;}
CfReport :: struct {status:CfStatus;rows:int;ece:f64;brier:f64;log_loss:f64;confident_errors:int;}
CfValue :: struct {status:CfStatus;value:f64;}

CF_ROWS_MAX :: 8192;
CF_QUESTIONS_MAX :: 8;
CF_BINS :: 10;
CF_MIN_ROWS :: 20;
CF_ECE_BINS :: 15;
CF_KNOTS_MAX :: 256;
CF_FLOOR :: 0.000001;
CF_SLOPE_MIN :: 0.05;
CF_SLOPE_MAX :: 20.0;

// Checks precede the implementation. Expected values are derived in chapter 156.
#test "clamping and logits" {
    #assert cf_clamp(0)==CF_FLOOR && cf_clamp(1)==1-CF_FLOOR && cf_clamp(0.5)==0.5 && cf_clamp(CF_FLOOR)==CF_FLOOR && cf_clamp(1-CF_FLOOR)==1-CF_FLOOR;
    #assert cf_logit(0.5)==0 && cf_logit(0.75)==log(3.0) && cf_logit(0)==log(CF_FLOOR/(1-CF_FLOOR));
}
#test "one question's rows, and a stable sort by probability" {
    q:=[5]int.[1,0,1,1,0];rows:[5]int;
    #assert cf_rows(q[..],1,rows[..])==3 && rows[0]==0 && rows[1]==2 && rows[2]==3 && cf_rows(q[..],2,rows[..])==0;
    p:=[5]f64.[0.5,0.1,0.3,0.5,0.2];all:=[5]int.[0,1,2,3,4];
    cf_sort(p[..],all[..]);
    #assert all[0]==1 && all[1]==4 && all[2]==2 && all[3]==0 && all[4]==3;
}
#test "the temperature's slope: where log loss stops falling" {
    // At logit ln 3 three rows in four are yes, at -ln 3 one in four: slope 1 fits exactly.
    p:=[8]f64.[0.75,0.75,0.75,0.75,0.25,0.25,0.25,0.25];y:=[8]f64.[1,1,1,0,1,0,0,0];rows:=[8]int.[0,1,2,3,4,5,6,7];
    #assert abs(cf_slope(p[..],y[..],rows[..])-1)<=1e-12;
    // Every row right: the loss keeps falling, and the slope stops at 20.
    for i:0..<4 {y[i]=1;y[4+i]=0;}
    #assert cf_slope(p[..],y[..],rows[..])==CF_SLOPE_MAX;
    // Every row wrong: the smallest slope.
    for i:0..<4 {y[i]=0;y[4+i]=1;}
    #assert cf_slope(p[..],y[..],rows[..])==f64_from_bits(f64_bits(CF_SLOPE_MIN)+1);
    // Probabilities of 1/2 carry nothing: the derivative is exactly zero, and the slope reaches 20.
    for i:0..<8 {p[i]=0.5;}
    #assert cf_slope(p[..],y[..],rows[..])==CF_SLOPE_MAX;
}
#test "isotonic steps by hand" {
    p:=[4]f64.[0.1,0.2,0.3,0.4];y:=[4]f64.[1,0,1,1];rows:=[4]int.[0,1,2,3];
    // 1, then 0 pools to 1/2; 1 starts a group; the next 1 ties and pools: knots 0.1 and 0.3.
    m:=cf_steps(CfMap.{},true,p[..],y[..],rows[..]);
    #assert m.status==CfStatus.ok && m.knots==2 && m.knot[0]==0.1 && m.value[0]==0.5 && m.knot[1]==0.3 && m.value[1]==1-CF_FLOOR;
    y[0]=0;m=cf_steps(CfMap.{},true,p[..],y[..],rows[..]);
    #assert m.knots==2 && m.value[0]==CF_FLOOR && m.knot[1]==0.3;
    y[1]=1;m=cf_steps(CfMap.{},true,p[..],y[..],rows[..]);
    #assert m.knots==2 && m.knot[1]==0.2 && m.value[1]==1-CF_FLOOR;
    // 0, 1, 0, 1: the second no pools with the yes before it, giving 0 | 1/2 | 1.
    y[0]=0;y[1]=1;y[2]=0;y[3]=1;m=cf_steps(CfMap.{},true,p[..],y[..],rows[..]);
    #assert m.knots==3 && m.knot[1]==0.2 && m.value[1]==0.5 && m.knot[2]==0.4;
}
#test "ten equal-count bins" {
    p:[200]f64;y:[200]f64;rows:[200]int;
    for i:0..<200 {p[i]=f64(i)/200;y[i]=0;if i%20<i/20 {y[i]=1;}rows[i]=i;}
    m:=cf_steps(CfMap.{},false,p[..],y[..],rows[..]);
    #assert m.status==CfStatus.ok && m.knots==10;
    for b:0..<10 {#assert m.knot[b]==f64(20*b)/200 && m.value[b]==cf_clamp(f64(b)/20);}
    // 205 rows: groups start where i*10/205 changes.
    q:[205]f64;z:[205]f64;r:[205]int;for i:0..<205 {q[i]=f64(i);r[i]=i;}
    m=cf_steps(CfMap.{},false,q[..],z[..],r[..]);
    #assert m.knots==10 && m.knot[1]==21 && m.knot[9]==185;
}
#test "isotonic knots are capped at 256" {
    // Group j is j yes rows then one no: rates j/(j+1) rise, so no group pools with the one before.
    p:[33410]f64;y:[33410]f64;rows:[33410]int;n:=0;
    for j:1..<258 {for i:0..<j+1 {p[n]=f64(n);rows[n]=n;y[n]=1;if i==j {y[n]=0;}n+=1;}}
    m:=cf_steps(CfMap.{},true,p[0..<33152],y[0..<33152],rows[0..<33152]);
    #assert m.status==CfStatus.ok && m.knots==256 && m.value[0]==0.5 && m.value[255]==256.0/257;
    #assert cf_steps(CfMap.{},true,p[..],y[..],rows[..]).status==CfStatus.capacity;
}
#test "fitting: per question, at least 200 rows, refusals" {
    q:[400]int;p:[400]f64;y:[400]f64;rows:[400]int;
    // Rows in falling order of probability, so fitting must sort them.
    for i:0..<400 {q[i]=i%2;p[i]=f64(399-i)/400;y[i]=1;if i>=200 {y[i]=0;}}
    m:=cf_fit(CfKind.binned,7,9,1,q[..],p[..],y[..],rows[..]);
    #assert m.status==CfStatus.ok && m.kind==CfKind.binned && m.model==7 && m.questions==9 && m.question==1 && m.knots==10;
    // Question 1's rows are the odd ones, probabilities 398/400, 396/400, ...: knots at 0, 40/400, ...
    #assert m.knot[0]==0 && m.knot[1]==40.0/400 && m.value[4]==CF_FLOOR && m.value[5]==1-CF_FLOOR;
    t:=cf_fit(CfKind.temperature,7,9,0,q[..],p[..],y[..],rows[..]);
    #assert t.status==CfStatus.ok && t.kind==CfKind.temperature && t.slope==cf_slope(p[..],y[..],rows[0..<cf_rows(q[..],0,rows[..])]);
    i:=cf_fit(CfKind.isotonic,7,9,0,q[..],p[..],y[..],rows[..]);#assert i.status==CfStatus.ok && i.knots==2 && i.knot[1]==201.0/400;
    n:=cf_fit(CfKind.none,7,9,0,q[..],p[..],y[..],rows[..]);#assert n.status==CfStatus.ok && n.kind==CfKind.none && n.slope==1;
    #assert cf_fit(CfKind.binned,7,9,-1,q[..],p[..],y[..],rows[..]).status==CfStatus.shape;
    #assert cf_fit(CfKind.binned,7,9,8,q[..],p[..],y[..],rows[..]).status==CfStatus.shape;
    #assert cf_fit(CfKind.binned,7,9,7,q[..],p[..],y[..],rows[..]).status==CfStatus.shape;
    #assert cf_fit(CfKind.binned,7,9,0,q[0..<399],p[..],y[..],rows[..]).status==CfStatus.shape;
    #assert cf_fit(CfKind.binned,7,9,0,q[..],p[..],y[0..<399],rows[..]).status==CfStatus.shape;
    #assert cf_fit(CfKind.binned,7,9,0,q[0..<0],p[0..<0],y[0..<0],rows[..]).status==CfStatus.shape;
    #assert cf_fit(CfKind.binned,7,9,0,q[..],p[..],y[..],rows[0..<399]).status==CfStatus.capacity;
    // 399 rows leave question 1 with 199.
    #assert cf_fit(CfKind.binned,7,9,1,q[0..<399],p[0..<399],y[0..<399],rows[..]).status==CfStatus.shape;
    #assert cf_fit(CfKind.binned,7,9,0,q[0..<399],p[0..<399],y[0..<399],rows[..]).status==CfStatus.ok;
    q[0]=8;#assert cf_fit(CfKind.binned,7,9,0,q[..],p[..],y[..],rows[..]).status==CfStatus.number;
    q[0]=-1;#assert cf_fit(CfKind.binned,7,9,0,q[..],p[..],y[..],rows[..]).status==CfStatus.number;
    q[0]=0;p[0]=1.5;#assert cf_fit(CfKind.binned,7,9,0,q[..],p[..],y[..],rows[..]).status==CfStatus.number;
    p[0]=-0.5;#assert cf_fit(CfKind.binned,7,9,0,q[..],p[..],y[..],rows[..]).status==CfStatus.number;
    p[0]=0.1;y[0]=0.5;#assert cf_fit(CfKind.binned,7,9,0,q[..],p[..],y[..],rows[..]).status==CfStatus.number;
    big:[8193]f64;bq:[8193]int;br:[8193]int;for k:0..<8193 {bq[k]=k%2;}
    #assert cf_fit(CfKind.none,7,9,0,bq[0..<8192],big[0..<8192],big[0..<8192],br[..]).status==CfStatus.ok;
    #assert cf_fit(CfKind.none,7,9,0,bq[..],big[..],big[..],br[..]).status==CfStatus.shape;
}
#test "applying maps: each kind, and a stale map refused" {
    t:=CfMap.{kind=CfKind.temperature,model=7,questions=9,question=0,slope=2};
    b:=CfMap.{kind=CfKind.binned,model=7,questions=9,question=1,knots=3};
    b.knot[0]=0.1;b.knot[1]=0.5;b.knot[2]=0.8;b.value[0]=0.2;b.value[1]=0.6;b.value[2]=0.9;
    #assert cf_map(t,0.75)==cf_clamp(tb_sigmoid(2*log(3.0))) && cf_map(t,1)==cf_clamp(tb_sigmoid(2*cf_logit(1)));
    #assert cf_map(b,0)==0.2 && cf_map(b,0.4999)==0.2 && cf_map(b,0.5)==0.6 && cf_map(b,0.8)==0.9 && cf_map(b,1)==0.9;
    n:=CfMap.{kind=CfKind.none};#assert cf_map(n,0.3)==0.3;
    i:=b;i.kind=CfKind.isotonic;#assert cf_map(i,0.79)==0.6;
    maps:=[2]CfMap.[t,b];q:=[3]int.[0,1,1];p:=[3]f64.[0.75,0.6,0];out:[3]f64;
    #assert cf_apply(maps[..],7,9,q[..],p[..],out[..],false)==CfStatus.ok && out[0]==cf_map(t,0.75) && out[1]==0.6 && out[2]==0.2;
    #assert cf_apply(maps[..],8,9,q[..],p[..],out[..],false)==CfStatus.stale && cf_apply(maps[..],7,10,q[..],p[..],out[..],false)==CfStatus.stale;
    #assert cf_apply(maps[0..<1],7,9,q[..],p[..],out[..],false)==CfStatus.number;
    #assert cf_apply(maps[0..<0],7,9,q[..],p[..],out[..],false)==CfStatus.shape;
    #assert cf_apply(maps[..],7,9,q[0..<2],p[..],out[..],false)==CfStatus.shape && cf_apply(maps[..],7,9,q[0..<0],p[0..<0],out[..],false)==CfStatus.shape;
    #assert cf_apply(maps[..],7,9,q[0..<1],p[0..<1],out[..],false)==CfStatus.ok;
    #assert cf_apply(maps[..],7,9,q[..],p[..],out[0..<2],false)==CfStatus.capacity && cf_apply(maps[..],7,9,q[..],p[..],out[..],true)==CfStatus.alias;
    swapped:=[2]CfMap.[b,t];#assert cf_apply(swapped[..],7,9,q[..],p[..],out[..],false)==CfStatus.shape;
    bad:=maps;bad[1].status=CfStatus.capacity;#assert cf_apply(bad[..],7,9,q[..],p[..],out[..],false)==CfStatus.shape;
    bad=maps;bad[1].model=8;#assert cf_apply(bad[..],7,9,q[..],p[..],out[..],false)==CfStatus.stale;
    q[2]=-1;#assert cf_apply(maps[..],7,9,q[..],p[..],out[..],false)==CfStatus.number;
    q[2]=1;p[2]=1.5;#assert cf_apply(maps[..],7,9,q[..],p[..],out[..],false)==CfStatus.number;
    p[2]=-1e-300;#assert cf_apply(maps[..],7,9,q[..],p[..],out[..],false)==CfStatus.number;
    nine:[9]CfMap;for k:0..<9 {nine[k]=CfMap.{model=7,questions=9,question=k};}
    #assert cf_apply(nine[0..<8],7,9,q[..],p[0..<3],out[..],false)==CfStatus.number;
    p[2]=0;#assert cf_apply(nine[0..<8],7,9,q[..],p[..],out[..],false)==CfStatus.ok && out[2]==0;
    #assert cf_apply(nine[..],7,9,q[..],p[..],out[..],false)==CfStatus.shape;
    big:[8193]f64;bq:[8193]int;bo:[8193]f64;
    #assert cf_apply(nine[0..<1],7,9,bq[0..<8192],big[0..<8192],bo[..],false)==CfStatus.ok && cf_apply(nine[0..<1],7,9,bq[..],big[..],bo[..],false)==CfStatus.shape;
}
#test "measuring by hand" {
    p:=[4]f64.[0.95,0.5,0.2,0.7];y:=[4]f64.[0,1,0,1];rows:=[4]int.[0,1,2,3];
    r:=cf_measure(p[..],y[..],rows[..]);
    // Tops 0.95 (wrong), 0.5, 0.8 and 0.7 (right), each alone in its bin.
    #assert r.status==CfStatus.ok && r.rows==4 && r.confident_errors==1;
    #assert abs(r.ece-(0.95+0.5+0.2+0.3)/4)<=1e-15;
    #assert abs(r.brier-2*(0.95*0.95+0.25+0.04+0.09)/4)<=1e-15;
    #assert abs(r.log_loss-(-log(0.05)-log(0.5)-log(0.8)-log(0.7))/4)<=1e-15;
    // Two rows in one bin: |0.7 + 0.75 - 1| over 2.
    p[0]=0.75;y[0]=0;r=cf_measure(p[0..<4],y[..],rows[0..<4]);#assert r.confident_errors==0;
    p[0]=0.72;two:=[2]int.[0,3];r=cf_measure(p[..],y[..],two[..]);#assert abs(r.ece-abs(0.72+0.7-1)/2)<=1e-15;
    // 0.9 is confident; 0.8999 is not; top label 0.5 means yes.
    p[0]=0.9;r=cf_measure(p[..],y[..],rows[..]);#assert r.confident_errors==1;
    p[0]=0.1;y[0]=1;r=cf_measure(p[..],y[..],rows[..]);#assert r.confident_errors==1;
    p[0]=0.8999;y[0]=0;r=cf_measure(p[..],y[..],rows[..]);#assert r.confident_errors==0;
    // A top label exactly on a bin edge, 12/15, stays in the lower bin with 0.75's neighbors.
    e:=[2]f64.[0.8,0.25];f:=[2]f64.[1,0];both:=[2]int.[0,1];r=cf_measure(e[..],f[..],both[..]);
    #assert abs(r.ece-abs(0.8+0.75-2)/2)<=1e-15;
    e[0]=0.8000000000000002;r=cf_measure(e[..],f[..],both[..]);#assert abs(r.ece-(0.2+0.25)/2)<=1e-15;
    // Neighboring bins: 0.5 and 0.52 share bin 7, right; 0.6 is bin 8 and 0.62 bin 9, both wrong.
    g:=[4]f64.[0.5,0.52,0.6,0.62];h:=[4]f64.[1,1,0,0];all:=[4]int.[0,1,2,3];r=cf_measure(g[..],h[..],all[..]);
    #assert abs(r.ece-(abs(0.5+0.52-2)+0.6+0.62)/4)<=1e-15;
    // Log loss of a 0 or a 1 is clamped.
    e[0]=1;e[1]=1;f[1]=0;r=cf_measure(e[..],f[..],both[..]);#assert abs(r.log_loss-(-log(1-CF_FLOOR)-log(1-(1-CF_FLOOR)))/2)<=1e-15;
    #assert cf_measure(p[0..<3],y[..],rows[0..<3]).status==CfStatus.shape && cf_measure(p[..],y[..],rows[0..<0]).status==CfStatus.shape;
    p[1]=1.5;#assert cf_measure(p[..],y[..],rows[..]).status==CfStatus.number;
    p[1]=0.5;y[1]=0.5;#assert cf_measure(p[..],y[..],rows[..]).status==CfStatus.number;
    y[1]=1;p[2]=-1;#assert cf_measure(p[..],y[..],rows[..]).status==CfStatus.number;
}
#test "reliability: ten bins, none reported under 20 rows" {
    p:[45]f64;y:[45]f64;rows:[45]int;
    for i:0..<45 {rows[i]=i;p[i]=0.05;y[i]=0;if i<5 {y[i]=1;}}
    for i:20..<40 {p[i]=0.95;y[i]=1;if i<22 {y[i]=0;}}
    for i:40..<45 {p[i]=1;}
    p[19]=0.1;p[39]=0.9;
    count:[10]int;mean:[10]f64;rate:[10]f64;
    #assert cf_reliability(p[..],y[..],rows[..],count[..],mean[..],rate[..],false)==CfStatus.ok;
    #assert count[0]==19 && count[1]==1 && count[9]==25 && count[8]==0 && rate[0]==-1 && mean[0]==-1 && rate[1]==-1;
    #assert abs(mean[9]-(19*0.95+0.9+5)/25)<=1e-15 && rate[9]==18.0/25;
    p[19]=0.05;#assert cf_reliability(p[..],y[..],rows[..],count[..],mean[..],rate[..],false)==CfStatus.ok && count[0]==20 && rate[0]==0.25;
    #assert cf_reliability(p[0..<44],y[..],rows[0..<44],count[..],mean[..],rate[..],false)==CfStatus.shape;
    #assert cf_reliability(p[..],y[..],rows[..],count[0..<9],mean[..],rate[..],false)==CfStatus.capacity;
    #assert cf_reliability(p[..],y[..],rows[..],count[..],mean[0..<9],rate[..],false)==CfStatus.capacity;
    #assert cf_reliability(p[..],y[..],rows[..],count[..],mean[..],rate[0..<9],false)==CfStatus.capacity;
    #assert cf_reliability(p[..],y[..],rows[..],count[..],mean[..],rate[..],true)==CfStatus.alias;
    p[3]=1.5;#assert cf_reliability(p[..],y[..],rows[..],count[..],mean[..],rate[..],false)==CfStatus.number;
    p[3]=0.05;y[3]=2;#assert cf_reliability(p[..],y[..],rows[..],count[..],mean[..],rate[..],false)==CfStatus.number;
}
#test "the gate: lower calibration error and lower log loss, both" {
    raw:=CfReport.{ece=0.1,log_loss=0.5};m:=CfReport.{ece=0.05,log_loss=0.4};
    #assert cf_gate(raw,m);
    m.ece=0.1;#assert !cf_gate(raw,m);
    m.ece=0.05;m.log_loss=0.5;#assert !cf_gate(raw,m);
    m.log_loss=0.4;m.status=CfStatus.shape;#assert !cf_gate(raw,m);
    m.status=CfStatus.ok;raw.status=CfStatus.shape;#assert !cf_gate(raw,m);
}
#test "the simulator at its counters" {
    model:=[4]f64.[2,0.5,-1,0];q:=[8]int.[-7,-7,-7,-7,-7,-7,-7,-7];p:=[8]f64.[-7,-7,-7,-7,-7,-7,-7,-7];y:=[8]f64.[-7,-7,-7,-7,-7,-7,-7,-7];
    #assert cf_simulate(5,model[..],q[..],p[..],y[..],false)==CfStatus.ok;
    for i:0..<8 {
        k:=i%2;l:=6*tb_uniform(5,cast(u64)(2*i))-3;
        #assert q[i]==k && y[i]==floor(tb_uniform(5,cast(u64)(2*i+1))+tb_sigmoid(l)) && p[i]==tb_sigmoid(model[2*k]*l+model[2*k+1]);
    }
    #assert cf_simulate(5,model[0..<3],q[..],p[..],y[..],false)==CfStatus.shape && cf_simulate(5,model[..],q[..],p[0..<0],y[..],false)==CfStatus.shape;
    #assert cf_simulate(5,model[..],q[0..<7],p[..],y[..],false)==CfStatus.capacity && cf_simulate(5,model[..],q[..],p[..],y[0..<7],false)==CfStatus.capacity;
    #assert cf_simulate(5,model[..],q[..],p[0..<1],y[..],false)==CfStatus.ok;
    #assert cf_simulate(5,model[..],q[..],p[..],y[..],true)==CfStatus.alias;
    model[3]=8;#assert cf_simulate(5,model[..],q[..],p[..],y[..],false)==CfStatus.ok;
    model[3]=-8;#assert cf_simulate(5,model[..],q[..],p[..],y[..],false)==CfStatus.ok;
    model[3]=8.5;#assert cf_simulate(5,model[..],q[..],p[..],y[..],false)==CfStatus.number;
    model[3]=-8.5;#assert cf_simulate(5,model[..],q[..],p[..],y[..],false)==CfStatus.number;
    big:[8193]f64;bq:[8193]int;bl:[8193]f64;model[3]=0;
    #assert cf_simulate(5,model[..],bq[..],big[0..<8192],bl[..],false)==CfStatus.ok && cf_simulate(5,model[..],bq[..],big[..],bl[..],false)==CfStatus.shape;
    // Calibrated by construction when the scale is 1 and the shift 0: yes as often as the mean probability.
    model[0]=1;model[1]=0;#assert cf_simulate(6,model[..],bq[0..<8192],big[0..<8192],bl[0..<8192],false)==CfStatus.ok;
    s:PsionicAccumulator;yes:=0;for i:0..<8192 {if bq[i]==0 {s=psionic_ops_accumulate(s,big[i]);if bl[i]==1 {yes+=1;}}}
    #assert abs(f64(yes)-psionic_ops_total(s))<=4*32;
}

// Probabilities are kept within [10^-6, 1 - 10^-6], so every logit and log loss is finite.
// Outside that range, p (always within [0, 1]) rounds to the nearer end.
cf_clamp :: (p:f64)->f64 {
    if tb_in(p,CF_FLOOR,1-CF_FLOOR) {return p;}
    ends:=[2]f64.[CF_FLOOR,1-CF_FLOOR];
    return ends[cast(int)floor(p+0.5)];
}
cf_logit :: (p:f64)->f64 {q:=cf_clamp(p);return log(q/(1-q));}

// Rows of one question, as indices, in row order.
cf_rows :: (question:[]int,k:int,out:[]int)->int {
    n:=0;
    for i:0..<question.count {if question[i]==k {out[n]=i;n+=1;}}
    return n;
}
// Stable insertion sort of row indices by probability.
cf_sort :: (p:[]f64,rows:[]int) {
    for i:1..<rows.count {
        r:=rows[i];j:=i;
        while j>0 && p[rows[j-1]]>p[r] {rows[j]=rows[j-1];j-=1;}
        rows[j]=r;
    }
}

// book:begin fit
// Temperature: the slope a minimizing log loss of sigmoid(a z) over z = logit(p).
// The loss is convex in a, so its derivative sum (sigmoid(a z) - y) z rises
// with a; halving finds where it crosses zero, within [0.05, 20]. A
// derivative of exactly zero counts as still falling.
cf_slope :: (p:[]f64,y:[]f64,rows:[]int)->f64 {
    lo:=CF_SLOPE_MIN;hi:=CF_SLOPE_MAX;
    while true {
        mid:=(lo+hi)/2;
        if mid==lo || mid==hi {break;}
        g:PsionicAccumulator;
        for r:rows {z:=cf_logit(p[r]);g=psionic_ops_accumulate(g,(tb_sigmoid(mid*z)-y[r])*z);}
        if psionic_ops_total(g)>0 {hi=mid;} else {lo=mid;}
    }
    return hi;
}
// Binned: ten groups of equal count by probability, each mapped to its rate of yes.
// Isotonic: pool adjacent groups while a rate fails to rise (pool-adjacent-violators).
// Both knots are a group's smallest probability; rates are compared as integers.
cf_steps :: (map:CfMap,isotonic:bool,p:[]f64,y:[]f64,rows:[]int)->CfMap {
    m:=map;
    // One more group than a map holds, for the row that may yet pool.
    n:=rows.count;yes:[257]int;count:[257]int;knot:[257]f64;k:=0;
    for i:0..<n {
        r:=rows[i];
        // A new group starts at every row (isotonic) or every tenth of the rows (binned).
        start:=isotonic || i*CF_BINS/n!=(i-1)*CF_BINS/n || i==0;
        if start {knot[k]=p[r];yes[k]=0;count[k]=0;k+=1;}
        yes[k-1]+=cast(int)y[r];count[k-1]+=1;
        while isotonic && k>1 && yes[k-2]*count[k-1]>=yes[k-1]*count[k-2] {
            yes[k-2]+=yes[k-1];count[k-2]+=count[k-1];k-=1;
        }
        if k>CF_KNOTS_MAX {return CfMap.{status=CfStatus.capacity};}
    }
    for j:0..<k {m.knot[j]=knot[j];m.value[j]=cf_clamp(f64(yes[j])/f64(count[j]));}
    m.knots=k;
    return m;
}
cf_fit :: (kind:CfKind,model:u64,questions:u64,question:int,q:[]int,p:[]f64,y:[]f64,rows:[]int)->CfMap #export_c {
    n:=p.count;
    // A question outside [0, 8) has no rows, and is refused with the rest below 200.
    if n>CF_ROWS_MAX || q.count!=n || y.count!=n || cast(int)kind>cast(int)CfKind.isotonic {return CfMap.{status=CfStatus.shape};}
    if rows.count<n {return CfMap.{status=CfStatus.capacity};}
    if !cf_rows_ok(q,p,y) {return CfMap.{status=CfStatus.number};}
    m:=CfMap.{kind=kind,model=model,questions=questions,question=question,slope=1};
    own:=rows[0..<cf_rows(q,question,rows)];
    if own.count<CF_BINS*CF_MIN_ROWS {return CfMap.{status=CfStatus.shape};}
    if kind==CfKind.temperature {m.slope=cf_slope(p,y,own);}
    if kind==CfKind.binned || kind==CfKind.isotonic {
        cf_sort(p,own);m=cf_steps(m,kind==CfKind.isotonic,p,y,own);
    }
    return m;
}
// book:end fit

// Questions in [0, 8), probabilities in [0, 1], labels exactly 0 or 1.
cf_rows_ok :: (q:[]int,p:[]f64,y:[]f64)->bool {
    for i:0..<p.count {
        if q[i]<0 || q[i]>=CF_QUESTIONS_MAX || !tb_in(p[i],0,1) {return false;}
        if y[i]!=0 && y[i]!=1 {return false;}
    }
    return true;
}

// book:begin apply
// A map applies only to the model and question set it was fitted for.
cf_map :: (m:CfMap,p:f64)->f64 {
    if m.kind==CfKind.none {return p;}
    if m.kind==CfKind.temperature {return cf_clamp(tb_sigmoid(m.slope*cf_logit(p)));}
    k:=0;
    for j:1..<m.knots {if m.knot[j]<=p {k=j;}}
    return m.value[k];
}
cf_apply :: (maps:[]CfMap,model:u64,questions:u64,q:[]int,p:[]f64,out:[]f64,overlap:bool)->CfStatus #export_c {
    n:=p.count;
    if n<1 || n>CF_ROWS_MAX || q.count!=n || maps.count<1 || maps.count>CF_QUESTIONS_MAX {return CfStatus.shape;}
    if out.count<n {return CfStatus.capacity;}
    if overlap {return CfStatus.alias;}
    for m,k:maps {
        if m.status!=CfStatus.ok || m.question!=k {return CfStatus.shape;}
        if m.model!=model || m.questions!=questions {return CfStatus.stale;}
    }
    for i:0..<n {
        if q[i]<0 || q[i]>=maps.count || !tb_in(p[i],0,1) {return CfStatus.number;}
        out[i]=cf_map(maps[q[i]],p[i]);
    }
    return CfStatus.ok;
}
// book:end apply

// book:begin measure
// Expected calibration error as chapter 12 measures it (top label, 15 equal
// bins (b/15, (b+1)/15]), Brier summed over both answers, log loss, and
// confident errors: a top label of at least 0.9 that is wrong.
cf_measure :: (p:[]f64,y:[]f64,rows:[]int)->CfReport #export_c {
    if p.count!=y.count || !tb_row_ok(rows,p.count) {return CfReport.{status=CfStatus.shape};}
    for r:rows {if !tb_in(p[r],0,1) || (y[r]!=0 && y[r]!=1) {return CfReport.{status=CfStatus.number};}}
    conf:[15]PsionicAccumulator;hit:[15]int;brier:PsionicAccumulator;loss:PsionicAccumulator;
    report:=CfReport.{rows=rows.count};
    for r:rows {
        // The top label is at least 1/2, so only bins 7 to 14 can hold it.
        v:=p[r];top:=0.5+abs(v-0.5);
        right:=(v>=0.5)==(y[r]==1);
        b:=7;while top>f64(b+1)/CF_ECE_BINS {b+=1;}
        conf[b]=psionic_ops_accumulate(conf[b],top);if right {hit[b]+=1;}
        if top>=0.9 && !right {report.confident_errors+=1;}
        e:=v-y[r];brier=psionic_ops_accumulate(brier,2*e*e);
        c:=cf_clamp(v);if y[r]==0 {c=1-c;}
        loss=psionic_ops_accumulate(loss,-log(c));
    }
    ece:PsionicAccumulator;
    for b:7..<CF_ECE_BINS {ece=psionic_ops_accumulate(ece,abs(psionic_ops_total(conf[b])-f64(hit[b])));}
    n:=f64(rows.count);
    report.ece=psionic_ops_total(ece)/n;report.brier=psionic_ops_total(brier)/n;report.log_loss=psionic_ops_total(loss)/n;
    return report;
}
// Reliability: ten equal-width bins of p, each with its count, mean
// probability and rate of yes. A bin under 20 rows reports a rate of -1.
cf_reliability :: (p:[]f64,y:[]f64,rows:[]int,count:[]int,mean:[]f64,rate:[]f64,overlap:bool)->CfStatus #export_c {
    if p.count!=y.count || !tb_row_ok(rows,p.count) {return CfStatus.shape;}
    if count.count<CF_BINS || mean.count<CF_BINS || rate.count<CF_BINS {return CfStatus.capacity;}
    if overlap {return CfStatus.alias;}
    for r:rows {if !tb_in(p[r],0,1) || (y[r]!=0 && y[r]!=1) {return CfStatus.number;}}
    s:[10]PsionicAccumulator;yes:[10]int;
    for b:0..<CF_BINS {count[b]=0;}
    for r:rows {
        b:=cast(int)(p[r]*CF_BINS);if b==CF_BINS {b=CF_BINS-1;}
        count[b]+=1;s[b]=psionic_ops_accumulate(s[b],p[r]);yes[b]+=cast(int)y[r];
    }
    for b:0..<CF_BINS {
        mean[b]=-1;rate[b]=-1;
        if count[b]>=CF_MIN_ROWS {mean[b]=psionic_ops_total(s[b])/f64(count[b]);rate[b]=f64(yes[b])/f64(count[b]);}
    }
    return CfStatus.ok;
}
// The frozen gate: a map is served only if it lowers both calibration error
// and log loss from the raw probabilities on the gate split.
cf_gate :: (raw:CfReport,mapped:CfReport)->bool #export_c {
    return raw.status==CfStatus.ok && mapped.status==CfStatus.ok && mapped.ece<raw.ece && mapped.log_loss<raw.log_loss;
}
// book:end measure

// book:begin simulate
// calibrate-sim-v1. Row i asks question i mod 2; its true logit is uniform in
// [-3, 3] at counter 2i, its label yes with that probability at 2i+1 (yes when
// u + p reaches 1). The model reports sigmoid(scale * logit + shift), with a
// scale and shift per question: model = [scale0, shift0, scale1, shift1].
cf_simulate :: (seed:u64,model:[]f64,q:[]int,p:[]f64,y:[]f64,overlap:bool)->CfStatus #export_c {
    n:=p.count;
    if n<1 || n>CF_ROWS_MAX || model.count!=4 {return CfStatus.shape;}
    if q.count<n || y.count<n {return CfStatus.capacity;}
    if overlap {return CfStatus.alias;}
    for v:model {if !tb_in(v,-8,8) {return CfStatus.number;}}
    for i:0..<n {
        k:=i%2;l:=6*tb_uniform(seed,cast(u64)(2*i))-3;
        q[i]=k;y[i]=floor(tb_uniform(seed,cast(u64)(2*i+1))+tb_sigmoid(l));
        p[i]=tb_sigmoid(model[2*k]*l+model[2*k+1]);
    }
    return CfStatus.ok;
}
// book:end simulate
