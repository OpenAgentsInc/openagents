// Checkpoint records (psionic-checkpoint-v1). A checkpoint is an explicit
// little-endian byte record, never a raw C struct:
//   "PSCK" u16 version=1 u16 count-width=4
//   model, tokenizer, dataset, optimizer identities, parent digest: 5 x 32 bytes
//   revision u64 (training steps taken; at least the optimizer's applied steps)
//   data cursor: seed u64, epoch u64, order u64, offset u64
//   optimizer: step u64, skipped u64
//   n u32, then n binary64 parameters, n first moments, n second moments
//   SHA-256 (tag psionic.checkpoint.v1) of every byte before it
// A pointer names the checkpoint to resume from by revision and digest:
//   "PSCP" u16 version=1 u16 0, revision u64, checkpoint digest, SHA-256 (tag
//   psionic.checkpoint-pointer.v1) of the bytes before it: 80 bytes.
// Native code reads and atomically publishes the bytes; Coax decides them.
#load "../data/pack.coax";
#load "../optim/adamw.coax";
#authority;
CkStatus :: enum u8 {ok;shape;truncated;magic;version;corrupt;model;tokenizer;dataset;optimizer;number;stale;alias;}
CkIds :: struct {model:[32]u8;tokenizer:[32]u8;dataset:[32]u8;optimizer:[32]u8;}
CkMeta :: struct {ids:CkIds;parent:[32]u8;revision:int;cursor:PkCursor;state:AwState;}
CkRead :: struct {status:CkStatus;meta:CkMeta;digest:[32]u8;}
CkPointer :: struct {status:CkStatus;revision:int;digest:[32]u8;}
CK_HEAD :: 228;
CK_VALUES :: 4096;
CK_POINTER :: 80;

ck_size :: (n:int)->int {return CK_HEAD+24*n+32;}
ck_put64 :: (b:[]u8,at:int,x:u64)->int {for i:0..<8 {b[at+i]=cast(u8)((x>>cast(u64)(8*i))&255);}return at+8;}
ck_get64 :: (b:[]u8,at:int)->u64 {x:=cast(u64)0;for i:0..<8 {x|=cast(u64)b[at+i]<<cast(u64)(8*i);}return x;}
ck_put32 :: (b:[]u8,at:int,x:int)->int {b[at]=cast(u8)(x&255);b[at+1]=cast(u8)((x>>8)&255);b[at+2]=cast(u8)((x>>16)&255);b[at+3]=cast(u8)((x>>24)&255);return at+4;}
ck_get32 :: (b:[]u8,at:int)->int {return cast(int)b[at]|cast(int)b[at+1]<<8|cast(int)b[at+2]<<16|cast(int)b[at+3]<<24;}
ck_put :: (b:[]u8,at:int,x:[32]u8)->int {for i:0..<32 {b[at+i]=x[i];}return at+32;}
ck_get :: (b:[]u8,at:int)->[32]u8 {x:[32]u8;for i:0..<32 {x[i]=b[at+i];}return x;}
ck_equal :: (a:[32]u8,b:[32]u8)->bool {for i:0..<32 {if a[i]!=b[i] {return false;}}return true;}
ck_digest :: (tag:string,b:[]u8)->[32]u8 {d:[32]u8;s:=sha256_tagged_checked(tag,b,d[..],false);#assert s==SHA_OK;return d;}
ck_magic :: (b:[]u8,a:u8,c:u8)->bool {return b[0]==cast(u8)80 && b[1]==cast(u8)83 && b[2]==a && b[3]==c;}
ck_finite :: (x:f64)->bool {return aw_finite(x);}
// Finite and, for a second moment, not negative (-0 is zero), read from the bits.
ck_bits :: (x:u64,second:bool)->bool {if (x>>52)&0x7ff==0x7ff {return false;}return !second || x>>63==0 || x==0x8000000000000000;}
ck_shape :: (n:int,m:int,v:int,out:int)->bool {return n>=1 && n<=CK_VALUES && m==n && v==n && out==ck_size(n);}

// book:begin write
// Writes the whole record into out (exactly ck_size(n) bytes) or nothing.
ck_write :: (meta:CkMeta,params:[]f64,m:[]f64,v:[]f64,out:[]u8,overlap:bool)->CkStatus #export_c {
    if overlap {return CkStatus.alias;}
    n:=params.count;if !ck_shape(n,m.count,v.count,out.count) {return CkStatus.shape;}
    if meta.revision<meta.state.step || meta.revision>=AW_STEPS || !aw_state(meta.state) || meta.cursor.epoch<0 || meta.cursor.order<0 || meta.cursor.offset<0 {return CkStatus.corrupt;}
    for i:0..<n {if !ck_finite(params[i]) || !ck_finite(m[i]) || !ck_finite(v[i]) || v[i]<0 {return CkStatus.number;}}
    b:[98564]u8;b[0]=80;b[1]=83;b[2]=67;b[3]=75;b[4]=1;b[6]=4;at:=8;
    at=ck_put(b[..],at,meta.ids.model);at=ck_put(b[..],at,meta.ids.tokenizer);at=ck_put(b[..],at,meta.ids.dataset);at=ck_put(b[..],at,meta.ids.optimizer);at=ck_put(b[..],at,meta.parent);
    at=ck_put64(b[..],at,cast(u64)meta.revision);
    at=ck_put64(b[..],at,meta.cursor.seed);at=ck_put64(b[..],at,cast(u64)meta.cursor.epoch);at=ck_put64(b[..],at,cast(u64)meta.cursor.order);at=ck_put64(b[..],at,cast(u64)meta.cursor.offset);
    at=ck_put64(b[..],at,cast(u64)meta.state.step);at=ck_put64(b[..],at,cast(u64)meta.state.skipped);
    at=ck_put32(b[..],at,n);
    for i:0..<n {at=ck_put64(b[..],at,f64_bits(params[i]));}for i:0..<n {at=ck_put64(b[..],at,f64_bits(m[i]));}for i:0..<n {at=ck_put64(b[..],at,f64_bits(v[i]));}
    d:=ck_digest("psionic.checkpoint.v1",b[0..<at]);at=ck_put(b[..],at,d);
    for i:0..<at {out[i]=b[i];}return CkStatus.ok;
}
// book:end write

// book:begin read
// Admits a whole record against the identities the run expects, then writes
// the values. Refusals write nothing.
ck_read :: (bytes:[]u8,expect:CkIds,params:[]f64,m:[]f64,v:[]f64,overlap:bool)->CkRead #export_c {
    if overlap {return CkRead.{status=CkStatus.alias};}
    if bytes.count<ck_size(0) {return CkRead.{status=CkStatus.truncated};}
    if !ck_magic(bytes,67,75) {return CkRead.{status=CkStatus.magic};}
    if bytes[4]!=1 || bytes[5]!=0 || bytes[6]!=4 || bytes[7]!=0 {return CkRead.{status=CkStatus.version};}
    n:=ck_get32(bytes,CK_HEAD-4);if n<1 || n>CK_VALUES {return CkRead.{status=CkStatus.corrupt};}
    if bytes.count<ck_size(n) {return CkRead.{status=CkStatus.truncated};}
    if bytes.count>ck_size(n) {return CkRead.{status=CkStatus.corrupt};}
    body:=ck_size(n)-32;d:=ck_digest("psionic.checkpoint.v1",bytes[0..<body]);if !ck_equal(d,ck_get(bytes,body)) {return CkRead.{status=CkStatus.corrupt};}
    meta:=CkMeta.{ids=CkIds.{model=ck_get(bytes,8),tokenizer=ck_get(bytes,40),dataset=ck_get(bytes,72),optimizer=ck_get(bytes,104)},parent=ck_get(bytes,136)};
    if !ck_equal(meta.ids.model,expect.model) {return CkRead.{status=CkStatus.model};}
    if !ck_equal(meta.ids.tokenizer,expect.tokenizer) {return CkRead.{status=CkStatus.tokenizer};}
    if !ck_equal(meta.ids.dataset,expect.dataset) {return CkRead.{status=CkStatus.dataset};}
    if !ck_equal(meta.ids.optimizer,expect.optimizer) {return CkRead.{status=CkStatus.optimizer};}
    if params.count!=n || m.count!=n || v.count!=n {return CkRead.{status=CkStatus.shape};}
    // Every field must fit the run's integers before it is believed.
    top:=cast(u64)1099511627775;words:[7]u64;for i:0..<7 {words[i]=ck_get64(bytes,168+8*i);}
    for i:0..<7 {if i!=1 && words[i]>top {return CkRead.{status=CkStatus.corrupt};}}
    meta.revision=cast(int)words[0];meta.cursor=PkCursor.{seed=words[1],epoch=cast(int)words[2],order=cast(int)words[3],offset=cast(int)words[4]};meta.state=AwState.{step=cast(int)words[5],skipped=cast(int)words[6]};
    if meta.revision<meta.state.step || !aw_state(meta.state) {return CkRead.{status=CkStatus.corrupt};}
    at:=CK_HEAD;
    for i:0..<3*n {if !ck_bits(ck_get64(bytes,at+8*i),i>=2*n) {return CkRead.{status=CkStatus.number};}}
    for i:0..<n {params[i]=f64_from_bits(ck_get64(bytes,at+8*i));m[i]=f64_from_bits(ck_get64(bytes,at+8*(n+i)));v[i]=f64_from_bits(ck_get64(bytes,at+8*(2*n+i)));}
    return CkRead.{meta=meta,digest=d};
}
// book:end read
ck_pointer_write :: (revision:int,digest:[32]u8,out:[]u8)->CkStatus #export_c {
    if out.count!=CK_POINTER {return CkStatus.shape;}if revision<0 {return CkStatus.corrupt;}
    b:[80]u8;b[0]=80;b[1]=83;b[2]=67;b[3]=80;b[4]=1;at:=ck_put64(b[..],8,cast(u64)revision);at=ck_put(b[..],at,digest);
    d:=ck_digest("psionic.checkpoint-pointer.v1",b[0..<48]);at=ck_put(b[..],at,d);for i:0..<80 {out[i]=b[i];}return CkStatus.ok;
}
ck_pointer_read :: (bytes:[]u8)->CkPointer #export_c {
    if bytes.count<CK_POINTER {return CkPointer.{status=CkStatus.truncated};}if bytes.count>CK_POINTER {return CkPointer.{status=CkStatus.corrupt};}
    if !ck_magic(bytes,67,80) {return CkPointer.{status=CkStatus.magic};}
    if bytes[4]!=1 || bytes[5]!=0 || bytes[6]!=0 || bytes[7]!=0 {return CkPointer.{status=CkStatus.version};}
    if !ck_equal(ck_digest("psionic.checkpoint-pointer.v1",bytes[0..<48]),ck_get(bytes,48)) {return CkPointer.{status=CkStatus.corrupt};}
    r:=ck_get64(bytes,8);if r>cast(u64)1099511627775 {return CkPointer.{status=CkStatus.corrupt};}
    return CkPointer.{revision=cast(int)r,digest=ck_get(bytes,16)};
}
// A pointer is current only for the checkpoint it names: same digest and
// revision. Anything else is a stale pointer and is refused.
ck_current :: (p:CkPointer,c:CkRead)->CkStatus #export_c {
    if p.status!=CkStatus.ok {return p.status;}if c.status!=CkStatus.ok {return c.status;}
    if p.revision!=c.meta.revision || !ck_equal(p.digest,c.digest) {return CkStatus.stale;}
    return CkStatus.ok;
}

ck_fill :: (k:u8)->[32]u8 {x:[32]u8;for i:0..<32 {x[i]=k;}return x;}
ck_fixed_meta :: ()->CkMeta {return CkMeta.{ids=CkIds.{model=ck_fill(1),tokenizer=ck_fill(2),dataset=ck_fill(3),optimizer=ck_fill(4)},parent=ck_fill(5),revision=6,cursor=PkCursor.{seed=0x0102030405060708,epoch=2,order=1,offset=3},state=AwState.{step=5,skipped=1}};}
#test "the record is the independently packed byte layout" {
    #assert ck_size(0)==260 && ck_size(2)==308 && ck_size(4096)==98564;
    p:=[2]f64.[0.5,-1.25];m:=[2]f64.[0.25,3];v:=[2]f64.[1,2];out:[308]u8;want:=CK_FIXED;
    #assert ck_write(ck_fixed_meta(),p[..],m[..],v[..],out[..],false)==CkStatus.ok;for i:0..<308 {#assert out[i]==want[i];}
    b:[8]u8;#assert ck_put64(b[..],0,0x8877665544332211)==8 && b[0]==0x11 && b[7]==0x88 && ck_get64(b[..],0)==0x8877665544332211;
    #assert ck_put32(b[..],0,0x7fabcdef)==4 && ck_get32(b[..],0)==0x7fabcdef && b[3]==0x7f;
    #assert ck_equal(ck_fill(3),ck_fill(3)) && !ck_equal(ck_fill(3),ck_fill(4));x:=ck_fill(3);x[31]=4;#assert !ck_equal(ck_fill(3),x);
}
#test "reading admits the whole record before writing any value" {
    want:=CK_FIXED;p:=[3]f64.[-7,-7,-7];m:=[3]f64.[-8,-8,-8];v:=[3]f64.[-9,-9,-9];ids:=ck_fixed_meta().ids;
    r:=ck_read(want[..],ids,p[0..<2],m[0..<2],v[0..<2],false);
    #assert r.status==CkStatus.ok && r.meta.revision==6 && r.meta.cursor.seed==0x0102030405060708 && r.meta.cursor.epoch==2 && r.meta.cursor.order==1 && r.meta.cursor.offset==3 && r.meta.state.step==5 && r.meta.state.skipped==1;
    #assert ck_equal(r.meta.parent,ck_fill(5)) && ck_equal(r.meta.ids.optimizer,ck_fill(4)) && r.digest[0]==want[276] && r.digest[31]==want[307];
    #assert p[0]==0.5 && p[1]==-1.25 && m[0]==0.25 && m[1]==3 && v[0]==1 && v[1]==2 && p[2]==-7 && m[2]==-8 && v[2]==-9;
    p[0]=-7;p[1]=-7;m[0]=-8;v[1]=-9;
    #assert ck_read(want[..],ids,p[0..<2],m[0..<2],v[0..<2],true).status==CkStatus.alias;
    #assert ck_read(want[0..<307],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.truncated;
    #assert ck_read(want[0..<259],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.truncated;
    long:[309]u8;for i:0..<308 {long[i]=want[i];}#assert ck_read(long[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.corrupt;
    b:=want;
    for at:[13]int.[0,1,2,3,4,5,6,7,8,100,200,290,307] {b[at]^=1;s:=ck_read(b[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status;#assert s==(if_magic(at));b[at]^=1;}
    b[224]=0;#assert ck_read(b[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.corrupt;b[224]=3;#assert ck_read(b[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.truncated;b[224]=2;
    b[226]=1;#assert ck_read(b[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.corrupt;b[226]=0;
    // Count limits: 1 and 4096 are admitted (then too short here), 4097 is not.
    b[224]=1;#assert ck_read(b[0..<270],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.truncated;
    b[224]=0;b[225]=16;#assert ck_read(b[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.truncated;b[224]=1;#assert ck_read(b[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.corrupt;b[224]=2;b[225]=0;
    zero:[270]u8;#assert ck_read(zero[0..<260],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.magic && ck_read(zero[..],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.magic && ck_read(zero[0..<259],ids,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.truncated;
    w:=ids;w.model[0]=9;#assert ck_read(want[..],w,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.model;
    w=ids;w.tokenizer[31]=9;#assert ck_read(want[..],w,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.tokenizer;
    w=ids;w.dataset[5]=9;#assert ck_read(want[..],w,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.dataset;
    w=ids;w.optimizer[9]=9;#assert ck_read(want[..],w,p[0..<2],m[0..<2],v[0..<2],false).status==CkStatus.optimizer;
    #assert ck_read(want[..],ids,p[0..<1],m[0..<2],v[0..<2],false).status==CkStatus.shape && ck_read(want[..],ids,p[0..<2],m[0..<3],v[0..<2],false).status==CkStatus.shape && ck_read(want[..],ids,p[0..<2],m[0..<2],v[0..<1],false).status==CkStatus.shape;
    #assert p[0]==-7 && p[1]==-7 && m[0]==-8 && v[1]==-9;
}
// The status a one-bit flip at byte `at` of the fixed record must give.
if_magic :: (at:int)->CkStatus {if at<4 {return CkStatus.magic;}if at<8 {return CkStatus.version;}return CkStatus.corrupt;}
// Re-signs a modified record so that only its content is wrong, not its digest.
ck_resign :: (b:[]u8) {d:=ck_digest("psionic.checkpoint.v1",b[0..<b.count-32]);for i:0..<32 {b[b.count-32+i]=d[i];}}
#test "finiteness and sign are read from the bits" {
    #assert ck_bits(0,true) && ck_bits(0x8000000000000000,true) && !ck_bits(0x8000000000000001,true) && ck_bits(0x8000000000000001,false) && !ck_bits(0x7ff0000000000000,false) && !ck_bits(0xfff8000000000000,false) && ck_bits(0x7fefffffffffffff,true) && !ck_bits(0xbff0000000000000,true);
}
#test "signed records with impossible content still refuse" {
    want:=CK_FIXED;ids:=ck_fixed_meta().ids;p:[2]f64;m:[2]f64;v:[2]f64;b:=want;
    for field:[7]int.[0,2,3,4,5,6,1] {b=want;b[168+8*field+5]=1;ck_resign(b[..]);s:=ck_read(b[..],ids,p[..],m[..],v[..],false).status;#assert (field==1)==(s==CkStatus.ok);#assert field==1 || s==CkStatus.corrupt;}
    b=want;b[168+8*0+4]=255;b[168]=255;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.ok;
    b=want;b[168]=4;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.corrupt;
    b=want;b[168]=5;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.ok;
    // Integer fields admit up to 2^40-1.
    b=want;for i:0..<5 {b[184+i]=255;}ck_resign(b[..]);r:=ck_read(b[..],ids,p[..],m[..],v[..],false);#assert r.status==CkStatus.ok && r.meta.cursor.epoch==1099511627775;
    b[184]=0;b[185]=0;b[186]=0;b[187]=0;b[188]=0;b[189]=1;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.corrupt;
    b=want;b[260+7]^=0x80;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.number;
    // A NaN parameter, an infinite moment and a negative second moment.
    for at:[3]int.[228,244,268] {b=want;b[at+7]=0xff;b[at+6]=0xf8;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.number;}
    b=want;b[268+7]^=0x80;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.number;
    b=want;b[244+7]^=0x80;ck_resign(b[..]);#assert ck_read(b[..],ids,p[..],m[..],v[..],false).status==CkStatus.ok && m[0]==-0.25;
}
#test "writing refuses shapes, states and values it cannot record" {
    meta:=ck_fixed_meta();p:=[2]f64.[0.5,-1.25];m:=[2]f64.[0.25,3];v:=[2]f64.[1,2];out:[309]u8;out[0]=7;
    #assert ck_write(meta,p[..],m[..],v[..],out[0..<308],true)==CkStatus.alias;
    #assert ck_write(meta,p[..],m[..],v[..],out[0..<307],false)==CkStatus.shape && ck_write(meta,p[..],m[..],v[..],out[..],false)==CkStatus.shape;
    #assert ck_write(meta,p[0..<0],m[0..<0],v[0..<0],out[0..<260],false)==CkStatus.shape && ck_write(meta,p[..],m[0..<1],v[..],out[0..<308],false)==CkStatus.shape && ck_write(meta,p[..],m[..],v[0..<1],out[0..<308],false)==CkStatus.shape;
    big:[4097]f64;bo:[98588]u8;#assert ck_write(meta,big[..],big[..],big[..],bo[..],false)==CkStatus.shape;
    #assert ck_shape(4096,4096,4096,98564) && !ck_shape(4097,4097,4097,98588) && ck_shape(1,1,1,284) && !ck_shape(0,0,0,260) && !ck_shape(2,1,2,308) && !ck_shape(2,2,3,308) && !ck_shape(2,2,2,309);
    bad:=meta;bad.revision=4;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.corrupt;bad.revision=5;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.ok;out[0]=7;
    bad=meta;bad.revision=AW_STEPS;bad.state.step=0;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.corrupt;bad.revision=AW_STEPS-1;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.ok;out[0]=7;
    bad=meta;bad.state.skipped=-1;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.corrupt;
    bad=meta;bad.cursor.epoch=-1;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.corrupt;
    bad=meta;bad.cursor.order=-1;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.corrupt;
    bad=meta;bad.cursor.offset=-1;#assert ck_write(bad,p[..],m[..],v[..],out[0..<308],false)==CkStatus.corrupt;
    p[1]=0.0/0.0;#assert ck_write(meta,p[..],m[..],v[..],out[0..<308],false)==CkStatus.number;p[1]=1;
    m[0]=1.0/0.0;#assert ck_write(meta,p[..],m[..],v[..],out[0..<308],false)==CkStatus.number;m[0]=1;
    v[1]=-1;#assert ck_write(meta,p[..],m[..],v[..],out[0..<308],false)==CkStatus.number;v[1]=-0.0;
    v[0]=0.0/0.0;#assert ck_write(meta,p[..],m[..],v[..],out[0..<308],false)==CkStatus.number;
    #assert out[0]==7;
    z:=meta;z.cursor=PkCursor.{};v[0]=0;v[1]=0;#assert ck_write(z,p[..],m[..],v[..],out[0..<308],false)==CkStatus.ok;
}
#test "three values round-trip and each section is read from its place" {
    meta:=ck_fixed_meta();p:=[3]f64.[1,2,3];m:=[3]f64.[4,5,6];v:=[3]f64.[7,8,9];b:[332]u8;q:[3]f64;a:[3]f64;c:[3]f64;
    #assert ck_write(meta,p[..],m[..],v[..],b[..],false)==CkStatus.ok;r:=ck_read(b[..],meta.ids,q[..],a[..],c[..],false);
    #assert r.status==CkStatus.ok && q[0]==1 && q[2]==3 && a[0]==4 && a[2]==6 && c[0]==7 && c[1]==8 && c[2]==9;
    b[276+7]^=0x80;ck_resign(b[..]);#assert ck_read(b[..],meta.ids,q[..],a[..],c[..],false).status==CkStatus.number;
    b[276+7]^=0x80;b[268+7]^=0x80;ck_resign(b[..]);#assert ck_read(b[..],meta.ids,q[..],a[..],c[..],false).status==CkStatus.ok && a[2]==-6;
}
#test "a pointer is current only for the record it names" {
    want:=CK_FIXED;wp:=CK_FIXED_POINTER;ids:=ck_fixed_meta().ids;p:[2]f64;m:[2]f64;v:[2]f64;
    r:=ck_read(want[..],ids,p[..],m[..],v[..],false);out:[81]u8;
    #assert ck_pointer_write(6,r.digest,out[0..<80])==CkStatus.ok;for i:0..<80 {#assert out[i]==wp[i];}
    #assert ck_pointer_write(6,r.digest,out[..])==CkStatus.shape && ck_pointer_write(-1,r.digest,out[0..<80])==CkStatus.corrupt && ck_pointer_write(0,r.digest,out[0..<80])==CkStatus.ok;
    q:=ck_pointer_read(wp[..]);#assert q.status==CkStatus.ok && q.revision==6 && ck_equal(q.digest,r.digest) && ck_current(q,r)==CkStatus.ok;
    #assert ck_pointer_read(wp[0..<79]).status==CkStatus.truncated && ck_pointer_read(out[..]).status==CkStatus.corrupt;
    b:=wp;for at:[11]int.[0,1,2,3,4,5,6,7,8,30,79] {b[at]^=4;#assert ck_pointer_read(b[..]).status==if_magic(at);b[at]^=4;}
    // A pointer at another revision, or naming another record, is stale.
    old:[80]u8;#assert ck_pointer_write(5,r.digest,old[..])==CkStatus.ok;#assert ck_current(ck_pointer_read(old[..]),r)==CkStatus.stale;
    d:=r.digest;d[17]^=1;#assert ck_pointer_write(6,d,old[..])==CkStatus.ok && ck_current(ck_pointer_read(old[..]),r)==CkStatus.stale;
    #assert ck_current(ck_pointer_read(wp[0..<10]),r)==CkStatus.truncated && ck_current(q,ck_read(want[0..<10],ids,p[..],m[..],v[..],false))==CkStatus.truncated;
    b=wp;b[8]=0;b[13]=1;sig:=ck_digest("psionic.checkpoint-pointer.v1",b[0..<48]);for i:0..<32 {b[48+i]=sig[i];}#assert ck_pointer_read(b[..]).status==CkStatus.corrupt;
    t:[80]u8;#assert ck_pointer_write(1099511627775,r.digest,t[..])==CkStatus.ok && ck_pointer_read(t[..]).revision==1099511627775;
    b[13]=0;b[12]=255;b[11]=255;sig=ck_digest("psionic.checkpoint-pointer.v1",b[0..<48]);for i:0..<32 {b[48+i]=sig[i];}#assert ck_pointer_read(b[..]).revision==1099494850560;
}
