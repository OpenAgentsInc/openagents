// Experimental same-architecture supervised baseline. No quality admission.
#load "construction-study.coax";
#load "optim/adamw.coax";

#test "construction MSE derivatives agree with central differences for all parameters" {
    s:=CnShape.{inputs=4,outputs=4};p:[56]f64;for i:0..<56 {p[i]=0.05*f64(i%5+1);}x:=[4]f64.[0.5,1,-0.25,0.75];y:=[4]f64.[-1,2,0.5,-2];g:[56]f64;
    loss:=cl_gradient(s,p[..],x,y,g[..]);#assert loss>0;
    for i:0..<56 {up:=p;dn:=p;up[i]+=1e-6;dn[i]-=1e-6;u:[56]f64;v:[56]f64;
        hi:=cl_gradient(s,up[..],x,y,u[..]);lo:=cl_gradient(s,dn[..],x,y,v[..]);#assert abs((hi-lo)/2e-6-g[i])<1e-8;
    }
}
#test "raw export preserves the normalized network, including skips and biases" {
    for task:0..<4 {s:=cs_shape(task);p:[56]f64;for i:0..<cn_count(s) {p[i]=0.03*f64(i%7-3);}raw:=cl_export(s,p[..],task);
        x:=[4]f64.[2,-3,1,4];scaled:=x;for j:0..<s.inputs {if task==3 || j<2 {scaled[j]/=4;}}
        before:=cn_compute(s,p[0..<cn_count(s)],scaled[0..<s.inputs]);after:=cn_compute(s,raw[0..<cn_count(s)],x[0..<s.inputs]);
        for o:0..<s.outputs {#assert abs(after[o]-4*before[o])<1e-12;}
    }
}
cl_gradient :: (s:CnShape,p:[]f64,x:[4]f64,y:[4]f64,g:[]f64)->f64 {
    a:=s.inputs*4;b:=a+4;c:=b+s.outputs*4;d:=c+s.inputs*s.outputs;z:[4]f64;h:[4]f64;dh:[4]f64;
    for k:0..<4 {z[k]=p[a+k];for j:0..<s.inputs {z[k]+=p[k*s.inputs+j]*x[j];}if z[k]>0 {h[k]=z[k];}}
    input:=x;out:=cn_compute(s,p,input[0..<s.inputs]);loss:=0.0;
    for o:0..<s.outputs {dy:=(out[o]-y[o])/f64(s.outputs);loss+=0.5*(out[o]-y[o])*dy;g[d+o]+=dy;
        for j:0..<s.inputs {g[c+o*s.inputs+j]+=dy*x[j];}
        for k:0..<4 {g[b+o*4+k]+=dy*h[k];dh[k]+=dy*p[b+o*4+k];}
    }
    for k:0..<4 {if z[k]>0 {g[a+k]+=dh[k];for j:0..<s.inputs {g[k*s.inputs+j]+=dh[k]*x[j];}}}return loss;
}
cl_export :: (s:CnShape,p:[]f64,task:int)->[56]f64 {
    raw:[56]f64;for i:0..<cn_count(s) {raw[i]=p[i];}b:=4*s.inputs+4;c:=b+4*s.outputs;d:=c+s.inputs*s.outputs;
    for j:0..<s.inputs {scale:=ifx task==3 || j<2 then 4.0 else 1.0;for k:0..<4 {raw[k*s.inputs+j]/=scale;}for o:0..<s.outputs {raw[c+o*s.inputs+j]*=4/scale;}}
    for o:0..<s.outputs {raw[d+o]*=4;for k:0..<4 {raw[b+o*4+k]*=4;}}return raw;
}
