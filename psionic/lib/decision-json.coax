// Serialize typed decision probabilities as the published answer objects.
#load "readout.coax";
#load "text/request.coax";
#authority;
PjStatus :: enum u8 {ok;shape;number;entry;capacity;alias;}
// system_one: OneJev's answer objects. decision_index: the fields the pinned engine.py keeps.
PJ_SYSTEM_ONE :: 0;
PJ_DECISION_INDEX :: 1;
PjResult :: struct {status:PjStatus;written:int;}
PjWriter :: struct {data:[]u8;at:int;store:bool;}
PJ_HEX :: "0123456789abcdef";
#test "six-decimal rounding is exact, half to even, from the binary value" {
    #assert pj_round6(0)==0 && pj_round6(0.0000004)==0 && pj_round6(0.0000006)==1 && pj_round6(1)==1000000;
    #assert pj_round6(0.757196285)==757196 && pj_round6(0.242803715)==242804 && pj_round6(9)==9000000;
    // Decimal midpoints are not binary midpoints: the stored value decides the direction.
    #assert pj_round6(0.0000005)==0 && pj_round6(0.0000025)==3 && pj_round6(0.0000015)==2;
    #assert pj_round6(0.0000035)==3 && pj_round6(0.0000045)==5;
    #assert pj_round6(f64(1)/f64(2000000))==0 && pj_round6(f64(3)/f64(2000000))==2;
    #assert pj_round6(f64_from_bits(0x3fe0000000000000))==500000 && pj_round6(f64_from_bits(0x3fdfffffffffffff))==500000;
    #assert pj_round6(f64_from_bits(0x3eb0c6f7a0b5ed8d))==1 && pj_round6(f64_from_bits(0x3ea0c6f7a0b5ed8d))==0;
    #assert pj_round6(f64_from_bits(0x3ea0c6f7a0b5ed8e))==1 && pj_round6(f64_from_bits(0x3ea0c6f7a0b5ed8c))==0;
    // Products that round to exactly n+0.5: the sign of the exact error decides.
    #assert pj_round6(f64_from_bits(0x3eb92a737110e454))==2 && pj_round6(f64_from_bits(0x3ec4f8b588e368f1))==3;
    #assert pj_round6(f64_from_bits(0x3ec4f8b588e368f0))==2 && pj_round6(f64_from_bits(0x3ecd5c31593e5fb7))==3;
    // Exact ties go to the even neighbour.
    #assert pj_round6(0.0078125)==7812 && pj_round6(0.0234375)==23438 && pj_round6(0.0390625)==39062 && pj_round6(0.0703125)==70312;
    #assert pj_error(0.757196285,0.757196285*1000000)==-0.000000000008128608897095546;
    x:=f64_from_bits(0x3eb0c6f7f52734c6);#assert pj_error(x,x*1000000)==f64_from_bits(0x3c81ec0000000000);
    #assert pj_round6(f64_from_bits(1))==0 && pj_round6(0.9999995)==1000000 && pj_round6(0.9999994999)==999999;
}
#test "numbers print as Python's repr of the rounded value" {
    out:[64]u8;
    #assert pj_number_text(0,out[..])=="0.0" && pj_number_text(1,out[..])=="1.0" && pj_number_text(0.5,out[..])=="0.5";
    #assert pj_number_text(0.757196285,out[..])=="0.757196" && pj_number_text(0.0001,out[..])=="0.0001";
    #assert pj_number_text(0.00012,out[..])=="0.00012" && pj_number_text(0.0000999,out[..])=="0.0001" && pj_number_text(0.000099,out[..])=="9.9e-05";
    #assert pj_number_text(0.00001,out[..])=="1e-05" && pj_number_text(0.000005,out[..])=="5e-06" && pj_number_text(0.0000004,out[..])=="0.0";
    #assert pj_number_text(0.00009,out[..])=="9e-05" && pj_number_text(0.0000123,out[..])=="1.2e-05";
    #assert pj_number_text(8.25,out[..])=="8.25" && pj_number_text(4.0000004,out[..])=="4.0" && pj_number_text(0.1000004,out[..])=="0.1";
    #assert pj_number_text(-0.0,out[..])=="-0.0" && pj_number_text(-0.25,out[..])=="-0.25" && pj_number_text(0.0123,out[..])=="0.0123";
    #assert pj_number_text(0.999999,out[..])=="0.999999" && pj_number_text(0.000101,out[..])=="0.000101" && pj_number_text(0.00002,out[..])=="2e-05";
    #assert pj_number_text(0.200001,out[..])=="0.200001" && pj_number_text(9,out[..])=="9.0";
}
#test "strings escape like json.dumps with ensure_ascii off" {
    out:[64]u8;w:=[1]PjWriter.[PjWriter.{data=out[..],store=true}];
    pj_string(w[..],"a\"b\\c\nd\re\tf");#assert cast(string)out[0..<w[0].at]=="\"a\\\"b\\\\c\\nd\\re\\tf\"";
    raw:=[10]u8.[8,12,0,31,127,32,195,169,47,16];w[0].at=0;pj_string(w[..],cast(string)raw[..]);
    want:=[28]u8.[34,92,98,92,102,92,117,48,48,48,48,92,117,48,48,49,102,127,32,195,169,47,92,117,48,48,49,48];
    #assert w[0].at==29 && out[28]==34;for i:0..<28 {#assert out[i]==want[i];}
    count:=[1]PjWriter.[PjWriter.{data=out[0..<0]}];pj_string(count[..],"ab");#assert count[0].at==4;
}
#test "choice, noul and score objects match the published fields" {
    out:[512]u8;
    options:=[3]PtOption.[PtOption.{name="red"},PtOption.{name="green"},PtOption.{name="blue"}];
    p:=[3]f64.[0.5,0.3,0.2];
    r:=pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[..],options[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"choice\",\"choice\":\"red\",\"probabilities\":{\"red\":0.5,\"green\":0.3,\"blue\":0.2},\"confidence\":0.25}";
    r=pj_answer(QrKind.choice,PJ_DECISION_INDEX,p[..],options[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"choice\",\"choice\":\"red\",\"probabilities\":{\"red\":0.5,\"green\":0.3,\"blue\":0.2}}";
    yes:=[2]f64.[0.757196285,0.242803715];
    r=pj_answer(QrKind.noul,PJ_SYSTEM_ONE,yes[..],options[0..<0],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"noul\",\"noul\":0.757196}";
    levels:=[3]PtOption.[PtOption.{description=PtEntry.{kind=PtEntryKind.text,value="low"}},PtOption.{description=PtEntry.{kind=PtEntryKind.text,value="mid"}},PtOption.{}];
    s:=[3]f64.[0.25,0.25,0.5];
    r=pj_answer(QrKind.score,PJ_SYSTEM_ONE,s[..],levels[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"score\",\"score\":1.25,\"legend\":{\"0\":\"low\",\"1\":\"mid\",\"2\":null},\"probabilities\":{\"0\":0.25,\"1\":0.25,\"2\":0.5},\"confidence\":0.0}";
    r=pj_answer(QrKind.score,PJ_DECISION_INDEX,s[..],levels[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"score\",\"score\":1.25,\"probabilities\":{\"0\":0.25,\"1\":0.25,\"2\":0.5}}";
}
#test "normalization, one-option answers and zero vectors follow answers.py" {
    out:[512]u8;one:=[1]PtOption.[PtOption.{name="only"}];certain:=[1]f64.[0.25];
    r:=pj_answer(QrKind.choice,PJ_SYSTEM_ONE,certain[..],one[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"choice\",\"choice\":\"only\",\"probabilities\":{\"only\":1.0},\"confidence\":1.0}";
    level:=[1]PtOption.[PtOption.{}];
    r=pj_answer(QrKind.score,PJ_SYSTEM_ONE,certain[..],level[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"score\",\"score\":0.0,\"legend\":{\"0\":null},\"probabilities\":{\"0\":1.0},\"confidence\":1.0}";
    two:=[2]PtOption.[PtOption.{name="a"},PtOption.{name="b"}];zero:=[2]f64.[0,0];
    r=pj_answer(QrKind.choice,PJ_SYSTEM_ONE,zero[..],two[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"choice\",\"choice\":\"a\",\"probabilities\":{\"a\":0.5,\"b\":0.5},\"confidence\":0.0}";
    half:=[2]f64.[0.1,0.3];
    r=pj_answer(QrKind.choice,PJ_SYSTEM_ONE,half[..],two[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"choice\",\"choice\":\"b\",\"probabilities\":{\"a\":0.25,\"b\":0.75},\"confidence\":0.5}";
    // noul keeps slot zero as given, clamped; a negative zero becomes 0.0.
    r=pj_answer(QrKind.noul,PJ_DECISION_INDEX,half[..],two[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"noul\",\"noul\":0.1}";
    nz:=[2]f64.[-0.0,1];
    r=pj_answer(QrKind.noul,PJ_SYSTEM_ONE,nz[..],two[0..<0],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"noul\",\"noul\":0.0}";
    s:=[4]f64.[0.1,0.2,0.3,0.4];levels:=[4]PtOption.[PtOption.{},PtOption.{},PtOption.{},PtOption.{}];
    r=pj_answer(QrKind.score,PJ_SYSTEM_ONE,s[..],levels[..],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"score\",\"score\":2.0,\"legend\":{\"0\":null,\"1\":null,\"2\":null,\"3\":null},\"probabilities\":{\"0\":0.1,\"1\":0.2,\"2\":0.3,\"3\":0.4},\"confidence\":0.0}";
    peak:=[3]f64.[0.1,0.8,0.1];
    r=pj_answer(QrKind.score,PJ_SYSTEM_ONE,peak[..],levels[0..<3],out[..],false);
    #assert r.status==PjStatus.ok && cast(string)out[0..<r.written]=="{\"type\":\"score\",\"score\":1.0,\"legend\":{\"0\":null,\"1\":null,\"2\":null},\"probabilities\":{\"0\":0.1,\"1\":0.8,\"2\":0.1},\"confidence\":0.7}";
}
#test "malformed answers refuse before writing output" {
    out:=[8]u8.[7,7,7,7,7,7,7,7];two:=[2]PtOption.[PtOption.{name="a"},PtOption.{name="b"}];p:=[2]f64.[0.5,0.5];
    #assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[..],two[..],out[..],false).status==PjStatus.capacity;
    #assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[..],two[..],out[..],true).status==PjStatus.alias;
    #assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[0..<0],two[0..<0],out[..],false).status==PjStatus.shape;
    #assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[..],two[0..<1],out[..],false).status==PjStatus.shape;
    #assert pj_answer(QrKind.score,PJ_SYSTEM_ONE,p[..],two[0..<1],out[..],false).status==PjStatus.shape;
    #assert pj_answer(QrKind.noul,PJ_SYSTEM_ONE,p[0..<1],two[0..<0],out[..],false).status==PjStatus.shape;
    #assert pj_answer(QrKind.noul,PJ_SYSTEM_ONE,p[..],two[0..<1],out[..],false).status==PjStatus.shape;
    #assert pj_answer(QrKind.choice,2,p[..],two[..],out[..],false).status==PjStatus.shape;
    same:=[2]PtOption.[PtOption.{name="a"},PtOption.{name="a"}];
    #assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[..],same[..],out[..],false).status==PjStatus.shape;
    bad:=p;bad[1]=1.5;#assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,bad[..],two[..],out[..],false).status==PjStatus.number;
    bad[1]=-0.25;#assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,bad[..],two[..],out[..],false).status==PjStatus.number;
    invalid:=[1]u8.[255];named:=two;named[1].name=cast(string)invalid[..];
    #assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[..],named[..],out[..],false).status==PjStatus.entry;
    named=two;named[0].name=cast(string)invalid[..];#assert pj_answer(QrKind.choice,PJ_SYSTEM_ONE,p[..],named[..],out[..],false).status==PjStatus.entry;
    first:=[2]PtOption.[PtOption.{description=PtEntry.{kind=PtEntryKind.json,value="1"}},PtOption.{}];
    #assert pj_answer(QrKind.score,PJ_SYSTEM_ONE,p[..],first[..],out[..],false).status==PjStatus.entry;
    levels:=[2]PtOption.[PtOption.{},PtOption.{description=PtEntry.{kind=PtEntryKind.json,value="{}"}}];
    #assert pj_answer(QrKind.score,PJ_SYSTEM_ONE,p[..],levels[..],out[..],false).status==PjStatus.entry;
    levels[1].description=PtEntry.{kind=PtEntryKind.text,value=cast(string)invalid[..]};
    #assert pj_answer(QrKind.score,PJ_SYSTEM_ONE,p[..],levels[..],out[..],false).status==PjStatus.entry;
    levels[1].description.value="ok";#assert pj_answer(QrKind.score,PJ_SYSTEM_ONE,p[..],levels[..],out[..],false).status==PjStatus.capacity;
    for b:out {#assert b==7;}
    exact:[64]u8;r:=pj_answer(QrKind.choice,PJ_DECISION_INDEX,p[..],two[..],exact[..],false);
    #assert r.status==PjStatus.ok && r.written==64;
    #assert pj_answer(QrKind.choice,PJ_DECISION_INDEX,p[..],two[..],exact[0..<63],false).status==PjStatus.capacity;
}
pj_byte :: (w:[]PjWriter,b:u8) {if w[0].store {w[0].data[w[0].at]=b;}w[0].at+=1;}
pj_text :: (w:[]PjWriter,s:string) {for i:0..<s.count {pj_byte(w,s[i]);}}
// The exact error of p=x*10^6 (Dekker): x*10^6 is exactly p+pj_error(x,p).
pj_error :: (x:f64,p:f64)->f64 {c:=134217729*x;high:=c-(c-x);low:=x-high;return (high*1000000-p)+low*1000000;}
// Round x*10^6 to an integer, half to even, from the exact binary value.
pj_round6 :: (x:f64)->int {
    p:=x*1000000;e:=pj_error(x,p);n:=int(floor(p));d:=p-(f64(n)+0.5);
    if d>0 || (d==0 && e>0) || (d==0 && e==0 && n%2==1) {n+=1;}
    return n;
}
pj_digit :: (w:[]PjWriter,v:int) {pj_byte(w,cast(u8)(48+v));}
// Python repr of round(x, 6): fixed notation from 1e-4, otherwise exponent form.
pj_number :: (w:[]PjWriter,x:f64) {
    if (f64_bits(x)>>63)==1 {pj_byte(w,45);}
    n:=pj_round6(abs(x));
    if n==0 {pj_text(w,"0.0");return;}
    if n<10 {pj_digit(w,n);pj_text(w,"e-06");return;}
    if n<100 {pj_digit(w,n/10);if n%10!=0 {pj_byte(w,46);pj_digit(w,n%10);}pj_text(w,"e-05");return;}
    // Values stay below 10: probabilities, confidences and expected levels 0..9.
    pj_digit(w,n/1000000);pj_byte(w,46);frac:=n%1000000;
    if frac==0 {pj_byte(w,48);return;}
    scale:=100000;while frac%10==0 {frac/=10;scale/=10;}
    while scale>0 {pj_byte(w,cast(u8)(48+(frac/scale)%10));scale/=10;}
}
pj_number_text :: (x:f64,out:[]u8)->string {w:=[1]PjWriter.[PjWriter.{data=out,store=true}];pj_number(w[..],x);return cast(string)out[0..<w[0].at];}
pj_string :: (w:[]PjWriter,s:string) {
    pj_byte(w,34);
    for i:0..<s.count {
        c:=s[i];
        if c==34 {pj_text(w,"\\\"");}
        else if c==92 {pj_text(w,"\\\\");}
        else if c==10 {pj_text(w,"\\n");}
        else if c==13 {pj_text(w,"\\r");}
        else if c==9 {pj_text(w,"\\t");}
        else if c==8 {pj_text(w,"\\b");}
        else if c==12 {pj_text(w,"\\f");}
        else if c<32 {pj_text(w,"\\u00");pj_byte(w,PJ_HEX[c/16]);pj_byte(w,PJ_HEX[c%16]);}
        else {pj_byte(w,c);}
    }
    pj_byte(w,34);
}
pj_key :: (w:[]PjWriter,i:int) {pj_byte(w,34);pj_digit(w,i);pj_byte(w,34);pj_byte(w,58);}
// answers._normalize: a left-to-right sum; a zero total becomes uniform.
pj_normalize :: (p:[]f64,out:[]f64) {
    total:=0.0;for v:p {total+=v;}
    for i:0..<p.count {if total>0 {out[i]=p[i]/total;} else {out[i]=1/f64(p.count);}}
}
pj_first_max :: (p:[]f64)->int {best:=0;for i:1..<p.count {if p[i]>p[best] {best=i;}}return best;}
pj_choice_confidence :: (p:[]f64)->f64 {
    n:=p.count;if n==1 {return 1;}
    q:[255]f64;pj_normalize(p,q[0..<n]);uniform:=1/f64(n);
    return (q[pj_first_max(q[0..<n])]-uniform)/(1-uniform);
}
pj_expected :: (p:[]f64)->f64 {q:[10]f64;pj_normalize(p,q[0..<p.count]);s:=0.0;for i:1..<p.count {s+=f64(i)*q[i];}return s;}
pj_score_confidence :: (p:[]f64)->f64 {
    n:=p.count;if n==1 {return 1;}
    q:[10]f64;pj_normalize(p,q[0..<n]);mode:=pj_first_max(q[0..<n]);
    distance:=0.0;for i:0..<n {distance+=q[i]*abs(f64(i-mode));}
    center:=f64(n-1)/2;spread:=0.0;for i:0..<n {spread+=abs(f64(i)-center);}
    r:=1-distance/(spread/f64(n));return (r+abs(r))/2;
}
// book:begin answer-json
pj_emit :: (w:[]PjWriter,kind:QrKind,fields:u8,probabilities:[]f64,options:[]PtOption) {
    n:=probabilities.count;p:[255]f64;pj_normalize(probabilities,p[0..<n]);
    if kind==QrKind.noul {
        v:=probabilities[0];if v<=0 {v=0;}
        pj_text(w,"{\"type\":\"noul\",\"noul\":");pj_number(w,v);pj_byte(w,125);return;
    }
    if kind==QrKind.choice {
        pj_text(w,"{\"type\":\"choice\",\"choice\":");pj_string(w,options[pj_first_max(p[0..<n])].name);
        pj_text(w,",\"probabilities\":{");
        for i:0..<n {if i>0 {pj_byte(w,44);}pj_string(w,options[i].name);pj_byte(w,58);pj_number(w,p[i]);}
        pj_byte(w,125);
        if fields==PJ_SYSTEM_ONE {pj_text(w,",\"confidence\":");pj_number(w,pj_choice_confidence(p[0..<n]));}
        pj_byte(w,125);return;
    }
    pj_text(w,"{\"type\":\"score\",\"score\":");pj_number(w,pj_expected(p[0..<n]));
    if fields==PJ_SYSTEM_ONE {
        pj_text(w,",\"legend\":{");
        for i:0..<n {
            if i>0 {pj_byte(w,44);}pj_key(w,i);
            if options[i].description.kind==PtEntryKind.none {pj_text(w,"null");} else {pj_string(w,options[i].description.value);}
        }
        pj_byte(w,125);
    }
    pj_text(w,",\"probabilities\":{");
    for i:0..<n {if i>0 {pj_byte(w,44);}pj_key(w,i);pj_number(w,p[i]);}
    pj_byte(w,125);
    if fields==PJ_SYSTEM_ONE {pj_text(w,",\"confidence\":");pj_number(w,pj_score_confidence(p[0..<n]));}
    pj_byte(w,125);
}
// book:end answer-json
pj_answer :: (kind:QrKind,fields:u8,probabilities:[]f64,options:[]PtOption,out:[]u8,overlap:bool)->PjResult #export_c {
    n:=probabilities.count;tag:=cast(u8)kind;
    if !qr_valid(tag,n,1) || !pt_question_count(tag,options.count) || fields>1 {return PjResult.{status=PjStatus.shape};}
    if kind!=QrKind.noul && options.count!=n {return PjResult.{status=PjStatus.shape};}
    if overlap {return PjResult.{status=PjStatus.alias};}
    for v:probabilities {if !(v>=0 && v<=1) {return PjResult.{status=PjStatus.number};}}
    for i:0..<options.count {
        if kind==QrKind.choice {
            if pt_utf8_validate(options[i].name)!=PtStatus.ok {return PjResult.{status=PjStatus.entry};}
            for j:0..<i {if options[j].name==options[i].name {return PjResult.{status=PjStatus.shape};}}
        }
        if kind==QrKind.score {
            d:=options[i].description;
            if d.kind==PtEntryKind.json || pt_utf8_validate(d.value)!=PtStatus.ok {return PjResult.{status=PjStatus.entry};}
        }
    }
    count:=[1]PjWriter.[PjWriter.{data=out}];pj_emit(count[..],kind,fields,probabilities,options);
    if count[0].at>out.count {return PjResult.{status=PjStatus.capacity};}
    w:=[1]PjWriter.[PjWriter.{data=out,store=true}];pj_emit(w[..],kind,fields,probabilities,options);
    return PjResult.{written=w[0].at};
}

#load "../fixtures/quality/answer-vectors.coax";
