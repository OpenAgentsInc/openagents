#load "engram-types.coax";
#load "../../fixtures/deepseek/engram-constants.coax";
#load "../../fixtures/deepseek/engram-goldens.coax";
#authority;

#test "original bucket primes offsets and row counts match independent integer construction" {
    #assert eg_prime(2) && eg_prime(3) && eg_prime(97) && !eg_prime(-1) && !eg_prime(0) && !eg_prime(1) && !eg_prime(4) && !eg_prime(9) && !eg_prime(49);
    #assert eg_next_prime(2)==2 && eg_next_prime(3)==3 && eg_next_prime(4)==5 && eg_next_prime(9)==11;
    at:=16000000;for i:0..<48 {at=eg_next_prime(at);#assert at==EG_PRIMES[i];at+=1;}
    for layer:0..<2 {offset:=0;for i:0..<24 {#assert EG_OFFSETS[layer*24+i]==offset;offset+=EG_PRIMES[layer*24+i];}#assert offset==EG_ROWS[layer];}
    #assert EG_ROWS[0]==384006168 && EG_ROWS[1]==384016682;
}
#test "map identity admission binds exact bytes dimensions compressed IDs and padding" {
    data:=EGG_MAP;a:=eg_admit_map(data[..],8,99092,2,EGG_MAP_SHA);#assert a.status==EgStatus.ok && a.value.raw==8 && a.value.compressed==99092 && a.value.pad==2 && a.value.data.count==32;
    #assert eg_admit_map(data[..],8,99092,2,EG_MAP_SHA).status==EgStatus.identity;
    #assert eg_admit_map(data[0..<31],8,99092,2,EGG_MAP_SHA).status==EgStatus.capacity;
    #assert eg_admit_map(data[..],0,99092,2,EGG_MAP_SHA).status==EgStatus.shape && eg_admit_map(data[..],1048577,99092,2,EGG_MAP_SHA).status==EgStatus.shape;
    #assert eg_admit_map(data[..],8,0,2,EGG_MAP_SHA).status==EgStatus.shape && eg_admit_map(data[..],8,1048577,2,EGG_MAP_SHA).status==EgStatus.shape;
    #assert eg_admit_map(data[..],8,99092,-1,EGG_MAP_SHA).status==EgStatus.shape && eg_admit_map(data[..],8,99092,8,EGG_MAP_SHA).status==EgStatus.shape;
    #assert eg_admit_map(data[..],8,7,2,EGG_MAP_SHA).status==EgStatus.token;
    #assert eg_map_dimensions(1,1,0) && eg_map_dimensions(1048576,1048576,1048575);
    bytes:=[4]u8.[0x78,0x56,0x34,0x12];#assert eg_u32(bytes[..],0)==0x12345678;
    c:=eg_v41_contract();#assert c.raw==129280 && c.compressed==99092 && c.pad==2 && c.sha==EG_MAP_SHA;
    #assert eg_v41_map(data[..]).status==EgStatus.capacity;
}
#test "dead tokens block all further lookback and cold history pads every missing position" {
    h:=eg_start();#assert h.next==0 && h.last[0]==-1 && h.last[1]==-1 && h.last[2]==-1 && eg_history_valid(h);
    t:=eg_look(7,h);#assert t[0]==7 && t[1]==2 && t[2]==2 && t[3]==2;
    h=EgHistory.{next=3,last=[3]int.[5,-1,9]};t=eg_look(7,h);#assert t[0]==7 && t[1]==5 && t[2]==2 && t[3]==2;
    t=eg_look(-1,h);for x:t {#assert x==2;}
    #assert eg_history_valid(EgHistory.{next=1048576,last=[3]int.[99091,0,-1]});
    #assert !eg_history_valid(EgHistory.{next=-1}) && !eg_history_valid(EgHistory.{next=1048577}) && !eg_history_valid(EgHistory.{next=0});
    #assert !eg_history_valid(EgHistory.{next=3,last=[3]int.[-2,0,0]}) && !eg_history_valid(EgHistory.{next=3,last=[3]int.[0,99092,0]});
}
#test "whole and split hash chunks preserve every original bucket ID and exact history" {
    data:=EGG_MAP;m:=eg_admit_map(data[..],8,99092,2,EGG_MAP_SHA).value;tokens:=EGG_TOKENS;mask:=EGG_MASK;out:[913]int;stage:[912]int;out[912]=77;
    r:=eg_hash(m,eg_start(),tokens[..],mask[..],out[..],stage[..],false);#assert r.status==EgStatus.ok && r.written==912 && r.next.next==19;
    for i:0..<912 {#assert out[i]==EGG_HASHES[i];}#assert out[912]==77;
    one:[48]int;work:[48]int;state:=eg_start();for i:0..<19 {s:=eg_hash(m,state,tokens[i..<i+1],mask[i..<i+1],one[..],work[..],false);#assert s.status==EgStatus.ok;state=s.next;for j:0..<48 {#assert one[j]==EGG_HASHES[i*48+j];}}
    #assert state.next==r.next.next;for j:0..<3 {#assert state.last[j]==r.next.last[j];}
}
#test "hash shape state masks and independent spans refuse before publication" {
    data:=EGG_MAP;m:=eg_admit_map(data[..],8,99092,2,EGG_MAP_SHA).value;tokens:=[2]int.[1,3];mask:=[2]u8.[1,1];out:[97]int;stage:[96]int;for i:0..<97 {out[i]=77;}
    #assert eg_hash_size(1) && eg_hash_size(1048576) && !eg_hash_size(0) && !eg_hash_size(1048577);
    #assert eg_hash(m,eg_start(),tokens[0..<0],mask[0..<0],out[..],stage[..],false).status==EgStatus.shape;
    for field:0..<4 {mk:=mask[..];o:=out[..];s:=stage[..];alias:=false;if field==0 {mk=mask[0..<1];}else if field==1 {o=out[0..<95];}else if field==2 {s=stage[0..<95];}else {alias=true;}
        r:=eg_hash(m,eg_start(),tokens[..],mk,o,s,alias);#assert r.status==(ifx field==3 then EgStatus.alias else EgStatus.capacity);}
    bad:=m;bad.compressed=99091;#assert eg_hash(bad,eg_start(),tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.identity;
    bad=m;bad.pad=3;#assert eg_hash(bad,eg_start(),tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.identity;
    bad=m;bad.data=data[0..<31];#assert eg_hash(bad,eg_start(),tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.identity;
    #assert eg_hash(m,EgHistory.{},tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.state;
    #assert eg_hash(m,EgHistory.{next=1048575,last=[3]int.[0,0,0]},tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.state;
    tokens[1]=8;#assert eg_hash(m,eg_start(),tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.token;tokens[1]=-1;#assert eg_hash(m,eg_start(),tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.token;
    tokens[1]=1;mask[1]=2;#assert eg_hash(m,eg_start(),tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.format;for x:out {#assert x==77;}
}

#test "inclusive metadata and continuation boundaries are reachable without large allocations" {
    #assert eg_raw_size(1) && eg_raw_size(1048576) && !eg_raw_size(0) && !eg_raw_size(1048577);
    #assert eg_advance(1048575,1) && !eg_advance(1048576,1);
    #assert !eg_history_valid(EgHistory.{next=1,last=[3]int.[0,0,-1]});
    data:=EGG_MAP;data[0]=8;data[16]=7;
    #assert eg_admit_map(data[..],8,8,2,"08fb10d607862baf304b1df2c6136a961d0665d120d8d8c28ce4733d4c0070a3").status==EgStatus.token;
    m:=EgMap.{raw=8,compressed=99092,pad=2,data=data[..]};data[0]=20;data[1]=131;data[2]=1;
    tokens:=[1]int.[0];mask:=[1]u8.[1];out:[48]int;stage:[48]int;
    #assert eg_hash(m,eg_start(),tokens[..],mask[..],out[..],stage[..],false).status==EgStatus.token;
}

eg_prime :: (n:int)->bool {if n<2 {return false;}if n%2==0 {return n==2;}d:=3;while d<=n/d {if n%d==0 {return false;}d+=2;}return true;}
eg_next_prime :: (n:int)->int {at:=n;while !eg_prime(at) {at+=1;}return at;}
eg_u32 :: (data:[]u8,at:int)->int {return cast(int)(u32(data[at])|(u32(data[at+1])<<8)|(u32(data[at+2])<<16)|(u32(data[at+3])<<24));}
eg_raw_size :: (raw:int)->bool {return raw>=1 && raw<=1048576;}
eg_advance :: (next:int,count:int)->bool {return next+count<=1048576;}
eg_map_dimensions :: (raw:int,compressed:int,pad:int)->bool {return eg_raw_size(raw) && compressed>=1 && compressed<=1048576 && pad>=0 && pad<raw;}
eg_admit_map :: (data:[]u8,raw:int,compressed:int,pad:int,sha:string)->EgAdmission #export_c {
    if !eg_map_dimensions(raw,compressed,pad) {return EgAdmission.{status=EgStatus.shape};}if data.count!=raw*4 {return EgAdmission.{status=EgStatus.capacity};}
    if !pw_digest(data,sha) {return EgAdmission.{status=EgStatus.identity};}
    for i:0..<raw {if eg_u32(data,4*i)>=compressed {return EgAdmission.{status=EgStatus.token};}}
    return EgAdmission.{value=EgMap.{raw=raw,compressed=compressed,pad=eg_u32(data,4*pad),data=data}};
}
eg_v41_contract :: ()->EgMapContract #export_c {return EgMapContract.{raw=129280,compressed=99092,pad=2,sha=EG_MAP_SHA};}
eg_v41_map :: (data:[]u8)->EgAdmission #export_c {c:=eg_v41_contract();return eg_admit_map(data,c.raw,c.compressed,c.pad,c.sha);}
eg_start :: ()->EgHistory #export_c {return EgHistory.{last=[3]int.[-1,-1,-1]};}
eg_history_valid :: (h:EgHistory)->bool {
    if h.next<0 || h.next>1048576 {return false;}for j:0..<3 {if h.last[j]<-1 || h.last[j]>=99092 {return false;}if j>=h.next && h.last[j]!=-1 {return false;}}return true;
}
eg_look :: (current:int,h:EgHistory)->[4]int {
    inputs:=[4]int.[current,h.last[0],h.last[1],h.last[2]];out:[4]int;blocked:=false;
    for j:0..<4 {blocked=blocked || inputs[j]==-1;out[j]=ifx blocked then 2 else inputs[j];}return out;
}
eg_hash_size :: (count:int)->bool {return count>=1 && count<=1048576;}
// book:begin hash
eg_hash :: (m:EgMap,state:EgHistory,tokens:[]int,mask:[]u8,out:[]int,stage:[]int,overlap:bool)->EgHash #export_c {
    if !eg_hash_size(tokens.count) {return EgHash.{status=EgStatus.shape};}
    if !eg_raw_size(m.raw) || m.data.count!=m.raw*4 || m.compressed!=99092 || m.pad!=2 {return EgHash.{status=EgStatus.identity};}
    if !eg_history_valid(state) || !eg_advance(state.next,tokens.count) {return EgHash.{status=EgStatus.state};}
    n:=tokens.count*48;if mask.count!=tokens.count || out.count<n || stage.count<n {return EgHash.{status=EgStatus.capacity};}if overlap {return EgHash.{status=EgStatus.alias};}
    next:=state;for t:0..<tokens.count {if tokens[t]<0 || tokens[t]>=m.raw {return EgHash.{status=EgStatus.token};}if mask[t]>1 {return EgHash.{status=EgStatus.format};}
        current:=eg_u32(m.data,4*tokens[t]);if current>=m.compressed {return EgHash.{status=EgStatus.token};}if mask[t]==0 {current=-1;}
        look:=eg_look(current,next);
        for layer:0..<2 {rolling:=u64(look[0])*EG_MULT[layer*4];for back:1..<4 {rolling^=u64(look[back])*EG_MULT[layer*4+back];
            for head:0..<8 {i:=layer*24+(back-1)*8+head;stage[t*48+i]=cast(int)(rolling%u64(EG_PRIMES[i]))+EG_OFFSETS[i];}}}
        next.last=[3]int.[current,next.last[0],next.last[1]];next.next+=1;
    }
    for i:0..<n {out[i]=stage[i];}return EgHash.{written=n,next=next};
}
// book:end hash
