#load "prefill-groups.coax";
#authority;

#test "time and workspace budgets choose largest chunks and never silently select serial" {
    c:=DpChunkConfig.{max_chunk=8,workspace=1000,bytes_per_token=100,fixed_ns=10,token_ns=5,expert_ns=3,experts=4,k=2,target_ns=59};
    p:=dp_chunk(c,20);#assert p.status==DsStatus.ok && p.count==7 && p.predicted_ns==57 && !p.tail && !p.serial;
    c.target_ns=42;#assert dp_chunk(c,20).count==4;c.target_ns=41;#assert dp_chunk(c,20).count==3;
    c.target_ns=1000;c.workspace=299;#assert dp_chunk(c,20).count==2;c.workspace=199;#assert dp_chunk(c,20).status==DsStatus.budget;c.workspace=1000;c.target_ns=31;#assert dp_chunk(c,20).status==DsStatus.budget;
    c.serial=true;c.max_chunk=1;p=dp_chunk(c,20);#assert p.status==DsStatus.ok && p.count==1 && p.serial && !p.tail && p.predicted_ns==21;
    c.serial=false;#assert dp_chunk(c,1).status==DsStatus.shape;c.max_chunk=2;p=dp_chunk(c,1);#assert p.status==DsStatus.ok && p.count==1 && p.tail && !p.serial;
    c.target_ns=20;#assert dp_chunk(c,1).status==DsStatus.budget;
    #assert dp_chunk(c,0).status==DsStatus.shape && dp_chunk(c,1048577).status==DsStatus.shape;
    #assert dp_cost(c,1)==21 && dp_cost(c,2)==32 && dp_cost(c,3)==37;
    #assert dp_nonnegative(0) && dp_nonnegative(1000000000000) && !dp_nonnegative(-1) && !dp_nonnegative(1000000000001);
    #assert dp_memory(0) && dp_memory(1125899906842624) && !dp_memory(-1) && !dp_memory(1125899906842625);
    #assert dp_positive_cost(1) && dp_positive_cost(1000000000000) && !dp_positive_cost(0) && !dp_positive_cost(1000000000001);
    #assert dp_prefix(0) && dp_prefix(1048576) && !dp_prefix(-1) && !dp_prefix(1048577);
    for field:0..<7 {v:=c;if field==0 {v.max_chunk=0;}else if field==1 {v.bytes_per_token=0;}else if field==2 {v.fixed_ns=-1;}else if field==3 {v.token_ns=0;}else if field==4 {v.expert_ns=-1;}else if field==5 {v.target_ns=0;}else {v.workspace=-1;}#assert dp_chunk(v,4).status==DsStatus.shape;}
}
#test "layer-major cursor requires every attention route group and combine receipt before commit" {
    start:=dp_start(5,3,2,4,2,7);#assert start.status==DsStatus.ok;cursor:=start.value;keys:=[2]int.[0,3];empty:=[1]int.[0];counts:[7]int;steps:=0;
    while cursor.phase!=DpPhase.done {counts[cast(int)(cast(u8)cursor.phase)]+=1;receipt:=DpReceipt.{epoch=cursor.epoch,layer=cursor.layer,phase=cursor.phase,group=cursor.group,ok=true};route_keys:=empty[0..<0];if cursor.phase==DpPhase.route {route_keys=keys[..];}
        next:=dp_advance(cursor,receipt,route_keys);#assert next.status==DsStatus.ok;cursor=next.value;steps+=1;#assert steps<=13;}
    #assert steps==13 && cursor.layer==2 && cursor.first==5 && cursor.count==3 && cursor.epoch==8 && cursor.keys.count==0;
    #assert counts[0]==2 && counts[1]==2 && counts[2]==4 && counts[3]==2 && counts[4]==2 && counts[5]==1 && counts[6]==0;
    #assert dp_advance(cursor,DpReceipt.{ok=true},empty[0..<0]).status==DsStatus.state;
    for field:0..<5 {r:=DpReceipt.{epoch=7,layer=0,phase=DpPhase.attention,group=0,ok=true};if field==0 {r.epoch=8;}else if field==1 {r.layer=1;}else if field==2 {r.phase=DpPhase.route;}else if field==3 {r.group=1;}else {r.ok=false;}#assert dp_advance(start.value,r,empty[0..<0]).status==DsStatus.state;}
    #assert dp_start(-1,3,2,4,2,7).status==DsStatus.shape && dp_start(1048575,2,2,4,2,7).status==DsStatus.shape && dp_start(0,0,2,4,2,7).status==DsStatus.shape;
    #assert dp_start(0,1,0,4,2,7).status==DsStatus.shape && dp_start(0,1,44,4,2,7).status==DsStatus.shape && dp_start(0,1,2,4,2,-1).status==DsStatus.shape && dp_start(0,1,2,4,2,1048576).status==DsStatus.shape;
    #assert dp_start(1048575,1,43,384,8,1048575).status==DsStatus.ok;
    bad:=start.value;bad.layer=-1;#assert !dp_cursor_valid(bad);bad=start.value;bad.group=1;#assert !dp_cursor_valid(bad);bad=start.value;bad.keys=keys[..];#assert !dp_cursor_valid(bad);
    #assert dp_keys(keys[..],4,6);keys[1]=0;#assert !dp_keys(keys[..],4,6);keys[1]=4;#assert !dp_keys(keys[..],4,6);keys[0]=-1;keys[1]=3;#assert !dp_keys(keys[..],4,6);
}

#test "remaining tails serial requests cursor phases and all key-count bounds are exact" {
    #assert dp_min(0,8)==0 && dp_min(8,0)==0 && dp_min(1,1)==1 && dp_min(2,1)==1 && dp_min(1,2)==1;
    #assert dp_expert_k(1,1) && dp_expert_k(384,8) && !dp_expert_k(0,1) && !dp_expert_k(2,3) && !dp_expert_k(385,1) && !dp_expert_k(2,0) && !dp_expert_k(10,9);
    #assert dp_layers(1) && dp_layers(43) && !dp_layers(0) && !dp_layers(44);
    #assert dp_key_count(1,1,1) && dp_key_count(2,2,2) && !dp_key_count(0,1,1) && !dp_key_count(2,1,2) && !dp_key_count(2,2,1);
    #assert dp_terminal(1,1,0,0) && !dp_terminal(0,1,0,0) && !dp_terminal(1,1,1,0) && !dp_terminal(1,1,0,1);
    #assert dp_index(0,1) && !dp_index(-1,1) && !dp_index(1,1);#assert dp_phase(0) && dp_phase(6) && !dp_phase(7);
    cfg:=DpChunkConfig.{max_chunk=8,workspace=10000,bytes_per_token=1,token_ns=1,experts=1,k=1,target_ns=1000};#assert dp_chunk(cfg,3).count==3;cfg.serial=true;#assert dp_chunk(cfg,20).count==1;cfg.serial=false;cfg.max_chunk=2;cfg.target_ns=1;#assert dp_chunk(cfg,2).status==DsStatus.budget;
    start:=dp_start(0,3,1,6,2,0);#assert start.status==DsStatus.ok;empty:[1]int;cursor:=start.value;r:=DpReceipt.{ok=true};
    #assert dp_advance(cursor,r,empty[..]).status==DsStatus.state;r.phase=DpPhase.attention;next:=dp_advance(cursor,r,empty[0..<0]);#assert next.status==DsStatus.ok;cursor=next.value;
    keys:=[6]int.[0,1,2,3,4,5];r.phase=DpPhase.route;next=dp_advance(cursor,r,keys[..]);#assert next.status==DsStatus.ok && dp_cursor_valid(next.value);
    cursor=next.value;cursor.group=-1;#assert !dp_cursor_valid(cursor);cursor.group=6;#assert !dp_cursor_valid(cursor);cursor.group=0;cursor.keys=empty[0..<0];#assert !dp_cursor_valid(cursor);
    cursor=start.value;cursor.layer=1;#assert !dp_cursor_valid(cursor);r=DpReceipt.{epoch=cursor.epoch,layer=cursor.layer,phase=cursor.phase,group=cursor.group,ok=true};#assert dp_advance(cursor,r,empty[0..<0]).status==DsStatus.state;
    cursor=DpCursor.{count=1,layers=1,layer=1,experts=1,k=1,phase=DpPhase.done};r=DpReceipt.{layer=1,phase=DpPhase.done,ok=true};#assert dp_advance(cursor,r,empty[0..<0]).status==DsStatus.state;
    cursor.phase=DpPhase.commit;cursor.epoch=1048576;r.phase=DpPhase.commit;r.epoch=1048576;#assert dp_advance(cursor,r,empty[0..<0]).status==DsStatus.state;
    key:=[1]int.[0];#assert dp_keys(key[..],1,1) && !dp_keys(key[0..<0],1,1) && !dp_keys(keys[..],6,5);
}

dp_min :: (a:int,b:int)->int {return (a+b-cast(int)abs(f64(a-b)))/2;}
dp_expert_k :: (experts:int,k:int)->bool {return experts>=1 && experts<=384 && k>=1 && k<=8 && k<=experts;}
dp_layers :: (layers:int)->bool {return layers>=1 && layers<=43;}
dp_key_count :: (count:int,experts:int,assignments:int)->bool {return count>=1 && count<=experts && count<=assignments;}
dp_terminal :: (layer:int,layers:int,group:int,keys:int)->bool {return layer==layers && group==0 && keys==0;}
dp_index :: (index:int,count:int)->bool {return index>=0 && index<count;}
dp_phase :: (phase:u8)->bool {return phase<=6;}
dp_nonnegative :: (v:int)->bool {return v>=0 && v<=1000000000000;}
dp_positive_cost :: (v:int)->bool {return v>=1 && v<=1000000000000;}
dp_memory :: (v:int)->bool {return v>=0 && v<=1125899906842624;}
dp_prefix :: (v:int)->bool {return v>=0 && v<=1048576;}
dp_cost :: (c:DpChunkConfig,n:int)->int {active:=dp_min(n*c.k,c.experts);return c.fixed_ns+n*c.token_ns+active*c.expert_ns;}
// book:begin chunk
dp_chunk :: (c:DpChunkConfig,remaining:int)->DpChunk #export_c {
    if !dp_batch(c.max_chunk) || (!c.serial && c.max_chunk==1) || !dp_positive_cost(c.bytes_per_token) || !dp_nonnegative(c.fixed_ns) || !dp_positive_cost(c.token_ns) || !dp_nonnegative(c.expert_ns) || !dp_positive_cost(c.target_ns) || !dp_memory(c.workspace) || !dp_expert_k(c.experts,c.k) || !dp_prefix(remaining) || remaining==0 {return DpChunk.{status=DsStatus.shape};}
    cap:=dp_min(c.max_chunk,remaining);cap=dp_min(cap,c.workspace/c.bytes_per_token);if c.serial {cap=dp_min(cap,1);}
    low:=0;high:=cap+1;while low+1<high {middle:=(low+high)/2;if dp_cost(c,middle)<=c.target_ns {low=middle;}else {high=middle;}}
    if low==0 || (!c.serial && remaining>1 && low<2) {return DpChunk.{status=DsStatus.budget};}
    return DpChunk.{count=low,predicted_ns=dp_cost(c,low),tail=remaining==1,serial=c.serial};
}
// book:end chunk
dp_keys :: (keys:[]int,experts:int,assignments:int)->bool {if !dp_key_count(keys.count,experts,assignments) {return false;}previous:=-1;for key:keys {if key<=previous || key>=experts {return false;}previous=key;}return true;}
dp_cursor_valid :: (c:DpCursor)->bool {
    if !dp_phase(cast(u8)c.phase) || !dp_prefix(c.first) || !dp_batch(c.count) || c.first+c.count>1048576 || !dp_layers(c.layers) || !dp_route_shape(c.experts,c.count,c.k) || !dp_prefix(c.epoch) {return false;}
    if c.phase==DpPhase.commit || c.phase==DpPhase.done {return dp_terminal(c.layer,c.layers,c.group,c.keys.count);}
    if c.layer<0 || c.layer>=c.layers {return false;}if c.phase==DpPhase.attention || c.phase==DpPhase.route {return c.group==0 && c.keys.count==0;}
    if !dp_keys(c.keys,c.experts,c.count*c.k) {return false;}if c.phase==DpPhase.expert {return dp_index(c.group,c.keys.count);}return c.group==0;
}
dp_start :: (first:int,count:int,layers:int,experts:int,k:int,epoch:int)->DpNext #export_c {
    c:=DpCursor.{first=first,count=count,layers=layers,experts=experts,k=k,epoch=epoch};if !dp_cursor_valid(c) || epoch==1048576 {return DpNext.{status=DsStatus.shape};}return DpNext.{value=c};
}
dp_advance :: (c:DpCursor,r:DpReceipt,keys:[]int)->DpNext #export_c {
    if !dp_cursor_valid(c) || c.phase==DpPhase.done || !r.ok || r.epoch!=c.epoch || r.layer!=c.layer || r.phase!=c.phase || r.group!=c.group {return DpNext.{status=DsStatus.state};}
    if c.phase!=DpPhase.route && keys.count!=0 {return DpNext.{status=DsStatus.state};}next:=c;
    if c.phase==DpPhase.attention {next.phase=DpPhase.route;}
    else if c.phase==DpPhase.route {if !dp_keys(keys,c.experts,c.count*c.k) {return DpNext.{status=DsStatus.state};}next.keys=keys;next.phase=DpPhase.expert;}
    else if c.phase==DpPhase.expert {next.group+=1;if next.group==c.keys.count {next.group=0;next.phase=DpPhase.shared;}}
    else if c.phase==DpPhase.shared {next.phase=DpPhase.combine;}
    else if c.phase==DpPhase.combine {next.layer+=1;next.keys=keys;next.phase=ifx next.layer==c.layers then DpPhase.commit else DpPhase.attention;}
    else {if c.epoch==1048576 {return DpNext.{status=DsStatus.state};}next.phase=DpPhase.done;next.epoch+=1;}
    return DpNext.{value=next};
}
