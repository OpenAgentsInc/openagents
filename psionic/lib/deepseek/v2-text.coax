#load "v2-generate.coax";
#load "../model-io/identity.coax";
#authority;
#load "../../fixtures/deepseek/v2-original/text-targets.coax";
DvText :: struct {status:DsStatus;count:int;pool:int;}
#test "V2 byte metadata supports empty token pools and independent unsigned fields" {
    bytes:=[5]u8.[9,120,86,52,18];#assert dv_text_u32(bytes[..],1)==305419896;
    #assert !dv_text_header(15) && dv_text_header(16) && dv_text_header(17);
    table:[24]u8;magic:="DV2T0001";for i:0..<8 {table[i]=magic[i];}table[8]=1;
    #assert dv_text_layout(table[..]).status==DsStatus.ok;
    ids:=[1]int.[0];out:[1]u8;stage:[1]u8;r:=dv_decode_answer(table[..],ids[..],out[0..<0],stage[0..<0],false);#assert r.status==DsStatus.ok && r.written==0;
    #assert dv_text_record(13,0,13) && dv_text_record(5,8,13) && !dv_text_record(14,0,13) && !dv_text_record(5,9,13);
    #assert dv_answer_room(1,65535) && !dv_answer_room(1,65536);
}
#test "V2 answer bytes preserve UTF8 and literal markers and strip only a final typed EOS" {
    table:=DV_TEXT_TOY;ids:=[4]int.[0,1,2,100001];out:[32]u8;stage:[32]u8;
    r:=dv_decode_answer(table[..],ids[..],out[..],stage[..],false);#assert r.status==DsStatus.ok && cast(string)out[0..<r.written]=="a😀</think>";
    #assert dv_decode_answer(table[..],ids[..],out[0..<13],stage[0..<13],false).status==DsStatus.ok;
    #assert dv_decode_answer(table[..],ids[..],out[..],stage[0..<4],false).status==DsStatus.capacity;
    out[0]=7;#assert dv_decode_answer(table[..],ids[..],out[0..<1],stage[..],false).status==DsStatus.capacity && out[0]==7;
    #assert dv_decode_answer(table[..],ids[..],out[..],stage[0..<1],false).status==DsStatus.capacity && out[0]==7;
    #assert dv_decode_answer(table[..],ids[..],out[..],stage[..],true).status==DsStatus.alias;
    ids[0]=100000;#assert dv_decode_answer(table[..],ids[..],out[..],stage[..],false).status==DsStatus.format;
    ids[0]=100001;#assert dv_decode_answer(table[..],ids[..],out[..],stage[..],false).status==DsStatus.format;
    ids[0]=-1;#assert dv_decode_answer(table[..],ids[..],out[..],stage[..],false).status==DsStatus.token;
    ids[0]=3;#assert dv_decode_answer(table[..],ids[..],out[..],stage[..],false).status==DsStatus.token;
}
#test "V2 token-byte layouts refuse bad magic lengths and out-of-pool records" {
    table:=DV_TEXT_TOY;#assert dv_text_layout(table[..]).status==DsStatus.ok && dv_text_layout(table[0..<15]).status==DsStatus.format;
    table[0]=0;#assert dv_text_layout(table[..]).status==DsStatus.format;table=DV_TEXT_TOY;table[8]=0;#assert dv_text_layout(table[..]).status==DsStatus.format;
    table=DV_TEXT_TOY;table[12]=1;#assert dv_text_layout(table[..]).status==DsStatus.format;
    table=DV_TEXT_TOY;table[16]=255;ids:=[1]int.[0];out:[32]u8;stage:[32]u8;#assert dv_decode_answer(table[..],ids[..],out[..],stage[..],false).status==DsStatus.format;
    table[16]=14;table[20]=0;#assert dv_decode_answer(table[..],ids[..],out[..],stage[..],false).status==DsStatus.format;
    #assert !dv_text_admit(table[..]);
    #assert dv_answer_count(4096) && !dv_answer_count(4097) && dv_answer_bytes(65536) && !dv_answer_bytes(65537);
}
dv_text_u32 :: (data:[]u8,at:int)->int {return cast(int)(u32(data[at])|(u32(data[at+1])<<8)|(u32(data[at+2])<<16)|(u32(data[at+3])<<24));}
dv_text_layout :: (data:[]u8)->DvText {
    if !dv_text_header(data.count) {return DvText.{status=DsStatus.format};}magic:="DV2T0001";for i:0..<8 {if data[i]!=magic[i] {return DvText.{status=DsStatus.format};}}
    n:=dv_text_u32(data,8);if !dv_logits_count(n) {return DvText.{status=DsStatus.format};}pool:=16+8*n;
    if data.count<pool || dv_text_u32(data,12)!=data.count-pool {return DvText.{status=DsStatus.format};}return DvText.{count=n,pool=pool};
}
dv_text_header :: (n:int)->bool {return n>=16;}
dv_text_record :: (begin:int,bytes:int,pool:int)->bool {return begin<=pool && bytes<=pool-begin;}
dv_text_admit :: (data:[]u8)->bool #export_c {return pw_digest(data,DV_TEXT_SHA);}
dv_answer_count :: (n:int)->bool {return n<=4096;}
dv_answer_bytes :: (n:int)->bool {return n<=65536;}
dv_answer_room :: (n:int,bytes:int)->bool {return dv_answer_bytes(n+bytes);}
dv_decode_answer :: (data:[]u8,ids:[]int,out:[]u8,stage:[]u8,overlap:bool)->DsResult #export_c {
    if overlap {return DsResult.{status=DsStatus.alias};}layout:=dv_text_layout(data);if layout.status!=DsStatus.ok {return DsResult.{status=layout.status};}
    if !dv_answer_count(ids.count) {return DsResult.{status=DsStatus.budget};}n:=0;
    for i:0..<ids.count {id:=ids[i];if id==dv_original_bos() {return DsResult.{status=DsStatus.format};}
        if id==dv_original_eos() {if i!=ids.count-1 {return DsResult.{status=DsStatus.format};}}
        else {if id<0 || id>=layout.count {return DsResult.{status=DsStatus.token};}begin:=dv_text_u32(data,16+8*id);bytes:=dv_text_u32(data,20+8*id);
            if !dv_text_record(begin,bytes,data.count-layout.pool) {return DsResult.{status=DsStatus.format};}
            if !dv_answer_room(n,bytes) {return DsResult.{status=DsStatus.budget};}if bytes>stage.count-n {return DsResult.{status=DsStatus.capacity};}
            for j:0..<bytes {stage[n+j]=data[layout.pool+begin+j];}n+=bytes;
        }
    }
    if n>out.count {return DsResult.{status=DsStatus.capacity};}for i:0..<n {out[i]=stage[i];}return DsResult.{written=n};
}
