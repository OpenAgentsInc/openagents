// Chapter 69: the launch plan and device admission for the
// MXFP4-BF16-MMA-v1 kernels in mxfp4-mma.coax, and the C host's entries for
// comparing device outputs with the binary64 reference. The host reports the
// device and launches; every decision here is Coax.
#load "mxfp4-mma.coax";
#load "admit.coax";
#authority;

// book:begin plan
MmStatus :: enum u8 {ok;shape;slices;tokens;device;}
// A launch of the profile: shape refusals first, then the device.
MmPlan :: struct {status:MmStatus;admission:DaStatus;split_items:int;part_items:int;finish_items:int;instructions:int;}
// What mm_part needs: one warp, registers only, and the tensor-core
// instruction.
MM_NEEDS :: DaNeeds.{threads=32,shared=0,mma=true};
mm_plan :: (rows:int,cols:int,tokens:int,slots:int,slices:int,dev:DaDevice)->MmPlan {
    if rows<16 || rows%16!=0 || cols<32 || cols%32!=0 || slots<1 {return MmPlan.{status=MmStatus.shape};}
    if slices<1 || cols%(16*slices)!=0 {return MmPlan.{status=MmStatus.slices};}
    if tokens<1 || tokens>4096 {return MmPlan.{status=MmStatus.tokens};}
    admitted:=da_admit(MM_NEEDS,dev);
    if admitted!=DaStatus.ok {return MmPlan.{status=MmStatus.device,admission=admitted};}
    groups:=(tokens+MM_TOKENS-1)/MM_TOKENS;
    return MmPlan.{split_items=slots*((tokens+7)/8*8)*cols/2,part_items=slots*groups*rows/16*slices,
        finish_items=slots*tokens*rows,instructions=mm_instructions(cols,slices)};
}
mm_text :: (p:MmPlan)->string {
    if p.status==MmStatus.ok {return "admitted";}
    if p.status==MmStatus.shape {return "refused: rows must be a multiple of 16 and columns a multiple of 32";}
    if p.status==MmStatus.slices {return "refused: the slices must divide the 16-column steps";}
    if p.status==MmStatus.tokens {return "refused: tokens must be 1 to 4096";}
    return da_text(p.admission);
}
// book:end plan

// The C host's entry: the plan as numbers. out receives split, part and
// finish work items and the instruction count; the result is the MmStatus
// number, and with 4 (device) the DaStatus number is added times 16.
mm_plan_c :: (rows:int,cols:int,tokens:int,slots:int,slices:int,major:int,minor:int,max_threads:int,max_shared:int,out:[]int)->int #export_c {
    p:=mm_plan(rows,cols,tokens,slots,slices,DaDevice.{major=major,minor=minor,max_threads=max_threads,max_shared=max_shared});
    if out.count<4 {return -1;}
    out[0]=p.split_items;out[1]=p.part_items;out[2]=p.finish_items;out[3]=p.instructions;
    return cast(int)p.status+16*cast(int)p.admission;
}
// The C host's entry for a device comparison: the error of `got` against the
// reference, as a fraction of the magnitude sum, written to out[0], and the
// bound for n instructions as the same fraction to out[1]. Returns 1 when
// the output is within the bound.
mm_check_c :: (rows:int,cols:int,stride:int,expert:int,row:int,slot:int,token:int,instructions:int,got:f32,packed:[]u8,scales:[]u8,bias:[]u16,x:[]f32,out:[]f64)->int #export_c {
    r:=mm_reference(rows,cols,stride,expert,row,slot,token,packed,scales,bias,x);
    err:=abs(f64(got)-r.value);bound:=mm_bound(instructions,r.magnitude);
    if out.count>=2 && r.magnitude>0 {out[0]=err/r.magnitude;out[1]=bound/r.magnitude;}
    return ifx err<=bound then 1 else 0;
}
// Chapter 66's rule for the C host: 1 when candidate passes against reference.
mm_rule_c :: (candidate:f32,reference:f32)->int #export_c {return ifx mm_rule_66(candidate,reference) then 1 else 0;}

// ---- Checks.
#test "the plan refuses shapes, slices, tokens and devices without the instruction" {
    d:=DaDevice.{major=8,minor=9,max_threads=1024,max_shared=49152};
    p:=mm_plan(5760,2880,1,4,4,d);
    #assert p.status==MmStatus.ok && p.admission==DaStatus.ok && p.split_items==4*8*1440 && p.part_items==4*360*4 && p.finish_items==4*5760 && p.instructions==90;
    p=mm_plan(2880,2880,100,4,1,d);
    #assert p.status==MmStatus.ok && p.split_items==4*104*1440 && p.part_items==4*4*180 && p.finish_items==4*100*2880 && p.instructions==360;
    #assert mm_plan(16,32,1,1,1,d).status==MmStatus.ok && mm_plan(16,32,4096,1,2,d).status==MmStatus.ok;
    // 32 tokens fill one warp's token group; 33 need a second.
    p=mm_plan(16,32,32,3,1,d);#assert p.part_items==3 && p.split_items==3*32*16 && p.finish_items==3*32*16;
    p=mm_plan(16,32,33,3,1,d);#assert p.part_items==6 && p.split_items==3*40*16;
    p=mm_plan(16,32,31,3,1,d);#assert p.part_items==3 && p.split_items==3*32*16;
    #assert mm_plan(8,32,1,1,1,d).status==MmStatus.shape && mm_plan(24,32,1,1,1,d).status==MmStatus.shape;
    #assert mm_plan(16,16,1,1,1,d).status==MmStatus.shape && mm_plan(16,48,1,1,1,d).status==MmStatus.shape;
    #assert mm_plan(16,32,1,0,1,d).status==MmStatus.shape;
    #assert mm_plan(16,32,1,1,0,d).status==MmStatus.slices && mm_plan(16,32,1,1,3,d).status==MmStatus.slices;
    #assert mm_plan(16,32,1,1,4,d).status==MmStatus.slices && mm_plan(16,64,1,1,4,d).status==MmStatus.ok;
    #assert mm_plan(16,32,0,1,1,d).status==MmStatus.tokens && mm_plan(16,32,4097,1,1,d).status==MmStatus.tokens;
    old:=DaDevice.{major=7,minor=5,max_threads=1024,max_shared=49152};
    p=mm_plan(5760,2880,1,4,4,old);
    #assert p.status==MmStatus.device && p.admission==DaStatus.mma && p.part_items==0;
    #assert mm_plan(5760,2880,1,4,4,DaDevice.{major=8,minor=0,max_threads=32,max_shared=0}).status==MmStatus.ok;
    #assert mm_plan(16,32,1,1,1,DaDevice.{major=0,minor=0,max_threads=32,max_shared=0}).admission==DaStatus.report;
    // Shape refusals come before the device.
    #assert mm_plan(8,32,1,1,1,old).status==MmStatus.shape;
}
#test "plan texts and the C entries" {
    d:=DaDevice.{major=8,minor=9,max_threads=1024,max_shared=49152};old:=DaDevice.{major=7,minor=5,max_threads=1024,max_shared=49152};
    #assert mm_text(mm_plan(16,32,1,1,1,d))=="admitted";
    #assert mm_text(mm_plan(8,32,1,1,1,d))=="refused: rows must be a multiple of 16 and columns a multiple of 32";
    #assert mm_text(mm_plan(16,32,1,1,3,d))=="refused: the slices must divide the 16-column steps";
    #assert mm_text(mm_plan(16,32,0,1,1,d))=="refused: tokens must be 1 to 4096";
    #assert mm_text(mm_plan(16,32,1,1,1,old))=="refused: cu_mma_bf16_16x8x16 needs compute capability 8.0 or later";
    out:[4]int;short:[3]int;
    #assert mm_plan_c(5760,2880,1,4,4,8,9,1024,49152,out[..])==0 && out[0]==4*8*1440 && out[1]==5760 && out[2]==4*5760 && out[3]==90;
    #assert mm_plan_c(5760,2880,1,4,4,7,5,1024,49152,out[..])==4+16*5 && out[1]==0;
    #assert mm_plan_c(8,32,1,1,1,8,9,1024,49152,out[..])==1 && mm_plan_c(16,32,1,1,1,8,9,1024,49152,short[..])==-1;
    #assert MM_PROFILE=="MXFP4-BF16-MMA-v1";
}
#test "the C entries for the bound and chapter 66's rule" {
    #assert mm_rule_c(1.0004,1)==1 && mm_rule_c(1.0012,1)==0;
    packed:[16]u8;scales:=[1]u8.[127];bias:=[1]u16.[0];x:[32]f32;e:[2]f64;
    for i:0..<16 {packed[i]=0x22;}for c:0..<32 {x[c]=1;}
    // 16 rows are not needed for the reference: one row of 32 ones is 32.
    #assert mm_check_c(1,32,0,0,0,0,0,4,32,packed[..],scales[..],bias[..],x[..],e[..])==1 && e[0]==0 && e[1]==22.0/1048576.0;
    over:=f32(32+32*22.0/1048576.0*2);
    #assert mm_check_c(1,32,0,0,0,0,0,4,over,packed[..],scales[..],bias[..],x[..],e[..])==0 && e[0]==44.0/1048576.0 && e[1]==22.0/1048576.0;
    edge:=f32(32+32*22.0/1048576.0);
    #assert mm_check_c(1,32,0,0,0,0,0,4,edge,packed[..],scales[..],bias[..],x[..],e[..])==1;
    short:[1]f64;short[0]=-1;
    // With no magnitude the fractions are left alone.
    zero:[32]f32;e[0]=-1;e[1]=-1;
    #assert mm_check_c(1,32,0,0,0,0,0,4,0,packed[..],scales[..],bias[..],zero[..],e[..])==1 && e[0]==-1 && e[1]==-1;
    #assert mm_check_c(1,32,0,0,0,0,0,4,32,packed[..],scales[..],bias[..],x[..],short[..])==1 && short[0]==-1;
}
