// The device schedule for one Elephant or Mammoth decision: workspace layout, which
// weights stay resident and which stream from pinned host memory, and every
// copy and kernel launch in order. The host executes the operations as
// written; it makes no arithmetic, tiling or scheduling decision.
#load "project.coax";
#load "layer.coax";
#load "warp.coax";
#load "tile.coax";
#authority;

// Kernels in the order the host looks them up by name.
DpKernel :: enum u8 {project;matvec;reduce;squares;add_squares;scale;add;swiglu;conv;gates;qk;scan;gate_norm;prepare;scores;softmax;attend;split;mma_project;conv_state;scan_state;tile_narrow;tile_wide;}
// The CUDA engine loads the first 21; Metal loads all of them.
DP_KERNELS :: 23;
dp_kernel_name :: (id:int)->string #export_c {
    names:=[23] string.["dv_project","dv_matvec","dv_reduce","dl_squares","dl_add_squares","dl_scale","dl_add","dl_swiglu","dl_conv","dl_gates","dl_qk","dl_scan","dl_gate_norm","dl_prepare","dl_scores","dl_softmax","dl_attend","dw_split","dw_project","dl_conv_state","dl_scan_state","dt_project_16x32","dt_project_16x64"];
    if id<0 || id>=DP_KERNELS {return "";}
    return names[id];
}

// Operation kinds. launch runs on the compute stream. copy fills a streaming
// slot from pinned host memory on the copy stream, after the slot's previous
// tensor is released. wait makes the compute stream wait for that copy;
// release records that the compute stream is done with the slot.
DpOpKind :: enum u8 {launch;copy;wait;release;}
// Argument kinds match the host's PcArgKind: int, u32, f32, f64, view.
// A view names a buffer (0 workspace, 1 and 2 the streaming slots, 3+id a
// resident weight), a byte offset and an element count.
DpArg :: struct {kind:u8;value:int;real:f64;buffer:int;offset:int;count:int;}
// lanes is 32 for a warp kernel, whose items are warps of 32 threads, and
// the group size (128) for a group kernel, whose items are threadgroups.
DpOp :: struct {kind:DpOpKind;kernel:u8;items:int;block:int;lanes:int;count:int;tensor:int;slot:int;args:[12]DpArg;}
DpStatus :: enum u8 {ok;shape;capacity;memory;}
// metal: projections use the Apple matrix-unit tiles (tile.coax).
// kind: the model (dp_model) the placement is for.
DpPlan :: struct {status:DpStatus;ops:int;workspace:int;resident:int;streamed:int;slot:int;streamed_tensors:int;metal:bool;rope:int;logits:int;kind:int;}

// book:begin model
// The decision's shape is data. Elephant (kind 0) and Mammoth (kind 1) share
// the layer pattern (every fourth layer is full attention), the head sizes
// (128 in the linear layers, 256 in the full ones), 16 key heads in the
// linear layers, 4 key/value heads in the full ones, and the vocabulary.
// They differ in depth, width, feed-forward width and head counts. Any other
// kind names Elephant here; the plans refuse it.
// chunks: how many pieces of up to `hidden` rows the head streams in.
DpModel :: struct {kind:int;layers:int;width:int;hidden:int;vocab:int;key_heads:int;value_heads:int;heads:int;kv_heads:int;chunks:int;}
dp_model :: (kind:int)->DpModel #export_c {
    if kind==1 {return DpModel.{kind=1,layers=64,width=5120,hidden=17408,vocab=248320,key_heads=16,value_heads=48,heads=24,kv_heads=4,chunks=15};}
    return DpModel.{layers=32,width=4096,hidden=12288,vocab=248320,key_heads=16,value_heads=32,heads=16,kv_heads=4,chunks=21};
}
// book:end model
// Rows of a linear layer's [q | k | v] projection, of its value heads and of
// a full layer's [query | gate] projection; columns of its attention output;
// rows of one key or value projection.
dp_channels :: (m:DpModel)->int {return 256*m.key_heads+128*m.value_heads;}
dp_values :: (m:DpModel)->int {return 128*m.value_heads;}
dp_queries :: (m:DpModel)->int {return 512*m.heads;}
dp_attended :: (m:DpModel)->int {return 256*m.heads;}
dp_kv :: (m:DpModel)->int {return 256*m.kv_heads;}

// Weight ids per layer: linear 0 input_norm, 1 post_norm, 2 conv, 3 A_log,
// 4 dt_bias, 5 delta norm, 6 qkv, 7 z, 8 a, 9 b, 10 out, 11 gate, 12 up,
// 13 down; full 0 input_norm, 1 post_norm, 2 q_norm, 3 k_norm, 4 q, 5 k, 6 v,
// 7 out, 8 gate, 9 up, 10 down. Head and final norm follow the layers.
// The DP_ constants are Elephant's.
DP_LAYERS :: 32;
DP_WIDTH :: 4096;
DP_HIDDEN :: 12288;
DP_VOCAB :: 248320;
DP_PER_LAYER :: 16;
DP_HEAD :: 512;
DP_FINAL :: 513;
DP_WEIGHTS :: 514;
dp_head :: (m:DpModel)->int {return m.layers*DP_PER_LAYER;}
dp_final :: (m:DpModel)->int {return dp_head(m)+1;}
dp_weights :: (m:DpModel)->int #export_c {return dp_head(m)+2;}
dp_full :: (layer:int)->bool #export_c {return layer%4==3;}
dp_weight :: (layer:int,j:int)->int #export_c {return layer*DP_PER_LAYER+j;}
// Elements of weight id w (f32 vectors count values; BF16 matrices count
// values too); 0 for an unused id inside a layer and -1 outside every layer.
dp_weight_elements :: (w:int)->int #export_c {return dp_elements(dp_model(0),w);}
dp_elements :: (m:DpModel,w:int)->int #export_c {
    if w<0 || w>dp_final(m) {return -1;}
    if w>=dp_head(m) {if w==dp_head(m) {return m.vocab*m.width;}return m.width;} // the head, then the final norm
    layer:=w/DP_PER_LAYER;j:=w%DP_PER_LAYER;d:=m.width;f:=m.hidden;
    if dp_full(layer) {
        sizes:=[11] int.[d,d,256,256,dp_queries(m)*d,dp_kv(m)*d,dp_kv(m)*d,d*dp_attended(m),f*d,f*d,d*f];
        if j>=11 {return 0;}
        return sizes[j];
    }
    c:=dp_channels(m);h:=m.value_heads;
    sizes:=[14] int.[d,d,4*c,h,h,128,c*d,dp_values(m)*d,h*d,h*d,d*dp_values(m),f*d,f*d,d*f];
    if j>=14 {return 0;}
    return sizes[j];
}
// BF16 matrices stay in their original bytes; the small vectors are the
// session's decoded f32 values.
dp_weight_bf16 :: (w:int)->bool #export_c {return dp_bf16(dp_model(0),w);}
dp_bf16 :: (m:DpModel,w:int)->bool #export_c {
    if w>=dp_head(m) {return w==dp_head(m);}
    j:=w%DP_PER_LAYER; // negative for a negative id: never a matrix
    if dp_full(w/DP_PER_LAYER) {return j>=4 && j<=10;}
    return j>=6 && j<=13;
}
dp_weight_bytes :: (w:int)->int #export_c {return dp_bytes(dp_model(0),w);}
dp_bytes :: (m:DpModel,w:int)->int #export_c {
    n:=dp_elements(m,w);if dp_bf16(m,w) {return 2*n;}return 4*n;
}

// Workspace regions, in f32 elements unless noted; offsets are bytes, each
// aligned to 256.
DpLayout :: struct {x0:int;x1:int;norm:int;residual:int;qkv:int;z:int;a:int;b:int;k:int;v:int;conv:int;qn:int;kn:int;beta:int;decay:int;
    draft:int;mix:int;aq:int;ak:int;scores:int;stats:int;probs:int;squares:int;partial:int;partial_rows:int;hi:int;lo:int;out:int;gate:int;up:int;product:int;down:int;rope:int;final:int;logits:int;lanes:int;total:int;}
dp_align :: (n:int)->int {return (n+255)/256*256;}
// The larger of a and b.
dp_wider :: (a:int,b:int)->int {return (a+b+cast(int)abs(f64(a-b)))/2;}
dp_layout :: (tokens:int)->DpLayout {return dp_layout_of(dp_model(0),tokens,tokens);}
// A forked suffix's tokens attend over keys (the prefix's and its own).
dp_layout_keys :: (tokens:int,keys:int)->DpLayout {return dp_layout_of(dp_model(0),tokens,keys);}
dp_layout_of :: (m:DpModel,tokens:int,keys:int)->DpLayout {
    // The first 256 bytes stay unused, so offset 0 never names a region.
    p:DpLayout;at:=256;t:=tokens;d:=m.width;f:=m.hidden;c:=dp_channels(m);v:=dp_values(m);h:=m.value_heads;n:=m.heads;
    // The [q | k | v] channels and a full layer's [query | gate] share one region.
    rows:=dp_wider(c,dp_queries(m));mix:=dp_wider(v,dp_attended(m));
    p.x0=at;at+=dp_align(4*t*d);p.x1=at;at+=dp_align(4*t*d);p.norm=at;at+=dp_align(4*t*d);p.residual=at;at+=dp_align(4*t*d);
    p.qkv=at;at+=dp_align(4*t*rows);p.z=at;at+=dp_align(4*t*v);p.a=at;at+=dp_align(4*t*h);p.b=at;at+=dp_align(4*t*h);
    p.k=at;at+=dp_align(4*t*dp_kv(m));p.v=at;at+=dp_align(4*t*dp_kv(m));p.conv=at;at+=dp_align(4*t*c);
    p.qn=at;at+=dp_align(4*t*128*m.key_heads);p.kn=at;at+=dp_align(4*t*128*m.key_heads);p.beta=at;at+=dp_align(4*t*h);p.decay=at;at+=dp_align(4*t*h);
    p.draft=at;at+=dp_align(4*t*v);p.mix=at;at+=dp_align(4*t*mix);p.aq=at;at+=dp_align(4*t*dp_attended(m));p.ak=at;at+=dp_align(4*t*dp_kv(m));
    p.scores=at;at+=dp_align(4*t*n*keys);p.stats=at;at+=dp_align(8*t*n*3);p.probs=at;at+=dp_align(8*t*n*keys);p.squares=at;at+=dp_align(8*t*16);p.partial=at;p.partial_rows=8*f;at+=dp_align(4*p.partial_rows*t);
    pad:=dp_padded(t);p.hi=at;at+=dp_align(4*pad*f/2);p.lo=at;at+=dp_align(4*pad*f/2);p.out=at;at+=dp_align(4*t*d);
    p.gate=at;at+=dp_align(4*t*f);p.up=at;at+=dp_align(4*t*f);p.product=at;at+=dp_align(4*t*f);p.down=at;at+=dp_align(4*t*d);
    p.rope=at;at+=dp_align(4*t*64);p.final=at;at+=dp_align(4*d);p.logits=at;at+=dp_align(4*m.vocab);p.lanes=at;at+=dp_align(4*16*m.vocab);
    p.total=at;return p;
}

// book:begin residency
// Which weights stream from pinned host memory, through two slots that hold
// them in turn, each the size of one feed-forward matrix (96 MiB for
// Elephant, 170 MiB for Mammoth). The feed-forward matrices go first: all
// down projections, then up, then gate, in bit-reversed layer order (0, 16,
// 8, 24, ... for 32 layers) so any number of them is spread across the
// model. If that is not enough the head streams, in chunks of up to one
// feed-forward width of rows, and then the mixer matrices (the projections
// before each layer's attention or scan), a whole layer at a time in the
// same spread order. Only the small vectors and the workspace must fit:
// everything else can stream.
//
// Streaming indices, for L layers: 3*layer+k for feed-forward matrix k
// (0 gate, 1 up, 2 down); 3L+5*layer+k for mixer matrix k (linear: qkv, z,
// a, b, out; full: q, k, v, out, and k = 4 is no matrix); 8L+c for head
// chunk c.
dp_mixer_base :: (m:DpModel)->int {return 3*m.layers;}
dp_head_base :: (m:DpModel)->int {return 8*m.layers;}
dp_head_chunks :: (m:DpModel)->int #export_c {return m.chunks;}
dp_streamable :: (m:DpModel)->int #export_c {return dp_head_base(m)+dp_head_chunks(m);}
dp_residency_of :: (m:DpModel,budget:int,workspace:int,stream:[]bool)->DpPlan {
    if stream.count!=dp_streamable(m) {return DpPlan.{status=DpStatus.capacity};}
    total:=0;
    for w:0..<dp_weights(m) {total+=dp_align(dp_bytes(m,w));}
    slot:=dp_align(2*m.width*m.hidden);
    for i:0..<stream.count {stream[i]=false;}
    if workspace+total<=budget {return DpPlan.{workspace=workspace,resident=total,kind=m.kind};}
    over:=workspace+total+2*slot-budget;saved:=0;n:=0;l:=m.layers;
    kinds:=[3]int.[2,1,0];
    for i:0..<3*l {if saved<over {stream[3*dp_spread_of(l,i%l)+kinds[i/l]]=true;saved+=slot;n+=1;}}
    if saved<over {for c:0..<dp_head_chunks(m) {stream[dp_head_base(m)+c]=true;}saved+=dp_bytes(m,dp_head(m));n+=dp_head_chunks(m);}
    for i:0..<l {
        layer:=dp_spread_of(l,i);
        for k:0..<dp_mixers(layer) {
            x:=dp_mixer_base(m)+5*layer+k;
            if saved<over {stream[x]=true;saved+=dp_bytes(m,dp_stream_weight_of(m,x));n+=1;}
        }
    }
    if saved<over {return DpPlan.{status=DpStatus.memory};}
    return DpPlan.{workspace=workspace,resident=total-saved,streamed=saved,slot=slot,streamed_tensors=n,kind=m.kind};
}
// book:end residency
// Elephant's streaming constants and residency.
DP_FFN_STREAMS :: 96;
DP_MIXER_BASE :: 96;
DP_HEAD_BASE :: 256;
DP_HEAD_ROWS :: 12288;
DP_HEAD_CHUNKS :: 21;
DP_STREAMABLE :: 277;
// The most streaming indices of any model (Mammoth's).
DP_MAX_STREAMABLE :: 527;
dp_residency :: (budget:int,workspace:int,stream:[]bool)->DpPlan #export_c {return dp_residency_of(dp_model(0),budget,workspace,stream);}
// Position i of the bit-reversed order of `layers` layers, a power of two.
dp_spread :: (i:int)->int {return dp_spread_of(32,i);}
dp_spread_of :: (layers:int,i:int)->int {
    r:=0;x:=i;n:=1;
    while n<layers {r=(r<<1)|(x&1);x=x>>1;n=n*2;}
    return r;
}
// Mixer matrices in a layer: qkv, z, a, b and out in a linear layer; q, k,
// v and out in a full-attention layer.
dp_mixers :: (layer:int)->int {if dp_full(layer) {return 4;}return 5;}
// The streaming index of weight w (the first chunk for the head), or -1 for
// a weight that never streams. A negative w has a negative j.
dp_stream_index :: (w:int)->int {return dp_stream_index_of(dp_model(0),w);}
dp_stream_index_of :: (m:DpModel,w:int)->int {
    if w==dp_head(m) {return dp_head_base(m);}
    layer:=w/DP_PER_LAYER;j:=w%DP_PER_LAYER;
    if layer>=m.layers {return -1;}
    mixer:=6;if dp_full(layer) {mixer=4;}
    if j>=mixer && j<mixer+dp_mixers(layer) {return dp_mixer_base(m)+5*layer+j-mixer;}
    ffn:=mixer+dp_mixers(layer);
    if j>=ffn && j<ffn+3 {return 3*layer+j-ffn;}
    return -1;
}
// The weight of streaming index i, or -1 for an index that names no matrix.
dp_stream_weight :: (i:int)->int {return dp_stream_weight_of(dp_model(0),i);}
dp_stream_weight_of :: (m:DpModel,i:int)->int {
    if i<0 || i>=dp_streamable(m) {return -1;}
    if i>=dp_head_base(m) {return dp_head(m);}
    if i<dp_mixer_base(m) {
        layer:=i/3;j:=11+i%3;
        if dp_full(layer) {j=8+i%3;}
        return dp_weight(layer,j);
    }
    layer:=(i-dp_mixer_base(m))/5;k:=(i-dp_mixer_base(m))%5;
    if !dp_full(layer) {return dp_weight(layer,6+k);}
    if k==4 {return -1;}
    return dp_weight(layer,4+k);
}
dp_streamed :: (w:int,stream:[]bool)->bool #export_c {return dp_streamed_of(dp_model(0),w,stream);}
dp_streamed_of :: (m:DpModel,w:int,stream:[]bool)->bool #export_c {
    i:=dp_stream_index_of(m,w);
    return i>=0 && i<stream.count && stream[i];
}
// Rows in head chunk c.
dp_head_rows :: (c:int)->int {return dp_chunk_rows(dp_model(0),c);}
dp_chunk_rows :: (m:DpModel,c:int)->int {
    if c<dp_head_chunks(m)-1 {return m.hidden;}
    return m.vocab-c*m.hidden;
}
// book:begin copy
// The copy that fills a slot with streaming index x. Its one argument names
// the host bytes: weight 3+w, a byte offset into it and a byte count.
dp_copy :: (m:DpModel,x:int,slot:int)->DpOp {
    w:=dp_stream_weight_of(m,x);offset:=0;bytes:=dp_bytes(m,w);
    if x>=dp_head_base(m) {c:=x-dp_head_base(m);offset=2*c*m.hidden*m.width;bytes=2*dp_chunk_rows(m,c)*m.width;}
    op:=DpOp.{kind=DpOpKind.copy,tensor=w,slot=slot,count=1};
    op.args[0]=DpArg.{kind=4,buffer=3+w,offset=offset,count=bytes};
    return op;
}
// book:end copy

// Argument builders.
dp_int :: (v:int)->DpArg {return DpArg.{kind=0,value=v};}
dp_f32 :: (v:f32)->DpArg {return DpArg.{kind=2,real=f64(v)};}
dp_ws :: (offset:int,count:int)->DpArg {return DpArg.{kind=4,buffer=0,offset=offset,count=count};}
dp_w :: (w:int,count:int)->DpArg {return DpArg.{kind=4,buffer=3+w,count=count};}
// A BF16 matrix; the projection that reads it sets its count.
dp_matrix :: (w:int)->DpArg {return DpArg.{kind=4,buffer=3+w};}

// The builder also tracks streaming: the streaming indices in schedule order,
// how many there are and how many have been used.
// book:begin forkstate
// A forked decision (chapter 12) runs the shared prefix block once, keeping
// what its suffixes need in the fork buffer: each linear layer's last three
// convolution inputs and delta-rule state, and each full layer's rotated keys
// and values. A suffix starts at token `start` and reads them; it changes
// nothing a sibling suffix will read. save marks the prefix pass. The fork
// buffer is view 3+weights; the byte counts are per linear layer (history,
// state) and per full layer (keys, then as many bytes of values).
DpFork :: struct {on:bool;start:int;save:bool;}
dp_fork_buffer :: (m:DpModel)->int #export_c {return 3+dp_weights(m);}
dp_fork_history_bytes :: (m:DpModel)->int {return 4*3*dp_channels(m);}
dp_fork_state_bytes :: (m:DpModel)->int {return 4*m.value_heads*128*128;}
dp_fork_cache_bytes :: (m:DpModel)->int {return 4*DP_MAX_TOKENS*dp_kv(m);}
dp_fork_linear :: (m:DpModel)->int {return m.layers-m.layers/4;}
dp_fork_history_of :: (m:DpModel,layer:int)->int {return (layer-layer/4)*dp_fork_history_bytes(m);}
dp_fork_state_of :: (m:DpModel,layer:int)->int {return dp_fork_linear(m)*dp_fork_history_bytes(m)+(layer-layer/4)*dp_fork_state_bytes(m);}
dp_fork_keys_of :: (m:DpModel,layer:int)->int {return dp_fork_linear(m)*(dp_fork_history_bytes(m)+dp_fork_state_bytes(m))+layer/4*2*dp_fork_cache_bytes(m);}
dp_fork_bytes_of :: (m:DpModel)->int #export_c {return dp_fork_keys_of(m,m.layers);}
dp_fork_arg :: (m:DpModel,offset:int,count:int)->DpArg {return DpArg.{kind=4,buffer=dp_fork_buffer(m),offset=offset,count=count};}
// Bit 0: start from the kept values; bit 1: keep the final ones.
dp_fork_mode :: (f:DpFork)->int {m:=0;if f.start>0 {m+=1;}if f.save {m+=2;}return m;}
// book:end forkstate
// Elephant's fork buffer.
DP_FORK_BUFFER :: 3+DP_WEIGHTS;
DP_FORK_HISTORY :: 4*3*8192;          // bytes per linear layer
DP_FORK_STATE :: 4*32*128*128;        // bytes per linear layer
DP_FORK_CACHE :: 4*DP_MAX_TOKENS*1024; // bytes of keys, then of values, per full layer
dp_fork_history :: (layer:int)->int {return dp_fork_history_of(dp_model(0),layer);}
dp_fork_state :: (layer:int)->int {return dp_fork_state_of(dp_model(0),layer);}
dp_fork_keys :: (layer:int)->int {return dp_fork_keys_of(dp_model(0),layer);}
dp_fork_bytes :: ()->int #export_c {return dp_fork_bytes_of(dp_model(0));}
DpBuilder :: struct {ops:[]DpOp;n:int;ok:bool;stream:[]bool;order:[]int;count:int;at:int;metal:bool;fork:DpFork;m:DpModel;}
dp_push :: (b:DpBuilder,op:DpOp)->DpBuilder {
    r:=b;
    if b.n>=b.ops.count {r.ok=false;return r;}
    b.ops[b.n]=op;r.n=b.n+1;return r;
}
dp_launch :: (kernel:DpKernel,items:int,args:[12]DpArg,count:int)->DpOp {
    return DpOp.{kind=DpOpKind.launch,kernel=cast(u8)kernel,items=items,block=128,count=count,args=args};
}
// A BF16 projection: out (tokens x rows) = in (tokens x cols) times weight.
// book:begin slices
// Column slices for a prefill projection: 16, halved until the groups of four
// columns divide evenly and the partial sums fit their workspace region. One
// token uses the matvec kernel instead.
DP_PARTIAL_ROWS :: 8*12288; // Elephant's partial region: this many f32 per token (8 x the feed-forward width)
dp_slices :: (rows:int,cols:int,capacity:int)->int #export_c {
    s:=16;
    while s>1 && ((cols/4)%s!=0 || s*rows>capacity) {s/=2;}
    return s;
}
// book:end slices
// book:begin tensor
// Tokens padded to whole tensor-core warps (88 each).
dp_padded :: (tokens:int)->int {return (tokens+DW_TOKENS-1)/DW_TOKENS*DW_TOKENS;}
// Column slices for the tensor-core projection: doubled from 1 while the
// launch has fewer than 4096 warps, every slice keeps at least 8 steps of 16
// columns and the partial sums fit their region; at most 32.
dp_mma_slices :: (rows:int,cols:int,capacity:int)->int #export_c {
    s:=1;steps:=cols/16;
    while s<32 && rows/16*s<4096 && steps%(2*s)==0 && steps/(2*s)>=8 && 2*s*rows<=capacity {s*=2;}
    return s;
}
// A whole-prompt projection on the tensor cores: split the activations into
// BF16 halves, multiply per slice, add the slices.
dp_mma :: (b:DpBuilder,p:DpLayout,weight:DpArg,rows:int,cols:int,tokens:int,input:int,out:DpArg)->DpBuilder {
    pad:=dp_padded(tokens);s:=dp_mma_slices(rows,cols,p.partial_rows);
    x:[12]DpArg;x[0]=dp_int(cols);x[1]=dp_int(tokens);x[2]=dp_ws(input,tokens*cols);x[3]=dp_ws(p.hi,pad*cols/2);x[4]=dp_ws(p.lo,pad*cols/2);
    r:=dp_push(b,dp_launch(DpKernel.split,pad*cols/2,x,5));
    a:[12]DpArg;w:=weight;w.count=rows*cols/2;
    a[0]=dp_int(rows);a[1]=dp_int(cols);a[2]=dp_int(tokens);a[3]=dp_int(s);a[4]=w;a[5]=dp_ws(p.hi,pad*cols/2);a[6]=dp_ws(p.lo,pad*cols/2);a[7]=dp_ws(p.partial,s*tokens*rows);
    op:=dp_launch(DpKernel.mma_project,rows/16*(pad/DW_TOKENS)*s,a,8);op.lanes=32;
    r=dp_push(r,op);
    e:[12]DpArg;e[0]=dp_int(tokens*rows);e[1]=dp_int(s);e[2]=dp_ws(p.partial,s*tokens*rows);e[3]=out;
    return dp_push(r,dp_launch(DpKernel.reduce,tokens*rows,e,4));
}
// book:end tensor
DP_MMA_TOKENS :: 16; // from this many tokens, projections use the tensor cores
// book:begin apple
// On Metal every projection is one launch of matrix-unit tiles of 16 tokens
// by 64 rows (32 for the 32-row a and b), written straight to the output:
// no split, slices or reduce.
dp_tile :: (b:DpBuilder,weight:DpArg,rows:int,cols:int,tokens:int,input:int,out:DpArg)->DpBuilder {
    a:[12]DpArg;w:=weight;w.count=rows*cols/2;
    a[0]=dp_int(rows);a[1]=dp_int(cols);a[2]=dp_int(tokens);a[3]=w;a[4]=dp_ws(input,tokens*cols);a[5]=out;
    // Up to 32 rows are one row tile of either width.
    kernel:=DpKernel.tile_wide;if rows<=32 {kernel=DpKernel.tile_narrow;}
    op:=dp_launch(kernel,dt_items(rows,tokens,16,64),a,6);op.lanes=DT_THREADS;
    return dp_push(b,op);
}
// book:end apple
dp_project_to :: (b:DpBuilder,p:DpLayout,weight:DpArg,rows:int,cols:int,tokens:int,input:int,out:DpArg)->DpBuilder {
    if b.metal {return dp_tile(b,weight,rows,cols,tokens,input,out);}
    if tokens>=DP_MMA_TOKENS {return dp_mma(b,p,weight,rows,cols,tokens,input,out);}
    a:[12]DpArg;w:=weight;w.count=rows*cols/4;s:=dp_slices(rows,cols,p.partial_rows);
    a[0]=dp_int(rows);a[1]=dp_int(cols);a[2]=dp_int(tokens);a[3]=dp_int(s);a[4]=w;a[5]=dp_ws(input,tokens*cols);a[6]=dp_ws(p.partial,s*tokens*rows);
    r:=dp_push(b,dp_launch(DpKernel.project,dv_project_items(rows,tokens,s),a,7));
    e:[12]DpArg;e[0]=dp_int(tokens*rows);e[1]=dp_int(s);e[2]=dp_ws(p.partial,s*tokens*rows);e[3]=out;
    return dp_push(r,dp_launch(DpKernel.reduce,tokens*rows,e,4));
}
// book:begin take
// A streamed matrix is read from slot at%2: wait for its copy, use it, then
// release the slot and start the copy of the streamed matrix after next.
dp_take :: (b:DpBuilder)->DpBuilder {return dp_push(b,DpOp.{kind=DpOpKind.wait,slot=b.at%2});}
dp_give :: (b:DpBuilder)->DpBuilder {
    slot:=b.at%2;
    r:=dp_push(b,DpOp.{kind=DpOpKind.release,slot=slot});
    if r.at+2<r.count {r=dp_push(r,dp_copy(r.m,r.order[r.at+2],slot));}
    r.at+=1;return r;
}
// A matrix projection whose weight may stream.
dp_project_weight :: (b:DpBuilder,p:DpLayout,w:int,rows:int,cols:int,tokens:int,input:int,output:int)->DpBuilder {
    return dp_project_weight_to(b,p,w,rows,cols,tokens,input,dp_ws(output,tokens*rows));
}
dp_project_weight_to :: (b:DpBuilder,p:DpLayout,w:int,rows:int,cols:int,tokens:int,input:int,out:DpArg)->DpBuilder {
    if !dp_streamed_of(b.m,w,b.stream) {return dp_project_to(b,p,dp_matrix(w),rows,cols,tokens,input,out);}
    r:=dp_take(b);
    r=dp_project_to(r,p,DpArg.{kind=4,buffer=1+b.at%2},rows,cols,tokens,input,out);
    return dp_give(r);
}
// book:end take
// The offset norm of `rows` rows of x: partial squares, then the scaled rows.
dp_norm_rows :: (b:DpBuilder,p:DpLayout,rows:int,input:int,scale:DpArg,output:int)->DpBuilder {
    d:=b.m.width;
    a:[12]DpArg;a[0]=dp_int(d);a[1]=dp_ws(input,rows*d);a[2]=DpArg.{kind=4,buffer=0,offset=p.squares,count=16*rows};
    r:=dp_push(b,dp_launch(DpKernel.squares,16*rows,a,3));
    return dp_scale(r,p,rows,input,scale,output);
}
dp_scale :: (b:DpBuilder,p:DpLayout,rows:int,input:int,scale:DpArg,output:int)->DpBuilder {
    d:=b.m.width;
    c:[12]DpArg;c[0]=dp_int(d);c[1]=dp_f32(0.000001);c[2]=dp_ws(input,rows*d);c[3]=scale;c[4]=DpArg.{kind=4,buffer=0,offset=p.squares,count=16*rows};c[5]=dp_ws(output,rows*d);
    return dp_push(b,dp_launch(DpKernel.scale,rows*d,c,6));
}
// Residual, post-attention norm and the SwiGLU feed-forward; writes output.
dp_finish :: (b:DpBuilder,p:DpLayout,layer:int,tokens:int,input:int,output:int)->DpBuilder {
    t:=tokens;d:=b.m.width;f:=b.m.hidden;full:=dp_full(layer);
    post:=dp_weight(layer,1);gate:=dp_weight(layer,11);up:=dp_weight(layer,12);
    if full {gate=dp_weight(layer,8);up=dp_weight(layer,9);}
    a:[12]DpArg;a[0]=dp_int(d);a[1]=dp_ws(input,t*d);a[2]=dp_ws(p.out,t*d);a[3]=dp_ws(p.residual,t*d);a[4]=DpArg.{kind=4,buffer=0,offset=p.squares,count=16*t};
    r:=dp_push(b,dp_launch(DpKernel.add_squares,16*t,a,5));
    r=dp_scale(r,p,t,p.residual,dp_w(post,d),p.norm);
    r=dp_project_weight(r,p,gate,f,d,t,p.norm,p.gate);
    r=dp_project_weight(r,p,up,f,d,t,p.norm,p.up);
    s:[12]DpArg;s[0]=dp_ws(p.gate,t*f);s[1]=dp_ws(p.up,t*f);s[2]=dp_ws(p.product,t*f);
    r=dp_push(r,dp_launch(DpKernel.swiglu,t*f,s,3));
    r=dp_project_weight(r,p,dp_down(layer),d,f,t,p.product,p.down);
    e:[12]DpArg;e[0]=dp_ws(p.residual,t*d);e[1]=dp_ws(p.down,t*d);e[2]=dp_ws(output,t*d);
    return dp_push(r,dp_launch(DpKernel.add,t*d,e,3));
}
dp_linear :: (b:DpBuilder,p:DpLayout,layer:int,tokens:int,input:int,output:int)->DpBuilder {
    m:=b.m;t:=tokens;d:=m.width;w:=layer*DP_PER_LAYER;c:=dp_channels(m);v:=dp_values(m);h:=m.value_heads;kh:=m.key_heads;
    r:=dp_norm_rows(b,p,t,input,dp_w(w,d),p.norm);
    r=dp_project_weight(r,p,w+6,c,d,t,p.norm,p.qkv);
    r=dp_project_weight(r,p,w+7,v,d,t,p.norm,p.z);
    r=dp_project_weight(r,p,w+8,h,d,t,p.norm,p.a);
    r=dp_project_weight(r,p,w+9,h,d,t,p.norm,p.b);
    cv:[12]DpArg;cv[0]=dp_int(c);cv[1]=dp_int(t);cv[2]=dp_ws(p.qkv,t*c);cv[3]=dp_w(w+2,4*c);cv[4]=dp_ws(p.conv,t*c);
    if b.fork.on {
        cv[5]=dp_fork_arg(m,dp_fork_history_of(m,layer),3*c);cv[6]=dp_int(dp_fork_mode(b.fork));
        r=dp_push(r,dp_launch(DpKernel.conv_state,c,cv,7));
    } else {r=dp_push(r,dp_launch(DpKernel.conv,c,cv,5));}
    g:[12]DpArg;g[0]=dp_int(h);g[1]=dp_ws(p.a,t*h);g[2]=dp_ws(p.b,t*h);g[3]=dp_w(w+3,h);g[4]=dp_w(w+4,h);g[5]=dp_ws(p.beta,t*h);g[6]=dp_ws(p.decay,t*h);
    r=dp_push(r,dp_launch(DpKernel.gates,t*h,g,7));
    q:[12]DpArg;q[0]=dp_int(kh);q[1]=dp_int(128);q[2]=dp_int(c);q[3]=dp_ws(p.conv,t*c);q[4]=dp_ws(p.qn,t*128*kh);q[5]=dp_ws(p.kn,t*128*kh);
    r=dp_push(r,dp_launch(DpKernel.qk,t*kh,q,6));
    s:[12]DpArg;s[0]=dp_int(t);s[1]=dp_int(h);s[2]=dp_int(kh);s[3]=dp_int(c);s[4]=dp_ws(p.conv,t*c);s[5]=dp_ws(p.qn,t*128*kh);s[6]=dp_ws(p.kn,t*128*kh);
    s[7]=dp_ws(p.beta,t*h);s[8]=dp_ws(p.decay,t*h);s[9]=dp_ws(p.draft,t*v);
    if b.fork.on {
        s[10]=dp_fork_arg(m,dp_fork_state_of(m,layer),h*128*128);s[11]=dp_int(dp_fork_mode(b.fork));
        r=dp_push(r,dp_launch(DpKernel.scan_state,v,s,12));
    } else {r=dp_push(r,dp_launch(DpKernel.scan,v,s,10));}
    n:[12]DpArg;n[0]=dp_f32(0.000001);n[1]=dp_ws(p.draft,t*v);n[2]=dp_w(w+5,128);n[3]=dp_ws(p.z,t*v);n[4]=dp_ws(p.mix,t*v);
    r=dp_push(r,dp_launch(DpKernel.gate_norm,t*h,n,5));
    r=dp_project_weight(r,p,w+10,d,v,t,p.mix,p.out);
    return dp_finish(r,p,layer,t,input,output);
}
dp_attention :: (b:DpBuilder,p:DpLayout,layer:int,tokens:int,prefix:int,input:int,output:int)->DpBuilder {
    m:=b.m;t:=tokens;d:=m.width;w:=layer*DP_PER_LAYER;nh:=m.heads;kv:=dp_kv(m);qr:=dp_queries(m);at:=dp_attended(m);
    // Keys and values: this decision's own, or (forked) the fork buffer's
    // rows from token 0, this block's written from `start`. A forked block
    // sees every key (its prefix is 0): the prefix pass is one block and a
    // suffix sees all.
    keys:=t;mask:=prefix;kall:=dp_ws(p.ak,t*kv);vall:=dp_ws(p.v,t*kv);knew:=kall;vnew:=vall;
    if b.fork.on {
        start:=b.fork.start;kb:=dp_fork_keys_of(m,layer);vb:=kb+dp_fork_cache_bytes(m);keys=start+t;
        kall=dp_fork_arg(m,kb,keys*kv);vall=dp_fork_arg(m,vb,keys*kv);knew=dp_fork_arg(m,kb+4*start*kv,t*kv);vnew=dp_fork_arg(m,vb+4*start*kv,t*kv);
    }
    r:=dp_norm_rows(b,p,t,input,dp_w(w,d),p.norm);
    r=dp_project_weight(r,p,w+4,qr,d,t,p.norm,p.qkv);
    r=dp_project_weight(r,p,w+5,kv,d,t,p.norm,p.k);
    r=dp_project_weight_to(r,p,w+6,kv,d,t,p.norm,vnew);
    a:[12]DpArg;a[0]=dp_int(nh);a[1]=dp_int(m.kv_heads);a[2]=dp_ws(p.qkv,t*qr);a[3]=dp_ws(p.k,t*kv);a[4]=dp_w(w+2,256);a[5]=dp_w(w+3,256);
    a[6]=dp_ws(p.rope,t*64);a[7]=dp_ws(p.aq,t*at);a[8]=knew;a[9]=dp_f32(0.000001);
    r=dp_push(r,dp_launch(DpKernel.prepare,t*(nh+m.kv_heads),a,10));
    s:[12]DpArg;s[0]=dp_int(keys);s[1]=dp_int(mask);s[2]=dp_int(nh);s[3]=dp_int(m.kv_heads);s[4]=dp_ws(p.aq,t*at);s[5]=kall;s[6]=dp_ws(p.scores,t*nh*keys);
    r=dp_push(r,dp_launch(DpKernel.scores,t*nh*keys,s,7));
    probs:=DpArg.{kind=4,buffer=0,offset=p.probs,count=t*nh*keys};
    sm:[12]DpArg;sm[0]=dp_int(keys);sm[1]=dp_int(mask);sm[2]=dp_int(nh);sm[3]=dp_ws(p.scores,t*nh*keys);sm[4]=DpArg.{kind=4,buffer=0,offset=p.stats,count=t*nh*3};sm[5]=probs;
    r=dp_push(r,dp_launch(DpKernel.softmax,t*nh,sm,6));
    o:[12]DpArg;o[0]=dp_int(keys);o[1]=dp_int(nh);o[2]=dp_int(m.kv_heads);o[3]=probs;o[4]=vall;o[5]=dp_ws(p.qkv,t*qr);o[6]=dp_ws(p.mix,t*at);
    r=dp_push(r,dp_launch(DpKernel.attend,t*at,o,7));
    r=dp_project_weight(r,p,w+7,d,at,t,p.mix,p.out);
    return dp_finish(r,p,layer,t,input,output);
}

// The most tokens one decision may hold (chapter 20 serves up to this).
DP_MAX_TOKENS :: 512;
// book:begin plan
// The whole decision: tokens 0..prefix form the first block. Inputs are the
// gathered embedding rows at x0 and rotary coefficients at rope; the result
// is the last token's vocabulary logits at logits. kind names the model.
dp_plan :: (tokens:int,prefix:int,budget:int,stream:[]bool,ops:[]DpOp)->DpPlan #export_c {
    return dp_plan_model(0,false,tokens,prefix,budget,stream,ops);
}
// The same decision for an Apple GPU: projections on the matrix units.
dp_plan_metal :: (tokens:int,prefix:int,budget:int,stream:[]bool,ops:[]DpOp)->DpPlan #export_c {
    return dp_plan_model(0,true,tokens,prefix,budget,stream,ops);
}
dp_plan_on :: (metal:bool,tokens:int,prefix:int,budget:int,stream:[]bool,ops:[]DpOp)->DpPlan {
    return dp_plan_model(0,metal,tokens,prefix,budget,stream,ops);
}
dp_plan_model :: (kind:int,metal:bool,tokens:int,prefix:int,budget:int,stream:[]bool,ops:[]DpOp)->DpPlan #export_c {
    if kind<0 || kind>1 || tokens<1 || tokens>DP_MAX_TOKENS || prefix<0 || prefix>=tokens {return DpPlan.{status=DpStatus.shape};}
    m:=dp_model(kind);
    plan:=dp_residency_of(m,budget,dp_layout_of(m,tokens,tokens).total,stream);
    if plan.status!=DpStatus.ok {return plan;}
    plan.metal=metal;
    return dp_schedule(tokens,prefix,plan,stream,ops);
}
// book:end plan
// A later decision on weights already placed by an opened plan: the same
// model, streamed set, backend and the opened workspace, which must hold this layout.
dp_replan :: (tokens:int,prefix:int,opened:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan #export_c {
    m:=dp_model(opened.kind);
    if opened.status!=DpStatus.ok || stream.count!=dp_streamable(m) {return DpPlan.{status=DpStatus.capacity};}
    if tokens<1 || tokens>DP_MAX_TOKENS || prefix<0 || prefix>=tokens {return DpPlan.{status=DpStatus.shape};}
    if dp_layout_of(m,tokens,tokens).total>opened.workspace {return DpPlan.{status=DpStatus.capacity};}
    n:=0;for i:0..<stream.count {if stream[i] {n+=1;}}
    if n!=opened.streamed_tensors {return DpPlan.{status=DpStatus.capacity};}
    return dp_schedule(tokens,prefix,opened,stream,ops);
}
// book:begin forkplan
// A forked decision on an opened placement: the prefix pass over tokens
// 0..prefix (one block, no readout), then one suffix pass per question over
// tokens start..start+tokens, whose logits are the last token's.
dp_plan_prefix :: (prefix:int,opened:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan #export_c {
    return dp_plan_fork(DpFork.{on=true,save=true},prefix,opened,stream,ops);
}
dp_plan_suffix :: (start:int,tokens:int,opened:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan #export_c {
    if start<1 {return DpPlan.{status=DpStatus.shape};}
    return dp_plan_fork(DpFork.{on=true,start=start},tokens,opened,stream,ops);
}
dp_plan_fork :: (fork:DpFork,tokens:int,opened:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan {
    m:=dp_model(opened.kind);
    if opened.status!=DpStatus.ok || stream.count!=dp_streamable(m) {return DpPlan.{status=DpStatus.capacity};}
    if tokens<1 || fork.start<0 || fork.start+tokens>DP_MAX_TOKENS {return DpPlan.{status=DpStatus.shape};}
    if dp_layout_of(m,tokens,fork.start+tokens).total>opened.workspace {return DpPlan.{status=DpStatus.capacity};}
    n:=0;for i:0..<stream.count {if stream[i] {n+=1;}}
    if n!=opened.streamed_tensors {return DpPlan.{status=DpStatus.capacity};}
    return dp_schedule_fork(tokens,0,fork,opened,stream,ops);
}
// book:end forkplan
// Where a decision may stop: before the first norm launch of each layer and
// of the readout. A stopped decision has published nothing.
dp_stop_point :: (op:DpOp)->bool #export_c {return op.kind==DpOpKind.launch && op.kernel==cast(u8)DpKernel.squares;}
dp_schedule :: (tokens:int,prefix:int,placed:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan {
    return dp_schedule_fork(tokens,prefix,DpFork.{},placed,stream,ops);
}
dp_schedule_fork :: (tokens:int,prefix:int,fork:DpFork,placed:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan {
    m:=dp_model(placed.kind);
    p:=dp_layout_of(m,tokens,fork.start+tokens);plan:=placed;readout:=!fork.save;
    order:[DP_MAX_STREAMABLE]int;
    b:=DpBuilder.{ops=ops,ok=true,stream=stream,order=order[..],metal=placed.metal,fork=fork,m=m};
    // Streaming indices in schedule order: each layer's mixer matrices, then
    // its gate, up and down; then the head chunks.
    for layer:0..<m.layers {
        for k:0..<5 {x:=dp_mixer_base(m)+5*layer+k;if stream[x] {order[b.count]=x;b.count+=1;}}
        for k:0..<3 {x:=3*layer+k;if stream[x] {order[b.count]=x;b.count+=1;}}
    }
    // The prefix pass of a fork has no readout, so it streams no head chunk.
    if readout {for c:0..<dp_head_chunks(m) {x:=dp_head_base(m)+c;if stream[x] {order[b.count]=x;b.count+=1;}}}
    // Prefetch the first two.
    for i:0..<2 {if i<b.count {b=dp_push(b,dp_copy(m,order[i],i));}}
    input:=p.x0;output:=p.x1;
    for layer:0..<m.layers {
        if dp_full(layer) {b=dp_attention(b,p,layer,tokens,prefix,input,output);}
        else {b=dp_linear(b,p,layer,tokens,input,output);}
        swap:=input;input=output;output=swap;
    }
    if readout {
        b=dp_norm_last(b,p,tokens,input);
        if dp_streamed_of(m,dp_head(m),stream) {
            for c:0..<dp_head_chunks(m) {
                slot:=b.at%2;b=dp_take(b);
                b=dp_readout(b,p,DpArg.{kind=4,buffer=1+slot},c*m.hidden,dp_chunk_rows(m,c),true);
            }
        } else {b=dp_readout(b,p,dp_matrix(dp_head(m)),0,m.vocab,false);}
    }
    if !b.ok {return DpPlan.{status=DpStatus.capacity};}
    plan.rope=p.rope;plan.logits=p.logits;
    plan.ops=b.n;return plan;
}
// book:begin readout
// The head's rows first..first+rows: one-token products into 16 lane
// partials, then their sums into those logits. A streamed chunk's slot is
// released between the two.
dp_readout :: (b:DpBuilder,p:DpLayout,weight:DpArg,first:int,rows:int,streamed:bool)->DpBuilder {
    d:=b.m.width;a:[12]DpArg;w:=weight;w.count=rows*d/4;
    a[0]=dp_int(rows);a[1]=dp_int(d);a[2]=w;a[3]=dp_ws(p.final,d);a[4]=dp_ws(p.lanes,16*rows);
    r:=dp_push(b,dp_launch(DpKernel.matvec,16*rows,a,5));
    if streamed {r=dp_give(r);}
    e:[12]DpArg;e[0]=dp_int(rows);e[1]=dp_int(16);e[2]=dp_ws(p.lanes,16*rows);e[3]=dp_ws(p.logits+4*first,rows);
    return dp_push(r,dp_launch(DpKernel.reduce,rows,e,4));
}
// book:end readout
dp_down :: (layer:int)->int {if dp_full(layer) {return dp_weight(layer,10);}return dp_weight(layer,13);}
dp_norm_last :: (b:DpBuilder,p:DpLayout,tokens:int,input:int)->DpBuilder {
    d:=b.m.width;
    return dp_norm_rows(b,p,1,input+4*(tokens-1)*d,dp_w(dp_final(b.m),d),p.final);
}
// book:begin batch
// Many questions at once (chapter 36): the suffixes of up to DP_BATCH
// questions that share one kept prefix run as one pass over the weights.
// Their tokens sit one question after another in the workspace. Every
// token-wise launch (norms, projections, gates, feed-forward) takes all of
// them at once; the launches that carry state along a sequence (the
// convolution, the delta rule, attention) and the readout run once per
// question on that question's rows, starting from the same kept prefix.
// Each question's arithmetic is then its own suffix pass's, provided every
// projection takes the same path: all questions have at least DP_MMA_TOKENS
// tokens (tensor cores), or all of them together have fewer (work items).
// Other batches, and Metal's tiles, are refused; the host runs those
// questions one suffix at a time.
DP_BATCH :: 8;
dp_batch_tokens :: (lengths:[]int)->int #export_c {n:=0;for t:lengths {n+=t;}return n;}
dp_batch_longest :: (lengths:[]int)->int {n:=0;for t:lengths {n=dp_wider(n,t);}return n;}
dp_batch_admits :: (metal:bool,start:int,lengths:[]int)->bool #export_c {
    if metal || start<1 || lengths.count<1 || lengths.count>DP_BATCH {return false;}
    total:=0;short:=false;
    for t:lengths {
        if t<1 || start+t>DP_MAX_TOKENS {return false;}
        if t<DP_MMA_TOKENS {short=true;}
        total+=t;
    }
    if total>DP_MAX_TOKENS {return false;}
    return !short || total<DP_MMA_TOKENS;
}
// book:end batch
// The workspace of a batch: one decision's layout for all its tokens, whose
// attention regions hold the longest question's keys, then the final norm
// rows and logits of questions 1.. (question 0 uses the layout's own).
DpBatch :: struct {p:DpLayout;finals:int;logits:int;total:int;}
dp_batch_layout :: (m:DpModel,start:int,lengths:[]int)->DpBatch {
    r:DpBatch;r.p=dp_layout_of(m,dp_batch_tokens(lengths),start+dp_batch_longest(lengths));
    more:=lengths.count-1;
    r.finals=r.p.total;r.logits=r.finals+more*dp_align(4*m.width);r.total=r.logits+more*dp_align(4*m.vocab);
    return r;
}
dp_batch_final :: (r:DpBatch,m:DpModel,i:int)->int {if i==0 {return r.p.final;}return r.finals+(i-1)*dp_align(4*m.width);}
dp_batch_logit :: (r:DpBatch,m:DpModel,i:int)->int {if i==0 {return r.p.logits;}return r.logits+(i-1)*dp_align(4*m.vocab);}
// Where the host reads question i's logits, and the workspace a batch needs.
dp_batch_logits :: (kind:int,start:int,lengths:[]int,i:int)->int #export_c {return dp_batch_logit(dp_batch_layout(dp_model(kind),start,lengths),dp_model(kind),i);}
dp_batch_workspace :: (kind:int,start:int,lengths:[]int)->int #export_c {return dp_batch_layout(dp_model(kind),start,lengths).total;}
// The first token of question i in the batch.
dp_batch_first :: (lengths:[]int,i:int)->int {n:=0;for j:0..<i {n+=lengths[j];}return n;}
dp_plan_batch :: (start:int,lengths:[]int,opened:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan #export_c {
    m:=dp_model(opened.kind);
    if opened.status!=DpStatus.ok || stream.count!=dp_streamable(m) {return DpPlan.{status=DpStatus.capacity};}
    if !dp_batch_admits(opened.metal,start,lengths) {return DpPlan.{status=DpStatus.shape};}
    if dp_batch_layout(m,start,lengths).total>opened.workspace {return DpPlan.{status=DpStatus.capacity};}
    n:=0;for i:0..<stream.count {if stream[i] {n+=1;}}
    if n!=opened.streamed_tensors {return DpPlan.{status=DpStatus.capacity};}
    return dp_schedule_batch(start,lengths,opened,stream,ops);
}
dp_schedule_batch :: (start:int,lengths:[]int,placed:DpPlan,stream:[]bool,ops:[]DpOp)->DpPlan {
    m:=dp_model(placed.kind);
    r:=dp_batch_layout(m,start,lengths);p:=r.p;plan:=placed;tokens:=dp_batch_tokens(lengths);
    order:[DP_MAX_STREAMABLE]int;
    b:=DpBuilder.{ops=ops,ok=true,stream=stream,order=order[..],metal=placed.metal,fork=DpFork.{on=true,start=start},m=m};
    for layer:0..<m.layers {
        for k:0..<5 {x:=dp_mixer_base(m)+5*layer+k;if stream[x] {order[b.count]=x;b.count+=1;}}
        for k:0..<3 {x:=3*layer+k;if stream[x] {order[b.count]=x;b.count+=1;}}
    }
    for c:0..<dp_head_chunks(m) {x:=dp_head_base(m)+c;if stream[x] {order[b.count]=x;b.count+=1;}}
    for i:0..<2 {if i<b.count {b=dp_push(b,dp_copy(m,order[i],i));}}
    input:=p.x0;output:=p.x1;
    for layer:0..<m.layers {
        if dp_full(layer) {b=dp_attention_batch(b,p,layer,lengths,input,output);}
        else {b=dp_linear_batch(b,p,layer,lengths,input,output);}
        swap:=input;input=output;output=swap;
    }
    d:=m.width;
    for i:0..<lengths.count {
        last:=dp_batch_first(lengths,i)+lengths[i]-1;
        b=dp_norm_rows(b,p,1,input+4*last*d,dp_w(dp_final(m),d),dp_batch_final(r,m,i));
    }
    if dp_streamed_of(m,dp_head(m),stream) {
        for c:0..<dp_head_chunks(m) {
            slot:=b.at%2;b=dp_take(b);
            b=dp_readout_batch(b,r,lengths.count,DpArg.{kind=4,buffer=1+slot},c*m.hidden,dp_chunk_rows(m,c),true);
        }
    } else {b=dp_readout_batch(b,r,lengths.count,dp_matrix(dp_head(m)),0,m.vocab,false);}
    if !b.ok {return DpPlan.{status=DpStatus.capacity};}
    plan.rope=p.rope;plan.logits=p.logits;plan.ops=b.n;return plan;
}
// The head's rows first..first+rows for each question in turn; a streamed
// chunk's slot is released after the last question's products.
dp_readout_batch :: (b:DpBuilder,r:DpBatch,questions:int,weight:DpArg,first:int,rows:int,streamed:bool)->DpBuilder {
    m:=b.m;d:=m.width;p:=r.p;x:=b;
    for i:0..<questions {
        a:[12]DpArg;w:=weight;w.count=rows*d/4;
        a[0]=dp_int(rows);a[1]=dp_int(d);a[2]=w;a[3]=dp_ws(dp_batch_final(r,m,i),d);a[4]=dp_ws(p.lanes,16*rows);
        x=dp_push(x,dp_launch(DpKernel.matvec,16*rows,a,5));
        if streamed && i==questions-1 {x=dp_give(x);}
        e:[12]DpArg;e[0]=dp_int(rows);e[1]=dp_int(16);e[2]=dp_ws(p.lanes,16*rows);e[3]=dp_ws(dp_batch_logit(r,m,i)+4*first,rows);
        x=dp_push(x,dp_launch(DpKernel.reduce,rows,e,4));
    }
    return x;
}
dp_linear_batch :: (b:DpBuilder,p:DpLayout,layer:int,lengths:[]int,input:int,output:int)->DpBuilder {
    m:=b.m;t:=dp_batch_tokens(lengths);d:=m.width;w:=layer*DP_PER_LAYER;c:=dp_channels(m);v:=dp_values(m);h:=m.value_heads;kh:=m.key_heads;
    mode:=dp_fork_mode(b.fork);
    r:=dp_norm_rows(b,p,t,input,dp_w(w,d),p.norm);
    r=dp_project_weight(r,p,w+6,c,d,t,p.norm,p.qkv);
    r=dp_project_weight(r,p,w+7,v,d,t,p.norm,p.z);
    r=dp_project_weight(r,p,w+8,h,d,t,p.norm,p.a);
    r=dp_project_weight(r,p,w+9,h,d,t,p.norm,p.b);
    for i:0..<lengths.count {
        o:=dp_batch_first(lengths,i);n:=lengths[i];
        cv:[12]DpArg;cv[0]=dp_int(c);cv[1]=dp_int(n);cv[2]=dp_ws(p.qkv+4*o*c,n*c);cv[3]=dp_w(w+2,4*c);cv[4]=dp_ws(p.conv+4*o*c,n*c);
        cv[5]=dp_fork_arg(m,dp_fork_history_of(m,layer),3*c);cv[6]=dp_int(mode);
        r=dp_push(r,dp_launch(DpKernel.conv_state,c,cv,7));
    }
    g:[12]DpArg;g[0]=dp_int(h);g[1]=dp_ws(p.a,t*h);g[2]=dp_ws(p.b,t*h);g[3]=dp_w(w+3,h);g[4]=dp_w(w+4,h);g[5]=dp_ws(p.beta,t*h);g[6]=dp_ws(p.decay,t*h);
    r=dp_push(r,dp_launch(DpKernel.gates,t*h,g,7));
    q:[12]DpArg;q[0]=dp_int(kh);q[1]=dp_int(128);q[2]=dp_int(c);q[3]=dp_ws(p.conv,t*c);q[4]=dp_ws(p.qn,t*128*kh);q[5]=dp_ws(p.kn,t*128*kh);
    r=dp_push(r,dp_launch(DpKernel.qk,t*kh,q,6));
    for i:0..<lengths.count {
        o:=dp_batch_first(lengths,i);n:=lengths[i];
        s:[12]DpArg;s[0]=dp_int(n);s[1]=dp_int(h);s[2]=dp_int(kh);s[3]=dp_int(c);s[4]=dp_ws(p.conv+4*o*c,n*c);s[5]=dp_ws(p.qn+4*o*128*kh,n*128*kh);s[6]=dp_ws(p.kn+4*o*128*kh,n*128*kh);
        s[7]=dp_ws(p.beta+4*o*h,n*h);s[8]=dp_ws(p.decay+4*o*h,n*h);s[9]=dp_ws(p.draft+4*o*v,n*v);
        s[10]=dp_fork_arg(m,dp_fork_state_of(m,layer),h*128*128);s[11]=dp_int(mode);
        r=dp_push(r,dp_launch(DpKernel.scan_state,v,s,12));
    }
    n:[12]DpArg;n[0]=dp_f32(0.000001);n[1]=dp_ws(p.draft,t*v);n[2]=dp_w(w+5,128);n[3]=dp_ws(p.z,t*v);n[4]=dp_ws(p.mix,t*v);
    r=dp_push(r,dp_launch(DpKernel.gate_norm,t*h,n,5));
    r=dp_project_weight(r,p,w+10,d,v,t,p.mix,p.out);
    return dp_finish(r,p,layer,t,input,output);
}
// Each question's keys and values are the prefix's followed by its own, in
// the fork buffer's rows from `start`; the next question overwrites them.
// So each question projects its own values (the slot of a streamed value
// matrix is held from the first question's to the last's) and attends
// before the next one starts.
dp_attention_batch :: (b:DpBuilder,p:DpLayout,layer:int,lengths:[]int,input:int,output:int)->DpBuilder {
    m:=b.m;t:=dp_batch_tokens(lengths);d:=m.width;w:=layer*DP_PER_LAYER;nh:=m.heads;kv:=dp_kv(m);qr:=dp_queries(m);at:=dp_attended(m);
    start:=b.fork.start;kb:=dp_fork_keys_of(m,layer);vb:=kb+dp_fork_cache_bytes(m);
    r:=dp_norm_rows(b,p,t,input,dp_w(w,d),p.norm);
    r=dp_project_weight(r,p,w+4,qr,d,t,p.norm,p.qkv);
    r=dp_project_weight(r,p,w+5,kv,d,t,p.norm,p.k);
    streamed:=dp_streamed_of(m,w+6,r.stream);value:=dp_matrix(w+6);
    for i:0..<lengths.count {
        o:=dp_batch_first(lengths,i);n:=lengths[i];keys:=start+n;
        kall:=dp_fork_arg(m,kb,keys*kv);vall:=dp_fork_arg(m,vb,keys*kv);knew:=dp_fork_arg(m,kb+4*start*kv,n*kv);vnew:=dp_fork_arg(m,vb+4*start*kv,n*kv);
        if streamed && i==0 {value=DpArg.{kind=4,buffer=1+r.at%2};r=dp_take(r);}
        r=dp_project_to(r,p,value,kv,d,n,p.norm+4*o*d,vnew);
        if streamed && i==lengths.count-1 {r=dp_give(r);}
        a:[12]DpArg;a[0]=dp_int(nh);a[1]=dp_int(m.kv_heads);a[2]=dp_ws(p.qkv+4*o*qr,n*qr);a[3]=dp_ws(p.k+4*o*kv,n*kv);a[4]=dp_w(w+2,256);a[5]=dp_w(w+3,256);
        a[6]=dp_ws(p.rope+4*o*64,n*64);a[7]=dp_ws(p.aq+4*o*at,n*at);a[8]=knew;a[9]=dp_f32(0.000001);
        r=dp_push(r,dp_launch(DpKernel.prepare,n*(nh+m.kv_heads),a,10));
        s:[12]DpArg;s[0]=dp_int(keys);s[1]=dp_int(0);s[2]=dp_int(nh);s[3]=dp_int(m.kv_heads);s[4]=dp_ws(p.aq+4*o*at,n*at);s[5]=kall;s[6]=dp_ws(p.scores,n*nh*keys);
        r=dp_push(r,dp_launch(DpKernel.scores,n*nh*keys,s,7));
        probs:=dp_ws(p.probs,n*nh*keys);
        sm:[12]DpArg;sm[0]=dp_int(keys);sm[1]=dp_int(0);sm[2]=dp_int(nh);sm[3]=dp_ws(p.scores,n*nh*keys);sm[4]=dp_ws(p.stats,n*nh*3);sm[5]=probs;
        r=dp_push(r,dp_launch(DpKernel.softmax,n*nh,sm,6));
        x:[12]DpArg;x[0]=dp_int(keys);x[1]=dp_int(nh);x[2]=dp_int(m.kv_heads);x[3]=probs;x[4]=vall;x[5]=dp_ws(p.qkv+4*o*qr,n*qr);x[6]=dp_ws(p.mix+4*o*at,n*at);
        r=dp_push(r,dp_launch(DpKernel.attend,n*at,x,7));
    }
    r=dp_project_weight(r,p,w+7,d,at,t,p.mix,p.out);
    return dp_finish(r,p,layer,t,input,output);
}
// Workspace byte offsets the host fills or reads.
dp_input_offset :: (tokens:int)->int #export_c {return dp_layout(tokens).x0;}
dp_rope_offset :: (tokens:int)->int #export_c {return dp_layout(tokens).rope;}
dp_logits_offset :: (tokens:int)->int #export_c {return dp_layout(tokens).logits;}
dp_workspace_bytes :: (tokens:int)->int #export_c {return dp_layout(tokens).total;}
dp_model_workspace_bytes :: (kind:int,tokens:int)->int #export_c {return dp_layout_of(dp_model(kind),tokens,tokens).total;}

// book:begin embed
// The host's input: the BF16 embedding rows of the request's tokens as f32.
// The table holds vocab rows of width values; a non-finite value refuses.
dp_embed :: (tokens:[]int,width:int,embedding:[]u8,out:[]f32)->bool #export_c {
    if width<1 || embedding.count%(2*width)!=0 || out.count!=tokens.count*width {return false;}
    vocab:=embedding.count/(2*width);
    for t:0..<tokens.count {
        id:=tokens[t];if id<0 || id>=vocab {return false;}
        for i:0..<width {
            p:=2*(id*width+i);half:=u32(embedding[p]) | (u32(embedding[p+1])<<8);
            if half&0x7f80==0x7f80 {return false;}
            out[t*width+i]=f32_from_bits(half<<16);
        }
    }
    return true;
}
// book:end embed

#test "kernel names follow the host's lookup order" {
    #assert dp_kernel_name(0)=="dv_project" && dp_kernel_name(1)=="dv_matvec" && dp_kernel_name(2)=="dv_reduce";
    #assert dp_kernel_name(3)=="dl_squares" && dp_kernel_name(5)=="dl_scale" && dp_kernel_name(11)=="dl_scan" && dp_kernel_name(16)=="dl_attend";
    #assert dp_kernel_name(-1)=="" && dp_kernel_name(23)=="" && dp_kernel_name(17)=="dw_split" && dp_kernel_name(18)=="dw_project";
    #assert dp_kernel_name(19)=="dl_conv_state" && dp_kernel_name(20)=="dl_scan_state" && dp_kernel_name(21)=="dt_project_16x32" && dp_kernel_name(22)=="dt_project_16x64";
    #assert cast(int)DpKernel.attend==16 && cast(int)DpKernel.mma_project==18 && cast(int)DpKernel.scan_state==20 && cast(int)DpKernel.tile_wide==22 && DP_KERNELS==23;
}
#forall "every fourth layer is full attention" layer:0..<32 {
    #assert dp_full(layer)==(layer==3 || layer==7 || layer==11 || layer==15 || layer==19 || layer==23 || layer==27 || layer==31);
}
#test "weight sizes match Elephant's tensors" {
    #assert dp_weight_elements(dp_weight(0,0))==4096 && dp_weight_elements(dp_weight(0,2))==32768 && dp_weight_elements(dp_weight(0,3))==32;
    #assert dp_weight_elements(dp_weight(0,5))==128 && dp_weight_elements(dp_weight(0,6))==8192*4096 && dp_weight_elements(dp_weight(0,9))==32*4096;
    #assert dp_weight_elements(dp_weight(0,13))==4096*12288 && dp_weight_elements(dp_weight(0,14))==0 && dp_weight_elements(dp_weight(0,15))==0;
    #assert dp_weight_elements(dp_weight(3,2))==256 && dp_weight_elements(dp_weight(3,4))==8192*4096 && dp_weight_elements(dp_weight(3,5))==1024*4096;
    #assert dp_weight_elements(dp_weight(3,10))==4096*12288 && dp_weight_elements(dp_weight(3,11))==0;
    #assert dp_weight_elements(DP_HEAD)==248320*4096 && dp_weight_elements(DP_FINAL)==4096 && dp_weight_elements(DP_WEIGHTS)==-1 && dp_weight_elements(-1)==-1;
    #assert dp_weight_bytes(-1)==-4 && dp_weight_bytes(DP_WEIGHTS)==-4;
    total:=0;matrices:=0;
    for w:0..<DP_WEIGHTS {total+=dp_weight_bytes(w);if dp_weight_bf16(w) {matrices+=1;}}
    #assert total==15875491840 && matrices==24*8+8*7+1;
    #assert dp_weight_bytes(dp_weight(0,0))==16384 && dp_weight_bytes(dp_weight(0,6))==2*8192*4096 && dp_weight_bytes(DP_HEAD)==2*248320*4096;
}
#forall "BF16 matrices are the projections and the head" layer:0..<32, j:0..<16 {
    w:=dp_weight(layer,j);
    expected:=ifx dp_full(layer) then j>=4 && j<=10 else j>=6 && j<=13;
    #assert dp_weight_bf16(w)==expected;
}
#test "BF16 bounds" {
    #assert dp_weight_bf16(DP_HEAD) && !dp_weight_bf16(DP_FINAL) && !dp_weight_bf16(-1) && !dp_weight_bf16(-10) && !dp_weight_bf16(DP_WEIGHTS) && !dp_weight_bf16(520);
}
#test "the workspace is aligned and covers the largest decision" {
    p:=dp_layout(86);
    #assert p.x0==256 && p.x1==256+dp_align(4*86*4096) && p.total%256==0 && p.lanes+dp_align(4*16*248320)==p.total;
    #assert dp_input_offset(86)==256 && dp_rope_offset(86)==p.rope && dp_logits_offset(86)==p.logits && dp_workspace_bytes(86)==p.total;
    #assert p.total==91447808 && p.lo-p.hi==dp_align(4*88*6144);
    #assert dp_align(0)==0 && dp_align(1)==256 && dp_align(256)==256 && dp_align(257)==512;
}
#test "residency streams spread feed-forward matrices first, and only when it must" {
    stream:[277]bool;w:=dp_workspace_bytes(86);all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
    for i:0..<277 {stream[i]=true;}
    fit:=dp_residency(w+all,w,stream[..]);
    #assert fit.status==DpStatus.ok && fit.streamed==0 && fit.resident==all && fit.slot==0 && fit.streamed_tensors==0;
    for i:0..<277 {#assert !stream[i];}
    slot:=dp_align(2*4096*12288);
    one:=dp_residency(w+all-1,w,stream[..]);
    #assert one.status==DpStatus.ok && one.streamed_tensors==3 && one.slot==slot && one.resident==all-3*slot && one.streamed==3*slot;
    // Down projections (k = 2) of layers 0, 16 and 8.
    #assert stream[2] && stream[3*16+2] && stream[3*8+2] && !stream[0] && !stream[1] && !stream[3*24+2] && !stream[95];
    nine:=dp_residency(w+all-7*slot,w,stream[..]);
    #assert nine.streamed_tensors==9;n:=0;for i:0..<277 {if stream[i] {n+=1;}}#assert n==9 && stream[3*2+2] && stream[3*28+2] && !stream[3*18+2];
    downs:=dp_residency(w+all-30*slot,w,stream[..]);
    #assert downs.status==DpStatus.ok && downs.streamed_tensors==32;for l:0..<32 {#assert stream[3*l+2] && !stream[3*l+1];}
    // Past 32 down projections, up projections join, then gates.
    up:=dp_residency(w+all-31*slot,w,stream[..]);
    #assert up.streamed_tensors==33 && stream[1] && !stream[3*16+1] && !stream[0];
    ups:=dp_residency(w+all-34*slot,w,stream[..]);
    #assert ups.streamed_tensors==36 && stream[1] && stream[3*16+1] && stream[3*8+1] && stream[3*24+1] && !stream[3*4+1] && !stream[0];
    gates:=dp_residency(w+all-70*slot,w,stream[..]);
    #assert gates.streamed_tensors==72 && stream[0] && stream[3*16] && stream[3*24] && stream[3*4] && !stream[3*2] && stream[3*2+1];
    every:=dp_residency(w+all-94*slot,w,stream[..]);
    #assert every.status==DpStatus.ok && every.streamed_tensors==96;for i:0..<96 {#assert stream[i];}for i:96..<277 {#assert !stream[i];}
    #assert dp_residency(w+all,w,stream[0..<276]).status==DpStatus.capacity && dp_residency(w+all,w,stream[0..<96]).status==DpStatus.capacity;
}
#test "past the feed-forward matrices the head streams in chunks, then the mixers a layer at a time" {
    stream:[277]bool;w:=dp_workspace_bytes(86);all:=0;matrices:=0;
    for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));if dp_weight_bf16(i) {matrices+=dp_weight_bytes(i);}}
    slot:=dp_align(2*4096*12288);head:=2*248320*4096;
    one:=dp_residency(w+all-94*slot-1,w,stream[..]);
    #assert one.status==DpStatus.ok && one.streamed_tensors==96+21 && one.streamed==96*slot+head && one.resident==all-96*slot-head;
    for c:0..<21 {#assert stream[256+c];}for i:96..<256 {#assert !stream[i];}
    exact:=dp_residency(w+all-94*slot-head,w,stream[..]);#assert exact.streamed_tensors==117 && !stream[96];
    // The first mixer is layer 0's qkv; then the rest of layer 0, then layer 16.
    qkv:=dp_residency(w+all-94*slot-head-1,w,stream[..]);
    #assert qkv.streamed_tensors==118 && qkv.streamed==96*slot+head+2*8192*4096 && stream[96] && !stream[97];
    layer0:=dp_residency(w+all-94*slot-head-2*(8192+4096+32+32+4096)*4096,w,stream[..]);
    #assert layer0.streamed_tensors==122 && stream[100] && !stream[96+5*16];
    next:=dp_residency(w+all-94*slot-head-2*(8192+4096+32+32+4096)*4096-1,w,stream[..]);
    #assert next.streamed_tensors==123 && stream[96+5*16] && !stream[96+5*16+1] && !stream[96+5*8];
    // Everything streams: only the vectors, the workspace and two slots stay.
    vectors:=all-matrices;
    least:=dp_residency(w+vectors+2*slot,w,stream[..]);
    #assert least.status==DpStatus.ok && least.streamed_tensors==96+21+152 && least.resident==vectors && least.streamed==matrices;
    for i:0..<277 {#assert stream[i]==(dp_stream_weight(i)>=0);}
    #assert !stream[96+5*3+4] && !stream[96+5*31+4] && stream[96+5*31+3] && stream[96+5*30+4];
    #assert dp_residency(w+vectors+2*slot-1,w,stream[..]).status==DpStatus.memory;
}
#forall "the spread order is the 5-bit reversal" i:0..<32 {
    r:=dp_spread(i);
    #assert r>=0 && r<32 && dp_spread(r)==i;
    #assert ((r>>4)&1)==(i&1) && ((r>>3)&1)==((i>>1)&1) && ((r>>2)&1)==((i>>2)&1) && ((r>>1)&1)==((i>>3)&1) && (r&1)==((i>>4)&1);
}
#test "every matrix and the head have a streaming index" {
    stream:[277]bool;for i:0..<277 {stream[i]=true;}
    #assert dp_stream_index(dp_weight(0,11))==0 && dp_stream_index(dp_weight(0,12))==1 && dp_stream_index(dp_weight(0,13))==2;
    #assert dp_stream_index(dp_weight(3,8))==9 && dp_stream_index(dp_weight(3,10))==11 && dp_stream_index(dp_weight(31,10))==95;
    #assert dp_stream_index(dp_weight(0,6))==96 && dp_stream_index(dp_weight(0,10))==100 && dp_stream_index(dp_weight(1,6))==101 && dp_stream_index(dp_weight(0,5))==-1;
    #assert dp_stream_index(dp_weight(3,4))==96+15 && dp_stream_index(dp_weight(3,7))==96+18 && dp_stream_index(dp_weight(3,3))==-1 && dp_stream_index(dp_weight(31,7))==96+5*31+3;
    #assert dp_stream_index(dp_weight(0,14))==-1 && dp_stream_index(dp_weight(3,11))==-1 && dp_stream_index(dp_weight(0,0))==-1 && dp_stream_index(dp_weight(31,15))==-1;
    #assert dp_stream_index(DP_HEAD)==256 && dp_stream_index(-1)==-1 && dp_stream_index(DP_FINAL)==-1 && dp_stream_index(-5)==-1 && dp_stream_index(-16)==-1;
    #assert dp_stream_weight(0)==dp_weight(0,11) && dp_stream_weight(11)==dp_weight(3,10) && dp_stream_weight(95)==dp_weight(31,10) && dp_stream_weight(4)==dp_weight(1,12);
    #assert dp_stream_weight(96)==dp_weight(0,6) && dp_stream_weight(100)==dp_weight(0,10) && dp_stream_weight(96+15)==dp_weight(3,4) && dp_stream_weight(96+18)==dp_weight(3,7);
    #assert dp_stream_weight(96+19)==-1 && dp_stream_weight(255)==-1 && dp_stream_weight(254)==dp_weight(31,7) && dp_stream_weight(256)==DP_HEAD && dp_stream_weight(276)==DP_HEAD;
    #assert dp_stream_weight(277)==-1 && dp_stream_weight(-1)==-1;
    for i:0..<256 {x:=dp_stream_weight(i);if x>=0 {#assert dp_stream_index(x)==i && dp_weight_bf16(x);}}
    #assert dp_streamed(dp_weight(0,11),stream[..]) && dp_streamed(DP_HEAD,stream[..]) && dp_streamed(dp_weight(5,6),stream[..]) && !dp_streamed(dp_weight(5,0),stream[..]);
    stream[17]=false;stream[256]=false;#assert !dp_streamed(dp_weight(5,13),stream[..]) && !dp_streamed(DP_HEAD,stream[..]) && !dp_streamed(dp_weight(31,7),stream[0..<254]) && dp_streamed(dp_weight(31,7),stream[0..<255]);
    #assert dp_stream_index(DP_HEAD+6)==-1 && dp_stream_index(DP_HEAD+11)==-1 && dp_stream_index(DP_FINAL+2)==-1 && dp_stream_index(-10)==-1 && dp_stream_index(-4)==-1;
    #assert dp_mixers(0)==5 && dp_mixers(3)==4 && dp_stream_index(dp_weight(3,8))==9 && dp_stream_index(dp_weight(0,11))==0;
    #assert dp_head_rows(0)==12288 && dp_head_rows(19)==12288 && dp_head_rows(20)==248320-20*12288 && DP_HEAD_CHUNKS*DP_HEAD_ROWS>=DP_VOCAB && (DP_HEAD_CHUNKS-1)*DP_HEAD_ROWS<DP_VOCAB;
    c:=dp_copy(dp_model(0),256+20,1);
    #assert c.kind==DpOpKind.copy && c.tensor==DP_HEAD && c.slot==1 && c.count==1 && c.args[0].kind==4 && c.args[0].buffer==3+DP_HEAD && c.args[0].offset==2*20*12288*4096 && c.args[0].count==2*2560*4096;
    f:=dp_copy(dp_model(0),2,0);#assert f.tensor==dp_weight(0,13) && f.args[0].buffer==3+dp_weight(0,13) && f.args[0].offset==0 && f.args[0].count==2*4096*12288 && f.slot==0;
    h:=dp_copy(dp_model(0),256,0);#assert h.args[0].offset==0 && h.args[0].count==2*12288*4096;
}
dp_digest :: (ops:[]DpOp,n:int)->u64 {
    h:u64=14695981039346656037;
    for i:0..<n {
        op:=ops[i];
        fields:=[8]int.[cast(int)op.kind,cast(int)op.kernel,op.items,op.block,op.lanes,op.count,op.tensor,op.slot];
        for f:fields {h=mul_wrap(h^cast,trunc(u64)f,1099511628211);}
        for a:op.args {
            more:=[5]int.[cast(int)a.kind,a.value,a.buffer,a.offset,a.count];
            for f:more {h=mul_wrap(h^cast,trunc(u64)f,1099511628211);}
            h=mul_wrap(h^f64_bits(a.real),1099511628211);
        }
    }
    return h;
}
#test "the decision plan: resident, then streamed through two slots" {
    ops:[2500]DpOp;stream:[277]bool;w:=dp_workspace_bytes(86);all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
    plan:=dp_plan(86,49,w+all,stream[..],ops[..]);
    #assert plan.status==DpStatus.ok && plan.ops==1092 && plan.streamed==0;
    launches:=0;for i:0..<plan.ops {if ops[i].kind==DpOpKind.launch {launches+=1;}#assert ops[i].count<=12 && ops[i].block==128;}
    #assert launches==1092 && ops[0].kernel==cast(u8)DpKernel.squares && ops[1091].kernel==cast(u8)DpKernel.reduce && ops[1090].items==16*248320;
    #assert ops[2].kernel==cast(u8)DpKernel.split && ops[3].kernel==cast(u8)DpKernel.mma_project && ops[3].lanes==32 && ops[3].items==512*8 && ops[2].lanes==0;
    #assert dp_digest(ops[..],plan.ops)==4173709594799487567;
    slot:=dp_align(2*4096*12288);
    streamed:=dp_plan(86,49,w+all-7*slot,stream[..],ops[..]);
    #assert streamed.status==DpStatus.ok && streamed.ops==1092+9*3 && streamed.streamed_tensors==9;
    // Two prefetches, then a wait before and a release after each streamed layer,
    // and each released slot is refilled with the next streamed tensor.
    #assert ops[0].kind==DpOpKind.copy && ops[0].slot==0 && ops[1].kind==DpOpKind.copy && ops[1].slot==1 && ops[1].tensor==dp_weight(2,13);
    waits:=0;copies:=0;releases:=0;
    for i:0..<streamed.ops {
        op:=ops[i];
        if op.kind==DpOpKind.wait {waits+=1;}
        if op.kind==DpOpKind.copy {copies+=1;}
        if op.kind==DpOpKind.release {releases+=1;#assert ops[i-1].kind==DpOpKind.launch;}
    }
    #assert waits==9 && copies==9 && releases==9;
    #assert dp_digest(ops[..],streamed.ops)==4120621289546768460;
    #assert dp_plan(0,0,w+all,stream[..],ops[..]).status==DpStatus.shape && dp_plan(DP_MAX_TOKENS+1,0,w+all,stream[..],ops[..]).status==DpStatus.shape;
    #assert dp_plan(86,86,w+all,stream[..],ops[..]).status==DpStatus.shape && dp_plan(86,-1,w+all,stream[..],ops[..]).status==DpStatus.shape;
    #assert dp_plan(86,49,w+all,stream[..],ops[0..<1091]).status==DpStatus.capacity;
    #assert dp_plan(1,0,w+all,stream[..],ops[..]).status==DpStatus.ok && dp_plan(128,127,w+all,stream[..],ops[..]).status==DpStatus.ok;
    #assert dp_plan(86,49,100,stream[..],ops[..]).status==DpStatus.memory;
    // Short prompts keep the work-item projections; 16 tokens use the tensor cores.
    short:=dp_plan(8,3,w+all,stream[..],ops[..]);
    #assert short.status==DpStatus.ok && short.ops==844 && ops[2].kernel==cast(u8)DpKernel.project && dp_digest(ops[..],short.ops)==4401176032947051311;
    fifteen:=dp_plan(15,0,w+all,stream[..],ops[..]);#assert fifteen.ops==844 && ops[2].kernel==cast(u8)DpKernel.project;
    sixteen:=dp_plan(16,0,w+all,stream[..],ops[..]);#assert sixteen.ops==1092 && ops[2].kernel==cast(u8)DpKernel.split;
    // Everything that can stream does: 96 copies, the first a layer-0 gate.
    all96:=dp_plan(86,49,w+all-94*slot,stream[..],ops[..]);
    #assert all96.status==DpStatus.ok && all96.streamed_tensors==96 && ops[0].tensor==dp_weight(0,11) && ops[1].tensor==dp_weight(0,12);
    copies96:=0;for i:0..<all96.ops {if ops[i].kind==DpOpKind.copy {copies96+=1;}}#assert copies96==96;
}
// Replaces each slot view in a streamed plan with the host bytes the slot
// holds at that point, checking that every copy fills an empty slot, every
// wait follows its copy, every use falls between the wait and the release
// and no slot is left full.
// Writes the launches to out and returns how many, or -1.
dp_resolve :: (ops:[]DpOp,n:int,out:[]DpOp)->int {
    held:=[2]DpArg.[DpArg.{},DpArg.{}];filled:=[2]bool.[false,false];ready:=[2]bool.[false,false];m:=0;
    for i:0..<n {
        op:=ops[i];
        if op.kind==DpOpKind.copy {if filled[op.slot] {return -1;}held[op.slot]=op.args[0];filled[op.slot]=true;}
        if op.kind==DpOpKind.wait {if !filled[op.slot] || ready[op.slot] {return -1;}ready[op.slot]=true;}
        if op.kind==DpOpKind.release {if !ready[op.slot] {return -1;}ready[op.slot]=false;filled[op.slot]=false;}
        if op.kind==DpOpKind.launch {
            r:=op;
            for k:0..<op.count {
                a:=op.args[k];
                if a.kind==4 && a.buffer>=1 && a.buffer<=2 {
                    if !ready[a.buffer-1] {return -1;}
                    h:=held[a.buffer-1];r.args[k].buffer=h.buffer;r.args[k].offset=h.offset;
                }
            }
            out[m]=r;m+=1;
        }
    }
    if filled[0] || filled[1] {return -1;}
    return m;
}
#test "a streamed plan computes what the resident plan computes" {
    ops:[2500]DpOp;stream:[277]bool;resident:[2500]DpOp;resolved:[2500]DpOp;
    w:=dp_workspace_bytes(86);all:=0;matrices:=0;
    for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));if dp_weight_bf16(i) {matrices+=dp_weight_bytes(i);}}
    slot:=dp_align(2*4096*12288);
    base:=dp_plan(86,49,w+all,stream[..],resident[..]);#assert base.status==DpStatus.ok && base.ops==1092;
    // Feed-forward matrices only: the launches are the resident plan's.
    some:=dp_plan(86,49,w+all-40*slot,stream[..],ops[..]);
    #assert some.streamed_tensors==42 && dp_resolve(ops[..],some.ops,resolved[..])==1092 && dp_digest(resolved[..],1092)==dp_digest(resident[..],1092);
    // Everything: the same launches up to the readout, which reads the head in 21 chunks.
    least:=dp_plan(86,49,w+all-matrices+2*slot,stream[..],ops[..]);
    #assert least.status==DpStatus.ok && least.streamed_tensors==269 && least.ops==1092+3*269+2*20;
    m:=dp_resolve(ops[..],least.ops,resolved[..]);
    #assert m==1092+2*20 && dp_digest(resolved[..],1090)==dp_digest(resident[..],1090);
    lg:=dp_logits_offset(86);rows:=0;
    for c:0..<21 {
        mv:=resolved[1090+2*c];rd:=resolved[1091+2*c];n:=dp_head_rows(c);
        #assert mv.kernel==cast(u8)DpKernel.matvec && mv.items==16*n && mv.args[0].value==n && mv.args[2].buffer==3+DP_HEAD && mv.args[2].offset==2*c*12288*4096 && mv.args[2].count==n*1024;
        #assert rd.kernel==cast(u8)DpKernel.reduce && rd.items==n && rd.args[0].value==n && rd.args[3].offset==lg+4*c*12288 && rd.args[3].count==n && rd.args[2].count==16*n;
        rows+=n;
    }
    #assert rows==248320;
    // The first two copies are layer 0's qkv and z; the last is the head's last chunk.
    #assert ops[0].kind==DpOpKind.copy && ops[0].tensor==dp_weight(0,6) && ops[0].slot==0 && ops[1].tensor==dp_weight(0,7) && ops[1].slot==1;
    last:=0;for i:0..<least.ops {if ops[i].kind==DpOpKind.copy {last=i;}}
    #assert ops[last].tensor==DP_HEAD && ops[last].args[0].offset==2*20*12288*4096;
    #assert dp_digest(ops[..],least.ops)==14444508989034962209;
    // A broken schedule is caught: a launch reading a slot before its wait.
    first:=0;while ops[first].kind!=DpOpKind.wait {first+=1;}
    #assert dp_resolve(ops[..],first+2,resolved[..])==-1;
    ops[first]=ops[first+1];#assert dp_resolve(ops[..],least.ops,resolved[..])==-1;
}
#test "the plan checker refuses each broken use of a slot" {
    out:[8]DpOp;held:=DpArg.{kind=4,buffer=3+DP_HEAD,offset=512,count=1024};
    copy:=DpOp.{kind=DpOpKind.copy,slot=0,count=1};copy.args[0]=held;
    copy1:=copy;copy1.slot=1;
    wait:=DpOp.{kind=DpOpKind.wait,slot=0};free:=DpOp.{kind=DpOpKind.release,slot=0};
    use:=DpOp.{kind=DpOpKind.launch,count=2};use.args[0]=DpArg.{kind=4,buffer=1,count=8};use.args[1]=DpArg.{kind=4,buffer=0,offset=64,count=8};
    good:=[4]DpOp.[copy,wait,use,free];
    #assert dp_resolve(good[..],4,out[..])==1 && out[0].args[0].buffer==3+DP_HEAD && out[0].args[0].offset==512 && out[0].args[0].count==8;
    #assert out[0].args[1].buffer==0 && out[0].args[1].offset==64;
    twice:=[2]DpOp.[copy,copy];#assert dp_resolve(twice[..],2,out[..])==-1;
    early:=[1]DpOp.[wait];#assert dp_resolve(early[..],1,out[..])==-1;
    again:=[3]DpOp.[copy,wait,wait];#assert dp_resolve(again[..],3,out[..])==-1;
    loose:=[2]DpOp.[copy,free];#assert dp_resolve(loose[..],2,out[..])==-1;
    unready:=[2]DpOp.[copy,use];#assert dp_resolve(unready[..],2,out[..])==-1;
    full0:=[1]DpOp.[copy];#assert dp_resolve(full0[..],1,out[..])==-1;
    full1:=[1]DpOp.[copy1];#assert dp_resolve(full1[..],1,out[..])==-1;
    other:=use;other.args[0].buffer=2;w1:=wait;w1.slot=1;f1:=free;f1.slot=1;
    second:=[4]DpOp.[copy1,w1,other,f1];#assert dp_resolve(second[..],4,out[..])==1 && out[0].args[0].offset==512;
}
#test "the largest decision plans and replans" {
    ops:[2500]DpOp;stream:[277]bool;again:[2500]DpOp;all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
    big:=dp_plan(DP_MAX_TOKENS,0,dp_workspace_bytes(DP_MAX_TOKENS)+all,stream[..],ops[..]);
    #assert big.status==DpStatus.ok && dp_replan(DP_MAX_TOKENS,0,big,stream[..],again[..]).status==DpStatus.ok;
}
#test "prefill projections use sixteen interleaved slices when they fit" {
    #assert dp_slices(8192,4096,98304)==8 && dp_slices(12288,4096,98304)==8 && dp_slices(4096,12288,98304)==16 && dp_slices(4096,4096,98304)==16;
    #assert dp_slices(1024,4096,98304)==16 && dp_slices(32,4096,98304)==16 && dp_slices(6144,4096,98304)==16 && dp_slices(6145,4096,98304)==8;
    #assert dp_slices(32,24,98304)==2 && dp_slices(32,8,98304)==2 && dp_slices(32,4,98304)==1 && dp_slices(32,32,98304)==8 && dp_slices(98304,4096,98304)==1;
    #assert dp_slices(49152,4096,98304)==2 && dp_slices(49153,4096,98304)==1 && dp_slices(98305,4096,98304)==1 && dp_slices(12289,4096,98304)==4;
}
#test "a decision may stop before each layer and the readout" {
    ops:[2500]DpOp;stream:[277]bool;w:=dp_workspace_bytes(86);all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
    plan:=dp_plan(86,49,w+all,stream[..],ops[..]);stops:=0;
    for i:0..<plan.ops {if dp_stop_point(ops[i]) {stops+=1;}}
    #assert stops==33 && dp_stop_point(ops[0]) && !dp_stop_point(ops[1]);
    copy:=DpOp.{kind=DpOpKind.copy,kernel=cast(u8)DpKernel.squares};#assert !dp_stop_point(copy);
}
#test "a later decision reuses the opened placement" {
    ops:[2500]DpOp;stream:[277]bool;again:[2500]DpOp;
    w:=dp_workspace_bytes(128);all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
    slot:=dp_align(2*4096*12288);
    opened:=dp_plan(128,0,w+all-7*slot,stream[..],ops[..]);
    #assert opened.status==DpStatus.ok && opened.streamed_tensors==9 && opened.workspace==w;
    later:=dp_replan(86,49,opened,stream[..],again[..]);
    direct:=dp_plan(86,49,w+all-7*slot,stream[..],ops[..]);
    #assert later.status==DpStatus.ok && later.ops==direct.ops && later.workspace==w && later.streamed_tensors==9;
    #assert dp_digest(again[..],later.ops)==dp_digest(ops[..],direct.ops);
    #assert dp_replan(DP_MAX_TOKENS+1,0,opened,stream[..],again[..]).status==DpStatus.shape && dp_replan(86,86,opened,stream[..],again[..]).status==DpStatus.shape;
    #assert dp_replan(0,0,opened,stream[..],again[..]).status==DpStatus.shape && dp_replan(86,-1,opened,stream[..],again[..]).status==DpStatus.shape;
    #assert dp_replan(86,49,opened,stream[0..<276],again[..]).status==DpStatus.capacity;
    small:=opened;small.workspace=dp_workspace_bytes(64);
    #assert dp_replan(65,0,small,stream[..],again[..]).status==DpStatus.capacity && dp_replan(64,0,small,stream[..],again[..]).status==DpStatus.ok;
    bad:=opened;bad.status=DpStatus.memory;#assert dp_replan(86,49,bad,stream[..],again[..]).status==DpStatus.capacity;
    other:[277]bool;for i:0..<277 {other[i]=stream[i];}other[0]=!other[0];
    #assert dp_replan(86,49,opened,other[..],again[..]).status==DpStatus.capacity;
    fewer:=opened;fewer.streamed_tensors=8;#assert dp_replan(86,49,fewer,stream[..],again[..]).status==DpStatus.capacity;
    #assert dp_replan(1,0,opened,stream[..],again[..]).status==DpStatus.ok && dp_replan(128,127,opened,stream[..],again[..]).status==DpStatus.ok;
}
#test "tensor-core projections pad tokens to warps and slice until the launch is full" {
    #assert dp_padded(1)==88 && dp_padded(86)==88 && dp_padded(88)==88 && dp_padded(89)==176;
    #assert dp_mma_slices(8192,4096,98304)==8 && dp_mma_slices(12288,4096,98304)==8 && dp_mma_slices(4096,12288,98304)==16;
    #assert dp_mma_slices(4096,4096,98304)==16 && dp_mma_slices(1024,4096,98304)==32 && dp_mma_slices(32,4096,98304)==32;
    #assert dp_mma_slices(4096,4096,1048576)==16 && dp_mma_slices(4095,4096,1048576)==32;
    #assert dp_mma_slices(65536,4096,98304)==1 && dp_mma_slices(32768,4096,98304)==2 && dp_mma_slices(16,256,98304)==2 && dp_mma_slices(16,512,98304)==4;
    #assert dp_mma_slices(16,768,98304)==4 && dp_mma_slices(16,240,98304)==1 && dp_mma_slices(16,1048576,98304)==32 && dp_mma_slices(12288,4096,98303)==4 && dp_mma_slices(12288,4096,98304*2)==8;
}
#test "embedding rows decode BF16 and refuse bad tokens and non-finite rows" {
    // Three rows of width 4.
    table:=[24]u8.[0x80,0x3f, 0x00,0xc0, 0,0, 0,0, 0x00,0x3f, 0x40,0x40, 0,0, 0,0, 0xe0,0x40, 0,0, 0x80,0x3f, 0x80,0x3f];
    tokens:=[3]int.[2,0,1];out:[12]f32;
    four:[32]u8;for i:0..<24 {four[i]=table[i];}
    #assert dp_embed(tokens[..],4,four[..],out[..]) && out[0]==7;
    #assert dp_embed(tokens[..],4,table[..],out[..]);
    #assert out[0]==7 && out[1]==0 && out[2]==1 && out[3]==1 && out[4]==1 && out[5]==-2 && out[8]==0.5 && out[9]==3 && out[11]==0;
    #assert !dp_embed(tokens[..],4,table[..],out[0..<11]) && !dp_embed(tokens[..],0,table[..],out[..]) && !dp_embed(tokens[..],4,table[0..<22],out[..]);
    #assert !dp_embed(tokens[..],-4,table[..],out[..]) && !dp_embed(tokens[0..<1],4,table[0..<20],out[0..<4]);
    bad:=[1]int.[3];#assert !dp_embed(bad[..],4,table[..],out[0..<4]);
    bad[0]=-1;#assert !dp_embed(bad[..],4,table[..],out[0..<4]);
    one:[1]f32;bad[0]=11;#assert dp_embed(bad[..],1,table[..],one[..]) && one[0]==1 && !dp_embed(bad[..],1,table[0..<23],one[..]);
    bad[0]=2;table[19]=0x7f;table[18]=0x81;
    #assert !dp_embed(bad[..],4,table[..],out[0..<4]);
    table[19]=0xff;table[18]=0x80;#assert !dp_embed(bad[..],4,table[..],out[0..<4]);
    table[18]=0x7f;table[19]=0x7f;#assert dp_embed(bad[..],4,table[..],out[0..<4]) && out[1]==f32_from_bits(0x7f7f0000);
}
#test "the Metal plan projects on matrix-unit tiles, one launch per projection" {
    ops:[1500]DpOp;stream:[DP_STREAMABLE]bool;w:=dp_workspace_bytes(86);all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
    plan:=dp_plan_metal(86,49,w+all,stream[..],ops[..]);
    // 248 projections each lose split and reduce.
    #assert plan.status==DpStatus.ok && plan.metal && plan.ops==1092-2*248 && plan.streamed==0;
    tiles:=0;narrow:=0;
    for i:0..<plan.ops {
        op:=ops[i];
        #assert op.kernel!=cast(u8)DpKernel.split && op.kernel!=cast(u8)DpKernel.mma_project && op.kernel!=cast(u8)DpKernel.project;
        if op.kernel==cast(u8)DpKernel.tile_wide || op.kernel==cast(u8)DpKernel.tile_narrow {
            tiles+=1;#assert op.lanes==128 && op.count==6;
            rows:=op.args[0].value;tn:=64;
            if op.kernel==cast(u8)DpKernel.tile_narrow {narrow+=1;tn=32;#assert rows==32;} else {#assert rows>32;}
            #assert op.items==6*((rows+tn-1)/tn) && op.args[2].value==86 && op.args[3].count==rows*op.args[1].value/2;
            #assert op.args[4].count==86*op.args[1].value && op.args[5].count==86*rows;
        }
    }
    #assert tiles==248 && narrow==48;
    // Layer 0: norm (2 launches), then qkv straight into its region.
    p:=dp_layout(86);
    #assert ops[2].kernel==cast(u8)DpKernel.tile_wide && ops[2].items==6*128 && ops[2].args[0].value==8192 && ops[2].args[4].offset==p.norm && ops[2].args[5].offset==p.qkv;
    #assert ops[2].args[3].buffer==3+dp_weight(0,6);
    // Short prompts and the readout keep their kernels; a later decision keeps the backend.
    one:=dp_plan_metal(1,0,w+all,stream[..],ops[..]);
    #assert one.ops==596 && ops[2].kernel==cast(u8)DpKernel.tile_wide && ops[2].items==128 && ops[595].kernel==cast(u8)DpKernel.reduce && ops[594].kernel==cast(u8)DpKernel.matvec;
    again:[1500]DpOp;
    later:=dp_replan(86,49,dp_plan_metal(128,0,dp_workspace_bytes(128)+all,stream[..],ops[..]),stream[..],again[..]);
    direct:=dp_plan_metal(86,49,w+all,stream[..],ops[..]);
    #assert later.metal && later.ops==direct.ops && dp_digest(again[..],later.ops)==dp_digest(ops[..],direct.ops);
    #assert dp_plan_metal(0,0,w+all,stream[..],ops[..]).status==DpStatus.shape && dp_plan_metal(86,49,100,stream[..],ops[..]).status==DpStatus.memory;
    #assert !dp_plan(86,49,w+all,stream[..],ops[..]).metal;
}
#test "the fork buffer keeps each layer's history, state and key and value rows apart" {
    #assert dp_fork_history(0)==0 && dp_fork_history(1)==DP_FORK_HISTORY && dp_fork_history(4)==3*DP_FORK_HISTORY && dp_fork_history(30)==23*DP_FORK_HISTORY;
    #assert dp_fork_state(0)==24*DP_FORK_HISTORY && dp_fork_state(5)==24*DP_FORK_HISTORY+4*DP_FORK_STATE && dp_fork_state(30)+DP_FORK_STATE==dp_fork_keys(3);
    #assert dp_fork_keys(3)==24*(DP_FORK_HISTORY+DP_FORK_STATE) && dp_fork_keys(7)==dp_fork_keys(3)+2*DP_FORK_CACHE && dp_fork_keys(31)+2*DP_FORK_CACHE==dp_fork_bytes();
    #assert dp_fork_bytes()==86245376 && DP_FORK_HISTORY%256==0 && DP_FORK_STATE%256==0 && DP_FORK_CACHE%256==0;
    #assert dp_fork_mode(DpFork.{on=true,save=true})==2 && dp_fork_mode(DpFork.{on=true,start=5})==1 && dp_fork_mode(DpFork.{on=true,start=1})==1 && dp_fork_mode(DpFork.{on=true,start=5,save=true})==3 && dp_fork_mode(DpFork.{on=true})==0;
    a:=dp_fork_arg(dp_model(0),64,8);#assert a.kind==4 && a.buffer==DP_FORK_BUFFER && a.offset==64 && a.count==8 && DP_FORK_BUFFER==517;
    // A suffix's attention regions grow with its keys; the rest of the layout does not.
    p:=dp_layout_keys(37,86);q:=dp_layout(37);
    #assert p.scores==q.scores && p.probs==q.scores+dp_align(4*37*16*86)+dp_align(8*37*16*3) && p.total>q.total && dp_layout_keys(37,37).total==q.total;
}
#test "a forked decision: the prefix pass keeps state, a suffix reads it" {
  for backend:0..<2 {
    metal:=backend==1;buf:[2500]DpOp;ops:=buf[..];
        stream:[DP_STREAMABLE]bool;all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
        w:=dp_workspace_bytes(128);
        opened:=dp_plan_on(metal,128,0,w+all,stream[..],ops);#assert opened.status==DpStatus.ok;
        whole:=dp_replan(86,49,opened,stream[..],ops);
        prefix:=dp_plan_prefix(49,opened,stream[..],ops);
        // The prefix pass: one block of 49, no readout, keeping everything.
        #assert prefix.status==DpStatus.ok && prefix.metal==metal && prefix.rope==dp_layout(49).rope;
        convs:=0;scans:=0;scores:=0;
        for i:0..<prefix.ops {
            op:=ops[i];
            #assert op.kernel!=cast(u8)DpKernel.matvec && op.kernel!=cast(u8)DpKernel.conv && op.kernel!=cast(u8)DpKernel.scan;
            if op.kernel==cast(u8)DpKernel.conv_state {convs+=1;#assert op.count==7 && op.items==8192 && op.args[6].value==2 && op.args[5].buffer==DP_FORK_BUFFER && op.args[5].count==3*8192 && op.args[1].value==49;}
            if op.kernel==cast(u8)DpKernel.scan_state {scans+=1;#assert op.count==12 && op.items==32*128 && op.args[11].value==2 && op.args[10].count==32*128*128 && op.args[0].value==49;}
            if op.kernel==cast(u8)DpKernel.scores {scores+=1;#assert op.args[0].value==49 && op.args[1].value==0 && op.items==49*16*49 && op.args[5].buffer==DP_FORK_BUFFER && op.args[5].count==49*1024;}
            if op.kernel==cast(u8)DpKernel.prepare {#assert op.args[8].buffer==DP_FORK_BUFFER && (op.args[8].offset-dp_fork_keys(3))%(2*DP_FORK_CACHE)==0 && op.args[8].count==49*1024;}
        }
        #assert convs==24 && scans==24 && scores==8;
        #assert ops[prefix.ops-1].kernel==cast(u8)DpKernel.add;
        // A suffix of 37 from token 49: it starts from the kept values, sees all 86 keys and reads out.
        suffix:=dp_plan_suffix(49,37,opened,stream[..],ops);
        #assert suffix.status==DpStatus.ok && suffix.rope==dp_layout_keys(37,86).rope && suffix.logits==dp_layout_keys(37,86).logits;
        #assert ops[suffix.ops-1].kernel==cast(u8)DpKernel.reduce && ops[suffix.ops-2].kernel==cast(u8)DpKernel.matvec;
        at:=0;
        for i:0..<suffix.ops {
            op:=ops[i];
            if op.kernel==cast(u8)DpKernel.conv_state {#assert op.args[6].value==1 && op.args[5].offset==dp_fork_history(at) && op.args[1].value==37;}
            if op.kernel==cast(u8)DpKernel.scan_state {#assert op.args[11].value==1 && op.args[10].offset==dp_fork_state(at);}
            if op.kernel==cast(u8)DpKernel.prepare {#assert op.args[8].offset==dp_fork_keys(at)+4*49*1024 && op.args[8].count==37*1024;}
            if op.kernel==cast(u8)DpKernel.scores {#assert op.args[0].value==86 && op.args[1].value==0 && op.items==37*16*86 && op.args[5].offset==dp_fork_keys(at) && op.args[5].count==86*1024;}
            if op.kernel==cast(u8)DpKernel.softmax {#assert op.args[0].value==86 && op.items==37*16 && op.args[5].count==37*16*86;}
            if op.kernel==cast(u8)DpKernel.attend {#assert op.args[0].value==86 && op.args[4].offset==dp_fork_keys(at)+DP_FORK_CACHE && op.args[4].count==86*1024;}
            if op.kernel==cast(u8)DpKernel.add {at+=1;}
        }
        #assert at==32;
        // The value projection writes the fork buffer's rows of this block.
        values:=0;at=0;
        for i:0..<suffix.ops {
            op:=ops[i];
            if op.kernel==cast(u8)DpKernel.add {at+=1;}
            fork_reader:=op.kernel==cast(u8)DpKernel.prepare || op.kernel==cast(u8)DpKernel.scores || op.kernel==cast(u8)DpKernel.attend || op.kernel==cast(u8)DpKernel.conv_state || op.kernel==cast(u8)DpKernel.scan_state;
            for j:0..<op.count {
                if !fork_reader && op.args[j].buffer==DP_FORK_BUFFER {values+=1;#assert op.args[j].offset==dp_fork_keys(at)+DP_FORK_CACHE+4*49*1024 && op.args[j].count==37*1024;}
            }
        }
        #assert values==8 && whole.ops>0;
        // Refusals: a suffix needs a prefix, everything fits 512 tokens and the opened workspace.
        #assert dp_plan_suffix(0,37,opened,stream[..],ops).status==DpStatus.shape && dp_plan_suffix(49,464,opened,stream[..],ops).status==DpStatus.shape;
        #assert dp_plan_suffix(49,463,opened,stream[..],ops).status==DpStatus.capacity && dp_plan_suffix(49,0,opened,stream[..],ops).status==DpStatus.shape;
        #assert dp_plan_suffix(1,1,opened,stream[..],ops).status==DpStatus.ok;
        #assert dp_plan_suffix(28,100,opened,stream[..],ops).status==DpStatus.ok;
        #assert dp_plan_suffix(128,128,opened,stream[..],ops).status==DpStatus.capacity;
        #assert dp_plan_prefix(0,opened,stream[..],ops).status==DpStatus.shape && dp_plan_prefix(128,opened,stream[..],ops).status==DpStatus.ok;
        bad:=opened;bad.status=DpStatus.memory;#assert dp_plan_prefix(49,bad,stream[..],ops).status==DpStatus.capacity;
        #assert dp_plan_suffix(49,37,opened,stream[0..<10],ops).status==DpStatus.capacity;
        fewer:=opened;fewer.streamed_tensors=1;#assert dp_plan_suffix(49,37,fewer,stream[..],ops).status==DpStatus.capacity;
        #assert dp_plan_suffix(49,37,opened,stream[..],ops[0..<100]).status==DpStatus.capacity;
  }
}
#test "the prefix pass of a streamed plan streams no head chunk" {
    ops:[2500]DpOp;stream:[DP_STREAMABLE]bool;all:=0;for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));}
    w:=dp_workspace_bytes(128);
    // Stream down to the head: every feed-forward matrix and some head chunks.
    opened:=dp_plan(128,0,w+all/3,stream[..],ops[..]);
    #assert opened.status==DpStatus.ok && dp_streamed(DP_HEAD,stream[..]);
    prefix:=dp_plan_prefix(49,opened,stream[..],ops[..]);
    copies:=0;waits:=0;
    for i:0..<prefix.ops {
        if ops[i].kind==DpOpKind.copy {copies+=1;#assert ops[i].tensor!=DP_HEAD;}
        if ops[i].kind==DpOpKind.wait {waits+=1;}
    }
    #assert prefix.status==DpStatus.ok && copies==waits && copies>0;
    suffix:=dp_plan_suffix(49,37,opened,stream[..],ops[..]);heads:=0;
    for i:0..<suffix.ops {if ops[i].kind==DpOpKind.copy && ops[i].tensor==DP_HEAD {heads+=1;}}
    #assert suffix.status==DpStatus.ok && heads==DP_HEAD_CHUNKS;
}
#test "matrix-unit tiles: 16 tokens by 64 rows, the narrow tile up to 32 rows" {
    ops:[4]DpOp;b:=DpBuilder.{ops=ops[..],ok=true,metal=true};out:=dp_ws(1024,17*33);
    r:=dp_tile(b,dp_matrix(6),32,4096,17,256,out);r=dp_tile(r,dp_matrix(6),33,4096,17,256,out);r=dp_tile(r,dp_matrix(6),129,64,16,256,out);
    #assert r.n==3 && ops[0].kernel==cast(u8)DpKernel.tile_narrow && ops[0].items==2 && ops[1].kernel==cast(u8)DpKernel.tile_wide && ops[1].items==2;
    #assert ops[2].items==3 && ops[2].args[3].count==129*32 && ops[2].args[4].count==16*64 && ops[2].args[5].offset==1024 && ops[0].args[2].value==17;
}
#test "the shape is data: Elephant's and Mammoth's" {
    e:=dp_model(0);m:=dp_model(1);
    #assert e.kind==0 && e.layers==32 && e.width==4096 && e.hidden==12288 && e.vocab==248320 && e.key_heads==16 && e.value_heads==32 && e.heads==16 && e.kv_heads==4 && e.chunks==21;
    #assert m.kind==1 && m.layers==64 && m.width==5120 && m.hidden==17408 && m.vocab==248320 && m.key_heads==16 && m.value_heads==48 && m.heads==24 && m.kv_heads==4 && m.chunks==15;
    #assert dp_model(2).layers==32 && dp_model(2).kind==0 && dp_model(-1).width==4096;
    #assert dp_channels(e)==8192 && dp_values(e)==4096 && dp_queries(e)==8192 && dp_attended(e)==4096 && dp_kv(e)==1024;
    #assert dp_channels(m)==10240 && dp_values(m)==6144 && dp_queries(m)==12288 && dp_attended(m)==6144 && dp_kv(m)==1024;
    #assert dp_weights(e)==514 && dp_head(m)==1024 && dp_final(m)==1025 && dp_weights(m)==1026;
    #assert dp_streamable(e)==277 && dp_streamable(m)==527 && DP_MAX_STREAMABLE==dp_streamable(m) && dp_mixer_base(m)==192 && dp_head_base(m)==512;
    // The head's chunks cover the vocabulary, the last one partly.
    for x:0..<2 {k:=dp_model(x);#assert k.chunks*k.hidden>=k.vocab && (k.chunks-1)*k.hidden<k.vocab;}
    #assert dp_chunk_rows(m,0)==17408 && dp_chunk_rows(m,13)==17408 && dp_chunk_rows(m,14)==4608;
    // Elephant's constants are its model's.
    #assert DP_LAYERS==e.layers && DP_WIDTH==e.width && DP_HIDDEN==e.hidden && DP_VOCAB==e.vocab && DP_HEAD==dp_head(e) && DP_FINAL==dp_final(e) && DP_WEIGHTS==dp_weights(e);
    #assert DP_FFN_STREAMS==3*e.layers && DP_MIXER_BASE==dp_mixer_base(e) && DP_HEAD_BASE==dp_head_base(e) && DP_HEAD_ROWS==e.hidden && DP_HEAD_CHUNKS==e.chunks && DP_STREAMABLE==dp_streamable(e);
    #assert DP_FORK_BUFFER==dp_fork_buffer(e) && DP_FORK_HISTORY==dp_fork_history_bytes(e) && DP_FORK_STATE==dp_fork_state_bytes(e) && DP_FORK_CACHE==dp_fork_cache_bytes(e);
    #assert DP_PARTIAL_ROWS==dp_layout(86).partial_rows && dp_layout_of(m,86,86).partial_rows==8*17408;
    #assert dp_wider(3,5)==5 && dp_wider(5,3)==5 && dp_wider(4,4)==4 && dp_wider(-2,1)==1 && dp_wider(0,0)==0;
}
#forall "Mammoth's spread order is the 6-bit reversal" i:0..<64 {
    r:=dp_spread_of(64,i);
    #assert r>=0 && r<64 && dp_spread_of(64,r)==i && dp_spread_of(64,i%32*2)==dp_spread(i%32);
    #assert ((r>>5)&1)==(i&1) && (r&1)==((i>>5)&1) && ((r>>2)&1)==((i>>3)&1);
}
#test "Mammoth's weights: 64 layers, the pinned shapes" {
    m:=dp_model(1);
    #assert dp_elements(m,dp_weight(0,0))==5120 && dp_elements(m,dp_weight(0,2))==4*10240 && dp_elements(m,dp_weight(0,3))==48 && dp_elements(m,dp_weight(0,4))==48;
    #assert dp_elements(m,dp_weight(0,5))==128 && dp_elements(m,dp_weight(0,6))==10240*5120 && dp_elements(m,dp_weight(0,7))==6144*5120 && dp_elements(m,dp_weight(0,8))==48*5120;
    #assert dp_elements(m,dp_weight(0,10))==5120*6144 && dp_elements(m,dp_weight(0,11))==17408*5120 && dp_elements(m,dp_weight(0,13))==5120*17408 && dp_elements(m,dp_weight(0,14))==0;
    #assert dp_elements(m,dp_weight(3,2))==256 && dp_elements(m,dp_weight(3,4))==12288*5120 && dp_elements(m,dp_weight(3,5))==1024*5120 && dp_elements(m,dp_weight(3,6))==1024*5120;
    #assert dp_elements(m,dp_weight(3,7))==5120*6144 && dp_elements(m,dp_weight(63,10))==5120*17408 && dp_elements(m,dp_weight(63,11))==0;
    #assert dp_elements(m,1024)==248320*5120 && dp_elements(m,1025)==5120 && dp_elements(m,1026)==-1 && dp_elements(m,-1)==-1 && dp_elements(m,512)==5120;
    total:=0;matrices:=0;
    for w:0..<dp_weights(m) {total+=dp_bytes(m,w);if dp_bf16(m,w) {matrices+=1;}}
    #assert total==51254491136 && matrices==48*8+16*7+1;
    #assert dp_bf16(m,1024) && !dp_bf16(m,1025) && !dp_bf16(m,1026) && !dp_bf16(m,512) && dp_bf16(m,513+6-1+16) && dp_bytes(m,1024)==2*248320*5120 && dp_bytes(m,1025)==4*5120;
}
#test "Mammoth's streaming indices" {
    m:=dp_model(1);stream:[527]bool;for i:0..<527 {stream[i]=true;}
    #assert dp_stream_index_of(m,dp_weight(0,11))==0 && dp_stream_index_of(m,dp_weight(63,10))==191 && dp_stream_index_of(m,dp_weight(0,6))==192;
    #assert dp_stream_index_of(m,dp_weight(3,4))==192+15 && dp_stream_index_of(m,dp_weight(63,7))==192+5*63+3 && dp_stream_index_of(m,1024)==512;
    #assert dp_stream_index_of(m,1025)==-1 && dp_stream_index_of(m,1026+5)==-1 && dp_stream_index_of(m,dp_weight(40,0))==-1 && dp_stream_index_of(m,dp_weight(40,12))==3*40+1;
    #assert dp_stream_weight_of(m,527)==-1 && dp_stream_weight_of(m,526)==1024 && dp_stream_weight_of(m,512)==1024 && dp_stream_weight_of(m,511)==-1 && dp_stream_weight_of(m,510)==dp_weight(63,7);
    #assert dp_stream_weight_of(m,191)==dp_weight(63,10) && dp_stream_weight_of(m,192)==dp_weight(0,6) && dp_stream_weight_of(m,-1)==-1;
    for i:0..<512 {x:=dp_stream_weight_of(m,i);if x>=0 {#assert dp_stream_index_of(m,x)==i && dp_bf16(m,x);}}
    #assert dp_streamed_of(m,1024,stream[..]) && dp_streamed_of(m,dp_weight(63,7),stream[..]) && !dp_streamed_of(m,dp_weight(63,7),stream[0..<510]);
    c:=dp_copy(m,512+14,1);
    #assert c.tensor==1024 && c.slot==1 && c.args[0].buffer==3+1024 && c.args[0].offset==2*14*17408*5120 && c.args[0].count==2*4608*5120;
    f:=dp_copy(m,2,0);#assert f.tensor==dp_weight(0,13) && f.args[0].offset==0 && f.args[0].count==2*5120*17408;
}
#test "Mammoth's workspace and fork buffer" {
    m:=dp_model(1);p:=dp_layout_of(m,86,86);
    #assert p.total==120422656 && dp_model_workspace_bytes(1,86)==p.total && dp_model_workspace_bytes(0,86)==dp_workspace_bytes(86);
    // The [q | k | v] region holds a full layer's 12,288 query rows; the mix region 6,144 values.
    #assert p.z-p.qkv==dp_align(4*86*12288) && p.a-p.z==dp_align(4*86*6144) && p.k-p.b==dp_align(4*86*48) && p.qn-p.conv==dp_align(4*86*10240);
    #assert p.aq-p.mix==dp_align(4*86*6144) && p.ak-p.aq==dp_align(4*86*6144) && p.stats-p.scores==dp_align(4*86*24*86) && p.squares-p.probs==dp_align(8*86*24*86);
    #assert p.lo-p.hi==dp_align(4*88*17408/2) && p.up-p.gate==dp_align(4*86*17408) && p.lanes+dp_align(4*16*248320)==p.total && p.x1-p.x0==dp_align(4*86*5120);
    e:=dp_layout(86);#assert e.z-e.qkv==dp_align(4*86*8192) && e.aq-e.mix==dp_align(4*86*4096);
    #assert dp_fork_buffer(m)==1029 && dp_fork_bytes_of(m)==48*(4*3*10240+4*48*128*128)+16*2*4*512*1024 && dp_fork_bytes_of(m)==224002048;
    #assert dp_fork_history_of(m,1)==4*3*10240 && dp_fork_state_of(m,0)==48*4*3*10240 && dp_fork_keys_of(m,7)==48*(4*3*10240+4*48*128*128)+2*4*512*1024;
    a:=dp_fork_arg(m,64,8);#assert a.buffer==1029 && a.offset==64 && a.count==8;
}
#test "a Mammoth decision: resident, and streamed through two slots" {
    m:=dp_model(1);ops:[3800]DpOp;stream:[527]bool;w:=dp_model_workspace_bytes(1,86);all:=0;matrices:=0;
    for i:0..<dp_weights(m) {all+=dp_align(dp_bytes(m,i));if dp_bf16(m,i) {matrices+=dp_bytes(m,i);}}
    slot:=dp_align(2*5120*17408);
    plan:=dp_plan_model(1,false,86,49,w+all,stream[..],ops[..]);
    #assert plan.status==DpStatus.ok && plan.kind==1 && plan.ops==2180 && plan.streamed==0 && plan.resident==all && plan.workspace==w;
    #assert ops[0].kernel==cast(u8)DpKernel.squares && ops[0].items==16*86 && ops[0].args[0].value==5120 && ops[3].kernel==cast(u8)DpKernel.mma_project && ops[3].args[0].value==10240;
    #assert ops[2178].kernel==cast(u8)DpKernel.matvec && ops[2178].items==16*248320 && ops[2178].args[2].count==248320*5120/4 && ops[2178].args[2].buffer==3+1024 && ops[2179].kernel==cast(u8)DpKernel.reduce;
    full:=0;
    for i:0..<plan.ops {
        op:=ops[i];
        if op.kernel==cast(u8)DpKernel.prepare {full+=1;#assert op.items==86*28 && op.args[0].value==24 && op.args[2].count==86*12288 && op.args[7].count==86*6144;}
        if op.kernel==cast(u8)DpKernel.attend {#assert op.items==86*6144 && op.args[1].value==24;}
        if op.kernel==cast(u8)DpKernel.scan {#assert op.items==48*128 && op.args[1].value==48 && op.args[3].value==10240 && op.args[9].count==86*6144;}
        if op.kernel==cast(u8)DpKernel.gate_norm {#assert op.items==86*48;}
    }
    #assert full==16 && dp_digest(ops[..],plan.ops)==15592307743001654911;
    #assert dp_digest(ops[..],2178)==15192526894030135554;
}
#test "Mammoth streaming feed-forward matrices computes what the resident plan computes" {
    m:=dp_model(1);ops:[3800]DpOp;stream:[527]bool;w:=dp_model_workspace_bytes(1,86);all:=0;matrices:=0;
    for i:0..<dp_weights(m) {all+=dp_align(dp_bytes(m,i));if dp_bf16(m,i) {matrices+=dp_bytes(m,i);}}
    slot:=dp_align(2*5120*17408);resolved:[2300]DpOp;
    // Feed-forward matrices only: the launches are the resident plan's.
    some:=dp_plan_model(1,false,86,49,w+all-100*slot,stream[..],ops[..]);
    #assert some.status==DpStatus.ok && some.streamed_tensors==102 && dp_resolve(ops[..],some.ops,resolved[..])==2180 && dp_digest(resolved[..],2178)==15192526894030135554;
}
#test "Mammoth streaming everything reads the head in 15 chunks" {
    m:=dp_model(1);ops:[3800]DpOp;stream:[527]bool;w:=dp_model_workspace_bytes(1,86);all:=0;matrices:=0;
    for i:0..<dp_weights(m) {all+=dp_align(dp_bytes(m,i));if dp_bf16(m,i) {matrices+=dp_bytes(m,i);}}
    slot:=dp_align(2*5120*17408);resolved:[2300]DpOp;
    plan:=dp_layout_of(m,86,86);
    least:=dp_plan_model(1,false,86,49,w+all-matrices+2*slot,stream[..],ops[..]);
    #assert least.status==DpStatus.ok && least.streamed_tensors==511 && least.streamed==matrices && least.ops==2180+3*511+2*14;
    n:=dp_resolve(ops[..],least.ops,resolved[..]);
    #assert n==2180+2*14 && dp_digest(resolved[..],2178)==15192526894030135554 && dp_digest(ops[..],least.ops)==7550959327929850761;
    rows:=0;
    for c:0..<15 {
        mv:=resolved[2178+2*c];k:=dp_chunk_rows(m,c);
        #assert mv.kernel==cast(u8)DpKernel.matvec && mv.args[0].value==k && mv.args[1].value==5120 && mv.args[2].offset==2*c*17408*5120 && mv.args[2].count==k*1280;
        #assert resolved[2179+2*c].args[3].offset==plan.logits+4*c*17408;
        rows+=k;
    }
    #assert rows==248320 && least.logits==dp_layout_of(m,86,86).logits;
    #assert dp_plan_model(1,false,86,49,w+all-matrices+2*slot-1,stream[..],ops[..]).status==DpStatus.memory;
    #assert dp_plan_model(2,false,86,49,w+all,stream[..],ops[..]).status==DpStatus.shape && dp_plan_model(-1,false,86,49,w+all,stream[..],ops[..]).status==DpStatus.shape;
    #assert dp_plan_model(1,false,86,49,w+all,stream[0..<277],ops[..]).status==DpStatus.capacity && dp_plan_model(1,false,86,49,w+all,stream[..],ops[0..<2179]).status==DpStatus.capacity;
    #assert dp_plan_model(1,false,0,0,w+all,stream[..],ops[..]).status==DpStatus.shape && dp_plan_model(1,false,513,0,w+all,stream[..],ops[..]).status==DpStatus.shape && dp_plan_model(1,false,86,86,w+all,stream[..],ops[..]).status==DpStatus.shape;
}
#test "a later Mammoth decision keeps the model" {
    m:=dp_model(1);ops:[3800]DpOp;stream:[527]bool;w:=dp_model_workspace_bytes(1,86);all:=0;matrices:=0;
    for i:0..<dp_weights(m) {all+=dp_align(dp_bytes(m,i));if dp_bf16(m,i) {matrices+=dp_bytes(m,i);}}
    slot:=dp_align(2*5120*17408);resolved:[2300]DpOp;
    opened:=dp_plan_model(1,false,128,0,dp_model_workspace_bytes(1,128)+all-100*slot,stream[..],ops[..]);
    later:=dp_replan(86,49,opened,stream[..],ops[..]);
    #assert later.status==DpStatus.ok && later.kind==1 && dp_resolve(ops[..],later.ops,resolved[..])==2180 && dp_digest(resolved[..],2178)==15192526894030135554;
    #assert dp_replan(86,49,opened,stream[0..<277],ops[..]).status==DpStatus.capacity;
    elephant:=opened;elephant.kind=0;#assert dp_replan(86,49,elephant,stream[..],ops[..]).status==DpStatus.capacity;
}
#test "a forked Mammoth decision keeps every layer's state apart" {
    m:=dp_model(1);ops:[3800]DpOp;stream:[527]bool;all:=0;for i:0..<dp_weights(m) {all+=dp_align(dp_bytes(m,i));}
    opened:=dp_plan_model(1,false,128,0,dp_model_workspace_bytes(1,128)+all,stream[..],ops[..]);
    prefix:=dp_plan_prefix(49,opened,stream[..],ops[..]);
    #assert prefix.status==DpStatus.ok && prefix.kind==1 && ops[prefix.ops-1].kernel==cast(u8)DpKernel.add;
    convs:=0;scans:=0;
    for i:0..<prefix.ops {
        op:=ops[i];
        if op.kernel==cast(u8)DpKernel.conv_state {convs+=1;#assert op.items==10240 && op.args[5].buffer==1029 && op.args[5].count==3*10240 && op.args[6].value==2;}
        if op.kernel==cast(u8)DpKernel.scan_state {scans+=1;#assert op.items==48*128 && op.args[10].count==48*128*128;}
    }
    #assert convs==48 && scans==48;
    suffix:=dp_plan_suffix(49,37,opened,stream[..],ops[..]);
    #assert suffix.status==DpStatus.ok && suffix.logits==dp_layout_of(m,37,86).logits && ops[suffix.ops-2].kernel==cast(u8)DpKernel.matvec;
    at:=0;values:=0;
    for i:0..<suffix.ops {
        op:=ops[i];
        if op.kernel==cast(u8)DpKernel.conv_state {#assert op.args[5].offset==dp_fork_history_of(m,at) && op.args[6].value==1;}
        if op.kernel==cast(u8)DpKernel.scan_state {#assert op.args[10].offset==dp_fork_state_of(m,at);}
        if op.kernel==cast(u8)DpKernel.prepare {#assert op.args[8].offset==dp_fork_keys_of(m,at)+4*49*1024 && op.args[8].count==37*1024;}
        if op.kernel==cast(u8)DpKernel.scores {#assert op.args[0].value==86 && op.items==37*24*86 && op.args[5].offset==dp_fork_keys_of(m,at) && op.args[5].count==86*1024;}
        if op.kernel==cast(u8)DpKernel.attend {#assert op.args[4].offset==dp_fork_keys_of(m,at)+dp_fork_cache_bytes(m) && op.args[4].count==86*1024;}
        if op.kernel==cast(u8)DpKernel.mma_project && op.args[0].value==1024 {values+=1;}
        if op.kernel==cast(u8)DpKernel.add {at+=1;}
    }
    #assert at==64 && values==32 && dp_plan_suffix(49,37,opened,stream[0..<277],ops[..]).status==DpStatus.capacity;
    #assert dp_plan_suffix(28,100,opened,stream[..],ops[..]).status==DpStatus.ok && dp_plan_suffix(128,128,opened,stream[..],ops[..]).status==DpStatus.capacity;
}
// book:begin perquestion
// The launches that carry a question's state (convolution, delta rule,
// attention), with the workspace offsets left out: a batch's question i
// must make exactly the launches its own suffix pass makes, in order, on the
// same fork-buffer rows. Occurrence j of a stateful kernel in a batch of q
// questions is question j%q's (they run question after question).
dp_stateful :: (op:DpOp)->bool {
    k:=op.kernel;
    return op.kind==DpOpKind.launch && (k==cast(u8)DpKernel.conv_state || k==cast(u8)DpKernel.scan_state || k==cast(u8)DpKernel.prepare || k==cast(u8)DpKernel.scores || k==cast(u8)DpKernel.softmax || k==cast(u8)DpKernel.attend);
}
dp_state_digest :: (ops:[]DpOp,n:int,questions:int,which:int)->u64 {
    h:u64=14695981039346656037;seen:[DP_KERNELS]int;
    for i:0..<n {
        op:=ops[i];
        if dp_stateful(op) {
            j:=seen[op.kernel];seen[op.kernel]=j+1;
            if j%questions==which {
                fields:=[4]int.[cast(int)op.kernel,op.items,op.lanes,op.count];
                for f:fields {h=mul_wrap(h^cast,trunc(u64)f,1099511628211);}
                for k:0..<op.count {
                    a:=op.args[k];offset:=a.offset;if a.buffer==0 {offset=-1;}
                    more:=[5]int.[cast(int)a.kind,a.value,a.buffer,offset,a.count];
                    for f:more {h=mul_wrap(h^cast,trunc(u64)f,1099511628211);}
                }
            }
        }
    }
    return h;
}
// book:end perquestion
#test "a batch admits suffixes whose projections take one path" {
    one:=[1]int.[37];five:=[5]int.[37,38,36,37,39];
    #assert dp_batch_admits(false,49,one[..]) && dp_batch_admits(false,49,five[..]) && !dp_batch_admits(true,49,five[..]);
    #assert !dp_batch_admits(false,0,one[..]) && dp_batch_admits(false,1,one[..]);
    edge:=[2]int.[16,16];#assert dp_batch_admits(false,49,edge[..]);
    mixed:=[2]int.[15,16];#assert !dp_batch_admits(false,49,mixed[..]);
    small:=[2]int.[7,8];#assert dp_batch_admits(false,49,small[..]);
    even:=[2]int.[8,8];#assert !dp_batch_admits(false,49,even[..]);
    zero:=[2]int.[0,20];#assert !dp_batch_admits(false,49,zero[..]);
    #assert !dp_batch_admits(false,49,one[0..<0]);
    eight:=[9]int.[20,20,20,20,20,20,20,20,20];#assert dp_batch_admits(false,49,eight[0..<8]) && !dp_batch_admits(false,49,eight[..]);
    last:=[1]int.[16];#assert dp_batch_admits(false,496,last[..]);
    over:=[1]int.[17];#assert !dp_batch_admits(false,496,over[..]);
    full:=[2]int.[256,256];#assert dp_batch_admits(false,1,full[..]);
    more:=[2]int.[256,257];#assert !dp_batch_admits(false,1,more[..]) && !dp_batch_admits(false,256,more[1..<2]) && dp_batch_admits(false,255,more[1..<2]) && dp_batch_admits(false,1,more[0..<1]);
    #assert dp_batch_tokens(five[..])==187 && dp_batch_longest(five[..])==39 && dp_batch_first(five[..],0)==0 && dp_batch_first(five[..],3)==111;
}
#test "a batch's workspace: one layout for every token, then each later question's norm row and logits" {
    five:=[5]int.[37,38,36,37,39];one:=[1]int.[37];m:=dp_model(0);
    r:=dp_batch_layout(m,49,five[..]);p:=dp_layout_of(m,187,49+39);
    #assert r.p.total==p.total && r.p.scores==p.scores && r.finals==p.total && r.logits==p.total+4*dp_align(4*4096) && r.total==r.logits+4*dp_align(4*248320);
    #assert dp_batch_final(r,m,0)==p.final && dp_batch_final(r,m,1)==r.finals && dp_batch_final(r,m,4)==r.finals+3*16384;
    #assert dp_batch_logits(0,49,five[..],0)==p.logits && dp_batch_logits(0,49,five[..],1)==r.logits && dp_batch_logits(0,49,five[..],3)==r.logits+2*993280;
    #assert dp_batch_workspace(0,49,five[..])==r.total && dp_batch_workspace(0,49,one[..])==dp_layout_keys(37,86).total;
    q:=dp_batch_layout(dp_model(1),49,five[..]);#assert q.total==q.logits+4*dp_align(4*248320) && q.logits==q.finals+4*dp_align(4*5120) && dp_batch_workspace(1,49,five[..])==q.total;
}
#test "a batch of one question is its suffix pass, launch for launch" {
    buf:[2500]DpOp;ops:=buf[..];stream:[DP_STREAMABLE]bool;all:=0;matrices:=0;
    for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));if dp_weight_bf16(i) {matrices+=dp_weight_bytes(i);}}
    one:=[1]int.[37];short:=[1]int.[8];
    budgets:=[2]int.[dp_workspace_bytes(256)+all,dp_workspace_bytes(256)+all-matrices+2*dp_align(2*4096*12288)];
    for budget:budgets {
        opened:=dp_plan(256,0,budget,stream[..],ops);#assert opened.status==DpStatus.ok;
        suffix:=dp_plan_suffix(49,37,opened,stream[..],ops);want:=dp_digest(ops,suffix.ops);
        batch:=dp_plan_batch(49,one[..],opened,stream[..],ops);
        #assert batch.status==DpStatus.ok && batch.ops==suffix.ops && dp_digest(ops,batch.ops)==want && batch.logits==suffix.logits && batch.rope==suffix.rope;
        s8:=dp_plan_suffix(49,8,opened,stream[..],ops);w8:=dp_digest(ops,s8.ops);
        b8:=dp_plan_batch(49,short[..],opened,stream[..],ops);#assert b8.ops==s8.ops && dp_digest(ops,b8.ops)==w8;
    }
}
#test "five questions in one pass: each makes its own suffix pass's stateful launches" {
    buf:[2500]DpOp;ops:=buf[..];other:[2500]DpOp;stream:[DP_STREAMABLE]bool;all:=0;matrices:=0;
    for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));if dp_weight_bf16(i) {matrices+=dp_weight_bytes(i);}}
    five:=[5]int.[37,38,36,37,39];
    opened:=dp_plan(256,0,dp_workspace_bytes(256)+all,stream[..],ops);
    batch:=dp_plan_batch(49,five[..],opened,stream[..],ops);
    #assert batch.status==DpStatus.ok && batch.logits==dp_batch_logits(0,49,five[..],0) && batch.rope==dp_layout_keys(187,88).rope;
    counts:[DP_KERNELS]int;for i:0..<batch.ops {counts[ops[i].kernel]+=1;}
    #assert counts[cast(int)DpKernel.conv_state]==24*5 && counts[cast(int)DpKernel.scan_state]==24*5 && counts[cast(int)DpKernel.prepare]==8*5 && counts[cast(int)DpKernel.attend]==8*5;
    #assert counts[cast(int)DpKernel.matvec]==5 && counts[cast(int)DpKernel.gates]==24 && counts[cast(int)DpKernel.swiglu]==32 && counts[cast(int)DpKernel.mma_project]==24*5+8*3+32*3+8*5;
    // Token-wise launches take all 187 tokens; the readout reads each question's last row.
    for i:0..<batch.ops {
        op:=ops[i];
        if op.kernel==cast(u8)DpKernel.gates {#assert op.items==187*32;}
        if op.kernel==cast(u8)DpKernel.conv_state {#assert op.args[2].count==op.args[1].value*8192;}
    }
    lastnorm:=0;for i:0..<batch.ops {if ops[i].kernel==cast(u8)DpKernel.scale && ops[i].items==4096 {lastnorm+=1;}}
    #assert lastnorm==5;
    // Question i's stateful launches are those of its own suffix pass.
    digests:[5]u64;for i:0..<5 {digests[i]=dp_state_digest(ops,batch.ops,5,i);}
    for i:0..<5 {
        suffix:=dp_plan_suffix(49,five[i],opened,stream[..],other[..]);
        #assert suffix.status==DpStatus.ok && dp_state_digest(other[..],suffix.ops,1,0)==digests[i];
    }
    #assert digests[0]!=digests[1] && digests[0]==digests[3];
    // Each question reads its own rows: the scan of question 3 starts at token 111.
    m:=dp_model(0);p:=dp_layout_keys(187,88);seen:=0;
    for i:0..<batch.ops {
        op:=ops[i];
        if op.kernel==cast(u8)DpKernel.scan_state {
            if seen==3 {#assert op.args[4].offset==p.conv+4*111*8192 && op.args[5].offset==p.qn+4*111*2048 && op.args[6].offset==p.kn+4*111*2048 && op.args[7].offset==p.beta+4*111*32 && op.args[8].offset==p.decay+4*111*32 && op.args[9].offset==p.draft+4*111*4096;}
            seen+=1;
        }
        if op.kernel==cast(u8)DpKernel.conv_state && seen==3 {#assert op.args[2].offset==p.qkv+4*111*8192 && op.args[4].offset==p.conv+4*111*8192;}
        if op.kernel==cast(u8)DpKernel.attend && op.args[0].value==49+37 && op.args[6].offset!=p.mix {#assert op.args[6].offset==p.mix+4*111*4096 && op.args[5].offset==p.qkv+4*111*8192;}
        if op.kernel==cast(u8)DpKernel.prepare && op.items==39*20 {#assert op.args[6].offset==p.rope+4*148*64 && op.args[7].offset==p.aq+4*148*4096 && op.args[3].offset==p.k+4*148*1024 && op.args[2].offset==p.qkv+4*148*8192;}
    }
    // The readout: question i's final row into its norm region, its logits into its own.
    r:=dp_batch_layout(m,49,five[..]);q:=0;rows:=0;
    for i:0..<batch.ops {
        op:=ops[i];
        if op.kernel==cast(u8)DpKernel.reduce && op.items==248320 {#assert op.args[3].offset==dp_batch_logit(r,m,q) && ops[i-1].args[3].offset==dp_batch_final(r,m,q);q+=1;}
        if op.kernel==cast(u8)DpKernel.squares && op.items==16 {#assert op.args[1].offset==p.x0+4*(dp_batch_first(five[..],rows)+five[rows]-1)*4096 && ops[i+1].args[5].offset==dp_batch_final(r,m,rows);rows+=1;}
    }
    #assert q==5 && rows==5;
    // Refusals.
    #assert dp_plan_batch(0,five[..],opened,stream[..],ops).status==DpStatus.shape;
    mixed:=[2]int.[37,8];#assert dp_plan_batch(49,mixed[..],opened,stream[..],ops).status==DpStatus.shape;
    metal:=opened;metal.metal=true;#assert dp_plan_batch(49,five[..],metal,stream[..],ops).status==DpStatus.shape;
    bad:=opened;bad.status=DpStatus.memory;#assert dp_plan_batch(49,five[..],bad,stream[..],ops).status==DpStatus.capacity;
    #assert dp_plan_batch(49,five[..],opened,stream[0..<10],ops).status==DpStatus.capacity;
    fewer:=opened;fewer.streamed_tensors=1;#assert dp_plan_batch(49,five[..],fewer,stream[..],ops).status==DpStatus.capacity;
    #assert dp_plan_batch(49,five[..],opened,stream[..],ops[0..<100]).status==DpStatus.capacity;
    tight:=opened;tight.workspace=dp_batch_workspace(0,49,five[..]);#assert dp_plan_batch(49,five[..],tight,stream[..],ops).status==DpStatus.ok;
    tight.workspace-=1;#assert dp_plan_batch(49,five[..],tight,stream[..],ops).status==DpStatus.capacity;
}
#test "a streamed batch computes what the resident batch computes, and holds a value slot across its questions" {
    buf:[3000]DpOp;ops:=buf[..];resident:[2000]DpOp;resolved:[2000]DpOp;stream:[DP_STREAMABLE]bool;all:=0;matrices:=0;
    for i:0..<DP_WEIGHTS {all+=dp_align(dp_weight_bytes(i));if dp_weight_bf16(i) {matrices+=dp_weight_bytes(i);}}
    five:=[5]int.[37,38,36,37,39];slot:=dp_align(2*4096*12288);w:=dp_workspace_bytes(256);
    opened:=dp_plan(256,0,w+all,stream[..],ops);
    base:=dp_plan_batch(49,five[..],opened,stream[..],resident[..]);
    readout:=0;while resident[readout].kernel!=cast(u8)DpKernel.matvec {readout+=1;}
    least:=dp_plan(256,0,w+all-matrices+2*slot,stream[..],ops);#assert least.streamed_tensors==269;
    batch:=dp_plan_batch(49,five[..],least,stream[..],ops);
    n:=dp_resolve(ops,batch.ops,resolved[..]);
    #assert batch.status==DpStatus.ok && n==base.ops+2*5*20 && dp_digest(resolved[..],readout)==dp_digest(resident[..],readout);
    // Every copy is used: 248 matrices and 21 head chunks, one wait and release each.
    waits:=0;copies:=0;releases:=0;held:=0;most:=0;
    for i:0..<batch.ops {
        op:=ops[i];
        if op.kind==DpOpKind.wait {waits+=1;held+=1;}
        if op.kind==DpOpKind.release {releases+=1;held-=1;}
        if op.kind==DpOpKind.copy {copies+=1;}
        if op.kernel==cast(u8)DpKernel.attend && op.kind==DpOpKind.launch {most=dp_wider(most,held);}
    }
    #assert waits==269 && copies==269 && releases==269 && most==1;
    // Each head chunk is read by all five questions before its slot is released.
    for i:0..<batch.ops {if ops[i].kind==DpOpKind.release && ops[i-1].kernel==cast(u8)DpKernel.matvec {#assert ops[i-1].args[3].offset==dp_batch_final(dp_batch_layout(dp_model(0),49,five[..]),dp_model(0),4);}}
}
#test "five Mammoth questions in one pass" {
    m:=dp_model(1);buf:[3600]DpOp;ops:=buf[..];other:[2600]DpOp;stream:[527]bool;all:=0;
    for i:0..<dp_weights(m) {all+=dp_align(dp_bytes(m,i));}
    five:=[5]int.[37,38,36,37,39];one:=[1]int.[37];
    opened:=dp_plan_model(1,false,256,0,dp_model_workspace_bytes(1,256)+all-100*dp_align(2*5120*17408),stream[..],ops);
    suffix:=dp_plan_suffix(49,37,opened,stream[..],ops);want:=dp_digest(ops,suffix.ops);
    single:=dp_plan_batch(49,one[..],opened,stream[..],ops);#assert single.ops==suffix.ops && dp_digest(ops,single.ops)==want;
    batch:=dp_plan_batch(49,five[..],opened,stream[..],ops);
    #assert batch.status==DpStatus.ok && batch.kind==1 && batch.logits==dp_batch_logits(1,49,five[..],0);
    for i:0..<5 {
        s:=dp_plan_suffix(49,five[i],opened,stream[..],other[..]);
        #assert dp_state_digest(other[..],s.ops,1,0)==dp_state_digest(ops,batch.ops,5,i);
    }
    copies:=0;for i:0..<batch.ops {if ops[i].kind==DpOpKind.copy {copies+=1;}}
    #assert copies==102;
}
