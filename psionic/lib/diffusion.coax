// Chapter 146: noise, diffusion and flow. A noise schedule (linear, cosine or
// any non-decreasing list of betas), the forward noising of a point, the exact
// posterior of a two-dimensional mixture of four Gaussians at any noise level,
// four training objectives (noise, data, diffusion velocity and flow
// velocity), an affine predictor per noise level and class trained by
// gradient descent, and four samplers: DDPM (stochastic), DDIM
// (deterministic), and Euler and Heun on the flow-matching ODE.
// Profile cpu-f64-diffusion-v1: binary64, one CPU core, plain sums in a fixed
// order; 2 dimensions, 4 classes, at most 1,000 diffusion steps (1,001 noise
// levels) and 4,096 training points a cell. Every normal draw comes from
// chapter 53's counter generator, so a seed names every sample.
#load "counter-rng.coax";

// book:begin types
DfStatus :: enum u8 {ok;steps;range;order;number;shape;class;objective;}
// What a model predicts from the noisy point x = alpha x0 + sigma eps: the
// noise eps, the data x0, the diffusion velocity alpha eps - sigma x0, or the
// flow velocity eps - x0.
DfObjective :: enum u8 {eps;x0;v;flow;}
DfSampler :: enum u8 {ddpm;ddim;euler;heun;}
// beta[t] and abar[t] for t = 1..steps; abar[0] = 1. abar[t] is the product
// of (1 - beta[s]) for s <= t.
DfSchedule :: struct {status:DfStatus;steps:int;beta:[DF_LEVELS_MAX]f64;abar:[DF_LEVELS_MAX]f64;}
// A model: noise level j has x = alpha[j] x0 + sigma[j] eps, and class c's
// predictor there is a x + b with (a, b0, b1) = w[12 j + 3 c ..]. levels = 0
// stands for the exact posterior of the target.
DfModel :: struct {status:DfStatus;objective:DfObjective;levels:int;alpha:[]f64;sigma:[]f64;w:[]f64;}
// What a predictor says about a noisy point: its noise, its data, and (for
// the exact posterior) the class it most likely came from, the first on ties.
DfPair :: struct {eps:[2]f64;x0:[2]f64;likely:int;}
DfSample :: struct {status:DfStatus;x:[2]f64;}
// Mean and per-coordinate variance of n points, how many are nearest each
// class mean, and the variance about the nearest class mean.
DfStats :: struct {status:DfStatus;n:int;mean:[2]f64;var:f64;count:[4]int;within:f64;}
// book:end types

// book:begin target
DF_LEVELS_MAX :: 1001;
DF_STEPS_MAX :: 1000;
DF_CELL_MAX :: 4096;            // training points for one level and class
DF_SPREAD :: 0.5;               // each class: N(mean, 0.5^2 I)
DF_MEAN :: [8]f64.[2,0, 0,2, -2,0, 0,-2];
DF_STRIDE :: 2002;              // normals reserved for one sample
DF_PI :: 3.141592653589793;
DF_CLIP :: 0.999;               // the cosine schedule's largest beta
DF_OFFSET :: 0.008;             // the cosine schedule's offset s
// book:end target

// Checks precede the implementation. Expected values are worked by hand in
// chapter 146, or come from an independent derivation written in the check.
df_near :: (a:f64,b:f64,tol:f64)->bool {return abs(a-b)<=tol;}
df_near2 :: (a:[2]f64,b:[2]f64,tol:f64)->bool {return df_near(a[0],b[0],tol) && df_near(a[1],b[1],tol);}
// The target's log density at a noise level, by its definition: the log of
// the average of the class densities (or one class's).
df_log_density :: (x:[2]f64,alpha:f64,sigma:f64,class:int)->f64 {
    v:=alpha*alpha*DF_SPREAD*DF_SPREAD+sigma*sigma;sum:=0.0;
    for c:0..<4 {
        if class<0 || class==c {
            d0:=x[0]-alpha*DF_MEAN[2*c];d1:=x[1]-alpha*DF_MEAN[2*c+1];
            sum+=exp(-(d0*d0+d1*d1)/(2*v))/(2*DF_PI*v);
        }
    }
    if class<0 {sum/=4;}
    return log(sum);
}

#test "the checks' own helpers" {
    #assert df_near2([2]f64.[1,2],[2]f64.[1.5,2.5],0.5) && !df_near2([2]f64.[1,2],[2]f64.[1,3],0.5) && !df_near2([2]f64.[1,2],[2]f64.[2,2],0.5);
    // The density by its definition: class 0 at its own mean is 1 / (2 pi v); the mixture at alpha 0 is one standard normal.
    #assert df_near(df_log_density([2]f64.[1.6,0],0.8,0.6,0),-log(2*DF_PI*0.52),1e-15);
    #assert df_near(df_log_density([2]f64.[0,0],0,1,-1),-log(2*DF_PI),1e-15) && df_near(df_log_density([2]f64.[1,0],0,1,2),-log(2*DF_PI)-0.5,1e-15);
}
#test "normal draws: Box-Muller on the counter generator, by hand" {
    // u1 = 0.8833108082136426, u2 = 0.43152799704850997 from cr_bits(0, 0) and cr_bits(0, 1).
    #assert df_normal(0,0)==sqrt(-2*log(1-0.8833108082136426))*cos(2*DF_PI*0.43152799704850997);
    #assert df_near(df_normal(0,0),-1.8839083333524405,1e-15) && df_near(df_normal(0,1),0.22760793546360525,1e-15);
    #assert df_normal(5,9)!=df_normal(6,9) && df_normal(5,9)==df_normal(5,9);
    p:=df_data(0,0,1);#assert p[0]==0.5*df_normal(0,0) && p[1]==2+0.5*df_normal(0,1);
    q:=df_data(3,2,3);#assert q[0]==0.5*df_normal(3,4) && q[1]==-2+0.5*df_normal(3,5);
    r:=df_data(3,2,2);#assert r[0]==-2+0.5*df_normal(3,4);
}
#test "schedules by hand" {
    s:=df_linear(4,0.1,0.4);
    #assert s.status==DfStatus.ok && s.steps==4 && s.abar[0]==1 && s.beta[0]==0;
    #assert s.beta[1]==0.1 && s.beta[2]==0.2 && s.beta[3]==0.1+(0.4-0.1)*2.0/3 && s.beta[4]==0.4;
    #assert s.abar[1]==0.9 && s.abar[2]==0.9*0.8 && s.abar[3]==0.9*0.8*(1-s.beta[3]) && s.abar[4]==s.abar[3]*0.6;
    #assert df_near(s.abar[4],0.3024,1e-15);
    one:=df_linear(1,0.3,0.3);#assert one.status==DfStatus.ok && one.beta[1]==0.3 && one.abar[1]==0.7;
    c:=df_cosine(4);
    #assert c.status==DfStatus.ok && df_near(c.abar[1],0.8470121613269047,1e-15) && df_near(c.abar[2],0.4938435904406378,1e-15);
    #assert df_near(c.beta[3],0.7078587123971634,1e-15) && df_near(c.beta[4],DF_CLIP,1e-15) && c.abar[4]==c.abar[3]*(1-c.beta[4]);
    f:=cos(DF_OFFSET/(1+DF_OFFSET)*DF_PI/2);g:=cos((0.25+DF_OFFSET)/(1+DF_OFFSET)*DF_PI/2);
    #assert df_near(c.abar[1],g*g/(f*f),1e-15);
    single:=df_cosine(1);#assert single.status==DfStatus.ok && df_near(single.beta[1],DF_CLIP,1e-15);
    #assert df_cap(0.5)==0.5 && df_near(df_cap(1),DF_CLIP,2e-16) && df_near(df_cap(3),DF_CLIP,2e-16) && df_near(df_cap(0.25),0.25,1e-16);
    big:=df_cosine(1000);#assert big.status==DfStatus.ok && df_near(big.abar[1000],2.4287669070348567e-09,1e-20);
    for t:1..<1000 {#assert big.beta[t+1]>=big.beta[t] && big.abar[t+1]<big.abar[t];}
    l:=df_linear(1000,0.0001,0.02);#assert l.status==DfStatus.ok && l.beta[1000]==0.02 && df_near(l.abar[1000],4.0358297653756754e-05,1e-18);
}
#test "schedules refuse bad step counts, betas out of range and decreasing betas" {
    #assert df_linear(0,0.1,0.2).status==DfStatus.steps && df_linear(1001,0.1,0.2).status==DfStatus.steps && df_linear(1000,0.1,0.2).status==DfStatus.ok;
    #assert df_cosine(0).status==DfStatus.steps && df_cosine(1001).status==DfStatus.steps;
    #assert df_linear(4,0,0.2).status==DfStatus.range && df_linear(4,0.1,1).status==DfStatus.range && df_linear(4,-0.1,0.2).status==DfStatus.range;
    #assert df_linear(4,0.3,0.2).status==DfStatus.order && df_linear(1,0.3,0.2).status==DfStatus.order;
    #assert df_linear(4,0.1,0.0/0.0).status==DfStatus.number && df_linear(4,1.0/0.0,0.2).status==DfStatus.number;
    b:=[3]f64.[0.1,0.2,0.2];#assert df_betas(b[..]).status==DfStatus.ok && df_betas(b[..]).abar[3]==0.9*0.8*0.8;
    b[1]=0.05;#assert df_betas(b[..]).status==DfStatus.order;
    b[1]=0.999999;b[2]=1;#assert df_betas(b[..]).status==DfStatus.range;
    b[2]=0.0/0.0;#assert df_betas(b[..]).status==DfStatus.number;
    #assert df_betas(b[0..<0]).status==DfStatus.steps && df_betas(b[0..<1]).status==DfStatus.ok;
    many:[1001]f64;for i:0..<1001 {many[i]=0.5;}
    #assert df_betas(many[..]).status==DfStatus.steps && df_betas(many[0..<1000]).status==DfStatus.ok;
    bad:=df_betas(b[..]);#assert bad.steps==0 && bad.abar[1]==0;
}
#test "the posterior by hand, and its noise is the score times -sigma" {
    // x0 = (2, 0) with eps = (1, -1) at alpha 0.8, sigma 0.6 gives x = (2.2, -0.6).
    x:=df_noise([2]f64.[2,0],[2]f64.[1,-1],0.8,0.6);#assert df_near2(x,[2]f64.[2.2,-0.6],1e-15);
    // Class 0: V = 0.64 * 0.25 + 0.36 = 0.52, x - alpha mu = (0.6, -0.6).
    p:=df_posterior(x,0.8,0.6,0);
    #assert df_near2(p.eps,[2]f64.[0.6/0.52*0.6,-0.6/0.52*0.6],1e-15) && df_near2(p.x0,[2]f64.[2+0.2/0.52*0.6,-0.2/0.52*0.6],1e-15) && p.likely==0;
    m:=df_posterior(x,0.8,0.6,-1);
    #assert df_near2(m.eps,[2]f64.[0.7059792014299524,-0.6793054590423947],1e-14) && df_near2(m.x0,[2]f64.[2.2205155989275354,-0.2405209057182038],1e-14) && m.likely==0;
    // Both answers put x back together: alpha x0 + sigma eps = x.
    #assert df_near2(df_noise(m.x0,m.eps,0.8,0.6),x,1e-15) && df_near2(df_noise(p.x0,p.eps,0.8,0.6),x,1e-15);
    // Far from every class the weights still sum to one (no overflow).
    far:=df_posterior([2]f64.[40,-30],0.8,0.6,-1);#assert df_near2(df_noise(far.x0,far.eps,0.8,0.6),[2]f64.[40,-30],1e-12) && far.likely==0;
    far=df_posterior([2]f64.[-30,40],0.8,0.6,-1);#assert df_near2(df_noise(far.x0,far.eps,0.8,0.6),[2]f64.[-30,40],1e-12) && far.likely==1;
    far=df_posterior([2]f64.[-40,-30],0.3,0.6,-1);#assert df_near2(df_noise(far.x0,far.eps,0.3,0.6),[2]f64.[-40,-30],1e-12) && far.likely==2;
    #assert df_posterior([2]f64.[1,-40],0.3,0.6,-1).likely==3 && df_posterior([2]f64.[1,-40],0.3,0.6,1).likely==1;
    // At the origin every class is equally likely: the first wins, and the guesses cancel.
    o:=df_posterior([2]f64.[0,0],0.8,0.6,-1);#assert o.likely==0 && df_near2(o.x0,[2]f64.[0,0],1e-15) && df_near2(o.eps,[2]f64.[0,0],1e-15);
    // At sigma 0 the point is the data; at alpha 0 it is the noise.
    d:=df_posterior([2]f64.[1,2],1,0,2);#assert d.eps[0]==0 && d.eps[1]==0 && d.x0[0]==1 && d.x0[1]==2;
    n:=df_posterior([2]f64.[1,2],0,1,-1);#assert n.eps[0]==1 && n.eps[1]==2 && n.x0[0]==0 && n.x0[1]==0;
    n=df_posterior([2]f64.[1,2],0,1,3);#assert n.x0[0]==0 && n.x0[1]==-2;
}
#forall "the posterior noise is -sigma times the gradient of the log density" k:0..<15 {
    x:=[2]f64.[f64(k%5)-2.1,f64(k/5)*1.3-1.7];alpha:=0.3+0.04*f64(k);sigma:=sqrt(1-alpha*alpha);h:=1e-5;
    for class:-1..<4 {
        e:=df_posterior(x,alpha,sigma,class).eps;
        g0:=(df_log_density([2]f64.[x[0]+h,x[1]],alpha,sigma,class)-df_log_density([2]f64.[x[0]-h,x[1]],alpha,sigma,class))/(2*h);
        g1:=(df_log_density([2]f64.[x[0],x[1]+h],alpha,sigma,class)-df_log_density([2]f64.[x[0],x[1]-h],alpha,sigma,class))/(2*h);
        #assert df_near(e[0],-sigma*g0,1e-8) && df_near(e[1],-sigma*g1,1e-8);
    }
}
#test "four objectives on fixed inputs: one prediction, four losses" {
    x0:=[2]f64.[2,0];eps:=[2]f64.[1,-1];x:=df_noise(x0,eps,0.8,0.6);
    #assert df_target(DfObjective.eps,x0,eps,0.8,0.6)[1]==-1 && df_target(DfObjective.x0,x0,eps,0.8,0.6)[0]==2;
    #assert df_near2(df_target(DfObjective.v,x0,eps,0.8,0.6),[2]f64.[-0.4,-0.8],1e-15) && df_target(DfObjective.flow,x0,eps,0.8,0.6)[0]==-1 && df_target(DfObjective.flow,x0,eps,0.8,0.6)[1]==-1;
    // A noise guess (0.5, -0.5) misses by 0.5 a coordinate: loss 0.5.
    guess:=[2]f64.[0.5,-0.5];#assert df_loss(DfObjective.eps,guess,x0,eps,0.8,0.6)==0.5;
    // The same guess as data: x0 = (x - 0.6 guess) / 0.8 = (2.375, -0.375); loss (0.6/0.8)^2 * 0.5.
    as_x0:=df_restate(DfObjective.eps,DfObjective.x0,guess,x,0.8,0.6);#assert df_near2(as_x0,[2]f64.[2.375,-0.375],1e-15);
    #assert df_near(df_loss(DfObjective.x0,as_x0,x0,eps,0.8,0.6),0.28125,1e-15);
    // As diffusion velocity: (guess - sigma x) / alpha = (-1.025, -0.175); loss 0.5 / 0.64.
    as_v:=df_restate(DfObjective.eps,DfObjective.v,guess,x,0.8,0.6);#assert df_near2(as_v,[2]f64.[-1.025,-0.175],1e-15);
    #assert df_near(df_loss(DfObjective.v,as_v,x0,eps,0.8,0.6),0.78125,1e-15);
    // As flow velocity: guess - x0 guess; loss (1 + 0.6/0.8)^2 * 0.5.
    as_f:=df_restate(DfObjective.eps,DfObjective.flow,guess,x,0.8,0.6);#assert df_near2(as_f,[2]f64.[0.5-2.375,-0.5+0.375],1e-15);
    #assert df_near(df_loss(DfObjective.flow,as_f,x0,eps,0.8,0.6),1.53125,1e-15);
    // Every restatement goes back to the same noise guess.
    for o:[4]DfObjective.[DfObjective.eps,DfObjective.x0,DfObjective.v,DfObjective.flow] {
        there:=df_restate(DfObjective.eps,o,guess,x,0.8,0.6);#assert df_near2(df_restate(o,DfObjective.eps,there,x,0.8,0.6),guess,1e-14);
        #assert df_near2(df_restate(o,DfObjective.x0,there,x,0.8,0.6),as_x0,1e-14);
    }
    // On the flow path (alpha + sigma = 1, not a unit circle) at t = 0.25.
    y:=df_noise(x0,eps,0.75,0.25);u:=df_target(DfObjective.flow,x0,eps,0.75,0.25);
    #assert df_near2(df_restate(DfObjective.flow,DfObjective.eps,u,y,0.75,0.25),eps,1e-15) && df_near2(df_restate(DfObjective.flow,DfObjective.x0,u,y,0.75,0.25),x0,1e-15);
    w:=df_target(DfObjective.v,x0,eps,0.75,0.25);
    #assert df_near2(df_restate(DfObjective.v,DfObjective.eps,w,y,0.75,0.25),eps,1e-15) && df_near2(df_restate(DfObjective.v,DfObjective.x0,w,y,0.75,0.25),x0,1e-15);
}
#test "least squares by hand, and gradient descent reaches it" {
    // Points (1, 0), (0, 1), (-1, -1) with targets (1, 1), (0, 0), (2, -1).
    xs:=[6]f64.[1,0, 0,1, -1,-1];ys:=[6]f64.[1,1, 0,0, 2,-1];
    // Sum x = 0, so b = mean y = (1, 0); a = sum x.y / sum |x|^2 = (1 + 0 - 1) / 4 = 0.
    w:=df_fit(xs[..],ys[..]);#assert w[0]==0 && w[1]==1 && w[2]==0;
    ys[0]=3;w=df_fit(xs[..],ys[..]);#assert w[0]==0.5 && w[1]==5.0/3 && w[2]==0;
    // From zero the gradient is -(2/3) (sum x.y, sum y) = -(2/3) (2, 5, 0).
    g:=df_gradient(xs[..],ys[..],[3]f64.[0,0,0]);
    #assert df_near(g[0],-2.0/3*2,1e-15) && df_near(g[1],-2.0/3*5,1e-15) && df_near(g[2],0,1e-15);
    h:=1e-6;base:=df_mse(xs[..],ys[..],[3]f64.[0.2,0.1,-0.3]);g=df_gradient(xs[..],ys[..],[3]f64.[0.2,0.1,-0.3]);
    #assert df_near(g[0],(df_mse(xs[..],ys[..],[3]f64.[0.2+h,0.1,-0.3])-df_mse(xs[..],ys[..],[3]f64.[0.2-h,0.1,-0.3]))/(2*h),1e-8);
    #assert df_near(g[1],(df_mse(xs[..],ys[..],[3]f64.[0.2,0.1+h,-0.3])-df_mse(xs[..],ys[..],[3]f64.[0.2,0.1-h,-0.3]))/(2*h),1e-8);
    #assert df_near(g[2],(df_mse(xs[..],ys[..],[3]f64.[0.2,0.1,-0.3+h])-df_mse(xs[..],ys[..],[3]f64.[0.2,0.1,-0.3-h]))/(2*h),1e-8);
    #assert df_near(base,((0.2+0.1-3)*(0.2+0.1-3)+(-0.3-1)*(-0.3-1)+0.1*0.1+(0.2-0.3)*(0.2-0.3)+(-0.2+0.1-2)*(-0.2+0.1-2)+(-0.2-0.3+1)*(-0.2-0.3+1))/3,1e-15);
    d:=df_descend(xs[..],ys[..],300,0.2);#assert df_near(d[0],0.5,1e-12) && df_near(d[1],5.0/3,1e-12) && df_near(d[2],0,1e-12);
    one:=df_descend(xs[..],ys[..],1,0.2);#assert df_near(one[0],0.2*4.0/3,1e-15) && df_near(one[1],0.2*10.0/3,1e-15) && one[2]==0;
    flat:=[6]f64.[1,1, 1,1, 1,1];#assert df_fit(flat[..],ys[..])[0]==0;
    // The first two points only: a = (3 + 0) / 2 ... from the centred sums: x mean (0.5, 0.5).
    two:=df_fit(xs[0..<4],ys[0..<4]);#assert df_near(two[0],1,1e-15) && df_near(two[1],1,1e-15) && df_near(two[2],0,1e-15);
}
#test "a trained cell is the least-squares answer" {
    xs:[64]f64;ys:[64]f64;
    df_cell(11,7,2,DfObjective.eps,0.8,0.6,xs[..],ys[..]);
    exact:=df_fit(xs[..],ys[..]);d:=df_descend(xs[..],ys[..],DF_ITERATIONS,DF_RATE);
    for i:0..<3 {#assert df_near(d[i],exact[i],1e-9);}
    // The cell's points: x = 0.8 x0 + 0.6 eps, from normals 4q .. 4q+3 with q = (7 * 4 + 2) * 32.
    q:=cast(u64)((7*4+2)*32);x0:=df_data(11,2*q,2);
    #assert xs[0]==0.8*x0[0]+0.6*df_normal(11,4*q+2) && xs[1]==0.8*x0[1]+0.6*df_normal(11,4*q+3) && ys[1]==df_normal(11,4*q+3);
    #assert xs[63]==0.8*df_data(11,2*(q+31),2)[1]+0.6*df_normal(11,4*(q+31)+3);
}
#test "each objective's least-squares answer is the same predictor, near the population optimum" {
    xs:[8192]f64;ys:[8192]f64;
    df_cell(4,3,1,DfObjective.eps,0.8,0.6,xs[..],ys[..]);e:=df_fit(xs[..],ys[..]);
    best:=df_optimal(DfObjective.eps,0.8,0.6,1);
    #assert df_near(e[0],best[0],0.04) && df_near(e[1],best[1],0.04) && df_near(e[2],best[2],0.06);
    for o:[3]DfObjective.[DfObjective.x0,DfObjective.v,DfObjective.flow] {
        df_cell(4,3,1,o,0.8,0.6,xs[..],ys[..]);w:=df_fit(xs[..],ys[..]);
        for k:0..<3 {
            x:=[2]f64.[f64(k)-0.4,0.7*f64(k)+1];
            mine:=[2]f64.[w[0]*x[0]+w[1],w[0]*x[1]+w[2]];eps:=[2]f64.[e[0]*x[0]+e[1],e[0]*x[1]+e[2]];
            #assert df_near2(df_restate(o,DfObjective.eps,mine,x,0.8,0.6),eps,1e-12);
        }
    }
}
#test "the four objectives' optima are one predictor, the exact posterior" {
    for o:[4]DfObjective.[DfObjective.eps,DfObjective.x0,DfObjective.v,DfObjective.flow] {for c:0..<4 {
        w:=df_optimal(o,0.8,0.6,c);
        for k:0..<3 {
            x:=[2]f64.[f64(k)-0.4,0.7*f64(k)];mine:=[2]f64.[w[0]*x[0]+w[1],w[0]*x[1]+w[2]];p:=df_posterior(x,0.8,0.6,c);
            #assert df_near2(df_restate(o,DfObjective.eps,mine,x,0.8,0.6),p.eps,1e-14) && df_near2(df_restate(o,DfObjective.x0,mine,x,0.8,0.6),p.x0,1e-14);
        }
    }}
}
#test "models: levels from a schedule or the flow grid, and their refusals" {
    s:=df_linear(4,0.1,0.4);al:[5]f64;sg:[5]f64;w:[60]f64;
    m:=df_vp_model(s,DfObjective.eps,al[..],sg[..],w[..]);
    #assert m.status==DfStatus.ok && m.levels==5 && al[0]==1 && sg[0]==0 && al[4]==sqrt(s.abar[4]) && sg[4]==sqrt(1-s.abar[4]);
    #assert m.alpha.count==5 && m.sigma.count==5 && m.w.count==60 && df_trained(m) && !df_trained(DfModel.{});
    #assert df_vp_model(s,DfObjective.flow,al[..],sg[..],w[..]).status==DfStatus.objective;
    #assert df_vp_model(s,DfObjective.eps,al[0..<4],sg[..],w[..]).status==DfStatus.shape && df_vp_model(s,DfObjective.eps,al[..],sg[0..<4],w[..]).status==DfStatus.shape;
    #assert df_vp_model(s,DfObjective.eps,al[..],sg[..],w[0..<59]).status==DfStatus.shape;
    #assert df_vp_model(df_linear(0,0.1,0.2),DfObjective.eps,al[..],sg[..],w[..]).status==DfStatus.steps;
    for i:0..<5 {al[i]=7;sg[i]=7;}
    f:=df_flow_model(4,al[..],sg[..],w[..]);
    #assert f.status==DfStatus.ok && f.objective==DfObjective.flow && f.levels==5 && al[0]==1 && sg[0]==0 && al[1]==0.75 && sg[1]==0.25 && al[4]==0 && sg[4]==1;
    #assert f.alpha.count==5 && f.sigma.count==5 && f.w.count==60;
    #assert df_flow_model(0,al[..],sg[..],w[..]).status==DfStatus.steps && df_flow_model(5,al[..],sg[..],w[..]).status==DfStatus.shape;
    #assert df_flow_model(4,al[..],sg[0..<4],w[..]).status==DfStatus.shape && df_flow_model(4,al[..],sg[..],w[0..<59]).status==DfStatus.shape;
    #assert df_flow_model(1,al[..],sg[..],w[..]).status==DfStatus.ok && al[1]==0 && sg[1]==1;
    big:[1001]f64;bw:[12012]f64;
    #assert df_flow_model(1000,big[..],big[..],bw[..]).status==DfStatus.ok && df_flow_model(1001,big[..],big[..],bw[..]).status==DfStatus.steps;
    for i:0..<60 {w[i]=7;}
    df_fill_optimal(m);
    for j:0..<5 {for c:0..<4 {b:=df_optimal(DfObjective.eps,m.alpha[j],m.sigma[j],c);for i:0..<3 {#assert w[12*j+3*c+i]==b[i];}}}
    for c:0..<4 {
        p:=df_pair(m,3,9,9,c,[2]f64.[0.3,0.4]);q:=df_posterior([2]f64.[0.3,0.4],m.alpha[3],m.sigma[3],c);
        #assert df_near2(p.eps,q.eps,1e-14) && df_near2(p.x0,q.x0,1e-14);
    }
    e:=df_pair(DfModel.{},3,0.8,0.6,-1,[2]f64.[0.3,0.4]);r:=df_posterior([2]f64.[0.3,0.4],0.8,0.6,-1);
    #assert e.eps[0]==r.eps[0] && e.eps[1]==r.eps[1] && e.x0[0]==r.x0[0] && e.x0[1]==r.x0[1];
}
#test "training: every cell, and its refusals" {
    s:=df_linear(2,0.2,0.5);al:[3]f64;sg:[3]f64;w:[36]f64;scratch:[128]f64;
    m:=df_vp_model(s,DfObjective.x0,al[..],sg[..],w[..]);
    #assert df_train(m,5,6,4,0.15,scratch[..])==DfStatus.ok;
    xs:[12]f64;ys:[12]f64;
    for j:0..<3 {for c:0..<4 {
        df_cell(5,j,c,DfObjective.x0,al[j],sg[j],xs[..],ys[..]);e:=df_descend(xs[..],ys[..],4,0.15);
        for i:0..<3 {#assert w[12*j+3*c+i]==e[i];}
    }}
    #assert df_train(m,5,1,1,0.1,scratch[..])==DfStatus.shape && df_train(m,5,33,1,0.1,scratch[..])==DfStatus.shape && df_train(m,5,32,1,0.1,scratch[..])==DfStatus.ok;
    #assert df_train(m,5,2,0,0.1,scratch[..])==DfStatus.steps && df_train(m,5,2,1,0,scratch[..])==DfStatus.range && df_train(m,5,2,1,0.15,scratch[..])==DfStatus.ok && df_train(m,5,2,1,0.1500001,scratch[..])==DfStatus.range;
    #assert df_train(m,5,2,1,0.0/0.0,scratch[..])==DfStatus.range && df_train(m,5,2,1,-0.1,scratch[..])==DfStatus.range;
    bad:=m;bad.status=DfStatus.steps;#assert df_train(bad,5,2,1,0.1,scratch[..])==DfStatus.shape;
    #assert df_train(DfModel.{},5,2,1,0.1,scratch[..])==DfStatus.shape;
    // One level is enough, and 4,096 points a cell is the most.
    la:=[1]f64.[0.8];ls:=[1]f64.[0.6];lw:[12]f64;one:=DfModel.{levels=1,alpha=la[..],sigma=ls[..],w=lw[..]};
    big:[16388]f64;
    #assert df_train(one,5,4096,1,0.1,big[..])==DfStatus.ok && df_train(one,5,4097,1,0.1,big[..])==DfStatus.shape && lw[0]!=0;
}
#test "a DDPM step and a DDIM jump by hand" {
    s:=df_linear(4,0.1,0.4);x:=[2]f64.[0.5,-1];
    // At t = 4, abar 0.3024: the exact class-0 noise, the mean step, and the posterior variance.
    e:=df_posterior(x,sqrt(0.3024),sqrt(0.6976),0).eps;
    #assert df_near2(e,[2]f64.[-0.6479343518773082,-1.080217952292866],1e-14);
    st:=df_ddpm_step(s,4,x,e,[2]f64.[0,0]);#assert df_near2(st,[2]f64.[1.0460983229586969,-0.6231235492346127],1e-14);
    z:=df_ddpm_step(s,4,x,e,[2]f64.[1,-2]);v:=(1-0.504)/(1-0.3024)*0.4;
    #assert df_near(v,0.28440366972477066,1e-15) && df_near2(z,[2]f64.[st[0]+sqrt(v),st[1]-2*sqrt(v)],1e-14);
    // At t = 2 the spread is sqrt((1 - 0.9) / (1 - 0.72) * 0.2).
    two:=df_ddpm_step(s,2,x,e,[2]f64.[1,0]);m:=df_ddpm_step(s,2,x,e,[2]f64.[0,0]);
    #assert df_near(two[0]-m[0],sqrt(0.1/0.28*0.2),1e-15) && two[1]==m[1] && df_near(m[0],(0.5-0.2/sqrt(0.28)*e[0])/sqrt(0.8),1e-15);
    // The last step adds no noise.
    last:=df_ddpm_step(s,1,x,e,[2]f64.[1,1]);#assert df_near2(last,[2]f64.[(0.5-0.1/sqrt(0.1)*e[0])/sqrt(0.9),(-1-0.1/sqrt(0.1)*e[1])/sqrt(0.9)],1e-15);
    // DDIM from t = 4 to t = 2: the data guess, then renoised to abar 0.72 with the same noise.
    j:=df_ddim_step(s,4,2,x,e);#assert df_near2(j,[2]f64.[1.2637065726954102,-0.7224684515173326],1e-14);
    h:=df_ddim_step(s,4,0,x,e);#assert df_near2(h,[2]f64.[1.8933505372792778,-0.1778029886816801],1e-14);
}
#test "an Euler and a Heun flow step by hand" {
    // Class 1 at t = 1 from z = (0.4, -0.2): x0 guess is the class mean (0, 2), velocity z - mean.
    m:=DfModel.{};z:=[2]f64.[0.4,-0.2];
    u:=df_velocity(m,0,1,1.0,z);#assert df_near2(u,[2]f64.[0.4,-2.2],1e-15);
    e:=df_flow_step(m,1,2,2,z,false);#assert df_near2(e,[2]f64.[0.2,0.9],1e-15);
    // At t = 0.5 the velocity is (0.24, -2.12); Heun averages it with (0.4, -2.2).
    #assert df_near2(df_velocity(m,0,1,0.5,e),[2]f64.[0.24,-2.12],1e-15);
    h:=df_flow_step(m,1,2,2,z,true);#assert df_near2(h,[2]f64.[0.24,0.88],1e-15);
}
#test "a flow model set to its optimum follows the exact flow" {
    al:[9]f64;sg:[9]f64;w:[108]f64;f:=df_flow_model(8,al[..],sg[..],w[..]);df_fill_optimal(f);
    z:=[2]f64.[0.7,-1.1];
    for c:0..<4 {for steps:[3]int.[2,4,8] {for heun:[2]bool.[false,true] {
        #assert df_near2(df_flow_solve(f,c,steps,heun,z),df_flow_solve(DfModel.{},c,steps,heun,z),1e-13);
    }}}
}
#test "Euler is first order and Heun second on the exact Gaussian flow" {
    // For one class the flow is solved in closed form: x(0) = mean + 0.5 z.
    m:=DfModel.{};z:=[2]f64.[df_normal(3,0),df_normal(3,1)];want:=[2]f64.[0.5*z[0],2+0.5*z[1]];
    err:[2][4]f64;
    for k:0..<4 {
        steps:=8<<k;
        for heun:0..<2 {
            x:=df_flow_solve(m,1,steps,heun==1,z);err[heun][k]=sqrt((x[0]-want[0])*(x[0]-want[0])+(x[1]-want[1])*(x[1]-want[1]));
        }
    }
    #assert err[1][3]<err[0][3]/100;
    #assert err[0][2]/err[0][3]>1.9 && err[0][2]/err[0][3]<2.1 && err[1][2]/err[1][3]>3.5 && err[1][2]/err[1][3]<4.1;
    #assert err[0][1]/err[0][2]>1.85 && err[1][1]/err[1][2]>3;
}
