// Chapter 217: how far apart may two honest answers be? Two machines answer
// the same fresh items; their answers are compared in centred log space; the
// distances between honest pairs and between cheap substitutes set the limits
// of a checker's round, and a round checks a subset drawn only after the
// answers arrive.
// Profile cpu-f64-distance-v1: binary64, plain sums in a fixed order, up to
// 1,024 items of 2 to 8 options, 64 checked items a round and 100,000
// simulated rounds.
#load "suite.coax";
#load "tabular.coax";
#authority;

DdStatus :: enum u8 {ok;shape;capacity;number;}
DdVerdict :: enum u8 {pass;lost;strike;}
// kind: 0 choice, 1 yes or no, 2 score.
DdItem :: struct {kind:u8;options:int;favourite:int;}
// How a backend's logits differ from the reference's: mixed with its own
// (mix 1 keeps the reference's), truncated to a grid toward zero, jittered by
// up to noise, and on a share of items shifted by up to shift.
DdBackend :: struct {seed:u64;mix:f64;grid:f64;noise:f64;share:f64;shift:f64;}
DdDistance :: struct {d:f64;option:int;floored:int;}
DdCompare :: struct {status:DdStatus;agree:int;floored:int;}
DdSummary :: struct {status:DdStatus;median:f64;p90:f64;p99:f64;max:f64;}
DdLimits :: struct {lost:f64;strike:f64;item:f64;}
DdCheck :: struct {verdict:DdVerdict;mean:f64;worst:f64;}
DdRounds :: struct {status:DdStatus;pass:int;lost:int;strike:int;worst:f64;worst_at:int;}
DdRound :: struct {status:DdStatus;verdict:DdVerdict;mean:f64;worst:f64;seed:u64;}

DD_OPTIONS :: 8;
DD_ITEMS_MAX :: 1024;
DD_VERIFIED_MAX :: 64;
DD_ROUNDS_MAX :: 100000;
DD_FLOOR :: 1.0e-6;
DD_BIG :: 1.0e300;
DD_PARAM_MAX :: 10.0;
DD_NONE :: DdLimits.{lost=DD_BIG,strike=DD_BIG,item=DD_BIG};

// Checks precede the implementation. Pinned values come from
// psionic/tests/distance_oracle.py --tests; the rest are worked by hand.
DD_TEST_QUANTIZED :: DdBackend.{seed=4,mix=1,grid=0.25};
DD_TEST_OTHER :: DdBackend.{seed=5,mix=1,noise=0.002,share=0.5,shift=0.4};

#test "items, and the reference's answers" {
    its:[7]DdItem;its[6].options=5;
    #assert dd_items(5,its[0..<6])==DdStatus.ok && its[6].options==5;
    want:=[18]int.[1,2,0, 0,4,3, 1,2,0, 2,4,3, 2,4,0, 0,8,1];
    for i:0..<6 {#assert cast(int)its[i].kind==want[3*i] && its[i].options==want[3*i+1] && its[i].favourite==want[3*i+2];}
    #assert dd_items(5,its[0..<0])==DdStatus.shape && dd_items(5,its[0..<1])==DdStatus.ok;
    big:[1025]DdItem;#assert dd_items(5,big[0..<1024])==DdStatus.ok && dd_items(5,big[..])==DdStatus.shape;
    a:[57]f64;a[56]=7;
    #assert dd_answer(5,its[0..<6],DdBackend.{seed=1,mix=1},a[..])==DdStatus.ok && a[56]==7;
    #assert a[0]==0.8915340623415284 && a[1]==0.10846593765847148 && a[2]==0 && a[7]==0;
    #assert dd_answer(5,its[0..<0],DdBackend.{seed=1,mix=1},a[..])==DdStatus.shape && dd_answer(5,its[0..<1],DdBackend.{seed=1,mix=1},a[..])==DdStatus.ok;
    many:[1025]DdItem;for i:0..<1025 {many[i]=its[i%6];}wide:[8200]f64;
    #assert dd_answer(5,many[0..<1024],DdBackend.{seed=1,mix=1},wide[..])==DdStatus.ok && dd_answer(5,many[..],DdBackend.{seed=1,mix=1},wide[..])==DdStatus.shape;
    left:=[8]f64.[9,9,9,9,9,9,9,9];#assert dd_answer(5,its[0..<1],DdBackend.{seed=1,mix=1},left[..])==DdStatus.ok && left[2]==9 && left[7]==9;
    #assert dd_answer(5,its[0..<6],DD_TEST_QUANTIZED,a[..])==DdStatus.ok && a[0]==0.8519528019683106 && a[1]==0.1480471980316895;
    #assert dd_answer(5,its[0..<6],DdBackend.{seed=6,mix=0.6},a[..])==DdStatus.ok && a[0]==0.8498608048327955 && a[9]==0.4492167229721859;
    #assert dd_answer(5,its[0..<6],DdBackend.{seed=2,mix=1,noise=0.0005},a[..])==DdStatus.ok && a[9]==0.2244433619773678;
    #assert dd_answer(5,its[0..<6],DD_TEST_OTHER,a[..])==DdStatus.ok && a[24]==0.18084336025800155 && a[27]==0.3454396637429217;
    #assert dd_answer(5,its[0..<6],DdBackend.{seed=1,mix=1},a[0..<47])==DdStatus.capacity;
}

#test "a backend and its items are refused out of bounds" {
    its:[6]DdItem;#assert dd_items(5,its[..])==DdStatus.ok;a:[48]f64;
    edge:=DdBackend.{mix=1,grid=10,noise=10,share=1,shift=10};#assert dd_answer(5,its[..],edge,a[..])==DdStatus.ok;
    #assert dd_answer(5,its[..],DdBackend.{},a[..])==DdStatus.ok;
    bad:=[10]DdBackend.[DdBackend.{mix=-0.1},DdBackend.{mix=1.1},DdBackend.{grid=-1},DdBackend.{grid=10.5},DdBackend.{noise=-1},
        DdBackend.{noise=10.5},DdBackend.{share=-0.1},DdBackend.{share=1.1},DdBackend.{shift=-1},DdBackend.{shift=10.5}];
    for b:bad {#assert dd_answer(5,its[..],b,a[..])==DdStatus.shape;}
    nan:=DdBackend.{mix=0.0/0.0};#assert dd_answer(5,its[..],nan,a[..])==DdStatus.shape;
    for k:0..<4 {
        x:=its;
        if k==0 {x[2].options=1;} if k==1 {x[2].options=9;} if k==2 {x[2].favourite=-1;} if k==3 {x[2].favourite=2;}
        #assert dd_answer(5,x[..],DdBackend.{},a[..])==DdStatus.shape;
    }
    x:=its;x[5].options=8;x[5].favourite=7;#assert dd_answer(5,x[..],DdBackend.{},a[..])==DdStatus.ok;
    x[0].options=2;x[0].favourite=1;#assert dd_answer(5,x[..],DdBackend.{},a[..])==DdStatus.ok;
}

#test "the distance by hand" {
    // Centred, [0.5, 0.5] is [0, 0] and [0.8, 0.2] is ±(ln 0.8 - ln 0.2)/2:
    // both options are as far apart, and the first is named.
    p:=[2]f64.[0.5,0.5];q:=[2]f64.[0.8,0.2];
    d:=dd_distance(p[..],q[..]);#assert d.d==abs(log(0.8)-(log(0.8)+log(0.2))/2) && d.option==0 && d.floored==0;
    #assert dd_distance(q[..],q[..]).d==0;
    // [0.5, 0.25, 0.25] against [0.25, 0.25, 0.5]: ln 2 at options 0 and 2,
    // 0 at 1; rounding leaves option 2 larger by 4e-16. Against
    // [0.25, 0.5, 0.25] options 0 and 1 tie exactly, and the first is named.
    a:=[3]f64.[0.5,0.25,0.25];b:=[3]f64.[0.25,0.25,0.5];
    d=dd_distance(a[..],b[..]);#assert d.option==2 && abs(d.d-log(2.0))<1.0e-15;
    c:=[3]f64.[0.25,0.5,0.25];d=dd_distance(a[..],c[..]);#assert d.option==0 && d.d==0.6931471805599453;
    lead:=[3]f64.[0.6,0.2,0.2];rest:=[3]f64.[0.2,0.4,0.4];d=dd_distance(lead[..],rest[..]);#assert d.option==0 && d.d>1;
    // The floor: exactly 10^-6 is not floored; below it is, and counts.
    at:=[2]f64.[1.0e-6,1-1.0e-6];zero:=[2]f64.[0,1];tiny:=[2]f64.[1.0e-9,1];
    #assert dd_distance(at[..],at[..]).floored==0 && dd_distance(zero[..],at[..]).floored==1 && dd_distance(zero[..],tiny[..]).floored==2;
    #assert dd_distance(at[..],zero[..]).floored==1 && dd_distance(zero[..],zero[..]).d==0;
    #assert dd_distance(zero[..],at[..]).d==dd_distance(at[..],at[..]).d+abs(log(1.0)-log(1-1.0e-6))/2*2 || dd_distance(zero[..],at[..]).d<1.0e-6;
    #assert dd_top(a[..])==0 && dd_top(b[..])==2 && dd_top(c[..])==1;
    tie:=[3]f64.[0.4,0.4,0.2];#assert dd_top(tie[..])==0;
    late:=[3]f64.[0.2,0.4,0.4];#assert dd_top(late[..])==1;
}

#test "two backends compared, against the oracle" {
    its:[6]DdItem;#assert dd_items(5,its[..])==DdStatus.ok;
    r:[48]f64;q:[48]f64;o:[48]f64;
    #assert dd_answer(5,its[..],DdBackend.{seed=1,mix=1},r[..])==DdStatus.ok && dd_answer(5,its[..],DD_TEST_QUANTIZED,q[..])==DdStatus.ok;
    #assert dd_answer(5,its[..],DD_TEST_OTHER,o[..])==DdStatus.ok;
    d:[7]f64;d[6]=9;
    c:=dd_compare(its[..],r[..],q[..],d[..]);#assert c.status==DdStatus.ok && c.agree==5 && c.floored==0 && d[6]==9;
    want:=[6]f64.[0.17825372970597142,0.17832555586454601,0.04966498576296818,0.0972925136469518,0.07111157135932777,0.23131940899358616];
    for w,i:want {#assert d[i]==w;}
    c=dd_compare(its[..],r[..],o[..],d[0..<6]);#assert c.status==DdStatus.ok && c.agree==6;
    other:=[6]f64.[0.09725183255496295,0.0008714306162718177,0.0006307382117671789,0.18359215853349453,0.20862411514520662,0.3638073170859104];
    for w,i:other {#assert d[i]==w;}
    #assert dd_compare(its[0..<1],r[..],q[..],d[..]).status==DdStatus.ok;
    many:[1025]DdItem;for i:0..<1025 {many[i]=its[i%6];}wide:[8200]f64;far:[1025]f64;
    #assert dd_compare(many[0..<1024],wide[..],wide[..],far[..]).status==DdStatus.ok && dd_compare(many[..],wide[..],wide[..],far[..]).status==DdStatus.shape;
    // One flipped top answer, and a floored probability.
    f:=r;f[0]=0.1;f[1]=0.9;c=dd_compare(its[..],r[..],f[..],d[0..<6]);#assert c.agree==5;
    f[0]=0;f[1]=1;c=dd_compare(its[..],r[..],f[..],d[0..<6]);#assert c.floored==1;
    #assert dd_compare(its[..],r[0..<47],q[..],d[..]).status==DdStatus.capacity && dd_compare(its[..],r[..],q[0..<47],d[..]).status==DdStatus.capacity;
    #assert dd_compare(its[..],r[..],q[..],d[0..<5]).status==DdStatus.capacity && dd_compare(its[0..<0],r[..],q[..],d[..]).status==DdStatus.shape;
    bad:=its;bad[1].options=9;#assert dd_compare(bad[..],r[..],q[..],d[..]).status==DdStatus.shape;
    for k:0..<3 {
        x:=r;x[9]=ifx k==0 then 0.0/0.0 else ifx k==1 then -0.1 else 1.1;
        #assert dd_compare(its[..],x[..],q[..],d[..]).status==DdStatus.number && dd_compare(its[..],q[..],x[..],d[..]).status==DdStatus.number;
    }
    edge:=r;edge[9]=0;edge[10]=1;#assert dd_compare(its[..],edge[..],q[..],d[..]).status==DdStatus.ok;
    // A value past an item's options is never read.
    past:=r;past[2]=0.0/0.0;#assert dd_compare(its[..],past[..],q[..],d[..]).status==DdStatus.ok;
}

#test "percentiles by nearest rank" {
    d:=[10]f64.[3,1,4,1,5,9,2,6,5,3];
    // Sorted: 1 1 2 3 3 4 5 5 6 9.
    #assert dd_quantile(d[..],10)==1 && dd_quantile(d[..],20)==1 && dd_quantile(d[..],30)==2 && dd_quantile(d[..],50)==3;
    #assert dd_quantile(d[..],51)==4 && dd_quantile(d[..],90)==6 && dd_quantile(d[..],99)==9 && dd_quantile(d[..],100)==9;
    s:=dd_summary(d[..]);#assert s.status==DdStatus.ok && s.median==3 && s.p90==6 && s.p99==9 && s.max==9;
    one:=[1]f64.[2];#assert dd_summary(one[..]).median==2;
    // A hundred distinct values: the 99th is the second largest.
    h:[100]f64;for i:0..<100 {h[i]=f64(99-i);}
    s=dd_summary(h[..]);#assert s.max==99 && s.p99==98 && s.p90==89 && s.median==49 && dd_quantile(h[..],1)==0;
    #assert dd_summary(d[0..<0]).status==DdStatus.shape;
    big:[1025]f64;#assert dd_summary(big[0..<1024]).status==DdStatus.ok && dd_summary(big[..]).status==DdStatus.shape;
    for k:0..<3 {x:=d;x[4]=ifx k==0 then 0.0/0.0 else ifx k==1 then -1.0 else 1.0e301;#assert dd_summary(x[..]).status==DdStatus.number;}
    x:=d;x[4]=1.0e300;#assert dd_summary(x[..]).status==DdStatus.ok;x[4]=0;#assert dd_summary(x[..]).status==DdStatus.ok;
}

#test "a round's verdict, at each limit" {
    l:=DdLimits.{lost=0.04,strike=0.06,item=0.085};
    v:=[12]f64.[0.03,0.05, 0.05,0.05, 0.06,0.06, 0.07,0.07, 0,0.085, 0,0.086];
    want:=[6]DdVerdict.[DdVerdict.pass,DdVerdict.lost,DdVerdict.lost,DdVerdict.strike,DdVerdict.lost,DdVerdict.strike];
    for i:0..<6 {x:=v[2*i..<2*i+2];c:=dd_check(x,l);#assert c.verdict==want[i] && c.mean==(x[0]+x[1])/2 && c.worst==x[1];}
    late:=[2]f64.[0.07,0.02];#assert dd_check(late[..],l).worst==0.07;
    out:[4]int;out[3]=9;dd_pick(3,10,3,0,out[..]);#assert out[0]==1 && out[1]==7 && out[2]==6 && out[3]==9;
    dd_pick(3,10,3,3,out[..]);#assert out[0]==0 && out[1]==2 && out[2]==7;
}

#test "simulated rounds" {
    d:=[10]f64.[0.03,0.01,0.04,0.01,0.05,0.09,0.02,0.06,0.05,0.03];l:=DdLimits.{lost=0.04,strike=0.06,item=0.085};
    r:=dd_simulate(d[..],l,3,50,3);
    #assert r.status==DdStatus.ok && r.pass==27 && r.lost==7 && r.strike==16 && r.worst==0.06666666666666667 && r.worst_at==12;
    flat:=[5]f64.[0.02,0.02,0.02,0.02,0.02];r=dd_simulate(flat[..],l,3,50,2);#assert r.pass==50 && r.worst==0.02 && r.worst_at==0;
    #assert dd_simulate(d[..],DD_NONE,3,50,3).pass==50;
    #assert dd_simulate(d[0..<0],l,3,5,1).status==DdStatus.shape && dd_simulate(d[..],l,3,5,0).status==DdStatus.shape;
    #assert dd_simulate(d[..],l,3,5,11).status==DdStatus.shape && dd_simulate(d[..],l,3,5,10).status==DdStatus.ok;
    #assert dd_simulate(d[..],l,3,0,1).status==DdStatus.shape && dd_simulate(d[..],l,3,100001,1).status==DdStatus.shape;
    #assert dd_simulate(d[0..<1],l,3,1,1).status==DdStatus.ok;
    #assert dd_simulate(d[..],l,3,1,1).status==DdStatus.ok && dd_rounds_ok(100000) && !dd_rounds_ok(100001) && dd_rounds_ok(1) && !dd_rounds_ok(0);
    many:[1025]f64;#assert dd_simulate(many[0..<65],l,3,1,64).status==DdStatus.ok && dd_simulate(many[0..<65],l,3,1,65).status==DdStatus.shape;
    #assert dd_simulate(many[0..<1024],l,3,1,1).status==DdStatus.ok && dd_simulate(many[..],l,3,1,1).status==DdStatus.shape;
    for k:0..<3 {x:=d;x[4]=ifx k==0 then 0.0/0.0 else ifx k==1 then -1.0 else 1.0e301;#assert dd_simulate(x[..],l,3,5,1).status==DdStatus.number;}
    x:=d;x[4]=1.0e300;#assert dd_simulate(x[..],l,3,5,1).status==DdStatus.ok;
}

#test "limits, and whether they separate" {
    l:=dd_limits(0.01,0.02);#assert l.lost==0.02 && l.strike==0.06 && l.item==0.04;
    h:=[2]DdRounds.[DdRounds.{pass=100},DdRounds.{pass=100}];s:=[2]DdRounds.[DdRounds.{pass=5},DdRounds.{pass=0}];
    #assert dd_gap(h[..],s[..],100);
    s[1].pass=6;#assert !dd_gap(h[..],s[..],100);
    s[1].pass=0;h[1].pass=99;#assert !dd_gap(h[..],s[..],100);
    h[1].pass=100;s[0].pass=6;#assert !dd_gap(h[..],s[..],100);
}

#test "one checked round, its subset drawn from the answers" {
    its:[8]DdItem;#assert dd_items(77,its[..])==DdStatus.ok;
    r:[64]f64;q:[64]f64;
    #assert dd_answer(77,its[..],DdBackend.{seed=1,mix=1},r[..])==DdStatus.ok && dd_answer(77,its[..],DD_TEST_QUANTIZED,q[..])==DdStatus.ok;
    l:=DdLimits.{lost=0.05,strike=0.1,item=0.12};out:[4]int;out[3]=9;
    x:=dd_round(its[..],r[..],q[..],99,3,l,out[..]);
    #assert x.status==DdStatus.ok && x.seed==0x3278994a4db8f045 && out[0]==1 && out[1]==2 && out[2]==3 && out[3]==9;
    #assert x.verdict==DdVerdict.strike && x.mean==0.09649380249726058 && x.worst==0.1308932522972257;
    exact:[3]int;#assert dd_round(its[..],r[..],q[..],99,3,l,exact[..]).status==DdStatus.ok;
    // Other answers, another subset; another secret, another subset.
    y:=q;y[0]=r[0];y[1]=r[1];#assert dd_round(its[..],r[..],y[..],99,3,l,out[..]).seed!=x.seed;
    #assert dd_round(its[..],r[..],q[..],98,3,l,out[..]).seed==x.seed^99^98;
    #assert dd_round(its[..],r[..],r[..],99,8,l,out[..]).status==DdStatus.capacity;
    full:[8]int;same:=dd_round(its[..],r[..],r[..],99,8,l,full[..]);
    #assert same.verdict==DdVerdict.pass && same.mean==0 && same.seed==0x810cf3762111a901;
    #assert dd_round(its[0..<0],r[..],q[..],99,1,l,out[..]).status==DdStatus.shape && dd_round(its[..],r[..],q[..],99,0,l,out[..]).status==DdStatus.shape;
    #assert dd_round(its[..],r[..],q[..],99,9,l,full[..]).status==DdStatus.shape && dd_round(its[0..<1],r[..],q[..],99,1,l,out[..]).status==DdStatus.ok;
    #assert dd_round(its[..],r[0..<63],q[..],99,3,l,out[..]).status==DdStatus.capacity && dd_round(its[..],r[..],q[0..<63],99,3,l,out[..]).status==DdStatus.capacity;
    bad:=its;bad[2].options=9;#assert dd_round(bad[..],r[..],q[..],99,3,l,out[..]).status==DdStatus.shape;
    n:=r;n[0]=0.0/0.0;#assert dd_round(its[..],n[..],q[..],99,3,l,out[..]).status==DdStatus.number && dd_round(its[..],q[..],n[..],99,3,l,out[..]).status==DdStatus.number;
    many:[65]DdItem;for i:0..<65 {many[i]=its[i%8];}
    wide:[520]f64;for i:0..<65 {for j:0..<8 {wide[i*8+j]=r[(i%8)*8+j];}}
    #assert dd_round(many[0..<64],wide[..],wide[..],99,3,l,out[..]).status==DdStatus.ok && dd_round(many[..],wide[..],wide[..],99,3,l,out[..]).status==DdStatus.shape;
}

// book:begin items
// answer-sim-v1. Item i draws its kind, its options (2 to 8 for a choice, 2
// for yes or no, 3 to 5 for a score) and a favourite option; the reference's
// logit for each option is uniform in [-2, 2], plus 2 for the favourite.
dd_items :: (seed:u64,out:[]DdItem)->DdStatus #export_c {
    if out.count<1 || out.count>DD_ITEMS_MAX {return DdStatus.shape;}
    for i:0..<out.count {
        b:=cast(u64)(4*i);kind:=cast(int)(3*tb_uniform(seed,b));r:=tb_uniform(seed,b+1);
        options:=ifx kind==0 then 2+cast(int)(7*r) else ifx kind==1 then 2 else 3+cast(int)(3*r);
        out[i]=DdItem.{kind=cast(u8)kind,options=options,favourite=cast(int)(f64(options)*tb_uniform(seed,b+2))};
    }
    return DdStatus.ok;
}
dd_backend_ok :: (b:DdBackend)->bool {
    return b.mix>=0 && b.mix<=1 && b.grid>=0 && b.grid<=DD_PARAM_MAX && b.noise>=0 && b.noise<=DD_PARAM_MAX && b.share>=0
        && b.share<=1 && b.shift>=0 && b.shift<=DD_PARAM_MAX;
}
dd_items_ok :: (items:[]DdItem)->bool {
    for x:items {if x.options<2 || x.options>DD_OPTIONS || x.favourite<0 || x.favourite>=x.options {return false;}}
    return true;
}
// A backend's answers, DD_OPTIONS slots to an item; slots past an item's
// options are left as they were.
dd_answer :: (seed:u64,items:[]DdItem,b:DdBackend,out:[]f64)->DdStatus #export_c {
    if items.count<1 || items.count>DD_ITEMS_MAX || !dd_items_ok(items) || !dd_backend_ok(b) {return DdStatus.shape;}
    if out.count<DD_OPTIONS*items.count {return DdStatus.capacity;}
    for item,i:items {
        shifted:=cast(int)(tb_uniform(b.seed,cast(u64)(16384+i))+b.share)>0;
        w:[DD_OPTIONS]f64;
        for j:0..<item.options {
            z:=4*tb_uniform(seed,cast(u64)(4096+8*i+j))-2+(ifx j==item.favourite then 2.0 else 0.0);
            y:=b.mix*z+(1-b.mix)*(4*tb_uniform(b.seed,cast(u64)(8*i+j))-2);
            if b.grid>0 {y=f64(cast(int)(y/b.grid))*b.grid;}
            y+=b.noise*(tb_uniform(b.seed,cast(u64)(8192+8*i+j))-tb_uniform(b.seed,cast(u64)(12288+8*i+j)));
            if shifted {y+=b.shift*(2*tb_uniform(b.seed,cast(u64)(24576+8*i+j))-1);}
            w[j]=y;
        }
        // Relative to the first logit, which is within about 100 of the rest.
        t:=0.0;first:=w[0];for j:0..<item.options {w[j]=exp(w[j]-first);t+=w[j];}
        for j:0..<item.options {out[i*DD_OPTIONS+j]=w[j]/t;}
    }
    return DdStatus.ok;
}
// book:end items

// book:begin distance
// The distance: subtract each answer's mean log probability, then take the
// largest difference between the two, and the first option where it is.
// Probabilities below 10^-6 count as 10^-6, and the result says how many did.
dd_distance :: (p:[]f64,q:[]f64)->DdDistance {
    r:=DdDistance.{};a:[DD_OPTIONS]f64;b:[DD_OPTIONS]f64;sa:=0.0;sb:=0.0;
    for j:0..<p.count {
        x:=p[j];y:=q[j];
        if x<DD_FLOOR {x=DD_FLOOR;r.floored+=1;}
        if y<DD_FLOOR {y=DD_FLOOR;r.floored+=1;}
        a[j]=log(x);b[j]=log(y);sa+=a[j];sb+=b[j];
    }
    n:=f64(p.count);
    for j:0..<p.count {e:=abs((a[j]-sa/n)-(b[j]-sb/n));if j==0 || e>r.d {r.d=e;r.option=j;}}
    return r;
}
// book:end distance

dd_top :: (p:[]f64)->int {best:=0;for j:1..<p.count {if p[j]>p[best] {best=j;}}return best;}
dd_answers_ok :: (items:[]DdItem,a:[]f64)->DdStatus {
    for item,i:items {
        for x:a[i*DD_OPTIONS..<i*DD_OPTIONS+item.options] {if !(x>=0 && x<=1) {return DdStatus.number;}}
    }
    return DdStatus.ok;
}

// book:begin compare
// Two backends' answers to the same items: the distance for each item, how
// many top answers agree, and how many probabilities were floored.
dd_compare :: (items:[]DdItem,a:[]f64,b:[]f64,out:[]f64)->DdCompare #export_c {
    n:=items.count;
    if n<1 || n>DD_ITEMS_MAX || !dd_items_ok(items) {return DdCompare.{status=DdStatus.shape};}
    if a.count<DD_OPTIONS*n || b.count<DD_OPTIONS*n || out.count<n {return DdCompare.{status=DdStatus.capacity};}
    status:=dd_answers_ok(items,a);if status==DdStatus.ok {status=dd_answers_ok(items,b);}
    if status!=DdStatus.ok {return DdCompare.{status=status};}
    r:=DdCompare.{};
    for item,i:items {
        p:=a[i*DD_OPTIONS..<i*DD_OPTIONS+item.options];q:=b[i*DD_OPTIONS..<i*DD_OPTIONS+item.options];
        d:=dd_distance(p,q);out[i]=d.d;r.floored+=d.floored;
        if dd_top(p)==dd_top(q) {r.agree+=1;}
    }
    return r;
}
// The pct percentile by nearest rank, k = ceil(pct n / 100) in integers:
// the value x with fewer than k distances below it and at least k at or
// below it.
dd_rank_is :: (d:[]f64,x:f64,k:int)->bool {
    below:=0;atmost:=0;
    for y:d {if y<x {below+=1;}if y<=x {atmost+=1;}}
    return below<k && atmost>=k;
}
dd_quantile :: (d:[]f64,pct:int)->f64 {
    k:=(pct*d.count+99)/100;i:=0;
    while !dd_rank_is(d,d[i],k) {i+=1;}
    return d[i];
}
dd_summary :: (d:[]f64)->DdSummary #export_c {
    if d.count<1 || d.count>DD_ITEMS_MAX {return DdSummary.{status=DdStatus.shape};}
    for x:d {if !(x>=0 && x<=DD_BIG) {return DdSummary.{status=DdStatus.number};}}
    return DdSummary.{median=dd_quantile(d,50),p90=dd_quantile(d,90),p99=dd_quantile(d,99),max=dd_quantile(d,100)};
}
// book:end compare

// book:begin round
// A round's verdict from its checked distances: a strike when the mean
// passes the strike limit or any one item passes the item limit; lost when
// the mean passes the lost limit; otherwise passed.
dd_check :: (d:[]f64,limits:DdLimits)->DdCheck {
    r:=DdCheck.{worst=dd_quantile(d,100)};t:=0.0;
    for x:d {t+=x;}
    r.mean=t/f64(d.count);
    r.verdict=ifx r.mean>limits.strike || r.worst>limits.item then DdVerdict.strike
        else ifx r.mean>limits.lost then DdVerdict.lost else DdVerdict.pass;
    return r;
}
// v distinct positions of n, by a partial shuffle on counters base, base+1, ...
dd_pick :: (seed:u64,n:int,v:int,base:int,out:[]int) {
    idx:[DD_ITEMS_MAX]int;for i:1..<n {idx[i]=i;}   // idx[0] is 0 already
    for k:0..<v {
        j:=k+cast(int)(f64(n-k)*tb_uniform(seed,cast(u64)(base+k)));
        x:=idx[k];idx[k]=idx[j];idx[j]=x;out[k]=idx[k];
    }
}
dd_rounds_ok :: (rounds:int)->bool {return rounds>=1 && rounds<=DD_ROUNDS_MAX;}
// Many rounds drawn from measured distances: each checks v items at random.
dd_simulate :: (d:[]f64,limits:DdLimits,seed:u64,rounds:int,v:int)->DdRounds #export_c {
    if d.count<1 || d.count>DD_ITEMS_MAX || v<1 || v>d.count || v>DD_VERIFIED_MAX || !dd_rounds_ok(rounds) {
        return DdRounds.{status=DdStatus.shape};
    }
    for x:d {if !(x>=0 && x<=DD_BIG) {return DdRounds.{status=DdStatus.number};}}
    r:=DdRounds.{};at:[DD_VERIFIED_MAX]int;ds:[DD_VERIFIED_MAX]f64;
    for k:0..<rounds {
        dd_pick(seed,d.count,v,k*v,at[..]);
        for i:0..<v {ds[i]=d[at[i]];}
        c:=dd_check(ds[0..<v],limits);
        if c.verdict==DdVerdict.pass {r.pass+=1;}
        if c.verdict==DdVerdict.lost {r.lost+=1;}
        if c.verdict==DdVerdict.strike {r.strike+=1;}
        if k==0 || c.mean>r.worst {r.worst=c.mean;r.worst_at=k;}
    }
    return r;
}
// book:end round

// book:begin limits
// Limits between the two kinds of pair: a round is lost above twice the
// worst honest round, struck above three times that, and struck when one
// item is above twice the worst honest item. They stand only when every
// honest pair passes every round and each substitute passes at most 5 in 100.
dd_limits :: (honest_round:f64,honest_item:f64)->DdLimits {
    return DdLimits.{lost=2*honest_round,strike=6*honest_round,item=2*honest_item};
}
dd_gap :: (honest:[]DdRounds,substitutes:[]DdRounds,rounds:int)->bool {
    for h:honest {if h.pass!=rounds {return false;}}
    for s:substitutes {if 100*s.pass>5*rounds {return false;}}
    return true;
}
// book:end limits

// book:begin live
// One checked round. The checker draws which items it checks from the digest
// of the answers it received and its own secret, so the subset doesn't exist
// until the answers do.
dd_round :: (items:[]DdItem,reference:[]f64,answers:[]f64,secret:u64,checked:int,limits:DdLimits,out:[]int)->DdRound #export_c {
    n:=items.count;
    if n<1 || n>SU_ITEMS_MAX || checked<1 || checked>n || !dd_items_ok(items) {return DdRound.{status=DdStatus.shape};}
    if reference.count<DD_OPTIONS*n || answers.count<DD_OPTIONS*n || out.count<checked {return DdRound.{status=DdStatus.capacity};}
    status:=dd_answers_ok(items,reference);if status==DdStatus.ok {status=dd_answers_ok(items,answers);}
    if status!=DdStatus.ok {return DdRound.{status=status};}
    digest:=su_values(answers[0..<DD_OPTIONS*n]);seed:=cast(u64)digest[0];
    for k:1..<8 {seed|=cast(u64)digest[k]<<(8*cast(u64)k);}
    r:=DdRound.{seed=seed^secret};
    dd_pick(r.seed,n,checked,0,out);
    ds:[DD_VERIFIED_MAX]f64;
    for k:0..<checked {
        item:=items[out[k]];o:=out[k]*DD_OPTIONS;
        ds[k]=dd_distance(reference[o..<o+item.options],answers[o..<o+item.options]).d;
    }
    c:=dd_check(ds[0..<checked],limits);
    r.verdict=c.verdict;r.mean=c.mean;r.worst=c.worst;
    return r;
}
// book:end live
