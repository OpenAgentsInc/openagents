// Chapter 160: DoMINO's pieces, small. A geometry encoding on a grid of
// nodes (the signed distance to a closed mesh and, at two radii, the mean of
// a fixed point feature over the surface points near each node); a local
// encoding at a query point (the mean of the node encodings within two
// radii); and an output network evaluated on the query's nearest surface
// points and blended by inverse distance. The target is potential flow
// around a spheroid, whose surface pressure has a closed form.
// Profile psionic-domino-v1: binary64, one CPU core, plain sums in a fixed
// order; a grid of at most 8 x 8 x 8 nodes, chapter 158's point and mesh
// limits, 2 radii a stage, 4 stencil points and a 12-unit hidden layer.
#load "field.coax";
#load "optim/adamw.coax";
#load "../tests/domino-checks.coax";   // the checks' oracles

// book:begin types
DmStatus :: enum u8 {ok;shape;number;radius;bounds;mesh;limit;train;}
// side^3 nodes evenly spaced from low to high, corners included.
DmBox :: struct {low:[3]f64;high:[3]f64;side:int;}
// geometry: the two radii a node gathers surface points within; local: the
// two radii a query gathers nodes within. Each pair grows.
DmRadii :: struct {geometry:[2]f64;local:[2]f64;}
// The fixed point feature: at scale s, channel c is
// tanh(w[s][c] . (x - node) / R_s + b[s][c]).
DmEncoder :: struct {w:[24]f64;b:[8]f64;}
// cause is chapter 158's status when it decided the refusal.
DmResult :: struct {status:DmStatus;cause:FdStatus;written:int;}
DmTrain :: struct {steps:int;lr:f64;decay:f64;}
// book:end types

// book:begin bounds
DM_SIDE_MAX :: 8;
DM_SCALES :: 2;
DM_C :: 4;                     // channels a scale
DM_FEAT :: 9;                  // a node: signed distance, then 2 x 4 channels
DM_KEEP :: 64;                 // at most this many points or nodes a ball
DM_STENCIL :: 4;               // surface points a query reads
DM_BASIS :: 7;                 // offset / rho_0 (3), normal (3), distance / rho_0
DM_IN :: 25;                   // 7 + 2 x 9
DM_H :: 12;
DM_PARAMS :: 325;              // 12 x 25 + 12 + 12 + 1
DM_ROW :: 104;                 // a query: 4 rows of 25, then 4 blend weights
DM_DELTA :: 0.001;             // inverse-distance weights are 1 / (d + delta)
DM_STEPS_MAX :: 100000;
// book:end bounds

// Checks precede the implementation. Expected values are worked by hand in
// chapter 160, or come from an oracle in psionic/tests/domino-checks.coax.
#test "tanh and the node lattice by hand" {
    #assert f64_bits(dm_tanh(0))==0 && dm_tanh(800)==1 && dm_tanh(-800)== -1 && dm_tanh(-0.5)== -dm_tanh(0.5);
    #assert dm_near(dm_tanh(0.5),0.46211715726000974,1e-16) && dm_near(dm_tanh(1),0.7615941559557649,1e-16);
    box:=DmBox.{low=[3]f64.[-1,-2,0],high=[3]f64.[1,2,3],side=3};
    p:=dm_node(box,0);#assert p[0]== -1 && p[1]== -2 && p[2]==0;
    p=dm_node(box,26);#assert p[0]==1 && p[1]==2 && p[2]==3;
    p=dm_node(box,5);#assert p[0]==1 && p[1]==0 && p[2]==0;    // 5 = 2 + 1 x 3
    p=dm_node(box,13);#assert p[0]==0 && p[1]==0 && p[2]==1.5;  // 13 = 1 + 1 x 3 + 1 x 9
}
#forall "tanh matches its series and its symmetry" k:0..<40 {
    x:=f64(k)/40-0.5;#assert dm_near(dm_tanh(x),dm_tanh_series(x),2e-16);
    #assert dm_near(dm_tanh(x+3),(exp(2*(x+3))-1)/(exp(2*(x+3))+1),1e-15);
}
#test "boxes and radii refuse, in order" {
    box:=dm_box();r:=dm_radii();
    #assert dm_box_check(box)==DmStatus.ok && dm_radii_check(box,r)==DmStatus.ok;
    b:=box;b.side=1;#assert dm_box_check(b)==DmStatus.shape;b.side=9;#assert dm_box_check(b)==DmStatus.limit;
    b.side=2;#assert dm_box_check(b)==DmStatus.ok;b.side=8;#assert dm_box_check(b)==DmStatus.ok;
    b.high[2]=b.low[2];#assert dm_box_check(b)==DmStatus.shape;
    b=box;b.high[0]=b.low[0];#assert dm_box_check(b)==DmStatus.shape;
    b.high[2]=0.0/0.0;#assert dm_box_check(b)==DmStatus.number;
    b=box;b.low[0]=0.0/0.0;b.side=1;#assert dm_box_check(b)==DmStatus.number;
    b=box;b.low[1]=b.high[1]+1;#assert dm_box_check(b)==DmStatus.shape;
    q:=r;q.geometry[0]=0;#assert dm_radii_check(box,q)==DmStatus.radius;
    q=r;q.geometry[0]= -0.1;#assert dm_radii_check(box,q)==DmStatus.radius;
    q=r;q.geometry[0]=q.geometry[1];#assert dm_radii_check(box,q)==DmStatus.radius;
    q=r;q.local[0]=q.local[1];#assert dm_radii_check(box,q)==DmStatus.radius;
    q=r;q.local[0]=0;#assert dm_radii_check(box,q)==DmStatus.radius;
    q=r;q.local[1]=0.0/0.0;#assert dm_radii_check(box,q)==DmStatus.radius;
    q=r;q.geometry[1]=0.0/0.0;#assert dm_radii_check(box,q)==DmStatus.radius;
    // The box's diagonal, 3 sqrt 3 = 5.196..., is the largest radius.
    q=r;q.local[1]=sqrt(27.0);#assert dm_radii_check(box,q)==DmStatus.ok;
    q=r;q.local[1]=5.19;#assert dm_radii_check(box,q)==DmStatus.ok;q.local[1]=5.2;#assert dm_radii_check(box,q)==DmStatus.radius;
    q=r;q.geometry[1]=5.19;#assert dm_radii_check(box,q)==DmStatus.ok;q.geometry[1]=5.2;#assert dm_radii_check(box,q)==DmStatus.radius;
    b=box;b.side=1;#assert dm_radii_check(b,r)==DmStatus.shape;
}

// 1. The flow.
#test "potential flow: the sphere by hand" {
    // A sphere has A0 = 2/3, alpha = 1/2: the surface speed peaks at 3/2 U.
    #assert dm_near(dm_a0(0.5,0.5),2.0/3,1e-16) && dm_near(dm_alpha(0.5,0.5),0.5,1e-16);
    #assert dm_near(dm_cp(0.5,0.5,[3]f64.[0.5,0,0]),1,1e-15) && dm_near(dm_cp(0.5,0.5,[3]f64.[-0.5,0,0]),1,1e-15);
    #assert dm_near(dm_cp(0.5,0.5,[3]f64.[0,0.5,0]),-1.25,1e-15) && dm_near(dm_cp(0.5,0.5,[3]f64.[0,0,-0.5]),-1.25,1e-15);
    // At 60 degrees from the flow, sin^2 = 3/4: Cp = 1 - 9/4 x 3/4 = -11/16.
    #assert dm_near(dm_cp(0.5,0.5,[3]f64.[0.25,0.25*sqrt(3.0),0]),-11.0/16,1e-15) && dm_near(dm_cp(0.5,0.5,[3]f64.[0.25,0,0.25*sqrt(3.0)]),-11.0/16,1e-15);
    // Cp scales: a point off the surface reads the normal there.
    #assert dm_near(dm_cp(0.5,0.5,[3]f64.[1,1,0]),1-2.25*0.5,1e-15);
}
#forall "A0 matches its closed form and its integral" k:0..<20 {
    a:=0.55+f64(k)*0.05;b:=0.5;
    #assert dm_near(dm_a0(a,b),dm_a0_closed(a,b),1e-14) && dm_near(dm_a0(a,b),dm_a0_integral(a,b),1e-10);
    // A longer body disturbs the flow less: alpha falls.
    #assert dm_alpha(a+0.05,b)<dm_alpha(a,b);
}
#forall "Cp is 1 at the nose and 1 - (1 + alpha)^2 at the waist" k:0..<10 {
    a:=0.55+f64(k)*0.1;b:=0.5;al:=dm_alpha(a,b);
    #assert dm_near(dm_cp(a,b,[3]f64.[a,0,0]),1,1e-15) && dm_near(dm_cp(a,b,[3]f64.[0,0.6*b,0.8*b]),1-(1+al)*(1+al),1e-14);
}
#test "spheroid meshes: counts, admission and volume" #steps 400000000 {
    v:[774]f64;t:[1536]int;for i:0..<1536 {t[i]=9;}
    for level:0..<4 {
        nv:=dm_spheroid(0.75,0.5,level,v[..],t[..]);
        #assert nv==4*dm_pow4(level)+2;
        m:=fd_mesh_admit(FdMesh.{vertices=v[0..<3*nv],triangles=t[0..<24*dm_pow4(level)]});#assert m.status==FdStatus.ok;
        // The octahedron's volume is 4/3 a b^2; finer meshes approach 4/3 pi a b^2 from below.
        exact:=4.0/3*FD_PI*0.75*0.25;
        if level==0 {#assert dm_near(m.volume,4.0/3*0.75*0.25,1e-15);}
        #assert m.volume<exact && m.volume>exact*dm_volume_share(level);
        for i:0..<nv {x:=v[3*i]/0.75;y:=v[3*i+1]/0.5;z:=v[3*i+2]/0.5;#assert dm_near(x*x+y*y+z*z,1,1e-15);}
    }
    #assert dm_spheroid(0.75,0.5,4,v[..],t[..])==0 && dm_spheroid(0.75,0.5,-1,v[..],t[..])==0;
    big:[6150]f64;bt:[6144]int;#assert dm_spheroid(0.75,0.5,4,big[..],bt[..])==0;
    #assert dm_spheroid(0.75,0.5,3,v[0..<773],t[..])==0 && dm_spheroid(0.75,0.5,3,v[..],t[0..<1535])==0;
    #assert dm_spheroid(0.75,0.5,0,v[0..<18],t[0..<24])==6;
}

// 2. The encodings.
#test "a node's encoding by hand" {
    // One node at the origin, two surface points at (0.2, 0, 0) and
    // (0, 0, 0.4), radii 0.25 and 0.5. Channel c of scale s is
    // tanh(w . (x - node) / R_s + b); with w = (1, 0, 0) and b = 0 the first
    // channel at scale 0 sees only the first point: tanh(0.8). At scale 1
    // it averages tanh(0.4) and tanh(0).
    enc:DmEncoder;enc.w[0]=1;enc.w[12]=1;enc.b[5]=0.5;
    cloud:=[6]f64.[0.2,0,0, 0,0,0.4];
    f:[8]f64;s:=dm_point_features(enc,cloud[..],[3]f64.[0,0,0],[2]f64.[0.25,0.5],f[..]);
    #assert s==FdStatus.ok;
    #assert f[0]==dm_tanh(0.8) && f[1]==0 && f[4]==dm_tanh(0.4)/2 && f[5]==dm_tanh(0.5) && f[6]==0;
    // A node no point reaches reads zeros.
    s=dm_point_features(enc,cloud[..],[3]f64.[3,3,3],[2]f64.[0.25,0.5],f[..]);#assert s==FdStatus.ok && f[0]==0 && f[5]==0;
}
#forall "point features equal a direct loop over every point" seed:0..<8 #steps 200000000 {
    enc:=dm_encoder(cast(u64)seed);cloud:[600]f64;fd_cloud(seed,200,cloud[..]);
    f:[8]f64;g:[8]f64;q:=[3]f64.[f64(seed)/10-0.3,0.1,-0.2];
    #assert dm_point_features(enc,cloud[..],q,[2]f64.[0.3,0.55],f[..])==FdStatus.ok;
    dm_point_features_direct(enc,cloud[..],q,[2]f64.[0.3,0.55],g[..]);
    for i:0..<8 {#assert dm_near(f[i],g[i],1e-15);}
}
#test "balls keep the nearest 64 and refuse bad queries" {
    cloud:[300]f64;for i:0..<100 {cloud[3*i]=f64(i)/100;}
    start:[40]int;order:[100]int;g:=fd_grid_build(cloud[..],0.1,start[..],order[..]);
    idx:[64]int;
    #assert dm_ball(g,[3]f64.[0,0,0],0.05,idx[..])==6 && idx[5]==5;
    #assert dm_ball(g,[3]f64.[0.5,0,0],1,idx[..])==64 && idx[0]==50 && idx[1]==49 && idx[2]==51;
    #assert dm_ball(g,[3]f64.[0,0,0],0.0499,idx[..])==5;
    #assert dm_ball(g,[3]f64.[0,0,9],1,idx[..])==0;
    small:=[3]f64.[0,0,0];one:=fd_grid_build(small[..],1,start[..],order[..]);
    #assert dm_ball(one,[3]f64.[0,0,0],1,idx[..])==1;
}
#test "a grid encoding by hand: a sphere's signed distance at the nodes" #steps 400000000 {
    v:[774]f64;t:[1536]int;nv:=dm_spheroid(0.5,0.5,3,v[..],t[..]);
    m:=fd_mesh_admit(FdMesh.{vertices=v[0..<3*nv],triangles=t[..]});
    cloud:[768]f64;nrm:[768]f64;#assert fd_sample_surface(m,5,cloud[..],nrm[..]).status==FdStatus.ok;
    box:=DmBox.{low=[3]f64.[-1,-1,-1],high=[3]f64.[1,1,1],side=3};out:[243]f64;
    r:=dm_encode(m,cloud[..],box,dm_radii(),dm_encoder(1),out[..]);
    #assert r.status==DmStatus.ok && r.written==27;
    // The centre node is 0.5 inside, less the mesh's sag; a corner is sqrt 3 - 0.5 outside.
    #assert out[13*9]< -0.49 && out[13*9]> -0.5 && out[0]>sqrt(3.0)-0.5 && out[0]<sqrt(3.0)-0.49;
    for i:0..<27 {
        p:=dm_node(box,i);#assert out[i*9]==fd_mesh_distance(m,p).d;
        f:[8]f64;#assert dm_point_features(dm_encoder(1),cloud[..],p,dm_radii().geometry,f[..])==FdStatus.ok;
        for c:0..<8 {#assert out[i*9+1+c]==f[c];}
    }
}
#test "encoding refuses, in order, before it writes" #steps 400000000 {
    v:[774]f64;t:[1536]int;nv:=dm_spheroid(0.5,0.5,1,v[..],t[..]);
    m:=fd_mesh_admit(FdMesh.{vertices=v[0..<3*nv],triangles=t[0..<96]});#assert m.status==FdStatus.ok;
    cloud:[96]f64;nrm:[96]f64;#assert fd_sample_surface(m,5,cloud[..],nrm[..]).status==FdStatus.ok;
    box:=DmBox.{low=[3]f64.[-1,-1,-1],high=[3]f64.[1,1,1],side=2};out:[72]f64;enc:=dm_encoder(1);
    for i:0..<72 {out[i]=7;}
    // An open mesh: drop the last triangle.
    open:=fd_mesh_admit(FdMesh.{vertices=v[0..<3*nv],triangles=t[0..<93]});
    r:=dm_encode(open,cloud[..],box,dm_radii(),enc,out[..]);#assert r.status==DmStatus.mesh && r.cause==FdStatus.open;
    b:=box;b.side=1;r=dm_encode(open,cloud[..],b,dm_radii(),enc,out[..]);#assert r.status==DmStatus.mesh;
    r=dm_encode(m,cloud[..],b,dm_radii(),enc,out[..]);#assert r.status==DmStatus.shape && r.cause==FdStatus.ok;
    rr:=dm_radii();rr.geometry[1]= -1;r=dm_encode(m,cloud[..],box,rr,enc,out[..]);#assert r.status==DmStatus.radius;
    r=dm_encode(m,cloud[0..<0],box,dm_radii(),enc,out[..]);#assert r.status==DmStatus.shape && r.cause==FdStatus.shape;
    r=dm_encode(m,cloud[..],box,dm_radii(),enc,out[0..<71]);#assert r.status==DmStatus.shape && r.cause==FdStatus.ok;
    cloud[4]=0.0/0.0;r=dm_encode(m,cloud[..],box,dm_radii(),enc,out[..]);#assert r.status==DmStatus.number && r.cause==FdStatus.number;
    cloud[4]=0;
    // Radii so small the surface grid needs more than 32 cells a side.
    rr=dm_radii();rr.geometry[0]=0.01;rr.geometry[1]=0.02;r=dm_encode(m,cloud[..],box,rr,enc,out[..]);#assert r.status==DmStatus.limit && r.cause==FdStatus.limit;
    for i:0..<72 {#assert out[i]==7;}
    r=dm_encode(m,cloud[..],box,dm_radii(),enc,out[..]);#assert r.status==DmStatus.ok && r.written==8;
}

// 3. Queries and the output network.
#test "a query's rows equal a direct loop" #steps 400000000 {
    s:=dm_scene_small();
    q:=[3]f64.[0.6,0.4,-0.1];qn:=[3]f64.[0,0.6,0.8];row:[104]f64;
    r:=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);
    #assert r.status==DmStatus.ok && r.written==1;
    dm_rows_direct(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q,qn,s.check[..]);
    for i:0..<104 {#assert dm_near(row[i],s.check[i],1e-15);}
    // The blend weights sum to 1 and fall with distance.
    #assert dm_near(row[100]+row[101]+row[102]+row[103],1,1e-15) && row[100]>=row[101] && row[101]>=row[102] && row[102]>=row[103];
}
#forall "rows equal a direct loop, for queries all over the box" seed:0..<6 #steps 400000000 {
    s:=dm_scene_small();qs:[30]f64;qn:[30]f64;row:[1040]f64;
    for i:0..<30 {qs[i]=(dm_unit(seed,i)*2-1)*0.99;qn[i]=dm_unit(seed+20,i);}
    #assert dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],qs[..],qn[..],row[..]).written==10;
    for k:0..<10 {
        dm_rows_direct(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],fd_at(qs[..],k),fd_at(qn[..],k),s.check[..]);
        for i:0..<104 {#assert dm_near(row[k*104+i],s.check[i],1e-15);}
    }
}
#test "queries refuse, in order, before they write" #steps 400000000 {
    s:=dm_scene_small();q:=[6]f64.[0,0,0, 0.5,0.5,0.5];qn:=[6]f64.[1,0,0, 0,1,0];row:[208]f64;for i:0..<208 {row[i]=7;}
    r:=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.ok && r.written==2;
    for i:0..<208 {row[i]=7;}
    q[3]=1.0001;r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.bounds;
    q[3]=1;r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.ok;
    for i:0..<208 {row[i]=7;}
    q[4]= -1.0001;r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.bounds;
    q[4]= -1;q[2]=0.0/0.0;r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.number;
    q[2]=0;
    r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[0..<5],qn[0..<5],row[..]);#assert r.status==DmStatus.shape;
    r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[0..<0],qn[0..<0],row[0..<0]);#assert r.status==DmStatus.shape;
    r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[0..<207]);#assert r.status==DmStatus.shape;
    r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[0..<3],row[..]);#assert r.status==DmStatus.shape;
    r=dm_rows(s.box,dm_radii(),s.feat[0..<10],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.shape;
    r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[0..<9],q[..],qn[..],row[..]);#assert r.status==DmStatus.shape;
    r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[0..<6],s.normals[0..<6],q[..],qn[..],row[..]);#assert r.status==DmStatus.shape && r.cause==FdStatus.parameter;
    r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[0..<9],s.normals[0..<9],q[..],qn[..],row[..]);#assert r.status==DmStatus.ok;
    for i:0..<208 {row[i]=7;}
    b:=s.box;b.side=9;r=dm_rows(b,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.limit;
    rr:=dm_radii();rr.local[0]=2;r=dm_rows(s.box,rr,s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.radius;
    s.cloud[0]=0.0/0.0;r=dm_rows(s.box,dm_radii(),s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.number && r.cause==FdStatus.number;
    s.cloud[0]=0;rr=dm_radii();rr.local[0]=0.01;rr.local[1]=0.02;
    r=dm_rows(s.box,rr,s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.limit && r.cause==FdStatus.limit;
    rr=dm_radii();rr.geometry[0]=0.01;rr.geometry[1]=0.02;
    r=dm_rows(s.box,rr,s.feat[..],s.cloud[..],s.normals[..],q[..],qn[..],row[..]);#assert r.status==DmStatus.limit && r.cause==FdStatus.limit;
    for i:0..<208 {#assert row[i]==7;}
}
#test "the output network by hand" {
    // One hidden unit reads input 0 with weight 1; the output weight is 2
    // and the bias 0.5. Two stencil rows with inputs 0.5 and -1, weighted
    // 3/4 and 1/4: y = 3/4 (2 tanh 0.5 + 0.5) + 1/4 (2 tanh(-1) + 0.5).
    p:[325]f64;p[0]=1;p[312]=2;p[324]=0.5;row:[104]f64;row[0]=0.5;row[25]= -1;row[100]=0.75;row[101]=0.25;
    y:=dm_forward(p[..],row[..]);
    #assert dm_near(y,0.75*(2*dm_tanh(0.5)+0.5)+0.25*(2*dm_tanh(-1)+0.5),1e-16);
    // Unit 1's bias changes nothing while its output weight is 0; then it adds tanh(1/4) to every row.
    p[301]=0.25;#assert dm_forward(p[..],row[..])==y;
    p[313]=1;#assert dm_near(dm_forward(p[..],row[..]),y+dm_tanh(0.25),4e-16);
}
#forall "output gradients match finite differences" seed:0..<6 {
    p:[325]f64;dm_init(p[..],cast(u64)seed);row:[104]f64;
    for i:0..<100 {row[i]=dm_unit(seed+50,i)*2-1;}
    for k:0..<4 {row[100+k]=0.1*f64(k+1);}
    g:[325]f64;dm_backward(p[..],row[..],1.5,g[..]);
    for t:0..<325 {
        if t%7!=seed {continue;}
        h:=1e-6;keep:=p[t];p[t]=keep+h;up:=dm_forward(p[..],row[..]);p[t]=keep-h;down:=dm_forward(p[..],row[..]);p[t]=keep;
        #assert dm_near(g[t],1.5*(up-down)/(2*h),1e-8);
    }
    // Gradients add: a second call doubles them.
    g2:[325]f64;dm_backward(p[..],row[..],1.5,g2[..]);dm_backward(p[..],row[..],1.5,g2[..]);
    for t:0..<325 {#assert dm_near(g2[t],2*g[t],1e-14);}
}
#test "initial weights by hand" {
    p:[325]f64;for t:0..<325 {p[t]=9;}dm_init(p[..],3);
    d:=cr_draw(CrSeed.{seed=3,counter=0});#assert p[0]==(2*d.value-1)/5;
    d=cr_draw(CrSeed.{seed=3,counter=299});#assert p[299]==(2*d.value-1)/5;
    d=cr_draw(CrSeed.{seed=3,counter=312});#assert p[312]==(2*d.value-1)/sqrt(12.0);
    d=cr_draw(CrSeed.{seed=3,counter=323});#assert p[323]==(2*d.value-1)/sqrt(12.0);
    for t:300..<312 {#assert p[t]==0;}#assert p[324]==0;
    e:=dm_encoder(3);d=cr_draw(CrSeed.{seed=3,counter=1000});#assert e.w[0]==2*d.value-1;
    d=cr_draw(CrSeed.{seed=3,counter=1023});#assert e.w[23]==2*d.value-1;
    d=cr_draw(CrSeed.{seed=3,counter=1024});#assert e.b[0]==(2*d.value-1)/2;
    d=cr_draw(CrSeed.{seed=3,counter=1031});#assert e.b[7]==(2*d.value-1)/2;
}

// 4. Training and error.
#test "training: the loss, its steps and its refusals" #steps 400000000 {
    p:[325]f64;m:[325]f64;v:[325]f64;dm_init(p[..],1);
    rows:[416]f64;y:[4]f64;
    for i:0..<416 {rows[i]=dm_unit(9,i)*2-1;}
    for k:0..<4 {for j:0..<4 {rows[k*104+100+j]=0.25;}y[k]=f64(k)/4-0.3;}
    losses:[40]f64;
    #assert dm_train(p[..],m[..],v[..],rows[..],y[..],DmTrain.{steps=40,lr=0.02,decay=0},losses[..])==DmStatus.ok;
    // losses[0] is the mean squared error of the starting weights.
    q:[325]f64;dm_init(q[..],1);e:=0.0;for k:0..<4 {d:=dm_forward(q[..],rows[k*104..<(k+1)*104])-y[k];e+=d*d/4;}
    #assert losses[0]==e && losses[39]<losses[0]/10;
    // The same run again gives the same weights.
    p2:[325]f64;m2:[325]f64;v2:[325]f64;dm_init(p2[..],1);l2:[40]f64;
    #assert dm_train(p2[..],m2[..],v2[..],rows[..],y[..],DmTrain.{steps=40,lr=0.02,decay=0},l2[..])==DmStatus.ok;
    for t:0..<325 {#assert p2[t]==p[t];}
    // The loop is AdamW on the batch gradient, step by step: three steps by hand.
    q3:[325]f64;mq:[325]f64;vq:[325]f64;dm_init(q3[..],1);st:AwState;none:[1]f32;
    c3:=DmTrain.{steps=3,lr=0.02,decay=0.01};
    for s:0..<3 {
        g:[325]f64;
        for k:0..<4 {d3:=dm_forward(q3[..],rows[k*104..<(k+1)*104])-y[k];dm_backward(q3[..],rows[k*104..<(k+1)*104],d3/2,g[..]);}
        gr:=[1]AwGroup.[AwGroup.{first=0,count=325,lr=dm_rate(c3,s),beta1=0.9,beta2=0.999,eps=1e-8,decay=0.01}];
        res:=aw_step(gr[..],AwPolicy.{},st,q3[..],g[..],mq[..],vq[..],none[0..<0],false);#assert res.status==AwStatus.ok;st=res.state;
    }
    p3:[325]f64;m3:[325]f64;v3:[325]f64;dm_init(p3[..],1);l3:[3]f64;
    #assert dm_train(p3[..],m3[..],v3[..],rows[..],y[..],c3,l3[..])==DmStatus.ok;
    for t:0..<325 {#assert p3[t]==q3[t] && m3[t]==mq[t] && v3[t]==vq[t];}
    // One step on one query is admitted.
    l1:[1]f64;#assert dm_train(p3[..],m3[..],v3[..],rows[0..<104],y[0..<1],DmTrain.{steps=1,lr=0.02,decay=0},l1[..])==DmStatus.ok;
    // Refusals write nothing.
    keep:=p;cfg:=DmTrain.{steps=40,lr=0.02,decay=0};
    #assert dm_train(p[..],m[..],v[..],rows[..],y[0..<3],cfg,losses[..])==DmStatus.shape;
    #assert dm_train(p[..],m[..],v[..],rows[0..<415],y[..],cfg,losses[..])==DmStatus.shape;
    #assert dm_train(p[0..<324],m[..],v[..],rows[..],y[..],cfg,losses[..])==DmStatus.shape;
    #assert dm_train(p[..],m[0..<324],v[..],rows[..],y[..],cfg,losses[..])==DmStatus.shape;
    #assert dm_train(p[..],m[..],v[0..<324],rows[..],y[..],cfg,losses[..])==DmStatus.shape;
    #assert dm_train(p[..],m[..],v[..],rows[..],y[..],cfg,losses[0..<39])==DmStatus.shape;
    #assert dm_train(p[..],m[..],v[..],rows[0..<0],y[0..<0],cfg,losses[..])==DmStatus.shape;
    c:=cfg;c.steps=0;#assert dm_train(p[..],m[..],v[..],rows[..],y[..],c,losses[0..<0])==DmStatus.shape;
    // The step limit is checked before the data: 100,000 steps get as far as a NaN.
    long:[100001]f64;c.steps=100001;#assert dm_train(p[..],m[..],v[..],rows[..],y[..],c,long[..])==DmStatus.shape;
    rows[7]=0.0/0.0;c.steps=100000;#assert dm_train(p[..],m[..],v[..],rows[..],y[..],c,long[0..<100000])==DmStatus.number;rows[7]=0.5;
    c=cfg;c.lr=2;#assert dm_train(p[..],m[..],v[..],rows[..],y[..],c,losses[..])==DmStatus.train;
    c=cfg;y[2]=0.0/0.0;#assert dm_train(p[..],m[..],v[..],rows[..],y[..],c,losses[..])==DmStatus.number;y[2]=0.2;
    rows[7]=1.0/0.0;#assert dm_train(p[..],m[..],v[..],rows[..],y[..],c,losses[..])==DmStatus.number;
    for t:0..<325 {#assert p[t]==keep[t];}
    // The learning rate halves after each quarter of the steps.
    #assert dm_rate(cfg,0)==0.02 && dm_rate(cfg,9)==0.02 && dm_rate(cfg,10)==0.01 && dm_rate(cfg,39)==0.0025;
}
#test "relative error and the drag integral by hand" {
    p:[325]f64;p[324]=1;rows:[208]f64;for k:0..<2 {rows[k*104+100]=1;}
    y:=[2]f64.[2,-1];
    // The network says 1 everywhere: errors -1 and 2, so sqrt(5 / 5) = 1.
    #assert dm_error(p[..],rows[..],y[..])==1;
    y[1]=1;#assert dm_near(dm_error(p[..],rows[..],y[..]),sqrt(1.0/5),1e-16);
    // The pressure force along x: the mean of Cp n_x times the area.
    cp:=[2]f64.[1,0.5];n:=[6]f64.[1,0,0, -0.6,0.8,0];
    #assert dm_drag(cp[..],n[..],4)== -2*(1-0.3);
}

// book:begin small
// tanh on |x|, then the sign: exactly odd, and 1 or -1 where exp underflows.
dm_tanh :: (x:f64)->f64 {t:=exp(-2*abs(x));y:=(1-t)/(1+t);return ifx x<0 then -y else y;}
dm_pow4 :: (level:int)->int {n:=1;for i:0..<level {n*=4;}return n;}
dm_node :: (box:DmBox,i:int)->[3]f64 {
    c:=[3]int.[i%box.side,(i/box.side)%box.side,i/(box.side*box.side)];p:[3]f64;
    for k:0..<3 {p[k]=box.low[k]+(box.high[k]-box.low[k])*f64(c[k])/f64(box.side-1);}
    return p;
}
// Chapter 158's refusals, carried: a number stays a number, a limit a limit.
dm_from :: (s:FdStatus)->DmStatus {
    if s==FdStatus.number {return DmStatus.number;}
    if s==FdStatus.limit {return DmStatus.limit;}
    return DmStatus.shape;
}
// book:end small

// book:begin check
dm_box_check :: (box:DmBox)->DmStatus {
    if !fd_point(box.low) || !fd_point(box.high) {return DmStatus.number;}
    if box.side<2 {return DmStatus.shape;}
    if box.side>DM_SIDE_MAX {return DmStatus.limit;}
    for k:0..<3 {if !(box.low[k]<box.high[k]) {return DmStatus.shape;}}
    return DmStatus.ok;
}
// Each pair grows, from above 0 to at most the box's diagonal. A NaN fails
// every comparison and is refused here too.
dm_radii_check :: (box:DmBox,r:DmRadii)->DmStatus {
    s:=dm_box_check(box);if s!=DmStatus.ok {return s;}
    diag:=fd_norm(fd_sub(box.high,box.low));
    pairs:=[4]f64.[r.geometry[0],r.geometry[1],r.local[0],r.local[1]];
    for k:0..<2 {if !(0<pairs[2*k] && pairs[2*k]<pairs[2*k+1] && pairs[2*k+1]<=diag) {return DmStatus.radius;}}
    return DmStatus.ok;
}
// book:end check

// book:begin flow
// Potential flow along x past the spheroid x^2/a^2 + (y^2 + z^2)/b^2 = 1,
// a >= b. With e^2 = 1 - b^2/a^2,
//   A0 = 2 (1 - e^2) (1/3 + e^2/5 + e^4/7 + ...),
// the series of (1 - e^2)/e^3 (ln((1 + e)/(1 - e)) - 2e), exact at e = 0.
// The sum runs until e2^k underflows to zero.
dm_a0 :: (a:f64,b:f64)->f64 {
    e2:=1-b*b/(a*a);sum:=0.0;term:=1.0;k:=0;add:=1.0/3;
    while add!=0 {sum+=add;term*=e2;k+=1;add=term/f64(2*k+3);}
    return 2*(1-e2)*sum;
}
// The surface speed is (1 + alpha) U times the tangential part of the flow.
dm_alpha :: (a:f64,b:f64)->f64 {a0:=dm_a0(a,b);return a0/(2-a0);}
// Cp = 1 - |v|^2 / U^2 = 1 - (1 + alpha)^2 (1 - n_x^2), with n the unit
// normal of the spheroid through p, along (x/a^2, y/b^2, z/b^2).
dm_cp_normal :: (a:f64,b:f64,n:[3]f64)->f64 {
    nx2:=n[0]*n[0]/fd_dot(n,n);k:=1+dm_alpha(a,b);return 1-k*k*(1-nx2);
}
dm_cp :: (a:f64,b:f64,p:[3]f64)->f64 {return dm_cp_normal(a,b,[3]f64.[p[0]/(a*a),p[1]/(b*b),p[2]/(b*b)]);}
// book:end flow

// book:begin mesh
// The octahedron, each triangle cut into four level times, the new corners
// pushed out to the unit sphere, then stretched to the spheroid. Returns the
// vertex count, or 0 if level is outside 0..3 or the arrays are short.
// A midpoint is never one of the octahedron's six corners: the search
// starts after them and returns n when p is new.
dm_find :: (v:[]f64,n:int,p:[3]f64)->int {
    for i:6..<n {if v[3*i]==p[0] && v[3*i+1]==p[1] && v[3*i+2]==p[2] {return i;}}
    return n;
}
dm_mid :: (v:[]f64,n:[]int,i:int,j:int)->int {
    m:=fd_add(fd_at(v,i),fd_at(v,j));m=fd_div(m,fd_norm(m));
    k:=dm_find(v,n[0],m);
    if k==n[0] {for d:0..<3 {v[3*k+d]=m[d];}n[0]+=1;}
    return k;
}
dm_spheroid :: (a:f64,b:f64,level:int,v:[]f64,t:[]int)->int {
    if level<0 || level>3 {return 0;}
    nt:=8*dm_pow4(level);nv:=nt/2+2;
    if v.count<3*nv || t.count<3*nt {return 0;}
    for i:0..<18 {v[i]=FD_OCTA_V[i];}for i:0..<24 {t[i]=FD_OCTA[i];}
    n:=[1]int.[6];have:=8;next:[1536]int;
    for l:0..<level {
        for s:0..<have {
            i:=t[3*s];j:=t[3*s+1];k:=t[3*s+2];
            ij:=dm_mid(v,n[..],i,j);jk:=dm_mid(v,n[..],j,k);ki:=dm_mid(v,n[..],k,i);
            four:=[12]int.[ij,jk,ki, i,ij,ki, ij,j,jk, ki,jk,k];
            for e:0..<12 {next[12*s+e]=four[e];}
        }
        have*=4;for e:0..<3*have {t[e]=next[e];}
    }
    for i:0..<nv {v[3*i]*=a;v[3*i+1]*=b;v[3*i+2]*=b;}
    return nv;
}
// book:end mesh

// book:begin ball
// The points of g within r of q, nearest first, at most 64: the k nearest
// from chapter 158's grid, cut where they leave the ball.
dm_ball :: (g:FdGrid,q:[3]f64,r:f64,out:[]int)->int {
    keep:=fd_knn(g,q,fd_imin(DM_KEEP,g.n),out).count;
    count:=0;while count<keep && fd_d2(g.points,out[count],q)<=r*r {count+=1;}
    return count;
}
// book:end ball

// book:begin encode
// The point feature at node q: at each scale, the mean over the surface
// points within R_s of tanh(w . (x - q) / R_s + b), or 0 if none is.
dm_features_in :: (g:FdGrid,enc:DmEncoder,q:[3]f64,radii:[2]f64,f:[]f64) {
    idx:[64]int;
    for s:0..<DM_SCALES {
        count:=dm_ball(g,q,radii[s],idx[..]);
        for c:0..<DM_C {
            o:=s*DM_C+c;sum:=0.0;
            for j:0..<count {
                u:=fd_div(fd_sub(fd_at(g.points,idx[j]),q),radii[s]);
                sum+=dm_tanh(enc.b[o]+enc.w[3*o]*u[0]+enc.w[3*o+1]*u[1]+enc.w[3*o+2]*u[2]);
            }
            f[o]=ifx count==0 then 0.0 else sum/f64(count);
        }
    }
}
dm_point_features :: (enc:DmEncoder,cloud:[]f64,q:[3]f64,radii:[2]f64,f:[]f64)->FdStatus {
    start:[32769]int;order:[4096]int;g:=fd_grid_build(cloud,radii[1],start[..],order[..]);
    if g.status==FdStatus.ok {dm_features_in(g,enc,q,radii,f);}
    return g.status;
}
// Node i's nine numbers: the mesh's signed distance, then the point
// feature's two scales of four channels.
dm_encode :: (m:FdChecked,cloud:[]f64,box:DmBox,radii:DmRadii,enc:DmEncoder,out:[]f64)->DmResult {
    r:DmResult;
    if m.status!=FdStatus.ok {r.status=DmStatus.mesh;r.cause=m.status;return r;}
    r.status=dm_radii_check(box,radii);if r.status!=DmStatus.ok {return r;}
    nodes:=box.side*box.side*box.side;
    if out.count!=nodes*DM_FEAT {r.status=DmStatus.shape;return r;}
    start:[32769]int;order:[4096]int;g:=fd_grid_build(cloud,radii.geometry[1],start[..],order[..]);
    r.cause=g.status;r.status=dm_from(g.status);
    if g.status!=FdStatus.ok {return r;}
    for i:0..<nodes {
        p:=dm_node(box,i);out[i*DM_FEAT]=fd_mesh_distance(m,p).d;
        dm_features_in(g,enc,p,radii.geometry,out[i*DM_FEAT+1..<(i+1)*DM_FEAT]);
    }
    r.status=DmStatus.ok;r.written=nodes;return r;
}
// book:end encode

// book:begin rows
// Query k's 104 numbers: four rows of 25, one for the query itself and one
// for each of its three nearest surface points j (offset and distance over
// rho_0, the point's normal, then the local encoding: the mean node encoding
// within rho_0 and within rho_1), then the four blend weights
// (1 / (d_j + delta)) / sum.
dm_rows :: (box:DmBox,radii:DmRadii,feat:[]f64,cloud:[]f64,normals:[]f64,queries:[]f64,qnormals:[]f64,rows:[]f64)->DmResult {
    r:DmResult;r.status=dm_radii_check(box,radii);if r.status!=DmStatus.ok {return r;}
    nodes:=box.side*box.side*box.side;
    if feat.count!=nodes*DM_FEAT {r.status=DmStatus.shape;return r;}
    r.status=DmStatus.shape;
    if normals.count!=cloud.count {return r;}
    if cloud.count<3*(DM_STENCIL-1) {r.cause=FdStatus.parameter;return r;}
    nq:=queries.count/3;
    if nq==0 || queries.count!=3*nq || qnormals.count!=queries.count || rows.count!=nq*DM_ROW {return r;}
    for k:0..<nq {
        q:=fd_at(queries,k);
        if !fd_point(q) {r.status=DmStatus.number;return r;}
        for d:0..<3 {if q[d]<box.low[d] || q[d]>box.high[d] {r.status=DmStatus.bounds;return r;}}
    }
    at:[1536]f64;for i:0..<nodes {p:=dm_node(box,i);for d:0..<3 {at[3*i+d]=p[d];}}
    ns:[32769]int;no:[512]int;ng:=fd_grid_build(at[0..<3*nodes],radii.local[1],ns[..],no[..]);
    cs:[32769]int;co:[4096]int;cg:=fd_grid_build(cloud,radii.geometry[1],cs[..],co[..]);
    r.cause=ng.status;if r.cause==FdStatus.ok {r.cause=cg.status;}
    r.status=dm_from(r.cause);if r.cause!=FdStatus.ok {return r;}
    for k:0..<nq {
        q:=fd_at(queries,k);row:=rows[k*DM_ROW..<(k+1)*DM_ROW];
        local:[18]f64;idx:[64]int;
        for t:0..<2 {
            count:=dm_ball(ng,q,radii.local[t],idx[..]);
            for c:0..<DM_FEAT {
                sum:=0.0;for j:0..<count {sum+=feat[idx[j]*DM_FEAT+c];}
                local[t*DM_FEAT+c]=ifx count==0 then 0.0 else sum/f64(count);
            }
        }
        near:=fd_knn(cg,q,DM_STENCIL-1,idx[1..<64]).count;total:=0.0;
        for j:0..<near+1 {
            x:=q;n:=fd_at(qnormals,k);
            if j>0 {x=fd_at(cloud,idx[j]);n=fd_at(normals,idx[j]);}
            u:=fd_div(fd_sub(x,q),radii.local[0]);o:=j*DM_IN;
            for d:0..<3 {row[o+d]=u[d];row[o+3+d]=n[d];}
            row[o+6]=fd_norm(u);
            for c:0..<18 {row[o+DM_BASIS+c]=local[c];}
            w:=1/(fd_norm(fd_sub(x,q))+DM_DELTA);row[DM_STENCIL*DM_IN+j]=w;total+=w;
        }
        for j:0..<DM_STENCIL {row[DM_STENCIL*DM_IN+j]/=total;}
    }
    r.status=DmStatus.ok;r.written=nq;return r;
}
// book:end rows

// book:begin net
// Parameters: W1 (12 x 25, row-major) at 0, b1 at 300, w2 at 312, b2 at 324.
// Each stencil row j gives f_j = b2 + sum_h w2[h] tanh(b1[h] + W1[h] . x_j);
// the prediction is sum_j a_j f_j with the row's blend weights a_j.
dm_init :: (p:[]f64,seed:u64) {
    for t:0..<DM_PARAMS {
        u:=2*cr_draw(CrSeed.{seed=seed,counter=cast(u64)t}).value-1;
        p[t]=0;
        if t<300 {p[t]=u/5;}
        if t>=312 && t<324 {p[t]=u/sqrt(12.0);}
    }
}
dm_encoder :: (seed:u64)->DmEncoder {
    e:DmEncoder;
    for i:0..<24 {e.w[i]=2*cr_draw(CrSeed.{seed=seed,counter=cast(u64)(1000+i)}).value-1;}
    for i:0..<8 {e.b[i]=(2*cr_draw(CrSeed.{seed=seed,counter=cast(u64)(1024+i)}).value-1)/2;}
    return e;
}
// Unit h on the stencil row that starts at row[o].
dm_hidden :: (p:[]f64,row:[]f64,o:int,h:int)->f64 {
    z:=p[300+h];for i:0..<DM_IN {z+=p[h*DM_IN+i]*row[o+i];}
    return dm_tanh(z);
}
dm_forward :: (p:[]f64,row:[]f64)->f64 {
    y:=0.0;
    for j:0..<DM_STENCIL {
        f:=p[324];
        for h:0..<DM_H {f+=p[312+h]*dm_hidden(p,row,j*DM_IN,h);}
        y+=row[DM_STENCIL*DM_IN+j]*f;
    }
    return y;
}
// Adds dy times the gradient of the prediction to g.
dm_backward :: (p:[]f64,row:[]f64,dy:f64,g:[]f64) {
    for j:0..<DM_STENCIL {
        o:=j*DM_IN;da:=dy*row[DM_STENCIL*DM_IN+j];g[324]+=da;
        for h:0..<DM_H {
            t:=dm_hidden(p,row,o,h);g[312+h]+=da*t;
            dz:=da*p[312+h]*(1-t*t);g[300+h]+=dz;
            for i:0..<DM_IN {g[h*DM_IN+i]+=dz*row[o+i];}
        }
    }
}
// book:end net

// book:begin train
// The learning rate halves after each quarter of the steps.
dm_rate :: (cfg:DmTrain,s:int)->f64 {return cfg.lr*pow(0.5,f64((4*s)/cfg.steps));}
// Full-batch steps of chapter 124's AdamW on the mean squared error.
// losses[s] is the loss before step s. A refused AdamW step leaves the
// weights as they were.
dm_train :: (p:[]f64,m:[]f64,v:[]f64,rows:[]f64,targets:[]f64,cfg:DmTrain,losses:[]f64)->DmStatus {
    n:=targets.count;
    if cfg.steps<1 || cfg.steps>DM_STEPS_MAX || losses.count!=cfg.steps || n<1 || rows.count!=n*DM_ROW {return DmStatus.shape;}
    if p.count!=DM_PARAMS || m.count!=DM_PARAMS || v.count!=DM_PARAMS {return DmStatus.shape;}
    for x:rows {if !fd_finite(x) {return DmStatus.number;}}
    for x:targets {if !fd_finite(x) {return DmStatus.number;}}
    g:[325]f64;none:[1]f32;state:AwState;
    for s:0..<cfg.steps {
        for t:0..<DM_PARAMS {g[t]=0;}
        loss:=0.0;
        for k:0..<n {
            row:=rows[k*DM_ROW..<(k+1)*DM_ROW];e:=dm_forward(p,row)-targets[k];
            loss+=e*e/f64(n);dm_backward(p,row,2*e/f64(n),g[..]);
        }
        losses[s]=loss;
        group:=[1]AwGroup.[AwGroup.{first=0,count=DM_PARAMS,lr=dm_rate(cfg,s),beta1=0.9,beta2=0.999,eps=1e-8,decay=cfg.decay}];
        r:=aw_step(group[..],AwPolicy.{},state,p,g[..],m,v,none[0..<0],false);
        if r.status!=AwStatus.ok {return DmStatus.train;}
        state=r.state;
    }
    return DmStatus.ok;
}
// book:end train

// book:begin error
// The relative L2 error sqrt(sum (y - t)^2 / sum t^2). Surface queries are
// drawn uniformly by area, so plain sums are area-weighted.
dm_error :: (p:[]f64,rows:[]f64,targets:[]f64)->f64 {
    e:=0.0;s:=0.0;
    for k:0..<targets.count {d:=dm_forward(p,rows[k*DM_ROW..<(k+1)*DM_ROW])-targets[k];e+=d*d;s+=targets[k]*targets[k];}
    return sqrt(e/s);
}
// The pressure force along the flow, -(surface integral of Cp n_x), as the
// area times the mean over area-uniform points. Potential flow has none.
dm_drag :: (cp:[]f64,normals:[]f64,area:f64)->f64 {
    s:=0.0;for i:0..<cp.count {s+=cp[i]*normals[3*i];}
    return -area*s/f64(cp.count);
}
// book:end error
