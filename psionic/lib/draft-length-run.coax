// Chapter 102: adaptive draft length on chapter 87's draft head. Each round
// the head drafts up to `most` tokens and reports its own probability for
// each; those are the acceptance estimates, and dl_choose picks how many to
// verify against the cost table. k = 0 is one plain target step. Greedy
// only. The time is modeled: the sum of the cost table's entries for the
// lengths used, not a clock.
// Profile dl-run-cpu-f64-v1: binary64 on the CPU, chapter 87's cells.
#load "draft-length.coax";
#load "draft-head.coax";

// book:begin run
// written: tokens in out. rounds: plain steps plus blocks. chosen[k]: rounds
// that verified k drafts. drafted and accepted: draft tokens verified and
// kept. target: target rows evaluated, one per round plus one per draft.
// time: the modeled cost of every round.
DlRun :: struct {status:DlStatus;written:int;rounds:int;drafted:int;accepted:int;target:int;chosen:[DL_MAX+1]int;time:f64;}
// fixed < 0: adaptive. fixed = 0..most: always that length.
dl_run :: (t:DhCell,head:DhCell,prompt:[]int,steps:int,most:int,fixed:int,cost:[]f64,out:[]int)->DlRun {
    r:=DlRun.{status=DlStatus.shape};
    if most<1 || most>DH_DRAFTS_MAX || fixed>most || cost.count!=most+1 {return r;}
    if dh_check(t,head,prompt,steps,cost[0..<0],out)!=DhStatus.ok {return r;}
    for c:cost {if !dl_time(c) {r.status=DlStatus.cost;return r;}}
    r.status=DlStatus.ok;w:=t.width;v:=t.vocab;
    hs:[(DH_DRAFTS_MAX+2)*DH_WIDTH_MAX]f64;p:[(DH_DRAFTS_MAX+1)*DH_VOCAB_MAX]f64;q:[DH_DRAFTS_MAX*DH_VOCAB_MAX]f64;
    drafts:[DH_DRAFTS_MAX]int;emitted:[DH_DRAFTS_MAX+1]int;stage:[DH_DRAFTS_MAX+1]int;residual:[DH_VOCAB_MAX]f64;scratch:[DH_VOCAB_MAX]f64;
    accept:[DH_DRAFTS_MAX]f64;zeros:[2*DH_DRAFTS_MAX+1]f64;
    dh_prefill(t,prompt,hs[0..<w]);pending:=prompt[prompt.count-1];
    while r.written<steps {
        used:=dh_draft(head,hs[0..<w],pending,most,true,accept[..],drafts[..],q[..]);#assert used==0;
        for j:0..<most {accept[j]=q[j*v+drafts[j]];}
        k:=fixed;if k<0 {k=dl_choose(accept[0..<most],cost).k;}
        r.rounds+=1;r.chosen[k]+=1;r.time+=cost[k];
        token:=pending;
        for i:0..<k+1 {
            dh_step(t,hs[i*w..<hs.count],token,hs[(i+1)*w..<hs.count]);dh_probs(t,hs[(i+1)*w..<hs.count],p[i*v..<p.count]);r.target+=1;
            if i<k {token=drafts[i];}
        }
        if k==0 {pending=gx_argmax(p[0..<v]);out[r.written]=pending;r.written+=1;for j:0..<w {hs[j]=hs[w+j];}continue;}
        b:=gx_block(v,p[0..<(k+1)*v],q[0..<k*v],drafts[0..<k],zeros[0..<2*k+1],true,emitted[..],stage[..],residual[..],scratch[..],false);
        #assert b.status==GStatus.ok;
        for i:0..<b.written {if r.written<steps {out[r.written]=emitted[i];r.written+=1;}}
        r.drafted+=k;r.accepted+=b.accepted;
        a:=b.accepted+1;for j:0..<w {hs[j]=hs[a*w+j];}pending=emitted[b.written-1];
    }
    return r;
}
// book:end run

// The chapter's synthetic pair, workload dh-walk-v1 of chapter 87: the
// target cell from seeds 1, 2, 3 and a head with its weights rounded to
// `step`.
DlPair :: struct {recur:[16]f64;embed:[32]f64;out:[32]f64;hr:[16]f64;he:[32]f64;}
dl_pair :: (seed:int,step:f64)->DlPair {
    x:DlPair;dh_fill(seed,4,x.recur[..]);dh_fill(seed+1,1,x.embed[..]);dh_fill(seed+2,4,x.out[..]);
    dh_round(x.recur[..],step,x.hr[..]);dh_round(x.embed[..],step,x.he[..]);return x;
}

#test "adaptive and fixed runs by hand on dh-walk-v1" {
    x:=dl_pair(1,0.5);
    t:=DhCell.{vocab=8,width=4,recur=x.recur[..],embed=x.embed[..],out=x.out[..]};
    head:=DhCell.{vocab=8,width=4,recur=x.hr[..],embed=x.he[..],out=x.out[..]};
    prompt:=[3]int.[1,2,3];none:[1]f64;base:[48]int;o:[48]int;
    g:=dh_generate(t,prompt[..],48,true,none[0..<0],base[..]);#assert g.written==48;
    // Fixed k = 0 is the target alone: 48 rounds of cost 10.
    c:=[5]f64.[10,12,14,16,18];
    r:=dl_run(t,head,prompt[..],48,4,0,c[..],o[..]);
    #assert r.status==DlStatus.ok && r.written==48 && r.rounds==48 && r.chosen[0]==48 && r.time==480 && r.drafted==0 && r.target==48;
    for i:0..<48 {#assert o[i]==base[i];}
    // Fixed k = 4 matches chapter 87's dh_speculate at k = 4: 13 blocks, 39 of 52.
    r=dl_run(t,head,prompt[..],48,4,4,c[..],o[..]);
    #assert r.rounds==13 && r.chosen[4]==13 && r.accepted==39 && r.drafted==52 && r.time==13*18 && r.target==65;
    for i:0..<48 {#assert o[i]==base[i];}
    // Blocks that cost (k + 1) steps never pay: adaptive is the target alone.
    e:=[5]f64.[10,20,30,40,50];r=dl_run(t,head,prompt[..],48,4,-1,e[..],o[..]);
    #assert r.chosen[0]==48 && r.time==480;
    // Cheap blocks: adaptive verifies, and is never slower here than the best fixed length.
    r=dl_run(t,head,prompt[..],48,4,-1,c[..],o[..]);
    #assert r.chosen[0]<48 && r.drafted>0;for i:0..<48 {#assert o[i]==base[i];}
    best:=480.0;for k:1..<5 {f:=dl_run(t,head,prompt[..],48,4,k,c[..],o[..]);if f.time<best {best=f.time;}}
    #assert r.time<=best;
}
#test "run refusals" {
    x:=dl_pair(1,0.5);
    t:=DhCell.{vocab=8,width=4,recur=x.recur[..],embed=x.embed[..],out=x.out[..]};
    prompt:=[3]int.[1,2,3];o:[48]int;c:=[5]f64.[10,12,14,16,18];
    #assert dl_run(t,t,prompt[..],48,4,-1,c[..],o[..]).status==DlStatus.ok;
    #assert dl_run(t,t,prompt[..],48,0,-1,c[0..<1],o[..]).status==DlStatus.shape;
    #assert dl_run(t,t,prompt[..],48,4,5,c[..],o[..]).status==DlStatus.shape;
    #assert dl_run(t,t,prompt[..],48,4,-1,c[0..<4],o[..]).status==DlStatus.shape;
    #assert dl_run(t,t,prompt[..],49,4,-1,c[..],o[..]).status==DlStatus.shape;
    big:[10]f64;for i:0..<10 {big[i]=1;}#assert dl_run(t,t,prompt[..],48,9,-1,big[..],o[..]).status==DlStatus.shape;
    #assert dl_run(t,t,prompt[..],48,8,-1,big[0..<9],o[..]).status==DlStatus.ok;
    c[3]=0;#assert dl_run(t,t,prompt[..],48,4,-1,c[..],o[..]).status==DlStatus.cost;
}
// Greedy parity: whatever the costs, the head and the lengths chosen, the
// tokens equal the target alone's greedy tokens.
#forall "greedy parity at every chosen length" seed:1..<4,costs:0..<4,most:1..<5 #steps 200000000 {
    x:=dl_pair(seed,0.25*cast(f64)(seed%3+1));
    t:=DhCell.{vocab=8,width=4,recur=x.recur[..],embed=x.embed[..],out=x.out[..]};
    head:=DhCell.{vocab=8,width=4,recur=x.hr[..],embed=x.he[..],out=x.out[..]};
    prompt:=[2]int.[seed,7-seed];none:[1]f64;base:[40]int;o:[40]int;
    g:=dh_generate(t,prompt[..],40,true,none[0..<0],base[..]);#assert g.written==40;
    c:[9]f64;for k:0..<most+1 {c[k]=10+cast(f64)(costs*k*k)+cast(f64)k;}
    for fixed:-1..<most+1 {
        r:=dl_run(t,head,prompt[..],40,most,fixed,c[0..<most+1],o[..]);#assert r.status==DlStatus.ok && r.written==40;
        for i:0..<40 {#assert o[i]==base[i];}
        n:=0;for k:0..<most+1 {n+=r.chosen[k];}#assert n==r.rounds && r.target==r.rounds+r.drafted;
    }
}
