// Attention as an exact memory: parabolic keys, hard-max reads, latest write wins.
#load "trace-machine.coax";
#load "../fixtures/memory-vectors.coax";
#authority;

EmStatus :: enum u8 {ok;missing;range;capacity;}
EmRead :: struct {status:EmStatus;value:int;position:int;}
EmSum :: struct {status:EmStatus;numerator:int;denominator:int;}

EM_KEY_MAX :: 1048576;
EM_VALUE_MAX :: 2147483647;

#test "a key on the parabola is the unique best match for its own query" {
    // score(k,q) = 2kq - k*k = q*q - (k-q)*(k-q): largest exactly at k = q.
    for q:-5..<6 {for k:-5..<6 {
        if k!=q {#assert em_score(k,q)+1<=em_score(q,q);}
    }}
    #assert em_score(3,3)==9 && em_score(2,3)==8 && em_score(-3,3)==-27;
    m:=EM_KEY_MAX;#assert em_score(m,m)==m*m && em_score(-m,m)==-3*m*m;
}
#test "reads accept keys exactly at their bounds and refuse one beyond" {
    m:=EM_KEY_MAX;keys:=[3]int.[m,-m,5];values:=[3]int.[1,2,3];
    #assert em_read(keys[..],values[..],3,m).value==1 && em_read(keys[..],values[..],3,-m).value==2;
    #assert em_read(keys[..],values[..],3,m+1).status==EmStatus.range;
    #assert em_read(keys[..],values[..],3,-m-1).status==EmStatus.range;
    keys[0]=m+1;#assert em_read(keys[..],values[..],3,5).status==EmStatus.range;
    keys[0]=-m-1;#assert em_read(keys[..],values[..],3,5).status==EmStatus.range;
    keys[0]=m;keys[2]=m+1;#assert em_read(keys[..],values[..],3,5).status==EmStatus.range;
    #assert em_read(keys[..],values[..],2,m).status==EmStatus.ok;
    #assert em_read(keys[..],values[..],-1,m).status==EmStatus.capacity;
    #assert em_read(keys[..],values[0..<2],3,m).status==EmStatus.capacity;
    #assert em_read(keys[0..<2],values[..],3,m).status==EmStatus.capacity;
    keys[2]=5;#assert em_read(keys[..],values[..],3,5).status==EmStatus.ok;
}
#test "the latest write to a key wins and an absent key is refused" {
    keys:=[5]int.[7,3,7,9,3];values:=[5]int.[10,20,30,40,50];
    a:=em_read(keys[..],values[..],5,7);#assert a.status==EmStatus.ok && a.value==30 && a.position==2;
    b:=em_read(keys[..],values[..],5,3);#assert b.status==EmStatus.ok && b.value==50 && b.position==4;
    c:=em_read(keys[..],values[..],2,7);#assert c.status==EmStatus.ok && c.value==10;
    d:=em_read(keys[..],values[..],5,8);#assert d.status==EmStatus.missing && d.value==0;
    #assert em_read(keys[..],values[..],0,7).status==EmStatus.missing;
    #assert em_read(keys[..],values[..],6,7).status==EmStatus.capacity;
    #assert em_read(keys[..],values[..],5,EM_KEY_MAX+1).status==EmStatus.range;
    keys[1]=-EM_KEY_MAX-1;#assert em_read(keys[..],values[..],5,7).status==EmStatus.range;
}
#forall "reads equal a map that keeps the latest write" seed:0..<24 {
    keys:[40]int;values:[40]int;latest:[9]int;seen:[9]bool;
    x:=(seed*7919+12345)%2147483648;
    for t:0..<40 {
        x=(x*1103515245+12345)%2147483648;k:=x%9-4;
        x=(x*1103515245+12345)%2147483648;v:=x%1000;
        keys[t]=k;values[t]=v;latest[k+4]=v;seen[k+4]=true;
        for q:-4..<5 {
            r:=em_read(keys[..],values[..],t+1,q);
            if seen[q+4] {#assert r.status==EmStatus.ok && r.value==latest[q+4];}
            else {#assert r.status==EmStatus.missing;}
        }
    }
}
#test "uniform keys turn attention into an exact running sum" {
    values:=[5]int.[4,-1,7,0,2];sums:=[5]int.[-9,-9,-9,-9,-9];
    #assert em_prefix_sums(values[..],sums[..])==EmStatus.ok;
    #assert sums[0]==4 && sums[1]==3 && sums[2]==10 && sums[3]==10 && sums[4]==12;
    m:=em_mean(values[..],3);#assert m.status==EmStatus.ok && m.numerator==10 && m.denominator==3;
    #assert em_prefix_sums(values[..],sums[0..<4])==EmStatus.capacity;
    big:=[2]int.[EM_VALUE_MAX,1];two:[2]int;#assert em_prefix_sums(big[..],two[..])==EmStatus.range;
    big[1]=0;#assert em_prefix_sums(big[..],two[..])==EmStatus.ok && two[1]==EM_VALUE_MAX;
    big[0]=-EM_VALUE_MAX;#assert em_mean(big[..],2).numerator==-EM_VALUE_MAX;
    big[1]=-1;#assert em_mean(big[..],2).status==EmStatus.range;
    #assert em_mean(values[..],0).status==EmStatus.capacity && em_mean(values[..],6).status==EmStatus.capacity;
    #assert em_mean(values[..],5).numerator==12 && em_mean(values[..],5).denominator==5;
    many:[257]int;out:[257]int;for i:0..<257 {many[i]=1;}
    #assert em_prefix_sums(many[0..<256],out[..])==EmStatus.ok && out[255]==256;
    #assert em_prefix_sums(many[..],out[..])==EmStatus.capacity;
    #assert em_prefix_sums(values[..],sums[..])==EmStatus.ok;
}
#test "a machine whose memory is attention over its own trace gives the same digest" {
    program:=[13]TmOp.[TmOp.{code=TmCode.push,arg=5},TmOp.{code=TmCode.push,arg=42},TmOp.{code=TmCode.store},
        TmOp.{code=TmCode.push,arg=5},TmOp.{code=TmCode.push,arg=43},TmOp.{code=TmCode.store},
        TmOp.{code=TmCode.push,arg=5},TmOp.{code=TmCode.load},TmOp.{code=TmCode.push,arg=6},TmOp.{code=TmCode.load},
        TmOp.{code=TmCode.add},TmOp.{code=TmCode.out},TmOp.{code=TmCode.ret}];
    t1:[64]int;t2:[64]int;o1:[1]int;o2:[1]int;keys:[16]int;values:[16]int;
    a:=tm_run(program[..],16,t1[..],o1[..],false);
    b:=em_run(program[..],16,t2[..],o2[..],keys[..],values[..],false);
    #assert a.status==TmStatus.ok && b.status==TmStatus.ok && o1[0]==43 && o2[0]==43 && a.steps==b.steps;
    for i:0..<32 {#assert a.digest[i]==b.digest[i];}
    for i:0..<a.steps*TM_TOKENS {#assert t1[i]==t2[i];}
    #assert em_run(program[..],16,t2[..],o2[..],keys[0..<1],values[..],false).status==TmStatus.capacity;
}

#test "the attention machine bounds its step budget like the interpreter" {
    rets:[1]TmOp;rets[0]=TmOp.{code=TmCode.ret};trace:[4]int;outputs:[1]int;keys:[1]int;values:[1]int;
    #assert em_run(rets[..],TM_STEPS_MAX,trace[..],outputs[..],keys[..],values[..],false).status==TmStatus.ok;
    #assert em_run(rets[..],TM_STEPS_MAX+1,trace[..],outputs[..],keys[..],values[..],false).status==TmStatus.budget;
    #assert em_run(rets[..],0,trace[..],outputs[..],keys[..],values[..],false).status==TmStatus.budget;
    #assert em_run(rets[..],1,trace[..],outputs[0..<0],keys[..],values[..],false).status==TmStatus.capacity;
    #assert em_run(rets[..],1,trace[..],outputs[..],keys[..],values[..],true).status==TmStatus.alias;
    #assert em_run(rets[0..<0],1,trace[..],outputs[..],keys[..],values[..],false).status==TmStatus.shape;
}

// book:begin score
// Key k sits at the point (2k, -k*k); query q is the direction (q, 1).
// Their dot product is q*q - (k-q)*(k-q), so the match k = q scores highest
// by at least 1 over every other integer key.
em_score :: (k:int,q:int)->int {return 2*k*q-k*k;}
// book:end score

// book:begin read
em_read :: (keys:[]int,values:[]int,count:int,q:int)->EmRead #export_c {
    if count<0 || count>keys.count || count>values.count {return EmRead.{status=EmStatus.capacity};}
    if q< -EM_KEY_MAX || q>EM_KEY_MAX {return EmRead.{status=EmStatus.range};}
    for t:0..<count {if keys[t]< -EM_KEY_MAX || keys[t]>EM_KEY_MAX {return EmRead.{status=EmStatus.range};}}
    if count==0 {return EmRead.{status=EmStatus.missing};}
    // Hard max; on a tie the later write replaces the earlier one.
    best:=0;
    for t:1..<count {if em_score(keys[t],q)>=em_score(keys[best],q) {best=t;}}
    // The read is exact only if the winning key is the one asked for.
    if keys[best]!=q {return EmRead.{status=EmStatus.missing};}
    return EmRead.{value=values[best],position=best};
}
// book:end read

// book:begin sum
// Equal scores give every earlier position the same weight 1/t, so attention
// returns the mean; the mean times t is the running sum, exact as a fraction.
em_mean :: (values:[]int,count:int)->EmSum #export_c {
    if count<1 || count>values.count {return EmSum.{status=EmStatus.capacity};}
    n:=0;for t:0..<count {n+=values[t];if n< -EM_VALUE_MAX || n>EM_VALUE_MAX {return EmSum.{status=EmStatus.range};}}
    return EmSum.{numerator=n,denominator=count};
}
em_prefix_sums :: (values:[]int,sums:[]int)->EmStatus #export_c {
    stage:[256]int;if sums.count<values.count || values.count>256 {return EmStatus.capacity;}
    for t:0..<values.count {
        m:=em_mean(values,t+1);if m.status!=EmStatus.ok {return m.status;}
        stage[t]=m.numerator;  // mean (numerator/denominator) times t+1
    }
    for t:0..<values.count {sums[t]=stage[t];}
    return EmStatus.ok;
}
// book:end sum

// book:begin run
// The chapter 165 machine with no memory of its own: before every step its
// view of memory is rebuilt from nothing but hard-max reads over the stores
// already in its trace, and an address never stored reads as zero.
em_pass :: (program:[]TmOp,budget:int,trace:[]int,outputs:[]int,keys:[]int,values:[]int,publish:bool)->TmResult {
    s:TmState;ip:=0;steps:=0;stores:=0;stage_out:[64]int;row:[4]int;bytes:[16]u8;
    sha:[112]u8;ok:=sha256_init(sha[..])==SHA_OK;
    while true {
        if ip==program.count {return TmResult.{status=TmStatus.fell,ip=ip,steps=steps};}
        if steps>=budget {return TmResult.{status=TmStatus.budget,ip=ip,steps=steps};}
        view:[64]int;
        for c:0..<TM_CELLS {view[c]=em_read(keys,values,stores,c).value;}
        r:=tm_step(program,ip,s,view[..],row[..]);
        if r.status!=TmStatus.ok {return TmResult.{status=r.status,ip=ip,steps=steps};}
        if program[ip].code==TmCode.store {
            if stores>=keys.count || stores>=values.count {return TmResult.{status=TmStatus.capacity,ip=ip,steps=steps};}
            keys[stores]=row[3];values[stores]=row[2];stores+=1;
        }
        if r.state.outputs>s.outputs {stage_out[s.outputs]=row[2];}
        if (steps+1)*TM_TOKENS>trace.count || r.state.outputs>outputs.count {return TmResult.{status=TmStatus.capacity,ip=ip,steps=steps};}
        if publish {for t:0..<TM_TOKENS {trace[steps*TM_TOKENS+t]=row[t];}}
        tm_bytes(row[..],bytes[..]);ok=ok && sha256_update_checked(sha[..],bytes[..],false)==SHA_OK;
        s=r.state;steps+=1;
        if r.next<0 {break;}
        ip=r.next;
    }
    result:=TmResult.{ip=ip,steps=steps,outputs=s.outputs};
    ok=ok && sha256_final_checked(sha[..],result.digest[..],false)==SHA_OK;
    if !ok {return TmResult.{status=TmStatus.digest};}
    for i:0..<s.outputs {outputs[i]=stage_out[i];}
    return result;
}
em_run :: (program:[]TmOp,budget:int,trace:[]int,outputs:[]int,keys:[]int,values:[]int,overlap:bool)->TmResult #export_c {
    admitted:=tm_admit(program);if admitted!=TmStatus.ok {return TmResult.{status=admitted};}
    if budget<1 || budget>TM_STEPS_MAX {return TmResult.{status=TmStatus.budget};}
    if outputs.count<1 {return TmResult.{status=TmStatus.capacity};}
    if overlap {return TmResult.{status=TmStatus.alias};}
    first:=em_pass(program,budget,trace,outputs,keys,values,false);
    if first.status!=TmStatus.ok {return first;}
    return em_pass(program,budget,trace,outputs,keys,values,true);
}
// book:end run
