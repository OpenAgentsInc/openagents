// Extended Ch 230 3-way differential harness for unified Attention+FFN blocks
// (exec-vm-v1). Runs every generated Attention+FFN graph three independent ways
// (reference evaluator, schedule/plan interpreter, compiled dense weights) and
// localizes every planted fault to `schedule` vs `emission`.
#load "exec-vm-core.coax";
#authority;

EvWhere :: enum u8 { none; schedule; emission; }

EvHRun :: struct {
    status: EvStatus;
    where: EvWhere;
    node: int;
}

EvHCatch :: struct {
    status: EvStatus;
    graphs: int;
    skipped: int;
    caught: bool;
    graph: int;
    node: int;
    where: EvWhere;
}

EVH_NODES_MAX :: 24;
EVH_KV_COUNT :: 6;
EVH_KV_SLOTS :: 5;
EVH_RUNS_MAX :: 500;

EvHCase :: struct {
    count: int;
    inputs: int;
    values: [3]int;
    outputs: [2]int;
    kv_ctx: [EVH_KV_COUNT * EVH_KV_SLOTS]int;
}

evh_next :: (x: int) -> int #effects(all) { return (x * 1103515245 + 12345) % 2147483648; }

// Read a linear form over base nodes through the scheduled residual slots.
evh_eval_form :: (f: EvForm, slot: []int, s: []int) -> int #effects(all) {
    sum := 0;
    for t: 0..<f.count { sum += f.coefs[t] * s[slot[f.slots[t]]]; }
    return sum;
}

// Execute the compiler's own Attention+FFN schedule in integers over residual slots:
// reads from start-of-layer snapshot, adds attention/FFN gate outputs into their
// assigned slots, and subtracts cleared slots in FFN layers.
evh_interpret :: (m: EvModel, nodes: []EvNode, outputs: []int, arena: EvCompileArena, inputs: []int, kv_ctx: []int, kv_count: int, values: []int, read: []int) -> EvResult #export_c #effects(all) {
    if m.status != EvStatus.ok { return EvResult.{status = m.status}; }
    if nodes.count != m.n_nodes { return EvResult.{status = EvStatus.shape}; }
    if inputs.count != m.n_inputs || values.count < nodes.count || read.count < outputs.count || m.width > 64 {
        return EvResult.{status = EvStatus.capacity};
    }
    if kv_count < 0 || kv_ctx.count < kv_count * m.kv_slots { return EvResult.{status = EvStatus.capacity}; }
    s: [64]int;
    v: [EVH_NODES_MAX]int;
    if nodes.count > EVH_NODES_MAX { return EvResult.{status = EvStatus.capacity}; }
    s[0] = 1;
    for i: 0..<nodes.count {
        if nodes[i].op == EvOp.input { s[arena.slot[i]] = inputs[nodes[i].k]; }
    }
    for li: 0..<m.n_layers {
        L := li + 1;
        start := s;
        if m.layers[li].kind == EvLayerKind.attn {
            for i: 0..<nodes.count {
                nd := nodes[i];
                if arena.layer[i] == L && ev_is_attn(nd.op) {
                    x := 0;
                    if nd.op == EvOp.attn_read && kv_count > 0 {
                        q := evh_eval_form(arena.forms[nd.a], arena.slot, start[..]);
                        best := 0;
                        best_sc := kv_ctx[nd.b] * q + kv_ctx[nd.c];
                        for p: 1..<kv_count {
                            sc := kv_ctx[p * m.kv_slots + nd.b] * q + kv_ctx[p * m.kv_slots + nd.c];
                            if sc >= best_sc { best_sc = sc; best = p; }
                        }
                        x = kv_ctx[best * m.kv_slots + nd.k];
                    }
                    if nd.op == EvOp.attn_sum {
                        for p: 0..<kv_count { x += kv_ctx[p * m.kv_slots + nd.k]; }
                    }
                    s[arena.slot[i]] += x;
                    v[i] = x;
                }
            }
        } else {
            for i: 1..<nodes.count {
                nd := nodes[i];
                if arena.layer[i] == L && ev_is_ffn(nd.op) {
                    a := evh_eval_form(arena.forms[nd.a], arena.slot, start[..]);
                    x: int;
                    if nd.op == EvOp.mul { x = a * evh_eval_form(arena.forms[nd.b], arena.slot, start[..]); }
                    if nd.op == EvOp.relu { x = ev_relu_int(a); }
                    if nd.op == EvOp.step { x = ev_relu_int(a) - ev_relu_int(a - 1); }
                    if nd.op == EvOp.eq0 { x = 1 - (ev_relu_int(a) - ev_relu_int(a - 1)) - (ev_relu_int(-a) - ev_relu_int(-a - 1)); }
                    if nd.op == EvOp.select {
                        b := evh_eval_form(arena.forms[nd.b], arena.slot, start[..]);
                        c := evh_eval_form(arena.forms[nd.c], arena.slot, start[..]);
                        x = b + (a - b) * ev_relu_int(c);
                    }
                    if nd.op == EvOp.mask {
                        b := evh_eval_form(arena.forms[nd.b], arena.slot, start[..]);
                        x = a * ev_relu_int(b);
                    }
                    s[arena.slot[i]] += x;
                    v[i] = x;
                }
            }
            for i: 0..<nodes.count {
                if arena.clear[i] == L { s[arena.slot[i]] -= start[arena.slot[i]]; }
            }
        }
    }
    for i: 0..<nodes.count {
        nd := nodes[i];
        if nd.op == EvOp.input { v[i] = inputs[nd.k]; }
        if nd.op == EvOp.constant { v[i] = nd.k; }
        if nd.op == EvOp.add { v[i] = v[nd.a] + v[nd.b]; }
        if nd.op == EvOp.sub { v[i] = v[nd.a] - v[nd.b]; }
        if nd.op == EvOp.scale { v[i] = v[nd.a] * nd.k; }
        values[i] = v[i];
    }
    for k: 0..<outputs.count {
        read[k] = evh_eval_form(arena.forms[outputs[k]], arena.slot, s[..]);
    }
    return EvResult.{};
}

evh_first_diff :: (a: []int, b: []int) -> int #effects(all) {
    for i: 0..<a.count { if a[i] != b[i] { return i; } }
    return -1;
}

// Run one unified Attention+FFN graph three ways: evaluator vs plan interpreter vs compiled dense weights.
evh_run :: (nodes: []EvNode, outputs: []int, inputs: []int, kv_ctx: []int, kv_count: int, kv_slots: int, fault: EvFault) -> EvHRun #export_c #effects(all) {
    if nodes.count < 1 || nodes.count > EVH_NODES_MAX || outputs.count < 1 || outputs.count > 4 {
        return EvHRun.{status = EvStatus.shape};
    }
    every: [EVH_NODES_MAX]int;
    for i: 1..<nodes.count { every[i] = i; }
    want: [EVH_NODES_MAX]int;
    sc: [EVH_NODES_MAX]int;
    e := ev_eval(nodes, inputs, kv_ctx, kv_count, kv_slots, every[0..<nodes.count], want[..], sc[..]);
    if e.status != EvStatus.ok { return EvHRun.{status = e.status, node = e.node}; }

    forms: [EVH_NODES_MAX]EvForm; layer: [EVH_NODES_MAX]int; last: [EVH_NODES_MAX]int;
    slot: [EVH_NODES_MAX]int; clear: [EVH_NODES_MAX]int; release: [EVH_NODES_MAX]int;
    kept: [EVH_NODES_MAX]bool; free_slots: [64]bool; ep: [1]int;
    arena := EvCompileArena.{
        forms = forms[..], layer = layer[..], last = last[..], slot = slot[..],
        clear = clear[..], release = release[..], kept = kept[..], free_slots = free_slots[..],
        kv_pin = ep[0..<0]
    };
    layers: [24]EvLayerDesc; heads: [16]EvHeadDesc; weights: [32768]f64;
    m := ev_compile_planted(nodes, outputs, kv_slots, arena, layers[..], heads[..], weights[..], fault);
    if m.status != EvStatus.ok { return EvHRun.{status = m.status, node = m.node}; }

    planned: [EVH_NODES_MAX]int; read: [4]int;
    #assert evh_interpret(m, nodes, outputs, arena, inputs, kv_ctx, kv_count, planned[..], read[..]).status == EvStatus.ok;
    first := evh_first_diff(planned[0..<nodes.count], want[0..<nodes.count]);
    if first != -1 { return EvHRun.{where = EvWhere.schedule, node = first}; }
    for k: 0..<outputs.count {
        if read[k] != want[outputs[k]] { return EvHRun.{where = EvWhere.schedule, node = outputs[k]}; }
    }

    // Pad KV vectors from kv_slots to model.width for the dense transformer forward pass.
    D := m.width;
    kv_f: [EVH_KV_COUNT * 64]f64;
    for s: 0..<kv_count {
        for c: 0..<kv_slots { kv_f[s * D + c] = f64(kv_ctx[s * kv_slots + c]); }
    }
    in_f: [3]f64;
    for k: 0..<inputs.count { in_f[k] = f64(inputs[k]); }
    ex_x: [64]f64; ex_st: [64]f64; ex_h: [256]f64;
    exec := EvExecArena.{x = ex_x[..], stage = ex_st[..], hidden = ex_h[..]};
    res_v: [64]f64; got: [4]f64;
    #assert ev_forward_token(m, in_f[0..<inputs.count], kv_f[0..<kv_count * D], kv_count, res_v[..], got[..], exec, false) == EvStatus.ok;
    for k: 0..<outputs.count {
        if got[k] != f64(read[k]) { return EvHRun.{where = EvWhere.emission, node = outputs[k]}; }
    }
    return EvHRun.{};
}

// Generate a deterministic mixed Attention+FFN graph with duplicate & distinct
// parabolic keys, uniform prefix sum, multi-layer FFN reuse, and second-wave attention.
evh_case :: (seed: int, graph: int, nodes: []EvNode) -> EvHCase #export_c #effects(all) {
    c: EvHCase;
    x := evh_next(((seed % 65536) * 2654435 + (graph % 65536) * 7919 + 13) % 2147483648);
    // 6-token KV context [1, 2k, -k^2, val, delta] with repeated keys so recency tie-break matters.
    // Interior key k0 sits strictly between -k1 and +k1 so flipping -k^2 -> +k^2 picks +/-k1 instead.
    k0 := 1 + (x >> 16) % 3; x = evh_next(x);
    k1 := k0 + 2 + (x >> 16) % 2; x = evh_next(x);
    k2 := -k1;
    keys := [EVH_KV_COUNT]int.[k0, k1, k2, k0, k1, k2];
    for s: 0..<EVH_KV_COUNT {
        x = evh_next(x); v := 1 + (x >> 16) % 40;
        // Distinct values per key and between older vs newer writes so both key-sign and tie-break bugs show.
        if s >= 3 { v = 50 + (s - 3) * 30 + ((x >> 16) % 30); }
        x = evh_next(x); d := ((x >> 16) % 5) - 2;
        base := s * EVH_KV_SLOTS;
        c.kv_ctx[base] = 1;
        c.kv_ctx[base + 1] = 2 * keys[s];
        c.kv_ctx[base + 2] = -keys[s] * keys[s];
        c.kv_ctx[base + 3] = v;
        c.kv_ctx[base + 4] = d;
    }

    // Inputs: 2 inputs; input 0 picks one of the repeated KV keys, input 1 is a small non-zero integer.
    c.inputs = 2;
    x = evh_next(x);
    c.values[0] = keys[(x >> 16) % 3];
    x = evh_next(x);
    v1 := ((x >> 16) % 9) - 4;
    if v1 == 0 { v1 = 2; }
    c.values[1] = v1;

    // Build a 16..20-node interleaved Attention+FFN graph with clearable/reusable slots.
    n := 0;
    nodes[n] = EvNode.{op = EvOp.input, k = 0}; n += 1;                        // 0: q0
    nodes[n] = EvNode.{op = EvOp.input, k = 1}; n += 1;                        // 1: x1
    // Wave 1 Attention: parabolic read at q0 + uniform sum of deltas.
    nodes[n] = EvNode.{op = EvOp.attn_read, a = 0, b = 1, c = 2, k = 3}; n += 1; // 2: a0 = attn(q0)
    nodes[n] = EvNode.{op = EvOp.attn_sum, k = 4}; n += 1;                     // 3: psum
    // Wave 2..4 FFN chain creating reusable/clearable intermediate slots.
    nodes[n] = EvNode.{op = EvOp.relu, a = 2}; n += 1;                         // 4: r1 = relu(a0) (> 0)
    nodes[n] = EvNode.{op = EvOp.relu, a = 4}; n += 1;                         // 5: r2 = relu(r1)
    nodes[n] = EvNode.{op = EvOp.relu, a = 5}; n += 1;                         // 6: r3 = relu(r2)
    nodes[n] = EvNode.{op = EvOp.mul, a = 4, b = 6}; n += 1;                   // 7: m1 = r1 * r3 (r1 live across layers!)
    nodes[n] = EvNode.{op = EvOp.step, a = 1}; n += 1;                         // 8: b0 = step(x1)
    nodes[n] = EvNode.{op = EvOp.constant, k = k1}; n += 1;                    // 9: const k1
    nodes[n] = EvNode.{op = EvOp.select, a = 9, b = 0, c = 8}; n += 1;         // 10: q1 = select(b0, k1, q0)
    // Wave 5 Attention (after FFN!): parabolic read at FFN-computed query q1.
    nodes[n] = EvNode.{op = EvOp.attn_read, a = 10, b = 1, c = 2, k = 3}; n += 1; // 11: a1 = attn(q1)
    // Extra seeded FFN ops on top of a1, m1, psum.
    bits: [10]int; nbits := 1; bits[0] = 8;
    x = evh_next(x);
    extra := 4 + (x >> 16) % 5; // total 16..20 nodes (1 + extra <= 9 bits fit in bits[10])
    for e: 0..<extra {
        x = evh_next(x); pick := (x >> 16) % 8;
        x = evh_next(x); a := 2 + (x >> 16) % (n - 2);
        x = evh_next(x); b := 2 + (x >> 16) % (n - 2);
        nd := EvNode.{op = EvOp.relu, a = a};
        if pick == 0 { nd = EvNode.{op = EvOp.add, a = a, b = b}; }
        else if pick == 1 { nd = EvNode.{op = EvOp.sub, a = a, b = b}; }
        else if pick == 2 { nd = EvNode.{op = EvOp.step, a = a}; }
        else if pick == 3 { nd = EvNode.{op = EvOp.eq0, a = a}; }
        else if pick == 4 { nd = EvNode.{op = EvOp.mask, a = a, b = bits[(x >> 16) % nbits]}; }
        else if pick == 5 { nd = EvNode.{op = EvOp.select, a = a, b = b, c = bits[(x >> 16) % nbits]}; }
        else if pick == 6 { nd = EvNode.{op = EvOp.mul, a = a, b = b}; }
        nodes[n] = nd;
        if ev_bit(nd.op) { bits[nbits] = n; nbits += 1; }
        n += 1;
    }
    // Combine m1 (7), a1 (11), psum (3), and last node so both attention waves and FFN chain stay observable.
    nodes[n] = EvNode.{op = EvOp.add, a = 7, b = 11}; n += 1;
    nodes[n] = EvNode.{op = EvOp.add, a = n - 1, b = n - 2}; n += 1;
    c.count = n;
    c.outputs[0] = n - 1;
    c.outputs[1] = n - 2;
    return c;
}

evh_count_ok :: (count: int) -> bool #effects(all) { return count >= 1 && count <= EVH_RUNS_MAX; }

evh_differential :: (seed: int, count: int, fault: EvFault) -> EvHCatch #export_c #effects(all) {
    if !evh_count_ok(count) { return EvHCatch.{status = EvStatus.shape}; }
    res: EvHCatch;
    nodes: [EVH_NODES_MAX]EvNode;
    for g: 0..<count {
        c := evh_case(seed, g, nodes[..]);
        r := evh_run(nodes[0..<c.count], c.outputs[..], c.values[0..<c.inputs], c.kv_ctx[..], EVH_KV_COUNT, EVH_KV_SLOTS, fault);
        if r.status != EvStatus.ok {
            res.skipped += 1;
        } else {
            res.graphs += 1;
            if r.where != EvWhere.none {
                res.caught = true;
                res.graph = g;
                res.node = r.node;
                res.where = r.where;
                return res;
            }
        }
    }
    return res;
}

// ---- Tests ----

#test "pinned Attention+FFN generator cases are deterministic and well-formed" {
    // Cheap fast-killer pin over 36 generated cases across seeds [1,2,3,4,20,10000] (filled from garbage so every write is observed).
    h := 17;
    nodes: [EVH_NODES_MAX]EvNode;
    seeds := [6]int.[1, 2, 3, 4, 20, 10000];
    for seed: seeds {
        for g: 0..<6 {
            for i: 0..<EVH_NODES_MAX { nodes[i] = EvNode.{op = EvOp.constant, a = 99, b = 99, c = 99, k = 99}; }
            c := evh_case(seed, g, nodes[..]);
            h = ((h * 131 + c.count + 10007) % 2147483647 + 2147483647) % 2147483647;
            h = ((h * 131 + c.inputs + 10007) % 2147483647 + 2147483647) % 2147483647;
            h = ((h * 131 + c.values[0] + 10007) % 2147483647 + 2147483647) % 2147483647;
            h = ((h * 131 + c.values[1] + 10007) % 2147483647 + 2147483647) % 2147483647;
            h = ((h * 131 + c.outputs[0] + 10007) % 2147483647 + 2147483647) % 2147483647;
            h = ((h * 131 + c.outputs[1] + 10007) % 2147483647 + 2147483647) % 2147483647;
            for v: c.kv_ctx { h = ((h * 131 + v + 10007) % 2147483647 + 2147483647) % 2147483647; }
            for i: 0..<c.count {
                nd := nodes[i];
                h = ((h * 131 + cast(int)nd.op + 10007) % 2147483647 + 2147483647) % 2147483647;
                h = ((h * 131 + nd.a + 10007) % 2147483647 + 2147483647) % 2147483647;
                h = ((h * 131 + nd.b + 10007) % 2147483647 + 2147483647) % 2147483647;
                h = ((h * 131 + nd.c + 10007) % 2147483647 + 2147483647) % 2147483647;
                h = ((h * 131 + nd.k + 10007) % 2147483647 + 2147483647) % 2147483647;
                h = ((h * 131 + cast(int)nd.mask + 10007) % 2147483647 + 2147483647) % 2147483647;
            }
        }
    }
    #assert h == 611157344;
    nodes2: [EVH_NODES_MAX]EvNode;
    c_big := evh_case(65537, 65538, nodes[..]);
    c_sm  := evh_case(1, 2, nodes2[..]);
    #assert c_big.count == c_sm.count && c_big.values[0] == c_sm.values[0] && c_big.values[1] == c_sm.values[1];
    for i: 0..<EVH_KV_COUNT * EVH_KV_SLOTS { #assert c_big.kv_ctx[i] == c_sm.kv_ctx[i]; }
    for i: 0..<c_sm.count { #assert nodes[i].op == nodes2[i].op && nodes[i].a == nodes2[i].a && nodes[i].b == nodes2[i].b; }
}

#test "honest Attention+FFN compiler agrees three ways on generated graphs" {
    #assert evh_count_ok(1) && evh_count_ok(EVH_RUNS_MAX) && !evh_count_ok(0) && !evh_count_ok(EVH_RUNS_MAX + 1);
    #assert evh_differential(1, 0, EvFault.none).status == EvStatus.shape;
    r := evh_differential(1, 8, EvFault.none);
    #assert r.status == EvStatus.ok && !r.caught && r.graphs == 8 && r.skipped == 0;
    // Seed 6 has 1 out-of-range graph skipped and counted (never treated as agreement).
    r2 := evh_differential(6, 12, EvFault.none);
    #assert r2.status == EvStatus.ok && !r2.caught && r2.graphs == 11 && r2.skipped == 1;
}

#test "all 7 planted Attention and FFN bugs are 100% caught and accurately attributed to schedule vs emission" {
    for seed: 1..<4 {
        c0 := evh_differential(seed, 12, EvFault.early_reuse);
        #assert c0.status == EvStatus.ok && c0.caught && c0.where == EvWhere.schedule;
        c1 := evh_differential(seed, 12, EvFault.same_layer);
        #assert c1.status == EvStatus.ok && c1.caught && c1.where == EvWhere.schedule;
        c2 := evh_differential(seed, 12, EvFault.no_clear);
        #assert c2.status == EvStatus.ok && c2.caught && c2.where == EvWhere.schedule;
        c3 := evh_differential(seed, 12, EvFault.attn_same_layer);
        #assert c3.status == EvStatus.ok && c3.caught && c3.where == EvWhere.schedule;
        c4 := evh_differential(seed, 12, EvFault.clear_sign);
        #assert c4.status == EvStatus.ok && c4.caught && c4.where == EvWhere.emission;
        c5 := evh_differential(seed, 12, EvFault.attn_key_sign);
        #assert c5.status == EvStatus.ok && c5.caught && c5.where == EvWhere.emission;
        c6 := evh_differential(seed, 12, EvFault.attn_tie_break);
        #assert c6.status == EvStatus.ok && c6.caught && c6.where == EvWhere.emission;
    }
    // Replay localization check on seed 1 for all 7 faults.
    faults := [7]EvFault.[
        EvFault.early_reuse, EvFault.same_layer, EvFault.no_clear, EvFault.attn_same_layer,
        EvFault.clear_sign, EvFault.attn_key_sign, EvFault.attn_tie_break
    ];
    for fi: 0..<7 {
        c := evh_differential(1, 12, faults[fi]);
        nodes: [EVH_NODES_MAX]EvNode;
        k := evh_case(1, c.graph, nodes[..]);
        rep := evh_run(nodes[0..<k.count], k.outputs[..], k.values[0..<k.inputs], k.kv_ctx[..], EVH_KV_COUNT, EVH_KV_SLOTS, faults[fi]);
        #assert rep.status == EvStatus.ok && rep.where == c.where && rep.node == c.node;
    }
}

#test "harness helper refusals and schedule interpreter edge cases" {
    a := [3]int.[1, 2, 3]; b := [3]int.[1, 2, 3];
    #assert evh_first_diff(a[..], b[..]) == -1;
    b[2] = 9; #assert evh_first_diff(a[..], b[..]) == 2;
    b[0] = 8; #assert evh_first_diff(a[..], b[..]) == 0;
    nodes: [25]EvNode;
    nodes[0] = EvNode.{op = EvOp.input, k = 0};
    for i: 1..<25 { nodes[i] = EvNode.{op = EvOp.relu, a = i - 1}; }
    outs := [4]int.[1, 1, 1, 1]; ins := [1]int.[5]; kv: [5]int;
    #assert evh_run(nodes[0..<0], outs[0..<1], ins[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.shape;
    #assert evh_run(nodes[0..<25], outs[0..<1], ins[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.shape;
    #assert evh_run(nodes[0..<24], outs[0..<4], ins[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.ok;
    #assert evh_run(nodes[0..<2], outs[0..<0], ins[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.shape;
    outs5: [5]int;
    #assert evh_run(nodes[0..<2], outs5[..], ins[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.shape;
    #assert evh_run(nodes[0..<2], outs[0..<1], ins[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.ok;
    // Output-only stale slot caught in schedule via read[k] != want[outputs[k]]; 1-output clear_sign caught in emission!
    r_nc := evh_run(nodes[0..<2], outs[0..<1], ins[..], kv[0..<0], 0, 0, EvFault.no_clear);
    #assert r_nc.where == EvWhere.schedule && r_nc.node == 1;
    r_cs := evh_run(nodes[0..<2], outs[0..<1], ins[..], kv[0..<0], 0, 0, EvFault.clear_sign);
    #assert r_cs.where == EvWhere.emission && r_cs.node == 1;
    // 1-node attn_sum at index 0 reading KV slot 0 (exercises nodes.count==1, i==0 in attn layer, and c==0 KV copy).
    g_one := [1]EvNode.[EvNode.{op = EvOp.attn_sum, k = 0}];
    o_one := [1]int.[0]; kv_one := [1]int.[1]; empty_in: [1]int;
    r_one := evh_run(g_one[..], o_one[..], empty_in[0..<0], kv_one[..], 1, 1, EvFault.none);
    #assert r_one.status == EvStatus.ok && r_one.where == EvWhere.none;
    // Range refusal from evaluator and terms refusal from compiler propagate cleanly.
    g_rng := [3]EvNode.[EvNode.{op = EvOp.input, k = 0}, EvNode.{op = EvOp.mul, a = 0, b = 0}, EvNode.{op = EvOp.mul, a = 1, b = 1}];
    o_rng := [1]int.[2]; in_big := [1]int.[300];
    #assert evh_run(g_rng[..], o_rng[..], in_big[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.range;
    g_sc := [4]EvNode.[
        EvNode.{op = EvOp.input, k = 0}, EvNode.{op = EvOp.scale, a = 0, k = EV_VALUE_MAX},
        EvNode.{op = EvOp.scale, a = 0, k = EV_VALUE_MAX}, EvNode.{op = EvOp.add, a = 1, b = 2}
    ];
    g_sc2 := [5]EvNode.[g_sc[0], g_sc[1], g_sc[2], g_sc[3], EvNode.{op = EvOp.add, a = 3, b = 0}];
    o_sc2 := [1]int.[4]; in_one := [1]int.[0];
    #assert evh_run(g_sc2[..], o_sc2[..], in_one[..], kv[0..<0], 0, 0, EvFault.none).status == EvStatus.range;
    // Scale, eq0, mask, constant, sub, add, attn_read (empty & 1-token), attn_sum in evh_interpret!
    g_all := [9]EvNode.[
        EvNode.{op = EvOp.input, k = 0},
        EvNode.{op = EvOp.constant, k = -3},
        EvNode.{op = EvOp.scale, a = 0, k = 4},
        EvNode.{op = EvOp.add, a = 2, b = 1},
        EvNode.{op = EvOp.sub, a = 3, b = 0},
        EvNode.{op = EvOp.eq0, a = 0},
        EvNode.{op = EvOp.mask, a = 4, b = 5},
        EvNode.{op = EvOp.attn_read, a = 0, b = 1, c = 2, k = 3},
        EvNode.{op = EvOp.attn_sum, k = 4}
    ];
    o_all := [3]int.[4, 6, 7];
    in0 := [1]int.[0];
    kv1 := [5]int.[1, 0, 0, 17, 9];
    #assert evh_run(g_all[..], o_all[..], in0[..], kv1[..], 1, 5, EvFault.none).status == EvStatus.ok;
    #assert evh_run(g_all[..], o_all[..], in0[..], kv1[0..<0], 0, 5, EvFault.none).status == EvStatus.ok;
    // Interpreter refusals & exact boundaries: bad status, wrong node count, capacity, width 64 vs 65, nodes 24 vs 25.
    forms: [25]EvForm; layer: [25]int; last: [25]int; slot: [25]int;
    clear: [25]int; release: [25]int; kept: [25]bool; free_slots: [64]bool; ep: [1]int;
    arena := EvCompileArena.{
        forms = forms[..], layer = layer[..], last = last[..], slot = slot[..],
        clear = clear[..], release = release[..], kept = kept[..], free_slots = free_slots[..],
        kv_pin = ep[0..<0]
    };
    layers: [25]EvLayerDesc; heads: [4]EvHeadDesc; weights: [8192]f64;
    m := ev_compile(g_all[..], o_all[..], 5, arena, layers[..], heads[..], weights[..]);
    vals: [25]int; rd: [3]int;
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in0[..], kv1[..], 1, vals[0..<9], rd[0..<3]).status == EvStatus.ok;
    #assert vals[2] == 0 && vals[4] == -3 && vals[6] == -3 && vals[7] == 17 && vals[8] == 9 && rd[0] == -3 && rd[1] == -3 && rd[2] == 17;
    in2 := [1]int.[2];
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in2[..], kv1[..], 1, vals[0..<9], rd[0..<3]).status == EvStatus.ok;
    #assert vals[2] == 8 && vals[4] == 3 && vals[6] == 0 && rd[0] == 3 && rd[1] == 0;
    // Negative input exercises eq0(-2)==0 and eq0(-1)==0 in evh_interpret; 3-token & 2-token KVs exercise parabolic score & tie-break!
    in_n2 := [1]int.[-2];
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in_n2[..], kv1[..], 1, vals[0..<9], rd[0..<3]).status == EvStatus.ok;
    #assert vals[5] == 0 && vals[6] == 0;
    in_n1 := [1]int.[-1];
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in_n1[..], kv1[..], 1, vals[0..<9], rd[0..<3]).status == EvStatus.ok && vals[5] == 0;
    kv3 := [15]int.[
        1, -2, -1, 11, 1, // k=-1: score at q=2 is -5
        1,  4, -4, 99, 2, // k=2:  score at q=2 is 4 (best!)
        1,  2, -1, 77, 3  // k=1:  score at q=2 is 3 (beats -5, loses to 4!)
    ];
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in2[..], kv3[..], 3, vals[0..<9], rd[0..<3]).status == EvStatus.ok && vals[7] == 99;
    kv2_first := [10]int.[
        1,  4, -4, 88, 1, // k=2: score at q=2 is 4 (best!)
        1, -2, -1, 11, 2  // k=-1: score at q=2 is -5
    ];
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in2[..], kv2_first[..], 2, vals[0..<9], rd[0..<3]).status == EvStatus.ok && vals[7] == 88;
    bm := m; bm.status = EvStatus.shape;
    #assert evh_interpret(bm, g_all[..], o_all[..], arena, in0[..], kv1[..], 1, vals[..], rd[..]).status == EvStatus.shape;
    #assert evh_interpret(m, g_all[0..<8], o_all[..], arena, in0[..], kv1[..], 1, vals[..], rd[..]).status == EvStatus.shape;
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in0[0..<0], kv1[..], 1, vals[..], rd[..]).status == EvStatus.capacity;
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in0[..], kv1[..], 1, vals[0..<8], rd[..]).status == EvStatus.capacity;
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in0[..], kv1[..], 1, vals[..], rd[0..<2]).status == EvStatus.capacity;
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in0[..], kv1[..], -1, vals[..], rd[..]).status == EvStatus.capacity;
    #assert evh_interpret(m, g_all[..], o_all[..], arena, in0[..], kv1[0..<4], 1, vals[..], rd[..]).status == EvStatus.capacity;
    bm = m; bm.width = 64;
    #assert evh_interpret(bm, g_all[..], o_all[..], arena, in0[..], kv1[..], 1, vals[..], rd[..]).status == EvStatus.ok;
    bm.width = 65;
    #assert evh_interpret(bm, g_all[..], o_all[..], arena, in0[..], kv1[..], 1, vals[..], rd[..]).status == EvStatus.capacity;
    m25 := ev_compile(nodes[0..<25], outs[0..<1], 0, arena, layers[..], heads[..], weights[..]);
    #assert m25.status == EvStatus.ok;
    #assert evh_interpret(m25, nodes[0..<25], outs[0..<1], arena, ins[..], kv[0..<0], 0, vals[..], rd[..]).status == EvStatus.capacity;
}
