  worker_pubkey: string;
}

ExwTierResult :: struct { outcome: ExwTierOutcome; tier: int; }
ExwOutlierMetrics :: struct { cosine_to_median_e6: int; l2_norm_e6: int; loss_delta_e6: int; step_distance_ppb: int; }

ExwTrainingVerdict :: struct {
  claim_digest: string;
  outlier_metrics: ExwOutlierMetrics;
  signature: string;
  tier_results: [EXW_TIERS] ExwTierResult;
  n_tiers: int;
