// Single #authority Coax codec for openagents.executor.v1alpha1 and
// openagents.executor-release.v1 (proto/openagents/executor/v1alpha1/*.proto,
// psionic/docs/executor-network-master-spec.md W2.1, GitHub #13914).
//
// Every message serializes to RFC 8785 (JCS) canonical compact JSON with
// lexicographically ordered keys matching protobuf field declaration order.
// Reads enforce closed objects, exact schema pinning, UTF-8 without NUL,
// strict bounds, valid enums, lowercase hex digests, Bitcoin-only networks,
// no-secret/no-invoice invariants, and truthful real_bitcoin_moved semantics.
//   coax/bin/coax test psionic/lib/executor-wire.coax
//   coax/bin/coax mutate psionic/lib/executor-wire.coax
#load "../../coax/lib/json/shape.coax";
#load "../../coax/lib/crypto/sha256-kernel.coax";
#authority;

EXW_SCHEMA_MODULE :: "openagents.executor.module.v1alpha1";
EXW_SCHEMA_PROGRAM_REF :: "openagents.executor.program-ref.v1alpha1";
EXW_SCHEMA_TRACE_RECEIPT :: "openagents.executor.trace-receipt.v1alpha1";
EXW_SCHEMA_REPLAY_VERDICT :: "openagents.executor.replay-verdict.v1alpha1";
EXW_SCHEMA_DATASET_SHARD :: "openagents.executor.dataset-shard.v1alpha1";
EXW_SCHEMA_TRAINING_LEASE :: "openagents.executor.training-lease.v1alpha1";
EXW_SCHEMA_TRAINING_CLAIM :: "openagents.executor.training-claim.v1alpha1";
EXW_SCHEMA_TRAINING_VERDICT :: "openagents.executor.training-verdict.v1alpha1";
EXW_SCHEMA_CHECKPOINT_LINEAGE :: "openagents.executor.checkpoint-lineage.v1alpha1";
EXW_SCHEMA_PAYOUT_INTENT :: "openagents.executor.payout-intent.v1alpha1";
EXW_SCHEMA_SETTLEMENT_RECEIPT :: "openagents.executor.settlement-receipt.v1alpha1";
EXW_SCHEMA_RELEASE :: "openagents.executor-release.v1";

EXW_JSON_MAX :: 65536;
EXW_INT_MAX :: 9007199254740991;
EXW_BAD_INT :: 9007199254740992;
EXW_STEP_MAX :: 1000000000;
EXW_MEM_MAX :: 68719476736;
EXW_ABI_SLOTS_MAX :: 1024;
EXW_SEAM_LAYER_MAX :: 4096;
EXW_SEAM_SLOT_MAX :: 65536;
EXW_SEAMS_MAX :: 64;
EXW_ROW_MAX :: 16;
EXW_TAGS_MAX :: 32;
EXW_TIERS :: 6;
EXW_WINDOWS_MAX :: 64;
EXW_SHARDS_MAX :: 32;
EXW_SUITES_MAX :: 16;
EXW_ARTIFACTS_MAX :: 16;
EXW_COSINE_MAX :: 1000000;
EXW_LOSS_DELTA_MAX :: 1000000000;
EXW_PPM_MAX :: 1000000;

ExwErr :: enum u8 {
  ok;
  truncated;
  schema;
  unknown_field;
  invalid_enum;
  bounds;
  digest;
  secret;
  invariant;
}

ExwOut :: struct { len: int; err: ExwErr; }
ExwArena :: struct { buf: [] u8; n: int; bad: bool; }
ExwBool :: struct { ok: bool; val: bool; }

// ---- Enums matching proto/openagents/executor/v1alpha1/*.proto ----

ExwVerifClass :: enum u8 { unspecified; e_exact_replay; d_deterministic_test; s_statistical; n_unverified; }
ExwReplayOutcome :: enum u8 { unspecified; exact_replay; failed; unverifiable; }
ExwShardSplit :: enum u8 { unspecified; train; validation; held_out; }
ExwTierOutcome :: enum u8 { unspecified; pass; fail; skipped; }
ExwWindowVerdict :: enum u8 { unspecified; accepted; rejected; quarantined; }
ExwPromotionVerdict :: enum u8 { unspecified; promoted; held; rolled_back; }
ExwPayoutLeg :: enum u8 { unspecified; worker; validator; }
ExwRolloutStage :: enum u8 { unspecified; shadow; canary; promoted; rolled_back; }

EXW_VERIF_NAMES :: [4] string.["E_EXACT_REPLAY", "D_DETERMINISTIC_TEST", "S_STATISTICAL", "N_UNVERIFIED"];
EXW_REPLAY_NAMES :: [3] string.["EXACT_REPLAY", "FAILED", "UNVERIFIABLE"];
EXW_SPLIT_NAMES :: [3] string.["TRAIN", "VALIDATION", "HELD_OUT"];
EXW_TIER_NAMES :: [3] string.["PASS", "FAIL", "SKIPPED"];
EXW_WIN_VERDICT_NAMES :: [3] string.["ACCEPTED", "REJECTED", "QUARANTINED"];
EXW_PROMO_NAMES :: [3] string.["PROMOTED", "HELD", "ROLLED_BACK"];
EXW_LEG_NAMES :: [2] string.["WORKER", "VALIDATOR"];
EXW_STAGE_NAMES :: [4] string.["SHADOW", "CANARY", "PROMOTED", "ROLLED_BACK"];
EXW_SCALAR_NAMES :: [4] string.["i32", "i64", "f64", "bytes"];
EXW_NETWORK_NAMES :: [4] string.["bitcoin", "testnet", "signet", "regtest"];
EXW_CHANNEL_NAMES :: [3] string.["shadow", "beta", "stable"];
EXW_PLATFORM_NAMES :: [4] string.["macos-arm64", "linux-x86_64", "linux-arm64", "portable"];
EXW_SECRET_KEYS :: [6] string.["invoice", "bolt11", "preimage", "private_key", "nsec", "mnemonic"];
EXW_SECRET_PREFIXES :: [6] string.["lnbc", "lntb", "lnsb", "nsec1", "xprv", "tprv"];

// ---- Wire records ----

ExwAbi :: struct { max_value: int; min_value: int; scalar_type: string; slot_count: int; }
ExwSeam :: struct { count: int; layer: int; slot: int; upstream_module_sha256: string; }
ExwModule :: struct {
  compiler_hash: string;
  conformance_suite_sha256: string;
  input_abi: ExwAbi;
  max_steps: int;
  memory_bytes: int;
  module_id: string;
  output_abi: ExwAbi;
  profile_id: string;
  seams: [EXW_SEAMS_MAX] ExwSeam;
  n_seams: int;
  verification_class: ExwVerifClass;
  version: string;
  weight_sha256: string;
}

ExwProgramRef :: struct {
  compiler_hash: string;
  executor_artifact_hash: string;
  input_hash: string;
  profile_id: string;
  program_hash: string;
}

ExwTraceReceipt :: struct {
  chunk_merkle_root: string;
  executor_artifact_hash: string;
  finished_at: int;
  input_hash: string;
  job_id: string;
  output_digest: string;
  program_hash: string;
  started_at: int;
  step_count: int;
  trace_digest: string;
  worker_device_ref: string;
  worker_pubkey: string;
}

ExwReplayVerdict :: struct {
  expected_row: [EXW_ROW_MAX] int;
  n_expected: int;
  first_divergent_step: int;
  observed_row: [EXW_ROW_MAX] int;
  n_observed: int;
  receipt_digest: string;
  signature: string;
  validator_device_ref: string;
  validator_pubkey: string;
  verdict: ExwReplayOutcome;
}

ExwDatasetShard :: struct {
  byte_count: int;
  created_at: int;
  exposure_ledger_sha256: string;
  family_tags: [EXW_TAGS_MAX] string;
  n_tags: int;
  record_count: int;
  shard_id: string;
