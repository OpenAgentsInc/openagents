  split: ExwShardSplit;
}

ExwTrainingLease :: struct {
  dataset_shard_sha256: string;
  end_step: int;
  expires_at: int;
  issued_at: int;
  lease_id: string;
  optimizer_state_sha256: string;
  parent_checkpoint_sha256: string;
  random_seed: int;
  start_step: int;
  training_config_sha256: string;
  worker_pubkey: string;
}

ExwLossStats :: struct {
  final_loss_e6: int;
  initial_loss_e6: int;
  max_grad_norm_e6: int;
  non_finite_count: int;
}

ExwTrainingClaim :: struct {
  dataset_shard_sha256: string;
  delta_sha256: string;
  end_step: int;
  lease_id: string;
  loss_stats: ExwLossStats;
  optimizer_state_sha256: string;
