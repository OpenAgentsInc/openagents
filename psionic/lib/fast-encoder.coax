// Chapter 222: a decision in milliseconds. A small encoder with fixed decision
// heads answers a typed question in one pass over at most 512 token IDs.
// Profile fe-tiny-v1, a ModernBERT-shaped stand-in: 64 token IDs, width 16,
// two attention heads of 8, three pre-norm layers (layer 0 attends globally,
// layers 1 and 2 to keys at most 64 positions away), GeGLU feed-forward
// layers of width 32, layer norm without parameters (epsilon 10^-5), no
// position encoding, mean pooling and three heads of 2, 3 and 4 classes with
// temperatures 1, 1/2 and 2. Weights come from SplitMix64 at a counter.
// Two engines run it: fe-f64-reference-v1 computes everything in binary64;
// fe-q8-cpu-v1 reads uint8 embedding rows (a low value and a step per row)
// and runs the four products of each layer through chapter 48's int8 blocks
// of 16; attention, norms and heads stay binary64. The model's identity is
// a hash of its original weights; the engine's identity is its name, and a
// named engine that is not built is refused, never replaced.
// The latency gate decides from warm runs in integer nanoseconds: P50 and P99
// by chapter 18's nearest rank, mean and standard deviation by chapter 34.
#load "quantized.coax";  // chapter 50: the quality card; chapter 48's int8 products
#load "comparator.coax"; // chapter 34: mean and sample standard deviation
#load "counter-rng.coax"; // SplitMix64 at a counter
#load "../fixtures/fast-encoder/oracle.coax";  // the Python oracle's logits
#authority;

// book:begin shape
FE_PROFILE :: "fe-tiny-v1";
FE_VOCAB :: 64;
FE_D :: 16;         // width
FE_HD :: 8;         // width of each of the two attention heads
FE_LAYERS :: 3;
FE_FF :: 32;        // GeGLU width: the up product has 64 rows
FE_WINDOW :: 64;    // a local layer sees keys at most 64 positions away
FE_GLOBAL :: 3;     // layers 0, 3, 6, ... attend globally
FE_TOKENS :: 512;   // the most token IDs one decision reads
FE_BLOCK :: 16;     // int8 block width
FE_CHUNK :: 128;    // tokens per int8 product call
FE_EMB :: 1024;     // 64 rows of 16
FE_LAYER_W :: 2560; // qkv 48 x 16, output 16 x 16, up 64 x 16, down 16 x 32
FE_HEAD_AT :: 8704; // 1024 + 3 x 2560
FE_WEIGHTS :: 8848; // and 9 head rows of 16
FE_CODES :: 7680;   // the int8 codes of the three layers
FE_LOGITS :: 9;
FE_CLASSES :: [3]int.[2,3,4];
FE_CLASS_AT :: [3]int.[0,2,5];
FE_TEMPS :: [3]f64.[1,0.5,2];
// book:end shape
FE_SEED :: cast(u64)222;
FE_EPS :: 0.00001;
FE_SCORE :: 0.35355339059327373;  // 1/sqrt(8)
FE_GELU_C :: 0.7978845608028654;  // sqrt(2/pi)
FE_GELU_A :: 0.044715;
FE_ROW :: 192;                     // binary64 work per token
FE_Q8_BYTES :: 14720;

// book:begin frozen
// Frozen before any measurement.
FE_LOGIT_BOUND :: 0.125;        // the largest |q8 logit - reference logit|
FE_CARD_KL :: 0.001;            // chapter 50's card: mean KL, pessimistic end
FE_CARD_AGREEMENT :: 0.95;      // and top-1 agreement, pessimistic end
FE_P99_LIMIT :: 20000000;       // P99 of a 512-token decision: 20 ms, in ns
FE_SAMPLES_MIN :: 100;          // fewer and nearest-rank P99 is the maximum
// book:end frozen

// book:begin types
FeStatus :: enum u8 {ok;tokens;id;storage;capacity;number;int8;engine;unavailable;}
FeEngine :: enum u8 {none;reference;q8;}
FeChoice :: struct {status:FeStatus;engine:FeEngine;}
// The q8 model: uint8 embedding rows (value = low + step * code) and the
// layers' int8 codes with one f32 scale (and a zero offset) per block of 16.
// The heads stay the original binary64 rows.
FeQ8 :: struct {emb:[]u8;low:[]f64;step:[]f64;codes:[]s8;scales:[]f32;offsets:[]f32;}
// Work: binary64 rows (FE_ROW per token), and the int8 activations of one chunk.
FeWork :: struct {f:[]f64;a:[]f32;codes:[]s8;scales:[]f32;sums:[]s32;dots:[]s32;}
FeParity :: struct {decisions:int;equal:int;worst:f64;ok:bool;}
FeVerdict :: enum u8 {refused;met;missed;}
FeReason :: enum u8 {none;engine;workload;parity;card;samples;}
FeGate :: struct {verdict:FeVerdict;reason:FeReason;n:int;p50:int;p99:int;mean:f64;sd:f64;limit:int;}
// book:end types

// Checks precede the implementation.
fe_model :: (w:[]f64,emb:[]u8,low:[]f64,step:[]f64,codes:[]s8,scales:[]f32,offsets:[]f32)->FeQ8 {
    #assert fe_weights(w)==FeStatus.ok;
    m:=FeQ8.{emb=emb,low=low,step=step,codes=codes,scales=scales,offsets=offsets};
    #assert fe_quantize(w,m)==FeStatus.ok;
    return m;
}
fe_ids :: (seed:int,t:int,ids:[]int) {for i:0..<t {ids[i]=cast(int)(cr_bits(cast(u64)(2220+seed),cast(u64)i)%64);}}
// The q8 engine's logits for fe_ids(3, 130), recorded from its first run: a
// regression pin, not an independent check (the bound above is that).
FE_RECORDED_Q8 :: [9]f64.[-0.5146587923496225,-0.421115295511843,0.16032407498715567,0.5009857039704882,
    -0.09391330051071226,-0.7155833836309408,1.4735106453347406,0.1547328209949981,-0.7851884240405986];
fe_work :: (f:[]f64,a:[]f32,c:[]s8,s:[]f32,m:[]s32,d:[]s32)->FeWork {return FeWork.{f=f,a=a,codes=c,scales=s,sums=m,dots=d};}

#test "the weights: scales by part, and SplitMix64's first words" {
    #assert fe_scale(0)==1 && fe_scale(1023)==1 && fe_scale(1024)==0.5 && fe_scale(1791)==0.5 && fe_scale(1792)==0.25;
    #assert fe_scale(2047)==0.25 && fe_scale(2048)==0.5 && fe_scale(3071)==0.5 && fe_scale(3072)==0.25 && fe_scale(3583)==0.25;
    #assert fe_scale(3584)==0.5 && fe_scale(3584+768)==0.25 && fe_scale(8703)==0.25 && fe_scale(8704)==1 && fe_scale(8847)==1;
    #assert fe_unit(0)==f64(cr_bits(222,0)>>11)/4503599627370496.0-1;
    w:[8848]f64;#assert fe_weights(w[..])==FeStatus.ok && fe_weights(w[0..<8847])==FeStatus.storage;
    for i:0..<FE_WEIGHTS {#assert w[i]==fe_scale(i)*fe_unit(i) && abs(w[i])<=fe_scale(i);}
    #assert w[0]==FE_ORACLE_W0 && w[8847]==FE_ORACLE_W8847 && fe_model_id(w[..])==FE_ORACLE_ID;
    // The identity covers every weight.
    v:=w;v[4000]=f64_from_bits(f64_bits(v[4000])+1);#assert fe_model_id(v[..])!=fe_model_id(w[..]);
    v=w;v[0]=-v[0];#assert fe_model_id(v[..])!=fe_model_id(w[..]);
}
#test "hand values: norm, GELU, tanh and the tempered softmax" {
    // [1, 3, 1, 3, ...]: mean 2, variance 1, so (x - 2)/sqrt(1 + 10^-5).
    x:[16]f64;y:[16]f64;for k:0..<16 {x[k]=f64(1+2*(k%2));}
    fe_norm(x[..],0,y[..],0);r:=1/sqrt(1.00001);
    for k:0..<16 {#assert y[k]==(x[k]-2)*r;}
    #assert f64_bits(fe_tanh(0))==0 && fe_tanh(-400)==-1 && fe_tanh(400)==1 && abs(fe_tanh(0.5)-0.46211715726000974)<=1e-16 && abs(fe_tanh(-1)+0.7615941559557649)<=1e-16;
    #assert fe_gelu(0)==0 && abs(fe_gelu(1)-0.8411919906082768)<=2e-16 && abs(fe_gelu(-1)+0.15880800939172324)<=1e-16;
    // Head 0 at temperature 1: logits 0, ln 3 give 1/4, 3/4. Head 1 at 1/2: 0, ln 3 / 2, 0 give 1/5, 3/5, 1/5.
    // Head 2 at 2: 0, 2 ln 2, 0, 0 give 1/5, 2/5, 1/5, 1/5.
    z:=[9]f64.[0,log(3.0),0,log(3.0)/2,0,0,2*log(2.0),0,0];p:[9]f64;
    fe_probs(z[..],p[..]);
    want:=[9]f64.[0.25,0.75,0.2,0.6,0.2,0.2,0.4,0.2,0.2];
    for i:0..<9 {#assert abs(p[i]-want[i])<=1e-15;}
    // The largest logit is subtracted first, so large logits do not overflow.
    z[0]=0;z[1]=1000;fe_probs(z[..],p[..]);#assert p[0]==0 && p[1]==1;
    z[3]=0;z[4]=800;z[8]=1600;fe_probs(z[..],p[..]);#assert p[4]==1 && p[8]==1 && p[2]==0;
}
#test "masks: layer 0 and 3 see every key, layers 1 and 2 keys at most 64 away" {
    #assert fe_lo(0,100)==0 && fe_hi(0,100,512)==512 && fe_lo(3,100)==0 && fe_hi(3,100,512)==512;
    #assert fe_lo(1,100)==36 && fe_hi(1,100,512)==165 && fe_lo(2,10)==0 && fe_hi(2,10,512)==75;
    #assert fe_lo(1,64)==0 && fe_lo(1,65)==1 && fe_hi(1,447,512)==512 && fe_hi(1,446,512)==511 && fe_hi(1,500,512)==512;
}
#test "attention subtracts the largest score: scores of 884 and -884 neither overflow nor vanish" {
    // Two tokens, layer 0. Head 0: query 0 and key 0 are (50, 0, ...), key 1 is
    // (-50, 0, ...) and query 1 is (-50, 0, ...): scores +-2500/sqrt(8) = +-883.9.
    // Head 1 has zero queries: equal scores, so the mean of the values.
    // Values: token 0 all 1, token 1 all 3. qkv at 0, out at 96, scores at 128.
    f:[130]f64;
    f[0]=50;f[16]=50;f[48]=-50;f[64]=-50;
    for c:0..<16 {f[32+c]=1;f[80+c]=3;}
    fe_attend(0,2,f[..],0,96,128);
    for c:0..<8 {#assert f[96+c]==1 && f[104+c]==2 && f[112+c]==3 && f[120+c]==2;}
    // Layer 1 at a distance of 1: the same keys.
    g:=f;for c:96..<128 {g[c]=0;}
    fe_attend(1,2,g[..],0,96,128);
    for c:96..<128 {#assert g[c]==f[c];}
}
#test "a local window reads keys 1 to 65 for query 65, and no score from outside it" {
    // 66 tokens, layer 1, zero queries and keys: each output is the mean of
    // the values in its window. Token j's values are all j. Query 0 reads keys
    // 0 to 64 (mean 32); query 65 reads 1 to 65 (mean 33); query 64 reads all 66 (mean 32.5). The slot just before
    // the scores holds 10^6, which no score may be compared with.
    f:[4290]f64;
    for j:0..<66 {for c:0..<16 {f[j*48+32+c]=f64(j);}}
    f[4223]=1000000;
    fe_attend(1,66,f[..],0,3168,4224);
    for c:0..<16 {#assert f[3168+c]==32 && f[3168+65*16+c]==33 && f[3168+64*16+c]==32.5;}
}
#test "hand-worked accounting: 16,281,744 multiply-adds at 512 tokens" {
    // Products: 3 layers x 512 tokens x 2,560. Layer 0: 512^2 x 32.
    // Layers 1 and 2: (2 x (64 x 65 + 2,016) + 384 x 129) x 32 = 61,888 x 32 each. Heads: 9 x 16.
    #assert fe_macs(512)==3932160+8388608+2*1980416+144;
    #assert fe_macs(1)==3*2560+3*32+144 && fe_macs(65)==3*65*2560+3*65*65*32+144;
    // At 130 tokens a local layer reads 6,305 + 129 + 6,176 = 12,610 keys.
    #assert fe_macs(130)==3*130*2560+130*130*32+2*12610*32+144;
    #assert fe_plan_f64(512)==512*192 && fe_q8_bytes()==FE_Q8_BYTES;
}
#test "engines are chosen by name; one not built is refused, never replaced" {
    #assert fe_select("fe-f64-reference-v1").engine==FeEngine.reference && fe_select("fe-f64-reference-v1").status==FeStatus.ok;
    #assert fe_select("fe-q8-cpu-v1").engine==FeEngine.q8 && fe_select("fe-q8-cpu-v1").status==FeStatus.ok;
    c:=fe_select("fe-q8-cuda-v1");#assert c.status==FeStatus.unavailable && c.engine==FeEngine.none;
    c=fe_select("fe-q8-cpu");#assert c.status==FeStatus.engine && c.engine==FeEngine.none;
    #assert fe_engine_name(FeEngine.reference)=="fe-f64-reference-v1" && fe_engine_name(FeEngine.q8)=="fe-q8-cpu-v1" && fe_engine_name(FeEngine.none)=="none";
}
#test "uint8 embedding rows: every value within half a step, the ends exact" {
    w:[8848]f64;e:[1024]u8;lo:[64]f64;st:[64]f64;c:[7680]s8;s:[480]f32;o:[480]f32;
    for i:0..<480 {o[i]=7;}
    q:=fe_model(w[..],e[..],lo[..],st[..],c[..],s[..],o[..]);
    for r:0..<64 {
        top:=0;bottom:=0;
        for k:0..<16 {
            v:=w[r*16+k];code:=cast(int)e[r*16+k];
            #assert abs(lo[r]+st[r]*f64(code)-v)<=st[r]*0.5000001;
            if code==255 {top+=1;}
            if code==0 {bottom+=1;}
        }
        #assert top>=1 && bottom>=1 && st[r]>0;
    }
    for i:0..<480 {#assert o[i]==0;}
    // Every slice is checked; a short one is refused before anything is written.
    #assert fe_quantize(w[0..<8847],q)==FeStatus.storage;
    for f:0..<6 {
        b:=q;
        if f==0 {b.emb=e[0..<1023];}
        if f==1 {b.low=lo[0..<63];}
        if f==2 {b.step=st[0..<63];}
        if f==3 {b.codes=c[0..<7679];}
        if f==4 {b.scales=s[0..<479];}
        if f==5 {b.offsets=o[0..<479];}
        #assert fe_quantize(w[..],b)==FeStatus.storage;
        one:=[1]int.[0];#assert fe_forward(FeEngine.q8,w[..],b,FeWork.{},one[..],lo[0..<9])==FeStatus.storage;
    }
    // Weights beyond 10^6 in magnitude (and so any that are not numbers) are refused.
    w[2000]=1000000;#assert fe_quantize(w[..],q)==FeStatus.ok;
    w[2000]=-1000000.0000001;#assert fe_quantize(w[..],q)==FeStatus.number;
    w[2000]=0.25;
    // A block of zero weights has no scale: refused.
    for k:0..<16 {w[4096+k]=0;}
    #assert fe_quantize(w[..],q)==FeStatus.number;
    w[4111]=0.125;#assert fe_quantize(w[..],q)==FeStatus.ok && c[3087]==127 && s[192]==int8_scale(0.125) && c[3072]==0;
    // A constant row has no step: refused.
    for k:0..<16 {w[16+k]=0.5;}
    #assert fe_quantize(w[..],q)==FeStatus.number;
}
#forall "each layer's int8 products stay within chapter 48's bound" cs:0..<16 #steps 200000000 {
    w:[8848]f64;e:[1024]u8;lo:[64]f64;st:[64]f64;c:[7680]s8;s:[480]f32;o:[480]f32;
    q:=fe_model(w[..],e[..],lo[..],st[..],c[..],s[..],o[..]);
    rows:=[4]int.[48,16,64,16];width:=[4]int.[16,16,16,32];part_at:=[4]int.[0,768,1024,2048];
    // Cases 0-11: each layer and part on 5 tokens. Cases 12-15: layer 0's up
    // and down products on 128 tokens (one whole chunk) and 129 (one more).
    layer:=ifx cs<12 then cs/4 else 0;part:=ifx cs<12 then cs%4 else 2+(cs-12)/2;
    nt:=ifx cs<12 then 5 else 128+cs%2;tc:=ifx cs<12 then 0 else 1;
    rw:=rows[part];wd:=width[part];
    n:=rw*wd;at:=FE_EMB+layer*FE_LAYER_W+part_at[part];c0:=at-FE_EMB;
    // The int8 weights decode to f32 weights close to the originals.
    wq:=Int8Weights.{codes=c[c0..<c0+n],scales=s[c0/16..<(c0+n)/16],offsets=o[c0/16..<(c0+n)/16]};
    wf:[1024]f32;#assert int8_dequantize(Int8Request.{rows=rw,width=wd,tokens=1,block=16},wq,wf[0..<n]).status==Int8Status.ok;
    for i:0..<n {#assert abs(f64(wf[i])-w[at+i])<=f64(s[(c0+i)/16])*0.5000001+abs(w[at+i])/4194304;}
    x:[4128]f64;for i:0..<nt*wd {x[i]=fe_unit(9000+i)*2;}
    f:[16]f64;a:[4096]f32;ac:[4096]s8;as:[256]f32;am:[256]s32;d:[8192]s32;
    wk:=fe_work(f[..],a[..],ac[..],as[..],am[..],d[..]);
    y:[8256]f64;yr:[8256]f64;
    #assert fe_linear(FeEngine.q8,w[..],q,wk,at,rw,wd,nt,x[..],0,y[..],0)==FeStatus.ok;
    #assert fe_linear(FeEngine.reference,w[..],q,wk,at,rw,wd,nt,x[..],0,yr[..],0)==FeStatus.ok;
    // Inputs lie in [-2, 2), so each activation moves at most half of 2/127:
    // the product moves at most sum |w| / 127, plus the weights' half steps times |x|.
    for i:0..<nt*rw {
        tok:=i/rw;row:=i%rw;slack:=0.0;
        for k:0..<wd {
            ww:=abs(w[at+row*wd+k]);ax:=abs(x[tok*wd+k]);
            slack+=ww/127*1.0000001+f64(s[(c0+row*wd+k)/16])*0.5000001*ax+ww*ax/4194304;
        }
        #assert abs(y[i]-yr[i])<=slack && y[i]!=yr[i];
    }
    if tc==0 {
        // Five tokens are one chunk: chapter 48's own bound, sharper, holds too.
        xf:[160]f32;for i:0..<5*wd {xf[i]=f32(x[i]);}
        bound:[320]f64;
        acts:=Int8Activations.{codes=ac[0..<5*wd],scales=as[0..<5*wd/16],sums=am[0..<5*wd/16]};
        r:=Int8Request.{rows=rw,width=wd,tokens=5,block=16};
        #assert int8_bound(r,wf[0..<n],xf[0..<5*wd],acts,bound[0..<5*rw]).status==Int8Status.ok;
        for i:0..<5*rw {
            row:=i%rw;slack:=0.0;
            for k:0..<wd {ax:=abs(x[(i/rw)*wd+k]);slack+=f64(s[(c0+row*wd+k)/16])*0.5000001*ax+abs(w[at+row*wd+k])*ax/4194304;}
            #assert abs(y[i]-yr[i])<=bound[i]+slack;
        }
    }
}
#test "the reference engine equals the Python oracle within 10^-12" #steps 2000000000 {
    w:[8848]f64;e:[1024]u8;lo:[64]f64;st:[64]f64;c:[7680]s8;s:[480]f32;o:[480]f32;
    q:=fe_model(w[..],e[..],lo[..],st[..],c[..],s[..],o[..]);
    f:[22000]f64;a:[4096]f32;ac:[4096]s8;as:[256]f32;am:[256]s32;d:[8192]s32;
    wk:=fe_work(f[..],a[..],ac[..],as[..],am[..],d[..]);
    lens:=[3]int.[1,5,70];ids:[70]int;z:[9]f64;
    for cs:0..<3 {
        // Work of exactly 192 values per token: a region laid out one past its end faults.
        n:=lens[cs];fe_ids(cs,n,ids[..]);wk.f=f[0..<192*n];
        #assert fe_forward(FeEngine.reference,w[..],q,wk,ids[0..<n],z[..])==FeStatus.ok;
        for i:0..<9 {#assert abs(z[i]-FE_ORACLE_LOGITS[cs*9+i])<=1e-12;}
    }
    // A key 65 positions away reaches token 0 only through layer 0: changing
    // token 69 changes the logits, and the local layers alone never see it.
    #assert fe_lo(1,69)==5 && fe_hi(1,4,70)==69;
}
#test "the q8 engine: near the reference, refusals before any work" #steps 4000000000 {
    w:[8848]f64;e:[1024]u8;lo:[64]f64;st:[64]f64;c:[7680]s8;s:[480]f32;o:[480]f32;
    q:=fe_model(w[..],e[..],lo[..],st[..],c[..],s[..],o[..]);
    f:[34000]f64;a:[4096]f32;ac:[4096]s8;as:[256]f32;am:[256]s32;d:[8192]s32;
    wk:=fe_work(f[0..<130*192],a[..],ac[..],as[..],am[..],d[..]);
    ids:[130]int;z:[9]f64;zr:[9]f64;
    // 130 tokens: two int8 chunks, of 128 and 2.
    fe_ids(3,130,ids[..]);
    #assert fe_forward(FeEngine.q8,w[..],q,wk,ids[..],z[..])==FeStatus.ok;
    #assert fe_forward(FeEngine.reference,w[..],q,wk,ids[..],zr[..])==FeStatus.ok;
    worst:=0.0;for i:0..<9 {worst=qz_larger(worst,abs(z[i]-zr[i]));}
    #assert worst>0 && worst<=FE_LOGIT_BOUND;
    for i:0..<9 {#assert abs(z[i]-FE_RECORDED_Q8[i])<=1e-12;}
    #assert fe_forward(FeEngine.none,w[..],q,wk,ids[..],z[..])==FeStatus.engine;
    #assert fe_forward(FeEngine.q8,w[..],q,wk,ids[0..<0],z[..])==FeStatus.tokens;
    big:[513]int;#assert fe_forward(FeEngine.q8,w[..],q,wk,big[..],z[..])==FeStatus.tokens;
    #assert fe_forward(FeEngine.q8,w[..],q,wk,big[0..<512],z[0..<8])==FeStatus.storage;
    keep:=ids[129];ids[129]=64;#assert fe_forward(FeEngine.q8,w[..],q,wk,ids[..],z[..])==FeStatus.id;
    ids[129]=-1;#assert fe_forward(FeEngine.q8,w[..],q,wk,ids[..],z[..])==FeStatus.id;
    ids[129]=keep;
    #assert fe_forward(FeEngine.q8,w[0..<8847],q,wk,ids[..],z[..])==FeStatus.storage;
    #assert fe_forward(FeEngine.q8,w[..],q,wk,ids[..],z[0..<8])==FeStatus.storage;
    small:=wk;small.f=f[0..<130*192-1];#assert fe_forward(FeEngine.q8,w[..],q,small,ids[..],z[..])==FeStatus.capacity;
    small=wk;small.a=a[0..<4095];#assert fe_forward(FeEngine.q8,w[..],q,small,ids[..],z[..])==FeStatus.capacity;
    small=wk;small.codes=ac[0..<4095];#assert fe_forward(FeEngine.q8,w[..],q,small,ids[..],z[..])==FeStatus.capacity;
    small=wk;small.scales=as[0..<255];#assert fe_forward(FeEngine.q8,w[..],q,small,ids[..],z[..])==FeStatus.capacity;
    small=wk;small.sums=am[0..<255];#assert fe_forward(FeEngine.q8,w[..],q,small,ids[..],z[..])==FeStatus.capacity;
    small=wk;small.dots=d[0..<8191];#assert fe_forward(FeEngine.q8,w[..],q,small,ids[..],z[..])==FeStatus.capacity;
    // The reference engine reads no q8 model and no int8 work.
    none:=fe_work(f[..],a[0..<0],ac[0..<0],as[0..<0],am[0..<0],d[0..<0]);
    five:[5]int;fe_ids(1,5,five[..]);
    #assert fe_forward(FeEngine.reference,w[..],FeQ8.{},none,five[..],z[..])==FeStatus.ok;
    for i:0..<9 {#assert abs(z[i]-FE_ORACLE_LOGITS[9+i])<=1e-12;}
    #assert fe_forward(FeEngine.q8,w[..],FeQ8.{},wk,ids[..],z[..])==FeStatus.storage;
    // A corrupted code (-128 is outside chapter 48's range) is refused by the int8 product.
    c[5000]=-128;#assert fe_forward(FeEngine.q8,w[..],q,wk,ids[..],z[..])==FeStatus.int8;
}
#test "parity: equal argmaxes and the largest logit difference, against the frozen bound" {
    r:=[18]f64.[0,1,0,1,2,5,4,3,2,  1,0,2,1,0,0,0,0,1];
    p:=fe_parity(r[..],r[..],2);#assert p.decisions==6 && p.equal==6 && p.worst==0 && p.ok;
    d:=r;d[3]=1.125;p=fe_parity(r[..],d[..],2);#assert p.equal==6 && p.worst==0.125 && p.ok;
    d=r;d[17]=1.25;d[15]=0.5;p=fe_parity(r[..],d[..],2);#assert p.equal==6 && p.worst==0.5 && !p.ok;
    // Ties go to the first class; a flipped head fails parity even inside the bound.
    d=r;d[0]=1;p=fe_parity(r[..],d[..],2);#assert p.equal==5 && p.worst==1 && !p.ok;
    d=r;d[9]=-0.0625;p=fe_parity(r[..],d[..],2);#assert p.equal==5 && p.worst==1.0625 && !p.ok;
    d=r;d[1]=-0.0625;d[0]=0.0625;p=fe_parity(r[..],d[..],2);#assert p.equal==5 && p.worst==1.0625 && !p.ok;
    d=r;d[11]=2.125;p=fe_parity(r[..],d[..],2);#assert p.equal==6 && p.worst==0.125 && p.ok;
    d=r;d[12]=2.0625;p=fe_parity(r[..],d[..],2);#assert p.equal==5 && !p.ok;
    #assert fe_argmax(r[..],5,4)==5 && fe_argmax(r[..],2,3)==4 && fe_argmax(r[..],14,4)==17 && fe_argmax(r[..],9,2)==9;
    #assert !fe_parity(r[..],r[0..<17],2).ok && !fe_parity(r[..],r[..],0).ok && !fe_parity(r[..],r[..],1).ok && fe_parity(r[0..<9],r[0..<9],1).ok && !fe_parity(r[0..<9],r[0..<9],2).ok;
}
#test "the card: items per head, gold from the reference, chapter 50's bound" {
    r:=[18]f64.[0,1,0,1,2,5,4,3,2,  1,0,2,1,0,0,0,0,1];pr:[18]f64;
    fe_probs(r[0..<9],pr[0..<9]);fe_probs(r[9..<18],pr[9..<18]);
    items:[6]PqItem;
    c:=fe_card(pr[..],pr[..],2,items[..]);
    #assert c.status==QzStatus.ok && c.items==6 && c.agreement==1 && c.kl==0 && c.promoted && c.bytes==FE_Q8_BYTES;
    #assert items[0].start==0 && items[0].count==2 && items[0].gold==1 && items[1].start==2 && items[1].gold==2 && items[2].start==5 && items[2].count==4 && items[2].gold==0;
    #assert items[3].start==9 && items[3].gold==0 && items[4].start==11 && items[4].count==3 && items[4].gold==0 && items[5].start==14 && items[5].gold==3 && items[5].abstain==-1;
    #assert items[5].kind==QrKind.choice;
    q:=pr;q[0]=0.5;q[1]=0.5;
    c=fe_card(pr[..],q[..],2,items[..]);#assert c.status==QzStatus.ok && c.agreement==5.0/6 && !c.promoted;
    #assert fe_card(pr[..],pr[..],2,items[0..<5]).status==QzStatus.capacity && fe_card(pr[..],pr[0..<17],2,items[..]).status==QzStatus.storage;
}
#test "the latency gate: P99 of at least 100 warm runs against 20 ms" {
    x:[200]int;for i:0..<100 {x[i]=10000000+i*1000;}
    ok:=FeParity.{decisions=6,equal=6,ok=true};card:=QzCard.{promoted=true};
    g:=fe_gate(FeEngine.q8,512,ok,card,x[0..<100],FE_P99_LIMIT);
    #assert g.verdict==FeVerdict.met && g.reason==FeReason.none && g.n==100 && g.p50==10049000 && g.p99==10098000 && g.limit==FE_P99_LIMIT;
    #assert g.mean==10049500 && abs(g.sd-29011.491975882016)<=1e-6;
    x[98]=20000000;x[99]=20000000;g=fe_gate(FeEngine.q8,512,ok,card,x[0..<100],FE_P99_LIMIT);#assert g.verdict==FeVerdict.met && g.p99==20000000;
    x[98]=20000001;x[99]=20000001;g=fe_gate(FeEngine.q8,512,ok,card,x[0..<100],FE_P99_LIMIT);#assert g.verdict==FeVerdict.missed && g.reason==FeReason.none && g.p99==20000001;
    // The one slowest run of 100 is not the P99; two are.
    x[98]=10098000;x[99]=90000000;g=fe_gate(FeEngine.q8,512,ok,card,x[0..<100],FE_P99_LIMIT);#assert g.verdict==FeVerdict.met && g.p99==10098000;
    x[99]=10099000;
    #assert fe_gate(FeEngine.reference,512,ok,card,x[0..<100],FE_P99_LIMIT).reason==FeReason.engine;
    #assert fe_gate(FeEngine.none,512,ok,card,x[0..<100],FE_P99_LIMIT).reason==FeReason.engine;
    #assert fe_gate(FeEngine.q8,511,ok,card,x[0..<100],FE_P99_LIMIT).reason==FeReason.workload;
    bad:=ok;bad.ok=false;g=fe_gate(FeEngine.q8,512,bad,card,x[0..<100],FE_P99_LIMIT);#assert g.verdict==FeVerdict.refused && g.reason==FeReason.parity && g.n==0;
    #assert fe_gate(FeEngine.q8,512,ok,QzCard.{},x[0..<100],FE_P99_LIMIT).reason==FeReason.card;
    g=fe_gate(FeEngine.q8,512,ok,card,x[0..<99],FE_P99_LIMIT);#assert g.verdict==FeVerdict.refused && g.reason==FeReason.samples;
    for i:100..<200 {x[i]=10000000;}
    #assert fe_gate(FeEngine.q8,512,ok,card,x[..],FE_P99_LIMIT).verdict==FeVerdict.met;
    big:[1025]int;for i:0..<1025 {big[i]=1;}
    #assert fe_gate(FeEngine.q8,512,ok,card,big[0..<1024],FE_P99_LIMIT).verdict==FeVerdict.met;
    #assert fe_gate(FeEngine.q8,512,ok,card,big[..],FE_P99_LIMIT).reason==FeReason.samples;
    x[7]=0;#assert fe_gate(FeEngine.q8,512,ok,card,x[0..<100],FE_P99_LIMIT).reason==FeReason.samples;
    x[7]=-5;#assert fe_gate(FeEngine.q8,512,ok,card,x[0..<100],FE_P99_LIMIT).reason==FeReason.samples;
    // The limit is frozen: a gate asked to use another one refuses.
    x[7]=1;#assert fe_gate(FeEngine.q8,512,ok,card,x[0..<100],FE_P99_LIMIT+1).reason==FeReason.workload;
    names:=[6]string.["none","the engine is not fe-q8-cpu-v1","not the frozen 512-token workload","q8 decisions differ from the reference",
        "the quality card did not promote","fewer than 100 or more than 1,024 warm runs, or a time that is not positive"];
    for i:0..<6 {#assert fe_reason_name(cast(FeReason)i)==names[i];}
    #assert fe_verdict_name(FeVerdict.refused)=="refused" && fe_verdict_name(FeVerdict.met)=="met" && fe_verdict_name(FeVerdict.missed)=="missed";
    // Nearest rank by hand: descending input, ties, one value, and p = 0.
    five:=[5]int.[50,40,30,20,10];#assert fe_rank(five[..],50)==30 && fe_rank(five[..],1)==10 && fe_rank(five[..],99)==50;
    three:=[3]int.[3,2,1];#assert fe_rank(three[..],50)==2;
    ties:=[4]int.[2,1,2,3];#assert fe_rank(ties[..],50)==2 && fe_rank(ties[..],51)==2 && fe_rank(ties[..],76)==3;
    one:=[1]int.[7];#assert fe_rank(one[..],1)==7 && fe_rank(one[..],0)==0;
    st:=[9]string.["ok","not 1 to 512 token IDs","a token ID outside 0 to 63","a slice of the wrong length","work storage too small",
        "a row with no spread","refused by the int8 product","no such engine","engine not built here"];
    for i:0..<9 {#assert fe_status_name(cast(FeStatus)i)==st[i];}
}

// book:begin weights
// Word i of SplitMix64 seed 222, as a binary64 in [-1, 1), times its part's scale.
fe_unit :: (i:int)->f64 {return f64(cr_bits(FE_SEED,cast(u64)i)>>11)/4503599627370496.0-1;}
fe_scale :: (i:int)->f64 {
    if i<FE_EMB || i>=FE_HEAD_AT {return 1;}
    k:=(i-FE_EMB)%FE_LAYER_W;
    if k>=2048 || (k>=768 && k<1024) {return 0.25;}
    return 0.5;
}
fe_weights :: (w:[]f64)->FeStatus #export_c {
    if w.count!=FE_WEIGHTS {return FeStatus.storage;}
    for i:0..<FE_WEIGHTS {w[i]=fe_scale(i)*fe_unit(i);}
    return FeStatus.ok;
}
// The model's identity: FNV-1a over every weight's 64 bits.
fe_model_id :: (w:[]f64)->u64 #export_c {
    h:=cast(u64)0xcbf29ce484222325;
    for v:w {h=mul_wrap(h^f64_bits(v),cast(u64)0x100000001b3);}
    return h;
}
// book:end weights

// book:begin quantize
fe_q8_bytes :: ()->int {return FE_EMB+2*8*FE_VOCAB+FE_CODES+2*4*FE_CODES/FE_BLOCK+8*(FE_WEIGHTS-FE_HEAD_AT);}
// Embedding rows: low = the row's least value, step = (most - least)/255,
// code = the nearest whole number of steps. Layers: chapter 48's quantizer,
// each 16 weights one block with its own scale.
fe_quantize :: (w:[]f64,q:FeQ8)->FeStatus #export_c {
    if w.count!=FE_WEIGHTS || !fe_q8_ok(q) {return FeStatus.storage;}
    for v:w {if !(abs(v)<=1000000) {return FeStatus.number;}}
    for r:0..<FE_VOCAB {
        lo:=w[r*FE_D];hi:=lo;
        for k:1..<FE_D {lo=-qz_larger(-lo,-w[r*FE_D+k]);hi=qz_larger(hi,w[r*FE_D+k]);}
        if !(hi>lo) {return FeStatus.number;}
        q.low[r]=lo;q.step[r]=(hi-lo)/255;
        for k:0..<FE_D {q.emb[r*FE_D+k]=cast(u8)int8_nearest((w[r*FE_D+k]-lo)/q.step[r]);}
    }
    // Chapter 48's rounding: the scale is the least f32 at or above amax/127.
    for b:0..<FE_CODES/FE_BLOCK {
        top:=0.0;
        for k:0..<FE_BLOCK {top=qz_larger(top,abs(f64(f32(w[FE_EMB+b*FE_BLOCK+k]))));}
        if top==0 {return FeStatus.number;}
        d:=int8_scale(f32(top));q.scales[b]=d;q.offsets[b]=0;
        for k:0..<FE_BLOCK {q.codes[b*FE_BLOCK+k]=cast(s8)int8_nearest(f64(f32(w[FE_EMB+b*FE_BLOCK+k]))/f64(d));}
    }
    return FeStatus.ok;
}
// book:end quantize

// book:begin parts
fe_imin :: (a:int,b:int)->int {return cast(int)((f64(a+b)-abs(f64(a-b)))/2);}
fe_norm :: (x:[]f64,at:int,out:[]f64,to:int) {
    mean:=0.0;for k:0..<FE_D {mean+=x[at+k];}
    mean/=FE_D;
    var:=0.0;for k:0..<FE_D {d:=x[at+k]-mean;var+=d*d;}
    r:=1/sqrt(var/FE_D+FE_EPS);
    for k:0..<FE_D {out[to+k]=(x[at+k]-mean)*r;}
}
fe_tanh :: (a:f64)->f64 {t:=exp(-2*abs(a));v:=(1-t)/(1+t);return ifx a<0 then -v else v;}
fe_gelu :: (z:f64)->f64 {return 0.5*z*(1+fe_tanh(FE_GELU_C*(z+FE_GELU_A*z*z*z)));}
// Keys query i reads in layer l: all of them, or those at most 64 away.
fe_lo :: (l:int,i:int)->int {return ifx l%FE_GLOBAL==0 then 0 else i-fe_imin(i,FE_WINDOW);}
fe_hi :: (l:int,i:int,t:int)->int {return ifx l%FE_GLOBAL==0 then t else fe_imin(t,i+FE_WINDOW+1);}
// Each head: softmax over its classes of logit / temperature, largest first subtracted.
fe_probs :: (z:[]f64,p:[]f64) #export_c {
    for h:0..<3 {
        at:=FE_CLASS_AT[h];n:=FE_CLASSES[h];top:=z[at];
        for c:1..<n {top=qz_larger(top,z[at+c]);}
        sum:=0.0;
        for c:0..<n {p[at+c]=exp((z[at+c]-top)/FE_TEMPS[h]);sum+=p[at+c];}
        for c:0..<n {p[at+c]/=sum;}
    }
}
// Multiply-adds of one decision: four products per layer, attention scores
// and values (32 per query-key pair), and the heads.
fe_macs :: (t:int)->int #export_c {
    n:=FE_LAYERS*t*FE_LAYER_W+FE_LOGITS*FE_D;
    for l:0..<FE_LAYERS {for i:0..<t {n+=(fe_hi(l,i,t)-fe_lo(l,i))*2*FE_D;}}
    return n;
}
// book:end parts

// book:begin select
fe_engine_name :: (e:FeEngine)->string {names:=[3]string.["none","fe-f64-reference-v1","fe-q8-cpu-v1"];return names[cast(int)e];}
// An engine is named, never inferred. A known engine that is not built here
// is refused; nothing else runs in its place.
fe_select :: (name:string)->FeChoice {
    for e:1..<3 {if name==fe_engine_name(cast(FeEngine)e) {return FeChoice.{engine=cast(FeEngine)e};}}
    if name=="fe-q8-cuda-v1" {return FeChoice.{status=FeStatus.unavailable};}
    return FeChoice.{status=FeStatus.engine};
}
// book:end select

// book:begin linear
// rows x width weights at w[at] times t inputs at x[xa], into y[ya]: binary64,
// or chapter 48's int8 row kernel in chunks of 128 tokens.
fe_linear :: (e:FeEngine,w:[]f64,q:FeQ8,k:FeWork,at:int,rows:int,width:int,t:int,x:[]f64,xa:int,y:[]f64,ya:int)->FeStatus {
    if e==FeEngine.reference {
        for i:0..<t {for r:0..<rows {
            acc:=0.0;
            for c:0..<width {acc+=w[at+r*width+c]*x[xa+i*width+c];}
            y[ya+i*rows+r]=acc;
        }}
        return FeStatus.ok;
    }
    c0:=at-FE_EMB;nb:=width/FE_BLOCK;
    wq:=Int8Weights.{codes=q.codes[c0..<c0+rows*width],scales=q.scales[c0/FE_BLOCK..<(c0+rows*width)/FE_BLOCK],offsets=q.offsets[c0/FE_BLOCK..<(c0+rows*width)/FE_BLOCK]};
    for s:0..<(t+FE_CHUNK-1)/FE_CHUNK {
        n:=fe_imin(FE_CHUNK,t-s*FE_CHUNK);r:=Int8Request.{rows=rows,width=width,tokens=n,block=FE_BLOCK};
        for i:0..<n*width {k.a[i]=f32(x[xa+s*FE_CHUNK*width+i]);}
        a:=Int8Activations.{codes=k.codes[0..<n*width],scales=k.scales[0..<n*nb],sums=k.sums[0..<n*nb]};
        st:=int8_quantize(r,k.a[0..<n*width],a).status;
        if st==Int8Status.ok {st=int8_row(r,wq,a,k.dots,y[ya+s*FE_CHUNK*rows..<ya+(s*FE_CHUNK+n)*rows]).status;}
        if st!=Int8Status.ok {return FeStatus.int8;}
    }
    return FeStatus.ok;
}
// book:end linear

// book:begin attend
// Two heads of 8 over the keys each query may read; scores, then values.
fe_attend :: (l:int,t:int,f:[]f64,qkv:int,out:int,s:int) {
    for i:0..<t {for h:0..<FE_D/FE_HD {
        lo:=fe_lo(l,i);hi:=fe_hi(l,i,t);top:=0.0;
        for j:lo..<hi {
            d:=0.0;
            for c:0..<FE_HD {d+=f[qkv+i*48+h*FE_HD+c]*f[qkv+j*48+FE_D+h*FE_HD+c];}
            f[s+j]=d*FE_SCORE;
            top=ifx j==lo then f[s+j] else qz_larger(top,f[s+j]);
        }
        sum:=0.0;
        for j:lo..<hi {f[s+j]=exp(f[s+j]-top);sum+=f[s+j];}
        for c:0..<FE_HD {
            acc:=0.0;
            for j:lo..<hi {acc+=f[s+j]*f[qkv+j*48+2*FE_D+h*FE_HD+c];}
            f[out+i*FE_D+h*FE_HD+c]=acc/sum;
        }
    }}
}
// book:end attend

// book:begin forward
fe_plan_f64 :: (t:int)->int {return t*FE_ROW;}
fe_q8_ok :: (q:FeQ8)->bool {
    return q.emb.count==FE_EMB && q.low.count==FE_VOCAB && q.step.count==FE_VOCAB && q.codes.count==FE_CODES
        && q.scales.count==FE_CODES/FE_BLOCK && q.offsets.count==FE_CODES/FE_BLOCK;
}
fe_forward :: (e:FeEngine,w:[]f64,q:FeQ8,k:FeWork,ids:[]int,z:[]f64)->FeStatus #export_c {
    t:=ids.count;
    if e==FeEngine.none {return FeStatus.engine;}
    if t<1 || t>FE_TOKENS {return FeStatus.tokens;}
    for v:ids {if v<0 || v>=FE_VOCAB {return FeStatus.id;}}
    if w.count!=FE_WEIGHTS || z.count!=FE_LOGITS || (e==FeEngine.q8 && !fe_q8_ok(q)) {return FeStatus.storage;}
    if k.f.count<fe_plan_f64(t) {return FeStatus.capacity;}
    if e==FeEngine.q8 {
        if k.a.count<FE_CHUNK*FE_FF || k.codes.count<FE_CHUNK*FE_FF || k.scales.count<FE_CHUNK*FE_FF/FE_BLOCK {return FeStatus.capacity;}
        if k.sums.count<FE_CHUNK*FE_FF/FE_BLOCK || k.dots.count<FE_CHUNK*2*FE_FF {return FeStatus.capacity;}
    }
    // Rows per token, in order: h (16), qkv (48), u (64), g (32), the residual
    // stream x (16) and att (16). Attention's scores use u, which is free then.
    f:=k.f;h:=0;qkv:=h+t*FE_D;u:=qkv+t*3*FE_D;g:=u+t*2*FE_FF;x:=g+t*FE_FF;att:=fe_plan_f64(t)-t*FE_D;
    for i:0..<t {for c:0..<FE_D {
        f[x+i*FE_D+c]=ifx e==FeEngine.reference then w[ids[i]*FE_D+c] else q.low[ids[i]]+q.step[ids[i]]*f64(q.emb[ids[i]*FE_D+c]);
    }}
    for l:0..<FE_LAYERS {
        at:=FE_EMB+l*FE_LAYER_W;
        for i:0..<t {fe_norm(f,x+i*FE_D,f,h+i*FE_D);}
        st:=fe_linear(e,w,q,k,at,48,FE_D,t,f,h,f,qkv);
        if st!=FeStatus.ok {return st;}
        fe_attend(l,t,f,qkv,att,u);
        st=fe_linear(e,w,q,k,at+768,FE_D,FE_D,t,f,att,f,h);
        if st!=FeStatus.ok {return st;}
        for i:0..<t {for c:0..<FE_D {f[x+i*FE_D+c]+=f[h+i*FE_D+c];}}
        for i:0..<t {fe_norm(f,x+i*FE_D,f,h+i*FE_D);}
        st=fe_linear(e,w,q,k,at+1024,2*FE_FF,FE_D,t,f,h,f,u);
        if st!=FeStatus.ok {return st;}
        for i:0..<t {for c:0..<FE_FF {f[g+i*FE_FF+c]=fe_gelu(f[u+i*2*FE_FF+c])*f[u+i*2*FE_FF+FE_FF+c];}}
        st=fe_linear(e,w,q,k,at+2048,FE_D,FE_FF,t,f,g,f,h);
        if st!=FeStatus.ok {return st;}
        for i:0..<t {for c:0..<FE_D {f[x+i*FE_D+c]+=f[h+i*FE_D+c];}}
    }
    // Mean of the normed rows, then the heads in binary64.
    pool:[16]f64;
    for i:0..<t {fe_norm(f,x+i*FE_D,f,h);for c:0..<FE_D {pool[c]+=f[h+c];}}
    for o:0..<FE_LOGITS {
        acc:=0.0;
        for c:0..<FE_D {acc+=w[FE_HEAD_AT+o*FE_D+c]*(pool[c]/f64(t));}
        z[o]=acc;
    }
    return FeStatus.ok;
}
// book:end forward

// book:begin parity
fe_argmax :: (z:[]f64,at:int,n:int)->int {b:=at;for c:at+1..<at+n {if z[c]>z[b] {b=c;}}return b;}
// n requests of 9 logits each: every head's argmax must match, and the
// largest difference must be within the frozen bound.
fe_parity :: (reference:[]f64,derived:[]f64,n:int)->FeParity #export_c {
    if n<1 || reference.count!=n*FE_LOGITS || derived.count!=reference.count {return FeParity.{};}
    p:=FeParity.{decisions=3*n};
    for r:0..<n {for h:0..<3 {
        at:=r*FE_LOGITS+FE_CLASS_AT[h];
        if fe_argmax(reference,at,FE_CLASSES[h])==fe_argmax(derived,at,FE_CLASSES[h]) {p.equal+=1;}
    }}
    for i:0..<reference.count {p.worst=qz_larger(p.worst,abs(derived[i]-reference[i]));}
    p.ok=p.equal==p.decisions && p.worst<=FE_LOGIT_BOUND;
    return p;
}
// Chapter 50's card over every (request, head): gold is the reference
// decision, since the stand-in has no labels; the card measures how far
// quantization moves the decisions.
fe_card :: (reference:[]f64,derived:[]f64,n:int,items:[]PqItem)->QzCard #export_c {
    if items.count<3*n {return QzCard.{status=QzStatus.capacity};}
    for r:0..<n {for h:0..<3 {
        at:=r*FE_LOGITS+FE_CLASS_AT[h];
        items[3*r+h]=PqItem.{kind=QrKind.choice,count=FE_CLASSES[h],start=at,gold=fe_argmax(reference,at,FE_CLASSES[h])-at,abstain=-1};
    }}
    return qz_card(QzBound.{kl=FE_CARD_KL,agreement=FE_CARD_AGREEMENT},items[0..<3*n],reference,derived,fe_q8_bytes());
}
// book:end parity

// book:begin gate
// Chapter 18's nearest rank: the value at rank ceil(p n / 100) in sorted order,
// counting from 1; it holds that rank when fewer values are below it and at
// least that many are at or below it.
fe_rank :: (x:[]int,p:int)->int #export_c {
    r:=(p*x.count+99)/100;
    for v:x {
        below:=0;atmost:=0;
        for u:x {if u<v {below+=1;} if u<=v {atmost+=1;}}
        if below<r && atmost>=r {return v;}
    }
    return 0;
}
// Refused unless the q8 engine ran the frozen workload with parity and a
// promoted card, on 100 to 1,024 positive warm times, against the frozen limit.
fe_gate :: (e:FeEngine,tokens:int,p:FeParity,c:QzCard,ns:[]int,limit:int)->FeGate #export_c {
    g:=FeGate.{limit=limit};
    if e!=FeEngine.q8 {g.reason=FeReason.engine;return g;}
    if tokens!=FE_TOKENS || limit!=FE_P99_LIMIT {g.reason=FeReason.workload;return g;}
    if !p.ok {g.reason=FeReason.parity;return g;}
    if !c.promoted {g.reason=FeReason.card;return g;}
    st:=cm_welford(ns);
    if ns.count<FE_SAMPLES_MIN || st.status!=CmStatus.ok {g.reason=FeReason.samples;return g;}
    g.n=ns.count;g.p50=fe_rank(ns,50);g.p99=fe_rank(ns,99);g.mean=st.mean;g.sd=st.sd;
    g.verdict=ifx g.p99<=limit then FeVerdict.met else FeVerdict.missed;
    return g;
}
// book:end gate

fe_verdict_name :: (v:FeVerdict)->string {names:=[3]string.["refused","met","missed"];return names[cast(int)v];}
fe_reason_name :: (r:FeReason)->string {
    names:=[6]string.["none","the engine is not fe-q8-cpu-v1","not the frozen 512-token workload","q8 decisions differ from the reference",
        "the quality card did not promote","fewer than 100 or more than 1,024 warm runs, or a time that is not positive"];
    return names[cast(int)r];
}
fe_status_name :: (s:FeStatus)->string {
    names:=[9]string.["ok","not 1 to 512 token IDs","a token ID outside 0 to 63","a slice of the wrong length","work storage too small",
        "a row with no spread","refused by the int8 product","no such engine","engine not built here"];
    return names[cast(int)s];
}
