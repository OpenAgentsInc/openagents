// Chapter 20 executable wiring. All protocol/admission/answer decisions are
// the checked fleet, chapter16/19 and Nostr units. The C host does loopback
// socket effects, argv, clocks and lifecycle only. Test/demo keys only.
#import "Basic";
#load "policy.coax";
#load "service.coax";
#load "../mesh/hooks.coax";
#load "../../../coax/lib/nostr/event_sign.coax";
#load "../../../coax/lib/net/relay_conn.coax";
#load "../../../coax/lib/crypto/entropy.coax";
#load "../../../coax/lib/nostr/nip44.coax";
#load "../../../coax/lib/nostr/nip44-key.coax";
#load "../../../coax/lib/nostr/nip42.coax";
#load "../../../coax/lib/nostr/relay_read.coax";

fh_argc :: ()->int #foreign;
fh_arg_len :: (i:int)->int #foreign;
fh_arg_byte :: (i:int,k:int)->int #foreign;
fh_now_s :: ()->int #foreign;
fh_stop :: ()->int #foreign;
fh_status :: (code:int)->int #foreign;
fh_listen :: (port:int)->int #foreign;
fh_accept :: (listener:int,timeout_ms:int)->int #foreign;
fh_read :: (fd:int,timeout_ms:int)->int #foreign;
fh_byte :: (i:int)->int #foreign;
fh_write :: (fd:int,byte:int)->int #foreign;
fh_flush :: (fd:int,timeout_ms:int)->int #foreign;
fh_close :: (fd:int)->int #foreign;

FM_BUFFER :: 131072;
FM_BODY :: 16384;
FmConfig :: struct {args:[8192]u8;used:int;relay:string="wss://relay.openagents.com";identity:string;port:int=8798;timeout:int=8000;attempt:int=2000;discover:int=500;fallback_host:string;fallback_port:int;route_provider:string;mesh_checker:string;checker_provider:string;backend_profile:string;sample:int=64;distance:int;}
FmRow :: struct {known:bool;provider:[64]u8;slug:[64]u8;slug_n:int;}
Fm :: struct {
    quiet:bool;cfg:[1]FmConfig;key:[32]u8;me:[64]u8;signer:[1]NostrSignWork;ecdh:[1]EcdhScratch;
    conn:[1]RelayConn;r:[1]Relay;n42:[1]Nip42;gen:int;opened:int;next_connect:int;subscribed:bool;
    peers:[32]MfPeer;rows:[32]FmRow;count:int;
    waiting:bool;active:int=-1;active_generation:int;request:[64]u8;request_n:int;attempt:int;deadline:int;started:int;
    jid:[64]u8;ack:int;answer:int;response:[FM_BUFFER]u8;response_n:int;
    storage:[1]SvTestPools;admitted:SvRequest;
    job_event:[FM_BUFFER]u8;job_event_n:int;job_plain:[FM_BUFFER]u8;job_plain_n:int;
    result_event:[FM_BUFFER]u8;result_event_n:int;result_plain:[FM_BUFFER]u8;result_plain_n:int;
    finished:int;capture:bool;remote_completed:bool;record_pending:bool;receipt_event:[16384]u8;receipt_event_n:int;receipt_id:[64]u8;receipt_ack:int;
    observe_sub:string;observe_frames:int;observe_failed:bool;observed:[FM_BUFFER]u8;observed_n:int;observed_eose:bool;
    children:[4]int;child_receipts:[4][64]u8;child_keys:[4][64]u8;child_key_present:[4]bool;child_providers:[4][64]u8;child_deadlines:[4]int;child_count:int;
}
fm_hex :: (bytes:[]u8,out:[]u8)->string {digits:="0123456789abcdef";for i:0..<bytes.count {out[2*i]=digits[bytes[i]>>4];out[2*i+1]=digits[bytes[i]&15];}return cast(string)out[0..<2*bytes.count];}
fm_unhex :: (s:string,out:[]u8)->bool {if s.count!=2*out.count {return false;}for i:0..<out.count {v:=0;for k:0..<2 {c:=s[2*i+k];d:=-1;if c>='0' && c<='9' {d=cast(int)(c-'0');}else if c>='a' && c<='f' {d=cast(int)(c-'a')+10;}if d<0 {return false;}v=v*16+d;}out[i]=cast(u8)v;}return true;}
fm_int :: (s:string)->int {v:=json_int(s);return ifx v.ok then v.value else -1;}
fm_arg :: (c:[]FmConfig,i:int)->string {n:=fh_arg_len(i);at:=c[0].used;if n<0 || at+n>8192 {return "";}for k:0..<n {c[0].args[at+k]=cast(u8)fh_arg_byte(i,k);}c[0].used+=n;return cast(string)c[0].args[at..<at+n];}
fm_config :: (c:[]FmConfig)->bool {
    i:=1;
    while i<fh_argc() {
        name:=fm_arg(c,i);if i+1>=fh_argc() {return false;}value:=fm_arg(c,i+1);i+=2;
        if name=="--relay" {c[0].relay=value;}
        else if name=="--identity" {c[0].identity=value;}
        else if name=="--port" {c[0].port=fm_int(value);}
        else if name=="--timeout-ms" {c[0].timeout=fm_int(value);}
        else if name=="--attempt-ms" {c[0].attempt=fm_int(value);}
        else if name=="--discover-ms" {c[0].discover=fm_int(value);}
        else if name=="--provider" {c[0].route_provider=value;}
        else if name=="--mesh-checker" {c[0].mesh_checker=value;}
        else if name=="--checker-provider" {c[0].checker_provider=value;}
        else if name=="--backend-profile" {c[0].backend_profile=value;}
        else if name=="--sample-256" {c[0].sample=fm_int(value);}
        else if name=="--maximum-distance-ppb" {c[0].distance=fm_int(value);}
        else if name=="--fallback" {
            prefix:="http://";if value.count<=prefix.count || value[0..<prefix.count]!=prefix {return false;}
            rest:=value[prefix.count..<value.count];at:=pb_index(rest,":");if at<1 {return false;}
            host:=rest[0..<at];port:=fm_int(rest[at+1..<rest.count]);if port<1 || port>65535 {return false;}
            // Local fallback is explicitly loopback; this is not an HTTP proxy.
            if host!="localhost" && host!="127.0.0.1" {return false;}c[0].fallback_host=host;c[0].fallback_port=port;
        }else {return false;}
    }
    return pb_identity(c[0].identity) && relay_uri(c[0].relay).ok && c[0].port>=1 && c[0].port<=65535 && c[0].timeout>=1 && c[0].timeout<=60000 && c[0].attempt>=1 && c[0].attempt<=c[0].timeout && c[0].discover>=0 && c[0].discover<=5000 && (c[0].route_provider.count==0 || pt_hex64(c[0].route_provider)) && c[0].sample>=0 && c[0].sample<=256 && c[0].distance>=0 && c[0].distance<=1000000000 && c[0].backend_profile.count<=64 && (c[0].mesh_checker.count==0 || (c[0].mesh_checker[0]=='/' && pt_hex64(c[0].checker_provider)));
}
fm_sign :: (f:[]Fm,kind:int,tags:string,content:string,scratch:[]u8,out:[]u8)->int {
    aux:[32]u8;if !rc_draw(32,aux[..]) {return -1;}n:=EVENT_MORE;
    while n==EVENT_MORE {n=nostr_event_sign_step(f[0].key[..],aux[..],fh_now_s(),kind,tags,content,f[0].signer[..],scratch,out,false);}
    for i:0..<32 {aux[i]=0;}return n;
}
fm_key :: (f:[]Fm)->bool {
    scratch:[4096]u8;out:[4096]u8;
    for attempt:0..<4 {
        if !rc_draw(32,f[0].key[..]) {return false;}n:=fm_sign(f,1,"[]","",scratch[..],out[..]);if n<0 {continue;}
        e:=nostr_event_read(cast(string)out[0..<n],scratch[..],false);if e.error!=NE_OK {continue;}text:=fm_hex(e.public_key[..],f[0].me[..]);return true;
    }
    return false;
}
fm_ck :: (f:[]Fm,peer:string,out:[]u8)->bool {key:[32]u8;return fm_unhex(peer,key[..]) && nip44_conversation_key_from_keys_checked(f[0].key[..],key[..],f[0].ecdh[..],out,false)==NIP44_OK;}
fm_seal :: (f:[]Fm,peer:string,plaintext:string,out:[]u8)->int {
    key:[32]u8;nonce:[32]u8;if !fm_ck(f,peer,key[..]) || !rc_draw(32,nonce[..]) {return -1;}
    work:[FM_BUFFER]u8;plain:[FM_BUFFER]u8;for i:0..<plaintext.count {plain[i]=plaintext[i];}
    r:=nip44_encrypt_checked(NIP44_COMPAT,key[..],nonce[..],plain[0..<plaintext.count],work[0..<nip44_encrypt_work_size(NIP44_COMPAT,plaintext.count)],out[0..<nip44_payload_size(NIP44_COMPAT,plaintext.count)],false);
    for i:0..<32 {key[i]=0;nonce[i]=0;}return ifx r.error==NIP44_OK then r.written else -1;
}
fm_open_payload :: (f:[]Fm,peer:string,payload:string,out:[]u8)->int {
    key:[32]u8;if !fm_ck(f,peer,key[..]) {return -1;}size:=nip44_decrypt_work_size(NIP44_COMPAT,payload.count);if size<0 || size>FM_BUFFER {return -1;}
    work:[FM_BUFFER]u8;r:=nip44_decrypt_checked(NIP44_COMPAT,key[..],payload,work[0..<size],out,false);for i:0..<32 {key[i]=0;}return ifx r.error==NIP44_OK then r.written else -1;
}
fm_drop :: (f:[]Fm) {relay_conn_drop(f[0].conn[..]);f[0].subscribed=false;f[0].next_connect=cxsock_now_ms()+2000;if f[0].waiting {f[0].answer=-1;}}
fm_auth :: (f:[]Fm)->bool {
    tags:[2048]u8;t:=nip42_template(f[0].n42[..],f[0].gen,fh_now_s(),tags[..]);if t.error!=N42_OK {return false;}
    scratch:[FM_BUFFER]u8;out:[FM_BUFFER]u8;n:=fm_sign(f,t.kind,t.tags,t.content,scratch[..],out[..]);if n<0 {return false;}
    e:=nostr_event_read(cast(string)out[0..<n],scratch[..],false);if e.error!=NE_OK {return false;}
    frame:[FM_BUFFER]u8;m:=json_raw(frame[..],0,"[\"AUTH\",");m=json_raw(frame[..],m,cast(string)out[0..<n]);m=json_raw(frame[..],m,"]");
    return m>0 && relay_conn_send(f[0].conn[..],cast(string)frame[0..<m]) && rl_auth_sent(f[0].r[..],e.id[..]);
}
fm_subscribe :: (f:[]Fm)->bool {
    kinds:=[1]int.[30200];filter:=NostrFilter.{has_kinds=true,kinds=kinds[..],has_limit=true,limit=256};filters:=[1]NostrFilter.[filter];out:[1024]u8;
    n:=nostr_message_write_req("fleet-beacons",filters[..],out[..],false);if n<0 || !relay_conn_send(f[0].conn[..],cast(string)out[0..<n]) {return false;}
    responses:=[2]int.[26910,27010];me:=[1]string.[cast(string)f[0].me[..]];tags:=[1]NostrTagFilter.[NostrTagFilter.{name='p',values=me[..]}];
    filter=NostrFilter.{has_kinds=true,kinds=responses[..],tags=tags[..],has_since=true,since=fh_now_s()-5};filters[0]=filter;
    n=nostr_message_write_req("fleet-answers",filters[..],out[..],false);return n>0 && relay_conn_send(f[0].conn[..],cast(string)out[0..<n]);
}
fm_offer :: (f:[]Fm,e:NostrEvent,provider:string,tags:string,content:string) {
    if f[0].cfg[0].route_provider.count>0 && f[0].cfg[0].route_provider!=provider {return;}
    b:=ph_read_beacon(e.kind,provider,tags,content);if b.code!=PbCode.ok {return;}
    slot:=-1;for i:0..<f[0].count {if cast(string)f[0].rows[i].provider[..]==provider && cast(string)f[0].rows[i].slug[0..<f[0].rows[i].slug_n]==b.pylon {slot=i;}}
    held:PbHeld;if slot>=0 {held=PbHeld.{present=true,generation=f[0].peers[slot].generation,observed_at=f[0].peers[slot].observed};}
    fresh:=pb_fresh(b,fh_now_s(),held)==PbFresh.fresh;if !fresh {return;}
    accepted:=mf_offer(e.verified,true,b.auth,fresh) && mf_free_service(content,provider,f[0].cfg[0].identity);
    // Unrelated historical services cannot consume the bounded route table.
    // Once admitted, a coordinate keeps its generation even when withdrawn.
    if slot<0 && !accepted {return;}
    if slot<0 {if f[0].count==MF_PEERS {return;}slot=f[0].count;f[0].count+=1;for i:0..<64 {f[0].rows[slot].provider[i]=provider[i];}for i:0..<b.pylon.count {f[0].rows[slot].slug[i]=b.pylon[i];}f[0].rows[slot].slug_n=b.pylon.count;f[0].rows[slot].known=true;}
    // A newer valid unsupported/paid/model-mismatched beacon becomes a
    // tombstone for the old route, preserving the held generation.
    f[0].peers[slot]=MfPeer.{present=accepted,tried=f[0].peers[slot].tried,generation=b.generation,observed=b.observed_at,valid_until=b.valid_until,status=cast(int)b.status,free=b.free,identity=ifx accepted then f[0].cfg[0].identity else ""};
}
fm_answer_event :: (f:[]Fm,e:NostrEvent,provider:string,tags:string,content:string) {
    if !f[0].waiting || f[0].answer!=0 {return;}index:=f[0].active;row:=f[0].rows[index];
    expected:=cast(string)row.provider[..];p:=pt_tag(tags,"p");correlation:=pt_tag(tags,"e");
    addressed:=p.ok && p.count==1 && p.size==2 && p.v[1]==cast(string)f[0].me[..];
    bound:=correlation.ok && correlation.count==1 && correlation.size==2 && correlation.v[1]==cast(string)f[0].jid[..];
    if provider!=expected || !addressed || !bound {return;}
    plaintext:[FM_BUFFER]u8;n:=fm_open_payload(f,provider,content,plaintext[..]);if n<0 {return;}body:=cast(string)plaintext[0..<n];
    request:=cast(string)f[0].request[0..<f[0].request_n];
    if e.kind==PD_STATUS {
        attempt:=mf_get(body,"attempt");v:=json_int(attempt.text);
        if mf_string(mf_get(body,"v"),PD_VERSION) && mf_string(mf_get(body,"type"),"status") && mf_string(mf_get(body,"status"),"error") && mf_string(mf_get(body,"request"),request) && v.ok && v.value==f[0].attempt {f[0].answer=-1;}
        return;
    }
    r:=mf_result(body,request,f[0].attempt);valid:=r.ok && mf_answer(r.response,f[0].admitted,sv_test_pools(f[0].storage[..]),f[0].cfg[0].identity,provider,cast(string)row.slug[0..<row.slug_n]);
    timely:=fh_now_s()<=f[0].deadline && e.created_at>=f[0].started-5 && e.created_at<=fh_now_s()+30 && fh_now_s()<=f[0].peers[index].valid_until;
    same:=f[0].peers[index].generation==f[0].active_generation && f[0].peers[index].identity==f[0].cfg[0].identity;
    if mf_reply(e.verified,n>=0,provider==expected,addressed && bound,r.ok,valid && same,timely) {
        if f[0].cfg[0].mesh_checker.count>0 || f[0].capture {
            for i:0..<e.original.count {f[0].result_event[i]=e.original[i];}f[0].result_event_n=e.original.count;
            for i:0..<n {f[0].result_plain[i]=plaintext[i];}f[0].result_plain_n=n;
        }
        for i:0..<r.response.count {f[0].response[i]=r.response[i];}f[0].response_n=r.response.count;f[0].answer=1;
    }
}
fm_frame :: (f:[]Fm,text:string) {
    m:=nostr_message_read(text);
    if m.error!=NM_OK {if nip42_input(f[0].r[..],f[0].n42[..],f[0].gen,text)==RL_AUTH {if !fm_auth(f) {fm_drop(f);}}return;}
    if m.type==NM_ACCEPT {
        d:=rl_input(f[0].r[..],f[0].gen,RlIn.{kind=RL_IN_OK,id=m.id,accepted=m.accepted});
        if d==RL_AUTH {if m.accepted {if !f[0].quiet {print("fleet: relay AUTH accepted\n");}}else {fm_drop(f);return;}}
        id:[64]u8;if f[0].waiting && fm_hex(m.id[..],id[..])==cast(string)f[0].jid[..] {f[0].ack=ifx m.accepted then 1 else -1;}
        if f[0].receipt_event_n>0 && fm_hex(m.id[..],id[..])==cast(string)f[0].receipt_id[..] {f[0].receipt_ack=ifx m.accepted then 1 else -1;}
        return;
    }
    if m.type==NM_EOSE && nm_text(m,m.sub)==f[0].observe_sub {f[0].observed_eose=true;return;}
    if m.type==NM_CLOSED {fm_drop(f);return;}
    if m.type!=NM_EVENT {return;}
    observing:=f[0].observe_sub.count>0 && nm_text(m,m.sub)==f[0].observe_sub;
    if observing {f[0].observe_frames+=1;}
    scratch:[NE_MAX_OUTPUT]u8;e:=nostr_event_verify_vartime(text[m.event.from..<m.event.to],scratch[..],false);if e.error!=NE_OK || !e.verified {if observing {f[0].observe_failed=true;}return;}
    if observing {for i:0..<e.original.count {f[0].observed[i]=e.original[i];}f[0].observed_n=e.original.count;}
    key:[64]u8;provider:=fm_hex(e.public_key[..],key[..]);content:[FM_BUFFER]u8;n:=json_unescape(e.original[e.content_from..<e.content_to],content[..]);if n<0 {return;}
    tags:=e.original[e.tags_from..<e.tags_to];
    if e.kind==PB_KIND {fm_offer(f,e,provider,tags,cast(string)content[0..<n]);}
    else if e.kind==PD_RESULT || e.kind==PD_STATUS {fm_answer_event(f,e,provider,tags,cast(string)content[0..<n]);}
}
fm_pump :: (f:[]Fm,wait:int) {
    if f[0].conn[0].h<0 {return;}
    result:=relay_conn_poll(f[0].conn[..],wait);
    if result==RC_TEXT {fm_frame(f,cast(string)f[0].conn[0].text[0..<f[0].conn[0].text_n]);}
    else if result!=RC_NONE {fm_drop(f);return;}
    if f[0].r[0].auth!=RA_OK && cxsock_now_ms()-f[0].opened>=5000 {fm_drop(f);return;}
    if f[0].r[0].auth==RA_OK && !f[0].subscribed {if fm_subscribe(f) {f[0].subscribed=true;}else {fm_drop(f);}}
}
fm_connect :: (f:[]Fm) {
    if f[0].conn[0].h>=0 || cxsock_now_ms()<f[0].next_connect {return;}
    f[0].r[0]=Relay.{};f[0].gen=rl_start(f[0].r[..],cxsock_now_ms());
    ok:=relay_conn_open(f[0].conn[..],f[0].cfg[0].relay);if !ok {fm_drop(f);return;}
    opened:=rl_opened(f[0].r[..],f[0].gen,cxsock_now_ms());f[0].opened=cxsock_now_ms();f[0].subscribed=false;
    ready:=nip42_init(f[0].n42[..],f[0].cfg[0].relay)==N42_OK;
}
// Local fallback speaks HTTP only to an explicitly configured loopback model.
fm_local :: (f:[]Fm,body:string,budget:int,out:[]u8)->MfResult {
    c:=f[0].cfg[0];end:=cxsock_now_ms()+budget;for b:c.fallback_host {x:=cxsock_host_push(cast(int)b);}
    h:=cxsock_connect(c.fallback_port,budget);if h<0 {return MfResult.{};}
    head:[512]u8;n:=json_raw(head[..],0,"POST /v1/systemone HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: ");n=json_write_int(head[..],n,body.count);n=json_raw(head[..],n,"\r\nConnection: close\r\n\r\n");
    for b:cast(string)head[0..<n] {x:=cxsock_write(h,cast(int)b);}for b:body {x:=cxsock_write(h,cast(int)b);}
    left:=end-cxsock_now_ms();if left<=0 || cxsock_flush(h,left)!=0 {x:=cxsock_close(h);return MfResult.{};}
    used:=0;
    while cxsock_now_ms()<end {
        k:=cxsock_read(h,end-cxsock_now_ms());if k==-1 {break;}if k<0 || used+k>out.count {x:=cxsock_close(h);return MfResult.{};}
        for i:0..<k {out[used+i]=cast(u8)cxsock_byte(h,i);}used+=k;
    }
    x:=cxsock_close(h);framed:=mf_local_http(cast(string)out[0..<used]);if !framed.ok {return MfResult.{};}response:=framed.response;
    valid:=mf_answer(response,f[0].admitted,sv_test_pools(f[0].storage[..]),c.identity,"","");
    if !mf_fallback(true,valid,end-cxsock_now_ms()) {return MfResult.{};}return MfResult.{ok=true,response=response};
}
fm_dispatch :: (f:[]Fm,body:string,out:[]u8)->int {
    f[0].remote_completed=false;c:=f[0].cfg[0];begin:=cxsock_now_ms();end:=begin+c.timeout;discover_end:=begin+c.discover;
    while cxsock_now_ms()<discover_end && cxsock_now_ms()<end && fh_stop()==0 {fm_pump(f,20);}
    for i:0..<f[0].count {f[0].peers[i].tried=false;}
    nonce:[16]u8;request:[32]u8;if !rc_draw(16,nonce[..]) {return sv_refusal(out,SvCode.internal);}id:=fm_hex(nonce[..],request[..]);for i:0..<id.count {f[0].request[i]=id[i];}f[0].request_n=id.count;
    attempt:=0;
    while f[0].subscribed && cxsock_now_ms()<end && fh_stop()==0 {
        index:=mf_choose(f[0].peers[0..<f[0].count],fh_now_s(),c.identity);if index<0 {break;}
        reserve:=ifx c.fallback_port>0 then 1000 else 0;left:=end-cxsock_now_ms()-reserve;if left<=0 {break;}
        budget:=ifx left<c.attempt then left else c.attempt;until:=cxsock_now_ms()+budget;attempt+=1;f[0].peers[index].tried=true;
        f[0].active=index;f[0].active_generation=f[0].peers[index].generation;f[0].started=fh_now_s();f[0].deadline=fh_now_s()+(budget+999)/1000;f[0].attempt=attempt;f[0].ack=0;f[0].answer=0;
        plain:[FM_BUFFER]u8;n:=mf_job(body,cast(string)f[0].request[0..<f[0].request_n],attempt,f[0].deadline,plain[..]);if n<0 {return sv_refusal(out,SvCode.internal);}
        row:=f[0].rows[index];provider:=cast(string)row.provider[..];payload:[FM_BUFFER]u8;m:=fm_seal(f,provider,cast(string)plain[0..<n],payload[..]);if m<0 {continue;}
        tags:[256]u8;t:=json_raw(tags[..],0,"[[\"p\",\"");t=json_raw(tags[..],t,provider);t=json_raw(tags[..],t,"\"],[\"expiration\",\"");t=json_write_int(tags[..],t,f[0].deadline);t=json_raw(tags[..],t,"\"]]");
        scratch:[FM_BUFFER]u8;signed:[FM_BUFFER]u8;s:=fm_sign(f,PD_REQUEST,cast(string)tags[0..<t],cast(string)payload[0..<m],scratch[..],signed[..]);if s<0 {continue;}
        ev:=nostr_event_read(cast(string)signed[0..<s],scratch[..],false);if ev.error!=NE_OK {continue;}text:=fm_hex(ev.id[..],f[0].jid[..]);frame:[FM_BUFFER]u8;k:=nostr_message_write_event(cast(string)signed[0..<s],frame[..],false);if k<0 {continue;}
        if c.mesh_checker.count>0 || f[0].capture {
            for i:0..<s {f[0].job_event[i]=signed[i];}f[0].job_event_n=s;
            for i:0..<n {f[0].job_plain[i]=plain[i];}f[0].job_plain_n=n;
        }
        f[0].waiting=true;
        if !relay_conn_send(f[0].conn[..],cast(string)frame[0..<k]) {fm_drop(f);}else {while (f[0].answer==0 || f[0].ack==0) && f[0].answer>=0 && f[0].ack>=0 && cxsock_now_ms()<until && fh_stop()==0 {fm_pump(f,20);}}
        f[0].waiting=false;
        if f[0].answer==1 && f[0].ack==1 && cxsock_now_ms()<=until && cxsock_now_ms()<=end {f[0].remote_completed=true;f[0].finished=fh_now_s();f[0].record_pending=c.mesh_checker.count>0 && fh_stop()==0;if !f[0].quiet {print("fleet: remote answer from % (% ms)\n",provider,cxsock_now_ms()-begin);}return sv_response(out,200,cast(string)f[0].response[0..<f[0].response_n]);}
    }
    if fh_stop()!=0 {return sv_refusal(out,SvCode.busy);}
    left:=end-cxsock_now_ms();
    if mf_fallback(c.fallback_port>0,true,left) {local:[FM_BUFFER]u8;r:=fm_local(f,body,left,local[..]);if r.ok {if !f[0].quiet {print("fleet: local fallback (% ms)\n",cxsock_now_ms()-begin);}return sv_response(out,200,r.response);}}
    return sv_refusal(out,ifx cxsock_now_ms()>=end then SvCode.timeout else SvCode.busy);
}
fm_write :: (fd:int,text:string)->bool {for b:text {if fh_write(fd,cast(int)b)!=0 {return false;}}return fh_flush(fd,1000)==0;}
fm_client :: (f:[]Fm,fd:int) {
    request:[24576]u8;used:=0;head:SvHead;end:=cxsock_now_ms()+5000;continued:=false;out:[FM_BUFFER]u8;
    while cxsock_now_ms()<end && fh_stop()==0 {
        n:=fh_read(fd,20);if n==-2 {fm_pump(f,0);continue;}if n<=0 {return;}if used+n>request.count {m:=sv_refusal(out[..],SvCode.limit_exceeded);ok:=fm_write(fd,cast(string)out[0..<m]);return;}
        for i:0..<n {request[used+i]=cast(u8)fh_byte(i);}used+=n;head=sv_head(cast(string)request[0..<used]);
        if head.status==SvHeadStatus.refused {m:=sv_refusal(out[..],head.code);ok:=fm_write(fd,cast(string)out[0..<m]);return;}
        if head.status!=SvHeadStatus.ready {continue;}
        if head.body>FM_BODY {m:=sv_refusal(out[..],SvCode.limit_exceeded);ok:=fm_write(fd,cast(string)out[0..<m]);return;}
        if head.expect && !continued {ok:=fm_write(fd,SV_CONTINUE);continued=true;}
        if used<head.head+head.body {continue;}
        if used!=head.head+head.body {m:=sv_refusal(out[..],SvCode.malformed);ok:=fm_write(fd,cast(string)out[0..<m]);return;}
        body:=cast(string)request[head.head..<used];f[0].admitted=sv_decode(body,sv_test_pools(f[0].storage[..]));
        code:=f[0].admitted.code;if code==SvCode.none && f[0].admitted.model!=pb_identity_name(f[0].cfg[0].identity) {code=SvCode.not_admitted;}
        m:=-1;if code!=SvCode.none {m=sv_refusal(out[..],code);}else {m=fm_dispatch(f,body,out[..]);}
        if m>0 {ok:=fm_write(fd,cast(string)out[0..<m]);if !ok {f[0].record_pending=false;}}return;
    }
    m:=sv_refusal(out[..],SvCode.request_timeout);ok:=fm_write(fd,cast(string)out[0..<m]);
}
fm_serve :: () {
    f:[1]Fm;
    if !fm_config(f[0].cfg[..]) {if !f[0].quiet {print("usage: psionic-fleet --identity MODEL@sha256:DIGEST [--relay ws[s]://HOST] [--port 8798] [--timeout-ms 8000] [--attempt-ms 2000] [--discover-ms 500] [--fallback http://localhost:PORT]\n");}x:=fh_status(2);return;}
    if !fm_key(f[..]) {if !f[0].quiet {print("fleet: throwaway buyer identity unavailable\n");}x:=fh_status(3);return;}
    listener:=fh_listen(f[0].cfg[0].port);if listener<0 {if !f[0].quiet {print("fleet: cannot listen on loopback\n");}x:=fh_status(4);return;}
    if !f[0].quiet {print("fleet: ready on http://127.0.0.1:%/v1/systemone, identity % (throwaway buyer key)\n",f[0].cfg[0].port,f[0].cfg[0].identity);}
    while fh_stop()==0 {fm_connect(f[..]);fm_pump(f[..],0);mh_poll_children(f[..]);if f[0].record_pending {mh_record(f[..]);}fd:=fh_accept(listener,20);if fd>=0 {fm_client(f[..],fd);x:=fh_close(fd);}}
    mh_stop_children(f[..]);relay_conn_drop(f[0].conn[..]);x:=fh_close(listener);for i:0..<32 {f[0].key[i]=0;}
}
