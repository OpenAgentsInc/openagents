// Compile a gate graph into gated feed-forward layers whose forward pass reproduces it.
#load "relu-arith.coax";
#authority;

GgOp :: enum u8 {input;add;sub;scale;mul;relu;step;eq0;select;constant;}
// Operands a, b, c are indices of earlier nodes; k is the input index, the scale or the constant.
GgNode :: struct {op:GgOp;a:int;b:int;c:int;k:int;}
GgStatus :: enum u8 {ok;shape;operand;type;range;layers;width;units;terms;capacity;alias;}
// `node` names the refusing node, or the layer for a units refusal.
GgResult :: struct {status:GgStatus;node:int;}
// The plan also records each node's layer, slot and the layer that clears its
// slot (0: never), so chapter 169's interpreter can execute the schedule itself.
GgPlan :: struct {status:GgStatus;node:int;layers:int;width:int;units:[32]int;weights:int;values:int;inputs:int;outputs:int;out:[16]RaForm;
    nodes:int;layer:[128]int;slot:[128]int;clear:[128]int;}
// Deliberate compiler bugs for chapter 169's harness; production code passes none.
GgFault :: enum u8 {none;early_reuse;same_layer;no_clear;clear_sign;}

GG_NODES_MAX :: 128;
GG_LAYERS_MAX :: 32;
GG_INPUTS_MAX :: 16;
GG_OUTPUTS_MAX :: 16;
GG_COEF_SUM_MAX :: 134217728;  // 2^27: with values within 2^26, every partial sum stays within 2^53

#test "max, absolute value and a product with an offset compile and agree" {
    // n0 = a, n1 = b, n2 = a - b, n3 = step(n2), n4 = select(n3, a, b) = max(a, b)
    // n5 = relu(a), n6 = -a, n7 = relu(n6), n8 = n5 + n7 = |a|, n9 = a * b, n10 = n9 + b
    g:=[11]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.input,k=1},GgNode.{op=GgOp.sub,a=0,b=1},
        GgNode.{op=GgOp.step,a=2},GgNode.{op=GgOp.select,c=3,a=0,b=1},GgNode.{op=GgOp.relu,a=0},
        GgNode.{op=GgOp.scale,a=0,k=-1},GgNode.{op=GgOp.relu,a=6},GgNode.{op=GgOp.add,a=5,b=7},
        GgNode.{op=GgOp.mul,a=0,b=1},GgNode.{op=GgOp.add,a=9,b=1}];
    outs:=[3]int.[4,8,10];w:[4096]f64;
    plan:=gg_compile(g[..],outs[..],w[..]);
    #assert plan.status==GgStatus.ok && plan.layers==2 && plan.inputs==2 && plan.outputs==3;
    // Layer 1: step, two ReLUs, the product. Layer 2: select, then clearing a and the step's bit.
    #assert plan.units[0]==2+1+1+2 && plan.units[1]==2+2;
    pairs:=[6]int.[-7,3,5,5,0,-2];
    for i:0..<3 {
        a:=pairs[2*i];b:=pairs[2*i+1];inputs:=[2]int.[a,b];want:[3]int;got:[3]f64;
        #assert gg_eval(g[..],inputs[..],outs[..],want[..]).status==GgStatus.ok;
        #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok;
        for j:0..<3 {#assert got[j]==f64(want[j]);}
        m:=a;if b>a {m=b;}
        n:=a;if a<0 {n=-a;}
        #assert want[0]==m && want[1]==n && want[2]==a*b+b;
    }
}
#test "slots are reused once their last reader has run, even within the same layer" {
    // A chain x -> relu -> relu -> ... keeps one live value at a time.
    g:[9]GgNode;g[0]=GgNode.{op=GgOp.input,k=0};
    for i:1..<9 {g[i]=GgNode.{op=GgOp.relu,a=i-1};}
    outs:=[1]int.[8];w:[4096]f64;plan:=gg_compile(g[..],outs[..],w[..]);
    #assert plan.status==GgStatus.ok && plan.layers==8 && plan.values==9 && plan.width==2;
    for L:0..<8 {#assert plan.units[L]==2;}
    inputs:=[1]int.[6];got:[1]f64;
    #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==6;
    inputs[0]=-6;#assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==0;
    // The input is read by every layer here, so its slot cannot be reused.
    h:[5]GgNode;h[0]=GgNode.{op=GgOp.input,k=0};h[1]=GgNode.{op=GgOp.relu,a=0};
    h[2]=GgNode.{op=GgOp.add,a=1,b=0};h[3]=GgNode.{op=GgOp.relu,a=2};h[4]=GgNode.{op=GgOp.add,a=3,b=0};
    o2:=[1]int.[4];p2:=gg_compile(h[..],o2[..],w[..]);
    #assert p2.status==GgStatus.ok && p2.layers==2 && p2.width==3;
    // relu(5) = 5, 5 + 5 = 10, relu(10) = 10, 10 + 5 = 15; the second ReLU reuses the first one's slot.
    inputs[0]=5;#assert gg_run(p2,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==15;
}
#test "equality and a bit-typed select" {
    g:=[5]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.input,k=1},GgNode.{op=GgOp.sub,a=0,b=1},
        GgNode.{op=GgOp.eq0,a=2},GgNode.{op=GgOp.select,c=3,a=0,b=2}];
    outs:=[2]int.[3,4];w:[4096]f64;plan:=gg_compile(g[..],outs[..],w[..]);
    #assert plan.status==GgStatus.ok && plan.layers==2;
    inputs:=[2]int.[4,4];want:[2]int;got:[2]f64;
    #assert gg_eval(g[..],inputs[..],outs[..],want[..]).status==GgStatus.ok && want[0]==1 && want[1]==4;
    #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==1 && got[1]==4;
    inputs[1]=9;#assert gg_eval(g[..],inputs[..],outs[..],want[..]).status==GgStatus.ok && want[0]==0 && want[1]==-5;
    #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==0 && got[1]==-5;
    // A select whose condition is not a step or equality is refused.
    g[4].c=2;#assert gg_admit(g[..],outs[..]).status==GgStatus.type;
    #assert gg_compile(g[..],outs[..],w[..]).status==GgStatus.type;
    #assert gg_eval(g[..],inputs[..],outs[..],want[..]).status==GgStatus.type;
}
#test "the evaluator refuses values past the bound at the node that produced them" {
    g:=[3]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.mul,a=0,b=0},GgNode.{op=GgOp.add,a=1,b=1}];
    outs:=[1]int.[2];want:[1]int;
    inputs:=[1]int.[4096];#assert gg_eval(g[..],inputs[..],outs[..],want[..]).status==GgStatus.ok && want[0]==33554432;
    inputs[0]=8192;r:=gg_eval(g[..],inputs[..],outs[..],want[..]);#assert r.status==GgStatus.range && r.node==2;
    inputs[0]=8193;r=gg_eval(g[..],inputs[..],outs[..],want[..]);#assert r.status==GgStatus.range && r.node==1;
    inputs[0]=RA_VALUE_MAX+1;r=gg_eval(g[..],inputs[..],outs[..],want[..]);#assert r.status==GgStatus.range && r.node==0;
    inputs[0]=-RA_VALUE_MAX-1;#assert gg_eval(g[..],inputs[..],outs[..],want[..]).node==0;
    s:=[2]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.scale,a=0,k=-3}];o:=[1]int.[1];
    inputs[0]=RA_VALUE_MAX/3;#assert gg_eval(s[..],inputs[..],o[..],want[..]).status==GgStatus.ok && want[0]==-(RA_VALUE_MAX/3)*3;
    inputs[0]=RA_VALUE_MAX/3+1;#assert gg_eval(s[..],inputs[..],o[..],want[..]).status==GgStatus.range;
    #assert gg_eval(s[..],inputs[0..<0],o[..],want[..]).status==GgStatus.capacity;
    #assert gg_eval(s[..],inputs[..],o[..],want[0..<0]).status==GgStatus.capacity;
}
#test "binary32 runs the same weights exactly only while products stay under 2^24" {
    g:=[3]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.input,k=1},GgNode.{op=GgOp.mul,a=0,b=1}];
    outs:=[1]int.[2];w:[4096]f64;plan:=gg_compile(g[..],outs[..],w[..]);got:[1]f64;
    inputs:=[2]int.[4096,4096];#assert gg_run(plan,w[..],inputs[..],got[..],true,false)==GgStatus.ok && got[0]==16777216;
    inputs=[2]int.[4097,4097];#assert gg_run(plan,w[..],inputs[..],got[..],true,false)==GgStatus.ok && got[0]!=16785409;
    #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==16785409;
}
#test "admission refuses malformed graphs before any work" {
    w:[4096]f64;o:=[1]int.[0];one:=[1]GgNode.[GgNode.{op=GgOp.input,k=0}];
    #assert gg_admit(one[..],o[..]).status==GgStatus.ok;
    #assert gg_admit(one[0..<0],o[..]).status==GgStatus.shape;
    #assert gg_admit(one[..],o[0..<0]).status==GgStatus.shape;
    o[0]=1;#assert gg_admit(one[..],o[..]).status==GgStatus.operand;
    o[0]=-1;#assert gg_admit(one[..],o[..]).status==GgStatus.operand;o[0]=0;
    many:[129]GgNode;#assert gg_admit(many[..],o[..]).status==GgStatus.shape;
    outs17:[17]int;#assert gg_admit(one[..],outs17[..]).status==GgStatus.shape;
    two:=[2]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.relu,a=1}];
    r:=gg_admit(two[..],o[..]);#assert r.status==GgStatus.operand && r.node==1;
    two[1].a=-1;#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.add,a=0,b=1};#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.add,a=0,b=-1};#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.select,a=0,b=0,c=1};#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.select,a=0,b=0,c=-1};#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.input,k=0};#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.input,k=2};#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.input,k=-1};#assert gg_admit(two[..],o[..]).status==GgStatus.operand;
    two[1]=GgNode.{op=GgOp.input,k=1};#assert gg_admit(two[..],o[..]).status==GgStatus.ok;
    two[1]=GgNode.{op=GgOp.scale,a=0,k=RA_VALUE_MAX+1};#assert gg_admit(two[..],o[..]).status==GgStatus.range;
    two[1]=GgNode.{op=GgOp.scale,a=0,k=-RA_VALUE_MAX-1};#assert gg_admit(two[..],o[..]).status==GgStatus.range;
    two[1]=GgNode.{op=GgOp.scale,a=0,k=RA_VALUE_MAX};#assert gg_admit(two[..],o[..]).status==GgStatus.ok;
    seventeen:[17]GgNode;for i:0..<17 {seventeen[i]=GgNode.{op=GgOp.input,k=i};}
    #assert gg_admit(seventeen[..],o[..]).status==GgStatus.operand && gg_admit(seventeen[0..<16],o[..]).status==GgStatus.ok;
    #assert gg_compile(two[0..<0],o[..],w[..]).status==GgStatus.shape;
}
#test "the compiler refuses programs that do not fit a block" {
    w:[16384]f64;o:=[1]int.[0];
    deep:[34]GgNode;deep[0]=GgNode.{op=GgOp.input,k=0};for i:1..<34 {deep[i]=GgNode.{op=GgOp.relu,a=i-1};}
    o[0]=32;#assert gg_compile(deep[0..<33],o[..],w[..]).status==GgStatus.ok;
    o[0]=33;r:=gg_compile(deep[..],o[..],w[..]);#assert r.status==GgStatus.layers && r.node==33;
    // 64 slots: the constant one and 63 ReLUs of one input, the first of which takes the
    // input's slot once its last reader, layer 1, has run.
    wide:[66]GgNode;wide[0]=GgNode.{op=GgOp.input,k=0};for i:1..<66 {wide[i]=GgNode.{op=GgOp.relu,a=0};}
    outs:[16]int;for i:0..<16 {outs[i]=i+1;}
    wp:=gg_compile(wide[0..<64],outs[..],w[..]);#assert wp.status==GgStatus.ok && wp.width==64 && wp.values==64;
    wr:=gg_compile(wide[0..<65],outs[..],w[..]);#assert wr.status==GgStatus.width && wr.node==64;
    // Weights must fit the caller's buffer: 28 products need 3 * 29 * 58 = 5,046 values.
    sq:[66]GgNode;sq[0]=GgNode.{op=GgOp.input,k=0};sq[1]=GgNode.{op=GgOp.input,k=1};
    for i:2..<66 {sq[i]=GgNode.{op=GgOp.mul,a=0,b=1};}
    o1:=[1]int.[2];
    #assert gg_compile(sq[0..<30],o1[..],w[..]).weights==5046;
    #assert gg_compile(sq[0..<30],o1[..],w[0..<5045]).status==GgStatus.capacity;
    // More than eight distinct terms in one linear form: x0 + ... + x8 over nine inputs.
    sum:[17]GgNode;for i:0..<9 {sum[i]=GgNode.{op=GgOp.input,k=i};}
    sum[9]=GgNode.{op=GgOp.add,a=0,b=1};for i:10..<17 {sum[i]=GgNode.{op=GgOp.add,a=i-1,b=i-8};}
    o[0]=15;#assert gg_compile(sum[0..<16],o[..],w[..]).status==GgStatus.ok;
    o[0]=16;rr:=gg_compile(sum[..],o[..],w[..]);#assert rr.status==GgStatus.terms && rr.node==16;
    // Repeating a term merges it instead of adding one: x + x + ... stays one term.
    rep:[12]GgNode;rep[0]=GgNode.{op=GgOp.input,k=0};for i:1..<12 {rep[i]=GgNode.{op=GgOp.add,a=i-1,b=0};}
    o[0]=11;#assert gg_compile(rep[..],o[..],w[..]).status==GgStatus.ok;
    // Coefficients whose sum could overflow binary64's exact range.
    big:=[3]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.scale,a=0,k=RA_VALUE_MAX},GgNode.{op=GgOp.scale,a=1,k=3}];
    o[0]=1;#assert gg_compile(big[0..<2],o[..],w[..]).status==GgStatus.ok;
    o[0]=2;#assert gg_compile(big[..],o[..],w[..]).status==GgStatus.range;
}
#test "gadget forms must fit as well as node forms" {
    // Eight distinct terms are a full form: a step on it would need a ninth for its constant.
    full:[16]GgNode;for i:0..<8 {full[i]=GgNode.{op=GgOp.input,k=i};}
    full[8]=GgNode.{op=GgOp.add,a=0,b=1};
    for i:2..<8 {full[7+i]=GgNode.{op=GgOp.add,a=6+i,b=i};}
    // full[14] is x0 + ... + x7, eight terms.
    full[15]=GgNode.{op=GgOp.step,a=14};o:=[1]int.[15];w:[8192]f64;
    r:=gg_compile(full[..],o[..],w[..]);#assert r.status==GgStatus.terms && r.node==15;
    full[15]=GgNode.{op=GgOp.eq0,a=14};#assert gg_compile(full[..],o[..],w[..]).status==GgStatus.terms;
    full[15]=GgNode.{op=GgOp.relu,a=14};#assert gg_compile(full[..],o[..],w[..]).status==GgStatus.ok;
    full[15]=GgNode.{op=GgOp.step,a=13};#assert gg_compile(full[..],o[..],w[..]).status==GgStatus.ok;
    // select(c, a, b) forms a - b: x0..x7 minus a distinct node needs nine terms.
    s:[18]GgNode;for i:0..<16 {s[i]=full[i];}
    s[15]=GgNode.{op=GgOp.relu,a=0};s[16]=GgNode.{op=GgOp.step,a=0};s[17]=GgNode.{op=GgOp.select,c=16,a=14,b=15};
    o[0]=17;#assert gg_compile(s[..],o[..],w[..]).status==GgStatus.terms;
    // Minus a node already in the form, it merges and fits.
    s[17]=GgNode.{op=GgOp.select,c=16,a=14,b=0};#assert gg_compile(s[..],o[..],w[..]).status==GgStatus.ok;
    // x - x is empty, so it costs no terms at all.
    z:=[3]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.sub,a=0,b=0},GgNode.{op=GgOp.relu,a=1}];o1:=[1]int.[2];
    pz:=gg_compile(z[..],o1[..],w[..]);inputs:=[1]int.[5];got:[1]f64;
    #assert pz.status==GgStatus.ok && gg_run(pz,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==0;
}
#test "each planted fault changes the plan or the weights, and only that" {
    // x, r1 = relu(x), r2 = relu(r1), r3 = relu(r2), m = r1 * r3: r1 is read in layers 2 and 4.
    g:=[5]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.relu,a=0},GgNode.{op=GgOp.relu,a=1},
        GgNode.{op=GgOp.relu,a=2},GgNode.{op=GgOp.mul,a=1,b=3}];
    outs:=[1]int.[4];w:[4096]f64;inputs:=[1]int.[3];got:[1]f64;
    honest:=gg_compile(g[..],outs[..],w[..]);
    #assert honest.status==GgStatus.ok && honest.layers==4 && honest.layer[1]==1 && honest.layer[4]==4;
    #assert honest.clear[0]==1 && honest.clear[1]==4 && honest.clear[2]==3 && honest.clear[3]==4 && honest.clear[4]==0;
    #assert gg_run(honest,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==9;
    // Same layer: each relu lands in its operand's layer, so the chain collapses to one layer.
    same:=gg_compile_planted(g[..],outs[..],w[..],GgFault.same_layer);
    #assert same.status==GgStatus.ok && same.layer[1]==1 && same.layer[2]==1 && same.layer[3]==1 && same.layer[4]==1;
    #assert gg_run(same,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]!=9;
    // No clear: the plan clears nothing and every layer is one unit lighter where a clear was.
    stale:=gg_compile_planted(g[..],outs[..],w[..],GgFault.no_clear);
    for i:0..<5 {#assert stale.clear[i]==0;}
    #assert stale.units[0]==honest.units[0]-1 && stale.units[3]==honest.units[3]-2;
    #assert gg_run(stale,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]!=9;
    // Clear sign: the same plan, but clearing adds instead of subtracting.
    sign:=gg_compile_planted(g[..],outs[..],w[..],GgFault.clear_sign);
    for i:0..<5 {#assert sign.clear[i]==honest.clear[i] && sign.slot[i]==honest.slot[i] && sign.layer[i]==honest.layer[i];}
    #assert gg_run(sign,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]!=9;
    // Early reuse: r1's slot is handed out in layer 3, a layer before its last reader.
    early:=gg_compile_planted(g[..],outs[..],w[..],GgFault.early_reuse);
    #assert early.clear[1]==4 && early.slot[3]==early.slot[1] && honest.slot[3]!=honest.slot[1];
    #assert gg_run(early,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]!=9;
    // An input read only in layer 2 is released in layer 1, where a gate takes its slot.
    late:=[4]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.constant,k=2},GgNode.{op=GgOp.relu,a=1},GgNode.{op=GgOp.mul,a=0,b=2}];
    o3:=[1]int.[3];pl:=gg_compile(late[..],o3[..],w[..]);
    #assert gg_run(pl,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==6;
    pe:=gg_compile_planted(late[..],o3[..],w[..],GgFault.early_reuse);
    #assert pe.slot[2]==pe.slot[0] && pl.slot[2]!=pl.slot[0];
    #assert gg_run(pe,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]!=6;
    // The plan records every node, starting with node 0.
    #assert honest.nodes==5 && honest.slot[0]==1 && pl.nodes==4 && pl.slot[0]==1;
    // A node read only in the layer after its own is never released early.
    short:=[3]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.relu,a=0},GgNode.{op=GgOp.relu,a=1}];o2:=[1]int.[2];
    ps:=gg_compile_planted(short[..],o2[..],w[..],GgFault.early_reuse);
    #assert gg_run(ps,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==3;
}
#test "units per layer are bounded" {
    w:[40000]f64;g:[70]GgNode;g[0]=GgNode.{op=GgOp.input,k=0};g[1]=GgNode.{op=GgOp.input,k=1};
    for i:2..<70 {g[i]=GgNode.{op=GgOp.mul,a=0,b=1};}
    // Each product is two units and holds a slot until read; read all of them in one sum chain.
    o:=[1]int.[2];
    // 60 products of two units each, and one unit to clear each input after layer 1.
    up:=gg_compile(g[0..<62],o[..],w[..]);#assert up.status==GgStatus.ok && up.units[0]==122 && up.width==61;
    eq:[66]GgNode;eq[0]=GgNode.{op=GgOp.input,k=0};for i:1..<66 {eq[i]=GgNode.{op=GgOp.eq0,a=0};}
    o[0]=1;r:=gg_compile(eq[0..<27],o[..],w[..]);#assert r.status==GgStatus.units && r.node==0;
    #assert gg_compile(eq[0..<26],o[..],w[..]).status==GgStatus.ok && gg_compile(eq[0..<26],o[..],w[..]).units[0]==126;
}
#test "runs refuse inputs and outputs that do not match the plan" {
    g:=[2]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.relu,a=0}];o:=[1]int.[1];w:[4096]f64;
    plan:=gg_compile(g[..],o[..],w[..]);inputs:=[1]int.[3];got:[1]f64;
    #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==3;
    #assert gg_run(plan,w[..],inputs[0..<0],got[..],false,false)==GgStatus.capacity;
    #assert gg_run(plan,w[..],inputs[..],got[0..<0],false,false)==GgStatus.capacity;
    #assert gg_run(plan,w[0..<plan.weights-1],inputs[..],got[..],false,false)==GgStatus.capacity;
    #assert gg_run(plan,w[..],inputs[..],got[..],false,true)==GgStatus.alias;
    inputs[0]=RA_VALUE_MAX+1;#assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.range;
    inputs[0]=-RA_VALUE_MAX-1;#assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.range;
    bad:=plan;bad.status=GgStatus.shape;#assert gg_run(bad,w[..],inputs[..],got[..],false,false)==GgStatus.shape;
}

#test "every operation at its boundary values in the evaluator and the block" {
    // n0 = x, then relu, step, eq0 of x, x * x, a constant and a select on step.
    g:=[8]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.relu,a=0},GgNode.{op=GgOp.step,a=0},
        GgNode.{op=GgOp.eq0,a=0},GgNode.{op=GgOp.mul,a=0,b=0},GgNode.{op=GgOp.constant,k=-7},
        GgNode.{op=GgOp.select,c=2,a=0,b=5},GgNode.{op=GgOp.add,a=6,b=5}];
    outs:=[7]int.[1,2,3,4,5,6,7];w:[4096]f64;plan:=gg_compile(g[..],outs[..],w[..]);
    #assert plan.status==GgStatus.ok && plan.layers==2;
    for x:-2..<3 {
        inputs:=[1]int.[x];want:[7]int;got:[7]f64;
        #assert gg_eval(g[..],inputs[..],outs[..],want[..]).status==GgStatus.ok;
        #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok;
        r:=0;if x>=1 {r=x;}
        s:=0;if x>=1 {s=1;}
        e:=0;if x==0 {e=1;}
        sel:=-7;if s==1 {sel=x;}
        #assert want[0]==r && want[1]==s && want[2]==e && want[3]==x*x && want[4]==-7 && want[5]==sel && want[6]==sel-7;
        for j:0..<7 {#assert got[j]==f64(want[j]);}
    }
    inputs:=[1]int.[RA_VALUE_MAX];want:[7]int;
    #assert gg_eval(g[0..<4],inputs[..],outs[0..<3],want[..]).status==GgStatus.ok && want[0]==RA_VALUE_MAX;
    inputs[0]=-RA_VALUE_MAX;#assert gg_eval(g[0..<4],inputs[..],outs[0..<3],want[..]).status==GgStatus.ok;
    got:[3]f64;p3:=gg_compile(g[0..<4],outs[0..<3],w[..]);
    #assert gg_run(p3,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==0 && got[2]==0;
    inputs[0]=RA_VALUE_MAX;#assert gg_run(p3,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==f64(RA_VALUE_MAX);
    c:=[2]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.constant,k=RA_VALUE_MAX+1}];o1:=[1]int.[1];
    #assert gg_admit(c[..],o1[..]).status==GgStatus.range;
    c[1].k=-RA_VALUE_MAX-1;#assert gg_admit(c[..],o1[..]).status==GgStatus.range;
    c[1].k=-RA_VALUE_MAX;#assert gg_admit(c[..],o1[..]).status==GgStatus.ok;
    c[1]=GgNode.{op=GgOp.scale,a=0,k=-RA_VALUE_MAX};#assert gg_admit(c[..],o1[..]).status==GgStatus.ok;
}
#test "a gate waits for its deepest operand, whichever position it is in" {
    // x * relu(x), relu(x) * x, select with a deep condition, and a sum whose deep term is first or last.
    g:=[9]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.relu,a=0},GgNode.{op=GgOp.mul,a=0,b=1},
        GgNode.{op=GgOp.mul,a=1,b=0},GgNode.{op=GgOp.step,a=1},GgNode.{op=GgOp.select,c=4,a=0,b=0},
        GgNode.{op=GgOp.add,a=1,b=0},GgNode.{op=GgOp.relu,a=6},GgNode.{op=GgOp.add,a=0,b=1}];
    full:[10]GgNode;for i:0..<9 {full[i]=g[i];}full[9]=GgNode.{op=GgOp.relu,a=8};
    outs:=[5]int.[2,3,5,7,9];w:[8192]f64;plan:=gg_compile(full[..],outs[..],w[..]);
    #assert plan.status==GgStatus.ok && plan.layers==3;
    for x:-3..<4 {
        inputs:=[1]int.[x];want:[5]int;got:[5]f64;
        #assert gg_eval(full[..],inputs[..],outs[..],want[..]).status==GgStatus.ok;
        #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok;
        for j:0..<5 {#assert got[j]==f64(want[j]);}
    }
}
#test "a constant read by an early gate never clears the slot that holds one" {
    // relu(x + 3) in layer 1 reads the constant; step(...) in layer 2 needs slot 0 to still be 1.
    g:=[5]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.constant,k=3},GgNode.{op=GgOp.add,a=0,b=1},
        GgNode.{op=GgOp.relu,a=2},GgNode.{op=GgOp.step,a=3}];
    outs:=[1]int.[4];w:[4096]f64;plan:=gg_compile(g[..],outs[..],w[..]);
    #assert plan.status==GgStatus.ok && plan.layers==2;
    for x:-5..<2 {
        inputs:=[1]int.[x];got:[1]f64;want:=0;if x+3>=1 {want=1;}
        #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==f64(want);
    }
}
#test "an output stays readable even after the gates that read it have run" {
    // relu chain of four, with node 1 an output and also read by node 2.
    g:[5]GgNode;g[0]=GgNode.{op=GgOp.input,k=0};for i:1..<5 {g[i]=GgNode.{op=GgOp.relu,a=i-1};}
    outs:=[2]int.[1,4];w:[4096]f64;plan:=gg_compile(g[..],outs[..],w[..]);
    // Slots: one, the input (handed to node 1 in layer 1), node 1 (kept), then nodes 2-4 in turn.
    #assert plan.status==GgStatus.ok && plan.width==3;
    inputs:=[1]int.[9];got:[2]f64;
    #assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==9 && got[1]==9;
}
#test "admission and capacity at their exact limits" {
    chain:[128]GgNode;chain[0]=GgNode.{op=GgOp.input,k=0};for i:1..<128 {chain[i]=GgNode.{op=GgOp.add,a=i-1,b=i-1};}
    o:=[1]int.[0];#assert gg_admit(chain[..],o[..]).status==GgStatus.ok;
    // A select whose condition is node 0 (an input) is a type error, not a bad index.
    s:=[2]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.select,a=0,b=0,c=0}];
    #assert gg_admit(s[..],o[..]).status==GgStatus.type;
    g:=[3]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.input,k=1},GgNode.{op=GgOp.mul,a=0,b=1}];
    o1:=[1]int.[2];w:[4096]f64;plan:=gg_compile(g[..],o1[..],w[..]);
    #assert gg_compile(g[..],o1[..],w[0..<plan.weights]).status==GgStatus.ok;
    #assert gg_compile(g[..],o1[..],w[0..<plan.weights-1]).status==GgStatus.capacity;
    inputs:=[2]int.[3,4];got:[1]f64;
    #assert gg_run(plan,w[0..<plan.weights],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==12;
    inputs=[2]int.[RA_VALUE_MAX,-1];#assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok && got[0]==-f64(RA_VALUE_MAX);
    inputs=[2]int.[-RA_VALUE_MAX,1];#assert gg_run(plan,w[..],inputs[..],got[..],false,false)==GgStatus.ok;
    // Coefficient sums at 2^27 compile; one more is refused.
    // (Adding x itself would merge into -2^27 + 1, which fits; a second input does not merge.)
    k:=[5]GgNode.[GgNode.{op=GgOp.input,k=0},GgNode.{op=GgOp.scale,a=0,k=-RA_VALUE_MAX},GgNode.{op=GgOp.scale,a=1,k=2},
        GgNode.{op=GgOp.input,k=1},GgNode.{op=GgOp.add,a=2,b=3}];
    o1[0]=2;#assert gg_compile(k[0..<3],o1[..],w[..]).status==GgStatus.ok;
    o1[0]=4;rr:=gg_compile(k[..],o1[..],w[..]);#assert rr.status==GgStatus.range && rr.node==4;
}
#test "128 units fit in a layer and 129 do not" {
    w:[40000]f64;
    g:[28]GgNode;g[0]=GgNode.{op=GgOp.input,k=0};g[1]=GgNode.{op=GgOp.input,k=1};
    for i:2..<27 {g[i]=GgNode.{op=GgOp.eq0,a=0};}
    // 25 equalities (125 units), then one more gate, plus a unit to clear each input.
    g[27]=GgNode.{op=GgOp.relu,a=1};o:=[1]int.[2];
    p:=gg_compile(g[..],o[..],w[..]);#assert p.status==GgStatus.ok && p.units[0]==128;
    g[27]=GgNode.{op=GgOp.mul,a=0,b=1};r:=gg_compile(g[..],o[..],w[..]);#assert r.status==GgStatus.units && r.node==0;
}

// book:begin admit
gg_arity :: (op:GgOp)->int {
    if op==GgOp.input || op==GgOp.constant {return 0;}
    if op==GgOp.add || op==GgOp.sub || op==GgOp.mul {return 2;}
    if op==GgOp.select {return 3;}
    return 1;
}
gg_bit :: (op:GgOp)->bool {return op==GgOp.step || op==GgOp.eq0;}
gg_admit :: (nodes:[]GgNode,outputs:[]int)->GgResult #export_c {
    if nodes.count<1 || nodes.count>GG_NODES_MAX || outputs.count<1 || outputs.count>GG_OUTPUTS_MAX {return GgResult.{status=GgStatus.shape};}
    inputs:=0;
    for i:0..<nodes.count {
        n:=nodes[i];
        if cast(int)n.op>cast(int)GgOp.constant {return GgResult.{status=GgStatus.operand,node=i};}
        arity:=gg_arity(n.op);
        if arity>=1 && (n.a<0 || n.a>=i) {return GgResult.{status=GgStatus.operand,node=i};}
        if arity>=2 && (n.b<0 || n.b>=i) {return GgResult.{status=GgStatus.operand,node=i};}
        if arity==3 && (n.c<0 || n.c>=i) {return GgResult.{status=GgStatus.operand,node=i};}
        if arity==3 && !gg_bit(nodes[n.c].op) {return GgResult.{status=GgStatus.type,node=i};}
        // Inputs are numbered 0, 1, 2, ... in the order they appear.
        if n.op==GgOp.input {
            if n.k!=inputs || inputs>=GG_INPUTS_MAX {return GgResult.{status=GgStatus.operand,node=i};}
            inputs+=1;
        }
        if (n.op==GgOp.scale || n.op==GgOp.constant) && (n.k< -RA_VALUE_MAX || n.k>RA_VALUE_MAX) {return GgResult.{status=GgStatus.range,node=i};}
    }
    for o:outputs {if o<0 || o>=nodes.count {return GgResult.{status=GgStatus.operand,node=o};}}
    return GgResult.{};
}
// book:end admit

// book:begin eval
// The reference: integers, every value within RA_VALUE_MAX, refused at the
// first node that leaves it.
gg_eval :: (nodes:[]GgNode,inputs:[]int,outputs:[]int,values:[]int)->GgResult #export_c {
    admitted:=gg_admit(nodes,outputs);if admitted.status!=GgStatus.ok {return admitted;}
    v:[128]int;count:=0;
    for n:nodes {if n.op==GgOp.input {count+=1;}}
    if inputs.count!=count || values.count<outputs.count {return GgResult.{status=GgStatus.capacity};}
    for i:0..<nodes.count {
        n:=nodes[i];x:=0;
        if n.op==GgOp.input {x=inputs[n.k];}
        if n.op==GgOp.add {x=v[n.a]+v[n.b];}
        if n.op==GgOp.sub {x=v[n.a]-v[n.b];}
        if n.op==GgOp.scale {x=v[n.a]*n.k;}
        if n.op==GgOp.mul {x=v[n.a]*v[n.b];}
        if n.op==GgOp.constant {x=n.k;}
        if n.op==GgOp.relu && v[n.a]>=1 {x=v[n.a];}
        if n.op==GgOp.step && v[n.a]>=1 {x=1;}
        if n.op==GgOp.eq0 && v[n.a]==0 {x=1;}
        if n.op==GgOp.select {x=v[n.b];if v[n.c]==1 {x=v[n.a];}}
        if x< -RA_VALUE_MAX || x>RA_VALUE_MAX {return GgResult.{status=GgStatus.range,node=i};}
        v[i]=x;
    }
    for i:0..<outputs.count {values[i]=v[outputs[i]];}
    return GgResult.{};
}
// book:end eval

// book:begin schedule
// A node's form is a sum over "base" nodes: inputs and nonlinear gates, each of
// which owns a residual slot. Linear nodes (add, sub, scale) cost no layer; a
// gate runs in the layer after its latest operand. A base node's slot is
// cleared in the layer of its last reader and may be handed to a gate written
// in that same layer, because every unit reads the residual before any unit
// writes it.
gg_linear :: (op:GgOp)->bool {return op==GgOp.add || op==GgOp.sub || op==GgOp.scale || op==GgOp.constant;}
gg_gate :: (op:GgOp)->bool {return op!=GgOp.input && !gg_linear(op);}
// The larger of two layers, without a comparison whose tie case is invisible.
gg_max :: (a:int,b:int)->int {return (a+b+cast(int)abs(f64(a-b)))/2;}
gg_form_of :: (nodes:[]GgNode,forms:[]RaForm,i:int)->RaForm {
    n:=nodes[i];
    if n.op==GgOp.add {return ra_plus(forms[n.a],forms[n.b]);}
    if n.op==GgOp.sub {return ra_plus(forms[n.a],ra_neg(forms[n.b]));}
    if n.op==GgOp.scale {f:=forms[n.a];for t:0..<f.count {f.coefs[t]*=n.k;}return f;}
    // A constant is its own base node, pinned to slot 0 (which holds 1), so its
    // form is k times that node.
    if n.op==GgOp.constant {return ra_term(i,n.k);}
    return ra_term(i,1);
}
gg_coef_sum :: (f:RaForm)->f64 {
    s:f64=0;
    for t:0..<f.count {s+=abs(f64(f.coefs[t]));}
    return s;
}
// book:end schedule

// book:begin compile
// Node 0 is always an input (it has no earlier node to read), so loops over
// gates start at node 1.
gg_layer_of :: (f:RaForm,layer:[]int)->int {
    deepest:=0;
    for t:0..<f.count {deepest=gg_max(deepest,layer[f.slots[t]]);}
    return deepest;
}
gg_operand :: (n:GgNode,which:int)->int {
    if which==1 {return n.b;}
    if which==2 {return n.c;}
    return n.a;
}
gg_compile :: (nodes:[]GgNode,outputs:[]int,weights:[]f64)->GgPlan #export_c {
    return gg_compile_planted(nodes,outputs,weights,GgFault.none);
}
gg_compile_planted :: (nodes:[]GgNode,outputs:[]int,weights:[]f64,fault:GgFault)->GgPlan #export_c {
    admitted:=gg_admit(nodes,outputs);
    if admitted.status!=GgStatus.ok {return GgPlan.{status=admitted.status,node=admitted.node};}
    forms:[128]RaForm;layer:[128]int;last:[128]int;slot:[128]int;kept:[128]bool;
    plan:GgPlan;plan.outputs=outputs.count;
    // Forms over base nodes, the coefficient bound, and layers: a gate runs one
    // layer after its deepest operand; a linear node sits at its deepest term.
    for i:0..<nodes.count {
        n:=nodes[i];forms[i]=gg_form_of(nodes,forms[..],i);
        if forms[i].count==-1 {return GgPlan.{status=GgStatus.terms,node=i};}
        if gg_coef_sum(forms[i])>f64(GG_COEF_SUM_MAX) {return GgPlan.{status=GgStatus.range,node=i};}
        if n.op==GgOp.input {plan.inputs+=1;}
        // A gadget builds forms of its own: step and equality add a constant term,
        // select forms a - b. Those must fit too, or the gate is refused here.
        if (n.op==GgOp.step || n.op==GgOp.eq0) && forms[n.a].count>=RA_TERMS {return GgPlan.{status=GgStatus.terms,node=i};}
        if n.op==GgOp.select && ra_plus(forms[n.a],ra_neg(forms[n.b])).count==-1 {return GgPlan.{status=GgStatus.terms,node=i};}
        if gg_gate(n.op) {
            deepest:=0;
            for which:0..<gg_arity(n.op) {deepest=gg_max(deepest,gg_layer_of(forms[gg_operand(n,which)],layer[..]));}
            // Planted: a gate placed in its deepest operand's own layer reads it before it is written.
            next:=1;if fault==GgFault.same_layer && deepest>=1 {next=0;}
            layer[i]=deepest+next;
            if layer[i]>GG_LAYERS_MAX {return GgPlan.{status=GgStatus.layers,node=i};}
            plan.layers=gg_max(plan.layers,layer[i]);
        }
        // Constants live in slot 0 and are never cleared.
        if n.op==GgOp.constant {kept[i]=true;}
    }
    // The last layer that reads each base node (0: never read by a gate);
    // outputs are read after the last layer, so their nodes are kept.
    for i:1..<nodes.count {
        n:=nodes[i];
        if gg_gate(n.op) {
            for which:0..<gg_arity(n.op) {
                f:=forms[gg_operand(n,which)];
                for t:0..<f.count {last[f.slots[t]]=gg_max(last[f.slots[t]],layer[i]);}
            }
        }
    }
    for o:outputs {f:=forms[o];for t:0..<f.count {kept[f.slots[t]]=true;}}
    // Clearing: in the layer of the last reader, for slots that are not kept.
    // Planted: a slot handed out one layer early, or never cleared, or cleared with the wrong sign.
    release:[128]int;
    for i:0..<nodes.count {
        if last[i]>=1 && !kept[i] {
            release[i]=last[i];plan.clear[i]=last[i];
            if fault==GgFault.early_reuse && last[i]>=2 {release[i]=last[i]-1;}
            if fault==GgFault.no_clear {plan.clear[i]=0;}
        }
    }
    // Slots: 0 holds the constant one, then inputs in order, then gates by layer.
    // A slot is freed in the layer of its node's last reader; 0 means none chosen.
    free:[64]bool;plan.width=1;
    for i:0..<nodes.count {if nodes[i].op==GgOp.input {slot[i]=plan.width;plan.width+=1;plan.values+=1;}}
    for layer_index:0..<plan.layers {
        L:=layer_index+1;
        for i:0..<nodes.count {if release[i]==L {free[slot[i]]=true;}}
        for i:1..<nodes.count {
            if layer[i]==L && gg_gate(nodes[i].op) {
                plan.values+=1;chosen:=0;
                for s:1..<plan.width {if chosen==0 && free[s] {chosen=s;}}
                if chosen==0 {
                    if plan.width>=RA_WIDTH_MAX {return GgPlan.{status=GgStatus.width,node=i};}
                    chosen=plan.width;plan.width+=1;
                }
                free[chosen]=false;slot[i]=chosen;
            }
        }
    }
    // Units per layer: each gate's units, plus one to clear each freed slot.
    for i:0..<nodes.count {
        if gg_gate(nodes[i].op) {plan.units[layer[i]-1]+=gg_units(nodes[i].op);}
        if plan.clear[i]>=1 {plan.units[plan.clear[i]-1]+=1;}
    }
    for L:0..<plan.layers {
        if plan.units[L]>RA_UNITS_MAX {return GgPlan.{status=GgStatus.units,node=L};}
        plan.weights+=ra_weight_count(plan.width,plan.units[L]);
    }
    if weights.count<plan.weights {return GgPlan.{status=GgStatus.capacity};}
    for k:0..<plan.weights {weights[k]=0;}
    // Emit: forms over base nodes become forms over their slots.
    base:=0;
    for layer_index:0..<plan.layers {
        L:=layer_index+1;units:=plan.units[layer_index];w:=weights[base..<base+ra_weight_count(plan.width,units)];u:=0;
        for i:1..<nodes.count {
            n:=nodes[i];
            if layer[i]==L && gg_gate(n.op) {
                a:=gg_slots(forms[n.a],slot[..]);t:=slot[i];
                if n.op==GgOp.mul {u=ra_mul(w,plan.width,units,u,a,gg_slots(forms[n.b],slot[..]),t);}
                if n.op==GgOp.relu {u=ra_relu(w,plan.width,units,u,a,t);}
                if n.op==GgOp.step {u=ra_step(w,plan.width,units,u,a,t);}
                if n.op==GgOp.eq0 {u=ra_eq0(w,plan.width,units,u,a,t);}
                if n.op==GgOp.select {u=ra_select(w,plan.width,units,u,gg_slots(forms[n.c],slot[..]),a,gg_slots(forms[n.b],slot[..]),t);}
            }
        }
        for i:0..<nodes.count {
            if plan.clear[i]==L {
                sign:=-1;if fault==GgFault.clear_sign {sign=-sign;}
                #assert ra_unit(w,plan.width,units,u,ra_term(slot[i],1),ra_one(),slot[i],sign);u+=1;
            }
        }
        #assert u==units;
        base+=ra_weight_count(plan.width,units);
    }
    for k:0..<outputs.count {plan.out[k]=gg_slots(forms[outputs[k]],slot[..]);}
    plan.nodes=nodes.count;
    for i:0..<nodes.count {plan.layer[i]=layer[i];plan.slot[i]=slot[i];}
    return plan;
}
gg_units :: (op:GgOp)->int {
    if op==GgOp.relu {return 1;}
    if op==GgOp.eq0 {return 5;}
    return 2;
}
gg_slots :: (f:RaForm,slot:[]int)->RaForm {r:=f;for t:0..<f.count {r.slots[t]=slot[f.slots[t]];}return r;}
// book:end compile

// book:begin run
// The compiled block: slot 0 is one, inputs fill slots 1 onward, every other
// slot starts at zero; each layer is chapter 167's gated layer; outputs are
// read as linear forms over the final residual.
gg_run :: (plan:GgPlan,weights:[]f64,inputs:[]int,outputs:[]f64,single:bool,overlap:bool)->GgStatus #export_c {
    if plan.status!=GgStatus.ok {return plan.status;}
    if weights.count<plan.weights || inputs.count!=plan.inputs || outputs.count<plan.outputs {return GgStatus.capacity;}
    if overlap {return GgStatus.alias;}
    for v:inputs {if v< -RA_VALUE_MAX || v>RA_VALUE_MAX {return GgStatus.range;}}
    x:[64]f64;x[0]=1;
    for k:0..<inputs.count {x[k+1]=f64(inputs[k]);}
    base:=0;
    for L:0..<plan.layers {
        n:=ra_weight_count(plan.width,plan.units[L]);
        // The layer stages its output, so it may write the residual it reads.
        #assert ra_forward(plan.width,plan.units[L],weights[base..<base+n],x[0..<plan.width],x[0..<plan.width],single,false)==RaStatus.ok;
        base+=n;
    }
    for k:0..<plan.outputs {
        f:=plan.out[k];sum:f64=0;
        for t:0..<f.count {sum=ra_round(sum+ra_round(f64(f.coefs[t])*x[f.slots[t]],single),single);}
        outputs[k]=sum;
    }
    return GgStatus.ok;
}
// book:end run
