gx_positive :: (v:f64)->f64 {return (v+abs(v))/2;}
#test "residual positive mass before normalization" {#assert gx_positive(-0.5)==0 && gx_positive(0)==0 && gx_positive(0.5)==0.5;}
GSpecBlock :: struct {status:GStatus;written:int;accepted:int;bonus:bool;}
// book:begin block
gx_block :: (vocab:int,target:[]f64,draft:[]f64,proposals:[]int,uniforms:[]f64,greedy:bool,out:[]int,stage:[]int,residual:[]f64,scratch:[]f64,overlap:bool)->GSpecBlock #export_c {
    k:=proposals.count;if !gs_size(vocab) || !gx_draft_count(k) {return GSpecBlock.{status=GStatus.shape};}
    if target.count!=(k+1)*vocab || draft.count!=k*vocab || uniforms.count!=2*k+1 || out.count<k+1 || stage.count<k+1 || residual.count<vocab || scratch.count<vocab {return GSpecBlock.{status=GStatus.capacity};}if overlap {return GSpecBlock.{status=GStatus.alias};}
    for row:1..<k+1 {if gs_pick(target[row*vocab..<(row+1)*vocab],0).status!=GStatus.ok {return GSpecBlock.{status=GStatus.number};}}
    for row:1..<k {if gs_pick(draft[row*vocab..<(row+1)*vocab],0).status!=GStatus.ok {return GSpecBlock.{status=GStatus.number};}}
    for u:uniforms {if !(u>=0 && u<1) {return GSpecBlock.{status=GStatus.number};}}
    accepted:=0;written:=k+1;
    for i:0..<k {decision:=gx_decide(target[i*vocab..<(i+1)*vocab],draft[i*vocab..<(i+1)*vocab],proposals[i],uniforms[2*i],uniforms[2*i+1],greedy,residual,scratch,false);
        if decision.status!=GStatus.ok {return GSpecBlock.{status=decision.status};}stage[i]=decision.token;
        if !decision.accepted {written=i+1;break;}accepted+=1;
    }
    bonus:=accepted==k;if bonus {p:=target[k*vocab..<(k+1)*vocab];stage[k]=ifx greedy then gx_argmax(p) else gs_pick(p,uniforms[2*k]).token;}
    for i:0..<written {out[i]=stage[i];}return GSpecBlock.{written=written,accepted=accepted,bonus=bonus};
}
// book:end block
gx_draft_count :: (n:int)->bool {return n>=1 && n<=16;}
// Complete snapshots preserve overwritten sliding-ring slots on rollback.
gx_snapshot :: (input:[]f32,out:[]f32,overlap:bool)->GResult #export_c {
    if !gx_snapshot_size(input.count) {return GResult.{status=GStatus.shape};}if out.count<input.count {return GResult.{status=GStatus.capacity};}if overlap {return GResult.{status=GStatus.alias};}
    for i:0..<input.count {out[i]=input[i];}return GResult.{written=input.count};
}
gx_snapshot_size :: (n:int)->bool {return n>=1 && n<=3221225472;}
#test "a block emits its first correction or an all-match bonus atomically" {
    target:=[9]f64.[0.5,0.25,0.25,0.25,0.25,0.5,1,0,0];draft:=[6]f64.[0.5,0.25,0.25,0.25,0.5,0.25];proposal:=[2]int.[0,1];u:=[5]f64.[0,0,0.9,0,0];out:=[4]int.[-7,-7,-7,-7];stage:[3]int;r:[3]f64;s:[3]f64;
    b:=gx_block(3,target[..],draft[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false);#assert b.status==GStatus.ok && b.accepted==1 && b.written==2 && !b.bonus && out[0]==0 && out[1]==2 && out[2]== -7;
    u[2]=0;b=gx_block(3,target[..],draft[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false);#assert b.status==GStatus.ok && b.accepted==2 && b.written==3 && b.bonus && out[2]==0 && out[3]== -7;
    out[0]=-7;target[6]=0;#assert gx_block(3,target[..],draft[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.number && out[0]== -7;
    #assert gx_draft_count(1) && gx_draft_count(16) && !gx_draft_count(0) && !gx_draft_count(17);
    #assert gx_snapshot_size(1) && gx_snapshot_size(3221225472) && !gx_snapshot_size(0) && !gx_snapshot_size(3221225473);
    a:=[2]f32.[3,4];saved:=[3]f32.[-7,-7,-7];#assert gx_snapshot(a[..],saved[..],false).status==GStatus.ok && saved[0]==3 && saved[1]==4 && saved[2]== -7;
    #assert gx_snapshot(a[..],saved[0..<1],false).status==GStatus.capacity && gx_snapshot(a[..],saved[..],true).status==GStatus.alias;
}
#test "one-token greedy bonus and exact snapshot capacity" {
    p:=[4]f64.[1,0,0,1];q:=[2]f64.[1,0];proposed:=[1]int.[0];u:=[3]f64.[0,0.2,0.9];out:=[2]int.[-7,-7];stage:=[2]int.[-9,-9];r:[2]f64;s:[2]f64;
    b:=gx_block(2,p[..],q[..],proposed[..],u[..],true,out[..],stage[..],r[..],s[..],false);#assert b.status==GStatus.ok && b.written==2 && b.accepted==1 && b.bonus && out[0]==0 && out[1]==1;
    stage[1]=-9;b=gx_block(2,p[..],q[..],proposed[..],u[..],false,out[..],stage[..],r[..],s[..],false);#assert b.status==GStatus.ok && b.bonus && out[1]==1;
    a:=[2]f32.[3,4];saved:[2]f32;#assert gx_snapshot(a[..],saved[..],false).status==GStatus.ok && saved[1]==4;
    #assert gx_snapshot(a[0..<0],saved[..],false).status==GStatus.shape;
}
#test "block refusal checks all counts and late data before publication" {
    p:=[4]f64.[1,0,0,1];q:=[2]f64.[1,0];proposal:=[1]int.[0];u:=[3]f64.[0,0,0];out:=[2]int.[-7,-7];stage:[2]int;r:[2]f64;s:[2]f64;
    #assert gx_block(0,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.shape;
    #assert gx_block(2,p[..],q[..],proposal[0..<0],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.shape;
    for field:0..<7 {a:=p[..];b:=q[..];c:=u[..];d:=out[..];e:=stage[..];f:=r[..];g:=s[..];
        if field==0 {a=p[0..<3];}else if field==1 {b=q[0..<1];}else if field==2 {c=u[0..<2];}else if field==3 {d=out[0..<1];}else if field==4 {e=stage[0..<1];}else if field==5 {f=r[0..<1];}else {g=s[0..<1];}
        #assert gx_block(2,a,b,proposal[..],c,false,d,e,f,g,false).status==GStatus.capacity;
    }
    #assert gx_block(2,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],true).status==GStatus.alias;
    q[0]=0;#assert gx_block(2,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.number;q[0]=1;
    u[2]=1;#assert gx_block(2,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.number;u[2]=-1;#assert gx_block(2,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.number;u[2]=0;
    proposal[0]=2;#assert gx_block(2,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.shape && out[0]== -7;
}

#test "later corrections use their own uniform and all-match bonus uses the full last row" {
    p:=[9]f64.[1,0,0,0.25,0.25,0.5,0,0,1];q:=[6]f64.[1,0,0,0,1,0];proposal:=[2]int.[0,1];u:=[5]f64.[0,0,0.8,0.5,0.1];out:[3]int;stage:[3]int;r:[3]f64;s:[3]f64;
    b:=gx_block(3,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false);#assert b.status==GStatus.ok && b.accepted==1 && out[1]==2;
    p[3]=0;p[4]=1;p[5]=0;b=gx_block(3,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false);#assert b.status==GStatus.ok && b.bonus && out[2]==2;
    // First proposal rejects. Later rows are still validated before publication.
    p[0]=0;p[1]=1;q[3]=0;q[4]=0;out[0]=-7;#assert gx_block(3,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.number && out[0]== -7;
    q[4]=1;p[4]=0;#assert gx_block(3,p[..],q[..],proposal[..],u[..],false,out[..],stage[..],r[..],s[..],false).status==GStatus.number && out[0]== -7;
}
