// Standard rejection sampling. Model evaluation/snapshot storage is separate.
#load "sampling.coax";
#authority;
GSpeculation :: struct {status:GStatus;accepted:bool;token:int;acceptance:f64;certain:bool;}

#test "binary-rational acceptance and residual recover the target distribution" {
    p:=[3]f64.[0.5,0.25,0.25];q:=[3]f64.[0.25,0.5,0.25];r:[4]f64;s:[3]f64;r[3]=-7;
    a:=gx_decide(p[..],q[..],0,0.99,0.5,false,r[..],s[..],false);#assert a.status==GStatus.ok && a.accepted && a.token==0 && a.acceptance==1;
    b:=gx_decide(p[..],q[..],1,0.499,0.5,false,r[..],s[..],false);#assert b.status==GStatus.ok && b.accepted && b.acceptance==0.5;
    b=gx_decide(p[..],q[..],1,0.5,0.5,false,r[..],s[..],false);#assert b.status==GStatus.ok && !b.accepted && b.token==0 && r[0]==1 && r[1]==0 && r[2]==0 && r[3]== -7;
    // q(i)*accept(i) + rejection_mass*residual(i) = p(i), exactly.
    #assert q[0]+0.25*r[0]==p[0] && q[1]*0.5+0.25*r[1]==p[1] && q[2]+0.25*r[2]==p[2];
    c:=gx_decide(p[..],q[..],2,0.9,0.2,true,r[..],s[..],false);#assert c.status==GStatus.ok && !c.accepted && c.token==0;
    c=gx_decide(p[..],q[..],0,0.9,0.2,true,r[..],s[..],false);#assert c.status==GStatus.ok && c.accepted && c.token==0;
    #assert gx_argmax(q[..])==1 && gx_argmax(p[..])==0;
}
#test "speculation refuses impossible proposals and invalid distributions" {
    p:=[2]f64.[1,0];q:=[2]f64.[0,1];r:[2]f64;s:[2]f64;
    #assert gx_decide(p[..],q[..],0,0.5,0.5,false,r[..],s[..],false).status==GStatus.token;
    #assert gx_decide(p[..],q[..],-1,0.5,0.5,false,r[..],s[..],false).status==GStatus.shape;
    #assert gx_decide(p[..],q[..],2,0.5,0.5,false,r[..],s[..],false).status==GStatus.shape;
    #assert gx_decide(p[..],q[0..<1],1,0.5,0.5,false,r[..],s[..],false).status==GStatus.capacity;
    #assert gx_decide(p[..],q[..],1,1,0.5,false,r[..],s[..],false).status==GStatus.shape;
    #assert gx_decide(p[..],q[..],1,0.5,-1,false,r[..],s[..],false).status==GStatus.shape;
    #assert gx_decide(p[..],q[..],1,0.5,0.5,false,r[0..<1],s[..],false).status==GStatus.capacity;
    #assert gx_decide(p[..],q[..],1,0.5,0.5,false,r[..],s[0..<1],false).status==GStatus.capacity;
    #assert gx_decide(p[..],q[..],1,0.5,0.5,false,r[..],s[..],true).status==GStatus.alias;
    p[0]=0;#assert gx_decide(p[..],q[..],1,0.5,0.5,false,r[..],s[..],false).status==GStatus.number;
}
// book:begin decide
gx_decide :: (target:[]f64,draft:[]f64,proposal:int,accept_uniform:f64,correct_uniform:f64,greedy:bool,residual:[]f64,stage:[]f64,overlap:bool)->GSpeculation #export_c {
    n:=target.count;if !gs_size(n) || proposal<0 || proposal>=n || !(accept_uniform>=0 && accept_uniform<1) || !(correct_uniform>=0 && correct_uniform<1) {return GSpeculation.{status=GStatus.shape};}
    if draft.count!=n || residual.count<n || stage.count<n {return GSpeculation.{status=GStatus.capacity};}if overlap {return GSpeculation.{status=GStatus.alias};}
    if gs_pick(target,0).status!=GStatus.ok || gs_pick(draft,0).status!=GStatus.ok {return GSpeculation.{status=GStatus.number};}
    if draft[proposal]==0 {return GSpeculation.{status=GStatus.token};}
    if greedy {id:=gx_argmax(target);return GSpeculation.{accepted=proposal==id,token=id,acceptance=ifx proposal==id then 1.0 else 0.0};}
    certain:=target[proposal]>=draft[proposal];acceptance:=1.0;if !certain {acceptance=target[proposal]/draft[proposal];}
    if accept_uniform<acceptance {return GSpeculation.{accepted=true,token=proposal,acceptance=acceptance,certain=certain};}
    sum:PsionicAccumulator;for i:0..<n {v:=target[i]-draft[i];stage[i]=gx_positive(v);sum=psionic_ops_accumulate(sum,stage[i]);}total:=psionic_ops_total(sum);
    for i:0..<n {stage[i]/=total;}pick:=gs_pick(stage[0..<n],correct_uniform);#assert pick.status==GStatus.ok;
    for i:0..<n {residual[i]=stage[i];}return GSpeculation.{token=pick.token,acceptance=acceptance,certain=certain};
}
// book:end decide
gx_argmax :: (p:[]f64)->int #export_c {best:=0;for i:1..<p.count {if p[i]>p[best] {best=i;}}return best;}
// Longest prompt suffix, most recent previous occurrence on ties. No prediction
// outside the supplied, already observed token history. -1 means no draft.
gx_ngram :: (history:[]int,maximum:int)->int #export_c {
    if !gx_history_size(history.count,maximum) {return -1;}
    width:=maximum;while width>0 {end:=history.count-width;candidate:=end-1;while candidate>=0 {
        equal:=true;for i:0..<width {if history[candidate+i]!=history[end+i] {equal=false;break;}}
        if equal {return history[candidate+width];}candidate-=1;
    }width-=1;}return -1;
}
#test "n-gram drafts choose the longest most recent matching suffix" {
    x:=[9]int.[1,2,3,1,2,4,1,2,3];#assert gx_ngram(x[..],3)==1 && gx_ngram(x[0..<8],2)==4;
    #assert gx_ngram(x[0..<2],2)== -1 && gx_ngram(x[0..<1],2)== -1 && gx_ngram(x[..],0)== -1 && gx_ngram(x[..],65)== -1;
}

gx_history_size :: (n:int,k:int)->bool {return n>=2 && n<=16384 && k>=1 && k<=64;}
#test "uniform, tie, certain and history endpoints" {
    p:=[2]f64.[0.5,0.5];q:=[2]f64.[0.5,0.5];r:[2]f64;s:[2]f64;
    a:=gx_decide(p[..],q[..],0,0,0,false,r[..],s[..],false);#assert a.status==GStatus.ok && a.accepted && a.certain;
    a=gx_decide(p[..],q[..],1,0,0,true,r[..],s[..],false);#assert a.status==GStatus.ok && !a.accepted && a.acceptance==0;
    a=gx_decide(p[..],q[..],0,0,0,true,r[..],s[..],false);#assert a.status==GStatus.ok && a.accepted && a.acceptance==1;
    #assert gx_decide(p[..],q[..],0,0,1,false,r[..],s[..],false).status==GStatus.shape;
    #assert gx_argmax(p[..])==0;
    #assert gx_history_size(2,1) && gx_history_size(16384,64) && !gx_history_size(1,1) && !gx_history_size(16385,1) && !gx_history_size(2,0) && !gx_history_size(2,65);
}
