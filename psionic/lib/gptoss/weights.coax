#test "binding capacities, publication and digest preflight" {
    data:=GT_FILE;pins:=GOWN_ARTIFACTS;specs:=GOWN_SPECS;files:=[1]GFile.[GFile.{name="tiny.safetensors",data=data[..]}];blocks:[2]GBlock;draft:[2]GBlock;out:[1]GModel;
    #assert g_bind_trusted(GShape.{},pins[..],specs[..],files[..],blocks[..],draft[..],out[..],false).status==GStatus.shape;
    #assert g_bind_trusted(GT_SHAPE,pins[0..<0],specs[..],files[..],blocks[..],draft[..],out[..],false).status==GStatus.weights;
    #assert g_bind_trusted(GT_SHAPE,pins[..],specs[0..<32],files[..],blocks[..],draft[..],out[..],false).status==GStatus.weights;
    #assert g_bind_trusted(GT_SHAPE,pins[..],specs[..],files[..],blocks[..],draft[0..<1],out[..],false).status==GStatus.capacity;
    #assert g_bind_trusted(GT_SHAPE,pins[..],specs[..],files[..],blocks[..],draft[..],out[0..<0],false).status==GStatus.capacity;
    #assert g_bind_trusted(GT_SHAPE,pins[..],specs[..],files[..],blocks[..],draft[..],out[..],false).status==GStatus.ok;
    draft[0].p[0]=data[0..<0];#assert out[0].blocks[0].p[0].count==64 && out[0].shape.layers==2 && out[0].shape.capacity==8;
    profile:=GProfile.{status=GStatus.token};#assert g_bind_profile(profile,files[..],blocks[..],draft[..],out[..],false).status==GStatus.token;
    profile.status=GStatus.ok;#assert g_bind_profile(profile,files[..],blocks[..],draft[..],out[..],true).status==GStatus.alias;
    files[0].name="bad";#assert g_authenticate(pins[..],files[..]).status==GStatus.weights;files[0].name="tiny.safetensors";pins[0].bytes-=1;#assert g_authenticate(pins[..],files[..]).status==GStatus.weights;
}
#test "coverage refuses an unclaimed payload byte" {
    data:=GT_FILE;pins:=GOWN_ARTIFACTS;specs:=GOWN_SPECS;files:=[1]GFile.[GFile.{name="tiny.safetensors",data=data[..]}];blocks:[2]GBlock;draft:[2]GBlock;out:[1]GModel;extra:[54013]u8;for i:0..<54012 {extra[i]=data[i];}files[0].data=extra[..];pins[0].bytes+=1;
    #assert g_bind_trusted(GT_SHAPE,pins[..],specs[..],files[..],blocks[..],draft[..],out[..],false).status==GStatus.weights;
}

g_spec_window :: (x:GSpec,pin:GArtifact)->bool {n:=g_spec_bytes(x);return pin.header!=0 && n>=1 && x.begin>=pin.header && x.begin<=pin.bytes-n && x.end==x.begin+n;}
#test "single byte descriptor boundaries" {
    x:=GSpec.{dtype=1,rank=1,dims=[4]int.[1,0,0,0],begin=8,end=9};pin:=GArtifact.{header=8,bytes=9};#assert g_spec_window(x,pin);x.begin=9;x.end=10;#assert !g_spec_window(x,pin);
    x.begin=7;x.end=8;#assert !g_spec_window(x,pin);pin.header=0;#assert !g_spec_window(x,pin);
}
#test "unordered descriptors, sidecars and exact aggregate residency" {
    data:=GT_FILE;pins:[2]GArtifact;initial:=GOWN_ARTIFACTS;pins[0]=initial[0];pins[1]=GArtifact.{name="abc",bytes=3,sha="ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"};
    abc:=[3]u8.[97,98,99];files:=[2]GFile.[GFile.{name="tiny.safetensors",data=data[..]},GFile.{name="abc",data=abc[..]}];specs:=GOWN_SPECS;blocks:[2]GBlock;draft:[2]GBlock;out:[1]GModel;
    saved:=specs[0];specs[0]=specs[30];specs[30]=saved;
    r:=g_bind_trusted(GT_SHAPE,pins[..],specs[..],files[..],blocks[..],draft[..],out[..],false);#assert r.status==GStatus.ok && r.bytes==54015;
    hashes:=[2]GArtifact.[pins[1],pins[1]];parts:=[2]GFile.[files[1],files[1]];r=g_authenticate(hashes[..],parts[..]);#assert r.status==GStatus.ok && r.written==2 && r.bytes==6;
    #assert g_authenticate(hashes[0..<1],parts[..]).status==GStatus.weights;
}
