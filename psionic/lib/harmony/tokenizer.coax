// Separate pinned gpt-oss tokenizer profile; never normalizes input bytes.
#load "../text/tokenizer.coax";
#load "../../fixtures/harmony/toy.coax";
#authority;
HS_CAP :: [7]int.[199998,524288,8192,0,0,199998,8388608];
HS_SPECIAL :: [15]string.["<|startoftext|>","<|endoftext|>","<|reserved_200000|>","<|reserved_200001|>","<|return|>","<|constrain|>","<|reserved_200004|>","<|channel|>","<|start|>","<|end|>","<|message|>","<|reserved_200009|>","<|reserved_200010|>","<|reserved_200011|>","<|call|>"];

#test "a distinct layout admits bounded sections and rejects incomplete tables" {
    table:=HS_TOY;t:=hs_layout(table[..]);#assert t.status==PtStatus.ok && t.counts[0]==266 && t.counts[5]==266;
    #assert hs_layout(table[0..<31]).status==PtStatus.artifact && hs_layout(table[0..<table.count-1]).status==PtStatus.artifact;
    for k:0..<4 {copy:=table;copy[k]=0;#assert hs_layout(copy[..]).status==PtStatus.artifact;}
    for k:0..<7 {#assert hs_count(k,HS_CAP[k]);#assert !hs_count(k,HS_CAP[k]+1);}
    #assert !hs_count(0,255) && !hs_count(2,0) && hs_count(0,256);
    for k:0..<7 {copy:=table;row:=4+k*4;copy[row]=255;copy[row+1]=255;copy[row+2]=255;copy[row+3]=255;#assert hs_layout(copy[..]).status==PtStatus.artifact;}
    copy:=table;copy[24]=0;#assert hs_layout(copy[..]).status==PtStatus.artifact;
}
#test "ordinary text preserves decomposed bytes and cannot inject control tokens" {
    table:=HS_TOY;out:[64]int;stage:[64]int;symbols:[1024]int;
    r:=hs_encode_checked(table[..],"hello's 1234 é <|start|>",out[..],stage[..],symbols[..],false);
    #assert r.status==PtStatus.ok && r.written>10 && out[0]==261 && out[1]==263;
    for i:0..<r.written {#assert out[i]<266;}
    bytes:[128]u8;scratch:[128]u8;d:=hs_decode_checked(table[..],out[0..<r.written],bytes[..],scratch[..],false);
    #assert d.status==PtStatus.ok && cast(string)bytes[0..<d.written]=="hello's 1234 é <|start|>";
    out[0]=-7;#assert hs_encode_checked(table[..],"hello",out[0..<0],stage[..],symbols[..],false).status==PtStatus.capacity && out[0]==-7;
    #assert hs_encode_checked(table[..],"hello",out[..],stage[0..<0],symbols[..],false).status==PtStatus.capacity;
    #assert hs_encode_checked(table[..],"hello",out[..],stage[..],symbols[0..<1],false).status==PtStatus.capacity;
    #assert hs_encode_checked(table[..],"x",out[..],stage[..],symbols[..],true).status==PtStatus.alias;
    #assert hs_encode_checked(table[0..<0],"x",out[..],stage[..],symbols[..],false).status==PtStatus.artifact;
    bad:=[1]u8.[255];#assert hs_encode_checked(table[..],cast(string)bad[..],out[..],stage[..],symbols[..],false).status==PtStatus.utf8;
    #assert hs_encode_checked(table[..],"",out[..],stage[..],symbols[..],false).written==0;
}
#test "lookup orders byte strings by content and length before ranked merging" {
    table:=HS_TOY;t:=hs_layout(table[..]);
    #assert hs_lookup(table[..],t,"hello")==261 && hs_lookup(table[..],t,"aba")==257;
    #assert hs_lookup(table[..],t,"hellp")==-1 && hs_lookup(table[..],t,"helloo")==-1 && hs_lookup(table[..],t,"")==-1;
    out:[8]int;r:=hs_bpe(table[..],t,"ababa",out[..]);#assert r.status==PtStatus.ok && r.written==2 && out[0]==256 && out[1]==257;
}
#test "explicit special decoding uses the gpt-oss vocabulary endpoint" {
    table:=HS_TOY;tokens:=[5]int.[200006,200005,200008,200002,201087];out:[128]u8;work:[128]u8;
    r:=hs_decode_checked(table[..],tokens[..],out[..],work[..],false);
    #assert r.status==PtStatus.ok && cast(string)out[0..<r.written]=="<|start|><|channel|><|message|><|return|><|reserved_201087|>";
    tokens[4]=201088;out[0]=7;r=hs_decode_checked(table[..],tokens[..],out[..],work[..],false);#assert r.status==PtStatus.range && r.written==0 && out[0]==7;
    tokens[4]=-1;#assert hs_decode_checked(table[..],tokens[..],out[..],work[..],false).status==PtStatus.range;
    #assert hs_decode_checked(table[..],tokens[..],out[..],work[..],true).status==PtStatus.alias;
}

hs_count :: (k:int,n:int)->bool {if n<0 || n>HS_CAP[k] {return false;}if k==0 {return n>=256;}if k==2 {return n>=1;}return true;}
// book:begin layout
hs_layout :: (data:[]u8)->PtLayout #export_c {
    if !pt_header_count(data.count) {return PtLayout.{status=PtStatus.artifact};}
    if data[0]!='H' || data[1]!='S' || data[2]!='T' || data[3]!='7' {return PtLayout.{status=PtStatus.artifact};}
    t:PtLayout;at:=1056;
    for k:0..<7 {n:=pt_u32(data,4+k*4);if !hs_count(k,n) {return PtLayout.{status=PtStatus.artifact};}t.counts[k]=n;t.starts[k]=at;at+=n*PT_WIDTH[k];}
    if at!=data.count || t.counts[5]!=t.counts[0] {return PtLayout.{status=PtStatus.artifact};}return t;
}
// book:end layout
hs_compare :: (table:[]u8,t:PtLayout,id:int,s:string)->int {
    span:=pt_span(table,t,id);if span.status!=PtStatus.ok {return 2;}
    n:=span.end-span.begin;
    for i:0..<n {if i>=s.count {return 1;}a:=table[span.begin+i];if a<s[i] {return -1;}if a>s[i] {return 1;}}
    if n<s.count {return -1;}return 0;
}
hs_lookup :: (table:[]u8,t:PtLayout,s:string)->int {
    lo:=0;hi:=t.counts[5];
    while lo<hi {
        mid:=pt_mid(lo,hi);id:=pt_u32(table,pt_row(t,5,mid));order:=hs_compare(table,t,id,s);
        if order==2 {return -2;}if order==0 {return id;}
        if order== -1 {lo=mid+1;}else {hi=mid;}
    }
    return -1;
}
hs_bpe :: (table:[]u8,t:PtLayout,s:string,symbols:[]int)->PtResult {
    if symbols.count<s.count {return PtResult.{status=PtStatus.capacity};}
    id:=hs_lookup(table,t,s);if id== -2 {return PtResult.{status=PtStatus.artifact};}
    if id!= -1 {symbols[0]=id;return PtResult.{written=1};}
    return pt_bpe(table,t,s,symbols);
}
hs_word_tail :: (table:[]u8,t:PtLayout,s:string,at:int,lower_first:bool)->int {
    p:=at;last_lower:=at;
    while p!=s.count {r:=pt_rune(s,p);if !pt_has(table,t,r.cp,82) {break;}p=r.next;if pt_has(table,t,r.cp,98) {last_lower=p;}}
    end:=pt_run(table,t,s,p,98,true);
    if lower_first {if end>p {return end;}return last_lower;}
    if p>at {return end;}return at;
}
hs_word :: (table:[]u8,t:PtLayout,s:string,at:int,lower_first:bool)->int {
    r:=pt_rune(s,at);
    if r.cp!=13 && r.cp!=10 && !pt_has(table,t,r.cp,5) {end:=hs_word_tail(table,t,s,r.next,lower_first);if end>r.next {return end;}}
    return hs_word_tail(table,t,s,at,lower_first);
}
hs_number :: (flags:int)->bool {return (flags&4)!=0;}
// book:begin pieces
hs_piece :: (table:[]u8,t:PtLayout,s:string,at:int)->int {
    end:=hs_word(table,t,s,at,true);if end==at {end=hs_word(table,t,s,at,false);}
    if end>at {if end<s.count {return pt_contraction(s,end);}return end;}
    r:=pt_rune(s,at);
    if hs_number(pt_prop(table,t,r.cp).flags) {for i:0..<3 {if end==s.count {break;}next:=pt_rune(s,end);if !hs_number(pt_prop(table,t,next.cp).flags) {break;}end=next.next;}return end;}
    p:=at;if r.cp==32 {p=r.next;}end=pt_run(table,t,s,p,13,false);
    if end>p {while end!=s.count {next:=pt_rune(s,end);if next.cp!=13 && next.cp!=10 && next.cp!=47 {break;}end=next.next;}return end;}
    last_newline:=at;last_space:=at;
    while p!=s.count {next:=pt_rune(s,p);if !pt_has(table,t,next.cp,8) {break;}last_space=p;p=next.next;if next.cp==13 || next.cp==10 {last_newline=p;}}
    if last_newline>at {return last_newline;}if p==s.count {return p;}if last_space>at {return last_space;}return p;
}
// book:end pieces
hs_append :: (table:[]u8,t:PtLayout,input:string,stage:[]int,symbols:[]int,used:int)->PtResult {
    if !pt_text_count(input.count) {return PtResult.{status=PtStatus.size};}
    valid:=pt_utf8_validate(input);if valid!=PtStatus.ok {return PtResult.{status=valid};}
    at:=0;n:=0;work:=used;
    while at<input.count {
        end:=hs_piece(table,t,input,at);width:=end-at;if !pt_piece_budget(work,width) {return PtResult.{status=PtStatus.budget};}work+=width*width;
        r:=hs_bpe(table,t,input[at..<end],symbols);if r.status!=PtStatus.ok {return r;}
        if r.written>stage.count-n {return PtResult.{status=PtStatus.capacity};}
        for i:0..<r.written {stage[n+i]=symbols[i];}n+=r.written;if !pt_token_count(n) {return PtResult.{status=PtStatus.size};}at=end;
    }
    return PtResult.{written=n,work=work};
}
// book:begin encode
hs_encode_checked :: (table:[]u8,input:string,out:[]int,stage:[]int,symbols:[]int,overlap:bool)->PtResult #export_c {
    if overlap {return PtResult.{status=PtStatus.alias};}t:=hs_layout(table);if t.status!=PtStatus.ok {return PtResult.{status=t.status};}
    r:=hs_append(table,t,input,stage,symbols,0);if r.status!=PtStatus.ok {return r;}
    if out.count<r.written {return PtResult.{status=PtStatus.capacity};}
    for i:0..<r.written {out[i]=stage[i];}return r;
}
// book:end encode
hs_special_valid :: (id:int)->bool {return id>=199998 && id<201088;}
hs_special_bytes :: (id:int,out:[]u8)->PtResult {
    if !hs_special_valid(id) {return PtResult.{status=PtStatus.range};}
    if id<200013 {text:=HS_SPECIAL[id-199998];if out.count<text.count {return PtResult.{status=PtStatus.capacity};}for i:0..<text.count {out[i]=text[i];}return PtResult.{written=text.count};}
    if out.count<19 {return PtResult.{status=PtStatus.capacity};}
    prefix:="<|reserved_";for i:0..<prefix.count {out[i]=prefix[i];}
    value:=id;for i:0..<6 {out[16-i]=cast(u8)(value%10)+'0';value/=10;}out[17]='|';out[18]='>';
    return PtResult.{written=19};
}
hs_decode_checked :: (table:[]u8,tokens:[]int,out:[]u8,stage:[]u8,overlap:bool)->PtResult #export_c {
    if !pt_token_count(tokens.count) {return PtResult.{status=PtStatus.size};}if overlap {return PtResult.{status=PtStatus.alias};}
    t:=hs_layout(table);if t.status!=PtStatus.ok {return PtResult.{status=t.status};}n:=0;
    for id:tokens {
        if id<199998 {
            span:=pt_span(table,t,id);if span.status!=PtStatus.ok {return PtResult.{status=span.status};}width:=span.end-span.begin;
            if width>stage.count-n {return PtResult.{status=PtStatus.capacity};}for i:0..<width {stage[n+i]=table[span.begin+i];}n+=width;
        }else {r:=hs_special_bytes(id,stage[n..<stage.count]);if r.status!=PtStatus.ok {return r;}n+=r.written;}
        if !pt_text_count(n) {return PtResult.{status=PtStatus.size};}
    }
    if out.count<n {return PtResult.{status=PtStatus.capacity};}for i:0..<n {out[i]=stage[i];}return PtResult.{written=n};
}

#load "../../fixtures/harmony/goldens.coax";
#test "all byte symbols include rank zero and the last sorted lookup entry" {
    table:=HS_TOY;t:=hs_layout(table[..]);one:[1]u8;symbols:[1]int;
    for byte:0..<256 {one[0]=cast(u8)byte;#assert hs_lookup(table[..],t,cast(string)one[..])==byte;r:=hs_bpe(table[..],t,cast(string)one[..],symbols[..]);#assert r.status==PtStatus.ok && r.written==1 && symbols[0]==byte;}
    beyond:=[2]u8.[255,255];#assert hs_lookup(table[..],t,cast(string)beyond[..])== -1;
    #assert hs_bpe(table[..],t,"a",symbols[0..<0]).status==PtStatus.capacity;
    #assert hs_count(2,1) && !hs_count(2,-1);
    #assert hs_compare(table[..],t,-1,"a")==2;
    row:=pt_row(t,5,t.counts[5]/2);value:=t.counts[0];for i:0..<4 {table[row+i]=cast(u8)((cast(u32)value>>(8*i))&255);}
    #assert hs_lookup(table[..],t,"hello")== -2 && hs_bpe(table[..],t,"a",symbols[..]).status==PtStatus.artifact;
}
#test "case alternatives and numeric classes retain their distinct domains" {
    table:=HS_TOY;t:=hs_layout(table[..]);
    #assert hs_word_tail(table[..],t,"abc",0,false)==0;
    #assert hs_word(table[..],t,"\rabc",0,true)==0 && hs_word(table[..],t,"\nABC",0,false)==0;
    #assert hs_piece(table[..],t,"\r  ",0)==1;
    #assert hs_number(4) && !hs_number(1) && !hs_number(0);
}
#test "exact encode and decode storage bounds do not consume spare capacity" {
    table:=HS_TOY;out:=[3]int.[-7,-7,-7];stage:[3]int;symbols:[1024]int;
    r:=hs_encode_checked(table[..],"a b",out[..],stage[..],symbols[..],false);#assert r.status==PtStatus.ok && r.written==3;
    out[0]=-7;r=hs_encode_checked(table[..],"a b",out[..],stage[0..<1],symbols[..],false);#assert r.status==PtStatus.capacity && out[0]==-7;
    ids:=[2]int.[97,98];bytes:[2]u8;work:[2]u8;r=hs_decode_checked(table[..],ids[..],bytes[..],work[..],false);
    #assert r.status==PtStatus.ok && r.written==2 && cast(string)bytes[..]=="ab";
    bytes[0]=7;#assert hs_decode_checked(table[..],ids[..],bytes[0..<1],work[..],false).status==PtStatus.capacity && bytes[0]==7;
    #assert hs_decode_checked(table[..],ids[..],bytes[..],work[0..<1],false).status==PtStatus.capacity && bytes[0]==7;
}
#test "all special literals and the first reserved extension have exact lengths" {
    table:=HS_TOY;out:[32]u8;work:[32]u8;id:[1]int;
    #assert hs_special_valid(199998) && hs_special_valid(201087) && !hs_special_valid(199997) && !hs_special_valid(201088);
    for i:0..<15 {
        text:=HS_SPECIAL[i];r:=hs_special_bytes(199998+i,out[0..<text.count]);#assert r.status==PtStatus.ok && r.written==text.count && cast(string)out[0..<r.written]==text;
        #assert hs_special_bytes(199998+i,out[0..<text.count-1]).status==PtStatus.capacity;
    }
    r:=hs_special_bytes(200013,out[0..<19]);#assert r.status==PtStatus.ok && r.written==19 && cast(string)out[0..<19]=="<|reserved_200013|>";
    #assert hs_special_bytes(200013,out[0..<18]).status==PtStatus.capacity;
    #assert hs_special_bytes(199997,out[..]).status==PtStatus.range;
    id[0]=199998;r=hs_decode_checked(table[..],id[..],out[..],work[..],false);#assert r.status==PtStatus.ok && cast(string)out[0..<r.written]=="<|startoftext|>";
}
