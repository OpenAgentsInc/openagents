#test "incremental model offsets bind complete pinned original payload extents" {
 #assert IAS_HEADER_BYTES+4*IAS_WEIGHT_COUNT==IAS_FILE_BYTES;
 #assert IAS_LAYERS[0][0]==7630080 && IAS_SUB[10]==612315392 && IAS_DEC[14]==617427840;
 for layer:0..<24 {for at:IAS_LAYERS[layer] {#assert at>=0 && at<IAS_WEIGHT_COUNT;}}
}
#test "incremental model admission refuses lengths before reading or hashing" {
 file:[16]u8;json:[16]u8;#assert !ias_model_identity(file[..],json[..]);
 nodes:[16]JvNode;bytes:[16]u8;pieces:[1024]string;#assert !ias_model_tokens(json[..],nodes[..],bytes[..],pieces[..]);
 #assert ias_sha("abc","ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
 #assert !ias_sha("abd","ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}
ias_sha :: (s:string,digest:string)->bool {b:[64]u8;return S_hex(S_hash(s),b[..]) && cast(string)b[..]==digest;}
ias_model_identity :: (file:[]u8,json:[]u8)->bool #export_c {
 if !ias_sizes(file.count,json.count) {return false;}
 return ias_identity(true,true,ias_sha(cast(string)file,IAS_MODEL_SHA),ias_sha(cast(string)json,IAS_TOKEN_SHA));
}
ias_model_tokens :: (json:[]u8,nodes:[]JvNode,bytes:[]u8,pieces:[]string)->bool #export_c {return pk_vocab(cast(string)json,1024,nodes,bytes,pieces).status==PkStatus.ok;}
