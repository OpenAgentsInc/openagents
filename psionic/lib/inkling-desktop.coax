// Inkling 2 Mini desktop model registry, hardware/install readiness, and
// composer model-picker gating for OpenAgents Desktop (ch271, #13825, #13826).

#authority;

#load "inkling-responses.coax";

// book:begin readiness
INKLING_MODEL_ID :: "inkling-2-mini";
INKLING_MODEL_LABEL :: "Inkling 2 Mini (Local)";
INKLING_MIN_RAM_MB :: 32768;
INKLING_FOOTPRINT_MB :: 16812;       // 17,627,940,768 bytes (17.63 GB IQ4_NL GGUF)
INKLING_DISK_HEADROOM_MB :: 512;
INKLING_CTX_TOKENS :: 32768;         // aligned with card.coax and LocalModelServer --ctx 32768

InklingLocalState :: enum u8 {
  not_installed;
  downloading;
  paused;
  verifying;
  installed;
  unsupported_hardware;
  insufficient_disk;
}

InklingDesktopStatus :: struct {
  state: InklingLocalState;
  selectable: bool;
  ram_mb: int;
  free_disk_mb: int;
  footprint_mb: int;
  ctx_tokens: int;
  download_pct: int;
  sha_verified: bool;
  status_code: int;
}

inkling_clamp_pct :: (pct: int) -> int #effects(all) {
  if pct < 0 { return 0; } // mutant: equivalent — pct == 0 returns 0 whether clamped or returned directly
  if pct > 100 { return 100; } // mutant: equivalent — pct == 100 returns 100 whether clamped or returned directly
  return pct;
}

// Evaluate whether Inkling 2 Mini can be selected or downloaded in OpenAgents Desktop.
// Requires >= 32 GB unified memory and a SHA-256 verified local checkpoint before selection.
inkling_desktop_readiness :: (
  ram_mb: int, free_disk_mb: int, installed_verified: bool,
  downloading: bool, paused: bool, verifying: bool, download_pct: int
) -> InklingDesktopStatus #export_c #effects(all) {
  if ram_mb < INKLING_MIN_RAM_MB {
    return InklingDesktopStatus.{
      state = InklingLocalState.unsupported_hardware, selectable = false,
      ram_mb = ram_mb, free_disk_mb = free_disk_mb, footprint_mb = INKLING_FOOTPRINT_MB,
      ctx_tokens = INKLING_CTX_TOKENS, download_pct = 0, sha_verified = false, status_code = 1
    };
  }
  if verifying {
    return InklingDesktopStatus.{
      state = InklingLocalState.verifying, selectable = false,
      ram_mb = ram_mb, free_disk_mb = free_disk_mb, footprint_mb = INKLING_FOOTPRINT_MB,
      ctx_tokens = INKLING_CTX_TOKENS, download_pct = inkling_clamp_pct(download_pct), sha_verified = false, status_code = 4
    };
  }
  if downloading {
    return InklingDesktopStatus.{
      state = InklingLocalState.downloading, selectable = false,
      ram_mb = ram_mb, free_disk_mb = free_disk_mb, footprint_mb = INKLING_FOOTPRINT_MB,
      ctx_tokens = INKLING_CTX_TOKENS, download_pct = inkling_clamp_pct(download_pct), sha_verified = false, status_code = 2
    };
  }
  if installed_verified {
    return InklingDesktopStatus.{
      state = InklingLocalState.installed, selectable = true,
      ram_mb = ram_mb, free_disk_mb = free_disk_mb, footprint_mb = INKLING_FOOTPRINT_MB,
      ctx_tokens = INKLING_CTX_TOKENS, download_pct = 100, sha_verified = true, status_code = 0
    };
  }
  if paused {
    return InklingDesktopStatus.{
      state = InklingLocalState.paused, selectable = false,
      ram_mb = ram_mb, free_disk_mb = free_disk_mb, footprint_mb = INKLING_FOOTPRINT_MB,
      ctx_tokens = INKLING_CTX_TOKENS, download_pct = inkling_clamp_pct(download_pct), sha_verified = false, status_code = 5
    };
  }
  if free_disk_mb < INKLING_FOOTPRINT_MB + INKLING_DISK_HEADROOM_MB {
    return InklingDesktopStatus.{
      state = InklingLocalState.insufficient_disk, selectable = false,
      ram_mb = ram_mb, free_disk_mb = free_disk_mb, footprint_mb = INKLING_FOOTPRINT_MB,
      ctx_tokens = INKLING_CTX_TOKENS, download_pct = 0, sha_verified = false, status_code = 6
    };
  }
  return InklingDesktopStatus.{
    state = InklingLocalState.not_installed, selectable = false,
    ram_mb = ram_mb, free_disk_mb = free_disk_mb, footprint_mb = INKLING_FOOTPRINT_MB,
    ctx_tokens = INKLING_CTX_TOKENS, download_pct = 0, sha_verified = false, status_code = 3
  };
}

inkling_desktop_status :: (ram_mb: int, installed: bool, downloading: bool, download_pct: int) -> InklingDesktopStatus #export_c #effects(all) {
  return inkling_desktop_readiness(ram_mb, INKLING_FOOTPRINT_MB + INKLING_DISK_HEADROOM_MB, installed, downloading, false, false, download_pct);
}

// Build the concise status summary shown in OpenAgents Desktop Settings > Models and composer picker.
inkling_desktop_summary :: (st: InklingDesktopStatus) -> string #effects(all) {
  if st.state == InklingLocalState.unsupported_hardware { return "Requires 32 GB RAM"; }
  if st.state == InklingLocalState.installed { return "Installed (17.63 GB · SHA-256 verified)"; }
  if st.state == InklingLocalState.verifying { return "Verifying SHA-256..."; }
  if st.state == InklingLocalState.downloading { return "Downloading..."; }
  if st.state == InklingLocalState.paused { return "Paused (resume available)"; }
  if st.state == InklingLocalState.insufficient_disk { return "Insufficient disk space (need 17.63 GB)"; }
  return "Not downloaded (17.63 GB)";
}
// book:end readiness

#test "32GB Mac with SHA-256 verified Inkling 2 Mini is selectable at 32K context" {
  st := inkling_desktop_status(32768, true, false, 100);
  #assert st.selectable && st.sha_verified;
  #assert st.state == InklingLocalState.installed && st.status_code == 0;
  #assert st.ram_mb == 32768 && st.footprint_mb == 16812 && st.ctx_tokens == 32768 && st.download_pct == 100;
  #assert st.free_disk_mb == 17324;
  #assert inkling_desktop_summary(st) == "Installed (17.63 GB · SHA-256 verified)";
}

#test "RAM guardrail (<32GB) and disk guardrail (<17324 MiB) enforce exact boundaries" {
  low := inkling_desktop_readiness(32767, 50000, true, false, false, false, 100);
  #assert !low.selectable && !low.sha_verified && low.state == InklingLocalState.unsupported_hardware && low.status_code == 1;
  #assert low.ram_mb == 32767 && low.free_disk_mb == 50000 && low.footprint_mb == 16812 && low.ctx_tokens == 32768 && low.download_pct == 0;
  #assert inkling_desktop_summary(low) == "Requires 32 GB RAM";

  disk_low := inkling_desktop_readiness(65536, 17323, false, false, false, false, 0);
  #assert !disk_low.selectable && !disk_low.sha_verified && disk_low.state == InklingLocalState.insufficient_disk && disk_low.status_code == 6;
  #assert disk_low.ram_mb == 65536 && disk_low.free_disk_mb == 17323 && disk_low.footprint_mb == 16812 && disk_low.ctx_tokens == 32768 && disk_low.download_pct == 0;
  #assert inkling_desktop_summary(disk_low) == "Insufficient disk space (need 17.63 GB)";

  disk_ok := inkling_desktop_readiness(65536, 17324, false, false, false, false, 0);
  #assert !disk_ok.selectable && !disk_ok.sha_verified && disk_ok.state == InklingLocalState.not_installed && disk_ok.status_code == 3;
  #assert disk_ok.ram_mb == 65536 && disk_ok.free_disk_mb == 17324 && disk_ok.footprint_mb == 16812 && disk_ok.ctx_tokens == 32768 && disk_ok.download_pct == 0;
  #assert inkling_desktop_summary(disk_ok) == "Not downloaded (17.63 GB)";
}

#test "downloading, paused, and verifying states clamp percent and gate picker selection" {
  d_neg := inkling_desktop_readiness(65536, 50000, false, true, false, false, -5);
  #assert !d_neg.selectable && !d_neg.sha_verified && d_neg.state == InklingLocalState.downloading && d_neg.status_code == 2 && d_neg.download_pct == 0;
  #assert d_neg.ram_mb == 65536 && d_neg.free_disk_mb == 50000 && d_neg.footprint_mb == 16812 && d_neg.ctx_tokens == 32768;
  #assert inkling_desktop_summary(d_neg) == "Downloading...";
  #assert inkling_desktop_status(65536, false, false, 0).state == InklingLocalState.not_installed;
  #assert inkling_desktop_status(65536, false, true, 101).download_pct == 100;
  #assert inkling_desktop_status(65536, false, true, 0).download_pct == 0;
  #assert inkling_desktop_status(65536, false, true, 100).download_pct == 100;

  p := inkling_desktop_readiness(65536, 1000, false, false, true, false, 42);
  #assert !p.selectable && !p.sha_verified && p.state == InklingLocalState.paused && p.status_code == 5 && p.download_pct == 42;
  #assert p.ram_mb == 65536 && p.free_disk_mb == 1000 && p.footprint_mb == 16812 && p.ctx_tokens == 32768;
  #assert inkling_desktop_summary(p) == "Paused (resume available)";

  v := inkling_desktop_readiness(65536, 50000, true, true, true, true, 77);
  #assert !v.selectable && !v.sha_verified && v.state == InklingLocalState.verifying && v.status_code == 4 && v.download_pct == 77;
  #assert v.ram_mb == 65536 && v.free_disk_mb == 50000 && v.footprint_mb == 16812 && v.ctx_tokens == 32768;
  #assert inkling_desktop_summary(v) == "Verifying SHA-256...";
}
