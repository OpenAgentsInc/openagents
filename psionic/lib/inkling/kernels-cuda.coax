// inkling-cuda-f32-v1: Inkling 2 Mini (inkling2_loop) kernels for NVIDIA GPUs,
// emitted by `coax cuda` and run by psionic/platform/inkling-cuda.c.
// Weights stay in their GGUF blocks (IQ4_NL, Q8_0, F32). Activations and
// accumulators are f32; the KV cache is f16.
//
// Every kernel is plain compute-subset Coax: group kernels (`for thread:
// 0..<T`) and one-thread-per-item kernels, with no device primitive. The same
// source compiled to C is the CPU meaning of each kernel. A group kernel is
// launched with T threads per work item (pc_launch_groups).
//
// Every kernel takes a batch of tokens: activations are [tokens, width], and
// a kernel's work items are the tokens times one token's items. Decode is a
// batch of one, so prefill and decode run the same code.

INK_T :: 64;
INK_NT :: 256;
INK_AT :: 1024;  // threads of an attention group
INK_DR :: 4;
INK_D :: 8;
INK_HEAD :: 128;
INK_REL :: 16;
INK_NEG_INF :: -300000000000000000000000000000000000000.0f32;

// ---- Scalars.
ink_half :: (bits:u32)->f32 {
    sign:=(bits>>15)&1;e:=(bits>>10)&31;m:=bits&1023;v:f32=0;
    if e==0 {v=f32(m)*0.000000059604644775390625f32;}
    else if e==31 {v=f32_from_bits(ifx m==0 then 0x7f800000 else 0x7fc00000);}
    else {v=f32_from_bits(((e+112)<<23)|(m<<13));}
    if sign!=0 {return -v;}return v;
}
ink_f16 :: (x:f32)->u32 {
    bits:=f32_bits(x);sign:=(bits>>16)&0x8000;e:=(bits>>23)&255;m:=bits&0x7fffff;
    if e==255 {return sign|0x7c00|(ifx m!=0 then cast(u32)0x200 else cast(u32)0);}
    if e>=143 {return sign|0x7c00;}
    if e>=113 {
        h:=((e-112)<<10)|(m>>13);rest:=m&0x1fff;
        if rest>0x1000 || (rest==0x1000 && (h&1)!=0) {h+=1;}
        return sign|h;
    }
    if e<102 {return sign;}
    full:=m|0x800000;shift:=126-e;h:=full>>shift;rest:=full&((cast(u32)1<<shift)-1);half:=cast(u32)1<<(shift-1);
    if rest>half || (rest==half && (h&1)!=0) {h+=1;}
    return sign|h;
}
ink_signed :: (b:u32)->f32 {return ifx b>=128 then f32(b)-256.0f32 else f32(b);}
ink_sigmoid :: (x:f32)->f32 {
    if x>=0.0f32 {return 1.0f32/(1.0f32+exp(-x));}
    e:=exp(x);return e/(1.0f32+e);
}
ink_tanh :: (x:f32)->f32 {
    if x>=0.0f32 {e:=exp(-2.0f32*x);return (1.0f32-e)/(1.0f32+e);}
    e:=exp(2.0f32*x);return (e-1.0f32)/(e+1.0f32);
}
ink_iq4_val :: (q:u32)->f32 {
    if q<8 {
        if q<4 {
            if q<2 {return ifx q==0 then -127.0f32 else -104.0f32;}
            return ifx q==2 then -83.0f32 else -65.0f32;
        }
        if q<6 {return ifx q==4 then -49.0f32 else -35.0f32;}
        return ifx q==6 then -22.0f32 else -10.0f32;
    }
    if q<12 {
        if q<10 {return ifx q==8 then 1.0f32 else 13.0f32;}
        return ifx q==10 then 25.0f32 else 38.0f32;
    }
    if q<14 {return ifx q==12 then 53.0f32 else 69.0f32;}
    return ifx q==14 then 89.0f32 else 113.0f32;
}

// ---- Embedding lookup from Q8_0 token_embd.weight + RMSNorm with tok_norm.
// One work item (256 threads). Reads row `tok` of [vocab, dim] Q8_0 (17 u16 words per 32 vals).
ink_embed_q8 :: (item:int,tok:int,dim:int,w:[]u16,norm_w:[]f32,eps:f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    d:=cast(u32)dim;blocks:=d/32;row_words:=blocks*17;base:=mul_wrap(cast(u32)(tok+item),row_words);ob:=mul_wrap(cast(u32)item,d);
    for thread:0..<INK_NT {
        s:f32=0;
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                blk:=i/32;off:=i%32;at:=add_wrap(base,mul_wrap(blk,17));
                sc:=ink_half(cast(u32)w[cast(int)at]);
                word:=cast(u32)w[cast(int)add_wrap(at,1+off/2)];
                q:=ifx (off%2)==0 then word&255 else (word>>8)&255;
                v:=sc*ink_signed(q);
                out[cast(int)add_wrap(ob,i)]=v;s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_NT {
        tot:f32=0;for j:0..<INK_NT {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {oi:=cast(int)add_wrap(ob,i);out[oi]=out[oi]*inv*norm_w[cast(int)i];}
        }
    }
}

// ---- RMSNorm: out[i] = x[i] * rsqrt(mean(x^2)+eps) * (has_w ? w[i] : 1).
// Supports `rows` independent vectors of width `dim`; one work item per row.
ink_rmsnorm :: (item:int,dim:int,has_w:int,eps:f32,x:[]f32,w:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    d:=cast(u32)dim;base:=mul_wrap(cast(u32)item,d);
    for thread:0..<INK_NT {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {v:=x[cast(int)add_wrap(base,i)];s+=v*v;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_NT {
        tot:f32=0;for j:0..<INK_NT {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                idx:=cast(int)add_wrap(base,i);
                v:=x[idx]*inv;
                if has_w!=0 {v=v*w[cast(int)i];}
                out[idx]=v;
            }
        }
    }
}


// ---- Matvec IQ4_NL (1 token): group of 64 threads writes INK_D=8 rows.
// w is [rows, cols] IQ4_NL stored as u16 (9 u16 per 32 values: 1 f16 d, 8 u16 = 16 qs bytes).
// qs byte j has low nibble for elem j (0..15) and high nibble for elem j+16 (16..31).
ink_dv_iq4 :: (item:int,rows:int,cols:int,add:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    nr:=cast(u32)rows;nc:=cast(u32)cols;blocks:=nc/32;words:=blocks*9;row0:=mul_wrap(cast(u32)item,cast(u32)INK_D);
    for thread:0..<INK_T {
        t:=cast(u32)thread;lane:=t%32;simd:=t/32;
        base_row:=add_wrap(row0,mul_wrap(simd,cast(u32)INK_DR));
        r3:=add_wrap(base_row,3);
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
        for step:cast(u32)0..<(blocks+31)/32 {
            block:=add_wrap(mul_wrap(step,32),lane);
            if block<blocks {
                xb:=mul_wrap(block,32);boff:=mul_wrap(block,9);
                if r3<nr {
                    at0:=add_wrap(mul_wrap(base_row,words),boff);
                    at1:=add_wrap(at0,words);at2:=add_wrap(at1,words);at3:=add_wrap(at2,words);
                    s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;
                    for k:0..<8 {
                        x0:=x[cast(int)add_wrap(xb,cast(u32)(2*k))];
                        x1:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k))];
                        x2:=x[cast(int)add_wrap(xb,cast(u32)(2*k+1))];
                        x3:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k+1))];
                        kk:=cast(u32)(1+k);
                        v0:=cast(u32)w[cast(int)add_wrap(at0,kk)];
                        s0+=ink_iq4_val(v0&15)*x0+ink_iq4_val((v0>>4)&15)*x1+ink_iq4_val((v0>>8)&15)*x2+ink_iq4_val(v0>>12)*x3;
                        v1:=cast(u32)w[cast(int)add_wrap(at1,kk)];
                        s1+=ink_iq4_val(v1&15)*x0+ink_iq4_val((v1>>4)&15)*x1+ink_iq4_val((v1>>8)&15)*x2+ink_iq4_val(v1>>12)*x3;
                        v2:=cast(u32)w[cast(int)add_wrap(at2,kk)];
                        s2+=ink_iq4_val(v2&15)*x0+ink_iq4_val((v2>>4)&15)*x1+ink_iq4_val((v2>>8)&15)*x2+ink_iq4_val(v2>>12)*x3;
                        v3:=cast(u32)w[cast(int)add_wrap(at3,kk)];
                        s3+=ink_iq4_val(v3&15)*x0+ink_iq4_val((v3>>4)&15)*x1+ink_iq4_val((v3>>8)&15)*x2+ink_iq4_val(v3>>12)*x3;
                    }
                    a0+=ink_half(cast(u32)w[cast(int)at0])*s0;
                    a1+=ink_half(cast(u32)w[cast(int)at1])*s1;
                    a2+=ink_half(cast(u32)w[cast(int)at2])*s2;
                    a3+=ink_half(cast(u32)w[cast(int)at3])*s3;
                } else {
                    for r:0..<INK_DR {
                        row:=add_wrap(base_row,cast(u32)r);
                        if row<nr {
                            at:=add_wrap(mul_wrap(row,words),boff);sum:f32=0;
                            for k:0..<8 {
                                x0:=x[cast(int)add_wrap(xb,cast(u32)(2*k))];
                                x1:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k))];
                                x2:=x[cast(int)add_wrap(xb,cast(u32)(2*k+1))];
                                x3:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k+1))];
                                v:=cast(u32)w[cast(int)add_wrap(at,cast(u32)(1+k))];
                                sum+=ink_iq4_val(v&15)*x0+ink_iq4_val((v>>4)&15)*x1+ink_iq4_val((v>>8)&15)*x2+ink_iq4_val(v>>12)*x3;
                            }
                            d:=ink_half(cast(u32)w[cast(int)at])*sum;
                            if r==0 {a0+=d;} else if r==1 {a1+=d;} else if r==2 {a2+=d;} else {a3+=d;}
                        }
                    }
                }
            }
        }
        part[thread*INK_DR+0]=a0;part[thread*INK_DR+1]=a1;part[thread*INK_DR+2]=a2;part[thread*INK_DR+3]=a3;
    }
    for thread:0..<INK_T {
        if thread<INK_D {
            row:=item*INK_D+thread;
            if row<rows {
                simd:=thread/INK_DR;r:=thread%INK_DR;sum:f32=0;
                for l:0..<32 {sum+=part[(simd*32+l)*INK_DR+r];}
                if add!=0 {out[row]=out[row]+sum;}else {out[row]=sum;}
            }
        }
    }
}


// ---- Matvec F32 for a matrix with few rows: one group of 256 threads per
// row (launch items = rows). A GPU thread is slow alone, so a short wide
// matrix (64 x 4608, 128 x 2304) gives every thread a few elements instead of
// giving a few threads hundreds. The row's sum adds the threads' parts in a
// fixed order: 16 sums of 16, then their sum.
ink_dvr_f32 :: (item:int,rows:int,cols:int,add:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;mid:[16]f32;
    for thread:0..<INK_NT {
        acc:f32=0;
        base:=(item%rows)*cols;xb:=(item/rows)*cols;
        for step:0..<(cols+INK_NT-1)/INK_NT {
            col:=step*INK_NT+thread;
            if col<cols {acc+=w[base+col]*x[xb+col];}
        }
        part[thread]=acc;
    }
    for thread:0..<INK_NT {
        if thread<16 {
            sum:f32=0;
            for j:0..<16 {sum+=part[thread*16+j];}
            mid[thread]=sum;
        }
    }
    for thread:0..<INK_NT {
        if thread==0 {
            sum:f32=0;
            for j:0..<16 {sum+=mid[j];}
            if add!=0 {out[item]=out[item]+sum;}else {out[item]=sum;}
        }
    }
}





// ---- Router: sigmoid(logits) + optional exp_probs_b -> top-k -> normalize * scale.
// One work item (1 threadgroup of 256 threads; n_expert <= 256).
ink_router :: (item:int,n_exp:int,n_used:int,has_bias:int,scale:f32,logits:[]f32,bias:[]f32,out_ids:[]u32,out_wts:[]f32) #export_c #effects(all) {
    probs:[256]f32;sel:[256]f32;rk:[256]f32;
    lb:=item*n_exp;ob:=item*n_used;
    for thread:0..<INK_NT {
        if thread<n_exp {
            p:=ink_sigmoid(logits[lb+thread]);
            probs[thread]=p;
            sel[thread]=ifx has_bias!=0 then p+bias[thread] else p;
        } else {
            probs[thread]=0.0f32;
            sel[thread]=INK_NEG_INF;
        }
    }
    // Every expert finds its own rank at once: how many experts score higher
    // (an equal score ranks the lower id first). Rank k < n_used is the k-th
    // choice, the order a one-at-a-time selection would produce.
    for thread:0..<INK_NT {
        rank:f32=1000.0f32;
        if thread<n_exp {
            mine:=sel[thread];rank=0.0f32;
            for e:0..<n_exp {
                o:=sel[e];
                if o>mine || (o==mine && e<thread) {rank+=1.0f32;}
            }
        }
        rk[thread]=rank;
    }
    // Thread k writes choice k. The weights' sum runs over the chosen experts
    // in id order, the same in every thread.
    for thread:0..<INK_NT {
        if thread<n_used {
            wsum:f32=0;best:int=0;used:=f32(n_used);me:=f32(thread);
            for e:0..<n_exp {
                r:=rk[e];
                if r<used {wsum+=probs[e];}
                if r==me {best=e;}
            }
            if wsum<0.00006103515625f32 {wsum=0.00006103515625f32;}
            out_ids[ob+thread]=cast(u32)best;
            out_wts[ob+thread]=probs[best]*(scale/wsum);
        }
    }
}

// ---- Depth attention residual mix: mix(blocks[0..n_blocks-1] + cur, query[q_idx]).
// blocks_buf holds n_blocks vectors of size dim, cur is 1 vector of size dim (total n_states = n_blocks + 1).
// Launch items = n_queries (1, 3, or 4). Each item has 256 threads.
ink_mix :: (item:int,dim:int,n_blocks:int,nq:int,stride:int,blocks_buf:[]f32,cur:[]f32,query:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;scores:[256]f32;invs:[256]f32;w:[256]f32;
    d:=cast(u32)dim;n_states:=n_blocks+1;st:=cast(u32)stride;
    bb:=mul_wrap(cast(u32)(item/nq),d);qi:=cast(u32)(item%nq);qbase:=mul_wrap(qi,d);obase:=add_wrap(mul_wrap(qi,st),bb);
    // Pass 1: compute RMS inv and dot(rms(state_s), query) for each state s.
    for s:0..<n_states {
        for thread:0..<INK_NT {
            ss:f32=0;t:=cast(u32)thread;
            for k:cast(u32)0..<(d+255)/256 {
                i:=add_wrap(mul_wrap(k,256),t);
                if i<d {
                    v:=ifx s<n_blocks then blocks_buf[cast(int)add_wrap(add_wrap(mul_wrap(cast(u32)s,st),bb),i)] else cur[cast(int)add_wrap(bb,i)];
                    ss+=v*v;
                }
            }
            part[thread]=ss;
        }
        for thread:0..<INK_NT {
            if thread==s {
                tot:f32=0;for j:0..<INK_NT {tot+=part[j];}
                invs[thread]=1.0f32/sqrt(tot/f32(dim)+0.000001f32);
            }
        }
        for thread:0..<INK_NT {
            dot:f32=0;t:=cast(u32)thread;inv:=invs[s];
            for k:cast(u32)0..<(d+255)/256 {
                i:=add_wrap(mul_wrap(k,256),t);
                if i<d {
                    v:=ifx s<n_blocks then blocks_buf[cast(int)add_wrap(add_wrap(mul_wrap(cast(u32)s,st),bb),i)] else cur[cast(int)add_wrap(bb,i)];
                    dot+=v*inv*query[cast(int)add_wrap(qbase,i)];
                }
            }
            part[thread]=dot;
        }
        for thread:0..<INK_NT {
            if thread==s {
                tot:f32=0;for j:0..<INK_NT {tot+=part[j];}
                scores[thread]=tot/sqrt(f32(dim));
            }
        }
    }
    // Pass 2: softmax over scores[0..n_states-1] and weighted sum of RMS-normalized states.
    for thread:0..<INK_NT {
        if thread<n_states {
            mx:f32=scores[0];
            for s:1..<n_states {if scores[s]>mx {mx=scores[s];}}
            w[thread]=exp(scores[thread]-mx);
        } else {
            w[thread]=0.0f32;
        }
    }
    for thread:0..<INK_NT {
        esum:f32=0;
        for s:0..<n_states {esum+=w[s];}
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                acc:f32=0;
                for s:0..<n_states {
                    v:=ifx s<n_blocks then blocks_buf[cast(int)add_wrap(add_wrap(mul_wrap(cast(u32)s,st),bb),i)] else cur[cast(int)add_wrap(bb,i)];
                    acc+=(w[s]/esum)*v*invs[s];
                }
                out[cast(int)add_wrap(obase,i)]=acc;
            }
        }
    }
}

// ---- Loop control prep: concat(rms(cur, 1e-6), rms(msg, 1e-6)) into out[0..2*dim-1].
// Launch 1 work item (256 threads).
ink_ctrl_prep :: (item:int,dim:int,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;part2:[256]f32;
    d:=cast(u32)dim;cb:=mul_wrap(cast(u32)item,d);ob:=mul_wrap(cb,2);
    for thread:0..<INK_NT {
        s1:f32=0;s2:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                a:=cur[cast(int)add_wrap(cb,i)];b:=msg[cast(int)add_wrap(cb,i)];
                s1+=a*a;s2+=b*b;
            }
        }
        part[thread]=s1;part2[thread]=s2;
    }
    for thread:0..<INK_NT {
        t1:f32=0;t2:f32=0;for j:0..<INK_NT {t1+=part[j];t2+=part2[j];}
        inv1:=1.0f32/sqrt(t1/f32(dim)+0.000001f32);
        inv2:=1.0f32/sqrt(t2/f32(dim)+0.000001f32);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                out[cast(int)add_wrap(ob,i)]=cur[cast(int)add_wrap(cb,i)]*inv1;
                out[cast(int)add_wrap(ob,add_wrap(d,i))]=msg[cast(int)add_wrap(cb,i)]*inv2;
            }
        }
    }
}

// ---- Loop control apply: out[i] = cur[i] - tanh(forget[i])*cur[i] + tanh(gain[i])*msg[i].
// Launch ceil(dim/256) items, 1 lane per item (or items=dim, lanes=1).
ink_ctrl_apply :: (item:int,dim:int,cur:[]f32,msg:[]f32,gain:[]f32,forget:[]f32,out:[]f32) #export_c #effects(all) {
    if item<dim {
        c:=cur[item];m:=msg[item];
        out[item]=c-ink_tanh(forget[item])*c+ink_tanh(gain[item])*m;
    }
}

// ---- Causal short convolution (l_cache=4) with residual + optional dynamic per-head taps.
// hist layout: [n_channels, 3] (3 oldest-to-newest past samples: hist[c*3+0]=t-3, +1=t-2, +2=t-1).
// weight layout: [n_channels, 4] (w[c*4+0]*x(t-3) + w[c*4+1]*x(t-2) + w[c*4+2]*x(t-1) + w[c*4+3]*x(t)).
// dynamic layout (if has_dyn!=0): [n_heads, 4] (lag 0 is x(t), lag 1 is x(t-1), lag 2 is x(t-2), lag 3 is x(t-3)).
// Launch items = n_channels, lanes = 1.
ink_convolve :: (item:int,n_channels:int,n_heads:int,has_dyn:int,nb:int,cur:[]f32,w:[]f32,dyn:[]f32,hist:[]f32,out:[]f32) #export_c #effects(all) {
    if item<n_channels {
        c:=item;
        x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];
        head_dim:=n_channels/n_heads;h:=c/head_dim;
        // The nb tokens of a batch in order: each one's output uses the three before it.
        for b:0..<nb {
            x3:=cur[b*n_channels+c];
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {
                db:=(b*n_heads+h)*4;
                acc+=dyn[db+0]*x3+dyn[db+1]*x2+dyn[db+2]*x1+dyn[db+3]*x0;
                out[b*n_channels+c]=(x3+acc)/sqrt(9.0f32);
            } else {
                out[b*n_channels+c]=(x3+acc)/sqrt(5.0f32);
            }
            x0=x1;x1=x2;x2=x3;
        }
        hist[c*3+0]=x0;hist[c*3+1]=x1;hist[c*3+2]=x2;
    }
}

// ---- Per-head clip: optional per-channel scale, L2 norm clip to threshold, optional tau multiplier.
// Launch items = n_heads (each item handles head_dim elements, 1 threadgroup of 64 threads).
ink_clip :: (item:int,head_dim:int,n_heads:int,has_scale:int,threshold:f32,tau_alpha:f32,tau_floor:f32,pos:int,x:[]f32,scale:[]f32) #export_c #effects(all) {
    part:[64]f32;
    hd:=cast(u32)head_dim;base:=mul_wrap(cast(u32)item,hd);sbase:=mul_wrap(cast(u32)(item%n_heads),hd);
    // tau = 1 + alpha * log(max(1, (position + 1) / floor)), for the token this head belongs to.
    tau:f32=1.0f32;
    if tau_alpha!=0.0f32 {
        ratio:=f32(pos+item/n_heads+1)/tau_floor;
        if ratio<1.0f32 {ratio=1.0f32;}
        tau=1.0f32+tau_alpha*log(ratio);
    }
    for thread:0..<INK_T {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {
                idx:=cast(int)add_wrap(base,i);
                v:=x[idx];
                if has_scale!=0 {v=v*scale[cast(int)add_wrap(sbase,i)];x[idx]=v;}
                s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        nrm:=sqrt(tot)+0.000001f32;
        fac:=threshold/nrm;
        if fac>1.0f32 {fac=1.0f32;}
        fac=fac*tau;
        t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {
                idx:=cast(int)add_wrap(base,i);
                x[idx]=x[idx]*fac;
            }
        }
    }
}

// ---- Per-head RMSNorm without weight (for Vcur: n_head_kv heads of head_dim).
// Launch items = n_heads (8), 1 threadgroup of 64 threads per head.
ink_head_rmsnorm :: (item:int,head_dim:int,eps:f32,x:[]f32) #export_c #effects(all) {
    part:[64]f32;
    hd:=cast(u32)head_dim;base:=mul_wrap(cast(u32)item,hd);
    for thread:0..<INK_T {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {v:=x[cast(int)add_wrap(base,i)];s+=v*v;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(head_dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {idx:=cast(int)add_wrap(base,i);x[idx]=x[idx]*inv;}
        }
    }
}

// ---- Store K and V into f16 KV cache at position `pos` (circular mod cap for SWA, or linear).
// k_cache / v_cache layout: [cap, n_head_kv, head_dim] u16.
// Launch items = n_head_kv * head_dim, lanes = 1.
ink_kv_store :: (item:int,n_kv_elem:int,pos:int,cap:int,k_in:[]f32,v_in:[]f32,k_cache:[]u16,v_cache:[]u16) #export_c #effects(all) {
    dst:=((pos+item/n_kv_elem)%cap)*n_kv_elem+item%n_kv_elem;
    k_cache[dst]=cast(u16)ink_f16(k_in[item]);
    v_cache[dst]=cast(u16)ink_f16(v_in[item]);
}

// ---- Single-token GQA attention with relative position bias, sink=0, sliding window, and output sigmoid gate.
// Launch items = tokens * n_head, one group of 1024 threads per token and Q head.
// Packed scalar args (keeps total kernel args <= 16 for metal-host.m):
//   dims0 = n_head | (n_head_kv << 16) | (head_dim << 32) | (n_rel << 48)
//   dims1 = extent | (is_swa << 24) | (swa << 32)
//   kv_info = kv_cap | (score_stride << 32)
// scratch_scores: [n_head * score_stride] f32 scratch buffer in device memory (score_stride >= max_ctx).
// pos: current 0-based token position.
// rel_bias: [extent, n_rel] f32; R: [n_head, n_rel] f32; sinks: [n_head] f32; gate: [n_head, head_dim] f32.
ink_attn :: (item:int,dims0:int,dims1:int,kv_info:int,pos0:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,scratch_scores:[]f32,out:[]f32) #export_c #effects(all) {
    smax:[1024]f32;ssum:[1024]f32;vpart:[1024]f32;gm:[32]f32;gs:[32]f32;qsh:[128]f32;rsh:[16]f32;
    n_head:=dims0&65535;n_head_kv:=(dims0>>16)&65535;head_dim:=(dims0>>32)&65535;n_rel:=(dims0>>48)&65535;
    extent:=dims1&16777215;is_swa:=(dims1>>24)&255;swa:=(dims1>>32)&16777215;
    kv_cap:=kv_info&4294967295;score_stride:=(kv_info>>32)&4294967295;
    h:=item;pos:=pos0+item/n_head;
    kv_h:=(item%n_head)/(n_head/n_head_kv);
    n_kv_elem:=n_head_kv*head_dim;
    scale:=1.0f32/sqrt(f32(head_dim));
    sink_val:=sinks[h];
    sbase:=h*score_stride;
    start:int=0;
    if is_swa!=0 && pos>=swa {start=pos-swa+1;}
    n_keys:=pos-start+1;
    n_chunks:=(n_keys+INK_AT-1)/INK_AT;
    for thread:0..<INK_AT {
        if thread<head_dim {qsh[thread]=q[h*head_dim+thread];}
        if thread<n_rel {rsh[thread]=r[h*n_rel+thread];}
    }
    // Pass 1: Q.K * scale + rel_bias - sink for every key in the window, into
    // scratch_scores; each thread keeps the largest of its keys.
    for thread:0..<INK_AT {
        lmax:f32=INK_NEG_INF;
        for c:0..<n_chunks {
            kidx:=c*INK_AT+thread;
            if kidx<n_keys {
                kp:=start+kidx;
                slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                kbase:=slot*n_kv_elem+kv_h*head_dim;
                dot:f32=0.0f32;
                for d:0..<INK_HEAD {dot+=qsh[d]*ink_half(cast(u32)k_cache[kbase+d]);}
                dist:=pos-kp;
                rb:f32=0.0f32;
                if dist<extent {
                    rb_base:=dist*n_rel;
                    for j:0..<INK_REL {rb+=rel_bias[rb_base+j]*rsh[j];}
                }
                score:=dot*scale+rb-sink_val;
                scratch_scores[sbase+kidx]=score;
                if score>lmax {lmax=score;}
            }
        }
        smax[thread]=lmax;
    }
    for thread:0..<INK_AT {
        if thread<32 {
            m:f32=INK_NEG_INF;
            for j:0..<32 {if smax[thread*32+j]>m {m=smax[thread*32+j];}}
            gm[thread]=m;
        }
    }
    // Pass 2: exponentiate against the largest score (the sink's logit is 0)
    // and add up the denominator.
    for thread:0..<INK_AT {
        gmax:f32=0.0f32;
        for j:0..<32 {if gm[j]>gmax {gmax=gm[j];}}
        lsum:f32=0.0f32;
        for c:0..<n_chunks {
            kidx:=c*INK_AT+thread;
            if kidx<n_keys {
                w:=exp(scratch_scores[sbase+kidx]-gmax);
                scratch_scores[sbase+kidx]=w;
                lsum+=w;
            }
        }
        ssum[thread]=lsum;
    }
    for thread:0..<INK_AT {
        if thread<32 {
            sum:f32=0.0f32;
            for j:0..<32 {sum+=ssum[thread*32+j];}
            gs[thread]=sum;
        }
    }
    // Pass 3: the weighted sum of V. Eight threads share each output
    // dimension: thread p*128+d adds the keys p, p+8, ... for dimension d.
    for thread:0..<INK_AT {
        d:=thread%INK_HEAD;part:=thread/INK_HEAD;
        vsum:f32=0.0f32;
        if d<head_dim {
            for c:0..<(n_keys+7)/8 {
                kidx:=c*8+part;
                if kidx<n_keys {
                    kp:=start+kidx;
                    slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                    vsum+=scratch_scores[sbase+kidx]*ink_half(cast(u32)v_cache[slot*n_kv_elem+kv_h*head_dim+d]);
                }
            }
        }
        vpart[thread]=vsum;
    }
    for thread:0..<INK_AT {
        if thread<head_dim {
            gmax:f32=0.0f32;
            for j:0..<32 {if gm[j]>gmax {gmax=gm[j];}}
            gsum:f32=exp(-gmax);
            for j:0..<32 {gsum+=gs[j];}
            vsum:f32=0.0f32;
            for p:0..<8 {vsum+=vpart[p*INK_HEAD+thread];}
            idx:=h*head_dim+thread;
            out[idx]=vsum/gsum*ink_sigmoid(gate[idx]);
        }
    }
}

// ---- Residual add: dst[i] = a[i] + b[i]. Launch items = n, lanes = 1.
ink_add :: (item:int,n:int,a:[]f32,b:[]f32,dst:[]f32) #export_c #effects(all) {
    if item<n {dst[item]=a[item]+b[item];}
}

// ---- Copy: dst[i] = src[i]. Launch items = n, lanes = 1.
ink_copy :: (item:int,n:int,src:[]f32,dst:[]f32) #export_c #effects(all) {
    if item<n {dst[item]=src[item];}
}

// ---- Final logit softcapping: x[i] = cap * tanh(x[i] / cap). Launch items = n, lanes = 1.
ink_softcap :: (item:int,n:int,cap:f32,x:[]f32) #export_c #effects(all) {
    if item<n {x[item]=cap*ink_tanh(x[item]/cap);}
}

// ---- Register-dequantizing matvecs for the microscaled float formats.
// FP4 E2M1 value (an NVFP4 element: 1 sign bit and a 3-bit magnitude).
ink_nvfp4_val :: (nib:u32)->f32 #effects(all) {
    m:=nib&7;
    v:f32=ifx m==0 then 0.0f32 else ifx m==1 then 0.5f32 else ifx m==2 then 1.0f32 else ifx m==3 then 1.5f32
        else ifx m==4 then 2.0f32 else ifx m==5 then 3.0f32 else ifx m==6 then 4.0f32 else 6.0f32;
    return ifx (nib&8)!=0 then -v else v;
}

// FP8 E4M3FN byte -> f32 (bias 7; subnormals are exact).
ink_fp8_e4m3 :: (b:u32)->f32 #effects(all) {
    e:=(b>>3)&15; m:=b&7;
    v:f32=ifx e==0 then f32(m)*(1.0f32/512.0f32) else f32_from_bits(((e+120)<<23)|(m<<20));
    return ifx (b&128)!=0 then -v else v;
}

// UE8M0 shared exponent -> f32 (2^(e - 127), an exact power of two).
ink_ue8m0 :: (e:u32)->f32 #effects(all) {
    if e==0 { return f32_from_bits(0x00400000); }
    return f32_from_bits((e&255)<<23);
}

// NVFP4 matvec: 16-element blocks of 2 u32 of packed nibbles, an E4M3 scale
// per block and one f32 scale for the tensor. One group of 32 threads per
// row (launch items = rows): thread t takes blocks t, t+32, ...; the row's
// sum adds the threads' parts in thread order, so it is the same sum on
// every device. No dequantized weight is ever stored.
ink_dv_nvfp4 :: (item:int,rows:int,cols:int,global_scale:f32,packed:[]u32,scales:[]u32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[32]f32;
    blocks:=cols/16;
    for thread:0..<32 {
        acc:f32=0;
        if item<rows {
            for step:0..<(blocks+31)/32 {
                blk:=step*32+thread;
                if blk<blocks {
                    bidx:=item*blocks+blk;
                    w0:=packed[bidx*2];
                    w1:=packed[bidx*2+1];
                    sc_word:=scales[bidx/4];
                    sc_byte:=(sc_word>>cast(u32)((bidx&3)*8))&255;
                    sc:=ink_fp8_e4m3(sc_byte)*global_scale;
                    xb:=blk*16;
                    s:f32=0;
                    for j:0..<8 {
                        s+=ink_nvfp4_val((w0>>cast(u32)(j*4))&15)*x[xb+j];
                        s+=ink_nvfp4_val((w1>>cast(u32)(j*4))&15)*x[xb+8+j];
                    }
                    acc+=sc*s;
                }
            }
        }
        part[thread]=acc;
    }
    for thread:0..<32 {
        if thread==0 && item<rows {
            tot:f32=0;
            for t:0..<32 {tot+=part[t];}
            out[item]=tot;
        }
    }
}

// MXFP8 matvec: 32-element blocks of 8 u32 of E4M3 bytes and a UE8M0 shared
// exponent per block. Launch and summation as ink_dv_nvfp4.
ink_dv_mxfp8 :: (item:int,rows:int,cols:int,weights:[]u32,scales:[]u32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[32]f32;
    blocks:=cols/32;
    for thread:0..<32 {
        acc:f32=0;
        if item<rows {
            for step:0..<(blocks+31)/32 {
                blk:=step*32+thread;
                if blk<blocks {
                    bidx:=item*blocks+blk;
                    sc_word:=scales[bidx/4];
                    sc_byte:=(sc_word>>cast(u32)((bidx&3)*8))&255;
                    sc:=ink_ue8m0(sc_byte);
                    xb:=blk*32;
                    wbase:=bidx*8;
                    s:f32=0;
                    for j:0..<8 {
                        wd:=weights[wbase+j];
                        s+=ink_fp8_e4m3(wd&255)*x[xb+j*4]
                          +ink_fp8_e4m3((wd>>8)&255)*x[xb+j*4+1]
                          +ink_fp8_e4m3((wd>>16)&255)*x[xb+j*4+2]
                          +ink_fp8_e4m3((wd>>24)&255)*x[xb+j*4+3];
                    }
                    acc+=sc*s;
                }
            }
        }
        part[thread]=acc;
    }
    for thread:0..<32 {
        if thread==0 && item<rows {
            tot:f32=0;
            for t:0..<32 {tot+=part[t];}
            out[item]=tot;
        }
    }
}

// ---- Parity diagnostic, never part of normal inference. ggml multiplies a
// quantized weight matrix by activations it has first rounded to Q8_0 (blocks
// of 32, an f16 scale, 8-bit codes); this engine keeps activations in f32.
// Rounding the input the same way (INK_ORACLE_Q8=1) removes that difference,
// so what is left when comparing logits is this engine's own arithmetic.
// Launch items = n / 32, one thread per block.
ink_q8_round :: (item:int,n:int,x:[]f32,out:[]f32) #export_c #effects(all) {
    base:=item*32;
    if base+32<=n {
        amax:f32=0;
        for j:0..<32 {
            v:=x[base+j];
            a:=ifx v<0.0f32 then -v else v;
            if a>amax {amax=a;}
        }
        d:=amax/127.0f32;
        id:f32=ifx d!=0.0f32 then 1.0f32/d else 0.0f32;
        dq:=ink_half(ink_f16(d));
        for j:0..<32 {
            t:=x[base+j]*id;
            q:f32=ifx t<0.0f32 then -floor(0.5f32-t) else floor(t+0.5f32);
            out[base+j]=q*dq;
        }
    }
}

// ---- Row-per-group kernels. A GPU thread is slow alone and fast in a crowd,
// so these give a whole group of 256 threads to one output row and each
// thread about one 32-value weight block, in place of a few threads walking
// many blocks. A row's sum adds the threads' parts in a fixed order: 16 sums
// of 16, then their sum.

// IQ4_NL code -> value, from the table packed four values to a word.
ink_iq4_fast :: (q:u32)->f32 {
    word:u32=ifx q<8 then (ifx q<4 then cast(u32)0xBFAD9881 else cast(u32)0xF6EADDCF)
                     else (ifx q<12 then cast(u32)0x26190D01 else cast(u32)0x71594535);
    return ink_signed((word>>((q&3)*8))&255);
}

// One 32-value block of a quantized row times 32 values of x. q8 != 0: Q8_0
// (17 words: an f16 scale, 32 signed bytes); else IQ4_NL (9 words: an f16
// scale, 16 bytes whose low nibbles are values 0..15 and high nibbles 16..31).
ink_block_dot :: (q8:int,w:[]u16,at:int,x:[]f32,xb:int)->f32 {
    sum:f32=0;
    if q8!=0 {
        for k:0..<16 {
            v:=cast(u32)w[at+1+k];
            sum+=ink_signed(v&255)*x[xb+2*k]+ink_signed(v>>8)*x[xb+2*k+1];
        }
    } else {
        for k:0..<8 {
            v:=cast(u32)w[at+1+k];
            sum+=ink_iq4_fast(v&15)*x[xb+2*k]+ink_iq4_fast((v>>4)&15)*x[xb+16+2*k]
                +ink_iq4_fast((v>>8)&15)*x[xb+2*k+1]+ink_iq4_fast(v>>12)*x[xb+16+2*k+1];
        }
    }
    return ink_half(cast(u32)w[at])*sum;
}

// MoE down projection and weighted sum over the n_used chosen experts.
// Launch items = tokens * ceil(rows / 4): a group writes 4 rows of one token,
// and each thread takes about one block of all 4, so a value of x is read
// once for the 4 rows. w is [slots, rows, cols] quantized; x is [tokens,
// n_used, cols]; ids are the chosen experts' slots in w, n_used per token.
ink_moe_down :: (item:int,rows:int,cols:int,n_used:int,q8:int,w:[]u16,x:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #export_c #effects(all) {
    part:[1024]f32;mid:[64]f32;
    blocks:=cols/32;bw:=ifx q8!=0 then 17 else 9;row_words:=blocks*bw;exp_words:=rows*row_words;
    total:=n_used*blocks;groups:=(rows+3)/4;tok:=item/groups;row0:=(item%groups)*4;sb:=tok*n_used;
    for thread:0..<INK_NT {
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
        for step:0..<(total+INK_NT-1)/INK_NT {
            gb:=step*INK_NT+thread;
            if gb<total {
                slot:=sb+gb/blocks;block:=gb%blocks;ew:=wts[slot];
                at:=cast(int)ids[slot]*exp_words+row0*row_words+block*bw;xb:=slot*cols+block*32;
                s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;
                if q8!=0 {
                    for k:0..<16 {
                        x0:=x[xb+2*k];x1:=x[xb+2*k+1];
                        if row0<rows {v:=cast(u32)w[at+1+k];s0+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+1<rows {v:=cast(u32)w[at+row_words+1+k];s1+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+2<rows {v:=cast(u32)w[at+2*row_words+1+k];s2+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+3<rows {v:=cast(u32)w[at+3*row_words+1+k];s3+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                    }
                } else {
                    for k:0..<8 {
                        x0:=x[xb+2*k];x1:=x[xb+16+2*k];x2:=x[xb+2*k+1];x3:=x[xb+16+2*k+1];
                        if row0<rows {v:=cast(u32)w[at+1+k];s0+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+1<rows {v:=cast(u32)w[at+row_words+1+k];s1+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+2<rows {v:=cast(u32)w[at+2*row_words+1+k];s2+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+3<rows {v:=cast(u32)w[at+3*row_words+1+k];s3+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                    }
                }
                if row0<rows {a0+=ew*ink_half(cast(u32)w[at])*s0;}
                if row0+1<rows {a1+=ew*ink_half(cast(u32)w[at+row_words])*s1;}
                if row0+2<rows {a2+=ew*ink_half(cast(u32)w[at+2*row_words])*s2;}
                if row0+3<rows {a3+=ew*ink_half(cast(u32)w[at+3*row_words])*s3;}
            }
        }
        part[thread*4]=a0;part[thread*4+1]=a1;part[thread*4+2]=a2;part[thread*4+3]=a3;
    }
    // Threads 0..63: thread r*16+g sums 16 parts of row r.
    for thread:0..<INK_NT {
        if thread<64 {
            r:=thread/16;g:=thread%16;sum:f32=0;
            for j:0..<16 {sum+=part[(g*16+j)*4+r];}
            mid[thread]=sum;
        }
    }
    for thread:0..<INK_NT {
        if thread<4 && row0+thread<rows {
            sum:f32=0;
            for j:0..<16 {sum+=mid[thread*16+j];}
            out[tok*rows+row0+thread]=sum;
        }
    }
}

// Quantized matvec (Q8_0 or IQ4_NL), 1 token. Launch items = ceil(rows / 4):
// a group of 64 threads writes 4 rows, and thread t takes blocks t, t+64, ...
// of all 4, so a value of x is read once for the 4 rows.
ink_dvq :: (item:int,rows:int,cols:int,add:int,q8:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;mid:[32]f32;
    blocks:=cols/32;bw:=ifx q8!=0 then 17 else 9;row_words:=blocks*bw;
    groups:=(rows+3)/4;tok:=item/groups;row0:=(item%groups)*4;
    for thread:0..<INK_T {
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
        for step:0..<(blocks+INK_T-1)/INK_T {
            block:=step*INK_T+thread;
            if block<blocks {
                at:=row0*row_words+block*bw;xb:=tok*cols+block*32;
                s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;
                if q8!=0 {
                    for k:0..<16 {
                        x0:=x[xb+2*k];x1:=x[xb+2*k+1];
                        if row0<rows {v:=cast(u32)w[at+1+k];s0+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+1<rows {v:=cast(u32)w[at+1*row_words+1+k];s1+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+2<rows {v:=cast(u32)w[at+2*row_words+1+k];s2+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+3<rows {v:=cast(u32)w[at+3*row_words+1+k];s3+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                    }
                } else {
                    for k:0..<8 {
                        x0:=x[xb+2*k];x1:=x[xb+16+2*k];x2:=x[xb+2*k+1];x3:=x[xb+16+2*k+1];
                        if row0<rows {v:=cast(u32)w[at+1+k];s0+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+1<rows {v:=cast(u32)w[at+1*row_words+1+k];s1+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+2<rows {v:=cast(u32)w[at+2*row_words+1+k];s2+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+3<rows {v:=cast(u32)w[at+3*row_words+1+k];s3+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                    }
                }
                if row0<rows {a0+=ink_half(cast(u32)w[at])*s0;}
                if row0+1<rows {a1+=ink_half(cast(u32)w[at+1*row_words])*s1;}
                if row0+2<rows {a2+=ink_half(cast(u32)w[at+2*row_words])*s2;}
                if row0+3<rows {a3+=ink_half(cast(u32)w[at+3*row_words])*s3;}
            }
        }
        part[thread*4]=a0;part[thread*4+1]=a1;part[thread*4+2]=a2;part[thread*4+3]=a3;
    }
    // Threads 0..31: thread r*8+g sums 8 parts of row r.
    for thread:0..<INK_T {
        if thread<32 {
            r:=thread/8;g:=thread%8;sum:f32=0;
            for j:0..<8 {sum+=part[(g*8+j)*4+r];}
            mid[thread]=sum;
        }
    }
    for thread:0..<INK_T {
        if thread<4 && row0+thread<rows {
            sum:f32=0;
            for j:0..<8 {sum+=mid[thread*8+j];}
            oi:=tok*rows+row0+thread;
            if add!=0 {out[oi]=out[oi]+sum;}else {out[oi]=sum;}
        }
    }
}

// MoE gate_up and SITU for the n_used chosen experts. w is [slots, 2*n_ff,
// cols] quantized: an expert's n_ff gate rows, then its n_ff up rows.
// Launch items = n_used * ceil(n_ff / 4): a group of 64 threads takes 4 gate
// rows and the matching 4 up rows of one expert, reads each value of x once
// for the 8, and writes situ(gate, up) into out[slot, row].
ink_moe_gu :: (item:int,n_ff:int,cols:int,n_used:int,q8:int,beta:f32,lb:f32,w:[]u16,x:[]f32,ids:[]u32,out:[]f32) #export_c #effects(all) {
    part:[512]f32;mid:[64]f32;
    groups:=(n_ff+3)/4;slot:=item/groups;row0:=(item%groups)*4;
    blocks:=cols/32;bw:=ifx q8!=0 then 17 else 9;row_words:=blocks*bw;
    exp_base:=cast(int)ids[slot]*(2*n_ff*row_words);
    for thread:0..<INK_T {
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;a4:f32=0;a5:f32=0;a6:f32=0;a7:f32=0;
        for step:0..<(blocks+INK_T-1)/INK_T {
            block:=step*INK_T+thread;
            if block<blocks {
                at:=exp_base+row0*row_words+block*bw;xb:=(slot/n_used)*cols+block*32;
                s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;s4:f32=0;s5:f32=0;s6:f32=0;s7:f32=0;
                if q8!=0 {
                    for k:0..<16 {
                        x0:=x[xb+2*k];x1:=x[xb+2*k+1];
                        if row0<n_ff {v:=cast(u32)w[at+1+k];s0+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+1<n_ff {v:=cast(u32)w[at+1*row_words+1+k];s1+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+2<n_ff {v:=cast(u32)w[at+2*row_words+1+k];s2+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+3<n_ff {v:=cast(u32)w[at+3*row_words+1+k];s3+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0<n_ff {v:=cast(u32)w[at+(n_ff+0)*row_words+1+k];s4+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+1<n_ff {v:=cast(u32)w[at+(n_ff+1)*row_words+1+k];s5+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+2<n_ff {v:=cast(u32)w[at+(n_ff+2)*row_words+1+k];s6+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                        if row0+3<n_ff {v:=cast(u32)w[at+(n_ff+3)*row_words+1+k];s7+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;}
                    }
                } else {
                    for k:0..<8 {
                        x0:=x[xb+2*k];x1:=x[xb+16+2*k];x2:=x[xb+2*k+1];x3:=x[xb+16+2*k+1];
                        if row0<n_ff {v:=cast(u32)w[at+1+k];s0+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+1<n_ff {v:=cast(u32)w[at+1*row_words+1+k];s1+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+2<n_ff {v:=cast(u32)w[at+2*row_words+1+k];s2+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+3<n_ff {v:=cast(u32)w[at+3*row_words+1+k];s3+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0<n_ff {v:=cast(u32)w[at+(n_ff+0)*row_words+1+k];s4+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+1<n_ff {v:=cast(u32)w[at+(n_ff+1)*row_words+1+k];s5+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+2<n_ff {v:=cast(u32)w[at+(n_ff+2)*row_words+1+k];s6+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                        if row0+3<n_ff {v:=cast(u32)w[at+(n_ff+3)*row_words+1+k];s7+=ink_iq4_fast(v&15)*x0+ink_iq4_fast((v>>4)&15)*x1+ink_iq4_fast((v>>8)&15)*x2+ink_iq4_fast(v>>12)*x3;}
                    }
                }
                if row0<n_ff {a0+=ink_half(cast(u32)w[at])*s0;}
                if row0+1<n_ff {a1+=ink_half(cast(u32)w[at+1*row_words])*s1;}
                if row0+2<n_ff {a2+=ink_half(cast(u32)w[at+2*row_words])*s2;}
                if row0+3<n_ff {a3+=ink_half(cast(u32)w[at+3*row_words])*s3;}
                if row0<n_ff {a4+=ink_half(cast(u32)w[at+(n_ff+0)*row_words])*s4;}
                if row0+1<n_ff {a5+=ink_half(cast(u32)w[at+(n_ff+1)*row_words])*s5;}
                if row0+2<n_ff {a6+=ink_half(cast(u32)w[at+(n_ff+2)*row_words])*s6;}
                if row0+3<n_ff {a7+=ink_half(cast(u32)w[at+(n_ff+3)*row_words])*s7;}
            }
        }
        part[thread*8+0]=a0;part[thread*8+1]=a1;part[thread*8+2]=a2;part[thread*8+3]=a3;part[thread*8+4]=a4;part[thread*8+5]=a5;part[thread*8+6]=a6;part[thread*8+7]=a7;
    }
    // Thread r*8+g sums 8 parts of row r (rows 0..3 gate, 4..7 up).
    for thread:0..<INK_T {
        r:=thread/8;g:=thread%8;sum:f32=0;
        for j:0..<8 {sum+=part[(g*8+j)*8+r];}
        mid[thread]=sum;
    }
    for thread:0..<INK_T {
        if thread<4 && row0+thread<n_ff {
            gate:f32=0;up:f32=0;
            for j:0..<8 {gate+=mid[thread*8+j];up+=mid[(4+thread)*8+j];}
            act:=beta*ink_tanh(gate/beta)*ink_sigmoid(gate);
            if lb>0.0f32 {up=lb*ink_tanh(up/lb);}
            out[slot*n_ff+row0+thread]=act*up;
        }
    }
}

// Matvec F32 for a narrow matrix (cols up to a few hundred): one thread per
// output, launch items = tokens * rows.
ink_dvs_f32 :: (item:int,rows:int,cols:int,add:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    base:=(item%rows)*cols;xb:=(item/rows)*cols;sum:f32=0;
    for c:0..<cols {sum+=w[base+c]*x[xb+c];}
    if add!=0 {out[item]=out[item]+sum;}else {out[item]=sum;}
}
