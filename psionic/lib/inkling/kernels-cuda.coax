// inkling-cuda-f32-v1: Inkling 2 Mini (inkling2_loop) kernels for NVIDIA GPUs,
// emitted by `coax cuda` and run by psionic/platform/inkling-cuda.c.
// Weights stay in their GGUF blocks (IQ4_NL, Q8_0, F32). Activations and
// accumulators are f32; the KV cache is f16.
//
// Every kernel is plain compute-subset Coax: group kernels (`for thread:
// 0..<T`) and one-thread-per-item kernels, with no device primitive. The same
// source compiled to C is the CPU meaning of each kernel. A group kernel is
// launched with T threads per work item (pc_launch_groups).
//
// Every kernel takes a batch of tokens: activations are [tokens, width], and
// a kernel's work items are the tokens times one token's items. Decode is a
// batch of one, so prefill and decode run the same code.
#load "../../../coax/lib/compute/mma.coax";

INK_T :: 64;
INK_NT :: 256;
INK_AT :: 1024;  // threads of an attention group
INK_OA :: 256;   // threads of an online-softmax GQA attention group (8 Q vectors x 32 lanes)
INK_MT :: 1024;  // threads of a direct expert group
INK_DR :: 4;
INK_D :: 8;
INK_HEAD :: 128;
INK_REL :: 16;
INK_RANK :: 64;  // the recurrence gate's rank
INK_NEG_INF :: -300000000000000000000000000000000000000.0f32;

// ---- Scalars.
ink_half :: (bits:u32)->f32 {
    sign:=(bits>>15)&1;e:=(bits>>10)&31;m:=bits&1023;v:f32=0;
    if e==0 {v=f32(m)*0.000000059604644775390625f32;}
    else if e==31 {v=f32_from_bits(ifx m==0 then 0x7f800000 else 0x7fc00000);}
    else {v=f32_from_bits(((e+112)<<23)|(m<<13));}
    if sign!=0 {return -v;}return v;
}
ink_f16 :: (x:f32)->u32 {
    bits:=f32_bits(x);sign:=(bits>>16)&0x8000;e:=(bits>>23)&255;m:=bits&0x7fffff;
    if e==255 {return sign|0x7c00|(ifx m!=0 then cast(u32)0x200 else cast(u32)0);}
    if e>=143 {return sign|0x7c00;}
    if e>=113 {
        h:=((e-112)<<10)|(m>>13);rest:=m&0x1fff;
        if rest>0x1000 || (rest==0x1000 && (h&1)!=0) {h+=1;}
        return sign|h;
    }
    if e<102 {return sign;}
    full:=m|0x800000;shift:=126-e;h:=full>>shift;rest:=full&((cast(u32)1<<shift)-1);half:=cast(u32)1<<(shift-1);
    if rest>half || (rest==half && (h&1)!=0) {h+=1;}
    return sign|h;
}
ink_signed :: (b:u32)->f32 {return ifx b>=128 then f32(b)-256.0f32 else f32(b);}
ink_sigmoid :: (x:f32)->f32 {
    if x>=0.0f32 {return 1.0f32/(1.0f32+exp(-x));}
    e:=exp(x);return e/(1.0f32+e);
}
ink_tanh :: (x:f32)->f32 {
    if x>=0.0f32 {e:=exp(-2.0f32*x);return (1.0f32-e)/(1.0f32+e);}
    e:=exp(2.0f32*x);return (e-1.0f32)/(e+1.0f32);
}
ink_iq4_val :: (q:u32)->f32 {
    if q<8 {
        if q<4 {
            if q<2 {return ifx q==0 then -127.0f32 else -104.0f32;}
            return ifx q==2 then -83.0f32 else -65.0f32;
        }
        if q<6 {return ifx q==4 then -49.0f32 else -35.0f32;}
        return ifx q==6 then -22.0f32 else -10.0f32;
    }
    if q<12 {
        if q<10 {return ifx q==8 then 1.0f32 else 13.0f32;}
        return ifx q==10 then 25.0f32 else 38.0f32;
    }
    if q<14 {return ifx q==12 then 53.0f32 else 69.0f32;}
    return ifx q==14 then 89.0f32 else 113.0f32;
}

// ---- Embedding lookup from Q8_0 token_embd.weight + RMSNorm with tok_norm.
// One work item (256 threads). Reads row `tok` of [vocab, dim] Q8_0 (17 u16 words per 32 vals).
ink_embed_q8 :: (item:int,tok:int,dim:int,w:[]u16,norm_w:[]f32,eps:f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    d:=cast(u32)dim;blocks:=d/32;row_words:=blocks*17;base:=mul_wrap(cast(u32)(tok+item),row_words);ob:=mul_wrap(cast(u32)item,d);
    for thread:0..<INK_NT {
        s:f32=0;
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                blk:=i/32;off:=i%32;at:=add_wrap(base,mul_wrap(blk,17));
                sc:=ink_half(cast(u32)w[cast(int)at]);
                word:=cast(u32)w[cast(int)add_wrap(at,1+off/2)];
                q:=ifx (off%2)==0 then word&255 else (word>>8)&255;
                v:=sc*ink_signed(q);
                out[cast(int)add_wrap(ob,i)]=v;s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_NT {
        tot:f32=0;for j:0..<INK_NT {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {oi:=cast(int)add_wrap(ob,i);out[oi]=out[oi]*inv*norm_w[cast(int)i];}
        }
    }
}

// ---- RMSNorm: out[i] = x[i] * rsqrt(mean(x^2)+eps) * (has_w ? w[i] : 1).
// Supports `rows` independent vectors of width `dim`; one work item per row.
ink_rmsnorm :: (item:int,dim:int,has_w:int,eps:f32,x:[]f32,w:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    d:=cast(u32)dim;base:=mul_wrap(cast(u32)item,d);
    for thread:0..<INK_NT {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {v:=x[cast(int)add_wrap(base,i)];s+=v*v;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_NT {
        tot:f32=0;for j:0..<INK_NT {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                idx:=cast(int)add_wrap(base,i);
                v:=x[idx]*inv;
                if has_w!=0 {v=v*w[cast(int)i];}
                out[idx]=v;
            }
        }
    }
}


// ---- Matvec IQ4_NL (1 token): group of 64 threads writes INK_D=8 rows.
// w is [rows, cols] IQ4_NL stored as u16 (9 u16 per 32 values: 1 f16 d, 8 u16 = 16 qs bytes).
// qs byte j has low nibble for elem j (0..15) and high nibble for elem j+16 (16..31).
ink_dv_iq4 :: (item:int,rows:int,cols:int,add:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    nr:=cast(u32)rows;nc:=cast(u32)cols;blocks:=nc/32;words:=blocks*9;row0:=mul_wrap(cast(u32)item,cast(u32)INK_D);
    for thread:0..<INK_T {
        t:=cast(u32)thread;lane:=t%32;simd:=t/32;
        base_row:=add_wrap(row0,mul_wrap(simd,cast(u32)INK_DR));
        r3:=add_wrap(base_row,3);
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
        for step:cast(u32)0..<(blocks+31)/32 {
            block:=add_wrap(mul_wrap(step,32),lane);
            if block<blocks {
                xb:=mul_wrap(block,32);boff:=mul_wrap(block,9);
                if r3<nr {
                    at0:=add_wrap(mul_wrap(base_row,words),boff);
                    at1:=add_wrap(at0,words);at2:=add_wrap(at1,words);at3:=add_wrap(at2,words);
                    s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;
                    for k:0..<8 {
                        x0:=x[cast(int)add_wrap(xb,cast(u32)(2*k))];
                        x1:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k))];
                        x2:=x[cast(int)add_wrap(xb,cast(u32)(2*k+1))];
                        x3:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k+1))];
                        kk:=cast(u32)(1+k);
                        v0:=cast(u32)w[cast(int)add_wrap(at0,kk)];
                        s0+=ink_iq4_val(v0&15)*x0+ink_iq4_val((v0>>4)&15)*x1+ink_iq4_val((v0>>8)&15)*x2+ink_iq4_val(v0>>12)*x3;
                        v1:=cast(u32)w[cast(int)add_wrap(at1,kk)];
                        s1+=ink_iq4_val(v1&15)*x0+ink_iq4_val((v1>>4)&15)*x1+ink_iq4_val((v1>>8)&15)*x2+ink_iq4_val(v1>>12)*x3;
                        v2:=cast(u32)w[cast(int)add_wrap(at2,kk)];
                        s2+=ink_iq4_val(v2&15)*x0+ink_iq4_val((v2>>4)&15)*x1+ink_iq4_val((v2>>8)&15)*x2+ink_iq4_val(v2>>12)*x3;
                        v3:=cast(u32)w[cast(int)add_wrap(at3,kk)];
                        s3+=ink_iq4_val(v3&15)*x0+ink_iq4_val((v3>>4)&15)*x1+ink_iq4_val((v3>>8)&15)*x2+ink_iq4_val(v3>>12)*x3;
                    }
                    a0+=ink_half(cast(u32)w[cast(int)at0])*s0;
                    a1+=ink_half(cast(u32)w[cast(int)at1])*s1;
                    a2+=ink_half(cast(u32)w[cast(int)at2])*s2;
                    a3+=ink_half(cast(u32)w[cast(int)at3])*s3;
                } else {
                    for r:0..<INK_DR {
                        row:=add_wrap(base_row,cast(u32)r);
                        if row<nr {
                            at:=add_wrap(mul_wrap(row,words),boff);sum:f32=0;
                            for k:0..<8 {
                                x0:=x[cast(int)add_wrap(xb,cast(u32)(2*k))];
                                x1:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k))];
                                x2:=x[cast(int)add_wrap(xb,cast(u32)(2*k+1))];
                                x3:=x[cast(int)add_wrap(xb,cast(u32)(16+2*k+1))];
                                v:=cast(u32)w[cast(int)add_wrap(at,cast(u32)(1+k))];
                                sum+=ink_iq4_val(v&15)*x0+ink_iq4_val((v>>4)&15)*x1+ink_iq4_val((v>>8)&15)*x2+ink_iq4_val(v>>12)*x3;
                            }
                            d:=ink_half(cast(u32)w[cast(int)at])*sum;
                            if r==0 {a0+=d;} else if r==1 {a1+=d;} else if r==2 {a2+=d;} else {a3+=d;}
                        }
                    }
                }
            }
        }
        part[thread*INK_DR+0]=a0;part[thread*INK_DR+1]=a1;part[thread*INK_DR+2]=a2;part[thread*INK_DR+3]=a3;
    }
    for thread:0..<INK_T {
        if thread<INK_D {
            row:=item*INK_D+thread;
            if row<rows {
                simd:=thread/INK_DR;r:=thread%INK_DR;sum:f32=0;
                for l:0..<32 {sum+=part[(simd*32+l)*INK_DR+r];}
                if add!=0 {out[row]=out[row]+sum;}else {out[row]=sum;}
            }
        }
    }
}


// ---- Matvec F32 for a matrix with few rows: one group of 256 threads per
// row (launch items = rows). A GPU thread is slow alone, so a short wide
// matrix (64 x 4608, 128 x 2304) gives every thread a few elements instead of
// giving a few threads hundreds. The row's sum adds the threads' parts in a
// fixed order: 16 sums of 16, then their sum.
ink_dvr_f32 :: (item:int,rows:int,cols:int,add:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;mid:[16]f32;
    for thread:0..<INK_NT {
        acc:f32=0;nc:=cast(u32)cols;t:=cast(u32)thread;
        base:=cast(u32)((item%rows)*cols);xb:=cast(u32)((item/rows)*cols);
        // Three columns at a time, their loads asked for together.
        for step:cast(u32)0..<(nc+767)/768 {
            c0:=add_wrap(mul_wrap(step,768),t);c1:=add_wrap(c0,256);c2:=add_wrap(c0,512);
            w0:f32=0;w1:f32=0;w2:f32=0;x0:f32=0;x1:f32=0;x2:f32=0;
            if c0<nc {w0=w[cast(int)add_wrap(base,c0)];x0=x[cast(int)add_wrap(xb,c0)];}
            if c1<nc {w1=w[cast(int)add_wrap(base,c1)];x1=x[cast(int)add_wrap(xb,c1)];}
            if c2<nc {w2=w[cast(int)add_wrap(base,c2)];x2=x[cast(int)add_wrap(xb,c2)];}
            acc+=w0*x0;acc+=w1*x1;acc+=w2*x2;
        }
        part[thread]=acc;
    }
    for thread:0..<INK_NT {
        if thread<16 {
            sum:f32=0;
            for j:0..<16 {sum+=part[thread*16+j];}
            mid[thread]=sum;
        }
    }
    for thread:0..<INK_NT {
        if thread==0 {
            sum:f32=0;
            for j:0..<16 {sum+=mid[j];}
            if add!=0 {out[item]=out[item]+sum;}else {out[item]=sum;}
        }
    }
}





// ---- Router: sigmoid(logits) + optional exp_probs_b -> top-k -> normalize * scale.
// One work item is one token: a group of 1024 threads, n_expert <= 128 and
// n_used <= 16. Eight threads share an expert and each compares it with 16
// of the others, so no thread has a long run of work.
ink_router :: (item:int,n_exp:int,n_used:int,has_bias:int,scale:f32,logits:[]f32,bias:[]f32,out_ids:[]u32,out_wts:[]f32) #export_c #effects(all) {
    probs:[128]f32;sel:[128]f32;cnt:[1024]f32;rk:[128]f32;chosen:[128]f32;mid:[16]f32;
    lb:=item*n_exp;ob:=item*n_used;
    for thread:0..<INK_MT {
        if thread<128 {
            if thread<n_exp {
                p:=ink_sigmoid(logits[lb+thread]);
                probs[thread]=p;
                sel[thread]=ifx has_bias!=0 then p+bias[thread] else p;
            } else {
                probs[thread]=0.0f32;
                sel[thread]=INK_NEG_INF;
            }
        }
    }
    // Every expert finds its own rank at once: how many experts score higher
    // (an equal score ranks the lower id first). Rank k < n_used is the k-th
    // choice, the order a one-at-a-time selection would produce.
    for thread:0..<INK_MT {
        me:=thread/8;part:=thread%8;mine:=sel[me];n:f32=0.0f32;
        for j:0..<16 {
            e:=part*16+j;o:=sel[e];
            if o>mine || (o==mine && e<me) {n+=1.0f32;}
        }
        cnt[thread]=n;
    }
    for thread:0..<INK_MT {
        if thread<128 {
            r:=((cnt[thread*8]+cnt[thread*8+1])+(cnt[thread*8+2]+cnt[thread*8+3]))+((cnt[thread*8+4]+cnt[thread*8+5])+(cnt[thread*8+6]+cnt[thread*8+7]));
            if thread>=n_exp {r=1000.0f32;}
            rk[thread]=r;
            chosen[thread]=ifx r<f32(n_used) then probs[thread] else 0.0f32;
        }
    }
    // The weights' sum runs over the chosen experts in id order, as 16 sums
    // of 8 and then their sum.
    for thread:0..<INK_MT {
        if thread<16 {
            sum:f32=0;
            for j:0..<8 {sum+=chosen[thread*8+j];}
            mid[thread]=sum;
        }
    }
    for thread:0..<INK_MT {
        if thread<n_exp && thread<128 {
            r:=rk[thread];
            if r<f32(n_used) {
                wsum:f32=0;
                for j:0..<16 {wsum+=mid[j];}
                if wsum<0.00006103515625f32 {wsum=0.00006103515625f32;}
                out_ids[ob+cast(int)r]=cast(u32)thread;
                out_wts[ob+cast(int)r]=probs[thread]*(scale/wsum);
            }
        }
    }
}

// ---- Depth attention residual mix: out = sum over states of softmax(score)_s
// * rms(state_s), score_s = rms(state_s) . query / sqrt(dim). The states are
// the n_blocks vectors of blocks_buf (stride floats apart) and then cur.
// Launch items = tokens * nq, a group of 256 threads each; dim <= 2304 and
// n_blocks <= 8. A thread takes every 256th element. It asks for a state's
// elements together, and adds its share of the state's sum of squares and of
// its dot with the query in one pass: rms(state) . query = (state . query) *
// inv. The shares add up as 16 sums of 16, then their sum.
ink_mix :: (item:int,dim:int,n_blocks:int,nq:int,stride:int,blocks_buf:[]f32,cur:[]f32,query:[]f32,out:[]f32) #export_c #effects(all) {
    pss:[2304]f32;pdq:[2304]f32;mss:[144]f32;mdq:[144]f32;invs:[16]f32;scores:[16]f32;coef:[16]f32;
    d:=cast(u32)dim;n_states:=n_blocks+1;st:=cast(u32)stride;
    bb:=mul_wrap(cast(u32)(item/nq),d);qi:=cast(u32)(item%nq);qbase:=mul_wrap(qi,d);obase:=add_wrap(mul_wrap(qi,st),bb);
    for thread:0..<INK_NT {
        t:=cast(u32)thread;qs:[16]f32;vs:[16]f32;
        for k:0..<9 {
            i:=add_wrap(mul_wrap(cast(u32)k,256),t);
            qs[k]=0.0f32;
            if i<d {qs[k]=query[cast(int)add_wrap(qbase,i)];}
        }
        for s:0..<9 {
            sb:=ifx s<n_blocks then add_wrap(mul_wrap(cast(u32)s,st),bb) else bb;
            for k:0..<9 {
                i:=add_wrap(mul_wrap(cast(u32)k,256),t);
                vs[k]=0.0f32;
                if i<d&&s<n_states {
                    if s<n_blocks {vs[k]=blocks_buf[cast(int)add_wrap(sb,i)];} else {vs[k]=cur[cast(int)add_wrap(sb,i)];}
                }
            }
            ss:f32=0;dq:f32=0;
            for k:0..<9 {ss+=vs[k]*vs[k];dq+=vs[k]*qs[k];}
            pss[thread*9+s]=ss;pdq[thread*9+s]=dq;
        }
    }
    for thread:0..<INK_NT {
        if thread<n_states*16 {
            ss:f32=0;dq:f32=0;
            sx:=thread/16;c:=thread%16;
            for j:0..<16 {ss+=pss[(c*16+j)*9+sx];dq+=pdq[(c*16+j)*9+sx];}
            mss[thread]=ss;mdq[thread]=dq;
        }
    }
    for thread:0..<INK_NT {
        if thread<n_states {
            ss:f32=0;dq:f32=0;
            for j:0..<16 {ss+=mss[thread*16+j];dq+=mdq[thread*16+j];}
            inv:=1.0f32/sqrt(ss/f32(dim)+0.000001f32);
            invs[thread]=inv;scores[thread]=dq*inv/sqrt(f32(dim));
        }
    }
    for thread:0..<INK_NT {
        if thread<n_states {
            mx:f32=scores[0];esum:f32=0;
            for s:1..<n_states {if scores[s]>mx {mx=scores[s];}}
            for s:0..<n_states {esum+=exp(scores[s]-mx);}
            coef[thread]=exp(scores[thread]-mx)/esum*invs[thread];
        }
    }
    for thread:0..<INK_NT {
        t:=cast(u32)thread;acc:[16]f32;vs:[16]f32;
        for k:0..<9 {acc[k]=0.0f32;}
        for s:0..<n_states {
            sb:=ifx s<n_blocks then add_wrap(mul_wrap(cast(u32)s,st),bb) else bb;
            for k:0..<9 {
                i:=add_wrap(mul_wrap(cast(u32)k,256),t);
                vs[k]=0.0f32;
                if i<d {
                    if s<n_blocks {vs[k]=blocks_buf[cast(int)add_wrap(sb,i)];} else {vs[k]=cur[cast(int)add_wrap(sb,i)];}
                }
            }
            c:=coef[s];
            for k:0..<9 {acc[k]+=c*vs[k];}
        }
        for k:0..<9 {
            i:=add_wrap(mul_wrap(cast(u32)k,256),t);
            if i<d {out[cast(int)add_wrap(obase,i)]=acc[k];}
        }
    }
}

// ---- RMSNorm of the vectors a layer feeds its projections: out[v, tok] =
// x[v or 0, tok] * rsqrt(mean(x^2) + eps) * w_v. Vectors lie [vector][batch]
// [dim], `stack` floats from one vector to the next. xsingle != 0: every
// output is the norm of vector 0 (with its own weight). w0, w1 and w2 are the
// three weights' places in `arena`, the resident weights as f32. Launch items
// = vectors * np, a group of 256 threads each. The sum of squares adds the
// threads' parts as 16 sums of 16, then their sum.
ink_rmsn :: (item:int,dim:int,np:int,stack:int,xsingle:int,eps:f32,w0:int,w1:int,w2:int,arena:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;mid:[16]f32;
    v:=item/np;tok:=item%np;
    xb:=(ifx xsingle!=0 then 0 else v)*stack+tok*dim;ob:=v*stack+tok*dim;
    wb:=ifx v==0 then w0 else ifx v==1 then w1 else w2;
    for thread:0..<INK_NT {
        s:f32=0;
        for k:0..<(dim+INK_NT-1)/INK_NT {
            i:=k*INK_NT+thread;
            if i<dim {xv:=x[xb+i];s+=xv*xv;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_NT {
        if thread<16 {
            s:f32=0;
            for j:0..<16 {s+=part[thread*16+j];}
            mid[thread]=s;
        }
    }
    for thread:0..<INK_NT {
        tot:f32=0;
        for j:0..<16 {tot+=mid[j];}
        inv:=1.0f32/sqrt(tot/f32(dim)+eps);
        for k:0..<(dim+INK_NT-1)/INK_NT {
            i:=k*INK_NT+thread;
            if i<dim {out[ob+i]=x[xb+i]*inv*arena[wb+i];}
        }
    }
}

// ---- The cross-pass recurrence gate, for up to three inputs of a layer at
// once: out = cur - tanh(forget) cur + tanh(gain) msg, where gate = D [rms(cur),
// rms(msg)] (rank INK_RANK), gain = G gate and forget = F gate.
// flags = swa | (c0 << 8): input c of this call uses message c0 + c, and with
// swa != 0 every input is vector 0 of cur. Vectors lie [vector][batch][dim],
// `stack` floats apart.

// ink_ctrl_gate: launch items = inputs * np * INK_RANK, a group of 1024
// threads for one gate value. off0..off2 are the inputs' D matrices in
// `arena` ([INK_RANK, 2*dim] f32). The group adds up D.cur, D.msg and the two
// sums of squares together (32 sums of 32, then their sum), so the norms need
// no pass of their own: gate = D_cur.cur * inv_cur + D_msg.msg * inv_msg.
ink_ctrl_gate :: (item:int,dim:int,np:int,stack:int,flags:int,off0:int,off1:int,off2:int,arena:[]f32,cur:[]f32,msg:[]f32,gate:[]f32) #export_c #effects(all) {
    pa:[1024]f32;pb:[1024]f32;pc:[1024]f32;pm:[1024]f32;m1:[512]f32;m2:[64]f32;m3:[4]f32;
    swa:=flags&255;c0:=(flags>>8)&255;
    cl:=item/(np*INK_RANK);tok:=(item/INK_RANK)%np;r:=item%INK_RANK;
    cb:=(ifx swa!=0 then 0 else cl)*stack+tok*dim;gb:=(c0+cl)*stack+tok*dim;
    wb:=(ifx cl==0 then off0 else ifx cl==1 then off1 else off2)+r*2*dim;
    for thread:0..<INK_MT {
        sa:f32=0;sb:f32=0;sc:f32=0;sm:f32=0;nd:=cast(u32)dim;t:=cast(u32)thread;
        cb32:=cast(u32)cb;gb32:=cast(u32)gb;wb32:=cast(u32)wb;
        for k:cast(u32)0..<(nd+1023)/1024 {
            i:=add_wrap(mul_wrap(k,1024),t);
            if i<nd {
                a:=cur[cast(int)add_wrap(cb32,i)];m:=msg[cast(int)add_wrap(gb32,i)];
                wa:=arena[cast(int)add_wrap(wb32,i)];wm:=arena[cast(int)add_wrap(add_wrap(wb32,nd),i)];
                sa+=wa*a;sb+=wm*m;sc+=a*a;sm+=m*m;
            }
        }
        pa[thread]=sa;pb[thread]=sb;pc[thread]=sc;pm[thread]=sm;
    }
    // The four sums, each as 128 sums of 8, 16 sums of 8, then their sum:
    // every step is a few loads for a thread.
    for thread:0..<INK_MT {
        if thread<512 {
            c:=thread%128;which:=thread/128;s:f32=0;
            if which==0 {for j:0..<8 {s+=pa[c*8+j];}}
            if which==1 {for j:0..<8 {s+=pb[c*8+j];}}
            if which==2 {for j:0..<8 {s+=pc[c*8+j];}}
            if which==3 {for j:0..<8 {s+=pm[c*8+j];}}
            m1[thread]=s;
        }
    }
    for thread:0..<INK_MT {
        if thread<64 {
            s:f32=0;
            for j:0..<8 {s+=m1[thread*8+j];}
            m2[thread]=s;
        }
    }
    for thread:0..<INK_MT {
        if thread<4 {
            s:f32=0;
            for j:0..<16 {s+=m2[thread*16+j];}
            m3[thread]=s;
        }
    }
    for thread:0..<INK_MT {
        if thread==0 {
            sa:=m3[0];sb:=m3[1];sc:=m3[2];sm:=m3[3];
            inv_c:=1.0f32/sqrt(sc/f32(dim)+0.000001f32);
            inv_m:=1.0f32/sqrt(sm/f32(dim)+0.000001f32);
            gate[item]=sa*inv_c+sb*inv_m;
        }
    }
}

// ink_ctrl_out: launch items = inputs * np * ceil(dim / 32), a group of 256
// threads for 32 outputs. gf0..gf2 hold each input's G and F places in
// `arena` ([dim, INK_RANK] f32): G in the low 32 bits, F in the high. Eight
// threads share an output: four take 16 gate values each for the gain and
// four for the forget, and the output's first thread adds them up.
ink_ctrl_out :: (item:int,dim:int,np:int,stack:int,flags:int,gf0:int,gf1:int,gf2:int,arena:[]f32,cur:[]f32,msg:[]f32,gate:[]f32,out:[]f32) #export_c #effects(all) {
    gsh:[64]f32;pp:[256]f32;
    swa:=flags&255;c0:=(flags>>8)&255;
    per:=(dim+31)/32;g:=item%per;ct:=item/per;cl:=ct/np;tok:=ct%np;
    gf:=ifx cl==0 then gf0 else ifx cl==1 then gf1 else gf2;
    gbase:=cast(u32)(gf&4294967295);fbase:=cast(u32)((gf>>32)&4294967295);
    cb:=(ifx swa!=0 then 0 else cl)*stack+tok*dim;mb:=(c0+cl)*stack+tok*dim;ob:=cl*stack+tok*dim;
    for thread:0..<INK_NT {
        if thread<INK_RANK {gsh[thread]=gate[ct*INK_RANK+thread];}
    }
    for thread:0..<INK_NT {
        e:=g*32+thread/8;part:=thread%8;q:=part%4;sum:f32=0;
        if e<dim {
            base:=add_wrap(add_wrap(ifx part<4 then gbase else fbase,mul_wrap(cast(u32)e,64)),cast(u32)(q*16));
            ws:[16]f32;
            for j:0..<16 {ws[j]=arena[cast(int)add_wrap(base,cast(u32)j)];}
            for j:0..<16 {sum+=ws[j]*gsh[q*16+j];}
        }
        pp[thread]=sum;
    }
    for thread:0..<INK_NT {
        if thread<32 {
            e:=g*32+thread;
            if e<dim {
                gain:=(pp[thread*8]+pp[thread*8+1])+(pp[thread*8+2]+pp[thread*8+3]);
                forget:=(pp[thread*8+4]+pp[thread*8+5])+(pp[thread*8+6]+pp[thread*8+7]);
                c:=cur[cb+e];m:=msg[mb+e];
                out[ob+e]=c-ink_tanh(forget)*c+ink_tanh(gain)*m;
            }
        }
    }
}

// ---- The end of a layer's attention for one channel of every token: the
// post short convolution of the output projection with its history, then
// either the residual add into cur, or, at a block's first layer, cur saved
// as the block's entry and replaced. Launch items = n_channels.
ink_attn_post :: (item:int,n_channels:int,nb:int,block_start:int,o:[]f32,w:[]f32,hist:[]f32,cur:[]f32,blk:[]f32) #export_c #effects(all) {
    if item<n_channels {
        c:=item;
        x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];
        for b:0..<nb {
            idx:=b*n_channels+c;x3:=o[idx];
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            y:=(x3+acc)/sqrt(5.0f32);
            if block_start!=0 {blk[idx]=cur[idx];cur[idx]=y;} else {cur[idx]=cur[idx]+y;}
            x0=x1;x1=x2;x2=x3;
        }
        hist[c*3+0]=x0;hist[c*3+1]=x1;hist[c*3+2]=x2;
    }
}

// ---- Causal short convolution (l_cache=4) with residual + optional dynamic per-head taps.
// hist layout: [n_channels, 3] (3 oldest-to-newest past samples: hist[c*3+0]=t-3, +1=t-2, +2=t-1).
// weight layout: [n_channels, 4] (w[c*4+0]*x(t-3) + w[c*4+1]*x(t-2) + w[c*4+2]*x(t-1) + w[c*4+3]*x(t)).
// dynamic layout (if has_dyn!=0): [n_heads, 4] (lag 0 is x(t), lag 1 is x(t-1), lag 2 is x(t-2), lag 3 is x(t-3)).
// Launch items = n_channels, lanes = 1.
ink_convolve :: (item:int,n_channels:int,n_heads:int,has_dyn:int,nb:int,cur:[]f32,w:[]f32,dyn:[]f32,hist:[]f32,out:[]f32) #export_c #effects(all) {
    if item<n_channels {
        c:=item;
        x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];
        head_dim:=n_channels/n_heads;h:=c/head_dim;
        // The nb tokens of a batch in order: each one's output uses the three before it.
        for b:0..<nb {
            x3:=cur[b*n_channels+c];
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {
                db:=(b*n_heads+h)*4;
                acc+=dyn[db+0]*x3+dyn[db+1]*x2+dyn[db+2]*x1+dyn[db+3]*x0;
                out[b*n_channels+c]=(x3+acc)/sqrt(9.0f32);
            } else {
                out[b*n_channels+c]=(x3+acc)/sqrt(5.0f32);
            }
            x0=x1;x1=x2;x2=x3;
        }
        hist[c*3+0]=x0;hist[c*3+1]=x1;hist[c*3+2]=x2;
    }
}

// ---- Per-head clip: optional per-channel scale, L2 norm clip to threshold, optional tau multiplier.
// Launch items = n_heads (each item handles head_dim elements, 1 threadgroup of 64 threads).
ink_clip :: (item:int,head_dim:int,n_heads:int,has_scale:int,threshold:f32,tau_alpha:f32,tau_floor:f32,pos:int,x:[]f32,scale:[]f32,pos_buf:[]u32) #export_c #effects(all) {
    part:[64]f32;
    hd:=cast(u32)head_dim;base:=mul_wrap(cast(u32)item,hd);sbase:=mul_wrap(cast(u32)(item%n_heads),hd);
    epos:=ifx pos<0 then cast(int)pos_buf[0] else pos;
    // tau = 1 + alpha * log(max(1, (position + 1) / floor)), for the token this head belongs to.
    tau:f32=1.0f32;
    if tau_alpha!=0.0f32 {
        ratio:=f32(epos+item/n_heads+1)/tau_floor;
        if ratio<1.0f32 {ratio=1.0f32;}
        tau=1.0f32+tau_alpha*log(ratio);
    }
    for thread:0..<INK_T {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {
                idx:=cast(int)add_wrap(base,i);
                v:=x[idx];
                if has_scale!=0 {v=v*scale[cast(int)add_wrap(sbase,i)];x[idx]=v;}
                s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        nrm:=sqrt(tot)+0.000001f32;
        fac:=threshold/nrm;
        if fac>1.0f32 {fac=1.0f32;}
        fac=fac*tau;
        t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {
                idx:=cast(int)add_wrap(base,i);
                x[idx]=x[idx]*fac;
            }
        }
    }
}

// ---- Per-head RMSNorm without weight (for Vcur: n_head_kv heads of head_dim).
// Launch items = n_heads (8), 1 threadgroup of 64 threads per head.
ink_head_rmsnorm :: (item:int,head_dim:int,eps:f32,x:[]f32) #export_c #effects(all) {
    part:[64]f32;
    hd:=cast(u32)head_dim;base:=mul_wrap(cast(u32)item,hd);
    for thread:0..<INK_T {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {v:=x[cast(int)add_wrap(base,i)];s+=v*v;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(head_dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {idx:=cast(int)add_wrap(base,i);x[idx]=x[idx]*inv;}
        }
    }
}

// ---- One token's K and V for one KV head, from the projections to the KV
// cache: the causal short convolutions (ink_convolve), K's norm clip
// (ink_clip without a scale), V's RMSNorm (ink_head_rmsnorm) and the store
// (ink_kv_store). Launch items = n_head_kv, a group of 256 threads: thread d
// takes K's dimension d and thread 128 + d takes V's. Heads are 128 wide.
ink_kv1 :: (item:int,n_kv_elem:int,has_dyn:int,pos:int,cap:int,thr:f32,eps:f32,kraw:[]f32,vraw:[]f32,kw:[]f32,vw:[]f32,kdyn:[]f32,vdyn:[]f32,khist:[]f32,vhist:[]f32,k_cache:[]u16,v_cache:[]u16,pos_buf:[]u32) #export_c #effects(all) {
    ys:[256]f32;part:[256]f32;mid:[16]f32;
    epos:=ifx pos<0 then cast(int)pos_buf[0] else pos;
    for thread:0..<INK_NT {
        d:=thread%128;c:=item*128+d;
        x0:f32=0;x1:f32=0;x2:f32=0;x3:f32=0;w0:f32=0;w1:f32=0;w2:f32=0;w3:f32=0;d0:f32=0;d1:f32=0;d2:f32=0;d3:f32=0;
        if thread<128 {
            x0=khist[c*3+0];x1=khist[c*3+1];x2=khist[c*3+2];x3=kraw[c];
            w0=kw[c*4+0];w1=kw[c*4+1];w2=kw[c*4+2];w3=kw[c*4+3];
            if has_dyn!=0 {d0=kdyn[item*4+0];d1=kdyn[item*4+1];d2=kdyn[item*4+2];d3=kdyn[item*4+3];}
            khist[c*3+0]=x1;khist[c*3+1]=x2;khist[c*3+2]=x3;
        } else {
            x0=vhist[c*3+0];x1=vhist[c*3+1];x2=vhist[c*3+2];x3=vraw[c];
            w0=vw[c*4+0];w1=vw[c*4+1];w2=vw[c*4+2];w3=vw[c*4+3];
            if has_dyn!=0 {d0=vdyn[item*4+0];d1=vdyn[item*4+1];d2=vdyn[item*4+2];d3=vdyn[item*4+3];}
            vhist[c*3+0]=x1;vhist[c*3+1]=x2;vhist[c*3+2]=x3;
        }
        acc:=x0*w0+x1*w1+x2*w2+x3*w3;
        y:f32=0;
        if has_dyn!=0 {acc+=d0*x3+d1*x2+d2*x1+d3*x0;y=(x3+acc)/sqrt(9.0f32);} else {y=(x3+acc)/sqrt(5.0f32);}
        ys[thread]=y;part[thread]=y*y;
    }
    for thread:0..<INK_NT {
        if thread<16 {
            sum:f32=0;
            for j:0..<16 {sum+=part[thread*16+j];}
            mid[thread]=sum;
        }
    }
    for thread:0..<INK_NT {
        d:=thread%128;dst:=(epos%cap)*n_kv_elem+item*128+d;
        if thread<128 {
            tot:=((mid[0]+mid[1])+(mid[2]+mid[3]))+((mid[4]+mid[5])+(mid[6]+mid[7]));
            fac:=thr/(sqrt(tot)+0.000001f32);
            if fac>1.0f32 {fac=1.0f32;}
            k_cache[dst]=cast(u16)ink_f16(ys[thread]*fac);
        } else {
            tot:=((mid[8]+mid[9])+(mid[10]+mid[11]))+((mid[12]+mid[13])+(mid[14]+mid[15]));
            inv:=1.0f32/sqrt(tot/128.0f32+eps);
            v_cache[dst]=cast(u16)ink_f16(ys[thread]*inv);
        }
    }
}

// ---- Store K and V into f16 KV cache at position `pos` (circular mod cap for SWA, or linear).
// k_cache / v_cache layout: [cap, n_head_kv, head_dim] u16.
// Launch items = n_head_kv * head_dim, lanes = 1.
ink_kv_store :: (item:int,n_kv_elem:int,pos:int,cap:int,k_in:[]f32,v_in:[]f32,k_cache:[]u16,v_cache:[]u16,pos_buf:[]u32) #export_c #effects(all) {
    epos:=ifx pos<0 then cast(int)pos_buf[0] else pos;
    dst:=((epos+item/n_kv_elem)%cap)*n_kv_elem+item%n_kv_elem;
    k_cache[dst]=cast(u16)ink_f16(k_in[item]);
    v_cache[dst]=cast(u16)ink_f16(v_in[item]);
}

// ---- Single-token GQA attention with relative position bias, sink=0, sliding window, and output sigmoid gate.
// Launch items = tokens * n_head, one group of 1024 threads per token and Q head.
// Packed scalar args (keeps total kernel args <= 16 for metal-host.m):
//   dims0 = n_head | (n_head_kv << 16) | (head_dim << 32) | (n_rel << 48)
//   dims1 = extent | (is_swa << 24) | (swa << 32)
//   kv_info = kv_cap | (score_stride << 32)
// scratch_scores: [n_head * score_stride] f32 scratch buffer in device memory (score_stride >= max_ctx).
// pos: current 0-based token position.
// rel_bias: [extent, n_rel] f32; R: [n_head, n_rel] f32; sinks: [n_head] f32; gate: [n_head, head_dim] f32.
// Q and R are clipped here first, as ink_clip would: flags bit 0 and bit 1
// say whether Q and R have a scale (qclip [n_head, head_dim], rclip [n_head,
// n_rel]); thr_q and thr_r are the norm thresholds; tau_alpha and tau_floor
// give tau for the token's position.
ink_attn :: (item:int,dims0:int,dims1:int,kv_info:int,pos0:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,scratch_scores:[]f32,out:[]f32,flags:int,thr_q:f32,thr_r:f32,tau_alpha:f32,tau_floor:f32,qclip:[]f32,rclip:[]f32,pos_buf:[]u32) #export_c #effects(all) {
    smax:[1024]f32;ssum:[1024]f32;vpart:[1024]f32;dp:[1024]f32;gm:[32]f32;gs:[32]f32;qsh:[128]f32;rsh:[16]f32;
    n_head:=dims0&65535;n_head_kv:=(dims0>>16)&65535;head_dim:=(dims0>>32)&65535;n_rel:=(dims0>>48)&65535;
    extent:=dims1&16777215;is_swa:=(dims1>>24)&255;swa:=(dims1>>32)&16777215;
    kv_cap:=kv_info&4294967295;score_stride:=(kv_info>>32)&4294967295;
    epos0:=ifx pos0<0 then cast(int)pos_buf[0] else pos0;
    h:=item;pos:=epos0+item/n_head;
    kv_h:=(item%n_head)/(n_head/n_head_kv);
    n_kv_elem:=n_head_kv*head_dim;
    scale:=1.0f32/sqrt(f32(head_dim));
    sink_val:=sinks[h];
    sbase:=h*score_stride;
    start:int=0;
    if is_swa!=0 && pos>=swa {start=pos-swa+1;}
    n_keys:=pos-start+1;
    n_chunks:=(n_keys+INK_AT-1)/INK_AT;
    tau:f32=1.0f32;
    if tau_alpha!=0.0f32 {
        ratio:=f32(pos+1)/tau_floor;
        if ratio<1.0f32 {ratio=1.0f32;}
        tau=1.0f32+tau_alpha*log(ratio);
    }
    for thread:0..<INK_AT {
        if thread<INK_HEAD {
            v:=q[h*INK_HEAD+thread];
            if (flags&1)!=0 {v=v*qclip[(h%n_head)*INK_HEAD+thread];}
            qsh[thread]=v;dp[thread]=v*v;
        }
        if thread<INK_REL {
            v:=r[h*INK_REL+thread];
            if (flags&2)!=0 {v=v*rclip[(h%n_head)*INK_REL+thread];}
            rsh[thread]=v;ssum[thread]=v*v;
        }
    }
    for thread:0..<INK_AT {
        if thread<16 {
            sum:f32=0.0f32;
            for j:0..<8 {sum+=dp[thread*8+j];}
            gs[thread]=sum;
        }
    }
    for thread:0..<INK_AT {
        if thread<INK_HEAD {
            tot:f32=0.0f32;
            for j:0..<16 {tot+=gs[j];}
            fac:=thr_q/(sqrt(tot)+0.000001f32);
            if fac>1.0f32 {fac=1.0f32;}
            qsh[thread]=qsh[thread]*fac*tau;
        }
        if thread<INK_REL {
            tot:f32=0.0f32;
            for j:0..<INK_REL {tot+=ssum[j];}
            fac:=thr_r/(sqrt(tot)+0.000001f32);
            if fac>1.0f32 {fac=1.0f32;}
            rsh[thread]=rsh[thread]*fac*tau;
        }
    }
    // Pass 1: Q.K * scale + rel_bias - sink for every key in the window, into
    // scratch_scores, 128 keys at a time. Eight threads share a key: each
    // asks for 16 of its dimensions together and adds their products, and
    // the key's first thread adds the eight and keeps the largest score.
    for thread:0..<INK_AT {smax[thread]=INK_NEG_INF;}
    for c:0..<(n_keys+127)/128 {
        for thread:0..<INK_AT {
            kidx:=c*128+thread/8;part:=thread%8;sum:f32=0.0f32;
            if kidx<n_keys {
                kp:=start+kidx;
                slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                kbase:=slot*n_kv_elem+kv_h*head_dim+part*16;
                kv:[16]u16;
                for d:0..<16 {kv[d]=k_cache[kbase+d];}
                for d:0..<16 {sum+=qsh[part*16+d]*ink_half(cast(u32)kv[d]);}
            }
            dp[thread]=sum;
        }
        for thread:0..<INK_AT {
            if thread<128 {
                kidx:=c*128+thread;
                if kidx<n_keys {
                    kp:=start+kidx;
                    dot:=((dp[thread*8]+dp[thread*8+1])+(dp[thread*8+2]+dp[thread*8+3]))+((dp[thread*8+4]+dp[thread*8+5])+(dp[thread*8+6]+dp[thread*8+7]));
                    dist:=pos-kp;
                    rb:f32=0.0f32;
                    if dist<extent {
                        rb_base:=dist*n_rel;
                        rs:[16]f32;
                        for j:0..<INK_REL {rs[j]=rel_bias[rb_base+j];}
                        for j:0..<INK_REL {rb+=rs[j]*rsh[j];}
                    }
                    score:=dot*scale+rb-sink_val;
                    scratch_scores[sbase+kidx]=score;
                    if score>smax[thread] {smax[thread]=score;}
                }
            }
        }
    }
    for thread:0..<INK_AT {
        if thread<32 {
            m:f32=INK_NEG_INF;
            for j:0..<32 {if smax[thread*32+j]>m {m=smax[thread*32+j];}}
            gm[thread]=m;
        }
    }
    // Pass 2: exponentiate against the largest score (the sink's logit is 0)
    // and add up the denominator.
    for thread:0..<INK_AT {
        gmax:f32=0.0f32;
        for j:0..<32 {if gm[j]>gmax {gmax=gm[j];}}
        lsum:f32=0.0f32;
        for c:0..<n_chunks {
            kidx:=c*INK_AT+thread;
            if kidx<n_keys {
                w:=exp(scratch_scores[sbase+kidx]-gmax);
                scratch_scores[sbase+kidx]=w;
                lsum+=w;
            }
        }
        ssum[thread]=lsum;
    }
    for thread:0..<INK_AT {
        if thread<32 {
            sum:f32=0.0f32;
            for j:0..<32 {sum+=ssum[thread*32+j];}
            gs[thread]=sum;
        }
    }
    // Pass 3: the weighted sum of V. Eight threads share each output
    // dimension: thread p*128+d adds the keys p, p+8, ... for dimension d.
    for thread:0..<INK_AT {
        d:=thread%INK_HEAD;part:=thread/INK_HEAD;
        vsum:f32=0.0f32;
        if d<head_dim {
            for c:0..<(n_keys+31)/32 {
                ws:[4]f32;vv:[4]u16;
                for j:0..<4 {
                    kidx:=(c*4+j)*8+part;
                    ws[j]=0.0f32;vv[j]=0;
                    if kidx<n_keys {
                        kp:=start+kidx;
                        slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                        ws[j]=scratch_scores[sbase+kidx];vv[j]=v_cache[slot*n_kv_elem+kv_h*head_dim+d];
                    }
                }
                for j:0..<4 {vsum+=ws[j]*ink_half(cast(u32)vv[j]);}
            }
        }
        vpart[thread]=vsum;
    }
    for thread:0..<INK_AT {
        if thread<head_dim {
            gmax:f32=0.0f32;
            for j:0..<32 {if gm[j]>gmax {gmax=gm[j];}}
            gsum:f32=exp(-gmax);
            for j:0..<32 {gsum+=gs[j];}
            vsum:f32=0.0f32;
            for p:0..<8 {vsum+=vpart[p*INK_HEAD+thread];}
            idx:=h*head_dim+thread;
            out[idx]=vsum/gsum*ink_sigmoid(gate[idx]);
        }
    }
}

// ---- Single-pass online-softmax GQA attention (zero scratch_scores DRAM buffer).
// Each group of INK_OA=256 threads processes up to 8 Q vectors sharing one KV head
// (for gqa=2: 4 consecutive tokens x 2 Q heads), reusing every K/V tile 8x in shared
// memory (KV_TILE=8 keys, 13 KB smem). Exact sink logit 0 via initial m=0, s=1.
// Launch items = ceil(np / t_step) * n_head_kv * g_chunks, where
//   q_in_g = min(gqa, 8), t_step = 8 / q_in_g, g_chunks = ceil(gqa / q_in_g).
ink_attn_online :: (item:int,dims0:int,dims1:int,kv_cap:int,pos0:int,np:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,out:[]f32,flags:int,thr_q:f32,thr_r:f32,tau_alpha:f32,tau_floor:f32,qclip:[]f32,rclip:[]f32) #export_c #effects(all) {
    kvsh:[1024]f32;pdot:[2048]f32;rsh:[128]f32;sc:[128]f32;wt:[64]f32;
    s_pos:[8]int;s_start:[8]int;s_h:[8]int;s_valid:[8]int;s_sink:[8]f32;
    s_m:[8]f32;s_s:[8]f32;s_alpha:[8]f32;
    qr:[1024]f32;ov:[1024]f32;
    n_head:=dims0&65535;n_head_kv:=(dims0>>16)&65535;head_dim:=(dims0>>32)&65535;n_rel:=(dims0>>48)&65535;
    extent:=dims1&16777215;is_swa:=(dims1>>24)&255;swa:=(dims1>>32)&16777215;
    gqa:=n_head/n_head_kv;
    q_in_g:=ifx gqa<8 then gqa else 8;
    t_step:=8/q_in_g;
    g_chunks:=(gqa+q_in_g-1)/q_in_g;
    kv_g:=item%(n_head_kv*g_chunks);
    tok0:=(item/(n_head_kv*g_chunks))*t_step;
    kv_h:=kv_g/g_chunks;
    g0:=(kv_g%g_chunks)*q_in_g;
    n_kv_elem:=cast(u32)(n_head_kv*head_dim);
    kv_off:=mul_wrap(cast(u32)kv_h,128);
    cap32:=cast(u32)kv_cap;
    scale:=1.0f32/sqrt(f32(head_dim));
    // Setup metadata, load Q & R, compute norms for clipping.
    for thread:0..<INK_OA {
        if thread<8 {
            dt:=thread/q_in_g;dg:=thread%q_in_g;
            tok:=tok0+dt;qh:=kv_h*gqa+g0+dg;
            valid:=ifx dt<t_step && tok<np && g0+dg<gqa then 1 else 0;
            h:=ifx valid!=0 then tok*n_head+qh else 0;
            pos:=pos0+tok;
            st:int=0;
            if is_swa!=0 && pos>=swa {st=pos-swa+1;}
            s_valid[thread]=valid;s_h[thread]=h;s_pos[thread]=pos;s_start[thread]=st;
            s_sink[thread]=ifx valid!=0 then sinks[h] else 0.0f32;
            s_m[thread]=0.0f32;s_s[thread]=1.0f32;s_alpha[thread]=1.0f32;
        }
        if thread<128 {
            qi:=thread/16;rj:=thread%16;
            dt:=qi/q_in_g;dg:=qi%q_in_g;
            tok:=tok0+dt;qh:=kv_h*gqa+g0+dg;
            if dt<t_step && tok<np && g0+dg<gqa {
                h:=tok*n_head+qh;
                rv:=r[h*INK_REL+rj];
                if (flags&2)!=0 {rv=rv*rclip[qh*INK_REL+rj];}
                rsh[thread]=rv;sc[thread]=rv*rv;
            } else {
                rsh[thread]=0.0f32;sc[thread]=0.0f32;
            }
        }
        qi:=thread/32;lane:=thread%32;
        dt:=qi/q_in_g;dg:=qi%q_in_g;
        tok:=tok0+dt;qh:=kv_h*gqa+g0+dg;
        qss:f32=0.0f32;
        if dt<t_step && tok<np && g0+dg<gqa {
            h:=tok*n_head+qh;
            qb:=h*INK_HEAD+lane*4;cb:=qh*INK_HEAD+lane*4;
            v0:=q[qb+0];v1:=q[qb+1];v2:=q[qb+2];v3:=q[qb+3];
            if (flags&1)!=0 {
                v0=v0*qclip[cb+0];v1=v1*qclip[cb+1];v2=v2*qclip[cb+2];v3=v3*qclip[cb+3];
            }
            qr[thread*4+0]=v0;qr[thread*4+1]=v1;qr[thread*4+2]=v2;qr[thread*4+3]=v3;
            qss=(v0*v0+v1*v1)+(v2*v2+v3*v3);
        } else {
            qr[thread*4+0]=0.0f32;qr[thread*4+1]=0.0f32;qr[thread*4+2]=0.0f32;qr[thread*4+3]=0.0f32;
        }
        pdot[thread]=qss;
        ov[thread*4+0]=0.0f32;ov[thread*4+1]=0.0f32;ov[thread*4+2]=0.0f32;ov[thread*4+3]=0.0f32;
    }
    // Apply Q/R L2 norm clip and log-scale tau.
    for thread:0..<INK_OA {
        qi:=thread/32;
        if s_valid[qi]!=0 {
            tau:f32=1.0f32;
            if tau_alpha!=0.0f32 {
                ratio:=f32(s_pos[qi]+1)/tau_floor;
                if ratio<1.0f32 {ratio=1.0f32;}
                tau=1.0f32+tau_alpha*log(ratio);
            }
            tot_q:f32=0.0f32;
            for j:0..<32 {tot_q+=pdot[qi*32+j];}
            qfac:=thr_q/(sqrt(tot_q)+0.000001f32);
            if qfac>1.0f32 {qfac=1.0f32;}
            qm:=qfac*tau;
            qr[thread*4+0]=qr[thread*4+0]*qm;qr[thread*4+1]=qr[thread*4+1]*qm;
            qr[thread*4+2]=qr[thread*4+2]*qm;qr[thread*4+3]=qr[thread*4+3]*qm;
        }
        if thread<128 {
            rq:=thread/16;
            if s_valid[rq]!=0 {
                tau:f32=1.0f32;
                if tau_alpha!=0.0f32 {
                    ratio:=f32(s_pos[rq]+1)/tau_floor;
                    if ratio<1.0f32 {ratio=1.0f32;}
                    tau=1.0f32+tau_alpha*log(ratio);
                }
                tot_r:f32=0.0f32;
                for j:0..<INK_REL {tot_r+=sc[rq*INK_REL+j];}
                rfac:=thr_r/(sqrt(tot_r)+0.000001f32);
                if rfac>1.0f32 {rfac=1.0f32;}
                rsh[thread]=rsh[thread]*rfac*tau;
            }
        }
    }
    // Union key range across the CTA's tokens: [k_min .. k_max].
    tok_last:=tok0+t_step-1;
    if tok_last>=np {tok_last=np-1;}
    pos_first:=pos0+tok0;
    pos_last:=pos0+tok_last;
    k_min:int=0;
    if is_swa!=0 && pos_first>=swa {k_min=pos_first-swa+1;}
    n_keys_cta:=pos_last-k_min+1;
    n_tiles:=cast(u32)((n_keys_cta+7)/8);
    k_min32:=cast(u32)k_min;
    pos_last32:=cast(u32)pos_last;
    ext32:=cast(u32)extent;
    n_rel32:=cast(u32)n_rel;
    for blk:cast(u32)0..<n_tiles {
        k_base:=add_wrap(k_min32,mul_wrap(blk,8));
        // Step 1: cooperatively load 8 K vectors (4 f16/thread -> kvsh[thread*4 .. +3]).
        for thread:0..<INK_OA {
            t:=cast(u32)thread;
            kk:=t/32;d0:=mul_wrap(t%32,4);
            kp:=add_wrap(k_base,kk);
            if kp<=pos_last32 {
                slot:=ifx is_swa!=0 then kp%cap32 else kp;
                kb:=add_wrap(add_wrap(mul_wrap(slot,n_kv_elem),kv_off),d0);
                k0:=cast(u32)k_cache[cast(int)kb];k1:=cast(u32)k_cache[cast(int)add_wrap(kb,1)];
                k2:=cast(u32)k_cache[cast(int)add_wrap(kb,2)];k3:=cast(u32)k_cache[cast(int)add_wrap(kb,3)];
                kvsh[thread*4+0]=ink_half(k0);kvsh[thread*4+1]=ink_half(k1);
                kvsh[thread*4+2]=ink_half(k2);kvsh[thread*4+3]=ink_half(k3);
            } else {
                kvsh[thread*4+0]=0.0f32;kvsh[thread*4+1]=0.0f32;
                kvsh[thread*4+2]=0.0f32;kvsh[thread*4+3]=0.0f32;
            }
        }
        // Step 2: each thread computes its 4-dim partial Q.K dot for all 8 keys.
        for thread:0..<INK_OA {
            d0:=mul_wrap(cast(u32)(thread%32),4);
            q0:=qr[thread*4+0];q1:=qr[thread*4+1];q2:=qr[thread*4+2];q3:=qr[thread*4+3];
            for kk:0..<8 {
                kb:=cast(int)add_wrap(mul_wrap(cast(u32)kk,128),d0);
                pdot[thread*8+kk]=(q0*kvsh[kb+0]+q1*kvsh[kb+1])+(q2*kvsh[kb+2]+q3*kvsh[kb+3]);
            }
        }
        // Step 3: load 8 V vectors into kvsh WHILE threads 0..63 reduce pdot + rel_bias -> sc[0..63].
        for thread:0..<INK_OA {
            t:=cast(u32)thread;
            kk:=t/32;d0:=mul_wrap(t%32,4);
            kp:=add_wrap(k_base,kk);
            if kp<=pos_last32 {
                slot:=ifx is_swa!=0 then kp%cap32 else kp;
                vb:=add_wrap(add_wrap(mul_wrap(slot,n_kv_elem),kv_off),d0);
                v0:=cast(u32)v_cache[cast(int)vb];v1:=cast(u32)v_cache[cast(int)add_wrap(vb,1)];
                v2:=cast(u32)v_cache[cast(int)add_wrap(vb,2)];v3:=cast(u32)v_cache[cast(int)add_wrap(vb,3)];
                kvsh[thread*4+0]=ink_half(v0);kvsh[thread*4+1]=ink_half(v1);
                kvsh[thread*4+2]=ink_half(v2);kvsh[thread*4+3]=ink_half(v3);
            } else {
                kvsh[thread*4+0]=0.0f32;kvsh[thread*4+1]=0.0f32;
                kvsh[thread*4+2]=0.0f32;kvsh[thread*4+3]=0.0f32;
            }
            if thread<64 {
                qi:=thread/8;sk:=cast(u32)(thread%8);
                skp:=add_wrap(k_base,sk);
                sp:=cast(u32)s_pos[qi];sst:=cast(u32)s_start[qi];
                if s_valid[qi]!=0 && skp>=sst && skp<=sp {
                    dot:f32=0.0f32;
                    qbase:=mul_wrap(cast(u32)qi,256);
                    for j:cast(u32)0..<32 {dot+=pdot[cast(int)add_wrap(add_wrap(qbase,mul_wrap(j,8)),sk)];}
                    dist:=sp-skp;
                    rb:f32=0.0f32;
                    if dist<ext32 {
                        rbb:=mul_wrap(dist,n_rel32);rbq:=mul_wrap(cast(u32)qi,16);
                        for j:cast(u32)0..<16 {rb+=rel_bias[cast(int)add_wrap(rbb,j)]*rsh[cast(int)add_wrap(rbq,j)];}
                    }
                    sc[thread]=dot*scale+rb-s_sink[qi];
                } else {
                    sc[thread]=INK_NEG_INF;
                }
            }
        }
        // Step 3b: compute per-Q online softmax weights ONCE per Q (8 threads x 8 keys).
        for thread:0..<INK_OA {
            if thread<8 {
                if s_valid[thread]!=0 {
                    m_old:=s_m[thread];m_new:=m_old;
                    sb:=thread*8;
                    for kk:0..<8 {sv:=sc[sb+kk];if sv>m_new {m_new=sv;}}
                    alpha:f32=1.0f32;
                    if m_new>m_old {alpha=exp(m_old-m_new);}
                    s_cur:=s_s[thread]*alpha;
                    for kk:0..<8 {
                        sv:=sc[sb+kk];
                        w:f32=0.0f32;
                        if sv>-100000000000000000000000000000.0f32 {w=exp(sv-m_new);s_cur+=w;}
                        wt[thread*8+kk]=w;
                    }
                    s_m[thread]=m_new;s_s[thread]=s_cur;s_alpha[thread]=alpha;
                }
            }
        }
        // Step 4: branchless pure-FMA weighted V accumulation into per-thread registers.
        for thread:0..<INK_OA {
            qi:=thread/32;
            if s_valid[qi]!=0 {
                alpha:=s_alpha[qi];
                o0:=ov[thread*4+0]*alpha;o1:=ov[thread*4+1]*alpha;
                o2:=ov[thread*4+2]*alpha;o3:=ov[thread*4+3]*alpha;
                d0:=mul_wrap(cast(u32)(thread%32),4);
                sb:=mul_wrap(cast(u32)qi,8);
                for kk:cast(u32)0..<8 {
                    w:=wt[cast(int)add_wrap(sb,kk)];
                    vb:=cast(int)add_wrap(mul_wrap(kk,128),d0);
                    o0+=w*kvsh[vb+0];o1+=w*kvsh[vb+1];o2+=w*kvsh[vb+2];o3+=w*kvsh[vb+3];
                }
                ov[thread*4+0]=o0;ov[thread*4+1]=o1;ov[thread*4+2]=o2;ov[thread*4+3]=o3;
            }
        }
    }
    // Epilogue: divide by softmax denominator and multiply by sigmoid(gate).
    for thread:0..<INK_OA {
        qi:=thread/32;lane:=thread%32;
        if s_valid[qi]!=0 {
            inv_s:=1.0f32/s_s[qi];
            idx:=s_h[qi]*128+lane*4;
            out[idx+0]=ov[thread*4+0]*inv_s*ink_sigmoid(gate[idx+0]);
            out[idx+1]=ov[thread*4+1]*inv_s*ink_sigmoid(gate[idx+1]);
            out[idx+2]=ov[thread*4+2]*inv_s*ink_sigmoid(gate[idx+2]);
            out[idx+3]=ov[thread*4+3]*inv_s*ink_sigmoid(gate[idx+3]);
        }
    }
}

// ---- Residual add: dst[i] = a[i] + b[i]. Launch items = n, lanes = 1.
ink_add :: (item:int,n:int,a:[]f32,b:[]f32,dst:[]f32) #export_c #effects(all) {
    if item<n {dst[item]=a[item]+b[item];}
}

// ---- Copy: dst[i] = src[i]. Launch items = n, lanes = 1.
ink_copy :: (item:int,n:int,src:[]f32,dst:[]f32) #export_c #effects(all) {
    if item<n {dst[item]=src[item];}
}

// ---- Final logit softcapping: x[i] = cap * tanh(x[i] / cap). Launch items = n, lanes = 1.
ink_softcap :: (item:int,n:int,cap:f32,x:[]f32) #export_c #effects(all) {
    if item<n {x[item]=cap*ink_tanh(x[item]/cap);}
}

// ---- Register-dequantizing matvecs for the microscaled float formats.
// FP4 E2M1 value (an NVFP4 element: 1 sign bit and a 3-bit magnitude).
ink_nvfp4_val :: (nib:u32)->f32 #effects(all) {
    m:=nib&7;
    v:f32=ifx m==0 then 0.0f32 else ifx m==1 then 0.5f32 else ifx m==2 then 1.0f32 else ifx m==3 then 1.5f32
        else ifx m==4 then 2.0f32 else ifx m==5 then 3.0f32 else ifx m==6 then 4.0f32 else 6.0f32;
    return ifx (nib&8)!=0 then -v else v;
}

// FP8 E4M3FN byte -> f32 (bias 7; subnormals are exact).
ink_fp8_e4m3 :: (b:u32)->f32 #effects(all) {
    e:=(b>>3)&15; m:=b&7;
    v:f32=ifx e==0 then f32(m)*(1.0f32/512.0f32) else f32_from_bits(((e+120)<<23)|(m<<20));
    return ifx (b&128)!=0 then -v else v;
}

// UE8M0 shared exponent -> f32 (2^(e - 127), an exact power of two).
ink_ue8m0 :: (e:u32)->f32 #effects(all) {
    if e==0 { return f32_from_bits(0x00400000); }
    return f32_from_bits((e&255)<<23);
}

// NVFP4 matvec: 16-element blocks of 2 u32 of packed nibbles, an E4M3 scale
// per block and one f32 scale for the tensor. One group of 32 threads per
// row (launch items = rows): thread t takes blocks t, t+32, ...; the row's
// sum adds the threads' parts in thread order, so it is the same sum on
// every device. No dequantized weight is ever stored.
ink_dv_nvfp4 :: (item:int,rows:int,cols:int,global_scale:f32,packed:[]u32,scales:[]u32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[32]f32;
    blocks:=cols/16;
    for thread:0..<32 {
        acc:f32=0;
        if item<rows {
            for step:0..<(blocks+31)/32 {
                blk:=step*32+thread;
                if blk<blocks {
                    bidx:=item*blocks+blk;
                    w0:=packed[bidx*2];
                    w1:=packed[bidx*2+1];
                    sc_word:=scales[bidx/4];
                    sc_byte:=(sc_word>>cast(u32)((bidx&3)*8))&255;
                    sc:=ink_fp8_e4m3(sc_byte)*global_scale;
                    xb:=blk*16;
                    s:f32=0;
                    for j:0..<8 {
                        s+=ink_nvfp4_val((w0>>cast(u32)(j*4))&15)*x[xb+j];
                        s+=ink_nvfp4_val((w1>>cast(u32)(j*4))&15)*x[xb+8+j];
                    }
                    acc+=sc*s;
                }
            }
        }
        part[thread]=acc;
    }
    for thread:0..<32 {
        if thread==0 && item<rows {
            tot:f32=0;
            for t:0..<32 {tot+=part[t];}
            out[item]=tot;
        }
    }
}

// MXFP8 matvec: 32-element blocks of 8 u32 of E4M3 bytes and a UE8M0 shared
// exponent per block. Launch and summation as ink_dv_nvfp4.
ink_dv_mxfp8 :: (item:int,rows:int,cols:int,weights:[]u32,scales:[]u32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[32]f32;
    blocks:=cols/32;
    for thread:0..<32 {
        acc:f32=0;
        if item<rows {
            for step:0..<(blocks+31)/32 {
                blk:=step*32+thread;
                if blk<blocks {
                    bidx:=item*blocks+blk;
                    sc_word:=scales[bidx/4];
                    sc_byte:=(sc_word>>cast(u32)((bidx&3)*8))&255;
                    sc:=ink_ue8m0(sc_byte);
                    xb:=blk*32;
                    wbase:=bidx*8;
                    s:f32=0;
                    for j:0..<8 {
                        wd:=weights[wbase+j];
                        s+=ink_fp8_e4m3(wd&255)*x[xb+j*4]
                          +ink_fp8_e4m3((wd>>8)&255)*x[xb+j*4+1]
                          +ink_fp8_e4m3((wd>>16)&255)*x[xb+j*4+2]
                          +ink_fp8_e4m3((wd>>24)&255)*x[xb+j*4+3];
                    }
                    acc+=sc*s;
                }
            }
        }
        part[thread]=acc;
    }
    for thread:0..<32 {
        if thread==0 && item<rows {
            tot:f32=0;
            for t:0..<32 {tot+=part[t];}
            out[item]=tot;
        }
    }
}

// ---- Parity diagnostic, never part of normal inference. ggml multiplies a
// quantized weight matrix by activations it has first rounded to Q8_0 (blocks
// of 32, an f16 scale, 8-bit codes); this engine keeps activations in f32.
// Rounding the input the same way (INK_ORACLE_Q8=1) removes that difference,
// so what is left when comparing logits is this engine's own arithmetic.
// Launch items = n / 32, one thread per block.
ink_q8_round :: (item:int,n:int,x:[]f32,out:[]f32) #export_c #effects(all) {
    base:=item*32;
    if base+32<=n {
        amax:f32=0;
        for j:0..<32 {
            v:=x[base+j];
            a:=ifx v<0.0f32 then -v else v;
            if a>amax {amax=a;}
        }
        d:=amax/127.0f32;
        id:f32=ifx d!=0.0f32 then 1.0f32/d else 0.0f32;
        dq:=ink_half(ink_f16(d));
        for j:0..<32 {
            t:=x[base+j]*id;
            q:f32=ifx t<0.0f32 then -floor(0.5f32-t) else floor(t+0.5f32);
            out[base+j]=q*dq;
        }
    }
}

// ---- Quantized weights on the device. A quantized matrix [rows, cols] is
// stored block-major, not in GGUF order, so that the 32 threads of a warp
// that hold 32 neighbouring rows read one contiguous run of memory:
//   wq[(b*W + k)*rows + r]  word k of row r's block b: bytes 4k..4k+3 of its
//                           codes (W = 4 words for IQ4_NL, 8 for Q8_0)
//   wd[b*rows + r]          the block's f16 scale
// The bits are the GGUF's; ink_relayout only moves them. Each kernel below
// gives a group of 1024 threads to 32 rows: warp c takes the rows' blocks
// c*run .. c*run+run-1, and the row's sum adds the 32 warps' parts in order.

// GGUF order -> device order for n rows that start at row row0 of a matrix of
// `rows` rows. raw holds those n rows as GGUF blocks (u16 words: an f16
// scale, then the codes). pair > 0 (an expert's gate_up, pair = n_ff, n =
// rows): device row 2i is gate row i and device row 2i+1 is up row i, so a
// hidden unit's two rows are neighbours. Launch items = n*blocks*(words+1).
ink_relayout :: (item:int,rows:int,row0:int,n:int,blocks:int,words:int,pair:int,raw:[]u16,lq:[]u32,ld:[]u16) #export_c #effects(all) {
    nq:=n*blocks*words;bw:=1+2*words;
    if item<nq {
        rl:=item%n;bk:=item/n;b:=bk/words;k:=bk%words;
        src:=ifx pair>0 then (rl%2)*pair+rl/2 else rl;
        at:=(src*blocks+b)*bw+1+2*k;
        lq[bk*rows+row0+rl]=cast(u32)raw[at]|(cast(u32)raw[at+1]<<16);
    } else if item<nq+n*blocks {
        j:=item-nq;rl:=j%n;b:=j/n;
        src:=ifx pair>0 then (rl%2)*pair+rl/2 else rl;
        ld[b*rows+row0+rl]=raw[(src*blocks+b)*bw];
    }
}

// IQ4_NL code -> value, from the table packed four values to a word.
ink_iq4_fast :: (q:u32)->f32 {
    word:u32=ifx q<8 then (ifx q<4 then cast(u32)0xBFAD9881 else cast(u32)0xF6EADDCF)
                     else (ifx q<12 then cast(u32)0x26190D01 else cast(u32)0x71594535);
    return ink_signed((word>>((q&3)*8))&255);
}

// One block of one row times 32 values of x, without the block's scale. qi is
// the index in wq of the block's word 0 for this row; the next word is
// `stride` further on. An IQ4_NL byte j holds value j in its low nibble and
// value j+16 in its high nibble.
ink_lblock :: (q8:int,wq:[]u32,qi:u32,stride:u32,x:[]f32,xb:u32)->f32 {
    sum:f32=0;
    if q8!=0 {
        for k:cast(u32)0..<8 {
            v:=wq[cast(int)add_wrap(qi,mul_wrap(k,stride))];
            xo:=cast(int)add_wrap(xb,mul_wrap(k,4));
            sum+=ink_signed(v&255)*x[xo]+ink_signed((v>>8)&255)*x[xo+1]
                +ink_signed((v>>16)&255)*x[xo+2]+ink_signed(v>>24)*x[xo+3];
        }
    } else {
        for k:cast(u32)0..<4 {
            v:=wq[cast(int)add_wrap(qi,mul_wrap(k,stride))];
            xo:=cast(int)add_wrap(xb,mul_wrap(k,4));
            sum+=ink_iq4_fast(v&15)*x[xo]+ink_iq4_fast((v>>4)&15)*x[xo+16]
                +ink_iq4_fast((v>>8)&15)*x[xo+1]+ink_iq4_fast((v>>12)&15)*x[xo+17]
                +ink_iq4_fast((v>>16)&15)*x[xo+2]+ink_iq4_fast((v>>20)&15)*x[xo+18]
                +ink_iq4_fast((v>>24)&15)*x[xo+3]+ink_iq4_fast(v>>28)*x[xo+19];
        }
    }
    return sum;
}

// Quantized matvec (Q8_0 or IQ4_NL): out[tok, row] = W x[tok]. Launch items =
// tokens * ceil(rows / 32). A group of 1024 threads takes 32 rows; warp c
// takes blocks c*run .. c*run+run-1. lrows is the number of rows the matrix
// is stored with (rows <= lrows: the output head computes only the unpadded
// vocabulary).
ink_mvq :: (item:int,rows:int,lrows:int,cols:int,add:int,q8:int,wq:[]u32,wd:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[1024]f32;
    groups:=(rows+31)/32;tok:=item/groups;row0:=(item%groups)*32;
    nr:=cast(u32)rows;lr:=cast(u32)lrows;blocks:=cast(u32)cols/32;words:=ifx q8!=0 then cast(u32)8 else cast(u32)4;
    run:=(blocks+31)/32;xt:=mul_wrap(cast(u32)tok,cast(u32)cols);
    for thread:0..<INK_MT {
        t:=cast(u32)thread;row:=add_wrap(cast(u32)row0,t%32);chunk:=t/32;acc:f32=0;
        if row<nr {
            for bb:cast(u32)0..<run {
                b:=add_wrap(mul_wrap(chunk,run),bb);
                if b<blocks {
                    s:=ink_lblock(q8,wq,add_wrap(mul_wrap(mul_wrap(b,words),lr),row),lr,x,add_wrap(xt,mul_wrap(b,32)));
                    acc+=ink_half(cast(u32)wd[cast(int)add_wrap(mul_wrap(b,lr),row)])*s;
                }
            }
        }
        part[thread]=acc;
    }
    for thread:0..<INK_MT {
        if thread<32 && row0+thread<rows {
            sum:f32=0;
            for c:0..<32 {sum+=part[c*32+thread];}
            oi:=tok*rows+row0+thread;
            if add!=0 {out[oi]=out[oi]+sum;}else {out[oi]=sum;}
        }
    }
}

// Q8_0 matvec for one token in two steps. A thread's time is what it does in
// a row, so ink_mvq_p gives every thread one block of four rows and nothing
// else, and ink_mvq_s adds a row's blocks.
// ink_mvq_p: launch items = (cols / 32) * (rows / 4), rows a multiple of 4.
// Thread (b, q) takes block b of rows q, q + rows/4, q + 2 rows/4 and q + 3
// rows/4, reading each value of x once for the four, and writes their shares
// part[b*rows + row]. A code byte c means c - 256 for c >= 128; with the top
// bit flipped, u = c ^ 128 is the value plus 128, so a block's sum is
// sum(u * x) - 128 * sum(x), and sum(x) is shared by the four rows.
ink_mvq_p :: (item:int,rows:int,lrows:int,cols:int,wq:[]u32,wd:[]u16,x:[]f32,part:[]f32) #export_c #effects(all) {
    nr:=cast(u32)rows;lr:=cast(u32)lrows;blocks:=cast(u32)cols/32;quarter:=nr/4;
    gi:=cast(u32)item;b:=gi/quarter;
    if b<blocks {
        r0:=gi%quarter;r1:=add_wrap(r0,quarter);r2:=add_wrap(r1,quarter);r3:=add_wrap(r2,quarter);
        xb:=mul_wrap(b,32);db:=mul_wrap(b,lr);pb:=mul_wrap(b,nr);
        // Every load first, then the arithmetic: a thread waits for a load
        // only when it needs the value, so loads asked for together arrive
        // together.
        xs:[32]f32;ws:[32]u32;
        for j:0..<32 {xs[j]=x[cast(int)add_wrap(xb,cast(u32)j)];}
        for k:0..<8 {
            qi:=mul_wrap(add_wrap(mul_wrap(b,8),cast(u32)k),lr);
            ws[k*4]=wq[cast(int)add_wrap(qi,r0)];ws[k*4+1]=wq[cast(int)add_wrap(qi,r1)];
            ws[k*4+2]=wq[cast(int)add_wrap(qi,r2)];ws[k*4+3]=wq[cast(int)add_wrap(qi,r3)];
        }
        d0:=cast(u32)wd[cast(int)add_wrap(db,r0)];d1:=cast(u32)wd[cast(int)add_wrap(db,r1)];
        d2:=cast(u32)wd[cast(int)add_wrap(db,r2)];d3:=cast(u32)wd[cast(int)add_wrap(db,r3)];
        s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;sx:f32=0;
        for k:0..<8 {
            x0:=xs[k*4];x1:=xs[k*4+1];x2:=xs[k*4+2];x3:=xs[k*4+3];
            sx+=(x0+x1)+(x2+x3);
            v:=ws[k*4]^0x80808080;
            s0+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
            v=ws[k*4+1]^0x80808080;
            s1+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
            v=ws[k*4+2]^0x80808080;
            s2+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
            v=ws[k*4+3]^0x80808080;
            s3+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
        }
        off:=128.0f32*sx;
        part[cast(int)add_wrap(pb,r0)]=ink_half(d0)*(s0-off);
        part[cast(int)add_wrap(pb,r1)]=ink_half(d1)*(s1-off);
        part[cast(int)add_wrap(pb,r2)]=ink_half(d2)*(s2-off);
        part[cast(int)add_wrap(pb,r3)]=ink_half(d3)*(s3-off);
    }
}

// ink_mvq_s: out[row] = the sum of the row's n_blocks shares, in block order.
// Launch items = rows.
ink_mvq_s :: (item:int,rows:int,n_blocks:int,add:int,part:[]f32,out:[]f32) #export_c #effects(all) {
    if item<rows {
        nr:=cast(u32)rows;r:=cast(u32)item;sum:f32=0;nb:=cast(u32)n_blocks;
        // Eight loads at a time, all asked for before any is used: a thread
        // waits for a load only when it needs the value.
        for g:cast(u32)0..<nb/8 {
            at:=add_wrap(mul_wrap(mul_wrap(g,8),nr),r);
            v0:=part[cast(int)at];v1:=part[cast(int)add_wrap(at,nr)];
            v2:=part[cast(int)add_wrap(at,mul_wrap(nr,2))];v3:=part[cast(int)add_wrap(at,mul_wrap(nr,3))];
            v4:=part[cast(int)add_wrap(at,mul_wrap(nr,4))];v5:=part[cast(int)add_wrap(at,mul_wrap(nr,5))];
            v6:=part[cast(int)add_wrap(at,mul_wrap(nr,6))];v7:=part[cast(int)add_wrap(at,mul_wrap(nr,7))];
            sum+=((v0+v1)+(v2+v3))+((v4+v5)+(v6+v7));
        }
        for b:(nb/8)*8..<nb {sum+=part[cast(int)add_wrap(mul_wrap(b,nr),r)];}
        if add!=0 {out[item]=out[item]+sum;}else {out[item]=sum;}
    }
}

// ---- A layer's attention projections in one launch. Its Q8_0 matrices that
// read the layer's inputs (Q, K, V, the K and V convolution taps, the
// relative-position and sink projections and the output gate) are listed in
// `desc`, ten words a matrix:
//   0 its codes' place in wq    1 its scales' place in wd   2 rows
//   3 rows it is stored with    4 its input's place in x    5 its output's place
//   6 its shares' place in part 7 the end of its ink_proj_p items
//   8 the end of its rows among all the rows
// ink_proj_p is ink_mvq_p over all of them (launch items = word 7 of the last
// matrix) and ink_proj_s is ink_mvq_s (launch items = word 8 of the last).
// `tok` is the token of the batch: its input is cols further on for each
// token, and a matrix's output rows further on.
ink_proj_p :: (item:int,n_mats:int,tok:int,cols:int,desc:[]u32,wq:[]u32,wd:[]u16,x:[]f32,part:[]f32) #export_c #effects(all) {
    gi:=cast(u32)item;nm:=cast(u32)n_mats;m:u32=0;first:u32=0;
    for i:cast(u32)0..<nm {
        e:=desc[cast(int)add_wrap(mul_wrap(i,10),7)];
        if gi>=e {m=add_wrap(i,1);first=e;}
    }
    if m<nm {
        at:=cast(int)mul_wrap(m,10);
        q0:=desc[at];d0:=desc[at+1];nr:=desc[at+2];lr:=desc[at+3];
        x0b:=add_wrap(desc[at+4],mul_wrap(cast(u32)tok,cast(u32)cols));p0:=desc[at+6];
        local:=gi-first;quarter:=nr/4;b:=local/quarter;
        r0:=local%quarter;r1:=add_wrap(r0,quarter);r2:=add_wrap(r1,quarter);r3:=add_wrap(r2,quarter);
        xb:=add_wrap(x0b,mul_wrap(b,32));db:=add_wrap(d0,mul_wrap(b,lr));pb:=add_wrap(p0,mul_wrap(b,nr));
        xs:[32]f32;ws:[32]u32;
        for j:0..<32 {xs[j]=x[cast(int)add_wrap(xb,cast(u32)j)];}
        for k:0..<8 {
            qi:=add_wrap(q0,mul_wrap(add_wrap(mul_wrap(b,8),cast(u32)k),lr));
            ws[k*4]=wq[cast(int)add_wrap(qi,r0)];ws[k*4+1]=wq[cast(int)add_wrap(qi,r1)];
            ws[k*4+2]=wq[cast(int)add_wrap(qi,r2)];ws[k*4+3]=wq[cast(int)add_wrap(qi,r3)];
        }
        e0:=cast(u32)wd[cast(int)add_wrap(db,r0)];e1:=cast(u32)wd[cast(int)add_wrap(db,r1)];
        e2:=cast(u32)wd[cast(int)add_wrap(db,r2)];e3:=cast(u32)wd[cast(int)add_wrap(db,r3)];
        s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;sx:f32=0;
        for k:0..<8 {
            x0:=xs[k*4];x1:=xs[k*4+1];x2:=xs[k*4+2];x3:=xs[k*4+3];
            sx+=(x0+x1)+(x2+x3);
            v:=ws[k*4]^0x80808080;
            s0+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
            v=ws[k*4+1]^0x80808080;
            s1+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
            v=ws[k*4+2]^0x80808080;
            s2+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
            v=ws[k*4+3]^0x80808080;
            s3+=f32(v&255)*x0+f32((v>>8)&255)*x1+f32((v>>16)&255)*x2+f32(v>>24)*x3;
        }
        off:=128.0f32*sx;
        part[cast(int)add_wrap(pb,r0)]=ink_half(e0)*(s0-off);
        part[cast(int)add_wrap(pb,r1)]=ink_half(e1)*(s1-off);
        part[cast(int)add_wrap(pb,r2)]=ink_half(e2)*(s2-off);
        part[cast(int)add_wrap(pb,r3)]=ink_half(e3)*(s3-off);
    }
}

ink_proj_s :: (item:int,n_mats:int,tok:int,n_blocks:int,desc:[]u32,part:[]f32,out:[]f32) #export_c #effects(all) {
    gi:=cast(u32)item;nm:=cast(u32)n_mats;m:u32=0;first:u32=0;
    for i:cast(u32)0..<nm {
        e:=desc[cast(int)add_wrap(mul_wrap(i,10),8)];
        if gi>=e {m=add_wrap(i,1);first=e;}
    }
    if m<nm {
        at:=cast(int)mul_wrap(m,10);
        nr:=desc[at+2];r:=gi-first;p0:=add_wrap(desc[at+6],r);nb:=cast(u32)n_blocks;sum:f32=0;
        for g:cast(u32)0..<nb/8 {
            pa:=add_wrap(p0,mul_wrap(mul_wrap(g,8),nr));
            v0:=part[cast(int)pa];v1:=part[cast(int)add_wrap(pa,nr)];
            v2:=part[cast(int)add_wrap(pa,mul_wrap(nr,2))];v3:=part[cast(int)add_wrap(pa,mul_wrap(nr,3))];
            v4:=part[cast(int)add_wrap(pa,mul_wrap(nr,4))];v5:=part[cast(int)add_wrap(pa,mul_wrap(nr,5))];
            v6:=part[cast(int)add_wrap(pa,mul_wrap(nr,6))];v7:=part[cast(int)add_wrap(pa,mul_wrap(nr,7))];
            sum+=((v0+v1)+(v2+v3))+((v4+v5)+(v6+v7));
        }
        for b:(nb/8)*8..<nb {sum+=part[cast(int)add_wrap(p0,mul_wrap(b,nr))];}
        out[cast(int)add_wrap(add_wrap(desc[at+5],mul_wrap(cast(u32)tok,nr)),r)]=sum;
    }
}

// ---- Table kernels for IQ4_NL experts, one token at a time. An IQ4_NL byte
// holds two codes: value j of its block in the low nibble and value j+16 in
// the high one. For one block of x, a 16 x 256 table in the group's shared
// memory holds T[low]*x[j] + T[high]*x[j+16] for every byte value, so a row's
// 32 products are 16 lookups and 16 additions. One group of 256 threads per
// (expert, block): the threads build the table (16 entries each), then each
// takes every 256th row. A group's results are that block's share of each
// row's sum; the next kernel adds a row's shares in block order.

// gate_up shares for one token. Launch items = n_used * (cols / 32). wq and
// wd are the layer's expert cache; part is [n_used, cols/32, 2*n_ff] with the
// rows in device order (gate i, up i, gate i+1, ...).
ink_moe_gu_t :: (item:int,n_ff:int,cols:int,wq:[]u32,wd:[]u16,x:[]f32,ids:[]u32,part:[]f32) #export_c #effects(all) {
    tab:[4096]f32;
    gi:=cast(u32)item;blocks:=cast(u32)cols/32;slot:=gi/blocks;block:=gi%blocks;
    rows:=mul_wrap(cast(u32)n_ff,2);cells:=mul_wrap(rows,blocks);id:=ids[cast(int)slot];
    qb:=add_wrap(mul_wrap(id,add_wrap(mul_wrap(cells,4),cells/2)),mul_wrap(mul_wrap(block,4),rows));
    db:=add_wrap(add_wrap(mul_wrap(id,mul_wrap(cells,9)),mul_wrap(cells,8)),mul_wrap(block,rows));
    xb:=mul_wrap(block,32);ob:=mul_wrap(gi,rows);
    for thread:0..<INK_NT {
        t:=cast(u32)thread;j:=t/16;hi:=t%16;
        a:=ink_iq4_fast(hi)*x[cast(int)add_wrap(xb,add_wrap(j,16))];
        xl:=x[cast(int)add_wrap(xb,j)];
        for k:0..<16 {tab[thread*16+k]=ink_iq4_fast(cast(u32)k)*xl+a;}
    }
    for thread:0..<INK_NT {
        t:=cast(u32)thread;
        for rr:cast(u32)0..<(rows+255)/256 {
            row:=add_wrap(mul_wrap(rr,256),t);
            if row<rows {
                at:=add_wrap(qb,row);
                v0:=wq[cast(int)at];v1:=wq[cast(int)add_wrap(at,rows)];
                v2:=wq[cast(int)add_wrap(at,mul_wrap(rows,2))];v3:=wq[cast(int)add_wrap(at,mul_wrap(rows,3))];
                dw:=cast(u32)wd[cast(int)add_wrap(db,row)];
                // A row's block from its table: word k holds bytes 4k..4k+3,
                // and byte j looks up entry j*256 + its value. The 16 lookups
                // are asked for together.
                a0:=tab[cast(int)(v0&255)];a1:=tab[cast(int)(256+((v0>>8)&255))];a2:=tab[cast(int)(512+((v0>>16)&255))];a3:=tab[cast(int)(768+(v0>>24))];
                b0:=tab[cast(int)(1024+(v1&255))];b1:=tab[cast(int)(1280+((v1>>8)&255))];b2:=tab[cast(int)(1536+((v1>>16)&255))];b3:=tab[cast(int)(1792+(v1>>24))];
                c0:=tab[cast(int)(2048+(v2&255))];c1:=tab[cast(int)(2304+((v2>>8)&255))];c2:=tab[cast(int)(2560+((v2>>16)&255))];c3:=tab[cast(int)(2816+(v2>>24))];
                e0:=tab[cast(int)(3072+(v3&255))];e1:=tab[cast(int)(3328+((v3>>8)&255))];e2:=tab[cast(int)(3584+((v3>>16)&255))];e3:=tab[cast(int)(3840+(v3>>24))];
                sum:=(((a0+a1)+(a2+a3))+((b0+b1)+(b2+b3)))+(((c0+c1)+(c2+c3))+((e0+e1)+(e2+e3)));
                part[cast(int)add_wrap(ob,row)]=ink_half(dw)*sum;
            }
        }
    }
}

// down shares for one token. Launch items = n_used * (cols / 32); cols =
// n_ff. A group first adds up the gate_up shares of its block's 32 hidden
// units (in four runs of blocks, then the four), applies SITU and the
// expert's router weight, and builds its table from those. gu_part is
// ink_moe_gu_t's output for in_cols input columns; part is [n_used, cols/32,
// rows].
ink_moe_down_t :: (item:int,rows:int,cols:int,in_cols:int,beta:f32,lb:f32,wq:[]u32,wd:[]u16,gu_part:[]f32,ids:[]u32,wts:[]f32,part:[]f32) #export_c #effects(all) {
    tab:[4096]f32;mid:[256]f32;hid:[32]f32;
    gi:=cast(u32)item;blocks:=cast(u32)cols/32;slot:=gi/blocks;block:=gi%blocks;
    nr:=cast(u32)rows;cells:=mul_wrap(nr,blocks);id:=ids[cast(int)slot];
    qb:=add_wrap(mul_wrap(id,add_wrap(mul_wrap(cells,4),cells/2)),mul_wrap(mul_wrap(block,4),nr));
    db:=add_wrap(add_wrap(mul_wrap(id,mul_wrap(cells,9)),mul_wrap(cells,8)),mul_wrap(block,nr));
    gb:=cast(u32)in_cols/32;gu_rows:=mul_wrap(cast(u32)cols,2);run:=(gb+3)/4;
    ob:=mul_wrap(gi,nr);ew:=wts[cast(int)slot];
    for thread:0..<INK_NT {
        t:=cast(u32)thread;j:=t%32;half:=(t/32)%2;chunk:=t/64;
        row:=add_wrap(mul_wrap(add_wrap(mul_wrap(block,32),j),2),half);
        s:f32=0;
        for bb:cast(u32)0..<run {
            b:=add_wrap(mul_wrap(chunk,run),bb);
            if b<gb {s+=gu_part[cast(int)add_wrap(mul_wrap(add_wrap(mul_wrap(slot,gb),b),gu_rows),row)];}
        }
        mid[thread]=s;
    }
    for thread:0..<INK_NT {
        if thread<32 {
            gate:=(mid[thread]+mid[64+thread])+(mid[128+thread]+mid[192+thread]);
            up:=(mid[32+thread]+mid[96+thread])+(mid[160+thread]+mid[224+thread]);
            act:=beta*ink_tanh(gate/beta)*ink_sigmoid(gate);
            if lb>0.0f32 {up=lb*ink_tanh(up/lb);}
            hid[thread]=act*up*ew;
        }
    }
    for thread:0..<INK_NT {
        j:=thread/16;hi:=cast(u32)(thread%16);
        a:=ink_iq4_fast(hi)*hid[j+16];
        xl:=hid[j];
        for k:0..<16 {tab[thread*16+k]=ink_iq4_fast(cast(u32)k)*xl+a;}
    }
    for thread:0..<INK_NT {
        t:=cast(u32)thread;
        for rr:cast(u32)0..<(nr+255)/256 {
            row:=add_wrap(mul_wrap(rr,256),t);
            if row<nr {
                at:=add_wrap(qb,row);
                v0:=wq[cast(int)at];v1:=wq[cast(int)add_wrap(at,nr)];
                v2:=wq[cast(int)add_wrap(at,mul_wrap(nr,2))];v3:=wq[cast(int)add_wrap(at,mul_wrap(nr,3))];
                dw:=cast(u32)wd[cast(int)add_wrap(db,row)];
                // A row's block from its table: word k holds bytes 4k..4k+3,
                // and byte j looks up entry j*256 + its value. The 16 lookups
                // are asked for together.
                a0:=tab[cast(int)(v0&255)];a1:=tab[cast(int)(256+((v0>>8)&255))];a2:=tab[cast(int)(512+((v0>>16)&255))];a3:=tab[cast(int)(768+(v0>>24))];
                b0:=tab[cast(int)(1024+(v1&255))];b1:=tab[cast(int)(1280+((v1>>8)&255))];b2:=tab[cast(int)(1536+((v1>>16)&255))];b3:=tab[cast(int)(1792+(v1>>24))];
                c0:=tab[cast(int)(2048+(v2&255))];c1:=tab[cast(int)(2304+((v2>>8)&255))];c2:=tab[cast(int)(2560+((v2>>16)&255))];c3:=tab[cast(int)(2816+(v2>>24))];
                e0:=tab[cast(int)(3072+(v3&255))];e1:=tab[cast(int)(3328+((v3>>8)&255))];e2:=tab[cast(int)(3584+((v3>>16)&255))];e3:=tab[cast(int)(3840+(v3>>24))];
                sum:=(((a0+a1)+(a2+a3))+((b0+b1)+(b2+b3)))+(((c0+c1)+(c2+c3))+((e0+e1)+(e2+e3)));
                part[cast(int)add_wrap(ob,row)]=ink_half(dw)*sum;
            }
        }
    }
}

// A token's MoE output from its down shares: out[row] = the sum of n_parts
// shares. Launch items = ceil(rows / 32): a group of 256 threads takes 32
// rows, warp c adds a run of the shares, and lane l of warp 0 adds the eight
// runs of row l.
ink_moe_sum :: (item:int,rows:int,n_parts:int,part:[]f32,out:[]f32) #export_c #effects(all) {
    mid:[256]f32;
    nr:=cast(u32)rows;np:=cast(u32)n_parts;run:=(np+7)/8;row0:=mul_wrap(cast(u32)item,32);
    for thread:0..<INK_NT {
        t:=cast(u32)thread;row:=add_wrap(row0,t%32);chunk:=t/32;s:f32=0;
        if row<nr {
            for pp:cast(u32)0..<run {
                p:=add_wrap(mul_wrap(chunk,run),pp);
                if p<np {s+=part[cast(int)add_wrap(mul_wrap(p,nr),row)];}
            }
        }
        mid[thread]=s;
    }
    for thread:0..<INK_NT {
        if thread<32 && item*32+thread<rows {
            sum:f32=0;
            for c:0..<8 {sum+=mid[c*32+thread];}
            out[item*32+thread]=sum;
        }
    }
}

// One token's end of a sublayer from its shares: a row's sum of n_parts
// shares (as ink_moe_sum, or ink_mvq_s for the attention output), the post
// short convolution with its history, and the residual add into cur; with
// block_start != 0, cur is first saved in blk and then replaced. Launch items
// = ceil(rows / 32), a group of 1024 threads: warp c adds a run of the shares
// for the group's 32 rows.
ink_sum_post :: (item:int,rows:int,n_parts:int,block_start:int,part:[]f32,w:[]f32,hist:[]f32,cur:[]f32,blk:[]f32) #export_c #effects(all) {
    mid:[1024]f32;m2:[256]f32;
    nr:=cast(u32)rows;np:=cast(u32)n_parts;run:=(np+31)/32;row0:=mul_wrap(cast(u32)item,32);
    for thread:0..<INK_MT {
        t:=cast(u32)thread;row:=add_wrap(row0,t%32);chunk:=t/32;s:f32=0;
        if row<nr {
            for pp:cast(u32)0..<run {
                p:=add_wrap(mul_wrap(chunk,run),pp);
                if p<np {s+=part[cast(int)add_wrap(mul_wrap(p,nr),row)];}
            }
        }
        mid[thread]=s;
    }
    for thread:0..<INK_MT {
        if thread<256 {
            r:=thread%32;c:=thread/32;
            m2[thread]=(mid[(c*4)*32+r]+mid[(c*4+1)*32+r])+(mid[(c*4+2)*32+r]+mid[(c*4+3)*32+r]);
        }
    }
    for thread:0..<INK_MT {
        if thread<32 && item*32+thread<rows {
            c:=item*32+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];
            w0:=w[c*4+0];w1:=w[c*4+1];w2:=w[c*4+2];w3:=w[c*4+3];old:=cur[c];
            x3:=((m2[thread]+m2[32+thread])+(m2[64+thread]+m2[96+thread]))+((m2[128+thread]+m2[160+thread])+(m2[192+thread]+m2[224+thread]));
            y:=(x3+(x0*w0+x1*w1+x2*w2+x3*w3))/sqrt(5.0f32);
            if block_start!=0 {blk[c]=old;cur[c]=y;} else {cur[c]=old+y;}
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
        }
    }
}

// MoE gate_up and SITU for the n_used chosen experts of every token. wq and
// wd are a layer's whole expert cache: [slots] experts of 2*n_ff rows stored
// with gate row i and up row i as neighbours (ink_relayout, pair). Launch
// items = tokens * n_used * ceil(n_ff / 16): a group takes 16 hidden units of
// one expert, 32 rows. ids are the experts' slots in the cache; out is
// [tokens * n_used, n_ff].
ink_moe_gu :: (item:int,n_ff:int,cols:int,n_used:int,q8:int,beta:f32,lb:f32,wq:[]u32,wd:[]u16,x:[]f32,ids:[]u32,out:[]f32) #export_c #effects(all) {
    part:[1024]f32;
    groups:=(n_ff+15)/16;slot:=item/groups;i0:=(item%groups)*16;
    nr:=mul_wrap(cast(u32)n_ff,2);blocks:=cast(u32)cols/32;words:=ifx q8!=0 then cast(u32)8 else cast(u32)4;
    run:=(blocks+31)/32;cells:=mul_wrap(nr,blocks);id:=ids[slot];
    qb:=mul_wrap(id,add_wrap(mul_wrap(cells,words),cells/2));
    db:=add_wrap(mul_wrap(id,mul_wrap(cells,add_wrap(mul_wrap(words,2),1))),mul_wrap(cells,mul_wrap(words,2)));
    xt:=mul_wrap(cast(u32)(slot/n_used),cast(u32)cols);
    for thread:0..<INK_MT {
        t:=cast(u32)thread;row:=add_wrap(mul_wrap(cast(u32)i0,2),t%32);chunk:=t/32;acc:f32=0;
        if row<nr {
            for bb:cast(u32)0..<run {
                b:=add_wrap(mul_wrap(chunk,run),bb);
                if b<blocks {
                    s:=ink_lblock(q8,wq,add_wrap(qb,add_wrap(mul_wrap(mul_wrap(b,words),nr),row)),nr,x,add_wrap(xt,mul_wrap(b,32)));
                    acc+=ink_half(cast(u32)wd[cast(int)add_wrap(db,add_wrap(mul_wrap(b,nr),row))])*s;
                }
            }
        }
        part[thread]=acc;
    }
    for thread:0..<INK_MT {
        if thread<16 && i0+thread<n_ff {
            gate:f32=0;up:f32=0;
            for c:0..<32 {gate+=part[c*32+2*thread];up+=part[c*32+2*thread+1];}
            act:=beta*ink_tanh(gate/beta)*ink_sigmoid(gate);
            if lb>0.0f32 {up=lb*ink_tanh(up/lb);}
            out[slot*n_ff+i0+thread]=act*up;
        }
    }
}

// MoE down projection and the weighted sum over a token's n_used experts.
// Launch items = tokens * ceil(rows / 32). The work of 32 rows is n_used *
// (cols / 32) (expert, block) pairs, shared out among the group's 32 warps.
// x is [tokens * n_used, cols]; ids and wts are the experts' cache slots and
// router weights.
ink_moe_down :: (item:int,rows:int,cols:int,n_used:int,q8:int,wq:[]u32,wd:[]u16,x:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #export_c #effects(all) {
    part:[1024]f32;
    groups:=(rows+31)/32;tok:=item/groups;row0:=(item%groups)*32;
    nr:=cast(u32)rows;blocks:=cast(u32)cols/32;words:=ifx q8!=0 then cast(u32)8 else cast(u32)4;
    units:=mul_wrap(cast(u32)n_used,blocks);run:=(units+31)/32;cells:=mul_wrap(nr,blocks);
    sb:=mul_wrap(cast(u32)tok,cast(u32)n_used);
    for thread:0..<INK_MT {
        t:=cast(u32)thread;row:=add_wrap(cast(u32)row0,t%32);chunk:=t/32;acc:f32=0;
        if row<nr {
            for uu:cast(u32)0..<run {
                u:=add_wrap(mul_wrap(chunk,run),uu);
                if u<units {
                    b:=u%blocks;slot:=cast(int)add_wrap(sb,u/blocks);id:=ids[slot];
                    qb:=mul_wrap(id,add_wrap(mul_wrap(cells,words),cells/2));
                    db:=add_wrap(mul_wrap(id,mul_wrap(cells,add_wrap(mul_wrap(words,2),1))),mul_wrap(cells,mul_wrap(words,2)));
                    s:=ink_lblock(q8,wq,add_wrap(qb,add_wrap(mul_wrap(mul_wrap(b,words),nr),row)),nr,x,add_wrap(mul_wrap(cast(u32)slot,cast(u32)cols),mul_wrap(b,32)));
                    acc+=wts[slot]*ink_half(cast(u32)wd[cast(int)add_wrap(db,add_wrap(mul_wrap(b,nr),row))])*s;
                }
            }
        }
        part[thread]=acc;
    }
    for thread:0..<INK_MT {
        if thread<32 && row0+thread<rows {
            sum:f32=0;
            for c:0..<32 {sum+=part[c*32+thread];}
            out[tok*rows+row0+thread]=sum;
        }
    }
}

// The end of a layer's MoE for one channel of every token: the post short
// convolution with its history, and the residual add.
// Launch items = n_channels, one thread each.
ink_moe_post :: (item:int,n_channels:int,nb:int,moe:[]f32,w:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    if item<n_channels {
        c:=item;
        x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];
        for b:0..<nb {
            x3:=moe[b*n_channels+c];
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            out[b*n_channels+c]=res[b*n_channels+c]+(x3+acc)/sqrt(5.0f32);
            x0=x1;x1=x2;x2=x3;
        }
        hist[c*3+0]=x0;hist[c*3+1]=x1;hist[c*3+2]=x2;
    }
}

// Matvec F32 for a narrow matrix (cols up to a few hundred): one thread per
// output, launch items = tokens * rows.
ink_dvs_f32 :: (item:int,rows:int,cols:int,add:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    base:=(item%rows)*cols;xb:=(item/rows)*cols;sum:f32=0;
    for c:0..<cols {sum+=w[base+c]*x[xb+c];}
    if add!=0 {out[item]=out[item]+sum;}else {out[item]=sum;}
}

// =========================================================================
// Tensor Core (cu_mma_bf16_16x8x16) prefill kernels for Q8_0 and IQ4_NL.
// =========================================================================
// Every Q8_0 signed integer (-128..127) and every IQ4_NL table integer
// (-127..113) is exact in BF16 (8-bit significand), so weights decode into
// BF16 fragments with zero rounding error and each 32-element block applies
// its exact FP16 scale d in FP32 after the block's two k=16 MMA steps.

ink_bf16_rne :: (x:f32)->u32 #effects(all) {
    b:=f32_bits(x);
    if (b&0x7f800000)==0x7f800000 {return b>>16;}
    return add_wrap(b,add_wrap(0x7fff,(b>>16)&1))>>16;
}

ink_q8_pair_bf16 :: (u:u32)->u32 #effects(all) {
    x:=u^0x8080;
    f0:=f32_bits(f32(x&255)-128.0f32)>>16;
    f1:=f32_bits(f32((x>>8)&255)-128.0f32)>>16;
    return f0|(f1<<16);
}

// Branchless exact BF16 upper 16 bits for the 16 IQ4_NL integer levels (-127..113).
ink_iq4_bf16 :: (q:u32)->u32 #effects(all) {
    w0:=ifx (q&2)==0 then cast(u32)0xC2D0C2FE else cast(u32)0xC282C2A6;
    w1:=ifx (q&2)==0 then cast(u32)0xC20CC244 else cast(u32)0xC120C1B0;
    w2:=ifx (q&2)==0 then cast(u32)0x41503F80 else cast(u32)0x421841C8;
    w3:=ifx (q&2)==0 then cast(u32)0x428A4254 else cast(u32)0x42E242B2;
    lo:=ifx (q&4)==0 then w0 else w1;
    hi:=ifx (q&4)==0 then w2 else w3;
    w:=ifx (q&8)==0 then lo else hi;
    return (w>>((q&1)*16))&0xffff;
}

// Pack [rows, cols] f32 activations into [rows, cols/2] u32 (two RNE BF16 per u32).
// Launch items = n_pairs = rows * (cols / 2).
ink_bf16_pack :: (item:int,n_pairs:int,x:[]f32,out:[]u32) #export_c #effects(all) {
    if item<n_pairs {
        i:=mul_wrap(cast(u32)item,2);
        out[item]=ink_bf16_rne(x[cast(int)i])|(ink_bf16_rne(x[cast(int)add_wrap(i,1)])<<16);
    }
}

// Batched Q8_0 Tensor Core GEMM: out[tok, row] = W[row, :] . x[tok, :] (or +=).
// One warp computes 16 rows by up to 16 tokens (2 x 8) with zero local-memory spills.
// Launch warps = ceil(rows / 16) * ceil(tokens / 16).
// wq/wd are in ink_relayout block-major Q8_0 order; xb is [tokens, cols/2] packed BF16.
ink_q8_mma :: (item:int,rows:int,lrows:int,cols:int,tokens:int,add:int,wq:[]u32,wd:[]u16,xb:[]u32,out:[]f32) #export_c #effects(all) {
    rtiles:=(rows+15)/16;
    r0:=cast(u32)((item%rtiles)*16);
    t0:=cast(u32)((item/rtiles)*16);
    nr:=cast(u32)rows;lr:=cast(u32)lrows;blocks:=cast(u32)cols/32;half:=cast(u32)cols/2;ntoks:=cast(u32)tokens;
    has1:=add_wrap(t0,8)<ntoks;
    fa0:[128]u32;fa1:[128]u32;fb0:[64]u32;fb1:[64]u32;fc:[128]f32;
    a0:[128]f32;a1:[128]f32;ds:[64]f32;
    for b:cast(u32)0..<blocks {
        qbase:=mul_wrap(mul_wrap(b,8),lr);
        dbase:=mul_wrap(b,lr);
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            wo:=t/2;sh:=(t&1)*16;
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            if rl<nr {
                ds[lane*2+0]=ink_half(cast(u32)wd[cast(int)add_wrap(dbase,rl)]);
                fa0[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(wo,lr)),rl)]>>sh)&0xffff);
                fa0[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,2),lr)),rl)]>>sh)&0xffff);
                fa1[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,4),lr)),rl)]>>sh)&0xffff);
                fa1[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,6),lr)),rl)]>>sh)&0xffff);
            } else {
                ds[lane*2+0]=0.0f32;fa0[lane*4+0]=0;fa0[lane*4+2]=0;fa1[lane*4+0]=0;fa1[lane*4+2]=0;
            }
            if rh<nr {
                ds[lane*2+1]=ink_half(cast(u32)wd[cast(int)add_wrap(dbase,rh)]);
                fa0[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(wo,lr)),rh)]>>sh)&0xffff);
                fa0[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,2),lr)),rh)]>>sh)&0xffff);
                fa1[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,4),lr)),rh)]>>sh)&0xffff);
                fa1[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,6),lr)),rh)]>>sh)&0xffff);
            } else {
                ds[lane*2+1]=0.0f32;fa0[lane*4+1]=0;fa0[lane*4+3]=0;fa1[lane*4+1]=0;fa1[lane*4+3]=0;
            }
        }
        // Token tile 0: t0 .. t0+7
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            tk:=add_wrap(t0,g);
            if tk<ntoks {
                base:=add_wrap(mul_wrap(tk,half),add_wrap(mul_wrap(b,16),t));
                fb0[lane*2+0]=xb[cast(int)base];
                fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];
                fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
            } else {
                fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
            }
            fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
        }
        cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
        cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
        for lane:0..<32 {
            dl:=ds[lane*2+0];dh:=ds[lane*2+1];
            a0[lane*4+0]+=dl*fc[lane*4+0];a0[lane*4+1]+=dl*fc[lane*4+1];
            a0[lane*4+2]+=dh*fc[lane*4+2];a0[lane*4+3]+=dh*fc[lane*4+3];
        }
        // Token tile 1: t0+8 .. t0+15
        if has1 {
            for lane:0..<32 {
                g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
                tk:=add_wrap(add_wrap(t0,8),g);
                if tk<ntoks {
                    base:=add_wrap(mul_wrap(tk,half),add_wrap(mul_wrap(b,16),t));
                    fb0[lane*2+0]=xb[cast(int)base];
                    fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                    fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];
                    fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                } else {
                    fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
                fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
            }
            cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
            cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
            for lane:0..<32 {
                dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                a1[lane*4+0]+=dl*fc[lane*4+0];a1[lane*4+1]+=dl*fc[lane*4+1];
                a1[lane*4+2]+=dh*fc[lane*4+2];a1[lane*4+3]+=dh*fc[lane*4+3];
            }
        }
    }
    for lane:0..<32 {
        g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
        rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
        tk0:=add_wrap(t0,mul_wrap(t,2));tk1:=add_wrap(tk0,1);
        if rl<nr {
            if tk0<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk0,nr),rl);v:=a0[lane*4+0];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
            if tk1<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk1,nr),rl);v:=a0[lane*4+1];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
        }
        if rh<nr {
            if tk0<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk0,nr),rh);v:=a0[lane*4+2];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
            if tk1<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk1,nr),rh);v:=a0[lane*4+3];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
        }
        if has1 {
            tk2:=add_wrap(tk0,8);tk3:=add_wrap(tk2,1);
            if rl<nr {
                if tk2<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk2,nr),rl);v:=a1[lane*4+0];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
                if tk3<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk3,nr),rl);v:=a1[lane*4+1];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
            }
            if rh<nr {
                if tk2<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk2,nr),rh);v:=a1[lane*4+2];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
                if tk3<ntoks {oi:=cast(int)add_wrap(mul_wrap(tk3,nr),rh);v:=a1[lane*4+3];if add!=0 {out[oi]=out[oi]+v;} else {out[oi]=v;}}
            }
        }
    }
}

// Fused attention projections Tensor Core GEMM: runs all n_mats Q8_0 matrices
// in `desc` in one launch. Each warp computes 16 rows by up to 32 tokens (4 x 8)
// with explicit accumulators a0..a3 (zero local-memory spills).
// desc word 9 holds each matrix's cumulative end of 16-row tiles.
// Launch warps = rtiles_total * ceil(tokens / 32).
ink_proj_mma :: (item:int,n_mats:int,rtiles_total:int,cols:int,tokens:int,desc:[]u32,wq:[]u32,wd:[]u16,xb:[]u32,out:[]f32) #export_c #effects(all) {
    rt:=cast(u32)(item%rtiles_total);
    t0:=cast(u32)((item/rtiles_total)*32);
    nm:=cast(u32)n_mats;m:u32=0;first:u32=0;
    for i:cast(u32)0..<nm {
        e:=desc[cast(int)add_wrap(mul_wrap(i,10),9)];
        if rt>=e {m=add_wrap(i,1);first=e;}
    }
    if m<nm {
        at:=cast(int)mul_wrap(m,10);
        q0:=desc[at];d0:=desc[at+1];nr:=desc[at+2];lr:=desc[at+3];
        xb0:=desc[at+4]/2;out0:=desc[at+5];
        r0:=mul_wrap(rt-first,16);
        blocks:=cast(u32)cols/32;half:=cast(u32)cols/2;ntoks:=cast(u32)tokens;
        has1:=add_wrap(t0,8)<ntoks;has2:=add_wrap(t0,16)<ntoks;has3:=add_wrap(t0,24)<ntoks;
        fa0:[128]u32;fa1:[128]u32;fb0:[64]u32;fb1:[64]u32;fc:[128]f32;
        a0:[128]f32;a1:[128]f32;a2:[128]f32;a3:[128]f32;ds:[64]f32;
        for b:cast(u32)0..<blocks {
            qbase:=add_wrap(q0,mul_wrap(mul_wrap(b,8),lr));
            dbase:=add_wrap(d0,mul_wrap(b,lr));
            for lane:0..<32 {
                g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
                wo:=t/2;sh:=(t&1)*16;
                rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
                if rl<nr {
                    ds[lane*2+0]=ink_half(cast(u32)wd[cast(int)add_wrap(dbase,rl)]);
                    fa0[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(wo,lr)),rl)]>>sh)&0xffff);
                    fa0[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,2),lr)),rl)]>>sh)&0xffff);
                    fa1[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,4),lr)),rl)]>>sh)&0xffff);
                    fa1[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,6),lr)),rl)]>>sh)&0xffff);
                } else {
                    ds[lane*2+0]=0.0f32;fa0[lane*4+0]=0;fa0[lane*4+2]=0;fa1[lane*4+0]=0;fa1[lane*4+2]=0;
                }
                if rh<nr {
                    ds[lane*2+1]=ink_half(cast(u32)wd[cast(int)add_wrap(dbase,rh)]);
                    fa0[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(wo,lr)),rh)]>>sh)&0xffff);
                    fa0[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,2),lr)),rh)]>>sh)&0xffff);
                    fa1[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,4),lr)),rh)]>>sh)&0xffff);
                    fa1[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qbase,mul_wrap(add_wrap(wo,6),lr)),rh)]>>sh)&0xffff);
                } else {
                    ds[lane*2+1]=0.0f32;fa0[lane*4+1]=0;fa0[lane*4+3]=0;fa1[lane*4+1]=0;fa1[lane*4+3]=0;
                }
            }
            // Tile 0: t0 .. t0+7
            for lane:0..<32 {
                g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
                tk:=add_wrap(t0,g);
                if tk<ntoks {
                    base:=add_wrap(xb0,add_wrap(mul_wrap(tk,half),add_wrap(mul_wrap(b,16),t)));
                    fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                    fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                } else {
                    fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
                fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
            }
            cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
            cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
            for lane:0..<32 {
                dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                a0[lane*4+0]+=dl*fc[lane*4+0];a0[lane*4+1]+=dl*fc[lane*4+1];
                a0[lane*4+2]+=dh*fc[lane*4+2];a0[lane*4+3]+=dh*fc[lane*4+3];
            }
            // Tile 1: t0+8 .. t0+15
            if has1 {
                for lane:0..<32 {
                    g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
                    tk:=add_wrap(add_wrap(t0,8),g);
                    if tk<ntoks {
                        base:=add_wrap(xb0,add_wrap(mul_wrap(tk,half),add_wrap(mul_wrap(b,16),t)));
                        fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                        fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                    } else {
                        fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                    }
                    fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
                }
                cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
                cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
                for lane:0..<32 {
                    dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                    a1[lane*4+0]+=dl*fc[lane*4+0];a1[lane*4+1]+=dl*fc[lane*4+1];
                    a1[lane*4+2]+=dh*fc[lane*4+2];a1[lane*4+3]+=dh*fc[lane*4+3];
                }
            }
            // Tile 2: t0+16 .. t0+23
            if has2 {
                for lane:0..<32 {
                    g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
                    tk:=add_wrap(add_wrap(t0,16),g);
                    if tk<ntoks {
                        base:=add_wrap(xb0,add_wrap(mul_wrap(tk,half),add_wrap(mul_wrap(b,16),t)));
                        fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                        fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                    } else {
                        fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                    }
                    fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
                }
                cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
                cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
                for lane:0..<32 {
                    dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                    a2[lane*4+0]+=dl*fc[lane*4+0];a2[lane*4+1]+=dl*fc[lane*4+1];
                    a2[lane*4+2]+=dh*fc[lane*4+2];a2[lane*4+3]+=dh*fc[lane*4+3];
                }
            }
            // Tile 3: t0+24 .. t0+31
            if has3 {
                for lane:0..<32 {
                    g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
                    tk:=add_wrap(add_wrap(t0,24),g);
                    if tk<ntoks {
                        base:=add_wrap(xb0,add_wrap(mul_wrap(tk,half),add_wrap(mul_wrap(b,16),t)));
                        fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                        fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                    } else {
                        fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                    }
                    fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
                }
                cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
                cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
                for lane:0..<32 {
                    dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                    a3[lane*4+0]+=dl*fc[lane*4+0];a3[lane*4+1]+=dl*fc[lane*4+1];
                    a3[lane*4+2]+=dh*fc[lane*4+2];a3[lane*4+3]+=dh*fc[lane*4+3];
                }
            }
        }
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            tk0:=add_wrap(t0,mul_wrap(t,2));tk1:=add_wrap(tk0,1);
            if rl<nr {
                if tk0<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk0,nr),rl))]=a0[lane*4+0];}
                if tk1<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk1,nr),rl))]=a0[lane*4+1];}
            }
            if rh<nr {
                if tk0<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk0,nr),rh))]=a0[lane*4+2];}
                if tk1<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk1,nr),rh))]=a0[lane*4+3];}
            }
            if has1 {
                tk2:=add_wrap(tk0,8);tk3:=add_wrap(tk2,1);
                if rl<nr {
                    if tk2<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk2,nr),rl))]=a1[lane*4+0];}
                    if tk3<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk3,nr),rl))]=a1[lane*4+1];}
                }
                if rh<nr {
                    if tk2<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk2,nr),rh))]=a1[lane*4+2];}
                    if tk3<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk3,nr),rh))]=a1[lane*4+3];}
                }
            }
            if has2 {
                tk4:=add_wrap(tk0,16);tk5:=add_wrap(tk4,1);
                if rl<nr {
                    if tk4<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk4,nr),rl))]=a2[lane*4+0];}
                    if tk5<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk5,nr),rl))]=a2[lane*4+1];}
                }
                if rh<nr {
                    if tk4<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk4,nr),rh))]=a2[lane*4+2];}
                    if tk5<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk5,nr),rh))]=a2[lane*4+3];}
                }
            }
            if has3 {
                tk6:=add_wrap(tk0,24);tk7:=add_wrap(tk6,1);
                if rl<nr {
                    if tk6<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk6,nr),rl))]=a3[lane*4+0];}
                    if tk7<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk7,nr),rl))]=a3[lane*4+1];}
                }
                if rh<nr {
                    if tk6<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk6,nr),rh))]=a3[lane*4+2];}
                    if tk7<ntoks {out[cast(int)add_wrap(out0,add_wrap(mul_wrap(tk7,nr),rh))]=a3[lane*4+3];}
                }
            }
        }
    }
}

// Grouped IQ4_NL MoE gate_up Tensor Core GEMM (16 rows x up to 16 tokens per task).
// Launch warps = n_tasks * ceil(2*n_ff / 16). Zero local-memory spills.
ink_moe_gu_iq4_mma :: (item:int,n_ff:int,cols:int,wq:[]u32,wd:[]u16,xb:[]u32,task_slot:[]u32,task_base:[]u32,task_cnt:[]u32,sorted_tok:[]u32,out:[]f32) #export_c #effects(all) {
    nr:=mul_wrap(cast(u32)n_ff,2);
    rtiles:=(nr+15)/16;
    gi:=cast(u32)item;
    tk_idx:=gi/rtiles;
    r0:=mul_wrap(gi%rtiles,16);
    blocks:=cast(u32)cols/32;half:=cast(u32)cols/2;
    cells:=mul_wrap(nr,blocks);
    slot:=task_slot[cast(int)tk_idx];
    tbase:=task_base[cast(int)tk_idx];
    tcnt:=task_cnt[cast(int)tk_idx];
    has1:=tcnt>8;
    qb:=mul_wrap(slot,add_wrap(mul_wrap(cells,4),cells/2));
    db:=add_wrap(mul_wrap(slot,mul_wrap(cells,9)),mul_wrap(cells,8));
    tok0:[32]u32;tok1:[32]u32;
    for lane:0..<32 {
        g:=cast(u32)(lane/4);
        tok0[lane*1]=ifx g<tcnt then sorted_tok[cast(int)add_wrap(tbase,g)] else 0xffffffff;
        g1:=add_wrap(g,8);
        tok1[lane*1]=ifx g1<tcnt then sorted_tok[cast(int)add_wrap(tbase,g1)] else 0xffffffff;
    }
    fa0:[128]u32;fa1:[128]u32;fb0:[64]u32;fb1:[64]u32;fc:[128]f32;
    a0:[128]f32;a1:[128]f32;ds:[64]f32;
    for b:cast(u32)0..<blocks {
        qblk:=add_wrap(qb,mul_wrap(mul_wrap(b,4),nr));
        dblk:=add_wrap(db,mul_wrap(b,nr));
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            wo:=t/2;sh:=(t&1)*16;
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            d_l:u32=0;w0_l:u32=0;w2_l:u32=0;d_h:u32=0;w0_h:u32=0;w2_h:u32=0;
            if rl<nr {
                d_l=cast(u32)wd[cast(int)add_wrap(dblk,rl)];
                w0_l=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rl)];
                w2_l=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rl)];
            }
            if rh<nr {
                d_h=cast(u32)wd[cast(int)add_wrap(dblk,rh)];
                w0_h=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rh)];
                w2_h=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rh)];
            }
            if rl<nr {
                ds[lane*2+0]=ink_half(d_l);
                u0:=(w0_l>>sh)&0xffff;u2:=(w2_l>>sh)&0xffff;
                fa0[lane*4+0]=ink_iq4_bf16(u0&15)|(ink_iq4_bf16((u0>>8)&15)<<16);
                fa0[lane*4+2]=ink_iq4_bf16(u2&15)|(ink_iq4_bf16((u2>>8)&15)<<16);
                fa1[lane*4+0]=ink_iq4_bf16((u0>>4)&15)|(ink_iq4_bf16(u0>>12)<<16);
                fa1[lane*4+2]=ink_iq4_bf16((u2>>4)&15)|(ink_iq4_bf16(u2>>12)<<16);
            } else {
                ds[lane*2+0]=0.0f32;fa0[lane*4+0]=0;fa0[lane*4+2]=0;fa1[lane*4+0]=0;fa1[lane*4+2]=0;
            }
            if rh<nr {
                ds[lane*2+1]=ink_half(d_h);
                u0:=(w0_h>>sh)&0xffff;u2:=(w2_h>>sh)&0xffff;
                fa0[lane*4+1]=ink_iq4_bf16(u0&15)|(ink_iq4_bf16((u0>>8)&15)<<16);
                fa0[lane*4+3]=ink_iq4_bf16(u2&15)|(ink_iq4_bf16((u2>>8)&15)<<16);
                fa1[lane*4+1]=ink_iq4_bf16((u0>>4)&15)|(ink_iq4_bf16(u0>>12)<<16);
                fa1[lane*4+3]=ink_iq4_bf16((u2>>4)&15)|(ink_iq4_bf16(u2>>12)<<16);
            } else {
                ds[lane*2+1]=0.0f32;fa0[lane*4+1]=0;fa0[lane*4+3]=0;fa1[lane*4+1]=0;fa1[lane*4+3]=0;
            }
        }
        for lane:0..<32 {
            t:=cast(u32)(lane%4);tid:=tok0[lane*1];
            if tid!=0xffffffff {
                base:=add_wrap(mul_wrap(tid,half),add_wrap(mul_wrap(b,16),t));
                fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
            } else {
                fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
            }
            fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
        }
        cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
        cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
        for lane:0..<32 {
            dl:=ds[lane*2+0];dh:=ds[lane*2+1];
            a0[lane*4+0]+=dl*fc[lane*4+0];a0[lane*4+1]+=dl*fc[lane*4+1];
            a0[lane*4+2]+=dh*fc[lane*4+2];a0[lane*4+3]+=dh*fc[lane*4+3];
        }
        if has1 {
            for lane:0..<32 {
                t:=cast(u32)(lane%4);tid:=tok1[lane*1];
                if tid!=0xffffffff {
                    base:=add_wrap(mul_wrap(tid,half),add_wrap(mul_wrap(b,16),t));
                    fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                    fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                } else {
                    fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
                fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
            }
            cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
            cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
            for lane:0..<32 {
                dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                a1[lane*4+0]+=dl*fc[lane*4+0];a1[lane*4+1]+=dl*fc[lane*4+1];
                a1[lane*4+2]+=dh*fc[lane*4+2];a1[lane*4+3]+=dh*fc[lane*4+3];
            }
        }
    }
    for lane:0..<32 {
        g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
        rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
        c0:=mul_wrap(t,2);c1:=add_wrap(c0,1);
        if rl<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c0),nr),rl)]=a0[lane*4+0];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c1),nr),rl)]=a0[lane*4+1];}
        }
        if rh<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c0),nr),rh)]=a0[lane*4+2];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c1),nr),rh)]=a0[lane*4+3];}
        }
        if has1 {
            c2:=add_wrap(c0,8);c3:=add_wrap(c2,1);
            if rl<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c2),nr),rl)]=a1[lane*4+0];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c3),nr),rl)]=a1[lane*4+1];}
            }
            if rh<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c2),nr),rh)]=a1[lane*4+2];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c3),nr),rh)]=a1[lane*4+3];}
            }
        }
    }
}

// Grouped Q8_0 MoE gate_up Tensor Core GEMM (16 rows x up to 16 tokens per task).
// Launch warps = n_tasks * ceil(2*n_ff / 16). Zero local-memory spills.
ink_moe_gu_q8_mma :: (item:int,n_ff:int,cols:int,wq:[]u32,wd:[]u16,xb:[]u32,task_slot:[]u32,task_base:[]u32,task_cnt:[]u32,sorted_tok:[]u32,out:[]f32) #export_c #effects(all) {
    nr:=mul_wrap(cast(u32)n_ff,2);
    rtiles:=(nr+15)/16;
    gi:=cast(u32)item;
    tk_idx:=gi/rtiles;
    r0:=mul_wrap(gi%rtiles,16);
    blocks:=cast(u32)cols/32;half:=cast(u32)cols/2;
    cells:=mul_wrap(nr,blocks);
    slot:=task_slot[cast(int)tk_idx];
    tbase:=task_base[cast(int)tk_idx];
    tcnt:=task_cnt[cast(int)tk_idx];
    has1:=tcnt>8;
    qb:=mul_wrap(slot,add_wrap(mul_wrap(cells,8),cells/2));
    db:=add_wrap(mul_wrap(slot,mul_wrap(cells,17)),mul_wrap(cells,16));
    tok0:[32]u32;tok1:[32]u32;
    for lane:0..<32 {
        g:=cast(u32)(lane/4);
        tok0[lane*1]=ifx g<tcnt then sorted_tok[cast(int)add_wrap(tbase,g)] else 0xffffffff;
        g1:=add_wrap(g,8);
        tok1[lane*1]=ifx g1<tcnt then sorted_tok[cast(int)add_wrap(tbase,g1)] else 0xffffffff;
    }
    fa0:[128]u32;fa1:[128]u32;fb0:[64]u32;fb1:[64]u32;fc:[128]f32;
    a0:[128]f32;a1:[128]f32;ds:[64]f32;
    for b:cast(u32)0..<blocks {
        qblk:=add_wrap(qb,mul_wrap(mul_wrap(b,8),nr));
        dblk:=add_wrap(db,mul_wrap(b,nr));
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            wo:=t/2;sh:=(t&1)*16;
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            if rl<nr {
                ds[lane*2+0]=ink_half(cast(u32)wd[cast(int)add_wrap(dblk,rl)]);
                fa0[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rl)]>>sh)&0xffff);
                fa0[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rl)]>>sh)&0xffff);
                fa1[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,4),nr)),rl)]>>sh)&0xffff);
                fa1[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,6),nr)),rl)]>>sh)&0xffff);
            } else {
                ds[lane*2+0]=0.0f32;fa0[lane*4+0]=0;fa0[lane*4+2]=0;fa1[lane*4+0]=0;fa1[lane*4+2]=0;
            }
            if rh<nr {
                ds[lane*2+1]=ink_half(cast(u32)wd[cast(int)add_wrap(dblk,rh)]);
                fa0[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rh)]>>sh)&0xffff);
                fa0[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rh)]>>sh)&0xffff);
                fa1[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,4),nr)),rh)]>>sh)&0xffff);
                fa1[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,6),nr)),rh)]>>sh)&0xffff);
            } else {
                ds[lane*2+1]=0.0f32;fa0[lane*4+1]=0;fa0[lane*4+3]=0;fa1[lane*4+1]=0;fa1[lane*4+3]=0;
            }
        }
        for lane:0..<32 {
            t:=cast(u32)(lane%4);tid:=tok0[lane*1];
            if tid!=0xffffffff {
                base:=add_wrap(mul_wrap(tid,half),add_wrap(mul_wrap(b,16),t));
                fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
            } else {
                fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
            }
            fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
        }
        cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
        cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
        for lane:0..<32 {
            dl:=ds[lane*2+0];dh:=ds[lane*2+1];
            a0[lane*4+0]+=dl*fc[lane*4+0];a0[lane*4+1]+=dl*fc[lane*4+1];
            a0[lane*4+2]+=dh*fc[lane*4+2];a0[lane*4+3]+=dh*fc[lane*4+3];
        }
        if has1 {
            for lane:0..<32 {
                t:=cast(u32)(lane%4);tid:=tok1[lane*1];
                if tid!=0xffffffff {
                    base:=add_wrap(mul_wrap(tid,half),add_wrap(mul_wrap(b,16),t));
                    fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                    fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                } else {
                    fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
                fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
            }
            cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
            cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
            for lane:0..<32 {
                dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                a1[lane*4+0]+=dl*fc[lane*4+0];a1[lane*4+1]+=dl*fc[lane*4+1];
                a1[lane*4+2]+=dh*fc[lane*4+2];a1[lane*4+3]+=dh*fc[lane*4+3];
            }
        }
    }
    for lane:0..<32 {
        g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
        rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
        c0:=mul_wrap(t,2);c1:=add_wrap(c0,1);
        if rl<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c0),nr),rl)]=a0[lane*4+0];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c1),nr),rl)]=a0[lane*4+1];}
        }
        if rh<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c0),nr),rh)]=a0[lane*4+2];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c1),nr),rh)]=a0[lane*4+3];}
        }
        if has1 {
            c2:=add_wrap(c0,8);c3:=add_wrap(c2,1);
            if rl<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c2),nr),rl)]=a1[lane*4+0];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c3),nr),rl)]=a1[lane*4+1];}
            }
            if rh<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c2),nr),rh)]=a1[lane*4+2];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(add_wrap(tbase,c3),nr),rh)]=a1[lane*4+3];}
            }
        }
    }
}

// Apply SITU activation + router weight to grouped gate_up outputs and pack
// directly into BF16 pairs for ink_moe_down_*_mma.
// Launch items = n_entries * (n_ff / 2).
ink_moe_situ_pack :: (item:int,n_entries:int,n_ff:int,beta:f32,lb:f32,gu:[]f32,sorted_pair:[]u32,wts:[]f32,out_bf16:[]u32) #export_c #effects(all) {
    half:=cast(u32)n_ff/2;
    gi:=cast(u32)item;
    ent:=gi/half;
    if ent<cast(u32)n_entries {
        j:=gi%half;
        ew:=wts[cast(int)sorted_pair[cast(int)ent]];
        base:=add_wrap(mul_wrap(ent,mul_wrap(cast(u32)n_ff,2)),mul_wrap(j,4));
        g0:=gu[cast(int)base];u0:=gu[cast(int)add_wrap(base,1)];
        g1:=gu[cast(int)add_wrap(base,2)];u1:=gu[cast(int)add_wrap(base,3)];
        a0:=beta*ink_tanh(g0/beta)*ink_sigmoid(g0);
        if lb>0.0f32 {u0=lb*ink_tanh(u0/lb);}
        a1:=beta*ink_tanh(g1/beta)*ink_sigmoid(g1);
        if lb>0.0f32 {u1=lb*ink_tanh(u1/lb);}
        out_bf16[item]=ink_bf16_rne(a0*u0*ew)|(ink_bf16_rne(a1*u1*ew)<<16);
    }
}

// Grouped IQ4_NL MoE down Tensor Core GEMM (16 rows x up to 16 tokens per task).
// Launch warps = n_tasks * ceil(rows / 16). Zero local-memory spills.
ink_moe_down_iq4_mma :: (item:int,rows:int,cols:int,wq:[]u32,wd:[]u16,xb:[]u32,task_slot:[]u32,task_base:[]u32,task_cnt:[]u32,sorted_pair:[]u32,out:[]f32) #export_c #effects(all) {
    nr:=cast(u32)rows;
    rtiles:=(nr+15)/16;
    gi:=cast(u32)item;
    tk_idx:=gi/rtiles;
    r0:=mul_wrap(gi%rtiles,16);
    blocks:=cast(u32)cols/32;half:=cast(u32)cols/2;
    cells:=mul_wrap(nr,blocks);
    slot:=task_slot[cast(int)tk_idx];
    tbase:=task_base[cast(int)tk_idx];
    tcnt:=task_cnt[cast(int)tk_idx];
    has1:=tcnt>8;
    qb:=mul_wrap(slot,add_wrap(mul_wrap(cells,4),cells/2));
    db:=add_wrap(mul_wrap(slot,mul_wrap(cells,9)),mul_wrap(cells,8));
    fa0:[128]u32;fa1:[128]u32;fb0:[64]u32;fb1:[64]u32;fc:[128]f32;
    a0:[128]f32;a1:[128]f32;ds:[64]f32;
    for b:cast(u32)0..<blocks {
        qblk:=add_wrap(qb,mul_wrap(mul_wrap(b,4),nr));
        dblk:=add_wrap(db,mul_wrap(b,nr));
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            wo:=t/2;sh:=(t&1)*16;
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            d_l:u32=0;w0_l:u32=0;w2_l:u32=0;d_h:u32=0;w0_h:u32=0;w2_h:u32=0;
            if rl<nr {
                d_l=cast(u32)wd[cast(int)add_wrap(dblk,rl)];
                w0_l=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rl)];
                w2_l=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rl)];
            }
            if rh<nr {
                d_h=cast(u32)wd[cast(int)add_wrap(dblk,rh)];
                w0_h=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rh)];
                w2_h=wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rh)];
            }
            if rl<nr {
                ds[lane*2+0]=ink_half(d_l);
                u0:=(w0_l>>sh)&0xffff;u2:=(w2_l>>sh)&0xffff;
                fa0[lane*4+0]=ink_iq4_bf16(u0&15)|(ink_iq4_bf16((u0>>8)&15)<<16);
                fa0[lane*4+2]=ink_iq4_bf16(u2&15)|(ink_iq4_bf16((u2>>8)&15)<<16);
                fa1[lane*4+0]=ink_iq4_bf16((u0>>4)&15)|(ink_iq4_bf16(u0>>12)<<16);
                fa1[lane*4+2]=ink_iq4_bf16((u2>>4)&15)|(ink_iq4_bf16(u2>>12)<<16);
            } else {
                ds[lane*2+0]=0.0f32;fa0[lane*4+0]=0;fa0[lane*4+2]=0;fa1[lane*4+0]=0;fa1[lane*4+2]=0;
            }
            if rh<nr {
                ds[lane*2+1]=ink_half(d_h);
                u0:=(w0_h>>sh)&0xffff;u2:=(w2_h>>sh)&0xffff;
                fa0[lane*4+1]=ink_iq4_bf16(u0&15)|(ink_iq4_bf16((u0>>8)&15)<<16);
                fa0[lane*4+3]=ink_iq4_bf16(u2&15)|(ink_iq4_bf16((u2>>8)&15)<<16);
                fa1[lane*4+1]=ink_iq4_bf16((u0>>4)&15)|(ink_iq4_bf16(u0>>12)<<16);
                fa1[lane*4+3]=ink_iq4_bf16((u2>>4)&15)|(ink_iq4_bf16(u2>>12)<<16);
            } else {
                ds[lane*2+1]=0.0f32;fa0[lane*4+1]=0;fa0[lane*4+3]=0;fa1[lane*4+1]=0;fa1[lane*4+3]=0;
            }
        }
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            if g<tcnt {
                base:=add_wrap(mul_wrap(add_wrap(tbase,g),half),add_wrap(mul_wrap(b,16),t));
                fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
            } else {
                fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
            }
            fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
        }
        cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
        cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
        for lane:0..<32 {
            dl:=ds[lane*2+0];dh:=ds[lane*2+1];
            a0[lane*4+0]+=dl*fc[lane*4+0];a0[lane*4+1]+=dl*fc[lane*4+1];
            a0[lane*4+2]+=dh*fc[lane*4+2];a0[lane*4+3]+=dh*fc[lane*4+3];
        }
        if has1 {
            for lane:0..<32 {
                g:=add_wrap(cast(u32)(lane/4),8);t:=cast(u32)(lane%4);
                if g<tcnt {
                    base:=add_wrap(mul_wrap(add_wrap(tbase,g),half),add_wrap(mul_wrap(b,16),t));
                    fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                    fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                } else {
                    fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
                fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
            }
            cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
            cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
            for lane:0..<32 {
                dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                a1[lane*4+0]+=dl*fc[lane*4+0];a1[lane*4+1]+=dl*fc[lane*4+1];
                a1[lane*4+2]+=dh*fc[lane*4+2];a1[lane*4+3]+=dh*fc[lane*4+3];
            }
        }
    }
    for lane:0..<32 {
        g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
        rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
        c0:=mul_wrap(t,2);c1:=add_wrap(c0,1);
        p0:u32=ifx c0<tcnt then sorted_pair[cast(int)add_wrap(tbase,c0)] else 0;
        p1:u32=ifx c1<tcnt then sorted_pair[cast(int)add_wrap(tbase,c1)] else 0;
        if rl<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(p0,nr),rl)]=a0[lane*4+0];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(p1,nr),rl)]=a0[lane*4+1];}
        }
        if rh<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(p0,nr),rh)]=a0[lane*4+2];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(p1,nr),rh)]=a0[lane*4+3];}
        }
        if has1 {
            c2:=add_wrap(c0,8);c3:=add_wrap(c2,1);
            p2:u32=ifx c2<tcnt then sorted_pair[cast(int)add_wrap(tbase,c2)] else 0;
            p3:u32=ifx c3<tcnt then sorted_pair[cast(int)add_wrap(tbase,c3)] else 0;
            if rl<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(p2,nr),rl)]=a1[lane*4+0];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(p3,nr),rl)]=a1[lane*4+1];}
            }
            if rh<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(p2,nr),rh)]=a1[lane*4+2];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(p3,nr),rh)]=a1[lane*4+3];}
            }
        }
    }
}

// Grouped Q8_0 MoE down Tensor Core GEMM (16 rows x up to 16 tokens per task).
// Launch warps = n_tasks * ceil(rows / 16). Zero local-memory spills.
ink_moe_down_q8_mma :: (item:int,rows:int,cols:int,wq:[]u32,wd:[]u16,xb:[]u32,task_slot:[]u32,task_base:[]u32,task_cnt:[]u32,sorted_pair:[]u32,out:[]f32) #export_c #effects(all) {
    nr:=cast(u32)rows;
    rtiles:=(nr+15)/16;
    gi:=cast(u32)item;
    tk_idx:=gi/rtiles;
    r0:=mul_wrap(gi%rtiles,16);
    blocks:=cast(u32)cols/32;half:=cast(u32)cols/2;
    cells:=mul_wrap(nr,blocks);
    slot:=task_slot[cast(int)tk_idx];
    tbase:=task_base[cast(int)tk_idx];
    tcnt:=task_cnt[cast(int)tk_idx];
    has1:=tcnt>8;
    qb:=mul_wrap(slot,add_wrap(mul_wrap(cells,8),cells/2));
    db:=add_wrap(mul_wrap(slot,mul_wrap(cells,17)),mul_wrap(cells,16));
    fa0:[128]u32;fa1:[128]u32;fb0:[64]u32;fb1:[64]u32;fc:[128]f32;
    a0:[128]f32;a1:[128]f32;ds:[64]f32;
    for b:cast(u32)0..<blocks {
        qblk:=add_wrap(qb,mul_wrap(mul_wrap(b,8),nr));
        dblk:=add_wrap(db,mul_wrap(b,nr));
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            wo:=t/2;sh:=(t&1)*16;
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            if rl<nr {
                ds[lane*2+0]=ink_half(cast(u32)wd[cast(int)add_wrap(dblk,rl)]);
                fa0[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rl)]>>sh)&0xffff);
                fa0[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rl)]>>sh)&0xffff);
                fa1[lane*4+0]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,4),nr)),rl)]>>sh)&0xffff);
                fa1[lane*4+2]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,6),nr)),rl)]>>sh)&0xffff);
            } else {
                ds[lane*2+0]=0.0f32;fa0[lane*4+0]=0;fa0[lane*4+2]=0;fa1[lane*4+0]=0;fa1[lane*4+2]=0;
            }
            if rh<nr {
                ds[lane*2+1]=ink_half(cast(u32)wd[cast(int)add_wrap(dblk,rh)]);
                fa0[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(wo,nr)),rh)]>>sh)&0xffff);
                fa0[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,2),nr)),rh)]>>sh)&0xffff);
                fa1[lane*4+1]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,4),nr)),rh)]>>sh)&0xffff);
                fa1[lane*4+3]=ink_q8_pair_bf16((wq[cast(int)add_wrap(add_wrap(qblk,mul_wrap(add_wrap(wo,6),nr)),rh)]>>sh)&0xffff);
            } else {
                ds[lane*2+1]=0.0f32;fa0[lane*4+1]=0;fa0[lane*4+3]=0;fa1[lane*4+1]=0;fa1[lane*4+3]=0;
            }
        }
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            if g<tcnt {
                base:=add_wrap(mul_wrap(add_wrap(tbase,g),half),add_wrap(mul_wrap(b,16),t));
                fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
            } else {
                fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
            }
            fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
        }
        cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
        cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
        for lane:0..<32 {
            dl:=ds[lane*2+0];dh:=ds[lane*2+1];
            a0[lane*4+0]+=dl*fc[lane*4+0];a0[lane*4+1]+=dl*fc[lane*4+1];
            a0[lane*4+2]+=dh*fc[lane*4+2];a0[lane*4+3]+=dh*fc[lane*4+3];
        }
        if has1 {
            for lane:0..<32 {
                g:=add_wrap(cast(u32)(lane/4),8);t:=cast(u32)(lane%4);
                if g<tcnt {
                    base:=add_wrap(mul_wrap(add_wrap(tbase,g),half),add_wrap(mul_wrap(b,16),t));
                    fb0[lane*2+0]=xb[cast(int)base];fb0[lane*2+1]=xb[cast(int)add_wrap(base,4)];
                    fb1[lane*2+0]=xb[cast(int)add_wrap(base,8)];fb1[lane*2+1]=xb[cast(int)add_wrap(base,12)];
                } else {
                    fb0[lane*2+0]=0;fb0[lane*2+1]=0;fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
                fc[lane*4+0]=0.0f32;fc[lane*4+1]=0.0f32;fc[lane*4+2]=0.0f32;fc[lane*4+3]=0.0f32;
            }
            cu_mma_bf16_16x8x16(fa0[..],fb0[..],fc[..]);
            cu_mma_bf16_16x8x16(fa1[..],fb1[..],fc[..]);
            for lane:0..<32 {
                dl:=ds[lane*2+0];dh:=ds[lane*2+1];
                a1[lane*4+0]+=dl*fc[lane*4+0];a1[lane*4+1]+=dl*fc[lane*4+1];
                a1[lane*4+2]+=dh*fc[lane*4+2];a1[lane*4+3]+=dh*fc[lane*4+3];
            }
        }
    }
    for lane:0..<32 {
        g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
        rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
        c0:=mul_wrap(t,2);c1:=add_wrap(c0,1);
        p0:u32=ifx c0<tcnt then sorted_pair[cast(int)add_wrap(tbase,c0)] else 0;
        p1:u32=ifx c1<tcnt then sorted_pair[cast(int)add_wrap(tbase,c1)] else 0;
        if rl<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(p0,nr),rl)]=a0[lane*4+0];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(p1,nr),rl)]=a0[lane*4+1];}
        }
        if rh<nr {
            if c0<tcnt {out[cast(int)add_wrap(mul_wrap(p0,nr),rh)]=a0[lane*4+2];}
            if c1<tcnt {out[cast(int)add_wrap(mul_wrap(p1,nr),rh)]=a0[lane*4+3];}
        }
        if has1 {
            c2:=add_wrap(c0,8);c3:=add_wrap(c2,1);
            p2:u32=ifx c2<tcnt then sorted_pair[cast(int)add_wrap(tbase,c2)] else 0;
            p3:u32=ifx c3<tcnt then sorted_pair[cast(int)add_wrap(tbase,c3)] else 0;
            if rl<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(p2,nr),rl)]=a1[lane*4+0];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(p3,nr),rl)]=a1[lane*4+1];}
            }
            if rh<nr {
                if c2<tcnt {out[cast(int)add_wrap(mul_wrap(p2,nr),rh)]=a1[lane*4+2];}
                if c3<tcnt {out[cast(int)add_wrap(mul_wrap(p3,nr),rh)]=a1[lane*4+3];}
            }
        }
    }
}

// Sum each token's n_used expert down outputs in deterministic slot order,
// apply post shortconv, and add to residual cur. Launch items = n_channels.
ink_moe_reduce_post :: (item:int,n_channels:int,nb:int,n_used:int,down_out:[]f32,w:[]f32,hist:[]f32,cur:[]f32) #export_c #effects(all) {
    if item<n_channels {
        c:=cast(u32)item;nc:=cast(u32)n_channels;nu:=cast(u32)n_used;
        h0:=mul_wrap(c,3);w_at:=mul_wrap(c,4);
        x0:=hist[cast(int)h0];x1:=hist[cast(int)add_wrap(h0,1)];x2:=hist[cast(int)add_wrap(h0,2)];
        w0:=w[cast(int)w_at];w1:=w[cast(int)add_wrap(w_at,1)];w2:=w[cast(int)add_wrap(w_at,2)];w3:=w[cast(int)add_wrap(w_at,3)];
        inv_s5:=1.0f32/sqrt(5.0f32);
        for b:cast(u32)0..<cast(u32)nb {
            x3:f32=0.0f32;
            pbase:=add_wrap(mul_wrap(mul_wrap(b,nu),nc),c);
            if nu==8 {
                v0:=down_out[cast(int)pbase];
                v1:=down_out[cast(int)add_wrap(pbase,nc)];
                v2:=down_out[cast(int)add_wrap(pbase,mul_wrap(nc,2))];
                v3:=down_out[cast(int)add_wrap(pbase,mul_wrap(nc,3))];
                v4:=down_out[cast(int)add_wrap(pbase,mul_wrap(nc,4))];
                v5:=down_out[cast(int)add_wrap(pbase,mul_wrap(nc,5))];
                v6:=down_out[cast(int)add_wrap(pbase,mul_wrap(nc,6))];
                v7:=down_out[cast(int)add_wrap(pbase,mul_wrap(nc,7))];
                x3=(((v0+v1)+(v2+v3))+((v4+v5)+(v6+v7)));
            } else {
                for k:cast(u32)0..<nu {x3+=down_out[cast(int)add_wrap(pbase,mul_wrap(k,nc))];}
            }
            acc:=x0*w0+x1*w1+x2*w2+x3*w3;
            ci:=cast(int)add_wrap(mul_wrap(b,nc),c);
            cur[ci]=cur[ci]+(x3+acc)*inv_s5;
            x0=x1;x1=x2;x2=x3;
        }
        hist[cast(int)h0]=x0;hist[cast(int)add_wrap(h0,1)]=x1;hist[cast(int)add_wrap(h0,2)]=x2;
    }
}

// =========================================================================
// Batched Tensor Core cross-pass recurrence gate (ink_ctrl_pack_bf16,
// ink_ctrl_gate_mma, ink_ctrl_out_mma): reads D, G, F once per batch instead
// of once per token (64x-128x less DRAM traffic in prefill).
// =========================================================================

// Pack [rms(cur), rms(msg)] for (cl, tok) into out_bf16[item * dim + 0..dim-1]
// (each u32 holds 2 BF16 values -> 2*dim BF16 elements per (cl, tok)).
// Launch items = n * np, group of INK_NT=256 threads.
ink_ctrl_pack_bf16 :: (item:int,dim:int,np:int,stack:int,flags:int,cur:[]f32,msg:[]f32,out_bf16:[]u32) #export_c #effects(all) {
    pc:[256]f32;pm:[256]f32;mc:[16]f32;mm:[16]f32;
    swa:=flags&255;c0:=(flags>>8)&255;
    cl:=item/np;tok:=item%np;
    cb:=(ifx swa!=0 then 0 else cl)*stack+tok*dim;
    gb:=(c0+cl)*stack+tok*dim;
    half:=dim/2;ob:=item*dim;
    for thread:0..<INK_NT {
        sc:f32=0.0f32;sm:f32=0.0f32;
        for k:0..<(dim+INK_NT-1)/INK_NT {
            i:=k*INK_NT+thread;
            if i<dim {
                a:=cur[cb+i];m:=msg[gb+i];
                sc+=a*a;sm+=m*m;
            }
        }
        pc[thread]=sc;pm[thread]=sm;
    }
    for thread:0..<INK_NT {
        if thread<16 {
            sc:f32=0.0f32;sm:f32=0.0f32;
            for j:0..<16 {sc+=pc[thread*16+j];sm+=pm[thread*16+j];}
            mc[thread]=sc;mm[thread]=sm;
        }
    }
    for thread:0..<INK_NT {
        tc:f32=0.0f32;tm:f32=0.0f32;
        for j:0..<16 {tc+=mc[j];tm+=mm[j];}
        inv_c:=1.0f32/sqrt(tc/f32(dim)+0.000001f32);
        inv_m:=1.0f32/sqrt(tm/f32(dim)+0.000001f32);
        for k:0..<(half+INK_NT-1)/INK_NT {
            i:=k*INK_NT+thread;
            if i<half {
                i2:=i*2;
                out_bf16[ob+i]=ink_bf16_rne(cur[cb+i2]*inv_c)|(ink_bf16_rne(cur[cb+i2+1]*inv_c)<<16);
                out_bf16[ob+half+i]=ink_bf16_rne(msg[gb+i2]*inv_m)|(ink_bf16_rne(msg[gb+i2+1]*inv_m)<<16);
            }
        }
    }
}

// Batched gate projection: gate[(cl*np + tok)*64 + r] = D_cl[r, :] . [rms(cur), rms(msg)].
// One warp computes 16 rows x up to 16 tokens (2 x 8) directly in fc0/fc1 (0 local-memory spills).
// Launch warps = n * 4 * ceil(np / 16).
ink_ctrl_gate_mma :: (item:int,dim:int,np:int,off0:int,off1:int,off2:int,arena:[]f32,xb:[]u32,gate:[]f32) #export_c #effects(all) {
    ttiles:=(np+15)/16;
    cl:=item/(4*ttiles);
    rem:=item%(4*ttiles);
    r0:=cast(u32)((rem%4)*16);
    t0:=cast(u32)((rem/4)*16);
    d_off:=cast(u32)(ifx cl==0 then off0 else ifx cl==1 then off1 else off2);
    k2:=mul_wrap(cast(u32)dim,2);
    steps:=k2/16;
    ntoks:=cast(u32)np;
    has1:=add_wrap(t0,8)<ntoks;
    xbase:=mul_wrap(cast(u32)(cl*np),cast(u32)dim);
    fa:[128]u32;fb0:[64]u32;fb1:[64]u32;fc0:[128]f32;fc1:[128]f32;
    for lane:0..<32 {
        fc0[lane*4+0]=0.0f32;fc0[lane*4+1]=0.0f32;fc0[lane*4+2]=0.0f32;fc0[lane*4+3]=0.0f32;
        fc1[lane*4+0]=0.0f32;fc1[lane*4+1]=0.0f32;fc1[lane*4+2]=0.0f32;fc1[lane*4+3]=0.0f32;
    }
    for bk:cast(u32)0..<steps {
        k0:=mul_wrap(bk,16);
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            al:=add_wrap(d_off,add_wrap(mul_wrap(rl,k2),add_wrap(k0,mul_wrap(t,2))));
            ah:=add_wrap(d_off,add_wrap(mul_wrap(rh,k2),add_wrap(k0,mul_wrap(t,2))));
            w00:=arena[cast(int)al];w01:=arena[cast(int)add_wrap(al,1)];
            w02:=arena[cast(int)add_wrap(al,8)];w03:=arena[cast(int)add_wrap(al,9)];
            w10:=arena[cast(int)ah];w11:=arena[cast(int)add_wrap(ah,1)];
            w12:=arena[cast(int)add_wrap(ah,8)];w13:=arena[cast(int)add_wrap(ah,9)];
            fa[lane*4+0]=ink_bf16_rne(w00)|(ink_bf16_rne(w01)<<16);
            fa[lane*4+1]=ink_bf16_rne(w10)|(ink_bf16_rne(w11)<<16);
            fa[lane*4+2]=ink_bf16_rne(w02)|(ink_bf16_rne(w03)<<16);
            fa[lane*4+3]=ink_bf16_rne(w12)|(ink_bf16_rne(w13)<<16);
            tk:=add_wrap(t0,g);
            if tk<ntoks {
                xb_at:=add_wrap(xbase,add_wrap(mul_wrap(tk,cast(u32)dim),add_wrap(mul_wrap(bk,8),t)));
                fb0[lane*2+0]=xb[cast(int)xb_at];
                fb0[lane*2+1]=xb[cast(int)add_wrap(xb_at,4)];
            } else {
                fb0[lane*2+0]=0;fb0[lane*2+1]=0;
            }
            if has1 {
                tk1:=add_wrap(tk,8);
                if tk1<ntoks {
                    xb_at1:=add_wrap(xbase,add_wrap(mul_wrap(tk1,cast(u32)dim),add_wrap(mul_wrap(bk,8),t)));
                    fb1[lane*2+0]=xb[cast(int)xb_at1];
                    fb1[lane*2+1]=xb[cast(int)add_wrap(xb_at1,4)];
                } else {
                    fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
            }
        }
        cu_mma_bf16_16x8x16(fa[..],fb0[..],fc0[..]);
        if has1 {cu_mma_bf16_16x8x16(fa[..],fb1[..],fc1[..]);}
    }
    gbase:=mul_wrap(cast(u32)(cl*np),64);
    for lane:0..<32 {
        g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
        rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
        tk0:=add_wrap(t0,mul_wrap(t,2));tk1:=add_wrap(tk0,1);
        if tk0<ntoks {
            gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk0,64),rl))]=fc0[lane*4+0];
            gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk0,64),rh))]=fc0[lane*4+2];
        }
        if tk1<ntoks {
            gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk1,64),rl))]=fc0[lane*4+1];
            gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk1,64),rh))]=fc0[lane*4+3];
        }
        if has1 {
            tk2:=add_wrap(tk0,8);tk3:=add_wrap(tk2,1);
            if tk2<ntoks {
                gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk2,64),rl))]=fc1[lane*4+0];
                gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk2,64),rh))]=fc1[lane*4+2];
            }
            if tk3<ntoks {
                gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk3,64),rl))]=fc1[lane*4+1];
                gate[cast(int)add_wrap(gbase,add_wrap(mul_wrap(tk3,64),rh))]=fc1[lane*4+3];
            }
        }
    }
}

// Batched gain/forget projection + fused gated recurrence apply:
// out = cur - tanh(F . gate) * cur + tanh(G . gate) * msg.
// One warp computes 16 channels x up to 16 tokens across rank 64 (4 k=16 steps).
// Launch warps = n * ceil(dim / 16) * ceil(np / 16).
ink_ctrl_out_mma :: (item:int,dim:int,np:int,stack:int,flags:int,gf0:int,gf1:int,gf2:int,arena:[]f32,cur:[]f32,msg:[]f32,gate_bf16:[]u32,out:[]f32) #export_c #effects(all) {
    swa:=flags&255;c0:=(flags>>8)&255;
    rtiles:=(dim+15)/16;ttiles:=(np+15)/16;
    cl:=item/(rtiles*ttiles);
    rem:=item%(rtiles*ttiles);
    r0:=cast(u32)((rem%rtiles)*16);
    t0:=cast(u32)((rem/rtiles)*16);
    nd:=cast(u32)dim;ntoks:=cast(u32)np;
    has1:=add_wrap(t0,8)<ntoks;
    gf:=ifx cl==0 then gf0 else ifx cl==1 then gf1 else gf2;
    gbase:=cast(u32)(gf&4294967295);fbase:=cast(u32)((gf>>32)&4294967295);
    gb_base:=mul_wrap(cast(u32)(cl*np),32);
    fg:[128]u32;ff:[128]u32;fb0:[64]u32;fb1:[64]u32;
    ga0:[128]f32;ga1:[128]f32;fa0:[128]f32;fa1:[128]f32;
    for lane:0..<32 {
        ga0[lane*4+0]=0.0f32;ga0[lane*4+1]=0.0f32;ga0[lane*4+2]=0.0f32;ga0[lane*4+3]=0.0f32;
        ga1[lane*4+0]=0.0f32;ga1[lane*4+1]=0.0f32;ga1[lane*4+2]=0.0f32;ga1[lane*4+3]=0.0f32;
        fa0[lane*4+0]=0.0f32;fa0[lane*4+1]=0.0f32;fa0[lane*4+2]=0.0f32;fa0[lane*4+3]=0.0f32;
        fa1[lane*4+0]=0.0f32;fa1[lane*4+1]=0.0f32;fa1[lane*4+2]=0.0f32;fa1[lane*4+3]=0.0f32;
    }
    for bk:cast(u32)0..<4 {
        k0:=mul_wrap(bk,16);
        for lane:0..<32 {
            g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
            rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
            if rl<nd {
                gl:=add_wrap(gbase,add_wrap(mul_wrap(rl,64),add_wrap(k0,mul_wrap(t,2))));
                fl:=add_wrap(fbase,add_wrap(mul_wrap(rl,64),add_wrap(k0,mul_wrap(t,2))));
                fg[lane*4+0]=ink_bf16_rne(arena[cast(int)gl])|(ink_bf16_rne(arena[cast(int)add_wrap(gl,1)])<<16);
                fg[lane*4+2]=ink_bf16_rne(arena[cast(int)add_wrap(gl,8)])|(ink_bf16_rne(arena[cast(int)add_wrap(gl,9)])<<16);
                ff[lane*4+0]=ink_bf16_rne(arena[cast(int)fl])|(ink_bf16_rne(arena[cast(int)add_wrap(fl,1)])<<16);
                ff[lane*4+2]=ink_bf16_rne(arena[cast(int)add_wrap(fl,8)])|(ink_bf16_rne(arena[cast(int)add_wrap(fl,9)])<<16);
            } else {
                fg[lane*4+0]=0;fg[lane*4+2]=0;ff[lane*4+0]=0;ff[lane*4+2]=0;
            }
            if rh<nd {
                gh:=add_wrap(gbase,add_wrap(mul_wrap(rh,64),add_wrap(k0,mul_wrap(t,2))));
                fh:=add_wrap(fbase,add_wrap(mul_wrap(rh,64),add_wrap(k0,mul_wrap(t,2))));
                fg[lane*4+1]=ink_bf16_rne(arena[cast(int)gh])|(ink_bf16_rne(arena[cast(int)add_wrap(gh,1)])<<16);
                fg[lane*4+3]=ink_bf16_rne(arena[cast(int)add_wrap(gh,8)])|(ink_bf16_rne(arena[cast(int)add_wrap(gh,9)])<<16);
                ff[lane*4+1]=ink_bf16_rne(arena[cast(int)fh])|(ink_bf16_rne(arena[cast(int)add_wrap(fh,1)])<<16);
                ff[lane*4+3]=ink_bf16_rne(arena[cast(int)add_wrap(fh,8)])|(ink_bf16_rne(arena[cast(int)add_wrap(fh,9)])<<16);
            } else {
                fg[lane*4+1]=0;fg[lane*4+3]=0;ff[lane*4+1]=0;ff[lane*4+3]=0;
            }
            tk:=add_wrap(t0,g);
            if tk<ntoks {
                at0:=add_wrap(gb_base,add_wrap(mul_wrap(tk,32),add_wrap(mul_wrap(bk,8),t)));
                fb0[lane*2+0]=gate_bf16[cast(int)at0];fb0[lane*2+1]=gate_bf16[cast(int)add_wrap(at0,4)];
            } else {
                fb0[lane*2+0]=0;fb0[lane*2+1]=0;
            }
            if has1 {
                tk1:=add_wrap(tk,8);
                if tk1<ntoks {
                    at1:=add_wrap(gb_base,add_wrap(mul_wrap(tk1,32),add_wrap(mul_wrap(bk,8),t)));
                    fb1[lane*2+0]=gate_bf16[cast(int)at1];fb1[lane*2+1]=gate_bf16[cast(int)add_wrap(at1,4)];
                } else {
                    fb1[lane*2+0]=0;fb1[lane*2+1]=0;
                }
            }
        }
        cu_mma_bf16_16x8x16(fg[..],fb0[..],ga0[..]);
        cu_mma_bf16_16x8x16(ff[..],fb0[..],fa0[..]);
        if has1 {
            cu_mma_bf16_16x8x16(fg[..],fb1[..],ga1[..]);
            cu_mma_bf16_16x8x16(ff[..],fb1[..],fa1[..]);
        }
    }
    cb0:=cast(u32)((ifx swa!=0 then 0 else cl)*stack);
    mb0:=cast(u32)((c0+cl)*stack);
    ob0:=cast(u32)(cl*stack);
    for lane:0..<32 {
        g:=cast(u32)(lane/4);t:=cast(u32)(lane%4);
        rl:=add_wrap(r0,g);rh:=add_wrap(rl,8);
        tk0:=add_wrap(t0,mul_wrap(t,2));tk1:=add_wrap(tk0,1);
        if rl<nd {
            if tk0<ntoks {
                off:=add_wrap(mul_wrap(tk0,nd),rl);
                c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa0[lane*4+0])*c+ink_tanh(ga0[lane*4+0])*m;
            }
            if tk1<ntoks {
                off:=add_wrap(mul_wrap(tk1,nd),rl);
                c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa0[lane*4+1])*c+ink_tanh(ga0[lane*4+1])*m;
            }
        }
        if rh<nd {
            if tk0<ntoks {
                off:=add_wrap(mul_wrap(tk0,nd),rh);
                c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa0[lane*4+2])*c+ink_tanh(ga0[lane*4+2])*m;
            }
            if tk1<ntoks {
                off:=add_wrap(mul_wrap(tk1,nd),rh);
                c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa0[lane*4+3])*c+ink_tanh(ga0[lane*4+3])*m;
            }
        }
        if has1 {
            tk2:=add_wrap(tk0,8);tk3:=add_wrap(tk2,1);
            if rl<nd {
                if tk2<ntoks {
                    off:=add_wrap(mul_wrap(tk2,nd),rl);
                    c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                    out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa1[lane*4+0])*c+ink_tanh(ga1[lane*4+0])*m;
                }
                if tk3<ntoks {
                    off:=add_wrap(mul_wrap(tk3,nd),rl);
                    c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                    out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa1[lane*4+1])*c+ink_tanh(ga1[lane*4+1])*m;
                }
            }
            if rh<nd {
                if tk2<ntoks {
                    off:=add_wrap(mul_wrap(tk2,nd),rh);
                    c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                    out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa1[lane*4+2])*c+ink_tanh(ga1[lane*4+2])*m;
                }
                if tk3<ntoks {
                    off:=add_wrap(mul_wrap(tk3,nd),rh);
                    c:=cur[cast(int)add_wrap(cb0,off)];m:=msg[cast(int)add_wrap(mb0,off)];
                    out[cast(int)add_wrap(ob0,off)]=c-ink_tanh(fa1[lane*4+3])*c+ink_tanh(ga1[lane*4+3])*m;
                }
            }
        }
    }
}

#test "IQ4_NL and Q8_0 BF16 tables are bit-exact and Q8 MMA kernels match scalar reference" {
    for q:0..<16 {
        #assert cu_bf16(ink_iq4_bf16(cast(u32)q),false)==ink_iq4_val(cast(u32)q);
    }
    for b:0..<256 {
        p:=ink_q8_pair_bf16(cast(u32)b|(cast(u32)((b+1)&255)<<8));
        #assert cu_bf16(p,false)==ink_signed(cast(u32)b);
        #assert cu_bf16(p,true)==ink_signed(cast(u32)((b+1)&255));
    }
    rows:=32;cols:=32;tokens:=10;blocks:=1;words:=8;
    wq:[32*1*8]u32;wd:[32*1]u16;x:[10*32]f32;xb:[10*16]u32;
    out_mma:[10*32]f32;out_proj:[10*32]f32;out_ref:[10*32]f32;
    for r:0..<rows {
        wd[r]=cast(u16)ink_f16(0.25f32+0.03125f32*f32(r%7));
        for w:0..<words {
            v0:=cast(u32)((r*3+w*7+1)&255);v1:=cast(u32)((r*5+w*11+2)&255);
            v2:=cast(u32)((r*7+w*13+3)&255);v3:=cast(u32)((r*11+w*17+4)&255);
            wq[w*rows+r]=v0|(v1<<8)|(v2<<16)|(v3<<24);
        }
    }
    for i:0..<tokens*cols {x[i]=f32((i%15)-7)*0.25f32;}
    for i:0..<tokens*(cols/2) {ink_bf16_pack(i,tokens*(cols/2),x[..],xb[..]);}
    for w:0..<2 {ink_q8_mma(w,rows,rows,cols,tokens,0,wq[..],wd[..],xb[..],out_mma[..]);}
    pdesc:[10]u32;
    pdesc[0]=0;pdesc[1]=0;pdesc[2]=32;pdesc[3]=32;pdesc[4]=0;pdesc[5]=0;pdesc[6]=0;pdesc[7]=8;pdesc[8]=32;pdesc[9]=2;
    for w:0..<2 {ink_proj_mma(w,1,2,cols,tokens,pdesc[..],wq[..],wd[..],xb[..],out_proj[..]);}
    for tok:0..<tokens {ink_mvq(tok,rows,rows,cols,0,1,wq[..],wd[..],x[..],out_ref[..]);}
    for i:0..<tokens*rows {
        d1:=out_mma[i]-out_ref[i];if d1<0 {d1=-d1;}
        d2:=out_proj[i]-out_ref[i];if d2<0 {d2=-d2;}
        #assert d1<0.001f32 && d2<0.001f32;
    }
}

#test "MoE IQ4_NL MMA kernels match scalar reference including >8-token tasks" {
    n_ff:=32;d:=32;tokens:=9;
    x:[9*32]f32;xb:[9*16]u32;
    for i:0..<tokens*d {x[i]=f32((i%15)-7)*0.25f32;}
    for i:0..<tokens*(d/2) {ink_bf16_pack(i,tokens*(d/2),x[..],xb[..]);}
    gu_buf:[64*1*4+64*1/2]u32;gu_h:[64*1*9]u16;
    dn_buf:[32*1*4+32*1/2]u32;dn_h:[32*1*9]u16;
    for i:0..<64*4 {gu_buf[i]=cast(u32)((i*17+3)&255)|(cast(u32)((i*23+7)&255)<<8)|(cast(u32)((i*31+11)&255)<<16)|(cast(u32)((i*37+13)&255)<<24);}
    for i:0..<64 {gu_h[64*8+i]=cast(u16)ink_f16(0.0625f32+0.015625f32*f32(i%5));}
    for i:0..<32*4 {dn_buf[i]=cast(u32)((i*19+5)&255)|(cast(u32)((i*29+9)&255)<<8)|(cast(u32)((i*41+15)&255)<<16)|(cast(u32)((i*43+1)&255)<<24);}
    for i:0..<32 {dn_h[32*8+i]=cast(u16)ink_f16(0.0625f32+0.015625f32*f32(i%4));}
    tslot:[1]u32;tbase:[1]u32;tcnt:[1]u32;stok:[9]u32;spair:[9]u32;wts:[9]f32;
    tslot[0]=0;tbase[0]=0;tcnt[0]=9;
    for e:0..<9 {stok[e]=cast(u32)e;spair[e]=cast(u32)e;wts[e]=0.25f32+0.125f32*f32(e%4);}
    gu_out:[9*64]f32;hid_bf16:[9*16]u32;dn_out:[9*32]f32;
    for w:0..<4 {ink_moe_gu_iq4_mma(w,n_ff,d,gu_buf[..],gu_h[..],xb[..],tslot[..],tbase[..],tcnt[..],stok[..],gu_out[..]);}
    for i:0..<9*(n_ff/2) {ink_moe_situ_pack(i,9,n_ff,1.5f32,10.0f32,gu_out[..],spair[..],wts[..],hid_bf16[..]);}
    for w:0..<2 {ink_moe_down_iq4_mma(w,d,n_ff,dn_buf[..],dn_h[..],hid_bf16[..],tslot[..],tbase[..],tcnt[..],spair[..],dn_out[..]);}
    ids9:[9]u32;hid9:[9*32]f32;ref9:[9*32]f32;
    for e:0..<9 {ids9[e]=0;}
    for gi:0..<9*2 {ink_moe_gu(gi,n_ff,d,1,0,1.5f32,10.0f32,gu_buf[..],gu_h[..],x[..],ids9[..],hid9[..]);}
    for gi:0..<9 {ink_moe_down(gi,d,n_ff,1,0,dn_buf[..],dn_h[..],hid9[..],ids9[..],wts[..],ref9[..]);}
    max_abs:f32=0;max_ref:f32=0;
    for i:0..<9*d {
        diff:=dn_out[i]-ref9[i];if diff<0 {diff=-diff;}
        mag:=ref9[i];if mag<0 {mag=-mag;}
        if diff>max_abs {max_abs=diff;}
        if mag>max_ref {max_ref=mag;}
    }
    #assert max_ref>1.0f32 && max_abs<0.01f32*max_ref;
    for e:0..<9 {
        for j:0..<n_ff {
            g0:=gu_out[e*2*n_ff+2*j];u0:=gu_out[e*2*n_ff+2*j+1];
            act:=1.5f32*ink_tanh(g0/1.5f32)*ink_sigmoid(g0);
            up:=10.0f32*ink_tanh(u0/10.0f32);
            d0:=act*up-hid9[e*n_ff+j];if d0<0 {d0=-d0;}
            #assert d0<0.005f32;
        }
    }
}

#test "ink_attn_online matches ink_attn with non-dividing GQA, SWA, rel_bias, clip, tau, and sink" {
    n_head:=3;n_head_kv:=1;head_dim:=128;n_rel:=16;extent:=6;swa:=4;kv_cap:=8;np:=3;pos0:=3;
    dims0:=n_head|(n_head_kv<<16)|(head_dim<<32)|(n_rel<<48);
    dims1:=extent|(1<<24)|(swa<<32);
    kv_info:=kv_cap|(16<<32);
    q:[3*3*128]f32;r:[3*3*16]f32;rel_bias:[6*16]f32;sinks:[3*3]f32;gate:[3*3*128]f32;
    k_cache:[8*128]u16;v_cache:[8*128]u16;scores:[3*3*16]f32;
    qclip:[3*128]f32;rclip:[3*16]f32;out_ref:[3*3*128]f32;out_on:[3*3*128]f32;
    for i:0..<3*3*128 {q[i]=f32((i%17)-8)*0.125f32;gate[i]=f32((i%11)-5)*0.2f32;}
    for i:0..<3*3*16 {r[i]=f32((i%13)-6)*0.15f32;}
    for i:0..<6*16 {rel_bias[i]=f32((i%9)-4)*0.1f32;}
    for i:0..<3*3 {sinks[i]=f32((i%5)-2)*0.3f32;}
    for i:0..<8*128 {
        k_cache[i]=cast(u16)ink_f16(f32((i%19)-9)*0.125f32);
        v_cache[i]=cast(u16)ink_f16(f32((i%15)-7)*0.125f32);
    }
    for i:0..<3*128 {qclip[i]=0.5f32+0.05f32*f32(i%7);}
    for i:0..<3*16 {rclip[i]=0.6f32+0.05f32*f32(i%5);}
    pbuf:[1]u32;pbuf[0]=cast(u32)pos0;
    for itm:0..<np*n_head {
        ink_attn(itm,dims0,dims1,kv_info,pos0,q[..],r[..],rel_bias[..],sinks[..],gate[..],k_cache[..],v_cache[..],scores[..],out_ref[..],3,2.0f32,1.5f32,0.1f32,2.0f32,qclip[..],rclip[..],pbuf[..]);
    }
    // Run both CTAs (t_step=2 for gqa=3, np=3) in reverse order so out-of-range dt=2 would clobber CTA 1's tok=2.
    for ri:0..<2 {
        itm:=1-ri;
        ink_attn_online(itm,dims0,dims1,kv_cap,pos0,np,q[..],r[..],rel_bias[..],sinks[..],gate[..],k_cache[..],v_cache[..],out_on[..],3,2.0f32,1.5f32,0.1f32,2.0f32,qclip[..],rclip[..]);
    }
    max_d:f32=0.0f32;
    for i:0..<3*3*128 {
        d:=out_on[i]-out_ref[i];if d<0 {d=-d;}
        if d>max_d {max_d=d;}
    }
    #assert max_d<0.0001f32;
}

#test "ink_ctrl MMA kernels match ink_ctrl_gate and ink_ctrl_out" {
    dim:=32;np:=3;stack:=3*32;
    // arena holds D [64, 64] at 0, G [32, 64] at 4096, F [32, 64] at 6144.
    arena:[8192]f32;cur:[3*32]f32;msg:[3*32]f32;
    gate_ref:[3*64]f32;gate_mma:[3*64]f32;out_ref:[3*32]f32;out_mma:[3*32]f32;
    xb:[3*32]u32;gb:[3*32]u32;
    for i:0..<8192 {arena[i]=f32((i%13)-6)*0.0625f32;}
    for i:0..<3*32 {cur[i]=f32((i%11)-5)*0.25f32;msg[i]=f32((i%9)-4)*0.25f32;}
    gf0:=4096|(6144<<32);
    for itm:0..<np*64 {ink_ctrl_gate(itm,dim,np,stack,0,0,0,0,arena[..],cur[..],msg[..],gate_ref[..]);}
    for itm:0..<np {ink_ctrl_out(itm,dim,np,stack,0,gf0,0,0,arena[..],cur[..],msg[..],gate_ref[..],out_ref[..]);}
    for itm:0..<np {ink_ctrl_pack_bf16(itm,dim,np,stack,0,cur[..],msg[..],xb[..]);}
    for w:0..<4 {ink_ctrl_gate_mma(w,dim,np,0,0,0,arena[..],xb[..],gate_mma[..]);}
    for i:0..<np*32 {ink_bf16_pack(i,np*32,gate_mma[..],gb[..]);}
    for w:0..<2 {ink_ctrl_out_mma(w,dim,np,stack,0,gf0,0,0,arena[..],cur[..],msg[..],gb[..],out_mma[..]);}
    max_g:f32=0.0f32;max_o:f32=0.0f32;
    for i:0..<np*64 {d:=gate_mma[i]-gate_ref[i];if d<0 {d=-d;} if d>max_g {max_g=d;}}
    for i:0..<np*dim {d:=out_mma[i]-out_ref[i];if d<0 {d=-d;} if d>max_o {max_o=d;}}
    #assert max_g<0.02f32 && max_o<0.02f32;
}
