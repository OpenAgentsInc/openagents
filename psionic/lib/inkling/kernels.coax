// inkling-metal-f32-v1: Inkling 2 Mini (inkling2_loop) compute-subset kernels
// for `coax metal-compute`. Weights stay in their GGUF blocks (IQ4_NL, Q8_0, F32).
// Activations and accumulators are f32; KV cache is f16.
#load "../../../coax/lib/compute/apple.coax";

INK_T :: 64;
INK_NT :: 256;
INK_PREFILL_B :: 3072;
INK_DR :: 4;
INK_D :: 8;
INK_HEAD :: 128;
INK_REL :: 16;
INK_NEG_INF :: -300000000000000000000000000000000000000.0f32;

// ---- Scalars.
ink_half :: (bits:u32)->f32 #effects(all) { return am_f16(bits); }
ink_f16 :: (x:f32)->u32 {
    bits:=f32_bits(x);sign:=(bits>>16)&0x8000;e:=(bits>>23)&255;m:=bits&0x7fffff;
    if e==255 {return sign|0x7c00|(ifx m!=0 then cast(u32)0x200 else cast(u32)0);}
    if e>=143 {return sign|0x7c00;}
    if e>=113 {
        h:=((e-112)<<10)|(m>>13);rest:=m&0x1fff;
        if rest>0x1000 || (rest==0x1000 && (h&1)!=0) {h+=1;}
        return sign|h;
    }
    if e<102 {return sign;}
    full:=m|0x800000;shift:=126-e;h:=full>>shift;rest:=full&((cast(u32)1<<shift)-1);half:=cast(u32)1<<(shift-1);
    if rest>half || (rest==half && (h&1)!=0) {h+=1;}
    return sign|h;
}
ink_signed :: (b:u32)->f32 {return ifx b>=128 then f32(b)-256.0f32 else f32(b);}
ink_sigmoid :: (x:f32)->f32 {
    if x>=0.0f32 {return 1.0f32/(1.0f32+exp(-x));}
    e:=exp(x);return e/(1.0f32+e);
}
ink_tanh :: (x:f32)->f32 {
    if x>=0.0f32 {e:=exp(-2.0f32*x);return (1.0f32-e)/(1.0f32+e);}
    e:=exp(2.0f32*x);return (e-1.0f32)/(e+1.0f32);
}
ink_iq4_val :: (q:u32)->f32 {
    if q<8 {
        if q<4 {
            if q<2 {return ifx q==0 then -127.0f32 else -104.0f32;}
            return ifx q==2 then -83.0f32 else -65.0f32;
        }
        if q<6 {return ifx q==4 then -49.0f32 else -35.0f32;}
        return ifx q==6 then -22.0f32 else -10.0f32;
    }
    if q<12 {
        if q<10 {return ifx q==8 then 1.0f32 else 13.0f32;}
        return ifx q==10 then 25.0f32 else 38.0f32;
    }
    if q<14 {return ifx q==12 then 53.0f32 else 69.0f32;}
    return ifx q==14 then 89.0f32 else 113.0f32;
}

// ---- Embedding lookup from Q8_0 token_embd.weight + RMSNorm with tok_norm.
// One work item (256 threads). Reads row `tok` of [vocab, dim] Q8_0 (17 u16 words per 32 vals).
ink_embed_q8 :: (item:int,tok:int,dim:int,w:[]u16,norm_w:[]f32,eps:f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    d:=cast(u32)dim;blocks:=d/32;row_words:=blocks*17;base:=mul_wrap(cast(u32)tok,row_words);
    for thread:0..<INK_NT {
        s:f32=0;
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {
                blk:=i/32;off:=i%32;at:=add_wrap(base,mul_wrap(blk,17));
                sc:=ink_half(cast(u32)w[cast(int)at]);
                word:=cast(u32)w[cast(int)add_wrap(at,1+off/2)];
                q:=ifx (off%2)==0 then word&255 else (word>>8)&255;
                v:=sc*ink_signed(q);
                out[cast(int)i]=v;s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_NT {
        tot:f32=0;for j:0..<INK_NT {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(d+255)/256 {
            i:=add_wrap(mul_wrap(k,256),t);
            if i<d {out[cast(int)i]=out[cast(int)i]*inv*norm_w[cast(int)i];}
        }
    }
}

// ---- RMSNorm (Sprint 61: single-pass register-cached float4 am_rmsnorm_f32).
ink_rmsnorm :: (item:int,dim:int,has_w:int,eps:f32,x:[]f32,w:[]f32,out:[]f32) #export_c #effects(all) {
    base:=item*dim;
    for thread:0..<INK_NT {
        am_rmsnorm_f32(dim,has_w,eps,x,base,w,0,out,base);
    }
}

// ---- Matvec Q8_0 (1 token): group of 128 threads (4 simdgroups x 2 rows) writes INK_D=8 rows.
// 4 lanes cooperate on each 32-elem Q8_0 block (8 blocks/simdgroup, 100% coalesced & 72/8=9 exact!).
// ---- Matvec Q8_0 (1 token): group of 128 threads (4 simdgroups x 2 rows = 8 rows/TG), 4 lanes/block coalesced.
// ---- Matvec Q8_0 (1 token, Sprint 30): 1 simdgroup (32 threads) computes 2 rows, ZERO TGEM, ZERO barriers, hardware simd_sum + f16!
ink_dv_q8 :: (item:int,rows:int,cols:int,add:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    blocks:=cols/32;words:=blocks*17;
    base_row:=item*2;
    r1:=base_row+1;
    for lane:0..<32 {
        blk_lane:=lane/4;sub:=lane%4;
        a0:f32=0;a1:f32=0;
        k0:=sub*4;
        if r1<rows {
            rb0:=base_row*words;rb1:=rb0+words;
            for step:0..<(blocks+7)/8 {
                block:=step*8+blk_lane;
                if block<blocks {
                    xb:=block*32+k0*2;boff:=block*17;
                    at0:=rb0+boff;at1:=rb1+boff;
                    s0:f32=0;s1:f32=0;
                    for j:0..<4 {
                        x0:=x[xb+2*j];
                        x1:=x[xb+2*j+1];
                        kk:=1+k0+j;
                        v0:=cast(u32)w[at0+kk];s0+=ink_signed(v0&255)*x0+ink_signed(v0>>8)*x1;
                        v1:=cast(u32)w[at1+kk];s1+=ink_signed(v1&255)*x0+ink_signed(v1>>8)*x1;
                    }
                    a0+=am_f16(cast(u32)w[at0])*s0;
                    a1+=am_f16(cast(u32)w[at1])*s1;
                }
            }
            tot0:=am_simd_sum(a0);
            tot1:=am_simd_sum(a1);
            if lane==0 {
                if add!=0 {out[base_row]=out[base_row]+tot0;out[r1]=out[r1]+tot1;}
                else {out[base_row]=tot0;out[r1]=tot1;}
            }
        } else if base_row<rows {
            rb0:=base_row*words;
            for step:0..<(blocks+7)/8 {
                block:=step*8+blk_lane;
                if block<blocks {
                    xb:=block*32+k0*2;boff:=block*17;
                    at:=rb0+boff;sum:f32=0;
                    for j:0..<4 {
                        x0:=x[xb+2*j];
                        x1:=x[xb+2*j+1];
                        v:=cast(u32)w[at+1+k0+j];
                        sum+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;
                    }
                    a0+=am_f16(cast(u32)w[at])*sum;
                }
            }
            tot0:=am_simd_sum(a0);
            if lane==0 {
                if add!=0 {out[base_row]=out[base_row]+tot0;} else {out[base_row]=tot0;}
            }
        }
    }
}

// ---- Sprint 28+30: Fused Q8_0 matvec + post shortconv + residual (1 simdgroup = 2 rows, ZERO TGEM, ZERO barriers!).
ink_dv_q8_conv :: (item:int,rows:int,cols:int,add_res:int,w:[]u16,x:[]f32,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    blocks:=cols/32;words:=blocks*17;
    base_row:=item*2;
    r1:=base_row+1;
    for lane:0..<32 {
        blk_lane:=lane/4;sub:=lane%4;
        a0:f32=0;a1:f32=0;
        k0:=sub*4;
        if r1<rows {
            rb0:=base_row*words;rb1:=rb0+words;
            for step:0..<(blocks+7)/8 {
                block:=step*8+blk_lane;
                if block<blocks {
                    xb:=block*32+k0*2;boff:=block*17;
                    at0:=rb0+boff;at1:=rb1+boff;
                    s0:f32=0;s1:f32=0;
                    for j:0..<4 {
                        x0:=x[xb+2*j];
                        x1:=x[xb+2*j+1];
                        kk:=1+k0+j;
                        v0:=cast(u32)w[at0+kk];s0+=ink_signed(v0&255)*x0+ink_signed(v0>>8)*x1;
                        v1:=cast(u32)w[at1+kk];s1+=ink_signed(v1&255)*x0+ink_signed(v1>>8)*x1;
                    }
                    a0+=am_f16(cast(u32)w[at0])*s0;
                    a1+=am_f16(cast(u32)w[at1])*s1;
                }
            }
            tot0:=am_simd_sum(a0);
            tot1:=am_simd_sum(a1);
            if lane==0 {
                x0:=hist[base_row*3+0];x1:=hist[base_row*3+1];x2:=hist[base_row*3+2];
                hist[base_row*3+0]=x1;hist[base_row*3+1]=x2;hist[base_row*3+2]=tot0;
                cv0:=(tot0+x0*cw[base_row*4+0]+x1*cw[base_row*4+1]+x2*cw[base_row*4+2]+tot0*cw[base_row*4+3])*0.4472135954999579f32;
                if add_res!=0 {out[base_row]=res[base_row]+cv0;} else {out[base_row]=cv0;}
                y0:=hist[r1*3+0];y1:=hist[r1*3+1];y2:=hist[r1*3+2];
                hist[r1*3+0]=y1;hist[r1*3+1]=y2;hist[r1*3+2]=tot1;
                cv1:=(tot1+y0*cw[r1*4+0]+y1*cw[r1*4+1]+y2*cw[r1*4+2]+tot1*cw[r1*4+3])*0.4472135954999579f32;
                if add_res!=0 {out[r1]=res[r1]+cv1;} else {out[r1]=cv1;}
            }
        } else if base_row<rows {
            rb0:=base_row*words;
            for step:0..<(blocks+7)/8 {
                block:=step*8+blk_lane;
                if block<blocks {
                    xb:=block*32+k0*2;boff:=block*17;
                    at:=rb0+boff;sum:f32=0;
                    for j:0..<4 {
                        x0:=x[xb+2*j];
                        x1:=x[xb+2*j+1];
                        v:=cast(u32)w[at+1+k0+j];
                        sum+=ink_signed(v&255)*x0+ink_signed(v>>8)*x1;
                    }
                    a0+=am_f16(cast(u32)w[at])*sum;
                }
            }
            tot0:=am_simd_sum(a0);
            if lane==0 {
                x0:=hist[base_row*3+0];x1:=hist[base_row*3+1];x2:=hist[base_row*3+2];
                hist[base_row*3+0]=x1;hist[base_row*3+1]=x2;hist[base_row*3+2]=tot0;
                cv0:=(tot0+x0*cw[base_row*4+0]+x1*cw[base_row*4+1]+x2*cw[base_row*4+2]+tot0*cw[base_row*4+3])*0.4472135954999579f32;
                if add_res!=0 {out[base_row]=res[base_row]+cv0;} else {out[base_row]=cv0;}
            }
        }
    }
}

// ---- Matvec IQ4_NL (1 token): group of 64 threads writes INK_D=8 rows.
// book:begin iq4-metal-kernel
// w is [rows, cols] IQ4_NL stored as u16 (9 u16 per 32 values: 1 f16 d, 8 u16 = 16 qs bytes).
// qs byte j has low nibble for elem j (0..15) and high nibble for elem j+16 (16..31).
ink_dv_iq4 :: (item:int,rows:int,cols:int,add:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    lut:[16]f32;
    blocks:=cols/32;words:=blocks*9;row0:=item*INK_D;
    for thread:0..<INK_T {
        if thread<16 {lut[thread]=ink_iq4_val(cast(u32)thread);}
    }
    for thread:0..<INK_T {
        lane:=thread%32;simd:=thread/32;
        base_row:=row0+simd*INK_DR;
        r3:=base_row+3;
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
        for step:0..<(blocks+31)/32 {
            block:=step*32+lane;
            if block<blocks {
                xb:=block*32;boff:=block*9;
                if r3<rows {
                    at0:=base_row*words+boff;
                    at1:=at0+words;at2:=at1+words;at3:=at2+words;
                    s0:f32=0;s1:f32=0;s2:f32=0;s3:f32=0;
                    for k:0..<8 {
                        x0:=x[xb+2*k];
                        x1:=x[xb+16+2*k];
                        x2:=x[xb+2*k+1];
                        x3:=x[xb+16+2*k+1];
                        kk:=1+k;
                        v0:=cast(int)w[at0+kk];
                        s0+=lut[v0&15]*x0+lut[(v0>>4)&15]*x1+lut[(v0>>8)&15]*x2+lut[v0>>12]*x3;
                        v1:=cast(int)w[at1+kk];
                        s1+=lut[v1&15]*x0+lut[(v1>>4)&15]*x1+lut[(v1>>8)&15]*x2+lut[v1>>12]*x3;
                        v2:=cast(int)w[at2+kk];
                        s2+=lut[v2&15]*x0+lut[(v2>>4)&15]*x1+lut[(v2>>8)&15]*x2+lut[v2>>12]*x3;
                        v3:=cast(int)w[at3+kk];
                        s3+=lut[v3&15]*x0+lut[(v3>>4)&15]*x1+lut[(v3>>8)&15]*x2+lut[v3>>12]*x3;
                    }
                    a0+=ink_half(cast(u32)w[at0])*s0;
                    a1+=ink_half(cast(u32)w[at1])*s1;
                    a2+=ink_half(cast(u32)w[at2])*s2;
                    a3+=ink_half(cast(u32)w[at3])*s3;
                } else {
                    for r:0..<INK_DR {
                        row:=base_row+r;
                        if row<rows {
                            at:=row*words+boff;sum:f32=0;
                            for k:0..<8 {
                                x0:=x[xb+2*k];
                                x1:=x[xb+16+2*k];
                                x2:=x[xb+2*k+1];
                                x3:=x[xb+16+2*k+1];
                                v:=cast(int)w[at+1+k];
                                sum+=lut[v&15]*x0+lut[(v>>4)&15]*x1+lut[(v>>8)&15]*x2+lut[v>>12]*x3;
                            }
                            d:=ink_half(cast(u32)w[at])*sum;
                            if r==0 {a0+=d;} else if r==1 {a1+=d;} else if r==2 {a2+=d;} else {a3+=d;}
                        }
                    }
                }
            }
        }
        part[thread*INK_DR+0]=a0;part[thread*INK_DR+1]=a1;part[thread*INK_DR+2]=a2;part[thread*INK_DR+3]=a3;
    }
    for thread:0..<INK_T {
        if thread<INK_D {
            row:=item*INK_D+thread;
            if row<rows {
                simd:=thread/INK_DR;r:=thread%INK_DR;sum:f32=0;
                for l:0..<32 {sum+=part[(simd*32+l)*INK_DR+r];}
                if add!=0 {out[row]=out[row]+sum;}else {out[row]=sum;}
            }
        }
    }
}
// book:end iq4-metal-kernel


// ---- Matvec F32 (1 token): 1 group of 64 threads writes INK_D=8 rows.
ink_dv_f32 :: (item:int,rows:int,cols:int,add:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    row0:=item*INK_D;
    for thread:0..<INK_T {
        lane:=thread%32;simd:=thread/32;
        base_row:=row0+simd*INK_DR;
        r3:=base_row+3;
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
        if r3<rows {
            at0:=base_row*cols;
            at1:=at0+cols;at2:=at1+cols;at3:=at2+cols;
            for step:0..<(cols+31)/32 {
                col:=step*32+lane;
                if col<cols {
                    xv:=x[col];
                    a0+=w[at0+col]*xv;
                    a1+=w[at1+col]*xv;
                    a2+=w[at2+col]*xv;
                    a3+=w[at3+col]*xv;
                }
            }
        } else {
            for step:0..<(cols+31)/32 {
                col:=step*32+lane;
                if col<cols {
                    xv:=x[col];
                    if base_row<rows {a0+=w[base_row*cols+col]*xv;}
                    if base_row+1<rows {a1+=w[(base_row+1)*cols+col]*xv;}
                    if base_row+2<rows {a2+=w[(base_row+2)*cols+col]*xv;}
                }
            }
        }
        part[thread*INK_DR+0]=a0;part[thread*INK_DR+1]=a1;part[thread*INK_DR+2]=a2;part[thread*INK_DR+3]=a3;
    }
    for thread:0..<INK_T {
        if thread<INK_D {
            row:=item*INK_D+thread;
            if row<rows {
                simd:=thread/INK_DR;r:=thread%INK_DR;sum:f32=0;
                for l:0..<32 {sum+=part[(simd*32+l)*INK_DR+r];}
                if add!=0 {out[row]=out[row]+sum;}else {out[row]=sum;}
            }
        }
    }
}


// ---- Matvec F32 for small-row matrices (Sprint 30: hardware simd_sum, 1 barrier instead of 3!).
ink_dv_f32_small :: (item:int,rows:int,cols:int,add:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    base:=item*cols;
    for thread:0..<INK_NT {
        s:f32=0;
        for step:0..<(cols+255)/256 {
            c:=step*256+thread;
            if c<cols {s+=w[base+c]*x[c];}
        }
        part[thread]=am_simd_sum(s);
    }
    for thread:0..<INK_NT {
        if thread==0 {
            tot:=part[0]+part[32]+part[64]+part[96]+part[128]+part[160]+part[192]+part[224];
            if add!=0 {out[item]=out[item]+tot;} else {out[item]=tot;}
        }
    }
}

// ---- Fused loop_ctrl_gain + loop_ctrl_forget + ink_ctrl_apply.
// gate is [rank] (rank <= 64), w_gain and w_forget are [dim, rank] F32.
// Launch items = ceil(dim / 64), lanes = 64 (1 thread per output dim).
ink_ctrl_up_apply :: (item:int,dim:int,rank:int,w_gain:[]f32,w_forget:[]f32,gate:[]f32,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    gsh:[64]f32;
    for thread:0..<INK_T {
        if thread<rank {gsh[thread]=gate[thread];}
    }
    for thread:0..<INK_T {
        row:=item*INK_T+thread;
        if row<dim {
            base:=row*rank;
            sg:f32=0;sf:f32=0;
            for k:0..<rank {
                gv:=gsh[k];
                sg+=w_gain[base+k]*gv;
                sf+=w_forget[base+k]*gv;
            }
            c:=cur[row];m:=msg[row];
            out[row]=c-ink_tanh(sf)*c+ink_tanh(sg)*m;
        }
    }
}

// ---- Sprint 65/67: 2-row-per-warp (1152 TGs) 4lb + 1KB TGEM byte-LUT + 1-warp noinline fused Router top-8 IQ4_NL MoE gate_up + SITU!
ink_moe_gu_iq4 :: (item:int,n_ff:int,cols:int,n_exp:int,n_used:int,has_bias:int,r_scale:f32,beta:f32,lb:f32,w:[]u16,x:[]f32,logits:[]f32,bias:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #export_c #effects(all) {
    groups_per_exp:=(n_ff+7)/8;
    slot:=item/groups_per_exp;
    row0:=(item%groups_per_exp)*8;
    for thread:0..<128 {
        am_moe_gu_iq4_tg(slot,row0,n_ff,cols,n_exp,n_used,has_bias,r_scale,beta,lb,w,x,logits,bias,ids,wts,out);
    }
}

// ---- MoE gate_up + SITU for top-K selected experts (Q8_0): 128 threads (4 simdgroups x 2 rows), 4 lanes/block coalesced.
ink_moe_gu_q8 :: (item:int,n_ff:int,cols:int,beta:f32,lb:f32,w:[]u16,x:[]f32,ids:[]u32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    groups_per_exp:=(n_ff+3)/4;
    slot:=item/groups_per_exp;
    rgrp:=item%groups_per_exp;
    exp_id:=cast(int)ids[slot];
    blocks:=cols/32;row_words:=blocks*17;
    exp_base:=exp_id*2*n_ff*row_words;
    row0:=rgrp*4;
    for thread:0..<128 {
        lane:=thread%32;simd:=thread/32;
        is_up:=simd/2;sub:=simd%2;
        blk_lane:=lane/4;bsub:=lane%4;
        r0:=row0+sub*2;r1:=r0+1;
        wrow0:=r0+is_up*n_ff;
        a0:f32=0;a1:f32=0;
        k0:=bsub*4;
        for step:0..<(blocks+7)/8 {
            block:=step*8+blk_lane;
            if block<blocks {
                xb:=block*32+k0*2;boff:=block*17;
                if r1<n_ff {
                    at0:=exp_base+wrow0*row_words+boff;
                    at1:=at0+row_words;
                    s0:f32=0;s1:f32=0;
                    for j:0..<4 {
                        x0:=x[xb+2*j];x1:=x[xb+2*j+1];
                        kk:=1+k0+j;
                        v0:=cast(u32)w[at0+kk];s0+=ink_signed(v0&255)*x0+ink_signed(v0>>8)*x1;
                        v1:=cast(u32)w[at1+kk];s1+=ink_signed(v1&255)*x0+ink_signed(v1>>8)*x1;
                    }
                    a0+=ink_half(cast(u32)w[at0])*s0;
                    a1+=ink_half(cast(u32)w[at1])*s1;
                } else if r0<n_ff {
                    at0:=exp_base+wrow0*row_words+boff;
                    s0:f32=0;
                    for j:0..<4 {
                        x0:=x[xb+2*j];x1:=x[xb+2*j+1];
                        v0:=cast(u32)w[at0+1+k0+j];
                        s0+=ink_signed(v0&255)*x0+ink_signed(v0>>8)*x1;
                    }
                    a0+=ink_half(cast(u32)w[at0])*s0;
                }
            }
        }
        part[thread*2+0]=a0;part[thread*2+1]=a1;
    }
    for thread:0..<128 {
        if thread<4 {
            row:=row0+thread;
            if row<n_ff {
                sub:=thread/2;rr:=thread%2;
                g:f32=0;u:f32=0;
                for l:0..<32 {
                    g+=part[(sub*32+l)*2+rr];
                    u+=part[((2+sub)*32+l)*2+rr];
                }
                act:=beta*ink_tanh(g/beta)*ink_sigmoid(g);
                if lb>0.0f32 {u=lb*ink_tanh(u/lb);}
                out[slot*n_ff+row]=act*u;
            }
        }
    }
}

// ---- Sprint 65: 4-row-per-TG (576 TGs, 4 warps x 2 experts, 4lb + 1KB TGEM half2 byte-LUT) IQ4_NL MoE down + fused post_conv + res (483.4 GB/s cold DRAM!).
ink_moe_down_iq4 :: (item:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,ids:[]u32,wts:[]f32,conv_w:[]f32,hist:[]f32,res:[]f32,tmp:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        am_moe_down_iq4_tg(item*4,rows,cols,n_used,w,x,ids,wts,conv_w,hist,res,out);
    }
}

// ---- Sprint 41B: Dequantize Q4_0 [rows, cols] -> BF16 pairs [rows, cols/2] u32 (8 rows/TG, 2x less DRAM than Q8_0!).
// Launch items = ceil(rows / 8), lanes = 96 (12 blocks/step x 8 u16/block).
ink_dequant_q4_bf16 :: (item:int,rows:int,cols:int,w:[]u16,out_bf16:[]u32) #export_c #effects(all) {
    blocks:=cols/32;
    words:=blocks*9;
    half_cols:=cols/2;
    row0:=item*8;
    for thread:0..<96 {
        b_lane:=thread/8;
        k:=thread%8;
        for rr:0..<8 {
            row:=row0+rr;
            if row<rows {
                rbase:=row*words;
                obase:=row*half_cols;
                for step:0..<(blocks+11)/12 {
                    blk:=step*12+b_lane;
                    if blk<blocks {
                        at:=rbase+blk*9;
                        sc:=am_f16(cast(u32)w[at]);
                        v:=cast(u32)w[at+1+k];
                        f0:=sc*(f32(v&15)-8.0f32);
                        f1:=sc*(f32((v>>4)&15)-8.0f32);
                        f2:=sc*(f32((v>>8)&15)-8.0f32);
                        f3:=sc*(f32(v>>12)-8.0f32);
                        b0:=(f32_bits(f0)+0x8000)>>16;
                        b1:=(f32_bits(f1)+0x8000)>>16;
                        b2:=(f32_bits(f2)+0x8000)>>16;
                        b3:=(f32_bits(f3)+0x8000)>>16;
                        out_bf16[obase+blk*16+k]=b0|(b2<<16);
                        out_bf16[obase+blk*16+8+k]=b1|(b3<<16);
                    }
                }
            }
        }
    }
}

// ---- Sprint 61: Native half4/float4 1-barrier Flash-Decoding GQA Attention with fused Q-clip & R-clip!
ink_attn_gqa_1pass :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos:int,qk_clip:f32,rel_clip:f32,q_tau:f32,q:[]f32,q_scale:[]f32,r:[]f32,r_scale:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,out:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        am_attn_gqa_1pass(item,dims0,dims1,kv_info,pos,qk_clip,rel_clip,q_tau,q,q_scale,r,r_scale,rel_bias,sinks,gate,k_cache,v_cache,out);
    }
}

// ---- Sprint 61: Vectorized float4 register-cached am_mix_fused QKV ctrl prep!
ink_mix_ctrl_prep_qkv :: (item:int,dim:int,n_blocks:int,is_swa:int,blocks_buf:[]f32,cur:[]f32,query:[]f32,msg:[]f32,out_mix:[]f32,out_cat:[]f32) #export_c #effects(all) {
    qbase:=ifx is_swa!=0 then 0 else item*dim;
    for thread:0..<INK_NT {
        am_mix_fused(2,dim,n_blocks,0.000001f32,blocks_buf,cur,query,qbase,msg,item*dim,out_mix,item*dim,out_cat,item*2*dim);
    }
}

// ---- MoE down projection + weighted sum over n_used selected experts (Q8_0): 128 threads (4 simdgroups x 2 rows), flattened (slot, block).
ink_moe_down_q8 :: (item:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,ids:[]u32,wts:[]f32,conv_w:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;
    blocks:=cols/32;row_words:=blocks*17;exp_words:=rows*row_words;
    tot_blocks:=n_used*blocks;
    row0:=item*INK_D;
    for thread:0..<128 {
        lane:=thread%32;simd:=thread/32;
        base_row:=row0+simd*2;
        r1:=base_row+1;
        a0:f32=0;a1:f32=0;
        for step:0..<(tot_blocks+31)/32 {
            idx:=step*32+lane;
            if idx<tot_blocks {
                slot:=idx/blocks;
                block:=idx%blocks;
                exp_id:=cast(int)ids[slot];ew:=wts[slot];
                exp_base:=exp_id*exp_words;
                xb:=slot*cols+block*32;boff:=block*17;
                if r1<rows {
                    at0:=exp_base+base_row*row_words+boff;
                    at1:=at0+row_words;
                    s0:f32=0;s1:f32=0;
                    for k:0..<16 {
                        x0:=x[xb+2*k];x1:=x[xb+2*k+1];
                        kk:=1+k;
                        v0:=cast(u32)w[at0+kk];s0+=ink_signed(v0&255)*x0+ink_signed(v0>>8)*x1;
                        v1:=cast(u32)w[at1+kk];s1+=ink_signed(v1&255)*x0+ink_signed(v1>>8)*x1;
                    }
                    a0+=ew*ink_half(cast(u32)w[at0])*s0;
                    a1+=ew*ink_half(cast(u32)w[at1])*s1;
                } else if base_row<rows {
                    at0:=exp_base+base_row*row_words+boff;
                    s0:f32=0;
                    for k:0..<16 {
                        x0:=x[xb+2*k];x1:=x[xb+2*k+1];
                        v0:=cast(u32)w[at0+1+k];
                        s0+=ink_signed(v0&255)*x0+ink_signed(v0>>8)*x1;
                    }
                    a0+=ew*ink_half(cast(u32)w[at0])*s0;
                }
            }
        }
        part[thread*2+0]=a0;part[thread*2+1]=a1;
    }
    for thread:0..<128 {
        if thread<INK_D {
            row:=item*INK_D+thread;
            if row<rows {
                simd:=thread/2;r:=thread%2;sum:f32=0;
                for l:0..<32 {sum+=part[(simd*32+l)*2+r];}
                x0:=hist[row*3+0];x1:=hist[row*3+1];x2:=hist[row*3+2];
                hist[row*3+0]=x1;hist[row*3+1]=x2;hist[row*3+2]=sum;
                acc:=x0*conv_w[row*4+0]+x1*conv_w[row*4+1]+x2*conv_w[row*4+2]+sum*conv_w[row*4+3];
                out[row]=res[row]+(sum+acc)*0.4472135954999579f32;
            }
        }
    }
}

// ---- Sprint 61: Native zero-overhead 32-lane warp MoE Router!
ink_router :: (item:int,n_exp:int,n_used:int,has_bias:int,scale:f32,logits:[]f32,bias:[]f32,out_ids:[]u32,out_wts:[]f32) #export_c #effects(all) {
    for lane:0..<32 {
        am_router_top8(n_exp,n_used,has_bias,scale,logits,bias,out_ids,out_wts);
    }
}

// ---- Sprint 61: Vectorized float4 register-cached am_mix_fused depth-attention mix!
ink_mix :: (item:int,dim:int,n_blocks:int,blocks_buf:[]f32,cur:[]f32,query:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<INK_NT {
        am_mix_fused(0,dim,n_blocks,0.000001f32,blocks_buf,cur,query,item*dim,cur,0,out,item*dim,out,0);
    }
}

// ---- Sprint 61: Vectorized float4 register-cached am_mix_fused depth-attention mix + RMSNorm!
ink_mix_rmsnorm :: (item:int,dim:int,n_blocks:int,eps:f32,blocks_buf:[]f32,cur:[]f32,query:[]f32,norm_w:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<INK_NT {
        am_mix_fused(1,dim,n_blocks,eps,blocks_buf,cur,query,0,norm_w,0,out,0,out,0);
    }
}

// ---- Loop control prep (Sprint 31: hardware am_simd_sum, 1 barrier instead of 3!).
ink_ctrl_prep :: (item:int,dim:int,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;part2:[256]f32;
    for thread:0..<INK_NT {
        s1:f32=0;s2:f32=0;
        for k:0..<(dim+255)/256 {
            i:=k*256+thread;
            if i<dim {
                a:=cur[i];b:=msg[i];
                s1+=a*a;s2+=b*b;
            }
        }
        part[thread]=am_simd_sum(s1);
        part2[thread]=am_simd_sum(s2);
    }
    for thread:0..<INK_NT {
        t1:=part[0]+part[32]+part[64]+part[96]+part[128]+part[160]+part[192]+part[224];
        t2:=part2[0]+part2[32]+part2[64]+part2[96]+part2[128]+part2[160]+part2[192]+part2[224];
        inv1:=1.0f32/sqrt(t1/f32(dim)+0.000001f32);
        inv2:=1.0f32/sqrt(t2/f32(dim)+0.000001f32);
        for k:0..<(dim+255)/256 {
            i:=k*256+thread;
            if i<dim {
                out[i]=cur[i]*inv1;
                out[dim+i]=msg[i]*inv2;
            }
        }
    }
}

// ---- Loop control apply: out[i] = cur[i] - tanh(forget[i])*cur[i] + tanh(gain[i])*msg[i].
// Launch ceil(dim/256) items, 1 lane per item (or items=dim, lanes=1).
ink_ctrl_apply :: (item:int,dim:int,cur:[]f32,msg:[]f32,gain:[]f32,forget:[]f32,out:[]f32) #export_c #effects(all) {
    if item<dim {
        c:=cur[item];m:=msg[item];
        out[item]=c-ink_tanh(forget[item])*c+ink_tanh(gain[item])*m;
    }
}

// ---- Causal short convolution (l_cache=4) with residual + optional dynamic per-head taps.
// hist layout: [n_channels, 3] (3 oldest-to-newest past samples: hist[c*3+0]=t-3, +1=t-2, +2=t-1).
// weight layout: [n_channels, 4] (w[c*4+0]*x(t-3) + w[c*4+1]*x(t-2) + w[c*4+2]*x(t-1) + w[c*4+3]*x(t)).
// dynamic layout (if has_dyn!=0): [n_heads, 4] (lag 0 is x(t), lag 1 is x(t-1), lag 2 is x(t-2), lag 3 is x(t-3)).
// Launch items = n_channels, lanes = 1.
ink_convolve :: (item:int,n_channels:int,n_heads:int,has_dyn:int,cur:[]f32,w:[]f32,dyn:[]f32,hist:[]f32,out:[]f32) #export_c #effects(all) {
    if item<n_channels {
        c:=item;
        x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
        // update history in-place
        hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
        acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
        if has_dyn!=0 {
            head_dim:=n_channels/n_heads;
            h:=c/head_dim;
            acc+=dyn[h*4+0]*x3+dyn[h*4+1]*x2+dyn[h*4+2]*x1+dyn[h*4+3]*x0;
            out[c]=(x3+acc)/sqrt(9.0f32);
        } else {
            out[c]=(x3+acc)/sqrt(5.0f32);
        }
    }
}

// ---- Fused post shortconv + residual add (non-dynamic, n_heads=1):
// out[c] = res[c] + (x3 + x0*w0 + x1*w1 + x2*w2 + x3*w3) / sqrt(5).
// Eliminates 88 dispatches and 88 GPU barriers per decode token!
ink_convolve_add :: (item:int,n_channels:int,cur:[]f32,w:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    if item<n_channels {
        c:=item;
        x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
        hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
        acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
        out[c]=res[c]+(x3+acc)*0.4472135954999579f32;
    }
}

// ---- Per-head clip: optional per-channel scale, L2 norm clip to threshold, optional tau multiplier.
// Launch items = n_heads (each item handles head_dim elements, 1 threadgroup of 64 threads).
ink_clip :: (item:int,head_dim:int,has_scale:int,threshold:f32,tau:f32,x:[]f32,scale:[]f32) #export_c #effects(all) {
    part:[64]f32;
    hd:=cast(u32)head_dim;base:=mul_wrap(cast(u32)item,hd);
    for thread:0..<INK_T {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {
                idx:=cast(int)add_wrap(base,i);
                v:=x[idx];
                if has_scale!=0 {v=v*scale[idx];x[idx]=v;}
                s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        nrm:=sqrt(tot)+0.000001f32;
        fac:=threshold/nrm;
        if fac>1.0f32 {fac=1.0f32;}
        fac=fac*tau;
        t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {
                idx:=cast(int)add_wrap(base,i);
                x[idx]=x[idx]*fac;
            }
        }
    }
}

// ---- Per-head RMSNorm without weight (for Vcur: n_head_kv heads of head_dim).
// Launch items = n_heads (8), 1 threadgroup of 64 threads per head.
ink_head_rmsnorm :: (item:int,head_dim:int,eps:f32,x:[]f32) #export_c #effects(all) {
    part:[64]f32;
    hd:=cast(u32)head_dim;base:=mul_wrap(cast(u32)item,hd);
    for thread:0..<INK_T {
        s:f32=0;t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {v:=x[cast(int)add_wrap(base,i)];s+=v*v;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(head_dim)+eps);
        t:=cast(u32)thread;
        for k:cast(u32)0..<(hd+63)/64 {
            i:=add_wrap(mul_wrap(k,64),t);
            if i<hd {idx:=cast(int)add_wrap(base,i);x[idx]=x[idx]*inv;}
        }
    }
}

// ---- Sprint 28: Fused K shortconv + L2 clip + f16 KV cache store (-48 dispatches & -48 barriers/tok!).
// Launch items = n_head_kv, lanes = 64 (head_dim <= 256, 4 register slots/thread).
ink_conv_clip_kv :: (item:int,head_dim:int,n_kv_elem:int,slot_pos:int,has_dyn:int,threshold:f32,cur:[]f32,w:[]f32,dyn:[]f32,hist:[]f32,k_cache:[]u16) #export_c #effects(all) {
    part:[64]f32;
    buf:[256]f32;
    base:=item*head_dim;
    dbase:=slot_pos*n_kv_elem+base;
    inv_s:=ifx has_dyn!=0 then 0.3333333333333333f32 else 0.4472135954999579f32;
    for thread:0..<INK_T {
        s:f32=0;
        v0:f32=0;v1:f32=0;v2:f32=0;v3:f32=0;
        if thread<head_dim {
            c:=base+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v0=(x3+acc)*inv_s;s+=v0*v0;
        }
        if 64+thread<head_dim {
            c:=base+64+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v1=(x3+acc)*inv_s;s+=v1*v1;
        }
        if 128+thread<head_dim {
            c:=base+128+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v2=(x3+acc)*inv_s;s+=v2*v2;
        }
        if 192+thread<head_dim {
            c:=base+192+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v3=(x3+acc)*inv_s;s+=v3*v3;
        }
        buf[thread*4+0]=v0;buf[thread*4+1]=v1;buf[thread*4+2]=v2;buf[thread*4+3]=v3;
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        nrm:=sqrt(tot)+0.000001f32;
        fac:=threshold/nrm;
        if fac>1.0f32 {fac=1.0f32;}
        if thread<head_dim {k_cache[dbase+thread]=am_to_f16(buf[thread*4+0]*fac);}
        if 64+thread<head_dim {k_cache[dbase+64+thread]=am_to_f16(buf[thread*4+1]*fac);}
        if 128+thread<head_dim {k_cache[dbase+128+thread]=am_to_f16(buf[thread*4+2]*fac);}
        if 192+thread<head_dim {k_cache[dbase+192+thread]=am_to_f16(buf[thread*4+3]*fac);}
    }
}

// ---- Sprint 28: Fused V shortconv + head RMSNorm + f16 KV cache store (-48 dispatches & -48 barriers/tok!).
// Launch items = n_head_kv, lanes = 64 (head_dim <= 256, 4 register slots/thread).
ink_conv_head_rmsnorm_kv :: (item:int,head_dim:int,n_kv_elem:int,slot_pos:int,has_dyn:int,eps:f32,cur:[]f32,w:[]f32,dyn:[]f32,hist:[]f32,v_cache:[]u16) #export_c #effects(all) {
    part:[64]f32;
    buf:[256]f32;
    base:=item*head_dim;
    dbase:=slot_pos*n_kv_elem+base;
    inv_s:=ifx has_dyn!=0 then 0.3333333333333333f32 else 0.4472135954999579f32;
    for thread:0..<INK_T {
        s:f32=0;
        v0:f32=0;v1:f32=0;v2:f32=0;v3:f32=0;
        if thread<head_dim {
            c:=base+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v0=(x3+acc)*inv_s;s+=v0*v0;
        }
        if 64+thread<head_dim {
            c:=base+64+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v1=(x3+acc)*inv_s;s+=v1*v1;
        }
        if 128+thread<head_dim {
            c:=base+128+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v2=(x3+acc)*inv_s;s+=v2*v2;
        }
        if 192+thread<head_dim {
            c:=base+192+thread;
            x0:=hist[c*3+0];x1:=hist[c*3+1];x2:=hist[c*3+2];x3:=cur[c];
            hist[c*3+0]=x1;hist[c*3+1]=x2;hist[c*3+2]=x3;
            acc:=x0*w[c*4+0]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
            if has_dyn!=0 {acc+=dyn[item*4+0]*x3+dyn[item*4+1]*x2+dyn[item*4+2]*x1+dyn[item*4+3]*x0;}
            v3=(x3+acc)*inv_s;s+=v3*v3;
        }
        buf[thread*4+0]=v0;buf[thread*4+1]=v1;buf[thread*4+2]=v2;buf[thread*4+3]=v3;
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(head_dim)+eps);
        if thread<head_dim {v_cache[dbase+thread]=am_to_f16(buf[thread*4+0]*inv);}
        if 64+thread<head_dim {v_cache[dbase+64+thread]=am_to_f16(buf[thread*4+1]*inv);}
        if 128+thread<head_dim {v_cache[dbase+128+thread]=am_to_f16(buf[thread*4+2]*inv);}
        if 192+thread<head_dim {v_cache[dbase+192+thread]=am_to_f16(buf[thread*4+3]*inv);}
    }
}

// ---- Fused K L2 clip + f16 KV cache store (eliminates 48 K_KV_STORE + 48 barriers per decode token!).
// Launch items = n_head_kv (8), lanes = 64.
ink_clip_kv :: (item:int,head_dim:int,n_kv_elem:int,slot_pos:int,threshold:f32,x:[]f32,k_cache:[]u16) #export_c #effects(all) {
    part:[64]f32;
    base:=item*head_dim;
    dbase:=slot_pos*n_kv_elem+base;
    for thread:0..<INK_T {
        s:f32=0;
        for k:0..<(head_dim+63)/64 {
            i:=k*64+thread;
            if i<head_dim {v:=x[base+i];s+=v*v;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        nrm:=sqrt(tot)+0.000001f32;
        fac:=threshold/nrm;
        if fac>1.0f32 {fac=1.0f32;}
        for k:0..<(head_dim+63)/64 {
            i:=k*64+thread;
            if i<head_dim {k_cache[dbase+i]=am_to_f16(x[base+i]*fac);}
        }
    }
}

// ---- Fused V head RMSNorm + f16 KV cache store. Launch items = n_head_kv (8), lanes = 64.
ink_head_rmsnorm_kv :: (item:int,head_dim:int,n_kv_elem:int,slot_pos:int,eps:f32,x:[]f32,v_cache:[]u16) #export_c #effects(all) {
    part:[64]f32;
    base:=item*head_dim;
    dbase:=slot_pos*n_kv_elem+base;
    for thread:0..<INK_T {
        s:f32=0;
        for k:0..<(head_dim+63)/64 {
            i:=k*64+thread;
            if i<head_dim {v:=x[base+i];s+=v*v;}
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        inv:=1.0f32/sqrt(tot/f32(head_dim)+eps);
        for k:0..<(head_dim+63)/64 {
            i:=k*64+thread;
            if i<head_dim {v_cache[dbase+i]=am_to_f16(x[base+i]*inv);}
        }
    }
}

// ---- Store K and V into f16 KV cache at position `pos` (circular mod cap for SWA, or linear).
// k_cache / v_cache layout: [cap, n_head_kv, head_dim] u16.
// Launch items = n_head_kv * head_dim, lanes = 1.
ink_kv_store :: (item:int,n_kv_elem:int,slot_pos:int,k_in:[]f32,v_in:[]f32,k_cache:[]u16,v_cache:[]u16) #export_c #effects(all) {
    if item<n_kv_elem {
        dst:=slot_pos*n_kv_elem+item;
        k_cache[dst]=am_to_f16(k_in[item]);
        v_cache[dst]=am_to_f16(v_in[item]);
    }
}

// ---- Single-token GQA attention with relative position bias, sink=0, sliding window, and output sigmoid gate.
// Launch items = n_head (24), 1 threadgroup of 256 threads per Q head.
// Packed scalar args (keeps total kernel args <= 16 for metal-host.m):
//   dims0 = n_head | (n_head_kv << 16) | (head_dim << 32) | (n_rel << 48)
//   dims1 = extent | (is_swa << 24) | (swa << 32)
//   kv_info = kv_cap | (score_stride << 32)
// scratch_scores: [n_head * score_stride] f32 scratch buffer in device memory (score_stride >= max_ctx).
// pos: current 0-based token position.
// rel_bias: [extent, n_rel] f32; R: [n_head, n_rel] f32; sinks: [n_head] f32; gate: [n_head, head_dim] f32.
ink_attn :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,scratch_scores:[]f32,out:[]f32) #export_c #effects(all) {
    smax:[512]f32;ssum:[512]f32;rmax:[16]f32;rsum:[16]f32;vpart:[512]f32;qsh:[128]f32;rsh:[16]f32;
    n_head:=cast(int)(dims0&255);n_head_kv:=cast(int)((dims0>>8)&255);head_dim:=cast(int)((dims0>>16)&255);n_rel:=cast(int)((dims0>>24)&255);
    extent:=cast(int)(dims1&65535);is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    kv_cap:=cast(int)(kv_info&65535);score_stride:=cast(int)((kv_info>>16)&65535);
    h:=item;
    kv_h:=h/(n_head/n_head_kv);
    n_kv_elem:=n_head_kv*head_dim;
    scale:=1.0f32/sqrt(f32(head_dim));
    sink_val:=sinks[h];
    sbase:=h*score_stride;
    start:int=0;
    if is_swa!=0 && pos>=swa {start=pos-swa+1;}
    n_keys:=pos-start+1;
    n_chunks:=(n_keys+511)/512;
    for thread:0..<512 {
        if thread<head_dim {qsh[thread]=q[h*head_dim+thread];}
        if thread<n_rel {rsh[thread]=r[h*n_rel+thread];}
        smax[thread]=INK_NEG_INF;
        ssum[thread]=0.0f32;
    }
    for thread:0..<512 {
        lmax:f32=INK_NEG_INF;
        for c:0..<n_chunks {
            kidx:=c*512+thread;
            if kidx<n_keys {
                kp:=start+kidx;
                slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                kbase:=slot*n_kv_elem+kv_h*head_dim;
                dot:f32=0.0f32;
                for d:0..<INK_HEAD {dot+=qsh[d]*ink_half(cast(u32)k_cache[kbase+d]);}
                dist:=pos-kp;
                rb:f32=0.0f32;
                if dist<extent {
                    rb_base:=dist*n_rel;
                    for j:0..<INK_REL {rb+=rel_bias[rb_base+j]*rsh[j];}
                }
                score:=dot*scale+rb-sink_val;
                scratch_scores[sbase+kidx]=score;
                if score>lmax {lmax=score;}
            }
        }
        smax[thread]=lmax;
    }
    for thread:0..<512 {
        if thread<16 {
            mx:f32=0.0f32;
            for j:0..<32 {v:=smax[j*16+thread];if v>mx {mx=v;}}
            rmax[thread]=mx;
        }
    }
    for thread:0..<512 {
        gmax:f32=0.0f32;
        for j:0..<16 {if rmax[j]>gmax {gmax=rmax[j];}}
        lsum:f32=0.0f32;
        for c:0..<n_chunks {
            kidx:=c*512+thread;
            if kidx<n_keys {
                w:=exp(scratch_scores[sbase+kidx]-gmax);
                scratch_scores[sbase+kidx]=w;
                lsum+=w;
            }
        }
        ssum[thread]=lsum;
    }
    for thread:0..<512 {
        if thread<16 {
            sm:f32=0.0f32;
            for j:0..<32 {sm+=ssum[j*16+thread];}
            rsum[thread]=sm;
        }
    }
    for thread:0..<512 {
        d:=thread%128;
        part_id:=thread/128;
        vsum:f32=0.0f32;
        for step:0..<(n_keys+3)/4 {
            kidx:=step*4+part_id;
            if kidx<n_keys {
                kp:=start+kidx;
                slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                kbase:=slot*n_kv_elem+kv_h*head_dim;
                vsum+=scratch_scores[sbase+kidx]*ink_half(cast(u32)v_cache[kbase+d]);
            }
        }
        vpart[thread]=vsum;
    }
    for thread:0..<512 {
        if thread<head_dim {
            gmax:f32=0.0f32;
            for j:0..<16 {if rmax[j]>gmax {gmax=rmax[j];}}
            gsum:f32=exp(-gmax);
            for j:0..<16 {gsum+=rsum[j];}
            vtot:=vpart[thread]+vpart[thread+128]+vpart[thread+256]+vpart[thread+384];
            idx:=h*head_dim+thread;
            out[idx]=(vtot/gsum)*ink_sigmoid(gate[idx]);
        }
    }
}

// ---- Residual add: dst[i] = a[i] + b[i]. Launch items = ceil(n/256), lanes = 256 (hits _n32 even for n > 1M!).
ink_add :: (item:int,n:int,a:[]f32,b:[]f32,dst:[]f32) #export_c #effects(all) {
    base:=item*INK_NT;
    for thread:0..<INK_NT {
        idx:=base+thread;
        if idx<n {dst[idx]=a[idx]+b[idx];}
    }
}

// ---- Copy: dst[i] = src[i]. Launch items = ceil(n/256), lanes = 256 (hits _n32 even for n > 1M!).
ink_copy :: (item:int,n:int,src:[]f32,dst:[]f32) #export_c #effects(all) {
    base:=item*INK_NT;
    for thread:0..<INK_NT {
        idx:=base+thread;
        if idx<n {dst[idx]=src[idx];}
    }
}

// ---- Final logit softcapping: x[i] = cap * tanh(x[i] / cap). Launch items = ceil(n/256), lanes = 256.
ink_softcap :: (item:int,n:int,cap:f32,x:[]f32) #export_c #effects(all) {
    base:=item*INK_NT;
    for thread:0..<INK_NT {
        idx:=base+thread;
        if idx<n {x[idx]=cap*ink_tanh(x[idx]/cap);}
    }
}

// ============================================================================
// Batched prefill kernels (chunk size B <= 64) using Apple simdgroup MMA.
// ============================================================================

// ---- Batched matmul Q8_0: out[t*rows+r] = sum_k x[t*cols+k] * W_q8[r,k] for 0<=t<n_tok.
// 2D-tiled: t_tiles = ceil(n_tok/64), r_tiles = ceil(rows/32), launch items = t_tiles * r_tiles, lanes = 128.
// Uses 4 threads/row (b[thread*8 + 0..7]): 1 ink_half & 4 u16 loads per thread instead of 8 & 16!
ink_mm_q8 :: (item:int,rows:int,cols:int,n_tok:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    a:[2048]f32;b:[1024]f32;acc:[2048]f32;
    r_tiles:=(rows+31)/32;
    t0:=(item/r_tiles)*64;
    r0:=(item%r_tiles)*32;
    m_rem:=n_tok-t0;
    if m_rem>64 {m_rem=64;}
    n_a_iters:=(m_rem+3)/4;
    if n_a_iters<16 {
        for thread:0..<128 {
            for i:0..<16 {if i>=n_a_iters {a[thread+128*i]=0.0f32;}}
        }
    }
    blocks:=cols/32;words:=blocks*17;
    for blk:0..<blocks {
        xb:=blk*32;boff:=blk*17;
        for thread:0..<128 {
            col:=thread%32;
            t_off:=thread/32;
            for i:0..<16 {
                if i<n_a_iters {
                    t:=t0+t_off+4*i;
                    v:f32=0.0f32;
                    if t<n_tok {v=x[t*cols+xb+col];}
                    a[thread+128*i]=v;
                }
            }
            // 4 threads per row: r_loc = thread/4, sub = thread%4 -> b[thread*8 + 0..7] == b[r_loc*32 + sub*8 + 0..7]!
            row:=r0+thread/4;
            sub:=thread%4;
            if row<rows {
                at:=row*words+boff;
                sc:=ink_half(cast(u32)w[at]);
                wbase:=at+1+sub*4;
                v0:=cast(u32)w[wbase+0];
                b[thread*8+0]=sc*ink_signed(v0&255);b[thread*8+1]=sc*ink_signed(v0>>8);
                v1:=cast(u32)w[wbase+1];
                b[thread*8+2]=sc*ink_signed(v1&255);b[thread*8+3]=sc*ink_signed(v1>>8);
                v2:=cast(u32)w[wbase+2];
                b[thread*8+4]=sc*ink_signed(v2&255);b[thread*8+5]=sc*ink_signed(v2>>8);
                v3:=cast(u32)w[wbase+3];
                b[thread*8+6]=sc*ink_signed(v3&255);b[thread*8+7]=sc*ink_signed(v3>>8);
            } else {
                b[thread*8+0]=0.0f32;b[thread*8+1]=0.0f32;b[thread*8+2]=0.0f32;b[thread*8+3]=0.0f32;
                b[thread*8+4]=0.0f32;b[thread*8+5]=0.0f32;b[thread*8+6]=0.0f32;b[thread*8+7]=0.0f32;
            }
        }
        am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    }
    am_sg_spill_64x32(acc[..],a[..]);
    for thread:0..<128 {
        for i:0..<n_a_iters {
            e:=thread+128*i;
            t:=t0+e/32;c:=e%32;
            row:=r0+c;
            if t<n_tok && row<rows {out[t*rows+row]=a[e];}
        }
    }
}

// ---- Batched matmul F32: out[t*rows+r] = sum_k x[t*cols+k] * W_f32[r,k] for 0<=t<n_tok.
// 2D-tiled: launch items = ceil(n_tok/64) * ceil(rows/32), lanes = 128.
ink_mm_f32 :: (item:int,rows:int,cols:int,n_tok:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    a:[2048]f32;b:[1024]f32;acc:[2048]f32;
    r_tiles:=(rows+31)/32;
    t0:=(item/r_tiles)*64;
    r0:=(item%r_tiles)*32;
    m_rem:=n_tok-t0;
    if m_rem>64 {m_rem=64;}
    n_a_iters:=(m_rem+3)/4;
    if n_a_iters<16 {
        for thread:0..<128 {
            for i:0..<16 {if i>=n_a_iters {a[thread+128*i]=0.0f32;}}
        }
    }
    blocks:=(cols+31)/32;
    for blk:0..<blocks {
        xb:=blk*32;
        for thread:0..<128 {
            col:=thread%32;
            t_off:=thread/32;
            c_idx:=xb+col;
            for i:0..<16 {
                if i<n_a_iters {
                    t:=t0+t_off+4*i;
                    v:f32=0.0f32;
                    if t<n_tok && c_idx<cols {v=x[t*cols+c_idx];}
                    a[thread+128*i]=v;
                }
            }
            for i:0..<8 {
                r_loc:=t_off+4*i;
                row:=r0+r_loc;
                v:f32=0.0f32;
                if row<rows && c_idx<cols {v=w[row*cols+c_idx];}
                b[thread+128*i]=v;
            }
        }
        am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    }
    am_sg_spill_64x32(acc[..],a[..]);
    for thread:0..<128 {
        for i:0..<16 {
            e:=thread+128*i;
            t:=t0+e/32;c:=e%32;
            row:=r0+c;
            if t<n_tok && row<rows {out[t*rows+row]=a[e];}
        }
    }
}

// ---- Batched embedding lookup from Q8_0 token_embd + tok_norm. Launch items = n_tok, lanes = 256.
ink_embed_q8_batch :: (item:int,dim:int,toks:[]u32,w:[]u16,norm_w:[]f32,eps:f32,out:[]f32) #export_c #effects(all) {
    part:[256]f32;part2:[16]f32;
    tok:=cast(int)toks[item];
    blocks:=dim/32;row_words:=blocks*17;base:=tok*row_words;
    obase:=item*dim;
    for thread:0..<INK_NT {
        s:f32=0;
        for k:0..<(dim+255)/256 {
            i:=k*256+thread;
            if i<dim {
                blk:=i/32;off:=i%32;at:=base+blk*17;
                sc:=ink_half(cast(u32)w[at]);
                word:=cast(u32)w[at+1+off/2];
                q:=ifx (off%2)==0 then word&255 else (word>>8)&255;
                v:=sc*ink_signed(q);
                out[obase+i]=v;s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_NT {
        if thread<16 {
            s:f32=0;for j:0..<16 {s+=part[j*16+thread];}part2[thread]=s;
        }
    }
    for thread:0..<INK_NT {
        tot:f32=0;for j:0..<16 {tot+=part2[j];}
        inv:=1.0f32/sqrt(tot/f32(dim)+eps);
        for k:0..<(dim+255)/256 {
            i:=k*256+thread;
            if i<dim {out[obase+i]=out[obase+i]*inv*norm_w[i];}
        }
    }
}

// ---- Batched depth-attention residual mix.
// blocks_buf is [n_blocks, n_tok, dim]; cur is [n_tok, dim]; query is [n_queries, dim]; out is [n_queries, n_tok, dim].
// Launch items = n_queries * n_tok, lanes = 256.
// ---- Sprint 20: Batched Depth-Attention Mix (256 threads, 4-state chunked -> 4x fewer barriers & query reads!).
ink_mix_batch :: (item:int,dim:int,n_blocks:int,n_tok:int,blocks_buf:[]f32,cur:[]f32,query:[]f32,out:[]f32) #export_c #effects(all) {
    // Sprint 64: Native float4 register-cached single-pass depth-attention mix!
    q_idx:=item/n_tok;
    t_idx:=item%n_tok;
    for thread:0..<INK_NT {
        am_mix_batch_f32(dim,n_blocks,n_tok,q_idx,t_idx,blocks_buf,cur,query,out);
    }
}


// ---- Batched loop control prep: concat(rms(cur[t]), rms(msg[t])) into out[t*2*dim..].
// Launch items = n_tok, lanes = 256. Sprint 57: hardware am_simd_sum (1 barrier instead of 3!).
ink_ctrl_prep_batch :: (item:int,dim:int,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    r1:[256]f32;r2:[256]f32;
    base:=item*dim;obase:=item*2*dim;
    for thread:0..<INK_NT {
        s1:f32=0;s2:f32=0;
        for k:0..<(dim+255)/256 {
            i:=k*256+thread;
            if i<dim {
                a:=cur[base+i];b:=msg[base+i];
                s1+=a*a;s2+=b*b;
            }
        }
        r1[thread]=am_simd_sum(s1);r2[thread]=am_simd_sum(s2);
    }
    for thread:0..<INK_NT {
        t1:=r1[0]+r1[32]+r1[64]+r1[96]+r1[128]+r1[160]+r1[192]+r1[224];
        t2:=r2[0]+r2[32]+r2[64]+r2[96]+r2[128]+r2[160]+r2[192]+r2[224];
        inv1:=1.0f32/sqrt(t1/f32(dim)+0.000001f32);
        inv2:=1.0f32/sqrt(t2/f32(dim)+0.000001f32);
        for k:0..<(dim+255)/256 {
            i:=k*256+thread;
            if i<dim {
                out[obase+i]=cur[base+i]*inv1;
                out[obase+dim+i]=msg[base+i]*inv2;
            }
        }
    }
}

// ---- Sprint 16B: Batched fused loop_ctrl_gain + loop_ctrl_forget + apply (8 tokens/TG -> 8x less weight traffic!).
// Launch items = ceil(n_tok / 8) * ceil(dim / 64), lanes = 64.
ink_ctrl_up_apply_batch :: (item:int,dim:int,rank:int,n_tok:int,w_gain:[]f32,w_forget:[]f32,gate:[]f32,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    gsh:[512]f32;
    groups:=(dim+INK_T-1)/INK_T;
    t0:=(item/groups)*8;
    grp:=item%groups;
    mc:=n_tok-t0;
    if mc>8 {mc=8;}
    for thread:0..<INK_T {
        for m:0..<8 {
            v:f32=0.0f32;
            if m<mc && thread<rank {v=gate[(t0+m)*rank+thread];}
            gsh[thread*8+m]=v;
        }
    }
    for thread:0..<INK_T {
        row:=grp*INK_T+thread;
        if row<dim {
            base:=row*rank;
            sg0:f32=0;sg1:f32=0;sg2:f32=0;sg3:f32=0;sg4:f32=0;sg5:f32=0;sg6:f32=0;sg7:f32=0;
            sf0:f32=0;sf1:f32=0;sf2:f32=0;sf3:f32=0;sf4:f32=0;sf5:f32=0;sf6:f32=0;sf7:f32=0;
            for k:0..<rank {
                wg:=w_gain[base+k];
                wf:=w_forget[base+k];
                kb:=k*8;
                gv0:=gsh[kb+0];sg0+=wg*gv0;sf0+=wf*gv0;
                if mc>1 {gv1:=gsh[kb+1];sg1+=wg*gv1;sf1+=wf*gv1;}
                if mc>2 {gv2:=gsh[kb+2];sg2+=wg*gv2;sf2+=wf*gv2;}
                if mc>3 {gv3:=gsh[kb+3];sg3+=wg*gv3;sf3+=wf*gv3;}
                if mc>4 {gv4:=gsh[kb+4];sg4+=wg*gv4;sf4+=wf*gv4;}
                if mc>5 {gv5:=gsh[kb+5];sg5+=wg*gv5;sf5+=wf*gv5;}
                if mc>6 {gv6:=gsh[kb+6];sg6+=wg*gv6;sf6+=wf*gv6;}
                if mc>7 {gv7:=gsh[kb+7];sg7+=wg*gv7;sf7+=wf*gv7;}
            }
            i0:=t0*dim+row;c0:=cur[i0];out[i0]=c0-ink_tanh(sf0)*c0+ink_tanh(sg0)*msg[i0];
            if mc>1 {i1:=i0+dim;c1:=cur[i1];out[i1]=c1-ink_tanh(sf1)*c1+ink_tanh(sg1)*msg[i1];}
            if mc>2 {i2:=i0+2*dim;c2:=cur[i2];out[i2]=c2-ink_tanh(sf2)*c2+ink_tanh(sg2)*msg[i2];}
            if mc>3 {i3:=i0+3*dim;c3:=cur[i3];out[i3]=c3-ink_tanh(sf3)*c3+ink_tanh(sg3)*msg[i3];}
            if mc>4 {i4:=i0+4*dim;c4:=cur[i4];out[i4]=c4-ink_tanh(sf4)*c4+ink_tanh(sg4)*msg[i4];}
            if mc>5 {i5:=i0+5*dim;c5:=cur[i5];out[i5]=c5-ink_tanh(sf5)*c5+ink_tanh(sg5)*msg[i5];}
            if mc>6 {i6:=i0+6*dim;c6:=cur[i6];out[i6]=c6-ink_tanh(sf6)*c6+ink_tanh(sg6)*msg[i6];}
            if mc>7 {i7:=i0+7*dim;c7:=cur[i7];out[i7]=c7-ink_tanh(sf7)*c7+ink_tanh(sg7)*msg[i7];}
        }
    }
}

// ---- Batched causal 4-tap depthwise shortconv over n_tok tokens (Sprint 55: 2D coalesced parallel!).
// Launch items = ((n_tok+31)/32) * ((n_channels+63)/64), lanes = 64.
// Tile t0==0 reads initial hist into registers, immediately writes final hist (100% race-free!), then computes t=0..<min(32,n_tok).
ink_convolve_batch :: (item:int,n_channels:int,n_heads:int,has_dyn:int,n_tok:int,cur:[]f32,w:[]f32,dyn:[]f32,hist:[]f32,out:[]f32) #export_c #effects(all) {
    c_tiles:=(n_channels+63)/64;
    t0:=(item/c_tiles)*32;
    c0:=(item%c_tiles)*64;
    t_end:=ifx t0+32<n_tok then t0+32 else n_tok;
    ch_per_head:=ifx n_heads>0 then n_channels/n_heads else 1;
    dyn_stride:=n_heads*4;
    inv_s:=ifx has_dyn!=0 then 1.0f32/3.0f32 else 1.0f32/sqrt(5.0f32);
    for thread:0..<64 {
        ch:=c0+thread;
        if ch<n_channels {
            wb:=ch*4;
            w0:=w[wb+0];w1:=w[wb+1];w2:=w[wb+2];w3:=w[wb+3];
            head:=ifx n_heads>0 then ch/ch_per_head else 0;
            x0:f32=0;x1:f32=0;x2:f32=0;
            if t0==0 {
                h_idx:=ch*3;
                x0=hist[h_idx+0];x1=hist[h_idx+1];x2=hist[h_idx+2];
                if n_tok>=3 {
                    hist[h_idx+0]=cur[(n_tok-3)*n_channels+ch];
                    hist[h_idx+1]=cur[(n_tok-2)*n_channels+ch];
                    hist[h_idx+2]=cur[(n_tok-1)*n_channels+ch];
                } else if n_tok==2 {
                    hist[h_idx+0]=x2;
                    hist[h_idx+1]=cur[ch];
                    hist[h_idx+2]=cur[n_channels+ch];
                } else if n_tok==1 {
                    hist[h_idx+0]=x1;
                    hist[h_idx+1]=x2;
                    hist[h_idx+2]=cur[ch];
                }
            } else {
                x0=cur[(t0-3)*n_channels+ch];
                x1=cur[(t0-2)*n_channels+ch];
                x2=cur[(t0-1)*n_channels+ch];
            }
            for t:t0..<t_end {
                idx:=t*n_channels+ch;
                x3:=cur[idx];
                acc:=x0*w0+x1*w1+x2*w2+x3*w3;
                if has_dyn!=0 {
                    db:=t*dyn_stride+head*4;
                    acc+=dyn[db+0]*x3+dyn[db+1]*x2+dyn[db+2]*x1+dyn[db+3]*x0;
                }
                out[idx]=(x3+acc)*inv_s;
                x0=x1;x1=x2;x2=x3;
            }
        }
    }
}

// ---- Fused batched post shortconv + residual add (Sprint 55: 2D coalesced parallel!).
// Launch items = ((n_tok+31)/32) * ((n_channels+63)/64), lanes = 64.
ink_convolve_add_batch :: (item:int,n_channels:int,n_tok:int,cur:[]f32,w:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    c_tiles:=(n_channels+63)/64;
    t0:=(item/c_tiles)*32;
    c0:=(item%c_tiles)*64;
    t_end:=ifx t0+32<n_tok then t0+32 else n_tok;
    inv_s:=1.0f32/sqrt(5.0f32);
    for thread:0..<64 {
        ch:=c0+thread;
        if ch<n_channels {
            wb:=ch*4;
            w0:=w[wb+0];w1:=w[wb+1];w2:=w[wb+2];w3:=w[wb+3];
            x0:f32=0;x1:f32=0;x2:f32=0;
            if t0==0 {
                h_idx:=ch*3;
                x0=hist[h_idx+0];x1=hist[h_idx+1];x2=hist[h_idx+2];
                if n_tok>=3 {
                    hist[h_idx+0]=cur[(n_tok-3)*n_channels+ch];
                    hist[h_idx+1]=cur[(n_tok-2)*n_channels+ch];
                    hist[h_idx+2]=cur[(n_tok-1)*n_channels+ch];
                } else if n_tok==2 {
                    hist[h_idx+0]=x2;
                    hist[h_idx+1]=cur[ch];
                    hist[h_idx+2]=cur[n_channels+ch];
                } else if n_tok==1 {
                    hist[h_idx+0]=x1;
                    hist[h_idx+1]=x2;
                    hist[h_idx+2]=cur[ch];
                }
            } else {
                x0=cur[(t0-3)*n_channels+ch];
                x1=cur[(t0-2)*n_channels+ch];
                x2=cur[(t0-1)*n_channels+ch];
            }
            for t:t0..<t_end {
                idx:=t*n_channels+ch;
                x3:=cur[idx];
                acc:=x0*w0+x1*w1+x2*w2+x3*w3;
                out[idx]=res[idx]+(x3+acc)*inv_s;
                x0=x1;x1=x2;x2=x3;
            }
        }
    }
}

// ---- Batched per-head L2 clip: optional per-channel scale, L2 norm clip to threshold, scalar or per-token tau multiplier.
// Launch items = n_tok * n_heads, lanes = 64.
ink_clip_batch :: (item:int,head_dim:int,n_heads:int,has_scale:int,threshold:f32,use_tau_vec:int,tau:f32,x:[]f32,scale:[]f32,tau_vec:[]f32) #export_c #effects(all) {
    part:[64]f32;
    base:=item*head_dim;
    tok:=item/n_heads;
    h:=item%n_heads;
    sbase:=h*head_dim;
    t:=ifx use_tau_vec!=0 then tau_vec[tok] else tau;
    for thread:0..<INK_T {
        s:f32=0;
        for k:0..<(head_dim+INK_T-1)/INK_T {
            i:=k*INK_T+thread;
            if i<head_dim {
                idx:=base+i;
                v:=x[idx];
                if has_scale!=0 {v=v*scale[sbase+i];x[idx]=v;}
                s+=v*v;
            }
        }
        part[thread]=s;
    }
    for thread:0..<INK_T {
        tot:f32=0;for j:0..<INK_T {tot+=part[j];}
        nrm:=sqrt(tot)+0.000001f32;
        fac:=threshold/nrm;
        if fac>1.0f32 {fac=1.0f32;}
        fac=fac*t;
        for k:0..<(head_dim+INK_T-1)/INK_T {
            i:=k*INK_T+thread;
            if i<head_dim {x[base+i]=x[base+i]*fac;}
        }
    }
}

// ---- Batched KV cache store. Launch items = n_tok, lanes = 128 (hits _n32!).
ink_kv_store_batch :: (item:int,n_kv_elem:int,pos0:int,kv_cap:int,is_swa:int,k_in:[]f32,v_in:[]f32,k_cache:[]u16,v_cache:[]u16) #export_c #effects(all) {
    p:=pos0+item;
    slot:=ifx is_swa!=0 then p%kv_cap else p;
    sbase:=item*n_kv_elem;
    dbase:=slot*n_kv_elem;
    steps:=(n_kv_elem+127)/128;
    for thread:0..<128 {
        for st:0..<steps {
            e:=st*128+thread;
            if e<n_kv_elem {
                k_cache[dbase+e]=am_to_f16(k_in[sbase+e]);
                v_cache[dbase+e]=am_to_f16(v_in[sbase+e]);
            }
        }
    }
}

// ---- Sprint 20: Parallel rank-based Batched Router (256 threads, 2 TGEM barriers instead of 18!).
ink_router_batch :: (item:int,n_exp:int,n_used:int,has_bias:int,scale:f32,logits:[]f32,bias:[]f32,out_ids:[]u32,out_wts:[]f32) #export_c #effects(all) {
    probs:[256]f32;sel:[256]f32;ranks:[256]int;
    lbase:=item*n_exp;
    obase:=item*n_used;
    for thread:0..<INK_NT {
        if thread<n_exp {
            p:=ink_sigmoid(logits[lbase+thread]);
            probs[thread]=p;
            sel[thread]=ifx has_bias!=0 then p+bias[thread] else p;
        } else {
            probs[thread]=0.0f32;
            sel[thread]=INK_NEG_INF;
        }
    }
    for thread:0..<INK_NT {
        rank:int=999;
        if thread<n_exp {
            my_s:=sel[thread];
            rank=0;
            for j:0..<n_exp {
                sj:=sel[j];
                if sj>my_s || (sj==my_s && j<thread) {rank+=1;}
            }
        }
        ranks[thread]=rank;
    }
    for thread:0..<INK_NT {
        if thread<n_exp && ranks[thread]<n_used {
            r:=ranks[thread];
            wsum:f32=0;
            for e:0..<n_exp {if ranks[e]<n_used {wsum+=probs[e];}}
            if wsum<0.00006103515625f32 {wsum=0.00006103515625f32;}
            out_ids[obase+r]=cast(u32)thread;
            out_wts[obase+r]=probs[thread]*(scale/wsum);
        }
    }
}

// ---- Sprint 16B: Parallel expert grouping (128 threads/expert instead of 1 -> 128x more parallelism!).
// Launch items = n_expert (128), lanes = 128.
ink_moe_group_batch :: (item:int,n_tok:int,n_used:int,ids:[]u32,wts:[]f32,exp_toks:[]u32,exp_slots:[]u32,exp_wts:[]f32,exp_cnt:[]u32) #export_c #effects(all) {
    cnt_sh:[128]u32;off_sh:[128]u32;
    exp_u:=cast(u32)item;
    base:=item*INK_PREFILL_B;
    chunk:=(n_tok+127)/128;
    for thread:0..<128 {
        t_lo:=thread*chunk;
        t_hi:=t_lo+chunk;
        if t_hi>n_tok {t_hi=n_tok;}
        c:u32=0;
        for t:t_lo..<t_hi {
            tb:=t*n_used;
            for s:0..<n_used {
                if ids[tb+s]==exp_u {c+=1;}
            }
        }
        cnt_sh[thread]=c;
    }
    for thread:0..<128 {
        if thread<128 {
            off:u32=0;
            for j:0..<thread {off+=cnt_sh[j];}
            off_sh[thread]=off;
            if thread==127 {
                tot:=off+cnt_sh[127];
                if tot>cast(u32)INK_PREFILL_B {tot=cast(u32)INK_PREFILL_B;}
                exp_cnt[item]=tot;
            }
        }
    }
    for thread:0..<128 {
        if cnt_sh[thread]>0 {
            t_lo:=thread*chunk;
            t_hi:=t_lo+chunk;
            if t_hi>n_tok {t_hi=n_tok;}
            pos:=cast(int)off_sh[thread];
            for t:t_lo..<t_hi {
                tb:=t*n_used;
                for s:0..<n_used {
                    if ids[tb+s]==exp_u {
                        if pos<INK_PREFILL_B {
                            exp_toks[base+pos]=cast(u32)t;
                            exp_slots[base+pos]=cast(u32)s;
                            exp_wts[base+pos]=wts[tb+s];
                            pos+=1;
                        }
                    }
                }
            }
        }
    }
}

// ---- Build compact list of active (exp_id, m0) MoE tiles of size tile_m (4 for small prompts, 64 for MMA).
// Launch items = 1, lanes = 1.
ink_moe_build_tiles :: (item:int,n_exp:int,tile_m:int,r_mul0:int,r_mul1:int,exp_cnt:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32) #export_c #effects(all) {
    t:int=0;
    for e:0..<n_exp {
        cnt:=cast(int)exp_cnt[e];
        if cnt>0 {
            nt:=(cnt+tile_m-1)/tile_m;
            for k:0..<nt {
                tile_exp[t]=cast(u32)e;
                tile_m0[t]=cast(u32)(k*tile_m);
                t+=1;
            }
        }
    }
    tile_cnt[0]=cast(u32)t;
    tile_cnt[4]=cast(u32)(t*r_mul0); tile_cnt[5]=1; tile_cnt[6]=1;
    tile_cnt[8]=cast(u32)(t*r_mul1); tile_cnt[9]=1; tile_cnt[10]=1;
}

// ---- Batched Expert-Grouped MoE gate_up via Apple hardware MMA (IQ4_NL), compacted active tiles.
// Launch items = max_tiles * ceil(2*n_ff / 32), lanes = 128.
ink_moe_gu_batch_iq4 :: (item:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,exp_toks:[]u32,exp_slots:[]u32,exp_cnt:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,gu_out:[]f32) #export_c #effects(all) {
    a:[2048]f32;b:[1024]f32;acc:[2048]f32;lut:[16]f32;tsh:[64]u32;
    r_tiles:=(rows+31)/32;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*32;
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        nm:=cast(int)exp_cnt[exp_id];
        ebase:=exp_id*INK_PREFILL_B;
        m_rem:=nm-m0;
        if m_rem>64 {m_rem=64;}
        n_a_iters:=(m_rem+3)/4;
        for thread:0..<128 {
            if thread<16 {lut[thread]=ink_iq4_val(cast(u32)thread);}
            if thread<64 {
                mi:=m0+thread;
                tsh[thread]=ifx mi<nm then exp_toks[ebase+mi] else 4294967295;
            }
            for i:0..<16 {if i>=n_a_iters {a[thread+128*i]=0.0f32;}}
        }
        blocks:=cols/32;row_words:=blocks*9;
        exp_base:=exp_id*rows*row_words;
        for blk:0..<blocks {
            xb:=blk*32;boff:=blk*9;
            for thread:0..<128 {
                col:=thread%32;
                t_off:=thread/32;
                for i:0..<16 {
                    if i<n_a_iters {
                        tu:=tsh[t_off+4*i];
                        v:f32=0.0f32;
                        if tu!=4294967295 {v=x[cast(int)tu*cols+xb+col];}
                        a[thread+128*i]=v;
                    }
                }
                // 4 threads/row: sub 0->elem 0..7 (w[1..4] lo nibs), sub 1->elem 8..15 (w[5..8] lo nibs),
                //                sub 2->elem 16..23 (w[1..4] hi nibs), sub 3->elem 24..31 (w[5..8] hi nibs).
                row:=r0+thread/4;
                sub:=thread%4;
                if row<rows {
                    at:=exp_base+row*row_words+boff;
                    sc:=ink_half(cast(u32)w[at]);
                    wbase:=at+1+(sub%2)*4;
                    if sub<2 {
                        v0:=cast(u32)w[wbase+0];
                        b[thread*8+0]=sc*lut[cast(int)(v0&15)];b[thread*8+1]=sc*lut[cast(int)((v0>>8)&15)];
                        v1:=cast(u32)w[wbase+1];
                        b[thread*8+2]=sc*lut[cast(int)(v1&15)];b[thread*8+3]=sc*lut[cast(int)((v1>>8)&15)];
                        v2:=cast(u32)w[wbase+2];
                        b[thread*8+4]=sc*lut[cast(int)(v2&15)];b[thread*8+5]=sc*lut[cast(int)((v2>>8)&15)];
                        v3:=cast(u32)w[wbase+3];
                        b[thread*8+6]=sc*lut[cast(int)(v3&15)];b[thread*8+7]=sc*lut[cast(int)((v3>>8)&15)];
                    } else {
                        v0:=cast(u32)w[wbase+0];
                        b[thread*8+0]=sc*lut[cast(int)((v0>>4)&15)];b[thread*8+1]=sc*lut[cast(int)(v0>>12)];
                        v1:=cast(u32)w[wbase+1];
                        b[thread*8+2]=sc*lut[cast(int)((v1>>4)&15)];b[thread*8+3]=sc*lut[cast(int)(v1>>12)];
                        v2:=cast(u32)w[wbase+2];
                        b[thread*8+4]=sc*lut[cast(int)((v2>>4)&15)];b[thread*8+5]=sc*lut[cast(int)(v2>>12)];
                        v3:=cast(u32)w[wbase+3];
                        b[thread*8+6]=sc*lut[cast(int)((v3>>4)&15)];b[thread*8+7]=sc*lut[cast(int)(v3>>12)];
                    }
                } else {
                    b[thread*8+0]=0.0f32;b[thread*8+1]=0.0f32;b[thread*8+2]=0.0f32;b[thread*8+3]=0.0f32;
                    b[thread*8+4]=0.0f32;b[thread*8+5]=0.0f32;b[thread*8+6]=0.0f32;b[thread*8+7]=0.0f32;
                }
            }
            am_sg_mma_64x32x32(acc[..],a[..],b[..]);
        }
        am_sg_spill_64x32(acc[..],a[..]);
        for thread:0..<128 {
            for i:0..<n_a_iters {
                e:=thread+128*i;
                mi:=m0+e/32;c:=e%32;
                row:=r0+c;
                if mi<nm && row<rows {
                    tt:=cast(int)tsh[e/32];
                    ss:=cast(int)exp_slots[ebase+mi];
                    gu_out[(tt*n_used+ss)*rows+row]=a[e];
                }
            }
        }
    }
}

// ---- Batched Expert-Grouped MoE gate_up via Apple hardware MMA (Q8_0, last 4 layers), compacted active tiles.
// Launch items = max_tiles * ceil(2*n_ff / 32), lanes = 128.
ink_moe_gu_batch_q8 :: (item:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,exp_toks:[]u32,exp_slots:[]u32,exp_cnt:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,gu_out:[]f32) #export_c #effects(all) {
    a:[2048]f32;b:[1024]f32;acc:[2048]f32;tsh:[64]u32;
    r_tiles:=(rows+31)/32;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*32;
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        nm:=cast(int)exp_cnt[exp_id];
        ebase:=exp_id*INK_PREFILL_B;
        m_rem:=nm-m0;
        if m_rem>64 {m_rem=64;}
        n_a_iters:=(m_rem+3)/4;
        for thread:0..<128 {
            if thread<64 {
                mi:=m0+thread;
                tsh[thread]=ifx mi<nm then exp_toks[ebase+mi] else 4294967295;
            }
            for i:0..<16 {if i>=n_a_iters {a[thread+128*i]=0.0f32;}}
        }
        blocks:=cols/32;row_words:=blocks*17;
        exp_base:=exp_id*rows*row_words;
        for blk:0..<blocks {
            xb:=blk*32;boff:=blk*17;
            for thread:0..<128 {
                col:=thread%32;
                t_off:=thread/32;
                for i:0..<16 {
                    if i<n_a_iters {
                        tu:=tsh[t_off+4*i];
                        v:f32=0.0f32;
                        if tu!=4294967295 {v=x[cast(int)tu*cols+xb+col];}
                        a[thread+128*i]=v;
                    }
                }
                row:=r0+thread/4;
                sub:=thread%4;
                if row<rows {
                    at:=exp_base+row*row_words+boff;
                    sc:=ink_half(cast(u32)w[at]);
                    wbase:=at+1+sub*4;
                    v0:=cast(u32)w[wbase+0];b[thread*8+0]=sc*ink_signed(v0&255);b[thread*8+1]=sc*ink_signed(v0>>8);
                    v1:=cast(u32)w[wbase+1];b[thread*8+2]=sc*ink_signed(v1&255);b[thread*8+3]=sc*ink_signed(v1>>8);
                    v2:=cast(u32)w[wbase+2];b[thread*8+4]=sc*ink_signed(v2&255);b[thread*8+5]=sc*ink_signed(v2>>8);
                    v3:=cast(u32)w[wbase+3];b[thread*8+6]=sc*ink_signed(v3&255);b[thread*8+7]=sc*ink_signed(v3>>8);
                } else {
                    b[thread*8+0]=0.0f32;b[thread*8+1]=0.0f32;b[thread*8+2]=0.0f32;b[thread*8+3]=0.0f32;
                    b[thread*8+4]=0.0f32;b[thread*8+5]=0.0f32;b[thread*8+6]=0.0f32;b[thread*8+7]=0.0f32;
                }
            }
            am_sg_mma_64x32x32(acc[..],a[..],b[..]);
        }
        am_sg_spill_64x32(acc[..],a[..]);
        for thread:0..<128 {
            for i:0..<n_a_iters {
                e:=thread+128*i;
                mi:=m0+e/32;c:=e%32;
                row:=r0+c;
                if mi<nm && row<rows {
                    tt:=cast(int)tsh[e/32];
                    ss:=cast(int)exp_slots[ebase+mi];
                    gu_out[(tt*n_used+ss)*rows+row]=a[e];
                }
            }
        }
    }
}

// ---- Batched SITU activation: Launch items = n_tok * n_used (<= 8192 -> hits _n32!), lanes = 128.
ink_situ_batch :: (item:int,n_ff:int,beta:f32,lb:f32,gu_out:[]f32,hid:[]f32) #export_c #effects(all) {
    base:=item*2*n_ff;
    hbase:=item*n_ff;
    steps:=(n_ff+127)/128;
    for thread:0..<128 {
        for s:0..<steps {
            row:=s*128+thread;
            if row<n_ff {
                g:=gu_out[base+row];
                u:=gu_out[base+n_ff+row];
                act:=beta*ink_tanh(g/beta)*ink_sigmoid(g);
                if lb>0.0f32 {u=lb*ink_tanh(u/lb);}
                hid[hbase+row]=act*u;
            }
        }
    }
}

// ---- Batched Expert-Grouped MoE down projection via Apple hardware MMA (IQ4_NL), compacted active tiles.
// Launch items = max_tiles * ceil(rows / 32), lanes = 128.
ink_moe_down_batch_iq4 :: (item:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,exp_toks:[]u32,exp_slots:[]u32,exp_wts:[]f32,exp_cnt:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,slot_out:[]f32) #export_c #effects(all) {
    a:[2048]f32;b:[1024]f32;acc:[2048]f32;lut:[16]f32;hsh:[64]u32;
    r_tiles:=(rows+31)/32;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*32;
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        nm:=cast(int)exp_cnt[exp_id];
        ebase:=exp_id*INK_PREFILL_B;
        m_rem:=nm-m0;
        if m_rem>64 {m_rem=64;}
        n_a_iters:=(m_rem+3)/4;
        for thread:0..<128 {
            if thread<16 {lut[thread]=ink_iq4_val(cast(u32)thread);}
            if thread<64 {
                mi:=m0+thread;
                hsh[thread]=ifx mi<nm then cast(u32)(cast(int)exp_toks[ebase+mi]*n_used+cast(int)exp_slots[ebase+mi]) else 4294967295;
            }
            for i:0..<16 {if i>=n_a_iters {a[thread+128*i]=0.0f32;}}
        }
        blocks:=cols/32;row_words:=blocks*9;
        exp_base:=exp_id*rows*row_words;
        for blk:0..<blocks {
            xb:=blk*32;boff:=blk*9;
            for thread:0..<128 {
                col:=thread%32;
                t_off:=thread/32;
                for i:0..<16 {
                    if i<n_a_iters {
                        hu:=hsh[t_off+4*i];
                        v:f32=0.0f32;
                        if hu!=4294967295 {v=x[cast(int)hu*cols+xb+col];}
                        a[thread+128*i]=v;
                    }
                }
                row:=r0+thread/4;
                sub:=thread%4;
                if row<rows {
                    at:=exp_base+row*row_words+boff;
                    sc:=ink_half(cast(u32)w[at]);
                    wbase:=at+1+(sub%2)*4;
                    if sub<2 {
                        v0:=cast(u32)w[wbase+0];
                        b[thread*8+0]=sc*lut[cast(int)(v0&15)];b[thread*8+1]=sc*lut[cast(int)((v0>>8)&15)];
                        v1:=cast(u32)w[wbase+1];
                        b[thread*8+2]=sc*lut[cast(int)(v1&15)];b[thread*8+3]=sc*lut[cast(int)((v1>>8)&15)];
                        v2:=cast(u32)w[wbase+2];
                        b[thread*8+4]=sc*lut[cast(int)(v2&15)];b[thread*8+5]=sc*lut[cast(int)((v2>>8)&15)];
                        v3:=cast(u32)w[wbase+3];
                        b[thread*8+6]=sc*lut[cast(int)(v3&15)];b[thread*8+7]=sc*lut[cast(int)((v3>>8)&15)];
                    } else {
                        v0:=cast(u32)w[wbase+0];
                        b[thread*8+0]=sc*lut[cast(int)((v0>>4)&15)];b[thread*8+1]=sc*lut[cast(int)(v0>>12)];
                        v1:=cast(u32)w[wbase+1];
                        b[thread*8+2]=sc*lut[cast(int)((v1>>4)&15)];b[thread*8+3]=sc*lut[cast(int)(v1>>12)];
                        v2:=cast(u32)w[wbase+2];
                        b[thread*8+4]=sc*lut[cast(int)((v2>>4)&15)];b[thread*8+5]=sc*lut[cast(int)(v2>>12)];
                        v3:=cast(u32)w[wbase+3];
                        b[thread*8+6]=sc*lut[cast(int)((v3>>4)&15)];b[thread*8+7]=sc*lut[cast(int)(v3>>12)];
                    }
                } else {
                    b[thread*8+0]=0.0f32;b[thread*8+1]=0.0f32;b[thread*8+2]=0.0f32;b[thread*8+3]=0.0f32;
                    b[thread*8+4]=0.0f32;b[thread*8+5]=0.0f32;b[thread*8+6]=0.0f32;b[thread*8+7]=0.0f32;
                }
            }
            am_sg_mma_64x32x32(acc[..],a[..],b[..]);
        }
        am_sg_spill_64x32(acc[..],a[..]);
        for thread:0..<128 {
            for i:0..<n_a_iters {
                e:=thread+128*i;
                mi:=m0+e/32;c:=e%32;
                row:=r0+c;
                if mi<nm && row<rows {
                    hs:=cast(int)hsh[e/32];
                    ew:=exp_wts[ebase+mi];
                    slot_out[hs*rows+row]=ew*a[e];
                }
            }
        }
    }
}

// ---- Batched Expert-Grouped MoE down projection via Apple hardware MMA (Q8_0, last 4 layers), compacted active tiles.
// Launch items = max_tiles * ceil(rows / 32), lanes = 128.
ink_moe_down_batch_q8 :: (item:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,exp_toks:[]u32,exp_slots:[]u32,exp_wts:[]f32,exp_cnt:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,slot_out:[]f32) #export_c #effects(all) {
    a:[2048]f32;b:[1024]f32;acc:[2048]f32;hsh:[64]u32;
    r_tiles:=(rows+31)/32;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*32;
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        nm:=cast(int)exp_cnt[exp_id];
        ebase:=exp_id*INK_PREFILL_B;
        m_rem:=nm-m0;
        if m_rem>64 {m_rem=64;}
        n_a_iters:=(m_rem+3)/4;
        for thread:0..<128 {
            if thread<64 {
                mi:=m0+thread;
                hsh[thread]=ifx mi<nm then cast(u32)(cast(int)exp_toks[ebase+mi]*n_used+cast(int)exp_slots[ebase+mi]) else 4294967295;
            }
            for i:0..<16 {if i>=n_a_iters {a[thread+128*i]=0.0f32;}}
        }
        blocks:=cols/32;row_words:=blocks*17;
        exp_base:=exp_id*rows*row_words;
        for blk:0..<blocks {
            xb:=blk*32;boff:=blk*17;
            for thread:0..<128 {
                col:=thread%32;
                t_off:=thread/32;
                for i:0..<16 {
                    if i<n_a_iters {
                        hu:=hsh[t_off+4*i];
                        v:f32=0.0f32;
                        if hu!=4294967295 {v=x[cast(int)hu*cols+xb+col];}
                        a[thread+128*i]=v;
                    }
                }
                row:=r0+thread/4;
                sub:=thread%4;
                if row<rows {
                    at:=exp_base+row*row_words+boff;
                    sc:=ink_half(cast(u32)w[at]);
                    wbase:=at+1+sub*4;
                    v0:=cast(u32)w[wbase+0];b[thread*8+0]=sc*ink_signed(v0&255);b[thread*8+1]=sc*ink_signed(v0>>8);
                    v1:=cast(u32)w[wbase+1];b[thread*8+2]=sc*ink_signed(v1&255);b[thread*8+3]=sc*ink_signed(v1>>8);
                    v2:=cast(u32)w[wbase+2];b[thread*8+4]=sc*ink_signed(v2&255);b[thread*8+5]=sc*ink_signed(v2>>8);
                    v3:=cast(u32)w[wbase+3];b[thread*8+6]=sc*ink_signed(v3&255);b[thread*8+7]=sc*ink_signed(v3>>8);
                } else {
                    b[thread*8+0]=0.0f32;b[thread*8+1]=0.0f32;b[thread*8+2]=0.0f32;b[thread*8+3]=0.0f32;
                    b[thread*8+4]=0.0f32;b[thread*8+5]=0.0f32;b[thread*8+6]=0.0f32;b[thread*8+7]=0.0f32;
                }
            }
            am_sg_mma_64x32x32(acc[..],a[..],b[..]);
        }
        am_sg_spill_64x32(acc[..],a[..]);
        for thread:0..<128 {
            for i:0..<n_a_iters {
                e:=thread+128*i;
                mi:=m0+e/32;c:=e%32;
                row:=r0+c;
                if mi<nm && row<rows {
                    hs:=cast(int)hsh[e/32];
                    ew:=exp_wts[ebase+mi];
                    slot_out[hs*rows+row]=ew*a[e];
                }
            }
        }
    }
}

// ---- Sum n_used expert slot outputs into moe_out[t*dim + r]. Launch items = n_tok (<= 1024 -> _n32!), lanes = 128.
// ---- Fused MoE slot reduction + post shortconv + residual add (eliminates K_CONVOLVE_ADD_BATCH + 48 barriers & moe_out round-trip!).
// Launch items = dim, lanes = 1.
ink_moe_reduce_batch :: (item:int,dim:int,n_used:int,n_tok:int,slot_out:[]f32,w:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    if item<dim {
        h_idx:=item*3;
        x0:=hist[h_idx+0];x1:=hist[h_idx+1];x2:=hist[h_idx+2];
        wb:=item*4;
        w0:=w[wb+0];w1:=w[wb+1];w2:=w[wb+2];w3:=w[wb+3];
        inv_s:=0.4472135954999579f32;
        stride:=n_used*dim;
        for t:0..<n_tok {
            tbase:=t*stride+item;
            x3:f32=0;
            for slot:0..<n_used {x3+=slot_out[tbase+slot*dim];}
            acc:=x0*w0+x1*w1+x2*w2+x3*w3;
            idx:=t*dim+item;
            out[idx]=res[idx]+(x3+acc)*inv_s;
            x0=x1;x1=x2;x2=x3;
        }
        hist[h_idx+0]=x0;hist[h_idx+1]=x1;hist[h_idx+2]=x2;
    }
}

// ---- MMA Prefill Attention Stage 1: Q*K^T + rel_bias - sink using am_sg_mma_64x32x32!
// ---- Sprint 49: FP16 Tensor-Core MMA Prefill Attention Stage 1 writing FP16 (u16) head-major scores (2x less DRAM!).
// Launch items = n_head * ceil(n_tok/64) * ceil(span/32), lanes = 128.
// ---- Sprint 56: Loop-over-K MMA Attention Scores (4 TGs per (h, q_tile), ZERO wasted causal/SWA TGs, r & sinks cached once!).
// Launch items = n_head * q_tiles * 4, lanes = 128.
ink_attn_scores_mma :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos0:int,n_tok:int,k_start:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,k_cache:[]u16,scores:[]u16) #export_c #effects(all) {
    ah:[2048]u16;bh:[1024]u16;rsh:[1088]u16;a:[2048]f32;acc:[2048]f32;
    n_head:=cast(int)(dims0&255);n_head_kv:=cast(int)((dims0>>8)&255);head_dim:=cast(int)((dims0>>16)&255);n_rel:=cast(int)((dims0>>24)&255);
    extent:=cast(int)(dims1&65535);is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    kv_cap:=cast(int)(kv_info&65535);score_stride:=cast(int)((kv_info>>16)&65535);
    span:=pos0+n_tok-k_start;
    qt:=(n_tok+63)/64;
    k_split:=item%4;
    hq:=item/4;
    h:=hq/qt;
    t0:=(hq%qt)*64;
    last_t:=ifx t0+63<n_tok then t0+63 else n_tok-1;
    kv_h:=h/(n_head/n_head_kv);
    n_kv_elem:=n_head_kv*head_dim;
    min_k:=ifx is_swa!=0 && pos0+t0>=swa then pos0+t0-swa+1 else 0;
    j_lo_tile:=ifx min_k>k_start then (min_k-k_start)/32 else 0;
    j_hi_val:=pos0+last_t-k_start;
    j_hi_tile:=ifx j_hi_val>=0 then j_hi_val/32 else -1;
    n_valid:=j_hi_tile-j_lo_tile+1;
    if n_valid>0 {
        // Load r[64x16] into rsh[0..1023] and sinks[64] into rsh[1024..1087] ONCE for all k_tiles!
        for thread:0..<128 {
            for i:0..<9 {
                if i<8 {
                    idx:=thread+128*i;
                    dt:=idx/16;m:=idx%16;
                    t:=t0+dt;
                    rsh[thread+128*i]=ifx t<n_tok then am_to_f16(r[(t*n_head+h)*INK_REL+m]) else cast(u16)0;
                } else if thread<64 {
                    t:=t0+thread;
                    rsh[thread+128*i]=ifx t<n_tok then am_to_f16(sinks[t*n_head+h]) else cast(u16)0;
                }
            }
        }
        scale:=1.0f32/sqrt(f32(head_dim));
        step_k:=(n_valid+3)/4;
        kt_start:=j_lo_tile+k_split*step_k;
        kt_end:=kt_start+step_k;
        if kt_end>j_hi_tile+1 {kt_end=j_hi_tile+1;}
        for kt_idx:kt_start..<kt_end {
            j0:=kt_idx*32;
            am_sg_zero_64x32(acc[..]);
            for st:0..<4 {
                for thread:0..<128 {
                    d:=st*32+thread%32;
                    t_off:=thread/32;
                    for i:0..<16 {
                        t:=t0+t_off+4*i;
                        v:u16=0;
                        if t<n_tok {v=am_to_f16(q[(t*n_head+h)*INK_HEAD+d]);}
                        ah[thread+128*i]=v;
                    }
                    for i:0..<8 {
                        j:=j0+t_off+4*i;
                        v:u16=0;
                        if j<span {
                            kp:=k_start+j;
                            slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                            v=k_cache[slot*n_kv_elem+kv_h*INK_HEAD+d];
                        }
                        bh[thread+128*i]=v;
                    }
                }
                am_sg_mma_f16_64x32x32(acc[..],ah[..],bh[..]);
            }
            am_sg_spill_64x32(acc[..],a[..]);
            no_rb:=k_start+j0+31<=pos0+t0 && (is_swa==0 || (pos0+last_t)-(k_start+j0)<swa) && (pos0+t0)-(k_start+j0+31)>=extent;
            if no_rb {
                for thread:0..<128 {
                    for i:0..<16 {
                        e:=thread+128*i;
                        dt:=e/32;
                        t:=t0+dt;j:=j0+e%32;
                        if t<n_tok && j<span {
                            scores[(h*n_tok+t)*score_stride+j]=am_to_f16(a[e]*scale-am_f16(cast(u32)rsh[1024+dt]));
                        }
                    }
                }
            } else {
                d_lo:=(pos0+t0)-(k_start+j0)-31;
                for thread:0..<128 {
                    for i:0..<12 {
                        idx:=thread+128*i;
                        di:=idx/16;m:=idx%16;
                        dist:=d_lo+di;
                        ah[thread+128*i]=ifx dist>=0 && dist<extent then am_to_f16(rel_bias[dist*n_rel+m]) else cast(u16)0;
                    }
                }
                for thread:0..<128 {
                    for i:0..<16 {
                        e:=thread+128*i;
                        dt:=e/32;dj:=e%32;
                        t:=t0+dt;j:=j0+dj;
                        if t<n_tok && j<span {
                            p:=pos0+t;kp:=k_start+j;
                            if kp<=p && (is_swa==0 || p-kp<swa) {
                                dist:=p-kp;
                                rb:f32=0.0f32;
                                if dist<extent {
                                    di:=dist-d_lo;
                                    rb_base:=di*16;
                                    r_base:=dt*16;
                                    for m:0..<INK_REL {rb+=am_f16(cast(u32)ah[rb_base+m])*am_f16(cast(u32)rsh[r_base+m]);}
                                }
                                scores[(h*n_tok+t)*score_stride+j]=am_to_f16(a[e]*scale+rb-am_f16(cast(u32)rsh[1024+dt]));
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---- Sprint 49: 32-lane Zero-TGEM/Zero-Barrier Warp Softmax on FP16 head-major scores[(h*n_tok+t)*score_stride+j]!
// Launch items = n_tok * n_head, lanes = 32.
ink_attn_softmax_mma :: (item:int,dims0:u32,dims1:u32,score_stride:int,pos0:int,n_tok:int,k_start:int,scores:[]u16,inv_gsum:[]f32) #export_c #effects(all) {
    n_head:=cast(int)(dims0&255);
    is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    span:=pos0+n_tok-k_start;
    h:=item/n_tok;
    t:=item%n_tok;
    p:=pos0+t;
    start_k:=ifx is_swa!=0 && p>=swa then p-swa+1 else 0;
    j_lo:=start_k-k_start;
    if j_lo<0 {j_lo=0;}
    j_hi:=p-k_start+1;
    t0:=(t/64)*64;
    last_t:=ifx t0+63<n_tok then t0+63 else n_tok-1;
    tile_j_lo:=ifx is_swa!=0 && pos0+t0>=swa then pos0+t0-swa+1-k_start else 0;
    if tile_j_lo<0 {tile_j_lo=0;}
    w_lo:=(tile_j_lo/32)*32;
    w_hi:=((pos0+last_t-k_start+1+31)/32)*32;
    if w_hi>span {w_hi=span;}
    w_len:=w_hi-w_lo;
    sbase:=item*score_stride;
    n_chunks:=(w_len+31)/32;
    for lane:0..<32 {
        lmax:f32=INK_NEG_INF;
        for c:0..<n_chunks {
            j:=w_lo+c*32+lane;
            if j>=j_lo && j<j_hi {
                v:=am_f16(cast(u32)scores[sbase+j]);
                if v>lmax {lmax=v;}
            }
        }
        gmax:=am_simd_max(lmax);
        if gmax<0.0f32 {gmax=0.0f32;}
        lsum:f32=0.0f32;
        for c:0..<n_chunks {
            j:=w_lo+c*32+lane;
            if j<w_hi {
                if j>=j_lo && j<j_hi {
                    w:=exp(am_f16(cast(u32)scores[sbase+j])-gmax);
                    scores[sbase+j]=am_to_f16(w);
                    lsum+=w;
                } else {
                    scores[sbase+j]=0;
                }
            }
        }
        gsum:=exp(-gmax)+am_simd_sum(lsum);
        if lane==0 {
            inv_gsum[t*n_head+h]=1.0f32/gsum;
        }
    }
}

// ---- Sprint 49: FP16 Tensor-Core MMA Prefill Attention Stage 3 (zero-conversion direct u16 load of P and V!).
// Launch items = n_head * ceil(n_tok/64) * 4, lanes = 128.
ink_attn_values_mma :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos0:int,n_tok:int,k_start:int,scores:[]u16,inv_gsum:[]f32,v_cache:[]u16,gate:[]f32,out:[]f32) #export_c #effects(all) {
    ah:[2048]u16;bh:[1024]u16;a:[2048]f32;acc:[2048]f32;
    n_head:=cast(int)(dims0&255);n_head_kv:=cast(int)((dims0>>8)&255);head_dim:=cast(int)((dims0>>16)&255);
    is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    kv_cap:=cast(int)(kv_info&65535);score_stride:=cast(int)((kv_info>>16)&65535);
    span:=pos0+n_tok-k_start;
    qt:=(n_tok+63)/64;
    per:=qt*4;
    h:=item/per;rem:=item%per;
    t0:=(rem/4)*64;c0:=(rem%4)*32;
    last_t:=ifx t0+63<n_tok then t0+63 else n_tok-1;
    kv_h:=h/(n_head/n_head_kv);
    n_kv_elem:=n_head_kv*head_dim;
    j_lo:=ifx is_swa!=0 && pos0+t0>=swa then pos0+t0-swa+1-k_start else 0;
    if j_lo<0 {j_lo=0;}
    j_hi:=pos0+last_t-k_start+1;
    st_lo:=j_lo/32;
    st_hi:=(j_hi+31)/32;
    for st:st_lo..<st_hi {
        for thread:0..<128 {
            j:=st*32+thread%32;
            t_off:=thread/32;
            for i:0..<16 {
                t:=t0+t_off+4*i;
                v:u16=0;
                if t<n_tok && j<span {v=scores[(h*n_tok+t)*score_stride+j];}
                ah[thread+128*i]=v;
            }
            for i:0..<8 {
                v:u16=0;
                if j<span {
                    kp:=k_start+j;
                    slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                    v=v_cache[slot*n_kv_elem+kv_h*INK_HEAD+c0+t_off+4*i];
                }
                bh[thread+128*i]=v;
            }
        }
        am_sg_mma_f16_64x32x32(acc[..],ah[..],bh[..]);
    }
    am_sg_spill_64x32(acc[..],a[..]);
    for thread:0..<128 {
        for i:0..<16 {
            e:=thread+128*i;
            t:=t0+e/32;c:=e%32;
            if t<n_tok {
                idx:=(t*n_head+h)*INK_HEAD+c0+c;
                out[idx]=a[e]*inv_gsum[t*n_head+h]*ink_sigmoid(gate[idx]);
            }
        }
    }
}

// ---- Sprint 4A: Coalesced GQA 3:1 Flash-Decoding Split-K Attention (1-pass, online softmax).
// Launch items = n_head_kv * n_splits, lanes = 128.
// Each threadgroup processes 1 KV head (3 Q heads: h0, h0+1, h0+2) across its split of keys in 16-key tiles.
// Reads K and V 100% coalesced and shares them across all 3 Q heads (3x less KV bandwidth, zero scratch_scores).
ink_attn_gqa_split :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,k_cache:[]u16,v_cache:[]u16,split_out:[]f32) #export_c #effects(all) {
    q0sh:[128]f32;q1sh:[128]f32;q2sh:[128]f32;rsh:[48]f32;p0:[128]f32;p1:[128]f32;p2:[128]f32;scsh:[64]f32;wsh:[64]f32;
    vacc0:[128]f32;vacc1:[128]f32;vacc2:[128]f32;
    ms0:[128]f32;ms1:[128]f32;ms2:[128]f32;
    ls0:[128]f32;ls1:[128]f32;ls2:[128]f32;
    n_head_kv:=cast(int)((dims0>>8)&255);head_dim:=cast(int)((dims0>>16)&255);n_rel:=cast(int)((dims0>>24)&255);
    extent:=cast(int)(dims1&65535);is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    kv_cap:=cast(int)(kv_info&65535);n_splits:=cast(int)((kv_info>>16)&65535);
    kv_h:=item/n_splits;
    sp:=item%n_splits;
    h0:=kv_h*3;h1:=h0+1;h2:=h0+2;
    n_kv_elem:=n_head_kv*head_dim;
    scale:=1.0f32/sqrt(f32(head_dim));
    sk0:=sinks[h0];sk1:=sinks[h1];sk2:=sinks[h2];
    start:int=0;
    if is_swa!=0 && pos>=swa {start=pos-swa+1;}
    n_keys:=pos-start+1;
    per_sp:=(n_keys+n_splits-1)/n_splits;
    k_begin:=sp*per_sp;
    k_end:=k_begin+per_sp;
    if k_end>n_keys {k_end=n_keys;}
    n_tiles:int=0;
    if k_begin<k_end {n_tiles=(k_end-k_begin+15)/16;}
    for thread:0..<128 {
        q0sh[thread]=q[h0*INK_HEAD+thread];
        q1sh[thread]=q[h1*INK_HEAD+thread];
        q2sh[thread]=q[h2*INK_HEAD+thread];
        if thread<48 {
            hl:=thread/16;j:=thread%16;
            rsh[thread]=r[(h0+hl)*n_rel+j];
        }
        vacc0[thread]=0.0f32;vacc1[thread]=0.0f32;vacc2[thread]=0.0f32;
        ms0[thread]=INK_NEG_INF;ms1[thread]=INK_NEG_INF;ms2[thread]=INK_NEG_INF;
        ls0[thread]=0.0f32;ls1[thread]=0.0f32;ls2[thread]=0.0f32;
    }
    for tile:0..<n_tiles {
        t_base:=k_begin+tile*16;
        for thread:0..<128 {
            k_loc:=thread/8;sub:=thread%8;
            kidx:=t_base+k_loc;
            d0:f32=0.0f32;d1:f32=0.0f32;d2:f32=0.0f32;
            if kidx<k_end {
                kp:=start+kidx;
                slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                kbase:=slot*n_kv_elem+kv_h*INK_HEAD+sub*16;
                qoff:=sub*16;
                for i:0..<16 {
                    kv:=am_f16(cast(u32)k_cache[kbase+i]);
                    d0+=q0sh[qoff+i]*kv;
                    d1+=q1sh[qoff+i]*kv;
                    d2+=q2sh[qoff+i]*kv;
                }
            }
            p0[thread]=d0;p1[thread]=d1;p2[thread]=d2;
        }
        for thread:0..<128 {
            if thread<48 {
                hl:=thread/16;k_loc:=thread%16;
                kidx:=t_base+k_loc;
                if kidx<k_end {
                    dot:f32=0.0f32;
                    poff:=k_loc*8;
                    if hl==0 {
                        for s:0..<8 {dot+=p0[poff+s];}
                    } else if hl==1 {
                        for s:0..<8 {dot+=p1[poff+s];}
                    } else {
                        for s:0..<8 {dot+=p2[poff+s];}
                    }
                    kp:=start+kidx;dist:=pos-kp;
                    rb:f32=0.0f32;
                    if dist<extent {
                        rb_base:=dist*n_rel;roff:=hl*INK_REL;
                        for j:0..<INK_REL {rb+=rel_bias[rb_base+j]*rsh[roff+j];}
                    }
                    sk:=ifx hl==0 then sk0 else ifx hl==1 then sk1 else sk2;
                    scsh[thread]=dot*scale+rb-sk;
                } else {
                    scsh[thread]=INK_NEG_INF;
                }
            }
        }
        for thread:0..<128 {
            if thread<48 {
                hl:=thread/16;
                tm:f32=INK_NEG_INF;
                for kl:0..<16 {s:=scsh[hl*16+kl];if s>tm {tm=s;}}
                om:=ifx hl==0 then ms0[0] else ifx hl==1 then ms1[0] else ms2[0];
                nm:=ifx tm>om then tm else om;
                kidx:=t_base+(thread%16);
                wsh[thread]=ifx kidx<k_end then exp(scsh[thread]-nm) else 0.0f32;
            }
        }
        for thread:0..<128 {
            tm0:f32=INK_NEG_INF;tm1:f32=INK_NEG_INF;tm2:f32=INK_NEG_INF;
            for kl:0..<16 {
                s0:=scsh[kl];if s0>tm0 {tm0=s0;}
                s1:=scsh[16+kl];if s1>tm1 {tm1=s1;}
                s2:=scsh[32+kl];if s2>tm2 {tm2=s2;}
            }
            om0:=ms0[thread];om1:=ms1[thread];om2:=ms2[thread];
            nm0:=ifx tm0>om0 then tm0 else om0;
            nm1:=ifx tm1>om1 then tm1 else om1;
            nm2:=ifx tm2>om2 then tm2 else om2;
            a0:=ifx om0>-1.0e20f32 then exp(om0-nm0) else 0.0f32;
            a1:=ifx om1>-1.0e20f32 then exp(om1-nm1) else 0.0f32;
            a2:=ifx om2>-1.0e20f32 then exp(om2-nm2) else 0.0f32;
            v0:=vacc0[thread]*a0;v1:=vacc1[thread]*a1;v2:=vacc2[thread]*a2;
            l0:=ls0[thread]*a0;l1:=ls1[thread]*a1;l2:=ls2[thread]*a2;
            for kl:0..<16 {
                kidx:=t_base+kl;
                if kidx<k_end {
                    kp:=start+kidx;
                    slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                    vv:=am_f16(cast(u32)v_cache[slot*n_kv_elem+kv_h*INK_HEAD+thread]);
                    w0:=wsh[kl];l0+=w0;v0+=w0*vv;
                    w1:=wsh[16+kl];l1+=w1;v1+=w1*vv;
                    w2:=wsh[32+kl];l2+=w2;v2+=w2*vv;
                }
            }
            ms0[thread]=nm0;ms1[thread]=nm1;ms2[thread]=nm2;
            ls0[thread]=l0;ls1[thread]=l1;ls2[thread]=l2;
            vacc0[thread]=v0;vacc1[thread]=v1;vacc2[thread]=v2;
        }
    }
    for thread:0..<128 {
        b0:=(h0*n_splits+sp)*130;
        b1:=(h1*n_splits+sp)*130;
        b2:=(h2*n_splits+sp)*130;
        split_out[b0+thread]=vacc0[thread];
        split_out[b1+thread]=vacc1[thread];
        split_out[b2+thread]=vacc2[thread];
        if thread==0 {
            split_out[b0+128]=ms0[0];split_out[b0+129]=ls0[0];
            split_out[b1+128]=ms1[0];split_out[b1+129]=ls1[0];
            split_out[b2+128]=ms2[0];split_out[b2+129]=ls2[0];
        }
    }
}

// ---- Combine Flash-Decoding split partials across n_splits for each Q head.
// Launch items = n_head, lanes = 128.
ink_attn_gqa_reduce :: (item:int,n_splits:int,split_out:[]f32,gate:[]f32,out:[]f32) #export_c #effects(all) {
    h:=item;
    for thread:0..<128 {
        gmax:f32=0.0f32;
        for sp:0..<n_splits {
            m:=split_out[(h*n_splits+sp)*130+128];
            if m>gmax {gmax=m;}
        }
        gsum:f32=exp(-gmax);
        vtot:f32=0.0f32;
        for sp:0..<n_splits {
            sb:=(h*n_splits+sp)*130;
            l:=split_out[sb+129];
            if l>0.0f32 {
                sc:=exp(split_out[sb+128]-gmax);
                gsum+=l*sc;
                vtot+=split_out[sb+thread]*sc;
            }
        }
        idx:=h*INK_HEAD+thread;
        out[idx]=(vtot/gsum)*ink_sigmoid(gate[idx]);
    }
}

// ---- Sprint 11: Dequantize Q8_0 [rows, cols] -> BF16 pairs [rows, cols/2] u32 (4 rows/TG -> 4x fewer TGs!).
// Launch items = ceil(rows / 4), lanes = 128.
ink_dequant_q8_bf16 :: (item:int,rows:int,cols:int,w:[]u16,out_bf16:[]u32) #export_c #effects(all) {
    blocks:=cols/32;
    words:=blocks*17;
    half_cols:=cols/2;
    row0:=item*4;
    for thread:0..<128 {
        b_lane:=thread/16;
        k:=thread%16;
        for rr:0..<4 {
            row:=row0+rr;
            if row<rows {
                rbase:=row*words;
                obase:=row*half_cols;
                for step:0..<(blocks+7)/8 {
                    blk:=step*8+b_lane;
                    if blk<blocks {
                        at:=rbase+blk*17;
                        sc:=am_f16(cast(u32)w[at]);
                        v:=cast(u32)w[at+1+k];
                        f0:=sc*ink_signed(v&255);
                        f1:=sc*ink_signed(v>>8);
                        b0:=(f32_bits(f0)+0x8000)>>16;
                        b1:=(f32_bits(f1)+0x8000)>>16;
                        out_bf16[obase+blk*16+k]=b0|(b1<<16);
                    }
                }
            }
        }
    }
}

// Fast f32 -> bf16 conversion (RNE rounding) for native bfloat x bfloat Metal 4 Neural Accelerators.
// 256 threads/TG, 4 elements/thread = 1024 elements/TG.
ink_f32_to_bf16 :: (item:int,n:int,x:[]f32,out:[]u16) #export_c #effects(all) {
    base:=item*1024;
    for thread:0..<256 {
        for k:0..<4 {
            idx:=base+k*256+thread;
            if idx<n {
                b:=f32_bits(x[idx]);
                out[idx]=cast(u16)((b+0x7fff+((b>>16)&1))>>16);
            }
        }
    }
}

// Metal 4 tensor-op GEMM (native bfloat x bfloat! 64x128 tile for nb>=33, 32x64 for 17..32, 16x64 for 8..16).
ink_mm_bf16 :: (item:int,rows:int,cols:int,n_tok:int,w_bf16:[]u32,x:[]u16,out:[]f32) #export_c #effects(all) {
    r_tiles:=(rows+127)/128;
    t0:=(item/r_tiles)*64;
    r0:=(item%r_tiles)*128;
    for thread:0..<256 {}
    am_matmul_bf16_x16(256,64,128,rows,cols,n_tok,r0,t0,w_bf16[..],x[..],out[..]);
}

ink_mm_bf16_16 :: (item:int,rows:int,cols:int,n_tok:int,w_bf16:[]u32,x:[]u16,out:[]f32) #export_c #effects(all) {
    r_tiles:=(rows+63)/64;
    t0:=(item/r_tiles)*16;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    am_matmul_bf16_x16(128,16,64,rows,cols,n_tok,r0,t0,w_bf16[..],x[..],out[..]);
}

ink_mm_bf16_32 :: (item:int,rows:int,cols:int,n_tok:int,w_bf16:[]u32,x:[]u16,out:[]f32) #export_c #effects(all) {
    r_tiles:=(rows+63)/64;
    t0:=(item/r_tiles)*32;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    am_matmul_bf16_x16(128,32,64,rows,cols,n_tok,r0,t0,w_bf16[..],x[..],out[..]);
}

// ---- Sprint 8B: Metal 4 Neural Accelerator (am_matmul_bf16) Expert-Grouped MoE!
// Compute prefix sums exp_off[0..n_exp-1] from exp_cnt[0..n_exp-1]. Launch items = 1, lanes = 1.
ink_moe_exp_off :: (item:int,n_exp:int,exp_cnt:[]u32,exp_off:[]u32) #export_c #effects(all) {
    acc:int=0;
    for e:0..<n_exp {
        exp_off[e]=cast(u32)acc;
        acc+=cast(int)exp_cnt[e];
    }
}

// Build active (exp_id, m0) tiles for expert chunk [e_lo..e_hi). Launch items = 1, lanes = 1.
ink_moe_chunk_tiles :: (item:int,e_lo:int,e_hi:int,tile_m:int,r_mul:int,exp_cnt:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32) #export_c #effects(all) {
    t:int=0;
    for e:e_lo..<e_hi {
        cnt:=cast(int)exp_cnt[e];
        if cnt>0 {
            nt:=(cnt+tile_m-1)/tile_m;
            for k:0..<nt {
                tile_exp[t]=cast(u32)e;
                tile_m0[t]=cast(u32)(k*tile_m);
                t+=1;
            }
        }
    }
    tile_cnt[0]=cast(u32)t;
    tile_cnt[4]=cast(u32)(t*r_mul); tile_cnt[5]=1; tile_cnt[6]=1;
}

// Gather tokens into contiguous per-expert rows x_exp[exp_off[e]+c] and record row_dst / row_wt.
// Launch items = n_exp * 8 (8 TGs/expert -> 1024 TGs, zero load imbalance, zero inner barriers!), lanes = 128.
ink_moe_gather_x :: (item:int,dim:int,n_used:int,x:[]f32,exp_toks:[]u32,exp_slots:[]u32,exp_wts:[]f32,exp_cnt:[]u32,exp_off:[]u32,x_exp:[]f32,row_dst:[]u32,row_wt:[]f32) #export_c #effects(all) {
    exp_id:=item/8;
    sub:=item%8;
    cnt:=cast(int)exp_cnt[exp_id];
    if sub<cnt {
        ebase:=exp_id*INK_PREFILL_B;
        off:=cast(int)exp_off[exp_id];
        steps:=(dim+127)/128;
        iters:=(cnt-sub+7)/8;
        for thread:0..<128 {
            for k:0..<iters {
                c:=sub+k*8;
                tok:=cast(int)exp_toks[ebase+c];
                dst_row:=off+c;
                if thread==0 {
                    sl:=cast(int)exp_slots[ebase+c];
                    row_dst[dst_row]=cast(u32)(tok*n_used+sl);
                    row_wt[dst_row]=exp_wts[ebase+c];
                }
                sbase:=tok*dim;
                dbase:=dst_row*dim;
                for st:0..<steps {
                    r:=st*128+thread;
                    if r<dim {x_exp[dbase+r]=x[sbase+r];}
                }
            }
        }
    }
}

// Dequantize IQ4_NL expert chunk [e_lo..e_lo+e_cnt) -> BF16 pairs [e_cnt * rows, cols/2] u32 (8 rows/TG -> 8x fewer TGs & LUT barriers!).
// Launch items = e_cnt * ceil(rows / 8), lanes = 128.
// Dequantize IQ4_NL expert chunk [e_lo..e_lo+e_cnt) -> BF16 pairs [e_cnt * rows, cols/2] u32 (8 rows/TG, 96 threads = 12 blocks/step -> 72/12=6 & 36/12=3 exact, 0% idle!).
ink_dequant_iq4_exp_bf16 :: (item:int,e_lo:int,rows:int,cols:int,w:[]u16,exp_cnt:[]u32,out_bf16:[]u32) #export_c #effects(all) {
    r_grps:=(rows+7)/8;
    local_e:=item/r_grps;
    row0:=(item%r_grps)*8;
    exp_id:=e_lo+local_e;
    if exp_cnt[exp_id]>0 {
        blocks:=cols/32;
        row_words:=blocks*9;
        half_cols:=cols/2;
        for thread:0..<96 {
            b_lane:=thread/8;
            k:=thread%8;
            for rr:0..<8 {
                row:=row0+rr;
                if row<rows {
                    rbase:=(exp_id*rows+row)*row_words;
                    obase:=(local_e*rows+row)*half_cols;
                    for step:0..<(blocks+11)/12 {
                        blk:=step*12+b_lane;
                        if blk<blocks {
                            at:=rbase+blk*9;
                            sc:=am_f16(cast(u32)w[at]);
                            v:=cast(u32)w[at+1+k];
                            f0:=sc*am_iq4_lut(v&15);
                            f1:=sc*am_iq4_lut((v>>4)&15);
                            f2:=sc*am_iq4_lut((v>>8)&15);
                            f3:=sc*am_iq4_lut(v>>12);
                            b0:=(f32_bits(f0)+0x8000)>>16;
                            b1:=(f32_bits(f1)+0x8000)>>16;
                            b2:=(f32_bits(f2)+0x8000)>>16;
                            b3:=(f32_bits(f3)+0x8000)>>16;
                            out_bf16[obase+blk*16+k]=b0|(b2<<16);
                            out_bf16[obase+blk*16+8+k]=b1|(b3<<16);
                        }
                    }
                }
            }
        }
    }
}

// Dequantize Q8_0 expert chunk [e_lo..e_lo+e_cnt) -> BF16 pairs [e_cnt * rows, cols/2] u32 (4 rows/TG -> 4x fewer TGs!).
// Launch items = e_cnt * ceil(rows / 4), lanes = 128.
ink_dequant_q8_exp_bf16 :: (item:int,e_lo:int,rows:int,cols:int,w:[]u16,exp_cnt:[]u32,out_bf16:[]u32) #export_c #effects(all) {
    r_grps:=(rows+3)/4;
    local_e:=item/r_grps;
    row0:=(item%r_grps)*4;
    exp_id:=e_lo+local_e;
    if exp_cnt[exp_id]>0 {
        blocks:=cols/32;
        row_words:=blocks*17;
        half_cols:=cols/2;
        for thread:0..<128 {
            b_lane:=thread/16;
            k:=thread%16;
            for rr:0..<4 {
                row:=row0+rr;
                if row<rows {
                    rbase:=(exp_id*rows+row)*row_words;
                    obase:=(local_e*rows+row)*half_cols;
                    for step:0..<(blocks+7)/8 {
                        blk:=step*8+b_lane;
                        if blk<blocks {
                            at:=rbase+blk*17;
                            sc:=am_f16(cast(u32)w[at]);
                            v:=cast(u32)w[at+1+k];
                            f0:=sc*ink_signed(v&255);
                            f1:=sc*ink_signed(v>>8);
                            b0:=(f32_bits(f0)+0x8000)>>16;
                            b1:=(f32_bits(f1)+0x8000)>>16;
                            out_bf16[obase+blk*16+k]=b0|(b1<<16);
                        }
                    }
                }
            }
        }
    }
}

// Metal 4 Neural Accelerator batched MoE GEMM on contiguous per-expert activations!
// Launch items = max_chunk_tiles * ceil(rows/64), lanes = 128 (64x64 tile for large chunks).
ink_moe_mm_bf16 :: (item:int,e_lo:int,rows:int,cols:int,w_bf16:[]u32,x_exp:[]f32,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,y_exp:[]f32) #export_c #effects(all) {
    r_tiles:=(rows+63)/64;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        local_e:=exp_id-e_lo;
        nm:=cast(int)exp_cnt[exp_id];
        e_off:=cast(int)exp_off[exp_id];
        w_stride:=rows*(cols/2);
        w_lo:=local_e*w_stride;
        x_lo:=e_off*cols;
        y_lo:=e_off*rows;
        am_matmul_bf16(128,64,64,rows,cols,nm,r0,m0,
            w_bf16[w_lo..<w_lo+w_stride],
            x_exp[x_lo..<x_lo+nm*cols],
            y_exp[y_lo..<y_lo+nm*rows]);
    }
}

// Metal 4 Neural Accelerator MoE GEMM for small prompts (16x64 tile, tile_m=16).
ink_moe_mm_bf16_16 :: (item:int,e_lo:int,rows:int,cols:int,w_bf16:[]u32,x_exp:[]f32,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,y_exp:[]f32) #export_c #effects(all) {
    r_tiles:=(rows+63)/64;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        local_e:=exp_id-e_lo;
        nm:=cast(int)exp_cnt[exp_id];
        e_off:=cast(int)exp_off[exp_id];
        w_stride:=rows*(cols/2);
        w_lo:=local_e*w_stride;
        x_lo:=e_off*cols;
        y_lo:=e_off*rows;
        am_matmul_bf16(128,16,64,rows,cols,nm,r0,m0,
            w_bf16[w_lo..<w_lo+w_stride],
            x_exp[x_lo..<x_lo+nm*cols],
            y_exp[y_lo..<y_lo+nm*rows]);
    }
}

// Sprint 52: Native BF16xBF16 Metal 4 Neural Accelerator MoE GEMM with IN-TILE IQ4_NL dequantization (64x64 tile).
ink_moe_mm_iq4 :: (item:int,rows:int,cols:int,w_iq4:[]u16,x_exp:[]u16,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,y_exp:[]f32) #export_c #effects(all) {
    tg:[4096]u16;
    r_tiles:=(rows+63)/64;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        nm:=cast(int)exp_cnt[exp_id];
        e_off:=cast(int)exp_off[exp_id];
        w_stride:=rows*((cols/32)*9);
        w_lo:=exp_id*w_stride;
        x_lo:=e_off*cols;
        y_lo:=e_off*rows;
        am_matmul_iq4_bf16(128,64,64,rows,cols,nm,r0,m0,
            w_iq4[w_lo..<w_lo+w_stride],
            x_exp[x_lo..<x_lo+nm*cols],
            y_exp[y_lo..<y_lo+nm*rows],
            tg[..]);
    }
}

// Sprint 52: Native BF16xBF16 Metal 4 Neural Accelerator MoE GEMM with IN-TILE IQ4_NL dequantization (16x64 tile).
ink_moe_mm_iq4_16 :: (item:int,rows:int,cols:int,w_iq4:[]u16,x_exp:[]u16,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,y_exp:[]f32) #export_c #effects(all) {
    tg:[4096]u16;
    r_tiles:=(rows+63)/64;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        nm:=cast(int)exp_cnt[exp_id];
        e_off:=cast(int)exp_off[exp_id];
        w_stride:=rows*((cols/32)*9);
        w_lo:=exp_id*w_stride;
        x_lo:=e_off*cols;
        y_lo:=e_off*rows;
        am_matmul_iq4_bf16(128,16,64,rows,cols,nm,r0,m0,
            w_iq4[w_lo..<w_lo+w_stride],
            x_exp[x_lo..<x_lo+nm*cols],
            y_exp[y_lo..<y_lo+nm*rows],
            tg[..]);
    }
}

// Scatter weighted expert outputs back to moe_slot_out[(tok*n_used + sl)*dim + r].
// Launch items = n_tok * n_used, lanes = 128.
ink_moe_scatter_wt :: (item:int,dim:int,out_exp:[]f32,row_dst:[]u32,row_wt:[]f32,slot_out:[]f32) #export_c #effects(all) {
    dst_slot:=cast(int)row_dst[item];
    ew:=row_wt[item];
    sbase:=item*dim;
    dbase:=dst_slot*dim;
    steps:=(dim+127)/128;
    for thread:0..<128 {
        for st:0..<steps {
            r:=st*128+thread;
            if r<dim {slot_out[dbase+r]=ew*out_exp[sbase+r];}
        }
    }
}


// ---- Sprint 12A: Direct IQ4_NL small-batch MoE gate_up + fused SITU (tile_m=4, zero BF16 staging).
// 128 threads = 4 simdgroups x 1 (gate, up) row pair x up to 4 tokens/tile; 4 lanes/block coalesced.
ink_moe_gu_iq4_m4 :: (item:int,n_ff:int,cols:int,beta:f32,lb:f32,w:[]u16,x_exp:[]f32,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,out_hid:[]f32) #export_c #effects(all) {
    part:[1024]f32;
    lut:[16]f32;
    r_groups:=(n_ff+3)/4;
    t_idx:=item/r_groups;
    row0:=(item%r_groups)*4;
    nt:=cast(int)tile_cnt[0];
    blocks:=cols/32;
    row_words:=blocks*9;
    exp_words:=2*n_ff*row_words;
    for thread:0..<128 {
        if t_idx<nt && thread<16 {lut[thread]=ink_iq4_val(cast(u32)thread);}
    }
    for thread:0..<128 {
        if t_idx<nt {
            g0:f32=0;g1:f32=0;g2:f32=0;g3:f32=0;
            u0:f32=0;u1:f32=0;u2:f32=0;u3:f32=0;
            exp_id:=cast(int)tile_exp[t_idx];
            m0:=cast(int)tile_m0[t_idx];
            nm:=cast(int)exp_cnt[exp_id];
            mc:=nm-m0;
            if mc>4 {mc=4;}
            r0:=cast(int)exp_off[exp_id]+m0;
            lane:=thread%32;simd:=thread/32;
            row:=row0+simd;
            if row<n_ff {
                blk_lane:=lane/4;sub:=lane%4;k0:=sub*2;
                exp_base:=exp_id*exp_words;
                g_row_base:=exp_base+row*row_words;
                u_row_base:=g_row_base+n_ff*row_words;
                xb0:=r0*cols;
                xb1:=xb0+cols;xb2:=xb1+cols;xb3:=xb2+cols;
                n_steps:=(blocks+7)/8;
                if mc==1 {
                    for step:0..<n_steps {
                        block:=step*8+blk_lane;
                        if block<blocks {
                            boff:=block*9;
                            at_g:=g_row_base+boff;at_u:=u_row_base+boff;
                            xoff:=block*32;
                            sg0:f32=0;su0:f32=0;
                            for j:0..<2 {
                                k:=k0+j;k2:=xoff+2*k;
                                x0:=x_exp[xb0+k2];x1:=x_exp[xb0+k2+16];x2:=x_exp[xb0+k2+1];x3:=x_exp[xb0+k2+17];
                                vg:=cast(u32)w[at_g+1+k];
                                sg0+=lut[cast(int)(vg&15)]*x0+lut[cast(int)((vg>>4)&15)]*x1+lut[cast(int)((vg>>8)&15)]*x2+lut[cast(int)(vg>>12)]*x3;
                                vu:=cast(u32)w[at_u+1+k];
                                su0+=lut[cast(int)(vu&15)]*x0+lut[cast(int)((vu>>4)&15)]*x1+lut[cast(int)((vu>>8)&15)]*x2+lut[cast(int)(vu>>12)]*x3;
                            }
                            g0+=ink_half(cast(u32)w[at_g])*sg0;
                            u0+=ink_half(cast(u32)w[at_u])*su0;
                        }
                    }
                } else if mc==2 {
                    for step:0..<n_steps {
                        block:=step*8+blk_lane;
                        if block<blocks {
                            boff:=block*9;
                            at_g:=g_row_base+boff;at_u:=u_row_base+boff;
                            xoff:=block*32;
                            sg0:f32=0;sg1:f32=0;su0:f32=0;su1:f32=0;
                            for j:0..<2 {
                                k:=k0+j;k2:=xoff+2*k;
                                vg:=cast(u32)w[at_g+1+k];
                                wg0:=lut[cast(int)(vg&15)];wg1:=lut[cast(int)((vg>>4)&15)];wg2:=lut[cast(int)((vg>>8)&15)];wg3:=lut[cast(int)(vg>>12)];
                                vu:=cast(u32)w[at_u+1+k];
                                wu0:=lut[cast(int)(vu&15)];wu1:=lut[cast(int)((vu>>4)&15)];wu2:=lut[cast(int)((vu>>8)&15)];wu3:=lut[cast(int)(vu>>12)];
                                x0:=x_exp[xb0+k2];x1:=x_exp[xb0+k2+16];x2:=x_exp[xb0+k2+1];x3:=x_exp[xb0+k2+17];
                                sg0+=wg0*x0+wg1*x1+wg2*x2+wg3*x3;su0+=wu0*x0+wu1*x1+wu2*x2+wu3*x3;
                                x0=x_exp[xb1+k2];x1=x_exp[xb1+k2+16];x2=x_exp[xb1+k2+1];x3=x_exp[xb1+k2+17];
                                sg1+=wg0*x0+wg1*x1+wg2*x2+wg3*x3;su1+=wu0*x0+wu1*x1+wu2*x2+wu3*x3;
                            }
                            dg:=ink_half(cast(u32)w[at_g]);du:=ink_half(cast(u32)w[at_u]);
                            g0+=dg*sg0;u0+=du*su0;g1+=dg*sg1;u1+=du*su1;
                        }
                    }
                } else {
                    for step:0..<n_steps {
                        block:=step*8+blk_lane;
                        if block<blocks {
                            boff:=block*9;
                            at_g:=g_row_base+boff;at_u:=u_row_base+boff;
                            xoff:=block*32;
                            sg0:f32=0;sg1:f32=0;sg2:f32=0;sg3:f32=0;
                            su0:f32=0;su1:f32=0;su2:f32=0;su3:f32=0;
                            for j:0..<2 {
                                k:=k0+j;k2:=xoff+2*k;
                                vg:=cast(u32)w[at_g+1+k];
                                wg0:=lut[cast(int)(vg&15)];wg1:=lut[cast(int)((vg>>4)&15)];wg2:=lut[cast(int)((vg>>8)&15)];wg3:=lut[cast(int)(vg>>12)];
                                vu:=cast(u32)w[at_u+1+k];
                                wu0:=lut[cast(int)(vu&15)];wu1:=lut[cast(int)((vu>>4)&15)];wu2:=lut[cast(int)((vu>>8)&15)];wu3:=lut[cast(int)(vu>>12)];
                                x0:=x_exp[xb0+k2];x1:=x_exp[xb0+k2+16];x2:=x_exp[xb0+k2+1];x3:=x_exp[xb0+k2+17];
                                sg0+=wg0*x0+wg1*x1+wg2*x2+wg3*x3;su0+=wu0*x0+wu1*x1+wu2*x2+wu3*x3;
                                x0=x_exp[xb1+k2];x1=x_exp[xb1+k2+16];x2=x_exp[xb1+k2+1];x3=x_exp[xb1+k2+17];
                                sg1+=wg0*x0+wg1*x1+wg2*x2+wg3*x3;su1+=wu0*x0+wu1*x1+wu2*x2+wu3*x3;
                                x0=x_exp[xb2+k2];x1=x_exp[xb2+k2+16];x2=x_exp[xb2+k2+1];x3=x_exp[xb2+k2+17];
                                sg2+=wg0*x0+wg1*x1+wg2*x2+wg3*x3;su2+=wu0*x0+wu1*x1+wu2*x2+wu3*x3;
                                if mc>3 {
                                    x0=x_exp[xb3+k2];x1=x_exp[xb3+k2+16];x2=x_exp[xb3+k2+1];x3=x_exp[xb3+k2+17];
                                    sg3+=wg0*x0+wg1*x1+wg2*x2+wg3*x3;su3+=wu0*x0+wu1*x1+wu2*x2+wu3*x3;
                                }
                            }
                            dg:=ink_half(cast(u32)w[at_g]);du:=ink_half(cast(u32)w[at_u]);
                            g0+=dg*sg0;u0+=du*su0;g1+=dg*sg1;u1+=du*su1;g2+=dg*sg2;u2+=du*su2;
                            if mc>3 {g3+=dg*sg3;u3+=du*su3;}
                        }
                    }
                }
            }
            part[thread*8+0]=g0;part[thread*8+4]=u0;
            if mc>1 {part[thread*8+1]=g1;part[thread*8+5]=u1;}
            if mc>2 {part[thread*8+2]=g2;part[thread*8+6]=u2;}
            if mc>3 {part[thread*8+3]=g3;part[thread*8+7]=u3;}
        }
    }
    for thread:0..<128 {
        if t_idx<nt && thread<16 {
            exp_id:=cast(int)tile_exp[t_idx];
            m0:=cast(int)tile_m0[t_idx];
            nm:=cast(int)exp_cnt[exp_id];
            mc:=nm-m0;
            if mc>4 {mc=4;}
            simd:=thread/4;m:=thread%4;
            row:=row0+simd;
            if row<n_ff && m<mc {
                r0:=cast(int)exp_off[exp_id]+m0;
                g:f32=0;u:f32=0;
                for l:0..<32 {
                    g+=part[(simd*32+l)*8+m];
                    u+=part[(simd*32+l)*8+4+m];
                }
                act:=beta*ink_tanh(g/beta)*ink_sigmoid(g);
                if lb>0.0f32 {u=lb*ink_tanh(u/lb);}
                out_hid[(r0+m)*n_ff+row]=act*u;
            }
        }
    }
}

// ---- Sprint 12B: Direct IQ4_NL small-batch MoE down + fused weighted scatter (tile_m=4, 2 rows/sg = 8 rows/TG!).
// 128 threads = 4 simdgroups x 2 output rows x up to 4 tokens/tile; 4 lanes/block coalesced.
ink_moe_down_iq4_m4 :: (item:int,rows:int,cols:int,w:[]u16,x_hid:[]f32,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,row_dst:[]u32,row_wt:[]f32,slot_out:[]f32) #export_c #effects(all) {
    part:[1024]f32;
    lut:[16]f32;
    r_groups:=(rows+7)/8;
    t_idx:=item/r_groups;
    row0:=(item%r_groups)*8;
    nt:=cast(int)tile_cnt[0];
    blocks:=cols/32;
    row_words:=blocks*9;
    exp_words:=rows*row_words;
    for thread:0..<128 {
        if t_idx<nt && thread<16 {lut[thread]=ink_iq4_val(cast(u32)thread);}
    }
    for thread:0..<128 {
        if t_idx<nt {
            a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
            b0:f32=0;b1:f32=0;b2:f32=0;b3:f32=0;
            exp_id:=cast(int)tile_exp[t_idx];
            m0:=cast(int)tile_m0[t_idx];
            nm:=cast(int)exp_cnt[exp_id];
            mc:=nm-m0;
            if mc>4 {mc=4;}
            r0:=cast(int)exp_off[exp_id]+m0;
            lane:=thread%32;simd:=thread/32;
            ra:=row0+simd*2;rb:=ra+1;
            if ra<rows {
                blk_lane:=lane/4;sub:=lane%4;k0:=sub*2;
                row_a:=exp_id*exp_words+ra*row_words;
                row_b:=row_a+row_words;
                has_b:=ifx rb<rows then 1 else 0;
                xb0:=r0*cols;
                xb1:=xb0+cols;xb2:=xb1+cols;xb3:=xb2+cols;
                n_steps:=(blocks+7)/8;
                if has_b!=0 && mc==1 {
                    for step:0..<n_steps {
                        block:=step*8+blk_lane;
                        if block<blocks {
                            boff:=block*9;at_a:=row_a+boff;at_b:=row_b+boff;xoff:=block*32;
                            sa0:f32=0;sb0:f32=0;
                            for j:0..<2 {
                                k:=k0+j;k2:=xoff+2*k;
                                x0:=x_hid[xb0+k2];x1:=x_hid[xb0+k2+16];x2:=x_hid[xb0+k2+1];x3:=x_hid[xb0+k2+17];
                                va:=cast(u32)w[at_a+1+k];
                                sa0+=lut[cast(int)(va&15)]*x0+lut[cast(int)((va>>4)&15)]*x1+lut[cast(int)((va>>8)&15)]*x2+lut[cast(int)(va>>12)]*x3;
                                vb:=cast(u32)w[at_b+1+k];
                                sb0+=lut[cast(int)(vb&15)]*x0+lut[cast(int)((vb>>4)&15)]*x1+lut[cast(int)((vb>>8)&15)]*x2+lut[cast(int)(vb>>12)]*x3;
                            }
                            a0+=ink_half(cast(u32)w[at_a])*sa0;
                            b0+=ink_half(cast(u32)w[at_b])*sb0;
                        }
                    }
                } else if has_b!=0 && mc==2 {
                    for step:0..<n_steps {
                        block:=step*8+blk_lane;
                        if block<blocks {
                            boff:=block*9;at_a:=row_a+boff;at_b:=row_b+boff;xoff:=block*32;
                            sa0:f32=0;sa1:f32=0;sb0:f32=0;sb1:f32=0;
                            for j:0..<2 {
                                k:=k0+j;k2:=xoff+2*k;
                                va:=cast(u32)w[at_a+1+k];
                                wa0:=lut[cast(int)(va&15)];wa1:=lut[cast(int)((va>>4)&15)];wa2:=lut[cast(int)((va>>8)&15)];wa3:=lut[cast(int)(va>>12)];
                                vb:=cast(u32)w[at_b+1+k];
                                wb0:=lut[cast(int)(vb&15)];wb1:=lut[cast(int)((vb>>4)&15)];wb2:=lut[cast(int)((vb>>8)&15)];wb3:=lut[cast(int)(vb>>12)];
                                x0:=x_hid[xb0+k2];x1:=x_hid[xb0+k2+16];x2:=x_hid[xb0+k2+1];x3:=x_hid[xb0+k2+17];
                                sa0+=wa0*x0+wa1*x1+wa2*x2+wa3*x3;sb0+=wb0*x0+wb1*x1+wb2*x2+wb3*x3;
                                x0=x_hid[xb1+k2];x1=x_hid[xb1+k2+16];x2=x_hid[xb1+k2+1];x3=x_hid[xb1+k2+17];
                                sa1+=wa0*x0+wa1*x1+wa2*x2+wa3*x3;sb1+=wb0*x0+wb1*x1+wb2*x2+wb3*x3;
                            }
                            da:=ink_half(cast(u32)w[at_a]);db:=ink_half(cast(u32)w[at_b]);
                            a0+=da*sa0;a1+=da*sa1;b0+=db*sb0;b1+=db*sb1;
                        }
                    }
                } else {
                    for step:0..<n_steps {
                        block:=step*8+blk_lane;
                        if block<blocks {
                            boff:=block*9;at_a:=row_a+boff;at_b:=row_b+boff;xoff:=block*32;
                            sa0:f32=0;sa1:f32=0;sa2:f32=0;sa3:f32=0;
                            sb0:f32=0;sb1:f32=0;sb2:f32=0;sb3:f32=0;
                            for j:0..<2 {
                                k:=k0+j;k2:=xoff+2*k;
                                va:=cast(u32)w[at_a+1+k];
                                wa0:=lut[cast(int)(va&15)];wa1:=lut[cast(int)((va>>4)&15)];wa2:=lut[cast(int)((va>>8)&15)];wa3:=lut[cast(int)(va>>12)];
                                x0:=x_hid[xb0+k2];x1:=x_hid[xb0+k2+16];x2:=x_hid[xb0+k2+1];x3:=x_hid[xb0+k2+17];
                                sa0+=wa0*x0+wa1*x1+wa2*x2+wa3*x3;
                                if has_b!=0 {
                                    vb:=cast(u32)w[at_b+1+k];
                                    wb0:=lut[cast(int)(vb&15)];wb1:=lut[cast(int)((vb>>4)&15)];wb2:=lut[cast(int)((vb>>8)&15)];wb3:=lut[cast(int)(vb>>12)];
                                    sb0+=wb0*x0+wb1*x1+wb2*x2+wb3*x3;
                                    if mc>1 {
                                        x0=x_hid[xb1+k2];x1=x_hid[xb1+k2+16];x2=x_hid[xb1+k2+1];x3=x_hid[xb1+k2+17];
                                        sa1+=wa0*x0+wa1*x1+wa2*x2+wa3*x3;sb1+=wb0*x0+wb1*x1+wb2*x2+wb3*x3;
                                    }
                                    if mc>2 {
                                        x0=x_hid[xb2+k2];x1=x_hid[xb2+k2+16];x2=x_hid[xb2+k2+1];x3=x_hid[xb2+k2+17];
                                        sa2+=wa0*x0+wa1*x1+wa2*x2+wa3*x3;sb2+=wb0*x0+wb1*x1+wb2*x2+wb3*x3;
                                    }
                                    if mc>3 {
                                        x0=x_hid[xb3+k2];x1=x_hid[xb3+k2+16];x2=x_hid[xb3+k2+1];x3=x_hid[xb3+k2+17];
                                        sa3+=wa0*x0+wa1*x1+wa2*x2+wa3*x3;sb3+=wb0*x0+wb1*x1+wb2*x2+wb3*x3;
                                    }
                                } else {
                                    if mc>1 {sa1+=wa0*x_hid[xb1+k2]+wa1*x_hid[xb1+k2+16]+wa2*x_hid[xb1+k2+1]+wa3*x_hid[xb1+k2+17];}
                                    if mc>2 {sa2+=wa0*x_hid[xb2+k2]+wa1*x_hid[xb2+k2+16]+wa2*x_hid[xb2+k2+1]+wa3*x_hid[xb2+k2+17];}
                                    if mc>3 {sa3+=wa0*x_hid[xb3+k2]+wa1*x_hid[xb3+k2+16]+wa2*x_hid[xb3+k2+1]+wa3*x_hid[xb3+k2+17];}
                                }
                            }
                            da:=ink_half(cast(u32)w[at_a]);a0+=da*sa0;
                            if mc>1 {a1+=da*sa1;}
                            if mc>2 {a2+=da*sa2;}
                            if mc>3 {a3+=da*sa3;}
                            if has_b!=0 {
                                db:=ink_half(cast(u32)w[at_b]);b0+=db*sb0;
                                if mc>1 {b1+=db*sb1;}
                                if mc>2 {b2+=db*sb2;}
                                if mc>3 {b3+=db*sb3;}
                            }
                        }
                    }
                }
            }
            part[thread*8+0]=a0;part[thread*8+4]=b0;
            if mc>1 {part[thread*8+1]=a1;part[thread*8+5]=b1;}
            if mc>2 {part[thread*8+2]=a2;part[thread*8+6]=b2;}
            if mc>3 {part[thread*8+3]=a3;part[thread*8+7]=b3;}
        }
    }
    for thread:0..<128 {
        if t_idx<nt && thread<32 {
            exp_id:=cast(int)tile_exp[t_idx];
            m0:=cast(int)tile_m0[t_idx];
            nm:=cast(int)exp_cnt[exp_id];
            mc:=nm-m0;
            if mc>4 {mc=4;}
            simd:=thread/8;rr:=(thread/4)%2;m:=thread%4;
            row:=row0+simd*2+rr;
            if row<rows && m<mc {
                r0:=cast(int)exp_off[exp_id]+m0;
                sum:f32=0;
                for l:0..<32 {sum+=part[(simd*32+l)*8+rr*4+m];}
                dst_slot:=cast(int)row_dst[r0+m];
                ew:=row_wt[r0+m];
                slot_out[dst_slot*rows+row]=sum*ew;
            }
        }
    }
}

// ---- Sprint 14: Small-batch / small-rows F32 matmul (4 tokens x 4 rows per 128-thread TG).
// Saturates all 40 GPU cores on ffn_gate_inp (128x2304), loop_ctrl_down (64x4608), attn_sink_proj (24x2304)!
ink_mm_f32_m4 :: (item:int,rows:int,cols:int,n_tok:int,w:[]f32,x:[]f32,out:[]f32) #export_c #effects(all) {
    part:[512]f32;
    r_tiles:=(rows+3)/4;
    t0:=(item/r_tiles)*4;
    row0:=(item%r_tiles)*4;
    mc:=n_tok-t0;
    if mc>4 {mc=4;}
    for thread:0..<128 {
        lane:=thread%32;simd:=thread/32;
        row:=row0+simd;
        a0:f32=0;a1:f32=0;a2:f32=0;a3:f32=0;
        if row<rows {
            rb:=row*cols;
            xb0:=t0*cols;xb1:=xb0+cols;xb2:=xb1+cols;xb3:=xb2+cols;
            for step:0..<(cols+31)/32 {
                c:=step*32+lane;
                if c<cols {
                    wv:=w[rb+c];
                    a0+=wv*x[xb0+c];
                    if mc>1 {a1+=wv*x[xb1+c];}
                    if mc>2 {a2+=wv*x[xb2+c];}
                    if mc>3 {a3+=wv*x[xb3+c];}
                }
            }
        }
        part[thread*4+0]=a0;part[thread*4+1]=a1;part[thread*4+2]=a2;part[thread*4+3]=a3;
    }
    for thread:0..<128 {
        if thread<16 {
            simd:=thread/4;m:=thread%4;
            row:=row0+simd;
            if row<rows && m<mc {
                sum:f32=0;
                for l:0..<32 {sum+=part[(simd*32+l)*4+m];}
                out[(t0+m)*rows+row]=sum;
            }
        }
    }
}

// ---- Sprint 15B: Pack F32 [rows, cols] -> BF16 pairs [rows, cols/2] u32 (4 rows/TG, 128 threads) for Metal 4 matmul2d.
ink_dequant_f32_bf16 :: (item:int,rows:int,cols:int,w:[]f32,out_bf16:[]u32) #export_c #effects(all) {
    row0:=item*4;
    half_cols:=cols/2;
    for thread:0..<128 {
        for rr:0..<4 {
            row:=row0+rr;
            if row<rows {
                rbase:=row*cols;
                obase:=row*half_cols;
                for step:0..<(half_cols+127)/128 {
                    p:=step*128+thread;
                    if p<half_cols {
                        b0:=(f32_bits(w[rbase+2*p])+0x8000)>>16;
                        b1:=(f32_bits(w[rbase+2*p+1])+0x8000)>>16;
                        out_bf16[obase+p]=b0|(b1<<16);
                    }
                }
            }
        }
    }
}

// ---- Sprint 29: Fused depth-attention mix + ctrl_prep (for MoE looped control, -24 dispatches & -24 barriers/tok).
// Writes raw mix output to out_mix[0..dim-1], and concat(rms(out_mix, 1e-6), rms(msg, 1e-6)) to out_cat[0..2*dim-1].
// Launch 1 work item, lanes = 256.
// ---- Sprint 61: Vectorized float4 register-cached am_mix_fused FFN ctrl prep!
ink_mix_ctrl_prep :: (item:int,dim:int,n_blocks:int,blocks_buf:[]f32,cur:[]f32,query:[]f32,msg:[]f32,out_mix:[]f32,out_cat:[]f32) #export_c #effects(all) {
    for thread:0..<INK_NT {
        am_mix_fused(2,dim,n_blocks,0.000001f32,blocks_buf,cur,query,0,msg,0,out_mix,0,out_cat,0);
    }
}

// ---- Sprint 29: GPU greedy argmax stage 1 (64 TGs x 256 threads scan logits -> 64 partial (val, id) pairs).
ink_argmax_s1 :: (item:int,n:int,logits:[]f32,out_vals:[]f32,out_ids:[]u32) #export_c #effects(all) {
    pv:[256]f32;pi:[256]u32;
    chunk:=(n+63)/64;
    lo:=item*chunk;
    hi:=lo+chunk;
    if hi>n {hi=n;}
    for thread:0..<INK_NT {
        bv:f32=-1.0e30f32;
        bi:u32=0;
        for step:0..<(chunk+255)/256 {
            i:=lo+step*256+thread;
            if i<hi {
                v:=logits[i];
                if v>bv {bv=v;bi=cast(u32)i;}
            }
        }
        wmax:=am_simd_max(bv);
        tie:f32=ifx bv==wmax then -f32(bi) else -1.0e30f32;
        wbest:=-am_simd_max(tie);
        pv[thread]=wmax;
        pi[thread]=cast(u32)wbest;
    }
    for thread:0..<INK_NT {
        if thread==0 {
            bv:=pv[0];bi:=pi[0];
            for j:1..<8 {
                idx:=j*32;
                if pv[idx]>bv || (pv[idx]==bv && pi[idx]<bi) {bv=pv[idx];bi=pi[idx];}
            }
            out_vals[item]=bv;
            out_ids[item]=bi;
        }
    }
}

// ---- Sprint 29: GPU greedy argmax stage 2 (1 TG of 64 threads reduces 64 partial pairs -> out_id[0]).
ink_argmax_s2 :: (item:int,n_parts:int,vals:[]f32,ids:[]u32,out_id:[]u32) #export_c #effects(all) {
    for thread:0..<INK_T {
        if thread==0 {
            bv:=vals[0];bi:=ids[0];
            for j:1..<n_parts {
                if vals[j]>bv || (vals[j]==bv && ids[j]<bi) {bv=vals[j];bi=ids[j];}
            }
            out_id[0]=bi;
        }
    }
}

// ---- Sprint 30: Parallel coalesced MoE slot reduction (replaces serial 2304-thread K_MOE_REDUCE_BATCH: 446ms -> ~30ms!).
// Launch items = nb * ceil(d / 128), lanes = 128.
ink_moe_sum_batch :: (item:int,dim:int,n_used:int,slot_out:[]f32,out:[]f32) #export_c #effects(all) {
    d_tiles:=(dim+127)/128;
    t:=item/d_tiles;
    c0:=(item%d_tiles)*128;
    base:=t*n_used*dim;
    for thread:0..<128 {
        c:=c0+thread;
        if c<dim {
            sum:f32=0;
            for k:0..<n_used {sum+=slot_out[base+k*dim+c];}
            out[t*dim+c]=sum;
        }
    }
}

// ---- Sprint 31A: Zero-LUT, Zero-TGEM, Zero-Barrier Q4_0 matvec via am_dot_q4_lane (16 blocks/step!).
// ---- Sprint 59: 2-row-per-warp (8 rows/TG, 128 threads) Q4_0 matvec (shares xl,xh,xsum + packed_ushort2!).
ink_dv_q4 :: (item:int,rows:int,cols:int,add:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    blocks:=cols/32;words:=blocks*9;
    for thread:0..<128 {
        row:=item*8+(thread/32)*2;
        lane:=thread%32;
        if add==0 && row+1<rows {
            am_dot_q4_2_write(w,row*words,(row+1)*words,x,0,blocks,out,row,row+1);
        } else {
            if row<rows {
                tot:=am_simd_sum(am_dot_q4_lane(w,row*words,x,0,blocks));
                if lane==0 {
                    if add!=0 {out[row]=out[row]+tot;} else {out[row]=tot;}
                }
            }
            if row+1<rows {
                tot:=am_simd_sum(am_dot_q4_lane(w,(row+1)*words,x,0,blocks));
                if lane==0 {
                    if add!=0 {out[row+1]=out[row+1]+tot;} else {out[row+1]=tot;}
                }
            }
        }
    }
}

// ---- Sprint 62/65: 2-row-per-warp (8 rows/TG, 128 threads) single-loop Q4_0 matvec + fused shortconv + residual!
ink_dv_q4_conv :: (item:int,rows:int,cols:int,add_res:int,w:[]u16,x:[]f32,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    blocks:=cols/32;words:=blocks*9;
    for thread:0..<128 {
        row:=item*8+(thread/32)*2;
        if row<rows {
            r1:=ifx row+1<rows then row+1 else row;
            am_dot_q4_conv_2_write(w,row*words,r1*words,x,blocks,add_res,cw,hist,res,out,row,r1);
        }
    }
}

// ---- Sprint 61: 128-thread (4 warps/row) half4+float4 F16 small-row matvec (high warp occupancy on 40 cores!).
ink_dv_f16_small :: (item:int,rows:int,cols:int,add:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        if item<rows {
            am_dot_f16_tg_write(w,item*cols,x,0,cols,add,0.0f32,out,item);
        }
    }
}

// ---- Sprint 61: 128-thread (4 warps/row) SINGLE-PASS F16 GEMV + RMSNorm scale (runs concurrently with K_RMSNORM!).
ink_dv_f16_norm :: (item:int,rows:int,cols:int,eps:f32,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        if item<rows {
            am_dot_f16_tg_write(w,item*cols,x,0,cols,0,eps,out,item);
        }
    }
}

// ---- Sprint 61: Native unrolled-4 half + hardware tanh loop_ctrl_gain + loop_ctrl_forget + apply!
ink_ctrl_up_apply_f16 :: (item:int,dim:int,rank:int,w_gain:[]u16,w_forget:[]u16,gate:[]f32,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<INK_T {
        am_ctrl_up_apply_f16(dim,rank,item*INK_T,w_gain,0,w_forget,0,gate,0,cur,0,msg,0,out,0);
    }
}

// ---- Sprint 65/67: 2-row-per-warp (1152 TGs, 4lb zero-LUT ALU + 1-warp noinline fused Router top-8) Q4_0 MoE gate_up + SITU!
ink_moe_gu_q4 :: (item:int,n_ff:int,cols:int,n_exp:int,n_used:int,has_bias:int,r_scale:f32,beta:f32,lb:f32,w:[]u16,x:[]f32,logits:[]f32,bias:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #export_c #effects(all) {
    groups_per_exp:=(n_ff+7)/8;
    slot:=item/groups_per_exp;
    row0:=(item%groups_per_exp)*8;
    for thread:0..<128 {
        am_moe_gu_q4_tg(slot,row0,n_ff,cols,n_exp,n_used,has_bias,r_scale,beta,lb,w,x,logits,bias,ids,wts,out);
    }
}

// ---- Sprint 65: 4-row-per-TG (576 TGs, 4 warps x 2 experts, 4lb zero-LUT ALU) Q4_0 MoE down + fused post_conv + res (448.3 GB/s!).
ink_moe_down_q4 :: (item:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,ids:[]u32,wts:[]f32,conv_w:[]f32,hist:[]f32,res:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        am_moe_down_q4_tg(item*4,rows,cols,n_used,w,x,ids,wts,conv_w,hist,res,out);
    }
}

// ---- Sprint 52: Native BF16xBF16 Double/Quad-M-tile IQ4_NL MoE GEMMs!
ink_moe_mm_iq4_128 :: (item:int,rows:int,cols:int,w:[]u16,x_exp:[]u16,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,y_exp:[]f32) #export_c #effects(all) {
    tg:[4096]u16;
    r_tiles:=(rows+63)/64;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        ec:=cast(int)exp_cnt[exp_id];
        eoff:=cast(int)exp_off[exp_id];
        row_words:=(cols/32)*9;
        w_off:=exp_id*rows*row_words;
        am_matmul_iq4_bf16(128,128,64,rows,cols,ec,r0,m0,w[w_off..<w_off+rows*row_words],x_exp[eoff*cols..<(eoff+ec)*cols],y_exp[eoff*rows..<(eoff+ec)*rows],tg[..]);
    }
}

ink_moe_mm_iq4_256 :: (item:int,rows:int,cols:int,w:[]u16,x_exp:[]u16,exp_cnt:[]u32,exp_off:[]u32,tile_exp:[]u32,tile_m0:[]u32,tile_cnt:[]u32,y_exp:[]f32) #export_c #effects(all) {
    tg:[4096]u16;
    r_tiles:=(rows+63)/64;
    t_idx:=item/r_tiles;
    r0:=(item%r_tiles)*64;
    for thread:0..<128 {}
    nt:=cast(int)tile_cnt[0];
    if t_idx<nt {
        exp_id:=cast(int)tile_exp[t_idx];
        m0:=cast(int)tile_m0[t_idx];
        ec:=cast(int)exp_cnt[exp_id];
        eoff:=cast(int)exp_off[exp_id];
        row_words:=(cols/32)*9;
        w_off:=exp_id*rows*row_words;
        am_matmul_iq4_bf16(128,256,64,rows,cols,ec,r0,m0,w[w_off..<w_off+rows*row_words],x_exp[eoff*cols..<(eoff+ec)*cols],y_exp[eoff*rows..<(eoff+ec)*rows],tg[..]);
    }
}

ink_moe_gather_bf16 :: (item:int,dim:int,n_used:int,x:[]f32,exp_toks:[]u32,exp_slots:[]u32,exp_wts:[]f32,exp_cnt:[]u32,exp_off:[]u32,x_exp:[]u16,row_dst:[]u32,row_wt:[]f32) #export_c #effects(all) {
    exp_id:=item/8;
    sub:=item%8;
    cnt:=cast(int)exp_cnt[exp_id];
    if sub<cnt {
        ebase:=exp_id*INK_PREFILL_B;
        off:=cast(int)exp_off[exp_id];
        steps:=(dim+127)/128;
        iters:=(cnt-sub+7)/8;
        for thread:0..<128 {
            for k:0..<iters {
                c:=sub+k*8;
                tok:=cast(int)exp_toks[ebase+c];
                dst_row:=off+c;
                if thread==0 {
                    sl:=cast(int)exp_slots[ebase+c];
                    row_dst[dst_row]=cast(u32)(tok*n_used+sl);
                    row_wt[dst_row]=exp_wts[ebase+c];
                }
                sbase:=tok*dim;
                dbase:=dst_row*dim;
                for st:0..<steps {
                    r:=st*128+thread;
                    if r<dim {x_exp[dbase+r]=cast(u16)(f32_bits(x[sbase+r])>>16);}
                }
            }
        }
    }
}

ink_situ_batch_bf16 :: (item:int,n_ff:int,beta:f32,lb:f32,gu_out:[]f32,hid:[]u16) #export_c #effects(all) {
    base:=item*2*n_ff;
    hbase:=item*n_ff;
    steps:=(n_ff+127)/128;
    for thread:0..<128 {
        for s:0..<steps {
            row:=s*128+thread;
            if row<n_ff {
                g:=gu_out[base+row];
                u:=gu_out[base+n_ff+row];
                act:=beta*ink_tanh(g/beta)*ink_sigmoid(g);
                if lb>0.0f32 {u=lb*ink_tanh(u/lb);}
                hid[hbase+row]=cast(u16)(f32_bits(act*u)>>16);
            }
        }
    }
}

// ---- Sprint 50: 4-row-per-TG (128-thread) Fused Q + R + Gate Q4_0 matvec (-96 dispatches/tok!).
// Launch items = (n_q + n_r + n_q + 3) / 4, lanes = 128.
// ---- Sprint 59: 2-row-per-warp (8 rows/TG, 128 threads) fused Q+R+Gate Q4_0 matvec!
ink_dv_q4_qrg :: (item:int,n_q:int,n_r:int,cols:int,w:[]u16,x:[]f32,out_q:[]f32,out_r:[]f32,out_g:[]f32) #export_c #effects(all) {
    blocks:=cols/32;words:=blocks*9;
    n_qr:=n_q+n_r;
    tot_rows:=n_qr+n_q;
    for thread:0..<128 {
        row:=item*8+(thread/32)*2;
        lane:=thread%32;
        if row+1<n_q {
            am_dot_q4_2_write(w,row*words,(row+1)*words,x,0,blocks,out_q,row,row+1);
        } else if row>=n_q && row+1<n_qr {
            am_dot_q4_2_write(w,row*words,(row+1)*words,x,0,blocks,out_r,row-n_q,row+1-n_q);
        } else if row>=n_qr && row+1<tot_rows {
            am_dot_q4_2_write(w,row*words,(row+1)*words,x,0,blocks,out_g,row-n_qr,row+1-n_qr);
        } else {
            if row<tot_rows {
                tot:=am_simd_sum(am_dot_q4_lane(w,row*words,x,0,blocks));
                if lane==0 {
                    if row<n_q {out_q[row]=tot;}
                    else if row<n_qr {out_r[row-n_q]=tot;}
                    else {out_g[row-n_qr]=tot;}
                }
            }
            if row+1<tot_rows {
                tot:=am_simd_sum(am_dot_q4_lane(w,(row+1)*words,x,0,blocks));
                if lane==0 {
                    r1:=row+1;
                    if r1<n_q {out_q[r1]=tot;}
                    else if r1<n_qr {out_r[r1-n_q]=tot;}
                    else {out_g[r1-n_qr]=tot;}
                }
            }
        }
    }
}

// ---- Sprint 61: Native register-cached float4 3-TG RMSNorm for (Q, K, V)!
ink_rmsnorm_3 :: (item:int,dim:int,is_swa:int,eps:f32,xq:[]f32,xk:[]f32,xv:[]f32,wq:[]f32,wk:[]f32,wv:[]f32,oq:[]f32,ok:[]f32,ov:[]f32) #export_c #effects(all) {
    for thread:0..<INK_NT {
        if item==0 {am_rmsnorm_f32(dim,1,eps,xq,0,wq,0,oq,0);}
        else if item==1 {
            if is_swa!=0 {am_rmsnorm_f32(dim,1,eps,xk,0,wq,0,ok,0);}
            else {am_rmsnorm_f32(dim,1,eps,xk,0,wk,0,ok,0);}
        } else {
            if is_swa!=0 {am_rmsnorm_f32(dim,1,eps,xv,0,wq,0,ov,0);}
            else {am_rmsnorm_f32(dim,1,eps,xv,0,wv,0,ov,0);}
        }
    }
}

// ---- Sprint 61: Native float4/half4 zero-TGEM/zero-barrier fused K+V conv+clip/norm+KV store!
ink_conv_kv_both :: (item:int,n_head_kv:int,n_kv_elem:int,slot_pos:int,has_dyn:int,threshold:f32,eps:f32,k_raw:[]f32,v_raw:[]f32,kw:[]f32,vw:[]f32,dyn:[]f32,k_hist:[]f32,v_hist:[]f32,k_cache:[]u16,v_cache:[]u16) #export_c #effects(all) {
    for lane:0..<32 {
        am_conv_kv_both(item,n_head_kv,n_kv_elem,slot_pos,has_dyn,threshold,eps,k_raw,v_raw,kw,vw,dyn,k_hist,v_hist,k_cache,v_cache);
    }
}

// ---- Sprint 61: 128-thread (4 warps/row) Fused 1-dispatch lossless F16 ctrl_down[0..2]!
// Launch items = 3 * rank, lanes = 128.
ink_dv_q4_ctrl_down_3 :: (item:int,rank:int,cols:int,w:[]u16,x:[]f32,out:[]f32) #export_c #effects(all) {
    tot_rows:=3*rank;
    for thread:0..<128 {
        if item<tot_rows {
            slot:=item/rank;
            am_dot_f16_tg_write(w,item*cols,x,slot*cols,cols,0,0.0f32,out,item);
        }
    }
}

// ---- Sprint 61: Native unrolled-4 half + hardware tanh Fused 1-dispatch F16 ctrl_up_apply[0..2]!
ink_ctrl_up_apply_f16_3 :: (item:int,dim:int,rank:int,is_swa:int,w_gain:[]u16,w_forget:[]u16,gate:[]f32,cur:[]f32,msg:[]f32,out_q:[]f32,out_k:[]f32,out_v:[]f32) #export_c #effects(all) {
    per:=(dim+INK_T-1)/INK_T;
    slot:=item/per;
    tile:=item%per;
    wbase:=slot*rank*dim;
    cbase:=ifx is_swa!=0 then 0 else slot*dim;
    mbase:=slot*dim;
    gbase:=slot*rank;
    for thread:0..<INK_T {
        if slot==0 {am_ctrl_up_apply_f16(dim,rank,tile*INK_T,w_gain,wbase,w_forget,wbase,gate,gbase,cur,cbase,msg,mbase,out_q,0);}
        else if slot==1 {am_ctrl_up_apply_f16(dim,rank,tile*INK_T,w_gain,wbase,w_forget,wbase,gate,gbase,cur,cbase,msg,mbase,out_k,0);}
        else {am_ctrl_up_apply_f16(dim,rank,tile*INK_T,w_gain,wbase,w_forget,wbase,gate,gbase,cur,cbase,msg,mbase,out_v,0);}
    }
}

// ---- Sprint 62: Fused 256-thread (8-warp) K+V conv+clip/norm+KV-store + 3-head GQA Flash-Decoding Attention (-48 dispatches & -48 barriers, 3x less KV reads!).
ink_kv_attn_gqa_1pass :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos:int,slot_pos:int,qk_clip:f32,rel_clip:f32,q_tau:f32,eps:f32,k_raw:[]f32,v_raw:[]f32,kw:[]f32,vw:[]f32,dyn:[]f32,k_hist:[]f32,v_hist:[]f32,q:[]f32,q_scale:[]f32,r:[]f32,r_scale:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,out:[]f32) #export_c #effects(all) {
    for thread:0..<256 {
        am_kv_attn_gqa_1pass(item,dims0,dims1,kv_info,pos,slot_pos,qk_clip,rel_clip,q_tau,eps,k_raw,v_raw,kw,vw,dyn,k_hist,v_hist,q,q_scale,r,r_scale,rel_bias,sinks,gate,k_cache,v_cache,out);
    }
}

// ---- Sprint 62/63: Interleaved half2 (gain, forget) loop ctrl_up_apply (zero-TG 32-lane half4 + simd_shuffle!).
ink_ctrl_up_apply_gf :: (item:int,dim:int,rank:int,w_gf:[]u32,gate:[]f32,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    for lane:0..<32 {
        am_ctrl_up_apply_gf(dim,rank,item*INK_T,w_gf,0,gate,0,cur,0,msg,0,out,0);
    }
}

ink_ctrl_up_apply_gf_3 :: (item:int,dim:int,rank:int,is_swa:int,w_gf:[]u32,gate:[]f32,cur:[]f32,msg:[]f32,out_q:[]f32,out_k:[]f32,out_v:[]f32) #export_c #effects(all) {
    per:=(dim+INK_T-1)/INK_T;
    slot:=item/per;
    tile:=item%per;
    wbase:=slot*rank*dim;
    cbase:=ifx is_swa!=0 then 0 else slot*dim;
    mbase:=slot*dim;
    gbase:=slot*rank;
    for lane:0..<32 {
        if slot==0 {am_ctrl_up_apply_gf(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,out_q,0);}
        else if slot==1 {am_ctrl_up_apply_gf(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,out_k,0);}
        else {am_ctrl_up_apply_gf(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,out_v,0);}
    }
}

// ---- Sprint 63: Fused ctrl_up_apply_gf + w_norm multiply + tile sum_sq into rms_parts (deletes 24 K_RMSNORM_3 + 24 barriers!).
ink_ctrl_up_apply_gf_3_norm :: (item:int,dim:int,rank:int,is_swa:int,w_gf:[]u32,gate:[]f32,cur:[]f32,msg:[]f32,wq:[]f32,wk:[]f32,wv:[]f32,out_q:[]f32,out_k:[]f32,out_v:[]f32,rms_parts:[]f32) #export_c #effects(all) {
    per:=(dim+INK_T-1)/INK_T;
    slot:=item/per;
    tile:=item%per;
    wbase:=slot*rank*dim;
    cbase:=ifx is_swa!=0 then 0 else slot*dim;
    mbase:=slot*dim;
    gbase:=slot*rank;
    for lane:0..<32 {
        if slot==0 {am_ctrl_up_apply_gf_norm(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,wq,out_q,0,rms_parts,item);}
        else if slot==1 {
            if is_swa!=0 {am_ctrl_up_apply_gf_norm(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,wq,out_k,0,rms_parts,item);}
            else {am_ctrl_up_apply_gf_norm(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,wk,out_k,0,rms_parts,item);}
        } else {
            if is_swa!=0 {am_ctrl_up_apply_gf_norm(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,wq,out_v,0,rms_parts,item);}
            else {am_ctrl_up_apply_gf_norm(dim,rank,tile*INK_T,w_gf,wbase,gate,gbase,cur,cbase,msg,mbase,wv,out_v,0,rms_parts,item);}
        }
    }
}

// ---- Sprint 63: Fused 3-stream depth-attention mix + RMSNorm for non-looped Full attention layers (deletes 4 K_RMSNORM_3 + 4 barriers!).
ink_mix_rmsnorm_3 :: (item:int,dim:int,n_blocks:int,eps:f32,blocks_buf:[]f32,cur:[]f32,query:[]f32,wq:[]f32,wk:[]f32,wv:[]f32,oq:[]f32,ok:[]f32,ov:[]f32) #export_c #effects(all) {
    qoff:=item*dim;
    for thread:0..<INK_NT {
        if item==0 {am_mix_fused(1,dim,n_blocks,eps,blocks_buf,cur,query,qoff,wq,0,oq,0,oq,0);}
        else if item==1 {am_mix_fused(1,dim,n_blocks,eps,blocks_buf,cur,query,qoff,wk,0,ok,0,ok,0);}
        else {am_mix_fused(1,dim,n_blocks,eps,blocks_buf,cur,query,qoff,wv,0,ov,0,ov,0);}
    }
}

// ---- Sprint 65: Fused 1-dispatch Q+R+Gate+K+V Q4_0 matvec (with optional deferred RMSNorm from rms_parts, -96 dispatches/tok!).
ink_dv_q4_qrgkv :: (item:int,n_q:int,n_r:int,n_kv:int,cols:int,n_parts:int,eps:f32,w:[]u16,xq:[]f32,xk:[]f32,xv:[]f32,parts:[]f32,oq:[]f32,or_:[]f32,og:[]f32,ok:[]f32,ov:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        am_dot_q4_qrgkv(item*8,n_q,n_r,n_kv,cols,n_parts,eps,w,xq,xk,xv,parts,oq,or_,og,ok,ov);
    }
}

ink_dv_q4_rms :: (item:int,rows:int,cols:int,p_off:int,n_parts:int,eps:f32,cap:f32,w:[]u16,x:[]f32,parts:[]f32,out:[]f32) #export_c #effects(all) {
    blocks:=cols/32;words:=blocks*9;
    for thread:0..<128 {
        row:=item*8+(thread/32)*2;
        if row<rows {
            r1:=ifx row+1<rows then row+1 else row;
            am_dot_q4_2_write_ex(w,row*words,r1*words,x,0,blocks,parts,p_off,n_parts,eps,cap,out,row,r1);
        }
    }
}

ink_dv_f16_small_rms :: (item:int,rows:int,cols:int,p_off:int,n_parts:int,eps:f32,w:[]u16,x:[]f32,parts:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        if item<rows {
            am_dot_f16_tg_write_rms(w,item*cols,x,0,cols,parts,p_off,n_parts,eps,out,item);
        }
    }
}

// ---- Sprint 64: Coalesced 16-token half2 ctrl_up_apply_gf_batch & Metal 4 Neural Accelerator Flash-Prefill Attention!
ink_ctrl_up_apply_gf_batch :: (item:int,dim:int,rank:int,n_tok:int,w_off:int,w_gf:[]u32,gate:[]f32,cur:[]f32,msg:[]f32,out:[]f32) #export_c #effects(all) {
    groups:=(dim+INK_T-1)/INK_T;
    t0:=(item/groups)*16;
    row0:=(item%groups)*INK_T;
    for thread:0..<128 {
        am_ctrl_up_apply_gf_batch(dim,rank,n_tok,t0,row0,w_gf,w_off,gate,0,cur,0,msg,0,out,0);
    }
}

ink_attn_scores_m4 :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos0:int,n_tok:int,k_start:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,k_cache:[]u16,scores:[]u16) #export_c #effects(all) {
    for thread:0..<128 {
        am_attn_scores_m4(item,dims0,dims1,kv_info,pos0,n_tok,k_start,q,r,rel_bias,sinks,k_cache,scores);
    }
}

ink_attn_values_m4 :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos0:int,n_tok:int,k_start:int,scores:[]u16,inv_gsum:[]f32,v_cache:[]u16,gate:[]f32,out:[]f32) #export_c #effects(all) {
    for thread:0..<128 {
        am_attn_values_m4(item,dims0,dims1,kv_info,pos0,n_tok,k_start,scores,inv_gsum,v_cache,gate,out);
    }
}

// book:begin quant-metal-kernels
// FP4 E2M1 value table (NVFP4 micro-block element: 1 sign bit + 3-bit magnitude).
ink_nvfp4_val :: (nib:u32)->f32 #effects(all) {
    m:=nib&7;
    v:f32=ifx m==0 then 0.0f32 else ifx m==1 then 0.5f32 else ifx m==2 then 1.0f32 else ifx m==3 then 1.5f32
        else ifx m==4 then 2.0f32 else ifx m==5 then 3.0f32 else ifx m==6 then 4.0f32 else 6.0f32;
    return ifx (nib&8)!=0 then -v else v;
}

// FP8 E4M3FN byte -> f32 (bias 7, subnormals exact via f32_from_bits).
ink_fp8_e4m3 :: (b:u32)->f32 #effects(all) {
    e:=(b>>3)&15; m:=b&7;
    v:f32=ifx e==0 then f32(m)*(1.0f32/512.0f32) else f32_from_bits(((e+120)<<23)|(m<<20));
    return ifx (b&128)!=0 then -v else v;
}

// UE8M0 shared microscaling exponent -> f32 (2^(e - 127), exact power of two).
ink_ue8m0 :: (e:u32)->f32 #effects(all) {
    if e==0 { return f32_from_bits(0x00400000); }
    return f32_from_bits((e&255)<<23);
}

// Register-dequantizing NVFP4 GEMV on Metal (16-element micro-blocks: 2 u32 packed nibbles + E4M3 block scale + f32 global_scale).
// 1 warp (32 lanes) per row; launch items = rows, lanes = 32. Zero FP16/FP32 weight buffer materialization.
ink_dv_nvfp4 :: (item:int,rows:int,cols:int,global_scale:f32,packed:[]u32,scales:[]u32,x:[]f32,out:[]f32) #export_c #effects(all) {
    blocks:=cols/16;
    for thread:0..<32 {
        row:=item;
        acc:f32=0;
        if row<rows {
            for step:0..<(blocks+31)/32 {
                blk:=step*32+thread;
                if blk<blocks {
                    bidx:=row*blocks+blk;
                    w0:=packed[bidx*2];
                    w1:=packed[bidx*2+1];
                    sc_word:=scales[bidx/4];
                    sc_byte:=(sc_word>>cast(u32)((bidx&3)*8))&255;
                    sc:=ink_fp8_e4m3(sc_byte)*global_scale;
                    xb:=blk*16;
                    s:f32=0;
                    for j:0..<8 {
                        s+=ink_nvfp4_val((w0>>cast(u32)(j*4))&15)*x[xb+j];
                        s+=ink_nvfp4_val((w1>>cast(u32)(j*4))&15)*x[xb+8+j];
                    }
                    acc+=sc*s;
                }
            }
            tot:=am_simd_sum(acc);
            if thread==0 { out[row]=tot; }
        }
    }
}

// Register-dequantizing MXFP8 GEMV on Metal (32-element micro-blocks: 8 u32 E4M3 bytes + UE8M0 shared exponent).
// 1 warp (32 lanes) per row; launch items = rows, lanes = 32. Zero FP16/FP32 weight buffer materialization.
ink_dv_mxfp8 :: (item:int,rows:int,cols:int,weights:[]u32,scales:[]u32,x:[]f32,out:[]f32) #export_c #effects(all) {
    blocks:=cols/32;
    for thread:0..<32 {
        row:=item;
        acc:f32=0;
        if row<rows {
            for step:0..<(blocks+31)/32 {
                blk:=step*32+thread;
                if blk<blocks {
                    bidx:=row*blocks+blk;
                    sc_word:=scales[bidx/4];
                    sc_byte:=(sc_word>>cast(u32)((bidx&3)*8))&255;
                    sc:=ink_ue8m0(sc_byte);
                    xb:=blk*32;
                    wbase:=bidx*8;
                    s:f32=0;
                    for j:0..<8 {
                        wd:=weights[wbase+j];
                        s+=ink_fp8_e4m3(wd&255)*x[xb+j*4]
                          +ink_fp8_e4m3((wd>>8)&255)*x[xb+j*4+1]
                          +ink_fp8_e4m3((wd>>16)&255)*x[xb+j*4+2]
                          +ink_fp8_e4m3((wd>>24)&255)*x[xb+j*4+3];
                    }
                    acc+=sc*s;
                }
            }
            tot:=am_simd_sum(acc);
            if thread==0 { out[row]=tot; }
        }
    }
}
// book:end quant-metal-kernels
