// Chapter 48: integer matrix products with 8-bit activation blocks.
// Profile int8-block-i32-v1: activations quantized per block of `block` values
// to codes in [-127, 127] with an f32 scale rounded up from amax/127 and a
// stored code sum; weights are codes in [-127, 127] with an f32 scale and an
// f32 offset per block. Each block's dot product is exact in s32 (the plan
// refuses any block size whose worst case could overflow); blocks combine in
// binary64. Integer parts are exact; only quantization and scaling round.
#load "ops.coax";                         // chapter 4's float product, the reference
#load "../tests/int8-products-checks.coax";  // the checks' fixtures and naive oracle
#authority;

INT8_CODE_MAX :: 127;
INT8_S32_MAX :: 2147483647;
INT8_MAC_LIMIT :: 1048576;
INT8_TILE :: 4;

// book:begin types
Int8Status :: enum u8 {ok;shape;overflow;limit;storage;capacity;code;scale;sum;number;tile;}
Int8Request :: struct {rows:int;width:int;tokens:int;block:int;}
Int8Plan :: struct {status:Int8Status;blocks:int;weight_codes:int;weight_scales:int;activation_codes:int;activation_scales:int;outputs:int;dots:int;}
Int8Result :: struct {status:Int8Status;written:int;}
// Weight value = scale * code + offset, one scale and offset per row block.
Int8Weights :: struct {codes:[]s8;scales:[]f32;offsets:[]f32;}
// Activation value ~ scale * code; sums[b] is the sum of block b's codes.
Int8Activations :: struct {codes:[]s8;scales:[]f32;sums:[]s32;}
// book:end types

// Checks precede the implementation.
#test "the hand overflow bound: 32 x 127 x 127 fits s32, and the largest block is 133144" {
    #assert 32*127*127==516128 && 516128<INT8_S32_MAX;
    #assert 133144*16129==2147479576 && 2147479576<=INT8_S32_MAX && 133148*16129>INT8_S32_MAX;
    #assert int8_block_fits(32) && int8_block_fits(133144) && !int8_block_fits(133145);
    a:[32]s8;b:[32]s8;
    for i:0..<32 {a[i]=127;b[i]=127;}
    #assert int8_dot(a[..],0,b[..],0,32)==516128;
    for i:0..<32 {b[i]=-127;}
    #assert int8_dot(a[..],0,b[..],0,32)==-516128;
}
#test "the largest admitted block reaches its bound without trapping" #steps 200000000 {
    n:=133144;a:[133144]s8;b:[133144]s8;
    for i:0..<n {a[i]=-127;b[i]=127;}
    #assert int8_dot(a[..],0,b[..],0,n)==-2147479576;
    for i:0..<n {b[i]=-127;}
    #assert int8_dot(a[..],0,b[..],0,n)==2147479576;
    p:=int8_plan(Int8Request.{rows=1,width=n,tokens=1,block=n});
    #assert p.status==Int8Status.ok && p.blocks==1 && p.dots==1;
}
#test "plans count every buffer and refuse bad shapes, overflow-prone blocks and too much work" {
    p:=int8_plan(Int8Request.{rows=8,width=96,tokens=4,block=32});
    #assert p.status==Int8Status.ok && p.blocks==3 && p.weight_codes==768 && p.weight_scales==24;
    #assert p.activation_codes==384 && p.activation_scales==12 && p.outputs==32 && p.dots==96;
    #assert int8_plan(Int8Request.{rows=1,width=4,tokens=1,block=4}).status==Int8Status.ok;
    for bad:[6]int.[0,-4,2,6,33,-1] {#assert int8_plan(Int8Request.{rows=1,width=96,tokens=1,block=bad}).status==Int8Status.shape;}
    #assert int8_plan(Int8Request.{rows=1,width=96,tokens=1,block=64}).status==Int8Status.shape;
    #assert int8_plan(Int8Request.{rows=1,width=16,tokens=1,block=32}).status==Int8Status.shape;
    #assert int8_plan(Int8Request.{rows=1,width=133148,tokens=1,block=133148}).status==Int8Status.overflow;
    #assert int8_plan(Int8Request.{rows=1,width=2097152,tokens=1,block=1048576}).status==Int8Status.overflow;
    for bad:[2]int.[0,-1] {
        #assert int8_plan(Int8Request.{rows=bad,width=32,tokens=1,block=32}).status==Int8Status.shape;
        #assert int8_plan(Int8Request.{rows=1,width=bad,tokens=1,block=32}).status==Int8Status.shape;
        #assert int8_plan(Int8Request.{rows=1,width=32,tokens=bad,block=32}).status==Int8Status.shape;
    }
    #assert int8_work_fits(1048576,1,1) && int8_work_fits(1,1048576,1) && int8_work_fits(1,1,1048576) && int8_work_fits(3,349525,1);
    #assert !int8_work_fits(1048577,1,1) && !int8_work_fits(1,1048577,1) && !int8_work_fits(1,1,1048577) && !int8_work_fits(1025,1024,1) && !int8_work_fits(17,61681,1) && int8_work_fits(1025,1023,1);
    #assert !int8_work_fits(9223372036854775807,9223372036854775807,9223372036854775807);
    #assert int8_plan(Int8Request.{rows=1,width=1048576,tokens=1,block=32}).status==Int8Status.ok;
    #assert int8_plan(Int8Request.{rows=1024,width=1024,tokens=1,block=32}).status==Int8Status.ok;
    #assert int8_plan(Int8Request.{rows=512,width=1024,tokens=2,block=32}).status==Int8Status.ok;
    #assert int8_plan(Int8Request.{rows=1025,width=1024,tokens=1,block=32}).status==Int8Status.limit;
    #assert int8_plan(Int8Request.{rows=512,width=1024,tokens=3,block=32}).status==Int8Status.limit;
    #assert int8_plan(Int8Request.{rows=1,width=1048608,tokens=1,block=32}).status==Int8Status.limit;
    #assert int8_plan(Int8Request.{rows=9223372036854775807,width=32,tokens=9223372036854775807,block=32}).status==Int8Status.limit;
}
#test "hand quantization of one block of four" {
    // amax 1.984375 = 127/64, so the scale is exactly 1/64.
    x:=[4]f32.[1.984375,-0.5,0.1,0.0078125];codes:[4]s8;scales:[1]f32;sums:[1]s32;
    r:=int8_quantize(Int8Request.{rows=1,width=4,tokens=1,block=4},x[..],Int8Activations.{codes=codes[..],scales=scales[..],sums=sums[..]});
    #assert r.status==Int8Status.ok && r.written==1;
    #assert scales[0]==0.015625 && codes[0]==127 && codes[1]==-32 && codes[2]==6 && codes[3]==1 && sums[0]==102;
    // 0.0078125 is exactly half a step: ties go upward.
    #assert int8_nearest(0.5)==1 && int8_nearest(-0.5)==0 && int8_nearest(6.4)==6 && int8_nearest(-6.6)==-7 && int8_nearest(0)==0;
    #assert int8_nearest(-127)==-127 && int8_nearest(127)==127 && int8_nearest(-1.5)==-1;
    // An all-zero block has scale 0 and codes 0.
    for i:0..<4 {x[i]=0;}
    r=int8_quantize(Int8Request.{rows=1,width=4,tokens=1,block=4},x[..],Int8Activations.{codes=codes[..],scales=scales[..],sums=sums[..]});
    #assert r.status==Int8Status.ok && scales[0]==0 && sums[0]==0;
    for i:0..<4 {#assert codes[i]==0;}
}
#test "scales round up, so no code passes 127, even for subnormal blocks" {
    #assert int8_scale(127)==1 && int8_scale(0)==0 && int8_scale(254)==2;
    #assert f32_bits(int8_scale(f32_from_bits(1)))==1;
    for bits:[6]u32.[190,200,0x7f7fffff,0x3f800000,0x3dcccccd,0x00800001] {
        amax:=f32_from_bits(bits);d:=int8_scale(amax);
        #assert f64(d)>=f64(amax)/127;
        #assert f64(f32_from_bits(f32_bits(d)-1))<f64(amax)/127;
        #assert int8_nearest(f64(amax)/f64(d))==127 || bits<254;
        #assert int8_nearest(f64(amax)/f64(d))<=127;
    }
}
#forall "quantization error is at most half a step per value" seed:0..<16,spread:0..<4 {
    x:[64]f32;codes:[64]s8;scales:[2]f32;sums:[2]s32;state:=seed*31+spread+1;
    for i:0..<64 {
        state=int8_next(state);
        x[i]=f32(f64((state>>8)%20001-10000)/f64(1<<(spread*6)));
    }
    r:=int8_quantize(Int8Request.{rows=1,width=64,tokens=1,block=32},x[..],Int8Activations.{codes=codes[..],scales=scales[..],sums=sums[..]});
    #assert r.status==Int8Status.ok && r.written==2;
    for b:0..<2 {
        amax:=0.0;s:=0;
        for k:0..<32 {if abs(f64(x[32*b+k]))>amax {amax=abs(f64(x[32*b+k]));}s+=cast(int)codes[32*b+k];}
        #assert f64(scales[b])>=amax/127 && cast(int)sums[b]==s;
        for k:0..<32 {
            q:=cast(int)codes[32*b+k];
            #assert q>=-127 && q<=127;
            #assert abs(f64(x[32*b+k])-f64(scales[b])*f64(q))<=f64(scales[b])/2*(1+1.0/1099511627776);
        }
    }
}
#forall "a block's grouped s32 dot equals the naive integer loop" seed:0..<24,groups:1..<17 {
    n:=4*groups;a:[64]s8;b:[64]s8;
    int8_fill_codes(a[..],seed);int8_fill_codes(b[..],seed+100);
    #assert cast(int)int8_dot(a[..],0,b[..],0,n)==int8_naive(a[..],b[..],n);
    if n>=8 {#assert cast(int)int8_dot(a[..],4,b[..],8,n-8)==int8_naive(a[4..<64],b[8..<64],n-8);}
}
#test "row kernel: every block sum matches the naive loop, and dyadic scales give the exact product" {
    r:=Int8Request.{rows=3,width=64,tokens=2,block=32};
    wc:[192]s8;ws:[6]f32;wo:[6]f32;xc:[128]s8;xs:[4]f32;xm:[4]s32;dots:[13]s32;y:[7]f64;
    int8_fill_codes(wc[..],3);int8_fill_codes(xc[..],4);
    for i:0..<6 {ws[i]=f32(f64(i+1)/8);wo[i]=f32(f64(i-2)/4);}
    for i:0..<4 {xs[i]=f32(1.0/f64(1<<(i+5)));}
    x:=Int8Activations.{codes=xc[..],scales=xs[..],sums=xm[..]};int8_fill_sums(r,x);
    dots[12]=-7;y[6]=-7;
    out:=int8_row(r,Int8Weights.{codes=wc[..],scales=ws[..],offsets=wo[..]},x,dots[..],y[..]);
    #assert out.status==Int8Status.ok && out.written==6 && dots[12]==-7 && y[6]==-7;
    for t:0..<2 {for row:0..<3 {
        exact:=0.0;
        for b:0..<2 {
            #assert cast(int)dots[(t*3+row)*2+b]==int8_naive(wc[(row*2+b)*32..<(row*2+b)*32+32],xc[(t*2+b)*32..<(t*2+b)*32+32],32);
        }
        // Every term is a small dyadic number, so this plain f64 sum is exact.
        for k:0..<64 {
            b:=k/32;
            w:=f64(ws[row*2+b])*f64(wc[row*64+k])+f64(wo[row*2+b]);
            exact+=w*f64(xs[t*2+b])*f64(xc[t*64+k]);
        }
        #assert y[t*3+row]==exact;
    }}
}
#test "interleaving puts four rows' groups of four side by side" {
    r:=Int8Request.{rows=4,width=8,tokens=1,block=8};
    codes:[32]s8;out:[33]s8;
    for i:0..<32 {codes[i]=cast(s8)i;}
    out[32]=-7;
    #assert int8_interleave(r,codes[..],out[..]).status==Int8Status.ok && out[32]==-7;
    want:=[32]s8.[0,1,2,3,8,9,10,11,16,17,18,19,24,25,26,27,4,5,6,7,12,13,14,15,20,21,22,23,28,29,30,31];
    for i:0..<32 {#assert out[i]==want[i];}
    #assert int8_interleave(Int8Request.{rows=3,width=8,tokens=1,block=8},codes[0..<24],out[..]).status==Int8Status.tile;
    #assert int8_interleave(r,codes[0..<31],out[..]).status==Int8Status.storage;
    #assert int8_interleave(r,codes[..],out[0..<31]).status==Int8Status.capacity;
    #assert int8_interleave(Int8Request.{rows=4,width=8,tokens=1,block=6},codes[..],out[..]).status==Int8Status.shape;
}
#forall "the tiled kernel equals the row kernel bit for bit" seed:0..<6,shape:0..<3 {
    rows:=4*(shape+1);tokens:=4*(2-shape/2);width:=32*(3-shape);
    r:=Int8Request.{rows=rows,width=width,tokens=tokens,block=32};nb:=width/32;
    wc:[1152]s8;wi:[1152]s8;ws:[36]f32;wo:[36]f32;xc:[768]s8;xs:[24]f32;xm:[24]s32;
    d1:[288]s32;d2:[288]s32;y1:[96]f64;y2:[96]f64;
    int8_fill_codes(wc[0..<rows*width],seed);int8_fill_codes(xc[0..<tokens*width],seed+50);
    state:=seed+9;
    for i:0..<rows*nb {state=int8_next(state);ws[i]=f32(f64(state%100000)/7e6);state=int8_next(state);wo[i]=f32(f64(state%1001-500)/3e4);}
    for i:0..<tokens*nb {state=int8_next(state);xs[i]=f32(f64(state%100000)/9e6);}
    x:=Int8Activations.{codes=xc[0..<tokens*width],scales=xs[0..<tokens*nb],sums=xm[0..<tokens*nb]};int8_fill_sums(r,x);
    w:=Int8Weights.{codes=wc[0..<rows*width],scales=ws[0..<rows*nb],offsets=wo[0..<rows*nb]};
    for i:0..<288 {d1[i]=-7;d2[i]=-9;}
    for i:0..<96 {y1[i]=-7;y2[i]=-9;}
    a:=int8_row(r,w,x,d1[..],y1[..]);
    #assert a.status==Int8Status.ok && a.written==rows*tokens;
    #assert int8_interleave(r,wc[0..<rows*width],wi[0..<rows*width]).status==Int8Status.ok;
    w.codes=wi[0..<rows*width];
    b:=int8_tiled(r,w,x,d2[..],y2[..]);
    #assert b.status==Int8Status.ok && b.written==rows*tokens;
    for i:0..<rows*tokens*nb {#assert d1[i]==d2[i];}
    for i:0..<rows*tokens {#assert f64_bits(y1[i])==f64_bits(y2[i]);}
}
#forall "the quantized product stays within the bound frozen before chapter 4's product" seed:0..<8 {
    r:=Int8Request.{rows=4,width=64,tokens=2,block=32};
    wc:[256]s8;ws:[8]f32;wo:[8]f32;wf:[256]f32;x:[128]f32;xt:[128]f32;
    xc:[128]s8;xs:[4]f32;xm:[4]s32;dots:[16]s32;y:[8]f64;bound:[8]f64;
    int8_fill_codes(wc[..],seed);state:=seed*13+5;
    for i:0..<8 {state=int8_next(state);ws[i]=f32(f64(state%1000+1)/64000);wo[i]=f32(f64(state%7-3)/256);}
    for i:0..<128 {state=int8_next(state);x[i]=f32(f64(state%20001-10000)/7777);}
    w:=Int8Weights.{codes=wc[..],scales=ws[..],offsets=wo[..]};
    #assert int8_dequantize(r,w,wf[..]).status==Int8Status.ok;
    a:=Int8Activations.{codes=xc[..],scales=xs[..],sums=xm[..]};
    #assert int8_quantize(r,x[..],a).status==Int8Status.ok;
    #assert int8_bound(r,wf[..],x[..],a,bound[..]).status==Int8Status.ok;
    // Chapter 4 multiplies W (rows x width) by X (width x tokens).
    for t:0..<2 {for k:0..<64 {xt[k*2+t]=x[t*64+k];}}
    ref:[8]f32;scratch:[8]f32;indices:[1]int;mask:[1]u8;
    c:=psionic_ops_checked(PsionicRequest.{op=PsionicOp.matmul,rows=4,width=64,columns=2},wf[..],xt[..],indices[0..<0],mask[0..<0],ref[..],scratch[..],false);
    #assert c.status==PsionicOpStatus.ok;
    #assert int8_row(r,w,a,dots[..],y[..]).status==Int8Status.ok;
    moved:=0;
    for t:0..<2 {for row:0..<4 {
        e:=abs(y[t*4+row]-f64(ref[row*2+t]));
        #assert e<=bound[t*4+row];
        if e>0 {moved+=1;}
        // The bound is useful: well under a hundredth of the output's scale.
        scale:=0.0;for k:0..<64 {scale+=abs(f64(wf[row*64+k])*f64(x[t*64+k]));}
        #assert bound[t*4+row]<scale/100;
    }}
    #assert moved>0;
}
#test "refusals leave every output unchanged" {
    r:=Int8Request.{rows=4,width=32,tokens=4,block=32};
    wc:[128]s8;ws:[4]f32;wo:[4]f32;xc:[128]s8;xs:[4]f32;xm:[4]s32;dots:[16]s32;y:[16]f64;
    for i:0..<4 {ws[i]=1;xs[i]=1;}
    w:=Int8Weights.{codes=wc[..],scales=ws[..],offsets=wo[..]};x:=Int8Activations.{codes=xc[..],scales=xs[..],sums=xm[..]};
    for i:0..<16 {dots[i]=-7;y[i]=-7;}
    for tiled:0..<2 {
        #assert int8_run(Int8Request.{rows=4,width=32,tokens=4,block=8+24},w,x,dots[..],y[..],tiled)==Int8Status.ok;
        for i:0..<16 {dots[i]=-7;y[i]=-7;}
        #assert int8_run(Int8Request.{rows=4,width=32,tokens=4,block=12},w,x,dots[..],y[..],tiled)==Int8Status.shape;
        #assert int8_run(r,Int8Weights.{codes=wc[0..<127],scales=ws[..],offsets=wo[..]},x,dots[..],y[..],tiled)==Int8Status.storage;
        #assert int8_run(r,Int8Weights.{codes=wc[..],scales=ws[0..<3],offsets=wo[..]},x,dots[..],y[..],tiled)==Int8Status.storage;
        #assert int8_run(r,Int8Weights.{codes=wc[..],scales=ws[..],offsets=wo[0..<3]},x,dots[..],y[..],tiled)==Int8Status.storage;
        #assert int8_run(r,w,Int8Activations.{codes=xc[0..<96],scales=xs[..],sums=xm[..]},dots[..],y[..],tiled)==Int8Status.storage;
        #assert int8_run(r,w,Int8Activations.{codes=xc[..],scales=xs[0..<3],sums=xm[..]},dots[..],y[..],tiled)==Int8Status.storage;
        #assert int8_run(r,w,Int8Activations.{codes=xc[..],scales=xs[..],sums=xm[0..<3]},dots[..],y[..],tiled)==Int8Status.storage;
        #assert int8_run(r,w,x,dots[0..<15],y[..],tiled)==Int8Status.capacity;
        #assert int8_run(r,w,x,dots[..],y[0..<15],tiled)==Int8Status.capacity;
        wc[127]=-128;#assert int8_run(r,w,x,dots[..],y[..],tiled)==Int8Status.code;wc[127]=0;
        xc[0]=-128;xm[0]=-128;#assert int8_run(r,w,x,dots[..],y[..],tiled)==Int8Status.code;xc[0]=0;xm[0]=0;
        for at:[2]int.[0,3] {
            for k:0..<5 {
                ws[at]=int8_special(k);#assert int8_run(r,w,x,dots[..],y[..],tiled)==Int8Status.scale;ws[at]=1;
                xs[at]=int8_special(k);#assert int8_run(r,w,x,dots[..],y[..],tiled)==Int8Status.scale;xs[at]=1;
            }
            for k:0..<3 {wo[at]=int8_special(k);#assert int8_run(r,w,x,dots[..],y[..],tiled)==Int8Status.scale;wo[at]=0;}
            xm[at]=1;#assert int8_run(r,w,x,dots[..],y[..],tiled)==Int8Status.sum;xm[at]=0;
        }
        ws[0]=0;xs[0]=0;wo[0]=f32_from_bits(0x80000000);
        #assert int8_run(r,w,x,dots[..],y[..],tiled)==Int8Status.ok;
        for i:0..<16 {dots[i]=-7;y[i]=-7;}
        ws[0]=1;xs[0]=1;wo[0]=0;
        for i:0..<16 {#assert dots[i]==-7 && y[i]==-7;}
    }
    #assert int8_tiled(Int8Request.{rows=3,width=32,tokens=4,block=32},Int8Weights.{codes=wc[0..<96],scales=ws[0..<3],offsets=wo[0..<3]},x,dots[..],y[..]).status==Int8Status.tile;
    #assert int8_tiled(Int8Request.{rows=4,width=32,tokens=3,block=32},w,Int8Activations.{codes=xc[0..<96],scales=xs[0..<3],sums=xm[0..<3]},dots[..],y[..]).status==Int8Status.tile;
    #assert int8_row(Int8Request.{rows=3,width=32,tokens=3,block=32},Int8Weights.{codes=wc[0..<96],scales=ws[0..<3],offsets=wo[0..<3]},Int8Activations.{codes=xc[0..<96],scales=xs[0..<3],sums=xm[0..<3]},dots[..],y[..]).status==Int8Status.ok;
}
#test "quantize, dequantize and bound refuse what they cannot represent" {
    r:=Int8Request.{rows=1,width=8,tokens=1,block=4};
    x:[8]f32;codes:[8]s8;scales:[2]f32;sums:[2]s32;wf:[8]f32;bound:[1]f64;
    a:=Int8Activations.{codes=codes[..],scales=scales[..],sums=sums[..]};
    for i:0..<8 {codes[i]=9;}scales[0]=-7;sums[0]=-7;
    #assert int8_quantize(Int8Request.{rows=1,width=8,tokens=1,block=3},x[..],a).status==Int8Status.shape;
    #assert int8_quantize(r,x[0..<7],a).status==Int8Status.storage;
    #assert int8_quantize(r,x[..],Int8Activations.{codes=codes[0..<7],scales=scales[..],sums=sums[..]}).status==Int8Status.capacity;
    #assert int8_quantize(r,x[..],Int8Activations.{codes=codes[..],scales=scales[0..<1],sums=sums[..]}).status==Int8Status.capacity;
    #assert int8_quantize(r,x[..],Int8Activations.{codes=codes[..],scales=scales[..],sums=sums[0..<1]}).status==Int8Status.capacity;
    for k:0..<3 {x[7]=int8_special(k);#assert int8_quantize(r,x[..],a).status==Int8Status.number;}
    for i:0..<8 {#assert codes[i]==9;}
    #assert scales[0]==-7 && sums[0]==-7;
    x[7]=f32_from_bits(0x7f7fffff);x[6]=-x[7];
    #assert int8_quantize(r,x[..],a).status==Int8Status.ok && codes[7]==127 && codes[6]==-127 && codes[0]==0;
    wc:[8]s8;ws:=[2]f32.[1,1];wo:[2]f32;
    w:=Int8Weights.{codes=wc[..],scales=ws[..],offsets=wo[..]};
    wf[0]=-7;
    #assert int8_dequantize(r,Int8Weights.{codes=wc[0..<7],scales=ws[..],offsets=wo[..]},wf[..]).status==Int8Status.storage;
    #assert int8_dequantize(r,w,wf[0..<7]).status==Int8Status.capacity;
    wc[1]=-128;#assert int8_dequantize(r,w,wf[..]).status==Int8Status.code;wc[1]=0;
    for at:[2]int.[0,1] {
        ws[at]=-1;#assert int8_dequantize(r,w,wf[..]).status==Int8Status.scale;ws[at]=1;
        wo[at]=int8_special(0);#assert int8_dequantize(r,w,wf[..]).status==Int8Status.scale;wo[at]=0;
    }
    ws[1]=-1;
    #assert wf[0]==-7;
    // A weight whose f32 value would overflow is refused, not rounded to infinity.
    ws[1]=f32_from_bits(0x7f7fffff);wc[4]=127;
    #assert int8_dequantize(r,w,wf[..]).status==Int8Status.number && wf[0]==-7;
    wc[4]=1;wo[1]=ws[1];#assert int8_dequantize(r,w,wf[..]).status==Int8Status.number;wo[1]=0;
    ws[0]=ws[1];wc[0]=-1;wo[0]=-ws[1];#assert int8_dequantize(r,w,wf[..]).status==Int8Status.number;
    ws[0]=1;wc[0]=0;wo[0]=0;
    ws[1]=1;wc[4]=1;wo[1]=0.5;
    d:=int8_dequantize(r,w,wf[..]);
    #assert d.status==Int8Status.ok && d.written==8 && wf[4]==1.5 && wf[5]==0.5 && wf[0]==0;
    #assert int8_bound(r,wf[0..<7],x[..],a,bound[..]).status==Int8Status.storage;
    #assert int8_bound(r,wf[..],x[0..<7],a,bound[..]).status==Int8Status.storage;
    #assert int8_bound(r,wf[..],x[..],a,bound[0..<0]).status==Int8Status.capacity;
    #assert int8_bound(r,wf[..],x[..],Int8Activations.{codes=codes[..],scales=scales[0..<1],sums=sums[..]},bound[..]).status==Int8Status.storage;
    #assert int8_bound(Int8Request.{rows=1,width=8,tokens=1,block=5},wf[..],x[..],a,bound[..]).status==Int8Status.shape;
}

#test "hand bound for one block of four" {
    r:=Int8Request.{rows=1,width=4,tokens=1,block=4};
    wf:=[4]f32.[1,2,-1,0.5];x:=[4]f32.[1.984375,-0.5,0.25,0.0078125];
    codes:[4]s8;scales:[1]f32;sums:[1]s32;bound:[2]f64;
    a:=Int8Activations.{codes=codes[..],scales=scales[..],sums=sums[..]};
    #assert int8_quantize(r,x[..],a).status==Int8Status.ok && scales[0]==0.015625;
    bound[1]=-7;
    b:=int8_bound(r,wf[..],x[..],a,bound[..]);
    // Half a step (1/128) times sum |w| = 4.5, and sum |w x| = 3.23828125.
    #assert b.status==Int8Status.ok && b.written==1 && bound[1]==-7;
    #assert bound[0]==0.03515625*(1+1.0/1099511627776)+3.23828125/4194304;
}

// book:begin plan
int8_block_fits :: (block:int)->bool {return block<=INT8_S32_MAX/(INT8_CODE_MAX*INT8_CODE_MAX);}
// Work in binary64: exact below 2^53, and far above the limit beyond it.
int8_work_fits :: (rows:int,width:int,tokens:int)->bool {return f64(rows)*f64(width)*f64(tokens)<=f64(INT8_MAC_LIMIT);}
int8_plan :: (r:Int8Request)->Int8Plan #export_c {
    if r.rows<1 || r.tokens<1 || r.block<4 || r.block%4!=0 {return Int8Plan.{status=Int8Status.shape};}
    if !int8_block_fits(r.block) {return Int8Plan.{status=Int8Status.overflow};}
    if r.width<r.block || r.width%r.block!=0 {return Int8Plan.{status=Int8Status.shape};}
    if !int8_work_fits(r.rows,r.width,r.tokens) {return Int8Plan.{status=Int8Status.limit};}
    nb:=r.width/r.block;
    return Int8Plan.{blocks=nb,weight_codes=r.rows*r.width,weight_scales=r.rows*nb,activation_codes=r.tokens*r.width,
        activation_scales=r.tokens*nb,outputs=r.rows*r.tokens,dots=r.rows*r.tokens*nb};
}
// book:end plan

// book:begin quantize
int8_finite :: (v:f32)->bool {return (f32_bits(v)&0x7fffffff)<0x7f800000;}
// The smallest f32 at or above amax/127, so amax/scale never exceeds 127.
int8_scale :: (amax:f32)->f32 {
    want:=f64(amax)/127;d:=f32(want);
    if f64(d)<want {d=f32_from_bits(f32_bits(d)+1);}
    return d;
}
// Nearest integer, ties upward.
int8_nearest :: (t:f64)->int {return int(floor(t+0.5));}
int8_quantize :: (r:Int8Request,x:[]f32,out:Int8Activations)->Int8Result #export_c {
    p:=int8_plan(r);
    if p.status!=Int8Status.ok {return Int8Result.{status=p.status};}
    if x.count!=p.activation_codes {return Int8Result.{status=Int8Status.storage};}
    if out.codes.count<p.activation_codes || out.scales.count<p.activation_scales || out.sums.count<p.activation_scales {return Int8Result.{status=Int8Status.capacity};}
    for v:x {if !int8_finite(v) {return Int8Result.{status=Int8Status.number};}}
    for g:0..<p.activation_scales {
        // Non-negative finite f32 bits order like their values.
        top:=0;
        for k:0..<r.block {v:=cast(int)(f32_bits(x[g*r.block+k])&0x7fffffff);top=cast(int)((f64(top+v)+abs(f64(top-v)))/2);}
        d:=int8_scale(f32_from_bits(cast(u32)top));sum:s32=0;
        for k:0..<r.block {
            q:=0;
            if top!=0 {q=int8_nearest(f64(x[g*r.block+k])/f64(d));}
            out.codes[g*r.block+k]=cast(s8)q;sum+=cast(s32)q;
        }
        out.scales[g]=d;out.sums[g]=sum;
    }
    return Int8Result.{written=p.activation_scales};
}
// book:end quantize

// book:begin dot
// Groups of four products, as one dp4a instruction would add them.
int8_dot4 :: (a:[]s8,at:int,b:[]s8,bt:int)->s32 {
    return cast(s32)a[at]*cast(s32)b[bt]+cast(s32)a[at+1]*cast(s32)b[bt+1]
        +cast(s32)a[at+2]*cast(s32)b[bt+2]+cast(s32)a[at+3]*cast(s32)b[bt+3];
}
int8_dot :: (a:[]s8,ai:int,b:[]s8,bi:int,n:int)->s32 {
    acc:s32=0;
    for g:0..<n/4 {acc+=int8_dot4(a,ai+4*g,b,bi+4*g);}
    return acc;
}
// One block's contribution: d_w d_x S + m d_x sum(x codes), in binary64.
int8_term :: (w:Int8Weights,wb:int,x:Int8Activations,xb:int,dot:s32)->f64 {
    dx:=f64(x.scales[xb]);
    return f64(w.scales[wb])*dx*f64(dot)+f64(w.offsets[wb])*dx*f64(x.sums[xb]);
}
// book:end dot

// book:begin admit
int8_scale_ok :: (v:f32)->bool {return int8_finite(v) && (f32_bits(v)&0x80000000)==0;}
int8_admit :: (r:Int8Request,w:Int8Weights,x:Int8Activations,dots:[]s32,y:[]f64,tiled:bool)->Int8Plan {
    p:=int8_plan(r);
    if p.status!=Int8Status.ok {return p;}
    if tiled && (r.rows%INT8_TILE!=0 || r.tokens%INT8_TILE!=0) {return Int8Plan.{status=Int8Status.tile};}
    if w.codes.count!=p.weight_codes || w.scales.count!=p.weight_scales || w.offsets.count!=p.weight_scales {return Int8Plan.{status=Int8Status.storage};}
    if x.codes.count!=p.activation_codes || x.scales.count!=p.activation_scales || x.sums.count!=p.activation_scales {return Int8Plan.{status=Int8Status.storage};}
    if dots.count<p.dots || y.count<p.outputs {return Int8Plan.{status=Int8Status.capacity};}
    for c:w.codes {if c<-INT8_CODE_MAX {return Int8Plan.{status=Int8Status.code};}}
    for c:x.codes {if c<-INT8_CODE_MAX {return Int8Plan.{status=Int8Status.code};}}
    for i:0..<p.weight_scales {if !int8_scale_ok(w.scales[i]) || !int8_finite(w.offsets[i]) {return Int8Plan.{status=Int8Status.scale};}}
    for i:0..<p.activation_scales {
        if !int8_scale_ok(x.scales[i]) {return Int8Plan.{status=Int8Status.scale};}
        s:=0;
        for k:0..<r.block {s+=cast(int)x.codes[i*r.block+k];}
        if s!=cast(int)x.sums[i] {return Int8Plan.{status=Int8Status.sum};}
    }
    return p;
}
// book:end admit

// book:begin row
// Decode shape: for each token and each output row, walk the row's blocks.
int8_row :: (r:Int8Request,w:Int8Weights,x:Int8Activations,dots:[]s32,y:[]f64)->Int8Result #export_c {
    p:=int8_admit(r,w,x,dots,y,false);
    if p.status!=Int8Status.ok {return Int8Result.{status=p.status};}
    nb:=p.blocks;
    for t:0..<r.tokens {for row:0..<r.rows {
        acc:f64=0;
        for b:0..<nb {
            s:=int8_dot(w.codes,(row*nb+b)*r.block,x.codes,(t*nb+b)*r.block,r.block);
            dots[(t*r.rows+row)*nb+b]=s;
            acc+=int8_term(w,row*nb+b,x,t*nb+b,s);
        }
        y[t*r.rows+row]=acc;
    }}
    return Int8Result.{written=p.outputs};
}
// book:end row

// book:begin tiled
// Interleaved weights: for each tile of four rows and each block, group g of
// row i sits at ((tile*nb + b)*(block/4) + g)*16 + 4*i, so one 16-byte read
// gives four rows the same four activation codes.
int8_at :: (r:Int8Request,row:int,k:int)->int {
    nb:=r.width/r.block;b:=k/r.block;g:=(k%r.block)/4;
    return (((row/INT8_TILE)*nb+b)*(r.block/4)+g)*16+4*(row%INT8_TILE)+k%4;
}
int8_interleave :: (r:Int8Request,codes:[]s8,out:[]s8)->Int8Result #export_c {
    p:=int8_plan(r);
    if p.status!=Int8Status.ok {return Int8Result.{status=p.status};}
    if r.rows%INT8_TILE!=0 {return Int8Result.{status=Int8Status.tile};}
    if codes.count!=p.weight_codes {return Int8Result.{status=Int8Status.storage};}
    if out.count<p.weight_codes {return Int8Result.{status=Int8Status.capacity};}
    for row:0..<r.rows {for k:0..<r.width {out[int8_at(r,row,k)]=codes[row*r.width+k];}}
    return Int8Result.{written=p.weight_codes};
}
// Prompt shape: a 4 x 4 tile of s32 accumulators per block; the same
// blocks are added to each output in the same order as the row kernel.
int8_tiled :: (r:Int8Request,w:Int8Weights,x:Int8Activations,dots:[]s32,y:[]f64)->Int8Result #export_c {
    p:=int8_admit(r,w,x,dots,y,true);
    if p.status!=Int8Status.ok {return Int8Result.{status=p.status};}
    nb:=p.blocks;
    for i:0..<p.outputs {y[i]=0;}
    for rt:0..<r.rows/INT8_TILE {for tt:0..<r.tokens/INT8_TILE {for b:0..<nb {
        tile:[16]s32;
        for g:0..<r.block/4 {
            base:=((rt*nb+b)*(r.block/4)+g)*16;
            for j:0..<INT8_TILE {
                xa:=((tt*INT8_TILE+j)*nb+b)*r.block+4*g;
                for i:0..<INT8_TILE {tile[4*i+j]+=int8_dot4(w.codes,base+4*i,x.codes,xa);}
            }
        }
        for i:0..<INT8_TILE {for j:0..<INT8_TILE {
            row:=rt*INT8_TILE+i;t:=tt*INT8_TILE+j;s:=tile[4*i+j];
            dots[(t*r.rows+row)*nb+b]=s;
            y[t*r.rows+row]+=int8_term(w,row*nb+b,x,t*nb+b,s);
        }}
    }}}
    return Int8Result.{written=p.outputs};
}
// book:end tiled

// book:begin reference
// Weights as f32 for chapter 4's float product. Refuses values f32 cannot hold.
int8_dequantize :: (r:Int8Request,w:Int8Weights,out:[]f32)->Int8Result #export_c {
    p:=int8_plan(r);
    if p.status!=Int8Status.ok {return Int8Result.{status=p.status};}
    if w.codes.count!=p.weight_codes || w.scales.count!=p.weight_scales || w.offsets.count!=p.weight_scales {return Int8Result.{status=Int8Status.storage};}
    if out.count<p.weight_codes {return Int8Result.{status=Int8Status.capacity};}
    for c:w.codes {if c<-INT8_CODE_MAX {return Int8Result.{status=Int8Status.code};}}
    for i:0..<p.weight_scales {if !int8_scale_ok(w.scales[i]) || !int8_finite(w.offsets[i]) {return Int8Result.{status=Int8Status.scale};}}
    for i:0..<p.weight_codes {
        b:=i/r.block;
        if !psionic_ops_fits_f32(f64(w.scales[b])*f64(w.codes[i])+f64(w.offsets[b])) {return Int8Result.{status=Int8Status.number};}
    }
    for i:0..<p.weight_codes {b:=i/r.block;out[i]=f32(f64(w.scales[b])*f64(w.codes[i])+f64(w.offsets[b]));}
    return Int8Result.{written=p.weight_codes};
}
// The frozen bound for |quantized product - chapter 4's product|, per output:
// half a step per activation times |w| (quantization), times (1 + 2^-40) for
// the binary64 division, plus 2^-22 sum |w x| for f32 weights, binary64
// combining and chapter 4's one narrowing to f32.
int8_bound :: (r:Int8Request,wf:[]f32,x:[]f32,a:Int8Activations,out:[]f64)->Int8Result #export_c {
    p:=int8_plan(r);
    if p.status!=Int8Status.ok {return Int8Result.{status=p.status};}
    if wf.count!=p.weight_codes || x.count!=p.activation_codes || a.scales.count!=p.activation_scales {return Int8Result.{status=Int8Status.storage};}
    if out.count<p.outputs {return Int8Result.{status=Int8Status.capacity};}
    for t:0..<r.tokens {for row:0..<r.rows {
        step:=0.0;size:=0.0;
        for k:0..<r.width {
            w:=abs(f64(wf[row*r.width+k]));
            step+=w*f64(a.scales[t*p.blocks+k/r.block])/2;
            size+=w*abs(f64(x[t*r.width+k]));
        }
        out[t*r.rows+row]=step*(1+1.0/1099511627776)+size/4194304;
    }}
    return Int8Result.{written=p.outputs};
}
// book:end reference
