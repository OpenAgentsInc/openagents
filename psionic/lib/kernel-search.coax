// Chapter 247: the evaluator a kernel search answers to. It owns the
// declared workload, the held-out cases, the reference, the numerical
// contract every candidate must keep, and the rules that turn timings into a
// verdict. The host only moves bytes and records times.
#authority;
#import "Basic";

// book:begin cases
// Case 0 is the declared workload: Elephant's offset RMS norm over chapter
// 14's 86-token sample, 4,096 wide. The rest are held out from the agent:
// a decode row, Mammoth's width, widths no power of two divides, a width of
// 1, extreme values, zero rows, and one huge value among tiny ones.
KS_CASES :: 10;
KS_EPSILON :: 1e-6;
KsShape :: struct {rows:int;width:int;}
ks_shape :: (c:int)->KsShape #export_c {
    s:=[20]int.[86,4096, 1,4096, 7,5120, 3,1000, 5,4097, 2,1, 1,17, 4,4096, 2,4096, 3,4096];
    if c<0 || c>=KS_CASES {return KsShape.{};}
    return KsShape.{rows=s[2*c],width=s[2*c+1]};
}
// A value from a 32-bit xorshift: about -4 to 4 with 20 fraction bits.
ks_random :: (state:u32)->u32 {
    s:=state;s^=s<<13;s^=s>>17;s^=s<<5;return s;
}
ks_fill :: (c:int,x:[]f32,scale:[]f32) #export_c {
    sh:=ks_shape(c);n:=sh.rows*sh.width;state:=mul_wrap(cast(u32)(c+1),cast(u32)2654435761);
    extremes:=[8]f32.[3.4028235e38,-3.4028235e38,f32_from_bits(1),0,1,-1e-20,65504,-f32_from_bits(0x7fffff)];
    for i:0..<n {
        state=ks_random(state);
        x[i]=f32(cast(int)(state>>8)-(1<<23))/f32(1<<21);
        if c==7 {x[i]=extremes[i%8];}
        if c==8 {x[i]=0;}
        if c==9 {x[i]=ifx i%sh.width==(i/sh.width)*97 then 1e30 else 1e-30;}
    }
    for i:0..<sh.width {state=ks_random(state);scale[i]=f32(cast(int)(state>>8)-(1<<23))/f32(1<<24);}
}
// book:end cases

// book:begin contract
// The numerical contract: each output is one of the two f32 values next to
// the f64 norm (squares added in f64 in column order), so the only freedom
// is the order of the f64 additions. An output still holding the host's
// prefill, the largest f32, was never written: no norm comes near it.
KsCheck :: struct {wrong:int;unwritten:int;first:int;}
KS_UNWRITTEN :: 0x7f7fffff;
ks_ulp :: (r:f32)->f64 {
    a:=abs(r);return f64(f32_from_bits(f32_bits(a)+1))-f64(a);
}
// Written so that a NaN, which compares false, is not within.
ks_within :: (got:f32,want:f64)->bool {return abs(f64(got)-want)<=ks_ulp(f32(want));}
ks_check :: (c:int,x:[]f32,scale:[]f32,out:[]f32)->KsCheck #export_c {
    sh:=ks_shape(c);k:KsCheck;k.first=-1;
    for r:0..<sh.rows {
        at:=r*sh.width;sum:f64=0;
        for i:0..<sh.width {v:=f64(x[at+i]);sum+=v*v;}
        d:=sqrt(sum/f64(sh.width)+f64(KS_EPSILON));
        for i:0..<sh.width {
            want:=f64(x[at+i])/d*(1+f64(scale[i]));got:=out[at+i];
            bad:=false;
            if f32_bits(got)==KS_UNWRITTEN {k.unwritten+=1;bad=true;}
            else if !ks_within(got,want) {k.wrong+=1;bad=true;}
            if bad && k.first<0 {k.first=at+i;}
        }
    }
    return k;
}
// book:end contract

// book:begin timing
// One configuration's trials (seconds per call of both passes). It is
// faster than another only when its slowest trial beats the other's fastest.
KS_TRIALS_MAX :: 64;
KsTiming :: struct {median:f64;low:f64;high:f64;count:int;}
ks_timing :: (trials:[]f64)->KsTiming {
    t:KsTiming;n:=trials.count;
    if n<1 || n>KS_TRIALS_MAX {return t;}
    s:[KS_TRIALS_MAX]f64;
    for v,i:trials {
        j:=i;
        while j>0 && s[j-1]>v {s[j]=s[j-1];j-=1;}
        s[j]=v;
    }
    t.median=ifx n%2==1 then s[n/2] else (s[n/2-1]+s[n/2])/2;
    t.low=s[0];t.high=s[n-1];t.count=n;
    return t;
}
ks_faster :: (a:KsTiming,b:KsTiming)->bool {return a.count>0 && b.count>0 && a.high<b.low;}
// book:end timing

// book:begin choose
// The tuner's choice among measured configurations: the lowest median among
// those that passed every case. -1 when none passed.
KsConfig :: struct {knob:int;block:int;passed:bool;timing:KsTiming;}
ks_best :: (configs:[]KsConfig)->int {
    best:=-1;
    for c,i:configs {
        if !c.passed || c.timing.count==0 {continue;}
        if best<0 || c.timing.median<configs[best].timing.median {best=i;}
    }
    return best;
}
// book:end choose

#test "case shapes, and nothing outside them" {
    #assert ks_shape(0).rows==86 && ks_shape(0).width==4096 && ks_shape(1).rows==1 && ks_shape(2).width==5120;
    #assert ks_shape(2).rows==7 && ks_shape(3).rows==3 && ks_shape(5).rows==2 && ks_shape(6).rows==1 && ks_shape(7).rows==4;
    #assert ks_shape(7).width==4096 && ks_shape(8).rows==2 && ks_shape(8).width==4096 && ks_shape(1).width==4096;
    #assert ks_shape(3).width==1000 && ks_shape(4).rows==5 && ks_shape(4).width==4097 && ks_shape(5).width==1 && ks_shape(6).width==17;
    #assert ks_shape(9).rows==3 && ks_shape(9).width==4096 && ks_shape(10).rows==0 && ks_shape(-1).width==0;
}
#test "the generator: fixed values, the extremes and the planted huge value" {
    #assert ks_random(1)==270369 && ks_random(0xdeadbeef)==1199382711 && ks_random(0xffffffff)==253983;
    x:[4096]f32;s:[4096]f32;
    ks_fill(1,x[..],s[..]);
    #assert f32_bits(x[0])==1065970232 && f32_bits(x[1])==1019768320;
    #assert f32_bits(s[0])==3199254830 && f32_bits(s[1])==1039562704 && f32_bits(s[4095])==3191893076;
    lo:f32=0;hi:f32=0;
    for v:x {if v<lo {lo=v;} if v>hi {hi=v;}}
    #assert lo>=-4 && hi<4 && lo<-3.9 && hi>3.9;
    for v:s {#assert v>=-0.5 && v<0.5;}
    y:[16384]f32;ks_fill(7,y[..],s[..]);
    #assert y[0]==3.4028235e38 && y[2]==f32_from_bits(1) && y[7]==-f32_from_bits(0x7fffff) && y[8]==y[0];
    z:[12288]f32;ks_fill(9,z[..],s[..]);
    #assert z[0]==1e30 && z[1]==1e-30 && z[4096+97]==1e30 && z[8192+194]==1e30 && z[4096]==1e-30;
    w:[8192]f32;for i:0..<8192 {w[i]=7;}
    ks_fill(8,w[..],s[..]);for v:w {#assert v==0;}
}
// The norm of case c, written plainly, rounded to f32.
ks_t_norm :: (c:int,x:[]f32,scale:[]f32,out:[]f32) {
    sh:=ks_shape(c);
    for r:0..<sh.rows {
        sum:f64=0;
        for i:0..<sh.width {v:=f64(x[r*sh.width+i]);sum+=v*v;}
        d:=sqrt(sum/f64(sh.width)+f64(KS_EPSILON));
        for i:0..<sh.width {out[r*sh.width+i]=f32(f64(x[r*sh.width+i])/d*(1+f64(scale[i])));}
    }
}
#test "the contract accepts the norm and both f32 neighbours, and nothing else" {
    x:[85]f32;s:[17]f32;ks_fill(6,x[..],s[..]);
    out:[17]f32;ks_t_norm(6,x[..],s[..],out[..]);
    k:=ks_check(6,x[..],s[..],out[..]);#assert k.wrong==0 && k.unwritten==0 && k.first==-1;
    // One step away is still a neighbour of the f64 value; two steps is not.
    o:=out;o[3]=f32_from_bits(f32_bits(o[3])+1);k=ks_check(6,x[..],s[..],o[..]);
    o2:=out;o2[3]=f32_from_bits(f32_bits(o2[3])-1);k2:=ks_check(6,x[..],s[..],o2[..]);
    #assert (k.wrong==0) != (k2.wrong==0);
    o=out;o[3]=f32_from_bits(f32_bits(o[3])+2);k=ks_check(6,x[..],s[..],o[..]);#assert k.wrong==1 && k.first==3;
    o[0]=f32_from_bits(f32_bits(o[0])+2);k=ks_check(6,x[..],s[..],o[..]);#assert k.wrong==2 && k.first==0;
    // Exactly one step above an f32 value is within; the step below 1 is half as wide.
    #assert ks_within(f32_from_bits(0x3f800001),1) && !ks_within(f32_from_bits(0x3f800002),1);
    #assert ks_within(f32_from_bits(0x3f7fffff),1) && !ks_within(f32_from_bits(0x3f7ffffd),1);
    o=out;o[16]=f32_from_bits(KS_UNWRITTEN);o[5]=f32_from_bits(KS_UNWRITTEN);
    k=ks_check(6,x[..],s[..],o[..]);#assert k.unwritten==2 && k.wrong==0 && k.first==5;
    #assert ks_ulp(1)==f64(f32_from_bits(0x34000000)) && ks_ulp(-1)==ks_ulp(1) && ks_ulp(0)==f64(f32_from_bits(1));
}
#test "the contract over rows: a row-sized error in the second row is found" {
    x:[8]f32;s:[4]f32;
    // Case 5 is 2 rows of width 1: each output is x/sqrt(x^2+eps)*(1+s).
    ks_fill(5,x[..],s[..]);out:[2]f32;ks_t_norm(5,x[..],s[..],out[..]);
    #assert ks_check(5,x[..],s[..],out[..]).wrong==0;
    o:=out;o[1]=o[1]*1.001;k:=ks_check(5,x[..],s[..],o[..]);#assert k.wrong==1 && k.first==1;
    // Squares in f32 lose the planted value's row in case 9.
    big:[12288]f32;bs:[4096]f32;ks_fill(9,big[..],bs[..]);bo:[12288]f32;ks_t_norm(9,big[..],bs[..],bo[..]);
    #assert ks_check(9,big[..],bs[..],bo[..]).wrong==0;
    // Squares added in f32 and an f32 divisor miss the contract on the decode row.
    y:[4096]f32;ys:[4096]f32;ks_fill(1,y[..],ys[..]);yo:[4096]f32;
    sum:f32=0;for v:y {sum+=v*v;}
    d:=sqrt(sum/4096+KS_EPSILON);
    for i:0..<4096 {yo[i]=y[i]/d*(1+ys[i]);}
    k=ks_check(1,y[..],ys[..],yo[..]);#assert k.wrong>0;
}
#test "timings sort their trials, and faster means no overlap" {
    a:=[5]f64.[5,1,4,2,3];t:=ks_timing(a[..]);
    #assert t.median==3 && t.low==1 && t.high==5 && t.count==5;
    b:=[4]f64.[9,7,6,8];u:=ks_timing(b[..]);#assert u.median==7.5 && u.low==6 && u.high==9;
    #assert ks_faster(t,u) && !ks_faster(u,t);
    c:=[2]f64.[6,10];v:=ks_timing(c[..]);#assert !ks_faster(v,u) && !ks_faster(u,v);
    one:=ks_timing(c[0..<1]);#assert one.count==1 && one.median==6 && ks_faster(one,ks_timing(b[0..<1]));
    e:[65]f64;#assert ks_timing(e[0..<0]).count==0 && ks_timing(e[..]).count==0 && ks_timing(e[0..<64]).count==64;
    z:KsTiming;#assert !ks_faster(z,u) && !ks_faster(t,z);
    // Unmeasured, whatever its fields say; and touching is not faster.
    far:=KsTiming.{low=100,high=100};#assert !ks_faster(t,far) && !ks_faster(far,t);
    w:=KsTiming.{low=5,high=5,count=1};#assert !ks_faster(t,w) && ks_faster(t,KsTiming.{low=5.5,high=6,count=1});
}
#test "the tuner's choice skips failures and unmeasured configurations" {
    t:=[3]f64.[2,3,4];m:=ks_timing(t[..]);q:=[3]f64.[1,1,1];f:=ks_timing(q[..]);
    c:=[4]KsConfig.[KsConfig.{knob=1,passed=true,timing=m},KsConfig.{knob=2,passed=false,timing=f},
        KsConfig.{knob=3,passed=true},KsConfig.{knob=4,passed=true,timing=f}];
    #assert ks_best(c[..])==3 && ks_best(c[0..<3])==0 && ks_best(c[1..<3])==-1;
    d:=[2]KsConfig.[KsConfig.{passed=true,timing=f},KsConfig.{passed=true,timing=f}];#assert ks_best(d[..])==0;
}
