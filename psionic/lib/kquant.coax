// Chapter 51: K-quants, IQ4 and the IQ3 and IQ2 lattice quants.
// Profiles: gguf-k-quant-v1, the 2- to 6-bit K-quant super-blocks (GGUF
// types 10 to 14: Q2_K, Q3_K, Q4_K, Q5_K, Q6_K, 256 values with packed
// sub-block scales); gguf-iq4-v1, the non-uniform 4-bit IQ4_NL (type 20,
// 32 values) and IQ4_XS (type 23, 256 values); and gguf-iq-lattice-v1,
// IQ2_XXS, IQ2_XS, IQ3_XXS, IQ3_S and IQ2_S (types 16, 17, 18, 21, 22, 256
// values), whose codes index ggml's grids. Byte layouts follow ggml's block
// structs in ggml-common.h; the IQ4 value table and the grids are copied from
// it (MIT, see psionic/NOTICE). Every decoded value is an exact integer
// number of 2^-24 units (2^-27 for the lattice formats), rounded once to f32.
#load "quantized.coax";             // chapter 50: halves, plans, the quality card; chapter 49's reader
#load "../fixtures/iq-grids.coax";  // ggml's sign tables and lattice grids, with their SHA-256
#load "../tests/kquant-checks.coax";  // the oracle's vectors, reference quantizers, the stand-in
#authority;

KQ_Q2_K :: 10;
KQ_Q3_K :: 11;
KQ_Q4_K :: 12;
KQ_Q5_K :: 13;
KQ_Q6_K :: 14;
KQ_IQ2_XXS :: 16;
KQ_IQ2_XS :: 17;
KQ_IQ3_XXS :: 18;
KQ_IQ4_NL :: 20;
KQ_IQ3_S :: 21;
KQ_IQ2_S :: 22;
KQ_IQ4_XS :: 23;
KQ_GROUPS_MAX :: 32768;  // groups of 32 values: 1,048,576 values
// book:begin table
// kvalues_iq4nl from ggml-common.h (MIT, Copyright (c) 2023-2026 The ggml authors).
KQ_IQ4 :: [16]int.[-127,-104,-83,-65,-49,-35,-22,-10,1,13,25,38,53,69,89,113];
// book:end table

// Checks precede the implementation.
#forall "a half is an integer number of 2^-24 units" bits:0..<1024 {
    for hi:[4]int.[0,0x1800,0x3c00,0x4400] {
        b:=(bits*31+hi)&0x7bff;
        #assert f64(kq_units(b))/16777216==qz_half(b) && f64(kq_units(b|0x8000))/16777216==qz_half(b|0x8000);
    }
    #assert kq_units(0x7bff)==65504*16777216 && kq_units(0x0001)==1 && kq_units(0x0400)==1024 && kq_units(0x8001)==-1;
}
#test "plans: super-blocks of 256, IQ4_NL blocks of 32, and the refusals" {
    p:=kq_plan(KQ_Q2_K,2,512);
    #assert p.status==QzStatus.ok && p.blocks==4 && p.bytes==336 && p.values==1024 && p.block_bytes==84;
    sizes:=[7]int.[84,110,144,176,210,18,136];kinds:=[7]int.[10,11,12,13,14,20,23];
    for i:0..<7 {p=kq_plan(kinds[i],1,256);#assert p.status==QzStatus.ok && p.block_bytes==sizes[i] && p.bytes==sizes[i]*(ifx i==5 then 8 else 1);}
    // The lattice formats, from their structs: IQ2_XXS, IQ2_XS, IQ3_XXS, IQ3_S, IQ2_S.
    lattice:=[5]int.[16,17,18,21,22];lsizes:=[5]int.[66,74,98,110,82];
    for i:0..<5 {p=kq_plan(lattice[i],1,256);#assert p.status==QzStatus.ok && p.block_bytes==lsizes[i] && p.bytes==lsizes[i] && p.blocks==1;}
    #assert kq_plan(KQ_Q4_K,1,1048576).status==QzStatus.ok && kq_plan(KQ_Q4_K,4096,256).status==QzStatus.ok;
    #assert kq_plan(KQ_Q4_K,4097,256).status==QzStatus.limit && kq_plan(KQ_IQ4_NL,32768,32).status==QzStatus.ok && kq_plan(KQ_IQ4_NL,32769,32).status==QzStatus.limit;
    #assert kq_plan(KQ_Q6_K,1,128).status==QzStatus.partial && kq_plan(KQ_IQ4_XS,1,32).status==QzStatus.partial && kq_plan(KQ_IQ4_NL,1,48).status==QzStatus.partial;
    for kind:[10]int.[-1,0,2,8,9,15,19,24,29,44] {#assert kq_plan(kind,1,256).status==QzStatus.kind;}
    #assert kq_plan(KQ_Q2_K,1,1).status==QzStatus.partial && kq_plan(KQ_IQ4_NL,1,1).status==QzStatus.partial;
    for bad:[2]int.[0,-256] {#assert kq_plan(KQ_Q2_K,bad,256).status==QzStatus.shape && kq_plan(KQ_Q2_K,1,bad).status==QzStatus.shape;}
}
// book:begin hand-tests
#test "Q2_K by hand: 4-bit scale and min in one byte, 2-bit codes" {
    // d = 0.5 and dmin = 1; scale bytes 0, 2, 4, 6 hold (scale | min << 4).
    b:[84]u8;b[0]=0x21;b[2]=0x13;b[4]=0x05;b[6]=0xf2;b[16]=0xe4;b[80]=0x00;b[81]=0x38;b[82]=0x00;b[83]=0x3c;
    y:[256]f32;
    #assert kq_decode(KQ_Q2_K,1,256,b[..],y[..]).status==QzStatus.ok;
    // Byte 16 = 0b11100100: codes 0, 1, 2, 3 for elements 0, 32, 64, 96.
    #assert y[0]==-2 && y[32]==0.5 && y[64]==5 && y[96]==-12 && y[1]==-2 && y[16]==0;
}
#test "Q3_K by hand: a 6-bit scale minus 32, a 2-bit code and a high bit" {
    b:[110]u8;b[108]=0x00;b[109]=0x3c;
    b[96]=0x01;b[104]=0x02;b[32]=0x03;b[0]=0x01;b[33]=0x02;
    b[97]=0x50;b[105]=0x10;b[80]=0x01;b[16]=0x10;
    y:[256]f32;
    #assert kq_decode(KQ_Q3_K,1,256,b[..],y[..]).status==QzStatus.ok;
    // Scale 0 = 1 | 2 << 4 = 33 -> 1. Element 0: code 3, high bit set -> 3; element 1: 2 - 4.
    #assert y[0]==3 && y[1]==-2;
    // Scale 2 is all zero bits: 0 - 32; element 32's code 0 without its high bit: -4.
    #assert y[32]==128;
    // Scale 9 = 5 | 1 << 4 = 21 -> -11; element 144: code 1, high bit 4 of byte 16 set.
    #assert y[144]==-11;
}
#test "Q4_K and Q5_K by hand: 6-bit scales and mins packed into 12 bytes" {
    b:[176]u8;b[0]=0x00;b[1]=0x38;b[2]=0x00;b[3]=0x3c;b[4]=0xc3;b[8]=0x41;b[12]=0x25;
    // Sub-block 0: scale 3, min 1. Sub-block 4: scale 5 | 3 << 4 = 53, min 2 | 1 << 4 = 18.
    four:=b;four[16]=0x9a;four[80]=0x07;
    y:[256]f32;
    #assert kq_decode(KQ_Q4_K,1,256,four[0..<144],y[..]).status==QzStatus.ok;
    #assert y[0]==14 && y[32]==0 && y[128]==167.5;
    // Q5_K: codes at 48, the fifth bit of element l in byte 16 + l, bit = sub-block.
    b[48]=0x9a;b[112]=0x07;b[16]=0x11;
    #assert kq_decode(KQ_Q5_K,1,256,b[..],y[..]).status==QzStatus.ok;
    #assert y[0]==38 && y[128]==591.5 && y[1]==-1;
}
#test "Q6_K and IQ4 by hand: signed 8-bit scales and the non-uniform table" {
    b:[210]u8;b[208]=0x00;b[209]=0x38;b[0]=0x31;b[128]=0x02;b[192]=2;b[196]=0xfd;
    y:[256]f32;
    #assert kq_decode(KQ_Q6_K,1,256,b[..],y[..]).status==QzStatus.ok;
    // Element 0: 1 | 2 << 4 = 33 -> 1, scale 2. Element 64: 3 -> -29, scale -3.
    #assert y[0]==1 && y[64]==43.5 && y[32]==0;
    n:[18]u8;n[0]=0x00;n[1]=0x38;n[2]=0xf0;
    #assert kq_decode(KQ_IQ4_NL,1,32,n[..],y[..]).status==QzStatus.ok;
    #assert y[0]==-63.5 && y[16]==56.5 && y[1]==-63.5 && y[17]==-63.5;
    x:[136]u8;x[0]=0x00;x[1]=0x3c;x[2]=0x02;x[4]=0x01;x[8]=0x8f;
    #assert kq_decode(KQ_IQ4_XS,1,256,x[..],y[..]).status==QzStatus.ok;
    // Sub-block 0: 1 | 2 << 4 = 33 -> 1; sub-block 1: 0 -> -32.
    #assert y[0]==113 && y[16]==1 && y[32]==4064;
}
// book:end hand-tests
// book:begin grid-tests
#test "IQ2_XXS and IQ3_S by hand: grid entries, sign masks and 4-bit scales" {
    // IQ2_XXS, d = 1. Sub-block 0: index bytes 1, 0, 0, 0; then 0x83 0x00 0x00 0x30.
    b:[66]u8;b[0]=0x00;b[1]=0x3c;b[2]=1;b[6]=0x83;b[9]=0x30;
    y:[256]f32;
    #assert kq_decode(KQ_IQ2_XXS,1,256,b[..],y[..]).status==QzStatus.ok;
    // Scale 3: (0.5 + 3) / 4 = 7/8. Group 0: entry 1 = 43, 8, ..., 8; signs index 3 -> 0x03.
    #assert y[0]==-37.625 && y[1]==-7 && y[2]==7 && y[7]==7;
    // Group 1: entry 0 = eight 8s; signs index 1 -> 0x81, the parity bit flips element 15.
    #assert y[8]==-7 && y[9]==7 && y[14]==7 && y[15]==-7;
    // Sub-block 1 is all zero bytes: scale 0, (0.5 + 0) / 4 times 8.
    #assert y[32]==1;
    // IQ3_S, d = 0.5. Index byte 1 with qh bit 0 -> entry 257 = 5, 7, 9, 5; index 0 -> 1, 1, 1, 1.
    c:[110]u8;c[0]=0x00;c[1]=0x38;c[2]=0x01;c[66]=0x01;c[74]=0x92;c[106]=0x21;
    #assert kq_decode(KQ_IQ3_S,1,256,c[..],y[..]).status==QzStatus.ok;
    // Scale nibble 1: 0.5 (1 + 2) = 1.5. Sign byte 0x92 flips elements 1, 4 and 7.
    #assert y[0]==7.5 && y[1]==-10.5 && y[2]==13.5 && y[3]==7.5 && y[4]==-1.5 && y[5]==1.5 && y[7]==-1.5;
    // Sub-block 1 takes the high nibble, 2: 0.5 (1 + 4) = 2.5 times entry 0.
    #assert y[32]==2.5;
}
// book:end grid-tests
#test "ggml's tables: the SHA-256 recorded at extraction, and the sign rule they follow" {
    #assert kq_tables_ok();
    // ksigns_iq2xs: seven sign bits, and an eighth that makes the count of minus signs even.
    for i:0..<128 {
        ones:=0;for j:0..<7 {ones+=(i>>j)&1;}
        #assert cast(int)KQ_KSIGNS[i]==(i|((ones&1)<<7));
    }
    for j:0..<8 {#assert cast(int)KQ_KMASK[j]==1<<j;}
}
#test "every format matches the independent oracle's vectors bit for bit" {
    y:[512]f32;
    {a:=KQV_Q2K_BYTES;c:=KQV_Q2K_BITS;#assert kq_vectors(KQV_Q2K_KIND,a[..],c[..],y[..]);}
    {a:=KQV_Q3K_BYTES;c:=KQV_Q3K_BITS;#assert kq_vectors(KQV_Q3K_KIND,a[..],c[..],y[..]);}
    {a:=KQV_Q4K_BYTES;c:=KQV_Q4K_BITS;#assert kq_vectors(KQV_Q4K_KIND,a[..],c[..],y[..]);}
    {a:=KQV_Q5K_BYTES;c:=KQV_Q5K_BITS;#assert kq_vectors(KQV_Q5K_KIND,a[..],c[..],y[..]);}
    {a:=KQV_Q6K_BYTES;c:=KQV_Q6K_BITS;#assert kq_vectors(KQV_Q6K_KIND,a[..],c[..],y[..]);}
    {a:=KQV_IQ4NL_BYTES;c:=KQV_IQ4NL_BITS;#assert kq_vectors(KQV_IQ4NL_KIND,a[..],c[..],y[..]);}
    {a:=KQV_IQ4XS_BYTES;c:=KQV_IQ4XS_BITS;#assert kq_vectors(KQV_IQ4XS_KIND,a[..],c[..],y[..]);}
    for format:7..<12 {#assert kq_oracle(format,y[..]);}
}
#test "decoding refuses wrong types, partial rows, truncated blocks and bad scales, leaving the output alone" {
    y:[512]f32;for i:0..<512 {y[i]=-7;}
    bytes:=KQV_Q2K_BYTES;
    #assert kq_decode(15,1,256,bytes[0..<84],y[..]).status==QzStatus.kind;
    #assert kq_decode(KQ_Q2_K,1,128,bytes[0..<84],y[..]).status==QzStatus.partial;
    #assert kq_decode(KQ_Q2_K,2,256,bytes[0..<167],y[..]).status==QzStatus.storage;
    #assert kq_decode(KQ_Q2_K,2,256,bytes[..],y[0..<511]).status==QzStatus.capacity;
    // d and dmin of the second block: infinity, NaN, -infinity.
    for at:[2]int.[164,166] {
        for bits:[3]int.[0x7c00,0x7e01,0xfc00] {
            c:=bytes;c[at]=cast(u8)(bits&255);c[at+1]=cast(u8)(bits>>8);
            #assert kq_decode(KQ_Q2_K,2,256,c[..],y[..]).status==QzStatus.scale;
        }
    }
    #assert kq_decode(KQ_IQ2_S,1,256,bytes[0..<81],y[..]).status==QzStatus.storage && kq_decode(KQ_IQ3_S,1,256,bytes[0..<111],y[..]).status==QzStatus.storage;
    #assert kq_decode(19,1,256,bytes[0..<50],y[..]).status==QzStatus.kind && kq_decode(KQ_IQ2_XXS,1,32,bytes[0..<66],y[..]).status==QzStatus.partial;
    for i:0..<512 {#assert y[i]==-7;}
    kinds:=[12]int.[10,11,12,13,14,20,23,16,17,22,18,21];mins:=[12]int.[82,108,2,2,208,0,0,0,0,0,0,0];ds:=[12]int.[80,108,0,0,208,0,0,0,0,0,0,0];
    for i:0..<12 {
        kind:=kinds[i];n:=PG_WIDTHS[kind];b:[210]u8;at:=mins[i];d:=ds[i];
        b[at+1]=0x7c;#assert kq_decode(kind,1,PG_BLOCKS[kind],b[0..<n],y[..]).status==QzStatus.scale;
        b[at+1]=0x7b;#assert kq_decode(kind,1,PG_BLOCKS[kind],b[0..<n],y[..]).status==QzStatus.ok;
        b[d+1]=0xfc;#assert kq_decode(kind,1,PG_BLOCKS[kind],b[0..<n],y[..]).status==QzStatus.scale;
    }
}
#forall "the reference quantizers' blocks decode within one step of every value" seed:0..<6,spread:0..<3,format:0..<7 #steps 200000000 {
    kinds:=[7]int.[10,11,12,13,14,20,23];kind:=kinds[format];
    x:[512]f32;b:[420]u8;y:[512]f32;
    qz_fill(x[..],seed+5*format,spread);
    p:=kq_plan(kind,2,256);
    #assert kq_quantize(kind,2,256,x[..],b[0..<p.bytes]).status==QzStatus.ok;
    #assert kq_decode(kind,2,256,b[0..<p.bytes],y[..]).status==QzStatus.ok;
    // The scales are rounded up so the codes reach every value: the error is
    // at most half a step of range / codes (Q2_K, Q4_K, Q5_K: a range up to
    // 2 amax over 3, 15, 31 steps), one step of amax / 4 or amax / 32 where
    // the top code clamps (Q3_K, Q6_K), or IQ4's 127 - 113 = 14 table units
    // of amax / 127; 1/16 more covers rounding the scale codes up.
    worst:=0.0;amax:=0.0;
    for i:0..<512 {worst=qz_larger(worst,abs(f64(x[i])-f64(y[i])));amax=qz_larger(amax,abs(f64(x[i])));}
    limits:=[7]f64.[1.0/3,1.0/4,1.0/15,1.0/31,1.0/32,14.0/127,14.0/127];
    #assert worst<=amax*limits[format]*(1+1.0/16) && worst>0;
}
#forall "a lattice block decodes to exactly the grid points the reference quantizer chose" seed:0..<1,spread:0..<3,format:0..<5 #steps 400000000 {
    kinds:=[5]int.[16,17,22,18,21];kind:=kinds[format];
    x:[512]f32;b:[220]u8;r:[256]f32;y:[256]f32;
    qz_fill(x[..],seed+3*format,spread);
    size:=kq_plan(kind,1,256).block_bytes;
    for blk:0..<2 {
        c:=b[blk*size..<(blk+1)*size];
        kq_lattice_block(kind,x[..],256*blk,c,r[..]);
        #assert kq_decode(kind,1,256,c,y[..]).status==QzStatus.ok;
        for i:0..<256 {#assert f32_bits(y[i])==f32_bits(r[i]);}
    }
}
#test "a tensor read by chapter 49 decodes through one entry for every format" {
    bytes:=PG_OWNED;m:[15]PgMeta;ms:[15]PgMeta;t:[2]PgTensor;ts:[2]PgTensor;
    #assert pg_read(bytes[..],bytes.count,m[..],ms[..],t[..],ts[..],false).status==PgStatus.ok;
    out:[512]f32;
    // Chapter 50's Q4_0 tensor still decodes, through chapter 50.
    at:=t[1].begin;bytes[at]=0x00;bytes[at+1]=0x38;bytes[at+2]=0x9f;
    r:=kq_tensor(t[1],bytes[..],out[..]);
    #assert r.status==QzStatus.ok && r.written==64 && out[0]==3.5 && out[16]==0.5;
    // A Q4_K descriptor of 256 x 2 over the oracle's two blocks.
    file:[288]u8;for i:0..<288 {file[i]=KQV_Q4K_BYTES[i];}
    k:=t[1];k.kind=KQ_Q4_K;k.dims[0]=256;k.dims[1]=2;k.elements=512;k.begin=0;k.end=288;
    r=kq_tensor(k,file[..],out[..]);
    #assert r.status==QzStatus.ok && r.written==512;
    for i:0..<512 {#assert f32_bits(out[i])==KQV_Q4K_BITS[i];}
    #assert kq_tensor(t[0],bytes[..],out[..]).status==QzStatus.kind;
    k.end=289;#assert kq_tensor(k,file[..],out[..]).status==QzStatus.storage;k.end=288;
    k.begin=-1;#assert kq_tensor(k,file[..],out[..]).status==QzStatus.storage;k.begin=0;
    k.end=287;#assert kq_tensor(k,file[..],out[..]).status==QzStatus.storage;k.end=288;
    k.dims[0]=0;#assert kq_tensor(k,file[..],out[..]).status==QzStatus.shape;
    k.dims[0]=128;k.elements=512;#assert kq_tensor(k,file[..],out[..]).status==QzStatus.partial;
    k.dims[0]=1;#assert kq_tensor(k,file[..],out[..]).status==QzStatus.partial;
    // A Q8_0 descriptor, 32 x 1, goes to chapter 50 too: scale 1, code 5.
    e:=k;e.kind=QZ_Q8_0;e.dims[0]=32;e.dims[1]=1;e.elements=32;e.end=34;file[0]=0x00;file[1]=0x3c;file[2]=5;
    r=kq_tensor(e,file[..],out[..]);#assert r.status==QzStatus.ok && r.written==32 && out[0]==5;
    k.dims[0]=256;#assert kq_tensor(k,file[..],out[0..<511]).status==QzStatus.capacity;
}
#test "the stand-in model: the declared bound promotes Q8_0, Q6_K and Q5_K and refuses every 4-bit and smaller format" #steps 400000000 {
    cards:[KQ_PROFILES]QzCard;
    for i:0..<9 {cards[i]=kq_standin_card(i);#assert cards[i].status==QzStatus.ok && cards[i].items==KQ_ITEMS;}
    #assert cards[2].bytes==2688 && cards[3].bytes==3520 && cards[4].bytes==4608 && cards[5].bytes==5632 && cards[6].bytes==6720;
    #assert cards[7].bytes==4608 && cards[8].bytes==4352 && cards[0].bytes==8704 && cards[1].bytes==4608;
    #assert cards[0].promoted && cards[5].promoted && cards[6].promoted;
    for i:[6]int.[1,2,3,4,7,8] {#assert !cards[i].promoted;}
    // At about 4.25 bits, the non-uniform IQ4_XS loses less than Q4_K and Q4_0.
    #assert cards[8].kl<cards[4].kl && cards[4].kl<cards[1].kl;
    // More bits, less loss, through the K-quant ladder.
    #assert cards[2].kl>cards[3].kl && cards[3].kl>cards[4].kl && cards[4].kl>cards[5].kl && cards[5].kl>cards[6].kl;
}
#test "the stand-in model: no lattice format is promoted; IQ3_S beats Q3_K at the same size, IQ2_XS beats Q2_K in fewer bytes" #steps 900000000 {
    cards:[KQ_PROFILES]QzCard;errors:[KQ_PROFILES]f64;
    for i:[7]int.[2,3,9,10,11,12,13] {
        cards[i]=kq_standin_measure(i,errors[i..<i+1]);
        #assert cards[i].status==QzStatus.ok && cards[i].items==KQ_ITEMS && !cards[i].promoted;
    }
    #assert cards[9].bytes==2112 && cards[10].bytes==2368 && cards[11].bytes==2624 && cards[12].bytes==3136 && cards[13].bytes==3520;
    // More bits, less weight error, through the lattice ladder.
    #assert errors[9]>errors[10] && errors[10]>errors[11] && errors[11]>errors[12] && errors[12]>errors[13];
    // IQ3_S and Q3_K are both 110 bytes a block; IQ2_XS is 74 to Q2_K's 84.
    #assert errors[13]<errors[3] && cards[13].kl<cards[3].kl && cards[13].bytes==cards[3].bytes;
    #assert errors[10]<errors[2] && cards[10].kl<cards[2].kl && cards[10].bytes<cards[2].bytes;
}

// book:begin units
// A finite half as a signed integer number of 2^-24 units: exact for every
// half, and products of a half with small codes stay below 2^53.
kq_units :: (bits:int)->int {
    e:=(bits>>10)&31;m:=bits&1023;
    v:=ifx e==0 then m else (1024+m)<<(e-1);
    return ifx (bits&0x8000)!=0 then -v else v;
}
kq_byte :: (b:[]u8,at:int)->int {return cast(int)b[at];}
kq_half_bits :: (b:[]u8,at:int)->int {return kq_byte(b,at)|(kq_byte(b,at+1)<<8);}
kq_half_units :: (b:[]u8,at:int)->int {return kq_units(kq_half_bits(b,at));}
// book:end units

// book:begin plan
kq_lattice_kind :: (kind:int)->bool {return (kind>=KQ_IQ2_XXS && kind<=KQ_IQ3_XXS) || kind==KQ_IQ3_S || kind==KQ_IQ2_S;}
kq_kind :: (kind:int)->bool {return (kind>=KQ_Q2_K && kind<=KQ_Q6_K) || kind==KQ_IQ4_NL || kind==KQ_IQ4_XS || kq_lattice_kind(kind);}
// Chapter 49's table gives each type's values and bytes per block.
kq_plan :: (kind:int,rows:int,width:int)->QzPlan #export_c {
    if !kq_kind(kind) {return QzPlan.{status=QzStatus.kind};}
    if rows<1 || width<1 {return QzPlan.{status=QzStatus.shape};}
    if width%PG_BLOCKS[kind]!=0 {return QzPlan.{status=QzStatus.partial};}
    if rows>KQ_GROUPS_MAX/(width/32) {return QzPlan.{status=QzStatus.limit};}
    blocks:=rows*width/PG_BLOCKS[kind];
    return QzPlan.{blocks=blocks,bytes=blocks*PG_WIDTHS[kind],values=rows*width,block_bytes=PG_WIDTHS[kind]};
}
// Where each block keeps its half scales: d, and dmin (d again when there is none).
kq_d_at :: (kind:int)->int {return ifx kind==KQ_Q2_K then 80 else ifx kind==KQ_Q3_K then 108 else ifx kind==KQ_Q6_K then 208 else 0;}
kq_m_at :: (kind:int)->int {return ifx kind==KQ_Q2_K then 82 else ifx kind==KQ_Q4_K || kind==KQ_Q5_K then 2 else kq_d_at(kind);}
// book:end plan

// book:begin kquant
// Q4_K and Q5_K: eight 6-bit scales (min = 0) or mins (min = 1) in the 12
// bytes from offset 4, ggml's get_scale_min_k4.
kq_scale_min :: (b:[]u8,j:int,min:int)->int {
    if j<4 {return kq_byte(b,4+j+4*min)&63;}
    return ((kq_byte(b,4+j+4)>>(4*min))&15)|((kq_byte(b,j+4*min)>>6)<<4);
}
// Element k of one block, in 2^-24 units.
kq_value :: (kind:int,b:[]u8,k:int)->int {
    if kind==KQ_Q6_K {
        // 128 values per half: four runs of 32, low nibbles in ql, two high bits in qh.
        n:=k/128;part:=(k%128)/32;l:=k%32;
        q:=((kq_byte(b,64*n+l+32*(part%2))>>(4*(part/2)))&15)|(((kq_byte(b,128+32*n+l)>>(2*part))&3)<<4);
        return kq_half_units(b,208)*qz_signed(b[192+k/16])*(q-32);
    }
    if kind==KQ_Q4_K || kind==KQ_Q5_K {
        // Four runs of 64: low nibbles are sub-block 2g, high nibbles 2g + 1.
        g:=k/64;part:=(k%64)/32;l:=k%32;j:=2*g+part;
        q:=(kq_byte(b,ifx kind==KQ_Q5_K then 48+32*g+l else 16+32*g+l)>>(4*part))&15;
        if kind==KQ_Q5_K {q+=((kq_byte(b,16+l)>>j)&1)<<4;}
        return kq_half_units(b,0)*kq_scale_min(b,j,0)*q-kq_half_units(b,2)*kq_scale_min(b,j,1);
    }
    // Q2_K and Q3_K: two halves of 128, each byte of qs holds four 2-bit
    // codes, the shift picks the run of 32, and h picks the sub-block of 16.
    n:=k/128;j:=(k%128)/32;h:=(k%32)/16;l:=k%16;s:=8*n+2*j+h;
    if kind==KQ_Q2_K {
        sc:=kq_byte(b,s);
        return kq_half_units(b,80)*(sc&15)*((kq_byte(b,16+32*n+16*h+l)>>(2*j))&3)-kq_half_units(b,82)*(sc>>4);
    }
    low:=(kq_byte(b,32+32*n+16*h+l)>>(2*j))&3;high:=(kq_byte(b,16*h+l)>>(4*n+j))&1;
    sc:=((kq_byte(b,96+s%8)>>(4*(s/8)))&15)|(((kq_byte(b,104+s%4)>>(2*(s/4)))&3)<<4);
    return kq_half_units(b,108)*(sc-32)*(low-4+4*high);
}
// book:end kquant

// book:begin iq4
kq_iq4 :: (kind:int,b:[]u8,k:int)->int {
    if kind==KQ_IQ4_NL {return kq_half_units(b,0)*KQ_IQ4[(kq_byte(b,2+k%16)>>(4*(k/16)))&15];}
    // IQ4_XS: eight sub-blocks of 32, each a 6-bit scale minus 32: four low
    // bits in scales_l (byte 4 + ib/2), two high bits in the 16-bit scales_h.
    ib:=k/32;r:=k%32;
    ls:=((kq_byte(b,4+ib/2)>>(4*(ib%2)))&15)|(((kq_half_bits(b,2)>>(2*ib))&3)<<4);
    return kq_half_units(b,0)*(ls-32)*KQ_IQ4[(kq_byte(b,8+16*ib+r%16)>>(4*(r/16)))&15];
}
// book:end iq4

// book:begin lattice
// Byte j of a grid entry, in memory order on a little-endian host, as ggml
// reads it, and the sign of position j in an 8-bit sign mask.
kq_grid_byte :: (entry:u64,j:int)->int {return cast(int)((entry>>cast(u64)(8*j))&255);}
kq_sign :: (signs:int,j:int)->int {return ifx (signs&cast(int)KQ_KMASK[j])!=0 then -1 else 1;}
kq_word :: (b:[]u8,at:int)->int {return kq_half_bits(b,at)|(kq_half_bits(b,at+2)<<16);}
// Element k of a lattice block in 2^-27 units: sub-block ib of 32, group l
// of 8, position j. ggml's scale is d (0.5 + s) / 4 for IQ2, d (0.5 + s) / 2
// for IQ3_XXS and d (1 + 2 s) for IQ3_S, so d (2 s + 1) times 1, 2 or 8.
kq_lattice :: (kind:int,b:[]u8,k:int)->int {
    ib:=k/32;l:=(k%32)/8;j:=k%8;d:=kq_half_units(b,0);
    if kind==KQ_IQ2_XXS {
        // Eight bytes a sub-block: four grid indices, then 4 x 7 sign bits and a 4-bit scale.
        aux:=kq_word(b,6+8*ib);
        g:=kq_grid_byte(KQ_IQ2XXS_GRID[kq_byte(b,2+8*ib+l)],j);
        return kq_sign(cast(int)KQ_KSIGNS[(aux>>(7*l))&127],j)*d*(2*(aux>>28)+1)*g;
    }
    if kind==KQ_IQ3_XXS {
        // Two 4-value grid indices a group; the signs and scale words follow all 64 indices.
        aux:=kq_word(b,66+4*ib);
        g:=kq_grid_byte(cast(u64)KQ_IQ3XXS_GRID[kq_byte(b,2+8*ib+2*l+j/4)],j%4);
        return kq_sign(cast(int)KQ_KSIGNS[(aux>>(7*l))&127],j)*d*(2*(aux>>28)+1)*2*g;
    }
    if kind==KQ_IQ3_S {
        // A ninth index bit from qh for each half group, a full sign byte, two scales a byte.
        e:=kq_byte(b,2+8*ib+2*l+j/4)|(((kq_byte(b,66+ib)>>(2*l+j/4))&1)<<8);
        s:=(kq_byte(b,106+ib/2)>>(4*(ib%2)))&15;
        return kq_sign(kq_byte(b,74+4*ib+l),j)*d*(2*s+1)*8*kq_grid_byte(cast(u64)KQ_IQ3S_GRID[e],j%4);
    }
    // IQ2_XS and IQ2_S: a 4-bit scale for each 16 values.
    if kind==KQ_IQ2_XS {
        // A 16-bit code a group: a 9-bit grid index and 7 sign bits.
        q:=kq_half_bits(b,2+8*ib+2*l);s:=(kq_byte(b,66+ib)>>(4*(l/2)))&15;
        return kq_sign(cast(int)KQ_KSIGNS[q>>9],j)*d*(2*s+1)*kq_grid_byte(KQ_IQ2XS_GRID[q&511],j);
    }
    // IQ2_S: a byte of index, two more bits from qh, and a full sign byte.
    e:=kq_byte(b,2+4*ib+l)|(((kq_byte(b,66+ib)>>(2*l))&3)<<8);s:=(kq_byte(b,74+ib)>>(4*(l/2)))&15;
    return kq_sign(kq_byte(b,34+4*ib+l),j)*d*(2*s+1)*kq_grid_byte(KQ_IQ2S_GRID[e],j);
}
// book:end lattice

// book:begin decode
kq_decode :: (kind:int,rows:int,width:int,bytes:[]u8,out:[]f32)->QzResult #export_c {
    p:=kq_plan(kind,rows,width);
    if p.status!=QzStatus.ok {return QzResult.{status=p.status};}
    if bytes.count!=p.bytes {return QzResult.{status=QzStatus.storage};}
    if out.count<p.values {return QzResult.{status=QzStatus.capacity};}
    size:=p.block_bytes;n:=PG_BLOCKS[kind];
    for blk:0..<p.blocks {
        b:=bytes[blk*size..<(blk+1)*size];
        if !qz_half_ok(kq_half_bits(b,kq_d_at(kind))) || !qz_half_ok(kq_half_bits(b,kq_m_at(kind))) {return QzResult.{status=QzStatus.scale};}
    }
    for i:0..<p.values {
        b:=bytes[(i/n)*size..<(i/n+1)*size];
        // |units| < 2^53, so the f64 is exact and f32 rounds once.
        if kq_lattice_kind(kind) {out[i]=f32(f64(kq_lattice(kind,b,i%n))/134217728);}
        else {out[i]=f32(f64(ifx kind==KQ_IQ4_NL || kind==KQ_IQ4_XS then kq_iq4(kind,b,i%n) else kq_value(kind,b,i%n))/16777216);}
    }
    return QzResult.{written=p.values};
}
// One tensor from chapter 49's reader: chapter 50's types go to chapter 50.
kq_tensor :: (t:PgTensor,file:[]u8,out:[]f32)->QzResult #export_c {
    if t.kind==QZ_Q8_0 || t.kind==QZ_Q4_0 {return qz_tensor(t,file,out);}
    if t.dims[0]<1 {return QzResult.{status=QzStatus.shape};}
    if t.begin<0 || t.end>file.count {return QzResult.{status=QzStatus.storage};}
    return kq_decode(t.kind,t.elements/t.dims[0],t.dims[0],file[t.begin..<t.end],out);
}
// book:end decode
