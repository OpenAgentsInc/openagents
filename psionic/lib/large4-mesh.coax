    m.budget=125000000000;b:=l4_smallest(c,m);#assert b.status==L4Status.ok && b.stages==5 && b.width==2;
    for k:0..<8 {#assert l4_status_name(cast(L4Status)k).count>1;}
    #assert l4_status_name(L4Status.ok)=="ok" && l4_status_name(L4Status.place)=="placement refused";
}
#test "a reader's attention is chapter 85's when it reads its own row" {
    s:=m4o_shape();a:=m4o_attn_weights(3);w:=m4_attn_view(a.f[..],a.c[..]);
    hidden:[32]f32;m4o_values(4,hidden[..],0);cache:[28]f32;work:[48]f32;fwork:[8]f64;
    // Layer A writes rows 0..3; a reader with A's weights at each position
    // equals A itself, reading A's rows.
    own:=hidden;#assert m4_attention(s,w,4,0,own[..],cache[..],work[..],fwork[..]).written==4;
    for p:0..<4 {
        mine:[8]f32;for i:0..<8 {mine[i]=hidden[p*8+i];}
        #assert l4_read(s,w,p,mine[..],cache[..],work[..],fwork[..]);
        for i:0..<8 {#assert f32_bits(mine[i])==f32_bits(own[p*8+i]);}
    }
    bad:=a;bad.f[15]=3e38;x:[8]f32;for i:0..<8 {x[i]=1;}#assert !l4_read(s,m4_attn_view(bad.f[..],bad.c[..]),0,x[..],cache[..],work[..],fwork[..]);
}
#forall "the model split over stages and expert peers equals it whole, bit for bit" seed:0..<6,n:1..<4,width:1..<4 #steps 2000000000 {
    src:=[6]int.[0,1,2,1,4,1];
    r:=l4c_run(seed,6,src[..],n,width,4,-1,-1);
    #assert r.whole && r.split.ok && r.same && r.reference && r.split.sent==r.want && r.split.refusal==StgRefusal.none;
}
#test "ties go to the earliest stage start" #steps 2000000000 {
    c:=l4_large4();
    m:=l4c_mesh(3,8);m.read=PLC_RATE_MAX;m.lat_in=0;m.bw_in=PLC_RATE_MAX;p:=l4_plan(c,m);#assert p.cut[1]==25 && p.cut[2]==49 && p.time[0]==57 && p.time[2]==56;
    m.stages=4;p=l4_plan(c,m);#assert p.cut[1]==19 && p.cut[2]==37 && p.cut[3]==55 && p.time[1]==43;
    m.stages=2;p=l4_plan(c,m);#assert p.cut[1]==37 && p.time[0]==85;
    // Layers 0-36 | 37-71 and 0-37 | 38-71 both take 25 ns at the slowest stage.
    m=l4c_mesh(2,1);m.read=PLC_RATE_MAX;m.budget=PLC_AMOUNT_MAX;p=l4_plan(c,m);#assert p.cut[1]==37 && stg_max(p.time[0],p.time[1])==25;
}
#test "the small model's layers are the weights it was given" {
    src:=[2]int.[0,1];f:[2*L4_F]f32;c:[2*L4_C]u8;for i:0..<2*L4_F {f[i]=f32(i);}for i:0..<2*L4_C {c[i]=cast(u8)(i%251);}
    t:=l4c_toy(2,src[..],f[..],c[..]);a:=l4_attn(t,1);m:=l4_moe(t,1);
    #assert a.norm[0]==81 && a.norm.count==8 && a.o.scale==100 && a.q_a.codes[0]==cast(u8)(646%251) && a.o.codes[47]==cast(u8)((646+213)%251);
    #assert m.norm[0]==101 && m.shared_down.scale==161 && m.up[0]==cast(u8)(860%251) && m.shared_down.codes[23]==cast(u8)(1291%251);
}
#test "a changed bit on the wire is refused, and the run stops" #steps 2000000000 {
    src:=[4]int.[0,1,2,1];
    six:=[6]int.[0,1,2,1,4,1];
    r:=l4c_run(0,6,six[..],2,1,4,9,-1);#assert !r.split.ok && r.split.refusal==StgRefusal.checksum && r.split.sent==68 && r.whole && r.cut[1]==4;
    r=l4c_run(0,6,six[..],2,1,4,0,-1);#assert !r.split.ok && r.split.refusal==StgRefusal.version && r.split.sent==68;
    r=l4c_run(0,6,six[..],2,1,4,64+4,-1);#assert !r.split.ok && r.split.refusal==StgRefusal.position && r.split.sent==132;
    r=l4c_run(0,6,six[..],2,1,4,2*64+3,-1);#assert !r.split.ok && r.split.refusal==StgRefusal.layer && r.split.sent==200;
    r=l4c_run(0,6,six[..],2,1,4,64,-1);#assert !r.split.ok && r.split.refusal==StgRefusal.version && r.split.sent==132;
    r=l4c_run(0,6,six[..],2,1,4,5,-1);#assert !r.split.ok && r.split.refusal==StgRefusal.count && r.split.sent==68;
    r=l4c_run(0,6,six[..],2,1,4,-1,-1);#assert r.split.ok && r.same && r.split.sent==528 && r.split.refusal==StgRefusal.none;
    two:=[4]int.[0,1,0,0];r=l4c_run(2,4,two[..],3,1,2,-1,-1);#assert r.split.ok && r.same && r.reference && r.split.sent==r.want;
}
#test "a layer that overflows stops the run, whole and split" #steps 2000000000 {
    six:=[6]int.[0,1,2,1,4,1];
    for bad:[3]int.[0,6,1] {for w:[2]int.[1,2] {
        r:=l4c_run(0,6,six[..],2,w,2,-1,bad);#assert !r.whole && !r.split.ok && !r.reference && r.split.refusal==StgRefusal.none;
    }}
    r:=l4c_run(0,6,six[..],2,2,2,-1,10);#assert !r.whole && !r.split.ok && r.split.sent==132;
}

// book:begin run
// A small model in Large 4's pattern: chapter 85's latent attention and
// mixture layers at its checks' shape, where layer l reads the cache of
// layer src[l] (src[l] < l for a reader, which keeps no cache of its own).
// Layer l's weights are f[81 l ..] (attention's 20 values, then the
// mixture's 61) and c[646 l ..] (214 codes, then 432).
L4Toy :: struct {layers:int;src:[8]int;f:[]f32;c:[]u8;}
L4_F :: 81;L4_C :: 646;
l4_attn :: (t:L4Toy,l:int)->M4Attn {return m4_attn_view(t.f[l*L4_F..<t.f.count],t.c[l*L4_C..<t.c.count]);}
l4_moe :: (t:L4Toy,l:int)->M4Moe {return m4_moe_view(t.f[l*L4_F+20..<(l+1)*L4_F],t.c[l*L4_C+214..<(l+1)*L4_C]);}
// A reader's attention: chapter 85's m4_attention for one token at position
// p, except the cache is the source layer's, read and never written.
l4_read :: (s:M4Shape,w:M4Attn,p:int,x:[]f32,cache:[]f32,work:[]f32,fwork:[]f64)->bool {
    at:=m4_layout(s);kv:=work[0..<s.rope];normed:=work[at[1]..<at[2]];qa:=work[at[2]..<at[3]];q:=work[at[3]..<at[4]];
    latent:=work[at[4]..<at[5]];attended:=work[at[5]..<at[6]];out:=work[at[6]..<at[7]];
    ok:=m4_norm(x,w.norm,normed) && m4_linear(w.q_a,normed,qa) && m4_norm(qa,w.q_norm,qa) && m4_linear(w.q_b,qa,q);
    for head:0..<s.heads {
        r:=q[head*(s.nope+s.rope)+s.nope..<(head+1)*(s.nope+s.rope)];
        ok=ok && m4_rotate(r,p,kv[0..<s.rope]);
        for j:0..<s.rope {r[j]=kv[j];}
    }
    ok=ok && m4_latent(s,w.kv_b,q,cache,p,m4_softmax_scale(s)*m4_position_scale(p),latent,attended,fwork);
    return ok && m4_linear(w.o,attended,out) && m4_residual(x,out);
}
// One token through layers a..<b at position p. caches[l] is layer l's
// cache (a reader's source cache may be a stage's copy); peers and owner
// split each layer's experts (one peer: chapter 85's m4_moe).
l4_layers :: (s:M4Shape,t:L4Toy,a:int,b:int,p:int,x:[]f32,caches:[][]f32,peers:[][]XmPeer,owner:[][]int,work:[]f32,fwork:[]f64)->bool {
    for l:a..<b {
        if t.src[l]==l {if m4_attention(s,l4_attn(t,l),1,p,x,caches[l],work,fwork).status!=M4Status.ok {return false;}}
        else if !l4_read(s,l4_attn(t,l),p,x,caches[t.src[l]],work,fwork) {return false;}
        routes:[1]M4Route;home:[1]int;
        if peers[l].count==1 {if m4_moe(s,l4_moe(t,l),1,x,routes[..],work,fwork).status!=M4Status.ok {return false;}}
        else if xm_moe(s,l4_moe(t,l),peers[l],owner[l],1,home[..],x,routes[..],work,fwork).status!=XmStatus.ok {return false;}
    }
    return true;
}
// The model split at cut (stages of layers cut[i]..<cut[i+1]), token by
// token. Each stage owns the caches of its layers and a copy of each cache
// it reads from an earlier stage; between stages the hidden row and each
// such cache row travel as chapter 186's messages, checked on receipt.
// sent counts their bytes; refusal is the first receipt refused. tamper
// (a check's hook; -1: none) flips bit 0 of word tamper % 64 of message
// tamper / 64, counting from 0 in the order sent.
L4Run :: struct {ok:bool;sent:int;refusal:StgRefusal;}
L4_TOY_DIGEST :: 0x4c34;
l4_tamper :: (wire:[]u32,tamper:int,sent:int) {if tamper>=0 && tamper/64==sent {wire[tamper%64]^=1;}}
l4_split :: (s:M4Shape,t:L4Toy,cut:[]int,tokens:int,hidden:[]f32,caches:[][]f32,copies:[][]f32,peers:[][]XmPeer,owner:[][]int,work:[]f32,fwork:[]f64,wire:[]u32,tamper:int)->L4Run {
    r:=L4Run.{ok=true};h:=s.hidden;row:=m4_row(s);n:=cut.count-1;sent:=0;
    for p:0..<tokens {
        x:=hidden[p*h..<(p+1)*h];
        for i:0..<n {
            a:=cut[i];b:=cut[i+1];
            // This stage's view of the caches: its own, then its copies.
            view:[8][]f32;for l:0..<t.layers {view[l]=ifx l>=a then caches[l] else copies[i*8+l];}
            if !l4_layers(s,t,a,b,p,x,view[0..<t.layers],peers,owner,work,fwork) {r.ok=false;return r;}
            if i==n-1 {continue;}
            // To stage i + 1: the hidden row, then each source row it reads.
            k:=stg_pack(L4_TOY_DIGEST,b,p,h,x,wire);r.sent+=4*k;
            l4_tamper(wire,tamper,sent);sent+=1;
            got:=stg_receive(StgExpect.{model=L4_TOY_DIGEST,layer=b,start=p,width=h},wire[0..<k],x);
            if got.refusal!=StgRefusal.none {r.ok=false;r.refusal=got.refusal;return r;}
            for src:0..<b {
                needed:=false;for l:b..<t.layers {if t.src[l]==src && l!=src {needed=true;}}
                if !needed {continue;}
                from:=ifx src>=a then caches[src] else copies[i*8+src];
                k=stg_pack(L4_TOY_DIGEST+1+cast(u64)src,b,p,row,from[p*row..<(p+1)*row],wire);r.sent+=4*k;
                l4_tamper(wire,tamper,sent);sent+=1;
                got=stg_receive(StgExpect.{model=L4_TOY_DIGEST+1+cast(u64)src,layer=b,start=p,width=row},wire[0..<k],copies[(i+1)*8+src][p*row..<(p+1)*row]);
                if got.refusal!=StgRefusal.none {r.ok=false;r.refusal=got.refusal;return r;}
            }
        }
    }
    return r;
}
// book:end run

l4_status_name :: (s:L4Status)->string {
    names:=[8]string.["ok","input","manifest line","totals differ from the pins","width is not 1, 2, 4 or 8","a layer fits on no peer","no split fits","placement refused"];
    return names[cast(int)s];
}
