MP_STATUS_NAMES :: [9]string.["ok","psionic.pin.target","psionic.pin.path","psionic.pin.bytes","psionic.pin.digest","psionic.pin.scope","psionic.pin.length","psionic.pin.options","psionic.pin.score"];
// The committed manifests' digests: any change to a pin changes its bytes.
MP_MANIFEST_SHA :: [4]string.["7b402750100c28af8a394f645d552130f14d3bba3d4b9737a1bfa593d0a51dbb",
    "bca3bd550067608e56c8a7287be29d809568ccaecb7200555700ab2c1212c559",
    "60c4659ca2b3df199f01966e463e814c12fd3bc0638754dcaa0218684af6a5c1",
    "39b5e874356a5e904a492a630d15e286040f261162f07de0417944705e4291c8"];
