// Frozen contracts for the first targets: Base Labs Elephant and Mammoth at
// their pinned revisions, and nanochat at 92d63d4e. Each pin binds the exact
// source files (bytes and SHA-256), the operations an implementation needs,
// its model-specific bounds and the refusal identities admission reports.
// Upstream code is pinned so it can be read; nothing here executes it.
// psionic/fixtures/models/pins/*.json are this file's manifests, byte for byte.
#load "decision-models.coax";
#load "model-io/identity.coax";
#load "../../coax/lib/nostr/json.coax";
#authority;

MpStatus :: enum u8 {ok;target;path;bytes;digest;scope;length;options;score;}
// One pinned source file. role is what it is to the engine: weights, index,
// config, tokenizer, readout and renderer are data an admission reads;
// reference is code to read, never to run; card and license are notices.
MpFile :: struct {target:int;path:string;bytes:int;sha:string;role:string;}
MpNum :: struct {target:int;name:string;value:int;}
MpOp :: struct {target:int;name:string;unit:string;}
MpTarget :: struct {name:string;origin:string;source:string;revision:string;architecture:string;storage:string;scope:string;license_metadata:string;license_text:string;inventory:string;inventory_sha:string;}

MP_TARGETS :: 4;
MP_INFO :: [4]MpTarget.[
    MpTarget.{name="elephant-1",origin="baselabs/elephant-1",source="https://huggingface.co/baselabs/elephant-1",revision="b3f8a93462fb1051a9de031e94a7ff380e254072",architecture="qwen3_5",storage="BF16",scope="text",license_metadata="mit",license_text="",inventory="psionic/fixtures/models/elephant/manifest.json",inventory_sha="4744758962cc73b7e6954c4385cda209ea29c3d9247f524fa14855ca245eedc3"},
