#test "the target names are exact and nothing else is a target" {
    #assert mp_target("elephant-1")==0 && mp_target("mammoth-1")==1 && mp_target("nanochat")==2 && mp_target("psionic-pin-toy")==3;
    for name:[6]string.["","elephant","Elephant-1","mammoth-1 ","../nanochat","baselabs/elephant-1"] {#assert mp_target(name)==-1;}
    #assert mp_count(0)==13 && mp_count(1)==15 && mp_count(2)==13 && mp_count(3)==1;
    #assert mp_count(-1)==0 && mp_count(4)==0;
    total:=0;for t:0..<MP_TARGETS {total+=mp_count(t);}#assert total==MP_FILE_COUNT;
    a:=mp_file(0,0);#assert a.ok && a.file.path=="README.md" && a.file.bytes==5475;
    a=mp_file(0,1);#assert a.ok && a.file.path=="chat_template.jinja";
    a=mp_file(0,12);#assert a.ok && a.file.path=="tokenizer_config.json" && a.file.target==0;
    a=mp_file(1,0);#assert a.ok && a.file.path=="README.md" && a.file.bytes==5468;
    a=mp_file(3,0);#assert a.ok && a.file.path=="readout.json" && a.file.bytes==47;
    #assert mp_find(0,"README.md").sha=="0c1f7c170191d0906218c3b34ad7a11ae4bc49a04d210eb12e5bb7a5461648f7";
}
#test "decision pins agree with the execution registry" {
    for kind:0..<2 {
        p:=ps_target(cast(u8)kind,16384);#assert p.status==PsStatus.ok;
        #assert MP_INFO[kind].origin==p.origin && MP_INFO[kind].revision==p.revision;
        #assert mp_find(kind,"config.json").sha==p.config_sha && mp_find(kind,"tokenizer.json").sha==p.tokenizer_sha && mp_find(kind,"readout.json").sha==p.readout_sha;
        for s:0..<p.shards {f:=mp_find(kind,p.shard[s].name);#assert f.role=="weights" && f.bytes==p.shard[s].bytes && f.sha==p.shard[s].sha;}
        weights:=0;for i:0..<mp_count(kind) {if mp_file(kind,i).file.role=="weights" {weights+=1;}}#assert weights==p.shards;
        #assert mp_num(kind,"vision_tensors")==333 && mp_num(kind,"vision_tensors")<p.tensors;
        #assert mp_num(kind,"tensors")==p.tensors && mp_num(kind,"vocab")==p.vocab && mp_num(kind,"width")==p.shape.linear.width && mp_num(kind,"ffn")==p.shape.linear.hidden;
        #assert mp_num(kind,"linear_layers")==p.shape.state.linear_layers && mp_num(kind,"full_layers")==p.shape.state.full_layers;
        #assert mp_num(kind,"layers")==p.shape.state.linear_layers+p.shape.state.full_layers;
        #assert mp_num(kind,"heads")==p.shape.full.attention.heads && mp_num(kind,"kv_heads")==p.shape.full.attention.kv_heads;
        #assert mp_num(kind,"head_dim")==p.shape.full.attention.head_dim && mp_num(kind,"rotary_dim")==p.shape.full.attention.rotary_dim;
        #assert mp_num(kind,"delta_value_heads")==p.shape.linear.delta.value_heads && mp_num(kind,"delta_key_heads")==p.shape.linear.delta.key_heads;
        #assert mp_num(kind,"delta_dim")==p.shape.linear.delta.key_dim && mp_num(kind,"delta_dim")==p.shape.linear.delta.value_dim;
    }
    #assert mp_find(1,"model.safetensors.index.json").sha==ps_target(1,1).index_sha && mp_find(0,"model.safetensors.index.json").path=="";
}
#test "every pin is a lowercase SHA-256 with a positive size, unique per target" {
    for i:0..<MP_FILE_COUNT {
        f:=MP_FILES[i];#assert pw_hex_digest(f.sha) && f.bytes>0 && f.target>=0 && f.target<MP_TARGETS && f.path!="";
        for j:0..<i {#assert MP_FILES[j].target!=f.target || MP_FILES[j].path!=f.path;}
        #assert f.role=="weights" || f.role=="index" || f.role=="config" || f.role=="tokenizer" || f.role=="readout" || f.role=="renderer" || f.role=="reference" || f.role=="card" || f.role=="license";
    }
    for i:0..<MP_NUM_COUNT {#assert MP_NUMS[i].value>0;for j:0..<i {#assert MP_NUMS[j].target!=MP_NUMS[i].target || MP_NUMS[j].name!=MP_NUMS[i].name;}}
    for i:0..<MP_OP_COUNT {for j:0..<i {#assert MP_OPS[j].target!=MP_OPS[i].target || MP_OPS[j].name!=MP_OPS[i].name;}}
    #assert mp_num(0,"absent")==0 && mp_num(4,"layers")==0 && mp_find(4,"config.json").path=="" && !mp_file(0,13).ok && !mp_file(0,-1).ok && !mp_file(4,0).ok;
}
#test "license metadata is not license text" {
    // The Base Labs trees carry `license: mit` in card metadata and no LICENSE
    // file; nanochat carries the actual text. A redistribution basis needs text.
    for kind:0..<2 {#assert MP_INFO[kind].license_metadata=="mit" && MP_INFO[kind].license_text=="" && mp_find(kind,"LICENSE").path=="" && !mp_text_licensed(kind);}
    #assert mp_text_licensed(2) && mp_find(2,"LICENSE").role=="license" && MP_INFO[2].license_metadata=="";
    #assert !mp_text_licensed(3) && !mp_text_licensed(-1) && !mp_text_licensed(4);
}
#test "metadata admission names the first mismatch" {
    f:=mp_find(0,"config.json");
    #assert mp_check(0,"config.json",f.bytes,f.sha)==MpStatus.ok;
    #assert mp_check(5,"config.json",f.bytes,f.sha)==MpStatus.target && mp_check(-1,"config.json",f.bytes,f.sha)==MpStatus.target;
    #assert mp_check(0,"config.jsn",f.bytes,f.sha)==MpStatus.path && mp_check(0,"",f.bytes,f.sha)==MpStatus.path;
    #assert mp_check(0,"config.json",f.bytes+1,f.sha)==MpStatus.bytes && mp_check(0,"config.json",f.bytes-1,f.sha)==MpStatus.bytes;
    #assert mp_check(0,"config.json",f.bytes,mp_find(1,"config.json").sha)==MpStatus.digest && mp_check(0,"config.json",f.bytes,"")==MpStatus.digest;
    // Mammoth's config is another file: the same name does not cross targets.
    #assert mp_check(1,"config.json",f.bytes,f.sha)==MpStatus.bytes;
    w:=mp_find(1,"model-00002-of-00002.safetensors");#assert mp_check(1,w.path,w.bytes,w.sha)==MpStatus.ok && mp_check(0,w.path,w.bytes,w.sha)==MpStatus.path;
    for i:0..<9 {#assert mp_status_name(cast(MpStatus)i)==MP_STATUS_NAMES[i];}
    #assert mp_status_name(MpStatus.digest)=="psionic.pin.digest" && mp_status_name(MpStatus.ok)=="ok";
}
#test "byte admission hashes the synthetic fixture offline" {
    toy:=MP_TOY_READOUT;data:[64]u8;for i:0..<toy.count {data[i]=toy[i];}
    #assert toy.count==47 && mp_admit(3,"readout.json",data[0..<toy.count])==MpStatus.ok;
    #assert mp_admit(3,"readout.json",data[0..<toy.count-1])==MpStatus.bytes && mp_admit(3,"other.json",data[0..<toy.count])==MpStatus.path;
    #assert mp_admit(9,"readout.json",data[0..<toy.count])==MpStatus.target;
    for pos:[3]int.[0,23,46] {data[pos]^=1;#assert mp_admit(3,"readout.json",data[0..<toy.count])==MpStatus.digest;data[pos]^=1;}
    #assert mp_admit(3,"readout.json",data[0..<toy.count])==MpStatus.ok;
}
#test "decision requests are text-only, bounded and never truncated" {
    for kind:0..<2 {
        #assert mp_request(kind,1,1,0,0)==MpStatus.ok && mp_request(kind,16384,255,0,0)==MpStatus.ok && mp_request(kind,10,0,1,0)==MpStatus.ok && mp_request(kind,10,0,10,0)==MpStatus.ok;
        #assert mp_request(kind,0,1,0,0)==MpStatus.length && mp_request(kind,16385,1,0,0)==MpStatus.length;
        #assert mp_request(kind,10,256,0,0)==MpStatus.options && mp_request(kind,10,0,0,0)==MpStatus.options && mp_request(kind,10,-1,0,0)==MpStatus.options;
        #assert mp_request(kind,10,0,11,0)==MpStatus.score && mp_request(kind,10,0,-1,0)==MpStatus.score && mp_request(kind,10,2,3,0)==MpStatus.score;
        #assert mp_request(kind,10,2,0,1)==MpStatus.scope && mp_request(kind,10,2,0,-1)==MpStatus.scope;
    }
    #assert mp_request(2,10,2,0,0)==MpStatus.scope && mp_request(3,10,2,0,0)==MpStatus.scope && mp_request(4,10,2,0,0)==MpStatus.target && mp_request(-1,10,2,0,0)==MpStatus.target;
}
#test "manifests are complete JSON, match the committed bytes and never truncate" {
    out:[24576]u8;
    for t:0..<MP_TARGETS {
        n:=mp_manifest(t,out[..]);#assert n>0 && json_valid(cast(string)out[0..<n]) && out[n-1]=='\n';
        #assert pw_digest(out[0..<n],MP_MANIFEST_SHA[t]);
        #assert mp_manifest(t,out[0..<n])==n && mp_manifest(t,out[0..<n-1])==-1 && mp_manifest(t,out[0..<0])==-1;
    }
    #assert mp_manifest(-1,out[..])==-1 && mp_manifest(4,out[..])==-1;
}

mp_target :: (name:string)->int {
    for t:0..<MP_TARGETS {if MP_INFO[t].name==name {return t;}}
    return -1;
}
mp_known :: (t:int)->bool {return t>=0 && t<MP_TARGETS;}
mp_count :: (t:int)->int {
    n:=0;for i:0..<MP_FILE_COUNT {if MP_FILES[i].target==t {n+=1;}}
    return n;
}
MpPinned :: struct {ok:bool;file:MpFile;}
// The target's i-th file in table order.
mp_file :: (t:int,i:int)->MpPinned {
    k:=0;
    for j:0..<MP_FILE_COUNT {
        if MP_FILES[j].target==t {if k==i {return MpPinned.{ok=true,file=MP_FILES[j]};}k+=1;}
    }
    return MpPinned.{};
}
mp_find :: (t:int,path:string)->MpFile {
    for i:0..<MP_FILE_COUNT {if MP_FILES[i].target==t && MP_FILES[i].path==path {return MP_FILES[i];}}
    return MpFile.{};
}
mp_num :: (t:int,name:string)->int {
    for i:0..<MP_NUM_COUNT {if MP_NUMS[i].target==t && MP_NUMS[i].name==name {return MP_NUMS[i].value;}}
    return 0;
}
mp_text_licensed :: (t:int)->bool {
    if !mp_known(t) || MP_INFO[t].license_text=="" {return false;}
    return mp_find(t,MP_INFO[t].license_text).role=="license";
}
mp_status_name :: (s:MpStatus)->string {return MP_STATUS_NAMES[cast(int)s];}
// A file someone holds, described by its size and digest, against the pin.
mp_check :: (t:int,path:string,bytes:int,sha:string)->MpStatus {
    if !mp_known(t) {return MpStatus.target;}
    f:=mp_find(t,path);
    if f.path=="" {return MpStatus.path;}
    if bytes!=f.bytes {return MpStatus.bytes;}
    if sha!=f.sha {return MpStatus.digest;}
    return MpStatus.ok;
}
// The bytes themselves, hashed here: no host-supplied digest is trusted.
mp_admit :: (t:int,path:string,data:[]u8)->MpStatus {
    if !mp_known(t) {return MpStatus.target;}
    f:=mp_find(t,path);
    if f.path=="" {return MpStatus.path;}
    if data.count!=f.bytes {return MpStatus.bytes;}
    if !pw_digest(data,f.sha) {return MpStatus.digest;}
    return MpStatus.ok;
}
// A decision request's shape against the published bounds: 1..16384 tokens,
// a choice of 1..255 options or a score of 1..10 levels (one, not both), and
// no images in the text-only profile. Over-limit work is refused, never cut.
mp_request :: (t:int,tokens:int,options:int,levels:int,images:int)->MpStatus {
    if !mp_known(t) {return MpStatus.target;}
    if t>1 || images!=0 {return MpStatus.scope;}
    if tokens<1 || tokens>mp_num(t,"max_tokens") {return MpStatus.length;}
    if levels!=0 {
        if levels<1 || levels>10 || options!=0 {return MpStatus.score;}
        return MpStatus.ok;
    }
    if options<1 || options>255 {return MpStatus.options;}
    return MpStatus.ok;
}
mp_role_use :: (role:string)->string {
    if role=="reference" {return "read-only; never executed";}
    if role=="card" || role=="license" {return "notice";}
    return "data";
}
mp_field :: (out:[]u8,at:int,name:string,value:string)->int {
    n:=json_raw(out,at,",\n  ");n=json_write_string(out,n,name);n=json_raw(out,n,": ");
    if value=="" {return json_raw(out,n,"null");}
    return json_write_string(out,n,value);
}
// One manifest per target, newline-terminated, or -1 when out is too small.
mp_manifest :: (t:int,out:[]u8)->int #export_c {
    if !mp_known(t) {return -1;}
    m:=MP_INFO[t];
    n:=json_raw(out,0,"{\n  \"schema\": \"psionic.model-pin.v1\"");
    n=mp_field(out,n,"target",m.name);n=mp_field(out,n,"origin",m.origin);n=mp_field(out,n,"source",m.source);
    n=mp_field(out,n,"revision",m.revision);n=mp_field(out,n,"architecture",m.architecture);
    n=mp_field(out,n,"storage",m.storage);n=mp_field(out,n,"scope",m.scope);
    n=mp_field(out,n,"license_metadata",m.license_metadata);n=mp_field(out,n,"license_text",m.license_text);
    n=mp_field(out,n,"inventory",m.inventory);n=mp_field(out,n,"inventory_sha256",m.inventory_sha);
    n=json_raw(out,n,",\n  \"bounds\": {");first:=true;
    for i:0..<MP_NUM_COUNT {
        if MP_NUMS[i].target!=t {continue;}
        if !first {n=json_raw(out,n,",");}first=false;
        n=json_raw(out,n,"\n    ");n=json_write_string(out,n,MP_NUMS[i].name);n=json_raw(out,n,": ");n=json_write_int(out,n,MP_NUMS[i].value);
    }
    n=json_raw(out,n,"\n  },\n  \"files\": [");first=true;
    for i:0..<MP_FILE_COUNT {
        f:=MP_FILES[i];if f.target!=t {continue;}
        if !first {n=json_raw(out,n,",");}first=false;
        n=json_raw(out,n,"\n    {\"path\": ");n=json_write_string(out,n,f.path);n=json_raw(out,n,", \"role\": ");n=json_write_string(out,n,f.role);
        n=json_raw(out,n,", \"use\": ");n=json_write_string(out,n,mp_role_use(f.role));
        n=json_raw(out,n,", \"bytes\": ");n=json_write_int(out,n,f.bytes);n=json_raw(out,n,", \"sha256\": ");n=json_write_string(out,n,f.sha);n=json_raw(out,n,"}");
    }
    n=json_raw(out,n,"\n  ],\n  \"operations\": [");first=true;
    for i:0..<MP_OP_COUNT {
        o:=MP_OPS[i];if o.target!=t {continue;}
        if !first {n=json_raw(out,n,",");}first=false;
        n=json_raw(out,n,"\n    {\"name\": ");n=json_write_string(out,n,o.name);n=json_raw(out,n,", \"unit\": ");n=json_write_string(out,n,o.unit);n=json_raw(out,n,"}");
    }
    n=json_raw(out,n,"\n  ],\n  \"refusals\": [");
    for i:1..<9 {if i>1 {n=json_raw(out,n,", ");}n=json_write_string(out,n,MP_STATUS_NAMES[i]);}
    return json_raw(out,n,"]\n}\n");
}
