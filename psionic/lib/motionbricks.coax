#test "edges the other checks do not reach" #steps 400000000 {
    // Inventory: an empty first line, an empty expected line, a nameless line.
    r:=mb_inventory("x\n","\nx\n");#assert r.status==MbStatus.checkpoint && r.lines==2 && r.expected==1 && r.bad== -1;
    r=mb_inventory("\n","\n");#assert r.status==MbStatus.ok && r.expected==1 && r.lines==1;
    r=mb_inventory(""," F32 5\nxF32 7\n");#assert r.parameters==5;
    // The smallest codebook; ties go to the lower code and the lower pair.
    s:=mb_small();t:=s;t.heads=1;t.dim=1;b:=mb_small_codebook(t);
    #assert b.value[0][0][0]==0.25 && b.value[0][3][0]==1;
    u:=mb_unpack(b,3);#assert u.status==MbStatus.ok && u.code[0]==3;
    one:=b;one.codes=2;#assert mb_unpack(one,1).code[0]==1;
    z:[MB_LATENT_MAX]f64;z[0]=0.375;#assert mb_quantize(b,z).code[0]==0;z[0]=0.875;#assert mb_quantize(b,z).code[0]==2;
    p:=mb_separation(b,0);#assert p.first==0 && p.second==1 && p.squared==0.0625;
    big:=mb_small_codebook(s);#assert big.value[0][3][0]==1 && big.value[1][2][1]==1 && big.value[1][0][0]== -0.25 && big.value[1][3][1]==1.5 && big.value[0][0][1]==0.5;
    // Shapes at their edges.
    e:=s;e.dim=1;#assert mb_shape_ok(e);e=s;e.width=4;#assert mb_shape_ok(e);e=s;e.attn=1;#assert mb_shape_ok(e);
    e=s;e.attn=0;#assert !mb_shape_ok(e);e=s;e.decoded=28;#assert mb_shape_ok(e);e=s;e.decoded=10;#assert mb_shape_ok(e);
    e=s;e.pose_feat=4;e.root_feat=16;e.length_feat=12;#assert mb_shape_ok(e);e=s;e.pose_feat=4;e.root_feat=12;e.length_feat=16;#assert mb_shape_ok(e);
    e=s;e.pose_feat=16;#assert mb_shape_ok(e);e=s;e.pose_in=16;#assert mb_shape_ok(e);
    // The plans' offsets, by hand.
    d:=mb_decoder_plan(s);
    #assert d.block[0][0][0]==104 && d.block[0][0][1]==304 && d.block[0][1][0]==376 && d.block[0][1][1]==576 && d.up[0]==648;
    #assert d.external[0]==848 && d.target[0]==984 && d.block[1][0][0]==1012 && d.block[1][1][1]==1484 && d.up[1]==1556 && d.external[1]==1756;
    #assert d.target[1]==1860 && d.mid==1916 && d.out==2116 && d.count==2516;
    g:=mb_predictor_plan(s);
    #assert g.mlp[0]==20 && g.mlp[1]==60 && g.mlp[2]==132 && g.root==204 && g.pose==272 && g.length==300 && g.input==344;
    #assert g.layer[0]==480 && g.layer[1]==1080 && g.logit==1680 && g.count==1752;
    // Three values a head: 8 x 6 x 3 + 8 for the first convolution; 2 x 5 x 3
    // table rows and 8 x 6 + 8 for the first MLP layer.
    three:=s;three.dim=3;#assert mb_decoder_plan(three).count==2564 && mb_predictor_plan(three).count==1778 && mb_predictor_plan(three).mlp[0]==30;
    // A convolution never reads past its positions.
    w:=[4]f64.[1,1,1,0];x:=[3]f64.[1,2,99];y:[2]f64;mb_conv(w[..],0,x[..],2,1,1,3,1,y[..]);#assert y[0]==3 && y[1]==3;
    // ReLU sends -0 to +0; LeakyReLU keeps a hundredth; the larger of two.
    #assert f64_bits(mb_relu1(-0.0))==0 && mb_relu1(-2)==0 && mb_relu1(3)==3;
    l:=[2]f64.[-1,2];mb_leaky(l[..],2);#assert pose_near(l[0],-0.01,1e-15) && pose_near(l[1],2,1e-15);
    #assert mb_larger(1000,0)==1000 && mb_larger(0,1000)==1000 && mb_larger(-3,-5)== -3;
    #assert mb_mask_count(3,4,4,1)==1 && mb_mask_count(3,4,1,1)==1 && mb_mask_count(1,4,1,1)==1 && mb_mask_count(0,4,1,1)==1;
}
#test "exact lengths, edge counts and large scores" #steps 400000000 {
    s:=mb_small();w:[MB_WEIGHTS_MAX]f64;mb_synthetic(w[..],mb_predictor_plan(s).count,1,1);b:=mb_small_codebook(s);
    c:=mb_walk(s,16,0);q:MbTokens;q.count=16;
    dec:[MB_WEIGHTS_MAX]f64;mb_synthetic_decoder(s,dec[..],3,1);
    #assert dec[0]==3.0/64 && dec[1]== -21.0/64 && dec[2516]==0 && dec[2116+400-16+3]==0.9 && dec[2116+400-16+4]==1 && dec[2116+400-16+14]==1;
    #assert mb_decode(s,dec[0..<2516],b,q,c).status==MbStatus.ok && mb_decode(s,dec[..],b,q,c).frames==64;
    #assert mb_predict(s,w[0..<1752],q,c).status==MbStatus.ok && mb_generate(s,w[0..<1752],16,c,16).status==MbStatus.ok;
    q.code[0][0]=5;#assert mb_predict(s,w[..],q,c).status==MbStatus.token;
    // Scores in the millions: the softmax subtracts the largest, so no NaN.
    loud:[MB_WEIGHTS_MAX]f64;mb_synthetic(loud[..],mb_predictor_plan(s).count,1,64);q.code[0][0]=0;q.count=6;
    l:=mb_predict(s,loud[..],q,mb_walk(s,6,0));
    for t:0..<6 {for h:0..<2 {for k:0..<4 {#assert l.value[t][h][k]==l.value[t][h][k];}}}
    // Zero weights: every logit ties, so code 0 wins at confidence 1/4, and
    // step 1 masks the first 8 of 12 tokens in order.
    zero:[MB_WEIGHTS_MAX]f64;g:=mb_generate(s,zero[..],6,mb_walk(s,6,0),2);
    #assert g.masked[1]==8 && g.last[0]==11 && g.last[1]==7 && g.changed[1]==0 && g.confidence[5][1]==0.25 && g.tokens.code[5][1]==0;
    // The clip: one frame and 64 frames; a sideways step under a turn.
    m:MbMotion;m.frames=1;m.value[0][0]=POSE_PI/2;m.value[0][1]=1;m.value[0][4]=1;m.value[0][8]=1;m.value[0][10]=1;m.value[0][14]=1;
    k:=mb_clip(s,m);#assert k.status==MbStatus.ok && pose_near(k.clip.frame[0].root[2],-1,1e-15) && pose_near(k.clip.frame[0].root[0],0,1e-15);
    for f:1..<64 {m.value[f]=m.value[0];}m.frames=64;#assert mb_clip(s,m).status==MbStatus.ok;
    ch:=mb_chain(2);#assert ch.offset[1][1]== -0.25;
}
