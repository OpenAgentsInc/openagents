    s:=mb_small();c:=mb_walk(s,6,0.5);
    #assert c.has[0] && c.has[3] && !c.has[4] && !c.has[19] && c.has[20] && c.has[23] && !c.has[24];
    #assert c.pose[0][0]==1.4 && c.pose[0][1]==1.5 && c.pose[0][2]==0.5 && c.pose[0][5]==1.5 && c.pose[0][7]==1.5 && c.pose[0][11]==1.5 && c.pose[0][12]==0.5;
    #assert c.root[5][1]==0.25 && c.root[5][2]==1 && c.velocity[23][1]==0.05 && c.velocity[24][1]==0;
    k:=mb_chain(3);#assert k.count==3 && k.parent[0]== -1 && k.parent[2]==1 && k.offset[2][1]== -0.25 && k.offset[0][1]==0;
    w:[8]f64;mb_synthetic(w[..],8,1,2);#assert w[0]==(11.0-30)/32 && w[1]==(48.0-30)/32 && w[2]==(85.0-61-30)/32;
}
