// Chapter 128: a complete pretraining run of chapter 125's nanochat GPT on
// the CPU in binary64 (nanochat-pretrain-cpu-f64-v1). A plan names the
// model, the batch, the schedule and a compute envelope, and is admitted or
// refused before any work. The corpus is split by source, never by window,
// and audited for shared paragraphs; chapter 123's byte BPE is trained on
// training documents only. Each step averages chapter 127's gradient over a
// batch of windows drawn in a seeded per-epoch order and takes one step of
// chapter 124's AdamW with a warmup and warmdown schedule. Evaluation reports
// held-out bits per byte next to unigram and bigram baselines on the same
// targets. A checkpoint holds the plan and data identities, the step and
// every parameter and moment; resume refuses anything else and continues
// bit for bit. The acceptance rule is frozen here, before any run.
#load "backward.coax";
#load "../bpe-train.coax";
#load "../checkpoint/record.coax";
#load "../../fixtures/nanochat/pretrain-oracle.coax";
#authority;

NpStatus :: enum u8 {ok;config;budget;data;leak;tokenizer;number;optimizer;}
NpCheck :: enum u8 {ok;shape;magic;version;corrupt;plan;data;step;number;}
// book:begin plan
// Everything a run decides. model.sequence_len is the window length; every
// window is a full context. Rates are AdamW's, one per parameter group, and
// are scaled by the schedule: a linear warmup over warmup steps, then
// constant, then a linear warmdown over the last warmdown steps towards
// final times the rate. budget caps the run's estimated FLOPs.
NpPlan :: struct {model:NcConfig;batch:int;steps:int;warmup:int;warmdown:int;final:f64;
    embed:f64;matrix:f64;head:f64;scalar:f64;beta1:f64;beta2:f64;eps:f64;clip:f64;seed:u64;init:u64;budget:f64;}
// book:end plan
NpData :: struct {status:NpStatus;train:int;val:int;train_docs:int;val_docs:int;train_bytes:int;val_bytes:int;shared:int;paragraphs:int;}
NpTok :: struct {status:NpStatus;written:int;merges:int;vocab:int;}
NpRun :: struct {step:int;state:AwState;}
NpStep :: struct {status:NpStatus;run:NpRun;loss:f64;norm:f64;scale:f64;}
NpEval :: struct {status:NpStatus;nats:f64;bytes:int;targets:int;bpb:f64;}
NpBase :: struct {status:NpStatus;unigram:f64;bigram:f64;k:f64;}
NpRead :: struct {status:NpCheck;run:NpRun;}
NP_STEPS :: 100000;
NP_BATCH :: 64;
// Sources whose number is a multiple of NP_HOLDOUT are held out.
NP_HOLDOUT :: 8;
// The tokenizer: 63 merges over 16 training samples of at most 256 bytes;
// with the 256 bytes and BOS the vocabulary is exactly 320, five rows of 64.
NP_MERGES :: 63;
NP_SAMPLES :: 16;
NP_SAMPLE_BYTES :: 256;
NP_PARAGRAPHS :: 4096;
// book:begin accept
// The acceptance rule, frozen before the first run: the model's held-out
// bits per byte must be at least NP_MARGIN below the best smoothed bigram's,
// on the same targets.
NP_MARGIN :: 0.1;
np_accept :: (model:f64,base:NpBase)->bool {return base.status==NpStatus.ok && model+NP_MARGIN<=base.bigram;}
// book:end accept
// Bigram add-k smoothing: the best k on the held-out targets is kept, which
// favours the baseline.
NP_K :: [6]f64.[1,0.3,0.1,0.03,0.01,0.003];
NP_HEAD :: 100;
np_size :: (n:int)->int {return NP_HEAD+24*n+32;}

#test "hand values: schedule, groups, envelope and initialization" {
    p:=NP_TEST;#assert np_admit(p,4)==NpStatus.ok;
    // warmup 2 and warmdown 2 of 6 steps, final 0.5: 1/2, 1, 1, 1, 1, then f = 1/2 gives 1/2 + 1/2 * 1/2.
    want:=[7]f64.[0.5,1,1,1,1,0.75,0.5];for s:0..<7 {#assert np_scale(p,s)==want[s];}
    // The constant phase never reads final: exactly 1 up to steps - warmdown.
    q:=p;q.final=0.0/0.0;#assert np_scale(q,4)==1 && np_scale(q,1)==1;
    q=p;q.warmup=0;q.warmdown=0;for s:0..<7 {#assert np_scale(q,s)==1;}
    q.warmdown=1;#assert np_scale(q,5)==1 && np_scale(q,6)==0.5;
    #assert np_min(4,9)==4 && np_min(9,4)==4 && np_min(-2,1)==-2;
    c:=p.model;g:[5]AwGroup;np_groups(p,0.5,g[..]);
    #assert g[0].first==0 && g[0].count==4 && g[0].lr==p.scalar/2 && g[1].first==4 && g[1].count==64*24 && g[1].lr==p.embed/2;
    #assert g[2].first==nc_block(c,0).q && g[2].count==nc_head(c)-g[2].first && g[2].lr==p.matrix/2 && g[3].first==nc_head(c) && g[3].count==64*24 && g[3].lr==p.head/2;
    #assert g[4].first==nc_smear_gate(c) && g[4].first+g[4].count==nc_parameter_count(c) && g[4].lr==p.embed/2;
    for k:0..<5 {#assert g[k].beta1==p.beta1 && g[k].beta2==p.beta2 && g[k].eps==p.eps && g[k].decay==0;}
    // 6 x 10216 parameters x 6 steps x 2 windows x 7 predicted tokens.
    #assert nc_parameter_count(c)==10216 && np_flops(p)==6.0*10216*6*2*7 && np_size(10216)==245316;
    w:[10216]f64;np_init(c,9,w[..]);s:=sqrt(3.0/24);
    #assert w[0]==1 && w[1]==0.1 && w[2]==0.1 && w[3]==0.2;
    u:=(f64(cr_bits(9,4)>>11))/9007199254740992.0;#assert w[4]==sqrt(3.0)*(2*u-1);
    b:=nc_block(c,0);ats:=[10]int.[b.q,b.k+5,b.v+7,b.fc+9,b.proj+3,b.mlp+11,b.gate+1,nc_head(c)+40,nc_smear_gate(c)+2,b.value+30];
    scales:=[10]f64.[s,s,s,s,0.1*s,0.1*s,0.1*s,0.001*sqrt(3.0),0.1*s,s];
    for k:0..<10 {at:=ats[k];u=f64(cr_bits(9,cast(u64)at)>>11)/9007199254740992.0;#assert w[at]==scales[k]*(2*u-1);}
}
#test "admission refuses each field just outside its range" {
    p:=NP_TEST;#assert np_admit(p,2)==NpStatus.ok && np_admit(p,1)==NpStatus.data;
    bad:[19]NpPlan;for k:0..<19 {bad[k]=p;}
    bad[0].model.width=23;bad[1].model.context=7;bad[2].batch=0;bad[3].batch=65;bad[4].steps=0;bad[5].steps=NP_STEPS+1;
    bad[6].warmup=-1;bad[7].warmdown=-1;bad[8].warmup=5;bad[9].final=-0.01;bad[10].final=1.01;bad[11].embed=0;bad[12].head=1.01;
    bad[13].matrix=0.0/0.0;bad[14].scalar=2;bad[15].beta1=1;bad[16].clip=-1;bad[17].eps=0;bad[18].beta2=1;
    for k:0..<19 {#assert np_admit(bad[k],4)==NpStatus.config;}
    e:=p;e.budget=np_flops(p);#assert np_admit(e,4)==NpStatus.ok;e.budget=np_flops(p)-1;#assert np_admit(e,4)==NpStatus.budget;
    edge:=[6]NpPlan.[p,p,p,p,p,p];edge[0].batch=64;edge[1].final=1;edge[2].final=0;edge[3].clip=0;edge[4].warmup=3;edge[4].warmdown=3;edge[5].steps=NP_STEPS;edge[5].budget=1e30;
    #assert np_admit(edge[0],64)==NpStatus.ok && np_admit(edge[0],63)==NpStatus.data;for k:1..<6 {#assert np_admit(edge[k],4)==NpStatus.ok;}
    c:=p;c.clip=1.0/0.0;#assert np_admit(c,4)==NpStatus.config;c=p;c.matrix=1;c.beta2=0;#assert np_admit(c,4)==NpStatus.ok;
    #assert np_unit(1) && !np_unit(0) && !np_unit(1.0000001);
    low:=[4]NpPlan.[p,p,p,p];low[0].batch=1;low[1].steps=1;low[1].warmup=0;low[1].warmdown=0;low[2].warmup=0;low[3].warmdown=0;for k:0..<4 {#assert np_admit(low[k],4)==NpStatus.ok;}
}
#test "bits per byte by hand, and the baselines' counts" {
    // A zero head gives each of 40 tokens logit 0: ln 40 nats per target.
    p:=NP_TEST;c:=p.model;w:[10216]f64;np_init(c,1,w[..]);for i:nc_head(c)..<nc_smear_gate(c) {w[i]=0;}
    lengths:[40]int;for i:0..<39 {lengths[i]=1+i%3;}
    val:=[16]int.[39,1,2,3,39,5,6,7,39,9,10,11,12,13,14,15];cache:[400]f64;work:[1304]f64;logits:[320]f64;
    e:=np_eval(c,w[..],val[..],lengths[..],2,cache[..],work[..],logits[..]);
    // Targets 1, 2, 3, 5, 6, 7 (BOS has no bytes) and 9 to 15: bytes 2+3+1+3+1+2 and 1+2+3+1+2+3+1.
    #assert e.status==NpStatus.ok && e.targets==13 && e.bytes==25 && abs(e.nats-13*log(40.0))<1e-12 && abs(e.bpb-13*log(40.0)/log(2.0)/25)<1e-14;
    #assert np_eval(c,w[..],val[..],lengths[..],3,cache[..],work[..],logits[..]).status==NpStatus.data && np_eval(c,w[..],val[..],lengths[..],0,cache[..],work[..],logits[..]).status==NpStatus.data;
    // With a larger head, a window without BOS targets is chapter 125's mean loss times 7.
    np_init(c,1,w[..]);for i:nc_head(c)..<nc_smear_gate(c) {w[i]*=3000;}one:=[8]int.[1,2,3,4,5,6,7,8];
    e=np_eval(c,w[..],one[..],lengths[..],1,cache[..],work[..],logits[..]);none:[1]f64;
    f:=nc_forward(c,w[..],one[..],cache[..],work[..],logits[..],none[0..<0],false);#assert f.status==NcStatus.ok && abs(e.nats-7*f.loss)<1e-12 && e.nats>7 && e.bytes==3+1+2+3+1+2+3;
    w[nc_head(c)]=0.0/0.0;#assert np_eval(c,w[..],val[..],lengths[..],1,cache[..],work[..],logits[..]).status==NpStatus.number;
    // Three symbols, BOS = 2 with no bytes. Train 2 0 1 0 1 2 0: token counts 3, 2, 2 of 7;
    // pairs (2,0) twice, (0,1) twice, (1,0), (1,2); each symbol starts two pairs.
    small:=c;small.vocab=3;small.sequence_len=3;small.context=3;
    train:=[7]int.[2,0,1,0,1,2,0];v:=[6]int.[2,0,1,0,1,2];bytes:=[3]int.[1,2,0];counts:[15]f64;
    b:=np_baselines(small,train[..],v[..],bytes[..],2,counts[..]);
    // Targets: 0 after 2, 1 after 0, 1 after 0 (2 after 1 has no bytes): 1 + 2 + 2 bytes.
    // Unigram add-one: (3+1)/(7+3) for 0, (2+1)/10 for 1.
    #assert b.status==NpStatus.ok && abs(b.unigram-(-log(0.4)-2*log(0.3))/log(2.0)/5)<1e-15;
    // Bigram add-k: (2+k)/(2+3k) for each target.
    best:=1e300;bk:=0.0;for k:NP_K {x:=-3*log((2+k)/(2+3*k))/log(2.0)/5;if x<best {best=x;bk=k;}}
    #assert abs(b.bigram-best)<1e-15 && b.k==bk && b.k==0.003;
    #assert counts[0*3+1]==2 && counts[2*3+0]==2 && counts[9+0]==3 && counts[12+2]==2 && counts[12+0]==2;
    // An unseen pair (1 after 1) makes the largest k best.
    unseen:=[3]int.[1,1,0];b=np_baselines(small,train[..],unseen[..],bytes[..],1,counts[..]);#assert b.k==1;
    #assert np_baselines(small,train[..],v[..],bytes[..],2,counts[0..<14]).status==NpStatus.data && np_baselines(small,train[..],v[..],bytes[..],3,counts[..]).status==NpStatus.data;
    b=np_baselines(small,train[..],v[..],bytes[..],2,counts[..]);
    #assert np_accept(b.bigram-0.1,b) && !np_accept(b.bigram-0.0999,b);no:=b;no.status=NpStatus.data;#assert !np_accept(0,no);
    // Exactly the margin passes: 0.4 + 0.1 is 0.5 in binary64.
    edge:=NpBase.{bigram=0.5};#assert np_accept(0.4,edge) && !np_accept(0.4000001,edge);
    // Rows that differ from token counts: train 2 0 1 1 0 1 2 0 1 has counts 3, 4, 2 and rows 3, 3, 2;
    // targets 0 after 1 and the unseen 0 after 0.
    t3:=[9]int.[2,0,1,1,0,1,2,0,1];v3:=[3]int.[1,0,0];for i:0..<15 {counts[i]=5;}b=np_baselines(small,t3[..],v3[..],bytes[..],1,counts[..]);
    #assert counts[9]==3 && counts[10]==4 && counts[11]==2 && counts[12]==3 && counts[13]==3 && counts[14]==2 && counts[4]==1 && counts[8]==0;
    best=1e300;for k:NP_K {x:=-(log((1+k)/(3+3*k))+log(k/(3+3*k)))/log(2.0)/2;if x<best {best=x;}}#assert abs(b.bigram-best)<1e-15 && b.k==1;
    #assert abs(b.unigram+2*log(4.0/12)/log(2.0)/2)<1e-15;
    // One symbol: every k gives probability 1, and the tie keeps the first k.
    lone:=small;lone.vocab=1;lone.sequence_len=2;z:=[3]int.[0,0,0];one1:=[1]int.[1];b=np_baselines(lone,z[..],z[0..<2],one1[..],1,counts[..]);#assert b.k==1 && b.bigram==0;
}
#test "the split holds out whole sources and refuses a shared paragraph" {
    docs:=[5]string.["alpha beta.\n\ngamma\ndelta.\n\n","held out text.\n\n","epsilon.\n\nzeta eta.","\n\nmore held.\n\n\n\n","theta\n"];
    sources:=[5]int.[1,8,2,16,3];hashes:[16]u64;
    a:=np_audit(docs[..],sources[..],hashes[..]);#assert a.status==NpStatus.ok && a.paragraphs==7 && a.shared==0 && a.train_docs==3 && a.val_docs==2;
    #assert hashes[0]==NP_ORACLE_FNV[1] && np_fnv("a")==NP_ORACLE_FNV[0] && hashes[4]==np_fnv("theta\n") && hashes[2]==np_fnv("epsilon.");
    docs[3]="gamma\ndelta.\n\nmore held.";a=np_audit(docs[..],sources[..],hashes[..]);#assert a.status==NpStatus.leak && a.shared==1;
    docs[3]="gamma";a=np_audit(docs[..],sources[..],hashes[..]);#assert a.status==NpStatus.ok;
    docs[3]="\n\n\ngamma\ndelta.";a=np_audit(docs[..],sources[..],hashes[..]);#assert a.status==NpStatus.leak && a.shared==1;
    docs[3]="zeta eta.\n\nalpha beta.";a=np_audit(docs[..],sources[..],hashes[..]);#assert a.status==NpStatus.leak && a.shared==2;
    #assert np_audit(docs[..],sources[..],hashes[0..<5]).status==NpStatus.leak && np_audit(docs[..],sources[..],hashes[0..<4]).status==NpStatus.data;
    #assert np_audit(docs[..],sources[0..<4],hashes[..]).status==NpStatus.data;
    one:=[1]int.[8];#assert np_audit(docs[0..<1],one[..],hashes[..]).status==NpStatus.data;
    two:=[1]int.[3];#assert np_audit(docs[0..<1],two[..],hashes[..]).status==NpStatus.data;
    #assert np_holdout(0) && np_holdout(16) && !np_holdout(7) && !np_holdout(9);
}
#test "tokenizer from training samples only, and BOS-separated streams" {
    docs:=[4]string.["the cat sat on the mat.","a held out line","the dog sat on the log.","then the cat ran."];sources:=[4]int.[1,8,2,3];
    picks:[16]string;#assert np_samples(docs[..],sources[..],picks[..])==3 && picks[0]==docs[0] && picks[1]==docs[2] && picks[2]==docs[3];
    long:[300]u8;for i:0..<300 {long[i]='a'+cast(u8)(i%5);}docs[2]=cast(string)long[..];#assert np_samples(docs[..],sources[..],picks[..])==3 && picks[1].count==256 && picks[1]==docs[2][0..<256];
    docs[2]=cast(string)long[0..<256];#assert np_samples(docs[..],sources[..],picks[..])==3 && picks[1].count==256;
    docs[2]=cast(string)long[0..<257];#assert np_samples(docs[..],sources[..],picks[..])==3 && picks[1].count==256;
    seventeen:[17]string;ss:[17]int;for i:0..<17 {seventeen[i]=docs[0];ss[i]=1;}#assert np_samples(seventeen[..],ss[..],picks[..])==16;
    many:[40]string;ms:[40]int;for i:0..<40 {many[i]=docs[0];ms[i]=i+1;}many[17]=docs[3];
    #assert np_samples(many[..],ms[..],picks[..])==16 && picks[7]==docs[3] && picks[8]==docs[0];
    classes:=PT_TOY;packed:[65536]u8;scratch:[65536]u8;docs[2]="the dog sat on the log.";
    t:=np_tokenizer(classes[..],docs[..],sources[..],5,packed[..],scratch[..]);#assert t.status==NpStatus.ok && t.merges==5 && t.vocab==262;
    // The same table as chapter 123's trainer gives on the three training documents.
    three:=[3]string.[docs[0],docs[2],docs[3]];mm:=bt_train(classes[..],three[..],5);ref:[65536]u8;rw:=bt_pack(mm,classes[..],ref[..],scratch[..],false);
    #assert rw.written==t.written;for i:0..<t.written {#assert ref[i]==packed[i];}
    #assert np_tokenizer(classes[..],docs[..],sources[..],65,packed[..],scratch[..]).status==NpStatus.tokenizer;
    #assert np_tokenizer(classes[..],docs[..],sources[..],60,packed[..],scratch[..]).status==NpStatus.tokenizer;
    #assert np_tokenizer(classes[..],docs[..],sources[..],5,packed[0..<100],scratch[..]).status==NpStatus.tokenizer;
    #assert np_tokenizer(classes[..],docs[..],sources[0..<3],5,packed[..],scratch[..]).status==NpStatus.data;
    hashes:[16]u64;train:[64]int;val:[64]int;
    d:=np_data(packed[0..<t.written],docs[..],sources[..],261,hashes[..],train[..],val[..]);
    #assert d.status==NpStatus.ok && d.train_docs==3 && d.val_docs==1 && d.train_bytes==23+23+17 && d.val_bytes==15 && d.paragraphs==4;
    #assert train[0]==261 && val[0]==261 && d.train>3 && d.val>1;
    text:=bt_decode(packed[0..<t.written],val[1..<d.val]);#assert cast(string)text.bytes[0..<text.written]=="a held out line";
    bos:=0;for x:train[0..<d.train] {if x==261 {bos+=1;}}#assert bos==3;
    e0:=bt_encode(packed[0..<t.written],docs[0]);first:=bt_decode(packed[0..<t.written],train[1..<1+e0.written]);
    #assert cast(string)first.bytes[0..<first.written]==docs[0] && train[1+e0.written]==261;
    #assert np_data(packed[0..<t.written],docs[..],sources[..],261,hashes[..],train[0..<d.train-1],val[..]).status==NpStatus.data;
    #assert np_data(packed[0..<t.written],docs[..],sources[..],261,hashes[..],train[0..<d.train],val[0..<d.val-1]).status==NpStatus.data;
    #assert np_data(packed[0..<t.written],docs[..],sources[..],261,hashes[..],train[0..<d.train],val[0..<d.val]).status==NpStatus.ok;
    #assert np_data(packed[0..<10],docs[..],sources[..],261,hashes[..],train[..],val[..]).status==NpStatus.tokenizer;
    docs[1]="the cat sat on the mat.";#assert np_data(packed[0..<t.written],docs[..],sources[..],261,hashes[..],train[..],val[..]).status==NpStatus.leak;
    lengths:[300]int;for i:0..<300 {lengths[i]=7;}#assert np_lengths(packed[0..<t.written],261,lengths[..])==NpStatus.ok && lengths[0]==1 && lengths[255]==1 && lengths[261]==0 && lengths[299]==0;
    one:[1]int;for i:256..<261 {one[0]=i;r:=bt_decode(packed[0..<t.written],one[..]);#assert lengths[i]==r.written && r.written>=2;}
    #assert np_lengths(packed[0..<10],261,lengths[..])==NpStatus.tokenizer && np_lengths(packed[0..<t.written],261,lengths[0..<261])==NpStatus.data && np_lengths(packed[0..<t.written],261,lengths[0..<262])==NpStatus.ok;
}
#test "the first step's loss and gradient match chapter 127's oracle" #steps 2000000000 {
    c:=NP_ORACLE_MODEL;n:=nc_parameter_count(c);#assert n==NP_ORACLE_PARAMETERS;
    w:[48170]f64;np_init(c,NP_ORACLE_INIT,w[..]);g:[48170]f64;tape:[40000]f64;logits:[5120]f64;t:=NP_ORACLE_TOKENS;
    r:=nb_gradient(c,w[..],t[..],g[..],tape[0..<nb_tape_count(c,t.count)],logits[0..<t.count*c.vocab],false);#assert r.status==NcStatus.ok;
    #assert abs(r.loss-NP_ORACLE_LOSS)<=1e-13*NP_ORACLE_LOSS;
    d:[63]f64;#assert nb_digests(c,g[..],d[..])==63;
    for i:0..<63 {#assert nb_close(d[i],NP_ORACLE_DIGESTS[i],1e-10);}
    for i:0..<NP_ORACLE_SAMPLES.count {#assert nb_close(g[97*i],NP_ORACLE_SAMPLES[i],1e-10);}
    for i:0..<24 {#assert w[NP_ORACLE_PICKS[i]]==NP_ORACLE_WEIGHTS[i];}
}
#test "identities and the order match their independent values" #steps 1000000000 {
    p:=NP_TEST;#assert ck_equal(np_plan_id(p),NP_ORACLE_PLAN_ID);
    big:[9000]int;for i:0..<9000 {big[i]=i%320;}v:=[3]int.[7,8,9];#assert ck_equal(np_data_id(big[..],v[..]),NP_ORACLE_DATA_ID);
    bytes:[70000]u8;for i:0..<70000 {bytes[i]=cast(u8)(i%251);}zero:[32]u8;#assert ck_equal(np_fold(zero,bytes[..]),NP_ORACLE_FOLD);
    o:[6]int;o[5]=-1;for i:0..<10 {#assert np_window(p,5,i,o[..])==NP_ORACLE_ORDER[i];}#assert o[5]==1;
    o2:[6]int;o2[5]=-1;#assert np_window(p,5,7,o2[..])==NP_ORACLE_ORDER[7] && np_window(p,5,2,o2[..])==NP_ORACLE_ORDER[2] && o2[5]==0;
}
#test "steps descend, and a run cut and continued from a copy is bit-exact" #steps 4000000000 {
    p:=NP_TEST;c:=p.model;n:=nc_parameter_count(c);train:[40]int;for i:0..<40 {train[i]=(7*i*i+3*i)%11+20;}
    a:[10216]f64;am:[10216]f64;av:[10216]f64;np_init(c,p.init,a[..]);g:[10216]f64;total:[10216]f64;tape:[6000]f64;logits:[320]f64;
    order:[6]int;order[5]=-1;run:=NpRun.{};first:=0.0;last:=0.0;
    for s:0..<6 {r:=np_step(p,run,train[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);#assert r.status==NpStatus.ok && r.run.step==s+1 && r.run.state.step==s+1 && r.scale==np_scale(p,s);
        if s==0 {first=r.loss;}last=r.loss;run=r.run;}
    #assert last<first-0.5;
    // The same six steps, cut after three: fresh buffers holding a copy of
    // the run, parameters and moments continue bit for bit (the record that
    // carries them is checked below; the examples round-trip a whole model).
    b:[10216]f64;bm:[10216]f64;bv:[10216]f64;np_init(c,p.init,b[..]);o2:[6]int;o2[5]=-1;r2:=NpRun.{};
    for s:0..<3 {r2=np_step(p,r2,train[..],o2[..],b[..],bm[..],bv[..],g[..],total[..],tape[..],logits[..]).run;}
    x:=b;xm:=bm;xv:=bv;o3:[6]int;o3[5]=-1;r3:=NpRun.{step=r2.step,state=AwState.{step=r2.state.step}};
    for s:3..<6 {r3=np_step(p,r3,train[..],o3[..],x[..],xm[..],xv[..],g[..],total[..],tape[..],logits[..]).run;}
    #assert np_same(x[..],a[..]) && np_same(xm[..],am[..]) && np_same(xv[..],av[..]) && r3.step==6;
}
#test "the checkpoint record: layout by hand, and every change refuses" {
    pid:=NP_ORACLE_PLAN_ID;did:=NP_ORACLE_DATA_ID;w:=[3]f64.[1.5,-2,0];m:=[3]f64.[-0.25,0,3];v:=[3]f64.[0,0.5,7];run:=NpRun.{step=4,state=AwState.{step=4}};
    bytes:[204]u8;for i:0..<204 {bytes[i]=255;}#assert np_size(3)==204 && np_save(pid,did,run,w[..],m[..],v[..],bytes[..])==NpCheck.ok;
    #assert bytes[0]==80 && bytes[1]==83 && bytes[2]==80 && bytes[3]==84 && bytes[4]==1 && bytes[5]==0 && bytes[6]==0 && bytes[7]==0;
    #assert ck_equal(ck_get(bytes[..],8),pid) && ck_equal(ck_get(bytes[..],40),did) && ck_get64(bytes[..],72)==4 && ck_get64(bytes[..],80)==4 && ck_get64(bytes[..],88)==0 && ck_get32(bytes[..],96)==3;
    for i:0..<3 {#assert ck_get64(bytes[..],NP_HEAD+8*i)==f64_bits(w[i]) && ck_get64(bytes[..],NP_HEAD+24+8*i)==f64_bits(m[i]) && ck_get64(bytes[..],NP_HEAD+48+8*i)==f64_bits(v[i]);}
    zero:[32]u8;#assert ck_equal(ck_get(bytes[..],172),np_fold(zero,bytes[0..<172]));
    x:[3]f64;xm:[3]f64;xv:[3]f64;r:=np_read(pid,did,4,bytes[..],x[..],xm[..],xv[..]);
    #assert r.status==NpCheck.ok && r.run.step==4 && r.run.state.step==4 && r.run.state.skipped==0 && np_same(x[..],w[..]) && np_same(xm[..],m[..]) && np_same(xv[..],v[..]);
    keep:=[3]f64.[-1,-1,-1];x=keep;xm=keep;xv=keep;bad:=bytes;
    for i:0..<4 {bad=bytes;bad[i]^=2;#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.magic;}
    for i:4..<8 {bad=bytes;bad[i]^=2;#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.version;}
    bad=bytes;bad[120]^=1;#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.corrupt;
    bad=bytes;bad[203]^=128;#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.corrupt;
    #assert np_read(did,did,4,bytes[..],x[..],xm[..],xv[..]).status==NpCheck.plan && np_read(pid,pid,4,bytes[..],x[..],xm[..],xv[..]).status==NpCheck.data;
    #assert np_read(pid,did,3,bytes[..],x[..],xm[..],xv[..]).status==NpCheck.step;
    #assert np_read(pid,did,4,bytes[0..<203],x[..],xm[..],xv[..]).status==NpCheck.shape && np_read(pid,did,4,bytes[..],x[..],xm[0..<2],xv[..]).status==NpCheck.shape && np_read(pid,did,4,bytes[..],x[..],xm[..],xv[0..<2]).status==NpCheck.shape;
    // A record signed over impossible content still refuses.
    bad=bytes;bad[80]=3;np_sign(bad[..]);#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.step;
    bad=bytes;bad[88]=1;np_sign(bad[..]);#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.step;
    bad=bytes;bad[96]=2;np_sign(bad[..]);#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.shape;
    bad=bytes;bad[NP_HEAD+48+7]=128;bad[NP_HEAD+48+6]=16;np_sign(bad[..]);#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.number;
    bad=bytes;bad[NP_HEAD+64+7]|=128;np_sign(bad[..]);#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.number;
    bad=bytes;bad[NP_HEAD+6]=240;bad[NP_HEAD+7]=127;np_sign(bad[..]);#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.number;
    for i:0..<3 {#assert x[i]==-1 && xm[i]==-1 && xv[i]==-1;}
    // A negative first moment and a negative-zero second moment are values, not refusals.
    bad=bytes;bad[NP_HEAD+40+7]|=128;bad[NP_HEAD+48+7]|=128;np_sign(bad[..]);#assert np_read(pid,did,4,bad[..],x[..],xm[..],xv[..]).status==NpCheck.ok && xm[2]==-3 && f64_bits(xv[0])==0x8000000000000000;
    #assert np_read(pid,did,5,bytes[..],x[..],xm[..],xv[..]).status==NpCheck.ok;
    // np_resume first asks for the plan's model size: these three values are not it.
    #assert np_resume(NP_TEST,pid,did,bytes[..],x[..],xm[..],xv[..]).status==NpCheck.shape;
    // Saving refuses what it cannot record.
    #assert np_save(pid,did,run,w[..],m[..],v[..],bytes[0..<203])==NpCheck.shape && np_save(pid,did,run,w[..],m[0..<2],v[..],bytes[..])==NpCheck.shape && np_save(pid,did,run,w[..],m[..],v[0..<2],bytes[..])==NpCheck.shape;
    v[1]=-1;#assert np_save(pid,did,run,w[..],m[..],v[..],bytes[..])==NpCheck.number;v[1]=1.0/0.0;#assert np_save(pid,did,run,w[..],m[..],v[..],bytes[..])==NpCheck.number;
    v[1]=0;m[2]=1.0/0.0;#assert np_save(pid,did,run,w[..],m[..],v[..],bytes[..])==NpCheck.number;
    m[2]=0;w[2]=0.0/0.0;#assert np_save(pid,did,run,w[..],m[..],v[..],bytes[..])==NpCheck.number;
    w[2]=0;w[0]=1.0/0.0;#assert np_save(pid,did,run,w[..],m[..],v[..],bytes[..])==NpCheck.number;w[0]=1.5;
    w[2]=0;odd:=run;odd.state.step=3;#assert np_save(pid,did,odd,w[..],m[..],v[..],bytes[..])==NpCheck.step;
    odd=run;odd.state.skipped=1;#assert np_save(pid,did,odd,w[..],m[..],v[..],bytes[..])==NpCheck.step;
    // Plan and data identities see every field.
    p:=NP_TEST;q:=p;ids:[18][32]u8;for k:0..<18 {q=p;
        if k==1 {q.model.width=48;}if k==2 {q.batch=3;}if k==3 {q.steps=7;}if k==4 {q.warmup=1;}if k==5 {q.warmdown=1;}if k==6 {q.final=0.25;}
        if k==7 {q.embed=0.5;}if k==8 {q.matrix=0.5;}if k==9 {q.head=0.5;}if k==10 {q.scalar=0.5;}if k==11 {q.beta1=0.5;}if k==12 {q.beta2=0.5;}
        if k==13 {q.eps=0.5;}if k==14 {q.clip=0.5;}if k==15 {q.seed=99;}if k==16 {q.init=99;}if k==17 {q.budget=7;}
        ids[k]=np_plan_id(q);for j:0..<k {#assert !ck_equal(ids[j],ids[k]);}}
    for k:0..<9 {q=p;
        if k==1 {q.model.sequence_len=9;}if k==2 {q.model.vocab=321;}if k==3 {q.model.layers=2;}if k==4 {q.model.heads=4;}
        if k==5 {q.model.kv_heads=2;}if k==6 {q.model.pattern=1;}if k==7 {q.model.pattern_len=2;}if k==8 {q.model.context=9;}
        ids[k]=np_plan_id(q);for j:0..<k {#assert !ck_equal(ids[j],ids[k]);}}
    t:=[4]int.[1,2,3,4];#assert !ck_equal(np_data_id(t[0..<3],t[3..<4]),np_data_id(t[0..<2],t[2..<4]));
}
#test "a step refuses a bad batch and an optimizer refusal, and clips the norm" #steps 1000000000 {
    p:=NP_TEST;c:=p.model;train:[40]int;for i:0..<40 {train[i]=(5*i+1)%13;}
    a:[10216]f64;am:[10216]f64;av:[10216]f64;np_init(c,p.init,a[..]);g:[10216]f64;total:[10216]f64;tape:[6000]f64;logits:[320]f64;order:[6]int;order[5]=-1;
    r:=np_step(p,NpRun.{step=6,state=AwState.{step=6}},train[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);#assert r.status==NpStatus.config && r.run.step==6;
    t2:=train;for k:0..<5 {t2[8*k+3]=40;}r=np_step(p,NpRun.{},t2[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);#assert r.status==NpStatus.data;
    #assert np_step(p,NpRun.{},train[0..<15],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]).status==NpStatus.data;
    // AdamW refuses a state it cannot hold; nothing moves.
    keep:=a;r=np_step(p,NpRun.{state=AwState.{step=-1}},train[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);#assert r.status==NpStatus.optimizer && np_same(keep[..],a[..]);
    // Clipping: the step's gradient leaves with norm clip, or untouched below it; 0 turns it off.
    q:=p;q.clip=0.001;r=np_step(q,NpRun.{},train[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);
    s:=0.0;for x:total {s+=x*x;}#assert r.status==NpStatus.ok && r.norm>0.01 && abs(sqrt(s)-0.001)<1e-15;
    for q2:[2]f64.[0,1e6] {a=keep;for i:0..<10216 {am[i]=0;av[i]=0;}q.clip=q2;r=np_step(q,NpRun.{},train[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);
        s=0;for x:total {s+=x*x;}#assert r.status==NpStatus.ok && sqrt(s)==r.norm && !np_same(keep[..],a[..]);}
    #assert !np_same(keep[0..<2],keep[0..<3]);one:=[2]f64.[1,2];two:=[2]f64.[0,2];#assert !np_same(one[..],two[..]);
    // The first step by hand: windows o[0] and o[1] of epoch 0, each gradient halved and added in order.
    o:[6]int;o[5]=-1;w0:=np_window(p,5,0,o[..]);w1:=np_window(p,5,1,o[..]);want:[10216]f64;g1:[10216]f64;
    l0:=nb_gradient(c,keep[..],train[8*w0..<8*w0+8],g[..],tape[0..<nb_tape_count(c,8)],logits[..],false).loss;
    l1:=nb_gradient(c,keep[..],train[8*w1..<8*w1+8],g1[..],tape[0..<nb_tape_count(c,8)],logits[..],false).loss;
    s=0;for i:0..<10216 {want[i]=0;want[i]+=g[i]/2;want[i]+=g1[i]/2;s+=want[i]*want[i];}
    a=keep;for i:0..<10216 {am[i]=0;av[i]=0;}q.clip=0;order[5]=-1;r=np_step(q,NpRun.{},train[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);
    #assert r.loss==l0/2+l1/2 && r.norm==sqrt(s) && np_same(total[..],want[..]);
    // Clipping exactly at the norm scales nothing.
    a=keep;for i:0..<10216 {am[i]=0;av[i]=0;}q.clip=r.norm;r=np_step(q,NpRun.{},train[..],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]);#assert np_same(total[..],want[..]);
    // Exactly as many windows as the batch is enough.
    #assert np_step(p,NpRun.{},train[0..<16],order[..],a[..],am[..],av[..],g[..],total[..],tape[..],logits[..]).status==NpStatus.ok;
}
np_same :: (a:[]f64,b:[]f64)->bool {if a.count!=b.count {return false;}for i:0..<a.count {if f64_bits(a[i])!=f64_bits(b[i]) {return false;}}return true;}
// book:begin admit
np_flops :: (p:NpPlan)->f64 {return 6.0*f64(nc_parameter_count(p.model))*f64(p.steps)*f64(p.batch)*f64(p.model.sequence_len-1);}
np_unit :: (x:f64)->bool {return x>0 && x<=1;}
// Every refusal of a plan, before any work: the model, the window, the batch,
// the schedule, the rates, the optimizer, clipping, the data and the budget.
np_admit :: (p:NpPlan,windows:int)->NpStatus {
    c:=p.model;if !nc_valid(c) || c.context!=c.sequence_len {return NpStatus.config;}
    if p.batch<1 || p.batch>NP_BATCH || p.steps<1 || p.steps>NP_STEPS || p.warmup<0 || p.warmdown<0 || p.warmup+p.warmdown>p.steps {return NpStatus.config;}
    if !(p.final>=0 && p.final<=1) || !np_unit(p.embed) || !np_unit(p.matrix) || !np_unit(p.head) || !np_unit(p.scalar) {return NpStatus.config;}
    if !aw_beta(p.beta1) || !aw_beta(p.beta2) || !aw_eps(p.eps) || !(p.clip>=0) || !aw_finite(p.clip) {return NpStatus.config;}
    if windows<p.batch {return NpStatus.data;}
    if np_flops(p)>p.budget {return NpStatus.budget;}
    return NpStatus.ok;
}
// book:end admit
// book:begin schedule
// nanochat base_train's multiplier: (s+1)/warmup during warmup, 1, then
// over the last warmdown steps f + (1 - f) final with f = (steps - s)/warmdown.
np_scale :: (p:NpPlan,s:int)->f64 {
    if s<p.warmup {return f64(s+1)/f64(p.warmup);}
    if s+p.warmdown<=p.steps {return 1;}
    f:=f64(p.steps-s)/f64(p.warmdown);return f+(1-f)*p.final;
}
// The smaller of two integers, without a branch.
np_min :: (a:int,b:int)->int {return (a+b-cast(int)abs(f64(a-b)))/2;}
// Five AdamW groups in parameter order: the scalars, wte, every block's
// matrices and gates, lm_head, then smear_gate and the value embeddings.
np_groups :: (p:NpPlan,scale:f64,out:[]AwGroup) {
    c:=p.model;at:=[6]int.[0,nc_wte(c),nc_block(c,0).q,nc_head(c),nc_smear_gate(c),nc_parameter_count(c)];
    lr:=[5]f64.[p.scalar,p.embed,p.matrix,p.head,p.embed];
    for k:0..<5 {out[k]=AwGroup.{first=at[k],count=at[k+1]-at[k],lr=lr[k]*scale,beta1=p.beta1,beta2=p.beta2,eps=p.eps};}
}
// book:end schedule
// book:begin init
// Uniform draws from chapter 103's counter generator, one per flat index:
// p = offset + scale (2u - 1). Input matrices and value embeddings take
// scale sqrt(3/width) (standard deviation 1/sqrt(width)), wte sqrt(3)
// (deviation 1), lm_head 0.001 sqrt(3). Output projections and gates start
// at a tenth of the input scale, not at zero, so the first gradient reaches
// every matrix. resid 1, x0 0.1, smear 0.1, backout 0.2.
np_init :: (c:NcConfig,seed:u64,p:[]f64) {
    inv:[NC_TENSORS_MAX]NcTensor;n:=nc_inventory(c,inv[..]);s:=sqrt(3.0/f64(c.width));
    for k:0..<n {t:=inv[k];scale:=s;offset:=0.0;
        if t.kind==NcKind.resid {scale=0;offset=1;}if t.kind==NcKind.x0 || t.kind==NcKind.smear_lambda {scale=0;offset=0.1;}
        if t.kind==NcKind.backout {scale=0;offset=0.2;}if t.kind==NcKind.wte {scale=sqrt(3.0);}if t.kind==NcKind.head {scale=0.001*sqrt(3.0);}
        if t.kind==NcKind.proj || t.kind==NcKind.mlp || t.kind==NcKind.gate || t.kind==NcKind.smear_gate {scale=0.1*s;}
        for e:0..<nc_elements(t) {i:=t.offset+e;u:=f64(cr_bits(seed,cast(u64)i)>>11)/9007199254740992.0;p[i]=offset+scale*(2*u-1);}
    }
}
// book:end init

// book:begin split
np_holdout :: (source:int)->bool {return source%NP_HOLDOUT==0;}
// FNV-1a over one paragraph.
np_fnv :: (s:string)->u64 {h:=cast(u64)0xcbf29ce484222325;for i:0..<s.count {h=mul_wrap(h^cast(u64)s[i],cast(u64)0x100000001b3);}return h;}
// Paragraphs are the non-empty runs between blank lines ("\n\n"). Training
// paragraphs' hashes are kept; a held-out paragraph with the same hash is a
// shared paragraph, and any shared paragraph refuses the split.
np_audit :: (docs:[]string,sources:[]int,hashes:[]u64)->NpData {
    r:=NpData.{};if docs.count!=sources.count {r.status=NpStatus.data;return r;}
    kept:=0;
    for pass:0..<2 {
        for d:0..<docs.count {if np_holdout(sources[d])!=(pass==1) {continue;}
            if pass==0 {r.train_docs+=1;} else {r.val_docs+=1;}
            s:=docs[d];at:=0;
            while at<s.count {
                if s[at]==10 {at+=1;continue;}
                end:=at;while end<s.count && !(s[end]==10 && end+1<s.count && s[end+1]==10) {end+=1;}
                h:=np_fnv(s[at..<end]);r.paragraphs+=1;at=end;
                if pass==0 {if kept==hashes.count {r.status=NpStatus.data;return r;}hashes[kept]=h;kept+=1;}
                else {for k:0..<kept {if hashes[k]==h {r.shared+=1;}}}
            }
        }
    }
    if r.train_docs==0 || r.val_docs==0 {r.status=NpStatus.data;return r;}
    if r.shared>0 {r.status=NpStatus.leak;}
    return r;
}
// book:end split
// book:begin tokenizer
// Chapter 123's byte BPE, trained on samples of training documents only: up
// to 16 evenly spaced training documents, the first 256 bytes of each.
np_samples :: (docs:[]string,sources:[]int,out:[]string)->int {
    train:=0;for s:sources {if !np_holdout(s) {train+=1;}}
    k:=np_min(train,NP_SAMPLES);
    for j:0..<k {want:=j*train/k;seen:=0;
        for d:0..<docs.count {if !np_holdout(sources[d]) {if seen==want {s:=docs[d];out[j]=s[0..<np_min(s.count,NP_SAMPLE_BYTES)];}seen+=1;}}}
    return k;
}
np_tokenizer :: (classes:[]u8,docs:[]string,sources:[]int,merges:int,packed:[]u8,scratch:[]u8)->NpTok {
    if docs.count!=sources.count {return NpTok.{status=NpStatus.data};}
    picks:[16]string;k:=np_samples(docs,sources,picks[..]);
    m:=bt_train(classes,picks[0..<k],merges);if m.status!=PtStatus.ok || m.merges!=merges {return NpTok.{status=NpStatus.tokenizer};}
    w:=bt_pack(m,classes,packed,scratch,false);if w.status!=PtStatus.ok {return NpTok.{status=NpStatus.tokenizer};}
    return NpTok.{written=w.written,merges=m.merges,vocab=257+m.merges};
}
// Bytes per token ID; BOS (and anything past it) has none.
np_lengths :: (packed:[]u8,bos:int,out:[]int)->NpStatus {
    if out.count<=bos {return NpStatus.data;}
    for i:bos..<out.count {out[i]=0;}
    one:[1]int;for i:0..<bos {one[0]=i;r:=bt_decode(packed,one[..]);if r.status!=PtStatus.ok {return NpStatus.tokenizer;}out[i]=r.written;}
    return NpStatus.ok;
}
// The two streams: each document is BOS then its tokens, training sources
// into train and held-out sources into val, after the audit admits the split.
np_data :: (packed:[]u8,docs:[]string,sources:[]int,bos:int,hashes:[]u64,train:[]int,val:[]int)->NpData {
    r:=np_audit(docs,sources,hashes);if r.status!=NpStatus.ok {return r;}
    for d:0..<docs.count {e:=bt_encode(packed,docs[d]);if e.status!=PtStatus.ok {r.status=NpStatus.tokenizer;return r;}
        if np_holdout(sources[d]) {
            if r.val+1+e.written>val.count {r.status=NpStatus.data;return r;}
            val[r.val]=bos;for i:0..<e.written {val[r.val+1+i]=e.ids[i];}r.val+=1+e.written;r.val_bytes+=docs[d].count;
        } else {
            if r.train+1+e.written>train.count {r.status=NpStatus.data;return r;}
            train[r.train]=bos;for i:0..<e.written {train[r.train+1+i]=e.ids[i];}r.train+=1+e.written;r.train_bytes+=docs[d].count;
        }
    }
    return r;
}
// book:end tokenizer

// book:begin step
// Epoch e's order of the training windows: Fisher-Yates from the last
// position down, counters e*windows onwards. order[windows] remembers the epoch.
np_window :: (p:NpPlan,windows:int,g:int,order:[]int)->int {
    epoch:=g/windows;
    if order[windows]!=epoch {
        for i:0..<windows {order[i]=i;}
        for r:0..<windows-1 {i:=windows-1-r;j:=cast(int)(cr_bits(p.seed,cast(u64)(epoch*windows+r))%cast(u64)(i+1));t:=order[i];order[i]=order[j];order[j]=t;}
        order[windows]=epoch;
    }
    return order[g%windows];
}
// One optimizer step: the mean loss and gradient over batch windows, the
// global norm, clipping, the scheduled rates and AdamW.
np_step :: (p:NpPlan,run:NpRun,train:[]int,order:[]int,w:[]f64,m:[]f64,v:[]f64,g:[]f64,total:[]f64,tape:[]f64,logits:[]f64)->NpStep {
    c:=p.model;L:=c.sequence_len;windows:=train.count/L;n:=w.count;fail:=NpStep.{run=run};
    if run.step>=p.steps {fail.status=NpStatus.config;return fail;}
    if windows<p.batch {fail.status=NpStatus.data;return fail;}
    for i:0..<n {total[i]=0;}loss:=0.0;k:=f64(p.batch);
    for j:0..<p.batch {at:=np_window(p,windows,run.step*p.batch+j,order)*L;
        r:=nb_gradient(c,w,train[at..<at+L],g,tape[0..<nb_tape_count(c,L)],logits[0..<L*c.vocab],false);
        if r.status!=NcStatus.ok {fail.status=NpStatus.data;return fail;}
        for i:0..<n {total[i]+=g[i]/k;}loss+=r.loss/k;
    }
    sum:=0.0;for x:total {sum+=x*x;}norm:=sqrt(sum);
    if p.clip>0 && norm>p.clip {for i:0..<n {total[i]=total[i]*p.clip/norm;}}
    scale:=np_scale(p,run.step);groups:[5]AwGroup;np_groups(p,scale,groups[..]);none:[1]f32;
    a:=aw_step(groups[..],AwPolicy.{},run.state,w,total,m,v,none[0..<0],false);
    if a.status!=AwStatus.ok {fail.status=NpStatus.optimizer;return fail;}
    return NpStep.{run=NpRun.{step=run.step+1,state=a.state},loss=loss,norm=norm,scale=scale};
}
// book:end step

// book:begin eval
// Held-out bits per byte over the first `windows` windows of val: the
// negative log probability of every target that has bytes (BOS has none),
// in nats, over ln 2 times those targets' bytes.
np_eval :: (c:NcConfig,w:[]f64,val:[]int,lengths:[]int,windows:int,cache:[]f64,work:[]f64,logits:[]f64)->NpEval {
    L:=c.sequence_len;V:=c.vocab;r:=NpEval.{};if windows<1 || windows*L>val.count {r.status=NpStatus.data;return r;}
    none:[1]f64;
    for k:0..<windows {t:=val[k*L..<k*L+L];
        f:=nc_forward(c,w,t,cache,work,logits,none[0..<0],false);if f.status!=NcStatus.ok {r.status=NpStatus.number;return r;}
        for i:0..<L-1 {y:=t[i+1];b:=lengths[y];
            // The softcap keeps every logit within 15, so exp needs no shift.
            if b>0 {z:=i*V;sum:=0.0;for x:0..<V {sum+=exp(logits[z+x]);}r.nats+=log(sum)-logits[z+y];r.bytes+=b;r.targets+=1;}
        }
    }
    r.bpb=r.nats/(log(2.0)*f64(r.bytes));return r;
}
// The same targets under counts from the training stream: unigram with
// add-one smoothing, and bigram with add-k for each k of NP_K, the best kept.
// counts holds V*V pair counts, V token counts and V row totals.
np_baselines :: (c:NcConfig,train:[]int,val:[]int,lengths:[]int,windows:int,counts:[]f64)->NpBase {
    V:=c.vocab;L:=c.sequence_len;r:=NpBase.{};
    if counts.count<V*V+2*V || windows*L>val.count {r.status=NpStatus.data;return r;}
    U:=V*V;R:=U+V;for i:0..<V*V+2*V {counts[i]=0;}
    for i:0..<train.count {counts[U+train[i]]+=1;if i+1<train.count {counts[train[i]*V+train[i+1]]+=1;counts[R+train[i]]+=1;}}
    uni:=0.0;bi:[6]f64;bytes:=0;
    for k:0..<windows {for i:0..<L-1 {x:=val[k*L+i];y:=val[k*L+i+1];
        if lengths[y]>0 {bytes+=lengths[y];uni-=log((counts[U+y]+1)/(f64(train.count)+f64(V)));
            for j:0..<6 {a:=NP_K[j];bi[j]-=log((counts[x*V+y]+a)/(counts[R+x]+a*f64(V)));}}
    }}
    // Ties keep the larger k.
    d:=log(2.0)*f64(bytes);r.unigram=uni/d;r.bigram=1e308;
    for j:0..<6 {if bi[j]/d<r.bigram {r.bigram=bi[j]/d;r.k=NP_K[j];}}
    return r;
}
// book:end eval

// book:begin checkpoint
// The record: "PSPT" u16 version=1 u16 0; the plan identity and the data
// identity (32 bytes each); the step, AdamW's step and skip counters (u64);
// n (u32); n parameters, n first moments, n second moments (binary64 bits);
// then a digest of everything before it, folded over 32 KiB blocks.
np_plan_id :: (p:NpPlan)->[32]u8 {
    c:=p.model;w:=[22]u64.[cast,trunc(u64)c.sequence_len,cast,trunc(u64)c.vocab,cast,trunc(u64)c.layers,cast,trunc(u64)c.heads,cast,trunc(u64)c.kv_heads,cast,trunc(u64)c.width,
        cast(u64)c.pattern,cast,trunc(u64)c.pattern_len,cast,trunc(u64)c.context,cast,trunc(u64)p.batch,cast,trunc(u64)p.steps,cast,trunc(u64)p.warmup,cast,trunc(u64)p.warmdown,
        f64_bits(p.final),f64_bits(p.embed),f64_bits(p.matrix),f64_bits(p.head),f64_bits(p.scalar),f64_bits(p.beta1),f64_bits(p.beta2),f64_bits(p.eps),f64_bits(p.clip)];
    b:[200]u8;at:=0;for x:w {at=ck_put64(b[..],at,x);}at=ck_put64(b[..],at,p.seed);at=ck_put64(b[..],at,p.init);at=ck_put64(b[..],at,f64_bits(p.budget));
    return ck_digest("psionic.pretrain-plan.v1",b[0..<at]);
}
// Folds bytes into a running digest, 32 KiB at a time.
np_fold :: (d:[32]u8,bytes:[]u8)->[32]u8 {
    out:=d;at:=0;buf:[32800]u8;
    while at<bytes.count {k:=np_min(bytes.count-at,32768);for i:0..<32 {buf[i]=out[i];}for i:0..<k {buf[32+i]=bytes[at+i];}
        out=ck_digest("psionic.pretrain-fold.v1",buf[0..<32+k]);at+=k;}
    return out;
}
// The data identity: both streams, as u32 values, with their lengths.
np_data_id :: (train:[]int,val:[]int)->[32]u8 {
    d:[32]u8;head:[16]u8;h:=ck_put64(head[..],0,cast,trunc(u64)train.count);h=ck_put64(head[..],h,cast,trunc(u64)val.count);d=np_fold(d,head[0..<h]);
    buf:[32768]u8;
    for part:0..<2 {s:=train;if part==1 {s=val;}at:=0;
        while at<s.count {k:=np_min(s.count-at,8192);q:=0;for i:0..<k {q=ck_put32(buf[..],q,s[at+i]);}d=np_fold(d,buf[0..<q]);at+=k;}}
    return d;
}
np_sign :: (b:[]u8) {d:[32]u8;d=np_fold(d,b[0..<b.count-32]);for i:0..<32 {b[b.count-32+i]=d[i];}}
np_save :: (plan:[32]u8,data:[32]u8,run:NpRun,w:[]f64,m:[]f64,v:[]f64,out:[]u8)->NpCheck {
    n:=w.count;if m.count!=n || v.count!=n || out.count!=np_size(n) {return NpCheck.shape;}
    if run.state.step!=run.step || run.state.skipped!=0 {return NpCheck.step;}
    for i:0..<n {if !aw_finite(w[i]) || !aw_finite(m[i]) || !aw_finite(v[i]) || v[i]<0 {return NpCheck.number;}}
    out[0]=80;out[1]=83;out[2]=80;out[3]=84;out[4]=1;out[5]=0;out[6]=0;out[7]=0;
    at:=ck_put(out,8,plan);at=ck_put(out,at,data);at=ck_put64(out,at,cast,trunc(u64)run.step);
    at=ck_put64(out,at,cast,trunc(u64)run.state.step);at=ck_put64(out,at,cast,trunc(u64)run.state.skipped);at=ck_put32(out,at,n);
    for i:0..<n {at=ck_put64(out,at,f64_bits(w[i]));}for i:0..<n {at=ck_put64(out,at,f64_bits(m[i]));}for i:0..<n {at=ck_put64(out,at,f64_bits(v[i]));}
    np_sign(out);return NpCheck.ok;
}
// Admits the whole record against the plan and data it must belong to, then
// writes the values. A refusal writes nothing.
np_resume :: (p:NpPlan,plan:[32]u8,data:[32]u8,bytes:[]u8,w:[]f64,m:[]f64,v:[]f64)->NpRead {
    if w.count!=nc_parameter_count(p.model) {return NpRead.{status=NpCheck.shape};}
    return np_read(plan,data,p.steps,bytes,w,m,v);
}
// The record itself, for n = w.count values and a run of at most steps.
np_read :: (plan:[32]u8,data:[32]u8,steps:int,bytes:[]u8,w:[]f64,m:[]f64,v:[]f64)->NpRead {
    n:=w.count;if m.count!=n || v.count!=n || bytes.count!=np_size(n) {return NpRead.{status=NpCheck.shape};}
    if !ck_magic(bytes,80,84) {return NpRead.{status=NpCheck.magic};}
    if bytes[4]!=1 || bytes[5]!=0 || bytes[6]!=0 || bytes[7]!=0 {return NpRead.{status=NpCheck.version};}
    d:[32]u8;d=np_fold(d,bytes[0..<bytes.count-32]);if !ck_equal(d,ck_get(bytes,bytes.count-32)) {return NpRead.{status=NpCheck.corrupt};}
    if !ck_equal(ck_get(bytes,8),plan) {return NpRead.{status=NpCheck.plan};}
    if !ck_equal(ck_get(bytes,40),data) {return NpRead.{status=NpCheck.data};}
    step:=ck_get64(bytes,72);t:=ck_get64(bytes,80);skipped:=ck_get64(bytes,88);
    if step>cast(u64)steps || t!=step || skipped!=0 {return NpRead.{status=NpCheck.step};}
    if ck_get32(bytes,96)!=n {return NpRead.{status=NpCheck.shape};}
    for i:0..<3*n {if !ck_bits(ck_get64(bytes,NP_HEAD+8*i),i>=2*n) {return NpRead.{status=NpCheck.number};}}
    for i:0..<n {w[i]=f64_from_bits(ck_get64(bytes,NP_HEAD+8*i));m[i]=f64_from_bits(ck_get64(bytes,NP_HEAD+8*(n+i)));v[i]=f64_from_bits(ck_get64(bytes,NP_HEAD+8*(2*n+i)));}
    s:=cast(int)step;return NpRead.{run=NpRun.{step=s,state=AwState.{step=s}}};
}
// book:end checkpoint

// The checks' plan: one block of width 24 over a 40-token vocabulary,
// windows of 8, two windows a step for six steps.
NP_TEST :: NpPlan.{model=NcConfig.{sequence_len=8,vocab=40,layers=1,heads=2,kv_heads=1,width=24,pattern=0,pattern_len=1,context=8},
    batch=2,steps=6,warmup=2,warmdown=2,final=0.5,embed=0.05,matrix=0.02,head=0.02,scalar=0.01,beta1=0.8,beta2=0.95,eps=1e-10,clip=1,seed=5,init=11,budget=1e12};
