// Chapter 163: the whole Nemotron Nano model. The embedding, the 42 layers
// in the order the pattern names them, the final norm and the readout in
// chunks of NH_READOUT_ROWS rows; one request's memory (each Mamba-2
// layer's history and state, each attention layer's keys and values); the
// prompt in chunks, then greedy decoding one token at a time from that
// memory. Every layer is nemotron-h.coax's; the profile stays
// nemotron-h-cpu-f64-v1.
#load "nemotron-h.coax";

// book:begin model
// One layer's weights; only the view its kind names is used.
NhLayer :: struct { kind:int; mamba:NhMamba; attention:NhAttention; mlp:NhMlp; }
// The embedding (vocab x hidden), the layers in order, the final norm and
// the readout (vocab x hidden, separate from the embedding), read rows rows
// at a time, at most NH_READOUT_ROWS.
NhModel :: struct { shape:NhShape; pattern:string; embed:[]f32; layers:[]NhLayer; norm:[]f32; head:[]f32; rows:int; }
NH_READOUT_ROWS :: 32768;
// One request's memory for capacity positions: every Mamba-2 layer's
// history and state, every attention layer's keys and values, one layer
// after another in the order the layers come.
NhCache :: struct { capacity:int; history:[]f32; state:[]f32; keys:[]f32; values:[]f32; }
nh_history_size :: (s:NhShape,mambas:int)->int {return mambas*3*ss_channels(s.ssm);}
nh_state_size :: (s:NhShape,mambas:int)->int {return mambas*ss_states(s.ssm);}
nh_keys_size :: (s:NhShape,attentions:int,capacity:int)->int {return attentions*capacity*s.kv_heads*s.attn_dim;}
nh_model_valid :: (m:NhModel)->bool {
    s:=m.shape;p:=nh_pattern(s,m.pattern);
    if p.status!=NhStatus.ok || m.layers.count!=s.layers || s.vocab<1 {return false;}
    for i:0..<s.layers {if m.layers[i].kind!=nh_kind(m.pattern,i) {return false;}}
    if m.rows<1 || m.rows>NH_READOUT_ROWS {return false;}
    return m.embed.count==s.vocab*s.hidden && m.norm.count==s.hidden && m.head.count==s.vocab*s.hidden;
}
nh_cache_valid :: (m:NhModel,c:NhCache)->bool {
    s:=m.shape;p:=nh_pattern(s,m.pattern);
    if c.capacity<1 || c.history.count!=nh_history_size(s,p.counts[NH_MAMBA]) || c.state.count!=nh_state_size(s,p.counts[NH_MAMBA]) {return false;}
    return c.keys.count==nh_keys_size(s,p.counts[NH_ATTENTION],c.capacity) && c.values.count==c.keys.count;
}
// A new request starts from zero history, state, keys and values.
nh_clear :: (c:NhCache) {
    ss_clear(c.history,c.state);
    for i:0..<c.keys.count {c.keys[i]=0;c.values[i]=0;}
}
// f32 and f64 work for tokens rows at once in chunks of chunk.
// Each layer kind takes its work from the front, so the sum covers all.
nh_model_work :: (s:NhShape,tokens:int)->int {return nh_mamba_work(s,tokens)+nh_attention_work(s)+nh_mlp_work(s);}
nh_model_fwork :: (s:NhShape,chunk:int,capacity:int)->int {return ss_work_count(s.ssm,chunk)+capacity;}
// book:end model

// book:begin layer
// Layer `layer` on tokens rows of hidden at positions start, start + 1, ...
// Its memory is the slot of its kind: the number of earlier layers of the
// same kind.
nh_slot :: (pattern:string,layer:int)->int {
    n:=0;for i:0..<layer {if pattern[i]==pattern[layer] {n+=1;}}
    return n;
}
nh_layer :: (m:NhModel,c:NhCache,layer:int,tokens:int,start:int,chunk:int,hidden:[]f32,work:[]f32,fwork:[]f64)->NhResult {
    s:=m.shape;w:=m.layers[layer];k:=nh_slot(m.pattern,layer);
    if w.kind==NH_MAMBA {
        hs:=3*ss_channels(s.ssm);ns:=ss_states(s.ssm);
        return nh_mamba(s,w.mamba,tokens,chunk,hidden,c.history[k*hs..<(k+1)*hs],c.state[k*ns..<(k+1)*ns],work,fwork);
    }
    if w.kind==NH_ATTENTION {
        size:=c.capacity*s.kv_heads*s.attn_dim;
        return nh_attention(s,w.attention,tokens,start,hidden,c.keys[k*size..<(k+1)*size],c.values[k*size..<(k+1)*size],work,fwork);
    }
    return nh_mlp(s,w.mlp,tokens,hidden,work);
}
// book:end layer

// book:begin readout
// The final norm and the whole readout for one hidden row, m.rows rows at
// a time; the last chunk takes what is left. Returns the index of the
// largest logit, the lowest on a tie, or -1 when the arithmetic fails.
nh_logits :: (m:NhModel,hidden:[]f32,logits:[]f32,normed:[]f32)->int {
    v:=m.shape.vocab;
    if m.rows<1 || logits.count!=v {return -1;}
    best:int;chunks:=v/m.rows;
    if chunks*m.rows<v {chunks+=1;}
    for k:0..<chunks {
        first:=k*m.rows;n:=ifx k==chunks-1 then v-first else m.rows;
        b:=nh_readout(m.norm,m.head,hidden,first,logits[first..<first+n],normed);
        if b<0 {return -1;}
        if k==0 || logits[first+b]>logits[best] {best=first+b;}
    }
    return best;
}
// book:end readout

// book:begin forward
// The outcome of one pass: the largest logit of the last token (best), or
// the refusal, the layer that refused (-1 before the layers) and, for an
// embedding refusal, the offending token's index.
NhRun :: struct { status:NhStatus; layer:int; at:int; best:int; ssm:SsStatus; }
// tokens at positions start, start + 1, ... through the whole model, in
// chunks of chunk for the Mamba-2 layers. hidden holds the tokens' rows
// (tokens x hidden) and is left as the last layer wrote it; logits holds
// the last token's logits.
nh_forward :: (m:NhModel,c:NhCache,tokens:[]int,start:int,chunk:int,hidden:[]f32,logits:[]f32,work:[]f32,fwork:[]f64)->NhRun {
    if !nh_model_valid(m) || !nh_cache_valid(m,c) {return NhRun.{status=NhStatus.shape,layer=-1};}
    s:=m.shape;h:=s.hidden;n:=tokens.count;
    if n<1 || start<0 || start+n>c.capacity || hidden.count!=n*h || logits.count!=s.vocab {return NhRun.{status=NhStatus.capacity,layer=-1};}
    if work.count<nh_model_work(s,n) || fwork.count<nh_model_fwork(s,chunk,c.capacity) {return NhRun.{status=NhStatus.capacity,layer=-1};}
    for t:0..<n {
        id:=tokens[t];
        if id<0 || id>=s.vocab {return NhRun.{status=NhStatus.token,layer=-1,at=t};}
        for i:0..<h {hidden[t*h+i]=m.embed[id*h+i];}
    }
    for layer:0..<s.layers {
        r:=nh_layer(m,c,layer,n,start,chunk,hidden,work,fwork);
        if r.status!=NhStatus.ok {return NhRun.{status=r.status,layer=layer,ssm=r.ssm};}
    }
    best:=nh_logits(m,hidden[(n-1)*h..<n*h],logits,work[0..<h]);
    if best<0 {return NhRun.{status=NhStatus.arithmetic,layer=s.layers};}
    return NhRun.{best=best};
}
// book:end forward

// book:begin greedy
// Greedy decoding: the prompt at once in chunks of chunk, then each chosen
// token fed back one at a time from the cache, steps tokens in all. The
// cache must be cleared by the caller and hold prompt + steps - 1
// positions. hidden holds the prompt's rows. out[i] is the i-th token chosen.
nh_greedy :: (m:NhModel,c:NhCache,prompt:[]int,steps:int,chunk:int,out:[]int,hidden:[]f32,logits:[]f32,work:[]f32,fwork:[]f64)->NhRun {
    p:=prompt.count;h:=m.shape.hidden;
    if steps<1 || out.count<steps || p+steps-1>c.capacity || hidden.count!=p*h {return NhRun.{status=NhStatus.capacity,layer=-1};}
    r:=nh_forward(m,c,prompt,0,chunk,hidden,logits,work,fwork);
    if r.status!=NhStatus.ok {return r;}
    out[0]=r.best;
    for i:1..<steps {
        r=nh_forward(m,c,out[i-1..<i],p+i-1,1,hidden[0..<h],logits,work,fwork);
        if r.status!=NhStatus.ok {return r;}
        out[i]=r.best;
    }
    return r;
}
// book:end greedy

// ---- checks ----------------------------------------------------------------

// The checks' whole model: chapter 163's small shape (nho_shape) with six
// layers, M - * M * -, each with its own weights; a vocabulary of 9.
NHM_PATTERN :: "M-*M*-";
NHM_CAPACITY :: 8;
NhmRig :: struct { weights:[4284]f32; embed:[54]f32; norm:[6]f32; head:[54]f32; layers:[6]NhLayer;
    history:[120]f32; state:[48]f32; keys:[128]f32; values:[128]f32; }
nhm_shape :: ()->NhShape {s:=nho_shape();s.layers=6;return s;}
nhm_weights :: (r:[]NhmRig,l:int)->[]f32 {return r[0].weights[l*714..<(l+1)*714];}
nhm_rig :: (r:[]NhmRig,seed:int) {
    for l:0..<6 {w:=nho_weights(seed+l);for i:0..<714 {r[0].weights[l*714+i]=w[i];}}
    nho_fill(r[0].embed[..],seed+40,1);nho_fill(r[0].head[..],seed+41,1);nho_fill(r[0].norm[..],seed+42,0.5);
    for i:0..<6 {r[0].norm[i]+=1;}
}
// The model's views into a rig.
nhm_model :: (r:[]NhmRig)->NhModel {
    for l:0..<6 {
        a:=nhm_weights(r,l);
        r[0].layers[l]=NhLayer.{kind=nh_kind(NHM_PATTERN,l),mamba=nho_mamba_view(a),attention=nho_attention_view(a),mlp=nho_mlp_view(a)};
    }
    return NhModel.{shape=nhm_shape(),pattern=NHM_PATTERN,embed=r[0].embed[..],layers=r[0].layers[..],norm=r[0].norm[..],head=r[0].head[..],rows=4};
}
nhm_cache :: (r:[]NhmRig)->NhCache {
    return NhCache.{capacity=NHM_CAPACITY,history=r[0].history[..],state=r[0].state[..],keys=r[0].keys[..],values=r[0].values[..]};
}
// The whole model as binary64 from the oracle's layers, for 7 tokens: the
// last token's logits. Each layer's oracle takes the previous layer's
// result narrowed to f32.
nhm_oracle :: (r:[]NhmRig,tokens:[]int)->[9]f64 {
    hidden:[42]f32;
    for t:0..<7 {for i:0..<6 {hidden[t*6+i]=r[0].embed[tokens[t]*6+i];}}
    ref:[42]f64;
    for l:0..<6 {
        a:=nhm_weights(r,l);k:=nh_kind(NHM_PATTERN,l);
        if k==NH_MAMBA {ref=nho_mamba(a,hidden[..]);}
        if k==NH_ATTENTION {ref=nho_attention(a,hidden[..]);}
        if k==NH_MLP {ref=nho_mlp(a,hidden[..]);}
        for i:0..<42 {hidden[i]=f32(ref[i]);}
    }
    last:[6]f64;for i:0..<6 {last[i]=ref[36+i];}
    n:[6]f64;nho_rms(last[..],r[0].norm[..],n[..]);
    out:[9]f64;nho_matvec(r[0].head[..],n[..],out[..]);
    return out;
}
NHM_TOKENS :: [7]int.[3,1,4,1,5,8,2];
NHM_WORK :: 473;

// book:begin checks-model
#test "the whole small model matches the oracle's layers chained" #steps 200000000 {
    for seed:0..<3 {
        rig:[1]NhmRig;r:=rig[..];nhm_rig(r,seed);m:=nhm_model(r);c:=nhm_cache(r);
        for chunk:1..<8 {
            nh_clear(c);hidden:[42]f32;logits:[9]f32;work:[NHM_WORK]f32;fwork:[2000]f64;tokens:=NHM_TOKENS;
            run:=nh_forward(m,c,tokens[..],0,chunk,hidden[..],logits[..],work[..],fwork[..]);
            ref:=nhm_oracle(r,tokens[..]);g:=nho_gap(logits[..],ref[..]);
            #assert run.status==NhStatus.ok && g.gap<=g.limit;
            best:=0;for i:1..<9 {if ref[i]>ref[best] {best=i;}}
            #assert run.best==best;
        }
    }
}
#test "greedy decoding from the cache equals recomputing the whole sequence, bit for bit" #steps 200000000 {
    rig:[1]NhmRig;r:=rig[..];nhm_rig(r,1);m:=nhm_model(r);c:=nhm_cache(r);
    for chunk:1..<4 {
        // Prompt of 4 in chunks of chunk, then 4 tokens chosen one at a time.
        nh_clear(c);prompt:=[4]int.[3,1,4,1];out:[4]int;hidden:[24]f32;logits:[9]f32;work:[NHM_WORK]f32;fwork:[2000]f64;
        need:=nh_model_fwork(m.shape,chunk,NHM_CAPACITY);
        run:=nh_greedy(m,c,prompt[..],4,chunk,out[..],hidden[..],logits[..],work[..],fwork[0..<need]);
        #assert run.status==NhStatus.ok && run.best==out[3];
        last:=logits;
        // The first choice is the prompt's own last logits.
        nh_clear(c);#assert nh_forward(m,c,prompt[..],0,chunk,hidden[..],logits[..],work[..],fwork[..]).best==out[0];
        // The prompt and the first three choices, 7 tokens, in one pass from
        // an empty cache: its last logits choose the fourth token.
        all:=[7]int.[3,1,4,1,out[0],out[1],out[2]];whole:[42]f32;again:[9]f32;
        nh_clear(c);run=nh_forward(m,c,all[..],0,1,whole[..],again[..],work[..],fwork[..]);
        #assert run.status==NhStatus.ok && run.best==out[3];
        // With chunks of one token the two are the same arithmetic.
        if chunk==1 {#assert nho_same(last[..],again[..]);}
        ref:=nhm_oracle(r,all[..]);g:=nho_gap(last[..],ref[..]);#assert g.gap<=g.limit;
        // The cache holds the eighth position untouched.
        for i:7*8..<8*8 {#assert r[0].keys[i]==0 && r[0].values[i]==0;}
    }
    // A pass resumed after 4 tokens equals 7 tokens at once in chunks of 4.
    tokens:=NHM_TOKENS;work:[NHM_WORK]f32;fwork:[2000]f64;
    nh_clear(c);whole:[42]f32;a:[9]f32;
    #assert nh_forward(m,c,tokens[..],0,4,whole[..],a[..],work[..],fwork[..]).status==NhStatus.ok;
    keys:=r[0].keys;state:=r[0].state;
    nh_clear(c);split:[42]f32;b:[9]f32;
    #assert nh_forward(m,c,tokens[0..<4],0,4,split[0..<24],b[..],work[..],fwork[..]).status==NhStatus.ok;
    #assert nh_forward(m,c,tokens[4..<7],4,4,split[24..<42],b[..],work[..],fwork[..]).status==NhStatus.ok;
    #assert nho_same(a[..],b[..]) && nho_same(whole[36..<42],split[36..<42]) && nho_same(keys[..],r[0].keys[..]) && nho_same(state[..],r[0].state[..]);
    // Clearing empties all four parts of the cache.
    nh_clear(c);
    for i:0..<128 {#assert r[0].keys[i]==0 && r[0].values[i]==0;}
    for i:0..<48 {#assert r[0].state[i]==0;}
    for i:0..<120 {#assert r[0].history[i]==0;}
}
// book:end checks-model
#test "the readout in chunks finds the largest logit, the first on a tie" {
    rig:[1]NhmRig;r:=rig[..];nhm_rig(r,0);m:=nhm_model(r);hidden:=[6]f32.[1,-2,0.5,3,-1,2];normed:[6]f32;
    #assert m.rows==4;
    #assert r[0].head[1]==nho_value(41,1) && r[0].embed[1]==nho_value(40,1) && r[0].norm[1]==nho_value(42,1)*0.5+1;
    w:=m;w.rows=9;whole:[9]f32;b9:=nh_logits(w,hidden[..],whole[..],normed[..]);#assert b9>=0;
    for rows:1..<12 {
        w.rows=rows;part:[9]f32;b:=nh_logits(w,hidden[..],part[..],normed[..]);
        #assert nho_same(part[..],whole[..]) && b==b9;
    }
    // Rows 2 and 7 equal and largest: the first wins across chunks of 4.
    for i:0..<54 {r[0].head[i]=0;}
    for i:0..<6 {r[0].head[2*6+i]=1;r[0].head[7*6+i]=1;r[0].head[8*6+i]=0.5;}
    ones:=[6]f32.[1,1,1,1,1,1];
    #assert nh_logits(m,ones[..],whole[..],normed[..])==2;w.rows=1;#assert nh_logits(w,ones[..],whole[..],normed[..])==2;
    // Row 7 larger than row 2: a later chunk's largest replaces an earlier one.
    r[0].head[7*6]=2;#assert nh_logits(m,ones[..],whole[..],normed[..])==7;
    // Only row 0 is largest: the first chunk keeps it.
    for i:0..<54 {r[0].head[i]=-1;}for i:0..<6 {r[0].head[i]=0;}
    #assert nh_logits(m,ones[..],whole[..],normed[..])==0;
    // Row 8 alone in the last chunk of 1 is largest.
    r[0].head[8*6]=5;#assert nh_logits(m,ones[..],whole[..],normed[..])==8;
    w.rows=0;#assert nh_logits(w,hidden[..],whole[..],normed[..])==-1;
    #assert nh_logits(m,hidden[..],whole[0..<8],normed[..])==-1;
    r[0].head[50]=3e38;r[0].head[51]=3e38;
    #assert nh_logits(m,ones[..],whole[..],normed[..])==-1;
}
#test "slots count the earlier layers of the same kind" {
    #assert nh_slot("M-*M*-",0)==0 && nh_slot("M-*M*-",3)==1 && nh_slot("M-*M*-",4)==1 && nh_slot("M-*M*-",5)==1 && nh_slot("M-*M*-",2)==0;
    s:=nh_nano();
    #assert nh_slot(NH_NANO_PATTERN,41)==16 && nh_slot(NH_NANO_PATTERN,40)==20 && nh_slot(NH_NANO_PATTERN,12)==0;
    #assert nh_history_size(s,21)==21*29184 && nh_state_size(s,21)==21*983040 && nh_keys_size(s,4,16)==4*16*1024;
    #assert nh_model_work(nhm_shape(),7)==NHM_WORK && nh_model_fwork(s,6,16)==ss_work_count(s.ssm,6)+16;
}

// book:begin checks-refusals
#test "the whole model refuses a bad model, cache, token or size before it writes" #steps 200000000 {
    rig:[1]NhmRig;r:=rig[..];nhm_rig(r,2);m:=nhm_model(r);c:=nhm_cache(r);
    tokens:=NHM_TOKENS;hidden:[42]f32;logits:[9]f32;work:[NHM_WORK]f32;fwork:[2000]f64;
    nh_clear(c);
    #assert nh_forward(m,c,tokens[..],0,4,hidden[..],logits[..],work[..],fwork[..]).status==NhStatus.ok;
    // A token outside the vocabulary names its index.
    bad:=tokens;bad[5]=9;run:=nh_forward(m,c,bad[..],0,4,hidden[..],logits[..],work[..],fwork[..]);
    #assert run.status==NhStatus.token && run.at==5 && run.layer==-1;
    bad[5]=-1;#assert nh_forward(m,c,bad[..],0,4,hidden[..],logits[..],work[..],fwork[..]).at==5;
    bad[5]=8;bad[0]=-1;run=nh_forward(m,c,bad[..],0,4,hidden[..],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.token && run.at==0;
    // The model: a pattern, a layer of the wrong kind, short tables, rows.
    w:=m;w.pattern="M-*M*M";run=nh_forward(w,c,tokens[..],0,4,hidden[..],logits[..],work[..],fwork[..]);
    #assert run.status==NhStatus.shape && run.layer==-1;
    w=m;w.pattern="M-*M*";#assert !nh_model_valid(w);
    kinds:=r[0].layers;kinds[0].kind=NH_MLP;w=m;w.layers=kinds[..];#assert !nh_model_valid(w);
    w=m;w.layers=m.layers[0..<5];#assert !nh_model_valid(w);
    w=m;w.embed=m.embed[0..<53];#assert !nh_model_valid(w);
    w=m;w.norm=m.norm[0..<5];#assert !nh_model_valid(w);
    w=m;w.head=m.head[0..<53];#assert !nh_model_valid(w);
    w=m;w.shape.vocab=0;w.embed=m.embed[0..<0];w.head=m.head[0..<0];#assert !nh_model_valid(w);
    w=m;w.shape.vocab=1;w.embed=m.embed[0..<6];w.head=m.head[0..<6];#assert nh_model_valid(w);
    w=m;w.rows=0;#assert !nh_model_valid(w);w.rows=1;#assert nh_model_valid(w);
    w.rows=NH_READOUT_ROWS;#assert nh_model_valid(w);w.rows=NH_READOUT_ROWS+1;#assert !nh_model_valid(w);
    #assert nh_model_valid(m);
    // The cache: each part one value short, and no capacity.
    for k:0..<5 {
        d:=c;
        if k==0 {d.history=c.history[0..<119];}
        if k==1 {d.state=c.state[0..<47];}
        if k==2 {d.keys=c.keys[0..<127];}
        if k==3 {d.values=c.values[0..<127];}
        if k==4 {d.capacity=0;d.keys=c.keys[0..<0];d.values=c.values[0..<0];}
        #assert !nh_cache_valid(m,d) && nh_forward(m,d,tokens[..],0,4,hidden[..],logits[..],work[..],fwork[..]).status==NhStatus.shape;
    }
    one:=c;one.capacity=1;one.keys=c.keys[0..<16];one.values=c.values[0..<16];#assert nh_cache_valid(m,one);
    // Three Mamba-2 layers, one attention layer and two MLP layers need
    // their own sizes.
    w=m;w.pattern="MM*M--";big:[200]f32;
    e:=NhCache.{capacity=8,history=big[0..<180],state=big[0..<72],keys=big[0..<64],values=big[64..<128]};#assert nh_cache_valid(w,e);
    f:=e;f.history=big[0..<120];#assert !nh_cache_valid(w,f);
    f=e;f.state=big[0..<48];#assert !nh_cache_valid(w,f);
    f=e;f.keys=big[0..<128];f.values=big[0..<128];#assert !nh_cache_valid(w,f);
    // Sizes: no tokens, past the cache, rows, logits, work.
    run=nh_forward(m,c,tokens[0..<0],0,4,hidden[0..<0],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.capacity && run.layer==-1;
    run=nh_forward(m,c,tokens[..],2,4,hidden[..],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.capacity && run.layer==-1;
    #assert nh_forward(m,c,tokens[..],1,4,hidden[..],logits[..],work[..],fwork[..]).status==NhStatus.ok;
    run=nh_forward(m,c,tokens[..],-1,4,hidden[..],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.capacity && run.layer==-1;
    #assert nh_forward(m,c,tokens[..],0,4,hidden[0..<36],logits[..],work[..],fwork[..]).status==NhStatus.capacity;
    #assert nh_forward(m,c,tokens[..],0,4,hidden[..],logits[0..<8],work[..],fwork[..]).status==NhStatus.capacity;
    run=nh_forward(m,c,tokens[..],0,4,hidden[..],logits[..],work[0..<NHM_WORK-1],fwork[..]);#assert run.status==NhStatus.capacity && run.layer==-1;
    need:=nh_model_fwork(m.shape,4,8);
    #assert nh_forward(m,c,tokens[..],0,4,hidden[..],logits[..],work[..],fwork[0..<need-1]).status==NhStatus.capacity;
    #assert nh_forward(m,c,tokens[..],0,4,hidden[..],logits[..],work[..],fwork[0..<need]).status==NhStatus.ok;
    // A layer's refusal names the layer: chunk 0 is chapter 162's range.
    run=nh_forward(m,c,tokens[..],0,0,hidden[..],logits[..],work[..],fwork[..]);
    #assert run.status==NhStatus.recurrence && run.layer==0 && run.ssm==SsStatus.range;
    // An MLP that overflows is layer 1's arithmetic.
    for i:654..<684 {r[0].weights[714+i]=3e38;}
    run=nh_forward(m,c,tokens[..],0,4,hidden[..],logits[..],work[..],fwork[..]);
    #assert run.status==NhStatus.arithmetic && run.layer==1;
    nhm_rig(r,2);
    // A readout that overflows is reported past the last layer.
    for i:0..<54 {r[0].head[i]=3e38;}
    run=nh_forward(m,c,tokens[..],0,4,hidden[..],logits[..],work[..],fwork[..]);
    #assert run.status==NhStatus.arithmetic && run.layer==6;
    // Greedy decoding: no steps, too few outputs, a cache too short, rows;
    // nothing is chosen.
    nhm_rig(r,2);prompt:=[4]int.[3,1,4,1];out:=[6]int.[-7,-7,-7,-7,-7,-7];h4:[24]f32;
    run=nh_greedy(m,c,prompt[..],0,4,out[..],h4[..],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.capacity && run.layer==-1;
    #assert nh_greedy(m,c,prompt[..],5,4,out[0..<4],h4[..],logits[..],work[..],fwork[..]).status==NhStatus.capacity;
    run=nh_greedy(m,c,prompt[..],6,4,out[..],h4[..],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.capacity && out[0]==-7;
    #assert nh_greedy(m,c,prompt[..],4,4,out[..],h4[0..<18],logits[..],work[..],fwork[..]).status==NhStatus.capacity && out[0]==-7;
    nh_clear(c);run=nh_greedy(m,c,prompt[..],1,4,out[0..<1],h4[..],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.ok && run.best==out[0];
    nh_clear(c);run=nh_greedy(m,c,prompt[..],5,4,out[0..<5],h4[..],logits[..],work[..],fwork[..]);
    #assert run.status==NhStatus.ok && run.best==out[4];
    // A refusal on the way comes back as it is: a token, then a later step.
    nh_clear(c);bad4:=[4]int.[3,1,40,1];
    run=nh_greedy(m,c,bad4[..],2,4,out[..],h4[..],logits[..],work[..],fwork[..]);#assert run.status==NhStatus.token && run.at==2;
    // With a readout of zeros every token ties and token 0 is chosen. Only
    // token 0's row has a first value, and layer 0's in_proj multiplies it
    // by 3e38, so the prompt passes and the first decoding step refuses.
    nhm_rig(r,2);nh_clear(c);for i:0..<54 {r[0].head[i]=0;}
    for t:0..<9 {r[0].embed[t*6]=0;}r[0].embed[0]=1;for k:0..<32 {r[0].weights[6+k*6]=3e38;}
    run=nh_greedy(m,c,prompt[..],3,4,out[..],h4[..],logits[..],work[..],fwork[..]);
    #assert run.status==NhStatus.arithmetic && run.layer==0 && out[0]==0;
}
// book:end checks-refusals
