// Bounded experimental readout-edit proposals; no quality authority.
#load "../../coax/lib/json/json.coax";
#authority;
OpProposal :: struct {valid:bool;analysis:int;final:int;alpha:int;}
#test "readout proposals are exactly three bounded JSON integers" {
    r:=op_parse("[1,2,-4]");#assert r.valid && r.analysis==1 && r.final==2 && r.alpha==-4;
    r=op_parse("[0,0,4]");#assert r.valid && r.analysis==0 && r.final==0 && r.alpha==4;
    #assert op_parse("[2,1,0]").valid;
    bad:=[12]string.["[]","{}","[1,1]","[1,1,0,0]","[1.0,1,0]","[true,1,0]","[-1,1,0]","[3,1,0]","[1,-1,0]","[1,3,0]","[1,1,-5]","[1,1,5]"];
    for text:bad {p:=op_parse(text);#assert !p.valid && p.analysis==0 && p.final==0 && p.alpha==0;}
    #assert !op_parse("[1,1,0] prose").valid && !op_parse("[1,\"1\",0]").valid && !op_parse("[1,1,0.0]").valid;
    #assert !op_parse("{\"a\":0,\"b\":0,\"c\":0}").valid;
}
op_parse :: (text:string)->OpProposal #export_c {
    d:[1]Jv;nodes:[16]JvNode;r:OpProposal;
    if !jv_parse(d[..],text,nodes[..]) || jv_kind(d[0],0)!=JV_ARRAY || jv_len(d[0],0)!=3 {return r;}
    a:=jv_int(d[0],jv_at(d[0],0,0),-1);b:=jv_int(d[0],jv_at(d[0],0,1),-1);c:=jv_int(d[0],jv_at(d[0],0,2),-5);
    if a<0 || a>2 || b<0 || b>2 || c< -4 || c>4 {return r;}return OpProposal.{valid=true,analysis=a,final=b,alpha=c};
}
