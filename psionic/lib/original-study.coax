#test "answer matching removes formatting, never invents missing final answers" {
    #assert os_match(" **391**.\n","391") && os_match("PARIS!","paris") && !os_match("not Paris","paris") && !os_match("","391");
    #assert !os_match("17*23=391","391") && os_match("H2O","h2o") && os_match("H₂O","h2o");
    ids:=[9]int.[1,2,3,1,2,3,1,2,3];#assert os_repeat(ids[..])==3;#assert os_repeat(ids[0..<5])==0;
}
os_match :: (text:string,answer:string)->bool {
    b:[4096]u8;n:=0;at:=0;while at<text.count {v:=text[at];at+=1;
        if v==226 && at+1<text.count && text[at]==130 && text[at+1]>=128 && text[at+1]<=137 {v=48+text[at+1]-128;at+=2;}
        if v>=65 && v<=90 {v+=32;}if (v>=97 && v<=122) || (v>=48 && v<=57) || v=='-' {b[n]=v;n+=1;}}
    return cast(string)b[0..<n]==answer;
}
os_primary :: (which:int)->bool {return which>=36;}
os_repeat :: (ids:[]int)->int {
    best:=0;for span:3..<17 {if ids.count<3*span {continue;}
        for start:0..<ids.count-3*span+1 {same:=true;for i:0..<span {if ids[start+i]!=ids[start+span+i] || ids[start+i]!=ids[start+2*span+i] {same=false;}}
            if same && span>best {best=span;}
        }
    }return best;
}
os_reference :: (which:int)->string {
    if which==6 {return "Paris";}if which==8 {return "Tokyo";}if which==10 {return "CAT";}if which==11 {return "H2O";}
    if which==24 {return "Rome";}if which==25 {return "Berlin";}if which==26 {return "Madrid";}if which==27 {return "Ottawa";}
    if which==32 {return "DOG";}if which==33 {return "BLUE";}if which==34 {return "Au";}return OS_CASES[which].answer;
}
// Admitted rectangular matrices only: rows*cols == p.count <= 16384.
// book:begin rank
os_rank :: (p:[]f64,rows:int,cols:int,u:[]f64,v:[]f64,alpha:f64)->[16384]f64 {
    out:[16384]f64;for row:0..<rows {for col:0..<cols {out[row*cols+col]=p[row*cols+col]+alpha*u[row]*v[col];}}return out;
}
os_remove :: (p:[]f64,rows:int,cols:int,direction:[]f64)->[16384]f64 {
    u:[16384]f64;den:=0.0;for x:direction {den+=x*x;}#assert den>0;
    for row:0..<rows {for col:0..<cols {u[row]+=p[row*cols+col]*direction[col]/den;}}
    return os_rank(p,rows,cols,u[0..<rows],direction,-1);
}
// book:end rank
#test "rank-one removal equals projecting out the same activation direction" {
    p:=[4]f64.[1,2,3,4];d:=[2]f64.[1,0];r:=os_remove(p[..],2,2,d[..]);
    #assert r[0]==0 && r[1]==2 && r[2]==0 && r[3]==4;
    #assert r[0]*5+r[1]*6==12 && r[2]*5+r[3]*6==24;
    #assert p[0]*0+p[1]*6==12 && p[2]*0+p[3]*6==24;
}
