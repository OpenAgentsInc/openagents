// Parakeet's Metal encoder arithmetic, with a C/VM CPU meaning for checks.
// Products use Apple's Coax matrix primitives (wd_linear); the remaining
// kernels are kernels.coax's plain f32, which the CUDA profile (cuda.coax)
// shares. This is a tolerance-qualified device profile, not the
// compensated-binary64 CPU profile. The host only binds and launches these.
#load "../whisper/device.coax";
#load "kernels.coax";
