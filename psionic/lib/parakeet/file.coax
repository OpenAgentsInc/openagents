// Bounded offline Parakeet files. Windows share the global resampling phase,
// not model state. Cue times are TDT emission bounds, not word alignment.
#load "../whisper/wav.coax";
#load "../whisper/segments.coax";
#load "backend.coax";
#authority;

PKFILE_MIN :: 320;
PKFILE_MAX :: 327520;
PKFILE_WINDOWS :: 4096;
PkFileWindow :: struct {ok:bool;offset:int;count:int;}
PkFileSpan :: struct {ok:bool;start:int;end:int;}
PkFileOptions :: struct {ok:bool;gpu:bool;format:int;dump:int= -1;}

#test "Parakeet file windows cover short tails exactly without artificial padding" {
 tails:=[6]int.[0,1,319,320,321,327519];
 for k:0..<12 {for tail:tails {
  total:=k*PKFILE_MAX+tail;parts:=pkfile_chunks(total);
  if total<320 {#assert parts== -1;continue;}
  #assert parts>=1 && parts<=13;at:=0;
  for i:0..<parts {w:=pkfile_window(total,i);#assert w.ok && w.offset==at && w.count>=320 && w.count<=327520;at+=w.count;}
  #assert at==total && !pkfile_window(total,-1).ok && !pkfile_window(total,parts).ok;
 }}
 w:=pkfile_window(327521,0);#assert w.offset==0 && w.count==327201;
 w=pkfile_window(327521,1);#assert w.offset==327201 && w.count==320;
 #assert pkfile_window(655041,0).count==327520 && pkfile_window(655041,1).count==327201 && pkfile_window(655041,2).count==320;
 #assert pkfile_chunks(2880003)==9 && pkfile_window(2880003,8).offset==2620160 && pkfile_window(2880003,8).count==259843;
 #assert pkfile_chunks(-1)== -1 && pkfile_chunks(0)== -1 && pkfile_chunks(319)== -1;
 #assert pkfile_chunks(PKFILE_MAX*PKFILE_WINDOWS)==PKFILE_WINDOWS && pkfile_chunks(PKFILE_MAX*PKFILE_WINDOWS+1)== -1;
}
#test "Parakeet file emission bounds preserve fractional global offsets and repeated frames" {
 a:=[3]int.[0,0,1];s:=pkfile_span(327521,327201,320,1,a[0..<2]);
 #assert s.ok && s.start==327201 && s.end==327521;
 last:=[1]int.[255];s=pkfile_span(327520,0,327520,256,last[..]);#assert s.ok && s.start==326400 && s.end==327520;
 #assert pkfile_ms(s.end)==20470 && pkfile_ms(327201)==20450;
 #assert !pkfile_span(327521,327201,320,1,a[..]).ok;
 a[0]= -1;#assert !pkfile_span(327520,0,327520,256,a[0..<1]).ok;
 a[0]=2;a[1]=1;#assert !pkfile_span(327520,0,327520,256,a[0..<2]).ok;
 #assert !pkfile_span(327520,0,327520,257,last[..]).ok;
 #assert !pkfile_span(327520,1,327520,256,last[..]).ok;
 empty:[1]int;s=pkfile_span(320,0,320,1,empty[0..<0]);#assert s.ok && s.start==0 && s.end==0;
}
#test "Parakeet file parser versions outputs and never silently changes a named device" {
 args:=[8]string.["engine","transcribe","model","audio.wav","--gpu","--json","--dump-prefix","out"];
 o:=pkfile_options(args[..]);#assert o.ok && o.gpu && o.format==3 && o.dump==7;
 args[5]="--srt";#assert pkfile_options(args[0..<6]).format==1;
 args[5]="--vtt";#assert pkfile_options(args[0..<6]).format==2;
 args[5]="--text";#assert pkfile_options(args[0..<6]).format==0;
 #assert pkfile_options(args[0..<4]).ok && !pkfile_options(args[0..<4]).gpu;
 #assert !pkfile_options(args[0..<3]).ok;args[5]="--cuda";#assert !pkfile_options(args[..]).ok;
 args[4]="--json";args[5]="--text";#assert !pkfile_options(args[0..<6]).ok;
 args[4]="--gpu";args[5]="--cpu";#assert !pkfile_options(args[0..<6]).ok;
 args[1]="decode";#assert !pkfile_options(args[..]).ok;
 #assert pkfile_dumps(1,7) && pkfile_dumps(9,-1) && !pkfile_dumps(2,7);
}
#test "Parakeet file WAV windows preserve samples and reject truncated or misaligned data" {
 file:[108]u8;wv_header(file[..],1,2,16000,16,64);
 for i:0..<16 {wv_put16(file[..],44+i*4,1000+i);wv_put16(file[..],46+i*4,3000+i);}
 info:=pkfile_wav_info(file[..]);#assert info.status==WvStatus.ok && info.frames==16;
 out:[5]f32;table:[WV_TABLE]f64;wv_table(table[..]);
 #assert pkfile_audio(file[..],3,table[..],out[..])==5;
 for i:0..<5 {#assert out[i]==cast(f32)(cast(f64)(2003+i)/32768.0);}
 #assert pkfile_audio(file[..],12,table[..],out[..])== -1;
 #assert pkfile_wav_info(file[0..<107]).status!=WvStatus.ok;
 wv_put32(file[..],40,63);#assert pkfile_wav_info(file[..]).status!=WvStatus.ok;
}
#test "Parakeet file writers keep exact token offsets and escape literal transcript bytes" {
 out:[4096]u8;tok:=[2]int.[7,9];frames:=[2]int.[0,0];
 n:=pkfile_render(3,0,0,327521,327201,320,1,tok[..],frames[..],"x\"\ny",out[..]);
 #assert n>0 && cast(string)out[0..<n]=="{\"sample_offset\":327201,\"samples\":320,\"start\":20.450,\"end\":20.470,\"text\":\"x\\\"\\ny\",\"tokens\":[7,9],\"frames\":[0,0],\"token_samples\":[327201,327201]}";
 n=pkfile_render(1,0,4,327521,327201,320,1,tok[..],frames[..],"word",out[..]);
 #assert cast(string)out[0..<n]=="5\n00:00:20,450 --> 00:00:20,470\nword\n\n";
 n=pkfile_render(2,0,0,320,0,320,1,tok[..],frames[..],"word",out[..]);#assert n>0;
 n=pkfile_render(0,0,0,320,0,320,1,tok[..],frames[..],"",out[..]);#assert n==0;
 #assert pkfile_render(3,0,0,320,0,320,1,tok[..],frames[..],"x",out[0..<1])== -1;
 #assert !pkfile_publish(1,2,false) && !pkfile_publish(2,2,true) && pkfile_publish(2,2,false);
 tok[0]=8192;#assert pkfile_render(3,0,0,320,0,320,1,tok[..],frames[..],"x",out[..])== -1;
 #assert pkfile_cues(4,"")==4 && pkfile_cues(4,"word")==5;
}
#test "Parakeet file JSON framing preserves the legacy single-window snapshots" {
 out:[4096]u8;table:[WV_TABLE]f64;#assert pkfile_table(table[..]) && !pkfile_table(table[0..<1]);
 n:=pkfile_begin(2,320,PK_DEVICE_METAL,out[..]);#assert cast(string)out[0..<n]=="WEBVTT\n\n";
 #assert pkfile_begin(0,320,PK_DEVICE_CPU,out[..])==0 && pkfile_begin(3,320,PK_DEVICE_METAL,out[..])>0;
 #assert pkfile_begin(3,320,PK_DEVICE_CPU,out[0..<1])== -1;
 n=pkfile_json_text("a\"b",true,out[..]);#assert cast(string)out[0..<n]==" a\\\"b";
 #assert pkfile_json_text("",false,out[..])==0 && pkfile_json_text("x",false,out[0..<1])== -1;
 tok:=[1]int.[7];frames:=[1]int.[0];n=pkfile_json_tail(320,2,1,tok[..],frames[..],out[..]);
 #assert cast(string)out[0..<n]=="\",\"feature_frames\":2,\"encoded_frames\":1,\"token_count\":1,\"tokens\":[7],\"frames\":[0],\"complete\":true}\n";
 n=pkfile_json_tail(327521,2,1,tok[..],frames[..],out[..]);#assert cast(string)out[0..<n]=="\",\"complete\":true}\n";
 #assert pkfile_json_tail(320,2,1,tok[..],frames[..],out[0..<1])== -1;
 #assert pkfile_begin(-1,320,PK_DEVICE_METAL,out[..])== -1 && pkfile_begin(4,320,PK_DEVICE_METAL,out[..])== -1 && pkfile_begin(0,319,PK_DEVICE_METAL,out[..])== -1;
 n=pkfile_json_middle(out[..]);#assert cast(string)out[0..<n]=="],\"text\":\"";
}
#test "Parakeet file JSON names the device that ran, and refuses an unknown one" {
 out:[4096]u8;head:="{\"schema\":\"openagents.parakeet.file.v1\",\"model\":\"nvidia/parakeet-tdt-0.6b-v3\",\"revision\":\"541d1f99c6b0c3cd0b11a95167540bb8edefd82b\",\"backend\":";
 tail:=",\"sample_rate\":16000,\"samples\":320,\"timing\":\"TDT emission frames:1280 samples; not acoustic word alignment\",\"segments\":[";
 names:=[3]string.["\"cpu-exact\",\"device\":\"cpu\"","\"metal\",\"device\":\"apple-metal\"","\"cuda\",\"device\":\"nvidia-cuda\""];
 for device:0..<3 {n:=pkfile_begin(3,320,device,out[..]);#assert n==head.count+names[device].count+tail.count;
  #assert cast(string)out[0..<head.count]==head && cast(string)out[head.count..<head.count+names[device].count]==names[device] && cast(string)out[n-tail.count..<n]==tail;}
 for bad:[3]int.[-1,3,7] {for format:0..<4 {#assert pkfile_begin(format,320,bad,out[..])== -1;}}
}
#test "Parakeet file global resampling phase equals the existing full-file oracle" {
 file:[4140]u8;mono:[1024]f32;full:[1024]f32;part:[251]f32;table:[WV_TABLE]f64;wv_table(table[..]);
 for rate:[2]int.[44100,48000] {
  wv_header(file[..],1,2,rate,16,4096);
  for i:0..<1024 {wv_put16(file[..],44+i*4,(i*91)%32768);wv_put16(file[..],46+i*4,(i*37)%32768);}
  info:=wv_info(file[..]);#assert wv_mono(file[..],info,mono[..])==1024;
  n:=wv_resample(mono[..],rate,table[..],full[..]);#assert n>=251;
  #assert pkfile_audio(file[..],17,table[..],part[..])==251;
  for i:0..<251 {#assert f32_bits(part[i])==f32_bits(full[17+i]);}
 }
}

pkfile_chunks :: (samples:int)->int #export_c {
 if samples<PKFILE_MIN || samples>PKFILE_MAX*PKFILE_WINDOWS {return -1;}
 return (samples+PKFILE_MAX-1)/PKFILE_MAX;
}
pkfile_window :: (samples:int,index:int)->PkFileWindow #export_c {
 parts:=pkfile_chunks(samples);if parts<1 || index<0 || index>=parts {return PkFileWindow.{};}
 tail:=samples-(parts-1)*PKFILE_MAX;borrow:=ifx parts>1 && tail<PKFILE_MIN then PKFILE_MIN-tail else 0;
 offset:=index*PKFILE_MAX;count:=PKFILE_MAX;
 if index==parts-2 {count-=borrow;}
 if index==parts-1 {offset-=borrow;count=tail+borrow;}
 return PkFileWindow.{ok=true,offset=offset,count=count};
}
pkfile_options :: (args:[]string)->PkFileOptions #export_c {
 o:=PkFileOptions.{};if args.count<4 || args[1]!="transcribe" || args[2]=="" || args[3]=="" {return o;}
 seen_format:=false;seen_device:=false;i:=4;
 while i<args.count {
  s:=args[i];i+=1;
  if s=="--gpu" || s=="--cpu" {if seen_device {return o;}seen_device=true;o.gpu=s=="--gpu";}
  else if s=="--text" || s=="--srt" || s=="--vtt" || s=="--json" {
   if seen_format {return o;}seen_format=true;o.format=ifx s=="--srt" then 1 else ifx s=="--vtt" then 2 else ifx s=="--json" then 3 else 0;
  }else if s=="--dump-prefix" {if o.dump>=0 || i==args.count || args[i]=="" {return o;}o.dump=i;i+=1;}
  else {return o;}
 }
 o.ok=true;return o;
}
// Stricter file orchestration than the legacy recorder-recovery WAV reader:
// a missing physical tail cannot become a successfully completed transcript.
pkfile_wav_info :: (file:[]u8)->WvInfo #export_c {
 bad:=WvInfo.{status=WvStatus.data};if file.count<12 || wg_u32(file,4)!=file.count-8 {return bad;}
 r:=wv_info(file);if r.status!=WvStatus.ok {return r;}
 at:=12;while at+8<=file.count {
  size:=wg_u32(file,at+4);body:=at+8;if size>file.count-body {return bad;}
  if cast(string)file[at..<at+4]=="data" {if size%(r.channels*(r.bits/8))!=0 {return bad;}return r;}
  at=body+size+(size&1);
 }
 return bad;
}
pkfile_length :: (info:WvInfo)->int #export_c {if info.status!=WvStatus.ok || info.frames<0 || info.frames>4294967295 || info.rate<1000 || info.rate>384000 {return -1;}return wv_length(info.frames,info.rate);}
pkfile_table :: (out:[]f64)->bool #export_c {if out.count<WV_TABLE {return false;}wv_table(out);return true;}
pkfile_mono :: (file:[]u8,info:WvInfo,index:int)->f32 {
 bytes:=info.bits/8;at:=info.at+index*bytes*info.channels;sum:=0.0;
 for c:0..<info.channels {sum+=wv_sample(file,at+c*bytes,info.format,info.bits);}
 v:=sum/cast(f64)info.channels;
 return cast(f32)(ifx v>1 then 1.0 else ifx v>= -1 then v else -1.0);
}
pkfile_audio :: (file:[]u8,offset:int,table:[]f64,out:[]f32)->int #export_c {
 info:=pkfile_wav_info(file);total:=pkfile_length(info);
 if info.status!=WvStatus.ok || offset<0 || out.count>total || offset>total-out.count || table.count<WV_TABLE {return -1;}
 if info.rate==16000 {for i:0..<out.count {out[i]=pkfile_mono(file,info,offset+i);}return out.count;}
 fc:=WV_CUTOFF*(ifx info.rate>16000 then 16000.0/cast(f64)info.rate else 1.0);reach:=cast(int)(cast(f64)WV_ZEROS/fc)+1;step:=cast(f64)info.rate/16000.0;
 for t:0..<out.count {
  p:=cast(f64)(offset+t)*step;c:=cast(int)p;sum:=0.0;weight:=0.0;
  lo:=ifx c-reach+1<0 then 0 else c-reach+1;hi:=ifx c+reach+1>info.frames then info.frames else c+reach+1;
  for j:lo..<hi {u:=abs(p-cast(f64)j)*fc*cast(f64)WV_STEPS;k:=cast(int)u;if k+1>=WV_TABLE {continue;}f:=u-cast(f64)k;h:=table[k]+(table[k+1]-table[k])*f;sum+=h*cast(f64)pkfile_mono(file,info,j);weight+=h;}
  v:=ifx weight>0 then sum/weight else 0.0;out[t]=cast(f32)(ifx v>1 then 1.0 else ifx v< -1 then -1.0 else v);
 }
 return out.count;
}
pkfile_ms :: (sample:int)->int #export_c {return sample/16;}
pkfile_span :: (total:int,offset:int,count:int,encoded:int,frames:[]int)->PkFileSpan #export_c {
 r:=PkFileSpan.{};if pkfile_chunks(total)<1 || offset<0 || count<320 || count>327520 || count>total || offset>total-count || encoded!=(count/160+7)/8 {return r;}
 previous:= -1;
 for frame:frames {if frame<previous || frame<0 || frame>=encoded || frame*1280>=count {return r;}previous=frame;}
 r.ok=true;r.start=offset;r.end=offset;if frames.count==0 {return r;}
 r.start=offset+frames[0]*1280;r.end=offset+(frames[frames.count-1]+1)*1280;
 if r.end>offset+count {r.end=offset+count;}return r;
}
pkfile_publish :: (completed:int,expected:int,cancelled:bool)->bool #export_c {return expected>0 && completed==expected && !cancelled;}
pkfile_cues :: (prior:int,text:string)->int #export_c {return prior+ifx text=="" then 0 else 1;}
pkfile_dumps :: (parts:int,dump:int)->bool #export_c {return dump<0 || parts==1;}

// device is PK_DEVICE_CPU, _METAL or _CUDA: the one the engine actually ran on.
pkfile_begin :: (format:int,total:int,device:int,out:[]u8)->int #export_c {
 if format<0 || format>3 || pkfile_chunks(total)<1 || !pk_device_known(device) {return -1;}
 w:[1]WsOut;w[0].buf=out;
 if format==2 {wsg_put(w[..],"WEBVTT\n\n");}
 else if format==3 {
  wsg_put(w[..],"{\"schema\":\"openagents.parakeet.file.v1\",\"model\":\"nvidia/parakeet-tdt-0.6b-v3\",\"revision\":\"541d1f99c6b0c3cd0b11a95167540bb8edefd82b\",\"backend\":");wsg_quoted(w[..],pk_backend_name(device));
  wsg_put(w[..],",\"device\":");wsg_quoted(w[..],pk_device_name(device));wsg_put(w[..],",\"sample_rate\":16000,\"samples\":");wsg_digits(w[..],total,1);wsg_put(w[..],",\"timing\":\"TDT emission frames:1280 samples; not acoustic word alignment\",\"segments\":[");
 }
 return ifx w[0].full then -1 else w[0].n;
}
pkfile_render :: (format:int,index:int,cue:int,total:int,offset:int,count:int,encoded:int,tokens:[]int,frames:[]int,text:string,out:[]u8)->int #export_c {
 span:=pkfile_span(total,offset,count,encoded,frames);if !span.ok || tokens.count!=frames.count || (text.count>0 && frames.count==0) {return -1;}
 for token:tokens {if token<0 || token>=8192 {return -1;}}
 w:[1]WsOut;w[0].buf=out;
 if format==0 {if text!="" {wsg_put(w[..],text);wsg_byte(w[..],10);}}
 else if format==1 || format==2 {
  if text!="" {
   if format==1 {wsg_digits(w[..],cue+1,1);wsg_byte(w[..],10);}
   wsg_clock(w[..],pkfile_ms(span.start),ifx format==1 then ',' else '.');wsg_put(w[..]," --> ");wsg_clock(w[..],pkfile_ms(span.end),ifx format==1 then ',' else '.');wsg_byte(w[..],10);wsg_put(w[..],text);wsg_put(w[..],"\n\n");
  }
 }else if format==3 {
  if index>0 {wsg_byte(w[..],',');}wsg_put(w[..],"{\"sample_offset\":");wsg_digits(w[..],offset,1);wsg_put(w[..],",\"samples\":");wsg_digits(w[..],count,1);
  wsg_put(w[..],",\"start\":");wsg_seconds(w[..],pkfile_ms(span.start));wsg_put(w[..],",\"end\":");wsg_seconds(w[..],pkfile_ms(span.end));wsg_put(w[..],",\"text\":");wsg_quoted(w[..],text);
  wsg_put(w[..],",\"tokens\":[");for i:0..<tokens.count {if i>0 {wsg_byte(w[..],',');}wsg_digits(w[..],tokens[i],1);}wsg_put(w[..],"],\"frames\":[");for i:0..<frames.count {if i>0 {wsg_byte(w[..],',');}wsg_digits(w[..],frames[i],1);}
  wsg_put(w[..],"],\"token_samples\":[");for i:0..<frames.count {if i>0 {wsg_byte(w[..],',');}wsg_digits(w[..],offset+frames[i]*1280,1);}wsg_put(w[..],"]}");
 }else {return -1;}
 return ifx w[0].full then -1 else w[0].n;
}
pkfile_json_text :: (text:string,prior:bool,out:[]u8)->int #export_c {
 if text=="" {return 0;}w:[1]WsOut;w[0].buf=out;if prior {wsg_byte(w[..],' ');}at:=w[0].n;wsg_quoted(w[..],text);
 if w[0].full {return -1;}for i:at..<w[0].n-2 {out[i]=out[i+1];}w[0].n-=2;return w[0].n;
}
pkfile_json_middle :: (out:[]u8)->int #export_c {s:="],\"text\":\"";if out.count<s.count {return -1;}for i:0..<s.count {out[i]=s[i];}return s.count;}
pkfile_json_tail :: (total:int,features:int,encoded:int,tokens:[]int,frames:[]int,out:[]u8)->int #export_c {
 w:[1]WsOut;w[0].buf=out;wsg_put(w[..],"\"");
 if pkfile_chunks(total)==1 {
  wsg_put(w[..],",\"feature_frames\":");wsg_digits(w[..],features,1);wsg_put(w[..],",\"encoded_frames\":");wsg_digits(w[..],encoded,1);wsg_put(w[..],",\"token_count\":");wsg_digits(w[..],tokens.count,1);
  wsg_put(w[..],",\"tokens\":[");for i:0..<tokens.count {if i>0 {wsg_byte(w[..],',');}wsg_digits(w[..],tokens[i],1);}wsg_put(w[..],"],\"frames\":[");for i:0..<frames.count {if i>0 {wsg_byte(w[..],',');}wsg_digits(w[..],frames[i],1);}wsg_byte(w[..],']');
 }
 wsg_put(w[..],",\"complete\":true}\n");return ifx w[0].full then -1 else w[0].n;
}
