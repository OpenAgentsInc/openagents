#test "model pieces cover the pinned file exactly once" {
 p:=pkch_plan();#assert p.size==67108864 && p.bytes==2508311120 && p.pieces==38 && PKCH_DIGESTS.count==38;
 #assert pkch_count(p.bytes,p.size)==p.pieces;
 #assert pkch_count(0,4)==0 && pkch_count(1,4)==1 && pkch_count(4,4)==1 && pkch_count(5,4)==2 && pkch_count(5,0)==0 && pkch_count(-1,4)==0 && pkch_count(3,1)==3;
 total:=0;for i:0..<p.pieces {total+=pkch_end(i,p.bytes,p.size)-i*p.size;#assert pkch_end(i,p.bytes,p.size)>i*p.size;}
 #assert total==p.bytes && pkch_end(37,p.bytes,p.size)==p.bytes && pkch_end(36,p.bytes,p.size)==37*p.size;
 #assert pkch_end(0,8,4)==4 && pkch_end(1,8,4)==8 && pkch_end(1,7,4)==7 && pkch_end(0,3,4)==3;
}
#test "a piece matches only its own bytes and digest" {
 ds:=[3]string.["fb8e20fc2e4c3f248c60c39bd652f3c1347298bb977b8b4d5903b85055620603","21e721c35a5823fdb452fa2f9f0a612c74fb952e06927489c6b27a43b817bed4","4ca669ac3713d1f4aea07dae8dcc0d1c9867d27ea82a3ba4e6158a42206f959b"];
 file:=[6]u8.['a','b','c','d','e','f'];
 for i:0..<3 {#assert pkch_match(file[..],i,2,ds[..]);}
 #assert !pkch_match(file[..],-1,2,ds[..]) && !pkch_match(file[..],3,2,ds[..]) && !pkch_match(file[..],0,2,ds[0..<2]) && !pkch_match(file[..],0,0,ds[..]);
 file[3]='x';#assert pkch_match(file[..],0,2,ds[..]) && !pkch_match(file[..],1,2,ds[..]) && pkch_match(file[..],2,2,ds[..]);
 swapped:=[3]string.[ds[1],ds[0],ds[2]];file[3]='d';#assert !pkch_match(file[..],0,2,swapped[..]);
 short:=[3]string.["fb8e20fc2e4c3f248c60c39bd652f3c1347298bb977b8b4d5903b85055620603","21e721c35a5823fdb452fa2f9f0a612c74fb952e06927489c6b27a43b817bed4","3f79bb7b435b05321651daefd374cdc681dc06faa65e374e38337b88ca046dea"];
 #assert pkch_match(file[0..<5],2,2,short[..]) && !pkch_match(file[0..<5],2,2,ds[..]);
}
#test "every share checks exactly its pieces and refuses a wrong size or share" {
 ds:=[3]string.["fb8e20fc2e4c3f248c60c39bd652f3c1347298bb977b8b4d5903b85055620603","21e721c35a5823fdb452fa2f9f0a612c74fb952e06927489c6b27a43b817bed4","4ca669ac3713d1f4aea07dae8dcc0d1c9867d27ea82a3ba4e6158a42206f959b"];
 file:=[6]u8.['a','b','c','d','e','f'];
 #assert pkch_run(file[..],0,1,2,6,ds[..]) && pkch_run(file[..],0,3,2,6,ds[..]) && pkch_run(file[..],2,3,2,6,ds[..]) && pkch_run(file[..],1,2,2,6,ds[..]);
 #assert !pkch_run(file[..],0,1,2,7,ds[..]) && !pkch_run(file[0..<5],0,1,2,6,ds[..]) && !pkch_run(file[..],-1,1,2,6,ds[..]) && !pkch_run(file[..],0,0,2,6,ds[..]);
 #assert !pkch_run(file[..],3,3,2,6,ds[..]) && !pkch_run(file[..],0,4,2,6,ds[..]) && !pkch_run(file[..],1,1,2,6,ds[..]);
 file[2]='x';
 #assert !pkch_run(file[..],0,1,2,6,ds[..]) && pkch_run(file[..],0,2,2,6,ds[..]) && !pkch_run(file[..],1,2,2,6,ds[..]) && pkch_run(file[..],2,3,2,6,ds[..]) && !pkch_run(file[..],1,3,2,6,ds[..]);
 file[2]='c';file[5]='x';#assert !pkch_run(file[..],0,1,2,6,ds[..]) && !pkch_run(file[..],2,3,2,6,ds[..]) && !pkch_run(file[..],0,2,2,6,ds[..]) && pkch_run(file[..],1,2,2,6,ds[..]);
 small:[8]u8;#assert !pkch_verify(small[..],0,1);
}
#test "the parallel shares are admitted only when every share ran and passed" {
 none:[1]bool;#assert !pkch_complete(none[0..<0]);
 ok:[38]bool;for i:0..<38 {ok[i]=true;}
 #assert pkch_complete(ok[0..<1]) && pkch_complete(ok[0..<16]) && pkch_complete(ok[..]);
 more:[39]bool;for i:0..<39 {more[i]=true;}#assert !pkch_complete(more[..]);
 ok[15]=false;#assert !pkch_complete(ok[0..<16]) && pkch_complete(ok[0..<15]);ok[0]=false;#assert !pkch_complete(ok[0..<1]);
}

PkchPlan :: struct {size:int;bytes:int;pieces:int;}
pkch_plan :: ()->PkchPlan {return PkchPlan.{size=PKCH_SIZE,bytes=PKCH_BYTES,pieces=PKCH_PIECES};}
pkch_count :: (bytes:int,size:int)->int {if bytes<1 || size<1 {return 0;}return (bytes-1)/size+1;}
// The end of piece i: the file's end for the last piece, else the next piece's start.
pkch_end :: (i:int,bytes:int,size:int)->int {return ifx i==pkch_count(bytes,size)-1 then bytes else (i+1)*size;}
pkch_match :: (file:[]u8,i:int,size:int,digests:[]string)->bool {
 n:=pkch_count(file.count,size);if n!=digests.count || i<0 || i>=n {return false;}
 hex:[64]u8;return S_hex(S_hash(cast(string)file[i*size..<pkch_end(i,file.count,size)]),hex[..]) && cast(string)hex[..]==digests[i];
}
// Share first of step checks pieces first, first+step, ... The engine runs
// shares 0..step-1, one per thread, so together they check every piece.
pkch_run :: (file:[]u8,first:int,step:int,size:int,bytes:int,digests:[]string)->bool {
 if file.count!=bytes || step<1 || step>digests.count || first<0 || first>=step {return false;}
 i:=first;while i<digests.count {if !pkch_match(file,i,size,digests) {return false;}i+=step;}return true;
}
pkch_verify :: (file:[]u8,first:int,step:int)->bool #export_c {p:=pkch_plan();digests:=PKCH_DIGESTS;return pkch_run(file,first,step,p.size,p.bytes,digests[..]);}
// The answers of shares 0..n-1 of n: the file is admitted only when all ran and passed.
pkch_complete :: (shares:[]bool)->bool {if shares.count<1 || shares.count>PKCH_PIECES {return false;}for ok:shares {if !ok {return false;}}return true;}
