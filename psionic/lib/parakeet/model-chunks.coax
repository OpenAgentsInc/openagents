// The pinned model.safetensors as 38 pieces of 64 MiB (the last is shorter),
// each with its own pinned SHA-256, so the resident engine can check the
// whole file on several threads at once (GitHub #12665). The single-thread
// SHA-256 of all 2,508,311,120 bytes was the slowest part of opening the
// model. The pieces are this exact file's: their digests were computed from
// the copy whose whole-file SHA-256 is the pinned
// 3a2026366188c8c68598edbbff92f8d11590a08e0ae2e6775544e7b07d6a5e11
// (docs/verification/dictation-eval-2026-11-02/README.md). A file is
// admitted only when every piece matches, so every byte is still checked.
// Threads are an effect (parakeet-face.c); which pieces exist, what each
// covers and when the set is complete are decided here.
#load "../../../coax/lib/crypto/sha256-kernel.coax";
#authority;
PKCH_SIZE :: 67108864;
PKCH_BYTES :: 2508311120;
PKCH_PIECES :: 38;
PKCH_DIGESTS :: [38] string.[
