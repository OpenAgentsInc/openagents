// Parakeet's pinned SentencePiece unknown surface. Its other control pieces
// are literal text in NeMo, not commands or automatically removed tokens.
// Keep the generic chapter's tdt_text profile unchanged.
#load "../tdt.coax";

#test "Parakeet text matches recorded official SentencePiece unknown spacing" {
 pieces:[301]string;pieces[0]="<unk>";pieces[1]="<|nospeech|>";pieces[284]="an";pieces[300]="▁j";
 ids:=[9][3]int.[[3]int.[0,0,0],[3]int.[0,0,0],[3]int.[0,284,0],[3]int.[284,0,0],[3]int.[284,0,300],[3]int.[284,0,284],[3]int.[0,1,0],[3]int.[1,0,0],[3]int.[0,284,0]];
 sizes:=[9]int.[1,2,2,2,3,3,2,2,3];expected:=[9]string.[" ⁇ "," ⁇  ⁇ "," ⁇ an","an ⁇ ","an ⁇  j","an ⁇ an"," ⁇ <|nospeech|>","<|nospeech|> ⁇ "," ⁇ an ⁇ "];
 out:[128]u8;
 for i:0..<9 {seq:=ids[i];n:=pkv3_text(pieces[..],seq[0..<sizes[i]],out[..]);#assert n==expected[i].count && cast(string)out[0..<n]==expected[i];}
 seq:=[2]int.[300,300];n:=pkv3_text(pieces[..],seq[..],out[..]);#assert cast(string)out[0..<n]=="j j";
}
#test "Parakeet text preserves literal control pieces and exact output bounds" {
 pieces:=[4]string.["<unk>","<pad>","▁now","▁"];out:[32]u8;ids:=[2]int.[1,2];
 n:=pkv3_text(pieces[..],ids[..],out[..]);#assert n==9 && cast(string)out[0..<n]=="<pad> now";
 #assert pkv3_text(pieces[..],ids[..],out[0..<9])==9 && pkv3_text(pieces[..],ids[..],out[0..<8])== -1;
 one:=[1]int.[0];#assert pkv3_text(pieces[..],one[..],out[0..<5])==5 && pkv3_text(pieces[..],one[..],out[0..<4])== -1;
 #assert pkv3_text(pieces[..],one[0..<0],out[0..<0])==0;
 bad:=[1]int.[-1];#assert pkv3_text(pieces[..],bad[..],out[..])== -1;bad[0]=4;#assert pkv3_text(pieces[..],bad[..],out[..])== -1;
 bare:=[1]int.[3];#assert pkv3_text(pieces[..],bare[..],out[0..<0])==0;
 suffix:=[2]int.[1,3];#assert pkv3_text(pieces[..],suffix[..],out[0..<5])== -1;
 #assert pkv3_text(pieces[..],suffix[..],out[0..<6])==6 && cast(string)out[0..<6]=="<pad> ";
}
pkv3_text :: (pieces:[]string,tokens:[]int,out:[]u8)->int {
 n:=0;
 for token:tokens {
  if token<0 || token>=pieces.count {return -1;}
  piece:=ifx token==0 then " ⁇ " else pieces[token];i:=0;
  while i<piece.count {
   marker:=i+3<=piece.count && piece[i..<i+3]=="▁";
   if marker {i+=3;if n>0 {if n==out.count {return -1;}out[n]=' ';n+=1;}}
   else {if n==out.count {return -1;}out[n]=piece[i];n+=1;i+=1;}
  }
 }
 return n;
}
