#load "oscillator-function-types.coax";
#authority;

#test "owned RK4 graph modes select only state and held-action partials" {
  for mode:0..<5 {f:=of_function(cast(u8)mode);#assert f.status==FxStatus.ok;l:=fx_layout(f.function);#assert l.status==FxStatus.ok;if mode==0 {#assert f.function.count==3 && l.domain==16;}else if mode==1 {#assert f.function.count==1 && l.domain==22;}else if mode==3 {#assert f.function.count==3 && l.domain==22;}else {#assert f.function.count==9;} }
  #assert of_function(cast(u8)5).status==FxStatus.operation;
  p:=of_program(false);#assert p.count==23 && p.output==22;p=of_program(true);#assert p.count==29 && p.output==28;
}
#test "physical packing pins the augmented field and correlated step constants" {
  w:=[3]f32.[1,0.25,0.05];v:=of_pack(OsParams.{spring=2,damping=0.5},OsState.{position=1,velocity=2},1,0.03125,OsState.{position=0.25,velocity=-0.5},w[..]);#assert v.status==OsStatus.ok;
  #assert v.values[0]==1 && v.values[1]==2 && v.values[2]==1 && v.values[3]==0 && v.values[4]==1 && v.values[5]==0 && v.values[6]==-2 && v.values[7]==-0.5 && v.values[8]==1;
  #assert v.values[9]==0 && v.values[10]==0 && v.values[11]==0 && v.values[12]==0.015625 && v.values[13]==0.03125 && v.values[14]==0.03125f32/6.0f32 && v.values[15]==2;
  #assert v.values[16]==-0.25 && v.values[17]==0.5 && v.values[18]==0 && v.values[19]==1 && v.values[20]==0.25 && v.values[21]==0.05f32;
  #assert of_pack(OsParams.{mass=2,spring=2,damping=0.5},OsState.{},0,0.01,OsState.{},w[..]).status==OsStatus.parameters;
  #assert of_pack(OsParams.{spring=2,damping=0.5},OsState.{},0,0.01,OsState.{position=3},w[..]).status==OsStatus.state;
  #assert of_pack(OsParams.{spring=2,damping=0.5},OsState.{},0,0.01,OsState.{},w[0..<2]).status==OsStatus.shape;
  w[0]=-1;#assert of_pack(OsParams.{spring=2,damping=0.5},OsState.{},0,0.01,OsState.{},w[..]).status==OsStatus.parameters;w=[3]f32.[0,0,0];#assert of_pack(OsParams.{spring=2,damping=0.5},OsState.{},0,0.01,OsState.{},w[..]).status==OsStatus.parameters;
}
#test "packing keeps finite limits and malformed targets and weights distinct" {
  p:=OsParams.{spring=2,damping=0.5};w:=[3]f32.[1,0.25,0.05];
  #assert of_pack(p,OsState.{},0,0.01,OsState.{position=2,velocity=4},w[..]).status==OsStatus.ok;
  huge:f64=1e308;bad:=huge*huge;
  #assert of_pack(p,OsState.{},0,0.01,OsState.{position=bad},w[..]).status==OsStatus.number && of_pack(p,OsState.{},0,0.01,OsState.{velocity=bad},w[..]).status==OsStatus.number;
  for i:0..<3 {w=[3]f32.[1,0.25,0.05];w[i]=0;#assert of_pack(p,OsState.{},0,0.01,OsState.{},w[..]).status==OsStatus.ok;w[i]=4;#assert of_pack(p,OsState.{},0,0.01,OsState.{},w[..]).status==OsStatus.ok;w[i]=4.001f32;#assert of_pack(p,OsState.{},0,0.01,OsState.{},w[..]).status==OsStatus.parameters;big:f32=1e30;w[i]=big*big;#assert of_pack(p,OsState.{},0,0.01,OsState.{},w[..]).status==OsStatus.number;}
}
#test "RK4 graph products execute the physical field rather than a fitted surrogate" {
  weights:=[3]f32.[1,0.25,0.05];input:=of_pack(OsParams.{spring=2,damping=0.5},OsState.{position=0.8,velocity=-0.4},0.2,0.03125,OsState.{position=0.2},weights[..]);#assert input.status==OsStatus.ok;
  values:[256]f32;flags:[256]u8;dots:[256]f64;g:[256]f64;gd:[256]f64;seed:[32]f64;dir:[32]f64;stage:[256]f64;point:[32]f32;out:[10]f64;
  work:=FxWork.{values=values[..],flags=flags[..],dots=dots[..],grads=g[..],grad_dots=gd[..],seed=seed[..],direction=dir[..],stage=stage[..],point=point[..]};
  f:=of_function(OF_STEP);#assert fx_eval(f.function,input.values[0..<16],out[..],work,false).status==FxStatus.ok;physical:=os_step(OsParams.{spring=2,damping=0.5},OsState.{position=f64(input.values[0]),velocity=f64(input.values[1])},f64(input.values[2]),f64(input.values[13]));#assert physical.status==OsStatus.ok && abs(out[0]-physical.state.position)<0.000003 && abs(out[1]-physical.state.velocity)<0.000003 && out[2]==f64(input.values[2]);
  f=of_function(OF_JACOBIAN);#assert fx_eval(f.function,input.values[0..<16],out[..],work,false).status==FxStatus.ok && out[6]==0 && out[7]==0 && out[8]==1 && out[2]>0 && out[5]>0;
  #assert abs(out[0]-(0.99902866281157721))<0.00000000002 && abs(out[1]-(0.030997033844303079))<0.00000000002 && abs(out[2]-(0.00048566859421139696))<0.00000000002 && abs(out[3]-(-0.061994067688606158))<0.00000000002 && abs(out[4]-(0.98353014588942567))<0.00000000002 && abs(out[5]-(0.030997033844303079))<0.00000000002 && abs(out[6]-(0))<0.00000000002 && abs(out[7]-(0))<0.00000000002 && abs(out[8]-(1))<0.00000000002;
  f=of_function(OF_GRADIENT);#assert fx_eval(f.function,input.values[..],out[..],work,false).status==FxStatus.ok;
  #assert abs(out[0]-(1.1862421016829641))<0.00000000002 && abs(out[1]-(-0.17842123190514769))<0.00000000002 && abs(out[2]-(0.013800224416582237))<0.00000000002;
  f=of_function(OF_HESSIAN);#assert fx_eval(f.function,input.values[..],out[..],work,false).status==FxStatus.ok && abs(out[1]-out[3])<0.00000000001 && abs(out[2]-out[6])<0.00000000001 && abs(out[5]-out[7])<0.00000000001 && out[8]>0;
  #assert abs(out[0]-(1.9980381704524657))<0.00000000002 && abs(out[1]-(0.031447333326171743))<0.00000000002 && abs(out[2]-(9.5775853443103281e-06))<0.00000000002 && abs(out[3]-(0.031447333326171743))<0.00000000002 && abs(out[4]-(0.48558740615092721))<0.00000000002 && abs(out[5]-(0.015273367181217207))<0.00000000002 && abs(out[6]-(9.5775853443103281e-06))<0.00000000002 && abs(out[7]-(0.015273367181217207))<0.00000000002 && abs(out[8]-(0.10048088129165536))<0.00000000002;
}

// Matrix form of the same smooth field: z=[position,velocity,held_force], z'=A*z.
// This is a separately qualified F32 realization, not bitwise F64 os_step identity.
of_program :: (cost:bool)->TiProgram {
  p:TiProgram;p.count=ifx cost then 29 else 23;p.output=ifx cost then 28 else 22;
  column:TvShape;column.rank=2;column.dims[0]=3;column.dims[1]=1;matrix:TvShape;matrix.rank=2;matrix.dims[0]=3;matrix.dims[1]=3;scalar:TvShape;scalar.rank=1;scalar.dims[0]=1;
  p.nodes[0]=ti_input(column,0);p.nodes[1]=ti_input(matrix,3);p.nodes[2]=ti_input(scalar,12);p.nodes[3]=ti_input(scalar,13);p.nodes[4]=ti_input(scalar,14);p.nodes[5]=ti_input(scalar,15);
  p.nodes[6]=TiNode.{op=TiOp.matmul,a=1,b=0};p.nodes[7]=TiNode.{op=TiOp.multiply,a=6,b=2};p.nodes[8]=TiNode.{op=TiOp.add,a=0,b=7};
  p.nodes[9]=TiNode.{op=TiOp.matmul,a=1,b=8};p.nodes[10]=TiNode.{op=TiOp.multiply,a=9,b=2};p.nodes[11]=TiNode.{op=TiOp.add,a=0,b=10};
  p.nodes[12]=TiNode.{op=TiOp.matmul,a=1,b=11};p.nodes[13]=TiNode.{op=TiOp.multiply,a=12,b=3};p.nodes[14]=TiNode.{op=TiOp.add,a=0,b=13};p.nodes[15]=TiNode.{op=TiOp.matmul,a=1,b=14};
  p.nodes[16]=TiNode.{op=TiOp.multiply,a=9,b=5};p.nodes[17]=TiNode.{op=TiOp.add,a=6,b=16};p.nodes[18]=TiNode.{op=TiOp.multiply,a=12,b=5};p.nodes[19]=TiNode.{op=TiOp.add,a=17,b=18};p.nodes[20]=TiNode.{op=TiOp.add,a=19,b=15};p.nodes[21]=TiNode.{op=TiOp.multiply,a=20,b=4};p.nodes[22]=TiNode.{op=TiOp.add,a=0,b=21};
  p.nodes[23]=ti_input(column,16);p.nodes[24]=TiNode.{op=TiOp.add,a=22,b=23};p.nodes[25]=TiNode.{op=TiOp.multiply,a=24,b=24};p.nodes[26]=ti_input(column,19);p.nodes[27]=TiNode.{op=TiOp.multiply,a=25,b=26};p.nodes[28]=TiNode.{op=TiOp.sum,a=27,axis=0};return p;
}
of_function :: (mode:u8)->FxBuild #export_c {
  if cast(u8)mode>4 {return FxBuild.{status=FxStatus.operation};}cost:=mode!=OF_STEP && mode!=OF_JACOBIAN;f:=fx_function(of_program(cost));if f.status!=FxStatus.ok {return f;}
  if mode==OF_STEP || mode==OF_COST {return f;}f.function.count=ifx mode==OF_GRADIENT then 3 else 9;
  for i:0..<f.function.count {if mode==OF_JACOBIAN {f.function.leaves[i]=FxLeaf.{output=i/3,order=1,first=i%3};}else if mode==OF_GRADIENT {f.function.leaves[i]=FxLeaf.{order=1,first=i};}else {f.function.leaves[i]=FxLeaf.{order=2,first=i/3,second=i%3};}}return f;
}
of_pack :: (p:OsParams,s:OsState,force:f64,dt:f64,target:OsState,weights:[]f32)->OfInput #export_c {
  status:=os_admit(p,s,force,dt);if status!=OsStatus.ok {return OfInput.{status=status};}if !os_finite(target.position) || !os_finite(target.velocity) {return OfInput.{status=OsStatus.number};}if !os_state_ok(target) {return OfInput.{status=OsStatus.state};}if weights.count!=3 {return OfInput.{status=OsStatus.shape};}
  positive:=false;for v:weights {if !os_finite(f64(v)) {return OfInput.{status=OsStatus.number};}if v<0 || v>4 {return OfInput.{status=OsStatus.parameters};}if v>0 {positive=true;}}if !positive {return OfInput.{status=OsStatus.parameters};}
  out:OfInput;out.values=[22]f32.[f32(s.position),f32(s.velocity),f32(force),0,1,0,-f32(p.spring),-f32(p.damping),1,0,0,0,f32(dt)/2.0f32,f32(dt),f32(dt)/6.0f32,2,-f32(target.position),-f32(target.velocity),0,weights[0],weights[1],weights[2]];return out;
}
