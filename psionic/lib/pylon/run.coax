// Chapter 19: the Pylon program. One process holds a relay connection,
// authenticates with NIP-42, publishes its NIP-65 relay list and its 30200
// beacon, subscribes to the 25910 jobs addressed to its key, and answers each
// with a 26910 result or a 27010 status, decided by the chapter 16 engine.
// This file wires units together; it decides nothing itself. The decisions
// are decision.coax, beacon.coax, relays.coax and queue.coax (#authority),
// ws.coax and nip42.coax (#authority), and nip44.coax (#authority).
//
// The relay connection is coax/lib/net/relay_conn.coax (ws:// or wss://),
// driven by coax/lib/nostr/relay.coax's machine (generations, backoff,
// resubscription with since, publishes resent until their OK). On every new
// connection the Pylon answers that connection's NIP-42 challenge, then
// republishes its beacon, then lets the REQ and the queued answers out
// (pq_wire); a job answered once is not answered again (relay.coax's and
// pq_seen's id windows), and an answer made while the relay was away goes
// out on the next connection.
//
// The host (psionic/platform/pylon-host.c) gives arguments, the wall clock,
// a sleep and a stop request; sockets are socket-native.c, TLS tls-native.c,
// entropy entropy-foreign.c. Every event is signed in Coax
// (event_sign.coax's nostr_event_sign_step, BIP-340 over schnorr_sign.coax,
// a fresh 32-byte aux from the OS for each), and NIP-44's conversation key
// is nip44-key.coax.
//
// Relay frames are relay_read.coax's rl_read: message.coax (#6015) reads
// EVENT, OK, EOSE, CLOSED and NOTICE, an EVENT's id and signature are
// checked with the fast verifier, and auth-required is mapped onto RlIn,
// before relay.coax sees it. AUTH (rl_read's kind 0) goes to nip42_input.
// REQ, CLOSE and EVENT are written with nostr_message_write_req/close/event.
//
// TEST-ONLY (see the record, docs/verification/psionic-ch19-2026-10-29.md):
//   - The key is sha256 of --test-key-label. --key-file is refused until the
//     secret-handling audit (#4828) admits real keys.
#import "Basic";
#load "demo-label.coax";
#load "generation.coax";
#load "text.coax";
#load "text-probe-policy.coax";
#load "text-runtime.coax";
#load "../../../coax/lib/nostr/nip19-core.coax";
#load "host.coax";
#load "queue.coax";
#load "../../../coax/lib/nostr/event_sign.coax";
#load "selfcheck.coax";
#load "../../../coax/lib/net/relay_conn.coax";
#load "../../../coax/lib/nostr/relay.coax";
#load "../../../coax/lib/crypto/entropy.coax";
#load "../../../coax/lib/nostr/event.coax";
#load "../../../coax/lib/nostr/nip44.coax";
#load "../../../coax/lib/nostr/nip44-key.coax";
#load "../../../coax/lib/nostr/nip42.coax";
#load "../../../coax/lib/nostr/relay_read.coax";

// queue.coax names these PdCode and PdType values as integers.
#assert PQ_NONE==cast(int)PdCode.none && PQ_BUSY==cast(int)PdCode.busy && PQ_TIMEOUT==cast(int)PdCode.timeout;
#assert PQ_CANCELLED==cast(int)PdCode.cancelled && PQ_MISMATCH==cast(int)PdCode.identity_mismatch && PQ_INTERNAL==cast(int)PdCode.internal;
#assert PQ_CODES==cast(int)PdCode.internal+1 && PQ_CALL==cast(int)PdType.call && PQ_CANCEL==cast(int)PdType.cancel && PQ_REQUEST==PD_REQUEST;

// relay_conn.coax declares the cxsock_*, cxtls_* and cxrand_* effects.
pyh_argc :: () -> int #foreign;
pyh_arg_len :: (i: int) -> int #foreign;
pyh_arg_byte :: (i: int, k: int) -> int #foreign;
pyh_now_s :: () -> int #foreign;
pyh_stop_path_push :: (byte: int) -> int #foreign;
pyh_stop :: () -> int #foreign;
pyh_sleep_ms :: (ms: int) -> int #foreign;
pyh_status :: (code: int) -> int #foreign;
pyh_file_path_clear :: () -> int #foreign;
pyh_file_path_push :: (byte: int) -> int #foreign;
pyh_file_read :: () -> int #foreign;
pyh_file_byte :: (i: int) -> int #foreign;
pyh_file_write_push :: (byte: int) -> int #foreign;
pyh_file_write_commit :: () -> int #foreign;
pyh_file_lock :: () -> int #foreign;
pyh_label_read :: () -> int #foreign;
pyh_label_byte :: (i:int) -> int #foreign;
pyh_label_clear :: () -> int #foreign;

PY_IN :: 262144; PY_MSG :: 262144; PY_OUT :: 131072;
PY_IO_MS :: 5000;
PY_VERSION :: "psionic-pylon-v1";
PY_BODY :: 16384;       // the largest server request this host forwards
PY_HTTP :: 131072;
PY_ARGS :: 8192;
PY_LISTS :: 8;
PY_DEFAULT_LIST :: "wss://relay.openagents.com";   // owner decision, 2026-10-30

// ---- hex ------------------------------------------------------------------

py_hex :: (bytes:[]u8,out:[]u8)->string {
    digits:="0123456789abcdef";
    for i:0..<bytes.count {out[2*i]=digits[bytes[i]>>4];out[2*i+1]=digits[bytes[i]&15];}
    return cast(string)out[0..<2*bytes.count];
}
py_unhex :: (s:string,out:[]u8)->bool {
    if s.count!=2*out.count {return false;}
    for i:0..<out.count {
        v:=0;
        for k:0..<2 {
            c:=s[2*i+k];d:=-1;
            if c>='0' && c<='9' {d=cast(int)(c-'0');}else if c>='a' && c<='f' {d=cast(int)(c-'a')+10;}
            if d<0 {return false;}v=v*16+d;
        }
        out[i]=cast(u8)v;
    }
    return true;
}
// ---- configuration ----------------------------------------------------------

PyConfig :: struct {
    args:[8192]u8;used:int;
    relay:string;
    lists:[8]string;list_count:int;
    engine_host:string;engine_port:int;
    model:string;slug:string;label:string;family:string;memory_gb:int;
    label_key:string;label_file:string;key_file:string;stop_file:string;
    decide_ms:int;refresh:int;ttl:int;
    references:string;state:string;declared:string;doctor:bool;
    text:bool;probe:bool;engine_key_file:string;
}
py_arg :: (c:[]PyConfig,i:int)->string {
    n:=pyh_arg_len(i);if n<0 || c[0].used+n>PY_ARGS {return "";}
    at:=c[0].used;for k:0..<n {c[0].args[at+k]=cast(u8)pyh_arg_byte(i,k);}
    c[0].used+=n;return cast(string)c[0].args[at..<at+n];
}
py_int :: (s:string)->int {v:=json_int(s);if !v.ok {return -1;}return v.value;}
// http://HOST:PORT[/...]: host and port, or port -1.
PyUrl :: struct {host:string;port:int;}
py_url :: (url:string,scheme:string)->PyUrl {
    bad:=PyUrl.{port=-1};
    if url.count<=scheme.count || url[0..<scheme.count]!=scheme {return bad;}
    rest:=url[scheme.count..<url.count];colon:=-1;end:=rest.count;
    for i:0..<rest.count {if rest[i]==':' && colon<0 {colon=i;}if rest[i]=='/' && end==rest.count {end=i;}}
    if colon<1 || colon>=end {return bad;}
    port:=py_int(rest[colon+1..<end]);if port<1 || port>65535 {return bad;}
    return PyUrl.{host=rest[0..<colon],port=port};
}
py_usage :: () {
    print("usage: pylon --relay ws[s]://HOST[:PORT] --engine http://HOST:PORT --model NAME --slug SLUG\n");
    print("             (--test-key-label LABEL | --test-key-label-file PATH | --key-file PATH)\n");
    print("             [--list URL]... [--label TEXT] [--family gpu|cpu|unified-memory] [--memory-gb N]\n");
    print("             [--decide-ms N] [--refresh S] [--ttl S] [--stop-file PATH]\n");
    print("             --references SET --identity-state PATH [--declare-identity ID]\n");
    print("       pylon --doctor --engine http://HOST:PORT --model NAME --references SET --identity-state PATH [--declare-identity ID]\n");
}
py_config :: (c:[]PyConfig)->bool {
    c[0].label="Psionic Pylon";c[0].family="cpu";c[0].memory_gb=16;c[0].decide_ms=30000;c[0].refresh=60;c[0].ttl=180;
    i:=1;argc:=pyh_argc();
    while i<argc {
        name:=py_arg(c,i);
        if name=="--doctor" {c[0].doctor=true;i+=1;continue;}
        if name=="--nip90" {c[0].text=true;i+=1;continue;}
        if i+1>=argc {print("pylon: % needs a value\n",name);return false;}
        v:=py_arg(c,i+1);i+=2;
        if name=="--relay" {c[0].relay=v;}
        else if name=="--list" {if c[0].list_count>=PY_LISTS-1 {print("pylon: too many --list\n");return false;}c[0].lists[c[0].list_count]=v;c[0].list_count+=1;}
        else if name=="--engine" {u:=py_url(v,"http://");c[0].engine_host=u.host;c[0].engine_port=u.port;}
        else if name=="--model" {c[0].model=v;}
        else if name=="--slug" {c[0].slug=v;}
        else if name=="--label" {c[0].label=v;}
        else if name=="--family" {c[0].family=v;}
        else if name=="--memory-gb" {c[0].memory_gb=py_int(v);}
        else if name=="--test-key-label" {c[0].label_key=v;}
        else if name=="--test-key-label-file" {c[0].label_file=v;}
        else if name=="--key-file" {c[0].key_file=v;}
        else if name=="--stop-file" {c[0].stop_file=v;}
        else if name=="--decide-ms" {c[0].decide_ms=py_int(v);}
        else if name=="--refresh" {c[0].refresh=py_int(v);}
        else if name=="--ttl" {c[0].ttl=py_int(v);}
        else if name=="--references" {c[0].references=v;}
        else if name=="--identity-state" {c[0].state=v;}
        else if name=="--declare-identity" {c[0].declared=v;}
        else if name=="--engine-key-file" {c[0].engine_key_file=v;}
        else {print("pylon: unknown option %\n",name);return false;}
    }
    if c[0].engine_port<0 || c[0].engine_host.count==0 {print("pylon: --engine must be http://HOST:PORT\n");return false;}
    if (!c[0].text && c[0].references.count==0) || c[0].state.count==0 {print("pylon: --references and --identity-state are required: a Pylon checks itself before it serves (chapter 159)\n");py_usage();return false;}
    if c[0].model.count==0 {py_usage();return false;}
    if c[0].doctor {return true;}
    if !relay_uri(c[0].relay).ok {print("pylon: --relay must be ws://HOST[:PORT] or wss://HOST[:PORT], with a host name, not an IP address\n");return false;}
    if c[0].key_file.count!=0 {
        print("pylon: --key-file refused: real keys wait on the secret-handling audit (#4828); use a throwaway --test-key-label-file\n");return false;
    }
    if (c[0].label_key.count==0)==(c[0].label_file.count==0) {print("pylon: supply exactly one test label or test label file\n");return false;}
    if c[0].model.count==0 || !pb_slug(c[0].slug,PB_SLUG) {py_usage();return false;}
    if c[0].list_count==0 {c[0].lists[0]=PY_DEFAULT_LIST;c[0].list_count=1;}
    have:=false;for k:0..<c[0].list_count {if c[0].lists[k]==c[0].relay {have=true;}}
    if !have {c[0].lists[c[0].list_count]=c[0].relay;c[0].list_count+=1;}
    if pb_valid_until(0,c[0].ttl)<0 || c[0].refresh<PB_REFRESH_MIN || c[0].refresh>PB_REFRESH_MAX || pb_tier(c[0].family,c[0].memory_gb).count==0 || !pb_memory_ok(c[0].memory_gb) {
        print("pylon: --ttl 1..300, --refresh 60..240, and a memory_gb of 8..512 in powers of two\n");return false;
    }
    if c[0].stop_file.count!=0 {for b:c[0].stop_file {if pyh_stop_path_push(cast(int)b)!=0 {return false;}}}
    return true;
}

// ---- effects shared with the engine's HTTP -----------------------------------

py_draw :: (n:int,out:[]u8)->bool {return rc_draw(n,out);}
py_write :: (h:int,bytes:string)->bool {
    for b:bytes {if cxsock_write(h,cast(int)b)!=0 {return false;}}
    return cxsock_flush(h,PY_IO_MS)==0;
}
py_connect :: (host:string,port:int)->int {
    for b:host {r:=cxsock_host_push(cast(int)b);}
    return cxsock_connect(port,PY_IO_MS);
}

// ---- the Pylon ----------------------------------------------------------------

PySlot :: struct {held:PdJob;id:[64]u8;caller:[64]u8;request:[128]u8;body:[16384]u8;n:int;original:[16384]u8;original_n:int;}
// A signed ["EVENT",...] frame kept for relay.coax's publish slot of the same
// index, so it can go again on the next connection until its OK comes.
PyOutbox :: struct {text:[131072]u8;n:int;}
// The last answers sent (26910 or 27010), by job id, for pq_again.
PY_KEPT :: 8;
PyKept :: struct {jid:[32]u8;used:bool;frame:[131072]u8;n:int;}
Py :: struct {
    cfg:[1]PyConfig;
    key:[32]u8;me:[64]u8;
    signer:[1]NostrSignWork;
    // One RelayConn (about 450 KB) and the machine for the whole run; Py is
    // main's, on the host's 512 MiB thread, never a per-call frame.
    conn:[1]RelayConn;rl:[1]Relay;outbox:[8]PyOutbox;
    gen:int;opened_ms:int;announced:int;sub:int=-1;first_since:int;
    beacon_slot:int=-1;list_slot:int=-1;
    kept:[8]PyKept;kept_at:int;
    ecdh:[1]EcdhScratch;
    n42:[1]Nip42;
    q:[1]PqQueue;slots:[4]PySlot;
    life:PbLife;observed:int;identity:[160]u8;identity_n:int;
    sent:int;accepted:int;refused:int;forged:int;duplicates:int;ignored:int;
    answered:int;refusals:int;cancelled:int;beacons:int;
    connects:int;drops:int;auths:int;caught_up:int;
    engine_key:[128]u8;engine_key_n:int;probe:[1]P90Probe;
}
py_me :: (p:[]Py)->string {return cast(string)p[0].me[..];}
py_identity :: (p:[]Py)->string {return cast(string)p[0].identity[0..<p[0].identity_n];}
py_short :: (s:string)->string {return ifx s.count>12 then s[0..<12] else s;}

// book:begin sign
// One event signed in Coax: event_sign.coax's stages until it writes the
// event's JSON into out, with 32 fresh bytes from the OS as BIP-340's aux.
// The length, or -1 refused.
py_sign :: (p:[]Py,created_at:int,kind:int,tags:string,content:string,scratch:[]u8,out:[]u8)->int {
    aux:[32]u8;if !py_draw(32,aux[..]) {return -1;}
    n:=EVENT_MORE;
    while n==EVENT_MORE {n=nostr_event_sign_step(p[0].key[..],aux[..],created_at,kind,tags,content,p[0].signer[..],scratch,out,false);}
    for i:0..<32 {aux[i]=0;}
    return n;
}
// book:end sign
// The Pylon's public key, through the same signer: an event that is signed
// here and never sent, read back by event.coax.
py_public :: (p:[]Py)->bool {
    scratch:[4096]u8;signed:[4096]u8;
    n:=py_sign(p,0,1,"[]","",scratch[..],signed[..]);if n<0 {return false;}
    ev:=nostr_event_read(cast(string)signed[0..<n],scratch[..],false);
    if ev.error!=NE_OK {return false;}
    pk:=ev.public_key;id:=py_hex(pk[..],p[0].me[..]);
    return pt_hex64(id);
}
// A template's four signed fields, read back for the signer.
PyTpl :: struct {ok:bool;created_at:int;kind:int;tags:string;content:string;}
py_fields :: (template:string,content:[]u8)->PyTpl {
    r:PyTpl;j:[1]Json;json_start(j[..],template);
    if json_next(j[..])!=JSON_OBJECT {return r;}
    seen:=0;
    while true {
        t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}
        if t!=JSON_STRING {return r;}
        key:=json_text(j[..]);t=json_next(j[..]);
        if json_is(key,"created_at") {if t!=JSON_NUMBER {return r;}r.created_at=py_int(json_text(j[..]));seen|=1;}
        else if json_is(key,"kind") {if t!=JSON_NUMBER {return r;}r.kind=py_int(json_text(j[..]));seen|=2;}
        else if json_is(key,"tags") {r.tags=pt_raw(j[..],t);seen|=4;}
        else if json_is(key,"content") {if t!=JSON_STRING {return r;}n:=json_unescape(json_text(j[..]),content);if n<0 {return r;}r.content=cast(string)content[0..<n];seen|=8;}
        else {raw:=pt_raw(j[..],t);}
    }
    r.ok=seen==15 && r.created_at>=0 && r.kind>=0;return r;
}
// Signs one event and hands it to relay.coax's publish queue: it goes out
// when the connection is open and authenticated, again on every reconnect
// until the relay answers OK. The publish slot, or -1 when signing failed or
// every slot is pending.
py_publish :: (p:[]Py,template:string,what:string)->int {
    content:[65536]u8;t:=py_fields(template,content[..]);
    if !t.ok {print("pylon: % template unreadable\n",what);return -1;}
    scratch:[PY_OUT]u8;signed:[PY_OUT]u8;
    n:=py_sign(p,t.created_at,t.kind,t.tags,t.content,scratch[..],signed[..]);
    if n<0 {print("pylon: % refused by the signer\n",what);return -1;}
    // The signed event's id is its first field: {"id":"<64 hex>",...
    id:[32]u8;
    if n<72 || cast(string)signed[0..<7]!="{\"id\":\"" || !py_unhex(cast(string)signed[7..<71],id[..]) {return -1;}
    slot:=rl_publish(p[0].rl[..],id[..]);
    if slot<0 {print("pylon: no publish slot free for the %\n",what);return -1;}
    o:=p[0].outbox[slot].text[..];
    m:=nostr_message_write_event(cast(string)signed[0..<n],o,false);
    if m<0 || m>RC_MSG_MAX {x:=rl_cancel_publish(p[0].rl[..],slot);return -1;}
    p[0].outbox[slot].n=m;
    p[0].sent+=1;
    return slot;
}
// NIP-44 to the caller: the payload written into out.
// The conversation key with caller (x-only hex): nip44-key.coax's ECDH and
// HKDF-extract, into ck. NIP44_OK or its refusal.
py_ck :: (p:[]Py,caller:string,ck:[]u8)->u32 {
    peer:[32]u8;if !py_unhex(caller,peer[..]) {return NIP44_KEY;}
    return nip44_conversation_key_from_keys_checked(p[0].key[..],peer[..],p[0].ecdh[..],ck,false);
}
py_seal :: (p:[]Py,caller:string,plaintext:string,out:[]u8)->string {
    ck:[32]u8;nonce:[32]u8;
    e:=py_ck(p,caller,ck[..]);
    if e!=NIP44_OK || !py_draw(32,nonce[..]) {for i:0..<32 {ck[i]=0;}return "";}
    work:[PY_OUT]u8;plain:[PY_OUT]u8;if plaintext.count>PY_OUT {return "";}for i:0..<plaintext.count {plain[i]=plaintext[i];}
    r:=nip44_encrypt_checked(NIP44_COMPAT,ck[..],nonce[..],plain[0..<plaintext.count],work[0..<nip44_encrypt_work_size(NIP44_COMPAT,plaintext.count)],out[0..<nip44_payload_size(NIP44_COMPAT,plaintext.count)],false);
    for i:0..<32 {ck[i]=0;}
    if r.error!=NIP44_OK {return "";}
    return cast(string)out[0..<r.written];
}
py_open_payload :: (p:[]Py,caller:string,payload:string,out:[]u8)->Nip44Result {
    ck:[32]u8;
    e:=py_ck(p,caller,ck[..]);
    if e!=NIP44_OK {return Nip44Result.{error=e};}
    size:=nip44_decrypt_work_size(NIP44_COMPAT,payload.count);
    if size<0 || size>PY_OUT {return Nip44Result.{error=NIP44_CAPACITY};}
    work:[PY_OUT]u8;r:=nip44_decrypt_checked(NIP44_COMPAT,ck[..],payload,work[0..<size],out,false);
    for i:0..<32 {ck[i]=0;}
    return r;
}
// A 26910 or 27010 for job: encrypt plaintext to its caller, template, sign, send.
py_reply :: (p:[]Py,jb:PdJob,kind:int,plaintext:string,what:string)->bool {
    payload:[PY_OUT]u8;sealed:=py_seal(p,jb.caller,plaintext,payload[..]);
    if sealed.count==0 {print("pylon: could not encrypt the % for %\n",what,py_short(jb.id));return false;}
    template:[PY_OUT]u8;n:=pd_template(template[..],py_me(p),pyh_now_s(),kind,jb,sealed);
    if n<0 {return false;}
    slot:=py_publish(p,cast(string)template[0..<n],what);
    if slot<0 {return false;}
    k:=p[0].kept_at;p[0].kept_at=(k+1)%PY_KEPT;
    p[0].kept[k].used=py_unhex(jb.id,p[0].kept[k].jid[..]);
    for i:0..<p[0].outbox[slot].n {p[0].kept[k].frame[i]=p[0].outbox[slot].text[i];}p[0].kept[k].n=p[0].outbox[slot].n;
    return true;
}
// A job id seen again: its kept answer goes again when pq_again says so.
py_again :: (p:[]Py,jid:[]u8) {
    held:=false;
    for i:0..<PQ_SLOTS {
        if p[0].q[0].slots[i].state==PqState.free {continue;}
        id:[32]u8;if py_unhex(cast(string)p[0].slots[i].id[..],id[..]) && rl_id_eq(id[..],jid) {held=true;}
    }
    k:=-1;
    for i:0..<PY_KEPT {if p[0].kept[i].used && rl_id_eq(p[0].kept[i].jid[..],jid) {k=i;}}
    if !pq_again(k>=0,held) {return;}
    // The kept frame is ["EVENT",{"id":"<64 hex>",...
    f:=cast(string)p[0].kept[k].frame[0..<p[0].kept[k].n];id:[32]u8;
    if f.count<80 || f[0..<16]!="[\"EVENT\",{\"id\":\"" || !py_unhex(f[16..<80],id[..]) {return;}
    slot:=rl_publish(p[0].rl[..],id[..]);if slot<0 {return;}
    for i:0..<f.count {p[0].outbox[slot].text[i]=f[i];}p[0].outbox[slot].n=f.count;
    hj:[64]u8;print("pylon: job % seen again; its answer % goes again\n",py_short(py_hex(jid,hj[..])),py_short(f[16..<80]));
}
py_status :: (p:[]Py,jb:PdJob,code:PdCode)->bool {
    body:[1024]u8;retry:=ifx code==PdCode.busy then PQ_RETRY_MS else -1;
    n:=pd_status(body[..],jb,PdStatus.error,code,retry);if n<0 {return false;}
    p[0].refusals+=1;
    print("pylon: job % -> 27010 error %\n",py_short(jb.id),pd_code_name(code));
    return py_reply(p,jb,PD_STATUS,cast(string)body[0..<n],"status");
}

// ---- the engine (chapter 16's /v1/systemone over HTTP) ----------------------

PyHttp :: struct {reached:bool;timed_out:bool;status:int;body:string;}
// POST body to the engine; at most budget_ms for the whole exchange.
py_http :: (p:[]Py,body:string,budget_ms:int,resp:[]u8)->PyHttp {
    return py_http_at(p,"/v1/systemone","",body,budget_ms,resp);
}
py_http_at :: (p:[]Py,path:string,key:string,body:string,budget_ms:int,resp:[]u8)->PyHttp {
    r:PyHttp;c:=p[0].cfg[0];end:=cxsock_now_ms()+budget_ms;
    h:=py_connect(c.engine_host,c.engine_port);if h<0 {return r;}
    head:[1024]u8;n:=json_raw(head[..],0,"POST ");n=json_raw(head[..],n,path);n=json_raw(head[..],n," HTTP/1.1\r\nHost: ");n=json_raw(head[..],n,c.engine_host);
    if key.count>0 {n=json_raw(head[..],n,"\r\nAuthorization: Bearer ");n=json_raw(head[..],n,key);}
    n=json_raw(head[..],n,"\r\nContent-Type: application/json\r\nContent-Length: ");n=json_write_int(head[..],n,body.count);
    n=json_raw(head[..],n,"\r\nConnection: close\r\n\r\n");
    if n<0 || !py_write(h,cast(string)head[0..<n]) || !py_write(h,body) {x:=cxsock_close(h);return r;}
    used:=0;
    while true {
        left:=end-cxsock_now_ms();if left<=0 {r.timed_out=true;x:=cxsock_close(h);return r;}
        k:=cxsock_read(h,left);
        if k==-1 {break;}
        if k==-2 {r.timed_out=true;x:=cxsock_close(h);return r;}
        if k<0 || used+k>resp.count {x:=cxsock_close(h);return r;}
        for i:0..<k {resp[used+i]=cast(u8)cxsock_byte(h,i);}used+=k;
    }
    x:=cxsock_close(h);
    text:=cast(string)resp[0..<used];
    if used<12 || text[0..<9]!="HTTP/1.1 " {return r;}
    status:=py_int(text[9..<12]);
    at:=pb_index(text,"\r\n\r\n");if at<0 || status<100 {return r;}
    r.reached=true;r.status=status;r.body=text[at+4..<used];return r;
}
// The code a refusal body names: {"error":{"code":"..."}}, or none.
py_refused :: (body:string)->int {
    j:[1]Json;json_start(j[..],body);if json_next(j[..])!=JSON_OBJECT {return PQ_NONE;}
    while true {
        t:=json_next(j[..]);if t!=JSON_STRING {return PQ_NONE;}
        key:=json_text(j[..]);t=json_next(j[..]);
        if json_is(key,"error") && t==JSON_OBJECT {
            while true {
                s:=json_next(j[..]);if s!=JSON_STRING {return PQ_NONE;}
                k:=json_text(j[..]);s=json_next(j[..]);
                if json_is(k,"code") && s==JSON_STRING {return cast(int)pd_code(json_text(j[..]));}
                raw:=pt_raw(j[..],s);
            }
        }
        raw:=pt_raw(j[..],t);
    }
    return PQ_NONE;
}
// The engine's identity: one decision at start, its service.identity.
py_probe :: (p:[]Py)->bool {
    body:[512]u8;n:=json_raw(body[..],0,"{\"model\":");n=json_write_string(body[..],n,p[0].cfg[0].model);
    n=json_raw(body[..],n,",\"state\":\"Water is wet.\",\"questions\":{\"wet\":{\"type\":\"choice\",\"instructions\":\"Is the water wet?\",\"criteria\":{\"yes\":null,\"no\":null}}}}");
    resp:[PY_HTTP]u8;started:=cxsock_now_ms();
    r:=py_http(p,cast(string)body[0..<n],p[0].cfg[0].decide_ms,resp[..]);
    if !r.reached || r.status!=200 {print("pylon: the engine did not answer the probe (reached %, status %)\n",r.reached,r.status);return false;}
    at:=pb_index(r.body,"\"identity\":\"");if at<0 {return false;}
    rest:=r.body[at+12..<r.body.count];end:=pb_index(rest,"\"");if end<1 || end>p[0].identity.count {return false;}
    for i:0..<end {p[0].identity[i]=rest[i];}p[0].identity_n=end;
    id:=py_identity(p);
    if !pb_identity(id) || pb_identity_name(id)!=p[0].cfg[0].model {print("pylon: the engine names %, not a % identity\n",id,p[0].cfg[0].model);return false;}
    print("pylon: engine % answered the probe in % ms\n",id,cxsock_now_ms()-started);
    return true;
}

// ---- relay records -----------------------------------------------------------

py_beacon :: (p:[]Py,now:int)->bool {
    c:=p[0].cfg[0];
    observed:=ifx now>p[0].observed then now else p[0].observed+1;
    lanes:[1]string;services:[1]PbService;settlement:[1]string;cap:[160]u8;
    lanes[0]=ifx c.text then "nip90-5050" else "cj-decision";settlement[0]="free-v1";
    k:=pb_capability(cap[..],py_me(p));if k<0 {return false;}
    if c.text {k=json_raw(cap[..],0,py_me(p));k=json_raw(cap[..],k,":pylon/text");if k<0 {return false;}}
    services[0]=PbService.{capability=cast(string)cap[0..<k],model=py_identity(p),lanes=lanes[0..<1]};
    free:=pq_free(p[0].q[..]);if p[0].life.status!=PbStatus.online {free=0;}
    b:=PbBeacon.{provider=py_me(p),pylon=c.slug,label=c.label,status=p[0].life.status,generation=p[0].life.generation,since=p[0].life.since,
        observed_at=observed,valid_until=pb_valid_until(observed,c.ttl),hardware=PbClass.{family=c.family,tier=pb_tier(c.family,c.memory_gb),memory_gb=c.memory_gb},
        total=PQ_SLOTS,free=free,services=services[0..<1],settlement=settlement[0..<1]};
    if c.text {b.meta="{\"backend_profile\":\"psionic-gptoss-responses-v1\",\"input\":\"public-text\",\"max_input_bytes\":1024,\"max_output_tokens\":128}";}
    scratch:[8192]u8;out:[16384]u8;n:=ph_beacon(b,PbAuth.{},scratch[..],out[..]);
    if n<0 {print("pylon: the beacon writer refused\n");return false;}
    p[0].observed=observed;
    snap:=pb_snap(p[0].life,pq_free(p[0].q[..]),1);p[0].life=pb_sent(p[0].life,snap,now);
    p[0].beacons+=1;
    // A newer beacon replaces one still waiting to go out (after a drop).
    bs:=p[0].beacon_slot;
    if bs>=0 && (p[0].rl[0].pubs[bs].state==RP_QUEUED || p[0].rl[0].pubs[bs].state==RP_SENT) {x:=rl_cancel_publish(p[0].rl[..],bs);}
    print("pylon: beacon % generation % free % of % (connection %)\n",pb_status_name(b.status),b.generation,free,PQ_SLOTS,p[0].gen);
    p[0].beacon_slot=py_publish(p,cast(string)out[0..<n],"beacon");
    return p[0].beacon_slot>=0;
}
py_relay_list :: (p:[]Py,now:int)->bool {
    c:=p[0].cfg[0];relays:[8]PrRelay;
    for k:0..<c.list_count {relays[k]=PrRelay.{url=c.lists[k]};}
    out:[4096]u8;n:=pr_write(out[..],py_me(p),now,relays[0..<c.list_count]);
    if n<0 {print("pylon: the relay list writer refused\n");return false;}
    print("pylon: relay list of %\n",c.list_count);
    p[0].list_slot=py_publish(p,cast(string)out[0..<n],"relay list");
    return p[0].list_slot>=0;
}

// ---- jobs ----------------------------------------------------------------------

py_keep :: (p:[]Py,slot:int,jb:PdJob,body:string) {
    for i:0..<64 {p[0].slots[slot].id[i]=jb.id[i];p[0].slots[slot].caller[i]=jb.caller[i];}
    for i:0..<jb.request.count {p[0].slots[slot].request[i]=jb.request[i];}
    for i:0..<body.count {p[0].slots[slot].body[i]=body[i];}p[0].slots[slot].n=body.count;
    j:=jb;j.id=cast(string)p[0].slots[slot].id[..];j.caller=cast(string)p[0].slots[slot].caller[..];
    j.request=cast(string)p[0].slots[slot].request[0..<jb.request.count];j.target="";p[0].slots[slot].held=j;
}
// book:begin event
// ev is verified (py_take) and relay.coax delivered it once.
py_event :: (p:[]Py,event:NostrEvent) {
    if p[0].cfg[0].probe {p90_observe(p,event);return;}
    if p[0].cfg[0].text {p90_event(p,event);return;}
    ev:=event;
    if !pq_seen(p[0].q[..],ev.id[..]) {p[0].duplicates+=1;py_again(p,ev.id[..]);return;}
    idh:[64]u8;pkh:[64]u8;id:=py_hex(ev.id[..],idh[..]);caller:=py_hex(ev.public_key[..],pkh[..]);
    raw:=ev.original[ev.content_from..<ev.content_to];payload:[PY_OUT]u8;k:=json_unescape(raw,payload[..]);
    plain:[PY_OUT]u8;opened:=Nip44Result.{error=NIP44_PAYLOAD};
    if ev.kind==PD_REQUEST && k>0 {opened=py_open_payload(p,caller,cast(string)payload[0..<k],plain[..]);}
    decrypted:=opened.error==NIP44_OK;
    plaintext:=ifx decrypted then cast(string)plain[0..<opened.written] else "";
    env:=PdEnvelope.{kind=ev.kind,id=id,pubkey=caller,created_at=ev.created_at,tags=ev.original[ev.tags_from..<ev.tags_to],plaintext=plaintext};
    body:[16384]u8;now:=pyh_now_s();jb:=pd_admit(env,py_me(p),now,body[..]);
    draining:=p[0].life.status!=PbStatus.online;
    route:=pq_route(true,ev.kind,decrypted,cast(int)jb.code,cast(int)jb.type,jb.answerable,draining,pq_free(p[0].q[..]));
    print("pylon: event % kind % -> % (%)\n",py_short(id),ev.kind,route,jb.code);
    if route==PqRoute.ignore {p[0].ignored+=1;return;}
    if route==PqRoute.refuse {ok:=py_status(p,jb,jb.code);return;}
    if route==PqRoute.busy {ok:=py_status(p,jb,PdCode.busy);return;}
    if route==PqRoute.cancel {
        for i:0..<PQ_SLOTS {
            s:=p[0].q[0].slots[i].state;if s==PqState.free {continue;}
            c:=pd_cancel(p[0].slots[i].held,s==PqState.running,jb);
            if c==PdCancel.drop && pq_cancel(p[0].q[..],i)==1 {
                p[0].cancelled+=1;print("pylon: cancel % drops waiting job %\n",py_short(id),py_short(p[0].slots[i].held.id));
                ok:=py_status(p,p[0].slots[i].held,PdCode.cancelled);
            } else if c==PdCancel.stop {
                // This host runs one decision at a time and reads frames only
                // between decisions, so a running job is never seen here.
                print("pylon: cancel % names the running job %; it finishes\n",py_short(id),py_short(p[0].slots[i].held.id));
            }
        }
        return;
    }
    slot:=pq_put(p[0].q[..]);
    if slot<0 {ok:=py_status(p,jb,PdCode.busy);return;}
    py_keep(p,slot,jb,cast(string)body[0..<jb.body]);
}
// book:end event
py_run :: (p:[]Py,slot:int) {
    if p[0].cfg[0].text {p90_run(p,slot);return;}
    jb:=p[0].slots[slot].held;now:=pyh_now_s();
    budget:=pq_budget(pd_left_ms(jb,now),p[0].cfg[0].decide_ms);
    r:PyHttp;resp:[PY_HTTP]u8;started:=cxsock_now_ms();
    if budget.ms>0 {r=py_http(p,cast(string)p[0].slots[slot].body[0..<p[0].slots[slot].n],budget.ms,resp[..]);}
    else {r.timed_out=true;}
    out:[PY_OUT]u8;written:=PdOut.{code=PdCode.internal};refused:=PQ_NONE;
    receipt:[512]u8;
    if r.reached && r.status==200 {
        m:=json_raw(receipt[..],0,"{\"attempt_id\":");attempt:[160]u8;a:=json_raw(attempt[..],0,jb.request);a=json_raw(attempt[..],a,"#");a=json_write_int(attempt[..],a,jb.attempt);
        m=json_write_string(receipt[..],m,cast(string)attempt[0..<a]);m=json_raw(receipt[..],m,",\"schema\":\"openagents.receipt.execution.v1\",\"transport\":\"relay\"}");
        written=pd_result(out[..],jb,r.body,p[0].cfg[0].slug,py_me(p),PY_VERSION,py_identity(p),cast(string)receipt[0..<m]);
    } else if r.reached {refused=py_refused(r.body);}
    a:=pq_answer(r.reached,r.timed_out,r.status,cast(int)written.code,refused);
    took:=cxsock_now_ms()-started;
    if a.result {
        p[0].answered+=1;
        print("pylon: job % -> 26910 answered by % in % ms\n",py_short(jb.id),py_identity(p),took);
        ok:=py_reply(p,jb,PD_RESULT,cast(string)out[0..<written.written],"result");
    } else {ok:=py_status(p,jb,cast(PdCode)a.code);}
    done:=pq_done(p[0].q[..],slot);
}
// An OK, CLOSED or NOTICE frame's message, for the log ("" for others).
py_message :: (text:string)->string {
    m:=nostr_message_read(text);if m.error!=NM_OK {return "";}
    return nm_text(m,m.message);
}
// One relay message: relay_read.coax's rl_read reads it (message.coax) and
// checks an EVENT's id and signature, then relay.coax's machine decides.
py_take :: (p:[]Py) {
    c:=p[0].conn[..];r:=p[0].rl[..];
    text:=cast(string)c[0].text[0..<c[0].text_n];
    scratch:[NE_MAX_OUTPUT]u8;in:=rl_read(text,scratch[..],false);
    if in.kind==0 {
        // A refused frame, or an AUTH challenge (message.coax's NM_TYPE):
        // nip42_input takes a challenge; anything else counts as RL_BAD.
        if nip42_input(r,p[0].n42[..],p[0].gen,text)>=0 {return;}
        d:=rl_input(r,p[0].gen,in);print("pylon: unreadable frame (% bytes)\n",text.count);return;
    }
    d:=rl_input(r,p[0].gen,in);
    if in.kind==RL_IN_EVENT {
        if d==RL_FORGED {p[0].forged+=1;print("pylon: event refused by verification\n");return;}
        if d==RL_DUPLICATE {p[0].duplicates+=1;py_again(p,in.id[..]);return;}
        if d!=RL_DELIVER {p[0].ignored+=1;print("pylon: event for % not taken (%)\n",in.sub,d);return;}
        // rl_read verified these bytes; read them again for the event's fields.
        m:=nostr_message_read(text);ev:=nostr_event_read(text[m.event.from..<m.event.to],scratch[..],false);
        same:=ev.error==NE_OK;for i:0..<32 {if ev.id[i]!=in.id[i] {same=false;}}
        if !same {p[0].ignored+=1;print("pylon: delivered event unreadable\n");return;}
        py_event(p,ev);
        return;
    }
    if in.kind==RL_IN_OK {
        if d==RL_AUTH {
            if in.accepted {p[0].auths+=1;print("pylon: authenticated to % as % (connection %)\n",p[0].cfg[0].relay,py_me(p),p[0].gen);}
            else {print("pylon: the relay refused NIP-42 AUTH: %\n",py_message(text));}
            return;
        }
        if d==RL_ACK {
            hex:[64]u8;
            if in.accepted {p[0].accepted+=1;}else {p[0].refused+=1;print("pylon: relay refused %: %\n",py_short(py_hex(in.id[..],hex[..])),py_message(text));}
        }
        return;
    }
    if in.kind==RL_IN_EOSE {
        if d==RL_EOSE {p[0].caught_up+=1;print("pylon: caught up on % (connection %)\n",in.sub,p[0].gen);}
        return;
    }
    if in.kind==RL_IN_CLOSED {print("pylon: relay closed %: %\n",in.sub,py_message(text));return;}
    print("pylon: notice %\n",py_message(text));
}
py_jitter :: ()->int {
    b:[4]u8;if !py_draw(4,b[..]) {return 0;}
    return (cast(int)b[0]<<24)|(cast(int)b[1]<<16)|(cast(int)b[2]<<8)|cast(int)b[3];
}
// The connection ended (or is being given up): relay.coax backs off.
py_drop :: (p:[]Py,why:string) {
    relay_conn_drop(p[0].conn[..]);now:=cxsock_now_ms();
    if rl_dropped(p[0].rl[..],p[0].gen,now,py_jitter()) {
        p[0].drops+=1;
        print("pylon: connection % ended (%); reconnecting in % ms\n",p[0].gen,why,p[0].rl[0].deadline-now);
    }
}
// NIP-42 for this connection's challenge: a signed 22242 and the machine's hook.
py_auth :: (p:[]Py)->bool {
    tags:[1024]u8;t:=nip42_template(p[0].n42[..],p[0].gen,pyh_now_s(),tags[..]);
    if t.error!=N42_OK {print("pylon: no NIP-42 challenge (%)\n",t.error);return false;}
    scratch:[PY_OUT]u8;signed:[PY_OUT]u8;
    n:=py_sign(p,t.created_at,t.kind,t.tags,t.content,scratch[..],signed[..]);
    id:[32]u8;
    if n<72 || cast(string)signed[0..<7]!="{\"id\":\"" || !py_unhex(cast(string)signed[7..<71],id[..]) {return false;}
    frame:[PY_OUT]u8;m:=json_raw(frame[..],0,"[\"AUTH\",");m=json_raw(frame[..],m,cast(string)signed[0..<n]);m=json_raw(frame[..],m,"]");
    p[0].sent+=1;
    return m>0 && relay_conn_send(p[0].conn[..],cast(string)frame[0..<m]) && rl_auth_sent(p[0].rl[..],id[..]);
}
// What the machine asks to send: the job REQ (since from pq_since), CLOSE,
// and the kept EVENT frames. False when the socket failed.
py_flush :: (p:[]Py)->bool {
    r:=p[0].rl[..];
    while r[0].state==RL_OPEN {
        o:=rl_next(r,cxsock_now_ms());
        if o.kind==RL_OUT_NONE || o.kind==RL_OUT_AUTH {return true;}
        sb:[24]u8;id:=rl_sub_text(o.slot,r[0].subs[o.slot].serial,sb[..]);
        ok:=false;
        if o.kind==RL_OUT_REQ {
            since:=pq_since(o.has_since,o.since,p[0].first_since);
            kinds:=[1]int.[ifx p[0].cfg[0].text then 5050 else 25910];me:=[1]string.[py_me(p)];
            tags:=[1]NostrTagFilter.[NostrTagFilter.{name='p',values=me[..]}];
            f:NostrFilter;f.has_kinds=true;f.kinds=kinds[..];f.tags=tags[..];f.has_since=true;f.since=since.since;
            probe_kinds:=[3]int.[30200,6050,7000];authors:=[1]string.[p[0].probe[0].provider];
            if p[0].cfg[0].probe {f.kinds=probe_kinds[..];f.tags=tags[0..<0];f.has_authors=true;f.authors=authors[..];f.has_limit=true;f.limit=32;}
            filters:=[1]NostrFilter.[f];
            req:[512]u8;n:=nostr_message_write_req(id,filters[..],req[..],false);
            print("pylon: REQ % since % (connection %)%\n",id,since.since,p[0].gen,ifx since.resumed then ", resumed from the newest job delivered" else "");
            ok=n>0 && relay_conn_send(p[0].conn[..],cast(string)req[0..<n]);
        } else if o.kind==RL_OUT_CLOSE {
            close:[64]u8;n:=nostr_message_write_close(id,close[..],false);
            ok=n>0 && relay_conn_send(p[0].conn[..],cast(string)close[0..<n]);
        } else if o.kind==RL_OUT_EVENT {
            ok=relay_conn_send(p[0].conn[..],cast(string)p[0].outbox[o.slot].text[0..<p[0].outbox[o.slot].n]);
        }
        if !ok {return false;}
    }
    return true;
}
// One turn of the connection: connect when the machine says so, then
// pq_wire's step (AUTH, the beacon, the queued frames), then at most wait_ms
// for one relay message. relay_conn_poll's result (RC_NONE when it did not poll).
py_step :: (p:[]Py,wait_ms:int)->int {
    r:=p[0].rl[..];c:=p[0].conn[..];relay:=p[0].cfg[0].relay;now:=cxsock_now_ms();
    t:=rl_tick(r,now);
    if r[0].state==RL_IDLE || t==RL_DO_CONNECT {
        g:=rl_start(r,now);if g<0 {return RC_NONE;}
        p[0].gen=g;p[0].connects+=1;
        if !relay_conn_open(c,relay) || !rl_opened(r,g,cxsock_now_ms()) {py_drop(p,"no WebSocket");return RC_NONE;}
        p[0].opened_ms=cxsock_now_ms();
        print("pylon: connection % open to %\n",g,relay);
    } else if t==RL_DO_TIMEOUT {py_drop(p,"connect timed out");return RC_NONE;}
    if r[0].state==RL_BACKOFF {
        left:=r[0].deadline-cxsock_now_ms();
        if wait_ms>0 && left>0 {x:=pyh_sleep_ms(ifx left<wait_ms then left else wait_ms);}
        return RC_NONE;
    }
    if r[0].state!=RL_OPEN {return RC_NONE;}
    w:=pq_wire(r[0].auth==RA_CHALLENGED,r[0].auth==RA_OK,p[0].announced==p[0].gen,cxsock_now_ms()-p[0].opened_ms,PY_IO_MS);
    if w==PqWire.drop {py_drop(p,"no NIP-42 AUTH accepted in time");return RC_NONE;}
    if w==PqWire.auth && !py_auth(p) {py_drop(p,"AUTH not sent");return RC_NONE;}
    if w==PqWire.announce {
        p[0].announced=p[0].gen;
        if !p[0].cfg[0].probe && !py_beacon(p,pyh_now_s()) {print("pylon: the beacon for connection % was not queued\n",p[0].gen);}
    }
    if (w==PqWire.announce || w==PqWire.flow) && !py_flush(p) {py_drop(p,"send failed");return RC_NONE;}
    ev:=relay_conn_poll(c,wait_ms);
    if ev==RC_TEXT {py_take(p);return ev;}
    if ev==RC_NONE {return ev;}
    py_drop(p,ifx ev==RC_CLOSED then "closed by the relay" else "failed");
    return ev;
}
// Reads frames: the first within wait_ms, then whatever is already there.
py_pump :: (p:[]Py,wait_ms:int) {
    ev:=py_step(p,wait_ms);
    while ev==RC_TEXT {ev=py_step(p,0);}
}
// Waits at most limit_ms for the OK of publish slot (reconnecting meanwhile).
py_acked :: (p:[]Py,slot:int,limit_ms:int)->bool {
    if slot<0 {return false;}
    end:=cxsock_now_ms()+limit_ms;
    while cxsock_now_ms()<end {
        st:=p[0].rl[0].pubs[slot].state;
        if st==RP_ACCEPTED {return true;}
        if st==RP_REFUSED {return false;}
        py_pump(p,100);
    }
    return false;
}
// ---- chapter 159: the self-check and the doctor -----------------------------

// One named file through the host: its bytes into out, the length, -1 when it
// can't be read, -2 when it is missing.
py_read_file :: (path:string,out:[]u8)->int {
    r:=pyh_file_path_clear();for b:path {if pyh_file_path_push(cast(int)b)!=0 {return -1;}}
    n:=pyh_file_read();if n<0 {return n;}
    if n>out.count {return -1;}
    for i:0..<n {out[i]=cast(u8)pyh_file_byte(i);}
    return n;
}
py_write_file :: (path:string,text:string)->bool {
    r:=pyh_file_path_clear();for b:path {if pyh_file_path_push(cast(int)b)!=0 {return false;}}
    for b:text {if pyh_file_write_push(cast(int)b)!=0 {return false;}}
    return pyh_file_write_commit()==0;
}
// Reserve the durable epoch while holding the sibling lock for this process's
// lifetime. No relay publication is possible before the receipt is accepted.
py_generation :: (p:[]Py)->int {
    path:[1024]u8;lock:[1024]u8;text:[128]u8;record:[128]u8;
    n:=json_raw(path[..],0,p[0].cfg[0].state);n=json_raw(path[..],n,".generation");if n<0 {return 0;}
    counter:=cast(string)path[0..<n];k:=json_raw(lock[..],0,counter);k=json_raw(lock[..],k,".lock");if k<0 {return 0;}
    r:=pyh_file_path_clear();for b:lock[0..<k] {if pyh_file_path_push(cast(int)b)!=0 {return 0;}}
    if pyh_file_lock()!=0 {print("pylon: generation state already in use or its lock is unavailable\n");return 0;}
    used:=py_read_file(counter,text[..]);if used==-1 {print("pylon: generation state cannot be read\n");return 0;}
    prior:=ifx used>=0 then cast(string)text[0..<used] else "";
    plan:=pyg_plan(prior,py_me(p),used==-2);
    if plan.code!=PygCode.ok {print("pylon: generation state refused (code %)\n",cast(int)plan.code);return 0;}
    size:=pyg_encode(py_me(p),plan.generation,record[..]);if size<0 {return 0;}
    generation:=pyg_ready(plan,py_write_file(counter,cast(string)record[0..<size]));
    if generation==0 {print("pylon: generation state was not durably committed\n");}
    return generation;
}
PyCheckRun :: struct {
    set_text:[65536]u8;state_text:[256]u8;
    cases:[PS_CASES]PsCase;answers:[PS_CASES][PY_HTTP]u8;views:[PS_CASES]string;
    set:PsSet;check:PsCheck;last:string;gate:PsGate;facts:PsFacts;ms:int;
}
// The probe has named the engine's identity. Read the set and the last
// served identity, ask the engine every case, and decide; nothing is
// written here.
py_selfcheck :: (p:[]Py,w:[]PyCheckRun) {
    c:=p[0].cfg[0];f:=PsFacts.{config=true,engine=true};
    id:=py_identity(p);
    n:=py_read_file(c.state,w[0].state_text[..]);
    if n==-1 {f.gate=PsGate.unnamed;w[0].facts=f;w[0].gate=PsGate.unnamed;print("pylon: the identity state % can't be read\n",c.state);return;}
    w[0].last="";
    if n>0 {e:=n;while e>0 && w[0].state_text[e-1]=='\n' {e-=1;}w[0].last=cast(string)w[0].state_text[0..<e];}
    w[0].gate=ps_gate(w[0].last,c.declared,id);f.gate=w[0].gate;
    k:=py_read_file(c.references,w[0].set_text[..]);
    if k<0 {f.set=PsStatus.header;w[0].facts=f;print("pylon: the reference set % can't be read\n",c.references);return;}
    w[0].set=ps_read_set(cast(string)w[0].set_text[0..<k],w[0].cases[..]);f.set=w[0].set.status;
    if f.set!=PsStatus.ok {w[0].facts=f;return;}
    started:=cxsock_now_ms();
    for i:0..<w[0].set.count {
        w[0].views[i]="";
        r:=py_http(p,w[0].cases[i].request,c.decide_ms,w[0].answers[i][..]);
        if r.reached && r.status==200 {w[0].views[i]=r.body;}
    }
    w[0].ms=cxsock_now_ms()-started;
    w[0].check=ps_check(w[0].set,w[0].cases[..],id,w[0].views[0..<w[0].set.count]);
    f.verdict=w[0].check.verdict;w[0].facts=f;
}
PS_STEP_NAMES :: [6]string.["healthy","config","engine","identity","references","check"];
PS_GATE_NAMES :: [6]string.["first start","same as last served","a declared change","the engine names none","an undeclared change","not the declared identity"];
PS_CODE_NAMES :: [7]string.["pass","malformed answer","other kind","other choice","other options","missing","value out of tolerance"];
PS_SET_NAMES :: [7]string.["ok","header","line","identity","tolerance","cases","expect"];
py_report :: (p:[]Py,w:[]PyCheckRun) {
    c:=p[0].cfg[0];f:=w[0].facts;
    print("doctor: engine % answered as %\n",c.model,py_identity(p));
    print("doctor: identity: % (last served: %)\n",PS_GATE_NAMES[cast(int)f.gate],ifx w[0].last.count>0 then w[0].last else "none");
    if f.set!=PsStatus.ok {print("doctor: reference set %: refused (%, line %)\n",c.references,PS_SET_NAMES[cast(int)f.set],w[0].set.line);return;}
    print("doctor: reference set %: % cases for %\n",c.references,w[0].set.count,w[0].set.identity);
    k:=w[0].check;
    if k.verdict==PsVerdict.passed {print("doctor: self-check passed: % cases in % ms, largest error % billionths (tolerance %)\n",w[0].set.count,w[0].ms,k.worst,w[0].set.tolerance);}
    else if k.verdict==PsVerdict.other_model {print("doctor: self-check refused: the set is for another identity\n");}
    else if k.verdict==PsVerdict.no_references {print("doctor: self-check refused: no references\n");}
    else {print("doctor: self-check failed at case % (%): %, option %, error % billionths\n",k.failed,w[0].cases[k.failed].question,PS_CODE_NAMES[cast(int)k.item.code],k.item.option,k.item.error);}
}

py_main :: (p:[]Py)->int {
    if !py_config(p[0].cfg[..]) {
        if pyh_argc()>1 && py_arg(p[0].cfg[..],1)=="--doctor" {print("doctor: verdict config\n");}
        return 2;
    }
    c:=p[0].cfg[0];
    if c.doctor {
        if c.text {return ifx p90_start(p,false) then 0 else 6;}
        // Read-only: no key, no relay, no state written.
        w:[1]PyCheckRun;
        if !py_probe(p) {print("doctor: verdict engine\n");return 3;}
        py_selfcheck(p,w[..]);py_report(p,w[..]);
        step:=ps_doctor(w[0].facts);print("doctor: verdict %\n",PS_STEP_NAMES[cast(int)step]);
        return ifx step==PsStep.healthy then 0 else 10+cast(int)step;
    }
    // TEST-ONLY key: sha256 of the label. Never printed.
    label:[256]u8;label_n:=c.label_key.count;
    if c.label_file.count>0 {
        r:=pyh_file_path_clear();for b:c.label_file {if pyh_file_path_push(cast(int)b)!=0 {return 2;}}
        label_n=pyh_label_read();
        if label_n<0 || label_n>256 {print("pylon: demo label file must be a private regular file owned by this user\n");return 2;}
        for i:0..<label_n {label[i]=cast(u8)pyh_label_byte(i);}
        r=pyh_label_clear();
        if !pyd_label_ok(cast(string)label[0..<label_n]) {for i:0..<256 {label[i]=0;}print("pylon: demo label file must contain exactly 64 lowercase hex characters\n");return 2;}
    } else {
        if label_n>256 {return 2;}for i:0..<label_n {label[i]=c.label_key[i];}
    }
    label_status:=sha256_hash_checked(label[0..<label_n],p[0].key[..],false);
    for i:0..<256 {label[i]=0;}
    if label_status!=SHA_OK {return 2;}
    if !py_public(p) {print("pylon: the signer refused the key\n");return 2;}
    print("pylon: TEST-ONLY key, signed in Coax; pubkey %\n",py_me(p));
    public_key:[32]u8;public_text:[128]u8;
    if py_unhex(py_me(p),public_key[..]) {
        encoded:=nip19_encode_checked(N19_NPUB,cast(string)public_key[..],public_text[..],false);
        if encoded.error==NC_OK {print("pylon: npub %\n",cast(string)public_text[0..<encoded.written]);}
    }
    if c.text {
        if !p90_start(p,true) {return 6;}
    } else {
    if !py_probe(p) {return 3;}
    {
        w:[1]PyCheckRun;py_selfcheck(p,w[..]);py_report(p,w[..]);
        if !ps_may_serve(w[0].facts) {print("pylon: not serving: the self-check did not pass (%)\n",PS_STEP_NAMES[cast(int)ps_doctor(w[0].facts)]);return 6;}
        if w[0].gate!=PsGate.same && !py_write_file(c.state,py_identity(p)) {print("pylon: the identity state % can't be written\n",c.state);return 6;}
    }
    }
    generation:=py_generation(p);if generation==0 {return 6;}
    if nip42_init(p[0].n42[..],c.relay)!=N42_OK {print("pylon: NIP-42 refuses the relay URL\n");return 4;}
    now:=pyh_now_s();
    p[0].first_since=now-PD_PAST;
    p[0].sub=rl_subscribe(p[0].rl[..]);
    p[0].life=pb_start(PbLife.{generation=generation-1},now);
    if p[0].sub<0 || !py_relay_list(p,now) {return 5;}
    // The first connection: AUTH, the beacon, the REQ and the list, all acknowledged.
    if !py_acked(p,p[0].list_slot,30000) {print("pylon: relay list not accepted\n");return 5;}
    if !py_acked(p,p[0].beacon_slot,30000) {print("pylon: beacon not accepted\n");return 5;}
    print("pylon: online, waiting for jobs\n");
// book:begin loop
    while true {
        // Frames first, so a job that arrived while the engine ran is held
        // before the stop request is weighed. A dropped connection comes
        // back here: py_step reconnects, re-authenticates, republishes the
        // beacon and resubscribes, and queued answers go out after AUTH.
        py_pump(p,200);
        now=pyh_now_s();
        l:=pq_life(pyh_stop()==1,pq_held(p[0].q[..]));
        if l==PqLife.off {break;}
        was:=p[0].life.status;
        if l==PqLife.drain {p[0].life=pb_drain(p[0].life);}
        snap:=pb_snap(p[0].life,pq_free(p[0].q[..]),1);
        if pq_beacon_now(pb_due(p[0].life,snap,c.refresh,now),was!=p[0].life.status,l!=PqLife.run) {if !py_beacon(p,now) {return 5;}}
        slot:=pq_next(p[0].q[..]);
        if slot>=0 {py_run(p,slot);}
    }
// book:end loop
    p[0].life=pb_stop(p[0].life);
    if !py_beacon(p,pyh_now_s()) || !py_acked(p,p[0].beacon_slot,PY_IO_MS) {print("pylon: offline beacon not accepted\n");}
    if rl_unsubscribe(p[0].rl[..],p[0].sub) {sent:=py_flush(p);}
    rl_shutdown(p[0].rl[..]);
    ok:=relay_conn_close(p[0].conn[..],WS_CLOSE_NORMAL);
    for i:0..<32 {p[0].key[i]=0;}
    print("pylon: offline. sent %, accepted %, refused %, answered %, refusals %, cancelled %, forged %, duplicates %, ignored %, beacons %, connections %, drops %, auths %, catch-ups %\n",
        p[0].sent,p[0].accepted,p[0].refused,p[0].answered,p[0].refusals,p[0].cancelled,p[0].forged,p[0].duplicates,p[0].ignored,p[0].beacons,
        p[0].connects,p[0].drops,p[0].auths,p[0].caught_up);
    return 0;
}
main :: () {
    p:[1]Py;r:=py_main(p[..]);
    if r!=0 {print("pylon: stopped (%)\n",r);}
    x:=pyh_status(r);
}
