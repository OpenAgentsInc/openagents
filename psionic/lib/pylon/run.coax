// Chapter 19: the Pylon program. One process holds a relay connection,
// authenticates with NIP-42, publishes its NIP-65 relay list and its 30200
// beacon, subscribes to the 25910 jobs addressed to its key, and answers each
// with a 26910 result or a 27010 status, decided by the chapter 16 engine.
// This file wires units together; it decides nothing itself. The decisions
// are decision.coax, beacon.coax, relays.coax and queue.coax (#authority),
// ws.coax and nip42.coax (#authority), and nip44.coax (#authority).
//
// The host (psionic/platform/pylon-host.c) gives arguments, the wall clock
// and a stop request; sockets are socket-native.c, entropy entropy-foreign.c,
// and the signer's process process-native.c.
//
// TEST-ONLY until openagents-d7's units land on main (see the record,
// docs/verification/psionic-ch19-2026-10-29.md, for the exact swaps):
//   - py_sign_step stands in for nostr_event_sign_step (event_sign.coax) and
//     py_shared_x for NIP-44's conversation key from two keys. Both ask
//     psionic/tests/pylon/sign_double.ts (@noble/curves) over a pipe.
//   - py_frame reads relay-to-client frames until message.coax lands.
//   - The key is sha256 of --test-key-label. --key-file is refused while the
//     signer is the double.
#import "Basic";
#load "host.coax";
#load "queue.coax";
#load "../../../coax/lib/net/ws.coax";
#load "../../../coax/lib/crypto/entropy.coax";
#load "../../../coax/lib/nostr/event.coax";
#load "../../../coax/lib/nostr/nip44.coax";
#load "../../../coax/lib/nostr/nip42.coax";

// queue.coax names these PdCode and PdType values as integers.
#assert PQ_NONE==cast(int)PdCode.none && PQ_BUSY==cast(int)PdCode.busy && PQ_TIMEOUT==cast(int)PdCode.timeout;
#assert PQ_CANCELLED==cast(int)PdCode.cancelled && PQ_MISMATCH==cast(int)PdCode.identity_mismatch && PQ_INTERNAL==cast(int)PdCode.internal;
#assert PQ_CODES==cast(int)PdCode.internal+1 && PQ_CALL==cast(int)PdType.call && PQ_CANCEL==cast(int)PdType.cancel && PQ_REQUEST==PD_REQUEST;

cxsock_host_push :: (byte: int) -> int #foreign;
cxsock_connect :: (port: int, timeout_ms: int) -> int #foreign;
cxsock_write :: (h: int, byte: int) -> int #foreign;
cxsock_flush :: (h: int, timeout_ms: int) -> int #foreign;
cxsock_read :: (h: int, timeout_ms: int) -> int #foreign;
cxsock_byte :: (h: int, i: int) -> int #foreign;
cxsock_close :: (h: int) -> int #foreign;
cxsock_now_ms :: () -> int #foreign;
cxrand_fill :: (n: int) -> int #foreign;
cxrand_byte :: (i: int) -> int #foreign;
cxproc_new :: () -> int #foreign;
cxproc_push :: (h: int, field: int, byte: int) -> int #foreign;
cxproc_end :: (h: int, field: int) -> int #foreign;
cxproc_spawn :: (h: int) -> int #foreign;
cxproc_read_line :: (h: int, timeout_ms: int) -> int #foreign;
cxproc_line_byte :: (h: int, i: int) -> int #foreign;
cxproc_write :: (h: int, byte: int) -> int #foreign;
cxproc_flush :: (h: int) -> int #foreign;
cxproc_release :: (h: int) -> int #foreign;
pyh_argc :: () -> int #foreign;
pyh_arg_len :: (i: int) -> int #foreign;
pyh_arg_byte :: (i: int, k: int) -> int #foreign;
pyh_now_s :: () -> int #foreign;
pyh_stop_path_push :: (byte: int) -> int #foreign;
pyh_stop :: () -> int #foreign;

PY_IN :: 262144; PY_MSG :: 262144; PY_OUT :: 131072;
PY_IO_MS :: 5000;
PY_SIGN_MS :: 10000;
PY_SUB :: "pylon-jobs";
PY_VERSION :: "psionic-pylon-v1";
PY_BODY :: 16384;       // the largest server request this host forwards
PY_HTTP :: 131072;
PY_ARGS :: 8192;
PY_LISTS :: 8;
PY_DEFAULT_LIST :: "wss://relay.openagents.com";   // owner decision, 2026-10-30
// rx results besides ws.coax's WS_EV_* events.
PY_NONE :: 100; PY_EOF :: 101; PY_FAIL :: 102;
// Frame verbs (py_frame), until message.coax.
PF_UNKNOWN :: 0; PF_EVENT :: 1; PF_OK :: 2; PF_EOSE :: 3; PF_CLOSED :: 4; PF_NOTICE :: 5; PF_AUTH :: 6;

// ---- the signing double (TEST-ONLY) ----------------------------------------

// The double's process. nostr_event_sign_step's work is [1]NostrSignWork.
PySignWork :: struct {proc:int=-1;}
py_hex :: (bytes:[]u8,out:[]u8)->string {
    digits:="0123456789abcdef";
    for i:0..<bytes.count {out[2*i]=digits[bytes[i]>>4];out[2*i+1]=digits[bytes[i]&15];}
    return cast(string)out[0..<2*bytes.count];
}
py_unhex :: (s:string,out:[]u8)->bool {
    if s.count!=2*out.count {return false;}
    for i:0..<out.count {
        v:=0;
        for k:0..<2 {
            c:=s[2*i+k];d:=-1;
            if c>='0' && c<='9' {d=cast(int)(c-'0');}else if c>='a' && c<='f' {d=cast(int)(c-'a')+10;}
            if d<0 {return false;}v=v*16+d;
        }
        out[i]=cast(u8)v;
    }
    return true;
}
// One request line to the double, one answer line back into out.
py_double :: (work:[]PySignWork,line:string,out:[]u8)->int {
    h:=work[0].proc;if h<0 {return -1;}
    for b:line {if cxproc_write(h,cast(int)b)!=0 {return -1;}}
    if cxproc_write(h,10)!=0 || cxproc_flush(h)!=0 {return -1;}
    n:=cxproc_read_line(h,PY_SIGN_MS);
    if n<=0 || n>out.count {return -1;}
    for i:0..<n {out[i]=cast(u8)cxproc_line_byte(h,i);}
    if n>8 && cast(string)out[0..<9]=="{\"error\":" {return -1;}
    return n;
}
// book:begin sign
// TEST-ONLY, shaped as nostr_event_sign_step: the signed event's JSON into
// out and its length, 0 for "call again" (never, here), -1 refused.
py_sign_step :: (key:[]u8,aux:[]u8,created_at:int,kind:int,tags:string,content:string,work:[]PySignWork,scratch:[]u8,out:[]u8,overlap:bool)->int {
    if overlap || key.count!=32 || aux.count!=32 || !json_valid(tags) {return -1;}
    hk:[64]u8;ha:[64]u8;
    n:=json_raw(scratch,0,"{\"op\":\"sign\",\"key\":\"");n=json_raw(scratch,n,py_hex(key,hk[..]));
    n=json_raw(scratch,n,"\",\"aux\":\"");n=json_raw(scratch,n,py_hex(aux,ha[..]));
    n=json_raw(scratch,n,"\",\"created_at\":");n=json_write_int(scratch,n,created_at);
    n=json_raw(scratch,n,",\"kind\":");n=json_write_int(scratch,n,kind);
    n=json_raw(scratch,n,",\"tags\":");n=json_raw(scratch,n,tags);
    n=json_raw(scratch,n,",\"content\":");n=json_write_string(scratch,n,content);n=json_raw(scratch,n,"}");
    for i:0..<hk.count {hk[i]=0;}
    if n<0 {return -1;}
    m:=py_double(work,cast(string)scratch[0..<n],out);
    for i:0..<n {scratch[i]=0;}
    return m;
}
// book:end sign
// TEST-ONLY: the raw shared x of key and peer (x-only hex), for NIP-44's
// conversation key. Replaced by NIP-44's conversation key from two keys.
py_shared_x :: (key:[]u8,peer:string,work:[]PySignWork,out:[]u8)->bool {
    if key.count!=32 || out.count!=32 || !pt_hex64(peer) {return false;}
    hk:[64]u8;line:[256]u8;
    n:=json_raw(line[..],0,"{\"op\":\"x\",\"key\":\"");n=json_raw(line[..],n,py_hex(key,hk[..]));
    n=json_raw(line[..],n,"\",\"peer\":\"");n=json_raw(line[..],n,peer);n=json_raw(line[..],n,"\"}");
    for i:0..<64 {hk[i]=0;}
    answer:[256]u8;m:=py_double(work,cast(string)line[0..<n],answer[..]);
    for i:0..<n {line[i]=0;}
    if m!=72 || cast(string)answer[0..<6]!="{\"x\":\"" {return false;}
    return py_unhex(cast(string)answer[6..<70],out);
}
py_public :: (key:[]u8,work:[]PySignWork,out:[]u8)->bool {
    hk:[64]u8;line:[256]u8;
    n:=json_raw(line[..],0,"{\"op\":\"pub\",\"key\":\"");n=json_raw(line[..],n,py_hex(key,hk[..]));n=json_raw(line[..],n,"\"}");
    for i:0..<64 {hk[i]=0;}
    answer:[256]u8;m:=py_double(work,cast(string)line[0..<n],answer[..]);
    for i:0..<n {line[i]=0;}
    if m!=74 || cast(string)answer[0..<8]!="{\"pub\":\"" {return false;}
    for i:0..<64 {out[i]=answer[8+i];}
    return pt_hex64(cast(string)out[0..<64]);
}

// ---- configuration ----------------------------------------------------------

PyConfig :: struct {
    args:[8192]u8;used:int;
    relay:string;relay_host:string;relay_port:int;
    lists:[8]string;list_count:int;
    engine_host:string;engine_port:int;
    model:string;slug:string;label:string;family:string;memory_gb:int;
    label_key:string;key_file:string;bun:string;script:string;node_path:string;stop_file:string;
    decide_ms:int;refresh:int;ttl:int;
}
py_arg :: (c:[]PyConfig,i:int)->string {
    n:=pyh_arg_len(i);if n<0 || c[0].used+n>PY_ARGS {return "";}
    at:=c[0].used;for k:0..<n {c[0].args[at+k]=cast(u8)pyh_arg_byte(i,k);}
    c[0].used+=n;return cast(string)c[0].args[at..<at+n];
}
py_int :: (s:string)->int {v:=json_int(s);if !v.ok {return -1;}return v.value;}
// ws://HOST:PORT[/] or http://HOST:PORT[/...]: host and port, or port -1.
PyUrl :: struct {host:string;port:int;}
py_url :: (url:string,scheme:string)->PyUrl {
    bad:=PyUrl.{port=-1};
    if url.count<=scheme.count || url[0..<scheme.count]!=scheme {return bad;}
    rest:=url[scheme.count..<url.count];colon:=-1;end:=rest.count;
    for i:0..<rest.count {if rest[i]==':' && colon<0 {colon=i;}if rest[i]=='/' && end==rest.count {end=i;}}
    if colon<1 || colon>=end {return bad;}
    port:=py_int(rest[colon+1..<end]);if port<1 || port>65535 {return bad;}
    return PyUrl.{host=rest[0..<colon],port=port};
}
py_usage :: () {
    print("usage: pylon --relay ws://HOST:PORT --engine http://HOST:PORT --model NAME --slug SLUG\n");
    print("             (--test-key-label LABEL | --key-file PATH) --signer-bun BUN --signer-script sign_double.ts --node-path DIR\n");
    print("             [--list URL]... [--label TEXT] [--family gpu|cpu|unified-memory] [--memory-gb N]\n");
    print("             [--decide-ms N] [--refresh S] [--ttl S] [--stop-file PATH]\n");
}
py_config :: (c:[]PyConfig)->bool {
    c[0].label="Psionic Pylon";c[0].family="cpu";c[0].memory_gb=16;c[0].decide_ms=30000;c[0].refresh=60;c[0].ttl=180;
    i:=1;argc:=pyh_argc();
    while i<argc {
        name:=py_arg(c,i);
        if i+1>=argc {print("pylon: % needs a value\n",name);return false;}
        v:=py_arg(c,i+1);i+=2;
        if name=="--relay" {c[0].relay=v;}
        else if name=="--list" {if c[0].list_count>=PY_LISTS-1 {print("pylon: too many --list\n");return false;}c[0].lists[c[0].list_count]=v;c[0].list_count+=1;}
        else if name=="--engine" {u:=py_url(v,"http://");c[0].engine_host=u.host;c[0].engine_port=u.port;}
        else if name=="--model" {c[0].model=v;}
        else if name=="--slug" {c[0].slug=v;}
        else if name=="--label" {c[0].label=v;}
        else if name=="--family" {c[0].family=v;}
        else if name=="--memory-gb" {c[0].memory_gb=py_int(v);}
        else if name=="--test-key-label" {c[0].label_key=v;}
        else if name=="--key-file" {c[0].key_file=v;}
        else if name=="--signer-bun" {c[0].bun=v;}
        else if name=="--signer-script" {c[0].script=v;}
        else if name=="--node-path" {c[0].node_path=v;}
        else if name=="--stop-file" {c[0].stop_file=v;}
        else if name=="--decide-ms" {c[0].decide_ms=py_int(v);}
        else if name=="--refresh" {c[0].refresh=py_int(v);}
        else if name=="--ttl" {c[0].ttl=py_int(v);}
        else {print("pylon: unknown option %\n",name);return false;}
    }
    u:=py_url(c[0].relay,"ws://");c[0].relay_host=u.host;c[0].relay_port=u.port;
    if u.port<0 {print("pylon: --relay must be ws://HOST:PORT (wss:// is not wired into this host yet)\n");return false;}
    if c[0].engine_port<0 || c[0].engine_host.count==0 {print("pylon: --engine must be http://HOST:PORT\n");return false;}
    if c[0].key_file.count!=0 {
        print("pylon: --key-file refused: this build signs through the TEST-ONLY double, which never takes a real key\n");return false;
    }
    if c[0].label_key.count==0 || c[0].bun.count==0 || c[0].script.count==0 || c[0].node_path.count==0 {py_usage();return false;}
    if c[0].model.count==0 || !pb_slug(c[0].slug,PB_SLUG) {py_usage();return false;}
    if c[0].list_count==0 {c[0].lists[0]=PY_DEFAULT_LIST;c[0].list_count=1;}
    have:=false;for k:0..<c[0].list_count {if c[0].lists[k]==c[0].relay {have=true;}}
    if !have {c[0].lists[c[0].list_count]=c[0].relay;c[0].list_count+=1;}
    if pb_valid_until(0,c[0].ttl)<0 || c[0].refresh<PB_REFRESH_MIN || c[0].refresh>PB_REFRESH_MAX || pb_tier(c[0].family,c[0].memory_gb).count==0 || !pb_memory_ok(c[0].memory_gb) {
        print("pylon: --ttl 1..300, --refresh 60..240, and a memory_gb of 8..512 in powers of two\n");return false;
    }
    if c[0].stop_file.count!=0 {for b:c[0].stop_file {if pyh_stop_path_push(cast(int)b)!=0 {return false;}}}
    return true;
}

// ---- the relay connection (ws.coax over socket-native.c) -------------------

PyConn :: struct {
    h:int=-1;gen:int;
    inb:[262144]u8;used:int;
    rd:[1]WsReader;
    msg:[262144]u8;
    ctl:[125]u8;ctl_n:int;
}
py_draw :: (n:int,out:[]u8)->bool {
    if out.count<n || cxrand_fill(n)!=0 {return false;}
    for i:0..<n {b:=cxrand_byte(i);if b<0 || b>255 {return false;}out[i]=cast(u8)b;}
    return true;
}
py_write :: (h:int,bytes:string)->bool {
    for b:bytes {if cxsock_write(h,cast(int)b)!=0 {return false;}}
    return cxsock_flush(h,PY_IO_MS)==0;
}
py_send :: (c:[]PyConn,op:int,payload:string)->bool {
    mask:[4]u8;out:[PY_OUT]u8;
    if c[0].h<0 || !py_draw(4,mask[..]) {return false;}
    n:=ws_frame_write(op,true,payload,mask[..],out[..]);
    return n>0 && py_write(c[0].h,cast(string)out[0..<n]);
}
py_shut :: (c:[]PyConn) {
    if c[0].h>=0 {r:=cxsock_close(c[0].h);}
    c[0].h=-1;c[0].used=0;c[0].rd[0]=WsReader.{};
}
py_fill :: (c:[]PyConn,timeout_ms:int)->int {
    n:=cxsock_read(c[0].h,timeout_ms);
    if n<=0 {return n;}
    if c[0].used+n>PY_IN {return -3;}
    for i:0..<n {c[0].inb[c[0].used+i]=cast(u8)cxsock_byte(c[0].h,i);}
    c[0].used+=n;return n;
}
py_drop_front :: (c:[]PyConn,k:int) {
    for i:k..<c[0].used {c[0].inb[i-k]=c[0].inb[i];}
    c[0].used-=k;
}
py_connect :: (host:string,port:int)->int {
    for b:host {r:=cxsock_host_push(cast(int)b);}
    return cxsock_connect(port,PY_IO_MS);
}
py_open :: (c:[]PyConn,host:string,port:int)->bool {
    py_shut(c);
    h:=py_connect(host,port);if h<0 {return false;}
    c[0].h=h;c[0].gen+=1;
    nonce:[16]u8;key:[24]u8;req:[512]u8;
    if !py_draw(16,nonce[..]) || !ws_key(nonce[..],key[..]) {py_shut(c);return false;}
    n:=ws_request(host,port,"/",cast(string)key[..],req[..]);
    if n<0 || !py_write(c[0].h,cast(string)req[0..<n]) {py_shut(c);return false;}
    while true {
        hello:=ws_response(cast(string)c[0].inb[0..<c[0].used],cast(string)key[..]);
        if hello.status==WS_HELLO_OK {py_drop_front(c,hello.consumed);return true;}
        if hello.status!=WS_HELLO_MORE || py_fill(c,PY_IO_MS)<=0 {py_shut(c);return false;}
    }
    return false;
}
// The next WebSocket event; pings are answered here.
py_recv :: (c:[]PyConn,timeout_ms:int)->int {
    while true {
        f:=ws_frame_read(cast(string)c[0].inb[0..<c[0].used],PY_MSG);
        if f.status==WS_FRAME_OK {
            ev:=ws_take(c[0].rd[..],f,cast(string)c[0].inb[f.header..<f.total],c[0].msg[..]);
            if f.op>=8 {c[0].ctl_n=f.length;for i:0..<f.length {c[0].ctl[i]=c[0].inb[f.header+i];}}
            py_drop_front(c,f.total);
            if ev==WS_EV_PING {if !py_send(c,WS_OP_PONG,cast(string)c[0].ctl[0..<c[0].ctl_n]) {return PY_FAIL;}continue;}
            if ev!=WS_EV_PART {return ev;}
            continue;
        }
        if f.status!=WS_FRAME_MORE {return PY_FAIL;}
        n:=py_fill(c,timeout_ms);
        if n==-2 {return PY_NONE;}
        if n==-1 {return PY_EOF;}
        if n<0 {return PY_FAIL;}
    }
    return PY_FAIL;
}
py_text :: (c:[]PyConn)->string {return cast(string)c[0].msg[0..<c[0].rd[0].used];}

// ---- relay frames (TEST-ONLY adapter until message.coax) -------------------

PyFrame :: struct {verb:int;sub:string;event:string;id:string;ok:bool;message:string;}
py_frame :: (text:string)->PyFrame {
    f:PyFrame;j:[1]Json;json_start(j[..],text);
    if json_next(j[..])!=JSON_ARRAY || json_next(j[..])!=JSON_STRING {return f;}
    verb:=json_text(j[..]);
    if json_is(verb,"EVENT") {
        if json_next(j[..])!=JSON_STRING {return f;}
        f.sub=json_text(j[..]);t:=json_next(j[..]);if t!=JSON_OBJECT {return f;}
        f.event=pt_raw(j[..],t);if f.event.count==0 || json_next(j[..])!=JSON_ARRAY_END {return f;}
        f.verb=PF_EVENT;return f;
    }
    if json_is(verb,"OK") {
        if json_next(j[..])!=JSON_STRING {return f;}
        f.id=json_text(j[..]);t:=json_next(j[..]);if t!=JSON_TRUE && t!=JSON_FALSE {return f;}
        f.ok=t==JSON_TRUE;if json_next(j[..])!=JSON_STRING {return f;}
        f.message=json_text(j[..]);f.verb=PF_OK;return f;
    }
    if json_is(verb,"AUTH") {f.verb=PF_AUTH;return f;}
    if json_next(j[..])!=JSON_STRING {return f;}
    s:=json_text(j[..]);
    if json_is(verb,"EOSE") {f.sub=s;f.verb=PF_EOSE;}
    else if json_is(verb,"CLOSED") {f.sub=s;if json_next(j[..])==JSON_STRING {f.message=json_text(j[..]);}f.verb=PF_CLOSED;}
    else if json_is(verb,"NOTICE") {f.message=s;f.verb=PF_NOTICE;}
    return f;
}

// ---- the Pylon ----------------------------------------------------------------

PySlot :: struct {held:PdJob;id:[64]u8;caller:[64]u8;request:[128]u8;body:[16384]u8;n:int;}
Py :: struct {
    cfg:[1]PyConfig;
    key:[32]u8;me:[64]u8;
    signer:[1]PySignWork;
    conn:[1]PyConn;
    n42:[1]Nip42;
    q:[1]PqQueue;slots:[4]PySlot;
    life:PbLife;observed:int;identity:[160]u8;identity_n:int;
    pending:[64]u8;pending_ok:int=-1;
    sent:int;accepted:int;refused:int;forged:int;duplicates:int;ignored:int;
    answered:int;refusals:int;cancelled:int;beacons:int;
}
py_me :: (p:[]Py)->string {return cast(string)p[0].me[..];}
py_identity :: (p:[]Py)->string {return cast(string)p[0].identity[0..<p[0].identity_n];}
py_short :: (s:string)->string {return ifx s.count>12 then s[0..<12] else s;}

// A template's four signed fields, read back for the signer.
PyTpl :: struct {ok:bool;created_at:int;kind:int;tags:string;content:string;}
py_fields :: (template:string,content:[]u8)->PyTpl {
    r:PyTpl;j:[1]Json;json_start(j[..],template);
    if json_next(j[..])!=JSON_OBJECT {return r;}
    seen:=0;
    while true {
        t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}
        if t!=JSON_STRING {return r;}
        key:=json_text(j[..]);t=json_next(j[..]);
        if json_is(key,"created_at") {if t!=JSON_NUMBER {return r;}r.created_at=py_int(json_text(j[..]));seen|=1;}
        else if json_is(key,"kind") {if t!=JSON_NUMBER {return r;}r.kind=py_int(json_text(j[..]));seen|=2;}
        else if json_is(key,"tags") {r.tags=pt_raw(j[..],t);seen|=4;}
        else if json_is(key,"content") {if t!=JSON_STRING {return r;}n:=json_unescape(json_text(j[..]),content);if n<0 {return r;}r.content=cast(string)content[0..<n];seen|=8;}
        else {raw:=pt_raw(j[..],t);}
    }
    r.ok=seen==15 && r.created_at>=0 && r.kind>=0;return r;
}
// Signs and sends one event; its id is remembered for the OK. False when
// signing or the socket failed.
py_publish :: (p:[]Py,template:string,what:string)->bool {
    content:[65536]u8;t:=py_fields(template,content[..]);
    if !t.ok {print("pylon: % template unreadable\n",what);return false;}
    aux:[32]u8;if !py_draw(32,aux[..]) {return false;}
    scratch:[PY_OUT]u8;signed:[PY_OUT]u8;n:=0;
    while n==0 {n=py_sign_step(p[0].key[..],aux[..],t.created_at,t.kind,t.tags,t.content,p[0].signer[..],scratch[..],signed[..],false);}
    if n<0 {print("pylon: % refused by the signer\n",what);return false;}
    frame:[PY_OUT]u8;m:=json_raw(frame[..],0,"[\"EVENT\",");m=json_raw(frame[..],m,cast(string)signed[0..<n]);m=json_raw(frame[..],m,"]");
    if m<0 {return false;}
    // The signed event's id is its first field: {"id":"<64 hex>",...
    if n<72 || cast(string)signed[0..<7]!="{\"id\":\"" {return false;}
    for i:0..<64 {p[0].pending[i]=signed[7+i];}p[0].pending_ok=-1;
    p[0].sent+=1;
    return py_send(p[0].conn[..],WS_OP_TEXT,cast(string)frame[0..<m]);
}
// NIP-44 to the caller: the payload written into out.
py_seal :: (p:[]Py,caller:string,plaintext:string,out:[]u8)->string {
    x:[32]u8;ck:[32]u8;nonce:[32]u8;
    if !py_shared_x(p[0].key[..],caller,p[0].signer[..],x[..]) {return "";}
    e:=nip44_conversation_key_checked(x[..],ck[..],false);for i:0..<32 {x[i]=0;}
    if e!=NIP44_OK || !py_draw(32,nonce[..]) {return "";}
    work:[PY_OUT]u8;plain:[PY_OUT]u8;if plaintext.count>PY_OUT {return "";}for i:0..<plaintext.count {plain[i]=plaintext[i];}
    r:=nip44_encrypt_checked(NIP44_COMPAT,ck[..],nonce[..],plain[0..<plaintext.count],work[0..<nip44_encrypt_work_size(NIP44_COMPAT,plaintext.count)],out[0..<nip44_payload_size(NIP44_COMPAT,plaintext.count)],false);
    for i:0..<32 {ck[i]=0;}
    if r.error!=NIP44_OK {return "";}
    return cast(string)out[0..<r.written];
}
py_open_payload :: (p:[]Py,caller:string,payload:string,out:[]u8)->Nip44Result {
    x:[32]u8;ck:[32]u8;
    if !py_shared_x(p[0].key[..],caller,p[0].signer[..],x[..]) {return Nip44Result.{error=NIP44_KEY};}
    e:=nip44_conversation_key_checked(x[..],ck[..],false);for i:0..<32 {x[i]=0;}
    if e!=NIP44_OK {return Nip44Result.{error=e};}
    size:=nip44_decrypt_work_size(NIP44_COMPAT,payload.count);
    if size<0 || size>PY_OUT {return Nip44Result.{error=NIP44_CAPACITY};}
    work:[PY_OUT]u8;r:=nip44_decrypt_checked(NIP44_COMPAT,ck[..],payload,work[0..<size],out,false);
    for i:0..<32 {ck[i]=0;}
    return r;
}
// A 26910 or 27010 for job: encrypt plaintext to its caller, template, sign, send.
py_reply :: (p:[]Py,jb:PdJob,kind:int,plaintext:string,what:string)->bool {
    payload:[PY_OUT]u8;sealed:=py_seal(p,jb.caller,plaintext,payload[..]);
    if sealed.count==0 {print("pylon: could not encrypt the % for %\n",what,py_short(jb.id));return false;}
    template:[PY_OUT]u8;n:=pd_template(template[..],py_me(p),pyh_now_s(),kind,jb,sealed);
    if n<0 {return false;}
    return py_publish(p,cast(string)template[0..<n],what);
}
py_status :: (p:[]Py,jb:PdJob,code:PdCode)->bool {
    body:[1024]u8;retry:=ifx code==PdCode.busy then PQ_RETRY_MS else -1;
    n:=pd_status(body[..],jb,PdStatus.error,code,retry);if n<0 {return false;}
    p[0].refusals+=1;
    print("pylon: job % -> 27010 error %\n",py_short(jb.id),pd_code_name(code));
    return py_reply(p,jb,PD_STATUS,cast(string)body[0..<n],"status");
}

// ---- the engine (chapter 16's /v1/systemone over HTTP) ----------------------

PyHttp :: struct {reached:bool;timed_out:bool;status:int;body:string;}
// POST body to the engine; at most budget_ms for the whole exchange.
py_http :: (p:[]Py,body:string,budget_ms:int,resp:[]u8)->PyHttp {
    r:PyHttp;c:=p[0].cfg[0];end:=cxsock_now_ms()+budget_ms;
    h:=py_connect(c.engine_host,c.engine_port);if h<0 {return r;}
    head:[512]u8;n:=json_raw(head[..],0,"POST /v1/systemone HTTP/1.1\r\nHost: ");n=json_raw(head[..],n,c.engine_host);
    n=json_raw(head[..],n,"\r\nContent-Type: application/json\r\nContent-Length: ");n=json_write_int(head[..],n,body.count);
    n=json_raw(head[..],n,"\r\nConnection: close\r\n\r\n");
    if n<0 || !py_write(h,cast(string)head[0..<n]) || !py_write(h,body) {x:=cxsock_close(h);return r;}
    used:=0;
    while true {
        left:=end-cxsock_now_ms();if left<=0 {r.timed_out=true;x:=cxsock_close(h);return r;}
        k:=cxsock_read(h,left);
        if k==-1 {break;}
        if k==-2 {r.timed_out=true;x:=cxsock_close(h);return r;}
        if k<0 || used+k>resp.count {x:=cxsock_close(h);return r;}
        for i:0..<k {resp[used+i]=cast(u8)cxsock_byte(h,i);}used+=k;
    }
    x:=cxsock_close(h);
    text:=cast(string)resp[0..<used];
    if used<12 || text[0..<9]!="HTTP/1.1 " {return r;}
    status:=py_int(text[9..<12]);
    at:=pb_index(text,"\r\n\r\n");if at<0 || status<100 {return r;}
    r.reached=true;r.status=status;r.body=text[at+4..<used];return r;
}
// The code a refusal body names: {"error":{"code":"..."}}, or none.
py_refused :: (body:string)->int {
    j:[1]Json;json_start(j[..],body);if json_next(j[..])!=JSON_OBJECT {return PQ_NONE;}
    while true {
        t:=json_next(j[..]);if t!=JSON_STRING {return PQ_NONE;}
        key:=json_text(j[..]);t=json_next(j[..]);
        if json_is(key,"error") && t==JSON_OBJECT {
            while true {
                s:=json_next(j[..]);if s!=JSON_STRING {return PQ_NONE;}
                k:=json_text(j[..]);s=json_next(j[..]);
                if json_is(k,"code") && s==JSON_STRING {return cast(int)pd_code(json_text(j[..]));}
                raw:=pt_raw(j[..],s);
            }
        }
        raw:=pt_raw(j[..],t);
    }
    return PQ_NONE;
}
// The engine's identity: one decision at start, its service.identity.
py_probe :: (p:[]Py)->bool {
    body:[512]u8;n:=json_raw(body[..],0,"{\"model\":");n=json_write_string(body[..],n,p[0].cfg[0].model);
    n=json_raw(body[..],n,",\"state\":\"Water is wet.\",\"questions\":{\"wet\":{\"type\":\"choice\",\"instructions\":\"Is the water wet?\",\"criteria\":{\"yes\":null,\"no\":null}}}}");
    resp:[PY_HTTP]u8;started:=cxsock_now_ms();
    r:=py_http(p,cast(string)body[0..<n],p[0].cfg[0].decide_ms,resp[..]);
    if !r.reached || r.status!=200 {print("pylon: the engine did not answer the probe (reached %, status %)\n",r.reached,r.status);return false;}
    at:=pb_index(r.body,"\"identity\":\"");if at<0 {return false;}
    rest:=r.body[at+12..<r.body.count];end:=pb_index(rest,"\"");if end<1 || end>p[0].identity.count {return false;}
    for i:0..<end {p[0].identity[i]=rest[i];}p[0].identity_n=end;
    id:=py_identity(p);
    if !pb_identity(id) || pb_identity_name(id)!=p[0].cfg[0].model {print("pylon: the engine names %, not a % identity\n",id,p[0].cfg[0].model);return false;}
    print("pylon: engine % answered the probe in % ms\n",id,cxsock_now_ms()-started);
    return true;
}

// ---- relay records -----------------------------------------------------------

py_beacon :: (p:[]Py,now:int)->bool {
    c:=p[0].cfg[0];
    observed:=ifx now>p[0].observed then now else p[0].observed+1;
    lanes:[1]string;services:[1]PbService;settlement:[1]string;cap:[160]u8;
    lanes[0]="cj-decision";settlement[0]="free-v1";
    k:=pb_capability(cap[..],py_me(p));if k<0 {return false;}
    services[0]=PbService.{capability=cast(string)cap[0..<k],model=py_identity(p),lanes=lanes[0..<1]};
    free:=pq_free(p[0].q[..]);if p[0].life.status!=PbStatus.online {free=0;}
    b:=PbBeacon.{provider=py_me(p),pylon=c.slug,label=c.label,status=p[0].life.status,generation=p[0].life.generation,since=p[0].life.since,
        observed_at=observed,valid_until=pb_valid_until(observed,c.ttl),hardware=PbClass.{family=c.family,tier=pb_tier(c.family,c.memory_gb),memory_gb=c.memory_gb},
        total=PQ_SLOTS,free=free,services=services[0..<1],settlement=settlement[0..<1]};
    scratch:[8192]u8;out:[16384]u8;n:=ph_beacon(b,PbAuth.{},scratch[..],out[..]);
    if n<0 {print("pylon: the beacon writer refused\n");return false;}
    p[0].observed=observed;
    snap:=pb_snap(p[0].life,pq_free(p[0].q[..]),1);p[0].life=pb_sent(p[0].life,snap,now);
    p[0].beacons+=1;
    print("pylon: beacon % generation % free % of %\n",pb_status_name(b.status),b.generation,free,PQ_SLOTS);
    return py_publish(p,cast(string)out[0..<n],"beacon");
}
py_relay_list :: (p:[]Py,now:int)->bool {
    c:=p[0].cfg[0];relays:[8]PrRelay;
    for k:0..<c.list_count {relays[k]=PrRelay.{url=c.lists[k]};}
    out:[4096]u8;n:=pr_write(out[..],py_me(p),now,relays[0..<c.list_count]);
    if n<0 {print("pylon: the relay list writer refused\n");return false;}
    print("pylon: relay list of %\n",c.list_count);
    return py_publish(p,cast(string)out[0..<n],"relay list");
}

// ---- jobs ----------------------------------------------------------------------

py_keep :: (p:[]Py,slot:int,jb:PdJob,body:string) {
    for i:0..<64 {p[0].slots[slot].id[i]=jb.id[i];p[0].slots[slot].caller[i]=jb.caller[i];}
    for i:0..<jb.request.count {p[0].slots[slot].request[i]=jb.request[i];}
    for i:0..<body.count {p[0].slots[slot].body[i]=body[i];}p[0].slots[slot].n=body.count;
    j:=jb;j.id=cast(string)p[0].slots[slot].id[..];j.caller=cast(string)p[0].slots[slot].caller[..];
    j.request=cast(string)p[0].slots[slot].request[0..<jb.request.count];j.target="";p[0].slots[slot].held=j;
}
// book:begin event
py_event :: (p:[]Py,text:string) {
    scratch:[262144]u8;
    ev:=nostr_event_verify_vartime(text,scratch[..],false);
    verified:=ev.error==NE_OK && ev.verified;
    if !verified {p[0].forged+=1;print("pylon: event refused by verification (error %)\n",ev.error);return;}
    if !pq_seen(p[0].q[..],ev.id[..]) {p[0].duplicates+=1;return;}
    idh:[64]u8;pkh:[64]u8;id:=py_hex(ev.id[..],idh[..]);caller:=py_hex(ev.public_key[..],pkh[..]);
    raw:=ev.original[ev.content_from..<ev.content_to];payload:[PY_OUT]u8;k:=json_unescape(raw,payload[..]);
    plain:[PY_OUT]u8;opened:=Nip44Result.{error=NIP44_PAYLOAD};
    if ev.kind==PD_REQUEST && k>0 {opened=py_open_payload(p,caller,cast(string)payload[0..<k],plain[..]);}
    decrypted:=opened.error==NIP44_OK;
    plaintext:=ifx decrypted then cast(string)plain[0..<opened.written] else "";
    env:=PdEnvelope.{kind=ev.kind,id=id,pubkey=caller,created_at=ev.created_at,tags=ev.original[ev.tags_from..<ev.tags_to],plaintext=plaintext};
    body:[16384]u8;now:=pyh_now_s();jb:=pd_admit(env,py_me(p),now,body[..]);
    draining:=p[0].life.status!=PbStatus.online;
    route:=pq_route(true,ev.kind,decrypted,cast(int)jb.code,cast(int)jb.type,jb.answerable,draining,pq_free(p[0].q[..]));
    print("pylon: event % kind % -> % (%)\n",py_short(id),ev.kind,route,jb.code);
    if route==PqRoute.ignore {p[0].ignored+=1;return;}
    if route==PqRoute.refuse {ok:=py_status(p,jb,jb.code);return;}
    if route==PqRoute.busy {ok:=py_status(p,jb,PdCode.busy);return;}
    if route==PqRoute.cancel {
        for i:0..<PQ_SLOTS {
            s:=p[0].q[0].slots[i].state;if s==PqState.free {continue;}
            c:=pd_cancel(p[0].slots[i].held,s==PqState.running,jb);
            if c==PdCancel.drop && pq_cancel(p[0].q[..],i)==1 {
                p[0].cancelled+=1;print("pylon: cancel % drops waiting job %\n",py_short(id),py_short(p[0].slots[i].held.id));
                ok:=py_status(p,p[0].slots[i].held,PdCode.cancelled);
            } else if c==PdCancel.stop {
                // This host runs one decision at a time and reads frames only
                // between decisions, so a running job is never seen here.
                print("pylon: cancel % names the running job %; it finishes\n",py_short(id),py_short(p[0].slots[i].held.id));
            }
        }
        return;
    }
    slot:=pq_put(p[0].q[..]);
    if slot<0 {ok:=py_status(p,jb,PdCode.busy);return;}
    py_keep(p,slot,jb,cast(string)body[0..<jb.body]);
}
// book:end event
py_run :: (p:[]Py,slot:int) {
    jb:=p[0].slots[slot].held;now:=pyh_now_s();
    budget:=pq_budget(pd_left_ms(jb,now),p[0].cfg[0].decide_ms);
    r:PyHttp;resp:[PY_HTTP]u8;started:=cxsock_now_ms();
    if budget.ms>0 {r=py_http(p,cast(string)p[0].slots[slot].body[0..<p[0].slots[slot].n],budget.ms,resp[..]);}
    else {r.timed_out=true;}
    out:[PY_OUT]u8;written:=PdOut.{code=PdCode.internal};refused:=PQ_NONE;
    receipt:[512]u8;
    if r.reached && r.status==200 {
        m:=json_raw(receipt[..],0,"{\"attempt_id\":");attempt:[160]u8;a:=json_raw(attempt[..],0,jb.request);a=json_raw(attempt[..],a,"#");a=json_write_int(attempt[..],a,jb.attempt);
        m=json_write_string(receipt[..],m,cast(string)attempt[0..<a]);m=json_raw(receipt[..],m,",\"schema\":\"openagents.receipt.execution.v1\",\"transport\":\"relay\"}");
        written=pd_result(out[..],jb,r.body,p[0].cfg[0].slug,py_me(p),PY_VERSION,py_identity(p),cast(string)receipt[0..<m]);
    } else if r.reached {refused=py_refused(r.body);}
    a:=pq_answer(r.reached,r.timed_out,r.status,cast(int)written.code,refused);
    took:=cxsock_now_ms()-started;
    if a.result {
        p[0].answered+=1;
        print("pylon: job % -> 26910 answered by % in % ms\n",py_short(jb.id),py_identity(p),took);
        ok:=py_reply(p,jb,PD_RESULT,cast(string)out[0..<written.written],"result");
    } else {ok:=py_status(p,jb,cast(PdCode)a.code);}
    done:=pq_done(p[0].q[..],slot);
}
// One relay message.
py_take :: (p:[]Py) {
    text:=py_text(p[0].conn[..]);f:=py_frame(text);
    if f.verb==PF_EVENT {if json_is(f.sub,PY_SUB) {py_event(p,f.event);}return;}
    if f.verb==PF_OK {
        if f.ok {p[0].accepted+=1;}else {p[0].refused+=1;print("pylon: relay refused %: %\n",py_short(f.id),f.message);}
        if f.id==cast(string)p[0].pending[..] {p[0].pending_ok=ifx f.ok then 1 else 0;}
        return;
    }
    if f.verb==PF_EOSE {print("pylon: caught up on %\n",f.sub);return;}
    if f.verb==PF_CLOSED {print("pylon: relay closed %: %\n",f.sub,f.message);return;}
    if f.verb==PF_NOTICE {print("pylon: notice %\n",f.message);return;}
    if f.verb==PF_AUTH {return;}
    print("pylon: unreadable frame (% bytes)\n",text.count);
}
// Reads frames: the first within wait_ms, then whatever is already there.
// False when the connection failed.
py_pump :: (p:[]Py,wait_ms:int)->bool {
    wait:=wait_ms;
    while true {
        ev:=py_recv(p[0].conn[..],wait);wait=0;
        if ev==PY_NONE {return true;}
        if ev==WS_EV_MESSAGE {py_take(p);continue;}
        if ev==WS_EV_PONG {continue;}
        print("pylon: the relay connection ended (%)\n",ev);return false;
    }
    return false;
}
// Waits for the OK of the last publish.
py_acked :: (p:[]Py,limit_ms:int)->bool {
    end:=cxsock_now_ms()+limit_ms;
    while p[0].pending_ok==-1 && cxsock_now_ms()<end {if !py_pump(p,100) {return false;}}
    return p[0].pending_ok==1;
}
// NIP-42: the relay's challenge, a signed 22242, its OK.
py_auth :: (p:[]Py)->bool {
    c:=p[0].cfg[0];
    if nip42_init(p[0].n42[..],c.relay)!=N42_OK {print("pylon: NIP-42 refuses the relay URL\n");return false;}
    end:=cxsock_now_ms()+PY_IO_MS;
    while cxsock_now_ms()<end {
        ev:=py_recv(p[0].conn[..],200);
        if ev==PY_NONE {continue;}
        if ev!=WS_EV_MESSAGE {return false;}
        if nip42_challenge(p[0].n42[..],p[0].conn[0].gen,py_text(p[0].conn[..]))==N42_OK {break;}
        py_take(p);
    }
    tags:[1024]u8;t:=nip42_template(p[0].n42[..],p[0].conn[0].gen,pyh_now_s(),tags[..]);
    if t.error!=N42_OK {print("pylon: no NIP-42 challenge (%)\n",t.error);return false;}
    aux:[32]u8;if !py_draw(32,aux[..]) {return false;}
    scratch:[PY_OUT]u8;signed:[PY_OUT]u8;n:=0;
    while n==0 {n=py_sign_step(p[0].key[..],aux[..],t.created_at,t.kind,t.tags,t.content,p[0].signer[..],scratch[..],signed[..],false);}
    if n<72 {return false;}
    frame:[PY_OUT]u8;m:=json_raw(frame[..],0,"[\"AUTH\",");m=json_raw(frame[..],m,cast(string)signed[0..<n]);m=json_raw(frame[..],m,"]");
    for i:0..<64 {p[0].pending[i]=signed[7+i];}p[0].pending_ok=-1;p[0].sent+=1;
    if m<0 || !py_send(p[0].conn[..],WS_OP_TEXT,cast(string)frame[0..<m]) {return false;}
    if !py_acked(p,PY_IO_MS) {print("pylon: the relay refused NIP-42 AUTH\n");return false;}
    print("pylon: authenticated to % as %\n",c.relay,py_me(p));
    return true;
}
py_subscribe :: (p:[]Py,now:int)->bool {
    req:[512]u8;n:=json_raw(req[..],0,"[\"REQ\",\"");n=json_raw(req[..],n,PY_SUB);n=json_raw(req[..],n,"\",{\"kinds\":[25910],\"#p\":[\"");
    n=json_raw(req[..],n,py_me(p));n=json_raw(req[..],n,"\"],\"since\":");n=json_write_int(req[..],n,now-PD_PAST);n=json_raw(req[..],n,"}]");
    return n>0 && py_send(p[0].conn[..],WS_OP_TEXT,cast(string)req[0..<n]);
}
py_signer :: (p:[]Py)->bool {
    c:=p[0].cfg[0];h:=cxproc_new();if h<0 {return false;}
    for b:c.bun {r:=cxproc_push(h,0,cast(int)b);}r:=cxproc_end(h,0);
    for b:c.script {r=cxproc_push(h,0,cast(int)b);}r=cxproc_end(h,0);
    env:="NODE_PATH=";for b:env {r=cxproc_push(h,1,cast(int)b);}for b:c.node_path {r=cxproc_push(h,1,cast(int)b);}r=cxproc_end(h,1);
    if cxproc_spawn(h)!=0 {return false;}
    p[0].signer[0].proc=h;return true;
}

py_main :: (p:[]Py)->int {
    if !py_config(p[0].cfg[..]) {return 2;}
    c:=p[0].cfg[0];
    // TEST-ONLY key: sha256 of the label. Never printed.
    label:[256]u8;if c.label_key.count>256 {return 2;}for i:0..<c.label_key.count {label[i]=c.label_key[i];}
    if sha256_hash_checked(label[0..<c.label_key.count],p[0].key[..],false)!=SHA_OK {return 2;}
    if !py_signer(p) || !py_public(p[0].key[..],p[0].signer[..],p[0].me[..]) {print("pylon: the TEST-ONLY signer did not start\n");return 2;}
    print("pylon: TEST-ONLY key and signing double; pubkey %\n",py_me(p));
    if !py_probe(p) {return 3;}
    if !py_open(p[0].conn[..],c.relay_host,c.relay_port) {print("pylon: no WebSocket to %\n",c.relay);return 4;}
    if !py_auth(p) {return 4;}
    now:=pyh_now_s();
    if !py_relay_list(p,now) || !py_acked(p,PY_IO_MS) {print("pylon: relay list not accepted\n");return 5;}
    p[0].life=pb_start(PbLife.{},now);
    if !py_beacon(p,now) || !py_acked(p,PY_IO_MS) {print("pylon: beacon not accepted\n");return 5;}
    if !py_subscribe(p,now) {return 4;}
    print("pylon: online, waiting for jobs\n");
// book:begin loop
    while true {
        // Frames first, so a job that arrived while the engine ran is held
        // before the stop request is weighed.
        if !py_pump(p,200) {return 6;}
        now=pyh_now_s();
        l:=pq_life(pyh_stop()==1,pq_held(p[0].q[..]));
        if l==PqLife.off {break;}
        was:=p[0].life.status;
        if l==PqLife.drain {p[0].life=pb_drain(p[0].life);}
        snap:=pb_snap(p[0].life,pq_free(p[0].q[..]),1);
        if pq_beacon_now(pb_due(p[0].life,snap,c.refresh,now),was!=p[0].life.status,l!=PqLife.run) {if !py_beacon(p,now) {return 5;}}
        slot:=pq_next(p[0].q[..]);
        if slot>=0 {py_run(p,slot);}
    }
// book:end loop
    p[0].life=pb_stop(p[0].life);
    if !py_beacon(p,pyh_now_s()) || !py_acked(p,PY_IO_MS) {print("pylon: offline beacon not accepted\n");}
    close:[64]u8;n:=json_raw(close[..],0,"[\"CLOSE\",\"");n=json_raw(close[..],n,PY_SUB);n=json_raw(close[..],n,"\"]");
    ok:=py_send(p[0].conn[..],WS_OP_TEXT,cast(string)close[0..<n]);
    mask:[4]u8;cf:[16]u8;
    if py_draw(4,mask[..]) {k:=ws_close_write(WS_CLOSE_NORMAL,mask[..],cf[..]);if k>0 {ok=py_write(p[0].conn[0].h,cast(string)cf[0..<k]);}}
    py_shut(p[0].conn[..]);
    for i:0..<32 {p[0].key[i]=0;}
    r:=cxproc_release(p[0].signer[0].proc);
    print("pylon: offline. sent %, accepted %, refused %, answered %, refusals %, cancelled %, forged %, duplicates %, ignored %, beacons %\n",
        p[0].sent,p[0].accepted,p[0].refused,p[0].answered,p[0].refusals,p[0].cancelled,p[0].forged,p[0].duplicates,p[0].ignored,p[0].beacons);
    return 0;
}
main :: () {
    p:[1]Py;r:=py_main(p[..]);
    if r!=0 {print("pylon: stopped (%)\n",r);}
}
