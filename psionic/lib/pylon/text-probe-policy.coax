#load "beacon.coax";
#load "../responses/json.coax";
#authority;
P90_PROBE_IDENT :: "gpt-oss-20b@sha256:3340a61d1a0391e8c5b5d3463d18d4c48129a84bbc04a554c762c99020aa06ed";
#test "probe pins, time and text budgets are independent gates" {
    key:=PB_KEY;id:=P90_PROBE_IDENT;
    #assert p90_probe_config(key,id,id,"x","PONG",1000) && p90_probe_config(key,id,id,"x","PONG",60000);
    #assert p90_probe_config(key,id,id,"x","X",1000);
    #assert !p90_probe_config("x",id,id,"x","PONG",1000) && !p90_probe_config(key,"other",id,"x","PONG",1000) && !p90_probe_config(key,"bad","bad","x","PONG",1000);
    #assert !p90_probe_config(key,id,id,"","PONG",1000) && !p90_probe_config(key,id,id,"x","",1000) && !p90_probe_config(key,id,id,"x","PONG",999) && !p90_probe_config(key,id,id,"x","PONG",60001);
    prompt:[1025]u8;expected:[65]u8;for i:0..<1025 {prompt[i]='x';}for i:0..<65 {expected[i]='X';}
    #assert p90_probe_config(key,id,id,cast(string)prompt[0..<1024],cast(string)expected[0..<64],1000);
    #assert !p90_probe_config(key,id,id,cast(string)prompt[..],"X",1000) && !p90_probe_config(key,id,id,"x",cast(string)expected[..],1000);
}
#test "public targeted request is standard free NIP90 and bounded before signing" {
    out:[8192]u8;n:=p90_probe_tags(PB_KEY,"Quote \"PONG\"",1000,out[..]);
    #assert cast(string)out[0..<n]=="[[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"i\",\"Quote \\\"PONG\\\"\",\"text\"],[\"param\",\"model\",\"gpt-oss-20b\"],[\"param\",\"max_tokens\",\"64\"],[\"param\",\"temperature\",\"0\"],[\"output\",\"text/plain\"],[\"bid\",\"0\"],[\"expiration\",\"1060\"]]";
    #assert p90_probe_tags("bad","x",1000,out[..])==-1 && p90_probe_tags(PB_KEY,"",1000,out[..])==-1 && p90_probe_tags(PB_KEY,"x",-1,out[..])==-1;
    #assert p90_probe_tags(PB_KEY,"x",9007199254740931,out[..])>0 && p90_probe_tags(PB_KEY,"x",9007199254740932,out[..])==-1;
    #assert p90_probe_tags(PB_KEY,"x",0,out[..])>0 && p90_probe_tags(PB_KEY,"x",1,out[0..<1])==-1;
    text:[1025]u8;for i:0..<1025 {text[i]='x';}
    #assert p90_probe_tags(PB_KEY,cast(string)text[0..<1024],1000,out[..])>0 && p90_probe_tags(PB_KEY,cast(string)text[..],1000,out[..])==-1;
}
#test "feedback only aborts on one explicit error status" {
    #assert p90_feedback_error("[[\"status\",\"error\",\"refused\"]]") && p90_feedback_error("[[\"status\",\"error\"]]");
    #assert !p90_feedback_error("[[\"status\",\"processing\"]]") && !p90_feedback_error("[]") && !p90_feedback_error("bad") && !p90_feedback_error("{}");
    #assert !p90_feedback_error("[[\"status\",\"error\"],[\"status\",\"error\"]]") && !p90_feedback_error("[[\"status\"]]") && !p90_feedback_error("[1]");
    #assert !p90_feedback_error("[[\"status\",\"error\"]] trailing") && !p90_feedback_error("{\"x\":[\"status\",\"error\"]}");
    #assert !p90_feedback_error("[[\"status\",\"error\"],1]") && !p90_feedback_error("[[\"status\",\"error\"],[1]]") && !p90_feedback_error("[[\"status\",\"error\"],[\"meta\",1]]");
    #assert p90_feedback_error("[[],[\"status\",\"error\"]]") && !p90_feedback_error("[[\"metadata\",\"status\"],[\"status\",\"processing\"]]");
    #assert !p90_feedback_error("[[\"unrelated\",\"error\"]]") && !p90_feedback_error("[[\"status\"],[\"status\",\"error\"]]");
    bounded:[1024]u8;n:=json_raw(bounded[..],0,"[");
    for i:0..<127 {if i>0 {n=json_raw(bounded[..],n,",");}n=json_raw(bounded[..],n,"[]");}n=json_raw(bounded[..],n,"]");
    #assert !p90_feedback_error(cast(string)bounded[0..<n]);
    n=json_raw(bounded[..],0,"[");for i:0..<125 {if i>0 {n=json_raw(bounded[..],n,",");}n=json_raw(bounded[..],n,"[]");}n=json_raw(bounded[..],n,",[\"status\"]]");
    #assert !p90_feedback_error(cast(string)bounded[0..<n]);
}
p90_probe_config :: (provider:string,identity:string,admitted:string,prompt:string,expected:string,timeout:int)->bool {
    return pt_hex64(provider) && pb_identity(admitted) && identity==admitted && prompt.count>=1 && prompt.count<=1024 && expected.count>=1 && expected.count<=64 && timeout>=1000 && timeout<=60000;
}
p90_probe_tags :: (provider:string,prompt:string,now:int,out:[]u8)->int {
    if !pt_hex64(provider) || prompt.count<1 || prompt.count>1024 || now<0 || now>9007199254740931 {return -1;}
    n:=json_raw(out,0,"[[\"p\",");n=json_write_string(out,n,provider);n=json_raw(out,n,"],[\"i\",");n=json_write_string(out,n,prompt);
    n=json_raw(out,n,",\"text\"],[\"param\",\"model\",\"gpt-oss-20b\"],[\"param\",\"max_tokens\",\"64\"],[\"param\",\"temperature\",\"0\"],[\"output\",\"text/plain\"],[\"bid\",\"0\"],[\"expiration\",");
    time:[32]u8;size:=json_write_int(time[..],0,now+60);n=json_write_string(out,n,cast(string)time[0..<size]);return json_raw(out,n,"]]");
}
p90_feedback_error :: (tags:string)->bool {
    nodes:[128]RsNode;arena:[4096]u8;tree:=rs_json(tags,nodes[..],arena[..]);if !tree.ok {return false;}
    if nodes[0].kind!=JSON_ARRAY {return false;}
    i:=1;found:bool;error:bool;
    while i<nodes[0].next {
        if nodes[i].kind!=JSON_ARRAY {return false;}
        for k:i+1..<nodes[i].next {if nodes[k].kind!=JSON_STRING {return false;}}
        if nodes[i].next>i+1 && nodes[i+1].text=="status" {
            if found || nodes[i].next<i+3 {return false;}
            found=true;error=nodes[i+2].text=="error";
        }
        i=nodes[i].next;
    }
    return found && error;
}
