// Chapter 144: See with C-RADIO. The pinned C-RADIOv3-B image encoder: its
// tensor inventory checked against the config, image admission and the
// input conditioner, patch rows, the patch embedding with the CPE position
// table resized to the image's grid, the cls and register tokens, the
// pre-norm transformer block with layer scale, and the split into summary
// and spatial features. Profile psionic-radio-v1: f32 storage, binary64
// sums, one rounding to f32 per stored value. The block's helpers (row
// product, layer norm, erf GELU, attention scores) are chapter 143's.
#load "see.coax";
#load "../fixtures/radio/oracle.coax";
#authority;

// book:begin types
RdStatus :: enum u8 {ok;config;shape;channels;depth;large;multiple;capacity;alias;number;missing;dtype;extra;}
// The encoder's fields: patch side, width in heads, the MLP's width, depth,
// the CPE table's side (a side by side grid), cls tokens, register tokens,
// how many cls tokens form the summary, the layer norms' epsilon, and the
// input conditioner's mean and spread per channel.
RdConfig :: struct {patch:int;width:int;heads:int;inner:int;depth:int;side:int;cls:int;registers:int;summary:int;epsilon:f64;mean:[3]f64;std:[3]f64;}
RdGrid :: struct {status:RdStatus;rows:int;cols:int;patches:int;tokens:int;features:int;}
RdResult :: struct {status:RdStatus;written:int;cause:int;}
RdBlock :: struct {norm1:[]f32;norm1_bias:[]f32;qkv:[]f32;qkv_bias:[]f32;proj:[]f32;proj_bias:[]f32;ls1:[]f32;
    norm2:[]f32;norm2_bias:[]f32;fc1:[]f32;fc1_bias:[]f32;fc2:[]f32;fc2_bias:[]f32;ls2:[]f32;}
// book:end types

// book:begin config
// C-RADIOv3-B: vit_base_patch16_v2_224 (16-pixel patches, width 768 in 12
// heads, MLP 3072, 12 blocks), CPE up to 2048 pixels (a 128 by 128 table),
// one cls token per teacher (4) and 4 registers. summary_idxs is [0, 1, 2]:
// the teachers with use_summary. The conditioner's mean and spread are the
// stored f32 values of OpenAI CLIP's.
rd_c_radio_v3_b :: ()->RdConfig {
    return RdConfig.{patch=16,width=768,heads=12,inner=3072,depth=12,side=128,cls=4,registers=4,summary=3,epsilon=0.000001,
        mean=[3]f64.[0.48145467042922974,0.45782750844955444,0.40821072459220886],std=[3]f64.[0.2686295509338379,0.2613025903701782,0.27577710151672363]};
}
// book:end config

// The tiny configuration the checks and the oracle share: 2-pixel patches,
// width 8 in 2 heads, MLP 6, 2 blocks, a 4 by 4 table, 3 cls tokens of which
// 2 form the summary, 1 register.
rd_tiny :: ()->RdConfig {c:=rd_c_radio_v3_b();c.patch=2;c.width=8;c.heads=2;c.inner=6;c.depth=2;c.side=4;c.cls=3;c.registers=1;c.summary=2;return c;}

// book:begin admit
rd_config_status :: (c:RdConfig)->RdStatus {
    sizes:=[7]int.[c.patch,c.width,c.heads,c.inner,c.depth,c.side,c.summary];
    for s:sizes {if s<1 || s>SV_EXTENT_MAX {return RdStatus.config;}}
    if c.summary>c.cls || c.registers<0 || c.cls+c.registers>SV_EXTENT_MAX || c.width%c.heads!=0 || !(c.epsilon>0) {return RdStatus.config;}
    if px_profile_status(rd_profile(c,PxImage.{width=PX_SIDE_MAX,height=PX_SIDE_MAX}))!=PxStatus.ok {return RdStatus.config;}
    return RdStatus.ok;
}
// An image is admitted as is: 8-bit RGB, both sides a multiple of the patch
// (the model's min_resolution_step without windowed attention), at most
// chapter 142's 512-pixel side and at most the position table's grid.
// The pinned processor does not resize, so neither does this.
rd_admit :: (c:RdConfig,image:PxImage)->RdGrid {
    if rd_config_status(c)!=RdStatus.ok {return RdGrid.{status=RdStatus.config};}
    s:=px_image_status(image);
    if s==PxStatus.shape {return RdGrid.{status=RdStatus.shape};}
    if s==PxStatus.limit {return RdGrid.{status=RdStatus.large};}
    if s==PxStatus.channels {return RdGrid.{status=RdStatus.channels};}
    if s==PxStatus.depth {return RdGrid.{status=RdStatus.depth};}
    if image.width%c.patch!=0 || image.height%c.patch!=0 {return RdGrid.{status=RdStatus.multiple};}
    g:=RdGrid.{rows=image.height/c.patch,cols=image.width/c.patch,features=3*c.patch*c.patch};
    if g.rows>c.side || g.cols>c.side {return RdGrid.{status=RdStatus.large};}
    g.patches=g.rows*g.cols;g.tokens=c.cls+c.registers+g.patches;
    return g;
}
// book:end admit

#test "configurations: the checkpoint, the tiny one, and each bad field alone" {
    e:=rd_c_radio_v3_b();t:=rd_tiny();
    #assert rd_config_status(e)==RdStatus.ok && rd_config_status(t)==RdStatus.ok;
    bad:=[13]RdConfig.[t,t,t,t,t,t,t,t,t,t,t,t,t];
    bad[0].patch=0;bad[1].width=0;bad[2].heads=0;bad[3].inner=0;bad[4].depth=0;bad[5].side=0;bad[6].summary=0;
    bad[7].summary=4;bad[8].registers=-1;bad[9].heads=3;bad[10].epsilon=0;bad[11].std[2]=0;bad[12].mean[0]=300;
    for b:bad {#assert rd_config_status(b)==RdStatus.config;}
    edge:=t;edge.width=SV_EXTENT_MAX;edge.inner=SV_EXTENT_MAX;edge.side=SV_EXTENT_MAX;edge.depth=SV_EXTENT_MAX;edge.summary=1;edge.cls=1;edge.registers=0;
    #assert rd_config_status(edge)==RdStatus.ok;
    sizes:=[7]int.[0,1,2,3,4,5,6];
    for k:sizes {
        over:=edge;if k==0 {over.patch=SV_EXTENT_MAX+1;} if k==1 {over.width=SV_EXTENT_MAX+1;over.heads=1;} if k==2 {over.heads=SV_EXTENT_MAX+1;}
        if k==3 {over.inner=SV_EXTENT_MAX+1;} if k==4 {over.depth=SV_EXTENT_MAX+1;} if k==5 {over.side=SV_EXTENT_MAX+1;}
        if k==6 {over.summary=SV_EXTENT_MAX+1;over.cls=SV_EXTENT_MAX+1;}
        #assert rd_config_status(over)==RdStatus.config;
    }
    edge.patch=SV_EXTENT_MAX;edge.heads=SV_EXTENT_MAX;edge.cls=SV_EXTENT_MAX;edge.summary=SV_EXTENT_MAX;#assert rd_config_status(edge)==RdStatus.ok;
    edge.registers=1;#assert rd_config_status(edge)==RdStatus.config;
    edge.cls=SV_EXTENT_MAX-1;edge.summary=1;#assert rd_config_status(edge)==RdStatus.ok;
    edge=t;edge.summary=3;edge.registers=0;#assert rd_config_status(edge)==RdStatus.ok;
}

#test "admission: grids, tokens and each refusal" {
    e:=rd_c_radio_v3_b();
    g:=rd_admit(e,PxImage.{width=64,height=48});
    #assert g.status==RdStatus.ok && g.rows==3 && g.cols==4 && g.patches==12 && g.tokens==20 && g.features==768;
    g=rd_admit(e,PxImage.{width=512,height=512});#assert g.status==RdStatus.ok && g.rows==32 && g.patches==1024 && g.tokens==1032;
    g=rd_admit(e,PxImage.{width=16,height=16});#assert g.status==RdStatus.ok && g.patches==1 && g.tokens==9;
    #assert rd_admit(e,PxImage.{width=64,height=40}).status==RdStatus.multiple;
    #assert rd_admit(e,PxImage.{width=60,height=48}).status==RdStatus.multiple;
    #assert rd_admit(e,PxImage.{width=528,height=48}).status==RdStatus.large;
    #assert rd_admit(e,PxImage.{width=0,height=48}).status==RdStatus.shape;
    #assert rd_admit(e,PxImage.{width=64,height=48,channels=4}).status==RdStatus.channels;
    #assert rd_admit(e,PxImage.{width=64,height=48,depth=16}).status==RdStatus.depth;
    bad:=e;bad.heads=5;#assert rd_admit(bad,PxImage.{width=64,height=48}).status==RdStatus.config;
    t:=rd_tiny();
    #assert rd_admit(t,PxImage.{width=8,height=8}).status==RdStatus.ok && rd_admit(t,PxImage.{width=8,height=8}).tokens==20;
    #assert rd_admit(t,PxImage.{width=10,height=8}).status==RdStatus.large && rd_admit(t,PxImage.{width=8,height=10}).status==RdStatus.large;
}

// book:begin pixels
// The input conditioner: bytes / 255, then (x - mean) / spread per channel;
// chapter 142's preprocessing with no resize.
rd_profile :: (c:RdConfig,image:PxImage)->PxProfile {
    return PxProfile.{scale=1.0/255,mean=c.mean,std=c.std,height=image.height,width=image.width,filter=PxFilter.nearest};
}
// Patch rows left to right, top to bottom; each holds (channel, row, column)
// values, the layout of the patch embedding's weight [768, 3 * 16 * 16].
rd_pixels :: (c:RdConfig,image:PxImage,bytes:[]u8,work:[]f32,out:[]f32,overlap:bool)->RdResult {
    g:=rd_admit(c,image);if g.status!=RdStatus.ok {return RdResult.{status=g.status};}
    stage:=3*image.width*image.height;
    if bytes.count!=stage {return RdResult.{status=RdStatus.shape};}
    if work.count<2*stage || out.count<g.patches*g.features {return RdResult.{status=RdStatus.capacity};}
    if overlap {return RdResult.{status=RdStatus.alias};}
    #assert px_preprocess(image,bytes,rd_profile(c,image),work[0..<stage],work[stage..<2*stage],false).written==stage;
    pp:=c.patch*c.patch;
    for r:0..<g.patches {for k:0..<g.features {
        y:=(r/g.cols)*c.patch+(k%pp)/c.patch;x:=(r%g.cols)*c.patch+k%c.patch;
        out[r*g.features+k]=work[stage+((k/pp)*image.height+y)*image.width+x];
    }}
    return RdResult.{written=g.patches*g.features};
}
// book:end pixels

rd_value :: (c:RdConfig,width:int,y:int,x:int,ch:int)->f32 {
    i:=3*(width*y+x)+ch;return f32((f64(f32(f64((i*37+11)%256)*(1.0/255)))-c.mean[ch])/c.std[ch]);
}
#test "pixels: bytes to patch rows by hand, and refusals before writing" {
    t:=rd_tiny();image:=PxImage.{width=6,height=4};bytes:[72]u8;sv_bytes(bytes[..]);work:[144]f32;out:[73]f32;out[72]=-7;
    r:=rd_pixels(t,image,bytes[..],work[..],out[..],false);
    #assert r.status==RdStatus.ok && r.written==72 && out[72]==-7;
    for p:0..<6 {for k:0..<12 {#assert out[p*12+k]==rd_value(t,6,(p/3)*2+(k%4)/2,(p%3)*2+k%2,k/4);}}
    // Patch 4 is grid cell (1, 1): its first value is pixel (2, 2), red.
    #assert out[48]==rd_value(t,6,2,2,0) && out[52]==rd_value(t,6,2,2,1) && out[59]==rd_value(t,6,3,3,2);
    oracle:=RD_ORACLE_WIDE_PATCHES;for i:0..<72 {#assert abs(f64(out[i])-oracle[i])<=3e-7;}
    tall:=PxImage.{width=4,height=6};#assert rd_pixels(t,tall,bytes[..],work[..],out[0..<72],false).written==72;
    oracle=RD_ORACLE_TALL_PATCHES;for i:0..<72 {#assert abs(f64(out[i])-oracle[i])<=3e-7;}
    out[0]=-7;
    #assert rd_pixels(t,PxImage.{width=5,height=4},bytes[0..<60],work[..],out[..],false).status==RdStatus.multiple;
    #assert rd_pixels(t,image,bytes[0..<71],work[..],out[..],false).status==RdStatus.shape;
    #assert rd_pixels(t,image,bytes[..],work[0..<143],out[..],false).status==RdStatus.capacity;
    #assert rd_pixels(t,image,bytes[..],work[..],out[0..<71],false).status==RdStatus.capacity;
    #assert rd_pixels(t,image,bytes[..],work[..],out[0..<72],true).status==RdStatus.alias;
    #assert out[0]==-7;
    // 3-pixel patches: 27 values a patch, (channel, row, column).
    three:=t;three.patch=3;wide:=PxImage.{width=6,height=3};w3:[108]f32;p3:[54]f32;
    #assert rd_pixels(three,wide,bytes[0..<54],w3[..],p3[..],false).written==54;
    for p:0..<2 {for k:0..<27 {#assert p3[p*27+k]==rd_value(three,6,(k%9)/3,p*3+k%3,k/9);}}
}

#test "attention: the largest score is subtracted, per head, whichever key holds it" {
    // Three tokens, two heads of 2. In head 1, token r's query and key point
    // at 120 * r degrees, lengths 40 and 80: its own score is 3200 / sqrt 2 =
    // 2263, past exp's range, and every other key scores 3394 less, so
    // softmax is exactly one-hot and token r reads its own value (r + 1,
    // -(r + 1)). Head 0's queries and keys are zero: every score is 0 and
    // each token reads the mean value, (2, -2).
    qkv:[36]f32;
    for r:0..<3 {
        a:=f64(r)*2.0943951023931953;t:=r*12;
        qkv[t+2]=f32(40*cos(a));qkv[t+3]=f32(40*sin(a));qkv[t+6]=2*qkv[t+2];qkv[t+7]=2*qkv[t+3];
        for e:0..<2 {qkv[t+8+2*e]=f32(r+1);qkv[t+9+2*e]=-f32(r+1);}
    }
    att:[12]f32;rd_attend(qkv[..],3,4,2,att[..]);
    for r:0..<3 {#assert att[4*r]==2 && att[4*r+1]==-2 && att[4*r+2]==f32(r+1) && att[4*r+3]==-f32(r+1);}
}

// book:begin embed
// The patch embedding is a row product without bias (768 inputs, 768
// outputs). Positions come from the 128 by 128 CPE table: resized
// bilinearly, corners aligned, to a square whose side is the grid's longer
// side, then cut to the grid from the top-left corner. The cls and register
// tokens go first, without positions.
rd_embed_work :: (c:RdConfig,g:RdGrid)->int {return (g.patches+1)*c.width;}
rd_embed :: (c:RdConfig,image:PxImage,patches:[]f32,w:[]f32,table:[]f32,tokens:[]f32,out:[]f32,work:[]f32,overlap:bool)->RdResult {
    g:=rd_admit(c,image);if g.status!=RdStatus.ok {return RdResult.{status=g.status};}
    n:=g.patches;d:=c.width;s:=c.cls+c.registers;
    if patches.count!=n*g.features || w.count!=d*g.features || table.count!=c.side*c.side*d || tokens.count!=s*d {return RdResult.{status=RdStatus.shape};}
    if out.count<g.tokens*d || work.count<rd_embed_work(c,g) {return RdResult.{status=RdStatus.capacity};}
    if overlap {return RdResult.{status=RdStatus.alias};}
    if !px_finite(patches) || !px_finite(w) || !px_finite(table) || !px_finite(tokens) {return RdResult.{status=RdStatus.number};}
    zero:=work[0..<d];y:=work[d..<work.count];for k:0..<d {zero[k]=0;}
    sv_linear(patches,n,g.features,w,zero,d,y);
    m:=(g.rows+g.cols+cast(int)abs(f64(g.rows-g.cols)))/2;
    bad:=false;
    for r:0..<n {
        a:=sv_point(r/g.cols,m,c.side);b:=sv_point(r%g.cols,m,c.side);low:=a.low*c.side;high:=a.high*c.side;
        for k:0..<d {
            top:=(1-b.fraction)*f64(table[(low+b.low)*d+k])+b.fraction*f64(table[(low+b.high)*d+k]);
            bottom:=(1-b.fraction)*f64(table[(high+b.low)*d+k])+b.fraction*f64(table[(high+b.high)*d+k]);
            y[r*d+k]=sv_f32(f64(y[r*d+k])+f64(sv_f32((1-a.fraction)*top+a.fraction*bottom)));bad=bad || !rd_finite(y[r*d+k]);
        }
    }
    if bad {return RdResult.{status=RdStatus.number};}
    for i:0..<s*d {out[i]=tokens[i];}
    for i:0..<n*d {out[s*d+i]=y[i];}
    return RdResult.{written=g.tokens*d};
}
// book:end embed

#test "position points: the longer side sets the square" {
    // A 3 by 4 grid on the 128-row table: the square is 4, so row 1 reads
    // 127 / 3 = 42.333 and column 3 reads 127.
    p:=sv_point(1,4,128);#assert p.low==42 && p.high==43 && abs(p.fraction-1.0/3)<1e-12;
    p=sv_point(3,4,128);#assert p.low==127 && p.high==127 && p.fraction==0;
    p=sv_point(0,1,128);#assert p.low==0 && p.high==0 && p.fraction==0;
}

// book:begin block
// One block: x + ls1 * proj(attention(norm1(x))), then
// + ls2 * fc2(gelu(fc1(norm2(x)))). Attention is plain softmax attention
// over every token in both directions, 12 heads of 64; there is no rotary
// position: the positions were added once, at the embedding.
// The layer-scaled branch rounds to f32 before the residual sum; a value
// past f32 stays as it is, so the sum's rounding refuses it.
rd_finite :: (v:f32)->bool {return psionic_tensor_finite_bits(f32_bits(v));}
rd_round :: (v:f64)->f64 {if psionic_ops_fits_f32(v) {return f64(f32(v));}return v;}
rd_block_work :: (c:RdConfig,n:int)->int {return n*(6*c.width+c.inner);}
rd_block_status :: (c:RdConfig,w:RdBlock)->RdStatus {
    d:=c.width;i:=c.inner;
    parts:=[14][]f32.[w.norm1,w.norm1_bias,w.qkv,w.qkv_bias,w.proj,w.proj_bias,w.ls1,w.norm2,w.norm2_bias,w.fc1,w.fc1_bias,w.fc2,w.fc2_bias,w.ls2];
    want:=[14]int.[d,d,3*d*d,3*d,d*d,d,d,d,d,i*d,i,d*i,d,d];
    for k:0..<14 {if parts[k].count!=want[k] {return RdStatus.shape;}}
    for p:parts {if !px_finite(p) {return RdStatus.number;}}
    return RdStatus.ok;
}
rd_block :: (c:RdConfig,image:PxImage,x:[]f32,w:RdBlock,out:[]f32,work:[]f32,overlap:bool)->RdResult {
    g:=rd_admit(c,image);if g.status!=RdStatus.ok {return RdResult.{status=g.status};}
    n:=g.tokens;d:=c.width;
    if x.count!=n*d {return RdResult.{status=RdStatus.shape};}
    s:=rd_block_status(c,w);if s!=RdStatus.ok {return RdResult.{status=s};}
    if out.count!=n*d || work.count<rd_block_work(c,n) {return RdResult.{status=RdStatus.capacity};}
    if overlap {return RdResult.{status=RdStatus.alias};}
    if !px_finite(x) {return RdResult.{status=RdStatus.number};}
    // Each region runs to the end of work; only its start matters.
    mid:=work;h:=work[n*d..<work.count];qkv:=work[2*n*d..<work.count];att:=work[5*n*d..<work.count];f:=work[6*n*d..<work.count];
    sv_norm(x,n,d,w.norm1,w.norm1_bias,c.epsilon,h);
    sv_linear(h,n,d,w.qkv,w.qkv_bias,3*d,qkv);
    rd_attend(qkv,n,d,c.heads,att);
    sv_linear(att,n,d,w.proj,w.proj_bias,d,mid);
    for i:0..<n*d {mid[i]=sv_f32(f64(x[i])+rd_round(f64(mid[i])*f64(w.ls1[i%d])));}
    sv_norm(mid,n,d,w.norm2,w.norm2_bias,c.epsilon,h);
    sv_linear(h,n,d,w.fc1,w.fc1_bias,c.inner,f);
    for i:0..<n*c.inner {f[i]=sv_f32(sv_gelu(f64(f[i])));}
    sv_linear(f,n,c.inner,w.fc2,w.fc2_bias,d,att);
    bad:=false;
    for i:0..<n*d {att[i]=sv_f32(f64(mid[i])+rd_round(f64(att[i])*f64(w.ls2[i%d])));bad=bad || !rd_finite(att[i]);}
    if bad {return RdResult.{status=RdStatus.number};}
    for i:0..<n*d {out[i]=att[i];}
    return RdResult.{written=n*d};
}
// Softmax attention per head over all n tokens. The largest score is
// subtracted before exponentiating, so scores past 709 do not overflow.
rd_attend :: (qkv:[]f32,n:int,d:int,heads:int,att:[]f32) {
    hd:=d/heads;scale:=1/sqrt(f64(hd));
    for head:0..<heads {for r:0..<n {
        q:=r*3*d+head*hd;top:f64;
        for j:0..<n {v:=sv_score(qkv,q,j*3*d+d+head*hd,hd,scale);top=ifx j==0 then v else (top+v+abs(top-v))/2;}
        total:=0.0;for j:0..<n {total+=exp(sv_score(qkv,q,j*3*d+d+head*hd,hd,scale)-top);}
        for e:0..<hd {
            acc:=0.0;
            for j:0..<n {acc+=exp(sv_score(qkv,q,j*3*d+d+head*hd,hd,scale)-top)*f64(qkv[j*3*d+2*d+head*hd+e]);}
            att[r*d+head*hd+e]=sv_f32(acc/total);
        }
    }}
}
// book:end block

// book:begin outputs
// The model has no final norm (model_norm is false). The summary is the
// first `summary` cls tokens joined end to end (3 * 768 = 2304 values); the
// spatial features are every patch token, after the cls and register
// tokens, one row of 768 per grid cell, rows then columns.
rd_split :: (c:RdConfig,image:PxImage,y:[]f32,summary:[]f32,features:[]f32)->RdResult {
    g:=rd_admit(c,image);if g.status!=RdStatus.ok {return RdResult.{status=g.status};}
    d:=c.width;s:=c.cls+c.registers;
    if y.count!=g.tokens*d {return RdResult.{status=RdStatus.shape};}
    if summary.count!=c.summary*d || features.count!=g.patches*d {return RdResult.{status=RdStatus.capacity};}
    for i:0..<c.summary*d {summary[i]=y[i];}
    for i:0..<g.patches*d {features[i]=y[s*d+i];}
    return RdResult.{written=(c.summary+g.patches)*d};
}
// book:end outputs

// book:begin encode
// The whole encoder: bytes to patch rows, the embedding, every block, then
// the summary and the spatial features.
RdWeights :: struct {patch:[]f32;table:[]f32;tokens:[]f32;blocks:[]RdBlock;}
rd_encode_work :: (c:RdConfig,image:PxImage)->int {
    g:=rd_admit(c,image);if g.status!=RdStatus.ok {return 0;}
    return rd_scratch(c,image,g)+g.patches*g.features+2*g.tokens*c.width;
}
// The scratch serves the pixels (two channel-major images) and then each
// block: the larger of the two.
rd_scratch :: (c:RdConfig,image:PxImage,g:RdGrid)->int {
    p:=6*image.width*image.height;b:=rd_block_work(c,g.tokens);return (p+b+cast(int)abs(f64(p-b)))/2;
}
rd_encode :: (c:RdConfig,image:PxImage,bytes:[]u8,w:RdWeights,summary:[]f32,features:[]f32,work:[]f32,overlap:bool)->RdResult {
    g:=rd_admit(c,image);if g.status!=RdStatus.ok {return RdResult.{status=g.status};}
    if w.blocks.count!=c.depth {return RdResult.{status=RdStatus.shape};}
    if work.count<rd_encode_work(c,image) {return RdResult.{status=RdStatus.capacity};}
    sc:=rd_scratch(c,image,g);np:=g.patches*g.features;nt:=g.tokens*c.width;
    scratch:=work[0..<sc];patches:=work[sc..<sc+np];a:=work[sc+np..<sc+np+nt];b:=work[sc+np+nt..<sc+np+2*nt];
    r:=rd_pixels(c,image,bytes,scratch,patches,overlap);if r.status!=RdStatus.ok {return r;}
    r=rd_embed(c,image,patches,w.patch,w.table,w.tokens,a,scratch,false);if r.status!=RdStatus.ok {return r;}
    for k:0..<c.depth {
        r=rd_block(c,image,a,w.blocks[k],b,scratch,false);if r.status!=RdStatus.ok {return RdResult.{status=r.status,cause=k};}
        for i:0..<nt {a[i]=b[i];}
    }
    r=rd_split(c,image,a,summary,features);
    return r;
}
// book:end encode

// Tiny synthetic weights, laid out exactly as the oracle generates them.
RD_TINY_BLOCK :: 446;
RdTiny :: struct {patch:[96]f32;table:[128]f32;tokens:[32]f32;blocks:[892]f32;}
rd_tiny_weights :: ()->RdTiny {t:RdTiny;sv_fill(t.patch[..],5);sv_fill(t.table[..],7);sv_fill(t.tokens[..],3);sv_fill(t.blocks[..],11);return t;}
rd_tiny_block :: (b:[]f32)->RdBlock {
    return RdBlock.{norm1=b[0..<8],norm1_bias=b[8..<16],qkv=b[16..<208],qkv_bias=b[208..<232],proj=b[232..<296],proj_bias=b[296..<304],ls1=b[304..<312],
        norm2=b[312..<320],norm2_bias=b[320..<328],fc1=b[328..<376],fc1_bias=b[376..<382],fc2=b[382..<430],fc2_bias=b[430..<438],ls2=b[438..<446]};
}

#test "the tiny encoder agrees with the independent oracle, wide and tall" {
    t:=rd_tiny();w:=rd_tiny_weights();bytes:[72]u8;sv_bytes(bytes[..]);
    blocks:=[2]RdBlock.[rd_tiny_block(w.blocks[0..<RD_TINY_BLOCK]),rd_tiny_block(w.blocks[RD_TINY_BLOCK..<2*RD_TINY_BLOCK])];
    weights:=RdWeights.{patch=w.patch[..],table=w.table[..],tokens=w.tokens[..],blocks=blocks[..]};
    for side:0..<2 {
        image:=PxImage.{width=6,height=4};oe:=RD_ORACLE_WIDE_EMBED;ob:=RD_ORACLE_WIDE_BLOCK;os:=RD_ORACLE_WIDE_SUMMARY;of:=RD_ORACLE_WIDE_FEATURES;
        if side==1 {image=PxImage.{width=4,height=6};oe=RD_ORACLE_TALL_EMBED;ob=RD_ORACLE_TALL_BLOCK;os=RD_ORACLE_TALL_SUMMARY;of=RD_ORACLE_TALL_FEATURES;}
        work:[1000]f32;for i:0..<1000 {work[i]=-7;}patches:[72]f32;
        #assert rd_pixels(t,image,bytes[..],work[..],patches[..],false).written==72;
        embedded:[80]f32;r:=rd_embed(t,image,patches[..],w.patch[..],w.table[..],w.tokens[..],embedded[..],work[..],false);
        #assert r.status==RdStatus.ok && r.written==80 && rd_near(embedded[..],oe[..]);
        blocked:[80]f32;r=rd_block(t,image,embedded[..],blocks[0],blocked[..],work[..],false);
        #assert r.status==RdStatus.ok && r.written==80 && rd_near(blocked[..],ob[..]);
        summary:[16]f32;features:[48]f32;for i:0..<1000 {work[i]=-7;}
        #assert rd_encode_work(t,image)==72+160+540;
        r=rd_encode(t,image,bytes[..],weights,summary[..],features[..],work[0..<772],false);
        #assert r.status==RdStatus.ok && r.written==64 && rd_near(summary[..],os[..]) && rd_near(features[..],of[..]);
    }
}

#test "encoder refusals come before any write" {
    t:=rd_tiny();image:=PxImage.{width=6,height=4};g:=rd_admit(t,image);w:=rd_tiny_weights();
    x:[72]f32;sv_fill(x[..],3);work:[1000]f32;out:[80]f32;for i:0..<80 {out[i]=-7;}
    pw:=w.patch[..];tb:=w.table[..];tk:=w.tokens[..];
    #assert rd_embed_work(t,g)==56;
    #assert rd_embed(t,PxImage.{width=5,height=4},x[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.multiple;
    #assert rd_embed(t,image,x[0..<71],pw,tb,tk,out[..],work[..],false).status==RdStatus.shape;
    #assert rd_embed(t,image,x[..],pw[0..<95],tb,tk,out[..],work[..],false).status==RdStatus.shape;
    #assert rd_embed(t,image,x[..],pw,tb[0..<127],tk,out[..],work[..],false).status==RdStatus.shape;
    #assert rd_embed(t,image,x[..],pw,tb,tk[0..<31],out[..],work[..],false).status==RdStatus.shape;
    #assert rd_embed(t,image,x[..],pw,tb,tk,out[0..<79],work[..],false).status==RdStatus.capacity;
    #assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[0..<55],false).status==RdStatus.capacity;
    #assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[0..<56],true).status==RdStatus.alias;
    nan:=x;nan[71]=0.0/0.0;#assert rd_embed(t,image,nan[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.number;
    w.patch[95]=1.0/0.0;#assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.number;w.patch[95]=0;
    w.table[127]=1.0/0.0;#assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.number;w.table[127]=0;
    w.tokens[31]=1.0/0.0;#assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.number;w.tokens[31]=0;
    // Only the last patch's last feature overflows: grid (1, 2) blends table
    // cells (1, 3) and (2, 3), each 3e38 there, so 3e38 + 3e38.
    w=rd_tiny_weights();w.table[63]=3e38;w.table[95]=3e38;for i:0..<12 {w.patch[84+i]=0;}w.patch[95]=1;x[71]=3e38;
    #assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.number;
    x[71]=1e37;#assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.ok;
    for i:0..<80 {out[i]=-7;}
    x[71]=3e38;#assert rd_embed(t,image,x[..],pw,tb,tk,out[..],work[..],false).status==RdStatus.number;
    for v:out {#assert v==-7;}
    w=rd_tiny_weights();sv_fill(x[..],3);

    h:=out[0..<80];sv_fill(h,3);b:=rd_tiny_block(w.blocks[0..<RD_TINY_BLOCK]);y:[80]f32;for i:0..<80 {y[i]=-7;}
    #assert rd_block_work(t,10)==540;
    #assert rd_block(t,PxImage.{width=5,height=4},h,b,y[..],work[..],false).status==RdStatus.multiple;
    #assert rd_block(t,image,h[0..<79],b,y[..],work[..],false).status==RdStatus.shape;
    starts:=[14]int.[0,8,16,208,232,296,304,312,320,328,376,382,430,438];
    for k:0..<14 {
        short:=b;
        if k==0 {short.norm1=b.norm1[0..<7];} if k==1 {short.norm1_bias=b.norm1_bias[0..<7];} if k==2 {short.qkv=b.qkv[0..<191];}
        if k==3 {short.qkv_bias=b.qkv_bias[0..<23];} if k==4 {short.proj=b.proj[0..<63];} if k==5 {short.proj_bias=b.proj_bias[0..<7];}
        if k==6 {short.ls1=b.ls1[0..<7];} if k==7 {short.norm2=b.norm2[0..<7];} if k==8 {short.norm2_bias=b.norm2_bias[0..<7];}
        if k==9 {short.fc1=b.fc1[0..<47];} if k==10 {short.fc1_bias=b.fc1_bias[0..<5];} if k==11 {short.fc2=b.fc2[0..<47];}
        if k==12 {short.fc2_bias=b.fc2_bias[0..<7];} if k==13 {short.ls2=b.ls2[0..<7];}
        #assert rd_block(t,image,h,short,y[..],work[..],false).status==RdStatus.shape;
        saved:=w.blocks;w.blocks[starts[k]]=1.0/0.0;
        #assert rd_block(t,image,h,b,y[..],work[..],false).status==RdStatus.number;w.blocks=saved;
    }
    #assert rd_block(t,image,h,b,y[0..<79],work[..],false).status==RdStatus.capacity;
    wide:[81]f32;#assert rd_block(t,image,h,b,wide[..],work[..],false).status==RdStatus.capacity;
    #assert rd_block(t,image,h,b,y[..],work[0..<539],false).status==RdStatus.capacity;
    #assert rd_block(t,image,h,b,y[..],work[0..<540],true).status==RdStatus.alias;
    hx:[80]f32;sv_fill(hx[..],3);hx[79]=1.0/0.0;#assert rd_block(t,image,hx[..],b,y[..],work[..],false).status==RdStatus.number;
    // Layer scale 3e38 on the last feature: x + ls2 * mlp overflows only there.
    w.blocks[445]=3e38;w.blocks[437]=3e38;#assert rd_block(t,image,h,b,y[..],work[..],false).status==RdStatus.number;
    for v:y {#assert v==-7;}
    w=rd_tiny_weights();#assert rd_block(t,image,h,b,y[..],work[0..<540],false).written==80;

    summary:[16]f32;features:[48]f32;for i:0..<16 {summary[i]=-7;}
    #assert rd_split(t,PxImage.{width=5,height=4},h,summary[..],features[..]).status==RdStatus.multiple;
    #assert rd_split(t,image,h[0..<79],summary[..],features[..]).status==RdStatus.shape;
    #assert rd_split(t,image,h,summary[0..<15],features[..]).status==RdStatus.capacity;
    #assert rd_split(t,image,h,summary[..],features[0..<47]).status==RdStatus.capacity;
    #assert summary[0]==-7;
    r:=rd_split(t,image,h,summary[..],features[..]);
    #assert r.written==64 && summary[0]==h[0] && summary[15]==h[15] && features[0]==h[32] && features[47]==h[79];

    bytes:[72]u8;sv_bytes(bytes[..]);
    blocks:=[2]RdBlock.[rd_tiny_block(w.blocks[0..<RD_TINY_BLOCK]),rd_tiny_block(w.blocks[RD_TINY_BLOCK..<2*RD_TINY_BLOCK])];
    weights:=RdWeights.{patch=w.patch[..],table=w.table[..],tokens=w.tokens[..],blocks=blocks[..]};
    one:=weights;one.blocks=blocks[0..<1];
    #assert rd_encode_work(t,PxImage.{width=5,height=4})==0;
    #assert rd_encode(t,PxImage.{width=5,height=4},bytes[0..<60],weights,summary[..],features[..],work[..],false).status==RdStatus.multiple;
    #assert rd_encode(t,image,bytes[..],one,summary[..],features[..],work[..],false).status==RdStatus.shape;
    #assert rd_encode(t,image,bytes[..],weights,summary[..],features[..],work[0..<771],false).status==RdStatus.capacity;
    #assert rd_encode(t,image,bytes[..],weights,summary[..],features[..],work[0..<772],true).status==RdStatus.alias;
    #assert rd_encode(t,image,bytes[0..<71],weights,summary[..],features[..],work[..],false).status==RdStatus.shape;
    bad:=weights;bad.patch=w.patch[0..<95];#assert rd_encode(t,image,bytes[..],bad,summary[..],features[..],work[..],false).status==RdStatus.shape;
    for i:0..<16 {summary[i]=-7;}w.blocks[RD_TINY_BLOCK+16]=1.0/0.0;r=rd_encode(t,image,bytes[..],weights,summary[..],features[..],work[..],false);
    #assert r.status==RdStatus.number && r.cause==1 && summary[0]==-7;
    w=rd_tiny_weights();
    #assert rd_encode(t,image,bytes[..],weights,summary[0..<15],features[..],work[..],false).status==RdStatus.capacity;
    big:=PxImage.{width=8,height=8};#assert rd_encode_work(t,big)==192+2*160+rd_block_work(t,20);
    // 4-pixel patches on 16 by 16: the pixels' scratch (6 * 256 = 1536) passes a block's (20 * 54).
    four:=t;four.patch=4;#assert rd_encode_work(four,PxImage.{width=16,height=16})==768+2*160+1536;
    small:=PxImage.{width=2,height=2};#assert rd_encode_work(t,small)==12+2*40+270;
}

// book:begin inventory
// The tensors the checkpoint must hold, in a fixed order: seven shared ones,
// then fourteen per block. Each entry writes its name and returns its shape
// and type: every tensor is F32 except summary_idxs, I64. reg_token is
// timm's own register table; the CPE forward reads the cls_token table's
// four registers instead, so it is checked but never used.
RD_SHARED :: 7;
RD_PER_BLOCK :: 14;
RdDtype :: enum u8 {f32;i64;}
RdTensor :: struct {name:string;dtype:RdDtype;shape:P5Shape;elements:int;}
RdNeed :: struct {count:int;dtype:RdDtype;shape:P5Shape;}
rd_s3 :: (a:int,b:int,c:int)->P5Shape {s:=sv_s2(a,b);s.rank=3;s.dims[2]=c;return s;}
rd_tensors :: (c:RdConfig)->int {return RD_SHARED+RD_PER_BLOCK*c.depth;}
rd_need :: (c:RdConfig,i:int,name:[]u8)->RdNeed {
    d:=c.width;
    n:=json_raw(name,0,"radio_model.");
    if i<RD_SHARED {
        shared:=[7]string.["summary_idxs","input_conditioner.norm_mean","input_conditioner.norm_std","model.patch_generator.embedder.weight",
            "model.patch_generator.pos_embed","model.patch_generator.cls_token.token","model.reg_token"];
        shapes:=[7]P5Shape.[sv_s1(c.summary),rd_s3(3,1,1),rd_s3(3,1,1),sv_s2(d,3*c.patch*c.patch),rd_s3(1,c.side*c.side,d),
            sv_s2(c.cls+c.registers,d),rd_s3(1,c.registers,d)];
        need:=RdNeed.{count=json_raw(name,n,shared[i]),shape=shapes[i]};
        if i==0 {need.dtype=RdDtype.i64;}
        return need;
    }
    b:=(i-RD_SHARED)/RD_PER_BLOCK;j:=i-RD_SHARED-b*RD_PER_BLOCK;
    suffixes:=[14]string.["norm1.weight","norm1.bias","attn.qkv.weight","attn.qkv.bias","attn.proj.weight","attn.proj.bias","ls1.grandma",
        "norm2.weight","norm2.bias","mlp.fc1.weight","mlp.fc1.bias","mlp.fc2.weight","mlp.fc2.bias","ls2.grandma"];
    shapes:=[14]P5Shape.[sv_s1(d),sv_s1(d),sv_s2(3*d,d),sv_s1(3*d),sv_s2(d,d),sv_s1(d),sv_s1(d),
        sv_s1(d),sv_s1(d),sv_s2(c.inner,d),sv_s1(c.inner),sv_s2(d,c.inner),sv_s1(d),sv_s1(d)];
    n=json_raw(name,n,"model.blocks.");n=json_write_int(name,n,b);n=json_raw(name,n,".");
    return RdNeed.{count=json_raw(name,n,suffixes[j]),shape=shapes[j]};
}
// Every needed tensor present once, with its type and the config's shape,
// and nothing else in the file. Returns the element count.
rd_inventory :: (c:RdConfig,inventory:[]RdTensor)->RdResult {
    if rd_config_status(c)!=RdStatus.ok {return RdResult.{status=RdStatus.config};}
    total:=0;
    for i:0..<rd_tensors(c) {
        name:[128]u8;need:=rd_need(c,i,name[..]);key:=cast(string)name[0..<need.count];found:=-1;
        for t:0..<inventory.count {if inventory[t].name==key {if found>=0 {return RdResult.{status=RdStatus.extra,cause=i};}found=t;}}
        if found<0 {return RdResult.{status=RdStatus.missing,cause=i};}
        if inventory[found].dtype!=need.dtype {return RdResult.{status=RdStatus.dtype,cause=i};}
        if !pa_shape_equal(inventory[found].shape,need.shape) {return RdResult.{status=RdStatus.shape,cause=i};}
        total+=inventory[found].elements;
    }
    if inventory.count!=rd_tensors(c) {return RdResult.{status=RdStatus.extra,cause=inventory.count};}
    return RdResult.{written=total,cause=inventory.count};
}
// book:end inventory

rd_name :: (c:RdConfig,i:int,buffer:[]u8)->string {need:=rd_need(c,i,buffer);return cast(string)buffer[0..<need.count];}
#test "names and shapes of the C-RADIO tensors" {
    e:=rd_c_radio_v3_b();
    #assert rd_tensors(e)==175;
    a:[128]u8;
    #assert rd_name(e,0,a[..])=="radio_model.summary_idxs" && rd_need(e,0,a[..]).dtype==RdDtype.i64 && rd_need(e,0,a[..]).shape.dims[0]==3;
    #assert rd_name(e,1,a[..])=="radio_model.input_conditioner.norm_mean" && rd_need(e,1,a[..]).dtype==RdDtype.f32;
    s:=rd_need(e,2,a[..]).shape;#assert s.rank==3 && s.dims[0]==3 && s.dims[1]==1 && s.dims[2]==1 && s.dims[3]==0 && s.dims[4]==0;
    #assert rd_name(e,2,a[..])=="radio_model.input_conditioner.norm_std";
    #assert rd_name(e,3,a[..])=="radio_model.model.patch_generator.embedder.weight" && rd_need(e,3,a[..]).shape.dims[1]==768;
    s=rd_need(e,4,a[..]).shape;#assert rd_name(e,4,a[..])=="radio_model.model.patch_generator.pos_embed" && s.rank==3 && s.dims[0]==1 && s.dims[1]==16384 && s.dims[2]==768;
    s=rd_need(e,5,a[..]).shape;#assert rd_name(e,5,a[..])=="radio_model.model.patch_generator.cls_token.token" && s.dims[0]==8 && s.dims[1]==768;
    s=rd_need(e,6,a[..]).shape;#assert rd_name(e,6,a[..])=="radio_model.model.reg_token" && s.rank==3 && s.dims[1]==4 && s.dims[2]==768;
    #assert rd_name(e,7,a[..])=="radio_model.model.blocks.0.norm1.weight";
    s=rd_need(e,9,a[..]).shape;#assert rd_name(e,9,a[..])=="radio_model.model.blocks.0.attn.qkv.weight" && s.dims[0]==2304 && s.dims[1]==768;
    #assert rd_name(e,13,a[..])=="radio_model.model.blocks.0.ls1.grandma";
    s=rd_need(e,16,a[..]).shape;#assert rd_name(e,16,a[..])=="radio_model.model.blocks.0.mlp.fc1.weight" && s.dims[0]==3072 && s.dims[1]==768;
    s=rd_need(e,18,a[..]).shape;#assert rd_name(e,18,a[..])=="radio_model.model.blocks.0.mlp.fc2.weight" && s.dims[0]==768 && s.dims[1]==3072;
    #assert rd_name(e,174,a[..])=="radio_model.model.blocks.11.ls2.grandma" && rd_need(e,174,a[..]).dtype==RdDtype.f32;
}

rd_size :: (s:P5Shape)->int {n:=1;for k:0..<s.rank {n*=s.dims[k];}return n;}
#test "inventory: complete, then each defect alone" {
    t:=rd_tiny();count:=rd_tensors(t);#assert count==35;
    names:[35][128]u8;inv:[36]RdTensor;
    for i:0..<count {need:=rd_need(t,i,names[i][..]);inv[i]=RdTensor.{name=cast(string)names[i][0..<need.count],dtype=need.dtype,shape=need.shape,elements=rd_size(need.shape)};}
    r:=rd_inventory(t,inv[0..<35]);
    // 2 + 3 + 3 + 96 + 128 + 32 + 8 shared, 446 per block.
    #assert r.status==RdStatus.ok && r.written==2+3+3+96+128+32+8+2*446 && r.cause==35;
    bad:=t;bad.heads=3;#assert rd_inventory(bad,inv[0..<35]).status==RdStatus.config;
    r=rd_inventory(t,inv[0..<34]);#assert r.status==RdStatus.missing && r.cause==34;
    saved:=inv[3];inv[3].dtype=RdDtype.i64;r=rd_inventory(t,inv[0..<35]);#assert r.status==RdStatus.dtype && r.cause==3;inv[3]=saved;
    saved=inv[0];inv[0].dtype=RdDtype.f32;r=rd_inventory(t,inv[0..<35]);#assert r.status==RdStatus.dtype && r.cause==0;inv[0]=saved;
    saved=inv[4];inv[4].shape.dims[1]=15;r=rd_inventory(t,inv[0..<35]);#assert r.status==RdStatus.shape && r.cause==4;inv[4]=saved;
    inv[35]=inv[20];r=rd_inventory(t,inv[0..<36]);#assert r.status==RdStatus.extra && r.cause==20;
    inv[35]=inv[0];r=rd_inventory(t,inv[0..<36]);#assert r.status==RdStatus.extra && r.cause==0;
    inv[35]=RdTensor.{name="radio_model.model.norm.weight",shape=sv_s1(8),elements=8};r=rd_inventory(t,inv[0..<36]);#assert r.status==RdStatus.extra && r.cause==36;
}
