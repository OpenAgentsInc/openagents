#load "types.coax";
#authority;
RsHttp :: struct {status:int;route:int;body:int;length:int;profile:int;}
#test "HTTP framing rejects ambiguous lengths, transfer encodings and bad auth" {
    #assert rs_settings("0123456789abcdef",8080) && !rs_settings("short",8080) && !rs_settings("0123456789abcde ",8080) && !rs_settings("0123456789abcdef",80);
    key:="0123456789abcdef";
    h:=rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}",key);#assert h.status==200 && h.route==1 && h.length==2;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nContent-Length: 2\r\nContent-Length: 2\r\n\r\n{}",key).status==400;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n",key).status==400;
    #assert rs_http("GET /v1/models HTTP/1.1\r\n\r\n",key).status==401;
    #assert rs_http("GET /healthz HTTP/1.1\r\n\r\n",key).route==3;
    #assert rs_http("GET /healthz HTTP/1.1\r\n",key).status==0;
    #assert rs_lower('A')=='a' && rs_eq("AbC","aBc") && !rs_eq("a","ab");#assert rs_trim(" \tx \t")=="x";
    #assert rs_secret("aa","aa") && !rs_secret("aa","ab");
    out:[512]u8;#assert rs_headers(200,2,false,out[..])>0 && rs_headers(503,0,true,out[..])>0;
    #assert rs_ingress(0,4999) && !rs_ingress(0,5000) && !rs_ingress(1,0);
}
rs_lower :: (c:u8)->u8 #effects(all) {return ifx c>='A' && c<='Z' then c+32 else c;}
rs_eq :: (a:string,b:string)->bool #effects(all) {if a.count!=b.count {return false;}for i:0..<a.count {if rs_lower(a[i])!=rs_lower(b[i]) {return false;}}return true;}
rs_trim :: (s:string)->string #effects(all) {a:=0;b:=s.count;while a<b && (s[a]==32 || s[a]==9) {a+=1;}while b>a && (s[b-1]==32 || s[b-1]==9) {b-=1;}return s[a..<b];}
rs_secret :: (a:string,b:string)->bool #effects(all) {if a.count!=b.count {return false;}v:u8=0;for i:0..<a.count {v=v | (a[i]^b[i]);}return v==0;}
rs_ingress :: (start:int,now:int)->bool #export_c #effects(all) {return now>=start && now-start<5000;}
rs_http :: (text:string,key:string)->RsHttp #export_c #effects(all) {
    end:= -1;for i:0..<text.count {if i+3<text.count && text[i..<i+4]=="\r\n\r\n" {end=i+4;break;}}
    if end<0 {return RsHttp.{status=ifx text.count>=8192 then 431 else 0};}if end>8192 {return RsHttp.{status=431};}  // mutant: equivalent (a found terminator puts end at 4 or more, so end<0 and end<1 agree)
    first:= -1;for i:0..<end-1 {if text[i..<i+2]=="\r\n" {first=i;break;}}if first<0 {return RsHttp.{status=400};}  // mutant: equivalent (the terminator's own CRLF at end - 4 is always found first or earlier, so the scan's bound and its refusal never apply, and a CRLF at 0 gives line "" or one starting with CR, both 404)
    line:=text[0..<first];r:=RsHttp.{status=200,body=end};
    if line=="POST /v1/responses HTTP/1.1" || line=="POST /v1/responses HTTP/1.0" {r.route=1;}
    else if line=="GET /v1/models HTTP/1.1" || line=="GET /v1/models HTTP/1.0" {r.route=2;}
    else if line=="GET /healthz HTTP/1.1" || line=="GET /healthz HTTP/1.0" {r.route=3;}
    else if line=="GET /readyz HTTP/1.1" || line=="GET /readyz HTTP/1.0" {r.route=4;}
    else {return RsHttp.{status=404};}
    at:=first+2;length:=false;auth:=false;ctype:=false;profile:=false;
    while at<end-2 {finish:=at;while finish+1<end && text[finish..<finish+2]!="\r\n" {finish+=1;}colon:=at;while colon<finish && text[colon]!=':' {colon+=1;}if colon==at || colon==finish {return RsHttp.{status=400};}name:=text[at..<colon];for c:name {if !((c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='-') {return RsHttp.{status=400};}}value:=rs_trim(text[colon+1..<finish]);  // mutant: equivalent (each header line starts at or before end - 5 and its CRLF lies before end - 3, so the loop bounds agree; a line with no colon still refuses, its name then holding CR)
        if rs_eq(name,"content-length") {if length {return RsHttp.{status=400};}length=true;if value.count<1 || value.count>6 {return RsHttp.{status=413};}n:=0;for c:value {if c<'0' || c>'9' {return RsHttp.{status=400};}n=n*10+cast(int)c-48;}if n>65536 {return RsHttp.{status=413};}r.length=n;}
        else if rs_eq(name,"transfer-encoding") {return RsHttp.{status=400};}
        else if rs_eq(name,"expect") {return RsHttp.{status=417};}
        else if rs_eq(name,"authorization") {if auth {return RsHttp.{status=400};}auth=true;if value.count<7 || value[0..<7]!="Bearer " || !rs_secret(value[7..<value.count],key) {return RsHttp.{status=401};}}  // mutant: equivalent (trimming removes a trailing space, so a value of exactly 7 bytes never starts with "Bearer ")
        else if rs_eq(name,"content-type") {if ctype {return RsHttp.{status=400};}ctype=true;semi:=value.count;for i:0..<value.count {if value[i]==';' {semi=i;break;}}if !rs_eq(rs_trim(value[0..<semi]),"application/json") {return RsHttp.{status=415};}}  // mutant: equivalent (a ';' at 0 leaves a prefix that is empty or starts with ';', never application/json)
        else if rs_eq(name,"x-psionic-responses-profile") {if profile {return RsHttp.{status=400};}profile=true;if value=="openresponses-2026-04-24" {r.profile=1;}else if value!="psionic-gptoss-responses-v1" {return RsHttp.{status=400};}}
        at=finish+2;
    }
    if r.route<=2 && !auth {return RsHttp.{status=401};}if r.route==1 && !length {return RsHttp.{status=411};}if r.route==1 && !ctype {return RsHttp.{status=415};}if r.route!=1 && r.length>0 {return RsHttp.{status=400};}
    if text.count<end+r.length {r.status=0;}return r;
}
rs_headers :: (status:int,length:int,stream:bool,out:[]u8)->int #export_c #effects(all) {
    w:=[1]RsWriter.[RsWriter.{data=out}];rs_put(w[..],"HTTP/1.1 ");rs_int(w[..],status);rs_put(w[..]," ");rs_put(w[..],ifx status==200 then "OK" else "Error");rs_put(w[..],"\r\nConnection: close\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nContent-Type: ");rs_put(w[..],ifx stream then "text/event-stream" else "application/json");rs_put(w[..],"\r\n");if !stream {rs_put(w[..],"Content-Length: ");rs_int(w[..],length);rs_put(w[..],"\r\n");}rs_put(w[..],"\r\n");return w[0].at;
}

rs_settings :: (key:string,port:int)->bool #export_c #effects(all) {
    if key.count<16 || key.count>128 || port<1024 || port>65535 {return false;}
    for c:key {if c<33 || c>126 {return false;}}return true;
}

#test "HTTP helpers: case folding, trimming, secrets and the ingress window" {
    #assert rs_lower('Z')=='z' && rs_lower('@')=='@' && rs_lower('[')=='[';
    #assert !rs_eq("ab","xb") && !rs_eq("ab","ac") && rs_eq("Z-x","z-X");
    #assert rs_trim("  ")=="" && rs_trim("x ")=="x" && rs_trim(" x")=="x" && rs_trim("")=="";
    #assert !rs_secret("a","ab") && !rs_secret("ba","aa") && !rs_secret("ab","aa") && rs_secret("","");
    #assert rs_ingress(5,5) && rs_ingress(1000,4500) && rs_ingress(1000,5999) && !rs_ingress(1000,6000) && !rs_ingress(1000,999);
}
#test "settings take keys of 16 to 128 printable bytes and ports 1024 to 65535" {
    k16:="0123456789abcdef";
    #assert rs_settings(k16,1024) && !rs_settings(k16,1023) && rs_settings(k16,65535) && !rs_settings(k16,65536);
    long:[129]u8;for i:0..<129 {long[i]='k';}
    #assert rs_settings(cast(string)long[0..<128],8080) && !rs_settings(cast(string)long[..],8080);
    #assert rs_settings("!123456789abcdef",8080) && rs_settings("~123456789abcdef",8080);
    del:=[16]u8.[127,'1','2','3','4','5','6','7','8','9','a','b','c','d','e','f'];#assert !rs_settings(cast(string)del[..],8080);
}
#test "response headers are exact" {
    out:[512]u8;
    n:=rs_headers(200,2,false,out[..]);
    #assert cast(string)out[0..<n]=="HTTP/1.1 200 OK\r\nConnection: close\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n";
    n=rs_headers(503,0,true,out[..]);
    #assert cast(string)out[0..<n]=="HTTP/1.1 503 Error\r\nConnection: close\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nContent-Type: text/event-stream\r\n\r\n";
}
#test "the header block's 8192-byte limit" {
    key:="0123456789abcdef";buf:[8300]u8;
    // No terminator: 8191 bytes may still be arriving; 8192 are too many.
    for i:0..<8300 {buf[i]='a';}
    #assert rs_http(cast(string)buf[0..<8191],key).status==0 && rs_http(cast(string)buf[0..<8192],key).status==431;
    // A terminator ending at 8192 is admitted; at 8193 it is not.
    line:="GET /healthz HTTP/1.1\r\nX: ";for i:0..<line.count {buf[i]=line[i];}
    for size:8192..<8194 {
        for i:line.count..<size-4 {buf[i]='a';}buf[size-4]='\r';buf[size-3]='\n';buf[size-2]='\r';buf[size-1]='\n';
        h:=rs_http(cast(string)buf[0..<size],key);
        if size==8192 {#assert h.status==200 && h.route==3 && h.body==8192;} else {#assert h.status==431;}
    }
}
#test "request lines, routes and header names" {
    key:="0123456789abcdef";
    #assert rs_http("\r\n\r\n",key).status==404 && rs_http("GET /nope HTTP/1.1\r\n\r\n",key).status==404;
    #assert rs_http("GET /healthz HTTP/1.0\r\n\r\n",key).route==3;
    r:=rs_http("GET /readyz HTTP/1.1\r\n\r\n",key);#assert r.status==200 && r.route==4;
    #assert rs_http("GET /readyz HTTP/1.0\r\n\r\n",key).route==4;
    r=rs_http("GET /v1/models HTTP/1.0\r\nAuthorization: Bearer 0123456789abcdef\r\n\r\n",key);#assert r.status==200 && r.route==2;
    r=rs_http("GET /v1/models HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\n\r\n",key);#assert r.status==200 && r.route==2;
    #assert rs_http("GET /healthz HTTP/1.1\r\n:x\r\n\r\n",key).status==400 && rs_http("GET /healthz HTTP/1.1\r\nx\r\n\r\n",key).status==400;
    #assert rs_http("GET /healthz HTTP/1.1\r\nx_y: 1\r\n\r\n",key).status==400 && rs_http("GET /healthz HTTP/1.1\r\nx{: 1\r\n\r\n",key).status==400;
    #assert rs_http("GET /healthz HTTP/1.1\r\nx[: 1\r\n\r\n",key).status==400 && rs_http("GET /healthz HTTP/1.1\r\nx@: 1\r\n\r\n",key).status==400;
    #assert rs_http("GET /healthz HTTP/1.1\r\nZz-Aa: 1\r\n\r\n",key).status==200;
    #assert rs_http("GET /healthz HTTP/1.1\r\nExpect: 100-continue\r\n\r\n",key).status==417;
    #assert rs_http("GET /healthz HTTP/1.1\r\nContent-Length: 1\r\n\r\nx",key).status==400;
}
#test "content length: digits only, at most six, at most 65536" {
    key:="0123456789abcdef";
    pre:="POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\n";
    buf:[512]u8;
    lengths:=[11]string.["Content-Length:2","Content-Length: ","Content-Length: 0000002","Content-Length: 065536","Content-Length: 65537","Content-Length: 0","Content-Length: 9","Content-Length: 1a","Content-Length: 1:","Content-Length: /","Content-Length: 12"];
    want:=[11]int.[200,413,413,0,413,200,0,400,400,400,0];
    sizes:=[11]int.[2,0,0,65536,0,0,9,0,0,0,12];
    for c:0..<11 {
        at:=0;for i:0..<pre.count {buf[at]=pre[i];at+=1;}for i:0..<lengths[c].count {buf[at]=lengths[c][i];at+=1;}
        tail:="\r\n\r\n{}";for i:0..<tail.count {buf[at]=tail[i];at+=1;}
        h:=rs_http(cast(string)buf[0..<at],key);
        #assert h.status==want[c];
        if want[c]==200 || want[c]==0 {#assert h.length==sizes[c];}
    }
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{",key).status==0;
}
#test "authorization, content type and profile headers" {
    key:="0123456789abcdef";
    #assert rs_http("GET /v1/models HTTP/1.1\r\nAuthorization: Bearer x\r\n\r\n","x").status==200;
    #assert rs_http("GET /v1/models HTTP/1.1\r\nAuthorization: x\r\n\r\n",key).status==401;
    #assert rs_http("GET /v1/models HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdeX\r\n\r\n",key).status==401;
    #assert rs_http("GET /v1/models HTTP/1.1\r\nAuthorization: Basic 0123456789abcdef\r\n\r\n",key).status==401;
    #assert rs_http("GET /v1/models HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nAuthorization: Bearer 0123456789abcdef\r\n\r\n",key).status==400;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Length: 2\r\nContent-Type: application/json; charset=utf-8\r\n\r\n{}",key).status==200;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Length: 2\r\nContent-Type: text/plain\r\n\r\n{}",key).status==415;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Length: 2\r\nContent-Type: application/json\r\nContent-Type: application/json\r\n\r\n{}",key).status==400;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Length: 2\r\n\r\n{}",key).status==415;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\n\r\n",key).status==411;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}",key).status==401;
    h:=rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\nX-Psionic-Responses-Profile: openresponses-2026-04-24\r\nContent-Length: 2\r\n\r\n{}",key);
    #assert h.status==200 && h.profile==1;
    h=rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\nX-Psionic-Responses-Profile: psionic-gptoss-responses-v1\r\nContent-Length: 2\r\n\r\n{}",key);
    #assert h.status==200 && h.profile==0;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\nX-Psionic-Responses-Profile: other\r\nContent-Length: 2\r\n\r\n{}",key).status==400;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\nX-Psionic-Responses-Profile: psionic-gptoss-responses-v1\r\nX-Psionic-Responses-Profile: psionic-gptoss-responses-v1\r\nContent-Length: 2\r\n\r\n{}",key).status==400;
}
