#load "types.coax";
#authority;
RsHttp :: struct {status:int;route:int;body:int;length:int;profile:int;}
#test "HTTP framing rejects ambiguous lengths, transfer encodings and bad auth" {
    #assert rs_settings("0123456789abcdef",8080) && !rs_settings("short",8080) && !rs_settings("0123456789abcde ",8080) && !rs_settings("0123456789abcdef",80);
    key:="0123456789abcdef";
    h:=rs_http("POST /v1/responses HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}",key);#assert h.status==200 && h.route==1 && h.length==2;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nContent-Length: 2\r\nContent-Length: 2\r\n\r\n{}",key).status==400;
    #assert rs_http("POST /v1/responses HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n",key).status==400;
    #assert rs_http("GET /v1/models HTTP/1.1\r\n\r\n",key).status==401;
    #assert rs_http("GET /healthz HTTP/1.1\r\n\r\n",key).route==3;
    #assert rs_http("GET /healthz HTTP/1.1\r\n",key).status==0;
    #assert rs_lower('A')=='a' && rs_eq("AbC","aBc") && !rs_eq("a","ab");#assert rs_trim(" \tx \t")=="x";
    #assert rs_secret("aa","aa") && !rs_secret("aa","ab");
    out:[512]u8;#assert rs_headers(200,2,false,out[..])>0 && rs_headers(503,0,true,out[..])>0;
    #assert rs_ingress(0,4999) && !rs_ingress(0,5000) && !rs_ingress(1,0);
}
rs_lower :: (c:u8)->u8 {return ifx c>='A' && c<='Z' then c+32 else c;}
rs_eq :: (a:string,b:string)->bool {if a.count!=b.count {return false;}for i:0..<a.count {if rs_lower(a[i])!=rs_lower(b[i]) {return false;}}return true;}
rs_trim :: (s:string)->string {a:=0;b:=s.count;while a<b && (s[a]==32 || s[a]==9) {a+=1;}while b>a && (s[b-1]==32 || s[b-1]==9) {b-=1;}return s[a..<b];}
rs_secret :: (a:string,b:string)->bool {if a.count!=b.count {return false;}v:u8=0;for i:0..<a.count {v=v | (a[i]^b[i]);}return v==0;}
rs_ingress :: (start:int,now:int)->bool #export_c {return now>=start && now-start<5000;}
rs_http :: (text:string,key:string)->RsHttp #export_c {
    end:= -1;for i:0..<text.count {if i+3<text.count && text[i..<i+4]=="\r\n\r\n" {end=i+4;break;}}
    if end<0 {return RsHttp.{status=ifx text.count>=8192 then 431 else 0};}if end>8192 {return RsHttp.{status=431};}
    first:= -1;for i:0..<end-1 {if text[i..<i+2]=="\r\n" {first=i;break;}}if first<0 {return RsHttp.{status=400};}
    line:=text[0..<first];r:=RsHttp.{status=200,body=end};
    if line=="POST /v1/responses HTTP/1.1" || line=="POST /v1/responses HTTP/1.0" {r.route=1;}
    else if line=="GET /v1/models HTTP/1.1" || line=="GET /v1/models HTTP/1.0" {r.route=2;}
    else if line=="GET /healthz HTTP/1.1" || line=="GET /healthz HTTP/1.0" {r.route=3;}
    else if line=="GET /readyz HTTP/1.1" || line=="GET /readyz HTTP/1.0" {r.route=4;}
    else {return RsHttp.{status=404};}
    at:=first+2;length:=false;auth:=false;ctype:=false;profile:=false;
    while at<end-2 {finish:=at;while finish+1<end && text[finish..<finish+2]!="\r\n" {finish+=1;}colon:=at;while colon<finish && text[colon]!=':' {colon+=1;}if colon==at || colon==finish {return RsHttp.{status=400};}name:=text[at..<colon];for c:name {if !((c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='-') {return RsHttp.{status=400};}}value:=rs_trim(text[colon+1..<finish]);
        if rs_eq(name,"content-length") {if length {return RsHttp.{status=400};}length=true;if value.count<1 || value.count>6 {return RsHttp.{status=413};}n:=0;for c:value {if c<'0' || c>'9' {return RsHttp.{status=400};}n=n*10+cast(int)c-48;}if n>65536 {return RsHttp.{status=413};}r.length=n;}
        else if rs_eq(name,"transfer-encoding") {return RsHttp.{status=400};}
        else if rs_eq(name,"expect") {return RsHttp.{status=417};}
        else if rs_eq(name,"authorization") {if auth {return RsHttp.{status=400};}auth=true;if value.count<7 || value[0..<7]!="Bearer " || !rs_secret(value[7..<value.count],key) {return RsHttp.{status=401};}}
        else if rs_eq(name,"content-type") {if ctype {return RsHttp.{status=400};}ctype=true;semi:=value.count;for i:0..<value.count {if value[i]==';' {semi=i;break;}}if !rs_eq(rs_trim(value[0..<semi]),"application/json") {return RsHttp.{status=415};}}
        else if rs_eq(name,"x-psionic-responses-profile") {if profile {return RsHttp.{status=400};}profile=true;if value=="openresponses-2026-04-24" {r.profile=1;}else if value!="psionic-gptoss-responses-v1" {return RsHttp.{status=400};}}
        at=finish+2;
    }
    if r.route<=2 && !auth {return RsHttp.{status=401};}if r.route==1 && !length {return RsHttp.{status=411};}if r.route==1 && !ctype {return RsHttp.{status=415};}if r.route!=1 && r.length>0 {return RsHttp.{status=400};}
    if text.count<end+r.length {r.status=0;}return r;
}
rs_headers :: (status:int,length:int,stream:bool,out:[]u8)->int #export_c {
    w:=[1]RsWriter.[RsWriter.{data=out}];rs_put(w[..],"HTTP/1.1 ");rs_int(w[..],status);rs_put(w[..]," ");rs_put(w[..],ifx status==200 then "OK" else "Error");rs_put(w[..],"\r\nConnection: close\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nContent-Type: ");rs_put(w[..],ifx stream then "text/event-stream" else "application/json");rs_put(w[..],"\r\n");if !stream {rs_put(w[..],"Content-Length: ");rs_int(w[..],length);rs_put(w[..],"\r\n");}rs_put(w[..],"\r\n");return w[0].at;
}

rs_settings :: (key:string,port:int)->bool #export_c {
    if key.count<16 || key.count>128 || port<1024 || port>65535 {return false;}
    for c:key {if c<33 || c>126 {return false;}}return true;
}
