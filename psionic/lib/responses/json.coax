// Bounded JSON tree, preserving raw intervals and unescaping every key/value.
#module "coax.json.tree"; // one owner when the gateway and serving/CLI contexts share the tree
#load "../../../coax/lib/nostr/json.coax";
#authority;
RS_BODY :: 65536;
RsNode :: struct {kind:int;parent:int= -1;next:int;key:string;text:string;begin:int;end:int;}
RsJson :: struct {ok:bool;count:int;bytes:int;}
#test "JSON tree validates escaped duplicate keys and complete input" {
    nodes:[32]RsNode;arena:[256]u8;
    r:=rs_json("{\"a\":[\"x\\ny\",2],\"b\":true}",nodes[..],arena[..]);#assert r.ok && r.count==5 && nodes[1].next==4 && nodes[2].text=="x\ny";
    #assert !rs_json("{\"a\":1,\"\\u0061\":2}",nodes[..],arena[..]).ok;
    #assert !rs_json("{\"x\":\"\\ud800\"}",nodes[..],arena[..]).ok && !rs_json("{} {}",nodes[..],arena[..]).ok;
    #assert !rs_json("[1,]",nodes[..],arena[..]).ok && !rs_json("{}",nodes[0..<0],arena[..]).ok;
}
rs_json :: (text:string,nodes:[]RsNode,arena:[]u8)->RsJson #export_c #effects(all) {
    if text.count>RS_BODY {return RsJson.{};}j:[1]Json;json_start(j[..],text);stack:[16]int;depth:=0;n:=0;at:=0;key:="";
    while true {tok:=json_next(j[..]);if tok==JSON_ERROR {return RsJson.{};}if tok==JSON_END {break;}
        if j[0].key {size:=json_unescape(json_text(j[..]),arena[at..<arena.count]);if size<0 {return RsJson.{};}key=cast(string)arena[at..<at+size];at+=size;continue;}
        if tok==JSON_OBJECT_END || tok==JSON_ARRAY_END {if depth<1 {return RsJson.{};}depth-=1;idx:=stack[depth];nodes[idx].next=n;nodes[idx].end=j[0].to;continue;}
        if n>=nodes.count {return RsJson.{};}parent:= -1;if depth>0 {parent=stack[depth-1];}
        if parent>=0 && nodes[parent].kind==JSON_OBJECT {for i:0..<n {if nodes[i].parent==parent && nodes[i].key==key {return RsJson.{};}}}  // mutant: equivalent (node 0 is the root, whose parent is -1, so it never shares a parent at or above 0)
        node:=RsNode.{kind=tok,parent=parent,next=n+1,key=key,begin=j[0].from,end=j[0].to};key="";
        if tok==JSON_STRING {size:=json_unescape(json_text(j[..]),arena[at..<arena.count]);if size<0 {return RsJson.{};}node.text=cast(string)arena[at..<at+size];at+=size;node.begin-=1;node.end+=1;}
        else if tok==JSON_NUMBER {node.text=json_text(j[..]);}
        nodes[n]=node;
        if tok==JSON_OBJECT || tok==JSON_ARRAY {if depth>=16 {return RsJson.{};}stack[depth]=n;depth+=1;}n+=1;  // mutant: equivalent (json_next refuses a 17th level first, at JSON_DEPTH = 16, so this limit is never reached)
    }return RsJson.{ok=n>0 && depth==0,count=n,bytes=at};  // mutant: equivalent (json_next gives JSON_END only after one complete value, so n is at least 1 and depth is 0 there)
}
rs_get :: (nodes:[]RsNode,parent:int,key:string)->int #effects(all) {if parent<0 || parent>=nodes.count {return -1;}i:=parent+1;while i<nodes[parent].next {if nodes[i].key==key {return i;}i=nodes[i].next;}return -1;}
rs_string :: (nodes:[]RsNode,index:int)->string #effects(all) {if index<0 || index>=nodes.count || nodes[index].kind!=JSON_STRING {return "";}return nodes[index].text;}
rs_kind :: (nodes:[]RsNode,index:int,kind:int)->bool #effects(all) {return index>=0 && index<nodes.count && nodes[index].kind==kind;}
rs_keys :: (nodes:[]RsNode,parent:int,allowed:[]string)->bool #effects(all) {
    if !rs_kind(nodes,parent,JSON_OBJECT) {return false;}i:=parent+1;while i<nodes[parent].next {found:=false;for key:allowed {if nodes[i].key==key {found=true;}}if !found {return false;}i=nodes[i].next;}return true;
}
rs_raw :: (text:string,nodes:[]RsNode,index:int)->string #effects(all) {if index<0 || index>=nodes.count {return "";}return text[nodes[index].begin..<nodes[index].end];}
#test "tree lookup and key admission stay inside the selected object" {
    nodes:[16]RsNode;arena:[64]u8;text:="{\"a\":{\"z\":1},\"b\":\"B\"}";r:=rs_json(text,nodes[..],arena[..]);#assert r.ok;
    a:=rs_get(nodes[..],0,"a");b:=rs_get(nodes[..],0,"b");#assert a==1 && b==3 && rs_string(nodes[..],b)=="B" && rs_get(nodes[..],0,"z")== -1;
    keys:=[2]string.["a","b"];#assert rs_keys(nodes[..],0,keys[..]) && !rs_keys(nodes[..],0,keys[0..<1]);#assert rs_raw(text,nodes[..],a)=="{\"z\":1}";
}
#test "tree bounds, raw intervals and every lookup's edge" {
    nodes:[32]RsNode;arena:[256]u8;
    #assert !rs_json("",nodes[..],arena[..]).ok;
    text:="{\"ab\":\"cd\",\"n\":12,\"t\":true,\"z\":[1]}";r:=rs_json(text,nodes[..],arena[..]);
    #assert r.ok && r.count==6 && r.bytes==7 && nodes[0].parent== -1;
    #assert rs_raw(text,nodes[..],1)=="\"cd\"" && nodes[1].text=="cd" && nodes[2].text=="12" && nodes[3].text=="" && nodes[5].key=="";
    #assert rs_get(nodes[..],0,"z")==4 && rs_get(nodes[..],-1,"ab")== -1 && rs_get(nodes[0..<6],6,"ab")== -1;
    #assert rs_string(nodes[..],1)=="cd" && rs_string(nodes[0..<2],2)=="" && rs_string(nodes[..],-1)=="";
    #assert rs_json("{\"\":1}",nodes[..],arena[..]).ok;
    one:="\"x\"";#assert rs_json(one,nodes[..],arena[..]).ok && rs_string(nodes[..],0)=="x" && rs_raw(one,nodes[..],0)==one;
    #assert !rs_kind(nodes[0..<1],1,JSON_STRING) && rs_raw(one,nodes[..],-1)=="" && rs_raw(one,nodes[0..<1],1)=="";
    obj:="{\"c\":1}";#assert rs_json(obj,nodes[..],arena[..]).ok;
    allowed:=[1]string.["a"];#assert !rs_keys(nodes[..],0,allowed[..]) && !rs_keys(nodes[..],1,allowed[..]);
}
#test "a body of exactly 65536 bytes parses; one more does not" {
    big:[65537]u8;nodes:[2]RsNode;arena:[65536]u8;
    big[0]='"';for i:1..<65535 {big[i]='a';}big[65535]='"';
    r:=rs_json(cast(string)big[0..<65536],nodes[..],arena[..]);#assert r.ok && r.count==1 && r.bytes==65534;
    big[65535]='a';big[65536]='"';#assert !rs_json(cast(string)big[..],nodes[..],arena[..]).ok;
}
