// psionic-gptoss-responses-v1. Normalized DTO projection is in proto/.
#load "json.coax";
#load "../harmony/types.coax";
#authority;
RS_MODEL :: "gpt-oss-20b";
RS_CONTEXT :: 2048;
RS_ITEMS :: 48;
RS_TOOLS :: 8;
RsItem :: struct {kind:int;role:string;phase:string;text:string;id:string;name:string;call_id:string;arguments:string;status:int;}
RsTool :: struct {name:string;description:string;schema:int;}
RsRequest :: struct {status:int=200;code:string;param:string;limit:int=256;effort:int;stream:bool;items:int;tools:int;choice:int;instructions:string;metadata:string="{}";raw_tools:string="[]";nodes:int;}
RsWriter :: struct {data:[]u8;at:int;}
rs_put :: (w:[]RsWriter,s:string) {w[0].at=json_raw(w[0].data,w[0].at,s);}
rs_quote :: (w:[]RsWriter,s:string) {w[0].at=json_write_string(w[0].data,w[0].at,s);}
rs_int :: (w:[]RsWriter,n:int) {if n<0 || n>9007199254740991 {w[0].at= -1;return;}w[0].at=json_write_int(w[0].data,w[0].at,n);}
rs_bad :: (code:string,param:string)->RsRequest {return RsRequest.{status=400,code=code,param=param};}
rs_flag :: (nodes:[]RsNode,index:int,value:bool)->bool {return index<0 || nodes[index].kind==(ifx value then JSON_TRUE else JSON_FALSE) || nodes[index].kind==JSON_NULL;}
rs_name :: (s:string)->bool {if s.count<1 || s.count>48 {return false;}for i:0..<s.count {c:=s[i];if !((c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='_'||(i>0&&c>='0'&&c<='9')) {return false;}}return true;}
rs_zero :: (s:string)->bool {for c:s {if c=='e' || c=='E' {break;}if c>='1' && c<='9' {return false;}}return s.count>0;}
rs_null :: (nodes:[]RsNode,index:int)->bool {return index<0 || nodes[index].kind==JSON_NULL;}
#test "identifiers and numeric zero have no approximate admission" {
    #assert rs_name("lookup_weather") && !rs_name("functions.x") && !rs_name("9x") && !rs_name("");
    #assert rs_zero("0.0e100") && rs_zero("-0") && !rs_zero("1e-9999");
    out:[64]u8;w:=[1]RsWriter.[RsWriter.{data=out[..]}];rs_put(w[..],"[");rs_quote(w[..],"a\n");rs_put(w[..],",");rs_int(w[..],123);rs_put(w[..],"]");#assert cast(string)out[0..<w[0].at]=="[\"a\\n\",123]";
}

#test "shared admission distinguishes null flags and exact decimal one" {
    n:=[2]RsNode.[RsNode.{kind=JSON_FALSE},RsNode.{kind=JSON_NULL}];
    #assert rs_bad("x","y").status==400 && rs_flag(n[..],0,false) && !rs_flag(n[..],0,true) && rs_flag(n[..],1,true);
    #assert rs_null(n[..],-1) && rs_null(n[..],1) && !rs_null(n[..],0);
    #assert rs_one("1") && rs_one("1.0") && rs_one("0.1e1") && rs_one("10e-1") && !rs_one("1.00000001") && !rs_one("1e-999") && !rs_one("0");
}
// Exact decimal equality; input has already passed the JSON number grammar.
rs_one :: (s:string)->bool {
    if s.count<1 || s[0]=='-' {return false;}whole:=0;digits:=0;one:= -1;fraction:=false;at:=0;
    while at<s.count && s[at]!='e' && s[at]!='E' {c:=s[at];if c=='.' {fraction=true;}else {if !fraction {whole+=1;}if c!='0' {if c!='1' || one>=0 {return false;}one=digits;}digits+=1;}at+=1;}
    exponent:=0;sign:=1;if at<s.count {at+=1;if s[at]=='+' || s[at]=='-' {if s[at]=='-' {sign= -1;}at+=1;}while at<s.count {exponent=exponent*10+cast(int)s[at]-48;if exponent>100000 {return false;}at+=1;}}
    return one>=0 && whole-1-one+sign*exponent==0;
}
