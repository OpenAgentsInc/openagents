// The golden bytes were independently frozen before the codec.
#load "experiment-fixtures.coax";
#load "experiment-wire-golden.coax";
#test "RXE1 writer and reader match every independent byte and the complete descriptor" {
  c:=rex_fixture();b:[472]u8;out:[1]RexExperiment;
  r:=rxw_write(c,c.embodiment,b[..]);#assert r.status==RexWireStatus.ok && r.policy==RexStatus.ok && r.bytes==472;
  for i:0..<472 {#assert b[i]==RXW_GOLDEN[i];}for i:0..<32 {#assert r.digest[i]==RXW_GOLDEN_DIGEST[i];}
  r=rxw_read(b[..],c.embodiment,RXW_GOLDEN_DIGEST,out[..]);#assert r.status==RexWireStatus.ok && r.bytes==472 && r.policy==RexStatus.ok;
  rex_same_experiment(c,out[0]);for i:0..<32 {#assert r.digest[i]==RXW_GOLDEN_DIGEST[i];}
}
#test "RXE1 size admission precedes multiplication and all buffer access" {
  #assert RXW_JOINTS==16 && RXW_OBSERVATIONS==32 && REX_JOINTS>=RXW_JOINTS && REX_OBSERVATIONS>=RXW_OBSERVATIONS;
  #assert rxw_size(1,1)==324 && rxw_size(16,32)==2096;
  for n:[4]int.[-1,0,17,9223372036854775807] {#assert rxw_size(n,1)==0;}
  for n:[4]int.[-1,0,33,9223372036854775807] {#assert rxw_size(1,n)==0;}
  c:=rex_fixture();b:[473]u8;for i:0..<473 {b[i]=165;}
  #assert rxw_write(c,c.embodiment,b[0..<471]).status==RexWireStatus.shape;
  #assert rxw_write(c,c.embodiment,b[..]).status==RexWireStatus.shape;
  for v:b {#assert v==165;}
  out:=[2]RexExperiment.[c,c];gold:=RXW_GOLDEN;
  #assert rxw_read(gold[..],c.embodiment,RXW_GOLDEN_DIGEST,out[..]).status==RexWireStatus.shape;
  #assert rxw_read(gold[..],c.embodiment,RXW_GOLDEN_DIGEST,out[0..<0]).status==RexWireStatus.shape;
  rex_same_experiment(out[0],c);rex_same_experiment(out[1],c);
}
#forall "RXE1 every cut and extra tail refuses without publishing any descriptor" length:0..<474 {
  c:=rex_fixture();b:[473]u8;for i:0..<472 {b[i]=RXW_GOLDEN[i];}out:=[1]RexExperiment.[c];out[0].seed=123;old:=out[0];
  r:=rxw_read(b[0..<length],c.embodiment,RXW_GOLDEN_DIGEST,out[..]);
  if length==472 {#assert r.status==RexWireStatus.ok;}else {#assert r.status==RexWireStatus.length && r.bytes==0;rex_same_experiment(out[0],old);for v:r.digest {#assert v==0;}}
}
#forall "RXE1 every artifact byte and expected digest byte is bound" k:0..<472 {
  c:=rex_fixture();b:=RXW_GOLDEN;b[k]^=1;out:=[1]RexExperiment.[c];old:=out[0];
  r:=rxw_read(b[..],c.embodiment,RXW_GOLDEN_DIGEST,out[..]);#assert r.status!=RexWireStatus.ok && r.bytes==0;rex_same_experiment(out[0],old);
  if k<32 {b=RXW_GOLDEN;d:=RXW_GOLDEN_DIGEST;d[k]^=1;r=rxw_read(b[..],c.embodiment,d,out[..]);#assert r.status==RexWireStatus.identity;rex_same_experiment(out[0],old);}
}
#test "RXE1 expected embodiment and rejected metadata cannot leak a staged result" {
  c:=rex_fixture();b:=RXW_GOLDEN;out:=[1]RexExperiment.[c];out[0].seed=123;old:=out[0];expected:=c.embodiment;expected.joints[1].sign=1;
  r:=rxw_read(b[..],expected,RXW_GOLDEN_DIGEST,out[..]);#assert r.status==RexWireStatus.policy && r.policy==RexStatus.identity;rex_same_experiment(out[0],old);
  for i:0..<472 {b[i]=165;}r=rxw_write(c,expected,b[..]);#assert r.status==RexWireStatus.policy && r.policy==RexStatus.identity && r.bytes==0;for v:b {#assert v==165;}
  b=RXW_GOLDEN;#assert cb_store_le32(b[..],16,0);digest:=rxw_digest(b[..]);r=rxw_read(b[..],c.embodiment,digest,out[..]);#assert r.status==RexWireStatus.policy && r.policy==RexStatus.convention;rex_same_experiment(out[0],old);
}
#forall "RXE1 joint and observation words reject nonfinite data before floating conversion" role:0..<6,bad:0..<3 {
  c:=rex_fixture();b:=RXW_GOLDEN;offset:=ifx role<4 then 260+8*role else 360+8*(role-4);
  words:=[3]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001];#assert cb_store_le64(b[..],offset,words[bad]);digest:=rxw_digest(b[..]);out:=[1]RexExperiment.[c];old:=out[0];
  r:=rxw_read(b[..],c.embodiment,digest,out[..]);#assert r.status==RexWireStatus.number && r.bytes==0;rex_same_experiment(out[0],old);
}
#test "RXE1 inactive slots are canonical defaults and signed zero is retained" {
  c:=rex_fixture();c.embodiment.joints[15].home.value=999;c.observations[31].offset=999;
  b:[472]u8;r:=rxw_write(c,c.embodiment,b[..]);#assert r.status==RexWireStatus.ok;for i:0..<472 {#assert b[i]==RXW_GOLDEN[i];}
  out:[1]RexExperiment;r=rxw_read(b[..],c.embodiment,r.digest,out[..]);#assert r.status==RexWireStatus.ok;
  defaults:RexExperiment;#assert out[0].embodiment.joints[15].home.value==defaults.embodiment.joints[15].home.value && out[0].observations[31].offset==defaults.observations[31].offset;
  c=rex_fixture();c.observations[0].offset=f64_from_bits(0x8000000000000000);r=rxw_write(c,c.embodiment,b[..]);#assert r.status==RexWireStatus.ok;
  r=rxw_read(b[..],c.embodiment,r.digest,out[..]);#assert r.status==RexWireStatus.ok && f64_bits(out[0].observations[0].offset)==0x8000000000000000;
}
#test "RXE1 size and magic diagnostics retain precedence at physical buffer boundaries" {
  c:=rex_fixture();b:[2097]u8;out:=[1]RexExperiment.[c];old:=out[0];
  #assert rxw_read(b[0..<239],c.embodiment,RXW_GOLDEN_DIGEST,out[..]).status==RexWireStatus.length;
  #assert rxw_read(b[0..<240],c.embodiment,RXW_GOLDEN_DIGEST,out[..]).status==RexWireStatus.magic;
  #assert rxw_read(b[..],c.embodiment,RXW_GOLDEN_DIGEST,out[..]).status==RexWireStatus.length;
  for k:0..<4 {bad:=RXW_GOLDEN;bad[k]^=1;#assert rxw_read(bad[..],c.embodiment,RXW_GOLDEN_DIGEST,out[..]).status==RexWireStatus.magic;}
  rex_same_experiment(out[0],old);
  c.embodiment.count=0;#assert rxw_write(c,c.embodiment,b[0..<0]).status==RexWireStatus.shape;
}
#test "RXE1 decodes all conventions and nondefault observation scale before policy admission" {
  c:=rex_fixture();out:=[1]RexExperiment.[c];old:=out[0];
  for offset:[4]int.[20,252,256,356] {
    b:=RXW_GOLDEN;#assert cb_store_le32(b[..],offset,0);digest:=rxw_digest(b[..]);r:=rxw_read(b[..],c.embodiment,digest,out[..]);
    #assert r.status==RexWireStatus.policy && r.policy==RexStatus.convention;rex_same_experiment(out[0],old);
  }
  b:=RXW_GOLDEN;#assert cb_store_le64(b[..],368,f64_bits(2.5));digest:=rxw_digest(b[..]);r:=rxw_read(b[..],c.embodiment,digest,out[..]);
  #assert r.status==RexWireStatus.ok && out[0].observations[0].scale==2.5;
}
#test "RXE1 actual minimum and maximum records retain all active fields" {
  c:=rex_fixture();c.embodiment.count=16;c.observation_count=32;
  for i:0..<16 {c.embodiment.joints[i]=c.embodiment.joints[0];c.embodiment.joints[i].joint=i;c.embodiment.joints[i].motor=15-i;}
  for i:0..<32 {c.observations[i].joint=i/2;c.observations[i].signal=1+i%2;c.observations[i].unit=1+i%2;}
  b:[2096]u8;out:[1]RexExperiment;r:=rxw_write(c,c.embodiment,b[..]);#assert r.status==RexWireStatus.ok && r.bytes==2096;
  r=rxw_read(b[..],c.embodiment,r.digest,out[..]);#assert r.status==RexWireStatus.ok;rex_same_experiment(out[0],c);
  c=rex_fixture();c.embodiment.count=1;c.observation_count=1;c.embodiment.joints[0].motor=0;
  for i:1..<16 {c.embodiment.joints[i]=RexJoint.{};}for i:1..<32 {c.observations[i]=RexObservation.{};}
  r=rxw_write(c,c.embodiment,b[0..<324]);#assert r.status==RexWireStatus.ok && r.bytes==324;
  r=rxw_read(b[0..<324],c.embodiment,r.digest,out[..]);#assert r.status==RexWireStatus.ok;rex_same_experiment(out[0],c);
}
