}
gac_stage :: (sequence:int)->GacStage #export_c {s:=gac_schedule(sequence);if s.status!=GvpStatus.ok {return s;}b:=gac_build(sequence);s.nodes=b.count;s.flags=b.flags;return s;}
gac_node :: (sequence:int,index:int)->GvpNode #export_c {if sequence<0 || sequence>=142 || index<0 {return GvpNode.{status=GvpStatus.shape};}b:=gac_build(sequence);if index>=b.count {return GvpNode.{status=GvpStatus.shape};}return b.nodes[index];}
