// Action-head F32 storage with wide normalization statistics. On Metal f64
// uses the existing qualified float-float profile; affine stages remain F32.
#load "groot-device-kernels.coax";
#authority;
#test "action wide statistics normalize nonzero means and keep affine and RMS stages explicit" {
  x:=[6]f32.[1,2,3,4,4,4];scale:=[3]f32.[2,3,4];bias:=[3]f32.[1,2,3];empty:[1]f32;out:[6]f32;flags:=[2]u8.[9,9];
  for i:0..<2 {gaw_norm(i,3,0,0.00001f32,x[..],empty[0..<0],empty[0..<0],out[..],flags[..]);}#assert abs(out[0]+1.2247356f32)<2e-7f32 && out[1]==0 && abs(out[2]-1.2247356f32)<2e-7f32 && out[3]==0 && flags[0]==0 && flags[1]==0;
  for i:0..<2 {flags[i]=9;gaw_norm(i,3,1,0.00001f32,x[..],scale[..],bias[..],out[..],flags[..]);}#assert abs(out[0]+1.4494712f32)<3e-7f32 && out[1]==2 && abs(out[2]-7.8989425f32)<5e-7f32 && out[3]==1 && flags[0]==0 && flags[1]==0;
  for i:0..<2 {flags[i]=9;gaw_norm(i,3,2,0.00001f32,x[..],scale[..],empty[0..<0],out[..],flags[..]);}#assert abs(out[0]-0.9258191f32)<2e-7f32 && abs(out[1]-2.7774572f32)<5e-7f32 && abs(out[2]-5.5549145f32)<1e-6f32 && flags[0]==0 && flags[1]==0;
  out[0]=7;flags[0]=9;gaw_norm(-1,3,0,0.1f32,x[..],empty[0..<0],empty[0..<0],out[..],flags[..]);gaw_norm(0,3,0,0,x[..],empty[0..<0],empty[0..<0],out[..],flags[..]);#assert out[0]==7 && flags[0]==9;
}
gaw_norm :: (item:int,width:int,kind:int,epsilon:f32,x:[]f32,scale:[]f32,bias:[]f32,out:[]f32,flags:[]u8) #export_c {
  if !gdk_norm_bounds(item,width,kind,x.count,scale.count,bias.count,out.count,flags.count) || epsilon<=0 {return;}
  start:=item*width;sum:f64=0;checked:int=0;for j:0..<width {value:=x[start+j];checked=gdk_count(checked,f32_bits(value));sum+=f64(value);}
  mean:=ifx kind==2 then 0.0f64 else sum/f64(width);variance:f64=0;for j:0..<width {value:=f64(x[start+j])-mean;variance+=value*value;}
  denominator:=sqrt(variance/f64(width)+f64(epsilon));checked=gdk_count(checked,f32_bits(f32(denominator)));
  for j:0..<width {value:=f32((f64(x[start+j])-mean)/denominator);if kind!=0 {value*=scale[j];checked=gdk_count(checked,f32_bits(scale[j]));}if kind==1 {value+=bias[j];checked=gdk_count(checked,f32_bits(bias[j]));}out[start+j]=value;checked=gdk_count(checked,f32_bits(value));}
  wanted:=2*width+1;if kind!=0 {wanted+=width;}if kind==1 {wanted+=width;}flags[item]=gdk_receipt(checked,wanted);
}
