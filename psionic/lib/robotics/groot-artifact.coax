// GR00T component plans from bounded original header metadata. Declared file
// lengths/offsets are NOT payload authentication; retain the source manifest.
#load "../model-io/rank5.coax";
#authority;
GcaSpec :: struct {ok:bool;name:string;shape:P5Shape;begin:int;stride:int;inputs:int;outputs:int;}
GcaRange :: struct {status:PwStatus;name:string;begin:int;end:int;bytes:int;inputs:int;outputs:int;category:int;}
GCA_NAMES :: [4]string.["action_head.state_encoder.layer1.W","action_head.state_encoder.layer1.b","action_head.state_encoder.layer2.W","action_head.state_encoder.layer2.b"];
GCA_START :: [4]int.[1407627928,1416278680,1416344216,1517007512];
GCA_INPUT :: [4]int.[132,0,1024,0];
GCA_OUTPUT :: [4]int.[1024,1024,1536,1536];
GCA_SHARD2_BYTES :: 1919980184;

#test "header-only admission includes scalar bounds before parsing or writes" {
  #assert gca_header_admit(2,10,0,1,1,false)==PwStatus.ok;
  #assert gca_header_admit(1048576,68719476736,15,1,1,false)==PwStatus.ok;
  for x:[8]int.[-1,0,1,1048577,9223372036854775807,3,8,9] {if x<2 || x>1048576 {#assert gca_header_admit(x,68719476736,0,1,1,false)==PwStatus.size;}}
  #assert gca_header_admit(3,10,0,1,1,false)==PwStatus.size;
  #assert gca_header_admit(2,9,0,1,1,false)==PwStatus.size && gca_header_admit(2,68719476737,0,1,1,false)==PwStatus.size;
  #assert gca_header_admit(2,10,-1,1,1,false)==PwStatus.manifest && gca_header_admit(2,10,16,1,1,false)==PwStatus.manifest;
  #assert gca_header_admit(2,10,0,0,1,false)==PwStatus.capacity && gca_header_admit(2,10,0,1,0,false)==PwStatus.capacity;
  #assert gca_header_admit(2,10,0,1,1,true)==PwStatus.alias;
}
#test "small declared payloads yield absolute rank-five inventory without fabricated views" {
  h:="{\"a\":{\"dtype\":\"BF16\",\"shape\":[1,1,1,1,2],\"data_offsets\":[0,4]},\"b\":{\"dtype\":\"F32\",\"shape\":[],\"data_offsets\":[4,8]}}";
  out:[3]P5Tensor;draft:[3]P5Tensor;out[2].name="sentinel";
  r:=gca_header(h,h.count+16,1,out[..],draft[..],false);
  #assert r.status==PwStatus.ok && r.written==2 && r.bytes==8 && out[0].shape.rank==5 && out[0].elements==2 && out[1].elements==1 && out[0].begin==h.count+8 && out[1].end==h.count+16 && out[1].shard==1 && out[2].name=="sentinel";
  #assert gca_header(h,h.count+16,1,out[0..<2],draft[..],false).status==PwStatus.ok;
  reverse:="{\"b\":{\"dtype\":\"F32\",\"shape\":[],\"data_offsets\":[4,8]},\"a\":{\"dtype\":\"BF16\",\"shape\":[1,1,1,1,2],\"data_offsets\":[0,4]}}";
  #assert gca_header(reverse,reverse.count+16,1,out[..],draft[..],false).status==PwStatus.ok;
  out[0].name="sentinel";#assert gca_header(h,h.count+16,1,out[0..<1],draft[..],false).status==PwStatus.capacity && out[0].name=="sentinel";
  #assert gca_header(h,h.count+17,1,out[..],draft[..],false).status==PwStatus.coverage && out[0].name=="sentinel";
  #assert gca_header(h,h.count+16,1,out[..],draft[..],true).status==PwStatus.alias && out[0].name=="sentinel";
}
#test "broken header metadata never publishes a partial inventory" {
  out:[3]P5Tensor;draft:[3]P5Tensor;out[0].name="sentinel";
  for h:[7]string.["[]","{}","{]","{\"a\":{\"dtype\":\"BF16\",\"shape\":[1],\"data_offsets\":[0,2]},\"a\":{\"dtype\":\"BF16\",\"shape\":[1],\"data_offsets\":[2,4]}}","{\"a\":{\"dtype\":\"BF16\",\"shape\":[1],\"data_offsets\":[0,2]},\"b\":{\"dtype\":\"BF16\",\"shape\":[1],\"data_offsets\":[0,2]}}","{\"a\":{\"dtype\":\"F16\",\"shape\":[1],\"data_offsets\":[0,2]}}","{\"a\":{\"dtype\":\"BF16\",\"shape\":[1],\"data_offsets\":[1,3]}}"] {
    r:=gca_header(h,h.count+12,0,out[..],draft[..],false);#assert r.status!=PwStatus.ok && r.written==0 && out[0].name=="sentinel";
  }
  #assert gca_header("{}",10,0,out[..],draft[..],false).status==PwStatus.coverage;
  h:="{\"__metadata__\":{\"format\":\"pt\"},\"a\":{\"dtype\":\"BF16\",\"shape\":[1],\"data_offsets\":[0,2]}}";
  #assert gca_header(h,h.count+10,0,out[..],draft[..],false).status==PwStatus.ok;
  h="{\"__metadata__\":{},\"__metadata__\":{}}";
  #assert gca_header(h,h.count+8,0,out[..],draft[..],false).status==PwStatus.duplicate;
  h="{\"__metadata__\":{\"format\":1}}";
  #assert gca_header(h,h.count+8,0,out[..],draft[..],false).status==PwStatus.schema;
}
#test "every state component and category has an independently stated BF16 range" {
  expected:=[4]int.[270336,2048,3145728,3072];inv:[4]P5Tensor;
  shapes:=[4]P5Shape.[P5Shape.{rank=3,dims=[5]int.[32,132,1024,0,0]},P5Shape.{rank=2,dims=[5]int.[32,1024,0,0,0]},P5Shape.{rank=3,dims=[5]int.[32,1024,1536,0,0]},P5Shape.{rank=2,dims=[5]int.[32,1536,0,0,0]}];
  for p:0..<4 {s:=gca_spec(p);#assert s.ok && s.stride==expected[p] && s.begin==GCA_START[p] && s.outputs==GCA_OUTPUT[p] && s.inputs==GCA_INPUT[p] && s.shape.rank==shapes[p].rank;
    for axis:0..<5 {#assert s.shape.dims[axis]==shapes[p].dims[axis];}
    inv[p]=P5Tensor.{name=s.name,shape=s.shape,dtype=PwDtype.bf16,begin=s.begin,end=s.begin+32*s.stride,elements=16*s.stride,shard=1};
  }
  for p:0..<4 {for c:0..<32 {r:=gca_state_range(p,c,inv[..],GCA_SHARD2_BYTES);#assert r.status==PwStatus.ok && r.category==c && r.bytes==expected[p] && r.begin==GCA_START[p]+c*expected[p] && r.end==r.begin+expected[p] && r.name==GCA_NAMES[p];}}
  #assert !gca_spec(-1).ok && !gca_spec(4).ok;
  for bad:[4]int.[-1,32,33,9223372036854775807] {#assert gca_state_range(0,bad,inv[..],GCA_SHARD2_BYTES).status==PwStatus.shape;}
  #assert gca_state_range(-1,2,inv[..],GCA_SHARD2_BYTES).status==PwStatus.shape && gca_state_range(4,2,inv[..],GCA_SHARD2_BYTES).status==PwStatus.shape;
  #assert gca_state_range(0,2,inv[..],GCA_SHARD2_BYTES-1).status==PwStatus.manifest;
}
#test "component range binding rejects missing duplicate wrong-type and changed tensors" {
  s:=gca_spec(0);original:=P5Tensor.{name=s.name,shape=s.shape,dtype=PwDtype.bf16,begin=s.begin,end=s.begin+32*s.stride,elements=16*s.stride,shard=1};
  for field:0..<13 {inv:=[2]P5Tensor.[original,P5Tensor.{name="other"}];
    if field==0 {inv[0].name="other";}if field==1 {inv[1]=original;}if field==2 {inv[0].dtype=PwDtype.f32;}if field==3 {inv[0].shape.rank=2;}if field==4 {inv[0].shape.dims[1]+=1;}if field==5 {inv[0].begin+=2;}if field==6 {inv[0].end+=2;}if field==7 {inv[0].elements+=1;}if field==8 {inv[0].shard=0;}if field==9 {inv[0].shape.dims[4]=1;}
    if field==10 {inv[0].shape.dims[0]+=1;}if field==11 {inv[0].shape.dims[2]+=1;}if field==12 {inv[0].shape.dims[3]+=1;}
    #assert gca_state_range(0,2,inv[..],GCA_SHARD2_BYTES).status!=PwStatus.ok;
  }
  inv:[1]P5Tensor;#assert gca_state_range(0,2,inv[0..<0],GCA_SHARD2_BYTES).status==PwStatus.capacity;
  #assert gca_inventory_valid(1) && gca_inventory_valid(4096) && !gca_inventory_valid(0) && !gca_inventory_valid(-1) && !gca_inventory_valid(4097);
}

gca_header_admit :: (header:int,file_bytes:int,shard:int,out:int,work:int,overlap:bool)->PwStatus #export_c {
  if !pw_file_size(file_bytes) || header<2 || header>PW_HEADER_MAX || header>file_bytes-8 {return PwStatus.size;}
  if shard<0 || shard>=PW_SHARDS_MAX {return PwStatus.manifest;}
  if out<1 || work<1 {return PwStatus.capacity;}if overlap {return PwStatus.alias;}return PwStatus.ok;
}
gca_header :: (header:string,file_bytes:int,shard:int,out:[]P5Tensor,draft:[]P5Tensor,overlap:bool)->PwResult #export_c {
  status:=gca_header_admit(header.count,file_bytes,shard,out.count,draft.count,overlap);if status!=PwStatus.ok {return PwResult.{status=status};}
  j:[1]Json;json_start_bounded(j[..],header,header.count,header.count);
  if json_next(j[..])!=JSON_OBJECT {return PwResult.{status=PwStatus.json};}
  count:=0;covered:=0;meta:=false;t:=json_next(j[..]);data:=8+header.count;payload:=file_bytes-data;
  while t!=JSON_OBJECT_END {
    if t!=JSON_STRING {return PwResult.{status=PwStatus.json};}
    name:=json_text(j[..]);if !pw_name(name) {return PwResult.{status=PwStatus.unsupported};}
    if name=="__metadata__" {if meta {return PwResult.{status=PwStatus.duplicate};}meta=true;result:=pw_metadata(j[..]);if result!=PwStatus.ok {return PwResult.{status=result};}}
    else {
      slot:=pw_slot(count,draft.count);if slot!=PwStatus.ok {return PwResult.{status=slot};}
      parsed:=p5_parse_tensor(j[..],name);if parsed.status!=PwStatus.ok {return PwResult.{status=parsed.status};}
      tensor:=parsed.tensor;size:=p5_shape_size(tensor.shape,tensor.dtype);if size.status!=PwStatus.ok {return PwResult.{status=size.status};}
      if !pw_span(tensor.begin,tensor.end,size.bytes,payload) {return PwResult.{status=PwStatus.offsets};}
      tensor.begin+=data;tensor.end+=data;tensor.elements=size.elements;tensor.shard=shard;
      for i:0..<count {if draft[i].name==name {return PwResult.{status=PwStatus.duplicate};}if tensor.begin<draft[i].end && draft[i].begin<tensor.end {return PwResult.{status=PwStatus.offsets};}}
      draft[count]=tensor;count+=1;covered+=size.bytes;
    }
    t=json_next(j[..]);
  }
  if json_next(j[..])!=JSON_END {return PwResult.{status=PwStatus.json};}
  if count==0 || covered!=payload {return PwResult.{status=PwStatus.coverage};}
  if out.count<count {return PwResult.{status=PwStatus.capacity};}
  for i:0..<count {out[i]=draft[i];}return PwResult.{written=count,bytes=covered};
}
gca_spec :: (part:int)->GcaSpec #export_c {
  if part<0 || part>=4 {return GcaSpec.{};}
  n:=GCA_INPUT[part];m:=GCA_OUTPUT[part];s:=P5Shape.{rank=2,dims=[5]int.[32,m,0,0,0]};stride:=2*m;
  if (part&1)==0 {s=P5Shape.{rank=3,dims=[5]int.[32,n,m,0,0]};stride*=n;}
  return GcaSpec.{ok=true,name=GCA_NAMES[part],shape=s,begin=GCA_START[part],stride=stride,inputs=n,outputs=m};
}
gca_state_range :: (part:int,category:int,inventory:[]P5Tensor,file_bytes:int)->GcaRange #export_c {
  s:=gca_spec(part);if !s.ok || category<0 || category>=32 {return GcaRange.{status=PwStatus.shape};}
  if file_bytes!=GCA_SHARD2_BYTES {return GcaRange.{status=PwStatus.manifest};}
  if !gca_inventory_valid(inventory.count) {return GcaRange.{status=PwStatus.capacity};}
  found:= -1;for i:0..<inventory.count {if inventory[i].name==s.name {if found>=0 {return GcaRange.{status=PwStatus.duplicate};}found=i;}}
  if found<0 {return GcaRange.{status=PwStatus.manifest};}t:=inventory[found];
  if t.dtype!=PwDtype.bf16 || t.shard!=1 || t.shape.rank!=s.shape.rank || t.begin!=s.begin || t.end!=s.begin+32*s.stride || t.elements!=16*s.stride {return GcaRange.{status=PwStatus.manifest};}
  for i:0..<5 {if t.shape.dims[i]!=s.shape.dims[i] {return GcaRange.{status=PwStatus.manifest};}}
  begin:=s.begin+category*s.stride;return GcaRange.{name=s.name,begin=begin,end=begin+s.stride,bytes=s.stride,inputs=s.inputs,outputs=s.outputs,category=category};
}
gca_inventory_valid :: (count:int)->bool #export_c {return count>=1 && count<=PW_TENSORS_MAX;}
