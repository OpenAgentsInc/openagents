#load "lqr-types.coax";
rlq_poison_block :: ()->RlpBlock {return RlpBlock.{actual_loss_sum=91,gradient_sum=92,vjp_proxy=93,rows=94,nodes=95,clipped=96};}
rlq_same_block :: (a:RlpBlock,b:RlpBlock) {#assert a.actual_loss_sum==b.actual_loss_sum && a.gradient_sum==b.gradient_sum && a.vjp_proxy==b.vjp_proxy && a.rows==b.rows && a.nodes==b.nodes && a.clipped==b.clipped;}
rlq_poison_row :: ()->RleRow {r:RleRow;r.x=91;r.action=92;r.next_x=93;r.old_logp=94;r.z=95;r.step.reward.value=96;r.step.current_value.value=97;r.step.next_value.value=98;r.step.terminated=99;r.step.truncated=100;r.target.delta.value=101;r.target.advantage.value=102;r.target.lambda_return.value=103;r.target.bootstrap=104;r.target.trace=105;return r;}
rlq_same_row :: (a:RleRow,b:RleRow) {#assert a.x==b.x && a.action==b.action && a.next_x==b.next_x && a.old_logp==b.old_logp && a.z==b.z && a.step.reward.value==b.step.reward.value && a.step.current_value.value==b.step.current_value.value && a.step.next_value.value==b.step.next_value.value && a.step.terminated==b.step.terminated && a.step.truncated==b.step.truncated && a.target.delta.value==b.target.delta.value && a.target.advantage.value==b.target.advantage.value && a.target.lambda_return.value==b.target.lambda_return.value && a.target.bootstrap==b.target.bootstrap && a.target.trace==b.target.trace;}
