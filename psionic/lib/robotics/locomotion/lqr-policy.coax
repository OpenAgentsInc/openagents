#load "lqr-fixtures.coax";
#load "gaussian-ratio.coax";
#load "../../tape.coax";
#authority;
#test "LQR actor local VJP has the literal loss/sign and a separate proxy" {
 d:[1]RgpDensity;#assert rgp_density_raw(-0.5,-1.3862943611198906,0,d[..])==RgpStatus.ok;r:=[1]RlpRow.[RlpRow.{x=1,action=0,old_logp=d[0].logp.value,advantage=2}];o:[1]RlpBlock;
 #assert rlp_block(0.5,r[..],o[..])==RlpStatus.ok && o[0].actual_loss_sum== -2 && o[0].gradient_sum==16 && o[0].rows==1 && o[0].nodes==20 && o[0].clipped==0 && o[0].vjp_proxy!=o[0].actual_loss_sum;
 r[0].advantage= -2;#assert rlp_block(0.5,r[..],o[..])==RlpStatus.ok && o[0].actual_loss_sum==2 && o[0].gradient_sum== -16;r[0].advantage=0;#assert rlp_block(0.5,r[..],o[..])==RlpStatus.ok && o[0].actual_loss_sum==0 && o[0].gradient_sum==0;
}
#test "LQR actor shared parameter and maximum block count are observed" {
 d:[1]RgpDensity;#assert rgp_density_raw(-0.5,-1.3862943611198906,0,d[..])==RgpStatus.ok;r:[64]RlpRow;for i:0..<64 {r[i]=RlpRow.{x=1,action=0,old_logp=d[0].logp.value,advantage=2};}o:[1]RlpBlock;#assert rlp_block(0.5,r[..],o[..])==RlpStatus.ok && o[0].gradient_sum==1024 && o[0].actual_loss_sum== -128 && o[0].nodes==839 && o[0].rows==64 && o[0].clipped==0;
}
#test "LQR actor positive and negative saturated local weights are zero" {
 d:[1]RgpDensity;#assert rgp_density_raw(-0.5,-1.3862943611198906,0,d[..])==RgpStatus.ok;r:=[1]RlpRow.[RlpRow.{x=1,action=0,old_logp=d[0].logp.value-1,advantage=2}];o:[1]RlpBlock;#assert rlp_block(0.5,r[..],o[..])==RlpStatus.ok && o[0].gradient_sum==0 && o[0].clipped==1 && o[0].actual_loss_sum== -2.4;r[0].old_logp=d[0].logp.value+1;r[0].advantage= -2;#assert rlp_block(0.5,r[..],o[..])==RlpStatus.ok && o[0].gradient_sum==0 && o[0].clipped==1 && o[0].actual_loss_sum==1.6;
}
#test "LQR actor complete input and ratio refusal preserve poison before publication" {
 r:[65]RlpRow;o:=[2]RlpBlock.[rlq_poison_block(),rlq_poison_block()];#assert rlp_block(0,r[0..<0],o[0..<1])==RlpStatus.shape && rlp_block(0,r[..],o[0..<1])==RlpStatus.shape && rlp_block(0.5,r[0..<1],o[..])==RlpStatus.shape;
 for k:[2]f64.[0.249999,1.000001] {#assert rlp_block(k,r[0..<1],o[0..<1])==RlpStatus.range;}for role:0..<4 {x:=r;if role==0 {x[0].x=16.001;}if role==1 {x[0].action=18.251;}if role==2 {x[0].old_logp=1000001;}if role==3 {x[0].advantage=1000000001;}#assert rlp_block(0.5,x[0..<1],o[0..<1])==RlpStatus.range;}
 r[0].old_logp=100;#assert rlp_block(0.5,r[0..<1],o[0..<1])==RlpStatus.ratio;for x:o {rlq_same_block(x,rlq_poison_block());}
 #assert rlp_saved_match(0,0) && !rlp_saved_match(0,1) && !rlp_saved_match(0,0x8000000000000000);
}
#test "LQR actor dense asymmetric rows observe every shared and proxy value" {
 a:[1]RgpDensity;b:[1]RgpDensity;#assert rgp_density_raw(-0.25,-1.3862943611198906,0.25,a[..])==RgpStatus.ok && rgp_density_raw(0.375,-1.3862943611198906,0.125,b[..])==RgpStatus.ok;
 r:=[2]RlpRow.[RlpRow.{x=0.5,action=0.25,old_logp=a[0].logp.value,advantage=2},RlpRow.{x= -0.75,action=0.125,old_logp=b[0].logp.value,advantage=3}];o:[1]RlpBlock;#assert rlp_block(0.5,r[..],o[..])==RlpStatus.ok && o[0].actual_loss_sum== -5 && o[0].gradient_sum==17 && o[0].vjp_proxy==(-2*a[0].logp.value)+(-3*b[0].logp.value) && o[0].nodes==33 && o[0].rows==2 && o[0].clipped==0;
 #assert rlp_gain(0.25) && rlp_gain(1);r[0]=RlpRow.{x=16,action=18.25,old_logp=1000000,advantage=1000000000};#assert rlp_row_domain(r[0]);r[0]=RlpRow.{x= -16,action= -18.25,old_logp= -1000000,advantage= -1000000000};#assert rlp_row_domain(r[0]);
 expect:=[2]f64.[1,2];indices:=[2]int.[0,1];values:=[2]f64.[1,2];#assert rlp_replay_match(expect[..],indices[..],values[..]);values[0]=2;#assert !rlp_replay_match(expect[..],indices[..],values[..]);values[0]=1;values[1]=3;#assert !rlp_replay_match(expect[..],indices[..],values[..]);
}
// Trusted tape construction uses only admitted rows, finite bounded constants and one parameter.
rlp_saved_match :: (expected:u64,observed:u64)->bool {return expected==observed;}
rlp_gain :: (K:f64)->bool {return K>=0.25 && K<=1;}
rlp_row_finite :: (r:RlpRow)->bool {return rlr_finite4(f64_bits(r.x),f64_bits(r.action),f64_bits(r.old_logp),f64_bits(r.advantage));}
rlp_row_domain :: (r:RlpRow)->bool {return abs(r.x)<=16 && abs(r.action)<=18.25 && abs(r.old_logp)<=1000000 && abs(r.advantage)<=1000000000;}
rlp_block :: (K:f64,rows:[]RlpRow,output:[]RlpBlock)->RlpStatus #export_c {
 if rows.count<1 || rows.count>64 || output.count!=1 {return RlpStatus.shape;}
 if !rgp_finite(f64_bits(K)) {return RlpStatus.number;}for r:rows {if !rlp_row_finite(r) {return RlpStatus.number;}}
 if !rlp_gain(K) {return RlpStatus.range;}for r:rows {if !rlp_row_domain(r) {return RlpStatus.range;}}
 nodes:[840]TpNode;values:[840]f64;logps:[64]f64;indices:[64]int;params:=[1]f64.[K];grads:[1]f64;fresh:RlpBlock;
 // Node0 is the zero-initialized param/slot0 node.
 nodes[1]=tp_c(-1.3862943611198906);nodes[2]=tp_u(TpOp.neg,1);nodes[3]=tp_u(TpOp.exp,2);nodes[4]=tp_c(-0.5);nodes[5]=tp_c(0.9189385332046728);nodes[6]=tp_c(0);n:=7;total:=6;
 for r,i:rows {
  density:[1]RgpDensity;#assert rgp_density_raw(-(K*r.x),-1.3862943611198906,r.action,density[..])==RgpStatus.ok;
  objective:[1]RlrOutput;if rlr_surrogate_raw(density[0].logp.value,r.old_logp,r.advantage,0.2,objective[..])!=RlrStatus.ok {return RlpStatus.ratio;}
  logps[i]=density[0].logp.value;fresh.actual_loss_sum+=objective[0].objective.loss.value;fresh.clipped+=objective[0].objective.clipped_active;
  base:=n;nodes[n]=tp_c(r.x);n+=1;nodes[n]=tp_b(TpOp.mul,0,base);n+=1;nodes[n]=tp_u(TpOp.neg,n-1);n+=1;mean:=n-1;
  nodes[n]=tp_c(r.action);n+=1;nodes[n]=tp_b(TpOp.sub,n-1,mean);n+=1;nodes[n]=tp_b(TpOp.mul,n-1,3);n+=1;nodes[n]=tp_u(TpOp.square,n-1);n+=1;nodes[n]=tp_b(TpOp.mul,4,n-1);n+=1;nodes[n]=tp_b(TpOp.sub,n-1,1);n+=1;nodes[n]=tp_b(TpOp.sub,n-1,5);indices[i]=n;n+=1;
  nodes[n]=tp_c(objective[0].objective.dloss_dlogp.value);n+=1;nodes[n]=tp_b(TpOp.mul,n-1,n-2);n+=1;nodes[n]=tp_b(TpOp.add,total,n-1);total=n;n+=1;
 }
 #assert tp_forward(nodes[0..<n],params[..],values[0..<n],false)==TpStatus.ok;
 #assert rlp_replay_match(logps[0..<rows.count],indices[0..<rows.count],values[0..<n]);
 #assert tp_backward(nodes[0..<n],values[0..<n],grads[..],false)==TpStatus.ok;
 fresh.gradient_sum=grads[0];fresh.vjp_proxy=values[n-1];fresh.rows=rows.count;fresh.nodes=n;output[0]=fresh;return RlpStatus.ok;
}

rlp_replay_match :: (expected:[]f64,indices:[]int,values:[]f64)->bool {for x,i:expected {if !rlp_saved_match(f64_bits(x),f64_bits(values[indices[i]])) {return false;}}return true;}
