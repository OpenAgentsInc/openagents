// Fixed numerical source: gear1, no activation, gains1/1000, zero joint springs.
// The private raw clamp trusts finite admitted values and ordered finite bounds.
#load "panda-actuation-types.coax";
#authority;
#forall "actuation clamp exact endpoints and outside values preserve value and strict clip flag" side:0..<5 {
 values:=[5]f64.[-3,-2,0,4,5];r:=pa_clip(values[side],-2,4);#assert r.value==(ifx side==0 then -2.0 else ifx side==4 then 4.0 else values[side]);#assert r.clipped==(side==0 || side==4);
}
#forall "actuation each exact source torque limit and viscous damping coefficient is fixed" axis:0..<7 {
 #assert pa_torque_limit(axis)==(ifx axis<5 then 80.0 else 12.0);
 #assert pa_hinge_damping(axis).value==(ifx axis<5 then 0.1 else 0.01);
}
#test "actuation finger targets become newtons before source force clipping and passive velocity stays separate" {
 q:[2]pfku.Quantity(pfku.Metre,f64);target:[2]pfku.Quantity(pfku.Metre,f64);q[0].value=0.03;q[1].value=-0.03;target[0].value=0.04;target[1].value=-0.04;
 #assert abs(pa_finger(q[0],target[0]).value-10)<1e-13 && abs(pa_finger(q[1],target[1]).value+10)<1e-13;
 q[0].value=0;target[0].value=0.02;#assert pa_finger(q[0],target[0]).value==20;
 q[0].value=0.04;#assert pa_finger(q[0],target[0]).value== -20;
 v:[7]pfku.Quantity(PidAngularRate,f64);s:[2]pfku.Quantity(PidLinearRate,f64);for i:0..<7 {v[i].value=f64(i+1);}s[0].value=0.03;s[1].value=-0.02;p:=pa_damping(v,s);
 for i:0..<7 {#assert p.hinge[i].value== -(ifx i<5 then 0.1 else 0.01)*f64(i+1);}#assert p.slide[0].value== -3 && p.slide[1].value==2;
}

pa_clip :: (value:f64,lo:f64,hi:f64)->PaClip {
 if value<lo {return PaClip.{value=lo,clipped=true};}if value>hi {return PaClip.{value=hi,clipped=true};}return PaClip.{value=value};
}
pa_torque_limit :: (axis:int)->f64 {return ifx axis<5 then 80.0 else 12.0;}
pa_hinge_damping :: (axis:int)->pfku.Quantity(PaHingeDamping,f64) {r:pfku.Quantity(PaHingeDamping,f64);r.value=ifx axis<5 then 0.1 else 0.01;return r;}
pa_finger :: (position:pfku.Quantity(pfku.Metre,f64),target:pfku.Quantity(pfku.Metre,f64))->pfku.Quantity(PmSlideGravity,f64) {
 gain:pfku.Quantity(PaFingerGain,f64);gain.value=1000;negative:pfku.Quantity(PaFingerGain,f64);negative.value= -1000;zero:pfku.Quantity(PmSlideGravity,f64);
 // Source order is gain*control, then the affine bias. Do not factor to k*(u-q).
 bias:=zero+convert_unit(PmSlideGravity,negative*position);return convert_unit(PmSlideGravity,gain*target)+bias;
}
pa_damping :: (hinge:[7]pfku.Quantity(PidAngularRate,f64),slide:[2]pfku.Quantity(PidLinearRate,f64))->PidOutput {
 out:PidOutput;zero_h:pfku.Quantity(PmHingeGravity,f64);zero_s:pfku.Quantity(PmSlideGravity,f64);d:pfku.Quantity(PaSlideDamping,f64);d.value=100;
 for i:0..<7 {out.hinge[i]=zero_h-convert_unit(PmHingeGravity,pa_hinge_damping(i)*hinge[i]);}for i:0..<2 {out.slide[i]=zero_s-convert_unit(PmSlideGravity,d*slide[i]);}return out;
}
