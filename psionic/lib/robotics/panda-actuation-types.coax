// Fixed source stateless direct-joint actuators. Units survive the force map.
#load "panda-inverse-dynamics.coax";
PaFingerGain :: struct @unit(mass=1,length=0,time=-2,angle=0,numerator=1,denominator=1) {}
PaHingeDamping :: struct @unit(mass=1,length=2,time=-1,angle=-2,numerator=1,denominator=1) {}
PaSlideDamping :: struct @unit(mass=1,length=0,time=-1,angle=0,numerator=1,denominator=1) {}
PaClip :: struct {value:f64;clipped:bool;}
PaOutput :: struct {actuator:PidOutput;joint_passive:PidOutput;control_clipped:int;force_clipped:int;}
