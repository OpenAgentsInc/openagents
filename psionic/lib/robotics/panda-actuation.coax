// Actuator + JOINT passive only. Fluid is not silently treated as damping;
// dof_frictionloss is a separate constraint. No integration or command effects.
#load "panda-actuation-math.coax";
#load "panda-actuation-fixtures.coax";
#authority;
#forall "actuation all typed span shapes precede numerical admission and preserve complete output" field:0..<8 {
 q:[8]pfku.Quantity(pfku.Radian,f64);s:[3]pfku.Quantity(pfku.Metre,f64);v:[8]pfku.Quantity(PidAngularRate,f64);sv:[3]pfku.Quantity(PidLinearRate,f64);u:[8]pfku.Quantity(PmHingeGravity,f64);t:[3]pfku.Quantity(pfku.Metre,f64);out:[2]PaOutput;out[0].control_clipped=123;out[1].force_clipped=456;old:=out[0];tail:=out[1];
 qs:=q[0..<7];ss:=s[0..<2];vs:=v[0..<7];ws:=sv[0..<2];us:=u[0..<7];ts:=t[0..<2];os:=out[0..<1];
 if field==0 {qs=q[0..<6];}if field==1 {ss=s[0..<1];}if field==2 {vs=v[0..<6];}if field==3 {ws=sv[0..<1];}if field==4 {us=u[0..<6];}if field==5 {ts=t[0..<1];}if field==6 {os=out[0..<0];}if field==7 {os=out[..];}
 q[0].value=101;#assert pa_forward(qs,ss,vs,ws,us,ts,os)==PfkStatus.shape;pa_same(out[0],old);pa_same(out[1],tail);
}
#forall "actuation every coordinate rate and broad control box admits endpoints and refuses the next word" role:0..<3,axis:0..<9,negative:bool {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);u:[7]pfku.Quantity(PmHingeGravity,f64);t:[2]pfku.Quantity(pfku.Metre,f64);out:[1]PaOutput;
 bound:=ifx role==0 then (ifx axis<7 then 100.0 else 1.0) else ifx role==1 then (ifx axis<7 then 20.0 else 2.0) else (ifx axis<7 then 10000.0 else 1.0);value:=ifx negative then -bound else bound;
 if role==0 {if axis<7 {q[axis].value=value;}else {s[axis-7].value=value;}}if role==1 {if axis<7 {v[axis].value=value;}else {sv[axis-7].value=value;}}if role==2 {if axis<7 {u[axis].value=value;}else {t[axis-7].value=value;}}
 #assert pa_forward(q[..],s[..],v[..],sv[..],u[..],t[..],out[..])==PfkStatus.ok;old:=out[0];bits:=f64_bits(bound)+1;if negative {bits=bits|0x8000000000000000;}value=f64_from_bits(bits);
 if role==0 {if axis<7 {q[axis].value=value;}else {s[axis-7].value=value;}}if role==1 {if axis<7 {v[axis].value=value;}else {sv[axis-7].value=value;}}if role==2 {if axis<7 {u[axis].value=value;}else {t[axis-7].value=value;}}
 #assert pa_forward(q[..],s[..],v[..],sv[..],u[..],t[..],out[..])==PfkStatus.range;pa_same(out[0],old);
}
#test "actuation source clipping counts and typed raw identity retain dense input roles and spare output" {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);u:[7]pfku.Quantity(PmHingeGravity,f64);t:[2]pfku.Quantity(pfku.Metre,f64);
 s[0].value=0.03;s[1].value=-0.03;t[0].value=0.05;t[1].value=-0.05;for i:0..<7 {u[i].value=100;v[i].value=f64(i+1);}sv[0].value=0.03;sv[1].value=-0.02;
 out:[2]PaOutput;out[1].force_clipped=99;old:=out[1];#assert pa_forward(q[..],s[..],v[..],sv[..],u[..],t[..],out[0..<1])==PfkStatus.ok;#assert out[0].control_clipped==9 && out[0].force_clipped==0;
 for i:0..<7 {#assert out[0].actuator.hinge[i].value==(ifx i<5 then 80.0 else 12.0);#assert out[0].joint_passive.hinge[i].value== -(ifx i<5 then 0.1 else 0.01)*f64(i+1);}#assert abs(out[0].actuator.slide[0].value-10)<1e-13 && abs(out[0].actuator.slide[1].value+10)<1e-13;#assert out[0].joint_passive.slide[0].value== -3 && out[0].joint_passive.slide[1].value==2;pa_same(out[1],old);
 rq:[9]f64;rv:[9]f64;ru:[9]f64;for i:0..<7 {rq[i]=q[i].value;rv[i]=v[i].value;ru[i]=u[i].value;}for i:0..<2 {rq[7+i]=s[i].value;rv[7+i]=sv[i].value;ru[7+i]=t[i].value;}other:[1]PaOutput;#assert pa_forward_raw(rq[..],rv[..],ru[..],other[..])==PfkStatus.ok;pa_same(other[0],out[0]);
 s[0].value=0;s[1].value=0;#assert pa_forward(q[..],s[..],v[..],sv[..],u[..],t[..],out[0..<1])==PfkStatus.ok;#assert out[0].force_clipped==2 && out[0].actuator.slide[0].value==20 && out[0].actuator.slide[1].value== -20;
}
#forall "actuation packed shape refusal is atomic before invalid values" field:0..<5 {
 q:[10]f64;v:[10]f64;u:[10]f64;out:[2]PaOutput;old:=out[0];qs:=q[0..<9];vs:=v[0..<9];us:=u[0..<9];os:=out[0..<1];if field==0 {qs=q[0..<8];}if field==1 {vs=v[0..<8];}if field==2 {us=u[0..<8];}if field==3 {os=out[0..<0];}if field==4 {os=out[..];}q[0]=101;
 #assert pa_forward_raw(qs,vs,us,os)==PfkStatus.shape;pa_same(out[0],old);
}

pa_forward :: (angles:[]pfku.Quantity(pfku.Radian,f64),slides:[]pfku.Quantity(pfku.Metre,f64),hinge_rates:[]pfku.Quantity(PidAngularRate,f64),slide_rates:[]pfku.Quantity(PidLinearRate,f64),arm_control:[]pfku.Quantity(PmHingeGravity,f64),finger_target:[]pfku.Quantity(pfku.Metre,f64),output:[]PaOutput)->PfkStatus #export_c {
 if angles.count!=7 || slides.count!=2 || hinge_rates.count!=7 || slide_rates.count!=2 || arm_control.count!=7 || finger_target.count!=2 || output.count!=1 {return PfkStatus.shape;}
 q:[9]u64;v:[9]u64;u:[9]u64;for i:0..<7 {q[i]=f64_bits(angles[i].value);v[i]=f64_bits(hinge_rates[i].value);u[i]=f64_bits(arm_control[i].value);}for i:0..<2 {q[7+i]=f64_bits(slides[i].value);v[7+i]=f64_bits(slide_rates[i].value);u[7+i]=f64_bits(finger_target[i].value);}
 status:=pid_admit(q,100,1);if status!=PfkStatus.ok {return status;}status=pid_admit(v,20,2);if status!=PfkStatus.ok {return status;}status=pid_admit(u,10000,1);if status!=PfkStatus.ok {return status;}
 fresh:PaOutput;rates:[7]pfku.Quantity(PidAngularRate,f64);srates:[2]pfku.Quantity(PidLinearRate,f64);
 for i:0..<7 {r:=pa_clip(arm_control[i].value,-pa_torque_limit(i),pa_torque_limit(i));fresh.actuator.hinge[i].value=r.value;if r.clipped {fresh.control_clipped+=1;}rates[i]=hinge_rates[i];}
 for i:0..<2 {lo:=ifx i==0 then 0.0 else -0.04;hi:=ifx i==0 then 0.04 else 0.0;r:=pa_clip(finger_target[i].value,lo,hi);target:pfku.Quantity(pfku.Metre,f64);target.value=r.value;if r.clipped {fresh.control_clipped+=1;}
  force:=pa_finger(slides[i],target);clamped:=pa_clip(force.value,-20,20);fresh.actuator.slide[i].value=clamped.value;if clamped.clipped {fresh.force_clipped+=1;}srates[i]=slide_rates[i];
 }fresh.joint_passive=pa_damping(rates,srates);output[0]=fresh;return PfkStatus.ok;
}
pa_forward_raw :: (coordinates:[]f64,rates:[]f64,controls:[]f64,output:[]PaOutput)->PfkStatus #export_c {
 if coordinates.count!=9 || rates.count!=9 || controls.count!=9 {return PfkStatus.shape;}
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);u:[7]pfku.Quantity(PmHingeGravity,f64);t:[2]pfku.Quantity(pfku.Metre,f64);
 for i:0..<7 {q[i].value=coordinates[i];v[i].value=rates[i];u[i].value=controls[i];}for i:0..<2 {s[i].value=coordinates[7+i];sv[i].value=rates[7+i];t[i].value=controls[7+i];}return pa_forward(q[..],s[..],v[..],sv[..],u[..],t[..],output);
}

#forall "actuation packed coordinate rate and control refusals are independently observable" role:0..<3,axis:0..<9,negative:bool {
 q:[9]f64;v:[9]f64;u:[9]f64;out:[1]PaOutput;old:=out[0];bound:=ifx role==0 then (ifx axis<7 then 100.0 else 1.0) else ifx role==1 then (ifx axis<7 then 20.0 else 2.0) else (ifx axis<7 then 10000.0 else 1.0);bits:=f64_bits(bound)+1;if negative {bits=bits|0x8000000000000000;}value:=f64_from_bits(bits);
 if role==0 {q[axis]=value;}if role==1 {v[axis]=value;}if role==2 {u[axis]=value;}#assert pa_forward_raw(q[..],v[..],u[..],out[..])==PfkStatus.range;pa_same(out[0],old);
}
