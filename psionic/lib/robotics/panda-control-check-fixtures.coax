// Owned analytic telemetry; original SDK captures are separate native tooling.
#load "panda-control-types.coax";
pc_fixture :: ()->PcSample {
  s:PcSample;s.rotation=[9]f64.[1,0,0,0,1,0,0,0,1];
  s.q=[7]f64.[0,0.19634954084936207,0,-2.617993877991494,0,2.941592653589793,0.7853981633974483];
  for i:0..<7 {s.mass[i*7+i]=1;s.lower[i]=ifx i<5 then -80.0 else -12.0;s.upper[i]= -s.lower[i];}
  for i:0..<3 {s.jp[i*7+i]=1;s.jr[i*7+3+i]=1;}return s;
}
pc_unchanged :: (a:PcState,b:PcState) {
 #assert a.ready==b.ready;for i:0..<3 {#assert f64_bits(a.goal_position[i])==f64_bits(b.goal_position[i]);}for i:0..<9 {#assert f64_bits(a.goal_rotation[i])==f64_bits(b.goal_rotation[i]);}for i:0..<7 {#assert f64_bits(a.home[i])==f64_bits(b.home[i]);}for i:0..<2 {#assert f64_bits(a.grip[i])==f64_bits(b.grip[i]);}
}
