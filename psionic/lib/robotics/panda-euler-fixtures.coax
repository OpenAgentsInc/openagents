#load "panda-euler-types.coax";
peu_poison :: ()->PeuOutput {
 out:PeuOutput;for i:0..<7 {out.angles[i].value=1000+f64(i);out.hinge_rates[i].value=2000+f64(i);out.effective.hinge[i].value=3000+f64(i);}for i:0..<2 {out.slides[i].value=4000+f64(i);out.slide_rates[i].value=5000+f64(i);out.effective.slide[i].value=6000+f64(i);}out.control_clipped=91;out.force_clipped=92;return out;
}
peu_same :: (a:PeuOutput,b:PeuOutput) {
 for i:0..<7 {#assert f64_bits(a.angles[i].value)==f64_bits(b.angles[i].value);#assert f64_bits(a.hinge_rates[i].value)==f64_bits(b.hinge_rates[i].value);#assert f64_bits(a.effective.hinge[i].value)==f64_bits(b.effective.hinge[i].value);}for i:0..<2 {#assert f64_bits(a.slides[i].value)==f64_bits(b.slides[i].value);#assert f64_bits(a.slide_rates[i].value)==f64_bits(b.slide_rates[i].value);#assert f64_bits(a.effective.slide[i].value)==f64_bits(b.effective.slide[i].value);}#assert a.control_clipped==b.control_clipped && a.force_clipped==b.force_clipped;
}

// Independent Gaussian targets from original retained M/bias+Pa operands.
// These are algebraic step targets, never observed SDK step endpoints.
peu_cached_golden :: (out:PeuOutput,variant:int) {
 qwant:=ifx variant==0 then [9]f64.[6.279495212448833e-11,4.491062109047213e-06,2.1097283584639582e-10,8.328960844077448e-06,4.629438603596381e-10,-8.345579597987203e-06,1.6115300714179826e-10,6.11280329963668e-05,-6.100937158378595e-05] else ifx variant==1 then [9]f64.[6.279495212448833e-11,4.491062109047213e-06,2.1097283584638194e-10,8.328960844077448e-06,4.6294386035961035e-10,-8.345579597987203e-06,1.6115300714178438e-10,6.112803299636679e-05,-6.100937158378594e-05] else [9]f64.[6.279495212448833e-11,4.491062109047213e-06,2.1097283584639582e-10,8.328960844077448e-06,4.629438603596381e-10,-8.345579597987203e-06,1.6115300714179826e-10,6.11280329963668e-05,-6.100937158378595e-05];
 vwant:=ifx variant==0 then [9]f64.[3.139747606224416e-08,0.002245531054523607,1.0548641792319791e-07,0.004164480422038723,2.3147193017981904e-07,-0.004172789798993602,8.057650357089913e-08,0.030564016498183404,-0.030504685791892975] else ifx variant==1 then [9]f64.[3.139747606224416e-08,0.002245531054523607,1.0548641792319096e-07,0.004164480422038723,2.3147193017980517e-07,-0.004172789798993602,8.057650357089219e-08,0.030564016498183397,-0.03050468579189297] else [9]f64.[3.139747606224416e-08,0.002245531054523607,1.0548641792319791e-07,0.004164480422038723,2.3147193017981904e-07,-0.004172789798993602,8.057650357089913e-08,0.030564016498183404,-0.030504685791892975];
 awant:=ifx variant==0 then [9]f64.[1.569873803112208e-05,1.1227655272618033,5.274320896159895e-05,2.0822402110193616,0.00011573596508990952,-2.086394899496801,4.0288251785449564e-05,15.282008249091701,-15.252342895946487] else ifx variant==1 then [9]f64.[1.569873803112208e-05,1.1227655272618033,5.2743208961595484e-05,2.0822402110193616,0.00011573596508990258,-2.086394899496801,4.0288251785446094e-05,15.282008249091698,-15.252342895946486] else [9]f64.[1.569873803112208e-05,1.1227655272618033,5.274320896159895e-05,2.0822402110193616,0.00011573596508990952,-2.086394899496801,4.0288251785449564e-05,15.282008249091701,-15.252342895946487];
 for i:0..<7 {#assert abs(out.angles[i].value-qwant[i])<2e-12;#assert abs(out.hinge_rates[i].value-vwant[i])<2e-10;#assert abs(out.effective.hinge[i].value-awant[i])<1e-8;}for i:0..<2 {#assert abs(out.slides[i].value-qwant[7+i])<2e-12;#assert abs(out.slide_rates[i].value-vwant[7+i])<2e-10;#assert abs(out.effective.slide[i].value-awant[7+i])<1e-8;}
}
