// Checks precede implementation. Helpers trust the owned profile/admitted input;
// source-visible writable PODs do not establish model or admission provenance.
#load "panda-euler-fixtures.coax";
#authority;
#test "Euler typed h damping adds only nine metric diagonal coefficients" {
 m:PmOutput;for i:0..<49 {m.hinge_hinge[i].value=f64(i)+0.125;}for i:0..<14 {m.hinge_slide[i].value=f64(i)+10.25;m.slide_hinge[i].value=f64(i)+20.5;}for i:0..<4 {m.slide_slide[i].value=f64(i)+30.75;}for i:0..<7 {m.hinge_gravity[i].value=f64(i)+40.125;}for i:0..<2 {m.slide_gravity[i].value=f64(i)+50.25;}
 a:=peu_metric(m);#assert peu_h().value==0.002;
 for i:0..<7 {for j:0..<7 {want:=m.hinge_hinge[i*7+j].value;if i==j {want+=ifx i<5 then 0.0002 else 0.00002;}#assert a.hinge_hinge[i*7+j].value==want;}#assert a.hinge_gravity[i].value==m.hinge_gravity[i].value;}
 for i:0..<14 {#assert a.hinge_slide[i].value==m.hinge_slide[i].value && a.slide_hinge[i].value==m.slide_hinge[i].value;}for i:0..<2 {for j:0..<2 {#assert a.slide_slide[i*2+j].value==m.slide_slide[i*2+j].value+(ifx i==j then 0.2 else 0.0);}#assert a.slide_gravity[i].value==m.slide_gravity[i].value;}
}
#test "Euler typed velocity first then position matches literal dense per coordinate arithmetic" {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);a:PmsOutput;
 for i:0..<7 {q[i].value=f64(i)/4-1;v[i].value=f64(i)/8-0.5;a.hinge[i].value=f64(i)-3;}for i:0..<2 {s[i].value=f64(i)/8-0.0625;sv[i].value=f64(i)/4-0.125;a.slide[i].value=f64(i)*2-1;}
 r:=peu_advance(q,s,v,sv,a);#assert r.status==PmsStatus.ok;
 for i:0..<7 {nv:=f64(i)/8-0.5+0.002*(f64(i)-3);#assert r.output.hinge_rates[i].value==nv;#assert r.output.angles[i].value==f64(i)/4-1+0.002*nv;#assert r.output.effective.hinge[i].value==f64(i)-3;}for i:0..<2 {nv:=f64(i)/4-0.125+0.002*(f64(i)*2-1);#assert r.output.slide_rates[i].value==nv;#assert r.output.slides[i].value==f64(i)/8-0.0625+0.002*nv;#assert r.output.effective.slide[i].value==f64(i)*2-1;}
 #assert r.output.control_clipped==0 && r.output.force_clipped==0;
}
#forall "Euler projected numerical state bounds are inclusive and next outward coordinate refuses" role:0..<2,lane:0..<9,negative:bool {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);a:PmsOutput;
 limit:=ifx role==0 then (ifx lane<7 then 100.0 else 1.0) else (ifx lane<7 then 20.0 else 2.0);value:=ifx negative then -limit else limit;
 if role==0 {if lane<7 {q[lane].value=value;}else {s[lane-7].value=value;}}else {if lane<7 {v[lane].value=value;}else {sv[lane-7].value=value;}}
 #assert peu_advance(q,s,v,sv,a).status==PmsStatus.ok;
 if role==0 {if lane<7 {v[lane].value=ifx negative then -1.0 else 1.0;}else {sv[lane-7].value=ifx negative then -1.0 else 1.0;}}else {if lane<7 {a.hinge[lane].value=ifx negative then -1.0 else 1.0;}else {a.slide[lane-7].value=ifx negative then -1.0 else 1.0;}}
 r:=peu_advance(q,s,v,sv,a);#assert r.status==PmsStatus.range;peu_same(r.output,PeuOutput.{});
}
#test "Euler staged completion propagates failed solves and late state refusal before publication" {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);out:=[2]PeuOutput.[peu_poison(),peu_poison()];old:=out[0];solved:PmsRaw;solved.status=PmsStatus.factor;
 #assert peu_complete(q,s,v,sv,solved,12,34,out[0..<0])==PmsStatus.shape;#assert peu_complete(q,s,v,sv,solved,12,34,out[..])==PmsStatus.shape;
 #assert peu_complete(q,s,v,sv,solved,12,34,out[0..<1])==PmsStatus.factor;peu_same(out[0],old);peu_same(out[1],old);
 solved.status=PmsStatus.ok;q[0].value=100;v[0].value=1;#assert peu_complete(q,s,v,sv,solved,12,34,out[0..<1])==PmsStatus.range;peu_same(out[0],old);q[0].value=0;
 for i:0..<9 {solved.acceleration[i]=f64(i)-4;}
 #assert peu_complete(q,s,v,sv,solved,12,34,out[0..<1])==PmsStatus.ok;#assert out[0].control_clipped==12 && out[0].force_clipped==34;for i:0..<7 {#assert out[0].effective.hinge[i].value==f64(i)-4;}for i:0..<2 {#assert out[0].effective.slide[i].value==f64(i+7)-4;}peu_same(out[1],old);
}

peu_h :: ()->pfku.Quantity(pfku.Second,f64) {h:pfku.Quantity(pfku.Second,f64);h.value=0.002;return h;}
peu_metric :: (metric:PmOutput)->PmOutput {
 out:=metric;h:=peu_h();for i:0..<7 {out.hinge_hinge[i*7+i]=out.hinge_hinge[i*7+i]+convert_unit(PmHingeInertia,h*pa_hinge_damping(i));}
 damping:pfku.Quantity(PaSlideDamping,f64);damping.value=100;for i:0..<2 {out.slide_slide[i*2+i]=out.slide_slide[i*2+i]+convert_unit(pfku.Kilogram,h*damping);}return out;
}
peu_advance :: (q:[7]pfku.Quantity(pfku.Radian,f64),s:[2]pfku.Quantity(pfku.Metre,f64),v:[7]pfku.Quantity(PidAngularRate,f64),sv:[2]pfku.Quantity(PidLinearRate,f64),effective:PmsOutput)->PeuResult {
 h:=peu_h();fresh:PeuOutput;fresh.effective=effective;qb:[9]u64;vb:[9]u64;
 for i:0..<7 {fresh.hinge_rates[i]=v[i]+convert_unit(PidAngularRate,h*effective.hinge[i]);fresh.angles[i]=q[i]+convert_unit(pfku.Radian,h*fresh.hinge_rates[i]);qb[i]=f64_bits(fresh.angles[i].value);vb[i]=f64_bits(fresh.hinge_rates[i].value);}
 for i:0..<2 {fresh.slide_rates[i]=sv[i]+convert_unit(PidLinearRate,h*effective.slide[i]);fresh.slides[i]=s[i]+convert_unit(pfku.Metre,h*fresh.slide_rates[i]);qb[7+i]=f64_bits(fresh.slides[i].value);vb[7+i]=f64_bits(fresh.slide_rates[i].value);}
 status:=pid_admit(qb,100,1);if status!=PfkStatus.ok {return PeuResult.{status=pms_model_status(status)};}status=pid_admit(vb,20,2);if status!=PfkStatus.ok {return PeuResult.{status=pms_model_status(status)};}return PeuResult.{output=fresh};
}
peu_complete :: (q:[7]pfku.Quantity(pfku.Radian,f64),s:[2]pfku.Quantity(pfku.Metre,f64),v:[7]pfku.Quantity(PidAngularRate,f64),sv:[2]pfku.Quantity(PidLinearRate,f64),solved:PmsRaw,control_clipped:int,force_clipped:int,output:[]PeuOutput)->PmsStatus {
 if output.count!=1 {return PmsStatus.shape;}if solved.status!=PmsStatus.ok {return solved.status;}next:=peu_advance(q,s,v,sv,pms_restore(solved.acceleration));if next.status!=PmsStatus.ok {return next.status;}next.output.control_clipped=control_clipped;next.output.force_clipped=force_clipped;output[0]=next.output;return PmsStatus.ok;
}

