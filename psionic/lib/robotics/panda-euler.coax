// Fixed h=.002 s, implicit joint damping, all other smooth forces explicit.
// No contact/constraint/frictionloss solve, time scalar or command validity.
#load "panda-euler-math.coax";
#authority;
#forall "Euler all typed shapes precede numerical admission and preserve entire output" field:0..<9,large:bool {
 q:[8]pfku.Quantity(pfku.Radian,f64);s:[3]pfku.Quantity(pfku.Metre,f64);v:[8]pfku.Quantity(PidAngularRate,f64);sv:[3]pfku.Quantity(PidLinearRate,f64);u:[8]pfku.Quantity(PmHingeGravity,f64);t:[3]pfku.Quantity(pfku.Metre,f64);eh:[8]pfku.Quantity(PmHingeGravity,f64);es:[3]pfku.Quantity(PmSlideGravity,f64);out:=[2]PeuOutput.[peu_poison(),peu_poison()];old:=out[0];
 qs:=q[0..<7];ss:=s[0..<2];vs:=v[0..<7];ws:=sv[0..<2];us:=u[0..<7];ts:=t[0..<2];hs:=eh[0..<7];fs:=es[0..<2];os:=out[0..<1];
 if field==0 {qs=ifx large then q[..] else q[0..<6];}if field==1 {ss=ifx large then s[..] else s[0..<1];}if field==2 {vs=ifx large then v[..] else v[0..<6];}if field==3 {ws=ifx large then sv[..] else sv[0..<1];}if field==4 {us=ifx large then u[..] else u[0..<6];}if field==5 {ts=ifx large then t[..] else t[0..<1];}if field==6 {hs=ifx large then eh[..] else eh[0..<6];}if field==7 {fs=ifx large then es[..] else es[0..<1];}if field==8 {os=ifx large then out[..] else out[0..<0];}
 q[0].value=101;eh[0].value=10001;#assert peu_step(qs,ss,vs,ws,us,ts,hs,fs,os)==PmsStatus.shape;peu_same(out[0],old);peu_same(out[1],old);
}
#forall "Euler packed shapes all precede numerical refusal including output count" field:0..<5,large:bool {
 q:[10]f64;v:[10]f64;c:[10]f64;e:[10]f64;out:=[2]PeuOutput.[peu_poison(),peu_poison()];old:=out[0];qs:=q[0..<9];vs:=v[0..<9];cs:=c[0..<9];es:=e[0..<9];os:=out[0..<1];
 if field==0 {qs=ifx large then q[..] else q[0..<8];}if field==1 {vs=ifx large then v[..] else v[0..<8];}if field==2 {cs=ifx large then c[..] else c[0..<8];}if field==3 {es=ifx large then e[..] else e[0..<8];}if field==4 {os=ifx large then out[..] else out[0..<0];}q[0]=101;e[0]=10001;
 #assert peu_step_raw(qs,vs,cs,es,os)==PmsStatus.shape;peu_same(out[0],old);peu_same(out[1],old);
}
#forall "Euler all packed input role lanes enforce original numeric domain without publication" role:0..<4,lane:0..<9,negative:bool {
 q:[9]f64;v:[9]f64;c:[9]f64;e:[9]f64;out:=[1]PeuOutput.[peu_poison()];old:=out[0];bound:=ifx role==0 then (ifx lane<7 then 100.0 else 1.0) else ifx role==1 then (ifx lane<7 then 20.0 else 2.0) else ifx role==2 then (ifx lane<7 then 10000.0 else 1.0) else 10000.0;bits:=f64_bits(bound)+1;if negative {bits=bits|0x8000000000000000;}bad:=f64_from_bits(bits);
 if role==0 {q[lane]=bad;}if role==1 {v[lane]=bad;}if role==2 {c[lane]=bad;}if role==3 {e[lane]=bad;}
 #assert peu_step_raw(q[..],v[..],c[..],e[..],out[..])==PmsStatus.range;peu_same(out[0],old);
}
#test "Euler force admission and late next-state refusal preserve every output lane" {
 q:[9]f64;v:[9]f64;c:[9]f64;e:[9]f64;out:=[1]PeuOutput.[peu_poison()];old:=out[0];
 q[0]=101;e[0]=10001;#assert peu_step_raw(q[..],v[..],c[..],e[..],out[..])==PmsStatus.range;peu_same(out[0],old);
 q[0]=100;e[0]=0;v[0]=1;#assert peu_step_raw(q[..],v[..],c[..],e[..],out[..])==PmsStatus.range;peu_same(out[0],old);
 q[0]=0;v[0]=0;c[7]=0.04;e[7]=10000;#assert peu_step_raw(q[..],v[..],c[..],e[..],out[..])==PmsStatus.range;peu_same(out[0],old);
}
#test "Euler dense whole step transports every typed lane and uses effective velocity first with exact clipping meaning" {
 x:=psf_fixture();x.external=[9]f64.[0.5,-0.6,0.7,-0.8,0.9,-0.1,0.2,0.3,-0.4];q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);u:[7]pfku.Quantity(PmHingeGravity,f64);t:[2]pfku.Quantity(pfku.Metre,f64);eh:[7]pfku.Quantity(PmHingeGravity,f64);es:[2]pfku.Quantity(PmSlideGravity,f64);
 for i:0..<7 {q[i].value=x.q[i];v[i].value=x.v[i];u[i].value=x.control[i];eh[i].value=x.external[i];}for i:0..<2 {s[i].value=x.q[7+i];sv[i].value=x.v[7+i];t[i].value=x.control[7+i];es[i].value=x.external[7+i];}
 raw:[1]PeuOutput;out:=[2]PeuOutput.[peu_poison(),peu_poison()];tail:=out[1];#assert peu_step(q[..],s[..],v[..],sv[..],u[..],t[..],eh[..],es[..],out[0..<1])==PmsStatus.ok;#assert peu_step_raw(x.q[..],x.v[..],x.control[..],x.external[..],raw[..])==PmsStatus.ok;peu_same(raw[0],out[0]);peu_same(out[1],tail);
 for i:0..<7 {#assert out[0].hinge_rates[i].value==x.v[i]+0.002*out[0].effective.hinge[i].value;#assert out[0].angles[i].value==x.q[i]+0.002*out[0].hinge_rates[i].value;}for i:0..<2 {#assert out[0].slide_rates[i].value==x.v[7+i]+0.002*out[0].effective.slide[i].value;#assert out[0].slides[i].value==x.q[7+i]+0.002*out[0].slide_rates[i].value;}#assert out[0].control_clipped==0 && out[0].force_clipped==0;
 instant:[1]PsfOutput;#assert psf_forward_raw(x.q[..],x.v[..],x.control[..],x.external[..],instant[..])==PmsStatus.ok;#assert abs(instant[0].acceleration.slide[0].value-out[0].effective.slide[0].value)>0.01;
 for i:0..<7 {x.control[i]=100;}x.control[7]=0.05;x.control[8]= -0.05;#assert peu_step_raw(x.q[..],x.v[..],x.control[..],x.external[..],raw[..])==PmsStatus.ok;#assert raw[0].control_clipped==9 && raw[0].force_clipped==1;
}
#forall "Euler response admits APPLIED and NET force independently even when a later state bound could mask refusal" lane:0..<9,side:bool {
 metric:PmOutput;for i:0..<7 {metric.hinge_hinge[i*7+i].value=2;}for i:0..<2 {metric.slide_slide[i*2+i].value=2;}
 applied:PidOutput;bias:PidOutput;limit:=ifx side then -10000.0 else 10000.0;outside:=ifx side then -10000.000000000002 else 10000.000000000002;opposite:=ifx side then 1.0 else -1.0;
 if lane<7 {applied.hinge[lane].value=outside;bias.hinge[lane].value= -opposite;}else {applied.slide[lane-7].value=outside;bias.slide[lane-7].value= -opposite;}
 r:=peu_response(metric,applied,bias);#assert r.status==PmsStatus.range;for x:r.acceleration {#assert x==0;}
 if lane<7 {applied.hinge[lane].value=limit;bias.hinge[lane].value=opposite;}else {applied.slide[lane-7].value=limit;bias.slide[lane-7].value=opposite;}
 r=peu_response(metric,applied,bias);#assert r.status==PmsStatus.range;for x:r.acceleration {#assert x==0;}
 if lane<7 {bias.hinge[lane].value=0;}else {bias.slide[lane-7].value=0;}r=peu_response(metric,applied,bias);#assert r.status==PmsStatus.ok;denominator:=ifx lane<7 then (ifx lane<5 then 2.0002 else 2.00002) else 2.2;for i:0..<9 {#assert abs(r.acceleration[i]-(ifx i==lane then limit/denominator else 0.0))<1e-10;}
}

#forall "Euler original cached operands match independent Gaussian algebraic targets in every q v effective lane" variant:0..<3 {
 q:[9]f64;v:[9]f64;c:[9]f64;e:[9]f64;values:=[3]f64.[0.02,0.019999999999999997,0.020000000000000004];c[7]=values[variant];c[8]= -values[variant];out:[1]PeuOutput;
 #assert peu_step_raw(q[..],v[..],c[..],e[..],out[..])==PmsStatus.ok;peu_cached_golden(out[0],variant);#assert out[0].control_clipped==0 && out[0].force_clipped==(ifx variant==2 then 2 else 0);
}

peu_response :: (metric:PmOutput,applied:PidOutput,bias:PidOutput)->PmsRaw {
 status:=pms_forces_admit(pfd_words(applied));if status!=PmsStatus.ok {return PmsRaw.{status=status};}net:=pfd_subtract(applied,bias);status=pms_forces_admit(pfd_words(net));if status!=PmsStatus.ok {return PmsRaw.{status=status};}
 problem:=pms_basis(peu_metric(metric),net.hinge,net.slide);return pms_solve_force_admitted(problem.mass,problem.force);
}

peu_step :: (angles:[]pfku.Quantity(pfku.Radian,f64),slides:[]pfku.Quantity(pfku.Metre,f64),hinge_rates:[]pfku.Quantity(PidAngularRate,f64),slide_rates:[]pfku.Quantity(PidLinearRate,f64),arm_control:[]pfku.Quantity(PmHingeGravity,f64),finger_target:[]pfku.Quantity(pfku.Metre,f64),external_hinge:[]pfku.Quantity(PmHingeGravity,f64),external_slide:[]pfku.Quantity(PmSlideGravity,f64),output:[]PeuOutput)->PmsStatus #export_c {
 if angles.count!=7 || slides.count!=2 || hinge_rates.count!=7 || slide_rates.count!=2 || arm_control.count!=7 || finger_target.count!=2 || external_hinge.count!=7 || external_slide.count!=2 || output.count!=1 {return PmsStatus.shape;}
 external:PidOutput;for i:0..<7 {external.hinge[i]=external_hinge[i];}for i:0..<2 {external.slide[i]=external_slide[i];}status:=pms_forces_admit(pfd_words(external));if status!=PmsStatus.ok {return status;}
 poses:[1]PffOutput;model:=pff_forward(angles,slides,poses[..]);if model!=PfkStatus.ok {return pms_model_status(model);}
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);velocities:[9]f64;
 for i:0..<7 {q[i]=angles[i];v[i]=hinge_rates[i];velocities[i]=v[i].value;}for i:0..<2 {s[i]=slides[i];sv[i]=slide_rates[i];velocities[7+i]=sv[i].value;}
 // Pa validates rates before controls; repeating that admission here would be
 // redundant. It runs before any fluid/bias arithmetic on these copied values.
 actuator:[1]PaOutput;model=pa_forward(angles,slides,hinge_rates,slide_rates,arm_control,finger_target,actuator[..]);if model!=PfkStatus.ok {return pms_model_status(model);}
 profile:=pm_profile();fluid:=pfl_sum_owned(poses[0],profile,v,sv);passive:PidOutput;for i:0..<7 {passive.hinge[i]=actuator[0].joint_passive.hinge[i]+fluid.hinge[i];}for i:0..<2 {passive.slide[i]=actuator[0].joint_passive.slide[i]+fluid.slide[i];}
 applied:=psf_applied(actuator[0].actuator,external,passive);metric:=pm_sum_owned(poses[0],profile);zero_acceleration:[9]f64;bias:=pid_sum_owned(poses[0],profile,velocities,zero_acceleration);
 return peu_complete(q,s,v,sv,peu_response(metric,applied,bias),actuator[0].control_clipped,actuator[0].force_clipped,output);
}
peu_step_raw :: (coordinates:[]f64,rates:[]f64,controls:[]f64,external:[]f64,output:[]PeuOutput)->PmsStatus #export_c {
 if coordinates.count!=9 || rates.count!=9 || controls.count!=9 || external.count!=9 || output.count!=1 {return PmsStatus.shape;}
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);u:[7]pfku.Quantity(PmHingeGravity,f64);t:[2]pfku.Quantity(pfku.Metre,f64);eh:[7]pfku.Quantity(PmHingeGravity,f64);es:[2]pfku.Quantity(PmSlideGravity,f64);
 for i:0..<7 {q[i].value=coordinates[i];v[i].value=rates[i];u[i].value=controls[i];eh[i].value=external[i];}for i:0..<2 {s[i].value=coordinates[7+i];sv[i].value=rates[7+i];t[i].value=controls[7+i];es[i].value=external[7+i];}return peu_step(q[..],s[..],v[..],sv[..],u[..],t[..],eh[..],es[..],output);
}

#test "Euler moving force assembly agrees in every residual lane with the separately qualified smooth force path" {
 x:=psf_fixture();x.external=[9]f64.[0.5,-0.6,0.7,-0.8,0.9,-0.1,0.2,0.3,-0.4];instant:[1]PsfOutput;out:[1]PeuOutput;
 #assert psf_forward_raw(x.q[..],x.v[..],x.control[..],x.external[..],instant[..])==PmsStatus.ok;#assert peu_step_raw(x.q[..],x.v[..],x.control[..],x.external[..],out[..])==PmsStatus.ok;
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);for i:0..<7 {q[i].value=x.q[i];}for i:0..<2 {s[i].value=x.q[7+i];}metric:[1]PmOutput;#assert pm_forward(q[..],s[..],metric[..])==PfkStatus.ok;
 zero_h:[7]pfku.Quantity(PmHingeGravity,f64);zero_s:[2]pfku.Quantity(PmSlideGravity,f64);m:=pms_basis(metric[0],zero_h,zero_s);a:=pms_basis(peu_metric(metric[0]),zero_h,zero_s);instant_words:[9]f64;effective_words:[9]f64;
 for i:0..<7 {instant_words[i]=instant[0].acceleration.hinge[i].value;effective_words[i]=out[0].effective.hinge[i].value;}for i:0..<2 {instant_words[7+i]=instant[0].acceleration.slide[i].value;effective_words[7+i]=out[0].effective.slide[i].value;}
 for i:0..<9 {left:f64;right:f64;for j:0..<9 {left+=m.mass[i*9+j]*instant_words[j];right+=a.mass[i*9+j]*effective_words[j];}#assert abs(left-right)<1e-10;}
}
