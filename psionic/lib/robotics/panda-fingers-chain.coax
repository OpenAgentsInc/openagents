// Fixed four-body, two-slide extension. Metres are coordinates, not normalized
// gripper commands. +/-1m is numerical admission, never a source soft limit.
#load "panda-fingers-profile.coax";
#load "panda-fingers-check-fixtures.coax";
#authority;
#test "Panda fingers shape first then arm and slide index refusal order is atomic" {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);out:=[2]PffOutput.[pff_poison(),pff_poison()];old:=out[0];
 #assert pff_forward(q[0..<6],s[..],out[0..<1])==PfkStatus.shape;pff_same(out[0],old);
 #assert pff_forward(q[..],s[0..<1],out[0..<1])==PfkStatus.shape;pff_same(out[0],old);
 #assert pff_forward(q[..],s[..],out[0..<0])==PfkStatus.shape;pff_same(out[0],old);
 #assert pff_forward(q[..],s[..],out[..])==PfkStatus.shape;pff_same(out[0],old);pff_same(out[1],old);
 q[0].value=101;s[0].value=2;#assert pff_forward(q[..],s[..],out[0..<1])==PfkStatus.range;pff_same(out[0],old);
 s[0].value=0;#assert pff_forward(q[..],s[..],out[0..<1])==PfkStatus.range;pff_same(out[0],old);
 words:=[2]u64.[0x4000000000000000,0x7ff0000000000000];#assert pff_slides_admit(words)==PfkStatus.range;
 words=[2]u64.[0x3ff0000000000000,0x7ff0000000000000];#assert pff_slides_admit(words)==PfkStatus.number;
}
#forall "Panda fingers every slide finite boundary and next outside value" axis:0..<2,negative:bool {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);out:=[1]PffOutput.[pff_poison()];old:=out[0];
 for bad:[3]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001] {words:[2]u64;words[axis]=bad;#assert pff_slides_admit(words)==PfkStatus.number;}
 s[axis].value=ifx negative then -1.0000000000000002 else 1.0000000000000002;#assert pff_forward(q[..],s[..],out[..])==PfkStatus.range;pff_same(out[0],old);
 s[axis].value=ifx negative then -1.0 else 1.0;#assert pff_forward(q[..],s[..],out[..])==PfkStatus.ok;
}
#test "Panda fingers branch translation rotates fixed local Y before sliding" {
 parent:PfkPose;parent.quaternion[0]=1;nodes:=pff_profile();q:pfku.Quantity(pfku.Metre,f64);q.value=0.04;
 left:=pff_branch(parent,nodes[0],q);#assert abs(left.position.x+0.04)<1e-15 && abs(left.position.y)<1e-15 && left.position.z==0.0524;
 tip:=pff_branch(left,nodes[1],q);#assert abs(tip.position.x+0.0485)<1e-15 && abs(tip.position.y)<1e-15 && abs(tip.position.z-0.1084)<1e-15;
 q.value= -0.027;right:=pff_branch(parent,nodes[2],q);tip=pff_branch(right,nodes[3],q);#assert abs(tip.position.x-0.0355)<1e-15 && abs(tip.position.z-0.1084)<1e-15;
 node:=nodes[0];node.reference=0.01;q.value=0.04;shifted:=pff_branch(parent,node,q);#assert abs(shifted.position.x+0.03)<1e-15;
 node.axis=[3]f64.[0.6,0.8,0];shifted=pff_branch(parent,node,q);#assert abs(shifted.position.x+0.024)<1e-15 && abs(shifted.position.y-0.018)<1e-15;
 for i:0..<9 {#assert right.rotation[i]==left.rotation[i];}#assert abs(left.rotation[1]+1)<1e-15 && abs(left.rotation[3]-1)<1e-15;
}
#test "Panda fingers moving one branch preserves arm grip and other branch exactly" {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);a:[1]PffOutput;b:[1]PffOutput;oldarm:[1]PfkOutput;
 q[0].value=0.31;q[1].value= -0.22;q[6].value=0.73;s[0].value=0.013;s[1].value= -0.027;
 #assert pff_forward(q[..],s[..],a[..])==PfkStatus.ok && pfk_forward(q[..],oldarm[..])==PfkStatus.ok;pfk_same_output(a[0].arm,oldarm[0]);
 for i:0..<2 {finger:=i*2;offset:=[3]f64.[0,0.0085,0.056];if i==1 {offset[1]= -0.0085;}expected:=pfk_shift(a[0].fingers[finger].position,a[0].fingers[finger].quaternion,offset);tip:=a[0].fingers[finger+1].position;#assert abs(tip.x-expected.x)<1e-15 && abs(tip.y-expected.y)<1e-15 && abs(tip.z-expected.z)<1e-15;}
 s[0].value=0.031;#assert pff_forward(q[..],s[..],b[..])==PfkStatus.ok;pfk_same_output(a[0].arm,b[0].arm);
 for i:2..<4 {x:PfkOutput;y:PfkOutput;x.grip=a[0].fingers[i];y.grip=b[0].fingers[i];pfk_same_output(x,y);}
 for i:0..<4 {for j:0..<4 {#assert a[0].fingers[i].quaternion[j]==b[0].fingers[i].quaternion[j];}}
 #assert abs(a[0].fingers[0].position.x-b[0].fingers[0].position.x)>0.001;
 rawq:=[7]f64.[0.31,-0.22,0,0,0,0,0.73];raws:=[2]f64.[0.031,-0.027];#assert pff_forward_raw(rawq[..],raws[..],a[..])==PfkStatus.ok;pff_same(a[0],b[0]);
 #assert pff_forward_raw(rawq[0..<6],raws[..],a[..])==PfkStatus.shape;pff_same(a[0],b[0]);
 #assert pff_forward_raw(rawq[..],raws[0..<1],a[..])==PfkStatus.shape;pff_same(a[0],b[0]);
}

pff_slides_admit :: (words:[2]u64)->PfkStatus {for bits:words {if !pfk_finite(bits) {return PfkStatus.number;}if abs(f64_from_bits(bits))>1 {return PfkStatus.range;}}return PfkStatus.ok;}
pff_branch :: (parent:PfkPose,node:PffNode,coordinate:pfku.Quantity(pfku.Metre,f64))->PfkPose {
 child:PfkRigid;child.position=pfk_shift(parent.position,parent.quaternion,node.offset);child.quaternion=pfk_multiply(parent.quaternion,pfk_normalize(node.fixed).value);
 if node.joint>=0 {delta:=coordinate.value-node.reference;offset:[3]f64;for i:0..<3 {offset[i]=node.axis[i]*delta;}child.position=pfk_shift(child.position,child.quaternion,offset);}
 return pfk_pose(child);
}
pff_forward :: (angles:[]pfku.Quantity(pfku.Radian,f64),slides:[]pfku.Quantity(pfku.Metre,f64),output:[]PffOutput)->PfkStatus #export_c {
 if angles.count!=7 || slides.count!=2 || output.count!=1 {return PfkStatus.shape;}
 // Arm evaluation is private, so a later slide refusal still publishes nothing.
 arm:[1]PfkOutput;status:=pfk_forward(angles,arm[..]);if status!=PfkStatus.ok {return status;}
 words:[2]u64;for i:0..<2 {words[i]=f64_bits(slides[i].value);}status=pff_slides_admit(words);if status!=PfkStatus.ok {return status;}
 fresh:PffOutput;fresh.arm=arm[0];nodes:=pff_profile();
 for i:0..<4 {node:=nodes[i];parent:PfkPose;if node.parent==10 {parent=fresh.arm.links[node.parent];}else {parent=fresh.fingers[node.parent-12];}q:pfku.Quantity(pfku.Metre,f64);if node.joint>=0 {q=slides[node.joint];}fresh.fingers[i]=pff_branch(parent,node,q);}
 output[0]=fresh;return PfkStatus.ok;
}
pff_forward_raw :: (radians:[]f64,metres:[]f64,output:[]PffOutput)->PfkStatus #export_c {
 if radians.count!=7 || metres.count!=2 {return PfkStatus.shape;}q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);for i:0..<7 {q[i].value=radians[i];}for i:0..<2 {s[i].value=metres[i];}return pff_forward(q[..],s[..],output);
}
