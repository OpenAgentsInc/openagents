// Fixed7-hinge grip-SITE geometric derivative. Singular poses are valid.
// Reuses FK admission; no inversion/dynamics/time/provenance or #bounded claim.
#load "panda-fk-chain.coax";
#load "panda-jacobian-math.coax";
#load "panda-jacobian-check-fixtures.coax";
#authority;
#test "Panda Jacobian zero-angle singular posture is geometric and has analytic first and final columns" {
 q:[7]pfku.Quantity(pfku.Radian,f64);out:[1]PjOutput;#assert pj_forward(q[..],out[..])==PfkStatus.ok;
 #assert abs(out[0].linear[0].value)<2e-12 && abs(out[0].linear[7].value-0.088)<2e-12 && abs(out[0].linear[14].value)<2e-12;
 #assert out[0].angular[0].value==0 && out[0].angular[7].value==0 && out[0].angular[14].value==1;
 for row:0..<3 {#assert abs(out[0].linear[row*7+6].value)<2e-12;}
 for col:0..<7 {norm:f64=0;for row:0..<3 {v:=out[0].angular[row*7+col].value;norm+=v*v;}#assert abs(norm-1)<2e-12;}
 raw:[7]f64;b:[1]PjOutput;#assert pj_forward_raw(raw[..],b[..])==PfkStatus.ok;pj_same(out[0],b[0]);
}
#test "Panda Jacobian shape refusal leaves both caller outputs unchanged" {
 q:[8]pfku.Quantity(pfku.Radian,f64);raw:[8]f64;out:=[2]PjOutput.[pj_poison(),pj_poison()];old:=out[0];
 #assert pj_forward(q[0..<6],out[0..<1])==PfkStatus.shape;pj_same(out[0],old);
 #assert pj_forward(q[..],out[0..<1])==PfkStatus.shape;pj_same(out[0],old);
 #assert pj_forward(q[0..<7],out[0..<0])==PfkStatus.shape;pj_same(out[0],old);
 #assert pj_forward(q[0..<7],out[..])==PfkStatus.shape;pj_same(out[0],old);pj_same(out[1],old);
 #assert pj_forward_raw(raw[0..<6],out[0..<1])==PfkStatus.shape;pj_same(out[0],old);
 #assert pj_forward_raw(raw[..],out[0..<1])==PfkStatus.shape;pj_same(out[0],old);
 #assert pj_forward_raw(raw[0..<7],out[0..<0])==PfkStatus.shape;pj_same(out[0],old);
}
#forall "Panda Jacobian every joint refuses outside-domain values atomically and admits boundaries" axis:0..<7,negative:bool {
 q:[7]pfku.Quantity(pfku.Radian,f64);raw:[7]f64;out:=[1]PjOutput.[pj_poison()];old:=out[0];
 q[axis].value=ifx negative then -100.00000000000001 else 100.00000000000001;raw[axis]=q[axis].value;
 #assert pj_forward(q[..],out[..])==PfkStatus.range;pj_same(out[0],old);#assert pj_forward_raw(raw[..],out[..])==PfkStatus.range;pj_same(out[0],old);
 q[axis].value=ifx negative then -100.0 else 100.0;raw[axis]=q[axis].value;a:[1]PjOutput;b:[1]PjOutput;
 #assert pj_forward(q[..],a[..])==PfkStatus.ok && pj_forward_raw(raw[..],b[..])==PfkStatus.ok;pj_same(a[0],b[0]);
 for i:0..<21 {#assert pfk_finite(f64_bits(a[0].linear[i].value)) && pfk_finite(f64_bits(a[0].angular[i].value));}
}

pj_forward :: (angles:[]pfku.Quantity(pfku.Radian,f64),output:[]PjOutput)->PfkStatus #export_c {
 if output.count!=1 {return PfkStatus.shape;}
 owned:[1]PfkOutput;status:=pfk_forward(angles,owned[..]);if status!=PfkStatus.ok {return status;}
 fresh:=pj_project_owned(owned[0]);output[0]=fresh;return PfkStatus.ok;
}
pj_forward_raw :: (radians:[]f64,output:[]PjOutput)->PfkStatus #export_c {
 if radians.count!=7 {return PfkStatus.shape;}angles:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {angles[i].value=radians[i];}return pj_forward(angles[..],output);
}
