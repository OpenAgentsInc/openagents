#load "panda-joint-pd-types.coax";
pjp_fixture :: ()->PjpInput {x:PjpInput;x.q=pik_home();x.target=x.q;x.kp=pjp_default_kp();x.kd=pjp_default_kd();x.slides[0].value=0.013;x.slides[1].value= -0.027;return x;}
pjp_words :: ()->[44]u64 {x:=pjp_fixture();w:[44]u64;for i:0..<7 {w[i]=f64_bits(x.q[i].value);w[9+i]=f64_bits(x.rate[i].value);w[16+i]=f64_bits(x.target[i].value);w[23+i]=f64_bits(x.target_rate[i].value);w[30+i]=f64_bits(x.kp[i].value);w[37+i]=f64_bits(x.kd[i].value);}for i:0..<2 {w[7+i]=f64_bits(x.slides[i].value);}return w;}
pjp_poison :: ()->PjpOutput {x:PjpOutput;for i:0..<7 {x.proportional[i].value=1001+f64(i);x.derivative[i].value=1011+f64(i);x.gravity[i].value=1021+f64(i);x.requested[i].value=1031+f64(i);x.command[i].value=1041+f64(i);}x.clipped=1051;return x;}
pjp_same :: (a:PjpOutput,b:PjpOutput) {for i:0..<7 {#assert f64_bits(a.proportional[i].value)==f64_bits(b.proportional[i].value) && f64_bits(a.derivative[i].value)==f64_bits(b.derivative[i].value) && f64_bits(a.gravity[i].value)==f64_bits(b.gravity[i].value) && f64_bits(a.requested[i].value)==f64_bits(b.requested[i].value) && f64_bits(a.command[i].value)==f64_bits(b.command[i].value);}#assert a.clipped==b.clipped;}
