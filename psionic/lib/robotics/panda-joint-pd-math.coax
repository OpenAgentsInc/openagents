// Typed joint-PD arithmetic. Source-visible helpers trust admitted inputs and
// owned gravity; no arbitrary-POD provenance or bounded-control certificate.
#load "panda-joint-pd-types.coax";
#load "panda-joint-pd-fixtures.coax";
#authority;
#test "Panda joint PD default gains keep all seven physical coefficients distinct" {
 p:=pjp_default_kp();d:=pjp_default_kd();pe:=[7]f64.[60,60,60,60,40,20,10];de:=[7]f64.[8,8,8,8,5,3,2];for i:0..<7 {#assert p[i].value==pe[i] && d[i].value==de[i];}
 #assert pjp_admit(pjp_words())==PjpStatus.ok;
}
#forall "Panda joint PD source current and target joint limits are inclusive and precede later fields" axis:0..<7,side:bool,target:bool {
 w:=pjp_words();index:=axis+(ifx target then 16 else 0);lo:=pik_lower();hi:=pik_upper();edge:=ifx side then hi[axis] else lo[axis];w[index]=f64_bits(edge);#assert pjp_admit(w)==PjpStatus.ok;
 w[index]=f64_bits(edge+(ifx side then 1e-9 else -1e-9));#assert pjp_admit(w)==PjpStatus.limits;
}
#forall "Panda joint PD rate slide and gain boxes have exact inclusive endpoints" ordinal:0..<30,side:bool {
 index:=ifx ordinal<9 then ordinal+7 else ordinal+14;w:=pjp_words();bound:=ifx index<9 then 1.0 else ifx index<30 then 20.0 else ifx index<37 then 500.0 else 100.0;
 edge:=ifx index<30 then (ifx side then bound else -bound) else (ifx side then bound else 1e-6);w[index]=f64_bits(edge);#assert pjp_admit(w)==PjpStatus.ok;
 w[index]=f64_bits(edge+(ifx side then 1e-9 else -1e-9));#assert pjp_admit(w)==PjpStatus.range;
}
#test "Panda joint PD IEEE word admission stops before conversion and preserves field order" {
 for i:0..<44 {for bits:[3]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001] {w:=pjp_words();w[i]=bits;#assert pjp_admit(w)==PjpStatus.number;}}
 w:=pjp_words();w[0]=f64_bits(3.0);w[43]=0x7ff8000000000001;#assert pjp_admit(w)==PjpStatus.limits;
 w=pjp_words();w[7]=f64_bits(2.0);w[9]=0x7ff8000000000001;#assert pjp_admit(w)==PjpStatus.range;
}
#test "Panda joint PD literal terms distinguish target minus measured rate and gravity from feedback" {
 x:=pjp_fixture();g:[7]pfku.Quantity(PmHingeGravity,f64);for i:0..<7 {x.target[i].value=x.q[i].value+(ifx i%2==0 then 0.125 else -0.125);x.rate[i].value=0.5*f64(i+1);x.target_rate[i].value= -x.rate[i].value;x.kp[i].value=8*f64(i+1);x.kd[i].value=f64(i+2);g[i].value=f64(i)-3;}
 out:=pjp_assemble(x,g);#assert out.clipped==2;
 for i:0..<7 {p:=ifx i%2==0 then f64(i+1) else -f64(i+1);d:= -f64((i+1)*(i+2));requested:=(p+d)+f64(i)-3;#assert out.proportional[i].value==p && out.derivative[i].value==d && out.gravity[i].value==f64(i)-3 && out.requested[i].value==requested && out.command[i].value==(ifx i<5 then requested else -12.0);}
 x=pjp_fixture();for i:0..<7 {g[i].value=ifx i%2==0 then pa_torque_limit(i)+1 else -pa_torque_limit(i)-1;}out=pjp_assemble(x,g);#assert out.clipped==7;for i:0..<7 {#assert out.requested[i].value==g[i].value && out.command[i].value==(ifx i%2==0 then pa_torque_limit(i) else -pa_torque_limit(i));}
 for i:0..<7 {g[i].value=pa_torque_limit(i);}out=pjp_assemble(x,g);#assert out.clipped==0;for i:0..<7 {#assert out.command[i].value==g[i].value;}
}

pjp_default_kp :: ()->[7]pfku.Quantity(PjpStiffness,f64) #export_c {values:=[7]f64.[60,60,60,60,40,20,10];out:[7]pfku.Quantity(PjpStiffness,f64);for i:0..<7 {out[i].value=values[i];}return out;}
pjp_default_kd :: ()->[7]pfku.Quantity(PjpDamping,f64) #export_c {values:=[7]f64.[8,8,8,8,5,3,2];out:[7]pfku.Quantity(PjpDamping,f64);for i:0..<7 {out[i].value=values[i];}return out;}
pjp_admit :: (words:[44]u64)->PjpStatus {
 lower:=pik_lower();upper:=pik_upper();
 for i:0..<44 {if !pfk_finite(words[i]) {return PjpStatus.number;}value:=f64_from_bits(words[i]);
  if i<7 {if value<lower[i] || value>upper[i] {return PjpStatus.limits;}}
  else if i>=16 && i<23 {if value<lower[i-16] || value>upper[i-16] {return PjpStatus.limits;}}
  else if i>=30 {bound:=ifx i<37 then 500.0 else 100.0;if value<1e-6 || value>bound {return PjpStatus.range;}}
  else {bound:=ifx i<9 then 1.0 else 20.0;if abs(value)>bound {return PjpStatus.range;}}
 }return PjpStatus.ok;
}
pjp_assemble :: (input:PjpInput,gravity:[7]pfku.Quantity(PmHingeGravity,f64))->PjpOutput {
 out:PjpOutput;for i:0..<7 {
  out.proportional[i]=convert_unit(PmHingeGravity,input.kp[i]*(input.target[i]-input.q[i]));
  out.derivative[i]=convert_unit(PmHingeGravity,input.kd[i]*(input.target_rate[i]-input.rate[i]));
  out.gravity[i]=gravity[i];out.requested[i]=(out.proportional[i]+out.derivative[i])+out.gravity[i];
  limited:=pa_clip(out.requested[i].value,-pa_torque_limit(i),pa_torque_limit(i));out.command[i].value=limited.value;if limited.clipped {out.clipped+=1;}
 }return out;
}
