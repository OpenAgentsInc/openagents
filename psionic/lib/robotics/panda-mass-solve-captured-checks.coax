// New solver checks from separately bound retained matrices; RHS fixed before solver execution.
#load "panda-mass-solve-check-fixtures.coax";
#test "Panda mass solve original and cached matrices recover a fixed dense acceleration" {
 for sample:0..<2 {q:[9]f64;f:[9]f64;
  if sample==0 {q=[9]f64.[0.0,0.19634954084936207,0.0,-2.617993877991494,0.0,2.941592653589793,0.7853981633974483,0.0,0.0];f=[9]f64.[1.0210849406139906,-0.21456598270006796,0.9721959978094535,-1.4841185691989223,0.8561771013838264,-1.047609877262502,0.8266048689990949,-1.1337077009096492,1.2250422990903496];}
  if sample==1 {q=[9]f64.[2.2533752082944463,-1.2778024212184658,-1.8378879475623644,-1.302063192871729,-2.0175088965067554,1.2269522305497682,-2.2653524292910374,0.027907134665190392,-0.03517817050814539];f=[9]f64.[1.970537417598147,-1.6273972807986317,1.0082489349235229,-1.509374412859111,1.1482487306299485,-0.6284083519181705,0.6489367879265147,-1.060718120479371,1.2980318795206287];}
  out:[1]PmsOutput;#assert pms_forward_raw(q[0..<7],q[7..<9],f[0..<7],f[7..<9],out[..])==PmsStatus.ok;want:=[9]f64.[0.125,-0.25,0.375,-0.5,0.625,-0.75,0.875,-1.0,1.125];for i:0..<7 {#assert abs(out[0].hinge[i].value-want[i])<2e-10;}for i:0..<2 {#assert abs(out[0].slide[i].value-want[7+i])<2e-10;}
 }
}
