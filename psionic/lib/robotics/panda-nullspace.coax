// Checked source-bound kinematic query; output is a delta, not a new pose.
#load "panda-nullspace-math.coax";
#authority;
#test "Panda nullspace one radian metre and angular weight preserve coefficient dimensions" {
 j:PjOutput;for i:0..<21 {j.linear[i].value=f64(i+1)/10;j.angular[i].value=f64(i+1)/20;}a:=pns_normalized(j);for i:0..<21 {#assert abs(a[i]-f64(i+1)/10)<2e-15 && abs(a[21+i]-f64(i+1)/80)<2e-15;}
}
#test "Panda nullspace both source vectors shape and domain refusals are atomic" {
 q:=pik_home();rest:=q;out:=[2]PnsOutput.[pns_poison(),pns_poison()];before:=out[0];
 #assert pns_query(q[0..<6],rest[..],out[0..<1])==PnsStatus.shape && pns_query(q[..],rest[0..<6],out[0..<1])==PnsStatus.shape && pns_query(q[..],rest[..],out[0..<0])==PnsStatus.shape && pns_query(q[..],rest[..],out[..])==PnsStatus.shape;
 hi:=pik_upper();lo:=pik_lower();for i:0..<7 {q=pik_home();q[i].value=hi[i]+0.1;#assert pns_query(q[..],rest[..],out[0..<1])==PnsStatus.limits;q=pik_home();rest=pik_home();rest[i].value=lo[i]-0.1;#assert pns_query(q[..],rest[..],out[0..<1])==PnsStatus.limits;rest=pik_home();}pns_same(out[0],before);pns_same(out[1],before);
 raw:[7]f64;#assert pns_query_raw(raw[0..<6],raw[..],out[0..<1])==PnsStatus.shape && pns_query_raw(raw[..],raw[0..<6],out[0..<1])==PnsStatus.shape && pns_query_raw(raw[..],raw[..],out[..])==PnsStatus.shape;
 words:[14]u64;home:=pik_home();for i:0..<14 {words[i]=f64_bits(home[i%7].value);}#assert pns_joint_bits(words)==PnsStatus.ok;for i:0..<14 {old:=words[i];words[i]=0x7ff8000000000001;#assert pns_joint_bits(words)==PnsStatus.number;words[i]=f64_bits(lo[i%7]);#assert pns_joint_bits(words)==PnsStatus.ok;words[i]=f64_bits(hi[i%7]);#assert pns_joint_bits(words)==PnsStatus.ok;words[i]=old;}words[0]=f64_bits(4.0);words[7]=0x7ff8000000000001;#assert pns_joint_bits(words)==PnsStatus.limits;
}
#test "Panda nullspace independent dense source posture observes line delta volume and raw agreement" {
 words:=[14]f64.[0.5916784815654972,-1.1314303950772526,1.3723101939314204,-0.7863450971120733,0.9193678441656266,2.7243916210477472,-1.0067594805156277,0.0,0.19634954084936207,0.0,-2.617993877991494,0.0,2.941592653589793,0.7853981633974483];q:[7]pfku.Quantity(pfku.Radian,f64);rest:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {q[i].value=words[i];rest[i].value=words[7+i];}out:[1]PnsOutput;#assert pns_query(q[..],rest[..],out[..])==PnsStatus.ok;
 expected:=[27]f64.[-0.08879913386739656,-0.259342502598368,-0.516616631351254,0.08307217411776675,0.7591248175936182,-0.19390169714626113,-0.19285770253298473,0.07287496397021574,0.2128351337415556,0.4239728109550833,-0.06817500838240136,-0.6229924924002351,0.1591296961792286,0.15827291901807714,9.2e-80,5e-80,2.18e-79,1.8e-80,5.6e-80,-6.9e-81,6.378e-79,1.21e-78,1.447e-78,-3.03e-79,4.54e-79,-3.571e-79,0.00044377840015018933];for i:0..<7 {#assert abs(out[0].projected_delta[i].value-expected[7+i])<=2e-8;for j:0..<7 {#assert abs(out[0].direction[i].value*out[0].direction[j].value-expected[i]*expected[j])<=2e-8;}}for i:0..<6 {#assert abs(out[0].null_residual[i].value)<=2e-10 && abs(out[0].task_leak[i].value)<=2e-10*4;}#assert abs(out[0].normalized_volume.value-expected[26])<=2e-12+2e-10*abs(expected[26]);
 rawq:[7]f64;rawrest:[7]f64;for i:0..<7 {rawq[i]=q[i].value;rawrest[i]=rest[i].value;}other:[1]PnsOutput;#assert pns_query_raw(rawq[..],rawrest[..],other[..])==PnsStatus.ok;pns_same(out[0],other[0]);
 #assert pns_query(q[..],q[..],other[..])==PnsStatus.ok;for i:0..<7 {#assert f64_bits(other[0].projected_delta[i].value)==0;}
}
#test "Panda nullspace unsealed geometry helper exposes FK refusal without publishing a certificate" {q:=pik_home();rest:=q;q[0].value=101;#assert pns_owned_query(q,rest).status==PnsStatus.range;}

pns_joint_bits :: (words:[14]u64)->PnsStatus {lo:=pik_lower();hi:=pik_upper();for i:0..<14 {if !pfk_finite(words[i]) {return PnsStatus.number;}value:=f64_from_bits(words[i]);if value<lo[i%7] || value>hi[i%7] {return PnsStatus.limits;}}return PnsStatus.ok;}
pns_normalized :: (j:PjOutput)->[42]f64 {radian:pfku.Quantity(pfku.Radian,f64);radian.value=1;metre:pfku.Quantity(pfku.Metre,f64);metre.value=1;weight:pfku.Quantity(PnsAngularWeight,f64);weight.value=0.25;a:[42]f64;for i:0..<21 {linear:=convert_unit(pfku.Metre,j.linear[i]*radian);angular:=convert_unit(pfku.Metre,weight*(j.angular[i]*radian));a[i]=convert_unit(UnitOne,linear/metre).value;a[21+i]=convert_unit(UnitOne,angular/metre).value;}return a;}
pns_owned_query :: (q:[7]pfku.Quantity(pfku.Radian,f64),rest:[7]pfku.Quantity(pfku.Radian,f64))->PnsProjection {local:=q;fk:[1]PfkOutput;if pfk_forward(local[..],fk[..])!=PfkStatus.ok {return PnsProjection.{status=PnsStatus.range};}matrix:=pns_normalized(pj_project_owned(fk[0]));basis:pfku.Quantity(pfku.Radian,f64);basis.value=1;delta:[7]f64;for i:0..<7 {delta[i]=convert_unit(UnitOne,(rest[i]-q[i])/basis).value;}return pns_project_owned(matrix,delta);}
pns_query :: (q:[]pfku.Quantity(pfku.Radian,f64),rest:[]pfku.Quantity(pfku.Radian,f64),output:[]PnsOutput)->PnsStatus #export_c {if q.count!=7 || rest.count!=7 || output.count!=1 {return PnsStatus.shape;}words:[14]u64;for i:0..<7 {words[i]=f64_bits(q[i].value);words[7+i]=f64_bits(rest[i].value);}status:=pns_joint_bits(words);if status!=PnsStatus.ok {return status;}ownedq:[7]pfku.Quantity(pfku.Radian,f64);ownedrest:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {ownedq[i]=q[i];ownedrest[i]=rest[i];}result:=pns_owned_query(ownedq,ownedrest);if result.status!=PnsStatus.ok {return result.status;}output[0]=result.value;return PnsStatus.ok;}
pns_query_raw :: (q:[]f64,rest:[]f64,output:[]PnsOutput)->PnsStatus #export_c {if q.count!=7 || rest.count!=7 || output.count!=1 {return PnsStatus.shape;}typedq:[7]pfku.Quantity(pfku.Radian,f64);typedrest:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {typedq[i].value=q[i];typedrest[i].value=rest[i];}return pns_query(typedq[..],typedrest[..],output);}
