#load "panda-pose-ik-types.coax";
ppo_rot_poison :: ()->PpoRotation {r:PpoRotation;for i:0..<3 {r.vector[i].value=1001+f64(i);}r.angle.value=1004;return r;}
ppo_rot_same :: (a:PpoRotation,b:PpoRotation) {for i:0..<3 {#assert f64_bits(a.vector[i].value)==f64_bits(b.vector[i].value);}#assert f64_bits(a.angle.value)==f64_bits(b.angle.value);}
ppo_poison :: ()->PpoOutput {r:PpoOutput;for i:0..<7 {r.angles[i].value=1001+f64(i);}r.position.x=1011;r.position.y=1012;r.position.z=1013;for i:0..<4 {r.world_from_grip_wxyz[i]=1021+f64(i);}r.position_error_metres=1031;r.orientation_error.value=1032;r.weighted_error_metres=1033;r.updates=1041;r.projected_coordinates=1042;return r;}
ppo_same :: (a:PpoOutput,b:PpoOutput) {for i:0..<7 {#assert f64_bits(a.angles[i].value)==f64_bits(b.angles[i].value);}#assert f64_bits(a.position.x)==f64_bits(b.position.x)&&f64_bits(a.position.y)==f64_bits(b.position.y)&&f64_bits(a.position.z)==f64_bits(b.position.z);for i:0..<4 {#assert f64_bits(a.world_from_grip_wxyz[i])==f64_bits(b.world_from_grip_wxyz[i]);}#assert f64_bits(a.position_error_metres)==f64_bits(b.position_error_metres)&&f64_bits(a.orientation_error.value)==f64_bits(b.orientation_error.value)&&f64_bits(a.weighted_error_metres)==f64_bits(b.weighted_error_metres)&&a.updates==b.updates&&a.projected_coordinates==b.projected_coordinates;}
