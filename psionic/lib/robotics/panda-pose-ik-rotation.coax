// Principal WORLD-left quaternion log. Quarter-atan is owned bounded F64
// arithmetic; no host atan2, transform-chain or global continuity claim.
#load "panda-pose-ik-fixtures.coax";
#load "panda-fk-math.coax";
#authority;
#test "Panda pose atan ratio and scaled norm retain zero tiny and quarter-angle identities" {
 #assert ppo_atan_ratio(0)==1;z:=0.41421356237309515;#assert abs(z*ppo_atan_ratio(z)-3.141592653589793/8)<2e-12 && ppo_atan_ratio(z)==ppo_atan_ratio(-z);
 #assert abs(0.1*ppo_atan_ratio(0.1)-0.09966865249116204)<2e-12;
 #assert ppo_norm3([3]f64.[0,-0.0,0])==0 && ppo_norm3([3]f64.[1e-200,0,0])==1e-200 && ppo_norm3([3]f64.[3,4,12])==13;
}
#test "Panda pose canonical quaternions fix both hemispheres every zero sign and exact pi axis tie" {
 for axis:1..<4 {q:[4]f64;q[axis]= -1;q[0]= -0.0;r:=ppo_canonical(q);for i:0..<4 {#assert f64_bits(r[i])==f64_bits(ifx i==axis then 1.0 else 0.0);}}
 r:=ppo_canonical([4]f64.[-0.5,0.5,-0.5,0.5]);#assert r[0]==0.5 && r[1]== -0.5 && r[2]==0.5 && r[3]== -0.5;
 q:=[4]f64.[1,0,0,0];#assert ppo_identical(q,q);for i:0..<4 {b:=q;b[i]+=0.1;#assert !ppo_identical(q,b);}
}
#test "Panda pose exact identity and cardinal pi logs have literal angle and canonical positive axis" {
 a:=[4]f64.[1,0,0,0];r:=ppo_error_owned(a,a);#assert f64_bits(r.angle.value)==0;for x:r.vector {#assert f64_bits(x.value)==0;}
 for axis:0..<3 {for negative:0..<2 {b:[4]f64;b[axis+1]=ifx negative==0 then 1.0 else -1.0;r=ppo_error_owned(a,b);#assert r.angle.value==3.141592653589793;for i:0..<3 {#assert r.vector[i].value==(ifx i==axis then 3.141592653589793 else 0.0);}}}
 tiny:=[4]f64.[1,1e-200,0,0];r=ppo_error_owned(a,tiny);#assert r.vector[0].value==2e-200 && r.angle.value==2e-200 && f64_bits(r.vector[1].value)==0 && f64_bits(r.vector[2].value)==0;
}
#test "Panda pose true principal log distinguishes dense WORLD-left order small angles and both sides of pi" {
 current:=ppo_canonical([4]f64.[0.25,0.5,0.75,1]);axis:=[3]f64.[1/sqrt(14.0),2/sqrt(14.0),3/sqrt(14.0)];
 for theta:[9]f64.[1e-12,1e-8,0.0001,0.1,1.5707963267938965,1.5707963267948966,1.5707963267958966,3.141592653489793,3.141592653689793] {
  delta:=[4]f64.[cos(theta/2),axis[0]*sin(theta/2),axis[1]*sin(theta/2),axis[2]*sin(theta/2)];target:=pfk_multiply(delta,current);r:=ppo_error_owned(current,target);want:=ifx theta>3.141592653589793 then theta-6.283185307179586 else theta;
  for i:0..<3 {#assert abs(r.vector[i].value-axis[i]*want)<2e-12;}#assert abs(r.angle.value-abs(want))<2e-12;
  for i:0..<4 {target[i]= -target[i];}ppo_rot_same(r,ppo_error_owned(current,target));for i:0..<4 {current[i]= -current[i];}ppo_rot_same(r,ppo_error_owned(current,target));
 }
}
#test "Panda pose quaternion words reject nonunit zero large and nonfinite representations before arithmetic" {
 bits:[4]u64;#assert ppo_unit_bits(bits)==PpoStatus.rotation;bits[0]=f64_bits(1.0);#assert ppo_unit_bits(bits)==PpoStatus.ok;bits[0]=f64_bits(1.000000001);#assert ppo_unit_bits(bits)==PpoStatus.rotation;bits[0]=f64_bits(2.1);#assert ppo_unit_bits(bits)==PpoStatus.range;
 for axis:0..<4 {for word:[3]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001] {bits=[4]u64.[0x3ff0000000000000,0,0,0];bits[axis]=word;#assert ppo_unit_bits(bits)==PpoStatus.number;}}
}
#test "Panda pose standalone shapes and ordinary quaternion refusals preserve complete output" {
 a:=[5]f64.[1,0,0,0,0];b:=a;out:=[2]PpoRotation.[ppo_rot_poison(),ppo_rot_poison()];old:=out[0];
 #assert ppo_rotation_raw(a[..],b[0..<4],out[0..<1])==PpoStatus.shape && ppo_rotation_raw(a[0..<3],b[0..<4],out[0..<1])==PpoStatus.shape && ppo_rotation_raw(a[0..<4],b[..],out[0..<1])==PpoStatus.shape && ppo_rotation_raw(a[0..<4],b[0..<3],out[0..<1])==PpoStatus.shape;
 #assert ppo_rotation_raw(a[0..<4],b[0..<4],out[0..<0])==PpoStatus.shape && ppo_rotation_raw(a[0..<4],b[0..<4],out[..])==PpoStatus.shape;
 a[0]=0;#assert ppo_rotation_raw(a[0..<4],b[0..<4],out[0..<1])==PpoStatus.rotation;a[0]=1;b[0]=0;#assert ppo_rotation_raw(a[0..<4],b[0..<4],out[0..<1])==PpoStatus.rotation;ppo_rot_same(out[0],old);ppo_rot_same(out[1],old);
 b[0]= -1;#assert ppo_rotation_raw(a[0..<4],b[0..<4],out[0..<1])==PpoStatus.ok;#assert out[0].angle.value==0;
}

ppo_atan_ratio :: (z:f64)->f64 {
 return ppo_atan_trace(z)[23];
}
ppo_norm3 :: (v:[3]f64)->f64 {
 scale:f64=0;for x:v {if pik_greater(abs(x),scale) {scale=abs(x);}}if scale==0 {return 0;}sum:f64=0;for x:v {ratio:=x/scale;sum+=ratio*ratio;}return scale*sqrt(sum);
}
ppo_unit_bits :: (words:[4]u64)->PpoStatus {
 norm:f64=0;for bits:words {if !pfk_finite(bits) {return PpoStatus.number;}v:=f64_from_bits(bits);if pik_greater(abs(v),2) {return PpoStatus.range;}norm+=v*v;}
 if pik_greater(abs(norm-1),2e-12) {return PpoStatus.rotation;}return PpoStatus.ok;
}
ppo_canonical :: (input:[4]f64)->[4]f64 {
 q:=pfk_normalize(input).value;negative:=pik_less(q[0],0);if q[0]==0 {if q[1]!=0 {negative=pik_less(q[1],0);}else if q[2]!=0 {negative=pik_less(q[2],0);}else {negative=pik_less(q[3],0);}}
 if negative {for i:0..<4 {q[i]= -q[i];}}for i:0..<4 {if q[i]==0 {q[i]=0.0;}}return q;
}
ppo_identical :: (a:[4]f64,b:[4]f64)->bool {return a[0]==b[0] && a[1]==b[1] && a[2]==b[2] && a[3]==b[3];}
ppo_error_owned :: (current:[4]f64,target:[4]f64)->PpoRotation {
 a:=ppo_canonical(current);b:=ppo_canonical(target);result:PpoRotation;if ppo_identical(a,b) {return result;}
 conjugate:=[4]f64.[a[0],-a[1],-a[2],-a[3]];relative:=ppo_canonical(pfk_multiply(b,conjugate));v:=[3]f64.[relative[1],relative[2],relative[3]];s:=ppo_norm3(v);x:=s/(1+relative[0]);factor:f64=0;
 if pik_greater(x,0.41421356237309515) {z:=(x-1)/(x+1);factor=(3.141592653589793+4*z*ppo_atan_ratio(z))/s;}
 else {factor=(4/(1+relative[0]))*ppo_atan_ratio(x);}
 for i:0..<3 {result.vector[i].value=factor*v[i];}result.angle.value=ppo_norm3([3]f64.[result.vector[0].value,result.vector[1].value,result.vector[2].value]);return result;
}
ppo_rotation_raw :: (current:[]f64,target:[]f64,output:[]PpoRotation)->PpoStatus #export_c {
 if current.count!=4 || target.count!=4 || output.count!=1 {return PpoStatus.shape;}
 a:[4]u64;b:[4]u64;for i:0..<4 {a[i]=f64_bits(current[i]);b[i]=f64_bits(target[i]);}
 status:=ppo_unit_bits(a);if status!=PpoStatus.ok {return status;}status=ppo_unit_bits(b);if status!=PpoStatus.ok {return status;}
 ca:[4]f64;ta:[4]f64;for i:0..<4 {ca[i]=current[i];ta[i]=target[i];}fresh:=ppo_error_owned(ca,ta);output[0]=fresh;return PpoStatus.ok;
}

// The trace exposes the explicitly frozen24 Horner stages, including tails
// below final-result rounding, so the approximation recipe is observable.
ppo_atan_trace :: (z:f64)->[24]f64 {
 trace:[24]f64;polynomial:f64=0;for back:0..<24 {k:=23-back;sign:=ifx k%2==0 then 1.0 else -1.0;polynomial=sign/f64(2*k+1)+(z*z)*polynomial;trace[back]=polynomial;}return trace;
}
#test "Panda pose every frozen Horner stage and dense equality operand remains observable" {
 trace:=ppo_atan_trace(0);for back:0..<24 {k:=23-back;#assert trace[back]==(ifx k%2==0 then 1.0 else -1.0)/f64(2*k+1);}
 q:=[4]f64.[0.1,0.2,0.3,0.4];#assert ppo_identical(q,q);for i:0..<4 {b:=q;b[i]+=0.01;#assert !ppo_identical(q,b);}
 canonical:=ppo_canonical([4]f64.[-0.0,1,0,0]);for i:0..<4 {#assert f64_bits(canonical[i])==f64_bits(ifx i==1 then 1.0 else 0.0);}
}
#test "Panda pose public rotation bridge preserves all dense current target and result coefficients" {
 current:=ppo_canonical([4]f64.[0.25,0.5,0.75,1]);axis:=[3]f64.[1/sqrt(14.0),2/sqrt(14.0),3/sqrt(14.0)];theta:f64=0.7;delta:=[4]f64.[cos(theta/2),axis[0]*sin(theta/2),axis[1]*sin(theta/2),axis[2]*sin(theta/2)];target:=pfk_multiply(delta,current);out:[1]PpoRotation;
 #assert ppo_rotation_raw(current[..],target[..],out[..])==PpoStatus.ok;for i:0..<3 {#assert abs(out[0].vector[i].value-axis[i]*theta)<2e-12;}#assert abs(out[0].angle.value-theta)<2e-12;
}
