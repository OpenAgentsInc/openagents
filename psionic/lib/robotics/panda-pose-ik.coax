// Exactly ONE position+principal-orientation geometric DLS candidate.
// No whole pose solve/convergence, nullspace, collision or R14 claim.
#load "panda-pose-ik-math.coax";
#load "panda-jacobian.coax";
#authority;
#test "Panda pose one admitted zero-error update retains source home and reports every zero diagnostic" {
 q:=pik_home();fk:[1]PfkOutput;#assert pfk_forward(q[..],fk[..])==PfkStatus.ok;t:[1]PpoTarget;t[0].position=fk[0].grip.position;t[0].world_from_grip_wxyz=fk[0].grip.quaternion;out:[1]PpoOutput;
 #assert ppo_step(q[..],t[..],out[..])==PpoStatus.ok && out[0].updates==1 && out[0].projected_coordinates==0;
 for i:0..<7 {#assert out[0].angles[i].value==q[i].value;}#assert out[0].position_error_metres==0 && out[0].orientation_error.value==0 && out[0].weighted_error_metres==0;
 raw:[7]f64;for i:0..<7 {raw[i]=q[i].value;}xyz:=[3]f64.[t[0].position.x,t[0].position.y,t[0].position.z];other:[1]PpoOutput;#assert ppo_step_raw(raw[..],xyz[..],t[0].world_from_grip_wxyz[..],other[..])==PpoStatus.ok;ppo_same(out[0],other[0]);
}
#test "Panda pose checked target units and standalone angular rows use explicit radian basis" {
 one:pfku.Quantity(pfku.Radian,f64);one.value=1;jp:pfku.Quantity(UnitQuotient(pfku.Metre,pfku.Radian),f64);jp.value=2;jr:pfku.Quantity(UnitOne,f64);jr.value=3;
 position:=convert_unit(pfku.Metre,jp*one);orientation:=convert_unit(pfku.Metre,ppo_weight()*(jr*one));angle:pfku.Quantity(pfku.Radian,f64);angle.value=2;weighted:=convert_unit(pfku.Metre,ppo_weight()*angle);
 #assert position.value==2 && orientation.value==0.75 && weighted.value==0.5;
}
#test "Panda pose every shape domain and quaternion refusal preserves full output" {
 q:=pik_home();target:[2]PpoTarget;target[0].world_from_grip_wxyz[0]=1;out:=[2]PpoOutput.[ppo_poison(),ppo_poison()];old:=out[0];
 #assert ppo_step(q[0..<6],target[0..<1],out[0..<1])==PpoStatus.shape && ppo_step(q[..],target[0..<0],out[0..<1])==PpoStatus.shape && ppo_step(q[..],target[..],out[0..<1])==PpoStatus.shape && ppo_step(q[..],target[0..<1],out[0..<0])==PpoStatus.shape && ppo_step(q[..],target[0..<1],out[..])==PpoStatus.shape;
 q[0].value=3;#assert ppo_step(q[..],target[0..<1],out[0..<1])==PpoStatus.limits;q=pik_home();
 for axis:0..<3 {target[0].position.x=0;target[0].position.y=0;target[0].position.z=0;if axis==0 {target[0].position.x=11;}if axis==1 {target[0].position.y=11;}if axis==2 {target[0].position.z=11;}#assert ppo_step(q[..],target[0..<1],out[0..<1])==PpoStatus.range;}
 target[0].position.z=0;target[0].world_from_grip_wxyz[0]=0;#assert ppo_step(q[..],target[0..<1],out[0..<1])==PpoStatus.rotation;target[0].world_from_grip_wxyz[0]=2.1;#assert ppo_step(q[..],target[0..<1],out[0..<1])==PpoStatus.range;ppo_same(out[0],old);ppo_same(out[1],old);
 raw:[7]f64;xyz:[4]f64;quat:=[5]f64.[1,0,0,0,0];#assert ppo_step_raw(raw[0..<6],xyz[0..<3],quat[0..<4],out[0..<1])==PpoStatus.shape && ppo_step_raw(raw[..],xyz[..],quat[0..<4],out[0..<1])==PpoStatus.shape && ppo_step_raw(raw[..],xyz[0..<3],quat[..],out[0..<1])==PpoStatus.shape && ppo_step_raw(raw[..],xyz[0..<3],quat[0..<4],out[..])==PpoStatus.shape;
}
#test "Panda pose dense independent matrix Gaussian row28 observes all candidate pose and error fields" {
 input:=[14]f64.[-0.26070335378293363,0.4197829540218629,-0.17224976514367665,-2.7864034195561564,-0.17538875316188446,2.740753613038838,0.7788488675752366,-0.5250789228078325,-0.11265799954996873,0.8947516665468195,-0.16060863355553037,0.7705457766950156,0.5952945116922437,-0.16151940191194944];q:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {q[i].value=input[i];}t:[1]PpoTarget;t[0].position.x=input[7];t[0].position.y=input[8];t[0].position.z=input[9];for i:0..<4 {t[0].world_from_grip_wxyz[i]=input[10+i];}out:[1]PpoOutput;
 #assert ppo_step(q[..],t[..],out[..])==PpoStatus.ok && out[0].updates==1 && out[0].projected_coordinates==0;
 expected:=[7]f64.[-0.24645310784144053,0.40515373240152075,-0.15101450667273245,-2.797568624049957,-0.1589868039633642,2.749403021932217,0.8022737156511386];for i:0..<7 {#assert abs(out[0].angles[i].value-expected[i])<2e-10;}
 #assert abs(out[0].position.x+0.5253406457302225)<2e-10 && abs(out[0].position.y+0.11299264751058398)<2e-10 && abs(out[0].position.z-0.8947094238253975)<2e-10;
 #assert abs(out[0].position_error_metres-0.0004269339447285114)<2e-10 && abs(out[0].orientation_error.value-0.0013878801998152472)<2e-10 && abs(out[0].weighted_error_metres-0.0005501461703278487)<2e-10;
 target_rotation:=pfk_matrix([4]f64.[0.16117161375649564,-0.7702373466162472,-0.5955540027577683,0.16147312654398607]);actual_rotation:=pfk_matrix(out[0].world_from_grip_wxyz);for i:0..<9 {#assert abs(target_rotation[i]-actual_rotation[i])<2e-12;}
 raw:[7]f64;for i:0..<7 {raw[i]=q[i].value;}xyz:=[3]f64.[input[7],input[8],input[9]];other:[1]PpoOutput;#assert ppo_step_raw(raw[..],xyz[..],t[0].world_from_grip_wxyz[..],other[..])==PpoStatus.ok;ppo_same(out[0],other[0]);
 for i:0..<4 {t[0].world_from_grip_wxyz[i]= -t[0].world_from_grip_wxyz[i];}#assert ppo_step(q[..],t[..],other[..])==PpoStatus.ok;ppo_same(out[0],other[0]);
}
#test "Panda pose source upper inward seed produces two reported coordinate projections" {
 hi:=pik_upper();target_q:[7]pfku.Quantity(pfku.Radian,f64);seed:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {target_q[i].value=hi[i];seed[i].value=hi[i]-0.01;}fk:[1]PfkOutput;#assert pfk_forward(target_q[..],fk[..])==PfkStatus.ok;t:[1]PpoTarget;t[0].position=fk[0].grip.position;t[0].world_from_grip_wxyz=fk[0].grip.quaternion;out:[1]PpoOutput;
 #assert ppo_step(seed[..],t[..],out[..])==PpoStatus.ok && out[0].projected_coordinates==2 && out[0].updates==1;
 for i:0..<7 {#assert out[0].angles[i].value<=hi[i];}
}

ppo_finish :: (angles:[7]pfku.Quantity(pfku.Radian,f64),pose:PfkPose,target:PpoTarget,projected:int)->PpoOutput {
 out:PpoOutput;out.angles=angles;out.position=pose.position;out.world_from_grip_wxyz=ppo_canonical(pose.quaternion);position_delta:=[3]f64.[target.position.x-pose.position.x,target.position.y-pose.position.y,target.position.z-pose.position.z];out.position_error_metres=ppo_norm3(position_delta);rotation:=ppo_error_owned(pose.quaternion,target.world_from_grip_wxyz);out.orientation_error=rotation.angle;weighted:=convert_unit(pfku.Metre,ppo_weight()*rotation.angle);out.weighted_error_metres=sqrt(out.position_error_metres*out.position_error_metres+weighted.value*weighted.value);out.updates=1;out.projected_coordinates=projected;return out;
}
ppo_step :: (seed:[]pfku.Quantity(pfku.Radian,f64),target:[]PpoTarget,output:[]PpoOutput)->PpoStatus #export_c {
 if seed.count!=7 || target.count!=1 || output.count!=1 {return PpoStatus.shape;}
 words:[10]u64;for i:0..<7 {words[i]=f64_bits(seed[i].value);}words[7]=f64_bits(target[0].position.x);words[8]=f64_bits(target[0].position.y);words[9]=f64_bits(target[0].position.z);status:=ppo_admit_position(words);if status!=PpoStatus.ok {return status;}
 qw:[4]u64;for i:0..<4 {qw[i]=f64_bits(target[0].world_from_grip_wxyz[i]);}status=ppo_unit_bits(qw);if status!=PpoStatus.ok {return status;}
 current:[1]PfkOutput;if pfk_forward(seed,current[..])!=PfkStatus.ok {return PpoStatus.solve;}j_owned:=pj_project_owned(current[0]);rotation:=ppo_error_owned(current[0].grip.quaternion,target[0].world_from_grip_wxyz);j:[42]f64;e:[6]f64;one_radian:pfku.Quantity(pfku.Radian,f64);one_radian.value=1;weight:=ppo_weight();
 for i:0..<21 {linear:=convert_unit(pfku.Metre,j_owned.linear[i]*one_radian);angular:=convert_unit(pfku.Metre,weight*(j_owned.angular[i]*one_radian));j[i]=linear.value;j[21+i]=angular.value;}
 e[0]=target[0].position.x-current[0].grip.position.x;e[1]=target[0].position.y-current[0].grip.position.y;e[2]=target[0].position.z-current[0].grip.position.z;for i:0..<3 {weighted:=convert_unit(pfku.Metre,weight*rotation.vector[i]);e[3+i]=weighted.value;}
 delta:=ppo_delta(j,e);if delta.status!=PpoStatus.ok {return delta.status;}lo:=pik_lower();hi:=pik_upper();angles:[7]pfku.Quantity(pfku.Radian,f64);projected:=0;
 for i:0..<7 {coefficient:pfku.Quantity(UnitOne,f64);coefficient.value=delta.radians[i];increment:=convert_unit(pfku.Radian,one_radian*coefficient);candidate:=seed[i]+increment;angles[i].value=pik_clip(candidate.value,lo[i],hi[i]);if pik_less(candidate.value,lo[i]) || pik_greater(candidate.value,hi[i]) {projected+=1;}}
 next:[1]PfkOutput;if pfk_forward(angles[..],next[..])!=PfkStatus.ok {return PpoStatus.solve;}fresh:=ppo_finish(angles,next[0].grip,target[0],projected);output[0]=fresh;return PpoStatus.ok;
}
ppo_step_raw :: (seed:[]f64,target_xyz:[]f64,target_wxyz:[]f64,output:[]PpoOutput)->PpoStatus #export_c {
 if seed.count!=7 || target_xyz.count!=3 || target_wxyz.count!=4 || output.count!=1 {return PpoStatus.shape;}
 q:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {q[i].value=seed[i];}target:[1]PpoTarget;target[0].position.x=target_xyz[0];target[0].position.y=target_xyz[1];target[0].position.z=target_xyz[2];for i:0..<4 {target[0].world_from_grip_wxyz[i]=target_wxyz[i];}return ppo_step(q[..],target[..],output);
}
