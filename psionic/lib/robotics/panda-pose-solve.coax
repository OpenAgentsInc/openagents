// Both position and principal orientation must satisfy their own tolerances.
// Finite iteration policy, not a compiler-proven #bounded or collision policy.
#load "panda-pose-solve-fixtures.coax";
#authority;

#test "Panda whole pose inclusive typed tolerances require both coordinates" {
 p:pfku.Quantity(pfku.Metre,f64);a:pfku.Quantity(pfku.Radian,f64);
 for i:0..<5 {for j:0..<5 {p.value=f64(i)*0.5e-6;a.value=f64(j)*0.5e-6;#assert pps_reached(p,a)==(i<=2 && j<=2);}}
 p.value=1e-6;a.value=1e-6;#assert pps_reached(p,a);p.value=1.1e-6;#assert !pps_reached(p,a);p.value=0;a.value=1.1e-6;#assert !pps_reached(p,a);
}
#test "Panda whole pose matched fresh goal admits zero work at both budget bounds" {
 q:=pik_home();target:=[1]PpoTarget.[pps_goal(q)];out:[1]PpsOutput;
 #assert pps_solve(q[..],target[..],0,out[..])==PpsStatus.ok && out[0].updates==0 && out[0].projected_coordinates==0;
 for i:0..<7 {#assert out[0].angles[i].value==q[i].value;}#assert out[0].position_error_metres==0 && out[0].orientation_error.value==0 && out[0].weighted_error_metres==0;
 before:=out[0];#assert pps_solve(q[..],target[..],96,out[..])==PpsStatus.ok;pps_same(before,out[0]);
 raw:[7]f64;for i:0..<7 {raw[i]=q[i].value;}xyz:=[3]f64.[target[0].position.x,target[0].position.y,target[0].position.z];#assert pps_solve_raw(raw[..],xyz[..],target[0].world_from_grip_wxyz[..],0,out[..])==PpsStatus.ok;pps_same(before,out[0]);
}
#test "Panda whole pose shapes budgets and geometry refusals retain complete output" {
 q:=pik_home();target:=[2]PpoTarget.[pps_goal(q),pps_goal(q)];out:=[2]PpsOutput.[pps_poison(),pps_poison()];before:=out[0];
 #assert pps_solve(q[0..<6],target[0..<1],0,out[0..<1])==PpsStatus.shape && pps_solve(q[..],target[0..<0],0,out[0..<1])==PpsStatus.shape && pps_solve(q[..],target[..],0,out[0..<1])==PpsStatus.shape && pps_solve(q[..],target[0..<1],0,out[0..<0])==PpsStatus.shape && pps_solve(q[..],target[0..<1],0,out[..])==PpsStatus.shape;
 #assert pps_solve(q[..],target[0..<1],-1,out[0..<1])==PpsStatus.range && pps_solve(q[..],target[0..<1],97,out[0..<1])==PpsStatus.range;
 q[0].value=3;#assert pps_solve(q[..],target[0..<1],0,out[0..<1])==PpsStatus.limits;q=pik_home();target[0].position.x=11;#assert pps_solve(q[..],target[0..<1],0,out[0..<1])==PpsStatus.range;target[0]=pps_goal(q);target[0].world_from_grip_wxyz=[4]f64.[0,0,0,0];#assert pps_solve(q[..],target[0..<1],0,out[0..<1])==PpsStatus.rotation;pps_same(out[0],before);pps_same(out[1],before);
 raw:[7]f64;xyz:[4]f64;quat:[5]f64;#assert pps_solve_raw(raw[0..<6],xyz[0..<3],quat[0..<4],0,out[0..<1])==PpsStatus.shape && pps_solve_raw(raw[..],xyz[..],quat[0..<4],0,out[0..<1])==PpsStatus.shape && pps_solve_raw(raw[..],xyz[0..<3],quat[..],0,out[0..<1])==PpsStatus.shape && pps_solve_raw(raw[..],xyz[0..<3],quat[0..<4],0,out[..])==PpsStatus.shape;pps_same(out[0],before);
}
#test "Panda whole pose zero budget refuses when just one goal coordinate fails" {
 q:=pik_home();goal:=pps_goal(q);target:=[1]PpoTarget.[goal];out:=[1]PpsOutput.[pps_poison()];before:=out[0];
 target[0].position.x+=1.2e-6;#assert pps_solve(q[..],target[..],0,out[..])==PpsStatus.not_converged;pps_same(out[0],before);
 target[0]=goal;delta:=[4]f64.[cos(0.6e-6),sin(0.6e-6),0,0];target[0].world_from_grip_wxyz=pfk_multiply(delta,goal.world_from_grip_wxyz);#assert pps_solve(q[..],target[..],0,out[..])==PpsStatus.not_converged;pps_same(out[0],before);
 target[0]=goal;target[0].position.x+=0.8e-6;delta=[4]f64.[cos(0.4e-6),sin(0.4e-6),0,0];target[0].world_from_grip_wxyz=pfk_multiply(delta,goal.world_from_grip_wxyz);#assert pps_solve(q[..],target[..],0,out[..])==PpsStatus.ok && out[0].updates==0 && out[0].position_error_metres>0 && out[0].orientation_error.value>0;
}
#test "Panda whole pose staging maps legacy status without changing published status identity" {
 for i:0..<7 {#assert cast(int)pps_status(cast(PpoStatus)i)==i;}
 q:=pik_home();q[0].value=101;t:PpoTarget;#assert pps_walk(q,t,0).status==PpsStatus.solve;
}

#test "Panda whole pose trusted staged legacy step failure cannot counterfeit success" {
 q:=pik_home();target:=pps_goal(q);q[0].value=3;run:=pps_walk(q,target,1);#assert run.status==PpsStatus.limits && run.candidate.updates==0;
}

#test "Panda whole pose independent dense Gaussian trajectory observes every published field and exact stop" {
 x:=pps_fixture([14]f64.[-0.43,-0.17,0.52,-1.87,-0.61,1.43,-0.82,-0.3312488088297923,-0.02236227277159756,1.1949403501120703,0.3087793425683993,0.26307588076182686,-0.9008416321384713,0.15469567663807282]);out:=[1]PpsOutput.[pps_poison()];before:=out[0];
 #assert pps_solve(x.seed[..],x.target[..],8,out[..])==PpsStatus.not_converged;pps_same(out[0],before);
 #assert pps_solve(x.seed[..],x.target[..],9,out[..])==PpsStatus.ok && out[0].updates==9 && out[0].projected_coordinates==0;
 expected:=[17]f64.[-0.37986142675079454,0.022116456985340677,0.5110876419926416,-2.1796255603744763,-0.3936560855714113,1.5881769710542475,-1.086359861256274,-0.3312488344188279,-0.02236228067898783,1.1949403469449846,0.3087792784197639,0.2630759067866602,-0.900841647334479,0.15469567193250272,2.69695383040888e-08,1.4206196386675867e-07,4.459491108793388e-08];for i:0..<7 {#assert abs(out[0].angles[i].value-expected[i])<=2e-10;}
 #assert abs(out[0].position.x-expected[7])<=2e-10 && abs(out[0].position.y-expected[8])<=2e-10 && abs(out[0].position.z-expected[9])<=2e-10;
 expected_rotation:=pfk_matrix([4]f64.[expected[10],expected[11],expected[12],expected[13]]);actual_rotation:=pfk_matrix(out[0].world_from_grip_wxyz);for i:0..<9 {#assert abs(actual_rotation[i]-expected_rotation[i])<=2e-10;}
 #assert abs(out[0].position_error_metres-expected[14])<=2e-10 && abs(out[0].orientation_error.value-expected[15])<=2e-10 && abs(out[0].weighted_error_metres-expected[16])<=2e-10;
 other:[1]PpsOutput;raw:[7]f64;for i:0..<7 {raw[i]=x.seed[i].value;}xyz:=[3]f64.[x.target[0].position.x,x.target[0].position.y,x.target[0].position.z];#assert pps_solve_raw(raw[..],xyz[..],x.target[0].world_from_grip_wxyz[..],9,other[..])==PpsStatus.ok;pps_same(other[0],out[0]);
 for i:0..<4 {x.target[0].world_from_grip_wxyz[i]= -x.target[0].world_from_grip_wxyz[i];}#assert pps_solve(x.seed[..],x.target[..],9,other[..])==PpsStatus.ok;pps_same(out[0],other[0]);
}
#test "Panda whole pose independent active-limit stages accumulate projections and publish only convergence" {
 x:=pps_fixture([14]f64.[2.8923,1.7578,2.8923,-0.0748,2.8923,3.7475,2.8923,-1.5801328370801704,0.10695667726501362,1.2874706460974301,0.8365317804438452,0.016288267468630914,-0.5466624485649972,0.03330825692290898]);a:=pps_walk(x.seed,x.target[0],1);b:=pps_walk(x.seed,x.target[0],2);#assert a.status==PpsStatus.not_converged && b.status==PpsStatus.not_converged && a.candidate.updates==1 && b.candidate.updates==2 && a.candidate.projected_coordinates==2 && b.candidate.projected_coordinates==5;
 one:=[7]f64.[2.89695749928328,1.7628,2.896791859408719,-0.07129911960606533,2.8971483549852226,3.751905868085993,2.8973];two:=[7]f64.[2.897170459761625,1.7628,2.8970243981737203,-0.0704553098650067,2.8973,3.7522975623492214,2.8973];for i:0..<7 {#assert abs(a.candidate.angles[i].value-one[i])<=2e-10 && abs(b.candidate.angles[i].value-two[i])<=2e-10;}
 out:=[1]PpsOutput.[pps_poison()];before:=out[0];#assert pps_solve(x.seed[..],x.target[..],12,out[..])==PpsStatus.not_converged;pps_same(out[0],before);#assert pps_solve(x.seed[..],x.target[..],13,out[..])==PpsStatus.ok && out[0].updates==13 && out[0].projected_coordinates==38 && out[0].position_error_metres<=1e-6 && out[0].orientation_error.value<=1e-6;
}

#test "Panda whole pose each world coordinate is admitted independently before iteration" {
 q:=pik_home();target:=[1]PpoTarget.[pps_goal(q)];out:=[1]PpsOutput.[pps_poison()];before:=out[0];
 for axis:0..<3 {target[0]=pps_goal(q);if axis==0 {target[0].position.x=11;}if axis==1 {target[0].position.y=11;}if axis==2 {target[0].position.z=11;}#assert pps_solve(q[..],target[..],0,out[..])==PpsStatus.range;pps_same(out[0],before);}
}

pps_reached :: (position:pfku.Quantity(pfku.Metre,f64),angle:pfku.Quantity(pfku.Radian,f64))->bool {return position.value<=1e-6 && angle.value<=1e-6;}
pps_satisfied :: (value:PpoOutput)->bool {p:pfku.Quantity(pfku.Metre,f64);p.value=value.position_error_metres;return pps_reached(p,value.orientation_error);}
pps_status :: (status:PpoStatus)->PpsStatus {return cast(PpsStatus)cast(u8)status;}
pps_pack :: (value:PpoOutput,updates:int,projected:int)->PpsOutput {
 out:PpsOutput;out.angles=value.angles;out.position=value.position;out.world_from_grip_wxyz=value.world_from_grip_wxyz;out.position_error_metres=value.position_error_metres;out.orientation_error=value.orientation_error;out.weighted_error_metres=value.weighted_error_metres;out.updates=updates;out.projected_coordinates=projected;return out;
}
// Trusted staged operator. Its POD carries diagnostics even on exhaustion;
// it is not an admission certificate and does not publish caller output.
pps_walk :: (seed:[7]pfku.Quantity(pfku.Radian,f64),target:PpoTarget,max_updates:int)->PpsWalk {
 out:PpsWalk;out.status=PpsStatus.not_converged;q:=seed;fk:[1]PfkOutput;if pfk_forward(q[..],fk[..])!=PfkStatus.ok {out.status=PpsStatus.solve;return out;}
 measured:=ppo_finish(seed,fk[0].grip,target,0);out.candidate=pps_pack(measured,0,measured.projected_coordinates);if pps_satisfied(measured) {out.status=PpsStatus.ok;return out;}
 target_array:=[1]PpoTarget.[target];projected:int=0;
 for update:0..<max_updates {
  next:[1]PpoOutput;status:=ppo_step(q[..],target_array[..],next[..]);if status!=PpoStatus.ok {out.status=pps_status(status);return out;}
  projected+=next[0].projected_coordinates;out.candidate=pps_pack(next[0],update+1,projected);
  if pps_satisfied(next[0]) {out.status=PpsStatus.ok;return out;}
  q=next[0].angles;
 }
 return out;
}
pps_solve :: (seed:[]pfku.Quantity(pfku.Radian,f64),target:[]PpoTarget,max_updates:int,output:[]PpsOutput)->PpsStatus #export_c {
 if seed.count!=7 || target.count!=1 || output.count!=1 {return PpsStatus.shape;}
 if max_updates<0 || max_updates>96 {return PpsStatus.range;}
 words:[10]u64;for i:0..<7 {words[i]=f64_bits(seed[i].value);}words[7]=f64_bits(target[0].position.x);words[8]=f64_bits(target[0].position.y);words[9]=f64_bits(target[0].position.z);admission:=ppo_admit_position(words);if admission!=PpoStatus.ok {return pps_status(admission);}
 quat:[4]u64;for i:0..<4 {quat[i]=f64_bits(target[0].world_from_grip_wxyz[i]);}admission=ppo_unit_bits(quat);if admission!=PpoStatus.ok {return pps_status(admission);}
 q:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {q[i]=seed[i];}run:=pps_walk(q,target[0],max_updates);if run.status!=PpsStatus.ok {return run.status;}output[0]=run.candidate;return PpsStatus.ok;
}
pps_solve_raw :: (seed:[]f64,target_xyz:[]f64,target_wxyz:[]f64,max_updates:int,output:[]PpsOutput)->PpsStatus #export_c {
 if seed.count!=7 || target_xyz.count!=3 || target_wxyz.count!=4 || output.count!=1 {return PpsStatus.shape;}
 q:[7]pfku.Quantity(pfku.Radian,f64);for i:0..<7 {q[i].value=seed[i];}target:[1]PpoTarget;target[0].position.x=target_xyz[0];target[0].position.y=target_xyz[1];target[0].position.z=target_xyz[2];for i:0..<4 {target[0].world_from_grip_wxyz[i]=target_wxyz[i];}return pps_solve(q[..],target[..],max_updates,output);
}
