// Explicit first-shadow selection. SDK telemetry/robotstate remain required
// effects; only selected mathematical sample is admitted. No SDK fallback.
#load "panda-query-source-fixtures.coax";
#authority;
#test "query source every SDK telemetry controller field maps independent indexes" {
 w:[173]u64;for i:0..<173 {w[i]=f64_bits(f64(i)+0.25);}s:=pqs_sdk(w[..]);
 for i:0..<3 {#assert s.position[i]==f64(106+i)+0.25;}for i:0..<9 {#assert s.rotation[i]==f64(109+i)+0.25;}
 for i:0..<7 {#assert s.q[i]==f64(1+i)+0.25 && s.qd[i]==f64(8+i)+0.25 && s.bias[i]==f64(134+i)+0.25 && s.lower[i]==f64(141+i)+0.25 && s.upper[i]==f64(148+i)+0.25;}
 for i:0..<49 {#assert s.mass[i]==f64(15+i)+0.25;}for i:0..<21 {#assert s.jp[i]==f64(64+i)+0.25 && s.jr[i]==f64(85+i)+0.25;}for i:0..<6 {#assert s.velocity[i]==f64(118+i)+0.25;}
}
#test "query source shape mode and effects refuse before decode and preserve all output" {
 w:=pqs_fixture();q:[9]u64;v:[9]u64;out:=[2]PcSample.[pcs_poison(),pcs_poison()];old:=out[0];w[0]=0x7ff8000000000001;
 #assert pqs_select(9,w[0..<172],q[..],v[..],1,1,out[0..<1]).code==PqsCode.shape;
 #assert pqs_select(9,w[..],q[0..<8],v[..],1,1,out[0..<1]).code==PqsCode.shape;
 #assert pqs_select(9,w[..],q[..],v[0..<8],1,1,out[0..<1]).code==PqsCode.shape;
 #assert pqs_select(9,w[..],q[..],v[..],1,1,out[..]).code==PqsCode.shape;
 #assert pqs_select(-1,w[..],q[..],v[..],1,1,out[0..<1]).code==PqsCode.kind && pqs_select(2,w[..],q[..],v[..],1,1,out[0..<1]).code==PqsCode.kind;
 #assert pqs_select(0,w[..],q[..],v[..],1,0,out[0..<1]).code==PqsCode.effect && pqs_select(1,w[..],q[..],v[..],0,1,out[0..<1]).code==PqsCode.effect;
 pcs_same(out[0],old);pcs_same(out[1],old);
}
#forall "query source every SDK bit lane rejects nonfinite and keeps poison" lane:0..<173 {
 w:=pqs_fixture();q:[9]u64;v:[9]u64;out:=[1]PcSample.[pcs_poison()];old:=out[0];w[lane]=0x7ff8000000000001;r:=pqs_select(0,w[..],q[..],v[..],0,0,out[..]);#assert r.code==PqsCode.number && r.detail==PcStatus.number;pcs_same(out[0],old);
}
#forall "query source every robot coordinate and rate rejects all nonfinite classes" lane:0..<9,rate:bool {
 for bad:[3]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001] {w:=pqs_fixture();q:[9]u64;v:[9]u64;out:=[1]PcSample.[pcs_poison()];if rate {v[lane]=bad;}else {q[lane]=bad;}r:=pqs_select(1,w[..],q[..],v[..],0,0,out[..]);#assert r.code==PqsCode.number && r.detail==PcStatus.number;pcs_same(out[0],pcs_poison());}
}
#test "query source SDK and owned selection admit only chosen math and never fallback" {
 w:=pqs_fixture();q:[9]u64;v:[9]u64;out:[1]PcSample;r:=pqs_select(0,w[..],q[..],v[..],0,0,out[..]);#assert r.code==PqsCode.ok && r.detail==PcStatus.ok;pcs_same(out[0],pc_fixture());
 q[0]=f64_bits(101.0);r=pqs_select(0,w[..],q[..],v[..],0,0,out[..]);#assert r.code==PqsCode.ok;
 old:=out[0];r=pqs_select(1,w[..],q[..],v[..],0,0,out[..]);#assert r.code==PqsCode.sample && r.detail==PcStatus.range;pcs_same(out[0],old);
 q[0]=0;w[109]=f64_bits(3.0);w[15]=f64_bits(-1.0);r=pqs_select(0,w[..],q[..],v[..],0,0,out[..]);#assert r.code==PqsCode.sample && r.detail==PcStatus.number;pcs_same(out[0],old);
 r=pqs_select(1,w[..],q[..],v[..],0,0,out[..]);#assert r.code==PqsCode.ok;expected:[1]PcSample;rawq:[9]f64;rawv:[9]f64;#assert pcs_forward_raw(rawq[..],rawv[..],expected[..])==PcStatus.ok;pcs_same(out[0],expected[0]);
 #assert pqs_name(0)=="panda-sdk-query-shadow-v1" && pqs_name(1)=="panda-owned-query-shadow-v1" && pqs_name(-1)=="" && pqs_name(2)=="";
}
#test "query source owned dense coordinates and rates preserve all eighteen bit transports" {
 w:=pqs_fixture();q:=[9]f64.[0.2,-0.3,0.4,-1.1,0.6,1.3,-0.7,0.013,-0.027];v:=[9]f64.[0.7,-0.6,0.5,-0.4,0.3,-0.2,0.1,0.03,-0.02];qb:[9]u64;vb:[9]u64;for i:0..<9 {qb[i]=f64_bits(q[i]);vb[i]=f64_bits(v[i]);}out:[1]PcSample;expected:[1]PcSample;
 r:=pqs_select(1,w[..],qb[..],vb[..],0,0,out[..]);#assert r.code==PqsCode.ok && r.detail==PcStatus.ok && pcs_forward_raw(q[..],v[..],expected[..])==PcStatus.ok;pcs_same(out[0],expected[0]);
}

pqs_finite :: (words:[]u64)->bool {for word:words {if !pfk_finite(word) {return false;}}return true;}
// Trusted fixed-layout helper, not an arbitrary telemetry/provenance gate.
pqs_sdk :: (w:[]u64)->PcSample {
 s:PcSample;for i:0..<3 {s.position[i]=f64_from_bits(w[106+i]);}for i:0..<9 {s.rotation[i]=f64_from_bits(w[109+i]);}
 for i:0..<7 {s.q[i]=f64_from_bits(w[1+i]);s.qd[i]=f64_from_bits(w[8+i]);s.bias[i]=f64_from_bits(w[134+i]);s.lower[i]=f64_from_bits(w[141+i]);s.upper[i]=f64_from_bits(w[148+i]);}
 for i:0..<49 {s.mass[i]=f64_from_bits(w[15+i]);}for i:0..<21 {s.jp[i]=f64_from_bits(w[64+i]);s.jr[i]=f64_from_bits(w[85+i]);}for i:0..<6 {s.velocity[i]=f64_from_bits(w[118+i]);}return s;
}
pqs_select :: (kind:int,sdk:[]u64,q:[]u64,v:[]u64,sdk_effect:int,robot_effect:int,output:[]PcSample)->PqsResult #export_c {
 if sdk.count!=173 || q.count!=9 || v.count!=9 || output.count!=1 {return PqsResult.{code=PqsCode.shape};}
 if kind<0 || kind>1 {return PqsResult.{code=PqsCode.kind};}if sdk_effect!=0 || robot_effect!=0 {return PqsResult.{code=PqsCode.effect};}
 if !pqs_finite(sdk) || !pqs_finite(q) || !pqs_finite(v) {return PqsResult.{code=PqsCode.number,detail=PcStatus.number};}
 fresh:PcSample;status:PcStatus;
 if kind==0 {fresh=pqs_sdk(sdk);status=pc_sample(fresh);}else {coordinates:[9]f64;rates:[9]f64;for i:0..<9 {coordinates[i]=f64_from_bits(q[i]);rates[i]=f64_from_bits(v[i]);}owned:[1]PcSample;status=pcs_forward_raw(coordinates[..],rates[..],owned[..]);fresh=owned[0];}
 if status!=PcStatus.ok {return PqsResult.{code=PqsCode.sample,detail=status};}output[0]=fresh;return PqsResult.{};
}
pqs_name :: (kind:int)->string #export_c {if kind==0 {return "panda-sdk-query-shadow-v1";}if kind==1 {return "panda-owned-query-shadow-v1";}return "";}
