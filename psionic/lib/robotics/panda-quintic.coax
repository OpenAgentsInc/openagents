// Checked source-bound rest-to-rest timing; no collision/tracking certificate.
#load "panda-quintic-math.coax";
#authority;
#test "Panda quintic public all shape and numeric refusals preserve complete timing and sample" {
 x:=pqt_fixture();t:=[2]PqtTiming.[pqt_timing_poison(),pqt_timing_poison()];s:=[2]PqtSample.[pqt_sample_poison(),pqt_sample_poison()];old:=t[0];before:=s[0];
 #assert pqt_time(x.q0[0..<6],x.q1[..],x.vlim[..],x.alim[..],t[0..<1])==PqtStatus.shape && pqt_time(x.q0[..],x.q1[0..<6],x.vlim[..],x.alim[..],t[0..<1])==PqtStatus.shape && pqt_time(x.q0[..],x.q1[..],x.vlim[0..<6],x.alim[..],t[0..<1])==PqtStatus.shape && pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[0..<6],t[0..<1])==PqtStatus.shape && pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[..])==PqtStatus.shape;
 #assert pqt_sample(x.q0[0..<6],x.q1[..],x.vlim[..],x.alim[..],0,s[0..<1])==PqtStatus.shape && pqt_sample(x.q0[..],x.q1[0..<6],x.vlim[..],x.alim[..],0,s[0..<1])==PqtStatus.shape && pqt_sample(x.q0[..],x.q1[..],x.vlim[0..<6],x.alim[..],0,s[0..<1])==PqtStatus.shape && pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[0..<6],0,s[0..<1])==PqtStatus.shape && pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],0,s[..])==PqtStatus.shape;
 x.q0[0].value=3;#assert pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[0..<1])==PqtStatus.limits && pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],0,s[0..<1])==PqtStatus.limits;x=pqt_fixture();x.q1=x.q0;x.vlim[0].value=0;#assert pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[0..<1])==PqtStatus.range && pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],0,s[0..<1])==PqtStatus.range;
 pqt_timing_same(t[0],old);pqt_timing_same(t[1],old);pqt_sample_same(s[0],before);pqt_sample_same(s[1],before);
}
#test "Panda quintic public timing tick and zero edge precedence never trusts caller timing" {
 x:=pqt_fixture();x.q1=x.q0;t:[1]PqtTiming;s:=[1]PqtSample.[pqt_sample_poison()];before:=s[0];#assert pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[..])==PqtStatus.ok && t[0].steps==0;#assert pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],1,s[..])==PqtStatus.range && pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],-1,s[..])==PqtStatus.range;pqt_sample_same(s[0],before);
 lo:=pik_lower();hi:=pik_upper();for i:0..<7 {x.q0[i].value=lo[i];x.q1[i].value=hi[i];x.vlim[i].value=0.001;x.alim[i].value=100;}#assert pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[..])==PqtStatus.duration && pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],-1,s[..])==PqtStatus.duration;pqt_sample_same(s[0],before);
}
#test "Panda quintic public independent velocity edge timing and midpoint match analytic values" {
 x:=pqt_fixture();x.q1[0].value=0.3;x.vlim[0].value=0.05;t:[1]PqtTiming;s:[1]PqtSample;#assert pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[..])==PqtStatus.ok && t[0].steps==5626 && t[0].total_nanoseconds==11252000000 && abs(t[0].duration.value-11.252)<2e-12 && abs(t[0].required_estimate.value-11.25)<2e-12;
 #assert pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],2813,s[..])==PqtStatus.ok && abs(s[0].angle[0].value-0.15)<2e-12 && abs(s[0].rate[0].value-0.04999111269107714)<2e-10 && s[0].acceleration[0].value==0;for i:1..<7 {#assert s[0].angle[i].value==x.q0[i].value && s[0].rate[i].value==0 && s[0].acceleration[i].value==0;}
}

#test "Panda quintic public raw adapters transport all four roles and preserve shape refusals" {
 x:=pqt_fixture();w:=pqt_words(x);values:[28]f64;for i:0..<28 {values[i]=f64_from_bits(w[i]);}t:[1]PqtTiming;other:[1]PqtTiming;s:[1]PqtSample;raw:[1]PqtSample;
 #assert pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[..])==PqtStatus.ok && pqt_time_raw(values[0..<7],values[7..<14],values[14..<21],values[21..<28],other[..])==PqtStatus.ok;pqt_timing_same(t[0],other[0]);#assert pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],117,s[..])==PqtStatus.ok && pqt_sample_raw(values[0..<7],values[7..<14],values[14..<21],values[21..<28],117,raw[..])==PqtStatus.ok;pqt_sample_same(s[0],raw[0]);
 before:=raw[0];old:=other[0];#assert pqt_time_raw(values[0..<6],values[7..<14],values[14..<21],values[21..<28],other[..])==PqtStatus.shape && pqt_time_raw(values[0..<7],values[7..<13],values[14..<21],values[21..<28],other[..])==PqtStatus.shape && pqt_time_raw(values[0..<7],values[7..<14],values[14..<20],values[21..<28],other[..])==PqtStatus.shape && pqt_time_raw(values[0..<7],values[7..<14],values[14..<21],values[21..<27],other[..])==PqtStatus.shape && pqt_time_raw(values[0..<7],values[7..<14],values[14..<21],values[21..<28],other[0..<0])==PqtStatus.shape;
 #assert pqt_sample_raw(values[0..<6],values[7..<14],values[14..<21],values[21..<28],117,raw[..])==PqtStatus.shape && pqt_sample_raw(values[0..<7],values[7..<13],values[14..<21],values[21..<28],117,raw[..])==PqtStatus.shape && pqt_sample_raw(values[0..<7],values[7..<14],values[14..<20],values[21..<28],117,raw[..])==PqtStatus.shape && pqt_sample_raw(values[0..<7],values[7..<14],values[14..<21],values[21..<27],117,raw[..])==PqtStatus.shape && pqt_sample_raw(values[0..<7],values[7..<14],values[14..<21],values[21..<28],117,raw[0..<0])==PqtStatus.shape;pqt_sample_same(raw[0],before);pqt_timing_same(other[0],old);
}

#test "Panda quintic public inclusive tick endpoints and numeric-zero target copies are exact" {
 x:=pqt_fixture();t:[1]PqtTiming;out:[1]PqtSample;#assert pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[..])==PqtStatus.ok;#assert pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],0,out[..])==PqtStatus.ok;for i:0..<7 {#assert f64_bits(out[0].angle[i].value)==f64_bits(x.q0[i].value) && f64_bits(out[0].rate[i].value)==0 && f64_bits(out[0].acceleration[i].value)==0;}
 #assert pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],t[0].steps,out[..])==PqtStatus.ok;for i:0..<7 {#assert f64_bits(out[0].angle[i].value)==f64_bits(x.q1[i].value) && f64_bits(out[0].rate[i].value)==0 && f64_bits(out[0].acceleration[i].value)==0;}
 x.q1=x.q0;x.q1[0].value=f64_from_bits(0x8000000000000000);#assert pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],0,out[..])==PqtStatus.ok && f64_bits(out[0].angle[0].value)==0x8000000000000000;
}

pqt_take :: (q0:[]pfku.Quantity(pfku.Radian,f64),q1:[]pfku.Quantity(pfku.Radian,f64),vlim:[]pfku.Quantity(PqtRate,f64),alim:[]pfku.Quantity(PqtAcceleration,f64))->PqtEdge {x:PqtEdge;for i:0..<7 {x.q0[i]=q0[i];x.q1[i]=q1[i];x.vlim[i]=vlim[i];x.alim[i]=alim[i];}return x;}
pqt_take_raw :: (q0:[]f64,q1:[]f64,vlim:[]f64,alim:[]f64)->PqtEdge {x:PqtEdge;for i:0..<7 {x.q0[i].value=q0[i];x.q1[i].value=q1[i];x.vlim[i].value=vlim[i];x.alim[i].value=alim[i];}return x;}
pqt_time :: (q0:[]pfku.Quantity(pfku.Radian,f64),q1:[]pfku.Quantity(pfku.Radian,f64),vlim:[]pfku.Quantity(PqtRate,f64),alim:[]pfku.Quantity(PqtAcceleration,f64),output:[]PqtTiming)->PqtStatus #export_c {if q0.count!=7 || q1.count!=7 || vlim.count!=7 || alim.count!=7 || output.count!=1 {return PqtStatus.shape;}x:=pqt_take(q0,q1,vlim,alim);status:=pqt_admit(pqt_words(x));if status!=PqtStatus.ok {return status;}plan:=pqt_plan_owned(x);if plan.status!=PqtStatus.ok {return plan.status;}output[0]=plan.timing;return PqtStatus.ok;}
pqt_sample :: (q0:[]pfku.Quantity(pfku.Radian,f64),q1:[]pfku.Quantity(pfku.Radian,f64),vlim:[]pfku.Quantity(PqtRate,f64),alim:[]pfku.Quantity(PqtAcceleration,f64),tick:int,output:[]PqtSample)->PqtStatus #export_c {if q0.count!=7 || q1.count!=7 || vlim.count!=7 || alim.count!=7 || output.count!=1 {return PqtStatus.shape;}x:=pqt_take(q0,q1,vlim,alim);status:=pqt_admit(pqt_words(x));if status!=PqtStatus.ok {return status;}plan:=pqt_plan_owned(x);if plan.status!=PqtStatus.ok {return plan.status;}if tick<0 || tick>plan.timing.steps {return PqtStatus.range;}candidate:=pqt_sample_owned(x,plan.timing,tick);output[0]=candidate;return PqtStatus.ok;}
pqt_time_raw :: (q0:[]f64,q1:[]f64,vlim:[]f64,alim:[]f64,output:[]PqtTiming)->PqtStatus #export_c {if q0.count!=7 || q1.count!=7 || vlim.count!=7 || alim.count!=7 || output.count!=1 {return PqtStatus.shape;}x:=pqt_take_raw(q0,q1,vlim,alim);return pqt_time(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],output);}
pqt_sample_raw :: (q0:[]f64,q1:[]f64,vlim:[]f64,alim:[]f64,tick:int,output:[]PqtSample)->PqtStatus #export_c {if q0.count!=7 || q1.count!=7 || vlim.count!=7 || alim.count!=7 || output.count!=1 {return PqtStatus.shape;}x:=pqt_take_raw(q0,q1,vlim,alim);return pqt_sample(x.q0[..],x.q1[..],x.vlim[..],x.alim[..],tick,output);}
