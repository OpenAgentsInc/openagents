#load "rotor-pd-types.coax";
rpd_fixture :: ()->RpdParams {p:RpdParams;p.inertia.value=1;p.physical_damping.value=2;p.kp.value=4;p.kd.value=1;p.step.value=0.5;return p;}
rpd_poison :: ()->RpdOutput {x:RpdOutput;x.state.error.value=1001;x.state.rate.value=1003;x.effective_acceleration.value=1009;return x;}
rpd_same :: (a:RpdOutput,b:RpdOutput) {#assert f64_bits(a.state.error.value)==f64_bits(b.state.error.value) && f64_bits(a.state.rate.value)==f64_bits(b.state.rate.value) && f64_bits(a.effective_acceleration.value)==f64_bits(b.effective_acceleration.value);}
rpd_analysis_poison :: ()->RpdAnalysis {a:RpdAnalysis;a.effective_inertia.value=101;a.alpha.value=103;a.beta.value=107;for i:0..<4 {a.transition[i].value=109+f64(i);}a.natural_inverse_seconds.value=127;a.zeta.value=131;a.trace.value=137;a.algebraic_determinant.value=139;a.jury_damping.value=149;a.jury_margin.value=151;a.strict_stable=157;a.classification=163;return a;}
rpd_analysis_same :: (a:RpdAnalysis,b:RpdAnalysis) {#assert f64_bits(a.effective_inertia.value)==f64_bits(b.effective_inertia.value) && f64_bits(a.alpha.value)==f64_bits(b.alpha.value) && f64_bits(a.beta.value)==f64_bits(b.beta.value);for i:0..<4 {#assert f64_bits(a.transition[i].value)==f64_bits(b.transition[i].value);}#assert f64_bits(a.natural_inverse_seconds.value)==f64_bits(b.natural_inverse_seconds.value) && f64_bits(a.zeta.value)==f64_bits(b.zeta.value) && f64_bits(a.trace.value)==f64_bits(b.trace.value) && f64_bits(a.algebraic_determinant.value)==f64_bits(b.algebraic_determinant.value) && f64_bits(a.jury_damping.value)==f64_bits(b.jury_damping.value) && f64_bits(a.jury_margin.value)==f64_bits(b.jury_margin.value) && a.strict_stable==b.strict_stable && a.classification==b.classification;}
