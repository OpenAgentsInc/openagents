#test "SLR1 is exact framed and restores only a verified replay of the current source" {
 r:[1]RsrRun;r[0]=rsr_fixture();b:[RSW_MAX]u8;size:=rsw_size(r[0].count);#assert rsw_write(r[..],b[0..<size]);out:[1]RsrRun;#assert rsw_read(b[0..<size],r[0].start.config,out[..]);
 same:[RSW_MAX]u8;#assert rsw_write(out[..],same[0..<size]);for i:0..<size {#assert b[i]==same[i];}
 before:=out[0].trace;for at:[12]int.[0,4,8,12,16,48,80,112,424,584,896,1056] {bad:=b;bad[at]^=1;#assert !rsw_read(bad[0..<size],r[0].start.config,out[..]) && slw_same(before,out[0].trace);}
 #assert !rsw_read(b[0..<size-1],r[0].start.config,out[..]) && !rsw_read(b[0..<size+1],r[0].start.config,out[..]);
 wrong:=r[0].start.config;wrong.model[0]^=1;#assert !rsw_read(b[0..<size],wrong,out[..]);
}
#test "complete snapshot byte offsets queue words cursor and refusal are independently observed" {
 c:=rsl_fixture();c.p.delay=16;a:RsaSnapshot;a.params=c.p;a.position.value=0.01;a.rate.value= -0.02;a.output_position.value=0.009;a.cursor=15;a.steps=7;for i:0..<16 {a.pending[i].value=cast(f64)(i+1)*0.001;}
 b:[160]u8;rsw_snapshot_write(a,b[..]);#assert cb_load_le64(b[..],0).value==f64_bits(0.01) && cb_load_le64(b[..],8).value==f64_bits(-0.02) && cb_load_le64(b[..],16).value==f64_bits(0.009);
 for i:0..<16 {#assert cb_load_le64(b[..],24+i*8).value==f64_bits(cast(f64)(i+1)*0.001);}#assert cb_load_le32(b[..],152).value==15 && cb_load_le32(b[..],156).value==7;
 out:[1]RsaSnapshot;#assert rsw_snapshot_read(b[..],c.p,out[..]) && rsr_snapshot_same(a,out[0],c);
 #assert !rsw_snapshot_read(b[0..<159],c.p,out[..]) && !rsw_snapshot_read(b[..],c.p,out[0..<0]);
 for i:0..<19 {bad:=b;_:=cb_store_le64(bad[..],i*8,0x7ff8000000000001);#assert !rsw_snapshot_read(bad[..],c.p,out[..]) && out[0].cursor==15;}
 bad:=b;_:=cb_store_le32(bad[..],152,16);#assert !rsw_snapshot_read(bad[..],c.p,out[..]);
}
#test "inner packet queue command and trace admission is tested after an attacker reseals bytes" {
 r:[1]RsrRun;r[0]=rsr_fixture();b:[RSW_MAX]u8;size:=rsw_size(r[0].count);#assert rsw_write(r[..],b[0..<size]);out:[1]RsrRun;out[0]=r[0];
 for at:[16]int.[0,4,8,12,16,80,112,224,328,424,576,584,696,800,1048,1056] {bad:=b;bad[at]^=128;rsw_reseal(bad[0..<size]);#assert !rsw_read(bad[0..<size],r[0].start.config,out[..]) && slw_same(out[0].trace,r[0].trace);}
 for at:[2]int.[424,896] {for i:0..<19 {bad:=b;_:=cb_store_le64(bad[..],at+i*8,0x7ff0000000000000);rsw_reseal(bad[0..<size]);#assert !rsw_read(bad[0..<size],r[0].start.config,out[..]);}}
 bad:=b;_:=cb_store_le64(bad[..],1060,0x7ff8000000000001);rsw_reseal(bad[0..<size]);#assert !rsw_read(bad[0..<size],r[0].start.config,out[..]);
 for field:0..<3 {wrong:=r[0].start.config;if field==0 {wrong.model[31]^=1;}if field==1 {wrong.assembly[31]^=1;}if field==2 {wrong.topology[31]^=1;}#assert !rsw_read(b[0..<size],wrong,out[..]);}
 #assert !rsw_read(b[0..<size],r[0].start.config,out[0..<0]) && !rsw_write(r[0..<0],b[0..<size]) && !rsw_write(r[..],b[0..<size-1]);
 #assert !rsw_write(r[..],b[0..<size+1]);
 badrun:=r;badrun[0].finish.row.position=0.7;b[0]=77;#assert !rsw_write(badrun[..],b[0..<size]) && b[0]==77;
}
#test "a full nonzero initial queue and two nonzero command ticks survive the complete file path" {
 c:=rsl_fixture();c.p.delay=16;a:RsaSnapshot;a.params=c.p;a.position.value=0.01;a.rate.value= -0.02;a.output_position.value=0.009;a.cursor=15;a.steps=7;for i:0..<16 {a.pending[i].value=cast(f64)(i+1)*0.001;}
 s:[1]RslSession;#assert rsr_seed(c,1,a,s[..]);commands:=[2]RsrCommand.[RsrCommand.{tick=8,target= -0.1},RsrCommand.{tick=10,target=0.07}];
 for tick:7..<19 {for command:commands {if command.tick==tick {#assert rsl_target(s[..],command.target,s[0].revision)==RslStatus.ok;}}#assert rsl_tick(s[..])==RslStatus.ok;}
 r:[1]RsrRun;parent:[32]u8;parent[31]=91;#assert rsr_capture(c,1,a,s[0],commands[..],0,parent,r[..]);b:[1112]u8;#assert rsw_write(r[..],b[..]);#assert cb_load_le32(b[..],576).value==15 && cb_load_le32(b[..],580).value==7 && cb_load_le32(b[..],1056).value==8 && cb_load_le32(b[..],1068).value==10;
 out:[1]RsrRun;#assert rsw_read(b[..],c,out[..]) && rsr_snapshot_same(out[0].initial,a,c);again:[1112]u8;#assert rsw_write(out[..],again[..]);for i:0..<1112 {#assert b[i]==again[i];}
}
#test "minimum maximum framing parent words and command stride round trip exactly" {
 for n:[4]int.[-1,0,32,33] {#assert rsw_size(n)==(ifx n<0 || n>32 then 0 else 1088+n*12);}
 for count:[2]int.[0,32] {c:=rsl_fixture();s:[1]RslSession;#assert rsl_begin(c,1,s[..])==RslStatus.ok;initial:=s[0].snapshot;commands:[32]RsrCommand;for i:0..<count {commands[i].target=0.1;#assert rsl_target(s[..],0.1,s[0].revision)==RslStatus.ok;}
  parent:[32]u8;for i:0..<32 {parent[i]=cast(u8)(i+7);}r:[1]RsrRun;#assert rsr_capture(c,1,initial,s[0],commands[0..<count],3,parent,r[..]);b:[RSW_MAX]u8;size:=rsw_size(count);#assert rsw_write(r[..],b[0..<size]);out:[1]RsrRun;#assert rsw_read(b[0..<size],c,out[..]) && out[0].reason==3 && slw_same(out[0].parent,parent);
  for i:0..<count {#assert cb_load_le32(b[..],1056+i*12).value==0 && cb_load_le64(b[..],1060+i*12).value==f64_bits(0.1);}
 }
}
rsw_reseal :: (b:[]u8) {id:=rsw_identity(b[0..<b.count-32]);for v,i:id {b[b.count-32+i]=v;}}

