#load "running-stats-fixtures.coax";
#test "running statistics raw numeric pairs check both fields before conversion" {
  #assert rn_numbers(0,0) && rn_numbers(0x8000000000000000,0x7fefffffffffffff);
  for bits:[5]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001,0x7ff0000000000001,0xfff8000000000001] {#assert !rn_numbers(bits,0) && !rn_numbers(0,bits);}
}
#test "running statistics independent two-pass moments and normalization expose every channel" {
  s:[1]RnSnapshot;o:[1]RnSnapshot;#assert rn_begin(3,s[..])==RnStatus.ok;
  rows:=[9]f64.[1,2,3,2,4,4,3,6,5];#assert rn_push(s[0],3,rows[..],o[..])==RnStatus.ok;
  for i:0..<3 {#assert o[0].moments[i].count==3 && o[0].moments[i].mean==RN_GOLDEN_MEAN[i] && o[0].moments[i].m2==RN_GOLDEN_M2[i];}
  x:=[3]f64.[4,0,-1];normalized:[3]f64;#assert rn_apply(o[0],x[..],normalized[..])==RnStatus.ok;
  for i:0..<3 {#assert abs(normalized[i]-RN_GOLDEN_NORMALIZED[i])<=2e-13+2e-13*abs(RN_GOLDEN_NORMALIZED[i]);}
  #assert rn_apply(s[0],x[..],normalized[..])==RnStatus.ok;for i:0..<3 {#assert normalized[i]==x[i];}
  // Sequential streaming preserves the declared row order and all bits.
  for i:0..<3 {#assert rn_push(s[0],1,rows[i*3..<i*3+3],s[..])==RnStatus.ok;}rn_same(s[0],o[0]);
}
#test "running statistics constant inputs use population variance and explicit epsilon" {
  s:[1]RnSnapshot;#assert rn_begin(1,s[..])==RnStatus.ok;x:=[3]f64.[5,5,5];#assert rn_push(s[0],3,x[..],s[..])==RnStatus.ok;
  out:[1]f64;#assert rn_apply(s[0],x[0..<1],out[..])==RnStatus.ok && out[0]==0;
  x[0]=6;#assert rn_apply(s[0],x[0..<1],out[..])==RnStatus.ok && out[0]==10000;
  #assert rn_begin(1,s[..])==RnStatus.ok;one:=[1]f64.[5];#assert rn_push(s[0],1,one[..],s[..])==RnStatus.ok && rn_apply(s[0],x[0..<1],out[..])==RnStatus.ok && out[0]==10000;
  #assert rn_begin(1,s[..])==RnStatus.ok;for endpoint:[2]f64.[-1000000,1000000] {one[0]=endpoint;#assert rn_apply(s[0],one[..],out[..])==RnStatus.ok && out[0]==endpoint;}
}
#test "running statistics snapshot shape count coherence empty-state and inactive fields are checked" {
  s:[1]RnSnapshot;#assert rn_begin(1,s[..])==RnStatus.ok;
  for channels:[3]int.[-1,0,65] {bad:=s[0];bad.channels=channels;#assert rn_check(bad)==RnStatus.shape;}
  for count:[2]int.[-1,1000000001] {bad:=s[0];bad.moments[0].count=count;#assert rn_check(bad)==RnStatus.range;}
  bad:=s[0];bad.moments[0].mean=0.125;#assert rn_check(bad)==RnStatus.state;bad=s[0];bad.moments[0].m2=0.125;#assert rn_check(bad)==RnStatus.range;
  bad=s[0];bad.moments[0].count=1;bad.moments[0].m2=0.125;#assert rn_check(bad)==RnStatus.state;
  bad=s[0];bad.moments[1].mean=0.125;#assert rn_check(bad)==RnStatus.state;bad=s[0];bad.moments[1].m2=0.125;#assert rn_check(bad)==RnStatus.range;bad=s[0];bad.moments[1].count=1;#assert rn_check(bad)==RnStatus.state;
  #assert rn_begin(2,s[..])==RnStatus.ok;bad=s[0];bad.moments[1].count=2;#assert rn_check(bad)==RnStatus.state;
  for value:[2]f64.[-1000001,1000001] {bad=s[0];bad.moments[0].mean=value;#assert rn_check(bad)==RnStatus.range;}
  bad=s[0];bad.moments[0]=SmMoments.{count=2,mean=1000000,m2=8000000000000};bad.moments[1].count=2;#assert rn_check(bad)==RnStatus.ok;
  bad.moments[0].m2=f64_from_bits(f64_bits(8000000000000.0)+1);#assert rn_check(bad)==RnStatus.range;bad.moments[0].m2=-1;#assert rn_check(bad)==RnStatus.range;
}
#test "running statistics all shapes and late invalid rows preserve complete outputs" {
  poison:=rn_poison();out:=[2]RnSnapshot.[poison,poison];s:[1]RnSnapshot;#assert rn_begin(2,s[..])==RnStatus.ok;values:=[4]f64.[1,2,3,4];dest:=[3]f64.[17,19,23];
  for count:[2]int.[0,2] {#assert rn_begin(2,out[0..<count])==RnStatus.shape && rn_push(s[0],1,values[0..<2],out[0..<count])==RnStatus.shape;}
  for channels:[2]int.[0,65] {#assert rn_begin(channels,out[0..<1])==RnStatus.shape;}
  for rows:[2]int.[-1,2049] {#assert rn_push(s[0],rows,values[..],out[0..<1])==RnStatus.shape;}
  #assert rn_push(s[0],1,values[..],out[0..<1])==RnStatus.shape && rn_apply(s[0],values[..],dest[0..<2])==RnStatus.shape && rn_apply(s[0],values[0..<2],dest[..])==RnStatus.shape;
  for role:0..<4 {bad:=values;bad[role]=1000001;#assert rn_push(s[0],2,bad[..],out[0..<1])==RnStatus.range;}
  values[1]=-1000001;#assert rn_apply(s[0],values[0..<2],dest[0..<2])==RnStatus.range;
  bad:=s[0];bad.moments[1].count=1;#assert rn_push(bad,1,values[0..<2],out[0..<1])==RnStatus.state && rn_apply(bad,values[0..<2],dest[0..<2])==RnStatus.state;
  for i:0..<2 {rn_same(out[i],poison);}#assert dest[0]==17 && dest[1]==19 && dest[2]==23;
}
#test "running statistics rounded maximum-M2 candidate can cross its box and must not publish" {
  s:[1]RnSnapshot;#assert rn_begin(1,s[..])==RnStatus.ok;
  s[0].moments[0]=SmMoments.{count=999990000,mean=-1000000,m2=3.99996e21};#assert rn_check(s[0])==RnStatus.ok;
  old:=s[0];x:=[1]f64.[1000000];#assert rn_push(s[0],1,x[..],s[..])==RnStatus.range;rn_same(old,s[0]);
}
#test "running statistics maximum shape, exact endcaps, exhaustion and zero rows are literal" {
  s:[1]RnSnapshot;#assert rn_begin(64,s[..])==RnStatus.ok;values:[131072]f64;
  for i:0..<64 {values[i]=ifx i%2==0 then -1000000.0 else 1000000.0;}
  #assert rn_push(s[0],1,values[0..<64],s[..])==RnStatus.ok;
  for i:0..<64 {#assert s[0].moments[i].mean==values[i] && s[0].moments[i].m2==0 && s[0].moments[i].count==1;}
  #assert rn_begin(1,s[..])==RnStatus.ok && rn_push(s[0],2048,values[0..<2048],s[..])==RnStatus.ok && s[0].moments[0].count==2048;
  #assert rn_push(s[0],2049,values[0..<2049],s[..])==RnStatus.shape;
  #assert rn_begin(64,s[..])==RnStatus.ok && rn_push(s[0],2048,values[..],s[..])==RnStatus.ok && s[0].moments[63].count==2048;
  old:=s[0];#assert rn_push(s[0],0,values[0..<0],s[..])==RnStatus.ok;rn_same(old,s[0]);
  for i:0..<64 {s[0].moments[i]=SmMoments.{count=999999999};}#assert rn_push(s[0],1,values[0..<64],s[..])==RnStatus.ok && s[0].moments[0].count==1000000000;
  old=s[0];#assert rn_push(s[0],1,values[0..<64],s[..])==RnStatus.exhausted;rn_same(old,s[0]);
  #assert rn_begin(1,s[..])==RnStatus.ok;s[0].moments[0].count=1000000000;old=s[0];#assert rn_push(s[0],1,values[0..<1],s[..])==RnStatus.exhausted;rn_same(old,s[0]);
}
