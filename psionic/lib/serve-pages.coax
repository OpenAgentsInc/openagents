// Chapter 176: paged state and a tiered prefix cache. Model state lives in
// fixed-size pages: frames in three tiers (device, host, disk), a free stack
// per tier and a reference count per frame. A request's page table maps its
// positions to frames; a write to a shared frame copies it first. Prompt
// blocks that a request finishes enter a prefix trie keyed by model identity
// (the root), the parent block and the block's exact tokens, with a chained
// hash per node. Admission is chapter 175's scheduler charging pages: the
// pages a request will newly hold, after the cached blocks it reuses.
// Profile pg-pages-v1: integer frames and steps; the three tiers are
// regions of one array in one process, not a GPU, host memory and a disk.
#authority;
#load "serve-batch.coax";
#load "../tests/serve-pages-checks.coax";  // the checks' brute-force models and stand-in paged model

PG_PROFILE :: "pg-pages-v1";
PG_PAGE :: 8;
PG_DIM :: 4;
// Frames per tier: tier t holds frames t*16 to t*16+cap[t]-1.
PG_TIER :: 16;
PG_NODES :: 48;
PG_BLOCKS :: 16;
PG_REQUESTS :: 16;
PG_PROMPT :: 32;
PG_HASH :: 2147483647;

PgStatus :: enum u8 {ok;pages;long;batch;}
// book:begin types
// page: positions per page. dim: values per position. hybrid: the model also
// carries a recurrent state of dim values, which is not KV and cannot be
// paged by position: each running request holds one more page for it, and
// each cached block's page keeps a snapshot of it after the block's last
// position. cap: frames in the device, host and disk tiers.
PgConfig :: struct {page:int;dim:int;hybrid:bool;cap:[3]int;}
// Reference counts, and a free stack per tier.
PgPool :: struct {ref:[48]int;stack:[48]int;nfree:[3]int;got:int;}
// One request's page table: the frame of each block, and the cache node
// that block is shared with (-1 while it is private).
PgTable :: struct {n:int;page:[16]int;node:[16]int;}
// One cached prompt block: its parent node (-1 - model for a first block),
// the chained hash of the prefix through it, its tokens, its frame (-1 when
// the slot is empty), and the clock reading of its last use.
PgNode :: struct {parent:int;hash:int;tok:[8]int;frame:int;stamp:int;keep:bool;}
// book:end types
// Frames, tables and the trie. Counters: frames moved down from each tier,
// nodes dropped, copies on write.
PgStore :: struct {cfg:PgConfig;pool:PgPool;table:[16]PgTable;live:[16]int;node:[48]PgNode;down:[3]int;drop:int;cow:int;}
PgPath :: struct {n:int;node:[16]int;}
// Counters: blocks reused (by the tier they were found in), blocks computed,
// and the blocks each request reused.
PgState :: struct {status:PgStatus;cfg:PgConfig;cb:CbState;st:PgStore;model:[16]int;tok:[512]int;path:PgPath;hit:[3]int;miss:int;reused:[16]int;}

// Checks come first. The hand trace is worked in chapter 176; its workload
// is in psionic/tests/serve-pages-checks.coax.
// book:begin check-hand
#test "the hand trace: sharing, model identity, spills down two tiers, a drop" {
    mem:[1728]f64;s:=pgx_hand_start();#assert s.status==PgStatus.ok;
    // Step 0, A (model 0): 3 pages, frames 0 to 2; blocks [1,2] and [3,4] enter the trie.
    s=pg_finish(pg_step(s,mem[..]));n:=s.st.node;f:=s.st.pool;
    #assert pgx_pages(s,0,0,1,2,-1) && s.miss==3 && n[0].hash==65 && n[1].hash==62594 && n[0].parent== -1 && n[1].parent==0;
    #assert f.ref[0]==1 && f.ref[1]==1 && f.ref[2]==0 && f.nfree[0]==2;
    // Step 1, B (model 1, the same tokens): no hit. A's block 1 goes to host for B's third page.
    s=pg_finish(pg_step(s,mem[..]));n=s.st.node;
    #assert pgx_pages(s,1,2,3,1,-1) && s.hit[0]==0 && s.miss==6 && s.st.down[0]==1 && n[1].frame==16;
    #assert n[2].parent== -2 && n[2].hash==1026 && n[3].parent==2 && n[3].hash==986115;
    // Step 2, C (model 0): A's blocks hit, one on the device and one brought up from host.
    // Making room sends B's block 1 to host, then B's block 0 to host and block 1 on to disk.
    s=pg_finish(pg_step(s,mem[..]));n=s.st.node;
    #assert pgx_pages(s,2,0,1,3,2) && s.hit[0]==1 && s.hit[1]==1 && s.miss==7 && s.st.down[0]==3 && s.st.down[1]==1;
    #assert n[2].frame==16 && n[3].frame==32 && n[4].frame==3 && n[4].parent==1 && n[4].hash==60153059;
    // Step 3, D (B's prompt again): one block from host, one from disk; C's block 2 goes to host, then on to disk.
    s=pg_finish(pg_step(s,mem[..]));n=s.st.node;f=s.st.pool;
    #assert pgx_pages(s,3,2,3,1,-1) && s.hit[1]==2 && s.hit[2]==1 && s.miss==8 && s.st.down[0]==5 && s.st.down[1]==2;
    #assert n[1].frame==16 && n[4].frame==32 && f.nfree[0]==1 && f.nfree[1]==0 && f.nfree[2]==0;
    // Step 4, E (C's prompt again): the chain of moves ends with C's block 2 dropped from disk.
    s=pg_finish(pg_step(s,mem[..]));n=s.st.node;f=s.st.pool;
    #assert pgx_pages(s,4,0,1,3,2) && s.hit[0]==2 && s.hit[1]==3 && s.miss==9 && s.st.down[0]==7 && s.st.down[1]==3 && s.st.drop==1;
    #assert n[2].frame==16 && n[3].frame==32 && n[4].frame==3 && f.ref[3]==1 && f.ref[2]==0 && s.cb.done==5;
    // Last use, by step: A's blocks at E's step 4, B's at D's step 3.
    #assert n[0].stamp==4 && n[1].stamp==4 && n[2].stamp==3 && n[3].stamp==3 && n[4].stamp==4;
    #assert s.reused[0]==0 && s.reused[1]==0 && s.reused[2]==2 && s.reused[3]==2 && s.reused[4]==2;
}
// book:end check-hand
#test "page configurations and requests that are refused" {
    s:=pgx_hand_start();#assert s.status==PgStatus.ok;
    cfg:=s.cfg;b:=CbConfig.{slots=1,tokens=8,clients=1,steps=100};b.weight[0]=1;
    q:=[1]CbRequest.[CbRequest.{prompt=31,output=1}];m:=[1]int.[0];tok:[32]int;
    #assert pg_start(cfg,b,q[..],m[..],tok[..]).status==PgStatus.ok;
    x:=cfg;x.page=0;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.pages;
    x=cfg;x.page=8;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.ok;x.page=9;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.pages;
    x=cfg;x.dim=0;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.pages;
    x=cfg;x.dim=4;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.ok;x.dim=5;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.pages;
    for t:0..<3 {
        x=cfg;x.cap[t]=16;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.ok;
        x.cap[t]=17;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.pages;
        x.cap[t]=-1;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.pages;
    }
    x=cfg;x.cap[0]=0;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.pages;
    x=cfg;x.cap[1]=0;x.cap[2]=0;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.ok;
    // 16 pages of 2 positions: 32 positions is the most a request may hold, and 32 the longest prompt.
    q[0].output=2;#assert pg_start(cfg,b,q[..],m[..],tok[..]).status==PgStatus.long;
    q[0].prompt=32;q[0].output=0;#assert pg_start(cfg,b,q[..],m[..],tok[..]).status==PgStatus.ok;
    x=cfg;x.page=3;q[0].prompt=33;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.long;
    q[0].prompt=2;q[0].output=1;m[0]=-1;#assert pg_start(cfg,b,q[..],m[..],tok[..]).status==PgStatus.long;
    m[0]=0;b.slots=0;#assert pg_start(cfg,b,q[..],m[..],tok[..]).status==PgStatus.batch;
    b.slots=1;#assert pg_start(cfg,b,q[0..<0],m[..],tok[..]).status==PgStatus.batch;
    many:[17]CbRequest;mm:[17]int;mt:[544]int;for i:0..<17 {many[i]=q[0];}
    #assert pg_start(cfg,b,many[0..<16],mm[..],mt[..]).status==PgStatus.ok && pg_start(cfg,b,many[..],mm[..],mt[..]).status==PgStatus.long;
    // A hybrid model's state page must leave room: one device page is not enough.
    x=cfg;x.hybrid=true;x.cap[0]=1;#assert pg_start(x,b,q[..],m[..],tok[..]).status==PgStatus.batch;
    x.cap[0]=2;y:=pg_start(x,b,q[..],m[..],tok[..]);#assert y.status==PgStatus.ok && y.cb.cfg.kv==4 && y.cb.cfg.state==2;
    #assert pg_start(cfg,b,q[..],m[..],tok[..]).cb.cfg.state==0;
    mem:[1728]f64;#assert pg_run(x,b,q[0..<0],m[..],tok[..],mem[..]).status==PgStatus.batch;
}
#test "hashes chain, and a collision is a miss" {
    a:=[2]int.[1,2];c:=[2]int.[0,31];d:=[2]int.[1,0];
    #assert pg_hash(0,a[..])==65 && pg_hash(65,a[0..<0])==65 && pg_hash(1,a[..])==1026 && pg_hash(2147483646,a[0..<1])==2147483618;
    #assert pg_hash(7,c[..])==pg_hash(7,d[..]);
    // Model 0 caches [0,31] then [5,5]; then [1,0], [5,5], which hashes the same at both depths but is a different prefix.
    cfg:=PgConfig.{page=2,dim=1};cfg.cap[0]=8;b:=CbConfig.{slots=1,tokens=8,clients=1,steps=100};b.weight[0]=1;
    q:=[5]CbRequest.[CbRequest.{prompt=5,output=1},CbRequest.{prompt=5,output=1},CbRequest.{prompt=5,output=1},CbRequest.{prompt=3,output=1},CbRequest.{prompt=3,output=1}];
    m:=[5]int.[0,0,0,0,1];tok:[160]int;
    t:=[21]int.[0,31,5,5,9,1,0,5,5,9,1,0,5,5,9,31,1,9,0,1,0];
    for k:0..<5 {tok[k]=t[k];tok[32+k]=t[5+k];tok[64+k]=t[10+k];}
    for k:0..<3 {tok[96+k]=t[15+k];tok[128+k]=t[18+k];}
    mem:[1728]f64;s:=pg_run(cfg,b,q[0..<1],m[..],tok[..],mem[..]);#assert s.status==PgStatus.ok && pgx_live(s)==2;
    // The second request misses although both its block hashes are in the trie.
    #assert pg_match(s.st,0,tok[32..<64],5).n==0 && pg_match(s.st,0,tok[0..<32],5).n==2;
    // All five: the third hits the second's two blocks, not the first's.
    s=pg_run(cfg,b,q[..],m[..],tok[..],mem[..]);n:=s.st.node;
    #assert s.hit[0]==2 && s.miss==11 && pgx_live(s)==6 && s.st.table[2].node[0]==2 && s.st.table[2].node[1]==3;
    // Model 1's [0,1] hashes as model 0's [31,1] and misses: the model is the root.
    #assert n[4].hash==994 && n[5].hash==994 && n[4].parent== -1 && n[5].parent== -2 && s.st.table[4].node[0]==5;
}
#test "a hybrid hit restores the recurrent snapshot and leaves its block's last position to run" {
    cfg:=PgConfig.{page=2,dim=2,hybrid=true};cfg.cap[0]=8;b:=CbConfig.{slots=1,tokens=8,clients=1,steps=100};b.weight[0]=1;
    q:=[2]CbRequest.[CbRequest.{prompt=4,output=2},CbRequest.{prompt=5,output=1}];m:[2]int;tok:[64]int;
    for p:0..<5 {tok[p]=p+3;tok[32+p]=p+3;}
    s:=pg_start(cfg,b,q[..],m[..],tok[..]);mem:[1728]f64;out:[16]int;
    for k:0..<48 {mem[k]=9;}
    while s.cb.done<2 {s=pg_step(s,mem[..]);pgx_rows(s,mem[..],out[..]);s=pg_finish(s);}
    // A prompt of 4 reuses no block of its own; a prompt of 5 reuses 2: never the one holding the last position.
    #assert s.hit[0]==2 && s.miss==3 && s.cb.filled[1]==5 && s.st.table[1].node[1]==1;
    a:[8]int;pgx_alone(s,0,a[..]);#assert out[0]==a[0] && out[1]==a[1];
    pgx_alone(s,1,a[..]);#assert out[8]==a[0];
}
#test "the pool's edges, and the least recently used node goes first" {
    c:=PgConfig.{page=8,dim=4};c.cap[0]=1;#assert pg_width(c)==36;
    p:=pg_alloc(pg_pool(c),0);#assert p.got==0 && p.nfree[0]==0;
    p=pg_alloc(p,0);#assert p.got== -1 && p.nfree[0]==0;
    // Three cached first blocks used at steps 3, 5 and 3: the first of the two oldest goes.
    c.cap[0]=3;s:PgStore;s.cfg=c;s.pool=pg_pool(c);mem:[1728]f64;
    for n:0..<PG_NODES {s.node[n].frame=-1;}
    stamp:=[3]int.[3,5,3];
    for n:0..<3 {s.pool=pg_alloc(s.pool,0);s.node[n]=PgNode.{parent=-1,frame=s.pool.got,stamp=stamp[n]};s.node[n].tok[0]=n;}
    s=pg_spill(s,mem[..],0);#assert s.node[0].frame== -1 && s.node[1].frame==1 && s.node[2].frame==2 && s.drop==1 && s.pool.nfree[0]==1;
    s=pg_spill(s,mem[..],0);#assert s.node[2].frame== -1 && s.node[1].frame==1;
}
#test "a token that differs by the hash's modulus is still a different token" {
    cfg:=PgConfig.{page=2,dim=1};cfg.cap[0]=8;b:=CbConfig.{slots=1,tokens=8,clients=1,steps=100};b.weight[0]=1;
    q:=[1]CbRequest.[CbRequest.{prompt=3,output=1}];m:[1]int;tok:[32]int;tok[1]=5;
    mem:[1728]f64;s:=pg_run(cfg,b,q[..],m[..],tok[..],mem[..]);
    t:=tok;t[0]=2147483647;
    #assert pg_hash(0,t[0..<2])==s.st.node[0].hash && pg_match(s.st,0,t[..],3).n==0 && pg_match(s.st,0,tok[..],3).n==1;
}
#test "sixteen requests, the most a run takes, all served; a finished table lets go of its state page" {
    cfg:=PgConfig.{page=2,dim=1,hybrid=true};cfg.cap[0]=4;b:=CbConfig.{slots=1,tokens=8,clients=1,steps=100};b.weight[0]=1;
    q:[16]CbRequest;m:[16]int;tok:[512]int;
    for i:0..<16 {q[i]=CbRequest.{prompt=2,output=1};tok[i*32]=i;}
    mem:[1728]f64;s:=pg_run(cfg,b,q[..],m[..],tok[..],mem[..]);
    #assert s.cb.done==16 && s.cb.fate[15].finish==15 && s.st.live[15]== -1 && s.st.live[0]== -1;
}
#test "names" {
    #assert pg_status_name(PgStatus.ok)=="ok" && pg_status_name(PgStatus.pages)=="page configuration out of bounds";
    #assert pg_status_name(PgStatus.long)=="a request outside the page table, prompt or model bounds" && pg_status_name(PgStatus.batch)=="refused by the scheduler";
}

// Independent checks on random small workloads (psionic/tests/serve-pages-checks.coax).
#forall "shared tables, forks and copies on write equal private copies" seed:0..<100 #steps 100000000 {
    c:=PgConfig.{page=1+seed%3,dim=1+seed/3%4};c.cap[0]=16;
    s:PgStore;s.cfg=c;s.pool=pg_pool(c);for i:0..<16 {s.live[i]=-1;}
    mem:[1728]f64;bt:PgxTables;h:=pgx_next(seed+1);x:[4]f64;cows:=0;size:=c.page*c.dim;
    for op:0..<30 {
        t:=h/65536%4;h=pgx_next(h);u:=h/65536%4;h=pgx_next(h);kind:=h/65536%4;h=pgx_next(h);
        if kind==0 && bt.n[t]==0 {
            n:=1+h/65536%4;h=pgx_next(h);
            for k:0..<n {s.pool=pg_alloc(s.pool,0);s.table[t].page[k]=s.pool.got;}
            s.table[t].n=n;bt.n[t]=n;
            for p:0..<n*c.page {
                for j:0..<c.dim {x[j]=cast(f64)(h/65536%9-4)*0.125;h=pgx_next(h);bt.val[t*64+p*c.dim+j]=x[j];}
                s=pg_write(s,mem[..],t,p,x[0..<c.dim]);
            }
        }
        if kind==1 && bt.n[t]>0 && bt.n[u]==0 {
            s=pg_fork(s,t,u);bt.n[u]=bt.n[t];
            for o:0..<bt.n[t]*size {bt.val[u*64+o]=bt.val[t*64+o];}
        }
        if kind==2 && bt.n[t]>0 {
            p:=h/65536%(bt.n[t]*c.page);h=pgx_next(h);
            if s.pool.ref[s.table[t].page[p/c.page]]>1 {cows+=1;}
            for j:0..<c.dim {x[j]=cast(f64)(h/65536%9-4)*0.125;h=pgx_next(h);bt.val[t*64+p*c.dim+j]=x[j];}
            s=pg_write(s,mem[..],t,p,x[0..<c.dim]);
        }
        if kind==3 && bt.n[t]>0 {s=pg_free_table(s,t);bt.n[t]=0;}
        #assert pgx_same(s,mem[..],bt) && s.cow==cows;
    }
}
#forall "cached prefixes give the cold run's tokens; frames, trie and lookup stay exact" seed:0..<60 #steps 400000000 {
    w:=pgx_work(seed);s:=pgx_start(w);mem:[1728]f64;out:[96]int;
    #assert s.status==PgStatus.ok;
    while s.cb.done<s.cb.n {s=pg_step(s,mem[..]);pgx_rows(s,mem[..],out[..]);s=pg_finish(s);pgx_check(s,mem[..]);}
    for i:0..<w.n {
        if s.cb.fate[i].status!=CbStatus.ok {continue;}
        a:[8]int;pgx_alone(s,i,a[..]);
        for t:0..<w.req[i].output {#assert out[i*8+t]==a[t];}
    }
}
// With page 1 and prompts that share nothing, charging pages is charging
// chapter 175's positions: the same schedule, request for request.
#forall "with nothing shared, the paged scheduler is chapter 175's" seed:0..<50 #steps 100000000 {
    w:=cbx_work(seed);hybrid:=w.cfg.state>0;w.cfg.state=ifx hybrid then 1 else 0;
    if w.cfg.kv>16 {w.cfg.kv=16;}
    cfg:=PgConfig.{page=1,dim=1,hybrid=hybrid};cfg.cap[0]=w.cfg.kv;
    m:[12]int;tok:[384]int;
    for i:0..<w.n {for p:0..<w.req[i].prompt {tok[i*32+p]=i*32+p+1;}}
    mem:[1728]f64;s:=pg_run(cfg,w.cfg,w.req[0..<w.n],m[0..<w.n],tok[..],mem[..]);r:=cb_run(w.cfg,w.req[0..<w.n]);
    #assert s.status==PgStatus.ok && s.cb.status==CbStatus.ok && s.cb.step==r.step && s.hit[0]==0;
    for i:0..<w.n {f:=s.cb.fate[i];g:=r.fate[i];#assert f.status==g.status && f.admit==g.admit && f.first==g.first && f.finish==g.finish && f.order==g.order && f.first_ns==g.first_ns && f.finish_ns==g.finish_ns;}
    for c:0..<3 {#assert s.cb.vt[c]==r.vt[c];}
}
#test "the random workloads reach every tier, every move and the step limit" {
    hit:[3]int;down:[3]int;drop:=0;mem:[1728]f64;
    for seed:0..<30 {
        w:=pgx_work(seed);s:=pg_run(w.cfg,w.batch,w.req[0..<w.n],w.model[0..<w.n],w.tok[..],mem[..]);
        for t:0..<3 {hit[t]+=s.hit[t];down[t]+=s.st.down[t];}drop+=s.st.drop;
    }
    #assert hit[0]>0 && hit[1]>0 && hit[2]>0 && down[0]>0 && down[1]>0 && drop>0;
    w:=pgx_work(0);w.n=2;w.req[0]=CbRequest.{prompt=1,output=1};w.req[1]=w.req[0];w.batch.slots=1;w.batch.steps=1;s:=pg_run(w.cfg,w.batch,w.req[0..<2],w.model[0..<2],w.tok[..],mem[..]);
    #assert s.status==PgStatus.ok && s.cb.status==CbStatus.steps && s.cb.step==1;
}

// book:begin pool
pg_tier :: (f:int)->int {return f/PG_TIER;}
// Every frame free; each tier's stack pops its lowest frame first.
pg_pool :: (c:PgConfig)->PgPool {
    p:PgPool;
    for t:0..<3 {for k:0..<c.cap[t] {p.stack[t*PG_TIER+k]=t*PG_TIER+c.cap[t]-1-k;}p.nfree[t]=c.cap[t];}
    return p;
}
// Take the top of tier t's free stack (got = -1 when it is empty).
pg_alloc :: (from:PgPool,t:int)->PgPool {
    p:=from;p.got=-1;
    if p.nfree[t]==0 {return p;}
    p.nfree[t]-=1;f:=p.stack[t*PG_TIER+p.nfree[t]];
    p.ref[f]=1;p.got=f;
    return p;
}
pg_retain :: (from:PgPool,f:int)->PgPool {p:=from;p.ref[f]+=1;return p;}
// Drop one reference; the last one returns the frame to its tier's stack.
pg_release :: (from:PgPool,f:int)->PgPool {
    p:=from;p.ref[f]-=1;
    if p.ref[f]==0 {t:=pg_tier(f);p.stack[t*PG_TIER+p.nfree[t]]=f;p.nfree[t]+=1;}
    return p;
}
pg_width :: (c:PgConfig)->int {return (c.page+1)*c.dim;}
pg_copy :: (c:PgConfig,mem:[]f64,from:int,to:int) {
    w:=pg_width(c);
    for j:0..<w {mem[to*w+j]=mem[from*w+j];}
}
// book:end pool

// book:begin cow
// Share every page of table a with table b.
pg_fork :: (from:PgStore,a:int,b:int)->PgStore {
    s:=from;s.table[b]=s.table[a];
    for k:0..<s.table[a].n {s.pool=pg_retain(s.pool,s.table[a].page[k]);}
    return s;
}
// Write one position's values. A frame that another holder also references
// is copied first, so the write never shows through anyone else's table.
pg_write :: (from:PgStore,mem:[]f64,i:int,pos:int,x:[]f64)->PgStore {
    s:=from;k:=pos/s.cfg.page;f:=s.table[i].page[k];
    if s.pool.ref[f]>1 {
        s=pg_take(s,mem);
        pg_copy(s.cfg,mem,f,s.pool.got);s.pool=pg_release(s.pool,f);
        s.table[i].page[k]=s.pool.got;f=s.pool.got;s.cow+=1;
    }
    w:=pg_width(s.cfg);
    for j:0..<s.cfg.dim {mem[f*w+pos%s.cfg.page*s.cfg.dim+j]=x[j];}
    return s;
}
pg_free_table :: (from:PgStore,i:int)->PgStore {
    s:=from;
    for k:0..<s.table[i].n {s.pool=pg_release(s.pool,s.table[i].page[k]);}
    s.table[i].n=0;
    if s.live[i]>=0 {s.pool=pg_release(s.pool,s.live[i]);s.live[i]=-1;}
    return s;
}
// book:end cow

// book:begin hash
// The chained hash: a first block starts from the model identity.
pg_hash :: (h:int,tok:[]int)->int {
    x:=h;
    for t:tok {x=(x*31+t+1)%PG_HASH;}
    return x;
}
// The node for this parent and these exact tokens, or -1. The hash narrows
// the search; the parent and the tokens decide it, so a collision is a miss.
pg_child :: (node:[]PgNode,parent:int,h:int,tok:[]int)->int {
    for n:0..<PG_NODES {
        d:=node[n];
        if d.frame>=0 && d.hash==h && d.parent==parent {
            same:=true;
            for j:0..<tok.count {if d.tok[j]!=tok[j] {same=false;}}
            if same {return n;}
        }
    }
    return -1;
}
// The cached blocks a prompt can reuse: its longest cached prefix of whole
// blocks, never the block that holds its last position, because that
// position must run to produce the first output token.
pg_match :: (from:PgStore,model:int,tok:[]int,prompt:int)->PgPath {
    s:=from;p:=s.cfg.page;r:PgPath;parent:=-1-model;h:=model;
    for k:0..<(prompt-1)/p {
        b:[8]int;for j:0..<p {b[j]=tok[k*p+j];}
        h=pg_hash(h,b[0..<p]);
        n:=pg_child(s.node[..],parent,h,b[0..<p]);
        if n<0 {return r;}
        r.node[k]=n;r.n=k+1;parent=n;
    }
    return r;
}
// book:end hash

// book:begin tiers
// Make one frame free in tier t by moving its least recently used movable
// node down a tier. Movable: not kept for the admission in progress, no
// child in the same tier, and on the device referenced by the cache alone.
// A node with nowhere to go (on disk, or the tier below is full with
// nothing movable) is dropped with everything under it.
pg_spill :: (from:PgStore,mem:[]f64,t:int)->PgStore {
    s:=from;v:=-1;
    for n:0..<PG_NODES {
        d:=s.node[n];
        if d.frame<0 || pg_tier(d.frame)!=t || d.keep || s.pool.ref[d.frame]>1 || pg_child_in(s.node[..],n,t) {continue;}
        if v<0 || d.stamp<s.node[v].stamp {v=n;}
    }
    if v<0 {return s;}
    f:=s.node[v].frame;
    if t<2 && s.pool.nfree[t+1]==0 {s=pg_spill(s,mem,t+1);}
    if t<2 && s.pool.nfree[t+1]>0 {
        s.pool=pg_alloc(s.pool,t+1);pg_copy(s.cfg,mem,f,s.pool.got);s.pool=pg_release(s.pool,f);
        s.node[v].frame=s.pool.got;s.down[t]+=1;
        return s;
    }
    for n:0..<PG_NODES {
        if s.node[n].frame>=0 && pg_under(s.node[..],n,v) {s.pool=pg_release(s.pool,s.node[n].frame);s.node[n].frame=-1;s.drop+=1;}
    }
    return s;
}
pg_child_in :: (node:[]PgNode,n:int,t:int)->bool {
    for c:0..<PG_NODES {if node[c].frame>=0 && node[c].parent==n && pg_tier(node[c].frame)==t {return true;}}
    return false;
}
// Is node n the node v or under it?
pg_under :: (node:[]PgNode,n:int,v:int)->bool {
    a:=n;
    while a>=0 {if a==v {return true;}a=node[a].parent;}
    return false;
}
// A device frame for a request: free one first if none is.
pg_take :: (from:PgStore,mem:[]f64)->PgStore {
    s:=from;
    if s.pool.nfree[0]==0 {s=pg_spill(s,mem,0);}
    s.pool=pg_alloc(s.pool,0);
    return s;
}
// book:end tiers

// book:begin start
// Refuse a page configuration or a request outside the bounds; the
// scheduler's state budget becomes the device tier in positions, and a
// hybrid model's recurrent state is charged one page per request.
pg_start :: (cfg:PgConfig,batch:CbConfig,reqs:[]CbRequest,model:[]int,tok:[]int)->PgState {
    s:PgState;s.cfg=cfg;s.status=PgStatus.pages;
    if cfg.page<1 || cfg.page>PG_PAGE || cfg.dim<1 || cfg.dim>PG_DIM || cfg.cap[0]<1 {return s;}
    for t:0..<3 {if cfg.cap[t]<0 || cfg.cap[t]>PG_TIER {return s;}}
    s.status=PgStatus.long;
    if reqs.count>PG_REQUESTS {return s;}
    for i:0..<reqs.count {
        r:=reqs[i];
        if r.prompt>PG_PROMPT || r.output>PG_BLOCKS*cfg.page-r.prompt || model[i]<0 {return s;}
        for p:0..<r.prompt {s.tok[i*PG_PROMPT+p]=tok[i*PG_PROMPT+p];}
        s.model[i]=model[i];
    }
    c:=batch;c.kv=cfg.cap[0]*cfg.page;c.state=ifx cfg.hybrid then cfg.page else 0;
    s.cb=cb_start(c,reqs);s.status=PgStatus.batch;
    if s.cb.status!=CbStatus.ok {return s;}
    s.st.cfg=cfg;s.st.pool=pg_pool(cfg);
    for n:0..<PG_NODES {s.st.node[n].frame=-1;}
    for i:0..<PG_REQUESTS {s.st.live[i]=-1;}
    s.status=PgStatus.ok;
    return s;
}
// book:end start

// book:begin admit
// Chapter 175's admission, charging pages. The head request's charge is its
// blocks, less the cached blocks it reuses, plus one page per reused block
// that must come back up from host or disk, plus its recurrent-state page.
// It is admitted when the charge fits in the free device frames and the
// frames that cached blocks it does not need could give back.
pg_admit :: (from:PgState,mem:[]f64)->PgState {
    s:=from;p:=s.cfg.page;
    while s.cb.nrun<s.cb.cfg.slots {
        c:=-1;
        for d:0..<s.cb.cfg.clients {if s.cb.queued[d]>0 && (c<0 || s.cb.vt[d]<s.cb.vt[c]) {c=d;}}
        if c<0 {return s;}
        h:=0;
        while s.cb.req[h].client!=c || s.cb.fate[h].status!=CbStatus.ok || s.cb.fate[h].admit>=0 {h+=1;}
        r:=s.cb.req[h];
        s.path=pg_match(s.st,s.model[h],s.tok[h*PG_PROMPT..<h*PG_PROMPT+PG_PROMPT],r.prompt);u:=s.path.n;
        blocks:=(r.prompt+r.output+p-1)/p;
        need:=blocks-u+s.cb.cfg.state/p;
        for k:0..<u {n:=s.path.node[k];s.st.node[n].keep=true;if s.st.node[n].frame>=PG_TIER {need+=1;}}
        spare:=s.st.pool.nfree[0];
        for n:0..<PG_NODES {d:=s.st.node[n];if d.frame>=0 && d.frame<PG_TIER && !d.keep && s.st.pool.ref[d.frame]==1 {spare+=1;}}
        if need>spare {for k:0..<u {s.st.node[s.path.node[k]].keep=false;}return s;}
        for k:0..<u {
            n:=s.path.node[k];f:=s.st.node[n].frame;t:=pg_tier(f);
            if t>0 {s.st=pg_take(s.st,mem);pg_copy(s.cfg,mem,f,s.st.pool.got);s.st.pool=pg_release(s.st.pool,f);s.st.node[n].frame=s.st.pool.got;}
            s.st.pool=pg_retain(s.st.pool,s.st.node[n].frame);
            s.hit[t]+=1;s.st.node[n].keep=false;s.st.table[h].page[k]=s.st.node[n].frame;
        }
        for k:u..<blocks {s.st=pg_take(s.st,mem);s.st.table[h].page[k]=s.st.pool.got;}
        s.st.table[h].n=blocks;s.miss+=(r.prompt+p-1)/p-u;s.reused[h]=u;
        if s.cfg.hybrid {
            s.st=pg_take(s.st,mem);l:=s.st.pool.got;s.st.live[h]=l;w:=pg_width(s.cfg);
            for j:0..<s.cfg.dim {mem[l*w+j]=0;if u>0 {mem[l*w+j]=mem[s.st.table[h].page[u-1]*w+p*s.cfg.dim+j];}}
        }
        s.cb.filled[h]=u*p;
        s.cb.fate[h].admit=s.cb.step;s.cb.fate[h].order=s.cb.admitted;s.cb.admitted+=1;
        s.cb.now=s.cb.vt[c];s.cb.vt[c]+=need*CB_SCALE/s.cb.cfg.weight[c];s.cb.queued[c]-=1;
        s.cb.run[s.cb.nrun]=h;s.cb.nrun+=1;
    }
    return s;
}
// book:end admit

// book:begin step
// One iteration, in two halves around the model: pg_step plans it
// (arrivals, admission, rows); the model runs the rows, reading and writing
// frames through the page tables; pg_finish puts every whole prompt block
// written so far in the trie, marks its last use, and retires the finished
// requests.
pg_step :: (from:PgState,mem:[]f64)->PgState {
    s:=from;s.cb=cb_arrive(s.cb);s=pg_admit(s,mem);s.cb=cb_tokens(s.cb);
    return s;
}
pg_finish :: (from:PgState)->PgState {
    s:=from;
    for q:0..<s.cb.nrun {
        i:=s.cb.run[q];
        for k:0..<s.cb.filled[i]/s.cfg.page {s.st=pg_commit(s.st,i,k,s.model[i],s.tok[i*PG_PROMPT..<i*PG_PROMPT+PG_PROMPT],s.cb.step);}
    }
    s.cb.clock+=cb_step_ns(s.cb.used);
    m:=0;
    for q:0..<s.cb.nrun {
        i:=s.cb.run[q];
        if s.cb.fate[i].first==s.cb.step {s.cb.fate[i].first_ns=s.cb.clock;}
        if s.cb.emitted[i]==s.cb.req[i].output {s.cb.fate[i].finish=s.cb.step;s.cb.fate[i].finish_ns=s.cb.clock;s.cb.done+=1;s.st=pg_free_table(s.st,i);}
        else {s.cb.run[m]=i;m+=1;}
    }
    s.cb.nrun=m;s.cb.step+=1;
    return s;
}
// Put block k of request i in the trie. If the same block is already there,
// the request's frame and the cached one hold the same bytes: a cached frame
// on the device replaces the request's copy; one on host or disk is replaced
// by the request's device frame. A block already linked finds itself, and
// only its last use moves.
pg_commit :: (from:PgStore,i:int,k:int,model:int,tok:[]int,step:int)->PgStore {
    s:=from;p:=s.cfg.page;parent:=-1-model;h:=model;
    if k>0 {parent=s.table[i].node[k-1];h=s.node[parent].hash;}
    b:[8]int;for j:0..<p {b[j]=tok[k*p+j];}
    h=pg_hash(h,b[0..<p]);f:=s.table[i].page[k];
    n:=pg_child(s.node[..],parent,h,b[0..<p]);
    if n<0 {
        n=0;while s.node[n].frame>=0 {n+=1;}
        s.node[n]=PgNode.{parent=parent,hash=h,tok=b,frame=f};s.pool=pg_retain(s.pool,f);
    }
    else if s.node[n].frame<PG_TIER {s.pool=pg_release(s.pool,f);s.table[i].page[k]=s.node[n].frame;s.pool=pg_retain(s.pool,s.node[n].frame);}
    else {s.pool=pg_release(s.pool,s.node[n].frame);s.node[n].frame=f;s.pool=pg_retain(s.pool,f);}
    s.node[n].stamp=step;s.table[i].node[k]=n;
    return s;
}
// Without a model: every step's rows are taken as run. Page contents stay
// as they are; admission, sharing and tiers do not depend on them.
pg_run :: (cfg:PgConfig,batch:CbConfig,reqs:[]CbRequest,model:[]int,tok:[]int,mem:[]f64)->PgState {
    s:=pg_start(cfg,batch,reqs,model,tok);
    if s.status!=PgStatus.ok {return s;}
    while s.cb.done<s.cb.n && s.cb.step<s.cb.cfg.steps {s=pg_finish(pg_step(s,mem));}
    if s.cb.done<s.cb.n {s.cb.status=CbStatus.steps;}
    return s;
}
// book:end step

pg_status_name :: (s:PgStatus)->string {
    names:=[4]string.["ok","page configuration out of bounds","a request outside the page table, prompt or model bounds","refused by the scheduler"];
    return names[cast(int)s];
}
