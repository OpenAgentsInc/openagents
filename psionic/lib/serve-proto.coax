// The protobuf wire for POST /v1/systemone: openagents.decision.v1alpha1.
// This file decides nothing. A protobuf request is transcoded to the frozen
// NIP-DEC JSON and admitted by chapter 16's decoder (#authority), so every
// bound and refusal stays in one place and the protobuf door can never admit
// what the JSON door refuses. A protobuf answer re-encodes the JSON answer
// the engine already rendered, so the choice, the score and the rounding
// (at most nine decimals, parsed back exactly) are the JSON answer's.
//   coax/bin/coax test psionic/lib/serve-proto.coax
#load "serve-run.coax";
// The independent vectors sit between the generated markers below, rewritten by
// psionic/tests/serve_proto_oracle.py --update: a separate fixture file would be
// one source unit more than the compiler's budget allows with serve-run.
#import_proto "../../proto/descriptors/systemone.pb" as So;

SpOut :: struct {code:SvCode;at:int;}
SpFlags :: struct {proto_in:bool;proto_out:bool;}
SpBody :: struct {code:SvCode;from:int;to:int;}
SpStep :: struct {step:SvStep;proto_out:bool;}

SP_MEDIA :: "application/x-protobuf";
SP_DEPTH_MAX :: 32;
SP_LEVEL_BYTES :: 16384;   // one nesting level's working space while building a legend value
SP_INTEGER_MAX :: 9007199254740992;

#test "the head names a protobuf body and a protobuf answer" {
    h:="POST /v1/systemone HTTP/1.1\r\nContent-Type: application/x-protobuf\r\nAccept: application/x-protobuf\r\nContent-Length: 3\r\n\r\n";
    f:=sp_flags(h);#assert f.proto_in && f.proto_out;
    j:="POST /v1/systemone HTTP/1.1\r\ncontent-type: application/json\r\nContent-Length: 3\r\n\r\n";
    g:=sp_flags(j);#assert !g.proto_in && !g.proto_out;
    k:="POST /v1/systemone HTTP/1.1\r\nCONTENT-TYPE:  application/x-protobuf \r\naccept: application/json\r\n\r\n";
    m:=sp_flags(k);#assert m.proto_in && !m.proto_out;
    // Only the head counts: a body that mentions the media type changes nothing.
    b:="POST /v1/systemone HTTP/1.1\r\nContent-Length: 40\r\n\r\nAccept: application/x-protobuf\r\n\r\n";
    #assert !sp_flags(b).proto_out && !sp_flags("no head at all").proto_in;
    p:="POST / HTTP/1.1\r\nAccept: application/x-protobuf;q=1\r\n\r\n";#assert !sp_flags(p).proto_out;
}

#test "decimals parse exactly as the body writes them" {
    #assert sp_decimal("0.757196285").value==0.757196285 && sp_decimal("1").value==1 && sp_decimal("-3").value==-3;
    #assert sp_decimal("0.000000001").value==0.000000001 && sp_decimal("2.5").value==2.5;
    #assert !sp_decimal("0.1234567891").present && !sp_decimal("1.").present && !sp_decimal("").present;
    #assert !sp_decimal("1e5").present && !sp_decimal("1.2.3").present && !sp_decimal("x").present;
}

