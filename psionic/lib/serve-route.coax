// Chapter 177: route, queue and scale replicas. A router sends each request
// to the replica with the smallest predicted time to finish it: the work
// already waiting there plus the request's own cost after the prompt blocks
// that replica's prefix trie (chapter 176) already holds. Each replica has a
// bounded queue; each client a bounded share of the requests in flight;
// what does not fit is refused with a typed reason. An autoscaler adds and
// removes replicas between a floor and an owner's budget, with a band of
// hysteresis, a scale-down delay, and the measured cold-start cost from
// chapter 178's receipt deciding whether a new replica would come up in
// time to help. A discrete-event simulation replays traffic against it.
// Profile rr-route-v1: integer microseconds; each replica serves one request
// at a time, timed by chapter 175's step model; replicas are simulated in
// one process.
#authority;
#load "serve-pages.coax";
#load "bench.coax";
#load "../tests/serve-route-checks.coax";  // the checks' brute-force router and hand-traced fleets

RR_PROFILE :: "rr-route-v1";
RR_REPLICAS :: 8;
RR_DEPTH :: 8;
RR_CLIENTS :: 8;
RR_OUTPUT :: 64;
RR_REQUESTS :: 256;
RR_EVENTS :: 4096;
// Frame values: 48 frames of (8 + 1) * 4 values, chapter 176's largest
// page. With the device tier only, no frame is ever copied or written (a
// full device drops its least recently used block), so every replica's
// trie can share one scratch region.
RR_MEM :: 1728;
RR_NEVER :: 1125899906842624;  // 2^50: cb_min and cb_max stay exact
// book:begin cold
// Measured cold starts on coderos-4080, chapter 178's receipt
// (psionic/fixtures/startup/coderos-4080.json, 256 MiB of weights, an empty
// file cache): 520,740 us when a verification record lets the start skip
// hashing ("cold, record"), 1,264,892 us when every byte is hashed ("cold,
// no record").
RR_COLD_RECORD_US :: 520740;
RR_COLD_HASH_US :: 1264892;
// book:end cold

RrStatus :: enum u8 {ok;config;order;events;}
// book:begin types
// Why a request was refused: outside the request bounds, its client already
// holds its share of the requests in flight, every replica's queue is full,
// or no replica is running or starting.
RrRefusal :: enum u8 {none;shape;client;full;cold;}
// affinity: the smallest predicted finish, counting cached blocks. least:
// the same prediction, blind to the cache. round: the next replica in turn
// with room.
RrPolicy :: enum u8 {affinity;least;round;}
RrPhase :: enum u8 {off;starting;ready;}
// replicas: running at the start. depth: most requests waiting at one
// replica. share: most requests one client may have queued or running.
// events: the most event times a simulation may take.
RrConfig :: struct {policy:RrPolicy;replicas:int;depth:int;clients:int;share:int;pages:PgConfig;events:int;}
RrRequest :: struct {client:int;arrive:int;prompt:int;output:int;}
// One replica: its queue (request numbers, oldest first), the predicted
// cost of what waits there, the request it is serving and when that ends,
// and its own prefix trie and frames.
RrReplica :: struct {phase:RrPhase;ready_at:int;running:int;busy_until:int;nq:int;queue:[8]int;work:int;st:PgStore;}
// The router's choice: a replica, the cached blocks it counted there, and
// the predicted time from now until the request would finish.
RrPick :: struct {refusal:RrRefusal;replica:int;cached:int;est:int;turn:int;}
// book:end types
// book:begin load-types
// floor and budget: fewest and most replicas. target: requests in flight per
// replica. band: percent of hysteresis around the target. down: consecutive
// low ticks before one replica is removed. cold_us: the measured start cost.
RrScaler :: struct {on:bool;floor:int;budget:int;target:int;band:int;down:int;cold_us:int;tick_us:int;}
// What the autoscaler sees at a tick: replicas ready and starting, requests
// queued or running, the predicted work they hold, and the low and high
// ticks in a row so far.
RrLoad :: struct {ready:int;starting:int;load:int;backlog:int;low:int;high:int;}
RrAct :: enum u8 {hold;up;down;}
// steady: inside the band. floor: below the floor. load: the load asks for
// it. cold: a new replica would start after the backlog has drained, and
// the load has not been high for as long as a cold start.
// budget: more are wanted than the budget allows. delay: low, but not for
// long enough yet.
RrWhy :: enum u8 {steady;floor;load;cold;budget;delay;}
RrScale :: struct {act:RrAct;count:int;why:RrWhy;low:int;high:int;}
// book:end load-types
RrFate :: struct {refusal:RrRefusal;replica:int;pred:int;start:int;first:int;finish:int;reused:int;}
// A simulation's record: every request's fate, refusals by reason, blocks
// reused of those that could be, the deepest queue, the autoscaler's ticks
// by reason, replicas started and stopped, the most provisioned at once,
// and replica-microseconds provisioned.
RrSim :: struct {
    status:RrStatus;n:int;fate:[256]RrFate;
    refused:[5]int;hit:int;blocks:int;deepest:int;
    why:[6]int;ups:int;downs:int;peak:int;replica_us:int;end:int;events:int;
}
RrReport :: struct {served:int;refused:int;hit:int;blocks:int;first:BnStats;latency:BnStats;peak:int;replica_us:int;}

// Checks come first. The hand-traced fleets and the brute-force router are
// in psionic/tests/serve-route-checks.coax; chapter 177 works the numbers.
// book:begin check-cost
#test "costs follow chapter 175's step model: one step of prefill rows, then one per output token" {
    // 17,792,472 ns for one row, 1,459,182 ns per further row.
    #assert rr_cost(13,2,0)==53095 && rr_cost(13,2,8)==41421 && rr_cost(13,2,12)==35584;
    #assert rr_prefill(13,0)==35302 && rr_prefill(13,12)==17792 && rr_cost(1,1,0)==17792;
}
// book:end check-cost
// book:begin check-hand
#test "the hand-traced routes" {
    f:=rrx_hand();cfg:=rrx_hand_config();tok:=rrx_hand_tok();
    // Replica 0 holds A's first 2 blocks and is idle; replica 1 holds 3 and has 10 ms of work; replica 2 is empty.
    #assert pg_match(f[0].st,0,tok[..],13).n==2 && pg_match(f[1].st,0,tok[..],13).n==3 && pg_match(f[2].st,0,tok[..],13).n==0;
    r:=RrRequest.{client=0,prompt=13,output=2};
    p:=rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0);#assert p.refusal==RrRefusal.none && p.replica==0 && p.cached==2 && p.est==41421;
    // With 5 ms of work, replica 1's 5,000 + 35,584 beats replica 0's 41,421.
    f[1].work=5000;p=rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0);#assert p.replica==1 && p.cached==3 && p.est==40584;
    // Blind to the cache, the idle replicas tie at 53,095 and the lowest goes; in turn, replica 2 is next after 1.
    c:=cfg;c.policy=RrPolicy.least;p=rr_route(f[..],c,r,tok[..],0,rrx_held(0),0);#assert p.replica==0 && p.cached==0 && p.est==53095;
    c.policy=RrPolicy.round;p=rr_route(f[..],c,r,tok[..],0,rrx_held(0),2);#assert p.replica==2 && p.turn==0 && p.est==53095;
    // Replica 1 still starting: 1,000 us to go costs it the request; 800 does not.
    f[1].phase=RrPhase.starting;f[1].ready_at=1000;p=rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0);#assert p.replica==0 && p.est==41421;
    f[1].ready_at=800;p=rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0);#assert p.replica==1 && p.est==41384;
    // Replica 0 busy until 12 ms: at 0 replica 2 wins, at 2 ms replica 0 does again.
    f[1].phase=RrPhase.off;f[0].running=7;f[0].busy_until=12000;
    p=rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0);#assert p.replica==2 && p.est==53095;
    p=rr_route(f[..],cfg,r,tok[..],2000,rrx_held(0),0);#assert p.replica==0 && p.est==51421;
}
// book:end check-hand
// book:begin check-refuse
#test "refusals, each with its reason" {
    f:=rrx_hand();cfg:=rrx_hand_config();tok:=rrx_hand_tok();
    r:=RrRequest.{client=0,prompt=13,output=2};
    #assert rr_route(f[..],cfg,r,tok[..],0,rrx_held(1),0).refusal==RrRefusal.none && rr_route(f[..],cfg,r,tok[..],0,rrx_held(2),0).refusal==RrRefusal.client;
    bad:=r;bad.client=-1;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.shape;
    bad.client=3;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.shape;bad.client=2;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.none;
    bad=r;bad.prompt=0;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.shape;
    bad.prompt=33;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.shape;bad.prompt=32;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.none;
    bad=r;bad.output=0;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.shape;
    bad.output=65;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.shape;bad.output=64;#assert rr_route(f[..],cfg,bad,tok[..],0,rrx_held(0),0).refusal==RrRefusal.none;
    // Queues of depth 2: full ones are skipped; all full is a refusal.
    f[0].nq=2;p:=rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0);#assert p.replica==1;
    f[1].nq=2;f[2].nq=1;p=rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0);#assert p.replica==2;
    f[2].nq=2;#assert rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0).refusal==RrRefusal.full && rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0).replica== -1;
    c:=cfg;c.policy=RrPolicy.round;#assert rr_route(f[..],c,r,tok[..],0,rrx_held(0),1).refusal==RrRefusal.full;
    f[1].nq=1;p=rr_route(f[..],c,r,tok[..],0,rrx_held(0),2);#assert p.replica==1 && p.turn==2;
    // Off replicas take nothing; with none running or starting the refusal is cold.
    f[1].phase=RrPhase.off;#assert rr_route(f[..],c,r,tok[..],0,rrx_held(0),2).refusal==RrRefusal.full;
    f[0].phase=RrPhase.off;f[2].phase=RrPhase.off;#assert rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0).refusal==RrRefusal.cold;
    f[2].phase=RrPhase.starting;#assert rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0).refusal==RrRefusal.full;
    f[2].phase=RrPhase.off;f[0].phase=RrPhase.ready;#assert rr_route(f[..],cfg,r,tok[..],0,rrx_held(0),0).refusal==RrRefusal.full;
    // The share is per client: client 1 at its share, client 0 not.
    h:=rrx_held(0);h[1]=2;f[0].nq=0;#assert rr_route(f[..],cfg,r,tok[..],0,h,0).replica==0;
    r.client=1;#assert rr_route(f[..],cfg,r,tok[..],0,h,0).refusal==RrRefusal.client;
}
// book:end check-refuse
#test "configurations and traffic the simulation refuses" {
    cfg:=rrx_sim_config();q:=[2]RrRequest.[RrRequest.{prompt=4,output=1},RrRequest.{arrive=5,prompt=4,output=1}];tok:[64]int;sc:RrScaler;
    #assert rr_sim(cfg,sc,q[..],tok[..]).status==RrStatus.ok;
    c:=cfg;c.replicas=0;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.replicas=8;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.ok;c.replicas=9;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.depth=0;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.depth=8;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.ok;c.depth=9;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.clients=0;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.clients=8;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.ok;c.clients=9;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.share=0;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.pages.page=0;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.pages.page=9;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.pages.dim=0;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.pages.dim=5;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;c.pages.dim=4;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.ok;
    // The device must hold a whole prompt of 32 positions: 8 pages of 4, not 7.
    c=cfg;c.pages.cap[0]=7;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.pages.cap[0]=16;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.ok;c.pages.cap[0]=17;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.pages.hybrid=true;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    // The device tier only; pages of 8 need 4 frames.
    c=cfg;c.pages.cap[1]=1;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.pages.cap[2]=1;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c=cfg;c.pages.page=8;c.pages.cap[0]=4;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.ok;
    c.pages.cap[0]=3;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    // The event limit: this run takes 4 event times.
    c=cfg;c.events=0;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.events=4097;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.config;
    c.events=4096;#assert rr_sim(c,sc,q[..],tok[..]).events==4;
    c.events=1;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.events;
    c.events=4;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.ok;
    c.events=3;#assert rr_sim(c,sc,q[..],tok[..]).status==RrStatus.events;
    #assert rr_sim(cfg,sc,q[0..<1],tok[..]).status==RrStatus.ok;
    #assert rr_sim(cfg,sc,q[..],tok[0..<63]).status==RrStatus.config;
    #assert rr_sim(cfg,sc,q[0..<0],tok[..]).status==RrStatus.config;
    many:[257]RrRequest;mt:[8224]int;for i:0..<257 {many[i]=q[0];}
    #assert rr_sim(cfg,sc,many[0..<256],mt[..]).status==RrStatus.ok && rr_sim(cfg,sc,many[..],mt[..]).status==RrStatus.config;
    o:=q;o[1].arrive=-1;#assert rr_sim(cfg,sc,o[..],tok[..]).status==RrStatus.order;
    o[0].arrive=-1;#assert rr_sim(cfg,sc,o[..],tok[..]).status==RrStatus.order;
    o[0].arrive=5;o[1].arrive=5;#assert rr_sim(cfg,sc,o[..],tok[..]).status==RrStatus.ok;
    o[0].arrive=-1;#assert rr_sim(cfg,sc,o[..],tok[..]).status==RrStatus.order;
    o[0].arrive=10;#assert rr_sim(cfg,sc,o[..],tok[..]).status==RrStatus.order;
    // The scaler's own bounds, checked only when it is on.
    s:=rrx_scaler();#assert rr_sim(cfg,s,q[..],tok[..]).status==RrStatus.ok;
    x:=s;x.floor=-1;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x=s;x.floor=0;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.ok;
    x=s;x.floor=3;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x=s;x.budget=8;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.ok;x.budget=9;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x=s;x.budget=1;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x=s;x.target=0;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x=s;x.band=0;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x.band=99;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.ok;x.band=100;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x=s;x.down=0;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x=s;x.cold_us=-1;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    x.cold_us=0;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.ok;
    x=s;x.tick_us=0;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.config;
    // Edges that pass: a tick of 1 us runs out of events instead.
    x.tick_us=1;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.events;
    x=s;x.floor=2;x.budget=2;x.target=1;x.band=1;x.down=1;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.ok;
    // Requests outside the bounds are refused one by one, and the rest run.
    b:=q;b[0].client=-1;b[1].client=2;y:=rr_sim(cfg,sc,b[..],tok[..]);
    #assert y.status==RrStatus.ok && y.refused[1]==2 && y.fate[0].replica== -1 && y.fate[1].start== -1;
    x=s;x.on=false;x.floor=-1;#assert rr_sim(cfg,x,q[..],tok[..]).status==RrStatus.ok;
}
// book:begin check-scale
#test "the hand-worked autoscaler ticks" {
    s:=rrx_scaler();  // floor 1, budget 4, target 2, band 25, down after 3 ticks, cold start 520,740 us
    // 2 replicas: up above 2 * 2 * 1.25 = 5 requests, down at or below 1 * 2 * 0.75 = 1.5.
    d:=rr_scale(s,RrLoad.{ready=2,load=5,backlog=9000000});#assert d.act==RrAct.hold && d.why==RrWhy.steady && d.low==0;
    d=rr_scale(s,RrLoad.{ready=2,load=6,backlog=9000000});#assert d.act==RrAct.up && d.count==1 && d.why==RrWhy.load;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=9000000});#assert d.act==RrAct.up && d.count==2 && d.why==RrWhy.load;
    // A backlog of 2 * 520,740 us or less drains before a new replica would be up:
    // hold, until the load has been high for 6 ticks of 100 ms, longer than the start.
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1041480});#assert d.act==RrAct.hold && d.why==RrWhy.cold && d.high==1;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1041481,high=3});#assert d.act==RrAct.up && d.count==2 && d.high==0;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1041480,high=4});#assert d.act==RrAct.hold && d.high==5;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1041480,high=5});#assert d.act==RrAct.up && d.count==2;
    // A start that hashes every byte, 1,264,892 us, waits 13 ticks.
    s.cold_us=RR_COLD_HASH_US;d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1041481,high=11});#assert d.act==RrAct.hold && d.why==RrWhy.cold;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=2529784,high=11});#assert d.act==RrAct.hold;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=2529785,high=11});#assert d.act==RrAct.up;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1041481,high=12});#assert d.act==RrAct.up;
    s=rrx_scaler();
    // Starting replicas count: 3 provisioned hold 7.
    d=rr_scale(s,RrLoad.{ready=2,starting=1,load=7,backlog=9000000});#assert d.act==RrAct.hold && d.why==RrWhy.steady;
    // The budget caps the count, then refuses to grow.
    d=rr_scale(s,RrLoad.{ready=3,load=20,backlog=9000000});#assert d.act==RrAct.up && d.count==1;
    d=rr_scale(s,RrLoad.{ready=4,load=20,backlog=9000000,high=2});#assert d.act==RrAct.hold && d.why==RrWhy.budget && d.high==3;
    d=rr_scale(s,RrLoad.{ready=4,load=8,high=2});#assert d.act==RrAct.hold && d.why==RrWhy.steady && d.high==0;
    // Down only after 3 low ticks in a row.
    d=rr_scale(s,RrLoad.{ready=2,load=1});#assert d.act==RrAct.hold && d.why==RrWhy.delay && d.low==1;
    d=rr_scale(s,RrLoad.{ready=2,load=1,low=1});#assert d.act==RrAct.hold && d.low==2;
    d=rr_scale(s,RrLoad.{ready=2,load=1,low=2});#assert d.act==RrAct.down && d.count==1 && d.why==RrWhy.load && d.low==0;
    d=rr_scale(s,RrLoad.{ready=2,load=2,low=2});#assert d.act==RrAct.hold && d.why==RrWhy.steady && d.low==0;
    // Never below the floor; below it, up to it at once.
    d=rr_scale(s,RrLoad.{ready=1,load=0,low=5});#assert d.act==RrAct.hold && d.why==RrWhy.steady;
    d=rr_scale(s,RrLoad.{load=0});#assert d.act==RrAct.up && d.count==1 && d.why==RrWhy.floor;
    // Floor 0: one replica goes after the delay, and the first request starts one, cold or not.
    s.floor=0;d=rr_scale(s,RrLoad.{ready=1,load=0,low=2});#assert d.act==RrAct.down;
    d=rr_scale(s,RrLoad.{load=1,backlog=1});#assert d.act==RrAct.up && d.count==1 && d.why==RrWhy.load;
    d=rr_scale(s,RrLoad.{load=0});#assert d.act==RrAct.hold && d.why==RrWhy.steady;
    // Exact edges: 200 > 1 * 1 * 199 is high; 13,900 <= 7 * 20 * 99 = 13,860 is not low.
    x:=RrScaler.{on=true,floor=0,budget=8,target=1,band=99,down=1,cold_us=0,tick_us=1};
    d=rr_scale(x,RrLoad.{ready=1,load=2});#assert d.act==RrAct.up && d.count==1;
    x.target=20;x.band=1;d=rr_scale(x,RrLoad.{ready=8,load=139});#assert d.act==RrAct.hold && d.why==RrWhy.steady;
    d=rr_scale(x,RrLoad.{ready=8,load=138});#assert d.act==RrAct.down;
    // Six high ticks of 100,000 us reach a 600,000 us start exactly.
    s.cold_us=600000;d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1,high=5});#assert d.act==RrAct.up;
    d=rr_scale(s,RrLoad.{ready=2,load=7,backlog=1,high=4});#assert d.act==RrAct.hold;
}
// book:end check-scale
#test "names" {
    #assert rr_refusal_name(RrRefusal.none)=="none" && rr_refusal_name(RrRefusal.shape)=="request outside the bounds";
    #assert rr_refusal_name(RrRefusal.client)=="client over its share" && rr_refusal_name(RrRefusal.full)=="every queue full" && rr_refusal_name(RrRefusal.cold)=="no replica running or starting";
    #assert rr_why_name(RrWhy.steady)=="steady" && rr_why_name(RrWhy.floor)=="floor" && rr_why_name(RrWhy.load)=="load";
    #assert rr_why_name(RrWhy.cold)=="cold" && rr_why_name(RrWhy.budget)=="budget" && rr_why_name(RrWhy.delay)=="delay";
    #assert rr_policy_name(RrPolicy.affinity)=="prefix affinity" && rr_policy_name(RrPolicy.least)=="least work" && rr_policy_name(RrPolicy.round)=="round robin";
    #assert rr_status_name(RrStatus.ok)=="ok" && rr_status_name(RrStatus.config)=="configuration or traffic out of bounds";
    #assert rr_status_name(RrStatus.order)=="arrivals out of order" && rr_status_name(RrStatus.events)=="event limit reached";
}

