    q:=dgx_q(300000);c:=dgx_fleet(3);c.local=128;p:=dg_report(dg_sim(c,q[..]),q[..]);
    #assert dgx_frozen(p,779767764,3608655820,20710836,23629200,207486132,18242399044) && p.transfers==30 && p.bytes==761268336;
}
