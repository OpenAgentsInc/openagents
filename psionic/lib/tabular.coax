// Chapter 103: learning with arrays. A deadline simulator, grouped splits,
// feature scaling, affine and one-hidden-layer models trained by minibatch
// SGD with explicit gradients, and the measurements that compare them.
// Profile cpu-f64-sgd-v1: binary64 storage and arithmetic, chapter 4's
// compensated accumulator for every sum, no FMA or reassociation.
#load "ops.coax";
#authority;

TbStatus :: enum u8 {ok;shape;capacity;alias;number;update;}
TbSim :: struct {status:TbStatus;rows:int;on_time:int;}
TbModel :: struct {features:int;hidden:int;logistic:bool;}
TbConfig :: struct {epochs:int;batch:int;rate:f64;decay:f64;init_seed:u64;shuffle_seed:u64;}
TbTrain :: struct {status:TbStatus;steps:int;loss:f64;}
TbValue :: struct {status:TbStatus;value:f64;}
TbClass :: struct {status:TbStatus;accuracy:f64;cost:f64;late:int;caught:int;}
TbChoice :: struct {status:TbStatus;threshold:f64;cost:f64;}

TB_GOLDEN :: (cast(u64)0x9e3779b97f4a7c15);
TB_SESSION_COUNTER :: (cast(u64)1048576);
TB_SESSIONS_MAX :: 512;
TB_PER_SESSION :: 8;
TB_ROWS_MAX :: 4096;
TB_FEATURES_MAX :: 8;
TB_HIDDEN_MAX :: 16;
TB_EPOCHS_MAX :: 512;
TB_BATCH_MAX :: 256;
TB_WORK_MAX :: 16777216;
TB_DOMAIN :: 1048576.0;
TB_DEADLINE :: 9.0;
TB_COST_MAX :: 1000000.0;

// Checks precede the implementation. Expected values are derived in chapter 103.
#test "SplitMix64 counter zero has the published seed-zero word" {
    #assert tb_bits(0,0)==(cast(u64)0xe220a8397b1dcdaf) && tb_bits(0,1)==(cast(u64)0x6e789e6aa1b965f4);
    #assert tb_uniform(0,0)==0.8833108082136426;
}
#test "a request is on time up to and including the deadline" {
    #assert tb_on_time(9) && tb_on_time(-1) && !tb_on_time(f64_from_bits(f64_bits(9.0)+1));
}
#test "the simulator follows its stated formula" {
    // Two sessions, so the second session's draws (counters 2^20 + 2, 2^20 + 3) are checked too.
    x:[64]f64;y:[16]f64;lat:[16]f64;g:[16]int;
    for i:0..<16 {y[i]=-7;}
    r:=tb_simulate(71,2,x[..],y[..],lat[..],g[..],false);
    #assert r.status==TbStatus.ok && r.rows==16;
    on:=0;
    for i:0..<16 {
        s:=i/8;
        h:=0.5+7.5*tb_uniform(71,TB_SESSION_COUNTER+cast(u64)(2*s));w:=0.7+0.6*tb_uniform(71,TB_SESSION_COUNTER+cast(u64)(2*s)+1);
        c:=cast(u64)(4*i);p:=64+cast(int)(tb_bits(71,c)%8129);q:=cast(int)(tb_bits(71,c+1)%16);m:=cast(int)(tb_bits(71,c+2)%2);
        cost:=0.0003;if m==1 {cost=0.0009;}
        want:=0.2+0.15*f64(q)+f64(p)*cost*w*(1+1.5/h)+0.6*(tb_uniform(71,c+3)-0.5);
        #assert x[4*i]==f64(p) && x[4*i+1]==f64(q) && x[4*i+2]==f64(m) && x[4*i+3]==h && lat[i]==want && g[i]==s;
        #assert p>=64 && p<=8192 && q>=0 && q<=15;
        if want<=9 {#assert y[i]==1;on+=1;} else {#assert y[i]==0;}
    }
    #assert r.on_time==on && on>0 && on<16;
}
#test "simulation refuses bad sizes, short storage and overlap before writing" {
    x:[31]f64;for i:0..<31 {x[i]=-7;}
    y:[16]f64;lat:[16]f64;g:[16]int;big:[64]f64;
    #assert tb_simulate(1,0,x[..],y[..],lat[..],g[..],false).status==TbStatus.shape;
    #assert tb_simulate(1,513,x[..],y[..],lat[..],g[..],false).status==TbStatus.shape;
    // 512 sessions is a size the simulator accepts; this storage is merely too short.
    #assert tb_simulate(1,512,x[..],y[..],lat[..],g[..],false).status==TbStatus.capacity;
    #assert tb_simulate(1,1,x[..],y[..],lat[..],g[..],false).status==TbStatus.capacity;
    #assert tb_simulate(1,1,big[..],y[0..<7],lat[..],g[..],false).status==TbStatus.capacity;
    #assert tb_simulate(1,1,big[..],y[..],lat[0..<7],g[..],false).status==TbStatus.capacity;
    #assert tb_simulate(1,1,big[..],y[..],lat[..],g[0..<7],false).status==TbStatus.capacity;
    #assert tb_simulate(1,1,big[..],y[..],lat[..],g[..],true).status==TbStatus.alias;
    for v:x {#assert v==-7;}
    r:=tb_simulate(1,2,big[..],y[..],lat[..],g[..],false);
    #assert r.status==TbStatus.ok && r.rows==16 && g[7]==0 && g[8]==1;
}
#forall "sessions split three, one, one by their number" group:0..<12 {
    k:=group%5;want:=2;if k<3 {want=0;} else if k==3 {want=1;}
    #assert tb_part(group)==want;
}
#test "rows are listed by part in order, and a group never crosses parts" {
    g:=[10]int.[0,0,1,3,3,4,5,8,9,9];out:[10]int;
    #assert tb_rows(g[..],0,out[..],false)==4 && out[0]==0 && out[1]==1 && out[2]==2 && out[3]==6;
    #assert tb_rows(g[..],1,out[..],false)==3 && out[0]==3 && out[1]==4 && out[2]==7;
    #assert tb_rows(g[..],2,out[..],false)==3 && out[0]==5 && out[2]==9;
    #assert tb_rows(g[..],0,out[0..<3],false)==-1 && tb_rows(g[..],0,out[0..<4],false)==4 && tb_rows(g[..],3,out[..],false)==-1;
    bad:=[1]int.[-1];#assert tb_rows(bad[..],0,out[..],false)==-1 && tb_rows(g[..],0,out[..],true)==-1;
}
#test "admission helpers have inclusive bounds" {
    #assert tb_in(-2,-2,2) && tb_in(2,-2,2) && !tb_in(-2.5,-2,2) && !tb_in(2.5,-2,2);
    r:[4097]int;
    #assert tb_row_ok(r[0..<4096],1) && !tb_row_ok(r[..],1) && !tb_row_ok(r[0..<0],1);
    r[0]=3;#assert tb_row_ok(r[0..<1],4) && !tb_row_ok(r[0..<1],3);
    r[0]=-1;#assert !tb_row_ok(r[0..<1],4);
    a:[8193]f64;
    #assert tb_table_ok(a[0..<4096],1) && !tb_table_ok(a[0..<4097],1) && tb_table_ok(a[0..<8192],2) && !tb_table_ok(a[..],2);
    #assert tb_table_ok(a[0..<8],8) && !tb_table_ok(a[0..<9],9) && !tb_table_ok(a[0..<3],0) && tb_table_ok(a[0..<0],1);
    #assert tb_model_ok(TbModel.{features=1}) && tb_model_ok(TbModel.{features=8,hidden=16});
    #assert !tb_model_ok(TbModel.{features=0}) && !tb_model_ok(TbModel.{features=9}) && !tb_model_ok(TbModel.{features=1,hidden=17}) && !tb_model_ok(TbModel.{features=1,hidden=-1});
}
#test "scaling uses training rows only and refuses a constant feature" {
    // Two features over rows 0, 1, 2; row 3 is outside training and must not move the statistics.
    x:=[8]f64.[0,4, 3,5, 6,9, 1000,-1000];rows:=[3]int.[0,1,2];mean:[2]f64;sd:[2]f64;
    #assert tb_fit_scale(x[..],2,rows[..],mean[..],sd[..],false)==TbStatus.ok;
    #assert mean[0]==3 && mean[1]==6 && sd[0]==sqrt(6.0) && sd[1]==sqrt(14.0/3.0);
    out:[8]f64;#assert tb_apply_scale(x[..],2,mean[..],sd[..],out[..],false)==TbStatus.ok;
    #assert out[0]==-3/sqrt(6.0) && out[2]==0 && out[3]==-1/sqrt(14.0/3.0) && out[6]==997/sqrt(6.0);
    flat:=[4]f64.[1,5, 3,5];two:=[2]int.[0,1];
    #assert tb_fit_scale(flat[..],2,two[..],mean[..],sd[..],false)==TbStatus.number && mean[0]==3;
    one:=[3]f64.[2,4,9];#assert tb_fit_scale(one[..],1,two[..],mean[0..<1],sd[0..<1],false)==TbStatus.ok && mean[0]==3 && sd[0]==1;
    #assert tb_fit_scale(x[..],2,rows[..],mean[0..<1],sd[..],false)==TbStatus.capacity;
    #assert tb_fit_scale(x[..],2,rows[..],mean[..],sd[0..<1],false)==TbStatus.capacity;
    #assert tb_fit_scale(x[..],0,rows[..],mean[..],sd[..],false)==TbStatus.shape;
    #assert tb_fit_scale(x[0..<7],2,rows[..],mean[..],sd[..],false)==TbStatus.shape;
    #assert tb_fit_scale(x[..],2,rows[..],mean[..],sd[..],true)==TbStatus.alias;
    late:=[1]int.[4];#assert tb_fit_scale(x[..],2,late[..],mean[..],sd[..],false)==TbStatus.shape;
    // Out-of-domain training values: the first feature of the first row, the second of the second.
    x[0]=TB_DOMAIN*2;#assert tb_fit_scale(x[..],2,rows[..],mean[..],sd[..],false)==TbStatus.number;
    x[0]=0;x[3]=-TB_DOMAIN*2;#assert tb_fit_scale(x[..],2,rows[..],mean[..],sd[..],false)==TbStatus.number;
    #assert mean[0]==3 && mean[1]==6;
}
#test "applying a scale refuses bad statistics and storage before writing" {
    x:=[4]f64.[1,2, 3,4];mean:=[2]f64.[0,0];sd:=[2]f64.[1,TB_DOMAIN];out:=[4]f64.[-7,-7,-7,-7];
    #assert tb_apply_scale(x[..],2,mean[..],sd[..],out[..],false)==TbStatus.ok && out[3]==4/TB_DOMAIN;
    out[0]=-7;
    #assert tb_apply_scale(x[..],3,mean[..],sd[..],out[..],false)==TbStatus.shape;
    #assert tb_apply_scale(x[..],2,mean[0..<1],sd[..],out[..],false)==TbStatus.shape;
    #assert tb_apply_scale(x[..],2,mean[..],sd[0..<1],out[..],false)==TbStatus.shape;
    #assert tb_apply_scale(x[..],2,mean[..],sd[..],out[0..<3],false)==TbStatus.capacity;
    #assert tb_apply_scale(x[..],2,mean[..],sd[..],out[..],true)==TbStatus.alias;
    sd[0]=0;#assert tb_apply_scale(x[..],2,mean[..],sd[..],out[..],false)==TbStatus.number;
    sd[0]=1;sd[1]=TB_DOMAIN*2;#assert tb_apply_scale(x[..],2,mean[..],sd[..],out[..],false)==TbStatus.number;
    sd[1]=1;mean[0]=TB_DOMAIN*2;#assert tb_apply_scale(x[..],2,mean[..],sd[..],out[..],false)==TbStatus.number;
    mean[0]=0;x[3]=TB_DOMAIN*2;#assert tb_apply_scale(x[..],2,mean[..],sd[..],out[..],false)==TbStatus.number;
    #assert out[0]==-7;
}
#test "parameter counts" {
    #assert tb_param_count(TbModel.{features=4})==5 && tb_param_count(TbModel.{features=4,hidden=8})==49;
    #assert tb_param_count(TbModel.{features=8,hidden=16})==161 && tb_param_count(TbModel.{features=3,hidden=2})==11;
    #assert tb_param_count(TbModel.{features=0})==0 && tb_param_count(TbModel.{features=1,hidden=17})==0;
}
#test "stable activations by hand" {
    #assert tb_tanh(0)==0 && f64_bits(tb_tanh(0))==0 && tb_tanh(1)==-tb_tanh(-1) && tb_tanh(400)==1 && tb_tanh(-400)==-1;
    #assert abs(tb_tanh(0.5)-0.46211715726000974)<=1e-16;
    #assert tb_sigmoid(0)==0.5 && tb_sigmoid(800)==1 && tb_sigmoid(-800)==0;
    #assert tb_sigmoid(2)==1/(1+exp(-2.0)) && tb_sigmoid(-2)==exp(-2.0)/(1+exp(-2.0));
    #assert tb_softplus(0)==log(2.0) && tb_softplus(800)==800 && tb_softplus(-800)==0 && tb_softplus(1)==1+log(1+exp(-1.0));
}
#test "an affine output and a tanh hidden layer by hand" {
    p:=[3]f64.[2,-1,0.5];v:=[2]f64.[3,4];
    #assert tb_output(TbModel.{features=2},p[..],v[..])==2.5;
    // One hidden unit: a = 1*3 + 0*4 + (-3) = 0, so h = tanh(0) = 0 and the output is its bias 0.25.
    q:=[5]f64.[1,0,-3,7,0.25];#assert tb_output(TbModel.{features=2,hidden=1},q[..],v[..])==0.25;
    q[2]=-2;#assert tb_output(TbModel.{features=2,hidden=1},q[..],v[..])==7*tb_tanh(1)+0.25;
    // Three inputs and two hidden units: W1 = [[1,0,0],[0,0,1]], b1 = [0,-1], w2 = [2,3], b2 = -1.
    r:=[11]f64.[1,0,0, 0,0,1, 0,-1, 2,3, -1];u:=[3]f64.[0.5,9,1];
    #assert tb_output(TbModel.{features=3,hidden=2},r[..],u[..])==2*tb_tanh(0.5)-1;
}
#test "weights and biases are told apart in every layout" {
    a:=TbModel.{features=3};
    #assert tb_is_weight(a,0) && tb_is_weight(a,2) && !tb_is_weight(a,3);
    one:=TbModel.{features=1,hidden=1};
    #assert tb_is_weight(one,0) && !tb_is_weight(one,1) && tb_is_weight(one,2) && !tb_is_weight(one,3);
    m:=TbModel.{features=3,hidden=2};want:=[11]bool.[true,true,true,true,true,true,false,false,true,true,false];
    for s:0..<11 {#assert tb_is_weight(m,s)==want[s];}
}
#test "initialization draws weights at their slot and leaves biases zero" {
    p:[11]f64;m:=TbModel.{features=3,hidden=2};tb_initialize(m,5,p[..]);
    #assert p[0]==(2*tb_uniform(5,0)-1)/sqrt(3.0) && p[5]==(2*tb_uniform(5,5)-1)/sqrt(3.0);
    #assert p[6]==0 && p[7]==0 && p[8]==(2*tb_uniform(5,8)-1)/sqrt(2.0) && p[9]==(2*tb_uniform(5,9)-1)/sqrt(2.0) && p[10]==0;
    q:=[4]f64.[-7,-7,-7,-7];tb_initialize(TbModel.{features=1,hidden=1},5,q[..]);
    #assert q[0]==2*tb_uniform(5,0)-1 && q[1]==0 && q[2]==2*tb_uniform(5,2)-1 && q[3]==0;
    a:=[3]f64.[-7,-7,-7];tb_initialize(TbModel.{features=2},5,a[..]);#assert a[0]==0 && a[1]==0 && a[2]==0;
}
#test "a hidden layer's gradient matches a central difference" {
    x:=[9]f64.[0.5,-1,0.25, -0.25,2,-1, 1.5,0.75,0.5];y:=[3]f64.[1,0,1];rows:=[3]int.[0,1,2];
    m:=TbModel.{features=3,hidden=2,logistic=true};
    p:[11]f64;tb_initialize(m,5,p[..]);p[6]=0.3;p[7]=-0.2;p[10]=0.1;
    g:[11]f64;tb_gradient(m,p[..],x[..],y[..],rows[..],g[..]);
    for s:0..<11 {
        up:=p;down:=p;up[s]+=1e-6;down[s]-=1e-6;
        numeric:=(tb_loss(m,up[..],x[..],y[..],rows[..])-tb_loss(m,down[..],x[..],y[..],rows[..]))/2e-6;
        #assert abs(numeric-g[s])<=1e-8;
    }
    // The same for a line on half the squared error.
    l:=TbModel.{features=3};t:=[3]f64.[2,-1,0.5];q:=[4]f64.[0.5,-0.25,1,0.1];
    tb_gradient(l,q[..],x[..],t[..],rows[..],g[0..<4]);
    for s:0..<4 {
        up:=q;down:=q;up[s]+=1e-6;down[s]-=1e-6;
        numeric:=(tb_loss(l,up[..],x[..],t[..],rows[..])-tb_loss(l,down[..],x[..],t[..],rows[..]))/2e-6;
        #assert abs(numeric-g[s])<=1e-8;
    }
}
#test "the shuffle is Fisher-Yates over a counter that persists across epochs" {
    o:=[4]int.[10,11,12,13];next:=tb_shuffle(o[..],9,0);
    #assert next==3;
    want:=[4]int.[10,11,12,13];
    c:=(cast(u64)0);i:=3;
    while i>0 {j:=cast(int)(tb_bits(9,c)%cast(u64)(i+1));c+=1;t:=want[i];want[i]=want[j];want[j]=t;i-=1;}
    for k:0..<4 {#assert o[k]==want[k];}
    one:=[1]int.[5];#assert tb_shuffle(one[..],9,7)==7 && one[0]==5;
}
#test "training work is bounded before it starts" {
    #assert tb_budget(TbModel.{features=1},TbConfig.{epochs=1},1) && tb_budget(TbModel.{features=1},TbConfig.{epochs=512},4096);
    #assert !tb_budget(TbModel.{features=0},TbConfig.{epochs=1},1) && !tb_budget(TbModel.{features=1},TbConfig.{epochs=0},1);
    #assert !tb_budget(TbModel.{features=1},TbConfig.{epochs=513},1) && !tb_budget(TbModel.{features=1},TbConfig.{epochs=1},0);
    #assert !tb_budget(TbModel.{features=1},TbConfig.{epochs=1},4097);
    // 512 * 4096 * 8 parameters is exactly the budget; 97 parameters over 257 * 673 rows is one past it.
    #assert tb_budget(TbModel.{features=7},TbConfig.{epochs=512},4096) && !tb_budget(TbModel.{features=8},TbConfig.{epochs=512},4096);
    #assert !tb_budget(TbModel.{features=6,hidden=12},TbConfig.{epochs=257},673) && tb_budget(TbModel.{features=6,hidden=12},TbConfig.{epochs=256},673);
}
#test "one SGD step of logistic regression has an exact hand oracle" {
    // Two rows, one feature, zero start, rate 1/2. At zero every sigmoid is 1/2.
    // gradient w = ((1/2 - 1)*2 + (1/2 - 0)*(-2))/2 = -1, gradient b = ((-1/2) + (1/2))/2 = 0.
    x:=[2]f64.[2,-2];y:=[2]f64.[1,0];rows:=[2]int.[0,1];p:=[3]f64.[-7,-7,-7];order:=[2]int.[1,1];
    m:=TbModel.{features=1,logistic=true};c:=TbConfig.{epochs=1,batch=2,rate=0.5};
    r:=tb_train(m,c,x[..],y[..],rows[..],p[..],order[..],false);
    #assert r.status==TbStatus.ok && r.steps==1 && p[0]==0.5 && p[1]==0 && p[2]==-7;
    // Loss after the step: each row has logit +-1 on its correct side.
    #assert abs(r.loss-tb_softplus(-1))<=1e-16;
}
#test "one SGD step of a line, with weight decay but none on the bias" {
    x:=[1]f64.[1];y:=[1]f64.[3];rows:=[1]int.[0];p:[2]f64;order:[1]int;
    m:=TbModel.{features=1};c:=TbConfig.{epochs=1,batch=1,rate=0.25,decay=0.5};
    // A zero start: residual -3, gradient w = -3, b = -3, so both become 0.75.
    r:=tb_train(m,c,x[..],y[..],rows[..],p[..],order[..],false);
    #assert r.status==TbStatus.ok && p[0]==0.75 && p[1]==0.75 && r.loss==(1.5*1.5)/2;
    c.epochs=2;r=tb_train(m,c,x[..],y[..],rows[..],p[..],order[..],false);
    // Second step from 0.75, 0.75: residual -1.5; w gets -1.5 + 0.375 decay, b gets -1.5.
    #assert r.steps==2 && p[0]==0.75+0.25*(1.5-0.375) && p[1]==0.75+0.25*1.5;
}
#test "one SGD step of the hidden layer starts from the stated initialization" {
    x:=[3]f64.[0.5,-1,2];y:=[1]f64.[1];rows:=[1]int.[0];m:=TbModel.{features=3,hidden=2,logistic=true};
    c:=TbConfig.{epochs=1,batch=1,rate=0.5,decay=0.1,init_seed=5};
    p0:[11]f64;tb_initialize(m,5,p0[..]);g:[11]f64;tb_gradient(m,p0[..],x[..],y[..],rows[..],g[..]);
    p:[11]f64;order:[1]int;
    #assert tb_train(m,c,x[..],y[..],rows[..],p[..],order[..],false).status==TbStatus.ok;
    for s:0..<11 {
        step:=g[s];if tb_is_weight(m,s) {step+=0.1*p0[s];}
        #assert p[s]==p0[s]-0.5*step;
    }
}
#test "epochs, a short last batch, decay and the persistent shuffle match the independent oracle" {
    // Values from psionic/tests/tabular_oracle.py train(), which uses exactly rounded sums.
    x:=[10]f64.[0.5,-1, -0.25,2, 1.5,0.75, -1,-0.5, 0.25,0.25];y:=[5]f64.[1,0,1,0,1];rows:=[5]int.[0,1,2,3,4];
    m:=TbModel.{features=2,hidden=2,logistic=true};c:=TbConfig.{epochs=2,batch=2,rate=0.5,decay=0.1,init_seed=3,shuffle_seed=4};
    p:[9]f64;order:=[5]int.[4,4,4,4,4];
    r:=tb_train(m,c,x[..],y[..],rows[..],p[..],order[..],false);
    want:=[9]f64.[-0.8089714015225703,0.21997983359222684,0.5611921993420547,-0.34420063314734484,-0.04795855237536923,0.0858229572627825,-0.8407457451153201,0.6165808157656696,0.14095771947970867];
    #assert r.status==TbStatus.ok && r.steps==6 && abs(r.loss-0.393557817567476)<=1e-14;
    for s:0..<9 {#assert abs(p[s]-want[s])<=1e-14;}
    // A line on rows listed out of order: order starts from the caller's list.
    lx:=[3]f64.[1,2,-1];ly:=[3]f64.[0.5,1.5,-2];lr:=[3]int.[2,0,1];q:[2]f64;lo:[3]int;
    l:=tb_train(TbModel.{features=1},TbConfig.{epochs=3,batch=2,rate=0.25,decay=0.5,shuffle_seed=7},lx[..],ly[..],lr[..],q[..],lo[..],false);
    #assert l.status==TbStatus.ok && l.steps==6 && abs(q[0]-0.8702278137207031)<=1e-15 && abs(q[1]+0.3389892578125)<=1e-15;
}
#test "training refuses bad requests before writing parameters" {
    x:=[2]f64.[2,-2];y:=[2]f64.[1,0];rows:=[2]int.[0,1];order:[2]int;
    m:=TbModel.{features=1,logistic=true};c:=TbConfig.{epochs=1,batch=2,rate=0.5};
    for kind:0..<19 {
        p:=[2]f64.[-7,-7];mm:=m;cc:=c;fx:=x;fy:=y;rr:=rows;ov:=false;want:=TbStatus.shape;pv:=p[..];ord:=order[..];rv:=rr[..];
        if kind==0 {mm.hidden=17;}
        if kind==1 {cc.epochs=0;}
        if kind==2 {cc.epochs=513;}
        if kind==3 {cc.batch=0;}
        if kind==4 {cc.batch=257;}
        if kind==5 {cc.rate=0;}
        if kind==6 {cc.rate=17;}
        if kind==7 {cc.decay=-1;}
        if kind==8 {rr[1]=2;}
        if kind==9 {pv=p[0..<1];want=TbStatus.capacity;}
        if kind==10 {ord=order[0..<1];want=TbStatus.capacity;}
        if kind==11 {ov=true;want=TbStatus.alias;}
        if kind==12 {fx[1]=TB_DOMAIN*2;want=TbStatus.number;}
        if kind==13 {fy[0]=0.5;want=TbStatus.number;}
        if kind==14 {cc.decay=2;}
        if kind==15 {rr[0]=-1;}
        if kind==16 {mm.logistic=false;fy[1]=-TB_DOMAIN*2;want=TbStatus.number;}
        if kind==17 {rv=rr[0..<0];}
        if kind==18 {rv=rr[0..<1];pv=p[0..<1];want=TbStatus.capacity;}
        r:=tb_train(mm,cc,fx[..],fy[..],rv,pv,ord,ov);
        #assert r.status==want && r.steps==0 && r.loss==0 && p[0]==-7 && p[1]==-7;
    }
    // The second feature of the second row is outside the domain.
    w:=[4]f64.[0,0, 0,TB_DOMAIN*2];p:[3]f64;
    #assert tb_train(TbModel.{features=2,logistic=true},c,w[..],y[..],rows[..],p[..],order[..],false).status==TbStatus.number;
    #assert tb_train(m,c,x[0..<1],y[..],rows[..],p[..],order[..],false).status==TbStatus.shape;
}
#test "training accepts its inclusive limits" {
    x:=[2]f64.[2,-2];y:=[2]f64.[1,0];rows:=[2]int.[0,1];order:[2]int;p:[2]f64;
    m:=TbModel.{features=1,logistic=true};
    #assert tb_train(m,TbConfig.{epochs=1,batch=256,rate=16,decay=1},x[..],y[..],rows[..],p[..],order[..],false).status==TbStatus.ok;
    #assert tb_train(m,TbConfig.{epochs=1,batch=1,rate=1e-9},x[..],y[..],rows[..],p[..],order[..],false).steps==2;
    l:=TbModel.{features=1};big:=[2]f64.[TB_DOMAIN,-TB_DOMAIN];
    #assert tb_train(l,TbConfig.{epochs=1,batch=2,rate=1e-30},big[..],big[..],rows[..],p[..],order[..],false).status==TbStatus.ok;
}
#test "an update that leaves the parameter domain is refused, and nothing is published" {
    x:=[1]f64.[1048576];y:=[1]f64.[1048576];rows:=[1]int.[0];p:=[2]f64.[-7,-7];order:[1]int;
    r:=tb_train(TbModel.{features=1},TbConfig.{epochs=1,batch=1,rate=1},x[..],y[..],rows[..],p[..],order[..],false);
    #assert r.status==TbStatus.update && r.steps==0 && p[0]==-7 && p[1]==-7;
}
#test "prediction writes one output per row and refuses before writing" {
    p:=[3]f64.[2,-1,0.5];x:=[4]f64.[3,4, 1,1];out:=[3]f64.[-7,-7,-7];m:=TbModel.{features=2};
    #assert tb_predict(m,p[..],x[..],out[0..<2],false)==TbStatus.ok && out[0]==2.5 && out[1]==1.5 && out[2]==-7;
    out[0]=-7;
    #assert tb_predict(m,p[0..<2],x[..],out[..],false)==TbStatus.shape && tb_predict(m,p[..],x[0..<3],out[..],false)==TbStatus.shape;
    #assert tb_predict(TbModel.{features=0},p[..],x[..],out[..],false)==TbStatus.shape && tb_predict(TbModel.{features=2,hidden=17},p[..],x[..],out[..],false)==TbStatus.shape;
    #assert tb_predict(m,p[..],x[..],out[0..<1],false)==TbStatus.capacity && tb_predict(m,p[..],x[..],out[..],true)==TbStatus.alias;
    p[0]=TB_DOMAIN*2;#assert tb_predict(m,p[..],x[..],out[..],false)==TbStatus.number;
    p[0]=2;p[2]=TB_DOMAIN*2;#assert tb_predict(m,p[..],x[..],out[..],false)==TbStatus.number;
    p[2]=0.5;x[3]=-TB_DOMAIN*2;#assert tb_predict(m,p[..],x[..],out[..],false)==TbStatus.number;
    #assert out[0]==-7;
}
#test "log loss, squared error and a constant predictor" {
    z:=[2]f64.[1,-2];y:=[2]f64.[1,0];rows:=[2]int.[0,1];
    #assert tb_log_loss(z[..],y[..],rows[..]).value==((tb_softplus(1)-1)+tb_softplus(-2))/2;
    t:=[2]f64.[3,-1];#assert tb_mse(z[..],t[..],rows[..]).value==(4+1)/2.0;
    labels:=[5]f64.[1,0,1,0,0];all:=[5]int.[0,1,2,3,4];
    b:=tb_base_logit(labels[..],all[..]);#assert b.status==TbStatus.ok && b.value==log(2.0/3.0);
    #assert tb_base_logit(labels[..],all[0..<2]).value==0;
    #assert tb_base_logit(labels[..],all[1..<2]).status==TbStatus.number && tb_base_logit(labels[..],all[0..<1]).status==TbStatus.number;
    #assert tb_base_logit(labels[..],all[0..<0]).status==TbStatus.shape;
    #assert tb_log_loss(z[..],y[..],rows[0..<0]).status==TbStatus.shape;
    bad:=[1]int.[2];#assert tb_mse(z[..],t[..],bad[..]).status==TbStatus.shape;
    #assert tb_log_loss(z[..],y[0..<1],rows[0..<1]).status==TbStatus.shape;
    huge:=[2]f64.[1e301,0];
    #assert tb_log_loss(huge[..],y[..],rows[..]).status==TbStatus.shape && tb_mse(z[..],huge[..],rows[..]).status==TbStatus.shape;
}
#test "costs count missed late requests and needless flags separately" {
    // Probabilities of finishing on time; requests 1 and 3 were late.
    p:=[4]f64.[0.9,0.6,0.4,0.2];y:=[4]f64.[1,0,1,0];rows:=[4]int.[0,1,2,3];
    a:=tb_classify(p[..],y[..],rows[..],0.5,5,1);
    // Flagged (below 0.5): 2 and 3. Late 1 is missed (5), on-time 2 is flagged (1).
    #assert a.status==TbStatus.ok && a.accuracy==0.5 && a.cost==1.5 && a.late==2 && a.caught==1;
    b:=tb_classify(p[..],y[..],rows[..],0.7,5,1);#assert b.accuracy==0.75 && b.cost==0.25 && b.caught==2;
    #assert tb_classify(p[..],y[..],rows[..],1,0,TB_COST_MAX).cost==TB_COST_MAX/2;
    #assert tb_classify(p[..],y[..],rows[..],0.1,TB_COST_MAX,0).cost==TB_COST_MAX/2;
    for k:0..<6 {
        t:=0.5;miss:=5.0;alarm:=1.0;
        if k==0 {t=0;} if k==1 {t=1.5;} if k==2 {miss=-1;} if k==3 {miss=TB_COST_MAX*2;} if k==4 {alarm=-1;} if k==5 {alarm=TB_COST_MAX*2;}
        #assert tb_classify(p[..],y[..],rows[..],t,miss,alarm).status==TbStatus.shape;
    }
    c:=tb_choose(p[..],y[..],rows[..],5,1);
    // Any threshold in (0.6, 0.9] flags both late requests and one on-time one: cost 1/4. The smallest is 0.65.
    #assert c.status==TbStatus.ok && c.threshold==0.65 && c.cost==0.25;
    #assert tb_choose(p[..],y[..],rows[..],-1,1).status==TbStatus.shape;
    // Ends of the grid: 0.05 alone separates these, and nothing below 1 can flag a 0.97.
    lo:=[2]f64.[0.01,0.06];hi:=[2]f64.[0.97,0.98];two:=[2]int.[0,1];late:=[2]f64.[0,1];
    #assert tb_choose(lo[..],late[..],two[..],5,1).threshold==0.05 && tb_choose(hi[..],late[..],two[..],5,1).cost==2.5;
}
#test "the handwritten rule ignores memory and keeps a safety factor of two" {
    #assert tb_rule_seconds(1000,4,1)==2*(0.2+0.15*4+1000*0.0009) && tb_rule_seconds(8000,10,0)==2*(0.2+0.15*10+8000*0.0003);
    x:[32]f64;y:[8]f64;lat:[8]f64;g:[8]int;
    #assert tb_simulate(3,1,x[..],y[..],lat[..],g[..],false).status==TbStatus.ok;
    out:[9]f64;for i:0..<9 {out[i]=-7;}
    #assert tb_rule(x[..],out[..],false)==TbStatus.ok && out[8]==-7;
    on:=0;
    for i:0..<8 {
        want:=0.0;if tb_on_time(tb_rule_seconds(x[4*i],x[4*i+1],x[4*i+2])) {want=1;on+=1;}
        #assert out[i]==want;
    }
    #assert on>0 && on<8;
    #assert tb_rule(x[0..<31],out[..],false)==TbStatus.shape && tb_rule(x[..],out[0..<7],false)==TbStatus.capacity && tb_rule(x[..],out[0..<8],false)==TbStatus.ok;
    #assert tb_rule(x[..],out[..],true)==TbStatus.alias;
}

// book:begin random
// SplitMix64 at a counter, the same generator as chapter 64's sampler.
tb_bits :: (seed:u64,counter:u64)->u64 {
    z:=add_wrap(seed,mul_wrap(TB_GOLDEN,add_wrap(counter,(cast(u64)1))));
    z=mul_wrap(z^(z>>30),(cast(u64)0xbf58476d1ce4e5b9));z=mul_wrap(z^(z>>27),(cast(u64)0x94d049bb133111eb));return z^(z>>31);
}
tb_uniform :: (seed:u64,counter:u64)->f64 {return f64(tb_bits(seed,counter)>>11)/9007199254740992.0;}
// book:end random

// book:begin simulate
tb_on_time :: (seconds:f64)->bool {return seconds<=TB_DEADLINE;}
// deadline-sim-v1. Session g draws its memory headroom and machine slowness;
// request i draws its prompt length, queue depth, model and noise.
tb_simulate :: (seed:u64,sessions:int,x:[]f64,y:[]f64,latency:[]f64,groups:[]int,overlap:bool)->TbSim #export_c {
    if sessions<1 || sessions>TB_SESSIONS_MAX {return TbSim.{status=TbStatus.shape};}
    n:=sessions*TB_PER_SESSION;
    if x.count<4*n || y.count<n || latency.count<n || groups.count<n {return TbSim.{status=TbStatus.capacity};}
    if overlap {return TbSim.{status=TbStatus.alias};}
    on:=0;
    for g:0..<sessions {
        headroom:=0.5+7.5*tb_uniform(seed,TB_SESSION_COUNTER+cast(u64)(2*g));
        slowness:=0.7+0.6*tb_uniform(seed,TB_SESSION_COUNTER+cast(u64)(2*g+1));
        for r:0..<TB_PER_SESSION {
            i:=g*TB_PER_SESSION+r;c:=cast(u64)(4*i);
            prompt:=64+cast(int)(tb_bits(seed,c)%8129);
            queue:=cast(int)(tb_bits(seed,c+1)%16);
            large:=cast(int)(tb_bits(seed,c+2)%2);
            cost:=0.0003;if large==1 {cost=0.0009;}
            seconds:=0.2+0.15*f64(queue)+f64(prompt)*cost*slowness*(1+1.5/headroom)+0.6*(tb_uniform(seed,c+3)-0.5);
            x[4*i]=f64(prompt);x[4*i+1]=f64(queue);x[4*i+2]=f64(large);x[4*i+3]=headroom;
            latency[i]=seconds;groups[i]=g;y[i]=0;
            if tb_on_time(seconds) {y[i]=1;on+=1;}
        }
    }
    return TbSim.{rows=n,on_time=on};
}
// book:end simulate

// book:begin split
// Whole sessions go to one part: 0 training (three in five), 1 validation, 2 test.
tb_part :: (group:int)->int {
    k:=group%5;
    if k<3 {return 0;}
    if k==3 {return 1;}
    return 2;
}
// The rows of one part, in row order. -1 for a bad part, group, short or overlapping output.
tb_rows :: (groups:[]int,part:int,out:[]int,overlap:bool)->int #export_c {
    if part<0 || part>2 || overlap {return -1;}
    n:=0;
    for g:groups {
        if g<0 {return -1;}
        if tb_part(g)==part {n+=1;}
    }
    if out.count<n {return -1;}
    n=0;
    for i:0..<groups.count {if tb_part(groups[i])==part {out[n]=i;n+=1;}}
    return n;
}
// book:end split

tb_in :: (v:f64,lo:f64,hi:f64)->bool {return v>=lo && v<=hi;}
// One to 4096 row indices, each naming a row below `limit`.
tb_row_ok :: (rows:[]int,limit:int)->bool {
    if rows.count<1 || rows.count>TB_ROWS_MAX {return false;}
    for r:rows {if r<0 || r>=limit {return false;}}
    return true;
}
// A row-major table of at most 4096 rows of d features.
tb_table_ok :: (x:[]f64,d:int)->bool {
    return d>=1 && d<=TB_FEATURES_MAX && x.count%d==0 && x.count/d<=TB_ROWS_MAX;
}
tb_model_ok :: (m:TbModel)->bool {
    return m.features>=1 && m.features<=TB_FEATURES_MAX && m.hidden>=0 && m.hidden<=TB_HIDDEN_MAX;
}

// book:begin scale
// Mean and population standard deviation of each feature over the training rows only.
tb_fit_scale :: (x:[]f64,d:int,rows:[]int,mean:[]f64,sd:[]f64,overlap:bool)->TbStatus #export_c {
    if !tb_table_ok(x,d) || !tb_row_ok(rows,x.count/d) {return TbStatus.shape;}
    if mean.count<d || sd.count<d {return TbStatus.capacity;}
    if overlap {return TbStatus.alias;}
    for r:rows {for j:0..<d {if !tb_in(x[r*d+j],-TB_DOMAIN,TB_DOMAIN) {return TbStatus.number;}}}
    m:[8]f64;s:[8]f64;
    for j:0..<d {
        a:PsionicAccumulator;
        for r:rows {a=psionic_ops_accumulate(a,x[r*d+j]);}
        m[j]=psionic_ops_total(a)/f64(rows.count);
        v:PsionicAccumulator;
        for r:rows {e:=x[r*d+j]-m[j];v=psionic_ops_accumulate(v,e*e);}
        s[j]=sqrt(psionic_ops_total(v)/f64(rows.count));
        if s[j]==0 {return TbStatus.number;}
    }
    for j:0..<d {mean[j]=m[j];sd[j]=s[j];}
    return TbStatus.ok;
}
tb_apply_scale :: (x:[]f64,d:int,mean:[]f64,sd:[]f64,out:[]f64,overlap:bool)->TbStatus #export_c {
    if !tb_table_ok(x,d) || mean.count<d || sd.count<d {return TbStatus.shape;}
    if out.count<x.count {return TbStatus.capacity;}
    if overlap {return TbStatus.alias;}
    for j:0..<d {if !tb_in(mean[j],-TB_DOMAIN,TB_DOMAIN) || !(sd[j]>0 && sd[j]<=TB_DOMAIN) {return TbStatus.number;}}
    for v:x {if !tb_in(v,-TB_DOMAIN,TB_DOMAIN) {return TbStatus.number;}}
    for i:0..<x.count {j:=i%d;out[i]=(x[i]-mean[j])/sd[j];}
    return TbStatus.ok;
}
// book:end scale

// book:begin model
// hidden 0: output = b + sum w_j x_j. hidden h: W1 [h,d], b1 [h], w2 [h], b2.
tb_param_count :: (m:TbModel)->int #export_c {
    if !tb_model_ok(m) {return 0;}
    if m.hidden==0 {return m.features+1;}
    return m.hidden*m.features+2*m.hidden+1;
}
tb_tanh :: (a:f64)->f64 {
    t:=exp(-2*abs(a));v:=(1-t)/(1+t);
    if a<0 {return -v;}
    return v;
}
// exp(min(z, 0)) / (1 + exp(-|z|)): no exponential of a large positive number.
tb_sigmoid :: (z:f64)->f64 {return exp((z-abs(z))/2)/(1+exp(-abs(z)));}
tb_softplus :: (z:f64)->f64 {return (z+abs(z))/2+log(1+exp(-abs(z)));}
tb_hidden :: (m:TbModel,p:[]f64,v:[]f64,h:[]f64) {
    d:=m.features;
    for k:0..<m.hidden {
        a:PsionicAccumulator;a=psionic_ops_accumulate(a,p[m.hidden*d+k]);
        for j:0..<d {a=psionic_ops_accumulate(a,p[k*d+j]*v[j]);}
        h[k]=tb_tanh(psionic_ops_total(a));
    }
}
tb_output :: (m:TbModel,p:[]f64,v:[]f64)->f64 {
    d:=m.features;a:PsionicAccumulator;
    if m.hidden==0 {
        a=psionic_ops_accumulate(a,p[d]);
        for j:0..<d {a=psionic_ops_accumulate(a,p[j]*v[j]);}
        return psionic_ops_total(a);
    }
    h:[16]f64;tb_hidden(m,p,v,h[..]);base:=m.hidden*d+m.hidden;
    a=psionic_ops_accumulate(a,p[base+m.hidden]);
    for k:0..<m.hidden {a=psionic_ops_accumulate(a,p[base+k]*h[k]);}
    return psionic_ops_total(a);
}
// book:end model

// Weights draw U(-1/sqrt(fan_in), 1/sqrt(fan_in)) at counter = their slot; biases start at zero.
tb_initialize :: (m:TbModel,seed:u64,p:[]f64) {
    for s:0..<tb_param_count(m) {p[s]=0;}
    if m.hidden==0 {return;}
    d:=m.features;
    for s:0..<m.hidden*d {p[s]=(2*tb_uniform(seed,cast(u64)s)-1)/sqrt(f64(d));}
    base:=m.hidden*d+m.hidden;
    for k:0..<m.hidden {p[base+k]=(2*tb_uniform(seed,cast(u64)(base+k))-1)/sqrt(f64(m.hidden));}
}
// Weight decay applies to W1 and w2 (or w), never to a bias.
tb_is_weight :: (m:TbModel,s:int)->bool {
    if m.hidden==0 {return s<m.features;}
    hd:=m.hidden*m.features;
    return s<hd || (s>=hd+m.hidden && s<hd+2*m.hidden);
}

// book:begin gradient
// Mean gradient of the per-row loss over `rows`: log loss on a logit, or
// half the squared error of a value. Both give d loss / d output = residual.
tb_gradient :: (m:TbModel,p:[]f64,x:[]f64,y:[]f64,rows:[]int,g:[]f64) {
    d:=m.features;n:=tb_param_count(m);acc:[161]PsionicAccumulator;h:[16]f64;
    for r:rows {
        v:=x[r*d..<r*d+d];z:=tb_output(m,p,v);
        residual:=z-y[r];if m.logistic {residual=tb_sigmoid(z)-y[r];}
        if m.hidden==0 {
            for j:0..<d {acc[j]=psionic_ops_accumulate(acc[j],residual*v[j]);}
            acc[d]=psionic_ops_accumulate(acc[d],residual);
        } else {
            tb_hidden(m,p,v,h[..]);base:=m.hidden*d+m.hidden;
            acc[n-1]=psionic_ops_accumulate(acc[n-1],residual);
            for k:0..<m.hidden {
                acc[base+k]=psionic_ops_accumulate(acc[base+k],residual*h[k]);
                back:=residual*p[base+k]*(1-h[k]*h[k]);
                acc[m.hidden*d+k]=psionic_ops_accumulate(acc[m.hidden*d+k],back);
                for j:0..<d {acc[k*d+j]=psionic_ops_accumulate(acc[k*d+j],back*v[j]);}
            }
        }
    }
    for s:0..<n {g[s]=psionic_ops_total(acc[s])/f64(rows.count);}
}
// book:end gradient

tb_loss :: (m:TbModel,p:[]f64,x:[]f64,y:[]f64,rows:[]int)->f64 {
    d:=m.features;a:PsionicAccumulator;
    for r:rows {
        z:=tb_output(m,p,x[r*d..<r*d+d]);
        if m.logistic {a=psionic_ops_accumulate(a,tb_softplus(z)-y[r]*z);}
        else {e:=z-y[r];a=psionic_ops_accumulate(a,e*e/2);}
    }
    return psionic_ops_total(a)/f64(rows.count);
}

// Fisher-Yates from the last position down; returns the next unused counter.
tb_shuffle :: (order:[]int,seed:u64,counter:u64)->u64 {
    c:=counter;i:=order.count-1;
    while i>0 {
        j:=cast(int)(tb_bits(seed,c)%cast(u64)(i+1));c+=1;
        t:=order[i];order[i]=order[j];order[j]=t;i-=1;
    }
    return c;
}
// Rows times parameters, summed over every epoch, within the trainer's budget.
tb_budget :: (m:TbModel,c:TbConfig,rows:int)->bool {
    if !tb_model_ok(m) || c.epochs<1 || c.epochs>TB_EPOCHS_MAX || rows<1 || rows>TB_ROWS_MAX {return false;}
    return c.epochs*rows<=TB_WORK_MAX/tb_param_count(m);
}

// book:begin train
// Every refusal, before any work. Chapter 104's trainer shares it.
tb_admit_train :: (m:TbModel,c:TbConfig,x:[]f64,y:[]f64,rows:[]int,params:[]f64,order:[]int,overlap:bool)->TbStatus {
    n:=tb_param_count(m);d:=m.features;
    if !tb_budget(m,c,rows.count) || c.batch<1 || c.batch>TB_BATCH_MAX || !(c.rate>0 && c.rate<=16) || !tb_in(c.decay,0,1) {return TbStatus.shape;}
    if x.count!=y.count*d || !tb_row_ok(rows,y.count) {return TbStatus.shape;}
    if params.count<n || order.count<rows.count {return TbStatus.capacity;}
    if overlap {return TbStatus.alias;}
    for r:rows {
        for j:0..<d {if !tb_in(x[r*d+j],-TB_DOMAIN,TB_DOMAIN) {return TbStatus.number;}}
        if m.logistic && y[r]!=0 && y[r]!=1 {return TbStatus.number;}
        if !tb_in(y[r],-TB_DOMAIN,TB_DOMAIN) {return TbStatus.number;}
    }
    return TbStatus.ok;
}
tb_train :: (m:TbModel,c:TbConfig,x:[]f64,y:[]f64,rows:[]int,params:[]f64,order:[]int,overlap:bool)->TbTrain #export_c {
    admitted:=tb_admit_train(m,c,x,y,rows,params,order,overlap);
    if admitted!=TbStatus.ok {return TbTrain.{status=admitted};}
    n:=tb_param_count(m);
    // Train on staged copies; the caller's parameters change only on success.
    p:[161]f64;g:[161]f64;tb_initialize(m,c.init_seed,p[..]);
    o:=order[0..<rows.count];for i:0..<rows.count {o[i]=rows[i];}
    counter:=(cast(u64)0);steps:=0;
    for epoch:0..<c.epochs {
        counter=tb_shuffle(o,c.shuffle_seed,counter);
        start:=0;
        for i:0..<o.count {
            // A batch closes when it holds `batch` rows or the epoch runs out of rows.
            if i+1-start!=c.batch && i+1!=o.count {continue;}
            tb_gradient(m,p[0..<n],x,y,o[start..<i+1],g[0..<n]);
            for s:0..<n {
                step:=g[s];if tb_is_weight(m,s) {step+=c.decay*p[s];}
                next:=p[s]-c.rate*step;
                if !tb_in(next,-TB_DOMAIN,TB_DOMAIN) {return TbTrain.{status=TbStatus.update};}
                p[s]=next;
            }
            steps+=1;start=i+1;
        }
    }
    loss:=tb_loss(m,p[0..<n],x,y,rows);
    for s:0..<n {params[s]=p[s];}
    return TbTrain.{steps=steps,loss=loss};
}
// book:end train

// Outputs (logits or values) for every row; caller output and parameters must not overlap.
tb_predict :: (m:TbModel,params:[]f64,x:[]f64,out:[]f64,overlap:bool)->TbStatus #export_c {
    n:=tb_param_count(m);d:=m.features;
    if !tb_model_ok(m) || params.count<n || !tb_table_ok(x,d) {return TbStatus.shape;}
    if out.count<x.count/d {return TbStatus.capacity;}
    if overlap {return TbStatus.alias;}
    for s:0..<n {if !tb_in(params[s],-TB_DOMAIN,TB_DOMAIN) {return TbStatus.number;}}
    for v:x {if !tb_in(v,-TB_DOMAIN,TB_DOMAIN) {return TbStatus.number;}}
    for r:0..<x.count/d {out[r]=tb_output(m,params,x[r*d..<r*d+d]);}
    return TbStatus.ok;
}

// Paired outputs and targets, one to 4096 named rows, every named value finite.
tb_pairs_ok :: (a:[]f64,b:[]f64,rows:[]int)->bool {
    if a.count!=b.count || !tb_row_ok(rows,a.count) {return false;}
    for r:rows {if !tb_in(a[r],-1e300,1e300) || !tb_in(b[r],-1e300,1e300) {return false;}}
    return true;
}
// book:begin metrics
tb_log_loss :: (z:[]f64,y:[]f64,rows:[]int)->TbValue #export_c {
    if !tb_pairs_ok(z,y,rows) {return TbValue.{status=TbStatus.shape};}
    a:PsionicAccumulator;
    for r:rows {a=psionic_ops_accumulate(a,tb_softplus(z[r])-y[r]*z[r]);}
    return TbValue.{value=psionic_ops_total(a)/f64(rows.count)};
}
tb_mse :: (z:[]f64,target:[]f64,rows:[]int)->TbValue #export_c {
    if !tb_pairs_ok(z,target,rows) {return TbValue.{status=TbStatus.shape};}
    a:PsionicAccumulator;
    for r:rows {e:=z[r]-target[r];a=psionic_ops_accumulate(a,e*e);}
    return TbValue.{value=psionic_ops_total(a)/f64(rows.count)};
}
// The constant predictor: the training on-time rate as a logit.
tb_base_logit :: (y:[]f64,rows:[]int)->TbValue #export_c {
    if !tb_row_ok(rows,y.count) {return TbValue.{status=TbStatus.shape};}
    on:=0;
    for r:rows {if y[r]==1 {on+=1;}}
    if on==0 || on==rows.count {return TbValue.{status=TbStatus.number};}
    return TbValue.{value=log(f64(on)/f64(rows.count-on))};
}
// A request is flagged as late when its on-time probability is below the threshold.
// A missed late request costs `miss`; a needlessly flagged one costs `alarm`.
tb_classify :: (on_time:[]f64,y:[]f64,rows:[]int,threshold:f64,miss:f64,alarm:f64)->TbClass #export_c {
    if !tb_pairs_ok(on_time,y,rows) || !(threshold>0 && threshold<=1) || !tb_in(miss,0,TB_COST_MAX) || !tb_in(alarm,0,TB_COST_MAX) {return TbClass.{status=TbStatus.shape};}
    right:=0;late:=0;caught:=0;alarms:=0;
    for r:rows {
        flagged:=on_time[r]<threshold;was_late:=y[r]==0;
        if flagged==was_late {right+=1;}
        if was_late {late+=1;if flagged {caught+=1;}}
        else if flagged {alarms+=1;}
    }
    cost:=(miss*f64(late-caught)+alarm*f64(alarms))/f64(rows.count);
    return TbClass.{accuracy=f64(right)/f64(rows.count),cost=cost,late=late,caught=caught};
}
// The cheapest threshold among 0.05, 0.10, ..., 0.95; ties keep the smaller one.
tb_choose :: (on_time:[]f64,y:[]f64,rows:[]int,miss:f64,alarm:f64)->TbChoice #export_c {
    best:=TbChoice.{status=TbStatus.shape};
    for k:1..<20 {
        c:=tb_classify(on_time,y,rows,f64(k)/20,miss,alarm);
        if c.status!=TbStatus.ok {return TbChoice.{status=c.status};}
        if best.status!=TbStatus.ok || c.cost<best.cost {best=TbChoice.{threshold=f64(k)/20,cost=c.cost};}
    }
    return best;
}
// book:end metrics

// book:begin rule
// An operator's rule: the documented per-token and queue costs, doubled for
// safety, and nothing about memory. 1 means "on time", 0 means "flag it".
tb_rule_seconds :: (prompt:f64,queue:f64,large:f64)->f64 {
    cost:=0.0003;if large==1 {cost=0.0009;}
    return 2*(0.2+0.15*queue+prompt*cost);
}
tb_rule :: (x:[]f64,out:[]f64,overlap:bool)->TbStatus #export_c {
    if !tb_table_ok(x,4) {return TbStatus.shape;}
    if out.count<x.count/4 {return TbStatus.capacity;}
    if overlap {return TbStatus.alias;}
    for i:0..<x.count/4 {
        out[i]=0;if tb_on_time(tb_rule_seconds(x[4*i],x[4*i+1],x[4*i+2])) {out[i]=1;}
    }
    return TbStatus.ok;
}
// book:end rule
