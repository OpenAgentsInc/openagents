// Explicit bounded VJPs. These are value-operator derivatives, not a tape,
// allocator or backing-storage alias accumulation engine.
#load "tensor-ops.coax";
#authority;
ToGradient :: struct {status:ToStatus;written_a:int;written_b:int;}

#test "a broadcast VJP sums every use of the smaller operand" {
    owners:=[2]TvStorage.[tv_owner(1,1,6).storage,tv_owner(2,1,3).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=2,dims=[4]int.[2,3,0,0]},false).view,tv_contiguous(owners[1],TvShape.{rank=1,dims=[4]int.[3,0,0,0]},false).view];
    a:=[6]f32.[1,2,3,4,5,6];b:=[3]f32.[10,20,30];dy:=[6]f32.[1,2,3,4,5,6];ga:[7]f32;gb:[4]f32;sa:[7]f32;sb:[4]f32;idx:[1]int;
    r:=to_vjp_checked(ToRequest.{op=ToOp.multiply},owners[..],views[..],a[..],b[..],idx[0..<0],dy[..],ga[..],gb[..],sa[..],sb[..],false);
    #assert r.status==ToStatus.ok && r.written_a==6 && r.written_b==3 && ga[0]==10 && ga[1]==40 && ga[5]==180 && gb[0]==17 && gb[1]==29 && gb[2]==45;
}
#test "matrix VJPs and stable value permutations have hand derivatives" {
    owners:=[2]TvStorage.[tv_owner(1,1,2).storage,tv_owner(2,1,2).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=2,dims=[4]int.[1,2,0,0]},false).view,tv_contiguous(owners[1],TvShape.{rank=2,dims=[4]int.[2,1,0,0]},false).view];
    a:=[3]f32.[1,2,0];b:=[2]f32.[3,4];dy:=[3]f32.[2,0,0];ga:[3]f32;gb:[3]f32;sa:[3]f32;sb:[3]f32;idx:[1]int;
    r:=to_vjp_checked(ToRequest.{op=ToOp.matmul},owners[..],views[..],a[0..<2],b[..],idx[0..<0],dy[0..<1],ga[..],gb[..],sa[..],sb[..],false);
    #assert r.status==ToStatus.ok && ga[0]==6 && ga[1]==8 && gb[0]==2 && gb[1]==4;
    owners[0].elements=3;owners[1]=tv_owner(2,1,0).storage;views[0]=tv_contiguous(owners[0],TvShape.{rank=1,dims=[4]int.[3,0,0,0]},false).view;views[1]=tv_contiguous(owners[1],TvShape.{rank=1},false).view;
    a=[3]f32.[3,3,-1];dy=[3]f32.[1,2,3];r=to_vjp_checked(ToRequest.{op=ToOp.sort},owners[..],views[..],a[..],b[0..<0],idx[0..<0],dy[..],ga[..],gb[..],sa[..],sb[..],false);
    #assert r.status==ToStatus.ok && ga[0]==1 && ga[1]==2 && ga[2]==3;
}
#test "comparisons have no VJP and derivative work has its own limit" {
    a:=TvShape.{rank=2,dims=[4]int.[64,64,0,0]};p:=to_plan(ToRequest.{op=ToOp.matmul},a,a,0);#assert p.status==ToStatus.ok && !to_vjp_work(ToRequest.{op=ToOp.matmul},p,a);
    owners:=[2]TvStorage.[tv_owner(1,1,1).storage,tv_owner(2,1,1).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{},false).view,tv_contiguous(owners[1],TvShape.{},false).view];
    x:=[1]f32.[2];dy:=[1]f32.[1];ga:=[1]f32.[-7];gb:=[1]f32.[-8];sa:=[1]f32.[-9];sb:=[1]f32.[-10];idx:[1]int;
    r:=to_vjp_checked(ToRequest.{op=ToOp.less},owners[..],views[..],x[..],x[..],idx[0..<0],dy[..],ga[..],gb[..],sa[..],sb[..],false);
    #assert r.status==ToStatus.nondiff && ga[0]==-7 && gb[0]==-8 && sa[0]==-9 && sb[0]==-10;
}

#test "ReLU at zero and maximum ties use their frozen subgradient conventions" {
    owners:=[2]TvStorage.[tv_owner(1,1,3).storage,tv_owner(2,1,0).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=1,dims=[4]int.[3,0,0,0]},false).view,tv_contiguous(owners[1],TvShape.{rank=1},false).view];
    a:=[3]f32.[-1,0,2];none:[1]f32;dy:=[3]f32.[1,2,3];ga:[3]f32;gb:[1]f32;sa:[3]f32;sb:[1]f32;idx:[1]int;
    r:=to_vjp_checked(ToRequest.{op=ToOp.relu},owners[..],views[..],a[..],none[0..<0],idx[0..<0],dy[..],ga[..],gb[0..<0],sa[..],sb[0..<0],false);#assert r.status==ToStatus.ok && ga[0]==0 && ga[1]==0 && ga[2]==3;
    a=[3]f32.[2,2,1];r=to_vjp_checked(ToRequest.{op=ToOp.maximum},owners[..],views[..],a[..],none[0..<0],idx[0..<0],dy[0..<1],ga[..],gb[0..<0],sa[..],sb[0..<0],false);#assert r.status==ToStatus.ok && ga[0]==1 && ga[1]==0 && ga[2]==0;
}

#test "elementwise VJPs equal central differences of the forward operators" {
    for k:0..<17 {
        r:ToRequest;ash:TvShape;bsh:=TvShape.{rank=1};idx:[8]int;ni:=0;pa:=false;pb:=false;
        if k==0 {r=ToRequest.{op=ToOp.add};ash=TvShape.{rank=2,dims=[4]int.[2,1,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[1,3,0,0]};}
        if k==1 {r=ToRequest.{op=ToOp.add};ash=TvShape.{rank=1,dims=[4]int.[3,0,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==2 {r=ToRequest.{op=ToOp.add};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};bsh=TvShape.{};}
        if k==3 {r=ToRequest.{op=ToOp.subtract};ash=TvShape.{rank=2,dims=[4]int.[2,1,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[1,3,0,0]};}
        if k==4 {r=ToRequest.{op=ToOp.subtract};ash=TvShape.{rank=1,dims=[4]int.[3,0,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==5 {r=ToRequest.{op=ToOp.subtract};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};bsh=TvShape.{};}
        if k==6 {r=ToRequest.{op=ToOp.multiply};ash=TvShape.{rank=2,dims=[4]int.[2,1,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[1,3,0,0]};}
        if k==7 {r=ToRequest.{op=ToOp.multiply};ash=TvShape.{rank=1,dims=[4]int.[3,0,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==8 {r=ToRequest.{op=ToOp.multiply};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};bsh=TvShape.{};}
        if k==9 {r=ToRequest.{op=ToOp.divide};ash=TvShape.{rank=2,dims=[4]int.[2,1,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[1,3,0,0]};pb=true;}
        if k==10 {r=ToRequest.{op=ToOp.divide};ash=TvShape.{rank=1,dims=[4]int.[3,0,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};pb=true;}
        if k==11 {r=ToRequest.{op=ToOp.divide};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};bsh=TvShape.{};pb=true;}
        if k==12 {r=ToRequest.{op=ToOp.negate};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==13 {r=ToRequest.{op=ToOp.relu};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==14 {r=ToRequest.{op=ToOp.exponential};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==15 {r=ToRequest.{op=ToOp.logarithm};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};pa=true;}
        if k==16 {r=ToRequest.{op=ToOp.mse};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        na:=tv_elements(ash).elements;nb:=tv_elements(bsh).elements;p:=to_plan(r,ash,bsh,ni);n:=p.n;#assert p.status==ToStatus.ok && na<=96 && nb<=96 && n<=96;
        owners:=[2]TvStorage.[tv_owner(1,1,na).storage,tv_owner(2,1,nb).storage];views:=[2]TvView.[tv_contiguous(owners[0],ash,false).view,tv_contiguous(owners[1],bsh,false).view];
        a:[96]f32;b:[96]f32;dy:[96]f32;for i:0..<na {a[i]=f32((i*37+11)%97-48)/16+0.03125;if pa {a[i]=1+f32((i*7)%13)/4;}}
        for i:0..<nb {b[i]=f32((i*53+5)%97-48)/16+0.03125;if pb {b[i]=1+f32((i*5+3)%11)/4;}}for j:0..<n {dy[j]=f32((j*29+3)%17-8)/4+0.125;}
        ga:[96]f32;gb:[96]f32;sa:[96]f32;sb:[96]f32;
        g:=to_vjp_checked(r,owners[..],views[..],a[0..<na],b[0..<nb],idx[0..<ni],dy[0..<n],ga[..],gb[..],sa[..],sb[..],false);
        #assert g.status==ToStatus.ok && g.written_a==na && g.written_b==nb;
        for operand:0..<2 {count:=na;if operand==1 {count=nb;}
            for i:0..<count {total:f64=0;
                for side:0..<2 {xa:=a;xb:=b;step:f32=0.015625;if side==1 {step=-step;}if operand==0 {xa[i]+=step;}else {xb[i]+=step;}
                    out:[96]f32;scratch:[96]f32;aux:[96]int;stage:[96]int;
                    f:=to_forward_checked(r,owners[..],views[..],xa[0..<na],xb[0..<nb],idx[0..<ni],out[..],scratch[..],aux[..],stage[..],false);#assert f.status==ToStatus.ok;
                    for j:0..<n {term:=f64(out[j])*f64(dy[j]);if side==0 {total+=term;}else {total-=term;}}
                }
                fd:=total/0.03125;exact:=f64(ga[i]);if operand==1 {exact=f64(gb[i]);}#assert abs(fd-exact)<=0.001*(1+abs(fd));
            }
        }
    }
}
#test "reduction and softmax VJPs equal central differences on every axis" {
    for k:0..<13 {
        r:ToRequest;ash:TvShape;bsh:=TvShape.{rank=1};idx:[8]int;ni:=0;pa:=false;pb:=false;
        if k==0 {r=ToRequest.{op=ToOp.sum,axis=1};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==1 {r=ToRequest.{op=ToOp.sum,axis=2,keep=true};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==2 {r=ToRequest.{op=ToOp.sum,axis=0};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==3 {r=ToRequest.{op=ToOp.mean,axis=1,keep=true};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==4 {r=ToRequest.{op=ToOp.mean,axis=0};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==5 {r=ToRequest.{op=ToOp.mean,axis=1};ash=TvShape.{rank=2,dims=[4]int.[3,2,0,0]};}
        if k==6 {r=ToRequest.{op=ToOp.maximum,axis=1};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==7 {r=ToRequest.{op=ToOp.maximum,axis=2,keep=true};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==8 {r=ToRequest.{op=ToOp.maximum,axis=0};ash=TvShape.{rank=2,dims=[4]int.[3,4,0,0]};}
        if k==9 {r=ToRequest.{op=ToOp.maximum,axis=1};ash=TvShape.{rank=2,dims=[4]int.[2,5,0,0]};}
        if k==10 {r=ToRequest.{op=ToOp.softmax,axis=1};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==11 {r=ToRequest.{op=ToOp.softmax,axis=2};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==12 {r=ToRequest.{op=ToOp.softmax,axis=0};ash=TvShape.{rank=2,dims=[4]int.[3,2,0,0]};}
        na:=tv_elements(ash).elements;nb:=tv_elements(bsh).elements;p:=to_plan(r,ash,bsh,ni);n:=p.n;#assert p.status==ToStatus.ok && na<=96 && nb<=96 && n<=96;
        owners:=[2]TvStorage.[tv_owner(1,1,na).storage,tv_owner(2,1,nb).storage];views:=[2]TvView.[tv_contiguous(owners[0],ash,false).view,tv_contiguous(owners[1],bsh,false).view];
        a:[96]f32;b:[96]f32;dy:[96]f32;for i:0..<na {a[i]=f32((i*37+11)%97-48)/16+0.03125;if pa {a[i]=1+f32((i*7)%13)/4;}}
        for i:0..<nb {b[i]=f32((i*53+5)%97-48)/16+0.03125;if pb {b[i]=1+f32((i*5+3)%11)/4;}}for j:0..<n {dy[j]=f32((j*29+3)%17-8)/4+0.125;}
        ga:[96]f32;gb:[96]f32;sa:[96]f32;sb:[96]f32;
        g:=to_vjp_checked(r,owners[..],views[..],a[0..<na],b[0..<nb],idx[0..<ni],dy[0..<n],ga[..],gb[..],sa[..],sb[..],false);
        #assert g.status==ToStatus.ok && g.written_a==na && g.written_b==nb;
        for operand:0..<2 {count:=na;if operand==1 {count=nb;}
            for i:0..<count {total:f64=0;
                for side:0..<2 {xa:=a;xb:=b;step:f32=0.015625;if side==1 {step=-step;}if operand==0 {xa[i]+=step;}else {xb[i]+=step;}
                    out:[96]f32;scratch:[96]f32;aux:[96]int;stage:[96]int;
                    f:=to_forward_checked(r,owners[..],views[..],xa[0..<na],xb[0..<nb],idx[0..<ni],out[..],scratch[..],aux[..],stage[..],false);#assert f.status==ToStatus.ok;
                    for j:0..<n {term:=f64(out[j])*f64(dy[j]);if side==0 {total+=term;}else {total-=term;}}
                }
                fd:=total/0.03125;exact:=f64(ga[i]);if operand==1 {exact=f64(gb[i]);}#assert abs(fd-exact)<=0.001*(1+abs(fd));
            }
        }
    }
}
#test "indexed concatenation and ordering VJPs equal central differences" {
    for k:0..<15 {
        r:ToRequest;ash:TvShape;bsh:=TvShape.{rank=1};idx:[8]int;ni:=0;pa:=false;pb:=false;
        if k==0 {r=ToRequest.{op=ToOp.take,axis=0};ash=TvShape.{rank=2,dims=[4]int.[3,2,0,0]};idx[0]=2;idx[1]=0;idx[2]=2;idx[3]=1;ni=4;}
        if k==1 {r=ToRequest.{op=ToOp.take,axis=1};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};idx[0]=1;idx[1]=2;ni=2;}
        if k==2 {r=ToRequest.{op=ToOp.take,axis=1};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};idx[0]=2;idx[1]=2;idx[2]=0;ni=3;}
        if k==3 {r=ToRequest.{op=ToOp.update,axis=0};ash=TvShape.{rank=2,dims=[4]int.[4,2,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,2,0,0]};idx[0]=3;idx[1]=1;ni=2;}
        if k==4 {r=ToRequest.{op=ToOp.update,axis=0};ash=TvShape.{rank=2,dims=[4]int.[4,2,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,2,0,0]};idx[0]=1;idx[1]=1;ni=2;}
        if k==5 {r=ToRequest.{op=ToOp.update,axis=1};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,2,0,0]};idx[0]=2;idx[1]=0;ni=2;}
        if k==6 {r=ToRequest.{op=ToOp.concat,axis=1};ash=TvShape.{rank=2,dims=[4]int.[2,2,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==7 {r=ToRequest.{op=ToOp.concat,axis=0};ash=TvShape.{rank=2,dims=[4]int.[1,3,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};}
        if k==8 {r=ToRequest.{op=ToOp.concat,axis=1};ash=TvShape.{rank=3,dims=[4]int.[2,1,2,0]};bsh=TvShape.{rank=3,dims=[4]int.[2,2,2,0]};}
        if k==9 {r=ToRequest.{op=ToOp.sort,axis=1};ash=TvShape.{rank=2,dims=[4]int.[2,4,0,0]};}
        if k==10 {r=ToRequest.{op=ToOp.sort,axis=0,descending=false};ash=TvShape.{rank=2,dims=[4]int.[3,2,0,0]};}
        if k==11 {r=ToRequest.{op=ToOp.sort,axis=1};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        if k==12 {r=ToRequest.{op=ToOp.topk,axis=1,k=2};ash=TvShape.{rank=2,dims=[4]int.[2,4,0,0]};}
        if k==13 {r=ToRequest.{op=ToOp.topk,axis=0,k=2,descending=false};ash=TvShape.{rank=2,dims=[4]int.[3,2,0,0]};}
        if k==14 {r=ToRequest.{op=ToOp.topk,axis=1,k=1};ash=TvShape.{rank=3,dims=[4]int.[2,3,2,0]};}
        na:=tv_elements(ash).elements;nb:=tv_elements(bsh).elements;p:=to_plan(r,ash,bsh,ni);n:=p.n;#assert p.status==ToStatus.ok && na<=96 && nb<=96 && n<=96;
        owners:=[2]TvStorage.[tv_owner(1,1,na).storage,tv_owner(2,1,nb).storage];views:=[2]TvView.[tv_contiguous(owners[0],ash,false).view,tv_contiguous(owners[1],bsh,false).view];
        a:[96]f32;b:[96]f32;dy:[96]f32;for i:0..<na {a[i]=f32((i*37+11)%97-48)/16+0.03125;if pa {a[i]=1+f32((i*7)%13)/4;}}
        for i:0..<nb {b[i]=f32((i*53+5)%97-48)/16+0.03125;if pb {b[i]=1+f32((i*5+3)%11)/4;}}for j:0..<n {dy[j]=f32((j*29+3)%17-8)/4+0.125;}
        ga:[96]f32;gb:[96]f32;sa:[96]f32;sb:[96]f32;
        g:=to_vjp_checked(r,owners[..],views[..],a[0..<na],b[0..<nb],idx[0..<ni],dy[0..<n],ga[..],gb[..],sa[..],sb[..],false);
        #assert g.status==ToStatus.ok && g.written_a==na && g.written_b==nb;
        for operand:0..<2 {count:=na;if operand==1 {count=nb;}
            for i:0..<count {total:f64=0;
                for side:0..<2 {xa:=a;xb:=b;step:f32=0.015625;if side==1 {step=-step;}if operand==0 {xa[i]+=step;}else {xb[i]+=step;}
                    out:[96]f32;scratch:[96]f32;aux:[96]int;stage:[96]int;
                    f:=to_forward_checked(r,owners[..],views[..],xa[0..<na],xb[0..<nb],idx[0..<ni],out[..],scratch[..],aux[..],stage[..],false);#assert f.status==ToStatus.ok;
                    for j:0..<n {term:=f64(out[j])*f64(dy[j]);if side==0 {total+=term;}else {total-=term;}}
                }
                fd:=total/0.03125;exact:=f64(ga[i]);if operand==1 {exact=f64(gb[i]);}#assert abs(fd-exact)<=0.001*(1+abs(fd));
            }
        }
    }
}
#test "matrix and convolution VJPs equal central differences" {
    for k:0..<4 {
        r:ToRequest;ash:TvShape;bsh:=TvShape.{rank=1};idx:[8]int;ni:=0;pa:=false;pb:=false;
        if k==0 {r=ToRequest.{op=ToOp.matmul};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[3,4,0,0]};}
        if k==1 {r=ToRequest.{op=ToOp.matmul};ash=TvShape.{rank=2,dims=[4]int.[3,1,0,0]};bsh=TvShape.{rank=2,dims=[4]int.[1,2,0,0]};}
        if k==2 {r=ToRequest.{op=ToOp.conv2d};ash=TvShape.{rank=4,dims=[4]int.[2,2,3,3]};bsh=TvShape.{rank=4,dims=[4]int.[2,2,2,2]};}
        if k==3 {r=ToRequest.{op=ToOp.conv2d};ash=TvShape.{rank=4,dims=[4]int.[1,1,3,4]};bsh=TvShape.{rank=4,dims=[4]int.[3,1,2,3]};}
        na:=tv_elements(ash).elements;nb:=tv_elements(bsh).elements;p:=to_plan(r,ash,bsh,ni);n:=p.n;#assert p.status==ToStatus.ok && na<=96 && nb<=96 && n<=96;
        owners:=[2]TvStorage.[tv_owner(1,1,na).storage,tv_owner(2,1,nb).storage];views:=[2]TvView.[tv_contiguous(owners[0],ash,false).view,tv_contiguous(owners[1],bsh,false).view];
        a:[96]f32;b:[96]f32;dy:[96]f32;for i:0..<na {a[i]=f32((i*37+11)%97-48)/16+0.03125;if pa {a[i]=1+f32((i*7)%13)/4;}}
        for i:0..<nb {b[i]=f32((i*53+5)%97-48)/16+0.03125;if pb {b[i]=1+f32((i*5+3)%11)/4;}}for j:0..<n {dy[j]=f32((j*29+3)%17-8)/4+0.125;}
        ga:[96]f32;gb:[96]f32;sa:[96]f32;sb:[96]f32;
        g:=to_vjp_checked(r,owners[..],views[..],a[0..<na],b[0..<nb],idx[0..<ni],dy[0..<n],ga[..],gb[..],sa[..],sb[..],false);
        #assert g.status==ToStatus.ok && g.written_a==na && g.written_b==nb;
        for operand:0..<2 {count:=na;if operand==1 {count=nb;}
            for i:0..<count {total:f64=0;
                for side:0..<2 {xa:=a;xb:=b;step:f32=0.015625;if side==1 {step=-step;}if operand==0 {xa[i]+=step;}else {xb[i]+=step;}
                    out:[96]f32;scratch:[96]f32;aux:[96]int;stage:[96]int;
                    f:=to_forward_checked(r,owners[..],views[..],xa[0..<na],xb[0..<nb],idx[0..<ni],out[..],scratch[..],aux[..],stage[..],false);#assert f.status==ToStatus.ok;
                    for j:0..<n {term:=f64(out[j])*f64(dy[j]);if side==0 {total+=term;}else {total-=term;}}
                }
                fd:=total/0.03125;exact:=f64(ga[i]);if operand==1 {exact=f64(gb[i]);}#assert abs(fd-exact)<=0.001*(1+abs(fd));
            }
        }
    }
}
#test "pooling interpolation and loss VJPs equal central differences" {
    for k:0..<12 {
        r:ToRequest;ash:TvShape;bsh:=TvShape.{rank=1};idx:[8]int;ni:=0;pa:=false;pb:=false;
        if k==0 {r=ToRequest.{op=ToOp.maxpool2d,height=2,width=2};ash=TvShape.{rank=4,dims=[4]int.[2,2,3,3]};}
        if k==1 {r=ToRequest.{op=ToOp.maxpool2d,height=2,width=3,stride=2};ash=TvShape.{rank=4,dims=[4]int.[1,1,4,5]};}
        if k==2 {r=ToRequest.{op=ToOp.avgpool2d,height=2,width=1,stride=2};ash=TvShape.{rank=4,dims=[4]int.[2,2,4,4]};}
        if k==3 {r=ToRequest.{op=ToOp.avgpool2d,height=2,width=3,stride=2};ash=TvShape.{rank=4,dims=[4]int.[1,1,4,5]};}
        if k==4 {r=ToRequest.{op=ToOp.avgpool2d,height=2,width=2};ash=TvShape.{rank=4,dims=[4]int.[1,2,3,3]};}
        if k==5 {r=ToRequest.{op=ToOp.nearest2d,height=2,width=5};ash=TvShape.{rank=4,dims=[4]int.[2,2,3,2]};}
        if k==6 {r=ToRequest.{op=ToOp.nearest2d,height=3,width=2};ash=TvShape.{rank=4,dims=[4]int.[1,1,2,3]};}
        if k==7 {r=ToRequest.{op=ToOp.bilinear2d,height=3,width=3};ash=TvShape.{rank=4,dims=[4]int.[2,2,2,2]};}
        if k==8 {r=ToRequest.{op=ToOp.bilinear2d,height=2,width=3};ash=TvShape.{rank=4,dims=[4]int.[1,1,3,4]};}
        if k==9 {r=ToRequest.{op=ToOp.bilinear2d,height=3,width=5};ash=TvShape.{rank=4,dims=[4]int.[1,1,2,3]};}
        if k==10 {r=ToRequest.{op=ToOp.cross_entropy};ash=TvShape.{rank=2,dims=[4]int.[3,4,0,0]};idx[0]=2;idx[1]=0;idx[2]=3;ni=3;}
        if k==11 {r=ToRequest.{op=ToOp.cross_entropy};ash=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};idx[0]=1;idx[1]=1;ni=2;}
        na:=tv_elements(ash).elements;nb:=tv_elements(bsh).elements;p:=to_plan(r,ash,bsh,ni);n:=p.n;#assert p.status==ToStatus.ok && na<=96 && nb<=96 && n<=96;
        owners:=[2]TvStorage.[tv_owner(1,1,na).storage,tv_owner(2,1,nb).storage];views:=[2]TvView.[tv_contiguous(owners[0],ash,false).view,tv_contiguous(owners[1],bsh,false).view];
        a:[96]f32;b:[96]f32;dy:[96]f32;for i:0..<na {a[i]=f32((i*37+11)%97-48)/16+0.03125;if pa {a[i]=1+f32((i*7)%13)/4;}}
        for i:0..<nb {b[i]=f32((i*53+5)%97-48)/16+0.03125;if pb {b[i]=1+f32((i*5+3)%11)/4;}}for j:0..<n {dy[j]=f32((j*29+3)%17-8)/4+0.125;}
        ga:[96]f32;gb:[96]f32;sa:[96]f32;sb:[96]f32;
        g:=to_vjp_checked(r,owners[..],views[..],a[0..<na],b[0..<nb],idx[0..<ni],dy[0..<n],ga[..],gb[..],sa[..],sb[..],false);
        #assert g.status==ToStatus.ok && g.written_a==na && g.written_b==nb;
        for operand:0..<2 {count:=na;if operand==1 {count=nb;}
            for i:0..<count {total:f64=0;
                for side:0..<2 {xa:=a;xb:=b;step:f32=0.015625;if side==1 {step=-step;}if operand==0 {xa[i]+=step;}else {xb[i]+=step;}
                    out:[96]f32;scratch:[96]f32;aux:[96]int;stage:[96]int;
                    f:=to_forward_checked(r,owners[..],views[..],xa[0..<na],xb[0..<nb],idx[0..<ni],out[..],scratch[..],aux[..],stage[..],false);#assert f.status==ToStatus.ok;
                    for j:0..<n {term:=f64(out[j])*f64(dy[j]);if side==0 {total+=term;}else {total-=term;}}
                }
                fd:=total/0.03125;exact:=f64(ga[i]);if operand==1 {exact=f64(gb[i]);}#assert abs(fd-exact)<=0.001*(1+abs(fd));
            }
        }
    }
}

#test "derivative work admits each family's exact ceiling and refuses one past it" {
    none:=TvShape.{rank=1};
    // pairs = (na+nb)*n against TV_LIMIT/factor; the factor is each family's inner Jacobian walk.
    a:=TvShape.{rank=1,dims=[4]int.[1023,0,0,0]};r:=ToRequest.{};p:=to_plan(r,a,TvShape.{},0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[0]=1024;p=to_plan(r,a,TvShape.{},0);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a=TvShape.{rank=2,dims=[4]int.[4,256,0,0]};r=ToRequest.{op=ToOp.maximum,axis=1};p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[1]=257;p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a=TvShape.{rank=2,dims=[4]int.[2,64,0,0]};r=ToRequest.{op=ToOp.sort,axis=1};p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[1]=65;p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a=TvShape.{rank=2,dims=[4]int.[4,256,0,0]};r=ToRequest.{op=ToOp.topk,axis=1,k=1};p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[1]=257;p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a=TvShape.{rank=2,dims=[4]int.[1,80,0,0]};r=ToRequest.{op=ToOp.softmax,axis=1};p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[1]=81;p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a=TvShape.{rank=4,dims=[4]int.[1,1,1,724]};r=ToRequest.{op=ToOp.maxpool2d,height=1,width=2};p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[3]=725;p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a=TvShape.{rank=1,dims=[4]int.[723,0,0,0]};b:=TvShape.{rank=1,dims=[4]int.[2,0,0,0]};r=ToRequest.{op=ToOp.update};p=to_plan(r,a,b,2);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[0]=724;p=to_plan(r,a,b,2);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a.dims[0]=1024;p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a=TvShape.{rank=2,dims=[4]int.[1,1024,0,0]};r=ToRequest.{op=ToOp.cross_entropy};p=to_plan(r,a,none,1);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
    a.dims[1]=1025;p=to_plan(r,a,none,1);#assert p.status==ToStatus.ok && !to_vjp_work(r,p,a);
    a=TvShape.{rank=2,dims=[4]int.[1,1025,0,0]};r=ToRequest.{op=ToOp.mean,axis=1};p=to_plan(r,a,none,0);#assert p.status==ToStatus.ok && to_vjp_work(r,p,a);
}
#test "the checked VJP measures work on the differentiated operand" {
    owners:=[2]TvStorage.[tv_owner(1,1,1028).storage,tv_owner(2,1,0).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=2,dims=[4]int.[4,257,0,0]},false).view,tv_contiguous(owners[1],TvShape.{rank=1},false).view];
    a:[1028]f32;none:[1]f32;dy:[4]f32;ga:[1028]f32;sa:[1028]f32;idx:[1]int;
    r:=to_vjp_checked(ToRequest.{op=ToOp.maximum,axis=1},owners[..],views[..],a[..],none[0..<0],idx[0..<0],dy[..],ga[..],none[0..<0],sa[..],none[0..<0],false);
    #assert r.status==ToStatus.limit && r.written_a==0;
}
#test "every gradient capacity is checked on its own and refusals keep destinations" {
