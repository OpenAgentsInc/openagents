    a:=[2]f32.[1,2];b:=[2]f32.[3,4];dy:=[3]f32.[1,1,1];ga:=[2]f32.[-7,-7];gb:=[2]f32.[-8,-8];sa:=[2]f32.[-9,-9];sb:=[2]f32.[-6,-6];idx:[1]int;m:=ToRequest.{op=ToOp.multiply};
    #assert to_vjp_checked(m,owners[..],views[..],a[..],b[..],idx[0..<0],dy[0..<1],ga[..],gb[..],sa[..],sb[..],false).status==ToStatus.capacity;
    #assert to_vjp_checked(m,owners[..],views[..],a[..],b[..],idx[0..<0],dy[..],ga[..],gb[..],sa[..],sb[..],false).status==ToStatus.capacity;
    #assert to_vjp_checked(m,owners[..],views[..],a[..],b[..],idx[0..<0],dy[0..<2],ga[0..<1],gb[..],sa[..],sb[..],false).status==ToStatus.capacity;
    #assert to_vjp_checked(m,owners[..],views[..],a[..],b[..],idx[0..<0],dy[0..<2],ga[..],gb[0..<1],sa[..],sb[..],false).status==ToStatus.capacity;
    #assert to_vjp_checked(m,owners[..],views[..],a[..],b[..],idx[0..<0],dy[0..<2],ga[..],gb[..],sa[0..<1],sb[..],false).status==ToStatus.capacity;
    #assert to_vjp_checked(m,owners[..],views[..],a[..],b[..],idx[0..<0],dy[0..<2],ga[..],gb[..],sa[..],sb[0..<1],false).status==ToStatus.capacity;
