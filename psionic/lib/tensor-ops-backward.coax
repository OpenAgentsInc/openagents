#test "a forward value the profile refuses has no derivative" {
    owners:=[2]TvStorage.[tv_owner(1,1,1).storage,tv_owner(2,1,1).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{},false).view,tv_contiguous(owners[1],TvShape.{},false).view];
    big:=[1]f32.[1e30];dy:=[1]f32.[1];ga:=[1]f32.[-7];gb:=[1]f32.[-8];sa:=[1]f32.[-9];sb:=[1]f32.[-10];idx:[1]int;
    r:=to_vjp_checked(ToRequest.{op=ToOp.multiply},owners[..],views[..],big[..],big[..],idx[0..<0],dy[..],ga[..],gb[..],sa[..],sb[..],false);
    #assert r.status==ToStatus.arithmetic && ga[0]==-7 && gb[0]==-8 && sa[0]==-9;
    owners[1]=tv_owner(2,1,0).storage;views[1]=tv_contiguous(owners[1],TvShape.{rank=1},false).view;none:[1]f32;
    x:=[1]f32.[-1];r=to_vjp_checked(ToRequest.{op=ToOp.logarithm},owners[..],views[..],x[..],none[0..<0],idx[0..<0],dy[..],ga[..],gb[0..<0],sa[..],sb[0..<0],false);
    #assert r.status==ToStatus.arithmetic && ga[0]==-7 && sa[0]==-9;
