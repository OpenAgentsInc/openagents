// The plan's inner width is the pooling window and update's search (at least one).
to_vjp_work :: (r:ToRequest,p:ToPlan,a:TvShape)->bool {
    n:=p.na+p.nb;if !to_work_fits(n,p.n) {return false;}pairs:=n*p.n;factor:=1;
    if r.op==ToOp.maximum || r.op==ToOp.sort || r.op==ToOp.topk {factor=a.dims[r.axis];}
    else if r.op==ToOp.softmax {factor=2*a.dims[r.axis];}
    else if r.op==ToOp.maxpool2d || r.op==ToOp.update {factor=p.inner;}
    else if r.op==ToOp.cross_entropy {factor=a.dims[1];}
    return to_work_fits(pairs,factor);
}
// One analytical Jacobian entry. The VJP contracts it with dy in output
// order, using an independent work admission before any derivative is run.
to_jacobian :: (r:ToRequest,p:ToPlan,av:TvView,bv:TvView,a:[]f32,b:[]f32,indices:[]int,operand:int,input:int,output:int)->f64 {
    op:=r.op;
    if cast(u8)op<=3 {ai:=to_broadcast_index(av.shape,p.shape,output);bi:=to_broadcast_index(bv.shape,p.shape,output);selected:=ai;if operand==1 {selected=bi;}if input!=selected {return 0;}x:=to_at(av,a,ai);y:=to_at(bv,b,bi);
        if op==ToOp.add {return 1;}if op==ToOp.subtract {if operand==0 {return 1;}return -1;}if op==ToOp.multiply {if operand==0 {return y;}return x;}if operand==0 {return 1/y;}return -x/(y*y);
    }
    if op==ToOp.negate || op==ToOp.relu || op==ToOp.exponential || op==ToOp.logarithm {if input!=output {return 0;}x:=to_at(av,a,input);if op==ToOp.negate {return -1;}if op==ToOp.relu {if x>0 {return 1;}return 0;}if op==ToOp.exponential {return exp(x);}return 1/x;}
    c:=to_coords(p.shape,output);shape:=av.shape;if operand==1 {shape=bv.shape;}ic:=to_coords(shape,input);
    if op==ToOp.sum || op==ToOp.mean || op==ToOp.maximum {point:=to_reduce_coords(av.shape,p,r,output);for axis:0..<av.shape.rank {if axis!=r.axis && ic[axis]!=point[axis] {return 0;}}
        if op==ToOp.sum {return 1;}if op==ToOp.mean {return 1/f64(av.shape.dims[r.axis]);}maximum:=to_read(av,a,point);best:=0;
        for j:1..<av.shape.dims[r.axis] {point[r.axis]=j;x:=to_read(av,a,point);if x>maximum {maximum=x;best=j;}}if ic[r.axis]==best {return 1;}return 0;
    }
    if op==ToOp.softmax {for axis:0..<av.shape.rank {if axis!=r.axis && ic[axis]!=c[axis] {return 0;}}y:=to_soft(av,a,c,r.axis);x:=to_soft(av,a,ic,r.axis);diagonal:f64=0;if ic[r.axis]==c[r.axis] {diagonal=1;}return y*(diagonal-x);}
    if op==ToOp.take {point:=c;point[r.axis]=indices[c[r.axis]];if input==to_flat(av.shape,point) {return 1;}return 0;}
    if op==ToOp.update {selected:=-1;for j:0..<indices.count {if indices[j]==c[r.axis] {selected=j;}}
        if operand==0 {if selected<0 && input==output {return 1;}return 0;}if selected<0 {return 0;}point:=c;point[r.axis]=selected;if input==to_flat(bv.shape,point) {return 1;}return 0;
    }
    if op==ToOp.concat {point:=c;if c[r.axis]<av.shape.dims[r.axis] {if operand==0 && input==to_flat(av.shape,point) {return 1;}return 0;}
        point[r.axis]-=av.shape.dims[r.axis];if operand==1 && input==to_flat(bv.shape,point) {return 1;}return 0;
    }
    if op==ToOp.sort || op==ToOp.topk {for axis:0..<av.shape.rank {if axis!=r.axis && ic[axis]!=c[axis] {return 0;}}if to_rank(av,a,ic,r.axis,r.descending)==c[r.axis] {return 1;}return 0;}
    if op==ToOp.matmul {point:=c;if operand==0 {if ic[0]==c[0] {point[0]=ic[1];return to_read(bv,b,point);}return 0;}if ic[1]==c[1] {point[1]=ic[0];return to_read(av,a,point);}return 0;}
    if op==ToOp.conv2d {if operand==0 {h:=ic[2]-c[2];w:=ic[3]-c[3];if ic[0]!=c[0] || h<0 || h>=bv.shape.dims[2] || w<0 || w>=bv.shape.dims[3] {return 0;}return to_read(bv,b,[4]int.[c[1],ic[1],h,w]);}
        if ic[0]!=c[1] {return 0;}return to_read(av,a,[4]int.[c[0],ic[1],c[2]+ic[2],c[3]+ic[3]]);
    }
    if op==ToOp.maxpool2d {if input==to_pool_best(av,a,c,r) {return 1;}return 0;}
    if op==ToOp.avgpool2d {h:=ic[2]-c[2]*r.stride;w:=ic[3]-c[3]*r.stride;if ic[0]==c[0] && ic[1]==c[1] && h>=0 && h<r.height && w>=0 && w<r.width {return 1/f64(p.inner);}return 0;}
    if op==ToOp.nearest2d {if ic[0]==c[0] && ic[1]==c[1] && ic[2]==c[2]*av.shape.dims[2]/r.height && ic[3]==c[3]*av.shape.dims[3]/r.width {return 1;}return 0;}
    if op==ToOp.bilinear2d {if ic[0]!=c[0] || ic[1]!=c[1] {return 0;}h:=to_point(c[2],av.shape.dims[2],r.height);w:=to_point(c[3],av.shape.dims[3],r.width);weight:f64=0;
        if ic[2]==h.low && ic[3]==w.low {weight+=(1-h.fraction)*(1-w.fraction);}if ic[2]==h.low && ic[3]==w.high {weight+=(1-h.fraction)*w.fraction;}
        if ic[2]==h.high && ic[3]==w.low {weight+=h.fraction*(1-w.fraction);}if ic[2]==h.high && ic[3]==w.high {weight+=h.fraction*w.fraction;}return weight;
    }
    if op==ToOp.mse {value:=2*(to_at(av,a,input)-to_at(bv,b,input))/f64(p.na);if operand==1 {value=-value;}return value;}
    if op==ToOp.cross_entropy {value:=to_soft(av,a,ic,1);if ic[1]==indices[ic[0]] {value-=1;}return value/f64(av.shape.dims[0]);}
    return 0;
}
// book:begin vjp
to_vjp_checked :: (r:ToRequest,owners:[]TvStorage,views:[]TvView,a:[]f32,b:[]f32,indices:[]int,dy:[]f32,ga:[]f32,gb:[]f32,sa:[]f32,sb:[]f32,overlap:bool)->ToGradient #export_c {
    p:=to_admit(r,owners,views,a,b,indices);if p.status!=ToStatus.ok {return ToGradient.{status=p.status};}
    if !to_differentiable(r.op) {return ToGradient.{status=ToStatus.nondiff};}
    if !to_vjp_work(r,p,views[0].shape) {return ToGradient.{status=ToStatus.limit};}
    if dy.count!=p.n || ga.count<p.na || gb.count<p.nb || sa.count<p.na || sb.count<p.nb {return ToGradient.{status=ToStatus.capacity};}
    if overlap {return ToGradient.{status=ToStatus.alias};}for x:dy {if !tv_finite(x) {return ToGradient.{status=ToStatus.number};}}
    // A derivative is admitted only where this forward profile succeeds.
    for j:0..<p.n {value:=to_eval(r,p,views[0],views[1],a,b,indices,j);if value.status!=ToStatus.ok || !to_fits(value.value) {return ToGradient.{status=ToStatus.arithmetic};}}
    for operand:0..<2 {count:=p.na;if operand==1 {count=p.nb;}
        for i:0..<count {total:ToWide;for j:0..<p.n {entry:=to_jacobian(r,p,views[0],views[1],a,b,indices,operand,i,j);total=to_accumulate(total,entry*f64(dy[j]));}
            value:=to_total(total);if !to_fits(value) {return ToGradient.{status=ToStatus.arithmetic};}if operand==0 {sa[i]=f32(value);}else {sb[i]=f32(value);}}
    }
    for i:0..<p.na {ga[i]=sa[i];}for i:0..<p.nb {gb[i]=sb[i];}return ToGradient.{written_a=p.na,written_b=p.nb};
}
// book:end vjp
