#load "tensor-ops-contract.coax";
#authority;
ToWide :: struct {sum:f64;correction:f64;}
ToValue :: struct {status:ToStatus;value:f64;index:int;}
ToPoint :: struct {low:int;high:int;fraction:f64;}

#test "broadcast arithmetic reductions and gradients use logical view order" {
    owners:=[2]TvStorage.[tv_owner(1,1,6).storage,tv_owner(2,1,3).storage];
    views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=2,dims=[4]int.[2,3,0,0]},false).view,tv_contiguous(owners[1],TvShape.{rank=1,dims=[4]int.[3,0,0,0]},false).view];
    a:=[6]f32.[1,2,3,4,5,6];b:=[3]f32.[10,20,30];idx:[1]int;out:[8]f32;scratch:[8]f32;aux:[1]int;stage:[1]int;
    r:=to_forward_checked(ToRequest.{},owners[..],views[..],a[..],b[..],idx[0..<0],out[..],scratch[..],aux[0..<0],stage[0..<0],false);
    #assert r.status==ToStatus.ok && r.written==6 && out[0]==11 && out[2]==33 && out[3]==14 && out[5]==36;
    owners[1]=tv_owner(2,1,0).storage;views[1]=tv_contiguous(owners[1],TvShape.{rank=1},false).view;
    r=to_forward_checked(ToRequest.{op=ToOp.sum,axis=0},owners[..],views[..],a[..],b[0..<0],idx[0..<0],out[..],scratch[..],aux[0..<0],stage[0..<0],false);
    #assert r.status==ToStatus.ok && r.written==3 && out[0]==5 && out[1]==7 && out[2]==9;
}
#test "stable sorting and topk retain lowest axis indices on ties" {
    owners:=[2]TvStorage.[tv_owner(1,1,4).storage,tv_owner(2,1,0).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=1,dims=[4]int.[4,0,0,0]},false).view,tv_contiguous(owners[1],TvShape.{rank=1},false).view];
    a:=[4]f32.[5,2,5,-1];none:[1]f32;idx:[1]int;out:=[5]f32.[-7,-7,-7,-7,-7];scratch:[5]f32;aux:=[5]int.[-9,-9,-9,-9,-9];stage:[5]int;
    r:=to_forward_checked(ToRequest.{op=ToOp.topk,k=3},owners[..],views[..],a[..],none[0..<0],idx[0..<0],out[..],scratch[..],aux[..],stage[..],false);
    #assert r.status==ToStatus.ok && r.written==3 && r.aux_written==3 && out[0]==5 && out[1]==5 && out[2]==2 && aux[0]==0 && aux[1]==2 && aux[2]==1 && aux[3]==-9 && out[3]==-7;
}
#test "wide cancellation and empty sum preserve their explicit identities" {
    owners:=[2]TvStorage.[tv_owner(1,1,3).storage,tv_owner(2,1,0).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=1,dims=[4]int.[3,0,0,0]},false).view,tv_contiguous(owners[1],TvShape.{rank=1},false).view];
    a:=[3]f32.[1e20,1,-1e20];none:[1]f32;idx:[1]int;out:[2]f32;scratch:[2]f32;aux:[1]int;
    r:=to_forward_checked(ToRequest.{op=ToOp.sum},owners[..],views[..],a[..],none[0..<0],idx[0..<0],out[..],scratch[..],aux[0..<0],aux[0..<0],false);
    #assert r.status==ToStatus.ok && out[0]==1;
    owners[0]=tv_owner(1,1,0).storage;views[0]=tv_contiguous(owners[0],TvShape.{rank=2,dims=[4]int.[2,0,0,0]},false).view;
    r=to_forward_checked(ToRequest.{op=ToOp.sum,axis=1},owners[..],views[..],a[0..<0],none[0..<0],idx[0..<0],out[..],scratch[..],aux[0..<0],aux[0..<0],false);
    #assert r.status==ToStatus.ok && r.written==2 && out[0]==0 && out[1]==0;
}
#test "loss and half-pixel interpolation have independent small oracles" {
    owners:=[2]TvStorage.[tv_owner(1,1,4).storage,tv_owner(2,1,0).storage];views:=[2]TvView.[tv_contiguous(owners[0],TvShape.{rank=4,dims=[4]int.[1,1,2,2]},false).view,tv_contiguous(owners[1],TvShape.{rank=1},false).view];
    a:=[4]f32.[1,2,3,4];none:[1]f32;idx:=[1]int.[1];out:[10]f32;scratch:[10]f32;aux:[1]int;
    r:=to_forward_checked(ToRequest.{op=ToOp.bilinear2d,height=3,width=3},owners[..],views[..],a[..],none[0..<0],idx[0..<0],out[..],scratch[..],aux[0..<0],aux[0..<0],false);
    #assert r.status==ToStatus.ok && out[0]==1 && out[1]==1.5 && out[4]==2.5 && out[7]==3.5 && out[8]==4;
    a[0]=0;a[1]=0;owners[0].elements=2;views[0]=tv_contiguous(owners[0],TvShape.{rank=2,dims=[4]int.[1,2,0,0]},false).view;
    r=to_forward_checked(ToRequest.{op=ToOp.cross_entropy},owners[..],views[..],a[0..<2],none[0..<0],idx[..],out[..],scratch[..],aux[0..<0],aux[0..<0],false);
    #assert r.status==ToStatus.ok && abs(f64(out[0])-0.6931471805599453)<0.000001;
}
#test "domain overflow shape and alias refusals preserve public destinations" {
    owners:=[2]TvStorage.[tv_owner(1,1,2).storage,tv_owner(2,1,2).storage];shape:=TvShape.{rank=1,dims=[4]int.[2,0,0,0]};views:=[2]TvView.[tv_contiguous(owners[0],shape,false).view,tv_contiguous(owners[1],shape,false).view];
    a:=[2]f32.[1,f32_from_bits(0x7f7fffff)];b:=a;out:=[3]f32.[-7,-7,-7];scratch:=[3]f32.[-9,-9,-9];idx:[1]int;
    r:=to_forward_checked(ToRequest.{},owners[..],views[..],a[..],b[..],idx[0..<0],out[..],scratch[..],idx[0..<0],idx[0..<0],false);
    #assert r.status==ToStatus.arithmetic && r.written==0 && out[0]==-7 && out[1]==-7 && scratch[0]==2 && scratch[2]==-9;
    r=to_forward_checked(ToRequest.{},owners[..],views[..],a[..],b[..],idx[0..<0],out[..],scratch[..],idx[0..<0],idx[0..<0],true);#assert r.status==ToStatus.alias && out[0]==-7;
    b[1]=0;r=to_forward_checked(ToRequest.{op=ToOp.divide},owners[..],views[..],a[..],b[..],idx[0..<0],out[..],scratch[..],idx[0..<0],idx[0..<0],false);#assert r.status==ToStatus.arithmetic && out[0]==-7;
}

#test "softmax and max pooling have stable shifted and first-tie behavior" {
    owner:=tv_owner(1,1,4).storage;v:=tv_contiguous(owner,TvShape.{rank=4,dims=[4]int.[1,1,2,2]},false).view;
    values:=[4]f32.[3,3,1,2];#assert to_pool_best(v,values[..],[4]int.[0,0,0,0],ToRequest.{height=2,width=2,stride=1})==0;
    v=tv_contiguous(owner,TvShape.{rank=1,dims=[4]int.[4,0,0,0]},false).view;values=[4]f32.[1000,1000,1000,1000];
    #assert to_soft(v,values[..],[4]int.[2,0,0,0],0)==0.25;
}

to_accumulate :: (s:ToWide,value:f64)->ToWide {next:=s.sum+value;virtual_value:=next-s.sum;error:=(s.sum-(next-virtual_value))+(value-virtual_value);return ToWide.{sum=next,correction=s.correction+error};}
to_total :: (s:ToWide)->f64 {return s.sum+s.correction;}
to_fits :: (value:f64)->bool {return abs(value)<=3.4028234663852886e38;}
to_coords :: (shape:TvShape,linear:int)->[4]int {c:[4]int;n:=linear;i:=shape.rank;while i>0 {i-=1;c[i]=n%shape.dims[i];n/=shape.dims[i];}return c;}
to_flat :: (shape:TvShape,c:[4]int)->int {n:=0;for i:0..<shape.rank {n=n*shape.dims[i]+c[i];}return n;}
to_at :: (v:TvView,data:[]f32,linear:int)->f64 {return f64(data[tv_offset(v,linear)]);}
to_read :: (v:TvView,data:[]f32,c:[4]int)->f64 {offset:=v.offset;for i:0..<v.shape.rank {offset+=c[i]*v.strides[i];}return f64(data[offset]);}
to_broadcast_index :: (input:TvShape,output:TvShape,linear:int)->int {c:=to_coords(output,linear);n:=0;shift:=output.rank-input.rank;for i:0..<input.rank {value:=0;if input.dims[i]!=1 {value=c[i+shift];}n=n*input.dims[i]+value;}return n;}
to_reduce_coords :: (a:TvShape,p:ToPlan,r:ToRequest,linear:int)->[4]int {o:=to_coords(p.shape,linear);c:[4]int;j:=0;for i:0..<a.rank {if i!=r.axis {if r.keep {c[i]=o[i];}else {c[i]=o[j];j+=1;}}}return c;}
to_rank :: (v:TvView,data:[]f32,c:[4]int,axis:int,descending:bool)->int {selected:=c[axis];value:=to_read(v,data,c);other:=c;rank:=0;for j:0..<v.shape.dims[axis] {other[axis]=j;x:=to_read(v,data,other);better:=x<value;if descending {better=x>value;}if better || (x==value && j<selected) {rank+=1;}}return rank;}
to_soft :: (v:TvView,data:[]f32,c:[4]int,axis:int)->f64 {other:=c;other[axis]=0;maximum:=to_read(v,data,other);for j:1..<v.shape.dims[axis] {other[axis]=j;x:=to_read(v,data,other);if x>maximum {maximum=x;}}
    den:ToWide;for j:0..<v.shape.dims[axis] {other[axis]=j;den=to_accumulate(den,exp(to_read(v,data,other)-maximum));}return exp(to_read(v,data,c)-maximum)/to_total(den);
}
to_point :: (out:int,input_size:int,output_size:int)->ToPoint {x:=(f64(out)+0.5)*f64(input_size)/f64(output_size)-0.5;if x<0 {x=0;}if x>f64(input_size-1) {x=f64(input_size-1);}lo:=int(x);hi:=lo+1;if hi>=input_size {hi=lo;}return ToPoint.{low=lo,high=hi,fraction=x-f64(lo)};}
to_pool_best :: (v:TvView,data:[]f32,c:[4]int,r:ToRequest)->int {point:=c;point[2]=c[2]*r.stride;point[3]=c[3]*r.stride;best:=to_flat(v.shape,point);maximum:=to_at(v,data,best);
    for h:0..<r.height {for w:0..<r.width {point[2]=c[2]*r.stride+h;point[3]=c[3]*r.stride+w;index:=to_flat(v.shape,point);value:=to_at(v,data,index);if value>maximum {maximum=value;best=index;}}}return best;
}
// Internal evaluator: admitted views, indices and work; no public writes.
to_eval :: (r:ToRequest,p:ToPlan,av:TvView,bv:TvView,a:[]f32,b:[]f32,indices:[]int,i:int)->ToValue {
    op:=r.op;
    if cast(u8)op<=3 || op==ToOp.equal || op==ToOp.less {
        x:=to_at(av,a,to_broadcast_index(av.shape,p.shape,i));y:=to_at(bv,b,to_broadcast_index(bv.shape,p.shape,i));value:f64=0;
        if op==ToOp.add {value=x+y;}else if op==ToOp.subtract {value=x-y;}else if op==ToOp.multiply {value=x*y;}else if op==ToOp.divide {if y==0 {return ToValue.{status=ToStatus.arithmetic};}value=x/y;}
        else if (op==ToOp.equal && x==y) || (op==ToOp.less && x<y) {value=1;}return ToValue.{value=value};
    }
    if op==ToOp.negate || op==ToOp.relu || op==ToOp.exponential || op==ToOp.logarithm {x:=to_at(av,a,i);value:=-x;
        if op==ToOp.relu {value=0;if x>0 {value=x;}}else if op==ToOp.exponential {if x>88.72283905206835 {return ToValue.{status=ToStatus.arithmetic};}value=exp(x);}
        else if op==ToOp.logarithm {if x<=0 {return ToValue.{status=ToStatus.arithmetic};}value=log(x);}return ToValue.{value=value};
    }
    c:=to_coords(p.shape,i);
    if op==ToOp.sum || op==ToOp.mean || op==ToOp.maximum {point:=to_reduce_coords(av.shape,p,r,i);total:ToWide;maximum:f64=0;
        for j:0..<av.shape.dims[r.axis] {point[r.axis]=j;value:=to_read(av,a,point);total=to_accumulate(total,value);if j==0 || value>maximum {maximum=value;}}
        value:=to_total(total);if op==ToOp.mean {value/=f64(av.shape.dims[r.axis]);}else if op==ToOp.maximum {value=maximum;}return ToValue.{value=value};
    }
    if op==ToOp.softmax {return ToValue.{value=to_soft(av,a,c,r.axis)};}
    if op==ToOp.take {point:=c;point[r.axis]=indices[c[r.axis]];return ToValue.{value=to_read(av,a,point)};}
    if op==ToOp.update {point:=c;selected:=-1;for j:0..<indices.count {if indices[j]==c[r.axis] {selected=j;}}if selected>=0 {point[r.axis]=selected;return ToValue.{value=to_read(bv,b,point)};}return ToValue.{value=to_read(av,a,c)};}
    if op==ToOp.concat {if c[r.axis]<av.shape.dims[r.axis] {return ToValue.{value=to_read(av,a,c)};}point:=c;point[r.axis]-=av.shape.dims[r.axis];return ToValue.{value=to_read(bv,b,point)};}
    if op==ToOp.sort || op==ToOp.topk {point:=c;for j:0..<av.shape.dims[r.axis] {point[r.axis]=j;if to_rank(av,a,point,r.axis,r.descending)==c[r.axis] {return ToValue.{value=to_read(av,a,point),index=j};}}}
    if op==ToOp.matmul {total:ToWide;for k:0..<av.shape.dims[1] {total=to_accumulate(total,to_read(av,a,[4]int.[c[0],k,0,0])*to_read(bv,b,[4]int.[k,c[1],0,0]));}return ToValue.{value=to_total(total)};}
    if op==ToOp.conv2d {total:ToWide;for channel:0..<av.shape.dims[1] {for h:0..<bv.shape.dims[2] {for w:0..<bv.shape.dims[3] {x:=to_read(av,a,[4]int.[c[0],channel,c[2]+h,c[3]+w]);y:=to_read(bv,b,[4]int.[c[1],channel,h,w]);total=to_accumulate(total,x*y);}}}return ToValue.{value=to_total(total)};}
    if op==ToOp.maxpool2d {return ToValue.{value=to_at(av,a,to_pool_best(av,a,c,r))};}
    if op==ToOp.avgpool2d {total:ToWide;for h:0..<r.height {for w:0..<r.width {total=to_accumulate(total,to_read(av,a,[4]int.[c[0],c[1],c[2]*r.stride+h,c[3]*r.stride+w]));}}return ToValue.{value=to_total(total)/f64(p.inner)};}
    if op==ToOp.nearest2d {point:=c;point[2]=c[2]*av.shape.dims[2]/r.height;point[3]=c[3]*av.shape.dims[3]/r.width;return ToValue.{value=to_read(av,a,point)};}
    if op==ToOp.bilinear2d {h:=to_point(c[2],av.shape.dims[2],r.height);w:=to_point(c[3],av.shape.dims[3],r.width);
        v00:=to_read(av,a,[4]int.[c[0],c[1],h.low,w.low]);v01:=to_read(av,a,[4]int.[c[0],c[1],h.low,w.high]);v10:=to_read(av,a,[4]int.[c[0],c[1],h.high,w.low]);v11:=to_read(av,a,[4]int.[c[0],c[1],h.high,w.high]);
        top:=(1-w.fraction)*v00+w.fraction*v01;bottom:=(1-w.fraction)*v10+w.fraction*v11;return ToValue.{value=(1-h.fraction)*top+h.fraction*bottom};
    }
    if op==ToOp.mse {total:ToWide;for j:0..<p.na {difference:=to_at(av,a,j)-to_at(bv,b,j);total=to_accumulate(total,difference*difference);}return ToValue.{value=to_total(total)/f64(p.na)};}
    if op==ToOp.cross_entropy {total:ToWide;for row:0..<av.shape.dims[0] {maximum:=to_read(av,a,[4]int.[row,0,0,0]);for k:1..<av.shape.dims[1] {x:=to_read(av,a,[4]int.[row,k,0,0]);if x>maximum {maximum=x;}}
        den:ToWide;for k:0..<av.shape.dims[1] {den=to_accumulate(den,exp(to_read(av,a,[4]int.[row,k,0,0])-maximum));}loss:=(maximum-to_read(av,a,[4]int.[row,indices[row],0,0]))+log(to_total(den));total=to_accumulate(total,loss);}
        return ToValue.{value=to_total(total)/f64(av.shape.dims[0])};
    }return ToValue.{status=ToStatus.operation};
}
to_admit :: (r:ToRequest,owners:[]TvStorage,views:[]TvView,a:[]f32,b:[]f32,indices:[]int)->ToPlan {
    if owners.count!=2 || views.count!=2 {return ToPlan.{status=ToStatus.capacity};}
    if tv_layout(owners[0],views[0]).status!=TvStatus.ok || tv_layout(owners[1],views[1]).status!=TvStatus.ok {return ToPlan.{status=ToStatus.view};}
    p:=to_plan(r,views[0].shape,views[1].shape,indices.count);if p.status!=ToStatus.ok {return p;}
    if a.count!=owners[0].elements || b.count!=owners[1].elements {return ToPlan.{status=ToStatus.capacity};}
    if r.op==ToOp.take || r.op==ToOp.update || r.op==ToOp.cross_entropy {bound:=0;if r.op==ToOp.cross_entropy {bound=views[0].shape.dims[1];}else {bound=views[0].shape.dims[r.axis];}for x:indices {if x<0 || x>=bound {return ToPlan.{status=ToStatus.index};}}}
    for i:0..<p.na {if !tv_finite(a[tv_offset(views[0],i)]) {return ToPlan.{status=ToStatus.number};}}
    for i:0..<p.nb {if !tv_finite(b[tv_offset(views[1],i)]) {return ToPlan.{status=ToStatus.number};}}
    return p;
}
// book:begin forward
to_forward_checked :: (r:ToRequest,owners:[]TvStorage,views:[]TvView,a:[]f32,b:[]f32,indices:[]int,out:[]f32,scratch:[]f32,aux:[]int,aux_stage:[]int,overlap:bool)->ToResult #export_c {
    p:=to_admit(r,owners,views,a,b,indices);if p.status!=ToStatus.ok {return ToResult.{status=p.status};}
    if out.count<p.n || scratch.count<p.n || aux.count<p.aux || aux_stage.count<p.aux {return ToResult.{status=ToStatus.capacity};}
    if overlap {return ToResult.{status=ToStatus.alias};}
    for i:0..<p.n {value:=to_eval(r,p,views[0],views[1],a,b,indices,i);if value.status!=ToStatus.ok || !to_fits(value.value) {return ToResult.{status=ToStatus.arithmetic};}scratch[i]=f32(value.value);if p.aux>0 {aux_stage[i]=value.index;}}
    for i:0..<p.n {out[i]=scratch[i];}for i:0..<p.aux {aux[i]=aux_stage[i];}return ToResult.{written=p.n,aux_written=p.aux};
}
// book:end forward
