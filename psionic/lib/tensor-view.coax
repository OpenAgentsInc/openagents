// Chapter 3: bounded borrowed CPU f32 views, separate from chapter 2's
// contiguous-only contract. Caller keeps one authoritative storage record.
#authority;
TV_LIMIT :: 1048576;
TvStatus :: enum u8 {ok;rank;dimension;limit;state;bounds;alias;readonly;capacity;number;modified;}
// book:begin types
TvShape :: struct {rank:int;dims:[4]int;}
TvStorage :: struct {identity:int;epoch:int;elements:int;version:int;live:bool;}
TvView :: struct {identity:int;epoch:int;shape:TvShape;strides:[4]int;offset:int;writable:bool;}
TvLayout :: struct {status:TvStatus;elements:int;low:int;high:int;contiguous:bool;injective:bool;}
TvSaved :: struct {status:TvStatus;identity:int;epoch:int;version:int;}
// book:end types
TvOwner :: struct {status:TvStatus;storage:TvStorage;}
TvResult :: struct {status:TvStatus;written:int;}
TvViewResult :: struct {status:TvStatus;view:TvView;}
TvCount :: struct {status:TvStatus;elements:int;}
TvIndex :: struct {status:TvStatus;offset:int;}
TvAlias :: struct {status:TvStatus;may_alias:bool;}

// Checks precede the implementation. These expected addresses are literal
// small integer oracles, not results generated by the view implementation.
#test "scalar, empty and contiguous views have different element counts" {
    s:=tv_owner(7,1,6).storage;
    scalar:=tv_contiguous(s,TvShape.{},true);a:=tv_layout(s,scalar.view);#assert scalar.status==TvStatus.ok && a.elements==1 && a.low==0 && a.high==0 && a.contiguous && a.injective;
    shape:=TvShape.{rank=2,dims=[4]int.[2,3,0,0]};v:=tv_contiguous(s,shape,true);a=tv_layout(s,v.view);
    #assert a.status==TvStatus.ok && a.elements==6 && a.low==0 && a.high==5 && a.contiguous && a.injective && v.view.strides[0]==3 && v.view.strides[1]==1;
    empty:=tv_contiguous(tv_owner(8,1,0).storage,TvShape.{rank=2,dims=[4]int.[3,0,0,0]},true);
    a=tv_layout(tv_owner(8,1,0).storage,empty.view);#assert a.status==TvStatus.ok && a.elements==0 && a.contiguous && a.injective;
    #assert tv_elements(TvShape.{rank=4,dims=[4]int.[1048576,1048576,1048576,0]}).elements==0;
    #assert tv_contiguous(tv_owner(8,1,0).storage,TvShape.{},true).status==TvStatus.bounds;
}
#test "rank dimensions products and storage records refuse before address arithmetic" {
    #assert tv_elements(TvShape.{rank=-1}).status==TvStatus.rank && tv_elements(TvShape.{rank=5}).status==TvStatus.rank;
    #assert tv_elements(TvShape.{rank=1,dims=[4]int.[-1,0,0,0]}).status==TvStatus.dimension;
    #assert tv_elements(TvShape.{rank=1,dims=[4]int.[1,1,0,0]}).status==TvStatus.dimension;
    #assert tv_elements(TvShape.{rank=1,dims=[4]int.[9223372036854775807,0,0,0]}).status==TvStatus.limit;
    #assert tv_elements(TvShape.{rank=2,dims=[4]int.[1024,1024,0,0]}).elements==1048576;
    #assert tv_elements(TvShape.{rank=2,dims=[4]int.[1024,1025,0,0]}).status==TvStatus.limit;
    #assert tv_owner(0,1,1).status==TvStatus.state && tv_owner(1,0,1).status==TvStatus.state;
    #assert tv_owner(1,1,-1).status==TvStatus.limit && tv_owner(1,1,1048577).status==TvStatus.limit;
    bad:=tv_owner(1,1,1048577);#assert bad.storage.identity==0 && !bad.storage.live;
}
#test "transpose reversal gaps and singleton strides have independent addresses" {
    s:=tv_owner(7,1,6).storage;v:=tv_contiguous(s,TvShape.{rank=2,dims=[4]int.[2,3,0,0]},true).view;
    t:=tv_transpose(s,v,0,1);a:=tv_layout(s,t.view);#assert t.status==TvStatus.ok && !a.contiguous && a.injective && a.low==0 && a.high==5;
    expected:=[6]int.[0,3,1,4,2,5];for i:0..<6 {#assert tv_offset(t.view,i)==expected[i];}
    r:=tv_slice(s,v,1,2,3,-1);a=tv_layout(s,r.view);#assert r.status==TvStatus.ok && !a.contiguous && a.injective;
    reversed:=[6]int.[2,1,0,5,4,3];for i:0..<6 {#assert tv_offset(r.view,i)==reversed[i];}
    index:=tv_index(s,r.view,[4]int.[1,2,0,0]);#assert index.status==TvStatus.ok && index.offset==3;
    #assert tv_index(s,r.view,[4]int.[1,3,0,0]).status==TvStatus.bounds && tv_index(s,r.view,[4]int.[0,0,1,0]).status==TvStatus.bounds;
    #assert tv_index(s,r.view,[4]int.[-1,0,0,0]).status==TvStatus.bounds;
    gap:=TvView.{identity=7,epoch=1,shape=TvShape.{rank=1,dims=[4]int.[3,0,0,0]},strides=[4]int.[2,0,0,0],writable=true};
    a=tv_layout(s,gap);#assert a.status==TvStatus.ok && a.high==4 && !a.contiguous && a.injective;
    one:=gap;one.shape.dims[0]=1;one.strides[0]=-1048576;#assert tv_layout(s,one).contiguous;
}
#test "bounded slicing validates last selected element and canonicalizes empties" {
    s:=tv_owner(1,1,6).storage;v:=tv_contiguous(s,TvShape.{rank=1,dims=[4]int.[6,0,0,0]},true).view;
    #assert tv_slice(s,v,0,1,3,2).status==TvStatus.ok;
    #assert tv_slice(s,v,0,1,4,2).status==TvStatus.bounds;
    #assert tv_slice(s,v,0,0,2,-1).status==TvStatus.bounds;
    #assert tv_slice(s,v,0,6,1,1).status==TvStatus.bounds;
    #assert tv_slice(s,v,0,6,0,1).status==TvStatus.ok;
    #assert tv_slice(s,v,0,7,0,1).status==TvStatus.bounds;
    #assert tv_slice(s,v,0,0,1,0).status==TvStatus.dimension;
    #assert tv_slice(s,v,-1,0,1,1).status==TvStatus.rank;
    #assert tv_slice(s,v,1,0,1,1).status==TvStatus.rank;
    #assert tv_slice(s,v,0,0,-1,1).status==TvStatus.dimension;
    #assert tv_slice(s,v,0,0,1,9223372036854775807).status==TvStatus.limit;
    bad:=tv_slice(s,v,0,0,7,1);#assert bad.view.identity==0 && bad.view.shape.rank==0;
}
#test "broadcasts are readable aliases and never writable destinations" {
    s:=tv_owner(1,1,3).storage;v:=tv_contiguous(s,TvShape.{rank=1,dims=[4]int.[3,0,0,0]},true).view;
    b:=tv_broadcast(s,v,TvShape.{rank=2,dims=[4]int.[2,3,0,0]});a:=tv_layout(s,b.view);
    #assert b.status==TvStatus.ok && !b.view.writable && a.elements==6 && !a.injective && !a.contiguous;
    expected:=[6]int.[0,1,2,0,1,2];for i:0..<6 {#assert tv_offset(b.view,i)==expected[i];}
    forged:=b.view;forged.writable=true;#assert tv_layout(s,forged).status==TvStatus.alias;
    #assert tv_broadcast(s,v,TvShape.{rank=1,dims=[4]int.[2,0,0,0]}).status==TvStatus.dimension;
    #assert tv_broadcast(s,v,TvShape.{}).status==TvStatus.rank;
    singleton:=tv_contiguous(s,TvShape.{rank=1,dims=[4]int.[1,0,0,0]},true).view;
    #assert tv_broadcast(s,singleton,TvShape.{rank=1,dims=[4]int.[0,0,0,0]}).status==TvStatus.ok;
    overlap:=TvView.{identity=1,epoch=1,shape=TvShape.{rank=2,dims=[4]int.[2,2,0,0]},strides=[4]int.[1,1,0,0],writable=true};#assert tv_layout(s,overlap).status==TvStatus.alias;
}
#test "foreign stale overflowing and out-of-storage views cannot be used" {
    s:=tv_owner(1,2,6).storage;v:=tv_contiguous(s,TvShape.{rank=1,dims=[4]int.[6,0,0,0]},true).view;
    v.identity=2;#assert tv_layout(s,v).status==TvStatus.state;v.identity=1;v.epoch=1;#assert tv_layout(s,v).status==TvStatus.state;v.epoch=2;
    v.offset=1;#assert tv_layout(s,v).status==TvStatus.bounds;v.offset=-1;#assert tv_layout(s,v).status==TvStatus.bounds;v.offset=0;
    v.strides[0]=-9223372036854775807;#assert tv_layout(s,v).status==TvStatus.limit;
    v.strides[0]=1;v.strides[3]=1;#assert tv_layout(s,v).status==TvStatus.dimension;
    v.strides[3]=0;s.live=false;#assert tv_layout(s,v).status==TvStatus.state;
}
#test "gather materializes logical order and preserves signed zero and tails" {
    s:=tv_owner(1,1,6).storage;v:=tv_contiguous(s,TvShape.{rank=2,dims=[4]int.[2,3,0,0]},true).view;t:=tv_transpose(s,v,0,1).view;
    data:=[6]f32.[f32_from_bits(0x80000000),2,3,4,5,6];out:=[8]f32.[-7,-7,-7,-7,-7,-7,-7,-7];scratch:=[8]f32.[-9,-9,-9,-9,-9,-9,-9,-9];
    owner:=[1]TvStorage.[s];r:=tv_gather_checked(owner[..],t,data[..],out[..],scratch[..],false);#assert r.status==TvStatus.ok && r.written==6;
    #assert f32_bits(out[0])==0x80000000 && out[1]==4 && out[2]==2 && out[3]==5 && out[4]==3 && out[5]==6 && out[6]==-7 && scratch[6]==-9;
    r=tv_gather_checked(owner[..],t,data[..],out[0..<5],scratch[..],false);#assert r.status==TvStatus.capacity && r.written==0 && out[6]==-7;
    r=tv_gather_checked(owner[..],t,data[..],out[..],scratch[..],true);#assert r.status==TvStatus.alias;
    r=tv_gather_checked(owner[..],t,data[0..<5],out[..],scratch[..],false);#assert r.status==TvStatus.capacity && out[5]==6 && scratch[5]==6;
}
#test "a successful alias write invalidates a saved value once, failures do not" {
    owner:=[1]TvStorage.[tv_owner(7,1,6).storage];v:=tv_contiguous(owner[0],TvShape.{rank=2,dims=[4]int.[2,3,0,0]},true).view;
    saved:=tv_save(owner[0],v);t:=tv_transpose(owner[0],v,0,1).view;data:=[6]f32.[1,2,3,4,5,6];src:=[6]f32.[10,20,30,40,50,60];scratch:=[8]f32.[-9,-9,-9,-9,-9,-9,-9,-9];
    #assert tv_saved_status(owner[0],saved)==TvStatus.ok;
    r:=tv_scatter_checked(owner[..],t,src[..],data[..],scratch[..],false);#assert r.status==TvStatus.ok && r.written==6 && owner[0].version==1;
    #assert data[0]==10 && data[1]==30 && data[2]==50 && data[3]==20 && data[4]==40 && data[5]==60 && scratch[6]==-9;
    #assert tv_saved_status(owner[0],saved)==TvStatus.modified;
    saved=tv_save(owner[0],v);r=tv_scatter_checked(owner[..],v,src[0..<5],data[..],scratch[..],false);
    #assert r.status==TvStatus.capacity && r.written==0 && tv_saved_status(owner[0],saved)==TvStatus.ok && data[5]==60 && scratch[5]==60;
    src[5]=60;r=tv_scatter_checked(owner[..],v,src[..],data[..],scratch[..],true);#assert r.status==TvStatus.alias && owner[0].version==1;
    owner[0].version=9223372036854775807;r=tv_scatter_checked(owner[..],v,src[..],data[..],scratch[..],false);#assert r.status==TvStatus.limit && data[5]==60;
    owner[0].version=1;#assert tv_retire(owner[..]).status==TvStatus.ok && tv_saved_status(owner[0],saved)==TvStatus.state;
    #assert tv_layout(tv_owner(7,2,6).storage,v).status==TvStatus.state;
}
#test "empty gather and scatter do no data work and do not increment version" {
    owner:=[1]TvStorage.[tv_owner(1,1,0).storage];v:=tv_contiguous(owner[0],TvShape.{rank=1},true).view;data:[1]f32;src:[1]f32;scratch:[1]f32;
    #assert tv_gather_checked(owner[..],v,data[0..<0],src[0..<0],scratch[0..<0],false).status==TvStatus.ok;
    #assert tv_scatter_checked(owner[..],v,src[0..<0],data[0..<0],scratch[0..<0],false).status==TvStatus.ok && owner[0].version==0;
    #assert tv_index(owner[0],v,[4]int.[0,0,0,0]).status==TvStatus.bounds;
}

#test "nonfinite representations are refused without evaluating them as Coax constants" {
    bits:=[8]u32.[0x00000000,0x80000000,0x00000001,0x7f7fffff,0x7f800000,0xff800000,0x7fc00001,0x7f800001];
    for i:0..<8 {#assert tv_finite_bits(bits[i])==(i<4);}
}
#forall "rank-one strided coordinates use the absolute storage origin" stride:-3..<4,offset:0..<7 {
    s:=tv_owner(1,1,7).storage;v:=TvView.{identity=1,epoch=1,shape=TvShape.{rank=1,dims=[4]int.[3,0,0,0]},strides=[4]int.[stride,0,0,0],offset=offset};
    r:=tv_layout(s,v);valid:=offset+2*stride>=0 && offset+2*stride<7;
    #assert (r.status==TvStatus.ok)==valid;
    if valid {for i:0..<3 {a:=tv_index(s,v,[4]int.[i,0,0,0]);#assert a.status==TvStatus.ok && a.offset==offset+i*stride;}}
    else {#assert r.elements==0 && r.low==0 && r.high==0 && !r.contiguous && !r.injective;}
}

#test "alias intervals can prove disjoint views but conservatively retain gaps" {
    s:=tv_owner(1,1,6).storage;v:=tv_contiguous(s,TvShape.{rank=1,dims=[4]int.[6,0,0,0]},true).view;
    a:=tv_slice(s,v,0,0,3,1).view;b:=tv_slice(s,v,0,3,3,1).view;r:=tv_alias(s,a,b);#assert r.status==TvStatus.ok && !r.may_alias;
    a=tv_slice(s,v,0,0,3,2).view;b=tv_slice(s,v,0,1,3,2).view;r=tv_alias(s,a,b);#assert r.status==TvStatus.ok && r.may_alias;
    b=tv_slice(s,v,0,6,0,1).view;#assert !tv_alias(s,v,b).may_alias;
    b.epoch=2;#assert tv_alias(s,v,b).status==TvStatus.state;
}

tv_storage_valid :: (s:TvStorage)->bool {return s.live && s.identity>0 && s.epoch>0 && s.elements>=0 && s.elements<=TV_LIMIT && s.version>=0;}
tv_owner :: (identity:int,epoch:int,elements:int)->TvOwner #export_c {
    if identity<=0 || epoch<=0 {return TvOwner.{status=TvStatus.state};}
    if elements<0 || elements>TV_LIMIT {return TvOwner.{status=TvStatus.limit};}
    return TvOwner.{storage=TvStorage.{identity=identity,epoch=epoch,elements=elements,live=true}};
}
tv_elements :: (shape:TvShape)->TvCount #export_c {
    if shape.rank<0 || shape.rank>4 {return TvCount.{status=TvStatus.rank};}
    empty:=false;
    for i:0..<4 {d:=shape.dims[i];if i<shape.rank {if d<0 {return TvCount.{status=TvStatus.dimension};}if d>TV_LIMIT {return TvCount.{status=TvStatus.limit};}if d==0 {empty=true;}}
        else if d!=0 {return TvCount.{status=TvStatus.dimension};}}
    if empty {return TvCount.{};}
    n:=1;for i:0..<shape.rank {if shape.dims[i]>TV_LIMIT/n {return TvCount.{status=TvStatus.limit};}n*=shape.dims[i];}
    return TvCount.{elements=n};
}
// book:begin layout
tv_layout :: (s:TvStorage,v:TvView)->TvLayout #export_c {
    if !tv_storage_valid(s) || v.identity!=s.identity || v.epoch!=s.epoch {return TvLayout.{status=TvStatus.state};}
    count:=tv_elements(v.shape);if count.status!=TvStatus.ok {return TvLayout.{status=count.status};}
    for i:0..<4 {if i>=v.shape.rank {if v.strides[i]!=0 {return TvLayout.{status=TvStatus.dimension};}}
        else if v.strides[i]< -TV_LIMIT || v.strides[i]>TV_LIMIT {return TvLayout.{status=TvStatus.limit};}}
    if v.offset<0 || v.offset>s.elements {return TvLayout.{status=TvStatus.bounds};}
    if count.elements==0 {return TvLayout.{low=v.offset,high=v.offset,contiguous=true,injective=true};}
    low:=v.offset;high:=v.offset;
    // Extent/stride caps bound every product by 2^40 and the four-axis sum
    // by 2^42, before checking the actual storage interval.
    for i:0..<v.shape.rank {delta:=(v.shape.dims[i]-1)*v.strides[i];if delta<0 {low+=delta;}else {high+=delta;}}
    if low<0 || high>=s.elements {return TvLayout.{status=TvStatus.bounds};}
    contiguous:=true;expected:=1;i:=v.shape.rank;
    while i>0 {i-=1;if v.shape.dims[i]>1 && v.strides[i]!=expected {contiguous=false;}expected*=v.shape.dims[i];}
    // Sufficient injectivity proof, not an exhaustive solver: in increasing
    // absolute-stride order, each axis must step beyond the preceding span.
    used:[4]bool;covered:=1;injective:=true;
    for pass:0..<v.shape.rank {chosen:=-1;best:=TV_LIMIT+1;
        for axis:0..<v.shape.rank {stride:=v.strides[axis];if stride<0 {stride=-stride;}
            if !used[axis] && v.shape.dims[axis]>1 && stride<best {chosen=axis;best=stride;}}
        if chosen>=0 {used[chosen]=true;if best<covered {injective=false;}covered+=(v.shape.dims[chosen]-1)*best;}
    }
    if v.writable && !injective {return TvLayout.{status=TvStatus.alias};}
    return TvLayout.{elements=count.elements,low=low,high=high,contiguous=contiguous,injective=injective};
}
// book:end layout
// Interval overlap is conservative: interleaved even/odd addresses may still
// report may_alias. An empty view touches no element.
tv_alias :: (s:TvStorage,a:TvView,b:TvView)->TvAlias #export_c {
    x:=tv_layout(s,a);if x.status!=TvStatus.ok {return TvAlias.{status=x.status};}
    y:=tv_layout(s,b);if y.status!=TvStatus.ok {return TvAlias.{status=y.status};}
    return TvAlias.{may_alias=x.elements>0 && y.elements>0 && x.low<=y.high && y.low<=x.high};
}

tv_checked_view :: (s:TvStorage,v:TvView)->TvViewResult {r:=tv_layout(s,v);if r.status!=TvStatus.ok {return TvViewResult.{status=r.status};}return TvViewResult.{view=v};}
tv_contiguous :: (s:TvStorage,shape:TvShape,writable:bool)->TvViewResult #export_c {
    c:=tv_elements(shape);if c.status!=TvStatus.ok {return TvViewResult.{status=c.status};}
    v:=TvView.{identity=s.identity,epoch=s.epoch,shape=shape,writable=writable};
    if c.elements>0 {stride:=1;i:=shape.rank;while i>0 {i-=1;v.strides[i]=stride;stride*=shape.dims[i];}}
    return tv_checked_view(s,v);
}
tv_transpose :: (s:TvStorage,v:TvView,a:int,b:int)->TvViewResult #export_c {
    r:=tv_layout(s,v);if r.status!=TvStatus.ok {return TvViewResult.{status=r.status};}
    if a<0 || a>=v.shape.rank || b<0 || b>=v.shape.rank {return TvViewResult.{status=TvStatus.rank};}
    next:=v;next.shape.dims[a]=v.shape.dims[b];next.shape.dims[b]=v.shape.dims[a];next.strides[a]=v.strides[b];next.strides[b]=v.strides[a];return tv_checked_view(s,next);
}
tv_slice :: (s:TvStorage,v:TvView,axis:int,start:int,count:int,step:int)->TvViewResult #export_c {
    r:=tv_layout(s,v);if r.status!=TvStatus.ok {return TvViewResult.{status=r.status};}
    if axis<0 || axis>=v.shape.rank {return TvViewResult.{status=TvStatus.rank};}
    if count<0 || step==0 {return TvViewResult.{status=TvStatus.dimension};}
    if count>TV_LIMIT || step< -TV_LIMIT || step>TV_LIMIT {return TvViewResult.{status=TvStatus.limit};}
    extent:=v.shape.dims[axis];if start<0 || start>extent {return TvViewResult.{status=TvStatus.bounds};}
    next:=v;next.shape.dims[axis]=count;
    if count==0 {next.strides[axis]=0;return tv_checked_view(s,next);}
    last:=start+(count-1)*step;if start>=extent || last<0 || last>=extent {return TvViewResult.{status=TvStatus.bounds};}
    next.offset+=start*v.strides[axis];next.strides[axis]*=step;return tv_checked_view(s,next);
}
tv_broadcast :: (s:TvStorage,v:TvView,target:TvShape)->TvViewResult #export_c {
    r:=tv_layout(s,v);if r.status!=TvStatus.ok {return TvViewResult.{status=r.status};}
    c:=tv_elements(target);if c.status!=TvStatus.ok {return TvViewResult.{status=c.status};}
    if target.rank<v.shape.rank {return TvViewResult.{status=TvStatus.rank};}
    next:=TvView.{identity=v.identity,epoch=v.epoch,shape=target,offset=v.offset};shift:=target.rank-v.shape.rank;
    for i:0..<target.rank {if i>=shift {axis:=i-shift;if v.shape.dims[axis]==target.dims[i] {next.strides[i]=v.strides[axis];}
        else if v.shape.dims[axis]!=1 {return TvViewResult.{status=TvStatus.dimension};}}}
    return tv_checked_view(s,next);
}
// Internal: callers first admit layout and 0 <= linear < elements.
tv_offset :: (v:TvView,linear:int)->int {n:=linear;offset:=v.offset;i:=v.shape.rank;while i>0 {i-=1;offset+=(n%v.shape.dims[i])*v.strides[i];n/=v.shape.dims[i];}return offset;}
tv_index :: (s:TvStorage,v:TvView,coordinates:[4]int)->TvIndex #export_c {
    r:=tv_layout(s,v);if r.status!=TvStatus.ok {return TvIndex.{status=r.status};}offset:=v.offset;
    for i:0..<4 {if i<v.shape.rank {if coordinates[i]<0 || coordinates[i]>=v.shape.dims[i] {return TvIndex.{status=TvStatus.bounds};}offset+=coordinates[i]*v.strides[i];}
        else if coordinates[i]!=0 {return TvIndex.{status=TvStatus.bounds};}}
    return TvIndex.{offset=offset};
}
// book:begin versions
tv_save :: (s:TvStorage,v:TvView)->TvSaved #export_c {
    r:=tv_layout(s,v);if r.status!=TvStatus.ok {return TvSaved.{status=r.status};}
    return TvSaved.{identity=s.identity,epoch=s.epoch,version=s.version};
}
tv_saved_status :: (s:TvStorage,saved:TvSaved)->TvStatus #export_c {
    if saved.status!=TvStatus.ok || !tv_storage_valid(s) || saved.identity!=s.identity || saved.epoch!=s.epoch {return TvStatus.state;}
    if saved.version!=s.version {return TvStatus.modified;}return TvStatus.ok;
}
// book:end versions
tv_retire :: (owner:[]TvStorage)->TvResult #export_c {
    if owner.count!=1 {return TvResult.{status=TvStatus.capacity};}
    if !tv_storage_valid(owner[0]) {return TvResult.{status=TvStatus.state};}owner[0].live=false;return TvResult.{};
}
tv_finite_bits :: (bits:u32)->bool {return (bits&0x7fffffff)<0x7f800000;}
tv_finite :: (x:f32)->bool {return tv_finite_bits(f32_bits(x));}
tv_gather_checked :: (owner:[]TvStorage,v:TvView,data:[]f32,out:[]f32,scratch:[]f32,overlap:bool)->TvResult #export_c {
    if owner.count!=1 {return TvResult.{status=TvStatus.capacity};}s:=owner[0];r:=tv_layout(s,v);if r.status!=TvStatus.ok {return TvResult.{status=r.status};}
    if data.count!=s.elements || out.count<r.elements || scratch.count<r.elements {return TvResult.{status=TvStatus.capacity};}
    if overlap {return TvResult.{status=TvStatus.alias};}
    for i:0..<r.elements {if !tv_finite(data[tv_offset(v,i)]) {return TvResult.{status=TvStatus.number};}}
    for i:0..<r.elements {scratch[i]=data[tv_offset(v,i)];}
    for i:0..<r.elements {out[i]=scratch[i];}return TvResult.{written=r.elements};
}
// book:begin scatter
tv_scatter_checked :: (owner:[]TvStorage,v:TvView,source:[]f32,data:[]f32,scratch:[]f32,overlap:bool)->TvResult #export_c {
    if owner.count!=1 {return TvResult.{status=TvStatus.capacity};}s:=owner[0];r:=tv_layout(s,v);
    if r.status!=TvStatus.ok {return TvResult.{status=r.status};}
    if !v.writable {return TvResult.{status=TvStatus.readonly};}
    if source.count!=r.elements || data.count!=s.elements || scratch.count<r.elements {return TvResult.{status=TvStatus.capacity};}
    if overlap {return TvResult.{status=TvStatus.alias};}
    if r.elements>0 && s.version==9223372036854775807 {return TvResult.{status=TvStatus.limit};}
    for x:source {if !tv_finite(x) {return TvResult.{status=TvStatus.number};}}
    for i:0..<r.elements {scratch[i]=source[i];}
    for i:0..<r.elements {data[tv_offset(v,i)]=scratch[i];}
    if r.elements>0 {owner[0].version+=1;}return TvResult.{written=r.elements};
}
// book:end scatter
