#load "unicode.coax";
#authority;
PtBranch :: struct {begin:int;end:int;answer:int;}
PtSplit :: struct {status:PtStatus;written:int;prefix:int;}

#test "shared prefix is the longest matching candidate across complete branches" {
    candidate:=[4]int.[10,11,12,13];full:=[12]int.[10,11,12,20,21,10,11,12,30,10,11,99];ends:=[3]int.[5,9,12];out:[4]PtBranch;
    r:=pt_split_checked(candidate[..],full[..],ends[..],out[..],false);
    #assert r.status==PtStatus.ok && r.written==3 && r.prefix==2;
    #assert out[0].begin==2 && out[0].end==5 && out[0].answer==4;
    #assert out[1].begin==7 && out[1].end==9 && out[1].answer==3;
    #assert out[2].begin==11 && out[2].end==12 && out[2].answer==2;
    #assert out[3].begin==0 && out[3].end==0;
    full[0]=42;r=pt_split_checked(candidate[..],full[..],ends[..],out[..],false);#assert r.status==PtStatus.ok && r.prefix==0;
    #assert pt_branch_count(1) && pt_branch_count(32) && !pt_branch_count(0) && !pt_branch_count(33);
}
#test "bad branch metadata, token ids, aliases and empty suffixes never publish" {
    prefix:=[2]int.[1,2];full:=[4]int.[1,2,1,2];ends:=[2]int.[2,4];out:=[2]PtBranch.[PtBranch.{begin=-7},PtBranch.{begin=-7}];
    #assert pt_split_checked(prefix[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    full[3]=3;ends[0]=0;#assert pt_split_checked(prefix[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    ends[0]=3;ends[1]=2;#assert pt_split_checked(prefix[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    ends[0]=2;ends[1]=3;#assert pt_split_checked(prefix[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    ends[1]=4;full[3]=248077;#assert pt_split_checked(prefix[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    full[3]=3;prefix[0]=-1;#assert pt_split_checked(prefix[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    prefix[0]=1;#assert pt_split_checked(prefix[0..<1],full[..],ends[..],out[0..<1],false).status==PtStatus.capacity;
    #assert pt_split_checked(prefix[0..<1],full[..],ends[..],out[..],true).status==PtStatus.alias;
    for row:out {#assert row.begin==-7;}
}
#test "branch limits, zero ids and empty suffixes use exact interval metadata" {
    #assert pt_id(0) && pt_id(248076) && !pt_id(-1) && !pt_id(248077);
    #assert pt_branch_span(0,1,1) && !pt_branch_span(0,0,1) && !pt_branch_span(1,0,1) && !pt_branch_span(0,2,1);
    candidate:=[2]int.[1,1];full:=[4]int.[1,1,1,3];ends:=[2]int.[1,4];out:[2]PtBranch;
    #assert pt_split_checked(candidate[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    candidate[1]=2;full[1]=9;full[2]=1;full[3]=9;ends[0]=2;
    r:=pt_split_checked(candidate[..],full[..],ends[..],out[..],false);#assert r.status==PtStatus.ok && r.prefix==1;
    ends[0]=1;#assert pt_split_checked(candidate[0..<1],full[0..<1],ends[0..<1],out[..],false).status==PtStatus.range;
    full[1]=2;full[2]=3;full[3]=1;ends[0]=3;ends[1]=4;
    #assert pt_split_checked(candidate[0..<1],full[..],ends[..],out[..],false).status==PtStatus.range;
    candidate[0]=1;candidate[1]=1;full[0]=1;full[1]=1;full[2]=9;full[3]=1;
    #assert pt_split_checked(candidate[..],full[..],ends[..],out[..],false).status==PtStatus.range;
    #assert pt_split_checked(candidate[..],full[..],ends[0..<0],out[..],false).status==PtStatus.size;
    large:[16385]int;boundary:=[2]int.[16384,16385];
    r=pt_split_checked(candidate[0..<0],large[..],boundary[..],out[..],false);#assert r.status==PtStatus.ok && r.prefix==0 && out[1].answer==0;
    #assert pt_split_checked(large[..],full[..],ends[..],out[..],false).status==PtStatus.size;
}
pt_branch_span :: (start:int,end:int,total:int)->bool {return end>start && end<=total;}

pt_branch_count :: (n:int)->bool {return n>=1 && n<=32;}
pt_id :: (id:int)->bool {return id>=0 && id<248077;}
// book:begin split
// `full` is the concatenation of complete branch encodings; ends are exclusive.
// Tokenize the prefix candidate separately, then shrink it against EVERY branch.
pt_split_checked :: (candidate:[]int,full:[]int,ends:[]int,output:[]PtBranch,overlap:bool)->PtSplit #export_c {
    if !pt_branch_count(ends.count) || !pt_token_count(candidate.count) {return PtSplit.{status=PtStatus.size};}
    if output.count<ends.count {return PtSplit.{status=PtStatus.capacity};}
    if overlap {return PtSplit.{status=PtStatus.alias};}
    for id:candidate {if !pt_id(id) {return PtSplit.{status=PtStatus.range};}}
    start:=0;n:=candidate.count;
    for end:ends {
        if !pt_branch_span(start,end,full.count) {return PtSplit.{status=PtStatus.range};}
        if !pt_token_count(end-start) {return PtSplit.{status=PtStatus.size};}
        for i:start..<end {if !pt_id(full[i]) {return PtSplit.{status=PtStatus.range};}}
        shared:=0;
        while shared<n && shared<end-start {if candidate[shared]!=full[start+shared] {break;}shared+=1;}
        n=shared;start=end;
    }
    if start!=full.count {return PtSplit.{status=PtStatus.range};}
    start=0;for end:ends {if end-start==n {return PtSplit.{status=PtStatus.range};}start=end;}
    start=0;
    for i:0..<ends.count {output[i]=PtBranch.{begin=start+n,end=ends[i],answer=ends[i]-start-1};start=ends[i];}
    return PtSplit.{written=ends.count,prefix=n};
}
// book:end split
