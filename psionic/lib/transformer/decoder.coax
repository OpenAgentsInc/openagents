// Chapter 113: a tiny complete causal decoder and its backward pass.
// Binary64 CPU reference: token embedding, pre-norm blocks of causal grouped-
// query attention with interleaved RoPE and a squared-ReLU FFN, a final
// RMSNorm and an untied vocabulary head. One per-position routine serves the
// full sequence and incremental decoding over a bounded KV cache; the backward
// pass is derived by hand and checked against central differences.
#load "../counter-rng.coax";
TdStatus :: enum u8 {ok;shape;token;capacity;number;alias;position;}
// book:begin shape
TdShape :: struct {vocab:int;width:int;heads:int;kv_heads:int;head_width:int;hidden:int;layers:int;context:int;}
// book:end shape
TdBlock :: struct {norm1:int;wq:int;wk:int;wv:int;wo:int;norm2:int;w1:int;w2:int;}
TdResult :: struct {status:TdStatus;written:int;loss:f64;}
TD_EPSILON :: 0.000001;
TD_THETA :: 10000.0;
TD_NUMBER :: 1048576.0;

// Tests use a deterministic formula for weights so an independent Python
// definition (psionic/tests/decoder_oracle.py) can reproduce every logit.
TD_TINY :: TdShape.{vocab=5,width=4,heads=2,kv_heads=1,head_width=2,hidden=3,layers=2,context=4};
// Generated by psionic/tests/decoder_oracle.py --coax for TD_TINY and tokens 1,3,0,2
// (correctly rounded sin, cos, exp and log since #12695).
TD_ORACLE_LOSS :: 1.8059255342158513;
TD_ORACLE_LOGITS :: [20]f64.[0.3326536694254403,-0.33690265960461363,0.3022207555948625,-0.23261563586587738,0.13613054220848106,0.1762938243862832,-0.26067992506404286,0.31494307393205667,-0.3328128755312528,0.312224379243382,-0.5811340956483357,0.4951734754043695,-0.3519929264167466,0.16813772265001978,0.03514668923674214,-0.44766145897115195,0.4479311370634924,-0.3964399898735277,0.29913809332308927,-0.16726919907455778];
td_formula :: (p:[]f64) {for i:0..<p.count {p[i]=0.5*sin(0.7*f64(i)+0.3);}}

#test "shapes, parameter layout and buffers are exact and bounded" {
    s:=TD_TINY;#assert td_valid(s) && td_parameter_count(s)==204 && td_block_size(s)==80 && td_slot_size(s)==37 && td_work_count(s)==384;
    b:=td_block(s,1);#assert b.norm1==100 && b.wq==104 && b.wk==120 && b.wv==128 && b.wo==136 && b.norm2==152 && b.w1==156 && b.w2==168;
    #assert td_final_norm(s)==180 && td_unembed(s)==184;
    bad:=s;bad.kv_heads=3;#assert !td_valid(bad);bad=s;bad.head_width=3;bad.width=6;#assert !td_valid(bad);
    bad=s;bad.width=5;#assert !td_valid(bad);bad=s;bad.vocab=1;#assert !td_valid(bad);bad=s;bad.context=65;#assert !td_valid(bad);
    bad=s;bad.layers=0;#assert !td_valid(bad);bad=s;bad.layers=5;#assert !td_valid(bad);bad=s;bad.hidden=257;#assert !td_valid(bad);
    big:=TdShape.{vocab=256,width=64,heads=8,kv_heads=2,head_width=8,hidden=256,layers=4,context=64};#assert td_valid(big);
}
#test "full-sequence logits match the independent Python definition" {
    s:=TD_TINY;p:[204]f64;td_formula(p[..]);w:[384]f64;tokens:=[4]int.[1,3,0,2];logits:[20]f64;
    r:=td_forward(s,p[..],tokens[..],w[..],logits[..],false);#assert r.status==TdStatus.ok && r.written==20;
    #assert abs(r.loss-TD_ORACLE_LOSS)<1e-12;
    for i:0..<20 {#assert abs(logits[i]-TD_ORACLE_LOGITS[i])<1e-12;}
}
#test "incremental decode equals the full sequence and the future cannot change the past" {
    s:=TD_TINY;p:[204]f64;td_formula(p[..]);w:[384]f64;cache:[384]f64;tokens:=[4]int.[1,3,0,2];full:[20]f64;step:[5]f64;
    #assert td_forward(s,p[..],tokens[..],w[..],full[..],false).status==TdStatus.ok;
    filled:=0;for t:0..<4 {r:=td_decode(s,p[..],cache[..],filled,tokens[t],step[..],false);#assert r.status==TdStatus.ok && r.written==t+1;filled=r.written;
        for v:0..<5 {#assert step[v]==full[5*t+v];}}
    #assert td_decode(s,p[..],cache[..],filled,0,step[..],false).status==TdStatus.position;
    for j:0..<4 {changed:=tokens;changed[j]=(tokens[j]+1)%5;other:[20]f64;
        #assert td_forward(s,p[..],changed[..],w[..],other[..],false).status==TdStatus.ok;
        for i:0..<5*j {#assert other[i]==full[i];}moved:=false;for i:5*j..<5*j+5 {if other[i]!=full[i] {moved=true;}}#assert moved;}
}
// Largest scaled gap between the analytic gradient and a central difference
// over parameters first..<last of TD_TINY on tokens 1,3,0,2.
td_check_span :: (first:int,last:int)->f64 {
    s:=TD_TINY;p:[204]f64;td_formula(p[..]);w:[384]f64;dw:[384]f64;grads:[204]f64;tokens:=[4]int.[1,3,0,2];logits:[20]f64;
    r:=td_gradients(s,p[..],tokens[..],w[..],dw[..],grads[..],false);if r.status!=TdStatus.ok || abs(r.loss-TD_ORACLE_LOSS)>=1e-12 {return 1;}
    h:=0.00001;worst:=0.0;
    for i:first..<last {keep:=p[i];p[i]=keep+h;up:=td_forward(s,p[..],tokens[..],w[..],logits[..],false).loss;p[i]=keep-h;down:=td_forward(s,p[..],tokens[..],w[..],logits[..],false).loss;p[i]=keep;
        error:=abs(grads[i]-(up-down)/(2*h))/(1+abs(grads[i]));if error>worst {worst=error;}}
    return worst;
}
#test "embedding and first-block gradients match central differences" {#assert td_check_span(0,30)<1e-8 && td_check_span(30,60)<1e-8;}
#test "first-block projection and FFN gradients match central differences" {#assert td_check_span(60,90)<1e-8 && td_check_span(90,120)<1e-8;}
#test "second-block gradients match central differences" {#assert td_check_span(120,150)<1e-8 && td_check_span(150,180)<1e-8;}
#test "head gradients match central differences" {#assert td_check_span(180,204)<1e-8;}
#test "every parameter group receives gradient" {
    s:=TD_TINY;p:[204]f64;td_formula(p[..]);w:[384]f64;dw:[384]f64;grads:[204]f64;tokens:=[4]int.[1,3,0,2];
    r:=td_gradients(s,p[..],tokens[..],w[..],dw[..],grads[..],false);#assert r.status==TdStatus.ok && r.written==204;
    // Coverage: every parameter group of every block, the head and the used
    // embedding rows receive gradient. Token 4 never appears and token 2 is
    // only the last input, which predicts nothing, so their rows stay zero.
    for l:0..<2 {b:=td_block(s,l);starts:=[9]int.[b.norm1,b.wq,b.wk,b.wv,b.wo,b.norm2,b.w1,b.w2,b.w2+12];
        for g:0..<8 {mass:=0.0;for i:starts[g]..<starts[g+1] {mass+=abs(grads[i]);}#assert mass>0;}}
    mass:=0.0;for i:180..<204 {mass+=abs(grads[i]);}#assert mass>0;for i:0..<20 {row:=i/4;#assert (grads[i]==0)==(row==2 || row==4);}
}
#test "refusals precede every write" {
    s:=TD_TINY;p:[204]f64;td_formula(p[..]);w:[384]f64;dw:[384]f64;grads:[204]f64;tokens:=[4]int.[1,3,0,2];logits:[20]f64;for i:0..<20 {logits[i]=-7;}
    bad:=s;bad.width=5;#assert td_forward(bad,p[..],tokens[..],w[..],logits[..],false).status==TdStatus.shape;
    #assert td_forward(s,p[0..<203],tokens[..],w[..],logits[..],false).status==TdStatus.shape;
    #assert td_forward(s,p[..],tokens[..],w[0..<383],logits[..],false).status==TdStatus.capacity;
    #assert td_forward(s,p[..],tokens[..],w[..],logits[0..<19],false).status==TdStatus.capacity;
    #assert td_forward(s,p[..],tokens[0..<0],w[..],logits[..],false).status==TdStatus.shape;
    long:=[5]int.[0,0,0,0,0];#assert td_forward(s,p[..],long[..],w[..],logits[..],false).status==TdStatus.shape;
    tokens[2]=5;#assert td_forward(s,p[..],tokens[..],w[..],logits[..],false).status==TdStatus.token;tokens[2]=-1;#assert td_forward(s,p[..],tokens[..],w[..],logits[..],false).status==TdStatus.token;tokens[2]=0;
    #assert td_forward(s,p[..],tokens[..],w[..],logits[..],true).status==TdStatus.alias;
    keep:=p[7];p[7]=2*TD_NUMBER;#assert td_forward(s,p[..],tokens[..],w[..],logits[..],false).status==TdStatus.number;p[7]=keep;
    for x:logits {#assert x==-7;}
    #assert td_gradients(s,p[..],tokens[0..<1],w[..],dw[..],grads[..],false).status==TdStatus.shape;
    #assert td_gradients(s,p[..],tokens[..],w[..],dw[0..<383],grads[..],false).status==TdStatus.capacity;
    #assert td_gradients(s,p[..],tokens[..],w[..],dw[..],grads[0..<203],false).status==TdStatus.capacity;
    #assert td_decode(s,p[..],w[..],-1,0,logits[0..<5],false).status==TdStatus.position && td_decode(s,p[..],w[..],0,5,logits[0..<5],false).status==TdStatus.token;
    #assert td_decode(s,p[..],w[..],0,0,logits[0..<4],false).status==TdStatus.capacity;
}
#test "a small full training run learns the sequence" {
    s:=TD_TINY;p:[204]f64;td_formula(p[..]);for i:0..<204 {p[i]*=0.4;}w:[384]f64;dw:[384]f64;grads:[204]f64;tokens:=[4]int.[1,3,0,2];
    first:=0.0;last:=0.0;
    for step:0..<60 {r:=td_gradients(s,p[..],tokens[..],w[..],dw[..],grads[..],false);#assert r.status==TdStatus.ok;if step==0 {first=r.loss;}last=r.loss;for i:0..<204 {p[i]-=0.5*grads[i];}}
    #assert first>1 && last<0.05*first;
    logits:[5]f64;filled:=0;out:=[4]int.[1,0,0,0];
    for t:0..<3 {r:=td_decode(s,p[..],w[..],filled,out[t],logits[..],false);filled=r.written;out[t+1]=td_argmax(logits[..]);}
    for t:0..<4 {#assert out[t]==tokens[t];}
}

// book:begin layout
td_valid :: (s:TdShape)->bool {
    if s.vocab<2 || s.vocab>256 || s.heads<1 || s.heads>8 || s.kv_heads<1 || s.kv_heads>s.heads || s.heads%s.kv_heads!=0 {return false;}
    if s.head_width<2 || s.head_width>32 || s.head_width%2!=0 || s.width!=s.heads*s.head_width || s.width>128 {return false;}
    return s.hidden>=1 && s.hidden<=256 && s.layers>=1 && s.layers<=4 && s.context>=1 && s.context<=64;
}
td_block_size :: (s:TdShape)->int {d:=s.width;q:=s.heads*s.head_width;k:=s.kv_heads*s.head_width;return 2*d+q*d+2*k*d+d*q+2*s.hidden*d;}
td_parameter_count :: (s:TdShape)->int {return 2*s.vocab*s.width+s.layers*td_block_size(s)+s.width;}
td_block :: (s:TdShape,layer:int)->TdBlock {
    d:=s.width;q:=s.heads*s.head_width;k:=s.kv_heads*s.head_width;b:TdBlock;b.norm1=s.vocab*d+layer*td_block_size(s);
    b.wq=b.norm1+d;b.wk=b.wq+q*d;b.wv=b.wk+k*d;b.wo=b.wv+k*d;b.norm2=b.wo+d*q;b.w1=b.norm2+d;b.w2=b.w1+s.hidden*d;return b;
}
td_final_norm :: (s:TdShape)->int {return s.vocab*s.width+s.layers*td_block_size(s);}
td_unembed :: (s:TdShape)->int {return td_final_norm(s)+s.width;}
// Saved values for one layer at one position: input, normed input, two
// inverse RMS values, rotated queries, attention context, the mid residual,
// its norm, the FFN pre-activation, then per-head attention probabilities.
td_slot_size :: (s:TdShape)->int {q:=s.heads*s.head_width;return 4*s.width+2+2*q+s.hidden+s.heads*s.context;}
td_layer_size :: (s:TdShape)->int {return s.context*(td_slot_size(s)+2*s.kv_heads*s.head_width);}
td_work_count :: (s:TdShape)->int {return s.layers*td_layer_size(s)+s.context*(2*s.width+1+s.vocab);}
// book:end layout
td_slot :: (s:TdShape,layer:int,t:int)->int {return layer*td_layer_size(s)+t*td_slot_size(s);}
td_keys :: (s:TdShape,layer:int)->int {return layer*td_layer_size(s)+s.context*td_slot_size(s);}
td_values :: (s:TdShape,layer:int)->int {return td_keys(s,layer)+s.context*s.kv_heads*s.head_width;}
td_final :: (s:TdShape,t:int)->int {return s.layers*td_layer_size(s)+t*(2*s.width+1+s.vocab);}

td_matvec :: (w:[]f64,wo:int,rows:int,cols:int,x:[]f64,xo:int,y:[]f64,yo:int) {
    for r:0..<rows {acc:=0.0;for c:0..<cols {acc+=w[wo+r*cols+c]*x[xo+c];}y[yo+r]=acc;}
}
// y = g*x/rms(x); returns 1/rms(x) for the backward pass.
td_norm :: (x:[]f64,xo:int,g:[]f64,go:int,n:int,y:[]f64,yo:int)->f64 {
    squares:=0.0;for i:0..<n {squares+=x[xo+i]*x[xo+i];}r:=1/sqrt(squares/f64(n)+TD_EPSILON);
    for i:0..<n {y[yo+i]=g[go+i]*x[xo+i]*r;}return r;
}
// Rotates each interleaved pair (2i,2i+1) of every head by position*theta^(-2i/E).
// A negative position applies the transpose, which the backward pass needs.
td_rope :: (v:[]f64,vo:int,heads:int,e:int,position:f64) {
    for h:0..<heads {for i:0..<e/2 {angle:=position*exp(-log(TD_THETA)*f64(2*i)/f64(e));c:=cos(angle);sn:=sin(angle);
        at:=vo+h*e+2*i;a:=v[at];b:=v[at+1];v[at]=a*c-b*sn;v[at+1]=a*sn+b*c;}}
}
td_argmax :: (x:[]f64)->int {best:=0;for i:1..<x.count {if x[i]>x[best] {best=i;}}return best;}

// book:begin advance
// Computes every layer and the logits at position t from the token and the
// keys and values already saved for positions 0..t-1. Nothing later is read.
td_advance :: (s:TdShape,p:[]f64,w:[]f64,token:int,t:int) {
    d:=s.width;e:=s.head_width;q:=s.heads*e;k:=s.kv_heads*e;group:=s.heads/s.kv_heads;scale:=1/sqrt(f64(e));
    first:=td_slot(s,0,t);for i:0..<d {w[first+i]=p[token*d+i];}
    for l:0..<s.layers {
        b:=td_block(s,l);o:=td_slot(s,l,t);n1:=o+d;r:=o+2*d;qs:=r+2;cs:=qs+q;m:=cs+q;n2:=m+d;u:=n2+d;a:=u+s.hidden;
        key:=td_keys(s,l)+t*k;value:=td_values(s,l)+t*k;
        w[r]=td_norm(w,o,p,b.norm1,d,w,n1);
        td_matvec(p,b.wq,q,d,w,n1,w,qs);td_matvec(p,b.wk,k,d,w,n1,w,key);td_matvec(p,b.wv,k,d,w,n1,w,value);
        td_rope(w,qs,s.heads,e,f64(t));td_rope(w,key,s.kv_heads,e,f64(t));
        for h:0..<s.heads {g:=h/group;row:=a+h*s.context;top:=0.0;
            for j:0..<t+1 {score:=0.0;for x:0..<e {score+=w[qs+h*e+x]*w[td_keys(s,l)+j*k+g*e+x];}w[row+j]=score*scale;if j==0 || w[row+j]>top {top=w[row+j];}}
            total:=0.0;for j:0..<t+1 {w[row+j]=exp(w[row+j]-top);total+=w[row+j];}for j:0..<t+1 {w[row+j]/=total;}
            for x:0..<e {acc:=0.0;for j:0..<t+1 {acc+=w[row+j]*w[td_values(s,l)+j*k+g*e+x];}w[cs+h*e+x]=acc;}
        }
        td_matvec(p,b.wo,d,q,w,cs,w,m);for i:0..<d {w[m+i]+=w[o+i];}
        w[r+1]=td_norm(w,m,p,b.norm2,d,w,n2);td_matvec(p,b.w1,s.hidden,d,w,n2,w,u);
        next:=td_final(s,t);if l+1<s.layers {next=td_slot(s,l+1,t);}
        for i:0..<d {acc:=0.0;for f:0..<s.hidden {z:=w[u+f];if z>0 {acc+=p[b.w2+i*s.hidden+f]*z*z;}}w[next+i]=w[m+i]+acc;}
    }
    f:=td_final(s,t);w[f+2*d]=td_norm(w,f,p,td_final_norm(s),d,w,f+d);td_matvec(p,td_unembed(s),s.vocab,d,w,f+d,w,f+2*d+1);
}
// book:end advance
td_admit :: (s:TdShape,p:[]f64,w:[]f64)->TdStatus {
    if !td_valid(s) || p.count!=td_parameter_count(s) {return TdStatus.shape;}if w.count<td_work_count(s) {return TdStatus.capacity;}
    for x:p {if !(x>=-TD_NUMBER && x<=TD_NUMBER) {return TdStatus.number;}}return TdStatus.ok;
}
td_tokens :: (s:TdShape,tokens:[]int)->TdStatus {
    if tokens.count<1 || tokens.count>s.context {return TdStatus.shape;}for x:tokens {if x<0 || x>=s.vocab {return TdStatus.token;}}return TdStatus.ok;
}
// Mean next-token cross entropy over positions 0..n-2 (zero for one token).
td_loss :: (s:TdShape,w:[]f64,tokens:[]int)->f64 {
    if tokens.count<2 {return 0;}total:=0.0;
    for t:0..<tokens.count-1 {z:=td_final(s,t)+2*s.width+1;top:=w[z];for v:1..<s.vocab {if w[z+v]>top {top=w[z+v];}}
        sum:=0.0;for v:0..<s.vocab {sum+=exp(w[z+v]-top);}total+=top+log(sum)-w[z+tokens[t+1]];}
    return total/f64(tokens.count-1);
}
td_forward :: (s:TdShape,p:[]f64,tokens:[]int,w:[]f64,logits:[]f64,overlap:bool)->TdResult #export_c {
    status:=td_admit(s,p,w);if status!=TdStatus.ok {return TdResult.{status=status};}
    status=td_tokens(s,tokens);if status!=TdStatus.ok {return TdResult.{status=status};}
    n:=tokens.count*s.vocab;if logits.count<n {return TdResult.{status=TdStatus.capacity};}if overlap {return TdResult.{status=TdStatus.alias};}
    for t:0..<tokens.count {td_advance(s,p,w,tokens[t],t);}
    for t:0..<tokens.count {z:=td_final(s,t)+2*s.width+1;for v:0..<s.vocab {logits[t*s.vocab+v]=w[z+v];}}
    return TdResult.{written=n,loss=td_loss(s,w,tokens)};
}
// book:begin decode
// One incremental step: `filled` positions are already in the cache; this
// writes position `filled` and returns its logits.
td_decode :: (s:TdShape,p:[]f64,cache:[]f64,filled:int,token:int,logits:[]f64,overlap:bool)->TdResult #export_c {
    status:=td_admit(s,p,cache);if status!=TdStatus.ok {return TdResult.{status=status};}
    if filled<0 || filled>=s.context {return TdResult.{status=TdStatus.position};}if token<0 || token>=s.vocab {return TdResult.{status=TdStatus.token};}
    if logits.count<s.vocab {return TdResult.{status=TdStatus.capacity};}if overlap {return TdResult.{status=TdStatus.alias};}
    td_advance(s,p,cache,token,filled);z:=td_final(s,filled)+2*s.width+1;for v:0..<s.vocab {logits[v]=cache[z+v];}
    return TdResult.{written=filled+1};
}
// book:end decode

// d(g*x*r)/dx with r=1/rms(x): adds dx into out and dg into grads.
td_norm_back :: (dy:[]f64,dyo:int,x:[]f64,xo:int,r:f64,p:[]f64,go:int,n:int,grads:[]f64,out:[]f64,outo:int) {
    dot:=0.0;for i:0..<n {grads[go+i]+=dy[dyo+i]*x[xo+i]*r;dot+=dy[dyo+i]*p[go+i]*x[xo+i];}
    for i:0..<n {out[outo+i]+=r*dy[dyo+i]*p[go+i]-x[xo+i]*r*r*r*dot/f64(n);}
}
// y=W x: adds W^T dy into dx and dy x^T into the weight gradient.
td_matvec_back :: (p:[]f64,wo:int,rows:int,cols:int,x:[]f64,xo:int,dy:[]f64,dyo:int,grads:[]f64,dx:[]f64,dxo:int) {
    for r:0..<rows {for c:0..<cols {grads[wo+r*cols+c]+=dy[dyo+r]*x[xo+c];dx[dxo+c]+=p[wo+r*cols+c]*dy[dyo+r];}}
}
// book:begin backward
td_gradients :: (s:TdShape,p:[]f64,tokens:[]int,w:[]f64,dw:[]f64,grads:[]f64,overlap:bool)->TdResult #export_c {
    status:=td_admit(s,p,w);if status!=TdStatus.ok {return TdResult.{status=status};}
    status=td_tokens(s,tokens);if status!=TdStatus.ok {return TdResult.{status=status};}if tokens.count<2 {return TdResult.{status=TdStatus.shape};}
    if dw.count<td_work_count(s) || grads.count!=p.count {return TdResult.{status=TdStatus.capacity};}if overlap {return TdResult.{status=TdStatus.alias};}
    n:=tokens.count;d:=s.width;e:=s.head_width;q:=s.heads*e;k:=s.kv_heads*e;group:=s.heads/s.kv_heads;scale:=1/sqrt(f64(e));
    for t:0..<n {td_advance(s,p,w,tokens[t],t);}
    for i:0..<grads.count {grads[i]=0;}for i:0..<td_work_count(s) {dw[i]=0;}
    // Head: softmax minus the one-hot target, averaged over the n-1 predictions.
    for t:0..<n-1 {f:=td_final(s,t);z:=f+2*d+1;top:=w[z];for v:1..<s.vocab {if w[z+v]>top {top=w[z+v];}}sum:=0.0;for v:0..<s.vocab {sum+=exp(w[z+v]-top);}
        for v:0..<s.vocab {dw[z+v]=exp(w[z+v]-top)/sum/f64(n-1);}dw[z+tokens[t+1]]-=1/f64(n-1);
        td_matvec_back(p,td_unembed(s),s.vocab,d,w,f+d,dw,z,grads,dw,f+d);td_norm_back(dw,f+d,w,f,w[f+2*d],p,td_final_norm(s),d,grads,dw,f);}
    l:=s.layers;
    while l>0 {l-=1;b:=td_block(s,l);keys:=td_keys(s,l);values:=td_values(s,l);
        for t:0..<n {o:=td_slot(s,l,t);n1:=o+d;r:=o+2*d;qs:=r+2;cs:=qs+q;m:=cs+q;n2:=m+d;u:=n2+d;a:=u+s.hidden;
            next:=td_final(s,t);if l+1<s.layers {next=td_slot(s,l+1,t);}
            for i:0..<d {dw[m+i]+=dw[next+i];}
            for f:0..<s.hidden {z:=w[u+f];if z>0 {g:=0.0;for i:0..<d {grads[b.w2+i*s.hidden+f]+=dw[next+i]*z*z;g+=p[b.w2+i*s.hidden+f]*dw[next+i];}dw[u+f]=2*z*g;}}
            td_matvec_back(p,b.w1,s.hidden,d,w,n2,dw,u,grads,dw,n2);td_norm_back(dw,n2,w,m,w[r+1],p,b.norm2,d,grads,dw,m);
            td_matvec_back(p,b.wo,d,q,w,cs,dw,m,grads,dw,cs);
            for h:0..<s.heads {g:=h/group;row:=a+h*s.context;mean:=0.0;
                for j:0..<t+1 {dp:=0.0;for x:0..<e {dp+=dw[cs+h*e+x]*w[values+j*k+g*e+x];dw[values+j*k+g*e+x]+=w[row+j]*dw[cs+h*e+x];}dw[row+j]=dp;mean+=w[row+j]*dp;}
                for j:0..<t+1 {ds:=w[row+j]*(dw[row+j]-mean)*scale;for x:0..<e {dw[qs+h*e+x]+=ds*w[keys+j*k+g*e+x];dw[keys+j*k+g*e+x]+=ds*w[qs+h*e+x];}}
            }
        }
        for t:0..<n {o:=td_slot(s,l,t);n1:=o+d;r:=o+2*d;qs:=r+2;m:=qs+2*q;key:=keys+t*k;value:=values+t*k;
            td_rope(dw,qs,s.heads,e,-f64(t));td_rope(dw,key,s.kv_heads,e,-f64(t));
            td_matvec_back(p,b.wq,q,d,w,n1,dw,qs,grads,dw,n1);td_matvec_back(p,b.wk,k,d,w,n1,dw,key,grads,dw,n1);td_matvec_back(p,b.wv,k,d,w,n1,dw,value,grads,dw,n1);
            for i:0..<d {dw[o+i]+=dw[m+i];}td_norm_back(dw,n1,w,o,w[r],p,b.norm1,d,grads,dw,o);
        }
    }
    for t:0..<n {o:=td_slot(s,0,t);for i:0..<d {grads[tokens[t]*d+i]+=dw[o+i];}}
    return TdResult.{written=grads.count,loss=td_loss(s,w,tokens)};
}
// book:end backward
// Uniform(-1,1)/sqrt(fan-in) matrices, unit norm gains, from a counter RNG.
td_init :: (s:TdShape,seed:CrSeed,p:[]f64)->CrSeed #export_c {
    state:=seed;for i:0..<p.count {draw:=cr_draw(state);state=draw.next;p[i]=(2*draw.value-1)/sqrt(f64(s.width));}
    for l:0..<s.layers {b:=td_block(s,l);for i:0..<s.width {p[b.norm1+i]=1;p[b.norm2+i]=1;}
        for i:0..<s.width*s.hidden {p[b.w2+i]*=sqrt(f64(s.width))/sqrt(f64(s.hidden));}}
    for i:0..<s.width {p[td_final_norm(s)+i]=1;}return state;
}
