// Psionic Whisper's kernels for an Apple GPU (coax metal-compute). The host
// (psionic/platform/whisper-face.c with --gpu) runs the encoder's
// projections and attention here, and each decoder step as one batch of
// these kernels (norms, products, attention, residual adds and the
// self-attention cache stores); the mel, the prompt and the search run on
// the CPU, on the same shared buffers. The C build of this file is the CPU meaning the
// tests check; the device adds each 32-wide slice of a product in an order
// the hardware chooses, so device results match within a tolerance, not bit
// for bit (see coax/lib/compute/apple.coax).
//
// Checks: coax test psionic/lib/whisper/device.coax --library
#load "../../../coax/lib/compute/apple.coax";
// WD_THREADS, wd_expf and wd_norm: plain f32, shared with CUDA.
#load "device-common.coax";

WD_HEAD :: 64;

// GELU as engine.coax's we_gelu.
wd_gelu :: (x: f32) -> f32 {
  u := 0.7978845608 * (x + 0.044715 * x * x * x);
  if u > 10 { return x; }
  if u < -10 { return 0; }
  return 0.5 * x * (2 - 2 / (wd_expf(2 * u) + 1));
}
// The number of work items of wd_linear: 64-row by 32-output tiles.
wd_linear_items :: (rows: int, n_out: int) -> int { return ((rows + 63) / 64) * ((n_out + 31) / 32); }
// y[r][o] = b[o] + sum_i x[r][i] w[o][i], GELU when act is 1; b is unused
// when bias is 0. Item i is the tile of rows 64 (i / tiles) and outputs
// 32 (i % tiles), tiles = ceil(n_out / 32): the simdgroups multiply 32-wide
// slices of x and w staged in threadgroup memory, zero past the edges.
wd_linear :: (item: int, rows: int, n_in: int, n_out: int, act: int, bias: int, x: [] f32, w: [] f32, b: [] f32, y: [] f32) #export_c {
  tiles := (n_out + 31) / 32; r0 := item / tiles * 64; o0 := item % tiles * 32;
  a: [2048] f32; bt: [1024] f32; acc: [2048] f32;
  for s: 0..<(n_in + 31) / 32 {
    k0 := s * 32;
    for thread: 0..<WD_THREADS {
      for i: 0..<16 {
        e := thread + WD_THREADS * i; r := e / 32; q := e % 32;
        v: f32 = 0; if r0 + r < rows && k0 + q < n_in { v = x[(r0 + r) * n_in + k0 + q]; }
        a[thread + WD_THREADS * i] = v;
      }
      for i: 0..<8 {
        e := thread + WD_THREADS * i; c := e / 32; q := e % 32;
        v: f32 = 0; if o0 + c < n_out && k0 + q < n_in { v = w[(o0 + c) * n_in + k0 + q]; }
        bt[thread + WD_THREADS * i] = v;
      }
    }
    am_sg_mma_64x32x32(acc[..], a[..], bt[..]);
  }
  am_sg_spill_64x32(acc[..], a[..]);
  for thread: 0..<WD_THREADS {
    for i: 0..<16 {
      e := thread + WD_THREADS * i; r := e / 32; c := e % 32;
      if r0 + r < rows && o0 + c < n_out {
        v := a[e];
        if bias == 1 { v += b[o0 + c]; }
        if act == 1 { v = wd_gelu(v); }
        if act == 2 { y[(r0 + r) * n_out + o0 + c] += v; } else { y[(r0 + r) * n_out + o0 + c] = v; }
      }
    }
  }
}
// Attention without a mask, one work item per (head, query): item i is head
// i / nq and query i % nq. One pass over the keys with a running maximum
// (the scores are rescaled when it grows), so no score array is kept.
// Heads have 64 dimensions, as in every Whisper model.
wd_attend :: (item: int, nq: int, nk: int, d: int, heads: int, q: [] f32, k: [] f32, v: [] f32, out: [] f32) #export_c {
  h := item / nq; t := item % nq; hd := h * WD_HEAD;
  qr: [64] f32; acc: [64] f32;
  for i: 0..<WD_HEAD { qr[i] = q[t * d + hd + i] * 0.125; }
  best: f32 = -3.0e38; sum: f32 = 0;
  for j: 0..<nk {
    o := j * d + hd;
    s: f32 = 0;
    for i: 0..<WD_HEAD { s += qr[i] * k[o + i]; }
    if s > best {
      c := wd_expf(best - s);
      sum = sum * c;
      for i: 0..<WD_HEAD { acc[i] = acc[i] * c; }
      best = s;
    }
    p := wd_expf(s - best);
    sum += p;
    for i: 0..<WD_HEAD { acc[i] += p * v[o + i]; }
  }
  for i: 0..<WD_HEAD { out[t * d + hd + i] = acc[i] / sum; }
}

// The same product for at most 8 rows (the decoder's beams), as ggml-metal's
// matrix-vector kernels do it: item i is outputs WD_ROWS_OUT i onward, read
// once by a group of WD_RT threads that each take every WD_RT-th input and
// load each input of every row once for all the group's outputs; thread
// 8 o + r then adds the WD_RT partial sums of output o, row r, the bias,
// and GELU when act is 1.
WD_ROWS_OUT :: 4;
WD_RT :: 128;
wd_rows_items :: (n_out: int) -> int { return (n_out + WD_ROWS_OUT - 1) / WD_ROWS_OUT; }
wd_rows :: (item: int, rows: int, n_in: int, n_out: int, act: int, bias: int, x: [] f32, w: [] f32, b: [] f32, y: [] f32) #export_c {
  part: [WD_RT * 8 * WD_ROWS_OUT] f32;
  o0 := item * WD_ROWS_OUT;
  for thread: 0..<WD_RT {
    a: [8 * WD_ROWS_OUT] f32;
    for u: 0..<(n_in + WD_RT - 1) / WD_RT {
      i := thread + WD_RT * u;
      if i < n_in {
        xr: [8] f32;
        for r: 0..<8 { if r < rows { xr[r] = x[r * n_in + i]; } }
        for oo: 0..<WD_ROWS_OUT {
          if o0 + oo < n_out {
            wv := w[(o0 + oo) * n_in + i];
            for r: 0..<8 { a[oo * 8 + r] += wv * xr[r]; }
          }
        }
      }
    }
    for e: 0..<8 * WD_ROWS_OUT { part[thread + WD_RT * e] = a[e]; }
  }
  for thread: 0..<WD_RT {
    oo := thread / 8; r := thread % 8;
    if thread < 8 * WD_ROWS_OUT && r < rows && o0 + oo < n_out {
      v: f32 = 0;
      for t: 0..<WD_RT { v += part[t + WD_RT * thread]; }
      if bias == 1 { v += b[o0 + oo]; }
      if act == 1 { v = wd_gelu(v); }
      if act == 2 { y[r * n_out + o0 + oo] += v; } else { y[r * n_out + o0 + oo] = v; }
    }
  }
}
// The IEEE half in the low (high false) or high 16 bits of word as f32,
// exactly, as engine.coax's we_half; the host keeps no infinities or NaN.
wd_half :: (word: u32, high: bool) -> f32 {
  h := word & 0xffff; if high { h = word >> 16; }
  e := (h >> 10) & 31; m := h & 1023;
  v: f32 = 0;
  if e == 0 { v = cast(f32) m * f32_from_bits(0x33800000); }
  else { v = f32_from_bits(((e + 112) << 23) | (m << 13)); }
  if (h >> 15) == 1 { v = -v; }
  return v;
}
// wd_rows with the weights as halves, two to a word (the low half first):
// the model's own f16 values, so the product reads half the bytes. n_in is
// even; thread i takes the inputs 2 i and 2 i + 1 of every WD_RT-th word.
// Partial sum e of thread t is at t + WD_RT e. Pass one has thread t add
// the partials of value e = t % 32 from threads 32 (t / 32) onward, starting
// at the one in lane e, so the 32 threads of a simdgroup read 32 different
// banks at each step; pass two adds those four. act 2 adds the result to y
// (a residual) instead of storing it. act 3 is a block's query, key and
// value at once (n_out three times the width e): outputs below e are row r's
// query in y, and the key and value go to row r's place in the cache kvc,
// slot and position from sp (wd_slot_pos): key at (slot ctx + pos) e,
// value vstride later.
wd_rowsh :: (item: int, rows: int, n_in: int, n_out: int, act: int, bias: int, x: [] f32, w: [] u32, b: [] f32, y: [] f32,
             sp: int, ctx: int, vstride: int, kvc: [] f32) #export_c {
  part: [WD_RT * 8 * WD_ROWS_OUT] f32; red: [WD_RT] f32;
  o0 := item * WD_ROWS_OUT; nw := n_in / 2;
  wo := w[o0 * nw..<w.count];  // the group's weight rows, so each index is small
  for thread: 0..<WD_RT {
    a: [8 * WD_ROWS_OUT] f32;
    for u: 0..<(nw + WD_RT - 1) / WD_RT {
      i := thread + WD_RT * u;
      if i < nw {
        x0: [8] f32; x1: [8] f32;
        for r: 0..<8 { if r < rows { x0[r] = x[r * n_in + 2 * i]; x1[r] = x[r * n_in + 2 * i + 1]; } }
        for oo: 0..<WD_ROWS_OUT {
          if o0 + oo < n_out {
            word := wo[oo * nw + i];
            wa := wd_half(word, false); wb := wd_half(word, true);
            for r: 0..<8 { v := fma(wa, x0[r], fma(wb, x1[r], a[oo * 8 + r])); a[oo * 8 + r] = v; }
          }
        }
      }
    }
    for e: 0..<8 * WD_ROWS_OUT { part[thread + WD_RT * e] = a[e]; }
  }
  for thread: 0..<WD_RT {
    e := thread % 32; q := thread / 32;
    z: f32 = 0;
    for j: 0..<32 { z += part[q * 32 + (e + j) % 32 + WD_RT * e]; }
    red[thread] = z;
  }
  for thread: 0..<WD_RT {
    oo := thread / 8; r := thread % 8;
    if thread < 8 * WD_ROWS_OUT && r < rows && o0 + oo < n_out {
      v := (red[thread] + red[thread + 32]) + (red[thread + 64] + red[thread + 96]);
      if bias == 1 { v += b[o0 + oo]; }
      if act == 1 { v = wd_gelu(v); }
      o := o0 + oo;
      if act == 3 {
        e := n_out / 3; at := wd_slot_pos(sp, r); place := ((at >> 9) * ctx + (at & 511)) * e;
        if o < e { y[r * e + o] = v; } else if o < 2 * e { kvc[place + o - e] = v; } else { kvc[vstride + place + o - 2 * e] = v; }
      } else if act == 2 { y[r * n_out + o] += v; } else { y[r * n_out + o] = v; }
    }
  }
}
// The decoder's products, at most WD_MR rows (the beams), with half
// weights: item i is outputs WD_MO i onward, one group of WD_MT threads.
// Thread t takes every WD_MT-th word of those outputs' weight rows, so each
// input of each row is loaded once for the group's outputs; partial sum e
// of thread t is at t + WD_MT e, and thread e then adds value e's WD_MT
// partials, starting at lane e so a simdgroup reads 32 banks at each step.
WD_MR :: 5;
WD_MO :: 4;
WD_MT :: 32;
wd_mv_items :: (n_out: int) -> int { return (n_out + WD_MO - 1) / WD_MO; }
wd_mv :: (item: int, rows: int, n_in: int, n_out: int, act: int, bias: int, x: [] f32, w: [] u32, b: [] f32, y: [] f32) #export_c {
  part: [WD_MT * WD_MR * WD_MO] f32;
  o0 := item * WD_MO; nw := n_in / 2;
  wo := w[o0 * nw..<w.count];
  for thread: 0..<WD_MT {
    a: [WD_MR * WD_MO] f32;
    for u: 0..<(nw + WD_MT - 1) / WD_MT {
      i := thread + WD_MT * u;
      if i < nw {
        x0: [WD_MR] f32; x1: [WD_MR] f32;
        for r: 0..<WD_MR { if r < rows { x0[r] = x[r * n_in + 2 * i]; x1[r] = x[r * n_in + 2 * i + 1]; } }
        for oo: 0..<WD_MO {
          if o0 + oo < n_out {
            word := wo[oo * nw + i];
            wa := wd_half(word, false); wb := wd_half(word, true);
            for r: 0..<WD_MR { v := fma(wa, x0[r], fma(wb, x1[r], a[oo * WD_MR + r])); a[oo * WD_MR + r] = v; }
          }
        }
      }
    }
    for e: 0..<WD_MR * WD_MO { part[thread + WD_MT * e] = a[e]; }
  }
  for thread: 0..<WD_MT {
    if thread < WD_MR * WD_MO {
      oo := thread / WD_MR; r := thread % WD_MR;
      z: f32 = 0;
      for j: 0..<WD_MT { z += part[(thread + j) % WD_MT + WD_MT * thread]; }
      if r < rows && o0 + oo < n_out {
        if bias == 1 { z += b[o0 + oo]; }
        if act == 1 { z = wd_gelu(z); }
        if act == 2 { y[r * n_out + o0 + oo] += z; } else { y[r * n_out + o0 + oo] = z; }
      }
    }
  }
}
// A beam's token rules, log-softmax and top k on the GPU, as search.coax's
// we_rules then we_topk, so the step hands the search k candidates a row
// instead of the vocabulary. Row r's rules are WD_PRM values at
// prm[r WD_PRM] (we_rule_params writes them): the temperature's inverse,
// masked ranges, masked tokens and bias adds (token, amount) in order, each
// count first. wd_rules_part takes each chunk of a row (item r chunks + c)
// and leaves its maximum, sum and best tokens in rec (WD_REC values);
// wd_rules_join (item r) combines a row's chunks. top
// receives the row's count n, then n (token, log-probability) pairs, best
// first, ties to the lower token, as we_topk.
WD_PRM :: 64;
WD_RANGES :: 8;
WD_SINGLES :: 20;
WD_ADDS :: 12;
WD_TOP :: 16;
WD_RT2 :: 128;
WD_NEG :: -1.0e30;
wd_dead :: (v: f32) -> bool { return v < -1.0e29; }
// search.coax's we_expv, step for step.
wd_expv :: (x: f32) -> f32 {
  y := x; if y < -87 { y = -87; } if y > 88 { y = 88; }
  k := y * 1.442695041 + 12582912.0;
  fn := k - 12582912.0;
  r := (y - fn * 0.693145752) - fn * 0.00000142860677;
  p := 1 + r * (1 + r * (0.5 + r * (0.1666666667 + r * (0.04166666667 + r * (0.008333333333 + r * 0.001388888889)))));
  e := p * f32_from_bits((f32_bits(k) - 0x4B3FFF81) << 23);
  return ifx x < -87 then 0 else e;
}
// a ranks above b: larger, or equal and the lower token (tokens fit 32 bits)
wd_above :: (av: f32, ai: s32, bv: f32, bi: s32) -> bool { return av > bv || (av == bv && ai < bi); }
WD_CH :: 2048;
WD_REC :: 16;
WD_NONE :: -3.0e38;
// A row's chunks: [0, beg) then [beg, V), WD_CH tokens each, so a chunk is
// all text or all timestamps.
wd_text_chunks :: (beg: int) -> int { return (beg + WD_CH - 1) / WD_CH; }
wd_rule_chunks :: (V: int, beg: int) -> int { return wd_text_chunks(beg) + (V - beg + WD_CH - 1) / WD_CH; }
// Chunk item of the rows: its maximum m, the sum of e^(lp - m) in f64, and
// its best 5 live tokens by lp, ties to the lower token (WD_NONE pads).
// Pass one finds m; pass two applies the rules again rather than keeping
// the chunk's values, so the group's memory stays small enough for several
// groups to share a GPU core. The best lists are merged in pairs, from gv
// and gi to hv and hk and back, half as many lists each time.
wd_rules_part :: (item: int, V: int, beg: int, prm: [] f32, logits: [] f32, rec: [] f64) #export_c {
  tc := wd_text_chunks(beg); chunks := wd_rule_chunks(V, beg);
  r := item / chunks; c := item % chunks;
  c0 := ifx c < tc then c * WD_CH else beg + (c - tc) * WD_CH;
  last := ifx c < tc then beg else V; end := ifx c0 + WD_CH < last then c0 + WD_CH else last;
  P := r * WD_PRM; L := r * V; A0 := P + 4 + 2 * WD_RANGES + WD_SINGLES; S0 := P + 3 + 2 * WD_RANGES;
  lr := logits[L..<logits.count];  // the row, so each index is small
  inv := prm[P]; nr := cast(int) prm[P + 1]; ns := cast(int) prm[S0 - 1]; na := cast(int) prm[A0 - 1];
  mx: [WD_RT2] f32; sx: [WD_RT2] f64;
  gv: [WD_RT2 * 5] f32; gi: [WD_RT2 * 5] f32; hv: [WD_RT2 * 5] f32; hk: [WD_RT2 * 5] f32;
  // the chunk's scaled logits with the rules applied, and its maximum
  for thread: 0..<WD_RT2 {
    // Tokens are below 2^24 (exact in f32), so the rules compare in 32 bits.
    lo: [WD_RANGES] s32; hi: [WD_RANGES] s32; at: [WD_ADDS] s32; by: [WD_ADDS] f32; sg: [WD_SINGLES] s32;
    for g: 0..<WD_RANGES { lo[g] = ifx g < nr then cast(s32) prm[P + 2 + 2 * g] else 0; hi[g] = ifx g < nr then cast(s32) prm[P + 3 + 2 * g] else 0; }
    for g: 0..<WD_ADDS { at[g] = ifx g < na then cast(s32) prm[A0 + 2 * g] else -1; by[g] = ifx g < na then prm[A0 + 2 * g + 1] else 0; }
    for g: 0..<WD_SINGLES { sg[g] = ifx g < ns then cast(s32) prm[S0 + g] else -1; }
    a: f32 = WD_NONE;
    for u: 0..<WD_CH / WD_RT2 {
      i := c0 + thread + WD_RT2 * u;
      if i < end {
        v := lr[i] * inv; t := cast(s32) i;
        for g: 0..<WD_RANGES { if t >= lo[g] && t < hi[g] { v = WD_NEG; } }
        for g: 0..<WD_ADDS { if at[g] == t && !wd_dead(v) { v += by[g]; } }
        for g: 0..<WD_SINGLES { if sg[g] == t { v = WD_NEG; } }
        if v > a { a = v; }
      }
    }
    mx[thread] = a;
  }
  m: f32 = WD_NONE;
  for i: 0..<WD_RT2 { if mx[i] > m { m = mx[i]; } }
  // the sum of e^(lp - m), in f64; each thread's best 5
  for thread: 0..<WD_RT2 {
    // Tokens are below 2^24 (exact in f32), so the rules compare in 32 bits.
    lo: [WD_RANGES] s32; hi: [WD_RANGES] s32; at: [WD_ADDS] s32; by: [WD_ADDS] f32; sg: [WD_SINGLES] s32;
    for g: 0..<WD_RANGES { lo[g] = ifx g < nr then cast(s32) prm[P + 2 + 2 * g] else 0; hi[g] = ifx g < nr then cast(s32) prm[P + 3 + 2 * g] else 0; }
    for g: 0..<WD_ADDS { at[g] = ifx g < na then cast(s32) prm[A0 + 2 * g] else -1; by[g] = ifx g < na then prm[A0 + 2 * g + 1] else 0; }
    for g: 0..<WD_SINGLES { sg[g] = ifx g < ns then cast(s32) prm[S0 + g] else -1; }
    z := 0.0;
    bv: [5] f32; bi: [5] s32;
    for j: 0..<5 { bv[j] = WD_NONE; bi[j] = 1 << 30; }
    for u: 0..<WD_CH / WD_RT2 {
      i := c0 + thread + WD_RT2 * u;
      if i < end {
        v := lr[i] * inv; t := cast(s32) i;
        for g: 0..<WD_RANGES { if t >= lo[g] && t < hi[g] { v = WD_NEG; } }
        for g: 0..<WD_ADDS { if at[g] == t && !wd_dead(v) { v += by[g]; } }
        for g: 0..<WD_SINGLES { if sg[g] == t { v = WD_NEG; } }
        if !wd_dead(m) { z += cast(f64) wd_expv(v - m); }
        if !wd_dead(v) && wd_above(v, t, bv[4], bi[4]) {
          o := 0;
          for j: 0..<5 { if wd_above(bv[j], bi[j], v, t) { o += 1; } }
          for jj: 0..<4 { j := 4 - jj; if j > o { bv[j] = bv[j - 1]; bi[j] = bi[j - 1]; } }
          bv[o] = v; bi[o] = t;
        }
      }
    }
    sx[thread] = z;
    for j: 0..<5 { gv[thread + WD_RT2 * j] = bv[j]; gi[thread + WD_RT2 * j] = cast(f32) bi[j]; }
  }
  for thread: 0..<WD_RT2 {
    if thread < 64 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := gv[x + WD_RT2 * p]; ai := cast(s32) gi[x + WD_RT2 * p];
        bv := gv[x + 1 + WD_RT2 * q]; bi := cast(s32) gi[x + 1 + WD_RT2 * q];
        if wd_above(av, ai, bv, bi) { hv[thread + WD_RT2 * j] = av; hk[thread + WD_RT2 * j] = cast(f32) ai; p += 1; }
        else { hv[thread + WD_RT2 * j] = bv; hk[thread + WD_RT2 * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RT2 {
    if thread < 32 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := hv[x + WD_RT2 * p]; ai := cast(s32) hk[x + WD_RT2 * p];
        bv := hv[x + 1 + WD_RT2 * q]; bi := cast(s32) hk[x + 1 + WD_RT2 * q];
        if wd_above(av, ai, bv, bi) { gv[thread + WD_RT2 * j] = av; gi[thread + WD_RT2 * j] = cast(f32) ai; p += 1; }
        else { gv[thread + WD_RT2 * j] = bv; gi[thread + WD_RT2 * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RT2 {
    if thread < 16 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := gv[x + WD_RT2 * p]; ai := cast(s32) gi[x + WD_RT2 * p];
        bv := gv[x + 1 + WD_RT2 * q]; bi := cast(s32) gi[x + 1 + WD_RT2 * q];
        if wd_above(av, ai, bv, bi) { hv[thread + WD_RT2 * j] = av; hk[thread + WD_RT2 * j] = cast(f32) ai; p += 1; }
        else { hv[thread + WD_RT2 * j] = bv; hk[thread + WD_RT2 * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RT2 {
    if thread < 8 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := hv[x + WD_RT2 * p]; ai := cast(s32) hk[x + WD_RT2 * p];
        bv := hv[x + 1 + WD_RT2 * q]; bi := cast(s32) hk[x + 1 + WD_RT2 * q];
        if wd_above(av, ai, bv, bi) { gv[thread + WD_RT2 * j] = av; gi[thread + WD_RT2 * j] = cast(f32) ai; p += 1; }
        else { gv[thread + WD_RT2 * j] = bv; gi[thread + WD_RT2 * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RT2 {
    if thread < 4 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := gv[x + WD_RT2 * p]; ai := cast(s32) gi[x + WD_RT2 * p];
        bv := gv[x + 1 + WD_RT2 * q]; bi := cast(s32) gi[x + 1 + WD_RT2 * q];
        if wd_above(av, ai, bv, bi) { hv[thread + WD_RT2 * j] = av; hk[thread + WD_RT2 * j] = cast(f32) ai; p += 1; }
        else { hv[thread + WD_RT2 * j] = bv; hk[thread + WD_RT2 * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RT2 {
    if thread < 2 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := hv[x + WD_RT2 * p]; ai := cast(s32) hk[x + WD_RT2 * p];
        bv := hv[x + 1 + WD_RT2 * q]; bi := cast(s32) hk[x + 1 + WD_RT2 * q];
        if wd_above(av, ai, bv, bi) { gv[thread + WD_RT2 * j] = av; gi[thread + WD_RT2 * j] = cast(f32) ai; p += 1; }
        else { gv[thread + WD_RT2 * j] = bv; gi[thread + WD_RT2 * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RT2 {
    if thread < 1 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := gv[x + WD_RT2 * p]; ai := cast(s32) gi[x + WD_RT2 * p];
        bv := gv[x + 1 + WD_RT2 * q]; bi := cast(s32) gi[x + 1 + WD_RT2 * q];
        if wd_above(av, ai, bv, bi) { hv[thread + WD_RT2 * j] = av; hk[thread + WD_RT2 * j] = cast(f32) ai; p += 1; }
        else { hv[thread + WD_RT2 * j] = bv; hk[thread + WD_RT2 * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  R := item * WD_REC;
  for thread: 0..<WD_RT2 {
    if thread == 0 {
      zs := 0.0;
      for i: 0..<WD_RT2 { zs += sx[i]; }
      rec[R] = cast(f64) m; rec[R + 1] = zs;
      for j: 0..<5 { rec[R + 2 + 2 * j] = cast(f64) hk[WD_RT2 * j]; rec[R + 3 + 2 * j] = cast(f64) hv[WD_RT2 * j]; }
    }
  }
}
// Row item from its chunks: the log-softmax over the row (text and
// timestamps apart, as we_rules), then its best k (at most 5) into top.
// WD_RJ threads take the chunks in turn; the chunk sums are added in chunk
// order, so at most WD_RJC chunks a row.
WD_RJ :: 32;
WD_RJC :: 64;
wd_rules_join :: (item: int, V: int, beg: int, k: int, rec: [] f64, top: [] f32) #export_c {
  tc := wd_text_chunks(beg); chunks := wd_rule_chunks(V, beg); R0 := item * chunks * WD_REC;
  t1: [WD_RJ] f32; t2: [WD_RJ] f32; ec: [WD_RJC] f64;
  tv: [WD_RJ * 5] f32; ti: [WD_RJ * 5] f32; uv: [WD_RJ * 5] f32; ui: [WD_RJ * 5] f32;
  // the largest text and timestamp chunk maxima
  for thread: 0..<WD_RJ {
    a1: f32 = WD_NONE; a2: f32 = WD_NONE;
    for u: 0..<WD_RJC / WD_RJ {
      c := thread + WD_RJ * u;
      if c < chunks {
        m := cast(f32) rec[R0 + c * WD_REC];
        if c < tc { if m > a1 { a1 = m; } } else { if m > a2 { a2 = m; } }
      }
    }
    t1[thread] = a1; t2[thread] = a2;
  }
  m1: f32 = WD_NONE; m2: f32 = WD_NONE;
  for i: 0..<WD_RJ { if t1[i] > m1 { m1 = t1[i]; } if t2[i] > m2 { m2 = t2[i]; } }
  text := ifx wd_dead(m1) then -1.0e300 else cast(f64) m1;
  tmax := ifx wd_dead(m2) then -1.0e300 else cast(f64) m2;
  best := ifx text > tmax then text else tmax;
  bf := ifx best > -1.0e299 then cast(f32) best else 0;
  // each chunk's sum at the row's maximum
  for thread: 0..<WD_RJ {
    for u: 0..<WD_RJC / WD_RJ {
      c := thread + WD_RJ * u;
      if c < chunks {
        R := R0 + c * WD_REC; m := cast(f32) rec[R];
        e := 0.0;
        if !wd_dead(m) { e = rec[R + 1] * exp(cast(f64) m - cast(f64) bf); }
        ec[thread + WD_RJ * u] = e;
      }
    }
  }
  zx := 0.0; zt := 0.0;
  for c: 0..<chunks { if c < WD_RJC { if c < tc { zx += ec[c]; } else { zt += ec[c]; } } }
  lz := best + log(zx + zt);
  ts := ifx zt > 0 then best + log(zt) else -1.0e300;
  only_ts := ts > text;
  // each thread's best k of its chunks' tokens, then pairs of lists merged
  for thread: 0..<WD_RJ {
    bv: [5] f32; bi: [5] s32; n := 0;
    for j: 0..<5 { bv[j] = WD_NONE; bi[j] = 1 << 30; }
    for u: 0..<WD_RJC / WD_RJ {
      c := thread + WD_RJ * u;
      if c < chunks && (c >= tc || !only_ts) {
        for e: 0..<5 {
          R := R0 + c * WD_REC + 2 + 2 * e;
          raw := cast(f32) rec[R + 1];
          if !wd_dead(raw) {
            i := cast(s32) cast(f32) rec[R]; v := cast(f32) (rec[R + 1] - lz);
            if n < k || wd_above(v, i, bv[k - 1], bi[k - 1]) {
              o := 0;
              for j: 0..<5 { if j < n && wd_above(bv[j], bi[j], v, i) { o += 1; } }
              for jj: 0..<4 { j := 4 - jj; if j > o && j < k { bv[j] = bv[j - 1]; bi[j] = bi[j - 1]; } }
              bv[o] = v; bi[o] = i;
              if n < k { n += 1; }
            }
          }
        }
      }
    }
    for j: 0..<5 { tv[thread + WD_RJ * j] = bv[j]; ti[thread + WD_RJ * j] = cast(f32) bi[j]; }
  }
  for thread: 0..<WD_RJ {
    if thread < 16 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := tv[x + WD_RJ * p]; ai := cast(s32) ti[x + WD_RJ * p];
        bv := tv[x + 1 + WD_RJ * q]; bi := cast(s32) ti[x + 1 + WD_RJ * q];
        if wd_above(av, ai, bv, bi) { uv[thread + WD_RJ * j] = av; ui[thread + WD_RJ * j] = cast(f32) ai; p += 1; }
        else { uv[thread + WD_RJ * j] = bv; ui[thread + WD_RJ * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RJ {
    if thread < 8 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := uv[x + WD_RJ * p]; ai := cast(s32) ui[x + WD_RJ * p];
        bv := uv[x + 1 + WD_RJ * q]; bi := cast(s32) ui[x + 1 + WD_RJ * q];
        if wd_above(av, ai, bv, bi) { tv[thread + WD_RJ * j] = av; ti[thread + WD_RJ * j] = cast(f32) ai; p += 1; }
        else { tv[thread + WD_RJ * j] = bv; ti[thread + WD_RJ * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RJ {
    if thread < 4 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := tv[x + WD_RJ * p]; ai := cast(s32) ti[x + WD_RJ * p];
        bv := tv[x + 1 + WD_RJ * q]; bi := cast(s32) ti[x + 1 + WD_RJ * q];
        if wd_above(av, ai, bv, bi) { uv[thread + WD_RJ * j] = av; ui[thread + WD_RJ * j] = cast(f32) ai; p += 1; }
        else { uv[thread + WD_RJ * j] = bv; ui[thread + WD_RJ * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RJ {
    if thread < 2 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := uv[x + WD_RJ * p]; ai := cast(s32) ui[x + WD_RJ * p];
        bv := uv[x + 1 + WD_RJ * q]; bi := cast(s32) ui[x + 1 + WD_RJ * q];
        if wd_above(av, ai, bv, bi) { tv[thread + WD_RJ * j] = av; ti[thread + WD_RJ * j] = cast(f32) ai; p += 1; }
        else { tv[thread + WD_RJ * j] = bv; ti[thread + WD_RJ * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  for thread: 0..<WD_RJ {
    if thread < 1 {
      p := 0; q := 0; x := 2 * thread;
      for j: 0..<5 {
        av := tv[x + WD_RJ * p]; ai := cast(s32) ti[x + WD_RJ * p];
        bv := tv[x + 1 + WD_RJ * q]; bi := cast(s32) ti[x + 1 + WD_RJ * q];
        if wd_above(av, ai, bv, bi) { uv[thread + WD_RJ * j] = av; ui[thread + WD_RJ * j] = cast(f32) ai; p += 1; }
        else { uv[thread + WD_RJ * j] = bv; ui[thread + WD_RJ * j] = cast(f32) bi; q += 1; }
      }
    }
  }
  T := item * WD_TOP;
  for thread: 0..<WD_RJ {
    if thread == 0 {
      n := 0;
      for j: 0..<5 { if j < k && !wd_dead(uv[WD_RJ * j]) { n += 1; } }
      top[T] = cast(f32) n;
      for j: 0..<5 { if j < n { top[T + 1 + 2 * j] = ui[WD_RJ * j]; top[T + 2 + 2 * j] = uv[WD_RJ * j]; } }
    }
  }
}
// ka[i] and va[i] into kb[i] and vb[i]: a row's keys and values into its
// self-attention cache slot.
wd_store :: (item: int, ka: [] f32, va: [] f32, kb: [] f32, vb: [] f32) #export_c { kb[item] = ka[item]; vb[item] = va[item]; }

// Attention for a few queries (the decoder's rows) in two launches, as
// ggml-metal's vector flash attention splits the keys. Not causal (causal
// 0): every query sees all nk keys, rows 0..nk of k and v. Causal: query t
// reads its own self-attention cache slot, positions 0..p of slot s, the
// rows s ctx.. of k and v, where s and p are packed in 12 bits of sp per
// query: wd_slot_pos(sp, t) = 512 s + p (so at most five queries, eight
// slots and 512 positions). wd_part: item i is head and query i / C (head
// (i / C) / nq, query (i / C) % nq) and the chunk c = i % C of 128 keys
// (C = wd_chunks(nk), nk above every query's count); its 128 threads score
// a key each, and it leaves at part[66 i] the chunk's largest score, the
// sum of its exponentials and its 64 weighted sums of values.
WD_CHUNK :: 128;
WD_PART :: 66;
wd_chunks :: (nk: int) -> int { return (nk + WD_CHUNK - 1) / WD_CHUNK; }
wd_slot_pos :: (sp: int, t: int) -> int { return (sp >> (12 * t)) & 4095; }
wd_part :: (item: int, nq: int, nk: int, d: int, heads: int, ctx: int, sp: int, causal: int, q: [] f32, k: [] f32, v: [] f32, part: [] f32, out: [] f32) #export_c {
  C := wd_chunks(nk); qi := item / C; j0 := item % C * WD_CHUNK;
  h := qi / nq; t := qi % nq; hd := h * WD_HEAD;
  n := nk; base := 0;
  if causal == 1 { e := wd_slot_pos(sp, t); base = (e >> 9) * ctx; if (e & 511) + 1 < nk { n = (e & 511) + 1; } }
  qr: [64] f32; s: [128] f32; red: [128] f32;
  // Views at the query's row and the chunk's first key, so each index is small.
  qt := q[t * d..<q.count]; ot := out[t * d..<out.count];
  kc := k[(base + j0) * d..<k.count]; vc := v[(base + j0) * d..<v.count];
  for thread: 0..<WD_THREADS { if thread < WD_HEAD { qr[thread] = qt[hd + thread] * 0.125; } }
  for thread: 0..<WD_THREADS {
    a: f32 = -3.0e38;
    if j0 + thread < n {
      a = 0;
      for i: 0..<WD_HEAD { a += qr[i] * kc[thread * d + hd + i]; }
    }
    s[thread] = a;
  }
  best: f32 = -3.0e38;
  for i: 0..<WD_THREADS { if s[i] > best { best = s[i]; } }
  for thread: 0..<WD_THREADS {
    e: f32 = 0;
    if j0 + thread < n { e = wd_expf(s[thread] - best); }
    s[thread] = e;
  }
  total: f32 = 0;
  for i: 0..<WD_THREADS { total += s[i]; }
  for thread: 0..<WD_THREADS {
    c := thread % WD_HEAD; par := thread / WD_HEAD;
    a: f32 = 0;
    for u: 0..<WD_CHUNK / 2 { j := par + 2 * u; if j0 + j < n { a += s[j] * vc[j * d + hd + c]; } }
    red[thread] = a;
  }
  for thread: 0..<WD_THREADS {
    if C == 1 { if thread < WD_HEAD { ot[hd + thread] = (red[thread] + red[thread + WD_HEAD]) / total; } }
    else {
      if thread < WD_HEAD { part[item * WD_PART + 2 + thread] = red[thread] + red[thread + WD_HEAD]; }
      if thread == 0 { part[item * WD_PART] = best; part[item * WD_PART + 1] = total; }
    }
  }
}
// wd_cross: the same parts when every query sees all nk keys (the
// cross-attention of the decoder's rows, at most 8): item i is head i / C
// and chunk i % C, and its 128 threads score their key for every query, so
// each key and value is read once for all the queries.
wd_cross :: (item: int, nq: int, nk: int, d: int, heads: int, q: [] f32, k: [] f32, v: [] f32, part: [] f32) #export_c {
  C := wd_chunks(nk); h := item / C; c0 := item % C; j0 := c0 * WD_CHUNK; hd := h * WD_HEAD;
  qr: [512] f32; s: [1024] f32; red: [8] f32; tot: [8] f32; acc: [1024] f32;
  kc := k[j0 * d..<k.count]; vc := v[j0 * d..<v.count];  // the chunk's first key, so each index is small
  for thread: 0..<WD_THREADS {
    for e: 0..<4 {
      if (thread + WD_THREADS * e) / WD_HEAD < nq { qr[thread + WD_THREADS * e] = q[(thread + WD_THREADS * e) / WD_HEAD * d + hd + (thread + WD_THREADS * e) % WD_HEAD] * 0.125; }
    }
  }
  for thread: 0..<WD_THREADS {
    a: [8] f32;
    if j0 + thread < nk {
      for i: 0..<WD_HEAD {
        kv := kc[thread * d + hd + i];
        for t: 0..<8 { a[t] += qr[t * WD_HEAD + i] * kv; }
      }
    }
    for t: 0..<8 { e: f32 = -3.0e38; if j0 + thread < nk { e = a[t]; } s[thread + WD_THREADS * t] = e; }
  }
  for thread: 0..<WD_THREADS {
    if thread < nq { m: f32 = -3.0e38; for j: 0..<WD_CHUNK { if s[thread * WD_CHUNK + j] > m { m = s[thread * WD_CHUNK + j]; } } red[thread] = m; }
  }
  for thread: 0..<WD_THREADS {
    for t: 0..<8 { e: f32 = 0; if j0 + thread < nk && t < nq { e = wd_expf(s[thread + WD_THREADS * t] - red[t]); } s[thread + WD_THREADS * t] = e; }
  }
  for thread: 0..<WD_THREADS {
    if thread < nq { z: f32 = 0; for j: 0..<WD_CHUNK { z += s[thread * WD_CHUNK + j]; } tot[thread] = z; }
  }
  for thread: 0..<WD_THREADS {
    c := thread % WD_HEAD; par := thread / WD_HEAD;
    a: [8] f32;
    for u: 0..<WD_CHUNK / 2 {
      j := par + 2 * u;
      if j0 + j < nk {
        vv := vc[j * d + hd + c];
        for t: 0..<8 { a[t] += s[t * WD_CHUNK + j] * vv; }
      }
    }
    for t: 0..<8 { acc[thread + WD_THREADS * t] = a[t]; }
  }
  for thread: 0..<WD_THREADS {
    for e: 0..<4 {
      t := (thread + WD_THREADS * e) / WD_HEAD; c := (thread + WD_THREADS * e) % WD_HEAD;
      if t < nq { part[((h * nq + t) * C + c0) * WD_PART + 2 + c] = acc[c + WD_THREADS * t] + acc[c + WD_HEAD + WD_THREADS * t]; }
    }
    if thread < nq { part[((h * nq + thread) * C + c0) * WD_PART] = red[thread]; part[((h * nq + thread) * C + c0) * WD_PART + 1] = tot[thread]; }
  }
}
// wd_join: item i is head i / nq and query i % nq; its 64 threads rescale
// the chunks to their largest score and write dimension thread of out.
wd_join :: (item: int, nq: int, nk: int, d: int, part: [] f32, out: [] f32) #export_c {
  C := wd_chunks(nk); h := item / nq; t := item % nq;
  pi := part[item * C * WD_PART..<part.count];  // this query's chunks
  for thread: 0..<WD_HEAD {
    m: f32 = -3.0e38;
    for c: 0..<C { if pi[c * WD_PART] > m { m = pi[c * WD_PART]; } }
    acc: f32 = 0; tot: f32 = 0;
    for c: 0..<C {
      at := c * WD_PART;
      e := wd_expf(pi[at] - m);
      tot += e * pi[at + 1];
      acc += e * pi[at + 2 + thread];
    }
    out[t * d + h * WD_HEAD + thread] = acc / tot;
  }
}

// Attention as three launches over every head at once, through a score
// buffer s of heads * nq * nk values. wd_scores: item i is head i / (qt kt)
// and the 64-query by 32-key tile i % (qt kt) (qt = ceil(nq / 64), kt =
// ceil(nk / 32)) of s = q k^T / 8.
wd_scores_items :: (nq: int, nk: int, heads: int) -> int { return heads * ((nq + 63) / 64) * ((nk + 31) / 32); }
wd_scores :: (item: int, nq: int, nk: int, d: int, heads: int, q: [] f32, k: [] f32, s: [] f32) #export_c {
  kt := (nk + 31) / 32; per := ((nq + 63) / 64) * kt;
  h := item / per; tile := item % per; t0 := tile / kt * 64; j0 := tile % kt * 32; hd := h * WD_HEAD;
  a: [2048] f32; bt: [1024] f32; acc: [2048] f32;
  for st: 0..<2 {
    k0 := hd + st * 32;
    for thread: 0..<WD_THREADS {
      for i: 0..<16 {
        e := thread + WD_THREADS * i; r := e / 32; c := e % 32;
        x: f32 = 0; if t0 + r < nq { x = q[(t0 + r) * d + k0 + c]; }
        a[thread + WD_THREADS * i] = x;
      }
      for i: 0..<8 {
        e := thread + WD_THREADS * i; r := e / 32; c := e % 32;
        x: f32 = 0; if j0 + r < nk { x = k[(j0 + r) * d + k0 + c]; }
        bt[thread + WD_THREADS * i] = x;
      }
    }
    am_sg_mma_64x32x32(acc[..], a[..], bt[..]);
  }
  am_sg_spill_64x32(acc[..], a[..]);
  for thread: 0..<WD_THREADS {
    for i: 0..<16 {
      e := thread + WD_THREADS * i; r := e / 32; c := e % 32;
      if t0 + r < nq && j0 + c < nk { s[(h * nq + t0 + r) * nk + j0 + c] = a[e] * 0.125; }
    }
  }
}
// Each row of s (item i is row i) becomes its softmax, by a group of 128
// threads: each reduces its own strided values, then all read the parts.
wd_softmax :: (item: int, nk: int, s: [] f32) #export_c {
  part: [128] f32;
  base := item * nk;
  for thread: 0..<WD_THREADS {
    m: f32 = -3.0e38;
    for u: 0..<(nk + WD_THREADS - 1) / WD_THREADS { j := thread + WD_THREADS * u; if j < nk && s[base + j] > m { m = s[base + j]; } }
    part[thread] = m;
  }
  best: f32 = -3.0e38;
  for i: 0..<WD_THREADS { if part[i] > best { best = part[i]; } }
  for thread: 0..<WD_THREADS {
    z: f32 = 0;
    for u: 0..<(nk + WD_THREADS - 1) / WD_THREADS { j := thread + WD_THREADS * u; if j < nk { e := wd_expf(s[base + j] - best); s[base + j] = e; z += e; } }
    part[thread] = z;
  }
  total: f32 = 0;
  for i: 0..<WD_THREADS { total += part[i]; }
  inv := 1 / total;
  for thread: 0..<WD_THREADS {
    for u: 0..<(nk + WD_THREADS - 1) / WD_THREADS { j := thread + WD_THREADS * u; if j < nk { s[base + j] = s[base + j] * inv; } }
  }
}
// out = s v: item i is head i / (qt 2) and the 64-query by 32-dimension tile
// i % (qt 2); the keys are the product's inner dimension.
wd_values_items :: (nq: int, heads: int) -> int { return heads * ((nq + 63) / 64) * 2; }
wd_values :: (item: int, nq: int, nk: int, d: int, heads: int, s: [] f32, v: [] f32, out: [] f32) #export_c {
  per := ((nq + 63) / 64) * 2;
  h := item / per; tile := item % per; t0 := tile / 2 * 64; c0 := tile % 2 * 32; hd := h * WD_HEAD;
  a: [2048] f32; bt: [1024] f32; acc: [2048] f32;
  for st: 0..<(nk + 31) / 32 {
    j0 := st * 32;
    for thread: 0..<WD_THREADS {
      for i: 0..<16 {
        e := thread + WD_THREADS * i; r := e / 32; c := e % 32;
        x: f32 = 0; if t0 + r < nq && j0 + c < nk { x = s[(h * nq + t0 + r) * nk + j0 + c]; }
        a[thread + WD_THREADS * i] = x;
      }
      for i: 0..<8 {
        e := thread + WD_THREADS * i; r := e / 32; c := e % 32;
        x: f32 = 0; if j0 + c < nk { x = v[(j0 + c) * d + hd + c0 + r]; }
        bt[thread + WD_THREADS * i] = x;
      }
    }
    am_sg_mma_64x32x32(acc[..], a[..], bt[..]);
  }
  am_sg_spill_64x32(acc[..], a[..]);
  for thread: 0..<WD_THREADS {
    for i: 0..<16 {
      e := thread + WD_THREADS * i; r := e / 32; c := e % 32;
      if t0 + r < nq { out[(t0 + r) * d + hd + c0 + c] = a[e]; }
    }
  }
}

#test "a tiled projection matches the plain sum, with bias and GELU" #steps 200000000 {
  rows := 70; n_in := 40; n_out := 37;
  x: [2800] f32; w: [1480] f32; b: [37] f32; y: [2590] f32;
  for i: 0..<2800 { x[i] = cast(f32) ((i * 7) % 11) * 0.1 - 0.5; }
  for i: 0..<1480 { w[i] = cast(f32) ((i * 5) % 13) * 0.05 - 0.3; }
  for i: 0..<37 { b[i] = cast(f32) i * 0.01; }
  for act: 0..<2 {
    for i: 0..<wd_linear_items(rows, n_out) { wd_linear(i, rows, n_in, n_out, act, 1, x[..], w[..], b[..], y[..]); }
    for r: 0..<rows { for o: 0..<n_out {
      s := 0.0; for i: 0..<n_in { s += cast(f64) x[r * n_in + i] * cast(f64) w[o * n_in + i]; }
      want := cast(f32) s + b[o];
      if act == 1 { want = wd_gelu(want); }
      #assert abs(cast(f64) (y[r * n_out + o] - want)) < 0.00001;
    } }
  }
}
#test "one-pass attention matches a direct softmax" {
  d := 128; heads := 2; nq := 3; nk := 9;
  q: [384] f32; k: [1152] f32; v: [1152] f32; o: [384] f32;
  for i: 0..<384 { q[i] = cast(f32) ((i * 7) % 11) * 0.1 - 0.5; }
  for i: 0..<1152 { k[i] = cast(f32) ((i * 5) % 13) * 0.1 - 0.6; v[i] = cast(f32) ((i * 3) % 7) - 3; }
  for i: 0..<heads * nq { wd_attend(i, nq, nk, d, heads, q[..], k[..], v[..], o[..]); }
  for h: 0..<heads { for t: 0..<nq {
    sc: [9] f64; best := -1.0e300;
    for j: 0..<nk { a := 0.0; for i: 0..<64 { a += cast(f64) q[t * d + h * 64 + i] * cast(f64) k[j * d + h * 64 + i]; } sc[j] = a / 8; if sc[j] > best { best = sc[j]; } }
    z := 0.0; for j: 0..<nk { sc[j] = exp(sc[j] - best); z += sc[j]; }
    for i: 0..<64 {
      r := 0.0; for j: 0..<nk { r += sc[j] / z * cast(f64) v[j * d + h * 64 + i]; }
      #assert abs(cast(f64) o[t * d + h * 64 + i] - r) < 0.00001;
    }
  } }
}
#test "attention in three launches matches the one-pass kernel" #steps 400000000 {
  d := 128; heads := 2; nq := 70; nk := 40;
  q: [8960] f32; k: [5120] f32; v: [5120] f32; o: [8960] f32; r: [8960] f32; sc: [5600] f32;
  for i: 0..<8960 { q[i] = cast(f32) ((i * 7) % 11) * 0.1 - 0.5; }
  for i: 0..<5120 { k[i] = cast(f32) ((i * 5) % 13) * 0.1 - 0.6; v[i] = cast(f32) ((i * 3) % 7) - 3; }
  for i: 0..<wd_scores_items(nq, nk, heads) { wd_scores(i, nq, nk, d, heads, q[..], k[..], sc[..]); }
  for i: 0..<heads * nq { wd_softmax(i, nk, sc[..]); }
  for i: 0..<wd_values_items(nq, heads) { wd_values(i, nq, nk, d, heads, sc[..], v[..], o[..]); }
  for i: 0..<heads * nq { wd_attend(i, nq, nk, d, heads, q[..], k[..], v[..], r[..]); }
  for i: 0..<8960 { #assert abs(cast(f64) (o[i] - r[i])) < 0.0001; }
}
#test "the beam product matches the plain sum" {
  rows := 5; n_in := 70; n_out := 9;
  x: [350] f32; w: [630] f32; b: [9] f32; y: [45] f32;
  for i: 0..<350 { x[i] = cast(f32) ((i * 7) % 11) * 0.1 - 0.5; }
  for i: 0..<630 { w[i] = cast(f32) ((i * 5) % 13) * 0.05 - 0.3; }
  for i: 0..<9 { b[i] = cast(f32) i * 0.01; }
  for act: 0..<2 {
    for o: 0..<wd_rows_items(n_out) { wd_rows(o, rows, n_in, n_out, act, 1, x[..], w[..], b[..], y[..]); }
    for r: 0..<rows { for o: 0..<n_out {
      s := 0.0; for i: 0..<n_in { s += cast(f64) x[r * n_in + i] * cast(f64) w[o * n_in + i]; }
      want := cast(f32) s + b[o];
      if act == 1 { want = wd_gelu(want); }
      #assert abs(cast(f64) (y[r * n_out + o] - want)) < 0.00001;
    } }
  }
}
#test "halves decode exactly, and the half product matches the f32 one" {
  #assert wd_half(0x3c00, false) == 1 && wd_half(0xc0000000, true) == -2 && wd_half(0x0001, false) == f32_from_bits(0x33800000);
  #assert wd_half(0x7bff, false) == 65504 && wd_half(0x3555, false) == f32_from_bits(0x3eaaa000);
  rows := 5; n_in := 70; n_out := 9;
  x: [350] f32; w: [630] f32; wh: [315] u32; b: [9] f32; y: [45] f32; z: [45] f32;
  for i: 0..<350 { x[i] = cast(f32) ((i * 7) % 11) * 0.125 - 0.5; }
  for i: 0..<315 { wh[i] = cast(u32) (0x3000 + (i * 37) % 2048) | (cast(u32) (0xb000 + (i * 53) % 2048) << 16); }
  for i: 0..<630 { w[i] = wd_half(wh[i / 2], i % 2 == 1); }
  for i: 0..<9 { b[i] = cast(f32) i * 0.01; }
  for o: 0..<wd_rows_items(n_out) { wd_rows(o, rows, n_in, n_out, 1, 1, x[..], w[..], b[..], y[..]); wd_rowsh(o, rows, n_in, n_out, 1, 1, x[..], wh[..], b[..], z[..], 0, 0, 0, z[..]); }
  for i: 0..<45 { #assert abs(cast(f64) (y[i] - z[i])) < 0.00001; }
  // act 2 adds the product to y: z (the GELU products) plus the plain ones
  g: [45] f32; for i: 0..<45 { g[i] = z[i]; }
  for o: 0..<wd_rows_items(n_out) { wd_rows(o, rows, n_in, n_out, 0, 1, x[..], w[..], b[..], y[..]); wd_rowsh(o, rows, n_in, n_out, 2, 1, x[..], wh[..], b[..], z[..], 0, 0, 0, z[..]); }
  for i: 0..<45 { #assert abs(cast(f64) (z[i] - (g[i] + y[i]))) < 0.00001; }
  // act 3: n_out 9 is a query, key and value of width 3; row r goes to slot
  // 4 - r at position r + 1 of slots of ctx 3 rows, values 40 later
  q: [15] f32; kv: [100] f32; sp := 0;
  for r: 0..<rows { sp = sp | (((4 - r) * 512 + r + 1) << (12 * r)); }
  for o: 0..<wd_rows_items(n_out) { wd_rowsh(o, rows, n_in, n_out, 3, 1, x[..], wh[..], b[..], q[..], sp, 3, 40, kv[..]); }
  for r: 0..<rows {
    place := ((4 - r) * 3 + r + 1) * 3;
    for c: 0..<3 {
      #assert q[r * 3 + c] == y[r * n_out + c];
      #assert kv[place + c] == y[r * n_out + 3 + c] && kv[40 + place + c] == y[r * n_out + 6 + c];
    }
  }
}
#test "the rules kernel picks what the search's rules and top k pick" #steps 400000000 {
  // three chunks a row; the best tokens in different chunks
  V := 5000; beg := 4500; k := 5;
  logits: [10000] f32; prm: [128] f32; top: [32] f32;
  for i: 0..<10000 { logits[i] = cast(f32) ((i * 37) % 101) * 0.05 - 2; }
  for i: beg..<V { logits[i] = -6; }
  logits[2100] = 4; logits[4200] = 4; logits[V + 4300] = 3.5;
  // row 1's timestamps are likelier than its text: only timestamps follow
  for i: V + beg..<2 * V { logits[i] = cast(f32) ((i * 13) % 17) * 0.1 + 3; }
  for r: 0..<2 {
    P := r * WD_PRM;
    prm[P] = 0.5;
    prm[P + 1] = 2; prm[P + 2] = 0; prm[P + 3] = 3; prm[P + 4] = 4950; prm[P + 5] = 5000;
    S := P + 2 + 2 * WD_RANGES; prm[S] = 2; prm[S + 1] = 10; prm[S + 2] = 20;
    A := S + 1 + WD_SINGLES; prm[A] = 3;
    prm[A + 1] = 30; prm[A + 2] = 2.5; prm[A + 3] = 1; prm[A + 4] = 1; prm[A + 5] = 30; prm[A + 6] = 0.5;
  }
  rec: [8 * WD_REC] f64;
  #assert wd_rule_chunks(V, beg) == 4;
  for item: 0..<8 { wd_rules_part(item, V, beg, prm[..], logits[..], rec[..]); }
  for r: 0..<2 { wd_rules_join(r, V, beg, k, rec[..], top[..]); }
  for r: 0..<2 {
    // the reference: scale, ranges, adds unless masked, tokens, then
    // log-softmax with f64 sums, as we_rules
    want: [5000] f32;
    for i: 0..<V {
      v := logits[r * V + i] * 0.5;
      if i < 3 || i >= 4950 { v = WD_NEG; }
      want[i] = v;
    }
    want[30] += 2.5; want[30] += 0.5; want[10] = WD_NEG; want[20] = WD_NEG;
    m1: f32 = -3.0e38; m2: f32 = -3.0e38;
    for i: 0..<V { if i < beg { if want[i] > m1 { m1 = want[i]; } } else { if want[i] > m2 { m2 = want[i]; } } }
    text := cast(f64) m1; tmax := cast(f64) m2; best := ifx text > tmax then text else tmax; bf := cast(f32) best;
    zx := 0.0; zt := 0.0;
    for i: 0..<V { e := cast(f64) wd_expv(want[i] - bf); if i < beg { zx += e; } else { zt += e; } }
    lz := best + log(zx + zt); only := best + log(zt) > text;
    #assert only == (r == 1);
    // brute force: the best k live tokens, ties to the lower token
    taken: [5000] bool;
    #assert cast(int) top[r * WD_TOP] == k;
    for c: 0..<k {
      bi := -1; bv: f32 = 0;
      for i: 0..<V {
        if taken[i] || wd_dead(want[i]) || (only && i < beg) { continue; }
        v := cast(f32) (cast(f64) want[i] - lz);
        if bi < 0 || v > bv { bi = i; bv = v; }
      }
      taken[bi] = true;
      #assert cast(int) top[r * WD_TOP + 1 + 2 * c] == bi;
      #assert abs(cast(f64) (top[r * WD_TOP + 2 + 2 * c] - bv)) < 0.000001;
    }
  }
}
#test "the row norm matches LayerNorm in f64" {
  d := 300; x: [600] f32; g: [300] f32; b: [300] f32; y: [600] f32;
  for i: 0..<600 { x[i] = cast(f32) ((i * 7) % 23) * 0.13 - 1.1; }
  for i: 0..<300 { g[i] = cast(f32) (i % 5) * 0.2 + 0.5; b[i] = cast(f32) (i % 3) * 0.1 - 0.1; }
  for r: 0..<2 { wd_norm(r, d, x[..], g[..], b[..], y[..]); }
  for r: 0..<2 {
    m := 0.0; for i: 0..<d { m += cast(f64) x[r * d + i]; } m = m / cast(f64) d;
    q := 0.0; for i: 0..<d { e := cast(f64) x[r * d + i] - m; q += e * e; }
    inv := 1 / sqrt(q / cast(f64) d + 0.00001);
    for i: 0..<d { #assert abs(cast(f64) y[r * d + i] - ((cast(f64) x[r * d + i] - m) * inv * cast(f64) g[i] + cast(f64) b[i])) < 0.00001; }
  }
  kb: [600] f32; vb: [600] f32;
  for i: 0..<600 { wd_store(i, x[..], y[..], kb[..], vb[..]); }
  for i: 0..<600 { #assert kb[i] == x[i] && vb[i] == y[i]; }
}
#test "split-key attention matches the one-pass kernel, and masks causally" #steps 400000000 {
  d := 128; heads := 2; nq := 3; nk := 300;
  q: [384] f32; k: [38400] f32; v: [38400] f32; o: [384] f32; r: [384] f32; part: [1188] f32;
  for i: 0..<384 { q[i] = cast(f32) ((i * 7) % 11) * 0.1 - 0.5; }
  for i: 0..<38400 { k[i] = cast(f32) ((i * 5) % 13) * 0.1 - 0.6; v[i] = cast(f32) ((i * 3) % 7) - 3; }
  C := wd_chunks(nk);
  #assert C == 3;
  for i: 0..<heads * nq * C { wd_part(i, nq, nk, d, heads, 0, 0, 0, q[..], k[..], v[..], part[..], o[..]); }
  for i: 0..<heads * nq { wd_join(i, nq, nk, d, part[..], o[..]); wd_attend(i, nq, nk, d, heads, q[..], k[..], v[..], r[..]); }
  for i: 0..<384 { #assert abs(cast(f64) (o[i] - r[i])) < 0.0001; }
  for i: 0..<heads * C { wd_cross(i, nq, nk, d, heads, q[..], k[..], v[..], part[..]); }
  for i: 0..<heads * nq { wd_join(i, nq, nk, d, part[..], o[..]); }
  for i: 0..<384 { #assert abs(cast(f64) (o[i] - r[i])) < 0.0001; }
  // causal: query t in slot 2 - t (slots of 100 rows) at position 40 + t sees
  // that slot's first 41 + t rows, as the one-pass kernel over them
  sp := 0;
  for t: 0..<nq { sp = sp | (((2 - t) * 512 + 40 + t) << (12 * t)); }
  #assert wd_slot_pos(sp, 1) == 512 + 41;
  // one chunk (44 keys): wd_part writes the output itself, as wd_join would
  #assert wd_chunks(44) == 1;
  for i: 0..<heads * nq { wd_part(i, nq, 44, d, heads, 100, sp, 1, q[..], k[..], v[..], part[..], o[..]); }
  for t: 0..<nq {
    at := (2 - t) * 100 * d;
    for h: 0..<heads { wd_attend(h * nq + t, nq, 41 + t, d, heads, q[..], k[at..<at + 100 * d], v[at..<at + 100 * d], r[..]); }
    for i: 0..<d { #assert abs(cast(f64) (o[t * d + i] - r[t * d + i])) < 0.0001; }
  }
}
