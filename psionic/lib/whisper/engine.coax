// Whisper end to end on the CPU: the weights decoded from the mapped ggml
// file, the encoder, the decoder with its key and value caches, greedy
// search with whisper.cpp's logit rules, and segments. The host
// (psionic/platform/whisper-face.c) maps the files and allocates the two
// arenas this file lays out: W, every weight as f32, and work, every
// activation. Nothing here allocates or does I/O.
// Profile psionic-whisper-cpu-v1: f32 storage; dot products in f32 with four
// partial sums; LayerNorm statistics, softmax sums and GELU in binary64;
// GELU in ggml's tanh form (whisper.cpp's, not PyTorch's erf form).
// Design: psionic/docs/transcribe.md.
#load "ggml.coax";
#load "tokens.coax";
#load "front.coax";
#load "segments.coax";
#load "wav.coax";
#load "../counter-rng.coax";

WE_LAYERS_MAX :: 32;
WE_EPS :: 0.00001;
WeStatus :: enum u8 {ok;model;missing;shape;kind;number;capacity;audio;}

// A block's tensors as offsets into W (-1: none). Encoder blocks leave the
// cross-attention fields at -1.
WeBlock :: struct {
  ln1_w: int; ln1_b: int; q_w: int; q_b: int; k_w: int; v_w: int; v_b: int; o_w: int; o_b: int;
  lnx_w: int; lnx_b: int; xq_w: int; xq_b: int; xk_w: int; xv_w: int; xv_b: int; xo_w: int; xo_b: int;
  ln2_w: int; ln2_b: int; fc1_w: int; fc1_b: int; fc2_w: int; fc2_b: int;
}
// Offsets into work for one run.
WeWork :: struct {
  mel: int; c1: int; x: int; h: int; q: int; k: int; v: int; a: int; m: int; s: int;
  ck: int; cv: int; sk: int; sv: int; dx: int; dh: int; dq: int; da: int; dk: int; dv: int; dm: int; logits: int; lp: int;
  rp: int; rt: int; rl: int; total: int;
}
WeNet :: struct {
  status: WeStatus; params: WgParams; sp: WtSpecials; space: int; ctx: int;
  e_pos: int; c1_w: int; c1_b: int; c2_w: int; c2_b: int; e_ln_w: int; e_ln_b: int;
  d_pos: int; d_emb: int; d_ln_w: int; d_ln_b: int;
  enc: [WE_LAYERS_MAX] WeBlock; dec: [WE_LAYERS_MAX] WeBlock;
  weights: int; work: WeWork;
}

// ---- weights ----------------------------------------------------------------

// An IEEE half as f32, exactly; ok false for infinities and NaN.
WeHalf :: struct { ok: bool; value: f32; }
we_half :: (h: int) -> WeHalf {
  sign := (h >> 15) & 1; e := (h >> 10) & 31; mant := h & 1023;
  if e == 31 { return WeHalf.{ok = false}; }
  v: f32 = 0;
  if e == 0 { v = cast(f32) mant * f32_from_bits(0x33800000); }   // mant * 2^-24
  else { v = f32_from_bits(cast(u32) (((e - 15 + 127) << 23) | (mant << 13))); }
  if sign == 1 { v = -v; }
  return WeHalf.{ok = true, value = v};
}
// Each tensor's offset in W, in file order, except that a block's
// attention weights sit together so the GPU makes the query, key and value
// of a row in one product: PREFIX.attn.query.weight, then the key and value
// weights, then the query bias, the key's zero bias (a gap of the query
// bias's size, left 0) and the value bias. The total element count.
we_layout :: (tensors: [] WgTensor, count: int, offsets: [] int) -> int {
  at := 0;
  for i: 0..<count { offsets[i] = -1; }
  for i: 0..<count {
    if offsets[i] >= 0 { continue; }
    g: [5] int; n := we_group(tensors, count, i, g[..]);
    if n == 5 && tensors[g[1]].elements == tensors[g[0]].elements && tensors[g[2]].elements == tensors[g[0]].elements && tensors[g[4]].elements == tensors[g[3]].elements {
      for j: 0..<3 { offsets[g[j]] = at; at += tensors[g[j]].elements; }
      offsets[g[3]] = at; at += 2 * tensors[g[3]].elements;
      offsets[g[4]] = at; at += tensors[g[4]].elements;
      continue;
    }
    offsets[i] = at; at += tensors[i].elements;
  }
  return at;
}
// When tensor i is PREFIX.attn.query.weight: g = its key weight, value
// weight, query bias and value bias after it, and 5; otherwise 0.
we_group :: (tensors: [] WgTensor, count: int, i: int, g: [] int) -> int {
  q := ".attn.query.weight"; name := tensors[i].name;
  if name.count <= q.count || cast(string) name[name.count - q.count..<name.count] != q { return 0; }
  prefix := cast(string) name[0..<name.count - q.count];
  g[0] = i;
  g[1] = we_suffixed(tensors, count, prefix, ".attn.key.weight"); g[2] = we_suffixed(tensors, count, prefix, ".attn.value.weight");
  g[3] = we_suffixed(tensors, count, prefix, ".attn.query.bias"); g[4] = we_suffixed(tensors, count, prefix, ".attn.value.bias");
  for j: 1..<5 { if g[j] < 0 { return 0; } }
  return 5;
}
we_suffixed :: (tensors: [] WgTensor, count: int, prefix: string, suffix: string) -> int {
  buf: [160] u8; w: [1] WsOut; w[0].buf = buf[..];
  wsg_put(w[..], prefix); wsg_put(w[..], suffix);
  if w[0].full { return -1; }
  return wg_find(tensors, count, cast(string) buf[0..<w[0].n]);
}
// The half at byte p.
we_half_at :: (b: [] u8, p: int) -> WeHalf { return we_half(cast(int) b[p] | (cast(int) b[p + 1] << 8)); }
// One block of 32 quantized values at byte p into out, as ggml's
// dequantize_row_* does: q8_0 d*q; q4_0 d*(q-8); q4_1 d*q+m; q5_0
// d*(q-16) and q5_1 d*q+m, with the fifth bits in a 32-bit word. False for
// a scale that is infinite or NaN.
we_dequant :: (b: [] u8, kind: int, p: int, out: [] f32) -> bool {
  hd := we_half_at(b, p); if !hd.ok { return false; }
  d := hd.value;
  if kind == WG_Q8_0 {
    for j: 0..<32 { q := cast(int) b[p + 2 + j]; if q >= 128 { q -= 256; } out[j] = d * cast(f32) q; }
    return true;
  }
  m: f32 = 0; at := p + 2;
  if kind == WG_Q4_1 || kind == WG_Q5_1 { hm := we_half_at(b, p + 2); if !hm.ok { return false; } m = hm.value; at = p + 4; }
  if kind == WG_Q4_0 || kind == WG_Q4_1 {
    off := ifx kind == WG_Q4_0 then 8 else 0;
    for j: 0..<16 {
      q := cast(int) b[at + j];
      out[j] = d * cast(f32) ((q & 15) - off) + m; out[j + 16] = d * cast(f32) ((q >> 4) - off) + m;
    }
    return true;
  }
  qh := wg_u32(b, at); qs := at + 4;
  off := ifx kind == WG_Q5_0 then 16 else 0;
  for j: 0..<16 {
    q := cast(int) b[qs + j];
    h0 := ((qh >> j) << 4) & 16; h1 := (qh >> (j + 12)) & 16;
    out[j] = d * cast(f32) (((q & 15) | h0) - off) + m; out[j + 16] = d * cast(f32) (((q >> 4) | h1) - off) + m;
  }
  return true;
}
// Every tensor decoded into W: f32 copied, f16 decoded, q8_0, q5_0, q5_1,
// q4_0 and q4_1 dequantized. An infinite or NaN weight or scale is refused
// (number).
we_load :: (b: [] u8, tensors: [] WgTensor, count: int, offsets: [] int, w: [] f32) -> WeStatus {
  for i: 0..<count {
    st := we_load_slice(b, tensors[i], offsets[i], 0, tensors[i].elements, w);
    if st != WeStatus.ok { return st; }
  }
  return WeStatus.ok;
}
// Elements j0..<j1 of tensor t into w at offset at (a quantized tensor's
// j0 and j1 are multiples of its 32-value blocks); the host loads a large
// tensor as slices on several threads, each element written by one slice.
we_load_slice :: (b: [] u8, t: WgTensor, at: int, j0: int, j1: int, w: [] f32) -> WeStatus {
  if at < 0 || at + t.elements > w.count || j0 < 0 || j1 > t.elements || j0 > j1 { return WeStatus.capacity; }
  if t.kind == WG_F32 {
    for j: j0..<j1 { v := wg_f32_at(b, t.begin + 4 * j); if !(v >= -3.0e38 && v <= 3.0e38) { return WeStatus.number; } w[at + j] = v; }
  } else if t.kind == WG_F16 {
    for j: j0..<j1 {
      h := we_half_at(b, t.begin + 2 * j);
      if !h.ok { return WeStatus.number; }
      w[at + j] = h.value;
    }
  } else if t.kind == WG_Q8_0 || t.kind == WG_Q4_0 || t.kind == WG_Q4_1 || t.kind == WG_Q5_0 || t.kind == WG_Q5_1 {
    if j0 % 32 != 0 || (j1 % 32 != 0 && j1 != t.elements) { return WeStatus.capacity; }
    bytes := wg_block_bytes(t.kind);
    for k: j0 / 32..<j1 / 32 {
      if !we_dequant(b, t.kind, t.begin + k * bytes, w[at + 32 * k..<at + 32 * k + 32]) { return WeStatus.number; }
    }
  } else { return WeStatus.kind; }
  return WeStatus.ok;
}

// The offset of the tensor called PREFIX.N.SUFFIX (N < 0: PREFIX.SUFFIX)
// with the given element count; -1 when missing, -2 when its size differs.
we_named :: (tensors: [] WgTensor, count: int, offsets: [] int, prefix: string, n: int, suffix: string, elements: int) -> int {
  buf: [160] u8; w: [1] WsOut; w[0].buf = buf[..];
  wsg_put(w[..], prefix); wsg_byte(w[..], '.');
  if n >= 0 { wsg_digits(w[..], n, 1); wsg_byte(w[..], '.'); }
  wsg_put(w[..], suffix);
  k := wg_find(tensors, count, cast(string) buf[0..<w[0].n]);
  if k < 0 { return -1; }
  if tensors[k].elements != elements { return -2; }
  return offsets[k];
}
WeFind :: struct { tensors: [] WgTensor; count: int; offsets: [] int; bad: bool; }
we_get :: (f: [] WeFind, prefix: string, n: int, suffix: string, elements: int) -> int {
  at := we_named(f[0].tensors, f[0].count, f[0].offsets, prefix, n, suffix, elements);
  if at < 0 { f[0].bad = true; }
  return at;
}
we_block :: (f: [] WeFind, prefix: string, i: int, d: int, cross: bool) -> WeBlock {
  b: WeBlock;
  b.ln1_w = we_get(f, prefix, i, "attn_ln.weight", d); b.ln1_b = we_get(f, prefix, i, "attn_ln.bias", d);
  b.q_w = we_get(f, prefix, i, "attn.query.weight", d * d); b.q_b = we_get(f, prefix, i, "attn.query.bias", d);
  b.k_w = we_get(f, prefix, i, "attn.key.weight", d * d);
  b.v_w = we_get(f, prefix, i, "attn.value.weight", d * d); b.v_b = we_get(f, prefix, i, "attn.value.bias", d);
  b.o_w = we_get(f, prefix, i, "attn.out.weight", d * d); b.o_b = we_get(f, prefix, i, "attn.out.bias", d);
  b.lnx_w = -1; b.lnx_b = -1; b.xq_w = -1; b.xq_b = -1; b.xk_w = -1; b.xv_w = -1; b.xv_b = -1; b.xo_w = -1; b.xo_b = -1;
  if cross {
    b.lnx_w = we_get(f, prefix, i, "cross_attn_ln.weight", d); b.lnx_b = we_get(f, prefix, i, "cross_attn_ln.bias", d);
    b.xq_w = we_get(f, prefix, i, "cross_attn.query.weight", d * d); b.xq_b = we_get(f, prefix, i, "cross_attn.query.bias", d);
    b.xk_w = we_get(f, prefix, i, "cross_attn.key.weight", d * d);
    b.xv_w = we_get(f, prefix, i, "cross_attn.value.weight", d * d); b.xv_b = we_get(f, prefix, i, "cross_attn.value.bias", d);
    b.xo_w = we_get(f, prefix, i, "cross_attn.out.weight", d * d); b.xo_b = we_get(f, prefix, i, "cross_attn.out.bias", d);
  }
  b.ln2_w = we_get(f, prefix, i, "mlp_ln.weight", d); b.ln2_b = we_get(f, prefix, i, "mlp_ln.bias", d);
  b.fc1_w = we_get(f, prefix, i, "mlp.0.weight", 4 * d * d); b.fc1_b = we_get(f, prefix, i, "mlp.0.bias", 4 * d);
  b.fc2_w = we_get(f, prefix, i, "mlp.2.weight", 4 * d * d); b.fc2_b = we_get(f, prefix, i, "mlp.2.bias", d);
  return b;
}
// Resolves every tensor and lays out work for an audio context of ctx
// positions (1 to n_audio_ctx; 1,500 is a full 30 s window).
we_net :: (b: [] u8, m: WgModel, tensors: [] WgTensor, offsets: [] int, ctx: int) -> WeNet {
  net: WeNet; net.status = WeStatus.model;
  if m.status != WgStatus.ok { return net; }
  p := m.params; net.params = p; net.sp = wt_specials(p.n_vocab);
  if p.n_audio_layer > WE_LAYERS_MAX || p.n_text_layer > WE_LAYERS_MAX || p.n_audio_state != p.n_text_state { net.status = WeStatus.shape; return net; }
  if ctx < 1 || ctx > p.n_audio_ctx { net.status = WeStatus.shape; return net; }
  net.ctx = ctx;
  net.weights = we_layout(tensors, m.tensor_count, offsets);
  d := p.n_audio_state;
  f: [1] WeFind; f[0].tensors = tensors; f[0].count = m.tensor_count; f[0].offsets = offsets;
  net.e_pos = we_whole(f[..], "encoder.positional_embedding", p.n_audio_ctx * d);
  net.c1_w = we_whole(f[..], "encoder.conv1.weight", 3 * p.n_mels * d); net.c1_b = we_whole(f[..], "encoder.conv1.bias", d);
  net.c2_w = we_whole(f[..], "encoder.conv2.weight", 3 * d * d); net.c2_b = we_whole(f[..], "encoder.conv2.bias", d);
  net.e_ln_w = we_whole(f[..], "encoder.ln_post.weight", d); net.e_ln_b = we_whole(f[..], "encoder.ln_post.bias", d);
  net.d_pos = we_whole(f[..], "decoder.positional_embedding", p.n_text_ctx * d);
  net.d_emb = we_whole(f[..], "decoder.token_embedding.weight", p.n_vocab * d);
  net.d_ln_w = we_whole(f[..], "decoder.ln.weight", d); net.d_ln_b = we_whole(f[..], "decoder.ln.bias", d);
  for i: 0..<p.n_audio_layer { net.enc[i] = we_block(f[..], "encoder.blocks", i, d, false); }
  for i: 0..<p.n_text_layer { net.dec[i] = we_block(f[..], "decoder.blocks", i, d, true); }
  if f[0].bad { net.status = WeStatus.missing; return net; }
  // " " is the blank token suppressed at a window's start.
  net.space = -1;
  for i: 0..<m.tokens { if wg_token(b, m, i) == " " { net.space = i; break; } }
  // work
  k: WeWork; at := 0; L := p.n_text_layer; T := ctx;
  k.mel = at; at += p.n_mels * WF_WINDOW_FRAMES;
  k.c1 = at; at += d * 2 * T;
  k.x = at; at += T * d; k.h = at; at += T * d; k.q = at; at += T * d; k.k = at; at += T * d; k.v = at; at += T * d; k.a = at; at += T * d;
  k.m = at; at += T * 4 * d;
  k.s = at; at += ifx T > p.n_text_ctx then T else p.n_text_ctx;
  k.ck = at; at += L * T * d; k.cv = at; at += L * T * d;
  k.sk = at; at += L * WE_SLOTS * p.n_text_ctx * d; k.sv = at; at += L * WE_SLOTS * p.n_text_ctx * d;
  R := WE_ROWS_MAX;
  k.dx = at; at += R * d; k.dh = at; at += R * d; k.dq = at; at += R * d; k.da = at; at += R * d;
  k.dk = at; at += R * d; k.dv = at; at += R * d; k.dm = at; at += R * 4 * d;
  k.logits = at; at += WE_SLOTS * p.n_vocab; k.lp = at; at += p.n_vocab;
  // a step's token rules on the GPU (cxwh_rules): parameters, results, scratch
  k.rp = at; at += WE_SLOTS * WE_PRM; k.rt = at; at += WE_SLOTS * WE_TOP; k.rl = at; at += WE_SLOTS * p.n_vocab;
  k.total = at;
  net.work = k;
  net.status = WeStatus.ok;
  return net;
}
we_whole :: (f: [] WeFind, name: string, elements: int) -> int {
  k := wg_find(f[0].tensors, f[0].count, name);
  if k < 0 || f[0].tensors[k].elements != elements { f[0].bad = true; return -1; }
  return f[0].offsets[k];
}

// ---- kernels ------------------------------------------------------------------

// Coax has no threads yet (Coax chapter 14). As in chapter 35, the host owns
// them: each heavy kernel below is a foreign call (cxwh_*) that the host
// splits into fixed ranges, calling the matching *_part export once per
// range. Every output element is computed by exactly one part, in the same
// order whatever the split, so the result does not depend on the thread
// count. A host without threads calls the part once over the whole range.
cxwh_linear :: (x: [] f32, rows: int, n_in: int, w: [] f32, b: [] f32, n_out: int, y: [] f32, act: int) -> int #foreign;
cxwh_attend :: (q: [] f32, nq: int, k: [] f32, v: [] f32, nk: int, d: int, heads: int, first: int, causal: bool, out: [] f32) -> int #foreign;
cxwh_mel :: (x: [] f32, window: [] f64, bank: [] f64, mels: int, cache: [] f32, frames: int) -> int #foreign;
// A decoder step's batch on a GPU host: cxwh_step(1) opens it (1 when the
// host has one), cxwh_step(0) runs it; cxwh_step(2) opens one for the
// encoder's layers. While it is open the host takes the calls into it, and
// these return 1 when it took the call; 0 means the engine does it here.
cxwh_step :: (begin: int) -> int #foreign;
cxwh_norm :: (x: [] f32, rows: int, d: int, g: [] f32, b: [] f32, y: [] f32) -> int #foreign;
cxwh_store :: (ka: [] f32, va: [] f32, kb: [] f32, vb: [] f32) -> int #foreign;
// Self-attention of rows decoders at once: row r is query q[r] in cache
// slot s at position p, sp holding 512 s + p in its bits 12 r..12 r + 11;
// ks and vs are a layer's slots of ctx rows each, nk is above every p.
cxwh_slots :: (q: [] f32, rows: int, ks: [] f32, vs: [] f32, ctx: int, d: int, heads: int, sp: int, nk: int, out: [] f32) -> int #foreign;
// A block's query, key and value of rows decoders in one product: w and b
// are the three weights and biases together (we_layout), the queries go to
// q and row r's key and value into the layer's cache kv (its key slots,
// then its value slots vstride later) at slot and position sp as above.
cxwh_qkv :: (x: [] f32, rows: int, d: int, w: [] f32, b: [] f32, q: [] f32, kv: [] f32, vstride: int, ctx: int, sp: int) -> int #foreign;
// The token rules, log-softmax and top k of each row's logits
// (device.coax's wd_rules): rules prm (WE_PRM a row), scratch lp, results
// top (WE_TOP a row: the count, then token and log-probability pairs).
cxwh_rules :: (logits: [] f32, rows: int, V: int, beg: int, k: int, prm: [] f32, lp: [] f32, top: [] f32) -> int #foreign;
WE_PRM :: 64;
WE_TOP :: 16;

WE_KEYS_MAX :: 1500;

// y = x w^T + b for outputs o0..o1, then GELU when act is 1; w is
// [n_out][n_in] as ggml stores it. As ggml_vec_dot_f32 does on NEON, each
// output keeps four lanes: lane l sums the terms k = 4i + l in order with
// fma, the lanes combine as (l0 + l1) + (l2 + l3), and the n_in % 4 tail is
// added in order. Tiles of 4 rows by 4 outputs share each load; every output
// is the same sum whichever tile computes it, so the result does not depend
// on the thread count or the row count. The loops index the views with
// affine expressions only, so the optimized C checks each range once and
// the lane loops become NEON fused multiply-adds.
we_linear_part :: (x: [] f32, rows: int, n_in: int, w: [] f32, b: [] f32, n_out: int, y: [] f32, o0: int, o1: int, act: int) {
  k4 := n_in / 4; rt := rows / 4; ot := (o1 - o0) / 4;
  for to: 0..<ot {
    for tr: 0..<rt {
      a: [64] f32;
      for k: 0..<k4 {
        for ro: 0..<4 { for oo: 0..<4 { for l: 0..<4 {
          a[(ro * 4 + oo) * 4 + l] = fma(x[(tr * 4 + ro) * n_in + k * 4 + l], w[(o0 + to * 4 + oo) * n_in + k * 4 + l], a[(ro * 4 + oo) * 4 + l]);
        } } }
      }
      for fr: 0..<4 { for fo: 0..<4 {
        f := (fr * 4 + fo) * 4;
        we_out(x, w, b, y, tr * 4 + fr, o0 + to * 4 + fo, n_in, n_out, act, (a[f] + a[f + 1]) + (a[f + 2] + a[f + 3]));
      } }
    }
    for r: rt * 4..<rows {
      a: [16] f32;
      for k: 0..<k4 { for oo: 0..<4 { for l: 0..<4 {
        a[oo * 4 + l] = fma(x[r * n_in + k * 4 + l], w[(o0 + to * 4 + oo) * n_in + k * 4 + l], a[oo * 4 + l]);
      } } }
      for fo: 0..<4 { f := fo * 4; we_out(x, w, b, y, r, o0 + to * 4 + fo, n_in, n_out, act, (a[f] + a[f + 1]) + (a[f + 2] + a[f + 3])); }
    }
  }
  for o: o0 + ot * 4..<o1 {
    for r: 0..<rows {
      a: [4] f32;
      for k: 0..<k4 { for l: 0..<4 { a[l] = fma(x[r * n_in + k * 4 + l], w[o * n_in + k * 4 + l], a[l]); } }
      we_out(x, w, b, y, r, o, n_in, n_out, act, (a[0] + a[1]) + (a[2] + a[3]));
    }
  }
}
// One output of we_linear_part from its combined lanes: the n_in % 4 tail
// in order, the bias, then GELU (act 1); act 2 adds it to y (a residual).
we_out :: (x: [] f32, w: [] f32, b: [] f32, y: [] f32, r: int, o: int, n_in: int, n_out: int, act: int, lanes: f32) {
  v := lanes;
  for k: (n_in / 4) * 4..<n_in { v = fma(x[r * n_in + k], w[o * n_in + k], v); }
  if b.count > 0 { v += b[o]; }
  if act == 1 { v = we_gelu(v); }
  if act == 2 { y[r * n_out + o] += v; } else { y[r * n_out + o] = v; }
}
we_linear :: (x: [] f32, rows: int, n_in: int, w: [] f32, b: [] f32, n_out: int, y: [] f32) { we_linear_part(x, rows, n_in, w, b, n_out, y, 0, n_out, 0); }
we_mm :: (x: [] f32, rows: int, n_in: int, w: [] f32, b: [] f32, n_out: int, y: [] f32) { r := cxwh_linear(x, rows, n_in, w, b, n_out, y, 0); }
we_mm_gelu :: (x: [] f32, rows: int, n_in: int, w: [] f32, b: [] f32, n_out: int, y: [] f32) { r := cxwh_linear(x, rows, n_in, w, b, n_out, y, 1); }
// y += x w^T + b: a residual.
we_mm_add :: (x: [] f32, rows: int, n_in: int, w: [] f32, b: [] f32, n_out: int, y: [] f32) { r := cxwh_linear(x, rows, n_in, w, b, n_out, y, 2); }
// LayerNorm of each row: (x - mean) / sqrt(var + 1e-5) * g + b, population variance.
we_norm :: (x: [] f32, rows: int, d: int, g: [] f32, b: [] f32, y: [] f32) {
  for r: 0..<rows {
    xr := x[r * d..<(r + 1) * d];
    s := 0.0; for v: xr { s += cast(f64) v; }
    mean := s / cast(f64) d;
    q := 0.0; for v: xr { e := cast(f64) v - mean; q += e * e; }
    inv := 1 / sqrt(q / cast(f64) d + WE_EPS);
    for i: 0..<d { y[r * d + i] = cast(f32) ((cast(f64) xr[i] - mean) * inv) * g[i] + b[i]; }
  }
}
// we_norm, x += h and the cache store, through the host when it takes them.
we_ln :: (x: [] f32, rows: int, d: int, g: [] f32, b: [] f32, y: [] f32) { if cxwh_norm(x, rows, d, g, b, y) == 0 { we_norm(x, rows, d, g, b, y); } }
we_store :: (ka: [] f32, va: [] f32, kb: [] f32, vb: [] f32) { if cxwh_store(ka, va, kb, vb) == 0 { for i: 0..<ka.count { kb[i] = ka[i]; vb[i] = va[i]; } } }
// e^x in f32: n = round(x log2(e)), r = x - n ln(2) in two parts (Cody and
// Waite) so |r| <= ln(2)/2 stays exact, e^r from its degree-6 Taylor
// polynomial (relative error under 2e-7) and 2^n from the exponent bits.
// Below -87 the result is 0; above 88 it is clamped to e^88.
we_expf :: (x: f32) -> f32 {
  if x < -87 { return 0; }
  y := ifx x > 88 then cast(f32) 88 else x;
  t := y * 1.442695041;
  n := cast(int) (ifx t >= 0 then t + 0.5 else t - 0.5);
  fn := cast(f32) n;
  r := (y - fn * 0.693145752) - fn * 0.00000142860677;
  p := 1 + r * (1 + r * (0.5 + r * (0.1666666667 + r * (0.04166666667 + r * (0.008333333333 + r * 0.001388888889)))));
  return p * f32_from_bits(cast(u32) (n + 127) << 23);
}
// ggml's GELU: 0.5 x (1 + tanh(sqrt(2/pi) (x + 0.044715 x^3))), tanh u as
// 1 - 2 / (e^(2u) + 1).
we_gelu :: (x: f32) -> f32 {
  u := 0.7978845608 * (x + 0.044715 * x * x * x);
  if u > 10 { return x; }
  if u < -10 { return 0; }
  t := 1 - 2 / (we_expf(2 * u) + 1);
  return 0.5 * x * (1 + t);
}
// Attention for jobs j0..j1 of heads * ceil(nq / 4); job j is head
// j / ceil(nq / 4) and the block of up to four queries starting at
// 4 (j % ceil(nq / 4)): out[t] = softmax(q[t] k^T / sqrt(dh)) v over nk keys
// (at most 1,500). Causal: query t sees keys 0..first+t. A score is four
// lanes over the head's dimensions with fma, combined (l0 + l1) + (l2 + l3);
// the weighted sum of values adds the keys in order with fma. A full block
// of four queries shares each key's loads; a score and an output are the
// same whatever block computes them.
WE_HEAD_MAX :: 128;
we_attend_blocks :: (nq: int) -> int { return (nq + 3) / 4; }
// Scores of query row t (s[0..<n]) against keys 0..<n, head offset hd.
we_scores_one :: (q: [] f32, t: int, k: [] f32, n: int, d: int, hd: int, dh: int, scale: f32, s: [] f32) {
  e4 := dh / 4; kt := n / 4;
  for kb: 0..<kt {
    a: [16] f32;
    for e: 0..<e4 { for kk: 0..<4 { for l: 0..<4 {
      a[kk * 4 + l] = fma(q[t * d + hd + e * 4 + l], k[(kb * 4 + kk) * d + hd + e * 4 + l], a[kk * 4 + l]);
    } } }
    for fk: 0..<4 { f := fk * 4; s[kb * 4 + fk] = ((a[f] + a[f + 1]) + (a[f + 2] + a[f + 3])) * scale; }
  }
  for j: kt * 4..<n {
    a: [4] f32;
    for e: 0..<e4 { for l: 0..<4 { a[l] = fma(q[t * d + hd + e * 4 + l], k[j * d + hd + e * 4 + l], a[l]); } }
    s[j] = ((a[0] + a[1]) + (a[2] + a[3])) * scale;
  }
}
// Scores of query rows t0..t0+3 (s[r * WE_KEYS_MAX + j]) against keys 0..<n.
we_scores_four :: (q: [] f32, t0: int, k: [] f32, n: int, d: int, hd: int, dh: int, scale: f32, s: [] f32) {
  e4 := dh / 4; kt := n / 4;
  for kb: 0..<kt {
    a: [64] f32;
    for e: 0..<e4 { for tq: 0..<4 { for kk: 0..<4 { for l: 0..<4 {
      a[(tq * 4 + kk) * 4 + l] = fma(q[(t0 + tq) * d + hd + e * 4 + l], k[(kb * 4 + kk) * d + hd + e * 4 + l], a[(tq * 4 + kk) * 4 + l]);
    } } } }
    for ft: 0..<4 { for fk: 0..<4 {
      f := (ft * 4 + fk) * 4;
      s[ft * WE_KEYS_MAX + kb * 4 + fk] = ((a[f] + a[f + 1]) + (a[f + 2] + a[f + 3])) * scale;
    } }
  }
  for j: kt * 4..<n {
    for tq: 0..<4 {
      a: [4] f32;
      for e: 0..<e4 { for l: 0..<4 { a[l] = fma(q[(t0 + tq) * d + hd + e * 4 + l], k[j * d + hd + e * 4 + l], a[l]); } }
      s[tq * WE_KEYS_MAX + j] = ((a[0] + a[1]) + (a[2] + a[3])) * scale;
    }
  }
}
// Softmax of s[0..<n] in place; the sum of the exponentials.
we_softmax :: (s: [] f32, n: int) -> f64 {
  best: f32 = -3.0e38;
  for kk: 0..<n { if s[kk] > best { best = s[kk]; } }
  sum := 0.0;
  for kk: 0..<n { e := we_expf(s[kk] - best); s[kk] = e; sum += cast(f64) e; }
  return sum;
}
we_attend_part :: (q: [] f32, nq: int, k: [] f32, v: [] f32, nk: int, d: int, heads: int, first: int, causal: bool, out: [] f32, j0: int, j1: int) {
  dh := d / heads; scale := cast(f32) (1 / sqrt(cast(f64) dh));
  nb := we_attend_blocks(nq);
  s: [4 * WE_KEYS_MAX] f32;
  acc: [4 * WE_HEAD_MAX] f32;
  for j: j0..<j1 {
    h := j / nb; t0 := 4 * (j % nb); hd := h * dh;
    tq := ifx nq - t0 < 4 then nq - t0 else 4;
    nmax := ifx causal then first + t0 + tq else nk;
    if tq == 4 { we_scores_four(q, t0, k, nmax, d, hd, dh, scale, s[..]); }
    else { for t: 0..<tq { we_scores_one(q, t0 + t, k, nmax, d, hd, dh, scale, s[t * WE_KEYS_MAX..<(t + 1) * WE_KEYS_MAX]); } }
    sums: [4] f64;
    for t: 0..<tq {
      n := ifx causal then first + t0 + t + 1 else nk;
      sums[t] = we_softmax(s[t * WE_KEYS_MAX..<(t + 1) * WE_KEYS_MAX], n);
      for kk: n..<nmax { s[t * WE_KEYS_MAX + kk] = 0; }
    }
    we_values(s[..], v, nmax, d, hd, dh, tq, acc[..]);
    for t: 0..<tq {
      inv := cast(f32) (1 / sums[t]);
      for i: 0..<dh { out[(t0 + t) * d + hd + i] = acc[t * WE_HEAD_MAX + i] * inv; }
    }
  }
}
// acc[t * WE_HEAD_MAX + i] = sum over keys j in order of p[t][j] v[j][i],
// for tq queries; p[t][j] = s[t * WE_KEYS_MAX + j].
we_values :: (s: [] f32, v: [] f32, n: int, d: int, hd: int, dh: int, tq: int, acc: [] f32) {
  for t: 0..<tq { for i: 0..<dh { acc[t * WE_HEAD_MAX + i] = 0; } }
  for j: 0..<n {
    for t: 0..<tq {
      for i: 0..<dh { acc[t * WE_HEAD_MAX + i] = fma(s[t * WE_KEYS_MAX + j], v[j * d + hd + i], acc[t * WE_HEAD_MAX + i]); }
    }
  }
}
we_attend :: (q: [] f32, nq: int, k: [] f32, v: [] f32, nk: int, d: int, heads: int, first: int, causal: bool, out: [] f32) {
  we_attend_part(q, nq, k, v, nk, d, heads, first, causal, out, 0, heads * we_attend_blocks(nq));
}
we_att :: (q: [] f32, nq: int, k: [] f32, v: [] f32, nk: int, d: int, heads: int, first: int, causal: bool, out: [] f32) {
  r := cxwh_attend(q, nq, k, v, nk, d, heads, first, causal, out);
}
// A width-3 convolution with padding 1, then GELU, for output channels
// o0..o1. src is channel-major (n_in x t_in), w is [out][in][3]. stride 1
// writes channel-major (n_out x t_out); stride 2 writes time-major
// (t_out x n_out) plus pos, as the encoder's input.
we_conv_part :: (src: [] f32, n_in: int, t_in: int, w: [] f32, b: [] f32, n_out: int, t_out: int, stride: int, pos: [] f32, out: [] f32, o0: int, o1: int) {
  acc: [3000] f32;
  for o: o0..<o1 {
    for t: 0..<t_out { acc[t] = b[o]; }
    for i: 0..<n_in {
      row := src[i * t_in..<(i + 1) * t_in];
      w0 := w[(o * n_in + i) * 3]; wa := w[(o * n_in + i) * 3 + 1]; wb := w[(o * n_in + i) * 3 + 2];
      for t: 0..<t_out {
        c := stride * t;
        s := wa * row[c];
        if c > 0 { s += w0 * row[c - 1]; }
        if c + 1 < t_in { s += wb * row[c + 1]; }
        acc[t] += s;
      }
    }
    if stride == 1 { for t: 0..<t_out { out[o * t_out + t] = we_gelu(acc[t]); } }
    else { for t: 0..<t_out { out[t * n_out + o] = we_gelu(acc[t]) + pos[t * n_out + o]; } }
  }
}

// The encoder's convolutions run as projections: each output time t takes
// a row of its n_in x 3 inputs (input c, tap k at col[t][3c + k], zero past
// the edges), which matches the weights' [out][in][3] layout.
// From channel-major src (n_in rows of t_in), stride 1.
we_im2col_rows :: (src: [] f32, n_in: int, t_in: int, t_out: int, col: [] f32) {
  w := 3 * n_in;
  for t: 0..<t_out {
    r := col[t * w..<(t + 1) * w];
    for c: 0..<n_in {
      row := src[c * t_in..<(c + 1) * t_in];
      r[3 * c] = ifx t > 0 then row[t - 1] else 0;
      r[3 * c + 1] = row[t];
      r[3 * c + 2] = ifx t + 1 < t_in then row[t + 1] else 0;
    }
  }
}
// From time-major src (t_in rows of n_in), stride 2.
we_im2col_time :: (src: [] f32, n_in: int, t_in: int, t_out: int, col: [] f32) {
  w := 3 * n_in;
  for t: 0..<t_out {
    r := col[t * w..<(t + 1) * w];
    c0 := 2 * t;
    for c: 0..<n_in {
      r[3 * c] = ifx c0 > 0 then src[(c0 - 1) * n_in + c] else 0;
      r[3 * c + 1] = src[c0 * n_in + c];
      r[3 * c + 2] = ifx c0 + 1 < t_in then src[(c0 + 1) * n_in + c] else 0;
    }
  }
}

// ---- encoder ------------------------------------------------------------------

// The encoder over net.ctx positions of the mel window at work.mel
// (mels x 3000, mel-major). Leaves the encoded frames at work.x (ctx x d)
// and each decoder layer's cross-attention keys and values at work.ck, cv.
we_encode :: (net: WeNet, W: [] f32, work: [] f32) {
  p := net.params; d := p.n_audio_state; T := net.ctx; T2 := 2 * T; k := net.work; mels := p.n_mels;
  mel := work[k.mel..<k.mel + mels * WF_WINDOW_FRAMES];
  c1 := work[k.c1..<k.c1 + d * T2];
  x := work[k.x..<k.x + T * d];
  none: [1] f32;
  h := work[k.h..<k.h + T * d]; q := work[k.q..<k.q + T * d]; kk := work[k.k..<k.k + T * d]; v := work[k.v..<k.v + T * d];
  a := work[k.a..<k.a + T * d]; mm := work[k.m..<k.m + T * 4 * d];
  // conv1 reads the first 2T frames of each mel row (rows are 3,000 long)
  // and leaves c1 time-major; both convolutions build their rows in mm.
  we_im2col_rows(mel, mels, WF_WINDOW_FRAMES, T2, mm);
  we_mm_gelu(mm, T2, 3 * mels, W[net.c1_w..<net.c1_w + 3 * mels * d], W[net.c1_b..<net.c1_b + d], d, c1);
  we_im2col_time(c1, d, T2, T, mm);
  we_mm_gelu(mm, T, 3 * d, W[net.c2_w..<net.c2_w + 3 * d * d], W[net.c2_b..<net.c2_b + d], d, x);
  pos := W[net.e_pos..<net.e_pos + T * d];
  for i: 0..<T * d { x[i] += pos[i]; }
  // the layers in one GPU batch where the host has one
  batch := cxwh_step(2) == 1;
  for l: 0..<p.n_audio_layer {
    bl := net.enc[l];
    we_ln(x, T, d, W[bl.ln1_w..<bl.ln1_w + d], W[bl.ln1_b..<bl.ln1_b + d], h);
    we_mm(h, T, d, W[bl.q_w..<bl.q_w + d * d], W[bl.q_b..<bl.q_b + d], d, q);
    we_mm(h, T, d, W[bl.k_w..<bl.k_w + d * d], none[0..<0], d, kk);
    we_mm(h, T, d, W[bl.v_w..<bl.v_w + d * d], W[bl.v_b..<bl.v_b + d], d, v);
    we_att(q, T, kk, v, T, d, p.n_audio_head, 0, false, a);
    we_mm_add(a, T, d, W[bl.o_w..<bl.o_w + d * d], W[bl.o_b..<bl.o_b + d], d, x);
    we_ln(x, T, d, W[bl.ln2_w..<bl.ln2_w + d], W[bl.ln2_b..<bl.ln2_b + d], h);
    we_mm_gelu(h, T, d, W[bl.fc1_w..<bl.fc1_w + 4 * d * d], W[bl.fc1_b..<bl.fc1_b + 4 * d], 4 * d, mm);
    we_mm_add(mm, T, 4 * d, W[bl.fc2_w..<bl.fc2_w + 4 * d * d], W[bl.fc2_b..<bl.fc2_b + d], d, x);
  }
  we_ln(x, T, d, W[net.e_ln_w..<net.e_ln_w + d], W[net.e_ln_b..<net.e_ln_b + d], h);
  // cross-attention keys and values for every decoder layer
  for l: 0..<p.n_text_layer {
    bl := net.dec[l];
    we_mm(h, T, d, W[bl.xk_w..<bl.xk_w + d * d], none[0..<0], d, work[k.ck + l * T * d..<k.ck + (l + 1) * T * d]);
    we_mm(h, T, d, W[bl.xv_w..<bl.xv_w + d * d], W[bl.xv_b..<bl.xv_b + d], d, work[k.cv + l * T * d..<k.cv + (l + 1) * T * d]);
  }
  if batch { done := cxwh_step(0); }
  for i: 0..<T * d { x[i] = h[i]; }
}

// ---- decoder ------------------------------------------------------------------

// Decoders running side by side (beams, or samples at a temperature), each
// with its own self-attention cache slot; rows a decoder call handles at once
// (a whole prompt: the previous-text prompt is at most n_text_ctx / 2 tokens).
WE_SLOTS :: 5;
WE_ROWS_MAX :: 232;
// Layer l's self-attention keys (values: we_slot_v) in slot s: n_text_ctx rows of d.
we_slot_k :: (net: WeNet, work: [] f32, l: int, s: int) -> [] f32 {
  C := net.params.n_text_ctx; d := net.params.n_text_state; at := net.work.sk + (l * WE_SLOTS + s) * C * d;
  return work[at..<at + C * d];
}
we_slot_v :: (net: WeNet, work: [] f32, l: int, s: int) -> [] f32 {
  C := net.params.n_text_ctx; d := net.params.n_text_state; at := net.work.sv + (l * WE_SLOTS + s) * C * d;
  return work[at..<at + C * d];
}
// Copies positions 0..n of slot from into slot to, in every layer.
we_slot_copy :: (net: WeNet, work: [] f32, from: int, to: int, n: int) {
  if from == to { return; }
  d := net.params.n_text_state;
  for l: 0..<net.params.n_text_layer {
    ka := we_slot_k(net, work, l, from); kb := we_slot_k(net, work, l, to);
    va := we_slot_v(net, work, l, from); vb := we_slot_v(net, work, l, to);
    for i: 0..<n * d { kb[i] = ka[i]; vb[i] = va[i]; }
  }
}

// Self-attention of a step's rows in one call when the host takes it (up to
// five rows, positions below 512).
we_slots :: (net: WeNet, work: [] f32, l: int, q: [] f32, rows: int, pos: [] int, slots: [] int, a: [] f32) -> bool {
  C := net.params.n_text_ctx; d := net.params.n_text_state;
  sp := we_sp(net, rows, pos, slots);
  if sp < 0 { return false; }
  nk := 0;
  for r: 0..<rows { if pos[r] + 1 > nk { nk = pos[r] + 1; } }
  at := net.work.sk + l * WE_SLOTS * C * d; av := net.work.sv + l * WE_SLOTS * C * d;
  return cxwh_slots(q, rows, work[at..<at + WE_SLOTS * C * d], work[av..<av + WE_SLOTS * C * d], C, d, net.params.n_text_head, sp, nk, a) == 1;
}
// Slot and position of each row, 512 s + p in bits 12 r..12 r + 11; -1
// when they do not fit (more than 5 rows, or a context above 512).
we_sp :: (net: WeNet, rows: int, pos: [] int, slots: [] int) -> int {
  if rows > 5 || net.params.n_text_ctx > 512 { return -1; }
  sp := 0;
  for r: 0..<rows { sp = sp | ((slots[r] * 512 + pos[r]) << (12 * r)); }
  return sp;
}
// The query, key and value of a step's rows through cxwh_qkv, when the
// block's weights lie together and the rows fit sp; false otherwise.
we_qkv :: (net: WeNet, W: [] f32, work: [] f32, l: int, h: [] f32, rows: int, sp: int, q: [] f32) -> bool {
  bl := net.dec[l]; d := net.params.n_text_state; C := net.params.n_text_ctx;
  if sp < 0 || bl.k_w != bl.q_w + d * d || bl.v_w != bl.q_w + 2 * d * d || bl.v_b != bl.q_b + 2 * d { return false; }
  at := net.work.sk + l * WE_SLOTS * C * d; vstride := net.work.sv - net.work.sk;
  kv := work[at..<net.work.sv + (l + 1) * WE_SLOTS * C * d];
  return cxwh_qkv(h, rows, d, W[bl.q_w..<bl.q_w + 3 * d * d], W[bl.q_b..<bl.q_b + 3 * d], q, kv, vstride, C, sp) == 1;
}
// The decoder over rows tokens. prefill: the rows are one sequence at
// positions pos[0], pos[0] + 1, ... in slot slots[0], and only the last row's
// logits are made (at logits row 0). Otherwise row r is one decoder's next
// token at position pos[r] in its slot slots[r], and every row's logits are
// made (logits row r). Self-attention keys and values of the rows go into
// the slots first, so a row sees itself and everything before it. A step
// that is not a prefill runs as one batch on a GPU host.
// tops > 0 (a step only): the rules in work at rp are applied to each row's
// logits in the step's batch, and its top tops tokens are left at rt; true
// when that happened.
we_forward :: (net: WeNet, W: [] f32, work: [] f32, toks: [] int, rows: int, pos: [] int, slots: [] int, prefill: bool, tops: int) -> bool {
  p := net.params; d := p.n_text_state; k := net.work; T := net.ctx; V := p.n_vocab;
  x := work[k.dx..<k.dx + rows * d]; h := work[k.dh..<k.dh + rows * d]; q := work[k.dq..<k.dq + rows * d];
  a := work[k.da..<k.da + rows * d]; kn := work[k.dk..<k.dk + rows * d]; vn := work[k.dv..<k.dv + rows * d];
  mm := work[k.dm..<k.dm + rows * 4 * d];
  emb := W[net.d_emb..<net.d_emb + V * d]; dpos := W[net.d_pos..<net.d_pos + p.n_text_ctx * d];
  for r: 0..<rows {
    at := ifx prefill then pos[0] + r else pos[r];
    for i: 0..<d { x[r * d + i] = emb[toks[r] * d + i] + dpos[at * d + i]; }
  }
  none: [1] f32;
  step := !prefill && cxwh_step(1) == 1;
  sp := ifx step then we_sp(net, rows, pos, slots) else -1;
  for l: 0..<p.n_text_layer {
    bl := net.dec[l];
    we_ln(x, rows, d, W[bl.ln1_w..<bl.ln1_w + d], W[bl.ln1_b..<bl.ln1_b + d], h);
    if !we_qkv(net, W, work, l, h, rows, sp, q) {
      we_mm(h, rows, d, W[bl.q_w..<bl.q_w + d * d], W[bl.q_b..<bl.q_b + d], d, q);
      we_mm(h, rows, d, W[bl.k_w..<bl.k_w + d * d], none[0..<0], d, kn);
      we_mm(h, rows, d, W[bl.v_w..<bl.v_w + d * d], W[bl.v_b..<bl.v_b + d], d, vn);
      for r: 0..<rows {
        s := ifx prefill then slots[0] else slots[r]; at := ifx prefill then pos[0] + r else pos[r];
        sk := we_slot_k(net, work, l, s); sv := we_slot_v(net, work, l, s);
        we_store(kn[r * d..<(r + 1) * d], vn[r * d..<(r + 1) * d], sk[at * d..<(at + 1) * d], sv[at * d..<(at + 1) * d]);
      }
    }
    if prefill {
      we_att(q, rows, we_slot_k(net, work, l, slots[0]), we_slot_v(net, work, l, slots[0]), pos[0] + rows, d, p.n_text_head, pos[0], true, a);
    } else if !we_slots(net, work, l, q, rows, pos, slots, a) {
      for r: 0..<rows {
        we_att(q[r * d..<(r + 1) * d], 1, we_slot_k(net, work, l, slots[r]), we_slot_v(net, work, l, slots[r]), pos[r] + 1, d, p.n_text_head, pos[r], true, a[r * d..<(r + 1) * d]);
      }
    }
    we_mm_add(a, rows, d, W[bl.o_w..<bl.o_w + d * d], W[bl.o_b..<bl.o_b + d], d, x);
    we_ln(x, rows, d, W[bl.lnx_w..<bl.lnx_w + d], W[bl.lnx_b..<bl.lnx_b + d], h);
    we_mm(h, rows, d, W[bl.xq_w..<bl.xq_w + d * d], W[bl.xq_b..<bl.xq_b + d], d, q);
    we_att(q, rows, work[k.ck + l * T * d..<k.ck + (l + 1) * T * d], work[k.cv + l * T * d..<k.cv + (l + 1) * T * d], T, d, p.n_text_head, 0, false, a);
    we_mm_add(a, rows, d, W[bl.xo_w..<bl.xo_w + d * d], W[bl.xo_b..<bl.xo_b + d], d, x);
    we_ln(x, rows, d, W[bl.ln2_w..<bl.ln2_w + d], W[bl.ln2_b..<bl.ln2_b + d], h);
    we_mm_gelu(h, rows, d, W[bl.fc1_w..<bl.fc1_w + 4 * d * d], W[bl.fc1_b..<bl.fc1_b + 4 * d], 4 * d, mm);
    we_mm_add(mm, rows, 4 * d, W[bl.fc2_w..<bl.fc2_w + 4 * d * d], W[bl.fc2_b..<bl.fc2_b + d], d, x);
  }
  r0 := ifx prefill then rows - 1 else 0; n := ifx prefill then 1 else rows;
  we_ln(x[r0 * d..<(r0 + n) * d], n, d, W[net.d_ln_w..<net.d_ln_w + d], W[net.d_ln_b..<net.d_ln_b + d], h[0..<n * d]);
  we_mm(h[0..<n * d], n, d, emb, none[0..<0], V, work[k.logits..<k.logits + n * V]);
  ruled := false;
  if step && tops > 0 {
    ruled = cxwh_rules(work[k.logits..<k.logits + n * V], n, V, net.sp.beg, tops, work[k.rp..<k.rp + n * WE_PRM],
                       work[k.rl..<k.rl + n * V], work[k.rt..<k.rt + n * WE_TOP]) == 1;
  }
  if step { done := cxwh_step(0); }
  return ruled;
}

// ---- the host's entry points ----------------------------------------------------

psionic_whisper_read :: (b: [] u8, tensors: [] WgTensor) -> WgModel #export_c { return wg_read(b, tensors); }
psionic_whisper_net :: (b: [] u8, m: WgModel, tensors: [] WgTensor, offsets: [] int, ctx: int) -> WeNet #export_c {
  return we_net(b, m, tensors, offsets, ctx);
}
psionic_whisper_load :: (b: [] u8, tensors: [] WgTensor, count: int, offsets: [] int, w: [] f32) -> WeStatus #export_c {
  return we_load(b, tensors, count, offsets, w);
}
psionic_whisper_load_slice :: (b: [] u8, t: WgTensor, at: int, j0: int, j1: int, w: [] f32) -> WeStatus #export_c {
  return we_load_slice(b, t, at, j0, j1, w);
}
psionic_whisper_bank :: (mels: int, bank: [] f64) -> int #export_c { return cast(int) sf_mel_bank(wf_spec(mels), bank).status; }
// The largest difference between our mel filters and the file's.
psionic_whisper_filter_diff :: (b: [] u8, m: WgModel, bank: [] f64) -> f64 #export_c {
  worst := 0.0;
  for i: 0..<m.filter_mels { for j: 0..<m.filter_bins {
    e := abs(bank[i * m.filter_bins + j] - cast(f64) wg_filter(b, m, i, j));
    if e > worst { worst = e; }
  } }
  return worst;
}
// segs written as text (0), SRT (1), WebVTT (2) or JSON (3); the byte count, or -1 when out is too small.
psionic_whisper_format :: (segs: [] WsSegment, format: int, model: string, language: string, out: [] u8) -> int #export_c {
  w: [1] WsOut; w[0].buf = out;
  if format == 1 { wsg_srt(segs, w[..]); }
  else if format == 2 { wsg_vtt(segs, w[..]); }
  else if format == 3 { wsg_json(segs, model, "psionic", language, w[..]); }
  else if format == 4 { wsg_lines(segs, w[..]); }
  else { wsg_text(segs, w[..]); }
  return ifx w[0].full then -1 else w[0].n;
}
// 16-bit little-endian PCM samples at b[at..] as f32 in [-1, 1).
// WAV input (wav.coax): the format and data chunk, every frame as mono at
// the file's rate, and those resampled to 16 kHz.
psionic_whisper_wav_info :: (b: [] u8) -> WvInfo #export_c { return wv_info(b); }
psionic_whisper_wav_mono :: (b: [] u8, info: WvInfo, mono: [] f32) -> int #export_c { return wv_mono(b, info, mono); }
psionic_whisper_wav_length :: (frames: int, rate: int) -> int #export_c { return wv_length(frames, rate); }
psionic_whisper_resample :: (mono: [] f32, rate: int, out: [] f32) -> int #export_c {
  table: [WV_TABLE] f64; wv_table(table[..]);
  return wv_resample(mono, rate, table[..], out);
}

#test "a block's query, key and value weights are laid out together" {
  t: [9] WgTensor; off: [9] int;
  names := [9] string.["d.blocks.0.mlp.0.weight", "d.blocks.0.attn.query.weight", "d.blocks.0.attn.query.bias", "d.blocks.0.attn.key.weight",
                       "d.blocks.0.attn.value.weight", "d.blocks.0.attn.value.bias", "d.blocks.0.cross_attn.query.weight", "d.blocks.0.cross_attn.key.weight", "e.blocks.1.attn.query.weight"];
  sizes := [9] int.[8, 4, 2, 4, 4, 2, 4, 4, 4];
  for i: 0..<9 { t[i].name = names[i]; t[i].elements = sizes[i]; }
  total := we_layout(t[..], 9, off[..]);
  // mlp, then q k v weights, q bias, a gap, v bias; cross attention and a
  // query weight without partners stay in file order
  #assert off[0] == 0 && off[1] == 8 && off[3] == 12 && off[4] == 16 && off[2] == 20 && off[5] == 24;
  #assert off[6] == 26 && off[7] == 30 && off[8] == 34 && total == 38;
  // a key weight of another size keeps the file order
  t[3].elements = 3;
  total = we_layout(t[..], 9, off[..]);
  #assert off[1] == 8 && off[2] == 12 && off[3] == 14 && off[4] == 17 && off[5] == 21 && total == 35;
}
#test "quantized blocks decode as ggml does" {
  // d = 0.5 (0x3800), m = -1 (0xbc00)
  b: [40] u8; out: [32] f32;
  b[0] = 0x00; b[1] = 0x38;
  for j: 0..<32 { b[2 + j] = cast(u8) ((j * 9) & 255); }
  #assert we_dequant(b[..], WG_Q8_0, 0, out[..]);
  for j: 0..<32 { q := (j * 9) & 255; if q >= 128 { q -= 256; } #assert out[j] == 0.5 * cast(f32) q; }
  // q4_0: byte j holds value j (low nibble) and value j+16 (high nibble)
  for j: 0..<16 { b[2 + j] = cast(u8) (j | ((15 - j) << 4)); }
  #assert we_dequant(b[..], WG_Q4_0, 0, out[..]);
  for j: 0..<16 { #assert out[j] == 0.5 * cast(f32) (j - 8) && out[j + 16] == 0.5 * cast(f32) (7 - j); }
  // q4_1 with m = -1
  b[2] = 0x00; b[3] = 0xbc; for j: 0..<16 { b[4 + j] = cast(u8) (j | ((15 - j) << 4)); }
  #assert we_dequant(b[..], WG_Q4_1, 0, out[..]);
  for j: 0..<16 { #assert out[j] == 0.5 * cast(f32) j - 1 && out[j + 16] == 0.5 * cast(f32) (15 - j) - 1; }
  // q5_0: fifth bits set for values 0 and 16 only (qh bits 0 and 16)
  b[2] = 0x01; b[3] = 0; b[4] = 0x01; b[5] = 0;
  for j: 0..<16 { b[6 + j] = cast(u8) (3 | (5 << 4)); }
  #assert we_dequant(b[..], WG_Q5_0, 0, out[..]);
  #assert out[0] == 0.5 * cast(f32) (19 - 16) && out[1] == 0.5 * cast(f32) (3 - 16) && out[16] == 0.5 * cast(f32) (21 - 16) && out[17] == 0.5 * cast(f32) (5 - 16);
  // q5_1: the same bits, m = -1, no offset
  b[2] = 0x00; b[3] = 0xbc; b[4] = 0x01; b[5] = 0; b[6] = 0x01; b[7] = 0;
  for j: 0..<16 { b[8 + j] = cast(u8) (3 | (5 << 4)); }
  #assert we_dequant(b[..], WG_Q5_1, 0, out[..]);
  #assert out[0] == 0.5 * 19 - 1 && out[1] == 0.5 * 3 - 1 && out[16] == 0.5 * 21 - 1 && out[17] == 0.5 * 5 - 1;
  // an infinite scale is refused
  b[0] = 0x00; b[1] = 0x7c; #assert !we_dequant(b[..], WG_Q8_0, 0, out[..]);
}
#test "halves decode exactly" #steps 200000000 {
  #assert we_half(0x3c00).value == 1 && we_half(0xc000).value == -2 && we_half(0x0000).value == 0 && we_half(0x7bff).value == 65504;
  #assert we_half(0x0001).value == f32_from_bits(0x33800000) && we_half(0x03ff).value == cast(f32) 1023 * f32_from_bits(0x33800000);
  #assert we_half(0x3555).value == f32_from_bits(0x3eaaa000) && !we_half(0x7c00).ok && !we_half(0xfe00).ok;
  // every finite pattern: the f32 value rounds back to the same half (checked through its bits)
  for h: 0..<65536 {
    e := (h >> 10) & 31;
    r := we_half(h);
    #assert r.ok == (e != 31);
    if !r.ok { continue; }
    bits := cast(int) f32_bits(r.value);
    if e != 0 { #assert (bits & 0x1fff) == 0 && ((bits >> 13) & 1023) == (h & 1023); }
    #assert ((bits >> 31) & 1) == ((h >> 15) & 1);
  }
}
#test "a blocked product equals one output at a time" {
  x: [21] f32; w: [42] f32; y: [18] f32; z: [18] f32; bias := [2] f32.[0.25, -0.5];
  for i: 0..<21 { x[i] = cast(f32) (i % 5) * 0.37 - 0.6; }
  for i: 0..<42 { w[i] = cast(f32) (i % 7) * 0.11 - 0.3; }
  // 3 rows of 7 inputs, 6 outputs: one block of 4, then 2 alone
  we_linear_part(x[..], 3, 7, w[..], bias[0..<0], 6, y[..], 0, 6, 0);
  for o: 0..<6 { we_linear_part(x[..], 3, 7, w[..], bias[0..<0], 6, z[..], o, o + 1, 0); }
  for i: 0..<18 { #assert y[i] == z[i]; }
  // 5 rows (a tile of 4, then 1) equal one row at a time
  x5: [45] f32; w5: [54] f32; y5: [30] f32; z5: [30] f32;
  for i: 0..<45 { x5[i] = cast(f32) (i % 7) * 0.29 - 0.8; }
  for i: 0..<54 { w5[i] = cast(f32) (i % 11) * 0.07 - 0.35; }
  we_linear_part(x5[..], 5, 9, w5[..], bias[0..<0], 6, y5[..], 0, 6, 1);
  for r: 0..<5 { we_linear_part(x5[r * 9..<(r + 1) * 9], 1, 9, w5[..], bias[0..<0], 6, z5[r * 6..<(r + 1) * 6], 0, 6, 1); }
  for i: 0..<30 { #assert y5[i] == z5[i]; }
}
#test "kernels by hand" {
  x := [4] f32.[1, 2, 3, 4]; w := [8] f32.[1, 0, 0, 0, 1, 1, 1, 1]; bias := [2] f32.[0.5, -1]; y: [2] f32;
  we_linear(x[..], 1, 4, w[..], bias[..], 2, y[..]);
  #assert y[0] == 1.5 && y[1] == 9;
  g := [4] f32.[1, 1, 1, 1]; z := [4] f32.[0, 0, 0, 0]; n: [4] f32;
  we_norm(x[..], 1, 4, g[..], z[..], n[..]);
  #assert abs(n[0] + 1.3416355) < 0.00001 && abs(n[3] - 1.3416355) < 0.00001;
  #assert we_gelu(0) == 0 && abs(we_gelu(1) - 0.841192) < 0.00001 && abs(we_gelu(-3) + 0.003637) < 0.00001;
  worst := 0.0;
  for i: 0..<2001 {
    xe := cast(f32) (-86.0 + cast(f64) i * 0.087);
    r := abs(cast(f64) we_expf(xe) / exp(cast(f64) xe) - 1);
    if r > worst { worst = r; }
  }
  #assert worst < 0.0000005;
  #assert we_expf(-90) == 0 && we_expf(0) == 1;
  // one head, two keys: equal scores average the values
  q := [2] f32.[0, 0]; k := [4] f32.[1, 0, 0, 1]; v := [4] f32.[2, 4, 6, 8]; o: [2] f32;
  we_attend(q[..], 1, k[..], v[..], 2, 2, 1, 0, false, o[..]);
  #assert o[0] == 4 && o[1] == 6;
  we_attend(q[..], 1, k[..], v[..], 2, 2, 1, 0, true, o[..]);
  #assert o[0] == 2 && o[1] == 4;
}
#test "attention blocks match a direct softmax for every query count and mask" {
  // 2 heads of 4 dimensions, up to 7 queries and 9 keys
  d := 8; heads := 2; dh := 4;
  q: [56] f32; k: [72] f32; v: [72] f32; o: [56] f32;
  for i: 0..<56 { q[i] = cast(f32) ((i * 7) % 11) * 0.1 - 0.5; }
  for i: 0..<72 { k[i] = cast(f32) ((i * 5) % 13) * 0.1 - 0.6; v[i] = cast(f32) ((i * 3) % 7) - 3; }
  for nq: 1..<8 {
    for mode: 0..<2 {
      causal := mode == 1; first := ifx causal then 2 else 0; nk := ifx causal then first + nq else 9;
      for i: 0..<56 { o[i] = -99; }
      we_attend(q[..], nq, k[..], v[..], nk, d, heads, first, causal, o[..]);
      for h: 0..<heads { for t: 0..<nq {
        n := ifx causal then first + t + 1 else nk;
        sc: [9] f64; best := -1.0e300;
        for j: 0..<n { a := 0.0; for i: 0..<dh { a += cast(f64) q[t * d + h * dh + i] * cast(f64) k[j * d + h * dh + i]; } sc[j] = a / 2; if sc[j] > best { best = sc[j]; } }
        z := 0.0; for j: 0..<n { sc[j] = exp(sc[j] - best); z += sc[j]; }
        for i: 0..<dh {
          r := 0.0; for j: 0..<n { r += sc[j] / z * cast(f64) v[j * d + h * dh + i]; }
          #assert abs(cast(f64) o[t * d + h * dh + i] - r) < 0.00001;
        }
      } }
      for t: nq..<7 { #assert o[t * d] == -99; }
    }
  }
}
#test "convolution rows times the weights equal the direct convolution" {
  // 3 inputs of 8 frames, 4 outputs: stride 1 channel-major, then stride 2 from time-major
  src: [24] f32; w: [36] f32; b: [4] f32; pos: [16] f32;
  for i: 0..<24 { src[i] = cast(f32) ((i * 5) % 7) - 3; }
  for i: 0..<36 { w[i] = cast(f32) ((i * 3) % 5) * 0.25 - 0.5; }
  for i: 0..<4 { b[i] = cast(f32) i * 0.5; }
  direct: [32] f32; col: [96] f32; y: [32] f32;
  we_conv_part(src[..], 3, 8, w[..], b[..], 4, 8, 1, pos[0..<0], direct[..], 0, 4);
  we_im2col_rows(src[..], 3, 8, 8, col[..]);
  we_linear_part(col[..], 8, 9, w[..], b[..], 4, y[..], 0, 4, 1);
  for o: 0..<4 { for t: 0..<8 { #assert abs(direct[o * 8 + t] - y[t * 4 + o]) < 0.00001; } }
  // stride 2 on 4 time-major channels of 8 frames (y above), 4 outputs
  w2: [48] f32; for i: 0..<48 { w2[i] = cast(f32) ((i * 7) % 9) * 0.1 - 0.4; }
  cm: [32] f32; for o: 0..<4 { for t: 0..<8 { cm[o * 8 + t] = y[t * 4 + o]; } }
  d2: [16] f32; col2: [48] f32; y2: [16] f32;
  we_conv_part(cm[..], 4, 8, w2[..], b[..], 4, 4, 2, pos[..], d2[..], 0, 4);
  we_im2col_time(y[..], 4, 8, 4, col2[..]);
  we_linear_part(col2[..], 4, 12, w2[..], b[..], 4, y2[..], 0, 4, 1);
  for i: 0..<16 { #assert abs(d2[i] - y2[i]) < 0.00001; }
}
psionic_whisper_linear_part :: (x: [] f32, rows: int, n_in: int, w: [] f32, b: [] f32, n_out: int, y: [] f32, o0: int, o1: int, act: int) #export_c {
  we_linear_part(x, rows, n_in, w, b, n_out, y, o0, o1, act);
}
psionic_whisper_attend_part :: (q: [] f32, nq: int, k: [] f32, v: [] f32, nk: int, d: int, heads: int, first: int, causal: bool, out: [] f32, j0: int, j1: int) #export_c {
  we_attend_part(q, nq, k, v, nk, d, heads, first, causal, out, j0, j1);
}
psionic_whisper_mel_part :: (x: [] f32, window: [] f64, bank: [] f64, mels: int, cache: [] f32, t0: int, t1: int) #export_c {
  wf_frames_part(x, window, bank, mels, cache, t0, t1);
}
// The cache size in floats for n samples: every frame's mels.
psionic_whisper_cache_size :: (n: int, mels: int) -> int #export_c { return wf_frames(n) * mels; }
// The language token for a code on this model, or -1 (English-only models
// have none; "auto" is not detected yet and also gives -1).
psionic_whisper_language :: (net: WeNet, code: string) -> int #export_c { return wt_language(net.sp, code); }
