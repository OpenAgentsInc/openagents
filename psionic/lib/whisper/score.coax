// Scoring transcripts against each other: words, word error rate, the word
// differences, and how far segment start times drift. The comparison
// harness (`openagents transcribe compare`) runs both backends and scores
// them with this file. No effects. Design: psionic/docs/transcribe.md.
//   coax/bin/coax test psionic/lib/whisper/score.coax --library
#load "segments.coax";

// Words: lowercase ASCII letters, digits and apostrophes inside a word; any
// other ASCII byte separates words. Bytes from 0x80 up (UTF-8) count as
// letters. A hyphen separates ("well-known" is two words), so the two
// backends' hyphenation choices do not count as errors.
sc_letter :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c >= 0x80; }
sc_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
// The words of text, lowercased into buf, as views in words. The word
// count, or -1 when buf or words is too small.
sc_words :: (text: string, buf: [] u8, words: [] string) -> int {
  n := 0; at := 0; i := 0;
  while i < text.count {
    if !sc_letter(text[i]) { i += 1; continue; }
    start := at;
    while i < text.count && (sc_letter(text[i]) || (text[i] == '\'' && i + 1 < text.count && sc_letter(text[i + 1]) && at > start)) {
      if at >= buf.count { return -1; }
      buf[at] = sc_lower(text[i]); at += 1; i += 1;
    }
    if n >= words.count { return -1; }
    words[n] = cast(string) buf[start..<at]; n += 1;
  }
  return n;
}
// The text of every segment, joined with spaces, into buf; the byte count,
// or -1 when it does not fit.
sc_join :: (segs: [] WsSegment, buf: [] u8) -> int {
  n := 0;
  for s: segs {
    if n > 0 { if n >= buf.count { return -1; } buf[n] = ' '; n += 1; }
    if n + s.text.count > buf.count { return -1; }
    for c: s.text { buf[n] = c; n += 1; }
  }
  return n;
}

// Edit counts from the reference words to the hypothesis words.
ScErrors :: struct { ok: bool; words: int; subs: int; ins: int; dels: int; }
sc_errors :: (e: ScErrors) -> int { return e.subs + e.ins + e.dels; }
// Word error rate in hundredths of a percent (1234 is 12.34%); 0 when the
// reference is empty and the hypothesis is too.
sc_wer_bp :: (e: ScErrors) -> int {
  if e.words == 0 { return ifx sc_errors(e) == 0 then 0 else 10000; }
  return (sc_errors(e) * 10000 + e.words / 2) / e.words;
}
// One edit of an alignment: a substitution, an insertion (hyp only) or a
// deletion (ref only), with word indexes (-1 for the missing side).
ScEditKind :: enum u8 {sub; ins; del;}
ScEdit :: struct { kind: ScEditKind; r: int; h: int; }
SC_DIAG :: 0; SC_UP :: 1; SC_LEFT :: 2;
// The minimum edits from ref to hyp (Levenshtein over words), with ties
// broken toward substitutions. dir, when it holds (|ref|+1)*(|hyp|+1)
// bytes, keeps the path so the edits can be listed into edits (in order;
// the count is in edits_n). row needs |hyp|+1 entries, twice.
ScAlign :: struct { errors: ScErrors; edits_n: int; }
sc_align :: (ref: [] string, hyp: [] string, row: [] int, dir: [] u8, edits: [] ScEdit) -> ScAlign {
  out: ScAlign; n := ref.count; m := hyp.count;
  out.errors.words = n;
  if row.count < 2 * (m + 1) { return out; }
  keep := dir.count >= (n + 1) * (m + 1);
  prev := row[0..<m + 1]; cur := row[m + 1..<2 * (m + 1)];
  for j: 0..<m + 1 { prev[j] = j; if keep { dir[j] = SC_LEFT; } }
  for i: 1..<n + 1 {
    cur[0] = i; if keep { dir[i * (m + 1)] = SC_UP; }
    for j: 1..<m + 1 {
      same := ref[i - 1] == hyp[j - 1];
      best := prev[j - 1] + (ifx same then 0 else 1); d := SC_DIAG;
      if prev[j] + 1 < best { best = prev[j] + 1; d = SC_UP; }
      if cur[j - 1] + 1 < best { best = cur[j - 1] + 1; d = SC_LEFT; }
      cur[j] = best;
      if keep { dir[i * (m + 1) + j] = cast(u8) d; }
    }
    for j: 0..<m + 1 { prev[j] = cur[j]; }
  }
  if !keep {
    // counts without the path: total only, all called substitutions
    out.errors.ok = true; out.errors.subs = prev[m];
    return out;
  }
  // walk back from the end, then reverse
  i := n; j := m; k := 0;
  while i > 0 || j > 0 {
    d := ifx i == 0 then SC_LEFT else ifx j == 0 then SC_UP else cast(int) dir[i * (m + 1) + j];
    if d == SC_DIAG {
      if ref[i - 1] != hyp[j - 1] { out.errors.subs += 1; if k < edits.count { edits[k] = ScEdit.{kind = ScEditKind.sub, r = i - 1, h = j - 1}; k += 1; } }
      i -= 1; j -= 1;
    } else if d == SC_UP {
      out.errors.dels += 1; if k < edits.count { edits[k] = ScEdit.{kind = ScEditKind.del, r = i - 1, h = -1}; k += 1; }
      i -= 1;
    } else {
      out.errors.ins += 1; if k < edits.count { edits[k] = ScEdit.{kind = ScEditKind.ins, r = -1, h = j - 1}; k += 1; }
      j -= 1;
    }
  }
  for a: 0..<k / 2 { t := edits[a]; edits[a] = edits[k - 1 - a]; edits[k - 1 - a] = t; }
  out.edits_n = k; out.errors.ok = true;
  return out;
}
// The edits as "ref -> hyp", "-ref" and "+hyp", separated by "; ".
sc_edits_text :: (ref: [] string, hyp: [] string, edits: [] ScEdit, w: [] WsOut) {
  for i: 0..<edits.count {
    if i > 0 { wsg_put(w, "; "); }
    e := edits[i];
    if e.kind == ScEditKind.sub { wsg_put(w, ref[e.r]); wsg_put(w, " -> "); wsg_put(w, hyp[e.h]); }
    else if e.kind == ScEditKind.del { wsg_byte(w, '-'); wsg_put(w, ref[e.r]); }
    else { wsg_byte(w, '+'); wsg_put(w, hyp[e.h]); }
  }
}

// How far a's segment starts are from b's: for each non-empty segment of a,
// the distance to the nearest start in b. Mean and largest, in ms.
ScDrift :: struct { n: int; mean_ms: int; max_ms: int; }
sc_drift :: (a: [] WsSegment, b: [] WsSegment) -> ScDrift {
  r: ScDrift; total := 0;
  for s: a {
    if s.text.count == 0 { continue; }
    near := -1;
    for t: b {
      if t.text.count == 0 { continue; }
      d := s.start_ms - t.start_ms; if d < 0 { d = -d; }
      if near < 0 || d < near { near = d; }
    }
    if near < 0 { continue; }
    r.n += 1; total += near;
    if near > r.max_ms { r.max_ms = near; }
  }
  if r.n > 0 { r.mean_ms = (total + r.n / 2) / r.n; }
  return r;
}

#test "words" {
  buf: [128] u8; w: [16] string;
  n := sc_words("And so, my fellow Americans: ask NOT -- what's well-known 'quoted' 30.", buf[..], w[..]);
  #assert n == 12 && w[11] == "30" && w[0] == "and" && w[4] == "americans" && w[6] == "not" && w[7] == "what's" && w[8] == "well" && w[9] == "known" && w[10] == "quoted";
  #assert sc_words("", buf[..], w[..]) == 0 && sc_words("  ...  ", buf[..], w[..]) == 0;
  #assert sc_words("a b c", buf[0..<2], w[..]) == -1 && sc_words("a b c", buf[..], w[0..<2]) == -1;
  w2: [4] string; #assert sc_words("30 isn't", buf[..], w2[..]) == 2 && w2[0] == "30" && w2[1] == "isn't";
  segs := [2] WsSegment.[WsSegment.{start_ms = 0, end_ms = 1, text = "a b"}, WsSegment.{start_ms = 1, end_ms = 2, text = "c"}];
  j: [8] u8; #assert sc_join(segs[..], j[..]) == 5 && cast(string) j[0..<5] == "a b c" && sc_join(segs[..], j[0..<4]) == -1;
}
#test "alignment" {
  ref := [5] string.["ask", "not", "what", "your", "country"];
  hyp := [5] string.["ask", "what", "you", "country", "can"];
  row: [16] int; dir: [64] u8; edits: [8] ScEdit;
  a := sc_align(ref[..], hyp[..], row[..], dir[..], edits[..]);
  #assert a.errors.ok && a.errors.words == 5 && a.errors.dels == 1 && a.errors.subs == 1 && a.errors.ins == 1 && a.edits_n == 3;
  #assert edits[0].kind == ScEditKind.del && edits[0].r == 1 && edits[1].kind == ScEditKind.sub && edits[1].r == 3 && edits[1].h == 2 && edits[2].kind == ScEditKind.ins && edits[2].h == 4;
  #assert sc_wer_bp(a.errors) == 6000;
  o: [128] u8; w: [1] WsOut; w[0].buf = o[..];
  sc_edits_text(ref[..], hyp[..], edits[0..<3], w[..]);
  #assert cast(string) o[0..<w[0].n] == "-not; your -> you; +can";
  // without room for the path, the total is still right
  b := sc_align(ref[..], hyp[..], row[..], dir[0..<4], edits[..]);
  #assert b.errors.ok && sc_errors(b.errors) == 3 && b.edits_n == 0;
  // identical, empty
  c := sc_align(ref[..], ref[..], row[..], dir[..], edits[..]);
  #assert sc_errors(c.errors) == 0 && sc_wer_bp(c.errors) == 0;
  e := sc_align(ref[0..<0], hyp[0..<2], row[..], dir[..], edits[..]);
  #assert e.errors.ins == 2 && sc_wer_bp(e.errors) == 10000;
  #assert !sc_align(ref[..], hyp[..], row[0..<3], dir[..], edits[..]).errors.ok;
}
#test "drift" {
  a := [3] WsSegment.[WsSegment.{start_ms = 0, end_ms = 1, text = "a"}, WsSegment.{start_ms = 1000, end_ms = 1, text = "b"}, WsSegment.{start_ms = 5000, end_ms = 1, text = ""}];
  b := [2] WsSegment.[WsSegment.{start_ms = 100, end_ms = 1, text = "a"}, WsSegment.{start_ms = 1300, end_ms = 1, text = "b"}];
  d := sc_drift(a[..], b[..]);
  #assert d.n == 2 && d.mean_ms == 200 && d.max_ms == 300;
  #assert sc_drift(a[..], b[0..<0]).n == 0;
}
