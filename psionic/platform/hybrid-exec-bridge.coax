// Thin Coax C-export bridge for psionic/platform/hybrid-exec-host.c
// (Executor W3.1, hybrid-exec-v1, GitHub #13920).
//
// Exposes all Coax #authority libraries (hybrid-exec-policy, hybrid-lora,
// hybrid-exec, next-token Ch 53 DFA, module-v2 safetensors deserialization,
// Ch 234 exact replay, and Ch 239-241 statistical gates) to the thin Metal 4
// platform host so zero policy, crypto, grammar, LoRA, or scoring logic lives in C.
#load "../lib/hybrid-exec.coax";
#load "../lib/suite.coax";
#load "../lib/verdict.coax";

HxbGateReport :: struct {
  suite_ok: bool;
  chain_ok: bool;
  compare_ok: bool;
  items_sha: [32] u8;
  questions_sha: [32] u8;
  gate_sha: [32] u8;
  floor_status: NsStatus;
  floor_blocks: int;
  floor_sd: f64;
  floor_val: f64;
  dec_status: VdStatus;
  dec_verdict: VdVerdict;
  dec_reason: VdReason;
  dec_gain: f64;
  dec_se: f64;
  dec_below: int;
  dec_tasks: int;
  dec_room: f64;
  prob_status: VdStatus;
  prob_verdict: VdVerdict;
  prob_reason: VdReason;
  prob_loss_base: f64;
  prob_loss_hyb: f64;
  prob_err_base: int;
  prob_err_hyb: int;
  prob_ece_base: f64;
  prob_ece_hyb: f64;
  eval_verdict: VdVerdict;
  eval_reason: VdReason;
}

// Deserialize a disk-loaded W2.2 weights.safetensors blob with mandatory SHA-256 verification.
hxb_load_module :: (
  bytes: [] u8, expect_sha: [32] u8,
  layers: [] EvLayerDesc, heads: [] EvHeadDesc, weights: [] f64
) -> EvLoadResult #export_c #effects(all) {
  return ev_deserialize(bytes, expect_sha, true, layers, heads, weights);
}

// Compute the canonical SHA-256 digest of the active W2.2 compiled-module bundle.
hxb_bundle_digest :: (
  s1: [32] u8, s2: [32] u8, s3: [32] u8, s4: [32] u8, s5: [32] u8
) -> [32] u8 #export_c #effects(all) {
  sha: [112] u8;
  out: [32] u8;
  #assert sha256_init(sha[..]) == SHA_OK;
  a1 := s1; a2 := s2; a3 := s3; a4 := s4; a5 := s5;
  #assert sha256_update_checked(sha[..], a1[..], false) == SHA_OK;
  #assert sha256_update_checked(sha[..], a2[..], false) == SHA_OK;
  #assert sha256_update_checked(sha[..], a3[..], false) == SHA_OK;
  #assert sha256_update_checked(sha[..], a4[..], false) == SHA_OK;
  #assert sha256_update_checked(sha[..], a5[..], false) == SHA_OK;
  #assert sha256_final_checked(sha[..], out[..], false) == SHA_OK;
  return out;
}

// Step a Ch 53 NxGrammar by raw byte slice; returns live next state >= 0, or -1 if disallowed.
hxb_grammar_step_bytes :: (g: NxGrammar, state: int, piece: [] u8) -> int #export_c #effects(all) {
  if state < 0 || state >= g.states || piece.count == 0 { return -1; }
  s := state;
  for i: 0..<piece.count {
    s = g.next[s * 256 + cast(int) piece[i]];
    if s < 0 { return -1; }
  }
  if g.live[s] != 1 { return -1; }
  return s;
}

hxb_grammar_accepting :: (g: NxGrammar, state: int) -> bool #export_c #effects(all) {
  if state < 0 || state >= g.states { return false; }
  return g.accepting[state] == 1;
}

// Parse a 64-char lowercase hex string into [32]u8; returns true on valid hex.
hxb_hex_to_sha :: (hex: [] u8, out: [] u8) -> bool #export_c #effects(all) {
  if hex.count != 64 || out.count < 32 { return false; }
  for i: 0..<32 {
    hi := hex[2 * i];
    lo := hex[2 * i + 1];
    vh := -1;
    vl := -1;
    if hi >= '0' && hi <= '9' { vh = cast(int) (hi - '0'); }
    else if hi >= 'a' && hi <= 'f' { vh = cast(int) (hi - 'a') + 10; }
    if lo >= '0' && lo <= '9' { vl = cast(int) (lo - '0'); }
    else if lo >= 'a' && lo <= 'f' { vl = cast(int) (lo - 'a') + 10; }
    if vh < 0 || vl < 0 { return false; }
    out[i] = cast(u8) ((vh << 4) | vl);
  }
  return true;
}

// Evaluate paired Base vs hybrid-exec-v1 benchmark results through Ch 239 (su_suite +
// hash-chained receipt store), Ch 240 (ns_floor + ns_boot), and Ch 241 (vd_decision,
// vd_probability, vd_evaluate).
hxb_eval_gates :: (
  base_runs: [] f64, n_runs: int, block_size: int,
  base_scores: [] f64, hyb_scores: [] f64,
  base_probs: [] f64, hyb_probs: [] f64, labels: [] f64,
  tasks: [] int, n_items: int,
  total_cost: f64, total_seconds: f64
) -> HxbGateReport #export_c #effects(all) {
  rep: HxbGateReport;
  if n_items < 1 || n_items > SU_ITEMS_MAX { return rep; }

  // 1. Ch 239 frozen three-digest suite + append-only chained receipt store
  items: [SU_ITEMS_MAX] SuItem;
  qs: [SU_ITEMS_MAX] string;
  part: [SU_ITEMS_MAX] int;
  for i: 0..<n_items {
    items[i] = SuItem.{id = "hx", kind = 1, task = tasks[i], partition = 0, state = "hybrid-exec-v1", gold = 1, abstain = -1};
    qs[i] = "exact-verify";
    part[i] = 0;
  }
  gate := SuGate.{kind = 1, clear = 40, min_tasks = 10, replicates = 1000, seed = 20261121, cost_limit = 10.0, seconds_limit = 600.0};
  suite := su_suite(items[0..<n_items], qs[0..<n_items], gate, 0);
  rep.suite_ok = suite.status == SuStatus.ok;
  rep.items_sha = suite.items;
  rep.questions_sha = suite.questions;
  rep.gate_sha = suite.gate;

  // Compute mean scores for suite receipts
  b_sum := 0.0;
  h_sum := 0.0;
  for i: 0..<n_items {
    b_sum += base_scores[i];
    h_sum += hyb_scores[i];
  }
  store: [4] SuReceipt;
  r_base := SuReceipt.{suite = suite, partition = 0, system = 1, read = 1, score = b_sum / f64(n_items), values = su_values(base_scores[0..<n_items])};
  r_hyb := SuReceipt.{suite = suite, partition = 0, system = 2, read = 1, score = h_sum / f64(n_items), values = su_values(hyb_scores[0..<n_items])};
  a1 := su_append(store[..], 0, r_base);
  a2 := su_append(store[..], a1.count, r_hyb);
  rep.chain_ok = a1.status == SuStatus.ok && a2.status == SuStatus.ok && su_verify(store[..], a2.count).status == SuStatus.ok;
  rep.compare_ok = su_compare(store[0], store[1]).status == SuStatus.ok;

  // 2. Ch 240 noise floor from repeated baseline seed blocks
  fl := ns_floor(base_runs[0..<n_runs * n_items], part[0..<n_items], 0, n_runs, block_size);
  rep.floor_status = fl.status;
  rep.floor_blocks = fl.blocks;
  rep.floor_sd = fl.sd;
  rep.floor_val = fl.floor;

  // 3. Ch 241 decision gate (paired whole-task bootstrap against measured noise floor)
  dec := vd_decision(base_scores[0..<n_items], hyb_scores[0..<n_items], tasks[0..<n_items], part[0..<n_items], 0, fl, 1.0, 20261121, 1000);
  rep.dec_status = dec.status;
  rep.dec_verdict = dec.result.verdict;
  rep.dec_reason = dec.result.reason;
  rep.dec_gain = dec.gain.gain;
  rep.dec_se = dec.gain.se;
  rep.dec_below = dec.gain.below;
  rep.dec_tasks = dec.gain.tasks;
  rep.dec_room = dec.room.room;

  // 4. Ch 241 probability gate (log loss + confident errors + ECE)
  pr := vd_probability(base_probs[0..<n_items], hyb_probs[0..<n_items], labels[0..<n_items], tasks[0..<n_items], 20261121, 1000);
  rep.prob_status = pr.status;
  rep.prob_verdict = pr.result.verdict;
  rep.prob_reason = pr.result.reason;
  rep.prob_loss_base = pr.loss[0];
  rep.prob_loss_hyb = pr.loss[1];
  rep.prob_err_base = pr.errors[0];
  rep.prob_err_hyb = pr.errors[1];
  rep.prob_ece_base = pr.ece[0];
  rep.prob_ece_hyb = pr.ece[1];

  // 5. Ch 241 evaluation gate (cost + wall-clock budget)
  ev := vd_evaluate(dec.result, total_cost, total_seconds, gate.cost_limit, gate.seconds_limit);
  rep.eval_verdict = ev.verdict;
  rep.eval_reason = ev.reason;
  return rep;
}
