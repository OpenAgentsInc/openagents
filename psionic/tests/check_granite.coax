// Granite 4.2 8B (issue #12870): binding, tokenizer and chat template on the CPU; the dense decoder
// on Metal against its CPU repeat; parity with the packaged llama.cpp (LLAMA_PREFIX, default
// /opt/homebrew) unless PSIONIC_GRANITE_PARITY=0. The pinned files live in PSIONIC_GRANITE_DIR
// (default ~/models/psionic/granite-4.2-8b-a7042144125c); without them only the owned tiny model
// runs. Nothing is downloaded.
//   coax/web/tool.sh psionic/tests/check_granite.coax [--mutate] [--jobs N]
// COAX (default coax/bin/coax) and COAX_CC (default cc) pick the compilers. The first step that
// fails ends the run with its status.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";

cxproc_self_path :: (out: [] u8) -> int #foreign #effects(all);
cxtool_out_flush :: () -> int #foreign #effects(all);

CG_KEEP :: 0;       // stdout passes through (prefixed)
CG_TAIL :: 1;       // only its last lines (prefixed)
CG_FILE :: 2;       // into a file
CG_NULL :: 3;       // dropped
CG_LINE :: 1048576;
CG_FLAGS :: [17] string.["-std=c11", "-O2", "-g", "-ffp-contract=off", "-fno-fast-math", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function", "-Wno-unused-parameter", "-Wno-unknown-pragmas", "-Wno-missing-field-initializers", "", "-Ipsionic/platform", "-DGRANITE_COAX_HEADER=\"host.h\"", "", ""];

// The run: where it is, its compilers, its work directory, its status, and the strings it makes
// (kept for its whole length).
W :: struct { b: [4194304] u8; n: int; repo: string; coax: string; cc: string; out: string; status: int; }
cat :: (w: [] W, parts: [] string) -> string {
  from := w[0].n;
  for p: parts { for c: p { w[0].b[w[0].n] = c; w[0].n += 1; } }
  return cast(string) w[0].b[from..<w[0].n];
}
cat2 :: (w: [] W, a: string, b: string) -> string { p := [2] string.[a, b]; return cat(w, p[..]); }
cat3 :: (w: [] W, a: string, b: string, c: string) -> string { p := [3] string.[a, b, c]; return cat(w, p[..]); }

// A command: its arguments, extra environment entries, where its stdout goes.
Cmd :: struct { args: [96] string; n: int; env: [8] string; ne: int; mode: int = CG_KEEP; tail: int = 1; prefix: string; file: string; }
arg :: (c: [] Cmd, s: string) { c[0].args[c[0].n] = s; c[0].n += 1; }
args_of :: (c: [] Cmd, list: [] string) { for s: list { arg(c, s); } }
env :: (c: [] Cmd, s: string) { c[0].env[c[0].ne] = s; c[0].ne += 1; }


say :: (s: string) { print("%\n", s); f := cxtool_out_flush(); }
say_err :: (s: string) { f := cxtool_out_flush(); tool_errln(s); }

// Runs a command from the repository's root; false (and the run's status set) when it fails.
run :: (w: [] W, c: [] Cmd) -> bool {
  h := proc_new();
  ok := h >= 0 && proc_cwd(h, w[0].repo) && proc_err_ours(h);
  if ok && c[0].mode == CG_FILE {
    // the shell only opens the file: exec "$@" > FILE
    ok = proc_arg(h, "/bin/sh") && proc_arg(h, "-c") && proc_arg(h, "f=$1; shift; exec \"$@\" > \"$f\"") && proc_arg(h, "sh") && proc_arg(h, c[0].file);
  }
  for i: 0..<c[0].n { ok = ok && proc_arg(h, c[0].args[i]); }
  for i: 0..<c[0].ne { ok = ok && proc_env(h, c[0].env[i]); }
  if !ok || proc_start(h) != 0 {
    say_err(cat2(w, "check_granite: can't run ", c[0].args[0]));
    if h >= 0 { r := proc_release(h); }
    w[0].status = 127; return false;
  }
  line: [CG_LINE] u8;
  keep: [4] [4096] u8; keep_n: [4] int; got := 0;
  while true {
    n := proc_line(h, -1, line[..]);
    if n == PROC_EOF || n == PROC_ERROR || n == PROC_TIMEOUT { break; }
    if n == PROC_TOO_LONG { continue; }
    if c[0].mode == CG_KEEP { print("%", c[0].prefix); print("%\n", cast(string) line[0..<n]); f := cxtool_out_flush(); }
    if c[0].mode == CG_TAIL {
      slot := got % 4; m := ifx n < 4096 then n else 4096;
      for i: 0..<m { keep[slot][i] = line[i]; }
      keep_n[slot] = m; got += 1;
    }
  }
  status := proc_wait(h, -1);
  d := proc_release(h);
  if c[0].mode == CG_TAIL {
    first := ifx got > c[0].tail then got - c[0].tail else 0;
    for k: first..<got { print("%", c[0].prefix); print("%\n", cast(string) keep[k % 4][0..<keep_n[k % 4]]); }
    f := cxtool_out_flush();
  }
  if status != 0 { w[0].status = ifx status < 0 then 1 else status; return false; }
  return true;
}

has :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for at: 0..<text.count - part.count + 1 { if text[at..<at + part.count] == part { return true; } }
  return false;
}
// Whether a file's bytes equal another's.
same_file :: (a: string, b: string) -> bool {
  x: [1048576] u8; y: [1048576] u8;
  n := fs_read(a, x[..]); m := fs_read(b, y[..]);
  if n < 0 || n != m || n >= x.count { return false; }
  for i: 0..<n { if x[i] != y[i] { return false; } }
  return true;
}
// The file's text (empty when unreadable).
text_of :: (path: string, buf: [] u8) -> string { n := fs_read(path, buf[..]); return ifx n > 0 && n <= buf.count then cast(string) buf[0..<n] else ""; }
// Its file name without the directory and the suffix.
base_of :: (path: string, suffix: string) -> string {
  b := fs_base(path);
  if b.count > suffix.count && b[b.count - suffix.count..<b.count] == suffix { return b[0..<b.count - suffix.count]; }
  return b;
}
done :: (w: [] W) -> int {
  if w[0].out.count > 0 { argv := [3] string.["/bin/rm", "-rf", w[0].out]; o: [16] u8; e: [16] u8; r := proc_run(argv[..], 60000, o[..], e[..]); }
  return w[0].status;
}

tool_main :: () -> int #export_c #effects(all) {
  wb: [1] W; w := wb[..];
  a: [1] Args;
  ok := args_load(a[..]);
  mutate := false; jobs := "4";
  i := 0;
  while ok && i < args_count(a[..]) {
    s := args_at(a[..], i);
    if s == "--mutate" { mutate = true; i += 1; }
    else if s == "--jobs" && i + 1 < args_count(a[..]) { jobs = args_at(a[..], i + 1); i += 2; }
    else { ok = false; }
  }
  if !ok { say_err("usage: check_granite.coax [--mutate] [--jobs N]"); return 2; }
  sb: [4096] u8; sn := cxproc_self_path(sb[..]);
  if sn <= 0 { say_err("check_granite: can't find this tool's own path"); return 1; }
  // the repository's root from this tool's own binary (ROOT/coax/web/build/tools/NAME-HASH, tool.sh)
  repo := cast(string) sb[0..<sn]; for k: 0..<5 { repo = fs_dir(repo); }
  w[0].repo = cat2(w, repo, "");
  eb: [4096] u8; cb: [4096] u8; mb: [4096] u8; hb: [4096] u8; lb: [4096] u8; pb: [64] u8;
  coax := proc_getenv("COAX", eb[..]); if coax.count == 0 { coax = cat2(w, repo, "/coax/bin/coax"); }
  cc := proc_getenv("COAX_CC", cb[..]); if cc.count == 0 { cc = "cc"; }
  w[0].coax = cat2(w, coax, ""); w[0].cc = cat2(w, cc, "");
  model := proc_getenv("PSIONIC_GRANITE_DIR", mb[..]);
  if model.count == 0 { model = cat2(w, proc_getenv("HOME", hb[..]), "/models/psionic/granite-4.2-8b-a7042144125c"); }
  ggufs: [2] string; ng := 0;
  if fs_exists(cat2(w, model, "/SHA256SUMS")) {
    for q: [2] string.["Q4_K_M", "Q8_0"] {
      f := cat2(w, cat2(w, cat2(w, model, "/gguf-93f3f6a8938e/granite-4.2-8b-"), q), ".gguf");
      if fs_exists(f) { ggufs[ng] = f; ng += 1; }
    }
  }
  ob: [FS_PATH_MAX] u8; w[0].out = cat2(w, fs_temp("psionic-granite.", ob[..]), "");
  if w[0].out.count == 0 { say_err("check_granite: can't make a work directory"); return 1; }
  out := w[0].out;
  F := "psionic/fixtures/granite";
  tool := cat2(w, repo, "/coax/web/tool.sh");

  // The owned fixtures: the tiny model's header, the Unicode classes, the text cases.
  { c: [1] Cmd; c[0].mode = CG_FILE; c[0].file = cat2(w, out, "/tiny.coax"); arg(c[..], "python3"); arg(c[..], "-I"); arg(c[..], "psionic/tests/granite_fixture.py"); arg(c[..], "--coax");
    if !run(w, c[..]) { return done(w); }
    if !same_file(c[0].file, cat2(w, F, "/tiny.coax")) { say(cat3(w, "- ", F, "/tiny.coax differ")); w[0].status = 1; return done(w); } }
  { c: [1] Cmd; c[0].mode = CG_FILE; c[0].file = cat2(w, out, "/unicode.coax"); arg(c[..], "python3"); arg(c[..], "-I"); arg(c[..], "psionic/tests/granite_unicode.py");
    if !run(w, c[..]) || !same_file(c[0].file, cat2(w, F, "/unicode.coax")) { w[0].status = 0; say("note: this Python's Unicode tables differ from the recorded ones"); } }
  { c: [1] Cmd; arg(c[..], tool); arg(c[..], "psionic/tests/granite_text.coax"); arg(c[..], "--cases"); arg(c[..], cat2(w, out, "/cases.bin")); if !run(w, c[..]) { return done(w); } }

  // Steps 1-3: binding, tokenizer and chat, in Coax and natively.
  for unit: [3] string.["model", "tokenizer", "chat"] { for mode: [2] string.["debug", "release"] {
    c: [1] Cmd; c[0].mode = CG_TAIL;
    arg(c[..], coax); arg(c[..], "test"); arg(c[..], cat3(w, "psionic/lib/granite/", unit, ".coax")); arg(c[..], "--run-steps"); arg(c[..], "200000000");
    if mode == "release" { arg(c[..], "--release"); }
    if !run(w, c[..]) { return done(w); }
  } }
  for mode: [2] string.["debug", "release"] {
    opt := ifx mode == "release" then "-O2" else "-O0";
    { c: [1] Cmd; c[0].mode = CG_FILE; c[0].file = cat3(w, out, "/chat-", cat2(w, mode, ".c"));
      arg(c[..], coax); arg(c[..], "c"); arg(c[..], "psionic/lib/granite/chat.coax"); arg(c[..], "--library"); arg(c[..], "--header"); arg(c[..], cat2(w, out, "/chat.h")); arg(c[..], "--run-steps"); arg(c[..], "200000000");
      if mode == "release" { arg(c[..], "--release"); }
      if !run(w, c[..]) { return done(w); } }
    for kind: [2] string.["plain", "sanitized"] {
      bin := cat2(w, cat2(w, cat2(w, cat2(w, cat2(w, out, "/text-"), mode), "-"), kind), "");
      c: [1] Cmd;
      arg(c[..], cc); arg(c[..], "-std=c11"); arg(c[..], opt); arg(c[..], "-g"); arg(c[..], "-ffp-contract=off"); arg(c[..], "-fno-fast-math"); arg(c[..], "-Wall"); arg(c[..], "-Wextra"); arg(c[..], "-Werror"); arg(c[..], "-Wno-unused-function"); arg(c[..], "-Wno-unused-parameter"); arg(c[..], "-Wno-unknown-pragmas");
      if kind == "sanitized" { arg(c[..], "-fsanitize=address,undefined"); arg(c[..], "-fno-omit-frame-pointer"); }
      arg(c[..], cat2(w, "-I", out)); arg(c[..], "-Ipsionic/platform"); arg(c[..], "-DGRANITE_COAX_HEADER=\"chat.h\""); arg(c[..], cat3(w, out, "/chat-", cat2(w, mode, ".c"))); arg(c[..], "psionic/platform/granite-file.c"); arg(c[..], "psionic/tests/granite_text.c"); arg(c[..], "-lm"); arg(c[..], "-o"); arg(c[..], bin);
      if !run(w, c[..]) { return done(w); }
      for g: 0..<ng {
        f := ggufs[g];
        t: [1] Cmd; t[0].mode = CG_FILE; t[0].file = cat2(w, out, "/text.out");
        env(t[..], "ASAN_OPTIONS=detect_leaks=0:halt_on_error=1"); env(t[..], "UBSAN_OPTIONS=halt_on_error=1");
        arg(t[..], bin); arg(t[..], f); arg(t[..], cat2(w, out, "/cases.bin"));
        if !run(w, t[..]) { return done(w); }
        k: [1] Cmd; k[0].prefix = cat2(w, cat2(w, cat2(w, cat2(w, cat2(w, cat2(w, base_of(f, ".gguf"), " "), mode), " "), kind), ": "), "");
        arg(k[..], tool); arg(k[..], "psionic/tests/granite_text.coax"); arg(k[..], "--check"); arg(k[..], t[0].file); arg(k[..], model); arg(k[..], f);
        if !run(w, k[..]) { return done(w); }
      }
    }
  }

  // Step 4: the kernels against binary64, then the decoder on Metal against its CPU repeat (the
  // owned tiny model, then the pinned files).
  for unit: [2] string.["psionic/tests/granite-kernel-checks.coax", "psionic/lib/granite/host.coax"] { for mode: [2] string.["debug", "release"] {
    c: [1] Cmd; c[0].mode = CG_TAIL;
    arg(c[..], coax); arg(c[..], "test"); arg(c[..], unit); arg(c[..], "--run-steps"); arg(c[..], "200000000");
    if mode == "release" { arg(c[..], "--release"); }
    if !run(w, c[..]) { return done(w); }
  } }
  metal := cat2(w, out, "/k.metal"); runner := cat2(w, out, "/granite-run");
  { c: [1] Cmd; c[0].mode = CG_FILE; c[0].file = metal; arg(c[..], coax); arg(c[..], "metal-compute"); arg(c[..], "psionic/lib/granite/kernels.coax"); arg(c[..], "--release"); if !run(w, c[..]) { return done(w); } }
  { c: [1] Cmd; c[0].mode = CG_FILE; c[0].file = cat2(w, out, "/host.c"); arg(c[..], coax); arg(c[..], "c"); arg(c[..], "psionic/lib/granite/host.coax"); arg(c[..], "--library"); arg(c[..], "--release"); arg(c[..], "--header"); arg(c[..], cat2(w, out, "/host.h")); if !run(w, c[..]) { return done(w); } }
  { c: [1] Cmd; arg(c[..], cc); for x: 0..<12 { arg(c[..], CG_FLAGS[x]); } arg(c[..], cat2(w, "-I", out)); for x: 13..<15 { arg(c[..], CG_FLAGS[x]); }
    arg(c[..], "-c"); arg(c[..], cat2(w, out, "/host.c")); arg(c[..], "-o"); arg(c[..], cat2(w, out, "/host.o")); if !run(w, c[..]) { return done(w); } }
  { c: [1] Cmd; arg(c[..], cc); arg(c[..], "-fobjc-arc"); arg(c[..], "-mmacosx-version-min=15.0"); arg(c[..], "-O2"); arg(c[..], "-Wall"); arg(c[..], "-Wextra"); arg(c[..], "-c"); arg(c[..], "psionic/platform/metal-host.m"); arg(c[..], "-o"); arg(c[..], cat2(w, out, "/metal-host.o")); if !run(w, c[..]) { return done(w); } }
  { c: [1] Cmd; arg(c[..], cc); for x: 0..<12 { arg(c[..], CG_FLAGS[x]); } arg(c[..], cat2(w, "-I", out)); for x: 13..<15 { arg(c[..], CG_FLAGS[x]); }
    arg(c[..], "-fblocks"); arg(c[..], "psionic/platform/granite-file.c"); arg(c[..], "psionic/platform/granite-metal.c"); arg(c[..], "psionic/tests/granite_run.c"); arg(c[..], cat2(w, out, "/host.o")); arg(c[..], cat2(w, out, "/metal-host.o")); arg(c[..], "-framework"); arg(c[..], "Metal"); arg(c[..], "-framework"); arg(c[..], "Foundation"); arg(c[..], "-lm"); arg(c[..], "-o"); arg(c[..], runner);
    if !run(w, c[..]) { return done(w); } }
  tiny := cat2(w, out, "/tiny.gguf");
  { c: [1] Cmd; arg(c[..], "python3"); arg(c[..], "-I"); arg(c[..], "psionic/tests/granite_fixture.py"); arg(c[..], "--gguf"); arg(c[..], tiny); if !run(w, c[..]) { return done(w); } }
  { c: [1] Cmd; c[0].mode = CG_TAIL; arg(c[..], runner); arg(c[..], tiny); arg(c[..], metal); arg(c[..], "compare"); arg(c[..], "--raw"); arg(c[..], "--prompt"); arg(c[..], "hello world hello"); arg(c[..], "--steps"); arg(c[..], "8"); arg(c[..], "--capacity"); arg(c[..], "512"); if !run(w, c[..]) { return done(w); } }
  // Past 8 tokens the prompt takes the prefill products and attention; compare also holds it
  // within 1e-3 of the decoder fed a token at a time.
  long := "hello world hello hello world hello world hello world hello";
  { c: [1] Cmd; c[0].mode = CG_TAIL; c[0].tail = 2; arg(c[..], runner); arg(c[..], tiny); arg(c[..], metal); arg(c[..], "compare"); arg(c[..], "--raw"); arg(c[..], "--prompt"); arg(c[..], long); arg(c[..], "--steps"); arg(c[..], "8"); arg(c[..], "--capacity"); arg(c[..], "512"); if !run(w, c[..]) { return done(w); } }
  { c: [1] Cmd; c[0].mode = CG_TAIL; c[0].prefix = "chunks of 13: "; env(c[..], "GRANITE_CHUNK=13");
    arg(c[..], runner); arg(c[..], tiny); arg(c[..], metal); arg(c[..], "compare"); arg(c[..], "--raw"); arg(c[..], "--prompt"); arg(c[..], long); arg(c[..], "--steps"); arg(c[..], "8"); arg(c[..], "--capacity"); arg(c[..], "512"); if !run(w, c[..]) { return done(w); } }
  for g: 0..<ng {
    f := ggufs[g]; q := base_of(f, ".gguf"); qp := cat2(w, q, ": ");
    { c: [1] Cmd; c[0].mode = CG_TAIL; c[0].tail = 2; c[0].prefix = qp;
      arg(c[..], runner); arg(c[..], f); arg(c[..], metal); arg(c[..], "compare"); arg(c[..], "--prompt"); arg(c[..], "Move the oak tree"); arg(c[..], "--steps"); arg(c[..], "2"); arg(c[..], "--capacity"); arg(c[..], "512"); if !run(w, c[..]) { return done(w); } }
    answer := cat2(w, out, "/answer.txt");
    { c: [1] Cmd; c[0].mode = CG_FILE; c[0].file = answer;
      arg(c[..], runner); arg(c[..], f); arg(c[..], metal); arg(c[..], "generate"); arg(c[..], "--prompt"); arg(c[..], "What is the capital of France? Answer in one sentence."); arg(c[..], "--steps"); arg(c[..], "24"); arg(c[..], "--capacity"); arg(c[..], "1024"); if !run(w, c[..]) { return done(w); } }
    ab: [1048576] u8; text := text_of(answer, ab[..]);
    if !has(text, "Paris") { say_err(cat2(w, q, ": the answer does not name Paris")); f2 := cxtool_out_flush(); tool_err(text); w[0].status = 1; return done(w); }
    tail_lines(text, 2, qp);
    // Tool calling: the model calls get_weather in the template's format, the result goes back
    // as a tool turn, and the answer uses it.
    tools := cat2(w, out, "/tools.txt");
    { c: [1] Cmd; c[0].mode = CG_FILE; c[0].file = tools;
      arg(c[..], runner); arg(c[..], f); arg(c[..], metal); arg(c[..], "tools"); arg(c[..], "--tools"); arg(c[..], "psionic/fixtures/granite/tools.jsonl"); arg(c[..], "--prompt"); arg(c[..], "What's the weather in Paris right now?"); arg(c[..], "--steps"); arg(c[..], "64"); arg(c[..], "--capacity"); arg(c[..], "1024"); arg(c[..], "--result"); arg(c[..], "{\"sky\": \"light rain\", \"temp_c\": 11}");
      if !run(w, c[..]) { return done(w); } }
    tbuf: [1048576] u8; tt := text_of(tools, tbuf[..]);
    if !has_line(tt, "call 0: get_weather(city=Paris)") { say_err(cat2(w, q, ": no get_weather(city=Paris) call")); tool_err(tt); w[0].status = 1; return done(w); }
    if !has(after_turn2(tt), "11") { say_err(cat2(w, q, ": the answer does not use the tool's result")); tool_err(tt); w[0].status = 1; return done(w); }
    say(cat2(w, q, ": tool call get_weather(city=Paris), and the answer uses its result"));
  }

  // Step 5: parity with the packaged llama.cpp (a reference, never a runtime dependency): token
  // ids, every layer's residual stream, full logits and a greedy continuation, with the prompt
  // fed a token at a time.
  llama := proc_getenv("LLAMA_PREFIX", lb[..]); if llama.count == 0 { llama = "/opt/homebrew"; }
  parity := proc_getenv("PSIONIC_GRANITE_PARITY", pb[..]); if parity.count == 0 { parity = "1"; }
  header := fs_exists(cat2(w, llama, "/include/llama.h"));
  if ng > 0 && parity == "1" && !header { say(cat3(w, "SKIP: parity: no llama.h in ", llama, " (set LLAMA_PREFIX)")); }
  if ng > 0 && parity == "1" && header {
    ll := cat2(w, out, "/granite-llama");
    { c: [1] Cmd; arg(c[..], cc); arg(c[..], "-std=c11"); arg(c[..], "-O2"); arg(c[..], "-Wall"); arg(c[..], "-Wextra"); arg(c[..], cat3(w, "-I", llama, "/include")); arg(c[..], "psionic/tests/granite_llama.c"); arg(c[..], cat3(w, "-L", llama, "/lib")); arg(c[..], "-lllama"); arg(c[..], "-lggml"); arg(c[..], "-lggml-base"); arg(c[..], cat3(w, "-Wl,-rpath,", llama, "/lib")); arg(c[..], "-o"); arg(c[..], ll);
      if !run(w, c[..]) { return done(w); } }
    for g: 0..<ng {
      f := ggufs[g]; qp := cat2(w, base_of(f, ".gguf"), ": ");
      ps := cat2(w, out, "/ps.bin"); lls := cat2(w, out, "/ll.bin");
      { c: [1] Cmd; c[0].mode = CG_NULL;
        arg(c[..], runner); arg(c[..], f); arg(c[..], metal); arg(c[..], "dump"); arg(c[..], "--prompt"); arg(c[..], "Move the oak tree two meters to the left of the well."); arg(c[..], "--steps"); arg(c[..], "16"); arg(c[..], "--capacity"); arg(c[..], "1024"); arg(c[..], "--out"); arg(c[..], ps); if !run(w, c[..]) { return done(w); } }
      ids := dump_ids(w, ps);
      if ids.count == 0 { say_err("check_granite: can't read the token ids of the dump"); w[0].status = 1; return done(w); }
      { c: [1] Cmd; c[0].mode = CG_NULL; env(c[..], "GRANITE_LLAMA_ONE=1"); arg(c[..], ll); arg(c[..], f); arg(c[..], ids); arg(c[..], "16"); arg(c[..], lls); if !run(w, c[..]) { return done(w); } }
      { c: [1] Cmd; c[0].prefix = qp; arg(c[..], tool); arg(c[..], "psionic/tests/granite_parity.coax"); arg(c[..], ps); arg(c[..], lls); arg(c[..], "--require"); if !run(w, c[..]) { return done(w); } }
    }
  }
  if ng == 0 { say(cat3(w, "SKIP: no pinned Granite files in ", model, "; only owned checks ran")); }
  if mutate {
    for unit: [4] string.["model", "tokenizer", "chat", "host"] {
      c: [1] Cmd; arg(c[..], coax); arg(c[..], "mutate"); arg(c[..], cat3(w, "psionic/lib/granite/", unit, ".coax")); arg(c[..], "--root-only"); arg(c[..], "--jobs"); arg(c[..], jobs); arg(c[..], "--run-steps"); arg(c[..], "200000000");
      if !run(w, c[..]) { return done(w); }
    }
  }
  return done(w);
}

// The last k lines of text, each after prefix (tail -k | sed).
tail_lines :: (text: string, k: int, prefix: string) {
  end := text.count; if end > 0 && text[end - 1] == '\n' { end -= 1; }
  start := end; seen := 0;
  while start > 0 { if text[start - 1] == '\n' { seen += 1; if seen == k { break; } } start -= 1; }
  at := start;
  for i: start..<end + 1 { if i == end || text[i] == '\n' { print("%", prefix); print("%\n", text[at..<i]); at = i + 1; } }
  f := cxtool_out_flush();
}
// Whether a line of text is exactly line (grep -qx).
has_line :: (text: string, line: string) -> bool {
  at := 0;
  for i: 0..<text.count + 1 { if i == text.count || text[i] == '\n' { if text[at..<i] == line { return true; } at = i + 1; } }
  return false;
}
// The text from the first line starting "turn 2" on (sed -n '/^turn 2/,$p').
after_turn2 :: (text: string) -> string {
  at := 0;
  for i: 0..<text.count + 1 {
    if i == text.count || text[i] == '\n' { l := text[at..<i]; if l.count >= 6 && l[0..<6] == "turn 2" { return text[at..<text.count]; } at = i + 1; }
  }
  return "";
}
// A dump's token ids joined by commas (n at byte 0, the ids from byte 40, i64 each).
dump_ids :: (w: [] W, path: string) -> string {
  h: [8] u8;
  if fs_read_at(path, 0, h[..]) != 8 { return ""; }
  n := 0; for i: 0..<8 { n = n | (cast(int) h[i] << (8 * i)); }
  if n < 1 || n > 65536 { return ""; }
  b: [524288] u8;
  if fs_read_at(path, 40, b[0..<8 * n]) != 8 * n { return ""; }
  from := w[0].n;
  for k: 0..<n {
    v := 0; for i: 0..<8 { v = v | (cast(int) b[8 * k + i] << (8 * i)); }
    if k > 0 { w[0].b[w[0].n] = ','; w[0].n += 1; }
    digits: [24] u8; m := 0; neg := v < 0; if neg { v = -v; }
    while true { digits[m] = cast,trunc(u8) ('0' + v % 10); m += 1; v /= 10; if v == 0 { break; } }
    if neg { w[0].b[w[0].n] = '-'; w[0].n += 1; }
    while m > 0 { m -= 1; w[0].b[w[0].n] = digits[m]; w[0].n += 1; }
  }
  return cast(string) w[0].b[from..<w[0].n];
}
