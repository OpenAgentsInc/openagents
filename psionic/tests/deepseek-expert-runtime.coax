#load "../lib/deepseek/expert.coax";
#load "../lib/model-io/identity.coax";
#load "../lib/deepseek/router.coax";
#load "../fixtures/deepseek/expert-original-targets.coax";
DeFixture :: enum u8 {routed0;routed1;routed2;shared;wide;}
// Test-only owned DATA constructors; public execution still validates descriptors.
de_test_fixture :: (which:DeFixture,bytes:[]u8)->DeExpert #export_c {
    if which==DeFixture.routed0 {return de_fixture_0(bytes);}if which==DeFixture.routed1 {return de_fixture_1(bytes);}if which==DeFixture.routed2 {return de_fixture_2(bytes);}if which==DeFixture.shared {return de_fixture_3(bytes);}return de_fixture_4(bytes);
}
de_test_original_pin :: ()->DsArtifact #export_c {return DE_ORIGINAL_PIN;}
// Test-only borrowing of reviewed intervals, after the host calls pw_digest.
de_test_original :: (data:[]u8,shared:bool)->DeExpert #export_c {
    matrices:[3]DeMatrix;begin:=ifx shared then 3 else 0;
    for i:0..<3 {s:=DE_ORIGINAL_MATRICES[begin+i];matrices[i]=DeMatrix.{kind=s.kind,rows=s.rows,columns=s.columns,data=data[s.data_begin..<s.data_end],scales=data[s.scale_begin..<s.scale_end]};}
    return DeExpert.{gate=matrices[0],up=matrices[1],down=matrices[2]};
}
de_test_original_input :: (out:[]f32)->int #export_c {
    for i:0..<5120 {out[i]=f32((i*17)%29-14)/8;}return 5120;
}
de_test_original_all :: (data:[]u8,out:[]DeExpert)->int #export_c {
    for id:0..<384 {m:[3]DeMatrix;for j:0..<3 {s:=DE_ORIGINAL_ALL[3*id+j];m[j]=DeMatrix.{kind=s.kind,rows=s.rows,columns=s.columns,data=data[s.data_begin..<s.data_end],scales=data[s.scale_begin..<s.scale_end]};}out[id]=DeExpert.{gate=m[0],up=m[1],down=m[2]};}return 384;
}
de_test_original_route :: (data:[]u8,x:[]f32,logits:[]f32,stage:[]f32,raw:[]f64,ranked:[]f64)->DrRoute #export_c {
    w:=DE_ORIGINAL_GATE_WEIGHT;b:=DE_ORIGINAL_GATE_BIAS;r:=qm_project(QmDtype.bf16,384,5120,data[w[0]..<w[1]],x,logits,stage,false);#assert r.status==QmStatus.ok;
    bias:[384]f32;for i:0..<384 {bias[i]=f32_from_bits(qm_bits(QmDtype.f32,data[b[0]..<b[1]],i));}
    return dr_route(DrConfig.{profile=DrProfile.v41,k=6,scale=1.5},logits,bias[..],raw,ranked,false);
}
de_test_route_values :: (route:DrRoute,ids:[]int,weights:[]f32)->int #export_c {
    for i:0..<route.count {ids[i]=route.ids[i];weights[i]=f32(route.weights[i]);}return route.count;
}
