// Chapter 42's device harness, the Coax side: the plan and kernels, chapter
// 11's recurrence and chapter 42's CPU chunked profile over packed inputs,
// the unpacking of those inputs into chapter 44's device layouts, and, for
// the original-weight check, one Elephant linear layer's norm and
// projections that pack a hidden row the way ql_step does. C (psionic/tests/
// delta_chunks_device.c) only maps files, moves bytes and launches.
#load "elephant-slices-runtime.coax";
#load "../lib/device/delta-chunks-plan.coax";

// Chapter 11's packed inputs for `tokens` tokens into the device layouts:
// mixed[t*c + i], the convolution weights (4 per channel), a and b [t*h + i],
// A_log and dt_bias per head (from token 0), z [t*v + i] and gamma.
dkr_unpack :: (key_heads:int,heads:int,tokens:int,rows:[]f32,mixed:[]f32,weight:[]f32,a:[]f32,b:[]f32,a_log:[]f32,dt:[]f32,z:[]f32,gamma:[]f32) #export_c {
    s:=PdShape.{key_heads=key_heads,value_heads=heads,key_dim=128,value_dim=128,epsilon=0.000001f32};
    c:=pd_channels(s);m:=pd_input_count(s);v:=heads*128;
    aoff:=5*c;boff:=aoff+heads;logoff:=boff+heads;dtoff:=logoff+heads;zoff:=dtoff+heads;gammaoff:=zoff+v;
    for i:0..<4*c {weight[i]=rows[c+i];}
    for i:0..<heads {a_log[i]=rows[logoff+i];dt[i]=rows[dtoff+i];}
    for i:0..<128 {gamma[i]=rows[gammaoff+i];}
    for t:0..<tokens {
        row:=rows[t*m..<(t+1)*m];
        for i:0..<c {mixed[t*c+i]=row[i];}
        for i:0..<heads {a[t*heads+i]=row[aoff+i];b[t*heads+i]=row[boff+i];}
        for i:0..<v {z[t*v+i]=row[zoff+i];}
    }
}
dkr_shape :: (key_heads:int,heads:int)->PdShape {return PdShape.{key_heads=key_heads,value_heads=heads,key_dim=128,value_dim=128,epsilon=0.000001f32};}
dkr_input_count :: (key_heads:int,heads:int)->int #export_c {return pd_input_count(dkr_shape(key_heads,heads));}
dkr_work_count :: (key_heads:int,heads:int,chunk:int)->int #export_c {return dk_work_count(dkr_shape(key_heads,heads),chunk);}
// Chapter 11's recurrence from the zero state over every token: outputs
// [t*v + i] and the final state in chapter 11's layout. The status.
dkr_step_work :: (key_heads:int,heads:int)->int #export_c {return pd_work_count(dkr_shape(key_heads,heads));}
dkr_recurrence :: (key_heads:int,heads:int,tokens:int,rows:[]f32,out:[]f32,history:[]f32,state:[]f32,work:[]f32)->int #export_c {
    s:=dkr_shape(key_heads,heads);m:=pd_input_count(s);v:=heads*128;
    for i:0..<history.count {history[i]=0;}for i:0..<state.count {state[i]=0;}
    for t:0..<tokens {
        r:=pd_step(s,rows[t*m..<(t+1)*m],history,state,out[t*v..<(t+1)*v],work,false);
        if r.status!=PdStatus.ok {return cast(int)r.status;}
    }
    return 0;
}
// Chapter 42's CPU chunked profile from the zero state. The status.
dkr_chunked :: (key_heads:int,heads:int,tokens:int,chunk:int,rows:[]f32,out:[]f32,history:[]f32,state:[]f32,work:[]f64)->int #export_c {
    s:=dkr_shape(key_heads,heads);
    for i:0..<history.count {history[i]=0;}for i:0..<state.count {state[i]=0;}
    r:=dk_prefill(s,tokens,chunk,rows,history,state,out,state[0..<0],work[0..<dk_work_count(s,chunk)],false);
    return cast(int)r.status;
}

// One linear layer's input norm and projections of `tokens` hidden rows
// x[t*d ...], packed as chapter 11's inputs exactly as ql_step packs them.
// work: d + c + d f32. The first refusing projection's status, else 0.
dkr_pack_work :: (s:QlShape)->int #export_c {return 2*s.width+pd_channels(s.delta);}
dkr_pack :: (s:QlShape,w:QlWeights,x:[]f32,tokens:int,rows:[]f32,work:[]f32)->int #export_c {
    d:=s.width;c:=pd_channels(s.delta);m:=pd_input_count(s.delta);v:=s.delta.value_heads*s.delta.value_dim;h:=s.delta.value_heads;
    aoff:=5*c;boff:=aoff+h;logoff:=boff+h;dtoff:=logoff+h;zoff:=dtoff+h;gammaoff:=zoff+v;
    norm:=work[0..<d];temp:=work[d..<2*d+c];
    for t:0..<tokens {
        packed:=rows[t*m..<(t+1)*m];
        r:=qb_begin(d,s.delta.epsilon,x[t*d..<(t+1)*d],w.input_norm,norm,temp[0..<d],false);if r.status!=QmStatus.ok {return 100+cast(int)r.status;}
        r=qm_project(s.dtype,c,d,w.qkv,norm,packed[0..<c],temp,false);if r.status!=QmStatus.ok {return 200+cast(int)r.status;}
        for i:0..<4*c {packed[c+i]=w.conv[i];}
        for i:0..<h {packed[logoff+i]=w.a_log[i];packed[dtoff+i]=w.dt[i];}
        for i:0..<s.delta.value_dim {packed[gammaoff+i]=w.delta_norm[i];}
        r=qm_project(s.dtype,h,d,w.a,norm,packed[aoff..<aoff+h],temp,false);if r.status!=QmStatus.ok {return 300+cast(int)r.status;}
        r=qm_project(s.dtype,h,d,w.b,norm,packed[boff..<boff+h],temp,false);if r.status!=QmStatus.ok {return 400+cast(int)r.status;}
        r=qm_project(s.dtype,v,d,w.z,norm,packed[zoff..<zoff+v],temp,false);if r.status!=QmStatus.ok {return 500+cast(int)r.status;}
    }
    return 0;
}

// The C build of chapter 44's linear-layer core with dkd_chunk in place of
// dl_scan, from packed inputs, against chapter 11's recurrence and chapter
// 42's CPU profile, at Elephant's key and value width 128.
#test "the device layer core equals chapter 11's recurrence at width 128" #steps 2000000000 {
    kh:=1;h:=2;T:=9;s:=dkr_shape(kh,h);m:=pd_input_count(s);c:=pd_channels(s);
    rows:[26568]f32;#assert m==2952 && c==512;
    for t:0..<T {for i:0..<m {rows[t*m+i]=dkd_value(i*3+t*7)/2;}}
    // The layer's own parameters are the same for every token: convolution
    // weights, A_log (-2 and -4: each token keeps most of the state), dt
    // and gamma.
    for i:0..<c {rows[c+4*i+3]=0.75;}
    rows[5*c+2*h]= -2;rows[5*c+2*h+1]= -4;
    for t:1..<T {
        for i:c..<5*c {rows[t*m+i]=rows[i];}
        for i:5*c+2*h..<5*c+4*h {rows[t*m+i]=rows[i];}
        for i:m-128..<m {rows[t*m+i]=rows[i];}
    }
    mixed:[9*512]f32;weight:[2048]f32;a:[18]f32;b:[18]f32;alog:[2]f32;dt:[2]f32;z:[9*256]f32;gamma:[128]f32;
    dkr_unpack(kh,h,T,rows[..],mixed[..],weight[..],a[..],b[..],alog[..],dt[..],z[..],gamma[..]);
    conv:[9*512]f32;q:[9*128]f32;k:[9*128]f32;beta:[18]f32;decay:[18]f32;draft:[9*256]f32;out:[9*256]f32;state:[32768]f32;
    for i:0..<c {dl_conv(i,c,T,mixed[..],weight[..],conv[..]);}
    for i:0..<T*h {dl_gates(i,h,a[..],b[..],alog[..],dt[..],beta[..],decay[..]);}
    for i:0..<T*kh {dl_qk(i,kh,128,c,conv[..],q[..],k[..]);}
    for g:0..<dkp_groups(h) {dkd_chunk(g,T,4,h,kh,c,conv[..],q[..],k[..],beta[..],decay[..],draft[..],state[..]);}
    for i:0..<T*h {dl_gate_norm(i,s.epsilon,draft[..],gamma[..],z[..],out[..]);}
    ref:[9*256]f32;history:[1536]f32;ref_state:[32768]f32;work:[35072]f32;#assert dkr_step_work(1,2)==35072;
    #assert dkr_recurrence(kh,h,T,rows[..],ref[..],history[..],ref_state[..],work[..])==0;
    worst:=dkp_worst(out[..],ref[..]);d:=abs(f64(out[worst])-f64(ref[worst]));
    sw:=dkp_worst(state[..],ref_state[..]);e:=abs(f64(state[sw])-f64(ref_state[sw]));
    #assert dkp_within(d,ref[..]) && dkp_within(e,ref_state[..]) && d<0.0001 && e<0.00001;
    big:=0.0;for x:ref {if abs(f64(x))>big {big=abs(f64(x));}}#assert big>0.1;
    cpu:[9*256]f32;cpu_state:[32768]f32;cw:[38468]f64;#assert dkr_work_count(1,2,4)==38468;
    #assert dkr_chunked(kh,h,T,4,rows[..],cpu[..],history[..],cpu_state[..],cw[..])==0;
    worst=dkp_worst(out[..],cpu[..]);#assert dkp_within(abs(f64(out[worst])-f64(cpu[worst])),cpu[..]);
}
