// Chapter 99's test oracle for gptoss/device-sample.coax: chapter 53's rule
// written out with a selection sort and no lists or merges. Plain
// procedures only, so the kernel file can load it and still compile to CUDA.
gso_sample :: (logits:[]f32,k:int,temperature:f64,top_p:f64,uniform:f64,order:[]int,p:[]f64)->int {
    n:=logits.count;
    for i:0..<n {order[i]=i;p[i]=0;}
    for i:0..<n {b:=i;for j:i+1..<n {x:=order[j];y:=order[b];if logits[x]>logits[y] || (logits[x]==logits[y] && x<y) {b=j;}}t:=order[i];order[i]=order[b];order[b]=t;}
    if temperature==0 {return order[0];}
    kept:=k;if kept>n {kept=n;}
    top:=f64(logits[order[0]]);total:=0.0;
    for i:0..<kept {v:=exp((f64(logits[order[i]])-top)/temperature);p[order[i]]=v;total+=v;}
    mass:=0.0;take:=0;
    while mass<top_p*total {mass+=p[order[take]];take+=1;}
    for i:0..<kept {if i<take {p[order[i]]/=mass;}else {p[order[i]]=0;}}
    running:=0.0;for i:0..<n {running+=p[i];if uniform<running {return i;}}
    last:=n-1;while p[last]==0 {last-=1;}return last;
}
gso_uniform :: (seed:u64,counter:u64)->f64 {return f64(gs_bits(seed,counter)>>11)/9007199254740992.0;}
