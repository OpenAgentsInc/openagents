// Chapter 160's check oracles and fixtures, loaded by psionic/lib/domino.coax:
// a tolerance test, tanh from the sinh and cosh series, A0 in closed form and
// by quadrature, the point features and a query's rows written as direct
// loops over every point and node, and a small encoded sphere.
dm_near :: (a:f64,b:f64,tol:f64)->bool {return abs(a-b)<=tol;}
dm_unit :: (seed:int,i:int)->f64 {return cr_draw(CrSeed.{seed=cast(u64)(seed+7000),counter=cast(u64)i}).value;}
dm_box :: ()->DmBox {return DmBox.{low=[3]f64.[-1.5,-1.5,-1.5],high=[3]f64.[1.5,1.5,1.5],side=8};}
dm_radii :: ()->DmRadii {return DmRadii.{geometry=[2]f64.[0.3,0.6],local=[2]f64.[0.5,0.9]};}
// tanh x = sinh x / cosh x, each from its Taylor series.
dm_tanh_series :: (x:f64)->f64 {
    s:=0.0;c:=0.0;term:=1.0;
    for k:0..<40 {c+=term;term*=x/f64(2*k+1);s+=term;term*=x/f64(2*k+2);}
    return s/c;
}
// The prolate spheroid's A0 from the logarithm, for e > 0.
dm_a0_closed :: (a:f64,b:f64)->f64 {e:=sqrt(1-b*b/(a*a));return (1-e*e)/(e*e*e)*(log((1+e)/(1-e))-2*e);}
// A0 = a b^2 times the integral over s >= 0 of ds / ((a^2 + s)^(3/2) (b^2 + s)).
// With s = a^2 (1 - u^2) / u^2 it is b^2 times the integral over [0, 1] of
// 2 u^2 / (a^2 + (b^2 - a^2) u^2), by Simpson's rule on 2,000 panels.
dm_a0_integral :: (a:f64,b:f64)->f64 {
    n:=2000;h:=1.0/f64(n);s:=0.0;
    for i:0..<n+1 {
        u:=f64(i)*h;f:=2*u*u/(a*a+(b*b-a*a)*u*u);
        w:=ifx i==0 || i==n then 1.0 else (ifx i%2==1 then 4.0 else 2.0);s+=w*f;
    }
    return b*b*s*h/3;
}
// A lower bound on the share of the spheroid's volume a level's mesh holds.
dm_volume_share :: (level:int)->f64 {shares:=[4]f64.[0.3,0.7,0.9,0.97];return shares[level];}
// The point features restated as a direct loop: every point within the
// radius, the nearest 64 by (squared distance, index), chosen by repeated
// minimum.
dm_nearest_direct :: (points:[]f64,q:[3]f64,r:f64,keep:int,out:[]int)->int {
    n:=points.count/3;count:=0;lastd:=-1.0;lasti:=-1;
    while count<keep {
        best:=-1;bd:=0.0;
        for i:0..<n {
            v:=fd_sub(fd_at(points,i),q);d:=fd_dot(v,v);
            if d>r*r {continue;}
            if d<lastd || (d==lastd && i<=lasti) {continue;}
            if best<0 || d<bd || (d==bd && i<best) {best=i;bd=d;}
        }
        if best<0 {break;}
        out[count]=best;count+=1;lastd=bd;lasti=best;
    }
    return count;
}
dm_point_features_direct :: (enc:DmEncoder,cloud:[]f64,q:[3]f64,radii:[2]f64,f:[]f64) {
    idx:[64]int;
    for s:0..<2 {
        count:=dm_nearest_direct(cloud,q,radii[s],64,idx[..]);
        for c:0..<4 {
            o:=s*4+c;sum:=0.0;
            for j:0..<count {
                z:=enc.b[o];for d:0..<3 {z+=enc.w[3*o+d]*((cloud[3*idx[j]+d]-q[d])/radii[s]);}
                sum+=dm_tanh(z);
            }
            f[o]=0;if count>0 {f[o]=sum/f64(count);}
        }
    }
}
dm_rows_direct :: (box:DmBox,radii:DmRadii,feat:[]f64,cloud:[]f64,normals:[]f64,q:[3]f64,qn:[3]f64,out:[]f64) {
    nodes:=box.side*box.side*box.side;at:[1536]f64;
    for i:0..<nodes {p:=dm_node(box,i);for d:0..<3 {at[3*i+d]=p[d];}}
    local:[18]f64;idx:[64]int;
    for t:0..<2 {
        count:=dm_nearest_direct(at[0..<3*nodes],q,radii.local[t],64,idx[..]);
        for c:0..<9 {
            sum:=0.0;for j:0..<count {sum+=feat[idx[j]*9+c];}
            local[t*9+c]=0;if count>0 {local[t*9+c]=sum/f64(count);}
        }
    }
    // The query itself, then its three nearest surface points.
    near:=dm_nearest_direct(cloud,q,1000,3,idx[..]);#assert near==3;
    total:=0.0;
    for j:0..<4 {
        x:=q;n:=qn;if j>0 {x=fd_at(cloud,idx[j-1]);n=fd_at(normals,idx[j-1]);}
        for d:0..<3 {out[j*25+d]=(x[d]-q[d])/radii.local[0];out[j*25+3+d]=n[d];}
        out[j*25+6]=sqrt(out[j*25]*out[j*25]+out[j*25+1]*out[j*25+1]+out[j*25+2]*out[j*25+2]);
        for c:0..<18 {out[j*25+7+c]=local[c];}
        v:=fd_sub(x,q);out[100+j]=1/(sqrt(fd_dot(v,v))+0.001);total+=out[100+j];
    }
    for j:0..<4 {out[100+j]/=total;}
}
// A sphere of radius 1/2 (level 2, 128 triangles), 64 surface points, and
// its encoding on a 4 x 4 x 4 grid over [-1, 1]^3.
DmSmall :: struct {box:DmBox;feat:[576]f64;cloud:[192]f64;normals:[192]f64;check:[104]f64;}
dm_scene_small :: ()->DmSmall {
    s:DmSmall;s.box=DmBox.{low=[3]f64.[-1,-1,-1],high=[3]f64.[1,1,1],side=4};
    v:[198]f64;t:[384]int;nv:=dm_spheroid(0.5,0.5,2,v[..],t[..]);#assert nv==66;
    m:=fd_mesh_admit(FdMesh.{vertices=v[..],triangles=t[..]});
    #assert fd_sample_surface(m,11,s.cloud[..],s.normals[..]).status==FdStatus.ok;
    #assert dm_encode(m,s.cloud[..],s.box,dm_radii(),dm_encoder(2),s.feat[..]).status==DmStatus.ok;
    return s;
}
