// Checks of psionic/lib/granite/kernels.coax on the CPU, against chapter 50
// and 51's decoders, their independent oracle vectors, and binary64 sums.
//   coax test psionic/tests/granite-kernel-checks.coax
#load "../lib/granite/kernels.coax";
#load "../lib/kquant.coax";

gr_words64 :: (b:[]u8,out:[]u64) {for i:0..<out.count {w:u64=0;for k:0..<8 {w|=cast(u64)b[8*i+k]<<cast(u64)(8*k);}out[i]=w;}}
gr_words16 :: (b:[]u8,out:[]u16) {for i:0..<out.count {out[i]=cast(u16)(cast(u32)b[2*i]|cast(u32)b[2*i+1]<<8);}}
// A deterministic byte stream for weights and activations.
gr_noise :: (seed:u64,i:int)->u64 {x:=add_wrap(mul_wrap(cast(u64)i,cast(u64)0x9e3779b97f4a7c15),seed);x=mul_wrap(x^(x>>29),cast(u64)0xbf58476d1ce4e5b9);return x^(x>>32);}

#forall "every binary16 decodes exactly as chapter 50's half" high:0..<64 {
    for low:0..<1024 {bits:=high*1024+low;e:=(bits>>10)&31;if e==31 {continue;}#assert f64(gr_half(cast(u32)bits))==qz_half(bits);}
}
#forall "f16 rounding: every finite half survives, and midpoints round to even" high:0..<64 #steps 100000000 {
    for low:0..<1024 {
        bits:=cast(u32)(high*1024+low);e:=(bits>>10)&31;if e==31 {continue;}
        #assert gr_f16(gr_half(bits))==bits || (bits==0x8000 && gr_f16(gr_half(bits))==0x8000);
        if (bits&0x3ff)!=0x3ff && e<30 {
            a:=f64(gr_half(bits));b:=f64(gr_half(bits+1));mid:=f32((a+b)/2);
            if f64(mid)==(a+b)/2 {want:=ifx (bits&1)==0 then bits else bits+1;#assert gr_f16(mid)==want;}
        }
    }
}
#test "f16 overflow, infinities, NaN and the smallest subnormals" {
    #assert gr_f16(65504)==0x7bff && gr_f16(65520)==0x7c00 && gr_f16(1.0e30f32)==0x7c00 && gr_f16(-1.0e30f32)==0xfc00;
    // Infinities and NaN cannot be built at compile time (E0412); the
    // native kernel harness checks them.
    #assert gr_f16(f32_from_bits(0x33000000))==0 && gr_f16(f32_from_bits(0x33000001))==1 && gr_f16(f32_from_bits(0x33800000))==1 && gr_f16(f32_from_bits(0x33c00000))==2 && gr_f16(f32_from_bits(0x34000000))==2 && gr_f16(f32_from_bits(0x32800000))==0;
    #assert gr_silu(0)==0 && gr_signed(255)== -1 && gr_signed(127)==127;
}
#test "Q4_K and Q6_K values equal chapter 51's oracle vectors bit for bit" {
    a:=KQV_Q4K_BYTES;c:=KQV_Q4K_BITS;w:[36]u64;gr_words64(a[..],w[..]);
    for k:0..<512 {#assert f32_bits(gr_q4k_value(w[k/256*18..<k/256*18+18],cast(u32)(k%256)))==c[k];}
    s:=KQV_Q6K_BYTES;e:=KQV_Q6K_BITS;h:[210]u16;gr_words16(s[..],h[..]);
    for k:0..<512 {#assert f32_bits(gr_q6k_value(h[k/256*105..<k/256*105+105],cast(u32)(k%256)))==e[k];}
}
#test "Q8_0 values equal chapter 50's decoder" {
    b:[68]u8;for i:0..<68 {b[i]=cast,trunc(u8)gr_noise(7,i);}b[1]=0x1c;b[35]=0x9d;
    y:[64]f32;#assert qz_decode(QZ_Q8_0,1,64,b[..],y[..]).status==QzStatus.ok;
    w:[34]u16;gr_words16(b[..],w[..]);
    for k:0..<64 {#assert gr_q8_value(w[k/32*17..<k/32*17+17],cast(u32)(k%32))==y[k];}
}

// Weights of `rows` by `cols` in each format, from noise with finite scales.
gr_fill :: (kind:int,rows:int,cols:int,b:[]u8) {
    for i:0..<b.count {b[i]=cast,trunc(u8)gr_noise(cast(u64)kind,i);}
    blocks:=rows*cols/PG_BLOCKS[kind];size:=PG_WIDTHS[kind];
    for k:0..<blocks {
        at:=k*size;
        if kind==12 {b[at+1]=0x1c;b[at+3]=0x18;}
        else if kind==14 {b[at+209]=0x14;}
        else {b[at+1]=0x20;}
    }
}
// The product of every format against binary64 sums of chapter 51's values:
// 5 rows (one partial group), 3 tokens, 2 columns of super-blocks.
#forall "every product kernel matches binary64 sums of decoded weights" format:0..<3 {
    kinds:=[3]int.[12,14,8];kind:=kinds[format];rows:=5;cols:=512;tokens:=3;
    b:[5280]u8;n:=rows*cols/PG_BLOCKS[kind]*PG_WIDTHS[kind];gr_fill(kind,rows,cols,b[0..<n]);
    values:[2560]f32;
    if kind==8 {#assert qz_decode(kind,rows,cols,b[0..<n],values[..]).status==QzStatus.ok;}else {#assert kq_decode(kind,rows,cols,b[0..<n],values[..]).status==QzStatus.ok;}
    x:[1536]f32;for i:0..<1536 {x[i]=f32(cast(int)(gr_noise(99,i)%2001)-1000)/1000;}
    out:[15]f32;for i:0..<15 {out[i]=1;}
    w64:[660]u64;w16:[2640]u16;gr_words64(b[0..<n-n%8],w64[0..<n/8]);gr_words16(b[0..<n],w16[0..<n/2]);
    for item:0..<2 {
        if kind==12 {gr_mv_q4k(item,rows,cols,tokens,1,w64[0..<n/8],x[..],out[..]);}
        else if kind==14 {gr_mv_q6k(item,rows,cols,tokens,1,w16[0..<n/2],x[..],out[..]);}
        else {gr_mv_q8(item,rows,cols,tokens,1,w16[0..<n/2],x[..],out[..]);}
    }
    for t:0..<tokens {for r:0..<rows {
        want:=1.0;scale:=0.0;for i:0..<cols {p:=f64(values[r*cols+i])*f64(x[t*cols+i]);want+=p;scale+=abs(p);}
        #assert abs(f64(out[t*rows+r])-want)<=0.000002*(1+scale);
    }}
}
// The decode kernels against binary64 sums: 11 rows (a partial group of 8),
// 1280 columns (a partial step of four super-blocks, or 32 Q8_0 blocks).
// gr_dv adds to the output; gr_dv3 writes prefixes of 11, 3 and 9 rows of
// the same weights; gr_dvglu uses them as gate and up, so it writes
// silu(g) * g.
#forall "every decode kernel matches binary64 sums of decoded weights" format:0..<3 #steps 400000000 {
    kinds:=[3]int.[12,14,8];kind:=kinds[format];rows:=11;cols:=1280;
    b:[14960]u8;n:=rows*cols/PG_BLOCKS[kind]*PG_WIDTHS[kind];gr_fill(kind,rows,cols,b[0..<n]);
    values:[14080]f32;
    if kind==8 {#assert qz_decode(kind,rows,cols,b[0..<n],values[..]).status==QzStatus.ok;}else {#assert kq_decode(kind,rows,cols,b[0..<n],values[..]).status==QzStatus.ok;}
    x:[1280]f32;for i:0..<1280 {x[i]=f32(cast(int)(gr_noise(98,i)%2001)-1000)/1000;}
    want:[11]f64;scale:[11]f64;
    for r:0..<rows {want[r]=0;scale[r]=0;for i:0..<cols {p:=f64(values[r*cols+i])*f64(x[i]);want[r]+=p;scale[r]+=abs(p);}}
    w64:[1870]u64;w16:[7480]u16;gr_words64(b[0..<n-n%8],w64[0..<n/8]);gr_words16(b[0..<n],w16[0..<n/2]);
    out:[11]f32;for i:0..<11 {out[i]=1;}
    for item:0..<2 {
        if kind==12 {gr_dv_q4k(item,rows,cols,1,w64[0..<n/8],x[..],out[..]);}
        else if kind==14 {gr_dv_q6k(item,rows,cols,1,w16[0..<n/2],x[..],out[..]);}
        else {gr_dv_q8(item,rows,cols,1,w16[0..<n/2],x[..],out[..]);}
    }
    for r:0..<rows {#assert abs(f64(out[r])-1-want[r])<=0.000002*(1+scale[r]);}
    oa:[11]f32;ob:[11]f32;oc:[11]f32;for i:0..<11 {oa[i]=7;ob[i]=7;oc[i]=7;}
    for item:0..<5 {
        if kind==12 {gr_dv3_q4k(item,11,3,9,cols,w64[0..<n/8],w64[0..<n/8],w64[0..<n/8],x[..],oa[..],ob[..],oc[..]);}
        else if kind==14 {gr_dv3_q6k(item,11,3,9,cols,w16[0..<n/2],w16[0..<n/2],w16[0..<n/2],x[..],oa[..],ob[..],oc[..]);}
        else {gr_dv3_q8(item,11,3,9,cols,w16[0..<n/2],w16[0..<n/2],w16[0..<n/2],x[..],oa[..],ob[..],oc[..]);}
    }
    for r:0..<rows {
        #assert abs(f64(oa[r])-want[r])<=0.000002*(1+scale[r]);
        if r<3 {#assert abs(f64(ob[r])-want[r])<=0.000002*(1+scale[r]);}else {#assert ob[r]==7;}
        if r<9 {#assert abs(f64(oc[r])-want[r])<=0.000002*(1+scale[r]);}else {#assert oc[r]==7;}
    }
    act:[11]f32;
    for item:0..<3 {
        if kind==12 {gr_dvglu_q4k(item,rows,cols,w64[0..<n/8],w64[0..<n/8],x[..],act[..]);}
        else if kind==14 {gr_dvglu_q6k(item,rows,cols,w16[0..<n/2],w16[0..<n/2],x[..],act[..]);}
        else {gr_dvglu_q8(item,rows,cols,w16[0..<n/2],w16[0..<n/2],x[..],act[..]);}
    }
    for r:0..<rows {g:=f64(oa[r]);#assert abs(f64(act[r])-g*g/(1+exp(-g)))<=0.00001*(1+g*g);}
}
#test "embedding rows decode the token's row" {
    b:[5280]u8;gr_fill(12,5,512,b[0..<1440]);values:[2560]f32;#assert kq_decode(12,5,512,b[0..<1440],values[..]).status==QzStatus.ok;
    w:[180]u64;gr_words64(b[0..<1440],w[..]);ids:=[2]int.[3,1];out:[1024]f32;
    for item:0..<1024 {gr_embed_q4k(item,512,ids[..],w[..],out[..]);}
    for i:0..<512 {#assert out[i]==values[3*512+i] && out[512+i]==values[512+i];}
    gr_fill(14,5,512,b[0..<2100]);#assert kq_decode(14,5,512,b[0..<2100],values[..]).status==QzStatus.ok;h:[1050]u16;gr_words16(b[0..<2100],h[..]);
    for item:0..<1024 {gr_embed_q6k(item,512,ids[..],h[..],out[..]);}for i:0..<512 {#assert out[i]==values[3*512+i];}
    gr_fill(8,5,512,b[0..<2720]);#assert qz_decode(8,5,512,b[0..<2720],values[..]).status==QzStatus.ok;q:[1360]u16;gr_words16(b[0..<2720],q[..]);
    for item:0..<1024 {gr_embed_q8(item,512,ids[..],q[..],out[..]);}for i:0..<512 {#assert out[512+i]==values[512+i];}
}
#test "the norm, the rotation, the cache and attention against binary64" {
    cols:=300;x:[600]f32;scale:[300]f32;out:[600]f32;
    for i:0..<600 {x[i]=f32(cast(int)(gr_noise(5,i)%2001)-1000)/250;}for i:0..<300 {scale[i]=0.5+f32(i)/300;}
    eps:=cast(int)f32_bits(0.00001);for item:0..<2 {gr_norm(item,cols,eps,x[..],scale[..],out[..]);}
    for t:0..<2 {ss:=0.0;for i:0..<cols {ss+=f64(x[t*cols+i])*f64(x[t*cols+i]);}inv:=1/sqrt(ss/300+f64(0.00001f32));
        for i:0..<cols {want:=f64(x[t*cols+i])*inv*f64(scale[i]);#assert abs(f64(out[t*cols+i])-want)<=0.000002*(1+abs(want));}}
    // Two query heads share one key head; two tokens at positions 2 and 3
    // after two cached ones. Pages: position p lives in page pages[p/256].
    heads:=2;kv:=1;position:=2;tokens:=2;span:=position+tokens;cap:=8;
    rope:[1024]f32;for p:0..<4 {for i:0..<64 {theta:=f64(p)*pow(10000000.0,-f64(2*i)/128);rope[p*128+2*i]=f32(cos(theta));rope[p*128+2*i+1]=f32(sin(theta));}}
    q:[512]f32;k:[256]f32;v:[256]f32;for i:0..<512 {q[i]=f32(cast(int)(gr_noise(11,i)%2001)-1000)/1000;}for i:0..<256 {k[i]=f32(cast(int)(gr_noise(12,i)%2001)-1000)/1000;v[i]=f32(cast(int)(gr_noise(13,i)%2001)-1000)/1000;}
    q0:=q;k0:=k;
    for item:0..<tokens*(heads+kv)*64 {gr_rope(item,heads,kv,position,rope[..],q[..],k[..]);}
    for i:0..<64 {c:=rope[(position+1)*128+2*i];s:=rope[(position+1)*128+2*i+1];a:=q0[256+2*i];b:=q0[256+2*i+1];#assert q[256+2*i]==a*c-b*s && q[256+2*i+1]==a*s+b*c;}
    pages:=[2]int.[1,0];cache:[131072]u16;
    // Keys and values of the two cached positions, then this call's.
    early:[512]f32;for i:0..<512 {early[i]=f32(cast(int)(gr_noise(14,i)%2001)-1000)/1000;}
    for item:0..<256 {gr_store(item,kv,0,0,pages[..],early[0..<256],early[256..<512],cache[..]);}
    for item:0..<256 {gr_store(item,kv,position,0,pages[..],k[..],v[..],cache[..]);}
    #assert gr_cache_at(pages[..],0,1,3,0,1)==(3*256+3)*128 && gr_cache_at(pages[..],1,1,0,0,0)==0;
    scores:[64]f32;sb:=cast(int)f32_bits(0.0078125);
    for item:0..<tokens*heads*span {gr_scores(item,heads,kv,position,span,cap,sb,0,pages[..],q[..],cache[..],scores[..]);}
    for item:0..<tokens*heads {gr_softmax(item,span,cap,scores[..]);}
    chunks:=1;partial:[512]f32;att:[512]f32;
    for item:0..<tokens*heads*chunks*128 {gr_context_part(item,heads,kv,span,cap,chunks,0,pages[..],scores[..],cache[..],partial[..]);}
    for item:0..<tokens*heads*128 {gr_context(item,chunks,partial[..],att[..]);}
    for t:0..<tokens {for h:0..<heads {
        logits:[4]f64;top:=-1000000.0;
        for key:0..<position+t+1 {
            krow:=ifx key<2 then early[key*128..<key*128+128] else k[(key-2)*128..<(key-2)*128+128];
            dot:=0.0;for d:0..<128 {dot+=f64(q[(t*heads+h)*128+d])*f64(gr_half(gr_f16(krow[d])));}logits[key]=dot/128;if logits[key]>top {top=logits[key];}
        }
        den:=0.0;for key:0..<position+t+1 {den+=exp(logits[key]-top);}
        for d:0..<128 {
            want:=0.0;for key:0..<position+t+1 {vrow:=ifx key<2 then early[256+key*128..<256+key*128+128] else v[(key-2)*128..<(key-2)*128+128];want+=exp(logits[key]-top)/den*f64(gr_half(gr_f16(vrow[d])));}
            #assert abs(f64(att[(t*heads+h)*128+d])-want)<=0.00001;
        }
        if t==0 {#assert scores[(t*heads+h)*cap+3]==0;}
    }}
    g:=[3]f32.[-2,0,3];u:=[3]f32.[1,2,0.5];o:[3]f32;for item:0..<3 {gr_swiglu(item,g[..],u[..],o[..]);}#assert o[1]==0 && abs(f64(o[0])+0.238405844)<0.000001;
}
#test "greedy choice takes the first largest logit" {
    logits:[600]f32;for i:0..<600 {logits[i]=f32(i%300);}logits[450]=1000;logits[451]=1000;
    best:[3]f32;index:[3]int;control:[1]int;
    for item:0..<3 {gr_argmax_part(item,logits[..],best[..],index[..]);}gr_argmax(0,3,best[..],index[..],control[..]);#assert control[0]==450;
    index[1]= -2;gr_argmax(0,3,best[..],index[..],control[..]);#assert control[0]== -2;
}
