// Compares two Granite dumps (granite_run dump, granite_llama): token ids, each layer's residual
// stream, the prompt's full-vocabulary logits, and the greedy continuation with each step's logits.
//   coax/web/tool.sh psionic/tests/granite_parity.coax PSIONIC.bin LLAMA.bin [--require] [--json OUT]
// A dump: n, layers, width, vocab, steps (i64 each), then n token ids (i64), the residual stream
// (layers * n * width f32), the prompt's logits (vocab f32), and for each step its token (i64) and
// logits (vocab f32).
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";

cxproc_self_path :: (out: [] u8) -> int #foreign;


GP_VOCAB :: 262144;      // logits a step at most
GP_IDS :: 4096;          // tokens at most
GP_STEPS :: 256;         // greedy steps at most
GP_LAYERS :: 256;
GP_CHUNK :: 1048576;     // f32s read at once

Dump :: struct { path: string; n: int; layers: int; width: int; vocab: int; steps: int; ids: [GP_IDS] int; tokens: [GP_STEPS] int; ok: bool; }

gp_i64 :: (b: [] u8, at: int) -> int {
  v: u64 = 0;
  for i: 0..<8 { v = v | (cast(u64) b[at + i] << cast(u64) (8 * i)); }
  return cast(int) v;
}
gp_f32 :: (b: [] u8, at: int) -> f64 {
  v: u32 = cast(u32) b[at] | (cast(u32) b[at + 1] << 8) | (cast(u32) b[at + 2] << 16) | (cast(u32) b[at + 3] << 24);
  return cast(f64) f32_from_bits(v);
}

gp_load :: (d: [] Dump, path: string) -> bool {
  d[0].path = path;
  h: [40] u8;
  if fs_read_at(path, 0, h[..]) != 40 { return false; }
  d[0].n = gp_i64(h[..], 0); d[0].layers = gp_i64(h[..], 8); d[0].width = gp_i64(h[..], 16); d[0].vocab = gp_i64(h[..], 24); d[0].steps = gp_i64(h[..], 32);
  if d[0].n < 1 || d[0].n > GP_IDS || d[0].steps < 0 || d[0].steps > GP_STEPS || d[0].vocab < 1 || d[0].vocab > GP_VOCAB || d[0].layers < 1 || d[0].layers > GP_LAYERS || d[0].width < 1 { return false; }
  b: [GP_IDS * 8] u8;
  if fs_read_at(path, 40, b[0..<8 * d[0].n]) != 8 * d[0].n { return false; }
  for i: 0..<d[0].n { d[0].ids[i] = gp_i64(b[..], 8 * i); }
  for s: 0..<d[0].steps {
    t: [8] u8;
    if fs_read_at(path, gp_step_at(d, s + 1) - 8, t[..]) != 8 { return false; }
    d[0].tokens[s] = gp_i64(t[..], 0);
  }
  return true;
}
// Where the residual stream starts, and where step s's logits start (step 0 the prompt's).
gp_res_at :: (d: [] Dump) -> int { return 40 + 8 * d[0].n; }
gp_step_at :: (d: [] Dump, s: int) -> int {
  at := gp_res_at(d) + 4 * d[0].layers * d[0].n * d[0].width + 4 * d[0].vocab;
  if s == 0 { return at - 4 * d[0].vocab; }
  return at + (s - 1) * (8 + 4 * d[0].vocab) + 8;
}
// count f32s from offset into out.
gp_floats :: (path: string, at: int, count: int, out: [] f64) -> bool {
  b: [4 * GP_CHUNK] u8;
  done := 0;
  while done < count {
    k := ifx count - done < GP_CHUNK then count - done else GP_CHUNK;
    if fs_read_at(path, at + 4 * done, b[0..<4 * k]) != 4 * k { return false; }
    for i: 0..<k { out[done + i] = gp_f32(b[..], 4 * i); }
    done += k;
  }
  return true;
}

// Python's sum() of floats (3.12 on): Neumaier's compensated sum.
Sum :: struct { f: f64; c: f64; }
gp_add :: (s: [] Sum, x: f64) {
  t := s[0].f + x;
  if abs(s[0].f) >= abs(x) { s[0].c += (s[0].f - t) + x; } else { s[0].c += (x - t) + s[0].f; }
  s[0].f = t;
}
gp_total :: (s: [] Sum) -> f64 { return ifx s[0].c != 0 && s[0].c == s[0].c && s[0].c - s[0].c == 0 then s[0].f + s[0].c else s[0].f; }

gp_dist :: (a: [] f64, b: [] f64) -> f64 {
  worst := 0.0; scale := 0.0;
  for i: 0..<a.count {
    d := abs(a[i] - b[i]);
    if d > worst { worst = d; }
    if abs(b[i]) > scale { scale = abs(b[i]); }
  }
  return worst / (1 + scale);
}
gp_rel_rms :: (a: [] f64, b: [] f64) -> f64 {
  sn: [1] Sum; sd: [1] Sum;
  for i: 0..<a.count { d := a[i] - b[i]; gp_add(sn[..], d * d); }
  for i: 0..<b.count { gp_add(sd[..], b[i] * b[i]); }
  num := gp_total(sn[..]); den := gp_total(sd[..]);
  return ifx den != 0 then sqrt(num / den) else 0.0;
}
// The k largest's indices, largest first; ties to the lower index (Python's stable sort).
gp_top :: (l: [] f64, k: int, out: [] int) {
  for j: 0..<k {
    best := -1;
    for i: 0..<l.count {
      taken := false; for q: 0..<j { if out[q] == i { taken = true; } }
      if !taken && (best < 0 || l[i] > l[best]) { best = i; }
    }
    out[j] = best;
  }
}
gp_softmax :: (l: [] f64, out: [] f64) {
  m := l[0]; for x: l { if x > m { m = x; } }
  t: [1] Sum;
  for i: 0..<l.count { out[i] = exp(l[i] - m); gp_add(t[..], out[i]); }
  s := gp_total(t[..]);
  for i: 0..<l.count { out[i] = out[i] / s; }
}
gp_kl :: (p: [] f64, q: [] f64) -> f64 {
  t: [1] Sum;
  for i: 0..<p.count { if p[i] > 0 && q[i] > 0 { gp_add(t[..], p[i] * log(p[i] / q[i])); } }
  return gp_total(t[..]);
}

put :: (out: [] u8, n: [] int, c: u8) { out[n[0]] = c; n[0] += 1; }
// Python's '{:.3g}'.
gp_g3 :: (value: f64, out: [] u8) -> string {
  x := value;
  nn: [1] int; nn[0] = 0;
  if x != x { return "nan"; }
  if x == 0 { if f64_bits(x) >> 63 != 0 { return "-0"; } return "0"; }
  if x < 0 { put(out, nn[..], '-'); x = -x; }
  e := cast(int) floor(log(x) / log(10.0));
  m := cast(int) floor(x / pow(10.0, cast(f64) (e - 2)) + 0.5);
  if m < 100 { e -= 1; m = cast(int) floor(x / pow(10.0, cast(f64) (e - 2)) + 0.5); }
  if m >= 1000 { e += 1; m = cast(int) floor(x / pow(10.0, cast(f64) (e - 2)) + 0.5); }
  d: [3] u8; d[0] = cast,trunc(u8) ('0' + m / 100); d[1] = cast,trunc(u8) ('0' + (m / 10) % 10); d[2] = cast,trunc(u8) ('0' + m % 10);
  keep := 3; while keep > 1 && d[keep - 1] == '0' { keep -= 1; }
  if e >= -4 && e < 3 {
    if e < 0 {
      put(out, nn[..], '0'); put(out, nn[..], '.');
      for i: 0..<-e - 1 { put(out, nn[..], '0'); }
      for i: 0..<keep { put(out, nn[..], d[i]); }
    } else {
      for i: 0..<e + 1 { put(out, nn[..], d[i]); }
      if keep > e + 1 { put(out, nn[..], '.'); for i: e + 1..<keep { put(out, nn[..], d[i]); } }
    }
  } else {
    put(out, nn[..], d[0]);
    if keep > 1 { put(out, nn[..], '.'); for i: 1..<keep { put(out, nn[..], d[i]); } }
    put(out, nn[..], 'e'); put(out, nn[..], ifx e < 0 then cast(u8) '-' else cast(u8) '+');
    a := ifx e < 0 then -e else e;
    if a >= 100 { put(out, nn[..], cast,trunc(u8) ('0' + a / 100)); }
    put(out, nn[..], cast,trunc(u8) ('0' + (a / 10) % 10)); put(out, nn[..], cast,trunc(u8) ('0' + a % 10));
  }
  return cast(string) out[0..<nn[0]];
}
#test "the .3g format is Python's" {
  b: [64] u8;
  #assert gp_g3(0.00123456, b[..]) == "0.00123";
  #assert gp_g3(1.2e-05, b[..]) == "1.2e-05";
  #assert gp_g3(0.0001, b[..]) == "0.0001";
  #assert gp_g3(123.0, b[..]) == "123";
  #assert gp_g3(1234.0, b[..]) == "1.23e+03";
  #assert gp_g3(12.0, b[..]) == "12";
  #assert gp_g3(0.5, b[..]) == "0.5";
  #assert gp_g3(-0.000271828, b[..]) == "-0.000272";
  #assert gp_g3(999.6, b[..]) == "1e+03";
  #assert gp_g3(0.0, b[..]) == "0";
}

add :: (bad: [] u8, nb: int, s: string) -> int {
  n := nb;
  if n > 0 { for c: "; " { bad[n] = c; n += 1; } }
  for c: s { bad[n] = c; n += 1; }
  return n;
}
gp_list :: (v: [] int) {
  print("[");
  for i: 0..<v.count { if i > 0 { print(", "); } print("%", v[i]); }
  print("]");
}

Layer :: struct { max_rel: f64; rel_rms: f64; }
Step :: struct { max_rel: f64; rel_rms: f64; kl: f64; top_p: [5] int; top_q: [5] int; same: bool; }

// --json: the same numbers as JSON (Python's json.dumps(..., indent=1)), printed by a second run
// of this tool with --print-json, whose output goes to the file.
gp_json :: (p: [] Dump, q: [] Dump, layers: [] Layer, steps: [] Step, same: int) {
  print("{\n \"tokens\": %,\n \"ids\": ", p[0].n); gp_json_ints(p[0].ids[0..<p[0].n]); print(",\n \"layers\": [");
  for l: 0..<layers.count {
    print("%\n  {\n   \"layer\": %,\n   \"max_rel\": %,\n   \"rel_rms\": %\n  }", ifx l > 0 then "," else "", l, layers[l].max_rel, layers[l].rel_rms);
  }
  print("\n ],\n \"logits\": [");
  for s: 0..<steps.count {
    print("%\n  {\n   \"step\": %,\n   \"max_rel\": %,\n   \"rel_rms\": %,\n   \"kl\": %,\n   \"top_psionic\": ", ifx s > 0 then "," else "", s, steps[s].max_rel, steps[s].rel_rms, steps[s].kl);
    gp_json_ints_at(steps[s].top_p[..], 3); print(",\n   \"top_llama\": "); gp_json_ints_at(steps[s].top_q[..], 3);
    print(",\n   \"argmax_same\": %\n  }", ifx steps[s].same then "true" else "false");
  }
  print("\n ],\n \"greedy_psionic\": "); gp_json_ints(p[0].tokens[0..<p[0].steps]);
  print(",\n \"greedy_llama\": "); gp_json_ints(q[0].tokens[0..<q[0].steps]);
  print(",\n \"greedy_agree\": %,\n \"greedy_steps\": %\n}\n", same, q[0].steps);
}
gp_json_ints :: (v: [] int) { gp_json_ints_at(v, 1); }
gp_json_ints_at :: (v: [] int, depth: int) {
  if v.count == 0 { print("[]"); return; }
  print("[");
  for i: 0..<v.count { print("%\n", ifx i > 0 then "," else ""); for k: 0..<depth + 1 { print(" "); } print("%", v[i]); }
  print("\n"); for k: 0..<depth { print(" "); } print("]");
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  ok := args_load(a[..]);
  if !ok || args_count(a[..]) < 2 { tool_errln("usage: granite_parity.coax PSIONIC.bin LLAMA.bin [--require] [--json OUT]"); return 2; }
  print_json := args_has(a[..], "--print-json");
  p: [1] Dump; q: [1] Dump;
  if !gp_load(p[..], args_at(a[..], 0)) { tool_err("granite_parity: can't read the dump "); tool_errln(args_at(a[..], 0)); return 1; }
  if !gp_load(q[..], args_at(a[..], 1)) { tool_err("granite_parity: can't read the dump "); tool_errln(args_at(a[..], 1)); return 1; }
  same_ids := p[0].n == q[0].n;
  if same_ids { for i: 0..<p[0].n { if p[0].ids[i] != q[0].ids[i] { same_ids = false; } } }
  if !same_ids { tool_errln("AssertionError: the token ids differ"); return 1; }
  n := p[0].n; w := p[0].width;
  layers: [GP_LAYERS] Layer;
  ra: [GP_IDS * 4096] f64; rb: [GP_IDS * 4096] f64;
  if n * w > ra.count { tool_errln("granite_parity: a layer is larger than this tool holds"); return 1; }
  for l: 0..<p[0].layers {
    first := ifx l < p[0].layers - 1 then 0 else n - 1;
    k := (n - first) * w;
    at := (l * n + first) * w;
    if !gp_floats(p[0].path, gp_res_at(p[..]) + 4 * at, k, ra[..]) || !gp_floats(q[0].path, gp_res_at(q[..]) + 4 * at, k, rb[..]) { tool_errln("granite_parity: a dump ends early"); return 1; }
    layers[l].max_rel = gp_dist(ra[0..<k], rb[0..<k]); layers[l].rel_rms = gp_rel_rms(ra[0..<k], rb[0..<k]);
  }
  steps: [GP_STEPS + 1] Step;
  nsteps := ifx p[0].steps < q[0].steps then p[0].steps else q[0].steps;
  la: [GP_VOCAB] f64; lb: [GP_VOCAB] f64; pa: [GP_VOCAB] f64; pb: [GP_VOCAB] f64;
  v := p[0].vocab;
  for s: 0..<nsteps + 1 {
    if !gp_floats(p[0].path, gp_step_at(p[..], s), v, la[..]) || !gp_floats(q[0].path, gp_step_at(q[..], s), v, lb[..]) { tool_errln("granite_parity: a dump ends early"); return 1; }
    gp_softmax(la[0..<v], pa[..]); gp_softmax(lb[0..<v], pb[..]);
    steps[s].max_rel = gp_dist(la[0..<v], lb[0..<v]); steps[s].rel_rms = gp_rel_rms(la[0..<v], lb[0..<v]);
    steps[s].kl = gp_kl(pb[0..<v], pa[0..<v]);
    gp_top(la[0..<v], 5, steps[s].top_p[..]); gp_top(lb[0..<v], 5, steps[s].top_q[..]);
    steps[s].same = steps[s].top_p[0] == steps[s].top_q[0];
  }
  same := 0;
  for i: 0..<nsteps { if p[0].tokens[i] != q[0].tokens[i] { break; } same += 1; }
  if print_json { gp_json(p[..], q[..], layers[0..<p[0].layers], steps[0..<nsteps + 1], same); return 0; }
  worst := 0;
  for l: 1..<p[0].layers { if layers[l].rel_rms > layers[worst].rel_rms { worst = l; } }
  last := p[0].layers - 1;
  g1: [64] u8; g2: [64] u8; g3: [64] u8;
  print("ids: % equal; residual stream: worst layer % relative RMS %", n, worst, gp_g3(layers[worst].rel_rms, g1[..]));
  print(" (max %); last layer relative RMS %\n", gp_g3(layers[worst].max_rel, g2[..]), gp_g3(layers[last].rel_rms, g3[..]));
  print("prompt logits: relative RMS %, KL(llama||psionic) %, top-5 ", gp_g3(steps[0].rel_rms, g1[..]), gp_g3(steps[0].kl, g2[..]));
  gp_list(steps[0].top_p[..]); print(" vs "); gp_list(steps[0].top_q[..]); print("\n");
  wr := steps[0].rel_rms; wk := steps[0].kl;
  for s: 1..<nsteps + 1 { if steps[s].rel_rms > wr { wr = steps[s].rel_rms; } if steps[s].kl > wk { wk = steps[s].kl; } }
  print("greedy: % of % tokens agree; worst step logits relative RMS %, worst KL %\n", same, q[0].steps, gp_g3(wr, g1[..]), gp_g3(wk, g2[..]));
  jat := args_find(a[..], "--json");
  if args_has(a[..], "--require") {
    // Bounds for the token-at-a-time comparison (both sides f32 activations).
    bad: [256] u8; nb := 0;
    if same != q[0].steps { nb = add(bad[..], nb, "the greedy continuations differ"); }
    if layers[worst].rel_rms > 0.005 { nb = add(bad[..], nb, "a layer differs by more than 5e-3 relative RMS"); }
    if wr > 0.005 { nb = add(bad[..], nb, "logits differ by more than 5e-3 relative RMS"); }
    if nb > 0 { tool_errln(cast(string) bad[0..<nb]); return 1; }
    print("parity: ok\n");
  }
  if jat >= 0 && jat + 1 < args_count(a[..]) {
    sb: [4096] u8; sn := cxproc_self_path(sb[..]);
    argv := [4] string.[cast(string) sb[0..<sn], args_at(a[..], 0), args_at(a[..], 1), "--print-json"];
    out: [4194304] u8; err: [4096] u8;
    r := proc_run(argv[..], 600000, out[..], err[..]);
    if r.status != 0 || r.cut { tool_errln("granite_parity: the JSON run failed"); return 1; }
    out[r.out_n] = '\n';
    if !fs_write(args_at(a[..], jat + 1), cast(string) out[0..<r.out_n + 1]) { tool_errln("granite_parity: can't write the JSON"); return 1; }
  }
  return 0;
}
