// Chapter 110's check oracles, loaded by psionic/lib/gridworld.coax. They
// share no code with the planner: their own neighbour rule, integer
// shortest paths by repeated relaxation, discounted values summed term by
// term, and exhaustive search over every deterministic policy.
#load "../lib/counter-rng.coax";
// A cell is row * 8 + column; a map is given as its rows, '#' a wall.
go_cell :: (rows:string,width:int,s:int)->u8 {return rows[(s/8)*(width+1)+s%8];}
go_inside :: (width:int,height:int,s:int)->bool {return s>=0 && s<64 && s%8<width && s/8<height;}
// The neighbour in direction a (up, right, down, left), or s itself at an edge or a wall.
go_step :: (rows:string,width:int,height:int,s:int,a:int)->int {
    dr:=[4]int.[-1,0,1,0];dc:=[4]int.[0,1,0,-1];
    r:=s/8+dr[a];c:=s%8+dc[a];
    if r<0 || c<0 || r>=height || c>=width {return s;}
    if go_cell(rows,width,r*8+c)=='#' {return s;}
    return r*8+c;
}
// Steps to the goal from every cell, -1 where there is no route: relax 64 times.
go_distance :: (rows:string,width:int,height:int,goal:int,d:[]int) {
    for s:0..<64 {d[s]=-1;}d[goal]=0;
    for round:0..<64 {for s:0..<64 {
        if !go_inside(width,height,s) || s==goal || go_cell(rows,width,s)=='#' {continue;}
        for a:0..<4 {t:=go_step(rows,width,height,s,a);if t!=s && d[t]>=0 && (d[s]<0 || d[t]+1<d[s]) {d[s]=d[t]+1;}}
    }}
}
// -(1 + g + ... + g^(d-1)); with no route, the limit -1/(1-g).
go_value :: (d:int,gamma:f64)->f64 {
    if d<0 {return -1/(1-gamma);}
    v:=0.0;p:=1.0;for k:0..<d {v-=p;p*=gamma;}return v;
}
// The value of following one fixed policy from s: a path to the goal in t steps,
// or a cycle that never reaches it.
go_policy_value :: (rows:string,width:int,height:int,goal:int,policy:[]int,s:int,gamma:f64)->f64 {
    at:=s;for t:0..<65 {if at==goal {return go_value(t,gamma);}at=go_step(rows,width,height,at,policy[at]);}
    return go_value(-1,gamma);
}
// Every deterministic policy over the open cells other than the goal (at most
// seven, 4^7 policies): the best value each cell reaches under any of them.
go_brute :: (rows:string,width:int,height:int,goal:int,gamma:f64,best:[]f64)->int {
    cells:[7]int;n:=0;
    for s:0..<64 {if go_inside(width,height,s) && s!=goal && go_cell(rows,width,s)!='#' {#assert n<7;cells[n]=s;n+=1;}}
    for s:0..<64 {best[s]=0;}for i:0..<n {best[cells[i]]=go_value(-1,gamma);}
    count:=1;for i:0..<n {count*=4;}
    policy:[64]int;
    for code:0..<count {
        rest:=code;for i:0..<n {policy[cells[i]]=rest%4;rest/=4;}
        for i:0..<n {v:=go_policy_value(rows,width,height,goal,policy[..],cells[i],gamma);if v>best[cells[i]] {best[cells[i]]=v;}}
    }
    return count;
}
// A 5 x 5 map from a seed: walls with probability about a quarter, the start
// top left, the goal bottom right.
go_random_map :: (seed:u64,buf:[]u8)->string {
    for r:0..<5 {
        for c:0..<5 {
            u:=cr_bits(seed,cast(u64)(r*5+c));
            buf[r*6+c]=ifx u%4==0 then '#' else '.';
        }
        if r<4 {buf[r*6+5]='/';}
    }
    buf[0]='S';buf[4*6+4]='G';
    return cast(string)buf[0..<29];
}
// Q-learning written a second time from chapter 110's description: open cells
// other than the goal in increasing order; per episode one draw for the start
// (its value mod the number of cells), then per step a draw whose value mod 16
// below explore means a random action, the next counter's value mod 4. Both
// counters are used every step. The greedy action is the first largest Q.
GoLearn :: struct {q:[256]f64;visited:[256]bool;digest:u64;steps:int;off:int;
    close_episode:int=-1;close_steps:int=-1;optimal_episode:int=-1;optimal_steps:int=-1;}
go_first_best :: (q:[]f64,s:int)->int {
    b:=0;
    if q[4*s+1]>q[4*s+b] {b=1;}
    if q[4*s+2]>q[4*s+b] {b=2;}
    if q[4*s+3]>q[4*s+b] {b=3;}
    return b;
}
go_learn :: (rows:string,width:int,height:int,start:int,goal:int,q0:[256]f64,gamma:f64,alpha:f64,explore:int,seed:u64,episodes:int,episode_steps:int,tol:f64)->GoLearn {
    o:GoLearn;o.q=q0;o.digest=(cast(u64)14695981039346656037);
    cells:[64]int;n:=0;
    for s:0..<64 {if go_inside(width,height,s) && s!=goal && go_cell(rows,width,s)!='#' {cells[n]=s;n+=1;}}
    d:[64]int;go_distance(rows,width,height,goal,d[..]);
    draw:u64=0;
    for e:1..<episodes+1 {
        at:=cells[cast(int)(cr_bits(seed,draw)%cast(u64)n)];draw+=1;
        k:=0;
        while k<episode_steps && at!=goal {
            a:=go_first_best(o.q[..],at);
            if cast(int)(cr_bits(seed,draw)%16)<explore {a=cast(int)(cr_bits(seed,draw+1)%4);}
            draw+=2;
            to:=go_step(rows,width,height,at,a);o.visited[4*at+a]=true;
            future:=0.0;if to!=goal {future=o.q[4*to+go_first_best(o.q[..],to)];}
            o.q[4*at+a]=o.q[4*at+a]+alpha*((-1+gamma*future)-o.q[4*at+a]);
            o.digest=mul_wrap(o.digest^cast(u64)(4*at+a),(cast(u64)1099511628211))^cast(u64)to;
            o.steps+=1;k+=1;at=to;
        }
        o.off=0;
        for i:0..<256 {
            s:=i/4;if !go_inside(width,height,s) || s==goal || go_cell(rows,width,s)=='#' {continue;}
            want:=-1+gamma*go_value(d[go_step(rows,width,height,s,i%4)],gamma);
            if abs(o.q[i]-want)>tol {o.off+=1;}
        }
        if o.off==0 && o.close_episode<0 {o.close_episode=e;o.close_steps=o.steps;}
        // The greedy walk from the start, compared with the shortest number of moves.
        walk:=start;moves:=0;
        while walk!=goal && moves<=64 {walk=go_step(rows,width,height,walk,go_first_best(o.q[..],walk));moves+=1;}
        if walk==goal && moves==d[start] && o.optimal_episode<0 {o.optimal_episode=e;o.optimal_steps=o.steps;}
    }
    return o;
}
