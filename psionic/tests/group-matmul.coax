// Group-kernel conformance (chapter 32): a tiled matrix product through
// threadgroup memory and barriers, the same source on the CPU (the oracle,
// where a thread loop is an ordinary loop), on Apple GPUs (coax
// metal-compute) and on CUDA (coax cuda). Every output adds its products in
// the same order on every target, so the results are compared bit for bit.
#authority;

GM_THREADS :: 128;
// Tile `item` of c (m by n, row-major) = a (m by k) times b (k by n): 32 rows
// by 32 columns, k in steps of 32. Thread t owns row t/4, columns
// 8*(t%4) .. +7 of the tile, accumulated in its own registers.
gm_matmul :: (item:int,m:int,n:int,k:int,a:[]f32,b:[]f32,c:[]f32) #export_c {
    tiles:=(n+31)/32;r0:=item/tiles*32;c0:=item%tiles*32;
    ta:[1024]f32;tb:[1024]f32;acc:[1024]f32;
    for s:0..<(k+31)/32 {
        k0:=s*32;
        for thread:0..<GM_THREADS {
            for i:0..<8 {
                e:=thread+GM_THREADS*i;r:=e/32;q:=e%32;
                va:f32=0;if r0+r<m && k0+q<k {va=a[(r0+r)*k+k0+q];}
                vb:f32=0;if k0+r<k && c0+q<n {vb=b[(k0+r)*n+c0+q];}
                ta[thread+GM_THREADS*i]=va;tb[thread+GM_THREADS*i]=vb;
            }
        }
        for thread:0..<GM_THREADS {
            row:=thread/4;col:=thread%4*8;
            for j:0..<8 {
                sum:=acc[thread*8+j];
                for q:0..<32 {sum+=ta[row*32+q]*tb[q*32+col+j];}
                acc[thread*8+j]=sum;
            }
        }
    }
    for thread:0..<GM_THREADS {
        row:=thread/4;col:=thread%4*8;
        for j:0..<8 {if r0+row<m && c0+col+j<n {c[(r0+row)*n+c0+col+j]=acc[thread*8+j];}}
    }
}
// Shared code reads threadgroup memory after a phase: each item's 256 sums of
// x (in a thread's own strided slots), then the group's total, broadcast.
gm_total :: (item:int,count:int,x:[]f32,out:[]f32) #export_c {
    part:[256]f32;
    for thread:0..<GM_THREADS {
        for i:0..<2 {
            at:=item*256+thread+GM_THREADS*i;v:f32=0;
            if at<count {v=x[at];}
            part[thread+GM_THREADS*i]=v;
        }
    }
    total:f32=0;
    for i:0..<256 {total+=part[i];}
    for thread:0..<GM_THREADS {
        for i:0..<2 {
            at:=item*256+thread+GM_THREADS*i;
            if at<count {out[at]=x[at]/total;}
        }
    }
}

#test "the tiled product is the plain product" {
    m:=37;n:=45;k:=70;
    a:[2590]f32;b:[3150]f32;c:[1665]f32;
    for i:0..<m*k {a[i]=f32(i%7-3)*0.5;}
    for i:0..<k*n {b[i]=f32(i%5-2)*0.25;}
    items:=((m+31)/32)*((n+31)/32);
    for item:0..<items {gm_matmul(item,m,n,k,a[..],b[..],c[..]);}
    for i:0..<m {for j:0..<n {
        sum:f32=0;for q:0..<k {sum+=a[i*k+q]*b[q*n+j];}
        #assert c[i*n+j]==sum;
    }}
}
#test "the group total divides each value" {
    x:[300]f32;out:[300]f32;
    for i:0..<300 {x[i]=f32(i%4+1);}
    for item:0..<2 {gm_total(item,300,x[..],out[..]);}
    first:f32=0;for i:0..<256 {first+=x[i];}
    second:f32=0;for i:256..<300 {second+=x[i];}
    #assert out[0]==1/first && out[255]==x[255]/first && out[256]==x[256]/second && out[299]==x[299]/second;
}
