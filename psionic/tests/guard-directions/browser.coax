    jo_arr(o[..]);jo_str(o[..],"verse.player");jo_str(o[..],"{\"key\":\"synthetic-local-only\",\"id\":\"p-1\",\"account\":true}");jo_end(o[..]);jo_end(o[..]);jo_end(o[..]);
    html:[8192]u8;n:=ws_put(html[..],0,DB_DOC_START);n=ws_put(html[..],n,jo_text(o[..]));n=ws_put(html[..],n,DB_DOC_END);
