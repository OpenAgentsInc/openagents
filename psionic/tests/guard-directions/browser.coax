        return db_record(s,"published-11-edits-keep-find-work",ok && db_local(v,0) && v.local_action==1 && s[0].calls==0 && s[0].other==0,v);}
    s[0].viewer=0;ok:=db_call(c,s,"Emulation.setFocusEmulationEnabled","{\"enabled\":true}")>=0 && db_visit(c,s,"");
    // Bram is eligible (calm, near, visible): only the route refuses the offer.
    eligible:=false;end:=proc_now_ms()+15000;while proc_now_ms()<end && !s[0].bad {if db_scalar(c,s,247)==1 {eligible=true;break;}db_delay(c,s,40);}
    db_delay(c,s,1000);ok=ok && eligible && db_press(c,s,"g");db_delay(c,s,600);v:=db_snapshot(c,s);
    return db_record(s,"crate-on-the-route-refuses",ok && v.version==1 && v.offer==0 && v.rendered==0 && v.local==0 && s[0].calls==0 && s[0].other==0,v);
}
db_hash_module :: (out:[]u8)->bool {
    if out.count!=64 {return false;}bytes:[8388608]u8;n:=fs_read("apps/openagents-web/build/everglade.wasm",bytes[..]);digest:[32]u8;
    if n<1 {return false;}state:[112]u8;if sha256_init(state[..])!=SHA_OK {return false;}
    at:=0;while at<n {end:=ifx n-at>32768 then at+32768 else n;if sha256_update_checked(state[..],bytes[at..<end],false)!=SHA_OK {return false;}at=end;}
    if sha256_final_checked(state[..],digest[..],false)!=SHA_OK {return false;}
    for i:0..<32 {b:=cast(int)digest[i];out[2*i]="0123456789abcdef"[b/16];out[2*i+1]="0123456789abcdef"[b%16];}return true;
}
db_server :: (origin:string)->int {
