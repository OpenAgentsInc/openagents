DB_DOC_START :: "<!doctype html><html><style>html,body{margin:0;background:black}canvas{width:100vw;height:100vh}</style><canvas id=\"coaxial\"></canvas><script>((d)=>{Date.now=()=>d.now;localStorage.clear();for(const [k,v] of d.storage.slice(0,8))localStorage.setItem(k,v);})(";
