    line:[4096]u8;if proc_line(h,5000,line[..])<1 {ignored:=proc_release(h);return -1;}return h;
}
db_stop_server :: (h:int) {if h>=0 {ignored:=proc_kill(h,PROC_SIGTERM);status:=proc_wait(h,1000);released:=proc_release(h);}}
