// The measured production Elephant listener is placed for 512 tokens.
#authority;
#test "the preparation preflight accepts the full resident capacity inclusively" {
  #assert guide_tokens_fit(1) && guide_tokens_fit(512);
  #assert !guide_tokens_fit(0) && !guide_tokens_fit(-1) && !guide_tokens_fit(513) && !guide_tokens_fit(9223372036854775807);
}
guide_tokens_fit :: (tokens:int)->bool #export_c {return tokens>=1 && tokens<=512;}
