// Chapter 201's check helpers, kept apart from psionic/lib/harness/log.coax:
// chapter 200's hand trace logged as a session, and a forger who rewrites
// the chain after editing events, so a check can reach the rules the chain
// alone does not enforce. Nothing here is used by the log itself.
// Two turns, and two steps, field for field.
lc_same :: (a:HlTurn,b:HlTurn)->bool {return a.stop==b.stop && a.steps==b.steps && a.at==b.at && a.reply==b.reply && a.tokens==b.tokens && a.ticks==b.ticks && a.tools==b.tools;}
lc_step :: (a:HlStep,b:HlStep)->bool {
    return a.seen==b.seen && a.seed==b.seed && a.limit==b.limit && a.written==b.written && a.draws==b.draws && a.stop==b.stop && a.positions==b.positions && a.value==b.value && a.output==b.output;
}
// The hand trace: HL_PROMPT as one user event, then chapter 200's turn at seed 7.
lc_trace :: (l:[]LgLog,b:HlBudget,context:int)->LgTurn {
    tb:=NC_LEARNED;tr:=HL_TRACE;ts:=HL_TRACE_STARTS;p:=HL_PROMPT;
    #assert lg_say(l,LgKind.user,p[..])==LgStatus.ok;
    return lg_run(hl_scripted(tb[..],tr[..],ts[..],context),b,7,l);
}
// Chapter 200's turn and the logged turn under one budget and window: the
// same turn and transcript, the same steps rebuilt from the log, and replay.
lc_compare :: (b:HlBudget,context:int) {
    tb:=NC_LEARNED;tr:=HL_TRACE;ts:=HL_TRACE_STARTS;
    ids:[48]int;want:[6]HlStep;t:=hl_trace(tb[..],b,context,ids[..],want[..]);
    ev:[24]LgEvent;tk:[48]int;l:=[1]LgLog.[LgLog.{events=ev[..],tokens=tk[..]}];r:=lc_trace(l[..],b,context);
    #assert r.status==LgStatus.ok && lc_same(r.turn,t);for i:0..<t.at {#assert tk[i]==ids[i];}
    steps:[6]HlStep;u:=lg_turn(l[0],1,steps[..]);#assert u.status==LgStatus.ok && lc_same(u.turn,t);
    for k:0..<t.steps {#assert lc_step(steps[k],want[k]);}
    scratch:[48]int;#assert lg_replay(hl_scripted(tb[..],tr[..],ts[..],context),l[0],1,steps[..],scratch[..])==LgStatus.ok;
}
// Rewrite sequence, links, content digests and digests in order, as someone
// who can write the whole log would after editing it.
lc_rechain :: (events:[]LgEvent,n:int,tokens:[]int) {
    at:=0;previous:[32]u8;
    for i:0..<n {
        e:=events[i];e.sequence=i;e.previous=previous;
        if !e.redacted {e.content=lg_content(tokens[at..<at+e.count]);}
        e.digest=lg_digest(e);events[i]=e;previous=e.digest;at+=e.count;
    }
}
