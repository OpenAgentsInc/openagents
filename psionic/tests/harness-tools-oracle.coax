// Chapter 203's independent checks: random small registries, every call
// they allow written out by enumeration, and the compiled grammar's
// language counted path by path. It is written apart from
// psionic/lib/harness/tools.coax and shares none of its building code; it
// reads the subject's types only to hand it registries.
// A registry: up to three tools named from f, fg, g (two share a prefix),
// each with up to two fields named from a, b, c; a field is an integer of
// one digit, a boolean, or one of one to three words from a, ab, abc, b.
TO_NAMES :: [3]string.["f","fg","g"];
TO_FIELDS :: [3]string.["a","b","c"];
TO_WORDS :: [4]string.["a","ab","abc","b"];
TO_CALLS_MAX :: 400;
// Storage: field j of tool t is fields[3*t+j]; its words start at words[4*(3*t+j)].
to_bits :: (seed:u64,k:int,n:int)->int {return cast(int)(cr_bits(seed,cast(u64)(5000+k))%cast(u64)n);}
to_registry :: (seed:u64,fields:[]HtField,words:[]string,tools:[]HtTool)->int {
    count:=1+to_bits(seed,0,3);
    for t:0..<count {
        nf:=to_bits(seed,10+t,3);tools[t]=HtTool.{name=TO_NAMES[t],fields=fields[3*t..<3*t+nf],result=HtType.{kind=HtKind.boolean},cost=1};
        for j:0..<nf {
            at:=3*t+j;kind:=to_bits(seed,20+at,3);
            if kind==0 {fields[at]=HtField.{name=TO_FIELDS[j],type=HtType.{kind=HtKind.integer,digits=1}};}
            else if kind==1 {fields[at]=HtField.{name=TO_FIELDS[j],type=HtType.{kind=HtKind.boolean}};}
            else {nw:=1+to_bits(seed,40+at,3);first:=to_bits(seed,60+at,2);
                for k:0..<nw {words[4*at+k]=TO_WORDS[first+k];}
                fields[at]=HtField.{name=TO_FIELDS[j],type=HtType.{kind=HtKind.choice,choices=words[4*at..<4*at+nw]}};}
        }
    }
    return count;
}
to_values :: (t:HtType)->int {if t.kind==HtKind.integer {return 10;}if t.kind==HtKind.boolean {return 2;}return t.choices.count;}
to_size :: (t:HtTool)->int {n:=1;for f:t.fields {n*=to_values(f.type);}return n;}
to_add :: (out:[]u8,n:int,s:string)->int {for c,i:s {out[n+i]=c;}return n+s.count;}
// Call i of tool t, written out by hand: field j takes value (i / radix) % size.
to_write :: (t:HtTool,i:int,out:[]u8,values:[]int)->int {
    n:=to_add(out,0,t.name);n=to_add(out,n,"{");x:=i;
    for f,j:t.fields {
        if j>0 {n=to_add(out,n,",");}
        n=to_add(out,n,"\"");n=to_add(out,n,f.name);n=to_add(out,n,"\":");
        v:=x%to_values(f.type);x/=to_values(f.type);values[j]=v;
        if f.type.kind==HtKind.integer {out[n]='0'+cast(u8)v;n+=1;}
        else if f.type.kind==HtKind.boolean {n=to_add(out,n,ifx v==1 then "true" else "false");}
        else {n=to_add(out,n,"\"");n=to_add(out,n,f.type.choices[v]);n=to_add(out,n,"\"");}
    }
    return to_add(out,n,"}");
}
// Every call of the registry, concatenated: text[starts[c]..<starts[c+1]].
to_calls :: (tools:[]HtTool,text:[]u8,starts:[]int)->int {
    c:=0;starts[0]=0;v:[4]int;
    for t:tools {for i:0..<to_size(t) {starts[c+1]=starts[c]+to_write(t,i,text[starts[c]..<text.count],v[..]);c+=1;}}
    return c;
}
to_member :: (text:[]u8,starts:[]int,count:int,s:string)->bool {
    for c:0..<count {if cast(string)text[starts[c]..<starts[c+1]]==s {return true;}}
    return false;
}
// The number of strings the table accepts, counted path by path. It holds
// only when every edge points to a lower state, which it checks first;
// -1 otherwise.
to_language :: (g:NxGrammar)->int {
    ways:[512]int;for s:0..<g.states {ways[s]=0;}ways[g.start]=1;total:=0;
    for k:0..<g.states {s:=g.start-k;if s>=0 {
        for b:0..<256 {t:=g.next[s*256+b];if t>=s {return -1;}if t>=0 {ways[t]+=ways[s];}}}}
    for s:0..<g.states {if g.accepting[s]==1 {total+=ways[s];}}
    return total;
}
// A random edit of a string: replace, delete or insert one byte.
TO_ALPHABET :: "{}\":,0123456789abcfgtrueflsxy ";
to_edit :: (seed:u64,k:int,s:string,out:[]u8)->int {
    kind:=to_bits(seed,1000+3*k,3);at:=to_bits(seed,1001+3*k,s.count+1);c:=TO_ALPHABET[to_bits(seed,1002+3*k,TO_ALPHABET.count)];n:=0;
    for i:0..<s.count {
        if i==at && kind==2 {out[n]=c;n+=1;}
        if i!=at || kind!=1 {out[n]=ifx i==at && kind==0 then c else s[i];n+=1;}
    }
    if at==s.count && kind!=1 {out[n]=c;n+=1;}
    return n;
}
// A grant of the given tools and call budgets, cost 10, any effect.
to_grant_all :: (tools:[]int,calls:[]int)->HtGrant {return HtGrant.{tools=tools,calls=calls,cost=10,effects=HtEffect.write};}
