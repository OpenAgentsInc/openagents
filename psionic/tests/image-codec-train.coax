// Chapter 145's recorded training run. It trains the codec for 1,500 steps,
// longer than the book's example may take in a debug build, and prints a
// Coax source file: the run's losses as comments, then the trained weights
// as f32 bit patterns. psionic/fixtures/image-codec-weights.coax is this
// program's output; regenerate and compare it with
//   coax/bin/coax run psionic/tests/image-codec-train.coax --release | diff - psionic/fixtures/image-codec-weights.coax
#import "Basic";
#load "../lib/image-codec.coax";

TRAIN :: 192;
STEPS :: 1500;

main :: () {
    train:[TRAIN*CZ_PIXELS]f32;
    for k:0..<TRAIN {cz_image(k,train[k*CZ_PIXELS..<(k+1)*CZ_PIXELS]);}
    params:[CZ_PARAMS]f64;m:[CZ_PARAMS]f64;v:[CZ_PARAMS]f64;losses:[STEPS]f64;cz_init(params[..],7);
    cfg:=CzTrain.{steps=STEPS,batch=16,lr=0.01};
    status:=cz_train(params[..],m[..],v[..],train[..],TRAIN,cfg,losses[..]);
    print("// Generated by psionic/tests/image-codec-train.coax: images 0..191, %\n",status);
    print("// % AdamW steps of 16 images through the quantizer, rate % halved after each quarter, init seed 7.\n",STEPS,cfg.lr);
    for t:0..<STEPS {if t%250==0 || t==STEPS-1 {print("// step %: loss %\n",t,floor(losses[t]*1000000+0.5)/1000000);}}
    print("CZ_TRAINED :: [%]u32.[",CZ_PARAMS);
    for i:0..<CZ_PARAMS {
        if i%12==0 {print("\n    ");}
        print("%",f32_bits(f32(params[i])));
        if i<CZ_PARAMS-1 {print(",");}
    }
    print("\n];\n");
}
