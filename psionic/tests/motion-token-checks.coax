// Chapter 148's check oracles and fixtures, loaded by psionic/lib/motion-token.coax:
// the hand codebook and clip, a bit-exact clip comparison, a matrix-free
// rotation distance and a brute-force nearest code.

// The hand codebook: one joint, one frame a token, turns of 0, 45 and 90
// degrees about X with root steps of 0, 0.25 and 0.5 m along Z.
mt_hand_codebook :: ()->MtCodebook {
    b:MtCodebook;b.convention=pose_gltf();b.joints=1;b.codes=3;b.segment=1;b.root_weight=1;
    for e:0..<3 {b.entry[e][0].rotation[0]=mt_x(45*f64(e));b.entry[e][0].root=[3]f64.[0,0,0.25*f64(e)];}
    return b;
}
mt_one_joint :: ()->PoseSkeleton {s:PoseSkeleton;s.count=1;s.parent[0]= -1;return s;}
mt_hand_clip :: ()->PoseClip {
    c:PoseClip;c.convention=pose_gltf();c.frames=3;
    angles:=[3]f64.[0,50,80];z:=[3]f64.[0,0.25,0.75];
    for k:0..<3 {c.frame[k].rotation[0]=mt_x(angles[k]);c.frame[k].root=[3]f64.[0,0,z[k]];}
    return c;
}
// Trained on 0122, 0120 and 0012.
mt_hand_model :: ()->MtModel {
    m:=mt_model(3);
    for q:[3]string.["0122","0120","0012"] {m=mt_train(m,mt_parse(q)).model;}
    return m;
}
// The knee's part of the stand-to-first-walk distance: frame 1 of the walk
// bends the knee 20 (1 - cos 30) degrees.
mt_gait_knee_term :: ()->f64 {s:=sin(20*(1-cos(POSE_PI/6))*POSE_PI/180/2);return 4*s*s;}
// Equal frame counts and the same bits in every root and declared rotation.
mt_same_frames :: (a:PoseClip,b:PoseClip,joints:int)->bool {
    if a.frames!=b.frames {return false;}
    for k:0..<a.frames {
        for i:0..<3 {if f64_bits(a.frame[k].root[i])!=f64_bits(b.frame[k].root[i]) {return false;}}
        for j:0..<joints {for i:0..<4 {if f64_bits(a.frame[k].rotation[j][i])!=f64_bits(b.frame[k].rotation[j][i]) {return false;}}}
    }
    return true;
}
// Oracle: with r = conj(a) b = (w, x, y, z), the first two columns of the
// two matrices differ by 4 - 2 (R00 + R11) = 4 (x^2 + y^2) + 8 z^2.
mt_oracle_turn :: (a:[4]f64,b:[4]f64)->f64 {
    r:=pfk_multiply([4]f64.[a[0],-a[1],-a[2],-a[3]],b);return 4*(r[1]*r[1]+r[2]*r[2])+8*r[3]*r[3];
}
// Every code's squared distance to token i of a working clip, by the oracle,
// and each code's rank: how many codes are closer, or as close with a lower
// number. The nearest code is the one of rank 0.
MtOracle :: struct {token:int;zeros:int;distance:[MT_CODES]f64;}
mt_oracle :: (b:MtCodebook,w:PoseClip,token:int)->MtOracle {
    out:MtOracle;
    for e:0..<b.codes {
        sum:f64=0;
        for k:0..<b.segment {
            f:=token*b.segment+k;
            for j:0..<b.joints {sum+=mt_oracle_turn(w.frame[f].rotation[j],b.entry[e][k].rotation[j]);}
            if f>0 {for i:0..<3 {d:=w.frame[f].root[i]-w.frame[f-1].root[i]-b.entry[e][k].root[i];sum+=b.root_weight*d*d;}}
        }
        out.distance[e]=sum;
    }
    out.token= -1;
    for e:0..<b.codes {
        rank:=0;
        for o:0..<b.codes {if out.distance[o]<out.distance[e] || (o<e && out.distance[o]==out.distance[e]) {rank+=1;}}
        if rank==0 {out.token=e;out.zeros+=1;}
    }
    return out;
}
