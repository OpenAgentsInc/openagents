// Chapter 53's independent checks for psionic/lib/next-token-schema.coax:
// random small schemas, a validator that reads a schema and a text and says
// whether the text is the schema's canonical JSON, and a counter that says
// how many such texts there are of each length. It is written apart from the
// compiler and shares none of its building code; it reads the schema through
// the same JSON tree (psionic/lib/responses/json.coax).
// Canonical JSON here: no whitespace, object keys in the order the schema's
// properties are written, strings of printable ASCII without " or \,
// integers without leading zeros and without -0.
OS_CAP :: 1000000000000;
OS_WORDS :: [5]string.["","a","ab","b","ba"];
OS_NAMES :: [3]string.["a","ab","b"];
OS_CLASSES :: [4]string.["^[ab]*$","^[a-c]*$","^[x]*$","^[b-ba]*$"];
OsText :: struct {data:[]u8;at:int;}

os_bits :: (seed:u64,k:int,n:int)->int {return cast(int)(cr_bits(seed,cast(u64)(7000+k))%cast(u64)n);}
os_put :: (w:[]OsText,s:string) {for c:s {w[0].data[w[0].at]=c;w[0].at+=1;}}
os_number :: (w:[]OsText,v:int) {
    if v<0 {os_put(w,"-");}
    m:=ifx v<0 then -v else v;digits:[12]u8;n:=0;
    while true {digits[n]=cast(u8)('0'+m%10);n+=1;m/=10;if m==0 {break;}}
    while n>0 {n-=1;w[0].data[w[0].at]=digits[n];w[0].at+=1;}
}
// A random schema as JSON text; k numbers the draws. Returns the next k.
os_schema :: (seed:u64,w:[]OsText,depth:int,k0:int)->int {
    k:=k0;kind:=os_bits(seed,k,ifx depth>=3 then 4 else 6);k+=1;
    if kind==0 {
        lo:=os_bits(seed,k,151)-130;hi:=lo+os_bits(seed,k+1,151);k+=2;
        os_put(w,"{\"type\":\"integer\",\"minimum\":");os_number(w,lo);os_put(w,",\"maximum\":");os_number(w,hi);os_put(w,"}");
    } else if kind==1 {
        os_put(w,ifx os_bits(seed,k,2)==0 then "{\"type\":\"boolean\"}" else "{\"type\":\"null\",\"title\":\"nothing\"}");k+=1;
    } else if kind==2 {
        first:=os_bits(seed,k,5);n:=1+os_bits(seed,k+1,3);k+=2;
        os_put(w,"{\"type\":\"string\",\"enum\":[");
        for j:0..<n {if j>0 {os_put(w,",");}os_put(w,"\"");os_put(w,OS_WORDS[(first+j)%5]);os_put(w,"\"");}
        os_put(w,"]}");
    } else if kind==3 {
        c:=os_bits(seed,k,5);lo:=os_bits(seed,k+1,2);more:=os_bits(seed,k+2,4);k+=3;
        os_put(w,"{\"type\":\"string\"");
        if c<4 {os_put(w,",\"pattern\":\"");os_put(w,OS_CLASSES[c]);os_put(w,"\"");}
        if lo>0 {os_put(w,",\"minLength\":");os_number(w,lo);}
        // Without a class every printable byte is allowed, so the length is always bounded.
        if more<3 || c==4 {os_put(w,",\"maxLength\":");os_number(w,lo+more%3);}
        os_put(w,"}");
    } else if kind==4 {
        n:=os_bits(seed,k,3);first:=os_bits(seed,k+1,2);back:=os_bits(seed,k+2,2);closed:=os_bits(seed,k+3,2);k+=4;
        os_put(w,"{\"type\":\"object\",\"properties\":{");
        for j:0..<n {if j>0 {os_put(w,",");}os_put(w,"\"");os_put(w,OS_NAMES[first+j]);os_put(w,"\":");k=os_schema(seed,w,depth+1,k);}
        os_put(w,"},\"required\":[");
        for j:0..<n {if j>0 {os_put(w,",");}x:=ifx back==1 then n-1-j else j;os_put(w,"\"");os_put(w,OS_NAMES[first+x]);os_put(w,"\"");}
        os_put(w,"]");if closed==1 {os_put(w,",\"additionalProperties\":false");}os_put(w,"}");
    } else {
        most:=os_bits(seed,k,3);least:=os_bits(seed,k+1,most+2);k+=2;
        os_put(w,"{\"type\":\"array\",\"items\":");k=os_schema(seed,w,depth+1,k);
        os_put(w,",\"maxItems\":");os_number(w,most);
        if least<=most {os_put(w,",\"minItems\":");os_number(w,least);}
        os_put(w,"}");
    }
    return k;
}

// The schema's numbers and class, read straight from the tree.
os_get :: (nodes:[]RsNode,i:int,key:string,missing:int)->int {
    x:=rs_get(nodes,i,key);if x<0 {return missing;}
    t:=nodes[x].text;v:=0;neg:=t[0]=='-';
    for c:t {if c!='-' {v=v*10+cast(int)(c-'0');}}
    return ifx neg then -v else v;
}
os_plain :: (c:u8)->bool {return c>=32 && c<=126 && c!='"' && c!='\\';}
// The pattern ^[...]*$ as a byte test, item by item.
os_in :: (pattern:string,c:u8)->bool {
    if pattern.count==0 {return os_plain(c);}
    body:=pattern[2..<pattern.count-3];k:=0;
    while k<body.count {
        if k+2<body.count && body[k+1]=='-' {if c>=body[k] && c<=body[k+2] {return true;}k+=3;}
        else {if c==body[k] {return true;}k+=1;}
    }
    return false;
}
os_starts :: (text:string,at:int,s:string)->bool {return at+s.count<=text.count && text[at..<at+s.count]==s;}

// The end of the value of schema i that starts at at, or -1.
os_valid :: (nodes:[]RsNode,i:int,text:string,at:int)->int {
    kind:=rs_string(nodes,rs_get(nodes,i,"type"));p:=at;
    if kind=="null" {return ifx os_starts(text,p,"null") then p+4 else -1;}
    if kind=="boolean" {if os_starts(text,p,"true") {return p+4;}return ifx os_starts(text,p,"false") then p+5 else -1;}
    if kind=="integer" {
        neg:=p<text.count && text[p]=='-';if neg {p+=1;}
        begin:=p;v:=0;while p<text.count && text[p]>='0' && text[p]<='9' && p-begin<12 {v=v*10+cast(int)(text[p]-'0');p+=1;}
        if p==begin || (text[begin]=='0' && p-begin>1) || (neg && v==0) {return -1;}
        if neg {v= -v;}
        return ifx v>=os_get(nodes,i,"minimum",0) && v<=os_get(nodes,i,"maximum",0) then p else -1;
    }
    if kind=="string" {
        if !os_starts(text,p,"\"") {return -1;}p+=1;begin:=p;
        while p<text.count && text[p]!='"' {p+=1;}
        if p==text.count {return -1;}
        s:=text[begin..<p];
        e:=rs_get(nodes,i,"enum");
        if e>=0 {found:=false;k:=e+1;while k<nodes[e].next {if nodes[k].text==s {found=true;}k=nodes[k].next;}return ifx found then p+1 else -1;}
        pattern:=rs_string(nodes,rs_get(nodes,i,"pattern"));
        for c:s {if !os_in(pattern,c) {return -1;}}
        if s.count<os_get(nodes,i,"minLength",0) || s.count>os_get(nodes,i,"maxLength",1000000) {return -1;}
        return p+1;
    }
    if kind=="object" {
        if !os_starts(text,p,"{") {return -1;}p+=1;props:=rs_get(nodes,i,"properties");k:=props+1;first:=true;
        while k<nodes[props].next {
            if !first {if !os_starts(text,p,",") {return -1;}p+=1;}
            first=false;
            if !os_starts(text,p,"\"") || !os_starts(text,p+1,nodes[k].key) || !os_starts(text,p+1+nodes[k].key.count,"\":") {return -1;}
            p=os_valid(nodes,k,text,p+3+nodes[k].key.count);if p<0 {return -1;}
            k=nodes[k].next;
        }
        return ifx os_starts(text,p,"}") then p+1 else -1;
    }
    // array
    if !os_starts(text,p,"[") {return -1;}p+=1;items:=rs_get(nodes,i,"items");n:=0;
    if !os_starts(text,p,"]") {
        while true {p=os_valid(nodes,items,text,p);if p<0 {return -1;}n+=1;if !os_starts(text,p,",") {break;}p+=1;}
        if !os_starts(text,p,"]") {return -1;}
    }
    if n<os_get(nodes,i,"minItems",0) || n>os_get(nodes,i,"maxItems",0) {return -1;}
    return p+1;
}
os_accepts :: (nodes:[]RsNode,text:string)->bool {return os_valid(nodes,0,text,0)==text.count;}

// How many canonical texts schema i has of each length 0..L, saturating at OS_CAP.
os_add :: (a:int,b:int)->int {return ifx a+b>OS_CAP then OS_CAP else a+b;}
os_mul :: (a:int,b:int)->int {if a==0 || b==0 {return 0;}return ifx a>OS_CAP/b then OS_CAP else a*b;}
// out = a followed by b, lengths added.
os_join :: (a:[]int,b:[]int,out:[]int) {
    t:[65]int;for x:0..<out.count {for y:0..<out.count-x {t[x+y]=os_add(t[x+y],os_mul(a[x],b[y]));}}
    for x:0..<out.count {out[x]=t[x];}
}
os_shift :: (a:[]int,by:int) {x:=a.count-1;while x>=0 {a[x]=ifx x>=by then a[x-by] else 0;x-=1;}}
os_digits :: (v:int)->int {m:=ifx v<0 then -v else v;n:=1;while m>=10 {m/=10;n+=1;}return ifx v<0 then n+1 else n;}
os_count :: (nodes:[]RsNode,i:int,out:[]int) {
    for x:0..<out.count {out[x]=0;}L:=out.count-1;
    kind:=rs_string(nodes,rs_get(nodes,i,"type"));
    if kind=="null" {out[4]=1;return;}
    if kind=="boolean" {out[4]=1;out[5]=1;return;}
    if kind=="integer" {for v:os_get(nodes,i,"minimum",0)..<os_get(nodes,i,"maximum",0)+1 {d:=os_digits(v);if d<=L {out[d]+=1;}}return;}
    if kind=="string" {
        e:=rs_get(nodes,i,"enum");
        if e>=0 {k:=e+1;while k<nodes[e].next {if nodes[k].text.count+2<=L {out[nodes[k].text.count+2]+=1;}k=nodes[k].next;}return;}
        pattern:=rs_string(nodes,rs_get(nodes,i,"pattern"));size:=0;for c:32..<127 {if os_in(pattern,cast(u8)c) {size+=1;}}
        ways:=1;for n:0..<L-1 {
            if n>=os_get(nodes,i,"minLength",0) && n<=os_get(nodes,i,"maxLength",1000000) {out[n+2]=ways;}
            ways=os_mul(ways,size);
        }
        return;
    }
    if kind=="object" {
        out[2]=1;props:=rs_get(nodes,i,"properties");k:=props+1;first:=true;child:[65]int;
        while k<nodes[props].next {
            os_count(nodes,k,child[0..<out.count]);os_shift(child[0..<out.count],nodes[k].key.count+3+(ifx first then 0 else 1));
            os_join(out,child[0..<out.count],out);first=false;k=nodes[k].next;
        }
        return;
    }
    items:=rs_get(nodes,i,"items");one:[65]int;os_count(nodes,items,one[0..<out.count]);
    run:[65]int;run[2]=1;
    for n:0..<os_get(nodes,i,"maxItems",0)+1 {
        if n>=os_get(nodes,i,"minItems",0) {for x:0..<out.count {out[x]=os_add(out[x],run[x]);}}
        // One more item: a comma when there was one before, then the item.
        if n>0 {os_shift(run[0..<out.count],1);}
        os_join(run[0..<out.count],one[0..<out.count],run[0..<out.count]);
    }
}

// Each state's bytes with a live target, as lists: bytes[lists[s]..<lists[s+1]].
os_lists :: (g:NxGrammar,bytes:[]u8,lists:[]int) {
    n:=0;for s:0..<g.states {lists[s]=n;for b:0..<256 {t:=g.next[s*256+b];if t>=0 && g.live[t]==1 {bytes[n]=cast(u8)b;n+=1;}}}
    lists[g.states]=n;
}
// The compiled table's strings of each length 0..L, counted path by path.
os_table :: (g:NxGrammar,out:[]int) {
    ways:[4096]int;next:[4096]int;for s:0..<g.states {ways[s]=0;}ways[g.start]=1;
    for n:0..<out.count {
        out[n]=0;for s:0..<g.states {if g.accepting[s]==1 {out[n]=os_add(out[n],ways[s]);}next[s]=0;}
        for s:0..<g.states {if ways[s]>0 {for b:0..<256 {t:=g.next[s*256+b];if t>=0 {next[t]=os_add(next[t],ways[s]);}}}}
        for s:0..<g.states {ways[s]=next[s];}
    }
}
// Every string the table accepts, up to L bytes, each handed to the validator
// and kept in found (48 bytes a slot); bad counts those the validator refused.
OsWalk :: struct {found:[]u8;size:[]int;count:int;bad:int;}
os_walk :: (g:NxGrammar,bytes:[]u8,lists:[]int,s:int,text:[]u8,n:int,L:int,nodes:[]RsNode,w:[]OsWalk) {
    if g.accepting[s]==1 {
        if !os_accepts(nodes,cast(string)text[0..<n]) {w[0].bad+=1;}
        if w[0].count<w[0].size.count {for i:0..<n {w[0].found[w[0].count*48+i]=text[i];}w[0].size[w[0].count]=n;}
        w[0].count+=1;
    }
    if n<L {for k:lists[s]..<lists[s+1] {b:=bytes[k];text[n]=b;os_walk(g,bytes,lists,g.next[s*256+cast(int)b],text,n+1,L,nodes,w);}}
}
// A random edit of a string: replace, delete or insert one byte.
OS_ALPHABET :: "{}[]\":,-0123456789abcxtrueflsn ";
os_edit :: (seed:u64,k:int,s:string,out:[]u8)->int {
    kind:=os_bits(seed,1000+3*k,3);at:=os_bits(seed,1001+3*k,s.count+1);c:=OS_ALPHABET[os_bits(seed,1002+3*k,OS_ALPHABET.count)];n:=0;
    for i:0..<s.count {
        if i==at && kind==2 {out[n]=c;n+=1;}
        if i!=at || kind!=1 {out[n]=ifx i==at && kind==0 then c else s[i];n+=1;}
    }
    if at==s.count && kind!=1 {out[n]=c;n+=1;}
    return n;
}

// The subject's refusal of text: why, the keyword and the node, and no states.
ns_refuse :: (w:NsWork,text:string,why:NsWhy,keyword:string,node:int) {s:=nx_schema(text,w);#assert s.why==why && s.keyword==keyword && s.node==node && s.states==0;}
// An integer schema lo..hi against brute force around both bounds.
check_range :: (w:NsWork,lo:int,hi:int) {
    b:[256]u8;t:=[1]OsText.[OsText.{data=b[..]}];os_put(t[..],"{\"type\":\"integer\",\"minimum\":");os_number(t[..],lo);os_put(t[..],",\"maximum\":");os_number(t[..],hi);os_put(t[..],"}");
    s:=nx_schema(cast(string)b[0..<t[0].at],w);#assert s.why==NsWhy.none;
    probe:=[12]int.[lo-1,lo,lo+1,hi-1,hi,hi+1,0,-1,1,lo/2+hi/2,-lo,-hi];
    for v:probe {x:[16]u8;u:=[1]OsText.[OsText.{data=x[..]}];os_number(u[..],v);#assert nx_accepts(s.grammar,cast(string)x[0..<u[0].at])==(v>=lo && v<=hi);}
    if hi-lo<=2000 {for v:lo-20..<hi+21 {x:[16]u8;u:=[1]OsText.[OsText.{data=x[..]}];os_number(u[..],v);#assert nx_accepts(s.grammar,cast(string)x[0..<u[0].at])==(v>=lo && v<=hi);}}
    #assert !nx_accepts(s.grammar,"-0") && !nx_accepts(s.grammar,"") && !nx_accepts(s.grammar,"-") && !nx_accepts(s.grammar,"01") && !nx_accepts(s.grammar,"+1");
}
