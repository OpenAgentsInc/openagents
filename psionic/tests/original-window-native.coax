// Nonfinite and complete BF16-codepoint checks stay in Coax.
#load "../lib/original-window.coax";
#load "../lib/original-proposal.coax";
original_window_native_checks :: ()->int #export_c {
    w:=OwWindow.{name="native",rows=1,cols=1,count=1};source:=[2]u8.[128,63];pin:=ow_identity(w,source[..]);
    for bits:[5]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001,0x7ff0000000000001,0xfff8000000000001] {
        p:=[1]f64.[f64_from_bits(bits)];r:=ow_apply(w,source[..],pin.digest,p[..]);#assert r.status==OwStatus.number && r.count==0 && r.changed==0;for b:r.bytes {#assert b==0;}
    }
    for code:0..<65536 {if (code&0x7f80)==0x7f80 {continue;}bytes:=[2]u8.[cast(u8)(code&255),cast(u8)(code>>8)];v:=ow_value(bytes[..],0,OwType.bf16);#assert ow_encoded(v,OwType.bf16)==cast(u32)code;}
    #assert op_parse("[1,2,-4]").valid && !op_parse("[1,2,1.0]").valid;return 0;
}
