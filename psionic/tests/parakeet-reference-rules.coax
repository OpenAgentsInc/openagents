];
#forall "actual NeMo forced-logit TDT cap traces preserve token frame and duration outputs" scenario:0..<13 {
 c:=PK_NEMO_RULES[scenario];s:=tdt_durations(TdtShape.{vocab=2,enc=1,pred=1,layers=1,joint=1,max_symbols=c.cap},5);
 t:=0;symbols:=0;calls:=0;written:=0;
 while t<c.frames {
  duration:=c.duration;if c.alternating {duration=ifx calls%2==0 then 0 else 2;}
  got:=tdt_rule(s,t,symbols,c.token,duration);
  if got.emit {#assert written<c.count && c.ids[written]==c.token && c.at[written]==t && c.dur[written]==duration;written+=1;}
  t=got.t;symbols=got.symbols;calls+=1;#assert calls<=c.frames*c.cap;
 }
 #assert written==c.count;
}
