// This checks observable emitted IDs/frames/durations, not the number of
// repeated blank-duration-zero calls: Coax safely skips those equivalent blanks.
#load "../lib/tdt.coax";
PkNeMoRule :: struct {frames:int;cap:int;token:int;alternating:bool;duration:int;count:int;ids:[20]int;at:[20]int;dur:[20]int;}
