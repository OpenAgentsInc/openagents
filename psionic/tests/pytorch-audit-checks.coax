// Chapter 250's model descriptions: two models chapter 118 trains and the
// three published PyTorch tutorials, each as its layers in order. Every
// count is derived by hand from the layer sizes in chapter 250.
pa_model :: (ops:[]int,parameters:int,nodes:int,rows:int)->PaModel {
    m:=PaModel.{count=ops.count,parameters=parameters,nodes=nodes,rows=rows,dtype=PaDtype.f32,device=PaDevice.cpu};
    for i:0..<ops.count {m.ops[i]=ops[i];}
    return m;
}
// Chapter 118's MNIST MLP: Linear, ReLU, Linear, MSELoss.
pa_mlp :: ()->PaModel {o:=[4]int.[0,1,0,4];return pa_model(o[..],3322,17,4096);}
// Chapter 118's MNIST CNN: Conv2d, ReLU, Flatten, Linear, MSELoss.
pa_cnn :: ()->PaModel {o:=[5]int.[2,1,3,0,4];return pa_model(o[..],2910,18,4096);}
// PyTorch's quickstart classifier on FashionMNIST: Flatten, Linear(784, 512),
// ReLU, Linear(512, 512), ReLU, Linear(512, 10), CrossEntropyLoss.
// 784*512+512 + 512*512+512 + 512*10+10 = 669,706 parameters; 60,000
// training images; 23 IR nodes as chapter 118 counts them (2 data, 4 per
// Linear, 1 per ReLU, 1 for Flatten, 6 for the loss).
pa_quickstart :: ()->PaModel {o:=[7]int.[3,0,1,0,1,0,21];return pa_model(o[..],669706,23,60000);}
// PyTorch's CIFAR-10 CNN tutorial: Conv2d, ReLU, MaxPool2d, Conv2d, ReLU,
// MaxPool2d, Flatten, Linear, ReLU, Linear, ReLU, Linear, CrossEntropyLoss.
// 456 + 2,416 + 48,120 + 10,164 + 850 = 62,006 parameters; 50,000 images.
// Its IR nodes are not counted (0): an operator refuses it first.
pa_cifar :: ()->PaModel {o:=[13]int.[2,1,22,2,1,22,3,0,1,0,1,0,21];return pa_model(o[..],62006,0,50000);}
// PyTorch's nn.Transformer language-model tutorial: Embedding, the sine
// positional encoding, Dropout, two TransformerEncoderLayers (attention,
// LayerNorm, Linear, ReLU, Dropout inside), Linear, CrossEntropyLoss. With
// its settings (28,782 tokens, width 200, two layers): 5,756,400 embedding
// + 2 * 242,000 per layer + 5,785,182 readout = 12,025,582 parameters. Its
// nodes and rows are not counted (0): an operator refuses it first.
pa_transformer :: ()->PaModel {o:=[7]int.[24,30,11,26,26,0,21];return pa_model(o[..],12025582,0,0);}
#test "the parameter counts follow from the published layer sizes" {
    #assert pa_mlp().parameters==196*16+16+16*10+10;
    #assert pa_cnn().parameters==2*3*3+2+288*10+10;
    #assert pa_quickstart().parameters==784*512+512+512*512+512+512*10+10;
    #assert pa_cifar().parameters==(6*3*5*5+6)+(16*6*5*5+16)+(400*120+120)+(120*84+84)+(84*10+10);
    layer:=(3*200*200+3*200)+(200*200+200)+(200*200+200)+(200*200+200)+2*(200+200);
    #assert layer==242000 && pa_transformer().parameters==28782*200+2*layer+(200*28782+28782);
}
#test "each description, field by field" {
    m:=pa_mlp();#assert m.count==4 && m.ops[0]==0 && m.ops[1]==1 && m.ops[2]==0 && m.ops[3]==4 && m.nodes==17 && m.rows==4096;
    #assert m.dtype==PaDtype.f32 && m.device==PaDevice.cpu;
    m=pa_cnn();#assert m.count==5 && m.ops[0]==2 && m.ops[1]==1 && m.ops[2]==3 && m.ops[3]==0 && m.ops[4]==4 && m.nodes==18 && m.rows==4096;
    m=pa_quickstart();#assert m.count==7 && m.nodes==23 && m.rows==60000;
    for i:0..<7 {#assert m.ops[i]==[7]int.[3,0,1,0,1,0,21][i];}
    m=pa_cifar();#assert m.count==13 && m.nodes==0 && m.rows==50000;
    for i:0..<13 {#assert m.ops[i]==[13]int.[2,1,22,2,1,22,3,0,1,0,1,0,21][i];}
    m=pa_transformer();#assert m.count==7 && m.nodes==0 && m.rows==0;
    for i:0..<7 {#assert m.ops[i]==[7]int.[24,30,11,26,26,0,21][i];}
}
