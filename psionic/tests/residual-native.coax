// Native verification exports only. All caller spans are live and disjoint.
#load "../lib/module-residual.coax";
#load "../lib/module-train.coax";
residual_native_vjp :: (x:[]f32,a:[]f32,b:[]f32,c:[]f32,d:[]f32,dy:[]f32,y:[]f32,gx:[]f32,ga:[]f32,gb:[]f32,gc:[]f32,gd:[]f32,loss:[]f32)->AdStatus #export_c {
    if x.count!=12 || a.count!=6 || b.count!=3 || c.count!=6 || d.count!=2 || dy.count!=12 || y.count!=12 || gx.count!=12 || ga.count!=6 || gb.count!=3 || gc.count!=6 || gd.count!=2 || loss.count!=1 {return AdStatus.capacity;}
    m:=mr_test_block();prediction:=m.node;forward:=m;
    m=mdl_data(m,"dy",m.shapes[prediction]);upstream:=m.node;
    m=mdl_op(m,TiOp.multiply,prediction,upstream);for pass:0..<4 {m=mdl_op(m,TiOp.sum,m.node,0);}
    mode:=mdl_mode(m);mode.grad[0]=true;t:=ad_tape(m.program,mode,OrRegistry.{});if t.status!=AdStatus.ok {return t.status;}
    inputs:[41]f32;for i:0..<12 {inputs[i]=x[i];inputs[29+i]=dy[i];}for i:0..<6 {inputs[12+i]=a[i];inputs[21+i]=c[i];}for i:0..<3 {inputs[18+i]=b[i];}for i:0..<2 {inputs[27+i]=d[i];}
    values:[512]f32;grads:[512]f64;flags:[128]u8;
    ys:[12]f32;xs:[12]f32;as:[6]f32;bs:[3]f32;cs:[6]f32;ds:[2]f32;ls:[1]f32;
    inference:=ad_tape(forward.program,AdMode.{enabled=false},OrRegistry.{});
    ir:=ad_run(inference,AdCursor.{},inputs[..],values[..],grads[..],flags[..]);if ir.status!=AdStatus.ok {return ir.status;}
    s:=ad_value(inference,ir.cursor,prediction,inputs[..],values[..],ys[..]);if s!=AdStatus.ok {return s;}
    run:=ad_run(t,AdCursor.{},inputs[..],values[..],grads[..],flags[..]);if run.status!=AdStatus.ok {return run.status;}
    s=ad_value(t,run.cursor,m.program.output,inputs[..],values[..],ls[..]);if s!=AdStatus.ok {return s;}
    s=ad_gradient(t,run.cursor,0,grads[..],xs[..]);if s!=AdStatus.ok {return s;}
    s=ad_gradient(t,run.cursor,1,grads[..],as[..]);if s!=AdStatus.ok {return s;}
    s=ad_gradient(t,run.cursor,2,grads[..],bs[..]);if s!=AdStatus.ok {return s;}
    s=ad_gradient(t,run.cursor,6,grads[..],cs[..]);if s!=AdStatus.ok {return s;}
    s=ad_gradient(t,run.cursor,7,grads[..],ds[..]);if s!=AdStatus.ok {return s;}
    for i:0..<12 {y[i]=ys[i];gx[i]=xs[i];}for i:0..<6 {ga[i]=as[i];gc[i]=cs[i];}for i:0..<3 {gb[i]=bs[i];}for i:0..<2 {gd[i]=ds[i];}loss[0]=ls[0];return AdStatus.ok;
}
residual_native_state :: ()->bool #export_c {
    m:=mr_test_block();inputs:[29]f32;other:[29]f32;
    if mdl_init(m,71,inputs[..])!=MdlStatus.ok || mdl_init(m,99,other[..])!=MdlStatus.ok {return false;}
    file:[4096]u8;stage:[4096]u8;saved:=mdl_save(m,inputs[..],file[..],stage[..]);
    if saved.status!=MdlStatus.ok || saved.tensors!=4 {return false;}
    fresh:=mr_test_block();loaded:=mdl_load(fresh,file[0..<saved.written],other[..],true);
    if loaded.status!=MdlStatus.ok || loaded.loaded!=4 {return false;}
    for e:m.entries[0..<m.count] {if mdl_saved(e) {for j:0..<e.size {if f32_bits(inputs[e.base+j])!=f32_bits(other[e.base+j]) {return false;}}}}
    f:=mdl_freeze(m,"block.expand",true);mode:=mdl_mode(f);
    if !f.entries[1].frozen || !f.entries[2].frozen || f.entries[3].frozen || mode.grad[1] || mode.grad[2] || !mode.grad[6] || !mode.grad[7] {return false;}
    for j:0..<f.count {if mdl_saved(f.entries[j])!=mdl_saved(m.entries[j]) {return false;}}
    return true;
}
