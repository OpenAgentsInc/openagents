// Native observation of the public decoded query API; independently authored action table.
#load "../../lib/robotics/experiment-policy.coax";
#load "../../lib/robotics/experiment-fixtures.coax";
experiment_native_checks :: ()->int #export_c #effects(all) {
  c:=rex_fixture();out:[2]RexTarget;
  samples:=[6]f64.[-1,-0.5,0,0.5,1,f64_from_bits(0x8000000000000000)];
  requested0:=[6]f64.[-0.2,0,0.2,0.4,0.6,0.2];limited0:=[6]f64.[-0.1,0,0.2,0.4,0.6,0.2];
  requested1:=[6]f64.[0.125,0,-0.125,-0.25,-0.375,-0.125];limited1:=[6]f64.[0.125,0,-0.125,-0.25,-0.25,-0.125];
  for k:0..<6 {
    a:=[2]f64.[samples[k],samples[k]];#assert rex_map(c,c.embodiment,a[..],out[..])==RexStatus.ok;
    #assert abs(out[0].requested.value-requested0[k])<1e-15 && abs(out[0].limited.value-limited0[k])<1e-15 && out[0].saturated==(k==0);
    #assert out[1].requested.value==requested1[k] && out[1].limited.value==limited1[k] && out[1].saturated==(k==4);
    #assert out[0].joint==0 && out[0].motor==1 && out[1].joint==1 && out[1].motor==0;
  }
  for role:0..<7 {for bits:[5]u64.[0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000001,0x7ff0000000000001,0xfff8000000000001] {
    bad:=c;value:=f64_from_bits(bits);a:=[2]f64.[0,0];out[0]=rex_poison();out[1]=rex_poison();
    if role==0 {bad.embodiment.joints[0].home.value=value;}if role==1 {bad.embodiment.joints[0].scale.value=value;}if role==2 {bad.embodiment.joints[0].low.value=value;}if role==3 {bad.embodiment.joints[0].high.value=value;}
    if role==4 {bad.observations[0].offset=value;}if role==5 {bad.observations[0].scale=value;}if role==6 {a[1]=value;}
    #assert rex_map(bad,bad.embodiment,a[..],out[..])==RexStatus.number;
    for p:out {rex_same_target(p,rex_poison());}
  }}
  // A late identity refusal preserves the complete descriptor, including inactive slots.
  kept:=[1]RexExperiment.[c];wrong:=c.embodiment;wrong.joints[1].sign=1;
  #assert rex_admit(c,wrong,kept[..])==RexStatus.identity;rex_same_experiment(kept[0],c);
  return 0;
}
