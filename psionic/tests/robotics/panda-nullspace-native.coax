// TEST-ONLY checked numerical bridge; public source queries own fresh FK/J.
#load "../../lib/robotics/panda-nullspace.coax";
#authority;
#test "Panda nullspace numeric probe shapes range rank and positive fixture publish atomically" {
 a:=pns_identity();d:[7]f64;d[6]=1;out:=[2]PnsOutput.[pns_poison(),pns_poison()];before:=out[0];#assert pns_math_probe(a[0..<41],d[..],out[0..<1])==PnsStatus.shape && pns_math_probe(a[..],d[0..<6],out[0..<1])==PnsStatus.shape && pns_math_probe(a[..],d[..],out[..])==PnsStatus.shape;
 a[0]=5;#assert pns_math_probe(a[..],d[..],out[0..<1])==PnsStatus.range;a=pns_identity();d[0]=7;#assert pns_math_probe(a[..],d[..],out[0..<1])==PnsStatus.range;d[0]=0;a[0]=0;#assert pns_math_probe(a[..],d[..],out[0..<1])==PnsStatus.rank;pns_same(out[0],before);pns_same(out[1],before);
 a=pns_identity();#assert pns_math_probe(a[..],d[..],out[0..<1])==PnsStatus.ok && out[0].direction[6].value==1 && out[0].projected_delta[6].value==1 && out[0].normalized_volume.value==1;
 words:[49]u64;#assert pns_math_bits(words)==PnsStatus.ok;for i:0..<49 {words[i]=0x7ff8000000000001;#assert pns_math_bits(words)==PnsStatus.number;words[i]=f64_bits(ifx i<42 then 5.0 else 7.0);#assert pns_math_bits(words)==PnsStatus.range;words[i]=0;}
 residual:=[5]u64.[0,0,0,0,0];#assert pns_residual_probe(residual[..])==PnsStatus.shape && pns_residual_probe(residual[0..<3])==PnsStatus.shape && pns_residual_probe(residual[0..<4])==PnsStatus.ok;
}
#test "Panda nullspace probe endpoints and dense copies preserve coefficient role identity" {
 words:[49]u64;for i:0..<49 {words[i]=f64_bits(ifx i<42 then 4.0 else 6.0);#assert pns_math_bits(words)==PnsStatus.ok;words[i]=0;}
 a:=pns_identity();d:[7]f64;out:[1]PnsOutput;for i:0..<7 {d[i]=6;#assert pns_math_probe(a[..],d[..],out[..])==PnsStatus.ok;d[i]=0;}
 v:=[6]f64.[1,-2,3,-4,0.5,-0.25];for i:0..<6 {a[i*7+6]=v[i];}d=[7]f64.[1,2,-1,0.5,-0.25,0.75,-1];#assert pns_math_probe(a[..],d[..],out[..])==PnsStatus.ok;c:=[7]f64.[-1,2,-3,4,-0.5,0.25,1];square:f64=0;dot:f64=0;for i:0..<7 {square+=c[i]*c[i];dot+=c[i]*d[i];}for i:0..<7 {#assert abs(out[0].direction[i].value-c[i]/sqrt(square))<2e-12 && abs(out[0].projected_delta[i].value-c[i]*dot/square)<2e-12;}
 residual:=[4]u64.[f64_bits(3e-12),0,0,0];#assert pns_residual_probe(residual[..])==PnsStatus.residual;
}
pns_math_bits :: (words:[49]u64)->PnsStatus {for i:0..<49 {if !pfk_finite(words[i]) {return PnsStatus.number;}bound:=ifx i<42 then 4.0 else 6.0;if abs(f64_from_bits(words[i]))>bound {return PnsStatus.range;}}return PnsStatus.ok;}
pns_math_probe :: (matrix:[]f64,delta:[]f64,output:[]PnsOutput)->PnsStatus #export_c {if matrix.count!=42 || delta.count!=7 || output.count!=1 {return PnsStatus.shape;}words:[49]u64;for i:0..<42 {words[i]=f64_bits(matrix[i]);}for i:0..<7 {words[42+i]=f64_bits(delta[i]);}status:=pns_math_bits(words);if status!=PnsStatus.ok {return status;}a:[42]f64;d:[7]f64;for i:0..<42 {a[i]=matrix[i];}for i:0..<7 {d[i]=delta[i];}result:=pns_project_owned(a,d);if result.status!=PnsStatus.ok {return result.status;}output[0]=result.value;return PnsStatus.ok;}
pns_residual_probe :: (words:[]u64)->PnsStatus #export_c {if words.count!=4 {return PnsStatus.shape;}values:[4]u64;for i:0..<4 {values[i]=words[i];}return pns_residual_bits(values);}
