#load "panda-pd-gain-search-types.coax";
#authority;
#test "Panda gain study fixed nine scale pairs preserve source cases and expose every gain bit" {
 ps:=[3]f64.[1,2,4];ds:=[3]f64.[0.5,1,2];for profile:0..<9 {for case_id:0..<4 {old:=pnt_case_owned(case_id);fresh:=pgs_case_owned(profile,case_id);for i:0..<7 {#assert fresh.kp[i].value==old.kp[i].value*ps[profile/3] && fresh.kd[i].value==old.kd[i].value*ds[profile%3];#assert fresh.edge.q0[i].value==old.edge.q0[i].value && fresh.edge.q1[i].value==old.edge.q1[i].value;}for i:0..<9 {#assert fresh.initial.q[i]==old.initial.q[i] && fresh.initial.v[i]==old.initial.v[i];}for i:0..<2 {#assert fresh.finger_target[i].value==old.finger_target[i].value;}}}
 #assert pgs_scale(0).x==1 && pgs_scale(8).x==4 && pgs_scale(0).y==0.5 && pgs_scale(8).y==2;
}
#test "Panda gain study exported gains include carried baseline but step refuses it before plant arithmetic" {
 gains:[2]PgsGains;gains[0].kp[0].value=901;gains[1].kd[6].value=902;old:=gains[0];tail:=gains[1];s:=pgs_gains(0,0,gains[..]);#assert s.stage==1 && s.code==1;s=pgs_gains(-1,0,gains[0..<1]);#assert s.stage==7 && s.code==1;s=pgs_gains(9,0,gains[0..<1]);#assert s.stage==7 && s.code==1;s=pgs_gains(0,4,gains[0..<1]);#assert s.stage==2 && s.code==1;#assert gains[0].kp[0].value==old.kp[0].value && gains[1].kd[6].value==tail.kd[6].value;
 for profile:0..<9 {for c:0..<4 {#assert pnt_ok(pgs_gains(profile,c,gains[0..<1]));cfg:=pgs_case_owned(profile,c);for i:0..<7 {#assert gains[0].kp[i].value==cfg.kp[i].value && gains[0].kd[i].value==cfg.kd[i].value;}}}
 cfg:=pnt_case_owned(0);q:=cfg.initial.q;v:=cfg.initial.v;out:=[2]PntStep.[pnt_step_poison(),pnt_step_poison()];before:=out[0];s=pgs_step(1,0,0,q[..],v[..],out[0..<1]);#assert s.stage==7 && s.code==2;pnt_step_same(out[0],before);pnt_step_same(out[1],before);
}
#test "Panda gain study step guards and old status forwarding publish atomically" {
 cfg:=pnt_case_owned(3);q:=cfg.initial.q;v:=cfg.initial.v;out:=[2]PntStep.[pnt_step_poison(),pnt_step_poison()];old:=out[0];s:=pgs_step(0,0,0,q[0..<8],v[..],out[0..<1]);#assert s.stage==1 && s.code==1;s=pgs_step(0,0,0,q[..],v[0..<8],out[0..<1]);#assert s.stage==1 && s.code==1;s=pgs_step(0,0,0,q[..],v[..],out[..]);#assert s.stage==1 && s.code==1;s=pgs_step(-1,0,0,q[..],v[..],out[0..<1]);#assert s.stage==7 && s.code==1;s=pgs_step(9,0,0,q[..],v[..],out[0..<1]);#assert s.stage==7 && s.code==1;s=pgs_step(0,-1,0,q[..],v[..],out[0..<1]);#assert s.stage==2 && s.code==1;s=pgs_step(0,4,0,q[..],v[..],out[0..<1]);#assert s.stage==2 && s.code==1;s=pgs_step(0,0,-1,q[..],v[..],out[0..<1]);#assert s.stage==2 && s.code==2;s=pgs_step(0,0,750,q[..],v[..],out[0..<1]);#assert s.stage==2 && s.code==2;q[0]=9;s=pgs_step(0,3,0,q[..],v[..],out[0..<1]);#assert s.stage==4 && s.code==cast(int)PjpStatus.limits;q=cfg.initial.q;v[8]=3;s=pgs_step(0,3,0,q[..],v[..],out[0..<1]);#assert s.stage==5 && s.code==cast(int)PfkStatus.range;pnt_step_same(out[0],old);pnt_step_same(out[1],old);
 v=cfg.initial.v;#assert pnt_ok(pgs_step(2,3,0,q[..],v[..],out[0..<1]));#assert out[0].command.controller.derivative[6].value== -80 && out[0].command.controller.command[6].value== -12 && out[0].command.controller.clipped==1;
 dense:=[9]f64.[0.11,-0.12,0.13,-0.14,0.15,-0.16,0.17,0.018,-0.019];#assert pnt_ok(pgs_step(0,2,200,q[..],dense[..],out[0..<1]));control:=pnt_control_owned(pgs_case_owned(0,2),200,q,dense);fresh:=pnt_apply_owned(control.command,q,dense);pnt_step_same(out[0],fresh.output);
}

PgsScale :: struct {x:f64;y:f64;}
pgs_scale :: (profile:int)->PgsScale {p:=profile/3;d:=profile%3;return PgsScale.{x=ifx p==0 then 1.0 else ifx p==1 then 2.0 else 4.0,y=ifx d==0 then 0.5 else ifx d==1 then 1.0 else 2.0};}
// Unsealed factory: caller supplies profile0..8 and case0..3.
pgs_case_owned :: (profile:int,case_id:int)->PntCase {x:=pnt_case_owned(case_id);scale:=pgs_scale(profile);for i:0..<7 {x.kp[i].value*=scale.x;x.kd[i].value*=scale.y;}return x;}
pgs_profile_valid :: (profile:int)->bool {return profile>=0 && profile<9;}
pgs_gains :: (profile:int,case_id:int,output:[]PgsGains)->PntStatus #export_c {if output.count!=1 {return pnt_status(1,1);}if !pgs_profile_valid(profile) {return pnt_status(7,1);}if !pnt_case_valid(case_id) {return pnt_status(2,1);}x:=pgs_case_owned(profile,case_id);fresh:PgsGains;fresh.kp=x.kp;fresh.kd=x.kd;output[0]=fresh;return pnt_status(0,0);}
pgs_step :: (profile:int,case_id:int,tick:int,q:[]f64,v:[]f64,output:[]PntStep)->PntStatus #export_c {if q.count!=9 || v.count!=9 || output.count!=1 {return pnt_status(1,1);}if !pgs_profile_valid(profile) {return pnt_status(7,1);}if profile==1 {return pnt_status(7,2);}if !pnt_case_valid(case_id) {return pnt_status(2,1);}if !pnt_tick_valid(tick) {return pnt_status(2,2);}coordinates:[9]f64;rates:[9]f64;for i:0..<9 {coordinates[i]=q[i];rates[i]=v[i];}control:=pnt_control_owned(pgs_case_owned(profile,case_id),tick,coordinates,rates);if !pnt_ok(control.status) {return control.status;}result:=pnt_apply_owned(control.command,coordinates,rates);if !pnt_ok(result.status) {return result.status;}output[0]=result.output;return pnt_status(0,0);}
