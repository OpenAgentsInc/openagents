#load "panda-pd-gain-search-control.coax";
// Literal scorer fixtures, never presented as simulated model output.
pgs_case_poison :: ()->PgsCaseScore {s:PgsCaseScore;s.position_square=101;s.stationary_square=102;s.iae=103;s.terminal=104;s.hold_peak=105;for i:0..<9 {s.peak_speed[i]=201+f64(i);s.peak_acceleration[i]=301+f64(i);s.minimum_margin[i]=401+f64(i);}s.profile=501;s.case_id=502;s.samples=503;s.valid=504;s.complete=505;s.feasible=506;s.reason=507;s.terminal_ok=508;s.hold_ok=509;s.nominal_ok=510;s.pjp_clipped=511;s.pa_control_clipped=512;s.pa_force_clipped=513;return s;}
pgs_case_same :: (a:PgsCaseScore,b:PgsCaseScore) {#assert a.position_square==b.position_square && a.stationary_square==b.stationary_square && a.iae==b.iae && a.terminal==b.terminal && a.hold_peak==b.hold_peak;for i:0..<9 {#assert a.peak_speed[i]==b.peak_speed[i] && a.peak_acceleration[i]==b.peak_acceleration[i] && a.minimum_margin[i]==b.minimum_margin[i];}#assert a.profile==b.profile && a.case_id==b.case_id && a.samples==b.samples && a.valid==b.valid && a.complete==b.complete && a.feasible==b.feasible && a.reason==b.reason && a.terminal_ok==b.terminal_ok && a.hold_ok==b.hold_ok && a.nominal_ok==b.nominal_ok && a.pjp_clipped==b.pjp_clipped && a.pa_control_clipped==b.pa_control_clipped && a.pa_force_clipped==b.pa_force_clipped;}
pgs_literal_card :: (profile:int,c:int)->PgsCaseScore {s:PgsCaseScore;s.profile=profile;s.case_id=c;s.samples=750;s.valid=1;s.complete=1;s.feasible=1;s.terminal_ok=1;s.hold_ok=1;s.nominal_ok=1;s.position_square=1;s.stationary_square=2;s.terminal=0.25;s.iae=0.125;return s;}
pgs_fixture_word :: (prior:PgsCaseScore,lane:int,value:f64)->PgsCaseScore {s:=prior;if lane==0 {s.position_square=value;}else if lane==1 {s.stationary_square=value;}else if lane==2 {s.iae=value;}else if lane==3 {s.terminal=value;}else if lane==4 {s.hold_peak=value;}else if lane<14 {s.peak_speed[lane-5]=value;}else if lane<23 {s.peak_acceleration[lane-14]=value;}else {s.minimum_margin[lane-23]=value;}return s;}
pgs_candidate_same :: (a:PgsCandidate,b:PgsCandidate) {#assert a.terminal==b.terminal && a.iae==b.iae && a.profile==b.profile && a.valid==b.valid && a.feasible==b.feasible && a.pjp_clipped==b.pjp_clipped && a.pa_control_clipped==b.pa_control_clipped && a.pa_force_clipped==b.pa_force_clipped && a.reason==b.reason;}
pgs_selection_same :: (a:PgsSelection,b:PgsSelection) {#assert a.winner==b.winner && a.runner_up==b.runner_up && a.feasible_count==b.feasible_count && a.first_key==b.first_key && a.terminal_gap==b.terminal_gap && a.iae_gap==b.iae_gap && a.clip_gap==b.clip_gap && a.id_gap==b.id_gap;}
pgs_fixture_case_int :: (prior:PgsCaseScore,role:int,value:int)->PgsCaseScore {s:=prior;if role==0 {s.samples=value;}else if role==1 {s.valid=value;}else if role==2 {s.complete=value;}else if role==3 {s.feasible=value;}else if role==4 {s.reason=value;}else if role==5 {s.terminal_ok=value;}else if role==6 {s.hold_ok=value;}else if role==7 {s.nominal_ok=value;}else if role==8 {s.pjp_clipped=value;}else if role==9 {s.pa_control_clipped=value;}else {s.pa_force_clipped=value;}return s;}
pgs_fixture_candidate_int :: (prior:PgsCandidate,role:int,value:int)->PgsCandidate {s:=prior;if role==0 {s.valid=value;}else if role==1 {s.feasible=value;}else if role==2 {s.reason=value;}else if role==3 {s.pjp_clipped=value;}else if role==4 {s.pa_control_clipped=value;}else {s.pa_force_clipped=value;}return s;}
