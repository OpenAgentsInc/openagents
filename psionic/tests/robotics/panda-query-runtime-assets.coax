// Exact ranges/identities for one already authenticated rewritten scene.
// These helpers are source-visible, not a general XML parser or model importer.
#load "panda-query-runtime-fixtures.coax";
#authority;
#test "owned runtime asset ranges cover every frozen field and borrow exact bytes" {
 reference:=pqn_reference_ranges();xml:[66846]u8;
 for i:0..<85 {r:=reference[i];for j:0..<r.count {xml[r.offset+j]=cast(u8)(32+(j*17+i*13)%95);}}
 for i:0..<85 {r:=pqn_asset_range(i);e:=reference[i];#assert r.offset==e.offset && r.count==e.count;path:=pqn_asset_path(xml[..],i);#assert path.count==e.count;for j:0..<e.count {#assert path[j]==xml[e.offset+j];}digest:=pqn_asset_digest(i);#assert digest.count==64;}
 #assert pqn_asset_range(-1).count==0 && pqn_asset_range(85).offset==0 && pqn_asset_digest(-1)=="" && pqn_asset_digest(85)=="";
 #assert pqn_asset_path(xml[0..<66845],0)=="" && pqn_asset_path(xml[..],-1)=="" && pqn_asset_path(xml[..],85)=="";
}
