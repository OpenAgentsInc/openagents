#load "panda-scheduled-pd-fixtures.coax";
#authority;
#test "Common damping law threshold neighbors both signs and canonical absolute zero are frozen" {
 thresholds:=[2]f64.[0.1,0.5];for edge:0..<2 {for side:0..<3 {bits:=f64_bits(thresholds[edge])+cast(u64)side-1;s:=f64_from_bits(bits);for sign:0..<2 {negative:=sign==1;e:=ifx negative then -s else s;r:=psd_law_owned(e);#assert r.signed_error.value==e && r.absolute_error.value==s;r_expected:=ifx s<=0.1 then 0 else ifx s>=0.5 then 2 else 1;#assert r.regime==r_expected;expected:=ifx r_expected==0 then 4.0 else ifx r_expected==2 then 20.0 else 4+16*((s-0.1)/(0.5-0.1));#assert f64_bits(r.damping.value)==f64_bits(expected);}}}
 z:=f64_from_bits(0x8000000000000000);r:=psd_law_owned(z);#assert f64_bits(r.signed_error.value)==0x8000000000000000 && f64_bits(r.absolute_error.value)==0 && r.damping.value==4 && r.regime==0;r=psd_law_owned(0);#assert f64_bits(r.absolute_error.value)==0 && r.regime==0;r=psd_law_owned(0.3);#assert abs(r.damping.value-12)<2e-15 && r.regime==1;r=psd_law_owned(-40);#assert r.damping.value==20 && r.regime==2;
}
#test "Common damping scalar checked boundaries finite precedence typed raw identity and atomic output" {
 out:=[2]PsdSchedule.[psd_schedule_poison(),psd_schedule_poison()];old:=out[0];#assert psd_schedule_raw(0,0,out[..])==PjpStatus.shape;#assert psd_schedule_raw(21,0,out[0..<1])==PjpStatus.range;#assert psd_schedule_raw(0,-21,out[0..<1])==PjpStatus.range;psd_schedule_same(out[0],old);psd_schedule_same(out[1],old);
 #assert psd_admit_bits(f64_bits(21.0),0x7ff8000000000001)==PjpStatus.number && psd_admit_bits(0x7ff0000000000000,0)==PjpStatus.number && psd_admit_bits(0,0xfff0000000000000)==PjpStatus.number;
 for role:0..<2 {for sign:0..<2 {negative:=sign==1;r:pfku.Quantity(PidAngularRate,f64);a:pfku.Quantity(PidAngularRate,f64);value:=ifx negative then -20.0 else 20.0;if role==0 {r.value=value;}else {a.value=value;}#assert psd_schedule(r,a,out[0..<1])==PjpStatus.ok;expected:=out[0];#assert psd_schedule_raw(r.value,a.value,out[0..<1])==PjpStatus.ok;psd_schedule_same(out[0],expected);value=f64_from_bits(f64_bits(20.0)+1);if negative {value= -value;}if role==0 {r.value=value;}else {a.value=value;}#assert psd_schedule(r,a,out[0..<1])==PjpStatus.range;psd_schedule_same(out[0],expected);}}
 #assert psd_schedule_raw(0.35,0.1,out[0..<1])==PjpStatus.ok && abs(out[0].signed_error.value-0.25)<1e-15 && abs(out[0].damping.value-10)<2e-15;
}
#test "Common scheduled gains never inherit a scenario brake override" {
 kp:=[7]f64.[240,240,240,240,160,80,40];kd:=[6]f64.[16,16,16,16,10,6];for e:[3]f64.[0,0.3,2] {out:[1]PsdGains;#assert psd_gains_raw(e,0,out[..])==PjpStatus.ok;for i:0..<7 {#assert out[0].gains.kp[i].value==kp[i];}for i:0..<6 {#assert out[0].gains.kd[i].value==kd[i];}#assert out[0].gains.kd[6].value==out[0].schedule.damping.value;}
 out:[2]PsdGains;out[0].gains.kp[0].value=901;out[0].schedule=psd_schedule_poison();out[1]=out[0];old:=out[0];#assert psd_gains_raw(0,0,out[..])==PjpStatus.shape && psd_gains_raw(21,0,out[0..<1])==PjpStatus.range;psd_gains_same(out[0],old);psd_gains_same(out[1],old);
}
#test "Common scheduled force exposes exact low and high rate-error damping without plant steps" {
 x:=pjp_fixture();for i:0..<7 {x.target[i]=x.q[i];x.target_rate[i]=x.rate[i];}x.rate[6].value=2;x.target_rate[6].value=0;out:[2]PsdForce;out[0].controller=pjp_poison();out[0].schedule=psd_schedule_poison();out[1]=out[0];old:=out[0];
 #assert psd_force(x.q[0..<6],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],out[0..<1])==PjpStatus.shape;#assert psd_force(x.q[..],x.slides[0..<1],x.rate[..],x.target[..],x.target_rate[..],out[0..<1])==PjpStatus.shape;#assert psd_force(x.q[..],x.slides[..],x.rate[0..<6],x.target[..],x.target_rate[..],out[0..<1])==PjpStatus.shape;#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[0..<6],x.target_rate[..],out[0..<1])==PjpStatus.shape;#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[..],x.target_rate[0..<6],out[0..<1])==PjpStatus.shape;#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],out[..])==PjpStatus.shape;
 x.q[0].value=9;#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],out[0..<1])==PjpStatus.limits;x.rate[6].value=21;#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],out[0..<1])==PjpStatus.range;psd_force_same(out[0],old);psd_force_same(out[1],old);
 x=pjp_fixture();for i:0..<7 {x.target[i].value=x.q[i].value+0.001*f64(i+1);x.rate[i].value=0.01*f64(i+1);x.target_rate[i].value=0.02*f64(i+1);}#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],out[0..<1])==PjpStatus.ok;kp:=[7]f64.[240,240,240,240,160,80,40];kd:=[7]f64.[16,16,16,16,10,6,4];for i:0..<7 {#assert abs(out[0].controller.proportional[i].value-kp[i]*(x.target[i].value-x.q[i].value))<2e-13 && abs(out[0].controller.derivative[i].value-kd[i]*(x.target_rate[i].value-x.rate[i].value))<2e-13;}
 x.rate[6].value=2;x.target_rate[6].value=0;#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],out[0..<1])==PjpStatus.ok && out[0].schedule.regime==2 && out[0].schedule.damping.value==20 && out[0].controller.derivative[6].value== -40;
}

#test "Common scheduled force raw transport observes every input role and complete refusal state" {
 x:=pjp_fixture();offset:=[7]f64.[0.17,0.11,-0.13,0.21,0.15,-0.19,0.23];q:[9]f64;v:[7]f64;t:[7]f64;tv:[7]f64;for i:0..<7 {x.q[i].value+=offset[i];x.target[i].value=x.q[i].value+0.001*f64(i+1);x.rate[i].value=0.01*f64(i+1);x.target_rate[i].value=0.02*f64(i+1);q[i]=x.q[i].value;v[i]=x.rate[i].value;t[i]=x.target[i].value;tv[i]=x.target_rate[i].value;}for i:0..<2 {q[7+i]=x.slides[i].value;}typed:[1]PsdForce;raw:[2]PsdForce;#assert psd_force(x.q[..],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],typed[..])==PjpStatus.ok;#assert psd_force_raw(q[..],v[..],t[..],tv[..],raw[0..<1])==PjpStatus.ok;psd_force_same(typed[0],raw[0]);raw[1]=raw[0];old:=raw[0];
 #assert psd_force_raw(q[0..<8],v[..],t[..],tv[..],raw[0..<1])==PjpStatus.shape && psd_force_raw(q[..],v[0..<6],t[..],tv[..],raw[0..<1])==PjpStatus.shape && psd_force_raw(q[..],v[..],t[0..<6],tv[..],raw[0..<1])==PjpStatus.shape && psd_force_raw(q[..],v[..],t[..],tv[0..<6],raw[0..<1])==PjpStatus.shape && psd_force_raw(q[..],v[..],t[..],tv[..],raw[..])==PjpStatus.shape;psd_force_same(raw[0],old);psd_force_same(raw[1],old);
}

#test "Scheduled raw gains retain actual-rate subtraction and force shape precedence" {
 gains:[1]PsdGains;#assert psd_gains_raw(0.35,0.1,gains[..])==PjpStatus.ok && abs(gains[0].schedule.signed_error.value-0.25)<1e-15 && abs(gains[0].gains.kd[6].value-10)<2e-15;
 x:=pjp_fixture();x.rate[6].value=21;out:[1]PsdForce;#assert psd_force(x.q[0..<6],x.slides[..],x.rate[..],x.target[..],x.target_rate[..],out[..])==PjpStatus.shape;#assert psd_force(x.q[..],x.slides[0..<1],x.rate[..],x.target[..],x.target_rate[..],out[..])==PjpStatus.shape;
}

// Trusted finite |error|<=40 coefficient profile; no case or legacy gain input.
psd_law_owned :: (error:f64)->PsdSchedule {r:PsdSchedule;r.signed_error.value=error;s:=f64_from_bits(f64_bits(error)&0x7fffffffffffffff);r.absolute_error.value=s;r.regime=ifx s<=0.1 then 0 else ifx s>=0.5 then 2 else 1;r.damping.value=4;if r.regime==2 {r.damping.value=20;}else if r.regime==1 {r.damping.value=4+16*((s-0.1)/(0.5-0.1));}return r;}
psd_admit_bits :: (reference:u64,actual:u64)->PjpStatus {if !pfk_finite(reference) || !pfk_finite(actual) {return PjpStatus.number;}if abs(f64_from_bits(reference))>20 || abs(f64_from_bits(actual))>20 {return PjpStatus.range;}return PjpStatus.ok;}
psd_schedule :: (reference:pfku.Quantity(PidAngularRate,f64),actual:pfku.Quantity(PidAngularRate,f64),output:[]PsdSchedule)->PjpStatus #export_c {if output.count!=1 {return PjpStatus.shape;}status:=psd_admit_bits(f64_bits(reference.value),f64_bits(actual.value));if status!=PjpStatus.ok {return status;}output[0]=psd_law_owned(reference.value-actual.value);return PjpStatus.ok;}
psd_schedule_raw :: (reference:f64,actual:f64,output:[]PsdSchedule)->PjpStatus #export_c {r:pfku.Quantity(PidAngularRate,f64);a:pfku.Quantity(PidAngularRate,f64);r.value=reference;a.value=actual;return psd_schedule(r,a,output);}
psd_gains_owned :: (schedule:PsdSchedule)->PsdGains {r:PsdGains;kp:=[7]f64.[240,240,240,240,160,80,40];kd:=[6]f64.[16,16,16,16,10,6];for i:0..<7 {r.gains.kp[i].value=kp[i];}for i:0..<6 {r.gains.kd[i].value=kd[i];}r.gains.kd[6]=schedule.damping;r.schedule=schedule;return r;}
psd_gains :: (reference:pfku.Quantity(PidAngularRate,f64),actual:pfku.Quantity(PidAngularRate,f64),output:[]PsdGains)->PjpStatus #export_c {if output.count!=1 {return PjpStatus.shape;}schedule:[1]PsdSchedule;status:=psd_schedule(reference,actual,schedule[..]);if status!=PjpStatus.ok {return status;}output[0]=psd_gains_owned(schedule[0]);return PjpStatus.ok;}
psd_gains_raw :: (reference:f64,actual:f64,output:[]PsdGains)->PjpStatus #export_c {r:pfku.Quantity(PidAngularRate,f64);a:pfku.Quantity(PidAngularRate,f64);r.value=reference;a.value=actual;return psd_gains(r,a,output);}
psd_force :: (q:[]pfku.Quantity(pfku.Radian,f64),slides:[]pfku.Quantity(pfku.Metre,f64),rates:[]pfku.Quantity(PidAngularRate,f64),target:[]pfku.Quantity(pfku.Radian,f64),target_rates:[]pfku.Quantity(PidAngularRate,f64),output:[]PsdForce)->PjpStatus #export_c {if q.count!=7 || slides.count!=2 || rates.count!=7 || target.count!=7 || target_rates.count!=7 || output.count!=1 {return PjpStatus.shape;}gains:[1]PsdGains;status:=psd_gains(target_rates[6],rates[6],gains[..]);if status!=PjpStatus.ok {return status;}pd:[1]PjpOutput;status=pjp_forward(q,slides,rates,target,target_rates,gains[0].gains.kp[..],gains[0].gains.kd[..],pd[..]);if status!=PjpStatus.ok {return status;}fresh:PsdForce;fresh.controller=pd[0];fresh.schedule=gains[0].schedule;output[0]=fresh;return PjpStatus.ok;}
psd_force_raw :: (q:[]f64,rates:[]f64,target:[]f64,target_rates:[]f64,output:[]PsdForce)->PjpStatus #export_c {if q.count!=9 || rates.count!=7 || target.count!=7 || target_rates.count!=7 || output.count!=1 {return PjpStatus.shape;}a:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);t:[7]pfku.Quantity(pfku.Radian,f64);tv:[7]pfku.Quantity(PidAngularRate,f64);for i:0..<7 {a[i].value=q[i];v[i].value=rates[i];t[i].value=target[i];tv[i].value=target_rates[i];}for i:0..<2 {s[i].value=q[7+i];}return psd_force(a[..],s[..],v[..],t[..],tv[..],output);}
