#load "panda-scheduled-pd-control.coax";
#load "panda-scheduled-pd-validation-fixtures.coax";
#authority;
#test "Prospective C/D factory resets all nine positions rates references fingers and common gain metadata" {
 cq:=[9]f64.[-0.44,-0.26,0.33,-2.24,0.28,1.66,0.61,0.015,-0.024];dq:=[9]f64.[0.53,0.37,-0.48,-1.72,-0.42,2.06,-0.35,0.021,-0.017];delta:=[7]f64.[0.03,-0.025,0.02,-0.02,0.015,0.02,-0.025];kp:=[7]f64.[240,240,240,240,160,80,40];kd:=[7]f64.[16,16,16,16,10,6,4];
 for id:0..<8 {x:=psv_case_owned(id);pose:=id/4;scenario:=id%4;q:=ifx pose==0 then cq else dq;#assert x.case_id==scenario;for i:0..<9 {#assert f64_bits(x.initial.q[i])==f64_bits(q[i]) && x.initial.v[i]==(ifx scenario==3 && i==6 then (ifx pose==0 then 2.0 else -2.0) else 0.0);}for i:0..<7 {#assert x.edge.q0[i].value==q[i] && x.edge.q1[i].value==(ifx scenario==1 || scenario==2 then q[i]+delta[i] else q[i]) && x.edge.vlim[i].value==0.12 && x.edge.alim[i].value==0.6 && x.kp[i].value==kp[i] && x.kd[i].value==kd[i];}for i:0..<2 {#assert x.finger_target[i].value==q[7+i];}}
 #assert !psv_context_valid(-1) && psv_context_valid(0) && psv_context_valid(7) && !psv_context_valid(8) && psv_pose_valid(0) && psv_pose_valid(1) && !psv_pose_valid(-1) && !psv_pose_valid(2);
}
#test "Prospective C/D initial and64word fixture metadata are exact and refuse atomically" {
 initial:[2]PntInitial;for i:0..<9 {initial[0].q[i]=101+f64(i);initial[0].v[i]=201+f64(i);}initial[1]=initial[0];old:=initial[0];s:=psv_initial(0,initial[..]);#assert s.stage==1 && s.code==1;s=psv_initial(-1,initial[0..<1]);#assert s.stage==2 && s.code==1;s=psv_initial(8,initial[0..<1]);#assert s.stage==2 && s.code==1;for i:0..<9 {#assert initial[0].q[i]==old.q[i] && initial[0].v[i]==old.v[i] && initial[1].q[i]==old.q[i] && initial[1].v[i]==old.v[i];}
 words:[65]f64;for i:0..<65 {words[i]=1001+f64(i);}before:=words;#assert psv_fixture(0,words[..]).stage==1 && psv_fixture(-1,words[0..<64]).stage==2 && psv_fixture(8,words[0..<64]).stage==2;for i:0..<65 {#assert words[i]==before[i];}
 for id:0..<8 {#assert pnt_ok(psv_initial(id,initial[0..<1])) && pnt_ok(psv_fixture(id,words[0..<64]));x:=psv_case_owned(id);for i:0..<9 {#assert words[i]==x.initial.q[i] && words[9+i]==x.initial.v[i] && initial[0].q[i]==x.initial.q[i] && initial[0].v[i]==x.initial.v[i];}for i:0..<7 {#assert words[18+i]==x.edge.q1[i].value && words[25+i]==x.edge.vlim[i].value && words[32+i]==x.edge.alim[i].value && words[39+i]==x.kp[i].value && words[46+i]==x.kd[i].value;}for i:0..<2 {#assert words[53+i]==x.finger_target[i].value;}for i:0..<9 {#assert words[55+i]==(ifx id%4==2 && i==1 then (ifx id<4 then 3.0 else -3.0) else 0.0);}#assert words[64]==before[64];}
}
#test "Prospective C/D references admit postframe750 preserve endpoints and distinguish both new poses" {
 out:=[2]PsvReference.[psv_reference_poison(),psv_reference_poison()];old:=out[0];s:=psv_reference(0,0,out[..]);#assert s.stage==1 && s.code==1;s=psv_reference(-1,0,out[0..<1]);#assert s.stage==2 && s.code==1;s=psv_reference(8,0,out[0..<1]);#assert s.stage==2 && s.code==1;s=psv_reference(0,-1,out[0..<1]);#assert s.stage==2 && s.code==2;s=psv_reference(0,751,out[0..<1]);#assert s.stage==2 && s.code==2;psv_reference_same(out[0],old);psv_reference_same(out[1],old);
 for id:0..<8 {x:=psv_case_owned(id);#assert pnt_ok(psv_reference(id,0,out[0..<1]));#assert out[0].reference_tick==0 && out[0].reference_steps==(ifx id%4==1 || id%4==2 then 270 else 0);for i:0..<7 {#assert f64_bits(out[0].reference.angle[i].value)==f64_bits(x.edge.q0[i].value) && f64_bits(out[0].reference.rate[i].value)==0 && f64_bits(out[0].reference.acceleration[i].value)==0;}#assert pnt_ok(psv_reference(id,750,out[0..<1]));#assert out[0].reference_tick==out[0].reference_steps;for i:0..<7 {#assert f64_bits(out[0].reference.angle[i].value)==f64_bits(x.edge.q1[i].value) && f64_bits(out[0].reference.rate[i].value)==0 && f64_bits(out[0].reference.acceleration[i].value)==0;}}
}

#test "Validation explicit helper pose transition and exact fixture refusal codes" {
 #assert psv_pulse_owned(3)==3 && psv_pulse_owned(4)== -3;
 out:[65]f64;for i:0..<65 {out[i]=1000+f64(i);}r:=psv_fixture(0,out[..]);#assert r.stage==1 && r.code==1;r=psv_fixture(8,out[0..<64]);#assert r.stage==2 && r.code==1;for i:0..<65 {#assert out[i]==1000+f64(i);}
}
psv_context_valid :: (context:int)->bool {return context>=0 && context<8;}
psv_pose_valid :: (pose:int)->bool {return pose>=0 && pose<2;}
// Unsealed fixed factory; caller supplies context0..7, never arbitrary input PODs.
psv_case_owned :: (context:int)->PntCase {x:PntCase;pose:=context/4;scenario:=context%4;x.case_id=scenario;c:=[9]f64.[-0.44,-0.26,0.33,-2.24,0.28,1.66,0.61,0.015,-0.024];d:=[9]f64.[0.53,0.37,-0.48,-1.72,-0.42,2.06,-0.35,0.021,-0.017];x.initial.q=ifx pose==0 then c else d;if scenario==3 {x.initial.v[6]=ifx pose==0 then 2.0 else -2.0;}delta:=[7]f64.[0.03,-0.025,0.02,-0.02,0.015,0.02,-0.025];gains:=psd_gains_owned(psd_law_owned(0));x.kp=gains.gains.kp;x.kd=gains.gains.kd;for i:0..<7 {x.edge.q0[i].value=x.initial.q[i];x.edge.q1[i]=x.edge.q0[i];if scenario==1 || scenario==2 {x.edge.q1[i].value=x.initial.q[i]+delta[i];}x.edge.vlim[i].value=0.12;x.edge.alim[i].value=0.6;}for i:0..<2 {x.finger_target[i].value=x.initial.q[7+i];}return x;}
psv_pulse_owned :: (context:int)->f64 {return ifx context<4 then 3.0 else -3.0;}
psv_initial :: (context:int,output:[]PntInitial)->PntStatus #export_c {if output.count!=1 {return pnt_status(1,1);}if !psv_context_valid(context) {return pnt_status(2,1);}output[0]=psv_case_owned(context).initial;return pnt_status(0,0);}
psv_fixture :: (context:int,output:[]f64)->PntStatus #export_c {if output.count!=64 {return pnt_status(1,1);}if !psv_context_valid(context) {return pnt_status(2,1);}x:=psv_case_owned(context);fresh:[64]f64;for i:0..<9 {fresh[i]=x.initial.q[i];fresh[9+i]=x.initial.v[i];}for i:0..<7 {fresh[18+i]=x.edge.q1[i].value;fresh[25+i]=x.edge.vlim[i].value;fresh[32+i]=x.edge.alim[i].value;fresh[39+i]=x.kp[i].value;fresh[46+i]=x.kd[i].value;}for i:0..<2 {fresh[53+i]=x.finger_target[i].value;}if context%4==2 {fresh[56]=psv_pulse_owned(context);}for i:0..<64 {output[i]=fresh[i];}return pnt_status(0,0);}
// Fixed admitted edge and nonnegative tick0..750 make the old reference helper safe.
psv_reference :: (context:int,tick:int,output:[]PsvReference)->PntStatus #export_c {if output.count!=1 {return pnt_status(1,1);}if !psv_context_valid(context) {return pnt_status(2,1);}if tick<0 || tick>750 {return pnt_status(2,2);}r:=pnt_reference_owned(psv_case_owned(context),tick);fresh:PsvReference;fresh.reference=r.reference;fresh.reference_tick=r.tick;fresh.reference_steps=r.steps;output[0]=fresh;return pnt_status(0,0);}
