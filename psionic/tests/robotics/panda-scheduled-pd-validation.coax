#load "panda-scheduled-pd.coax";
#load "panda-scheduled-pd-validation-score.coax";
#authority;
#test "Validation command snapshots all nine raw coordinates rates and new pose references" {
 for context:0..<8 {cfg:=psv_case_owned(context);v:=[9]f64.[0.11,-0.12,0.13,-0.14,0.15,-0.16,0.17,0.018,-0.019];out:=[2]PsdCommand.[psd_command_poison(),psd_command_poison()];#assert pnt_ok(psv_command(context,135,cfg.initial.q[..],v[..],out[0..<1]));expected:=psd_command_owned(cfg,135,cfg.initial.q,v);psd_command_same(out[0],expected.output);psd_command_same(out[1],psd_command_poison());}
}
#test "Validation pulse is signed by prospective pose before publishing and absent outside its exact interval" {
 for context:[2]int.[2,6] {cfg:=psv_case_owned(context);for tick:[4]int.[199,200,249,250] {r:=psv_command_owned(context,tick,cfg.initial.q,cfg.initial.v);#assert pnt_ok(r.status);pulse:=tick>=200 && tick<250;#assert r.output.base.pulse==ifx pulse then 1 else 0;for i:0..<9 {#assert r.output.base.external[i]==ifx pulse && i==1 then psv_pulse_owned(context) else 0;}}}
 for context:[6]int.[0,1,3,4,5,7] {cfg:=psv_case_owned(context);r:=psv_command_owned(context,200,cfg.initial.q,cfg.initial.v);#assert pnt_ok(r.status) && r.output.base.pulse==0;for i:0..<9 {#assert r.output.base.external[i]==0;}}
}
#test "Validation command and step guard exact status complete atomicity and shape context tick precedence" {
 cfg:=psv_case_owned(4);q:=cfg.initial.q;v:=cfg.initial.v;out:=[2]PsdCommand.[psd_command_poison(),psd_command_poison()];old:=out[0];s:=psv_command(-1,-1,q[0..<8],v[..],out[0..<1]);#assert s.stage==1 && s.code==1;s=psv_command(4,0,q[..],v[0..<8],out[0..<1]);#assert s.stage==1 && s.code==1;s=psv_command(4,0,q[..],v[..],out[..]);#assert s.stage==1 && s.code==1;for context:[2]int.[-1,8] {s=psv_command(context,0,q[..],v[..],out[0..<1]);#assert s.stage==2 && s.code==1;}for tick:[2]int.[-1,750] {s=psv_command(4,tick,q[..],v[..],out[0..<1]);#assert s.stage==2 && s.code==2;}q[0]=9;s=psv_command(4,0,q[..],v[..],out[0..<1]);#assert s.stage==4 && s.code==cast(int)PjpStatus.limits;q=cfg.initial.q;v[8]=3;s=psv_command(4,0,q[..],v[..],out[0..<1]);#assert s.stage==5 && s.code==cast(int)PfkStatus.range;psd_command_same(out[0],old);psd_command_same(out[1],old);
 step:=[2]PsdStep.[psd_step_poison(),psd_step_poison()];prior:=step[0];v=cfg.initial.v;s=psv_step(-1,-1,q[0..<8],v[..],step[0..<1]);#assert s.stage==1 && s.code==1;s=psv_step(4,0,q[..],v[0..<8],step[0..<1]);#assert s.stage==1 && s.code==1;s=psv_step(4,0,q[..],v[..],step[..]);#assert s.stage==1 && s.code==1;for context:[2]int.[-1,8] {s=psv_step(context,0,q[..],v[..],step[0..<1]);#assert s.stage==2 && s.code==1;}for tick:[2]int.[-1,750] {s=psv_step(4,tick,q[..],v[..],step[0..<1]);#assert s.stage==2 && s.code==2;}q[0]=9;s=psv_step(4,0,q[..],v[..],step[0..<1]);#assert s.stage==4 && s.code==cast(int)PjpStatus.limits;psd_step_same(step[0],prior);psd_step_same(step[1],prior);
}
#test "Validation isolated D negative-pulse step forwards actual command and all plant fields without a rollout" {
 cfg:=psv_case_owned(6);q:=cfg.initial.q;v:=[9]f64.[0.11,-0.12,0.13,-0.14,0.15,-0.16,0.17,0.018,-0.019];out:=[2]PsdStep.[psd_step_poison(),psd_step_poison()];#assert pnt_ok(psv_step(6,200,q[..],v[..],out[0..<1]));expected:=psv_command_owned(6,200,q,v);psd_command_same(out[0].command,expected.output);#assert out[0].command.base.external[1]== -3;
 for i:0..<7 {#assert out[0].plant.angles[i].value!=0 && out[0].plant.hinge_rates[i].value!=0 && out[0].plant.effective.hinge[i].value!=0;}for i:0..<2 {#assert out[0].plant.slides[i].value!=0 && out[0].plant.slide_rates[i].value!=0 && out[0].plant.effective.slide[i].value!=0;}#assert out[0].plant.control_clipped==0 && out[0].plant.force_clipped==0;psd_step_same(out[1],psd_step_poison());for i:0..<9 {#assert q[i]==cfg.initial.q[i] && v[i]==[9]f64.[0.11,-0.12,0.13,-0.14,0.15,-0.16,0.17,0.018,-0.019][i];}
}
#test "Validation verdict requires ordered distinct pose cards with numeric admission and two-pose AND goals" {
 cards:[2]PgsCandidate;for pose:0..<2 {source:[4]PgsCaseScore;for c:0..<4 {source[c]=pgs_literal_card(pose,c);}fresh:[1]PgsCandidate;#assert psv_combine(pose,source[..],fresh[..])==PgsStatus.ok;cards[pose]=fresh[0];}out:=[2]PsvVerdict.[PsvVerdict.{valid=101,feasible=102},PsvVerdict.{valid=101,feasible=102}];#assert psv_verdict(cards[0..<1],out[0..<1])==PgsStatus.shape && psv_verdict(cards[..],out[..])==PgsStatus.shape;#assert out[0].valid==101 && out[0].feasible==102 && out[1].valid==101 && out[1].feasible==102;
 #assert psv_verdict(cards[..],out[0..<1])==PgsStatus.ok && out[0].valid==1 && out[0].feasible==1;for pose:0..<2 {old:=cards[pose];cards[pose].feasible=0;#assert psv_verdict(cards[..],out[0..<1])==PgsStatus.ok && out[0].valid==1 && out[0].feasible==0;cards[pose].valid=0;#assert psv_verdict(cards[..],out[0..<1])==PgsStatus.ok && out[0].valid==0 && out[0].feasible==0;cards[pose]=old;}
 old:=cards[0];cards[0].profile=1;#assert psv_verdict(cards[..],out[0..<1])==PgsStatus.order;cards[0]=old;old=cards[1];cards[1].profile=0;#assert psv_verdict(cards[..],out[0..<1])==PgsStatus.order;cards[1]=old;cards[1].terminal= -1;#assert psv_verdict(cards[..],out[0..<1])==PgsStatus.range;
}

// Trusted: context 0..7, tick 0..749, source factory. Refusal POD is not an admission certificate.
psv_command_owned :: (context:int,tick:int,coordinates:[9]f64,rates:[9]f64)->PsdCommandResult {r:=psd_command_owned(psv_case_owned(context),tick,coordinates,rates);if !pnt_ok(r.status) {return r;}if r.output.base.pulse==1 {r.output.base.external[1]=psv_pulse_owned(context);}return r;}
psv_command :: (context:int,tick:int,q:[]f64,v:[]f64,output:[]PsdCommand)->PntStatus #export_c {if q.count!=9 || v.count!=9 || output.count!=1 {return pnt_status(1,1);}if !psv_context_valid(context) {return pnt_status(2,1);}if !pnt_tick_valid(tick) {return pnt_status(2,2);}coordinates:[9]f64;rates:[9]f64;for i:0..<9 {coordinates[i]=q[i];rates[i]=v[i];}r:=psv_command_owned(context,tick,coordinates,rates);if !pnt_ok(r.status) {return r.status;}output[0]=r.output;return pnt_status(0,0);}
psv_step :: (context:int,tick:int,q:[]f64,v:[]f64,output:[]PsdStep)->PntStatus #export_c {if q.count!=9 || v.count!=9 || output.count!=1 {return pnt_status(1,1);}if !psv_context_valid(context) {return pnt_status(2,1);}if !pnt_tick_valid(tick) {return pnt_status(2,2);}coordinates:[9]f64;rates:[9]f64;for i:0..<9 {coordinates[i]=q[i];rates[i]=v[i];}command:=psv_command_owned(context,tick,coordinates,rates);if !pnt_ok(command.status) {return command.status;}r:=psd_apply_owned(command.output,coordinates,rates);if !pnt_ok(r.status) {return r.status;}output[0]=r.output;return pnt_status(0,0);}
psv_verdict :: (poses:[]PgsCandidate,output:[]PsvVerdict)->PgsStatus #export_c {if poses.count!=2 || output.count!=1 {return PgsStatus.shape;}fresh:PsvVerdict;fresh.valid=1;fresh.feasible=1;for pose:0..<2 {x:=poses[pose];if x.profile!=pose {return PgsStatus.order;}status:=pgs_candidate_admit(x);if status!=PgsStatus.ok {return status;}if x.valid!=1 {fresh.valid=0;}if x.feasible!=1 {fresh.feasible=0;}}output[0]=fresh;return PgsStatus.ok;}
