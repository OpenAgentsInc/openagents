#load "../../lib/robotics/panda-euler.coax";
main :: () {
 q:[7]pfku.Quantity(pfku.Radian,f64);s:[2]pfku.Quantity(pfku.Metre,f64);v:[7]pfku.Quantity(PidAngularRate,f64);sv:[2]pfku.Quantity(PidLinearRate,f64);u:[7]pfku.Quantity(PmHingeGravity,f64);t:[2]pfku.Quantity(pfku.Metre,f64);h:[7]pfku.Quantity(PmHingeGravity,f64);f:[2]pfku.Quantity(PmSlideGravity,f64);out:[1]PeuOutput;
 bad:[7]pfku.Quantity(pfku.Metre,f64);
 result:=peu_step(bad[..],s[..],v[..],sv[..],u[..],t[..],h[..],f[..],out[..]);
}
