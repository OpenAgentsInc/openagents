// Chapter 176's check helpers, loaded by psionic/lib/serve-pages.coax and
// owned by its checks: the hand-traced workload, a brute-force model of
// shared tables (every table a private list of values), a brute-force
// prefix lookup that walks every cached chain, the invariants a state must
// keep, and a stand-in model whose attention and recurrent state read and
// write frames through page tables, with a contiguous twin run alone.

pgx_next :: (h:int)->int {return (h*1103515245+12345)%2147483648;}

// The hand trace: page 2, dim 1, device 4, host 1, disk 1, one slot.
pgx_hand_start :: ()->PgState {
    cfg:=PgConfig.{page=2,dim=1};cfg.cap[0]=4;cfg.cap[1]=1;cfg.cap[2]=1;
    b:=CbConfig.{slots=1,tokens=8,clients=1,steps=100};b.weight[0]=1;
    q:[5]CbRequest;tok:[160]int;model:=[5]int.[0,1,0,1,0];
    for i:0..<5 {
        q[i]=CbRequest.{prompt=ifx i%2==0 && i>0 then 6 else 5,output=1};
        for p:0..<4 {tok[i*32+p]=p+1;}
        tok[i*32+4]=ifx q[i].prompt==6 then 6 else 5;tok[i*32+5]=7;
    }
    return pg_start(cfg,b,q[..],model[..],tok[..]);
}
pgx_pages :: (s:PgState,i:int,a:int,b:int,c:int,d:int)->bool {
    t:=s.st.table[i].page;
    return t[0]==a && t[1]==b && t[2]==c && (d<0 || t[3]==d);
}
pgx_live :: (s:PgState)->int {n:=0;for k:0..<48 {if s.st.node[k].frame>=0 {n+=1;}}return n;}

// After every step: every frame's count equals its holders (tables of
// running requests, recurrent-state pages, cached nodes); each free stack
// holds exactly the unreferenced frames of its tier; host and disk frames
// belong to the cache alone; a node's parent is live and never in a slower
// tier; no two nodes share a parent and tokens; each request's lookup equals
// the brute-force one; every cached frame holds the bytes its tokens give.
pgx_check :: (from:PgState,mem:[]f64) {
    s:=from;c:=s.cfg;held:[48]int;
    for q:0..<s.cb.nrun {
        i:=s.cb.run[q];
        for k:0..<s.st.table[i].n {held[s.st.table[i].page[k]]+=1;}
        if s.st.live[i]>=0 {held[s.st.live[i]]+=1;}
    }
    for n:0..<48 {
        d:=s.st.node[n];
        if d.frame<0 {continue;}
        held[d.frame]+=1;#assert !d.keep && pgx_expect(c,s.st.node[..],mem,n);
        if d.parent>=0 {#assert s.st.node[d.parent].frame>=0 && s.st.node[d.parent].frame/16<=d.frame/16;}
        for m:0..<n {
            e:=s.st.node[m];
            if e.frame>=0 && e.parent==d.parent {
                same:=true;for j:0..<c.page {if e.tok[j]!=d.tok[j] {same=false;}}
                #assert !same;
            }
        }
    }
    for t:0..<3 {
        free:=0;
        for f:t*16..<t*16+c.cap[t] {#assert s.st.pool.ref[f]==held[f] && (t==0 || held[f]<=1);if held[f]==0 {free+=1;}}
        #assert s.st.pool.nfree[t]==free;
        for k:0..<free {
            f:=s.st.pool.stack[t*16+k];#assert f/16==t && f<t*16+c.cap[t] && s.st.pool.ref[f]==0;
            for j:0..<k {#assert s.st.pool.stack[t*16+j]!=f;}
        }
    }
    for i:0..<s.cb.n {
        t:=s.tok[i*32..<i*32+32];
        #assert pg_match(s.st,s.model[i],t,s.cb.req[i].prompt).n==pgx_brute_match(c,s.st.node[..],s.model[i],t,s.cb.req[i].prompt);
    }
}
// The brute-force lookup: for every cached node, rebuild its whole prefix
// and its model by walking to the root; the longest one the prompt starts
// with, within the blocks it may reuse.
pgx_brute_match :: (c:PgConfig,node:[]PgNode,model:int,tok:[]int,prompt:int)->int {
    best:=0;
    for n:0..<48 {
        if node[n].frame<0 {continue;}
        chain:[16]int;depth:=0;a:=n;
        while a>=0 {chain[depth]=a;depth+=1;a=node[a].parent;}
        if -1-a!=model || depth*c.page>prompt-1 {continue;}
        same:=true;
        for k:0..<depth {for j:0..<c.page {if node[chain[depth-1-k]].tok[j]!=tok[k*c.page+j] {same=false;}}}
        if same && depth>best {best=depth;}
    }
    return best;
}
// What a cached block's frame must hold: its keys from its tokens and, for
// a hybrid model, the recurrent state after its last position.
pgx_expect :: (c:PgConfig,node:[]PgNode,mem:[]f64,n:int)->bool {
    w:=pg_width(c);chain:[16]int;depth:=0;a:=n;
    while a>=0 {chain[depth]=a;depth+=1;a=node[a].parent;}
    m:=-1-a;r:[4]f64;f:=node[n].frame;
    for k:0..<depth {for o:0..<c.page {for j:0..<c.dim {r[j]=r[j]*0.5+pgx_embed(m,node[chain[depth-1-k]].tok[o],j);}}}
    for o:0..<c.page {for j:0..<c.dim {if mem[f*w+o*c.dim+j]!=pgx_embed(m,node[n].tok[o],j) {return false;}}}
    if c.hybrid {for j:0..<c.dim {if mem[f*w+c.page*c.dim+j]!=r[j] {return false;}}}
    return true;
}

// The stand-in model. A token's key and value are its embedding under the
// model identity; position p attends to positions 0 to p of its request;
// a hybrid model also keeps r = r/2 + embedding, one value per dim, and
// adds it to every logit. The next token is the best of 16.
pgx_embed :: (model:int,tok:int,j:int)->f64 {return cast(f64)((tok*5+j*3+model*2)%7-3)*0.25;}
pgx_pick :: (model:int,att:[]f64,r:[]f64,p:int)->int {
    best:=0;top:=-1000000.0;
    for v:0..<16 {
        l:=0.0;
        for j:0..<att.count {l+=att[j]*pgx_embed(model,v,j)*cast(f64)(1+(v+j+p)%3)+r[j]*pgx_embed(model,v,j);}
        if l>top {top=l;best=v;}
    }
    return best;
}
// Attention for position p over the keys of positions 0 to p, laid out
// contiguously: the same operations, in the same order, for both readers.
pgx_scores :: (key:[]f64,p:int,dim:int,att:[]f64) {
    score:[128]f64;m:=-1000000.0;
    for q:0..<p+1 {s:=0.0;for j:0..<dim {s+=key[p*dim+j]*key[q*dim+j]*cast(f64)(1+q%3);}score[q]=s;if s>m {m=s;}}
    den:=0.0;out:[4]f64;
    for q:0..<p+1 {e:=exp(score[q]-m);den+=e;for j:0..<dim {out[j]+=e*key[q*dim+j];}}
    for j:0..<dim {att[j]=out[j]/den;}
}
// Copy the keys of positions 0 to p of a table, page by page, in order.
pgx_gather :: (c:PgConfig,t:PgTable,mem:[]f64,p:int,key:[]f64) {
    w:=pg_width(c);
    for b:0..<p/c.page+1 {for o:0..<c.page*c.dim {key[b*c.page*c.dim+o]=mem[t.page[b]*w+o];}}
}
// Request i, position p, through its page table: write the key, step the
// recurrent state (and snapshot it into the block's page at a block end),
// gather and attend.
pgx_paged :: (c:PgConfig,t:PgTable,live:int,model:int,mem:[]f64,p:int,tok:int,att:[]f64,r:[]f64)->int {
    w:=pg_width(c);f:=t.page[p/c.page];
    for j:0..<c.dim {mem[f*w+p%c.page*c.dim+j]=pgx_embed(model,tok,j);}
    if c.hybrid {
        for j:0..<c.dim {mem[live*w+j]=mem[live*w+j]*0.5+pgx_embed(model,tok,j);r[j]=mem[live*w+j];}
        if (p+1)%c.page==0 {for j:0..<c.dim {mem[f*w+c.page*c.dim+j]=r[j];}}
    }
    key:[512]f64;pgx_gather(c,t,mem,p,key[..]);
    pgx_scores(key[..],p,c.dim,att);
    return pgx_pick(model,att[0..<c.dim],r[0..<c.dim],p);
}
// Request i alone with a contiguous cache: prompt, then one token at a time.
pgx_alone :: (s:PgState,i:int,out:[]int) {
    c:=s.cfg;m:=s.model[i];q:=s.cb.req[i];key:[512]f64;r:[4]f64;att:[4]f64;
    for p:0..<q.prompt+q.output-1 {
        tok:=ifx p<q.prompt then s.tok[i*32+p] else out[p-q.prompt];
        for j:0..<c.dim {key[p*c.dim+j]=pgx_embed(m,tok,j);}
        if c.hybrid {for j:0..<c.dim {r[j]=r[j]*0.5+pgx_embed(m,tok,j);}}
        pgx_scores(key[..],p,c.dim,att[..]);
        nxt:=pgx_pick(m,att[0..<c.dim],r[0..<c.dim],p);
        if p>=q.prompt-1 {out[p-q.prompt+1]=nxt;}
    }
}
// Run one planned step's rows through the paged model. Every frame written
// is held by its request alone.
pgx_rows :: (from:PgState,mem:[]f64,out:[]int) {
    s:=from;att:[4]f64;r:[4]f64;
    for k:0..<s.cb.nrows {
        row:=s.cb.rows[k];i:=row.req;q:=s.cb.req[i];t:=s.st.table[i];
        for p:row.at..<row.at+row.count {
            #assert s.st.pool.ref[t.page[p/s.cfg.page]]==1 && (!s.cfg.hybrid || s.st.pool.ref[s.st.live[i]]==1);
            tok:=ifx p<q.prompt then s.tok[i*32+p] else out[i*8+p-q.prompt];
            nxt:=pgx_paged(s.cfg,t,s.st.live[i],s.model[i],mem,p,tok,att[..],r[..]);
            if p==row.at+row.count-1 && row.emit {out[i*8+p-q.prompt+1]=nxt;}
        }
    }
}

// Random shared-prefix workloads: 1 to 12 requests whose prompts start with
// part of one of three family prefixes, under model 0 or 1, on a small
// device with small host and disk tiers, so blocks hit, move, come back and
// drop.
PgxWork :: struct {cfg:PgConfig;batch:CbConfig;n:int;req:[12]CbRequest;model:[12]int;tok:[384]int;}
pgx_work :: (seed:int)->PgxWork {
    w:PgxWork;h:=pgx_next(seed*7919+13);
    w.cfg.page=1+h/65536%4;h=pgx_next(h);w.cfg.dim=1+h/65536%4;h=pgx_next(h);w.cfg.hybrid=h/65536%2==1;h=pgx_next(h);
    w.cfg.cap[0]=2+h/65536%10;h=pgx_next(h);w.cfg.cap[1]=h/65536%4;h=pgx_next(h);w.cfg.cap[2]=h/65536%4;h=pgx_next(h);
    w.batch.slots=1+h/65536%3;h=pgx_next(h);w.batch.tokens=w.batch.slots+h/65536%6;h=pgx_next(h);
    w.batch.clients=1+h/65536%2;w.batch.steps=400;w.batch.weight[0]=1;w.batch.weight[1]=2;h=pgx_next(h);
    w.n=1+h/65536%12;h=pgx_next(h);
    for i:0..<w.n {
        fam:=h/65536%3;h=pgx_next(h);share:=h/65536%13;h=pgx_next(h);
        r:=CbRequest.{client=i%w.batch.clients,arrive=i/3,prompt=1+h/65536%12};h=pgx_next(h);
        r.output=1+h/65536%4;h=pgx_next(h);w.model[i]=h/65536%5/4;h=pgx_next(h);
        for p:0..<r.prompt {w.tok[i*32+p]=ifx p<share then (fam*5+p*3)%16 else h/65536%16;h=pgx_next(h);}
        w.req[i]=r;
    }
    return w;
}
pgx_start :: (w:PgxWork)->PgState {v:=w;return pg_start(v.cfg,v.batch,v.req[0..<v.n],v.model[0..<v.n],v.tok[..]);}

// The brute-force model of shared tables: each table is its own list of
// values. pgx_same compares it with what the frames hold, and every count
// and free frame with the tables.
PgxTables :: struct {n:[4]int;val:[256]f64;}
pgx_same :: (from:PgStore,mem:[]f64,b:PgxTables)->bool {
    s:=from;w:=pg_width(s.cfg);held:[48]int;size:=s.cfg.page*s.cfg.dim;
    for t:0..<4 {
        if s.table[t].n!=b.n[t] {return false;}
        for k:0..<b.n[t] {
            f:=s.table[t].page[k];held[f]+=1;
            for o:0..<size {if mem[f*w+o]!=b.val[t*64+k*size+o] {return false;}}
        }
        // Paged attention over the table equals attention over its private copy, bit for bit.
        if b.n[t]>0 {
            last:=b.n[t]*s.cfg.page-1;key:[512]f64;g:[4]f64;c:[4]f64;bv:=b.val;
            pgx_gather(s.cfg,s.table[t],mem,last,key[..]);
            pgx_scores(key[..],last,s.cfg.dim,g[..]);pgx_scores(bv[t*64..<t*64+64],last,s.cfg.dim,c[..]);
            for j:0..<4 {if g[j]!=c[j] {return false;}}
        }
    }
    free:=0;
    for f:0..<s.cfg.cap[0] {if s.pool.ref[f]!=held[f] {return false;}if held[f]==0 {free+=1;}}
    for k:0..<s.pool.nfree[0] {f:=s.pool.stack[k];if s.pool.ref[f]!=0 {return false;}for j:0..<k {if s.pool.stack[j]==f {return false;}}}
    return s.pool.nfree[0]==free;
}
