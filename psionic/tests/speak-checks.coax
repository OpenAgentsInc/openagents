// Chapter 155's check references, loaded by psionic/lib/speak.coax.
// spk_ref_frame transforms a frame with chapter 151's direct DFT, not the
// FFT. spk_ref_whole is textbook Griffin-Lim over a whole utterance: every
// frame at once, no blocks, no context, no pending samples, one inverse STFT
// at the end. spk_ref_blocks solves the same blocks as a stream with
// spk_solve, keeps every frame, and adds them all up at the end.

// A fixed signal in [-1, 1] from a linear congruential sequence.
spk_noise :: (seed:int,x:[]f64) {
    v:=seed*7919+12345;
    for i:0..<x.count {v=(v*1103515245+12345)%2147483648;x[i]=f64(v%2001-1000)/1000;}
}
// The windowed frame of x from at, by the direct DFT.
spk_ref_frame :: (x:[]f64,at:int,w:[]f64,re:[]f64,im:[]f64) {
    n:=w.count;a:[SPK_N_MAX]f64;b:[SPK_N_MAX]f64;
    for m:0..<n {a[m]=x[at+m]*w[m];}
    #assert sf_dft(a[0..<n],b[0..<n],re,im,false)==SfStatus.ok;
}
spk_same :: (a:[]f64,b:[]f64)->bool {
    if a.count!=b.count {return false;}
    for i:0..<a.count {if a[i]!=b[i] {return false;}}
    return true;
}
// Inverse STFT of frames (T rows of n) by least squares, summing frames in
// order: out[s] = sum of w[m] y_t[m] over sum of w[m]^2, with s = t hop + m.
// Overwrites re with the windowed frames w[m] y_t[m].
spk_ref_istft :: (sh:SpkShape,re:[]f64,im:[]f64,T:int,out:[]f64)->int {
    n:=sh.n;h:=sh.hop;L:=(T-1)*h+n;
    w:[SPK_N_MAX]f64;tr:[SPK_N_MAX]f64;ti:[SPK_N_MAX]f64;spk_window(w[0..<n]);
    for t:0..<T {
        for k:0..<n {tr[k]=re[t*n+k];ti[k]=im[t*n+k];}
        #assert sf_fft(tr[0..<n],ti[0..<n],true)==SfStatus.ok;
        for m:0..<n {re[t*n+m]=w[m]*tr[m];}
    }
    for s:0..<L {
        num:=0.0;den:=0.0;
        for t:0..<T {
            m:=s-t*h;
            if m<0 || m>=n {continue;}
            num+=re[t*n+m];den+=w[m]*w[m];
        }
        out[s]=num/den;
    }
    return L;
}
// Textbook Griffin-Lim on the whole utterance, then its inverse STFT.
spk_ref_whole :: (sh:SpkShape,u:[]SpkUtterance,re:[]f64,im:[]f64,mag:[]f64,x:[]f64,den:[]f64,out:[]f64)->int {
    n:=sh.n;h:=sh.hop;T:=spk_frames(u);L:=(T-1)*h+n;bins:=n/2+1;
    w:[SPK_N_MAX]f64;tr:[SPK_N_MAX]f64;ti:[SPK_N_MAX]f64;spk_window(w[0..<n]);
    for t:0..<T {
        spk_frame(sh,u,t,mag[t*bins..<(t+1)*bins]);
        for k:0..<n {
            kk:=k;if 2*k>n {kk=n-k;}
            m:=mag[t*bins+kk];
            if t==0 {re[k]=m;im[k]=0;continue;}
            ur:=1.0;ui:=0.0;
            a:=sqrt(re[(t-1)*n+k]*re[(t-1)*n+k]+im[(t-1)*n+k]*im[(t-1)*n+k]);if a>0 {ur=re[(t-1)*n+k]/a;ui=im[(t-1)*n+k]/a;}
            turn:=sf_turn((k*(n-h))%n,n);
            re[t*n+k]=m*(ur*turn.re-ui*turn.im);im[t*n+k]=m*(ur*turn.im+ui*turn.re);
        }
    }
    for s:0..<L {den[s]=0;}
    for t:0..<T {for m:0..<n {den[t*h+m]+=w[m]*w[m];}}
    for i:0..<sh.iters {
        for s:0..<L {x[s]=0;}
        for t:0..<T {
            for k:0..<n {tr[k]=re[t*n+k];ti[k]=im[t*n+k];}
            #assert sf_fft(tr[0..<n],ti[0..<n],true)==SfStatus.ok;
            for m:0..<n {x[t*h+m]+=w[m]*tr[m];}
        }
        for s:0..<L {x[s]=x[s]/den[s];}
        for t:0..<T {
            for m:0..<n {tr[m]=x[t*h+m]*w[m];ti[m]=0;}
            #assert sf_fft(tr[0..<n],ti[0..<n],false)==SfStatus.ok;
            for k:0..<n {
                kk:=k;if 2*k>n {kk=n-k;}
                m:=mag[t*bins+kk];a:=sqrt(tr[k]*tr[k]+ti[k]*ti[k]);
                if a>0 {re[t*n+k]=m*(tr[k]/a);im[t*n+k]=m*(ti[k]/a);}
            }
        }
    }
    return spk_ref_istft(sh,re,im,T,out);
}
// The stream's blocks solved one after another with spk_solve, every frame
// kept, then one inverse STFT.
spk_ref_blocks :: (sh:SpkShape,u:[]SpkUtterance,work:[]f64,re:[]f64,im:[]f64,out:[]f64)->int {
    p:=spk_plan(sh);n:=sh.n;bins:=n/2+1;T:=spk_frames(u);curve:[SPK_ITERS_MAX]f64;
    spk_window(work[p.at_w..<p.at_w+n]);
    s0:=0;
    while s0<T {
        c:=p.context;if s0<c {c=s0;}
        b:=sh.block;if T-s0<b {b=T-s0;}
        for i:0..<c*n {work[p.at_re+i]=re[(s0-c)*n+i];work[p.at_im+i]=im[(s0-c)*n+i];}
        for j:0..<b {
            mag:=work[p.at_mag+j*bins..<p.at_mag+(j+1)*bins];
            spk_frame(sh,u,s0+j,mag);
            spk_guess(sh,work[p.at_re..<p.at_re+(c+b)*n],work[p.at_im..<p.at_im+(c+b)*n],c+j,mag);
        }
        #assert spk_solve(sh,p,c,b,work,curve[..])>=b;
        for i:0..<b*n {re[s0*n+i]=work[p.at_re+c*n+i];im[s0*n+i]=work[p.at_im+c*n+i];}
        s0+=b;
    }
    return spk_ref_istft(sh,re,im,T,out);
}
// Run a stream to its end, appending every chunk to audio; the chunks.
spk_ref_stream :: (st:[]SpkStream,u:[]SpkUtterance,work:[]f64,audio:[]f64)->int {
    curve:[SPK_ITERS_MAX]f64;k:=0;at:=0;
    while true {
        r:=spk_next(st,u,work,audio[at..<audio.count],curve[..]);
        if r.status!=SpkStatus.ok {return k;}
        at+=r.samples;k+=1;
    }
    return k;
}
// The phone names of an utterance, joined by spaces.
spk_ref_names :: (u:[]SpkUtterance,out:[]u8)->string {
    n:=0;
    for k:0..<u[0].phones {
        name:=SPK_NAMES[u[0].id[k]];
        if k>0 {out[n]=' ';n+=1;}
        for i:0..<name.count {out[n]=name[i];n+=1;}
    }
    return cast(string)out[0..<n];
}

// Helpers for the checks in psionic/lib/speak.coax.
spk_tiny :: ()->SpkShape {return SpkShape.{rate=8000,n=16,hop=4,block=3,iters=4};}
spk_text_is :: (text:string,want:string)->bool {
    out:[256]u8;r:=spk_normalize(text,out[..]);
    return r.status==SpkStatus.ok && cast(string)out[0..<r.count]==want;
}
spk_names_are :: (text:string,want:string)->bool {
    u:[1]SpkUtterance;buf:[1024]u8;
    return spk_phonemize(text,u[..])==SpkStatus.ok && spk_ref_names(u[..],buf[..])==want;
}
spk_weighted :: (a:[26]f64)->f64 {s:=0.0;for i:0..<26 {s+=f64(i+1)*a[i];}return s;}
// A block for Griffin-Lim: c context frames from the STFT of a signal,
// then b frames whose targets are that signal's magnitudes (consistent)
// or seeded ones (not), with first estimates.
spk_test_block :: (sh:SpkShape,c:int,b:int,seed:int,consistent:bool,work:[]f64)->SpkPlan {
    p:=spk_plan(sh);n:=sh.n;bins:=n/2+1;
    x:[512]f64;spk_noise(seed,x[0..<(c+b-1)*sh.hop+n]);
    w:=work[p.at_w..<p.at_w+n];spk_window(w);
    re:=work[p.at_re..<p.at_re+(c+b)*n];im:=work[p.at_im..<p.at_im+(c+b)*n];
    r:[64]f64;q:[64]f64;
    for f:0..<c+b {
        spk_ref_frame(x[..],f*sh.hop,w,r[0..<n],q[0..<n]);
        if f<c {for k:0..<n {re[f*n+k]=r[k];im[f*n+k]=q[k];}continue;}
        mag:=work[p.at_mag+(f-c)*bins..<p.at_mag+(f-c+1)*bins];
        for k:0..<bins {mag[k]=sqrt(r[k]*r[k]+q[k]*q[k]);if !consistent {mag[k]=abs(x[(7*f+3*k)%x.count])*f64(n)/4;}}
        spk_guess(sh,re,im,f,mag);
    }
    return p;
}
spk_test_utterance :: (text:string,u:[]SpkUtterance) {#assert spk_phonemize(text,u)==SpkStatus.ok;}
