// Chapter 187's check helpers, loaded by psionic/lib/stage-package.coax and
// owned by its checks and examples: chapter 81's synthetic model (as
// chapter 186's stg_tiny lays it out) written as a real safetensors file,
// with the names, shapes and order of the Ministral checkpoint's header, and
// one tensor of the image path the text stages never need.

SPX_FILE_MAX :: 16384;
// Room for a check's file, manifest and scratch; the six-layer shape.
SpxWork :: struct {inventory:[64]P5Tensor;draft:[64]P5Tensor;picked:[64]int;text:[8192]u8;file:[SPX_FILE_MAX]u8;}
MS_TINY_LAYERS6 :: MsShape.{width=8,layers=6,heads=4,kv_heads=2,head_dim=4,hidden=12,vocab=16};
// The order in which stg_tiny writes a layer's tensors, as chapter 81's
// inventory index k (wk wo wq wv attention_norm w1 w2 w3 ffn_norm).
SPX_ORDER :: [9]int.[2,0,3,1,5,6,7,4,8];
spx_name :: (s:MsShape,e:int,out:[]u8)->int {
    x:=ms_expected(s,e);at:=0;
    if x.layer>=0 {at=pv_decimal(x.layer,out,pv_text("layers.",out,0));}
    return pv_text(x.name,out,at);
}
// The file for `layers` synthetic layers: an 8-byte header length, the JSON
// header in chapter 81's inventory order, the payload in stg_tiny's order,
// then 8 bytes of "vision_encoder.patch.weight". Returns its length.
spx_file :: (layers:int,out:[]u8)->int {
    s:=ms_tiny();s.layers=layers;count:=ms_expected_count(s);
    begin:[56]int;at:=0;
    begin[1]=at;at+=sp_size(s,1);begin[0]=at;at+=sp_size(s,0);
    for l:0..<layers {for k:SPX_ORDER {e:=2+9*l+k;begin[e]=at;at+=sp_size(s,e);}}
    data:=at;
    head:[8192]u8;name:[64]u8;h:=pv_text("{",head[..],0);
    for e:0..<count {
        x:=ms_expected(s,e);n:=spx_name(s,e,name[..]);
        h=pv_text("\":{\"dtype\":\"BF16\",\"shape\":[",head[..],pv_text(cast(string)name[0..<n],head[..],pv_text("\"",head[..],h)));
        h=pv_decimal(x.rows,head[..],h);
        if x.rank==2 {h=pv_decimal(x.cols,head[..],pv_text(",",head[..],h));}
        h=pv_decimal(begin[e],head[..],pv_text("],\"data_offsets\":[",head[..],h));
        h=pv_text("]},",head[..],pv_decimal(begin[e]+sp_size(s,e),head[..],pv_text(",",head[..],h)));
    }
    h=pv_text("\"vision_encoder.patch.weight\":{\"dtype\":\"BF16\",\"shape\":[4],\"data_offsets\":[",head[..],h);
    h=pv_text("]}}",head[..],pv_decimal(data+8,head[..],pv_text(",",head[..],pv_decimal(data,head[..],h))));
    for i:0..<8 {out[i]=cast(u8)((h>>(8*i))&255);}
    for i:0..<h {out[8+i]=head[i];}
    t:=stg_tiny(layers,out[8+h..<8+h+data]);#assert t.shape.layers==layers;
    for i:0..<8 {out[8+h+data+i]=cast(u8)(17*i+3);}
    return 8+h+data+8;
}
// Hex SHA-256 of bytes, for the checks' expected digests.
spx_hex :: (data:[]u8,out:[]u8)->string {h:=sp_hex(data);for i:0..<64 {out[i]=h[i];}return cast(string)out[0..<64];}
// A plan of the synthetic model under budgets, at `context` positions.
spx_plan :: (layers:int,budget:[]int,context:int)->StgPlan {s:=ms_tiny();s.layers=layers;return stg_plan(stg_ministral(s),budget,context);}
// Chapter 81's inventory of Ministral 3 3B with byte ranges laid end to end
// (no bytes behind them), plus one image tensor at the end.
spx_ministral :: (out:[]P5Tensor,names:[]u8)->int {
    s:=MS_3B;at:=1000;used:=0;
    for e:0..<ms_expected_count(s) {
        n:=spx_name(s,e,names[used..<used+64]);
        out[e]=P5Tensor.{name=cast(string)names[used..<used+n],dtype=PwDtype.bf16,begin=at,end=at+sp_size(s,e)};
        used+=n;at+=sp_size(s,e);
    }
    k:=ms_expected_count(s);out[k]=P5Tensor.{name="vision_encoder.x",dtype=PwDtype.bf16,begin=at,end=at+2};
    return k+1;
}
// The planner's per-stage bytes with no context are the weights a stage
// holds plus, on the last stage, its logits buffers.
spx_weights :: (m:StgModel,p:StgPlan,k:int)->int {
    last:=k==p.stages-1;b:=stg_bytes(m,p.cut[k],p.cut[k+1],k==0,last,0);
    if last {b-=m.out;}
    return b;
}
// A manifest with its first `from` replaced by `to`. Returns the new length.
spx_edit :: (text:[]u8,from:string,to:string,out:[]u8)->int {
    for i:0..<text.count-from.count+1 {
        if cast(string)text[i..<i+from.count]!=from {continue;}
        at:=pv_text(cast(string)text[0..<i],out,0);at=pv_text(to,out,at);
        return pv_text(cast(string)text[i+from.count..<text.count],out,at);
    }
    return -1;
}
spx_is :: (c:SpStage,status:SpStatus,tensor:int,hashed:int)->bool {return c.status==status && c.tensor==tensor && c.hashed==hashed && c.life.state==CsState.failed;}
