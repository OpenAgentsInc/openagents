// Buffers for TL_SPLIT (or chapter 113's TD_TINY) at up to 4 devices.
TlBuffers :: struct {p:[776]f64;shards:[4*776]f64;works:[4*240]f64;partials:[4*64]f64;reduced:[64]f64;logits:[48]f64;}
tlt_gap :: (a:[]f64,b:[]f64)->f64 {worst:=0.0;for i:0..<a.count {g:=abs(a[i]-b[i]);if g>worst {worst=g;}}return worst;}
tlt_same :: (a:[]f64,b:[]f64)->bool {for i:0..<a.count {if a[i]!=b[i] {return false;}}return true;}
