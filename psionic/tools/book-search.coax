// Search the Coax, Psionic and Aethyr books (Psionic chapter 54).
//   coax/web/tool.sh psionic/tools/book-search.coax "how do I keep a model resident"
//   ... "query" --k 10 --book psionic --mode bm25|dense|fused --json
//   ... --eval psionic/fixtures/book-search/heldout.tsv [--json]
//   ... --rerank-eval psionic/fixtures/book-search/heldout.tsv   (chapter 56)
//   ... --answer-eval psionic/fixtures/book-search/heldout.tsv   (chapter 57)
//   ... --bundle DIR [--reference FILE]   the browser bundle and native result lines (chapter 59)
//   ... --no-build      refuse a stale index instead of rebuilding it
//   ... --rebuild       rebuild the index;  --train  retrain the weights too
// Runs from the repository root. The weights and the index live in
// coax/web/build/book-search/ (not tracked). The first run trains the weights
// (about a minute on one CPU core); later runs rebuild only a stale index.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../lib/book-search/encoder.coax";
#load "../lib/book-search/hnsw.coax";
#load "../lib/book-search/rerank.coax";
#load "../lib/book-search/answer.coax";
#load "../lib/book-search/browser.coax";
#load "../lib/verdict.coax";

FILES_MAX :: 1024;
TEXT_MAX :: 16777216;
HEADS_MAX :: 2097152;
NAMES_MAX :: 131072;
PASSAGES_MAX :: 16384;
IDS_MAX :: 4194304;
VOCAB_MAX :: 16384;
COUNT_MAX :: 262144;
OUT_MAX :: 33554432;
LIST_MAX :: 100;

BsFile :: struct { path_from: int; path_to: int; text_from: int; text_to: int; book: int; status: BsStatus; hash: [32] u8; rev: [12] u8; edited: bool; }
Bs :: struct {
  text: [] u8; text_n: int; heads: [] u8; heads_n: int; names: [] u8; names_n: int;
  files: [] BsFile; file_n: int; passages: [] BsPassage; passage_n: int; revision: [40] u8;
  ids: [] int; ids_n: int; hf: [] int; ht: [] int; bf: [] int; bt: [] int;
  terms: [] int; counts: [] int; tf: [] int; tt: [] int; df: [] int; average: f64;
  vocab: [] BsVocab; table: [] f64; query: [] f64; embeddings: [] f32; digest: [32] u8; trained_at: [40] u8;
}
Bw :: struct { buf: [] u8; n: int; full: bool; }
Br :: struct { buf: [] u8; at: int; n: int; bad: bool; }
Labels :: struct { relevant: int; }

BOOK_DIRS :: [3] string.["coax/book", "psionic/book", "aethyr/book"];
PROFILE :: "bs-attnpool-d64-v1";
CONFIG :: BeConfig.{steps = 1500, batch = 64, tau = 0.05, lr = 0.01, seed = 54};

// ---- bytes in and out ------------------------------------------------------
bw_byte :: (w: [] Bw, c: u8) { if w[0].n == w[0].buf.count { w[0].full = true; return; } w[0].buf[w[0].n] = c; w[0].n += 1; }
bw_u32 :: (w: [] Bw, x: int) { for i: 0..<4 { bw_byte(w, cast,trunc(u8) ((x >> (8 * i)) & 255)); } }
bw_bytes :: (w: [] Bw, s: [] u8) { for c: s { bw_byte(w, c); } }
bw_str :: (w: [] Bw, s: string) { bw_u32(w, s.count); for c: s { bw_byte(w, c); } }
bw_f32 :: (w: [] Bw, x: f32) { b := f32_bits(x); for i: 0..<4 { bw_byte(w, cast,trunc(u8) ((b >> cast(u32) (8 * i)) & 255)); } }
br_byte :: (r: [] Br) -> u8 { if r[0].at >= r[0].n { r[0].bad = true; return 0; } c := r[0].buf[r[0].at]; r[0].at += 1; return c; }
br_u32 :: (r: [] Br) -> int { x := 0; for i: 0..<4 { x |= cast(int) br_byte(r) << (8 * i); } return x; }
br_f32 :: (r: [] Br) -> f32 { b: u32 = 0; for i: 0..<4 { b |= cast(u32) br_byte(r) << cast(u32) (8 * i); } return f32_from_bits(b); }
br_into :: (r: [] Br, out: [] u8) { for i: 0..<out.count { out[i] = br_byte(r); } }
br_str :: (r: [] Br) -> string {
  n := br_u32(r);
  if n < 0 || r[0].at + n > r[0].n { r[0].bad = true; return ""; }
  s := cast(string) r[0].buf[r[0].at..<r[0].at + n]; r[0].at += n; return s;
}
put :: (out: [] u8, at: int, s: string) -> int { for i: 0..<s.count { out[at + i] = s[i]; } return at + s.count; }

// ---- numbers as text ---------------------------------------------------------
fixed :: (x: f64, digits: int, out: [] u8) -> string {
  scale := 1; for i: 0..<digits { scale *= 10; }
  neg := x < 0; y := ifx neg then -x else x;
  v := cast(int) (y * f64(scale) + 0.5);
  n := 0; if neg && v > 0 { out[n] = '-'; n += 1; }
  whole := v / scale; frac := v % scale;
  digs: [24] u8; k := 0;
  if whole == 0 { digs[0] = '0'; k = 1; }
  while whole > 0 { digs[k] = cast,trunc(u8) ('0' + whole % 10); whole /= 10; k += 1; }
  while k > 0 { k -= 1; out[n] = digs[k]; n += 1; }
  if digits > 0 {
    out[n] = '.'; n += 1;
    d := scale / 10;
    while d > 0 { out[n] = cast,trunc(u8) ('0' + (frac / d) % 10); n += 1; d /= 10; }
  }
  return cast(string) out[0..<n];
}

// ---- the books -------------------------------------------------------------
revision :: (b: Bs, n: int, out: [] u8) -> string { r := b.revision; for i: 0..<n { out[i] = r[i]; } return cast(string) out[0..<n]; }
file_path :: (b: Bs, f: int) -> string { return cast(string) b.names[b.files[f].path_from..<b.files[f].path_to]; }
file_name :: (b: Bs, f: int) -> string { return fs_base(file_path(b, f)); }
file_rev :: (b: Bs, f: int) -> string {
  n := 0; while n < 12 && b.files[f].rev[n] != 0 { n += 1; }
  return cast(string) b.files[f].rev[0..<n];
}

// Lists and reads every chapter file of the three books, sorted by path.
read_books :: (s: [] Bs, root: string) -> bool {
  s[0].file_n = 0; s[0].text_n = 0; s[0].names_n = 0;
  dir: [4096] u8; full: [4096] u8;
  // Aethyr, Coax, Psionic: the paths come out sorted, which find_file and
  // the freshness check rely on.
  order := [3] int.[2, 0, 1];
  for book: order {
    l: [1] FsList;
    k := fs_list(fs_join(root, BOOK_DIRS[book], dir[..]), l[..]);
    if k < 0 { tool_errln("book-search: cannot list a book directory"); return false; }
    for i: 0..<k {
      name := fs_entry(l[..], i);
      if name.count < 4 || name[name.count - 3..<name.count] != ".md" { continue; }
      if s[0].file_n == FILES_MAX { tool_errln("book-search: too many chapter files"); return false; }
      f := s[0].file_n; s[0].file_n += 1;
      at := s[0].names_n;
      at = put(s[0].names, at, BOOK_DIRS[book]); s[0].names[at] = '/'; at = put(s[0].names, at + 1, name);
      s[0].files[f] = BsFile.{path_from = s[0].names_n, path_to = at, book = book};
      s[0].names_n = at;
      path := fs_join(root, file_path(s[0], f), full[..]);
      n := fs_read(path, s[0].text[s[0].text_n..<s[0].text.count]);
      if n < 0 { tool_errln("book-search: cannot read a chapter file"); return false; }
      s[0].files[f].text_from = s[0].text_n; s[0].files[f].text_to = s[0].text_n + n; s[0].text_n += n;
      text := cast(string) s[0].text[s[0].files[f].text_from..<s[0].files[f].text_to];
      s[0].files[f].status = bs_status(name, text);
      s[0].files[f].hash = bs_file_hash(s[0].text, s[0].files[f].text_from, s[0].files[f].text_to);
    }
  }
  return true;
}

find_file :: (b: Bs, path: string) -> int {
  lo := 0; hi := b.file_n;
  while lo < hi { mid := (lo + hi) / 2; if bs_less(file_path(b, mid), path) { lo = mid + 1; } else { hi = mid; } }
  if lo < b.file_n && file_path(b, lo) == path { return lo; }
  return -1;
}

// HEAD, and each file's last commit; files with uncommitted edits say so.
revisions :: (s: [] Bs, root: string) -> bool {
  out: [4194304] u8; err: [4096] u8;
  argv := [5] string.["git", "-C", root, "rev-parse", "HEAD"];
  r := proc_run(argv[..], 30000, out[..], err[..]);
  if r.started != 0 || r.status != 0 || r.out_n < 40 { tool_errln("book-search: git rev-parse HEAD failed"); return false; }
  for i: 0..<40 { s[0].revision[i] = out[i]; }
  logv := [10] string.["git", "-C", root, "log", "--format=%H", "--name-only", "--", "coax/book", "psionic/book", "aethyr/book"];
  r = proc_run(logv[..], 60000, out[..], err[..]);
  if r.started != 0 || r.status != 0 || r.cut { tool_errln("book-search: git log failed"); return false; }
  commit := 0; at := 0;
  while at < r.out_n {
    end := at; while end < r.out_n && out[end] != '\n' { end += 1; }
    line := cast(string) out[at..<end];
    if line.count == 40 && !bs_has_slash(line) { commit = at; }
    else if line.count > 0 {
      f := find_file(s[0], line);
      if f >= 0 && s[0].files[f].rev[0] == 0 { for i: 0..<12 { s[0].files[f].rev[i] = out[commit + i]; } }
    }
    at = end + 1;
  }
  st := [9] string.["git", "-C", root, "status", "--porcelain", "--", "coax/book", "psionic/book", "aethyr/book"];
  r = proc_run(st[..], 30000, out[..], err[..]);
  if r.started != 0 || r.status != 0 { tool_errln("book-search: git status failed"); return false; }
  at = 0;
  while at < r.out_n {
    end := at; while end < r.out_n && out[end] != '\n' { end += 1; }
    if end - at > 3 { f := find_file(s[0], cast(string) out[at + 3..<end]); if f >= 0 { s[0].files[f].edited = true; } }
    at = end + 1;
  }
  return true;
}
bs_has_slash :: (s: string) -> bool { for c: s { if c == '/' || c == '.' { return true; } } return false; }

chunk_books :: (s: [] Bs) -> bool {
  s[0].passage_n = 0; s[0].heads_n = 0;
  for f: 0..<s[0].file_n {
    r := bs_chunk(s[0].text, s[0].files[f].text_from, s[0].files[f].text_to, f, s[0].passages, s[0].passage_n, s[0].heads, s[0].heads_n);
    if r.full { tool_errln("book-search: too many passages"); return false; }
    s[0].passage_n = r.passages; s[0].heads_n = r.heads;
  }
  return true;
}

// ---- words -------------------------------------------------------------------
// Appends the vocabulary ids of text's words to s.ids (unknown words dropped).
add_words :: (s: [] Bs, table: [] u8, t: PtLayout, text: string) -> bool {
  word: [64] u8; at := 0;
  while at < text.count {
    w := bs_word(table, t, text, at, word[..]);
    if w.size > 0 {
      id := bs_find(s[0].vocab[0], cast(string) word[0..<w.size]);
      if id >= 0 { if s[0].ids_n == s[0].ids.count { return false; } s[0].ids[s[0].ids_n] = id; s[0].ids_n += 1; }
    }
    at = w.next;
  }
  return true;
}
// Every passage's heading words and text words, then BM25's term lists.
tokenize :: (s: [] Bs, seen: [] int, slot: [] int) -> bool {
  table := PT_TOY; t := pt_layout(table[..]);
  s[0].ids_n = 0;
  for p: 0..<s[0].passage_n {
    q := s[0].passages[p];
    s[0].hf[p] = s[0].ids_n;
    if !add_words(s, table[..], t, cast(string) s[0].heads[q.head_from..<q.head_to]) { return false; }
    s[0].ht[p] = s[0].ids_n; s[0].bf[p] = s[0].ids_n;
    if !add_words(s, table[..], t, cast(string) s[0].text[q.from..<q.to]) { return false; }
    s[0].bt[p] = s[0].ids_n;
  }
  v := s[0].vocab[0].n;
  for i: 0..<v { seen[i] = -1; s[0].df[i] = 0; }
  n := 0; total := 0;
  for p: 0..<s[0].passage_n {
    s[0].tf[p] = n;
    for i: s[0].hf[p]..<s[0].bt[p] {
      id := s[0].ids[i];
      if seen[id] == p { s[0].counts[slot[id]] += 1; continue; }
      seen[id] = p; slot[id] = n; s[0].terms[n] = id; s[0].counts[n] = 1; n += 1;
    }
    // Sort this passage's distinct terms, keeping counts with them.
    for i: s[0].tf[p] + 1..<n {
      a := s[0].terms[i]; c := s[0].counts[i]; j := i;
      while j > s[0].tf[p] && s[0].terms[j - 1] > a { s[0].terms[j] = s[0].terms[j - 1]; s[0].counts[j] = s[0].counts[j - 1]; j -= 1; }
      s[0].terms[j] = a; s[0].counts[j] = c;
    }
    s[0].tt[p] = n;
    for i: s[0].tf[p]..<n { s[0].df[s[0].terms[i]] += 1; }
    total += s[0].bt[p] - s[0].hf[p];
  }
  s[0].average = ifx s[0].passage_n > 0 then f64(total) / f64(s[0].passage_n) else 1;
  return true;
}

// ---- weights -----------------------------------------------------------------
train :: (s: [] Bs, root: string, path: string) -> bool {
  tool_errln("book-search: training the weights (bs-attnpool-d64-v1) on the books at this revision...");
  slots: [2 * COUNT_MAX] int; pool: [4194304] u8; from: [COUNT_MAX] int; size: [COUNT_MAX] int; count: [COUNT_MAX] int;
  counted := [1] BsVocab.[BsVocab.{slots = slots[..], pool = pool[..], from = from[..], size = size[..], count = count[..]}];
  bs_vocab_clear(counted[..]);
  table := PT_TOY; t := pt_layout(table[..]); word: [64] u8;
  for p: 0..<s[0].passage_n {
    q := s[0].passages[p];
    texts := [2] string.[cast(string) s[0].heads[q.head_from..<q.head_to], cast(string) s[0].text[q.from..<q.to]];
    for text: texts {
      at := 0;
      while at < text.count { w := bs_word(table[..], t, text, at, word[..]); if w.size > 0 { e := bs_count(counted[..], cast(string) word[0..<w.size]); } at = w.next; }
    }
  }
  if counted[0].full { tool_errln("book-search: the word counter is full"); return false; }
  order: [COUNT_MAX] int; scratch: [COUNT_MAX] int;
  kept := bs_vocab_select(counted[0], 2, s[0].vocab, order[..], scratch[..]);
  seen: [VOCAB_MAX] int; slot: [VOCAB_MAX] int;
  if !tokenize(s, seen[..], slot[..]) { tool_errln("book-search: too many words"); return false; }
  n := kept * BE_WIDTH;
  m: [VOCAB_MAX * BE_WIDTH] f64; v: [VOCAB_MAX * BE_WIDTH] f64; g: [VOCAB_MAX * BE_WIDTH] f64;
  mq: [BE_WIDTH] f64; vq: [BE_WIDTH] f64; gq: [BE_WIDTH] f64; mark: [VOCAB_MAX] int;
  t0 := proc_now_ms();
  P := s[0].passage_n;
  r := be_train(CONFIG, s[0].ids[0..<s[0].ids_n], s[0].hf[0..<P], s[0].ht[0..<P], s[0].bf[0..<P], s[0].bt[0..<P], s[0].table[0..<n], s[0].query,
                m[0..<n], v[0..<n], g[0..<n], mq[..], vq[..], gq[..], mark[0..<kept]);
  if !r.ok { tool_errln("book-search: training refused its configuration"); return false; }
  o: [64] u8; o2: [64] u8;
  ib: [32] u8;
  print_err3("book-search: trained ", itoa(CONFIG.steps, ib[..]), " steps");
  print_err3("  loss over the first steps ", fixed(r.first, 3, o[..]), "");
  print_err3("  loss over the last steps  ", fixed(r.last, 3, o2[..]), "");
  print_err3("  seconds ", fixed(f64(proc_now_ms() - t0) / 1000, 1, o[..]), "");
  for i: 0..<40 { s[0].trained_at[i] = s[0].revision[i]; }
  return save_weights(s, path);
}
print_err3 :: (a: string, b: string, c: string) { tool_err(a); tool_err(b); tool_errln(c); }
itoa :: (x: int, out: [] u8) -> string { return fixed(f64(x), 0, out); }

WEIGHTS_MAGIC :: "PSIONIC-BOOK-SEARCH-WEIGHTS-1\n";
save_weights :: (s: [] Bs, path: string) -> bool {
  buf: [OUT_MAX] u8; w := [1] Bw.[Bw.{buf = buf[..]}];
  for c: WEIGHTS_MAGIC { bw_byte(w[..], c); }
  bw_str(w[..], PROFILE); bw_bytes(w[..], s[0].trained_at[..]);
  v := s[0].vocab[0]; bw_u32(w[..], v.n); bw_u32(w[..], BE_WIDTH);
  for e: 0..<v.n { bw_str(w[..], bs_vocab_word(v, e)); bw_u32(w[..], v.count[e]); }
  for i: 0..<v.n * BE_WIDTH { bw_f32(w[..], cast(f32) s[0].table[i]); }
  for d: 0..<BE_WIDTH { bw_f32(w[..], cast(f32) s[0].query[d]); }
  if w[0].full || !fs_write(path, cast(string) buf[0..<w[0].n]) { tool_errln("book-search: cannot write the weights"); return false; }
  return load_weights(s, path);
}
// Reads the weights back; the table is used exactly as stored (binary32).
load_weights :: (s: [] Bs, path: string) -> bool {
  buf: [OUT_MAX] u8;
  n := fs_read(path, buf[..]);
  if n < 0 { return false; }
  r := [1] Br.[Br.{buf = buf[..], n = n}];
  magic: [30] u8; br_into(r[..], magic[..]);
  if cast(string) magic[..] != WEIGHTS_MAGIC || br_str(r[..]) != PROFILE { tool_errln("book-search: the weights file has another format"); return false; }
  br_into(r[..], s[0].trained_at[..]);
  count := br_u32(r[..]); width := br_u32(r[..]);
  if count < 1 || count > VOCAB_MAX || width != BE_WIDTH { return false; }
  bs_vocab_clear(s[0].vocab);
  for e: 0..<count { word := br_str(r[..]); c := br_u32(r[..]); id := bs_count(s[0].vocab, word); if id != e { return false; } s[0].vocab[0].count[id] = c; }
  for i: 0..<count * BE_WIDTH { s[0].table[i] = f64(br_f32(r[..])); }
  for d: 0..<BE_WIDTH { s[0].query[d] = f64(br_f32(r[..])); }
  if r[0].bad || r[0].at != n { return false; }
  s[0].digest = bs_file_hash(buf[..], 0, n);
  return true;
}

// ---- the index ------------------------------------------------------------------
INDEX_MAGIC :: "PSIONIC-BOOK-SEARCH-INDEX-1\n";
build_index :: (s: [] Bs, path: string) -> bool {
  seen: [VOCAB_MAX] int; slot: [VOCAB_MAX] int;
  if !tokenize(s, seen[..], slot[..]) { tool_errln("book-search: too many words"); return false; }
  P := s[0].passage_n;
  for p: 0..<P { be_embed(s[0].table, s[0].query, s[0].ids[s[0].hf[p]..<s[0].bt[p]], s[0].embeddings[p * BE_WIDTH..<(p + 1) * BE_WIDTH]); }
  buf: [OUT_MAX] u8; w := [1] Bw.[Bw.{buf = buf[..]}];
  for c: INDEX_MAGIC { bw_byte(w[..], c); }
  bw_bytes(w[..], s[0].revision[..]); bw_bytes(w[..], s[0].digest[..]);
  bw_u32(w[..], s[0].file_n);
  for f: 0..<s[0].file_n {
    x := s[0].files[f];
    bw_str(w[..], file_path(s[0], f)); bw_bytes(w[..], x.hash[..]); bw_bytes(w[..], x.rev[..]);
    bw_u32(w[..], ifx x.edited then 1 else 0); bw_u32(w[..], cast(int) x.status); bw_u32(w[..], x.book);
    bw_u32(w[..], x.text_from); bw_u32(w[..], x.text_to);
  }
  bw_u32(w[..], s[0].text_n); bw_bytes(w[..], s[0].text[0..<s[0].text_n]);
  bw_u32(w[..], s[0].heads_n); bw_bytes(w[..], s[0].heads[0..<s[0].heads_n]);
  bw_u32(w[..], P);
  for p: 0..<P {
    x := s[0].passages[p];
    bw_u32(w[..], x.file); bw_u32(w[..], x.from); bw_u32(w[..], x.to); bw_u32(w[..], x.head_from); bw_u32(w[..], x.head_to); bw_u32(w[..], x.part); bw_bytes(w[..], x.hash[..]);
  }
  for i: 0..<P * BE_WIDTH { bw_f32(w[..], s[0].embeddings[i]); }
  if w[0].full || !fs_write(path, cast(string) buf[0..<w[0].n]) { tool_errln("book-search: cannot write the index"); return false; }
  return true;
}
// Loads an index into s, replacing the books read from disk.
load_index :: (s: [] Bs, path: string, weights: [32] u8) -> int {
  buf: [OUT_MAX] u8;
  n := fs_read(path, buf[..]);
  if n < 0 { return -1; }
  r := [1] Br.[Br.{buf = buf[..], n = n}];
  magic: [28] u8; br_into(r[..], magic[..]);
  if cast(string) magic[..] != INDEX_MAGIC { return -1; }
  br_into(r[..], s[0].revision[..]);
  digest: [32] u8; br_into(r[..], digest[..]);
  for i: 0..<32 { if digest[i] != weights[i] { return -2; } }
  s[0].file_n = br_u32(r[..]); s[0].names_n = 0;
  if s[0].file_n < 0 || s[0].file_n > FILES_MAX { return -1; }
  for f: 0..<s[0].file_n {
    p := br_str(r[..]); at := put(s[0].names, s[0].names_n, p);
    x := BsFile.{path_from = s[0].names_n, path_to = at}; s[0].names_n = at;
    br_into(r[..], x.hash[..]); br_into(r[..], x.rev[..]);
    x.edited = br_u32(r[..]) == 1; x.status = cast(BsStatus) br_u32(r[..]); x.book = br_u32(r[..]);
    x.text_from = br_u32(r[..]); x.text_to = br_u32(r[..]);
    s[0].files[f] = x;
  }
  s[0].text_n = br_u32(r[..]);
  if s[0].text_n < 0 || s[0].text_n > s[0].text.count { return -1; }
  br_into(r[..], s[0].text[0..<s[0].text_n]);
  // Status is read again from the stored text, so the current rules decide it.
  for f: 0..<s[0].file_n {
    x := s[0].files[f];
    if x.text_from < 0 || x.text_to < x.text_from || x.text_to > s[0].text_n { return -1; }
    s[0].files[f].status = bs_status(file_name(s[0], f), cast(string) s[0].text[x.text_from..<x.text_to]);
  }
  s[0].heads_n = br_u32(r[..]);
  if s[0].heads_n < 0 || s[0].heads_n > s[0].heads.count { return -1; }
  br_into(r[..], s[0].heads[0..<s[0].heads_n]);
  s[0].passage_n = br_u32(r[..]);
  if s[0].passage_n < 0 || s[0].passage_n > PASSAGES_MAX { return -1; }
  for p: 0..<s[0].passage_n {
    x: BsPassage;
    x.file = br_u32(r[..]); x.from = br_u32(r[..]); x.to = br_u32(r[..]); x.head_from = br_u32(r[..]); x.head_to = br_u32(r[..]); x.part = br_u32(r[..]);
    br_into(r[..], x.hash[..]);
    s[0].passages[p] = x;
  }
  for i: 0..<s[0].passage_n * BE_WIDTH { s[0].embeddings[i] = br_f32(r[..]); }
  if r[0].bad || r[0].at != n { return -1; }
  seen: [VOCAB_MAX] int; slot: [VOCAB_MAX] int;
  if !tokenize(s, seen[..], slot[..]) { return -1; }
  return 0;
}

// Compares the index's files with the books on disk and says what changed.
freshness :: (held: Bs, now: Bs, quiet: bool) -> BsFresh {
  hp: [FILES_MAX] string; hh: [FILES_MAX] string; np: [FILES_MAX] string; nh: [FILES_MAX] string;
  hx: [FILES_MAX * 64] u8; nx: [FILES_MAX * 64] u8;
  for f: 0..<held.file_n { hp[f] = file_path(held, f); hh[f] = bs_hex(held.files[f].hash, 32, hx[f * 64..<f * 64 + 64]); }
  for f: 0..<now.file_n { np[f] = file_path(now, f); nh[f] = bs_hex(now.files[f].hash, 32, nx[f * 64..<f * 64 + 64]); }
  r := bs_freshness(hp[0..<held.file_n], hh[0..<held.file_n], np[0..<now.file_n], nh[0..<now.file_n]);
  if !r.fresh && !quiet {
    ib: [32] u8;
    edited := 0; for f: 0..<now.file_n { if now.files[f].edited { edited += 1; } }
    rb: [40] u8; tool_err("book-search: stale index: it holds the books at revision "); tool_err(revision(held, 12, rb[..]));
    tool_err(", and the books now (revision "); tool_err(revision(now, 12, rb[..]));
    if edited > 0 { tool_err(", uncommitted edits in chapter files: "); tool_err(itoa(edited, ib[..])); }
    tool_errln(") differ:");
    print_err3("  changed files: ", itoa(r.changed, ib[..]), "");
    print_err3("  added files:   ", itoa(r.added, ib[..]), "");
    print_err3("  removed files: ", itoa(r.removed, ib[..]), "");
    if r.first >= 0 {
      print_err3("  first: ", hp[r.first], "");
      print_err3("    held content sha256 ", cast(string) hh[r.first][0..<16], "");
      j := find_file(now, hp[r.first]);
      if j >= 0 { print_err3("    now  content sha256 ", cast(string) nh[j][0..<16], ""); } else { tool_errln("    now: removed"); }
    }
  }
  return r;
}

// ---- search ------------------------------------------------------------------------
Search :: struct { e: [BE_WIDTH] f32; lexical: [LIST_MAX] BsHit; ln: int; dense: [LIST_MAX] BsHit; dn: int; fused: [LIST_MAX] BsHit; fn: int; words: int; known: int; }
search :: (b: Bs, text: string, book: int, scores: [] f64, out: [] Search) {
  table := PT_TOY; t := pt_layout(table[..]); word: [64] u8;
  ids: [4096] int; n := 0; words := 0; at := 0;
  while at < text.count && n < ids.count {
    w := bs_word(table[..], t, text, at, word[..]);
    if w.size > 0 { words += 1; id := bs_find(b.vocab[0], cast(string) word[0..<w.size]); if id >= 0 { ids[n] = id; n += 1; } }
    at = w.next;
  }
  out[0].words = words; out[0].known = n;
  be_embed(b.table, b.query, ids[0..<n], out[0].e[..]);
  distinct: [4096] int; for i: 0..<n { distinct[i] = ids[i]; }
  k := bs_distinct(distinct[0..<n]);
  P := b.passage_n;
  for p: 0..<P {
    scores[p] = bs_passage_bm25(distinct[0..<k], b.terms[b.tf[p]..<b.tt[p]], b.counts[b.tf[p]..<b.tt[p]], b.df, P, b.bt[p] - b.hf[p], b.average);
    if book >= 0 && b.files[b.passages[p].file].book != book { scores[p] = 0; }
  }
  out[0].ln = bs_top(scores[0..<P], 0, out[0].lexical[..]);
  for p: 0..<P {
    scores[p] = bs_dot(out[0].e[..], b.embeddings[p * BE_WIDTH..<(p + 1) * BE_WIDTH]);
    if (book >= 0 && b.files[b.passages[p].file].book != book) || n == 0 { scores[p] = -2; }
  }
  out[0].dn = bs_top(scores[0..<P], -2, out[0].dense[..]);
  bs_fuse(out[0].lexical[0..<out[0].ln], out[0].dense[0..<out[0].dn], scores[0..<P]);
  out[0].fn = bs_top(scores[0..<P], 0, out[0].fused[..]);
}
mode_hits :: (r: [] Search, mode: int) -> [] BsHit {
  if mode == 0 { return r[0].lexical[0..<r[0].ln]; }
  if mode == 1 { return r[0].dense[0..<r[0].dn]; }
  return r[0].fused[0..<r[0].fn];
}
MODES :: [3] string.["bm25", "dense", "fused"];

// One line of text: whitespace runs become one space, cut at `most` bytes on a character start.
snippet :: (s: string, most: int, out: [] u8) -> string {
  n := 0; space := false;
  for c: s {
    if c == '\n' || c == ' ' || c == '\t' || c == '\r' { space = n > 0; continue; }
    if n >= most && (c & 192) != 128 { out[n] = '.'; out[n + 1] = '.'; out[n + 2] = '.'; return cast(string) out[0..<n + 3]; }
    if space { out[n] = ' '; n += 1; space = false; }
    out[n] = c; n += 1;
  }
  return cast(string) out[0..<n];
}

json_result :: (b: Bs, j: [] Jo, rank: int, hit: BsHit) {
  q := b.passages[hit.passage]; f := b.files[q.file]; hx: [64] u8; num: [64] u8;
  jo_obj(j);
  jo_key(j, "rank"); jo_int(j, rank);
  jo_key(j, "book"); jo_str(j, bs_book_name(f.book));
  jo_key(j, "chapter"); jo_str(j, file_path(b, q.file));
  jo_key(j, "heading"); jo_str(j, cast(string) b.heads[q.head_from..<q.head_to]);
  jo_key(j, "part"); jo_int(j, q.part);
  jo_key(j, "passage"); jo_str(j, bs_hex(q.hash, 32, hx[..]));
  jo_key(j, "revision"); jo_str(j, file_rev(b, q.file));
  jo_key(j, "edited"); jo_bool(j, f.edited);
  st := bs_section_status(f.status, cast(string) b.heads[q.head_from..<q.head_to]);
  jo_key(j, "status"); jo_str(j, bs_status_name(st));
  jo_key(j, "shipped"); jo_bool(j, bs_shipped(st));
  jo_key(j, "score"); jo_raw(j, fixed(hit.score, 6, num[..]));
  jo_key(j, "text"); jo_str(j, cast(string) b.text[q.from..<q.to]);
  jo_end(j);
}
print_result :: (b: Bs, rank: int, hit: BsHit) {
  q := b.passages[hit.passage]; f := b.files[q.file]; hx: [64] u8; num: [64] u8; sn: [800] u8;
  print("%. % · % · %\n", rank, bs_book_name(f.book), file_path(b, q.file), cast(string) b.heads[q.head_from..<q.head_to]);
  st := bs_section_status(f.status, cast(string) b.heads[q.head_from..<q.head_to]);
  if !bs_shipped(st) { print("   [% — this text describes work that is not built; do not treat it as shipped]\n", bs_status_label(st)); }
  else { print("   [%]\n", bs_status_label(st)); }
  print("   revision %", file_rev(b, q.file));
  if f.edited { print(" + uncommitted edits"); }
  print(", passage % part %, score %\n", bs_hex(q.hash, 8, hx[..]), q.part, fixed(hit.score, 4, num[..]));
  print("   %\n\n", snippet(cast(string) b.text[q.from..<q.to], 600, sn[..]));
}

// ---- evaluation ------------------------------------------------------------------
// A query file holds lines "query<TAB>path#heading[;path#heading...]". A
// passage is relevant when it comes from that path and the heading is one of
// the components of its heading path. Lines that are empty or start with #
// are skipped.
mark_relevant :: (b: Bs, labels: string, relevant: [] bool) -> int {
  for p: 0..<b.passage_n { relevant[p] = false; }
  total := 0; at := 0;
  while at <= labels.count {
    end := at; while end < labels.count && labels[end] != ';' { end += 1; }
    label := labels[at..<end]; hash := 0; while hash < label.count && label[hash] != '#' { hash += 1; }
    if hash < label.count {
      path := label[0..<hash]; heading := label[hash + 1..<label.count];
      f := find_file(b, path);
      if f < 0 { tool_err("book-search: unknown labelled file: "); tool_errln(path); return -1; }
      matched := 0;
      for p: 0..<b.passage_n {
        q := b.passages[p];
        if q.file == f && has_component(cast(string) b.heads[q.head_from..<q.head_to], heading) { if !relevant[p] { relevant[p] = true; total += 1; } matched += 1; }
      }
      if matched == 0 { tool_err("book-search: no passage has the labelled heading: "); tool_errln(label); return -1; }
    }
    at = end + 1;
  }
  return total;
}
has_component :: (path: string, heading: string) -> bool {
  at := 0;
  while at <= path.count {
    end := at; while end + 2 < path.count && !(path[end] == ' ' && path[end + 1] == '>' && path[end + 2] == ' ') { end += 1; }
    if end + 2 >= path.count { end = path.count; }
    if path[at..<end] == heading { return true; }
    at = end + 3;
  }
  return false;
}
evaluate :: (b: Bs, file: string, json: bool, verbose: bool) -> int {
  text: [1048576] u8;
  n := fs_read(file, text[..]);
  if n < 0 { tool_errln("book-search: cannot read the query file"); return 2; }
  scores: [PASSAGES_MAX] f64; relevant: [PASSAGES_MAX] bool;
  r: [1] Search;
  recall1: [3] f64; recall5: [3] f64; recall10: [3] f64; mrr: [3] f64; queries := 0;
  at := 0;
  while at < n {
    end := at; while end < n && text[end] != '\n' { end += 1; }
    line := cast(string) text[at..<end]; at = end + 1;
    if line.count == 0 || line[0] == '#' { continue; }
    tab := 0; while tab < line.count && line[tab] != '\t' { tab += 1; }
    if tab == line.count { tool_errln("book-search: a query line has no tab"); return 2; }
    if mark_relevant(b, line[tab + 1..<line.count], relevant[..]) <= 0 { return 2; }
    search(b, line[0..<tab], -1, scores[..], r[..]);
    queries += 1;
    for m: 0..<3 {
      hits := mode_hits(r[..], m);
      top := ifx hits.count < 10 then hits.count else 10;
      first := bs_first_relevant(hits[0..<top], relevant[0..<b.passage_n]);
      if bs_hit(hits, relevant[0..<b.passage_n], 1) { recall1[m] += 1; }
      if bs_hit(hits, relevant[0..<b.passage_n], 5) { recall5[m] += 1; }
      if bs_hit(hits, relevant[0..<b.passage_n], 10) { recall10[m] += 1; }
      mrr[m] += bs_reciprocal(first, 10);
      if verbose { print("%\t%\t%\n", MODES[m], first, line[0..<tab]); }
    }
  }
  if queries == 0 { tool_errln("book-search: the query file has no queries"); return 2; }
  o1: [32] u8; o2: [32] u8; o3: [32] u8; o4: [32] u8;
  if json {
    buf: [8192] u8; j := [1] Jo.[Jo.{buf = buf[..]}]; hx: [64] u8;
    jo_obj(j[..]); jo_key(j[..], "queries"); jo_int(j[..], queries); jo_key(j[..], "passages"); jo_int(j[..], b.passage_n); jo_key(j[..], "vocabulary"); jo_int(j[..], b.vocab[0].n);
    jo_key(j[..], "revision"); rb: [40] u8; jo_str(j[..], revision(b, 40, rb[..])); jo_key(j[..], "weights"); jo_str(j[..], bs_hex(b.digest, 32, hx[..]));
    jo_key(j[..], "modes"); jo_obj(j[..]);
    for m: 0..<3 {
      jo_key(j[..], MODES[m]); jo_obj(j[..]);
      jo_key(j[..], "recall_at_1"); jo_raw(j[..], fixed(recall1[m] / f64(queries), 4, o1[..]));
      jo_key(j[..], "recall_at_5"); jo_raw(j[..], fixed(recall5[m] / f64(queries), 4, o2[..]));
      jo_key(j[..], "recall_at_10"); jo_raw(j[..], fixed(recall10[m] / f64(queries), 4, o3[..]));
      jo_key(j[..], "mrr_at_10"); jo_raw(j[..], fixed(mrr[m] / f64(queries), 4, o4[..]));
      jo_end(j[..]);
    }
    jo_end(j[..]); jo_end(j[..]);
    print("%\n", jo_text(j[..]));
    return 0;
  }
  rb: [40] u8;
  print("% queries over % passages and % words, books at %, weights %\n", queries, b.passage_n, b.vocab[0].n, revision(b, 12, rb[..]), bs_hex(b.digest, 8, o1[..]));
  print("| Retriever | Recall@1 | Recall@5 | Recall@10 | MRR@10 |\n| --- | ---: | ---: | ---: | ---: |\n");
  names := [3] string.["BM25", "Exhaustive vector search", "Psionic retriever (fused)"];
  for m: 0..<3 {
    print("| % | % | % | % | % |\n", names[m], fixed(recall1[m] / f64(queries), 3, o1[..]), fixed(recall5[m] / f64(queries), 3, o2[..]), fixed(recall10[m] / f64(queries), 3, o3[..]), fixed(mrr[m] / f64(queries), 3, o4[..]));
  }
  return 0;
}

// ---- chapter 56: candidates, reranking and three separate measurements ------------
// Settings fixed before the held-out run; the chapter records them.
HN_M :: 16; HN_EF_BUILD :: 128; HN_SEED :: 55; HN_EF :: 200;
POOL_MAX :: 2 * LIST_MAX;
TRAIN_POOL :: 1200; TRAIN_SEED :: 56; RERANK_SEED :: 56; FLOOR_RUNS :: 8;
RERANK :: RrConfig.{steps = 300, lr = 0.5, l2 = 0.001};
EVAL_MAX :: 64; QUERY_MAX :: 256;
RUNS :: FLOOR_RUNS + 1;
COLS :: 5 + FLOOR_RUNS;

Cands :: struct { q: [QUERY_MAX] int; qn: int; e: [BE_WIDTH] f32; lexical: [LIST_MAX] BsHit; ln: int; dense: [LIST_MAX] BsHit; dn: int; sims: int; }

// Known word ids of text, in order (unknown words dropped).
query_ids :: (b: Bs, text: string, out: [] int) -> int {
  table := PT_TOY; t := pt_layout(table[..]); word: [64] u8; n := 0; at := 0;
  while at < text.count && n < out.count {
    w := bs_word(table[..], t, text, at, word[..]);
    if w.size > 0 { id := bs_find(b.vocab[0], cast(string) word[0..<w.size]); if id >= 0 { out[n] = id; n += 1; } }
    at = w.next;
  }
  return n;
}
// BM25's top 100 and the dense top 100, from exhaustive search (ef 0) or the
// HNSW index. bm holds every passage's BM25 score afterwards.
candidates :: (b: Bs, ix: [] HnIndex, ef: int, ids: [] int, bm: [] f64, scores: [] f64, c: [] Cands) {
  P := b.passage_n;
  be_embed(b.table, b.query, ids, c[0].e[..]);
  n := ifx ids.count < QUERY_MAX then ids.count else QUERY_MAX;
  for i: 0..<n { c[0].q[i] = ids[i]; }
  c[0].qn = bs_distinct(c[0].q[0..<n]);
  for p: 0..<P { bm[p] = bs_passage_bm25(c[0].q[0..<c[0].qn], b.terms[b.tf[p]..<b.tt[p]], b.counts[b.tf[p]..<b.tt[p]], b.df, P, b.bt[p] - b.hf[p], b.average); }
  c[0].ln = bs_top(bm[0..<P], 0, c[0].lexical[..]);
  c[0].dn = 0; c[0].sims = 0;
  if ids.count == 0 { return; }
  if ef == 0 {
    for p: 0..<P { scores[p] = bs_dot(c[0].e[..], b.embeddings[p * BE_WIDTH..<(p + 1) * BE_WIDTH]); }
    c[0].dn = bs_top(scores[0..<P], -2, c[0].dense[..]); c[0].sims = P;
  } else {
    r := hn_search(ix, c[0].e[..], LIST_MAX, ef, c[0].dense[..]);
    c[0].dn = r.found; c[0].sims = r.sims;
  }
}
fused :: (b: Bs, c: [] Cands, scores: [] f64, out: [] BsHit) -> int {
  bs_fuse(c[0].lexical[0..<c[0].ln], c[0].dense[0..<c[0].dn], scores[0..<b.passage_n]);
  return bs_top(scores[0..<b.passage_n], 0, out);
}
// Seven features for each merged candidate into f.
features :: (b: Bs, unit: [] f64, c: [] Cands, cands: [] RrCand, bm: [] f64, f: [] f64) {
  P := b.passage_n; w: [QUERY_MAX] f64;
  for i: 0..<c[0].qn { w[i] = bs_idf(P, b.df[c[0].q[i]]); }
  best := 0.0;
  for x: cands { if bm[x.passage] > best { best = bm[x.passage]; } }
  head: [512] int;
  for x, i: cands {
    p := x.passage; hn := 0;
    for k: b.hf[p]..<b.ht[p] { if hn < head.count { head[hn] = b.ids[k]; hn += 1; } }
    hn = bs_distinct(head[0..<hn]);
    words := b.terms[b.tf[p]..<b.tt[p]];
    rr_row(x, bm[p], best, bs_dot(c[0].e[..], b.embeddings[p * BE_WIDTH..<(p + 1) * BE_WIDTH]),
           rr_coverage(c[0].q[0..<c[0].qn], w[0..<c[0].qn], head[0..<hn]), rr_coverage(c[0].q[0..<c[0].qn], w[0..<c[0].qn], words),
           rr_late(unit, BE_WIDTH, c[0].q[0..<c[0].qn], words), f[i * RR_FEATURES..<(i + 1) * RR_FEATURES]);
  }
}
heads_of :: (b: Bs, p: int) -> string { q := b.passages[p]; return cast(string) b.heads[q.head_from..<q.head_to]; }
last_heading :: (path: string) -> string {
  at := 0;
  for i: 0..<path.count - 2 { if path[i] == ' ' && path[i + 1] == '>' && path[i + 2] == ' ' { at = i + 3; } }
  return path[at..<path.count];
}
pct :: (x: f64, out: [] u8) -> string { return fixed(x, 3, out); }

// Chapter 56's training: synthetic queries from the books' structure, never
// from a query file, and `runs` rerankers trained on them (run 0 with
// RERANK_SEED, run r > 0 with seed r). ok is false after a refusal.
Trained :: struct { ok: bool; queries: int; usable: int; rows: int; features_ms: int; train_ms: int; }
train_rerankers :: (b: Bs, ix: [] HnIndex, unit: [] f64, runs: int, weights: [] f64, trained: [] RrTrained) -> Trained {
  P := b.passage_n; t1 := proc_now_ms();
  // Training queries from the books' structure, never from the query file.
  bm: [PASSAGES_MAX] f64; scores: [PASSAGES_MAX] f64; c: [1] Cands; ids: [QUERY_MAX] int;
  tf: [TRAIN_POOL * POOL_MAX * RR_FEATURES] f64; tl: [TRAIN_POOL * POOL_MAX] bool; tg: [TRAIN_POOL + 1] int;
  merged: [POOL_MAX] RrCand; tq := 0; rows := 0; usable := 0;
  for i: 0..<TRAIN_POOL {
    p := cast(int) (cr_bits(TRAIN_SEED, cast(u64) (3 * i)) % cast(u64) P);
    path := heads_of(b, p); pf := b.passages[p].file; n := 0; section := true;
    if i % 2 == 0 {
      n = query_ids(b, last_heading(path), ids[..]);
      section = false;
      if n < 2 { continue; }
    } else {
      body := b.bt[p] - b.bf[p];
      if body < 16 { continue; }
      n = 5 + cast(int) (cr_bits(TRAIN_SEED, cast(u64) (3 * i + 1)) % 6);
      at := b.bf[p] + cast(int) (cr_bits(TRAIN_SEED, cast(u64) (3 * i + 2)) % cast(u64) (body - n + 1));
      for k: 0..<n { ids[k] = b.ids[at + k]; }
    }
    candidates(b, ix[..], HN_EF, ids[0..<n], bm[..], scores[..], c[..]);
    m := rr_merge(c[0].lexical[0..<c[0].ln], c[0].dense[0..<c[0].dn], merged[..]);
    if m.status != RrStatus.ok { tool_errln("book-search: merge refused"); return Trained.{}; }
    tg[tq] = rows;
    features(b, unit[..], c[..], merged[0..<m.count], bm[..], tf[rows * RR_FEATURES..<(rows + m.count) * RR_FEATURES]);
    good := 0;
    for x, k: merged[0..<m.count] {
      rel := b.passages[x.passage].file == pf;
      if rel { rel = ifx section then heads_of(b, x.passage) == path else has_component(heads_of(b, x.passage), last_heading(path)); }
      tl[rows + k] = rel; if rel { good += 1; }
    }
    if good > 0 && good < m.count { usable += 1; }
    rows += m.count; tq += 1;
  }
  tg[tq] = rows;
  t2 := proc_now_ms();
  // The rerankers: run 0 is the reported one, the rest are for the floor;
  // each trains on the half of the training queries its seed picks.
  sf: [TRAIN_POOL * POOL_MAX * RR_FEATURES] f64; sl: [TRAIN_POOL * POOL_MAX] bool; sg: [TRAIN_POOL + 1] int;
  for run: 0..<runs {
    seed := ifx run == 0 then cast(u64) RERANK_SEED else cast(u64) run;
    n := 0; at := 0;
    for q: 0..<tq {
      if cr_bits(seed + 1000, cast(u64) q) % 2 != 0 { continue; }
      sg[n] = at; n += 1;
      for r: tg[q]..<tg[q + 1] {
        sl[at] = tl[r];
        for k: 0..<RR_FEATURES { sf[at * RR_FEATURES + k] = tf[r * RR_FEATURES + k]; }
        at += 1;
      }
    }
    sg[n] = at;
    trained[run] = rr_train(RERANK, sf[0..<at * RR_FEATURES], sl[0..<at], sg[0..<n + 1], weights[run * RR_FEATURES..<(run + 1) * RR_FEATURES]);
    if trained[run].status != RrStatus.ok { tool_err("book-search: reranker: "); tool_errln(rr_status_name(trained[run].status)); return Trained.{}; }
  }
  t3 := proc_now_ms();
  return Trained.{ok = true, queries = tq, usable = usable, rows = rows, features_ms = t2 - t1, train_ms = t3 - t2};
}

rerank_eval :: (b: Bs, file: string) -> int {
  P := b.passage_n;
  text: [1048576] u8;
  tn := fs_read(file, text[..]);
  if tn < 0 { tool_errln("book-search: cannot read the query file"); return 2; }
  t0 := proc_now_ms();
  // The HNSW index over the stored passage embeddings.
  ix: [1] HnIndex; hv: [PASSAGES_MAX * BE_WIDTH] f32; hl: [PASSAGES_MAX] int; hu: [PASSAGES_MAX] int;
  hb: [PASSAGES_MAX * 2 * HN_M] int; hp: [PASSAGES_MAX * HN_M] int; hs: [PASSAGES_MAX] int;
  st := hn_init(ix[..], BE_WIDTH, HN_M, HN_EF_BUILD, HN_SEED, hv[0..<P * BE_WIDTH], hl[0..<P], hu[0..<P], hb[0..<P * 2 * HN_M], hp[..], hs[0..<P]);
  if st != HnStatus.ok { tool_err("book-search: hnsw: "); tool_errln(hn_status_name(st)); return 2; }
  built := 0;
  for p: 0..<P {
    r := hn_add(ix[..], b.embeddings[p * BE_WIDTH..<(p + 1) * BE_WIDTH]);
    if r.status != HnStatus.ok { tool_err("book-search: hnsw add: "); tool_errln(hn_status_name(r.status)); return 2; }
    built += r.sims;
  }
  t1 := proc_now_ms();
  unit: [VOCAB_MAX * BE_WIDTH] f64;
  rr_unit(b.table[0..<b.vocab[0].n * BE_WIDTH], BE_WIDTH, unit[0..<b.vocab[0].n * BE_WIDTH]);

  bm: [PASSAGES_MAX] f64; scores: [PASSAGES_MAX] f64; c: [1] Cands; ids: [QUERY_MAX] int; merged: [POOL_MAX] RrCand;
  weights: [RUNS * RR_FEATURES] f64; trained: [RUNS] RrTrained;
  tr0 := train_rerankers(b, ix[..], unit[..], RUNS, weights[..], trained[..]);
  if !tr0.ok { return 2; }
  tq := tr0.queries; usable := tr0.usable; rows := tr0.rows;

  // The held-out queries. Columns of rr: 0 BM25, 1 exhaustive dense, 2 fused
  // (chapter 54), 3 fused over HNSW, 4 reranked, 5.. the floor runs.
  rr: [COLS * EVAL_MAX] f64; nd: [5 * EVAL_MAX] f64; r10: [5 * EVAL_MAX] f64;
  relevant: [PASSAGES_MAX] bool; queries := 0;
  ann: [3] f64; annsims: [3] int; efs := [3] int.[100, 200, 400];
  pool_exact := 0; pool_hnsw := 0; lex_holds := 0; dense_holds := 0; hnsw_holds := 0;
  exact: [1] Cands; f: [POOL_MAX * RR_FEATURES] f64; list: [POOL_MAX] BsHit; pool := 0; rerank_ms := 0;
  lists: [5 * LIST_MAX] BsHit; counts: [5] int;
  at := 0;
  while at < tn {
    end := at; while end < tn && text[end] != '\n' { end += 1; }
    line := cast(string) text[at..<end]; at = end + 1;
    if line.count == 0 || line[0] == '#' { continue; }
    tab := 0; while tab < line.count && line[tab] != '\t' { tab += 1; }
    if tab == line.count || queries == EVAL_MAX { tool_errln("book-search: a query line has no tab, or too many queries"); return 2; }
    total := mark_relevant(b, line[tab + 1..<line.count], relevant[..]);
    if total <= 0 { return 2; }
    n := query_ids(b, line[0..<tab], ids[..]);
    rel := relevant[0..<P]; qi := queries; queries += 1;
    candidates(b, ix[..], 0, ids[0..<n], bm[..], scores[..], exact[..]);
    for i: 0..<exact[0].ln { lists[i] = exact[0].lexical[i]; } counts[0] = exact[0].ln;
    for i: 0..<exact[0].dn { lists[LIST_MAX + i] = exact[0].dense[i]; } counts[1] = exact[0].dn;
    counts[2] = fused(b, exact[..], scores[..], lists[2 * LIST_MAX..<3 * LIST_MAX]);
    if rr_holds(exact[0].lexical[0..<exact[0].ln], rel) { lex_holds += 1; }
    if rr_holds(exact[0].dense[0..<exact[0].dn], rel) { dense_holds += 1; }
    m := rr_merge(exact[0].lexical[0..<exact[0].ln], exact[0].dense[0..<exact[0].dn], merged[..]);
    if rr_pool_holds(merged[0..<m.count], rel) { pool_exact += 1; }
    // Index recall at three budgets, against the exhaustive top 100.
    for k: 0..<3 {
      candidates(b, ix[..], efs[k], ids[0..<n], bm[..], scores[..], c[..]);
      ann[k] += ifx exact[0].dn > 0 then f64(hn_shared(c[0].dense[0..<c[0].dn], exact[0].dense[0..<exact[0].dn])) / f64(exact[0].dn) else 1.0;
      annsims[k] += c[0].sims;
    }
    candidates(b, ix[..], HN_EF, ids[0..<n], bm[..], scores[..], c[..]);
    if rr_holds(c[0].dense[0..<c[0].dn], rel) { hnsw_holds += 1; }
    counts[3] = fused(b, c[..], scores[..], lists[3 * LIST_MAX..<4 * LIST_MAX]);
    m = rr_merge(c[0].lexical[0..<c[0].ln], c[0].dense[0..<c[0].dn], merged[..]);
    if rr_pool_holds(merged[0..<m.count], rel) { pool_hnsw += 1; }
    pool += m.count;
    s0 := proc_now_ms();
    features(b, unit[..], c[..], merged[0..<m.count], bm[..], f[..]);
    for run: 0..<RUNS {
      k := rr_rerank(weights[run * RR_FEATURES..<(run + 1) * RR_FEATURES], f[0..<m.count * RR_FEATURES], merged[0..<m.count], list[..]);
      top := ifx k < 10 then k else 10;
      if run == 0 {
        for i: 0..<top { lists[4 * LIST_MAX + i] = list[i]; } counts[4] = top;
      } else {
        rr[(4 + run) * EVAL_MAX + qi] = bs_reciprocal(bs_first_relevant(list[0..<top], rel), 10);
      }
    }
    rerank_ms += proc_now_ms() - s0;
    for col: 0..<5 {
      top := ifx counts[col] < 10 then counts[col] else 10;
      hits := lists[col * LIST_MAX..<col * LIST_MAX + top];
      rr[col * EVAL_MAX + qi] = bs_reciprocal(bs_first_relevant(hits, rel), 10);
      nd[col * EVAL_MAX + qi] = rr_ndcg(hits, rel, total, 10);
      r10[col * EVAL_MAX + qi] = ifx bs_hit(hits, rel, 10) then 1.0 else 0.0;
    }
  }
  if queries == 0 { tool_errln("book-search: the query file has no queries"); return 2; }
  Q := queries; o1: [32] u8; o2: [32] u8; o3: [32] u8; rb: [40] u8; hx: [64] u8;
  print("% held-out queries over % passages, books at %, weights %\n", Q, P, revision(b, 12, rb[..]), bs_hex(b.digest, 8, hx[..]));
  print("HNSW over the passage embeddings: m %, ef_build %, seed %; built with % similarities in % ms; % bytes in memory\n",
        HN_M, HN_EF_BUILD, HN_SEED, built, t1 - t0, hn_memory(ix[..]));
  print("training: % synthetic queries (% with a relevant and another candidate), % candidate rows, features in % ms; 9 rerankers trained in % ms\n",
        tq, usable, rows, tr0.features_ms, tr0.train_ms);
  tr := trained[0];
  print("reranker (seed %): % queries, % pairs, loss % -> %\n", RERANK_SEED, tr.queries, tr.pairs, fixed(tr.first, 4, o1[..]), fixed(tr.last, 4, o2[..]));
  for k: 0..<RR_FEATURES { print("  weight %: %\n", RR_FEATURE_NAMES[k], fixed(weights[k], 4, o1[..])); }
  print("\nIndex recall\n| Dense source | Recall@100 against exhaustive | Similarities per query |\n| --- | ---: | ---: |\n");
  for k: 0..<3 { print("| HNSW, ef % | % | % |\n", efs[k], pct(ann[k] / f64(Q), o1[..]), fixed(f64(annsims[k]) / f64(Q), 1, o2[..])); }
  print("| Exhaustive | 1.000 | % |\n", P);
  print("queries whose candidates hold a relevant passage (of %): BM25 top 100 %, exhaustive dense top 100 %, HNSW dense top 100 %, merged with exhaustive dense %, merged with HNSW dense %; mean merged pool % candidates\n",
        Q, lex_holds, dense_holds, hnsw_holds, pool_exact, pool_hnsw, fixed(f64(pool) / f64(Q), 1, o1[..]));
  print("\nRelevance\n| Ranking | Recall@10 | MRR@10 | nDCG@10 |\n| --- | ---: | ---: | ---: |\n");
  names := [5] string.["BM25", "Exhaustive vector search", "Fused, exhaustive dense (chapter 54)", "Fused, HNSW dense", "Reranked, HNSW candidates"];
  for col: 0..<5 {
    a := 0.0; mm := 0.0; d := 0.0;
    for i: 0..<Q { a += r10[col * EVAL_MAX + i]; mm += rr[col * EVAL_MAX + i]; d += nd[col * EVAL_MAX + i]; }
    print("| % | % | % | % |\n", names[col], pct(a / f64(Q), o1[..]), pct(mm / f64(Q), o2[..]), pct(d / f64(Q), o3[..]));
  }
  print("reranking: % ms per query for the features and nine rerankings (one core)\n", fixed(f64(rerank_ms) / f64(Q), 2, o1[..]));
  // Chapter 240's floor from the eight floor runs, chapter 241's verdicts.
  runs: [FLOOR_RUNS * EVAL_MAX] f64; task: [EVAL_MAX] int; part: [EVAL_MAX] int;
  for r: 0..<FLOOR_RUNS { for i: 0..<Q { runs[r * Q + i] = rr[(5 + r) * EVAL_MAX + i]; } }
  for i: 0..<Q { task[i] = i; part[i] = 0; }
  fl := ns_floor(runs[0..<FLOOR_RUNS * Q], part[0..<Q], 0, FLOOR_RUNS, 1);
  print("\nfloor over % reranker runs: MRR@10 run means", FLOOR_RUNS);
  for r: 0..<FLOOR_RUNS { print(" %", fixed(fl.mean[r], 3, o1[..])); }
  print("; sd %, floor %\n", fixed(fl.sd, 4, o1[..]), fixed(fl.floor, 4, o2[..]));
  base := [2] int.[3, 2]; what := [2] string.["reranked against fused on the same HNSW candidates", "reranked against chapter 54's fused retriever"];
  for k: 0..<2 {
    d := vd_decision(rr[base[k] * EVAL_MAX..<base[k] * EVAL_MAX + Q], rr[4 * EVAL_MAX..<4 * EVAL_MAX + Q], task[0..<Q], part[0..<Q], 0, fl, 1, 56, 1000);
    print("%: MRR@10 gain %, % of 1000 replicates at or under the floor; verdict %, %\n", what[k], fixed(d.gain.gain, 4, o1[..]), d.gain.below,
          verdict_name(d.result.verdict), reason_name(d.result.reason));
  }
  return 0;
}
// ---- chapter 57: answers that cite the current sources -----------------------------
// The query file's label "-" marks a question no passage should answer.
// Answers come from the index (held); every citation is then checked against
// the books as read from disk now (now), byte for byte.
ID_POOL :: 4194304;
answer_eval :: (b: Bs, now: Bs, file: string) -> int {
  P := b.passage_n;
  text: [1048576] u8;
  tn := fs_read(file, text[..]);
  if tn < 0 { tool_errln("book-search: cannot read the query file"); return 2; }
  ix: [1] HnIndex; hv: [PASSAGES_MAX * BE_WIDTH] f32; hl: [PASSAGES_MAX] int; hu: [PASSAGES_MAX] int;
  hb: [PASSAGES_MAX * 2 * HN_M] int; hp: [PASSAGES_MAX * HN_M] int; hs: [PASSAGES_MAX] int;
  st := hn_init(ix[..], BE_WIDTH, HN_M, HN_EF_BUILD, HN_SEED, hv[0..<P * BE_WIDTH], hl[0..<P], hu[0..<P], hb[0..<P * 2 * HN_M], hp[..], hs[0..<P]);
  if st != HnStatus.ok { tool_err("book-search: hnsw: "); tool_errln(hn_status_name(st)); return 2; }
  for p: 0..<P {
    r := hn_add(ix[..], b.embeddings[p * BE_WIDTH..<(p + 1) * BE_WIDTH]);
    if r.status != HnStatus.ok { tool_err("book-search: hnsw add: "); tool_errln(hn_status_name(r.status)); return 2; }
  }
  unit: [VOCAB_MAX * BE_WIDTH] f64;
  rr_unit(b.table[0..<b.vocab[0].n * BE_WIDTH], BE_WIDTH, unit[0..<b.vocab[0].n * BE_WIDTH]);
  weights: [RR_FEATURES] f64; trained: [1] RrTrained;
  tr := train_rerankers(b, ix[..], unit[..], 1, weights[..], trained[..]);
  if !tr.ok { return 2; }

  // The books on disk now: every passage's identity, heading path and text.
  idpool: [ID_POOL] u8; used := 0;
  nid: [PASSAGES_MAX] string; nhead: [PASSAGES_MAX] string; ntext: [PASSAGES_MAX] string;
  for p: 0..<now.passage_n {
    q := now.passages[p];
    nid[p] = an_id(file_path(now, q.file), heads_of(now, p), q.part, idpool[used..<ID_POOL]);
    if nid[p].count == 0 { tool_errln("book-search: passage identities do not fit"); return 2; }
    used += nid[p].count;
    nhead[p] = heads_of(now, p); ntext[p] = cast(string) now.text[q.from..<q.to];
  }

  bm: [PASSAGES_MAX] f64; scores: [PASSAGES_MAX] f64; c: [1] Cands; ids: [QUERY_MAX] int;
  merged: [POOL_MAX] RrCand; f: [POOL_MAX * RR_FEATURES] f64; list: [POOL_MAX] BsHit; relevant: [PASSAGES_MAX] bool;
  queries := 0; labelled := 0; answered := 0; abstained := 0; current := 0; precise := 0; precise_abstain := 0;
  top1 := 0; top3 := 0; mrr := 0.0; unlabelled_abstained := 0; spent := 0;
  o1: [32] u8; o2: [32] u8; o3: [32] u8; hx: [64] u8; ib: [256] u8;
  print("| Question | Verdict | Support | Cited passage | Labelled relevant | Citation now |\n| --- | --- | ---: | --- | --- | --- |\n");
  at := 0;
  while at < tn {
    end := at; while end < tn && text[end] != '\n' { end += 1; }
    line := cast(string) text[at..<end]; at = end + 1;
    if line.count == 0 || line[0] == '#' { continue; }
    tab := 0; while tab < line.count && line[tab] != '\t' { tab += 1; }
    if tab == line.count { tool_errln("book-search: a query line has no tab"); return 2; }
    question := line[0..<tab]; label := line[tab + 1..<line.count];
    has := label != "-";
    if has { if mark_relevant(b, label, relevant[..]) <= 0 { return 2; } labelled += 1; }
    else { for p: 0..<P { relevant[p] = false; } }
    queries += 1;
    s0 := proc_now_ms();
    // Retrieve and rerank (chapter 56).
    n := query_ids(b, question, ids[..]);
    candidates(b, ix[..], HN_EF, ids[0..<n], bm[..], scores[..], c[..]);
    m := rr_merge(c[0].lexical[0..<c[0].ln], c[0].dense[0..<c[0].dn], merged[..]);
    if m.status != RrStatus.ok { tool_errln("book-search: merge refused"); return 2; }
    features(b, unit[..], c[..], merged[0..<m.count], bm[..], f[..]);
    k := rr_rerank(weights[..], f[0..<m.count * RR_FEATURES], merged[0..<m.count], list[..]);
    // Answer from the top AN_TOP, weighting each query word by BM25's IDF.
    pool: [1024] u8; words: [64] string; weight: [64] f64;
    w := an_query_words(question, pool[..], words[..]);
    if w < 0 { tool_errln("book-search: a question has too many words"); return 2; }
    for i: 0..<w { id := bs_find(b.vocab[0], words[i]); weight[i] = bs_idf(P, ifx id >= 0 then b.df[id] else 0); }
    top := ifx k < AN_TOP then k else AN_TOP;
    found: [AN_TOP] string;
    for i: 0..<top { q := b.passages[list[i].passage]; found[i] = cast(string) b.text[q.from..<q.to]; }
    a := an_answer(words[0..<w], weight[0..<w], found[0..<top], AN_SUPPORT_MIN);
    spent += proc_now_ms() - s0;
    if has {
      first := bs_first_relevant(list[0..<ifx k < 10 then k else 10], relevant[0..<P]);
      if first == 1 { top1 += 1; }
      if first >= 1 && first <= AN_TOP { top3 += 1; }
      mrr += bs_reciprocal(first, 10);
    }
    cited := "-"; rel := "-"; check := "-";
    if a.rank >= 0 {
      p := list[a.rank].passage; q := b.passages[p];
      cited = heads_of(b, p);
      rel = ifx !has then "no label" else ifx relevant[p] then "yes" else "no";
      if a.verdict == AnVerdict.answer {
        answered += 1;
        idb: [4096] u8;
        cite := AnCite.{id = an_id(file_path(b, q.file), heads_of(b, p), q.part, idb[..]), from = a.from, to = a.to, digest = an_digest(heads_of(b, p), found[a.rank])};
        ck := an_check(cite, found[a.rank][a.from..<a.to], nid[0..<now.passage_n], nhead[0..<now.passage_n], ntext[0..<now.passage_n]);
        check = an_check_name(ck);
        if an_serve(ck) { current += 1; }
        if has && relevant[p] { precise += 1; }
      } else {
        if has && relevant[p] { precise_abstain += 1; }
      }
    }
    if a.verdict == AnVerdict.abstain { abstained += 1; if !has { unlabelled_abstained += 1; } }
    print("| % | % | % | % | % | % |\n", question, an_verdict_name(a.verdict), fixed(ifx a.support < 0 then 0.0 else a.support, 3, o1[..]), cited, rel, check);
  }
  if queries == 0 { tool_errln("book-search: the query file has no queries"); return 2; }
  rb: [40] u8;
  print("\n% questions (% labelled, % marked unanswerable) over % passages, books at %, weights %\n", queries, labelled, queries - labelled, P, revision(b, 12, rb[..]), bs_hex(b.digest, 8, hx[..]));
  print("reranker (seed %): % training queries, loss % -> %; support floor %, top %\n", RERANK_SEED, tr.queries, fixed(trained[0].first, 4, o1[..]), fixed(trained[0].last, 4, o2[..]), fixed(AN_SUPPORT_MIN, 2, o3[..]), AN_TOP);
  if labelled > 0 {
    L := f64(labelled);
    print("retrieval, reranked (labelled questions): recall@1 %, recall@% %, MRR@10 %\n", pct(f64(top1) / L, o1[..]), AN_TOP, pct(f64(top3) / L, o2[..]), pct(mrr / L, o3[..]));
  }
  print("answered %, abstained % of %\n", answered, abstained, queries);
  print("citations current against the books on disk: % of % answers\n", current, answered);
  if labelled > 0 {
    print("citation precision (the cited passage is labelled relevant): % of % answers", precise, answered);
    if answered > 0 { print(" = %", pct(f64(precise) / f64(answered), o1[..])); }
    print("\nabstained on labelled questions: %; of those, % had a labelled passage as the closest span\n", abstained - unlabelled_abstained, precise_abstain);
  }
  if queries > labelled { print("abstained on unanswerable questions: % of %\n", unlabelled_abstained, queries - labelled); }
  print("answering: % ms per question for retrieval, reranking and the answer (one core)\n", fixed(f64(spent) / f64(queries), 2, o1[..]));
  return 0;
}
verdict_name :: (v: VdVerdict) -> string { if v == VdVerdict.passed { return "passed"; } if v == VdVerdict.failed { return "failed"; } return "unverifiable"; }
reason_name :: (r: VdReason) -> string {
  if r == VdReason.beyond_floor { return "beyond the floor"; }
  if r == VdReason.within_floor { return "within the floor"; }
  if r == VdReason.near_floor { return "near the floor"; }
  if r == VdReason.no_headroom { return "no headroom"; }
  if r == VdReason.no_floor { return "no floor"; }
  if r == VdReason.few_tasks { return "too few queries"; }
  return "other";
}

// ---- chapter 59: the browser bundle ---------------------------------------------------
// A store over a Bs (files copied into flat arrays; everything else shared).
BundleFiles :: struct { path_from: [FILES_MAX] int; path_to: [FILES_MAX] int; hashes: [FILES_MAX * 32] u8; status: [FILES_MAX] int; book: [FILES_MAX] int; length: [PASSAGES_MAX] int; }
bundle_store :: (b: Bs, f: [] BundleFiles) -> BbStore {
  for i: 0..<b.file_n {
    x := b.files[i];
    f[0].path_from[i] = x.path_from; f[0].path_to[i] = x.path_to; f[0].status[i] = cast(int) x.status; f[0].book[i] = x.book;
    for k: 0..<32 { f[0].hashes[32 * i + k] = x.hash[k]; }
  }
  for p: 0..<b.passage_n { f[0].length[p] = b.bt[p] - b.hf[p]; }
  return BbStore.{table = b.table, query = b.query, vocab = b.vocab, words = b.vocab[0].n, names = b.names, path_from = f[0].path_from[..], path_to = f[0].path_to[..],
    hashes = f[0].hashes[..], status = f[0].status[..], book = f[0].book[..], file_n = b.file_n, heads = b.heads, heads_n = b.heads_n, passages = b.passages,
    length = f[0].length[..], tf = b.tf, tt = b.tt, passage_n = b.passage_n, df = b.df, average = b.average, terms = b.terms, counts = b.counts,
    terms_n = ifx b.passage_n > 0 then b.tt[b.passage_n - 1] else 0, embeddings = b.embeddings};
}
// Writes DIR/encoder.bin (the weights file, byte for byte), DIR/index.bin,
// DIR/manifest.txt (the corpus digest of the books as they are now) and,
// with a query file, DIR/reference.txt: one native result line per query.
write_bundle :: (held: Bs, now: Bs, wpath: string, dir: string, queries: string) -> int {
  if !fs_mkdir(dir) { tool_errln("book-search: cannot make the bundle directory"); return 2; }
  enc: [OUT_MAX] u8; idx: [OUT_MAX] u8; man: [4096] u8; pb: [4096] u8;
  en := fs_read(wpath, enc[..]);
  if en < 0 { tool_errln("book-search: cannot read the weights"); return 2; }
  m := BbManifest.{ok = true, profile = BB_PROFILE, encoder = bs_file_hash(enc[..], 0, en), encoder_bytes = en};
  hf: [1] BundleFiles; nf: [1] BundleFiles;
  s := bundle_store(held, hf[..]);
  m.corpus = bb_corpus(bundle_store(now, nf[..]));
  wi := [1] BbW.[BbW.{buf = idx[..]}];
  bb_write_index(wi[..], s, m.encoder);
  m.index = bs_file_hash(idx[..], 0, wi[0].n); m.index_bytes = wi[0].n;
  wm := [1] BbW.[BbW.{buf = man[..]}];
  bb_write_manifest(wm[..], m);
  if wi[0].full || wm[0].full || !fs_write(fs_join(dir, "encoder.bin", pb[..]), cast(string) enc[0..<en]) || !fs_write(fs_join(dir, "index.bin", pb[..]), cast(string) idx[0..<wi[0].n])
     || !fs_write(fs_join(dir, "manifest.txt", pb[..]), cast(string) man[0..<wm[0].n]) { tool_errln("book-search: cannot write the bundle"); return 2; }
  ib: [32] u8;
  print_err3("book-search: bundle encoder.bin bytes ", itoa(en, ib[..]), "");
  print_err3("book-search: bundle index.bin bytes ", itoa(wi[0].n, ib[..]), "");
  if queries.count == 0 { return 0; }
  text: [1048576] u8;
  n := fs_read(queries, text[..]);
  if n < 0 { tool_errln("book-search: cannot read the query file"); return 2; }
  out: [4194304] u8; wo := [1] BbW.[BbW.{buf = out[..]}];
  scores: [PASSAGES_MAX] f64; r: [1] Search; count := 0; at := 0;
  while at < n {
    end := at; while end < n && text[end] != '\n' { end += 1; }
    line := cast(string) text[at..<end]; at = end + 1;
    if line.count == 0 || line[0] == '#' { continue; }
    tab := 0; while tab < line.count && line[tab] != '\t' { tab += 1; }
    search(held, line[0..<tab], -1, scores[..], r[..]);
    bb_line(wo[..], r[0].e[..], r[0].words, r[0].known, r[0].lexical[0..<r[0].ln], r[0].dense[0..<r[0].dn], r[0].fused[0..<r[0].fn]);
    count += 1;
  }
  if wo[0].full || !fs_write(fs_join(dir, "reference.txt", pb[..]), cast(string) out[0..<wo[0].n]) { tool_errln("book-search: cannot write the reference"); return 2; }
  print_err3("book-search: native reference lines ", itoa(count, ib[..]), "");
  return 0;
}

// ---- main ------------------------------------------------------------------------
tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("book-search: arguments too long"); return 2; }
  query := ""; i := 0;
  while i < args_count(a[..]) {
    x := args_at(a[..], i);
    if x == "--k" || x == "--book" || x == "--mode" || x == "--eval" || x == "--rerank-eval" || x == "--answer-eval" || x == "--bundle" || x == "--reference" { i += 2; continue; }
    if x.count > 1 && x[0] == '-' && x[1] == '-' { i += 1; continue; }
    query = x; i += 1;
  }
  eval := args_value(a[..], "--eval", "");
  reval := args_value(a[..], "--rerank-eval", "");
  aeval := args_value(a[..], "--answer-eval", "");
  json := args_has(a[..], "--json");
  bundle := args_value(a[..], "--bundle", "");
  if query.count == 0 && bundle.count == 0 && eval.count == 0 && reval.count == 0 && aeval.count == 0 && !args_has(a[..], "--rebuild") && !args_has(a[..], "--train") {
    tool_errln("usage: coax/web/tool.sh psionic/tools/book-search.coax \"QUERY\" [--k N] [--book coax|psionic|aethyr] [--mode fused|bm25|dense] [--json] [--no-build]");
    tool_errln("       coax/web/tool.sh psionic/tools/book-search.coax --eval FILE [--json] [--verbose] | --rebuild | --train");
    return 2;
  }
  kn := args_number(args_value(a[..], "--k", "5"));
  k := ifx kn.ok && kn.value >= 1 && kn.value <= LIST_MAX then cast(int) kn.value else 5;
  bookname := args_value(a[..], "--book", "");
  book := -1;
  if bookname == "coax" { book = 0; } else if bookname == "psionic" { book = 1; } else if bookname == "aethyr" { book = 2; }
  else if bookname.count > 0 { tool_errln("book-search: --book is coax, psionic or aethyr"); return 2; }
  modename := args_value(a[..], "--mode", "fused");
  mode := 2;
  if modename == "bm25" { mode = 0; } else if modename == "dense" { mode = 1; } else if modename != "fused" { tool_errln("book-search: --mode is fused, bm25 or dense"); return 2; }

  rootbuf: [4096] u8; err: [4096] u8;
  top := [4] string.["git", "rev-parse", "--show-toplevel", ""];
  pr := proc_run(top[0..<3], 30000, rootbuf[..], err[..]);
  if pr.started != 0 || pr.status != 0 { tool_errln("book-search: run inside the openagents repository"); return 2; }
  root := cast(string) rootbuf[0..<pr.out_n];
  dirbuf: [4096] u8; wbuf: [4096] u8; ibuf: [4096] u8;
  dir := fs_join(root, "coax/web/build/book-search", dirbuf[..]);
  if !fs_mkdir(dir) { tool_errln("book-search: cannot make coax/web/build/book-search"); return 2; }
  wpath := fs_join(dir, "weights.bin", wbuf[..]); ipath := fs_join(dir, "index.bin", ibuf[..]);

  // The books as they are now.
  text: [TEXT_MAX] u8; heads: [HEADS_MAX] u8; names: [NAMES_MAX] u8; files: [FILES_MAX] BsFile; passages: [PASSAGES_MAX] BsPassage;
  ids: [IDS_MAX] int; hf: [PASSAGES_MAX] int; ht: [PASSAGES_MAX] int; bf: [PASSAGES_MAX] int; bt: [PASSAGES_MAX] int;
  terms: [IDS_MAX] int; counts: [IDS_MAX] int; tf: [PASSAGES_MAX] int; tt: [PASSAGES_MAX] int; df: [VOCAB_MAX] int;
  slots: [4 * VOCAB_MAX] int; vpool: [1048576] u8; vfrom: [VOCAB_MAX] int; vsize: [VOCAB_MAX] int; vcount: [VOCAB_MAX] int;
  vocab := [1] BsVocab.[BsVocab.{slots = slots[..], pool = vpool[..], from = vfrom[..], size = vsize[..], count = vcount[..]}];
  table: [VOCAB_MAX * BE_WIDTH] f64; qv: [BE_WIDTH] f64; embeddings: [PASSAGES_MAX * BE_WIDTH] f32;
  now := [1] Bs.[Bs.{text = text[..], heads = heads[..], names = names[..], files = files[..], passages = passages[..], ids = ids[..], hf = hf[..], ht = ht[..], bf = bf[..], bt = bt[..],
                     terms = terms[..], counts = counts[..], tf = tf[..], tt = tt[..], df = df[..], vocab = vocab[..], table = table[..], query = qv[..], embeddings = embeddings[..]}];
  if !read_books(now[..], root) || !revisions(now[..], root) || !chunk_books(now[..]) { return 2; }

  // The weights: trained once, kept until --train.
  if args_has(a[..], "--train") || !load_weights(now[..], wpath) {
    if !train(now[..], root, wpath) { return 2; }
  }
  // The index: the stored passages, their text and embeddings.
  text2: [TEXT_MAX] u8; heads2: [HEADS_MAX] u8; names2: [NAMES_MAX] u8; files2: [FILES_MAX] BsFile; passages2: [PASSAGES_MAX] BsPassage;
  held := [1] Bs.[now[0]];
  held[0].text = text2[..]; held[0].heads = heads2[..]; held[0].names = names2[..]; held[0].files = files2[..]; held[0].passages = passages2[..];
  loaded := ifx args_has(a[..], "--rebuild") || args_has(a[..], "--train") then -1 else load_index(held[..], ipath, now[0].digest);
  fresh := loaded == 0 && freshness(held[0], now[0], false).fresh;
  if loaded == -2 { tool_errln("book-search: the index was built with other weights"); }
  if !fresh {
    if args_has(a[..], "--no-build") {
      if loaded == -1 { tool_errln("book-search: no index; run without --no-build to build one"); }
      tool_errln("book-search: refusing to answer from a stale index (--no-build); run without --no-build to rebuild it");
      return 3;
    }
    if !build_index(now[..], ipath) { return 2; }
    loaded = load_index(held[..], ipath, now[0].digest);
    if loaded != 0 { tool_errln("book-search: the rebuilt index does not read back"); return 2; }
    ib: [32] u8;
    tool_err("book-search: built the index at revision "); tool_err(cast(string) held[0].revision[0..<12]); print_err3(", passages: ", itoa(held[0].passage_n, ib[..]), "");
  }
  for f: 0..<held[0].file_n { held[0].files[f].rev = now[0].files[f].rev; held[0].files[f].edited = now[0].files[f].edited; }
  if reval.count > 0 { return rerank_eval(held[0], reval); }
  if aeval.count > 0 { return answer_eval(held[0], now[0], aeval); }
  if eval.count > 0 { return evaluate(held[0], eval, json, args_has(a[..], "--verbose")); }
  if bundle.count > 0 { return write_bundle(held[0], now[0], wpath, bundle, args_value(a[..], "--reference", "")); }
  if query.count == 0 { return 0; }

  scores: [PASSAGES_MAX] f64; r: [1] Search;
  search(held[0], query, book, scores[..], r[..]);
  hits := mode_hits(r[..], mode);
  shown := ifx hits.count < k then hits.count else k;
  if json {
    buf: [4194304] u8; j := [1] Jo.[Jo.{buf = buf[..]}]; hx: [64] u8;
    jo_obj(j[..]);
    jo_key(j[..], "query"); jo_str(j[..], query);
    jo_key(j[..], "mode"); jo_str(j[..], MODES[mode]);
    jo_key(j[..], "index_revision"); jo_str(j[..], cast(string) held[0].revision[..]);
    jo_key(j[..], "weights"); jo_str(j[..], bs_hex(held[0].digest, 32, hx[..]));
    jo_key(j[..], "words"); jo_int(j[..], r[0].words); jo_key(j[..], "known_words"); jo_int(j[..], r[0].known);
    jo_key(j[..], "results"); jo_arr(j[..]);
    for x: 0..<shown { json_result(held[0], j[..], x + 1, hits[x]); }
    jo_end(j[..]); jo_end(j[..]);
    print("%\n", jo_text(j[..]));
    return 0;
  }
  print("% results for \"%\" (%; % of % words known; books at %)\n\n", shown, query, MODES[mode], r[0].known, r[0].words, cast(string) held[0].revision[0..<12]);
  for x: 0..<shown { print_result(held[0], x + 1, hits[x]); }
  return 0;
}
