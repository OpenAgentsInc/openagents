// Chapter 254 gate: serial low-priority caller; one mutation worker.
// Run separate phases to bound every command below fifteen minutes.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";
ccn_run :: (args:[]string,seconds:int,out:[]u8)->int {
    err:[65536]u8;r:=proc_run(args,seconds*1000,out,err[..]);
    if r.status!=0 || r.timed_out || r.cut {tool_errln(cast(string)err[0..<r.err_n]);tool_errln(cast(string)out[0..<r.out_n]);return -1;}
    return r.out_n;
}
// proc_run joins stdout lines without the final newline. Saved transcripts
// are newline-terminated; compare every captured byte under that API contract.
ccn_transcript :: (out:[]u8,n:int,expected:[]u8,k:int)->bool {
    return n>=0 && k==n+1 && expected[k-1]=='\n' && cast(string)out[0..<n]==cast(string)expected[0..<k-1];
}
ccn_native :: ()->int {
    path:[1024]u8;dir:=fs_temp("construction-native-",path[..]);#assert dir.count>0;
    cb:[1024]u8;exe:[1024]u8;cpath:=fs_join(dir,"check.c",cb[..]);binary:=fs_join(dir,"check",exe[..]);out:[16777216]u8;
    for mode:0..<2 {
        args:=[5]string.["coax/bin/coax","c","psionic/tests/construction-native.coax","--library","--release"];
        n:=ccn_run(args[0..<4+mode],120,out[..]);if n<0 {return 1;}
        #assert fs_write(cpath,cast(string)out[0..<n]);#assert fs_append(cpath,"\nint main(void) { return (int)construction_native_checks(); }\n");
        for sanitized:0..<2 {
            flags:=[12]string.["cc","-std=c11",ifx mode==0 then "-O0" else "-O2","-ffp-contract=off","-fno-fast-math",cpath,"-lm","-o",binary,"-g","-fsanitize=address,undefined","-fno-omit-frame-pointer"];
            if ccn_run(flags[0..<10+sanitized*2],120,out[..])<0 {return 1;}
            run:=[1]string.[binary];if ccn_run(run[..],60,out[..])<0 {return 1;}print("native: mode %, sanitizers %: passed\n",mode,sanitized);
        }
    }#assert fs_remove(dir);return 0;
}
tool_main :: ()->int #export_c {
    a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {tool_errln("usage: check-construction all|checks|mutate|native|book");return 2;}
    phase:=args_at(a[..],0);out:[16777216]u8;
    if phase=="all" {start:=proc_now_ms();for part:[4]string.["checks","mutate","native","book"] {
        left:=840-(proc_now_ms()-start)/1000;if left<=0 {tool_errln("gate budget exhausted; run separate phases");return 1;}
        cmd:=[3]string.["coax/web/tool.sh","psionic/tools/check-construction.coax",part];n:=ccn_run(cmd[..],left,out[..]);if n<0 {return 1;}print("%",cast(string)out[0..<n]);
    }return 0;}
    if phase=="native" {return ccn_native();}
    if phase=="checks" {for source:[3]string.["psionic/lib/construct.coax","psionic/lib/construct-program.coax","psionic/lib/construction-learn.coax"] {
        for mode:0..<2 {cmd:=[4]string.["coax/bin/coax","test",source,"--release"];if ccn_run(cmd[0..<3+mode],600,out[..])<0 {return 1;}print("checks: %, release %: passed\n",source,mode);}
    }return 0;}
    if phase=="mutate" {for source:[2]string.["psionic/lib/construct.coax","psionic/lib/construct-program.coax"] {
        cmd:=[7]string.["coax/bin/coax","mutate",source,"--root-only","--jobs","1","--mutation-stats"];n:=ccn_run(cmd[..],600,out[..]);if n<0 {return 1;}print("%",cast(string)out[0..<n]);
    }return 0;}
    if phase=="book" {
        oracle:=[3]string.["python3","-I","psionic/tests/construction_oracle.py"];n:=ccn_run(oracle[..],120,out[..]);if n<0 {return 1;}print("%",cast(string)out[0..<n]);
        for task:0..<4 {digits:=[4]string.["0","1","2","3"];replay:=[4]string.["coax/web/tool.sh","psionic/tools/construction-run.coax","replay",digits[task]];
            n=ccn_run(replay[..],120,out[..]);if n<0 {return 1;}path:[1024]u8;name:=fs_join("psionic/fixtures/construction",ifx task==0 then "llm-0.csv" else ifx task==1 then "llm-1.csv" else ifx task==2 then "llm-2.csv" else "llm-3.csv",path[..]);expected:[65536]u8;k:=fs_read(name,expected[..]);
            if !ccn_transcript(out[..],n,expected[..],k) {tool_errln("proposal replay drift");return 1;}
        }
        expected:[65536]u8;k:=fs_read("psionic/fixtures/construction/example.out",expected[..]);#assert k>0;
        for mode:0..<2 {cmd:=[4]string.["coax/bin/coax","run","psionic/examples/construct-network.coax","--release"];n=ccn_run(cmd[0..<3+mode],180,out[..]);
            if !ccn_transcript(out[..],n,expected[..],k) {tool_errln("example transcript drift");return 1;}
        }
        book:=[3]string.["python3","-I","psionic/tests/book.py"];if ccn_run(book[..],120,out[..])<0 {return 1;}
        print("book: oracle, four offline replays, exact debug/release example, inventory and links: passed\n");return 0;
    }tool_errln("unknown phase");return 2;
}
