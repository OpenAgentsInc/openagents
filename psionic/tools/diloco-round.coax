// End-to-End Decentralized Local-SGD/DiLoCo Training, 6-Tier Byzantine
// Verification, Three-Checkpoint Quarantine Optimizer & Atomic Rollback Runner
// (Executor W5.1 #13923, W5.2 #13925, W5.3 #13927).
// tool.sh: release
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/crypto/sha256.coax";
#load "../../coax/lib/encoding/json.coax";
#load "../lib/peer/training-window.coax";
#load "../lib/peer/train-verify.coax";
#load "../lib/peer/quarantine-opt.coax";
#load "../lib/wasm-exec.coax";
#load "../lib/hybrid-exec-policy.coax";

DL_DIM :: 8;
DL_SHARD_SAMPLES :: 16;
DL_HELDOUT_SAMPLES :: 16;

// Deterministic cross-platform exp(x) for |x| <= 10 using range reduction (2^k).
dl_exp :: (x: f64) -> f64 {
  v := x;
  if v > 10.0 { v = 10.0; }
  if v < -10.0 { v = -10.0; }
  // Scale by 1/16, compute 8-term Taylor, then square 4 times
  s := v / 16.0;
  term := 1.0;
  acc := 1.0;
  for k: 1..<9 {
    term = term * s / f64(k);
    acc += term;
  }
  acc = acc * acc;
  acc = acc * acc;
  acc = acc * acc;
  acc = acc * acc;
  return acc;
}

// Deterministic ln(x) for x in (1e-6, 1.0] via 24-step Newton on exp(y) = x.
dl_ln :: (x: f64) -> f64 {
  v := ifx x < 0.000001 then 0.000001 else x;
  y := -1.0;
  for _: 0..<24 {
    ey := dl_exp(y);
    y = y + (v - ey) / ey;
  }
  return y;
}

dl_sigmoid :: (z: f64) -> f64 {
  if z >= 0.0 {
    e := dl_exp(-z);
    return 1.0 / (1.0 + e);
  }
  e := dl_exp(z);
  return e / (1.0 + e);
}

dl_hex_ch :: (v: int) -> u8 { return ifx v < 10 then cast(u8) ('0' + v) else cast(u8) ('a' + (v - 10)); }
dl_hex32 :: (d: [32] u8, out: [] u8) -> string {
  for i: 0..<32 { b := cast(int) d[i]; out[2 * i] = dl_hex_ch(b >> 4); out[2 * i + 1] = dl_hex_ch(b & 15); }
  return cast(string) out[0..<64];
}

// Serialize DL_DIM f64 weights deterministically to bytes and return SHA-256 + non-zero 31-bit id.
dl_hash_weights :: (w: [] f64, out_bytes: [] u8, out_sha: [] u8) -> int {
  n := 0;
  for i: 0..<DL_DIM {
    // Fixed-point micro-unit serialization (1e6) for exact cross-platform canonical bytes
    q := cast(int) (w[i] * 1000000.0);
    for b: 0..<8 {
      out_bytes[n] = cast(u8) ((q >> (b * 8)) & 255);
      n += 1;
    }
  }
  #assert sha256_hash_checked(out_bytes[0..<n], out_sha, false) == SHA_OK;
  id := (cast(int) out_sha[0] << 24) | (cast(int) out_sha[1] << 16) | (cast(int) out_sha[2] << 8) | cast(int) out_sha[3];
  if id < 0 { id = -id; }
  return ifx id == 0 then 1 else id;
}

// Deterministic synthetic-free routing feature generator (ground truth teacher w_star).
dl_sample :: (seed: int, x: [] f64) -> f64 {
  s := seed * 1103515245 + 12345;
  dot := 0.0;
  w_star := [DL_DIM] f64.[1.6, -1.2, 0.9, 1.4, -0.8, 1.1, -1.5, 0.7];
  for j: 0..<DL_DIM {
    s = (s * 1103515245 + 12345) & 2147483647;
    v := (f64(s % 2001) - 1000.0) / 1000.0;
    x[j] = v;
    dot += w_star[j] * v;
  }
  return ifx dot >= 0.0 then 1.0 else 0.0;
}

// Evaluate binary cross-entropy log-loss (in milli-nats) and accuracy (in bps) on a sample range.
DlEval :: struct {
  logloss_milli: int;
  pass_bps: int;
  conferr_bps: int;
}

dl_eval :: (w: [] f64, seed_base: int, count: int) -> DlEval {
  loss_sum := 0.0;
  correct := 0;
  conferr := 0;
  x: [DL_DIM] f64;
  for i: 0..<count {
    y := dl_sample(seed_base + i, x[..]);
    z := 0.0;
    for j: 0..<DL_DIM { z += w[j] * x[j]; }
    p := dl_sigmoid(z);
    if y > 0.5 {
      loss_sum += -dl_ln(p);
      if p >= 0.5 { correct += 1; } else if p < 0.2 { conferr += 1; }
    } else {
      loss_sum += -dl_ln(1.0 - p);
      if p < 0.5 { correct += 1; } else if p > 0.8 { conferr += 1; }
    }
  }
  return DlEval.{
    logloss_milli = cast(int) ((loss_sum / f64(count)) * 1000.0),
    pass_bps = (correct * 10000) / count,
    conferr_bps = (conferr * 10000) / count,
  };
}

// Run H local SGD inner steps on shard `seed_base..seed_base+count` and output pseudo-gradient delta = theta_H - theta_0.
dl_local_sgd :: (w0: [] f64, seed_base: int, count: int, steps: int, lr: f64, delta_out: [] f64) {
  w: [DL_DIM] f64;
  for j: 0..<DL_DIM { w[j] = w0[j]; }
  x: [DL_DIM] f64;
  for _: 0..<steps {
    g: [DL_DIM] f64;
    for i: 0..<count {
      y := dl_sample(seed_base + i, x[..]);
      z := 0.0;
      for j: 0..<DL_DIM { z += w[j] * x[j]; }
      err := dl_sigmoid(z) - y;
      for j: 0..<DL_DIM { g[j] += err * x[j]; }
    }
    inv := lr / f64(count);
    for j: 0..<DL_DIM { w[j] -= inv * g[j]; }
  }
  for j: 0..<DL_DIM { delta_out[j] = w[j] - w0[j]; }
}

tool_main :: () -> int #export_c #effects(all) {
  out_dir := "/tmp/oa-diloco-e2e";
  args: [1] Args;
  if args_load(args[..]) {
    out_dir = args_value(args[..], "--dir", "/tmp/oa-diloco-e2e");
  }
  _ = fs_mkdir_all(out_dir);

  // 1. Initialize canonical checkpoint v1 (all zeros) and persist with SHA-256
  w0: [DL_DIM] f64;
  w0_bytes: [DL_DIM * 8] u8;
  w0_sha: [32] u8;
  w0_id := dl_hash_weights(w0[..], w0_bytes[..], w0_sha[..]);
  hex0: [64] u8;
  p_can: [512] u8; p_bak: [512] u8; p_quar: [512] u8; p_lin: [512] u8;
  can_path := fs_join(out_dir, "canonical.bin", p_can[..]);
  bak_path := fs_join(out_dir, "canonical_v1.bin", p_bak[..]);
  quar_path := fs_join(out_dir, "quarantine.bin", p_quar[..]);
  lin_path := fs_join(out_dir, "lineage.json", p_lin[..]);
  #assert fs_replace_durable(can_path, cast(string) w0_bytes[..]);
  #assert fs_replace_durable(bak_path, cast(string) w0_bytes[..]);

  base_eval := dl_eval(w0[..], 9000, DL_HELDOUT_SAMPLES);
  print("W5_INIT canonical_v1_sha256=% heldout_pass_bps=% heldout_logloss_milli=%\n",
        dl_hex32(w0_sha, hex0[..]), base_eval.pass_bps, base_eval.logloss_milli);

  // 2. W5.1: Admit 4 disjoint non-held-out shards, issue 4 leases, run Local-SGD on 4 Pylons
  pool: [1] TwPool;
  deltas: [4][DL_DIM] f64;
  for wi: 0..<4 {
    st_s := tw_admit_shard(16, 16, 0, true, 0);
    if st_s != TwStatus.ok { print("W51_FAIL shard admit\n"); return 1; }
    st_l := tw_issue_lease(pool[..], 200 + wi, 1000 + wi, w0_id, 100 + wi, 30, 4096, 100, 500);
    if st_l != TwStatus.ok { print("W51_FAIL lease issue\n"); return 1; }
    dl_local_sgd(w0[..], 100 + wi * 100, DL_SHARD_SAMPLES, 30, 0.8, deltas[wi][..]);
    st_c := tw_complete_lease(pool[..], 200 + wi, 1000 + wi, 512, 150);
    if st_c != TwStatus.ok { print("W51_FAIL lease complete\n"); return 1; }
  }
  // Verify lease expiration works for an abandoned lease
  #assert tw_issue_lease(pool[..], 299, 1099, w0_id, 199, 30, 4096, 100, 100) == TwStatus.ok;
  #assert tw_expire_leases(pool[..], 250) == 1;
  print("W51_DILOCO_WORKERS ok workers=4 steps_each=30 leases_completed=4 expired_checked=1\n");

  // Compute honest cohort reference (mean of 4 honest deltas)
  cohort_ref: [DL_DIM] f64;
  for j: 0..<DL_DIM {
    cohort_ref[j] = (deltas[0][j] + deltas[1][j] + deltas[2][j] + deltas[3][j]) / 4.0;
  }

  // 3. W5.2: Verify all 4 honest claims pass Tiers 0-4, and all 7 Byzantine attacks are 100% rejected
  honest_ok := 0;
  for wi: 0..<4 {
    c := TvClaim.{
      sig_ok = true, now_s = 150, lease_expires_s = 600,
      parent_sha = w0_id, expect_parent_sha = w0_id,
      shard_sha = 100 + wi, expect_shard_sha = 100 + wi,
      config_sha = 777, expect_config_sha = 777,
      worker_key = 1000 + wi, worker_device = 2000 + wi,
      val_key = 9001, val_device = 9002,
      spot_dist = 0.001, max_spot_dist = 0.05,
      min_l2_sq = 0.0001, max_l2_sq = 50.0,
      canary_exact_ok = true, canary_refusal_ok = true,
    };
    if tv_verify_claim(c, deltas[wi][..], cohort_ref[..]) != TvStatus.accepted {
      print("W52_FAIL honest worker % rejected\n", wi);
      return 1;
    }
    honest_ok += 1;
  }

  // All 7 Byzantine attacks against real deltas[0]
  base_c := TvClaim.{
    sig_ok = true, now_s = 150, lease_expires_s = 600,
    parent_sha = w0_id, expect_parent_sha = w0_id,
    shard_sha = 100, expect_shard_sha = 100,
    config_sha = 777, expect_config_sha = 777,
    worker_key = 1000, worker_device = 2000,
    val_key = 9001, val_device = 9002,
    spot_dist = 0.001, max_spot_dist = 0.05,
    min_l2_sq = 0.0001, max_l2_sq = 50.0,
    canary_exact_ok = true, canary_refusal_ok = true,
  };
  zeros: [DL_DIM] f64;
  noise: [DL_DIM] f64; for j: 0..<DL_DIM { noise[j] = 50.0; }
  flipped: [DL_DIM] f64; for j: 0..<DL_DIM { flipped[j] = -deltas[0][j]; }
  nan_d: [DL_DIM] f64; nan_d[0] = 2000000000.0;

  a1 := tv_verify_claim(base_c, zeros[..], cohort_ref[..]) == TvStatus.zero_delta;
  a2 := tv_verify_claim(base_c, noise[..], cohort_ref[..]) == TvStatus.norm_exceeded;
  a3 := tv_verify_claim(base_c, flipped[..], cohort_ref[..]) == TvStatus.sign_poison;
  c_backdoor := base_c; c_backdoor.canary_refusal_ok = false;
  a4 := tv_verify_claim(c_backdoor, deltas[0][..], cohort_ref[..]) == TvStatus.canary_failed;
  c_stale := base_c; c_stale.parent_sha = w0_id + 1;
  a5 := tv_verify_claim(c_stale, deltas[0][..], cohort_ref[..]) == TvStatus.stale_checkpoint;
  a6 := tv_verify_claim(base_c, nan_d[..], cohort_ref[..]) == TvStatus.non_finite;
  c_collude := base_c; c_collude.val_device = base_c.worker_device;
  a7 := tv_verify_claim(c_collude, deltas[0][..], cohort_ref[..]) == TvStatus.collusion;
  if !(a1 && a2 && a3 && a4 && a5 && a6 && a7) {
    print("W52_FAIL byzantine attack suite\n");
    return 1;
  }

  // Mixed round: 4 honest Pylons + 1 Byzantine sign-flipper (20% poisoner)
  // Compare naive mean vs raw Tier 3 trimmed mean vs full Tier 0-3 verified + trimmed mean
  w_honest: [DL_DIM] f64;
  w_mixed_trim: [DL_DIM] f64;
  w_naive: [DL_DIM] f64;
  for j: 0..<DL_DIM {
    h_vals := [4] f64.[deltas[0][j], deltas[1][j], deltas[2][j], deltas[3][j]];
    m_vals := [5] f64.[deltas[0][j], deltas[1][j], deltas[2][j], deltas[3][j], -5.0 * deltas[0][j]];
    w_honest[j] = w0[j] + tv_trimmed_mean(h_vals[..], 1);
    w_mixed_trim[j] = w0[j] + tv_trimmed_mean(m_vals[..], 1);
    w_naive[j] = w0[j] + (m_vals[0] + m_vals[1] + m_vals[2] + m_vals[3] + m_vals[4]) / 5.0;
  }
  ev_honest := dl_eval(w_honest[..], 9000, DL_HELDOUT_SAMPLES);
  ev_mixed := dl_eval(w_mixed_trim[..], 9000, DL_HELDOUT_SAMPLES);
  ev_naive := dl_eval(w_naive[..], 9000, DL_HELDOUT_SAMPLES);
  if ev_mixed.logloss_milli >= base_eval.logloss_milli || ev_mixed.logloss_milli >= ev_naive.logloss_milli {
    print("W52_FAIL trimmed mean did not beat base/naive: mixed=% naive=% base=%\n", ev_mixed.logloss_milli, ev_naive.logloss_milli, base_eval.logloss_milli);
    return 1;
  }
  print("W52_BYZANTINE ok honest_accepted=%/4 attacks_rejected=7/7 naive_poisoned_logloss_milli=% trimmed_logloss_milli=% honest_logloss_milli=%\n",
        honest_ok, ev_naive.logloss_milli, ev_mixed.logloss_milli, ev_honest.logloss_milli);

  // 4. W5.3: Stage quarantine checkpoint, run all 4 promotion gates (including real Ch 234 wasm-exec-v1 + <exec_refuse>)
  wq_bytes: [DL_DIM * 8] u8;
  wq_sha: [32] u8;
  wq_id := dl_hash_weights(w_honest[..], wq_bytes[..], wq_sha[..]);
  #assert fs_replace_durable(quar_path, cast(string) wq_bytes[..]);

  // Verify real Ch 234 wasm-exec-v1 exact replay + #authority <exec_refuse> gate
  layers: [WX_CORE_MAX_LAYERS] EvLayerDesc;
  heads: [WX_CORE_MAX_HEADS] EvHeadDesc;
  weights: [WX_CORE_MAX_WEIGHTS] f64;
  core := wx_compile_and_load_core(layers[..], heads[..], weights[..]);
  prog := [4] WmOp.[
    WmOp.{code = WmCode.i32_const, arg = 19},
    WmOp.{code = WmCode.i32_const, arg = 23},
    WmOp.{code = WmCode.i32_add},
    WmOp.{code = WmCode.end_op}
  ];
  fns := [1] WsmFunc.[WsmFunc.{entry_ip = 0, n_params = 0, n_locals = 0}];
  n1: [32] HtNode; n2: [32] HtNode;
  rc := wx_run(core, prog[..], fns[..], 16, 100, n1[..]);
  rep := wx_replay_verify(prog[..], fns[..], 16, 100, rc, n2[..]);
  exact_ok := rep.verdict == RxVerdict.exact && rc.result == 42;
  oor_args := [1] int.[HX_ARG_MAX + 1];
  refusal_ok := hx_admit_call(1, 1, true, oor_args[..]) == HxStatus.arg_out_of_range;

  qstate: [1] QoState;
  qstate[0] = qo_init(w0_id);
  #assert qo_stage_quarantine(qstate[..], wq_id, 200) == QoStatus.promoted;
  metrics := QoMetrics.{
    base_pass_bps = base_eval.pass_bps,
    cand_pass_bps = ev_honest.pass_bps,
    noise_2sigma_bps = 200,
    retained_drop_bps = 0,
    base_logloss_milli = base_eval.logloss_milli,
    cand_logloss_milli = ev_honest.logloss_milli,
    base_conferr_bps = base_eval.conferr_bps,
    cand_conferr_bps = ev_honest.conferr_bps,
    exact_replay_ok = exact_ok,
    typed_refusal_ok = refusal_ok,
    cand_latency_us = 1200,
    max_latency_us = 5000,
    cand_mem_mb = 64,
    max_mem_mb = 512,
  };
  pst := qo_try_promote(qstate[..], metrics);
  if pst != QoStatus.promoted || qstate[0].canonical_sha != wq_id {
    print("W53_FAIL promotion status=%\n", pst);
    return 1;
  }
  // Atomic swap canonical.bin <- quarantine.bin and emit CheckpointLineageRecord
  #assert fs_replace_durable(can_path, cast(string) wq_bytes[..]);
  hexq: [64] u8;
  lin_b: [1024] u8;
  ln := json_raw(lin_b[..], 0, "{\"v\":\"openagents.executor.checkpoint-lineage.v1alpha1\",\"parent_sha256\":\"");
  ln = json_raw(lin_b[..], ln, dl_hex32(w0_sha, hex0[..]));
  ln = json_raw(lin_b[..], ln, "\",\"canonical_sha256\":\"");
  ln = json_raw(lin_b[..], ln, dl_hex32(wq_sha, hexq[..]));
  ln = json_raw(lin_b[..], ln, "\",\"generation\":2,\"windows\":[200,201,202,203],\"gates\":\"4/4_passed\"}\n");
  #assert fs_replace_durable(lin_path, cast(string) lin_b[0..<ln]);
  print("W53_PROMOTE ok canonical_v2_sha256=% pass_bps=%->% logloss_milli=%->% exact=% refusal=%\n",
        dl_hex32(wq_sha, hexq[..]), base_eval.pass_bps, ev_honest.pass_bps,
        base_eval.logloss_milli, ev_honest.logloss_milli, exact_ok, refusal_ok);

  // All 3 deliberate regression falsifiers MUST block promotion & leave canonical untouched
  #assert qo_stage_quarantine(qstate[..], wq_id + 11, 301) == QoStatus.promoted;
  m_f1 := metrics; m_f1.cand_pass_bps = m_f1.base_pass_bps - 500;
  f1 := qo_try_promote(qstate[..], m_f1) == QoStatus.decision_gate_failed;
  #assert qo_stage_quarantine(qstate[..], wq_id + 12, 302) == QoStatus.promoted;
  m_f2 := metrics; m_f2.cand_pass_bps = 9500; m_f2.cand_logloss_milli = m_f2.base_logloss_milli + 371;
  f2 := qo_try_promote(qstate[..], m_f2) == QoStatus.probability_gate_failed;
  #assert qo_stage_quarantine(qstate[..], wq_id + 13, 303) == QoStatus.promoted;
  m_f3 := metrics; m_f3.typed_refusal_ok = false;
  f3 := qo_try_promote(qstate[..], m_f3) == QoStatus.exactness_gate_failed;
  if !(f1 && f2 && f3) || qstate[0].canonical_sha != wq_id {
    print("W53_FAIL regression falsifiers\n");
    return 1;
  }

  // Atomic rollback back to canonical_v1_sha256 and exclude suspect window 200
  rb := qo_rollback(qstate[..], w0_id, 200);
  if rb != QoStatus.promoted || qstate[0].canonical_sha != w0_id {
    print("W53_FAIL rollback status=%\n", rb);
    return 1;
  }
  bak_read: [DL_DIM * 8] u8;
  bn := fs_read(bak_path, bak_read[..]);
  #assert bn == DL_DIM * 8 && fs_replace_durable(can_path, cast(string) bak_read[0..<bn]);
  ver_read: [DL_DIM * 8] u8;
  vn := fs_read(can_path, ver_read[..]);
  ver_sha: [32] u8;
  #assert vn == DL_DIM * 8 && sha256_hash_checked(ver_read[0..<vn], ver_sha[..], false) == SHA_OK;
  for i: 0..<32 { if ver_sha[i] != w0_sha[i] { print("W53_FAIL rollback sha mismatch\n"); return 1; } }
  // Quarantined window 200 is now excluded from future rounds
  if qo_stage_quarantine(qstate[..], wq_id, 200) != QoStatus.window_excluded {
    print("W53_FAIL excluded window not blocked\n");
    return 1;
  }
  hexv: [64] u8;
  print("W53_ROLLBACK ok restored_sha256=% matches_v1=true excluded_window_200=blocked falsifiers_blocked=3/3\n",
        dl_hex32(ver_sha, hexv[..]));
  print("diloco-round: PASS (W5.1 + W5.2 + W5.3 end-to-end verified)\n");
  return 0;
}
