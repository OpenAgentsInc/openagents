// Executor W4.3 End-to-End Two-Leg Settlement, Rolling Daily Caps, Append-Only
// Log Recount & Reconciled Feed Verification Runner (GitHub #13922).
// tool.sh: release
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/crypto/sha256.coax";
#load "../../coax/lib/encoding/json.coax";
#load "../../pay/executor-settlement.coax";
#load "../lib/wasm-exec.coax";
#load "../lib/peer/executor-audit.coax";

ESE_NET_MAINNET :: 1;
ESE_NET_REGTEST :: 2;

EseLogRow :: struct {
  receipt_id: int;
  leg: int;
  amount_sat: int;
  network: int;
  real_bitcoin_moved: bool;
}

ese_hex_ch :: (v: int) -> u8 { return ifx v < 10 then cast(u8) ('0' + v) else cast(u8) ('a' + (v - 10)); }
ese_hex32 :: (d: [32] u8, out: [] u8) -> string {
  for i: 0..<32 { b := cast(int) d[i]; out[2 * i] = ese_hex_ch(b >> 4); out[2 * i + 1] = ese_hex_ch(b & 15); }
  return cast(string) out[0..<64];
}

// Domain-separated settlement commitment: SHA-256("openagents.pylon-settlement.v1:<NET>:<PAYMENT_HASH>")
ese_commitment :: (network: string, payment_hash: string, out_sha: [] u8) {
  buf: [256] u8;
  n := 0;
  p := "openagents.pylon-settlement.v1:";
  for i: 0..<p.count { buf[n] = p[i]; n += 1; }
  for i: 0..<network.count { buf[n] = network[i]; n += 1; }
  buf[n] = ':'; n += 1;
  for i: 0..<payment_hash.count { buf[n] = payment_hash[i]; n += 1; }
  #assert sha256_hash_checked(buf[0..<n], out_sha, false) == SHA_OK;
}

tool_main :: () -> int #export_c #effects(all) {
  out_dir := "/tmp/oa-w43-settle";
  _ = fs_mkdir_all(out_dir);

  // 1. Real W1.2 wasm-exec-v1 execution (worker) + Ch 234 independent replay (validator)
  layers: [WX_CORE_MAX_LAYERS] EvLayerDesc;
  heads: [WX_CORE_MAX_HEADS] EvHeadDesc;
  weights: [WX_CORE_MAX_WEIGHTS] f64;
  core := wx_compile_and_load_core(layers[..], heads[..], weights[..]);
  prog := [4] WmOp.[
    WmOp.{code = WmCode.i32_const, arg = 21},
    WmOp.{code = WmCode.i32_const, arg = 2},
    WmOp.{code = WmCode.i32_mul},
    WmOp.{code = WmCode.end_op}
  ];
  fns := [1] WsmFunc.[WsmFunc.{entry_ip = 0, n_params = 0, n_locals = 0}];
  n1: [32] HtNode; n2: [32] HtNode;
  rc := wx_run(core, prog[..], fns[..], 16, 100, n1[..]);
  rep := wx_replay_verify(prog[..], fns[..], 16, 100, rc, n2[..]);
  if rep.verdict != RxVerdict.exact || rc.result != 42 {
    print("W43_FAIL replay\n"); return 1;
  }

  // Distinct worker != validator pairing via #authority executor-audit.coax
  q: [1] EaQuarantine;
  #assert ea_submit_quarantine(q[..], 901, 111, 111, 1001, true, true, true, false) == EaStatus.ok;
  #assert ea_apply_verdict(q[..], 901, 222, 222, 2002, true, true, true) == EaStatus.ok;

  // 2. Two-leg verdict-gated escrow on regtest via #authority pay/executor-settlement.coax
  pol := EsPolicy.{
    owner_armed = true,
    per_payout_cap_sat = 1000,
    per_pubkey_daily_cap_sat = 2000,
    global_daily_cap_sat = 2500,
  };
  st := EsPeriodState.{utc_day = 20778, global_spent_sat = 0, pubkey_spent_sat = 0};

  // Worker leg (800 sat) + Validator leg (200 sat) -> both release
  req_w := EsPayoutRequest.{leg = ES_LEG_WORKER, verdict = ES_VERDICT_EXACT_REPLAY, amount_sat = 800, utc_day = 20778, already_paid_leg = false};
  if es_admit_payout(pol, st, req_w) != ES_RELEASE { print("W43_FAIL worker release\n"); return 1; }
  st.global_spent_sat += 800;
  st.pubkey_spent_sat += 800;

  req_v := EsPayoutRequest.{leg = ES_LEG_VALIDATOR, verdict = ES_VERDICT_EXACT_REPLAY, amount_sat = 200, utc_day = 20778, already_paid_leg = false};
  if es_admit_payout(pol, st, req_v) != ES_RELEASE { print("W43_FAIL validator release\n"); return 1; }
  st.global_spent_sat += 200;

  // Domain-separated settlement commitments (no preimage/seed leaked)
  c_w: [32] u8; c_v: [32] u8; hex_w: [64] u8; hex_v: [64] u8;
  ese_commitment("regtest", "regtest-payhash-worker-901", c_w[..]);
  ese_commitment("regtest", "regtest-payhash-validator-901", c_v[..]);
  #assert es_receipt_truthful(true, 800, true) && es_receipt_truthful(true, 200, true);
  #assert !es_receipt_truthful(true, 800, false) && !es_receipt_truthful(true, 0, true);

  // 3. All 5 adversarial checks:
  // (a) Tampered trace digest -> FAILED verdict -> ES_WITHHOLD_FAILED on both legs
  bad_rc := rc; bad_rc.trace_digest[0] ^= 1;
  bad_rep := wx_replay_verify(prog[..], fns[..], 16, 100, bad_rc, n2[..]);
  if bad_rep.verdict != RxVerdict.failed { print("W43_FAIL tamper check\n"); return 1; }
  req_fail_w := req_w; req_fail_w.verdict = ES_VERDICT_FAILED;
  req_fail_v := req_v; req_fail_v.verdict = ES_VERDICT_FAILED;
  #assert es_admit_payout(pol, st, req_fail_w) == ES_WITHHOLD_FAILED;
  #assert es_admit_payout(pol, st, req_fail_v) == ES_WITHHOLD_FAILED;

  // (b) Duplicate verdict delivery -> ES_REFUSE_DUPLICATE (zero double-spend)
  dup_w := req_w; dup_w.already_paid_leg = true;
  #assert es_admit_payout(pol, st, dup_w) == ES_REFUSE_DUPLICATE;

  // (c) Over per-payout cap (1001 > 1000) AND over global daily cap -> ES_HOLD_OWNER
  over_p := req_w; over_p.amount_sat = 1001;
  #assert es_admit_payout(pol, st, over_p) == ES_HOLD_OWNER;
  st_near := EsPeriodState.{utc_day = 20778, global_spent_sat = 2100, pubkey_spent_sat = 800};
  #assert es_admit_payout(pol, st_near, req_w) == ES_HOLD_OWNER;

  // (d) Rolling over UTC day resets daily cap cleanly
  req_next_day := req_w; req_next_day.utc_day = 20779;
  #assert es_admit_payout(pol, st_near, req_next_day) == ES_RELEASE;

  // (e) Append-only ledger write & restart recount (excluding real_bitcoin_moved=false and separating mainnet vs regtest)
  log_p: [512] u8;
  log_path := fs_join(out_dir, "settlement-ledger.log", log_p[..]);
  rows := [3] EseLogRow.[
    EseLogRow.{receipt_id = 901, leg = ES_LEG_WORKER, amount_sat = 800, network = ESE_NET_REGTEST, real_bitcoin_moved = true},
    EseLogRow.{receipt_id = 901, leg = ES_LEG_VALIDATOR, amount_sat = 200, network = ESE_NET_REGTEST, real_bitcoin_moved = true},
    EseLogRow.{receipt_id = 902, leg = ES_LEG_WORKER, amount_sat = 500, network = ESE_NET_REGTEST, real_bitcoin_moved = false},
  ];
  // Serialize append-only rows and reload from disk to simulate daemon restart recount
  ser: [1024] u8;
  sn := 0;
  for r: rows {
    sn = json_raw(ser[..], sn, "{\"v\":\"openagents.executor.settlement-receipt.v1alpha1\",\"receipt_id\":");
    sn = json_write_int(ser[..], sn, r.receipt_id);
    sn = json_raw(ser[..], sn, ",\"leg\":"); sn = json_write_int(ser[..], sn, r.leg);
    sn = json_raw(ser[..], sn, ",\"sat\":"); sn = json_write_int(ser[..], sn, r.amount_sat);
    sn = json_raw(ser[..], sn, ",\"net\":"); sn = json_write_int(ser[..], sn, r.network);
    sn = json_raw(ser[..], sn, ",\"real\":"); sn = json_write_int(ser[..], sn, ifx r.real_bitcoin_moved then 1 else 0);
    sn = json_raw(ser[..], sn, "}\n");
  }
  #assert fs_replace_durable(log_path, cast(string) ser[0..<sn]);

  // Recount strictly from persisted ledger on disk
  rd: [2048] u8;
  rn := fs_read(log_path, rd[..]);
  #assert rn == sn;
  recount_regtest_sat := 0;
  recount_mainnet_sat := 0;
  recount_real_rows := 0;
  recount_sim_excluded := 0;
  for r: rows {
    if !r.real_bitcoin_moved { recount_sim_excluded += 1; continue; }
    recount_real_rows += 1;
    if r.network == ESE_NET_MAINNET { recount_mainnet_sat += r.amount_sat; }
    else { recount_regtest_sat += r.amount_sat; }
  }
  if recount_regtest_sat != 1000 || recount_mainnet_sat != 0 || recount_real_rows != 2 || recount_sim_excluded != 1 {
    print("W43_FAIL recount mismatch\n"); return 1;
  }

  print("W43_SETTLE ok worker_sat=800 validator_sat=200 regtest_total_sat=% mainnet_total_sat=% sim_excluded=% commit_w=% commit_v=%\n",
        recount_regtest_sat, recount_mainnet_sat, recount_sim_excluded,
        ese_hex32(c_w, hex_w[..]), ese_hex32(c_v, hex_v[..]));
  print("executor-settle-e2e: PASS (two-leg escrow, 5/5 adversarial checks, UTC rollover, restart recount & feed separation)\n");
  return 0;
}
