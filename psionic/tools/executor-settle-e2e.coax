// Executor W4.3 End-to-End Two-Leg Settlement, Rolling Daily Caps, Append-Only
// Log Recount, Reconciled Settled Feed & NIP-PYLON 30201 Pool Verifier (GitHub #13922).
// tool.sh: release
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/crypto/sha256.coax";
#load "../../coax/lib/encoding/json.coax";
#load "../lib/wasm-exec.coax";
#load "../lib/peer/executor-audit.coax";
#load "../lib/peer/pay.coax";
#load "../lib/peer/settled-feed.coax";

tool_main :: () -> int #export_c #effects(all) {
  out_dir := "/tmp/oa-w43-settle";
  _ = fs_mkdir_all(out_dir);

  // 1. Real W1.2 wasm-exec-v1 execution (worker) + Ch 234 independent replay (validator)
  layers: [WX_CORE_MAX_LAYERS] EvLayerDesc;
  heads: [WX_CORE_MAX_HEADS] EvHeadDesc;
  weights: [WX_CORE_MAX_WEIGHTS] f64;
  core := wx_compile_and_load_core(layers[..], heads[..], weights[..]);
  prog := [4] WmOp.[
    WmOp.{code = WmCode.i32_const, arg = 21},
    WmOp.{code = WmCode.i32_const, arg = 2},
    WmOp.{code = WmCode.i32_mul},
    WmOp.{code = WmCode.end_op}
  ];
  fns := [1] WsmFunc.[WsmFunc.{entry_ip = 0, n_params = 0, n_locals = 0}];
  n1: [32] HtNode; n2: [32] HtNode;
  rc := wx_run(core, prog[..], fns[..], 16, 100, n1[..]);
  rep := wx_replay_verify(prog[..], fns[..], 16, 100, rc, n2[..]);
  if rep.verdict != RxVerdict.exact || rc.result != 42 {
    print("W43_FAIL replay\n"); return 1;
  }

  // Distinct worker != validator pairing via #authority executor-audit.coax
  q: [1] EaQuarantine;
  #assert ea_submit_quarantine(q[..], 901, 111, 111, 1001, true, true, true, false) == EaStatus.ok;
  #assert ea_apply_verdict(q[..], 901, 222, 222, 2002, true, true, true) == EaStatus.ok;

  // 2. Two-leg verdict-gated escrow on regtest via #authority pay.coax + pay/executor-settlement.coax
  pol := VpExecPolicy.{
    es = EsPolicy.{
      owner_armed = true,
      per_payout_cap_sat = 1000,
      per_pubkey_daily_cap_sat = 2000,
      global_daily_cap_sat = 2500
    },
    mainnet_armed = false,
    owner_policy_digest = "1111111111111111111111111111111111111111111111111111111111111111"
  };
  rcpt_hex: [64] u8;
  _ = S_hex(S_hash("w43-e2e-receipt-901"), rcpt_hex[..]);
  rcpt_id := cast(string) rcpt_hex[..];
  rcpt2_hex: [64] u8;
  _ = S_hex(S_hash("w43-e2e-receipt-902"), rcpt2_hex[..]);
  rcpt2_id := cast(string) rcpt2_hex[..];
  vd_id := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
  wrk_pk := "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
  val_pk := "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee";

  l: VpExecLedger;
  pair := vp_exec_admit_replay_pair(
    l, pol, rcpt_id, vd_id, wrk_pk, val_pk,
    ExwReplayOutcome.exact_replay, 800, 200, 20778, "2026-11-21", "regtest"
  );
  if pair.worker.code != ES_RELEASE || pair.validator.code != ES_RELEASE || !pair.worker.has_intent || !pair.validator.has_intent {
    print("W43_FAIL two-leg release\n"); return 1;
  }
  l = pair.ledger;

  // Domain-separated settlement commitments via #authority settled-feed.coax (no preimage/seed leaked)
  hex_w: [64] u8; hex_v: [64] u8;
  #assert sf_settlement_commitment("regtest", "regtest-payhash-worker-901", hex_w[..]);
  #assert sf_settlement_commitment("regtest", "regtest-payhash-validator-901", hex_v[..]);
  cw := cast(string) hex_w[..];
  cv := cast(string) hex_v[..];

  // Record settled worker (800 sat) + validator (200 sat) and one simulated (500 sat, real_bitcoin_moved=false)
  recs: [3] ExwSettlementReceipt;
  sw := vp_exec_record_settlement(l, pol, rcpt_id, ES_LEG_WORKER, true, 1795200100, cw, "2026-11-21", recs[0..<1]);
  #assert sw.code == ES_RELEASE && sw.state == VpExecState.settled;
  l = sw.ledger;
  sv := vp_exec_record_settlement(l, pol, rcpt_id, ES_LEG_VALIDATOR, true, 1795200101, cv, "2026-11-21", recs[1..<2]);
  #assert sv.code == ES_RELEASE && sv.state == VpExecState.settled;
  l = sv.ledger;
  sim_step := vp_exec_admit_leg(l, pol, rcpt2_id, vd_id, wrk_pk, ES_LEG_WORKER, ES_VERDICT_EXACT_REPLAY, 500, 20778, "2026-11-21", "regtest");
  #assert sim_step.code == ES_RELEASE;
  l = sim_step.ledger;
  ss := vp_exec_record_settlement(l, pol, rcpt2_id, ES_LEG_WORKER, false, 0, "", "2026-11-21", recs[2..<3]);
  #assert ss.code == ES_RELEASE && ss.state == VpExecState.released && ss.ledger.settled_real_sat == 1000;
  l = ss.ledger;

  // 3. All 5 adversarial checks:
  // (a) Tampered trace digest -> FAILED verdict -> ES_WITHHOLD_FAILED on both legs
  bad_rc := rc; bad_rc.trace_digest[0] ^= 1;
  bad_rep := wx_replay_verify(prog[..], fns[..], 16, 100, bad_rc, n2[..]);
  if bad_rep.verdict != RxVerdict.failed { print("W43_FAIL tamper check\n"); return 1; }
  bad_pair := vp_exec_admit_replay_pair(
    VpExecLedger.{}, pol, rcpt_id, vd_id, wrk_pk, val_pk,
    ExwReplayOutcome.failed, 800, 200, 20778, "2026-11-21", "regtest"
  );
  #assert bad_pair.worker.code == ES_WITHHOLD_FAILED && bad_pair.validator.code == ES_WITHHOLD_FAILED;

  // (b) Duplicate verdict delivery -> ES_REFUSE_DUPLICATE (zero double-spend)
  dup := vp_exec_admit_leg(l, pol, rcpt_id, vd_id, wrk_pk, ES_LEG_WORKER, ES_VERDICT_EXACT_REPLAY, 800, 20778, "2026-11-21", "regtest");
  #assert dup.code == ES_REFUSE_DUPLICATE;

  // (c) Over per-payout cap (1001 > 1000), over global daily cap, AND unarmed mainnet -> ES_HOLD_OWNER
  rcpt3 := "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
  #assert vp_exec_admit_leg(l, pol, rcpt3, vd_id, wrk_pk, ES_LEG_WORKER, ES_VERDICT_EXACT_REPLAY, 1001, 20778, "2026-11-21", "regtest").code == ES_HOLD_OWNER;
  #assert vp_exec_admit_leg(l, pol, rcpt3, vd_id, wrk_pk, ES_LEG_WORKER, ES_VERDICT_EXACT_REPLAY, 800, 20778, "2026-11-21", "bitcoin").code == ES_HOLD_OWNER;
  l_near := l; l_near.global_spent_sat = 2100;
  #assert vp_exec_admit_leg(l_near, pol, rcpt3, vd_id, wrk_pk, ES_LEG_WORKER, ES_VERDICT_EXACT_REPLAY, 800, 20778, "2026-11-21", "regtest").code == ES_HOLD_OWNER;

  // (d) Rolling over UTC day resets daily cap cleanly
  rolled := vp_exec_admit_leg(l_near, pol, rcpt3, vd_id, wrk_pk, ES_LEG_WORKER, ES_VERDICT_EXACT_REPLAY, 800, 20779, "2026-11-22", "regtest");
  #assert rolled.code == ES_RELEASE && rolled.ledger.utc_day == 20779 && rolled.ledger.global_spent_sat == 800;

  // (e) Append-only W2.1 JSONL persistence, restart reload & #authority reconciled settled feed + 30201 projection
  log_p: [512] u8;
  log_path := fs_join(out_dir, "settlement-ledger.jsonl", log_p[..]);
  ser: [8192] u8;
  sn := 0;
  for r: recs {
    one_b: [2048] u8;
    w := exw_settlement_receipt_write(r, one_b[..]);
    #assert w.err == ExwErr.ok;
    #assert !sf_has_secret(cast(string) one_b[0..<w.len]);
    for j: 0..<w.len { ser[sn] = one_b[j]; sn += 1; }
    ser[sn] = '\n'; sn += 1;
  }
  #assert fs_replace_durable(log_path, cast(string) ser[0..<sn]);

  // Reload strictly from persisted disk log and decode with W2.1 exw_settlement_receipt_read
  rd: [8192] u8;
  rn := fs_read(log_path, rd[..]);
  #assert rn == sn;
  reloaded: [3] ExwSettlementReceipt;
  arena: [4096] u8;
  a_pos := 0;
  r_cnt := 0;
  pos := 0;
  while pos < rn {
    start := pos;
    while pos < rn && rd[pos] != '\n' { pos += 1; }
    line := cast(string) rd[start..<pos];
    pos += 1;
    #assert exw_settlement_receipt_read(line, reloaded[r_cnt..<r_cnt + 1], arena[a_pos..<a_pos + 1024]) == ExwErr.ok;
    r_cnt += 1;
    a_pos += 1024;
  }
  #assert r_cnt == 3;

  // Reconcile via #authority settled-feed.coax + verify NIP-PYLON 30201 pool aggregate
  feed := sf_reconcile_feed(reloaded[..]);
  #assert feed.err == SfErr.ok;
  #assert feed.paid_msat_regtest == 1000000 && feed.paid_msat_bitcoin == 0 && feed.paid_msat_testnet == 0 && feed.paid_msat_signet == 0;
  #assert feed.settled_count == 2 && feed.excluded_simulated_count == 1;

  zero_sha := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
  meta := SfPoolMeta.{
    aggregator = val_pk,
    pool = "executor-pool",
    policy_digest = pol.owner_policy_digest,
    window_from = 1795200000,
    window_to = 1795203600,
    generated_at = 1795203600,
    valid_until = 1795203900,
    beacons_count = 2,
    beacons_digest = zero_sha,
    checks_count = 1,
    checks_digest = zero_sha,
    pylons_online = 2,
    slots_total = 2,
    slots_free = 2,
    family_unified = 1,
    family_gpu = 1,
    family_cpu = 0,
    jobs_accepted = 1,
    checks_pass = 1,
    checks_fail = 0,
    checks_inconclusive = 0
  };
  pbody: [4096] u8; ptags: [512] u8; fjson: [8192] u8;
  pbn := sf_pool_30201_content(meta, feed, pbody[..]);
  ptn := sf_pool_30201_tags(meta, cast(string) pbody[0..<pbn], ptags[..]);
  fjn := sf_feed_json(feed, reloaded[..], fjson[..]);
  #assert pbn > 0 && ptn > 0 && fjn > 0;
  #assert !sf_has_secret(cast(string) pbody[0..<pbn]) && !sf_has_secret(cast(string) fjson[0..<fjn]);
  #assert sf_pool_30201_verify(cast(string) pbody[0..<pbn], cast(string) ptags[0..<ptn], meta, reloaded[..]);

  print("W43_SETTLE ok worker_sat=800 validator_sat=200 regtest_total_sat=% mainnet_total_sat=% sim_excluded=% pool_30201_bytes=% commit_w=% commit_v=%\n",
        feed.paid_msat_regtest / 1000, feed.paid_msat_bitcoin / 1000, feed.excluded_simulated_count, pbn, cw, cv);
  print("executor-settle-e2e: PASS (two-leg W2.1 escrow, 5/5 adversarial checks, UTC rollover, restart recount, settled feed & NIP-PYLON 30201)\n");
  return 0;
}
