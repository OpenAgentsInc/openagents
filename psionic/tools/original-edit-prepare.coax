#import "Basic";
#load "original-edit-data.coax";
#load "../lib/optim/adamw.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/proc.coax";
#test "the channel-only fitting derivative agrees with independent central differences" {
    for z:[3]f64.[-4,1,7] {for t:[3]f64.[0.1,1,2] {for a:[3]f64.[-2,0,3] {
        hi:=log(1+exp(z-2*(a+1e-6)*t));lo:=log(1+exp(z-2*(a-1e-6)*t));#assert abs((hi-lo)/2e-6-od_channel_gradient(a,t,z))<1e-8;
    }}}
}
od_channel_gradient :: (alpha:f64,t:f64,z:f64)->f64 {return -2*t/(1+exp(-(z-2*alpha*t)));}
od_fit :: (d:OdData)->f64 {
    projections:[6]f64;differences:[6]f64;direction:=d.direction;
    for which:36..<42 {h:=od_vector(which);for i:0..<2880 {projections[which-36]+=h[i]*direction[i];}
        path:[1024]u8;bytes:[804352]u8;#assert fs_read(od_path("channel/",which,".logits.f32",path[..]),bytes[..])==804352;
        differences[which-36]=ow_value(bytes[..],35644,OwType.f32)-ow_value(bytes[..],17196,OwType.f32);
    }
    p:[1]f64;m:[1]f64;v:[1]f64;none:[1]f32;state:AwState;groups:=[1]AwGroup.[AwGroup.{count=1,lr=0.05,beta1=0.9,beta2=0.99,eps=1e-8}];
    for step:0..<200 {grad:=0.0;for i:0..<6 {grad+=od_channel_gradient(p[0],projections[i],differences[i])/6;}
        g:=[1]f64.[grad];r:=aw_step(groups[..],AwPolicy.{},state,p[..],g[..],m[..],v[..],none[0..<0],false);#assert r.status==AwStatus.ok;state=r.state;if p[0]>4 {p[0]=4;}if p[0]< -4 {p[0]=-4;}
    }return p[0];
}
tool_main :: ()->int #export_c {
    a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}mode:=args_at(a[..],0);d:=od_load();
    if mode=="prepare" {#assert !fs_exists("psionic/fixtures/original-edit/fit-alpha.f64");start:=proc_now_ms();alpha:=od_fit(d);b:[8]u8;n:=we_word(b[..],0,f64_bits(alpha));#assert fs_write("psionic/fixtures/original-edit/fit-alpha.f64",cast(string)b[..]);print("fit: 200 AdamW steps, alpha %, milliseconds %\n",alpha,proc_now_ms()-start);
        for id:0..<13 {c:=od_candidate(id,d);od_save(id,d,c);print("candidate %: valid %, changed %, norm2 %\n",id,c.valid,c.changed,c.norm2);}return 0;
    }
    if mode=="seal" {for id:13..<16 {c:=od_candidate(id,d);od_save(id,d,c);print("candidate %: valid %, changed %, norm2 %\n",id,c.valid,c.changed,c.norm2);}return 0;}
    if mode=="carry" {for id:13..<16 {c:=od_candidate(id,d);if !c.valid {continue;}source:=-1;for other:0..<13 {if other==1 || other==2 {continue;}base:=od_candidate(other,d);if we_same(base.digest,c.digest) {source=other;break;}}
        if source>=0 {b:[1024]u8;j:[1]Jo;hex:[64]u8;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_int(j[..],source);jo_key(j[..],"digest");jo_str(j[..],od_hex(c.digest,hex[..]));jo_key(j[..],"contract");jo_str(j[..],"same-weights-greedy-request-v1");jo_end(j[..]);path:[1024]u8;#assert fs_write(od_path("candidates/",id,".carry.json",path[..]),jo_text(j[..]));print("candidate % carries observed greedy source %; zero new sequences\n",id,source);}
    }return 0;}
    if mode=="rows" {
        print("// Two authenticated original readout windows; no full model required.\nOE_MODEL :: [32]u8.[");for i:0..<32 {if i>0 {print(",");}print("%",d.model[i]);}print("];\nOE_SHARD :: [32]u8.[");for i:0..<32 {if i>0 {print(",");}print("%",d.shard[i]);}print("];\nOE_ROWS :: [2][5760]u8.[\n");
        for row:0..<2 {print("[5760]u8.[");for i:0..<5760 {if i>0 {print(",");}print("%",d.original[row][i]);}print("]%\n",ifx row==0 then "," else "");}print("];\n");return 0;
    }
    return 2;
}
