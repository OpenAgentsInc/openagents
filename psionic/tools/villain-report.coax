#import "Basic";
#load "villain-data.coax";
#load "../../coax/lib/sys/tool.coax";
VrMetric :: struct {n:int;complete:int;tokens:int;prompt:int;words:int;over:int;repeat:int;correct:int;milliseconds:int;}
vr_line :: (id:int,which:int,out:[]u8)->int {
    path:[1024]u8;raw:[65536]u8;stem:=ifx id==20 then "external/" else ifx id==21 then "external-initial/" else ifx id==22 then "external-second/" else "runs/";name:=vw_path(stem,ifx id>=20 then which else id*100+which,ifx id>=20 then ".response.json" else ".json",path[..]);n:=fs_read(name,raw[..]);#assert n>0;j:[1]Jv;nodes:[4096]JvNode;#assert jv_parse(j[..],cast(string)raw[0..<n],nodes[..]);return jv_str(j[0],jv_get(j[0],0,ifx id>=20 then "result" else "final"),out);
}
vr_metric :: (id:int,which:int)->VrMetric {
    path:[1024]u8;raw:[65536]u8;r:=VrMetric.{n=1};stem:=ifx id==20 then "external/" else ifx id==21 then "external-initial/" else ifx id==22 then "external-second/" else "runs/";
    n:=fs_read(vw_path(stem,ifx id>=20 then which else id*100+which,ifx id>=20 then ".response.json" else ".json",path[..]),raw[..]);#assert n>0;j:[1]Jv;nodes:[4096]JvNode;#assert jv_parse(j[..],cast(string)raw[0..<n],nodes[..]);
    if id<20 {r.complete=ifx jv_kind(j[0],jv_get(j[0],0,"complete"))==JV_TRUE then 1 else 0;r.tokens=jv_len(j[0],jv_get(j[0],0,"generated"));r.prompt=jv_len(j[0],jv_get(j[0],0,"prefix"));r.words=jv_int(j[0],jv_get(j[0],0,"words"),-1);r.repeat=ifx jv_int(j[0],jv_get(j[0],0,"repeat_span"),-1)>0 then 1 else 0;r.correct=ifx jv_kind(j[0],jv_get(j[0],0,"control_ok"))==JV_TRUE then 1 else 0;r.milliseconds=jv_int(j[0],jv_get(j[0],0,"milliseconds"),-1);}
    else {sub:[32]u8;k:=jv_str(j[0],jv_get(j[0],0,"subtype"),sub[..]);r.complete=ifx k==7 && cast(string)sub[0..<k]=="success" && jv_kind(j[0],jv_get(j[0],0,"is_error"))==JV_FALSE then 1 else 0;
        usage:=jv_get(j[0],0,"usage");r.tokens=jv_int(j[0],jv_get(j[0],usage,"output_tokens"),-1);r.prompt=jv_int(j[0],jv_get(j[0],usage,"input_tokens"),-1)+jv_int(j[0],jv_get(j[0],usage,"cache_creation_input_tokens"),-1)+jv_int(j[0],jv_get(j[0],usage,"cache_read_input_tokens"),-1);text:[4096]u8;k=jv_str(j[0],jv_get(j[0],0,"result"),text[..]);#assert k>=0;r.words=vw_words(cast(string)text[0..<k]);if which>=14 {expected:=[4]string.["391","Paris","TORCH","north stairs forest"];r.correct=ifx cast(string)text[0..<k]==expected[which-14] then 1 else 0;}
        n=fs_read(vw_path(stem,which,".timing.json",path[..]),raw[..]);#assert n>0;#assert jv_parse(j[..],cast(string)raw[0..<n],nodes[..]);r.milliseconds=jv_int(j[0],jv_get(j[0],0,"milliseconds"),-1);
    }r.over=ifx r.words>60 then 1 else 0;return r;
}
vr_sum :: (a:VrMetric,b:VrMetric)->VrMetric {return VrMetric.{n=a.n+b.n,complete=a.complete+b.complete,tokens=a.tokens+b.tokens,prompt=a.prompt+b.prompt,words=a.words+b.words,over=a.over+b.over,repeat=a.repeat+b.repeat,correct=a.correct+b.correct,milliseconds=a.milliseconds+b.milliseconds};}
tool_main :: ()->int #export_c {
    a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}mode:=args_at(a[..],0);ids:=[17]int.[0,1,2,3,4,5,6,7,8,11,12,15,16,17,20,21,22];
    if mode=="dev" {for which:0..<6 {print("\nCASE % %: %\n",which,VW_CASES[which].label,VW_CASES[which].question);for id:ids {line:[4096]u8;n:=vr_line(id,which,line[..]);#assert n>=0;print("[%] %\n",id,cast(string)line[0..<n]);}}return 0;}
    if mode=="matrix" {print("id,split,n,complete,output_tokens,token_basis,prompt_tokens,words,over60,repeated,token_repetition_measured,control_correct,milliseconds\n");for id:ids {for split:0..<3 {if id>=21 && split!=0 {continue;}sum:VrMetric;for which:0..<18 {if VW_CASES[which].split==split {sum=vr_sum(sum,vr_metric(id,which));}}print("%,%,%,%,%,%,%,%,%,%,%,%,%\n",id,split,sum.n,sum.complete,sum.tokens,ifx id<20 then "emitted_ids" else "provider_including_thinking",sum.prompt,sum.words,sum.over,sum.repeat,id<20,sum.correct,sum.milliseconds);}}return 0;}
    if mode=="judge-local" || mode=="judge-weight" {chosen:=ifx mode=="judge-local" then 11 else 3;b:[16384]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"task");jo_str(j[..],"Compare two fictional NPC replies in each pair as a demanding game-dialogue editor. Judge distinctive voice, menace/subtext, relevance and continuity/player agency. Poetic imagery and credible villain boasts are allowed; wrong directions, reversed explicit physical limits, invented completed actions or wrong names are defects. Available healing is not evidence of a player's injury. Prefer useful, concrete dialogue over biography or stock threats. Do not favor length. Labels are blinded and position alternates. Return ONLY JSON {pairs:[{case:integer,winner:A or B or tie,reason:one short sentence}]} with each of the8 cases exactly once. No tools.");jo_key(j[..],"character_facts");jo_str(j[..],VEYR.knowledge);jo_key(j[..],"pairs");jo_arr(j[..]);for which:6..<14 {c:=VW_CASES[which];swap:=(which-6)%2==1;left:=ifx swap then chosen else 0;right:=ifx swap then 0 else chosen;x:[4096]u8;y:[4096]u8;nx:=vr_line(left,which,x[..]);ny:=vr_line(right,which,y[..]);#assert nx>=0 && ny>=0;jo_obj(j[..]);jo_key(j[..],"case");jo_int(j[..],which);jo_key(j[..],"state");jo_str(j[..],c.state);jo_key(j[..],"previous_player");jo_str(j[..],c.previous_player);jo_key(j[..],"previous_npc");jo_str(j[..],c.previous_npc);jo_key(j[..],"question");jo_str(j[..],c.question);jo_key(j[..],"A");jo_str(j[..],cast(string)x[0..<nx]);jo_key(j[..],"B");jo_str(j[..],cast(string)y[0..<ny]);jo_end(j[..]);}jo_end(j[..]);jo_end(j[..]);#assert !j[0].bad;print("%\n",jo_text(j[..]));return 0;}
    if mode=="source" {print("// Recorded held-out dialogue, not live inference.\nVEYR_RECORDED :: [8]string.[\n");for which:6..<14 {line:[4096]u8;n:=vr_line(20,which,line[..]);#assert n>0;b:[8192]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_str(j[..],cast(string)line[0..<n]);print("%",jo_text(j[..]));print("%\n",ifx which==13 then "" else ",");}print("];\n");return 0;}
    return 2;
}
