// Prepare chapter 253's fresh artifacts once. All training arithmetic is Coax.
// Run with coax/web/tool.sh; stdout is a source fixture, stderr is progress.
#import "Basic";
#load "../lib/weight-space.coax";
#load "../../coax/lib/sys/tool.coax";

tool_main :: ()->int #export_c {
    print("// Generated by psionic/tools/weight-space-train.coax; seeds 119..123.\n");
    print("// Models 0..4: hint weight 0.75. Models 5..9: hint weight 0.\n");
    print("WS_FRESH :: [10][664]u64.[\n");
    for mode:0..<2 {for seed:119..<124 {
        tool_errln("training one 664-parameter artifact");
        hinted:=ifx mode==0 then 0.75 else 0.0;p:=ws_train(cast(u64)seed,hinted);
        if seed==119 && mode==0 {old:=ax_trained();gap:=0.0;for i:0..<664 {d:=abs(p[i]-old[i]);if d>gap {gap=d;}}print("// Native/compile-time chapter 119 maximum weight difference: %\n",gap);}
        print("[664]u64.[");for i:0..<664 {if i>0 {print(",");}print("%",f64_bits(p[i]));}print("]");
        if seed!=123 || mode!=1 {print(",");}print("\n");
    }}print("];\n");return 0;
}

// Preparation only; routine library checks never retrain.
// Routine replay reads saved weights.
ws_train :: (seed:u64,hinted:f64)->[664]f64 {
    p:[664]f64;initialized:=td_init(AX_SHAPE,CrSeed.{seed=seed},p[..]);#assert initialized.counter==664;
    m:[664]f64;v:[664]f64;total:[664]f64;clear:[664]f64;state:AwState;none:[1]f32;
    group:=[1]AwGroup.[AwGroup.{first=0,count=664,lr=AX_RATE,beta1=0.9,beta2=0.99,eps=0.00000001,decay=0}];
    for step:0..<AX_STEPS {
        total=clear;
        for a:1..<7 {loss:=ax_term(p[..],ax_sequence(a,a+6),hinted/6,total[..]);loss=ax_term(p[..],ax_sequence(a,13),(1-hinted)/6,total[..]);}
        update:=aw_step(group[..],AwPolicy.{},state,p[..],total[..],m[..],v[..],none[0..<0],false);#assert update.status==AwStatus.ok;state=update.state;
    }return p;
}
