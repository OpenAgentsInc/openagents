// Chapter 59: the Wasm module's Coax entry. The page's state is one struct in
// the module's memory (Coax has no heap); face.c holds it and the downloaded
// bytes, and calls these procedures. Search refuses until bb_load admits.
#load "../../lib/book-search/browser.coax";

BSW_VOCAB :: 16384;
BSW_FILES :: 1024;
BSW_PASSAGES :: 16384;
BSW_TERMS :: 1048576;
BSW_HEADS :: 2097152;
BSW_NAMES :: 131072;

BswState :: struct {
  verdict: int; admitted: bool;
  table: [BSW_VOCAB * BE_WIDTH] f64; query: [BE_WIDTH] f64;
  slots: [4 * BSW_VOCAB] int; vpool: [1048576] u8; vfrom: [BSW_VOCAB] int; vsize: [BSW_VOCAB] int; vcount: [BSW_VOCAB] int; vocab: [1] BsVocab;
  names: [BSW_NAMES] u8; path_from: [BSW_FILES] int; path_to: [BSW_FILES] int; hashes: [BSW_FILES * 32] u8; status: [BSW_FILES] int; book: [BSW_FILES] int;
  heads: [BSW_HEADS] u8; passages: [BSW_PASSAGES] BsPassage; length: [BSW_PASSAGES] int; tf: [BSW_PASSAGES] int; tt: [BSW_PASSAGES] int;
  df: [BSW_VOCAB] int; terms: [BSW_TERMS] int; counts: [BSW_TERMS] int; embeddings: [BSW_PASSAGES * BE_WIDTH] f32;
  scores: [BSW_PASSAGES] f64; result: [1] BbResult; store: [1] BbStore;
}

bsw_init :: (w: [] BswState) #export_c {
  w[0].vocab[0] = BsVocab.{slots = w[0].slots[..], pool = w[0].vpool[..], from = w[0].vfrom[..], size = w[0].vsize[..], count = w[0].vcount[..]};
  w[0].store[0] = BbStore.{table = w[0].table[..], query = w[0].query[..], vocab = w[0].vocab[..], names = w[0].names[..], path_from = w[0].path_from[..],
    path_to = w[0].path_to[..], hashes = w[0].hashes[..], status = w[0].status[..], book = w[0].book[..], heads = w[0].heads[..], passages = w[0].passages[..],
    length = w[0].length[..], tf = w[0].tf[..], tt = w[0].tt[..], df = w[0].df[..], terms = w[0].terms[..], counts = w[0].counts[..], embeddings = w[0].embeddings[..]};
  bs_vocab_clear(w[0].vocab[..]);
  w[0].admitted = false; w[0].verdict = -1;
}
// The verdict as a number (BbVerdict); 0 is admitted.
bsw_load :: (w: [] BswState, manifest: [] u8, encoder: [] u8, index: [] u8) -> int #export_c {
  w[0].admitted = false;
  v := bb_load(manifest, encoder, index, w[0].store[..]);
  w[0].verdict = cast(int) v; w[0].admitted = v == BbVerdict.admitted;
  return w[0].verdict;
}
// The verdict's text into out; its length.
bsw_message :: (w: [] BswState, out: [] u8) -> int #export_c {
  b := [1] BbW.[BbW.{buf = out}];
  if w[0].verdict < 0 { bb_text(b[..], "nothing loaded"); } else { bb_text(b[..], bb_verdict_text(cast(BbVerdict) w[0].verdict)); }
  return b[0].n;
}
// Every query of a query file, one result line each, into out; the bytes
// written, or -1 when nothing was admitted or out is too small.
bsw_queries :: (w: [] BswState, file: [] u8, out: [] u8) -> int #export_c {
  if !w[0].admitted { return -1; }
  b := [1] BbW.[BbW.{buf = out}];
  n := bb_queries(w[0].store[0], cast(string) file, w[0].scores[..], w[0].result[..], b[..]);
  return ifx b[0].full then -1 else b[0].n;
}
// One query, shown as text: the fused top k with book, file, heading path
// and status, into out; the bytes written, or -1.
bsw_search :: (w: [] BswState, text: [] u8, k: int, out: [] u8) -> int #export_c {
  if !w[0].admitted { return -1; }
  b := [1] BbW.[BbW.{buf = out}];
  s := w[0].store[0];
  bb_search(s, cast(string) text, w[0].scores[..], w[0].result[..]);
  r := w[0].result[0];
  bb_decimal(b[..], r.known); bb_text(b[..], " of "); bb_decimal(b[..], r.words); bb_text(b[..], " words known\n");
  top := ifx r.fn < k then r.fn else k;
  for i: 0..<top {
    p := r.fused[i].passage; f := s.passages[p].file;
    status := bs_section_status(cast(BsStatus) s.status[f], bb_heads(s, p));
    bb_decimal(b[..], i + 1); bb_text(b[..], ". "); bb_text(b[..], bs_book_name(s.book[f])); bb_text(b[..], " · ");
    bb_text(b[..], bb_path(s, f)); bb_text(b[..], " · "); bb_text(b[..], bb_heads(s, p));
    bb_text(b[..], " ["); bb_text(b[..], bs_status_label(status)); bb_text(b[..], "]\n");
  }
  return ifx b[0].full then -1 else b[0].n;
}
bsw_counts :: (w: [] BswState, what: int) -> int #export_c {
  if what == 0 { return w[0].store[0].passage_n; }
  if what == 1 { return w[0].store[0].words; }
  return w[0].store[0].file_n;
}
