// SRD 5.2.1 Rules Glossary Search, Study, Influence and Utilize [Action], Friendly/Hostile/
// Indifferent [Attitude], Lightly Obscured, and Charmed's Social Advantage. Each spends the
// action; the world says what is being looked for, studied or urged (its DC, the monster's
// willingness and attitude, whether it understands, whether an object needs an action).
#authority;

IN_HESITANT :: 0; IN_WILLING :: 1; IN_UNWILLING :: 2;
AT_INDIFFERENT :: 0; AT_FRIENDLY :: 1; AT_HOSTILE :: 2;
RS_INFLUENCE_WAIT :: 86400 * RS_TICKS;   // 24 hours before urging it the same way again

// Search: a Wisdom check with Insight, Medicine, Perception or Survival against the world's `dc`.
// With Perception it also finds every hidden enemy whose Hide total the check meets; the check
// relies on sight (a Blinded searcher fails it) and has Disadvantage when each hidden enemy sought
// stands Lightly Obscured.
rs_search :: (b: [] RsBattle, i: int, skill: int, dc: int) -> RsAbilityResult #effects(all) {
  r: RsAbilityResult;
  if !rs_action_free(b, i) || !(skill == SK_INSIGHT || skill == SK_MEDICINE || skill == SK_PERCEPTION || skill == SK_SURVIVAL) { return r; }
  q := RsAbilityRequest.{ability = RS_WIS, skill = skill, dc = dc};
  if skill == SK_PERCEPTION {
    q.sight = true;
    sought := 0; light := 0;
    for k: 0..<b[0].n { if k != i && b[0].c[k].team != b[0].c[i].team && rs_hidden_at(b[0].c[k]) >= 0 { sought += 1; if rs_obscured(b, k) == 1 { light += 1; } } }
    q.disadvantage = sought > 0 && light == sought;
  }
  b[0].turn.action = true;
  r = rs_ability_check(b, i, q);
  found := false;
  if skill == SK_PERCEPTION && r.accepted {
    for k: 0..<b[0].n {
      h := rs_hidden_at(b[0].c[k]);
      if k != i && b[0].c[k].team != b[0].c[i].team && h >= 0 && !r.automatic && r.total >= b[0].c[k].eff[h].dc { rs_unhide(b, k); found = true; }
    }
  }
  rs_say(b, RS_EV_CONDITION, i, i, r.total, ifx found then " searches and finds someone hidden" else " searches");
  return r;
}
// Study: an Intelligence check with Arcana, History, Investigation, Nature or Religion against `dc`.
rs_study :: (b: [] RsBattle, i: int, skill: int, dc: int) -> RsAbilityResult #effects(all) {
  r: RsAbilityResult;
  if !rs_action_free(b, i) || !(skill == SK_ARCANA || skill == SK_HISTORY || skill == SK_INVESTIGATION || skill == SK_NATURE || skill == SK_RELIGION) { return r; }
  b[0].turn.action = true;
  r = rs_ability_check(b, i, RsAbilityRequest.{ability = RS_INT, skill = skill, dc = dc});
  rs_say(b, RS_EV_CONDITION, i, i, r.total, " studies");
  return r;
}
// The wait a failed Influence leaves on j for urging it with `skill`, or -1.
rs_influence_wait :: (b: [] RsBattle, i: int, j: int, skill: int) -> int #effects(all) {
  for k: 0..<RS_EFFECTS { e := b[0].c[j].eff[k]; if e.kind == EF_INFLUENCED && e.by == i && e.cond == skill && e.until > b[0].clock { return k; } }
  return -1;
}
// Influence i urges monster j: Willing complies with no check, Unwilling refuses with none; a
// Hesitant one takes the check its interaction names (Charisma with Deception, Intimidation,
// Performance or Persuasion; Wisdom with Animal Handling) against 15 or its Intelligence score,
// whichever is higher. Friendly gives Advantage, Hostile Disadvantage, and its charmer has
// Advantage. Deceiving and persuading need a monster that understands. A failure means 24 hours
// before urging it the same way again. `passed`: it complies.
rs_influence :: (b: [] RsBattle, i: int, j: int, skill: int, willing: int, attitude: int, understands: bool) -> RsAbilityResult #effects(all) {
  r: RsAbilityResult;
  if !rs_action_free(b, i) || j < 0 || j >= b[0].n || j == i || b[0].c[j].dead || willing < IN_HESITANT || willing > IN_UNWILLING || attitude < AT_INDIFFERENT || attitude > AT_HOSTILE { return r; }
  if !(skill == SK_DECEPTION || skill == SK_INTIMIDATION || skill == SK_PERFORMANCE || skill == SK_PERSUASION || skill == SK_ANIMAL) { return r; }
  if (skill == SK_DECEPTION || skill == SK_PERSUASION) && !understands { return r; }
  if rs_influence_wait(b, i, j, skill) >= 0 { return r; }
  if willing == IN_HESITANT && rs_effect_free(b[0].c[j]) == 0 { return r; }
  b[0].turn.action = true;
  if willing != IN_HESITANT {
    r.accepted = true; r.automatic = true; r.passed = willing == IN_WILLING;
  } else {
    q := RsAbilityRequest.{ability = ifx skill == SK_ANIMAL then RS_WIS else RS_CHA, skill = skill, dc = rs_max(15, b[0].c[j].score[RS_INT])};
    q.advantage = attitude == AT_FRIENDLY || rs_charmed_by(b[0].c[j], i);
    q.disadvantage = attitude == AT_HOSTILE;
    r = rs_ability_check(b, i, q);
    if !r.passed { _ := rs_put_effect(b, j, RsEffect.{kind = EF_INFLUENCED, cond = skill, by = i, spell = -1, until = b[0].clock + RS_INFLUENCE_WAIT, save = -1, dc = 0}); }
  }
  rs_say(b, RS_EV_CONDITION, i, j, r.total, ifx r.passed then " urges a monster, and it complies" else " urges a monster, and it refuses");
  return r;
}
// Utilize: an object that needs an action to use (the world's `needs_action`): the action spent.
rs_utilize :: (b: [] RsBattle, i: int, needs_action: bool) -> bool #effects(all) {
  if !needs_action || !rs_action_free(b, i) { return false; }
  b[0].turn.action = true;
  rs_say(b, RS_EV_CONDITION, i, i, 0, " uses an object");
  return true;
}

#test "Search takes the action with a Wisdom skill it names; Perception finds every hidden enemy it meets" {
  for skill: -1..<RS_SKILLS + 1 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]);
    ok := skill == SK_INSIGHT || skill == SK_MEDICINE || skill == SK_PERCEPTION || skill == SK_SURVIVAL;
    r := rs_search(b[..], 0, skill, 11);
    #assert r.accepted == ok && b[0].turn.action == ok;
    if ok { #assert r.total == 11 && r.passed && r.ability == RS_WIS; }
  }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); act_hide(b[..], 1, 11); act_hide(b[..], 2, 5);
  _ := rs_add(b[..], rs_wizard("Deep", 1, 3), 7, 1); act_hide(b[..], 3, 12);
  r := rs_search(b[..], 0, SK_PERCEPTION, 30);
  #assert r.total == 11 && !r.passed && rs_hidden_at(b[0].c[1]) < 0 && rs_hidden_at(b[0].c[3]) >= 0 && rs_hidden_at(b[0].c[2]) >= 0;   // an ally stays hidden
  #assert !rs_search(b[..], 0, SK_PERCEPTION, 10).accepted;   // the action is spent
  s: [1] RsBattle; s_room: [1] RsRoom; rs_have(s[..], s_room[..]); act_field(s[..]); act_hide(s[..], 1, 11); q := rs_search(s[..], 0, SK_INSIGHT, 5); #assert q.passed; #assert rs_hidden_at(s[0].c[1]) >= 0;   // only Perception finds
  n: [1] RsBattle; n_room: [1] RsRoom; rs_have(n[..], n_room[..]); act_field(n[..]); act_hide(n[..], 1, 3); n[0].c[0].cond |= RS_BLINDED; r = rs_search(n[..], 0, SK_PERCEPTION, 3);
  #assert r.accepted && r.automatic && !r.passed && rs_hidden_at(n[0].c[1]) >= 0;
  o: [1] RsBattle; o_room: [1] RsRoom; rs_have(o[..], o_room[..]); act_field(o[..]); act_hide(o[..], 0, 3); r = rs_search(o[..], 0, SK_PERCEPTION, 3); #assert rs_hidden_at(o[0].c[0]) >= 0;   // never itself
  w: [1] RsBattle; w_room: [1] RsRoom; rs_have(w[..], w_room[..]); act_field(w[..]); w[0].who = 1; #assert !rs_search(w[..], 0, SK_PERCEPTION, 3).accepted;
}
#test "searching for enemies all Lightly Obscured has Disadvantage; one in the open does not" {
  for mode: 0..<4 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); b[0].dice[0].fixed = false; b[0].dice[0].state = 7;
    act_hide(b[..], 1, 30);
    if mode >= 1 { _ := rs_terrain_put(b[..], TR_LIGHT, 5, 1, 5, 1); }
    if mode == 2 { _ := rs_add(b[..], rs_wizard("Open", 1, 3), 8, 1); act_hide(b[..], 3, 30); }
    if mode == 3 { rs_unhide(b[..], 1); }
    r := rs_search(b[..], 0, SK_PERCEPTION, 30);
    #assert r.edge == (ifx mode == 1 then -1 else 0);
  }
}
#test "Study is an Intelligence check with a knowledge skill, spending the action" {
  for skill: -1..<RS_SKILLS + 1 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]);
    ok := skill == SK_ARCANA || skill == SK_HISTORY || skill == SK_INVESTIGATION || skill == SK_NATURE || skill == SK_RELIGION;
    r := rs_study(b[..], 0, skill, 10);
    #assert r.accepted == ok && b[0].turn.action == ok;
    if ok { #assert r.total == 10 && r.passed && r.ability == RS_INT; }
  }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); b[0].turn.action = true; #assert !rs_study(b[..], 0, SK_ARCANA, 10).accepted;
}
#test "Influence: willing complies and unwilling refuses with no check; hesitant checks against 15 or Intelligence" {
  for mode: 0..<8 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]);
    willing := IN_HESITANT; skill := SK_PERSUASION; attitude := AT_INDIFFERENT;
    if mode == 0 { willing = IN_WILLING; } else if mode == 1 { willing = IN_UNWILLING; } else if mode == 3 { b[0].c[1].score[RS_INT] = 16; }
    else if mode == 4 { b[0].c[0].score[RS_CHA] = 20; } else if mode == 5 { skill = SK_ANIMAL; b[0].c[0].score[RS_WIS] = 20; } else if mode == 6 { skill = SK_ANIMAL; }
    else if mode == 7 { b[0].c[0].score[RS_CHA] = 20; b[0].c[1].score[RS_INT] = 18; }
    r := rs_influence(b[..], 0, 1, skill, willing, attitude, true);
    passed := mode == 0 || mode == 4 || mode == 5;
    #assert r.accepted && b[0].turn.action && r.passed == passed && r.automatic == (mode <= 1);
    if mode >= 2 { #assert r.total == 10 + rs_mod(ifx skill == SK_ANIMAL then b[0].c[0].score[RS_WIS] else b[0].c[0].score[RS_CHA]); }
    #assert (rs_influence_wait(b[..], 0, 1, skill) >= 0) == (mode >= 2 && !passed);
  }
}
#test "attitude and charm set the edge; a failure waits 24 hours for the same urging only" {
  for mode: 0..<4 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); b[0].dice[0].fixed = false; b[0].dice[0].state = 3;
    attitude := ifx mode == 1 then AT_FRIENDLY else ifx mode == 2 then AT_HOSTILE else AT_INDIFFERENT;
    if mode == 3 { _ := rs_put_effect(b[..], 1, RsEffect.{kind = EF_COND, cond = RS_CHARMED, by = 0, spell = -1, until = RS_NO_END, save = -1}); }
    r := rs_influence(b[..], 0, 1, SK_INTIMIDATION, IN_HESITANT, attitude, false);
    #assert r.accepted && r.edge == (ifx mode == 1 || mode == 3 then 1 else ifx mode == 2 then -1 else 0);
  }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]);
  #assert !rs_influence(b[..], 0, 1, SK_INTIMIDATION, IN_HESITANT, AT_HOSTILE, true).passed && rs_influence_wait(b[..], 0, 1, SK_INTIMIDATION) >= 0;
  rs_fresh(b[..], 0); #assert !rs_influence(b[..], 0, 1, SK_INTIMIDATION, IN_WILLING, AT_INDIFFERENT, true).accepted && !b[0].turn.action;
  #assert rs_influence(b[..], 0, 1, SK_PERFORMANCE, IN_HESITANT, AT_INDIFFERENT, true).accepted;
  rs_fresh(b[..], 2); #assert rs_influence(b[..], 2, 1, SK_INTIMIDATION, IN_UNWILLING, AT_INDIFFERENT, true).accepted;   // another urger may
  b[0].clock += RS_INFLUENCE_WAIT; rs_fresh(b[..], 0); #assert rs_influence_wait(b[..], 0, 1, SK_INTIMIDATION) < 0 && rs_influence(b[..], 0, 1, SK_INTIMIDATION, IN_UNWILLING, AT_INDIFFERENT, true).accepted;
}
#test "Influence refuses, spending nothing, a malformed request, a monster that can't understand, or no room" {
  for mode: 1..<14 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]);
    j := 1; skill := SK_PERSUASION; willing := IN_HESITANT; attitude := AT_INDIFFERENT; understands := true;
    if mode == 1 { j = 0; } else if mode == 2 { j = -1; } else if mode == 3 { j = 3; } else if mode == 4 { b[0].c[1].dead = true; } else if mode == 5 { skill = SK_STEALTH; }
    else if mode == 6 { willing = 3; } else if mode == 7 { willing = -1; } else if mode == 8 { attitude = 3; } else if mode == 9 { attitude = -1; }
    else if mode == 10 { understands = false; } else if mode == 11 { skill = SK_DECEPTION; understands = false; } else if mode == 12 { for k: 0..<RS_EFFECTS { b[0].c[1].eff[k].kind = EF_BLESS; } }
    else if mode == 13 { b[0].turn.action = true; }
    #assert !rs_influence(b[..], 0, j, skill, willing, attitude, understands).accepted && b[0].turn.action == (mode == 13);
  }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); for k: 0..<RS_EFFECTS { b[0].c[1].eff[k].kind = EF_BLESS; }
  #assert rs_influence(b[..], 0, 1, SK_INTIMIDATION, IN_WILLING, AT_INDIFFERENT, false).passed;   // no record needed
  c: [1] RsBattle; c_room: [1] RsRoom; rs_have(c[..], c_room[..]); act_field(c[..]); #assert rs_influence(c[..], 0, 1, SK_INTIMIDATION, IN_HESITANT, AT_INDIFFERENT, false).accepted;
  #assert rs_influence(c[..], 0, 1, SK_PERFORMANCE, IN_HESITANT, AT_INDIFFERENT, false).accepted == false;   // action spent
}
#test "Utilize spends the action only for an object that needs one" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]);
  #assert !rs_utilize(b[..], 0, false) && !b[0].turn.action && rs_utilize(b[..], 0, true) && b[0].turn.action && !rs_utilize(b[..], 0, true);
}
#test "each action tells what it did" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); act_hide(b[..], 1, 11);
  r := rs_search(b[..], 0, SK_PERCEPTION, 30);
  #assert act_last(b[..]).kind == RS_EV_CONDITION && act_last(b[..]).by.value == 0 && act_last(b[..]).amount == r.total && act_said(b[..], "Seeker searches and finds someone hidden");
  s: [1] RsBattle; s_room: [1] RsRoom; rs_have(s[..], s_room[..]); act_field(s[..]); act_hide(s[..], 1, 12); r = rs_search(s[..], 0, SK_PERCEPTION, 30);
  #assert act_last(s[..]).kind == RS_EV_CONDITION && act_said(s[..], "Seeker searches");
  t: [1] RsBattle; t_room: [1] RsRoom; rs_have(t[..], t_room[..]); act_field(t[..]); r = rs_study(t[..], 0, SK_ARCANA, 10);
  #assert act_last(t[..]).kind == RS_EV_CONDITION && act_last(t[..]).amount == r.total && act_said(t[..], "Seeker studies");
  u: [1] RsBattle; u_room: [1] RsRoom; rs_have(u[..], u_room[..]); act_field(u[..]); act_hide(u[..], 1, 3); #assert rs_utilize(u[..], 0, true);
  #assert act_last(u[..]).kind == RS_EV_CONDITION && act_last(u[..]).amount == 0 && act_said(u[..], "Seeker uses an object");
  for willing: 1..<3 {
    v: [1] RsBattle; v_room: [1] RsRoom; rs_have(v[..], v_room[..]); act_field(v[..]); u_r := rs_influence(v[..], 0, 1, SK_PERSUASION, willing, AT_INDIFFERENT, true); #assert u_r.accepted;
    e := act_last(v[..]);
    #assert e.kind == RS_EV_CONDITION && e.by.value == 0 && e.to.value == 1 && act_said(v[..], ifx willing == IN_WILLING then "Seeker urges a monster, and it complies" else "Seeker urges a monster, and it refuses");
  }
}
#test "Search counts and finds enemies from creature 0 on, never allies" {
  for mode: 0..<2 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); b[0].dice[0].fixed = false; b[0].dice[0].state = 7;
    rs_fresh(b[..], 1); act_hide(b[..], 0, 30);
    _ := rs_terrain_put(b[..], TR_LIGHT, 1, 1, 1, 1);
    if mode == 1 { ally := rs_add(b[..], rs_wizard("Ally", 1, 3), 8, 4); act_hide(b[..], ally, 30); }   // hidden in the open, on the searcher's side
    #assert rs_search(b[..], 1, SK_PERCEPTION, 30).edge == -1;
  }
  f: [1] RsBattle; f_room: [1] RsRoom; rs_have(f[..], f_room[..]); act_field(f[..]); rs_fresh(f[..], 1); act_hide(f[..], 0, 5);
  #assert rs_search(f[..], 1, SK_PERCEPTION, 30).accepted && rs_hidden_at(f[0].c[0]) < 0 && act_said(f[..], "Quarry searches and finds someone hidden");
}
#test "Influence may urge creature 0, by Deception when it understands; a failure's record is plain" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); act_field(b[..]); rs_fresh(b[..], 2);
  #assert rs_influence(b[..], 2, 0, SK_DECEPTION, IN_HESITANT, AT_INDIFFERENT, true).accepted;
  h: [1] RsBattle; h_room: [1] RsRoom; rs_have(h[..], h_room[..]); act_field(h[..]); #assert !rs_influence(h[..], 0, 1, SK_HISTORY, IN_HESITANT, AT_INDIFFERENT, true).accepted && !h[0].turn.action;
  f: [1] RsBattle; f_room: [1] RsRoom; rs_have(f[..], f_room[..]); act_field(f[..]); #assert !rs_influence(f[..], 0, 1, SK_INTIMIDATION, IN_HESITANT, AT_HOSTILE, true).passed;
  e := f[0].c[1].eff[rs_influence_wait(f[..], 0, 1, SK_INTIMIDATION)];
  #assert e.spell == -1 && e.save == -1 && e.dc == 0 && e.cond == SK_INTIMIDATION;
}
