// A character's lasting effects carried between zone owners and across a restart (#13282), beside
// its rest (rest-carry.coax). A capture holds each effect record as eight numbers that name nothing
// of the world it left: its source is "the character itself" or "nobody here", and its end is the
// ticks left on the battle's clock, not a tick of that clock. The spell the character concentrates
// on goes with them when one of its own carried records is that spell's.
//
// What does not carry is what belongs to the world left behind: a zone's hold, a readied response,
// a helper's distraction, a command still to obey, natural sleep (the rest's own, rest-carry.coax)
// and a failed Influence (its urger stays). A record whose clock has already run out is over.
//
// The other side lays the numbers on a fresh body against its own clock, all or none.
#authority;
RS_AURA_CARRY :: 8;                                 // numbers a carried record
RS_AURAS_HEAD :: 2;                                 // 1 + the spell it concentrates on (0 none), and that spell's ticks left
RS_AURAS_CARRY :: RS_AURAS_HEAD + RS_EFFECTS * RS_AURA_CARRY;
RS_AURA_LEFT :: 2592000000000;                      // ticks: thirty days, the longest a carried clock runs
RS_AURA_SPELL :: 1000;                              // 1 + the greatest spell number a record names
// A record's fields, each 0 to its high: the Aura's kind (EF_*); its cond; 1 when the character is
// its own source; 1 + its spell (0 none); its ticks left (0: no clock ends it); 1 + the save it
// repeats (0 none); that save's DC; 1 when the character's own turn's end ends it.
RS_AURA_HIGH :: [8] int.[40, 2147483647, 1, RS_AURA_SPELL, RS_AURA_LEFT, 6, 99, 1];
rs_aura_field :: (q: int, n: int) -> bool #effects(all) { return q >= 0 && q < RS_AURA_CARRY && n >= 0 && n <= RS_AURA_HIGH[q]; }
// Whether an Aura of this kind goes with its bearer.
rs_aura_carried :: (kind: int) -> bool #effects(all) {
  if kind <= EF_NONE || kind > EF_INSPIRED || kind == 14 { return false; }
  if kind == EF_ZONE_RESTRAIN || kind == EF_READY || kind == EF_HELP_CHECK || kind == EF_HELP_ATTACK { return false; }
  if kind == EF_HALT || kind == EF_HALT_PENDING || kind == EF_REST_SLEEP || kind == EF_INFLUENCED { return false; }
  return true;
}
// The ticks a deadline has left at `now`, as carried: 0 for one no clock reaches, at most RS_AURA_LEFT.
rs_aura_left :: (until: int, now: int) -> int #effects(all) {
  if until >= RS_NO_END { return 0; }
  return rs_min(until - now, RS_AURA_LEFT);
}
// The deadline a carried count of ticks is on a clock at `now`.
rs_aura_until :: (left: int, now: int) -> int #effects(all) { return ifx left == 0 then RS_NO_END else now + left; }
// Effect e of creature `self` as carried numbers at `now`; kind 0 (all zero) when it does not carry.
rs_aura_row :: (e: RsEffect, self: int, now: int) -> [RS_AURA_CARRY] int #effects(all) {
  none: [RS_AURA_CARRY] int;
  if !rs_aura_carried(e.kind) || e.until <= now { return none; }
  r := [8] int.[e.kind, e.cond, ifx e.by == self then 1 else 0, e.spell + 1, rs_aura_left(e.until, now), e.save + 1, e.dc, ifx e.turn_end == self + 1 then 1 else 0];
  for q: 1..<RS_AURA_CARRY { if !rs_aura_field(q, r[q]) { return none; } }   // its kind is rs_aura_carried's to judge
  return r;
}
// Creature i's lasting effects and Concentration as carried numbers, against battle b's clock: the
// head, then a record of eight for each effect that carries. The count of numbers written (0: no
// such creature, or no room for RS_AURAS_CARRY).
rs_auras_out :: (b: [] RsBattle, i: int, out: [] int) -> int #effects(all) {
  if i < 0 || i >= b[0].n || out.count < RS_AURAS_CARRY { return 0; }
  c := b[0].c[i]; now := b[0].clock; n := RS_AURAS_HEAD; held := false;
  for k: 0..<RS_EFFECTS {
    e := c.eff[k]; r := rs_aura_row(e, i, now);
    if r[0] == EF_NONE { continue; }
    for q: 0..<RS_AURA_CARRY { out[n + q] = r[q]; }
    n += RS_AURA_CARRY;
    if e.by == i && e.spell == c.conc { held = true; }
  }
  out[0] = 0; out[1] = 0;
  if held && c.conc >= 0 && c.conc_until > now { out[0] = c.conc + 1; out[1] = rs_aura_left(c.conc_until, now); }
  return n;
}
// Lay carried effects `in` (as rs_auras_out wrote them) on creature i of battle b, all or none.
// Refused: a count that is not a head and whole records, a number out of its range, a kind that does
// not carry, more records than the body has room for (rs_effect_add refuses the one too many), or a Concentration none of its records is held by.
rs_auras_in :: (b: [] RsBattle, i: int, in: [] int) -> bool #effects(all) {
  switch rs_auras_atomic(b, i, in) { case none { return false; } case some(ok) { return ok; } }
}
rs_auras_atomic :: (b: [] RsBattle, i: int, in: [] int) -> bool? #effects(all) {
  #transaction {
    if !rs_auras_apply(b, i, in) { return null; }
  }
  return some(true);
}
rs_auras_apply :: (b: [] RsBattle, i: int, in: [] int) -> bool #effects(all) {
  if i < 0 || i >= b[0].n || in.count < RS_AURAS_HEAD { return false; }
  if (in.count - RS_AURAS_HEAD) % RS_AURA_CARRY != 0 { return false; }
  // (the spell's own range is its record's: a Concentration must be one of the records' spells, below)
  if in[1] < 0 || in[1] > RS_AURA_LEFT || (in[0] == 0 && in[1] != 0) { return false; }
  now := b[0].clock; c := b[0].c[i..<i + 1]; held := false;
  at := RS_AURAS_HEAD;
  while at < in.count {
    if !rs_aura_carried(in[at]) { return false; }
    for q: 1..<RS_AURA_CARRY { if !rs_aura_field(q, in[at + q]) { return false; } }
    e := RsEffect.{kind = in[at], cond = in[at + 1], by = ifx in[at + 2] == 1 then i else -1, spell = in[at + 3] - 1, until = rs_aura_until(in[at + 4], now), save = in[at + 5] - 1, dc = in[at + 6], turn_end = ifx in[at + 7] == 1 then i + 1 else 0};
    if !rs_effect_add(c, e) { return false; }
    if in[at + 2] == 1 && in[at + 3] == in[0] { held = true; }
    at += RS_AURA_CARRY;
  }
  if in[0] == 0 { return true; }
  if !held { return false; }
  c[0].conc = in[0] - 1; c[0].conc_until = rs_aura_until(in[1], now);
  return true;
}

#test "aura carry: a poisoned, hexed, raging creature arrives in a new battle with the same effects and the ticks they had left" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; b[0].c = c[..]; b[0].n = 2; b[0].who = -1; b[0].clock = 5000000;
  c[0] = rs_fighter("Carried", 0, 3); c[1] = rs_fighter("Other", 1, 3);
  #assert rs_effect_add(c[0..<1], RsEffect.{kind = EF_COND, cond = RS_POISONED, by = 1, spell = 7, until = 5000000 + 42000000, save = RS_CON, dc = 13, turn_end = 2});
  #assert rs_effect_add(c[0..<1], RsEffect.{kind = EF_HEX, cond = 3, by = 0, spell = SP_HEX, until = 5000000 + 3600000000, save = -1, dc = 0, turn_end = 1});
  c[0].eff = rs_state_put(c[0].eff, EF_RAGE, true); c[0].conc = SP_HEX; c[0].conc_until = 5000000 + 3600000000;
  w: [RS_AURAS_CARRY] int; n := rs_auras_out(b[..], 0, w[..]);
  #assert n == RS_AURAS_HEAD + 3 * RS_AURA_CARRY && w[0] == SP_HEX + 1 && w[1] == 3600000000;
  want := [24] int.[EF_COND, RS_POISONED, 0, 8, 42000000, RS_CON + 1, 13, 0,  EF_HEX, 3, 1, SP_HEX + 1, 3600000000, 0, 0, 1,  EF_RAGE, 0, 0, 0, 0, 0, 0, 0];
  // the state Aura sits in the list's last place, so it is the third record out
  for q: 0..<24 { #assert w[RS_AURAS_HEAD + q] == want[q]; }
  d: [1] RsBattle; d_room: [1] RsRoom; rs_have(d[..], d_room[..]); f: [4] RsCreature; d[0].c = f[..]; d[0].n = 4; d[0].who = -1; d[0].clock = 900;
  f[3] = rs_fighter("Carried", 0, 3); f[3].conc = -1;
  #assert rs_auras_in(d[..], 3, w[0..<n]);
  #assert (f[3].cond & RS_POISONED) != 0 && rs_effect(f[3], EF_HEX) && rs_effect(f[3], EF_RAGE) && f[3].conc == SP_HEX && f[3].conc_until == 900 + 3600000000;
  p := f[3].eff[0]; h := f[3].eff[1]; g := f[3].eff[2];
  #assert p.kind == EF_COND && p.cond == RS_POISONED && p.by == -1 && p.spell == 7 && p.until == 900 + 42000000 && p.save == RS_CON && p.dc == 13 && p.turn_end == 0;
  #assert h.kind == EF_HEX && h.cond == 3 && h.by == 3 && h.spell == SP_HEX && h.until == 900 + 3600000000 && h.save == -1 && h.turn_end == 4;
  #assert g.kind == EF_RAGE && g.by == -1 && g.spell == -1 && g.until == RS_NO_END && g.save == -1 && f[3].eff[3].kind == EF_NONE;
  // carried again from there, the numbers are the same: nothing is lost or doubled by a second crossing
  w2: [RS_AURAS_CARRY] int; n2 := rs_auras_out(d[..], 3, w2[..]); #assert n2 == n; for q: 0..<n { #assert w2[q] == w[q]; }
}
#test "aura carry: what belongs to the world left behind, and what is over, stays there" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [1] RsCreature; b[0].c = c[..]; b[0].n = 1; b[0].who = -1; b[0].clock = 100;
  c[0] = rs_fighter("Leaver", 0, 3); c[0].restrained_by = -1; c[0].conc = -1;
  for kind: 0..<48 {
    stays := kind <= 0 || kind > 40 || kind == 14 || kind == EF_HALT || kind == EF_ZONE_RESTRAIN || kind == EF_HALT_PENDING || kind == EF_HELP_CHECK || kind == EF_HELP_ATTACK || kind == EF_REST_SLEEP || kind == EF_READY || kind == EF_INFLUENCED;
    #assert rs_aura_carried(kind) == !stays;
    e := RsEffect.{kind = kind, by = 0, spell = -1, until = 101, save = -1};
    r0 := rs_aura_row(e, 0, 100); #assert r0[0] == (ifx stays then 0 else kind); #assert stays || r0[4] == 1;
    e.until = 100; r0 = rs_aura_row(e, 0, 100); #assert r0[0] == 0;   // its clock has run out
  }
  #assert !rs_aura_carried(-1) && EF_INSPIRED == 40 && RS_AURA_HIGH[0] == EF_INSPIRED;
  // a number out of its range keeps its record here
  ok := RsEffect.{kind = EF_WEAK, cond = 2147483647, by = 0, spell = RS_AURA_SPELL - 1, until = 200, save = 5, dc = 99, turn_end = 1};
  r := rs_aura_row(ok, 0, 100); #assert r[0] == EF_WEAK && r[1] == 2147483647 && r[2] == 1 && r[3] == RS_AURA_SPELL && r[4] == 100 && r[5] == 6 && r[6] == 99 && r[7] == 1;
  bad := ok; bad.cond = 2147483648; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0; bad.cond = -1; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0;
  bad = ok; bad.spell = RS_AURA_SPELL; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0; bad.spell = -2; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0;
  bad = ok; bad.save = 6; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0; bad.save = -2; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0;
  bad = ok; bad.dc = 100; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0; bad.dc = -1; r = rs_aura_row(bad, 0, 100); #assert r[0] == 0;
  // another creature's turn's end becomes the clock's end, at the same tick; another's source is nobody
  far := ok; far.turn_end = 2; far.by = 1; r = rs_aura_row(far, 0, 100); #assert r[0] == EF_WEAK && r[7] == 0 && r[2] == 0;
  far.turn_end = 0; r = rs_aura_row(far, 0, 100); #assert r[7] == 0;
  // the clock: none, a tick, and the thirty-day cap
  #assert rs_aura_left(RS_NO_END, 5) == 0 && rs_aura_left(RS_NO_END + 1, 5) == 0 && rs_aura_left(RS_NO_END - 1, RS_NO_END - 3) == 2 && rs_aura_left(6, 5) == 1;
  #assert rs_aura_left(5 + RS_AURA_LEFT, 5) == RS_AURA_LEFT && rs_aura_left(6 + RS_AURA_LEFT, 5) == RS_AURA_LEFT && rs_aura_left(4 + RS_AURA_LEFT, 5) == RS_AURA_LEFT - 1;
  #assert rs_aura_until(0, 7) == RS_NO_END && rs_aura_until(1, 7) == 8 && rs_aura_until(RS_AURA_LEFT, 7) == 7 + RS_AURA_LEFT;
  for q: 0..<RS_AURA_CARRY { #assert rs_aura_field(q, 0) && rs_aura_field(q, RS_AURA_HIGH[q]) && !rs_aura_field(q, -1) && !rs_aura_field(q, RS_AURA_HIGH[q] + 1); }
  #assert !rs_aura_field(-1, 0) && !rs_aura_field(RS_AURA_CARRY, 0) && RS_AURA_CARRY == 8 && RS_AURAS_HEAD == 2 && RS_AURAS_CARRY == 2 + 16 * 8 && RS_AURA_LEFT == 2592000000000 && RS_AURA_SPELL == 1000;
  highs := [8] int.[40, 2147483647, 1, 1000, 2592000000000, 6, 99, 1]; for q: 0..<8 { #assert RS_AURA_HIGH[q] == highs[q]; }
}
#test "aura carry: out names a creature and needs room; Concentration goes only with a record it holds" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; b[0].c = c[..]; b[0].n = 2; b[0].who = -1; b[0].clock = 100;
  c[0] = rs_fighter("One", 0, 3); c[1] = rs_fighter("Two", 1, 3); c[0].conc = -1; c[1].conc = -1;
  w: [RS_AURAS_CARRY] int; short: [RS_AURAS_CARRY - 1] int;
  #assert rs_auras_out(b[..], -1, w[..]) == 0 && rs_auras_out(b[..], 2, w[..]) == 0 && rs_auras_out(b[..], 0, short[..]) == 0;
  w[0] = 9; w[1] = 9; #assert rs_auras_out(b[..], 1, w[..]) == RS_AURAS_HEAD && w[0] == 0 && w[1] == 0;
  // no effect at all: a sourceless record with no spell (spell -1) is not "held" by having no Concentration (-1)
  #assert rs_effect_add(c[0..<1], RsEffect.{kind = EF_WEAK, by = 0, spell = -1, until = 200, save = -1}); c[0].conc_until = 300;
  #assert rs_auras_out(b[..], 0, w[..]) == 10 && w[0] == 0 && w[1] == 0;
  // its own Bless, concentrated on: both go
  #assert rs_effect_add(c[0..<1], RsEffect.{kind = EF_BLESS, by = 0, spell = SP_BLESS, until = 300, save = -1});
  c[0].conc = SP_BLESS; c[0].conc_until = 300;
  #assert rs_auras_out(b[..], 0, w[..]) == 18 && w[0] == SP_BLESS + 1 && w[1] == 200;
  c[0].conc_until = RS_NO_END; #assert rs_auras_out(b[..], 0, w[..]) == 18 && w[0] == SP_BLESS + 1 && w[1] == 0;
  c[0].conc_until = 101; #assert rs_auras_out(b[..], 0, w[..]) == 18 && w[0] == SP_BLESS + 1 && w[1] == 1;
  c[0].conc_until = 100; #assert rs_auras_out(b[..], 0, w[..]) == 18 && w[0] == 0 && w[1] == 0;   // over
  // spell number 0 is a spell
  c[0].eff[1].spell = 0; c[0].conc = 0; c[0].conc_until = 300; #assert rs_auras_out(b[..], 0, w[..]) == 18 && w[0] == 1 && w[1] == 200 && w[13] == 1;
  c[0].eff[1].spell = SP_BLESS;
  // a spell it holds on someone else stays behind with them: its own records are another spell's
  c[0].conc = SP_HEX; c[0].conc_until = 300; #assert rs_auras_out(b[..], 0, w[..]) == 18 && w[0] == 0 && w[1] == 0;
  // Two's Bless on One is not One's to concentrate on
  c[0].eff[1].by = 1; c[0].conc = SP_BLESS; #assert rs_auras_out(b[..], 0, w[..]) == 18 && w[0] == 0;
  c[0].eff[1].by = 0; c[0].conc = RS_AURA_SPELL; c[0].eff[1].spell = RS_AURA_SPELL; #assert rs_auras_out(b[..], 0, w[..]) == 10 && w[0] == 0;
  // the last place of the list is read too, and the records are packed in order
  c[0].eff[1].spell = SP_BLESS; c[0].conc = SP_BLESS; c[0].eff[RS_EFFECTS - 1] = RsEffect.{kind = EF_VEX, cond = 4, by = 1, spell = -1, until = 150, save = -1};
  #assert rs_auras_out(b[..], 0, w[..]) == 26 && w[18] == EF_VEX && w[19] == 4 && w[22] == 50 && w[10] == EF_BLESS && w[2] == EF_WEAK;
}
#test "aura carry: in is all or none, and refuses every malformed list" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; b[0].c = c[..]; b[0].n = 2; b[0].who = -1; b[0].clock = 100;
  c[0] = rs_fighter("One", 0, 3); c[1] = rs_fighter("Two", 1, 3); c[0].conc = -1; c[1].conc = -1; c[1].restrained_by = -1;
  good := [18] int.[SP_BLESS + 1, 200,  EF_COND, RS_POISONED, 0, 0, 50, 0, 0, 0,  EF_BLESS, 0, 1, SP_BLESS + 1, 200, 0, 0, 1];
  w := good;
  #assert !rs_auras_in(b[..], -1, w[..]) && !rs_auras_in(b[..], 2, w[..]) && c[1].eff[0].kind == EF_NONE;
  #assert !rs_auras_in(b[..], 1, w[0..<1]) && !rs_auras_in(b[..], 1, w[0..<17]) && !rs_auras_in(b[..], 1, w[0..<3]) && !rs_auras_in(b[..], 1, w[0..<9]);
  none := [2] int.[0, 0]; #assert rs_auras_in(b[..], 1, none[..]) && c[1].eff[0].kind == EF_NONE && c[1].conc == -1;
  // the head's ranges, and ticks left with no spell
  w = good; w[0] = -1; #assert !rs_auras_in(b[..], 1, w[..]); w[0] = RS_AURA_SPELL + 1; #assert !rs_auras_in(b[..], 1, w[..]);
  w = good; w[1] = -1; #assert !rs_auras_in(b[..], 1, w[..]); w[1] = RS_AURA_LEFT + 1; #assert !rs_auras_in(b[..], 1, w[..]);
  w[1] = RS_AURA_LEFT; #assert rs_auras_in(b[..], 1, w[..]) && c[1].conc == SP_BLESS && c[1].conc_until == 100 + RS_AURA_LEFT;
  c[1] = rs_fighter("Two", 1, 3); c[1].conc = -1; c[1].restrained_by = -1;
  none[1] = 1; #assert !rs_auras_in(b[..], 1, none[..]); none[1] = 0;
  // each field of each record, a kind that stays, and the second record's fault undoes the first
  for q: 0..<RS_AURA_CARRY {
    w = good; w[10 + q] = RS_AURA_HIGH[q] + 1; #assert !rs_auras_in(b[..], 1, w[..]) && c[1].eff[0].kind == EF_NONE && c[1].cond == 0 && c[1].conc == -1;
    w = good; w[10 + q] = -1; #assert !rs_auras_in(b[..], 1, w[..]) && c[1].eff[0].kind == EF_NONE;
    w = good; w[2 + q] = RS_AURA_HIGH[q] + 1; #assert !rs_auras_in(b[..], 1, w[..]);
  }
  w = good; w[10] = EF_HALT; #assert !rs_auras_in(b[..], 1, w[..]) && c[1].eff[0].kind == EF_NONE && c[1].cond == 0;
  w = good; w[10] = 0; #assert !rs_auras_in(b[..], 1, w[..]);
  // a Concentration needs one of its own records of that spell
  w = good; w[12] = 0; #assert !rs_auras_in(b[..], 1, w[..]) && c[1].conc == -1 && c[1].eff[0].kind == EF_NONE;
  w = good; w[13] = SP_BLESS + 2; #assert !rs_auras_in(b[..], 1, w[..]) && c[1].eff[0].kind == EF_NONE;
  w = good; w[0] = 0; w[1] = 0; #assert rs_auras_in(b[..], 1, w[..]) && c[1].conc == -1 && c[1].eff[1].kind == EF_BLESS;
  c[1] = rs_fighter("Two", 1, 3); c[1].conc = -1; c[1].restrained_by = -1;
  // the good list, with no clock on the Concentration
  w = good; w[1] = 0; #assert rs_auras_in(b[..], 1, w[..]) && c[1].conc == SP_BLESS && c[1].conc_until == RS_NO_END;
  e := c[1].eff[1]; #assert e.kind == EF_BLESS && e.by == 1 && e.spell == SP_BLESS && e.until == 300 && e.turn_end == 2 && e.save == -1;
  p := c[1].eff[0]; #assert p.kind == EF_COND && p.by == -1 && p.spell == -1 && p.until == 150 && p.turn_end == 0 && (c[1].cond & RS_POISONED) != 0;
  // a full body: sixteen records fit, and one more than it has room for is refused whole
  c[1] = rs_fighter("Two", 1, 3); c[1].conc = -1; c[1].restrained_by = -1;
  full: [RS_AURAS_CARRY] int; for k: 0..<RS_EFFECTS { full[2 + k * 8] = EF_HEX; full[2 + k * 8 + 1] = k; full[2 + k * 8 + 4] = 10 + k; }
  #assert rs_auras_in(b[..], 1, full[..]) && c[1].eff[RS_EFFECTS - 1].kind == EF_HEX && c[1].eff[RS_EFFECTS - 1].cond == 15 && c[1].eff[RS_EFFECTS - 1].until == 125 && c[1].eff[RS_EFFECTS - 1].spell == -1 && c[1].eff[RS_EFFECTS - 1].save == -1;
  for k: 0..<RS_EFFECTS - 1 { rs_effect_end(c[1..<2], k); }
  #assert !rs_auras_in(b[..], 1, full[..]) && c[1].eff[0].kind == EF_NONE && c[1].eff[RS_EFFECTS - 1].cond == 15;
  over: [RS_AURAS_CARRY + RS_AURA_CARRY] int; over[2] = EF_HEX; #assert !rs_auras_in(b[..], 0, over[..]) && rs_auras_in(b[..], 0, over[0..<10]);
}
