// The classes' features (GitHub #13287, split from battle.coax): rs_release_turned to rs_dash. A
// feature is a row of steps (#13285: rs_feature, run by rs_feature_use).
// Its own checks are battle-features-checks.coax, which battle.coax loads.
//   coax/bin/coax mutate rules/srd/battle.coax --library --unit rules/srd/battle-features.coax --traversal 16000000000
#authority;

// ---- the classes' features

// Who i has turned (Turn Undead) is let go: i dropped, or is Incapacitated.
rs_release_turned :: (b: [] RsBattle, i: int) #effects(all) {
  if !rs_has_feature(b[0].c[i], RS_FT_TURN_UNDEAD) { return; }   // only Turn Undead turns (rs_turn_undead)
  for j: 0..<b[0].n {
    for k: 0..<RS_EFFECTS { if b[0].c[j].eff[k].kind == EF_TURNED && b[0].c[j].eff[k].by == i { rs_drop_effect(b, j, k); } }
  }
}
// Who turned j (Turn Undead), or -1.
rs_turned_by :: (c: RsCreature) -> int #effects(all) {
  for k: 0..<RS_EFFECTS { if c.eff[k].kind == EF_TURNED { return c.eff[k].by; } }
  return -1;
}
// A creature's own Bonus Action feature may run: its turn, its Bonus Action free, able to act.
rs_bonus_free :: (b: [] RsBattle, i: int) -> bool #effects(all) { return b[0].who == i && !b[0].turn.bonus && rs_can_act(b[0].c[i]); }
rs_action_free :: (b: [] RsBattle, i: int) -> bool #effects(all) { return b[0].who == i && !b[0].turn.action && rs_can_act(b[0].c[i]); }
rs_say :: (b: [] RsBattle, kind: int, i: int, j: int, amount: int, t: string) #effects(all) { rs_say_ft(b, kind, i, j, amount, RS_FT_NONE, t); }
rs_say_ft :: (b: [] RsBattle, kind: int, i: int, j: int, amount: int, feat: int, t: string) #effects(all) {
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], t);
  rs_tell_ft(b, kind, -1, i, j, amount, 0, feat, l[..]);
}
// A feature that has no line of its own (a Dash): told quietly, for the worlds that draw it.
rs_quiet_ft :: (b: [] RsBattle, i: int, feat: int) #effects(all) { l: [1] RsLine; rs_tell_ft(b, RS_EV_FEAT, -1, i, i, 0, 0, feat, l[..]); }
// Healing from a feature (not a spell): the log line, and Hit Points back.
rs_feature_heal :: (b: [] RsBattle, i: int, j: int, amount: int, what: string, feat: int) -> int #effects(all) {
  was_down := b[0].c[j].hp == 0;
  h: [1] RsCreature; h[0] = b[0].c[j];
  got := rs_heal(h[..], amount);
  b[0].c[j] = h[0];
  l: [1] RsLine;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " regains "); rs_add_int(l[..], got); rs_add_text(l[..], " Hit Points from "); rs_add_text(l[..], what);
  if was_down && b[0].c[j].hp > 0 && !rs_has(b[0].c[j],RS_UNCONSCIOUS) { rs_add_text(l[..], " and wakes"); }
  rs_tell_ft(b, RS_EV_HEAL, -1, i, j, got, 0, feat, l[..]);
  return got;
}

// ---- a feature's record: its program (#13285)
//
// A class feature is a row of steps from a closed set, as a spell is (spells.coax): what it needs
// (its turn's part, the feature known, a use in its pool, a target in reach), what it spends, the
// line it tells, and what it does. rs_feature_use runs any row: every need first, and nothing is
// spent unless all hold; then the rest in order. A step that can still refuse (an Aura with no place)
// stands before any that spends. A feature that uses these steps is a row, and nothing else.
//
// The needs (below RS_FS_DO): its turn; able to act; its Bonus Action free; its Action free; its
// Action spent; feature a known; rank a above 0; a use in pool a; pool a below its maximum; pool a
// empty; a spell slot; below its Hit Point maximum; able to regain Hit Points; not moved this turn;
// note a clear; not done this turn; Aura a not on it; state Aura a not on it, with a place for it;
// class a at level b; a point within a feet; another creature, up, within a feet, with a place for
// state Aura b and none yet; a creature within a feet that can be healed, and something to give it
// (at most the pool a, the amount asked and what it lacks); a place on every Undead foe within a
// feet that would be turned; a Bloodied friend within a feet.
RS_FS_N_TURN :: 1; RS_FS_N_ACT :: 2; RS_FS_N_BONUS :: 3; RS_FS_N_ACTION :: 4; RS_FS_N_ACTED :: 5; RS_FS_N_FEAT :: 6; RS_FS_N_RANK :: 7;
RS_FS_N_USE :: 8; RS_FS_N_POOL_ROOM :: 9; RS_FS_N_POOL_NONE :: 10; RS_FS_N_SLOT :: 11; RS_FS_N_HURT :: 12; RS_FS_N_HEALS :: 13;
RS_FS_N_STILL :: 14; RS_FS_N_FRESH :: 15; RS_FS_N_ONCE :: 16; RS_FS_N_NO_AURA :: 17; RS_FS_N_NO_STATE :: 18; RS_FS_N_CLASS :: 19;
RS_FS_N_POINT :: 20; RS_FS_N_OTHER :: 21; RS_FS_N_GIVE :: 22; RS_FS_N_TURNABLE :: 23; RS_FS_N_BLOODIED :: 24;
// What it does (from RS_FS_DO): takes its Bonus Action; takes its Action; gives its Action back;
// spends one use of pool a; spends from pool a what it gives; spends its lowest spell slot; one more
// use in pool a; pool a at one; one more slot of level a; note a set; done this turn; tells line t
// as event a of feature c, to itself (b 0), its target (b 1, with what it gives) or no one (b 2);
// heals itself a dice of b sides (b 0: its Martial Arts die) plus its level (c 1) or its Wisdom
// modifier, 1 at least (c 2), named t; heals its target what it gives, named t; half its Speed more
// with feature a (Tactical Shift); Aura a on itself (refused with no place); state Aura a on, with
// bit b; ends its Concentration, saying t; ends Charmed and Frightened on it with feature a; Steady
// Aim's turn; the Bard's die on its target; and three that are one feature's own: Turn Undead,
// Preserve Life and Land's Aid.
RS_FS_DO :: 40;
RS_FS_BONUS :: 40; RS_FS_ACTION :: 41; RS_FS_SURGE :: 42; RS_FS_SPEND :: 43; RS_FS_SPEND_GIVE :: 44; RS_FS_SLOT_SPEND :: 45;
RS_FS_POOL_ADD :: 46; RS_FS_POOL_ONE :: 47; RS_FS_SLOT_ADD :: 48; RS_FS_NOTE :: 49; RS_FS_ONCE :: 50; RS_FS_SAY :: 51;
RS_FS_HEAL :: 52; RS_FS_HEAL_GIVE :: 53; RS_FS_SHIFT :: 54; RS_FS_AURA :: 55; RS_FS_STATE :: 56; RS_FS_END_CONC :: 57;
RS_FS_UNCHARM :: 58; RS_FS_AIM :: 59; RS_FS_INSPIRE :: 60; RS_FS_TURN_UNDEAD :: 61; RS_FS_PRESERVE :: 62; RS_FS_LANDS :: 63;
RS_TO_SELF :: 0; RS_TO_TARGET :: 1; RS_TO_NONE :: 2;
RS_PLUS_LEVEL :: 1; RS_PLUS_WIS :: 2;
// Two features with no ability number of their own (ability-record.coax RS_AB_*): Font of
// Inspiration, and Wild Resurgence's other way (a Wild Shape use for a 1st-level slot).
RS_FP_FONT :: 100; RS_FP_RESURGE_SLOT :: 101;

RsFeatStep :: struct { kind: int; a: int; b: int; c: int; t: string; }
RS_FEAT_STEPS :: 10;
RsFeature :: struct { st: [RS_FEAT_STEPS] RsFeatStep; n: int; }
// What a use is aimed at and asks for: a creature (-1 none), a point, an amount (Lay On Hands).
// `give` is what the needs worked out it gives.
RsUse :: struct { j: int = -1; x: int; y: int; amount: int; give: int; feat: int; }   // feat: the feature its line told (its heals tell the same)
rs_fp :: (f: [] RsFeature, kind: int, a: int, b: int, c: int, t: string) #effects(all) { f[0].st[f[0].n] = RsFeatStep.{kind = kind, a = a, b = b, c = c, t = t}; f[0].n += 1; }

// The features' rows (SRD 5.2.1; the page is the feature's). n 0: no such row.
rs_feature :: (kind: int) -> RsFeature #effects(all) {
  f: [1] RsFeature;
  if kind == RS_AB_RAGE {   // Rage (p. 29): a Bonus Action, one of its uses; no Concentration while it lasts
    rs_fp(f[..], RS_FS_N_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_RAGE, 0, 0, ""); rs_fp(f[..], RS_FS_N_NO_STATE, EF_RAGE, 0, 0, "");
    rs_fp(f[..], RS_FS_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_RAGE, 0, 0, ""); rs_fp(f[..], RS_FS_STATE, EF_RAGE, RS_RAGE_KEPT, 0, "");
    rs_fp(f[..], RS_FS_END_CONC, 0, 0, 0, " (Rage)"); rs_fp(f[..], RS_FS_UNCHARM, RS_FT_MINDLESS_RAGE, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_NONE, " enters a Rage");
  } else if kind == RS_AB_SECOND {   // Second Wind (p. 48): a Bonus Action, 1d10 + its Fighter level; Tactical Shift
    rs_fp(f[..], RS_FS_N_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_WIND, 0, 0, ""); rs_fp(f[..], RS_FS_N_HURT, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_WIND, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CAST, RS_TO_SELF, RS_FT_SECOND_WIND, " takes a Second Wind");
    rs_fp(f[..], RS_FS_HEAL, 1, 10, RS_PLUS_LEVEL, "Second Wind"); rs_fp(f[..], RS_FS_SHIFT, RS_FT_TACTICAL_SHIFT, 0, 0, "");
  } else if kind == RS_AB_SURGE {   // Action Surge (p. 48): one more action this turn
    rs_fp(f[..], RS_FS_N_TURN, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_ACTED, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_ACT, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_SURGE, 0, 0, "");
    rs_fp(f[..], RS_FS_SURGE, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_SURGE, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_ACTION_SURGE, " uses Action Surge");
  } else if kind == RS_AB_WHOLE {   // Wholeness of Body (Open Hand, p. 52): a Bonus Action, the Martial Arts die + Wisdom (at least 1)
    rs_fp(f[..], RS_FS_N_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_WHOLE, 0, 0, ""); rs_fp(f[..], RS_FS_N_HURT, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_HEALS, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_WHOLE, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CAST, RS_TO_SELF, RS_FT_WHOLENESS, " draws on Wholeness of Body");
    rs_fp(f[..], RS_FS_HEAL, 1, 0, RS_PLUS_WIS, "Wholeness of Body");
  } else if kind == RS_AB_LAY {   // Lay On Hands (p. 53-54): a Bonus Action, touching a creature (itself too), from the pool
    rs_fp(f[..], RS_FS_N_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_LAY, 0, 0, ""); rs_fp(f[..], RS_FS_N_GIVE, RS_USE_LAY, 5, 0, "");
    rs_fp(f[..], RS_FS_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND_GIVE, RS_USE_LAY, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CAST, RS_TO_TARGET, RS_FT_LAY_ON_HANDS, " lays on hands");
    rs_fp(f[..], RS_FS_HEAL_GIVE, 0, 0, 0, "Lay On Hands");
  } else if kind == RS_AB_SACRED {   // Sacred Weapon (Oath of Devotion, p. 56): with the Attack action, a Channel Divinity use
    rs_fp(f[..], RS_FS_N_ACTION, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_CLASS, RS_PALADIN, 3, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_CHANNEL, 0, 0, ""); rs_fp(f[..], RS_FS_N_NO_AURA, EF_SACRED, 0, 0, "");
    rs_fp(f[..], RS_FS_AURA, EF_SACRED, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_CHANNEL, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_SACRED_WEAPON, " raises a Sacred Weapon: +Cha to hit, Radiant on a hit");
  } else if kind == RS_AB_AIM {   // Steady Aim (p. 62): a Bonus Action, only if it hasn't moved this turn
    rs_fp(f[..], RS_FS_N_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_FEAT, RS_FT_STEADY_AIM, 0, 0, ""); rs_fp(f[..], RS_FS_N_STILL, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_AIM, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_STEADY_AIM, " takes Steady Aim");
  } else if kind == RS_AB_INNATE {   // Innate Sorcery (p. 65-66): a Bonus Action, for 1 minute
    rs_fp(f[..], RS_FS_N_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_INNATE, 0, 0, ""); rs_fp(f[..], RS_FS_N_NO_AURA, EF_INNATE, 0, 0, "");
    rs_fp(f[..], RS_FS_AURA, EF_INNATE, 0, 0, ""); rs_fp(f[..], RS_FS_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_INNATE, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_INNATE_SORCERY, " unleashes Innate Sorcery");
  } else if kind == RS_AB_INSPIRE {   // Bardic Inspiration (p. 31-32): a Bonus Action and one use; another creature within 60 feet holds the Bard's die
    rs_fp(f[..], RS_FS_N_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_RANK, RS_RK_INSPIRATION_DIE, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_INSPIRE, 0, 0, "");
    rs_fp(f[..], RS_FS_N_OTHER, 60, EF_INSPIRED, 0, "");
    rs_fp(f[..], RS_FS_BONUS, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_INSPIRE, 0, 0, ""); rs_fp(f[..], RS_FS_INSPIRE, EF_INSPIRED, RS_RK_INSPIRATION_DIE, RS_FT_INSPIRATION, "");
  } else if kind == RS_FP_FONT {   // Font of Inspiration (p. 32): no action, its lowest spell slot for one Bardic Inspiration use
    rs_fp(f[..], RS_FS_N_TURN, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_FEAT, RS_FT_FONT, 0, 0, ""); rs_fp(f[..], RS_FS_N_POOL_ROOM, RS_USE_INSPIRE, 0, 0, ""); rs_fp(f[..], RS_FS_N_SLOT, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_SLOT_SPEND, 0, 0, 0, ""); rs_fp(f[..], RS_FS_POOL_ADD, RS_USE_INSPIRE, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_FONT, ": Font of Inspiration, a spell slot for Bardic Inspiration");
  } else if kind == RS_AB_RESURGE {   // Wild Resurgence (p. 43): once a turn, with no Wild Shape use left, its lowest slot for one (no action)
    rs_fp(f[..], RS_FS_N_TURN, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_FEAT, RS_FT_WILD_RESURGENCE, 0, 0, ""); rs_fp(f[..], RS_FS_N_ONCE, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_N_POOL_NONE, RS_USE_WILD, 0, 0, ""); rs_fp(f[..], RS_FS_N_SLOT, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_SLOT_SPEND, 0, 0, 0, ""); rs_fp(f[..], RS_FS_POOL_ONE, RS_USE_WILD, 0, 0, ""); rs_fp(f[..], RS_FS_ONCE, 0, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_WILD_RESURGENCE, ": Wild Resurgence, a spell slot for a Wild Shape use");
  } else if kind == RS_FP_RESURGE_SLOT {   // and once a Long Rest, a Wild Shape use for a 1st-level slot
    rs_fp(f[..], RS_FS_N_TURN, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_FEAT, RS_FT_WILD_RESURGENCE, 0, 0, ""); rs_fp(f[..], RS_FS_N_FRESH, RS_NT_RESURGED, 0, 0, "");
    rs_fp(f[..], RS_FS_N_USE, RS_USE_WILD, 0, 0, "");
    rs_fp(f[..], RS_FS_SPEND, RS_USE_WILD, 0, 0, ""); rs_fp(f[..], RS_FS_SLOT_ADD, 1, 0, 0, ""); rs_fp(f[..], RS_FS_NOTE, RS_NT_RESURGED, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_NONE, ": Wild Resurgence, a Wild Shape use for a 1st-level slot");
  } else if kind == RS_AB_TURN {   // Turn Undead (Channel Divinity, p. 37): a Magic action; each Undead foe within 30 feet
    rs_fp(f[..], RS_FS_N_ACTION, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_FEAT, RS_FT_TURN_UNDEAD, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_CHANNEL, 0, 0, ""); rs_fp(f[..], RS_FS_N_TURNABLE, 30, 0, 0, "");
    rs_fp(f[..], RS_FS_ACTION, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_CHANNEL, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CAST, RS_TO_NONE, RS_FT_TURN_UNDEAD, " presents a holy symbol: Turn Undead"); rs_fp(f[..], RS_FS_TURN_UNDEAD, 30, 0, 0, "");
  } else if kind == RS_AB_PRESERVE {   // Preserve Life (Life Domain, p. 40): a Magic action and a Channel Divinity use
    rs_fp(f[..], RS_FS_N_ACTION, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_FEAT, RS_FT_PRESERVE_LIFE, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_CHANNEL, 0, 0, ""); rs_fp(f[..], RS_FS_N_BLOODIED, 30, 0, 0, "");
    rs_fp(f[..], RS_FS_ACTION, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_CHANNEL, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CAST, RS_TO_NONE, RS_FT_PRESERVE_LIFE, " channels divinity: Preserve Life"); rs_fp(f[..], RS_FS_PRESERVE, 30, 0, 0, "");
  } else if kind == RS_AB_LANDS {   // Land's Aid (Circle of the Land, p. 46): a Magic action and a Wild Shape use, a point within 60 feet
    rs_fp(f[..], RS_FS_N_ACTION, 0, 0, 0, ""); rs_fp(f[..], RS_FS_N_FEAT, RS_FT_LANDS_AID, 0, 0, ""); rs_fp(f[..], RS_FS_N_USE, RS_USE_WILD, 0, 0, ""); rs_fp(f[..], RS_FS_N_POINT, 60, 0, 0, "");
    rs_fp(f[..], RS_FS_ACTION, 0, 0, 0, ""); rs_fp(f[..], RS_FS_SPEND, RS_USE_WILD, 0, 0, "");
    rs_fp(f[..], RS_FS_SAY, RS_EV_CAST, RS_TO_NONE, RS_FT_LANDS_AID, " calls on Land's Aid: flowers and thorns"); rs_fp(f[..], RS_FS_LANDS, 0, 0, 0, "");
  }
  return f[0];
}
// Whether a need holds for creature i's use u (and, for a gift, what it gives).
rs_feat_need :: (b: [] RsBattle, i: int, u: [] RsUse, st: RsFeatStep) -> bool #effects(all) {
  k := st.kind; j := u[0].j;
  if k == RS_FS_N_TURN { return b[0].who == i; }
  if k == RS_FS_N_ACT { return rs_can_act(b[0].c[i]); }
  if k == RS_FS_N_BONUS { return rs_bonus_free(b, i); }
  if k == RS_FS_N_ACTION { return rs_action_free(b, i); }
  if k == RS_FS_N_ACTED { return b[0].turn.action; }
  if k == RS_FS_N_FEAT { return rs_has_feature(b[0].c[i], st.a); }
  if k == RS_FS_N_RANK { return b[0].c[i].rank[st.a] > 0; }
  if k == RS_FS_N_USE { return b[0].c[i].uses[st.a] > 0; }
  if k == RS_FS_N_POOL_ROOM { return b[0].c[i].uses[st.a] < b[0].c[i].uses_max[st.a]; }
  if k == RS_FS_N_POOL_NONE { return b[0].c[i].uses[st.a] <= 0; }
  if k == RS_FS_N_SLOT { return rs_lowest_slot(b[0].c[i]) > 0; }
  if k == RS_FS_N_HURT { return b[0].c[i].hp < b[0].c[i].hp_max; }
  if k == RS_FS_N_HEALS { return !rs_effect(b[0].c[i], EF_NOHEAL); }
  if k == RS_FS_N_STILL { return !b[0].turn.moved; }
  if k == RS_FS_N_FRESH { return b[0].c[i].note[st.a] == 0; }
  if k == RS_FS_N_ONCE { return !b[0].turn.resurged; }
  if k == RS_FS_N_NO_AURA { return !rs_aura_on(b[0].c[i], st.a, b[0].clock); }
  if k == RS_FS_N_NO_STATE { return !rs_effect(b[0].c[i], st.a) && rs_state_room(b[0].c[i], st.a); }
  if k == RS_FS_N_CLASS { return b[0].c[i].klass == st.a && b[0].c[i].level >= st.b; }
  if k == RS_FS_N_POINT { return rs_range_ft(b, b[0].c[i].x, b[0].c[i].y, u[0].x, u[0].y) <= st.a; }
  if k == RS_FS_N_OTHER {
    if j < 0 || j >= b[0].n || j == i || !rs_up(b[0].c[j]) { return false; }
    return rs_state_value(b[0].c[j], st.b) <= 0 && rs_state_room(b[0].c[j], st.b) && rs_feet_to(b, i, j) <= st.a;
  }
  if k == RS_FS_N_GIVE {
    if j < 0 || j >= b[0].n || b[0].c[j].dead || rs_feet_to(b, i, j) > st.b || rs_effect(b[0].c[j], EF_NOHEAL) { return false; }
    u[0].give = rs_min(rs_min(u[0].amount, b[0].c[i].uses[st.a]), b[0].c[j].hp_max - b[0].c[j].hp);
    return u[0].give > 0;
  }
  if k == RS_FS_N_TURNABLE {
    for q: 0..<b[0].n {
      c := b[0].c[q];
      if c.undead && rs_up(c) && c.team != b[0].c[i].team && rs_feet_to(b,i,q) <= st.a && rs_effect_condition_mask(c,RS_FRIGHTENED|RS_INCAPACITATED) != 0 && rs_effect_free(c) < 1 { return false; }
    }
    return true;
  }
  if k == RS_FS_N_BLOODIED {
    for q: 0..<b[0].n {
      c := b[0].c[q];
      if c.team == b[0].c[i].team && !c.dead && c.hp < c.hp_max / 2 && !rs_effect(c, EF_NOHEAL) && rs_feet_to(b, i, q) <= st.a { return true; }
    }
    return false;
  }
  return false;
}
// A creature's lowest spell slot level with a slot left, 0 none.
rs_lowest_slot :: (c: RsCreature) -> int #effects(all) {
  for l: 1..<10 { if c.slots[l] > 0 { return l; } }
  return 0;
}
// One step done for creature i's use u. False: it refused (only a step that stands before any spending can).
rs_feat_do :: (b: [] RsBattle, i: int, u: [] RsUse, st: RsFeatStep) -> bool #effects(all) {
  k := st.kind; j := u[0].j;
  if k == RS_FS_BONUS { b[0].turn.bonus = true; }
  else if k == RS_FS_ACTION { b[0].turn.action = true; }
  else if k == RS_FS_SURGE { b[0].turn.action = false; }
  else if k == RS_FS_SPEND { b[0].c[i].uses[st.a] -= 1; }
  else if k == RS_FS_SPEND_GIVE { b[0].c[i].uses[st.a] -= u[0].give; }
  else if k == RS_FS_SLOT_SPEND { b[0].c[i].slots[rs_lowest_slot(b[0].c[i])] -= 1; }
  else if k == RS_FS_POOL_ADD { b[0].c[i].uses[st.a] += 1; }
  else if k == RS_FS_POOL_ONE { b[0].c[i].uses[st.a] = 1; }
  else if k == RS_FS_SLOT_ADD { b[0].c[i].slots[st.a] += 1; }
  else if k == RS_FS_NOTE { b[0].c[i].note[st.a] = 1; }
  else if k == RS_FS_ONCE { b[0].turn.resurged = true; }
  else if k == RS_FS_SAY { u[0].feat = st.c; rs_say_ft(b, st.a, i, ifx st.b == RS_TO_SELF then i else ifx st.b == RS_TO_TARGET then j else -1, u[0].give, st.c, st.t); }
  else if k == RS_FS_HEAL {
    sides := ifx st.b > 0 then st.b else b[0].c[i].rank[RS_RK_MARTIAL_DIE];
    amount := rs_sum(b[0].dice[..], st.a, sides);
    if st.c == RS_PLUS_LEVEL { amount += b[0].c[i].level; }
    if st.c == RS_PLUS_WIS { amount = rs_max(amount + rs_mod(b[0].c[i].score[RS_WIS]), 1); }
    got := rs_feature_heal(b, i, i, amount, st.t, u[0].feat);
  }
  else if k == RS_FS_HEAL_GIVE { got := rs_feature_heal(b, i, j, u[0].give, st.t, u[0].feat); }
  else if k == RS_FS_SHIFT { if rs_has_feature(b[0].c[i], st.a) && !b[0].turn.anchored { b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE / 2; } }
  else if k == RS_FS_AURA { return rs_aura_grant(b, i, st.a); }
  else if k == RS_FS_STATE { b[0].c[i].eff = rs_state_put(b[0].c[i].eff, st.a, true); b[0].c[i].eff = rs_state_bit(b[0].c[i].eff, st.a, st.b, true); }
  else if k == RS_FS_END_CONC { rs_end_concentration(b, i, st.t); }
  else if k == RS_FS_UNCHARM {
    if rs_has_feature(b[0].c[i], st.a) {
      for e: 0..<RS_EFFECTS {
        ef := b[0].c[i].eff[e];
        if (ef.kind == EF_COND || ef.kind == EF_TURNED) && (ef.cond & (RS_CHARMED | RS_FRIGHTENED)) != 0 { rs_drop_effect(b, i, e); }
      }
    }
  }
  else if k == RS_FS_AIM {
    b[0].turn.aimed = true; b[0].turn.anchored = true; b[0].turn.move_left = 0; b[0].turn.move_feet = 0;
    _ := rs_dodge_live(b,i);
  }
  else if k == RS_FS_INSPIRE {
    die := b[0].c[i].rank[st.b];
    b[0].c[j].eff = rs_state_value_put(b[0].c[j].eff, st.a, die);
    l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " inspires "); rs_add_name(l[..], b, j); rs_add_text(l[..], ": a Bardic Inspiration d"); rs_add_int(l[..], die);
    rs_tell_ft(b, RS_EV_CONDITION, -1, i, j, 0, 0, st.c, l[..]);
  }
  else if k == RS_FS_TURN_UNDEAD { rs_turn_undead_step(b, i, st.a); }
  else if k == RS_FS_PRESERVE { rs_preserve_life_step(b, i, st.a); }
  else if k == RS_FS_LANDS { rs_lands_aid_step(b, i, u); }
  return true;
}
// Creature i uses the feature `kind` (an RS_AB_* with a row, or an RS_FP_*), aimed as u says. False,
// and nothing spent or told, when a need does not hold or the feature has no row.
rs_feature_use :: (b: [] RsBattle, i: int, kind: int, u: RsUse) -> bool #effects(all) { return rs_feature_run(b, i, rs_feature(kind), u); }
// Creature i runs row f (no row has no steps).
rs_feature_run :: (b: [] RsBattle, i: int, f: RsFeature, u: RsUse) -> bool #effects(all) {
  if f.n == 0 { return false; }
  use: [1] RsUse; use[0] = u;
  for k: 0..<f.n { if f.st[k].kind < RS_FS_DO && !rs_feat_need(b, i, use[..], f.st[k]) { return false; } }
  for k: 0..<f.n { if f.st[k].kind >= RS_FS_DO && !rs_feat_do(b, i, use[..], f.st[k]) { return false; } }
  return true;
}
// The features by name: each is its row.
rs_font :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_FP_FONT, RsUse.{}); }
rs_inspire :: (b: [] RsBattle, i: int, j: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_INSPIRE, RsUse.{j = j}); }
rs_turn_undead :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_TURN, RsUse.{}); }
rs_preserve_life :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_PRESERVE, RsUse.{}); }
rs_second_wind :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_SECOND, RsUse.{}); }
rs_action_surge :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_SURGE, RsUse.{}); }
rs_lay_on_hands :: (b: [] RsBattle, i: int, j: int, amount: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_LAY, RsUse.{j = j, amount = amount}); }
rs_sacred_weapon :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_SACRED, RsUse.{}); }
rs_steady_aim :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_AIM, RsUse.{}); }
rs_innate_sorcery :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_INNATE, RsUse.{}); }
rs_wild_resurgence :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_RESURGE, RsUse.{}); }
rs_resurge_slot :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_FP_RESURGE_SLOT, RsUse.{}); }
rs_lands_aid :: (b: [] RsBattle, i: int, tx: int, ty: int, heal: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_LANDS, RsUse.{j = heal, x = tx, y = ty}); }
rs_rage :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_RAGE, RsUse.{}); }
rs_wholeness :: (b: [] RsBattle, i: int) -> bool #effects(all) { return rs_feature_use(b, i, RS_AB_WHOLE, RsUse.{}); }

// Turn Undead's own step: each Undead foe within `feet` makes a Wisdom save or is Frightened and
// Incapacitated for 1 minute; it ends early if the creature takes damage, or the Cleric is
// Incapacitated or dies.
rs_turn_undead_step :: (b: [] RsBattle, i: int, feet: int) #effects(all) {
  dc := rs_dc(b, i);
  // Sear Undead: Wisdom-modifier d8s (at least one), rolled once, Radiant on each that fails
  sears := rs_has_feature(b[0].c[i], RS_FT_SEAR_UNDEAD);
  sear: int; if sears { sear = rs_sum(b[0].dice[..], rs_max(rs_mod(b[0].c[i].score[RS_WIS]), 1), 8); }
  radiant := RS_RADIANT;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if !c.undead || !rs_up(c) || c.team == b[0].c[i].team || rs_feet_to(b, i, j) > feet { continue; }
    saving := rs_saving_throw_magic(b,j,RS_WIS,dc,0);
    total := saving.total; ok := saving.passed;
    l: [1] RsLine;
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " WIS save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
    rs_add_text(l[..], ifx ok then ": success" else ": turned, Frightened and Incapacitated");
    rs_tell(b, ifx ok then RS_EV_SAVE else RS_EV_CONDITION, -1, i, j, total, 0, l[..]);
    if !ok && sears {
      // the damage first, so it doesn't end the turning
      amount := rs_resisted(b, j, sear, radiant);
      sl: [1] RsLine; rs_add_text(sl[..], "  "); rs_add_name(sl[..], b, j); rs_add_text(sl[..], " takes "); rs_add_int(sl[..], amount); rs_add_text(sl[..], " Radiant (Sear Undead)");
      rs_feature_hurt(b, i, j, amount, radiant, sl[..]);
    }
    if !ok && !b[0].c[j].dead { _ := rs_put_effect(b, j, RsEffect.{kind = EF_TURNED, cond = RS_FRIGHTENED | RS_INCAPACITATED, by = i, spell = -1, until = b[0].clock + rs_secs(60), save = -1, dc = 0}); }
  }
}
// Damage from a feature (not a spell, not a critical hit): its line, then the damage.
rs_feature_hurt :: (b: [] RsBattle, i: int, j: int, amount: int, kind: int, l: [] RsLine) #effects(all) {
  rs_tell(b, RS_EV_DAMAGE, -1, i, j, amount, kind, l);
  rs_damage(b, i, j, amount, kind, false, -1);
}
// Preserve Life's own step: five times the Cleric's level in Hit Points, divided among Bloodied
// creatures within `feet` (its side, itself too), none above half its Hit Point maximum. The most
// hurt first.
rs_preserve_life_step :: (b: [] RsBattle, i: int, feet: int) #effects(all) {
  pool := 5 * b[0].c[i].level;
  while pool > 0 {
    best := -1; bv := 2.0f32;
    for j: 0..<b[0].n {
      c := b[0].c[j];
      if c.team != b[0].c[i].team || c.dead || c.hp >= c.hp_max / 2 || rs_effect(c, EF_NOHEAL) || rs_feet_to(b, i, j) > feet { continue; }
      v := f32(c.hp) / f32(c.hp_max);   // above 1: it is below half of it
      if v < bv { bv = v; best = j; }
    }
    if best < 0 { break; }
    give := rs_min(pool, b[0].c[best].hp_max / 2 - b[0].c[best].hp);
    pool -= give;
    got := rs_feature_heal(b, i, best, give, "Preserve Life", RS_FT_PRESERVE_LIFE);
  }
}
// Land's Aid's own step: each foe in the 10-foot-radius Sphere at the use's point makes a Con save,
// 2d6 Necrotic or half; one creature there (the use's, -1 none) regains 2d6 Hit Points.
rs_lands_aid_step :: (b: [] RsBattle, i: int, u: [] RsUse) #effects(all) {
  n6 := ifx b[0].c[i].level >= 14 then 4 else ifx b[0].c[i].level >= 10 then 3 else 2;
  e: RsEvent; e.kind = RS_EV_ZONE; e.spell.value = -1; e.by.value = i; e.to.value = -1; e.feat = RS_FT_LANDS_AID; e.x = u[0].x - 2; e.y = u[0].y - 2; e.amount = 5; e.at = b[0].clock;
  k := rs_emit(b[0].book[..], e);
  dc := rs_dc(b, i);
  necrotic := RS_NECROTIC;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || rs_range_ft(b, u[0].x, u[0].y, c.x, c.y) >= 10 + RS_SQUARE { continue; }
    saving := rs_saving_throw_magic(b,j,RS_CON,dc,0);
    total := saving.total; ok := saving.passed;
    amount := rs_sum(b[0].dice[..], n6, 6);
    if ok { amount = amount / 2; }
    amount = rs_resisted(b, j, amount, necrotic);
    l: [1] RsLine;
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " CON save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
    rs_add_text(l[..], ifx ok then ": half, " else ": "); rs_add_int(l[..], amount); rs_add_text(l[..], " Necrotic");
    rs_feature_hurt(b, i, j, amount, necrotic, l[..]);
  }
  if u[0].j >= 0 && u[0].j < b[0].n && !b[0].c[u[0].j].dead && rs_range_ft(b, u[0].x, u[0].y, b[0].c[u[0].j].x, b[0].c[u[0].j].y) < 10 + RS_SQUARE {
    got := rs_feature_heal(b, i, u[0].j, rs_sum(b[0].dice[..], n6, 6), "Land's Aid", RS_FT_LANDS_AID);
  }
}

// Cunning Action (p. 62): Dash as a Bonus Action.
rs_cunning_dash :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  return rs_dash_use(b,i,RS_DASH_CUNNING);
}
// The Dash action: its Speed again.
rs_dash :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  return rs_dash_use(b,i,RS_DASH_ACTION);
}
