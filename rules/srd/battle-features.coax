// The classes' features (GitHub #13287, split from battle.coax): rs_release_turned to rs_dash.
// Not #authority yet: it owes its mutation pass (and a check for each procedure the issue lists).
//   coax/bin/coax mutate rules/srd/battle.coax --library --unit rules/srd/battle-features.coax

// ---- the classes' features

// Who i has turned (Turn Undead) is let go: i dropped, or is Incapacitated.
rs_release_turned :: (b: [] RsBattle, i: int) {
  if !b[0].c[i].turn_undead { return; }   // only Turn Undead turns (rs_turn_undead)
  for j: 0..<b[0].n {
    for k: 0..<RS_EFFECTS { if b[0].c[j].eff[k].kind == EF_TURNED && b[0].c[j].eff[k].by == i { rs_drop_effect(b, j, k); } }
  }
}
// Who turned j (Turn Undead), or -1.
rs_turned_by :: (c: RsCreature) -> int {
  for k: 0..<RS_EFFECTS { if c.eff[k].kind == EF_TURNED { return c.eff[k].by; } }
  return -1;
}
// A creature's own Bonus Action feature may run: its turn, its Bonus Action free, able to act.
rs_bonus_free :: (b: [] RsBattle, i: int) -> bool { return b[0].who == i && !b[0].turn.bonus && rs_can_act(b[0].c[i]); }
rs_action_free :: (b: [] RsBattle, i: int) -> bool { return b[0].who == i && !b[0].turn.action && rs_can_act(b[0].c[i]); }
rs_say :: (b: [] RsBattle, kind: int, i: int, j: int, amount: int, t: string) { rs_say_ft(b, kind, i, j, amount, RS_FT_NONE, t); }
rs_say_ft :: (b: [] RsBattle, kind: int, i: int, j: int, amount: int, feat: int, t: string) {
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], t);
  rs_tell_ft(b, kind, -1, i, j, amount, 0, feat, l[..]);
}
// A feature that has no line of its own (a Dash): told quietly, for the worlds that draw it.
rs_quiet_ft :: (b: [] RsBattle, i: int, feat: int) { l: [1] RsLine; rs_tell_ft(b, RS_EV_FEAT, -1, i, i, 0, 0, feat, l[..]); }
// Healing from a feature (not a spell): the log line, and Hit Points back.
rs_feature_heal :: (b: [] RsBattle, i: int, j: int, amount: int, what: string, feat: int) -> int {
  was_down := b[0].c[j].hp == 0;
  h: [1] RsCreature; h[0] = b[0].c[j];
  got := rs_heal(h[..], amount);
  b[0].c[j] = h[0];
  l: [1] RsLine;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " regains "); rs_add_int(l[..], got); rs_add_text(l[..], " Hit Points from "); rs_add_text(l[..], what);
  if was_down && b[0].c[j].hp > 0 && !rs_has(b[0].c[j],RS_UNCONSCIOUS) { rs_add_text(l[..], " and wakes"); }
  rs_tell_ft(b, RS_EV_HEAL, -1, i, j, got, 0, feat, l[..]);
  return got;
}

// Font of Inspiration (p. 32): no action, its lowest spell slot for one Bardic Inspiration use.
rs_font :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || !b[0].c[i].font || b[0].c[i].uses[RS_USE_INSPIRE] >= b[0].c[i].uses_max[RS_USE_INSPIRE] { return false; }
  for l: 1..<10 {
    if b[0].c[i].slots[l] > 0 {
      b[0].c[i].slots[l] -= 1; b[0].c[i].uses[RS_USE_INSPIRE] += 1;
      rs_say_ft(b, RS_EV_CONDITION, i, i, 0, RS_FT_FONT, ": Font of Inspiration, a spell slot for Bardic Inspiration");
      return true;
    }
  }
  return false;
}
// Bardic Inspiration (p. 31-32): a Bonus Action and one use; another creature within 60 feet gains
// the Bard's die, and adds it to a D20 Test it fails (one die at a time).
rs_inspire :: (b: [] RsBattle, i: int, j: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].insp_die <= 0 || b[0].c[i].uses[RS_USE_INSPIRE] <= 0 { return false; }
  if j < 0 || j >= b[0].n || j == i || !rs_up(b[0].c[j]) || b[0].c[j].inspired > 0 || rs_feet_to(b, i, j) > 60 { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_INSPIRE] -= 1;
  b[0].c[j].inspired = b[0].c[i].insp_die;
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " inspires "); rs_add_name(l[..], b, j); rs_add_text(l[..], ": a Bardic Inspiration d"); rs_add_int(l[..], b[0].c[i].insp_die);
  rs_tell_ft(b, RS_EV_CONDITION, -1, i, j, 0, 0, RS_FT_INSPIRATION, l[..]);
  return true;
}

// Turn Undead (Channel Divinity, p. 37): a Magic action; each Undead foe within 30 feet makes a
// Wisdom save or is Frightened and Incapacitated for 1 minute, moving away; it ends early if the
// creature takes damage, or the Cleric is Incapacitated or dies.
rs_turn_undead :: (b: [] RsBattle, i: int) -> bool {
  if !rs_action_free(b, i) || !b[0].c[i].turn_undead || b[0].c[i].uses[RS_USE_CHANNEL] <= 0 { return false; }
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.undead && rs_up(c) && c.team != b[0].c[i].team && rs_feet_to(b,i,j) <= 30 && rs_effect_condition_mask(c,RS_FRIGHTENED|RS_INCAPACITATED) != 0 && rs_effect_room(c,false,0,-1) < 1 { return false; }
  }
  b[0].turn.action = true; b[0].c[i].uses[RS_USE_CHANNEL] -= 1;
  rs_say_ft(b, RS_EV_CAST, i, -1, 0, RS_FT_TURN_UNDEAD, " presents a holy symbol: Turn Undead");
  dc := rs_dc(b, i);
  // Sear Undead: Wisdom-modifier d8s (at least one), rolled once, Radiant on each that fails
  sear := ifx b[0].c[i].sear then rs_sum(b[0].dice[..], rs_max(rs_mod(b[0].c[i].score[RS_WIS]), 1), 8) else 0;
  for j: 0..<b[0].n {
    if !b[0].c[j].undead || rs_feet_to(b, i, j) > 30 { continue; }
    c := b[0].c[j];
    if !c.undead || !rs_up(c) || c.team == b[0].c[i].team || rs_feet_to(b, i, j) > 30 { continue; }
    saving := rs_saving_throw_magic(b,j,RS_WIS,dc,0);
    total := saving.total; ok := saving.passed;
    l: [1] RsLine;
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " WIS save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
    rs_add_text(l[..], ifx ok then ": success" else ": turned, Frightened and Incapacitated");
    rs_tell(b, ifx ok then RS_EV_SAVE else RS_EV_CONDITION, -1, i, j, total, 0, l[..]);
    if !ok && sear > 0 {
      // the damage first, so it doesn't end the turning
      amount := rs_resisted(b, j, sear, RS_RADIANT);
      sl: [1] RsLine; rs_add_text(sl[..], "  "); rs_add_name(sl[..], b, j); rs_add_text(sl[..], " takes "); rs_add_int(sl[..], amount); rs_add_text(sl[..], " Radiant (Sear Undead)");
      rs_tell(b, RS_EV_DAMAGE, -1, i, j, amount, RS_RADIANT, sl[..]);
      rs_damage(b, i, j, amount, RS_RADIANT, false, -1);
    }
    if !ok && !b[0].c[j].dead { _ := rs_put_effect(b, j, RsEffect.{kind = EF_TURNED, cond = RS_FRIGHTENED | RS_INCAPACITATED, by = i, spell = -1, until = b[0].clock + rs_secs(60), save = -1, dc = 0}); }
  }
  return true;
}

// Preserve Life (Life Domain, p. 40): a Magic action and a Channel Divinity use; five times the
// Cleric's level in Hit Points, divided among Bloodied creatures within 30 feet (its side, itself
// too), none above half its Hit Point maximum. The most hurt first.
rs_preserve_life :: (b: [] RsBattle, i: int) -> bool {
  if !rs_action_free(b, i) || !b[0].c[i].preserve_life || b[0].c[i].uses[RS_USE_CHANNEL] <= 0 { return false; }
  any := false;
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team && !c.dead && c.hp < c.hp_max / 2 && !rs_effect(c, EF_NOHEAL) && rs_feet_to(b, i, j) <= 30 { any = true; }
  }
  if !any { return false; }
  b[0].turn.action = true; b[0].c[i].uses[RS_USE_CHANNEL] -= 1;
  rs_say_ft(b, RS_EV_CAST, i, -1, 0, RS_FT_PRESERVE_LIFE, " channels divinity: Preserve Life");
  pool := 5 * b[0].c[i].level;
  while pool > 0 {
    best := -1; bv := 2.0f32;
    for j: 0..<b[0].n {
      c := b[0].c[j];
      if c.team != b[0].c[i].team || c.dead || c.hp >= c.hp_max / 2 || rs_effect(c, EF_NOHEAL) || rs_feet_to(b, i, j) > 30 { continue; }
      v := f32(c.hp) / f32(rs_max(c.hp_max, 1));
      if v < bv { bv = v; best = j; }
    }
    if best < 0 { break; }
    give := rs_min(pool, b[0].c[best].hp_max / 2 - b[0].c[best].hp);
    pool -= give;
    got := rs_feature_heal(b, i, best, give, "Preserve Life", RS_FT_PRESERVE_LIFE);
  }
  return true;
}

// Second Wind (p. 48): a Bonus Action, 1d10 + its Fighter level.
rs_second_wind :: (b: [] RsBattle, i: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].uses[RS_USE_WIND] <= 0 || b[0].c[i].hp >= b[0].c[i].hp_max { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_WIND] -= 1;
  rs_say_ft(b, RS_EV_CAST, i, i, 0, RS_FT_SECOND_WIND, " takes a Second Wind");
  got := rs_feature_heal(b, i, i, rs_roll(b[0].dice[..], 10) + b[0].c[i].level, "Second Wind", RS_FT_SECOND_WIND);
  // Tactical Shift (p. 48): half its Speed more (no Opportunity Attacks in this engine to avoid)
  if b[0].c[i].shift && !b[0].turn.anchored { b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE / 2; }
  return true;
}
// Action Surge (p. 48): one more action this turn, once.
rs_action_surge :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || !b[0].turn.action || !rs_can_act(b[0].c[i]) || b[0].c[i].uses[RS_USE_SURGE] <= 0 { return false; }
  b[0].turn.action = false; b[0].c[i].uses[RS_USE_SURGE] -= 1;
  rs_say_ft(b, RS_EV_CONDITION, i, i, 0, RS_FT_ACTION_SURGE, " uses Action Surge");
  return true;
}

// Lay On Hands (p. 53-54): a Bonus Action, touching a creature (itself too), up to `amount` Hit
// Points from the pool.
rs_lay_on_hands :: (b: [] RsBattle, i: int, j: int, amount: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].uses[RS_USE_LAY] <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || rs_feet_to(b, i, j) > 5 || rs_effect(b[0].c[j], EF_NOHEAL) { return false; }
  give := rs_min(rs_min(amount, b[0].c[i].uses[RS_USE_LAY]), b[0].c[j].hp_max - b[0].c[j].hp);
  if give <= 0 { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_LAY] -= give;
  rs_say_ft(b, RS_EV_CAST, i, j, give, RS_FT_LAY_ON_HANDS, " lays on hands");
  got := rs_feature_heal(b, i, j, give, "Lay On Hands", RS_FT_LAY_ON_HANDS);
  return true;
}
// Sacred Weapon (Oath of Devotion, p. 56): with the Attack action, a Channel Divinity use; for 10
// minutes its Charisma modifier on its melee weapon's attack rolls, and Radiant damage if it likes.
rs_sacred_weapon :: (b: [] RsBattle, i: int) -> bool {
  if !rs_action_free(b, i) || b[0].c[i].klass != RS_PALADIN || b[0].c[i].level < 3 || b[0].c[i].uses[RS_USE_CHANNEL] <= 0 { return false; }
  if rs_aura_on(b[0].c[i], EF_SACRED, b[0].clock) || !rs_aura_grant(b, i, EF_SACRED) { return false; }
  b[0].c[i].uses[RS_USE_CHANNEL] -= 1;
  rs_say_ft(b, RS_EV_CONDITION, i, i, 0, RS_FT_SACRED_WEAPON, " raises a Sacred Weapon: +Cha to hit, Radiant on a hit");
  return true;
}

// Cunning Action (p. 62): Dash as a Bonus Action.
rs_cunning_dash :: (b: [] RsBattle, i: int) -> bool {
  return rs_dash_use(b,i,RS_DASH_CUNNING);
}
// Steady Aim (p. 62): a Bonus Action, only if it hasn't moved this turn; Advantage on its next
// attack roll this turn, and its Speed is 0 until the turn ends.
rs_steady_aim :: (b: [] RsBattle, i: int) -> bool {
  if !rs_bonus_free(b, i) || !b[0].c[i].steady_aim || b[0].turn.moved { return false; }
  b[0].turn.bonus = true; b[0].turn.aimed = true; b[0].turn.anchored = true; b[0].turn.move_left = 0; b[0].turn.move_feet = 0;
  _ := rs_dodge_live(b,i);
  rs_say_ft(b, RS_EV_CONDITION, i, i, 0, RS_FT_STEADY_AIM, " takes Steady Aim");
  return true;
}

// Innate Sorcery (p. 65-66): a Bonus Action, for 1 minute: +1 to its spell save DC and Advantage on
// its spell attack rolls.
rs_innate_sorcery :: (b: [] RsBattle, i: int) -> bool {
  if !rs_bonus_free(b, i) || b[0].c[i].uses[RS_USE_INNATE] <= 0 || rs_aura_on(b[0].c[i], EF_INNATE, b[0].clock) || !rs_aura_grant(b, i, EF_INNATE) { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_INNATE] -= 1;
  rs_say_ft(b, RS_EV_CONDITION, i, i, 0, RS_FT_INNATE_SORCERY, " unleashes Innate Sorcery");
  return true;
}

// Wild Resurgence (p. 43): once a turn, with no Wild Shape use left, its lowest slot for one (no
// action); and once a Long Rest, a Wild Shape use for a 1st-level slot (rs_resurge_slot).
rs_wild_resurgence :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || !b[0].c[i].resurgence || b[0].turn.resurged || b[0].c[i].uses[RS_USE_WILD] > 0 { return false; }
  for l: 1..<10 {
    if b[0].c[i].slots[l] > 0 {
      b[0].c[i].slots[l] -= 1; b[0].c[i].uses[RS_USE_WILD] = 1; b[0].turn.resurged = true;
      rs_say_ft(b, RS_EV_CONDITION, i, i, 0, RS_FT_WILD_RESURGENCE, ": Wild Resurgence, a spell slot for a Wild Shape use");
      return true;
    }
  }
  return false;
}
rs_resurge_slot :: (b: [] RsBattle, i: int) -> bool {
  if b[0].who != i || !b[0].c[i].resurgence || b[0].c[i].resurged_slot || b[0].c[i].uses[RS_USE_WILD] <= 0 { return false; }
  b[0].c[i].uses[RS_USE_WILD] -= 1; b[0].c[i].slots[1] += 1; b[0].c[i].resurged_slot = true;
  rs_say(b, RS_EV_CONDITION, i, i, 0, ": Wild Resurgence, a Wild Shape use for a 1st-level slot");
  return true;
}
// Land's Aid (Circle of the Land, p. 46): a Magic action and a Wild Shape use, a point within 60
// feet: each foe in the 10-foot-radius Sphere makes a Con save, 2d6 Necrotic or half; one creature
// there (`heal`, -1 none) regains 2d6 Hit Points.
rs_lands_aid :: (b: [] RsBattle, i: int, tx: int, ty: int, heal: int) -> bool {
  if !rs_action_free(b, i) || !b[0].c[i].lands_aid || b[0].c[i].uses[RS_USE_WILD] <= 0 { return false; }
  if rs_range_ft(b, b[0].c[i].x, b[0].c[i].y, tx, ty) > 60 { return false; }
  b[0].turn.action = true; b[0].c[i].uses[RS_USE_WILD] -= 1;
  n6 := ifx b[0].c[i].level >= 14 then 4 else ifx b[0].c[i].level >= 10 then 3 else 2;
  rs_say_ft(b, RS_EV_CAST, i, -1, 0, RS_FT_LANDS_AID, " calls on Land's Aid: flowers and thorns");
  e: RsEvent; e.kind = RS_EV_ZONE; e.spell = -1; e.by = i; e.to = -1; e.feat = RS_FT_LANDS_AID; e.x = tx - 2; e.y = ty - 2; e.amount = 5; e.at = b[0].clock;
  k := rs_emit(b[0].book[..], e);
  dc := rs_dc(b, i);
  for j: 0..<b[0].n {
    c := b[0].c[j];
    if c.team == b[0].c[i].team || !rs_up(c) || rs_range_ft(b, tx, ty, c.x, c.y) > 10 { continue; }
    saving := rs_saving_throw_magic(b,j,RS_CON,dc,0);
    total := saving.total; ok := saving.passed;
    amount := rs_sum(b[0].dice[..], n6, 6);
    if ok { amount = amount / 2; }
    amount = rs_resisted(b, j, amount, RS_NECROTIC);
    l: [1] RsLine;
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " CON save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
    rs_add_text(l[..], ifx ok then ": half, " else ": "); rs_add_int(l[..], amount); rs_add_text(l[..], " Necrotic");
    rs_tell(b, RS_EV_DAMAGE, -1, i, j, amount, RS_NECROTIC, l[..]);
    rs_damage(b, i, j, amount, RS_NECROTIC, false, -1);
  }
  if heal >= 0 && heal < b[0].n && !b[0].c[heal].dead && rs_range_ft(b, tx, ty, b[0].c[heal].x, b[0].c[heal].y) <= 10 {
    got := rs_feature_heal(b, i, heal, rs_sum(b[0].dice[..], n6, 6), "Land's Aid", RS_FT_LANDS_AID);
  }
  return true;
}

// The Dash action: its Speed again.
rs_dash :: (b: [] RsBattle, i: int) -> bool {
  return rs_dash_use(b,i,RS_DASH_ACTION);
}
