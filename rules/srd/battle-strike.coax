// Weapons and martial features (GitHub #13287, split from battle.coax): rs_rage_end to rs_step_of_the_wind.
// Its own checks are battle-strike-checks.coax, which battle.coax loads.
//   coax/bin/coax mutate rules/srd/battle.coax --library --unit rules/srd/battle-strike.coax

// ---- weapons and martial features

rs_rage_end :: (b: [] RsBattle, i: int, why: string) {
  if !rs_effect(b[0].c[i], EF_RAGE) { return; }
  b[0].c[i].eff = rs_state_put(b[0].c[i].eff, EF_RAGE, false);   // the record goes, and its bits with it
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], "'s Rage ends"); rs_add_text(l[..], why);
  rs_tell(b, RS_EV_END, -1, i, -1, 0, 0, l[..]);
}
// (Rage and Wholeness of Body are rows of the feature program: battle-features.coax rs_feature.)
// Hex and Hunter's Mark: 1d6 more (Necrotic, Force) when their caster i hits j with an attack roll.
rs_curse_damage :: (b: [] RsBattle, i: int, j: int, crit: bool) {
  mult := ifx crit then 2 else 1;
  for ek: 0..<RS_EFFECTS {
    e := b[0].c[j].eff[ek];
    hex := e.kind == EF_HEX;
    if (!hex && e.kind != EF_MARK) || e.by != i || b[0].c[j].dead { continue; }
    kind := ifx hex then RS_NECROTIC else RS_FORCE;
    sp := ifx hex then SP_HEX else SP_HUNTERS_MARK;
    extra := rs_resisted(b, j, rs_sum(b[0].dice[..], mult, 6), kind);
    h: [1] RsLine;
    rs_add_text(h[..], "  "); rs_add_name(h[..], b, j); rs_add_text(h[..], " takes "); rs_add_int(h[..], extra);
    rs_add_text(h[..], ifx hex then " Necrotic from Hex" else " Force from Hunter's Mark");
    rs_tell(b, RS_EV_DAMAGE, sp, i, j, extra, kind, h[..]);
    rs_damage(b, i, j, extra, kind, crit, sp);
  }
}
// The end of creature j's own next turn: the one running, or the one coming.
rs_own_turn_end :: (b: [] RsBattle, j: int) -> int {
  return ifx rs_turn_owner(b) == j then b[0].c[j].turn_at + rs_beat(b) else b[0].c[j].turn_at;
}
// The tick of creature j's next turn still to end (-1: no such creature, or it takes no more turns).
rs_effect_owner_turn :: (b: [] RsBattle, j: int) -> int {
  return ifx j >= 0 && j < b[0].n && !b[0].c[j].dead then b[0].c[j].turn_at else -1;
}
// Whether i can use weapon w's mastery property m (Weapon Mastery).
rs_mastery :: (b: [] RsBattle, i: int, w: int, m: int) -> bool { return rs_weapon(w).mastery == m && (b[0].c[i].masteries & (1 << m)) != 0; }

// Within 5 feet: distances are whole squares, so less than two of them.
rs_beside_ft :: (feet: int) -> bool { return feet < 2 * RS_SQUARE; }
// What Resistance, Vulnerability or Immunity did to `before`, for a damage line: nothing when it is unchanged.
rs_resist_note :: (l: [] RsLine, got: int, before: int) {
  if got > before { rs_add_text(l, ", vulnerable"); }
  else if got < before { rs_add_text(l, ifx got == 0 then ", immune" else ", resisted"); }
}
// Sneak Attack's ally: one of i's side other than i, standing and not Incapacitated, within 5 feet of j.
rs_sneak_ally :: (b: [] RsBattle, i: int, j: int) -> bool {
  for k: 0..<b[0].n {
    c := b[0].c[k];
    if k != i && c.team == b[0].c[i].team && rs_up(c) && !rs_has(c, RS_INCAPACITATED) && rs_beside_ft(rs_feet_to(b, k, j)) { return true; }
  }
  return false;
}
// One attack roll with i's weapon at j, and its damage. `bare` drops the ability modifier from the
// damage (Cleave's second attack). Along the way: Improved Critical, Sacred Weapon, Sneak Attack,
// Colossus Slayer, the Berserker's Frenzy, Deflect Attacks, the Graze, Sap, Vex and Slow masteries,
// Hex and Hunter's Mark. True on a hit.
// Room for what one attack at j alone can leave (strike-admission.coax).
rs_strike_fits :: (b: [] RsBattle, i: int, j: int, w: int) -> bool { return rs_strikes_fit(b,i,j,w,1,false); }
rs_strike :: (b: [] RsBattle, i: int, j: int, w: int, bare: bool) -> bool {
  if !rs_strike_fits(b,i,j,w) { return false; }
  c := b[0].c[i];
  return rs_strike_resolved(b,i,j,w,bare,rs_weapon(w),rs_weapon_attack(c,w),rs_attack_ability(c,w),rs_mod(c.score[rs_attack_ability(c,w)]));
}
// Both ordinary weapons and printed stat-block numbers use this executor.
// Callers preflight any retained riders before spending; the natural melee
// stat record has no weapon mastery or Finesse rider to reserve.
rs_strike_resolved :: (b: [] RsBattle, i: int, j: int, w: int, bare: bool, wp: RsWeapon, printed_bonus: int, ab: int, damage_modifier: int) -> bool {
  me := b[0].c[i];
  strength := ab == RS_STR;
  rs_rest_interrupt_at(b[0].c,i);
  b[0].turn.struck = true;
  melee := wp.range_ft <= 5 || (wp.both && rs_beside_ft(rs_feet_to(b, i, j)));   // Arcane Burst: melee from 5 feet
  // Knocking Out (p.17): only this melee attack's own damage, never a Reaction it provokes
  ko_prev := b[0].ko_by; b[0].ko_by = ifx melee && me.knockout then i + 1 else 0;
  edge := rs_attack_edge(b, i, j, melee, strength);
  // long range: Disadvantage, which cancels an Advantage
  if !melee && rs_feet_to(b, i, j) > wp.range_ft { edge = ifx edge == 1 then 0 else -1; }
  bonus := printed_bonus;
  // Sacred Weapon: its Charisma modifier (at least +1) on the attack rolls of a melee weapon
  sacred := rs_strike_sacred(melee,w,rs_aura_on(me, EF_SACRED, b[0].clock));
  if sacred { bonus += rs_max(rs_mod(me.score[RS_CHA]), 1); }
  // Improved Critical: weapons and Unarmed Strikes score a Critical Hit on 20 - crit_range or higher
  r := rs_roll_attack(b, i, j, edge, bonus, 20 - me.rank[RS_RK_CRIT_RANGE], false);
  rs_unhide(b,i);   // a hidden attacker gives itself away once the roll hits or misses (p.16, p.183)
  // Parry (a Knight's or a Warrior Veteran's Reaction, holding a weapon): +2 AC against a melee hit
  if r.hit && !r.crit && melee && rs_has_feature(b[0].c[j], RS_FT_PARRY) && !b[0].c[j].reacted && rs_capable(b[0].c[j]) && r.total < r.ac + 2 {
    b[0].c[j].reacted = true; r.hit = false; r.ac += 2; r.parry = true;
  }
  crit := r.crit;
  hit := r.hit;
  if hit && rs_condition_critical(b[0].c[j],rs_feet_to(b,i,j)) { crit = true; }
  // Divine Smite follows a hit with a Melee weapon or an Unarmed Strike
  b[0].turn.last_hit = ifx hit && melee then j + 1 else 0;
  b[0].turn.last_crit = crit;
  l: [1] RsLine;
  rs_add_name(l[..], b, i); rs_add_text(l[..], ifx melee then " attacks " else " shoots "); rs_add_name(l[..], b, j); rs_add_text(l[..], " with ");
  rs_add_text(l[..], ifx w == W_UNARMED then "an Unarmed Strike" else wp.name);
  rs_add_text(l[..], ": "); rs_add_roll(l[..], r, bonus);
  rs_add_text(l[..], ifx crit then ": critical hit" else ifx hit then ": hit" else ": miss");
  rs_tell(b, ifx hit then RS_EV_ATTACK else RS_EV_MISS, -1, i, j, r.total, ifx crit then 1 else 0, l[..]);
  if !hit {
    // Graze: a miss still deals the attack's ability modifier
    gm := rs_mod(me.score[ab]);
    if rs_mastery(b, i, w, M_GRAZE) && gm > 0 && !b[0].c[j].dead {
      g := rs_resisted(b, j, gm, wp.damage);
      gl: [1] RsLine;
      rs_add_text(gl[..], "  Graze: "); rs_add_name(gl[..], b, j); rs_add_text(gl[..], " takes "); rs_add_int(gl[..], g); rs_add_text(gl[..], " "); rs_add_text(gl[..], RS_DAMAGE[wp.damage]);
      weapon_only := -1;   // no spell: a weapon's own damage
      rs_tell(b, RS_EV_DAMAGE, weapon_only, i, j, g, wp.damage, gl[..]);
      rs_damage(b, i, j, g, wp.damage, false, weapon_only);
    }
    b[0].ko_by = ko_prev;
    return false;
  }
  tg := b[0].c[j];
  // the damage: the weapon's dice (a Monk's Martial Arts die unarmed; 1 + Strength for anyone else)
  ndice := wp.dice; sides := wp.sides;
  if w == W_UNARMED && me.rank[RS_RK_MARTIAL_DIE] > 0 { ndice = 1; sides = me.rank[RS_RK_MARTIAL_DIE]; }
  mult := ifx crit then 2 else 1;
  rolled := ifx ndice > 0 then rs_sum(b[0].dice[..], ndice * mult, sides) else rs_strike_flat_base(w);
  mod := damage_modifier;
  amount := rolled;
  adds := !(bare || wp.bare) || mod < 0;   // Radiant Flame adds no modifier; a penalty always counts
  if adds { amount += mod; }
  rage := 0;
  if rs_effect(me, EF_RAGE) && strength { rage = me.rank[RS_RK_RAGE_BONUS]; amount += rage; }
  frenzy := 0;
  if rs_frenzy_turn(me,strength,b[0].clock,rs_turn_owner(b)==i,b[0].turn.frenzied) {
    b[0].turn.frenzied = true;
    frenzy = rs_sum(b[0].dice[..], me.rank[RS_RK_RAGE_BONUS] * mult, 6); amount += frenzy;
  }
  // Sneak Attack: once a turn, with a Finesse or Ranged weapon, with Advantage, or with an ally
  // beside the target (not Incapacitated) and no Disadvantage
  sneak := 0; plan := CS_NONE;
  if me.rank[RS_RK_SNEAK_DICE] > 0 && !b[0].turn.sneaked && (wp.finesse || !melee) && w != W_UNARMED {
    if r.edge > 0 || (rs_sneak_ally(b, i, j) && r.edge >= 0) {
      b[0].turn.sneaked = true;
      // Cunning Strike (p. 63): a die forgone, before the roll, for the planned effect
      dice_n := me.rank[RS_RK_SNEAK_DICE];
      want := me.note[RS_NT_STRIKE_PLAN];
      if rs_has_feature(me, RS_FT_CUNNING_STRIKE) && want != CS_NONE && (want != CS_POISON || rs_has_feature(me, RS_FT_POISON_KIT)) && dice_n > 1 { dice_n -= 1; plan = want; }
      sneak = rs_sum(b[0].dice[..], dice_n * mult, 6); amount += sneak;
    }
  }
  // Colossus Slayer: 1d8 more, once a turn, on a creature missing any of its Hit Points
  colossus := 0;
  if rs_has_feature(me, RS_FT_COLOSSUS) && !b[0].turn.colossus && tg.hp < tg.hp_max && w != W_UNARMED {
    b[0].turn.colossus = true; colossus = rs_sum(b[0].dice[..], mult, 8); amount += colossus;
  }
  weak := 0;
  if rs_effect(me, EF_ENFEEBLED) { weak = rs_roll(b[0].dice[..], 8); }
  amount = rs_max(amount - weak, 0);
  // Sacred Weapon: its normal damage type or Radiant, whichever hurts more
  kind := wp.damage;
  if sacred && rs_resisted(b, j, amount, RS_RADIANT) > rs_resisted(b, j, amount, kind) { kind = RS_RADIANT; }
  // Empowered Strikes (p. 51): an Unarmed Strike deals Force if that hurts more
  if w == W_UNARMED && rs_has_feature(me, RS_FT_EMPOWERED_STRIKES) && rs_resisted(b, j, amount, RS_FORCE) > rs_resisted(b, j, amount, kind) { kind = RS_FORCE; }
  dl: [1] RsLine;
  rs_add_text(dl[..], "  "); rs_add_name(dl[..], b, j); rs_add_text(dl[..], " takes ");
  // Deflect Attacks: a Monk's Reaction cuts Bludgeoning, Piercing or Slashing damage from a hit
  cut := 0;
  if rs_has_feature(tg, RS_FT_DEFLECT) && !tg.reacted && rs_capable(tg) && (kind == RS_BLUDGEONING || kind == RS_PIERCING || kind == RS_SLASHING) {
    b[0].c[j].reacted = true;
    cut = rs_roll(b[0].dice[..], 10) + rs_mod(tg.score[RS_DEX]) + tg.level;
  }
  before := rs_max(amount - cut, 0);
  dealt := rs_resisted(b, j, before, kind);
  resisted := dealt;
  // Uncanny Dodge (p. 63): a Reaction halves an attack's damage (round down)
  dodged := false;
  if rs_has_feature(tg, RS_FT_UNCANNY_DODGE) && !b[0].c[j].reacted && rs_capable(tg) && dealt > 0 && rs_up(b[0].c[i]) { b[0].c[j].reacted = true; dealt = dealt / 2; dodged = true; }
  rs_add_int(dl[..], dealt); rs_add_text(dl[..], " "); rs_add_text(dl[..], RS_DAMAGE[kind]); rs_add_text(dl[..], " (");
  if ndice > 0 { rs_add_int(dl[..], ndice * mult); rs_add_text(dl[..], "d"); rs_add_int(dl[..], sides); } else { rs_add_int(dl[..],rolled); }
  if adds { rs_add_text(dl[..], " + "); rs_add_int(dl[..], mod); }
  if rage > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], rage); rs_add_text(dl[..], " Rage"); }
  if frenzy > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], frenzy); rs_add_text(dl[..], " Frenzy"); }
  if sneak > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], sneak); rs_add_text(dl[..], " Sneak Attack"); }
  if colossus > 0 { rs_add_text(dl[..], " + "); rs_add_int(dl[..], colossus); rs_add_text(dl[..], " Colossus Slayer"); }
  if weak > 0 { rs_add_text(dl[..], ", -"); rs_add_int(dl[..], weak); rs_add_text(dl[..], " enfeebled"); }
  if cut > 0 { rs_add_text(dl[..], ", Deflect Attacks -"); rs_add_int(dl[..], cut); }
  if dodged { rs_add_text(dl[..], ", halved by Uncanny Dodge"); }
  else { rs_resist_note(dl[..], resisted, before); }
  rs_add_text(dl[..], ")");
  no_spell := -1;   // a weapon's own damage
  rs_tell_ft(b, RS_EV_DAMAGE, no_spell, i, j, dealt, kind, ifx sneak > 0 then RS_FT_SNEAK_ATTACK else RS_FT_NONE, dl[..]);
  rs_damage(b, i, j, dealt, kind, crit, no_spell);
  // a stat block's extra damage of a second type on a hit (a Knight's Radiant, a Fanatic's Necrotic)
  if (wp.plus_dice > 0 || wp.plus_flat > 0) && !b[0].c[j].dead {
    extra := wp.plus_flat + rs_sum(b[0].dice[..], wp.plus_dice * mult, wp.plus_sides);   // no dice: nothing rolled
    got := rs_resisted(b, j, extra, wp.plus_kind);
    pl: [1] RsLine;
    rs_add_text(pl[..], "  "); rs_add_name(pl[..], b, j); rs_add_text(pl[..], " takes "); rs_add_int(pl[..], got); rs_add_text(pl[..], " "); rs_add_text(pl[..], RS_DAMAGE[wp.plus_kind]);
    rs_add_text(pl[..], " (");
    if wp.plus_dice > 0 { rs_add_int(pl[..], wp.plus_dice * mult); rs_add_text(pl[..], "d"); rs_add_int(pl[..], wp.plus_sides); } else { rs_add_int(pl[..], wp.plus_flat); }
    rs_resist_note(pl[..], got, extra);
    rs_add_text(pl[..], ")");
    rs_tell(b, RS_EV_DAMAGE, no_spell, i, j, got, wp.plus_kind, pl[..]);
    rs_damage(b, i, j, got, wp.plus_kind, crit, no_spell);
  }
  // a stat block's damage only with Advantage (a Goblin's Scimitar and Shortbow, monster-traits.coax)
  if rs_advantage_rider(r.edge, wp.adv_dice) && !b[0].c[j].dead {
    extra := rs_resisted(b, j, rs_sum(b[0].dice[..], wp.adv_dice * mult, wp.adv_sides), kind);
    al: [1] RsLine;
    rs_add_text(al[..], "  "); rs_add_name(al[..], b, j); rs_add_text(al[..], " takes "); rs_add_int(al[..], extra); rs_add_text(al[..], " "); rs_add_text(al[..], RS_DAMAGE[kind]);
    rs_add_text(al[..], " more (Advantage)");
    rs_tell(b, RS_EV_DAMAGE, no_spell, i, j, extra, kind, al[..]);
    rs_damage(b, i, j, extra, kind, crit, no_spell);
  }
  // Hex and Hunter's Mark hold for any attack roll their caster hits with
  rs_curse_damage(b, i, j, crit);
  if plan != CS_NONE { rs_cunning_effect(b, i, j, plan); }
  if rs_stun_weapon(w) { rs_stunning_strike(b, i, j); }
  // the masteries that follow a hit: Sap (Disadvantage on its next attack roll before the start of
  // the attacker's next turn), Vex (Advantage on the attacker's next attack roll against it before
  // the end of its next turn), Slow (10 feet less Speed until the start of the attacker's next turn)
  if rs_up(b[0].c[j]) {
    if rs_mastery(b, i, w, M_SAP) {
      _ := rs_put_effect(b, j, RsEffect.{kind = EF_WEAK, by = i, spell = -1, until = rs_next_turn_tick(b, i), save = -1, dc = 0});
    }
    if rs_mastery(b, i, w, M_VEX) && dealt > 0 {
      _ := rs_put_effect(b, i, RsEffect.{kind = EF_VEX, cond = j, by = i, spell = -1, until = rs_next_turn_tick(b, i), turn_end = i + 1, save = -1, dc = 0});
    }
    if rs_mastery(b, i, w, M_SLOW) && dealt > 0 { _ := rs_put_effect(b, j, RsEffect.{kind = EF_SLOWED, by = i, spell = -1, until = rs_next_turn_tick(b, i), save = -1}); }
  }
  // all damage cut away: the Monk may spend a Focus Point to send the force back at a melee attacker
  if cut > 0 && amount - cut <= 0 && b[0].c[j].uses[RS_USE_FOCUS] > 0 && rs_up(b[0].c[j]) && rs_up(b[0].c[i]) {
    b[0].c[j].uses[RS_USE_FOCUS] -= 1;
    dc := rs_focus_dc(b[0].c[j]);
    saving := rs_saving_throw(b,i,RS_DEX,dc);
    st := saving.total;
    rl: [1] RsLine;
    rs_add_name(rl[..], b, j); rs_add_text(rl[..], " redirects the blow: "); rs_add_name(rl[..], b, i);
    rs_add_text(rl[..], " DEX save "); rs_add_int(rl[..], st); rs_add_text(rl[..], " vs DC "); rs_add_int(rl[..], dc);
    if saving.passed { rs_add_text(rl[..], ": success"); rs_tell(b, RS_EV_SAVE, no_spell, j, i, st, 0, rl[..]); }
    else {
      back := rs_sum(b[0].dice[..], 2, b[0].c[j].rank[RS_RK_MARTIAL_DIE]) + rs_mod(b[0].c[j].score[RS_DEX]);
      rs_add_text(rl[..], ": failure, "); rs_add_int(rl[..], back); rs_add_text(rl[..], " "); rs_add_text(rl[..], RS_DAMAGE[kind]);
      rs_tell(b, RS_EV_DAMAGE, no_spell, j, i, back, kind, rl[..]);
      rs_damage(b, j, i, rs_resisted(b, i, back, kind), kind, false, no_spell);
    }
  }
  b[0].ko_by = ko_prev;
  return true;
}

// The Attack action: one attack with its weapon at j (5 feet away). `reckless` attacks recklessly
// (a Barbarian's first attack in a turn); `cleave_to`, when the weapon's Cleave mastery applies, is
// a second creature within 5 feet of j and of the attacker (-1 none).
// The Attack action at j, plainly: no Reckless Attack, no Cleave.
rs_attack_action :: (b: [] RsBattle, i: int, j: int) -> bool { return rs_attack(b, i, j, false, -1); }
rs_attack :: (b: [] RsBattle, i: int, j: int, reckless: bool, cleave_to: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_can_act(b[0].c[i]) { return false; }
  if b[0].c[i].wild_form != 0 { return rs_stat_multiattack(b, i, j, rs_monster_action(b[0].c[i].wild_form)); }   // Wild Shape: the Beast's Action
  if b[0].c[i].shape_form != 0 { return rs_stat_multiattack(b, i, j, rs_monster_action(b[0].c[i].shape_form)); }   // Shapechange: the form's Action
  if j < 0 || j >= b[0].n || b[0].c[j].dead || j == i || !rs_beside_ft(rs_feet_to(b, i, j)) || rs_charmed_by(b[0].c[i],j) { return false; }
  w := b[0].c[i].weapon;
  if !rs_strikes_fit(b,i,j,w,1+b[0].c[i].rank[RS_RK_EXTRA_ATTACK],true) { return false; }
  b[0].turn.action = true;
  if reckless && b[0].c[i].level >= 2 && b[0].c[i].klass == RS_BARBARIAN && !rs_aura_on(b[0].c[i], EF_RECKLESS, b[0].clock)
     && rs_put_effect(b, i, RsEffect.{kind = EF_RECKLESS, by = i, spell = -1, until = rs_next_turn_tick(b, i), save = -1}) {
    l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " attacks recklessly");
    rs_tell(b, RS_EV_CONDITION, -1, i, i, 0, 0, l[..]);
  }
  hit := rs_strike(b, i, j, w, false);
  k := cleave_to;
  if hit && rs_mastery(b, i, w, M_CLEAVE) && !b[0].turn.cleaved && k >= 0 && k < b[0].n && k != j && k != i
     && !b[0].c[k].dead && b[0].c[k].team != b[0].c[i].team && rs_beside_ft(rs_feet_to(b, i, k)) && rs_beside_ft(rs_feet_to(b, j, k)) {
    b[0].turn.cleaved = true;
    l: [1] RsLine; rs_add_text(l[..], "  Cleave carries on into "); rs_add_name(l[..], b, k);
    rs_tell(b, RS_EV_CONDITION, -1, i, k, 0, 0, l[..]);
    _ := rs_strike(b, i, k, w, true);
  }
  rs_after_blow(b, i);
  // Extra Attack (p. 29, 48, 51, 55, 59): the Attack action's other attacks, at the same foe while
  // it stands, else another beside it
  for e: 0..<b[0].c[i].rank[RS_RK_EXTRA_ATTACK] {
    t := ifx rs_up(b[0].c[j]) then j else rs_beside(b, i);
    if t < 0 || !rs_can_act(b[0].c[i]) { break; }
    _ := rs_strike(b, i, t, w, false);
    rs_after_blow(b, i);
  }
  return true;
}
// A saving throw's bonus in the battle: the creature's own, and Aura of Protection (p. 55): a
// Paladin's Charisma modifier (at least +1) to itself and its allies within 10 feet, unless it is
// Incapacitated; only the best aura counts.
rs_aura :: (b: [] RsBattle, j: int) -> int {
  best := 0;
  for k: 0..<b[0].n {
    if !rs_has_feature(b[0].c[k], RS_FT_AURA_OF_PROTECTION) { continue; }
    p := b[0].c[k];
    if p.team != b[0].c[j].team || !rs_capable(p) || rs_feet_to(b, k, j) >= 3 * RS_SQUARE { continue; }   // (rs_capable: not Incapacitated)
    best = rs_max(best, rs_max(rs_mod(p.score[RS_CHA]), 1));
  }
  return best;
}
rs_save_in :: (b: [] RsBattle, j: int, ability: int) -> int { return rs_save_bonus(b[0].c[j], ability) + rs_aura(b, j); }
// Stunning Strike (p. 51): once a turn, on a hit with an Unarmed Strike or a Monk weapon, 1 Focus
// Point; a Con save against its Focus DC or Stunned until the start of the Monk's next turn; on a
// success, half Speed and Advantage on the next attack roll against it until then.
rs_stunning_strike :: (b: [] RsBattle, i: int, j: int) {
  me := b[0].c[i];
  if !rs_stun_ready(me,b[0].turn.stunned) { return; }
  if !rs_up(b[0].c[j]) || rs_has(b[0].c[j], RS_STUNNED) { return; }
  if rs_effect_free(b[0].c[j]) < 2 { return; }   // saved against: half Speed and the next attack's Advantage
  b[0].turn.stunned = true; b[0].c[i].uses[RS_USE_FOCUS] -= 1;
  dc := rs_focus_dc(me);
  saving := rs_saving_throw(b,j,RS_CON,dc);
  total := saving.total; ok := saving.passed;
  until := rs_next_turn_tick(b, i);
  l: [1] RsLine;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, i); rs_add_text(l[..], " spends a Focus Point on a Stunning Strike: "); rs_add_name(l[..], b, j);
  rs_add_text(l[..], " CON save "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
  rs_add_text(l[..], ifx ok then ": success, half Speed and exposed" else ": failure, Stunned");
  rs_tell_ft(b, ifx ok then RS_EV_SAVE else RS_EV_CONDITION, -1, i, j, total, 0, RS_FT_STUNNING_STRIKE, l[..]);
  if ok {
    _ := rs_put_effect(b, j, RsEffect.{kind = EF_HALVED, by = i, spell = -1, until = until, save = -1});
    _ := rs_put_effect(b, j, RsEffect.{kind = EF_EXPOSED, by = i, spell = -1, until = until, save = -1});
  } else {
    _ := rs_put_effect(b, j, RsEffect.{kind = EF_COND, cond = RS_STUNNED, by = i, spell = -1, until = until, save = -1});
  }
}
// Cunning Strike's effects, after the damage (p. 63): a save against 8 + Dex + Proficiency.
CS_NONE :: 0; CS_TRIP :: 1; CS_POISON :: 2; CS_WITHDRAW :: 3;
rs_cunning_effect :: (b: [] RsBattle, i: int, j: int, plan: int) {
  me := b[0].c[i];
  if plan == CS_WITHDRAW {
    rs_say(b, RS_EV_CONDITION, i, i, 0, ": Cunning Strike, Withdraw");
    if b[0].who == i && !b[0].turn.anchored { b[0].turn.move_left += me.speed / RS_SQUARE / 2; }
    return;
  }
  if !rs_up(b[0].c[j]) { return; }
  trip := plan == CS_TRIP;
  poisoned := RS_POISONED;
  if plan == CS_POISON && rs_effect_condition_mask(b[0].c[j],poisoned) != 0 && rs_effect_free(b[0].c[j]) < 1 { return; }
  if trip && rs_has(b[0].c[j], RS_PRONE) { return; }
  ability := ifx trip then RS_DEX else RS_CON;
  dc := 8 + rs_mod(me.score[RS_DEX]) + rs_proficiency(me.level);
  saving := rs_saving_throw(b,j,ability,dc);
  total := saving.total;
  ok := saving.passed;
  if !trip && (b[0].c[j].immune_cond & poisoned) != 0 { ok = true; }
  l: [1] RsLine;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], ifx trip then " Cunning Strike, Trip: DEX save " else " Cunning Strike, Poison: CON save ");
  if saving.automatic { rs_add_text(l[..], "automatic failure"); }
  else { rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc); }
  rs_add_text(l[..], ifx ok then ": success" else ifx trip then ": failure, Prone" else ": failure, Poisoned");
  rs_tell(b, ifx ok then RS_EV_SAVE else RS_EV_CONDITION, -1, i, j, total, 0, l[..]);
  if ok { return; }
  if trip { b[0].c[j].cond = b[0].c[j].cond | RS_PRONE; }
  else { _ := rs_put_effect(b, j, RsEffect.{kind = EF_COND, cond = poisoned, by = i, spell = -1, until = b[0].clock + rs_secs(60), save = RS_CON, dc = dc}); }
}
// A foe standing within 5 feet of i, or -1.
rs_beside :: (b: [] RsBattle, i: int) -> int {
  for k: 0..<b[0].n {
    if k != i && rs_up(b[0].c[k]) && b[0].c[k].team != b[0].c[i].team && rs_beside_ft(rs_feet_to(b, i, k)) { return k; }
  }
  return -1;
}
// After each attack: Remarkable Athlete (p. 49) moves half its Speed after a Critical Hit.
rs_after_blow :: (b: [] RsBattle, i: int) {
  if b[0].turn.last_crit && rs_has_feature(b[0].c[i], RS_FT_ATHLETE) && !b[0].turn.anchored { b[0].turn.move_left += b[0].c[i].speed / RS_SQUARE / 2; b[0].turn.last_crit = false; }
}

// The Attack action with its ranged weapon, at j within its long range.
rs_shoot :: (b: [] RsBattle, i: int, j: int) -> bool {
  if b[0].who != i || b[0].turn.action || !rs_can_act(b[0].c[i]) || b[0].c[i].ranged < 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || j == i || rs_feet_to(b, i, j) > rs_weapon(b[0].c[i].ranged).long_ft { return false; }
  if !rs_strikes_fit(b,i,j,b[0].c[i].ranged,1+b[0].c[i].rank[RS_RK_EXTRA_ATTACK],false) { return false; }
  b[0].turn.action = true;
  _ := rs_strike(b, i, j, b[0].c[i].ranged, false);
  rs_after_blow(b, i);
  for e: 0..<b[0].c[i].rank[RS_RK_EXTRA_ATTACK] {
    if !rs_up(b[0].c[j]) || !rs_can_act(b[0].c[i]) { break; }
    _ := rs_strike(b, i, j, b[0].c[i].ranged, false);
    rs_after_blow(b, i);
  }
  return true;
}

// Martial Arts: an Unarmed Strike as a Bonus Action.
rs_bonus_strike :: (b: [] RsBattle, i: int, j: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].rank[RS_RK_MARTIAL_DIE] <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || !rs_beside_ft(rs_feet_to(b, i, j)) { return false; }
  unarmed := W_UNARMED;
  if !rs_strike_fits(b,i,j,unarmed) { return false; }
  b[0].turn.bonus = true;
  _ := rs_strike(b, i, j, unarmed, false);
  return true;
}
// Open Hand Technique, on a creature hit by Flurry of Blows.
OH_ADDLE :: 0; OH_PUSH :: 1; OH_TOPPLE :: 2;
rs_open_hand :: (b: [] RsBattle, i: int, j: int, how: int) {
  if !rs_has_feature(b[0].c[i], RS_FT_OPEN_HAND) || !rs_up(b[0].c[j]) { return; }
  l: [1] RsLine;
  if how == OH_ADDLE {
    if !rs_state_room(b[0].c[j], EF_ADDLED) { return; }   // a full list takes no record: it is not addled, and nothing is told
    rs_opportunity_suppress(b[0].c[j..<j+1]);
    rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " is addled: no Opportunity Attacks until its next turn");
    rs_tell(b, RS_EV_CONDITION, -1, i, j, 0, 0, l[..]);
    return;
  }
  ab := ifx how == OH_PUSH then RS_STR else RS_DEX;
  dc := rs_focus_dc(b[0].c[i]);
  saving := rs_saving_throw(b,j,ab,dc);
  total := saving.total; saved := saving.passed;
  rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " "); rs_add_text(l[..], RS_ABBR[ab]); rs_add_text(l[..], " save ");
  rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], dc);
  if saved { rs_add_text(l[..], ": success"); rs_tell(b, RS_EV_SAVE, -1, i, j, total, 0, l[..]); return; }
  if how == OH_TOPPLE {
    b[0].c[j].cond = b[0].c[j].cond | RS_PRONE;
    rs_add_text(l[..], ": knocked Prone");
    rs_tell(b, RS_EV_CONDITION, -1, i, j, RS_PRONE, 0, l[..]);
    return;
  }
  dx := rs_sign(b[0].c[j].x - b[0].c[i].x); dy := rs_sign(b[0].c[j].y - b[0].c[i].y);
  moved := 0;
  for n: 0..<3 {
    nx := b[0].c[j].x + dx; ny := b[0].c[j].y + dy;
    if nx < 0 || ny < 0 || nx >= b[0].w || ny >= b[0].h || rs_at(b, nx, ny) >= 0 { break; }
    rs_truth_move(b,j,nx,ny); moved += 1;
  }
  rs_add_text(l[..], ": pushed "); rs_add_int(l[..], moved * RS_SQUARE); rs_add_text(l[..], " feet");
  rs_tell(b, RS_EV_PUSH, -1, i, j, moved * RS_SQUARE, 0, l[..]);
}
// Flurry of Blows: 1 Focus Point, two Unarmed Strikes as a Bonus Action; each hit can carry an
// Open Hand Technique.
rs_flurry :: (b: [] RsBattle, i: int, j: int, how: int) -> bool {
  if b[0].who != i || b[0].turn.bonus || !rs_can_act(b[0].c[i]) || b[0].c[i].uses[RS_USE_FOCUS] <= 0 { return false; }
  if j < 0 || j >= b[0].n || b[0].c[j].dead || !rs_beside_ft(rs_feet_to(b, i, j)) { return false; }
  unarmed := W_UNARMED;
  blows := 2;
  if !rs_strikes_fit(b,i,j,unarmed,blows,false) { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_FOCUS] -= 1;
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " spends a Focus Point on Flurry of Blows");
  rs_tell_ft(b, RS_EV_CONDITION, -1, i, i, 0, 0, RS_FT_FLURRY, l[..]);
  for k: 0..<blows {
    if b[0].c[j].dead || !rs_beside_ft(rs_feet_to(b, i, j)) { break; }
    if rs_strike(b, i, j, unarmed, false) { rs_open_hand(b, i, j, how); }
  }
  return true;
}
// Patient Defense with a Focus Point: Disengage and Dodge as a Bonus Action.
rs_patient_defense :: (b: [] RsBattle, i: int) -> bool {
  if !rs_disengage_use(b,i,RS_DISENGAGE_DODGE) { return false; }
  l: [1] RsLine; rs_add_name(l[..], b, i); rs_add_text(l[..], " spends a Focus Point on Patient Defense: Disengage and Dodge");
  rs_tell_ft(b, RS_EV_CONDITION, -1, i, i, 0, 0, RS_FT_PATIENT_DEFENSE, l[..]);
  return true;
}
// Step of the Wind without a Focus Point: Dash as a Bonus Action (its Speed again).
rs_step_of_the_wind :: (b: [] RsBattle, i: int) -> bool {
  return rs_dash_use(b,i,RS_DASH_WIND);
}
