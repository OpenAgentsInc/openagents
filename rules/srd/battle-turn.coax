// The turn's lifecycle (GitHub #13287, split from battle.coax): rs_walk_speed to rs_team_up. Speed, the
// start and end of a turn, the clock's tick, standing up and who is left standing.
// Its own checks are battle-turn-checks.coax, which battle.coax loads.
//   coax/bin/coax mutate rules/srd/battle.coax --library --unit rules/srd/battle-turn.coax --traversal 16000000000
#authority;

rs_walk_speed :: (b: [] RsBattle, i: int) -> int #effects(all) {
  speed := rs_exhaustion_speed(b[0].c[i].exhaustion,b[0].c[i].speed - (ifx rs_aura_on(b[0].c[i], EF_SLOWED, b[0].clock) then 10 else 0));
  if rs_aura_on(b[0].c[i], EF_HALVED, b[0].clock) { speed = speed/2; }
  if rs_guarded(b,i) { speed = speed/2; }
  return speed;
}
// Standing is a movement choice, not a turn-start consequence or an Action.
rs_stand_up :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  if i < 0 || i >= b[0].n { return false; }
  turn: [1] RsTurn; turn[0] = b[0].turn;
  if b[0].who==i { rs_reprice_movement(turn[..],rs_movement_allowance(b,i)); }
  ok := rs_prone_stand(b[0].c[i..<i+1],turn[..],rs_timing_stand_speed(b[0].timing,rs_walk_speed(b,i)),b[0].who == i);
  if ok { b[0].turn = turn[0]; }
  return ok;
}
// The start of i's turn: what has run out ends and a creature at 0 makes its
// death saving throw. A Prone creature chooses later whether to stand or crawl.
rs_start_turn :: (b: [] RsBattle, i: int) #effects(all) {
  b[0].c[i].familiar_sensing = false;
  rs_seal_timing(b);
  rs_help_start_turn(b,i);
  rs_ready_start_turn(b,i);
  rs_grapple_lapse(b,i);
  _ := rs_stable_recover(b,i);
  concentration_lost := rs_sync_concentration(b,i);
  if !b[0].kept { rs_index(b); }
  b[0].who = i;
  rs_dodge_end(b[0].c[i..<i+1]);
  rs_shield_end(b[0].c[i..<i+1]);
  rs_opportunity_begin(b[0].c[i..<i+1]);
  rs_halt_begin(b[0].c[i..<i+1],b[0].clock+rs_beat(b));
  // The profile declares the movement grant: exact feet in strict mode, or
  // the legacy proportional whole-square grant in action combat.
  // the Slow mastery: 10 feet less
  b[0].turn = RsTurn.{};
  speed := rs_dash_speed(b,i);
  b[0].turn_no += 1;
  feet := rs_timing_move(b[0].timing,speed);
  b[0].turn = RsTurn.{action = false, bonus = false, slot_spent = false, move_left = feet/5, move_feet=feet%5, move_basis=feet, move_tracked=true};
  b[0].turn.new_round = b[0].c[i].turn_at >= b[0].c[i].round_at;
  if b[0].turn.new_round { b[0].c[i].round_at += RS_ROUND_TICKS; }
  b[0].c[i].reacted = false;
  rs_truth_start(b,i);
  rs_rite_turn(b,i);
  if b[0].turn.new_round { rs_dragon_turn_start(b,i); }   // Burning and Recharge, dragon-actions.coax: nothing for one with no fire on it and no breath spent
  if rs_effect(b[0].c[i], EF_RAGE) && !rs_capable(b[0].c[i]) { rs_rage_end(b, i, " (Incapacitated)"); }
  if b[0].c[i].hp == 0 && !b[0].c[i].dead {
    if b[0].c[i].stable || !b[0].turn.new_round { return; }
    r := rs_battle_death_save(b,i);
    l: [1] RsLine;
    rs_add_name(l[..], b, i);
    if r == RS_DS_UP { rs_add_text(l[..], " rolls a 20 on a death save and regains 1 Hit Point"); }
    else if r == RS_DS_BLOCKED { rs_add_text(l[..], " rolls a 20 on a death save but cannot regain Hit Points"); }
    else if r == RS_DS_STABLE { rs_add_text(l[..], " is Stable (three death save successes)"); }
    else if r == RS_DS_DEAD { rs_add_text(l[..], " dies (three death save failures)"); }
    else { rs_add_text(l[..], ifx r == RS_DS_OK then " death save: success (" else " death save: failure (");
           rs_add_int(l[..], b[0].c[i].death_ok); rs_add_text(l[..], " of 3 successes, "); rs_add_int(l[..], b[0].c[i].death_fail); rs_add_text(l[..], " of 3 failures)"); }
    rs_tell(b, ifx r == RS_DS_DEAD then RS_EV_DEATH else ifx r == RS_DS_UP then RS_EV_UP else RS_EV_STABLE, -1, i, i, r, 0, l[..]);
  }
}
// Creature i ends its turn: in a lasting area whose spell says so (Gust of Wind's Line), it makes the
// spell's save again, once a round, and takes what a failure brings. A Line from you blasts from
// where its caster stands now; it points where it was cast (changing it is a Bonus Action the world
// doesn't send).
rs_turn_saves :: (b: [] RsBattle, i: int) #effects(all) {
  if !b[0].turn.new_round || !rs_up(b[0].c[i]) { return; }
  for k: 0..<b[0].zone.count {
    z := b[0].zone[k];
    if !z.on || z.by == i || z.by < 0 || z.by >= b[0].n || b[0].c[z.by].conc != z.spell { continue; }
    sp := rs_spell(z.spell);   // no spell (-1) is a record with no turn_save
    if !sp.turn_save { continue; }
    if z.line && (z.cx != b[0].c[z.by].x || z.cy != b[0].c[z.by].y) {
      z.cx = b[0].c[z.by].x; z.cy = b[0].c[z.by].y;
      z = rs_line_box(z);
      b[0].zone[k] = z;
    }
    if !rs_inside(z, b[0].c[i].x, b[0].c[i].y) { continue; }
    rs_affect(b, z.by, i, z.spell, sp.level, k);
  }
}
rs_end_turn :: (b: [] RsBattle, i: int) #effects(all) {
  // ending its turn in a foe's Spirit Guardians
  rs_guardians(b, i);   // nothing when no Emanation stands
  // ending it in a Gust of Wind
  rs_turn_saves(b, i);
  // the saves it repeats at the end of its turns
  for k: 0..<RS_EFFECTS {
    e := b[0].c[i].eff[k];
    if e.kind == EF_NONE || e.save < 0 || b[0].c[i].dead || !b[0].turn.new_round { continue; }
    ups:=rs_magic_save_ups(b[0].c[i],e.spell>=0)+rs_protection_save_ups(b,i,e);
    saving:=rs_saving_throw_edges(b,i,e.save,e.dc,ups,0);
    total := saving.total; ok := saving.passed;
    l: [1] RsLine;
    rs_add_name(l[..], b, i); rs_add_text(l[..], " "); rs_add_text(l[..], RS_ABBR[e.save]); rs_add_text(l[..], " save against ");
    rs_add_text(l[..], ifx e.spell >= 0 then rs_spell(e.spell).name else "the poison"); rs_add_text(l[..], " "); rs_add_int(l[..], total); rs_add_text(l[..], " vs DC "); rs_add_int(l[..], e.dc);
    rs_add_text(l[..], ifx ok then ": it ends" else ": it holds");
    rs_tell(b, RS_EV_SAVE, e.spell, e.by, i, total, 0, l[..]);
    if ok {
      rs_drop_effect(b, i, k);
      // a spell that ends on a success ends for its caster too (Ray of Enfeeblement)
      if e.kind == EF_ENFEEBLED && e.by >= 0 && e.spell >= 0 && b[0].c[e.by].conc == e.spell { rs_end_concentration(b, e.by, " (the target shook it off)"); }
      // a concentration spell with no one left under it ends (Hold Person on one target)
      if e.by >= 0 && e.spell >= 0 && b[0].c[e.by].conc == e.spell {
        under := false;
        for jj: 0..<b[0].n { for kk: 0..<RS_EFFECTS { if b[0].c[jj].eff[kk].kind != EF_NONE && b[0].c[jj].eff[kk].by == e.by && b[0].c[jj].eff[kk].spell == e.spell { under = true; } } }
        if !under { rs_end_concentration(b, e.by, " (no one left under it)"); }
      }
    }
  }
  // Rage lasts until the end of its next turn; an attack roll against an enemy (or a Bonus Action)
  // in that turn extends it
  if b[0].turn.struck { b[0].c[i].eff = rs_state_bit(b[0].c[i].eff, EF_RAGE, RS_RAGE_STRUCK, true); }
  if rs_effect(b[0].c[i], EF_RAGE) && b[0].turn.new_round {
    if rs_state_has(b[0].c[i], EF_RAGE, RS_RAGE_UPKEEP) { b[0].c[i].eff = rs_state_bit(b[0].c[i].eff, EF_RAGE, RS_RAGE_UPKEEP, false); }   // kept for this round: both bits start the next one clear
    else { rs_rage_end(b, i, ""); }
  }
  rs_halt_finish(b[0].c[i..<i+1]);
  rs_turn_effects_end(b, i, b[0].c[i].turn_at);
  b[0].c[i].turn_at += rs_beat(b);
  rs_disengage_end(b,i);
  if b[0].who == i { b[0].who = -1; }
}
// The clock moves on: what lasts for a time ends when it runs out.
// rs_tick takes a host's frame in seconds and admits it to whole ticks (rest-clock.coax keeps the
// part of a tick left over); rs_tick_ticks takes whole ticks. Inside, time is ticks only.
rs_tick :: (b: [] RsBattle, dt: f32) #effects(all) { admitted:=rs_rest_tick(b,dt); }
rs_tick_ticks :: (b: [] RsBattle, ticks: int) #effects(all) { admitted:=rs_rest_tick_ticks(b,ticks); }
rs_tick_raw :: (b: [] RsBattle, ticks: int) #effects(all) {
  rs_seal_timing(b);
  b[0].clock += ticks;
  t := b[0].clock;
  for i: 0..<b[0].n {
    concentration_lost := rs_sync_concentration(b,i);
    if b[0].c[i].conc >= 0 && b[0].c[i].conc_until <= t { rs_end_concentration(b, i, " (its duration is up)"); }
    if b[0].c[i].wild_form != 0 { rs_wild_shape_lapse(b, i); }
    for k: 0..<RS_EFFECTS { e := b[0].c[i].eff[k]; owner := e.turn_end - 1; if rs_effect_clock_ended(e.kind, owner, e.until, t, rs_effect_owner_turn(b, owner), rs_beat(b)) { rs_drop_effect(b, i, k); } }
    _ := rs_stable_recover(b,i);
    rest_finished := rs_short_rest_finish(b,i);
    // the action adapter: spent slots and uses come back on a cooldown, one at a time
    r := rs_timing_recharge(b[0].timing);   // 0: this profile gives nothing back on a cooldown
    if r != 0 && !b[0].c[i].dead {
      for l: 1..<10 {
        if b[0].c[i].slots[l] >= b[0].c[i].slots_max[l] { b[0].c[i].slot_back[l] = 0; continue; }
        if b[0].c[i].slot_back[l] == 0 { b[0].c[i].slot_back[l] = t + r; }
        else if b[0].c[i].slot_back[l] <= t { b[0].c[i].slots[l] += 1; b[0].c[i].slot_back[l] = 0; }
      }
      // every limited use: one back at a time, points (Sorcery, Bardic Inspiration, Focus) and the
      // Lay On Hands pool (5 Hit Points a time) at half the cooldown
      for u: 0..<RS_USES {
        if b[0].c[i].uses[u] >= b[0].c[i].uses_max[u] { b[0].c[i].uses_back[u] = 0; continue; }
        quick := u == RS_USE_SORCERY || u == RS_USE_INSPIRE || u == RS_USE_LAY || u == RS_USE_FOCUS;
        if b[0].c[i].uses_back[u] == 0 { b[0].c[i].uses_back[u] = t + (ifx quick then r / 2 else r); }
        else if b[0].c[i].uses_back[u] <= t {
          b[0].c[i].uses[u] = rs_min(b[0].c[i].uses[u] + (ifx u == RS_USE_LAY then 5 else 1), b[0].c[i].uses_max[u]);
          b[0].c[i].uses_back[u] = 0;
        }
      }
    }
  }
  rs_expire_zones(b);
}
rs_team_up :: (b: [] RsBattle, team: int) -> int #effects(all) {
  n := 0;
  for i: 0..<b[0].n { if b[0].c[i].team == team && !b[0].c[i].dead && b[0].c[i].hp > 0 { n += 1; } }   // rs_up, without copying each creature
  return n;
}
