// Creatures a small battle's room holds (RsRoom). A world that fields more gives the
// battle room of its own with rs_use (5E Lab's armies: 1024 heroes and 16384 of the dead), so the
// other worlds' state stays small. Worlds keep their RsBattle in their state, never on the stack
// (rs_reset clears one in place).
RS_MAX :: 216;
// Squares a battle indexes of its own (rs_at's occupancy, 128 by 64); rs_use gives more, and a
// grid larger than the room scans its creatures.
RS_SQUARES :: 8192;
// Zones a battle holds of its own. A world that needs more (a zone of 150 seats: one Concentration
// area a caster) gives a table with rs_use_zones, as it gives creatures with rs_use (#13285,
// #13275). Zone of Truth keeps one bit a zone on each creature, so a Zone of Truth takes one of the
// table's first RS_TRUTH_ZONES places; every other area takes any.
RS_ZONES :: 8;
RS_TRUTH_ZONES :: 62;
RsZone :: struct { on: bool; spell: int; by: int; x0: int; y0: int; x1: int; y1: int; until: int; difficult: bool; round: bool; cx: int; cy: int; r_ft: int; truth_dc: int;
                  truth: bool;    // a Zone of Truth: a TRUTH step's area (zone-of-truth.coax)
                  measure: int;   // how its radius and length are measured (measure.coax): the battle's, from rs_area
                  line: bool; dx: f32; dy: f32; half: f32; }   // a Line: from (cx, cy) along (dx, dy), a unit, r_ft long, half (squares) each side
// A turn's economy and what has happened in it: moved (Steady Aim needs none), aimed (Steady Aim's
// Advantage waiting) and anchored (its Speed 0 after), last_hit (1 + whom its last melee weapon
// attack hit, 0 none: Divine Smite follows it) and last_crit, the once-a-turn Sneak Attack and
// Colossus Slayer, leveled (a level 1+ spell cast) and quickened (Quickened Spell used).
RsTurn :: struct { disengaged: bool; action: bool; bonus: bool; slot_spent: bool; move_left: int; move_feet: int; move_basis: int; move_debt: int; move_tracked: bool; dash_n: int; cleaved: bool; frenzied: bool; struck: bool; new_round: bool;
                   moved: bool; aimed: bool; anchored: bool; last_hit: int; last_crit: bool; sneaked: bool; colossus: bool;
                   leveled: bool; quickened: bool; stunned: bool; resurged: bool; walk_ft: f32;
                   run_ft: int; jumps_doubled: bool; }   // feet walked on foot just before a jump; Step of the Wind's doubled jumps
RsReactionFrame :: struct { on:bool; who:int = -1; turn:RsTurn; }
RsBattle :: struct {
  c: [] RsCreature; n: int;   // the creatures: a room's (rs_have), or a world's (rs_use)
  zone: [] RsZone;            // the lasting areas: a room's (rs_have), or a world's (rs_use_zones)
  truth_zones:int;
  dice: [1] RsDice;
  book: [1] RsLog;
  clock: int;   // whole ticks (RS_TICKS a second, engine.coax)
  rest_clock:RsRestClock; rest_auto:bool;
  w: int; h: int;             // the grid, squares
  turn_no: int;               // turns begun, for what happens once a turn
  guards: int;                // Spirit Guardians cast and not yet ended
  aff_used: bool;             // Elemental Affinity's one roll spent in this casting
  who: int;                   // whose turn is running (-1 none)
  turn: RsTurn;
  ko_by: int;                 // 1 + the attacker whose melee attack may knock out (knockout.coax), 0 none
  reaction_frame: RsReactionFrame; // true turn while a Reaction strike borrows acting state
  shape_keeps: [RS_SHAPE_KEEPS] RsShapeKeep; // Shapechange: each changed creature's own numbers, shapechange.coax
  // Strict timing is the default: six-second turns and no automatic recovery.
  // The declared action profile gives 1.5-second turns, proportional rounded
  // movement, slot/Rage/ordinary-use recharge at 9 seconds, Focus and the
  // existing point/pool exceptions at 4.5 seconds.
  // Repeat saves, death saves and Rage upkeep stay on six-second rounds.
  timing: RsTimingProfile;
  areas: RsAreaProfile;      // strict, or a declared house rule sparing the caster or its team (area-origin.coax)
  measure: int;              // RS_MEASURE_GRID, or a declared straight-line measure of ranges and areas (measure.coax)
  walk: int;                 // RS_WALK_PAID or the declared unpaid RS_WALK_RATE (world-profile.coax)
  // A world selects all four together with rs_set_world (world-profile.coax). Every press is paid:
  // no profile refills what a creature spends (#13284).
  timing_sealed: bool;       // configured before begin/turn/tick; reset opens it
  // Who stands on each square (1 + the creature, 0 none), so rs_at is one look rather than a scan
  // of every creature: kept by rs_add, rs_place, rs_step_to and the pushes, and rebuilt at each
  // turn's start (rs_index) for whatever a world moved by hand.
  occ: [] int;
  terrain: [RS_TERRAINS] RsTerrain; covers: [RS_COVERS] RsCover;   // the world's admitted geometry (cover.coax)
  // The world moves creatures only through rs_add, rs_place and the engine's own steps and pushes, so
  // the index stays right and a turn's start needn't rebuild it (5E Lab's crowds: 70,000 squares).
  kept: bool;
}
// The room of a small battle (a check's, a lab's, a room of 16 seats): its keeper declares it beside
// the battle and gives it with rs_have. A battle holds none of its own (#13285).
RsRoom :: struct { c: [RS_MAX] RsCreature; occ: [RS_SQUARES] int; zone: [RS_ZONES] RsZone; }
#load "battle-grid.coax";   // the grid: room, distance, squares, zones and areas (#13287)

#load "battle-tell.coax";   // telling the world: lines and events (#13287)

#load "battle-life.coax";   // creatures in the battle: adding, turn order, dropping, damage (#13287)

#load "battle-cast.coax";   // (#13287)

#load "battle-attack.coax";   // (#13287)

#load "battle-affect.coax";   // (#13287)

#load "battle-turn.coax";   // (#13287)

#load "battle-strike.coax";   // (#13287)

#load "battle-features.coax";   // (#13287)

#test "who stands where: the squares' index follows adds, steps, a world's moves and a reset" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 11;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 1);
  t := rs_add(b[..], rs_skeleton("Skeleton 1", 2), 5, 4);
  #assert rs_at(b[..], 1, 1) == a && rs_at(b[..], 5, 4) == t && rs_at(b[..], 2, 2) == -1;
  rs_start_turn(b[..], a);
  #assert rs_step_to(b[..], a, 2, 2) && rs_at(b[..], 2, 2) == a && rs_at(b[..], 1, 1) == -1;
  #assert !rs_step_to(b[..], a, 2, 2);   // not a square away
  rs_end_turn(b[..], a);
  rs_place(b[..], t, 9, 6);
  #assert rs_at(b[..], 9, 6) == t && rs_at(b[..], 5, 4) == -1;
  // moved by hand: found by the scan until the next turn rebuilds the index
  b[0].c[t].x = 3;
  #assert rs_at(b[..], 3, 6) == -1 || rs_at(b[..], 3, 6) == t;
  rs_start_turn(b[..], a);
  #assert rs_at(b[..], 3, 6) == t && rs_at(b[..], 9, 6) == -1;
  rs_end_turn(b[..], a);
  rs_reset(b[..]);
  #assert b[0].n == 0 && b[0].w == 0 && b[0].clock == 0 && b[0].book[0].seq == 0 && rs_at(b[..], 2, 2) == -1;
}

#test "Starry Wisp: a ranged spell attack, +5, 1d8 Radiant on a hit" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 11;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 1);
  t := rs_add(b[..], rs_druid("Thorn", 1, 3), 8, 1);
  hits := 0; total := 0;
  for k: 0..<200 {
    b[0].c[t].hp = b[0].c[t].hp_max; b[0].c[t].cond = 0;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_STARRY_WISP, 0, 0, 0, t);
    #assert !rs_cast(b[..], a, SP_STARRY_WISP, 0, 0, 0, t);   // one action a turn
    rs_end_turn(b[..], a);
    lost := b[0].c[t].hp_max - b[0].c[t].hp;
    #assert lost >= 0 && lost <= 16;
    if lost > 0 { hits += 1; total += lost; }
  }
  // +5 against AC 15: 11 or higher hits, 55% (a 20 crits)
  #assert hits > 80 && hits < 140;
}
#test "Cure Wounds heals 2d8 + 3 by touch; a 2nd-level slot heals 4d8 + 3; one slot a turn" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 1);
  f := rs_add(b[..], rs_druid("Briar", 0, 3), 2, 1);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 9, 1);
  b[0].c[f].hp = 1;
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, far);   // Touch
  #assert rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, f);
  #assert b[0].c[f].hp >= 1 + 5 && b[0].c[f].hp <= 1 + 19 && b[0].c[a].slots[1] == 3;
  #assert !rs_cast(b[..], a, SP_HEALING_WORD, 1, 0, 0, f);    // the one slot this turn is spent
  rs_end_turn(b[..], a);
  b[0].c[f].hp = 0; b[0].c[f].cond = RS_UNCONSCIOUS | RS_PRONE;
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_HEALING_WORD, 2, 0, 0, f);
  #assert b[0].c[f].hp >= 4 + 3 && !rs_has(b[0].c[f], RS_UNCONSCIOUS) && b[0].c[a].slots[2] == 1;
}
#test "Thunderwave: a 15-foot cube from you, Con save, 2d8 Thunder and pushed 10 feet on a failure" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 3);
  e := rs_add(b[..], rs_druid("Thorn", 1, 3), 3, 3);
  out := rs_add(b[..], rs_druid("Sable", 1, 3), 7, 3);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_THUNDERWAVE, 1, 3, 3, -1);
  lost := b[0].c[e].hp_max - b[0].c[e].hp;
  #assert lost >= 1 && lost <= 16;
  #assert b[0].c[e].x == 3 || b[0].c[e].x == 5;          // stayed (saved) or pushed two squares
  #assert b[0].c[out].hp == b[0].c[out].hp_max;          // outside the cube
}
#test "Thunderwave: whoever stands beside you or in your square is in the cube from you; behind you isn't (#12930)" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 4, 3);
  same := rs_add(b[..], rs_druid("Wren", 1, 3), 4, 3);     // shares your square
  side := rs_add(b[..], rs_druid("Ash", 1, 3), 4, 4);      // at your shoulder
  behind := rs_add(b[..], rs_druid("Moss", 1, 3), 3, 3);   // behind you
  ahead := rs_add(b[..], rs_druid("Fern", 1, 3), 7, 3);    // 15 feet ahead
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_THUNDERWAVE, 1, 6, 3, -1);
  #assert b[0].c[same].hp < b[0].c[same].hp_max && b[0].c[side].hp < b[0].c[side].hp_max && b[0].c[ahead].hp < b[0].c[ahead].hp_max;
  #assert b[0].c[behind].hp == b[0].c[behind].hp_max && b[0].c[a].hp == b[0].c[a].hp_max;
  z := rs_area(b[..], a, rs_spell(SP_THUNDERWAVE), 6, 3);
  #assert z.x0 == 4 && z.x1 == 7 && z.y0 == 2 && z.y1 == 4;
  // diagonal: the quadrant toward the point, your row and column in it
  d := rs_area(b[..], a, rs_spell(SP_THUNDERWAVE), 1, 0);
  #assert d.x0 == 1 && d.x1 == 4 && d.y0 == 0 && d.y1 == 3;
}
#test "Entangle restrains on a failed Strength save; concentration ends it and lets go" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  held := 0;
  for k: 0..<20 {
    for j: 0..<RS_ZONES { b[0].zone[j].on = false; }
    b[0].n = 1; b[0].c[a].conc = -1;
    e := rs_add(b[..], rs_druid("Thorn", 1, 3), 8, 3);
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_ENTANGLE, 1 + k % 2, 8, 3, -1);
    if rs_has(b[0].c[e], RS_RESTRAINED) {
      held += 1;
      #assert rs_difficult(b[..], 8, 3);
      rs_end_concentration(b[..], a, "");
      #assert !rs_has(b[0].c[e], RS_RESTRAINED) && !rs_difficult(b[..], 8, 3);
    }
    b[0].c[a].slots[1] = 4; b[0].c[a].slots[2] = 2;
    rs_end_turn(b[..], a);
  }
  // Str +0 against DC 13: fails on 12 or lower, 60%
  #assert held >= 6 && held <= 18;
}
#test "Chill Touch: a melee spell attack; on a hit 1d10 Necrotic and no healing until the end of the caster's next turn" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 31;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 3, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 4, 3);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 9, 3);
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, far);   // Touch
  hit := false;
  for k: 0..<30 {
    b[0].c[t].hp = 10; b[0].who = a; b[0].turn.action = false;
    #assert rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, t);
    if b[0].c[t].hp < 10 { hit = true; break; }
  }
  #assert hit && rs_effect(b[0].c[t], EF_NOHEAL);
  hp := b[0].c[t].hp;
  c: [1] RsCreature; c[0] = b[0].c[t];
  #assert rs_heal(c[..], 5) == 0;
  rs_end_turn(b[..], a);
  // it holds through the caster's next turn, however late the frame, and goes when that turn ends
  rs_tick(b[..], f32(RS_ROUND) + 0.1);
  #assert rs_effect(b[0].c[t], EF_NOHEAL);
  rs_start_turn(b[..], a); #assert rs_effect(b[0].c[t], EF_NOHEAL);
  rs_end_turn(b[..], a);
  #assert !rs_effect(b[0].c[t], EF_NOHEAL);
}
#test "Ray of Sickness poisons until the end of the caster's next turn; a Poisoned attacker has Disadvantage" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 41;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  got := false;
  for k: 0..<20 {
    b[0].c[t].hp = 21; b[0].c[a].slots[1] = 3;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_RAY_OF_SICKNESS, 1, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_POISONED) { got = true; break; }
  }
  #assert got;
  // still Poisoned until the caster's next turn has ended
  rs_tick_ticks(b[..], b[0].c[a].turn_at - 500000 - b[0].clock);
  #assert rs_has(b[0].c[t], RS_POISONED);
  rs_tick(b[..], 0.7);
  rs_start_turn(b[..], a); #assert rs_has(b[0].c[t], RS_POISONED);
  rs_end_turn(b[..], a);
  #assert !rs_has(b[0].c[t], RS_POISONED);
}
#test "False Life: 2d4 + 4 Temporary Hit Points, 5 more a slot level above 1" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_FALSE_LIFE, 1, 0, 0, a) && b[0].c[a].temp >= 6 && b[0].c[a].temp <= 12;
  rs_end_turn(b[..], a); b[0].c[a].temp = 0;
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_FALSE_LIFE, 2, 0, 0, a) && b[0].c[a].temp >= 11 && b[0].c[a].temp <= 17;
}
#test "Ray of Enfeeblement: on a failed Con save the target's damage loses 1d8, until it saves at the end of a turn" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 77;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  // This scenario chooses Ray of Enfeeblement for its legal prepared list.
  _ := rs_spellbook_add(b[0].c[a..<a+1], RS_EXEC_SOURCE[SP_RAY_OF_ENFEEBLEMENT]);
  choices := [2] int.[RS_KEY_MAGE_ARMOR, RS_EXEC_SOURCE[SP_RAY_OF_ENFEEBLEMENT]];
  #assert rs_set_spells(b[0].c[a..<a+1], choices[..]);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  held := false;
  for k: 0..<20 {
    for e: 0..<RS_EFFECTS { b[0].c[t].eff[e].kind = EF_NONE; }
    b[0].c[a].conc = -1; b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_RAY_OF_ENFEEBLEMENT, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_effect(b[0].c[t], EF_ENFEEBLED) { held = true; break; }
    #assert rs_effect(b[0].c[t], EF_WEAK) && b[0].c[a].conc < 0;
  }
  #assert held && b[0].c[a].conc == SP_RAY_OF_ENFEEBLEMENT;
  // concentration broken: it ends
  rs_end_concentration(b[..], a, "");
  #assert !rs_effect(b[0].c[t], EF_ENFEEBLED);
}
#test "Blindness/Deafness: Blinded on a failed save; attacks against it have Advantage; it saves to end it" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 13;
  a := rs_add(b[..], rs_wizard("Mordra", 1, 3), 1, 3);
  choices := [2] int.[RS_KEY_MAGE_ARMOR, RS_EXEC_SOURCE[SP_BLINDNESS]];
  #assert rs_set_spells(b[0].c[a..<a+1], choices[..]);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 8, 3);
  blind := false;
  for k: 0..<20 {
    b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_BLINDNESS, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_BLINDED) { blind = true; break; }
  }
  #assert blind;
  ended := false;
  for k: 0..<40 { rs_start_turn(b[..], t); rs_end_turn(b[..], t); if !rs_has(b[0].c[t], RS_BLINDED) { ended = true; break; } }
  #assert ended;
}
#test "Produce Flame: the flame first (a Bonus Action), then a Magic action to hurl it" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 21;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  e := rs_add(b[..], rs_druid("Thorn", 1, 3), 9, 3);
  rs_start_turn(b[..], a);
  #assert !rs_cast(b[..], a, SP_FLAME_HURL, 0, 0, 0, e);
  #assert rs_cast(b[..], a, SP_PRODUCE_FLAME, 0, 0, 0, a);
  #assert rs_cast(b[..], a, SP_FLAME_HURL, 0, 0, 0, e);
  #assert rs_aura_on(b[0].c[a], EF_FLAME, b[0].clock);
}
#test "Eldritch Blast: 1d10 Force + Cha (Agonizing Blast), and a hit pushes 10 feet (Repelling Blast)" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 6, 3);
  hit := false;
  for k: 0..<30 {
    b[0].c[t].hp = 21; b[0].c[t].x = 6; b[0].c[t].y = 3;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_ELDRITCH_BLAST, 0, 0, 0, t);
    rs_end_turn(b[..], a);
    if b[0].c[t].hp < 21 { hit = true; break; }
  }
  #assert hit && b[0].c[t].x == 8;
  lost := 21 - b[0].c[t].hp;
  #assert lost >= 1 + 3 && lost <= 20 + 3;
  // one beam at level 3, two at 5: each its own attack
  #assert rs_cantrip_tier(3) == 1;
}
#test "Hex: 1d6 Necrotic more on each hit; it moves on a later turn once its target drops" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 10, 3);
  u := rs_add(b[..], rs_druid("Fern", 0, 3), 10, 6);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_HEX, 2, 0, 0, t) && b[0].c[a].conc == SP_HEX && b[0].c[a].slots[2] == 1;
  #assert b[0].c[a].conc_until == rs_secs(14400) && b[0].c[t].eff[0].until == rs_secs(14400);
  #assert !rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, u);   // one slot a turn
  #assert rs_effect(b[0].c[t], EF_HEX);
  extra := false;
  for k: 0..<30 {
    b[0].c[t].hp = 21; b[0].c[t].x = 10; b[0].c[t].y = 3; b[0].who = a; b[0].turn.action = false;
    seq := b[0].book[0].seq;
    #assert rs_cast(b[..], a, SP_ELDRITCH_BLAST, 0, 0, 0, t);
    for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.spell.value == SP_HEX && ev.kind == RS_EV_DAMAGE { extra = true; } }
    if extra { break; }
  }
  #assert extra;
  // it drops: not this turn, the next one
  b[0].c[t].hp = 1; b[0].c[t].temp = 0;
  rs_damage(b[..], a, t, 5, RS_FORCE, false, SP_ELDRITCH_BLAST);
  #assert b[0].c[t].hp == 0 && b[0].c[a].note[RS_NT_CURSE_FREE] != 0;
  #assert !rs_hex_move(b[..], a, u);
  rs_end_turn(b[..], a);
  rs_tick_ticks(b[..], b[0].c[a].turn_at - b[0].clock);
  rs_start_turn(b[..], a);
  #assert rs_hex_move(b[..], a, u) && rs_effect(b[0].c[u], EF_HEX) && !rs_effect(b[0].c[t], EF_HEX) && b[0].c[a].slots[2] == 1;
}
#test "Hold Person: Paralyzed on a failed Wis save; it fails Dex saves, and a hit from 5 feet is a Critical Hit" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 21;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 3);
  held := false;
  for k: 0..<20 {
    for e: 0..<RS_EFFECTS { b[0].c[t].eff[e].kind = EF_NONE; }
    b[0].c[t].cond = 0; b[0].c[a].conc = -1; b[0].c[a].slots[2] = 2;
    rs_start_turn(b[..], a);
    #assert rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, t);
    rs_end_turn(b[..], a);
    if rs_has(b[0].c[t], RS_PARALYZED) { held = true; break; }
    #assert b[0].c[a].conc < 0;   // saved: nothing to hold
  }
  #assert held && !rs_can_act(b[0].c[t]) && b[0].c[a].conc == SP_HOLD_PERSON;
  // a melee hit from 5 feet: a Critical Hit (two dice of Chill Touch)
  crit := false;
  for k: 0..<10 {
    b[0].c[t].hp = 21; b[0].who = a; b[0].turn.action = false;
    seq := b[0].book[0].seq;
    #assert rs_cast(b[..], a, SP_CHILL_TOUCH, 0, 0, 0, t);
    for e: 0..<(b[0].book[0].seq - seq) {
      ev := rs_recent(b[0].book[0], e);
      if ev.kind == RS_EV_ATTACK { crit = ev.text_n > 12 && cast(string) ev.text[(ev.text_n - 12)..<ev.text_n] == "critical hit"; #assert crit; }
    }
    if crit { break; }
  }
  #assert crit;
  // its concentration ends: it can move again
  rs_end_concentration(b[..], a, "");
  #assert !rs_has(b[0].c[t], RS_PARALYZED);
}
#test "Scorching Ray: three rays, a ranged spell attack each, 2d6 Fire on a hit; four from a 3rd-level slot" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 2;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 5, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 10, 3);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 200;
  rs_start_turn(b[..], a);
  seq := b[0].book[0].seq;
  #assert rs_cast(b[..], a, SP_SCORCHING_RAY, 3, 0, 0, t);
  rolls := 0;
  for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { rolls += 1; } }
  #assert rolls == 4;
}
#test "Dark One's Blessing: Cha + Warlock level Temporary Hit Points when it drops a foe, or one drops within 10 feet" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 4;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  close := rs_add(b[..], rs_druid("Rowan", 0, 3), 3, 3);
  far := rs_add(b[..], rs_druid("Fern", 0, 3), 12, 3);
  ally := rs_add(b[..], rs_warlock("Ilse", 1, 3, SP_ELDRITCH_BLAST), 13, 6);
  b[0].c[far].hp = 1;
  rs_damage(b[..], ally, far, 4, RS_FORCE, false, -1);
  #assert b[0].c[a].temp == 0 && b[0].c[ally].temp == 3 + 3;
  b[0].c[close].hp = 1;
  rs_damage(b[..], ally, close, 4, RS_FORCE, false, -1);
  #assert b[0].c[a].temp == 6;
}
#test "Rage: a Bonus Action; +2 damage on Greataxe hits, Bludgeoning/Piercing/Slashing halved; it ends on a turn without an attack" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 12;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], a);
  #assert rs_rage(b[..], a) && rs_effect(b[0].c[a], EF_RAGE) && b[0].c[a].uses[RS_USE_RAGE] == 2 && !rs_rage(b[..], a);
  // a monk's 1d6 + 3 Bludgeoning is halved
  b[0].c[m].feats = rs_feature_put(b[0].c[m].feats, RS_FT_DEFLECT, false);
  rs_end_turn(b[..], a);
  got := false;
  for k: 0..<20 {
    b[0].c[a].hp = 32;
    rs_start_turn(b[..], m);
    seq := b[0].book[0].seq;
    #assert rs_attack(b[..], m, a, false, -1);
    rs_end_turn(b[..], m);
    if b[0].c[a].hp < 32 { #assert 32 - b[0].c[a].hp <= 9 / 2 + 3; got = true; break; }
  }
  #assert got && rs_effect(b[0].c[a], EF_RAGE);
  // its own turn passes with an attack: it holds; a turn without one: it ends
  rs_start_turn(b[..], a);
  #assert rs_attack(b[..], a, m, false, -1);
  rs_end_turn(b[..], a);
  #assert rs_effect(b[0].c[a], EF_RAGE);
  rs_start_turn(b[..], a);
  rs_end_turn(b[..], a);
  #assert !rs_effect(b[0].c[a], EF_RAGE);
}
#test "Reckless Attack: Advantage on its Strength attacks and on attacks against it; Frenzy adds 2d6 to the first hit" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 8;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], a);
  #assert rs_rage(b[..], a);
  #assert rs_attack(b[..], a, m, true, -1);
  #assert rs_aura_on(b[0].c[a], EF_RECKLESS, b[0].clock);
  #assert rs_attack_edge(b[..], m, a, true, false) == 1;
  frenzy := false;
  for k: 0..<10 {
    ev := rs_recent(b[0].book[0], k);
    if ev.kind == RS_EV_DAMAGE { s := cast(string) ev.text[0..<ev.text_n]; for c: 0..<(ev.text_n - 6) { if s[c..<(c + 6)] == "Frenzy" { frenzy = true; } } }
    if ev.kind == RS_EV_MISS { frenzy = true; }   // a miss: nothing to add
  }
  #assert frenzy;
  rs_end_turn(b[..], a);
  // gone at the start of its next turn
  rs_tick_ticks(b[..], b[0].c[a].turn_at - b[0].clock);
  #assert !rs_aura_on(b[0].c[a], EF_RECKLESS, b[0].clock);
}
#test "Cleave: a Greataxe hit carries into a second foe beside the first, without the Strength modifier" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 4, 3);
  n := rs_add(b[..], rs_warlock("Ilse", 1, 3, SP_ELDRITCH_BLAST), 4, 4);
  cleft := false;
  for k: 0..<20 {
    b[0].c[m].hp = 21; b[0].c[n].hp = 21; b[0].c[m].temp = 0;
    rs_start_turn(b[..], a);
    #assert rs_attack(b[..], a, m, false, n);
    rs_end_turn(b[..], a);
    if b[0].c[n].hp < 21 { #assert 21 - b[0].c[n].hp <= 24; cleft = true; break; }
  }
  #assert cleft;
}
#test "Flurry of Blows: 1 Focus Point, two Unarmed Strikes (1d6 + 3); Topple knocks a foe Prone on a failed Dex save" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 19;
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 3, 3);
  t := rs_add(b[..], rs_warlock("Vesk", 0, 3, SP_ELDRITCH_BLAST), 4, 3);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 200;
  prone := false;
  for k: 0..<10 {
    b[0].c[m].uses[RS_USE_FOCUS] = 3; b[0].c[t].cond = 0;
    rs_start_turn(b[..], m);
    seq := b[0].book[0].seq;
    #assert rs_flurry(b[..], m, t, OH_TOPPLE) && b[0].c[m].uses[RS_USE_FOCUS] == 2 && !rs_flurry(b[..], m, t, OH_TOPPLE);
    strikes := 0;
    for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { strikes += 1; } }
    #assert strikes == 2;
    rs_end_turn(b[..], m);
    if rs_has(b[0].c[t], RS_PRONE) { prone = true; break; }
  }
  #assert prone;
}
#test "Deflect Attacks: a Monk's Reaction cuts 1d10 + Dex + level from a Greataxe hit, once until its turn" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  for k: 0..<20 {
    b[0].c[m].hp = 21; b[0].c[m].reacted = false; b[0].c[m].uses[RS_USE_FOCUS] = 0;
    rs_start_turn(b[..], a);
    #assert rs_attack(b[..], a, m, false, -1);
    rs_end_turn(b[..], a);
    if b[0].c[m].reacted { break; }
  }
  #assert b[0].c[m].reacted && 21 - b[0].c[m].hp <= 12 + 3 - (1 + 3 + 3);
}
#test "Patient Defense: Dodge until its next turn, Disadvantage on attacks against it and Advantage on Dex saves" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 3, 3);
  m := rs_add(b[..], rs_monk("Sen", 1, 3), 4, 3);
  rs_start_turn(b[..], m);
  #assert rs_patient_defense(b[..], m) && b[0].c[m].uses[RS_USE_FOCUS] == 2;
  #assert rs_attack_edge(b[..], a, m, true, true) == -1 && rs_save_edge(b[..], m, RS_DEX) == 1;
  rs_end_turn(b[..], m);
  rs_tick_ticks(b[..], b[0].c[m].turn_at - b[0].clock);
  #assert rs_attack_edge(b[..], a, m, true, true) == -1;
  rs_start_turn(b[..], m);
  #assert rs_attack_edge(b[..], a, m, true, true) == 0;
}
#test "the action adapter: a turn every 1.5 seconds, slots back after the cooldown, saves still on 6-second rounds" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 21;
  #assert rs_set_timing(b[..],RS_ACTION_TIMING);
  a := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 9, 3);
  rs_begin(b[..]);
  first := b[0].c[a].turn_at;
  rs_tick_ticks(b[..], first - b[0].clock);
  rs_start_turn(b[..], a);
  #assert b[0].turn.new_round && b[0].turn.move_left == 2;   // 30 feet a round: 7.5 feet a beat, 2 squares
  #assert rs_cast(b[..], a, SP_SCORCHING_RAY, 2, 0, 0, t) && b[0].c[a].slots[2] == 1;
  rs_end_turn(b[..], a);
  #assert b[0].c[a].turn_at == first + 1500000;
  rs_tick(b[..], 1.5);
  rs_start_turn(b[..], a);
  #assert !b[0].turn.new_round;
  rs_end_turn(b[..], a);
  for k: 0..<10 { rs_tick(b[..], 1.0); }
  #assert b[0].c[a].slots[2] == 2;
}
#test "a Skeleton takes double from a Monk's fists, nothing from Poison Spray, and can't be held by Hold Person" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 14;
  m := rs_add(b[..], rs_monk("Sen", 0, 3), 3, 3);
  s := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 3);
  w := rs_add(b[..], rs_warlock("Vesk", 1, 3, SP_ELDRITCH_BLAST), 8, 3);
  d := rs_add(b[..], rs_druid("Rowan", 0, 3), 5, 4);
  poison_choice := [1] int.[RS_EXEC_SOURCE[SP_POISON_SPRAY]];
  #assert rs_set_spells(b[0].c[d..<d+1], poison_choice[..]);
  hit := false;
  for k: 0..<20 {
    b[0].c[s].hp = 13; b[0].c[s].dead = false; b[0].c[s].cond = 0;
    rs_start_turn(b[..], m);
    #assert rs_attack(b[..], m, s, false, -1);
    rs_end_turn(b[..], m);
    if b[0].c[s].hp < 13 { #assert (13 - b[0].c[s].hp) % 2 == 0 || b[0].c[s].hp == 0; hit = true; break; }
  }
  #assert hit;
  rs_start_turn(b[..], w);
  before_slots := b[0].c[w].slots[2];
  #assert rs_cast(b[..], w, SP_HOLD_PERSON, 2, 0, 0, s);
  #assert b[0].c[w].slots[2] == before_slots - 1 && !rs_has(b[0].c[s], RS_PARALYZED);
  rs_end_turn(b[..], w);
  for k: 0..<10 {
    b[0].c[s].hp = 13; b[0].c[s].dead = false; b[0].c[s].cond = 0;
    rs_start_turn(b[..], d);
    #assert rs_cast(b[..], d, SP_POISON_SPRAY, 0, 0, 0, s);
    rs_end_turn(b[..], d);
    #assert b[0].c[s].hp == 13;
  }
}
#test "a Skeleton's Shortbow: 80 feet, Disadvantage out to 320, and up close Disadvantage while a foe is beside it" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 80; b[0].h = 8; b[0].dice[0].state = 2;
  s := rs_add(b[..], rs_skeleton("Skeleton", 2), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 30, 3);
  rs_start_turn(b[..], s);
  #assert rs_shoot(b[..], s, t);
  ev := rs_recent(b[0].book[0], 0);
  for k: 0..<4 { e := rs_recent(b[0].book[0], k); if e.kind == RS_EV_ATTACK || e.kind == RS_EV_MISS { ev = e; } }
  txt := cast(string) ev.text[0..<ev.text_n];
  dis := false;
  for c: 0..<(ev.text_n - 12) { if txt[c..<(c + 12)] == "Disadvantage" { dis = true; } }
  #assert dis;   // 145 feet: long range
  rs_end_turn(b[..], s);
  b[0].c[t].x = 75;
  rs_start_turn(b[..], s);
  #assert !rs_shoot(b[..], s, t);   // 370 feet: beyond 320
}

// Whether an event since `seq` says `needle` (the tests' look at the log).
rs_saw :: (b: [] RsBattle, seq: int, needle: string) -> bool {
  for e: 0..<rs_min(b[0].book[0].seq - seq, RS_EVENTS) {
    ev := rs_recent(b[0].book[0], e);
    t := cast(string) ev.text[0..<ev.text_n];
    if ev.text_n < needle.count { continue; }
    for c: 0..<(ev.text_n - needle.count + 1) { if t[c..<(c + needle.count)] == needle { return true; } }
  }
  return false;
}
// A fresh turn for i (its action, Bonus Action and slot unspent), without the clock moving.
rs_fresh :: (b: [] RsBattle, i: int) { b[0].who = i; b[0].turn = RsTurn.{move_left = 6}; b[0].c[i].reacted = false; }

#test "Bardic Inspiration: a Bonus Action gives an ally the d6, spent on its next failed attack roll" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_bard("Lark", 0, 3), 1, 3);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 5, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 6, 3);
  rs_fresh(b[..], a);
  #assert !rs_inspire(b[..], a, a) && rs_inspire(b[..], a, f) && rs_state_value(b[0].c[f], EF_INSPIRED) == 6 && b[0].c[a].uses[RS_USE_INSPIRE] == 2;
  #assert !rs_inspire(b[..], a, f);   // the Bonus Action is spent
  b[0].c[t].ac = 40; b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  for k: 0..<20 {
    rs_fresh(b[..], f); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], f, t, false, -1);
    if rs_state_value(b[0].c[f], EF_INSPIRED) == 0 { #assert rs_saw(b[..], seq, "Inspiration"); break; }
  }
  #assert rs_state_value(b[0].c[f], EF_INSPIRED) == 0;
}
#test "Cutting Words: a Lore Bard's Reaction takes its die off a foe's hit, turning some to misses" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_bard("Lark", 0, 3), 1, 3);
  t := rs_add(b[..], rs_fighter("Garr", 0, 3), 5, 3);
  s := rs_add(b[..], rs_skeleton("Skeleton", 2), 6, 3);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  cut := false;
  for k: 0..<30 {
    b[0].c[a].uses[RS_USE_INSPIRE] = 3; b[0].c[a].reacted = false;
    rs_fresh(b[..], s); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], s, t, false, -1);
    if rs_saw(b[..], seq, "Cutting Words") { cut = true; #assert b[0].c[a].uses[RS_USE_INSPIRE] == 2 && b[0].c[a].reacted; break; }
  }
  #assert cut;
}
#test "Vicious Mockery: a failed Wis save, 1d6 Psychic and Disadvantage on its next attack roll" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 8;
  a := rs_add(b[..], rs_bard("Lark", 0, 3), 1, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 8, 3);
  mocked := false;
  for k: 0..<20 {
    b[0].c[t].hp = 13; b[0].c[t].dead = false;
    rs_fresh(b[..], a);
    #assert rs_cast(b[..], a, SP_VICIOUS_MOCKERY, 0, 0, 0, t);
    if rs_effect(b[0].c[t], EF_WEAK) { mocked = true; #assert b[0].c[t].hp < 13 && b[0].c[t].hp >= 13 - 6; break; }
  }
  #assert mocked && rs_attack_edge(b[..], t, a, false, false) == -1 && !rs_effect(b[0].c[t], EF_WEAK);
}
#test "Turn Undead: Undead within 30 feet that fail a Wis save are Frightened and Incapacitated until hurt" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 4;
  a := rs_add(b[..], rs_cleric("Aster", 0, 3), 2, 4);
  for k: 0..<6 { s := rs_add(b[..], rs_skeleton("Skeleton", 2), 4 + k, 4); }
  far := rs_add(b[..], rs_skeleton("Skeleton", 2), 15, 4);
  rs_fresh(b[..], a);
  #assert rs_turn_undead(b[..], a) && b[0].c[a].uses[RS_USE_CHANNEL] == 1 && !rs_turn_undead(b[..], a);
  turned := -1;
  for j: 1..<7 { if rs_effect(b[0].c[j], EF_TURNED) { turned = j; } }
  #assert turned > 0 && !rs_effect(b[0].c[far], EF_TURNED);
  #assert !rs_can_act(b[0].c[turned]) && rs_can_move(b[0].c[turned]) && rs_has(b[0].c[turned], RS_FRIGHTENED) && rs_turned_by(b[0].c[turned]) == a;
  b[0].c[turned].hp = 13; b[0].c[turned].vulnerable = 0;
  rs_damage(b[..], a, turned, 1, RS_RADIANT, false, -1);
  #assert !rs_effect(b[0].c[turned], EF_TURNED) && rs_can_act(b[0].c[turned]);
}
#test "Preserve Life: 15 Hit Points among Bloodied allies within 30 feet, none above half; Disciple of Life adds 2 + slot" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 6;
  a := rs_add(b[..], rs_cleric("Aster", 0, 3), 2, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  r := rs_add(b[..], rs_rogue("Nim", 0, 3), 4, 5);
  rs_fresh(b[..], a);
  #assert !rs_preserve_life(b[..], a);   // nobody Bloodied: nothing spent
  b[0].c[f].hp = 2; b[0].c[r].hp = 9;
  #assert rs_preserve_life(b[..], a) && b[0].c[a].uses[RS_USE_CHANNEL] == 1;
  #assert b[0].c[f].hp == 14 && b[0].c[r].hp == 12;   // 12 and 3: each up to half its maximum
  b[0].c[f].hp = 1;
  rs_fresh(b[..], a);
  #assert rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, f) && b[0].c[f].hp >= 1 + 2 + 3 + 3;
}
#test "Guiding Bolt: 4d6 Radiant on a hit, and the next attack roll against it has Advantage; Sacred Flame is a Dex save" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 9;
  a := rs_add(b[..], rs_cleric("Aster", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Garr", 1, 3), 10, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  lit_up := false;
  for k: 0..<20 {
    b[0].c[a].slots[1] = 4; rs_fresh(b[..], a);
    #assert rs_cast(b[..], a, SP_GUIDING_BOLT, 1, 0, 0, t);
    if rs_effect(b[0].c[t], EF_EXPOSED) { lit_up = true; break; }
  }
  #assert lit_up && 500 - b[0].c[t].hp >= 4;
  #assert rs_attack_edge(b[..], a, t, false, false) == 1 && !rs_effect(b[0].c[t], EF_EXPOSED);
  b[0].c[t].hp = 500; rs_fresh(b[..], a); seq := b[0].book[0].seq;
  #assert rs_cast(b[..], a, SP_SACRED_FLAME, 0, 0, 0, t) && rs_saw(b[..], seq, "DEX save") && 500 - b[0].c[t].hp <= 8;
}
#test "Second Wind heals 1d10 + 3 as a Bonus Action; Action Surge gives a second Attack action" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 2;
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  b[0].c[f].hp = 5;
  rs_fresh(b[..], f);
  #assert rs_second_wind(b[..], f) && b[0].c[f].hp >= 5 + 4 && b[0].c[f].hp <= 5 + 13 && b[0].c[f].uses[RS_USE_WIND] == 1 && !rs_second_wind(b[..], f);
  #assert !rs_action_surge(b[..], f);   // nothing to surge past yet
  #assert rs_attack(b[..], f, t, false, -1) && !rs_attack(b[..], f, t, false, -1);
  #assert rs_action_surge(b[..], f) && rs_attack(b[..], f, t, false, -1) && b[0].c[f].uses[RS_USE_SURGE] == 0 && !rs_action_surge(b[..], f);
}
#test "a feature's events say which feature it is; a Cunning Action Dash is told without a line" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 2;
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  r := rs_add(b[..], rs_rogue("Nim", 0, 3), 6, 4);
  b[0].c[f].hp = 5;
  rs_fresh(b[..], f);
  #assert rs_second_wind(b[..], f);
  told := rs_recent(b[0].book[0], 1); heal := rs_recent(b[0].book[0], 0);
  #assert told.kind == RS_EV_CAST && told.feat == RS_FT_SECOND_WIND && heal.kind == RS_EV_HEAL && heal.feat == RS_FT_SECOND_WIND;
  rs_fresh(b[..], r);
  #assert rs_cunning_dash(b[..], r);
  e := rs_recent(b[0].book[0], 0);
  #assert e.kind == RS_EV_FEAT && e.feat == RS_FT_CUNNING_DASH && e.by.value == r && e.text_n == 0;
}
#test "Improved Critical: the Champion's 19s are Critical Hits; Graze deals the Strength modifier on a miss" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 12;
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 4, 4);
  b[0].c[t].ac = 40;   // only Critical Hits land
  crits := 0; grazed := 0;
  for k: 0..<200 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], f);
    hit := rs_attack(b[..], f, t, false, -1);
    lost := 500 - b[0].c[t].hp;
    if lost == 3 { grazed += 1; }
    if lost > 3 { crits += 1; #assert lost >= 4 + 3; }
  }
  // 19 or 20: 10%; a 20 alone would be 5%
  #assert crits > 12 && crits < 32 && grazed > 150;
}
#test "Divine Smite: a Bonus Action after a melee hit, 2d8 Radiant (3d8 on Undead); once without a slot" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 14;
  p := rs_add(b[..], rs_paladin("Oriel", 0, 3), 3, 4);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 4);
  rs_fresh(b[..], p);
  #assert !rs_cast(b[..], p, SP_DIVINE_SMITE, 0, 0, 0, t);   // no hit yet
  smote := false;
  for k: 0..<20 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500; b[0].c[t].dead = false; b[0].c[t].vulnerable = 0;
    rs_fresh(b[..], p);
    #assert rs_attack(b[..], p, t, false, -1);
    if b[0].turn.last_hit == t + 1 {
      before := b[0].c[t].hp; seq := b[0].book[0].seq;
      free := b[0].c[p].uses[RS_USE_FREE] > 0;
      #assert rs_cast(b[..], p, SP_DIVINE_SMITE, ifx free then 0 else 1, 0, 0, t);
      lost := before - b[0].c[t].hp;
      #assert lost >= 3 && rs_saw(b[..], seq, "3d8") || rs_saw(b[..], seq, "6d8");
      if free { #assert b[0].c[p].uses[RS_USE_FREE] == 0 && b[0].c[p].slots[1] == 3; }
      #assert !rs_cast(b[..], p, SP_DIVINE_SMITE, 1, 0, 0, t);   // one smite a hit
      smote = true; break;
    }
  }
  #assert smote;
}
#test "Lay On Hands heals from a 15-point pool by touch; Sacred Weapon adds Cha to hit; Sap weakens a foe hit" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 15;
  p := rs_add(b[..], rs_paladin("Oriel", 0, 3), 3, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 5);
  far := rs_add(b[..], rs_rogue("Nim", 0, 3), 10, 5);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 4, 4);
  b[0].c[f].hp = 10; b[0].c[far].hp = 1;
  rs_fresh(b[..], p);
  #assert !rs_lay_on_hands(b[..], p, far, 10) && rs_lay_on_hands(b[..], p, f, 10) && b[0].c[f].hp == 20 && b[0].c[p].uses[RS_USE_LAY] == 5;
  #assert rs_sacred_weapon(b[..], p) && b[0].c[p].uses[RS_USE_CHANNEL] == 1;
  sapped := false;
  for k: 0..<20 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], p); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], p, t, false, -1) && rs_saw(b[..], seq, " + 7 = ");   // +2 prof, +3 Str, +2 Cha
    if b[0].turn.last_hit == t + 1 { sapped = rs_effect(b[0].c[t], EF_WEAK); break; }
  }
  #assert sapped;
}
#test "Hunter's Mark: cast free with Favored Enemy, 1d6 Force on each hit; Colossus Slayer and Slow on a hurt foe" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 16;
  r := rs_add(b[..], rs_ranger("Wren", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 14, 4);
  rs_fresh(b[..], r);
  #assert rs_cast(b[..], r, SP_HUNTERS_MARK, 0, 0, 0, t) && b[0].c[r].uses[RS_USE_FREE] == 1 && b[0].c[r].slots[1] == 3 && rs_effect(b[0].c[t], EF_MARK) && b[0].c[r].conc == SP_HUNTERS_MARK;
  marked := false; slayer := false;
  for k: 0..<30 {
    b[0].c[t].hp = 400; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], r); seq := b[0].book[0].seq;
    #assert rs_shoot(b[..], r, t);
    if rs_saw(b[..], seq, "Hunter's Mark") { marked = true; }
    if rs_saw(b[..], seq, "Colossus Slayer") { slayer = true; #assert rs_aura_on(b[0].c[t], EF_SLOWED, b[0].clock); }
    if marked && slayer { break; }
  }
  #assert marked && slayer;
  // Slowed: 10 feet less at the start of its turn
  rs_start_turn(b[..], t); #assert b[0].turn.move_left == 4;
}
#test "Sneak Attack: 2d6 once a turn with an ally beside the foe or Advantage; Steady Aim gives Advantage, not after moving" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 17;
  r := rs_add(b[..], rs_rogue("Nim", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 10, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_fresh(b[..], r);
  #assert rs_steady_aim(b[..], r) && b[0].turn.aimed && b[0].turn.move_left == 0 && !rs_step_to(b[..], r, 3, 4);
  #assert rs_attack_edge(b[..], r, t, false, false) == 1 && !b[0].turn.aimed;
  rs_fresh(b[..], r);
  #assert rs_step_to(b[..], r, 3, 4) && !rs_steady_aim(b[..], r);
  #assert rs_cunning_dash(b[..], r) && b[0].turn.move_left == 5 + 6;
  ally := rs_add(b[..], rs_fighter("Garr", 0, 3), 11, 4);
  sneaky := false;
  for k: 0..<20 {
    rs_fresh(b[..], r); seq := b[0].book[0].seq;
    #assert rs_shoot(b[..], r, t);
    if rs_saw(b[..], seq, "Sneak Attack") { sneaky = true; #assert b[0].turn.sneaked; break; }
  }
  #assert sneaky;
}
#test "Vex: a Shortsword hit that deals damage gives Advantage on the next attack roll against that foe" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 18;
  r := rs_add(b[..], rs_rogue("Nim", 0, 3), 3, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 4, 4);
  u := rs_add(b[..], rs_fighter("Kell", 1, 3), 4, 5);
  vexed := false;
  for k: 0..<20 {
    b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
    rs_fresh(b[..], r);
    #assert rs_attack(b[..], r, t, false, -1);
    if rs_effect(b[0].c[r], EF_VEX) { vexed = true; break; }
  }
  #assert vexed && rs_attack_edge(b[..], r, u, true, false) == 0 && rs_attack_edge(b[..], r, t, true, false) == 1 && !rs_effect(b[0].c[r], EF_VEX);
}
#test "Innate Sorcery: +1 DC and Advantage on spell attacks; Quickened Spell casts a cantrip as a Bonus Action" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 19;
  s := rs_add(b[..], rs_sorcerer("Ember", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 14, 4);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_fresh(b[..], s);
  #assert rs_dc(b[..], s) == 13 && rs_innate_sorcery(b[..], s) && rs_dc(b[..], s) == 14 && b[0].c[s].uses[RS_USE_INNATE] == 1;
  rs_fresh(b[..], s); seq := b[0].book[0].seq;
  #assert rs_cast(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t) && rs_saw(b[..], seq, "(Advantage)");
  #assert rs_cast_quick(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t) && b[0].c[s].uses[RS_USE_SORCERY] <= 1 && b[0].turn.bonus;
  #assert !rs_cast(b[..], s, SP_SCORCHING_RAY, 2, 0, 0, t);   // no level 1+ spell after a Quickened one
  rs_fresh(b[..], s);
  #assert rs_cast(b[..], s, SP_SCORCHING_RAY, 2, 0, 0, t) && !rs_cast_quick(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t);
}
#test "Seeking Spell rerolls a missed spell attack for a Sorcery Point; Draconic Resilience: 20 HP, AC 15" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 20;
  s := rs_add(b[..], rs_sorcerer("Ember", 0, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Brand", 1, 3), 14, 4);
  b[0].c[t].ac = 40; b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_fresh(b[..], s); seq := b[0].book[0].seq;
  #assert rs_cast(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t) && rs_saw(b[..], seq, "Seeking Spell") && b[0].c[s].uses[RS_USE_SORCERY] == 2;
  #assert b[0].c[s].hp_max == 20 && b[0].c[s].ac == 15;
}
#test "Shield: a Reaction to a hit, +5 AC against it and until the start of the caster's next turn" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 10; b[0].dice[0].state = 21;
  w := rs_add(b[..], rs_wizard("Mordra", 1, 3), 4, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 4);
  rs_begin(b[..]);
  shielded := false;
  for k: 0..<30 {
    b[0].c[w].hp = 17; b[0].c[w].reacted = false; rs_shield_end(b[0].c[w..<w+1]);
    rs_fresh(b[..], f); seq := b[0].book[0].seq;
    #assert rs_attack(b[..], f, w, false, -1);
    if rs_saw(b[..], seq, "casts Shield") { shielded = true; break; }
  }
  #assert shielded && b[0].c[w].reacted && b[0].c[w].slots[1] == 2 && rs_ac(b[..], w) == 20 && b[0].c[w].hp == 17 - 3;   // turned to a miss, but Graze still deals its 3
  rs_tick_ticks(b[..], b[0].c[w].turn_at - b[0].clock);
  #assert rs_ac(b[..], w) == 20;
  rs_start_turn(b[..],w); #assert rs_ac(b[..], w) == 15;
}
#test "Potent Cantrip: an Evoker's missed Fire Bolt still deals half its damage" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 22;
  w := rs_add(b[..], rs_wizard("Mordra", 1, 3), 2, 4);
  t := rs_add(b[..], rs_fighter("Garr", 0, 3), 14, 4);
  b[0].c[t].ac = 40; b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  half := false;
  for k: 0..<20 {
    rs_fresh(b[..], w); seq := b[0].book[0].seq;
    #assert rs_cast(b[..], w, SP_FIRE_BOLT, 0, 0, 0, t);
    if rs_saw(b[..], seq, "Potent Cantrip") { half = 500 - b[0].c[t].hp <= 5; break; }
  }
  #assert half;
}
#test "Land's Aid: a Wild Shape use, a 10-foot sphere: 2d6 Necrotic on a failed Con save, half on a success, 2d6 back to a friend" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 23;
  d := rs_add(b[..], rs_druid("Rowan", 0, 3), 2, 4);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 9, 4);
  e1 := rs_add(b[..], rs_fighter("Brand", 1, 3), 10, 4);
  e2 := rs_add(b[..], rs_fighter("Kell", 1, 3), 11, 5);
  out := rs_add(b[..], rs_fighter("Vane", 1, 3), 14, 4);
  b[0].c[f].hp = 5;
  rs_fresh(b[..], d);
  #assert !rs_lands_aid(b[..], d, 30, 4, f);   // beyond 60 feet
  #assert rs_lands_aid(b[..], d, 10, 4, f) && b[0].c[d].uses[RS_USE_WILD] == 1;
  #assert b[0].c[e1].hp < 28 && b[0].c[e2].hp < 28 && b[0].c[e1].hp >= 28 - 12 && b[0].c[out].hp == 28;
  #assert b[0].c[f].hp >= 5 + 2 && b[0].c[f].hp <= 5 + 12;
}
#test "Remarkable Athlete: a Champion rolls Initiative with Advantage" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 10; b[0].dice[0].state = 24;
  champ := 0; plain := 0;
  for k: 0..<100 {
    b[0].n = 0;
    a := rs_add(b[..], rs_fighter("Garr", 0, 3), 1, 1);
    c := rs_add(b[..], rs_fighter("Garr", 0, 2), 2, 1);
    champ += b[0].c[a].initiative; plain += b[0].c[c].initiative;
  }
  // a d20's mean is 10.5, with Advantage about 13.8
  #assert champ > plain + 150;
}

#test "a level 6 Champion: Strength 20 from two Ability Score Improvements, Extra Attack, Tactical Mind and Tactical Shift" {
  c := rs_fighter("Garr", 0, 6);
  // Ability Score Improvement (p. 87) at 4 and 6: Strength 16 to 20; Greatsword +5 (Str) +3 (Proficiency)
  #assert c.score[RS_STR] == 20 && rs_weapon_attack(c, c.weapon) == 8 && c.rank[RS_RK_EXTRA_ATTACK] == 1 && c.uses_max[RS_USE_WIND] == 3;
  #assert rs_fighter("Garr", 0, 4).score[RS_STR] == 18 && rs_fighter("Garr", 0, 4).rank[RS_RK_EXTRA_ATTACK] == 0;
  #assert c.hp_max == 10 + 2 + 5 * (6 + 2);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].state = 9;
  f := rs_add(b[..], c, 3, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 4, 3);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  // Extra Attack: two attack rolls for one Attack action
  rs_fresh(b[..], f); seq := b[0].book[0].seq;
  #assert rs_attack(b[..], f, t, false, -1) && b[0].turn.action;
  rolls := 0;
  for e: 0..<(b[0].book[0].seq - seq) {
    ev := rs_recent(b[0].book[0], e);
    tx := cast(string) ev.text[0..<ev.text_n];
    for q: 0..<rs_max(ev.text_n - 6, 0) { if tx[q..<(q + 7)] == " vs AC " { rolls += 1; } }
  }
  #assert rolls == 2;
  // Tactical Shift: Second Wind gives half its Speed (3 squares) more
  b[0].c[f].hp = 10; rs_fresh(b[..], f);
  #assert rs_second_wind(b[..], f) && b[0].turn.move_left == 6 + 3 && b[0].c[f].uses[RS_USE_WIND] == 2;
  // Remarkable Athlete: half its Speed after a Critical Hit
  rs_fresh(b[..], f); b[0].turn.last_crit = true; rs_after_blow(b[..], f);
  #assert b[0].turn.move_left == 6 + 3 && !b[0].turn.last_crit;
}

#test "Tactical Mind: a failed Strength (Athletics) check takes 1d10 more from a Second Wind use, spent only when it then succeeds" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 14; b[0].h = 8; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_druid("Rowan", 0, 3), 1, 3);
  b[0].c[a].score[RS_WIS] = 30;   // DC 8 + 2 + 10 = 20: hard enough that the plants hold
  f := rs_add(b[..], rs_fighter("Garr", 1, 6), 8, 3);
  b[0].c[f].score[RS_STR] = 10;
  mind := false;
  for k: 0..<40 {
    if !rs_has(b[0].c[f], RS_RESTRAINED) {
      for j: 0..<RS_ZONES { b[0].zone[j].on = false; }
      b[0].c[a].conc = -1; b[0].c[a].slots[1] = 4;
      rs_fresh(b[..], a);
      ok := rs_cast(b[..], a, SP_ENTANGLE, 1, 8, 3, -1);
      continue;
    }
    rs_fresh(b[..], f); seq := b[0].book[0].seq;
    was := b[0].c[f].uses[RS_USE_WIND];
    freed := rs_escape(b[..], f);
    if rs_saw(b[..], seq, "Tactical Mind") { mind = true; #assert b[0].c[f].uses[RS_USE_WIND] == was - (ifx freed then 1 else 0); }
    else { #assert b[0].c[f].uses[RS_USE_WIND] == was; }
    if b[0].c[f].uses[RS_USE_WIND] == 0 { b[0].c[f].uses[RS_USE_WIND] = 3; }
  }
  #assert mind;
}

#test "a level 6 Berserker: Strength 18, Extra Attack, Fast Movement, four Rages, and Mindless Rage" {
  c := rs_barbarian("Gorr", 1, 6);
  #assert c.score[RS_STR] == 18 && rs_weapon_attack(c, c.weapon) == 7 && c.rank[RS_RK_EXTRA_ATTACK] == 1 && c.speed == 40 && c.uses[RS_USE_RAGE] == 4 && rs_has_feature(c, RS_FT_PRIMAL_KNOWLEDGE);
  #assert c.hp_max == 12 + 2 + 5 * (7 + 2) && rs_has_feature(rs_barbarian("Gorr", 1, 5), RS_FT_MINDLESS_RAGE) == false && rs_has_feature(c, RS_FT_MINDLESS_RAGE);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].state = 4;
  a := rs_add(b[..], c, 2, 2);
  // Frightened before the Rage: entering it ends the condition
  #assert rs_put_effect(b[..], a, RsEffect.{kind = EF_COND, cond = RS_FRIGHTENED, by = -1, spell = -1, until = 100, save = -1, dc = 0});
  #assert rs_has(b[0].c[a], RS_FRIGHTENED);
  rs_fresh(b[..], a);
  #assert rs_rage(b[..], a) && !rs_has(b[0].c[a], RS_FRIGHTENED);
  // and while raging it can't be Charmed or Frightened; other conditions still land
  #assert rs_put_effect(b[..], a, RsEffect.{kind = EF_COND, cond = RS_CHARMED | RS_POISONED, by = -1, spell = -1, until = 100, save = -1, dc = 0});
  #assert !rs_has(b[0].c[a], RS_CHARMED) && rs_has(b[0].c[a], RS_POISONED);
}

#test "a level 6 Thief: Dexterity 18, Sneak Attack 3d6, Cunning Strike (Trip, Withdraw; no Poison without a kit), Uncanny Dodge, Expertise" {
  c := rs_rogue("Wen", 0, 6);
  #assert c.score[RS_DEX] == 18 && c.ac == 15 && c.rank[RS_RK_SNEAK_DICE] == 3 && rs_weapon_attack(c, c.weapon) == 7;
  #assert rs_has_feature(c, RS_FT_CUNNING_STRIKE) && rs_has_feature(c, RS_FT_UNCANNY_DODGE) && c.rank[RS_RK_EXPERTISE] == 4 && rs_has_feature(c, RS_FT_THIEVES_CANT) && rs_has_feature(c, RS_FT_FAST_HANDS) && c.climb == 30 && !rs_has_feature(c, RS_FT_POISON_KIT);
  #assert c.hp_max == 8 + 2 + 5 * (5 + 2);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].state = 11;
  r := rs_add(b[..], c, 2, 2);
  t := rs_add(b[..], rs_barbarian("Gorr", 1, 3), 3, 2);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  // Trip: one die forgone; the target saves or goes Prone
  b[0].c[r].note[RS_NT_STRIKE_PLAN] = CS_TRIP;
  tripped := false; tried := false;
  for k: 0..<30 {
    rs_fresh(b[..], r); b[0].turn.aimed = true; seq := b[0].book[0].seq;
    ok := rs_attack(b[..], r, t, false, -1);
    if rs_saw(b[..], seq, "Cunning Strike, Trip") { tried = true; if rs_has(b[0].c[t], RS_PRONE) { tripped = true; break; } }
  }
  #assert tried && tripped;
  // Poison needs a Poisoner's Kit: without one no die is forgone and nothing is rolled
  b[0].c[t].cond = 0; b[0].c[r].note[RS_NT_STRIKE_PLAN] = CS_POISON;
  for k: 0..<10 {
    rs_fresh(b[..], r); b[0].turn.aimed = true; seq := b[0].book[0].seq;
    ok := rs_attack(b[..], r, t, false, -1);
    #assert !rs_saw(b[..], seq, "Poison");
  }
  // Withdraw: half its Speed after the attack
  b[0].c[r].note[RS_NT_STRIKE_PLAN] = CS_WITHDRAW;
  for k: 0..<30 {
    rs_fresh(b[..], r); b[0].turn.aimed = true; seq := b[0].book[0].seq;
    ok := rs_attack(b[..], r, t, false, -1);
    if rs_saw(b[..], seq, "Withdraw") { #assert b[0].turn.move_left == 6 + 3; break; }
  }
  // Uncanny Dodge: the Barbarian's hit on it is halved, once until its Reaction comes back
  b[0].c[r].hp = 500; b[0].c[r].hp_max = 500; b[0].c[r].ac = 1;
  rs_fresh(b[..], t); seq := b[0].book[0].seq;
  b[0].c[r].reacted = false;
  ok := rs_attack(b[..], t, r, false, -1);
  #assert rs_saw(b[..], seq, "Uncanny Dodge") && b[0].c[r].reacted;
}

#test "a level 6 Open Hand Monk: Dex 18 (AC 16), Speed 45, d8 Martial Arts, Extra Attack, Stunning Strike, Empowered Strikes, Wholeness of Body" {
  c := rs_monk("Sen", 0, 6);
  #assert c.score[RS_DEX] == 18 && c.ac == 16 && c.speed == 45 && c.rank[RS_RK_MARTIAL_DIE] == 8 && c.uses_max[RS_USE_FOCUS] == 6 && c.rank[RS_RK_EXTRA_ATTACK] == 1;
  #assert rs_has_feature(c, RS_FT_STUNNING_STRIKE) && rs_has_feature(c, RS_FT_EMPOWERED_STRIKES) && rs_has_feature(c, RS_FT_METABOLISM) && rs_has_feature(c, RS_FT_SLOW_FALL) && c.uses_max[RS_USE_WHOLE] == 2 && c.hp_max == 8 + 1 + 5 * (5 + 1);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].state = 21;
  m := rs_add(b[..], c, 2, 2);
  t := rs_add(b[..], rs_barbarian("Gorr", 1, 3), 3, 2);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500; b[0].c[t].eff = rs_state_put(b[0].c[t].eff, EF_RAGE, true);
  b[0].c[m].note[RS_NT_STUN] = 1;
  stunned := false; saved := false; forced := false;
  for k: 0..<40 {
    rs_fresh(b[..], m); seq := b[0].book[0].seq;
    for e: 0..<RS_EFFECTS { if b[0].c[t].eff[e].kind != EF_NONE { rs_drop_effect(b[..], t, e); } }
    rs_aura_lift(b[0].c[t..<t+1], EF_HALVED); b[0].c[t].eff = rs_state_put(b[0].c[t].eff, EF_RAGE, true);
    was := b[0].c[m].uses[RS_USE_FOCUS];
    ok := rs_attack(b[..], m, t, false, -1);
    // Empowered Strikes: Force, which a Rage doesn't halve
    if rs_saw(b[..], seq, " Force (1d8") { forced = true; }
    if rs_saw(b[..], seq, "Stunning Strike") {
      // once a turn however many hits, for 1 Focus Point
      #assert b[0].c[m].uses[RS_USE_FOCUS] == was - 1 && b[0].turn.stunned;
      if rs_has(b[0].c[t], RS_STUNNED) { stunned = true; #assert rs_can_act(b[0].c[t]) == false && rs_attack_edge(b[..], m, t, true, false) == 1; }
      else { saved = true; #assert rs_aura_on(b[0].c[t], EF_HALVED, b[0].clock); }   // its Advantage may be spent by the second attack
    }
    if b[0].c[m].uses[RS_USE_FOCUS] == 0 { b[0].c[m].uses[RS_USE_FOCUS] = 6; }
  }
  #assert stunned && saved && forced;
  // Wholeness of Body: a Bonus Action, 1d8 + 2
  b[0].c[m].hp = 5; rs_fresh(b[..], m);
  #assert rs_wholeness(b[..], m) && b[0].c[m].hp >= 5 + 3 && b[0].c[m].hp <= 5 + 10 && b[0].c[m].uses[RS_USE_WHOLE] == 1;
  #assert !rs_wholeness(b[..], m);
}

#test "a level 6 Devotion Paladin: Strength 18, Extra Attack, two 2nd-level slots, and Aura of Protection" {
  c := rs_paladin("Ulf", 1, 6);
  #assert c.score[RS_STR] == 18 && rs_weapon_attack(c, c.weapon) == 7 && c.rank[RS_RK_EXTRA_ATTACK] == 1 && c.slots_max[1] == 4 && c.slots_max[2] == 2;
  #assert rs_has_feature(c, RS_FT_AURA_OF_PROTECTION) && rs_has_feature(c, RS_FT_FAITHFUL_STEED) && !rs_has_feature(rs_paladin("Ulf", 1, 5), RS_FT_AURA_OF_PROTECTION) && c.uses_max[RS_USE_LAY] == 30 && c.hp_max == 10 + 1 + 5 * (6 + 1);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 6; b[0].dice[0].state = 2;
  p := rs_add(b[..], c, 2, 2);
  f := rs_add(b[..], rs_fighter("Garr", 1, 3), 4, 2);
  g := rs_add(b[..], rs_fighter("Hild", 1, 3), 10, 2);
  e := rs_add(b[..], rs_skeleton("Skeleton", 2), 12, 2);
  // Charisma 14: +2 to its own saves and a friend's 10 feet off; nothing 40 feet off, or to a foe
  #assert rs_aura(b[..], p) == 2 && rs_aura(b[..], f) == 2 && rs_aura(b[..], g) == 0 && rs_aura(b[..], e) == 0;
  #assert rs_save_in(b[..], f, RS_WIS) == rs_save_bonus(b[0].c[f], RS_WIS) + 2;
  // inactive while it is Incapacitated
  b[0].c[p].cond = RS_INCAPACITATED;
  #assert rs_aura(b[..], f) == 0;
}

#test "a level 6 Hunter Ranger: Dexterity 18, Extra Attack with the Longbow, Roving, three Hunter's Marks without a slot" {
  c := rs_ranger("Yen", 0, 6);
  #assert c.score[RS_DEX] == 18 && c.ac == 16 && rs_weapon_attack(c, c.ranged) == 4 + 3 + 2 && c.rank[RS_RK_EXTRA_ATTACK] == 1;
  #assert c.speed == 40 && c.climb == 40 && c.swim == 40 && c.uses_max[RS_USE_FREE] == 3 && c.slots_max[2] == 2 && rs_has_feature(c, RS_FT_DEFT_EXPLORER) && rs_has_feature(c, RS_FT_HUNTERS_LORE);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 6; b[0].dice[0].state = 6;
  r := rs_add(b[..], c, 2, 2);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 14, 2);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_fresh(b[..], r); seq := b[0].book[0].seq;
  #assert rs_shoot(b[..], r, t);
  rolls := 0;
  for e: 0..<(b[0].book[0].seq - seq) {
    ev := rs_recent(b[0].book[0], e);
    tx := cast(string) ev.text[0..<ev.text_n];
    for q: 0..<rs_max(ev.text_n - 6, 0) { if tx[q..<(q + 7)] == " vs AC " { rolls += 1; } }
  }
  #assert rolls == 2;
}

#test "Fireball: a 20-foot-radius sphere, Dex save, 8d6 Fire or half; a level 6 Evoker sculpts its allies out of it" {
  c := rs_wizard("Vesk", 1, 6);
  #assert c.score[RS_INT] == 18 && rs_spell_dc(c) == 8 + 3 + 4 && c.slots_max[3] == 3 && rs_has_feature(c, RS_FT_SCULPT) && rs_has_feature(c, RS_FT_RITUAL_ADEPT) && rs_has_feature(c, RS_FT_MEMORIZE);
  #assert rs_wizard("Vesk", 1, 5).slots_max[3] == 2 && !rs_has_feature(rs_wizard("Vesk", 1, 5), RS_FT_SCULPT);
  fb := rs_spell(SP_FIREBALL); #assert fb.level == 3 && fb.area == RS_A_SPHERE && fb.area_ft == 20 && fb.range_ft == 150 && fb.steps[1].a == 8 && fb.page == 131;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 14; b[0].dice[0].state = 13;
  w := rs_add(b[..], c, 1, 6);
  f := rs_add(b[..], rs_fighter("Garr", 1, 3), 12, 6);   // an ally at the centre
  inner := rs_add(b[..], rs_skeleton("Skeleton", 2), 15, 6);   // 15 feet off the point: inside
  edge := rs_add(b[..], rs_skeleton("Skeleton", 2), 16, 6);   // 20 feet: inside
  out := rs_add(b[..], rs_skeleton("Skeleton", 2), 17, 6);    // 25 feet: outside
  for k: 1..<4 { b[0].c[k + 1].hp = 200; b[0].c[k + 1].hp_max = 200; }
  rs_fresh(b[..], w);
  #assert rs_cast(b[..], w, SP_FIREBALL, 3, 12, 6, -1) && b[0].c[w].slots[3] == 2;
  #assert b[0].c[f].hp == b[0].c[f].hp_max;   // Sculpt Spells
  #assert b[0].c[inner].hp < 200 && b[0].c[edge].hp < 200 && b[0].c[out].hp == 200;
  #assert 200 - b[0].c[inner].hp >= 4 && 200 - b[0].c[inner].hp <= 48;
}

#test "Lightning Bolt: a 100-foot Line 5 feet wide from you, Dex save, 8d6 Lightning or half; Burning Hands: 3d6 Fire in 15 feet" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 30; b[0].dice[0].state = 29;
  w := rs_add(b[..], rs_wizard("Vesk", 1, 5), 2, 2);
  choices := [3] int.[RS_KEY_MAGE_ARMOR, RS_EXEC_SOURCE[SP_LIGHTNING_BOLT], RS_EXEC_SOURCE[SP_BURNING_HANDS]];
  #assert rs_set_spells(b[0].c[w..<w+1], choices[..]);
  on := rs_add(b[..], rs_skeleton("Skeleton", 2), 10, 10);     // on the diagonal: in the Line
  far := rs_add(b[..], rs_skeleton("Skeleton", 2), 21, 21);    // 95 feet along it: in
  past := rs_add(b[..], rs_skeleton("Skeleton", 2), 24, 24);   // 110 feet: past its end
  side := rs_add(b[..], rs_skeleton("Skeleton", 2), 11, 10);   // beside it: out
  for k: 1..<5 { b[0].c[k].hp = 200; b[0].c[k].hp_max = 200; }
  rs_fresh(b[..], w);
  #assert rs_cast(b[..], w, SP_LIGHTNING_BOLT, 3, 30, 30, -1) && b[0].c[w].slots[3] == 1;
  #assert b[0].c[on].hp < 200 && b[0].c[far].hp < 200 && b[0].c[past].hp == 200 && b[0].c[side].hp == 200;
  #assert 200 - b[0].c[on].hp >= 4 && 200 - b[0].c[on].hp <= 48 && b[0].c[w].hp == b[0].c[w].hp_max;
  // Burning Hands, from a 2nd-level slot: 4d6 to the one beside, none to the one 20 feet off
  near := rs_add(b[..], rs_skeleton("Skeleton", 2), 3, 2);
  off := rs_add(b[..], rs_skeleton("Skeleton", 2), 7, 2);
  b[0].c[near].hp = 200; b[0].c[near].hp_max = 200; b[0].c[off].hp = 200; b[0].c[off].hp_max = 200;
  rs_fresh(b[..], w);
  #assert rs_cast(b[..], w, SP_BURNING_HANDS, 2, 3, 2, -1);
  #assert b[0].c[near].hp < 200 && 200 - b[0].c[near].hp <= 24 && b[0].c[off].hp == 200;
}

// The saves against spell sp told since `seq` (the log's count then): each one's creature in to[], how
// many in all.
rs_test_saves :: (b: [] RsBattle, seq: int, sp: int, to: [] int) -> int {
  n := 0;
  m := rs_min(b[0].book[0].seq - seq, RS_EVENTS);
  for q: 0..<m {
    e := rs_recent_at(b[0].book[..], q);
    if e.kind == RS_EV_SAVE && e.spell.value == sp && n < to.count { to[n] = e.to.value; n += 1; }
  }
  return n;
}
#test "Gust of Wind: a 60-foot Line 10 feet wide from you, a Strength save or pushed 15 feet, and again for one that ends its turn in it (#12884)" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 20; b[0].dice[0].state = 31;
  d := rs_add(b[..], rs_druid("Rowan", 0, 5), 2, 10);
  choices := [1] int.[RS_EXEC_SOURCE[SP_GUST_OF_WIND]];
  #assert rs_set_spells(b[0].c[d..<d+1], choices[..]);
  on := rs_add(b[..], rs_skeleton("Skeleton", 2), 8, 10);      // on the Line
  edge := rs_add(b[..], rs_skeleton("Skeleton", 2), 9, 11);    // 5 feet off its middle: in (10 feet wide)
  side := rs_add(b[..], rs_skeleton("Skeleton", 2), 9, 12);    // 10 feet off: out
  end := rs_add(b[..], rs_skeleton("Skeleton", 2), 13, 9);     // 55 feet along: in (past a 15-foot cube)
  past := rs_add(b[..], rs_skeleton("Skeleton", 2), 15, 10);   // 65 feet: past its end
  for k: 1..<6 { b[0].c[k].hp = 200; b[0].c[k].hp_max = 200; b[0].c[k].score[RS_STR] = 1; }
  b[0].c[d].score[rs_max(b[0].c[d].spell_ability, 0)] = 30;   // DC 21: the -5 saves all fail
  rs_start_turn(b[..], d);
  seq := b[0].book[0].seq;
  #assert rs_cast(b[..], d, SP_GUST_OF_WIND, 2, 30, 10, -1) && b[0].c[d].conc == SP_GUST_OF_WIND;
  to: [16] int;
  n := rs_test_saves(b[..], seq, SP_GUST_OF_WIND, to[..]);
  #assert n == 3;
  seen := [6] bool.[false, false, false, false, false, false];
  for q: 0..<n { seen[to[q]] = true; }
  #assert seen[on] && seen[edge] && seen[end] && !seen[side] && !seen[past];
  // pushed 15 feet away from the caster
  #assert b[0].c[on].x == 11 && b[0].c[on].y == 10 && b[0].c[edge].x == 12 && b[0].c[edge].y == 14;
  rs_end_turn(b[..], d);
  // a later round: the one it pushed to 45 feet along ends its turn in the Line and saves again (and
  // is pushed again); the one beside it that never was in it doesn't
  seq = b[0].book[0].seq;
  rs_start_turn(b[..], on); #assert b[0].turn.new_round; rs_end_turn(b[..], on);
  rs_start_turn(b[..], side); rs_end_turn(b[..], side);
  n = rs_test_saves(b[..], seq, SP_GUST_OF_WIND, to[..]);
  #assert n == 1 && to[0] == on && b[0].c[on].x == 14;
  // the Line blasts from where its caster stands: stepped back to x 0, 55 feet along is past its end;
  // stepped on to x 4, 65 feet from where it was cast is in
  rs_place(b[..], d, 0, 10);
  b[0].c[end].x = 13; b[0].c[end].y = 10;
  seq = b[0].book[0].seq;
  rs_start_turn(b[..], end); rs_end_turn(b[..], end);
  #assert rs_test_saves(b[..], seq, SP_GUST_OF_WIND, to[..]) == 0;
  rs_place(b[..], d, 4, 10);
  seq = b[0].book[0].seq;
  rs_start_turn(b[..], past); rs_end_turn(b[..], past);
  #assert rs_test_saves(b[..], seq, SP_GUST_OF_WIND, to[..]) == 1 && to[0] == past;
  // its concentration ends: no save after
  rs_end_concentration(b[..], d, "");
  seq = b[0].book[0].seq;
  b[0].c[on].x = 5; b[0].c[on].y = 10;
  b[0].c[on].round_at = b[0].c[on].turn_at;
  rs_start_turn(b[..], on); rs_end_turn(b[..], on);
  #assert rs_test_saves(b[..], seq, SP_GUST_OF_WIND, to[..]) == 0;
}

#test "Spirit Guardians: foes ending their turn within 15 feet save or take 3d8 Radiant, once a turn, at half Speed" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 17;
  c := rs_add(b[..], rs_cleric("Nyx", 0, 5), 4, 3);
  s := rs_add(b[..], rs_skeleton("Skeleton", 2), 6, 3);
  far := rs_add(b[..], rs_skeleton("Skeleton", 2), 12, 3);
  b[0].c[s].hp = 200; b[0].c[s].hp_max = 200; b[0].c[far].hp = 200; b[0].c[far].hp_max = 200;
  rs_start_turn(b[..], c);
  #assert rs_cast(b[..], c, SP_SPIRIT_GUARDIANS, 3, 0, 0, c) && b[0].c[c].conc == SP_SPIRIT_GUARDIANS && b[0].guards == 1;
  rs_end_turn(b[..], c);
  rs_start_turn(b[..], s);
  #assert rs_guarded(b[..], s) && !rs_guarded(b[..], far);
  rs_end_turn(b[..], s);
  hit := 200 - b[0].c[s].hp;
  #assert hit >= 1 && hit <= 24;
  // once a turn: a second check this turn does nothing
  rs_guardians(b[..], s);
  #assert 200 - b[0].c[s].hp == hit;
  rs_start_turn(b[..], far); rs_end_turn(b[..], far);
  #assert b[0].c[far].hp == 200;
  // the far one walks in: it saves as it enters
  rs_start_turn(b[..], far); b[0].turn.move_left = 6;
  for k: 0..<5 { ok := rs_step_to(b[..], far, b[0].c[far].x - 1, 3); }
  #assert b[0].c[far].x == 7 && b[0].c[far].hp < 200;
  rs_end_concentration(b[..], c, "");
  #assert b[0].guards == 0;
}

// A zone's battle (#13275, #13285): the zone gives the rules its creature table with rs_use, sized by
// its caps (150 seats, 96 creatures, a familiar a seat: 396), and RS_MAX stays the size of the room a
// small battle has of its own. Nothing in a cast, an attack, a lasting effect or a turn counts to RS_MAX.
// ---- the procedures #13287 found with no check of their own
// The movement a turn has left, in feet.
rs_turn_feet :: (t: RsTurn) -> int { return t.move_left * RS_SQUARE + t.move_feet; }
#test "standing up: on its own turn a Prone creature spends half its Speed and is Prone no more; no other creature, turn or state stands it" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_fighter("Garr", 0, 3), 2, 2); f := rs_add(b[..], rs_fighter("Foe", 1, 3), 8, 2);
  rs_start_turn(b[..], a);
  #assert !rs_stand_up(b[..], a) && !rs_stand_up(b[..], -1) && !rs_stand_up(b[..], b[0].n);   // not Prone; no such creature
  b[0].c[a].cond |= RS_PRONE; b[0].c[f].cond |= RS_PRONE;
  #assert !rs_stand_up(b[..], f) && rs_has(b[0].c[f], RS_PRONE);                              // not its turn
  speed := b[0].c[a].speed;
  #assert speed == 30 && rs_turn_feet(b[0].turn) == speed;
  #assert rs_stand_up(b[..], a) && !rs_has(b[0].c[a], RS_PRONE) && rs_turn_feet(b[0].turn) == speed - speed / 2;
  // with under half its Speed left it stays down, and nothing is spent
  b[0].c[a].cond |= RS_PRONE; b[0].turn.move_left = 2; b[0].turn.move_feet = 4;
  #assert !rs_stand_up(b[..], a) && rs_has(b[0].c[a], RS_PRONE) && b[0].turn.move_left == 2 && b[0].turn.move_feet == 4;
  // exactly half is enough
  b[0].turn.move_left = 3; b[0].turn.move_feet = 0;
  #assert rs_stand_up(b[..], a) && !rs_has(b[0].c[a], RS_PRONE) && rs_turn_feet(b[0].turn) == 0;
  // Speed 0 (Grappled) keeps it down
  b[0].c[a].cond |= RS_PRONE; b[0].turn.move_left = 6; b[0].c[a].cond |= RS_GRAPPLED;
  #assert !rs_stand_up(b[..], a) && rs_has(b[0].c[a], RS_PRONE);
}
#test "a team's creatures still up: alive and above 0 Hit Points, of that team only" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6;
  for i: 0..<3 { _ := rs_add(b[..], rs_fighter("A", 0, 1), 1 + i, 1); }
  for i: 0..<2 { _ := rs_add(b[..], rs_fighter("B", 1, 1), 1 + i, 4); }
  #assert rs_team_up(b[..], 0) == 3 && rs_team_up(b[..], 1) == 2 && rs_team_up(b[..], 2) == 0;
  b[0].c[0].hp = 0; #assert rs_team_up(b[..], 0) == 2;                      // at 0: down
  b[0].c[1].dead = true; #assert rs_team_up(b[..], 0) == 1;                 // dead, whatever its Hit Points
  b[0].c[2].hp = 1; #assert rs_team_up(b[..], 0) == 1 && rs_team_up(b[..], 1) == 2;
  b[0].c[4].hp = -3; #assert rs_team_up(b[..], 1) == 1;                     // the last creature counts
  // a record past the battle's count is nobody
  b[0].c[b[0].n] = rs_fighter("C", 1, 1); #assert rs_team_up(b[..], 1) == 1;
}
#test "shaking a creature out of Hypnotic Pattern's stupor: an action from within 5 feet ends it and says so; no stupor, no action spent" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_fighter("Garr", 0, 3), 2, 2); j := rs_add(b[..], rs_fighter("Ally", 0, 3), 3, 2); far := rs_add(b[..], rs_fighter("Far", 0, 3), 5, 2);
  daze := RsEffect.{kind = EF_DAZED, cond = RS_CHARMED | RS_INCAPACITATED, by = far, spell = SP_HYPNOTIC_PATTERN, until = RS_NO_END, save = -1};
  rs_fresh(b[..], a);
  #assert !rs_shake(b[..], a, j) && !b[0].turn.action;                       // no stupor: nothing to shake off, and the action is kept
  #assert rs_put_effect(b[..], j, daze) && rs_put_effect(b[..], far, daze) && !rs_can_act(b[0].c[j]);
  #assert !rs_shake(b[..], a, a) && !rs_shake(b[..], -1, j) && !rs_shake(b[..], a, -1) && !rs_shake(b[..], a, b[0].n) && !rs_shake(b[..], b[0].n, j);
  #assert !rs_shake(b[..], a, far) && rs_effect(b[0].c[far], EF_DAZED);      // 15 feet away
  b[0].who = j; #assert !rs_shake(b[..], a, j);                              // not the shaker's turn
  rs_fresh(b[..], a); b[0].turn.action = true; #assert !rs_shake(b[..], a, j) && rs_effect(b[0].c[j], EF_DAZED);   // its action is spent
  b[0].turn.action = false; b[0].c[a].cond |= RS_STUNNED; #assert !rs_shake(b[..], a, j);                           // it can't act
  b[0].c[a].cond = 0; seq := b[0].book[0].seq;
  #assert rs_shake(b[..], a, j) && b[0].turn.action && !rs_effect(b[0].c[j], EF_DAZED) && rs_can_act(b[0].c[j]) && rs_effect(b[0].c[far], EF_DAZED);
  e := rs_recent_at(b[0].book[..], 0);
  #assert b[0].book[0].seq > seq && e.kind == RS_EV_END && e.spell.value == SP_HYPNOTIC_PATTERN && e.by.value == a && e.to.value == j;
  // exactly 5 feet is in reach; the diagonal too
  rs_fresh(b[..], a); rs_place(b[..], far, 3, 3); #assert rs_shake(b[..], a, far) && !rs_effect(b[0].c[far], EF_DAZED);
}
#test "the Attack action is rs_attack with no Reckless Attack and no Cleave: one action, the weapon's blow, in reach, on its own turn" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 2, 2); t := rs_add(b[..], rs_skeleton("Bones", 1), 3, 2); far := rs_add(b[..], rs_skeleton("Far", 1), 6, 2);
  b[0].c[t].hp = 100; b[0].c[t].hp_max = 100; b[0].c[t].ac = 1;
  rs_fresh(b[..], a);
  #assert !rs_attack_action(b[..], a, far) && !rs_attack_action(b[..], a, a) && !rs_attack_action(b[..], a, -1) && !rs_attack_action(b[..], a, b[0].n) && !b[0].turn.action;
  #assert rs_attack_action(b[..], a, t) && b[0].turn.action && b[0].c[t].hp < 100;
  #assert !rs_aura_on(b[0].c[a], EF_RECKLESS, b[0].clock);                   // never reckless
  hp := b[0].c[t].hp; #assert !rs_attack_action(b[..], a, t) && b[0].c[t].hp == hp;   // one action a turn
  rs_fresh(b[..], t); #assert !rs_attack_action(b[..], a, t);                // not its turn
  // the same blow as rs_attack's, die for die
  c: [1] RsBattle; c_room: [1] RsRoom; rs_have(c[..], c_room[..]); c[0].w = 12; c[0].h = 6; c[0].dice[0].fixed = true;
  ca := rs_add(c[..], rs_barbarian("Thorn", 0, 3), 2, 2); ct := rs_add(c[..], rs_skeleton("Bones", 1), 3, 2);
  c[0].c[ct].hp = 100; c[0].c[ct].hp_max = 100; c[0].c[ct].ac = 1; rs_fresh(c[..], ca);
  #assert rs_attack(c[..], ca, ct, false, -1) && c[0].c[ct].hp == hp;
}
#test "Martial Arts' Bonus Action strike: an Unarmed Strike in reach, for one with a Martial Arts die, once a turn" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true;
  m := rs_add(b[..], rs_monk("Ash", 0, 3), 2, 2); t := rs_add(b[..], rs_skeleton("Bones", 1), 3, 2); far := rs_add(b[..], rs_skeleton("Far", 1), 5, 2);
  f := rs_add(b[..], rs_fighter("Garr", 0, 3), 3, 3);
  b[0].c[t].hp = 100; b[0].c[t].hp_max = 100; b[0].c[t].ac = 1;
  rs_fresh(b[..], m);
  #assert !rs_bonus_strike(b[..], m, far) && !rs_bonus_strike(b[..], m, -1) && !rs_bonus_strike(b[..], m, b[0].n) && !b[0].turn.bonus;   // 15 feet; nobody
  b[0].c[far].dead = true; rs_place(b[..], far, 2, 3); #assert !rs_bonus_strike(b[..], m, far) && !b[0].turn.bonus;                     // the dead
  focus := b[0].c[m].uses[RS_USE_FOCUS];
  #assert rs_bonus_strike(b[..], m, t) && b[0].turn.bonus && !b[0].turn.action && b[0].c[t].hp < 100 && b[0].c[m].uses[RS_USE_FOCUS] == focus;   // it costs no Focus
  hp := b[0].c[t].hp; #assert !rs_bonus_strike(b[..], m, t) && b[0].c[t].hp == hp;                                                       // one Bonus Action
  rs_fresh(b[..], t); #assert !rs_bonus_strike(b[..], m, t);                                                                             // not its turn
  rs_fresh(b[..], m); b[0].c[m].cond |= RS_STUNNED; #assert !rs_bonus_strike(b[..], m, t) && !b[0].turn.bonus; b[0].c[m].cond = 0;      // it can't act
  // no Martial Arts die: no such strike
  rs_fresh(b[..], f); #assert b[0].c[f].rank[RS_RK_MARTIAL_DIE] == 0 && !rs_bonus_strike(b[..], f, t) && !b[0].turn.bonus && b[0].c[t].hp == hp;
  b[0].c[f].rank[RS_RK_MARTIAL_DIE] = 6; #assert rs_bonus_strike(b[..], f, t) && b[0].turn.bonus;
}
#test "Dash is an action and Step of the Wind a Monk's Bonus Action: each adds its Speed to the turn's movement once, and tells of the feature" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 6; b[0].dice[0].fixed = true;
  m := rs_add(b[..], rs_monk("Ash", 0, 3), 2, 2); f := rs_add(b[..], rs_fighter("Garr", 0, 3), 2, 4);
  rs_start_turn(b[..], f);
  left := rs_turn_feet(b[0].turn); speed := b[0].c[f].speed;
  #assert left == speed && rs_dash(b[..], f) && b[0].turn.action && !b[0].turn.bonus && b[0].turn.dash_n == 1 && rs_turn_feet(b[0].turn) == left + speed;
  #assert !rs_dash(b[..], f) && b[0].turn.dash_n == 1 && rs_turn_feet(b[0].turn) == left + speed;      // its action is spent
  #assert !rs_step_of_the_wind(b[..], f) && !b[0].turn.bonus;                                    // no Focus pool: not a Monk's feature
  #assert !rs_dash(b[..], m) && !rs_step_of_the_wind(b[..], m);                                  // not its turn
  rs_end_turn(b[..], f); rs_start_turn(b[..], m);
  mleft := rs_turn_feet(b[0].turn); mspeed := b[0].c[m].speed; focus := b[0].c[m].uses[RS_USE_FOCUS]; seq := b[0].book[0].seq;
  #assert rs_step_of_the_wind(b[..], m) && b[0].turn.bonus && !b[0].turn.action && b[0].turn.dash_n == 1 && rs_turn_feet(b[0].turn) == mleft + mspeed && b[0].c[m].uses[RS_USE_FOCUS] == focus;
  e := rs_recent_at(b[0].book[..], 0);
  #assert b[0].book[0].seq == seq + 1 && e.kind == RS_EV_FEAT && e.feat == RS_FT_STEP_OF_THE_WIND && e.by.value == m;
  #assert !rs_step_of_the_wind(b[..], m) && b[0].turn.dash_n == 1;                               // one Bonus Action
  // and its action's Dash on top: twice its Speed more
  #assert rs_dash(b[..], m) && b[0].turn.action && b[0].turn.dash_n == 2 && rs_turn_feet(b[0].turn) == mleft + 2 * mspeed;
  // a creature that can't act dashes with neither
  rs_end_turn(b[..], m); rs_start_turn(b[..], f); b[0].c[f].cond |= RS_STUNNED;
  #assert !rs_dash(b[..], f) && !b[0].turn.action && !rs_dash(b[..], -1) && !rs_dash(b[..], b[0].n);
}
#test "a state Aura needs a place: with its list full, Rage, Dodge, Patient Defense, Shield and Bardic Inspiration are refused before any cost, and Addle is not applied" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 16; b[0].h = 8; b[0].dice[0].fixed = true;
  ba := rs_add(b[..], rs_barbarian("Thorn", 0, 3), 1, 1); mo := rs_add(b[..], rs_monk("Ash", 0, 3), 3, 1);
  wz := rs_add(b[..], rs_wizard("Mira", 0, 3), 5, 1); bd := rs_add(b[..], rs_bard("Lark", 0, 3), 7, 1); fi := rs_add(b[..], rs_fighter("Garr", 0, 3), 9, 1);
  full := RsEffect.{kind = EF_HEX, by = 0, spell = SP_HEX, until = RS_NO_END, save = -1};
  for i: 0..<5 { for k: 0..<RS_EFFECTS { b[0].c[i].eff[k] = full; b[0].c[i].eff[k].by = k; } }
  // Rage: no use, no Bonus Action
  rs_fresh(b[..], ba); rages := b[0].c[ba].uses[RS_USE_RAGE];
  #assert !rs_rage(b[..], ba) && b[0].c[ba].uses[RS_USE_RAGE] == rages && !b[0].turn.bonus && !rs_effect(b[0].c[ba], EF_RAGE);
  // Dodge: no action; Patient Defense: no Focus Point, no Bonus Action
  rs_fresh(b[..], fi); #assert !rs_dodge(b[..], fi) && !b[0].turn.action && !rs_effect(b[0].c[fi], EF_DODGE);
  rs_fresh(b[..], mo); focus := b[0].c[mo].uses[RS_USE_FOCUS];
  #assert !rs_patient_defense(b[..], mo) && b[0].c[mo].uses[RS_USE_FOCUS] == focus && !b[0].turn.bonus && !b[0].turn.disengaged && !rs_effect(b[0].c[mo], EF_DODGE);
  // Shield: no slot, no Reaction
  slots := b[0].c[wz].slots[1]; b[0].c[wz].reacted = false;
  #assert !rs_shield(b[..], wz) && b[0].c[wz].slots[1] == slots && !b[0].c[wz].reacted && !rs_effect(b[0].c[wz], EF_SHIELD);
  // Bardic Inspiration at one whose list is full: no use, no Bonus Action
  rs_fresh(b[..], bd); uses := b[0].c[bd].uses[RS_USE_INSPIRE];
  #assert !rs_inspire(b[..], bd, fi) && b[0].c[bd].uses[RS_USE_INSPIRE] == uses && !b[0].turn.bonus && rs_state_value(b[0].c[fi], EF_INSPIRED) == 0;
  // the Open Hand's Addle on a full list: nothing, and nothing told
  seq := b[0].book[0].seq; rs_open_hand(b[..], mo, fi, OH_ADDLE);
  #assert !rs_effect(b[0].c[fi], EF_ADDLED) && b[0].book[0].seq == seq;
  // one place free on each: every one is taken, and paid
  for i: 0..<5 { b[0].c[i].eff[3] = RsEffect.{}; }
  rs_fresh(b[..], ba); #assert rs_rage(b[..], ba) && b[0].c[ba].uses[RS_USE_RAGE] == rages - 1 && b[0].turn.bonus && rs_effect(b[0].c[ba], EF_RAGE) && b[0].c[ba].eff[3].kind == EF_RAGE;
  #assert rs_state_has(b[0].c[ba], EF_RAGE, RS_RAGE_KEPT) && !rs_state_has(b[0].c[ba], EF_RAGE, RS_RAGE_STRUCK);
  rs_fresh(b[..], fi); #assert rs_dodge(b[..], fi) && b[0].turn.action && rs_effect(b[0].c[fi], EF_DODGE);
  rs_fresh(b[..], mo); #assert rs_patient_defense(b[..], mo) && b[0].c[mo].uses[RS_USE_FOCUS] == focus - 1 && b[0].turn.bonus && rs_effect(b[0].c[mo], EF_DODGE);
  #assert rs_shield(b[..], wz) && b[0].c[wz].slots[1] == slots - 1 && b[0].c[wz].reacted && rs_effect(b[0].c[wz], EF_SHIELD);
  // the list is full again with its own state: taking the same state again still has its room (Dodge on a second turn)
  rs_fresh(b[..], fi); #assert rs_effect_free(b[0].c[fi]) == 0 && rs_dodge(b[..], fi) && rs_effect(b[0].c[fi], EF_DODGE);
  // the Bard's die goes to one with room, and Addle is applied and told
  b[0].c[fi].eff[5] = RsEffect.{}; rs_fresh(b[..], bd);
  #assert rs_inspire(b[..], bd, fi) && b[0].c[bd].uses[RS_USE_INSPIRE] == uses - 1 && b[0].turn.bonus && rs_state_value(b[0].c[fi], EF_INSPIRED) == b[0].c[bd].rank[RS_RK_INSPIRATION_DIE];
  b[0].c[fi].eff[7] = RsEffect.{}; seq = b[0].book[0].seq; rs_open_hand(b[..], mo, fi, OH_ADDLE);
  #assert rs_effect(b[0].c[fi], EF_ADDLED) && b[0].book[0].seq == seq + 1;
}
#test "a zone's table of lasting areas (one a caster of 150): a ninth caster's area stands, each ends with its own Concentration, and a Zone of Truth takes one of the first 62 places" {
  room: [160] RsCreature; occ: [80 * 80] int; zones: [150] RsZone;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); rs_use(b[..], room[..], occ[..]); rs_use_zones(b[..], zones[..]); b[0].w = 80; b[0].h = 80; b[0].dice[0].fixed = true;
  #assert b[0].zone.count == 150 && rs_truth_zones(b[..]) == 62 && RS_ZONES == 8 && RS_TRUTH_ZONES == 62;
  // twelve Druids, each with an Entangle of its own: more areas than a battle's own eight
  for i: 0..<12 { _ := rs_add(b[..], rs_druid("", 0, 3), 2 + i * 6, 2); }
  for i: 0..<12 { rs_fresh(b[..], i); #assert rs_cast(b[..], i, SP_ENTANGLE, 1, 2 + i * 6, 12, -1) && b[0].zone[i].on && b[0].zone[i].by == i && b[0].zone[i].spell == SP_ENTANGLE; }
  #assert !b[0].zone[12].on && rs_difficult(b[..], 2 + 11 * 6, 12) && !rs_difficult(b[..], 2 + 11 * 6, 40);
  // the eleventh's Concentration ends: its area goes, and no other
  rs_end_concentration(b[..], 10, ""); #assert !b[0].zone[10].on && b[0].zone[9].on && b[0].zone[11].on && !rs_difficult(b[..], 2 + 10 * 6, 12);
  // the clock ends the rest together, the last place too
  b[0].zone[149] = RsZone.{on = true, by = 0, spell = SP_FOG_CLOUD, until = b[0].clock + 5};
  rs_tick_ticks(b[..], 5); #assert !b[0].zone[149].on && b[0].zone[0].on && !rs_release_zone(b[..], 150) && !rs_release_zone(b[..], 149) && rs_release_zone(b[..], 0);
  // Zone of Truth: with the first 62 places taken it is refused and nothing is paid, though places past them are free
  c := rs_add(b[..], rs_paladin("", 0, 5), 40, 40);
  for k: 0..<62 { b[0].zone[k] = RsZone.{on = true, by = 1, spell = SP_FOG_CLOUD, x0 = 70, y0 = 70, x1 = 71, y1 = 71, until = RS_NO_END}; }
  rs_fresh(b[..], c); slots := b[0].c[c].slots[2];
  #assert rs_spell_ready(b[0].c[c], SP_ZONE_OF_TRUTH) && !rs_cast(b[..], c, SP_ZONE_OF_TRUTH, 2, 40, 40, -1) && b[0].c[c].slots[2] == slots && !b[0].zone[62].on && b[0].truth_zones == 0;
  // any other area takes a place past them
  d := rs_add(b[..], rs_druid("", 0, 3), 44, 44); rs_fresh(b[..], d);
  #assert rs_cast(b[..], d, SP_ENTANGLE, 1, 44, 50, -1) && b[0].zone[62].on && b[0].zone[62].by == d;
  // one of the first 62 freed: the Zone of Truth takes it, and its bit is that place's
  b[0].zone[61].on = false; rs_fresh(b[..], c);
  #assert rs_cast(b[..], c, SP_ZONE_OF_TRUTH, 2, 40, 40, -1) && b[0].zone[61].on && b[0].zone[61].spell == SP_ZONE_OF_TRUTH && b[0].truth_zones == 1 << 61 && b[0].c[c].slots[2] == slots - 1;
  // a battle with no table given keeps its own eight
  own: [1] RsBattle; own_room: [1] RsRoom; rs_have(own[..], own_room[..]); own[0].w = 8; own[0].h = 8; _ := rs_add(own[..], rs_druid("", 0, 3), 1, 1);
  #assert own[0].zone.count == RS_ZONES && rs_truth_zones(own[..]) == RS_ZONES;
}
#test "a battle in a zone's room (150 seats, 96 creatures, a familiar a seat): creatures past the rules' own 216 cast, strike, are struck and bear effects as any other" {
  room: [396] RsCreature; occ: [80 * 80] int;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); rs_use(b[..], room[..], occ[..]); b[0].w = 80; b[0].h = 80; b[0].dice[0].fixed = true;
  for i: 0..<150 { _ := rs_add(b[..], rs_fighter("", 0, 1), i % 75, i / 75); }           // the seats, 0 to 149
  for i: 0..<96 { _ := rs_add(b[..], rs_skeleton("", 2), 4 + i % 48, 30 + i / 48); }     // the zone's creatures, 150 to 245
  for i: 0..<149 { _ := rs_add(b[..], rs_fighter("", 0, 1), i % 75, 70 + i / 75); }      // the familiars' slots, 246 to 394
  w := rs_add(b[..], rs_wizard("", 0, 5), 20, 24);                                       // the last slot casts
  #assert w == 395 && b[0].n == 396 && rs_room_for(b[..]) == 396 && b[0].c.count == 396 && RS_MAX == 216;
  #assert rs_add(b[..], rs_fighter("", 0, 1), 79, 79) == -1 && b[0].n == 396;   // the zone's cap is the table's
  // creature 395's Fireball at creatures 216 to 245 (the second row's first thirty): each takes it; those out of it don't
  for i: 150..<246 { b[0].c[i].hp = 200; b[0].c[i].hp_max = 200; }
  rs_fresh(b[..], w);
  #assert rs_at(b[..], 22, 31) == 216 && rs_cast(b[..], w, SP_FIREBALL, 3, 22, 31, -1) && b[0].c[w].slots[3] == 1;
  #assert b[0].c[216].hp < 200 && b[0].c[217].hp < 200 && b[0].c[220].hp < 200 && b[0].c[168].hp < 200 && b[0].c[245].hp == 200 && b[0].c[150].hp == 200 && b[0].c[w].hp == b[0].c[w].hp_max;
  // creature 394 strikes creature 245, and 245 strikes back: both past the rules' own room
  f := 394; t := 245;
  rs_place(b[..], f, 51, 32); #assert rs_at(b[..], 51, 32) == f && rs_at(b[..], 51, 31) == t;
  rs_fresh(b[..], f); b[0].c[t].ac = 1; #assert rs_attack(b[..], f, t, false, -1) && b[0].c[t].hp < 200;
  rs_fresh(b[..], t); b[0].c[f].ac = 1; fh := b[0].c[f].hp; #assert rs_attack(b[..], t, f, false, -1) && b[0].c[f].hp < fh;
  // a lasting effect on creature 300 (an Aura's record, ability-record.coax), and the turn of each
  #assert rs_aura_grant(b[..], 300, EF_SACRED) && rs_aura_on(b[0].c[300], EF_SACRED, b[0].clock) && !rs_aura_on(b[0].c[299], EF_SACRED, b[0].clock) && b[0].c[300].eff[0].kind == EF_SACRED;
  rs_start_turn(b[..], 300); #assert b[0].who == 300; rs_end_turn(b[..], 300);
  rs_start_turn(b[..], w); #assert b[0].who == w && b[0].turn.move_left > 0; rs_end_turn(b[..], w);
}

#test "Call Lightning: a 3d10 bolt within 5 feet of a point, and a Magic action for another while it lasts" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 8; b[0].dice[0].state = 19;
  d := rs_add(b[..], rs_druid("Rowan", 0, 5), 1, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 15, 3);
  u := rs_add(b[..], rs_skeleton("Skeleton", 2), 16, 3);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 200; b[0].c[u].hp = 200; b[0].c[u].hp_max = 200;
  rs_fresh(b[..], d);
  #assert !rs_cast(b[..], d, SP_CALL_BOLT, 0, 15, 3, -1);   // not before the cloud
  #assert rs_cast(b[..], d, SP_CALL_LIGHTNING, 3, 15, 3, -1) && b[0].c[d].conc == SP_CALL_LIGHTNING;
  #assert b[0].c[t].hp < 200 && b[0].c[u].hp < 200;
  for k: 0..<RS_ZONES { #assert !b[0].zone[k].on; }   // the bolt leaves nothing on the ground
  th := b[0].c[t].hp;
  rs_fresh(b[..], d);
  #assert rs_cast(b[..], d, SP_CALL_BOLT, 0, 15, 3, -1) && b[0].c[t].hp < th && b[0].c[d].slots[3] == 1;
}

#test "Hypnotic Pattern: Charmed and Incapacitated at Speed 0 on a failed Wis save, ending when it takes damage" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 10; b[0].dice[0].state = 23;
  a := rs_add(b[..], rs_bard("Lark", 0, 5), 1, 4);
  b[0].c[a].score[RS_CHA] = 30;   // a DC no Skeleton makes
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 12, 4);
  rs_fresh(b[..], a);
  #assert rs_cast(b[..], a, SP_HYPNOTIC_PATTERN, 3, 12, 4, -1);
  #assert rs_has(b[0].c[t], RS_CHARMED) && rs_has(b[0].c[t], RS_INCAPACITATED) && !rs_can_act(b[0].c[t]) && !rs_can_move(b[0].c[t]);
  rs_damage(b[..], a, t, 1, RS_FIRE, false, -1);
  #assert !rs_has(b[0].c[t], RS_CHARMED) && rs_can_act(b[0].c[t]) && rs_can_move(b[0].c[t]);
}

#test "a level 6 Draconic Sorcerer: Charisma 18 (AC 16), three 3rd-level slots, Elemental Affinity (Fire Resistance, +Cha on a Fire spell)" {
  c := rs_sorcerer("Ivy", 0, 6);
  #assert c.score[RS_CHA] == 18 && c.ac == 10 + 2 + 4 && c.slots_max[3] == 3 && c.uses_max[RS_USE_SORCERY] == 6 && rs_has_feature(c, RS_FT_RESTORATION);
  #assert c.hp_max == 6 + 1 + 5 * (4 + 1) + 3 + 3 && c.rank[RS_RK_AFFINITY] == RS_FIRE && (c.resist & (1 << RS_FIRE)) != 0;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 8; b[0].dice[0].state = 29;
  s := rs_add(b[..], c, 1, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 10, 3);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500; b[0].c[t].ac = 1;
  // Fire Bolt: 2d10 + 4 at level 6, so never under 6
  low := 100;
  for k: 0..<20 { rs_fresh(b[..], s); hp := b[0].c[t].hp; ok := rs_cast(b[..], s, SP_FIRE_BOLT, 0, 0, 0, t); if b[0].c[t].hp < hp { low = rs_min(low, hp - b[0].c[t].hp); } }
  #assert low >= 6 && low < 100;
  // and its own Fire Resistance halves a Fireball on it
  #assert rs_resisted(b[..], s, 20, RS_FIRE) == 10;
}

#test "a level 6 Life Cleric: Wisdom 18, Spirit Guardians' slots, three Channel Divinity uses, Sear Undead and Blessed Healer" {
  c := rs_cleric("Nyx", 1, 6);
  #assert c.score[RS_WIS] == 18 && rs_spell_dc(c) == 15 && c.slots_max[3] == 3 && c.uses_max[RS_USE_CHANNEL] == 3 && rs_has_feature(c, RS_FT_SEAR_UNDEAD) && rs_has_feature(c, RS_FT_BLESSED_HEALER);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 31;
  k := rs_add(b[..], c, 2, 3);
  for q: 0..<4 { s := rs_add(b[..], rs_skeleton("Skeleton", 2), 4 + q, 3); b[0].c[s].hp = 100; b[0].c[s].hp_max = 100; }
  rs_fresh(b[..], k);
  #assert rs_turn_undead(b[..], k);
  // a turned Skeleton took Sear Undead's 4d8 and is still turned
  seared := false;
  for q: 1..<5 { if rs_effect(b[0].c[q], EF_TURNED) { #assert b[0].c[q].hp <= 100 - 4 && b[0].c[q].hp >= 100 - 32; seared = true; } }
  #assert seared;
  // Blessed Healer: Healing Word on a friend gives the Cleric 2 + 1
  f := rs_add(b[..], rs_fighter("Garr", 1, 3), 2, 5);
  b[0].c[f].hp = 5; b[0].c[k].hp = 10;
  rs_fresh(b[..], k);
  #assert rs_cast(b[..], k, SP_HEALING_WORD, 1, 0, 0, f) && b[0].c[k].hp == 13 && b[0].c[f].hp > 5;
}

#test "a level 6 Land Druid: Wisdom 18, three Wild Shape uses, Wild Resurgence both ways, Natural Recovery's free Hold Person, Call Lightning's slots" {
  c := rs_druid("Rowan", 0, 6);
  #assert c.score[RS_WIS] == 18 && rs_spell_dc(c) == 15 && c.uses_max[RS_USE_WILD] == 3 && c.slots_max[3] == 3 && rs_has_feature(c, RS_FT_WILD_COMPANION) && rs_has_feature(c, RS_FT_WILD_RESURGENCE);
  #assert c.rank[RS_RK_FREE_SPELL] == SP_HOLD_PERSON && c.uses_max[RS_USE_FREE] == 1;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 37;
  d := rs_add(b[..], c, 2, 3);
  t := rs_add(b[..], rs_fighter("Garr", 1, 3), 8, 3);
  rs_fresh(b[..], d);
  #assert !rs_wild_resurgence(b[..], d);   // it still has uses
  #assert rs_resurge_slot(b[..], d) && b[0].c[d].slots[1] == 5 && b[0].c[d].uses[RS_USE_WILD] == 2 && !rs_resurge_slot(b[..], d);
  b[0].c[d].uses[RS_USE_WILD] = 0;
  #assert rs_wild_resurgence(b[..], d) && b[0].c[d].uses[RS_USE_WILD] == 1 && b[0].c[d].slots[1] == 4 && !rs_wild_resurgence(b[..], d);
  // Natural Recovery: Hold Person without a slot, once
  #assert rs_cast(b[..], d, SP_HOLD_PERSON, 0, 0, 0, t) && b[0].c[d].slots[2] == 3 && b[0].c[d].uses[RS_USE_FREE] == 0;
}

#test "a level 6 Lore Bard: Charisma 18, four Inspirations of a d8, Font of Inspiration, Magical Discoveries' Fireball" {
  c := rs_bard("Lark", 0, 6);
  #assert c.score[RS_CHA] == 18 && rs_spell_dc(c) == 15 && c.uses_max[RS_USE_INSPIRE] == 4 && c.rank[RS_RK_INSPIRATION_DIE] == 8 && c.slots_max[3] == 3;
  #assert rs_has_feature(c, RS_FT_FONT) && rs_has_feature(c, RS_FT_JACK) && c.rank[RS_RK_EXPERTISE] == 2 && c.rank[RS_RK_DISCOVERY + 0] == SP_FIREBALL && c.rank[RS_RK_DISCOVERY + 1] == SP_SPIRIT_GUARDIANS;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 8; b[0].dice[0].state = 41;
  a := rs_add(b[..], c, 1, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 14, 3);
  rs_fresh(b[..], a);
  #assert !rs_font(b[..], a);   // all four uses still held
  b[0].c[a].uses[RS_USE_INSPIRE] = 0;
  #assert rs_font(b[..], a) && b[0].c[a].uses[RS_USE_INSPIRE] == 1 && b[0].c[a].slots[1] == 3 && !b[0].turn.action && !b[0].turn.bonus;
  th := b[0].c[t].hp;
  #assert rs_cast(b[..], a, SP_FIREBALL, 3, 14, 3, -1) && b[0].c[a].slots[3] == 2 && b[0].c[t].hp < th;
}

#test "a level 6 Fiend Warlock: Charisma 18, two 3rd-level pact slots, Fireball, Dark One's Own Luck on a failed save" {
  c := rs_warlock("Vex", 0, 6, SP_ELDRITCH_BLAST);
  #assert c.score[RS_CHA] == 18 && rs_spell_dc(c) == 15 && c.slots_max[3] == 2 && c.slots_max[2] == 0 && c.uses_max[RS_USE_LUCK] == 4 && rs_has_feature(c, RS_FT_MAGICAL_CUNNING);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 30; b[0].h = 8; b[0].dice[0].state = 43;
  w := rs_add(b[..], c, 1, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 14, 3);
  rs_fresh(b[..], w);
  th := b[0].c[t].hp;
  #assert rs_cast(b[..], w, SP_FIREBALL, 3, 14, 3, -1) && b[0].c[w].slots[3] == 1 && b[0].c[t].hp < th;
  // the luck: a total short by 10 or less, never past one roll's reach
  #assert rs_own_luck(b[..], w, 5, 30) == 0 && rs_own_luck(b[..], w, 20, 15) == 0 && b[0].c[w].uses[RS_USE_LUCK] == 4;
  luck := rs_own_luck(b[..], w, 12, 15);
  #assert luck >= 1 && luck <= 10 && b[0].c[w].uses[RS_USE_LUCK] == 3 && rs_saw(b[..], 0, "Own Luck");
}
#test "a level 17 Warlock: four 5th-level Pact slots, a Mystic Arcanum of each level 6 to 9, Charisma 20, four beams" {
  c := rs_warlock("Vesk", 1, 17, SP_ELDRITCH_BLAST);
  #assert c.slots_max[5] == 4 && c.slots_max[3] == 0 && c.slots_max[6] == 1 && c.slots_max[7] == 1 && c.slots_max[9] == 1;
  #assert c.score[RS_CHA] == 20 && rs_spell_dc(c) == 8 + 6 + 5 && rs_cantrip_tier(c.level) == 4;
  #assert rs_warlock("Ilse", 1, 6, SP_ELDRITCH_BLAST).slots_max[3] == 2 && rs_warlock("Ilse", 1, 11, SP_ELDRITCH_BLAST).slots_max[5] == 3;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 9;
  a := rs_add(b[..], c, 1, 3);
  t := rs_add(b[..], rs_skeleton("Skeleton", 2), 9, 3);
  b[0].c[t].hp_max = 500; b[0].c[t].hp = 500;
  rs_start_turn(b[..], a);
  seq := b[0].book[0].seq;
  #assert rs_cast(b[..], a, SP_ELDRITCH_BLAST, 0, 0, 0, t);
  attacks := 0;
  for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); if ev.kind == RS_EV_ATTACK || ev.kind == RS_EV_MISS { attacks += 1; } }
  #assert attacks == 4;
}
#test "Circle of Death: 8d8 Necrotic in a 60-foot Sphere, Con half; 2d8 more a slot level above 6" {
  cd := rs_spell(SP_CIRCLE_OF_DEATH);
  #assert cd.level == 6 && cd.range_ft == 150 && cd.area == RS_A_SPHERE && cd.area_ft == 60 && cd.steps[0].a == RS_CON && cd.steps[1].a == 8 && cd.steps[1].b == 8 && cd.steps[1].c == RS_NECROTIC && cd.steps[1].d == 2;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 60; b[0].h = 30; b[0].dice[0].state = 5;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 17, SP_ELDRITCH_BLAST), 1, 15);
  b[0].c[a].materials[0]=RsMaterialStock.{key=RS_KEY_CIRCLE_OF_DEATH,count=1};
  near := rs_add(b[..], rs_skeleton("A", 2), 20, 15); edge := rs_add(b[..], rs_skeleton("B", 2), 31, 15); out := rs_add(b[..], rs_skeleton("C", 2), 34, 15);
  for q: 0..<3 { b[0].c[q + 1].hp_max = 300; b[0].c[q + 1].hp = 300; }
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_CIRCLE_OF_DEATH, 6, 20, 15, -1);
  #assert b[0].c[near].hp < 300 && b[0].c[edge].hp < 300 && b[0].c[out].hp == 300 && b[0].c[a].slots[6] == 0;
}
#test "Finger of Death: 7d8 + 30 Necrotic, Con half; a Humanoid it kills rises as a Zombie at the start of the caster's next turn" {
  fd := rs_spell(SP_FINGER_OF_DEATH);
  #assert fd.level == 7 && fd.range_ft == 60 && fd.plus == 30 && fd.steps[1].a == 7 && fd.steps[1].b == 8 && fd.steps[2].kind == RS_S_RISE;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 17;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 17, SP_ELDRITCH_BLAST), 1, 3);
  t := rs_add(b[..], rs_druid("Rowan", 0, 3), 6, 3);
  sk := rs_add(b[..], rs_skeleton("Skeleton", 2), 6, 5);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_FINGER_OF_DEATH, 7, 0, 0, t);
  // at least 30 + 7 (or half of it): a level 3 druid's 24 Hit Points are gone, and its Massive Damage kills it
  #assert b[0].c[t].hp == 0 && b[0].c[t].rise_by == a && b[0].c[t].rise_at >= b[0].clock;
  rs_end_turn(b[..], a);
  // not a Humanoid: no Zombie
  b[0].c[a].slots[7] = 1; rs_start_turn(b[..], a);
  b[0].c[sk].hp = 10;
  #assert rs_cast(b[..], a, SP_FINGER_OF_DEATH, 7, 0, 0, sk);
  #assert b[0].c[sk].dead && b[0].c[sk].rise_by < 0;
}
#test "the Zombie: AC 8, 15 Hit Points, Slam +3 for 1d8 + 1; Undead Fortitude keeps it at 1 Hit Point on a save" {
  z := rs_zombie("Zombie", 1);
  #assert z.ac == 8 && z.hp_max == 15 && z.speed == 20 && rs_weapon_attack(z, z.weapon) == 3 && z.undead && rs_has_feature(z, RS_FT_UNDEAD_FORTITUDE) && rs_weapon(W_SLAM).sides == 8;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8; b[0].dice[0].state = 3;
  i := rs_add(b[..], z, 2, 2);
  kept := 0;
  for k: 0..<30 { b[0].c[i].hp = 15; b[0].c[i].dead = false; rs_damage(b[..], -1, i, 15, RS_SLASHING, false, -1); if !b[0].c[i].dead { kept += 1; #assert b[0].c[i].hp == 1; } }
  // DC 20 against Con +3: a 17 or more on the die, about one in five
  #assert kept > 0 && kept < 15;
  b[0].c[i].hp = 15; b[0].c[i].dead = false;
  rs_damage(b[..], -1, i, 15, RS_RADIANT, false, -1);
  #assert b[0].c[i].dead;
}
#test "Blight: 8d8 Necrotic, Con half, 1d8 more a slot level above 4; Dimension Door: to the point, or 4d6 Force where a creature stands" {
  bl := rs_spell(SP_BLIGHT);
  #assert bl.level == 4 && bl.range_ft == 30 && bl.steps[1].a == 8 && bl.steps[1].d == 1 && bl.steps[1].c == RS_NECROTIC;
  dd := rs_spell(SP_DIMENSION_DOOR);
  #assert dd.level == 4 && dd.range_ft == 500 && dd.components == "V" && dd.steps[0].kind == RS_S_TELEPORT;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 120; b[0].h = 20; b[0].dice[0].state = 3;
  a := rs_add(b[..], rs_warlock("Vesk", 1, 17, SP_ELDRITCH_BLAST), 1, 3);
  o := rs_add(b[..], rs_skeleton("Skeleton", 2), 40, 3);
  rs_start_turn(b[..], a);
  #assert rs_cast(b[..], a, SP_DIMENSION_DOOR, 5, 90, 10, a);
  #assert b[0].c[a].x == 90 && b[0].c[a].y == 10;
  rs_end_turn(b[..], a); rs_start_turn(b[..], a);
  hp := b[0].c[a].hp;
  #assert rs_cast(b[..], a, SP_DIMENSION_DOOR, 5, 40, 3, a);
  #assert b[0].c[a].x == 90 && b[0].c[a].hp < hp && b[0].c[a].hp >= hp - 24;
}

#test "a siege's stat blocks fight on the rules: extra damage on a hit, Multiattack, Parry, and Hellish Rebuke" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 8; b[0].dice[0].state = 23;
  kn := rs_add(b[..], rs_knight("Knight 1", 0), 2, 2);
  cu := rs_add(b[..], rs_fanatic("Cultist Fanatic 1", 1), 3, 2);
  // the Knight's Greatsword: two attacks (Multiattack), each hit 2d6 + 3 Slashing then 1d8 Radiant
  radiant := false; parried := false; seq := b[0].book[0].seq;
  for k: 0..<60 {
    b[0].c[cu].hp = b[0].c[cu].hp_max; b[0].c[cu].dead = false; b[0].c[cu].cond = 0;
    b[0].c[kn].hp = b[0].c[kn].hp_max; b[0].c[kn].reacted = false;
    rs_fresh(b[..], kn);
    #assert rs_attack(b[..], kn, cu, false, -1);
    b[0].c[cu].hp = b[0].c[cu].hp_max; b[0].c[cu].dead = false; b[0].c[cu].cond = 0;
    rs_fresh(b[..], cu);
    #assert rs_attack(b[..], cu, kn, false, -1);
  }
  #assert rs_saw(b[..], seq, " Radiant (1d8") || rs_saw(b[..], seq, " Radiant (2d8");
  #assert rs_saw(b[..], seq, " Necrotic (2d6") || rs_saw(b[..], seq, " Necrotic (4d6");
  #assert rs_saw(b[..], seq, "(Parry)");
  // Hellish Rebuke: a Warlock hurt by a creature within 60 feet answers with its Reaction and a slot
  w := rs_add(b[..], rs_siege_attacker(2, 1, SP_ELDRITCH_BLAST), 6, 5);
  g := rs_add(b[..], rs_guard("Guard 1", 0), 7, 5);
  #assert b[0].c[w].klass == RS_WARLOCK && rs_has_feature(b[0].c[w], RS_FT_REBUKE) && b[0].c[w].slots[1] == 1;
  hit := false;
  for k: 0..<40 {
    if hit { break; }
    b[0].c[w].hp = b[0].c[w].hp_max; b[0].c[w].reacted = false; b[0].c[w].slots[1] = 1;
    b[0].c[g].hp = b[0].c[g].hp_max; b[0].c[g].dead = false;
    seq = b[0].book[0].seq;
    rs_fresh(b[..], g);
    #assert rs_attack(b[..], g, w, false, -1);
    if b[0].c[w].hp < b[0].c[w].hp_max {
      hit = true;
      #assert rs_saw(b[..], seq, "casts Hellish Rebuke (1st-level slot) at Guard 1: DEX save") && b[0].c[w].slots[1] == 0 && b[0].c[w].reacted;
      #assert rs_saw(b[..], seq, " Fire (2d10");
    }
  }
  #assert hit;
  // a Mage's Shield is Protective Magic: its 1st-level uses, never a Fireball's slot
  m := rs_add(b[..], rs_mage("Mage 1", 0), 1, 7);
  b[0].c[m].slots[1] = 0;
  #assert !rs_shield(b[..], m) && b[0].c[m].slots[4] == 2;
  b[0].c[m].slots[1] = 3;
  #assert rs_shield(b[..], m) && b[0].c[m].slots[1] == 2;
}

#test "Bless and Bane: three targets each, 1d4 on attack rolls and saves; Shield of Faith +2 AC; False Life by Fiendish Vigor; Command halts (#12771)" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 24; b[0].h = 8; b[0].dice[0].state = 33;
  p := rs_add(b[..], rs_cleric("Cult Priest 1", 1, 3), 2, 3);
  a1 := rs_add(b[..], rs_cultist("Cultist 1", 1), 3, 3); a2 := rs_add(b[..], rs_cultist("Cultist 2", 1), 4, 3);
  a3 := rs_add(b[..], rs_cultist("Cultist 3", 1), 3, 4); far := rs_add(b[..], rs_cultist("Cultist 4", 1), 22, 3);
  g1 := rs_add(b[..], rs_guard("Guard 1", 0), 6, 3); g2 := rs_add(b[..], rs_guard("Guard 2", 0), 7, 3); g3 := rs_add(b[..], rs_guard("Guard 3", 0), 6, 4);
  // Bless: the target and the two nearest of its side within 30 feet (not the one 100 feet off)
  rs_start_turn(b[..], p);
  #assert rs_cast(b[..], p, SP_BLESS, 1, 0, 0, a1);
  rs_end_turn(b[..], p);
  #assert rs_effect(b[0].c[a1], EF_BLESS) && rs_effect(b[0].c[a2], EF_BLESS) && rs_effect(b[0].c[a3], EF_BLESS) && !rs_effect(b[0].c[far], EF_BLESS);
  #assert !rs_effect(b[0].c[p], EF_BLESS) && b[0].c[p].conc == SP_BLESS;
  // its 1d4 is on the attack roll's line
  seq := b[0].book[0].seq;
  rs_start_turn(b[..], a1); s1 := rs_strike(b[..], a1, g1, W_RITUAL_SICKLE, false); rs_end_turn(b[..], a1);
  told := false;
  for e: 0..<(b[0].book[0].seq - seq) { ev := rs_recent(b[0].book[0], e); s := cast(string) ev.text[0..<ev.text_n]; for c: 0..<s.count - 5 { if s[c..<c + 6] == " Bless" { told = true; } } }
  #assert told;
  // Shield of Faith, a Bonus Action: +2 AC; it replaces Bless as the Priest's concentration
  ac := rs_ac(b[..], a2);
  rs_start_turn(b[..], p);
  #assert rs_cast(b[..], p, SP_SHIELD_OF_FAITH, 1, 0, 0, a2);
  rs_end_turn(b[..], p);
  #assert rs_ac(b[..], a2) == ac + 2 && !rs_effect(b[0].c[a1], EF_BLESS);
  // Bane: a Cha save each; on a failure 1d4 off; most of three Guards fail some of twenty tries
  baned := 0;
  for k: 0..<20 {
    for j: [3] int.[g1, g2, g3] { for e: 0..<RS_EFFECTS { b[0].c[j].eff[e].kind = EF_NONE; } }
    b[0].c[p].conc = -1; b[0].c[p].slots[1] = 4;
    rs_start_turn(b[..], p); #assert rs_cast(b[..], p, SP_BANE, 1, 0, 0, g1); rs_end_turn(b[..], p);
    for j: [3] int.[g1, g2, g3] { if rs_effect(b[0].c[j], EF_BANE) { baned += 1; } }
  }
  #assert baned > 10 && baned < 60;
  // False Life through Fiendish Vigor: no slot spent, 2d4 + 4 at its highest (12)
  w := rs_add(b[..], rs_warlock("Warlock 1", 1, 3, SP_ELDRITCH_BLAST), 5, 5);
  b[0].c[w].feats = rs_feature_put(b[0].c[w].feats, RS_FT_FIENDISH_VIGOR, true);
  slots := b[0].c[w].slots[2];
  rs_start_turn(b[..], w); #assert rs_cast(b[..], w, SP_FALSE_LIFE, 0, 0, 0, w); rs_end_turn(b[..], w);
  #assert b[0].c[w].temp == 12 && b[0].c[w].slots[2] == slots;
  b[0].c[w].feats = rs_feature_put(b[0].c[w].feats, RS_FT_FIENDISH_VIGOR, false);
  rs_start_turn(b[..], w); #assert !rs_cast(b[..], w, SP_FALSE_LIFE, 0, 0, 0, w); rs_end_turn(b[..], w);
  // Command (Halt): on a failed Wis save no move, action or Bonus Action until the end of its next turn
  halted := false;
  for k: 0..<20 {
    b[0].c[p].slots[1] = 4;
    rs_start_turn(b[..], p); #assert rs_cast(b[..], p, SP_COMMAND, 1, 0, 0, g2); rs_end_turn(b[..], p);
    if rs_effect(b[0].c[g2], EF_HALT_PENDING) { halted = true; break; }
  }
  #assert halted && rs_can_act(b[0].c[g2]) && rs_can_move(b[0].c[g2]);
  rs_start_turn(b[..], g2); #assert !rs_can_act(b[0].c[g2]) && !rs_can_move(b[0].c[g2]) && !rs_attack(b[..], g2, a2, false, -1); rs_end_turn(b[..], g2);
  rs_tick(b[..], 0.2);
  #assert !rs_effect(b[0].c[g2], EF_HALT) && rs_can_act(b[0].c[g2]);
}
#load "battle-attack-checks.coax" #test;   // battle-attack.coax's own checks (#13287)
#load "battle-features-checks.coax" #test;   // battle-features.coax's own checks (#13285, #13287)

// ---- the feature program (#13285): rs_feature's rows, written out a second time, and rs_feature_use
rs_fs_is :: (f: RsFeature, k: int, kind: int, a: int, b: int, c: int, t: string) -> bool { st := f.st[k]; return k < f.n && st.kind == kind && st.a == a && st.b == b && st.c == c && st.t == t; }
#test "features: every row holds its steps in order, each with its numbers and its line; no other kind has a row" {
  f_rs_ab_rage := rs_feature(RS_AB_RAGE); #assert f_rs_ab_rage.n == 9;
  #assert rs_fs_is(f_rs_ab_rage, 0, RS_FS_N_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_rage, 1, RS_FS_N_USE, RS_USE_RAGE, 0, 0, "") && rs_fs_is(f_rs_ab_rage, 2, RS_FS_N_NO_STATE, EF_RAGE, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_rage, 3, RS_FS_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_rage, 4, RS_FS_SPEND, RS_USE_RAGE, 0, 0, "") && rs_fs_is(f_rs_ab_rage, 5, RS_FS_STATE, EF_RAGE, RS_RAGE_KEPT, 0, "");
  #assert rs_fs_is(f_rs_ab_rage, 6, RS_FS_END_CONC, 0, 0, 0, " (Rage)") && rs_fs_is(f_rs_ab_rage, 7, RS_FS_UNCHARM, RS_FT_MINDLESS_RAGE, 0, 0, "") && rs_fs_is(f_rs_ab_rage, 8, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_NONE, " enters a Rage");
  f_rs_ab_second := rs_feature(RS_AB_SECOND); #assert f_rs_ab_second.n == 8;
  #assert rs_fs_is(f_rs_ab_second, 0, RS_FS_N_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_second, 1, RS_FS_N_USE, RS_USE_WIND, 0, 0, "") && rs_fs_is(f_rs_ab_second, 2, RS_FS_N_HURT, 0, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_second, 3, RS_FS_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_second, 4, RS_FS_SPEND, RS_USE_WIND, 0, 0, "") && rs_fs_is(f_rs_ab_second, 5, RS_FS_SAY, RS_EV_CAST, RS_TO_SELF, RS_FT_SECOND_WIND, " takes a Second Wind");
  #assert rs_fs_is(f_rs_ab_second, 6, RS_FS_HEAL, 1, 10, RS_PLUS_LEVEL, "Second Wind") && rs_fs_is(f_rs_ab_second, 7, RS_FS_SHIFT, RS_FT_TACTICAL_SHIFT, 0, 0, "");
  f_rs_ab_surge := rs_feature(RS_AB_SURGE); #assert f_rs_ab_surge.n == 7;
  #assert rs_fs_is(f_rs_ab_surge, 0, RS_FS_N_TURN, 0, 0, 0, "") && rs_fs_is(f_rs_ab_surge, 1, RS_FS_N_ACTED, 0, 0, 0, "") && rs_fs_is(f_rs_ab_surge, 2, RS_FS_N_ACT, 0, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_surge, 3, RS_FS_N_USE, RS_USE_SURGE, 0, 0, "") && rs_fs_is(f_rs_ab_surge, 4, RS_FS_SURGE, 0, 0, 0, "") && rs_fs_is(f_rs_ab_surge, 5, RS_FS_SPEND, RS_USE_SURGE, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_surge, 6, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_ACTION_SURGE, " uses Action Surge");
  f_rs_ab_whole := rs_feature(RS_AB_WHOLE); #assert f_rs_ab_whole.n == 8;
  #assert rs_fs_is(f_rs_ab_whole, 0, RS_FS_N_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_whole, 1, RS_FS_N_USE, RS_USE_WHOLE, 0, 0, "") && rs_fs_is(f_rs_ab_whole, 2, RS_FS_N_HURT, 0, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_whole, 3, RS_FS_N_HEALS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_whole, 4, RS_FS_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_whole, 5, RS_FS_SPEND, RS_USE_WHOLE, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_whole, 6, RS_FS_SAY, RS_EV_CAST, RS_TO_SELF, RS_FT_WHOLENESS, " draws on Wholeness of Body") && rs_fs_is(f_rs_ab_whole, 7, RS_FS_HEAL, 1, 0, RS_PLUS_WIS, "Wholeness of Body");
  f_rs_ab_lay := rs_feature(RS_AB_LAY); #assert f_rs_ab_lay.n == 7;
  #assert rs_fs_is(f_rs_ab_lay, 0, RS_FS_N_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_lay, 1, RS_FS_N_USE, RS_USE_LAY, 0, 0, "") && rs_fs_is(f_rs_ab_lay, 2, RS_FS_N_GIVE, RS_USE_LAY, 5, 0, "");
  #assert rs_fs_is(f_rs_ab_lay, 3, RS_FS_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_lay, 4, RS_FS_SPEND_GIVE, RS_USE_LAY, 0, 0, "") && rs_fs_is(f_rs_ab_lay, 5, RS_FS_SAY, RS_EV_CAST, RS_TO_TARGET, RS_FT_LAY_ON_HANDS, " lays on hands");
  #assert rs_fs_is(f_rs_ab_lay, 6, RS_FS_HEAL_GIVE, 0, 0, 0, "Lay On Hands");
  f_rs_ab_sacred := rs_feature(RS_AB_SACRED); #assert f_rs_ab_sacred.n == 7;
  #assert rs_fs_is(f_rs_ab_sacred, 0, RS_FS_N_ACTION, 0, 0, 0, "") && rs_fs_is(f_rs_ab_sacred, 1, RS_FS_N_CLASS, RS_PALADIN, 3, 0, "") && rs_fs_is(f_rs_ab_sacred, 2, RS_FS_N_USE, RS_USE_CHANNEL, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_sacred, 3, RS_FS_N_NO_AURA, EF_SACRED, 0, 0, "") && rs_fs_is(f_rs_ab_sacred, 4, RS_FS_AURA, EF_SACRED, 0, 0, "") && rs_fs_is(f_rs_ab_sacred, 5, RS_FS_SPEND, RS_USE_CHANNEL, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_sacred, 6, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_SACRED_WEAPON, " raises a Sacred Weapon: +Cha to hit, Radiant on a hit");
  f_rs_ab_aim := rs_feature(RS_AB_AIM); #assert f_rs_ab_aim.n == 6;
  #assert rs_fs_is(f_rs_ab_aim, 0, RS_FS_N_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_aim, 1, RS_FS_N_FEAT, RS_FT_STEADY_AIM, 0, 0, "") && rs_fs_is(f_rs_ab_aim, 2, RS_FS_N_STILL, 0, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_aim, 3, RS_FS_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_aim, 4, RS_FS_AIM, 0, 0, 0, "") && rs_fs_is(f_rs_ab_aim, 5, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_STEADY_AIM, " takes Steady Aim");
  f_rs_ab_innate := rs_feature(RS_AB_INNATE); #assert f_rs_ab_innate.n == 7;
  #assert rs_fs_is(f_rs_ab_innate, 0, RS_FS_N_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_innate, 1, RS_FS_N_USE, RS_USE_INNATE, 0, 0, "") && rs_fs_is(f_rs_ab_innate, 2, RS_FS_N_NO_AURA, EF_INNATE, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_innate, 3, RS_FS_AURA, EF_INNATE, 0, 0, "") && rs_fs_is(f_rs_ab_innate, 4, RS_FS_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_innate, 5, RS_FS_SPEND, RS_USE_INNATE, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_innate, 6, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_INNATE_SORCERY, " unleashes Innate Sorcery");
  f_rs_ab_inspire := rs_feature(RS_AB_INSPIRE); #assert f_rs_ab_inspire.n == 7;
  #assert rs_fs_is(f_rs_ab_inspire, 0, RS_FS_N_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_inspire, 1, RS_FS_N_RANK, RS_RK_INSPIRATION_DIE, 0, 0, "") && rs_fs_is(f_rs_ab_inspire, 2, RS_FS_N_USE, RS_USE_INSPIRE, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_inspire, 3, RS_FS_N_OTHER, 60, EF_INSPIRED, 0, "") && rs_fs_is(f_rs_ab_inspire, 4, RS_FS_BONUS, 0, 0, 0, "") && rs_fs_is(f_rs_ab_inspire, 5, RS_FS_SPEND, RS_USE_INSPIRE, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_inspire, 6, RS_FS_INSPIRE, EF_INSPIRED, RS_RK_INSPIRATION_DIE, RS_FT_INSPIRATION, "");
  f_rs_fp_font := rs_feature(RS_FP_FONT); #assert f_rs_fp_font.n == 7;
  #assert rs_fs_is(f_rs_fp_font, 0, RS_FS_N_TURN, 0, 0, 0, "") && rs_fs_is(f_rs_fp_font, 1, RS_FS_N_FEAT, RS_FT_FONT, 0, 0, "") && rs_fs_is(f_rs_fp_font, 2, RS_FS_N_POOL_ROOM, RS_USE_INSPIRE, 0, 0, "");
  #assert rs_fs_is(f_rs_fp_font, 3, RS_FS_N_SLOT, 0, 0, 0, "") && rs_fs_is(f_rs_fp_font, 4, RS_FS_SLOT_SPEND, 0, 0, 0, "") && rs_fs_is(f_rs_fp_font, 5, RS_FS_POOL_ADD, RS_USE_INSPIRE, 0, 0, "");
  #assert rs_fs_is(f_rs_fp_font, 6, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_FONT, ": Font of Inspiration, a spell slot for Bardic Inspiration");
  f_rs_ab_resurge := rs_feature(RS_AB_RESURGE); #assert f_rs_ab_resurge.n == 9;
  #assert rs_fs_is(f_rs_ab_resurge, 0, RS_FS_N_TURN, 0, 0, 0, "") && rs_fs_is(f_rs_ab_resurge, 1, RS_FS_N_FEAT, RS_FT_WILD_RESURGENCE, 0, 0, "") && rs_fs_is(f_rs_ab_resurge, 2, RS_FS_N_ONCE, 0, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_resurge, 3, RS_FS_N_POOL_NONE, RS_USE_WILD, 0, 0, "") && rs_fs_is(f_rs_ab_resurge, 4, RS_FS_N_SLOT, 0, 0, 0, "") && rs_fs_is(f_rs_ab_resurge, 5, RS_FS_SLOT_SPEND, 0, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_resurge, 6, RS_FS_POOL_ONE, RS_USE_WILD, 0, 0, "") && rs_fs_is(f_rs_ab_resurge, 7, RS_FS_ONCE, 0, 0, 0, "") && rs_fs_is(f_rs_ab_resurge, 8, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_WILD_RESURGENCE, ": Wild Resurgence, a spell slot for a Wild Shape use");
  f_rs_fp_resurge_slot := rs_feature(RS_FP_RESURGE_SLOT); #assert f_rs_fp_resurge_slot.n == 8;
  #assert rs_fs_is(f_rs_fp_resurge_slot, 0, RS_FS_N_TURN, 0, 0, 0, "") && rs_fs_is(f_rs_fp_resurge_slot, 1, RS_FS_N_FEAT, RS_FT_WILD_RESURGENCE, 0, 0, "") && rs_fs_is(f_rs_fp_resurge_slot, 2, RS_FS_N_FRESH, RS_NT_RESURGED, 0, 0, "");
  #assert rs_fs_is(f_rs_fp_resurge_slot, 3, RS_FS_N_USE, RS_USE_WILD, 0, 0, "") && rs_fs_is(f_rs_fp_resurge_slot, 4, RS_FS_SPEND, RS_USE_WILD, 0, 0, "") && rs_fs_is(f_rs_fp_resurge_slot, 5, RS_FS_SLOT_ADD, 1, 0, 0, "");
  #assert rs_fs_is(f_rs_fp_resurge_slot, 6, RS_FS_NOTE, RS_NT_RESURGED, 0, 0, "") && rs_fs_is(f_rs_fp_resurge_slot, 7, RS_FS_SAY, RS_EV_CONDITION, RS_TO_SELF, RS_FT_NONE, ": Wild Resurgence, a Wild Shape use for a 1st-level slot");
  f_rs_ab_turn := rs_feature(RS_AB_TURN); #assert f_rs_ab_turn.n == 8;
  #assert rs_fs_is(f_rs_ab_turn, 0, RS_FS_N_ACTION, 0, 0, 0, "") && rs_fs_is(f_rs_ab_turn, 1, RS_FS_N_FEAT, RS_FT_TURN_UNDEAD, 0, 0, "") && rs_fs_is(f_rs_ab_turn, 2, RS_FS_N_USE, RS_USE_CHANNEL, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_turn, 3, RS_FS_N_TURNABLE, 30, 0, 0, "") && rs_fs_is(f_rs_ab_turn, 4, RS_FS_ACTION, 0, 0, 0, "") && rs_fs_is(f_rs_ab_turn, 5, RS_FS_SPEND, RS_USE_CHANNEL, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_turn, 6, RS_FS_SAY, RS_EV_CAST, RS_TO_NONE, RS_FT_TURN_UNDEAD, " presents a holy symbol: Turn Undead") && rs_fs_is(f_rs_ab_turn, 7, RS_FS_TURN_UNDEAD, 30, 0, 0, "");
  f_rs_ab_preserve := rs_feature(RS_AB_PRESERVE); #assert f_rs_ab_preserve.n == 8;
  #assert rs_fs_is(f_rs_ab_preserve, 0, RS_FS_N_ACTION, 0, 0, 0, "") && rs_fs_is(f_rs_ab_preserve, 1, RS_FS_N_FEAT, RS_FT_PRESERVE_LIFE, 0, 0, "") && rs_fs_is(f_rs_ab_preserve, 2, RS_FS_N_USE, RS_USE_CHANNEL, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_preserve, 3, RS_FS_N_BLOODIED, 30, 0, 0, "") && rs_fs_is(f_rs_ab_preserve, 4, RS_FS_ACTION, 0, 0, 0, "") && rs_fs_is(f_rs_ab_preserve, 5, RS_FS_SPEND, RS_USE_CHANNEL, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_preserve, 6, RS_FS_SAY, RS_EV_CAST, RS_TO_NONE, RS_FT_PRESERVE_LIFE, " channels divinity: Preserve Life") && rs_fs_is(f_rs_ab_preserve, 7, RS_FS_PRESERVE, 30, 0, 0, "");
  f_rs_ab_lands := rs_feature(RS_AB_LANDS); #assert f_rs_ab_lands.n == 8;
  #assert rs_fs_is(f_rs_ab_lands, 0, RS_FS_N_ACTION, 0, 0, 0, "") && rs_fs_is(f_rs_ab_lands, 1, RS_FS_N_FEAT, RS_FT_LANDS_AID, 0, 0, "") && rs_fs_is(f_rs_ab_lands, 2, RS_FS_N_USE, RS_USE_WILD, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_lands, 3, RS_FS_N_POINT, 60, 0, 0, "") && rs_fs_is(f_rs_ab_lands, 4, RS_FS_ACTION, 0, 0, 0, "") && rs_fs_is(f_rs_ab_lands, 5, RS_FS_SPEND, RS_USE_WILD, 0, 0, "");
  #assert rs_fs_is(f_rs_ab_lands, 6, RS_FS_SAY, RS_EV_CAST, RS_TO_NONE, RS_FT_LANDS_AID, " calls on Land's Aid: flowers and thorns") && rs_fs_is(f_rs_ab_lands, 7, RS_FS_LANDS, 0, 0, 0, "");
  for kind: -1..<110 {
    has := kind == RS_AB_RAGE || kind == RS_AB_SECOND || kind == RS_AB_SURGE || kind == RS_AB_WHOLE || kind == RS_AB_LAY || kind == RS_AB_SACRED || kind == RS_AB_AIM || kind == RS_AB_INNATE || kind == RS_AB_INSPIRE || kind == RS_FP_FONT || kind == RS_AB_RESURGE || kind == RS_FP_RESURGE_SLOT || kind == RS_AB_TURN || kind == RS_AB_PRESERVE || kind == RS_AB_LANDS;
    #assert (rs_feature(kind).n > 0) == has;
  }
  #assert RS_FS_DO == 40 && RS_FS_N_BLOODIED < RS_FS_DO && RS_FS_BONUS == RS_FS_DO && RS_FEAT_STEPS == 10 && RS_FP_FONT == 100 && RS_FP_RESURGE_SLOT == 101;
}
