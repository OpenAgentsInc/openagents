// Creatures a battle holds of its own. A world that fields more gives the
// battle room of its own with rs_use (5E Lab's armies: 1024 heroes and 16384 of the dead), so the
// other worlds' state stays small. Worlds keep their RsBattle in their state, never on the stack
// (rs_reset clears one in place).
RS_MAX :: 216;
// Squares a battle indexes of its own (rs_at's occupancy, 128 by 64); rs_use gives more, and a
// grid larger than the room scans its creatures.
RS_SQUARES :: 8192;
RS_ZONES :: 8;
RsZone :: struct { on: bool; spell: int; by: int; x0: int; y0: int; x1: int; y1: int; until: int; difficult: bool; round: bool; cx: int; cy: int; r_ft: int; truth_dc: int;
                  measure: int;   // how its radius and length are measured (measure.coax): the battle's, from rs_area
                  line: bool; dx: f32; dy: f32; half: f32; }   // a Line: from (cx, cy) along (dx, dy), a unit, r_ft long, half (squares) each side
// A turn's economy and what has happened in it: moved (Steady Aim needs none), aimed (Steady Aim's
// Advantage waiting) and anchored (its Speed 0 after), last_hit (1 + whom its last melee weapon
// attack hit, 0 none: Divine Smite follows it) and last_crit, the once-a-turn Sneak Attack and
// Colossus Slayer, leveled (a level 1+ spell cast) and quickened (Quickened Spell used).
RsTurn :: struct { disengaged: bool; action: bool; bonus: bool; slot_spent: bool; move_left: int; move_feet: int; move_basis: int; move_debt: int; move_tracked: bool; dash_n: int; cleaved: bool; frenzied: bool; struck: bool; new_round: bool;
                   moved: bool; aimed: bool; anchored: bool; last_hit: int; last_crit: bool; sneaked: bool; colossus: bool;
                   leveled: bool; quickened: bool; stunned: bool; resurged: bool; walk_ft: f32;
                   run_ft: int; jumps_doubled: bool; }   // feet walked on foot just before a jump; Step of the Wind's doubled jumps
RsReactionFrame :: struct { on:bool; who:int = -1; turn:RsTurn; }
RsBattle :: struct {
  c: [] RsCreature; n: int;   // the creatures: own's room (rs_room), or a world's (rs_use)
  zone: [RS_ZONES] RsZone;
  truth_zones:int;
  dice: [1] RsDice;
  book: [1] RsLog;
  clock: int;   // whole ticks (RS_TICKS a second, engine.coax)
  rest_clock:RsRestClock; rest_auto:bool;
  w: int; h: int;             // the grid, squares
  turn_no: int;               // turns begun, for what happens once a turn
  guards: int;                // Spirit Guardians cast and not yet ended
  aff_used: bool;             // Elemental Affinity's one roll spent in this casting
  who: int;                   // whose turn is running (-1 none)
  turn: RsTurn;
  ko_by: int;                 // 1 + the attacker whose melee attack may knock out (knockout.coax), 0 none
  reaction_frame: RsReactionFrame; // true turn while a Reaction strike borrows acting state
  shape_keeps: [RS_SHAPE_KEEPS] RsShapeKeep; // Shapechange: each changed creature's own numbers, shapechange.coax
  // Strict timing is the default: six-second turns and no automatic recovery.
  // The declared action profile gives 1.5-second turns, proportional rounded
  // movement, slot/Rage/ordinary-use recharge at 9 seconds, Focus and the
  // existing point/pool exceptions at 4.5 seconds.
  // Repeat saves, death saves and Rage upkeep stay on six-second rounds.
  timing: RsTimingProfile;
  areas: RsAreaProfile;      // strict, or a declared house rule sparing the caster or its team (area-origin.coax)
  measure: int;              // RS_MEASURE_GRID, or a declared straight-line measure of ranges and areas (measure.coax)
  walk: int;                 // RS_WALK_PAID or the declared unpaid RS_WALK_RATE (world-profile.coax)
  // A world selects all four together with rs_set_world (world-profile.coax). Every press is paid:
  // no profile refills what a creature spends (#13284).
  timing_sealed: bool;       // configured before begin/turn/tick; reset opens it
  // Who stands on each square (1 + the creature, 0 none), so rs_at is one look rather than a scan
  // of every creature: kept by rs_add, rs_place, rs_step_to and the pushes, and rebuilt at each
  // turn's start (rs_index) for whatever a world moved by hand.
  occ: [] int;
  terrain: [RS_TERRAINS] RsTerrain; covers: [RS_COVERS] RsCover;   // the world's admitted geometry (cover.coax)
  // The world moves creatures only through rs_add, rs_place and the engine's own steps and pushes, so
  // the index stays right and a turn's start needn't rebuild it (5E Lab's crowds: 70,000 squares).
  kept: bool;
  own: [RS_MAX] RsCreature; own_occ: [RS_SQUARES] int;   // the room a battle has of its own
}
#load "battle-grid.coax";   // the grid: room, distance, squares, zones and areas (#13287)

