// SRD 5.2.1 pp.113 and 140: per-recipient condition/ability choices. These
// modify a request-local program, never a global spell record or stable ID.
#authority;
RsCastOptions :: struct {
  blindness: int = RS_BLINDED; hex_ability: int = RS_STR; restoration: int;
  guidance: int = SK_PERCEPTION; willing: bool;
}

#test "option capacity aggregates repeated assignments without borrowing an existing zone lease" {
  b: [1] RsBattle;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Repeated",1),2,1);
  u := rs_add(b[..],rs_skeleton("Other",1),3,1);
  picks := [3] int.[t,u,t]; options := [3] RsCastOptions.[RsCastOptions.{},RsCastOptions.{},RsCastOptions.{}];
  s := rs_spell(SP_BLESS); s.concentration = false; s.step_n = 2; s.steps[1] = RsStep.{kind=RS_S_BOON,a=EF_FAITH};
  for free: 0..<7 {
    for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=ifx k < RS_EFFECTS-free then EF_HEX else EF_NONE}; }
    #assert rs_options_effect_room(b[..],a,s,SP_BLESS,1,picks[..],options[..]) == (free >= 4);
  }
  for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX}; }
  s.step_n = 1; s.steps[0] = RsStep.{kind=RS_S_CONDITION,a=RS_RESTRAINED};
  b[0].c[t].eff[0] = RsEffect.{kind=EF_ZONE_RESTRAIN,cond=0,by=a,spell=SP_BLESS};
  #assert !rs_options_effect_room(b[..],a,s,SP_BLESS,1,picks[0..<1],options[0..<1]);
  s.humanoid_only=true;
  #assert rs_options_effect_room(b[..],a,s,SP_BLESS,1,picks[0..<1],options[0..<1]);
  b[0].c[t].humanoid=true;
  #assert !rs_options_effect_room(b[..],a,s,SP_BLESS,1,picks[0..<1],options[0..<1]);
}

#test "spell options accept only the named condition or ability on its own spell" {
  for sp: [4] int.[SP_BLINDNESS,SP_HEX,SP_BLESS,-1] {
    for condition: -1..<7 { for ability: -1..<7 {
      expected := (ifx sp == SP_BLINDNESS then condition == 1 || condition == 4 else condition == 1) && (ifx sp == SP_HEX then ability >= 0 && ability <= 5 else ability == 0);
      #assert rs_option_valid(sp,RsCastOptions.{blindness=condition,hex_ability=ability}) == expected;
    } }
  }
  options := [2] RsCastOptions.[RsCastOptions.{},RsCastOptions.{blindness=RS_DEAFENED}];
  #assert rs_options_valid(SP_BLINDNESS,2,options[..]) && !rs_options_valid(SP_BLINDNESS,1,options[..]);
  #assert !rs_options_valid(SP_BLESS,2,options[..]);
  #assert rs_options_valid(SP_BLESS,2,options[0..<0]) && rs_options_valid(SP_BLESS,1,options[0..<1]);
  #assert rs_option_at(options[0..<0],99).blindness == RS_BLINDED && rs_option_at(options[..],1).blindness == RS_DEAFENED;
  restore:=RsCastOptions.{restoration=RS_POISONED};
  #assert rs_option_valid(SP_LESSER_RESTORATION,restore) && !rs_option_valid(SP_BLESS,restore);
  for skill:-1..<RS_SKILLS+1 {
    #assert rs_option_valid(SP_GUIDANCE,RsCastOptions.{guidance=skill})==(skill>=0 && skill<RS_SKILLS);
    #assert rs_option_valid(SP_BLESS,RsCastOptions.{guidance=skill})==(skill==SK_PERCEPTION);
  }
  #assert rs_option_valid(SP_GUIDANCE,RsCastOptions.{willing=true}) && !rs_option_valid(SP_BLESS,RsCastOptions.{willing=true});
}
#test "request-local program choices retain unrelated instructions and source identity" {
  s := rs_spell(SP_BLINDNESS);
  deaf := rs_spell_variant(s,SP_BLINDNESS,2,RsCastOptions.{blindness=RS_DEAFENED});
  #assert s.steps[1].a == RS_BLINDED && deaf.steps[1].a == RS_DEAFENED;
  #assert deaf.steps[0].kind == RS_S_SAVE && deaf.steps[0].a == RS_CON && deaf.steps[1].c == RS_CON && deaf.duration_s == 60 && deaf.id == s.id;
  h := rs_spell_variant(rs_spell(SP_HEX),SP_HEX,1,RsCastOptions.{hex_ability=RS_CHA});
  #assert h.steps[0].a == RS_CHA && h.steps[0].kind == RS_S_HEX;
  synthetic := s; synthetic.step_n = 1; synthetic.steps[0] = RsStep.{kind=RS_S_DAMAGE,a=3};
  unchanged := rs_spell_variant(synthetic,SP_BLINDNESS,3,RsCastOptions.{blindness=RS_DEAFENED});
  #assert unchanged.steps[0].a == 3 && unchanged.duration_s == 60;
  synthetic = h; synthetic.steps[0] = RsStep.{kind=RS_S_DAMAGE,a=2};
  unchanged = rs_spell_variant(synthetic,SP_HEX,1,RsCastOptions.{hex_ability=RS_WIS});
  #assert unchanged.steps[0].a == 2;
  other := rs_spell_variant(s,SP_BLESS,3,RsCastOptions.{});
  #assert other.steps[1].a == RS_BLINDED && other.duration_s == 60;
  restored:=rs_spell(SP_LESSER_RESTORATION);
  restored.steps[1]=rs_step(RS_S_DAMAGE,2,4,RS_FIRE,0); restored.step_n=2;
  restored=rs_spell_variant(restored,SP_LESSER_RESTORATION,2,RsCastOptions.{restoration=RS_POISONED});
  #assert restored.steps[0].a==RS_POISONED && restored.steps[1].a==2;
  guidance:=rs_spell(SP_GUIDANCE);
  guidance.steps[1]=rs_step(RS_S_DAMAGE,2,4,RS_FIRE,0); guidance.step_n=2;
  selected:=rs_spell_variant(guidance,SP_GUIDANCE,0,RsCastOptions.{guidance=SK_ACROBATICS});
  #assert selected.steps[0].b==SK_ACROBATICS && selected.steps[1].b==4;
  unrelated:=rs_spell_variant(rs_spell(SP_BLESS),SP_BLESS,1,RsCastOptions.{guidance=SK_ATHLETICS});
  #assert unrelated.steps[0].b==0;
}
#test "Hex source duration follows every slot band including a base free cast" {
  for slot: 0..<10 {
    seconds := [10] f32.[3600,3600,14400,28800,28800,86400,86400,86400,86400,86400];
    h := rs_spell_variant(rs_spell(SP_HEX),SP_HEX,slot,RsCastOptions.{});
    #assert h.duration_s == seconds[slot];
  }
}
rs_option_valid :: (sp: int, option: RsCastOptions) -> bool #effects(all) {
  if sp == SP_BLINDNESS {
    if option.blindness != RS_BLINDED && option.blindness != RS_DEAFENED { return false; }
  } else if option.blindness != RS_BLINDED { return false; }
  if sp == SP_HEX {
    if option.hex_ability < RS_STR || option.hex_ability > RS_CHA { return false; }
  } else if option.hex_ability != RS_STR { return false; }
  if sp==SP_GUIDANCE {
    if option.guidance<0 || option.guidance>=RS_SKILLS { return false; }
  } else if option.guidance!=SK_PERCEPTION || (option.willing && sp!=SP_PROTECTION_GOOD_EVIL) { return false; }
  if option.restoration!=0 {
    if sp!=SP_LESSER_RESTORATION { return false; }
    for condition:RS_RESTORABLE { if option.restoration==condition { return true; } }
    return false;
  }
  return true;
}
rs_options_valid :: (sp: int, count: int, options: [] const RsCastOptions) -> bool #effects(all) {
  if options.count != 0 && options.count != count { return false; }
  for option: options { if !rs_option_valid(sp,option) { return false; } }
  return true;
}
rs_option_at :: (options: [] const RsCastOptions, k: int) -> RsCastOptions #effects(all) {
  if options.count == 0 { return RsCastOptions.{}; }
  return options[k];
}
rs_spell_variant :: (base: RsSpell, sp: int, slot: int, option: RsCastOptions) -> RsSpell #effects(all) {
  s := base;
  for k: 0..<s.step_n {
    if sp == SP_BLINDNESS && s.steps[k].kind == RS_S_TIMED { s.steps[k].a = option.blindness; }
    if sp == SP_HEX && s.steps[k].kind == RS_S_HEX { s.steps[k].a = option.hex_ability; }
    if sp == SP_LESSER_RESTORATION && s.steps[k].kind == RS_S_RESTORE { s.steps[k].a = option.restoration; }
    if s.steps[k].kind==RS_S_AID { s.steps[k].b=s.steps[k].a*(slot-1); }
    if sp==SP_GUIDANCE && s.steps[k].kind==RS_S_BOON { s.steps[k].b=option.guidance; }
  }
  if sp == SP_HEX {
    s.duration_s = ifx slot >= 5 then 86400 else ifx slot >= 3 then 28800 else ifx slot >= 2 then 14400 else 3600;
  }
  return s;
}
// Caller has validated list shape and actor/target identities. Repeated picks
// prepay every occurrence, including their individually chosen variants.
rs_options_effect_room :: (b: [] RsBattle, i: int, s: RsSpell, sp: int, slot: int, picks: [] const int, options: [] const RsCastOptions) -> bool #effects(all) {
  for target: picks {
    if s.humanoid_only && !b[0].c[target].humanoid { continue; }
    need := 0;
    for k: 0..<picks.count {
      if picks[k] != target { continue; }
      variant := rs_spell_variant(s,sp,slot,rs_option_at(options,k));
      need += rs_effect_demand(b[0].c[target],variant,-1,i,sp);
    }
    if rs_effect_room(b[0].c[target],s.concentration,i,b[0].c[i].conc) < need { return false; }
  }
  return true;
}
