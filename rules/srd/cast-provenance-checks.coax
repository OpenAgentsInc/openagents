// Where a preset caster's always-prepared spells and material components come from (#13038).
// Every class-spell grant a level 1-6 preset holds is named by an SRD 5.2.1 feature at that
// level (table below, reviewed against the pinned PDF), and every listed grant arrives at its
// level. Every spell a preset can cast has its components: Verbal and Somatic from a free voice
// and hand, ordinary materials from its class's own spellcasting focus, and priced or consumed
// materials only from an exact receipt it holds.
//   coax/bin/coax test rules/srd/cast-provenance-checks.coax --library
#load "battle.coax";

RsGrantSource :: struct { klass: int; from: int; sp: int; page: int; }
// Druidic p.42, Circle of the Land (Polar) p.46, Fiend Spells p.76, Fiendish Vigor p.73 (this preset's level 5
// invocation; Level 2+ Warlock), Magical Discoveries p.35 (this preset's two
// choices), Blessed Warrior and Paladin's Smite p.54, Oath of Devotion Spells p.56, Draconic Spells
// p.70, Life Domain Spells p.40, Favored Enemy p.58. Source spells without engine records
// (Suggestion, Alter Self and others) grant no ID.
RS_GRANT_SOURCES :: [27] RsGrantSource.[
  RsGrantSource.{klass = RS_DRUID, from = 1, sp = SP_SPEAK_WITH_ANIMALS, page = 42},
  RsGrantSource.{klass = RS_DRUID, from = 3, sp = SP_FOG_CLOUD, page = 46}, RsGrantSource.{klass = RS_DRUID, from = 3, sp = SP_HOLD_PERSON, page = 46},
  RsGrantSource.{klass = RS_DRUID, from = 3, sp = SP_RAY_OF_FROST, page = 46}, RsGrantSource.{klass = RS_DRUID, from = 5, sp = SP_SLEET_STORM, page = 46},
  RsGrantSource.{klass = RS_WARLOCK, from = 3, sp = SP_BURNING_HANDS, page = 76}, RsGrantSource.{klass = RS_WARLOCK, from = 3, sp = SP_COMMAND, page = 76},
  RsGrantSource.{klass = RS_WARLOCK, from = 3, sp = SP_SCORCHING_RAY, page = 76}, RsGrantSource.{klass = RS_WARLOCK, from = 5, sp = SP_FIREBALL, page = 76},
  RsGrantSource.{klass = RS_WARLOCK, from = 5, sp = SP_FALSE_LIFE, page = 73},
  RsGrantSource.{klass = RS_BARD, from = 6, sp = SP_FIREBALL, page = 35}, RsGrantSource.{klass = RS_BARD, from = 6, sp = SP_SPIRIT_GUARDIANS, page = 35},
  RsGrantSource.{klass = RS_PALADIN, from = 2, sp = SP_SACRED_FLAME, page = 54}, RsGrantSource.{klass = RS_PALADIN, from = 2, sp = SP_DIVINE_SMITE, page = 54},
  RsGrantSource.{klass = RS_PALADIN, from = 2, sp = SP_GUIDANCE, page = 54},
  RsGrantSource.{klass = RS_PALADIN, from = 3, sp = SP_SHIELD_OF_FAITH, page = 56}, RsGrantSource.{klass = RS_PALADIN, from = 3, sp = SP_PROTECTION_GOOD_EVIL, page = 56},
  RsGrantSource.{klass = RS_PALADIN, from = 5, sp = SP_AID, page = 56}, RsGrantSource.{klass = RS_PALADIN, from = 5, sp = SP_ZONE_OF_TRUTH, page = 56},
  RsGrantSource.{klass = RS_SORCERER, from = 3, sp = SP_COMMAND, page = 70},
  RsGrantSource.{klass = RS_CLERIC, from = 3, sp = SP_BLESS, page = 40}, RsGrantSource.{klass = RS_CLERIC, from = 3, sp = SP_CURE_WOUNDS, page = 40},
  RsGrantSource.{klass = RS_CLERIC, from = 3, sp = SP_LESSER_RESTORATION, page = 40}, RsGrantSource.{klass = RS_CLERIC, from = 3, sp = SP_AID, page = 40},
  RsGrantSource.{klass = RS_CLERIC, from = 5, sp = SP_REVIVIFY, page = 40},
  RsGrantSource.{klass = RS_CLERIC, from = 5, sp = SP_MASS_HEALING_WORD, page = 40},
  RsGrantSource.{klass = RS_RANGER, from = 1, sp = SP_HUNTERS_MARK, page = 58}];
// Consumed materials a world supplies one a visit (everglade/shared/fivebar.coax's
// per-visit presets), so a spent one stays spent across preset changes: the Life Cleric's
// 300 GP diamond for Revivify (p.159) and the Devotion Paladin's holy water for Protection
// from Evil and Good (p.157).
RS_WORLD_SUPPLIES :: [2] RsGrantSource.[RsGrantSource.{klass = RS_CLERIC, from = 5, sp = SP_REVIVIFY, page = 159},
  RsGrantSource.{klass = RS_PALADIN, from = 3, sp = SP_PROTECTION_GOOD_EVIL, page = 157}];
pv_supplied :: (klass: int, sp: int) -> bool {
  for g: RS_WORLD_SUPPLIES { if g.klass == klass && g.sp == sp { return true; } }
  return false;
}
RS_PROVENANCE_CLASSES :: [12] int.[RS_BARBARIAN, RS_BARD, RS_CLERIC, RS_DRUID, RS_FIGHTER, RS_MONK, RS_PALADIN, RS_RANGER, RS_ROGUE, RS_SORCERER, RS_WARLOCK, RS_WIZARD];

pv_preset :: (klass: int, level: int) -> RsCreature {
  if klass == RS_BARBARIAN { return rs_barbarian("P", 0, level); }
  if klass == RS_BARD { return rs_bard("P", 0, level); }
  if klass == RS_CLERIC { return rs_cleric("P", 0, level); }
  if klass == RS_DRUID { return rs_druid("P", 0, level); }
  if klass == RS_FIGHTER { return rs_fighter("P", 0, level); }
  if klass == RS_MONK { return rs_monk("P", 0, level); }
  if klass == RS_PALADIN { return rs_paladin("P", 0, level); }
  if klass == RS_RANGER { return rs_ranger("P", 0, level); }
  if klass == RS_ROGUE { return rs_rogue("P", 0, level); }
  if klass == RS_SORCERER { return rs_sorcerer("P", 0, level); }
  if klass == RS_WARLOCK { return rs_warlock("P", 0, level, SP_ELDRITCH_BLAST); }
  return rs_wizard("P", 0, level);
}
pv_listed :: (klass: int, level: int, sp: int) -> bool {
  for g: RS_GRANT_SOURCES { if g.klass == klass && g.sp == sp && level >= g.from { return true; } }
  return false;
}

#test "every level 1-6 preset's always-prepared spell is a listed SRD feature grant, and each listed grant arrives at its level" #steps 400000000 {
  for klass: RS_PROVENANCE_CLASSES { for level: 1..<7 {
    c := pv_preset(klass, level);
    for sp: 0..<RS_MORE_END {
      if rs_spell(sp).part_of >= 0 { continue; }   // a helper reads its parent's grant
      #assert rs_class_spell_granted(c, sp) == pv_listed(klass, level, sp);
    }
  } }
}
#test "the listed grants follow their features' rules" {
  for g: RS_GRANT_SOURCES {
    s := rs_spell(g.sp);
    #assert rs_executable_spell(g.sp) && g.from >= 1 && g.from <= 6 && g.page >= 35 && g.page <= 76;
    // Magical Discoveries: a Cleric, Druid or Wizard spell, a cantrip or of a level the Bard has slots for
    if g.klass == RS_BARD {
      bard := rs_bard("P", 0, g.from);
      #assert rs_has_class(s.classes, "Cleric") || rs_has_class(s.classes, "Druid") || rs_has_class(s.classes, "Wizard");
      #assert s.level == 0 || bard.slots_max[s.level] > 0;
    }
    // Fiendish Vigor's prerequisite: a level 2+ Warlock
    if g.sp == SP_FALSE_LIFE { #assert g.klass == RS_WARLOCK && g.from >= 2 && rs_warlock("P", 0, g.from, SP_ELDRITCH_BLAST).vigor; }
    // Blessed Warrior: Cleric cantrips
    if g.klass == RS_PALADIN && (g.sp == SP_SACRED_FLAME || g.sp == SP_GUIDANCE) { #assert s.level == 0 && rs_has_class(s.classes, "Cleric"); }
  }
}
#test "every spell a level 1-6 preset can cast has its components from its own focus, voice, hand or receipt" #steps 400000000 {
  for klass: RS_PROVENANCE_CLASSES { for level: 1..<7 {
    c := pv_preset(klass, level);
    if rs_source_class(klass) >= 0 { #assert c.focus_held && c.focus_class == klass; }
    else { #assert !c.focus_held && c.focus_class == -1; }
    for sp: 0..<RS_MORE_END {
      if !rs_spell_ready(c, sp) { continue; }
      // a world's one-a-visit material: the fresh preset holds none, the world's visit stocks one
      w := c;
      if pv_supplied(klass, sp) {
        #assert rs_material_slot(c, rs_component_key(sp)) < 0 && !rs_cast_components_ready(c, sp);
        w.materials[1] = RsMaterialStock.{key = rs_component_key(sp), count = 1};
      }
      #assert rs_cast_components_ready(w, sp);
      mask := rs_component_mask(sp);
      // a priced or consumed material only from a held receipt; the focus never stands in for it
      if (mask & (RS_C_PRICE | RS_C_CONSUME)) != 0 { #assert rs_material_slot(w, rs_component_key(sp)) >= 0; }
      // ordinary materials come through the focus only for its class's own list or that class's grant
      if (mask & RS_C_M) != 0 && (mask & (RS_C_PRICE | RS_C_CONSUME)) == 0 && !c.component_pouch { #assert rs_component_focus(c, sp); }
    }
  } }
}
rs_has_class :: (classes: string, name: string) -> bool {
  if classes.count < name.count { return false; }
  for k: 0..<classes.count - name.count + 1 { if classes[k..<k + name.count] == name { return true; } }
  return false;
}
