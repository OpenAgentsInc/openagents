// Target admission integration plus caller-facing battle lifecycle/budget checks.
// Mutation gates use this entry so the existing public wrappers are exercised,
// rather than exempted from the compiler's whole-entry execution coverage.
#load "battle.coax";

#test "Halt does not suppress Aura of Protection, Danger Sense or Rage through false incapacitation" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
  p := rs_add(b[..],rs_paladin("Paladin",0,6),1,1);
  ally := rs_add(b[..],rs_druid("Ally",0,1),2,1);
  aura := rs_aura(b[..],ally); #assert aura > 0;
  #assert rs_effect_add(b[0].c[p..<p+1],RsEffect.{kind=EF_HALT_PENDING,by=ally,spell=SP_COMMAND,save=-1});
  rs_start_turn(b[..],p);
  #assert !rs_can_act(b[0].c[p]) && rs_capable(b[0].c[p]) && rs_aura(b[..],ally) == aura;
  b[0].c[p].cond = RS_INCAPACITATED; #assert rs_aura(b[..],ally) == 0;
  b[0].c[p].cond = 0; rs_end_turn(b[..],p);
  m := rs_add(b[..],rs_barbarian("Barbarian",0,3),2,2); b[0].c[m].raging = true; b[0].c[m].rage_kept = true;
  #assert rs_effect_add(b[0].c[m..<m+1],RsEffect.{kind=EF_HALT_PENDING,by=ally,spell=SP_COMMAND,save=-1});
  rs_start_turn(b[..],m);
  #assert b[0].c[m].raging && !rs_can_act(b[0].c[m]) && rs_save_edge(b[..],m,RS_DEX) == 1;
}

#test "Command Halt waits for the next logical turn, preserves reactions and ends with that turn" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_cleric("Caster",0,3),1,1);
  t := rs_add(b[..],rs_sorcerer("Target",1,3),2,1);
  commands := [1] int.[RS_EXEC_SOURCE[SP_COMMAND]]; #assert rs_set_spells(b[0].c[a..<a+1],commands[..]);
  spells := [2] int.[RS_EXEC_SOURCE[SP_SHIELD],RS_EXEC_SOURCE[SP_FALSE_LIFE]]; #assert rs_set_spells(b[0].c[t..<t+1],spells[..]); b[0].c[t].shield_spell = true;
  rs_start_turn(b[..],a); #assert rs_cast(b[..],a,SP_COMMAND,1,0,0,t);
  #assert rs_can_act(b[0].c[t]) && rs_can_move(b[0].c[t]);
  rs_tick(b[..],100); #assert rs_can_act(b[0].c[t]) && rs_shield(b[..],t);
  rs_end_turn(b[..],a); rs_start_turn(b[..],t);
  #assert !rs_can_act(b[0].c[t]) && !rs_can_move(b[0].c[t]);
  seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled; slots := b[0].c[t].slots[1];
  #assert !rs_attack(b[..],t,a,false,-1) && !rs_cast(b[..],t,SP_FALSE_LIFE,1,0,0,t) && !rs_innate_sorcery(b[..],t);
  #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && b[0].c[t].slots[1] == slots && !b[0].turn.action && !b[0].turn.bonus;
  #assert rs_shield(b[..],t);
  rs_end_turn(b[..],t); #assert rs_can_act(b[0].c[t]) && rs_can_move(b[0].c[t]);
}

#test "mixed Blindness Deafness choices prepay the actual immunity branch at each recipient" {
  for immune: [2] int.[RS_BLINDED,RS_DEAFENED] {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
    t := rs_add(b[..],rs_skeleton("Deaf choice",1),3,1); b[0].c[t].immune_cond = immune;
    u := rs_add(b[..],rs_skeleton("Blind choice",1),4,1);
    for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100}; }
    keys := [1] int.[RS_EXEC_SOURCE[SP_BLINDNESS]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
    rs_start_turn(b[..],a); picks := [2] int.[t,u]; options := [2] RsCastOptions.[RsCastOptions.{blindness=RS_DEAFENED},RsCastOptions.{}];
    slots := b[0].c[a].slots[3]; seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
    #assert rs_cast_creatures_with(b[..],a,SP_BLINDNESS,3,picks[..],false,options[..]) == (immune == RS_DEAFENED);
    if immune == RS_BLINDED {
      #assert b[0].c[a].slots[3] == slots && b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && !b[0].turn.action;
      b[0].c[t].eff[RS_EFFECTS-1].kind = EF_NONE;
      #assert rs_cast_creatures_with(b[..],a,SP_BLINDNESS,3,picks[..],false,options[..]);
      #assert rs_has(b[0].c[t],RS_DEAFENED) && !rs_has(b[0].c[t],RS_BLINDED);
    } else {
      #assert !rs_has(b[0].c[t],RS_DEAFENED) && !rs_has(b[0].c[t],RS_BLINDED);
      for k: 0..<b[0].book[0].count { e := rs_recent(b[0].book[0],k); #assert !(e.kind == RS_EV_CONDITION && e.to == t); }
    }
    #assert rs_has(b[0].c[u],RS_BLINDED) && !rs_has(b[0].c[u],RS_DEAFENED);
  }
}
#test "malformed or unrelated spell options refuse before costs, rolls or concentration changes" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Target",1),3,1);
  keys := [1] int.[RS_EXEC_SOURCE[SP_BLINDNESS]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
  rs_start_turn(b[..],a); picks := [1] int.[t]; bad := [2] RsCastOptions.[RsCastOptions.{blindness=RS_PRONE},RsCastOptions.{}];
  slots := b[0].c[a].slots[2]; seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
  #assert !rs_cast_creatures_with(b[..],a,SP_BLINDNESS,2,picks[..],false,bad[0..<1]);
  bad[0] = RsCastOptions.{}; #assert !rs_cast_creatures_with(b[..],a,SP_BLINDNESS,2,picks[..],false,bad[..]);
  bad[0].hex_ability = RS_CHA; #assert !rs_cast_creatures_with(b[..],a,SP_BLINDNESS,2,picks[..],false,bad[0..<1]);
  #assert b[0].c[a].slots[2] == slots && b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && !b[0].turn.action && b[0].c[a].conc == -1;
}

#test "chosen Blindness Deafness option changes the retained condition, save and deadline" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Target",1),3,1);
  keys := [1] int.[RS_EXEC_SOURCE[SP_BLINDNESS]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
  rs_start_turn(b[..],a); picks := [1] int.[t];
  options := [1] RsCastOptions.[RsCastOptions.{blindness=RS_DEAFENED}];
  #assert rs_cast_creatures_with(b[..],a,SP_BLINDNESS,2,picks[..],false,options[..]);
  #assert rs_has(b[0].c[t],RS_DEAFENED) && !rs_has(b[0].c[t],RS_BLINDED);
  e := b[0].c[t].eff[0]; #assert e.kind == EF_COND && e.cond == RS_DEAFENED && e.until == rs_secs(60) && e.save == RS_CON && e.dc == rs_dc(b[..],a);
  rs_tick(b[..],60); #assert !rs_has(b[0].c[t],RS_DEAFENED);
}
#test "Hex retains the chosen ability and uses its source upcast concentration duration" {
  for ability: 0..<6 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
    a := rs_add(b[..],rs_warlock("Caster",0,5,SP_ELDRITCH_BLAST),1,1);
    t := rs_add(b[..],rs_skeleton("Target",1),3,1);
    keys := [1] int.[RS_EXEC_SOURCE[SP_HEX]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
    rs_start_turn(b[..],a); picks := [1] int.[t];
    options := [1] RsCastOptions.[RsCastOptions.{hex_ability=ability}];
    #assert rs_cast_creatures_with(b[..],a,SP_HEX,3,picks[..],false,options[..]);
    #assert b[0].c[t].eff[0].kind == EF_HEX && b[0].c[t].eff[0].cond == ability;
    #assert b[0].c[t].eff[0].until == rs_secs(28800) && b[0].c[a].conc_until == rs_secs(28800);
    #assert rs_save_edge(b[..],t,ability) == 0 && rs_attack_edge(b[..],t,a,true,true) == 0;
    u := rs_add(b[..],rs_skeleton("New target",1),4,1);
    b[0].c[t].hp = 1; rs_damage(b[..],a,t,1,RS_FORCE,false,SP_ELDRITCH_BLAST);
    rs_end_turn(b[..],a); rs_tick(b[..],6); rs_start_turn(b[..],a);
    #assert rs_hex_move(b[..],a,u) && b[0].c[u].eff[0].cond == ability && b[0].c[u].eff[0].until == rs_secs(28800);
  }
}

#test "a chosen self Hold Person cannot leave orphaned effects after concentration breaks" {
  for self_first: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_sorcerer("Caster",0,5),1,1); b[0].c[a].score[RS_WIS] = 1;
    t := rs_add(b[..],rs_skeleton("Other",1),3,1); b[0].c[t].humanoid = true; b[0].c[t].score[RS_WIS] = 1;
    keys := [1] int.[RS_EXEC_SOURCE[SP_HOLD_PERSON]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
    rs_start_turn(b[..],a); picks := [2] int.[ifx self_first == 1 then a else t,ifx self_first == 1 then t else a];
    #assert rs_cast_creatures(b[..],a,SP_HOLD_PERSON,3,picks[..],false);
    #assert b[0].c[a].conc == -1 && !rs_has(b[0].c[a],RS_PARALYZED) && !rs_has(b[0].c[t],RS_PARALYZED);
  }
}

#test "chosen rays resolve separate assignments in their declared order" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_sorcerer("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("First",1),3,1);
  u := rs_add(b[..],rs_skeleton("Second",1),4,1);
  for j: [2] int.[t,u] { b[0].c[j].hp = 500; b[0].c[j].hp_max = 500; b[0].c[j].ac = 1; }
  keys := [1] int.[RS_EXEC_SOURCE[SP_SCORCHING_RAY]];
  #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
  rs_start_turn(b[..],a); picks := [3] int.[u,t,t];
  #assert rs_cast_creatures(b[..],a,SP_SCORCHING_RAY,2,picks[..],false);
  #assert b[0].c[t].hp == 488 && b[0].c[u].hp == 494;
  reverse := [3] int.[t,t,u]; found := 0;
  for k: 0..<b[0].book[0].count {
    e := rs_recent(b[0].book[0],k);
    if e.kind == RS_EV_ATTACK { #assert found < 3 && e.to == reverse[found]; found += 1; }
  }
  #assert found == 3;
}
#test "chosen batches refuse a later full recipient before ordinary and Quickened costs" {
  for quick: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
    a := rs_add(b[..],rs_sorcerer("Caster",0,5),1,1);
    t := rs_add(b[..],rs_skeleton("First",1),3,1); b[0].c[t].humanoid = true;
    u := rs_add(b[..],rs_skeleton("Last",1),4,1); b[0].c[u].humanoid = true;
    for k: 0..<RS_EFFECTS { b[0].c[u].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100}; }
    keys := [1] int.[RS_EXEC_SOURCE[SP_HOLD_PERSON]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
    rs_start_turn(b[..],a); b[0].c[a].conc = SP_HEX; b[0].c[a].conc_until = 100; b[0].aff_used = true;
    slots := b[0].c[a].slots[3]; points := b[0].c[a].uses[RS_USE_SORCERY]; seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
    picks := [2] int.[t,u];
    #assert !rs_cast_creatures(b[..],a,SP_HOLD_PERSON,3,picks[..],quick == 1);
    #assert b[0].c[a].slots[3] == slots && b[0].c[a].uses[RS_USE_SORCERY] == points && b[0].c[a].conc == SP_HEX && b[0].c[a].conc_until == 100;
    #assert !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent && b[0].aff_used;
    #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && !rs_has(b[0].c[t],RS_PARALYZED);
    for k: 0..<RS_EFFECTS { #assert b[0].c[u].eff[k].by == 99; }
    b[0].c[u].eff[RS_EFFECTS-1].kind = EF_NONE;
    #assert rs_cast_creatures(b[..],a,SP_HOLD_PERSON,3,picks[..],quick == 1);
    #assert b[0].c[a].slots[3] == slots-1 && b[0].c[a].uses[RS_USE_SORCERY] == points-(ifx quick == 1 then 2 else 0);
    #assert b[0].turn.action == (quick == 0) && b[0].turn.bonus == (quick == 1) && b[0].turn.quickened == (quick == 1) && !b[0].aff_used;
    for k: 0..<RS_EFFECTS-1 { #assert b[0].c[u].eff[k].by == 99; }
  }
}
#test "one chosen Hold Person save does not cancel another recipient's concentration effect" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_druid("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Saves",1),3,1); b[0].c[t].humanoid = true; b[0].c[t].score[RS_WIS] = 30;
  u := rs_add(b[..],rs_skeleton("Fails",1),4,1); b[0].c[u].humanoid = true;
  keys := [1] int.[RS_EXEC_SOURCE[SP_HOLD_PERSON]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
  rs_start_turn(b[..],a); picks := [2] int.[t,u];
  #assert rs_cast_creatures(b[..],a,SP_HOLD_PERSON,3,picks[..],false);
  #assert !rs_has(b[0].c[t],RS_PARALYZED) && rs_has(b[0].c[u],RS_PARALYZED) && b[0].c[a].conc == SP_HOLD_PERSON;
  rs_end_concentration(b[..],a,""); #assert !rs_has(b[0].c[u],RS_PARALYZED);
}
#test "chosen empty optional casts spend normally and Self casts retain shared feature hooks" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_cleric("Cleric",0,6),1,1);
  t := rs_add(b[..],rs_skeleton("Patient",0),2,1);
  rs_start_turn(b[..],a); empty: [1] int; slots := b[0].c[a].slots[1];
  #assert rs_cast_creatures(b[..],a,SP_BLESS,1,empty[0..<0],false) && b[0].c[a].slots[1] == slots-1 && b[0].turn.action;
  #assert !rs_effect(b[0].c[a],EF_BLESS) && !rs_effect(b[0].c[t],EF_BLESS);
  rs_end_turn(b[..],a); rs_start_turn(b[..],a);
  b[0].c[a].hp = 10; b[0].c[t].hp = 1; picks := [1] int.[t];
  #assert rs_cast_creatures(b[..],a,SP_CURE_WOUNDS,1,picks[..],false) && b[0].c[a].hp == 13 && b[0].c[t].hp > 1;
  rs_end_turn(b[..],a); rs_start_turn(b[..],a); picks[0] = a;
  #assert rs_cast_creatures(b[..],a,SP_SPIRIT_GUARDIANS,3,picks[..],false);
  #assert b[0].guards == 1 && b[0].c[a].guard_slot == 3 && b[0].c[a].conc == SP_SPIRIT_GUARDIANS;
}

#test "chosen Bless recipients include the caster and do not fill unchosen creatures" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_cleric("Caster",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Chosen",1),3,1);
  u := rs_add(b[..],rs_skeleton("Unchosen",0),2,1);
  for k: 0..<RS_EFFECTS { b[0].c[u].eff[k] = RsEffect.{kind=EF_HEX}; }
  rs_start_turn(b[..],a); picks := [2] int.[t,a]; slots := b[0].c[a].slots[1];
  #assert rs_cast_creatures(b[..],a,SP_BLESS,1,picks[..],false);
  #assert rs_effect(b[0].c[a],EF_BLESS) && rs_effect(b[0].c[t],EF_BLESS) && !rs_effect(b[0].c[u],EF_BLESS);
  #assert b[0].c[a].slots[1] == slots-1 && b[0].turn.action;
}
#test "chosen upcast Hold Person retains valid targets when another target is invalid or saves" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_druid("Caster",0,5),1,1);
  x := rs_add(b[..],rs_skeleton("Invalid",1),3,1);
  t := rs_add(b[..],rs_skeleton("Humanoid",1),4,1); b[0].c[t].humanoid = true;
  keys := [1] int.[RS_EXEC_SOURCE[SP_HOLD_PERSON]];
  #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
  b[0].dice[0].fixed = true;
  rs_start_turn(b[..],a); picks := [2] int.[x,t]; rolls := b[0].dice[0].rolled;
  #assert rs_cast_creatures(b[..],a,SP_HOLD_PERSON,3,picks[..],false);
  #assert b[0].c[a].conc == SP_HOLD_PERSON && !rs_has(b[0].c[x],RS_PARALYZED) && rs_has(b[0].c[t],RS_PARALYZED);
  #assert b[0].dice[0].rolled == rolls+1;
}

#test "Mage Protective Magic spends a daily use rather than the turn's spell slot" {
  for mode: 0..<3 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
    a := rs_add(b[..],rs_mage("Mage",0),1,1);
    rs_start_turn(b[..],a); b[0].turn.slot_spent = mode == 0; b[0].turn.quickened = mode == 2;
    uses := b[0].c[a].slots[1]; seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
    #assert rs_shield(b[..],a) == (mode != 2);
    #assert b[0].c[a].slots[1] == uses-(ifx mode == 2 then 0 else 1) && b[0].c[a].reacted == (mode != 2);
    #assert b[0].turn.slot_spent == (mode == 0) && b[0].turn.leveled == (mode != 2);
    if mode == 1 { #assert rs_can_cast(b[..],a,SP_FIREBALL,4); }
    if mode == 2 { #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls; }
  }
}

#test "own-turn reaction spells refuse after a slot spell or Quickened cantrip without changing state" {
  for mode: 0..<2 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
    a := rs_add(b[..],rs_druid("Caster",0,3),1,1);
    t := rs_add(b[..],rs_skeleton("Enemy",1),3,1);
    #assert rs_grant_spell(b[0].c[a..<a+1],SP_SHIELD) && rs_grant_spell(b[0].c[a..<a+1],SP_HELLISH_REBUKE);
    b[0].c[a].shield_spell = true; b[0].c[a].rebuke = true;
    rs_start_turn(b[..],a);
    b[0].turn.slot_spent = mode == 0; b[0].turn.quickened = mode == 1;
    slots := b[0].c[a].slots; seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled; hp := b[0].c[t].hp;
    #assert !rs_shield(b[..],a) && !rs_hellish_rebuke(b[..],a,t);
    for k: 0..<10 { #assert b[0].c[a].slots[k] == slots[k]; }
    #assert !b[0].c[a].reacted && !b[0].c[a].shield_active && b[0].c[t].hp == hp;
    #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && !b[0].turn.leveled;
  }
}
#test "own-turn reactions spend the turn slot and count as leveled before later spell admission" {
  for kind: 0..<2 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
    a := rs_add(b[..],rs_sorcerer("Caster",0,3),1,1);
    t := rs_add(b[..],rs_skeleton("Enemy",1),3,1);
    #assert rs_grant_spell(b[0].c[a..<a+1],SP_SHIELD) && rs_grant_spell(b[0].c[a..<a+1],SP_HELLISH_REBUKE);
    b[0].c[a].shield_spell = true; b[0].c[a].rebuke = true;
    choices := [2] int.[RS_EXEC_SOURCE[SP_FIRE_BOLT],RS_EXEC_SOURCE[SP_FALSE_LIFE]];
    #assert rs_set_spells(b[0].c[a..<a+1],choices[..]);
    rs_start_turn(b[..],a); slots := b[0].c[a].slots[1];
    accepted := ifx kind == 0 then rs_shield(b[..],a) else rs_hellish_rebuke(b[..],a,t);
    #assert accepted && b[0].c[a].slots[1] == slots-1 && b[0].c[a].reacted;
    #assert b[0].turn.slot_spent && b[0].turn.leveled && !b[0].turn.action && !b[0].turn.bonus;
    #assert !rs_can_cast(b[..],a,SP_FALSE_LIFE,1) && !rs_can_cast_as(b[..],a,SP_FIRE_BOLT,0,true);
    #assert rs_can_cast(b[..],a,SP_FIRE_BOLT,0);
  }
}
#test "off-turn reactions do not inherit or mutate another actor's slot and Quickened restrictions" {
  for kind: 0..<2 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
    a := rs_add(b[..],rs_druid("Caster",0,3),1,1);
    t := rs_add(b[..],rs_skeleton("Enemy",1),3,1);
    #assert rs_grant_spell(b[0].c[a..<a+1],SP_SHIELD) && rs_grant_spell(b[0].c[a..<a+1],SP_HELLISH_REBUKE);
    b[0].c[a].shield_spell = true; b[0].c[a].rebuke = true;
    rs_start_turn(b[..],t); b[0].turn.slot_spent = true; b[0].turn.quickened = true;
    slots := b[0].c[a].slots[1];
    accepted := ifx kind == 0 then rs_shield(b[..],a) else rs_hellish_rebuke(b[..],a,t);
    #assert accepted && b[0].c[a].slots[1] == slots-1 && b[0].c[a].reacted;
    #assert b[0].turn.slot_spent && b[0].turn.quickened && !b[0].turn.leveled && !b[0].turn.action && !b[0].turn.bonus;
  }
}

#test "multi-target casts refuse the whole batch if a later target has no effect room" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_cleric("Cleric",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("First",0),3,1);
  u := rs_add(b[..],rs_skeleton("Second",0),4,1);
  for k: 0..<RS_EFFECTS { b[0].c[u].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100}; }
  rs_start_turn(b[..],a); slots := b[0].c[a].slots[1]; rolled := b[0].dice[0].rolled; seq := b[0].book[0].seq;
  #assert !rs_cast(b[..],a,SP_BLESS,1,3,1,t);
  #assert b[0].c[a].slots[1] == slots && b[0].c[a].conc == -1 && !b[0].turn.action;
  #assert b[0].dice[0].rolled == rolled && b[0].book[0].seq == seq && !rs_effect(b[0].c[t],EF_BLESS);
  b[0].c[u].eff[RS_EFFECTS-1].kind = EF_NONE;
  #assert rs_cast(b[..],a,SP_BLESS,1,3,1,t) && rs_effect(b[0].c[t],EF_BLESS) && rs_effect(b[0].c[u],EF_BLESS);
}
#test "concentration release pays for its replacement, immunity and invalid types need no record" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_cleric("Cleric",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Target",0),3,1);
  for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_BLESS,by=a,spell=SP_BLESS,until=100,save=-1}; }
  b[0].c[a].conc = SP_BLESS; b[0].c[a].conc_until = 100;
  rs_start_turn(b[..],a);
  #assert rs_cast(b[..],a,SP_BLESS,1,3,1,t) && rs_effect(b[0].c[t],EF_BLESS);
  for k: 1..<RS_EFFECTS { #assert b[0].c[t].eff[k].kind == EF_NONE; }
  rs_end_turn(b[..],a); rs_start_turn(b[..],a);
  for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100}; }
  choices := [1] int.[RS_EXEC_SOURCE[SP_HOLD_PERSON]]; #assert rs_set_spells(b[0].c[a..<a+1],choices[..]);
  // An invalid creature type still spends under p.106, even with no storage.
  #assert rs_cast(b[..],a,SP_HOLD_PERSON,2,3,1,t);
  rs_end_turn(b[..],a); rs_start_turn(b[..],a);
  b[0].c[t].humanoid = true; b[0].c[t].immune_cond |= RS_PARALYZED;
  #assert rs_cast(b[..],a,SP_HOLD_PERSON,2,3,1,t) && !rs_has(b[0].c[t],RS_PARALYZED);
}
#test "weapon and Channel Divinity capacity refusal precedes action, focus and dice" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_monk("Monk",0,5),1,1);
  t := rs_add(b[..],rs_skeleton("Target",1),2,1);
  b[0].c[a].stun_ready = true;
  for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100}; }
  rs_start_turn(b[..],a); focus := b[0].c[a].focus; rolled := b[0].dice[0].rolled; seq := b[0].book[0].seq;
  #assert !rs_attack(b[..],a,t,false,-1) && !rs_bonus_strike(b[..],a,t) && !rs_flurry(b[..],a,t,OH_TOPPLE);
  #assert !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.struck && b[0].c[a].focus == focus;
  #assert b[0].dice[0].rolled == rolled && b[0].book[0].seq == seq;
  b[0].c[a] = rs_cleric("Cleric",0,5); b[0].c[a].x = 1; b[0].c[a].y = 1;
  uses := b[0].c[a].uses[RS_USE_CHANNEL];
  #assert !rs_turn_undead(b[..],a) && !b[0].turn.action && b[0].c[a].uses[RS_USE_CHANNEL] == uses;
  #assert b[0].dice[0].rolled == rolled && b[0].book[0].seq == seq;
}
#test "escaping a zone frees only that lease and preserves another restraint" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_druid("Druid",0,3),1,1);
  t := rs_add(b[..],rs_barbarian("Strong",1,3),3,1);
  b[0].c[t].score[RS_STR] = 30; b[0].c[a].score[RS_WIS] = 1;
  for k: 0..<2 {
    b[0].zone[k] = RsZone.{on=true,by=a,spell=SP_ENTANGLE,until=60};
    #assert rs_effect_add(b[0].c[t..<t+1],RsEffect.{kind=EF_ZONE_RESTRAIN,cond=k,by=a,spell=SP_ENTANGLE,until=60,save=-1});
  }
  rs_start_turn(b[..],t);
  #assert rs_escape(b[..],t) && b[0].c[t].restrained_by == 0 && rs_has(b[0].c[t],RS_RESTRAINED);
  #assert b[0].c[t].eff[0].kind == EF_ZONE_RESTRAIN && b[0].c[t].eff[1].kind == EF_NONE;
}

#test "full effect storage refuses ordinary and Quickened casts before any cost or roll" {
  for quick: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
