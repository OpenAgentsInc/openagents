    t := rs_add(b[..],rs_skeleton("Target",1),3,1); b[0].c[t].humanoid = true;
    choices := [1] int.[RS_EXEC_SOURCE[SP_HOLD_PERSON]];
    #assert rs_set_spells(b[0].c[a..<a+1],choices[..]);
    for k: 0..<RS_EFFECTS { b[0].c[t].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100}; }
    rs_start_turn(b[..],a);
    slots := b[0].c[a].slots[2]; points := b[0].c[a].uses[RS_USE_SORCERY]; dice := b[0].dice[0].rolled; seq := b[0].book[0].seq;
    #assert !rs_cast_as(b[..],a,SP_HOLD_PERSON,2,3,1,t,quick == 1);
    #assert !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.quickened && !b[0].turn.slot_spent;
    #assert b[0].c[a].slots[2] == slots && b[0].c[a].uses[RS_USE_SORCERY] == points && b[0].c[a].conc == -1;
    #assert b[0].dice[0].rolled == dice && b[0].book[0].seq == seq;
    for k: 0..<RS_EFFECTS { #assert b[0].c[t].eff[k].by == 99; }
  }
}
#test "overlapping zone restraints release only their own lease" {
  b: [1] RsBattle; _ := rs_add(b[..],rs_druid("Druid",0,3),1,1);
  for k: 0..<2 {
    b[0].zone[k] = RsZone.{on=true,by=0,spell=SP_ENTANGLE,until=60};
    #assert rs_effect_add(b[0].c[0..<1],RsEffect.{kind=EF_ZONE_RESTRAIN,cond=k,by=0,spell=SP_ENTANGLE,until=60,save=-1});
  }
  #assert rs_release_zone(b[..],1) && b[0].c[0].restrained_by == 0 && rs_has(b[0].c[0],RS_RESTRAINED);
  #assert rs_release_zone(b[..],0) && b[0].c[0].restrained_by == -1 && !rs_has(b[0].c[0],RS_RESTRAINED);
}

#test "a full zone array can reuse the concentration being replaced and releases its old restraint" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_druid("Druid",0,3),1,1);
  t := rs_add(b[..],rs_skeleton("Target",1),3,1);
  rs_start_turn(b[..],a);
  for k: 0..<RS_ZONES { b[0].zone[k] = RsZone.{on=true,by=t,spell=SP_FOG_CLOUD,x0=k,x1=k+1,until=100}; }
  b[0].zone[3].by = a; b[0].zone[3].spell = SP_ENTANGLE;
  b[0].c[a].conc = SP_ENTANGLE; b[0].c[a].conc_until = 100;
  b[0].c[t].restrained_by = 3; b[0].c[t].cond = RS_RESTRAINED;
  before := b[0].zone; slots := b[0].c[a].slots[1];
  #assert rs_cast(b[..],a,SP_ENTANGLE,1,10,1,t);
  #assert b[0].c[a].slots[1] == slots - 1 && b[0].c[a].conc == SP_ENTANGLE;
  #assert b[0].zone[3].on && b[0].zone[3].by == a && b[0].zone[3].spell == SP_ENTANGLE && b[0].zone[3].x0 == 9 && b[0].zone[3].x1 == 12;
  #assert b[0].c[t].restrained_by == -1 && !rs_has(b[0].c[t],RS_RESTRAINED);
  for k: 0..<RS_ZONES {
    if k == 3 { continue; }
    #assert b[0].zone[k].on == before[k].on && b[0].zone[k].by == before[k].by && b[0].zone[k].spell == before[k].spell;
    #assert b[0].zone[k].x0 == before[k].x0 && b[0].zone[k].x1 == before[k].x1 && b[0].zone[k].until == before[k].until;
  }
}
#test "instantaneous casts need no zone slot and a last free slot retains an accepted lasting cast" {
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
  a := rs_add(b[..],rs_wizard("Wizard",0,5),1,1);
  #assert rs_spellbook_add(b[0].c[a..<a+1],RS_EXEC_SOURCE[SP_FOG_CLOUD]);
  choices := [3] int.[RS_KEY_MAGE_ARMOR,RS_EXEC_SOURCE[SP_FIREBALL],RS_EXEC_SOURCE[SP_FOG_CLOUD]];
  #assert rs_set_spells(b[0].c[a..<a+1],choices[..]);
  t := rs_add(b[..],rs_skeleton("Target",1),10,1); b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  for k: 0..<RS_ZONES { b[0].zone[k] = RsZone.{on=true,by=t,spell=SP_FOG_CLOUD,x0=k,x1=k+1,until=100}; }
  rs_start_turn(b[..],a); slots := b[0].c[a].slots[3];
  #assert rs_cast(b[..],a,SP_FIREBALL,3,10,1,t) && b[0].c[a].slots[3] == slots - 1 && b[0].c[t].hp < 500;
  for k: 0..<RS_ZONES { #assert b[0].zone[k].on && b[0].zone[k].by == t && b[0].zone[k].spell == SP_FOG_CLOUD && b[0].zone[k].x0 == k; }
  rs_end_turn(b[..],a); rs_start_turn(b[..],a);
  b[0].zone[RS_ZONES-1].on = false;
  slots = b[0].c[a].slots[1];
  #assert rs_cast(b[..],a,SP_FOG_CLOUD,1,10,1,t) && b[0].c[a].slots[1] == slots - 1;
  #assert b[0].zone[RS_ZONES-1].on && b[0].zone[RS_ZONES-1].by == a && b[0].zone[RS_ZONES-1].spell == SP_FOG_CLOUD;
}

#test "full unrelated zones refuse before ordinary and Quickened cast state changes" {
  for quick: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
    caster := ifx quick == 0 then rs_druid("Druid",0,3) else rs_sorcerer("Sorcerer",0,5);
    a := rs_add(b[..], caster,1,1);
    t := rs_add(b[..], rs_skeleton("Target",1),3,1);
    sp := ifx quick == 0 then SP_ENTANGLE else SP_SLEET_STORM;
    slot := ifx quick == 0 then 1 else 3;
    if quick == 1 { choices := [1] int.[RS_EXEC_SOURCE[SP_SLEET_STORM]]; #assert rs_set_spells(b[0].c[a..<a+1], choices[..]); }
    rs_start_turn(b[..],a);
    b[0].c[a].uses[RS_USE_SORCERY] = 3;
    b[0].c[a].conc = SP_HOLD_PERSON; b[0].c[a].conc_until = 90; b[0].aff_used = true;
    for k: 0..<RS_ZONES { b[0].zone[k] = RsZone.{on=true,by=t,spell=SP_FOG_CLOUD,x0=k,x1=k+1,until=100}; }
    before := b[0].zone; seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled; slots := b[0].c[a].slots[slot];
    #assert !rs_cast_as(b[..],a,sp,slot,10,1,t,quick == 1);
    #assert b[0].c[a].slots[slot] == slots && b[0].c[a].uses[RS_USE_SORCERY] == 3;
    #assert b[0].c[a].conc == SP_HOLD_PERSON && b[0].c[a].conc_until == 90 && b[0].aff_used;
    #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls;
    #assert !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent && !b[0].turn.quickened;
    for k: 0..<RS_ZONES {
      #assert b[0].zone[k].on == before[k].on && b[0].zone[k].by == before[k].by && b[0].zone[k].spell == before[k].spell;
      #assert b[0].zone[k].x0 == before[k].x0 && b[0].zone[k].x1 == before[k].x1 && b[0].zone[k].until == before[k].until;
    }
  }
}

#test "Self spells refuse another creature before ordinary or Quickened costs" {
  for quick: 0..<2 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
    caster := ifx quick == 0 then rs_wizard("Wizard",0,3) else rs_sorcerer("Sorcerer",0,3);
    a := rs_add(b[..], caster, 1, 1); t := rs_add(b[..], rs_skeleton("Target",1),3,1);
    rs_start_turn(b[..], a);
    b[0].aff_used = true; b[0].c[a].conc = SP_HEX; b[0].c[a].conc_until = 90;
    slots := b[0].c[a].slots[1]; points := b[0].c[a].uses[RS_USE_SORCERY];
    seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
    #assert !rs_cast_as(b[..],a,SP_FALSE_LIFE,1,0,0,t,quick == 1);
    #assert b[0].c[a].slots[1] == slots && b[0].c[a].uses[RS_USE_SORCERY] == points;
    #assert b[0].aff_used && b[0].c[a].conc == SP_HEX && b[0].c[a].conc_until == 90;
    #assert !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent && !b[0].turn.quickened;
    #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && b[0].c[t].temp == 0;
    #assert rs_cast_as(b[..],a,SP_FALSE_LIFE,1,0,0,a,quick == 1);
    #assert b[0].c[a].temp >= 6 && b[0].c[a].temp <= 12 && b[0].c[t].temp == 0;
    #assert b[0].c[a].slots[1] == slots - 1 && b[0].c[a].uses[RS_USE_SORCERY] == points - (ifx quick == 1 then 2 else 0);
    #assert b[0].turn.action == (quick == 0) && b[0].turn.bonus == (quick == 1);
    #assert b[0].c[a].conc == SP_HEX && b[0].c[a].conc_until == 90;
  }
}

#test "unprepared reactions preserve their budgets and selected reactions spend normally" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
  wizard := rs_add(b[..], rs_wizard("Wizard", 0, 1), 1, 1);
  warlock := rs_add(b[..], rs_warlock("Warlock", 0, 1, SP_ELDRITCH_BLAST), 2, 1);
  t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
  keys := [2] int.[RS_KEY_MAGE_ARMOR,RS_EXEC_SOURCE[SP_SHIELD]];
  b[0].c[warlock].rebuke = true;
  hex := [1] int.[RS_EXEC_SOURCE[SP_HEX]]; #assert rs_set_spells(b[0].c[warlock..<warlock+1], hex[..]);
  seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
  #assert !rs_shield(b[..], wizard) && !rs_hellish_rebuke(b[..], warlock, t);
  #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls;
  #assert !b[0].c[wizard].reacted && !b[0].c[warlock].reacted && b[0].c[wizard].slots[1] == 1 && b[0].c[warlock].slots[1] == 1;
  #assert rs_set_spells(b[0].c[wizard..<wizard+1], keys[..]);
  #assert rs_shield(b[..], wizard) && b[0].c[wizard].reacted && b[0].c[wizard].slots[1] == 0;
  rebuke := [2] int.[RS_EXEC_SOURCE[SP_HEX],RS_EXEC_SOURCE[SP_HELLISH_REBUKE]];
  #assert rs_set_spells(b[0].c[warlock..<warlock+1], rebuke[..]);
  #assert rs_hellish_rebuke(b[..], warlock, t) && b[0].c[warlock].reacted && b[0].c[warlock].slots[1] == 0;
}

#test "unprepared eligible spells refuse without spending and helper actions require their selected parent" {
