  #assert !rs_spell_ready(b[0].c[a], -1) && !rs_spell_ready(b[0].c[a], SP_WATER_ORB);
  rs_start_turn(b[..], a); slots := b[0].c[a].slots[1]; seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
