#test "malformed casting IDs and cantrip slots refuse before changing any battle state" {
  ids := [6] int.[-1, RS_MORE_END, 99, 104, SP_STARRY_WISP, SP_STARRY_WISP];
  slots := [6] int.[0, 0, 0, 0, -1, 1];
  for k: 0..<6 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
    a := rs_add(b[..], rs_druid("Caster", 0, 3), 1, 1);
    t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
    rs_start_turn(b[..], a);
    b[0].aff_used = true; b[0].c[a].conc = SP_HEX; b[0].c[a].conc_until = 80;
    seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
    hp := b[0].c[t].hp; available := b[0].c[a].slots[1];
    #assert !rs_can_cast(b[..], a, ids[k], slots[k]);
    #assert !rs_cast(b[..], a, ids[k], slots[k], 0, 0, t);
    #assert !rs_cast_quick(b[..], a, ids[k], slots[k], 0, 0, t);
    #assert b[0].aff_used && b[0].c[a].conc == SP_HEX && b[0].c[a].conc_until == 80;
    #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && b[0].c[t].hp == hp;
    #assert b[0].c[a].slots[1] == available && !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent;
  }
}

#test "caller-owned battles retain separate storage, due turns, casting budgets and diagnostics" {
  b: [1] RsBattle; other: [1] RsBattle;
  creatures: [4] RsCreature; squares: [64] int;
  rs_use(b[..], creatures[..], squares[..]); b[0].w = 8; b[0].h = 8;
  #assert rs_room_for(b[..]) == 4;
  a := rs_add(b[..], rs_druid("Caster", 0, 3), 1, 1);
  t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
  _ := rs_add(other[..], rs_cleric("Other", 0, 3), 1, 1);
  b[0].c[a].initiative = 20; b[0].c[t].initiative = 1;
  rs_begin(b[..]); #assert rs_due(b[..]) == -1 && !rs_can_cast(b[..], a, SP_CURE_WOUNDS, 1);
  b[0].clock = b[0].c[a].turn_at;
  #assert rs_due(b[..]) == a;
  rs_start_turn(b[..], a);
  #assert rs_can_cast(b[..], a, SP_CURE_WOUNDS, 1) && rs_cast(b[..], a, SP_CURE_WOUNDS, 1, 0, 0, a);
  #assert !rs_can_cast(b[..], a, SP_CURE_WOUNDS, 1);
  #assert other[0].n == 1 && other[0].c[0].slots[1] == other[0].c[0].slots_max[1];
  #assert rs_team_up(b[..], 0) == 1 && rs_team_up(b[..], 1) == 1;
  b[0].c[t].hp = 0; #assert rs_team_up(b[..], 1) == 0;
  line: [1] RsLine; line[0] = rs_line(); rs_add_text(line[..], "Room "); rs_add_int(line[..], rs_room_for(b[..]));
  #assert cast(string) line[0].buf[0..<line[0].n] == "Room 4";
}
#test "Monk bonus strike and Step of the Wind share one Bonus Action while Dash spends its action" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_monk("Monk", 0, 3), 1, 1);
  t := rs_add(b[..], rs_skeleton("Target", 1), 2, 1);
  b[0].c[t].hp = 500; b[0].c[t].hp_max = 500;
  rs_start_turn(b[..], a); movement := b[0].turn.move_left;
  #assert rs_bonus_strike(b[..], a, t) && b[0].turn.bonus;
  #assert !rs_bonus_strike(b[..], a, t) && !rs_step_of_the_wind(b[..], a);
  #assert rs_dash(b[..], a) && b[0].turn.move_left == movement + 8 && !rs_dash(b[..], a);
  rs_end_turn(b[..], a); rs_start_turn(b[..], a);
  focus := b[0].c[a].focus;
  #assert rs_step_of_the_wind(b[..], a) && b[0].turn.move_left == 16 && b[0].c[a].focus == focus;
  #assert !rs_bonus_strike(b[..], a, t);
}
