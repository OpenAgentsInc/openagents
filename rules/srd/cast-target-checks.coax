  #assert b[0].c[a].slots[1] == slots && !b[0].turn.action && b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls;
}

#test "reaction flags do not grant extra-list spells and raging prevents reaction casting" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
  a := rs_add(b[..], rs_druid("Druid", 0, 3), 1, 1);
  t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
  b[0].c[a].shield_spell = true; b[0].c[a].rebuke = true;
  seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled; slots := b[0].c[a].slots[1];
  #assert !rs_shield(b[..], a) && !rs_hellish_rebuke(b[..], a, t);
  #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && b[0].c[a].slots[1] == slots && !b[0].c[a].reacted;
  _ := rs_grant_spell(b[0].c[a..<a+1], SP_SHIELD); _ = rs_grant_spell(b[0].c[a..<a+1], SP_HELLISH_REBUKE);
  b[0].c[a].raging = true;
  #assert !rs_shield(b[..], a) && !rs_hellish_rebuke(b[..], a, t);
  #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls && b[0].c[a].slots[1] == slots && !b[0].c[a].reacted;
}

