// SRD p.106: an invalid creature type is an unaffected cast, not a request
// refusal. Loaded by battle.coax, which supplies the battle/events/types.
#authority;
#load "cast-target.coax";

#test "invalid target: Hold Person on an Undead spends a slot but rolls no save or condition" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_druid("Caster", 0, 3), 1, 1);
  t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
  b[0].c[a].conc = SP_HEX; b[0].c[a].conc_until = 80;
  b[0].c[t].eff[0] = RsEffect.{kind = EF_HEX, by = a, spell = SP_HEX, until = 80};
  rs_start_turn(b[..], a); rolls := b[0].dice[0].rolled; slots := b[0].c[a].slots[2]; hp := b[0].c[t].hp;
  #assert rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, t);
  #assert b[0].c[a].slots[2] == slots - 1 && b[0].turn.action && b[0].turn.slot_spent;
  #assert b[0].dice[0].rolled == rolls && b[0].c[t].hp == hp && b[0].c[t].cond == 0;
  #assert b[0].c[a].conc == -1 && b[0].c[a].conc_until == 0 && !rs_effect(b[0].c[t], EF_HEX);
  e := rs_recent(b[0].book[0], 0);
  #assert e.kind == RS_EV_SAVE && e.spell == SP_HOLD_PERSON && e.to == t && e.damage == 1 && e.amount == 0;
}
#test "invalid target: malformed, dead and out of range requests preserve all preflight state" {
  for which: 0..<4 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8;
    a := rs_add(b[..], rs_druid("Caster", 0, 3), 1, 1);
    t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
    rs_start_turn(b[..], a);
    if which == 0 { t = -1; } if which == 1 { t = b[0].n; }
    if which == 2 { rs_place(b[..], t, 20, 1); }
    if which == 3 { b[0].c[t].dead = true; }
    b[0].aff_used = true; b[0].c[a].conc = SP_HEX; b[0].c[a].conc_until = 80;
    rolls := b[0].dice[0].rolled; seq := b[0].book[0].seq; slots := b[0].c[a].slots[2];
    #assert !rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, t);
    #assert b[0].aff_used && b[0].c[a].conc == SP_HEX && b[0].c[a].conc_until == 80;
    #assert b[0].dice[0].rolled == rolls && b[0].book[0].seq == seq && b[0].c[a].slots[2] == slots;
    #assert !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent;
  }
}
#test "invalid target: a legal Humanoid still makes its normal save and a Quickened invalid cast pays both costs" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_sorcerer("Caster", 0, 3), 1, 1);
  t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
  b[0].c[t].humanoid = true;
  rs_start_turn(b[..], a); rolls := b[0].dice[0].rolled;
  #assert rs_cast(b[..], a, SP_HOLD_PERSON, 2, 0, 0, t);
  #assert b[0].dice[0].rolled > rolls && rs_has(b[0].c[t], RS_PARALYZED);
  rs_end_turn(b[..], a); rs_start_turn(b[..], a);
  b[0].c[t].humanoid = false; b[0].c[t].cond = 0;
  b[0].c[a].quickened = true; b[0].c[a].uses[RS_USE_SORCERY] = 3;
  rolls = b[0].dice[0].rolled; slots := b[0].c[a].slots[2];
  #assert rs_cast_quick(b[..], a, SP_HOLD_PERSON, 2, 0, 0, t);
  #assert b[0].c[a].uses[RS_USE_SORCERY] == 1 && b[0].c[a].slots[2] == slots - 1;
  #assert b[0].turn.bonus && !b[0].turn.action && b[0].turn.quickened;
  #assert b[0].dice[0].rolled == rolls && !rs_has(b[0].c[t], RS_PARALYZED);
}
#test "invalid target: outcome handler preserves unrelated concentration and does not touch valid casts" {
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
  a := rs_add(b[..], rs_druid("Caster", 0, 3), 1, 1);
  t := rs_add(b[..], rs_skeleton("Target", 1), 3, 1);
  b[0].c[a].conc = SP_HEX; b[0].c[a].conc_until = 80;
  b[0].c[t].temp = 5; b[0].c[t].cond = RS_POISONED;
  seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
  #assert !rs_unaffected_target(b[..], a, t, SP_CURE_WOUNDS) && b[0].book[0].seq == seq;
  #assert rs_unaffected_target(b[..], a, t, SP_HOLD_PERSON);
  #assert b[0].c[a].conc == SP_HEX && b[0].c[a].conc_until == 80;
  #assert b[0].c[t].temp == 5 && b[0].c[t].cond == RS_POISONED && b[0].dice[0].rolled == rolls;
  e := rs_recent(b[0].book[0], 0);
  #assert cast(string) e.text[0..<e.text_n] == "  Target save: success";
}

// Caller has already validated a live, in-range creature and spent the cast.
// A successful apparent save has no fabricated die roll (amount 0, success 1).
// The legacy single-target wrapper ends an inapplicable concentration cast;
// a chosen batch retains its concentration while checking other recipients.
rs_unaffected_target :: (b: [] RsBattle, i: int, j: int, sp: int) -> bool #effects(all) {
  return rs_unaffected_target_kept(b,i,j,sp,false);
}
rs_unaffected_target_kept :: (b: [] RsBattle, i: int, j: int, sp: int, keep_concentration: bool) -> bool #effects(all) {
  s := rs_spell(sp);
  if rs_target_decision(true, false, true, s.humanoid_only, b[0].c[j].humanoid) != RS_TARGET_UNAFFECTED { return false; }
  l: [1] RsLine; rs_add_text(l[..], "  "); rs_add_name(l[..], b, j); rs_add_text(l[..], " save: success");
  rs_tell(b, RS_EV_SAVE, sp, i, j, 0, 1, l[..]);
  if !keep_concentration && b[0].c[i].conc == sp { b[0].c[i].conc = -1; b[0].c[i].conc_until = 0; }
  return true;
}
