// Casting workflows through the shared battle: Rituals (SRD 5.2.1 pp.104-105, p.78, p.179) and sight (p.106).
// Its decisions are ritual.coax's (mutation-gated through this entry):
//   coax/bin/coax test rules/srd/cast-workflow-checks.coax --library
//   coax/bin/coax mutate rules/srd/cast-workflow-checks.coax --library --unit rules/srd/ritual.coax
#load "battle.coax";
#load "catalog.coax";
#load "executable-source-ids.coax";

rt_prepare :: (b: [] RsBattle, i: int, sp: int) {
  keys := [1] int.[RS_EXEC_SOURCE[sp]];
  if b[0].c[i].klass == RS_WIZARD { _ := rs_spellbook_add(b[0].c[i..<i+1],keys[0]); }
  #assert rs_set_spells(b[0].c[i..<i+1],keys[..]);
}
// A level 5 Druid at (1, 1) with Water Walk prepared, and an ally beside it.
rt_druid :: (b: [] RsBattle) -> int {
  b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b,rs_druid("Druid",0,5),1,1); _ := rs_add(b,rs_fighter("Ally",0,1),2,1);
  rt_prepare(b,a,SP_WATER_WALK); rs_start_turn(b,a);
  return a;
}
// The next own turn, one six-second round on.
rt_turn :: (b: [] RsBattle, a: int) { rs_end_turn(b,a); b[0].clock += RS_ROUND_TICKS; rs_start_turn(b,a); }
// The caster's slots and free-cast uses are as they were.
rt_kept :: (b: [] RsBattle, a: int, was: RsCreature) -> bool {
  for k: 1..<10 { if b[0].c[a].slots[k] != was.slots[k] { return false; } }
  return b[0].c[a].uses[RS_USE_FREE] == was.uses[RS_USE_FREE];
}

#test "a prepared Ritual takes ten more minutes of Magic actions, then its action, and spends no slot" #steps 400000000 {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); a := rt_druid(b[..]); ally := 1; was := b[0].c[a];
  #assert rs_ritual_begin(b[..],a,SP_WATER_WALK);
  #assert b[0].turn.action && b[0].turn.leveled && !b[0].turn.slot_spent && b[0].c[a].conc == SP_WATER_WALK && b[0].c[a].rite == SP_WATER_WALK;
  e := rs_recent_at(b[0].book[..],0); #assert e.kind == RS_EV_TEXT && cast(string) e.text[0..<e.text_n] == "Druid begins Water Walk as a Ritual";
  #assert !rs_ritual_continue(b[..],a) && !rs_ritual_begin(b[..],a,SP_WATER_WALK);   // once a turn; one rite
  for turn: 1..<100 {
    rt_turn(b[..],a);
    seq := b[0].book[0].seq;
    #assert !rs_cast(b[..],a,SP_WATER_WALK,0,0,0,ally) && b[0].book[0].seq == seq && !b[0].turn.action;   // not yet due
    #assert rs_ritual_continue(b[..],a) && b[0].turn.action && b[0].c[a].rite == SP_WATER_WALK;
  }
  rt_turn(b[..],a);
  #assert !rs_ritual_continue(b[..],a) && !b[0].turn.action;   // ten minutes are up: the action left is the cast
  // a held free cast of the same spell is not what the Ritual spends
  b[0].c[a].uses_max[RS_USE_FREE] = 1; b[0].c[a].uses[RS_USE_FREE] = 1; b[0].c[a].rank[RS_RK_FREE_SPELL] = SP_WATER_WALK; was = b[0].c[a];
  #assert !rs_cast(b[..],a,SP_WATER_WALK,0,0,0,9) && b[0].c[a].rite == SP_WATER_WALK;   // a malformed request spends nothing
  #assert rs_cast(b[..],a,SP_WATER_WALK,0,0,0,ally);
  #assert rt_kept(b[..],a,was) && b[0].c[a].rite == -1 && b[0].c[a].conc == -1 && b[0].turn.action && !b[0].turn.slot_spent;
  e = rs_recent_at(b[0].book[..],0);
  #assert e.kind == RS_EV_CAST && cast(string) e.text[0..<e.text_n] == "Druid casts Water Walk (as a Ritual) at Ally";
  rt_turn(b[..],a); #assert b[0].c[a].rite == -1;
}
#test "a missed Magic action, failed Concentration save, incapacitation, Rage or new Concentration spell fails the Ritual and expends nothing" #steps 400000000 {
  for why: 0..<4 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); a := rt_druid(b[..]); was := b[0].c[a];
    prior := RsEffect.{kind=EF_FAITH,by=a,spell=SP_WATER_WALK,until=9000};
    #assert rs_effect_add(b[0].c[1..<2],prior);   // an earlier copy's effect is not the rite's to end
    #assert rs_ritual_begin(b[..],a,SP_WATER_WALK);
    rt_turn(b[..],a);
    if why == 0 { rt_turn(b[..],a); }
    if why == 1 { b[0].c[a].score[RS_CON] = 1; b[0].c[a].save_prof[RS_CON] = false; rs_damage(b[..],1,a,40,RS_FIRE,false,-1); }
    if why == 2 { b[0].c[a].cond = RS_STUNNED; rt_turn(b[..],a); }
    if why == 3 { rt_prepare(b[..],a,SP_ENTANGLE); #assert rs_cast(b[..],a,SP_ENTANGLE,1,5,1,-1); }
    #assert b[0].c[a].rite == -1 && !b[0].c[a].rite_owed;
    #assert b[0].c[a].conc == (ifx why == 3 then SP_ENTANGLE else -1);
    #assert rs_effect(b[0].c[1],EF_FAITH);
    if why != 3 { #assert rt_kept(b[..],a,was); }
    found := false;
    for k: 0..<rs_min(b[0].book[0].seq,RS_EVENTS) {
      ev := rs_recent_at(b[0].book[..],k);
      t := cast(string) ev.text[0..<ev.text_n];
      if ev.kind == RS_EV_END && ev.spell.value == SP_WATER_WALK && t.count >= 25 && t[0..<25] == "Druid's Water Walk Ritual" { found = true; }
    }
    #assert found;
  }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); a := rt_druid(b[..]);
  #assert rs_ritual_begin(b[..],a,SP_WATER_WALK); rt_turn(b[..],a);
  b[0].c[a].uses[RS_USE_RAGE] = 1; b[0].c[a].uses_max[RS_USE_RAGE] = 1;
  #assert rs_rage(b[..],a) && b[0].c[a].rite == -1 && b[0].c[a].conc == -1;
}
#test "beginning a Ritual ends earlier Concentration and interrupts no Concentration-free state when refused" #steps 400000000 {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); a := rt_druid(b[..]);
  keys := [2] int.[RS_EXEC_SOURCE[SP_WATER_WALK],RS_EXEC_SOURCE[SP_ENTANGLE]];
  #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
  #assert rs_cast(b[..],a,SP_ENTANGLE,1,5,1,-1) && b[0].c[a].conc == SP_ENTANGLE;
  rt_turn(b[..],a);
  #assert rs_ritual_begin(b[..],a,SP_WATER_WALK) && b[0].c[a].conc == SP_WATER_WALK;
  zone_kept := false; for k: 0..<RS_ZONES { if b[0].zone[k].on && b[0].zone[k].spell == SP_ENTANGLE { zone_kept = true; } }
  #assert !zone_kept;
  // refusals: no tag, not prepared, action spent, Quickened this turn, raging, not its turn
  for why: 0..<6 {
    c: [1] RsBattle; c_room: [1] RsRoom; rs_have(c[..], c_room[..]); d := rt_druid(c[..]);
    keys2 := [2] int.[RS_EXEC_SOURCE[SP_WATER_WALK],RS_EXEC_SOURCE[SP_ENTANGLE]];
    #assert rs_set_spells(c[0].c[d..<d+1],keys2[..]);
    #assert rs_cast(c[..],d,SP_ENTANGLE,1,5,1,-1); rt_turn(c[..],d);
    sp := SP_WATER_WALK;
    if why == 0 { sp = SP_ENTANGLE; }
    if why == 1 { sp = SP_WATER_BREATHING; }
    if why == 2 { c[0].turn.action = true; }
    if why == 3 { c[0].turn.quickened = true; }
    if why == 4 { c[0].c[d].eff = rs_state_put(c[0].c[d].eff, EF_RAGE, true); }
    if why == 5 { c[0].who = 1; }
    seq := c[0].book[0].seq;
    #assert !rs_ritual_begin(c[..],d,sp);
    #assert c[0].c[d].conc == SP_ENTANGLE && c[0].c[d].rite == -1 && c[0].book[0].seq == seq && c[0].turn.action == (why == 2);
  }
  for bad: [4] int.[-1,RS_MORE_END,SP_FLAME_HURL,SP_ICE_KNIFE_BURST] { #assert !rs_ritual_begin(b[..],a,bad); }
  #assert !rs_ritual_begin(b[..],-1,SP_WATER_WALK) && !rs_ritual_begin(b[..],9,SP_WATER_WALK) && !rs_ritual_continue(b[..],9);
}
#test "Ritual Adept reads a spellbook Ritual that is not prepared; other casters need it prepared" #steps 400000000 {
  for adept: 0..<2 { for book: 0..<2 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8;
    a := rs_add(b[..],rs_wizard("Wizard",0,5),1,1);
    keys := [1] int.[RS_EXEC_SOURCE[SP_FIRE_BOLT]]; #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
    if book == 1 { #assert rs_spellbook_add(b[0].c[a..<a+1],RS_EXEC_SOURCE[SP_WATER_BREATHING]); }
    b[0].c[a].feats = rs_feature_put(b[0].c[a].feats, RS_FT_RITUAL_ADEPT, adept == 1);
    rs_start_turn(b[..],a); was := b[0].c[a];
    #assert !rs_spell_ready(b[0].c[a],SP_WATER_BREATHING);
    #assert rs_ritual_begin(b[..],a,SP_WATER_BREATHING) == (adept == 1 && book == 1);
    if adept == 1 && book == 1 {
      for turn: 0..<100 { rt_turn(b[..],a); if turn < 99 { #assert rs_ritual_continue(b[..],a); } }
      #assert !rs_cast(b[..],a,SP_WATER_BREATHING,3,0,0,a) && rt_kept(b[..],a,was);   // an ordinary cast still needs preparation
      #assert rs_cast(b[..],a,SP_WATER_BREATHING,0,0,0,a) && rt_kept(b[..],a,was);
    }
  } }
  // a Warlock's prepared Speak with Animals; unprepared, a Warlock cannot
  for prepared: 0..<2 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 20; b[0].h = 8;
    a := rs_add(b[..],rs_warlock("Warlock",0,3,SP_ELDRITCH_BLAST),1,1);
    keys := [1] int.[RS_EXEC_SOURCE[ifx prepared == 1 then SP_SPEAK_WITH_ANIMALS else SP_HEX]];
    #assert rs_set_spells(b[0].c[a..<a+1],keys[..]);
    rs_start_turn(b[..],a);
    #assert rs_ritual_begin(b[..],a,SP_SPEAK_WITH_ANIMALS) == (prepared == 1);
  }
}
#test "only the due rite's caster casts it free; Quickened, early or another spell's slot-0 requests refuse" #steps 400000000 {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); a := rt_druid(b[..]); was := b[0].c[a];
  #assert rs_ritual_begin(b[..],a,SP_WATER_WALK);
  for turn: 0..<100 { rt_turn(b[..],a); if turn < 99 { #assert rs_ritual_continue(b[..],a); } }
  b[0].c[a].feats = rs_feature_put(b[0].c[a].feats, RS_FT_QUICKENED, true); b[0].c[a].uses[RS_USE_SORCERY] = 4;
  #assert !rs_cast_quick(b[..],a,SP_WATER_WALK,0,0,0,1) && b[0].c[a].uses[RS_USE_SORCERY] == 4;
  #assert !rs_cast(b[..],a,SP_ENTANGLE,0,5,1,-1) && !rs_cast(b[..],a,SP_WATER_BREATHING,0,0,0,1);
  #assert b[0].c[a].rite == SP_WATER_WALK && !b[0].turn.action && rt_kept(b[..],a,was);
  // the due turn passes without the cast: it fails at the next turn's start
  rt_turn(b[..],a); #assert b[0].c[a].rite == -1 && rt_kept(b[..],a,was);
}

#test "every executable record carries the source Ritual tag and timed casts have a dedicated workflow" #steps 400000000 {
  rituals := 0;
  for sp: 0..<RS_MORE_END {
    s := rs_spell(sp); src := srd_source_lookup(RS_EXECUTABLE_SOURCE_IDS[sp]);
    #assert s.ritual == (src.ritual && s.part_of < 0);
    #assert (src.cast_kind == SRD_CAST_TIMED) == (sp == SP_FIND_FAMILIAR);
    if sp == SP_FIND_FAMILIAR {
      #assert s.cast_time == RS_T_LONG && src.cast_seconds == int(RS_FIND_FAMILIAR_SECONDS);
    } else if s.ritual { #assert src.cast_text == "Action or Ritual"; }
    if s.ritual { rituals += 1; }
  }
  #assert rituals == 4;
  for sp: RS_HOUSE..<RS_HOUSE_END { #assert !rs_spell(sp).ritual; }
}

rc_has :: (text: string, word: string) -> bool {
  if word.count == 0 || text.count < word.count { return word.count == 0; }
  for k: 0..<text.count - word.count + 1 { if text[k..<k + word.count] == word { return true; } }
  return false;
}
// The source text with its line breaks and hyphenation joined.
rc_joined :: (text: string, out: [] u8) -> string {
  n := 0;
  for k: 0..<text.count {
    ch := text[k];
    if ch == 10 {
      if n > 0 && out[n - 1] == 45 { n -= 1; continue; }
      ch = 32;
    }
    if n < out.count { out[n] = ch; n += 1; }
  }
  return cast(string) out[0..<n];
}
#test "the reviewed sight list matches every executable description that chooses what you can see" #steps 400000000 {
  // Dimension Door's destination may also be pictured or described; Feather Fall's sight is in
  // its Reaction trigger, which the world supplies (fivebar.coax), not a choice admitted here.
  // Find Familiar uses the phrase for seeing through the familiar’s eyes.
  reviewed := [3] string.["dimension-door","feather-fall","find-familiar"];
  buf: [8192] u8;
  for sp: 0..<RS_MORE_END {
    src := srd_source_lookup(RS_EXECUTABLE_SOURCE_IDS[sp]);
    text := rc_joined(src.text, buf[..]);
    sees := rc_has(text, "you can see") || rc_has(src.cast_text, "you can see");   // a Reaction trigger is in its casting time
    form := rs_spell_sight(sp);
    if form == RS_SIGHT_SEE_OR_HEAR { #assert rc_has(text, "you can see or hear"); }
    if form != RS_SIGHT_NONE { #assert sees; continue; }
    if !sees { continue; }
    excused := false; for id: reviewed { if id == src.id { excused = true; } }
    #assert excused;
  }
}

// A level 5 caster at (1, 1) with these spells selected, and a Humanoid foe two squares east.
rc_sight :: (b: [] RsBattle, c: RsCreature, spells: [] const int) -> int {
  b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b,c,1,1); t := rs_add(b,rs_fighter("Foe",1,1),3,1); b[0].c[t].humanoid = true;
  keys: [8] int; for k: 0..<spells.count { keys[k] = RS_EXEC_SOURCE[spells[k]]; }
  #assert rs_set_spells(b[0].c[a..<a+1],keys[0..<spells.count]);
  rs_start_turn(b,a);
  return a;
}
rc_same :: (b: [] RsBattle, a: int, was: RsCreature, rolled: int, seq: int) -> bool {
  for k: 0..<10 { if b[0].c[a].slots[k] != was.slots[k] { return false; } }
  return !b[0].turn.action && !b[0].turn.bonus && b[0].dice[0].rolled == rolled && b[0].book[0].seq == seq && b[0].c[a].conc == was.conc;
}
#test "an unseen creature or point refuses a you-can-see spell before any cost; hearing serves Vicious Mockery" #steps 400000000 {
  spells := [3] int.[SP_HOLD_PERSON,SP_SACRED_FLAME,SP_COMMAND];
  for blind: 0..<2 { for hidden: 0..<2 { for path: 0..<3 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); a := rc_sight(b[..],rs_cleric("Cleric",0,5),spells[..]); t := 1;
    if blind == 1 { b[0].c[a].cond = RS_BLINDED; }
    if hidden == 1 { b[0].c[t].cond = RS_INVISIBLE; }
    was := b[0].c[a]; rolled := b[0].dice[0].rolled; seq := b[0].book[0].seq;
    picks := [1] int.[t];
    ok := false;
    if path == 0 { ok = rs_cast(b[..],a,SP_HOLD_PERSON,2,0,0,t); }
    if path == 1 { ok = rs_cast(b[..],a,SP_SACRED_FLAME,0,0,0,t); }
    if path == 2 { ok = rs_cast_creatures(b[..],a,SP_COMMAND,1,picks[..],false); }
    #assert ok == (blind == 0 && hidden == 0);
    if !ok { #assert rc_same(b[..],a,was,rolled,seq); }
  } } }
  for deaf: 0..<2 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); mock := [1] int.[SP_VICIOUS_MOCKERY];
    a := rc_sight(b[..],rs_bard("Bard",0,5),mock[..]);
    b[0].c[a].cond = RS_BLINDED | (ifx deaf == 1 then RS_DEAFENED else 0);
    #assert rs_cast(b[..],a,SP_VICIOUS_MOCKERY,0,0,0,1) == (deaf == 0);
  }
  for blind: 0..<2 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); storm := [1] int.[SP_CALL_LIGHTNING];
    a := rc_sight(b[..],rs_druid("Druid",0,5),storm[..]);
    if blind == 1 { b[0].c[a].cond = RS_BLINDED; }
    was := b[0].c[a]; rolled := b[0].dice[0].rolled; seq := b[0].book[0].seq;
    ok := rs_cast(b[..],a,SP_CALL_LIGHTNING,3,8,1,-1);
    #assert ok == (blind == 0);
    if !ok { #assert rc_same(b[..],a,was,rolled,seq); }
  }
  for blind: 0..<2 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); rebuke := [1] int.[SP_HELLISH_REBUKE];
    a := rc_sight(b[..],rs_warlock("Warlock",0,3,SP_ELDRITCH_BLAST),rebuke[..]);
    b[0].c[a].feats = rs_feature_put(b[0].c[a].feats, RS_FT_REBUKE, true);
    if blind == 1 { b[0].c[a].cond = RS_BLINDED; }
    b[0].who = 1;
    slots := b[0].c[a].slots[2];
    #assert rs_hellish_rebuke(b[..],a,1) == (blind == 0);
    #assert b[0].c[a].reacted == (blind == 0) && b[0].c[a].slots[2] == slots - (ifx blind == 0 then 1 else 0);
  }
}
