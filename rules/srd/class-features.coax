// The levels 1-6 slice's class and subclass features (#13044): every feature the SRD 5.2.1 class
// tables and subclass descriptions give the twelve presets at levels 1 to 6, with its level and
// printed page, and what of the built preset (engine.coax rs_barbarian ... rs_wizard) shows it.
// The table is held to the presets at every level 1 to 6 below: a feature is there from its level
// and not before. What each one does is checked against its text, feature by feature, in
// class-<class>-checks.coax. Check-only: no world loads this file.
//   coax/bin/coax test --library rules/srd/class-features.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "battle.coax";

RsCf :: struct { klass: int; level: int; page: int; name: string; }
RS_CF_MAX :: 160;
cf :: (out: [] RsCf, n: int, klass: int, level: int, page: int, name: string) -> int { out[n] = RsCf.{klass = klass, level = level, page = page, name = name}; return n + 1; }
// Each class's rows, in the order of its class table; subclass features under their subclass.
rs_cf_table :: (out: [] RsCf) -> int {
  n := 0;
  // Barbarian (p. 28-30), Path of the Berserker
  n = cf(out, n, RS_BARBARIAN, 1, 28, "Rage"); n = cf(out, n, RS_BARBARIAN, 1, 29, "Unarmored Defense");
  n = cf(out, n, RS_BARBARIAN, 1, 29, "Weapon Mastery"); n = cf(out, n, RS_BARBARIAN, 2, 29, "Danger Sense");
  n = cf(out, n, RS_BARBARIAN, 2, 29, "Reckless Attack"); n = cf(out, n, RS_BARBARIAN, 3, 29, "Primal Knowledge");
  n = cf(out, n, RS_BARBARIAN, 3, 30, "Frenzy"); n = cf(out, n, RS_BARBARIAN, 4, 29, "Ability Score Improvement");
  n = cf(out, n, RS_BARBARIAN, 4, 29, "Weapon Mastery (3)");
  n = cf(out, n, RS_BARBARIAN, 5, 29, "Extra Attack"); n = cf(out, n, RS_BARBARIAN, 5, 29, "Fast Movement");
  n = cf(out, n, RS_BARBARIAN, 6, 30, "Mindless Rage");
  // Fighter (p. 47-49), Champion
  n = cf(out, n, RS_FIGHTER, 1, 47, "Fighting Style"); n = cf(out, n, RS_FIGHTER, 1, 48, "Second Wind");
  n = cf(out, n, RS_FIGHTER, 1, 48, "Weapon Mastery"); n = cf(out, n, RS_FIGHTER, 2, 48, "Action Surge");
  n = cf(out, n, RS_FIGHTER, 2, 48, "Tactical Mind"); n = cf(out, n, RS_FIGHTER, 3, 49, "Improved Critical");
  n = cf(out, n, RS_FIGHTER, 3, 49, "Remarkable Athlete"); n = cf(out, n, RS_FIGHTER, 4, 48, "Ability Score Improvement");
  n = cf(out, n, RS_FIGHTER, 4, 48, "Second Wind (3)"); n = cf(out, n, RS_FIGHTER, 4, 48, "Weapon Mastery (4)");
  n = cf(out, n, RS_FIGHTER, 5, 48, "Extra Attack"); n = cf(out, n, RS_FIGHTER, 5, 48, "Tactical Shift");
  n = cf(out, n, RS_FIGHTER, 6, 48, "Ability Score Improvement (6)");
  // Rogue (p. 61-64), Thief
  n = cf(out, n, RS_ROGUE, 1, 61, "Expertise"); n = cf(out, n, RS_ROGUE, 1, 61, "Sneak Attack");
  n = cf(out, n, RS_ROGUE, 1, 62, "Thieves' Cant"); n = cf(out, n, RS_ROGUE, 1, 62, "Weapon Mastery");
  n = cf(out, n, RS_ROGUE, 2, 62, "Cunning Action"); n = cf(out, n, RS_ROGUE, 3, 62, "Steady Aim");
  n = cf(out, n, RS_ROGUE, 3, 64, "Fast Hands"); n = cf(out, n, RS_ROGUE, 3, 64, "Second-Story Work");
  n = cf(out, n, RS_ROGUE, 3, 61, "Sneak Attack (2d6)"); n = cf(out, n, RS_ROGUE, 4, 63, "Ability Score Improvement");
  n = cf(out, n, RS_ROGUE, 5, 63, "Cunning Strike"); n = cf(out, n, RS_ROGUE, 5, 63, "Uncanny Dodge");
  n = cf(out, n, RS_ROGUE, 5, 61, "Sneak Attack (3d6)"); n = cf(out, n, RS_ROGUE, 6, 63, "Expertise (6)");
  // Monk (p. 49-52), Warrior of the Open Hand
  n = cf(out, n, RS_MONK, 1, 50, "Martial Arts"); n = cf(out, n, RS_MONK, 1, 50, "Unarmored Defense");
  n = cf(out, n, RS_MONK, 2, 50, "Monk's Focus"); n = cf(out, n, RS_MONK, 2, 51, "Unarmored Movement");
  n = cf(out, n, RS_MONK, 2, 51, "Uncanny Metabolism"); n = cf(out, n, RS_MONK, 3, 51, "Deflect Attacks");
  n = cf(out, n, RS_MONK, 3, 52, "Open Hand Technique"); n = cf(out, n, RS_MONK, 4, 51, "Ability Score Improvement");
  n = cf(out, n, RS_MONK, 4, 51, "Slow Fall"); n = cf(out, n, RS_MONK, 5, 51, "Extra Attack");
  n = cf(out, n, RS_MONK, 5, 51, "Stunning Strike"); n = cf(out, n, RS_MONK, 5, 50, "Martial Arts (d8)");
  n = cf(out, n, RS_MONK, 6, 51, "Empowered Strikes"); n = cf(out, n, RS_MONK, 6, 52, "Wholeness of Body");
  n = cf(out, n, RS_MONK, 6, 51, "Unarmored Movement (+15)");
  // Paladin (p. 53-56), Oath of Devotion
  n = cf(out, n, RS_PALADIN, 1, 53, "Lay On Hands"); n = cf(out, n, RS_PALADIN, 1, 54, "Spellcasting");
  n = cf(out, n, RS_PALADIN, 1, 54, "Weapon Mastery"); n = cf(out, n, RS_PALADIN, 2, 54, "Fighting Style");
  n = cf(out, n, RS_PALADIN, 2, 54, "Paladin's Smite"); n = cf(out, n, RS_PALADIN, 3, 54, "Channel Divinity");
  n = cf(out, n, RS_PALADIN, 3, 56, "Oath of Devotion Spells"); n = cf(out, n, RS_PALADIN, 3, 56, "Sacred Weapon");
  n = cf(out, n, RS_PALADIN, 4, 55, "Ability Score Improvement"); n = cf(out, n, RS_PALADIN, 5, 55, "Extra Attack");
  n = cf(out, n, RS_PALADIN, 5, 55, "Faithful Steed"); n = cf(out, n, RS_PALADIN, 6, 55, "Aura of Protection");
  // Ranger (p. 57-61), Hunter
  n = cf(out, n, RS_RANGER, 1, 57, "Spellcasting"); n = cf(out, n, RS_RANGER, 1, 58, "Favored Enemy");
  n = cf(out, n, RS_RANGER, 1, 58, "Weapon Mastery"); n = cf(out, n, RS_RANGER, 2, 59, "Deft Explorer");
  n = cf(out, n, RS_RANGER, 2, 59, "Fighting Style"); n = cf(out, n, RS_RANGER, 3, 61, "Hunter's Lore");
  n = cf(out, n, RS_RANGER, 3, 61, "Hunter's Prey"); n = cf(out, n, RS_RANGER, 4, 59, "Ability Score Improvement");
  n = cf(out, n, RS_RANGER, 5, 59, "Extra Attack"); n = cf(out, n, RS_RANGER, 5, 58, "Favored Enemy (3)");
  n = cf(out, n, RS_RANGER, 6, 59, "Roving");
  // Cleric (p. 36-40), Life Domain
  n = cf(out, n, RS_CLERIC, 1, 36, "Spellcasting"); n = cf(out, n, RS_CLERIC, 1, 37, "Divine Order");
  n = cf(out, n, RS_CLERIC, 2, 37, "Channel Divinity"); n = cf(out, n, RS_CLERIC, 3, 40, "Life Domain Spells");
  n = cf(out, n, RS_CLERIC, 3, 40, "Disciple of Life"); n = cf(out, n, RS_CLERIC, 3, 40, "Preserve Life");
  n = cf(out, n, RS_CLERIC, 4, 37, "Ability Score Improvement"); n = cf(out, n, RS_CLERIC, 5, 37, "Sear Undead");
  n = cf(out, n, RS_CLERIC, 5, 40, "Life Domain Spells (5)"); n = cf(out, n, RS_CLERIC, 6, 40, "Blessed Healer");
  n = cf(out, n, RS_CLERIC, 6, 37, "Channel Divinity (3)");
  // Bard (p. 31-35), College of Lore
  n = cf(out, n, RS_BARD, 1, 31, "Bardic Inspiration"); n = cf(out, n, RS_BARD, 1, 32, "Spellcasting");
  n = cf(out, n, RS_BARD, 2, 32, "Expertise"); n = cf(out, n, RS_BARD, 2, 32, "Jack of All Trades");
  n = cf(out, n, RS_BARD, 3, 35, "Bonus Proficiencies"); n = cf(out, n, RS_BARD, 3, 35, "Cutting Words");
  n = cf(out, n, RS_BARD, 4, 32, "Ability Score Improvement"); n = cf(out, n, RS_BARD, 5, 32, "Font of Inspiration");
  n = cf(out, n, RS_BARD, 5, 31, "Bardic Inspiration (d8)"); n = cf(out, n, RS_BARD, 6, 35, "Magical Discoveries");
  // Wizard (p. 77-82), Evoker
  n = cf(out, n, RS_WIZARD, 1, 77, "Spellcasting"); n = cf(out, n, RS_WIZARD, 1, 78, "Ritual Adept");
  n = cf(out, n, RS_WIZARD, 1, 78, "Arcane Recovery"); n = cf(out, n, RS_WIZARD, 2, 78, "Scholar");
  n = cf(out, n, RS_WIZARD, 3, 82, "Evocation Savant"); n = cf(out, n, RS_WIZARD, 3, 82, "Potent Cantrip");
  n = cf(out, n, RS_WIZARD, 4, 79, "Ability Score Improvement"); n = cf(out, n, RS_WIZARD, 5, 79, "Memorize Spell");
  n = cf(out, n, RS_WIZARD, 6, 82, "Sculpt Spells");
  // Warlock (p. 70-76), Fiend Patron
  n = cf(out, n, RS_WARLOCK, 1, 70, "Eldritch Invocations"); n = cf(out, n, RS_WARLOCK, 1, 71, "Pact Magic");
  n = cf(out, n, RS_WARLOCK, 2, 72, "Magical Cunning"); n = cf(out, n, RS_WARLOCK, 2, 70, "Eldritch Invocations (3)");
  n = cf(out, n, RS_WARLOCK, 3, 76, "Dark One's Blessing"); n = cf(out, n, RS_WARLOCK, 3, 76, "Fiend Spells");
  n = cf(out, n, RS_WARLOCK, 4, 72, "Ability Score Improvement"); n = cf(out, n, RS_WARLOCK, 5, 70, "Eldritch Invocations (5)");
  n = cf(out, n, RS_WARLOCK, 6, 76, "Dark One's Own Luck");
  // Sorcerer (p. 64-70), Draconic Sorcery
  n = cf(out, n, RS_SORCERER, 1, 64, "Spellcasting"); n = cf(out, n, RS_SORCERER, 1, 65, "Innate Sorcery");
  n = cf(out, n, RS_SORCERER, 2, 66, "Font of Magic"); n = cf(out, n, RS_SORCERER, 2, 66, "Metamagic");
  n = cf(out, n, RS_SORCERER, 3, 69, "Draconic Resilience"); n = cf(out, n, RS_SORCERER, 3, 70, "Draconic Spells");
  n = cf(out, n, RS_SORCERER, 4, 66, "Ability Score Improvement"); n = cf(out, n, RS_SORCERER, 5, 66, "Sorcerous Restoration");
  n = cf(out, n, RS_SORCERER, 6, 70, "Elemental Affinity");
  // Druid (p. 41-46), Circle of the Land (polar)
  n = cf(out, n, RS_DRUID, 1, 41, "Spellcasting"); n = cf(out, n, RS_DRUID, 1, 42, "Druidic");
  n = cf(out, n, RS_DRUID, 1, 42, "Primal Order"); n = cf(out, n, RS_DRUID, 2, 42, "Wild Shape");
  n = cf(out, n, RS_DRUID, 2, 43, "Wild Companion"); n = cf(out, n, RS_DRUID, 3, 46, "Circle of the Land Spells");
  n = cf(out, n, RS_DRUID, 3, 46, "Land's Aid"); n = cf(out, n, RS_DRUID, 4, 43, "Ability Score Improvement");
  n = cf(out, n, RS_DRUID, 4, 42, "Wild Shape (CR 1/2)"); n = cf(out, n, RS_DRUID, 4, 41, "Cantrips (3)");
  n = cf(out, n, RS_DRUID, 5, 43, "Wild Resurgence"); n = cf(out, n, RS_DRUID, 5, 46, "Circle of the Land Spells (5)");
  n = cf(out, n, RS_DRUID, 6, 46, "Natural Recovery"); n = cf(out, n, RS_DRUID, 6, 42, "Wild Shape (3)");
  return n;
}
// The classes whose rows are complete and held to the presets.
RS_CF_DONE :: [12] int.[RS_BARBARIAN, RS_FIGHTER, RS_ROGUE, RS_MONK, RS_PALADIN, RS_RANGER, RS_CLERIC, RS_BARD, RS_WIZARD, RS_WARLOCK, RS_SORCERER, RS_DRUID];

// A dice state whose first roll of a `sides` die lands on `face` (for a check of one exact roll, a 19).
cf_seed :: (sides: int, face: int) -> u64 {
  for s: 1..<100000 { d: [1] RsDice; d[0].state = cast(u64) s; if rs_roll(d[..], sides) == face { return cast(u64) s; } }
  return 0;
}
// A hero at (1, 1) and a plain foe beside it at 200 of 300 Hit Points, AC `ac`; fixed dice (each
// die on half its faces), the hero's turn open.
cf_field :: (b: [] RsBattle, hero: RsCreature, ac: int) {
  b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true;
  _ := rs_add(b, hero, 1, 1);
  t := rs_add(b, rs_sorcerer("Foe", 1, 3), 2, 1);
  b[0].c[t].hp = 200; b[0].c[t].hp_max = 300; b[0].c[t].ac = ac; b[0].c[t].shield_spell = false; b[0].c[t].deflect = false;
  rs_fresh(b, 0);
}

rs_cf_bits :: (v: int) -> int { n := 0; x := v; while x > 0 { n += x & 1; x = x >> 1; } return n; }

rs_cf_hero :: (klass: int, level: int) -> RsCreature {
  if klass == RS_BARBARIAN { return rs_barbarian("Hero", 0, level); }
  if klass == RS_BARD { return rs_bard("Hero", 0, level); }
  if klass == RS_CLERIC { return rs_cleric("Hero", 0, level); }
  if klass == RS_DRUID { return rs_druid("Hero", 0, level); }
  if klass == RS_FIGHTER { return rs_fighter("Hero", 0, level); }
  if klass == RS_MONK { return rs_monk("Hero", 0, level); }
  if klass == RS_PALADIN { return rs_paladin("Hero", 0, level); }
  if klass == RS_RANGER { return rs_ranger("Hero", 0, level); }
  if klass == RS_ROGUE { return rs_rogue("Hero", 0, level); }
  if klass == RS_SORCERER { return rs_sorcerer("Hero", 0, level); }
  if klass == RS_WARLOCK { return rs_warlock("Hero", 0, level, SP_ELDRITCH_BLAST); }
  return rs_wizard("Hero", 0, level);
}
// Does the built preset c show feature f? Each reads the state the feature's rules run on.
rs_cf_held :: (c: RsCreature, f: string) -> bool {
  dex := rs_mod(c.score[RS_DEX]); con := rs_mod(c.score[RS_CON]);
  if c.klass == RS_BARBARIAN {
    if f == "Rage" { return c.rages_max >= 2 && c.rage_bonus == 2; }
    if f == "Unarmored Defense" { return c.ac == 10 + dex + con; }
    if f == "Weapon Mastery" { return c.mastery_n >= 2 && (c.masteries & (1 << M_CLEAVE)) != 0; }
    if f == "Danger Sense" { return c.danger_sense; }
    if f == "Reckless Attack" { return c.level >= 2; }   // rs_attack admits it from level 2
    if f == "Primal Knowledge" { return c.primal; }
    if f == "Frenzy" { return c.frenzy; }
    if f == "Ability Score Improvement" { return c.score[RS_STR] == 18; }
    if f == "Weapon Mastery (3)" { return c.mastery_n == 3; }
    if f == "Extra Attack" { return c.extra_attack == 1; }
    if f == "Fast Movement" { return c.speed == 40; }
    if f == "Mindless Rage" { return c.mindless; }
  }
  if c.klass == RS_FIGHTER {
    if f == "Fighting Style" { return c.ac == 16 + 1; }   // Defense: +1 AC in Chain Mail
    if f == "Second Wind" { return c.uses_max[RS_USE_WIND] >= 2; }
    if f == "Weapon Mastery" { return c.mastery_n >= 3 && (c.masteries & (1 << M_GRAZE)) != 0; }
    if f == "Action Surge" { return c.uses_max[RS_USE_SURGE] == 1; }
    if f == "Tactical Mind" { return c.tactical; }
    if f == "Improved Critical" { return c.crit_range == 1; }
    if f == "Remarkable Athlete" { return c.athlete; }
    if f == "Ability Score Improvement" { return c.score[RS_STR] >= 18; }
    if f == "Second Wind (3)" { return c.uses_max[RS_USE_WIND] == 3; }
    if f == "Weapon Mastery (4)" { return c.mastery_n == 4; }
    if f == "Extra Attack" { return c.extra_attack == 1; }
    if f == "Tactical Shift" { return c.shift; }
    if f == "Ability Score Improvement (6)" { return c.score[RS_STR] == 20; }
  }
  if c.klass == RS_ROGUE {
    if f == "Expertise" { return rs_cf_bits(c.checks.expert) >= 2; }
    if f == "Sneak Attack" { return c.sneak_dice >= 1; }
    if f == "Thieves' Cant" { return c.cant; }
    if f == "Weapon Mastery" { return c.mastery_n == 2 && (c.masteries & (1 << M_VEX)) != 0 && (c.masteries & (1 << M_NICK)) != 0; }
    if f == "Cunning Action" { return c.cunning; }
    if f == "Steady Aim" { return c.steady_aim; }
    if f == "Fast Hands" { return c.fast_hands; }
    if f == "Second-Story Work" { return c.climb == c.speed && c.climb > 0; }
    if f == "Sneak Attack (2d6)" { return c.sneak_dice >= 2; }
    if f == "Ability Score Improvement" { return c.score[RS_DEX] == 18; }
    if f == "Cunning Strike" { return c.cunning_strike; }
    if f == "Uncanny Dodge" { return c.uncanny; }
    if f == "Sneak Attack (3d6)" { return c.sneak_dice == 3; }
    if f == "Expertise (6)" { return rs_cf_bits(c.checks.expert) == 4; }
  }
  if c.klass == RS_MONK {
    if f == "Martial Arts" { return c.martial_die >= 6 && c.weapon == W_UNARMED; }
    if f == "Unarmored Defense" { return c.ac == 10 + dex + rs_mod(c.score[RS_WIS]); }
    if f == "Monk's Focus" { return c.focus_max == c.level && c.focus_max >= 2; }
    if f == "Unarmored Movement" { return c.speed >= 40; }
    if f == "Uncanny Metabolism" { return c.metabolism && c.uses_max[RS_USE_METABOLISM] == 1; }
    if f == "Deflect Attacks" { return c.deflect; }
    if f == "Open Hand Technique" { return c.open_hand; }
    if f == "Ability Score Improvement" { return c.score[RS_DEX] == 18; }
    if f == "Slow Fall" { return c.slow_fall; }
    if f == "Extra Attack" { return c.extra_attack == 1; }
    if f == "Stunning Strike" { return c.stunning; }
    if f == "Martial Arts (d8)" { return c.martial_die == 8; }
    if f == "Empowered Strikes" { return c.empowered; }
    if f == "Wholeness of Body" { return c.uses_max[RS_USE_WHOLE] == rs_max(rs_mod(c.score[RS_WIS]), 1); }
    if f == "Unarmored Movement (+15)" { return c.speed == 45; }
  }
  if c.klass == RS_PALADIN {
    if f == "Lay On Hands" { return c.uses_max[RS_USE_LAY] == 5 * c.level; }
    if f == "Spellcasting" { return c.spell_ability == RS_CHA && c.slots_max[1] >= 2; }
    if f == "Weapon Mastery" { return c.mastery_n == 2 && (c.masteries & (1 << M_SAP)) != 0 && (c.masteries & (1 << M_SLOW)) != 0; }
    if f == "Fighting Style" { return rs_class_spell_granted(c, SP_SACRED_FLAME); }   // Blessed Warrior
    if f == "Paladin's Smite" { return c.free_spell == SP_DIVINE_SMITE && c.uses_max[RS_USE_FREE] == 1 && rs_class_spell_granted(c, SP_DIVINE_SMITE); }
    if f == "Channel Divinity" { return c.uses_max[RS_USE_CHANNEL] == 2; }
    if f == "Oath of Devotion Spells" { return rs_class_spell_granted(c, SP_SHIELD_OF_FAITH); }
    if f == "Sacred Weapon" { return c.level >= 3; }   // rs_sacred_weapon admits it from level 3
    if f == "Ability Score Improvement" { return c.score[RS_STR] == 18; }
    if f == "Extra Attack" { return c.extra_attack == 1; }
    if f == "Faithful Steed" { return c.steed && c.uses_max[RS_USE_STEED] == 1; }
    if f == "Aura of Protection" { return c.aura; }
  }
  if c.klass == RS_RANGER {
    if f == "Spellcasting" { return c.spell_ability == RS_WIS && c.slots_max[1] >= 2; }
    if f == "Favored Enemy" { return c.free_spell == SP_HUNTERS_MARK && c.uses_max[RS_USE_FREE] >= 2 && rs_class_spell_granted(c, SP_HUNTERS_MARK); }
    if f == "Weapon Mastery" { return c.mastery_n == 2 && (c.masteries & (1 << M_VEX)) != 0 && (c.masteries & (1 << M_SLOW)) != 0; }
    if f == "Deft Explorer" { return c.explorer && (c.checks.expert & (1 << SK_SURVIVAL)) != 0; }
    if f == "Fighting Style" { return c.archery; }
    if f == "Hunter's Lore" { return c.lore; }
    if f == "Hunter's Prey" { return c.colossus; }
    if f == "Ability Score Improvement" { return c.score[RS_DEX] == 18; }
    if f == "Extra Attack" { return c.extra_attack == 1; }
    if f == "Favored Enemy (3)" { return c.uses_max[RS_USE_FREE] == 3; }
    if f == "Roving" { return c.speed == 40 && c.climb == 40 && c.swim == 40; }
  }
  if c.klass == RS_CLERIC {
    if f == "Spellcasting" { return c.spell_ability == RS_WIS && c.slots_max[1] >= 2; }
    if f == "Divine Order" { return c.order == RS_ORDER_PROTECTOR; }
    if f == "Channel Divinity" { return c.uses_max[RS_USE_CHANNEL] >= 2 && c.turn_undead; }   // Divine Spark and Turn Undead
    if f == "Life Domain Spells" { return rs_class_spell_granted(c, SP_BLESS) && rs_class_spell_granted(c, SP_CURE_WOUNDS); }
    if f == "Disciple of Life" { return c.disciple; }
    if f == "Preserve Life" { return c.preserve_life; }
    if f == "Ability Score Improvement" { return c.score[RS_WIS] == 18; }
    if f == "Sear Undead" { return c.sear; }
    if f == "Life Domain Spells (5)" { return rs_class_spell_granted(c, SP_MASS_HEALING_WORD); }
    if f == "Blessed Healer" { return c.blessed_healer; }
    if f == "Channel Divinity (3)" { return c.uses_max[RS_USE_CHANNEL] == 3; }
  }
  if c.klass == RS_BARD {
    if f == "Bardic Inspiration" { return c.insp_die >= 6 && c.uses_max[RS_USE_INSPIRE] == rs_max(rs_mod(c.score[RS_CHA]), 1); }
    if f == "Spellcasting" { return c.spell_ability == RS_CHA && c.slots_max[1] >= 2; }
    if f == "Expertise" { return c.checks.expert == (1 << SK_PERFORMANCE) | (1 << SK_PERSUASION); }
    if f == "Jack of All Trades" { return c.jack; }
    if f == "Bonus Proficiencies" { return (c.checks.skills & (1 << SK_INSIGHT)) != 0; }
    if f == "Cutting Words" { return c.cutting; }
    if f == "Ability Score Improvement" { return c.score[RS_CHA] == 18; }
    if f == "Font of Inspiration" { return c.font; }
    if f == "Bardic Inspiration (d8)" { return c.insp_die == 8; }
    if f == "Magical Discoveries" { return c.discoveries[0] == SP_FIREBALL && c.discoveries[1] == SP_SPIRIT_GUARDIANS; }
  }
  if c.klass == RS_WIZARD {
    if f == "Spellcasting" { return c.spell_ability == RS_INT && c.slots_max[1] >= 2; }
    if f == "Ritual Adept" { return c.ritual; }
    if f == "Arcane Recovery" { return c.arcane_recovery && rs_rest_slot_budget(c, true) >= 1; }
    if f == "Scholar" { return c.scholar && (c.checks.expert & (1 << SK_ARCANA)) != 0; }
    if f == "Evocation Savant" { return c.savant; }
    if f == "Potent Cantrip" { return c.potent; }
    if f == "Ability Score Improvement" { return c.score[RS_INT] == 18; }
    if f == "Memorize Spell" { return c.memorize; }
    if f == "Sculpt Spells" { return c.sculpt; }
  }
  if c.klass == RS_WARLOCK {
    if f == "Eldritch Invocations" { return c.ac == 13 + dex; }   // Armor of Shadows
    if f == "Pact Magic" { return c.spell_ability == RS_CHA && rs_pact_level(c) >= 1; }
    if f == "Magical Cunning" { return c.cunning_rite && c.uses_max[RS_USE_CUNNING] == 1; }
    if f == "Eldritch Invocations (3)" { return c.agonizing == SP_ELDRITCH_BLAST && c.repelling == SP_ELDRITCH_BLAST; }
    if f == "Dark One's Blessing" { return c.dark_blessing; }
    if f == "Fiend Spells" { return rs_class_spell_granted(c, SP_BURNING_HANDS) && rs_class_spell_granted(c, SP_COMMAND) && rs_class_spell_granted(c, SP_SCORCHING_RAY); }
    if f == "Ability Score Improvement" { return c.score[RS_CHA] == 18; }
    if f == "Eldritch Invocations (5)" { return c.vigor && c.eldritch_mind && rs_class_spell_granted(c, SP_FIREBALL); }
    if f == "Dark One's Own Luck" { return c.own_luck && c.uses_max[RS_USE_LUCK] == rs_max(rs_mod(c.score[RS_CHA]), 1); }
  }
  if c.klass == RS_SORCERER {
    if f == "Spellcasting" { return c.spell_ability == RS_CHA && c.slots_max[1] >= 2; }
    if f == "Innate Sorcery" { return c.uses_max[RS_USE_INNATE] == 2; }
    if f == "Font of Magic" { return c.uses_max[RS_USE_SORCERY] == c.level && rs_font_of_magic_ready(c); }
    if f == "Metamagic" { return c.quickened && c.seeking; }
    if f == "Draconic Resilience" { return c.ac == 10 + dex + rs_mod(c.score[RS_CHA]); }
    if f == "Draconic Spells" { return rs_class_spell_granted(c, SP_COMMAND); }
    if f == "Ability Score Improvement" { return c.score[RS_CHA] == 18; }
    if f == "Sorcerous Restoration" { return c.restoration; }
    if f == "Elemental Affinity" { return c.affinity == RS_FIRE && (c.resist & (1 << RS_FIRE)) != 0; }
  }
  if c.klass == RS_DRUID {
    if f == "Spellcasting" { return c.spell_ability == RS_WIS && c.slots_max[1] >= 2; }
    if f == "Druidic" { return rs_class_spell_granted(c, SP_SPEAK_WITH_ANIMALS); }
    if f == "Primal Order" { return c.order == RS_ORDER_WARDEN; }
    if f == "Wild Shape" { return c.uses_max[RS_USE_WILD] >= 2 && rs_wild_knows(c, MON_WOLF); }
    if f == "Wild Companion" { return c.companion; }
    if f == "Circle of the Land Spells" { return rs_class_spell_granted(c, SP_HOLD_PERSON) && rs_class_spell_granted(c, SP_FOG_CLOUD) && rs_class_spell_granted(c, SP_RAY_OF_FROST); }
    if f == "Land's Aid" { return c.lands_aid; }
    if f == "Ability Score Improvement" { return c.score[RS_WIS] == 18; }
    if f == "Wild Shape (CR 1/2)" { return rs_wild_knows(c, MON_BLACK_BEAR); }
    if f == "Cantrips (3)" { return c.spells.cantrips == 3; }
    if f == "Wild Resurgence" { return c.resurgence; }
    if f == "Circle of the Land Spells (5)" { return rs_class_spell_granted(c, SP_SLEET_STORM); }
    if f == "Natural Recovery" { return c.natural_recovery && c.free_spell == SP_HOLD_PERSON; }
    if f == "Wild Shape (3)" { return c.uses_max[RS_USE_WILD] == 3; }
  }
  return false;
}

#test "the slice's feature table: each done class's features are on its preset from their level, not before" #steps 400000000 {
  rows: [RS_CF_MAX] RsCf; n := rs_cf_table(rows[..]);
  for klass: RS_CF_DONE {
    count := 0;
    for level: 1..<7 {
      c := rs_cf_hero(klass, level);
      #assert c.klass == klass && c.level == level;
      for r: 0..<n {
        if rows[r].klass != klass { continue; }
        if level == 1 { count += 1; #assert rows[r].level >= 1 && rows[r].level <= 6 && rows[r].page >= 28 && rows[r].page <= 82; }
        #assert rs_cf_held(c, rows[r].name) == (level >= rows[r].level);
      }
    }
    #assert count > 0;
  }
}
