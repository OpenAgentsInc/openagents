// The Paladin's levels 1-6 features (#13044; class-features.coax lists them), each resolved through
// the shared battle against its SRD 5.2.1 text (p. 53-56), with fixed dice (d8 4, d20 10). The
// preset is an Oath of Devotion Paladin in Chain Mail with a Shield and a Longsword, Strength 16,
// Charisma 14, its Fighting Style Blessed Warrior (Sacred Flame).
//   coax/bin/coax test --library rules/srd/class-paladin-checks.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "class-features.coax";

#test "Lay On Hands p.53: a pool of five times its level, spent as a Bonus Action on itself or a creature it touches; a Long Rest refills it" {
  for level: 1..<7 { #assert rs_paladin("U", 0, level).uses_max[RS_USE_LAY] == 5 * level; }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 1), 10);
  b[0].c[0].hp = 2;
  #assert rs_lay_on_hands(b[..], 0, 0, 5) && b[0].c[0].hp == 7 && b[0].c[0].uses[RS_USE_LAY] == 0 && b[0].turn.bonus && !b[0].turn.action;
  rs_fresh(b[..], 0); #assert !rs_lay_on_hands(b[..], 0, 1, 5);   // the pool is spent
  #assert rs_long_rest_resources(b[0].c[0..<1]) && b[0].c[0].uses[RS_USE_LAY] == 5;
}

#test "Spellcasting p.54: Charisma, DC 8 + proficiency + Charisma; the Paladin table's slots" {
  ones := [7] int.[0, 2, 2, 3, 3, 4, 4]; twos := [7] int.[0, 0, 0, 0, 0, 2, 2];
  for level: 1..<7 {
    c := rs_paladin("U", 0, level);
    #assert c.spell_ability == RS_CHA && c.slots_max[1] == ones[level] && c.slots_max[2] == twos[level] && c.slots_max[3] == 0;
    #assert rs_spell_dc(c) == 8 + rs_proficiency(level) + 2;
  }
}

#test "Weapon Mastery p.54: two kinds; a Longsword hit Saps (Disadvantage on the target's next attack roll)" {
  #assert rs_paladin("U", 0, 1).mastery_n == 2 && rs_paladin("U", 0, 6).mastery_n == 2;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 1), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - (4 + 3) && rs_effect(b[0].c[1], EF_WEAK);
}

#test "Fighting Style p.54: from level 2, Blessed Warrior's Sacred Flame, a Paladin spell cast with Charisma" {
  #assert !rs_class_spell_granted(rs_paladin("U", 0, 1), SP_SACRED_FLAME) && rs_class_spell_granted(rs_paladin("U", 0, 2), SP_SACRED_FLAME);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 2), 10);
  #assert rs_dc(b[..], 0) == 12 && rs_cast(b[..], 0, SP_SACRED_FLAME, 0, 0, 0, 1) && b[0].c[0].slots[1] == 2;
}

#test "Paladin's Smite p.54: from level 2 Divine Smite is always prepared and cast once a Long Rest without a slot" {
  #assert rs_paladin("U", 0, 1).rank[RS_RK_FREE_SPELL] != SP_DIVINE_SMITE && !rs_class_spell_granted(rs_paladin("U", 0, 1), SP_DIVINE_SMITE);
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 2), 10);
  #assert rs_class_spell_granted(b[0].c[0], SP_DIVINE_SMITE) && b[0].c[0].uses[RS_USE_FREE] == 1;
  #assert rs_attack(b[..], 0, 1, false, -1);
  #assert rs_cast(b[..], 0, SP_DIVINE_SMITE, 0, 0, 0, 1) && b[0].c[0].uses[RS_USE_FREE] == 0 && b[0].c[0].slots[1] == 2;
  #assert b[0].c[1].hp == 200 - 7 - 2 * 4;   // 2d8 Radiant
  #assert rs_long_rest_resources(b[0].c[0..<1]) && b[0].c[0].uses[RS_USE_FREE] == 1;
}

#test "Channel Divinity p.54: two uses from level 3, one back on a Short Rest, all on a Long Rest; Divine Sense its first effect" {
  #assert rs_paladin("U", 0, 2).uses_max[RS_USE_CHANNEL] == 0 && rs_paladin("U", 0, 3).uses_max[RS_USE_CHANNEL] == 2 && rs_paladin("U", 0, 6).uses_max[RS_USE_CHANNEL] == 2;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 3), 10); b[0].c[1].fiend = true;
  #assert rs_divine_sense(b[..], 0) && rs_divine_sensed(b[..], 0, 1) && b[0].c[0].uses[RS_USE_CHANNEL] == 1;
  b[0].c[0].uses[RS_USE_CHANNEL] = 0; rs_short_rest_resources(b[0].c[0..<1]); #assert b[0].c[0].uses[RS_USE_CHANNEL] == 1;
  rs_short_rest_resources(b[0].c[0..<1]); #assert b[0].c[0].uses[RS_USE_CHANNEL] == 2;
  b[0].c[0].uses[RS_USE_CHANNEL] = 0; #assert rs_long_rest_resources(b[0].c[0..<1]) && b[0].c[0].uses[RS_USE_CHANNEL] == 2;
  two: [1] RsBattle; two_room: [1] RsRoom; rs_have(two[..], two_room[..]); cf_field(two[..], rs_paladin("Ulf", 0, 2), 10); #assert !rs_divine_sense(two[..], 0);
}

#test "Oath of Devotion Spells p.56: Shield of Faith always prepared from level 3" {
  #assert !rs_class_spell_granted(rs_paladin("U", 0, 2), SP_SHIELD_OF_FAITH) && rs_class_spell_granted(rs_paladin("U", 0, 3), SP_SHIELD_OF_FAITH);
  #assert rs_spell_ready(rs_paladin("U", 0, 3), SP_SHIELD_OF_FAITH);
}

#test "Sacred Weapon p.56: with the Attack action and a Channel Divinity use, Charisma on its melee attack rolls for 10 minutes" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 3), 17);
  #assert !rs_attack(b[..], 0, 1, false, -1) || b[0].c[1].hp == 200;   // 10 + 5 misses AC 17
  rs_fresh(b[..], 0);
  #assert rs_sacred_weapon(b[..], 0) && b[0].c[0].uses[RS_USE_CHANNEL] == 1 && rs_aura_on(b[0].c[0], EF_SACRED, b[0].clock + rs_secs(600) - 1) && !rs_aura_on(b[0].c[0], EF_SACRED, b[0].clock + rs_secs(600));
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp < 200;   // 10 + 5 + 2 hits
  two: [1] RsBattle; two_room: [1] RsRoom; rs_have(two[..], two_room[..]); cf_field(two[..], rs_paladin("Ulf", 0, 2), 10); #assert !rs_sacred_weapon(two[..], 0);
}

#test "Ability Score Improvement p.55: Strength 16 to 18 at level 4" {
  #assert rs_paladin("U", 0, 3).score[RS_STR] == 16 && rs_paladin("U", 0, 4).score[RS_STR] == 18;
}

#test "Extra Attack p.55: from level 5 the Attack action makes two attacks" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 5), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - 2 * (4 + 4);
  four: [1] RsBattle; four_room: [1] RsRoom; rs_have(four[..], four_room[..]); cf_field(four[..], rs_paladin("Ulf", 0, 4), 10);
  #assert rs_attack(four[..], 0, 1, false, -1) && four[0].c[1].hp == 200 - (4 + 4);
}

#test "Faithful Steed p.55: from level 5, Find Steed once a Long Rest without a slot" {
  #assert rs_paladin("U", 0, 4).uses_max[RS_USE_STEED] == 0 && !rs_has_feature(rs_paladin("U", 0, 4), RS_FT_FAITHFUL_STEED);
  c: [1] RsCreature; c[0] = rs_paladin("U", 0, 5);
  #assert rs_has_feature(c[0], RS_FT_FAITHFUL_STEED) && c[0].uses[RS_USE_STEED] == 1;
  c[0].uses[RS_USE_STEED] = 0; #assert rs_long_rest_resources(c[..]) && c[0].uses[RS_USE_STEED] == 1;
}

#test "Aura of Protection p.55: from level 6, it and allies within 10 feet add its Charisma modifier to saves; not while Incapacitated" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); cf_field(b[..], rs_paladin("Ulf", 0, 6), 10);
  near := rs_add(b[..], rs_fighter("Ally", 0, 3), 3, 1); far := rs_add(b[..], rs_fighter("Far", 0, 3), 4, 1);
  #assert rs_aura(b[..], 0) == 2 && rs_aura(b[..], near) == 2 && rs_aura(b[..], far) == 0 && rs_aura(b[..], 1) == 0;
  #assert rs_save_in(b[..], near, RS_WIS) == rs_save_bonus(b[0].c[near], RS_WIS) + 2;
  b[0].c[0].cond = RS_INCAPACITATED; #assert rs_aura(b[..], near) == 0;
  five: [1] RsBattle; five_room: [1] RsRoom; rs_have(five[..], five_room[..]); cf_field(five[..], rs_paladin("Ulf", 0, 5), 10); #assert rs_aura(five[..], 0) == 0;
}
