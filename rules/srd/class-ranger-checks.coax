// The Ranger's levels 1-6 features (#13044; class-features.coax lists them), each resolved through
// the shared battle against its SRD 5.2.1 text (p. 57-61), with fixed dice (d6 3, d8 4, d20 10).
// The preset is a Hunter in Studded Leather with a Shortsword and a Longbow, Dexterity 16, Wisdom 14,
// its Fighting Style Archery and its Hunter's Prey Colossus Slayer.
//   coax/bin/coax test --library rules/srd/class-ranger-checks.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "class-features.coax";

#test "Spellcasting p.57: Wisdom, DC 8 + proficiency + Wisdom; the Ranger table's slots" {
  ones := [7] int.[0, 2, 2, 3, 3, 4, 4]; twos := [7] int.[0, 0, 0, 0, 0, 2, 2];
  for level: 1..<7 {
    c := rs_ranger("W", 0, level);
    #assert c.spell_ability == RS_WIS && c.slots_max[1] == ones[level] && c.slots_max[2] == twos[level] && c.slots_max[3] == 0;
    #assert rs_spell_dc(c) == 8 + rs_proficiency(level) + 2;
  }
}

#test "Favored Enemy p.58: Hunter's Mark always prepared, cast twice (three times from 5) without a slot; a Long Rest restores them" {
  #assert rs_ranger("W", 0, 1).uses_max[RS_USE_FREE] == 2 && rs_ranger("W", 0, 4).uses_max[RS_USE_FREE] == 2 && rs_ranger("W", 0, 5).uses_max[RS_USE_FREE] == 3;
  b: [1] RsBattle; cf_field(b[..], rs_ranger("Wren", 0, 1), 10);
  #assert rs_class_spell_granted(b[0].c[0], SP_HUNTERS_MARK) && b[0].c[0].free_spell == SP_HUNTERS_MARK;
  #assert rs_cast(b[..], 0, SP_HUNTERS_MARK, 0, 0, 0, 1) && b[0].c[0].uses[RS_USE_FREE] == 1 && b[0].c[0].slots[1] == 2 && rs_effect(b[0].c[1], EF_MARK);
  b[0].c[0].uses[RS_USE_FREE] = 0; #assert rs_long_rest_resources(b[0].c[0..<1]) && b[0].c[0].uses[RS_USE_FREE] == 2;
}

#test "Weapon Mastery p.58: two kinds, a Shortsword's Vex and a Longbow's Slow" {
  for level: 1..<7 { c := rs_ranger("W", 0, level); #assert c.mastery_n == 2 && (c.masteries & (1 << M_VEX)) != 0 && (c.masteries & (1 << M_SLOW)) != 0; }
  b: [1] RsBattle; cf_field(b[..], rs_ranger("Wren", 0, 1), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - (3 + 3) && rs_effect(b[0].c[0], EF_VEX);   // Advantage on its next attack at the foe
}

#test "Deft Explorer p.59: from level 2, Expertise in one of its skills (Survival)" {
  #assert (rs_ranger("W", 0, 1).checks.expert & (1 << SK_SURVIVAL)) == 0 && rs_ranger("W", 0, 2).checks.expert == 1 << SK_SURVIVAL && rs_has_feature(rs_ranger("W", 0, 2), RS_FT_DEFT_EXPLORER);
  for level: [2] int.[1, 2] {
    p := rs_check_plan(rs_ranger("W", 0, level), RsAbilityRequest.{ability = RS_WIS, skill = SK_SURVIVAL});
    #assert p.accepted && p.bonus == 2 + 2 + (ifx level == 2 then 2 else 0);   // Wisdom, proficiency, Expertise
  }
}

#test "Fighting Style p.59: from level 2, Archery's +2 on ranged weapon attack rolls, not melee" {
  #assert rs_weapon_attack(rs_ranger("W", 0, 1), W_LONGBOW) == 5 && rs_weapon_attack(rs_ranger("W", 0, 2), W_LONGBOW) == 7;
  #assert rs_weapon_attack(rs_ranger("W", 0, 2), W_SHORTSWORD) == 5;
}

#test "Hunter's Lore p.61: from level 3, its Hunter's Mark shows the target's Immunities, Resistances and Vulnerabilities" {
  for level: [2] int.[2, 3] {
    b: [1] RsBattle; cf_field(b[..], rs_ranger("Wren", 0, level), 10); b[0].c[1].resist = 1 << RS_COLD;
    #assert rs_cast(b[..], 0, SP_HUNTERS_MARK, 0, 0, 0, 1);
    r := rs_hunters_lore(b[..], 0, 1); #assert r.known == (level == 3) && r.resist == (ifx level == 3 then 1 << RS_COLD else 0);
  }
}

#test "Hunter's Prey p.61: Colossus Slayer, from level 3, 1d8 more on a weapon hit on a hurt creature, once a turn" {
  b: [1] RsBattle; cf_field(b[..], rs_ranger("Wren", 0, 3), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - (3 + 3 + 4);
  whole: [1] RsBattle; cf_field(whole[..], rs_ranger("Wren", 0, 3), 10); whole[0].c[1].hp = 300;
  #assert rs_attack(whole[..], 0, 1, false, -1) && whole[0].c[1].hp == 300 - 6;   // missing no Hit Points
  two: [1] RsBattle; cf_field(two[..], rs_ranger("Wren", 0, 2), 10);
  #assert rs_attack(two[..], 0, 1, false, -1) && two[0].c[1].hp == 200 - 6;
  five: [1] RsBattle; cf_field(five[..], rs_ranger("Wren", 0, 5), 10);
  #assert rs_attack(five[..], 0, 1, false, -1) && five[0].c[1].hp == 200 - (2 * (3 + 4) + 4);   // two hits, one 1d8
}

#test "Ability Score Improvement p.59: Dexterity 16 to 18 at level 4" {
  #assert rs_ranger("W", 0, 3).score[RS_DEX] == 16 && rs_ranger("W", 0, 4).score[RS_DEX] == 18 && rs_ranger("W", 0, 4).ac == 12 + 4;
}

#test "Extra Attack p.59: from level 5 the Attack action makes two attacks" {
  four: [1] RsBattle; cf_field(four[..], rs_ranger("Wren", 0, 4), 10); four[0].c[1].hp = 300;
  #assert rs_attack(four[..], 0, 1, false, -1) && four[0].c[1].hp == 300 - (3 + 4);
  five: [1] RsBattle; cf_field(five[..], rs_ranger("Wren", 0, 5), 10); five[0].c[1].hp = 300;
  #assert rs_attack(five[..], 0, 1, false, -1) && five[0].c[1].hp == 300 - (3 + 4) - (3 + 4 + 4);   // the second on a hurt foe
}

#test "Roving p.59: from level 6, Speed +10 feet out of Heavy armor, and Climb and Swim Speeds equal to it" {
  #assert rs_ranger("W", 0, 5).speed == 30 && rs_ranger("W", 0, 5).climb == 0 && rs_ranger("W", 0, 5).swim == 0;
  c := rs_ranger("W", 0, 6); #assert c.speed == 40 && c.climb == 40 && c.swim == 40;
}
