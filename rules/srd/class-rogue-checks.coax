// The Rogue's levels 1-6 features (#13044; class-features.coax lists them), each resolved through
// the shared battle against its SRD 5.2.1 text (p. 61-64; Hide p. 183), with fixed dice (d6 3,
// d20 10) so each number is read off the page. The preset is a Thief with a Shortsword (Vex) and
// Daggers (Nick), Dexterity 16 (18 from level 4).
//   coax/bin/coax test --library rules/srd/class-rogue-checks.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "class-features.coax";

// An ally of the Rogue's beside its foe, so Sneak Attack applies without Advantage.
cr_ally :: (b: [] RsBattle) -> int { k := rs_add(b, rs_fighter("Ally", 0, 1), 3, 1); return k; }

#test "Expertise p.61: double Proficiency in two trained skills at 1 (Athletics, Stealth), two more at 6" {
  c := rs_rogue("Nim", 0, 1);
  #assert rs_check_plan(c, RsAbilityRequest.{ability = RS_DEX, skill = SK_STEALTH}).bonus == 3 + 4;
  #assert rs_check_plan(c, RsAbilityRequest.{ability = RS_DEX, skill = SK_ACROBATICS}).bonus == 3 + 2;
  six := rs_rogue("Nim", 0, 6);
  #assert rs_check_plan(six, RsAbilityRequest.{ability = RS_DEX, skill = SK_ACROBATICS}).bonus == 4 + 6;
}

#test "Sneak Attack p.61: once a turn, 1d6 more with a Finesse weapon and an ally beside the foe; 2d6 at 3, 3d6 at 5" {
  for level: [3] int.[1, 3, 5] {
    b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, level), 10); _ := cr_ally(b[..]);
    dex := rs_mod(b[0].c[0].score[RS_DEX]);
    #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - (3 + dex + 3 * ((level + 1) / 2));
  }
  lone: [1] RsBattle; cf_field(lone[..], rs_rogue("Nim", 0, 1), 10);   // no ally, no Advantage
  #assert rs_attack(lone[..], 0, 1, false, -1) && lone[0].c[1].hp == 200 - 6;
}

#test "Thieves' Cant p.62 and Weapon Mastery p.62: the Cant from level 1; a Vex hit gives Advantage on its next attack at that foe" {
  #assert rs_rogue("N", 0, 1).cant && rs_rogue("N", 0, 1).mastery_n == 2;
  b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, 1), 10);
  #assert rs_attack(b[..], 0, 1, false, -1) && rs_attack_edge(b[..], 0, 1, true, false) == 1;
}

#test "Cunning Action p.62: from level 2, Dash, Disengage or Hide as a Bonus Action" {
  b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, 2), 10);
  #assert rs_cunning_dash(b[..], 0) && b[0].turn.bonus && !b[0].turn.action && b[0].turn.move_left == 6 + 6;
  d: [1] RsBattle; cf_field(d[..], rs_rogue("Nim", 0, 2), 10);
  #assert rs_disengage_use(d[..], 0, RS_DISENGAGE_CUNNING) && d[0].turn.bonus && !d[0].turn.action;
  h: [1] RsBattle; cf_field(h[..], rs_rogue("Nim", 0, 2), 10);
  r := rs_hide(h[..], 0, true, true);   // 10 + 3 + 4 (Stealth Expertise) beats DC 15
  #assert r.accepted && r.passed && r.total == 17 && h[0].turn.bonus && !h[0].turn.action && rs_has(h[0].c[0], RS_INVISIBLE);
  one: [1] RsBattle; cf_field(one[..], rs_rogue("Nim", 0, 1), 10);
  #assert !rs_cunning_dash(one[..], 0) && !rs_hide(one[..], 0, true, true).accepted && !one[0].turn.bonus;
}

#test "Hide p.183: concealed only, DC 15 Stealth; Invisible until an attack roll, a Verbal spell or a finder's Perception beats the total" {
  b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, 1), 10);
  #assert !rs_hide(b[..], 0, false, false).accepted && !b[0].turn.action;   // in plain sight
  #assert rs_hide(b[..], 0, true, false).passed && b[0].turn.action && rs_has(b[0].c[0], RS_INVISIBLE);
  #assert !rs_hide(b[..], 0, true, false).accepted;   // already hidden
  #assert !rs_find_hidden(b[..], 1, 0) && rs_has(b[0].c[0], RS_INVISIBLE);   // 10 + Wis 1 < 17
  b[0].c[1].score[RS_WIS] = 30; #assert rs_find_hidden(b[..], 1, 0) && !rs_has(b[0].c[0], RS_INVISIBLE);
  a: [1] RsBattle; cf_field(a[..], rs_rogue("Nim", 0, 1), 10);
  #assert rs_hide(a[..], 0, true, false).passed; rs_fresh(a[..], 0);
  #assert rs_attack(a[..], 0, 1, false, -1) && !rs_has(a[0].c[0], RS_INVISIBLE);
  w: [1] RsBattle; cf_field(w[..], rs_wizard("Wiz", 0, 1), 10);
  w[0].c[0].checks.skills |= 1 << SK_STEALTH; w[0].c[0].score[RS_DEX] = 20;
  #assert rs_hide(w[..], 0, true, false).passed; rs_fresh(w[..], 0);
  #assert rs_cast(w[..], 0, SP_FIRE_BOLT, 0, 0, 0, 1) && !rs_has(w[0].c[0], RS_INVISIBLE);   // V, S
  low: [1] RsBattle; cf_field(low[..], rs_rogue("Nim", 0, 1), 10); low[0].c[0].score[RS_DEX] = 1;
  #assert rs_hide(low[..], 0, true, false).accepted && !rs_has(low[0].c[0], RS_INVISIBLE);   // a failed check
}

#test "Steady Aim p.62: from level 3, a Bonus Action before moving: Advantage on its next attack, Speed 0 this turn" {
  b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, 3), 10);
  #assert rs_steady_aim(b[..], 0) && b[0].turn.move_left == 0 && rs_attack_edge(b[..], 0, 1, true, false) == 1;
  m: [1] RsBattle; cf_field(m[..], rs_rogue("Nim", 0, 3), 10); m[0].turn.moved = true;
  #assert !rs_steady_aim(m[..], 0);
  #assert !rs_rogue("N", 0, 2).steady_aim;
}

#test "Fast Hands p.64: from level 3, a Sleight of Hand check as a Bonus Action, with Thieves' Tools for a lock" {
  b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, 3), 10);
  want := 10 + rs_check_plan(b[0].c[0], RsAbilityRequest.{ability = RS_DEX, skill = SK_SLEIGHT, tool = TO_THIEVES}).bonus;
  r := rs_fast_hands(b[..], 0, 15, true);
  #assert r.accepted && r.total == want && want == 10 + 3 + 2 && b[0].turn.bonus && !b[0].turn.action;
  #assert !rs_fast_hands(b[..], 0, 15, true).accepted;   // one Bonus Action
  two: [1] RsBattle; cf_field(two[..], rs_rogue("Nim", 0, 2), 10); #assert !rs_fast_hands(two[..], 0, 15, true).accepted;
}

#test "Second-Story Work p.64: from level 3, a Climb Speed equal to its Speed" {
  #assert rs_rogue("N", 0, 2).climb == 0 && rs_rogue("N", 0, 3).climb == 30;
}

#test "Ability Score Improvement p.63: Dexterity 16 to 18 at level 4, AC 14 to 15" {
  #assert rs_rogue("N", 0, 3).score[RS_DEX] == 16 && rs_rogue("N", 0, 4).score[RS_DEX] == 18 && rs_rogue("N", 0, 4).ac == 15;
}

#test "Cunning Strike p.63: from level 5, a Sneak Attack die forgone for Trip: a Dex save against 8 + Dex + PB or Prone" {
  b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, 5), 10); _ := cr_ally(b[..]);
  b[0].c[0].strike_plan = CS_TRIP; b[0].c[1].score[RS_DEX] = 1;
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 200 - (3 + 4 + 2 * 3) && rs_has(b[0].c[1], RS_PRONE);
  w: [1] RsBattle; cf_field(w[..], rs_rogue("Nim", 0, 5), 10); _ = cr_ally(w[..]);
  w[0].c[0].strike_plan = CS_WITHDRAW;
  #assert rs_attack(w[..], 0, 1, false, -1) && w[0].turn.move_left == 6 + 3;
  four: [1] RsBattle; cf_field(four[..], rs_rogue("Nim", 0, 4), 10); _ = cr_ally(four[..]);
  four[0].c[0].strike_plan = CS_TRIP; four[0].c[1].score[RS_DEX] = 1;
  #assert rs_attack(four[..], 0, 1, false, -1) && !rs_has(four[0].c[1], RS_PRONE);
}

#test "Uncanny Dodge p.63: from level 5, its Reaction halves an attacker's damage" {
  for level: [2] int.[4, 5] {
    b: [1] RsBattle; cf_field(b[..], rs_rogue("Nim", 0, level), 10);
    b[0].c[1] = rs_barbarian("Gorr", 1, 1); b[0].c[1].x = 2; b[0].c[1].y = 1;
    b[0].c[0].hp = 100; b[0].c[0].ac = 1; rs_fresh(b[..], 1);
    #assert rs_attack(b[..], 1, 0, false, -1);
    #assert b[0].c[0].hp == 100 - (ifx level == 5 then 9 / 2 else 9) && b[0].c[0].reacted == (level == 5);
  }
}
