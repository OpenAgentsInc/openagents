// The Wizard's levels 1-6 features (#13044; class-features.coax lists them), each resolved through
// the shared battle against its SRD 5.2.1 text (p. 77-82), with fixed dice (d6 3, d10 5, d20 10).
// The preset is an Evoker with Mage Armor, Intelligence 16, a Dagger and Fire Bolt.
//   coax/bin/coax test --library rules/srd/class-wizard-checks.coax
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
#load "class-features.coax";

cw_book :: (c: RsCreature) -> int { n := 0; for key: 0..<RS_SPELL_KEYS.count { if rs_wizard_book_has(c, key) { n += 1; } } return n; }
cw_evocations :: (c: RsCreature) -> int {
  n := 0;
  for sp: 0..<RS_MORE_END { if rs_executable_spell(sp) && rs_spell(sp).level > 0 && rs_spell(sp).school == "Evocation" && rs_spell(sp).part_of < 0 && rs_wizard_book_has(c, RS_EXEC_SOURCE[sp]) { n += 1; } }
  return n;
}

#test "Spellcasting p.77: Intelligence, the Wizard table's slots, a spellbook of six level 1 spells and two more a level" #steps 400000000 {
  ones := [7] int.[0, 2, 3, 4, 4, 4, 4]; twos := [7] int.[0, 0, 0, 2, 3, 3, 3]; threes := [7] int.[0, 0, 0, 0, 0, 2, 3];
  for level: 1..<7 {
    c := rs_wizard("W", 0, level);
    #assert c.spell_ability == RS_INT && c.slots_max[1] == ones[level] && c.slots_max[2] == twos[level] && c.slots_max[3] == threes[level];
    #assert rs_spell_dc(c) == 8 + rs_proficiency(level) + rs_mod(c.score[RS_INT]);
    #assert cw_book(c) == 6 + 2 * (level - 1) + (ifx level >= 3 then 2 else 0) + (ifx level >= 5 then 1 else 0);
  }
}

#test "Ritual Adept and Arcane Recovery p.78: once a Long Rest, a Short Rest's slots totaling half its level (rounded up)" {
  #assert rs_wizard("W", 0, 1).ritual && rs_wizard("W", 0, 1).arcane_recovery;
  for level: [2] int.[1, 5] {
    c := rs_wizard("W", 0, level); #assert rs_rest_slot_budget(c, true) == (level + 1) / 2 && rs_rest_slot_budget(c, false) == 0;
  }
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; _ := rs_add(b[..], rs_wizard("Wiz", 0, 5), 1, 1);   // a spellbook Ritual, unprepared (ritual-cast.coax)
  #assert rs_spellbook_add(b[0].c[0..<1], RS_EXEC_SOURCE[SP_WATER_BREATHING]) && !rs_spell_ready(b[0].c[0], SP_WATER_BREATHING);
  rs_start_turn(b[..], 0); #assert rs_ritual_begin(b[..], 0, SP_WATER_BREATHING) && b[0].c[0].slots[3] == 2;
}

#test "Scholar p.78: from level 2, Expertise in Arcana" {
  for level: [2] int.[1, 2] {
    p := rs_check_plan(rs_wizard("W", 0, level), RsAbilityRequest.{ability = RS_INT, skill = SK_ARCANA});
    #assert p.accepted && p.bonus == 3 + 2 * (ifx level == 2 then 2 else 1) && rs_wizard("W", 0, level).scholar == (level == 2);
  }
}

#test "Evocation Savant p.82: from level 3, two Evocation spells of level 2 or lower in the book free, one more at 5" #steps 400000000 {
  #assert !rs_wizard("W", 0, 2).savant && rs_wizard("W", 0, 3).savant;
  #assert cw_book(rs_wizard("W", 0, 3)) - cw_book(rs_wizard("W", 0, 2)) == 2 + 2 && cw_book(rs_wizard("W", 0, 5)) - cw_book(rs_wizard("W", 0, 4)) == 2 + 1;
  #assert cw_evocations(rs_wizard("W", 0, 3)) >= 2 + 1;   // with Magic Missile
}

#test "Potent Cantrip p.82: from level 3, a damaging cantrip that misses deals half its damage" {
  for level: [2] int.[2, 3] {
    b: [1] RsBattle; cf_field(b[..], rs_wizard("Wiz", 0, level), 40);
    #assert rs_cast(b[..], 0, SP_FIRE_BOLT, 0, 0, 0, 1) && b[0].c[1].hp == 200 - (ifx level == 3 then 5 / 2 else 0);
  }
}

#test "Ability Score Improvement p.79: Intelligence 16 to 18 at level 4" {
  #assert rs_wizard("W", 0, 3).score[RS_INT] == 16 && rs_wizard("W", 0, 4).score[RS_INT] == 18;
}

#test "Memorize Spell p.79: from level 5, a Short Rest's swap of a prepared spell for one in the book" {
  #assert !rs_wizard("W", 0, 4).memorize && rs_wizard("W", 0, 5).memorize;
  w := rs_wizard("W", 0, 5); drop := RS_EXEC_SOURCE[SP_FALSE_LIFE]; add := RS_EXEC_SOURCE[SP_MAGIC_MISSILE];
  #assert rs_memorize_admits(w, drop, add) && !rs_memorize_admits(rs_wizard("W", 0, 4), drop, add);
}

#test "Sculpt Spells p.82: from level 6, an Evocation spares up to 1 + its level allies, who take no damage" {
  for level: [2] int.[5, 6] {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 10; b[0].dice[0].fixed = true;
    _ := rs_add(b[..], rs_wizard("Wiz", 0, level), 1, 1);
    foe := rs_add(b[..], rs_fighter("Foe", 1, 3), 8, 4); ally := rs_add(b[..], rs_fighter("Ally", 0, 3), 8, 5);
    b[0].c[foe].hp = 100; b[0].c[ally].hp = 100; b[0].c[foe].hp_max = 100; b[0].c[ally].hp_max = 100;
    rs_fresh(b[..], 0);
    #assert rs_cast(b[..], 0, SP_FIREBALL, 3, 8, 4, -1);
    #assert b[0].c[foe].hp < 100 && (b[0].c[ally].hp == 100) == (level == 6);
  }
}
