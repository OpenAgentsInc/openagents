// SRD 5.2.1 pp.105-106: unmet components refuse before costs or effects.
#load "cast-target-checks.coax";

#test "a gagged caster cannot cast Healing Word and refusal preserves every resource" {
  b: [1] RsBattle; b[0].w=12; b[0].h=8;
  a := rs_add(b[..],rs_cleric("Cleric",0,1),1,1);
  b[0].c[a].speech_blocked=true;
  rs_start_turn(b[..],a);
  slots := b[0].c[a].slots[1]; rolls := b[0].dice[0].rolled; seq := b[0].book[0].seq;
  #assert !rs_cast(b[..],a,SP_HEALING_WORD,1,0,0,a);
  #assert !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent;
  #assert b[0].c[a].slots[1]==slots && b[0].dice[0].rolled==rolls && b[0].book[0].seq==seq;
}

#test "a focus cannot replace a priced Holy Symbol and reusable exact materials survive accepted casts" {
  b: [1] RsBattle; b[0].w=12; b[0].h=8;
  a := rs_add(b[..],rs_cleric("Cleric",0,3),1,1);
  b[0].c[a].materials[0].count=0; b[0].c[a].component_pouch=true;
  rs_start_turn(b[..],a); slots := b[0].c[a].slots[1]; seq := b[0].book[0].seq;
  #assert !rs_cast(b[..],a,SP_BLESS,1,0,0,a) && b[0].c[a].slots[1]==slots && b[0].book[0].seq==seq;
  b[0].c[a].materials[0].count=1;
  #assert rs_cast(b[..],a,SP_BLESS,1,0,0,a) && b[0].c[a].materials[0].count==1;
  rs_end_turn(b[..],a); rs_start_turn(b[..],a);
  #assert rs_cast(b[..],a,SP_BLESS,1,0,0,a) && b[0].c[a].materials[0].count==1;
}

#test "V-only casting works with full hands while a held focus cannot satisfy Shield's S-only hand requirement" {
  b: [1] RsBattle; b[0].w=12; b[0].h=8;
  a := rs_add(b[..],rs_cleric("Cleric",0,1),1,1);
  b[0].c[a].gesture_hand=false; b[0].c[a].material_hand=false; b[0].c[a].focus_held=false; b[0].c[a].hp=1;
  rs_start_turn(b[..],a); #assert rs_cast(b[..],a,SP_HEALING_WORD,1,0,0,a) && b[0].c[a].hp>1;
  s := rs_add(b[..],rs_sorcerer("Sorcerer",1,3),2,1);
  selected := [1] int.[RS_EXEC_SOURCE[SP_SHIELD]]; #assert rs_set_spells(b[0].c[s..<s+1],selected[..]); b[0].c[s].feats = rs_feature_put(b[0].c[s].feats, RS_FT_SHIELD_SPELL, true);
  b[0].c[s].gesture_hand=false; b[0].c[s].focus_held=true;
  slots := b[0].c[s].slots[1]; seq := b[0].book[0].seq;
  #assert !rs_shield(b[..],s) && b[0].c[s].slots[1]==slots && !b[0].c[s].reacted && b[0].book[0].seq==seq;
  b[0].c[s].gesture_hand=true; #assert rs_shield(b[..],s);
}

#test "canonical consumed requirements pay exact stock once and refuse when empty without pouch substitution" {
  key := -1;
  for k: 0..<RS_SPELL_KEYS.count { if RS_SPELL_KEYS[k].id=="revivify" { key=k; } }
  #assert key>=0;
  mask := RS_SPELL_KEYS[key].component_mask; #assert mask==31;
  c: [1] RsCreature; c[0].component_pouch=true; c[0].focus_held=true;
  c[0].materials[7]=RsMaterialStock.{key=key,count=2};
  #assert rs_components_pay(c[..],mask,key,true) && c[0].materials[7].count==1;
  #assert rs_components_pay(c[..],mask,key,true) && c[0].materials[7].count==0;
  #assert !rs_components_pay(c[..],mask,key,true) && c[0].materials[7].count==0;
}

#test "class feature spells authorize their class focus while a world extra-list grant does not" {
  c: [1] RsCreature; c[0]=rs_druid("Druid",0,6);
  #assert rs_grant_spell(c[..],SP_FIREBALL) && !rs_component_focus(c[0],SP_FIREBALL);
  #assert !rs_cast_components_ready(c[0],SP_FIREBALL);
  c[0].component_pouch=true; #assert rs_cast_components_ready(c[0],SP_FIREBALL);
  w := rs_warlock("Warlock",0,6,SP_ELDRITCH_BLAST); #assert rs_component_focus(w,SP_FIREBALL);
  l := rs_bard("Bard",0,6); #assert rs_component_focus(l,SP_FIREBALL);
  w.feats = rs_feature_put(w.feats, RS_FT_FIENDISH_VIGOR, true); #assert rs_component_focus(w,SP_FALSE_LIFE);
  w.feats = rs_feature_put(w.feats, RS_FT_FIENDISH_VIGOR, false); #assert !rs_component_focus(w,SP_FALSE_LIFE);
}

#test "component identity rejects holes and aliases operational helpers without recasting their parent" {
  #assert RS_SPELL_KEYS[rs_component_key(0)].id=="produce-flame";
  c: [1] RsCreature; c[0]=rs_druid("Druid",0,3); c[0].speech_blocked=true; c[0].gesture_hand=false; c[0].material_hand=false; c[0].focus_held=false;
  #assert !rs_cast_components_ready(c[0],SP_PRODUCE_FLAME);
  #assert rs_component_mask(1)==0 && rs_cast_components_ready(c[0],1);
  for sp: [6] int.[-1,RS_MORE_END,99,104,105,1000] {
    #assert rs_component_key(sp)==-1 && rs_component_mask(sp)==-1 && !rs_cast_components_ready(c[0],sp);
    #assert !rs_cast_components_pay(c[..],sp);
  }
  for sp: 100..<104 { #assert rs_component_mask(sp)==0 && rs_component_key(sp)==-1 && !rs_component_focus(c[0],sp) && rs_cast_components_ready(c[0],sp); }
  #assert !rs_component_focus(c[0],-1);
  b: [1] RsBattle; #assert !rs_cast_reaction_slot(b[..],-1,SP_SHIELD,1,true) && !rs_cast_reaction_slot(b[..],0,SP_SHIELD,1,true);
}

#test "component payment addresses exactly the requested actor and refuses invalid spans" {
  c: [2] RsCreature; c[0].speech_blocked=true;
  #assert !rs_cast_components_pay_at(c[..],SP_HEALING_WORD,0) && rs_cast_components_pay_at(c[..],SP_HEALING_WORD,1);
  for actor: [3] int.[-1,2,3] {
    #assert !rs_cast_components_pay_at(c[..],SP_HEALING_WORD,actor);
    #assert !rs_components_pay_at(c[..],actor,0,-1,false);
  }
  #assert !rs_cast_components_pay_at(c[0..<0],SP_HEALING_WORD,0);
  c[1].materials[0]=RsMaterialStock.{key=0,count=2};
  #assert rs_components_pay_at(c[..],1,28,0,false) && c[1].materials[0].count==1 && c[0].materials[0].count==0;
}
