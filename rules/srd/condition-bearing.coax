// SRD 5.2.1 conditions as a body's bearing (aethyr/action/deed.coax, docs/verse/action-pipeline.md,
// GitHub #13072): one pose for the body, one set of locks for the input and the bar, so a creature at
// 0 Hit Points lies down, moves nothing and casts nothing, all at once, in every realm. Its loader
// loads the SRD engine (engine.coax or battle.coax) first. The checks are
// condition-bearing-checks.coax.
//
//   SRD 5.2.1 pp.177-191 (the conditions), p.182 Grappled, p.183 Incapacitated, p.185 Prone,
//   p.186 Restrained, p.187 Stunned, p.188 Unconscious; Command's Halt (p.130) and Hypnotic
//   Pattern's stupor (p.135) as the rules hold them (command-halt.coax, engine.coax EF_DAZED).
#load "../../aethyr/action/deed.coax";

// A body with hp Hit Points, dead or not, conditions `cond` (RS_* bits), under Command's Halt
// (halted) or Hypnotic Pattern's stupor (dazed). This is what a page that sees only a room's row
// (its hit points and condition bits) uses; rs_bearing is the creature's own.
rs_bearing_of :: (hp: int, dead: bool, cond: int, halted: bool, dazed: bool) -> DeedBearing {
  b: DeedBearing;
  if dead || hp <= 0 || (cond & RS_UNCONSCIOUS) != 0 { b = deed_bear(b, DeedPose.down, DEED_LOCK_ALL); }
  if (cond & (RS_PARALYZED | RS_PETRIFIED)) != 0 { b = deed_bear(b, DeedPose.still, DEED_LOCK_ALL); }
  if (cond & (RS_STUNNED | RS_INCAPACITATED)) != 0 { b = deed_bear(b, DeedPose.reel, DEED_LOCK_ACT | DEED_LOCK_REACT | DEED_LOCK_SPEAK); }
  if dazed { b = deed_bear(b, DeedPose.reel, DEED_LOCK_MOVE); }   // Speed 0; its Incapacitated comes as the condition bit
  if (cond & (RS_GRAPPLED | RS_RESTRAINED)) != 0 { b = deed_bear(b, DeedPose.held, DEED_LOCK_MOVE); }
  if (cond & RS_PRONE) != 0 { b = deed_bear(b, DeedPose.prone, 0); b.crawl = true; }
  if (cond & RS_FRIGHTENED) != 0 { b = deed_bear(b, DeedPose.cower, 0); }
  if halted { b = deed_bear(b, DeedPose.stand, DEED_LOCK_MOVE | DEED_LOCK_ACT); }
  return b;
}
// Creature c's bearing. Its locks agree with the rules' own rs_can_act and rs_can_move.
rs_bearing :: (c: RsCreature) -> DeedBearing {
  halted := false; dazed := false;
  for k: 0..<RS_EFFECTS { if c.eff[k].kind == EF_HALT { halted = true; } if c.eff[k].kind == EF_DAZED { dazed = true; } }
  b := rs_bearing_of(c.hp, c.dead, c.cond, halted, dazed);
  if !rs_can_act(c) { b.lock |= DEED_LOCK_ACT; }
  if !rs_can_move(c) { b.lock |= DEED_LOCK_MOVE; }
  return b;
}
