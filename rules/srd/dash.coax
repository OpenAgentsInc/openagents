// SRD 5.2.1 p.180 Dash, p.51 Step of the Wind, p.62 Cunning Action.
#authority;
RS_DASH_ACTION :: 0;
RS_DASH_CUNNING :: 1;
RS_DASH_WIND :: 2;

rs_dash_speed :: (b: [] RsBattle, i: int) -> int #effects(all) {
  if b[0].turn.anchored || rs_has(b[0].c[i],RS_GRAPPLED|RS_RESTRAINED|RS_PARALYZED|RS_PETRIFIED|RS_UNCONSCIOUS) { return 0; }
  for e: b[0].c[i].eff { if e.kind==EF_DAZED { return 0; } }
  return rs_walk_speed(b,i);
}
rs_dash_use :: (b: [] RsBattle, i: int, mode: int) -> bool #effects(all) {
  if i<0 || i>=b[0].n || b[0].who!=i || !rs_can_act(b[0].c[i]) { return false; }
  if mode==RS_DASH_ACTION {
    if b[0].turn.action { return false; }
    b[0].turn.action=true;
  } else {
    if b[0].turn.bonus { return false; }
    if mode==RS_DASH_CUNNING { if !rs_has_feature(b[0].c[i], RS_FT_CUNNING_ACTION) { return false; } }
    else if mode==RS_DASH_WIND { if b[0].c[i].uses_max[RS_USE_FOCUS]<=0 { return false; } }
    else { return false; }
    b[0].turn.bonus=true;
  }
  rs_rest_interrupt_at(b[0].c,i);
  t: [1] RsTurn; t[0]=b[0].turn;
  rs_reprice_movement(t[..],rs_movement_allowance(b,i));
  b[0].turn=t[0]; b[0].turn.dash_n+=1;
  t[0]=b[0].turn;
  rs_reprice_movement(t[..],rs_movement_allowance(b,i)); b[0].turn=t[0];
  if mode==RS_DASH_CUNNING { rs_quiet_ft(b,i,RS_FT_CUNNING_DASH); }
  if mode==RS_DASH_WIND { rs_quiet_ft(b,i,RS_FT_STEP_OF_THE_WIND); }
  return true;
}

#test "Dash rejects unknown modes before spending and leaves its zero-Speed helper observational" {
  b: [1] RsBattle; b[0].w=8; b[0].h=8;
  _ := rs_add(b[..],rs_rogue("Runner",0,3),1,1); rs_start_turn(b[..],0);
  for mode: [3] int.[-1,3,4] {
    #assert !rs_dash_use(b[..],0,mode) && !b[0].turn.action && !b[0].turn.bonus && b[0].turn.move_left==6;
  }
  b[0].c[0].eff[0].kind=EF_DAZED;
  #assert rs_dash_speed(b[..],0)==0;
  b[0].c[0].eff[0].kind=EF_NONE;
  #assert rs_dash_speed(b[..],0)==30;
}
