// SRD 5.2.1 pp.182-183 Help. The source's two benefits use actual next rolls
// and the helper's next turn, not an approximate clock deadline.
#load "ability-check-tests.coax";
#load "stabilization-checks.coax";

#test "the next allied attack consumes a retained Help distraction and receives Advantage" {
  b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
  #assert rs_put_effect(b[..],2,RsEffect.{kind=EF_HELP_ATTACK,by=0,spell=-1,save=-1});
  #assert rs_attack_edge(b[..],1,2,true,true)==1;
  #assert c[2].eff[0].kind==EF_NONE && rs_attack_edge(b[..],1,2,true,true)==0;
}

#test "Help selects each actual skill or tool proficiency without granting a second proficiency bonus" {
  for choice: 0..<55 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
    c[0].checks.skills=0; c[0].checks.tools=0; c[1].checks.skills=0; c[1].checks.tools=0;
    q: RsHelpRequest; q.possible=true;
    roll:=RsAbilityRequest.{ability=RS_INT,dc=10};
    if choice<18 { q.skill=choice; c[0].checks.skills=1<<choice; roll.skill=choice; }
    else { q.tool=choice-18; c[0].checks.tools=rs_tool_bit(choice-18); roll.tool=choice-18; }
    #assert rs_help_ability(b[..],0,1,q) && b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent;
    e:=c[1].eff[0];
    #assert e.kind==EF_HELP_CHECK && e.cond==choice && e.by==0 && e.spell == -1 && e.save == -1;
    #assert c[0].cond==0 && c[1].cond==0 && b[0].dice[0].rolled==0;
    r:=rs_ability_check(b[..],1,roll);
    #assert r.accepted && r.passed && r.edge==1 && r.total==10 && b[0].dice[0].rolled==2;
    #assert c[1].eff[0].kind==EF_NONE;
  }
}

#test "Help skill selection refuses malformed choices absent training and impossible assistance transactionally" {
  for mode: 0..<11 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
    q:=RsHelpRequest.{skill=SK_ATHLETICS,possible=true};
    if mode==0 { q.skill = -2; } else if mode==1 { q.skill=18; c[0].checks.skills=1<<18; }
    else if mode==2 { q.tool=TO_THIEVES; }
    else if mode==3 { q.skill = -1; } else if mode==4 { c[0].checks.skills=0; }
    else if mode==5 { q.possible=false; }
    else { q.skill = -1; q.tool=TO_THIEVES; c[0].checks.tools=rs_tool_bit(TO_THIEVES);
      if mode==6 { q.tool = -2; } else if mode==7 { q.tool=37; c[0].checks.tools=rs_tool_bit(37); }
      else if mode==8 { c[0].checks.tools=0; } else if mode==9 { q.skill=SK_ATHLETICS; }
      else { q.possible=false; }
    }
    #assert !rs_help_ability(b[..],0,1,q) && !b[0].turn.action && !b[0].turn.bonus && !b[0].turn.slot_spent;
    #assert b[0].dice[0].rolled==0 && b[0].book[0].seq==0 && rs_effect_free(c[1])==RS_EFFECTS;
  }
}

#test "both Help actions refuse invalid logical actors wrong turns incapacity self and dead targets" {
  for kind: 0..<2 { for mode: 0..<11 {
    b: [1] RsBattle; c: [4] RsCreature; hl_field(b[..],c[..]); b[0].n=3;
    i:=0; j:=ifx kind==0 then 1 else 2;
    if mode==0 { i = -1; b[0].who = -1; } else if mode==1 { i=3; b[0].who=3; }
    else if mode==2 { j = -1; } else if mode==3 { j=3; }
    else if mode==4 { b[0].who=1; } else if mode==5 { b[0].turn.action=true; }
    else if mode==6 { c[0].cond=RS_STUNNED; } else if mode==7 { j=i; }
    else if mode==8 { c[j].dead=true; } else if mode==9 { c[j].team=ifx kind==0 then 1 else 0; }
    else { c[0].hp=0; }
    before:=b[0].turn.action;
    ok:=ifx kind==0 then rs_help_ability(b[..],i,j,RsHelpRequest.{skill=SK_ATHLETICS,possible=true}) else rs_help_attack(b[..],i,j,true);
    #assert !ok && b[0].turn.action==before && !b[0].turn.bonus && !b[0].turn.slot_spent;
    #assert b[0].dice[0].rolled==0 && b[0].book[0].seq==0;
    for actor: 0..<3 { #assert rs_effect_free(c[actor])==RS_EFFECTS; }
  } }
}

#test "full recipient storage refuses either Help action before spending or losing an existing owner" {
  for kind: 0..<2 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]); j:=ifx kind==0 then 1 else 2;
    for k: 0..<RS_EFFECTS { #assert rs_put_effect(b[..],j,RsEffect.{kind=EF_HEX,by=k,spell=SP_HEX,until=60,cond=RS_CHA,save=-1}); }
    saved:=c[j].eff;
    ok:=ifx kind==0 then rs_help_ability(b[..],0,j,RsHelpRequest.{skill=SK_ATHLETICS,possible=true}) else rs_help_attack(b[..],0,j,true);
    #assert !ok && !b[0].turn.action && b[0].book[0].seq==0 && b[0].dice[0].rolled==0;
    for k: 0..<RS_EFFECTS { #assert c[j].eff[k].kind==saved[k].kind && c[j].eff[k].by==k && c[j].eff[k].spell==SP_HEX; }
  }
}

#test "a Help distraction needs an enemy within five feet and a possible distraction" {
  for mode: 0..<4 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
    c[2].x=ifx mode==0 then 1 else ifx mode==1 then 2 else 3;
    if mode==3 { c[2].x=2; }
    ok:=rs_help_attack(b[..],0,2,mode!=3);
    #assert ok==(mode<2) && b[0].turn.action==(mode<2) && (c[2].eff[0].kind==EF_HELP_ATTACK)==(mode<2);
    #assert b[0].dice[0].rolled==0;
  }
}

#test "Help events retain the helper recipient selection and action identity without imposing conditions" {
  for mode: 0..<2 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
    if mode==0 { #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true}); }
    else { #assert rs_help_attack(b[..],0,2,true); }
    e:=rs_recent_at(b[0].book[..],0);
    #assert e.kind==RS_EV_CONDITION && e.spell == -1 && e.by==0 && e.to==mode+1 && e.damage==0 && e.feat==RS_FT_NONE;
    #assert e.amount==(ifx mode==0 then SK_ATHLETICS else 0);
    #assert cast(string)e.text[0..<e.text_n]==(ifx mode==0 then "Helper helps Helper with an ability check" else "Helper distracts Helper to help an ally attack");
    #assert c[mode+1].cond==0;
  }
}

#test "Help matches its selected skill or tool and is consumed even on a failed or canceled check" {
  for choice: 0..<2 { for mode: 0..<3 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]); c[0].checks.tools=rs_tool_bit(TO_WEAVER);
    h:=RsHelpRequest.{possible=true};
    if choice==0 { h.skill=SK_ATHLETICS; } else { h.tool=TO_WEAVER; }
    #assert rs_help_ability(b[..],0,1,h);
    q:=RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,tool=TO_WEAVER,dc=100,disadvantage=mode!=0};
    if mode==2 { c[1].raging=true; }
    r:=rs_ability_check(b[..],1,q);
    #assert r.accepted && !r.passed && r.edge==(ifx mode==0 then 1 else 0);
    #assert c[1].eff[0].kind==EF_NONE && b[0].dice[0].rolled==(ifx mode==0 then 2 else 1);
  } }
}

#test "unrelated checks passive scores and malformed requests preserve a held Help benefit" {
  b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
  c[0].checks.skills|=1<<SK_PERCEPTION;
  #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_PERCEPTION,possible=true});
  r:=rs_passive_perception(b[..],1,RsAbilityRequest.{ability=RS_WIS,skill=SK_PERCEPTION,dc=12});
  #assert r.accepted && r.edge==0 && r.total==12 && c[1].eff[0].kind==EF_HELP_CHECK && b[0].dice[0].rolled==0;
  r=rs_ability_check(b[..],1,RsAbilityRequest.{ability=6,skill=SK_PERCEPTION,dc=10});
  #assert !r.accepted && c[1].eff[0].kind==EF_HELP_CHECK && b[0].dice[0].rolled==0;
  r=rs_ability_check(b[..],1,RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,dc=10});
  #assert r.edge==0;
  #assert c[1].eff[0].kind==EF_HELP_CHECK;
  #assert b[0].dice[0].rolled==1;
  r=rs_ability_check(b[..],1,RsAbilityRequest.{ability=RS_WIS,skill=SK_PERCEPTION,dc=12});
  #assert r.edge==1 && r.passed && c[1].eff[0].kind==EF_NONE && b[0].dice[0].rolled==3;
}

#test "an accepted automatically failed check consumes matching Help without dice or optional rescue spending" {
  b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
  #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
  c[1].cond=RS_BLINDED; c[1].inspired=6; c[1].tactical=true; c[1].uses[RS_USE_WIND]=1;
  r:=rs_ability_check(b[..],1,RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,dc=10,sight=true});
  #assert r.accepted && r.automatic && !r.passed && c[1].eff[0].kind==EF_NONE;
  #assert b[0].dice[0].rolled==0 && c[1].inspired==6 && c[1].uses[RS_USE_WIND]==1;
}

#test "all matching Help owners are consumed by one check while another skill remains pending" {
  b: [1] RsBattle; c: [4] RsCreature; hl_field(b[..],c[..]);
  #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
  b[0].who=3; b[0].turn.action=false;
  #assert rs_help_ability(b[..],3,1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
  b[0].turn.action=false;
  #assert rs_help_ability(b[..],3,1,RsHelpRequest.{skill=SK_PERCEPTION,possible=true});
  r:=rs_ability_check(b[..],1,RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,dc=12});
  #assert r.passed && r.edge==1 && c[1].eff[0].kind==EF_NONE && c[1].eff[1].kind==EF_NONE && c[1].eff[2].kind==EF_HELP_CHECK;
  #assert b[0].dice[0].rolled==2;
}

#test "attack Help benefits only another ally of its helper and consumes every qualifying distraction" {
  b: [1] RsBattle; c: [4] RsCreature; hl_field(b[..],c[..]);
  #assert rs_help_attack(b[..],0,2,true);
  #assert rs_attack_edge(b[..],0,2,true,true)==0 && c[2].eff[0].kind==EF_HELP_ATTACK;
  c[3].team=1;
  #assert rs_attack_edge(b[..],3,2,true,true)==0 && c[2].eff[0].kind==EF_HELP_ATTACK;
  c[3].team=0; b[0].who=3; b[0].turn.action=false;
  #assert rs_help_attack(b[..],3,2,true);
  c[1].cond=RS_POISONED;
  #assert rs_attack_edge(b[..],1,2,true,true)==0;
  #assert c[2].eff[0].kind==EF_NONE && c[2].eff[1].kind==EF_NONE;
}

#test "Help expires only at its helpers actual next turn and preserves other owners and unrelated effects" {
  b: [1] RsBattle; c: [4] RsCreature; hl_field(b[..],c[..]);
  #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
  b[0].turn.action=false; #assert rs_help_attack(b[..],0,2,true);
  b[0].who=3; b[0].turn.action=false;
  #assert rs_help_ability(b[..],3,1,RsHelpRequest.{skill=SK_PERCEPTION,possible=true});
  #assert rs_put_effect(b[..],1,RsEffect.{kind=EF_HEX,by=0,spell=SP_HEX,until=rs_secs(1000),cond=RS_CHA,save=-1});
  rs_tick(b[..],100);
  #assert c[1].eff[0].kind==EF_HELP_CHECK && c[1].eff[1].kind==EF_HELP_CHECK && c[2].eff[0].kind==EF_HELP_ATTACK;
  rs_start_turn(b[..],1);
  #assert c[1].eff[0].kind==EF_HELP_CHECK && c[2].eff[0].kind==EF_HELP_ATTACK;
  rs_start_turn(b[..],0);
  #assert c[1].eff[0].kind==EF_NONE && c[2].eff[0].kind==EF_NONE && c[1].eff[1].kind==EF_HELP_CHECK && c[1].eff[2].kind==EF_HEX;
  rs_start_turn(b[..],3); #assert c[1].eff[1].kind==EF_NONE && c[1].eff[2].kind==EF_HEX;
}

#test "Help admits a recipient at index zero and can distract an enemy there" {
  for kind: 0..<2 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]); b[0].who=1;
    if kind==0 { #assert rs_help_ability(b[..],1,0,RsHelpRequest.{skill=SK_ATHLETICS,possible=true}); }
    else { c[0].team=1; #assert rs_help_attack(b[..],1,0,true); }
    #assert b[0].turn.action && c[0].eff[0].by==1 && c[0].eff[0].kind==(ifx kind==0 then EF_HELP_CHECK else EF_HELP_ATTACK);
    rs_help_start_turn(b[..],1); #assert c[0].eff[0].kind==EF_NONE;
  }
}

#test "check assistance accounts for each helpers current capability and unavailable task context" {
  for mode: 0..<5 {
    b: [1] RsBattle; c: [4] RsCreature; hl_field(b[..],c[..]);
    #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
    b[0].who=3; b[0].turn.action=false;
    #assert rs_help_ability(b[..],3,1,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
    blocked: [2] int=[2] int.[0,3];
    q:=RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,dc=12};
    if mode==0 { c[0].cond=RS_UNCONSCIOUS; c[3].cond=RS_STUNNED; }
    else if mode==1 { q.help_blocked=blocked[..]; }
    else if mode==2 { q.help_blocked=blocked[0..<1]; }
    else if mode==3 { c[0].dead=true; }
    else { q.help_blocked=blocked[1..<2]; }
    r:=rs_ability_check(b[..],1,q);
    #assert r.accepted && r.passed && r.edge==(ifx mode<2 then 0 else 1);
    #assert b[0].dice[0].rolled==(ifx mode<2 then 1 else 2) && c[1].eff[0].kind==EF_NONE && c[1].eff[1].kind==EF_NONE;
  }
}

#test "unknown Help owners cannot supply Advantage and tool-minus-one cannot alias Survival" {
  for owner: [2] int.[-1,3] {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
    #assert rs_put_effect(b[..],1,RsEffect.{kind=EF_HELP_CHECK,by=owner,cond=SK_ATHLETICS,spell=-1,save=-1});
    #assert rs_put_effect(b[..],2,RsEffect.{kind=EF_HELP_ATTACK,by=owner,spell=-1,save=-1});
    r:=rs_ability_check(b[..],1,RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,dc=12});
    #assert r.edge==0 && c[1].eff[0].kind==EF_NONE;
    #assert rs_attack_edge(b[..],1,2,true,true)==0 && c[2].eff[0].kind==EF_HELP_ATTACK;
  }
  b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]); c[0].checks.skills|=1<<SK_SURVIVAL;
  #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_SURVIVAL,possible=true});
  r:=rs_ability_check(b[..],1,RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,dc=12});
  #assert r.edge==0 && c[1].eff[0].kind==EF_HELP_CHECK;
}

#test "a remote ally consumes a distraction on its first actual missed ranged attack even when edges cancel" {
  b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
  #assert rs_help_attack(b[..],0,2,true);
  // The helper can move away after distracting; the attacker need not be nearby.
  c[0].x=9; c[1].x=9; c[1].ranged=W_SHORTBOW; c[1].cond=RS_POISONED; c[2].ac=30;
  b[0].who=1; b[0].turn=RsTurn.{}; rolls:=b[0].dice[0].rolled;
  #assert rs_shoot(b[..],1,2);
  #assert b[0].turn.action && c[2].eff[0].kind==EF_NONE && b[0].dice[0].rolled==rolls+1;
  e:=rs_recent_at(b[0].book[..],0); #assert e.kind==RS_EV_MISS && e.to==2;
}

#test "Help applies to an actual Medicine first-aid check with current assistance facts" {
  for blocked: 0..<2 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]); c[0].checks.skills|=1<<SK_MEDICINE;
    #assert rs_help_ability(b[..],0,1,RsHelpRequest.{skill=SK_MEDICINE,possible=true});
    c[2].hp=0; c[2].cond=RS_UNCONSCIOUS|RS_PRONE; b[0].who=1; b[0].turn=RsTurn.{};
    q:=RsFirstAidContext.{contact=true}; unavailable: [1] int=[1] int.[0];
    if blocked==1 { q.help_blocked=unavailable[..]; }
    r:=rs_first_aid(b[..],1,2,q);
    #assert r.accepted && r.passed && r.edge==1-blocked && c[2].stable && c[1].eff[0].kind==EF_NONE;
    #assert b[0].dice[0].rolled==3-blocked && b[0].turn.action;
  }
}

#test "Help refuses a recipient beyond physical storage before reading its team or life" {
  b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
  #assert !rs_help_ability(b[..],0,3,RsHelpRequest.{skill=SK_ATHLETICS,possible=true});
  #assert !rs_help_attack(b[..],0,3,true) && !b[0].turn.action && b[0].book[0].seq==0;
}

#test "Help distraction uses one five-foot grid square including every diagonal and refuses two squares on either axis" {
  for dx: -2..<3 { for dy: -2..<3 {
    b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
    c[0].x=4; c[0].y=4; c[2].x=4+dx; c[2].y=4+dy;
    expected:=dx>=-1 && dx<=1 && dy>=-1 && dy<=1;
    #assert rs_help_attack(b[..],0,2,true)==expected && b[0].turn.action==expected;
  } }
}

#test "a legal spell attack consumes Help while a refused cast and a saving throw preserve the distraction" {
  b: [1] RsBattle; c: [3] RsCreature; hl_field(b[..],c[..]);
  #assert rs_help_attack(b[..],0,2,true);
  c[1]=rs_wizard("Wizard",0,3); c[1].x=6; c[1].y=1;
  b[0].who=1; b[0].turn=RsTurn.{};
  #assert !rs_cast(b[..],1,SP_FIRE_BOLT,1,0,0,2) && c[2].eff[0].kind==EF_HELP_ATTACK && b[0].dice[0].rolled==0;
  _ := rs_saving_throw(b[..],2,RS_CON,10);
  #assert c[2].eff[0].kind==EF_HELP_ATTACK && b[0].dice[0].rolled==1;
  #assert rs_cast(b[..],1,SP_FIRE_BOLT,0,0,0,2);
  #assert c[2].eff[0].kind==EF_NONE;
  #assert b[0].dice[0].rolled==4;
  #assert c[2].hp==95;
}

hl_field :: (b: [] RsBattle, c: [] RsCreature) {
  b[0].c=c; b[0].n=c.count; b[0].w=10; b[0].h=10; b[0].who=0; b[0].dice[0].fixed=true;
  for i: 0..<c.count {
    c[i]=RsCreature.{}; c[i].level=3; c[i].speed=30; c[i].weapon=W_LONGSWORD;
    c[i].conc = -1; c[i].restrained_by = -1; c[i].outlined_by = -1;
    c[i].checks.skills=(1<<SK_ATHLETICS)|(1<<SK_PERCEPTION);
    c[i].score=[6] int.[10,10,10,10,10,10]; rs_set_name(c[i..<i+1],"Helper");
    c[i].x=1; c[i].y=1; c[i].ac=10; c[i].hp=100; c[i].hp_max=100;
  }
  c[2].team=1; c[2].x=2;
}
