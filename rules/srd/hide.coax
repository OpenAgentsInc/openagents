// The Hide action (Rules Glossary p. 183) and the Rogue's Bonus Action uses of it and of Sleight of
// Hand (Cunning Action p. 62, Fast Hands p. 64). Whether the creature is Heavily Obscured or behind
// Three-Quarters or Total Cover and out of every enemy's line of sight is the world's admitted fact
// (`concealed`); the battle has no cover geometry of its own. A success is the Invisible condition,
// held as an effect whose `dc` is the check's total (the DC to find it), ended by an attack roll,
// a spell with a Verbal component, or being found.
//   coax/bin/coax test --library rules/srd/class-rogue-checks.coax
#authority;

RS_HIDE_SPELL :: -3;   // the effect's spell field: hidden, not a spell's Invisible
RS_HIDE_DC :: 15;

// The hidden effect on c, or -1.
rs_hidden_at :: (c: RsCreature) -> int #effects(all) {
  for k: 0..<RS_EFFECTS { e := c.eff[k]; if e.kind == EF_COND && e.spell == RS_HIDE_SPELL { return k; } }
  return -1;
}
// The acting creature hides with its action, or its Bonus Action through Cunning Action (`bonus`).
// Refused, with nothing spent, when it isn't concealed, the action is spent, it is already hidden
// or it has no room for the effect.
rs_hide :: (b: [] RsBattle, i: int, concealed: bool, bonus: bool) -> RsAbilityResult #effects(all) {
  r: RsAbilityResult;
  if b[0].who != i || !concealed || !rs_can_act(b[0].c[i]) || rs_hidden_at(b[0].c[i]) >= 0 || rs_effect_free(b[0].c[i]) == 0 { return r; }
  if ifx bonus then !b[0].c[i].cunning || b[0].turn.bonus else b[0].turn.action { return r; }
  if bonus { b[0].turn.bonus = true; } else { b[0].turn.action = true; }
  r = rs_ability_check(b, i, RsAbilityRequest.{ability = RS_DEX, skill = SK_STEALTH, dc = RS_HIDE_DC});
  if r.passed { _ := rs_put_effect(b, i, RsEffect.{kind = EF_COND, cond = RS_INVISIBLE, by = i, spell = RS_HIDE_SPELL, until = 1e9, save = -1, dc = r.total}); }
  return r;
}
// i stops being hidden (it made an attack roll, cast a spell with a Verbal component or was found).
rs_unhide :: (b: [] RsBattle, i: int) #effects(all) {
  k := rs_hidden_at(b[0].c[i]);
  if k >= 0 { rs_drop_effect(b, i, k); }
}
// A searcher j looks for hidden i: a Wisdom (Perception) check against its Hide total. A success
// ends the hiding.
rs_find_hidden :: (b: [] RsBattle, j: int, i: int) -> bool #effects(all) {
  k := rs_hidden_at(b[0].c[i]);
  if k < 0 || i == j { return false; }
  r := rs_ability_check(b, j, RsAbilityRequest.{ability = RS_WIS, skill = SK_PERCEPTION, dc = b[0].c[i].eff[k].dc});
  if r.passed { rs_unhide(b, i); }
  return r.passed;
}
// Fast Hands (p. 64): from level 3, a Sleight of Hand check (a lock, a trap with Thieves' Tools, a
// pocket) as a Bonus Action, against `dc`; `tools`: with Thieves' Tools (a lock or a trap).
rs_fast_hands :: (b: [] RsBattle, i: int, dc: int, tools: bool) -> RsAbilityResult #effects(all) {
  r: RsAbilityResult;
  if b[0].who != i || !b[0].c[i].fast_hands || b[0].turn.bonus || !rs_can_act(b[0].c[i]) { return r; }
  b[0].turn.bonus = true;
  q := RsAbilityRequest.{ability = RS_DEX, skill = SK_SLEIGHT, dc = dc};
  if tools { q.tool = TO_THIEVES; }
  return rs_ability_check(b, i, q);
}

// Each check seats a level 3 Rogue at (1,1), its Stealth 10 + Dexterity + 2 (no Expertise), beside
// a Wizard, its turn begun, with fixed dice (d20 10).
#test "Hide admits only the acting, concealed, capable, unhidden creature with its action or Cunning Action free" {
  for mode: 0..<12 {
    b: [1] RsBattle; b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; _ := rs_add(b[..], rs_rogue("Nim", 0, 3), 1, 1); _ = rs_add(b[..], rs_wizard("Seeker", 1, 1), 2, 1); b[0].c[0].score[RS_DEX] = 6; b[0].c[0].checks.expert = 0; rs_fresh(b[..], 0);   // 10 - 2 + 2: fails DC 15, but the attempt still spends
    concealed := mode != 1; bonus := mode >= 6;
    if mode == 2 { b[0].who = 1; } else if mode == 3 { b[0].c[0].cond = RS_STUNNED; }
    else if mode == 4 { b[0].turn.action = true; } else if mode == 5 { for k: 0..<RS_EFFECTS { b[0].c[0].eff[k].kind = EF_BLESS; } }
    else if mode == 7 { b[0].c[0].cunning = false; } else if mode == 8 { b[0].turn.bonus = true; }
    else if mode == 9 { b[0].turn.action = true; } else if mode == 10 { #assert rs_put_effect(b[..], 0, RsEffect.{kind = EF_COND, cond = RS_INVISIBLE, by = 0, spell = RS_HIDE_SPELL, until = 9, save = -1, dc = 15}); }
    else if mode == 11 { b[0].c[0].eff[0] = RsEffect.{kind = EF_COND, cond = RS_INVISIBLE, by = 0, spell = -2, until = 9, save = -1, dc = 15}; }
    r := rs_hide(b[..], 0, concealed, bonus);
    ok := mode == 0 || mode == 6 || mode == 9 || mode == 11;
    #assert r.accepted == ok && b[0].turn.action == (mode == 4 || mode == 9 || (ok && !bonus)) && b[0].turn.bonus == (mode == 8 || (ok && bonus));
    if ok { #assert r.total == 10 && !r.passed && rs_hidden_at(b[0].c[0]) < 0; }
  }
}
#test "Hide's DC 15 Stealth: its total is the finder's DC; Perception at or above it finds and ends it" {
  for dex: [2] int.[14, 16] {
    b: [1] RsBattle; b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; _ := rs_add(b[..], rs_rogue("Nim", 0, 3), 1, 1); _ = rs_add(b[..], rs_wizard("Seeker", 1, 1), 2, 1); b[0].c[0].score[RS_DEX] = dex; b[0].c[0].checks.expert = 0; rs_fresh(b[..], 0);
    r := rs_hide(b[..], 0, true, true);
    #assert r.passed == (dex == 16) && rs_has(b[0].c[0], RS_INVISIBLE) == (dex == 16);
    if dex == 16 {
      k := rs_hidden_at(b[0].c[0]); e := b[0].c[0].eff[k]; #assert k >= 0 && e.dc == 15 && e.by == 0 && e.cond == RS_INVISIBLE && e.save == -1 && e.kind == EF_COND;
      #assert !rs_find_hidden(b[..], 0, 0);
      b[0].c[1].score[RS_WIS] = 18; #assert !rs_find_hidden(b[..], 1, 0) && rs_has(b[0].c[0], RS_INVISIBLE);   // 10 + 4 = 14
      b[0].c[1].checks.skills = 1 << SK_PERCEPTION; #assert rs_find_hidden(b[..], 1, 0) && !rs_has(b[0].c[0], RS_INVISIBLE);   // 16
      #assert !rs_find_hidden(b[..], 1, 0);   // no longer hidden
    }
  }
}
#test "an attack roll or a Verbal spell ends hiding; a spell's own Invisible is not hiding" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; _ := rs_add(b[..], rs_rogue("Nim", 0, 3), 1, 1); _ = rs_add(b[..], rs_wizard("Seeker", 1, 1), 2, 1); b[0].c[0].score[RS_DEX] = 20; b[0].c[0].checks.expert = 0; rs_fresh(b[..], 0); b[0].c[1].hp = 200; b[0].c[1].ac = 10;
  #assert rs_hide(b[..], 0, true, false).passed; rs_fresh(b[..], 0);
  #assert rs_attack(b[..], 0, 1, false, -1) && rs_hidden_at(b[0].c[0]) < 0;
  w: [1] RsBattle; w[0].w = 12; w[0].h = 6; w[0].dice[0].fixed = true; _ = rs_add(w[..], rs_rogue("Nim", 0, 3), 1, 1); _ = rs_add(w[..], rs_wizard("Seeker", 1, 1), 2, 1); w[0].c[0].score[RS_DEX] = 20; w[0].c[0].checks.expert = 0; rs_fresh(w[..], 0);
  w[0].c[0] = rs_wizard("Wiz", 0, 3); w[0].c[0].x = 1; w[0].c[0].y = 1; w[0].c[0].score[RS_DEX] = 30;
  #assert rs_hide(w[..], 0, true, false).passed; rs_fresh(w[..], 0);
  #assert rs_cast(w[..], 0, SP_FIRE_BOLT, 0, 0, 0, 1) && rs_hidden_at(w[0].c[0]) < 0;
  c: RsCreature; c.eff[2] = RsEffect.{kind = EF_COND, cond = RS_INVISIBLE, spell = 4}; #assert rs_hidden_at(c) < 0;
  c.eff[3] = RsEffect.{kind = EF_BLESS, spell = RS_HIDE_SPELL}; #assert rs_hidden_at(c) < 0;
  c.eff[4] = RsEffect.{kind = EF_COND, spell = RS_HIDE_SPELL}; #assert rs_hidden_at(c) == 4;
}
#test "Fast Hands: the acting level 3 Rogue's Bonus Action Sleight of Hand, Thieves' Tools only when named" {
  for mode: 0..<6 {
    b: [1] RsBattle; b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; _ := rs_add(b[..], rs_rogue("Nim", 0, 3), 1, 1); _ = rs_add(b[..], rs_wizard("Seeker", 1, 1), 2, 1); b[0].c[0].score[RS_DEX] = 10; b[0].c[0].checks.expert = 0; rs_fresh(b[..], 0);
    if mode == 1 { b[0].who = 1; } else if mode == 2 { b[0].c[0].fast_hands = false; } else if mode == 3 { b[0].turn.bonus = true; }
    else if mode == 4 { b[0].c[0].cond = RS_STUNNED; }
    tools := mode != 5;
    r := rs_fast_hands(b[..], 0, 12, tools);
    ok := mode == 0 || mode == 5;
    #assert r.accepted == ok && b[0].turn.bonus == (ok || mode == 3) && !b[0].turn.action;
    if ok { #assert r.total == 10 + (ifx tools then 2 else 0) && r.passed == tools; }
  }
  t: [1] RsBattle; t[0].w = 12; t[0].h = 6; t[0].dice[0].fixed = true; _ := rs_add(t[..], rs_rogue("Nim", 0, 3), 1, 1); _ = rs_add(t[..], rs_wizard("Seeker", 1, 1), 2, 1); t[0].c[0].score[RS_DEX] = 10; t[0].c[0].checks.expert = 0; rs_fresh(t[..], 0); t[0].c[0].checks.tools = rs_tool_bit(0);
  #assert rs_fast_hands(t[..], 0, 12, false).total == 10;   // no tool named, none counted
}
