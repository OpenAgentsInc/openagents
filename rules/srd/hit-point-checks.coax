// SRD 5.2.1 pp.17-18: damage/healing, dying, stabilization and temporary HP.
#load "battle.coax";

#test "damage at zero still fails death saves when temporary HP absorb the whole hit" {
  for critical: 0..<2 {
    c: [1] RsCreature; c[0] = hp_dying(); c[0].temp = 8; c[0].stable = true;
    h := rs_hurt(c[..],3,critical == 1);
    #assert h.taken == 3 && !h.dropped && !h.killed && c[0].hp == 0 && c[0].temp == 5;
    #assert c[0].death_fail == critical+1 && !c[0].stable && !c[0].dead;
  }
}

#test "a natural twenty cannot report recovery while an active effect blocks healing" {
  c: [1] RsCreature; c[0] = hp_dying(); c[0].death_fail = 2;
  #assert rs_effect_add(c[..],RsEffect.{kind=EF_NOHEAL,until=20});
  d: [1] RsDice; d[0].state = hp_seed(20);
  #assert rs_death_save(d[..],c[..]) == RS_DS_BLOCKED;
  #assert c[0].hp == 0 && c[0].death_fail == 2 && c[0].death_ok == 0 && !c[0].stable && !c[0].dead;
  #assert rs_has(c[0],RS_UNCONSCIOUS) && d[0].rolled == 1;
}

#test "healing zero HP removes only the zero-HP Unconscious source" {
  c: [1] RsCreature; c[0] = hp_dying();
  #assert rs_effect_add(c[..],RsEffect.{kind=EF_COND,cond=RS_UNCONSCIOUS,until=20});
  #assert rs_heal(c[..],3) == 3 && c[0].hp == 3 && rs_has(c[0],RS_UNCONSCIOUS) && rs_has(c[0],RS_PRONE);
  rs_effect_end(c[..],0);
  #assert !rs_has(c[0],RS_UNCONSCIOUS) && rs_has(c[0],RS_PRONE);
}

#test "ending an independent Unconscious record cannot wake a creature still at zero HP" {
  c: [1] RsCreature; c[0] = hp_dying();
  #assert rs_effect_add(c[..],RsEffect.{kind=EF_COND,cond=RS_UNCONSCIOUS|RS_BLINDED,until=20});
  rs_effect_end(c[..],0);
  #assert rs_has(c[0],RS_UNCONSCIOUS) && !rs_has(c[0],RS_BLINDED) && rs_has(c[0],RS_PRONE);
  #assert rs_heal(c[..],1) == 1 && !rs_has(c[0],RS_UNCONSCIOUS) && rs_has(c[0],RS_PRONE);
}

#test "only a living unstable creature at zero HP rolls a death saving throw" {
  for mode: 0..<3 {
    c: [1] RsCreature; c[0] = hp_dying();
    if mode == 0 { c[0].dead = true; }
    else if mode == 1 { c[0].stable = true; }
    else { c[0].hp = 1; }
    d: [1] RsDice; d[0].state = hp_seed(1); before := d[0];
    #assert rs_death_save(d[..],c[..]) == RS_DS_NONE;
    #assert d[0].rolled == before.rolled && d[0].state == before.state;
    #assert c[0].death_ok == 0 && c[0].death_fail == 0;
  }
}

#forall "all death-save faces retain independent successes failures natural-one and natural-twenty outcomes" face: 1..<21 {
  for ok: 0..<3 { for failed: 0..<3 {
    c: [1] RsCreature; c[0] = hp_dying(); c[0].death_ok = ok; c[0].death_fail = failed;
    d: [1] RsDice; d[0].state = hp_seed(face);
    result := rs_death_save(d[..],c[..]);
    #assert d[0].rolled == 1;
    if face == 20 {
      #assert result == RS_DS_UP && c[0].hp == 1 && c[0].death_ok == 0 && c[0].death_fail == 0 && !c[0].dead && !c[0].stable;
      #assert c[0].cond == RS_PRONE;
    } else if face >= 10 {
      if ok == 2 {
        #assert result == RS_DS_STABLE && c[0].stable && c[0].death_ok == 0 && c[0].death_fail == 0;
      } else {
        #assert result == RS_DS_OK && !c[0].stable && c[0].death_ok == ok+1 && c[0].death_fail == failed;
      }
      #assert c[0].hp == 0 && !c[0].dead && c[0].cond == (RS_PRONE|RS_UNCONSCIOUS);
    } else {
      failures := failed+ifx face == 1 then 2 else 1;
      #assert result == (ifx failures >= 3 then RS_DS_DEAD else RS_DS_FAIL);
      #assert c[0].death_fail == failures && c[0].death_ok == ok && c[0].dead == (failures >= 3) && !c[0].stable;
      #assert c[0].hp == 0 && c[0].cond == (RS_PRONE|RS_UNCONSCIOUS);
    }
  } }
}

#test "zero and negative damage preserve dying stability and concentration without consuming temporary HP" {
  for amount: [3] int.[-2,-1,0] {
    c: [1] RsCreature; c[0] = hp_dying(); c[0].conc = SP_BLESS; c[0].stable = true; c[0].temp = 8;
    h := rs_hurt(c[..],amount,true);
    #assert h.taken == 0 && h.conc_dc == 0 && !h.dropped && !h.killed;
    #assert c[0].hp == 0 && c[0].temp == 8 && c[0].stable && !c[0].dead && c[0].death_fail == 0;
  }
  c: [1] RsCreature; c[0] = hp_dying(); c[0].dead = true; c[0].temp = 8;
  h := rs_hurt(c[..],1,true);
  #assert h.taken == 0 && !h.dropped && !h.killed && c[0].temp == 8 && c[0].death_fail == 0;
}

#test "damage at zero applies exact massive damage and critical failure thresholds independently of temporary HP" {
  for amount: [3] int.[11,12,13] {
    c: [1] RsCreature; c[0] = hp_dying(); c[0].hp_max = 12; c[0].temp = 20;
    h := rs_hurt(c[..],amount,false);
    #assert h.killed == (amount >= 12) && c[0].dead == (amount >= 12) && !h.dropped;
    #assert c[0].death_fail == 1 && c[0].hp == 0 && c[0].temp == 20-amount;
  }
  for failed: 0..<3 { for critical: 0..<2 {
    c: [1] RsCreature; c[0] = hp_dying(); c[0].death_fail = failed; c[0].temp = 8;
    h := rs_hurt(c[..],1,critical == 1);
    #assert c[0].death_fail == failed+critical+1 && h.killed == (failed+critical+1 >= 3);
  } }
}

#test "fresh dropping and real healing retire old death counters but retain unrelated state" {
  c: [1] RsCreature; c[0] = rs_druid("Patient",0,3); c[0].hp = 1;
  c[0].death_ok = 2; c[0].death_fail = 2; c[0].stable = true; c[0].cond = RS_BLINDED;
  h := rs_hurt(c[..],1,false);
  #assert h.dropped && !h.killed && !c[0].stable && c[0].death_ok == 0 && c[0].death_fail == 0;
  c[0].death_ok = 2; c[0].death_fail = 2; c[0].stable = true; c[0].temp = 7;
  #assert rs_heal(c[..],1) == 1 && c[0].death_ok == 0 && c[0].death_fail == 0 && !c[0].stable;
  #assert c[0].temp == 7 && c[0].cond == (RS_PRONE|RS_BLINDED);
  c[0] = rs_druid("Patient",0,3); c[0].hp = 1;
  #assert rs_hurt(c[..],1,false).dropped && c[0].cond == (RS_PRONE|RS_UNCONSCIOUS);
}

#test "healing ends zero-HP Unconscious when the only independent condition is Blinded" {
  c: [1] RsCreature; c[0] = hp_dying();
  #assert rs_effect_add(c[..],RsEffect.{kind=EF_COND,cond=RS_BLINDED,until=20});
  #assert rs_heal(c[..],1) == 1 && c[0].cond == (RS_PRONE|RS_BLINDED);
  #assert c[0].eff[0].kind == EF_COND && c[0].eff[0].cond == RS_BLINDED;
}

#test "concentration identity zero is live and negative one means no concentration" {
  c: [1] RsCreature; c[0] = rs_druid("Patient",0,3); c[0].conc = 0;
  #assert rs_hurt(c[..],1,false).conc_dc == 10;
  c[0].conc = -1;
  #assert rs_hurt(c[..],1,false).conc_dc == 0;
}

#test "three real turn saves stabilize once and damage through temporary HP starts a fresh death-save track" {
  b: [1] RsBattle; b[0].w = 8; b[0].h = 8;
  _ := rs_add(b[..],hp_dying(),1,1); b[0].dice[0].fixed = true;
  for turn: 0..<3 {
    b[0].clock = rs_secs(turn*6); rs_start_turn(b[..],0);
    #assert b[0].c[0].stable == (turn == 2);
    #assert b[0].c[0].death_ok == (ifx turn == 2 then 0 else turn+1) && b[0].c[0].death_fail == 0;
    rs_end_turn(b[..],0);
  }
  rolls := b[0].dice[0].rolled;
  b[0].clock = 18; rs_start_turn(b[..],0); rs_end_turn(b[..],0);
  #assert b[0].c[0].stable && b[0].dice[0].rolled == rolls;
  b[0].c[0].temp = 3;
  rs_damage(b[..],-1,0,1,RS_FORCE,false,-1);
  #assert !b[0].c[0].stable && b[0].c[0].hp == 0 && b[0].c[0].temp == 2;
  #assert b[0].c[0].death_fail == 1 && b[0].c[0].death_ok == 0;
  b[0].clock = 24; rs_start_turn(b[..],0);
  #assert b[0].c[0].death_ok == 1 && b[0].c[0].death_fail == 1 && b[0].dice[0].rolled == rolls+1;
}

#test "natural-twenty healing reports regained HP while another Unconscious source still prevents acting" {
  b: [1] RsBattle; b[0].w = 8; b[0].h = 8;
  _ := rs_add(b[..],hp_dying(),1,1);
  #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_COND,cond=RS_UNCONSCIOUS,until=20});
  b[0].dice[0].fixed = false; b[0].dice[0].state = hp_seed(20);
  rs_start_turn(b[..],0);
  #assert b[0].c[0].hp == 1 && !rs_can_act(b[0].c[0]) && rs_has(b[0].c[0],RS_UNCONSCIOUS) && rs_has(b[0].c[0],RS_PRONE);
  e := rs_recent_at(b[0].book[..],0);
  #assert e.kind == RS_EV_UP && cast(string)e.text[0..<e.text_n] == "Patient rolls a 20 on a death save and regains 1 Hit Point";
}

#test "natural-one turn saves count two failures and publish one terminal death outcome" {
  b: [1] RsBattle; b[0].w = 8; b[0].h = 8;
  _ := rs_add(b[..],hp_dying(),1,1);
  b[0].dice[0].fixed = false; b[0].dice[0].state = hp_seed(1);
  rs_start_turn(b[..],0);
  #assert b[0].c[0].death_fail == 2 && !b[0].c[0].dead;
  rs_end_turn(b[..],0); b[0].clock = 6; b[0].dice[0].state = hp_seed(1);
  rs_start_turn(b[..],0);
  #assert b[0].c[0].death_fail == 4 && b[0].c[0].dead;
  e := rs_recent_at(b[0].book[..],0);
  #assert e.kind == RS_EV_DEATH && e.by == 0 && e.to == 0 && e.amount == RS_DS_DEAD;
  seq := b[0].book[0].seq; rolls := b[0].dice[0].rolled;
  rs_end_turn(b[..],0); b[0].clock = 12; rs_start_turn(b[..],0);
  #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolls;
}

#test "Lay On Hands reports waking only when healing actually removes Unconscious" {
  for held: 0..<2 {
    b: [1] RsBattle; b[0].w = 8; b[0].h = 8;
    _ := rs_add(b[..],rs_paladin("Healer",0,3),1,1);
    _ = rs_add(b[..],hp_dying(),2,1);
    if held == 1 { #assert rs_put_effect(b[..],1,RsEffect.{kind=EF_COND,cond=RS_UNCONSCIOUS,until=20}); }
    rs_start_turn(b[..],0); pool := b[0].c[0].uses[RS_USE_LAY];
    #assert rs_lay_on_hands(b[..],0,1,3);
    #assert b[0].turn.bonus && b[0].c[0].uses[RS_USE_LAY] == pool-3 && b[0].c[1].hp == 3;
    #assert rs_has(b[0].c[1],RS_UNCONSCIOUS) == (held == 1) && rs_has(b[0].c[1],RS_PRONE);
    e := rs_recent_at(b[0].book[..],0);
    #assert e.kind == RS_EV_HEAL && e.feat == RS_FT_LAY_ON_HANDS && e.by == 0 && e.to == 1 && e.amount == 3;
    expected := ifx held == 1 then "  Patient regains 3 Hit Points from Lay On Hands" else "  Patient regains 3 Hit Points from Lay On Hands and wakes";
    #assert cast(string)e.text[0..<e.text_n] == expected;
  }
}

#test "healing refusal never changes HP counters conditions or temporary HP" {
  for mode: 0..<5 {
    c: [1] RsCreature; c[0] = hp_dying(); c[0].temp = 7; c[0].death_fail = 2;
    amount := 2;
    if mode == 0 { c[0].dead = true; }
    else if mode == 1 { #assert rs_effect_add(c[..],RsEffect.{kind=EF_NOHEAL}); }
    else if mode == 2 { amount = 0; }
    else if mode == 3 { amount = -1; }
    else { c[0].hp_max = 0; }
    #assert rs_heal(c[..],amount) == 0 && c[0].hp == 0 && c[0].temp == 7 && c[0].death_fail == 2;
    #assert c[0].cond == (RS_PRONE|RS_UNCONSCIOUS);
  }
  c: [1] RsCreature; c[0] = rs_druid("Patient",0,3); c[0].hp = c[0].hp_max+1;
  before := c[0].hp;
  #assert rs_heal(c[..],2) == 0 && c[0].hp == before;
}

#forall "temporary HP damage still requests the bounded concentration DC for the whole hit" amount: 1..<65 {
  c: [1] RsCreature; c[0] = rs_druid("Patient",0,3); c[0].conc = SP_BLESS; c[0].temp = 100;
  h := rs_hurt(c[..],amount,false);
  expected := ifx amount < 22 then 10 else ifx amount >= 60 then 30 else amount/2;
  #assert h.conc_dc == expected && h.taken == amount && !h.dropped && !h.killed;
  #assert c[0].hp == c[0].hp_max && c[0].temp == 100-amount;
  c[0].conc = -1;
  #assert rs_hurt(c[..],1,false).conc_dc == 0;
}

#test "healing saturates at maximum HP without arithmetic overflow or changing temporary HP" {
  c: [1] RsCreature; c[0] = rs_druid("Patient",0,3); c[0].temp = 17;
  c[0].hp_max = 9223372036854775807; c[0].hp = 5;
  #assert rs_heal(c[..],9223372036854775807) == 9223372036854775802;
  #assert c[0].hp == c[0].hp_max && c[0].temp == 17;
  #assert rs_heal(c[..],1) == 0 && c[0].hp == c[0].hp_max && c[0].temp == 17;
}

#test "turn reporting never tells a player they recovered while Chill Touch holds them at zero" {
  b: [1] RsBattle; b[0].w = 8; b[0].h = 8;
  _ := rs_add(b[..],hp_dying(),1,1);
  #assert rs_put_effect(b[..],0,RsEffect.{kind=EF_NOHEAL,until=20});
  b[0].dice[0].fixed = false; b[0].dice[0].state = hp_seed(20);
  rs_start_turn(b[..],0);
  #assert b[0].c[0].hp == 0 && !rs_can_act(b[0].c[0]);
  e := rs_recent_at(b[0].book[..],0);
  #assert e.kind != RS_EV_UP && e.to == 0 && e.by == 0;
  #assert cast(string)e.text[0..<e.text_n] == "Patient rolls a 20 on a death save but cannot regain Hit Points";
}

#forall "damage conserves ordinary and temporary HP and observes exact massive-damage thresholds" amount: 0..<31 {
  for hp: [3] int.[1,6,12] { for temp: [2] int.[0,5] { for monster: 0..<2 {
    c: [1] RsCreature; c[0] = rs_druid("Patient",0,3); c[0].hp_max = 12; c[0].hp = hp; c[0].temp = temp;
    c[0].cond = RS_BLINDED; if monster == 1 { c[0].klass = RS_MONSTER; }
    h := rs_hurt(c[..],amount,false);
    remaining := rs_max(amount-temp,0);
    expected_hp := rs_max(hp-remaining,0);
    killed := expected_hp == 0 && (monster == 1 || amount >= hp+temp+12);
    #assert c[0].hp == expected_hp && c[0].temp == rs_max(temp-amount,0) && h.taken == amount;
    #assert h.dropped == (expected_hp == 0) && h.killed == killed && c[0].dead == killed;
    #assert c[0].cond == (ifx expected_hp == 0 then RS_BLINDED|RS_UNCONSCIOUS|RS_PRONE else RS_BLINDED);
  } } }
}

hp_dying :: () -> RsCreature {
  c := rs_druid("Patient",0,3); c.hp = 0; c.cond = RS_UNCONSCIOUS|RS_PRONE; return c;
}
// Find replay seeds for authored natural-roll fixtures. Expected transitions
// are specified in the checks, independently of the damage/death implementation.
hp_seed :: (roll: int) -> u64 {
  for seed: 1..<4096 {
    d: [1] RsDice; d[0].state = cast(u64)seed;
    if rs_roll(d[..],20) == roll { return cast(u64)seed; }
  }
  return 0;
}
