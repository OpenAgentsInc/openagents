// SRD 5.2.1 pp.16-18 worked examples and interactions, through the shared entry
// points: healing, Temporary Hit Points, damage defenses, dropping to 0, death
// saves, stabilizing and knocking out (#13039). Each check cites its clause.
#load "stabilization-checks.coax";
#load "knockout-checks.coax";

hx_field :: (b: [] RsBattle, c: [] RsCreature) #effects(all) {
  b[0].c=c; b[0].n=2; b[0].w=8; b[0].h=8; b[0].who = -1; b[0].dice[0].fixed=true;
  c[0]=rs_wizard("Caster",0,3); c[0].x=1; c[0].y=1;
  c[1]=rs_fighter("Hero",0,3); c[1].x=2; c[1].y=1;
}

#test "p.17 healing: 8 HP of healing at 14 of 20 restores 6, and healing never restores Temporary HP" {
  c: [1] RsCreature; c[0].hp=14; c[0].hp_max=20; c[0].temp=3;
  #assert rs_heal(c[..],8)==6 && c[0].hp==20 && c[0].temp==3;
}
#test "p.18 Temporary HP are lost first: 5 Temporary HP and 7 damage lose 2 Hit Points" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; hx_field(b[..],c[..]);
  c[1].hp=20; c[1].temp=5;
  rs_damage(b[..],-1,1,7,RS_FIRE,false,-1);
  #assert c[1].temp==0 && c[1].hp==18;
}
#test "p.18 Temporary HP don't stack: the larger grant is kept either way" {
  for start: [3] int.[0,5,10] {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; hx_field(b[..],c[..]); b[0].who=0;
    c[0].temp=start;
    #assert rs_cast(b[..],0,SP_FALSE_LIFE,1,1,1,0);
    #assert c[0].temp==rs_max(start,8);   // 2d4 + 4 at fixed dice: 8
  }
}
#test "p.18 Temporary HP at 0 HP don't restore consciousness, and damage they absorb still costs a death save" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; hx_field(b[..],c[..]);
  c[1].hp=0; c[1].cond=RS_UNCONSCIOUS|RS_PRONE; c[1].temp=8;
  #assert rs_has(c[1],RS_UNCONSCIOUS) && rs_death_eligible(c[1]) && !rs_capable(c[1]);
  rs_damage(b[..],-1,1,3,RS_FIRE,false,-1);
  #assert c[1].temp==5 && c[1].death_fail==1 && c[1].hp==0;
}
#test "p.17 massive damage: maximum 12 at 6 HP dies from 18 damage and survives 17" {
  for amount: [2] int.[17,18] {
    c: [1] RsCreature; c[0].hp=6; c[0].hp_max=12;
    r:=rs_hurt(c[..],amount,false);
    #assert c[0].hp==0 && r.dropped && c[0].dead==(amount==18) && r.killed==(amount==18);
    #assert rs_has(c[0],RS_UNCONSCIOUS|RS_PRONE);
  }
}
#test "p.17 a monster dies the instant it drops to 0 HP; a character falls Unconscious" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; hx_field(b[..],c[..]);
  c[0]=rs_monster(MON_GOBLIN_WARRIOR,"Goblin",1); c[0].hp=3;
  rs_damage(b[..],-1,0,3,RS_SLASHING,false,-1);
  rs_damage(b[..],-1,1,c[1].hp,RS_SLASHING,false,-1);
  #assert c[0].dead && !c[1].dead && c[1].hp==0 && rs_has(c[1],RS_UNCONSCIOUS) && rs_has(c[1],RS_PRONE);
}
#test "p.18 damage at 0 HP: one failure, two from a Critical Hit, death at the HP maximum" {
  for k: 0..<3 {
    c: [1] RsCreature; c[0].hp=0; c[0].hp_max=12; c[0].cond=RS_UNCONSCIOUS|RS_PRONE; c[0].stable=true;
    amount := ifx k==2 then 12 else 1;
    _ := rs_hurt(c[..],amount,k==1);
    #assert !c[0].stable && c[0].death_fail==(ifx k==1 then 2 else 1) && c[0].dead==(k==2);
  }
}
#test "p.18 death saves: three successes stabilize, three failures kill, a 1 is two failures, a 20 regains 1 HP" {
  c: [1] RsCreature; c[0].hp_max=12; c[0].cond=RS_UNCONSCIOUS|RS_PRONE;
  #assert rs_death_apply(c[..],10,10)==RS_DS_OK && rs_death_apply(c[..],9,9)==RS_DS_FAIL;
  #assert rs_death_apply(c[..],15,15)==RS_DS_OK && rs_death_apply(c[..],12,12)==RS_DS_STABLE;
  #assert c[0].stable && c[0].death_ok==0 && c[0].death_fail==0 && c[0].hp==0 && rs_has(c[0],RS_UNCONSCIOUS);
  d: [1] RsCreature; d[0].hp_max=12; d[0].cond=RS_UNCONSCIOUS;
  #assert rs_death_apply(d[..],1,1)==RS_DS_FAIL && d[0].death_fail==2 && rs_death_apply(d[..],5,5)==RS_DS_DEAD && d[0].dead;
  e: [1] RsCreature; e[0].hp_max=12; e[0].cond=RS_UNCONSCIOUS|RS_PRONE; e[0].death_ok=2; e[0].death_fail=2;
  #assert rs_death_apply(e[..],20,20)==RS_DS_UP && e[0].hp==1 && e[0].death_ok==0 && e[0].death_fail==0;
  #assert !rs_has(e[0],RS_UNCONSCIOUS) && rs_has(e[0],RS_PRONE);   // Unconscious ends; Prone remains
}
#test "p.18 a Stable creature makes no death saves until it takes damage again" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; hx_field(b[..],c[..]);
  c[1].hp=0; c[1].stable=true; c[1].cond=RS_UNCONSCIOUS|RS_PRONE;
  #assert rs_battle_death_save(b[..],1)==RS_DS_NONE && c[1].death_fail==0;
  rs_damage(b[..],-1,1,1,RS_FIRE,false,-1);
  #assert !c[1].stable && c[1].death_fail==1 && rs_death_eligible(c[1]);
}
#test "p.16 damage order: a -5 aura, Resistance to all, then Vulnerability to Fire turns 28 Fire into 22" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; hx_field(b[..],c[..]);
  c[1].resist=32767; c[1].vulnerable=1<<RS_FIRE;
  #assert rs_resisted(b[..],1,28-5,RS_FIRE)==22 && rs_resisted(b[..],1,28-5,RS_COLD)==11;
  // no stacking: Necrotic Resistance and Resistance to all halve Necrotic once; Rage and Petrified add nothing more
  c[1].vulnerable=0; c[1].resist=(1<<RS_NECROTIC)|32767;
  #assert rs_resisted(b[..],1,21,RS_NECROTIC)==10;
  c[1].resist=1<<RS_SLASHING; c[1].eff = rs_state_put(c[1].eff, EF_RAGE, true); c[1].cond=RS_PETRIFIED;
  #assert rs_resisted(b[..],1,21,RS_SLASHING)==10;
  // Immunity means no damage, whatever else applies
  c[1].immune=1<<RS_SLASHING; c[1].vulnerable=1<<RS_SLASHING;
  #assert rs_resisted(b[..],1,21,RS_SLASHING)==0;
}
#test "p.17 knocking out: the same melee blow that would drop a character leaves it at 1 HP and Unconscious" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ko_field(b[..]);
  b[0].c[1]=rs_fighter("Squire",1,1); b[0].c[1].x=2; b[0].c[1].y=1; b[0].c[1].ac=5; b[0].c[1].hp=2;
  #assert rs_attack(b[..],0,1,false,-1);
  c:=b[0].c[1];
  #assert c.hp==1 && rs_knocked_out(c) && !rs_death_eligible(c) && c.death_fail==0 && c.rest.phase==1;
}
#test "p.97 Healer's Kit and p.18 first aid both stabilize without healing; only the kit needs no check" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c: [2] RsCreature; sa_field(b[..],c[..]); c[0].score[RS_WIS]=1; c[0].uses[RS_USE_KIT]=1;
  r:=rs_first_aid(b[..],0,1,RsFirstAidContext.{contact=true});
  #assert r.accepted && !r.passed && !c[1].stable;
  b[0].turn.action=false;
  #assert rs_healers_kit(b[..],0,1,true) && c[1].stable && c[1].hp==0 && c[0].uses[RS_USE_KIT]==0;
}

// Who owns each condition in the levels 1-6 slice (docs/verification/srd-knockout-conditions-2026-11-08/README.md).
// A record owns its bits; ending it clears only the bits no other owner holds.
// Zero HP owns Unconscious while hp==0; Prone and Exhaustion are not records:
// Prone is a raw bit ended by standing, Exhaustion the cumulative level.
HX_OWNERS :: [9] int.[EF_COND, EF_DAZED, EF_TURNED, EF_ZONE_RESTRAIN, EF_REST_SLEEP, EF_KNOCKOUT, EF_HEX, EF_HALT, EF_NOHEAL];
HX_OWNED :: [9] int.[-1, RS_CHARMED|RS_INCAPACITATED, RS_FRIGHTENED|RS_INCAPACITATED, RS_RESTRAINED, RS_UNCONSCIOUS, RS_UNCONSCIOUS, 0, 0, 0];
#test "condition owners: each record kind owns exactly its bits and ending one keeps every other owner's" {
  for a: 0..<HX_OWNERS.count { for o: 0..<HX_OWNERS.count {
    if a==o { continue; }
    shared := RS_UNCONSCIOUS|RS_INCAPACITATED|RS_CHARMED;
    ma := ifx HX_OWNED[a] < 0 then shared else HX_OWNED[a];
    mo := ifx HX_OWNED[o] < 0 then shared else HX_OWNED[o];
    c: [1] RsCreature; c[0].hp=5; c[0].restrained_by = -1;
    ea := RsEffect.{kind=HX_OWNERS[a],cond=ifx HX_OWNERS[a]==EF_ZONE_RESTRAIN then 0 else ifx HX_OWNED[a] < 0 then shared else HX_OWNED[a]};
    eo := RsEffect.{kind=HX_OWNERS[o],cond=ifx HX_OWNERS[o]==EF_ZONE_RESTRAIN then 1 else ifx HX_OWNED[o] < 0 then shared else HX_OWNED[o]};
    if HX_OWNERS[a]==EF_REST_SLEEP || HX_OWNERS[a]==EF_KNOCKOUT { ea.cond=0; }
    if HX_OWNERS[o]==EF_REST_SLEEP || HX_OWNERS[o]==EF_KNOCKOUT { eo.cond=0; }
    #assert rs_effect_add(c[..],ea) && rs_effect_add(c[..],eo);
    #assert rs_effect_conditions(ea)==ma && (c[0].cond & (ma|mo))==(ma|mo);
    rs_effect_end(c[..],0);
    #assert c[0].cond==mo;
    // at 0 HP the zero-HP owner keeps the Unconscious bit the remaining record held
    c[0].hp=0; rs_effect_end(c[..],1);
    #assert c[0].cond==(mo & RS_UNCONSCIOUS);
  } }
}
#test "condition owners: the slice's producers create the owners the table names" {
  hp := rs_spell(SP_HOLD_PERSON); hy := rs_spell(SP_HYPNOTIC_PATTERN); rs := rs_spell(SP_RAY_OF_SICKNESS);
  bd := rs_spell(SP_BLINDNESS); en := rs_spell(SP_ENTANGLE);
  found := 0;
  for k: 0..<hp.step_n { if hp.steps[k].kind==RS_S_TIMED && hp.steps[k].a==RS_PARALYZED { found+=1; } }
  for k: 0..<hy.step_n { if hy.steps[k].kind==RS_S_DAZE && hy.steps[k].a==(RS_CHARMED|RS_INCAPACITATED) { found+=1; } }
  for k: 0..<rs.step_n { if rs.steps[k].kind==RS_S_TIMED && rs.steps[k].a==RS_POISONED { found+=1; } }
  for k: 0..<bd.step_n { if bd.steps[k].kind==RS_S_TIMED && bd.steps[k].a==RS_BLINDED { found+=1; } }
  for k: 0..<en.step_n { if en.steps[k].kind==RS_S_CONDITION && en.steps[k].a==RS_RESTRAINED { found+=1; } }
  #assert found==5;
  // zero HP, sleep and the knockout each own Unconscious and leave Prone behind
  c: [1] RsCreature; c[0].hp=6; c[0].hp_max=12;
  _ := rs_hurt(c[..],6,false);
  #assert c[0].cond==(RS_UNCONSCIOUS|RS_PRONE) && c[0].eff[0].kind==EF_NONE;
  #assert rs_heal(c[..],1)==1 && c[0].cond==RS_PRONE;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ko_field(b[..]); b[0].c[1].hp=2;
  #assert rs_attack(b[..],0,1,false,-1) && (b[0].c[1].cond & (RS_UNCONSCIOUS|RS_PRONE))==(RS_UNCONSCIOUS|RS_PRONE);
  #assert rs_sleep_begin(b[..],0) && rs_has(b[0].c[0],RS_UNCONSCIOUS|RS_PRONE);
  rs_sleep_end(b[0].c[0..<1]); #assert !rs_has(b[0].c[0],RS_UNCONSCIOUS) && rs_has(b[0].c[0],RS_PRONE);
}
