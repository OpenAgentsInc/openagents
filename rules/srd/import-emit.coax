// Deterministic Coax/TSV generation from reconciled candidates. No file effects.
#load "import-reconcile.coax";
#load "import-policy.coax";

#test "generated literals escape quotes, backslashes, tabs and newlines without changing bytes" {
  a: [1] SiArena; si_quote("a\"b\\c\n\t", a[..]);
  #assert cast(string) a[0].bytes[0..<a[0].n] == "\"a\\\"b\\\\c\\n\\t\"";
  a[0].n = 0; si_integer(-1, a[..]); _ := si_store(" ", a[..]); si_integer(339, a[..]);
  #assert cast(string) a[0].bytes[0..<a[0].n] == "-1 339";
}
si_integer :: (n: int, a: [] SiArena) {
  v := n; if v < 0 { _ := si_store("-", a); v = -v; }
  buf: [32] u8; count := 0;
  while true { buf[count] = cast(u8) (48 + v % 10); count += 1; v = v / 10; if v == 0 { break; } }
  for j: 0..<count { one := [1] u8.[buf[count - 1 - j]]; _ := si_store(cast(string) one[..], a); }
}
si_quote :: (s: string, a: [] SiArena) {
  _ := si_store("\"", a);
  for c: s {
    if c == 34 { _ = si_store("\\\"", a); }
    else if c == 92 { _ = si_store("\\\\", a); }
    else if c == 10 { _ = si_store("\\n", a); }
    else if c == 9 { _ = si_store("\\t", a); }
    else if c == 13 { _ = si_store("\\r", a); }
    else { one := [1] u8.[c]; _ = si_store(cast(string) one[..], a); }
  }
  _ = si_store("\"", a);
}
si_string_field :: (key: string, value: string, a: [] SiArena) {
  _ := si_store("    s.", a); _ = si_store(key, a); _ = si_store(" = ", a); si_quote(value, a); _ = si_store(";\n", a);
}
si_int_field :: (key: string, value: int, a: [] SiArena) {
  _ := si_store("    s.", a); _ = si_store(key, a); _ = si_store(" = ", a); si_integer(value, a); _ = si_store(";\n", a);
}
si_bool_field :: (key: string, value: bool, a: [] SiArena) {
  _ := si_store("    s.", a); _ = si_store(key, a); _ = si_store(ifx value then " = true;\n" else " = false;\n", a);
}
si_attribution :: (a: [] SiArena) {
  _ := si_store("// Generated by rules/srd/import.coax; source schema 1. Do not edit.\n// This work includes material from the System Reference Document 5.2.1 (\"SRD 5.2.1\") by Wizards\n// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the\n// Creative Commons Attribution 4.0 International License, available at\n// https://creativecommons.org/licenses/by/4.0/legalcode.\n", a);
}
si_emit_spells :: (b: [] SiBook, a: [] SiArena) {
  si_attribution(a);
  _ := si_store("#load \"../source-schema.coax\";\nSRD_SOURCE_PDF_SHA256 :: ", a); si_quote(SI_PDF_SHA256, a);
  _ = si_store(";\nSRD_SOURCE_SPELLS :: ", a); si_integer(b[0].n, a);
  _ = si_store(";\n// Metadata only: no imported spell is thereby mechanically implemented.\nsrd_source_spell :: (i: int) -> SrdSourceSpell {\n  s: SrdSourceSpell;\n", a);
  for i: 0..<b[0].n {
    s := b[0].spell[i]; _ = si_store("  if i == ", a); si_integer(i, a); _ = si_store(" {\n", a);
    si_string_field("id", s.id, a); si_string_field("name", s.name, a);
    si_int_field("level", s.level, a); si_int_field("school", s.school, a); si_int_field("classes", s.classes, a);
    si_int_field("page", s.page, a); si_int_field("end_page", s.end_page, a);
    si_string_field("cast_text", s.cast_text, a); si_int_field("cast_kind", s.cast_kind, a); si_int_field("cast_seconds", s.cast_seconds, a); si_bool_field("ritual", s.ritual, a);
    si_string_field("range_text", s.range_text, a); si_int_field("range_kind", s.range_kind, a); si_int_field("range_value", s.range_value, a);
    si_string_field("components", s.components, a); si_bool_field("verbal", s.verbal, a); si_bool_field("somatic", s.somatic, a); si_bool_field("material", s.material, a);
    si_string_field("material_text", s.material_text, a); si_string_field("cost_text", s.cost_text, a); si_bool_field("consumed", s.consumed, a);
    si_string_field("duration_text", s.duration_text, a); si_int_field("duration_kind", s.duration_kind, a); si_int_field("duration_seconds", s.duration_seconds, a); si_bool_field("concentration", s.concentration, a);
    si_string_field("text", s.text, a); si_string_field("higher_levels", s.higher_levels, a);
    _ = si_store("    return s;\n  }\n", a);
  }
  _ = si_store("  return s;\n}\n", a);
}
si_emit_lists :: (b: [] SiBook, a: [] SiArena) {
  si_attribution(a); _ := si_store("#load \"../source-schema.coax\";\nSRD_SOURCE_MEMBERSHIPS :: ", a); si_integer(b[0].lists, a);
  _ = si_store(";\nSRD_SOURCE_CLASS_SPELLS :: [SRD_SOURCE_MEMBERSHIPS] SrdClassSpell.[\n", a);
  for i: 0..<b[0].lists {
    r := b[0].list[i]; _ = si_store("  SrdClassSpell.{klass = ", a); si_integer(r.klass, a);
    _ = si_store(", spell = ", a); si_integer(r.spell, a); _ = si_store(", level = ", a); si_integer(r.level, a); _ = si_store(", school = ", a); si_integer(r.school, a); _ = si_store(", page = ", a); si_integer(r.page, a);
    _ = si_store(ifx r.concentration then ", concentration = true" else ", concentration = false", a);
    _ = si_store(ifx r.ritual then ", ritual = true" else ", ritual = false", a);
    _ = si_store(ifx r.material_required then ", material_required = true}" else ", material_required = false}", a);
    _ = si_store(ifx i + 1 < b[0].lists then ",\n" else "\n", a);
  }
  _ = si_store("];\n", a);
}
si_emit_inventory :: (b: [] SiBook, a: [] SiArena, classes: bool) {
  _ := si_store("# ", a); _ = si_store(SRD_ATTRIBUTION, a); _ = si_store("\n", a);
  if classes {
    _ = si_store("class\tspell_id\tlevel\tschool\tsource_page\tconcentration\tritual\tmaterial_required\n", a);
    for i: 0..<b[0].lists {
      r := b[0].list[i]; _ = si_store(SRD_CLASSES[r.klass], a); _ = si_store("\t", a); _ = si_store(b[0].spell[r.spell].id, a); _ = si_store("\t", a);
      si_integer(r.level, a); _ = si_store("\t", a); _ = si_store(SRD_SCHOOLS[r.school], a); _ = si_store("\t", a); si_integer(r.page, a);
      _ = si_store(ifx r.concentration then "\t1" else "\t0", a); _ = si_store(ifx r.ritual then "\t1" else "\t0", a);
      _ = si_store(ifx r.material_required then "\t1\n" else "\t0\n", a);
    }
  } else {
    _ = si_store("ledger_id\tspell_id\tname\tlevel\tschool\tclasses_mask\tpage\tend_page\tmechanics\n", a);
    for i: 0..<b[0].n {
      s := b[0].spell[i]; _ = si_store("spell/", a); _ = si_store(s.id, a); _ = si_store("\t", a); _ = si_store(s.id, a); _ = si_store("\t", a); _ = si_store(s.name, a); _ = si_store("\t", a); si_integer(s.level, a);
      _ = si_store("\t", a); _ = si_store(SRD_SCHOOLS[s.school], a); _ = si_store("\t", a); si_integer(s.classes, a);
      _ = si_store("\t", a); si_integer(s.page, a); _ = si_store("\t", a); si_integer(s.end_page, a); _ = si_store("\tunqualified\n", a);
    }
  }
}
si_emit_difference :: (s: SrdSourceSpell, klass: int, page: int, field: string, source: int, table: int, a: [] SiArena) {
  _ := si_store(s.id, a); _ = si_store("\t", a); si_integer(s.page, a); _ = si_store("\t", a);
  if klass >= 0 { _ = si_store(SRD_CLASSES[klass], a); }
  _ = si_store("\t", a); si_integer(page, a); _ = si_store("\t", a); _ = si_store(field, a);
  _ = si_store("\t", a); si_integer(source, a); _ = si_store("\t", a); si_integer(table, a); _ = si_store("\treviewed-source-difference\n", a);
}
si_emit_differences :: (b: [] SiBook, a: [] SiArena) -> int {
  _ := si_store("# ", a); _ = si_store(SRD_ATTRIBUTION, a); _ = si_store("\nspell_id\tdescription_page\tclass\ttable_page\tfield\tdescription_value\ttable_value\tstatus\n", a);
  count := 0;
  for i: 0..<b[0].n {
    s := b[0].spell[i]; mask := 0;
    for j: 0..<b[0].lists {
      r := b[0].list[j]; if r.spell != i { continue; } mask = mask | (1 << r.klass);
      if r.school != s.school { si_emit_difference(s, r.klass, r.page, "school", s.school, r.school, a); count += 1; }
      material := ifx s.cost_text.count > 0 || s.consumed then 1 else 0; table_material := ifx r.material_required then 1 else 0;
      if material != table_material { si_emit_difference(s, r.klass, r.page, "material_required", material, table_material, a); count += 1; }
    }
    if mask != s.classes { si_emit_difference(s, -1, 0, "classes_mask", s.classes, mask, a); count += 1; }
  }
  return count;
}
