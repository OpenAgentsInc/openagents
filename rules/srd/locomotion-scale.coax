// The physical action world's declared base tuning represents Speed 30.
// Keep source Speed changes and per-foot walking costs proportional to it.
#authority;
rs_locomotion_scale :: (b:[]RsBattle,i:int)->f32 #effects(all) {
  if i<0 || i>=b[0].n { return 0; }
  if !rs_can_move(b[0].c[i]) { return 0; }
  cost:=rs_step_feet(rs_has(b[0].c[i],RS_PRONE),rs_difficult(b,b[0].c[i].x,b[0].c[i].y));
  return f32(rs_walk_speed(b,i))/30/(f32(cost)/5);
}
#test "locomotion scaling does not turn incapacitated action permission into movement permission" {
  b:[1]RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=8; b[0].h=8; _:=rs_add(b[..],rs_guard("Walker",0),2,2);
  #assert rs_locomotion_scale(b[..],0)==1;
  b[0].c[0].hp=0; #assert rs_locomotion_scale(b[..],0)==0;
}
#test "a Speed scale is Speed over 30 and over the step's cost over 5: crawling doubles it, difficult terrain adds a step, and no creature gives none" {
  b:[1]RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=8; b[0].h=8; _:=rs_add(b[..],rs_fighter("Walker",0,1),2,2);
  for speed:[4]int.[0,15,30,120] { for prone:0..<2 { for terrain:0..<2 {
    b[0].c[0].speed=speed; b[0].c[0].cond=ifx prone==1 then RS_PRONE else 0;
    b[0].zone[0]=RsZone.{on=terrain==1,difficult=true,x0=0,y0=0,x1=7,y1=7};
    #assert rs_locomotion_scale(b[..],0)==f32(speed)/30/f32(1+prone+terrain);
  } } }
  b[0].zone[0].on=false; b[0].c[0].cond=0; b[0].c[0].speed=45;
  #assert rs_locomotion_scale(b[..],0)==1.5;
  b[0].c[0].cond=RS_PRONE; #assert rs_locomotion_scale(b[..],0)==0.75;
  b[0].c[0].cond=RS_GRAPPLED; #assert rs_locomotion_scale(b[..],0)==0;
  b[0].c[0].cond=0; b[0].c[b[0].n]=rs_guard("Unused",0);   // a live creature past the last one is not one
  #assert rs_locomotion_scale(b[..],-1)==0 && rs_locomotion_scale(b[..],b[0].n)==0 && rs_locomotion_scale(b[..],1)==0;
}
