// How a world measures ranges, reaches and areas (docs/dnd/everglade-combat-profile.md, #13284).
//
// On the SRD's grid a diagonal square counts as a straight one (SRD 5.2.1 p. 189 "Playing on a Grid":
// the grid's count, RS_MEASURE_GRID), so a 30-foot reach along the diagonal is 41% longer than along a
// row. A world whose people stand anywhere, not on squares, declares RS_MEASURE_STRAIGHT: the straight
// line between the two squares' middles, to the nearest 5 feet. A square's middle is at most half a
// square from where its creature stands, so the rules and the world's metres then agree to a square,
// in every direction. Whole numbers only: the same on every machine.
//
// Movement always counts the grid's squares (rs_feet): a step to any of the eight squares round you
// is 5 feet in both measures.
#authority;

RS_MEASURE_GRID :: 0;
RS_MEASURE_STRAIGHT :: 1;

rs_measure_allowed :: (measure: int) -> bool #effects(all) { return measure == RS_MEASURE_GRID || measure == RS_MEASURE_STRAIGHT; }
// Feet between two squares (dx, dy) apart.
rs_measure_feet :: (measure: int, dx: int, dy: int) -> int #effects(all) {
  ax := rs_max(dx, -dx); ay := rs_max(dy, -dy);
  if measure != RS_MEASURE_STRAIGHT { return rs_max(ax, ay) * RS_SQUARE; }
  // the nearest whole number of squares to the straight line: the least r whose half-way mark to the
  // next is past it, (r + 1/2) squared > the distance squared, which in whole numbers is r * r + r >= it.
  // r is never more than the two counts together, so the search is bounded.
  d2 := dx * dx + dy * dy;
  r := 0;
  for step: 0..<ax + ay { if r * r + r < d2 { r += 1; } }
  return r * RS_SQUARE;
}

#test "only the grid and the straight measure are admitted" {
  for m: -2..<4 { #assert rs_measure_allowed(m) == (m == 0 || m == 1); }
  #assert RS_MEASURE_GRID == 0 && RS_MEASURE_STRAIGHT == 1;
}
#test "the grid counts a diagonal as a straight; the straight measure is the line, to the nearest square, the same both ways" {
  // the grid: the longer of the two counts, whatever its sign; an unknown measure is the grid's
  #assert rs_measure_feet(RS_MEASURE_GRID, 0, 0) == 0 && rs_measure_feet(RS_MEASURE_GRID, 3, 0) == 15 && rs_measure_feet(RS_MEASURE_GRID, 0, 3) == 15;
  #assert rs_measure_feet(RS_MEASURE_GRID, 3, 3) == 15 && rs_measure_feet(RS_MEASURE_GRID, -4, 3) == 20 && rs_measure_feet(RS_MEASURE_GRID, 3, -4) == 20;
  #assert rs_measure_feet(RS_MEASURE_GRID, 2, 5) == 25 && rs_measure_feet(RS_MEASURE_GRID, 5, 2) == 25 && rs_measure_feet(7, 3, 3) == 15 && rs_measure_feet(-1, 6, 6) == 30;
  // the straight line: rows and columns as the grid; a diagonal is longer
  #assert rs_measure_feet(RS_MEASURE_STRAIGHT, 0, 0) == 0 && rs_measure_feet(RS_MEASURE_STRAIGHT, 3, 0) == 15 && rs_measure_feet(RS_MEASURE_STRAIGHT, 0, -3) == 15 && rs_measure_feet(RS_MEASURE_STRAIGHT, -24, 0) == 120;
  // the eight squares round you are within 5 feet in both
  #assert rs_measure_feet(RS_MEASURE_STRAIGHT, 1, 1) == 5 && rs_measure_feet(RS_MEASURE_STRAIGHT, -1, 1) == 5 && rs_measure_feet(RS_MEASURE_STRAIGHT, 1, 0) == 5 && rs_measure_feet(RS_MEASURE_STRAIGHT, 0, 1) == 5;
  // (2,1) is 2.24 squares, (2,2) 2.83, (3,3) 4.24, (3,4) exactly 5, (6,6) 8.49, (17,17) 24.04, (18,18) 25.46
  #assert rs_measure_feet(RS_MEASURE_STRAIGHT, 2, 1) == 10 && rs_measure_feet(RS_MEASURE_STRAIGHT, 2, 2) == 15 && rs_measure_feet(RS_MEASURE_STRAIGHT, 3, 3) == 20;
  #assert rs_measure_feet(RS_MEASURE_STRAIGHT, 3, 4) == 25 && rs_measure_feet(RS_MEASURE_STRAIGHT, -4, -3) == 25 && rs_measure_feet(RS_MEASURE_STRAIGHT, 6, 6) == 40;
  #assert rs_measure_feet(RS_MEASURE_STRAIGHT, 17, 17) == 120 && rs_measure_feet(RS_MEASURE_STRAIGHT, 18, 18) == 125 && rs_measure_feet(RS_MEASURE_GRID, 18, 18) == 90;
  // (2,3) is 3.61 squares: 4; (1,2) is 2.24: 2; (5,0) and (0,5) need every step of the search
  #assert rs_measure_feet(RS_MEASURE_STRAIGHT, 2, 3) == 20 && rs_measure_feet(RS_MEASURE_STRAIGHT, 1, 2) == 10 && rs_measure_feet(RS_MEASURE_STRAIGHT, 5, 0) == 25 && rs_measure_feet(RS_MEASURE_STRAIGHT, 0, 5) == 25 && rs_measure_feet(RS_MEASURE_STRAIGHT, 1, 0) == 5;
  // it is the nearest: within half a square of the line, and the same with the two swapped or negated
  for dx: -9..<10 { for dy: -9..<10 {
    f := rs_measure_feet(RS_MEASURE_STRAIGHT, dx, dy); r := f / RS_SQUARE; d4 := 4 * (dx * dx + dy * dy);
    #assert f == r * RS_SQUARE && f >= 0;
    #assert (2 * r - 1) * (2 * r - 1) <= d4 || r == 0;
    #assert d4 < (2 * r + 1) * (2 * r + 1);
    #assert rs_measure_feet(RS_MEASURE_STRAIGHT, dy, dx) == f && rs_measure_feet(RS_MEASURE_STRAIGHT, -dx, dy) == f && rs_measure_feet(RS_MEASURE_STRAIGHT, dx, -dy) == f;
    #assert f >= rs_measure_feet(RS_MEASURE_GRID, dx, dy) && rs_measure_feet(RS_MEASURE_GRID, dy, dx) == rs_measure_feet(RS_MEASURE_GRID, -dx, -dy);
  } }
}
#test "diagonal and straight reach are equal under the straight measure: a 120-foot bolt, a 30-foot aura, a 20-foot sphere" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 60; b[0].h = 60;
  #assert rs_set_world(b[..], RS_EVERGLADE_WORLD) && b[0].measure == RS_MEASURE_STRAIGHT;
  i := rs_add(b[..], rs_wizard("Mordra", 0, 5), 10, 10);
  row := rs_add(b[..], rs_guard("Row", 1), 34, 10);        // 24 squares along the row: 120 feet
  diag := rs_add(b[..], rs_guard("Diagonal", 1), 27, 27);  // 17 squares each way: 24.04 squares, 120 feet
  far := rs_add(b[..], rs_guard("Far", 1), 28, 28);        // 18 each way: 25.46 squares; the grid would count 90 feet
  #assert rs_feet_to(b[..], i, row) == 120 && rs_feet_to(b[..], i, diag) == 120 && rs_feet_to(b[..], i, far) == 125;
  #assert rs_range_ft(b[..], 10, 10, 28, 28) == 125 && rs_range_ft(b[..], 28, 28, 10, 10) == 125 && rs_range_ft(b[..], 10, 12, 10, 9) == 15;
  rs_start_turn(b[..], i);
  #assert rs_can_cast(b[..], i, SP_FIRE_BOLT, 0) && rs_cast(b[..], i, SP_FIRE_BOLT, 0, 0, 0, row);
  rs_start_turn(b[..], i); #assert rs_cast(b[..], i, SP_FIRE_BOLT, 0, 0, 0, diag);
  rs_start_turn(b[..], i); #assert !rs_cast(b[..], i, SP_FIRE_BOLT, 0, 0, 0, far);
  // a sphere's edge: 20 feet round (40, 40) holds (44, 40) and (43, 43) (4.24 squares) and not (44, 43) (5.0: 25 feet) though the grid's would
  z := rs_area(b[..], i, rs_spell(SP_FIREBALL), 40, 40);
  #assert z.measure == RS_MEASURE_STRAIGHT && rs_inside(z, 44, 40) && rs_inside(z, 40, 36) && rs_inside(z, 43, 43) && !rs_inside(z, 44, 43) && !rs_inside(z, 44, 44) && !rs_inside(z, 45, 40);
  // the same battle strict: the grid's count, where the corner is in
  g: [1] RsBattle; g_room: [1] RsRoom; rs_have(g[..], g_room[..]); g[0].w = 60; g[0].h = 60;
  j := rs_add(g[..], rs_wizard("Mordra", 0, 5), 10, 10); k := rs_add(g[..], rs_guard("Far", 1), 28, 28);
  #assert g[0].measure == RS_MEASURE_GRID && rs_feet_to(g[..], j, k) == 90;
  zg := rs_area(g[..], j, rs_spell(SP_FIREBALL), 40, 40);
  #assert zg.measure == RS_MEASURE_GRID && rs_inside(zg, 44, 44) && !rs_inside(zg, 45, 40);
  // a Line's length is measured the same way
  line := rs_area(b[..], i, rs_spell(SP_LIGHTNING_BOLT), 20, 20);
  #assert line.line && line.measure == RS_MEASURE_STRAIGHT;
}
