// The SRD 5.2.1 stat blocks Everglade's worlds field (#13034), beyond the townsfolk and cultists of
// npcs.coax and the Skeleton and Zombie of engine.coax. Each record keeps its source ID
// (monster/<id>), its page in the pinned PDF and the block's numbers: size, AC, HP, Speed, scores,
// saves, resistances and immunities, CR's XP and Proficiency Bonus, its traits, and its Action's
// attacks as typed stat attacks (stat-attack.coax) with Multiattack's count (stat-multiattack.coax).
// rs_monster builds the creature; rs_monster_action is what it does with its Action.
//
// Who uses which (docs/dnd/srd-compliance-ledger.md, "Used monsters"): Experimental's village and
// dungeon (metaverse/experimental-hostiles.coax DG_KIND_*) field its Bestiary models under these
// blocks: the imp as the Imp, the gremlin (the Puglin) as the Goblin Warrior, the Puglin Brute as
// the Ogre, the Imp Fiend as the Quasit and the Puglin Warlord as the Hill Giant. Conjure Animals'
// wolves in Everglade 5E's room are Wolves, and Finger of Death's risen are Zombies.
//
// What these blocks have that the worlds don't use, and so the engine doesn't run: Speed other than
// walking (the Imp's Fly 40 ft.), Senses, Languages and skills, the Imp's and the Quasit's
// Invisibility and Shape-Shift, the Quasit's Scare and the Goblin's Hide (Nimble Escape's other
// choice). Recorded on #13034.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
//   coax/bin/coax test rules/srd/monster-checks.coax --library

MON_NONE :: 0; MON_IMP :: 1; MON_QUASIT :: 2; MON_GOBLIN_WARRIOR :: 3; MON_OGRE :: 4; MON_HILL_GIANT :: 5;
MON_WOLF :: 6; MON_ZOMBIE :: 7;
MON_RAT :: 8; MON_RIDING_HORSE :: 9; MON_SPIDER :: 10; MON_BLACK_BEAR :: 11; MON_WARHORSE :: 12;   // Wild Shape's forms (wild-shape.coax)
MON_CAT :: 13;
MON_BAT :: 14;
MON_FROG :: 15;
MON_HAWK :: 16;
MON_LIZARD :: 17;
MON_OCTOPUS :: 18;
MON_OWL :: 19;
MON_RAVEN :: 20;
MON_WEASEL :: 21;
MON_ADULT_RED_DRAGON :: 22;   // Shapechange's dragon (shapechange.coax), the druid demo's (/druid)
MON_N :: 23;
RsMonsterBlock :: struct {
  id: string; name: string; page: int; xp: int; pb: int;
  size: int; ac: int; hp: int; speed: int;
  score: [6] int; saves: int;               // save proficiencies, bits of 1 << RS_STR...
  resist: int; immune: int; immune_cond: int;
  undead: bool; fiend: bool; pack: bool; magic: bool; nimble: bool; fortitude: bool; beast: bool; climb: int; jumper: bool;
  swim: int; fly: int; darkvision: int; blindsight: int;
  action: RsStatAction;
}
// The blocks' numbers, as printed (page, then the Monsters chapter's order of entries):
//   Imp (p. 300): Tiny Fiend (Devil), AC 13, HP 21 (6d4 + 6), Speed 20 ft., Fly 40 ft., Str 6 Dex 17
//     Con 13 Int 11 Wis 12 Cha 14; Resistances Cold; Immunities Fire, Poison; Poisoned; CR 1 (XP 200;
//     PB +2). Magic Resistance. Sting: +5, reach 5 ft., 6 (1d6 + 3) Piercing plus 7 (2d6) Poison.
//   Quasit (p. 317): Tiny Fiend (Demon), AC 13, HP 25 (10d4), Speed 40 ft., Str 5 Dex 17 Con 10 Int 7
//     Wis 10 Cha 10; Resistances Cold, Fire, Lightning; Immunities Poison; Poisoned; CR 1 (XP 200; PB
//     +2). Magic Resistance. Rend: +5, reach 5 ft., 5 (1d4 + 3) Slashing, and the target has the
//     Poisoned condition until the start of the quasit's next turn.
//   Goblin Warrior (p. 290): Small Fey (Goblinoid), AC 15, HP 10 (3d6), Speed 30 ft., Str 8 Dex 15
//     Con 10 Int 10 Wis 8 Cha 8; CR 1/4 (XP 50; PB +2). Scimitar: +4, reach 5 ft., 5 (1d6 + 2)
//     Slashing, plus 2 (1d4) Slashing if the attack roll had Advantage. Shortbow: +4, range 80/320
//     ft., 5 (1d6 + 2) Piercing, plus 2 (1d4) Piercing if the attack roll had Advantage. Nimble
//     Escape: a Bonus Action Disengage or Hide.
//   Ogre (p. 312): Large Giant, AC 11, HP 68 (8d10 + 24), Speed 40 ft., Str 19 Dex 8 Con 16 Int 5
//     Wis 7 Cha 7; CR 2 (XP 450; PB +2). Greatclub: +6, reach 5 ft., 13 (2d8 + 4) Bludgeoning.
//     Javelin: +6, reach 5 ft. or range 30/120 ft., 11 (2d6 + 4) Piercing.
//   Hill Giant (p. 298): Huge Giant, AC 13, HP 105 (10d12 + 40), Speed 40 ft., Str 21 Dex 8 Con 19
//     Int 5 Wis 9 Cha 6; CR 5 (XP 1,800; PB +3). Multiattack: two attacks, Tree Club or Trash Lob in
//     any combination. Tree Club: +8, reach 10 ft., 18 (3d8 + 5) Bludgeoning; a Large or smaller
//     target has the Prone condition. Trash Lob: +8, range 60/240 ft., 16 (2d10 + 5) Bludgeoning,
//     and the target has the Poisoned condition until the end of its next turn.
//   Wolf (p. 364): Medium Beast, AC 12, HP 11 (2d8 + 2), Speed 40 ft., Str 14 Dex 15 Con 12 Int 3
//     Wis 12 Cha 6; CR 1/4 (XP 50; PB +2). Pack Tactics. Bite: +4, reach 5 ft., 5 (1d6 + 2)
//     Piercing; a Medium or smaller target has the Prone condition.
//   Zombie (p. 343): Medium Undead, AC 8, HP 15 (2d8 + 6), Speed 20 ft., Str 13 Dex 6 Con 16 Int 3
//     Wis 6 (save +0) Cha 5; Immunities Poison; Exhaustion, Poisoned; CR 1/4 (XP 50; PB +2). Undead
//     Fortitude. Slam: +3, reach 5 ft., 5 (1d8 + 1) Bludgeoning.
//   Black Bear (p. 345): Medium Beast, AC 11, HP 19 (3d8 + 6), Speed 30 ft., Climb 30 ft., Swim 30
//     ft., Str 15 Dex 12 Con 14 Int 2 Wis 12 Cha 7; CR 1/2 (XP 100; PB +2). Multiattack: two Rend
//     attacks. Rend: +4, reach 5 ft., 5 (1d6 + 2) Slashing.
//   Rat (p. 359): Tiny Beast, AC 10, HP 1 (1d4 - 1), Speed 20 ft., Climb 20 ft., Str 2 Dex 11 Con 9
//     Int 2 Wis 10 Cha 4; CR 0 (XP 10; PB +2). Agile. Bite: +2, reach 5 ft., 1 Piercing.
//   Riding Horse (p. 360): Large Beast, AC 11, HP 13 (2d10 + 2), Speed 60 ft., Str 16 Dex 13 Con 12
//     Int 2 Wis 11 Cha 7; CR 1/4 (XP 50; PB +2). Hooves: +5, reach 5 ft., 7 (1d8 + 3) Bludgeoning.
//   Spider (p. 361): Tiny Beast, AC 12, HP 1 (1d4 - 1), Speed 20 ft., Climb 20 ft., Str 2 Dex 14 Con 8
//     Int 1 Wis 10 Cha 2; CR 0 (XP 10; PB +2). Spider Climb, Web Walker. Bite: +4, reach 5 ft., 1
//     Piercing plus 2 (1d4) Poison.
//   Warhorse (p. 364): Large Beast, AC 11, HP 19 (3d10 + 3), Speed 60 ft., Str 18 Dex 12 Con 13 Int 2
//     Wis 12 (save +3) Cha 7; CR 1/2 (XP 100; PB +2). Hooves: +6, reach 5 ft., 9 (2d4 + 4)
//     Bludgeoning (its charge's extra 2d4 and Prone after a 20-foot straight run isn't run).
//   Cat (p. 346): Tiny Beast, AC 12, HP 2 (1d4), Speed and Climb 40 ft., Str 3 Dex 15
//     (save +4) Con 10 Int 3 Wis 12 Cha 7; CR 0 (XP 10; PB +2). Jumper. Scratch: +4,
//     reach 5 ft., 1 Slashing.
//   Adult Red Dragon (p. 318): Huge Dragon (Chromatic), AC 19, HP 256 (19d12 + 133), Speed 40 ft.,
//     Climb 40 ft., Fly 80 ft., Str 27 Dex 10 (save +6) Con 25 Int 16 Wis 13 (save +7) Cha 23;
//     Immunities Fire; Blindsight 60 ft., Darkvision 120 ft.; CR 17 (XP 18,000; PB +6). Legendary
//     Resistance. Multiattack: three Rend attacks. Rend: +14, reach 10 ft., 13 (1d10 + 8) Slashing
//     plus 5 (2d4) Fire. Fire Breath (Recharge 5-6): Dexterity save DC 21, each creature in a 60-foot
//     Cone, 59 (17d6) Fire on a failure, half on a success (dragon-actions.coax). Its Spellcasting
//     (Command, Detect Magic, Scorching Ray, Fireball) and Legendary Actions aren't run.
// The Beasts' Climb, the Rat's Agile and the Spider's webs are kept as its climb Speed only.
// They are kept as compact rows (the Lab's Wasm budget): a block's row is page, XP, PB, size, AC,
// HP, Speed, the six scores, save bits, resistance, immunity and condition-immunity bits, MF_*
// flags, its first attack row, the Action's records and Multiattack's count. An attack's row is
// bonus, dice, sides, flat, damage kind, ability, reach, range, long range, second damage's dice,
// sides and kind, the Advantage dice and sides, its RS_RIDE_* rider and the largest size it holds.
MF_UNDEAD :: 1; MF_FIEND :: 2; MF_PACK :: 4; MF_MAGIC :: 8; MF_NIMBLE :: 16; MF_FORTITUDE :: 32; MF_BEAST :: 64; MF_CLIMB :: 128; MF_JUMPER :: 256;
RS_MON_ROW :: 21; RS_MON_ATTACK_ROW :: 16;
RS_MON_ID :: [22] string.["monster/imp", "monster/quasit", "monster/goblin-warrior", "monster/ogre", "monster/hill-giant", "monster/wolf", "monster/zombie",
  "monster/rat", "monster/riding-horse", "monster/spider", "monster/black-bear", "monster/warhorse", "monster/cat",
  "monster/bat", "monster/frog", "monster/hawk", "monster/lizard", "monster/octopus", "monster/owl", "monster/raven", "monster/weasel", "monster/adult-red-dragon"];
RS_MON_NAME :: [22] string.["Imp", "Quasit", "Goblin Warrior", "Ogre", "Hill Giant", "Wolf", "Zombie", "Rat", "Riding Horse", "Spider", "Black Bear", "Warhorse", "Cat",
  "Bat", "Frog", "Hawk", "Lizard", "Octopus", "Owl", "Raven", "Weasel", "Adult Red Dragon"];
