// SRD 5.2.1 pp.24,180: current movement allowance minus feet already spent.
#authority;

// A decrease can put spent movement above the new allowance. Keep that debt,
// rather than clipping away history and granting fresh movement on restoration.
rs_reprice_movement :: (t: [] RsTurn, allowance: int) #effects(all) {
  if !t[0].move_tracked { t[0].move_tracked=true; t[0].move_basis=allowance; return; }
  net := t[0].move_left*5+t[0].move_feet-t[0].move_debt+allowance-t[0].move_basis;
  left := rs_max(net,0);
  t[0].move_left=left/5; t[0].move_feet=left%5;
  t[0].move_debt=rs_max(-net,0); t[0].move_basis=allowance;
}
rs_movement_allowance :: (b: [] RsBattle, i: int) -> int #effects(all) {
  speed := rs_dash_speed(b,i);
  return rs_timing_move(b[0].timing,speed)+b[0].turn.dash_n*speed;
}
// Explicit query for raw-grid loops. Refuses another actor's turn before reads.
rs_movement_left :: (b: [] RsBattle, i: int) -> int #effects(all) {
  if i<0 || i>=b[0].n || b[0].who!=i { return 0; }
  t: [1] RsTurn; t[0]=b[0].turn;
  rs_reprice_movement(t[..],rs_movement_allowance(b,i)); b[0].turn=t[0];
  return b[0].turn.move_left*5+b[0].turn.move_feet;
}

#test "repricing preserves spent feet through loss and restoration including an overspent allowance" {
  for initial: 0..<42 { for spent: 0..<initial+1 { for reduced: 0..<42 {
    t: [1] RsTurn; t[0].move_tracked=true; t[0].move_basis=initial;
    t[0].move_left=(initial-spent)/5; t[0].move_feet=(initial-spent)%5;
    rs_reprice_movement(t[..],reduced);
    #assert t[0].move_left*5+t[0].move_feet==rs_max(reduced-spent,0);
    #assert t[0].move_debt==rs_max(spent-reduced,0) && t[0].move_basis==reduced;
    rs_reprice_movement(t[..],initial);
    #assert t[0].move_left*5+t[0].move_feet==initial-spent && t[0].move_debt==0;
  } } }
}
#test "a manually supplied untracked turn binds its initial basis without discarding explicit credit" {
  t: [1] RsTurn; t[0].move_left=3; t[0].move_feet=2;
  rs_reprice_movement(t[..],30);
  #assert t[0].move_tracked && t[0].move_basis==30 && t[0].move_left==3 && t[0].move_feet==2;
  rs_reprice_movement(t[..],20);
  #assert t[0].move_left==1 && t[0].move_feet==2;
}

#test "movement queries bind only a logical actor in its own turn and preserve unrelated budgets" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=8; b[0].h=8;
  _ := rs_add(b[..],rs_rogue("Runner",0,3),1,1); rs_start_turn(b[..],0);
  b[0].turn.action=true; b[0].turn.bonus=true;
  #assert rs_movement_left(b[..],0)==30;
  b[0].c[0].speed=37;
  #assert rs_movement_left(b[..],0)==37 && b[0].turn.move_left==7 && b[0].turn.move_feet==2;
  b[0].who = -1;
  #assert rs_movement_left(b[..],-1)==0 && rs_movement_left(b[..],0)==0;
  b[0].who=b[0].n; b[0].c[b[0].n]=b[0].c[0];
  #assert rs_movement_left(b[..],b[0].n)==0;
  #assert b[0].turn.move_left==7 && b[0].turn.move_feet==2 && b[0].turn.action && b[0].turn.bonus;
}
