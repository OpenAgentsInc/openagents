// SRD 5.2.1 Rules Glossary Climbing, Swimming, Climb/Swim Speed, Jumping, Long Jump, High
// Jump; Monk's Step of the Wind (p.50) and the Thief's Second-Story Work (p.64). A square's
// climbing or swimming surface is the world's terrain fact (cover.coax). Each costs 5 more feet
// a square (1 a foot) unless the creature has that Speed; the extras add to crawling's and
// Difficult Terrain's, as the glossary's "2 extra feet in Difficult Terrain" reads. A Climb or
// Swim Speed is used in place of Speed: the turn's walking budget pays for it.
#authority;

// The feet one step to (x, y) costs i: crawling, Difficult Terrain, climbing and swimming without
// the matching Speed, and dragging what it grapples (grapple.coax).
rs_step_cost :: (b: [] RsBattle, i: int, x: int, y: int) -> int #effects(all) {
  bits := rs_terrain_at(b, x, y);
  cost := rs_step_feet(rs_has(b[0].c[i], RS_PRONE), rs_difficult(b, x, y));
  if (bits & TR_CLIMB) != 0 && b[0].c[i].climb <= 0 { cost += 5; }
  if (bits & TR_SWIM) != 0 && b[0].c[i].swim <= 0 { cost += 5; }
  return cost + rs_drag_feet(b, i, x, y);
}
// The score a jump's distance counts from: Strength, or Dexterity for a Jumper if that is more.
rs_jump_score :: (c: RsCreature) -> int #effects(all) {
  return ifx c.jumper then rs_max(c.score[RS_STR], c.score[RS_DEX]) else c.score[RS_STR];
}
// Whether i can jump now: its own turn, able to move, on its feet, not anchored, Speed above 0.
rs_jump_ready :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  if i < 0 || i >= b[0].n || b[0].reaction_frame.on || b[0].who != i { return false; }
  return rs_can_move(b[0].c[i]) && !rs_has(b[0].c[i], RS_PRONE) && !b[0].turn.anchored && rs_walk_speed(b, i) > 0;
}
// The jump's reach, given its full length: a standing jump (less than 10 feet moved on foot just
// before) goes half as far; Step of the Wind doubles it for the turn.
rs_jump_reach :: (b: [] RsBattle, full: int) -> int #effects(all) {
  r := ifx b[0].turn.run_ft >= 10 then full else full / 2;
  return ifx b[0].turn.jumps_doubled then r * 2 else r;
}
// Pay `feet` of the turn's movement; false and nothing spent if it hasn't them.
rs_jump_pay :: (b: [] RsBattle, i: int, feet: int) -> bool #effects(all) {
  t: [1] RsTurn; t[0] = b[0].turn;
  rs_reprice_movement(t[..], rs_movement_allowance(b, i));
  if !rs_pay_move(t[..], feet) { return false; }
  b[0].turn = t[0]; b[0].turn.moved = true; b[0].turn.run_ft = 0;
  rs_rest_interrupt_at(b[0].c, i);   // a jump closes either rest phase (rs_rest_motion)
  return true;
}
// A Long Jump to the open square (x, y): up to the jump score in feet, each foot costing a foot of
// movement, over whatever lies between. Landing in Difficult Terrain takes a DC 10 Dexterity
// (Acrobatics) check or the creature is Prone.
rs_long_jump :: (b: [] RsBattle, i: int, x: int, y: int) -> bool #effects(all) {
  if !rs_jump_ready(b, i) || x < 0 || y < 0 || x >= b[0].w || y >= b[0].h || rs_at(b, x, y) >= 0 { return false; }
  ox := b[0].c[i].x; oy := b[0].c[i].y;
  feet := rs_feet(ox, oy, x, y);
  if feet > rs_jump_reach(b, rs_jump_score(b[0].c[i])) || !rs_jump_pay(b, i, feet) { return false; }
  rs_truth_move(b,i,x,y);
  rs_drag_follow(b, i, ox, oy);
  rs_say(b, RS_EV_CONDITION, i, i, feet, " makes a Long Jump");
  if rs_difficult(b, x, y) && !rs_ability_check(b, i, RsAbilityRequest.{ability = RS_DEX, skill = SK_ACROBATICS, dc = 10}).passed {
    b[0].c[i].cond |= rs_effect_condition_mask(b[0].c[i], RS_PRONE);
  }
  return true;
}
// A High Jump: 3 + Strength modifier feet up (at least 0), each foot a foot of movement. Its
// height, or -1 when refused.
rs_high_jump :: (b: [] RsBattle, i: int) -> int #effects(all) {
  if !rs_jump_ready(b, i) { return -1; }
  feet := rs_jump_reach(b, rs_max(3 + rs_mod(rs_jump_score(b[0].c[i])), 0));
  if !rs_jump_pay(b, i, feet) { return -1; }
  rs_say(b, RS_EV_CONDITION, i, i, feet, " makes a High Jump");
  return feet;
}
// Feet walked on foot just before a jump: a step on foot counts, crawling starts over.
rs_run_up :: (b: [] RsBattle, i: int, feet: int) #effects(all) {
  b[0].turn.run_ft = ifx rs_has(b[0].c[i], RS_PRONE) then 0 else b[0].turn.run_ft + feet;
}

#test "a step adds climbing, swimming, crawling and Difficult Terrain costs, sparing a matching Speed" {
  b: [1] RsBattle; jump_field(b[..]);
  _ := rs_terrain_put(b[..], TR_CLIMB, 2, 1, 2, 1); _ = rs_terrain_put(b[..], TR_SWIM, 3, 1, 3, 1); _ = rs_terrain_put(b[..], TR_CLIMB | TR_DIFFICULT, 4, 1, 4, 1);
  _ = rs_terrain_put(b[..], TR_SWIM | TR_CLIMB, 5, 1, 5, 1);
  #assert rs_step_cost(b[..], 0, 1, 2) == 5 && rs_step_cost(b[..], 0, 2, 1) == 10 && rs_step_cost(b[..], 0, 3, 1) == 10 && rs_step_cost(b[..], 0, 4, 1) == 15 && rs_step_cost(b[..], 0, 5, 1) == 15;
  b[0].c[0].climb = 30; #assert rs_step_cost(b[..], 0, 2, 1) == 5 && rs_step_cost(b[..], 0, 3, 1) == 10 && rs_step_cost(b[..], 0, 4, 1) == 10 && rs_step_cost(b[..], 0, 5, 1) == 10;
  b[0].c[0].swim = 30; #assert rs_step_cost(b[..], 0, 3, 1) == 5 && rs_step_cost(b[..], 0, 5, 1) == 5;
  b[0].c[0].climb = 0; b[0].c[0].cond |= RS_PRONE; #assert rs_step_cost(b[..], 0, 4, 1) == 20 && rs_step_cost(b[..], 0, 1, 2) == 10;
}
#test "a step that drags an equal-sized creature adds five feet to its movement cost" {
  b:[1]RsBattle; c:[2]RsCreature; b[0].c=c[..]; b[0].w=12; b[0].h=8;
  a:=rs_add(b[..],rs_fighter("Grappler",0,1),2,1);
  j:=rs_add(b[..],rs_fighter("Held",1,1),1,1);
  c[a].grappling=j;
  #assert rs_step_cost(b[..],a,3,1)==10;
}

#test "a climbing step pays its extra cost through the shared step, and the run-up starts over crawling" {
  b: [1] RsBattle; jump_field(b[..]);
  _ := rs_terrain_put(b[..], TR_CLIMB, 2, 1, 2, 1);
  #assert rs_step_to(b[..], 0, 2, 1) && rs_movement_left(b[..], 0) == 20 && b[0].turn.run_ft == 5;
  #assert rs_step_to(b[..], 0, 3, 1) && b[0].turn.run_ft == 10;
  b[0].c[0].cond |= RS_PRONE; #assert rs_step_to(b[..], 0, 4, 1) && b[0].turn.run_ft == 0 && rs_movement_left(b[..], 0) == 5;
  #assert !rs_step_to(b[..], 0, 5, 1);   // 10 feet crawling, 5 left
  b[0].c[0].cond = 0; #assert rs_step_ready(b[..], 0, 5, 1) && rs_step_ready(b[..], 0, 3, 1);
  _ = rs_terrain_put(b[..], TR_SWIM, 5, 1, 5, 1); #assert !rs_step_ready(b[..], 0, 5, 1) && rs_step_ready(b[..], 0, 3, 1);
}
#test "a running Long Jump reaches the jump score in feet, a standing one half; a Jumper may use Dexterity" {
  for mode: 0..<8 {
    b: [1] RsBattle; jump_field(b[..]);
    if mode >= 1 { #assert rs_step_to(b[..], 0, 2, 1) && rs_step_to(b[..], 0, 3, 1); }   // 10 feet on foot
    if mode == 2 || mode == 6 { b[0].c[0].jumper = true; } else if mode == 3 { b[0].turn.jumps_doubled = true; }
    else if mode == 4 { b[0].c[0].score[RS_STR] = 9; } else if mode == 7 { b[0].c[0].score[RS_DEX] = 8; b[0].c[0].jumper = true; }
    to := ifx mode == 0 then 2 else ifx mode == 2 || mode == 3 then 6 else ifx mode == 6 then 7 else 5;
    from := ifx mode == 0 then 1 else 3;
    ok := mode != 4 && mode != 5 && mode != 6;
    if mode == 5 { to = 6; }
    left := rs_movement_left(b[..], 0);
    #assert rs_long_jump(b[..], 0, to, 1) == ok;
    if ok { #assert b[0].c[0].x == to && rs_movement_left(b[..], 0) == left - (to - from) * 5 && b[0].turn.run_ft == 0 && b[0].turn.moved && rs_at(b[..], to, 1) == 0; }
    else { #assert b[0].c[0].x == from && rs_movement_left(b[..], 0) == left; }
  }
}
#test "a Long Jump needs the feet, an open square on the grid and a creature free to move" {
  for mode: 0..<10 {
    b: [1] RsBattle; jump_field(b[..]);
    x := 2; y := 1;
    if mode == 1 { x = 12; } else if mode == 2 { y = -1; } else if mode == 3 { rs_place(b[..], 1, 2, 1); } else if mode == 4 { b[0].c[0].cond |= RS_PRONE; }
    else if mode == 5 { b[0].turn.anchored = true; } else if mode == 6 { b[0].who = 1; } else if mode == 7 { b[0].turn.move_left = 0; b[0].turn.move_feet = 4; }
    else if mode == 8 { b[0].c[0].cond |= RS_GRAPPLED; } else if mode == 9 { x = 1; y = 6; }
    #assert rs_long_jump(b[..], 0, x, y) == (mode == 0);
  }
  b: [1] RsBattle; jump_field(b[..]); b[0].c[0].speed = 0; #assert !rs_long_jump(b[..], 0, 2, 1) && rs_high_jump(b[..], 0) == -1;
  c: [1] RsBattle; jump_field(c[..]); c[0].reaction_frame.on = true; #assert !rs_jump_ready(c[..], 0); c[0].reaction_frame.on = false;
  #assert !rs_jump_ready(c[..], -1) && !rs_jump_ready(c[..], 2) && rs_jump_ready(c[..], 0);
  #assert !rs_long_jump(c[..], 0, -1, 1) && !rs_long_jump(c[..], 0, 1, -1) && !rs_long_jump(c[..], 0, 1, 1);
}
#test "landing in Difficult Terrain takes DC 10 Acrobatics or the jumper is Prone" {
  for dex: [3] int.[8, 10, 12] {
    b: [1] RsBattle; jump_field(b[..]); b[0].c[0].score[RS_DEX] = dex; b[0].c[0].checks.skills = 0; b[0].c[0].checks.expert = 0;
    _ := rs_terrain_put(b[..], TR_DIFFICULT, 2, 1, 2, 1);
    #assert rs_long_jump(b[..], 0, 2, 1) && rs_has(b[0].c[0], RS_PRONE) == (dex == 8) && rs_movement_left(b[..], 0) == 25;
  }
  i: [1] RsBattle; jump_field(i[..]); i[0].c[0].score[RS_DEX] = 8; i[0].c[0].checks.skills = 0; i[0].c[0].immune_cond = RS_PRONE;
  _ := rs_terrain_put(i[..], TR_DIFFICULT, 2, 1, 2, 1);
  #assert rs_long_jump(i[..], 0, 2, 1) && !rs_has(i[0].c[0], RS_PRONE);
}
#test "a High Jump rises 3 + Strength modifier feet running, half standing, doubled by Step of the Wind" {
  b: [1] RsBattle; jump_field(b[..]);
  #assert rs_high_jump(b[..], 0) == 2 && rs_movement_left(b[..], 0) == 28;   // standing: (3 + 1) / 2
  #assert rs_step_to(b[..], 0, 2, 1) && rs_step_to(b[..], 0, 3, 1) && rs_high_jump(b[..], 0) == 4 && rs_movement_left(b[..], 0) == 14;
  b[0].turn.jumps_doubled = true; #assert rs_high_jump(b[..], 0) == 4;   // standing again, doubled
  b[0].c[0].score[RS_STR] = 3; #assert rs_high_jump(b[..], 0) == 0;   // never below 0 feet
  b[0].c[0].score[RS_STR] = 30; b[0].turn.jumps_doubled = false; #assert rs_high_jump(b[..], 0) == 6 && rs_movement_left(b[..], 0) == 4;   // standing (3 + 10) / 2
  #assert rs_high_jump(b[..], 0) == -1 && rs_movement_left(b[..], 0) == 4;   // 6 feet, 4 left
  #assert rs_jump_score(rs_rogue("R", 0, 3)) == rs_max(rs_rogue("R", 0, 3).score[RS_STR], rs_rogue("R", 0, 3).score[RS_DEX]);
}
#test "a step's extra feet: Difficult Terrain alone, and any Climb or Swim Speed at all" {
  b: [1] RsBattle; jump_field(b[..]);
  _ := rs_terrain_put(b[..], TR_DIFFICULT, 2, 1, 2, 1); _ = rs_terrain_put(b[..], TR_CLIMB | TR_SWIM, 3, 1, 3, 1);
  #assert rs_step_cost(b[..], 0, 2, 1) == 10 && rs_step_cost(b[..], 0, 3, 1) == 15;
  b[0].c[0].climb = 1; b[0].c[0].swim = 1; #assert rs_step_cost(b[..], 0, 3, 1) == 5;
}
#test "jump readiness reads only the turn's own creature in the battle, Blinded or not, with any Speed" {
  b: [1] RsBattle; jump_field(b[..]); p := rs_add(b[..], rs_rogue("Past", 0, 3), 5, 3); b[0].n -= 1;
  b[0].who = p; #assert !rs_jump_ready(b[..], p);
  b[0].who = -1; #assert !rs_jump_ready(b[..], -1);
  b[0].who = 0; b[0].c[0].cond = RS_BLINDED; #assert rs_jump_ready(b[..], 0);
  b[0].c[0].score[RS_STR] = 3; b[0].c[0].speed = 1; #assert rs_high_jump(b[..], 0) == 0;
  b[0].c[0].speed = 0; #assert rs_high_jump(b[..], 0) == -1;
}
#test "a Long Jump lands on any open square of the grid, exactly at its reach" {
  for mode: 0..<4 {
    b: [1] RsBattle; jump_field(b[..]);
    x := ifx mode == 0 then 0 else ifx mode == 2 then 11 else 1;
    y := ifx mode == 1 then 0 else ifx mode == 3 then 5 else 1;
    if mode >= 2 { rs_place(b[..], 0, ifx mode == 2 then 10 else 1, ifx mode == 3 then 4 else 1); }
    #assert rs_long_jump(b[..], 0, x, y) && b[0].c[0].x == x && b[0].c[0].y == y;
    if mode == 2 { #assert !rs_long_jump(b[..], 0, 12, 1) && b[0].c[0].x == 11; }
    if mode == 3 { #assert !rs_long_jump(b[..], 0, 1, 6) && b[0].c[0].y == 5; }
  }
  e: [1] RsBattle; jump_field(e[..]); e[0].c[0].score[RS_STR] = 10;   // standing: 5 feet
  #assert rs_long_jump(e[..], 0, 2, 1) && e[0].c[0].x == 2;
}
#test "a Long Jump pays from the movement left now, tells itself, closes a rest and brings what it holds" {
  b: [1] RsBattle; jump_field(b[..]); b[0].c[0].score[RS_STR] = 30; b[0].c[0].speed = 5;   // 15 feet standing, 5 of Speed
  #assert !rs_long_jump(b[..], 0, 3, 1) && b[0].c[0].x == 1;
  h: [1] RsBattle; jump_field(h[..]); h[0].c[0].score[RS_STR] = 30; h[0].c[0].speed = 5;
  #assert rs_high_jump(h[..], 0) == -1;
  r: [1] RsBattle; jump_field(r[..]); r[0].c[0].rest.phase = 1; r[0].c[1].rest.phase = 1;
  rs_place(r[..], 1, 0, 1); grapple_hold(r[..], 0, 1, 12);
  #assert rs_long_jump(r[..], 0, 2, 1) && r[0].c[0].rest.phase == 0 && r[0].c[1].rest.phase == 1;
  #assert r[0].c[1].x == 1 && r[0].c[1].y == 1 && r[0].c[0].grappling == 1;
  #assert act_last(r[..]).kind == RS_EV_CONDITION && act_last(r[..]).by == 0 && act_said(r[..], "Leaper makes a Long Jump");
  #assert rs_high_jump(r[..], 0) == 2 && act_last(r[..]).kind == RS_EV_CONDITION && act_said(r[..], "Leaper makes a High Jump");
}
#test "an Acrobatics-trained jumper keeps its feet; a fall adds Prone alone; the run-up runs while Blinded" {
  b: [1] RsBattle; jump_field(b[..]); b[0].c[0].score[RS_DEX] = 8; b[0].c[0].checks.skills = 1 << SK_ACROBATICS; b[0].c[0].checks.expert = 0;
  _ := rs_terrain_put(b[..], TR_DIFFICULT, 2, 1, 2, 1);
  #assert rs_long_jump(b[..], 0, 2, 1) && !rs_has(b[0].c[0], RS_PRONE);
  f: [1] RsBattle; jump_field(f[..]); f[0].c[0].score[RS_DEX] = 8; f[0].c[0].checks.skills = 0; f[0].c[0].checks.expert = 0;
  _ = rs_terrain_put(f[..], TR_DIFFICULT, 2, 1, 2, 1);
  #assert rs_long_jump(f[..], 0, 2, 1) && f[0].c[0].cond == RS_PRONE;
  w: [1] RsBattle; jump_field(w[..]); w[0].c[0].cond = RS_BLINDED; rs_run_up(w[..], 0, 5); rs_run_up(w[..], 0, 5); #assert w[0].turn.run_ft == 10;
  w[0].c[0].score[RS_STR] = 3; #assert rs_high_jump(w[..], 0) == 0;   // running, never below 0
}
