#load "battle.coax";

#test "opportunity strike spends one Reaction and no Action without moving its victim or stealing its turn" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
  _:=rs_add(b[..],rs_fighter("Reactor",1,6),3,3); _=rs_add(b[..],rs_barbarian("Mover",0,6),4,3);
  rs_start_turn(b[..],1); b[0].turn.action=true; b[0].turn.bonus=true; b[0].turn.move_left=4;
  hp:=b[0].c[1].hp;
  q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true};
  r:=rs_opportunity_attack(b[..],0,1,b[0].c[0].weapon,q);
  #assert r.admitted && r.hit && b[0].c[0].reacted;
  #assert b[0].c[1].hp<hp && b[0].c[1].hp>hp-15; // one strike, never Extra Attack
  #assert b[0].c[1].x==4 && b[0].c[1].y==3;
  #assert b[0].who==1 && b[0].turn.action && b[0].turn.bonus && b[0].turn.move_left==4 && !b[0].turn.struck;
  #assert !b[0].reaction_frame.on;
  #assert !rs_opportunity_attack(b[..],0,1,b[0].c[0].weapon,q).admitted;
}

#test "a missed opportunity is still a spent Reaction and a malformed trigger spends nothing" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
  _:=rs_add(b[..],rs_guard("Reactor",1),3,3); _=rs_add(b[..],rs_fighter("Mover",0,1),4,3); rs_start_turn(b[..],1);
  q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true};
  q.teleport=true; rolls:=b[0].dice[0].rolled; seq:=b[0].book[0].seq;
  #assert !rs_opportunity_attack(b[..],0,1,W_SPEAR,q).admitted;
  #assert !b[0].c[0].reacted && b[0].dice[0].rolled==rolls && b[0].book[0].seq==seq;
  q.teleport=false; r:=rs_opportunity_attack(b[..],0,1,W_SPEAR,q);
  #assert r.admitted && !r.hit && b[0].c[0].reacted;
}

#test "the moving caster's actual Shield observes its own spent-slot and Quickened state during an opportunity" {
  for quick:0..<2 { for spent:0..<2 {
    b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
    _:=rs_add(b[..],rs_fighter("Reactor",1,3),3,3); _=rs_add(b[..],rs_wizard("Mover",0,3),4,3);
    pick:=[1]int.[RS_EXEC_SOURCE[SP_SHIELD]]; #assert rs_set_spells(b[0].c[1..<2],pick[..]); b[0].c[1].feats = rs_feature_put(b[0].c[1].feats, RS_FT_SHIELD_SPELL, true);
    rs_start_turn(b[..],1); b[0].turn.quickened=quick==1; b[0].turn.slot_spent=spent==1;
    slots:=b[0].c[1].slots[1]; hp:=b[0].c[1].hp;
    q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true}; r:=rs_opportunity_attack(b[..],0,1,W_UNARMED,q);
    allow:=quick==0 && spent==0;
    #assert r.admitted && r.hit==!allow && b[0].c[1].reacted==allow;
    #assert b[0].c[1].slots[1]==slots-(ifx allow then 1 else 0);
    #assert (b[0].c[1].hp==hp)==allow;
    if allow { #assert rs_effect(b[0].c[1], EF_SHIELD); }
    #assert b[0].who==1 && b[0].turn.quickened==(quick==1) && b[0].turn.slot_spent==(spent==1 || allow);
  } }
}

#test "opportunity refusals preserve resource dice events and preexisting turn frames" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12;
  _:=rs_add(b[..],rs_fighter("Reactor",1,3),3,3); _=rs_add(b[..],rs_barbarian("Mover",0,6),4,3); rs_start_turn(b[..],1);
  q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true}; rolls:=b[0].dice[0].rolled; seq:=b[0].book[0].seq;
  for w:[3]int.[-1,W_ARCANE_BURST,W_ARCANE_BURST+1] {
    b[0].c[0].weapon=w; #assert !rs_opportunity_attack(b[..],0,1,w,q).admitted;
  }
  b[0].c[0].weapon=W_LONGSWORD; #assert !rs_opportunity_attack(b[..],0,1,W_DAGGER,q).admitted;
  #assert !rs_opportunity_attack(b[..],-1,1,W_UNARMED,q).admitted;
  b[0].c[0].weapon=W_SHORTBOW; #assert !rs_opportunity_attack(b[..],0,1,W_SHORTBOW,q).admitted;
  #assert rs_reaction_frame_begin(b[..],0);
  #assert !rs_opportunity_attack(b[..],0,1,W_UNARMED,q).admitted && b[0].reaction_frame.on && b[0].who==0;
  rs_reaction_frame_end(b[..]);
  b[0].c[0].weapon=W_LONGSWORD; b[0].c[0].masteries=1<<M_SAP;
  for k:0..<RS_EFFECTS { b[0].c[1].eff[k]=RsEffect.{kind=EF_EXPOSED,by=-1,spell=-1,until=100,save=-1}; }
  #assert !rs_opportunity_attack(b[..],0,1,W_LONGSWORD,q).admitted;
  #assert !b[0].c[0].reacted && b[0].dice[0].rolled==rolls && b[0].book[0].seq==seq;
  #assert b[0].who==1 && !b[0].reaction_frame.on && !b[0].turn.struck;
}

#test "opportunity weapon facts cannot be forged and a Charmed reactor cannot attack its charmer" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
  _:=rs_add(b[..],rs_guard("Reactor",1),3,3); _=rs_add(b[..],rs_barbarian("Mover",0,6),4,3); rs_start_turn(b[..],1);
  q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true,reach=1000,melee=false};
  b[0].c[0].eff[0]=RsEffect.{kind=EF_COND,cond=RS_CHARMED,by=1,spell=-1,until=100,save=-1};
  #assert !rs_opportunity_attack(b[..],0,1,W_SPEAR,q).admitted && !b[0].c[0].reacted;
  b[0].c[0].eff[0].cond=RS_BLINDED; // supplied visibility may include special senses
  #assert rs_opportunity_attack(b[..],0,1,W_SPEAR,q).admitted;
}

#test "opportunity Sneak Attack uses its actor's own-turn marks or a separate off-turn strike scope" {
  for own:0..<2 {
    b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
    _:=rs_add(b[..],rs_rogue("Reactor",1,3),3,3); _=rs_add(b[..],rs_barbarian("Mover",0,6),4,3);
    _=rs_add(b[..],rs_guard("Ally",1),4,4);
    rs_start_turn(b[..],ifx own==1 then 0 else 1); b[0].turn.sneaked=true;
    hp:=b[0].c[1].hp; q:=RsOpportunityMove.{x=5,y=3,seen=true,reaction=true};
    r:=rs_opportunity_attack(b[..],0,1,W_SHORTSWORD,q);
    #assert r.admitted && r.hit && b[0].c[1].hp==hp-(ifx own==1 then 6 else 12);
    #assert b[0].turn.sneaked && r.strike.sneaked;
  }
}

#test "opportunity preflight reserves one target's one rider rather than retargeting Extra Attack" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
  _:=rs_add(b[..],rs_fighter("Reactor",1,3),3,3); _=rs_add(b[..],rs_barbarian("Mover",0,6),4,3);
  _=rs_add(b[..],rs_barbarian("Bystander",0,6),4,4);
  b[0].c[0].weapon=W_LONGSWORD; b[0].c[0].masteries=1<<M_SAP;
  for k:0..<RS_EFFECTS { b[0].c[2].eff[k]=RsEffect.{kind=EF_EXPOSED,by=-1,spell=-1,until=100,save=-1}; }
  for k:0..<RS_EFFECTS-1 { b[0].c[1].eff[k]=RsEffect.{kind=EF_EXPOSED,by=-1,spell=-1,until=100,save=-1}; }
  rs_start_turn(b[..],1); hp:=b[0].c[2].hp;
  q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true};
  #assert rs_opportunity_attack(b[..],0,1,W_LONGSWORD,q).admitted;
  #assert b[0].c[2].hp==hp;
}

#test "opportunity critical returns the Champion's immediate movement credit without moving or refilling the mover" #steps 400000000 {
  critical:=false;
  for seed:1..<65 {
    b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12;
    _:=rs_add(b[..],rs_fighter("Champion",1,3),3,3); _=rs_add(b[..],rs_barbarian("Mover",0,6),4,3);
    rs_start_turn(b[..],1); b[0].dice[0].state=cast(u64)seed*7919; b[0].turn.move_left=4;
    q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true}; r:=rs_opportunity_attack(b[..],0,1,b[0].c[0].weapon,q);
    #assert r.admitted && b[0].turn.move_left==4 && b[0].c[1].x==4;
    if r.strike.move_left>0 { critical=true; #assert r.strike.move_left==3; }
  }
  #assert critical;
}

#test "opportunity rider deadlines use the reactor's upcoming turn rather than a borrowed extra turn" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12;
  _:=rs_add(b[..],rs_fighter("Reactor",1,3),3,3); _=rs_add(b[..],rs_wizard("Mover",0,3),4,3);
  rs_start_turn(b[..],1); b[0].c[0].turn_at=6;
  #assert rs_reaction_frame_begin(b[..],0);
  #assert rs_next_turn_tick(b[..],0)==6;
  #assert rs_own_turn_end(b[..],1)==rs_beat(b[..]);
  rs_reaction_frame_end(b[..]);
}

#test "an opportunity kill releases Hex for the reactor's upcoming turn" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
  _:=rs_add(b[..],rs_fighter("Reactor",1,3),3,3); _=rs_add(b[..],rs_guard("Mover",0),4,3);
  rs_start_turn(b[..],1); b[0].c[0].turn_at=6; b[0].c[0].conc=SP_HEX;
  b[0].c[1].eff[0]=RsEffect.{kind=EF_HEX,by=0,spell=SP_HEX,until=60}; b[0].c[1].hp=1; b[0].c[1].ac=10;
  q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true}; r:=rs_opportunity_attack(b[..],0,1,W_UNARMED,q);
  #assert r.admitted && r.hit && b[0].c[1].hp==0;
  #assert b[0].c[0].note[RS_NT_CURSE_FREE] != 0 && b[0].c[0].note[RS_NT_CURSE_AFTER]==6-rs_beat(b[..]);
  #assert b[0].who==1 && !b[0].reaction_frame.on;
}
