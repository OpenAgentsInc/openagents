#load "opportunity-attack-checks.coax";
#load "reaction-frame-checks.coax";
#load "../../coax/lib/sys/tool.coax";

tool_main :: ()->int #export_c #effects(all) {
  for mode:0..<4 {
    b:[1] RsBattle; b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
    _:=rs_add(b[..],rs_fighter("Reactor",1,3),3,3); _=rs_add(b[..],rs_wizard("Mover",0,3),4,3);
    pick:=[1]int.[RS_EXEC_SOURCE[SP_SHIELD]]; if !rs_set_spells(b[0].c[1..<2],pick[..]) { return 1; } b[0].c[1].feats = rs_feature_put(b[0].c[1].feats, RS_FT_SHIELD_SPELL, true);
    rs_start_turn(b[..],1); b[0].turn.slot_spent=(mode&1)!=0; b[0].turn.quickened=(mode&2)!=0;
    slots:=b[0].c[1].slots[1]; hp:=b[0].c[1].hp;
    q:=RsOpportunityMove.{x=5,y=3,seen=true,movement=true}; r:=rs_opportunity_attack(b[..],0,1,W_UNARMED,q);
    if !r.admitted || r.hit!=(mode!=0) || !b[0].c[0].reacted { return 2; }
    if b[0].c[1].slots[1]!=slots-(ifx mode==0 then 1 else 0) || (b[0].c[1].hp==hp)!=(mode==0) { return 3; }
    if mode==0 && !rs_effect(b[0].c[1], EF_SHIELD) { return 6; }
    if b[0].who!=1 || b[0].reaction_frame.on || b[0].c[1].x!=4 { return 4; }
    if rs_opportunity_attack(b[..],0,1,W_UNARMED,q).admitted { return 5; }
  }
  tool_errln("PASS OPPORTUNITY-ATTACK"); return 0;
}
