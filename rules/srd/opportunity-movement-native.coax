#load "opportunity-movement-checks.coax";
#load "../../coax/lib/sys/tool.coax";
tool_main :: ()->int #export_c #effects(all) {
  for down:0..<2 {
    b:[1]RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=12; b[0].h=12; b[0].dice[0].fixed=true;
    _:=rs_add(b[..],rs_fighter("Reactor",1,3),3,3); _=rs_add(b[..],rs_guard("Mover",0),4,3); rs_start_turn(b[..],1);
    b[0].c[1].ac=10; if down==1 { b[0].c[1].hp=1; }
    choices:=[1]RsOpportunityChoice.[RsOpportunityChoice.{actor=0,weapon=W_UNARMED,seen=true}];
    moved:=rs_step_reactions(b[..],1,5,3,choices[..]);
    if moved!=(down==0) || !b[0].c[0].reacted || b[0].c[1].x!=(ifx down==0 then 5 else 4) { return 1; }
    if b[0].turn.moved!=moved || b[0].reaction_frame.on || b[0].who!=1 { return 2; }
  }
  tool_errln("PASS OPPORTUNITY-MOVEMENT"); return 0;
}
