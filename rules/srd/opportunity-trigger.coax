// SRD 5.2.1 p.15: the visible creature leaves reach, using its own movement,
// Action, Bonus Action or Reaction. Teleportation and Disengage do not provoke.
#authority;
// Authoritative caller facts: visibility (including special senses), declared
// melee-attack reach, and the resources causing this proposed displacement.
// This is a trigger query, not movement admission, weapon selection or a hit.
RsOpportunityMove :: struct {
  x:int; y:int; reach:int; melee:bool; seen:bool; teleport:bool;
  movement:bool; action:bool; bonus:bool; reaction:bool;
  measured:bool; from_feet:f32; to_feet:f32; // trusted physical metric, not rounded cells
}
rs_opportunity_trigger :: (b:[] RsBattle,reactor:int,mover:int,q:RsOpportunityMove)->bool #effects(all) {
  if reactor<0 || reactor>=b[0].n || mover<0 || mover>=b[0].n || reactor==mover { return false; }
  if b[0].c[reactor].familiar_owner>0 || !rs_capable(b[0].c[reactor]) || b[0].c[reactor].reacted || rs_effect(b[0].c[reactor], EF_ADDLED) || b[0].c[mover].dead { return false; }
  if !q.melee || !q.seen || q.teleport || !(q.movement || q.action || q.bonus || q.reaction) { return false; }
  if b[0].who==mover && b[0].turn.disengaged { return false; }
  rx:=b[0].c[reactor].x; ry:=b[0].c[reactor].y;
  mx:=b[0].c[mover].x; my:=b[0].c[mover].y;
  if rx<0 || ry<0 || mx<0 || my<0 || rx>=b[0].w || mx>=b[0].w || ry>=b[0].h || my>=b[0].h { return false; }
  if q.measured { return q.from_feet>=0 && q.from_feet<=f32(q.reach) && q.to_feet>f32(q.reach); }
  if q.x<0 || q.y<0 || q.x>=b[0].w || q.y>=b[0].h { return false; }
  return rs_feet(rx,ry,mx,my)<=q.reach && rs_feet(rx,ry,q.x,q.y)>q.reach;
}
rs_opportunity_suppress :: (c:[] RsCreature) #effects(all) { c[0].eff = rs_state_put(c[0].eff, EF_ADDLED, true); }
rs_opportunity_begin :: (c:[] RsCreature) #effects(all) { c[0].eff = rs_state_put(c[0].eff, EF_ADDLED, false); }

#test "opportunity suppression retires at an actual turn hook rather than consuming a Reaction" {
  c:[1] RsCreature; c[0].reacted=true;
  rs_opportunity_suppress(c[..]); #assert rs_effect(c[0], EF_ADDLED) && c[0].reacted;
  rs_opportunity_begin(c[..]); #assert !rs_effect(c[0], EF_ADDLED) && c[0].reacted;
}
#test "a default opportunity query cannot silently assume visibility or active movement" {
  b:[1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w=8; b[0].h=8;
  _:=rs_add(b[..],rs_guard("Guard",1),2,2); _=rs_add(b[..],rs_fighter("Mover",0,1),3,2);
  #assert !rs_opportunity_trigger(b[..],0,1,RsOpportunityMove.{});
}
