// Protection from Evil and Good, SRD 5.2.1 p. 157.
#authority;

RS_PROTECTION_CONDITIONS :: RS_CHARMED|RS_FRIGHTENED;

rs_protection_type :: (c:RsCreature)->bool #effects(all) {
  return c.aberration || c.celestial || c.elemental || c.fey || c.fiend || c.undead;
}
rs_protected_from :: (b:[]RsBattle,target:int,source:int)->bool #effects(all) {
  return source>=0 && source<b[0].n && rs_effect(b[0].c[target],EF_PROTECTION) && rs_protection_type(b[0].c[source]);
}
rs_protection_save_ups :: (b:[]RsBattle,target:int,e:RsEffect)->int #effects(all) {
  return ifx (rs_effect_conditions(e)&RS_PROTECTION_CONDITIONS)!=0 && rs_protected_from(b,target,e.by) then 1 else 0;
}

#test "Protection is source-specific and wards against all six named creature types" {
  b:[1]RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c:[2]RsCreature; b[0].c=c[..]; b[0].n=2;
  for kind:0..<7 {
    c[0]=RsCreature.{aberration=kind==0,celestial=kind==1,elemental=kind==2,fey=kind==3,fiend=kind==4,undead=kind==5};
    c[1]=RsCreature.{};
    fear:=RsEffect.{kind=EF_COND,cond=RS_FRIGHTENED|RS_POISONED,by=0,save=RS_WIS};
    #assert rs_put_effect(b[..],1,fear);
    #assert rs_protection_save_ups(b[..],1,fear)==0;
    #assert rs_put_effect(b[..],1,RsEffect.{kind=EF_PROTECTION,by=1,save=-1});
    #assert rs_protected_from(b[..],1,0)==(kind<6);
    #assert !rs_protected_from(b[..],1,-1) && !rs_protected_from(b[..],1,2);
    #assert rs_protection_save_ups(b[..],1,fear)==(ifx kind<6 then 1 else 0);
    #assert rs_has(c[1],RS_FRIGHTENED);
    rs_effect_end(c[1..<2],0);
    #assert rs_put_effect(b[..],1,fear);
    #assert rs_has(c[1],RS_POISONED) && rs_has(c[1],RS_FRIGHTENED)==(kind==6);
    fear.cond=RS_CHARMED;
    #assert rs_put_effect(b[..],1,fear) && rs_has(c[1],RS_CHARMED)==(kind==6);
    fear.cond=RS_POISONED;
    #assert rs_protection_save_ups(b[..],1,fear)==0;
    fear.cond=RS_BLINDED;
    #assert rs_protection_save_ups(b[..],1,fear)==0;
    #assert rs_put_effect(b[..],1,fear) && rs_has(c[1],RS_BLINDED);
  }
}

#test "Protection grants Advantage on the repeat save for a Charmed or Frightened condition already present" {
  for ward:0..<2 {
    b:[1]RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c:[2]RsCreature; b[0].c=c[..]; b[0].w=8; b[0].h=8;
    i:=rs_add(b[..],rs_monster(MON_IMP,"Fiend",1),1,1);
    j:=rs_add(b[..],rs_fighter("Target",0,1),2,1);
    #assert rs_put_effect(b[..],j,RsEffect.{kind=EF_COND,cond=RS_CHARMED,by=i,spell=-1,save=RS_WIS,dc=99});
    if ward==1 { #assert rs_put_effect(b[..],j,RsEffect.{kind=EF_PROTECTION,by=j,spell=SP_PROTECTION_GOOD_EVIL,save=-1}); }
    b[0].turn.new_round=true;
    b[0].dice[0].fixed=true;
    rolls:=b[0].dice[0].rolled;
    rs_end_turn(b[..],j);
    #assert b[0].dice[0].rolled==rolls+1+ward && rs_has(c[j],RS_CHARMED);
  }
}
