// The Hunter's Hunter's Lore (SRD 5.2.1 p. 61): while a creature is marked by the Ranger's Hunter's
// Mark, the Ranger knows whether it has any Immunities, Resistances or Vulnerabilities, and what
// they are. The battle answers what the Ranger knows; a world shows it.
//   coax/bin/coax test --library rules/srd/class-ranger-checks.coax
#authority;

RsLore :: struct { known: bool; resist: int; vulnerable: int; immune: int; immune_cond: int; }

// What i's Hunter's Lore tells it of j: nothing unless i has the feature and j bears i's mark.
rs_hunters_lore :: (b: [] RsBattle, i: int, j: int) -> RsLore #effects(all) {
  r: RsLore;
  if i < 0 || i >= b[0].n || j < 0 || j >= b[0].n || !rs_has_feature(b[0].c[i], RS_FT_HUNTERS_LORE) { return r; }
  for e: b[0].c[j].eff {
    if e.kind == EF_MARK && e.by == i {
      t := b[0].c[j];
      r = RsLore.{known = true, resist = t.resist, vulnerable = t.vulnerable, immune = t.immune, immune_cond = t.immune_cond};
    }
  }
  return r;
}

#test "Hunter's Lore tells a lore-keeping Ranger its own mark's Immunities, Resistances and Vulnerabilities, and nothing else" {
  for mode: 0..<5 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6;
    _ := rs_add(b[..], rs_ranger("Wren", 0, 3), 1, 1); _ = rs_add(b[..], rs_wizard("Foe", 1, 1), 2, 1); _ = rs_add(b[..], rs_ranger("Kin", 0, 3), 1, 2);
    b[0].c[1].resist = 1 << RS_FIRE; b[0].c[1].vulnerable = 1 << RS_RADIANT; b[0].c[1].immune = 1 << RS_POISON; b[0].c[1].immune_cond = RS_CHARMED;
    by := ifx mode == 2 then 2 else 0; kind := ifx mode == 3 then EF_HEX else EF_MARK;
    if mode != 4 { #assert rs_put_effect(b[..], 1, RsEffect.{kind = kind, by = by, spell = SP_HUNTERS_MARK, until = 60, save = -1}); }
    if mode == 1 { b[0].c[0].feats = rs_feature_put(b[0].c[0].feats, RS_FT_HUNTERS_LORE, false); }
    r := rs_hunters_lore(b[..], 0, 1); ok := mode == 0;
    #assert r.known == ok && r.resist == (ifx ok then 1 << RS_FIRE else 0) && r.vulnerable == (ifx ok then 1 << RS_RADIANT else 0);
    #assert r.immune == (ifx ok then 1 << RS_POISON else 0) && r.immune_cond == (ifx ok then RS_CHARMED else 0);
    #assert !rs_hunters_lore(b[..], -1, 1).known && !rs_hunters_lore(b[..], 0, -1).known;
    // past the three counted creatures
    b[0].c[3] = b[0].c[1]; #assert !rs_hunters_lore(b[..], 0, 3).known;
    b[0].c[3] = b[0].c[0]; #assert rs_put_effect(b[..], 1, RsEffect.{kind = EF_MARK, by = 3, spell = SP_HUNTERS_MARK, until = 60, save = -1});
    #assert !rs_hunters_lore(b[..], 3, 1).known;
  }
  // the marked creature first in the battle
  f: [1] RsBattle; f_room: [1] RsRoom; rs_have(f[..], f_room[..]); f[0].w = 12; f[0].h = 6;
  _ := rs_add(f[..], rs_wizard("Foe", 1, 1), 2, 1); _ = rs_add(f[..], rs_ranger("Wren", 0, 3), 1, 1); f[0].c[0].resist = 1 << RS_COLD;
  #assert rs_put_effect(f[..], 0, RsEffect.{kind = EF_MARK, by = 1, spell = SP_HUNTERS_MARK, until = 60, save = -1});
  #assert rs_hunters_lore(f[..], 1, 0).known && rs_hunters_lore(f[..], 1, 0).resist == 1 << RS_COLD;
}
