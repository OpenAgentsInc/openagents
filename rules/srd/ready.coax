// SRD 5.2.1 Rules Glossary Ready [Action] and Simultaneous Effects. On its turn a creature names
// a perceivable trigger (here: a creature, or any) and a response: one attack with its weapon, a
// move up to its Speed, or a spell with a casting time of an action. When the trigger occurs the
// world offers the Reaction; the creature takes it or ignores the trigger. A readied spell is cast
// as normal when readied (its action and slot spent) and held by Concentration until the start of
// its next turn; if Concentration breaks, it dissipates. The record ends at that actual turn start,
// not on the clock.
#authority;

RD_ATTACK :: 1; RD_MOVE :: 2; RD_SPELL :: 3;

// The Ready record on c, or -1.
rs_ready_at :: (c: RsCreature) -> int #effects(all) {
  for k: 0..<RS_EFFECTS { if c.eff[k].kind == EF_READY { return k; } }
  return -1;
}
rs_ready_response :: (e: RsEffect) -> int #effects(all) { return e.cond % 16; }
rs_ready_slot :: (e: RsEffect) -> int #effects(all) { return e.cond / 16; }
// Take the Ready action: `trigger` the creature whose deed will set it off (-1 any); for RD_SPELL,
// spell sp from a slot of level `slot` (0 a cantrip). Refused, with nothing spent, when the action
// is spent, a Ready is already held, there's no room, or the spell couldn't be cast now.
rs_ready :: (b: [] RsBattle, i: int, response: int, trigger: int, sp: int, slot: int) -> bool #effects(all) {
  if !rs_action_free(b, i) || response < RD_ATTACK || response > RD_SPELL || trigger < -1 || trigger >= b[0].n || trigger == i { return false; }
  if response==RD_ATTACK && b[0].c[i].familiar_owner>0 { return false; }
  if rs_ready_at(b[0].c[i]) >= 0 || rs_effect_free(b[0].c[i]) == 0 { return false; }
  e := RsEffect.{kind = EF_READY, cond = response, by = i, spell = -1, until = rs_next_turn_tick(b, i), save = -1, dc = trigger};
  if response == RD_SPELL {
    if !rs_executable_spell(sp) || rs_spell(sp).cast_time != RS_T_ACTION || !rs_can_cast(b, i, sp, slot) { return false; }
    level := rs_spell(sp).level;
    rs_rest_cast_before(b, i, level);
    if level > 0 { b[0].c[i].slots[slot] -= 1; b[0].turn.slot_spent = true; b[0].turn.leveled = true; }   // a cantrip's slot is 0
    rs_end_concentration(b, i, "");
    b[0].c[i].conc = sp; b[0].c[i].conc_until = e.until;
    e.spell = sp; e.cond = response + 16 * slot;
  }
  b[0].turn.action = true;
  _ := rs_put_effect(b, i, e);
  rs_say(b, RS_EV_CONDITION, i, i, response, ifx response == RD_SPELL then " readies a spell" else ifx response == RD_MOVE then " readies a move" else " readies an attack");
  return true;
}
// Whether i's readied response may answer creature j's deed now: it holds a Ready naming j (or
// any), has its Reaction and isn't Incapacitated; a held spell still needs its Concentration.
rs_ready_triggered :: (b: [] RsBattle, i: int, j: int) -> bool #effects(all) {
  if i < 0 || i >= b[0].n || j < 0 || j >= b[0].n || i == j { return false; }
  k := rs_ready_at(b[0].c[i]);
  if k < 0 || b[0].c[i].reacted || !rs_capable(b[0].c[i]) { return false; }
  e := b[0].c[i].eff[k];
  if e.dc != -1 && e.dc != j { return false; }
  return rs_ready_response(e) != RD_SPELL || b[0].c[i].conc == e.spell;
}
// The readied attack at j: one attack with its melee weapon within reach, or its ranged weapon
// within long range. False, and nothing spent, if it can't be made.
rs_ready_attack :: (b: [] RsBattle, i: int, j: int) -> bool #effects(all) {
  switch rs_ready_attack_atomic(b, i, j) { case none { return false; } case some(made) { return made; } }
}
rs_ready_attack_atomic :: (b: [] RsBattle, i: int, j: int) -> bool? #effects(all) {
  #transaction {
    if !rs_ready_triggered(b, i, j) || rs_ready_response(b[0].c[i].eff[rs_ready_at(b[0].c[i])]) != RD_ATTACK || b[0].c[j].dead { return null; }
    w := b[0].c[i].weapon;
    if rs_feet_to(b, i, j) > rs_weapon(w).reach_ft { w = b[0].c[i].ranged; }
    if w < 0 || rs_feet_to(b, i, j) > rs_max(rs_weapon(w).long_ft, rs_weapon(w).reach_ft) { return null; }
    if !rs_reaction_frame_begin(b, i) { return null; }
    if !rs_strikes_fit(b, i, j, w, 1, false) { return null; }
    b[0].c[i].reacted = true;
    rs_drop_effect(b, i, rs_ready_at(b[0].c[i]));
    _ := rs_strike(b, i, j, w, false);
    rs_after_blow(b, i);
    rs_reaction_frame_end(b);
  }
  return some(true);
}
// The readied move: up to its Speed along the squares `xs`, `ys`, one step each, as far as it can
// go. The squares moved, or -1 when the Ready can't answer j.
rs_ready_move :: (b: [] RsBattle, i: int, j: int, xs: [] const int, ys: [] const int) -> int #effects(all) {
  if !rs_ready_triggered(b, i, j) || rs_ready_response(b[0].c[i].eff[rs_ready_at(b[0].c[i])]) != RD_MOVE || b[0].reaction_frame.on || xs.count != ys.count { return -1; }
  who := b[0].who; turn := b[0].turn;
  b[0].c[i].reacted = true;
  rs_drop_effect(b, i, rs_ready_at(b[0].c[i]));
  speed := rs_walk_speed(b, i);
  b[0].who = i; b[0].turn = RsTurn.{move_left = speed / 5, move_feet = speed % 5};   // the first step bases it on the allowance
  moved := 0;
  for k: 0..<xs.count { if !rs_step_to(b, i, xs[k], ys[k]) { break; } moved += 1; }
  b[0].who = who; b[0].turn = turn;
  return moved;
}
// Release the held spell at creature `target` or the point (tx, ty), with the Reaction. False, and
// the spell still held, if the cast is refused there.
rs_ready_spell :: (b: [] RsBattle, i: int, j: int, tx: int, ty: int, target: int) -> bool #effects(all) {
  switch rs_ready_spell_atomic(b, i, j, tx, ty, target) { case none { return false; } case some(ok) { return ok; } }
}
rs_ready_spell_atomic :: (b: [] RsBattle, i: int, j: int, tx: int, ty: int, target: int) -> bool? #effects(all) {
  #transaction {
    if !rs_ready_triggered(b, i, j) { return null; }
    e := b[0].c[i].eff[rs_ready_at(b[0].c[i])];
    if rs_ready_response(e) != RD_SPELL { return null; }
    slot := rs_ready_slot(e);
    b[0].c[i].reacted = true;
    // the held energy: the slot it spent when readied pays the release
    b[0].c[i].conc = -1; b[0].c[i].conc_until = 0;
    rs_drop_effect(b, i, rs_ready_at(b[0].c[i]));
    if slot > 0 { b[0].c[i].slots[slot] += 1; }
    if !rs_reaction_frame_begin(b, i) { return null; }
    ok := rs_cast(b, i, e.spell, slot, tx, ty, target);
    rs_reaction_frame_end(b);
    if !ok { return null; }
  }
  return some(true);
}
// The start of i's turn: an unused Ready ends, and a held spell dissipates.
rs_ready_start_turn :: (b: [] RsBattle, i: int) #effects(all) {
  if i < 0 || i >= b[0].n { return; }
  k := rs_ready_at(b[0].c[i]);
  if k < 0 { return; }
  e := b[0].c[i].eff[k];
  rs_drop_effect(b, i, k);
  if rs_ready_response(e) == RD_SPELL && b[0].c[i].conc == e.spell { rs_end_concentration(b, i, " (the readied spell dissipates)"); }
}
// Simultaneous Effects: the creature whose turn it is orders things that happen at once. Sorts
// `items` (creatures) by their place in that creature's `prefs`; unnamed ones keep their order,
// after the named.
rs_simultaneous_order :: (items: [] int, prefs: [] const int) #effects(all) {
  for a: 1..<items.count {
    k := a;
    while k > 0 && rs_order_rank(items[k], prefs) < rs_order_rank(items[k - 1], prefs) { t := items[k]; items[k] = items[k - 1]; items[k - 1] = t; k -= 1; }
  }
}
rs_order_rank :: (item: int, prefs: [] const int) -> int #effects(all) {
  for k: 0..<prefs.count { if prefs[k] == item { return k; } }
  return prefs.count;
}
// Every creature whose readied response creature j's deed sets off, in the turn owner's order.
rs_ready_answers :: (b: [] RsBattle, j: int, prefs: [] const int, out: [] int) -> int #effects(all) {
  n := 0;
  for i: 0..<b[0].n { if n < out.count && rs_ready_triggered(b, i, j) { out[n] = i; n += 1; } }
  rs_simultaneous_order(out[0..<n], prefs);
  return n;
}

#test "Ready spends the action and holds one response until the readier's next turn starts" {
  for mode: 0..<9 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_fresh(b[..], 0);
    response := RD_ATTACK; trigger := 2;
    if mode == 1 { b[0].turn.action = true; } else if mode == 2 { response = 0; } else if mode == 3 { response = 4; } else if mode == 4 { trigger = 0; }
    else if mode == 5 { trigger = 3; } else if mode == 6 { trigger = -2; } else if mode == 7 { for k: 0..<RS_EFFECTS { b[0].c[0].eff[k].kind = EF_BLESS; } }
    else if mode == 8 { trigger = -1; response = RD_MOVE; }
    ok := mode == 0 || mode == 8;
    #assert rs_ready(b[..], 0, response, trigger, -1, 0) == ok && b[0].turn.action == (ok || mode == 1);
    if ok {
      k := rs_ready_at(b[0].c[0]); e := b[0].c[0].eff[k];
      #assert k >= 0 && rs_ready_response(e) == response && e.dc == trigger && e.by == 0 && e.save == -1 && !rs_effect_uses_clock(e.kind);
      #assert !rs_ready(b[..], 0, RD_MOVE, -1, -1, 0);
      rs_tick(b[..], 30); #assert rs_ready_at(b[0].c[0]) == k;   // the clock alone never retires it
      rs_ready_start_turn(b[..], 0); #assert rs_ready_at(b[0].c[0]) < 0;
    }
  }
  e: [1] RsBattle; e_room: [1] RsRoom; rs_have(e[..], e_room[..]); rs_ready_start_turn(e[..], -1);
}
#test "the trigger offers the Reaction only to the named creature's deed, while able and unspent" {
  for mode: 0..<7 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_fresh(b[..], 0);
    #assert rs_ready(b[..], 0, RD_ATTACK, ifx mode == 6 then -1 else 2, -1, 0);
    j := 2;
    if mode == 1 { j = 1; } else if mode == 2 { b[0].c[0].reacted = true; } else if mode == 3 { b[0].c[0].cond |= RS_INCAPACITATED; }
    else if mode == 4 { j = 0; } else if mode == 5 { j = 9; } else if mode == 6 { j = 1; }
    #assert rs_ready_triggered(b[..], 0, j) == (mode == 0 || mode == 6);
  }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); #assert !rs_ready_triggered(b[..], 0, 2) && !rs_ready_triggered(b[..], -1, 2) && !rs_ready_triggered(b[..], 7, 2);
}
#test "a readied attack strikes once as the Reaction, melee within reach or ranged within long range" {
  for mode: 0..<6 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_fresh(b[..], 0);
    #assert rs_ready(b[..], 0, RD_ATTACK, 2, -1, 0);
    b[0].who = 2; b[0].turn = RsTurn.{action = true};
    if mode == 0 { rs_place(b[..], 2, 3, 2); } else if mode == 2 { b[0].c[0].ranged = W_SHORTBOW; rs_place(b[..], 2, 9, 2); }
    else if mode == 3 { b[0].c[0].ranged = W_SHORTBOW; rs_place(b[..], 2, 11, 5); _ := rs_cover_put(b[..], 0, 2, RS_COVER_TOTAL); }
    else if mode == 4 { rs_place(b[..], 2, 3, 2); b[0].c[2].dead = true; } else if mode == 5 { b[0].c[0].ranged = W_SHORTBOW; b[0].w = 80; rs_place(b[..], 2, 70, 2); }
    hp := b[0].c[2].hp;
    ok := mode == 0 || mode == 2;
    #assert rs_ready_attack(b[..], 0, 2) == ok && b[0].c[0].reacted == ok && (rs_ready_at(b[0].c[0]) < 0) == ok;
    #assert b[0].who == 2 && b[0].turn.action && !b[0].reaction_frame.on && (b[0].c[2].hp < hp) == ok;
    if ok { #assert !rs_ready_attack(b[..], 0, 2); }
  }
  m: [1] RsBattle; m_room: [1] RsRoom; rs_have(m[..], m_room[..]); ready_field(m[..]); rs_fresh(m[..], 0); #assert rs_ready(m[..], 0, RD_MOVE, 2, -1, 0); rs_place(m[..], 2, 3, 2);
  #assert !rs_ready_attack(m[..], 0, 2) && !m[0].c[0].reacted;
  f: [1] RsBattle; f_room: [1] RsRoom; rs_have(f[..], f_room[..]); ready_field(f[..]); rs_fresh(f[..], 0); #assert rs_ready(f[..], 0, RD_ATTACK, 2, -1, 0); rs_place(f[..], 2, 3, 2);
  f[0].reaction_frame.on = true; #assert !rs_ready_attack(f[..], 0, 2) && !f[0].c[0].reacted && rs_ready_at(f[0].c[0]) >= 0;
}
#test "a readied move goes up to its Speed through open squares and keeps the true turn" {
  xs := [8] int.[1, 1, 1, 0, 0, 0, 0, 0]; ys := [8] int.[2, 3, 4, 4, 3, 2, 1, 0];
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_place(b[..], 1, 9, 5); rs_fresh(b[..], 0);
  #assert rs_ready(b[..], 0, RD_MOVE, 2, -1, 0);
  b[0].who = 2; b[0].turn = RsTurn.{action = true, move_left = 3};
  #assert rs_ready_move(b[..], 0, 2, xs[..], ys[..]) == 6 && b[0].c[0].x == 0 && b[0].c[0].y == 2 && b[0].c[0].reacted;   // Speed 30: six squares
  #assert b[0].who == 2 && b[0].turn.action && b[0].turn.move_left == 3 && rs_ready_move(b[..], 0, 2, xs[..], ys[..]) == -1;
  c: [1] RsBattle; c_room: [1] RsRoom; rs_have(c[..], c_room[..]); ready_field(c[..]); rs_fresh(c[..], 0); #assert rs_ready(c[..], 0, RD_MOVE, 2, -1, 0);
  #assert rs_ready_move(c[..], 0, 2, xs[0..<2], ys[0..<1]) == -1 && rs_ready_move(c[..], 0, 1, xs[..], ys[..]) == -1;
  bad := [1] int.[5]; #assert rs_ready_move(c[..], 0, 2, bad[..], bad[..]) == 0 && c[0].c[0].reacted;   // not adjacent: it stays, the Reaction spent
  d: [1] RsBattle; d_room: [1] RsRoom; rs_have(d[..], d_room[..]); ready_field(d[..]); rs_fresh(d[..], 0); #assert rs_ready(d[..], 0, RD_MOVE, 2, -1, 0); d[0].reaction_frame.on = true;
  #assert rs_ready_move(d[..], 0, 2, xs[..], ys[..]) == -1;
  a: [1] RsBattle; a_room: [1] RsRoom; rs_have(a[..], a_room[..]); ready_field(a[..]); rs_fresh(a[..], 0); #assert rs_ready(a[..], 0, RD_ATTACK, 2, -1, 0);
  #assert rs_ready_move(a[..], 0, 2, xs[..], ys[..]) == -1;
}
#test "a readied spell is cast as normal, held by Concentration, and released with the Reaction" {
  for mode: 0..<6 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_fresh(b[..], 1);
    sp := SP_FIRE_BOLT; slot := 0;
    if mode >= 1 { sp = SP_RAY_OF_SICKNESS; slot = 1; }
    if mode == 3 { slot = 9; } else if mode == 4 { sp = SP_SHIELD; slot = 1; } else if mode == 5 { sp = -9; }
    slots := b[0].c[1].slots[1];
    ok := mode <= 2;
    #assert rs_ready(b[..], 1, RD_SPELL, 2, sp, slot) == ok;
    if !ok { #assert !b[0].turn.action && b[0].c[1].slots[1] == slots && rs_ready_at(b[0].c[1]) < 0; continue; }
    #assert b[0].c[1].conc == sp && b[0].c[1].slots[1] == slots - slot && b[0].turn.slot_spent == (slot > 0) && b[0].turn.leveled == (slot > 0);
    b[0].who = 2; b[0].turn = RsTurn.{action = true};
    if mode == 2 {   // Concentration breaks: the spell dissipates, the slot stays spent
      rs_end_concentration(b[..], 1, ""); #assert rs_ready_at(b[0].c[1]) < 0 && !rs_ready_triggered(b[..], 1, 2) && b[0].c[1].slots[1] == slots - 1;
      continue;
    }
    hp := b[0].c[2].hp;
    #assert rs_ready_spell(b[..], 1, 2, 0, 0, 2) && b[0].c[1].reacted && rs_ready_at(b[0].c[1]) < 0 && b[0].c[2].hp < hp;
    #assert b[0].c[1].slots[1] == slots - slot && b[0].c[1].conc == -1 && b[0].who == 2 && b[0].turn.action && !b[0].reaction_frame.on;
  }
  o: [1] RsBattle; o_room: [1] RsRoom; rs_have(o[..], o_room[..]); ready_field(o[..]); rs_fresh(o[..], 1);
  #assert rs_ready(o[..], 1, RD_SPELL, 2, SP_RAY_OF_SICKNESS, 1);
  o[0].who = 2; o[0].turn = RsTurn.{action = true}; slots := o[0].c[1].slots[1];
  _ := rs_cover_put(o[..], 1, 2, RS_COVER_TOTAL);
  #assert !rs_ready_spell(o[..], 1, 2, 0, 0, 2) && o[0].c[1].conc == SP_RAY_OF_SICKNESS && rs_ready_at(o[0].c[1]) >= 0 && !o[0].c[1].reacted && o[0].c[1].slots[1] == slots;   // behind Total Cover: still held
  rs_cover_clear(o[..]);
  none: [1] int;
  #assert !rs_ready_spell(o[..], 1, 0, 0, 0, 2) && rs_ready_attack(o[..], 1, 2) == false && rs_ready_move(o[..], 1, 2, none[0..<0], none[0..<0]) == -1;
  o[0].reaction_frame.on = true; #assert !rs_ready_spell(o[..], 1, 2, 0, 0, 2); o[0].reaction_frame.on = false;
  rs_ready_start_turn(o[..], 1); #assert o[0].c[1].conc == -1 && rs_ready_at(o[0].c[1]) < 0 && o[0].c[1].slots[1] == slots;   // unreleased: dissipates
  a: [1] RsBattle; a_room: [1] RsRoom; rs_have(a[..], a_room[..]); ready_field(a[..]); rs_fresh(a[..], 0); #assert rs_ready(a[..], 0, RD_ATTACK, 2, -1, 0); #assert !rs_ready_spell(a[..], 0, 2, 0, 0, 2);
  k: [1] RsBattle; k_room: [1] RsRoom; rs_have(k[..], k_room[..]); ready_field(k[..]); rs_fresh(k[..], 1); #assert rs_ready(k[..], 1, RD_SPELL, 2, SP_FIRE_BOLT, 0);
  k[0].c[1].conc = SP_HEX; rs_ready_start_turn(k[..], 1); #assert k[0].c[1].conc == SP_HEX && rs_ready_at(k[0].c[1]) < 0;
}
#test "simultaneous readied answers follow the turn owner's order, the unnamed after in their own" {
  items := [5] int.[4, 1, 3, 0, 2];
  prefs := [2] int.[3, 2];
  rs_simultaneous_order(items[..], prefs[..]);
  #assert items[0] == 3 && items[1] == 2 && items[2] == 4 && items[3] == 1 && items[4] == 0;
  none: [1] int; two := [2] int.[1, 0]; one := [1] int.[1];
  rs_simultaneous_order(items[..], none[0..<0]); #assert items[0] == 3 && items[4] == 0;
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]);
  rs_fresh(b[..], 0); #assert rs_ready(b[..], 0, RD_ATTACK, 2, -1, 0);
  rs_fresh(b[..], 1); #assert rs_ready(b[..], 1, RD_MOVE, -1, -1, 0);
  out: [4] int;
  #assert rs_ready_answers(b[..], 2, none[0..<0], out[..]) == 2 && out[0] == 0 && out[1] == 1;
  #assert rs_ready_answers(b[..], 2, two[..], out[..]) == 2 && out[0] == 1 && out[1] == 0;
  #assert rs_ready_answers(b[..], 2, one[..], out[0..<1]) == 1 && out[0] == 0;
  #assert rs_ready_answers(b[..], 0, none[0..<0], out[..]) == 1 && out[0] == 1;
}
#test "a Ready record packs its response and slot; one record at a time; each response tells itself" {
  e := RsEffect.{kind = EF_READY, cond = RD_SPELL + 16 * 4};
  #assert rs_ready_slot(e) == 4 && rs_ready_response(e) == RD_SPELL;
  for response: 1..<3 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_fresh(b[..], 0);
    #assert rs_ready(b[..], 0, response, 2, -1, 0) && b[0].c[0].eff[rs_ready_at(b[0].c[0])].spell == -1;
    #assert act_last(b[..]).kind == RS_EV_CONDITION && act_last(b[..]).by.value == 0 && act_last(b[..]).amount == response;
    #assert act_said(b[..], ifx response == RD_MOVE then "Guard readies a move" else "Guard readies an attack");
    rs_fresh(b[..], 0); #assert !rs_ready(b[..], 0, RD_ATTACK, 2, -1, 0) && !b[0].turn.action;   // already held
  }
  s: [1] RsBattle; s_room: [1] RsRoom; rs_have(s[..], s_room[..]); ready_field(s[..]); rs_fresh(s[..], 1); #assert rs_ready(s[..], 1, RD_SPELL, 2, SP_FIRE_BOLT, 0);
  #assert act_last(s[..]).amount == RD_SPELL && act_said(s[..], "Mage readies a spell");
}
#test "a readied spell takes an action spell, ends other Concentration and closes a Long Rest when leveled" {
  h: [1] RsBattle; h_room: [1] RsRoom; rs_have(h[..], h_room[..]); ready_field(h[..]); h[0].c[1] = rs_warlock("Hexer", 0, 3, SP_ELDRITCH_BLAST); h[0].c[1].x = 2; h[0].c[1].y = 4; rs_fresh(h[..], 1);
  #assert rs_can_cast(h[..], 1, SP_HEX, 2) && !rs_ready(h[..], 1, RD_SPELL, 2, SP_HEX, 2) && !h[0].turn.action;   // a Bonus Action spell
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_fresh(b[..], 1);
  b[0].c[1].conc = SP_HEX; _ := rs_put_effect(b[..], 2, RsEffect.{kind = EF_COND, cond = RS_BLINDED, by = 1, spell = SP_HEX, until = RS_NO_END, save = -1});
  #assert rs_has(b[0].c[2], RS_BLINDED) && rs_ready(b[..], 1, RD_SPELL, 2, SP_RAY_OF_SICKNESS, 1);
  r := b[0].c[1].eff[rs_ready_at(b[0].c[1])];
  #assert !rs_has(b[0].c[2], RS_BLINDED) && b[0].c[1].conc == SP_RAY_OF_SICKNESS && b[0].c[1].conc_until == r.until;
  l: [1] RsBattle; l_room: [1] RsRoom; rs_have(l[..], l_room[..]); ready_field(l[..]); l[0].who = -1;
  #assert rs_rest_schedule_enable(l[..]) && rs_long_rest_start_owned(l[..], 1, 2, true);
  rs_tick(l[..], 3600); rs_fresh(l[..], 1);
  #assert l[0].c[1].long_rest.phase == 1 && rs_ready(l[..], 1, RD_SPELL, 2, SP_RAY_OF_SICKNESS, 1) && l[0].c[1].long_rest.phase == 2 && l[0].c[1].long_rest.interruptions == 1;
}
#test "Ready reads only creatures in the battle, and an attack answers while concentrating" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); p := rs_add(b[..], rs_fighter("Past", 0, 5), 7, 4); b[0].n -= 1;
  b[0].c[p].eff[0] = RsEffect.{kind = EF_READY, cond = RD_ATTACK, by = p, spell = -1, until = RS_NO_END, save = -1, dc = -1};
  #assert !rs_ready_triggered(b[..], p, 2);
  rs_ready_start_turn(b[..], p); #assert rs_ready_at(b[0].c[p]) == 0;
  rs_fresh(b[..], 0); #assert rs_ready(b[..], 0, RD_ATTACK, -1, -1, 0) && !rs_ready_triggered(b[..], 0, p) && rs_ready_triggered(b[..], 0, 2);
  b[0].c[0].conc = SP_HEX; #assert rs_ready_triggered(b[..], 0, 2);
  h: [1] RsBattle; h_room: [1] RsRoom; rs_have(h[..], h_room[..]); ready_field(h[..]); rs_fresh(h[..], 1); #assert rs_ready(h[..], 1, RD_SPELL, 2, SP_FIRE_BOLT, 0) && rs_ready_triggered(h[..], 1, 2);
  h[0].c[1].conc = SP_HEX; #assert !rs_ready_triggered(h[..], 1, 2);   // its Concentration moved on
}
#test "a readied attack is the weapon's own blow, unarmed too, with its masteries' room and a Champion's critical" {
  for mode: 0..<5 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_fresh(b[..], 0);
    if mode == 1 { b[0].c[0].weapon = W_UNARMED; } else if mode == 2 { b[0].c[0].weapon = W_SHORTSWORD; b[0].c[0].masteries = 1 << M_VEX; }
    else if mode == 3 { b[0].c[0].weapon = W_MACE; b[0].c[0].masteries = 1 << M_SAP; k := rs_add(b[..], rs_fighter("Crowd", 1, 1), 1, 2); for e: 0..<RS_EFFECTS { b[0].c[k].eff[e].kind = EF_BLESS; } }
    else if mode == 4 { b[0].c[2].cond |= RS_UNCONSCIOUS; }
    #assert rs_ready(b[..], 0, RD_ATTACK, 2, -1, 0);
    if mode == 2 { r := rs_ready_at(b[0].c[0]); for e: 0..<RS_EFFECTS - 1 { if e != r { b[0].c[0].eff[e].kind = EF_BLESS; } } }   // one free record
    rs_place(b[..], 2, 3, 2);
    w: [1] RsBattle; w_room: [1] RsRoom; rs_have(w[..], w_room[..]); ready_field(w[..]); w[0].c[0].weapon = b[0].c[0].weapon; w[0].c[0].masteries = b[0].c[0].masteries; w[0].c[2].cond = b[0].c[2].cond; rs_place(w[..], 2, 3, 2); rs_fresh(w[..], 0);
    _ := rs_strike(w[..], 0, 2, w[0].c[0].weapon, false);
    moves := b[0].turn.move_left;
    if mode != 4 { b[0].who = 2; b[0].turn = RsTurn.{action = true}; }   // a deed on the readier's own turn keeps its marks
    #assert rs_ready_attack(b[..], 0, 2) && b[0].c[0].reacted && b[0].c[2].hp < 60;
    if mode != 2 { #assert b[0].c[2].hp == w[0].c[2].hp; }
    if mode == 4 { #assert !b[0].turn.last_crit && b[0].turn.move_left == moves + 3; }   // Remarkable Athlete
  }
}
#test "a readied move retires its record and goes up to an odd Speed; a released spell leaves nothing held" {
  xs := [8] int.[1, 1, 1, 0, 0, 0, 0, 0]; ys := [8] int.[2, 3, 4, 4, 3, 2, 1, 0];
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); ready_field(b[..]); rs_place(b[..], 1, 9, 5); b[0].c[0].speed = 35; rs_fresh(b[..], 0);
  #assert rs_ready(b[..], 0, RD_MOVE, 2, -1, 0);
  b[0].who = 2; b[0].turn = RsTurn.{action = true};
  #assert rs_ready_move(b[..], 0, 2, xs[..], ys[..]) == 7 && rs_ready_at(b[0].c[0]) < 0;
  s: [1] RsBattle; s_room: [1] RsRoom; rs_have(s[..], s_room[..]); ready_field(s[..]); rs_fresh(s[..], 1); #assert rs_ready(s[..], 1, RD_SPELL, 2, SP_FIRE_BOLT, 0);
  zero := s[0].c[1].slots[0]; s[0].who = 2; s[0].turn = RsTurn.{action = true};
  #assert rs_ready_spell(s[..], 1, 2, 0, 0, 2) && s[0].c[1].slots[0] == zero && s[0].c[1].conc_until == 0;
}
