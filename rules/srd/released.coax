// A released attack lands even when its maker falls before it arrives: an arrow loosed, a bolt cast,
// a blow already swung. Anything already released resolves; anything not yet released (a draw, a
// cast bar, a ritual) is cancelled by the fall, which its own caller decides (GitHub #13120).
// For that one resolution the maker stands as it stood when it let go: up, at 1 Hit Point when it
// had none, without the conditions or halts its fall brought. Afterward it is down again as it
// was; whatever the resolution spent (a slot, the action) stays spent.
#authority;

RS_RELEASE_LIFT :: RS_INCAPACITATED | RS_PARALYZED | RS_PETRIFIED | RS_STUNNED | RS_UNCONSCIOUS | RS_PRONE;
RsReleased :: struct { on: bool; dead: bool; hp: int; cond: int; halts: int; halt: [RS_EFFECTS] RsEffect; }

// Stand creature i for a released attack's resolution. Nothing changes when it can act.
rs_release_stand :: (b: [] RsBattle, i: int) -> RsReleased #effects(all) {
  r: RsReleased;
  if i < 0 || i >= b[0].n || rs_can_act(b[0].c[i]) { return r; }
  c := b[0].c[i..<i + 1];  // mutant: equivalent (only c[0] is read, so a longer view is the same creature)
  r.on = true; r.dead = c[0].dead; r.hp = c[0].hp; r.cond = c[0].cond & RS_RELEASE_LIFT;
  c[0].dead = false;
  if c[0].hp < 1 { c[0].hp = 1; }  // mutant: equivalent (a creature at exactly 1 Hit Point is set to 1 either way)
  c[0].cond = rs_clear(c[0].cond, RS_RELEASE_LIFT);
  for k: 0..<RS_EFFECTS {
    if c[0].eff[k].kind == EF_HALT { r.halts = r.halts | (1 << k); r.halt[k] = c[0].eff[k]; c[0].eff[k].kind = EF_NONE; }
  }
  return r;
}
// Put creature i back down after the resolution rs_release_stand opened.
rs_release_fall :: (b: [] RsBattle, i: int, r: RsReleased) #effects(all) {
  if !r.on || i < 0 || i >= b[0].n { return; }
  c := b[0].c[i..<i + 1];  // mutant: equivalent (only c[0] is read, so a longer view is the same creature)
  c[0].dead = r.dead;
  if r.hp < 1 { c[0].hp = r.hp; }  // mutant: equivalent (a creature that stood at exactly 1 Hit Point is set to 1 either way)
  c[0].cond = c[0].cond | r.cond;
  for k: 0..<RS_EFFECTS {  // mutant: equivalent (the halts mask has no bit 16, so a seventeenth turn of the loop continues at once)
    if (r.halts & (1 << k)) == 0 { continue; }
    if c[0].eff[k].kind == EF_NONE { c[0].eff[k] = r.halt[k]; continue; }
    for q: 0..<RS_EFFECTS { if c[0].eff[q].kind == EF_NONE { c[0].eff[q] = r.halt[k]; break; } }
  }
}

#test "released: a fallen archer's loosed shot still rolls and harms; it is down again after" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 40; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..], rs_fighter("Archer", 0, 3), 1, 3);
  t := rs_add(b[..], rs_fighter("Target", 1, 3), 5, 3);
  b[0].c[a].ranged = W_LONGBOW; b[0].c[t].ac = 1; b[0].c[t].hp = 40; b[0].c[t].hp_max = 40;
  rs_start_turn(b[..], a);
  // the archer falls: Unconscious and Prone at 0 Hit Points, and the shot is refused as a new action
  b[0].c[a].hp = 0; b[0].c[a].cond = RS_UNCONSCIOUS | RS_PRONE;
  #assert !rs_shoot(b[..], a, t) && b[0].c[t].hp == 40;
  // released before the fall, it resolves
  up := rs_release_stand(b[..], a);
  #assert up.on && rs_can_act(b[0].c[a]);
  ok := rs_shoot(b[..], a, t);
  rs_release_fall(b[..], a, up);
  #assert ok && b[0].c[t].hp < 40 && b[0].turn.action;
  #assert b[0].c[a].hp == 0 && rs_has(b[0].c[a], RS_UNCONSCIOUS) && rs_has(b[0].c[a], RS_PRONE) && !rs_can_act(b[0].c[a]);
  // a creature that can act is left as it is
  b[0].c[t].hp = 9;
  same := rs_release_stand(b[..], t);
  #assert !same.on && b[0].c[t].hp == 9;
  // a dead creature's halt comes back with it
  b[0].c[a].dead = true; b[0].c[a].eff[2] = RsEffect.{kind = EF_HALT, by = 1, until = 5};
  dn := rs_release_stand(b[..], a);
  #assert dn.on && !b[0].c[a].dead && b[0].c[a].eff[2].kind == EF_NONE && rs_can_act(b[0].c[a]);
  rs_release_fall(b[..], a, dn);
  #assert b[0].c[a].dead && b[0].c[a].eff[2].kind == EF_HALT && b[0].c[a].eff[2].until == 5;
}

#test "released: a fallen maker stands for one resolution with only the fall's conditions lifted, and goes back to exactly what it was" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]);
  a := rs_add(b[..], rs_fighter("Archer", 0, 3), 1, 3);
  // a creature that can act, and an index that names none, are left alone
  #assert !rs_release_stand(b[..], a).on && !rs_release_stand(b[..], -1).on && !rs_release_stand(b[..], b[0].n).on;
  // the six conditions of a fall are lifted, the others stay; hit points stay when there are some
  b[0].c[a].hp = 5; b[0].c[a].cond = RS_RELEASE_LIFT | RS_BLINDED | RS_POISONED;
  up := rs_release_stand(b[..], a);
  #assert up.on && !up.dead && up.hp == 5 && up.cond == RS_RELEASE_LIFT && b[0].c[a].hp == 5 && b[0].c[a].cond == (RS_BLINDED | RS_POISONED);
  // the resolution lifts Blinded and wounds it: it goes down again with the fall's conditions and not with Blinded back
  b[0].c[a].hp = 3; b[0].c[a].cond = RS_POISONED;
  rs_release_fall(b[..], a, up);
  #assert b[0].c[a].hp == 3 && b[0].c[a].cond == (RS_POISONED | RS_RELEASE_LIFT) && !b[0].c[a].dead;
  // a creature with only one of them has only that one back
  b[0].c[a].hp = 4; b[0].c[a].cond = RS_INCAPACITATED;
  up = rs_release_stand(b[..], a);
  #assert up.on && up.cond == RS_INCAPACITATED && b[0].c[a].cond == 0;
  rs_release_fall(b[..], a, up);
  #assert b[0].c[a].cond == RS_INCAPACITATED && b[0].c[a].hp == 4;
  // at 0 Hit Points it stands at 1 and goes down to 0, whatever it was given meanwhile
  b[0].c[a].hp = 0; b[0].c[a].cond = RS_UNCONSCIOUS;
  up = rs_release_stand(b[..], a);
  #assert up.hp == 0 && b[0].c[a].hp == 1;
  b[0].c[a].hp = 7;
  rs_release_fall(b[..], a, up);
  #assert b[0].c[a].hp == 0 && b[0].c[a].cond == RS_UNCONSCIOUS;
}

#test "released: halts come back to their own slots or the first free one, and nothing is written over another effect" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]);
  a := rs_add(b[..], rs_fighter("Archer", 0, 3), 1, 3);
  b[0].c[a].eff[0] = RsEffect.{kind = EF_HALT, by = 1, until = 5};
  b[0].c[a].eff[15] = RsEffect.{kind = EF_HALT, by = 2, until = 6};
  b[0].c[a].eff[1] = RsEffect.{kind = EF_NONE, by = 7};     // a free slot with stale contents
  b[0].c[a].eff[3] = RsEffect.{kind = EF_NONE, by = 9};
  up := rs_release_stand(b[..], a);
  #assert up.on && up.halts == (1 | (1 << 15)) && b[0].c[a].eff[0].kind == EF_NONE && b[0].c[a].eff[15].kind == EF_NONE && rs_can_act(b[0].c[a]);
  // the resolution put something in slot 0: that halt takes the first free slot, the other its own
  b[0].c[a].eff[0] = RsEffect.{kind = EF_COND, by = 3, until = 4};
  rs_release_fall(b[..], a, up);
  #assert b[0].c[a].eff[0].kind == EF_COND && b[0].c[a].eff[0].by == 3;
  #assert b[0].c[a].eff[1].kind == EF_HALT && b[0].c[a].eff[1].by == 1 && b[0].c[a].eff[1].until == 5;
  #assert b[0].c[a].eff[15].kind == EF_HALT && b[0].c[a].eff[15].by == 2 && b[0].c[a].eff[15].until == 6;
  #assert b[0].c[a].eff[3].kind == EF_NONE && b[0].c[a].eff[3].by == 9 && !rs_can_act(b[0].c[a]);
  // slot 0 is free and the halt's own slot is not: slot 0 is the first free one
  b[0].c[a].eff[5] = RsEffect.{kind = EF_HALT, by = 6, until = 7};
  for k: 0..<RS_EFFECTS { if k != 5 { b[0].c[a].eff[k] = RsEffect.{kind = EF_NONE}; } }
  up = rs_release_stand(b[..], a);
  b[0].c[a].eff[5] = RsEffect.{kind = EF_COND, by = 3, until = 4};
  rs_release_fall(b[..], a, up);
  #assert b[0].c[a].eff[0].kind == EF_HALT && b[0].c[a].eff[0].by == 6 && b[0].c[a].eff[5].kind == EF_COND;
  // with every slot taken, a halt has nowhere to go and nothing is written over
  b[0].c[a].eff[1] = RsEffect.{kind = EF_NONE}; b[0].c[a].eff[15] = RsEffect.{kind = EF_NONE}; b[0].c[a].eff[0] = RsEffect.{kind = EF_HALT, by = 1, until = 5};
  up = rs_release_stand(b[..], a);
  for k: 0..<RS_EFFECTS { b[0].c[a].eff[k] = RsEffect.{kind = EF_COND, by = 4, until = 8}; }
  rs_release_fall(b[..], a, up);
  for k: 0..<RS_EFFECTS { #assert b[0].c[a].eff[k].kind == EF_COND && b[0].c[a].eff[k].by == 4; }
}

#test "released: a fall closes only what was opened, and names that are not creatures change nothing" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]);
  a := rs_add(b[..], rs_fighter("Archer", 0, 3), 1, 3);
  b[0].c[a].dead = true; b[0].c[a].hp = 0;
  rs_release_fall(b[..], a, RsReleased.{});   // nothing was opened
  #assert b[0].c[a].dead && b[0].c[a].hp == 0;
  open := RsReleased.{on = true, dead = true, hp = 0, cond = RS_PRONE};
  rs_release_fall(b[..], -1, open);
  rs_release_fall(b[..], b[0].n, open);
  #assert b[0].c[b[0].n].cond == 0 && !b[0].c[b[0].n].dead && b[0].c[b[0].n].hp == 0 && b[0].c[a].cond == 0;
}
