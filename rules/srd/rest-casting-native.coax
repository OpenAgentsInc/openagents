#load "../../apps/openagents-web/old/v1/fivebar-test.coax";
#load "../../coax/lib/sys/tool.coax";
tool_main :: ()->int #export_c #effects(all) {
  for level:1..<7 { for path:0..<4 {
    b:[1]RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c:[2]RsCreature; b[0].c=c[..]; b[0].n=2; b[0].who = -1;
    c[0]=rs_warlock("Watcher",0,level,SP_ELDRITCH_BLAST); c[1]=rs_fighter("Other",1,3); c[1].x=3;
    sl:=fb_free_slot(b[..],0,1); if sl==0 { return 1; }
    c[0].slots[sl]=1; c[0].feats = rs_feature_put(c[0].feats, RS_FT_REBUKE, true); c[0].component_pouch=true;
    if !rs_grant_spell(c[0..<1],SP_FEATHER_FALL) { return 2; }
    if !rs_rest_schedule_enable(b[..]) || !rs_long_rest_start_owned(b[..],0,2,true) { return 3; }
    rs_tick(b[..],3600);
    if path<2 {
      b[0].who=0;
      if path==0 { if !rs_cast(b[..],0,SP_HEX,sl,0,0,1) { return 4; } }
      else { if !fb_cast_at_nothing(b[..],0,SP_HEX,sl) { return 5; } }
    } else {
      b[0].who=1; b[0].turn.action=true; b[0].turn.bonus=true;
      if path==2 { if !rs_hellish_rebuke(b[..],0,1) { return 6; } }
      else { if !fb_cast(b[..],0,fb_spell(SP_FEATHER_FALL,1,FB_SELF),-1,0,0,-1) { return 7; } }
      if !c[0].reacted || b[0].who!=1 || !b[0].turn.action || !b[0].turn.bonus || b[0].turn.slot_spent || b[0].turn.leveled { return 8; }
    }
    if c[0].long_rest.phase!=2 || c[0].long_rest.interruptions!=1 || c[0].rest.phase!=0 || c[0].long_rest.short_due { return 9; }
    if c[0].slots[sl]!=c[0].slots_max[sl]-1 || c[0].rest.dice!=level { return 10; }
    if path<2 && (!b[0].turn.slot_spent || !b[0].turn.leveled || !b[0].turn.bonus) { return 11; }
  } }
  for spent:0..<2 {
    b:[1]RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); c:[2]RsCreature; b[0].c=c[..]; b[0].n=2; b[0].who = -1;
    c[0]=rs_warlock("True owner",0,3,SP_ELDRITCH_BLAST); c[1]=rs_fighter("Borrower",1,3); c[1].x=3;
    c[0].slots[2]=1; c[0].feats = rs_feature_put(c[0].feats, RS_FT_REBUKE, true);
    if !rs_rest_schedule_enable(b[..]) || !rs_long_rest_start_owned(b[..],0,2,true) { return 12; }
    rs_tick(b[..],3600); b[0].who=0; b[0].turn.action=true; b[0].turn.slot_spent=spent==1;
    if !rs_reaction_frame_begin(b[..],1) { return 13; }
    if rs_hellish_rebuke(b[..],0,1)!=(spent==0) { return 14; }
    if c[0].long_rest.phase!=(ifx spent==0 then 2 else 1) || c[0].slots[2]!=1 { return 15; }
    rs_reaction_frame_end(b[..]);
    if b[0].who!=0 || !b[0].turn.action || !b[0].turn.slot_spent || b[0].turn.leveled!=(spent==0) { return 16; }
  }
  tool_errln("PASS REST-CASTING (24 level/path transactions and true-owner borrowed Reaction admission)");
  return 0;
}
