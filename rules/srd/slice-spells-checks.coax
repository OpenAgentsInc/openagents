// Inflict Wounds, Acid Splash, Magic Missile, Mass Healing Word and Shatter (#13043):
// records against the pinned source, and their effects through the shared
// battle with fixed dice (every die lands on half its faces: d4 2, d6 3,
// d10 5, d20 10), so each expected number is read from the SRD text.
//   coax/bin/coax test --library rules/srd/slice-spells-checks.coax
#load "battle.coax";
#load "catalog.coax";
#load "executable-source-ids.coax";

#test "Devotion Zone of Truth creates a ten-minute sphere and saves on a turn starting inside" {
  sp:=-1;
  for k:0..<RS_MORE_END { if rs_spell(k).id=="zone-of-truth" { sp=k; } }
  #assert sp>=0 && rs_executable_spell(sp);
  #assert !rs_class_spell_granted(rs_paladin("Paladin",0,4),sp);
  b:[1]RsBattle; c:[3]RsCreature; b[0].c=c[..]; b[0].w=20; b[0].h=8; b[0].dice[0].fixed=true;
  a:=rs_add(b[..],rs_paladin("Paladin",0,5),1,1);
  j:=rs_add(b[..],rs_fighter("Inside",0,1),8,1);
  far:=rs_add(b[..],rs_fighter("Outside",0,1),12,1);
  #assert rs_class_spell_granted(c[a],sp);
  rs_start_turn(b[..],a);
  rolls:=b[0].dice[0].rolled;
  slots:=c[a].slots[2];
  #assert rs_cast(b[..],a,sp,2,8,1,-1);
  #assert c[a].slots[2]==slots-1 && c[a].conc<0 && b[0].turn.action;
  z:=b[0].zone[0];
  #assert z.on && z.spell==sp && z.until==600 && z.r_ft==15;
  #assert b[0].dice[0].rolled==rolls;
  rs_start_turn(b[..],far);
  #assert b[0].dice[0].rolled==rolls;
  rs_start_turn(b[..],j);
  #assert b[0].dice[0].rolled==rolls+1;
  b[0].clock=599; rs_tick_raw(b[..],1);
  #assert !b[0].zone[0].on;
}

#test "Devotion Protection from Evil and Good needs holy water and hinders attacks from a Fiend" {
  sp:=-1;
  for k:0..<RS_MORE_END { if rs_spell(k).id=="protection-from-evil-and-good" { sp=k; } }
  #assert sp>=0 && rs_executable_spell(sp);
  #assert !rs_class_spell_granted(rs_paladin("Paladin",0,2),sp);
  b:[1]RsBattle; c:[3]RsCreature; b[0].c=c[..]; b[0].w=8; b[0].h=8;
  a:=rs_add(b[..],rs_paladin("Paladin",0,3),2,2);
  imp:=rs_add(b[..],rs_monster(MON_IMP,"Imp",1),3,2);
  fighter:=rs_add(b[..],rs_fighter("Fighter",1,1),2,3);
  #assert rs_class_spell_granted(c[a],sp) && rs_attack_edge(b[..],imp,a,true,true)==0;
  rs_start_turn(b[..],a);
  slots:=c[a].slots[1];
  #assert !rs_cast(b[..],a,sp,1,0,0,a) && c[a].slots[1]==slots && !b[0].turn.action;
  c[a].materials[1]=RsMaterialStock.{key=RS_EXEC_SOURCE[sp],count=1};
  #assert rs_cast(b[..],a,sp,1,0,0,a);
  #assert c[a].slots[1]==slots-1 && c[a].materials[1].count==0 && c[a].conc==sp;
  #assert rs_attack_edge(b[..],imp,a,true,true)==-1 && rs_attack_edge(b[..],fighter,a,true,true)==0;
  rs_end_concentration(b[..],a,"");
  #assert rs_attack_edge(b[..],imp,a,true,true)==0;
  rs_start_turn(b[..],a);
  c[a].materials[1].count=1;
  targets:=[1]int.[fighter];
  option:[1]RsCastOptions;
  #assert !rs_cast_creatures_with(b[..],a,sp,1,targets[..],false,option[..]);
  #assert c[a].materials[1].count==1 && !b[0].turn.action;
  option[0].willing=true;
  #assert rs_cast_creatures_with(b[..],a,sp,1,targets[..],false,option[..]);
  #assert c[a].materials[1].count==0 && rs_effect(c[fighter],EF_PROTECTION);
}

#test "Blessed Warrior Guidance adds a d4 only to its chosen skill while the Paladin concentrates" {
  sp:=-1;
  for k:0..<RS_MORE_END { if rs_spell(k).id=="guidance" { sp=k; } }
  #assert sp>=0 && rs_executable_spell(sp);
  #assert !rs_class_spell_granted(rs_paladin("Paladin",0,1),sp);
  b:[1]RsBattle; c:[1]RsCreature; b[0].c=c[..]; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  a:=rs_add(b[..],rs_paladin("Paladin",0,2),1,1);
  #assert rs_class_spell_granted(c[a],sp);
  skill:=RsAbilityRequest.{ability=RS_WIS,skill=SK_PERCEPTION,dc=30};
  unrelated:=RsAbilityRequest.{ability=RS_WIS,skill=SK_SURVIVAL,dc=30};
  ordinary:=rs_ability_check(b[..],a,skill);
  other:=rs_ability_check(b[..],a,unrelated);
  rs_start_turn(b[..],a);
  slots:=c[a].slots[1];
  #assert rs_cast(b[..],a,sp,0,0,0,a) && c[a].conc==sp;
  #assert b[0].turn.action && !b[0].turn.slot_spent && c[a].slots[1]==slots;
  rolls:=b[0].dice[0].rolled;
  passive:=rs_passive_perception(b[..],a,skill);
  #assert passive.total==ordinary.total && b[0].dice[0].rolled==rolls;
  for trial:0..<2 {
    guided:=rs_ability_check(b[..],a,skill);
    unaffected:=rs_ability_check(b[..],a,unrelated);
    #assert guided.total==ordinary.total+2 && unaffected.total==other.total;
  }
  rs_end_concentration(b[..],a,"");
  again:=rs_ability_check(b[..],a,skill);
  #assert again.total==ordinary.total;
}

#test "Guidance needs a willing recipient and only the newest overlapping cast applies" {
  b:[1]RsBattle; c:[3]RsCreature; b[0].c=c[..]; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  a:=rs_add(b[..],rs_paladin("Paladin",0,2),1,1);
  j:=rs_add(b[..],rs_fighter("Ally",0,1),2,1);
  second:=rs_add(b[..],rs_paladin("Other",0,2),3,1);
  picks:=[1]int.[j];
  options:=[1]RsCastOptions.[RsCastOptions.{guidance=SK_ATHLETICS}];
  rs_start_turn(b[..],a);
  #assert !rs_cast_creatures_with(b[..],a,SP_GUIDANCE,0,picks[..],false,options[..]);
  #assert !b[0].turn.action && c[a].conc<0;
  options[0].willing=true;
  #assert rs_cast_creatures_with(b[..],a,SP_GUIDANCE,0,picks[..],false,options[..]);
  athletics:=RsAbilityRequest.{ability=RS_STR,skill=SK_ATHLETICS,dc=30};
  perception:=RsAbilityRequest.{ability=RS_WIS,skill=SK_PERCEPTION,dc=30};
  before:=rs_ability_check(b[..],j,athletics);
  ordinary:=rs_ability_check(b[..],j,perception);
  rs_start_turn(b[..],second);
  options[0].guidance=RS_SKILLS;
  #assert !rs_cast_creatures_with(b[..],second,SP_GUIDANCE,0,picks[..],false,options[..]);
  #assert !b[0].turn.action;
  options[0].guidance=SK_PERCEPTION;
  #assert rs_cast_creatures_with(b[..],second,SP_GUIDANCE,0,picks[..],false,options[..]);
  newer:=rs_ability_check(b[..],j,perception);
  ignored:=rs_ability_check(b[..],j,athletics);
  #assert newer.total==ordinary.total+2 && ignored.total==before.total-2;
  rs_end_concentration(b[..],second,"");
  resumed:=rs_ability_check(b[..],j,athletics);
  #assert resumed.total==before.total;
}

#test "Aid increases current and maximum Hit Points for up to three creatures for eight hours" {
  sp:=-1;
  for k:0..<RS_MORE_END { if rs_spell(k).id=="aid" { sp=k; } }
  #assert sp>=0 && rs_executable_spell(sp);
  #assert !rs_class_spell_granted(rs_cleric("Cleric",0,2),sp) && rs_class_spell_granted(rs_cleric("Cleric",0,3),sp);
  #assert !rs_class_spell_granted(rs_paladin("Paladin",0,4),sp) && rs_class_spell_granted(rs_paladin("Paladin",0,5),sp);
  b:[1]RsBattle; c:[4]RsCreature; b[0].c=c[..]; b[0].w=12; b[0].h=4;
  a:=rs_add(b[..],rs_cleric("Cleric",0,5),1,1);
  for k:1..<4 {
    _:=rs_add(b[..],rs_fighter("Ally",0,3),k+1,1);
    c[k].hp=10; c[k].hp_max=20;
  }
  rs_start_turn(b[..],a);
  picks:=[3]int.[1,2,3];
  #assert rs_cast_creatures(b[..],a,sp,3,picks[..],false);
  for k:1..<4 { #assert c[k].hp==20 && c[k].hp_max==30 && c[k].temp==0; }
  #assert c[a].hp==c[a].hp_max && b[0].turn.action && b[0].turn.slot_spent;
  c[1].hp-=3;
  b[0].clock=28799;
  rs_tick_raw(b[..],0.5);
  #assert c[1].hp==17 && c[1].hp_max==30;
  rs_tick_raw(b[..],0.5);
  #assert c[1].hp==7 && c[1].hp_max==20;
  for k:2..<4 { #assert c[k].hp==10 && c[k].hp_max==20; }
}

#test "Aid prepays all targets and upcasting cannot add a fourth target" {
  b:[1]RsBattle; c:[5]RsCreature; b[0].c=c[..]; b[0].w=12; b[0].h=4;
  a:=rs_add(b[..],rs_cleric("Cleric",0,5),1,1);
  for k:1..<5 { _:=rs_add(b[..],rs_fighter("Ally",0,3),k+1,1); }
  base:=c[1].hp_max;
  picks:=[4]int.[1,2,3,4];
  rs_start_turn(b[..],a);
  slots:=c[a].slots[3];
  #assert !rs_cast_creatures(b[..],a,SP_AID,3,picks[..],false);
  for k:0..<RS_EFFECTS { #assert rs_effect_add(c[3..<4],RsEffect.{kind=EF_HEX,by=k}); }
  #assert !rs_cast_creatures(b[..],a,SP_AID,3,picks[0..<3],false);
  #assert c[a].slots[3]==slots && !b[0].turn.action && c[1].hp_max==base;
  rs_effect_end(c[3..<4],0);
  c[3].hp_max=9223372036854775802;
  #assert !rs_cast_creatures(b[..],a,SP_AID,3,picks[0..<3],false);
  #assert c[a].slots[3]==slots && c[1].hp_max==base;
  c[3].hp_max=base;
  #assert rs_cast(b[..],a,SP_AID,3,0,0,1);
  for k:1..<4 { #assert c[k].hp_max==base+10; }
  #assert c[4].hp_max==base;
}

#test "Aid preflight uses the exact increase at the Hit Point ceiling" {
  s:=rs_spell(SP_AID);
  c:RsCreature;
  for slot:2..<10 {
    variant:=rs_spell_variant(s,SP_AID,slot,RsCastOptions.{});
    increase:=5*(slot-1);
    c.hp_max=9223372036854775807-increase;
    #assert rs_effect_demand(c,variant,-1,0,SP_AID)==1;
    c.hp_max+=1;
    #assert rs_effect_demand(c,variant,-1,0,SP_AID)==RS_EFFECTS+1;
  }
  c.hp_max=9223372036854775807;
  c.eff[0]=RsEffect.{kind=EF_AID,cond=10,until=10};
  variant:=rs_spell_variant(s,SP_AID,2,RsCastOptions.{});
  #assert rs_effect_demand(c,variant,-1,0,SP_AID)==1;
}

#test "Life Cleric always prepares Lesser Restoration at level 3 and spends a Bonus Action at Touch range" {
  sp:=-1;
  for k:0..<RS_MORE_END { if rs_spell(k).id=="lesser-restoration" { sp=k; } }
  #assert sp>=0 && rs_executable_spell(sp);
  #assert !rs_class_spell_granted(rs_cleric("Cleric",0,2),sp);
  for condition:[4]int.[RS_BLINDED,RS_DEAFENED,RS_PARALYZED,RS_POISONED] {
    b:[1]RsBattle; c:[2]RsCreature; b[0].c=c[..]; b[0].w=6; b[0].h=4;
    a:=rs_add(b[..],rs_cleric("Cleric",0,3),1,1);
    j:=rs_add(b[..],rs_fighter("Ally",0,3),3,1);
    #assert rs_class_spell_granted(c[a],sp);
    #assert rs_effect_add(c[j..<j+1],RsEffect.{kind=EF_COND,cond=condition|RS_FRIGHTENED,until=60});
    c[j].cond|=RS_PRONE;
    rs_start_turn(b[..],a);
    slots:=c[a].slots[2];
    #assert !rs_cast(b[..],a,sp,2,0,0,j);
    #assert c[a].slots[2]==slots && !b[0].turn.bonus && rs_has(c[j],condition);
    rs_place(b[..],j,2,1);
    #assert rs_cast(b[..],a,sp,2,0,0,j);
    #assert c[a].slots[2]==slots-1 && b[0].turn.bonus && !b[0].turn.action;
    #assert !rs_has(c[j],condition) && c[j].cond==(RS_FRIGHTENED|RS_PRONE);
    #assert c[j].eff[0].kind==EF_COND && c[j].eff[0].cond==RS_FRIGHTENED && c[j].eff[0].until==60;
  }
}

#test "Lesser Restoration chooses one of two active conditions and rejects an invalid choice before payment" {
  b:[1]RsBattle; c:[2]RsCreature; b[0].c=c[..]; b[0].w=5; b[0].h=4;
  a:=rs_add(b[..],rs_cleric("Cleric",0,3),1,1);
  j:=rs_add(b[..],rs_fighter("Ally",0,3),2,1);
  c[j].cond=RS_BLINDED|RS_POISONED;
  picks:=[1]int.[j];
  choices:=[1]RsCastOptions.[RsCastOptions.{restoration=RS_PRONE}];
  rs_start_turn(b[..],a);
  slots:=c[a].slots[2];
  #assert !rs_cast_creatures_with(b[..],a,SP_LESSER_RESTORATION,2,picks[..],false,choices[..]);
  #assert c[a].slots[2]==slots && !b[0].turn.bonus;
  choices[0].restoration=RS_POISONED;
  #assert rs_cast_creatures_with(b[..],a,SP_LESSER_RESTORATION,2,picks[..],false,choices[..]);
  #assert c[j].cond==RS_BLINDED && c[a].slots[2]==slots-1 && b[0].turn.bonus;
}

sl_learn :: (b: [] RsBattle, i: int, sp: int) {
  keys := [1] int.[RS_EXEC_SOURCE[sp]];
  // A Wizard prepares only from its spellbook: copy the spell in first, as a Wizard would.
  if b[0].c[i].klass == RS_WIZARD { _ := rs_spellbook_add(b[0].c[i..<i+1],keys[0]); }
  #assert rs_set_spells(b[0].c[i..<i+1],keys[..]);
}
sl_sturdy :: (b: [] RsBattle, j: int, con: int, dex: int) {
  b[0].c[j].hp = 200; b[0].c[j].hp_max = 200; b[0].c[j].score[RS_CON] = con; b[0].c[j].score[RS_DEX] = dex;
  b[0].c[j].shield_spell = false;   // the preset Sorcerer knows Shield; a plain target here does not
}

#test "the slice records carry their pinned source level, timing, range, components, page and classes" #steps 100000000 {
  for sp: [5] int.[SP_INFLICT_WOUNDS,SP_ACID_SPLASH,SP_MAGIC_MISSILE,SP_MASS_HEALING_WORD,SP_SHATTER] {
    s := rs_spell(sp); src := srd_source_lookup(s.id);
    #assert s.srd && s.part_of < 0 && s.step_n > 0 && rs_executable_spell(sp);
    #assert s.level == src.level && s.page == src.page && s.components == src.components;
    #assert s.concentration == src.concentration && s.cast_time == src.cast_kind;
    #assert s.range_ft == (ifx src.range_kind == 1 then 5 else src.range_value);
    #assert RS_EXECUTABLE_SOURCE_IDS[sp] == s.id && RS_SPELL_KEYS[RS_EXEC_SOURCE[sp]].id == s.id;
  }
  #assert RS_SPELL_KEYS[RS_KEY_MAGIC_MISSILE].id == rs_spell(SP_MAGIC_MISSILE).id;
}

#test "Inflict Wounds: touch, Con save for half of 2d10 Necrotic, one more d10 a slot level" {
  for slot: [2] int.[1,2] { for strong: 0..<2 {
    b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_cleric("Cleric",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),2,1);
    sl_learn(b[..],a,SP_INFLICT_WOUNDS); sl_sturdy(b[..],t,ifx strong == 1 then 30 else 1,10);
    rs_start_turn(b[..],a); slots := b[0].c[a].slots[slot];
    #assert rs_cast(b[..],a,SP_INFLICT_WOUNDS,slot,0,0,t);
    full := 5 * (2 + slot - 1);
    #assert 200 - b[0].c[t].hp == (ifx strong == 1 then full / 2 else full);
    #assert b[0].c[a].slots[slot] == slots - 1 && b[0].turn.action;
  } }
  // Out of touch reach: refused before anything is spent.
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_cleric("Cleric",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),4,1);
  sl_learn(b[..],a,SP_INFLICT_WOUNDS); rs_start_turn(b[..],a);
  slots := b[0].c[a].slots[1]; hp := b[0].c[t].hp; rolls := b[0].dice[0].rolled;
  #assert !rs_cast(b[..],a,SP_INFLICT_WOUNDS,1,0,0,t);
  #assert b[0].c[a].slots[1] == slots && b[0].c[t].hp == hp && b[0].dice[0].rolled == rolls && !b[0].turn.action;
}

#test "Acid Splash: a Dex save or 1d6 Acid to each creature in the 5-foot Sphere, growing with the caster's level" {
  for level: [2] int.[1,5] { for nimble: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 10; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,level),1,1);
    t := rs_add(b[..],rs_sorcerer("Centre",1,3),8,4); u := rs_add(b[..],rs_sorcerer("Beside",1,3),9,4);
    far := rs_add(b[..],rs_sorcerer("Outside",1,3),12,4);
    for j: [3] int.[t,u,far] { sl_sturdy(b[..],j,10,ifx nimble == 1 then 30 else 1); }
    sl_learn(b[..],a,SP_ACID_SPLASH); rs_start_turn(b[..],a);
    #assert rs_cast(b[..],a,SP_ACID_SPLASH,0,8,4,-1);
    full := 3 * (ifx level >= 5 then 2 else 1);
    // The level 5 preset is an Evoker: Potent Cantrip (level 3) halves a saved cantrip's damage.
    dealt := ifx nimble == 0 then full else ifx b[0].c[a].potent then full / 2 else 0;
    #assert 200 - b[0].c[t].hp == dealt && 200 - b[0].c[u].hp == dealt && b[0].c[far].hp == 200;
  } }
  // A point beyond 60 feet is refused.
  b: [1] RsBattle; b[0].w = 40; b[0].h = 4; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_wizard("Wizard",0,1),0,1); sl_learn(b[..],a,SP_ACID_SPLASH); rs_start_turn(b[..],a);
  #assert !rs_cast(b[..],a,SP_ACID_SPLASH,0,13,1,-1) && !b[0].turn.action;
}

#test "Magic Missile: three darts of 1d4 + 1 Force that never miss, one more a slot level, split as chosen" {
  for slot: [2] int.[1,2] {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),10,1);
    sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_sturdy(b[..],t,10,10); b[0].c[t].ac = 30;
    rs_start_turn(b[..],a); #assert rs_cast(b[..],a,SP_MAGIC_MISSILE,slot,0,0,t);
    #assert 200 - b[0].c[t].hp == 3 * (3 + slot - 1);
  }
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1);
  t := rs_add(b[..],rs_sorcerer("One",1,3),10,1); u := rs_add(b[..],rs_sorcerer("Two",1,3),11,2);
  sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_sturdy(b[..],t,10,10); sl_sturdy(b[..],u,10,10);
  rs_start_turn(b[..],a); picks := [3] int.[t,u,u];
  #assert rs_cast_creatures(b[..],a,SP_MAGIC_MISSILE,1,picks[..],false);
  #assert 200 - b[0].c[t].hp == 3 && 200 - b[0].c[u].hp == 6;
  // A fourth dart needs a 2nd-level slot; with a 1st it is refused before spending.
  b2: [1] RsBattle; b2[0].w = 30; b2[0].h = 8; b2[0].dice[0].fixed = true;
  a2 := rs_add(b2[..],rs_wizard("Wizard",0,3),1,1); t2 := rs_add(b2[..],rs_sorcerer("One",1,3),10,1);
  sl_learn(b2[..],a2,SP_MAGIC_MISSILE); rs_start_turn(b2[..],a2); slots := b2[0].c[a2].slots[1];
  four := [4] int.[t2,t2,t2,t2];
  #assert !rs_cast_creatures(b2[..],a2,SP_MAGIC_MISSILE,1,four[..],false) && b2[0].c[a2].slots[1] == slots;
}

#test "Shield answers Magic Missile once before the darts and then takes none of them" {
  for warded: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Warded",1,3),10,1);
    other := rs_add(b[..],rs_sorcerer("Open",1,3),11,1);
    sl_sturdy(b[..],t,10,10); sl_sturdy(b[..],other,10,10);
    sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_learn(b[..],t,SP_SHIELD); b[0].c[t].shield_spell = true;
    if warded == 1 { rs_shield_begin(b[0].c[t..<t+1]); b[0].c[t].reacted = true; }
    slots := b[0].c[t].slots[1];
    rs_start_turn(b[..],a); picks := [3] int.[t,t,other];
    #assert rs_cast_creatures(b[..],a,SP_MAGIC_MISSILE,1,picks[..],false);
    #assert b[0].c[t].hp == 200 && b[0].c[t].shield_active && 200 - b[0].c[other].hp == 3;
    // One Reaction and one slot when it reacted; none when Shield was already up.
    #assert b[0].c[t].slots[1] == (ifx warded == 1 then slots else slots - 1) && b[0].c[t].reacted;
  }
  // Without Shield prepared, or with its Reaction spent, every dart lands.
  for spent: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,3),1,1); t := rs_add(b[..],rs_sorcerer("Target",1,3),10,1);
    sl_learn(b[..],a,SP_MAGIC_MISSILE); sl_sturdy(b[..],t,10,10);
    if spent == 1 { sl_learn(b[..],t,SP_SHIELD); b[0].c[t].shield_spell = true; b[0].c[t].reacted = true; }
    rs_start_turn(b[..],a); #assert rs_cast(b[..],a,SP_MAGIC_MISSILE,1,0,0,t);
    #assert 200 - b[0].c[t].hp == 9 && !b[0].c[t].shield_active;
  }
}

#test "Mass Healing Word: a Bonus Action healing up to six chosen creatures 2d4 + modifier, 1d4 more a slot level" {
  // A Bard caster: the preset Cleric's Disciple of Life would add its own healing.
  for slot: [2] int.[3,4] {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_bard("Bard",0,5),1,1);
    // The preset slot table stops at level 6 (the slice); grant the 4th-level slot directly.
    b[0].c[a].slots_max[4] = 1; b[0].c[a].slots[4] = 1;
    picks: [6] int;
    for k: 0..<6 { picks[k] = rs_add(b[..],rs_druid("Ally",0,3),2 + k,2); b[0].c[picks[k]].hp = 1; }
    sl_learn(b[..],a,SP_MASS_HEALING_WORD); rs_start_turn(b[..],a); slots := b[0].c[a].slots[slot];
    #assert rs_cast_creatures(b[..],a,SP_MASS_HEALING_WORD,slot,picks[..],false);
    heal := 2 * (2 + slot - 3) + rs_mod(b[0].c[a].score[RS_CHA]);
    for k: 0..<6 { #assert b[0].c[picks[k]].hp == 1 + heal; }
    #assert b[0].turn.bonus && !b[0].turn.action && b[0].c[a].slots[slot] == slots - 1;
  }
  // A seventh creature is refused before anything is spent.
  b: [1] RsBattle; b[0].w = 30; b[0].h = 8; b[0].dice[0].fixed = true;
  a := rs_add(b[..],rs_bard("Bard",0,5),1,1);
  seven: [7] int;
  for k: 0..<7 { seven[k] = rs_add(b[..],rs_druid("Ally",0,3),2 + k,2); b[0].c[seven[k]].hp = 1; }
  sl_learn(b[..],a,SP_MASS_HEALING_WORD); rs_start_turn(b[..],a); slots := b[0].c[a].slots[3];
  #assert !rs_cast_creatures(b[..],a,SP_MASS_HEALING_WORD,3,seven[..],false);
  #assert b[0].c[a].slots[3] == slots && !b[0].turn.bonus && b[0].c[seven[0]].hp == 1;
}

#test "a Sphere at a point includes its caster; a Cube or Line from the caster does not; Sculpt Spells can spare it" {
  // Fireball (p.131) centred beside its own caster: the caster is in the Sphere and saves like anyone.
  for level: [2] int.[5,6] {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 12; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,level),5,5); t := rs_add(b[..],rs_sorcerer("Foe",1,3),7,5);
    sl_sturdy(b[..],a,10,1); sl_sturdy(b[..],t,10,1);
    sl_learn(b[..],a,SP_FIREBALL); rs_start_turn(b[..],a);
    #assert rs_cast(b[..],a,SP_FIREBALL,3,6,5,-1);
    #assert 200 - b[0].c[t].hp == 24;   // 8d6 on a failed save
    // The level 6 Evoker's Sculpt Spells spares its own side, the caster included.
    #assert 200 - b[0].c[a].hp == (ifx b[0].c[a].sculpt then 0 else 24);
  }
  // Thunderwave's Cube and Lightning Bolt's Line originate from the caster and leave it out.
  for sp: [2] int.[SP_THUNDERWAVE,SP_LIGHTNING_BOLT] {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 12; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,5),5,5); t := rs_add(b[..],rs_sorcerer("Foe",1,3),6,5);
    sl_sturdy(b[..],a,1,1); sl_sturdy(b[..],t,1,1);
    sl_learn(b[..],a,sp); rs_start_turn(b[..],a);
    #assert rs_cast(b[..],a,sp,rs_spell(sp).level,7,5,-1);
    #assert b[0].c[a].hp == 200 && b[0].c[t].hp < 200;
  }
}

#test "a caster inside its own area needs effect room too, refused before anything is spent" {
  // Hypnotic Pattern's 30-foot Cube at a point covers its own caster, whose possible daze needs a record.
  for full: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 12; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,5),5,5); t := rs_add(b[..],rs_sorcerer("Foe",1,3),6,5);
    sl_sturdy(b[..],a,10,10); sl_sturdy(b[..],t,10,10);
    if full == 1 { for k: 0..<RS_EFFECTS { b[0].c[a].eff[k] = RsEffect.{kind=EF_HEX,by=99,spell=-1,until=100}; } }
    sl_learn(b[..],a,SP_HYPNOTIC_PATTERN); rs_start_turn(b[..],a);
    slots := b[0].c[a].slots[3]; rolls := b[0].dice[0].rolled; seq := b[0].book[0].seq;
    #assert rs_cast(b[..],a,SP_HYPNOTIC_PATTERN,3,5,5,-1) == (full == 0);
    if full == 1 { #assert b[0].c[a].slots[3] == slots && b[0].dice[0].rolled == rolls && b[0].book[0].seq == seq && !b[0].turn.action; }
    else {
      // The caster saw its own pattern and failed its save (fixed d20 10 + Wis vs its own DC):
      // Charmed and Incapacitated, it loses concentration, so the Pattern and its daze end.
      saved := false;
      for k: 0..<b[0].book[0].count { e := rs_recent(b[0].book[0],k); if e.kind == RS_EV_SAVE && e.to == a { saved = true; } }
      #assert saved && b[0].c[a].slots[3] == slots - 1 && b[0].c[a].conc != SP_HYPNOTIC_PATTERN && !rs_has(b[0].c[a],RS_INCAPACITATED);
    }
  }
}

#test "a world's declared spare-caster house rule keeps a caster out of its own Sphere and nothing else" {
  for profile: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 12; b[0].dice[0].fixed = true;
    if profile == 1 { #assert rs_set_areas(b[..],RS_SPARE_CASTER_AREAS); }
    a := rs_add(b[..],rs_wizard("Wizard",0,5),5,5); t := rs_add(b[..],rs_sorcerer("Foe",1,3),7,5);
    sl_sturdy(b[..],a,10,1); sl_sturdy(b[..],t,10,1);
    sl_learn(b[..],a,SP_FIREBALL); rs_start_turn(b[..],a);
    #assert rs_cast(b[..],a,SP_FIREBALL,3,6,5,-1);
    #assert 200 - b[0].c[t].hp == 24 && 200 - b[0].c[a].hp == (ifx profile == 1 then 0 else 24);
  }
  // Removing the profile (a reset) restores strict areas.
  b: [1] RsBattle; #assert rs_set_areas(b[..],RS_SPARE_CASTER_AREAS); rs_reset(b[..]);
  #assert b[0].areas.kind == RS_AREA_STRICT;
}

#test "Shatter: a Con save for half of 3d8 Thunder in a 10-foot Sphere, one more d8 a slot level; a Construct saves with Disadvantage" {
  for slot: [2] int.[2,3] { for strong: 0..<2 {
    b: [1] RsBattle; b[0].w = 30; b[0].h = 12; b[0].dice[0].fixed = true;
    a := rs_add(b[..],rs_wizard("Wizard",0,5),1,1);
    t := rs_add(b[..],rs_sorcerer("Centre",1,3),8,5); u := rs_add(b[..],rs_sorcerer("Edge",1,3),10,5);
    far := rs_add(b[..],rs_sorcerer("Outside",1,3),12,5);
    for j: [3] int.[t,u,far] { sl_sturdy(b[..],j,ifx strong == 1 then 30 else 1,10); }
    sl_learn(b[..],a,SP_SHATTER); rs_start_turn(b[..],a);
    #assert rs_cast(b[..],a,SP_SHATTER,slot,8,5,-1);
    full := 4 * (3 + slot - 2);
    dealt := ifx strong == 1 then full / 2 else full;
    #assert 200 - b[0].c[t].hp == dealt && 200 - b[0].c[u].hp == dealt && b[0].c[far].hp == 200;
  } }
  // The Construct rider is a Disadvantage source: it joins other sources before they cancel.
  b: [1] RsBattle; b[0].w = 20; b[0].h = 8;
  t := rs_add(b[..],rs_sorcerer("Thing",1,3),3,3);
  #assert rs_save_edge_with(b[..],t,RS_CON,rs_save_rider_downs(RS_SAVE_RIDER_CONSTRUCT_DIS,b[0].c[t].construct)) == 0;
  b[0].c[t].construct = true;
  #assert rs_save_edge_with(b[..],t,RS_CON,rs_save_rider_downs(RS_SAVE_RIDER_CONSTRUCT_DIS,b[0].c[t].construct)) == -1;
  // Advantage from Rage on a Strength save cancels it rather than being overridden.
  b[0].c[t].raging = true;
  #assert rs_save_edge_with(b[..],t,RS_STR,1) == 0 && rs_save_edge_with(b[..],t,RS_STR,0) == 1;
  // Fixed dice show the second d20 is taken at Disadvantage: the save still rolls once a die.
  c: [1] RsBattle; c[0].w = 30; c[0].h = 12;
  a := rs_add(c[..],rs_wizard("Wizard",0,5),1,1); g := rs_add(c[..],rs_sorcerer("Golem",1,3),8,5);
  sl_sturdy(c[..],g,10,10); c[0].c[g].construct = true;
  sl_learn(c[..],a,SP_SHATTER); rs_start_turn(c[..],a);
  before := c[0].dice[0].rolled;
  #assert rs_cast(c[..],a,SP_SHATTER,2,8,5,-1);
  #assert c[0].dice[0].rolled - before == 2 + 3;   // two d20s at Disadvantage, then 3d8
}

#test "Revivify returns a recently dead creature at one Hit Point and spends one diamond" {
  b:[1]RsBattle; c:[3]RsCreature; b[0].c=c[..]; b[0].w=12; b[0].h=8;
  healer:=rs_add(b[..],rs_cleric("Cleric",0,5),1,1);
  ally:=rs_add(b[..],rs_fighter("Ally",0,1),2,1);
  foe:=rs_add(b[..],rs_fighter("Foe",1,1),3,1);
  b[0].clock=20;
  rs_damage(b[..],foe,ally,c[ally].hp+c[ally].hp_max,RS_SLASHING,false,-1);
  #assert c[ally].dead && c[ally].hp==0;
  b[0].clock=79;
  rs_start_turn(b[..],healer);
  slots:=c[healer].slots[3];
  #assert !rs_cast(b[..],healer,SP_REVIVIFY,3,0,0,ally);
  #assert c[ally].dead && c[healer].slots[3]==slots && !b[0].turn.action;
  c[healer].materials[0]=RsMaterialStock.{key=RS_EXEC_SOURCE[SP_REVIVIFY],count=1};
  #assert rs_cast(b[..],healer,SP_REVIVIFY,3,0,0,ally);
  #assert !c[ally].dead && c[ally].hp==1 && c[ally].death_ok==0 && c[ally].death_fail==0;
  #assert c[healer].materials[0].count==0 && c[healer].slots[3]==slots-1;
}

#test "Revivify refuses an older death and a living target before spending" {
  b:[1]RsBattle; c:[3]RsCreature; b[0].c=c[..]; b[0].w=12; b[0].h=8;
  healer:=rs_add(b[..],rs_cleric("Cleric",0,5),1,1);
  ally:=rs_add(b[..],rs_fighter("Ally",0,1),2,1);
  living:=rs_add(b[..],rs_fighter("Living",0,1),1,2);
  rs_damage(b[..],-1,ally,c[ally].hp+c[ally].hp_max,RS_SLASHING,false,-1);
  b[0].clock=61;
  rs_start_turn(b[..],healer);
  c[healer].materials[0]=RsMaterialStock.{key=RS_EXEC_SOURCE[SP_REVIVIFY],count=1};
  slots:=c[healer].slots[3];
  #assert !rs_cast(b[..],healer,SP_REVIVIFY,3,0,0,ally);
  #assert !rs_cast(b[..],healer,SP_REVIVIFY,3,0,0,living);
  #assert c[ally].dead && c[living].hp==c[living].hp_max;
  #assert c[healer].materials[0].count==1 && c[healer].slots[3]==slots && !b[0].turn.action;
}

#test "Revivify can be delivered by a capable familiar touching the corpse" {
  b:[1]RsBattle; c:[3]RsCreature; b[0].c=c[..]; b[0].w=20; b[0].h=8;
  i:=rs_add(b[..],rs_druid("Druid",0,5),1,1);
  j:=rs_add(b[..],rs_fighter("Ally",0,1),7,1);
  f:=rs_add(b[..],rs_monster(MON_CAT,"Familiar",0),6,1);
  c[f].familiar_owner=i+1;
  spells:=[1]int.[RS_EXEC_SOURCE[SP_REVIVIFY]];
  #assert rs_set_spells(c[0..<1],spells[..]);
  c[i].materials[0]=RsMaterialStock.{key=RS_EXEC_SOURCE[SP_REVIVIFY],count=1};
  rs_damage(b[..],-1,j,c[j].hp+c[j].hp_max,RS_SLASHING,false,-1);
  rs_start_turn(b[..],i);
  #assert !rs_cast(b[..],i,SP_REVIVIFY,3,0,0,j);
  #assert rs_familiar_touch(b[..],i,SP_REVIVIFY,3,j);
  #assert !c[j].dead && c[j].hp==1 && c[f].reacted && c[i].materials[0].count==0;
}
