// The Sorcerer's Font of Magic (SRD 5.2.1 p. 66): from level 2, a spell slot turns into Sorcery
// Points equal to its level (no action), never past its Sorcerer level in points; and, as a Bonus
// Action, points become one spell slot of level 1-5 by the Creating Spell Slots table (2, 3, 5, 6
// and 7 points; Sorcerer level 2, 3, 5, 7 and 9). A created slot is counted in created_slots and
// vanishes when it finishes a Long Rest (long-rest-resources.coax).
//   coax/bin/coax test --library rules/srd/class-sorcerer-checks.coax
#authority;

RS_SLOT_COST :: [6] int.[0, 2, 3, 5, 6, 7];
RS_SLOT_MIN :: [6] int.[0, 2, 3, 5, 7, 9];

rs_font_of_magic_ready :: (c: RsCreature) -> bool #effects(all) { return c.klass == RS_SORCERER && c.level >= 2 && rs_capable(c); }
// i spends a slot of `level` for that many Sorcery Points. A created slot goes first.
rs_slot_to_points :: (b: [] RsBattle, i: int, level: int) -> bool #effects(all) {
  if i < 0 || i >= b[0].n || level < 1 || level > 9 || !rs_font_of_magic_ready(b[0].c[i]) || b[0].c[i].slots[level] <= 0 { return false; }
  if b[0].c[i].uses[RS_USE_SORCERY] + level > b[0].c[i].uses_max[RS_USE_SORCERY] { return false; }
  b[0].c[i].slots[level] -= 1; b[0].c[i].uses[RS_USE_SORCERY] += level;
  if b[0].c[i].created_slots[level] > 0 { b[0].c[i].created_slots[level] -= 1; }
  rs_say_ft(b, RS_EV_FEAT, i, i, level, RS_FT_FONT_OF_MAGIC, ": Font of Magic, a spell slot for Sorcery Points");
  return true;
}
// i, on its turn, makes Sorcery Points into a spell slot of `level` with its Bonus Action.
rs_create_slot :: (b: [] RsBattle, i: int, level: int) -> bool #effects(all) {
  if level < 1 || level > 5 || !rs_bonus_free(b, i) || !rs_font_of_magic_ready(b[0].c[i]) { return false; }
  if b[0].c[i].level < RS_SLOT_MIN[level] || b[0].c[i].uses[RS_USE_SORCERY] < RS_SLOT_COST[level] { return false; }
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_SORCERY] -= RS_SLOT_COST[level];
  b[0].c[i].slots[level] += 1; b[0].c[i].created_slots[level] += 1;
  rs_say_ft(b, RS_EV_FEAT, i, i, level, RS_FT_FONT_OF_MAGIC, ": Font of Magic, Sorcery Points for a spell slot");
  return true;
}

#test "Font of Magic turns a slot into its level in Sorcery Points, never past the most, a created slot first" {
  for mode: 0..<10 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; _ := rs_add(b[..], rs_sorcerer("Sel", 0, 5), 1, 1); rs_fresh(b[..], 0);
    level := 2; b[0].c[0].uses[RS_USE_SORCERY] = 2;
    if mode == 1 { b[0].c[0].klass = RS_WIZARD; } else if mode == 2 { b[0].c[0].level = 1; } else if mode == 3 { b[0].c[0].cond = RS_STUNNED; }
    else if mode == 4 { b[0].c[0].slots[2] = 0; } else if mode == 5 { b[0].c[0].uses[RS_USE_SORCERY] = 4; } else if mode == 6 { b[0].c[0].uses[RS_USE_SORCERY] = 3; }
    else if mode == 7 { level = 0; } else if mode == 8 { level = 10; } else if mode == 9 { b[0].c[0].uses_max[RS_USE_SORCERY] = 0; b[0].c[0].uses[RS_USE_SORCERY] = 0; }
    pts := b[0].c[0].uses[RS_USE_SORCERY]; slots := b[0].c[0].slots[2];
    ok := mode == 0 || mode == 6;
    #assert rs_slot_to_points(b[..], 0, level) == ok && b[0].c[0].uses[RS_USE_SORCERY] == (ifx ok then pts + 2 else pts) && b[0].c[0].slots[2] == (ifx ok then slots - 1 else slots);
    #assert !b[0].turn.bonus && !b[0].turn.action;
    if ok { e := rs_recent(b[0].book[0], 0); #assert e.feat == RS_FT_FONT_OF_MAGIC && e.kind == RS_EV_FEAT && e.amount == 2 && e.by.value == 0; }
  }
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; _ := rs_add(b[..], rs_sorcerer("Sel", 0, 5), 1, 1); rs_fresh(b[..], 0);
  b[0].c[0].uses[RS_USE_SORCERY] = 0; b[0].c[0].slots[9] = 1; b[0].c[0].uses_max[RS_USE_SORCERY] = 20;
  #assert rs_slot_to_points(b[..], 0, 9) && b[0].c[0].uses[RS_USE_SORCERY] == 9;
  b[0].c[0].slots[1] = 3; b[0].c[0].created_slots[1] = 1;
  #assert rs_slot_to_points(b[..], 0, 1) && b[0].c[0].created_slots[1] == 0 && b[0].c[0].slots[1] == 2;
  #assert rs_slot_to_points(b[..], 0, 1) && b[0].c[0].created_slots[1] == 0 && b[0].c[0].slots[1] == 1;
  b[0].c[1] = b[0].c[0]; #assert !rs_slot_to_points(b[..], -1, 1) && !rs_slot_to_points(b[..], 1, 1) && b[0].c[1].slots[1] == 1;
}
#test "Font of Magic makes a slot of level 1-5 with its Bonus Action for 2, 3, 5, 6 or 7 points, at Sorcerer level 2, 3, 5, 7 or 9" {
  for level: 0..<7 {
    for sl: [5] int.[2, 3, 5, 7, 9] {
      for short: 0..<2 {
        b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; _ := rs_add(b[..], rs_sorcerer("Sel", 0, sl), 1, 1); rs_fresh(b[..], 0);
        cost := ifx level >= 1 && level <= 5 then RS_SLOT_COST[level] else 0;
        pts := rs_max(cost - short, 0); b[0].c[0].uses[RS_USE_SORCERY] = pts; b[0].c[0].uses_max[RS_USE_SORCERY] = 20;
        slots := b[0].c[0].slots[rs_min(level, 9)];
        ok := level >= 1 && level <= 5 && sl >= RS_SLOT_MIN[level] && short == 0;
        #assert rs_create_slot(b[..], 0, level) == ok && b[0].turn.bonus == ok;
        #assert b[0].c[0].uses[RS_USE_SORCERY] == (ifx ok then pts - cost else pts) && b[0].c[0].slots[rs_min(level, 9)] == (ifx ok then slots + 1 else slots);
        #assert b[0].c[0].created_slots[rs_min(level, 9)] == (ifx ok then 1 else 0);
        if ok { e := rs_recent(b[0].book[0], 0); #assert e.feat == RS_FT_FONT_OF_MAGIC && e.kind == RS_EV_FEAT && e.amount == level && e.by.value == 0; }
      }
    }
  }
  for mode: 0..<4 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; _ := rs_add(b[..], rs_sorcerer("Sel", 0, 5), 1, 1); rs_fresh(b[..], 0);
    if mode == 1 { b[0].turn.bonus = true; } else if mode == 2 { b[0].who = 1; } else if mode == 3 { b[0].c[0].klass = RS_WIZARD; }
    #assert rs_create_slot(b[..], 0, 1) == (mode == 0);
  }
}
