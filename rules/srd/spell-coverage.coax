// Spell coverage for the active Everglade levels 1-6 slice (#13030, #13043):
// for each base class spell table, which cantrips and 1st-3rd level spells
// have an executable record in the shared engine, and which exist only as
// canonical source text. "executor" means a record with an effect program is
// mapped to the source entry; it is NOT a claim that every mechanical clause
// of that spell is implemented or verified. Helpers count under their parent;
// house spells (srd: false) have no source entry and are not counted.
//
// This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards
// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the
// Creative Commons Attribution 4.0 International License, available at
// https://creativecommons.org/licenses/by/4.0/legalcode.
//
// Usage: coax/web/tool.sh rules/srd/spell-coverage.coax            per-class summary
//        coax/web/tool.sh rules/srd/spell-coverage.coax --list     plus one TSV row per spell
//        coax/web/tool.sh rules/srd/spell-coverage.coax --max-level N   (0..9, default 3)
//   coax/bin/coax test rules/srd/spell-coverage.coax
// battle.coax, not spells.coax alone: its checks exercise the #authority rest
// policy that engine.coax loads.
#load "battle.coax";
#load "data/spell-index.coax";
#load "../../coax/lib/sys/tool.coax";

// Class-table bits in the compact index: alphabetical, as the importer emits them.
SC_COV_CLASSES :: [8] string.["Bard", "Cleric", "Druid", "Paladin", "Ranger", "Sorcerer", "Warlock", "Wizard"];
SC_COV_SLICE_LEVEL :: 3;

ScCoverage :: struct { total: int; executable: int; }

#test "a source entry has an executor only when a canonical effect program maps to it" #steps 100000000 {
  fire_bolt := -1; mage_armor := RS_KEY_MAGE_ARMOR;
  for k: 0..<RS_SPELL_KEYS.count { if RS_SPELL_KEYS[k].id == "fire-bolt" { fire_bolt = k; } }
  #assert fire_bolt >= 0 && sc_cov_executable(fire_bolt);
  // The index carries Mage Armor as a source choice before any executor exists.
  #assert RS_SPELL_KEYS[mage_armor].id == "mage-armor" && !sc_cov_executable(mage_armor);
  #assert !sc_cov_executable(-1) && !sc_cov_executable(RS_SPELL_KEYS.count);
}
#test "every executable source entry is reached by some executable record, and no more than there are records" #steps 100000000 {
  covered := 0;
  for k: 0..<RS_SPELL_KEYS.count { if sc_cov_executable(k) { covered += 1; } }
  #assert covered > 0 && covered <= RS_MORE_END;
  for sp: 0..<RS_MORE_END {
    root := rs_spell_root(sp);
    if rs_spell(root).srd && rs_spell(root).step_n > 0 { #assert sc_cov_executable(RS_EXEC_SOURCE[root]); }
  }
}
#test "class coverage counts only that table's spells at or below the level, and never more executors than spells" #steps 100000000 {
  for klass: 0..<8 {
    slice := sc_cov_class(klass, SC_COV_SLICE_LEVEL); all := sc_cov_class(klass, 9); cantrips := sc_cov_class(klass, 0);
    #assert slice.total > 0 && slice.executable >= 0 && slice.executable <= slice.total;
    #assert cantrips.total <= slice.total && slice.total <= all.total && slice.executable <= all.executable;
  }
  // Paladin and Ranger have no cantrips in their base tables.
  #assert sc_cov_class(3, 0).total == 0 && sc_cov_class(4, 0).total == 0;
  bad := sc_cov_class(8, 3); #assert bad.total == 0 && bad.executable == 0;
  bad = sc_cov_class(-1, 3); #assert bad.total == 0;
  bad = sc_cov_class(0, -1); #assert bad.total == 0;
}

// True when an executable SRD record with an effect program maps to source key k.
sc_cov_executable :: (k: int) -> bool #effects(all) {
  if k < 0 || k >= RS_SPELL_KEYS.count { return false; }
  for sp: 0..<RS_MORE_END {
    if RS_EXEC_SOURCE[sp] != k { continue; }
    root := rs_spell_root(sp); s := rs_spell(root);
    if s.srd && s.step_n > 0 { return true; }
  }
  return false;
}
sc_cov_in_class :: (k: int, klass: int, max_level: int) -> bool #effects(all) {
  key := RS_SPELL_KEYS[k];
  return (key.classes & (1 << klass)) != 0 && key.level <= max_level;
}
sc_cov_class :: (klass: int, max_level: int) -> ScCoverage #effects(all) {
  c: ScCoverage;
  if klass < 0 || klass >= 8 || max_level < 0 { return c; }
  for k: 0..<RS_SPELL_KEYS.count {
    if !sc_cov_in_class(k, klass, max_level) { continue; }
    c.total += 1;
    if sc_cov_executable(k) { c.executable += 1; }
  }
  return c;
}

sc_cov_int :: (n: int) { buf: [32] u8; used := rs_put_int(buf[..], 0, n); tool_err(cast(string) buf[0..<used]); }
sc_cov_level :: (s: string) -> int {
  if s.count != 1 || s[0] < '0' || s[0] > '9' { return -1; }
  return cast(int) (s[0] - '0');
}
tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) { return 2; }
  list := false; max_level := SC_COV_SLICE_LEVEL; i := 0;
  while i < args[0].n {
    a := args_at(args[..], i);
    if a == "--list" { list = true; i += 1; }
    else if a == "--max-level" && i + 1 < args[0].n { max_level = sc_cov_level(args_at(args[..], i + 1)); i += 2; }
    else { max_level = -1; i = args[0].n; }
  }
  if max_level < 0 { tool_errln("usage: spell-coverage [--list] [--max-level 0..9]"); return 2; }
  if list {
    tool_errln("class\tlevel\tspell_id\tstatus");
    for klass: 0..<8 {
      for k: 0..<RS_SPELL_KEYS.count {
        if !sc_cov_in_class(k, klass, max_level) { continue; }
        tool_err(SC_COV_CLASSES[klass]); tool_err("\t"); sc_cov_int(RS_SPELL_KEYS[k].level); tool_err("\t");
        tool_err(RS_SPELL_KEYS[k].id); tool_errln(ifx sc_cov_executable(k) then "\texecutor" else "\tsource-only");
      }
    }
  }
  tool_err("# base class tables, spell levels 0-"); sc_cov_int(max_level);
  tool_errln(": executor = mapped effect program, not clause qualification");
  tool_errln("# class\tspells\texecutor\tsource_only");
  for klass: 0..<8 {
    c := sc_cov_class(klass, max_level);
    tool_err("# "); tool_err(SC_COV_CLASSES[klass]); tool_err("\t"); sc_cov_int(c.total); tool_err("\t");
    sc_cov_int(c.executable); tool_err("\t"); sc_cov_int(c.total - c.executable); tool_errln("");
  }
  distinct := 0; covered := 0;
  for k: 0..<RS_SPELL_KEYS.count {
    if RS_SPELL_KEYS[k].level > max_level { continue; }
    distinct += 1; if sc_cov_executable(k) { covered += 1; }
  }
  tool_err("# all distinct spells\t"); sc_cov_int(distinct); tool_err("\t"); sc_cov_int(covered); tool_err("\t");
  sc_cov_int(distinct - covered); tool_errln("");
  return 0;
}
