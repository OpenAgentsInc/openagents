// Writes spell-table.coax: every spell record rs_spell_record builds (spells.coax, more.coax,
// house.coax) as one constant table, so rs_spell is one index rather than a walk of the records,
// in the rules' checks and in a room's battle alike (#13593). Run it after changing a record; the
// check "every number's record is its table entry" in spells.coax fails until you do.
//   coax/web/tool.sh rules/srd/spell-table-build.coax --check rules/srd/spell-table.coax
//   coax/web/tool.sh rules/srd/spell-table-build.coax --out NEW_FILE   (then move it over spell-table.coax)
#load "battle.coax";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";

StArena :: struct { bytes: [1048576] u8; n: int; error: bool; }
st_put :: (s: string, a: [] StArena) {
  if a[0].n + s.count > a[0].bytes.count { a[0].error = true; return; }
  for c: s { a[0].bytes[a[0].n] = c; a[0].n += 1; }
}
st_int :: (n: int, a: [] StArena) {
  v := n; if v < 0 { st_put("-", a); v = -v; }
  buf: [32] u8; count := 0;
  while true { buf[count] = cast(u8) (48 + v % 10); count += 1; v = v / 10; if v == 0 { break; } }
  for j: 0..<count { one := [1] u8.[buf[count - 1 - j]]; st_put(cast(string) one[..], a); }
}
st_quote :: (s: string, a: [] StArena) {
  st_put("\"", a);
  for c: s {
    if c == 34 { st_put("\\\"", a); }
    else if c == 92 { st_put("\\\\", a); }
    else if c == 10 { st_put("\\n", a); }
    else if c == 9 { st_put("\\t", a); }
    else if c == 13 { st_put("\\r", a); }
    else { one := [1] u8.[c]; st_put(cast(string) one[..], a); }
  }
  st_put("\"", a);
}
st_s :: (key: string, v: string, a: [] StArena) { st_put(", ", a); st_put(key, a); st_put(" = ", a); st_quote(v, a); }
st_i :: (key: string, v: int, a: [] StArena) { st_put(", ", a); st_put(key, a); st_put(" = ", a); st_int(v, a); }
st_b :: (key: string, v: bool, a: [] StArena) { st_put(", ", a); st_put(key, a); st_put(ifx v then " = true" else " = false", a); }
st_record :: (s: RsSpell, a: [] StArena) {
  st_put("RsSpell.{id = ", a); st_quote(s.id, a);
  st_s("name", s.name, a); st_i("level", s.level, a); st_s("school", s.school, a); st_s("classes", s.classes, a);
  st_i("cast_time", s.cast_time, a); st_i("range_ft", s.range_ft, a); st_s("components", s.components, a);
  st_s("duration", s.duration, a); st_i("duration_s", s.duration_s, a); st_b("concentration", s.concentration, a);
  st_i("area", s.area, a); st_i("area_ft", s.area_ft, a); st_i("wide_ft", s.wide_ft, a); st_b("turn_save", s.turn_save, a);
  st_put(", steps = [RS_STEPS] RsStep.[", a);
  for k: 0..<RS_STEPS {
    if k > 0 { st_put(", ", a); }
    st_put("RsStep.{kind = ", a); st_int(s.steps[k].kind, a); st_i("a", s.steps[k].a, a); st_i("b", s.steps[k].b, a);
    st_i("c", s.steps[k].c, a); st_i("d", s.steps[k].d, a); st_put("}", a);
  }
  st_put("]", a);
  st_i("step_n", s.step_n, a); st_i("part_of", s.part_of, a); st_b("ritual", s.ritual, a); st_b("humanoid_only", s.humanoid_only, a);
  st_b("burst", s.burst, a); st_i("plus", s.plus, a); st_i("targets", s.targets, a); st_i("target_growth", s.target_growth, a);
  st_b("targets_optional", s.targets_optional, a); st_b("others", s.others, a); st_b("sight", s.sight, a); st_b("srd", s.srd, a);
  st_i("page", s.page, a); st_s("text", s.text, a); st_i("at_will", s.at_will, a); st_b("willing", s.willing, a); st_i("option", s.option, a);
  st_put(", lasts_from = [3] int.[", a);
  for k: 0..<3 { if k > 0 { st_put(", ", a); } st_int(s.lasts_from[k], a); }
  st_put("]", a);
  st_i("cast_s", s.cast_s, a); st_b("shield_stops", s.shield_stops, a); st_b("ignites", s.ignites, a);
  st_put("}", a);
}
st_emit :: (a: [] StArena) -> bool {
  st_put("// Generated by spell-table-build.coax from rs_spell_record (spells.coax, more.coax, house.coax). Do not edit:\n", a);
  st_put("// change a record there, then regenerate (the header of spell-table-build.coax says how).\n", a);
  st_put("// This work includes material from the System Reference Document 5.2.1 (\"SRD 5.2.1\") by Wizards\n", a);
  st_put("// of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the\n", a);
  st_put("// Creative Commons Attribution 4.0 International License, available at\n", a);
  st_put("// https://creativecommons.org/licenses/by/4.0/legalcode.\n", a);
  st_put("// Every number below RS_HOUSE_END, in order (one with no record is as rs_spell_record answers for it).\n", a);
  st_put("RS_SPELL_TABLE :: [RS_HOUSE_END] RsSpell.[\n", a);
  for i: 0..<RS_HOUSE_END {
    st_put("  ", a); st_record(rs_spell_record(i), a); st_put(ifx i + 1 < RS_HOUSE_END then ",\n" else "\n", a);
  }
  st_put("];\n// A number below 0, and one at RS_HOUSE_END or past it.\nRS_SPELL_NONE :: ", a);
  st_record(rs_spell_record(-1), a);
  st_put(";\nRS_SPELL_PAST :: ", a);
  st_record(rs_spell_record(RS_HOUSE_END), a);
  st_put(";\n", a);
  return !a[0].error;
}
tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) || args[0].n != 2 { tool_errln("usage: spell-table-build (--out NEW_FILE | --check FILE)"); return 2; }
  mode := args_at(args[..], 0); path := args_at(args[..], 1);
  if mode != "--out" && mode != "--check" { tool_errln("usage: spell-table-build (--out NEW_FILE | --check FILE)"); return 2; }
  a: [1] StArena; if !st_emit(a[..]) { tool_errln("spell table larger than the arena"); return 1; }
  expected := cast(string) a[0].bytes[0..<a[0].n];
  if mode == "--check" {
    buf: [1048576] u8; n := fs_read(path, buf[..]);
    if n < 0 || cast(string) buf[0..<n] != expected { tool_errln("stale or missing spell table: regenerate it with --out"); return 1; }
    tool_errln("spell table matches the records"); return 0;
  }
  if fs_kind(path) != FS_NONE { tool_errln("refused: output already exists"); return 1; }
  return ifx fs_write(path, expected) then 0 else 1;
}
