  RsSpell.{id = "produce-flame", name = "Produce Flame", level = 0, school = "Conjuration", classes = "Druid", cast_time = 1, range_ft = 0, components = "V, S", duration = "10 minutes", duration_s = 600, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 10, a = 20, b = 20, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 156, text = "A flickering flame appears in your hand and remains there for the duration. While there, the flame emits no heat and ignites nothing, and it sheds Bright Light in a 20-foot radius and Dim Light for an additional 20 feet. The spell ends if you cast it again. Until the spell ends, you can take a Magic action to hurl fire at a creature or an object within 60 feet of you. Make a ranged spell attack. On a hit, the target takes 1d8 Fire damage. Cantrip Upgrade. The damage increases by 1d8 when you reach levels 5 (2d8), 11 (3d8), and 17 (4d8).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
