  RsSpell.{id = "blight", name = "Blight", level = 4, school = "Necromancy", classes = "Druid, Sorcerer, Warlock, Wizard", cast_time = 0, range_ft = 30, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 2, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 8, b = 8, c = 7, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 113, text = "A creature that you can see within range makes a Constitution saving throw, taking 8d8 Necrotic damage on a failed save or half as much damage on a successful one. A Plant creature automatically fails the save. Alternatively, target a nonmagical plant that isn't a creature, such as a tree or shrub. It doesn't make a save; it simply withers and dies. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 4.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "circle-of-death", name = "Circle of Death", level = 6, school = "Necromancy", classes = "Sorcerer, Warlock, Wizard", cast_time = 0, range_ft = 150, components = "V, S, M (the powder of a crushed black pearl worth 500+ GP)", duration = "Instantaneous", duration_s = 0, concentration = false, area = 4, area_ft = 60, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 2, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 8, b = 8, c = 7, d = 2}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 115, text = "Negative energy ripples out in a 60-foot-radius Sphere from a point you choose within range. Each creature in that area makes a Constitution saving throw, taking 8d8 Necrotic damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 2d8 for each spell slot level above 6.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "finger-of-death", name = "Finger of Death", level = 7, school = "Necromancy", classes = "Sorcerer, Warlock, Wizard", cast_time = 0, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 2, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 7, b = 8, c = 7, d = 0}, RsStep.{kind = 25, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 30, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 131, text = "You unleash negative energy toward a creature you can see within range. The target makes a Constitution saving throw, taking 7d8 + 30 Necrotic damage on a failed save or half as much damage on a successful one. A Humanoid killed by this spell rises at the start of your next turn as a Zombie (see \"Monsters\") that follows your verbal orders.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "dimension-door", name = "Dimension Door", level = 4, school = "Conjuration", classes = "Bard, Sorcerer, Warlock, Wizard", cast_time = 0, range_ft = 500, components = "V", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 26, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 123, text = "You teleport to a location within range. You arrive at exactly the spot desired. It can be a place you can see, one you can visualize, or one you can describe by stating distance and direction, such as \"200 feet straight downward\" or \"300 feet upward to the northwest at a 45-degree angle.\" You can also teleport one willing creature. The creature must be within 5 feet of you when you teleport, and it teleports to a space within 5 feet of your destination space. If you, the other creature, or both would arrive in a space occupied by a creature or completely filled by one or more objects, you and any creature traveling with you each take 4d6 Force damage, and the teleportation fails.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "hellish-rebuke", name = "Hellish Rebuke", level = 1, school = "Evocation", classes = "Warlock", cast_time = 2, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 2, b = 10, c = 4, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 140, text = "The creature that damaged you is momentarily surrounded by green flames. It makes a Dexterity saving throw, taking 2d10 Fire damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 1d10 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "burning-hands", name = "Burning Hands", level = 1, school = "Evocation", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 0, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 1, area_ft = 15, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 3, b = 6, c = 4, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 0, text = "A thin sheet of flames shoots forth from you. Each creature in a 15-foot Cone makes a Dexterity saving throw, taking 3d6 Fire damage on a failed save or half as much damage on a successful one. Flammable objects in the Cone that aren't being worn or carried start burning. Using a Higher-Level Spell Slot. The damage increases by 1d6 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "lightning-bolt", name = "Lightning Bolt", level = 3, school = "Evocation", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 0, components = "V, S, M (a bit of fur and a crystal rod)", duration = "Instantaneous", duration_s = 0, concentration = false, area = 5, area_ft = 100, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 8, b = 6, c = 6, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 0, text = "A stroke of lightning forming a 100-foot-long, 5-foot-wide Line blasts out from you in a direction you choose. Each creature in the Line makes a Dexterity saving throw, taking 8d6 Lightning damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 1d6 for each spell slot level above 3.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "bless", name = "Bless", level = 1, school = "Enchantment", classes = "Cleric, Paladin", cast_time = 0, range_ft = 30, components = "V, S, M (a Holy Symbol worth 5+ GP)", duration = "Concentration, up to 1 minute", duration_s = 60, concentration = true, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 27, a = 11, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 3, target_growth = 1, targets_optional = true, others = false, sight = false, srd = true, page = 0, text = "You bless up to three creatures within range. Whenever a target makes an attack roll or a saving throw before the spell ends, the target adds 1d4 to the attack roll or save. Using a Higher-Level Spell Slot. You can target one additional creature for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "bane", name = "Bane", level = 1, school = "Enchantment", classes = "Bard, Cleric, Warlock", cast_time = 0, range_ft = 30, components = "V, S, M (a drop of blood)", duration = "Concentration, up to 1 minute", duration_s = 60, concentration = true, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 5, b = 0, c = 0, d = 0}, RsStep.{kind = 27, a = 12, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 3, target_growth = 1, targets_optional = true, others = false, sight = false, srd = true, page = 0, text = "Up to three creatures of your choice that you can see within range must each make a Charisma saving throw. Whenever a target that fails this save makes an attack roll or a saving throw before the spell ends, the target must subtract 1d4 from the attack roll or save. Using a Higher-Level Spell Slot. You can target one additional creature for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "shield-of-faith", name = "Shield of Faith", level = 1, school = "Abjuration", classes = "Cleric, Paladin", cast_time = 1, range_ft = 60, components = "V, S, M (a prayer scroll)", duration = "Concentration, up to 10 minutes", duration_s = 600, concentration = true, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 27, a = 13, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 0, text = "A shimmering field surrounds a creature of your choice within range, granting it a +2 bonus to Armor Class for the duration.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "command", name = "Command", level = 1, school = "Enchantment", classes = "Bard, Cleric, Paladin", cast_time = 0, range_ft = 60, components = "V", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 4, b = 0, c = 0, d = 0}, RsStep.{kind = 29, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 1, target_growth = 1, targets_optional = false, others = false, sight = false, srd = true, page = 0, text = "You speak a one-word command to a creature you can see within range. The target must succeed on a Wisdom saving throw or follow the command on its next turn. Choose the command from these options: Approach. The target moves toward you by the shortest and most direct route, ending its turn if it moves within 5 feet of you. Drop. The target drops whatever it is holding and then ends its turn. Flee. The target spends its turn moving away from you by the fastest available means. Grovel. The target has the Prone condition and then ends its turn. Halt. On its turn, the target doesn't move and takes no action or Bonus Action. Using a Higher-Level Spell Slot. You can affect one additional creature for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "inflict-wounds", name = "Inflict Wounds", level = 1, school = "Necromancy", classes = "Cleric", cast_time = 0, range_ft = 5, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 2, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 2, b = 10, c = 7, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 143, text = "A creature you touch makes a Constitution saving throw, taking 2d10 Necrotic damage on a failed save or half as much damage on a successful one. Using a Higher-Level Spell Slot. The damage increases by 1d10 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "acid-splash", name = "Acid Splash", level = 0, school = "Evocation", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 4, area_ft = 5, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 6, c = 1, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 107, text = "You create an acidic bubble at a point within range, where it explodes in a 5-foot-radius Sphere. Each creature in that Sphere must succeed on a Dexterity saving throw or take 1d6 Acid damage. Cantrip Upgrade. The damage increases by 1d6 when you reach levels 5 (2d6), 11 (3d6), and 17 (4d6).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "magic-missile", name = "Magic Missile", level = 1, school = "Evocation", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 120, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 16, a = 3, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 4, c = 5, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 1, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 146, text = "You create three glowing darts of magical force. Each dart strikes a creature of your choice that you can see within range. A dart deals 1d4 + 1 Force damage to its target. The darts all strike simultaneously, and you can direct them to hit one creature or several. Using a Higher-Level Spell Slot. The spell creates one more dart for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = true, ignites = false},
  RsSpell.{id = "mass-healing-word", name = "Mass Healing Word", level = 3, school = "Abjuration", classes = "Bard, Cleric", cast_time = 1, range_ft = 60, components = "V", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 4, a = 2, b = 4, c = 1, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 6, target_growth = 0, targets_optional = true, others = false, sight = false, srd = true, page = 148, text = "Up to six creatures of your choice that you can see within range regain Hit Points equal to 2d4 plus your spellcasting ability modifier. Using a Higher-Level Spell Slot. The healing increases by 1d4 for each spell slot level above 3.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
