  RsSpell.{id = "divine-smite", name = "Divine Smite", level = 1, school = "Evocation", classes = "Paladin", cast_time = 1, range_ft = 0, components = "V", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 20, a = 1, b = 8, c = 0, d = 0}, RsStep.{kind = 3, a = 2, b = 8, c = 11, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 125, text = "The target takes an extra 2d8 Radiant damage from the attack. The damage increases by 1d8 if the target is a Fiend or an Undead. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "hunters-mark", name = "Hunter's Mark", level = 1, school = "Divination", classes = "Ranger", cast_time = 1, range_ft = 90, components = "V", duration = "Concentration, up to 1 hour", duration_s = 3600, concentration = true, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 21, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 141, text = "You magically mark one creature you can see within range as your quarry. Until the spell ends, you deal an extra 1d6 Force damage to the target whenever you hit it with an attack roll. You also have Advantage on any Wisdom (Perception or Survival) check you make to find it. If the target drops to 0 Hit Points before this spell ends, you can take a Bonus Action to move the mark to a new creature you can see within range. Using a Higher-Level Spell Slot. Your Concentration can last longer with a spell slot of level 3–4 (up to 8 hours) or 5+ (up to 24 hours).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "fire-bolt", name = "Fire Bolt", level = 0, school = "Evocation", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 120, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 1, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 10, c = 4, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 132, text = "You hurl a mote of fire at a creature or an object within range. Make a ranged spell attack against the target. On a hit, the target takes 1d10 Fire damage. A flammable object hit by this spell starts burning if it isn't being worn or carried. Cantrip Upgrade. The damage increases by 1d10 when you reach levels 5 (2d10), 11 (3d10), and 17 (4d10).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = true},
  RsSpell.{id = "shield", name = "Shield", level = 1, school = "Abjuration", classes = "Sorcerer, Wizard", cast_time = 2, range_ft = 0, components = "V, S", duration = "1 round", duration_s = 6, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 22, a = 5, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 161, text = "An imperceptible barrier of magical force protects you. Until the start of your next turn, you have a +5 bonus to AC, including against the triggering attack, and you take no damage from Magic Missile.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "fireball", name = "Fireball", level = 3, school = "Evocation", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 150, components = "V, S, M (a ball of bat guano and sulfur)", duration = "Instantaneous", duration_s = 0, concentration = false, area = 4, area_ft = 20, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 8, b = 6, c = 4, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 131, text = "A bright streak flashes from you to a point you choose within range and then blossoms with a low roar into a fiery explosion. Each creature in a 20-foot-radius Sphere centered on that point makes a Dexterity saving throw, taking 8d6 Fire damage on a failed save or half as much damage on a successful one. Flammable objects in the area that aren't being worn or carried start burning. Using a Higher-Level Spell Slot. The damage increases by 1d6 for each spell slot level above 3.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "spirit-guardians", name = "Spirit Guardians", level = 3, school = "Conjuration", classes = "Cleric", cast_time = 0, range_ft = 0, components = "V, S, M (a prayer scroll)", duration = "Concentration, up to 10 minutes", duration_s = 600, concentration = true, area = 0, area_ft = 15, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 24, a = 3, b = 8, c = 4, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 164, text = "Protective spirits flit around you in a 15-foot Emanation for the duration. If you are good or neutral, their spectral form appears angelic or fey (your choice). If you are evil, they appear fiendish. When you cast this spell, you can designate creatures to be unaffected by it. Any other creature's Speed is halved in the Emanation, and whenever the Emanation enters a creature's space and whenever a creature enters the Emanation or ends its turn there, the creature must make a Wisdom saving throw. On a failed save, the creature takes 3d8 Radiant damage (if you are good or neutral) or 3d8 Necrotic damage (if you are evil). On a successful save, the creature takes half as much damage. A creature makes this save only once per turn. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 3.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "call-lightning", name = "Call Lightning", level = 3, school = "Conjuration", classes = "Druid", cast_time = 0, range_ft = 120, components = "V, S", duration = "Concentration, up to 10 minutes", duration_s = 600, concentration = true, area = 4, area_ft = 5, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 3, b = 10, c = 6, d = 1}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = true, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 114, text = "A storm cloud appears at a point within range that you can see above yourself. It takes the shape of a Cylinder that is 10 feet tall with a 60-foot radius. When you cast the spell, choose a point you can see under the cloud. A lightning bolt shoots from the cloud to that point. Each creature within 5 feet of that point makes a Dexterity saving throw, taking 3d10 Lightning damage on a failed save or half as much damage on a successful one. Until the spell ends, you can take a Magic action to call down lightning in that way again, targeting the same point or a different one. If you're outdoors in a storm when you cast this spell, the spell gives you control over that storm instead of creating a new one. Under such conditions, the spell's damage increases by 1d10. Using a Higher-Level Spell Slot. The damage increases by 1d10 for each spell slot level above 3.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "call-lightning-bolt", name = "Call Lightning", level = 0, school = "Conjuration", classes = "Druid", cast_time = 0, range_ft = 120, components = "V, S", duration = "Concentration, up to 10 minutes", duration_s = 0, concentration = false, area = 4, area_ft = 5, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 3, b = 10, c = 6, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = 27, ritual = false, humanoid_only = false, burst = true, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 114, text = "A storm cloud appears at a point within range that you can see above yourself. It takes the shape of a Cylinder that is 10 feet tall with a 60-foot radius. When you cast the spell, choose a point you can see under the cloud. A lightning bolt shoots from the cloud to that point. Each creature within 5 feet of that point makes a Dexterity saving throw, taking 3d10 Lightning damage on a failed save or half as much damage on a successful one. Until the spell ends, you can take a Magic action to call down lightning in that way again, targeting the same point or a different one. If you're outdoors in a storm when you cast this spell, the spell gives you control over that storm instead of creating a new one. Under such conditions, the spell's damage increases by 1d10. Using a Higher-Level Spell Slot. The damage increases by 1d10 for each spell slot level above 3.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
