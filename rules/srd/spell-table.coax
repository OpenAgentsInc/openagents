  RsSpell.{id = "starry-wisp", name = "Starry Wisp", level = 0, school = "Evocation", classes = "Bard, Druid", cast_time = 0, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 1, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 8, c = 11, d = 0}, RsStep.{kind = 9, a = 10, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 165, text = "You launch a mote of light at one creature or object within range. Make a ranged spell attack against the target. On a hit, the target takes 1d8 Radiant damage, and until the end of your next turn, it emits Dim Light in a 10-foot radius and can't benefit from the Invisible condition. Cantrip Upgrade. The damage increases by 1d8 when you reach levels 5 (2d8), 11 (3d8), and 17 (4d8).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "poison-spray", name = "Poison Spray", level = 0, school = "Necromancy", classes = "Druid, Sorcerer, Warlock, Wizard", cast_time = 0, range_ft = 30, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 1, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 12, c = 9, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 154, text = "You spray toxic mist at a creature within range. Make a ranged spell attack against the target. On a hit, the target takes 1d12 Poison damage. Cantrip Upgrade. The damage increases by 1d12 when you reach levels 5 (2d12), 11 (3d12), and 17 (4d12).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "cure-wounds", name = "Cure Wounds", level = 1, school = "Abjuration", classes = "Bard, Cleric, Druid, Paladin, Ranger", cast_time = 0, range_ft = 5, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 4, a = 2, b = 8, c = 1, d = 2}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 122, text = "A creature you touch regains a number of Hit Points equal to 2d8 plus your spellcasting ability modifier. Using a Higher-Level Spell Slot. The healing increases by 2d8 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "healing-word", name = "Healing Word", level = 1, school = "Abjuration", classes = "Bard, Cleric, Druid", cast_time = 1, range_ft = 60, components = "V", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 4, a = 2, b = 4, c = 1, d = 2}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 139, text = "A creature of your choice that you can see within range regains Hit Points equal to 2d4 plus your spellcasting ability modifier. Using a Higher-Level Spell Slot. The healing increases by 2d4 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "thunderwave", name = "Thunderwave", level = 1, school = "Evocation", classes = "Bard, Druid, Sorcerer, Wizard", cast_time = 0, range_ft = 0, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 1, area_ft = 15, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 2, b = 1, c = 0, d = 0}, RsStep.{kind = 3, a = 2, b = 8, c = 13, d = 1}, RsStep.{kind = 6, a = 10, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 169, text = "You unleash a wave of thunderous energy. Each creature in a 15-foot Cube originating from you makes a Constitution saving throw. On a failed save, a creature takes 2d8 Thunder damage and is pushed 10 feet away from you. On a successful save, a creature takes half as much damage only. In addition, unsecured objects that are entirely within the Cube are pushed 10 feet away from you, and a thunderous boom is audible within 300 feet. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "entangle", name = "Entangle", level = 1, school = "Conjuration", classes = "Druid, Ranger", cast_time = 0, range_ft = 90, components = "V, S", duration = "Concentration, up to 1 minute", duration_s = 60, concentration = true, area = 2, area_ft = 20, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 7, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 2, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 5, a = 4096, b = 0, c = 0, d = 0}, RsStep.{kind = 11, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 4, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = true, sight = false, srd = true, page = 128, text = "Grasping plants sprout from the ground in a 20-foot square within range. For the duration, these plants turn the ground in the area into Difficult Terrain. They disappear when the spell ends. Each creature (other than you) in the area when you cast the spell must succeed on a Strength saving throw or have the Restrained condition until the spell ends. A Restrained creature can take an action to make a Strength (Athletics) check against your spell save DC. On a success, it frees itself from the grasping plants and is no longer Restrained by them.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "faerie-fire", name = "Faerie Fire", level = 1, school = "Evocation", classes = "Bard, Druid", cast_time = 0, range_ft = 60, components = "V", duration = "Concentration, up to 1 minute", duration_s = 60, concentration = true, area = 3, area_ft = 20, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 0, c = 0, d = 0}, RsStep.{kind = 8, a = 10, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 130, text = "Objects in a 20-foot Cube within range are outlined in blue, green, or violet light (your choice). Each creature in the Cube is also outlined if it fails a Dexterity saving throw. For the duration, objects and affected creatures shed Dim Light in a 10-foot radius and can't benefit from the Invisible condition. Attack rolls against an affected creature or object have Advantage if the attacker can see it.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "chill-touch", name = "Chill Touch", level = 0, school = "Necromancy", classes = "Sorcerer, Warlock, Wizard", cast_time = 0, range_ft = 5, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 1, a = 1, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 10, c = 7, d = 0}, RsStep.{kind = 13, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 115, text = "Channeling the chill of the grave, make a melee spell attack against a target within reach. On a hit, the target takes 1d10 Necrotic damage, and it can't regain Hit Points until the end of your next turn. Cantrip Upgrade. The damage increases by 1d10 when you reach levels 5 (2d10), 11 (3d10), and 17 (4d10).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "ray-of-sickness", name = "Ray of Sickness", level = 1, school = "Necromancy", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 1, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 2, b = 8, c = 9, d = 1}, RsStep.{kind = 14, a = 1024, b = 1, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 158, text = "You shoot a greenish ray at a creature within range. Make a ranged spell attack against the target. On a hit, the target takes 2d8 Poison damage and has the Poisoned condition until the end of your next turn. Using a Higher-Level Spell Slot. The damage increases by 1d8 for each spell slot level above 1.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "false-life", name = "False Life", level = 1, school = "Necromancy", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 0, components = "V, S, M (a drop of alcohol)", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 12, a = 2, b = 4, c = 4, d = 5}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 129, text = "You gain 2d4 + 4 Temporary Hit Points. Using a Higher-Level Spell Slot. You gain 5 additional Temporary Hit Points for each spell slot level above 1.", at_will = 71, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "ray-of-enfeeblement", name = "Ray of Enfeeblement", level = 2, school = "Necromancy", classes = "Warlock, Wizard", cast_time = 0, range_ft = 60, components = "V, S", duration = "Concentration, up to 1 minute", duration_s = 60, concentration = true, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 2, b = 0, c = 0, d = 0}, RsStep.{kind = 15, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 158, text = "A beam of enervating energy shoots from you toward a creature within range. The target must make a Constitution saving throw. On a successful save, the target has Disadvantage on the next attack roll it makes until the start of your next turn. On a failed save, the target has Disadvantage on Strength-based D20 Tests for the duration. During that time, it also subtracts 1d8 from all its damage rolls. The target repeats the save at the end of each of its turns, ending the spell on a success.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "blindness-deafness", name = "Blindness/Deafness", level = 2, school = "Transmutation", classes = "Bard, Cleric, Sorcerer, Wizard", cast_time = 0, range_ft = 120, components = "V", duration = "1 minute", duration_s = 60, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 2, b = 0, c = 0, d = 0}, RsStep.{kind = 14, a = 1, b = 2, c = 2, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 1, target_growth = 1, targets_optional = false, others = false, sight = false, srd = true, page = 113, text = "One creature that you can see within range must succeed on a Constitution saving throw, or it has the Blinded or Deafened condition (your choice) for the duration. At the end of each of its turns, the target repeats the save, ending the spell on itself on a success. Using a Higher-Level Spell Slot. You can target one additional creature for each spell slot level above 2.", at_will = 0, willing = false, option = 1, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "eldritch-blast", name = "Eldritch Blast", level = 0, school = "Evocation", classes = "Warlock", cast_time = 0, range_ft = 120, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 16, a = 1, b = 0, c = 1, d = 0}, RsStep.{kind = 1, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 10, c = 5, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 127, text = "You hurl a beam of crackling energy. Make a ranged spell attack against one creature or object in range. On a hit, the target takes 1d10 Force damage. Cantrip Upgrade. The spell creates two beams at level 5, three beams at level 11, and four beams at level 17. You can direct the beams at the same target or at different ones. Make a separate attack roll for each beam.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "hex", name = "Hex", level = 1, school = "Enchantment", classes = "Warlock", cast_time = 1, range_ft = 90, components = "V, S, M (the petrified eye of a newt)", duration = "Concentration, up to 1 hour", duration_s = 3600, concentration = true, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 17, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 1, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 140, text = "You place a curse on a creature that you can see within range. Until the spell ends, you deal an extra 1d6 Necrotic damage to the target whenever you hit it with an attack roll. Also, choose one ability when you cast the spell. The target has Disadvantage on ability checks made with the chosen ability. If the target drops to 0 Hit Points before this spell ends, you can take a Bonus Action on a later turn to curse a new creature. Using a Higher-Level Spell Slot. Your Concentration can last longer with a spell slot of level 2 (up to 4 hours), 3–4 (up to 8 hours), or 5+ (24 hours).", at_will = 0, willing = false, option = 2, lasts_from = [3] int.[2, 3, 5], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "hold-person", name = "Hold Person", level = 2, school = "Enchantment", classes = "Bard, Cleric, Druid, Sorcerer, Warlock, Wizard", cast_time = 0, range_ft = 60, components = "V, S, M (a straight piece of iron)", duration = "Concentration, up to 1 minute", duration_s = 60, concentration = true, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 4, b = 0, c = 0, d = 0}, RsStep.{kind = 14, a = 256, b = 2, c = 4, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = true, burst = false, plus = 0, targets = 1, target_growth = 1, targets_optional = false, others = false, sight = false, srd = true, page = 141, text = "Choose a Humanoid that you can see within range. The target must succeed on a Wisdom saving throw or have the Paralyzed condition for the duration. At the end of each of its turns, the target repeats the save, ending the spell on itself on a success. Using a Higher-Level Spell Slot. You can target one additional Humanoid for each spell slot level above 2.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "scorching-ray", name = "Scorching Ray", level = 2, school = "Evocation", classes = "Sorcerer, Wizard", cast_time = 0, range_ft = 120, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 16, a = 3, b = 1, c = 0, d = 0}, RsStep.{kind = 1, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 2, b = 6, c = 4, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 159, text = "You hurl three fiery rays. You can hurl them at one target within range or at several. Make a ranged spell attack for each ray. On a hit, the target takes 2d6 Fire damage. Using a Higher-Level Spell Slot. You create one additional ray for each spell slot level above 2.", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "vicious-mockery", name = "Vicious Mockery", level = 0, school = "Enchantment", classes = "Bard", cast_time = 0, range_ft = 60, components = "V", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 4, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 6, c = 10, d = 0}, RsStep.{kind = 19, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 3, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 171, text = "You unleash a string of insults laced with subtle enchantments at one creature you can see or hear within range. The target must succeed on a Wisdom saving throw or take 1d6 Psychic damage and have Disadvantage on the next attack roll it makes before the end of its next turn. Cantrip Upgrade. The damage increases by 1d6 when you reach levels 5 (2d6), 11 (3d6), and 17 (4d6).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
  RsSpell.{id = "sacred-flame", name = "Sacred Flame", level = 0, school = "Evocation", classes = "Cleric", cast_time = 0, range_ft = 60, components = "V, S", duration = "Instantaneous", duration_s = 0, concentration = false, area = 0, area_ft = 0, wide_ft = 0, turn_save = false, steps = [RS_STEPS] RsStep.[RsStep.{kind = 2, a = 1, b = 0, c = 0, d = 0}, RsStep.{kind = 3, a = 1, b = 8, c = 11, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}, RsStep.{kind = 0, a = 0, b = 0, c = 0, d = 0}], step_n = 2, part_of = -1, ritual = false, humanoid_only = false, burst = false, plus = 0, targets = 0, target_growth = 0, targets_optional = false, others = false, sight = false, srd = true, page = 159, text = "Flame-like radiance descends on a creature that you can see within range. The target must succeed on a Dexterity saving throw or take 1d8 Radiant damage. The target gains no benefit from Half Cover or Three-Quarters Cover for this save. Cantrip Upgrade. The damage increases by 1d8 when you reach levels 5 (2d8), 11 (3d8), and 17 (4d8).", at_will = 0, willing = false, option = 0, lasts_from = [3] int.[0, 0, 0], cast_s = 0, shield_stops = false, ignites = false},
