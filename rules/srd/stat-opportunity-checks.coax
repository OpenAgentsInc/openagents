#load "battle.coax";
#load "stat-attack-checks.coax";

#test "typed opportunity uses its printed extended reach and damage without an Action" {
  b:[1]RsBattle; sa_field(b[..]); rs_place(b[..],1,3,1); rs_start_turn(b[..],1);
  b[0].turn.action=true; b[0].turn.bonus=true; b[0].turn.move_left=4;
  a:=sa_record(); a.reach=10; b[0].c[0].score[RS_STR]=6;
  q:=RsOpportunityMove.{x=4,y=1,seen=true,movement=true,reach=1000,melee=false};
  r:=rs_stat_opportunity(b[..],0,1,a,q);
  #assert r.admitted && r.hit && b[0].c[1].hp==91 && b[0].c[0].reacted;
  #assert rs_saw(b[..],0,"Sting") && r.strike.struck;
  #assert b[0].who==1 && b[0].turn.action && b[0].turn.bonus && b[0].turn.move_left==4 && b[0].c[1].x==3;
  #assert !rs_stat_opportunity(b[..],0,1,a,q).admitted;
}
#test "typed opportunity miss spends Reaction while malformed metadata and non-monsters refuse" {
  for mode:0..<4 {
    b:[1]RsBattle; sa_field(b[..]); rs_start_turn(b[..],1); b[0].c[1].ac=30;
    a:=sa_record(); if mode==1 { a.reach=-1; } if mode==2 { b[0].c[0].klass=RS_FIGHTER; } if mode==3 { a.id=""; }
    rolls:=b[0].dice[0].rolled; q:=RsOpportunityMove.{x=3,y=1,seen=true,movement=true};
    r:=rs_stat_opportunity(b[..],0,1,a,q);
    #assert r.admitted==(mode==0) && !r.hit && b[0].c[0].reacted==(mode==0) && b[0].c[1].hp==100;
    #assert b[0].dice[0].rolled==rolls+(ifx mode==0 then 1 else 0) && b[0].who==1 && !b[0].reaction_frame.on;
  }
}

#test "typed opportunity Charmed ownership is distinct from unrelated conditions" {
  for mode:0..<4 {
    b:[1]RsBattle; sa_field(b[..]); rs_start_turn(b[..],1);
    b[0].c[0].eff[0]=RsEffect.{kind=EF_COND,cond=ifx mode<2 then RS_CHARMED else RS_BLINDED,by=ifx mode==1 then 0 else 1,spell=-1,until=60,save=-1};
    if mode==3 { b[0].c[0].eff[0].kind=EF_NONE; }
    r:=rs_stat_opportunity(b[..],0,1,sa_record(),RsOpportunityMove.{x=3,y=1,seen=true,movement=true});
    #assert r.admitted==(mode!=0) && b[0].c[0].reacted==(mode!=0);
  }
}
#test "typed opportunity retains shared critical follow-up without giving the mover that movement" #steps 40000000 {
  critical:=false;
  for seed:1..<65 {
    b:[1]RsBattle; sa_field(b[..]); rs_start_turn(b[..],1); b[0].dice[0].fixed=false; b[0].dice[0].state=cast(u64)seed*7919;
    // Explicit trait-composition fixture, not a new monster catalog record.
    b[0].c[0].feats = rs_feature_put(b[0].c[0].feats, RS_FT_ATHLETE, true); b[0].turn.move_left=4;
    r:=rs_stat_opportunity(b[..],0,1,sa_record(),RsOpportunityMove.{x=3,y=1,seen=true,movement=true});
    #assert r.admitted && r.strike.struck && b[0].turn.move_left==4;
    if r.strike.move_left>0 { critical=true; #assert r.strike.move_left==3; }
  }
  #assert critical;
}
#test "typed opportunity refuses nesting and invalid actor spans without losing the original frame" {
  b:[1]RsBattle; sa_field(b[..]); rs_start_turn(b[..],1);
  q:=RsOpportunityMove.{x=3,y=1,seen=true,movement=true};
  #assert !rs_stat_opportunity(b[..],-1,1,sa_record(),q).admitted;
  #assert !rs_stat_opportunity(b[..],0,b[0].n,sa_record(),q).admitted;
  #assert rs_reaction_frame_begin(b[..],0);
  #assert !rs_stat_opportunity(b[..],0,1,sa_record(),q).admitted && b[0].reaction_frame.on && b[0].who==0 && !b[0].c[0].reacted;
  rs_reaction_frame_end(b[..]); #assert b[0].who==1;
}
