// One declared melee stat-block attack as a Reaction, never a Multiattack, with its riders.
// Record provenance belongs to the source/world adapter, as for rs_stat_attack.
#authority;
rs_stat_opportunity :: (b:[]RsBattle,reactor:int,mover:int,a:RsStatAttack,q:RsOpportunityMove)->RsOpportunityResult #effects(all) {
  switch rs_stat_opportunity_atomic(b,reactor,mover,a,q) { case none { return RsOpportunityResult.{}; } case some(r) { return r; } }
}
rs_stat_opportunity_atomic :: (b:[]RsBattle,reactor:int,mover:int,a:RsStatAttack,q:RsOpportunityMove)->RsOpportunityResult? #effects(all) {
  r:RsOpportunityResult;
  #transaction {
    r=rs_stat_opportunity_apply(b,reactor,mover,a,q);
    if !r.admitted { return null; }
  }
  return some(r);
}
rs_stat_opportunity_apply :: (b:[]RsBattle,reactor:int,mover:int,a:RsStatAttack,q:RsOpportunityMove)->RsOpportunityResult #effects(all) {
  r:RsOpportunityResult;
  if !rs_stat_attack_valid(a) || a.reach<=0 || reactor<0 || reactor>=b[0].c.count { return r; }
  move:=q; move.melee=true; move.reach=a.reach+rs_space_feet(b[0].c[reactor]);
  if !rs_opportunity_trigger(b,reactor,mover,move) { return r; }
  if b[0].c[reactor].klass!=RS_MONSTER { return r; }
  for effect:b[0].c[reactor].eff {
    if effect.by==mover && (rs_effect_conditions(effect)&RS_CHARMED)!=0 { return r; }
  }
  if rs_effect_free(b[0].c[mover])<rs_stat_rider_room(b,mover,a) { return r; }
  if !rs_reaction_frame_begin(b,reactor) { return r; }
  // A natural record has no mastery or Finesse rider; its own hit rider has prepaid room.
  b[0].c[reactor].reacted=true;
  r.hit=rs_stat_strike(b,reactor,mover,a,1);
  rs_after_blow(b,reactor);
  r.admitted=true; r.strike=b[0].turn;
  rs_reaction_frame_end(b);
  return r;
}
#test "typed opportunity entry resolves one natural strike and restores the mover" {
  b:[1]RsBattle; b[0].w=8; b[0].h=8; b[0].dice[0].fixed=true;
  _:=rs_add(b[..],rs_guard("Reactor",1),2,2); _=rs_add(b[..],rs_barbarian("Mover",0,6),3,2); rs_start_turn(b[..],1);
  a:=RsStatAttack.{id="fixture",name="Claw",bonus=5,dice=1,sides=6,flat=2,kind=RS_SLASHING,ability=RS_STR,reach=5};
  r:=rs_stat_opportunity(b[..],0,1,a,RsOpportunityMove.{x=4,y=2,seen=true,movement=true});
  #assert r.admitted && r.hit && b[0].c[0].reacted && b[0].c[1].x==3 && b[0].who==1;
}
