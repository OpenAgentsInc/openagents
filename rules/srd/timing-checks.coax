// Strict SRD timing vs the explicitly declared action-combat house profile.
#load "battle.coax";

#test "strict turn grants retain every foot of current Speed" {
  b: [1] RsBattle; b[0].w = 12; b[0].h = 8;
  a := rs_add(b[..],rs_fighter("Walker",0,1),1,1);
  b[0].c[a].speed = 7;
  rs_start_turn(b[..],a);
  #assert b[0].turn.move_left == 1 && b[0].turn.move_feet == 2;
}

#test "timing selection rejects unknown and live changes atomically and reset restores strict" {
  b: [1] RsBattle;
  #assert rs_beat(b[..]) == 6 && rs_timing_recharge(b[0].timing) == 0;
  #assert rs_set_timing(b[..],RS_ACTION_TIMING);
  #assert !rs_set_timing(b[..],RsTimingProfile.{kind=2}) && b[0].timing.kind == RS_TIME_ACTION && !b[0].timing_sealed;
  a := rs_add(b[..],rs_fighter("Actor",0,1),1,1);
  rs_begin(b[..]);
  seq := b[0].book[0].seq; rolled := b[0].dice[0].rolled; due := b[0].c[a].turn_at;
  #assert !rs_set_timing(b[..],RS_STRICT_TIMING) && rs_beat(b[..]) == 1.5;
  #assert b[0].book[0].seq == seq && b[0].dice[0].rolled == rolled && b[0].c[a].turn_at == due;
  rs_reset(b[..]); #assert rs_beat(b[..]) == 6 && !b[0].timing_sealed;
  #assert rs_set_timing(b[..],RS_ACTION_TIMING);
  rs_tick(b[..],0); #assert !rs_set_timing(b[..],RS_STRICT_TIMING);
  rs_reset(b[..]); a = rs_add(b[..],rs_fighter("Actor",0,1),1,1);
  rs_start_turn(b[..],a); #assert !rs_set_timing(b[..],RS_ACTION_TIMING) && rs_beat(b[..]) == 6;
}

#test "only the declared action profile recharges spent resources on the existing cooldown" {
  for profile: 0..<2 {
    b: [1] RsBattle; #assert rs_set_timing(b[..],RsTimingProfile.{kind=profile});
    a := rs_add(b[..],rs_cleric("Actor",0,1),1,1);
    b[0].c[a].slots[1] = 0; b[0].c[a].slots_max[1] = 3;
    b[0].c[a].rages = 0; b[0].c[a].rages_max = 2;
    b[0].c[a].focus = 0; b[0].c[a].focus_max = 2;
    rs_tick(b[..],1); rs_tick(b[..],4.5);
    #assert b[0].c[a].focus == profile && b[0].c[a].slots[1] == 0 && b[0].c[a].rages == 0;
    rs_tick(b[..],4.5);
    #assert b[0].c[a].slots[1] == profile && b[0].c[a].rages == profile;
  }
}

#test "short action turns renew reactions but death saves and repeat saves remain six-second events" {
  for profile: 0..<2 {
    b: [1] RsBattle; #assert rs_set_timing(b[..],RsTimingProfile.{kind=profile});
    a := rs_add(b[..],rs_fighter("Actor",0,1),1,1);
    rs_begin(b[..]); b[0].dice[0].fixed = true;
    baseline := b[0].dice[0].rolled;
    b[0].c[a].hp = 0; b[0].c[a].cond = RS_UNCONSCIOUS|RS_PRONE;
    for beat: 0..<(ifx profile==0 then 2 else 5) {
      rs_tick(b[..],b[0].c[a].turn_at-b[0].clock);
      b[0].c[a].reacted = true; rs_start_turn(b[..],a);
      #assert !b[0].c[a].reacted;
      #assert b[0].dice[0].rolled == baseline + (ifx profile==0 then beat+1 else 1+beat/4);
      rs_end_turn(b[..],a);
    }
    // A living creature repeating a failed save at end of turn follows the
    // same round boundary, independent of the Reaction refresh above.
    rs_reset(b[..]); #assert rs_set_timing(b[..],RsTimingProfile.{kind=profile});
    a = rs_add(b[..],rs_fighter("Actor",0,1),1,1); rs_begin(b[..]);
    b[0].dice[0].fixed = true;
    baseline = b[0].dice[0].rolled;
    #assert rs_effect_add(b[0].c[a..<a+1],RsEffect.{kind=EF_COND,cond=RS_BLINDED,by=-1,spell=-1,save=RS_WIS,dc=100,until=100});
    for beat: 0..<(ifx profile==0 then 2 else 5) {
      rs_tick(b[..],b[0].c[a].turn_at-b[0].clock); rs_start_turn(b[..],a); rs_end_turn(b[..],a);
      #assert b[0].dice[0].rolled == baseline + (ifx profile==0 then beat+1 else 1+beat/4);
    }
  }
}

#test "strict and action standing share a policy with an explicitly different movement price" {
  for profile: 0..<2 {
    b: [1] RsBattle; b[0].w=12; b[0].h=8;
    #assert rs_set_timing(b[..],RsTimingProfile.{kind=profile});
    a := rs_add(b[..],rs_fighter("Walker",0,1),1,1); b[0].c[a].cond = RS_PRONE;
    rs_start_turn(b[..],a);
    #assert b[0].turn.move_left == (ifx profile==0 then 6 else 2);
    #assert rs_stand_up(b[..],a) && !rs_has(b[0].c[a],RS_PRONE);
    #assert b[0].turn.move_left == (ifx profile==0 then 3 else 1) && !b[0].turn.action && !b[0].turn.bonus;
  }
}
