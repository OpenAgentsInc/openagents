// The actual physical walker paying a strict turn's movement (walk-budget.coax).
#load "world-timing-checks.coax";
#load "../../aethyr/walk.coax" as walk;

#test "the physical walker driven at its real run speed cannot overspend a strict turn" {
  for dash: 0..<2 {
    b: [1] RsBattle; wt_field(b[..],RS_STRICT_WORLD,30);
    if dash == 1 { #assert rs_dash(b[..],0); }
    w: walk.World; w.locomotion.walk_speed = 3.5; w.locomotion.run_speed = 7.5;
    p := walk.walk_input(walk.walk_place(0,0,0,0),0,1,0,0,true,false,0,0);
    moved: f32 = 0;
    for k: 0..<384 {   // six seconds of fixed steps
      q := walk.advance_scaled_in(w,p,f32(walk.STEP));
      to := rs_walk_take(b[..],0,p.pos.x,p.pos.z,q.pos.x,q.pos.z);
      moved += to.metres; q.pos.x = to.x; q.pos.z = to.z; p = q;
    }
    #assert wt_near(moved,f32(30 + 30*dash)*RS_FOOT_M) && abs(p.pos.z) <= f32(30 + 30*dash)*RS_FOOT_M + 0.001;
  }
}
