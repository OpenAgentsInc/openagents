// The Druid's Wild Shape (SRD 5.2.1 p. 42). As a Bonus Action and a use, it takes a Beast form it
// knows and gains Temporary Hit Points equal to its Druid level. The Beast's Strength, Dexterity,
// Constitution, Armor Class, Speed, size, traits and attacks replace its own; its Hit Points,
// Intelligence, Wisdom, Charisma, class features, saves and skills stay. It can't cast spells, though
// a spell it concentrates on goes on. The form lasts half its Druid level in hours, or until it uses
// Wild Shape again, has the Incapacitated condition or dies; it can leave early as a Bonus Action.
// Known forms (the Beast Shapes table): four of CR 1/4 or lower without a Fly Speed at level 2, six
// of CR 1/2 or lower at level 4. This preset knows the SRD's recommended Rat, Riding Horse, Spider and
// Wolf, then the Black Bear and the Warhorse (monsters.coax).
#load "wild-known.coax";
#authority;

// No spellcasting: in a Rage (p. 28) or a Wild Shape form.
rs_casting_barred :: (c: RsCreature) -> bool #effects(all) { return rs_effect(c, EF_RAGE) || c.wild_form != 0; }

// i's form ends, and its own numbers come back.
rs_wild_shape_end :: (b: [] RsBattle, i: int, why: string) #effects(all) {
  if b[0].c[i].wild_form == 0 { return; }
  k := b[0].c[i].wild_keep;
  b[0].c[i].score[RS_STR] = k.str; b[0].c[i].score[RS_DEX] = k.dex; b[0].c[i].score[RS_CON] = k.con;
  b[0].c[i].ac = k.ac; b[0].c[i].speed = k.speed; b[0].c[i].climb = k.climb; b[0].c[i].form = k.form;
  b[0].c[i].feats = rs_feature_put(b[0].c[i].feats, RS_FT_JUMPER, k.jumper);
  b[0].c[i].weapon = k.weapon; b[0].c[i].ranged = k.ranged;
  b[0].c[i].wild_form = 0; b[0].c[i].wild_until = 0;
  rs_say_ft(b, RS_EV_END, i, i, 0, RS_FT_WILD_SHAPE, why);
}
// The acting Druid i takes Beast form m with its Bonus Action and a use of Wild Shape. A form it is
// already in ends first.
rs_wild_shape :: (b: [] RsBattle, i: int, m: int) -> bool #effects(all) {
  if !rs_bonus_free(b, i) || !rs_wild_knows(b[0].c[i], m) || b[0].c[i].uses[RS_USE_WILD] <= 0 { return false; }
  rs_wild_shape_end(b, i, " leaves its form for another");
  k := rs_monster_block(m); c := b[0].c[i];
  b[0].c[i].wild_keep = RsWildKeep.{str = c.score[RS_STR], dex = c.score[RS_DEX], con = c.score[RS_CON], ac = c.ac, speed = c.speed, climb = c.climb,
                                    form = c.form, weapon = c.weapon, ranged = c.ranged, jumper = rs_has_feature(c, RS_FT_JUMPER)};
  b[0].c[i].score[RS_STR] = k.score[RS_STR]; b[0].c[i].score[RS_DEX] = k.score[RS_DEX]; b[0].c[i].score[RS_CON] = k.score[RS_CON];
  b[0].c[i].ac = k.ac; b[0].c[i].speed = k.speed; b[0].c[i].climb = k.climb;
  b[0].c[i].feats = rs_feature_put(b[0].c[i].feats, RS_FT_JUMPER, k.jumper);
  b[0].c[i].form = rs_monster(m, "", c.team).form;   // its size and traits (Pack Tactics)
  b[0].c[i].weapon = W_UNARMED; b[0].c[i].ranged = -1;
  b[0].c[i].wild_form = m; b[0].c[i].wild_until = b[0].clock + rs_secs(c.level / 2 * 3600);
  b[0].c[i].temp = rs_max(c.temp, c.level);
  b[0].turn.bonus = true; b[0].c[i].uses[RS_USE_WILD] -= 1;
  rs_say_ft(b, RS_EV_CONDITION, i, i, m, RS_FT_WILD_SHAPE, " takes a Beast's form with Wild Shape");
  return true;
}
// The acting i leaves its form early with its Bonus Action.
rs_wild_shape_leave :: (b: [] RsBattle, i: int) -> bool #effects(all) {
  if !rs_bonus_free(b, i) || b[0].c[i].wild_form == 0 { return false; }
  b[0].turn.bonus = true;
  rs_wild_shape_end(b, i, " returns to its own form");
  return true;
}
// The form ends when its hours are up, or i has the Incapacitated condition or dies (rs_tick_raw,
// rs_interrupt_incapacitated).
rs_wild_shape_lapse :: (b: [] RsBattle, i: int) #effects(all) {
  if !rs_capable(b[0].c[i]) || b[0].clock >= b[0].c[i].wild_until { rs_wild_shape_end(b, i, " leaves its Beast form"); }
}

#test "Wild Shape takes a known Beast form with the acting Druid's Bonus Action and a use" {
  for mode: 0..<9 {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; b_d := rs_add(b[..], rs_druid("Rowan", 0, 4), 1, 1); b_f := rs_add(b[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(b[..], b_d);
    m := MON_BLACK_BEAR;
    if mode == 1 { b[0].who = 1; } else if mode == 2 { b[0].turn.bonus = true; } else if mode == 3 { b[0].c[0].uses[RS_USE_WILD] = 0; }
    else if mode == 4 { b[0].c[0].klass = RS_RANGER; } else if mode == 5 { m = MON_OGRE; } else if mode == 6 { b[0].c[0].level = 3; }
    else if mode == 7 { b[0].c[0].uses[RS_USE_WILD] = 1; } else if mode == 8 { b[0].c[0].temp = 9; }
    own := b[0].c[0]; ok := mode == 0 || mode == 7 || mode == 8;
    #assert rs_wild_shape(b[..], 0, m) == ok && b[0].turn.bonus == (ok || mode == 2) && !b[0].turn.action;
    c := b[0].c[0];
    #assert c.uses[RS_USE_WILD] == (ifx ok then own.uses[RS_USE_WILD] - 1 else own.uses[RS_USE_WILD]);
    if !ok { #assert c.wild_form == 0 && c.ac == own.ac && c.temp == own.temp && c.score[RS_STR] == own.score[RS_STR]; continue; }
    // the Black Bear's numbers; its own Hit Points, mind and saves
    #assert c.wild_form == MON_BLACK_BEAR && c.ac == 11 && c.speed == 30 && c.climb == 30 && rs_size(c) == RS_MEDIUM && !rs_trait(c, RS_TRAIT_PACK);
    #assert c.score[RS_STR] == 15 && c.score[RS_DEX] == 12 && c.score[RS_CON] == 14 && c.weapon == W_UNARMED && c.ranged == -1;
    #assert c.score[RS_INT] == own.score[RS_INT] && c.score[RS_WIS] == own.score[RS_WIS] && c.score[RS_CHA] == own.score[RS_CHA] && c.hp == own.hp && c.save_prof[RS_WIS];
    #assert c.temp == (ifx mode == 8 then 9 else 4) && c.wild_until == b[0].clock + rs_secs(2 * 3600);
    k := c.wild_keep;
    #assert k.str == own.score[RS_STR] && k.dex == own.score[RS_DEX] && k.con == own.score[RS_CON] && k.ac == own.ac && k.speed == own.speed && k.climb == own.climb;
    #assert k.form == own.form && k.weapon == own.weapon && k.ranged == own.ranged;
    e := rs_recent(b[0].book[0], 0); #assert e.feat == RS_FT_WILD_SHAPE && e.kind == RS_EV_CONDITION && e.amount == MON_BLACK_BEAR && e.by.value == 0 && e.to.value == 0;
  }
}
#test "Wild Shape knows four forms at level 2 and six at 4; it is a Druid's from level 2" {
  for level: 1..<7 {
    c := rs_druid("D", 0, level);
    for k: 0..<RS_WILD_FORMS.count { #assert rs_wild_knows(c, RS_WILD_FORMS[k]) == (level >= 2 && (k < 4 || level >= 4)); }
    #assert !rs_wild_knows(c, MON_OGRE) && !rs_wild_knows(c, MON_NONE);
  }
  r := rs_druid("D", 0, 6); r.klass = RS_RANGER; #assert !rs_wild_knows(r, MON_WOLF);
  // the table: Beasts, without a Fly Speed, CR 1/4 (50 XP) or lower among the first four, CR 1/2 (100 XP) after
  for k: 0..<RS_WILD_FORMS.count { f := rs_monster_block(RS_WILD_FORMS[k]); #assert f.beast && f.xp <= (ifx k < 4 then 50 else 100); }
  #assert !rs_monster_block(MON_IMP).beast;   // the Imp's Fly Speed is a Fiend's
}
#test "Wild Shape: a Wolf has Pack Tactics, a Large horse its size; the form lasts half the Druid level in hours" {
  for level: [3] int.[2, 3, 6] {
    b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; b_d := rs_add(b[..], rs_druid("Rowan", 0, level), 1, 1); b_f := rs_add(b[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(b[..], b_d);
    #assert rs_wild_shape(b[..], 0, MON_WOLF) && rs_trait(b[0].c[0], RS_TRAIT_PACK) && rs_size(b[0].c[0]) == RS_MEDIUM && b[0].c[0].speed == 40 && b[0].c[0].climb == 0;
    #assert b[0].c[0].wild_until == b[0].clock + rs_secs(level / 2 * 3600) && b[0].c[0].temp == level;
    t := b[0].c[0].wild_until;
    b[0].clock = t - 1; rs_wild_shape_lapse(b[..], 0); #assert b[0].c[0].wild_form == MON_WOLF;
    b[0].clock = t; rs_wild_shape_lapse(b[..], 0); #assert b[0].c[0].wild_form == 0 && b[0].c[0].ac == rs_druid("D", 0, level).ac;
    e := rs_recent(b[0].book[0], 0); #assert e.feat == RS_FT_WILD_SHAPE && e.kind == RS_EV_END && e.by.value == 0 && e.to.value == 0 && e.amount == 0;
  }
  h: [1] RsBattle; h_room: [1] RsRoom; rs_have(h[..], h_room[..]); h[0].w = 12; h[0].h = 6; h[0].dice[0].fixed = true; h_d := rs_add(h[..], rs_druid("Rowan", 0, 2), 1, 1); h_f := rs_add(h[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(h[..], h_d); #assert rs_wild_shape(h[..], 0, MON_RIDING_HORSE) && rs_size(h[0].c[0]) == RS_LARGE && h[0].c[0].speed == 60;
}
#test "Wild Shape again ends the old form first; leaving early is a Bonus Action and gives its own numbers back" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; b_d := rs_add(b[..], rs_druid("Rowan", 0, 4), 1, 1); b_f := rs_add(b[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(b[..], b_d);
  b[0].c[0].weapon = W_SHORTSWORD; b[0].c[0].ranged = W_SHORTBOW; b[0].c[0].speed = 35; b[0].c[0].form = rs_form(RS_SMALL, 0); own := b[0].c[0];
  #assert rs_wild_shape(b[..], 0, MON_SPIDER) && b[0].c[0].climb == 20 && b[0].c[0].weapon == W_UNARMED && b[0].c[0].ranged == -1;
  rs_fresh(b[..], 0); #assert rs_wild_shape(b[..], 0, MON_BLACK_BEAR) && b[0].c[0].wild_form == MON_BLACK_BEAR && b[0].c[0].uses[RS_USE_WILD] == own.uses[RS_USE_WILD] - 2;
  #assert b[0].c[0].wild_keep.ac == own.ac && b[0].c[0].wild_keep.climb == own.climb && b[0].c[0].wild_keep.weapon == W_SHORTSWORD && b[0].c[0].score[RS_CON] == 14;
  rs_fresh(b[..], 0); b[0].turn.bonus = true; #assert !rs_wild_shape_leave(b[..], 0);
  rs_fresh(b[..], 0); b[0].who = 1; #assert !rs_wild_shape_leave(b[..], 0) && b[0].c[0].wild_form == MON_BLACK_BEAR;
  rs_fresh(b[..], 0); #assert rs_wild_shape_leave(b[..], 0) && b[0].turn.bonus && b[0].c[0].wild_form == 0 && b[0].c[0].wild_until == 0;
  c := b[0].c[0];
  #assert c.ac == own.ac && c.speed == own.speed && c.climb == own.climb && c.form == own.form && c.weapon == own.weapon && c.ranged == own.ranged;
  for ab: 0..<6 { #assert c.score[ab] == own.score[ab]; }
  rs_fresh(b[..], 0); #assert !rs_wild_shape_leave(b[..], 0) && !b[0].turn.bonus;   // in no form
  seq := b[0].book[0].seq; rs_wild_shape_end(b[..], 0, " x"); #assert b[0].book[0].seq == seq && b[0].c[0].ac == own.ac;
  // the sixth form needs level 4
  three: [1] RsBattle; three_room: [1] RsRoom; rs_have(three[..], three_room[..]); three[0].w = 12; three[0].h = 6; three[0].dice[0].fixed = true; three_d := rs_add(three[..], rs_druid("Rowan", 0, 3), 1, 1); three_f := rs_add(three[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(three[..], three_d); #assert !rs_wild_shape(three[..], 0, MON_WARHORSE);
}
#test "Wild Shape: no spellcasting in a form; its attacks are the Beast's; Incapacitated ends it" {
  b: [1] RsBattle; b_room: [1] RsRoom; rs_have(b[..], b_room[..]); b[0].w = 12; b[0].h = 6; b[0].dice[0].fixed = true; b_d := rs_add(b[..], rs_druid("Rowan", 0, 4), 1, 1); b_f := rs_add(b[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(b[..], b_d); b[0].c[1].hp = 100; b[0].c[1].hp_max = 100; b[0].c[1].ac = 10;
  #assert !rs_casting_barred(b[0].c[0]) && rs_can_cast_as(b[..], 0, SP_THUNDERWAVE, 1, false);
  #assert rs_wild_shape(b[..], 0, MON_BLACK_BEAR) && rs_casting_barred(b[0].c[0]) && !rs_can_cast_as(b[..], 0, SP_THUNDERWAVE, 1, false);
  #assert rs_attack(b[..], 0, 1, false, -1) && b[0].c[1].hp == 100 - 2 * (3 + 2);   // two Rends, 1d6 + 2 at 3
  rage: RsCreature; rage.eff = rs_state_put(rage.eff, EF_RAGE, true); #assert rs_casting_barred(rage);
  // a Druid out of form isn't a stat block
  s: [1] RsBattle; s_room: [1] RsRoom; rs_have(s[..], s_room[..]); s[0].w = 12; s[0].h = 6; s[0].dice[0].fixed = true; s_d := rs_add(s[..], rs_druid("Rowan", 0, 4), 1, 1); s_f := rs_add(s[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(s[..], s_d); #assert !rs_stat_multiattack(s[..], 0, 1, rs_monster_action(MON_WOLF));
  // Incapacitated, through the battle's hook
  #assert rs_put_effect(b[..], 0, RsEffect.{kind = EF_COND, cond = RS_STUNNED, by = 1, spell = -1, until = b[0].clock + rs_secs(6), save = -1});
  #assert b[0].c[0].wild_form == 0 && b[0].c[0].ac == rs_druid("D", 0, 4).ac;
  // at 0 Hit Points: the form ends, its Hit Points its own
  d: [1] RsBattle; d_room: [1] RsRoom; rs_have(d[..], d_room[..]); d[0].w = 12; d[0].h = 6; d[0].dice[0].fixed = true; d_d := rs_add(d[..], rs_druid("Rowan", 0, 2), 1, 1); d_f := rs_add(d[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(d[..], d_d); #assert rs_wild_shape(d[..], 0, MON_RAT) && d[0].c[0].ac == 10 && d[0].c[0].temp == 2;
  rs_damage(d[..], 1, 0, d[0].c[0].hp + 2, RS_FIRE, false, -1);
  #assert d[0].c[0].hp == 0 && d[0].c[0].wild_form == 0 && d[0].c[0].ac == rs_druid("D", 0, 2).ac;
  // the clock, through the tick
  t: [1] RsBattle; t_room: [1] RsRoom; rs_have(t[..], t_room[..]); t[0].w = 12; t[0].h = 6; t[0].dice[0].fixed = true; t_d := rs_add(t[..], rs_druid("Rowan", 0, 2), 1, 1); t_f := rs_add(t[..], rs_fighter("Foe", 1, 3), 2, 1); rs_fresh(t[..], t_d); #assert rs_wild_shape(t[..], 0, MON_WOLF);
  rs_tick(t[..], 3600); #assert t[0].c[0].wild_form == 0;
}
