#!/usr/bin/env bash
# Runs one command on the bench's build host (coderos-4080) against this
# trial's working copy, and brings back any file the command wrote.
# Env: AB_ROOT (the trial worktree), AB_BASE (its base commit), AB_SLOT,
# AB_HOST (default coderos-4080), AB_CMD_TIMEOUT (default 600).
set -u
root=${AB_ROOT:?} base=${AB_BASE:?} slot=${AB_SLOT:?}
host=${AB_HOST:-coderos-4080}
limit=${AB_CMD_TIMEOUT:-600}
ctl="-o ControlMaster=auto -o ControlPath=/tmp/ab-ssh-%C -o ControlPersist=15m -o ConnectTimeout=20"
rel=$(python3 -c 'import os,sys; r=os.path.relpath(os.getcwd(), sys.argv[1]); print("." if r.startswith("..") else r)' "$root")
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
idx=$(git -C "$root" rev-parse --path-format=absolute --git-path index)
cp "$idx" "$tmp/index"
GIT_INDEX_FILE="$tmp/index" git -C "$root" add -A >/dev/null 2>&1
GIT_INDEX_FILE="$tmp/index" git -C "$root" diff --cached --binary "$base" > "$tmp/local.patch"
quoted=""
for a in "$@"; do a=${a//$root/@ROOT@}; quoted+=" $(printf '%q' "$a")"; done
# stdin: size, patch, then held open (sleep) so the build host stops the
# command if this process is killed.
size=$(wc -c < "$tmp/local.patch" | tr -d ' ')
exec 3< <(printf '%s\n' "$size"; cat "$tmp/local.patch"; exec sleep 86400)
holder=$!
ssh $ctl "$host" "bash ~/ab/bin/run.sh $slot $base $(printf '%q' "$rel") $limit --$quoted" <&3 &
sshpid=$!
trap 'kill "$holder" "$sshpid" 2>/dev/null; exit 143' TERM INT HUP
wait "$sshpid"
rc=$?
exec 3<&-
kill "$holder" 2>/dev/null
ssh $ctl "$host" "cat ~/ab/slot$slot.result.patch" > "$tmp/result.patch" 2>/dev/null
if ! cmp -s "$tmp/local.patch" "$tmp/result.patch"; then
  if [ -s "$tmp/local.patch" ]; then git -C "$root" apply -R --binary "$tmp/local.patch" 2>/dev/null; fi
  if [ -s "$tmp/result.patch" ]; then git -C "$root" apply --binary "$tmp/result.patch" 2>/dev/null || echo "ab: could not bring the build host's file changes back" >&2; fi
fi
exit $rc
