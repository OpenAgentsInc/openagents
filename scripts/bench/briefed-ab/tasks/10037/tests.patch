+            dir.path()
+                .join("basic-chats")
+                .join(format!("basic-{}.cache", ids[0])),
+        )
+        .unwrap();
+        assert!(!raw.contains("question 0"));
+        assert!(
+            Cache::open(&dir.path().join("basic-chats"), &key(7))
+                .unwrap()
+                .read::<Saved>(&item(&ids[0]))
+                .is_err()
+        );
+
+        // A restarted host reads the same rows, turns, lane, and export.
+        drop(host);
+        let mut host = host_store(dir.path());
+        assert_eq!(host.list(), rows.as_slice());
+        for (n, id) in ids.iter().enumerate() {
+            assert_eq!(host.turns(id), turns[n].as_slice());
+            assert_eq!(atif(&mut host, id), exports[n]);
+        }
+        assert_eq!(host.lane(&ids[0]), lane);
+        assert_eq!(
+            host.get(&ids[0]).unwrap().coder,
+            Some(Spawned {
+                host: "d".repeat(64),
+                task: "e".repeat(64),
+                project: Some("openagents".into()),
+                at: Some(150),
+            })
+        );
+        assert!(host.get(&ids[1]).unwrap().archived);
+        let named = host.get(&ids[2]).unwrap();
+        assert!(named.pinned && named.named && named.title == "Named");
+    }
+
+    #[test]
+    fn a_second_move_is_a_no_op() {
+        let dir = tempfile::tempdir().unwrap();
+        home_with_threads(dir.path());
+        let home = dir.path().join("chat");
+        let mut host = host_store(dir.path());
+        migrate(&home, &mut host, HOST, 5_000).unwrap();
+        let rows = host.list().to_vec();
+        let marked = marker(&home).unwrap();
+        assert_eq!(
+            migrate(&home, &mut host, HOST, 6_000).unwrap(),
+            Report::default()
+        );
+        assert_eq!(host.list(), rows.as_slice());
+        assert_eq!(marker(&home).unwrap(), marked);
+        // Even a restarted host on the same store changes nothing.
+        let mut again = host_store(dir.path());
+        assert_eq!(
+            migrate(&home, &mut again, HOST, 7_000).unwrap(),
+            Report::default()
+        );
+        assert_eq!(again.list(), rows.as_slice());
+    }
+
+    #[test]
+    fn a_move_stopped_halfway_resumes_and_loses_nothing() {
+        let dir = tempfile::tempdir().unwrap();
+        let ids = home_with_threads(dir.path());
+        let home = dir.path().join("chat");
+        let mut host = host_store(dir.path());
+        // A crash after one thread: the old store stays, with no marker.
+        assert!(migrate_until(&home, &mut host, HOST, 5_000, Stop::After(1)).is_err());
+        assert!(pending(&home));
+        assert!(marker(&home).unwrap().is_none());
+        assert_eq!(host.list().len(), 1);
+        // The restarted host finishes, skipping the thread already there.
+        drop(host);
+        let mut host = host_store(dir.path());
+        assert_eq!(host.list().len(), 1);
+        // A crash after the marker, before the rename.
+        assert!(migrate_until(&home, &mut host, HOST, 6_000, Stop::BeforeRename).is_err());
+        assert!(pending(&home));
+        assert_eq!(host.list().len(), 3);
+        drop(host);
+        let mut host = host_store(dir.path());
+        let report = migrate(&home, &mut host, HOST, 7_000).unwrap();
+        assert_eq!((report.moved, report.present), (0, 3));
+        assert!(!pending(&home));
+        let mut listed: Vec<String> = host.list().iter().map(|row| row.id.clone()).collect();
+        listed.sort();
+        assert_eq!(listed, ids);
+        for id in &ids {
+            assert_eq!(host.turns(id).len(), 2);
+        }
+        // The first run that wrote a thread and the old store's copy agree.
+        let mut old = BasicChats::new(
+            None,
+            None,
+            Some(Cache::open(report.renamed.as_ref().unwrap(), &key(7)).unwrap()),
+        );
+        for id in &ids {
+            assert_eq!(old.turns(id), host.turns(id));
+        }
+    }
+
+    #[test]
+    fn a_thread_the_host_already_changed_is_left_as_it_is() {
+        let dir = tempfile::tempdir().unwrap();
+        let ids = home_with_threads(dir.path());
+        let home = dir.path().join("chat");
+        let mut host = host_store(dir.path());
+        assert!(migrate_until(&home, &mut host, HOST, 5_000, Stop::After(1)).is_err());
+        let first = host.list()[0].id.clone();
+        host.rename(&first, "Changed on the host").unwrap();
+        migrate(&home, &mut host, HOST, 6_000).unwrap();
+        assert_eq!(host.get(&first).unwrap().title, "Changed on the host");
+        assert_eq!(host.list().len(), ids.len());
+    }
+
+    #[test]
+    fn scratch_stores_and_unreadable_records_are_never_moved() {
+        let scratch_home = std::env::temp_dir().join(SCRATCH).join("f".repeat(32));
+        let dir = tempfile::tempdir().unwrap();
+        let mut host = host_store(dir.path());
+        assert!(migrate(&scratch_home, &mut host, HOST, 1).is_err());
+        assert!(scratch(&scratch_home));
+
+        // A record under another key: nothing is renamed or marked.
+        home_with_threads(dir.path());
+        let home = dir.path().join("chat");
+        Cache::open(&home.join(STORE), &key(8))
+            .unwrap()
+            .write(&item(&"9".repeat(32)), &Saved::default())
+            .unwrap();
+        assert!(migrate(&home, &mut host, HOST, 2).is_err());
+        assert!(pending(&home));
+        assert!(marker(&home).unwrap().is_none());
+
+        // A home with nothing to move is a no-op.
+        let empty = dir.path().join("empty");
+        assert_eq!(
+            migrate(&empty, &mut host, HOST, 3).unwrap(),
+            Report::default()
+        );
+    }
+}
