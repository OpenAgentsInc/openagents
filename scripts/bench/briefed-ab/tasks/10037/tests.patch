diff --git a/crates/openagents-chat/src/migrate.rs b/crates/openagents-chat/src/migrate.rs
new file mode 100644
index 0000000000000000000000000000000000000000..11cae09adf8d662fb38f95845fc4340d47ba66ef
--- /dev/null
+++ b/crates/openagents-chat/src/migrate.rs
@@ -0,0 +1,543 @@
+//! Moving threads kept without a host into the host's store.
+//!
+//! Without a host, `openagents chat` keeps its threads in its own encrypted
+//! store (`<chat home>/threads`, under `<chat home>/device.key`). When a
+//! host runs on the same computer, the host takes them into its own store
+//! (`<host root>/basic-chats`), re-encrypted under the host's key, so the
+//! desktop app and a paired phone show them. Each thread keeps its ID,
+//! title, times, turns with their router metadata and send IDs, lane, and
+//! Coder link.
+//!
+//! The move is crash-safe and idempotent:
+//!
+//! 1. Every thread is written into the host's store, one durable record at
+//!    a time. A thread the host already holds is left as it is, so a run
+//!    after a crash skips what the crashed run wrote.
+//! 2. The marker, `<chat home>/threads-migrated.json`, is written
+//!    atomically, naming the host and every thread moved.
+//! 3. The old store is renamed `threads-moved-<time>`, so it is never read
+//!    again. Its encrypted files stay there, under the same device key.
+//!
+//! Nothing is deleted. A crash before step 3 leaves `threads` in place and
+//! the next run repeats the steps, skipping the threads already moved. A
+//! later `openagents chat --local` starts a new `threads`, which the next
+//! host moves the same way. Scratch stores are never moved.
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+use secp256k1::SecretKey;
+use serde::{Deserialize, Serialize};
+
+use crate::basic_chats::{BasicChats, Saved, Summary, item};
+use crate::basic_coder::Role;
+use crate::cache::Cache;
+
+/// The in-process store, inside the chat home.
+pub const STORE: &str = "threads";
+/// The marker the move leaves in the chat home.
+pub const MARKER: &str = "threads-migrated.json";
+/// The prefix of a moved store's new name.
+pub const MOVED: &str = "threads-moved-";
+/// The directory, under the system temporary directory, that holds every
+/// scratch store (`openagents chat --scratch`).
+pub const SCRATCH: &str = "openagents-chat-scratch";
+/// The most moves the marker remembers; the oldest go first.
+const MAX_RUNS: usize = 32;
+
+/// What a move did.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Report {
+    /// Threads written into the host's store now.
+    pub moved: usize,
+    /// Threads the host already held, left as they were.
+    pub present: usize,
+    /// Where the old store went, when there was one.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub renamed: Option<PathBuf>,
+}
+
+/// One move, as the marker records it.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Run {
+    /// The host's public key, lowercase hex.
+    pub host: String,
+    pub at: u64,
+    /// Every thread of the old store, now in the host's.
+    pub threads: Vec<String>,
+    /// The old store's new name, inside the chat home.
+    pub moved_to: String,
+}
+
+/// The marker's contents: every move, oldest first.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Marker {
+    pub runs: Vec<Run>,
+}
+
+/// Whether `home` keeps threads a host has not taken in yet.
+#[must_use]
+pub fn pending(home: &Path) -> bool {
+    fs::symlink_metadata(home.join(STORE)).is_ok_and(|meta| meta.is_dir())
+}
+
+/// Whether `home` is, or is inside, a scratch store.
+#[must_use]
+pub fn scratch(home: &Path) -> bool {
+    let root = std::env::temp_dir().join(SCRATCH);
+    let canonical = |path: &Path| path.canonicalize().unwrap_or_else(|_| path.to_path_buf());
+    home.starts_with(&root) || canonical(home).starts_with(canonical(&root))
+}
+
+/// The marker in `home`, when a move left one.
+///
+/// # Errors
+/// A marker that can't be read.
+pub fn marker(home: &Path) -> Result<Option<Marker>, String> {
+    match fs::read(home.join(MARKER)) {
+        Ok(bytes) => serde_json::from_slice(&bytes)
+            .map(Some)
+            .map_err(|_| format!("{} is not a migration marker", MARKER)),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(format!("cannot read {MARKER}: {error}")),
+    }
+}
+
+/// The device key `home/device.key` holds: 64 hexadecimal characters.
+///
+/// # Errors
+/// A missing or malformed key.
+pub fn device_key(home: &Path) -> Result<SecretKey, String> {
+    let text = fs::read_to_string(home.join("device.key"))
+        .map_err(|error| format!("cannot read the chat device key: {error}"))?;
+    let text = text.trim();
+    let bytes: Vec<u8> = (0..text.len())
+        .step_by(2)
+        .filter_map(|at| text.get(at..at + 2))
+        .filter_map(|pair| u8::from_str_radix(pair, 16).ok())
+        .collect();
+    let bytes: [u8; 32] = bytes
+        .try_into()
+        .map_err(|_| "the chat device key is malformed".to_owned())?;
+    SecretKey::from_byte_array(bytes).map_err(|_| "the chat device key is malformed".into())
+}
+
+/// Move the threads kept in `home` into `into`, the host `host`'s store,
+/// at `now`. A home with no threads to move is a no-op.
+///
+/// # Errors
+/// A scratch store, a key or record that can't be read (nothing is renamed
+/// then), or a write the host's store refused.
+pub fn migrate(home: &Path, into: &mut BasicChats, host: &str, now: u64) -> Result<Report, String> {
+    migrate_until(home, into, host, now, Stop::Never)
+}
+
+/// Where a test stops a move, as a crash would.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Stop {
+    Never,
+    /// After this many threads are written.
+    After(usize),
+    /// After the marker, before the rename.
+    BeforeRename,
+}
+
+pub(crate) fn migrate_until(
+    home: &Path,
+    into: &mut BasicChats,
+    host: &str,
+    now: u64,
+    stop: Stop,
+) -> Result<Report, String> {
+    if scratch(home) {
+        return Err("a scratch store is never migrated".into());
+    }
+    let store_path = home.join(STORE);
+    match fs::symlink_metadata(&store_path) {
+        Ok(meta) if meta.is_dir() => {}
+        Ok(_) => return Err(format!("{} is not a directory", store_path.display())),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            return Ok(Report::default());
+        }
+        Err(error) => return Err(format!("cannot read {}: {error}", store_path.display())),
+    }
+    let secret = device_key(home)?;
+    let store = Cache::open(&store_path, &secret)?;
+    // The list, for records older than the summary they now carry.
+    let listed: BTreeMap<String, Summary> = store
+        .read::<Vec<Summary>>("basic-index")
+        .ok()
+        .flatten()
+        .unwrap_or_default()
+        .into_iter()
+        .map(|row| (row.id.clone(), row))
+        .collect();
+    let mut report = Report::default();
+    let mut threads = Vec::new();
+    for key in store
+        .keys("basic-")?
+        .into_iter()
+        .filter(|key| key.len() == 38)
+    {
+        let id = key["basic-".len()..].to_owned();
+        let saved: Saved = store
+            .read(&key)
+            .map_err(|error| format!("thread {id} can't be read: {error}"))?
+            .ok_or_else(|| format!("thread {id} went missing"))?;
+        if key != item(&id) {
+            continue;
+        }
+        let summary = match (saved.summary, listed.get(&id)) {
+            (Some(own), Some(row)) if row.updated > own.updated => row.clone(),
+            (Some(own), _) => own,
+            (None, Some(row)) => row.clone(),
+            (None, None) => untitled(&id, &saved.turns),
+        };
+        if summary.id != id {
+            return Err(format!("thread {id} names another thread"));
+        }
+        if stop == Stop::After(report.moved) {
+            return Err("stopped".into());
+        }
+        if into.adopt(summary, saved.turns, saved.lane)? {
+            report.moved += 1;
+        } else {
+            report.present += 1;
+        }
+        threads.push(id);
+    }
+    let moved_to = format!("{MOVED}{now}");
+    let mut marker = marker(home)?.unwrap_or_default();
+    marker.runs.push(Run {
+        host: host.to_owned(),
+        at: now,
+        threads,
+        moved_to: moved_to.clone(),
+    });
+    let skip = marker.runs.len().saturating_sub(MAX_RUNS);
+    marker.runs.drain(..skip);
+    write_atomic(home, MARKER, &marker)?;
+    if stop == Stop::BeforeRename {
+        return Err("stopped".into());
+    }
+    let mut target = home.join(&moved_to);
+    let mut attempt = 1;
+    while target.exists() {
+        target = home.join(format!("{moved_to}-{attempt}"));
+        attempt += 1;
+    }
+    fs::rename(&store_path, &target)
+        .map_err(|error| format!("cannot set the old store aside: {error}"))?;
+    sync_dir(home)?;
+    report.renamed = Some(target);
+    Ok(report)
+}
+
+/// A row for a record whose list entry is gone: titled by its first
+/// message, timed by its turns.
+fn untitled(id: &str, turns: &[crate::basic_coder::Turn]) -> Summary {
+    let title: String = turns
+        .iter()
+        .find(|turn| turn.role == Role::User)
+        .and_then(|turn| turn.text.lines().next())
+        .unwrap_or("Chat")
+        .chars()
+        .take(80)
+        .collect();
+    let times: Vec<u64> = turns.iter().filter_map(|turn| turn.at).collect();
+    Summary {
+        id: id.to_owned(),
+        title,
+        started: times.iter().copied().min().unwrap_or(0),
+        updated: times.iter().copied().max().unwrap_or(0),
+        coder: None,
+        archived: false,
+        pinned: false,
+        named: false,
+    }
+}
+
+fn write_atomic(home: &Path, name: &str, value: &impl Serialize) -> Result<(), String> {
+    let bytes = serde_json::to_vec_pretty(value).map_err(|_| "cannot encode the marker")?;
+    let temp = home.join(format!(".{name}.pending"));
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create(true).truncate(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let result = (|| {
+        let mut file = options.open(&temp)?;
+        file.write_all(&bytes)?;
+        file.sync_all()?;
+        fs::rename(&temp, home.join(name))
+    })();
+    if let Err(error) = result {
+        let _ = fs::remove_file(&temp);
+        return Err(format!("cannot write {name}: {error}"));
+    }
+    sync_dir(home)
+}
+
+fn sync_dir(dir: &Path) -> Result<(), String> {
+    fs::File::open(dir)
+        .and_then(|dir| dir.sync_all())
+        .map_err(|error| format!("cannot sync {}: {error}", dir.display()))
+}
+
