+async fn a_question_must_end_with_the_visitor() {
+    let root = tempfile::tempdir().unwrap();
+    let mut config = config(root.path().into());
+    config.chat = Arc::new(Answering);
+    for body in [
+        "not json",
+        r#"{"turns":[]}"#,
