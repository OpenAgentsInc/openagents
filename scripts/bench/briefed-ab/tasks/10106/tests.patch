+        r#"{"turns":[{"role":"system","text":"hi"}]}"#,
+    ] {
+        let (status, _, _) = post_ask(router(config.clone()), body, None).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST, "{body}");
+    }
