+/// An invitation's QR code as plain text rows, two modules per row, with
+/// the four-module quiet zone, for a screen that draws its own colors.
+/// Light modules are filled (`█`, `▀`, `▄`), so drawn light on a dark
+/// background it still scans as dark on light. No escape sequences.
+#[cfg(feature = "qr")]
+pub fn text_qr_rows_prefixed(prefix: &str, code: &str) -> Result<Vec<String>> {
+    let qr = qr(prefix, code)?;
+    let side = qr.size() + 8;
+    // Outside the code, including the half row below an odd side, is light.
+    let light = |x, y| !qr.get_module(x - 4, y - 4);
+    Ok((0..side)
+        .step_by(2)
+        .map(|y| {
+            (0..side)
+                .map(|x| match (light(x, y), light(x, y + 1)) {
+                    (true, true) => '█',
+                    (true, false) => '▀',
+                    (false, true) => '▄',
+                    (false, false) => ' ',
+                })
+                .collect()
+        })
+        .collect())
+}
 /// The modules of an invitation's QR code, row by row, with the standard
 /// four-module quiet zone on every side; `true` is a dark module. A native
 /// host draws these itself, so the code never leaves the device.
