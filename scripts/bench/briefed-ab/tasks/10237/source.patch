+fn write_whole<W: Write + Seek + Truncate>(file: &mut W, bytes: &[u8]) -> io::Result<()> {
+    let start = file.seek(SeekFrom::End(0))?;
+    let written = file
+        .write_all(bytes)
+        .and_then(|()| file.flush())
+        .and_then(|()| file.sync());
+    if written.is_err() {
+        let _ = file.cut(start);
+        let _ = file.seek(SeekFrom::Start(start));
+    }
+    written
