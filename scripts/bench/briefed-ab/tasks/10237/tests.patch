+    #[cfg(target_os = "linux")]
+    #[test]
+    fn a_replaced_program_still_starts_itself() {
+        const CHILD: &str = "OPENAGENTS_TEST_RUNNING_PROGRAM";
+        if std::env::var_os(CHILD).is_some() {
+            let exe = std::env::current_exe().unwrap();
+            std::fs::remove_file(&exe).unwrap();
