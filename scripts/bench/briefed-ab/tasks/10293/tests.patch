diff --git a/crates/coder-boundary/tests/boundary.rs b/crates/coder-boundary/tests/boundary.rs
index c35f75b68e1ade94f611ec04fd04ba56d53bd5b4..40ad2f27ac1f5e26943ad06abff79965d0073d9e 100644
--- a/crates/coder-boundary/tests/boundary.rs
+++ b/crates/coder-boundary/tests/boundary.rs
@@ -738,6 +738,51 @@ mod enforced {
         assert!(!denied.exists(), "a toolchain boundary let a write out");
         assert!(inside.exists(), "the checkout was not writable");
     }
+
+    /// A run's leased build slot outside its checkout (#10293), as a
+    /// toolchains run or an issue flow's checks get it: the slot is
+    /// writable, the sealed task store and anything else are not.
+    #[test]
+    fn a_build_slot_outside_the_checkout_is_writable_and_the_store_is_not() {
+        if !backend() {
+            return;
+        }
+        let root = TempDir::new().unwrap();
+        let checkout = root.path().join("worktrees/run");
+        let slot = root.path().join("targets/project-slot-0");
+        let store = root.path().join("tasks");
+        let outside = TempDir::new().unwrap();
+        for path in [&checkout, &slot, &store] {
+            std::fs::create_dir_all(path).unwrap();
+        }
+        let boundary = Boundary::writing(&checkout)
+            .readable(&checkout)
+            .writable(&slot)
+            .sealed(&store)
+            .owned_scratch_under(std::env::temp_dir())
+            .build()
+            .unwrap();
+        let built = slot.join("debug/built");
+        let (ending, stderr) = run(
+            &boundary,
+            "mkdir -p \"$(dirname \"$1\")\" && printf x > \"$1\" || exit 11; \
+             if printf x > \"$2\" 2>/dev/null; then exit 12; fi; \
+             if printf x > \"$3\" 2>/dev/null; then exit 13; fi",
+            &[
+                built.clone(),
+                store.join("written"),
+                outside.path().join("written"),
+            ],
+            &checkout,
+        );
+        assert_eq!(ending, Ending::Exited(Some(0)), "stderr: {stderr}");
+        assert!(built.exists(), "the build slot was not writable");
+        assert!(
+            !store.join("written").exists(),
+            "the sealed store was written"
+        );
+        assert!(!outside.path().join("written").exists(), "a write got out");
+    }
 }
 
