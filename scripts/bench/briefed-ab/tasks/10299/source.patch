+/// Removes a published flow's worktree once nothing in it would be lost,
+/// whatever the flow's ending: the same test the background `worktrees`
+/// rule and a task's own end use ([`background::git::removable`]: clean,
+/// no ignored file outside a disposable cache, every commit on a remote,
+/// no stash). The branch goes with it, since its commits are on a
+/// remote. A worktree that must stay says why.
+pub(crate) fn release(ended: &coder_delegate::issue::Ended<'_>) -> bool {
+    if ended.source.is_none() {
+        return false;
+    }
+    let undo = match background::git::removable(ended.workdir) {
+        Ok(undo) => undo,
+        Err(why) => {
+            coder_delegate::say::say!(
+                "issue ▸ kept the worktree {} ({why})",
+                ended.workdir.display()
+            );
+            return false;
+        }
+    };
+    if let Err(why) = background::git::remove(&undo) {
+        coder_delegate::say::say!(
+            "issue ▸ kept the worktree {} ({why})",
+            ended.workdir.display()
+        );
+        return false;
+    }
+    let _ = std::process::Command::new("git")
+        .args(["branch", "-D", "--", ended.branch])
+        .current_dir(&undo.repo)
+        .output();
+    true
 }
 
