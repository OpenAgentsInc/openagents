+                for k in 0..4 {
+                    assert!(
+                        (weight(&mix, k) - weight(last, k)).abs() <= 4.0 * STEP,
+                        "{minute}: {last:?} {mix:?}"
+                    );
+                }
+            }
+            last = Some(mix);
+        }
+        assert!(changes > 20, "{changes} changes through the day");
+    }
+
