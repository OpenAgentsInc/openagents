+/// The catalog's visible text carries no machine talk (#11031).
+#[test]
+fn catalog_copy_has_no_machine_talk() {
+    let text = oa_copy::visible_text(&catalog());
+    const ALLOW: &[&str] = &[
+        // The name of the mouse-pointer icon (`Icon::Cursor`) in the icon gallery.
+        "cursor",
+    ];
+    let hits = oa_copy::violations(&text, ALLOW);
+    assert!(
+        hits.is_empty(),
+        "machine talk in /ui: {}",
+        hits.iter()
+            .map(|h| format!("{:?} in \"{}\"", h.term, h.context))
+            .collect::<Vec<_>>()
+            .join("; ")
+    );
+}
