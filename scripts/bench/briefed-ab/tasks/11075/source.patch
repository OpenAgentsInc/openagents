+        let filter = self.actor_filter(life);
+        let settings = physics::character::Settings::default();
+        let clear = |feet: glam::DVec3| {
+            physics::character::Character::new(feet)
+                .teleport(&self.query_scene, filter, settings, feet)
+                .is_ok()
+        };
+        if clear(spawn) {
+            return Ok(spawn);
+        }
