+            .nodes()
+            .iter()
+            .map(|cell| cell.feet)
+            .filter(|feet| {
+                (feet.y - spawn.y).abs() <= settings.step_height && distance(feet) <= RESPAWN_RADIUS
+            })
+            .collect();
+        cells.sort_by(|a, b| {
+            distance(a)
