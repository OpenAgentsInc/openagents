+        local.observe(baseline, &source, 2, 2).unwrap();
+        local.queue(1, movement()).unwrap();
+        local.advance(8. / 120.).unwrap();
+        let mut frame = local.movement_frame(0, 8).unwrap();
+        frame.sequence = 1;
+        local.bind_movement_frame(&frame).unwrap();
