+#[tokio::test]
+async fn a_slow_first_upstream_falls_back_to_a_fast_second() {
+    let slow = Stub::new("slow", Script::Slow(900));
+    let fast = Stub::new("fast", Script::Answer);
+    let (gateway, _meter) = gateway(&[slow.clone(), fast.clone()]);
+    let started = std::time::Instant::now();
+    let routed = gateway
+        .run(&request("openagents/chat"), &caller())
+        .await
+        .expect("routed");
+    // The first missed its 200 ms deadline; the second was last and fast.
+    assert!(started.elapsed() < Duration::from_millis(800));
+    assert_eq!(routed.upstream, "fast");
+    assert_eq!(
+        routed.attempts[0].reason.as_deref(),
+        Some("first_token_deadline")
+    );
+    assert_eq!(slow.calls(), 1);
+    let response = collect(routed.events).await.expect("response");
+    assert_eq!(response.output_text(), "hello");
+}
+
+#[tokio::test]
+async fn when_every_attempt_is_slow_the_last_runs_to_its_ceiling_and_answers() {
+    let a = Stub::new("a", Script::Slow(1_000));
+    let b = Stub::new("b", Script::Slow(600));
+    let (gateway, _meter) = gateway(&[a.clone(), b.clone()]);
+    let prepared = gateway
+        .prepare(&request("openagents/chat"), &caller())
+        .await
+        .expect("prepared");
+    let told = Arc::new(AtomicUsize::new(0));
+    let seen = told.clone();
+    let routed = gateway
+        .send_observed(&request("openagents/chat"), &caller(), prepared, &move |_| {
+            seen.fetch_add(1, Ordering::SeqCst);
+        })
+        .await
+        .expect("the last attempt waits past its 200 ms deadline");
+    assert_eq!(routed.upstream, "b");
+    assert_eq!(routed.attempts.len(), 2);
+    assert_eq!(a.calls(), 1);
+    // The person is told it is still working, once.
+    assert_eq!(told.load(Ordering::SeqCst), 1);
+    let response = collect(routed.events).await.expect("response");
+    assert_eq!(response.status, ResponseStatus::Completed);
+}
+
+#[tokio::test]
+async fn a_last_attempt_slower_than_its_ceiling_is_a_plain_failure() {
+    let a = Stub::new("a", Script::Hang);
+    let b = Stub::new("b", Script::Hang);
+    let (gateway, meter) = gateway(&[a, b]);
+    let started = std::time::Instant::now();
+    let error = gateway
+        .run(&request("openagents/chat"), &caller())
+        .await
+        .expect_err("failed");
+    assert!(started.elapsed() >= Duration::from_millis(1_500));
+    assert_eq!(error.kind.status(), 502);
+    assert_eq!(kept(&meter), 2);
+}
