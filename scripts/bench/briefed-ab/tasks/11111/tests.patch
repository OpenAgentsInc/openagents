+fn anthropic_stream(chunks: &[Value]) -> String {
+    chunks
+        .iter()
+        .map(|chunk| {
+            format!(
+                "event: {}\ndata: {chunk}\n\n",
+                chunk["type"].as_str().unwrap()
+            )
+        })
+        .collect()
+}
