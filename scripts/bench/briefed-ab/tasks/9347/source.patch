@@ -0,0 +1,34 @@
+[package]
+name = "lev"
+version.workspace = true
+edition = "2024"
+rust-version = "1.95"
+description = "The System One contract answered by Apple's on-device foundation model: guided generation, seeded estimators, and a fitted calibration map."
+publish = false
+
+[features]
+# The `lev-serve` binary and its dependencies.
+serve = ["dep:axum", "dep:tokio", "dep:tower-http"]
+
+[dependencies]
+indexmap = { version = "2", features = ["serde"] }
+serde = { version = "1", features = ["derive"] }
+serde_json = { version = "1", features = ["preserve_order"] }
+sha2 = "0.10"
+thiserror = "2"
+
+axum = { version = "0.8", optional = true }
+tokio = { version = "1", features = ["full"], optional = true }
+tower-http = { version = "0.6", features = ["cors"], optional = true }
+
+[dev-dependencies]
+jev = { path = "../jev" }
+tokio = { version = "1", features = ["full", "test-util"] }
+
+[[bin]]
+name = "lev-serve"
+path = "src/bin/lev_serve.rs"
+required-features = ["serve"]
+
+[lints]
+workspace = true
diff --git a/crates/lev/src/error.rs b/crates/lev/src/error.rs
