+    #[test]
+    fn two_blocks_never_share_a_seed() {
+        let n = 8;
+        let blocks: Vec<Vec<u64>> =
+            (0..8).map(|base| seed_block(base, n).unwrap().collect()).collect();
+        for (left, first) in blocks.iter().enumerate() {
+            for (right, second) in blocks.iter().enumerate().skip(left + 1) {
+                assert!(
