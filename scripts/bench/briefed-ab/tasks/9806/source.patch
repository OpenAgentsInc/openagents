+pub fn capture_extended(
+    width: u32,
+    height: u32,
+    world: &Mesh,
+    view: View,
+    dynamic: &Mesh,
+    ui: &UiBatch,
+    atlas: &Atlas,
+    atmosphere: crate::zones::Atmosphere,
