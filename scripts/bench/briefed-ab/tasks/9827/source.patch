+    fn wake_near_kinematic(&mut self, margin: f64) {
+        let movers: Vec<usize> = (0..self.bodies.len())
+            .filter(|&i| self.bodies[i].kind == BodyKind::Kinematic && self.pushes(i))
+            .collect();
