+    let trust = verse::xp::XpTrust {
+        referees: std::collections::BTreeSet::from([referee.pubkey().to_owned()]),
+        runners: std::collections::BTreeSet::new(),
+    };
+    Ok(verse::xp::snapshot(&events, &trust))
