{%- set first = 1 if messages and messages[0]['role'] == 'system' else 0 -%}
{{- '<extra_id_0>System\n' + (messages[0]['content'] if first else '') + '\n' -}}
{%- for message in messages[first:] -%}
    {%- if message['role'] == 'user' -%}
        {{- '<extra_id_1>User\n' + message['content'] + '\n' -}}
    {%- elif message['role'] == 'assistant' -%}
        {{- '<extra_id_1>Assistant\n' + message['content'] + '\n' -}}
    {%- else -%}
        {{- raise_exception('Nemotron 4 supports an optional leading system message and user/assistant turns.') -}}
    {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '<extra_id_1>Assistant\n' -}}
{%- endif -%}
