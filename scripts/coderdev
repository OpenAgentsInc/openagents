#!/usr/bin/env bash
# Build the current Coder terminal from this checkout, then run it from the caller's
# directory with the caller's arguments.
# Never pull, rebase, stash, or otherwise modify the checkout or index.
# Concurrent agents' edits must stay in place and are built as-is.
#
# The build uses the toolchain that rust-toolchain.toml pins and Cargo's own
# freshness check, so unchanged source reuses the executable and dirty edits
# are compiled in. A failed build stops the launch; the old executable never
# runs by mistake.
#
# Environment:
#   CARGO_TARGET_DIR   Where Cargo writes the build; default
#                      ~/work/openagents-target-agent1, outside the checkout.
#   CODERDEV_ENV_FILE  Optional file of KEY=VALUE lines to load before the
#                      binary starts. It is sourced in this process only, so
#                      nothing reaches the parent shell, and nothing is printed.
#   CODERDEV_CARGO     Cargo command to run; default cargo. Tests point this at
#                      a stub.
#
# Build progress and launch identity go to standard error. Cargo reports
# compilation progress and waits for build locks instead of silently waiting.
set -euo pipefail

source_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
launch_dir="$PWD"
cargo="${CODERDEV_CARGO:-cargo}"
target_dir="${CARGO_TARGET_DIR:-$HOME/work/openagents-target-agent1}"
case "$target_dir" in
  /*) ;;
  *) target_dir="${launch_dir}/${target_dir}" ;;
esac
export CARGO_TARGET_DIR="$target_dir"
export CODER_BUILD_COMMIT="$(git -C "$source_dir" rev-parse HEAD)"

revision="$(git -C "$source_dir" rev-parse --short HEAD 2>/dev/null || echo unknown)"
dirty=clean
if test -n "$(git -C "$source_dir" status --porcelain --untracked-files=no 2>/dev/null)"; then
  dirty=dirty
fi
export CODER_BUILD_DIRTY=0
if test "$dirty" = dirty; then export CODER_BUILD_DIRTY=1; fi

echo "coderdev: building ${revision} (${dirty}) in ${target_dir}; Cargo progress follows" >&2

# Do not build the companion OpenAgents CLI here: its Verse dependency graph
# is not part of the Coder development launch. An installed CLI remains usable.
# Build immediately without acquiring an OpenAgents lease. Cargo still checks freshness.
# The subshell keeps the launch directory intact.
(cd "$source_dir" && \
  "$cargo" build -p coder-new --bin coder-new \
  -p microcoder --bin microcoder) || {
  echo "coderdev: build failed; not running the previous executable" >&2
  exit 1
}

binary="${target_dir}/debug/coder-new"
test -x "$binary" || {
  echo "coderdev: build produced no executable at ${binary}" >&2
  exit 1
}
echo "coderdev: coder ${revision} (${dirty}) ${binary}" >&2

if test -n "${CODERDEV_ENV_FILE:-}"; then
  test -r "$CODERDEV_ENV_FILE" || {
    echo "coderdev: cannot read CODERDEV_ENV_FILE=${CODERDEV_ENV_FILE}" >&2
    exit 1
  }
  set -a
  # shellcheck disable=SC1090
  . "$CODERDEV_ENV_FILE"
  set +a
fi

cd "$launch_dir"
exec "$binary" "$@"
