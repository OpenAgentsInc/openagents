#!/usr/bin/env bash
# Staging builds compress at brotli quality 5 (staging-build-env.sh).
set -euo pipefail
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -q) args+=(-q 5); shift 2 ;;
    --quality=*) args+=(--quality=5); shift ;;
    *) args+=("$1"); shift ;;
  esac
done
PATH="${PATH//$OA_STAGING_SHIMS:/}" exec brotli "${args[@]}"
