#!/usr/bin/env bash
# Staging builds skip wasm-opt (staging-build-env.sh): copy the input to the
# output, or leave it when they are the same file.
set -euo pipefail
in="" out=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -*) shift ;;
    *) in="$1"; shift ;;
  esac
done
[[ -n "$in" && -n "$out" ]] || { echo "wasm-opt (staging): need INPUT and -o OUTPUT" >&2; exit 64; }
[[ "$in" -ef "$out" ]] || cp "$in" "$out"
