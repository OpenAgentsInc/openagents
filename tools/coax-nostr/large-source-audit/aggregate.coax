    yes:=AG_public_arm(nodes,values,roots,types,n.c,env,memory,state,depth);no:=AG_public_arm(nodes,values,roots,types,n.d,env,memory,state,depth);
    joined:=AG_accumulate(yes,no,memory);joined.returned=yes.returned && no.returned;result=AG_accumulate(result,joined,memory);
   }else {branch:=ifx condition.lo!=0 then n.c else n.d;if branch!=0 {saved:=env[0].count;if nodes[branch].kind!=40 {SC_fail(state,SC_UNSUPPORTED,branch);break;}part:=AG_block(nodes,values,roots,types,branch,env,memory,state,depth+1);env[0].count=saved;result=AG_accumulate(result,part,memory);}}}
  else if n.kind==46 {condition:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);SC_fail(state,ifx AG_origin(condition,memory)!=0 then SC_BRANCH else SC_UNSUPPORTED,at);}
