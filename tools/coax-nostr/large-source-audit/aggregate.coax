AG_public_only :: (name:string)->bool {return name.count>=7 && name[name.count-7..<name.count]=="_public";}
AG_call :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int)->AgValue {
 n:=nodes[id];if SC_vartime(n.name) || (AG_public_only(n.name) && !memory[0].public_views) {SC_fail(state,SC_VARTIME,id);return AgValue.{};}args:[8]AgValue;count:=0;at:=n.head;
 while at!=0 {if count==8 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}args[count]=AG_expr(nodes,values,roots,types,at,env,memory,state,depth);count+=1;at=nodes[at].next;if state[0].error!=0 {return AgValue.{};}}
 d:=AG_decl(nodes,roots,n.name,state);builtin:=SC_builtin(n.name);if AG_slot(env,n.name)>=0 {SC_fail(state,SC_CALL,id);return AgValue.{};}
 if builtin!=0 {
  if d!=0 || count!=ifx builtin==1 then 1 else 2 {SC_fail(state,SC_CALL,id);return AgValue.{};}
  r:=AG_unranged(args[0]);r.mask=AG_origin(r,memory);r.region=0;r.known=false;r.literal=0;
