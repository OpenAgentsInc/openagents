 nodes[5]=ScNode.{kind=16};values[5]=4;nodes[6]=ScNode.{kind=16};values[6]=1025;nodes[7]=ScNode.{kind=1,name="u8"};nodes[8]=ScNode.{kind=1,name="P"};nodes[9]=ScNode.{kind=1,name="Q"};nodes[10]=ScNode.{kind=1,name="f64"};
 nodes[11]=ScNode.{kind=2,a=5,b=7};#assert AG_quiet(nodes[..],values[..],roots[..],11,0);
 nodes[11].a=6;#assert !AG_quiet(nodes[..],values[..],roots[..],11,0);nodes[11].a=7;#assert !AG_quiet(nodes[..],values[..],roots[..],11,0);
 nodes[11]=ScNode.{kind=3,b=8};#assert AG_quiet(nodes[..],values[..],roots[..],11,0);nodes[11].b=9;#assert !AG_quiet(nodes[..],values[..],roots[..],11,0);
 nodes[11].b=10;#assert !AG_quiet(nodes[..],values[..],roots[..],11,0);#assert !AG_quiet(nodes[..],values[..],roots[..],0,0) && !AG_quiet(nodes[..],values[..],roots[..],12,0) && !AG_quiet(nodes[..],values[..],roots[..],2,0);
 values[5]=0;nodes[11]=ScNode.{kind=2,a=5,b=7};#assert !AG_quiet(nodes[..],values[..],roots[..],11,0);values[5]=1;#assert AG_quiet(nodes[..],values[..],roots[..],11,0);values[5]=1024;#assert AG_quiet(nodes[..],values[..],roots[..],11,0);
 #assert !AG_quiet(nodes[..],values[..],roots[..],11,8) && AG_quiet(nodes[..],values[..],roots[..],11,6);
