   if items.extent<1 || AG_primitive_name(element)=="" {SC_fail(state,SC_UNSUPPORTED,at);break;}
   part:=AG_loop_run(nodes,values,roots,types,n,AgValue.{mask=AG_origin(items,memory)},element,env,memory,state,depth,at);if part.possible {result=AG_accumulate(result,part,memory);}
  }
