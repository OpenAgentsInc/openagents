}
AG_block :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int)->AgBlock {
 if depth>=16 || !AG_tick(state,id) {SC_fail(state,SC_LIMIT,id);return AgBlock.{};}if nodes[id].kind!=40 {SC_fail(state,SC_UNSUPPORTED,id);return AgBlock.{};}
 at:=nodes[id].head;result:AgBlock;
 while at!=0 && state[0].error==0 {if !AG_tick(state,at) {break;}n:=nodes[at];if result.returned {SC_fail(state,SC_UNSUPPORTED,at);break;}
  if n.kind==42 {if n.flag {SC_fail(state,SC_UNSUPPORTED,at);break;}type:=AG_resolved(nodes,values,roots,types,nodes[env[0].procedure],n,"local",state);r:=AG_with(AG_number(0),0,0);if n.a!=0 {r=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);}r=AG_new(nodes,values,roots,r,type,memory,state);AG_bind(env,n.name,r,state,at);}
  else if n.kind==43 {r:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);AG_write(nodes,values,roots,types,n.c,r,n.op,env,memory,state);}
