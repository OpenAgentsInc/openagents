 // Seven structs linked through arrays: the last field is reached at depth 13.
 for i:0..<7 {nodes[1+2*i]=ScNode.{kind=66,name="S",head=2+2*i};nodes[2+2*i]=ScNode.{kind=69,name="f",a=ifx i==6 then 28 else 20+i};}
 for i:0..<6 {nodes[20+i]=ScNode.{kind=2,b=1+2*(i+1)};}nodes[28]=ScNode.{kind=1,name="u64"};nodes[30]=ScNode.{kind=66,name="X"};
 #assert !AG_contains(nodes[..],roots[0..<0],1,30,state[..],0) && AG_contains(nodes[..],roots[0..<0],1,13,state[..],0);
 nodes[32]=ScNode.{kind=66,name="R",head=33};nodes[33]=ScNode.{kind=69,name="r",a=32};#assert AG_contains(nodes[..],roots[0..<0],32,30,state[..],0);
 state[0]=ScAudit.{};#assert !AG_contains(nodes[..],roots[0..<0],3,30,state[..],0) && !AG_contains(nodes[..],roots[0..<0],1,30,state[..],0);
}
