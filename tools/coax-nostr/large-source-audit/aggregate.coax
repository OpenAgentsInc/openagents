 f.nodes[6]=ScNode.{kind=45,a=7,c=11,d=8,next=12};f.nodes[11]=ScNode.{kind=40};f.nodes[8]=ScNode.{kind=40,head=9};f.nodes[9]=ScNode.{kind=44,a=10};f.nodes[10]=ScNode.{kind=16};values[10]=1;f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=16};
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<1],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.returned && r.value.known && r.value.lo==0 && r.value.hi==1;
 f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18,next=12};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};values[17]=2;f.nodes[18]=ScNode.{kind=40,head=9};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};
 state[0]=ScAudit.{};r=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.returned && r.value.known && r.value.lo==0 && r.value.hi==1;
}
