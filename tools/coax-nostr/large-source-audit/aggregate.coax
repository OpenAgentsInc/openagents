#test "public-field shadows map regions exactly and writes reach view and shadow" {
 memory:[1]AgMemory;memory[0].shadow_count=2;memory[0].shadow_base[0]=1;memory[0].shadow_field[0]=7;memory[0].shadow_region[0]=5;memory[0].shadow_struct[0]=3;
 memory[0].shadow_base[1]=2;memory[0].shadow_field[1]=7;memory[0].shadow_region[1]=6;memory[0].shadow_struct[1]=9;memory[0].fields[0]=7;memory[0].field_count=1;
 #assert AG_shadow(memory[..],1,7)==5 && AG_shadow(memory[..],2,7)==6 && AG_shadow(memory[..],1,8)==0 && AG_shadow(memory[..],3,7)==0 && AG_shadow(memory[..],0,7)==0;
 #assert AG_sensitive(memory[..],1) && AG_sensitive(memory[..],2) && !AG_sensitive(memory[..],3) && !AG_sensitive(memory[..],0);
 #assert AG_designated(memory[..],7) && !AG_designated(memory[..],8);
 memory[0].taint[1]=4;memory[0].taint[3]=8;#assert AG_read_mask(AgValue.{mask=2,region=1},memory[..])==2 && AG_read_mask(AgValue.{mask=2,region=3},memory[..])==10;
 nodes:[24]ScNode;roots:[1]int;state:[1]ScAudit;nodes[3]=ScNode.{kind=66,name="S",head=10};nodes[10]=ScNode.{kind=69,name="f",a=11};nodes[11]=ScNode.{kind=1,name="u64"};
 AG_shadow_write(nodes[..],roots[0..<0],memory[..],state[..],AgValue.{region=5,type=-1},16);#assert memory[0].taint[5]==0 && memory[0].taint[1]==20 && memory[0].dirty[1] && memory[0].taint[6]==0;
 AG_shadow_write(nodes[..],roots[0..<0],memory[..],state[..],AgValue.{region=1,type=3},32);#assert memory[0].taint[5]==32 && memory[0].taint[6]==0;
 AG_shadow_write(nodes[..],roots[0..<0],memory[..],state[..],AgValue.{region=1,type=-1},64);#assert memory[0].taint[5]==32;
 // A 16-deep chain of arrays reaches the depth limit only from depth 0.
 for i:12..<23 {nodes[i]=ScNode.{kind=2,b=i+1};}nodes[23]=ScNode.{kind=1,name="u64"};deep:[40]ScNode;for i:1..<17 {deep[i]=ScNode.{kind=2,b=i+1};}deep[17]=ScNode.{kind=1,name="u64"};deep[30]=ScNode.{kind=66,name="T"};
 #assert !AG_contains(deep[..],roots[0..<0],1,30,state[..],0) && AG_contains(deep[..],roots[0..<0],1,30,state[..],1);
 memory[0].shadow_base[1]=1;memory[0].shadow_struct[1]=30;AG_shadow_write(deep[..],roots[0..<0],memory[..],state[..],AgValue.{region=1,type=1},128);#assert memory[0].taint[6]==0;
}
