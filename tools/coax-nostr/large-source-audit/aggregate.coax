#test "declassification names, shadows, flat fields and obligations are exact" {
 #assert AG_declassifies("ok_declassify") && AG_declassifies("_declassify") && !AG_declassifies("declassify") && !AG_declassifies("ok_declassifyx") && !AG_declassifies("ok_vartime");
 memory:[1]AgMemory;memory[0].shadow_count=1;memory[0].shadow_region[0]=4;#assert AG_is_shadow(memory[..],4) && !AG_is_shadow(memory[..],3) && !AG_is_shadow(memory[..],0);
 memory[0].shadow_region[0]=0;#assert !AG_is_shadow(memory[..],0);
 nodes:[8]ScNode;roots:[1]int;state:[1]ScAudit;nodes[1]=ScNode.{kind=2,b=2};nodes[2]=ScNode.{kind=1,name="u8"};nodes[3]=ScNode.{kind=2,b=4};nodes[4]=ScNode.{kind=66,name="S"};nodes[5]=ScNode.{kind=3,b=2};
 #assert AG_flat(nodes[..],roots[0..<0],-1,state[..]) && AG_flat(nodes[..],roots[0..<0],1,state[..]) && !AG_flat(nodes[..],roots[0..<0],3,state[..]) && !AG_flat(nodes[..],roots[0..<0],4,state[..]) && !AG_flat(nodes[..],roots[0..<0],5,state[..]) && !AG_flat(nodes[..],roots[0..<0],0,state[..]);
 m:[1]AgMemory;m[0].public_views=true;args:=[1]AgValue.[AgValue.{region=4}];m[0].shadow_count=1;m[0].shadow_region[0]=4;m[0].taint[4]=8;
 v:=AG_declassify(nodes[..],m[..],state[..],1,AgValue.{mask=2,type=-1},args[..]);#assert v.mask==0 && v.type==-1 && m[0].taint[4]==0 && m[0].guard_count==1 && m[0].guards[0].mask==10 && m[0].guards[0].kind==2 && m[0].guards[0].node==1;
 v=AG_declassify(nodes[..],m[..],state[..],1,AgValue.{mask=16,type=-1},args[0..<0]);#assert m[0].guard_count==1 && m[0].guards[0].mask==26;
 v=AG_declassify(nodes[..],m[..],state[..],2,AgValue.{type=-1},args[0..<0]);#assert m[0].guard_count==2 && m[0].guards[1].node==2 && state[0].error==0;
 v=AG_declassify(nodes[..],m[..],state[..],3,AgValue.{region=5},args[0..<0]);#assert state[0].error==SC_UNSUPPORTED && state[0].where==3;
 state[0]=ScAudit.{};m[0].public_views=false;v=AG_declassify(nodes[..],m[..],state[..],3,AgValue.{type=-1},args[0..<0]);#assert state[0].error==SC_UNSUPPORTED;
 state[0]=ScAudit.{};m[0].guard_count=256;AG_obligation(nodes[..],m[..],state[..],7,1,2);#assert state[0].error==SC_LIMIT && state[0].where==7;
 state[0]=ScAudit.{};m[0]=AgMemory.{};AG_guard(nodes[..],m[..],state[..],5,4);#assert m[0].guards[0].kind==1 && m[0].guards[0].mask==4;
}
#test "an int masked by a known non-negative constant has a known interval" {
 memory:[1]AgMemory;state:[1]ScAudit;m:=AgValue.{type=-4,lo=0,hi=63,known=true};
 r:=AG_binary(AgValue.{type=-4},m,39,memory[..],state[..],0);#assert r.known && r.lo==0 && r.hi==63;
 r=AG_binary(AgValue.{type=-4,lo=1,hi=3,known=true},m,39,memory[..],state[..],0);#assert !r.known;
 r=AG_binary(AgValue.{type=-4},AgValue.{type=-4,lo= -1,hi=63,known=true},39,memory[..],state[..],0);#assert !r.known;
 r=AG_binary(AgValue.{type=-4},AgValue.{type=-4,lo=0,hi=63},39,memory[..],state[..],0);#assert !r.known;
 r=AG_binary(AgValue.{type=-1},AgValue.{type=-1,lo=0,hi=63,known=true},39,memory[..],state[..],0);#assert !r.known;
 r=AG_binary(AgValue.{type=-4},m,40,memory[..],state[..],0);#assert !r.known;
 r=AG_binary(AgValue.{type=-4},AgValue.{type=-4,lo=0,hi=0,known=true},39,memory[..],state[..],0);#assert r.known && r.hi==0;
}
