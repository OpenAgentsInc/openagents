  else if n.kind==44 {value:=AgValue.{};if n.a!=0 {value=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);}part:=AgBlock.{value=value,returned=true,possible=true};result=AG_accumulate(result,part,memory);}
  else if n.kind==52 {r:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);mask:=AG_origin(r,memory);if mask==0 && r.known && r.hi==0 {SC_fail(state,SC_UNSUPPORTED,at);}else if mask!=0 || !r.known || r.lo!=1 {AG_guard(nodes,memory,state,at,mask);}}
  else if n.kind==45 {condition:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);if AG_origin(condition,memory)!=0 {SC_fail(state,SC_BRANCH,at);break;}
   if !condition.known || condition.lo!=condition.hi {
