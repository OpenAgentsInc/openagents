 nodes[11]=ScNode.{kind=1,name="f64"};state[0]=ScAudit.{};#assert AG_resolved(nodes[..],values[..],roots[0..<0],types[..],p,n,"parameter",state[..])==0 && state[0].error==SC_TYPE;
 // AG_quiet bounds and literal lengths.
