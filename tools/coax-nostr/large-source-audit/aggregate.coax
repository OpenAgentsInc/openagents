// Separate aggregate source analysis. It never upgrades the scalar-v1 profile.
#load "inventory.coax";
#load "../../../coax/tests/nostr/secret_aggregate.coax";
#load "../../../coax/tests/nostr/secret_aggregate_cases.coax";
#authority;
AG_GUARDS :: 14;
AgValue :: struct {mask:u64;type:int;literal:int;lo:int;hi:int;known:bool;region:int;extent:int;view:bool;}
AgBinding :: struct {name:string;value:AgValue;induction:bool;}
AgEnv :: struct {bindings:[64]AgBinding;count:int;procedure:int;binding_floor:int;}
AgGuard :: struct {node:int;unit:int;line:int;column:int;mask:u64;kind:u32;}
AgMemo :: struct {procedure:int;count:int;args:[8]AgValue;result:AgValue;closure:u64;height:int;}
AgMemory :: struct {taint:[4096]u64;dirty:[4096]bool;readonly:[4096]bool;used:int;guard_count:int;guards:[256]AgGuard;memo:[128]AgMemo;memo_count:int;scope:[16]u64;height:[16]int;compiled_runs:bool;classified:bool;public_views:bool;branch_active:int;protected_regions:int;}
AgBlock :: struct {value:AgValue;returned:bool;possible:bool;}
AgLabel :: struct {name:string;type:string;extent:int;access:u32;}
#test "opt-in view roots require explicit bounded region and access" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="[] u64",extent=2,access=1}];
 f.nodes[5].a=10;f.nodes[10]=ScNode.{kind=3,b=3};f.types[0].type="[] u64";f.nodes[7]=ScNode.{kind=16};
 r:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);
 #assert r.error==0 && memory[0].used==1 && memory[0].readonly[1] && memory[0].taint[1]==1;
 labels[0].extent=0;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].extent=2;labels[0].access=0;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].access=2;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==0 && !memory[0].readonly[1];
 labels[0].extent=1025;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].extent=2;labels[0].access=3;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 r=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_UNSUPPORTED;
 labels[0].access=1;labels[0].extent=1;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==0;
 labels[0].extent=1024;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==0;
 f=SC_fixture();labels[0]=AgLabel.{name="x",type="u64",extent=1};r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].extent=0;labels[0].access=1;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
}
#test "view access stays attached to a borrowed region" {
 f:=AG_fixture();env:[1]AgEnv;state:[1]ScAudit;memory:[1]AgMemory;
 env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=8,region=1}};memory[0].used=1;memory[0].readonly[1]=true;
 AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[..],7,AgValue.{mask=2},23,env[..],memory[..],state[..]);#assert state[0].error==SC_UNSUPPORTED && memory[0].taint[1]==0;
 state[0]=ScAudit.{};memory[0].readonly[1]=false;AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[..],7,AgValue.{mask=2},23,env[..],memory[..],state[..]);#assert state[0].error==0 && memory[0].taint[1]==2 && memory[0].dirty[1];
}
#test "public-only procedures do not accept secret inputs and forbidden names remain forbidden" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="u64"}];
 f.nodes[2].name="candidate_public";f.types[0].procedure="candidate_public";
 public:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate_public",memory[..],0,labels[..],false);
 secret:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate_public",memory[..],1,labels[..],false);
 #assert public.error==0 && secret.error==SC_VARTIME;
 f.nodes[2].name="candidate_vartime";f.types[0].procedure="candidate_vartime";
 forbidden:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate_vartime",memory[..],0,labels[..],false);#assert forbidden.error==SC_VARTIME;
}
#test "public calls require opt-in and forbidden callees stay forbidden" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="u64"}];
 f.nodes[2].next=9;f.nodes[7]=ScNode.{kind=21,name="helper_public",head=8};f.nodes[8]=ScNode.{kind=20,name="x"};
 f.nodes[9]=ScNode.{kind=64,name="helper_public",line=2,a=3,b=10,head=11};f.nodes[10]=ScNode.{kind=40,head=12};f.nodes[11]=ScNode.{kind=68,name="y",line=2,a=3};f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=20,name="y"};
 f.types[1]=ScType.{procedure="helper_public",procedure_line=2,name="y",line=2,role="parameter",type="u64"};
 legacy:=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<2],"candidate",memory[..],0,labels[..],false);#assert legacy.error==SC_VARTIME;
 public:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<2],"candidate",memory[..],0,labels[..],false);#assert public.error==0;
 f.nodes[7].name="helper_vartime";f.nodes[9].name="helper_vartime";f.types[1].procedure="helper_vartime";
 forbidden:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<2],"candidate",memory[..],0,labels[..],false);#assert forbidden.error==SC_VARTIME;
 // The forbidden-name gate runs even when no declaration exists.
 f.nodes[7]=ScNode.{kind=21,name="missing_vartime"};env:[1]AgEnv;state:[1]ScAudit;memory[0]=AgMemory.{public_views=true};
 ignored:=AG_call(f.nodes[..],values[..],f.roots[..],f.types[0..<2],7,env[..],memory[..],state[..],0);#assert state[0].error==SC_VARTIME;
}
#test "aggregate source bounds and scalar identities are explicit" {
 #assert AG_primitive("u64")==-1 && AG_primitive("u32")==-2 && AG_primitive("bool")==-3 && AG_primitive("int")==-4 && AG_primitive("u8")==-5;
 #assert AG_primitive("f64")==0 && AG_primitive("string")==0;
 #assert AG_interval(0,4096) && !AG_interval(-1,1) && !AG_interval(0,4097) && !AG_interval(2,1);
}
#test "classified root requires exact parameter names types and mask width" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="u64"}];
 public:=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],0,labels[..],false);
 secret:=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);
 #assert public.error==0 && public.return_mask==0 && secret.error==0 && secret.return_mask==1;
 #assert AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],2,labels[..],false).error==SC_ENTRY;
 labels[0].name="wrong";wrong:=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],0,labels[..],false);#assert wrong.error==SC_TYPE && wrong.unit== -1;
 labels[0].name="x";labels[0].type="u32";#assert AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],0,labels[..],false).error==SC_TYPE;
 #assert AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],0,labels[0..<0],false).error==SC_TYPE;
}
#test "classified public branches analyze both returns and protect prior bindings" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="u64"}];
 f.nodes[6]=ScNode.{kind=45,a=7,c=8,d=9};f.nodes[7]=ScNode.{kind=20,name="x"};
 f.nodes[8]=ScNode.{kind=40,head=10};f.nodes[9]=ScNode.{kind=40,head=12};
 f.nodes[10]=ScNode.{kind=44,a=11};f.nodes[11]=ScNode.{kind=16};
 f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=20,name="x"};
 r:=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],0,labels[..],false);
 #assert r.error==0 && r.return_mask==0;
 state:[1]ScAudit;#assert AG_readonly_expr(f.nodes[..],13,state[..],0) && AG_readonly_block(f.nodes[..],8,state[..],0);
 f.nodes[10]=ScNode.{kind=43,a=11,c=13,op=23};
 r=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],0,labels[..],false);#assert r.error==SC_UNSUPPORTED;
}
#test "read-only expression scanner checks every operand and depth" {
 nodes:[16]ScNode;state:[1]ScAudit;nodes[1]=ScNode.{kind=16};nodes[2]=ScNode.{kind=18};nodes[3]=ScNode.{kind=20};nodes[4]=ScNode.{kind=21};
 #assert AG_readonly_expr(nodes[..],1,state[..],0) && AG_readonly_expr(nodes[..],2,state[..],0) && AG_readonly_expr(nodes[..],3,state[..],0);
 #assert !AG_readonly_expr(nodes[..],0,state[..],0) && !AG_readonly_expr(nodes[..],4,state[..],0) && !AG_readonly_expr(nodes[..],1,state[..],32);
 for kind:[3]u32.[22,25,30] {nodes[5]=ScNode.{kind=kind,a=1};#assert AG_readonly_expr(nodes[..],5,state[..],0);#assert AG_readonly_expr(nodes[..],5,state[..],30);#assert !AG_readonly_expr(nodes[..],5,state[..],31);nodes[5].a=4;#assert !AG_readonly_expr(nodes[..],5,state[..],0);}
 for kind:[2]u32.[23,26] {nodes[5]=ScNode.{kind=kind,a=1,b=2};#assert AG_readonly_expr(nodes[..],5,state[..],0);#assert AG_readonly_expr(nodes[..],5,state[..],30);#assert !AG_readonly_expr(nodes[..],5,state[..],31);nodes[5].a=4;#assert !AG_readonly_expr(nodes[..],5,state[..],0);nodes[5].a=1;nodes[5].b=4;#assert !AG_readonly_expr(nodes[..],5,state[..],0);}
 nodes[5]=ScNode.{kind=31,a=1,b=2,c=3};#assert AG_readonly_expr(nodes[..],5,state[..],0);#assert AG_readonly_expr(nodes[..],5,state[..],30);#assert !AG_readonly_expr(nodes[..],5,state[..],31);
 nodes[5].a=4;#assert !AG_readonly_expr(nodes[..],5,state[..],0);nodes[5].a=1;nodes[5].b=4;#assert !AG_readonly_expr(nodes[..],5,state[..],0);nodes[5].b=2;nodes[5].c=4;#assert !AG_readonly_expr(nodes[..],5,state[..],0);
 state[0].visits=262144;#assert !AG_readonly_expr(nodes[..],1,state[..],0) && state[0].error==SC_LIMIT;
}
#test "read-only loop scanner rejects writes calls and invalid structure" {
 nodes:[16]ScNode;state:[1]ScAudit;nodes[1]=ScNode.{kind=40};nodes[3]=ScNode.{kind=16};nodes[4]=ScNode.{kind=21};nodes[5]=ScNode.{kind=40};
 #assert AG_readonly_block(nodes[..],1,state[..],0) && !AG_readonly_block(nodes[..],0,state[..],0) && !AG_readonly_block(nodes[..],3,state[..],0) && !AG_readonly_block(nodes[..],1,state[..],16);
 nodes[1].head=2;nodes[2]=ScNode.{kind=42};#assert AG_readonly_block(nodes[..],1,state[..],0);nodes[2].a=3;#assert AG_readonly_block(nodes[..],1,state[..],0);nodes[2].a=4;#assert !AG_readonly_block(nodes[..],1,state[..],0);
 nodes[2]=ScNode.{kind=44,a=3};#assert AG_readonly_block(nodes[..],1,state[..],0);nodes[2].a=4;#assert !AG_readonly_block(nodes[..],1,state[..],0);
 nodes[2]=ScNode.{kind=45,a=3,c=5};#assert AG_readonly_block(nodes[..],1,state[..],0);#assert AG_readonly_block(nodes[..],1,state[..],14);#assert !AG_readonly_block(nodes[..],1,state[..],15);
 nodes[2].a=4;#assert !AG_readonly_block(nodes[..],1,state[..],0);nodes[2].a=3;nodes[2].c=3;#assert !AG_readonly_block(nodes[..],1,state[..],0);nodes[2].c=5;nodes[2].d=5;#assert AG_readonly_block(nodes[..],1,state[..],0);nodes[2].d=3;#assert !AG_readonly_block(nodes[..],1,state[..],0);
 nodes[2]=ScNode.{kind=43};#assert !AG_readonly_block(nodes[..],1,state[..],0);
 state[0].visits=262144;#assert !AG_readonly_block(nodes[..],1,state[..],0) && state[0].error==SC_LIMIT;
}
#test "public return joins preserve origins and protected scope" {
 memory:[1]AgMemory;a:=AgBlock.{possible=true,value=AgValue.{mask=1,type=-1}};b:=AgBlock.{possible=true,returned=true,value=AgValue.{mask=2,type=-1}};
 both:=AG_accumulate(a,b,memory[..]);#assert both.possible && both.returned && both.value.mask==3;
 only:=AG_accumulate(AgBlock.{},b,memory[..]);#assert only.possible && only.returned && only.value.mask==2;
 neither:=AG_accumulate(a,AgBlock.{},memory[..]);#assert neither.possible && !neither.returned && neither.value.mask==1;
 f:=SC_fixture();values:[32]u64;env:[1]AgEnv;state:[1]ScAudit;env[0].count=1;env[0].binding_floor=1;memory[0].used=2;memory[0].protected_regions=1;memory[0].branch_active=3;
 f.nodes[8]=ScNode.{kind=40,head=9};f.nodes[9]=ScNode.{kind=44,a=10};f.nodes[10]=ScNode.{kind=16};
 empty:=AG_public_arm(f.nodes[..],values[..],f.roots[..],f.types[0..<1],0,env[..],memory[..],state[..],0);#assert !empty.possible;
 result:=AG_public_arm(f.nodes[..],values[..],f.roots[..],f.types[0..<1],8,env[..],memory[..],state[..],0);
 #assert result.possible && result.returned && env[0].count==1 && env[0].binding_floor==1 && memory[0].protected_regions==1 && memory[0].branch_active==3;
 #assert AG_public_arm(f.nodes[..],values[..],f.roots[..],f.types[0..<1],8,env[..],memory[..],state[..],14).returned;
 state[0]=ScAudit.{};discard:=AG_public_arm(f.nodes[..],values[..],f.roots[..],f.types[0..<1],8,env[..],memory[..],state[..],15);#assert state[0].error==SC_LIMIT;
}
#test "public arm protects prior scalar and aggregate bindings at their boundaries" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;
 env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=-1,known=true,lo=1,hi=1}};
 env[0].binding_floor=1;AG_write(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,AG_number(2),23,env[..],memory[..],state[..]);#assert state[0].error==SC_UNSUPPORTED;
 state[0]=ScAudit.{};env[0].binding_floor=0;env[0].bindings[0].value.region=2;memory[0].protected_regions=2;
 AG_write(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,AG_number(2),23,env[..],memory[..],state[..]);#assert state[0].error==SC_UNSUPPORTED;
 state[0]=ScAudit.{};memory[0].protected_regions=1;AG_write(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,AG_number(2),23,env[..],memory[..],state[..]);#assert state[0].error==0 && env[0].bindings[0].value.lo==2;
}
#test "read-only recursion accounts for every operand at its depth limit" {
 n:[80]ScNode;s:[1]ScAudit;n[1]=ScNode.{kind=16};n[2]=ScNode.{kind=22,a=1};
 for kind:[2]u32.[23,26] {
  n[3]=ScNode.{kind=kind,a=2,b=1};#assert !AG_readonly_expr(n[..],3,s[..],30);
  n[3].a=1;n[3].b=2;#assert !AG_readonly_expr(n[..],3,s[..],30);
 }
 n[3]=ScNode.{kind=31,a=2,b=1,c=1};#assert !AG_readonly_expr(n[..],3,s[..],30);
 n[3].a=1;n[3].b=2;#assert !AG_readonly_expr(n[..],3,s[..],30);n[3].b=1;n[3].c=2;#assert !AG_readonly_expr(n[..],3,s[..],30);
 // A 31-edge expression is accepted at depth zero but not at depth one.
 for i:0..<31 {n[20+i]=ScNode.{kind=22,a=21+i};}n[51]=ScNode.{kind=16};
 n[4]=ScNode.{kind=40,head=5};
 n[5]=ScNode.{kind=42,a=20};#assert AG_readonly_block(n[..],4,s[..],0);
 n[5]=ScNode.{kind=44,a=20};#assert AG_readonly_block(n[..],4,s[..],0);
 n[5]=ScNode.{kind=45,a=20,c=6};n[6]=ScNode.{kind=40};#assert AG_readonly_block(n[..],4,s[..],0);
 // Each branch depth must advance, including an optional else.
 n[5]=ScNode.{kind=45,a=1,c=7,d=6};n[7]=ScNode.{kind=40,head=8};n[8]=ScNode.{kind=45,a=1,c=6};#assert !AG_readonly_block(n[..],4,s[..],14);
 n[5].c=6;n[5].d=7;#assert !AG_readonly_block(n[..],4,s[..],14);
 s[0]=ScAudit.{visits=262143};#assert !AG_readonly_block(n[..],4,s[..],0) && s[0].error==SC_LIMIT;
}
#test "public arm isolates prior bindings and restores fresh local scope" {
 f:=SC_fixture();values:[32]u64;env:[1]AgEnv;memory:[1]AgMemory;state:[1]ScAudit;
 env[0].procedure=2;env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AG_number(1)};
 f.nodes[8]=ScNode.{kind=40,head=9};f.nodes[9]=ScNode.{kind=43,a=10,c=7,op=23,next=11};f.nodes[10]=ScNode.{kind=16};f.nodes[11]=ScNode.{kind=44,a=10};
 fail:=AG_public_arm(f.nodes[..],values[..],f.roots[..],f.types[0..<1],8,env[..],memory[..],state[..],0);#assert state[0].error==SC_UNSUPPORTED && !fail.returned;
 state[0]=ScAudit.{};f.nodes[9]=ScNode.{kind=42,name="y",line=1,a=10,next=11};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="y",line=1,role="local",type="u64"};
 env[0].binding_floor=0;memory[0].used=2;memory[0].protected_regions=0;
 pass:=AG_public_arm(f.nodes[..],values[..],f.roots[..],f.types[0..<2],8,env[..],memory[..],state[..],0);
 #assert state[0].error==0 && pass.returned && env[0].count==1 && env[0].binding_floor==0 && memory[0].protected_regions==0;
}
#test "protected-binding boundary distinguishes equal slot and absent floor" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;
 env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=-1,known=true,lo=1,hi=1}};
 env[0].binding_floor=0;AG_write(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,AG_number(2),23,env[..],memory[..],state[..]);#assert state[0].error==0 && env[0].bindings[0].value.lo==2;
}
#test "public loop possible return does not erase continuation" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;env[0].procedure=2;env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=-1}};memory[0].classified=true;
 f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18,next=23};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};values[17]=2;
 f.nodes[18]=ScNode.{kind=40,head=19};f.nodes[19]=ScNode.{kind=45,a=7,c=20};f.nodes[20]=ScNode.{kind=40,head=21};f.nodes[21]=ScNode.{kind=44,a=22};f.nodes[22]=ScNode.{kind=16};values[22]=1;
 f.nodes[23]=ScNode.{kind=44,a=24};f.nodes[24]=ScNode.{kind=16};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);
 #assert state[0].error==0 && r.returned && r.possible && r.value.known && r.value.lo==0 && r.value.hi==1;
 env[0].count=1;memory[0].branch_active=1;state[0]=ScAudit.{};r=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==SC_UNSUPPORTED;
}
#test "one public arm return leaves the other continuation reachable" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;env[0].procedure=2;env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=-1}};memory[0].classified=true;
 f.nodes[6]=ScNode.{kind=45,a=7,c=8,next=12};f.nodes[8]=ScNode.{kind=40,head=9};f.nodes[9]=ScNode.{kind=44,a=10};f.nodes[10]=ScNode.{kind=16};values[10]=1;
 f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=16};
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<1],4,env[..],memory[..],state[..],0);
 #assert state[0].error==0 && r.returned && r.possible && r.value.known && r.value.lo==0 && r.value.hi==1;
}
#test "scanner checks each expression operand independently at the limit" {
 n:[80]ScNode;s:[1]ScAudit;n[1]=ScNode.{kind=16};n[2]=ScNode.{kind=22,a=1};
 for kind:[2]u32.[23,26] {n[3]=ScNode.{kind=kind,a=2,b=1};#assert !AG_readonly_expr(n[..],3,s[..],30);n[3].a=1;n[3].b=2;#assert !AG_readonly_expr(n[..],3,s[..],30);}
 n[3]=ScNode.{kind=31,a=2,b=1,c=1};#assert !AG_readonly_expr(n[..],3,s[..],30);n[3].a=1;n[3].b=2;#assert !AG_readonly_expr(n[..],3,s[..],30);n[3].b=1;n[3].c=2;#assert !AG_readonly_expr(n[..],3,s[..],30);
 n[1]=ScNode.{kind=21};n[4]=ScNode.{kind=40,head=5};n[5]=ScNode.{kind=42,a=1};#assert !AG_readonly_block(n[..],4,s[..],0);
}
#test "public arms reject a fresh view that aliases a prior region" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;
 f.nodes[8]=ScNode.{kind=40,head=9};f.nodes[9]=ScNode.{kind=42,name="v",line=1,a=16,next=11};
 f.nodes[11]=ScNode.{kind=43,a=10,c=18,op=23};f.nodes[10]=ScNode.{kind=16};f.nodes[14]=ScNode.{kind=3,b=3};f.nodes[15]=ScNode.{kind=2,a=19,b=3};
 f.nodes[16]=ScNode.{kind=27,a=7};f.nodes[17]=ScNode.{kind=20,name="v"};f.nodes[18]=ScNode.{kind=26,a=17,b=10};f.nodes[19]=ScNode.{kind=16};values[19]=1;
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="v",line=1,role="local",type="[]u64"};
 env[0].procedure=2;env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=15,region=2,extent=1}};memory[0].used=2;
 ignored:=AG_public_arm(f.nodes[..],values[..],f.roots[..],f.types[0..<2],8,env[..],memory[..],state[..],0);#assert state[0].error==SC_UNSUPPORTED && !memory[0].dirty[2];
 state[0]=ScAudit.{};env[0].count=1;memory[0].protected_regions=0;ignored=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],8,env[..],memory[..],state[..],0);#assert state[0].error==0 && memory[0].dirty[2];
}
#test "public control joins cover else-only returns and definite loop returns" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;env[0].procedure=2;env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=-1}};memory[0].classified=true;
 f.nodes[6]=ScNode.{kind=45,a=7,c=11,d=8,next=12};f.nodes[11]=ScNode.{kind=40};f.nodes[8]=ScNode.{kind=40,head=9};f.nodes[9]=ScNode.{kind=44,a=10};f.nodes[10]=ScNode.{kind=16};values[10]=1;f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=16};
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<1],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.returned && r.value.known && r.value.lo==0 && r.value.hi==1;
 f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18,next=12};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};values[17]=2;f.nodes[18]=ScNode.{kind=40,head=9};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};
 state[0]=ScAudit.{};r=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.returned && r.value.known && r.value.lo==0 && r.value.hi==1;
}
#test "else scanner advances exactly one level" {
 n:[12]ScNode;s:[1]ScAudit;n[1]=ScNode.{kind=16};n[2]=ScNode.{kind=40,head=3};n[3]=ScNode.{kind=45,a=1,c=4,d=4};n[4]=ScNode.{kind=40};
 #assert AG_readonly_block(n[..],2,s[..],14) && !AG_readonly_block(n[..],2,s[..],15);
}
