AG_readonly_expr :: (nodes:[]ScNode,id:int,state:[]ScAudit,depth:int)->bool {
 if id==0 || depth>=32 || !AG_tick(state,id) {return false;}n:=nodes[id];
 if n.kind==16 || n.kind==18 || n.kind==20 {return true;}
 if n.kind==22 || n.kind==25 || n.kind==30 {return AG_readonly_expr(nodes,n.a,state,depth+1);}
 if n.kind==23 || n.kind==26 {return AG_readonly_expr(nodes,n.a,state,depth+1) && AG_readonly_expr(nodes,n.b,state,depth+1);}
 if n.kind==31 {return AG_readonly_expr(nodes,n.a,state,depth+1) && AG_readonly_expr(nodes,n.b,state,depth+1) && AG_readonly_expr(nodes,n.c,state,depth+1);}
 return false;
}
AG_readonly_block :: (nodes:[]ScNode,id:int,state:[]ScAudit,depth:int)->bool {
 if id==0 || depth>=16 || !AG_tick(state,id) || nodes[id].kind!=40 {return false;}
 at:=nodes[id].head;while at!=0 {if !AG_tick(state,at) {return false;}n:=nodes[at];
  if n.kind==42 {if n.a!=0 && !AG_readonly_expr(nodes,n.a,state,0) {return false;}}
  else if n.kind==44 {if !AG_readonly_expr(nodes,n.a,state,0) {return false;}}
  else if n.kind==45 {if !AG_readonly_expr(nodes,n.a,state,0) || !AG_readonly_block(nodes,n.c,state,depth+1) {return false;}if n.d!=0 && !AG_readonly_block(nodes,n.d,state,depth+1) {return false;}}
  else {return false;}at=n.next;
 }return true;
}
AG_accumulate :: (base:AgBlock,part:AgBlock,memory:[]AgMemory)->AgBlock {
 r:=base;if part.possible {if r.possible {r.value=AG_union(r.value,part.value,memory);}else {r.value=part.value;}r.possible=true;}r.returned=part.returned;return r;
}
// Unknown public arms may create and mutate fresh locals only. Pre-existing
