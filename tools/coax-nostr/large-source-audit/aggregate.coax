 for i:0..<8 {nodes[2+i]=ScNode.{kind=69,name=names[i],a=11,next=ifx i==7 then 0 else 3+i};}nodes[11]=ScNode.{kind=1,name="u64"};
 labels:[8]AgLabel;for i:0..<8 {labels[i]=AgLabel.{name=names[i],type="V",access=3};}args:=[1]AgValue.[AgValue.{mask=1,region=1}];memory:[1]AgMemory;memory[0].used=1;state:[1]ScAudit;
 AG_public_fields(nodes[..],roots[..],labels[..],args[..],memory[..],state[..]);#assert state[0].error==0 && memory[0].field_count==8 && memory[0].shadow_count==8 && memory[0].fields[0]==2;
