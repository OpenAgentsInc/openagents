// Separate aggregate source analysis. It never upgrades the scalar-v1 profile.
#load "inventory.coax";
#load "../../../coax/tests/nostr/secret_aggregate.coax";
#load "../../../coax/tests/nostr/secret_aggregate_cases.coax";
#load "../../../coax/tests/nostr/secret_range_cases.coax";
#load "../../../coax/tests/nostr/secret_field_cases.coax";
#authority;
AG_GUARDS :: 14;
AgValue :: struct {mask:u64;type:int;literal:int;lo:int;hi:int;known:bool;region:int;extent:int;view:bool;ranged:bool;rlo:u64;rhi:u64;}
AgBinding :: struct {name:string;value:AgValue;induction:bool;}
AgEnv :: struct {bindings:[64]AgBinding;count:int;procedure:int;binding_floor:int;}
AgGuard :: struct {node:int;unit:int;line:int;column:int;mask:u64;kind:u32;}
AgMemo :: struct {procedure:int;count:int;args:[8]AgValue;result:AgValue;closure:u64;height:int;}
AgMemory :: struct {taint:[4096]u64;dirty:[4096]bool;readonly:[4096]bool;used:int;guard_count:int;guards:[256]AgGuard;memo:[128]AgMemo;memo_count:int;scope:[16]u64;height:[16]int;compiled_runs:bool;classified:bool;public_views:bool;branch_active:int;protected_regions:int;fields:[8]int;structs:[8]int;field_count:int;shadow_base:[64]int;shadow_field:[64]int;shadow_struct:[64]int;shadow_region:[64]int;shadow_count:int;}
AgBlock :: struct {value:AgValue;returned:bool;possible:bool;}
AgLabel :: struct {name:string;type:string;extent:int;access:u32;}
#test "opt-in view roots require explicit bounded region and access" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="[] u64",extent=2,access=1}];
 f.nodes[5].a=10;f.nodes[10]=ScNode.{kind=3,b=3};f.types[0].type="[] u64";f.nodes[7]=ScNode.{kind=16};
 r:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);
 #assert r.error==0 && memory[0].used==1 && memory[0].readonly[1] && memory[0].taint[1]==1;
 labels[0].extent=0;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].extent=2;labels[0].access=0;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].access=2;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==0 && !memory[0].readonly[1];
 labels[0].extent=1025;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].extent=2;labels[0].access=3;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 r=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_UNSUPPORTED;
 labels[0].access=1;labels[0].extent=1;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==0;
 labels[0].extent=1024;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==0;
 f=SC_fixture();labels[0]=AgLabel.{name="x",type="u64",extent=1};r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
 labels[0].extent=0;labels[0].access=1;r=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],1,labels[..],false);#assert r.error==SC_TYPE;
}
#test "view access stays attached to a borrowed region" {
 f:=AG_fixture();env:[1]AgEnv;state:[1]ScAudit;memory:[1]AgMemory;
 env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=8,region=1}};memory[0].used=1;memory[0].readonly[1]=true;
 AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[..],7,AgValue.{mask=2},23,env[..],memory[..],state[..]);#assert state[0].error==SC_UNSUPPORTED && memory[0].taint[1]==0;
 state[0]=ScAudit.{};memory[0].readonly[1]=false;AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[..],7,AgValue.{mask=2},23,env[..],memory[..],state[..]);#assert state[0].error==0 && memory[0].taint[1]==2 && memory[0].dirty[1];
}
#test "public-only procedures do not accept secret inputs and forbidden names remain forbidden" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="u64"}];
 f.nodes[2].name="candidate_public";f.types[0].procedure="candidate_public";
 public:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate_public",memory[..],0,labels[..],false);
 secret:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate_public",memory[..],1,labels[..],false);
 #assert public.error==0 && secret.error==SC_VARTIME;
 f.nodes[2].name="candidate_vartime";f.types[0].procedure="candidate_vartime";
 forbidden:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate_vartime",memory[..],0,labels[..],false);#assert forbidden.error==SC_VARTIME;
}
#test "public calls require opt-in and forbidden callees stay forbidden" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;labels:=[1]AgLabel.[AgLabel.{name="x",type="u64"}];
 f.nodes[2].next=9;f.nodes[7]=ScNode.{kind=21,name="helper_public",head=8};f.nodes[8]=ScNode.{kind=20,name="x"};
 f.nodes[9]=ScNode.{kind=64,name="helper_public",line=2,a=3,b=10,head=11};f.nodes[10]=ScNode.{kind=40,head=12};f.nodes[11]=ScNode.{kind=68,name="y",line=2,a=3};f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=20,name="y"};
 f.types[1]=ScType.{procedure="helper_public",procedure_line=2,name="y",line=2,role="parameter",type="u64"};
 legacy:=AG_check_classified(f.nodes[..],values[..],f.roots[..],f.types[0..<2],"candidate",memory[..],0,labels[..],false);#assert legacy.error==SC_VARTIME;
 public:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<2],"candidate",memory[..],0,labels[..],false);#assert public.error==0;
 f.nodes[7].name="helper_vartime";f.nodes[9].name="helper_vartime";f.types[1].procedure="helper_vartime";
 forbidden:=AG_check_public_views(f.nodes[..],values[..],f.roots[..],f.types[0..<2],"candidate",memory[..],0,labels[..],false);#assert forbidden.error==SC_VARTIME;
 // The forbidden-name gate runs even when no declaration exists.
 f.nodes[7]=ScNode.{kind=21,name="missing_vartime"};env:[1]AgEnv;state:[1]ScAudit;memory[0]=AgMemory.{public_views=true};
 ignored:=AG_call(f.nodes[..],values[..],f.roots[..],f.types[0..<2],7,env[..],memory[..],state[..],0);#assert state[0].error==SC_VARTIME;
}
#test "range facts follow types, literals and explicit bounds" {
 #assert AG_max(-1)==0xFFFFFFFFFFFFFFFF && AG_max(-2)==4294967295 && AG_max(-5)==255 && AG_max(-3)==1 && AG_max(-4)==0 && AG_max(0)==0;
 #assert AG_unsigned(-1) && AG_unsigned(-2) && AG_unsigned(-5) && AG_unsigned(-3) && !AG_unsigned(-4) && !AG_unsigned(0) && !AG_unsigned(-6);
 #assert AG_width(-1)==64 && AG_width(-2)==32 && AG_width(-5)==8 && AG_width(-3)==0 && AG_width(-4)==0;
 u:=AgValue.{type=-2};i:=AgValue.{type=-4};#assert AG_bounded(u) && !AG_bounded(i) && AG_hi(u)==4294967295 && AG_lo(u)==0;
 r:=AG_with(u,3,9);#assert r.ranged && AG_lo(r)==3 && AG_hi(r)==9 && AG_bounded(AG_with(i,1,1));
 x:=AG_unranged(r);#assert !x.ranged && x.rlo==0 && x.rhi==0 && AG_hi(x)==4294967295;
 #assert AG_fill(0)==0 && AG_fill(1)==1 && AG_fill(2)==3 && AG_fill(4)==7 && AG_fill(7)==7 && AG_fill(4294967296)==8589934591 && AG_fill(0xFFFFFFFFFFFFFFFF)==0xFFFFFFFFFFFFFFFF;
 for k:0..<64 {bit:=cast(u64)1<<cast(u64)k;#assert AG_fill(bit)==bit|(bit-1) && AG_fill(bit|1)==bit|(bit-1);}
}
#test "ranges survive bindings and casts only where the value is unchanged" {
 lit:=AG_with(AgValue.{type=-4},4294967296,4294967296);u64:=AG_with(AgValue.{type=-1},0,1);u32:=AG_with(AgValue.{type=-2},0,4294967295);
 #assert AG_keeps(lit,-1) && !AG_keeps(lit,-2) && AG_keeps(u64,-1) && !AG_keeps(u64,-2) && !AG_keeps(u64,-4) && !AG_keeps(u64,-3);
 #assert !AG_keeps(AgValue.{type=-1},-1) && AG_keeps(AG_with(AgValue.{type=-5},0,255),-5) && !AG_keeps(AG_with(AgValue.{type=-1},0,256),-5);
 #assert AG_keeps(AG_with(AgValue.{type=-2},0,7),-2) && AG_keeps(AG_with(AgValue.{type=-4},0,7),-2) && !AG_keeps(AG_with(AgValue.{type=-3},0,1),-3);
 #assert AG_fits(u64,-2) && AG_fits(u64,-5) && !AG_fits(u64,-1) && !AG_fits(u64,-3) && !AG_fits(u64,-4) && AG_fits(u32,-1) && !AG_fits(u32,-5);
 #assert AG_fits(lit,-1) && !AG_fits(lit,-2) && !AG_fits(AgValue.{type=-4},-1) && !AG_fits(AgValue.{type=-1},-2) && AG_fits(AgValue.{type=-5},-2);
 #assert !AG_fits(AG_with(AgValue.{type=-3},0,1),-1) && !AG_fits(AG_with(AgValue.{type=-1},0,4294967296),-2) && AG_fits(AG_with(AgValue.{type=-1},0,4294967295),-2);
}
#test "secret checked arithmetic is admitted only when its range excludes the trap" {
 base:=AG_with(AgValue.{type=-1},4294967296,4294967296);limb:=AgValue.{type=-2};wide:=AG_with(AgValue.{type=-1},0,4294967295);bit:=AG_with(AgValue.{type=-1},0,1);
 #assert AG_no_trap(base,wide,34,-1) && !AG_no_trap(AgValue.{type=-1},bit,34,-1) && AG_no_trap(AG_with(AgValue.{type=-1},0,0xFFFFFFFFFFFFFFFE),bit,34,-1);
 #assert !AG_no_trap(AG_with(AgValue.{type=-1},0,0xFFFFFFFFFFFFFFFF),bit,34,-1);
 #assert AG_no_trap(base,wide,35,-1) && !AG_no_trap(wide,bit,35,-1) && AG_no_trap(AG_with(AgValue.{type=-1},1,2),bit,35,-1) && !AG_no_trap(AG_with(AgValue.{type=-1},0,2),bit,35,-1);
 #assert !AG_no_trap(bit,bit,36,-1) && AG_no_trap(AG_with(AgValue.{type=-2},0,65535),AG_with(AgValue.{type=-2},0,65537),36,-2);
 #assert !AG_no_trap(AG_with(AgValue.{type=-2},0,65536),AG_with(AgValue.{type=-2},0,65536),36,-2) && AG_no_trap(limb,AG_with(AgValue.{type=-2},0,0),36,-2);
 #assert !AG_no_trap(bit,bit,37,-1) && !AG_no_trap(bit,bit,38,-1) && !AG_no_trap(bit,bit,39,-1) && !AG_no_trap(bit,bit,34,-3) && !AG_no_trap(bit,bit,34,-4);
 max:=AG_with(AgValue.{type=-1},0,0xFFFFFFFFFFFFFFFF);zero:=AG_with(AgValue.{type=-1},0,0);izero:=AG_with(AgValue.{type=-4},0,0);
 #assert AG_no_trap(max,zero,34,-1) && AG_no_trap(zero,max,34,-1) && !AG_no_trap(izero,izero,34,-4) && !AG_no_trap(AG_with(AgValue.{type=-3},0,0),zero,34,-3);
 #assert AG_no_trap(AG_with(AgValue.{type=-2},0,5),AG_with(AgValue.{type=-2},0,5),34,-2);
 #assert !AG_no_trap(AgValue.{type=-4},bit,34,-1) && !AG_no_trap(bit,AgValue.{type=-4},34,-1) && !AG_no_trap(AG_with(AgValue.{type=-1},0,256),bit,34,-5) && !AG_no_trap(bit,AG_with(AgValue.{type=-1},0,256),34,-5);
 #assert AG_no_trap(AG_with(AgValue.{type=-5},0,254),AG_with(AgValue.{type=-5},0,1),34,-5) && !AG_no_trap(AG_with(AgValue.{type=-5},0,255),AG_with(AgValue.{type=-5},0,1),34,-5);
}
#test "binary ranges are sound for arithmetic, masks and public shifts" {
 r:=AgValue.{type=-1};a:=AG_with(r,2,10);b:=AG_with(r,1,3);k:=AgValue.{type=-4,lo=4,hi=4,known=true};
 s:=AG_binary_range(a,b,34,r);#assert s.ranged && s.rlo==3 && s.rhi==13;
 s=AG_binary_range(a,AG_with(r,1,2),35,r);#assert s.ranged && s.rlo==0 && s.rhi==9;s=AG_binary_range(a,b,35,r);#assert !s.ranged;
 s=AG_binary_range(b,a,35,r);#assert !s.ranged;
 s=AG_binary_range(a,b,36,r);#assert s.ranged && s.rlo==2 && s.rhi==30;
 s=AG_binary_range(a,AG_with(r,0,0),36,r);#assert s.ranged && s.rhi==0;s=AG_binary_range(AG_with(r,0,0),AgValue.{type=-1},36,r);#assert s.ranged && s.rhi==0;
 s=AG_binary_range(AgValue.{type=-1},AG_with(r,2,2),36,r);#assert !s.ranged;
 s=AG_binary_range(a,b,39,r);#assert s.ranged && s.rlo==0 && s.rhi==3;s=AG_binary_range(a,b,40,r);#assert s.ranged && s.rlo==0 && s.rhi==15;s=AG_binary_range(a,b,41,r);#assert s.ranged && s.rlo==0 && s.rhi==15;
 s=AG_binary_range(AG_with(r,3,10),b,40,r);#assert s.rlo==0;s=AG_binary_range(AG_with(r,3,10),b,41,r);#assert s.rlo==0;s=AG_binary_range(AG_with(r,3,10),b,39,r);#assert s.rlo==0;
 z:=AgValue.{type=-4,lo=0,hi=0,known=true};s=AG_binary_range(a,z,43,r);#assert s.ranged && s.rlo==2 && s.rhi==10;s=AG_binary_range(a,z,42,r);#assert s.ranged && s.rlo==2 && s.rhi==10;
 s=AG_binary_range(AG_with(r,0,0xFFFFFFFFFFFFFFFA),AG_with(r,0,5),34,r);#assert s.ranged && s.rhi==0xFFFFFFFFFFFFFFFF;s=AG_binary_range(AG_with(r,3,10),AG_with(r,0,0),36,r);#assert s.ranged && s.rlo==0 && s.rhi==0;
 i0:=AG_with(AgValue.{type=-4},0,0);s=AG_binary_range(i0,i0,34,AgValue.{type=-4});#assert !s.ranged;s=AG_binary_range(AG_with(r,0,1),AG_with(r,0,1),39,AgValue.{type=-3});#assert !s.ranged;
 w:=AgValue.{type=-2};s=AG_binary_range(AG_with(w,0,9),AG_with(w,0,6),34,w);#assert s.ranged && s.rhi==15;
 s=AG_binary_range(a,b,37,r);#assert !s.ranged;s=AG_binary_range(a,b,44,AgValue.{type=-3});#assert !s.ranged;
 s=AG_binary_range(a,k,42,r);#assert s.ranged && s.rlo==32 && s.rhi==160;s=AG_binary_range(a,k,43,r);#assert s.ranged && s.rlo==0 && s.rhi==0;
 s=AG_binary_range(AG_with(r,32,320),AgValue.{type=-4,lo=2,hi=4,known=true},43,r);#assert s.ranged && s.rlo==2 && s.rhi==80;
 s=AG_binary_range(a,AgValue.{type=-4,lo=2,hi=4,known=true},42,r);#assert !s.ranged;
 s=AG_binary_range(AgValue.{type=-1},k,42,r);#assert !s.ranged;s=AG_binary_range(AgValue.{type=-1},AgValue.{type=-4,lo=32,hi=32,known=true},43,r);#assert s.ranged && s.rhi==4294967295;
 s=AG_binary_range(a,AgValue.{type=-4,lo=64,hi=64,known=true},43,r);#assert !s.ranged;s=AG_binary_range(a,AgValue.{type=-4},43,r);#assert !s.ranged;
 s=AG_binary_range(a,AgValue.{type=-4,lo= -1,hi=1,known=true},43,r);#assert !s.ranged;
 s=AG_binary_range(AG_with(r,0,0xFFFFFFFFFFFFFFFF),b,34,r);#assert !s.ranged;s=AG_binary_range(a,AgValue.{type=-4},34,r);#assert !s.ranged;
 s=AG_binary_range(AgValue.{type=-4},b,34,AgValue.{type=-4});#assert !s.ranged;
 u8:=AgValue.{type=-5};s=AG_binary_range(AG_with(u8,0,300),AG_with(u8,0,1),34,u8);#assert !s.ranged;s=AG_binary_range(AG_with(u8,0,3),AG_with(u8,0,300),34,u8);#assert !s.ranged;
 s=AG_binary_range(AG_with(u8,0,200),AG_with(u8,0,100),34,u8);#assert !s.ranged;s=AG_binary_range(AG_with(u8,0,15),AgValue.{type=-4,lo=4,hi=4,known=true},42,u8);#assert s.ranged && s.rhi==240;
 s=AG_binary_range(AG_with(u8,0,16),AgValue.{type=-4,lo=4,hi=4,known=true},42,u8);#assert !s.ranged;
 s=AG_binary_range(AG_with(r,5,5),AG_with(r,7,7),36,r);#assert s.rlo==35 && s.rhi==35;s=AG_binary_range(AG_with(r,0,0xFFFFFFFF),AG_with(r,0,0x100000002),36,r);#assert !s.ranged;s=AG_binary_range(AG_with(r,0,0xFFFFFFFF),AG_with(r,0,0x100000001),36,r);#assert s.ranged && s.rhi==0xFFFFFFFFFFFFFFFF;
}
#test "bindings and unions carry ranges only when both sides are bounded" {
 nodes:[1]ScNode;values:[1]u64;roots:[1]int;memory:[1]AgMemory;state:[1]ScAudit;
 v:=AG_new(nodes[..],values[..],roots[0..<0],AG_with(AgValue.{type=-1},0,5),-1,memory[..],state[..]);#assert v.ranged && v.rhi==5 && v.type==-1;
 v=AG_new(nodes[..],values[..],roots[0..<0],AG_with(AgValue.{type=-1},0,5),-2,memory[..],state[..]);#assert !v.ranged && v.type==-2;
 v=AG_new(nodes[..],values[..],roots[0..<0],AG_with(AgValue.{type=-4},3,3),-2,memory[..],state[..]);#assert v.ranged && v.rlo==3 && v.type==-2 && state[0].error==0;
 u:=AG_union(AG_with(AgValue.{type=-1},4,5),AG_with(AgValue.{type=-1},6,9),memory[..]);#assert u.ranged && u.rlo==4 && u.rhi==15;
 u=AG_union(AG_with(AgValue.{type=-1},4,5),AgValue.{type=-4},memory[..]);#assert !u.ranged;u=AG_union(AgValue.{type=-4},AG_with(AgValue.{type=-1},4,5),memory[..]);#assert !u.ranged;
 u=AG_union(AgValue.{type=-1},AG_with(AgValue.{type=-4},0,1),memory[..]);#assert u.ranged && u.rhi==0xFFFFFFFFFFFFFFFF;u=AG_union(AgValue.{type=-4},AgValue.{type=-4},memory[..]);#assert !u.ranged;
 u=AG_union(AG_with(AgValue.{type=-4},2,2),AG_with(AgValue.{type=-1},8,8),memory[..]);#assert u.ranged && u.rlo==0 && u.rhi==15;
}
#test "loop ranges widen to all-ones steps and only shrink by assumption" {
 r:=AgValue.{type=-1};s:=AG_with(r,0,0);
 #assert AG_inside(AG_with(r,0,0),s) && !AG_inside(AG_with(r,0,1),s) && !AG_inside(AG_with(r,1,1),AG_with(r,2,3)) && AG_inside(AG_with(r,2,3),AG_with(r,2,3));
 #assert AG_inside(AgValue.{type=-1},AgValue.{type=-1}) && !AG_inside(AgValue.{type=-1},s) && !AG_inside(AgValue.{type=-4},s) && AG_inside(AgValue.{type=-4},AgValue.{type=-4});
 w:=AG_widen(AG_with(r,0,5),AG_with(r,0,0xFFFFFFFFFFFFFFFF));#assert w.ranged && w.rhi==0xFFFFFFFFFFFFFFFF;
 w=AG_widen(s,AG_with(r,0,1));#assert w.ranged && w.rlo==0 && w.rhi==1;w=AG_widen(AG_with(r,5,6),AG_with(r,1,9));#assert w.ranged && w.rlo==1 && w.rhi==15;
 w=AG_widen(AG_with(r,5,6),AG_with(r,7,9));#assert w.ranged && w.rlo==5 && w.rhi==15;
 w=AG_widen(s,AgValue.{type=-4});#assert !w.ranged;w=AG_widen(AgValue.{type=-1},AG_with(r,0,1));#assert !w.ranged;
 b:=AgValue.{type=-5};w=AG_widen(AG_with(b,0,200),AG_with(b,0,256));#assert !w.ranged;w=AG_widen(AG_with(AgValue.{type=-4},0,1),AG_with(AgValue.{type=-4},0,0x100000000));#assert w.ranged && w.rhi==0x1FFFFFFFF;
}
#test "range-decided comparisons are public constants and undecided ones are not" {
 r:=AgValue.{type=-1};a:=AG_with(r,0,4294967295);big:=AG_with(AgValue.{type=-4},4294967295,4294967295);five:=AG_with(r,5,5);
 #assert AG_decide(a,big,48)==0 && AG_decide(big,a,49)==1 && AG_decide(a,big,47)==1 && AG_decide(big,a,46)==0;
 #assert AG_decide(AG_with(r,6,9),five,48)==1 && AG_decide(AG_with(r,5,9),five,48)==-1 && AG_decide(AG_with(r,0,5),five,48)==0 && AG_decide(AG_with(r,0,6),five,48)==-1;
 #assert AG_decide(AG_with(r,0,4),five,46)==1 && AG_decide(AG_with(r,0,5),five,46)==-1 && AG_decide(AG_with(r,5,9),five,46)==0 && AG_decide(AG_with(r,4,9),five,46)==-1;
 #assert AG_decide(AG_with(r,0,5),five,47)==1 && AG_decide(AG_with(r,0,6),five,47)==-1 && AG_decide(AG_with(r,6,9),five,47)==0 && AG_decide(AG_with(r,5,9),five,47)==-1;
 #assert AG_decide(AG_with(r,5,9),five,49)==1 && AG_decide(AG_with(r,4,9),five,49)==-1 && AG_decide(AG_with(r,0,4),five,49)==0 && AG_decide(AG_with(r,0,5),five,49)==-1;
 #assert AG_decide(five,five,44)==1 && AG_decide(five,five,45)==0 && AG_decide(AG_with(r,6,9),five,44)==0 && AG_decide(AG_with(r,6,9),five,45)==1;
 #assert AG_decide(AG_with(r,0,4),five,44)==0 && AG_decide(AG_with(r,0,5),five,44)==-1 && AG_decide(AG_with(r,0,5),five,45)==-1 && AG_decide(five,AG_with(r,5,6),44)==-1;
 #assert AG_decide(AG_with(r,5,6),AG_with(r,5,6),44)==-1 && AG_decide(a,AgValue.{type=-4},48)==-1 && AG_decide(AgValue.{type=-4},a,48)==-1;
 #assert AG_decide(a,big,34)==-1 && AG_decide(a,big,50)==-1 && AG_decide(AgValue.{type=-3},AgValue.{type=-3},44)==-1 && AG_decide(a,AgValue.{type=-3},44)==-1;
 memory:[1]AgMemory;state:[1]ScAudit;s:=a;s.mask=1;c:=AG_binary(s,big,48,memory[..],state[..],0);#assert c.mask==0 && c.known && c.lo==0 && c.hi==0 && state[0].error==0;
 c=AG_binary(s,AG_with(AgValue.{type=-4},7,7),48,memory[..],state[..],0);#assert c.mask==1 && !(c.known && c.lo==c.hi);
}
