  if n.name=="mul_wrap" {r=AG_binary_range(args[0],args[1],36,r);}if n.name=="add_wrap" {r=AG_binary_range(args[0],args[1],34,r);}return r;
 }
 if nodes[d].kind!=64 {SC_fail(state,SC_CALL,id);return AgValue.{};}
 r:=AG_procedure(nodes,values,roots,types,d,args[0..<count],memory,state);
