 #assert AG_quiet(q[..],qv[..],roots[0..<0],4,5) && !AG_quiet(q[..],qv[..],roots[0..<0],3,7) && AG_quiet(q[..],qv[..],roots[0..<0],1,7) && !AG_quiet(q[..],qv[..],roots[0..<0],5,0);
 #assert !AG_quiet(q[..],qv[..],roots[0..<0],7,0) && !AG_quiet(q[..],qv[..],roots[0..<0],0,0);
