#test "readonly scan starts at the actual loop body depth" {
 f:=AG_fixture();env:[1]AgEnv;memory:[1]AgMemory;state:[1]ScAudit;env[0].procedure=2;env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=12,region=2}};memory[0].used=2;memory[0].classified=true;
 f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};f.values[17]=2;f.nodes[18]=ScNode.{kind=40,head=20};f.nodes[60]=ScNode.{kind=18};f.values[60]=1;
 for i:0..<15 {at:=20+2*i;f.nodes[at]=ScNode.{kind=45,a=60,c=at+1};f.nodes[at+1]=ScNode.{kind=40,head=ifx i<14 then at+2 else 0};}
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};
