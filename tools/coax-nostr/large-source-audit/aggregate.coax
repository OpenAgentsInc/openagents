#test "public-field labels are validated before any shadow is created" {
 nodes:[24]ScNode;roots:=[1]int.[1];nodes[1]=ScNode.{kind=74,head=2};nodes[2]=ScNode.{kind=66,name="W",head=3,next=6};nodes[3]=ScNode.{kind=69,name="stage",a=10,next=4};
 nodes[4]=ScNode.{kind=69,name="val",a=11,next=5};nodes[5]=ScNode.{kind=69,name="inner",a=12};nodes[6]=ScNode.{kind=66,name="I",head=7};nodes[7]=ScNode.{kind=69,name="used",a=10};
 nodes[10]=ScNode.{kind=1,name="int"};nodes[11]=ScNode.{kind=1,name="u64"};nodes[12]=ScNode.{kind=1,name="I"};
 args:=[3]AgValue.[AgValue.{mask=1,region=1},AgValue.{mask=2},AgValue.{mask=4,region=2}];
 labels:=[2]AgLabel.[AgLabel.{name="stage",type="W",access=3},AgLabel.{name="used",type="I",access=3}];
 memory:[1]AgMemory;memory[0].used=2;memory[0].readonly[2]=true;state:[1]ScAudit;
 AG_public_fields(nodes[..],roots[..],labels[..],args[..],memory[..],state[..]);
 #assert state[0].error==0 && memory[0].field_count==2 && memory[0].fields[0]==3 && memory[0].structs[0]==2 && memory[0].fields[1]==7 && memory[0].structs[1]==6;
 #assert memory[0].shadow_count==4 && memory[0].used==6 && memory[0].shadow_base[0]==1 && memory[0].shadow_region[0]==3 && memory[0].shadow_field[0]==3 && memory[0].shadow_struct[0]==2;
 #assert memory[0].shadow_base[3]==2 && memory[0].shadow_region[3]==6 && memory[0].shadow_field[3]==7 && memory[0].shadow_struct[3]==6 && memory[0].readonly[5] && memory[0].readonly[6] && !memory[0].readonly[3];
 #assert args[0].mask==0 && args[1].mask==2 && args[2].mask==0;
 bad:[9]AgLabel;for i:0..<9 {bad[i]=AgLabel.{name="stage",type="W",access=3};}memory[0]=AgMemory.{};state[0]=ScAudit.{};
 AG_public_fields(nodes[..],roots[..],bad[..],args[..],memory[..],state[..]);#assert state[0].error==SC_LIMIT && state[0].where==0 && memory[0].field_count==0;
 for variant:0..<6 {
  one:=[1]AgLabel.[AgLabel.{name="stage",type="W",access=3}];
  if variant==0 {one[0].access=2;}if variant==1 {one[0].extent=1;}if variant==2 {one[0].type="Z";}if variant==3 {one[0].name="nope";}if variant==4 {one[0].name="inner";}
  memory[0]=AgMemory.{};state[0]=ScAudit.{};if variant==5 {memory[0].fields[0]=3;memory[0].field_count=1;}
  AG_public_fields(nodes[..],roots[..],one[..],args[..],memory[..],state[..]);#assert state[0].error==SC_TYPE;
  if variant<=2 {#assert state[0].where==0;}if variant>=4 {#assert state[0].where==ifx variant==4 then 5 else 3;}
 }
 memory[0]=AgMemory.{};memory[0].used=4095;state[0]=ScAudit.{};AG_public_fields(nodes[..],roots[..],labels[..],args[..],memory[..],state[..]);#assert state[0].error==SC_LIMIT && state[0].where==0;
 memory[0]=AgMemory.{};memory[0].used=4094;state[0]=ScAudit.{};AG_public_fields(nodes[..],roots[..],labels[0..<1],args[0..<1],memory[..],state[..]);#assert state[0].error==0 && memory[0].used==4095 && memory[0].shadow_region[0]==4095;
}
#test "struct containment recursion is bounded at every field level" {
