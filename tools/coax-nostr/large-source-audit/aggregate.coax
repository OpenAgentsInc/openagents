}
// Unsigned range facts, used only to prove that a checked operation's trap
// cannot fire. They never decide a branch, an index or a loop bound. A value
// without a range has its type's whole range; int has none.
AG_max :: (type:int)->u64 {if type==-1 {return 0xFFFFFFFFFFFFFFFF;}if type==-2 {return 4294967295;}if type==-5 {return 255;}if type==-3 {return 1;}return 0;}
AG_unsigned :: (type:int)->bool {return type==-1 || type==-2 || type==-5 || type==-3;}
AG_width :: (type:int)->u64 {if type==-1 {return 64;}if type==-2 {return 32;}if type==-5 {return 8;}return 0;}
AG_bounded :: (v:AgValue)->bool {return v.ranged || AG_unsigned(v.type);}
AG_hi :: (v:AgValue)->u64 {if v.ranged {return v.rhi;}return AG_max(v.type);}
AG_lo :: (v:AgValue)->u64 {if v.ranged {return v.rlo;}return 0;}
AG_with :: (v:AgValue,lo:u64,hi:u64)->AgValue {r:=v;r.ranged=true;r.rlo=lo;r.rhi=hi;return r;}
AG_unranged :: (v:AgValue)->AgValue {r:=v;r.ranged=false;r.rlo=0;r.rhi=0;return r;}
// The smallest all-ones value at or above x. Every value at most x has its
// bits inside AG_fill(x), which bounds masks and widens loop ranges.
AG_fill :: (x:u64)->u64 {r:=x|(x>>1);r|=r>>2;r|=r>>4;r|=r>>8;r|=r>>16;r|=r>>32;return r;}
// A range survives a binding or return only into the same unsigned type
// (or from an int literal) and only if it lies inside that type.
AG_keeps :: (value:AgValue,type:int)->bool {
 return value.ranged && (value.type==type || value.type==-4) && AG_unsigned(type) && type!=-3 && value.rhi<=AG_max(type);
}
// A cast whose source range lies inside a different unsigned non-bool target
// leaves the value unchanged, so neither the checked trap nor truncation can
// apply. Identity casts are excluded, as in AG_contained.
AG_fits :: (v:AgValue,target:int)->bool {
 return AG_bounded(v) && (AG_unsigned(v.type) || v.type==-4) && v.type!=-3 && v.type!=target && AG_unsigned(target) && target!=-3 && AG_hi(v)<=AG_max(target);
}
// Checked + and - on secret unsigned values whose ranges rule out the trap.
// u64 * refuses always: its emitted check branches on a zero operand and
// divides by it. u32 and u8 * are checked in int64 without division.
AG_no_trap :: (a:AgValue,b:AgValue,op:u32,type:int)->bool {
 if !AG_unsigned(type) || type==-3 || !AG_bounded(a) || !AG_bounded(b) {return false;}
 max:=AG_max(type);ha:=AG_hi(a);hb:=AG_hi(b);if ha>max || hb>max {return false;}
 if op==34 {return ha<=max-hb;}
 if op==35 {return AG_lo(a)>=hb;}
 if op==36 {return type!=-1 && (hb==0 || ha<=max/hb);}
 return false;
}
AG_binary_range :: (a:AgValue,b:AgValue,op:u32,base:AgValue)->AgValue {
 r:=AG_unranged(base);if !AG_unsigned(r.type) || r.type==-3 || !AG_bounded(a) {return r;}
 max:=AG_max(r.type);la:=AG_lo(a);ha:=AG_hi(a);if ha>max {return r;}
 if op==42 || op==43 {
  if !b.known || b.lo<0 || cast(u64)b.hi>=AG_width(r.type) {return r;}
  if op==43 {return AG_with(r,la>>cast(u64)b.hi,ha>>cast(u64)b.lo);}
  if b.lo!=b.hi || ha>(max>>cast(u64)b.lo) {return r;}return AG_with(r,la<<cast(u64)b.lo,ha<<cast(u64)b.lo);
 }
 if !AG_bounded(b) {return r;}lb:=AG_lo(b);hb:=AG_hi(b);if hb>max {return r;}
 if op==34 && ha<=max-hb {return AG_with(r,la+lb,ha+hb);}
 if op==35 && la>=hb {return AG_with(r,la-hb,ha-lb);}
 if op==36 {if hb==0 {return AG_with(r,0,0);}if ha<=max/hb {return AG_with(r,la*lb,ha*hb);}}
 if op==39 {return AG_with(r,0,AG_fill(ha)&AG_fill(hb));}
 if op==40 || op==41 {return AG_with(r,0,AG_fill(ha|hb));}
 return r;
}
// Is every value of e inside the range assumed by s?
AG_inside :: (e:AgValue,s:AgValue)->bool {return !s.ranged || (AG_bounded(e) && AG_lo(e)>=s.rlo && AG_hi(e)<=s.rhi);}
AG_widen :: (s:AgValue,e:AgValue)->AgValue {
 if !s.ranged || !AG_bounded(e) {return AG_unranged(s);}hi:=AG_fill(s.rhi|AG_hi(e));
 if AG_unsigned(s.type) && hi>AG_max(s.type) {return AG_unranged(s);}return AG_with(s,s.rlo&AG_lo(e),hi);
}
// Loop-carried scalars start from their entry ranges. Each pass is a complete
// analysis of the body; if a pass leaves every binding's range inside the one
// it assumed, that assumption is an inductive invariant. Otherwise the ranges
// widen and the body is analyzed again; from the fifth pass the carried
// scalars have type ranges, which are always inductive. Public-field shadows
// are not tainted in advance: a pass stands only when it also leaves every
// shadow's taint unchanged, so a later iteration's reads see every earlier
// write. Narrower ranges and taints only admit more, so a refusal in any pass
// is also one under the final assumptions. Eight passes without both fixed
// points fail closed.
AG_loop_body :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,n:ScNode,loop:AgValue,entry:[]AgBinding,marked:[]AgBinding,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int,at:int)->AgBlock {
 saved:=env[0].count;assume:[64]AgValue;before:[64]u64;
 for i:0..<saved {assume[i]=marked[i].value;if entry[i].value.ranged {assume[i]=AG_with(assume[i],entry[i].value.rlo,entry[i].value.rhi);}}
 for pass:0..<8 {
  ranged:=pass<4;for i:0..<saved {env[0].bindings[i].value=ifx ranged then assume[i] else marked[i].value;}
  for i:0..<memory[0].shadow_count {before[i]=memory[0].taint[memory[0].shadow_region[i]];}
  part:=AG_loop_pass(nodes,values,roots,types,n,loop,env,memory,state,depth,at,saved);if state[0].error!=0 {return part;}
  stable:=true;for i:0..<memory[0].shadow_count {if memory[0].taint[memory[0].shadow_region[i]]!=before[i] {stable=false;}}
  if ranged {for i:0..<saved {if !AG_inside(env[0].bindings[i].value,assume[i]) {stable=false;assume[i]=AG_widen(assume[i],env[0].bindings[i].value);}}}
  if stable {return part;}
 }
 SC_fail(state,SC_LIMIT,at);return AgBlock.{};
}
// Shared by range and for-each loops. A return inside the body is admitted
// only for read-only bodies; it never ends the enclosing block.
AG_loop_run :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,n:ScNode,loop:AgValue,want:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int,at:int)->AgBlock {
 readonly:=false;if memory[0].classified {readonly=AG_readonly_block(nodes,n.c,state,0);}
 incoming:=cast(u64)0;for i:0..<env[0].count {incoming|=AG_origin(env[0].bindings[i].value,memory);}
 if !readonly {for i:0..<env[0].count {region:=env[0].bindings[i].value.region;if region!=0 {memory[0].taint[region]|=incoming;memory[0].dirty[region]=true;}}}
 entry:=env[0].bindings;AG_loop_marks(nodes,n.c,env,memory,state,incoming,0);saved:=env[0].count;
 loop_type:=AG_resolved(nodes,values,roots,types,nodes[env[0].procedure],n,"loop",state);if loop_type!=want {SC_fail(state,SC_TYPE,at);return AgBlock.{};}
 marked:=env[0].bindings;l:=loop;l.type=loop_type;
 part:=AG_loop_body(nodes,values,roots,types,n,l,entry[..],marked[..],env,memory,state,depth,at);env[0].count=saved;
 if part.possible {if !readonly {SC_fail(state,SC_UNSUPPORTED,at);}part.returned=false;}return part;
}
AG_loop_pass :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,n:ScNode,loop:AgValue,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int,at:int,saved:int)->AgBlock {
 env[0].count=saved;AG_bind(env,n.name,loop,state,at);if env[0].count>saved {env[0].bindings[saved].induction=true;}
 return AG_block(nodes,values,roots,types,n.c,env,memory,state,depth+1);
}
// A checked cast whose source type's whole range lies inside the target's
// cannot reach its range trap, so the emitted check's branch never depends
// on the value. Only unsigned strict widening qualifies: u8 -> u32/u64 and
// u32 -> u64. Every other checked cast of a secret refuses: identity,
// narrowing, any int source or target, bool and others.
AG_contained :: (from:int,to:int)->bool {
 if from==-5 {return to==-2 || to==-1;}
 if from==-2 {return to==-1;}
 return false;
}
// The cast's target as a primitive code, read like AG_type but without
// failing: anything other than a primitive is 0, which nothing contains.
AG_cast_primitive :: (nodes:[]ScNode,id:int)->int {
 if id<0 {return ifx id>=-5 then id else 0;}
 if SC_ref(id,nodes.count) && nodes[id].kind==1 {return AG_primitive(nodes[id].name);}
 return 0;
}
AG_primitive_name :: (type:int)->string {if type==-1 {return "u64";}if type==-2 {return "u32";}if type==-3 {return "bool";}if type==-4 {return "int";}if type==-5 {return "u8";}return "";}
AG_parameter_name :: (types:[]ScType,p:ScNode,n:ScNode)->string {for t:types {if t.unit==p.unit && t.procedure==p.name && t.procedure_line==p.line && t.name==n.name && t.line==n.line && t.role=="parameter" {return t.type;}}return "";}
AG_check_source :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory,compiled_runs:bool,classified:bool,secret_mask:u64,labels:[]AgLabel,public_views:bool)->ScResult {
 if !LA_shape(nodes,roots,types) || values.count!=nodes.count || memory.count!=1 {return ScResult.{error=SC_GRAPH,unit=-1};}
 if !classified && (secret_mask!=0 || labels.count!=0 || public_views) {return ScResult.{error=SC_ENTRY,unit=-1};}memory[0]=AgMemory.{};
 memory[0].compiled_runs=compiled_runs;memory[0].classified=classified;memory[0].public_views=public_views;
 state:[1]ScAudit;id:=AG_decl(nodes,roots,entry,state[..]);if state[0].error!=0 {return ScResult.{error=state[0].error,unit=-1};}if nodes[id].kind!=64 {return ScResult.{error=SC_ENTRY,unit=-1};}args:[8]AgValue;at:=nodes[id].head;count:=0;
 while at!=0 {if !AG_tick(state[..],at) {break;}if count==8 {SC_fail(state[..],SC_LIMIT,id);break;}
  if classified {if count>=labels.count || nodes[at].name!=labels[count].name || AG_parameter_name(types,nodes[id],nodes[at])!=labels[count].type {SC_fail(state[..],SC_TYPE,at);break;}}
  bit:=cast(u64)1<<count;if !classified || (secret_mask&bit)!=0 {args[count].mask=bit;}
  if public_views {
   type:=AG_type(nodes,roots,nodes[at].a,state[..]);is_view:=SC_ref(type,nodes.count) && nodes[type].kind==3;label:=labels[count];
   if is_view {
    // At most eight fresh root views can be allocated before procedure entry.
    if label.extent<1 || label.extent>AG_array_limit() || (label.access!=1 && label.access!=2) {SC_fail(state[..],SC_TYPE,at);break;}
    memory[0].used+=1;region:=memory[0].used;memory[0].taint[region]=args[count].mask;memory[0].readonly[region]=label.access==1;
    args[count].region=region;args[count].extent=label.extent;
   }else if label.extent!=0 || label.access!=0 {SC_fail(state[..],SC_TYPE,at);break;}
  }
  count+=1;at=nodes[at].next;}
 if state[0].error!=0 {return ScResult.{error=state[0].error,unit=-1};}
 extra:=labels.count-count;if count==0 || (classified && (extra<0 || (extra!=0 && !public_views) || (secret_mask>>count)!=0)) {return ScResult.{error=SC_ENTRY,unit=-1};}
 if classified {AG_public_fields(nodes,roots,labels[count..<labels.count],args[0..<count],memory,state[..]);if state[0].error!=0 {return ScResult.{error=state[0].error,unit=-1};}}r:=AG_procedure(nodes,values,roots,types,id,args[0..<count],memory,state[..]);where:=state[0].where;error:=state[0].error;if error==0 && memory[0].guard_count!=0 {error=AG_GUARDS;}
 return ScResult.{error=error,unit=nodes[where].unit,line=nodes[where].line,column=nodes[where].column,reached=state[0].count,visits=state[0].visits,return_mask=AG_origin(r,memory)};
}
// Direct graph callers have no compiler attestation. The compiled entry is
// reserved for the source driver after compilation and source-hash checks.
AG_check :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory)->ScResult #export_c {empty:[]AgLabel;return AG_check_source(nodes,values,roots,types,entry,memory,false,false,0,empty,false);}
AG_check_compiled :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory)->ScResult #export_c {empty:[]AgLabel;return AG_check_source(nodes,values,roots,types,entry,memory,true,false,0,empty,false);}

// Internal source bridge only: the checked driver binds these labels to the
// exact compiler-recorded source closure and resolved parameter inventory.
AG_check_classified :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory,secret_mask:u64,labels:[]AgLabel,compiled_runs:bool)->ScResult #export_c {
 return AG_check_source(nodes,values,roots,types,entry,memory,compiled_runs,true,secret_mask,labels,false);
}
// Internal checked bridge only: extents, access and disjoint live storage are
// explicit caller premises, never inferred from source or arbitrary IR.
AG_check_public_views :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory,secret_mask:u64,labels:[]AgLabel,compiled_runs:bool)->ScResult #export_c {
 return AG_check_source(nodes,values,roots,types,entry,memory,compiled_runs,true,secret_mask,labels,true);
}

AG_tick :: (state:[]ScAudit,where:int)->bool {
 if state[0].error!=0 {return false;}if state[0].visits>=262144 {SC_fail(state,SC_LIMIT,where);return false;}state[0].visits+=1;return true;
}
AG_decl :: (nodes:[]ScNode,roots:[]int,name:string,state:[]ScAudit)->int {
 cached:=AG_lookup_cached(state,name,1);if cached>=0 {return cached;}if state[0].error!=0 {return 0;}
 found:=0;for root:roots {id:=nodes[root].head;while id!=0 {if !AG_tick(state,id) {return 0;}n:=nodes[id];if (n.kind==64 || n.kind==65) && n.name==name {if found!=0 {SC_fail(state,SC_GRAPH,id);return 0;}found=id;}id=n.next;}}AG_lookup_save(state,name,1,found);return found;
}

// Public interval arithmetic only. Admitted endpoints are 0..4096, so each
// difference+4096 lies in 0..8192 and the divisor produces an exact 0/1 choice.
AG_join_bounds :: (a:AgValue,b:AgValue)->AgValue {
 r:AgValue;r.known=a.known && b.known && AG_interval(a.lo,a.hi) && AG_interval(b.lo,b.hi);
 if r.known {limit:=AG_interval_limit();r.lo=a.lo-((a.lo-b.lo+limit)/(limit+1))*(a.lo-b.lo);r.hi=b.hi+((a.hi-b.hi+limit)/(limit+1))*(a.hi-b.hi);}return r;
}
