 nodes[5]=ScNode.{kind=2,b=6};nodes[6]=ScNode.{kind=1,name="T"};nodes[7]=ScNode.{kind=66,name="T",head=8};nodes[8]=ScNode.{kind=69,name="c",a=4};
 nodes[9]=ScNode.{kind=66,name="U",head=10};nodes[10]=ScNode.{kind=69,name="d",a=4};nodes[11]=ScNode.{kind=3,b=12};nodes[12]=ScNode.{kind=1,name="T"};nodes[13]=ScNode.{kind=67,head=2};
 roots[0]=15;nodes[15]=ScNode.{kind=74,head=1};nodes[1].next=7;nodes[7].next=9;
