 #assert AG_contains(nodes[..],roots[..],11,7,state[..],0) && !AG_contains(nodes[..],roots[..],11,9,state[..],0) && !AG_contains(nodes[..],roots[..],13,7,state[..],0) && state[0].error==0;
 #assert AG_contains(nodes[..],roots[..],1,1,state[..],0) && !AG_contains(nodes[..],roots[..],9,7,state[..],0) && AG_contains(nodes[..],roots[..],5,7,state[..],0);
