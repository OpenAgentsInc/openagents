}
AG_procedure :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,args:[]AgValue,memory:[]AgMemory,state:[]ScAudit)->AgValue {
 if !AG_tick(state,id) {return AgValue.{};}if state[0].depth==16 || args.count>8 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}
 for i:0..<state[0].depth {if state[0].stack[i]==id {SC_fail(state,SC_RECURSION,id);return AgValue.{};}}
 p:=nodes[id];if p.kind!=64 || p.flag2 {SC_fail(state,SC_CALL,id);return AgValue.{};}if SC_vartime(p.name) {SC_fail(state,SC_VARTIME,id);return AgValue.{};}
 if AG_public_only(p.name) {if !memory[0].public_views {SC_fail(state,SC_VARTIME,id);return AgValue.{};}for arg:args {if AG_origin(arg,memory)!=0 {SC_fail(state,SC_VARTIME,id);return AgValue.{};}}}
 seen:=-1;for i:0..<state[0].count {if state[0].seen[i]==id {seen=i;}}if seen<0 {if state[0].count==64 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}seen=state[0].count;state[0].seen[seen]=id;state[0].count+=1;}
 level:=state[0].depth;state[0].stack[level]=id;state[0].depth+=1;memory[0].scope[level]=cast(u64)1<<seen;memory[0].height[level]=1;env:=[1]AgEnv.[AgEnv.{procedure=id}];at:=p.head;count:=0;keys:[8]AgValue;cacheable:=true;
 while at!=0 {if !AG_tick(state,at) {return AgValue.{};}if count>=args.count || nodes[at].kind!=68 {SC_fail(state,SC_CALL,at);return AgValue.{};}
  type:=AG_resolved(nodes,values,roots,types,p,nodes[at],"parameter",state);if !AG_match(nodes,values,roots,nodes[at].a,AG_parameter_name(types,p,nodes[at]),state,0) {SC_fail(state,SC_TYPE,at);}
  value:=AG_new(nodes,values,roots,args[count],type,memory,state);AG_bind(env[..],nodes[at].name,value,state,at);if value.view || args[count].view {cacheable=false;}keys[count]=AG_memo_value(value);count+=1;at=nodes[at].next;
 }
 if count!=args.count {SC_fail(state,SC_CALL,id);return AgValue.{};}
 if cacheable && state[0].error==0 {
  ancestors:=cast(u64)0;for i:0..<level {for j:0..<state[0].count {if state[0].seen[j]==state[0].stack[i] {ancestors|=cast(u64)1<<j;}}}
  for i:0..<memory[0].memo_count {if !AG_tick(state,id) {break;}memo:=memory[0].memo[i];if memo.procedure!=id || memo.count!=count || (memo.closure&ancestors)!=0 || level+memo.height>16 {continue;}
   match:=true;for j:0..<count {if !AG_tick(state,id) {return AgValue.{};}if !AG_memo_equal(memo.args[j],keys[j]) {match=false;break;}}
   if match {result:=AgValue.{};if p.a!=0 {result=AG_new(nodes,values,roots,memo.result,p.a,memory,state);}AG_memo_scope(memory,level,memo.closure,memo.height);state[0].depth-=1;return result;}
  }
 }
 block:=AG_block(nodes,values,roots,types,p.b,env[..],memory,state,0);if p.a!=0 && !block.returned {SC_fail(state,SC_UNSUPPORTED,id);}
 result:=AgValue.{};if p.a!=0 {result=AG_new(nodes,values,roots,block.value,p.a,memory,state);}if result.view {SC_fail(state,SC_UNSUPPORTED,id);}
 if cacheable && state[0].error==0 && memory[0].memo_count<128 {at_memo:=memory[0].memo_count;memory[0].memo_count+=1;memory[0].memo[at_memo].procedure=id;memory[0].memo[at_memo].count=count;memory[0].memo[at_memo].args=keys;memory[0].memo[at_memo].result=AG_memo_value(result);memory[0].memo[at_memo].closure=memory[0].scope[level];memory[0].memo[at_memo].height=memory[0].height[level];}
