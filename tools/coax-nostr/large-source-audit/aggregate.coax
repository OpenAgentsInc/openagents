}
AG_memo_equal :: (a:AgValue,b:AgValue)->bool {
 return a.mask==b.mask && a.type==b.type && a.literal==b.literal && a.lo==b.lo && a.hi==b.hi && a.known==b.known && a.extent==b.extent && a.ranged==b.ranged && a.rlo==b.rlo && a.rhi==b.rhi;
}
AG_memo_value :: (value:AgValue)->AgValue {
 return AgValue.{mask=value.mask,type=value.type,literal=value.literal,lo=value.lo,hi=value.hi,known=value.known,extent=value.extent,ranged=value.ranged,rlo=value.rlo,rhi=value.rhi};
}
AG_memo_scope :: (memory:[]AgMemory,level:int,closure:u64,height:int) {
