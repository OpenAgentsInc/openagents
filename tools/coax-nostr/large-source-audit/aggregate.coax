}
AG_memo_equal :: (a:AgValue,b:AgValue)->bool {
 return a.mask==b.mask && a.type==b.type && a.literal==b.literal && a.lo==b.lo && a.hi==b.hi && a.known==b.known && a.extent==b.extent;
}
AG_memo_value :: (value:AgValue)->AgValue {
 return AgValue.{mask=value.mask,type=value.type,literal=value.literal,lo=value.lo,hi=value.hi,known=value.known,extent=value.extent};
}
AG_memo_scope :: (memory:[]AgMemory,level:int,closure:u64,height:int) {
 if level>0 {memory[0].scope[level-1]|=closure;if memory[0].height[level-1]<=height {memory[0].height[level-1]=height+1;}}
}
AG_procedure :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,args:[]AgValue,memory:[]AgMemory,state:[]ScAudit)->AgValue {
 if !AG_tick(state,id) {return AgValue.{};}if state[0].depth==16 || args.count>8 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}
 for i:0..<state[0].depth {if state[0].stack[i]==id {SC_fail(state,SC_RECURSION,id);return AgValue.{};}}
 p:=nodes[id];if p.kind!=64 || p.flag2 {SC_fail(state,SC_CALL,id);return AgValue.{};}if SC_vartime(p.name) {SC_fail(state,SC_VARTIME,id);return AgValue.{};}
 if AG_public_only(p.name) {if !memory[0].public_views {SC_fail(state,SC_VARTIME,id);return AgValue.{};}for arg:args {if AG_origin(arg,memory)!=0 {SC_fail(state,SC_VARTIME,id);return AgValue.{};}}}
 seen:=-1;for i:0..<state[0].count {if state[0].seen[i]==id {seen=i;}}if seen<0 {if state[0].count==64 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}seen=state[0].count;state[0].seen[seen]=id;state[0].count+=1;}
 level:=state[0].depth;state[0].stack[level]=id;state[0].depth+=1;memory[0].scope[level]=cast(u64)1<<seen;memory[0].height[level]=1;env:=[1]AgEnv.[AgEnv.{procedure=id}];at:=p.head;count:=0;keys:[8]AgValue;cacheable:=true;
 while at!=0 {if !AG_tick(state,at) {return AgValue.{};}if count>=args.count || nodes[at].kind!=68 {SC_fail(state,SC_CALL,at);return AgValue.{};}
  type:=AG_resolved(nodes,values,roots,types,p,nodes[at],"parameter",state);if !AG_match(nodes,values,roots,nodes[at].a,AG_parameter_name(types,p,nodes[at]),state,0) {SC_fail(state,SC_TYPE,at);}
  value:=AG_new(nodes,values,roots,args[count],type,memory,state);AG_bind(env[..],nodes[at].name,value,state,at);if value.view || args[count].view {cacheable=false;}keys[count]=AG_memo_value(value);count+=1;at=nodes[at].next;
 }
 if count!=args.count {SC_fail(state,SC_CALL,id);return AgValue.{};}
 if cacheable && state[0].error==0 {
  ancestors:=cast(u64)0;for i:0..<level {for j:0..<state[0].count {if state[0].seen[j]==state[0].stack[i] {ancestors|=cast(u64)1<<j;}}}
  for i:0..<memory[0].memo_count {if !AG_tick(state,id) {break;}memo:=memory[0].memo[i];if memo.procedure!=id || memo.count!=count || (memo.closure&ancestors)!=0 || level+memo.height>16 {continue;}
   match:=true;for j:0..<count {if !AG_tick(state,id) {return AgValue.{};}if !AG_memo_equal(memo.args[j],keys[j]) {match=false;break;}}
   if match {result:=AG_new(nodes,values,roots,memo.result,p.a,memory,state);AG_memo_scope(memory,level,memo.closure,memo.height);state[0].depth-=1;return result;}
  }
 }
 block:=AG_block(nodes,values,roots,types,p.b,env[..],memory,state,0);if !block.returned {SC_fail(state,SC_UNSUPPORTED,id);}
 result:=AG_new(nodes,values,roots,block.value,p.a,memory,state);if result.view {SC_fail(state,SC_UNSUPPORTED,id);}
 if cacheable && state[0].error==0 && memory[0].memo_count<128 {at_memo:=memory[0].memo_count;memory[0].memo_count+=1;memory[0].memo[at_memo].procedure=id;memory[0].memo[at_memo].count=count;memory[0].memo[at_memo].args=keys;memory[0].memo[at_memo].result=AG_memo_value(result);memory[0].memo[at_memo].closure=memory[0].scope[level];memory[0].memo[at_memo].height=memory[0].height[level];}
 AG_memo_scope(memory,level,memory[0].scope[level],memory[0].height[level]);state[0].depth-=1;return result;
}
AG_primitive_name :: (type:int)->string {if type==-1 {return "u64";}if type==-2 {return "u32";}if type==-3 {return "bool";}if type==-4 {return "int";}if type==-5 {return "u8";}return "";}
AG_parameter_name :: (types:[]ScType,p:ScNode,n:ScNode)->string {for t:types {if t.unit==p.unit && t.procedure==p.name && t.procedure_line==p.line && t.name==n.name && t.line==n.line && t.role=="parameter" {return t.type;}}return "";}
AG_check_source :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory,compiled_runs:bool,classified:bool,secret_mask:u64,labels:[]AgLabel,public_views:bool)->ScResult {
 if !LA_shape(nodes,roots,types) || values.count!=nodes.count || memory.count!=1 {return ScResult.{error=SC_GRAPH,unit=-1};}
 if !classified && (secret_mask!=0 || labels.count!=0 || public_views) {return ScResult.{error=SC_ENTRY,unit=-1};}memory[0]=AgMemory.{};
 memory[0].compiled_runs=compiled_runs;memory[0].classified=classified;memory[0].public_views=public_views;
 state:[1]ScAudit;id:=AG_decl(nodes,roots,entry,state[..]);if state[0].error!=0 {return ScResult.{error=state[0].error,unit=-1};}if nodes[id].kind!=64 {return ScResult.{error=SC_ENTRY,unit=-1};}args:[8]AgValue;at:=nodes[id].head;count:=0;
 while at!=0 {if !AG_tick(state[..],at) {break;}if count==8 {SC_fail(state[..],SC_LIMIT,id);break;}
  if classified {if count>=labels.count || nodes[at].name!=labels[count].name || AG_parameter_name(types,nodes[id],nodes[at])!=labels[count].type {SC_fail(state[..],SC_TYPE,at);break;}}
  bit:=cast(u64)1<<count;if !classified || (secret_mask&bit)!=0 {args[count].mask=bit;}
  if public_views {
   type:=AG_type(nodes,roots,nodes[at].a,state[..]);is_view:=SC_ref(type,nodes.count) && nodes[type].kind==3;label:=labels[count];
   if is_view {
    // At most eight fresh root views can be allocated before procedure entry.
    if label.extent<1 || label.extent>AG_array_limit() || (label.access!=1 && label.access!=2) {SC_fail(state[..],SC_TYPE,at);break;}
    memory[0].used+=1;region:=memory[0].used;memory[0].taint[region]=args[count].mask;memory[0].readonly[region]=label.access==1;
    args[count].region=region;args[count].extent=label.extent;
   }else if label.extent!=0 || label.access!=0 {SC_fail(state[..],SC_TYPE,at);break;}
  }
  count+=1;at=nodes[at].next;}
 if state[0].error!=0 {return ScResult.{error=state[0].error,unit=-1};}
 if count==0 || (classified && (labels.count!=count || (secret_mask>>count)!=0)) {return ScResult.{error=SC_ENTRY,unit=-1};}r:=AG_procedure(nodes,values,roots,types,id,args[0..<count],memory,state[..]);where:=state[0].where;error:=state[0].error;if error==0 && memory[0].guard_count!=0 {error=AG_GUARDS;}
 return ScResult.{error=error,unit=nodes[where].unit,line=nodes[where].line,column=nodes[where].column,reached=state[0].count,visits=state[0].visits,return_mask=AG_origin(r,memory)};
}
// Direct graph callers have no compiler attestation. The compiled entry is
// reserved for the source driver after compilation and source-hash checks.
AG_check :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory)->ScResult #export_c {empty:[]AgLabel;return AG_check_source(nodes,values,roots,types,entry,memory,false,false,0,empty,false);}
AG_check_compiled :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory)->ScResult #export_c {empty:[]AgLabel;return AG_check_source(nodes,values,roots,types,entry,memory,true,false,0,empty,false);}

// Internal source bridge only: the checked driver binds these labels to the
// exact compiler-recorded source closure and resolved parameter inventory.
AG_check_classified :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory,secret_mask:u64,labels:[]AgLabel,compiled_runs:bool)->ScResult #export_c {
 return AG_check_source(nodes,values,roots,types,entry,memory,compiled_runs,true,secret_mask,labels,false);
}
// Internal checked bridge only: extents, access and disjoint live storage are
// explicit caller premises, never inferred from source or arbitrary IR.
AG_check_public_views :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory,secret_mask:u64,labels:[]AgLabel,compiled_runs:bool)->ScResult #export_c {
 return AG_check_source(nodes,values,roots,types,entry,memory,compiled_runs,true,secret_mask,labels,true);
}

AG_tick :: (state:[]ScAudit,where:int)->bool {
 if state[0].error!=0 {return false;}if state[0].visits>=262144 {SC_fail(state,SC_LIMIT,where);return false;}state[0].visits+=1;return true;
}
AG_decl :: (nodes:[]ScNode,roots:[]int,name:string,state:[]ScAudit)->int {
 cached:=AG_lookup_cached(state,name,1);if cached>=0 {return cached;}if state[0].error!=0 {return 0;}
 found:=0;for root:roots {id:=nodes[root].head;while id!=0 {if !AG_tick(state,id) {return 0;}n:=nodes[id];if (n.kind==64 || n.kind==65) && n.name==name {if found!=0 {SC_fail(state,SC_GRAPH,id);return 0;}found=id;}id=n.next;}}AG_lookup_save(state,name,1,found);return found;
}

// Public interval arithmetic only. Admitted endpoints are 0..4096, so each
// difference+4096 lies in 0..8192 and the divisor produces an exact 0/1 choice.
AG_join_bounds :: (a:AgValue,b:AgValue)->AgValue {
 r:AgValue;r.known=a.known && b.known && AG_interval(a.lo,a.hi) && AG_interval(b.lo,b.hi);
 if r.known {limit:=AG_interval_limit();r.lo=a.lo-((a.lo-b.lo+limit)/(limit+1))*(a.lo-b.lo);r.hi=b.hi+((a.hi-b.hi+limit)/(limit+1))*(a.hi-b.hi);}return r;
}
