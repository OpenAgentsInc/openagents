 r:=AG_check_source(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],false,false,1,empty,false);#assert r.error==SC_ENTRY && r.unit== -1;
 r=AG_check_source(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..],false,false,0,labels[..],false);#assert r.error==SC_ENTRY && r.unit== -1;
}
#test "readonly scan starts at the actual loop body depth" {
 f:=AG_fixture();env:[1]AgEnv;memory:[1]AgMemory;state:[1]ScAudit;env[0].procedure=2;env[0].count=1;env[0].bindings[0]=AgBinding.{name="x",value=AgValue.{type=12,region=2}};memory[0].used=2;memory[0].classified=true;
 f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};f.values[17]=2;f.nodes[18]=ScNode.{kind=40,head=20};f.nodes[60]=ScNode.{kind=18};f.values[60]=1;
 for i:0..<15 {at:=20+2*i;f.nodes[at]=ScNode.{kind=45,a=60,c=at+1};f.nodes[at+1]=ScNode.{kind=40,head=ifx i<14 then at+2 else 0};}
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};
 ignored:=AG_block(f.nodes[..],f.values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert !memory[0].dirty[2];
}
AG_primitive :: (name:string)->int {if name=="u64" {return -1;}if name=="u32" {return -2;}if name=="bool" {return -3;}if name=="int" {return -4;}if name=="u8" {return -5;}return 0;}
AG_type_limit :: ()->int {return 8;}
// Aggregate nesting for this profile's type validation: the signer's
// workspace nests struct, array and view levels deeper than eight.
AG_nesting_limit :: ()->int {return 16;}
AG_array_limit :: ()->int {return 1024;}
AG_interval_limit :: ()->int {return 4096;}
AG_interval :: (lo:int,hi:int)->bool {return lo>=0 && lo<=hi && hi<=AG_interval_limit();}
AG_number :: (value:int)->AgValue {return AgValue.{type=-4,lo=value,hi=value,known=true};}
// Public fields: the classification may name struct fields that hold public
// values inside a root view (a stage counter, a hash length). Each named field
// of each root view gets a shadow region that starts public. Reads of that
// field use the shadow; writes to it taint the shadow and the view, so a copy
// of the whole aggregate still carries every secret. A write to any part of
// the view whose type can contain the field's struct also taints the shadow.
AG_designated :: (memory:[]AgMemory,field:int)->bool {for i:0..<memory[0].field_count {if memory[0].fields[i]==field {return true;}}return false;}
AG_shadow :: (memory:[]AgMemory,region:int,field:int)->int {
 if region==0 {return 0;}for i:0..<memory[0].shadow_count {if memory[0].shadow_base[i]==region && memory[0].shadow_field[i]==field {return memory[0].shadow_region[i];}}return 0;
}
AG_sensitive :: (memory:[]AgMemory,region:int)->bool {if region==0 {return false;}for i:0..<memory[0].shadow_count {if memory[0].shadow_base[i]==region {return true;}}return false;}
// Reads within a view that has public fields keep the view's taint in its
// region rather than the value's mask, so a later public-field read can
// replace it; AG_origin still adds the region's taint to every other use.
AG_read_mask :: (base:AgValue,memory:[]AgMemory)->u64 {if AG_sensitive(memory,base.region) {return base.mask;}return AG_origin(base,memory);}
AG_contains :: (nodes:[]ScNode,roots:[]int,type:int,structure:int,state:[]ScAudit,depth:int)->bool {
 if type==structure {return true;}if type<1 {return false;}if depth>=AG_nesting_limit() {return true;}n:=nodes[type];
 if n.kind==2 || n.kind==3 {return AG_contains(nodes,roots,AG_type(nodes,roots,n.b,state),structure,state,depth+1);}
 if n.kind!=66 {return false;}field:=n.head;while field!=0 {if !AG_tick(state,field) {return true;}if AG_contains(nodes,roots,AG_type(nodes,roots,nodes[field].a,state),structure,state,depth+1) {return true;}field=nodes[field].next;}return false;
}
AG_shadow_write :: (nodes:[]ScNode,roots:[]int,memory:[]AgMemory,state:[]ScAudit,target:AgValue,mask:u64) {
 for i:0..<memory[0].shadow_count {
  if memory[0].shadow_region[i]==target.region {base:=memory[0].shadow_base[i];memory[0].taint[base]|=mask;memory[0].dirty[base]=true;}
  else if memory[0].shadow_base[i]==target.region && AG_contains(nodes,roots,target.type,memory[0].shadow_struct[i],state,0) {memory[0].taint[memory[0].shadow_region[i]]|=mask;}
 }
}
// Named fields: each (struct, field) resolves to one primitive field. Every
// root view gets a public shadow per named field; the view's own mask moves
// into its region so element reads can reach the shadows.
// A public field is a primitive or an array of primitives.
AG_flat :: (nodes:[]ScNode,roots:[]int,type:int,state:[]ScAudit)->bool {if AG_primitive_name(type)!="" {return true;}return SC_ref(type,nodes.count) && nodes[type].kind==2 && AG_primitive_name(AG_type(nodes,roots,nodes[type].b,state))!="";}
AG_public_fields :: (nodes:[]ScNode,roots:[]int,labels:[]AgLabel,args:[]AgValue,memory:[]AgMemory,state:[]ScAudit) {
 if labels.count>8 {SC_fail(state,SC_LIMIT,0);return;}
 for label:labels {
  structure:=AG_struct(nodes,roots,label.type,state);if label.access!=3 || label.extent!=0 || structure==0 {SC_fail(state,SC_TYPE,0);return;}
  field:=AG_field(nodes,structure,label.name,state);if state[0].error!=0 {return;}
  if !AG_flat(nodes,roots,AG_type(nodes,roots,nodes[field].a,state),state) || AG_designated(memory,field) {SC_fail(state,SC_TYPE,field);return;}
  memory[0].fields[memory[0].field_count]=field;memory[0].structs[memory[0].field_count]=structure;memory[0].field_count+=1;
 }
 for i:0..<args.count {if args[i].region!=0 {
  for f:0..<memory[0].field_count {
   if memory[0].used==4095 {SC_fail(state,SC_LIMIT,0);return;}memory[0].used+=1;at:=memory[0].shadow_count;
   memory[0].shadow_base[at]=args[i].region;memory[0].shadow_field[at]=memory[0].fields[f];memory[0].shadow_struct[at]=memory[0].structs[f];memory[0].shadow_region[at]=memory[0].used;
   memory[0].readonly[memory[0].used]=memory[0].readonly[args[i].region];memory[0].shadow_count+=1;args[i].mask=0;
  }
 }}
}
AG_origin :: (value:AgValue,memory:[]AgMemory)->u64 {if value.region!=0 {return value.mask|memory[0].taint[value.region];}return value.mask;}
AG_slot :: (env:[]AgEnv,name:string)->int {for i:0..<env[0].count {if env[0].bindings[i].name==name {return i;}}return -1;}
// A cache belongs to one immutable AG_check graph. Its bounded overflow falls
// back to the original scan. Both hits and scans consume the existing budget.
AG_lookup_cached :: (state:[]ScAudit,name:string,kind:int)->int {
 for i:0..<state[0].lookup_count {if !AG_tick(state,0) {return -1;}row:=state[0].lookups[i];if row.kind==kind && row.name==name {return row.id;}}
 return -1;
}
AG_lookup_save :: (state:[]ScAudit,name:string,kind:int,id:int) {
 if state[0].error!=0 || state[0].lookup_count>=128 {return;}
 at:=state[0].lookup_count;state[0].lookups[at]=ScLookup.{name=name,kind=kind,id=id};state[0].lookup_count+=1;
}
AG_struct :: (nodes:[]ScNode,roots:[]int,name:string,state:[]ScAudit)->int {
 cached:=AG_lookup_cached(state,name,2);if cached>=0 {return cached;}if state[0].error!=0 {return 0;}
 found:=0;for root:roots {id:=nodes[root].head;while id!=0 {if !AG_tick(state,id) {return 0;}if nodes[id].kind==66 && nodes[id].name==name {if found!=0 {SC_fail(state,SC_GRAPH,id);return 0;}found=id;}id=nodes[id].next;}}AG_lookup_save(state,name,2,found);return found;
}
AG_type :: (nodes:[]ScNode,roots:[]int,id:int,state:[]ScAudit)->int {
 if id<0 {if id>=-5 {return id;}SC_fail(state,SC_TYPE,0);return 0;}
 n:=nodes[id];if n.kind==1 {p:=AG_primitive(n.name);if p!=0 {return p;}s:=AG_struct(nodes,roots,n.name,state);if s!=0 {return s;}}
 else if n.kind==2 || n.kind==3 || n.kind==66 {return id;}SC_fail(state,SC_TYPE,id);return 0;
}
AG_element :: (nodes:[]ScNode,roots:[]int,type:int,state:[]ScAudit)->int {
 if !SC_ref(type,nodes.count) || (nodes[type].kind!=2 && nodes[type].kind!=3) {SC_fail(state,SC_TYPE,0);return 0;}return AG_type(nodes,roots,nodes[type].b,state);
}
AG_length :: (nodes:[]ScNode,values:[]u64,type:int,state:[]ScAudit)->int {
 if SC_ref(type,nodes.count) && nodes[type].kind==2 && nodes[nodes[type].a].kind==16 && values[nodes[type].a]>=1 && values[nodes[type].a]<=cast(u64)AG_array_limit() {return cast(int)values[nodes[type].a];}SC_fail(state,SC_TYPE,0);return 0;
}
AG_field :: (nodes:[]ScNode,type:int,name:string,state:[]ScAudit)->int {
 if !SC_ref(type,nodes.count) || nodes[type].kind!=66 {SC_fail(state,SC_TYPE,0);return 0;}field:=nodes[type].head;
 while field!=0 {if !AG_tick(state,field) {return 0;}if nodes[field].kind!=69 {SC_fail(state,SC_TYPE,field);return 0;}if nodes[field].name==name {return field;}field=nodes[field].next;}SC_fail(state,SC_TYPE,type);return 0;
}
AG_match :: (nodes:[]ScNode,values:[]u64,roots:[]int,type:int,name:string,state:[]ScAudit,depth:int)->bool {
 if depth>=AG_type_limit() {return false;}resolved:=AG_type(nodes,roots,type,state);if resolved<0 {return AG_primitive(name)==resolved;}
 n:=nodes[resolved];if n.kind==66 {return name==n.name;}
 if name.count<3 || name[0]!=91 {return false;}at:=1;length:=0;
 while at<name.count && name[at]>=48 && name[at]<=57 {digit:=cast(int)name[at]-48;if length>(AG_array_limit()-digit)/10 {SC_fail(state,SC_LIMIT,0);return false;}length=length*10+digit;at+=1;}
 if at>=name.count || name[at]!=93 {return false;}
 if n.kind==2 {if at==1 || AG_length(nodes,values,resolved,state)!=length {return false;}}
 else if n.kind!=3 || at!=1 {return false;}
 inner:=at+1;if inner<name.count && name[inner]==32 {inner+=1;}return AG_match(nodes,values,roots,n.b,name[inner..<name.count],state,depth+1);
}
AG_resolved :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,p:ScNode,n:ScNode,role:string,state:[]ScAudit)->int {
 count:=0;name:string;for row:types {if row.unit==p.unit && row.procedure==p.name && row.procedure_line==p.line && row.name==n.name && row.line==n.line && row.role==role {count+=1;name=row.type;}}
 if count!=1 {SC_fail(state,SC_TYPE,0);return 0;}primitive:=AG_primitive(name);if primitive!=0 {return primitive;}structure:=AG_struct(nodes,roots,name,state);if structure!=0 {return structure;}
 // Any equal type node. Type nodes this profile cannot represent (an oversized
 // or computed length, a non-struct name) are skipped rather than refused:
 // they are not candidates.
 for node,index:nodes {if (node.kind==2 || node.kind==3) && AG_quiet(nodes,values,roots,index,0) {if AG_match(nodes,values,roots,index,name,state,0) {return index;}}}SC_fail(state,SC_TYPE,0);return 0;
}
AG_quiet :: (nodes:[]ScNode,values:[]u64,roots:[]int,id:int,depth:int)->bool {
 if depth>=AG_type_limit() || !SC_ref(id,nodes.count) {return false;}n:=nodes[id];
 if n.kind==2 {return SC_ref(n.a,nodes.count) && nodes[n.a].kind==16 && values[n.a]>=1 && values[n.a]<=cast(u64)AG_array_limit() && AG_quiet(nodes,values,roots,n.b,depth+1);}
 if n.kind==3 {return AG_quiet(nodes,values,roots,n.b,depth+1);}
 if n.kind!=1 {return false;}if AG_primitive(n.name)!=0 {return true;}
 found:=0;for root:roots {at:=nodes[root].head;while at!=0 {if nodes[at].kind==66 && nodes[at].name==n.name {found+=1;}at=nodes[at].next;}}return found==1;
}
AG_new :: (nodes:[]ScNode,values:[]u64,roots:[]int,value:AgValue,type:int,memory:[]AgMemory,state:[]ScAudit)->AgValue {
 result:=value;result.mask=AG_origin(value,memory);result.type=AG_type(nodes,roots,type,state);result.region=0;result.view=false;
 if !AG_keeps(value,result.type) {result=AG_unranged(result);}
 // A copied or borrowed aggregate cannot recover facts from its original
 // literal after any write through its source region, even a public write.
 if value.region!=0 && memory[0].dirty[value.region] {result.literal=0;}
 if !AG_valid_root(nodes,values,roots,result.type,result.mask!=0,state,memory) {SC_fail(state,SC_TYPE,0);return result;}
 if AG_primitive_name(result.type)=="" {n:=nodes[result.type];if n.kind==3 {if value.region==0 || value.extent<1 {SC_fail(state,SC_UNSUPPORTED,type);return result;}result.region=value.region;result.view=true;result.mask=AG_read_mask(value,memory);}
 else {if memory[0].used==4095 {SC_fail(state,SC_LIMIT,type);return result;}memory[0].used+=1;result.region=memory[0].used;memory[0].taint[result.region]=result.mask;if n.kind==2 {result.extent=AG_length(nodes,values,result.type,state);}}}
 return result;
}
AG_bind :: (env:[]AgEnv,name:string,value:AgValue,state:[]ScAudit,where:int) {
 if env[0].count==64 || AG_slot(env,name)>=0 {SC_fail(state,SC_UNSUPPORTED,where);return;}at:=env[0].count;env[0].bindings[at]=AgBinding.{name=name,value=value};env[0].count+=1;
}
AG_guard :: (nodes:[]ScNode,memory:[]AgMemory,state:[]ScAudit,id:int,mask:u64) {AG_obligation(nodes,memory,state,id,mask,1);}
// Obligations are reported, never accepted silently: kind 1 is an authored
// assertion, kind 2 an explicit declassification.
AG_obligation :: (nodes:[]ScNode,memory:[]AgMemory,state:[]ScAudit,id:int,mask:u64,kind:u32) {
 for i:0..<memory[0].guard_count {if memory[0].guards[i].node==id {memory[0].guards[i].mask|=mask;return;}}
 if memory[0].guard_count==256 {SC_fail(state,SC_LIMIT,id);return;}n:=nodes[id];at:=memory[0].guard_count;memory[0].guards[at]=AgGuard.{node=id,unit=n.unit,line=n.line,column=n.column,mask=mask,kind=kind};memory[0].guard_count+=1;
}
AG_declassifies :: (name:string)->bool {return name.count>=11 && name[name.count-11..<name.count]=="_declassify";}
// A *_declassify call is analyzed like any other; then its scalar result and
// any public-field shadow it was handed become public. The call site and the
// taint it removed are reported as a declassification obligation.
AG_declassify :: (nodes:[]ScNode,memory:[]AgMemory,state:[]ScAudit,id:int,result:AgValue,args:[]AgValue)->AgValue {
 if !memory[0].public_views || result.region!=0 {SC_fail(state,SC_UNSUPPORTED,id);return AgValue.{};}
 r:=result;mask:=AG_origin(r,memory);
 for arg:args {if AG_is_shadow(memory,arg.region) {mask|=memory[0].taint[arg.region];memory[0].taint[arg.region]=0;}}
 AG_obligation(nodes,memory,state,id,mask,2);r.mask=0;return r;
}
AG_is_shadow :: (memory:[]AgMemory,region:int)->bool {if region==0 {return false;}for i:0..<memory[0].shadow_count {if memory[0].shadow_region[i]==region {return true;}}return false;}
AG_union :: (a:AgValue,b:AgValue,memory:[]AgMemory)->AgValue {
 r:=a;r.mask=AG_origin(a,memory)|AG_origin(b,memory);r.region=0;r.literal=0;bounds:=AG_join_bounds(a,b);r.known=bounds.known;r.lo=bounds.lo;r.hi=bounds.hi;
 r=AG_unranged(r);if AG_bounded(a) && AG_bounded(b) {r=AG_with(r,AG_lo(a)&AG_lo(b),AG_fill(AG_hi(a)|AG_hi(b)));}return r;
}

// The shared profile's form, with no public fields named.
AG_valid_type :: (nodes:[]ScNode,values:[]u64,roots:[]int,type:int,secret:bool,state:[]ScAudit,depth:int)->bool {memory:[1]AgMemory;return AG_valid_type_in(nodes,values,roots,type,secret,state,depth,memory[..],AG_type_limit());}
AG_valid_root :: (nodes:[]ScNode,values:[]u64,roots:[]int,type:int,secret:bool,state:[]ScAudit,memory:[]AgMemory)->bool {return AG_valid_type_in(nodes,values,roots,type,secret,state,0,memory,AG_nesting_limit());}
AG_valid_type_in :: (nodes:[]ScNode,values:[]u64,roots:[]int,type:int,secret:bool,state:[]ScAudit,depth:int,memory:[]AgMemory,limit:int)->bool {
 if depth>=limit {return false;}t:=AG_type(nodes,roots,type,state);if t<0 {return t!=-4 || !secret;}
 n:=nodes[t];if n.kind==2 {length:=AG_length(nodes,values,t,state);return length>0 && AG_valid_type_in(nodes,values,roots,n.b,secret,state,depth+1,memory,limit);}
 if n.kind==3 {if depth!=0 {return false;}return AG_valid_type_in(nodes,values,roots,n.b,secret,state,depth+1,memory,limit);}
 field:=n.head;count:=0;while field!=0 {if !AG_tick(state,field) {return false;}if nodes[field].kind!=69 {return false;}count+=1;if count>64 {return false;}if !AG_valid_type_in(nodes,values,roots,nodes[field].a,secret && !AG_designated(memory,field),state,depth+1,memory,limit) {return false;}field=nodes[field].next;}return count>0;
}

AG_binary :: (a:AgValue,b:AgValue,op:u32,memory:[]AgMemory,state:[]ScAudit,id:int)->AgValue {
 r:=AgValue.{mask=AG_origin(a,memory)|AG_origin(b,memory),type=a.type};if a.type==-4 {r.type=b.type;}
 if (op==50 || op==51) && AG_origin(a,memory)!=0 {SC_fail(state,SC_BRANCH,id);}
 if (op==42 || op==43) && AG_origin(b,memory)!=0 {SC_fail(state,SC_SHIFT,id);}
 if op>=34 && op<=38 && r.mask!=0 && !AG_no_trap(a,b,op,r.type) {SC_fail(state,SC_UNSUPPORTED,id);}
 if op<34 || op>51 {SC_fail(state,SC_UNSUPPORTED,id);return r;}
 if op>=44 {r.type=-3;r.known=true;r.hi=1;}
 // An int index masked by a known m >= 0 lies in [0, m.hi] for every value,
 // negative or not.
 if op==39 && r.type==-4 && b.known && b.lo>=0 && !a.known {r.known=true;r.hi=b.hi;}
 if a.known && b.known {
  if op==34 {r.lo=a.lo+b.lo;r.hi=a.hi+b.hi;r.known=AG_interval(r.lo,r.hi);}
  else if op==35 {r.lo=a.lo-b.hi;r.hi=a.hi-b.lo;r.known=AG_interval(r.lo,r.hi);}
  else if op==36 {r.lo=a.lo*b.lo;r.hi=a.hi*b.hi;r.known=AG_interval(r.lo,r.hi);}
  else if op==37 && b.lo>0 {r.lo=a.lo/b.hi;r.hi=a.hi/b.lo;r.known=AG_interval(r.lo,r.hi);}
  else if op==38 && b.lo>0 {r.hi=b.hi-1;r.known=AG_interval(r.lo,r.hi);}
  else if op==44 {if a.lo==a.hi && b.lo==b.hi && a.lo==b.lo {r.lo=1;}else if a.hi<b.lo || b.hi<a.lo {r.hi=0;}}
  else if op==45 {if a.lo==a.hi && b.lo==b.hi && a.lo==b.lo {r.hi=0;}else if a.hi<b.lo || b.hi<a.lo {r.lo=1;}}
  else if op==46 {if a.hi<b.lo {r.lo=1;}else if a.lo>=b.hi {r.hi=0;}}
  else if op==47 {if a.hi<=b.lo {r.lo=1;}else if a.lo>b.hi {r.hi=0;}}
  else if op==48 {if a.lo>b.hi {r.lo=1;}else if a.hi<=b.lo {r.hi=0;}}
  else if op==49 {if a.lo>=b.hi {r.lo=1;}else if a.hi<b.lo {r.hi=0;}}
  else if op==50 {if a.lo!=0 && b.lo!=0 {r.lo=1;}else if a.hi==0 || b.hi==0 {r.hi=0;}}
  else if op==51 {if a.lo!=0 || b.lo!=0 {r.lo=1;}else if a.hi==0 && b.hi==0 {r.hi=0;}}
 }
 // Byte arithmetic can wrap in release builds. Bounds outside the byte range
 // cannot be used to eliminate a branch or establish an index.
 if r.type==-5 && r.known && r.hi>255 {r.known=false;}
 // A comparison that the operands' ranges decide has the same result for every
 // secret value, so it is a public constant and its branch never varies.
 decided:=AG_decide(a,b,op);if decided>=0 {r.mask=0;r.lo=decided;r.hi=decided;}
 return AG_binary_range(a,b,op,r);
}
AG_decide :: (a:AgValue,b:AgValue,op:u32)->int {
 if !AG_bounded(a) || !AG_bounded(b) {return -1;}la:=AG_lo(a);ha:=AG_hi(a);lb:=AG_lo(b);hb:=AG_hi(b);
 if op==44 || op==45 {same:=-1;if la==ha && lb==hb && la==lb {same=1;}if ha<lb || hb<la {same=0;}if same<0 || op==44 {return same;}return 1-same;}
 if op==46 {if ha<lb {return 1;}if la>=hb {return 0;}}
 if op==47 {if ha<=lb {return 1;}if la>hb {return 0;}}
 if op==48 {if la>hb {return 1;}if ha<=lb {return 0;}}
 if op==49 {if la>=hb {return 1;}if ha<lb {return 0;}}
 return -1;
}
AG_literal_field :: (nodes:[]ScNode,values:[]u64,id:int,field:ScNode,state:[]ScAudit,depth:int)->AgValue {
 if depth>=AG_type_limit()-1 || !AG_tick(state,id) {SC_fail(state,SC_LIMIT,id);return AgValue.{};}n:=nodes[id];
 if n.kind==29 {at:=n.head;first:=true;result:AgValue;while at!=0 {item:=AG_literal_field(nodes,values,at,field,state,depth+1);if first {result=item;first=false;}else {bounds:=AG_join_bounds(result,item);result.known=bounds.known;result.lo=bounds.lo;result.hi=bounds.hi;}at=nodes[at].next;}return result;}
 if n.kind!=28 {SC_fail(state,SC_GRAPH,id);return AgValue.{};}at:=n.head;
 while at!=0 {if !AG_tick(state,at) {return AgValue.{};}if nodes[at].kind!=71 {SC_fail(state,SC_GRAPH,at);return AgValue.{};}if nodes[at].name==field.name {v:=nodes[at].a;if nodes[v].kind==16 && values[v]<=cast(u64)AG_interval_limit() {return AG_number(cast(int)values[v]);}return AgValue.{};}at=nodes[at].next;}
 if field.b==0 {return AG_number(0);}return AgValue.{};
}
AG_expr :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int)->AgValue {
 if !AG_tick(state,id) {return AgValue.{};}if id==0 || depth>=16 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}n:=nodes[id];
 if n.kind==16 || n.kind==18 {if n.kind==18 && values[id]>1 {SC_fail(state,SC_GRAPH,id);return AgValue.{};}r:=AgValue.{type=ifx n.kind==18 then -3 else -4};if values[id]<=cast(u64)AG_interval_limit() {r.known=true;r.lo=cast(int)values[id];r.hi=r.lo;}if n.kind==16 {r=AG_with(r,values[id],values[id]);}return r;}
 // Only the checked-source driver may attest that the pinned compiler has
 // successfully evaluated the same source graph. No value or type is guessed.
 // An attested compile-time call is a public constant of its procedure's
 // declared result type; any other run expression has no type.
 if n.kind==24 {if !memory[0].compiled_runs {SC_fail(state,SC_UNSUPPORTED,id);return AgValue.{};}
  if nodes[n.a].kind==21 {d:=AG_decl(nodes,roots,nodes[n.a].name,state);if nodes[d].kind==64 {return AG_new(nodes,values,roots,AgValue.{},nodes[d].a,memory,state);}}
  return AgValue.{};}
 if n.kind==20 {slot:=AG_slot(env,n.name);if slot>=0 {return env[0].bindings[slot].value;}d:=AG_decl(nodes,roots,n.name,state);if nodes[d].kind!=65 {SC_fail(state,SC_CALL,id);return AgValue.{};}empty:[1]AgEnv;return AG_expr(nodes,values,roots,types,nodes[d].a,empty[..],memory,state,depth+1);}
 if n.kind==22 {a:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);r:=AG_unranged(a);r.mask=AG_origin(a,memory);r.region=0;r.literal=0;if (n.op!=35 && n.op!=52) || (n.op==35 && r.mask!=0) {SC_fail(state,SC_UNSUPPORTED,id);return r;}
  if n.op==52 {r.type=-3;if a.known {r.lo=ifx a.hi==0 then 1 else 0;r.hi=ifx a.lo!=0 then 0 else 1;}}
  else {r.known=false;}return r;}
 if n.kind==23 {a:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);b:=AG_expr(nodes,values,roots,types,n.b,env,memory,state,depth+1);return AG_binary(a,b,n.op,memory,state,id);}
 if n.kind==30 {r:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);if AG_primitive_name(r.type)=="" {SC_fail(state,SC_UNSUPPORTED,id);return AgValue.{};}r.mask=AG_origin(r,memory);fits:=AG_fits(r,AG_cast_primitive(nodes,n.d));if r.mask!=0 && !n.flag && !AG_contained(r.type,AG_cast_primitive(nodes,n.d)) && !fits {SC_fail(state,SC_UNSUPPORTED,id);return AgValue.{};}r.region=0;if fits {r=AG_with(r,AG_lo(r),AG_hi(r));}else {r=AG_unranged(r);}r.type=AG_type(nodes,roots,n.d,state);if r.type==-5 && r.known && (r.lo<0 || r.hi>255) {r.known=false;}return r;}
 if n.kind==31 {condition:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);if AG_origin(condition,memory)!=0 {SC_fail(state,SC_BRANCH,id);return AgValue.{};}
  a:=AG_expr(nodes,values,roots,types,n.b,env,memory,state,depth+1);b:=AG_expr(nodes,values,roots,types,n.c,env,memory,state,depth+1);if condition.known && condition.lo==condition.hi {return ifx condition.lo!=0 then a else b;}return AG_union(a,b,memory);}
 if n.kind==25 {base:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);
  if SC_ref(base.type,nodes.count) && (nodes[base.type].kind==2 || nodes[base.type].kind==3) && n.name=="count" {if base.extent<1 {SC_fail(state,SC_TYPE,id);return AgValue.{};}return AG_number(base.extent);}
  field:=AG_field(nodes,base.type,n.name,state);r:=AG_unranged(base);r.mask=AG_read_mask(base,memory);shadow:=AG_shadow(memory,base.region,field);if shadow!=0 {r.region=shadow;}r.type=AG_type(nodes,roots,nodes[field].a,state);r.literal=0;r.known=false;r.view=false;r.extent=0;
