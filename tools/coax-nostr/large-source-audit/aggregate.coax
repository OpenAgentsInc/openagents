 nodes[2]=ScNode.{kind=2,a=3,b=5};nodes[3]=ScNode.{kind=16};values[3]=5000;nodes[4]=ScNode.{kind=2,a=6,b=5};nodes[5]=ScNode.{kind=1,name="u64"};nodes[6]=ScNode.{kind=16};values[6]=2;
 for i:10..<17 {nodes[i]=ScNode.{kind=2,a=18,b=i+1};}nodes[17]=ScNode.{kind=1,name="u64"};nodes[18]=ScNode.{kind=16};values[18]=1;
 p:=ScNode.{name="f",line=1};n:=ScNode.{name="a",line=1};
 types:=[2]ScType.[ScType.{procedure="f",procedure_line=1,name="a",line=1,role="parameter",type="[2] u64"},ScType.{procedure="f",procedure_line=1,name="b",line=1,role="parameter",type="[1] [1] [1] [1] [1] [1] [1] u64"}];
