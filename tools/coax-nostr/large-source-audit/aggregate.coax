// Before a loop, conservatively taint writable outer scalars and all outer
// aggregate regions by all incoming data. This over-approximates backedges and
// direct-callee view writes, rather than trusting one iteration as a fixed point.
AG_loop_marks :: (nodes:[]ScNode,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,mask:u64,depth:int) {
 if depth>=16 || !AG_tick(state,id) {SC_fail(state,SC_LIMIT,id);return;}n:=nodes[id];
 // A view with public fields keeps its taint in its region, which the loop
 // has already tainted; its shadows reach their fixed point in AG_loop_body.
 if n.kind==43 {root:=AG_target_root(nodes,n.c,state);slot:=AG_slot(env,nodes[root].name);if slot>=0 {if !AG_sensitive(memory,env[0].bindings[slot].value.region) {env[0].bindings[slot].value.mask|=mask;}env[0].bindings[slot].value.known=false;env[0].bindings[slot].value=AG_unranged(env[0].bindings[slot].value);}}
