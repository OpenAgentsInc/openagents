// Separate aggregate source analysis. It never upgrades the scalar-v1 profile.
#load "../../../coax/lib/crypto/secret-flow.coax";
#load "../../../coax/tests/nostr/secret_aggregate.coax";
#load "../../../coax/tests/nostr/secret_aggregate_cases.coax";
#authority;
AG_GUARDS :: 14;
AgValue :: struct {mask:u64;type:int;literal:int;lo:int;hi:int;known:bool;region:int;extent:int;view:bool;}
AgBinding :: struct {name:string;value:AgValue;induction:bool;}
AgEnv :: struct {bindings:[64]AgBinding;count:int;procedure:int;}
AgGuard :: struct {node:int;unit:int;line:int;column:int;mask:u64;kind:u32;}
AgMemory :: struct {taint:[4096]u64;dirty:[4096]bool;used:int;guard_count:int;guards:[256]AgGuard;}
AgBlock :: struct {value:AgValue;returned:bool;}
#test "aggregate source bounds and scalar identities are explicit" {
 #assert AG_primitive("u64")==-1 && AG_primitive("u32")==-2 && AG_primitive("bool")==-3 && AG_primitive("int")==-4 && AG_primitive("u8")==-5;
 #assert AG_primitive("f64")==0 && AG_primitive("string")==0;
 #assert AG_interval(0,4096) && !AG_interval(-1,1) && !AG_interval(0,4097) && !AG_interval(2,1);
}
AG_primitive :: (name:string)->int {if name=="u64" {return -1;}if name=="u32" {return -2;}if name=="bool" {return -3;}if name=="int" {return -4;}if name=="u8" {return -5;}return 0;}
AG_type_limit :: ()->int {return 8;}
AG_array_limit :: ()->int {return 1024;}
AG_interval_limit :: ()->int {return 4096;}
AG_interval :: (lo:int,hi:int)->bool {return lo>=0 && lo<=hi && hi<=AG_interval_limit();}
AG_number :: (value:int)->AgValue {return AgValue.{type=-4,lo=value,hi=value,known=true};}
AG_origin :: (value:AgValue,memory:[]AgMemory)->u64 {if value.region!=0 {return value.mask|memory[0].taint[value.region];}return value.mask;}
AG_slot :: (env:[]AgEnv,name:string)->int {for i:0..<env[0].count {if env[0].bindings[i].name==name {return i;}}return -1;}
AG_struct :: (nodes:[]ScNode,roots:[]int,name:string,state:[]ScAudit)->int {
 found:=0;for root:roots {id:=nodes[root].head;while id!=0 {if !AG_tick(state,id) {return 0;}if nodes[id].kind==66 && nodes[id].name==name {if found!=0 {SC_fail(state,SC_GRAPH,id);return 0;}found=id;}id=nodes[id].next;}}return found;
}
AG_type :: (nodes:[]ScNode,roots:[]int,id:int,state:[]ScAudit)->int {
 if id<0 {if id>=-5 {return id;}SC_fail(state,SC_TYPE,0);return 0;}
 n:=nodes[id];if n.kind==1 {p:=AG_primitive(n.name);if p!=0 {return p;}s:=AG_struct(nodes,roots,n.name,state);if s!=0 {return s;}}
 else if n.kind==2 || n.kind==3 || n.kind==66 {return id;}SC_fail(state,SC_TYPE,id);return 0;
}
AG_element :: (nodes:[]ScNode,roots:[]int,type:int,state:[]ScAudit)->int {
 if !SC_ref(type,nodes.count) || (nodes[type].kind!=2 && nodes[type].kind!=3) {SC_fail(state,SC_TYPE,0);return 0;}return AG_type(nodes,roots,nodes[type].b,state);
}
AG_length :: (nodes:[]ScNode,values:[]u64,type:int,state:[]ScAudit)->int {
 if SC_ref(type,nodes.count) && nodes[type].kind==2 && nodes[nodes[type].a].kind==16 && values[nodes[type].a]>=1 && values[nodes[type].a]<=cast(u64)AG_array_limit() {return cast(int)values[nodes[type].a];}SC_fail(state,SC_TYPE,0);return 0;
}
AG_field :: (nodes:[]ScNode,type:int,name:string,state:[]ScAudit)->int {
 if !SC_ref(type,nodes.count) || nodes[type].kind!=66 {SC_fail(state,SC_TYPE,0);return 0;}field:=nodes[type].head;
 while field!=0 {if !AG_tick(state,field) {return 0;}if nodes[field].kind!=69 {SC_fail(state,SC_TYPE,field);return 0;}if nodes[field].name==name {return field;}field=nodes[field].next;}SC_fail(state,SC_TYPE,type);return 0;
}
AG_match :: (nodes:[]ScNode,values:[]u64,roots:[]int,type:int,name:string,state:[]ScAudit,depth:int)->bool {
 if depth>=AG_type_limit() {return false;}resolved:=AG_type(nodes,roots,type,state);if resolved<0 {return AG_primitive(name)==resolved;}
 n:=nodes[resolved];if n.kind==66 {return name==n.name;}
 if name.count<3 || name[0]!=91 {return false;}at:=1;length:=0;
 while at<name.count && name[at]>=48 && name[at]<=57 {digit:=cast(int)name[at]-48;if length>(AG_array_limit()-digit)/10 {SC_fail(state,SC_LIMIT,0);return false;}length=length*10+digit;at+=1;}
 if at>=name.count || name[at]!=93 {return false;}
 if n.kind==2 {if at==1 || AG_length(nodes,values,resolved,state)!=length {return false;}}
 else if n.kind!=3 || at!=1 {return false;}
 inner:=at+1;if inner<name.count && name[inner]==32 {inner+=1;}return AG_match(nodes,values,roots,n.b,name[inner..<name.count],state,depth+1);
}
AG_resolved :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,p:ScNode,n:ScNode,role:string,state:[]ScAudit)->int {
 count:=0;name:string;for row:types {if row.unit==p.unit && row.procedure==p.name && row.procedure_line==p.line && row.name==n.name && row.line==n.line && row.role==role {count+=1;name=row.type;}}
 if count!=1 {SC_fail(state,SC_TYPE,0);return 0;}primitive:=AG_primitive(name);if primitive!=0 {return primitive;}structure:=AG_struct(nodes,roots,name,state);if structure!=0 {return structure;}
 for node,index:nodes {if node.kind==2 || node.kind==3 {if AG_match(nodes,values,roots,index,name,state,0) {return index;}}}SC_fail(state,SC_TYPE,0);return 0;
}
AG_new :: (nodes:[]ScNode,values:[]u64,roots:[]int,value:AgValue,type:int,memory:[]AgMemory,state:[]ScAudit)->AgValue {
 result:=value;result.mask=AG_origin(value,memory);result.type=AG_type(nodes,roots,type,state);result.region=0;result.view=false;
 // A copied or borrowed aggregate cannot recover facts from its original
 // literal after any write through its source region, even a public write.
 if value.region!=0 && memory[0].dirty[value.region] {result.literal=0;}
 if !AG_valid_type(nodes,values,roots,result.type,result.mask!=0,state,0) {SC_fail(state,SC_TYPE,0);return result;}
 if AG_primitive_name(result.type)=="" {n:=nodes[result.type];if n.kind==3 {if value.region==0 || value.extent<1 {SC_fail(state,SC_UNSUPPORTED,type);return result;}result.region=value.region;result.view=true;}
 else {if memory[0].used==4095 {SC_fail(state,SC_LIMIT,type);return result;}memory[0].used+=1;result.region=memory[0].used;memory[0].taint[result.region]=result.mask;if n.kind==2 {result.extent=AG_length(nodes,values,result.type,state);}}}
 return result;
}
AG_bind :: (env:[]AgEnv,name:string,value:AgValue,state:[]ScAudit,where:int) {
 if env[0].count==64 || AG_slot(env,name)>=0 {SC_fail(state,SC_UNSUPPORTED,where);return;}at:=env[0].count;env[0].bindings[at]=AgBinding.{name=name,value=value};env[0].count+=1;
}
AG_guard :: (nodes:[]ScNode,memory:[]AgMemory,state:[]ScAudit,id:int,mask:u64) {
 for i:0..<memory[0].guard_count {if memory[0].guards[i].node==id {memory[0].guards[i].mask|=mask;return;}}
 if memory[0].guard_count==256 {SC_fail(state,SC_LIMIT,id);return;}n:=nodes[id];at:=memory[0].guard_count;memory[0].guards[at]=AgGuard.{node=id,unit=n.unit,line=n.line,column=n.column,mask=mask,kind=1};memory[0].guard_count+=1;
}
AG_union :: (a:AgValue,b:AgValue,memory:[]AgMemory)->AgValue {
 r:=a;r.mask=AG_origin(a,memory)|AG_origin(b,memory);r.region=0;r.literal=0;bounds:=AG_join_bounds(a,b);r.known=bounds.known;r.lo=bounds.lo;r.hi=bounds.hi;return r;
}

AG_valid_type :: (nodes:[]ScNode,values:[]u64,roots:[]int,type:int,secret:bool,state:[]ScAudit,depth:int)->bool {
 if depth>=AG_type_limit() {return false;}t:=AG_type(nodes,roots,type,state);if t<0 {return t!=-4 || !secret;}
 n:=nodes[t];if n.kind==2 {length:=AG_length(nodes,values,t,state);return length>0 && AG_valid_type(nodes,values,roots,n.b,secret,state,depth+1);}
 if n.kind==3 {if depth!=0 {return false;}return AG_valid_type(nodes,values,roots,n.b,secret,state,depth+1);}
 field:=n.head;count:=0;while field!=0 {if !AG_tick(state,field) {return false;}if nodes[field].kind!=69 {return false;}count+=1;if count>64 {return false;}if !AG_valid_type(nodes,values,roots,nodes[field].a,secret,state,depth+1) {return false;}field=nodes[field].next;}return count>0;
}

AG_binary :: (a:AgValue,b:AgValue,op:u32,memory:[]AgMemory,state:[]ScAudit,id:int)->AgValue {
 r:=AgValue.{mask=AG_origin(a,memory)|AG_origin(b,memory),type=a.type};if a.type==-4 {r.type=b.type;}
 if (op==50 || op==51) && AG_origin(a,memory)!=0 {SC_fail(state,SC_BRANCH,id);}
 if (op==42 || op==43) && AG_origin(b,memory)!=0 {SC_fail(state,SC_SHIFT,id);}
 if (op==37 || op==38) && r.mask!=0 {SC_fail(state,SC_UNSUPPORTED,id);}
 if op<34 || op>51 {SC_fail(state,SC_UNSUPPORTED,id);return r;}
 if op>=44 {r.type=-3;r.known=true;r.hi=1;}
 if a.known && b.known {
  if op==34 {r.lo=a.lo+b.lo;r.hi=a.hi+b.hi;r.known=AG_interval(r.lo,r.hi);}
  else if op==35 {r.lo=a.lo-b.hi;r.hi=a.hi-b.lo;r.known=AG_interval(r.lo,r.hi);}
  else if op==36 {r.lo=a.lo*b.lo;r.hi=a.hi*b.hi;r.known=AG_interval(r.lo,r.hi);}
  else if op==37 && b.lo>0 {r.lo=a.lo/b.hi;r.hi=a.hi/b.lo;r.known=AG_interval(r.lo,r.hi);}
  else if op==38 && b.lo>0 {r.hi=b.hi-1;r.known=AG_interval(r.lo,r.hi);}
  else if op==44 {if a.lo==a.hi && b.lo==b.hi && a.lo==b.lo {r.lo=1;}else if a.hi<b.lo || b.hi<a.lo {r.hi=0;}}
  else if op==45 {if a.lo==a.hi && b.lo==b.hi && a.lo==b.lo {r.hi=0;}else if a.hi<b.lo || b.hi<a.lo {r.lo=1;}}
  else if op==46 {if a.hi<b.lo {r.lo=1;}else if a.lo>=b.hi {r.hi=0;}}
  else if op==47 {if a.hi<=b.lo {r.lo=1;}else if a.lo>b.hi {r.hi=0;}}
  else if op==48 {if a.lo>b.hi {r.lo=1;}else if a.hi<=b.lo {r.hi=0;}}
  else if op==49 {if a.lo>=b.hi {r.lo=1;}else if a.hi<b.lo {r.hi=0;}}
  else if op==50 {if a.lo!=0 && b.lo!=0 {r.lo=1;}else if a.hi==0 || b.hi==0 {r.hi=0;}}
  else if op==51 {if a.lo!=0 || b.lo!=0 {r.lo=1;}else if a.hi==0 && b.hi==0 {r.hi=0;}}
 }
 // Byte arithmetic can wrap in release builds. Bounds outside the byte range
 // cannot be used to eliminate a branch or establish an index.
 if r.type==-5 && r.known && r.hi>255 {r.known=false;}
 return r;
}
AG_literal_field :: (nodes:[]ScNode,values:[]u64,id:int,field:ScNode,state:[]ScAudit,depth:int)->AgValue {
 if depth>=AG_type_limit()-1 || !AG_tick(state,id) {SC_fail(state,SC_LIMIT,id);return AgValue.{};}n:=nodes[id];
 if n.kind==29 {at:=n.head;first:=true;result:AgValue;while at!=0 {item:=AG_literal_field(nodes,values,at,field,state,depth+1);if first {result=item;first=false;}else {bounds:=AG_join_bounds(result,item);result.known=bounds.known;result.lo=bounds.lo;result.hi=bounds.hi;}at=nodes[at].next;}return result;}
 if n.kind!=28 {SC_fail(state,SC_GRAPH,id);return AgValue.{};}at:=n.head;
 while at!=0 {if !AG_tick(state,at) {return AgValue.{};}if nodes[at].kind!=71 {SC_fail(state,SC_GRAPH,at);return AgValue.{};}if nodes[at].name==field.name {v:=nodes[at].a;if nodes[v].kind==16 && values[v]<=cast(u64)AG_interval_limit() {return AG_number(cast(int)values[v]);}return AgValue.{};}at=nodes[at].next;}
 if field.b==0 {return AG_number(0);}return AgValue.{};
}
AG_expr :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int)->AgValue {
 if !AG_tick(state,id) {return AgValue.{};}if id==0 || depth>=16 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}n:=nodes[id];
 if n.kind==16 || n.kind==18 {if n.kind==18 && values[id]>1 {SC_fail(state,SC_GRAPH,id);return AgValue.{};}r:=AgValue.{type=ifx n.kind==18 then -3 else -4};if values[id]<=cast(u64)AG_interval_limit() {r.known=true;r.lo=cast(int)values[id];r.hi=r.lo;}return r;}
 if n.kind==20 {slot:=AG_slot(env,n.name);if slot>=0 {return env[0].bindings[slot].value;}d:=AG_decl(nodes,roots,n.name,state);if nodes[d].kind!=65 {SC_fail(state,SC_CALL,id);return AgValue.{};}empty:[1]AgEnv;return AG_expr(nodes,values,roots,types,nodes[d].a,empty[..],memory,state,depth+1);}
 if n.kind==22 {a:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);r:=a;r.mask=AG_origin(a,memory);r.region=0;r.literal=0;if n.op!=35 && n.op!=52 {SC_fail(state,SC_UNSUPPORTED,id);return r;}
  if n.op==52 {r.type=-3;if a.known {r.lo=ifx a.hi==0 then 1 else 0;r.hi=ifx a.lo!=0 then 0 else 1;}}
  else {r.known=false;}return r;}
 if n.kind==23 {a:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);b:=AG_expr(nodes,values,roots,types,n.b,env,memory,state,depth+1);return AG_binary(a,b,n.op,memory,state,id);}
 if n.kind==30 {r:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);if AG_primitive_name(r.type)=="" {SC_fail(state,SC_UNSUPPORTED,id);return AgValue.{};}r.mask=AG_origin(r,memory);r.region=0;r.type=AG_type(nodes,roots,n.d,state);if r.type==-5 && r.known && (r.lo<0 || r.hi>255) {r.known=false;}return r;}
 if n.kind==31 {condition:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);if AG_origin(condition,memory)!=0 {SC_fail(state,SC_BRANCH,id);return AgValue.{};}
  a:=AG_expr(nodes,values,roots,types,n.b,env,memory,state,depth+1);b:=AG_expr(nodes,values,roots,types,n.c,env,memory,state,depth+1);if condition.known && condition.lo==condition.hi {return ifx condition.lo!=0 then a else b;}return AG_union(a,b,memory);}
 if n.kind==25 {base:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);
  if SC_ref(base.type,nodes.count) && (nodes[base.type].kind==2 || nodes[base.type].kind==3) && n.name=="count" {if base.extent<1 {SC_fail(state,SC_TYPE,id);return AgValue.{};}return AG_number(base.extent);}
  field:=AG_field(nodes,base.type,n.name,state);r:=base;r.mask=AG_origin(base,memory);r.type=AG_type(nodes,roots,nodes[field].a,state);r.literal=0;r.known=false;r.view=false;r.extent=0;
  if SC_ref(r.type,nodes.count) && nodes[r.type].kind==2 {r.extent=AG_length(nodes,values,r.type,state);}
  if base.literal!=0 && (base.region==0 || !memory[0].dirty[base.region]) {bounds:=AG_literal_field(nodes,values,base.literal,nodes[field],state,0);r.known=bounds.known;r.lo=bounds.lo;r.hi=bounds.hi;}return r;}
 if n.kind==26 || n.kind==27 {base:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,depth+1);lo:=AG_number(0);if n.b!=0 {lo=AG_expr(nodes,values,roots,types,n.b,env,memory,state,depth+1);}
  if AG_origin(lo,memory)!=0 {SC_fail(state,SC_INDEX,id);return AgValue.{};}element:=AG_element(nodes,roots,base.type,state);if base.extent<1 {SC_fail(state,SC_TYPE,id);return AgValue.{};}
  if n.kind==26 {if !lo.known || lo.lo<0 || lo.hi>=base.extent {SC_fail(state,SC_LIMIT,id);}r:=base;r.mask=AG_origin(base,memory);r.type=element;r.extent=0;r.view=false;r.known=false;return r;}
  hi:=AG_number(base.extent);if n.c!=0 {hi=AG_expr(nodes,values,roots,types,n.c,env,memory,state,depth+1);}if AG_origin(hi,memory)!=0 {SC_fail(state,SC_INDEX,id);}
  if !lo.known || !hi.known || lo.lo!=lo.hi || hi.lo!=hi.hi || lo.lo<0 || hi.lo<lo.lo || hi.lo>base.extent || base.region==0 {SC_fail(state,SC_UNSUPPORTED,id);return AgValue.{};}
  r:=base;r.mask=AG_origin(base,memory);r.extent=hi.lo-lo.lo;r.view=true;r.literal=0;r.known=false;return r;}
 if n.kind==28 || n.kind==29 {r:=AgValue.{type=AG_type(nodes,roots,n.d,state),literal=id};at:=n.head;
  while at!=0 {if !AG_tick(state,at) {break;}if n.kind==28 && nodes[at].kind!=71 {SC_fail(state,SC_GRAPH,at);break;}value:=ifx n.kind==28 then nodes[at].a else at;item:=AG_expr(nodes,values,roots,types,value,env,memory,state,depth+1);r.mask|=AG_origin(item,memory);at=nodes[at].next;}
  if !AG_valid_type(nodes,values,roots,r.type,r.mask!=0,state,0) {SC_fail(state,SC_TYPE,id);}if n.kind==29 {r.extent=AG_length(nodes,values,r.type,state);}return r;}
 if n.kind==21 {return AG_call(nodes,values,roots,types,id,env,memory,state,depth+1);}
 SC_fail(state,SC_UNSUPPORTED,id);return AgValue.{};
}
AG_public_only :: (name:string)->bool {return SC_vartime(name) || (name.count>=7 && name[name.count-7..<name.count]=="_public");}
AG_call :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int)->AgValue {
 n:=nodes[id];if AG_public_only(n.name) {SC_fail(state,SC_VARTIME,id);return AgValue.{};}args:[8]AgValue;count:=0;at:=n.head;
 while at!=0 {if count==8 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}args[count]=AG_expr(nodes,values,roots,types,at,env,memory,state,depth);count+=1;at=nodes[at].next;if state[0].error!=0 {return AgValue.{};}}
 d:=AG_decl(nodes,roots,n.name,state);builtin:=SC_builtin(n.name);if AG_slot(env,n.name)>=0 {SC_fail(state,SC_CALL,id);return AgValue.{};}
 if builtin!=0 {
  if d!=0 || count!=ifx builtin==1 then 1 else 2 {SC_fail(state,SC_CALL,id);return AgValue.{};}
  r:=args[0];r.mask=AG_origin(r,memory);r.region=0;r.known=false;r.literal=0;
  if builtin!=1 {r.mask|=AG_origin(args[1],memory);if builtin==3 && AG_origin(args[1],memory)!=0 {SC_fail(state,SC_SHIFT,id);}}return r;
 }
 if nodes[d].kind!=64 {SC_fail(state,SC_CALL,id);return AgValue.{};}return AG_procedure(nodes,values,roots,types,d,args[0..<count],memory,state);
}
AG_target_root :: (nodes:[]ScNode,id:int,state:[]ScAudit)->int {
 at:=id;for i:0..<16 {if !AG_tick(state,at) {return 0;}if nodes[at].kind==20 {return at;}if nodes[at].kind!=25 && nodes[at].kind!=26 {SC_fail(state,SC_UNSUPPORTED,at);return 0;}at=nodes[at].a;}SC_fail(state,SC_LIMIT,id);return 0;
}
AG_write :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,rhs:AgValue,op:u32,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit) {
 target:=AG_expr(nodes,values,roots,types,id,env,memory,state,0);mask:=AG_origin(rhs,memory);
 if op<23 || op>33 {SC_fail(state,SC_UNSUPPORTED,id);return;}
 if (op==32 || op==33) && mask!=0 {SC_fail(state,SC_SHIFT,id);}
 if (op==27 || op==28) && (mask|AG_origin(target,memory))!=0 {SC_fail(state,SC_UNSUPPORTED,id);}
 root:=AG_target_root(nodes,id,state);slot:=AG_slot(env,nodes[root].name);if slot<0 {SC_fail(state,SC_CALL,id);return;}if env[0].bindings[slot].induction {SC_fail(state,ifx mask!=0 then SC_BRANCH else SC_UNSUPPORTED,id);return;}
 if nodes[id].kind==20 && target.view {SC_fail(state,SC_UNSUPPORTED,id);return;}
 if nodes[id].kind==20 && AG_primitive_name(target.type)!="" {r:=rhs;r.mask=mask;r.region=0;r.literal=0;if op!=23 {r=AG_binary(target,rhs,op+10,memory,state,id);}
  r.type=target.type;env[0].bindings[slot].value=r;return;}
 if target.region==0 {SC_fail(state,SC_UNSUPPORTED,id);return;}
 memory[0].taint[target.region]|=mask;memory[0].dirty[target.region]=true;
}
// Before a loop, conservatively taint writable outer scalars and all outer
// aggregate regions by all incoming data. This over-approximates backedges and
// direct-callee view writes, rather than trusting one iteration as a fixed point.
AG_loop_marks :: (nodes:[]ScNode,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,mask:u64,depth:int) {
 if depth>=16 || !AG_tick(state,id) {SC_fail(state,SC_LIMIT,id);return;}n:=nodes[id];
 if n.kind==43 {root:=AG_target_root(nodes,n.c,state);slot:=AG_slot(env,nodes[root].name);if slot>=0 {env[0].bindings[slot].value.mask|=mask;env[0].bindings[slot].value.known=false;}}
 if n.kind==40 {at:=n.head;while at!=0 {AG_loop_marks(nodes,at,env,memory,state,mask,depth+1);at=nodes[at].next;}}
 else if n.kind==47 || n.kind==45 {AG_loop_marks(nodes,n.c,env,memory,state,mask,depth+1);if n.d!=0 {AG_loop_marks(nodes,n.d,env,memory,state,mask,depth+1);}}
}
AG_block :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,env:[]AgEnv,memory:[]AgMemory,state:[]ScAudit,depth:int)->AgBlock {
 if depth>=16 || !AG_tick(state,id) {SC_fail(state,SC_LIMIT,id);return AgBlock.{};}if nodes[id].kind!=40 {SC_fail(state,SC_UNSUPPORTED,id);return AgBlock.{};}
 at:=nodes[id].head;result:AgBlock;
 while at!=0 && state[0].error==0 {if !AG_tick(state,at) {break;}n:=nodes[at];if result.returned {SC_fail(state,SC_UNSUPPORTED,at);break;}
  if n.kind==42 {if n.flag {SC_fail(state,SC_UNSUPPORTED,at);break;}type:=AG_resolved(nodes,values,roots,types,nodes[env[0].procedure],n,"local",state);r:=AG_number(0);if n.a!=0 {r=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);}r=AG_new(nodes,values,roots,r,type,memory,state);AG_bind(env,n.name,r,state,at);}
  else if n.kind==43 {r:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);AG_write(nodes,values,roots,types,n.c,r,n.op,env,memory,state);}
  else if n.kind==44 {result.value=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);result.returned=true;}
  else if n.kind==52 {r:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);mask:=AG_origin(r,memory);if mask==0 && r.known && r.hi==0 {SC_fail(state,SC_UNSUPPORTED,at);}else if mask!=0 || !r.known || r.lo!=1 {AG_guard(nodes,memory,state,at,mask);}}
  else if n.kind==45 {condition:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);if AG_origin(condition,memory)!=0 {SC_fail(state,SC_BRANCH,at);break;}if !condition.known || condition.lo!=condition.hi {SC_fail(state,SC_UNSUPPORTED,at);break;}
   branch:=ifx condition.lo!=0 then n.c else n.d;if branch!=0 {saved:=env[0].count;if nodes[branch].kind!=40 {SC_fail(state,SC_UNSUPPORTED,branch);break;}result=AG_block(nodes,values,roots,types,branch,env,memory,state,depth+1);env[0].count=saved;}}
  else if n.kind==46 {condition:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);SC_fail(state,ifx AG_origin(condition,memory)!=0 then SC_BRANCH else SC_UNSUPPORTED,at);}
  else if n.kind==47 {start:=AG_expr(nodes,values,roots,types,n.a,env,memory,state,0);end:=AG_expr(nodes,values,roots,types,n.b,env,memory,state,0);
   if (AG_origin(start,memory)|AG_origin(end,memory))!=0 {SC_fail(state,SC_BRANCH,at);break;}
   if !start.known || !end.known || !AG_interval(start.lo,end.hi) {SC_fail(state,SC_LIMIT,at);break;}
   // The body is analyzed once; it cannot represent the unchanged state of a
   // zero-trip execution. Refuse unless every admitted range is nonempty.
   if start.hi>=end.lo {SC_fail(state,SC_UNSUPPORTED,at);break;}
   incoming:=cast(u64)0;for i:0..<env[0].count {incoming|=AG_origin(env[0].bindings[i].value,memory);}
   for i:0..<env[0].count {region:=env[0].bindings[i].value.region;if region!=0 {memory[0].taint[region]|=incoming;memory[0].dirty[region]=true;}}
   AG_loop_marks(nodes,n.c,env,memory,state,incoming,0);saved:=env[0].count;
   loop_type:=AG_resolved(nodes,values,roots,types,nodes[env[0].procedure],n,"loop",state);if loop_type!=-4 {SC_fail(state,SC_TYPE,at);break;}
   loop:=AgValue.{type=loop_type,lo=start.lo,hi=end.hi-1,known=true};AG_bind(env,n.name,loop,state,at);if env[0].count>saved {env[0].bindings[saved].induction=true;}
   part:=AG_block(nodes,values,roots,types,n.c,env,memory,state,depth+1);env[0].count=saved;if part.returned {SC_fail(state,SC_UNSUPPORTED,at);}
  }
  else {SC_fail(state,SC_UNSUPPORTED,at);}at=n.next;
 }
 return result;
}
AG_procedure :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,id:int,args:[]AgValue,memory:[]AgMemory,state:[]ScAudit)->AgValue {
 if !AG_tick(state,id) {return AgValue.{};}if state[0].depth==16 || args.count>8 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}
 for i:0..<state[0].depth {if state[0].stack[i]==id {SC_fail(state,SC_RECURSION,id);return AgValue.{};}}
 p:=nodes[id];if p.kind!=64 || p.flag2 {SC_fail(state,SC_CALL,id);return AgValue.{};}if AG_public_only(p.name) {SC_fail(state,SC_VARTIME,id);return AgValue.{};}
 seen:=false;for i:0..<state[0].count {if state[0].seen[i]==id {seen=true;}}if !seen {if state[0].count==64 {SC_fail(state,SC_LIMIT,id);return AgValue.{};}state[0].seen[state[0].count]=id;state[0].count+=1;}
 state[0].stack[state[0].depth]=id;state[0].depth+=1;env:=[1]AgEnv.[AgEnv.{procedure=id}];at:=p.head;count:=0;
 while at!=0 {if !AG_tick(state,at) {return AgValue.{};}if count>=args.count || nodes[at].kind!=68 {SC_fail(state,SC_CALL,at);return AgValue.{};}
  type:=AG_resolved(nodes,values,roots,types,p,nodes[at],"parameter",state);if !AG_match(nodes,values,roots,nodes[at].a,AG_parameter_name(types,p,nodes[at]),state,0) {SC_fail(state,SC_TYPE,at);}
  value:=AG_new(nodes,values,roots,args[count],type,memory,state);AG_bind(env[..],nodes[at].name,value,state,at);count+=1;at=nodes[at].next;
 }
 if count!=args.count {SC_fail(state,SC_CALL,id);return AgValue.{};}block:=AG_block(nodes,values,roots,types,p.b,env[..],memory,state,0);if !block.returned {SC_fail(state,SC_UNSUPPORTED,id);}
 result:=AG_new(nodes,values,roots,block.value,p.a,memory,state);if result.view {SC_fail(state,SC_UNSUPPORTED,id);}state[0].depth-=1;return result;
}
AG_primitive_name :: (type:int)->string {if type==-1 {return "u64";}if type==-2 {return "u32";}if type==-3 {return "bool";}if type==-4 {return "int";}if type==-5 {return "u8";}return "";}
AG_parameter_name :: (types:[]ScType,p:ScNode,n:ScNode)->string {for t:types {if t.unit==p.unit && t.procedure==p.name && t.procedure_line==p.line && t.name==n.name && t.line==n.line && t.role=="parameter" {return t.type;}}return "";}
AG_check :: (nodes:[]ScNode,values:[]u64,roots:[]int,types:[]ScType,entry:string,memory:[]AgMemory)->ScResult #export_c {
 if !SC_shape(nodes,roots,types) || values.count!=nodes.count || memory.count!=1 {return ScResult.{error=SC_GRAPH,unit=-1};}memory[0]=AgMemory.{};
 state:[1]ScAudit;id:=AG_decl(nodes,roots,entry,state[..]);if state[0].error!=0 {return ScResult.{error=state[0].error,unit=-1};}if nodes[id].kind!=64 {return ScResult.{error=SC_ENTRY,unit=-1};}args:[8]AgValue;at:=nodes[id].head;count:=0;
 while at!=0 {if !AG_tick(state[..],at) {break;}if count==8 {SC_fail(state[..],SC_LIMIT,id);break;}args[count].mask=cast(u64)1<<count;count+=1;at=nodes[at].next;}
 if count==0 {return ScResult.{error=SC_ENTRY,unit=-1};}r:=AG_procedure(nodes,values,roots,types,id,args[0..<count],memory,state[..]);where:=state[0].where;error:=state[0].error;if error==0 && memory[0].guard_count!=0 {error=AG_GUARDS;}
 return ScResult.{error=error,unit=nodes[where].unit,line=nodes[where].line,column=nodes[where].column,reached=state[0].count,visits=state[0].visits,return_mask=AG_origin(r,memory)};
}

AG_tick :: (state:[]ScAudit,where:int)->bool {
 if state[0].error!=0 {return false;}if state[0].visits>=262144 {SC_fail(state,SC_LIMIT,where);return false;}state[0].visits+=1;return true;
}
AG_decl :: (nodes:[]ScNode,roots:[]int,name:string,state:[]ScAudit)->int {
 found:=0;for root:roots {id:=nodes[root].head;while id!=0 {if !AG_tick(state,id) {return 0;}n:=nodes[id];if (n.kind==64 || n.kind==65) && n.name==name {if found!=0 {SC_fail(state,SC_GRAPH,id);return 0;}found=id;}id=n.next;}}return found;
}

// Public interval arithmetic only. Admitted endpoints are 0..4096, so each
// difference+4096 lies in 0..8192 and the divisor produces an exact 0/1 choice.
AG_join_bounds :: (a:AgValue,b:AgValue)->AgValue {
 r:AgValue;r.known=a.known && b.known && AG_interval(a.lo,a.hi) && AG_interval(b.lo,b.hi);
 if r.known {limit:=AG_interval_limit();r.lo=a.lo-((a.lo-b.lo+limit)/(limit+1))*(a.lo-b.lo);r.hi=b.hi+((a.hi-b.hi+limit)/(limit+1))*(a.hi-b.hi);}return r;
}
