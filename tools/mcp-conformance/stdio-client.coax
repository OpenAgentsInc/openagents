// Dual-era (2025-11-25 + 2026-07-28) Coax MCP stdio client CLI for Phase 2
// interop verification against Coax stdio-server.coax and external stdio servers
// (such as @modelcontextprotocol/server-everything).
//
// Usage:
//   coax/web/tool.sh tools/mcp-conformance/stdio-client.coax \
//     [--legacy-2025] [--call TOOL] [--args JSON] [--resource URI] [--prompt NAME] [--prompt-args JSON] \
//     [--test-cancel] -- CMD [ARGS...]
#load "../../coax/lib/mcp/stdio_client.coax";
#load "../../coax/lib/sys/tool.coax";

CLI_WIRE_MAX :: 262144;
CLI_NODES :: 8192;

mcp_cli_check_ok :: (rc: int, ev: McpClientEvent, label: string) -> bool {
  if rc != MCP_CLI_STDIO_OK {
    tool_errln(label);
    return false;
  }
  if ev.kind != MCP_CLI_EV_RESPONSE_OK {
    tool_errln(label);
    return false;
  }
  return true;
}

tool_main :: () -> int #export_c #effects(all) {
  argc := cxargs_count();
  if argc < 2 {
    tool_errln("usage: stdio-client [--legacy-2025] [--call TOOL] [--args JSON] [--resource URI] [--prompt NAME] [--prompt-args JSON] [--test-cancel] -- CMD [ARGS...]");
    return 2;
  }

  // Parse flags before "--" and child argv after "--" (keeping copies in owned storage).
  arg_buf: [16384] u8;
  arg_used := 0;
  raw_args: [64] string;
  raw_n := 0;
  for i: 1..<argc {
    if raw_n >= 64 { tool_errln("too many args"); return 2; }
    k := cxargs_len(i);
    if k < 0 || arg_used + k > arg_buf.count { tool_errln("args too large"); return 2; }
    for j: 0..<k { arg_buf[arg_used + j] = cast,trunc(u8) cxargs_byte(i, j); }
    raw_args[raw_n] = cast(string) arg_buf[arg_used..<arg_used + k];
    arg_used += k;
    raw_n += 1;
  }

  prefer_2026 := true;
  call_tool := "";
  call_args := "{}";
  read_uri := "";
  prompt_name := "";
  prompt_args := "{}";
  test_cancel := false;
  cmd_start := -1;

  i := 0;
  while i < raw_n {
    s := raw_args[i];
    if s == "--" { cmd_start = i + 1; break; }
    if s == "--legacy-2025" { prefer_2026 = false; i += 1; }
    else if s == "--test-cancel" { test_cancel = true; i += 1; }
    else if s == "--call" && i + 1 < raw_n { call_tool = raw_args[i + 1]; i += 2; }
    else if s == "--args" && i + 1 < raw_n { call_args = raw_args[i + 1]; i += 2; }
    else if s == "--resource" && i + 1 < raw_n { read_uri = raw_args[i + 1]; i += 2; }
    else if s == "--prompt" && i + 1 < raw_n { prompt_name = raw_args[i + 1]; i += 2; }
    else if s == "--prompt-args" && i + 1 < raw_n { prompt_args = raw_args[i + 1]; i += 2; }
    else { tool_errln("unknown option before --"); return 2; }
  }
  if cmd_start < 0 || cmd_start >= raw_n {
    tool_errln("missing -- CMD [ARGS...]");
    return 2;
  }

  cli: [1] McpStdioClient;
  mcp_stdio_client_init(
    cli[..],
    McpImplInfo.{ name = "coax-mcp-stdio-client", version = "0.2.0" },
    McpClientCaps.{ elicitation = true, elicitation_form = true },
    15000
  );

  empty_env: [1] string;
  st := mcp_stdio_client_spawn(cli[..], raw_args[cmd_start..<raw_n], empty_env[0..<0], "");
  if st != 0 {
    print("FAIL spawn errno=%\n", st);
    return 1;
  }

  wire_buf: [CLI_WIRE_MAX] u8;
  scratch: [CLI_WIRE_MAX + 1] u8;
  line_buf: [CLI_WIRE_MAX] u8;
  nodes: [CLI_NODES] JvNode;
  doc: [1] Jv;
  ev: [1] McpClientEvent;
  id_out: [1] int;
  err_buf: [2048] u8;

  rc := mcp_stdio_client_connect(cli[..], prefer_2026, wire_buf[..], scratch[..], line_buf[..], nodes[..], doc[..]);
  if rc != MCP_CLI_STDIO_OK {
    print("FAIL connect rc=% stderr=%\n", rc, mcp_stdio_client_stderr(cli[..], err_buf[..]));
    _ = mcp_stdio_client_close(cli[..], 1000);
    return 1;
  }
  print("CONNECTED mode=% version=% server=%/% tools=% resources=% prompts=%\n",
        ifx cli[0].core[0].modern then "2026-07-28" else "2025-11-25",
        cli[0].core[0].protocol_version,
        cli[0].core[0].server_info.name,
        cli[0].core[0].server_info.version,
        cli[0].core[0].server_caps.tools,
        cli[0].core[0].server_caps.resources,
        cli[0].core[0].server_caps.prompts);

  // 1. tools/list (and verify x-mcp-header validity on every returned tool)
  if cli[0].core[0].server_caps.tools {
    rc = mcp_stdio_client_send_simple(cli[..], "tools/list", "", id_out[..], wire_buf[..], scratch[..]);
    if rc == MCP_CLI_STDIO_OK {
      rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
    }
    if !mcp_cli_check_ok(rc, ev[0], "FAIL tools/list") {
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    tarr := jv_get(doc[0], ev[0].result_node, "tools");
    tcount := jv_len(doc[0], tarr);
    valid_hdrs := 0;
    for k: 0..<tcount {
      if mcp_client_tool_headers_valid(doc[0], jv_at(doc[0], tarr, k)) { valid_hdrs += 1; }
    }
    print("TOOLS count=% valid_headers=%\n", tcount, valid_hdrs);
  }

  // 2. Optional tools/call (with progressToken to exercise progress notifications)
  if call_tool.count > 0 {
    rc = mcp_stdio_client_send_tools_call(cli[..], call_tool, call_args, "pt-1", "", "", id_out[..], wire_buf[..], scratch[..]);
    if rc == MCP_CLI_STDIO_OK {
      rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
    }
    if !mcp_cli_check_ok(rc, ev[0], "FAIL tools/call") {
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    carr := jv_get(doc[0], ev[0].result_node, "content");
    c0 := jv_at(doc[0], carr, 0);
    tbuf: [1024] u8;
    tlen := jv_str(doc[0], jv_get(doc[0], c0, "text"), tbuf[..]);
    txt := ifx tlen >= 0 then cast(string) tbuf[0..<tlen] else "";
    is_err := jv_kind(doc[0], jv_get(doc[0], ev[0].result_node, "isError")) == JV_TRUE;
    print("TOOL_CALL name=% isError=% text=%\n", call_tool, is_err, txt);
  }

  // 3. Optional resources/list + resources/read
  if cli[0].core[0].server_caps.resources {
    rc = mcp_stdio_client_send_simple(cli[..], "resources/list", "", id_out[..], wire_buf[..], scratch[..]);
    if rc == MCP_CLI_STDIO_OK {
      rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
    }
    if !mcp_cli_check_ok(rc, ev[0], "FAIL resources/list") {
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    rarr := jv_get(doc[0], ev[0].result_node, "resources");
    print("RESOURCES count=%\n", jv_len(doc[0], rarr));
  }
  if read_uri.count > 0 {
    rc = mcp_stdio_client_send_resources_read(cli[..], read_uri, "", "", id_out[..], wire_buf[..], scratch[..]);
    if rc == MCP_CLI_STDIO_OK {
      rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
    }
    if !mcp_cli_check_ok(rc, ev[0], "FAIL resources/read") {
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    carr := jv_get(doc[0], ev[0].result_node, "contents");
    c0 := jv_at(doc[0], carr, 0);
    tbuf: [1024] u8;
    tlen := jv_str(doc[0], jv_get(doc[0], c0, "text"), tbuf[..]);
    txt := ifx tlen >= 0 then cast(string) tbuf[0..<tlen] else "";
    print("RESOURCE_READ uri=% text=%\n", read_uri, txt);
  }

  // 4. Optional prompts/list + prompts/get
  if cli[0].core[0].server_caps.prompts {
    rc = mcp_stdio_client_send_simple(cli[..], "prompts/list", "", id_out[..], wire_buf[..], scratch[..]);
    if rc == MCP_CLI_STDIO_OK {
      rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
    }
    if !mcp_cli_check_ok(rc, ev[0], "FAIL prompts/list") {
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    parr := jv_get(doc[0], ev[0].result_node, "prompts");
    print("PROMPTS count=%\n", jv_len(doc[0], parr));
  }
  if prompt_name.count > 0 {
    rc = mcp_stdio_client_send_prompts_get(cli[..], prompt_name, prompt_args, "", "", id_out[..], wire_buf[..], scratch[..]);
    if rc == MCP_CLI_STDIO_OK {
      rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
    }
    if !mcp_cli_check_ok(rc, ev[0], "FAIL prompts/get") {
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    marr := jv_get(doc[0], ev[0].result_node, "messages");
    print("PROMPT_GET name=% messages=%\n", prompt_name, jv_len(doc[0], marr));
  }

  // 5. ping in 2025-11-25 mode
  if !cli[0].core[0].modern {
    rc = mcp_stdio_client_send_ping(cli[..], id_out[..], wire_buf[..], scratch[..]);
    if rc == MCP_CLI_STDIO_OK {
      rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
    }
    if !mcp_cli_check_ok(rc, ev[0], "FAIL ping") {
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    print("PING ok=true\n");
  }

  // 6. notifications/cancelled over stdio (verify server accepts notification without error & stays alive)
  if test_cancel {
    rc = mcp_stdio_client_cancel(cli[..], 99999, "client-cancel-smoke", wire_buf[..], scratch[..]);
    if rc != MCP_CLI_STDIO_OK {
      tool_errln("FAIL notifications/cancelled send");
      _ = mcp_stdio_client_close(cli[..], 1000);
      return 1;
    }
    // Follow up with tools/list to confirm transport remains synchronized after cancel notification.
    if cli[0].core[0].server_caps.tools {
      rc = mcp_stdio_client_send_simple(cli[..], "tools/list", "", id_out[..], wire_buf[..], scratch[..]);
      if rc == MCP_CLI_STDIO_OK {
        rc = mcp_stdio_client_wait_response(cli[..], id_out[0], 15000, line_buf[..], nodes[..], doc[..], ev[..]);
      }
      if !mcp_cli_check_ok(rc, ev[0], "FAIL post-cancel tools/list") {
        _ = mcp_stdio_client_close(cli[..], 1000);
        return 1;
      }
    }
    print("CANCEL ok=true\n");
  }

  exit_st := mcp_stdio_client_close(cli[..], 2000);
  print("CLOSED status=%\n", exit_st);
  return 0;
}
