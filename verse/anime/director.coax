// Anime Lab's director (docs/verse/anime-lab.md): spoken lines become typed
// directions over a fixed catalogue, and the directions become a timeline
// the stage plays while it is written. Pure: no drawing, no network, no
// clock of its own. The live voice path (A4) and the demo's simulated
// session (?stage=direct) both come through here.
//
// The words never reach this file as a way to choose. The decision model
// (today the server's typed selector, next Psionic's) reads the words and
// answers one flat JSON object per direction, its fields the catalogue's
// own words and a confidence `p`; anime_read holds each answer to the
// catalogue again, the way verse/setpiece.coax holds the Sandbox's pieces.
// The only parsing here is of those bounded fields (catalogue words, a
// count, a decimal). There is no keyword routing.
//
// The timeline keeps the anime grammar: a direction plays when it is
// decided (DECIDE after the words end); a cut never lands inside an
// action's anticipation (the wind-up before a cast); a close-up holds at
// least CLOSE_HOLD; a flash cut is FLASH_FRAMES white frames. The engine
// adds its own framing ("auto" shots) when a direction's subject is off
// the shot, so what is directed is always seen; those are marked auto.
//   coax/bin/coax test verse/anime/director.coax

// ---- The catalogue (anime-lab.md, Directions)
AD_ENTER :: 0; AD_EXIT :: 1; AD_ACT :: 2; AD_EMOTE :: 3; AD_CAST :: 4; AD_FX :: 5;
AD_SHOT :: 6; AD_CUT :: 7; AD_BEAT :: 8; AD_SET :: 9; AD_SAY :: 10; AD_MAKE :: 11;
AD_KINDS :: 12;
AD_KIND_WORDS :: [AD_KINDS] string.["enter", "exit", "act", "emote", "cast", "fx", "shot", "cut", "beat", "set", "say", "make"];
AD_KIND_LABELS :: [AD_KINDS] string.["ENTER", "EXIT", "ACT", "EMOTE", "CAST", "FX", "SHOT", "CUT", "BEAT", "SET", "SAY", "MAKE"];

// Cast slots: archetypes drawn in our own designs. A spoken name binds to one the first time it is
// heard; after that it is a label. The hooded figures are three of one archetype (slots 2, 3, 4).
AS_HEROINE :: 0; AS_HERO :: 1; AS_HOODED :: 2; AS_LORD :: 5; AS_MADE :: 6;
AS_SLOTS :: 7;
AS_ARCHETYPES :: 5;
AS_ARCHETYPE_WORDS :: [AS_ARCHETYPES] string.["heroine", "hero", "hooded", "dark-lord", "creature"];
AS_ARCHETYPE_SLOT :: [AS_ARCHETYPES] int.[AS_HEROINE, AS_HERO, AS_HOODED, AS_LORD, AS_MADE];

ACTIONS :: 11;
ACT_RAISE :: 0; ACT_CAST :: 1; ACT_BLOCK :: 2; ACT_RUN :: 3; ACT_FALL :: 4; ACT_KNEEL :: 5; ACT_TURN :: 6;
ACT_POINT :: 7; ACT_HESITATE :: 8; ACT_RECOIL :: 9; ACT_SHOUT :: 10;
ACTION_WORDS :: [ACTIONS] string.["raise-wand", "cast", "block", "run", "fall", "kneel", "turn", "point", "hesitate", "recoil", "shout"];
EMOTIONS :: 10;
EMO_CALM :: 0; EMO_SAD :: 1; EMO_ANGRY :: 2; EMO_AFRAID :: 3; EMO_DETERMINED :: 4; EMO_SMUG :: 5; EMO_SHOCKED :: 6;
EMO_CRYING :: 7; EMO_LAUGHING :: 8; EMO_HESITANT :: 9;
EMOTION_WORDS :: [EMOTIONS] string.["calm", "sad", "angry", "afraid", "determined", "smug", "shocked", "crying", "laughing", "hesitant"];
SPELLS :: 6;
SPELL_BOLT :: 0; SPELL_FIREBALL :: 1; SPELL_SHIELD :: 2; SPELL_FROST :: 3; SPELL_GUARDIAN :: 4; SPELL_LIGHT :: 5;
SPELL_WORDS :: [SPELLS] string.["bolt", "fireball", "shield", "frost-ring", "guardian", "light"];
EFFECTS :: 9;
FX_EXPLOSION :: 0; FX_RUBBLE :: 1; FX_FLASH :: 2; FX_SMOKE :: 3; FX_EMBERS :: 4; FX_WIND :: 5; FX_LIGHTNING :: 6;
FX_PETALS :: 7; FX_SHOCKWAVE :: 8;
EFFECT_WORDS :: [EFFECTS] string.["explosion", "rubble-rain", "flash", "smoke", "embers", "wind", "lightning", "petals", "shockwave"];
FRAMINGS :: 8;
FR_EXTREME :: 0; FR_CLOSE :: 1; FR_MEDIUM :: 2; FR_WIDE :: 3; FR_ESTABLISHING :: 4; FR_OVER :: 5; FR_LOW :: 6; FR_HIGH :: 7;
FRAMING_WORDS :: [FRAMINGS] string.["extreme-close-up", "close-up", "medium", "wide", "establishing", "over-the-shoulder", "low-angle", "high-angle"];
MOVES :: 6;
MOVE_HOLD :: 0; MOVE_PUSH :: 1; MOVE_PULL :: 2; MOVE_ORBIT :: 3; MOVE_SHAKE :: 4; MOVE_WHIP :: 5;
MOVE_WORDS :: [MOVES] string.["hold", "push-in", "pull-out", "orbit", "shake", "whip-pan"];
TRANSITIONS :: 5;
TR_CUT :: 0; TR_FLASH :: 1; TR_SMASH :: 2; TR_WIPE :: 3; TR_MATCH :: 4;
TRANSITION_WORDS :: [TRANSITIONS] string.["cut", "flash", "smash", "speed-line-wipe", "match"];
BEATS :: 4;
BEAT_HOLD :: 0; BEAT_SLOW :: 1; BEAT_FREEZE :: 2; BEAT_SPEED :: 3;
BEAT_WORDS :: [BEATS] string.["hold", "slow-motion", "freeze-frame", "speed-lines"];
HOWS :: 4;
HOW_WALKS :: 0; HOW_RUNS :: 1; HOW_APPEARS :: 2; HOW_LANDS :: 3;
HOW_WORDS :: [HOWS] string.["walks", "runs", "appears", "lands"];
// Places on the stage: where something enters, what a spell or an effect is aimed at.
PLACES :: 8;
PL_GATE :: 0; PL_COURTYARD :: 1; PL_WALL :: 2; PL_SKY :: 3; PL_LEFT :: 4; PL_RIGHT :: 5; PL_BEHIND :: 6; PL_ABOVE :: 7;
PLACE_WORDS :: [PLACES] string.["gate", "courtyard", "wall", "sky", "left", "right", "behind", "above"];
SIZES :: 3;
SIZE_SMALL :: 0; SIZE_LARGE :: 1; SIZE_HUGE :: 2;
SIZE_WORDS :: [SIZES] string.["small", "large", "huge"];

// The thresholds (anime-lab.md 2, calibrated): over PLAY plays at once; SOFT to PLAY plays and
// shows a "did you mean" chip; under SOFT the line shows as heard and nothing plays.
P_PLAY :: 0.85f32;
P_SOFT :: 0.5f32;

AnimeDirection :: struct {
  kind: int = -1;
  who: int = -1;         // the subject: a cast slot (AS_*), -1 none
  option: int = -1;      // the kind's own field: action, emotion, spell, effect, framing, transition, beat; enter: archetype
  move: int = -1;        // shot: its move; enter: how
  place: int = -1;       // where, or a spell's or an effect's target place (PL_*)
  to: int = -1;          // a cast slot the cut goes to, or a spell is aimed at
  count: int = 1;
  size: int = -1;
  p: f32 = 0;            // the decision model's confidence
  stock: bool = true;    // in the library (a make never is)
  what: string = "";     // a make's description, as said
  like: int = -1;        // a make's nearest archetype
  engine_framed: bool = false;    // the engine's own framing, not directed
}

ad_find :: (names: [] string, word: string) -> int { for i: 0..<names.count { if names[i] == word { return i; } } return -1; }

// The value after "key": in a flat JSON object: a string's letters (no escapes: catalogue words and a
// short description) or a number's characters; "" if none.
ad_value :: (json: string, key: string) -> string {
  i := 0;
  while i + key.count + 2 <= json.count {
    if json[i] == '"' && json[i + key.count + 1] == '"' && json[i + 1..<i + key.count + 1] == key {
      j := i + key.count + 2;
      while j < json.count && json[j] == ' ' { j += 1; }
      if j >= json.count || json[j] != ':' { i += 1; continue; }
      j += 1;
      while j < json.count && json[j] == ' ' { j += 1; }
      if j < json.count && json[j] == '"' {
        e := j + 1;
        while e < json.count && json[e] != '"' && json[e] != '\\' { e += 1; }
        if e >= json.count || json[e] != '"' { return ""; }
        return json[j + 1..<e];
      }
      e := j;
      while e < json.count && ((json[e] >= '0' && json[e] <= '9') || json[e] == '.') { e += 1; }
      return json[j..<e];
    }
    i += 1;
  }
  return "";
}
ad_int :: (digits: string) -> int {
  if digits.count == 0 || digits.count > 3 { return -1; }
  n := 0;
  for i: 0..<digits.count { if digits[i] < '0' || digits[i] > '9' { return -1; } n = n * 10 + cast(int) (digits[i] - '0'); }
  return n;
}
// A confidence "0.94" (0 to 1, at most three decimals); -1 when it isn't one.
ad_p :: (digits: string) -> f32 {
  if digits.count < 1 || digits.count > 5 { return -1; }
  if digits == "1" || digits == "1.0" { return 1; }
  if digits.count < 3 || digits[0] != '0' || digits[1] != '.' { return -1; }
  v := 0; scale := 1;
  for i: 2..<digits.count {
    if digits[i] < '0' || digits[i] > '9' { return -1; }
    v = v * 10 + cast(int) (digits[i] - '0'); scale *= 10;
  }
  return cast(f32) v / cast(f32) scale;
}
// A who: an archetype's word, its slot (the hooded's first); -1 for none or an unknown one.
ad_who :: (word: string) -> int {
  words := AS_ARCHETYPE_WORDS;
  k := ad_find(words[..], word);
  return ifx k < 0 then -1 else AS_ARCHETYPE_SLOT[k];
}

// Reads one of the decision model's answers, held to the catalogue: an unknown kind is no
// direction (kind -1); a field that isn't the kind's own words stays -1, and a direction missing
// the field its kind needs is no direction either. A make is never in stock; every other kind is.
anime_read :: (json: string) -> AnimeDirection {
  kinds := AD_KIND_WORDS;
  d: AnimeDirection;
  k := ad_find(kinds[..], ad_value(json, "kind"));
  if k < 0 { return d; }
  p := ad_p(ad_value(json, "p"));
  if p < 0 { return d; }
  d.p = p;
  d.who = ad_who(ad_value(json, "who"));
  places := PLACE_WORDS; sizes := SIZE_WORDS;
  d.place = ad_find(places[..], ad_value(json, "place"));
  d.to = ad_who(ad_value(json, "to"));
  d.size = ad_find(sizes[..], ad_value(json, "size"));
  c := ad_int(ad_value(json, "count"));
  d.count = ifx c >= 1 && c <= 3 then c else 1;
  if k == AD_ACT { w := ACTION_WORDS; d.option = ad_find(w[..], ad_value(json, "action")); }
  if k == AD_EMOTE { w := EMOTION_WORDS; d.option = ad_find(w[..], ad_value(json, "emotion")); }
  if k == AD_CAST { w := SPELL_WORDS; d.option = ad_find(w[..], ad_value(json, "spell")); }
  if k == AD_FX { w := EFFECT_WORDS; d.option = ad_find(w[..], ad_value(json, "effect")); }
  if k == AD_SHOT {
    w := FRAMING_WORDS; d.option = ad_find(w[..], ad_value(json, "framing"));
    m := MOVE_WORDS; d.move = ad_find(m[..], ad_value(json, "move"));
    if d.move < 0 { d.move = MOVE_HOLD; }
  }
  if k == AD_CUT {
    w := TRANSITION_WORDS; d.option = ad_find(w[..], ad_value(json, "transition"));
    if d.option < 0 { d.option = TR_CUT; }
  }
  if k == AD_BEAT { w := BEAT_WORDS; d.option = ad_find(w[..], ad_value(json, "beat")); }
  if k == AD_ENTER {
    d.option = ad_who(ad_value(json, "archetype"));
    h := HOW_WORDS; d.move = ad_find(h[..], ad_value(json, "how"));
    if d.move < 0 { d.move = HOW_WALKS; }
  }
  if k == AD_MAKE {
    d.what = ad_value(json, "what");
    d.like = ad_who(ad_value(json, "like"));
  }
  d.kind = k;
  d.stock = k != AD_MAKE;
  if !anime_direction_ok(d) { return AnimeDirection.{}; }
  return d;
}

// Whether a direction holds to the catalogue's types: its kind's own field in range, a subject
// where the kind needs one, a make described and not in stock.
anime_direction_ok :: (d: AnimeDirection) -> bool {
  if d.kind < 0 || d.kind >= AD_KINDS || !(d.p >= 0 && d.p <= 1) { return false; }
  if d.who >= AS_SLOTS || d.to >= AS_SLOTS || d.place >= PLACES || d.size >= SIZES || d.count < 1 || d.count > 3 { return false; }
  if d.stock == (d.kind == AD_MAKE) { return false; }
  k := d.kind;
  if k == AD_ACT { return d.who >= 0 && d.option >= 0 && d.option < ACTIONS; }
  if k == AD_EMOTE { return d.who >= 0 && d.option >= 0 && d.option < EMOTIONS; }
  if k == AD_CAST { return d.option >= 0 && d.option < SPELLS && (d.place >= 0 || d.to >= 0); }
  if k == AD_FX { return d.option >= 0 && d.option < EFFECTS; }
  if k == AD_SHOT { return d.option >= 0 && d.option < FRAMINGS && d.move >= 0 && d.move < MOVES && (d.who >= 0 || d.place >= 0); }
  if k == AD_CUT { return d.option >= 0 && d.option < TRANSITIONS && d.to >= 0; }
  if k == AD_BEAT { return d.option >= 0 && d.option < BEATS; }
  if k == AD_ENTER { return d.option >= 0 && d.move >= 0 && d.move < HOWS; }
  if k == AD_MAKE { return d.what.count > 0 && d.what.count <= 40 && d.like >= 0; }
  return true;
}

// ---- The take's cast: names bound to slots (anime.v1's `cast` lines)
CAST_NAMES :: [AS_SLOTS] string.["Draconia", "Kai", "hooded", "hooded", "hooded", "dark lord", "ink dragon"];

// ---- Words for the overlay: what the director made of a line, in the catalogue's vocabulary.
ad_put :: (buf: [] u8, at: int, t: string) -> int { n := at; for i: 0..<t.count { if n < buf.count { buf[n] = t[i]; n += 1; } } return n; }
// A catalogue word as shown: its hyphens as spaces ("raise-wand" is "raise wand").
ad_word :: (buf: [] u8, at: int, t: string) -> int {
  n := at;
  for i: 0..<t.count { if n < buf.count { buf[n] = ifx t[i] == '-' then cast(u8) ' ' else t[i]; n += 1; } }
  return n;
}
AD_DOT :: " · ";
AD_ARROW :: " → ";
AD_TIMES :: " ×";
ad_slot_name :: (slot: int) -> string { if slot < 0 || slot >= AS_SLOTS { return "-"; } return CAST_NAMES[slot]; }

// The direction in words after its kind: "Draconia · fireball → gate".
anime_says :: (d: AnimeDirection, buf: [] u8) -> string {
  n := 0;
  k := d.kind;
  if k == AD_ACT { n = ad_put(buf, n, ad_slot_name(d.who)); n = ad_put(buf, n, AD_DOT); n = ad_word(buf, n, ACTION_WORDS[d.option]); }
  if k == AD_EMOTE { n = ad_put(buf, n, ad_slot_name(d.who)); n = ad_put(buf, n, AD_DOT); n = ad_word(buf, n, EMOTION_WORDS[d.option]); }
  if k == AD_CAST {
    if d.who >= 0 { n = ad_put(buf, n, ad_slot_name(d.who)); n = ad_put(buf, n, AD_DOT); }
    n = ad_word(buf, n, SPELL_WORDS[d.option]); n = ad_put(buf, n, AD_ARROW);
    n = ad_put(buf, n, ifx d.to >= 0 then ad_slot_name(d.to) else PLACE_WORDS[d.place]);
    if d.size == SIZE_HUGE { n = ad_put(buf, n, AD_DOT); n = ad_put(buf, n, "huge"); }
  }
  if k == AD_FX {
    n = ad_word(buf, n, EFFECT_WORDS[d.option]);
    if d.place >= 0 { n = ad_put(buf, n, AD_DOT); n = ad_put(buf, n, PLACE_WORDS[d.place]); }
  }
  if k == AD_SHOT {
    n = ad_word(buf, n, FRAMING_WORDS[d.option]); n = ad_put(buf, n, AD_DOT);
    n = ad_put(buf, n, ifx d.who >= 0 then ad_slot_name(d.who) else PLACE_WORDS[d.place]);
    if d.move != MOVE_HOLD || d.option == FR_WIDE { n = ad_put(buf, n, AD_DOT); n = ad_word(buf, n, MOVE_WORDS[d.move]); }
  }
  if k == AD_CUT { n = ad_word(buf, n, TRANSITION_WORDS[d.option]); n = ad_put(buf, n, AD_ARROW); n = ad_put(buf, n, ad_slot_name(d.to)); }
  if k == AD_BEAT { n = ad_word(buf, n, BEAT_WORDS[d.option]); }
  if k == AD_ENTER {
    n = ad_put(buf, n, ifx d.option == AS_LORD then "dark lord" else ad_slot_name(d.option));
    if d.count > 1 { n = ad_put(buf, n, AD_TIMES); n = ad_put(buf, n, ifx d.count == 3 then "3" else "2"); }
    if d.place >= 0 { n = ad_put(buf, n, AD_DOT); n = ad_put(buf, n, PLACE_WORDS[d.place]); }
    n = ad_put(buf, n, AD_DOT); n = ad_word(buf, n, HOW_WORDS[d.move]);
  }
  if k == AD_MAKE {
    n = ad_put(buf, n, "\""); n = ad_put(buf, n, d.what); n = ad_put(buf, n, "\" like ");
    n = ad_put(buf, n, AS_ARCHETYPE_WORDS[ad_archetype(d.like)]);
  }
  return cast(string) buf[0..<n];
}
ad_archetype :: (slot: int) -> int { for i: 0..<AS_ARCHETYPES { if AS_ARCHETYPE_SLOT[i] == slot { return i; } } return 0; }

// ---- The session: lines as heard, with the decision model's answers
// said, done: when the line's words start and end (s into the take); the answers to it are
// AnimeAnswers[first ..< first + count], one flat object each, as the typed selector returns them.
AnimeLine :: struct { said: f32; done: f32; words: string; first: int; count: int; }

// The demo (anime-lab.md, The demo): a person directing, the voice simulated. The words, their
// timing and the answers are what the live path makes of them; the answers are recorded here.
