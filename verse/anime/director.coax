FILM_LENGTH :: 10.5f32;

// ---- The timeline: when each direction plays
DECIDE :: 0.35f32;         // s from the words' end to the decision (the typed selector, simulated)
STAGGER :: 0.14f32;        // s between one line's directions
ANTICIPATION :: 0.4f32;    // s: a cast's wind-up, inside which nothing cuts
CLOSE_HOLD :: 0.6f32;      // s: a close-up holds at least this
FLASH_FRAMES :: 3;         // a flash cut's white frames
FILM_FPS :: 30.0f32;
FLIGHT :: 0.9f32;          // s: a spell's flight to its target
EVENTS_MAX :: 48;

// shown: when the overlay shows the direction (it was decided); at: when it plays (the grammar may
// hold it a moment past that); line: the line it came from (-1 for the engine's own framing).
AnimeEvent :: struct { at: f32; shown: f32; d: AnimeDirection; line: int; }

anime_flash_length :: () -> f32 { return cast(f32) FLASH_FRAMES / FILM_FPS; }
// Whether a direction moves the camera.
anime_camera :: (d: AnimeDirection) -> bool { return d.kind == AD_SHOT || d.kind == AD_CUT; }
// Whether a direction has a wind-up the camera must not cut inside: a cast, or the act of casting.
anime_winds_up :: (d: AnimeDirection) -> bool { return (d.kind == AD_CAST && d.who >= 0) || (d.kind == AD_ACT && d.option == ACT_CAST); }

// The framing the camera holds after a camera direction, and on whom: a cut keeps a close framing
// (flash to Kai from a close-up is a close-up of Kai), else medium.
ad_frames :: (d: AnimeDirection, last: int) -> int {
  if d.kind == AD_SHOT { return d.option; }
  return ifx last == FR_CLOSE || last == FR_EXTREME then FR_CLOSE else FR_MEDIUM;
}
ad_subject :: (d: AnimeDirection) -> int { return ifx d.kind == AD_CUT then d.to else d.who; }

// The engine's framing for a direction that needs its subject seen: a shot it adds before it (kind
// -1: none). An action, a feeling or a cast on someone the shot isn't on gets a medium shot of them
// (a cast: over their shoulder at the target); a body action in a close-up pulls back to medium;
// whoever enters, a big spell, a made thing get a wide one.
ad_auto :: (d: AnimeDirection, framing: int, subject: int) -> AnimeDirection {
  a: AnimeDirection;
  a.engine_framed = true; a.p = 1; a.move = MOVE_HOLD;
  wide := framing == FR_WIDE || framing == FR_ESTABLISHING;
  if (d.kind == AD_ACT || d.kind == AD_EMOTE) && (subject != d.who || (d.kind == AD_ACT && framing == FR_CLOSE)) {
    if d.kind == AD_EMOTE && subject != d.who { a.kind = AD_SHOT; a.option = FR_MEDIUM; a.who = d.who; a.move = MOVE_PUSH; }
    if d.kind == AD_ACT { a.kind = AD_SHOT; a.option = FR_MEDIUM; a.who = d.who; a.move = MOVE_PUSH; }
    return a;
  }
  if d.kind == AD_CAST && d.who >= 0 && !(framing == FR_OVER && subject == d.who) {
    a.kind = AD_SHOT; a.option = FR_OVER; a.who = d.who; return a;
  }
  if d.kind == AD_CAST && d.who < 0 && !wide { a.kind = AD_SHOT; a.option = FR_WIDE; a.place = d.place; return a; }
  if d.kind == AD_ENTER && d.option == AS_HOODED { a.kind = AD_SHOT; a.option = FR_WIDE; a.place = PL_BEHIND; a.move = MOVE_PUSH; return a; }
  if d.kind == AD_ENTER && d.option == AS_LORD { a.kind = AD_SHOT; a.option = FR_LOW; a.who = AS_LORD; a.move = MOVE_PUSH; return a; }
  if d.kind == AD_MAKE { a.kind = AD_SHOT; a.option = FR_WIDE; a.place = d.place; a.move = MOVE_PULL; return a; }
  return a;
}

// Lays the lines' answers out as a timeline into out, in the order they play; returns how many.
// The grammar holds: camera directions wait out a close-up's CLOSE_HOLD and any wind-up they would
// land inside; a flash cut's subject's feeling plays with the cut, after its white frames.
anime_timeline :: (lines: [] AnimeLine, answers: [] string, auto: bool, out: [] AnimeEvent) -> int {
  n := 0;
  framing := FR_ESTABLISHING; subject := -1;
  close_at := -100.0f32;          // when the last close-up started
  wind_at := -100.0f32;           // when the last wind-up started
  flash_end := -100.0f32;
  for i: 0..<lines.count {
    l := lines[i];
    for k: 0..<l.count {
      if l.first + k >= answers.count || n >= out.count { continue; }
      d := anime_read(answers[l.first + k]);
      if d.kind < 0 || d.p < P_SOFT { continue; }
      shown := l.done + (ifx l.said < l.done then DECIDE else 0.0f32) + cast(f32) k * STAGGER;
      at := shown;
      if auto && !anime_camera(d) {
        a := ad_auto(d, framing, subject);
        if a.kind == AD_SHOT && n < out.count {
          ta := at;
          if framing == FR_CLOSE || framing == FR_EXTREME { ta = ifx ta < close_at + CLOSE_HOLD then close_at + CLOSE_HOLD else ta; }
          if ta > wind_at && ta < wind_at + ANTICIPATION { ta = wind_at + ANTICIPATION; }
          out[n] = AnimeEvent.{at = ta, shown = shown, d = a, line = -1}; n += 1;
          framing = a.option; subject = a.who;
          at = ifx at < ta then ta else at;
        }
      }
      if anime_camera(d) {
        if framing == FR_CLOSE || framing == FR_EXTREME { at = ifx at < close_at + CLOSE_HOLD then close_at + CLOSE_HOLD else at; }
        if at > wind_at && at < wind_at + ANTICIPATION { at = wind_at + ANTICIPATION; }
        framing = ad_frames(d, framing); subject = ad_subject(d);
        if framing == FR_CLOSE || framing == FR_EXTREME { close_at = at; }
        if d.kind == AD_CUT && d.option == TR_FLASH { flash_end = at + anime_flash_length(); }
      } else if d.kind == AD_EMOTE && d.who == subject && at < flash_end {
        at = flash_end;    // the feeling shows on the far side of the white frames
      }
      if anime_winds_up(d) { wind_at = at; }
      out[n] = AnimeEvent.{at = at, shown = shown, d = d, line = i}; n += 1;
    }
  }
  // in the order they play (a stable insertion sort: the lists are short)
  for i: 1..<n {
    e := out[i]; j := i - 1;
    while j >= 0 && out[j].at > e.at { out[j + 1] = out[j]; j -= 1; }
    out[j + 1] = e;
  }
  return n;
}

// How much of a line's words have been heard at t: bytes of its words, whole words only, the
// words arriving evenly while it is said (the partial), all of it from done (the final).
anime_heard :: (l: AnimeLine, t: f32) -> int {
  if t >= l.done { return l.words.count; }
  if t <= l.said || l.done <= l.said { return 0; }
  words := 0;
  for i: 0..<l.words.count { if l.words[i] == ' ' { words += 1; } }
  words += 1;
  want := cast(int) floor((t - l.said) / (l.done - l.said) * cast(f32) words);
  seen := 0;
  for i: 0..<l.words.count {
    if l.words[i] == ' ' { seen += 1; if seen >= want { return i; } }
  }
  return l.words.count;
}

// ---- Checks
ad_events :: (lines: [] AnimeLine, answers: [] string, out: [] AnimeEvent) -> int { return anime_timeline(lines, answers, true, out); }

#test "every answer in the demo and the film reads to a direction of the catalogue" {
  said := DEMO_ANSWERS; film := FILM_ANSWERS;
  for i: 0..<DEMO_ANSWERS_N { d := anime_read(said[i]); #assert d.kind >= 0 && anime_direction_ok(d); }
  for i: 0..<FILM_ANSWERS_N { d := anime_read(film[i]); #assert d.kind >= 0 && anime_direction_ok(d); }
  // each line's answers are its own: the table is covered once, in order
  lines := DEMO_LINES; next := 0;
  for i: 0..<DEMO_LINES_N { #assert lines[i].first == next && lines[i].count >= 1; next += lines[i].count; }
  #assert next == DEMO_ANSWERS_N;
  flines := FILM_LINES; next = 0;
  for i: 0..<FILM_LINES_N { #assert flines[i].first == next; next += flines[i].count; }
  #assert next == FILM_ANSWERS_N;
}

#test "answers are held to the catalogue: kinds, fields and confidences" {
  d := anime_read("{\"kind\":\"cast\",\"who\":\"heroine\",\"spell\":\"fireball\",\"place\":\"gate\",\"size\":\"large\",\"p\":0.94}");
  #assert d.kind == AD_CAST && d.who == AS_HEROINE && d.option == SPELL_FIREBALL && d.place == PL_GATE && d.size == SIZE_LARGE && d.stock;
  #assert d.p > 0.939 && d.p < 0.941;
  #assert anime_read("{\"kind\":\"cast\",\"who\":\"heroine\",\"spell\":\"avalanche\",\"place\":\"gate\",\"p\":0.9}").kind == -1;  // not a spell of ours
  #assert anime_read("{\"kind\":\"dance\",\"who\":\"heroine\",\"p\":0.9}").kind == -1;
  #assert anime_read("{\"kind\":\"act\",\"who\":\"heroine\",\"action\":\"raise-wand\"}").kind == -1;            // no confidence
  #assert anime_read("{\"kind\":\"act\",\"who\":\"heroine\",\"action\":\"raise-wand\",\"p\":1.4}").kind == -1;  // not a probability
  #assert anime_read("{\"kind\":\"act\",\"action\":\"raise-wand\",\"p\":0.9}").kind == -1;                    // nobody to do it
  #assert anime_read("{\"kind\":\"act\",\"who\":\"Heroine\",\"action\":\"raise-wand\",\"p\":0.9}").kind == -1; // exact words only
  #assert anime_read("{\"kind\":\"cut\",\"to\":\"hero\",\"p\":0.9}").option == TR_CUT;                         // a plain cut by default
  e := anime_read("{\"kind\":\"enter\",\"archetype\":\"hooded\",\"count\":3,\"place\":\"behind\",\"how\":\"appears\",\"p\":0.93}");
  #assert e.kind == AD_ENTER && e.option == AS_HOODED && e.count == 3 && e.move == HOW_APPEARS && e.place == PL_BEHIND;
  #assert anime_read("{\"kind\":\"enter\",\"archetype\":\"hooded\",\"count\":30,\"how\":\"appears\",\"p\":0.9}").count == 1;
  m := anime_read("{\"kind\":\"make\",\"what\":\"ink dragon\",\"like\":\"creature\",\"place\":\"wall\",\"p\":0.87}");
  #assert m.kind == AD_MAKE && !m.stock && m.what == "ink dragon" && m.like == AS_MADE;
  #assert anime_read("{\"kind\":\"make\",\"like\":\"creature\",\"p\":0.87}").kind == -1;   // a make says what it is
  #assert anime_read("").kind == -1 && anime_read("{\"kind\":\"act\"").kind == -1;
}

#test "only the make is out of stock, and it is the ink dragon" {
  said := DEMO_ANSWERS; makes := 0;
  for i: 0..<DEMO_ANSWERS_N {
    d := anime_read(said[i]);
    if !d.stock { makes += 1; #assert d.kind == AD_MAKE && d.what == "ink dragon"; }
  }
  #assert makes == 1;
}

#test "the session is paced like a person talking, inside the take" {
  lines := DEMO_LINES;
  for i: 0..<DEMO_LINES_N {
    #assert lines[i].said < lines[i].done && lines[i].done - lines[i].said < 4.0;
    if i > 0 { #assert lines[i].said > lines[i - 1].done + 0.8; }   // a breath between lines
  }
  #assert lines[0].said > 0.5 && lines[DEMO_LINES_N - 1].done > 40 && lines[DEMO_LINES_N - 1].done + 6 < DEMO_LENGTH && DEMO_LENGTH <= 60;
}

#test "the timeline plays in order, each direction once decided" {
  ev: [EVENTS_MAX] AnimeEvent;
  lines := DEMO_LINES; answers := DEMO_ANSWERS;
  n := ad_events(lines[..], answers[..], ev[..]);
  directed := 0;
  for i: 0..<n {
    if i > 0 { #assert ev[i].at >= ev[i - 1].at; }
    #assert ev[i].at >= ev[i].shown && ev[i].at - ev[i].shown < 1.0;
    if ev[i].line >= 0 { directed += 1; #assert ev[i].shown >= lines[ev[i].line].done + DECIDE; } else { #assert ev[i].d.engine_framed; }
  }
  #assert directed == DEMO_ANSWERS_N;   // every answer clears the threshold and plays
}

#test "the anime grammar: a close-up holds, no cut inside a wind-up, a flash cut is three frames" {
  ev: [EVENTS_MAX] AnimeEvent;
  lines := DEMO_LINES; answers := DEMO_ANSWERS;
  n := ad_events(lines[..], answers[..], ev[..]);
  close_at := -100.0f32; closed := false;
  for i: 0..<n {
    d := ev[i].d;
    if anime_camera(d) {
      if closed { #assert ev[i].at >= close_at + CLOSE_HOLD - 0.0001; }
      closed = d.kind == AD_SHOT && d.option == FR_CLOSE;
      if d.kind == AD_CUT { closed = closed || ad_frames(d, FR_CLOSE) == FR_CLOSE; }
      if closed { close_at = ev[i].at; }
      for j: 0..<n { if anime_winds_up(ev[j].d) { #assert !(ev[i].at > ev[j].at + 0.0001 && ev[i].at < ev[j].at + ANTICIPATION - 0.0001); } }
    }
  }
  #assert FLASH_FRAMES == 3 && anime_flash_length() * FILM_FPS == 3;
  // flash to Kai: his sadness shows after the white frames, not under them
  cut := -1.0f32; sad := -1.0f32;
  for i: 0..<n {
    if ev[i].d.kind == AD_CUT && ev[i].d.option == TR_FLASH { cut = ev[i].at; }
    if ev[i].d.kind == AD_EMOTE && ev[i].d.option == EMO_SAD { sad = ev[i].at; }
  }
  #assert cut > 0 && sad >= cut + anime_flash_length() - 0.0001;
}

#test "a cut asked for inside a wind-up waits for it; a shot after a close-up waits out its hold" {
  ls := [2] AnimeLine.[AnimeLine.{said = 0, done = 1, words = "a", first = 0, count = 1}, AnimeLine.{said = 1.05, done = 1.1, words = "b", first = 1, count = 1}];
  as := [2] string.["{\"kind\":\"cast\",\"who\":\"heroine\",\"spell\":\"bolt\",\"place\":\"gate\",\"p\":0.9}",
                    "{\"kind\":\"cut\",\"to\":\"hero\",\"p\":0.9}"];
  ev: [8] AnimeEvent;
  n := anime_timeline(ls[..], as[..], false, ev[..]);
  #assert n == 2 && ev[1].d.kind == AD_CUT && ev[1].at >= ev[0].at + ANTICIPATION - 0.0001;
  bs := [2] string.["{\"kind\":\"shot\",\"framing\":\"close-up\",\"who\":\"heroine\",\"p\":0.9}",
                    "{\"kind\":\"shot\",\"framing\":\"wide\",\"place\":\"courtyard\",\"p\":0.9}"];
  n = anime_timeline(ls[..], bs[..], false, ev[..]);
  #assert n == 2 && ev[1].at >= ev[0].at + CLOSE_HOLD - 0.0001;
}

#test "under the soft threshold nothing plays; between, it plays" {
  ls := [1] AnimeLine.[AnimeLine.{said = 0, done = 1, words = "x", first = 0, count = 2}];
  as := [2] string.["{\"kind\":\"act\",\"who\":\"hero\",\"action\":\"point\",\"p\":0.3}", "{\"kind\":\"act\",\"who\":\"hero\",\"action\":\"turn\",\"p\":0.6}"];
  ev: [8] AnimeEvent;
  n := anime_timeline(ls[..], as[..], false, ev[..]);
  #assert n == 1 && ev[0].d.option == ACT_TURN;
}

#test "the engine frames what is directed, and says so" {
  ev: [EVENTS_MAX] AnimeEvent;
  lines := DEMO_LINES; answers := DEMO_ANSWERS;
  n := ad_events(lines[..], answers[..], ev[..]);
  // the heroine hesitates while the shot is on Kai: a medium shot of her comes first
  for i: 0..<n {
    if ev[i].d.kind == AD_ACT && ev[i].d.option == ACT_HESITATE {
      #assert i > 0 && ev[i - 1].d.engine_framed && ev[i - 1].d.kind == AD_SHOT && ev[i - 1].d.who == AS_HEROINE;
    }
    if ev[i].d.engine_framed { #assert anime_direction_ok(ev[i].d) && ev[i].line == -1; }
  }
}

#test "the overlay says a direction in the catalogue's words" {
  buf: [96] u8;
  answers := DEMO_ANSWERS;
  #assert anime_says(anime_read(answers[0]), buf[..]) == "Draconia · raise wand";
  #assert anime_says(anime_read(answers[1]), buf[..]) == "Draconia · fireball → gate";
  #assert anime_says(anime_read(answers[2]), buf[..]) == "close up · Draconia · push in";
  #assert anime_says(anime_read(answers[3]), buf[..]) == "flash → Kai";
  #assert anime_says(anime_read(answers[4]), buf[..]) == "Kai · sad";
  #assert anime_says(anime_read(answers[9]), buf[..]) == "hooded ×3 · behind · appears";
  #assert anime_says(anime_read(answers[12]), buf[..]) == "fireball → courtyard · huge";
  #assert anime_says(anime_read(answers[14]), buf[..]) == "\"ink dragon\" like creature";
}

#test "words are heard as they are said, whole words, then all of them" {
  l := AnimeLine.{said = 1, done = 3, words = "Close up on Draconia.", first = 0, count = 1};
  #assert anime_heard(l, 0.5) == 0 && anime_heard(l, 3) == l.words.count && anime_heard(l, 9) == l.words.count;
  #assert anime_heard(l, 1.6) == 5;      // "Close"
  #assert anime_heard(l, 2.1) == 8;      // "Close up"
  last := 0;
  for i: 0..<40 { h := anime_heard(l, 0.8 + cast(f32) i * 0.06); #assert h >= last; last = h; }
}
