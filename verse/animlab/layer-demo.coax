// Its checks, with the checks files it loads: coax/bin/coax test --library verse/animlab/layer-demo.coax
// A private study performance. Contact annotations exclude the introductory
// and outgoing base blends, where the feet are deliberately not planted.
#load "../../metaverse-engine/anim/fixup.coax";
#load "../../metaverse-engine/anim/bundle.coax";
#load "layer-demo-checks.coax";
AlContact :: struct {joint:int;first:int;last:int;end:f32;target:Point;}
AlLayerDemo :: struct {performance:AnimPerformance;clip:AnimClip;contacts:[24]AlContact;count:int;}
al_demo :: (library:[]AnimLibrary,out:[]AlLayerDemo)->int {
 if library[0].count>=64 {return ANIM_CAPACITY;}r:=library[0].rig[0];body:=ifx library[0].count>1 then 1 else 0;c:=library[0].clips[body];if c.frames>2000 || c.length<0.5 {return ANIM_LIMIT;}map:[1]RtAnchors;e:=rt_anchors(r,map[..]);if e!=0 {return e;}feet:=[2]int.[map[0].joints[57],map[0].joints[62]];if feet[0]<0 || feet[1]<0 {return ANIM_REFERENCE;}
 points:[4000]Point;minimum:=[2]f32.[1000000,1000000];sample:[1]AnimSample;c.looping=false;for frame:0..<c.frames {anim_sample(r,c,library[0].packs[..],cast(f32)frame/c.rate,sample[..]);for foot:0..<2 {p:=sample[0].position[feet[foot]];points[frame*2+foot]=p;minimum[foot]=lo(minimum[foot],p.y);}}
 next:AlLayerDemo;next.clip=c;next.clip.name=anim_named("walk-contacts");next.clip.event_count=0;
 // Source events are authored from the measured full-weight interval. Release
 // occurs after foot-up, so all marked contact frames keep full IK weight.
 for foot:0..<2 {first:= -1;for frame:0..<c.frames {previous:=ifx frame>0 then frame-1 else frame;following:=ifx frame+1<c.frames then frame+1 else frame;time:=cast(f32)frame/c.rate;speed:=abs(points[following*2+foot].y-points[previous*2+foot].y)*c.rate/cast(f32)(following-previous);
   active:=time>=0.15 && time<c.length-0.15 && points[frame*2+foot].y<=minimum[foot]+0.02 && speed<=0.15;
   if active && first<0 {first=frame;}if !active && first>=0 {end:=lo(time,c.length-0.15);merge:=next.count>0 && next.contacts[next.count-1].joint==feet[foot] && cast(f32)first/c.rate-next.contacts[next.count-1].end<0.15;
    if merge {next.contacts[next.count-1].last=frame;next.contacts[next.count-1].end=end;}else {if next.count>=24 {return ANIM_CAPACITY;}next.contacts[next.count]=AlContact.{joint=feet[foot],first=first,last=frame,end=end,target=points[first*2+foot]};next.count+=1;}first= -1;}
  }}
 // Contact events are ordered by time, with stable joint order for ties.
 for k:0..<next.count {contact:=next.contacts[k];at:=next.clip.event_count;next.clip.events[at]=AnimEvent.{at=cast(f32)contact.first/c.rate,kind=0,joint=contact.joint};next.clip.events[at+1]=AnimEvent.{at=contact.end,kind=1,joint=contact.joint};next.clip.event_count+=2;}
 for k:1..<next.clip.event_count {event:=next.clip.events[k];j:=k;while j>0 && next.clip.events[j-1].at>event.at {next.clip.events[j]=next.clip.events[j-1];j-=1;}next.clip.events[j]=event;}

 p:=AnimPerformance.{ready=true,name=anim_named("walk-face-layers"),rig=r.name,length=c.length,count=4};
 p.layers[0]=AnimLayer.{kind=0,clip=library[0].count,start=0,end=c.length,speed=1,blend_in=0.15,blend_out=0.15,weight=1,mask=0};
 p.layers[1]=AnimLayer.{kind=1,clip=body,start=0,end=c.length,speed=0.5,blend_in=0.15,blend_out=0.15,weight=0.5,mask=4};
 p.layers[2]=AnimLayer.{kind=2,clip=body,start=0,end=c.length,speed=0.75,blend_in=0.15,blend_out=0.15,weight=0.05,mask=3};
 face:=ifx library[0].count>24 then 24 else body;p.layers[3]=AnimLayer.{kind=3,clip=face,start=0,end=c.length,speed=1,blend_in=0.15,blend_out=0.15,weight=1,mask=1};
 for k:0..<next.count {contact:=next.contacts[k];p.layers[p.count]=AnimLayer.{kind=4,solver=0,joint=contact.joint,target=contact.target,start=cast(f32)contact.first/c.rate,end=lo(c.length,contact.end+0.15),speed=1,blend_out=0.15,weight=1,mask=7};p.count+=1;}
 head:=map[0].joints[6];if head>=0 {p.layers[p.count]=AnimLayer.{kind=4,solver=1,joint=head,target=v3(1,1.65,3),start=0,end=c.length,speed=1,blend_in=0.15,blend_out=0.15,weight=0.4,mask=2};p.count+=1;}
 next.performance=p;out[0]=next;return ANIM_OK;
}
