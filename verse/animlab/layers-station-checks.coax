#test "layers station evaluates a made performance and toggles complete layer kinds" #steps 300000000 {
 s:[1]AlState;al_hash(s[..],"layers?rig=mannequin");#assert s[0].station==3 && s[0].performances[0].ready && s[0].performances[0].count>=6;
 al_layers_sample(s[..],0.5);#assert s[0].layer_report.feet>=1;
 #assert al_key(s[..],53);al_layers_sample(s[..],0.5);#assert s[0].layer_report.feet==0;
 #assert al_key(s[..],49) && (s[0].layer_disabled&1)!=0;#assert al_key(s[..],49) && (s[0].layer_disabled&1)==0;
 s[0].layer_before=12;s[0].layer_after=2;al_seek(s[..],5);#assert s[0].layer_before==0 && s[0].layer_after==0;
 #assert al_key(s[..],67) && s[0].station==1;#assert al_key(s[..],76) && s[0].station==3;
}
#test "pending metadata can arrive in either order and rejected replacement retains owned records" #steps 300000000 {
 s:[1]AlState;al_init(s[..]);clip_text:[8192]u8;bytes:[264]u8;n:=anim_test_clip_full(clip_text[..],bytes[..]);anim_test_clip_rig(s[0].libraries[1].rig[..]);s[0].libraries[1].count=1;s[0].libraries[1].packs[0]=AnimPack.{id=asset_id(cast(string)bytes[..]),bytes=bytes[..]};s[0].private_loaded=true;
 perf:[8192]u8;pn:=anim_test_replace(AP_TEST,"made-wave","all-tracks",perf[..]);#assert pn>0 && al_layers_document(s[..],1,perf[0..<pn]) && !s[0].performances[1].ready;
 #assert al_layers_document(s[..],2,clip_text[0..<n]) && s[0].performances[1].ready && s[0].performances[1].layers[0].clip==1 && s[0].libraries[1].count==1;
 perf[0]='[';#assert !al_layers_document(s[..],1,perf[0..<pn]) && s[0].performances[1].ready && anim_equal(s[0].performances[1].name,anim_named("made-performance")) && s[0].libraries[1].clips[1].ready;
 changed:[8192]u8;nn:=anim_test_replace(cast(string)clip_text[0..<n],"\"loop\":false","\"loop\":true",changed[..]);#assert nn>0 && !al_layers_document(s[..],2,changed[0..<nn]) && !s[0].libraries[1].clips[1].looping;
}
#test "browser arena defaults initialize scalar controls without a whole-state temporary" #steps 300000000 {
 s:[1]AlState;s[0].station=0;s[0].distance=0;s[0].clock.step_ns=0;al_state_defaults(s[..]);#assert s[0].station==1 && s[0].distance==1 && s[0].skeleton && s[0].ghost_step==8 && s[0].clock.step_ns==clock.LOOP_STEP_NS;
 al_init(s[..]);#assert s[0].libraries[0].rig[0].ready && s[0].performances[0].ready;
}

#test "each authored layer can be selected and toggled independently by keys and touch" #steps 300000000 {
 s:[1]AlState;al_hash(s[..],"layers?rig=mannequin");s[0].width=390;s[0].height=844;p:=s[0].performances[0];
 for k:0..<p.count {#assert al_key(s[..],-2);#assert s[0].layer_disabled==(cast(u32)1<<k);#assert al_key(s[..],-2) && s[0].layer_disabled==0;#assert al_key(s[..],61);}
 #assert s[0].layer_selected==0;#assert al_key(s[..],45) && s[0].layer_selected==p.count-1;
 #assert al_pointer(s[..],90,300,0) && s[0].layer_selected==0;#assert al_pointer(s[..],250,300,0) && s[0].layer_disabled==1;
 #assert al_pointer(s[..],10,300,0) && s[0].layer_selected==p.count-1 && s[0].layer_disabled==1;
}

#test "private selection uses the imported rig name and inspection includes distant bind geometry" #steps 300000000 {
 s:[1]AlState;al_init(s[..]);s[0].libraries[1]=s[0].libraries[0];s[0].libraries[1].rig[0].name=anim_named("made-import");s[0].libraries[1].clips[0].rig=s[0].libraries[1].rig[0].name;s[0].private_loaded=true;#assert al_key(s[..],69) && s[0].rig==1 && s[0].wanted_rig.n==11 && s[0].error==0;
 s[0].width=390;s[0].height=844;#assert al_key(s[..],77) && s[0].rig==0;#assert al_pointer(s[..],300,28,0) && s[0].rig==1;
 part:=s[0].libraries[1].rig[0].meshes[0].vertices;anim_bundle_put(s[0].made[..],part.offset,f32_bits(100));s[0].libraries[1].packs[0].id=asset_id(cast(string)s[0].libraries[1].packs[0].bytes);al_bounds(s[..]);#assert s[0].center.x>40 && s[0].radius>50;
}

#test "scene project publication preserves the active bank on refusal and holds authored frames" #steps 300000000 #traversal 400000000 {
 s:[1]AlState;al_state_defaults(s[..]);bytes:[32768]u8;n:=project_test_bytes(bytes[..]);#assert al_project_begin(s[..],bytes[0..<n]) && al_project_count(s[..],0)==1 && al_project_count(s[..],1)==1 && al_project_count(s[..],2)==1;for kind:0..<6 {#assert al_project_stage(s[..],kind,0);}active:=s[0].project_active;#assert al_probe(s[..],30)==1 && !s[0].project_loading;
 #assert al_key(s[..],78) && s[0].station==4;al_hash(s[..],"cut?card=1");#assert s[0].station==5 && s[0].movie_card;al_message(s[..],700,"60");#assert al_frame_index(s[..])==60 && s[0].time==2 && !s[0].playing;
 damaged:[32768]u8;nn:=project_test_bytes(damaged[..]);damaged[0]='!';#assert !al_project_begin(s[..],damaged[0..<nn]) && s[0].project_active==active && al_probe(s[..],30)==1;al_message(s[..],700,"144001");#assert al_frame_index(s[..])==60;
}

#test "inspection and film stations invalidate their shared geometry when crossing modes" {
 s:[1]AlState;s[0].station=4;s[0].movie[0].built=true;al_station(s[..],5);#assert s[0].movie[0].built;al_station(s[..],1);#assert !s[0].movie[0].built && s[0].mesh_dirty;s[0].movie[0].built=true;al_station(s[..],4);#assert !s[0].movie[0].built;
}
