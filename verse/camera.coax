// The Grid's cinematic camera: the overview the home screen shows, high
// above where you arrive, slowly circling it, and the dolly that Start runs,
// a long eased swoop from wherever the camera is down to behind your
// character, where verse/player.coax's follow camera takes over.
//
// A shot is an eye and the point it looks at, as verse_grid_view and
// verse_grid_frame take them. The host keeps a Dolly value and passes it
// back each frame with the shot the dolly ends on (the player's camera).
//   coax/bin/coax test verse/camera.coax

PI :: 3.14159265;
CENTER_X :: 0.0;          // what the overview circles: the spawn and its terminal
CENTER_Z :: 3.0;
ORBIT_RADIUS :: 62.0;     // metres out from the centre
ORBIT_HEIGHT :: 38.0;     // metres up
ORBIT_SPEED :: 0.035;     // radians a second: once round in three minutes
ORBIT_START :: 3.6;       // radians: the first view, from behind and to the right
SWAY :: 2.5;              // metres the eye rises and falls as it circles
SWAY_SPEED :: 0.11;       // radians a second
DOLLY :: 8.5;             // seconds: Start's swoop
HURRY :: 1.1;             // seconds: what is left once a touch hurries it
LEAD :: 1.3;              // the look-at gets there this much sooner than the eye
SWOOP_BACK :: 0.22;       // the last approach comes in from behind and above,
SWOOP_UP :: 0.12;         //   this share of the way back and up

Point :: struct { x: f32; y: f32; z: f32; }
Shot :: struct { eye: Point; at: Point; }

// A dolly from `from` to wherever the host says it ends, starting at
// `start` and taking `length` seconds. Length 0 is a cut.
Dolly :: struct { from: Shot; start: f64; length: f32; }

v3 :: (x: f32, y: f32, z: f32) -> Point { return Point.{x = x, y = y, z = z}; }
add :: (a: Point, b: Point) -> Point { return v3(a.x + b.x, a.y + b.y, a.z + b.z); }
sub :: (a: Point, b: Point) -> Point { return v3(a.x - b.x, a.y - b.y, a.z - b.z); }
times :: (a: Point, k: f32) -> Point { return v3(a.x * k, a.y * k, a.z * k); }
length :: (a: Point) -> f32 { return sqrt(a.x * a.x + a.y * a.y + a.z * a.z); }
mix :: (a: Point, b: Point, t: f32) -> Point { return add(a, times(sub(b, a), t)); }
clamp01 :: (x: f32) -> f32 { if x < 0 { return 0; } if x > 1 { return 1; } return x; }
finite :: (x: f32) -> bool { return x == x && x < 1000000 && x > -1000000; }
finite3 :: (a: Point) -> bool { return finite(a.x) && finite(a.y) && finite(a.z); }

// Smootherstep: starts and ends at rest, with no jerk at either end.
ease :: (x: f32) -> f32 { t := clamp01(x); return t * t * t * (t * (t * 6 - 15) + 10); }

// A cubic Bézier through a and d, pulled toward b and c.
bezier :: (a: Point, b: Point, c: Point, d: Point, t: f32) -> Point {
  u := 1 - t;
  return add(add(times(a, u * u * u), times(b, 3 * u * u * t)), add(times(c, 3 * u * t * t), times(d, t * t * t)));
}

// ---- The overview ----

// The home screen's camera at `now` seconds: circling high above the spawn,
// rising and falling a little, looking down at it.
verse_camera_overview :: (now: f64) -> Shot #export_c {
  t := f32(now);
  if !finite(t) { t = 0; }
  // Wrapped, so a long-running home loses no float precision.
  a := f32(ORBIT_START) + f32(ORBIT_SPEED) * (t - f32(2 * PI / ORBIT_SPEED) * floor(t / f32(2 * PI / ORBIT_SPEED)));
  s: Shot;
  s.at = v3(f32(CENTER_X), 0.5, f32(CENTER_Z));
  s.eye = v3(f32(CENTER_X) + sin(a) * f32(ORBIT_RADIUS),
             f32(ORBIT_HEIGHT) + sin(t * f32(SWAY_SPEED)) * f32(SWAY),
             f32(CENTER_Z) + cos(a) * f32(ORBIT_RADIUS));
  return s;
}

// ---- The dolly ----

// Start pressed at `now`, the camera showing `from`. With reduced motion,
// it cuts.
verse_camera_dolly_start :: (from: Shot, now: f64, reduced: bool) -> Dolly #export_c {
  return Dolly.{from = from, start = now, length = ifx reduced then 0.0f32 else f32(DOLLY)};
}

// How far through the dolly `now` is, 0 to 1.
progress :: (d: Dolly, now: f64) -> f32 {
  if !(d.length > 0) { return 1; }
  return clamp01(f32((now - d.start) / f64(d.length)));
}

verse_camera_dolly_done :: (d: Dolly, now: f64) -> bool #export_c { return progress(d, now) >= 1; }

// The shot at `now`, ending on `to`. The eye leaves along the line toward
// `to` at the height it had, then comes down and in from behind `to`; the
// look-at turns to `to` sooner, so the character is in view before the
// camera settles behind it.
verse_camera_dolly :: (d: Dolly, now: f64, to: Shot) -> Shot #export_c {
  t := progress(d, now);
  if t >= 1 || !finite3(d.from.eye) || !finite3(d.from.at) { return to; }
  a := d.from.eye; z := to.eye;
  far := length(sub(z, a));
  back := sub(to.eye, to.at); back.y = 0;
  flat := length(back);
  back = ifx flat > 0.001 then times(back, 1 / flat) else v3(0, 0, -1);
  b := mix(a, z, 0.35); b.y = a.y;
  c := add(z, add(times(back, f32(SWOOP_BACK) * far), v3(0, f32(SWOOP_UP) * far, 0)));
  s: Shot;
  s.eye = bezier(a, b, c, z, ease(t));
  s.at = mix(d.from.at, to.at, ease(t * f32(LEAD)));
  return s;
}

// A touch during the dolly: what is left of it now takes HURRY seconds,
// from where the camera is.
verse_camera_dolly_hurry :: (d: Dolly, now: f64, to: Shot) -> Dolly #export_c {
  if verse_camera_dolly_done(d, now) { return d; }
  if f32(now - d.start) + f32(HURRY) >= d.length { return d; }
  return Dolly.{from = verse_camera_dolly(d, now, to), start = now, length = f32(HURRY)};
}

// ---- Checks ----

near :: (a: f32, b: f32, tolerance: f32) -> bool { return abs(a - b) <= tolerance; }
same :: (a: Point, b: Point, tolerance: f32) -> bool { return near(a.x, b.x, tolerance) && near(a.y, b.y, tolerance) && near(a.z, b.z, tolerance); }
behind_you :: () -> Shot { return Shot.{eye = v3(0, 2.6, -4.2), at = v3(0, 1.6, 0)}; }

#test "the ease rests at both ends" {
  #assert ease(0) == 0 && ease(1) == 1 && ease(-1) == 0 && ease(2) == 1;
  #assert near(ease(0.5), 0.5, 0.00001);
  #assert ease(0.01) < 0.0001 && ease(0.99) > 0.9999;
}

#forall "the ease only rises" i: 0..<100 {
  #assert ease(f32(i + 1) / 100) >= ease(f32(i) / 100);
}

#forall "the overview circles the spawn from high up, looking down" i: 0..<120 {
  s := verse_camera_overview(f64(i) * 7.3);
  out := v3(s.eye.x - f32(CENTER_X), 0, s.eye.z - f32(CENTER_Z));
  #assert near(length(out), f32(ORBIT_RADIUS), 0.01);
  #assert s.eye.y >= f32(ORBIT_HEIGHT - SWAY) - 0.01 && s.eye.y <= f32(ORBIT_HEIGHT + SWAY) + 0.01;
  #assert near(s.at.x, f32(CENTER_X), 0.0001) && near(s.at.z, f32(CENTER_Z), 0.0001);
}

#test "the overview moves slowly and never jumps" {
  a := verse_camera_overview(10);
  b := verse_camera_overview(10 + 1.0 / 60.0);
  #assert length(sub(a.eye, b.eye)) < 0.1;
  // Around the wrap, after a full circle.
  w := f64(2 * PI / ORBIT_SPEED);
  c := verse_camera_overview(w - 1.0 / 120.0);
  e := verse_camera_overview(w + 1.0 / 120.0);
  #assert length(sub(c.eye, e.eye)) < 0.1;
  // A clock it can't use gives the first view.
  #assert same(verse_camera_overview(0).eye, verse_camera_overview(f64(1.0 / 0.0)).eye, 0.0001);
}

#test "the dolly starts where the camera is and ends behind you" {
  from := verse_camera_overview(20);
  d := verse_camera_dolly_start(from, 100, false);
  #assert same(verse_camera_dolly(d, 100, behind_you()).eye, from.eye, 0.001);
  #assert same(verse_camera_dolly(d, 100, behind_you()).at, from.at, 0.001);
  #assert !verse_camera_dolly_done(d, 100);
  end := verse_camera_dolly(d, 100 + f64(DOLLY), behind_you());
  #assert same(end.eye, behind_you().eye, 0.0001) && same(end.at, behind_you().at, 0.0001);
  #assert verse_camera_dolly_done(d, 100 + f64(DOLLY));
  #assert !verse_camera_dolly_done(d, 100 + f64(DOLLY) - 0.01);
  // Before it starts (a clock stepping back), it holds the first shot.
  #assert same(verse_camera_dolly(d, 99, behind_you()).eye, from.eye, 0.001);
}

#forall "the dolly is smooth, above the ground, and comes in from behind" step: 0..<170, round: 0..<3 {
  from := verse_camera_overview(f64(round) * 40);
  d := verse_camera_dolly_start(from, 0, false);
  t := f64(step) / 20;
  a := verse_camera_dolly(d, t, behind_you());
  b := verse_camera_dolly(d, t + 1.0 / 60.0, behind_you());
  // At 60 frames a second no step is far: the swoop is gentle.
  #assert length(sub(a.eye, b.eye)) < 0.45;
  #assert a.eye.y >= behind_you().eye.y - 0.001;
  #assert finite3(a.eye) && finite3(a.at);
  // The look-at leads: it is nearer its end than the eye is to its own.
  if step > 0 && step < 169 {
    eye_left := length(sub(a.eye, behind_you().eye)) / length(sub(from.eye, behind_you().eye));
    at_left := length(sub(a.at, behind_you().at)) / length(sub(from.at, behind_you().at));
    #assert at_left <= eye_left + 0.001;
  }
}

#test "the last stretch comes down from behind and above you" {
  d := verse_camera_dolly_start(verse_camera_overview(0), 0, false);
  late := verse_camera_dolly(d, f64(DOLLY) * 0.9, behind_you());
  // Behind you is -z here: the eye is further back and higher than its end.
  #assert late.eye.z < behind_you().eye.z && late.eye.y > behind_you().eye.y;
}

#test "reduced motion cuts" {
  d := verse_camera_dolly_start(verse_camera_overview(5), 50, true);
  #assert verse_camera_dolly_done(d, 50);
  #assert same(verse_camera_dolly(d, 50, behind_you()).eye, behind_you().eye, 0);
}

#test "a touch hurries the rest from where the camera is" {
  d := verse_camera_dolly_start(verse_camera_overview(5), 0, false);
  mid := verse_camera_dolly(d, 2, behind_you());
  h := verse_camera_dolly_hurry(d, 2, behind_you());
  #assert near(h.length, f32(HURRY), 0) && h.start == 2;
  #assert same(verse_camera_dolly(h, 2, behind_you()).eye, mid.eye, 0.001);
  #assert verse_camera_dolly_done(h, 2 + f64(HURRY));
  // Already nearly there: it isn't slowed down.
  late := verse_camera_dolly_hurry(d, f64(DOLLY) - 0.5, behind_you());
  #assert late.start == 0 && late.length == f32(DOLLY);
  // Done: nothing changes.
  done := verse_camera_dolly_hurry(d, 100, behind_you());
  #assert done.start == 0;
}

#test "a broken shot is not followed" {
  bad := Shot.{eye = v3(f32(0.0 / 0.0), 1, 1), at = v3(0, 0, 0)};
  d := verse_camera_dolly_start(bad, 0, false);
  #assert same(verse_camera_dolly(d, 1, behind_you()).eye, behind_you().eye, 0);
}
