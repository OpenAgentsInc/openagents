// The engine's cameras. Each one answers with a Shot, an eye and the point
// it looks at, as verse_grid_view and verse_grid_frame take them, so one
// camera can hand over to another by blending shots:
// - the overview the home screen shows, high above where you arrive,
//   slowly circling it;
// - the dolly that Start runs, a long eased swoop from wherever the camera
//   is down to behind your character;
// - the free orbit (Orbit), the third-person camera of an open world: it
//   circles your character at your shoulder, turns with a mouse drag, the
//   arrow keys or a thumb, zooms, swings gently behind you as you walk,
//   and pulls in where scenery is in the way. Zoomed in past its closest,
//   it goes on into your head: first person, looking out of your eyes,
//   free to look straight up or down; zooming out again comes back out.
//
// The host keeps a Dolly or an Orbit value and passes it back each frame.
//   coax/bin/coax test verse/camera.coax

#load "space.coax";

CENTER_X :: 0.0;          // what the overview circles: the spawn and its terminal
CENTER_Z :: 3.0;
ORBIT_RADIUS :: 62.0;     // metres out from the centre
ORBIT_HEIGHT :: 38.0;     // metres up
ORBIT_SPEED :: 0.035;     // radians a second: once round in three minutes
ORBIT_START :: 3.6;       // radians: the first view, from behind and to the right
SWAY :: 2.5;              // metres the eye rises and falls as it circles
SWAY_SPEED :: 0.11;       // radians a second
DOLLY :: 8.5;             // seconds: Start's swoop
HURRY :: 1.1;             // seconds: what is left once a touch hurries it
LEAD :: 1.3;              // the look-at gets there this much sooner than the eye
SWOOP_BACK :: 0.22;       // the last approach comes in from behind and above,
SWOOP_UP :: 0.12;         //   this share of the way back and up

// A dolly from `from` to wherever the host says it ends, starting at
// `start` and taking `length` seconds. Length 0 is a cut.
Dolly :: struct { from: Shot; start: f64; length: f32; }

// Smootherstep: starts and ends at rest, with no jerk at either end.
ease :: (x: f32) -> f32 { t := clamp01(x); return t * t * t * (t * (t * 6 - 15) + 10); }

// A cubic Bézier through a and d, pulled toward b and c.
bezier :: (a: Point, b: Point, c: Point, d: Point, t: f32) -> Point {
  u := 1 - t;
  return add(add(times(a, u * u * u), times(b, 3 * u * u * t)), add(times(c, 3 * u * t * t), times(d, t * t * t)));
}

// ---- The overview ----

// The home screen's camera at `now` seconds: circling high above the spawn,
// rising and falling a little, looking down at it.
verse_camera_overview :: (now: f64) -> Shot #export_c {
  t := f32(now);
  if !finite(t) { t = 0; }
  // Wrapped, so a long-running home loses no float precision.
  a := f32(ORBIT_START) + f32(ORBIT_SPEED) * (t - f32(2 * PI / ORBIT_SPEED) * floor(t / f32(2 * PI / ORBIT_SPEED)));
  s: Shot;
  s.at = v3(f32(CENTER_X), 0.5, f32(CENTER_Z));
  s.eye = v3(f32(CENTER_X) + sin(a) * f32(ORBIT_RADIUS),
             f32(ORBIT_HEIGHT) + sin(t * f32(SWAY_SPEED)) * f32(SWAY),
             f32(CENTER_Z) + cos(a) * f32(ORBIT_RADIUS));
  return s;
}

// ---- The dolly ----

// Start pressed at `now`, the camera showing `from`. With reduced motion,
// it cuts.
verse_camera_dolly_start :: (from: Shot, now: f64, reduced: bool) -> Dolly #export_c {
  return Dolly.{from = from, start = now, length = ifx reduced then 0.0f32 else f32(DOLLY)};
}

// How far through the dolly `now` is, 0 to 1.
progress :: (d: Dolly, now: f64) -> f32 {
  if !(d.length > 0) { return 1; }
  return clamp01(f32((now - d.start) / f64(d.length)));
}

verse_camera_dolly_done :: (d: Dolly, now: f64) -> bool #export_c { return progress(d, now) >= 1; }

// The shot at `now`, ending on `to`. The eye leaves along the line toward
// `to` at the height it had, then comes down and in from behind `to`; the
// look-at turns to `to` sooner, so the character is in view before the
// camera settles behind it.
verse_camera_dolly :: (d: Dolly, now: f64, to: Shot) -> Shot #export_c {
  t := progress(d, now);
  if t >= 1 || !finite3(d.from.eye) || !finite3(d.from.at) { return to; }
  a := d.from.eye; z := to.eye;
  far := length(sub(z, a));
  back := sub(to.eye, to.at); back.y = 0;
  flat := length(back);
  back = ifx flat > 0.001 then times(back, 1 / flat) else v3(0, 0, -1);
  b := mix(a, z, 0.35); b.y = a.y;
  c := add(z, add(times(back, f32(SWOOP_BACK) * far), v3(0, f32(SWOOP_UP) * far, 0)));
  s: Shot;
  s.eye = bezier(a, b, c, z, ease(t));
  s.at = mix(d.from.at, to.at, ease(t * f32(LEAD)));
  return s;
}

// A touch during the dolly: what is left of it now takes HURRY seconds,
// from where the camera is.
verse_camera_dolly_hurry :: (d: Dolly, now: f64, to: Shot) -> Dolly #export_c {
  if verse_camera_dolly_done(d, now) { return d; }
  if f32(now - d.start) + f32(HURRY) >= d.length { return d; }
  return Dolly.{from = verse_camera_dolly(d, now, to), start = now, length = f32(HURRY)};
}

// ---- The free orbit ----
//
// It circles a pivot that follows your head, looking along yaw (0 is +Z)
// and pitch (down from level), with you a little left of the middle: the
// view is centred FREE_SHOULDER to your right, over your shoulder. The eye
// sits on the line from the pivot to where it wants to be, as far along it
// as scenery allows, so it is never behind a tree or inside a wall, and
// it always looks the same way, so nothing jumps when it pulls in. A frame:
//   verse_orbit_look (a drag or a thumb) and verse_orbit_keys (the arrows),
//   verse_orbit_follow (you moved), verse_orbit_room against the scenery
//   along verse_orbit_ray (and the host's ground along the same ray),
//   verse_orbit_limit with the room left, verse_orbit_shot to draw.

FREE_DIST :: 5.2;            // metres back, to start
FREE_NEAR :: 1.5;            // the closest a zoom comes in
FREE_FAR :: 12.0;            // the furthest it goes out
FREE_HEIGHT :: 1.45;         // the pivot, above your feet
FREE_SHOULDER :: 0.55;       // metres right of you the view is centred
FREE_PITCH :: 0.3;           // radians down: where it rests
FREE_PITCH_MIN :: -0.55;     // looking up past the horizon
FREE_PITCH_MAX :: 1.3;       // nearly straight down
FREE_FOLLOW :: 12.0;         // per second: the pivot catching up with you
FREE_JUMP :: 12.0;           // metres: further than this in a frame is a cut
FREE_RECENTRE_AFTER :: 1.4;  // seconds after the last look before it swings
FREE_RECENTRE :: 1.3;        // per second: swinging behind where you walk
FREE_TOWARD :: 2.4;          // radians: walking at the camera this square doesn't swing it
FREE_ZOOM :: 9.0;            // per second: easing to the zoom asked for
FREE_OUT :: 2.5;             // per second: backing out once scenery lets go
FREE_CLEAR :: 0.25;          // how far the eye keeps from scenery
FREE_MIN_ROOM :: 0.3;        // the closest scenery pushes it to the pivot
FREE_KEY_TURN :: 2.2;        // radians a second for a held arrow key
FREE_PUSH :: 0.6;            // metres of zoom past FREE_NEAR that take it into your head
FREE_EYE :: 1.62;            // first person: your eyes, above your feet
FREE_FACE :: 0.12;           // and this far in front of the pivot, clear of your face
FREE_INSIDE :: 0.6;          // past this share of the way in your body is out of the shot
FREE_FIRST_PITCH :: 1.45;    // first person: radians up or down it can look
SPHERE :: 4;                 // numbers per sphere: centre x, y, z, radius
BOX :: 6;                    // numbers per box: min x, y, z, max x, y, z

Orbit :: struct {
  yaw: f32;
  pitch: f32 = FREE_PITCH;
  want: f32 = FREE_DIST;     // the distance asked for
  zoom: f32 = FREE_DIST;     // eased toward want
  shown: f32 = FREE_DIST;    // how far along the ray the eye is drawn
  pivot: Point;
  idle: f32 = FREE_RECENTRE_AFTER;   // seconds since the last look
  push: f32;                 // zoom asked for past FREE_NEAR, toward going in
}

// The line the eye sits on: from the pivot, toward where it wants to be,
// that far.
OrbitRay :: struct { from: Point; dir: Point; far: f32; }

// Behind your feet, facing as you do.
verse_orbit_start :: (feet: Point, facing: f32) -> Orbit #export_c {
  o: Orbit;
  o.yaw = ifx finite(facing) then wrap_angle(facing) else 0.0f32;
  o.pivot = ifx finite3(feet) then add(feet, v3(0, f32(FREE_HEIGHT), 0)) else v3(0, f32(FREE_HEIGHT), 0);
  o.shown = verse_orbit_ray(o).far;
  return o;
}

// Where it looks, and its right hand (level).
verse_orbit_forward :: (o: Orbit) -> Point #export_c {
  return v3(sin(o.yaw) * cos(o.pitch), -sin(o.pitch), cos(o.yaw) * cos(o.pitch));
}
verse_orbit_right :: (o: Orbit) -> Point #export_c { return v3(-cos(o.yaw), 0, sin(o.yaw)); }

// How far into first person it is: 0 out at FREE_NEAR or further, 1 with
// the eye in your head. It follows the eased zoom, so it changes smoothly.
verse_orbit_first :: (o: Orbit) -> f32 #export_c {
  if !finite(o.zoom) { return 0; }
  return clamp01(1 - o.zoom / f32(FREE_NEAR));
}

// The eye is in your head (or nearly): the host leaves your body out.
verse_orbit_inside :: (o: Orbit) -> bool #export_c { return verse_orbit_first(o) >= f32(FREE_INSIDE); }

// How far up and down it may look, widening in first person.
pitch_low :: (o: Orbit) -> f32 { return lerp(f32(FREE_PITCH_MIN), -f32(FREE_FIRST_PITCH), verse_orbit_first(o)); }
pitch_high :: (o: Orbit) -> f32 { return lerp(f32(FREE_PITCH_MAX), f32(FREE_FIRST_PITCH), verse_orbit_first(o)); }

// A drag or a thumb: positive dyaw turns left, positive dpitch looks up,
// in radians.
verse_orbit_look :: (o: Orbit, dyaw: f32, dpitch: f32) -> Orbit #export_c {
  next := o;
  moved := false;
  if finite(dyaw) && dyaw != 0 { next.yaw = wrap_angle(o.yaw + dyaw); moved = true; }
  if finite(dpitch) && dpitch != 0 { next.pitch = clamp(o.pitch - dpitch, pitch_low(o), pitch_high(o)); moved = true; }
  if moved { next.idle = 0; }
  return next;
}

// The arrow keys held: turn (1 left, -1 right) and tilt (1 up, -1 down).
verse_orbit_keys :: (o: Orbit, turn: f32, tilt: f32, dt: f32) -> Orbit #export_c {
  if !finite(dt) || dt <= 0 { return o; }
  t := lo(dt, 0.25);
  return verse_orbit_look(o, clamp(turn, -1, 1) * f32(FREE_KEY_TURN) * t, clamp(tilt, -1, 1) * f32(FREE_KEY_TURN) * 0.6 * t);
}

// The wheel or a pinch: positive is further out. Coming in, it stops at
// FREE_NEAR; FREE_PUSH more goes into your head (want 0, first person). Out
// of your head, any zoom out comes back to FREE_NEAR.
verse_orbit_zoom :: (o: Orbit, delta: f32) -> Orbit #export_c {
  next := o;
  if !finite(delta) || delta == 0 { return next; }
  if o.want < f32(FREE_NEAR) {
    if delta > 0 { next.want = f32(FREE_NEAR); next.push = 0; }
    return next;
  }
  if delta > 0 { next.want = clamp(o.want + delta, f32(FREE_NEAR), f32(FREE_FAR)); next.push = 0; return next; }
  if o.want > f32(FREE_NEAR) + 0.001 { next.want = clamp(o.want + delta, f32(FREE_NEAR), f32(FREE_FAR)); next.push = 0; return next; }
  next.push = o.push - delta;
  if next.push >= f32(FREE_PUSH) { next.want = 0; next.push = 0; }
  return next;
}

// You are at feet, heading that way (yaw) when moving. The pivot catches
// up; a while after the last look, walking swings the camera gently in
// behind you, except when you walk at it.
verse_orbit_follow :: (o: Orbit, feet: Point, heading: f32, moving: bool, dt: f32) -> Orbit #export_c {
  next := o;
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  if !finite3(feet) { return next; }
  dest := add(feet, v3(0, f32(FREE_HEIGHT), 0));
  if !finite3(o.pivot) || length(sub(dest, o.pivot)) > f32(FREE_JUMP) { next.pivot = dest; }
  else { next.pivot = mix(o.pivot, dest, settle(f32(FREE_FOLLOW), t)); }
  next.idle = lo(o.idle + t, 1000);
  // Looking out of your eyes it never swings: you walk where you look.
  outside := 1 - verse_orbit_first(o);
  if moving && finite(heading) && next.idle >= f32(FREE_RECENTRE_AFTER) && outside > 0.001 {
    ramp := clamp01((next.idle - f32(FREE_RECENTRE_AFTER)) / 0.6) * outside;
    d := wrap_angle(heading - o.yaw);
    if abs(d) < f32(FREE_TOWARD) {
      next.yaw = wrap_angle(o.yaw + d * settle(f32(FREE_RECENTRE), t) * ramp);
    }
    next.pitch = lerp(o.pitch, f32(FREE_PITCH), settle(f32(FREE_RECENTRE), t) * ramp);
  }
  next.zoom = lerp(o.zoom, o.want, settle(f32(FREE_ZOOM), t));
  // Coming back out, a look straight up or down eases into the third
  // person's range as it narrows.
  if finite(next.pitch) {
    kept := clamp(next.pitch, pitch_low(next), pitch_high(next));
    next.pitch = lerp(next.pitch, kept, settle(f32(FREE_ZOOM), t));
  }
  return next;
}

// Going in, the shoulder offset closes and the line's start rises from the
// pivot to your eyes, a little in front of your face.
verse_orbit_ray :: (o: Orbit) -> OrbitRay #export_c {
  k := verse_orbit_first(o);
  back := times(verse_orbit_forward(o), -o.zoom);
  want := add(back, times(verse_orbit_right(o), f32(FREE_SHOULDER) * (1 - k)));
  ahead := v3(sin(o.yaw), 0, cos(o.yaw));
  r: OrbitRay;
  r.from = add(o.pivot, times(add(v3(0, f32(FREE_EYE - FREE_HEIGHT), 0), times(ahead, f32(FREE_FACE))), k));
  r.far = length(want);
  r.dir = unit_or(want, v3(0, 0, -1));
  return r;
}

// How far along the ray the eye may go before scenery, keeping
// FREE_CLEAR from it: spheres (SPHERE numbers each) and boxes (BOX
// numbers each). Scenery the pivot is inside doesn't count.
verse_orbit_room :: (o: Orbit, spheres: [] f32, boxes: [] f32) -> f32 #export_c {
  r := verse_orbit_ray(o);
  room := r.far;
  for i: 0..<spheres.count / SPHERE {
    c := v3(spheres[i * SPHERE], spheres[i * SPHERE + 1], spheres[i * SPHERE + 2]);
    big := spheres[i * SPHERE + 3] + f32(FREE_CLEAR);
    oc := sub(r.from, c);
    b := dot(oc, r.dir);
    c2 := dot(oc, oc) - big * big;
    if !finite(c2) || c2 <= 0 { continue; }
    disc := b * b - c2;
    if disc < 0 { continue; }
    t := -b - sqrt(disc);
    if t >= 0 && t < room { room = t; }
  }
  for i: 0..<boxes.count / BOX {
    k := i * BOX;
    o3: [3] f32; dir3: [3] f32;
    o3[0] = r.from.x; o3[1] = r.from.y; o3[2] = r.from.z;
    dir3[0] = r.dir.x; dir3[1] = r.dir.y; dir3[2] = r.dir.z;
    enter := -1000000.0f32; leave := 1000000.0f32; inside := true; miss := false;
    for a: 0..<3 {
      low := boxes[k + a] - f32(FREE_CLEAR); high := boxes[k + 3 + a] + f32(FREE_CLEAR);
      if !(low <= high) { miss = true; break; }
      if o3[a] < low || o3[a] > high { inside = false; }
      if abs(dir3[a]) < 0.000001 {
        if o3[a] < low || o3[a] > high { miss = true; }
      } else {
        t0 := (low - o3[a]) / dir3[a]; t1 := (high - o3[a]) / dir3[a];
        enter = hi(enter, lo(t0, t1)); leave = lo(leave, hi(t0, t1));
      }
    }
    if miss || inside || enter > leave || enter < 0 { continue; }
    if enter < room { room = enter; }
  }
  return hi(room, 0);
}

// Scenery left `room` along the ray this frame (the least of
// verse_orbit_room and the host's ground): the eye comes in at once and
// backs out gently, never past where it wants to be.
verse_orbit_limit :: (o: Orbit, room: f32, dt: f32) -> Orbit #export_c {
  next := o;
  far := verse_orbit_ray(o).far;
  free := ifx finite(room) then clamp(room, lo(f32(FREE_MIN_ROOM), far), far) else far;
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  if free < o.shown || !finite(o.shown) { next.shown = free; }
  else { next.shown = lerp(o.shown, free, settle(f32(FREE_OUT), t)); }
  next.shown = lo(next.shown, far);
  return next;
}

// What to draw: the eye on the ray, looking forward.
verse_orbit_shot :: (o: Orbit) -> Shot #export_c {
  r := verse_orbit_ray(o);
  s: Shot;
  s.eye = add(r.from, times(r.dir, o.shown));
  s.at = add(s.eye, times(verse_orbit_forward(o), f32(FREE_DIST)));
  return s;
}

// Turns to look the way a shot does: how another camera (a cinematic, a
// close-up) hands control back without a jump in direction.
verse_orbit_toward :: (o: Orbit, s: Shot) -> Orbit #export_c {
  d := sub(s.at, s.eye);
  if !finite3(d) || length(d) < 0.0001 { return o; }
  next := o;
  next.yaw = yaw_of(d.x, d.z);
  next.pitch = clamp(atan2(-d.y, flat_length(d)), pitch_low(o), pitch_high(o));
  next.idle = 0;
  return next;
}

// Partway from one shot to another (eased): how a host blends into a
// close-up and back out to its live camera without a jump.
verse_shot_mix :: (a: Shot, b: Shot, t: f32) -> Shot #export_c {
  k := ease(t);
  return Shot.{eye = mix(a.eye, b.eye, k), at = mix(a.at, b.at, k)};
}

// The ray from the eye through a point on the screen: nx, ny from -1 to 1
// (right, up), with the projection's horizontal and vertical scales fx, fy
// (a point d ahead and x across lands at x * fx / d). What a click points at.
verse_shot_ray :: (s: Shot, fx: f32, fy: f32, nx: f32, ny: f32) -> OrbitRay #export_c {
  f := unit_or(sub(s.at, s.eye), v3(0, 0, 1));
  r := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0));
  up := cross(r, f);
  d := add(f, add(times(r, nx / hi(fx, 0.0001)), times(up, ny / hi(fy, 0.0001))));
  return OrbitRay.{from = s.eye, dir = unit_or(d, f), far = 1000};
}

// ---- Checks ----

behind_you :: () -> Shot { return Shot.{eye = v3(0, 2.6, -4.2), at = v3(0, 1.6, 0)}; }

#test "the ease rests at both ends" {
  #assert ease(0) == 0 && ease(1) == 1 && ease(-1) == 0 && ease(2) == 1;
  #assert near(ease(0.5), 0.5, 0.00001);
  #assert ease(0.01) < 0.0001 && ease(0.99) > 0.9999;
}

#forall "the ease only rises" i: 0..<100 {
  #assert ease(f32(i + 1) / 100) >= ease(f32(i) / 100);
}

#forall "the overview circles the spawn from high up, looking down" i: 0..<120 {
  s := verse_camera_overview(f64(i) * 7.3);
  out := v3(s.eye.x - f32(CENTER_X), 0, s.eye.z - f32(CENTER_Z));
  #assert near(length(out), f32(ORBIT_RADIUS), 0.01);
  #assert s.eye.y >= f32(ORBIT_HEIGHT - SWAY) - 0.01 && s.eye.y <= f32(ORBIT_HEIGHT + SWAY) + 0.01;
  #assert near(s.at.x, f32(CENTER_X), 0.0001) && near(s.at.z, f32(CENTER_Z), 0.0001);
}

#test "the overview moves slowly and never jumps" {
  a := verse_camera_overview(10);
  b := verse_camera_overview(10 + 1.0 / 60.0);
  #assert length(sub(a.eye, b.eye)) < 0.1;
  // Around the wrap, after a full circle.
  w := f64(2 * PI / ORBIT_SPEED);
  c := verse_camera_overview(w - 1.0 / 120.0);
  e := verse_camera_overview(w + 1.0 / 120.0);
  #assert length(sub(c.eye, e.eye)) < 0.1;
  // A clock it can't use gives the first view.
  #assert same(verse_camera_overview(0).eye, verse_camera_overview(f64(1.0 / 0.0)).eye, 0.0001);
}

#test "the dolly starts where the camera is and ends behind you" {
  from := verse_camera_overview(20);
  d := verse_camera_dolly_start(from, 100, false);
  #assert same(verse_camera_dolly(d, 100, behind_you()).eye, from.eye, 0.001);
  #assert same(verse_camera_dolly(d, 100, behind_you()).at, from.at, 0.001);
  #assert !verse_camera_dolly_done(d, 100);
  end := verse_camera_dolly(d, 100 + f64(DOLLY), behind_you());
  #assert same(end.eye, behind_you().eye, 0.0001) && same(end.at, behind_you().at, 0.0001);
  #assert verse_camera_dolly_done(d, 100 + f64(DOLLY));
  #assert !verse_camera_dolly_done(d, 100 + f64(DOLLY) - 0.01);
  // Before it starts (a clock stepping back), it holds the first shot.
  #assert same(verse_camera_dolly(d, 99, behind_you()).eye, from.eye, 0.001);
}

#forall "the dolly is smooth, above the ground, and comes in from behind" step: 0..<170, round: 0..<3 {
  from := verse_camera_overview(f64(round) * 40);
  d := verse_camera_dolly_start(from, 0, false);
  t := f64(step) / 20;
  a := verse_camera_dolly(d, t, behind_you());
  b := verse_camera_dolly(d, t + 1.0 / 60.0, behind_you());
  // At 60 frames a second no step is far: the swoop is gentle.
  #assert length(sub(a.eye, b.eye)) < 0.45;
  #assert a.eye.y >= behind_you().eye.y - 0.001;
  #assert finite3(a.eye) && finite3(a.at);
  // The look-at leads: it is nearer its end than the eye is to its own.
  if step > 0 && step < 169 {
    eye_left := length(sub(a.eye, behind_you().eye)) / length(sub(from.eye, behind_you().eye));
    at_left := length(sub(a.at, behind_you().at)) / length(sub(from.at, behind_you().at));
    #assert at_left <= eye_left + 0.001;
  }
}

#test "the last stretch comes down from behind and above you" {
  d := verse_camera_dolly_start(verse_camera_overview(0), 0, false);
  late := verse_camera_dolly(d, f64(DOLLY) * 0.9, behind_you());
  // Behind you is -z here: the eye is further back and higher than its end.
  #assert late.eye.z < behind_you().eye.z && late.eye.y > behind_you().eye.y;
}

#test "reduced motion cuts" {
  d := verse_camera_dolly_start(verse_camera_overview(5), 50, true);
  #assert verse_camera_dolly_done(d, 50);
  #assert same(verse_camera_dolly(d, 50, behind_you()).eye, behind_you().eye, 0);
}

#test "a touch hurries the rest from where the camera is" {
  d := verse_camera_dolly_start(verse_camera_overview(5), 0, false);
  mid := verse_camera_dolly(d, 2, behind_you());
  h := verse_camera_dolly_hurry(d, 2, behind_you());
  #assert near(h.length, f32(HURRY), 0) && h.start == 2;
  #assert same(verse_camera_dolly(h, 2, behind_you()).eye, mid.eye, 0.001);
  #assert verse_camera_dolly_done(h, 2 + f64(HURRY));
  // Already nearly there: it isn't slowed down.
  late := verse_camera_dolly_hurry(d, f64(DOLLY) - 0.5, behind_you());
  #assert late.start == 0 && late.length == f32(DOLLY);
  // Done: nothing changes.
  done := verse_camera_dolly_hurry(d, 100, behind_you());
  #assert done.start == 0;
}

#test "a broken shot is not followed" {
  bad := Shot.{eye = v3(f32(0.0 / 0.0), 1, 1), at = v3(0, 0, 0)};
  d := verse_camera_dolly_start(bad, 0, false);
  #assert same(verse_camera_dolly(d, 1, behind_you()).eye, behind_you().eye, 0);
}

// ---- The free orbit's checks ----

settled :: (o: Orbit) -> Orbit {
  next := o;
  for i: 0..<240 { next = verse_orbit_limit(verse_orbit_follow(next, sub(next.pivot, v3(0, f32(FREE_HEIGHT), 0)), 0, false, 1.0 / 60.0), 1000, 1.0 / 60.0); }
  return next;
}

#test "it starts behind you and above, over your right shoulder" {
  o := verse_orbit_start(v3(4, 0, 2), 0);
  s := verse_orbit_shot(o);
  #assert s.eye.z < 2 && s.eye.y > f32(FREE_HEIGHT);
  // Facing +Z your right is -X: the eye is a little that way.
  #assert s.eye.x < 4 && s.eye.x > 4 - 1;
  #assert near(length(sub(s.eye, o.pivot)), length(v3(f32(FREE_SHOULDER), 0, f32(FREE_DIST))), 0.001);
  // And it looks the way you face, a little down.
  f := verse_orbit_forward(o);
  #assert f.z > 0.9 && f.y < 0 && near(f.x, 0, 0.00001);
  r := verse_orbit_right(o);
  #assert same(r, v3(-1, 0, 0), 0.00001);
  #assert same(verse_orbit_start(v3(0, 0, 0), f32(0.0 / 0.0)).pivot, v3(0, f32(FREE_HEIGHT), 0), 0);
}

#forall "the shot is whole and looks forward wherever it turns" iy: -6..<7, ip: -4..<5 {
  o := verse_orbit_start(v3(1, 2, 3), 0);
  o = verse_orbit_look(o, f32(iy) * 0.6, f32(ip) * 0.4);
  #assert o.pitch >= f32(FREE_PITCH_MIN) && o.pitch <= f32(FREE_PITCH_MAX);
  s := verse_orbit_shot(o);
  #assert finite3(s.eye) && finite3(s.at);
  #assert near(length(verse_orbit_forward(o)), 1, 0.0001);
  d := unit_or(sub(s.at, s.eye), v3(0, 0, 0));
  #assert same(d, verse_orbit_forward(o), 0.0001);
  // The pivot (you) is ahead of the eye and a little to its left.
  to := sub(o.pivot, s.eye);
  #assert dot(to, verse_orbit_forward(o)) > 0;
  #assert dot(to, verse_orbit_right(o)) < 0;
}

#test "looking turns it, the keys turn it at their rate, and junk is ignored" {
  o := verse_orbit_start(v3(0, 0, 0), 0);
  l := verse_orbit_look(o, 0.5, 0.1);
  #assert near(l.yaw, 0.5, 0.00001) && near(l.pitch, f32(FREE_PITCH) - 0.1, 0.00001) && l.idle == 0;
  #assert verse_orbit_look(o, f32(0.0 / 0.0), f32(1.0 / 0.0)).yaw == o.yaw;
  #assert verse_orbit_look(o, 0, 0).idle == o.idle;
  k := verse_orbit_keys(o, 1, 0, 0.2);
  #assert near(k.yaw, f32(FREE_KEY_TURN) * 0.2, 0.0001);
  #assert near(verse_orbit_keys(o, 1, 0, 3).yaw, f32(FREE_KEY_TURN) * 0.25, 0.0001);
  #assert verse_orbit_keys(o, 1, 0, -1).yaw == o.yaw;
  #assert near(verse_orbit_keys(o, 9, 0, 0.1).yaw, f32(FREE_KEY_TURN) * 0.1, 0.0001);
  #assert verse_orbit_look(o, 0, 99).pitch == f32(FREE_PITCH_MIN) && verse_orbit_look(o, 0, -99).pitch == f32(FREE_PITCH_MAX);
}

#test "zoom asks for a distance, and it eases there" {
  o := verse_orbit_zoom(verse_orbit_start(v3(0, 0, 0), 0), 3);
  #assert near(o.want, f32(FREE_DIST) + 3, 0.0001) && o.zoom == f32(FREE_DIST);
  #assert verse_orbit_zoom(o, 100).want == f32(FREE_FAR) && verse_orbit_zoom(o, -100).want == f32(FREE_NEAR);
  s := settled(o);
  #assert near(s.zoom, o.want, 0.01) && near(s.shown, verse_orbit_ray(s).far, 0.05);
}

#test "the pivot follows you, smoothly, and cuts when you jump far" {
  o := verse_orbit_start(v3(0, 0, 0), 0);
  a := verse_orbit_follow(o, v3(1, 0, 0), 0, true, 1.0 / 60.0);
  #assert a.pivot.x > 0 && a.pivot.x < 0.5;
  for i: 0..<120 { a = verse_orbit_follow(a, v3(1, 0, 0), 0, true, 1.0 / 60.0); }
  #assert near(a.pivot.x, 1, 0.001) && near(a.pivot.y, f32(FREE_HEIGHT), 0.001);
  // One 1/30 s frame goes as far as two 1/60 s ones.
  one := verse_orbit_follow(o, v3(1, 0, 0), 0, false, 1.0 / 30.0);
  two := verse_orbit_follow(verse_orbit_follow(o, v3(1, 0, 0), 0, false, 1.0 / 60.0), v3(1, 0, 0), 0, false, 1.0 / 60.0);
  #assert near(one.pivot.x, two.pivot.x, 0.0001);
  cut := verse_orbit_follow(o, v3(40, 0, 0), 0, true, 1.0 / 60.0);
  #assert cut.pivot.x == 40;
  #assert same(verse_orbit_follow(o, v3(f32(0.0 / 0.0), 0, 0), 0, true, 0.1).pivot, o.pivot, 0);
}

#test "walking swings it behind you, a while after you last looked" {
  o := verse_orbit_look(verse_orbit_start(v3(0, 0, 0), 0), 0.001, 0);
  // Right after a look it holds.
  a := verse_orbit_follow(o, v3(0, 0, 0), f32(PI) / 2, true, 0.5);
  #assert near(a.yaw, o.yaw, 0.00001);
  // Later it swings toward where you walk (+X, a quarter turn) without overshooting.
  for i: 0..<600 { a = verse_orbit_follow(a, v3(0, 0, 0), f32(PI) / 2, true, 1.0 / 60.0); }
  #assert near(a.yaw, f32(PI) / 2, 0.02);
  // Standing still it doesn't.
  b := o;
  for i: 0..<600 { b = verse_orbit_follow(b, v3(0, 0, 0), f32(PI) / 2, false, 1.0 / 60.0); }
  #assert near(b.yaw, o.yaw, 0.00001);
  // Nor walking at the camera.
  c := o;
  for i: 0..<600 { c = verse_orbit_follow(c, v3(0, 0, 0), f32(PI), true, 1.0 / 60.0); }
  #assert near(c.yaw, o.yaw, 0.00001);
}

#test "a tree behind you pulls the eye in at once; it backs out gently" {
  nothing: [1] f32;
  o := settled(verse_orbit_start(v3(0, 0, 0), 0));
  r := verse_orbit_ray(o);
  spot := add(r.from, times(r.dir, 3));
  tree := [4] f32.[spot.x, spot.y, spot.z, 0.5];
  room := verse_orbit_room(o, tree[..], nothing[0..<0]);
  #assert room < 3 - 0.5 && room > 3 - 0.5 - f32(FREE_CLEAR) - 0.05;
  pulled := verse_orbit_limit(o, room, 1.0 / 60.0);
  #assert near(pulled.shown, room, 0.00001);
  s := verse_orbit_shot(pulled);
  #assert length(sub(s.eye, spot)) >= 0.5 + f32(FREE_CLEAR) - 0.01;
  // Gone again: one frame moves it only a little way out.
  back := verse_orbit_limit(pulled, 1000, 1.0 / 60.0);
  #assert back.shown > pulled.shown && back.shown < pulled.shown + 0.2;
  // The view's direction never changes as it pulls in.
  #assert same(unit_or(sub(s.at, s.eye), v3(0, 0, 0)), verse_orbit_forward(o), 0.0001);
}

#test "only scenery on the line counts" {
  nothing: [1] f32;
  o := settled(verse_orbit_start(v3(0, 0, 0), 0));
  far := verse_orbit_ray(o).far;
  ahead := [4] f32.[0, 1.5, 4, 1];      // in front of you
  aside := [4] f32.[6, 1.5, -2, 1];     // off to the side
  around := [4] f32.[0, 1.5, 0, 3];     // you are inside it
  #assert verse_orbit_room(o, ahead[..], nothing[0..<0]) == far;
  #assert verse_orbit_room(o, aside[..], nothing[0..<0]) == far;
  #assert verse_orbit_room(o, around[..], nothing[0..<0]) == far;
  wall := [6] f32.[-5, 0, -3, 5, 4, -2.5];     // a hedge behind you
  room := verse_orbit_room(o, nothing[0..<0], wall[..]);
  #assert room < far && room > 0;
  hit := add(verse_orbit_ray(o).from, times(verse_orbit_ray(o).dir, room));
  #assert near(hit.z, -2.5 + f32(FREE_CLEAR), 0.01);
  beside := [6] f32.[3, 0, -6, 6, 4, -4];
  #assert verse_orbit_room(o, nothing[0..<0], beside[..]) == far;
  bent := [6] f32.[1, 1, 1, 0, 0, 0];   // a box with its corners swapped is nothing
  #assert verse_orbit_room(o, nothing[0..<0], bent[..]) == far;
}

#forall "the eye stays inside the room it is given" k: 0..<40 {
  o := settled(verse_orbit_start(v3(0, 0, 0), f32(k) * 0.3));
  room := f32(k % 9) * 0.7;
  l := verse_orbit_limit(o, room, 1.0 / 60.0);
  #assert l.shown <= hi(room, f32(FREE_MIN_ROOM)) + 0.00001;
  #assert l.shown >= f32(FREE_MIN_ROOM) - 0.00001;
  #assert verse_orbit_limit(o, f32(0.0 / 0.0), 1.0 / 60.0).shown <= verse_orbit_ray(o).far + 0.00001;
}

#forall "another camera's shot hands back without a turn" iy: -5..<6, ip: -2..<4 {
  o := verse_orbit_look(verse_orbit_start(v3(2, 0, 2), 0), f32(iy) * 0.55, -f32(ip) * 0.3);
  back := verse_orbit_toward(verse_orbit_start(v3(2, 0, 2), 1), verse_orbit_shot(o));
  #assert same(verse_orbit_forward(back), verse_orbit_forward(o), 0.001);
  #assert verse_orbit_toward(o, Shot.{eye = v3(1, 1, 1), at = v3(1, 1, 1)}).yaw == o.yaw;
}

#test "a shot blends from one to the other and rests at both ends" {
  a := behind_you(); b := Shot.{eye = v3(3, 2, 1), at = v3(0, 1, 0)};
  #assert same(verse_shot_mix(a, b, 0).eye, a.eye, 0.00001) && same(verse_shot_mix(a, b, 1).at, b.at, 0.00001);
  m := verse_shot_mix(a, b, 0.5);
  #assert near(m.eye.x, 1.5, 0.0001);
}

#test "the screen's middle points along the shot, and its edges at the projection's edges" {
  s := Shot.{eye = v3(0, 2, -4), at = v3(0, 2, 0)};
  r := verse_shot_ray(s, 1.2, 1.5, 0, 0);
  #assert same(r.dir, v3(0, 0, 1), 0.0001) && same(r.from, s.eye, 0.0001);
  e := verse_shot_ray(s, 1.2, 1.5, 1, 1);
  // A point on that ray, projected the way a host's view does, lands at (1, 1).
  p := add(e.from, times(e.dir, 3));
  f := v3(0, 0, 1); rr := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0)); up := cross(rr, f);
  d := dot(f, sub(p, s.eye));
  #assert near(dot(rr, sub(p, s.eye)) * 1.2 / d, 1, 0.0001) && near(dot(up, sub(p, s.eye)) * 1.5 / d, 1, 0.0001);
}

#test "zooming in past the closest goes on into your head" {
  o := verse_orbit_zoom(verse_orbit_start(v3(4, 0, 2), 0), -100);
  #assert o.want == f32(FREE_NEAR) && o.push == 0;
  // At the closest, a little more isn't enough; FREE_PUSH in all is.
  a := verse_orbit_zoom(o, -f32(FREE_PUSH) * 0.5);
  #assert a.want == f32(FREE_NEAR) && near(a.push, f32(FREE_PUSH) * 0.5, 0.0001);
  #assert verse_orbit_zoom(a, 0.01).push == 0;
  b := verse_orbit_zoom(a, -f32(FREE_PUSH) * 0.5);
  #assert b.want == 0 && b.push == 0 && verse_orbit_first(b) == 0;
  // Settled: your eyes, a little in front of your face, looking your way.
  s := settled(b);
  #assert verse_orbit_first(s) > 0.999 && verse_orbit_inside(s);
  eye := verse_orbit_shot(s).eye;
  #assert same(eye, v3(4, f32(FREE_EYE), 2 + f32(FREE_FACE)), 0.01);
  #assert same(unit_or(sub(verse_orbit_shot(s).at, eye), v3(0, 0, 0)), verse_orbit_forward(s), 0.0001);
  // It looks nearly straight up and down; the third person can't.
  #assert near(verse_orbit_look(s, 0, 99).pitch, -f32(FREE_FIRST_PITCH), 0.0001);
  #assert near(verse_orbit_look(s, 0, -99).pitch, f32(FREE_FIRST_PITCH), 0.0001);
  #assert !verse_orbit_inside(settled(o));
}

#test "zooming out of your head comes back to the closest, smoothly" {
  start := settled(verse_orbit_zoom(verse_orbit_start(v3(0, 0, 0), 0), -100));
  inside := settled(verse_orbit_zoom(verse_orbit_zoom(start, -1), -1));
  #assert verse_orbit_inside(inside);
  // Looking straight up in first person, then out again.
  up := verse_orbit_look(inside, 0, 99);
  out := verse_orbit_zoom(up, 0.05);
  #assert out.want == f32(FREE_NEAR);
  // Each frame of the way out, the eye moves only a little.
  o := out;
  for i: 0..<240 {
    was := verse_orbit_shot(o).eye;
    o = verse_orbit_limit(verse_orbit_follow(o, v3(0, 0, 0), 0, false, 1.0 / 60.0), 1000, 1.0 / 60.0);
    #assert length(sub(verse_orbit_shot(o).eye, was)) < 0.3;
  }
  #assert verse_orbit_first(o) < 0.001 && !verse_orbit_inside(o);
  #assert o.pitch >= f32(FREE_PITCH_MIN) - 0.001;
  // Back where it was at the closest, but for the look.
  same_look := settled(verse_orbit_look(start, 0, start.pitch - o.pitch));
  #assert same(verse_orbit_shot(o).eye, verse_orbit_shot(same_look).eye, 0.02);
  // In your head, walking doesn't swing the view.
  w := inside;
  for i: 0..<300 { w = verse_orbit_follow(w, v3(0, 0, 0), f32(PI) / 2, true, 1.0 / 60.0); }
  #assert near(w.yaw, inside.yaw, 0.00001);
}
