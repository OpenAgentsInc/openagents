// Character Create's Nature glade, composed against Quaternius Preview_1.jpg.
// Coax owns the composition, terrain, palette and deterministic planting.
#module "verse.characterglade";

#test "glade preserves a level character clearing and winds the path through the hills" {
  #assert cg_height(0,0)==0 && cg_height(1,0)==0;
  #assert cg_height(-10,-20)>2 && cg_height(18,-30)>1;
  #assert cg_path(cg_path_x(-12),-12)>0.99 && cg_path(14,-12)<0.01;
}
#test "glade composition puts green woods left and autumn birches right" {
  a:=cg_item(0);b:=cg_item(7);
  #assert a.kind==0 && a.x<0 && b.kind==1 && b.x>0;
  #assert cg_item(16).kind==2;
}
CgItem :: struct {kind:int;variant:int;x:f32;z:f32;scale:f32; yaw:f32;lift:f32;vertical:f32;tint:[3]f32;}
CG_ITEMS :: 24;
cg_path_x :: (z:f32)->f32 {return 2.1*sin(z*0.27)+0.9-(ifx z>0 then z*0.55 else 0.0);}
cg_path :: (x:f32,z:f32)->f32 {
 d:=abs(x-cg_path_x(z));fade:=(z+24)/8;main:=exp(-d*d/(0.85+abs(z)*0.12))*(ifx fade<0 then 0 else ifx fade>1 then 1 else fade);
 branch_d:=z+10+1.4*(x+2);branch_fade:=(-x-0.5)/1.5;branch:=exp(-branch_d*branch_d/4.0)*(ifx branch_fade<0 then 0 else ifx branch_fade>1 then 1 else branch_fade);
 return ifx main>branch then main else branch;
}
cg_height :: (x:f32,z:f32)->f32 {
  away:=sqrt(x*x+z*z);if away<2 {return 0;}
  h:=4.0*exp(-((x+11)*(x+11)/110+(z+22)*(z+22)/95))+5.8*exp(-((x-17)*(x-17)/160+(z+33)*(z+33)/180));
  h+=11.2*exp(-((x+8)*(x+8)/120+(z+34)*(z+34)/70));
  fade:=ifx away<5 then (away-2)/3 else 1;
  return h*fade;
}
#test "glade rear ridge is golden while foreground woods remain green" {
 #assert cg_autumn(-4,-30)>0.8 && cg_autumn(-6,-5)==0;
}
cg_autumn :: (x:f32,z:f32)->f32 {
 side:=(x+z*0.1-1)/16;rear:=(-z-16)/13;wood:=(x+12)/5;
 a:=ifx side>0 then side else 0;b:=(ifx rear<0 then 0 else ifx rear>1 then 1 else rear)*(ifx wood<0 then 0 else ifx wood>1 then 1 else wood);
 v:=ifx a>b then a else b;return ifx v>1 then 1 else v;
}
cg_hash :: (a:f32,b:f32)->f32 {v:=sin(a*127.1+b*311.7)*43758.5453;return v-floor(v);}
cg_item :: (i:int)->CgItem {
  // x, z, scale, yaw, source variant. The rocks form the stepped left cliff.
  p:=[24][5]f32.[
    [5]f32.[-10.5,-9,0.42,1.1,2],[5]f32.[-6,-13,0.48,1.5,1],[5]f32.[-15,-18,0.55,2.4,2],[5]f32.[-4,-18,0.36,0.4,3],[5]f32.[-16,-17,0.45,1.0,4],[5]f32.[-13,-19,0.45,2,0],[5]f32.[-7,-30,0.45,0.3,1],
    [5]f32.[2.2,-0.5,0.16,0.1,0],[5]f32.[6,-13,0.42,1.3,1],[5]f32.[5,-24,0.40,0.8,2],[5]f32.[15,-26,0.5,2.1,3],[5]f32.[1.6,-21,0.48,1,4],[5]f32.[9,-35,0.5,1.7,0],[5]f32.[20,-18,0.5,2,2],[5]f32.[22,-35,0.5,0.5,3],[5]f32.[-1.8,-19,0.5,1.4,1],
    [5]f32.[-9,-18,1.25,0.1,1],[5]f32.[-14,-23,2.8,0.5,3],[5]f32.[-7,-20,1.4,2.4,1],[5]f32.[-9,-13,0.65,1.8,1],[5]f32.[1.3,-2.5,0.22,0.5,0],[5]f32.[-3.6,-4,0.18,2.1,3],[5]f32.[1.75,0.9,0.18,1.3,3],[5]f32.[1.8,-13,0.26,0.1,0]];
  r:CgItem;r.kind=ifx i<7 then 0 else ifx i<16 then 1 else ifx i==17 || i==21 || i==22 then 3 else 2;r.variant=int(p[i][4]);r.x=p[i][0];r.z=p[i][1];r.scale=p[i][2];r.yaw=p[i][3];r.lift=ifx i==17 then 1.7 else 0.0;r.vertical=ifx i==0 then 1.56 else ifx i==7 then 1.58 else ifx i==17 then 0.90 else 1.0;
  r.tint=ifx r.kind==1 then (ifx i==9 then [3]f32.[1.0,0.65,0.12] else ifx i==15 then [3]f32.[1.0,0.55,0.10] else ifx i==7 || i%3==0 then [3]f32.[1.0,0.22,0.025] else ifx i%3==1 then [3]f32.[1.0,0.55,0.09] else [3]f32.[1.0,0.72,0.18]) else ifx r.kind==0 then [3]f32.[0.50,0.80,0.10] else [3]f32.[0.52,0.55,0.33];return r;
}

#test "glade composition retains every visible source tree" {
 for i:0..<CG_ITEMS {#assert cg_visible(cg_item(i));}
}
// Every authored tree now stays in front of the cliff or on its visible rim.
cg_visible :: (item:CgItem)->bool {return item.scale>0;}
#test "glade canopy normals remain unit length even near their center" {
 a:=cg_canopy_normal(0.001,0,0);b:=cg_canopy_normal(0,0,0);
 #assert a[0]==1 && a[1]==0 && a[2]==0;
 #assert b[0]==0 && b[1]==1 && b[2]==0;
}
cg_canopy_normal :: (x:f32,y:f32,z:f32)->[3]f32 {
 magnitude:=sqrt(x*x+y*y+z*z);if magnitude<0.000001 {return [3]f32.[0,1,0];}
 return [3]f32.[x/magnitude,y/magnitude,z/magnitude];
}

#test "glade reference places the near birch and right rock in the foreground" {
 tree:=cg_item(7);rock:=cg_item(20);#assert tree.z> -1 && tree.scale<0.3 && rock.z> -4 && rock.scale<0.3;
 #assert cg_path(cg_path_x(-30),-30)<0.001 && cg_height(-5,-32)>6;
}

#test "glade bare path forks toward the left foreground" {#assert cg_path(-6.5,-3.7)>0.95 && cg_path(-6.5,-10)<0.1;}

#test "glade hero cliff cap has a broad level crown and a supported base" {
 #assert cg_cliff_cap_y(0)==0 && abs(cg_cliff_cap_y(1.2)-1.8)<0.0001;
 #assert cg_cliff_cap_y(1.96)<1.85 && cg_cliff_cap_y(1.96)>cg_cliff_cap_y(1.2);
 #assert cg_cliff_cap_y(-0.5)== -0.75;
}
cg_cliff_cap_y :: (y:f32)->f32 {return ifx y<=1.2 then y*1.5 else 1.8+(y-1.2)*0.05;}

#test "glade reference wind traces stay in front of the hills and behind the figure" {
 a:=cg_wind_screen(0,0);b:=cg_wind_screen(0,1);p:=cg_reference_point(a[0],a[1],a[2]);
 #assert a[0]==0 && a[1]==770 && b[0]==1100 && p[2]<0 && p[1]>0;
}
cg_wind_screen :: (which:int,t:f32)->[3]f32 {
 points:=[3][4][3]f32.[
  [4][3]f32.[[3]f32.[0,770,4],[3]f32.[300,735,5],[3]f32.[700,700,7],[3]f32.[1100,650,10]],
  [4][3]f32.[[3]f32.[180,606,9],[3]f32.[400,625,10],[3]f32.[650,630,12],[3]f32.[850,620,14]],
  [4][3]f32.[[3]f32.[1640,606,10],[3]f32.[1750,615,10],[3]f32.[1840,628,9],[3]f32.[1930,620,9]]];
 r:[3]f32;a:=1-t;for k:0..<3 {r[k]=points[which][0][k]*a*a*a+points[which][1][k]*3*a*a*t+points[which][2][k]*3*a*t*t+points[which][3][k]*t*t*t;}return r;
}
cg_reference_point :: (x:f32,y:f32,z:f32)->[3]f32 {
 fy:=0.4/sqrt(9.77);fz:=-3.1/sqrt(9.77);up:=(518.4-y)/961.2*z;
 return [3]f32.[(x-960)/961.2*z,0.8+f32(fy)*z-f32(fz)*up,3.1+f32(fz)*z+f32(fy)*up];
}
