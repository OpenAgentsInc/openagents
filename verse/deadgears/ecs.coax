// Dead Gears' components on Aethyr's entities (aethyr/entity.coax), and its
// clock and per-system timing. It was a private entity store ported from
// aethyr-demo's src/ecs; the store is now entity.coax's EntityStore, and
// this file keeps only what Dead Gears adds to it.
//
// Entities are entity.coax's: a handle is a 20-bit slot and a 12-bit
// generation, and every entity has an EntityId. Spawns and despawns are
// commands that apply at the step's flush (ecs_flush, which ends in
// entity_flush): a spawned entity's slot is the rules' to fill at once,
// and it takes part from the next step; a despawned one stays visible
// until the flush, so a system may despawn what it is walking. A slot
// whose generation would wrap is retired, not reused. ecs_remove_later
// defers a component removal the same way.
//
// Components are bits in a per-slot mask, a column beside the store like
// every other component; their values live in the world's own columns.
// ecs_match says whether live slot i has every bit of `all` and no bit of
// `none`. Walking slots 0..<ecs_high in order is the ordered view (saves,
// replays, determinism) and the only one there is.
//
// Systems run in the order the world calls them; ecs_clock_frame says how
// many fixed 1/60 s steps a frame covers, on Aethyr's one clock
// (aethyr/loop.coax: a frame clamped to 0.1 s, at most 8 steps), and
// Stats keeps each system's last and smoothed milliseconds, read off the
// host's clock, for the stats overlay and the frame budget.
//
// All storage is the host's (or a test's): Entities and Stats are views,
// so passing them copies only the views and every write reaches the store.
//   coax/bin/coax test --library verse/deadgears/ecs.coax

#load "../../aethyr/loop.coax";
#load "../../aethyr/entity.coax";

ECS_NONE :: ENTITY_NONE;   // no entity

// Aethyr's store, and the component bits beside it.
Entities :: struct {
  s: EntityStore;     // who is alive (aethyr/entity.coax)
  mask: [] int;       // each slot's component bits
  dropping: [] int;   // component bits to clear at the next flush
}

ecs_index :: (e: int) -> int { return entity_slot(e); }
ecs_capacity :: (w: Entities) -> int { return entity_capacity(w.s); }
ecs_high :: (w: Entities) -> int { return entity_high(w.s); }
ecs_count :: (w: Entities) -> int { return entity_count(w.s); }

ecs_clear :: (w: Entities) {
  entity_clear(w.s);
  for i: 0..<w.mask.count { w.mask[i] = 0; w.dropping[i] = 0; }
}

ecs_alive :: (w: Entities, e: int) -> bool { return entity_alive(w.s, e); }

// e is live, or a spawn waiting for the flush: its slot is the rules' to fill.
ecs_owned :: (w: Entities, e: int) -> bool { return entity_alive(w.s, e) || entity_waiting(w.s, e); }

// The handle of the live entity in slot i, or ECS_NONE.
ecs_at :: (w: Entities, i: int) -> int { return entity_at(w.s, i); }

// A new entity with no components, live from the next flush, or ECS_NONE
// when every slot is in use (live, waiting or retired).
ecs_spawn :: (w: Entities) -> int {
  made := entity_spawn(w.s);
  if made.handle == ENTITY_NONE { return ECS_NONE; }
  i := entity_slot(made.handle);
  w.mask[i] = 0; w.dropping[i] = 0;
  return made.handle;
}

// Despawned at the next ecs_flush; until then it is alive and visible. A
// waiting spawn despawned is cancelled: it never joins.
ecs_despawn :: (w: Entities, e: int) { entity_despawn(w.s, e); }
ecs_pending_destroy :: (w: Entities, e: int) -> bool { return entity_doomed(w.s, e); }

// The step's end: clears the bits of what is despawning and what was
// dropped, in slot order, then entity_flush applies the despawns and the
// spawns.
ecs_flush :: (w: Entities) {
  for i: 0..<entity_high(w.s) {
    if w.s.doomed[i] { w.mask[i] = 0; w.dropping[i] = 0; }
    else if w.dropping[i] != 0 { w.mask[i] = w.mask[i] & bits_not(w.dropping[i]); w.dropping[i] = 0; }
  }
  entity_flush(w.s);
}

// x with every bit flipped (Coax has no unary ~ yet): -x - 1.
bits_not :: (x: int) -> int { return -x - 1; }

// A live entity's bits. A waiting spawn's bits are set but it has none yet
// as far as the rules see; ecs_waiting finds it.
ecs_has :: (w: Entities, e: int, bits: int) -> bool { return ecs_alive(w, e) && (w.mask[ecs_index(e)] & bits) == bits; }
ecs_add :: (w: Entities, e: int, bits: int) { if ecs_owned(w, e) { i := ecs_index(e); w.mask[i] = w.mask[i] | bits; w.dropping[i] = w.dropping[i] & bits_not(bits); } }
ecs_remove :: (w: Entities, e: int, bits: int) { if ecs_owned(w, e) { i := ecs_index(e); w.mask[i] = w.mask[i] & bits_not(bits); } }
ecs_remove_later :: (w: Entities, e: int, bits: int) { if ecs_alive(w, e) { i := ecs_index(e); w.dropping[i] = w.dropping[i] | bits; } }

// Slot i is live, has every bit of all and none of none.
ecs_match :: (w: Entities, i: int, all: int, none: int) -> bool {
  m := w.mask[i];
  return w.s.live[i] && (m & all) == all && (m & none) == 0;
}
// Slot i is a spawn waiting for the flush, with every bit of all.
ecs_waiting :: (w: Entities, i: int, all: int) -> bool { return w.s.born[i] && (w.mask[i] & all) == all; }

// How many live entities have every bit of all.
ecs_count_of :: (w: Entities, all: int) -> int {
  n := 0;
  for i: 0..<entity_high(w.s) { if ecs_match(w, i, all, 0) { n += 1; } }
  return n;
}

// The first (lowest slot) live entity with every bit of all, or ECS_NONE.
ecs_first :: (w: Entities, all: int) -> int {
  for i: 0..<entity_high(w.s) { if ecs_match(w, i, all, 0) { return entity_at(w.s, i); } }
  return ECS_NONE;
}

// ---- the clock: fixed steps

ECS_FIXED_DT :: 0.016666668;
ECS_STEP_NS :: 16666666;   // the step on the clock: 1/60 s, rounded down, so 0.05 s is three

Clock :: struct {
  dt: f32 = 0.016666668;   // the fixed step the systems are given
  frame_dt: f32;           // what this frame counted for, after the clamp
  max_frame_dt: f32 = 0.1; // a stalled frame covers no more than this
  max_steps: int = 8;      // nor more fixed steps than this
  acc: f64;                // time not yet stepped
  alpha: f32;              // how far into the next step the frame ends
  now: f64;                // seconds of frames
  fixed_now: f64;          // seconds of fixed steps
  frame: int;              // frames so far
  steps: int;              // this frame's fixed steps
  loop: FrameClock;        // the steps are this clock's (aethyr/loop.coax)
}

// The seconds a frame of dt counts for, at most max_frame_dt: none for a time that isn't one. What a
// realm moves the time outside its steps by (Dead Gears' walk, turn and animation).
ecs_counts :: (max_frame_dt: f32, dt: f32) -> f32 {
  c: FrameClock;
  c.max_frame_ns = loop_ns(f64(max_frame_dt));
  return f32(loop_counts(c, f64(dt)));
}

// The clock after a frame of frame_dt seconds; its steps is how many fixed
// steps the world runs this frame. The clamp and the cap are the Clock's own,
// handed to the loop each frame.
ecs_clock_frame :: (c: Clock, frame_dt: f32) -> Clock {
  next := c;
  l := c.loop;
  l.step_ns = ECS_STEP_NS;
  l.max_frame_ns = loop_ns(f64(c.max_frame_dt));
  l.max_steps = c.max_steps;
  l = loop_accept(l, f64(frame_dt));
  next.steps = loop_due(l);
  l = loop_ran(l);
  next.loop = l;
  next.frame_dt = f32(loop_counted(l));
  next.now = c.now + loop_counted(l);
  next.frame = c.frame + 1;
  next.fixed_now = f64(l.ticks) * f64(c.dt);
  next.acc = f64(l.carry_ns) / f64(LOOP_SECOND);
  next.alpha = loop_alpha(l);
  return next;
}

// ---- systems and their timing

ECS_PRE :: 0;     // input, once a frame
ECS_FIXED :: 1;   // the rules, every fixed step
ECS_UPDATE :: 2;  // once a frame
ECS_POST :: 3;
ECS_RENDER :: 4;

// One element per system, in the order the world runs them. n[0] is how
// many there are.
Stats :: struct {
  name: [] string;
  phase: [] int;
  last: [] f64;   // ms, the last frame (every fixed step of it summed)
  mean: [] f64;   // ms, smoothed
  runs: [] int;   // calls so far
  n: [] int;
}

ecs_system :: (s: Stats, name: string, phase: int) -> int {
  id := s.n[0];
  if id >= s.name.count { return -1; }
  s.name[id] = name; s.phase[id] = phase; s.last[id] = 0; s.mean[id] = 0; s.runs[id] = 0;
  s.n[0] += 1;
  return id;
}

// A new frame: every system's frame time starts again at zero.
ecs_stats_frame :: (s: Stats) { for i: 0..<s.n[0] { s.last[i] = 0; } }

// A system ran for ms milliseconds.
ecs_stats_add :: (s: Stats, id: int, ms: f64) {
  if id < 0 || id >= s.n[0] { return; }
  s.last[id] += ms;
  s.runs[id] += 1;
}

// The frame is over: fold each system's frame into its smoothed mean.
ecs_stats_end :: (s: Stats) {
  for i: 0..<s.n[0] {
    if s.runs[i] <= 1 { s.mean[i] = s.last[i]; }
    else { s.mean[i] = s.mean[i] * 0.9 + s.last[i] * 0.1; }
  }
}

ecs_stats_total :: (s: Stats) -> f64 {
  t: f64 = 0;
  for i: 0..<s.n[0] { t += s.last[i]; }
  return t;
}

ecs_stats_find :: (s: Stats, name: string) -> int {
  for i: 0..<s.n[0] { if s.name[i] == name { return i; } }
  return -1;
}

// ---- checks
//
// These were the private store's checks. The store is entity.coax's now, so
// each keeps its case and states it under entity.coax's next-step rule: an
// entity spawned outside a step joins at the flush that follows, which a
// check calls where the old store made it live at once. Each changed
// expectation says why beside it.

TEST_CAP :: 64;
TestStore :: struct {
  gen: [TEST_CAP] int; live: [TEST_CAP] bool; born: [TEST_CAP] bool; doomed: [TEST_CAP] bool;
  ids: [TEST_CAP] int; free: [TEST_CAP] int; spawns: [TEST_CAP] int; n: [ENTITY_COUNTERS] int;
  mask: [TEST_CAP] int; dropping: [TEST_CAP] int;
  hp: [TEST_CAP] f32;
}
test_world :: (s: [] TestStore) -> Entities {
  store := EntityStore.{gen = s[0].gen[..], live = s[0].live[..], born = s[0].born[..], doomed = s[0].doomed[..],
                        ids = s[0].ids[..], free = s[0].free[..], spawns = s[0].spawns[..], n = s[0].n[..]};
  return Entities.{s = store, mask = s[0].mask[..], dropping = s[0].dropping[..]};
}
T_POS :: 1; T_VEL :: 2; T_TAG :: 4; T_HP :: 8;

#test "entities and generations: a stale handle never reaches a slot's next owner" {
  st: [1] TestStore; w := test_world(st[..]);
  a := ecs_spawn(w); b := ecs_spawn(w);
  // next-step rule: spawned, not yet live; the flush makes them live
  #assert a != b && !ecs_alive(w, a) && ecs_owned(w, a) && ecs_count(w) == 0;
  ecs_flush(w);
  #assert ecs_alive(w, a) && ecs_alive(w, b) && ecs_count(w) == 2;
  #assert ecs_index(a) == 0 && ecs_index(b) == 1 && entity_generation(a) == 0;
  ecs_add(w, a, T_POS);
  // was ecs_destroy_now: a despawn takes effect at the flush
  ecs_despawn(w, a); ecs_flush(w);
  #assert !ecs_alive(w, a) && !ecs_owned(w, a) && ecs_count(w) == 1;
  c := ecs_spawn(w);
  #assert ecs_index(c) == ecs_index(a) && entity_generation(c) == entity_generation(a) + 1;
  ecs_add(w, c, T_POS);
  ecs_flush(w);   // next-step rule: c has its bits once it is live
  #assert ecs_has(w, c, T_POS) && !ecs_has(w, a, T_POS);
  #assert !ecs_alive(w, ECS_NONE) && !ecs_owned(w, ECS_NONE);
  ecs_despawn(w, a);
  ecs_flush(w);
  #assert ecs_alive(w, c);
}

#test "a slot whose generation would wrap is retired, so a stale handle is never told apart by a wrapped one" {
  st: [1] TestStore; w := test_world(st[..]);
  e := ecs_spawn(w); ecs_flush(w);
  for k: 0..<4096 { ecs_despawn(w, e); ecs_flush(w); e = ecs_spawn(w); ecs_flush(w); }
  // The old store wrapped slot 0's generation back to 0 here (index 0, generation 0, high 1), so
  // the first handle named the slot's 4097th owner. entity.coax retires the slot at its last
  // generation instead: the 4096th despawn retires slot 0 and the next owner takes slot 1.
  #assert ecs_index(e) == 1 && entity_generation(e) == 0 && ecs_alive(w, e) && ecs_high(w) == 2;
  #assert !ecs_alive(w, entity_handle(0, 0)) && !ecs_alive(w, entity_handle(0, ENTITY_GEN_MASK)) && w.s.n[ENTITY_RETIRED] == 1;
}

#test "full: spawn says so instead of overwriting" {
  st: [1] TestStore; w := test_world(st[..]);
  for k: 0..<TEST_CAP { #assert ecs_spawn(w) != ECS_NONE; }
  // a waiting spawn holds its slot, so the store is full before the flush
  #assert ecs_spawn(w) == ECS_NONE && ecs_count(w) == 0 && w.s.n[ENTITY_REFUSED] == 1;
  ecs_flush(w);
  #assert ecs_spawn(w) == ECS_NONE && ecs_count(w) == TEST_CAP;
}

#test "a destroy while walking waits for the flush" {
  st: [1] TestStore; w := test_world(st[..]);
  es: [10] int;
  for k: 0..<10 { es[k] = ecs_spawn(w); ecs_add(w, es[k], T_HP); st[0].hp[ecs_index(es[k])] = f32(k); }
  ecs_flush(w);   // next-step rule: they join at the flush
  visited := 0;
  for i: 0..<ecs_high(w) {
    if !ecs_match(w, i, T_HP, 0) { continue; }
    visited += 1;
    if int(st[0].hp[i]) % 2 == 1 { ecs_despawn(w, ecs_at(w, i)); }
  }
  #assert visited == 10 && ecs_count_of(w, T_HP) == 10 && ecs_pending_destroy(w, es[1]) && !ecs_pending_destroy(w, es[0]);
  ecs_flush(w);
  #assert ecs_count_of(w, T_HP) == 5 && ecs_count(w) == 5 && st[0].mask[1] == 0;
  for i: 0..<ecs_high(w) { if ecs_match(w, i, T_HP, 0) { #assert int(st[0].hp[i]) % 2 == 0; } }
}

#test "views: every bit of all and none of none, in slot order" {
  st: [1] TestStore; w := test_world(st[..]);
  both := 0; only := 0; untagged := 0;
  for k: 0..<60 {
    e := ecs_spawn(w);
    ecs_add(w, e, T_POS);
    if k % 3 == 0 { ecs_add(w, e, T_VEL); both += 1; if k % 5 != 0 { untagged += 1; } } else { only += 1; }
    if k % 5 == 0 { ecs_add(w, e, T_TAG); }
  }
  #assert ecs_count_of(w, T_POS) == 0 && ecs_first(w, T_POS) == ECS_NONE;   // next-step rule: none live before the flush
  ecs_flush(w);
  seen := 0; noVel := 0; plain := 0; last := -1; ordered := true;
  for i: 0..<ecs_high(w) {
    if ecs_match(w, i, T_POS | T_VEL, 0) { seen += 1; if i <= last { ordered = false; } last = i; }
    if ecs_match(w, i, T_POS, T_VEL) { noVel += 1; }
    if ecs_match(w, i, T_POS | T_VEL, T_TAG) { plain += 1; }
  }
  #assert seen == both && noVel == only && plain == untagged && ordered;
  #assert ecs_count_of(w, T_VEL) == both && ecs_count_of(w, T_POS) == 60;
  #assert ecs_count_of(w, T_HP) == 0 && ecs_first(w, T_HP) == ECS_NONE && ecs_first(w, T_VEL) == entity_handle(0, 0);
}

#test "a removal later waits for the flush; adding again cancels it" {
  st: [1] TestStore; w := test_world(st[..]);
  e := ecs_spawn(w); f := ecs_spawn(w);
  ecs_add(w, e, T_POS | T_VEL); ecs_add(w, f, T_POS | T_VEL);
  ecs_remove_later(w, e, T_VEL);   // a waiting spawn has nothing to drop later
  #assert st[0].dropping[0] == 0;
  ecs_flush(w);                    // next-step rule: they join here
  ecs_remove_later(w, e, T_VEL); ecs_remove_later(w, f, T_VEL);
  ecs_add(w, f, T_VEL);
  #assert ecs_has(w, e, T_VEL);
  ecs_flush(w);
  #assert !ecs_has(w, e, T_VEL) && ecs_has(w, e, T_POS) && ecs_has(w, f, T_VEL) && st[0].dropping[0] == 0;
  ecs_remove_later(w, f, T_POS);   // bit 1 alone
  ecs_flush(w);
  #assert !ecs_has(w, f, T_POS) && ecs_has(w, f, T_VEL) && st[0].dropping[1] == 0;
  ecs_add(w, f, T_POS);
  ecs_remove(w, f, T_POS);
  #assert !ecs_has(w, f, T_POS) && ecs_has(w, f, T_VEL);
}

#test "adding while walking: the new entities are not visited in that pass" {
  st: [1] TestStore; w := test_world(st[..]);
  for k: 0..<8 { ecs_add(w, ecs_spawn(w), T_HP); }
  ecs_flush(w);   // next-step rule: the first eight join here
  visited := 0;
  high := ecs_high(w);
  for i: 0..<high { if ecs_match(w, i, T_HP, 0) { visited += 1; ecs_add(w, ecs_spawn(w), T_HP); } }
  // The old store counted 16 here, at once. Under the next-step rule the eight new ones wait,
  // so a later system in the same step doesn't see them either; they join at the flush.
  #assert visited == 8 && ecs_count_of(w, T_HP) == 8;
  waiting := 0;
  for i: 0..<ecs_high(w) { if ecs_waiting(w, i, T_HP) { waiting += 1; } }
  #assert waiting == 8;
  ecs_flush(w);
  #assert ecs_count_of(w, T_HP) == 16;
  for i: 0..<ecs_high(w) { #assert !ecs_waiting(w, i, 0); }
}

#test "a spawn's slot is filled at once and the entity joins at the flush; a despawned slot's next owner starts bare" {
  st: [1] TestStore; w := test_world(st[..]);
  e := ecs_spawn(w);
  ecs_add(w, e, T_POS | T_HP);
  ecs_remove(w, e, T_POS);
  #assert ecs_owned(w, e) && !ecs_alive(w, e) && !ecs_has(w, e, T_HP) && st[0].mask[0] == T_HP;
  #assert ecs_waiting(w, 0, T_HP) && !ecs_waiting(w, 0, T_POS) && !ecs_match(w, 0, T_HP, 0) && ecs_first(w, T_HP) == ECS_NONE;
  ecs_flush(w);
  #assert ecs_has(w, e, T_HP) && ecs_first(w, T_HP) == e && !ecs_waiting(w, 0, T_HP) && entity_id(w.s, e) == 1;
  ecs_remove_later(w, e, T_TAG);
  ecs_despawn(w, e);
  #assert ecs_has(w, e, T_HP) && ecs_pending_destroy(w, e);   // visible until the flush
  ecs_flush(w);
  #assert st[0].mask[0] == 0 && st[0].dropping[0] == 0 && !ecs_owned(w, e);
  ecs_add(w, e, T_TAG); ecs_remove(w, e, T_TAG);              // a stale handle writes nothing
  st[0].mask[0] = T_VEL; st[0].dropping[0] = T_VEL;           // what a slot's memory might hold
  f := ecs_spawn(w);
  #assert ecs_index(f) == 0 && st[0].mask[0] == 0 && st[0].dropping[0] == 0 && ecs_owned(w, f) && !ecs_owned(w, e);
  #assert !ecs_owned(w, entity_handle(1, 0)) && ecs_capacity(w) == TEST_CAP;
  ecs_flush(w);
  #assert entity_id(w.s, f) == 2 && !ecs_has(w, f, T_VEL);
  st[0].mask[0] = T_HP; st[0].dropping[0] = T_HP; st[0].mask[TEST_CAP - 1] = T_HP; st[0].dropping[TEST_CAP - 1] = T_TAG;
  ecs_clear(w);
  #assert ecs_count(w) == 0 && ecs_high(w) == 0 && st[0].mask[0] == 0 && st[0].dropping[0] == 0;
  #assert st[0].mask[TEST_CAP - 1] == 0 && st[0].dropping[TEST_CAP - 1] == 0;
}

#test "a waiting spawn despawned is cancelled: it never joins, and its slot's next owner starts bare" {
  st: [1] TestStore; w := test_world(st[..]);
  keep := ecs_spawn(w); ecs_add(w, keep, T_HP);
  gone := ecs_spawn(w); ecs_add(w, gone, T_HP | T_POS);
  ecs_despawn(w, gone);
  #assert ecs_pending_destroy(w, gone) && ecs_owned(w, gone) && ecs_waiting(w, 1, T_HP) && !ecs_pending_destroy(w, keep);
  ecs_flush(w);
  #assert ecs_alive(w, keep) && !ecs_alive(w, gone) && !ecs_owned(w, gone) && ecs_count(w) == 1 && ecs_count_of(w, T_HP) == 1;
  #assert st[0].mask[1] == 0 && st[0].dropping[1] == 0 && st[0].mask[0] == T_HP;
  next := ecs_spawn(w);
  #assert ecs_index(next) == 1 && entity_generation(next) == 1 && st[0].mask[1] == 0;
}

#test "the clock: three fixed steps in 0.05 s, half-steps add up, a stall is capped" {
  c: Clock;
  c = ecs_clock_frame(c, 0.05);
  #assert c.steps == 3 && c.frame == 1;
  c = ecs_clock_frame(c, 1.0 / 120);
  n := c.steps;
  c = ecs_clock_frame(c, 1.0 / 120);
  #assert n + c.steps == 1;
  c.max_frame_dt = 0.05;
  c = ecs_clock_frame(c, 100);
  #assert c.steps == 3 && c.frame == 4 && c.frame_dt == 0.05;
  c = ecs_clock_frame(c, -1);
  #assert c.steps == 0 && c.alpha >= 0 && c.alpha < 1;
}

#test "the clock is Aethyr's: a stall runs six steps of 0.1 s and the next frame is ordinary" {
  c: Clock;
  c = ecs_clock_frame(c, 3.0);
  #assert c.steps == 6 && c.frame_dt == 0.1 && c.loop.overlong == 1 && c.loop.stalls == 0;
  #assert c.loop.step_ns == ECS_STEP_NS && c.loop.ticks == 6 && c.fixed_now == 6.0 * f64(c.dt);
  #assert c.loop.carry_ns == 5 && c.acc == 0.000000005 && c.alpha < 0.000001 && abs(c.now - 0.1) < 0.0000001;
  c = ecs_clock_frame(c, 1.0 / 30);
  #assert c.steps == 2 && c.loop.ticks == 8 && c.frame == 2 && c.loop.ran == 2;
  c = ecs_clock_frame(c, 1.0 / 120);
  #assert c.steps == 0 && abs(c.alpha - 0.5) < 0.00001;
  c.max_steps = 2;
  c = ecs_clock_frame(c, 0.1);
  #assert c.steps == 2 && c.loop.stalls == 1 && c.frame_dt < 0.05 && c.loop.max_steps == 2;
  // a declared clamp below zero is no clamp: the loop's own (0.25 s) holds
  d: Clock; d.max_frame_dt = -1; d.max_steps = 20;
  d = ecs_clock_frame(d, 0.2);
  #assert d.steps == 12 && d.loop.max_frame_ns == LOOP_MAX_FRAME_NS && d.loop.overlong == 0;
  #assert ecs_counts(0.05, 3.0) == 0.05 && ecs_counts(0.05, 0.02) == 0.02 && ecs_counts(0.05, -1.0) == 0;
  #assert ecs_counts(0.05, 0.0 / 0.0) == 0 && ecs_counts(0.1, 3.0) == 0.1 && ecs_counts(0.05, 0.05) == 0.05;
}

#forall "the clock never runs more steps than the cap, nor loses time under it" k: 0..<40 {
  c: Clock;
  total := 0;
  for f: 0..<20 { c = ecs_clock_frame(c, f32(k) * 0.004); total += c.steps; #assert c.steps <= c.max_steps; }
  covered := f64(total) * f64(c.dt) + c.acc;
  #assert abs(covered - c.now) < 0.001 || k * 4 > 100;
}

#test "per-system timing: each system's frame, summed over steps, and smoothed" {
  names: [4] string; phase: [4] int; last: [4] f64; mean: [4] f64; runs: [4] int; n: [1] int;
  s := Stats.{name = names[..], phase = phase[..], last = last[..], mean = mean[..], runs = runs[..], n = n[..]};
  for i: 0..<4 { phase[i] = 9; last[i] = 9; mean[i] = 9; runs[i] = 9; }   // storage used before
  a := ecs_system(s, "dg.clock", ECS_FIXED); b := ecs_system(s, "dg.mutants", ECS_FIXED);
  #assert a == 0 && b == 1 && ecs_stats_find(s, "dg.mutants") == 1 && ecs_stats_find(s, "dg.clock") == 0 && ecs_stats_find(s, "none") == -1;
  #assert phase[0] == ECS_FIXED && last[1] == 0 && mean[1] == 0 && runs[1] == 0;
  ecs_stats_frame(s);
  ecs_stats_add(s, a, 0.25); ecs_stats_add(s, a, 0.25); ecs_stats_add(s, b, 1);
  ecs_stats_add(s, 2, 5); ecs_stats_add(s, -1, 5);   // no such system: nothing
  ecs_stats_end(s);
  #assert s.last[a] == 0.5 && abs(s.mean[a] - 0.05) < 0.000001 && s.mean[b] == 1 && ecs_stats_total(s) == 1.5 && last[2] == 9 && runs[2] == 9;
  ecs_stats_frame(s);
  ecs_stats_add(s, b, 2);
  ecs_stats_end(s);
  #assert abs(s.mean[b] - 1.1) < 0.000001 && s.last[a] == 0;
  #assert ecs_system(s, "c", ECS_UPDATE) == 2 && ecs_system(s, "d", ECS_UPDATE) == 3 && ecs_system(s, "e", ECS_UPDATE) == -1;
}
