// A drum arena (docs/verse/space.md, Orbit League's ol-drum-arena): the
// inside of a cylinder as the drivable surface, the floor curving up into
// the walls and over into the ceiling, closed by two flat end walls with a
// goal mouth in each. Everything here is in the drum's own rotating frame:
// its spin is a verse/gravity.coax drum field, so "down" is away from the
// axis wherever you are, and a car that drives up the curve is still on the
// floor when it is upside down at the top.
//
// The curve is given to the engine as planes, the way verse/vehicle.coax and
// verse/contact.coax already take a flat arena: drum_planes(d, pos) is the
// tangent plane under pos (the rim's nearest point) and the two end walls.
// For a car or a ball a few metres across inside a drum tens of metres
// round, the tangent plane is within millimetres of the curve under it.
//   coax/bin/coax test --library verse/drum.coax --steps 2000000000

#load "vehicle.coax";
#load "gravity.coax";

Drum :: struct {
  centre: D3;     // a point on the axis, midway between the ends
  axis: D3;       // a unit vector, the drum's length
  radius: f64;    // metres, axis to rim
  half: f64;      // half its length: the end walls are at +-half along axis
}

// A drum with its axis along z, sitting on the plane y = 0 (the rim's
// lowest line), radius r and length 2 half.
drum_on_floor :: (r: f64, half: f64) -> Drum { return Drum.{centre = d3(0.0, r, 0.0), axis = D3_Z, radius = r, half = half}; }

// The drum's spin field: g at the rim.
drum_field :: (d: Drum, g: f64) -> GravityField { return gravity_drum(d.centre, d.axis, drum_spin_for(d.radius, g)); }

// pos's offset from the axis, perpendicular to it, and how far along it.
drum_out :: (d: Drum, pos: D3) -> D3 {
  r := d3_sub(pos, d.centre);
  return d3_sub(r, d3_scale(d.axis, d3_dot(r, d.axis)));
}
drum_along :: (d: Drum, pos: D3) -> f64 { return d3_dot(d3_sub(pos, d.centre), d.axis); }

// The surface's inward normal (up, for whatever stands on the rim) under pos.
// On the axis itself every direction is as good; it picks the floor's.
drum_up :: (d: Drum, pos: D3) -> D3 {
  o := drum_out(d, pos);
  if d3_len(o) < 0.000001 { return d3_unit_or(d3_neg(d3_sub(d3(d.centre.x, 0.0, d.centre.z), d.centre)), D3_Y); }
  return d3_neg(d3_unit(o));
}

// The rim's tangent plane under pos, facing in.
drum_rim_plane :: (d: Drum, pos: D3) -> Plane {
  n := drum_up(d, pos);
  on := d3_add(d.centre, d3_add(d3_scale(d.axis, drum_along(d, pos)), d3_scale(n, -d.radius)));
  return plane_through(n, on);
}

// The planes a body at pos meets: the rim under it and both end walls.
drum_planes :: (d: Drum, pos: D3) -> [3] Plane {
  p: [3] Plane;
  p[0] = drum_rim_plane(d, pos);
  p[1] = plane_through(d.axis, d3_sub(d.centre, d3_scale(d.axis, d.half)));
  p[2] = plane_through(d3_neg(d.axis), d3_add(d.centre, d3_scale(d.axis, d.half)));
  return p;
}

// How far pos is inside the rim (negative: through it).
drum_clearance :: (d: Drum, pos: D3) -> f64 { return d.radius - d3_len(drum_out(d, pos)); }

// A sphere against the rim: the contact, if it touches.
drum_sphere :: (d: Drum, c: D3, r: f64) -> Contact {
  return contact_sphere_plane(c, r, drum_rim_plane(d, c));
}

// The angle round the axis, from the floor's lowest line (0) through the
// +x wall (pi/2) to the ceiling (pi): for a drum along z on the floor.
drum_angle :: (d: Drum, pos: D3) -> f64 {
  o := drum_out(d, pos);
  y := o.x; x := -o.y;
  if x > 0.0 { return atan_d(y / x); }
  if x < 0.0 { return ifx y >= 0.0 then atan_d(y / x) + PI_D else atan_d(y / x) - PI_D; }
  return ifx y >= 0.0 then PI_D / 2.0 else -PI_D / 2.0;
}

// One car step in a drum: the vehicle against the planes under it, with the
// drum's pull (and Coriolis) where it is.
drum_drive_step :: (store: [] RigidBody, i: int, d: Drum, f: GravityField, spec: VehicleSpec, st: VehicleState, input: VehicleInput, dt: f64) -> VehicleState {
  pl := drum_planes(d, store[i].pos);
  out := vehicle_step(store[i], spec, st, input, pl[..], gravity_on(f, store[i].pos, store[i].vel), dt);
  store[i] = out.body;
  return out.state;
}

// Checks.

#test "the rim plane under any point is tangent to the drum and faces the axis" {
  d := drum_on_floor(20.0, 40.0);
  for k: 0..<16 {
    a := cast(f64) k * TAU_D / 16.0;
    p := d3(d.centre.x + 12.0 * sin(a), d.centre.y - 12.0 * cos(a), 7.0);
    pl := drum_rim_plane(d, p);
    // the rim straight out from p lies on the plane, and p is 8 m above it
    rim := d3(d.centre.x + 20.0 * sin(a), d.centre.y - 20.0 * cos(a), 7.0);
    #assert near_d(plane_distance(pl, rim), 0.0, 0.000001) && near_d(plane_distance(pl, p), 8.0, 0.000001);
    #assert near_d(d3_dot(pl.n, d3_unit(d3_sub(d3(d.centre.x, d.centre.y, 7.0), rim))), 1.0, 0.000001);
  }
  // the floor's lowest line is y = 0, facing up
  f := drum_rim_plane(d, d3(0.0, 1.0, 0.0));
  #assert near_d(f.n.y, 1.0, 0.000001) && near_d(f.d, 0.0, 0.000001);
  #assert near_d(drum_angle(d, d3(0.0, 1.0, 0.0)), 0.0, 0.000001) && near_d(drum_angle(d, d3(19.0, 20.0, 0.0)), PI_D / 2.0, 0.000001);
  #assert near_d(abs(drum_angle(d, d3(0.0, 39.0, 0.0))), PI_D, 0.000001);
}

#test "the ball thrown at the curve bounces back off it, inside the drum, wherever it hits" {
  d := drum_on_floor(20.0, 40.0);
  f := drum_field(d, G_EARTH);
  for k: 0..<8 {
    a := cast(f64) k * TAU_D / 8.0 + 0.3;
    out := d3(sin(a), -cos(a), 0.0);
    store: [1] RigidBody;
    store[0] = rigid_body(150.0, d3(118.0, 118.0, 118.0), d3_add(d.centre, d3_scale(out, 14.0)), DQ.{});
    store[0].vel = d3_add(d3_scale(out, 25.0), d3(0.0, 0.0, 3.0));
    w := rigid_world(1.0 / 120.0, store[..]);
    bounced := false; inside := true;
    for i: 0..<120 {
      w = gravity_step(w, f);
      ct := drum_sphere(d, store[0].pos, 1.4);
      if ct.hit { store[0] = contact_resolve_static(store[0], ct, 0.65, 0.35); }
      if d3_dot(store[0].vel, out) < 0.0 { bounced = true; }
      if drum_clearance(d, store[0].pos) < 1.4 - 0.05 { inside = false; }
    }
    #assert bounced && inside;
  }
}

#test "a car drives from the floor up the curve, over the ceiling and back down, wheels on the rim all the way" {
  d := drum_on_floor(20.0, 40.0);
  f := drum_field(d, G_EARTH);
  spec := vehicle_roadster();
  store: [1] RigidBody;
  // on the floor facing +x: round the drum, not along it
  store[0] = vehicle_body(spec, 1000.0, d3(0.0, 0.95, 0.0), dq_y(PI_D / 2.0));
  w := rigid_world(1.0 / 120.0, store[..]);
  st := VehicleState.{};
  for i: 0..<120 {
    st = drum_drive_step(store[..], 0, d, f, spec, st, VehicleInput.{}, w.dt);
    w = rigid_step(w, D3_ZERO);
    pl := drum_planes(d, store[0].pos);
    store[0] = vehicle_collide(store[0], spec, pl[..], 0.1, 0.6);
  }
  #assert st.wheels == 4;
  top := 0.0; off := 0; travelled := 0.0; last := drum_angle(d, store[0].pos);
  for i: 0..<cast(int) (12.0 * 120.0) {
    st = drum_drive_step(store[..], 0, d, f, spec, st, VehicleInput.{throttle = 1.0}, w.dt);
    w = rigid_step(w, D3_ZERO);
    pl := drum_planes(d, store[0].pos);
    store[0] = vehicle_collide(store[0], spec, pl[..], 0.1, 0.6);
    a := drum_angle(d, store[0].pos);
    step := a - last;
    while step > PI_D { step -= TAU_D; }
    while step < -PI_D { step += TAU_D; }
    travelled += abs(step); last = a;
    if abs(a) > top { top = abs(a); }
    if st.wheels < 2 { off += 1; }
    // its wheels toward the rim: the chassis's up is the drum's up
    #assert d3_dot(rigid_axis(store[0], D3_Y), drum_up(d, store[0].pos)) > 0.9;
  }
  // over the top (angle pi), round at least once, never off its wheels for long
  #assert top > PI_D * 0.95 && travelled > TAU_D && off < 12;
  #assert drum_clearance(d, store[0].pos) > 0.0 && abs(drum_along(d, store[0].pos)) < 1.0;
}

#test "the end walls stop a ball and a car along the axis" {
  d := drum_on_floor(20.0, 40.0);
  pl := drum_planes(d, d3(0.0, 1.0, 39.5));
  ct := contact_sphere_plane(d3(0.0, 1.4, 39.0), 1.4, pl[2]);
  #assert ct.hit && near_d(ct.normal.z, -1.0, 0.000001);
  ct = contact_sphere_plane(d3(0.0, 1.4, -39.0), 1.4, pl[1]);
  #assert ct.hit && near_d(ct.normal.z, 1.0, 0.000001);
}
