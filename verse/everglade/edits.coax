// Everglade's edits (eg-edit): what an admin adds to the designed city in
// edit mode, and the checks that hold it to the plan. The plan
// (plan.coax) stays the city: its walls, buildings, streets, gates and
// people don't move, so the quests and the characters can rely on them.
// An admin places the kit's things on it (EG_EDIT_ITEMS), moves, turns,
// resizes and removes them; the realm publishes the list to the server as
// Everglade's world (POST /api/playtest/world/everglade, an admin's only)
// and every visitor's page lays it over the plan.
//
// An admin may also take away the city's people and cats (people.coax):
// the list keeps which are gone, and every page leaves them out.
//
// The list as text (eg_edits_text, eg_edits_read), a line each:
//   eg-edit 1
//   t KIND X Z YAW SIZE GROUP   an item: X and Z in centimetres, YAW in degrees, SIZE in percent,
//                               GROUP the row it was placed in (0 or left out: on its own)
//   p SPOT                      the person at plan.coax EG_SPOT SPOT is taken away
//
// A thing may not stand in a wall, a building, a prop, the woods or past
// the world's edge (eg_edit_fault: the realm refuses the place or the move).
// It may stand on a street. A removal takes the nearest thing or person, a
// named person, or a whole group ("these crates": eg_remove_pick).
//   coax/bin/coax test --library verse/everglade/edits.coax --steps 3000000000

#load "people.coax";

EG_EDIT_ITEMS :: 5;
EG_EDIT_MAX :: 48;      // things an admin may add
EG_EDIT_LABEL :: [5] string.["CRATE", "BARREL", "BENCH", "FENCE", "STALL"];
EG_EDIT_LABELS :: [5] string.["CRATES", "BARRELS", "BENCHES", "FENCES", "STALLS"];   // more than one
// Each one's footprint at size 1 from the pack's bounds (verse/packs/everglade.json): half its
// width across (its local x), half its depth (its local z), and its height, metres.
EG_EDIT_HALF :: [15] f32.[0.42, 0.45, 0.93,   0.35, 0.35, 0.9,   1.39, 0.27, 0.53,   1.03, 0.06, 0.81,   0.92, 0.47, 2.63];
EG_EDIT_SIZE_MIN :: 0.5; EG_EDIT_SIZE_MAX :: 3.0;
EG_EDIT_HEAD :: "eg-edit 1\n";

EgThing :: struct { kind: int; x: f32; z: f32; yaw: f32; size: f32; group: int; }
EgEdits :: struct { n: int; things: [EG_EDIT_MAX] EgThing; gone: u32; }   // gone: a bit per EG_SPOT

// Why a thing can't stand where it is.
EG_FAULT_NONE :: 0; EG_FAULT_EDGE :: 1; EG_FAULT_WOODS :: 2; EG_FAULT_SOLID :: 3; EG_FAULT_THING :: 4;
EG_FAULT_WORD :: [5] string.["", "PAST THE EDGE OF THE WORLD", "IN THE WOODS", "IN SOMETHING OF THE CITY", "IN ANOTHER THING"];

eg_edit_kind :: (k: int) -> int { if k < 0 { return 0; } if k >= EG_EDIT_ITEMS { return EG_EDIT_ITEMS - 1; } return k; }

// A thing's footprint on the ground: its box turned by its yaw, as the box round it.
eg_edit_box :: (t: EgThing, out: [] f32) {
  k := eg_edit_kind(t.kind) * 3;
  hx := EG_EDIT_HALF[k] * t.size; hz := EG_EDIT_HALF[k + 1] * t.size;
  c := abs(cos(t.yaw)); s := abs(sin(t.yaw));
  ex := c * hx + s * hz; ez := s * hx + c * hz;
  out[0] = t.x - ex; out[1] = t.z - ez; out[2] = t.x + ex; out[3] = t.z + ez;
  out[4] = EG_EDIT_HALF[k + 2] * t.size;
}

// Whether thing i of the list may stand where it is.
eg_edit_fault :: (e: EgEdits, i: int) -> int {
  if i < 0 || i >= e.n { return EG_FAULT_NONE; }
  t := e.things[i];
  box: [EG_BOX] f32;
  eg_edit_box(t, box[..]);
  b := f32(EG_BOUND) - 1;
  if box[0] < -b || box[2] > b || box[1] < -b || box[3] > b { return EG_FAULT_EDGE; }
  if everglade_in_woods(t.x, t.z) || everglade_in_woods(box[0], box[1]) || everglade_in_woods(box[2], box[3]) ||
     everglade_in_woods(box[0], box[3]) || everglade_in_woods(box[2], box[1]) { return EG_FAULT_WOODS; }
  solids: [EG_SOLIDS * EG_BOX] f32;
  n := everglade_solids(solids[..]);
  for s: 0..<n - 4 { if boxes_gap(box[..], 0, solids[..], s) <= 0.05 { return EG_FAULT_SOLID; } }
  // and not on the bridge's deck, where the trail crosses the river
  br := EG_BRIDGE;
  if boxes_gap(box[..], 0, br[..], 0) <= 0.05 { return EG_FAULT_SOLID; }
  other: [EG_BOX] f32;
  for j: 0..<e.n {
    if j == i { continue; }
    eg_edit_box(e.things[j], other[..]);
    if boxes_gap(box[..], 0, other[..], 0) <= 0.02 { return EG_FAULT_THING; }
  }
  return EG_FAULT_NONE;
}

// Whether thing i stands on a street or a trail (allowed, but the realm says so).
eg_edit_on_street :: (e: EgEdits, i: int) -> bool {
  if i < 0 || i >= e.n { return false; }
  box: [EG_BOX] f32;
  eg_edit_box(e.things[i], box[..]);
  for l: 0..<EG_LINKS {
    if link_box_gap(EG_LINK_AB[l * 2], EG_LINK_AB[l * 2 + 1], box[..], 0) < f32(EG_PATH_HALF) { return true; }
  }
  return false;
}

// ---- what a removal takes: placed things and the city's people

// Whether spot i's person (or cat) is taken away.
eg_gone :: (e: EgEdits, i: int) -> bool { return i >= 0 && i < EG_SPOTS && (e.gone >> cast(u32) i) & 1 != 0; }

// What a removal may name: one of the kit's things (EG_EDIT_ITEMS), a person, a cat, or anything (-1).
EG_PICK_ANY :: -1; EG_PICK_PERSON :: EG_EDIT_ITEMS; EG_PICK_CAT :: EG_EDIT_ITEMS + 1;
EG_REMOVE_NEAR :: 8.0;     // metres from you a removal reaches
EgTake :: struct { things: u64; people: u32; n_things: int; n_people: int; }

eg_take_thing :: (e: EgEdits, i: int, kind: int) -> bool {
  return kind == EG_PICK_ANY || (kind >= 0 && kind < EG_EDIT_ITEMS && eg_edit_kind(e.things[i].kind) == kind);
}
eg_take_person :: (e: EgEdits, i: int, kind: int) -> bool {
  if eg_gone(e, i) { return false; }
  return kind == EG_PICK_ANY || (kind == EG_PICK_PERSON && !EG_SPOT_CAT[i]) || (kind == EG_PICK_CAT && EG_SPOT_CAT[i]);
}
eg_gap2 :: (ax: f32, az: f32, bx: f32, bz: f32) -> f32 { return (ax - bx) * (ax - bx) + (az - bz) * (az - bz); }

// What "remove ..." takes, standing at (x, z): who (a spot) names one
// person; else of kind (EG_PICK_*), the nearest within EG_REMOVE_NEAR, or
// with all ("these crates", "clear this") every one within it and the whole
// group the nearest was placed with. With no kind and not all, the nearest
// of the things and the people; with no kind and all, the placed things.
eg_remove_pick :: (e: EgEdits, x: f32, z: f32, kind: int, who: int, all: bool) -> EgTake {
  r: EgTake;
  if who >= 0 && who < EG_SPOTS {
    if !eg_gone(e, who) { r.people = cast(u32) 1 << cast(u32) who; r.n_people = 1; }
    return r;
  }
  reach := f32(EG_REMOVE_NEAR * EG_REMOVE_NEAR);
  best := -1; most := reach;
  for i: 0..<e.n {
    if !eg_take_thing(e, i, kind) { continue; }
    d := eg_gap2(e.things[i].x, e.things[i].z, x, z);
    if d < most { most = d; best = i; }
  }
  folk := kind == EG_PICK_PERSON || kind == EG_PICK_CAT || (kind == EG_PICK_ANY && !all);
  person := -1;
  if folk {
    for i: 0..<EG_SPOTS {
      if !eg_take_person(e, i, kind) { continue; }
      d := eg_gap2(EG_SPOT[i * 3], EG_SPOT[i * 3 + 1], x, z);
      if d < most { most = d; person = i; best = -1; }
    }
  }
  if !all {
    if person >= 0 { r.people = cast(u32) 1 << cast(u32) person; r.n_people = 1; }
    else if best >= 0 { r.things = cast(u64) 1 << cast(u64) best; r.n_things = 1; }
    return r;
  }
  group := ifx best >= 0 then e.things[best].group else 0;
  for i: 0..<e.n {
    if !eg_take_thing(e, i, kind) { continue; }
    close := eg_gap2(e.things[i].x, e.things[i].z, x, z) < reach;
    if close || (group > 0 && e.things[i].group == group) { r.things |= cast(u64) 1 << cast(u64) i; r.n_things += 1; }
  }
  if folk {
    for i: 0..<EG_SPOTS {
      if eg_take_person(e, i, kind) && eg_gap2(EG_SPOT[i * 3], EG_SPOT[i * 3 + 1], x, z) < reach { r.people |= cast(u32) 1 << cast(u32) i; r.n_people += 1; }
    }
  }
  return r;
}

// The list without what t takes.
eg_remove :: (e: EgEdits, t: EgTake) -> EgEdits {
  out := e;
  out.n = 0;
  for i: 0..<e.n {
    if (t.things >> cast(u64) i) & 1 != 0 { continue; }
    out.things[out.n] = e.things[i]; out.n += 1;
  }
  out.gone = e.gone | t.people;
  return out;
}

// A new group's number for a row placed together.
eg_new_group :: (e: EgEdits) -> int {
  g := 0;
  for i: 0..<e.n { g = hi_i(g, e.things[i].group); }
  return g + 1;
}

// ---- the list as text

eg_put_int :: (out: [] u8, at: int, v: int) -> int {
  n := at;
  if v < 0 { n = raw_put(out, n, "-"); }
  a := ifx v < 0 then -v else v;
  d: [12] u8; m := 0;
  while m == 0 || a > 0 { d[m] = cast(u8) ('0' + a % 10); a = a / 10; m += 1; }
  while m > 0 { m -= 1; if n < out.count { out[n] = d[m]; n += 1; } }
  return n;
}
eg_round :: (v: f32) -> int { return cast(int) floor(v + 0.5); }

// The list as text into out: its length, or 0 when it doesn't fit.
eg_edits_text :: (e: EgEdits, out: [] u8) -> int {
  n := raw_put(out, 0, EG_EDIT_HEAD);
  for i: 0..<e.n {
    t := e.things[i];
    n = raw_put(out, n, "t ");
    n = eg_put_int(out, n, eg_edit_kind(t.kind));
    n = raw_put(out, n, " "); n = eg_put_int(out, n, eg_round(t.x * 100));
    n = raw_put(out, n, " "); n = eg_put_int(out, n, eg_round(t.z * 100));
    n = raw_put(out, n, " "); n = eg_put_int(out, n, eg_round(t.yaw * 180 / f32(PI)));
    n = raw_put(out, n, " "); n = eg_put_int(out, n, eg_round(t.size * 100));
    if t.group > 0 { n = raw_put(out, n, " "); n = eg_put_int(out, n, t.group); }
    n = raw_put(out, n, "\n");
  }
  for i: 0..<EG_SPOTS {
    if !eg_gone(e, i) { continue; }
    n = raw_put(out, n, "p "); n = eg_put_int(out, n, i); n = raw_put(out, n, "\n");
  }
  if n >= out.count { return 0; }
  return n;
}

// A whole number at line[i] (an optional minus), and where it ends.
EgNumber :: struct { v: int; end: int; ok: bool; }
eg_number :: (line: string, from: int) -> EgNumber {
  r: EgNumber;
  i := from;
  while i < line.count && line[i] == ' ' { i += 1; }
  minus := i < line.count && line[i] == '-';
  if minus { i += 1; }
  v := 0; digits := 0;
  while i < line.count && line[i] >= '0' && line[i] <= '9' && digits < 9 { v = v * 10 + cast(int) (line[i] - '0'); i += 1; digits += 1; }
  r.ok = digits > 0 && (i == line.count || line[i] == ' ');
  r.v = ifx minus then -v else v;
  r.end = i;
  return r;
}

// Reads a list into e: true when the text is one (its head, and every
// line a whole thing); a thing that can't stand where it says is dropped.
eg_edits_read :: (text: string, e: [] EgEdits) -> bool {
  if text.count < EG_EDIT_HEAD.count || text[0..<EG_EDIT_HEAD.count] != EG_EDIT_HEAD { return false; }
  got: EgEdits;
  i := EG_EDIT_HEAD.count;
  while i < text.count {
    j := i; while j < text.count && text[j] != '\n' { j += 1; }
    line := text[i..<j];
    i = j + 1;
    if line.count == 0 { continue; }
    if line.count < 3 || (line[0] != 't' && line[0] != 'p') || line[1] != ' ' { return false; }
    if line[0] == 'p' {
      spot := eg_number(line, 2);
      if !spot.ok || spot.end != line.count { return false; }
      if spot.v >= 0 && spot.v < EG_SPOTS { got.gone |= cast(u32) 1 << cast(u32) spot.v; }
      continue;
    }
    kind := eg_number(line, 2); x := eg_number(line, kind.end); z := eg_number(line, x.end);
    yaw := eg_number(line, z.end); size := eg_number(line, yaw.end);
    if !kind.ok || !x.ok || !z.ok || !yaw.ok || !size.ok { return false; }
    group := 0;
    if size.end != line.count {
      g := eg_number(line, size.end);
      if !g.ok || g.end != line.count { return false; }
      group = hi_i(g.v, 0);
    }
    if kind.v < 0 || kind.v >= EG_EDIT_ITEMS || got.n >= EG_EDIT_MAX { continue; }
    t: EgThing;
    t.kind = kind.v; t.x = f32(x.v) / 100; t.z = f32(z.v) / 100;
    t.yaw = f32(yaw.v) * f32(PI) / 180;
    t.size = clamp(f32(size.v) / 100, f32(EG_EDIT_SIZE_MIN), f32(EG_EDIT_SIZE_MAX));
    t.group = group;
    got.things[got.n] = t; got.n += 1;
    if eg_edit_fault(got, got.n - 1) != EG_FAULT_NONE { got.n -= 1; }
  }
  e[0] = got;
  return true;
}

// ---- the server's world (POST /api/playtest/world/everglade {doc, summary})

// The publish's body: {"doc":{"everglade":1,"edits":"..."},"summary":"..."}; 0 when it doesn't fit.
eg_edits_body :: (e: EgEdits, summary: string, out: [] u8) -> int {
  text: [4096] u8;
  tn := eg_edits_text(e, text[..]);
  if tn == 0 { return 0; }
  n := raw_put(out, 0, "{\"doc\":{\"everglade\":1,\"edits\":\"");
  for i: 0..<tn {
    if text[i] == '\n' { n = raw_put(out, n, "\\n"); } else if n < out.count { out[n] = text[i]; n += 1; }
  }
  n = raw_put(out, n, "\"},\"summary\":\"");
  for i: 0..<summary.count {
    c := summary[i];
    if c == '"' || c == '\\' || c < 32 { continue; }
    if n < out.count { out[n] = c; n += 1; }
  }
  n = raw_put(out, n, "\"}");
  if n >= out.count { return 0; }
  return n;
}

// Where a JSON key's value starts in text (after "key", spaces and the colon), or -1.
eg_json_at :: (text: string, key: string) -> int {
  if key.count + 2 > text.count { return -1; }
  for i: 0..<text.count - key.count - 1 {
    if text[i] != '"' || text[i + key.count + 1] != '"' || text[i + 1..<i + 1 + key.count] != key { continue; }
    j := i + key.count + 2;
    while j < text.count && text[j] == ' ' { j += 1; }
    if j >= text.count || text[j] != ':' { continue; }
    j += 1;
    while j < text.count && text[j] == ' ' { j += 1; }
    return j;
  }
  return -1;
}

// The server's answer to GET /api/playtest/world/everglade ("200\n" and its
// JSON): the published list into e, and its version (0 none published, the
// designed city; -1 no good answer).
eg_edits_answer :: (answer: string, e: [] EgEdits) -> int {
  if answer.count < 4 || answer[0..<4] != "200\n" { return -1; }
  body := answer[4..<answer.count];
  v := eg_json_at(body, "version");
  if v < 0 { return -1; }
  version := eg_number(body[v..<body.count], 0);
  if version.v == 0 { e[0].n = 0; e[0].gone = 0; return 0; }
  at := eg_json_at(body, "edits");
  if at < 0 || body[at] != '"' { return -1; }
  text: [4096] u8; n := 0;
  i := at + 1;
  while i < body.count && body[i] != '"' && n < 4096 {
    c := body[i];
    if c == '\\' && i + 1 < body.count {
      i += 1;
      c = ifx body[i] == 'n' then cast(u8) '\n' else body[i];
    }
    text[n] = c; n += 1; i += 1;
  }
  if !eg_edits_read(cast(string) text[0..<n], e) { return -1; }
  return hi_i(version.v, 1);
}

// ---- checks

eg_thing :: (kind: int, x: f32, z: f32, yaw: f32, size: f32) -> EgThing {
  t: EgThing; t.kind = kind; t.x = x; t.z = z; t.yaw = yaw; t.size = size;
  return t;
}
eg_one :: (t: EgThing) -> EgEdits { e: EgEdits; e.things[0] = t; e.n = 1; return e; }

#test "a thing stands in the open: not in a building, the palisade, the woods, the river or past the edge" {
  #assert eg_edit_fault(eg_one(eg_thing(0, 6, -12, 0, 1)), 0) == EG_FAULT_NONE;           // on the commons
  #assert eg_edit_fault(eg_one(eg_thing(0, -27, 41, 0, 1)), 0) == EG_FAULT_SOLID;         // in the mages' tower
  #assert eg_edit_fault(eg_one(eg_thing(0, -14, -37, 0, 1)), 0) == EG_FAULT_NONE;          // in the inn's room: it furnishes it
  #assert eg_edit_fault(eg_one(eg_thing(1, 20, -56, 0, 1)), 0) == EG_FAULT_SOLID;         // in the south wall
  #assert eg_edit_fault(eg_one(eg_thing(1, 1, 1, 0, 1)), 0) == EG_FAULT_SOLID;            // in the fountain
  #assert eg_edit_fault(eg_one(eg_thing(1, -40, -75, 0, 1)), 0) == EG_FAULT_WOODS;        // in the woods
  #assert eg_edit_fault(eg_one(eg_thing(1, 88, 40, 0, 1)), 0) != EG_FAULT_NONE;           // in the river
  #assert eg_edit_fault(eg_one(eg_thing(1, 88, -11, 0, 1)), 0) == EG_FAULT_SOLID;         // on the bridge's deck
  #assert eg_edit_fault(eg_one(eg_thing(4, 0, -99.4, 0, 1)), 0) == EG_FAULT_EDGE;         // past the edge
  // a bench turned a quarter is long the other way; a big one reaches the wall a small one doesn't
  #assert eg_edit_fault(eg_one(eg_thing(2, 6, -51.5, 0, 1)), 0) == EG_FAULT_NONE;
  #assert eg_edit_fault(eg_one(eg_thing(2, 6, -51.5, f32(PI) / 2, 1)), 0) == EG_FAULT_NONE;
  #assert eg_edit_fault(eg_one(eg_thing(2, 6, -51.5, f32(PI) / 2, 3)), 0) == EG_FAULT_SOLID;
}

#test "two things don't stand in each other" {
  e: EgEdits;
  e.things[0] = eg_thing(0, 6, -12, 0, 1); e.things[1] = eg_thing(0, 6.5, -12, 0, 1); e.n = 2;
  #assert eg_edit_fault(e, 1) == EG_FAULT_THING && eg_edit_fault(e, 0) == EG_FAULT_THING;
  e.things[1].x = 8;
  #assert eg_edit_fault(e, 1) == EG_FAULT_NONE;
}

#test "a thing on a street is allowed, and said" {
  #assert eg_edit_on_street(eg_one(eg_thing(0, 0, -34, 0, 1)), 0);
  #assert !eg_edit_on_street(eg_one(eg_thing(0, 6, -12, 0, 1)), 0);
  #assert !eg_edit_on_street(eg_one(eg_thing(0, 20, -6, 0, 1)), 0);
}

#test "the list round trips as text, and refuses what isn't one" {
  e: EgEdits;
  e.things[0] = eg_thing(1, 6, -12, f32(PI) / 4, 1.2); e.things[1] = eg_thing(4, -20.5, 3.25, 0, 1); e.n = 2;
  out: [512] u8;
  n := eg_edits_text(e, out[..]);
  #assert cast(string) out[0..<n] == "eg-edit 1\nt 1 600 -1200 45 120\nt 4 -2050 325 0 100\n";
  back: [1] EgEdits;
  #assert eg_edits_read(cast(string) out[0..<n], back[..]);
  #assert back[0].n == 2 && back[0].things[0].kind == 1 && abs(back[0].things[0].z + 12) < 0.001 && abs(back[0].things[0].yaw - f32(PI) / 4) < 0.001;
  #assert abs(back[0].things[1].size - 1) < 0.001 && abs(back[0].things[1].x + 20.5) < 0.001;
  #assert !eg_edits_read("eg-edit 2\n", back[..]) && !eg_edits_read("eg-edit 1\nt 1 2 3\n", back[..]) && !eg_edits_read("eg-edit 1\nx 1 2 3 4 5\n", back[..]);
  // a thing that can't stand where it says is dropped; an unknown kind too; sizes are held to their range
  #assert eg_edits_read("eg-edit 1\nt 0 -2700 4100 0 100\nt 9 600 -1200 0 100\nt 1 600 -1200 0 900\n", back[..]);
  #assert back[0].n == 1 && back[0].things[0].kind == 1 && back[0].things[0].size == f32(EG_EDIT_SIZE_MAX);
  #assert eg_edits_read("eg-edit 1\n", back[..]) && back[0].n == 0;
}

#test "the publish's body and the server's answer" {
  e: EgEdits;
  e.things[0] = eg_thing(1, 6, -12, 0, 1); e.n = 1;
  out: [1024] u8;
  n := eg_edits_body(e, "Placed a \"barrel\"", out[..]);
  #assert cast(string) out[0..<n] == "{\"doc\":{\"everglade\":1,\"edits\":\"eg-edit 1\\nt 1 600 -1200 0 100\\n\"},\"summary\":\"Placed a barrel\"}";
  got: [1] EgEdits;
  #assert eg_edits_answer("200\n{\"doc\": {\"edits\": \"eg-edit 1\\nt 1 600 -1200 0 100\\n\", \"everglade\": 1}, \"version\": 3, \"publishedAt\": 1.5, \"publishedBy\": \"owner\"}", got[..]) == 3;
  #assert got[0].n == 1 && got[0].things[0].kind == 1;
  #assert eg_edits_answer("200\n{\"doc\": null, \"version\": 0}", got[..]) == 0 && got[0].n == 0;
  #assert eg_edits_answer("500\n{}", got[..]) == -1 && eg_edits_answer("200\n{\"doc\": {\"edits\": \"nonsense\"}, \"version\": 2}", got[..]) == -1;
}

#test "a removal: the nearest thing or person, a named one, or a whole row ('these crates')" {
  e: EgEdits;
  // the owner's four crates in a row on the commons, placed together, and a bench beside them
  for k: 0..<4 { e.things[k] = eg_thing(0, 4 + f32(k) * 1.34, -12, 0, 1); e.things[k].group = 1; }
  e.things[4] = eg_thing(2, 6, -16, 0, 1); e.n = 5;
  one := eg_remove_pick(e, 6, -10, EG_PICK_ANY, -1, false);
  #assert one.n_things == 1 && one.n_people == 0 && (one.things >> 1) & 1 != 0;
  rows := eg_remove_pick(e, 6, -10, 0, -1, true);
  #assert rows.n_things == 4 && rows.n_people == 0 && (rows.things >> 4) & 1 == 0;
  left := eg_remove(e, rows);
  #assert left.n == 1 && left.things[0].kind == 2;
  // standing far down the row, "these crates" still takes the whole row it was placed in
  far := eg_remove_pick(e, 4 - 7.5, -12, 0, -1, true);
  #assert far.n_things == 4;
  // "clear this": every placed thing near, nobody of the city
  clear := eg_remove_pick(e, 6, -12, EG_PICK_ANY, -1, true);
  #assert clear.n_things == 5 && clear.n_people == 0;
  // the town crier stands by the board: nearer than any thing, "remove that" takes him
  crier := eg_remove_pick(e, 3.2, -7, EG_PICK_ANY, -1, false);
  #assert crier.n_people == 1 && (crier.people >> 3) & 1 != 0;
  marta := eg_remove(e, eg_remove_pick(e, 0, 0, EG_PICK_ANY, 5, false));
  #assert eg_gone(marta, 5) && marta.n == 5 && eg_remove_pick(marta, 0, 0, EG_PICK_ANY, 5, false).n_people == 0;
  // the inn's cat by Marta, as a cat; nothing near is nothing taken
  #assert eg_remove_pick(e, -3.4, -32, EG_PICK_CAT, -1, false).people == cast(u32) 64;
  #assert eg_remove_pick(e, 60, -40, EG_PICK_ANY, -1, false).n_things == 0;
  #assert eg_new_group(e) == 2;
}

#test "the list keeps who is gone and each thing's row" {
  e: EgEdits;
  e.things[0] = eg_thing(0, 6, -12, 0, 1); e.things[0].group = 3; e.n = 1;
  e.gone = (cast(u32) 1 << 5) | (cast(u32) 1 << 19);
  out: [512] u8;
  n := eg_edits_text(e, out[..]);
  #assert cast(string) out[0..<n] == "eg-edit 1\nt 0 600 -1200 0 100 3\np 5\np 19\n";
  back: [1] EgEdits;
  #assert eg_edits_read(cast(string) out[0..<n], back[..]);
  #assert back[0].n == 1 && back[0].things[0].group == 3 && eg_gone(back[0], 5) && eg_gone(back[0], 19) && !eg_gone(back[0], 3);
  #assert !eg_edits_read("eg-edit 1\np x\n", back[..]);
}
