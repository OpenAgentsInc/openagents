// Translated from WGSL by coax/web/wgsl-coax.coax.
#load "../gpu/wgsl.coax";
#load "../style.coax";

// Everglade's three passes: the sky, the scene (with the river's water in
// two blended halves after it) and the HUD. Every number
// comes from everglade.coax: the view, the eye and the fog, the sun, the
// ground's heights (store 0) and each object's place, size, colour and shape
// (store 1), the shadows, the streets, the paved squares and the HUD's
// plates and strokes. The kit's meshes come from the realm's pack: its
// vertices (pack_realm.py: 48 bytes, position, normal, uv, colour with its
// layer in the top byte) and its texture layers.
// EgU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0
//   time 2
//   fade 3
//   still 4
//   plates 5
//   k 6
//   horizon 7
//   r0 8
//   r1 12
//   r2 16
//   r3 20
//   eye 24
//   sun 28
//   ground 32
//   shadow 36
//   path 100
//   path_info 228
//   square 232
//   plate 248
//   water 760
//   style 1084
//   solid 1212
//   light_info 1340
//   lights 1344
//   weather 1472
//   ponds 1484
//   fx 1500
//   tide 2096
//   marks 2104
// the river's waves, look and mesh (verse/water-look.coax W_* rows)
// the painterly preset at the clock (verse/style-preset.coax SU_*: row = SU / 4)
// where no grass grows: the buildings' and props' footprints (x0, z0, x1, z1)
// the lamps lit, how lit (0 by day to 1 at night) (everglade.coax lamps), and how many of the last are the spells' blasts
// each lamp: x, y, z, reach; r, g, b, strength
// rain, wind x, wind z, lightning; wet, puddles, cloud, fog; rise (m), flow gain, deck top (m), buildings in solid (everglade.coax weather_frame)
// the ponds: x, z, rim radius, level (everglade.coax U_PONDS; pond_vertex)
// W6 (verse/everglade/river.coax everglade_river_fx): the weir's sheet (west, east, z, on; the level
// above, below, the water's speed over the sill), the rowboats' hulls (x, z, yaw, on), the wakes'
// trails (2 movers, 8 points each: x, z, when, speed; the newest first), then 64 particles (x, y, z,
// size; kind, alpha, age's share)
// the water the spells hold back (everglade-tide.coax td_uniforms): Part Water's trench (ax, az, bx, bz; half width), the whirlpool's eye (x, z, radius)
// the spells' marks on the ground (everglade-marks.coax sp_marks): a count, then two rows each (ground_mark)
// The painterly preset at the clock (art-styles.md; everglade.coax writes u.style each frame).
eg_st :: (i:u32,u:[]f32)->V4 {
  return wg_at4(u,(cast(int)i)*4+1084);
}
// The haze over a surface d metres off at height y, looking along v (spec 4): the preset's curve from
// where it starts (u.sun.w) and its density (u.eye.w), both the preset's own but thinned over the
// map's lift, teal where thin and the preset's blue far off, warm toward the key light.
eg_haze_share :: (d:f32,y:f32,u:[]f32)->f32 {
  return verse_style_haze(d,y,u[25]-2.5f32,u[31],u[27],eg_st(9,u).z,eg_st(9,u).w);
}
eg_haze_colour :: (f:f32,v:V3,u:[]f32)->V3 {
  hz:V3=wg_sw_xyz_f4(eg_st(10,u));
  cap:f32=eg_st(9,u).z;
  h:V3=v3(verse_style_haze_hue(hz.x,0.0f32,f,cap),verse_style_haze_hue(hz.y,1.0f32,f,cap),verse_style_haze_hue(hz.z,2.0f32,f,cap));
  // the green between the trunks (comparison round 2: the references' near haze is a green-teal mist,
  // ours a clear sky blue): looking level, the haze takes the meadow's hue, the light it has crossed
  // the grass and the leaves to reach; by day only, none looking up or down
  green:V3=wg_div_f3f(eg_meadow_srgb(0.5f32),wg_dot3(eg_meadow_srgb(0.5f32),v3(0.3333f32,0.3333f32,0.3333f32)));
  level:f32=1.0f32-smoothstep(0.05f32,0.35f32,abs(v.y));
  h=wg_mix_f3f3f(h,wg_mul_f3f3(h,green),(0.38f32*level)*(1.0f32-eg_st(14,u).w));
  return wg_mix_f3f3f(h,wg_sw_xyz_f4(eg_st(11,u)),verse_style_haze_glow(wg_dot3(v,wg_sw_xyz_f4(eg_st(1,u)))));
}
// The spell bar's square pieces (everglade-spells.coax sp_bar), as the previous engine's HUD drew
// them (hotbar.rs draw_of, demolition/hotbar.rs meter): a pixel is in the rect when its centre is,
// as a quad covers it, and s.w is the piece's unit (the tray's, the meter's) or edge (a slot's frame),
// device pixels. Its colours are the old HUD's, sRGB-encoded as its target encoded them.
eg_hud_rect :: (p:V2,under:V3,r:V4,s:V4)->V3 {
  if ((((p.x<r.x)||(p.y<r.y))||(p.x>=r.z))||(p.y>=r.w)) {
    return under;
  }
  e:f32=fmin(fmin(p.x-r.x,r.z-p.x),fmin(p.y-r.y,r.w-p.y)); // to the nearest edge
  t:f32=fmax(s.w,1.0f32);
  look:f32=s.y;
  if (look>7.5f32) {
    // a damage number's shade (everglade-watch.coax watch_pops_draw): a soft dark oval under its digits
    h:V2=wg_max_f2f2(wg_mul_f2f(wg_sub_f2f2(v2(r.z,r.w),v2(r.x,r.y)),0.5f32),v2(1.0f32,1.0f32));
    d:f32=wg_length2(wg_div_f2f2(wg_sub_f2f2(p,wg_add_f2f2(v2(r.x,r.y),h)),h));
    return wg_mix_f3f3f(under,v3(0.03f32,0.0f32,0.0f32),clampf(s.x,0.0f32,1.0f32)*(1.0f32-smoothstep(0.4f32,1.0f32,d)));
  }
  if (look<3.5f32) {
    // the tray (the owner, October 30: as the HUD's other plates, chamfered, grey, no bronze): a
    // dark see-through well, a thin grey line, its corners cut at 45 degrees
    dx:f32=fmin(p.x-r.x,r.z-p.x);
    dy:f32=fmin(p.y-r.y,r.w-p.y);
    cut:f32=5.0f32*t;
    if ((dx+dy)<cut) {
      return under;
    }
    rim:f32=fmin(e,((dx+dy)-cut)*0.7071f32);
    if (rim<t) {
      return wg_mix_f3f3f(under,v3(0.46f32,0.48f32,0.5f32),0.9f32);
    }
    return wg_mix_f3f3f(under,v3(0.045f32,0.05f32,0.058f32),0.82f32);
  }
  if (look<5.5f32) {
    // a slot's frame: a dark grey line, or the HUD's blue while its spell is picked or casting
    if (e>=t) {
      return under;
    }
    return ifx look>4.5f32 then v3(0.48f32,0.72f32,1.0f32) else v3(0.26f32,0.28f32,0.3f32);
  }
  if (look<6.5f32) {
    // a meter: a bronze line round a dark well
    if (e<t) {
      return v3(0.708f32,0.658f32,0.527f32);
    }
    return wg_mix_f3f3f(under,v3(0.437f32,0.313f32,0.221f32),0.94f32);
  }
  return v3(1.0f32,0.735f32,0.381f32); // the cast's fill, fire orange
}
eg_plate :: (p:V2,under:V3,r:V4,s:V4)->V3 {
  if (s.x<=0.0f32) {
    return under;
  }
  if (s.y>2.5f32) {
    return eg_hud_rect(p,under,r,s);
  }
  half:V2=wg_mul_f2f(wg_sub_f2f2(v2(r.z,r.w),v2(r.x,r.y)),0.5f32);
  corner:f32=6.0f32*s.z;
  q:V2=wg_add_f2f2(wg_sub_f2f2(wg_abs_f2(wg_sub_f2f2(p,wg_add_f2f2(v2(r.x,r.y),half))),half),v2(corner,corner));
  d:f32=(wg_length2(wg_max_f2f2(q,v2(0.0f32,0.0f32)))+fmin(fmax(q.x,q.y),0.0f32))-corner;
  if (d>1.0f32) {
    return under;
  }
  over:bool=s.y>=2.0f32;
  fill:V3=ifx over then v3(0.09f32,0.12f32,0.09f32) else v3(0.055f32,0.075f32,0.06f32);
  line:V3=ifx over||(s.y>=1.0f32) then v3(0.90f32,0.76f32,0.45f32) else v3(0.62f32,0.52f32,0.30f32);
  w:f32=1.25f32*s.z;
  inside:f32=clampf(0.5f32-d,0.0f32,1.0f32);
  edge:f32=clampf(((w*0.5f32)+0.5f32)-abs(d+(w*0.5f32)),0.0f32,1.0f32);
  a:f32=clampf(s.x,0.0f32,1.0f32);
  return wg_mix_f3f3f(wg_mix_f3f3f(under,fill,a*inside),line,(edge*fmin(1.0f32,a+0.1f32))*0.8f32);
}
eg_plates :: (p:V2,under:V3,u:[]f32)->V3 {
  c:V3=under;
  {
    k:s32=0;
    while k<64 {
      if ((cast(f32)(k))>=u[5]) {
        break;
      }
      c=eg_plate(p,c,wg_at4(u,(cast(int)(k*2))*4+248),wg_at4(u,(cast(int)((k*2)+1))*4+248));
      k+=1;
    }
  }
  return c;
}
eg_encode :: (c:V3)->V3 {
  return wg_pow_f3f3(wg_clamp_f3f3f3(c,v3(0.0f32,0.0f32,0.0f32),v3(1.0f32,1.0f32,1.0f32)),wg_make_f3_f(1.0f32/2.2f32));
}
eg_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}
// Everything draws light (rgba16float, its alpha the share that blooms) and aux (r: the sky's glow
// the light shafts blur); post_fs blooms, tones, encodes and lays the plates over it (host.js post).
EgLit :: struct {light:V4; aux:V4; }
// The view's inverse (the clip rows', by cofactors), so the sky is painted along each pixel's ray.
eg_unview :: (u:[]f32)->M4 {
  m:M4=wg_transpose(M4.{c0=wg_at4(u,8),c1=wg_at4(u,12),c2=wg_at4(u,16),c3=wg_at4(u,20)});
  a00:f32=m.c0.x;
  a01:f32=m.c0.y;
  a02:f32=m.c0.z;
  a03:f32=m.c0.w;
  a10:f32=m.c1.x;
  a11:f32=m.c1.y;
  a12:f32=m.c1.z;
  a13:f32=m.c1.w;
  a20:f32=m.c2.x;
  a21:f32=m.c2.y;
  a22:f32=m.c2.z;
  a23:f32=m.c2.w;
  a30:f32=m.c3.x;
  a31:f32=m.c3.y;
  a32:f32=m.c3.z;
  a33:f32=m.c3.w;
  b00:f32=(a00*a11)-(a01*a10);
  b01:f32=(a00*a12)-(a02*a10);
  b02:f32=(a00*a13)-(a03*a10);
  b03:f32=(a01*a12)-(a02*a11);
  b04:f32=(a01*a13)-(a03*a11);
  b05:f32=(a02*a13)-(a03*a12);
  b06:f32=(a20*a31)-(a21*a30);
  b07:f32=(a20*a32)-(a22*a30);
  b08:f32=(a20*a33)-(a23*a30);
  b09:f32=(a21*a32)-(a22*a31);
  b10:f32=(a21*a33)-(a23*a31);
  b11:f32=(a22*a33)-(a23*a32);
  det:f32=(((((b00*b11)-(b01*b10))+(b02*b09))+(b03*b08))-(b04*b07))+(b05*b06);
  k:f32=1.0f32/(ifx abs(det)<1e-12f32 then 1e-9f32 else det);
  return M4.{c0=wg_mul_f4f(v4(((a11*b11)-(a12*b10))+(a13*b09),((a02*b10)-(a01*b11))-(a03*b09),((a31*b05)-(a32*b04))+(a33*b03),((a22*b04)-(a21*b05))-(a23*b03)),k),c1=wg_mul_f4f(v4(((a12*b08)-(a10*b11))-(a13*b07),((a00*b11)-(a02*b08))+(a03*b07),((a32*b02)-(a30*b05))-(a33*b01),((a20*b05)-(a22*b02))+(a23*b01)),k),c2=wg_mul_f4f(v4(((a10*b10)-(a11*b08))+(a13*b06),((a01*b08)-(a00*b10))-(a03*b06),((a30*b04)-(a31*b02))+(a33*b00),((a21*b02)-(a20*b04))-(a23*b00)),k),c3=wg_mul_f4f(v4(((a11*b07)-(a10*b09))-(a12*b06),((a00*b09)-(a01*b07))+(a02*b06),((a31*b01)-(a30*b03))-(a32*b00),((a20*b03)-(a21*b01))+(a22*b00)),k)};
}
eg_pixel_ray :: (p:V2,u:[]f32)->V3 {
  ndc:V4=v4(((p.x/u[0])*2.0f32)-1.0f32,1.0f32-((p.y/u[1])*2.0f32),0.9f32,1.0f32);
  w:V4=m4_apply(eg_unview(u),ndc);
  return wg_normalize3(wg_sub_f3f3(wg_div_f3f(v3(w.x,w.y,w.z),w.w),v3(u[24],u[25],u[26])));
}
eg_hash2 :: (p:V2)->f32 {
  return fract(sin(wg_dot2(p,v2(127.1f32,311.7f32)))*43758.5453f32);
}
// Stars along a ray at night: one at most per cell of the sky's own grid, a few brighter.
eg_stars :: (d:V3)->f32 {
  if (d.y<=0.0f32) {
    return 0.0f32;
  }
  q:V2=wg_mul_f2f(wg_div_f2f(v2(d.x,d.z),(d.y+0.35f32)),260.0f32);
  g:V2=wg_floor_f2(q);
