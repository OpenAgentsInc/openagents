// Only the current visible selected objective is projected. No saved quest
// stages/history, player identifiers, speech, coordinates or private context.
// help_requested is a separate authored Directions interaction, never talk_to.
// destination_available means a known reachable canonical route after edits;
// first integration may refuse whenever any edits exist. hint_visible refers
// to an existing guide tip/cooldown, not the ordinary quest tracker.
GgObservation :: struct {help_requested:bool;goal:int;destination_available:bool;at_destination:bool;hint_visible:bool;eligible:bool;}
GgAnswer :: struct {ok:bool;action:int=-1;}
GgAdmit :: struct {ok:bool;action:int=-1;}
GgNumber :: struct {ok:bool;units:int;}
