// Versioned adapters around the actual cosmetic consumers. Their existing
// pure policy runs on a private copy; a decision must enter the replay log
// before the result, counters or transport capability can be published.
#load "guard-decision.coax";
#load "guard-guide-session.coax";
#load "../../aethyr/decision-trace.coax" as receipt;
#authority;

guard_trace_v1_reset :: ()->receipt.DecisionTraceV1 #export_c #effects(all) {fresh:receipt.DecisionTraceV1;return fresh;}
ga_page_v2 :: (s:[]GaSession,trace:[]receipt.DecisionTraceV1,input:GaInput,now:int) #export_c #effects(all) {
  next:=[1]GaSession.[s[0]];before:=[1]GdState.[s[0].ticket[0]];
  receipt.dr_stage(trace,before[..],now);next[0].ticket[0]=before[0];
  ga_page(next[..],input,now);
  if next[0].accepted!=s[0].accepted {
    #assert next[0].accepted==s[0].accepted+1;
    choice:=receipt.dr_take(trace,before[..],next[0].context,now,7);
    if choice.code!=GdCode.ok {s[0].disabled=true;s[0].send=false;return;}
    #assert choice.action==next[0].last_action;
  }
  if next[0].ticket[0].sequence!=s[0].ticket[0].sequence {
    started:=receipt.dr_started(trace,next[0].ticket[0].ticket);
    if !started.ok {s[0].disabled=true;s[0].send=false;return;}
    next[0].send=next[0].send && started.live;
  }
  s[0]=next[0];
}
ggs_step_v2 :: (s:[]GgsSession,trace:[]receipt.DecisionTraceV1,input:GgsInput,now:int) #export_c #effects(all) {
  next:=[1]GgsSession.[s[0]];before:=[1]GdState.[s[0].ticket[0]];
  receipt.dr_stage(trace,before[..],now);next[0].ticket[0]=before[0];
  ggs_step(next[..],input,now);
  if next[0].admitted!=s[0].admitted {
    #assert next[0].admitted==s[0].admitted+1;
    choice:=receipt.dr_take(trace,before[..],ggs_context(input),now,gg_legal(ggs_observation(next[..],input)));
    if choice.code!=GdCode.ok {s[0].disabled=true;s[0].send=false;return;}
    #assert choice.action==next[0].last_admitted;
  }
  if next[0].ticket[0].sequence!=s[0].ticket[0].sequence {
    started:=receipt.dr_started(trace,next[0].ticket[0].ticket);
    if !started.ok {s[0].disabled=true;s[0].send=false;return;}
    next[0].send=next[0].send && started.live;
  }
  s[0]=next[0];
}
guard_trace_v1_save :: (trace:[]receipt.DecisionTraceV1,out:[]u8,overlap:bool)->int #export_c #effects(all) {return receipt.dr_save(trace,out,overlap);}
guard_trace_v1_load :: (trace:[]receipt.DecisionTraceV1,bytes:[]u8,context:GdContext,overlap:bool)->bool #export_c #effects(all) {return receipt.dr_load(trace,bytes,context,overlap);}

#test "the actual ambient consumer records at its boundary and reconstructs without dispatching a model" {
  trace:=[1]receipt.DecisionTraceV1.[guard_trace_v1_reset()];live:[1]GaSession;
  input:=GaInput.{configured=true,boundary=true,epoch=1,generation=1,revision=1,url="/?guard-ai=shadow",observation=GaObservation.{calm=true,alive=true,near=true,visible=true,safe=true,playable=true,day=1}};
  ga_page_v2(live[..],trace[..],input,0);#assert live[0].send;
  context:=live[0].ticket[0].ticket.context;
  ga_sent(live[..],1,true);ga_reply(live[..],1,1,"200\n",GA_RESPONSE);
  ga_page_v2(live[..],trace[..],input,2);#assert live[0].accepted==1 && live[0].last_action==1;
  bytes:[1024]u8;n:=guard_trace_v1_save(trace[..],bytes[..],false);#assert n==200;
  replay:[1]receipt.DecisionTraceV1;again:[1]GaSession;
  #assert guard_trace_v1_load(replay[..],bytes[0..<n],context,false);
  ga_page_v2(again[..],replay[..],input,0);#assert !again[0].send && ga_effect(again[..],0).body.count==0;
  ga_page_v2(again[..],replay[..],input,2);#assert again[0].accepted==1 && again[0].last_action==live[0].last_action;
  #assert replay_matched(receipt.dr_session(replay[..]));
}
#test "the real directions shadow consumer also records accepted choices while authored lines stay local" {
  trace:[1]receipt.DecisionTraceV1;live:[1]GgsSession;input:=ggs_test_input();input.boundary=false;
  ggs_step_v2(live[..],trace[..],input,0);input.boundary=true;input.observation.hint_visible=true;input.hint_intent=1;
  ggs_step_v2(live[..],trace[..],input,1);#assert live[0].send;
  context:=live[0].ticket[0].ticket.context;ggs_sent(live[..],1,true);ggs_test_deliver(live[..],1,2);
  ggs_step_v2(live[..],trace[..],input,4);#assert live[0].admitted==1 && live[0].last_admitted==2;
  bytes:[1024]u8;n:=guard_trace_v1_save(trace[..],bytes[..],false);#assert n==200;
  replay:[1]receipt.DecisionTraceV1;again:[1]GgsSession;#assert guard_trace_v1_load(replay[..],bytes[0..<n],context,false);
  input.boundary=false;input.observation.hint_visible=false;input.hint_intent=0;
  ggs_step_v2(again[..],replay[..],input,0);input.boundary=true;input.observation.hint_visible=true;input.hint_intent=1;
  ggs_step_v2(again[..],replay[..],input,1);#assert !again[0].send && ggs_effect(again[..],1).body.count==0;
  ggs_step_v2(again[..],replay[..],input,4);#assert again[0].admitted==1 && again[0].last_admitted==2;
  #assert ggs_view(again[..],4).local_action==ggs_view(live[..],4).local_action;
  #assert replay_matched(receipt.dr_session(replay[..]));
}
#test "ambient record exhaustion refuses both starting and publishing without inheriting a send capability" {
  input:=GaInput.{configured=true,boundary=true,epoch=1,generation=1,revision=1,url="/?guard-ai=shadow",observation=GaObservation.{calm=true,alive=true,near=true,visible=true,safe=true,playable=true}};
  for at_start:[2]bool.[false,true] {
    trace:[1]receipt.DecisionTraceV1;live:[1]GaSession;
    if !at_start {
      ga_page_v2(live[..],trace[..],input,0);ga_reply(live[..],1,1,"200\n",GA_RESPONSE);
      #assert live[0].ticket[0].phase==GD_READY;
    }
    trace[0].initialized=true;trace[0].n[REPLAY_EVENTS]=64;live[0].send=true;
    ga_page_v2(live[..],trace[..],input,2);
    #assert live[0].disabled && !live[0].send && live[0].accepted==0;
    #assert live[0].ticket[0].sequence==(ifx at_start then 0 else 1);
  }
}
#test "directions record exhaustion refuses starting and publishing while retaining the local line" {
  for at_start:[2]bool.[false,true] {
    trace:[1]receipt.DecisionTraceV1;live:[1]GgsSession;input:=ggs_test_input();input.boundary=false;
    ggs_step_v2(live[..],trace[..],input,0);input.boundary=true;input.observation.hint_visible=true;input.hint_intent=1;
    if !at_start {ggs_step_v2(live[..],trace[..],input,1);ggs_sent(live[..],1,true);ggs_test_deliver(live[..],1,2);#assert live[0].ticket[0].phase==GD_READY;}
    trace[0].initialized=true;trace[0].n[REPLAY_EVENTS]=64;live[0].send=true;
    ggs_step_v2(live[..],trace[..],input,4);
    #assert live[0].disabled && !live[0].send && live[0].admitted==0 && live[0].local_action==2;
    #assert live[0].ticket[0].sequence==(ifx at_start then 0 else 1);
  }
}
