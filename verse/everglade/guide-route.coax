// The route a guard's directions describe, and whether something in the
// world touches it. The route runs from where the guard stands, along the
// plan's streets and trails (EG_NODE_XZ, EG_LINK_AB; shortest by length),
// to the place the tip names. A thing touches the route when its footprint
// reaches the walked strip: EG_PATH_HALF either side of each leg. Only a
// touching edit (a placed thing, a hidden plan building), a spell's wall or
// stone, or rubble and broken pieces of a building refuse the tip; an edit
// anywhere else leaves it standing.
//   coax/bin/coax test --library verse/everglade/guide-route.coax
#load "edits.coax";

GR_MAX :: 34;
gr_lo :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }   // points on a route: the guard, every node at most once, the place

// Distance from a point to the segment a-b on the ground.
gr_point_gap :: (px: f32, pz: f32, ax: f32, az: f32, bx: f32, bz: f32) -> f32 {
  dx := bx - ax; dz := bz - az; len2 := dx * dx + dz * dz;
  t: f32 = 0;
  if len2 > 0 { t = ((px - ax) * dx + (pz - az) * dz) / len2; if t < 0 { t = 0; } if t > 1 { t = 1; } }
  qx := ax + t * dx - px; qz := az + t * dz - pz;
  return sqrt(qx * qx + qz * qz);
}
// Whether segments a-b and c-d cross (touching counts).
gr_cross :: (ax: f32, az: f32, bx: f32, bz: f32, cx: f32, cz: f32, dx: f32, dz: f32) -> bool {
  s1 := (dx - cx) * (az - cz) - (dz - cz) * (ax - cx);
  s2 := (dx - cx) * (bz - cz) - (dz - cz) * (bx - cx);
  s3 := (bx - ax) * (cz - az) - (bz - az) * (cx - ax);
  s4 := (bx - ax) * (dz - az) - (bz - az) * (dx - ax);
  return ((s1 <= 0 && s2 >= 0) || (s1 >= 0 && s2 <= 0)) && ((s3 <= 0 && s4 >= 0) || (s3 >= 0 && s4 <= 0));
}
// Distance between segments a-b and c-d.
gr_segment_gap :: (ax: f32, az: f32, bx: f32, bz: f32, cx: f32, cz: f32, dx: f32, dz: f32) -> f32 {
  if gr_cross(ax, az, bx, bz, cx, cz, dx, dz) { return 0; }
  g := gr_point_gap(ax, az, cx, cz, dx, dz);
  g = gr_lo(g, gr_point_gap(bx, bz, cx, cz, dx, dz));
  g = gr_lo(g, gr_point_gap(cx, cz, ax, az, bx, bz));
  return gr_lo(g, gr_point_gap(dx, dz, ax, az, bx, bz));
}
// Distance from the segment a-b to the box x0..x1, z0..z1 (0 inside or crossing).
gr_box_gap :: (ax: f32, az: f32, bx: f32, bz: f32, x0: f32, z0: f32, x1: f32, z1: f32) -> f32 {
  if ax >= x0 && ax <= x1 && az >= z0 && az <= z1 { return 0; }
  g := gr_segment_gap(ax, az, bx, bz, x0, z0, x1, z0);
  g = gr_lo(g, gr_segment_gap(ax, az, bx, bz, x1, z0, x1, z1));
  g = gr_lo(g, gr_segment_gap(ax, az, bx, bz, x1, z1, x0, z1));
  return gr_lo(g, gr_segment_gap(ax, az, bx, bz, x0, z1, x0, z0));
}

gr_nearest_node :: (x: f32, z: f32) -> int {
  best := 0; gap: f32 = 1e30;
  for i: 0..<EG_NODES {
    dx := EG_NODE_XZ[i * 2] - x; dz := EG_NODE_XZ[i * 2 + 1] - z; d := dx * dx + dz * dz;
    if d < gap { gap = d; best = i; }
  }
  return best;
}
// The route from (fx, fz) to (tx, tz) as points x, z into out; the count of points.
gr_route :: (fx: f32, fz: f32, tx: f32, tz: f32, out: [] f32) -> int {
  if out.count < GR_MAX * 2 { return 0; }
  a := gr_nearest_node(fx, fz); b := gr_nearest_node(tx, tz);
  dist: [EG_NODES] f32; prev: [EG_NODES] int; done: [EG_NODES] bool;
  for i: 0..<EG_NODES { dist[i] = 1e30; prev[i] = -1; }
  dist[a] = 0;
  for _: 0..<EG_NODES {
    u := -1;
    for i: 0..<EG_NODES { if !done[i] && dist[i] < 1e29 && (u < 0 || dist[i] < dist[u]) { u = i; } }
    if u < 0 { break; }
    done[u] = true;
    for l: 0..<EG_LINKS {
      p := EG_LINK_AB[l * 2]; q := EG_LINK_AB[l * 2 + 1]; v := -1;
      if p == u { v = q; } else if q == u { v = p; }
      if v < 0 || done[v] { continue; }
      dx := EG_NODE_XZ[v * 2] - EG_NODE_XZ[u * 2]; dz := EG_NODE_XZ[v * 2 + 1] - EG_NODE_XZ[u * 2 + 1];
      d := dist[u] + sqrt(dx * dx + dz * dz);
      if d < dist[v] { dist[v] = d; prev[v] = u; }
    }
  }
  if dist[b] > 1e29 { return 0; }
  chain: [EG_NODES] int; k := 0; at := b;
  while at >= 0 && k < EG_NODES { chain[k] = at; k += 1; at = prev[at]; }
  n := 0;
  out[0] = fx; out[1] = fz; n = 1;
  for j: 0..<k { i := chain[k - 1 - j]; out[n * 2] = EG_NODE_XZ[i * 2]; out[n * 2 + 1] = EG_NODE_XZ[i * 2 + 1]; n += 1; }
  out[n * 2] = tx; out[n * 2 + 1] = tz; n += 1;
  return n;
}

// Whether a footprint reaches the route's strip.
gr_touch_point :: (route: [] f32, n: int, x: f32, z: f32, r: f32) -> bool {
  for i: 0..<n - 1 {
    if gr_point_gap(x, z, route[i * 2], route[i * 2 + 1], route[i * 2 + 2], route[i * 2 + 3]) < f32(EG_PATH_HALF) + r { return true; }
  }
  return false;
}
gr_touch_segment :: (route: [] f32, n: int, ax: f32, az: f32, bx: f32, bz: f32, r: f32) -> bool {
  for i: 0..<n - 1 {
    if gr_segment_gap(route[i * 2], route[i * 2 + 1], route[i * 2 + 2], route[i * 2 + 3], ax, az, bx, bz) < f32(EG_PATH_HALF) + r { return true; }
  }
  return false;
}
gr_touch_box :: (route: [] f32, n: int, x0: f32, z0: f32, x1: f32, z1: f32) -> bool {
  for i: 0..<n - 1 {
    if gr_box_gap(route[i * 2], route[i * 2 + 1], route[i * 2 + 2], route[i * 2 + 3], x0, z0, x1, z1) < f32(EG_PATH_HALF) { return true; }
  }
  return false;
}
// The placed things whose footprints touch the route.
gr_things :: (route: [] f32, n: int, e: EgEdits) -> int {
  m := 0;
  for i: 0..<e.n {
    if i >= EG_EDIT_MAX { break; }
    box: [EG_BOX] f32; eg_edit_box(e.things[i], box[..]);
    if gr_touch_box(route, n, box[0], box[1], box[2], box[3]) { m += 1; }
  }
  return m;
}
// The hidden plan buildings that touch the route, a bit each.
gr_hidden :: (route: [] f32, n: int, hidden: u32) -> u32 {
  m: u32 = 0;
  for b: 0..<EG_BUILDINGS {
    if (hidden >> cast(u32) b) & 1 == 0 { continue; }
    k := b * EG_BOX;
    if gr_touch_box(route, n, EG_BUILDING[k], EG_BUILDING[k + 1], EG_BUILDING[k + 2], EG_BUILDING[k + 3]) { m |= cast(u32) 1 << cast(u32) b; }
  }
  return m;
}

// ---- checks
GR_PUBLISHED_21 :: "eg-edit 1\nt 2 -122 1181 73 100\nt 2 -27 867 73 100\nt 1 242 -2393 107 100 1\nt 0 -1265 -911 173 100 2\nt 0 -1398 -927 173 100 2\nt 0 -1531 -943 173 100 2\nt 0 -1664 -959 173 100 2\nt 1 -1336 -201 -180 100 3\nt 1 -1456 -201 -180 100 3\nt 4 -1453 349 17 100 4\nt 4 -1257 294 77 100 5\n";
gr_board_route :: (out: [] f32) -> int {
  b := EG_BOARD * EG_BOX;
  return gr_route(0, -54, (EG_PROP[b] + EG_PROP[b + 2]) / 2, (EG_PROP[b + 1] + EG_PROP[b + 3]) / 2, out);
}
#test "the route follows the streets from the guard to the place" {
  r: [GR_MAX * 2] f32; n := gr_board_route(r[..]);
  #assert n >= 4 && r[0] == 0 && r[1] == -54;
  // up the road in and Inn Street (nodes 9, 8, 2), then across to the board
  #assert r[2] == 0 && r[3] == -56 && r[4] == 0 && r[5] == -34 && r[6] == 0 && r[7] == -12;
  w: [GR_MAX * 2] f32; m := gr_route(0, -54, EG_PLACE[2 * 2], EG_PLACE[2 * 2 + 1], w[..]);   // Guild Row
  #assert m >= 4 && w[(m - 1) * 2] == EG_PLACE[4] && w[(m - 1) * 2 + 1] == EG_PLACE[5];
  short: [4] f32; #assert gr_route(0, 0, 1, 1, short[..]) == 0;
}
#test "an edit on the route refuses it; one beside it or elsewhere does not" {
  r: [GR_MAX * 2] f32; n := gr_board_route(r[..]);
  e: [1] EgEdits;
  // the published world (version 21, 2026-10-31): benches by the north of the
  // commons, a barrel off Inn Street's edge, crates and stalls by Guild Row
  #assert eg_edits_read(GR_PUBLISHED_21, e[..]);
  #assert e[0].n == 11 && gr_things(r[..], n, e[0]) == 0;
  // a crate in the middle of Inn Street
  #assert eg_edits_read("eg-edit 1\nt 0 0 -2000 0 100\n", e[..]) && gr_things(r[..], n, e[0]) == 1;
  // a fence whose end reaches the street's edge touches it
  #assert eg_edits_read("eg-edit 1\nt 3 190 -2000 0 100\n", e[..]) && gr_things(r[..], n, e[0]) == 1;
  // the same fence a metre further out does not
  #assert eg_edits_read("eg-edit 1\nt 3 290 -2000 0 100\n", e[..]) && gr_things(r[..], n, e[0]) == 0;
}
#test "a spell's wall or rubble on the route refuses it; one away does not" {
  r: [GR_MAX * 2] f32; n := gr_board_route(r[..]);
  #assert gr_touch_segment(r[..], n, -2, -20, 2, -20, 0.08);     // a wall across Inn Street
  #assert !gr_touch_segment(r[..], n, 3, -30, 3, -20, 0.08);     // one alongside, past the edge
  #assert !gr_touch_segment(r[..], n, -30, 20, -20, 20, 0.08);   // one across the town
  #assert gr_touch_point(r[..], n, 0.5, -40, 0.3);               // a chunk on the road in
  #assert !gr_touch_point(r[..], n, 4, -40, 0.3);                // one in the grass
  #assert gr_touch_box(r[..], n, -1, -26, 1, -24) && !gr_touch_box(r[..], n, 2, -26, 4, -24);
}
#test "a hidden building touches only when its box reaches the route" {
  r: [GR_MAX * 2] f32; n := gr_board_route(r[..]);
  all: u32 = 0xffff;
  #assert gr_hidden(r[..], n, 0) == 0;
  m := gr_hidden(r[..], n, all);
  for b: 0..<EG_BUILDINGS {
    k := b * EG_BOX;
    on := gr_touch_box(r[..], n, EG_BUILDING[k], EG_BUILDING[k + 1], EG_BUILDING[k + 2], EG_BUILDING[k + 3]);
    #assert ((m >> cast(u32) b) & 1 != 0) == on;
  }
}
#test "segment distances" {
  #assert abs(gr_point_gap(0, 1, -1, 0, 1, 0) - 1) < 0.0001 && abs(gr_point_gap(3, 0, -1, 0, 1, 0) - 2) < 0.0001;
  #assert gr_segment_gap(-1, 0, 1, 0, 0, -1, 0, 1) == 0 && abs(gr_segment_gap(-1, 0, 1, 0, -1, 2, 1, 2) - 2) < 0.0001;
  #assert gr_box_gap(0, 0, 0, 0, -1, -1, 1, 1) == 0 && abs(gr_box_gap(3, 0, 5, 0, -1, -1, 1, 1) - 2) < 0.0001;
}
