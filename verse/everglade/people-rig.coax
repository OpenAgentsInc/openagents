// The rig in a page's state (a view needs an array it may write through), and its views.
People :: struct {
  parent: [65] int; rest_m: [455] f32; rest_f: [455] f32; bind_m: [780] f32; bind_f: [780] f32;
  duration: [12] f32; distance: [12] f32; track_t: [1560] int; track_r: [1560] int;
  keys_t_m: [736] f32; keys_t_f: [736] f32; keys_r: [24250] f32;
}
people_load :: (d: [] People) {
  d[0].parent = PEOPLE_PARENT;
  d[0].rest_m = PEOPLE_REST_M;
  d[0].rest_f = PEOPLE_REST_F;
  d[0].bind_m = PEOPLE_BIND_M;
  d[0].bind_f = PEOPLE_BIND_F;
  d[0].duration = PEOPLE_DURATION;
  d[0].distance = PEOPLE_DISTANCE;
  d[0].track_t = PEOPLE_TRACK_T;
  d[0].track_r = PEOPLE_TRACK_R;
  d[0].keys_t_m = PEOPLE_KEYS_T_M;
  d[0].keys_t_f = PEOPLE_KEYS_T_F;
  d[0].keys_r = PEOPLE_KEYS_R;
}
// Body 0 is the male skeleton, 1 the female; they share the clips' rotations.
people_rig :: (d: [] People, female: bool) -> SkinRig {
  if female {
    return SkinRig.{joints = PEOPLE_JOINTS, clips = PEOPLE_CLIPS, parent = d[0].parent[..], rest = d[0].rest_f[..], bind = d[0].bind_f[..],
                    duration = d[0].duration[..], distance = d[0].distance[..], track_t = d[0].track_t[..],
                    track_r = d[0].track_r[..], keys_t = d[0].keys_t_f[..], keys_r = d[0].keys_r[..]};
  }
  return SkinRig.{joints = PEOPLE_JOINTS, clips = PEOPLE_CLIPS, parent = d[0].parent[..], rest = d[0].rest_m[..], bind = d[0].bind_m[..],
                  duration = d[0].duration[..], distance = d[0].distance[..], track_t = d[0].track_t[..],
                  track_r = d[0].track_r[..], keys_t = d[0].keys_t_m[..], keys_r = d[0].keys_r[..]};
}
