// What every one of them knows of the city (docs/verse/everglade.md).
EG_CITY :: "Everglade is a city in a forest. Its old town stands inside a log palisade with four gates; the South Gate faces the road in, past the stables. In the middle of the old town is the commons with its fountain and the quest board. East of it is the market with its stalls and the general store; west, on Inn Street, the inn; north-west, Guild Row with the fighters' and rangers' halls and the smithy and the alchemist; north-east, the mages' tower; north, the temple and, beyond it, the observatory. Outside the palisade the Commons Loop runs all the way round the old town. South of it is the Great Lawn with the Reed and Lantern Ponds and the boathouse. North, Main Street has its shops and the Market Hall, with Stoop Lane off it. East, on Foundry Road, is the Foundry; north-east, on Studio Road, the Makers' Quarter; south-east, on Library Way, the Scholars' Quarter with the Stacks and the Old College. Across the bridge over the river, Lantern Road runs to the Lantern Quarter with its Music Hall, and to Brownstone Row. Trails lead out through the woods to the deep wood, the ruins, the crypt and the far ponds.";

// What the person at spot i does: their role, or for a cat (no role of their own) a cat's.
eg_words_role :: (i: int) -> string { return ifx i < 0 || i >= EG_PEOPLE then "" else ifx EG_ROLE[i].count == 0 then EG_CAT_ROLE else EG_ROLE[i]; }
// The id of the person at spot i (talk_id of their name); its length, 0 for no such spot.
eg_person_id :: (i: int, out: [] u8) -> int { return ifx i < 0 || i >= EG_PEOPLE then 0 else talk_id(EG_PERSON[i], out); }
// The person whose id is id, -1 none.
eg_person_of :: (id: string) -> int {
  for i: 0..<EG_PEOPLE {
    b: [64] u8; n := eg_person_id(i, b[..]);
    if n > 0 && cast(string) b[0..<n] == id { return i; }
  }
  return -1;
}

#test "every person has a name, a greeting and an id of their own" {
  for i: 0..<EG_PEOPLE {
    #assert EG_PERSON[i].count > 0 && EG_GREET[i].count > 0;
    b: [64] u8; n := eg_person_id(i, b[..]);
    #assert n > 0 && eg_person_of(cast(string) b[0..<n]) == i;
  }
  #assert eg_person_of("brother-anselm") == 17 && eg_person_of("marta") == 5 && eg_person_of("nobody") == -1;
}
