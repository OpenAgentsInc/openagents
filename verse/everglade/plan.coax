EG_PLACE_NAME :: [13] string.[
  "THE COMMONS", "THE MARKET", "GUILD ROW", "TEMPLE HILL", "THE OBSERVATORY", "INN STREET",
  "THE ROAD IN", "THE DEEP WOOD", "THE RUINS", "THE CRYPT", "THE RIVER CROSSING", "SOUTH GATE", "NORTH GATE"
