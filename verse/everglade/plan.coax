EG_PROP_NAME :: [15] string.[
  "FOUNTAIN", "QUEST BOARD", "STALL", "STALL", "STALL", "STALL", "STALL", "STALL",
  "WAYSTONE", "RUINED PILLAR", "RUINED PILLAR", "RUINED PILLAR", "CRYPT", "RIVER", "RIVER"
