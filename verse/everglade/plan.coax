// days; this is where each one's day starts.
EG_SPOTS :: 22;
EG_SPOT :: [66] f32.[
  -4.5, -59.5, 3.14,    4.5, -59.5, 3.14,     5.0, -72.0, -1.57,
  3.2, -6.4, -0.6,      -3.6, 4.6, 0.0,
  -3.4, -37.0, 1.57,    -3.4, -33.5, 1.57,
  28.0, 7.9, 3.14,      26.0, 8.0, 3.14,      32.0, -8.0, 0.0,     38.0, 8.0, 3.14,
  50.0, 6.0, 3.14,      49.0, -6.0, 0.0,
  -37.0, 4.0, 3.14,     -37.0, -4.0, 0.0,
  -27.0, 34.0, 3.14,    -24.5, 34.2, 3.14,
  0.0, 32.0, 3.14,      28.0, 38.0, 3.14,
  -88.0, 18.0, 1.57,    91.5, -19.5, 0.0,     21.0, 89.0, 0.0
];
EG_SPOT_NAME :: [22] string.[
  "GATE GUARD", "GATE GUARD", "STABLE HAND",
  "TOWN CRIER", "ERRAND CAT",
  "INNKEEPER", "INN CAT",
  "SHOPKEEPER", "FRUIT SELLER", "CLOTH SELLER", "TRINKET SELLER",
  "SMITH", "ALCHEMIST",
  "FIGHTERS' MASTER", "RANGERS' WARDEN",
  "ARCHMAGE", "GUILD FAMILIAR",
  "PRIEST", "ASTRONOMER",
  "WOODWARDEN", "FERRYMAN", "RUIN SCHOLAR"
];
EG_SPOT_CAT :: [22] bool.[
  false, false, false, false, true, false, true, false, false, false, false,
  false, false, false, false, false, true, false, false, false, false, false
];

// You arrive on the road in, south of the gate, facing it.
EG_SPAWN_X :: 0.0; EG_SPAWN_Z :: -84.0;

// ---- the ground

everglade_ground :: () -> Ground {
  g: Ground;
  g.n = EG_CELLS; g.cell = EG_CELL; g.west = EG_EDGE; g.south = EG_EDGE;
  g.rim_from = EG_RIM_FROM; g.rim = EG_RIM;
  return g;
}
EG_GROUND_POINTS :: (EG_CELLS + 1) * (EG_CELLS + 1);

// Level ground (terrain.coax FLAT: x, z, radius, level): the commons, the
// market square, the temple's forecourt, and one under each building at
// the street's level there.
EG_SQUARES :: 3;
EG_SQUARE :: [12] f32.[0, 0, 16, 0,   34, 0, 13, 0,   0, 31, 9, 0];
EG_FLATS :: EG_SQUARES + EG_BUILDINGS;

everglade_flats :: (out: [] f32) -> int {
  if out.count < EG_FLATS * FLAT { return 0; }
  for i: 0..<EG_SQUARES * FLAT { out[i] = EG_SQUARE[i]; }
  for b: 0..<EG_BUILDINGS {
    k := b * EG_BOX;
    x := (EG_BUILDING[k] + EG_BUILDING[k + 2]) / 2; z := (EG_BUILDING[k + 1] + EG_BUILDING[k + 3]) / 2;
    dx := EG_BUILDING[k + 2] - EG_BUILDING[k]; dz := EG_BUILDING[k + 3] - EG_BUILDING[k + 1];
    o := (EG_SQUARES + b) * FLAT;
    out[o] = x; out[o + 1] = z; out[o + 2] = sqrt(dx * dx + dz * dz) / 2 + 1;
    out[o + 3] = hills_rim(x, z, f32(EG_RIM_FROM), f32(EG_RIM)) * f32(PATH_LEVEL);
  }
  return EG_FLATS;
}

everglade_build_ground :: (heights: [] f32) -> bool {
  nodes := EG_NODE_XZ; links := EG_LINK_AB;
  flats: [EG_FLATS * FLAT] f32;
  made := everglade_flats(flats[..]);
  if made == 0 { return false; }
  if !verse_terrain_build(everglade_ground(), heights, nodes[..], links[..], f32(EG_PATH_HALF), flats[..]) { return false; }
  everglade_carve_river(heights);
  everglade_carve_ponds(heights);
  return true;
}

// ---- the ponds (docs/verse/water.md, W3: the previous Everglade's four, verse/everglade/previous/water.md
// "Owner decisions" 1): each a bowl carved into the ground off a trail, in its own clearing, its water a
// verse/water.coax pond body at a still level (verse/everglade/river.coax). The level is 0.25 m under
// the lowest ground 5 m past its rim; the bed falls from 0.25 m over the level at the rim to the pond's
// depth under it at the middle, and past the rim climbs 0.7 in 1 to the ground.
EG_PONDS :: 4;
EG_POND_LANTERN :: 0; EG_POND_REED :: 1; EG_POND_THINKING :: 2; EG_POND_FERN :: 3;
// x, z, rim radius, depth at the middle under the level; then each one's clearing's radius, which
// reaches the open corridor of the trail beside it
EG_POND :: [16] f32.[
  -77, -11, 6.0, 3.0,
  14, -90, 5.0, 1.6,
  28, 73, 5.5, 2.5,
  -79, 21, 5.0, 2.0
];
EG_POND_OPEN :: [4] f32.[12.5, 12.5, 9.5, 12.0];
EG_POND_NAME :: [4] string.["LANTERN POND", "REED POND", "THE THINKING POND", "THE FERN POND"];
EG_POND_ID :: [4] string.["lantern-pond", "reed-pond", "thinking-pond", "fern-pond"];   // the hash that starts you at its bank
EG_POND_BANK :: 0.25;
EG_POND_CLIMB :: 0.7;
// The pond's level over the ground as built (before or after its carve: the carve leaves the ring it reads).
everglade_pond_level :: (heights: [] f32, p: int) -> f32 {
  x := EG_POND[p * 4]; z := EG_POND[p * 4 + 1]; r := EG_POND[p * 4 + 2] + 5;
  low := 1000000.0f32;
  for k: 0..<24 {
    a := f32(k) / 24 * 6.2831853;
    low = lo(low, verse_terrain_height(everglade_ground(), heights, x + r * cos(a), z + r * sin(a)));
  }
  return low - f32(EG_POND_BANK);
}
// The bed d metres from the middle of pond p under its level.
everglade_pond_bed :: (p: int, level: f32, d: f32) -> f32 {
  r := EG_POND[p * 4 + 2]; depth := EG_POND[p * 4 + 3];
  bank := f32(EG_POND_BANK);
  if d < r { t := d / r; return level + bank - (depth + bank) * (1 - t * t); }
  return level + bank + (d - r) * f32(EG_POND_CLIMB);
}
everglade_carve_ponds :: (heights: [] f32) {
  w := EG_CELLS + 1;
  for p: 0..<EG_PONDS {
    level := everglade_pond_level(heights, p);
    x := EG_POND[p * 4]; z := EG_POND[p * 4 + 1]; reach := EG_POND[p * 4 + 2] + 6;
    for j: 0..<w {
      gz := f32(EG_EDGE) + f32(j) * f32(EG_CELL);
      if abs(gz - z) > reach { continue; }
      for i: 0..<w {
        gx := f32(EG_EDGE) + f32(i) * f32(EG_CELL);
        d := sqrt((gx - x) * (gx - x) + (gz - z) * (gz - z));
        if d > reach { continue; }
        heights[j * w + i] = lo(heights[j * w + i], everglade_pond_bed(p, level, d));
      }
    }
  }
}
// x, z, rim radius and level of each pond, 4 numbers each (the face builds their bodies from them).
everglade_pond_rows :: (heights: [] f32, out: [] f32) {
  if out.count < EG_PONDS * 4 { return; }
  for p: 0..<EG_PONDS {
    out[p * 4] = EG_POND[p * 4]; out[p * 4 + 1] = EG_POND[p * 4 + 1]; out[p * 4 + 2] = EG_POND[p * 4 + 2];
    out[p * 4 + 3] = everglade_pond_level(heights, p);
  }
}
// Whether (x, z) is within `pad` of a pond's rim: no tree stands there.
everglade_in_pond :: (x: f32, z: f32, pad: f32) -> bool {
  for p: 0..<EG_PONDS {
    dx := x - EG_POND[p * 4]; dz := z - EG_POND[p * 4 + 1]; r := EG_POND[p * 4 + 2] + pad;
    if dx * dx + dz * dz < r * r { return true; }
  }
  return false;
}

// ---- the river (docs/verse/water.md W3): a channel carved along x = 88
// from the north edge to the south, its water one verse/water.coax river
// body (verse/everglade/river.coax). Its level falls from north to south,
// never rising and always 0.2 m under the lowest ground it runs through,
// so the water stays in its bed; the bed is a V 2.2 m under the level at
// the middle and 0.25 m under it at the banks, 2 m out either side, and
// past them it climbs one in one until it meets the ground (in the south
// woods, where the ground rises, a ravine).
EG_RIVER_X :: 88.0;
EG_RIVER_HALF :: 2.0;     // the banks, metres from the middle
EG_RIVER_DEPTH :: 2.2;    // under the level at the middle
EG_RIVER_RIM :: 0.25;     // under the level at the banks
EG_RIVER_FALL :: 0.008;   // the least the level falls each ground row (2 m)
EG_RIVER_FREEBOARD :: 0.2;
EG_RIVER_COL :: 96;       // the ground's column at x = 88
// The weir (Glade Run's, from the old W3): the level steps down 0.25 m more
// between the ground row at z = -30 and the next downstream, over a stone
// sill, into a plunge pool 1.6 m deeper than the channel at its middle,
// 2.5 m round, centred 3 m below the sill (river.coax WEIR_Z, POOL_*).
EG_WEIR_Z :: -30.0;
EG_WEIR_DROP :: 0.25;
EG_POOL_Z :: -33.0;
EG_POOL_R :: 2.5;
EG_POOL_DEEP :: 1.6;

// The level over each ground row (z = EG_EDGE + j EG_CELL) of the ground
// as built, before the carve.
everglade_river_levels_of :: (heights: [] f32, levels: [] f32) {
  w := EG_CELLS + 1;
  if levels.count < w || heights.count < EG_GROUND_POINTS { return; }
  above := 1000000.0f32;
  for k: 0..<w {
    j := EG_CELLS - k;
    low := 1000000.0f32;
    for i: EG_RIVER_COL - 4..<EG_RIVER_COL + 5 { low = lo(low, heights[j * w + i]); }
    // the weir: the row just below it steps down by the drop as well
    z := f32(EG_EDGE) + f32(j) * f32(EG_CELL);
    weir := ifx z < f32(EG_WEIR_Z) && z + f32(EG_CELL) >= f32(EG_WEIR_Z) then f32(EG_WEIR_DROP) else 0.0f32;
    levels[j] = lo(above - f32(EG_RIVER_FALL) - weir, low - f32(EG_RIVER_FREEBOARD));
    above = levels[j];
  }
}

// The level over each row of the carved ground: the middle's bed and the depth.
everglade_river_levels :: (heights: [] f32, levels: [] f32) #export_c {
  w := EG_CELLS + 1;
  if levels.count < w || heights.count < EG_GROUND_POINTS { return; }
  for j: 0..<w { levels[j] = heights[j * w + EG_RIVER_COL] + f32(EG_RIVER_DEPTH) + everglade_pool_deepen(f32(EG_RIVER_X), f32(EG_EDGE) + f32(j) * f32(EG_CELL)); }
}

// How much deeper than the channel the plunge pool is at (x, z): a bowl,
// EG_POOL_DEEP at its middle and none at its edge.
everglade_pool_deepen :: (x: f32, z: f32) -> f32 #export_c {
  dx := x - f32(EG_RIVER_X); dz := z - f32(EG_POOL_Z);
  t := (dx * dx + dz * dz) / (f32(EG_POOL_R) * f32(EG_POOL_R));
  return ifx t < 1 then f32(EG_POOL_DEEP) * (1 - t) else 0.0f32;
}

// The bed's height d metres from the middle under a level.
river_section :: (level: f32, d: f32) -> f32 {
  half := f32(EG_RIVER_HALF);
  if d <= half { return level - f32(EG_RIVER_RIM) - (f32(EG_RIVER_DEPTH) - f32(EG_RIVER_RIM)) * (1 - d / half); }
  return level - f32(EG_RIVER_RIM) + (d - half);
}

everglade_carve_river :: (heights: [] f32) {
  w := EG_CELLS + 1;
  levels: [EG_CELLS + 1] f32;
  everglade_river_levels_of(heights, levels[..]);
  for j: 0..<w {
    for i: 0..<w {
      x := f32(EG_EDGE) + f32(i) * f32(EG_CELL);
      d := abs(x - f32(EG_RIVER_X));
      if d > 30 { continue; }
      z := f32(EG_EDGE) + f32(j) * f32(EG_CELL);
      heights[j * w + i] = lo(heights[j * w + i], river_section(levels[j], d) - everglade_pool_deepen(x, z));
    }
  }
}

// Whether x is within `pad` of the river's water (3 m either side of its
// middle, verse/everglade/river.coax's outline): no tree stands in it.
everglade_in_river :: (x: f32, pad: f32) -> bool { return abs(x - f32(EG_RIVER_X)) < 3 + pad; }

// Where you walk: the ground, or the bridge's deck where it spans the
// river. The deck's top is 0.1 m over the trail's ground at its ends,
// where the carve has left the ground as it was.
EG_DECK :: 0.1;
everglade_deck :: (heights: [] f32) -> f32 {
  if heights.count < EG_GROUND_POINTS { return 0; }
  w := EG_CELLS + 1;
  j := cast(int) ((-11.5 - f32(EG_EDGE)) / f32(EG_CELL));
  return (heights[j * w + EG_RIVER_COL - 2] + heights[j * w + EG_RIVER_COL + 2]) / 2 + f32(EG_DECK);
}
everglade_walk_height :: (heights: [] f32, deck: f32, x: f32, z: f32) -> f32 {
  h := verse_terrain_height(everglade_ground(), heights, x, z);
  if x >= EG_BRIDGE[0] && x <= EG_BRIDGE[2] && z >= EG_BRIDGE[1] && z <= EG_BRIDGE[3] { return hi(h, deck); }
  return h;
}

// ---- what stands in the way

// Every box a walker can't pass, five numbers each: the palisade, the
// buildings, the solid props, and the edge of the world. Returns how many.
EG_SOLIDS :: EG_PALISADE_N + EG_BUILDINGS + 4 * EG_INTERIORS + EG_RIVER + 4;
everglade_solids :: (out: [] f32) -> int {
  bld := EG_BUILDING;
  pal := EG_PALISADE;
  prp := EG_PROP;
  n := 0;
  for i: 0..<EG_PALISADE_N { n = put_box(out, n, pal[..], i); }
  for i: 0..<EG_BUILDINGS {
    if !EG_INTERIOR[i] { n = put_box(out, n, bld[..], i); continue; }
    n = put_walls(out, n, i);
  }
  // The river's banks are in the props for the map, but you may wade and
  // swim in it (verse/everglade/river.coax): they stand in no one's way.
  for i: 0..<EG_PROPS { if i < EG_RIVER { n = put_box(out, n, prp[..], i); } }
  b := f32(EG_BOUND);
  edges := [20] f32.[-b - 4, -b - 4, b + 4, -b, 12,   -b - 4, b, b + 4, b + 4, 12,   -b - 4, -b, -b, b, 12,   b, -b, b + 4, b, 12];
  for i: 0..<4 { n = put_box(out, n, edges[..], i); }
  return n;
}

// Where a building's door is: the side that faces its door spot (0 the low
// z side, 1 the high z side, 2 the low x side, 3 the high x side) and the
// middle of the 2 m wall module nearest the spot along it.
Door :: struct { side: int; along: f32; }
everglade_door :: (b: int) -> Door {
  k := b * EG_BOX;
  x0 := EG_BUILDING[k]; z0 := EG_BUILDING[k + 1]; x1 := EG_BUILDING[k + 2]; z1 := EG_BUILDING[k + 3];
  dx := EG_DOOR[b * 2]; dz := EG_DOOR[b * 2 + 1];
  d: Door;
  if dz < z0 { d.side = 0; } else if dz > z1 { d.side = 1; } else if dx < x0 { d.side = 2; } else { d.side = 3; }
  from := ifx d.side < 2 then x0 else z0;
  to := ifx d.side < 2 then x1 else z1;
  at := ifx d.side < 2 then dx else dz;
  m := f32(EG_MODULE);
  i := floor((at - from) / m);
  i = clamp(i, 0, (to - from) / m - 1);
  d.along = from + (i + 0.5) * m;
  return d;
}

// A walk-in building's walls: four 0.4 m walls, the door's in two pieces
// either side of the doorway.
put_walls :: (out: [] f32, n: int, b: int) -> int {
  k := b * EG_BOX;
  x0 := EG_BUILDING[k]; z0 := EG_BUILDING[k + 1]; x1 := EG_BUILDING[k + 2]; z1 := EG_BUILDING[k + 3]; h := EG_BUILDING[k + 4];
  t := f32(EG_WALL); g := f32(EG_DOORWAY) / 2;
  d := everglade_door(b);
  walls := [20] f32.[x0, z0, x1, z0 + t, h,   x0, z1 - t, x1, z1, h,   x0, z0, x0 + t, z1, h,   x1 - t, z0, x1, z1, h];
  m := n;
  for w: 0..<4 {
    if w != d.side { m = put_box(out, m, walls[..], w); continue; }
    a := w * EG_BOX;
    one := [10] f32.[0, 0, 0, 0, h,  0, 0, 0, 0, h];
    for q: 0..<4 { one[q] = walls[a + q]; one[5 + q] = walls[a + q]; }
    if w < 2 { one[2] = d.along - g; one[5] = d.along + g; } else { one[3] = d.along - g; one[6] = d.along + g; }
    m = put_box(out, m, one[..], 0);
    m = put_box(out, m, one[..], 1);
  }
  return m;
}

put_box :: (out: [] f32, n: int, from: [] f32, i: int) -> int {
  if (n + 1) * EG_BOX > out.count || (i + 1) * EG_BOX > from.count { return n; }
  for k: 0..<EG_BOX { out[n * EG_BOX + k] = from[i * EG_BOX + k]; }
  return n + 1;
}

// How far a point is from a box's footprint (0 inside).
box_gap :: (box: [] f32, i: int, x: f32, z: f32) -> f32 {
  k := i * EG_BOX;
  dx := hi(hi(box[k] - x, x - box[k + 2]), 0);
  dz := hi(hi(box[k + 1] - z, z - box[k + 3]), 0);
  return sqrt(dx * dx + dz * dz);
}

// The gap between two footprints (0 when they touch or overlap).
boxes_gap :: (a: [] f32, i: int, b: [] f32, j: int) -> f32 {
  p := i * EG_BOX; q := j * EG_BOX;
  dx := hi(hi(b[q] - a[p + 2], a[p] - b[q + 2]), 0);
  dz := hi(hi(b[q + 1] - a[p + 3], a[p + 1] - b[q + 3]), 0);
  return sqrt(dx * dx + dz * dz);
}

// The least gap between a link's centre line and a box's footprint.
link_box_gap :: (a: int, b: int, box: [] f32, i: int) -> f32 {
  ax := EG_NODE_XZ[a * 2]; az := EG_NODE_XZ[a * 2 + 1];
  bx := EG_NODE_XZ[b * 2]; bz := EG_NODE_XZ[b * 2 + 1];
  d := sqrt((bx - ax) * (bx - ax) + (bz - az) * (bz - az));
  steps := cast(int) (d / 0.2) + 1;
  least := 1000000.0f32;
  for s: 0..<steps + 1 {
    t := f32(s) / f32(steps);
    least = lo(least, box_gap(box, i, lerp(ax, bx, t), lerp(az, bz, t)));
  }
  return least;
}

inside_walls :: (box: [] f32, i: int) -> bool {
  k := i * EG_BOX;
  return box[k] > -63.6 && box[k + 2] < 63.6 && box[k + 1] > -55.6 && box[k + 3] < 59.6;
}

// ---- the woods: past a clear apron round the palisade the forest stands,
// but for the trails (EG_TRAIL_FREE either side of a link's middle: its 3 m
// and a verge) and the clearings where they end. The realm plants its trees
// only in the woods; you walk among them (round their trunks: everglade.coax
// forest_bodies), while the city's people and an admin's placings keep to
// the open ground (the reach grid below).
EG_APRON :: 6.0;        // metres of open grass outside the palisade
EG_TRAIL_FREE :: 3.0;
EG_CLEARINGS :: 6;
// x, z, radius each: the stables, where you arrive, the deep wood's
// waystone, the ruins, the crypt and the river's far bank.
EG_CLEARING :: [18] f32.[
  14, -70, 11,    0, -88, 7,    -91, 20, 9,    22, 94, 12,    66, 92, 9,    93, -13, 8
];

// The river's glade: x, z of its middle and its half widths across and along.
EG_GLADE :: [4] f32.[88, -14, 7, 26];
everglade_in_woods :: (x: f32, z: f32) -> bool {
  a := f32(EG_APRON);
  if x > -65.25 - a && x < 65.25 + a && z > -57.5 - a && z < 61.25 + a { return false; }
  for c: 0..<EG_CLEARINGS {
    dx := x - EG_CLEARING[c * 3]; dz := z - EG_CLEARING[c * 3 + 1]; r := EG_CLEARING[c * 3 + 2];
    if dx * dx + dz * dz < r * r { return false; }
  }
  // The river's glade either side of the bridge, where you may swim across.
  gx := (x - EG_GLADE[0]) / EG_GLADE[2]; gz := (z - EG_GLADE[1]) / EG_GLADE[3];
  if gx * gx + gz * gz < 1 { return false; }
  // each pond's clearing, open to the trail beside it
  for p: 0..<EG_PONDS {
    px := EG_POND[p * 4]; pz := EG_POND[p * 4 + 1]; r := EG_POND_OPEN[p];
    if (x - px) * (x - px) + (z - pz) * (z - pz) < r * r { return false; }
  }
  nodes := EG_NODE_XZ; links := EG_LINK_AB;
  return verse_path_nearest(nodes[..], links[..], x, z).d >= f32(EG_TRAIL_FREE);
}

// ---- reachability: a grid over the walkable ground, filled from the spawn

EG_REACH_CELL :: 0.5;
EG_REACH_N :: 400;      // cells a side: the world inside the edge
EG_REACH_WEST :: -100.0;

reach_index :: (x: f32, z: f32) -> int {
  i := cast(int) floor((x - f32(EG_REACH_WEST)) / f32(EG_REACH_CELL));
  j := cast(int) floor((z - f32(EG_REACH_WEST)) / f32(EG_REACH_CELL));
  if i < 0 || j < 0 || i >= EG_REACH_N || j >= EG_REACH_N { return -1; }
  return j * EG_REACH_N + i;
}

// Marks the cells a walker's middle may stand on: 1 open, 0 in the way
// (a solid widened by the walker's radius and half a cell, so a cell
// marked open is open all over).
everglade_open :: (grid: [] u8) {
  solids: [EG_SOLIDS * EG_BOX] f32;
  n := everglade_solids(solids[..]);
  pad := f32(EG_RADIUS) + f32(EG_REACH_CELL) * 0.71;
  for j: 0..<EG_REACH_N {
    for i: 0..<EG_REACH_N {
      x := f32(EG_REACH_WEST) + (f32(i) + 0.5) * f32(EG_REACH_CELL);
      z := f32(EG_REACH_WEST) + (f32(j) + 0.5) * f32(EG_REACH_CELL);
      grid[j * EG_REACH_N + i] = 1; if everglade_in_woods(x, z) { grid[j * EG_REACH_N + i] = 0; }
    }
  }
  for s: 0..<n {
    k := s * EG_BOX;
    i0 := cast(int) floor((solids[k] - pad - f32(EG_REACH_WEST)) / f32(EG_REACH_CELL));
    i1 := cast(int) floor((solids[k + 2] + pad - f32(EG_REACH_WEST)) / f32(EG_REACH_CELL));
    j0 := cast(int) floor((solids[k + 1] - pad - f32(EG_REACH_WEST)) / f32(EG_REACH_CELL));
    j1 := cast(int) floor((solids[k + 3] + pad - f32(EG_REACH_WEST)) / f32(EG_REACH_CELL));
    for j: hi_i(j0, 0)..<lo_i(j1 + 1, EG_REACH_N) {
      for i: hi_i(i0, 0)..<lo_i(i1 + 1, EG_REACH_N) {
        x := f32(EG_REACH_WEST) + (f32(i) + 0.5) * f32(EG_REACH_CELL);
        z := f32(EG_REACH_WEST) + (f32(j) + 0.5) * f32(EG_REACH_CELL);
        if box_gap(solids[..], s, x, z) < pad { grid[j * EG_REACH_N + i] = 0; }
      }
    }
  }
}

hi_i :: (a: int, b: int) -> int { if a > b { return a; } return b; }
lo_i :: (a: int, b: int) -> int { if a < b { return a; } return b; }

// Fills from the spawn, breadth first: 2 every open cell a walker gets
// to. Returns how many.
everglade_reach :: (grid: [] u8, queue: [] u32) -> int {
  everglade_open(grid);
  return everglade_fill(grid, queue);
}
// The fill over a grid already marked (everglade_open, and an admin's edits on it: edits.coax).
everglade_fill :: (grid: [] u8, queue: [] u32) -> int {
  N := EG_REACH_N;
  start := reach_index(f32(EG_SPAWN_X), f32(EG_SPAWN_Z));
  if start < 0 || grid[start] != 1 || queue.count < N * N { return 0; }
  grid[start] = 2;
  queue[0] = cast(u32) start;
  head := 0; tail := 1;
  while head < tail {
    c := cast(int) queue[head];
    head += 1;
    i := c % N;
    if i > 0 && grid[c - 1] == 1 { grid[c - 1] = 2; queue[tail] = cast(u32) (c - 1); tail += 1; }
    if i < N - 1 && grid[c + 1] == 1 { grid[c + 1] = 2; queue[tail] = cast(u32) (c + 1); tail += 1; }
    if c >= N && grid[c - N] == 1 { grid[c - N] = 2; queue[tail] = cast(u32) (c - N); tail += 1; }
    if c < N * N - N && grid[c + N] == 1 { grid[c + N] = 2; queue[tail] = cast(u32) (c + N); tail += 1; }
  }
  return tail;
}

reached :: (grid: [] u8, x: f32, z: f32) -> bool {
  c := reach_index(x, z);
  return c >= 0 && grid[c] == 2;
}

// ---- checks

#test "nothing overlaps: buildings keep apart, inside the palisade, off the streets" {
  bld := EG_BUILDING;
  pal := EG_PALISADE;
  prp := EG_PROP;
  for i: 0..<EG_BUILDINGS {
    k := i * EG_BOX;
    #assert EG_BUILDING[k] < EG_BUILDING[k + 2] && EG_BUILDING[k + 1] < EG_BUILDING[k + 3] && EG_BUILDING[k + 4] > 2;
    for j: i + 1..<EG_BUILDINGS { #assert boxes_gap(bld[..], i, bld[..], j) >= f32(EG_GAP); }
    for p: 0..<EG_PALISADE_N { #assert boxes_gap(bld[..], i, pal[..], p) >= f32(EG_GAP); }
    for p: 0..<EG_PROPS { #assert boxes_gap(bld[..], i, prp[..], p) >= f32(EG_PROP_GAP); }
    // Only the stables stand outside, on the road in.
    #assert inside_walls(bld[..], i) == (i != EG_STABLES);
  }
  for i: 0..<EG_PROPS {
    for j: i + 1..<EG_PROPS { #assert boxes_gap(prp[..], i, prp[..], j) >= f32(EG_PROP_GAP); }
    for p: 0..<EG_PALISADE_N { #assert boxes_gap(prp[..], i, pal[..], p) >= f32(EG_GAP); }
  }
  // The palisade's pieces meet but never overlap.
  for i: 0..<EG_PALISADE_N {
    for j: i + 1..<EG_PALISADE_N {
      p := i * EG_BOX; q := j * EG_BOX;
      ox := lo(EG_PALISADE[p + 2], EG_PALISADE[q + 2]) - hi(EG_PALISADE[p], EG_PALISADE[q]);
      oz := lo(EG_PALISADE[p + 3], EG_PALISADE[q + 3]) - hi(EG_PALISADE[p + 1], EG_PALISADE[q + 1]);
      #assert ox <= 0.0001 || oz <= 0.0001;
    }
  }
}

#test "the streets and trails keep clear of everything in the way" {
  solids: [EG_SOLIDS * EG_BOX] f32;
  n := everglade_solids(solids[..]);
  #assert n == EG_SOLIDS;
  for l: 0..<EG_LINKS {
    a := EG_LINK_AB[l * 2]; b := EG_LINK_AB[l * 2 + 1];
    for s: 0..<n { #assert link_box_gap(a, b, solids[..], s) >= f32(EG_PATH_HALF) + f32(EG_CLEAR); }
  }
}

#test "the paths connect: one network, through every gate and over the bridge" {
  seen: [EG_NODES] bool;
  for k: 0..<EG_NODES { seen[k] = false; }
  seen[EG_SOUTH_GATE_NODE] = true;
  more := true;
  while more {
    more = false;
    for l: 0..<EG_LINKS {
      a := EG_LINK_AB[l * 2]; b := EG_LINK_AB[l * 2 + 1];
      #assert a >= 0 && b >= 0 && a < EG_NODES && b < EG_NODES && a != b;
      if seen[a] != seen[b] { seen[a] = true; seen[b] = true; more = true; }
    }
  }
  for k: 0..<EG_NODES { #assert seen[k]; }
  #assert EG_NODES <= MAX_NODES;
  // Each gate has a link through the middle of its gap.
  for g: 0..<EG_GATES {
    gx := EG_GATE[g * 4]; gz := EG_GATE[g * 4 + 1];
    nodes := EG_NODE_XZ; links := EG_LINK_AB;
    #assert verse_path_nearest(nodes[..], links[..], gx, gz).d < 0.01;
  }
  // The river trail crosses on the bridge.
  nodes := EG_NODE_XZ; links := EG_LINK_AB;
  for k: 0..<9 {
    z := -15.0 + f32(k);
    p := verse_path_nearest(nodes[..], links[..], 88, z);
    if p.d < 0.01 { #assert z > EG_BRIDGE[1] + f32(EG_PATH_HALF) && z < EG_BRIDGE[3] - f32(EG_PATH_HALF); }
  }
}

#test "everything is reachable on foot from the road in" {
  bld := EG_BUILDING;
  grid: [EG_REACH_N * EG_REACH_N] u8;
  queue: [EG_REACH_N * EG_REACH_N] u32;
  count := everglade_reach(grid[..], queue[..]);
  #assert count > 60000;
  for b: 0..<EG_BUILDINGS { #assert reached(grid[..], EG_DOOR[b * 2], EG_DOOR[b * 2 + 1]); }
  for b: 0..<EG_BUILDINGS { #assert box_gap(bld[..], b, EG_DOOR[b * 2], EG_DOOR[b * 2 + 1]) <= 1.01; }
  // Inside each walk-in building, its middle and the far corners of its room are reached through the door.
  for b: 0..<EG_BUILDINGS {
    if !EG_INTERIOR[b] { continue; }
    k := b * EG_BOX;
    x0 := EG_BUILDING[k]; z0 := EG_BUILDING[k + 1]; x1 := EG_BUILDING[k + 2]; z1 := EG_BUILDING[k + 3];
    #assert reached(grid[..], (x0 + x1) / 2, (z0 + z1) / 2);
    #assert reached(grid[..], x0 + 1.2, z0 + 1.2) && reached(grid[..], x1 - 1.2, z1 - 1.2);
    // and nowhere else: the wall beside the doorway is shut
    d := everglade_door(b);
    if d.side < 2 { #assert !reached(grid[..], d.along + 1.6, ifx d.side == 0 then z0 + 0.2 else z1 - 0.2); }
    else { #assert !reached(grid[..], ifx d.side == 2 then x0 + 0.2 else x1 - 0.2, d.along + 1.6); }
  }
  for s: 0..<EG_SPOTS { #assert reached(grid[..], EG_SPOT[s * 3], EG_SPOT[s * 3 + 1]); }
  for k: 0..<EG_NODES { #assert reached(grid[..], EG_NODE_XZ[k * 2], EG_NODE_XZ[k * 2 + 1]); }
  for g: 0..<EG_GATES { #assert reached(grid[..], EG_GATE[g * 4], EG_GATE[g * 4 + 1]); }
  // The quest board, the stalls and the trails' ends are reachable from beside them.
  #assert reached(grid[..], 6.2, -6.4) && reached(grid[..], 32, 3.5) && reached(grid[..], 32, -3.5);
  #assert reached(grid[..], -88, 22) && reached(grid[..], 22, 95) && reached(grid[..], 66, 89.5) && reached(grid[..], 96, -16);
}

#test "the open ground: past the apron only a trail or a clearing is, where the people walk and an admin places" {
  grid: [EG_REACH_N * EG_REACH_N] u8;
  queue: [EG_REACH_N * EG_REACH_N] u32;
  count := everglade_reach(grid[..], queue[..]);
  #assert count > 60000;
  nodes := EG_NODE_XZ; links := EG_LINK_AB;
  deep := 0;
  for j: 0..<EG_REACH_N {
    for i: 0..<EG_REACH_N {
      x := f32(EG_REACH_WEST) + (f32(i) + 0.5) * f32(EG_REACH_CELL);
      z := f32(EG_REACH_WEST) + (f32(j) + 0.5) * f32(EG_REACH_CELL);
      if everglade_in_woods(x, z) { deep += 1; #assert grid[j * EG_REACH_N + i] == 0; }
    }
  }
  // Most of what lies outside the walls is forest.
  #assert deep > 60000;
  // Straight out from each wall, between the gates, the forest stops you within the apron.
  #assert !reached(grid[..], -40, -64.5) && !reached(grid[..], 40, 69) && !reached(grid[..], 72.5, 30) && !reached(grid[..], -72.5, -30);
  #assert reached(grid[..], -40, -60) && reached(grid[..], 70, 30);
  // The far bank is reached by the bridge, and the forest beyond it is not.
  #assert reached(grid[..], 96, -16) && !reached(grid[..], 95, 40);
  // In the glade you may wade and swim across beside the bridge; up and down
  // the river past it the forest closes in on both banks.
  #assert reached(grid[..], 88, -30) && reached(grid[..], 88, 4) && reached(grid[..], 84, -34) && reached(grid[..], 92, -34);
  #assert !reached(grid[..], 88, -60) && !reached(grid[..], 88, 40) && !reached(grid[..], 88, -95) && !reached(grid[..], 88, 95);
  // Each trail stays open from its gate to its end.
  #assert reached(grid[..], -80, 4) && reached(grid[..], 44, 74) && reached(grid[..], 80, -4) && reached(grid[..], 0, -98);
}

#test "the palisade keeps you in but for its gates" {
  grid: [EG_REACH_N * EG_REACH_N] u8;
  everglade_open(grid[..]);
  // Walk the walls' line: open only in a gate.
  for k: 0..<128 {
    x := -63.0 + f32(k);
    c := reach_index(x, -56);
    gate := abs(x) < 3 - f32(EG_RADIUS);
    if !gate && abs(x) > 3.5 { #assert grid[c] == 0; }
    if gate && abs(x) < 2.2 { #assert grid[c] == 1; }
    n := reach_index(x, 60);
    if abs(x - 44) > 3.2 { #assert grid[n] == 0; }
    if abs(x - 44) < 1.7 { #assert grid[n] == 1; }
  }
  for k: 0..<114 {
    z := -55.0 + f32(k);
    w := reach_index(-64, z); e := reach_index(64, z);
    if abs(z) > 3.2 { #assert grid[w] == 0 && grid[e] == 0; }
    if abs(z) < 1.7 { #assert grid[w] == 1 && grid[e] == 1; }
  }
}

#test "the ground is built: flat where the city stands, rising into the forest" {
  heights: [EG_GROUND_POINTS] f32;
  #assert everglade_build_ground(heights[..]);
  g := everglade_ground();
  #assert near(verse_terrain_height(g, heights[..], 2, 1), 0, 0.02);
  #assert near(verse_terrain_height(g, heights[..], 34, 3), 0, 0.05);
  // Under each building the ground is level, so its box stands on it.
  for b: 0..<EG_BUILDINGS {
    k := b * EG_BOX;
    lowest := 1000.0f32; highest := -1000.0f32;
    for c: 0..<4 {
      x := ifx c % 2 == 0 then EG_BUILDING[k] else EG_BUILDING[k + 2];
      z := ifx c / 2 == 0 then EG_BUILDING[k + 1] else EG_BUILDING[k + 3];
      h := verse_terrain_height(g, heights[..], x, z);
      lowest = lo(lowest, h); highest = hi(highest, h);
    }
    #assert highest - lowest < 0.25;
  }
  // The forest past the walls rises; the trails out climb gently, the river trail over the bridge's deck.
  deck := everglade_deck(heights[..]);
  #assert verse_terrain_height(g, heights[..], -96, -96) > verse_terrain_height(g, heights[..], -40, -40) + 2;
  for l: 0..<EG_LINKS {
    a := EG_LINK_AB[l * 2]; b := EG_LINK_AB[l * 2 + 1];
    ax := EG_NODE_XZ[a * 2]; az := EG_NODE_XZ[a * 2 + 1]; bx := EG_NODE_XZ[b * 2]; bz := EG_NODE_XZ[b * 2 + 1];
    for s: 0..<20 {
      x0 := lerp(ax, bx, f32(s) / 20); z0 := lerp(az, bz, f32(s) / 20);
      x1 := lerp(ax, bx, f32(s + 1) / 20); z1 := lerp(az, bz, f32(s + 1) / 20);
      run := sqrt((x1 - x0) * (x1 - x0) + (z1 - z0) * (z1 - z0));
      rise := abs(everglade_walk_height(heights[..], deck, x1, z1) - everglade_walk_height(heights[..], deck, x0, z0));
      #assert rise <= run * 0.2 + 0.05;
    }
  }
}

#test "the river runs in its carved bed, falling south, with the deck over it" {
  heights: [EG_GROUND_POINTS] f32;
  #assert everglade_build_ground(heights[..]);
  levels: [EG_CELLS + 1] f32;
  everglade_river_levels(heights[..], levels[..]);
  g := everglade_ground();
  w := EG_CELLS + 1;
  for j: 0..<w {
    if j > 0 { #assert levels[j] - levels[j - 1] >= f32(EG_RIVER_FALL) - 0.0001; }
    // the water stays in its bed: past the banks the ground stands over the level
    for i: 0..<w {
      x := f32(EG_EDGE) + f32(i) * f32(EG_CELL);
      d := abs(x - f32(EG_RIVER_X));
      if d >= 4 && d <= 8 { #assert heights[j * w + i] >= levels[j] + 0.15; }
      zj := f32(EG_EDGE) + f32(j) * f32(EG_CELL);
      if d <= 2 { #assert near(heights[j * w + i], river_section(levels[j], d) - everglade_pool_deepen(x, zj), 0.0001); }
    }
  }
  // the weir: the level steps down at least its drop past the sill, into a pool 1.6 m deeper
  jw := cast(int) ((f32(EG_WEIR_Z) - f32(EG_EDGE)) / f32(EG_CELL));
  #assert levels[jw] - levels[jw - 1] >= f32(EG_WEIR_DROP) + f32(EG_RIVER_FALL) - 0.0001;
  jp := cast(int) ((f32(EG_POOL_Z) - f32(EG_EDGE)) / f32(EG_CELL) + 0.5);
  zp := f32(EG_EDGE) + f32(jp) * f32(EG_CELL);
  #assert levels[jp] - heights[jp * w + EG_RIVER_COL] > f32(EG_RIVER_DEPTH) + f32(EG_POOL_DEEP) * 0.8;
  #assert near(levels[jp] - heights[jp * w + EG_RIVER_COL], f32(EG_RIVER_DEPTH) + everglade_pool_deepen(88, zp), 0.0001);
  // Deep enough to swim in the middle, shallow enough to wade at the edge.
  z := -30.0f32;
  j := cast(int) ((z - f32(EG_EDGE)) / f32(EG_CELL));
  #assert levels[j] - verse_terrain_height(g, heights[..], 88, z) > 2.1;
  #assert levels[j] - verse_terrain_height(g, heights[..], 86.5, z) < 1.25;
  // The deck stands over the water and the trail's ground either side of it.
  deck := everglade_deck(heights[..]);
  b := cast(int) ((-11.5 - f32(EG_EDGE)) / f32(EG_CELL));
  #assert deck > levels[b] + 0.8;
  #assert everglade_walk_height(heights[..], deck, 88, -11.5) == deck;
  #assert abs(verse_terrain_height(g, heights[..], EG_BRIDGE[0], -7) - deck) < 0.3 && abs(verse_terrain_height(g, heights[..], EG_BRIDGE[2], -13) - deck) < 0.3;
}

#test "every place, gate and character has a name, and the hashes are distinct" {
  for i: 0..<EG_PLACES {
    #assert EG_PLACE_NAME[i].count > 0 && EG_PLACE_ID[i].count > 0;
    for j: i + 1..<EG_PLACES { #assert EG_PLACE_ID[i] != EG_PLACE_ID[j]; }
  }
  for s: 0..<EG_SPOTS { #assert EG_SPOT_NAME[s].count > 0 && EG_SPOT_NAME[s].count <= 20; }
  for b: 0..<EG_BUILDINGS { #assert EG_BUILDING_NAME[b].count > 0; }
  // A character stands in the open, not in a wall.
  solids: [EG_SOLIDS * EG_BOX] f32;
  n := everglade_solids(solids[..]);
  for s: 0..<EG_SPOTS {
    for k: 0..<n { #assert box_gap(solids[..], k, EG_SPOT[s * 3], EG_SPOT[s * 3 + 1]) >= f32(EG_RADIUS) + 0.2; }
  }
}

#test "the ponds: off the trails and the river, clear of the walls, each in a clearing that meets its trail, carved to their depths" {
  nodes := EG_NODE_XZ; links := EG_LINK_AB;
  heights: [EG_GROUND_POINTS] f32;
  #assert everglade_build_ground(heights[..]);
  for p: 0..<EG_PONDS {
    x := EG_POND[p * 4]; z := EG_POND[p * 4 + 1]; r := EG_POND[p * 4 + 2];
    // the water stays off the trail, with a bank to stand on
    trail := verse_path_nearest(nodes[..], links[..], x, z).d;
    #assert trail > r + f32(EG_PATH_HALF) + 1.5;
    #assert EG_POND_OPEN[p] >= r + 4 && EG_POND_OPEN[p] > trail - f32(EG_TRAIL_FREE) + 1;
    #assert !everglade_in_river(x, r + 3);
    #assert abs(x) + r < f32(EG_BOUND) - 4 && abs(z) + r < f32(EG_BOUND) - 4;
    // outside the palisade and its apron
    #assert x - r > 65.25 || x + r < -65.25 || z - r > 61.25 || z + r < -57.5;
    // the pond and the ground between it and its trail are open
    #assert !everglade_in_woods(x, z) && !everglade_in_woods(x + r + 1, z) && !everglade_in_woods(x - r - 1, z);
    level := everglade_pond_level(heights[..], p);
    w := EG_CELLS + 1;
    i := cast(int) floor((x - f32(EG_EDGE)) / f32(EG_CELL) + 0.5); j := cast(int) floor((z - f32(EG_EDGE)) / f32(EG_CELL) + 0.5);
    gx := f32(EG_EDGE) + f32(i) * f32(EG_CELL); gz := f32(EG_EDGE) + f32(j) * f32(EG_CELL);
    d := sqrt((gx - x) * (gx - x) + (gz - z) * (gz - z));
    // deep at the middle by the pond's depth (within a grid cell's slope), dry ground 2 m past the rim
    #assert level - heights[j * w + i] > EG_POND[p * 4 + 3] * 0.8;
    #assert verse_terrain_height(everglade_ground(), heights[..], x + r + 2, z) >= level + 0.2;
  }
  // the carve leaves the ring the level is read from: the same level after it
  raw: [EG_GROUND_POINTS] f32;
  flats: [EG_FLATS * FLAT] f32;
  #assert everglade_flats(flats[..]) == EG_FLATS;
  #assert verse_terrain_build(everglade_ground(), raw[..], nodes[..], links[..], f32(EG_PATH_HALF), flats[..]);
  everglade_carve_river(raw[..]);
  for p: 0..<EG_PONDS { #assert abs(everglade_pond_level(raw[..], p) - everglade_pond_level(heights[..], p)) < 0.001; }
}
