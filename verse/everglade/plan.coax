EG_FOUNTAIN :: 0; EG_BOARD :: 1; EG_STALL :: 2; EG_WAYSTONE :: 8; EG_PILLAR :: 9; EG_CRYPT :: 12; EG_RIVER :: 13;
// The bridge over the river where the trail crosses it: a deck you walk on, not in the way.
EG_BRIDGE :: [5] f32.[84, -18, 92, -5, 0.5];   // its ends on the ground the river's carve leaves as it was

// ---- the streets and the trails out (verse/terrain.coax nodes and links)
EG_NODES :: 30;
EG_NODE_XZ :: [60] f32.[
  0, 12,   12, 0,   0, -12,   -12, 0,   8.5, 8.5,   8.5, -8.5,   -8.5, -8.5,   -8.5, 8.5,
  0, -34,  0, -56,  0, -70,   0, -98,
  24, 0,   44, 0,   64, 0,    80, -4,   96, -16,
  -26, 0,  -48, 0,  -64, 0,   -80, 4,   -96, 18,
  0, 26,   26, 30,  44, 44,   44, 60,   44, 74,   22, 92,   66, 88,
  -26, 30
];
EG_LINKS :: 30;
EG_LINK_AB :: [60] int.[
  0, 4,  4, 1,  1, 5,  5, 2,  2, 6,  6, 3,  3, 7,  7, 0,
  2, 8,  8, 9,  9, 10,  10, 11,
  1, 12,  12, 13,  13, 14,  14, 15,  15, 16,
  3, 17,  17, 18,  18, 19,  19, 20,  20, 21,
  0, 22,  22, 23,  23, 24,  24, 25,  25, 26,  26, 27,  26, 28,
  22, 29
];
// The street and trail names, for the map: a link each.
EG_LINK_NAME :: [30] string.[
  "COMMONS RING", "COMMONS RING", "COMMONS RING", "COMMONS RING", "COMMONS RING", "COMMONS RING", "COMMONS RING", "COMMONS RING",
  "INN STREET", "INN STREET", "THE ROAD IN", "THE ROAD IN",
  "MARKET STREET", "MARKET STREET", "MARKET STREET", "RIVER TRAIL", "RIVER TRAIL",
  "GUILD ROW", "GUILD ROW", "GUILD ROW", "DEEP WOOD TRAIL", "DEEP WOOD TRAIL",
  "TEMPLE WALK", "STARGAZERS' LANE", "STARGAZERS' LANE", "NORTH LANE", "NORTH TRAIL", "RUINS TRAIL", "CRYPT TRAIL",
  "MAGES' LANE"
];
EG_SOUTH_GATE_NODE :: 9;

// ---- where things are, for the HUD's labels and the map: x, z each.
EG_PLACES :: 13;
EG_PLACE :: [26] f32.[
  0, 0,   34, 0,   -37, 0,   0, 30,   28, 50,   -14, -49,
  0, -85,  -92, 25,   22, 90,   66, 99,   93, -12,  0, -62,  50, 60
