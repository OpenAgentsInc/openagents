// Everglade, the forest city, as a blockout: the ground, the palisade and
// every building, stall and landmark as a box, the streets and the trails
// out as a path graph, and where each character stands. The plan in words
// is docs/verse/everglade.md; its map (docs/verse/everglade-map.svg) is
// drawn from these numbers by verse/everglade/map.py.
//
// Metres, z north and x west, the fountain at the origin: the engine's
// axes (yaw 0 faces +z, a quarter turn +x), so seen from above with north
// up, +x is to the left. A box is five
// numbers: min x, min z, max x, max z, height. The ground and the paths
// are verse/terrain.coax's: a heightfield with rolling hills that rise past
// the walls, levelled where the streets run and flat under the commons,
// the market, the forecourt and each building.
// The checks walk the whole city on a half-metre grid and build its
// ground, so they need a larger step budget than a file's default:
//   coax/bin/coax test --library verse/everglade/plan.coax --steps 2000000000

#load "../terrain.coax";

EG_CELLS :: 104;        // the ground's cells a side
EG_CELL :: 2.0;         // metres each
EG_EDGE :: -104.0;      // its west and south edge
EG_BOUND :: 100.0;      // metres from the middle you may walk
// The woods are open: you walk among the trees, round their trunks and rocks, out to EG_BOUND
// (the ruins' pillars stand at 98.5). Past it a thicket stands (everglade.coax plant_thicket):
// dense brush backed by close-set trees, so the world's end shows before you reach it.
EG_THICKET :: 101.3;    // the thicket's front row, where its brush's middles stand
EG_RIM_FROM :: 80.0;    // the forest's hills rise from here
EG_RIM :: 0.004;
EG_PATH_HALF :: 1.5;    // a street's half width: three metres across
EG_BOX :: 5;
EG_GAP :: 2.0;          // metres between two buildings, and between a building and the palisade
EG_PROP_GAP :: 1.0;     // between a prop and anything else
EG_CLEAR :: 0.5;        // what a street keeps clear of on either side
EG_RADIUS :: 0.3;       // a walker's capsule (verse/player.coax RADIUS)

// ---- the palisade: four timber walls 4.5 m high, with a gate in each and
// a tower either side of every gate. The South Gate is the main one, 6 m
// across; the others are 5.
EG_PALISADE_N :: 16;
EG_PALISADE :: [80] f32.[
  -64.4, -56.4, -6.0, -55.6, 4.5,     6.0, -56.4, 64.4, -55.6, 4.5,
  -6.0, -57.5, -3.0, -54.5, 7.5,      3.0, -57.5, 6.0, -54.5, 7.5,
  -64.4, 59.6, 39.0, 60.4, 4.5,       49.0, 59.6, 64.4, 60.4, 4.5,
  39.0, 58.75, 41.5, 61.25, 7.0,      46.5, 58.75, 49.0, 61.25, 7.0,
  -64.4, -55.6, -63.6, -5.0, 4.5,     -64.4, 5.0, -63.6, 59.6, 4.5,
  -65.25, -5.0, -62.75, -2.5, 7.0,    -65.25, 2.5, -62.75, 5.0, 7.0,
  63.6, -55.6, 64.4, -5.0, 4.5,       63.6, 5.0, 64.4, 59.6, 4.5,
  62.75, -5.0, 65.25, -2.5, 7.0,      62.75, 2.5, 65.25, 5.0, 7.0
];
// The gates: x, z of the gap's middle, its width, and 0 when it runs east-west (a south or north wall).
EG_GATES :: 4;
EG_GATE :: [16] f32.[0, -56, 6, 0,   44, 60, 5, 0,   -64, 0, 5, 1,   64, 0, 5, 1];
EG_GATE_NAME :: [4] string.["SOUTH GATE", "NORTH GATE", "EAST GATE", "WEST GATE"];

// ---- the buildings: a box each, its door (the spot just outside it where
// you walk in, or will once it has an interior), and its name.
EG_BUILDINGS :: 16;
EG_BUILDING :: [80] f32.[
  -22, -44, -6, -30, 9,       22, 10, 34, 20, 7,        44, 8, 56, 18, 6,         44, -18, 54, -8, 7,
  -44, 6, -30, 18, 8,         -44, -18, -30, -6, 7,     -32, 36, -22, 46, 14,     -9, 34, 9, 52, 12,
  24, 40, 32, 48, 18,         8, -76, 20, -64, 6,       -22, -24, -12, -16, 7,    8, -26, 18, -16, 7,
  8, -46, 18, -36, 7,         -50, 30, -40, 40, 7,      50, -40, 58, -30, 6,      -52, -40, -42, -30, 6
];
EG_DOOR :: [32] f32.[
  -5, -37,   28, 9,   50, 7,   49, -7,
  -37, 5,    -37, -5, -27, 35, 0, 33,
  28, 39,    7, -70,  -11, -20, 7, -21,
  7, -41,    -45, 29, 49, -35, -47, -29
];
EG_BUILDING_NAME :: [16] string.[
  "THE INN", "GENERAL STORE", "SMITHY", "ALCHEMIST",
  "FIGHTERS' HALL", "RANGERS' LODGE", "MAGES' TOWER", "TEMPLE",
  "OBSERVATORY", "STABLES", "HOUSE", "HOUSE",
  "HOUSE", "HOUSE", "HOUSE", "HOUSE"
];
// The buildings you walk into (eg-buildings): the inn, the three shops,
// the two guild halls and the temple. Their walls stand 0.4 m thick inside
// the footprint, with a doorway in the wall that faces the door spot.
EG_INTERIOR :: [16] bool.[true, true, true, true, true, true, false, true, false, false, false, false, false, false, false, false];
EG_INTERIORS :: 7;
// The hash that starts you inside one (#in-inn): "" for those you can't enter.
EG_ROOM_ID :: [16] string.["in-inn", "in-store", "in-smithy", "in-alchemist", "in-fighters", "in-rangers", "", "in-temple", "", "", "", "", "", "", "", ""];
EG_WALL :: 0.4;         // a wall's thickness
EG_MODULE :: 2.0;       // the kit's walls are 2 m modules
EG_DOORWAY :: 1.9;      // the gap a doorway leaves in a wall
EG_INN :: 0; EG_STORE :: 1; EG_SMITHY :: 2; EG_ALCHEMIST :: 3; EG_FIGHTERS :: 4; EG_RANGERS :: 5;
EG_MAGES :: 6; EG_TEMPLE :: 7; EG_OBSERVATORY :: 8; EG_STABLES :: 9; EG_HOUSES :: 10;

