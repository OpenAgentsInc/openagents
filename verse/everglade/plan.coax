  24.5, 5, 27.5, 7, 2.6,      30.5, 5, 33.5, 7, 2.6,      36.5, 5, 39.5, 7, 2.6,
  24.5, -7, 27.5, -5, 2.6,    30.5, -7, 33.5, -5, 2.6,    36.5, -7, 39.5, -5, 2.6,
  -90.3, 21.6, -89.5, 22.4, 1.8,
  13.5, 94.5, 14.5, 95.5, 3.2,   29.5, 95.5, 30.5, 96.5, 2.2,   19.5, 97.5, 20.5, 98.5, 4.0,
  62, 91, 70, 97, 3.5,
  86, -100, 90, -18, 0.3,     86, -5, 90, 100, 0.3
