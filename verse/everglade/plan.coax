EG_PLACE_ID :: [13] string.[
  "commons", "market", "guilds", "temple", "observatory", "inn",
  "road", "deep-wood", "ruins", "crypt", "river", "gate", "north-gate"
];

// ---- where the city's characters stand: x, z, the way they face (radians,
