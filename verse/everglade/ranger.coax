// The rig in a page's state (a view needs an array it may write through), and its views.
Ranger :: struct {
  parent: [75] int;
  rest: [525] f32;
  bind: [900] f32;
  duration: [8] f32;
  distance: [8] f32;
  track_t: [1200] int;
  track_r: [1200] int;
  keys_t: [2592] f32;
  keys_r: [20055] f32;
}
ranger_load :: (d: [] Ranger) {
  d[0].parent = RANGER_PARENT;
  d[0].rest = RANGER_REST;
  d[0].bind = RANGER_BIND;
  d[0].duration = RANGER_DURATION;
  d[0].distance = RANGER_DISTANCE;
  d[0].track_t = RANGER_TRACK_T;
  d[0].track_r = RANGER_TRACK_R;
  d[0].keys_t = RANGER_KEYS_T;
  d[0].keys_r = RANGER_KEYS_R;
}
ranger_rig :: (d: [] Ranger) -> SkinRig {
  return SkinRig.{joints = RANGER_JOINTS, clips = RANGER_CLIPS, parent = d[0].parent[..], rest = d[0].rest[..], bind = d[0].bind[..],
                  duration = d[0].duration[..], distance = d[0].distance[..], track_t = d[0].track_t[..],
                  track_r = d[0].track_r[..], keys_t = d[0].keys_t[..], keys_r = d[0].keys_r[..]};
}
