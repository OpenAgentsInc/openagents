// Everglade's river on the water system (phase W3 of docs/verse/water.md,
// adapted to today's Everglade): the 4 m river verse/everglade/plan.coax
// carves along x = 88 from the north edge of the world to the south, one
// verse/water.coax river body with the level profile the plan's carve
// follows and a current from water_flow_river round the bridge's piles,
// drawn with the W2 shader (verse/water-look.coax, everglade.wgsl). It is
// its own library, as verse/player.coax is: the realm's face
// (apps/openagents-web/everglade-face.c) passes values between it, the page
// and the controller.
//
// Ported from the old W3 (git show 03b7bbe2b0: crates/physics/src/water/
// medium.rs, crates/verse-world/src/water.rs, the zone's water.rs) what fits
// the current layout:
//
// - The medium: ground, wading (deeper than 0.4 m), swimming (deeper than
//   1.25 m or the feet off the bed) and diving (the eye under the surface),
//   from the gameplay surface; a swimmer settles at a float line 1.2 m
//   under the surface, an idle diver rises at 0.6 m/s.
// - Pace (SRD 5.2.1): half speed wading and swimming, a sixth of Speed less
//   each Exhaustion level. On land the controller's speeds are unchanged.
// - Breath (SRD 5.2.1): 1 + Constitution modifier minutes (the Ranger's
//   modifier is +0: a minute), at least 30 s; out of breath, an Exhaustion
//   level every 6 s; the sixth defeats, and you come to on the nearer bank.
//   Breathing again removes them; breath refills over 6 s.
// - Floats: ducks and lily pads, rigid bodies (verse/rigid.coax) on
//   water_apply's buoyancy and drag; a duck paddles back to its stretch of
//   the glade against the current, a lily pad is held by its stem.
//
// - The four ponds (verse/everglade/plan.coax EG_POND): W1 pond bodies at a
//   still level over the bowls the plan carves, in the same set as the
//   river, so wading, swimming, diving and breath hold in them too.
//
// - The weir (plan.coax EG_WEIR_Z): the level profile is a point every 2 m,
//   so its 0.25 m step stays at the sill; the nodes carry white water down
//   the drop and in the plunge pool.
//
// - Rowboats moored at three ponds (FLOAT_BOAT): a hull on a slack line.
//   You board one with the interact key from the bank or the water, sit at
//   its middle thwart, and row it: strokes at 0.8 a second to about 1.5 m/s,
//   turning by rowing one oar (the old W6 rowboat). Leaving puts you on the
//   bank within 2.5 m, else in the water beside it, and ties it up there.
//
// - From W6: Kelvin wakes and foam trails behind you swimming or rowing and
//   behind the ducks (a trail of points the shader draws the wedge from),
//   and the water's particles (FX): spray where you splash in, at the weir's
//   foot and off the oars, mist over the weir and its pool, drips, and the
//   steam and crown splashes the spells raise (everglade_river_splash).
//   A fixed pool of FX particles, the oldest replaced; nothing allocates.
//
// The townsfolk wade and swim by the same rules (verse/water-wade.coax, verse/everglade/routines.coax).
// Not yet: the underwater combat rules.
//   coax/bin/coax test --library verse/everglade/river.coax --steps 2000000000

#load "../water-look.coax";
#load "../water-wade.coax";

RIVER_X :: 88.0;          // the plan's river runs along x = 88 (EG_RIVER_X)
RIVER_NORTH :: 104.0;     // from the north edge of the ground, flowing south
RIVER_SOUTH :: -104.0;
RIVER_WIDTH :: 6.0;       // the outline: the 4 m channel and its wet banks
RIVER_POINTS :: 27;       // the course, every 8 m
RIVER_PROFILE :: 105;     // its level, every 2 m (a ground row), so the weir's step stays where it is
RIVER_COLS :: 13;         // the baked nodes: 0.5 m across, from -3 to 3 m
RIVER_ROWS :: 209;        // and 1 m along
RIVER_ACROSS :: 0.5;
RIVER_ALONG :: 1.0;
RIVER_PATCH_ROWS :: 4;    // a patch (an instance) is 4 m of river
RIVER_PATCHES :: 52;
RIVER_NODES :: RIVER_COLS * RIVER_ROWS * WATER_NODE;
RIVER_FLOW_CELL :: 0.5;
RIVER_FLOW :: 7600;       // the flow grid's nodes (17 by 433)
RIVER_SPEED :: 0.45;      // m/s, the mean current
RIVER_PILES :: 2;         // the bridge's piles, in the stream
RIVER_PILE :: [6] f64.[87.0, -11.0, 0.5,   89.0, -11.0, 0.5];   // each holds five of the flow grid's nodes
RIVER_RIPPLES :: 24;
// W6: the wakes' movers (you, and the duck nearest you) and the points each trail keeps, laid every
// WAKE_LAY s; the particles, FX_FLOATS numbers each (x, y, z, vx, vy, vz, age, life, size, kind).
WAKE_MOVERS :: 2;
WAKE_POINTS :: 8;
WAKE_LAY :: 0.3;
// (two spare, and the weir's two, so these arrays' C types are River's own beside everglade.h's)
TRAIL_FLOATS :: WAKE_MOVERS * WAKE_POINTS * 4 + 2;
FX :: 64;
FX_FLOATS :: 10;
FX_SPRAY :: 0; FX_MIST :: 1; FX_DRIP :: 2; FX_STEAM :: 3;
// What the face writes for the shader (everglade.coax U_FX): the weir's sheet (2 rows: west, east, z, 1;
// the level above, below, the water's speed over the sill, 0), the boats'
// hulls (BOATS rows: x, z, yaw, 1 when drawn), the trails (WAKE_MOVERS * WAKE_POINTS rows), then
// the particles (2 rows each: x, y, z, size; kind, alpha, 0, 0).
FX_ROWS :: 2 + 3 + WAKE_MOVERS * WAKE_POINTS + FX * 2;
PONDS :: 4;               // the plan's ponds (EG_PONDS): x, z, rim radius, level each after the river's levels
POND_POINTS :: 24;        // each pond's outline, a polygon round its rim
MEDIUM_BOAT :: 4;         // seated in a rowboat (Swim.medium; out of the water for lightning)

// The swimmer (medium.rs).
// (WADE_DEPTH, SWIM_DEPTH, FLOAT_DEPTH, EYE_HEIGHT, STANDING and the media are verse/water-wade.coax's)
RISE_SPEED :: 0.6;
SETTLE_RATE :: 6.0;
DIVE_SPEED :: 1.5;        // m/s down while you hold dive (ours; the old diver followed the camera's pitch)

// Breath (verse-world water.rs, SRD 5.2.1).
CON :: 0;                 // the Ranger's Constitution modifier
MIN_HOLD :: 30.0;
ROUND :: 6.0;
REFILL :: 6.0;
DEFEAT_LEVEL :: 6;

// Floats: three ducks and six lily pads on the river, and on each pond a
// duck and three pads (POND_FLOATS, the duck first).
RIVER_FLOATS :: 9;
POND_FLOATS :: 4;
// and a rowboat moored at the Lantern, Thinking and Fern ponds (not the Reed
// Pond's: it is too small for one)
BOAT_PONDS :: [4] bool.[true, false, true, true];
BOATS :: 3;
FLOATS :: RIVER_FLOATS + PONDS * POND_FLOATS + BOATS;
FLOAT_DUCK :: 0; FLOAT_PAD :: 1; FLOAT_BOAT :: 2;
// A rowboat: 3.2 m long and 1.1 m across, its hull 0.4 m deep, 220 kg.
BOAT_HALF :: D3.{x = 0.55, y = 0.2, z = 1.6};
BOAT_MASS :: 220.0;
DUCKS :: 3;
FLOAT_HOME :: [18] f64.[
  88.4, -26.0,   87.2, 2.0,   88.8, -34.0,
  86.6, -22.5,   89.2, -38.5,   89.4, -24.0,   86.7, 4.5,   89.3, 7.0,   86.9, -36.5
];
FLOAT_STEP :: 1.0 / 120.0;
// The weir and its plunge pool (plan.coax EG_WEIR_Z, EG_POOL_*): white water
// down the drop and churning in the pool.
WEIR_Z :: -30.0;
WEIR_FOOT :: -32.0;
POOL_X :: 88.0; POOL_Z :: -33.0; POOL_R :: 2.5;

River :: struct {
  ready: bool;
  rise: f32;            // m the rain has raised the river (verse/water-weather.coax, at most 0.15; W9)
  flow_boost: f32;      // and how much faster its current runs for it (0 to 0.6)
  n: int; cell: f32; west: f32; south: f32;      // the ground the bed is (verse/terrain.coax's grid)
  points: [RIVER_POINTS] D2; widths: [RIVER_POINTS] f64; lengths: [RIVER_POINTS] f64;
  profile: [RIVER_PROFILE] D2; profile_n: int;
  flow: [RIVER_FLOW] D2;
  piles: [RIVER_PILES] Obstacle;
  bodies: [1 + PONDS] WaterBody;
  pond_points: [PONDS * POND_POINTS] D2;
  ponds: [PONDS * 4] f32;
  boat_room: [PONDS * POND_POINTS] f32;   // how far out from each pond's middle a hull still floats, a direction each
  starts: [257] int; entries: [256] int;
  set: WaterSet;
  preset: WaterPreset;
  nodes: [RIVER_NODES] f32;                       // store 3 (everglade.wgsl water_nodes)
  ripples: [RIVER_RIPPLES * 4] f32;
  // you
  medium: int; feet: f32; afloat: bool;
  breath: f64; out: f64; levels: int;
  wake_x: f32; wake_z: f32; wake_time: f32; splashed: bool;
  // the floats
  floats: [FLOATS] RigidBody; colliders: [FLOATS] Collider; pushes: [FLOATS * 2] Push;
  homes: [FLOATS * 3] f64; kinds: [FLOATS] int; float_n: int;   // each one's home x, z and yaw
  float_tick: u64; float_carry: f64;
  // the rowboat you sit in (a float's index, -1 none), the stroke's clock and what you ask of it
  aboard: int; oar_t: f32; row_on: f32; row_ahead: f32; row_turn: f32; oar_wet: bool;
  // the wakes: each mover's trail (x, z, when, speed; the newest first), and when it last laid a point
  trail: [TRAIL_FLOATS] f32; trail_t: [WAKE_MOVERS] f32;
  // the particles (FX_FLOATS each): spray, mist, drips, steam
  fx: [FX * FX_FLOATS] f32; fx_next: int; fx_seed: u32; mist_carry: f32; foot_carry: f32;
  weir: [6] f32;          // the weir's sheet: west and east edges of its water, the level above and below it (2 spare)
  clock: f32;             // s on the water's clock, folded every hour (the ripples' and the FX's)
  // the spells' fields over the floats this frame (everglade_river_fields), RIVER_FIELD_FLOATS each
  fields: [RIVER_FIELDS * RIVER_FIELD_FLOATS] f32; field_n: int;
}
RIVER_FIELDS :: 16; RIVER_FIELD_FLOATS :: 10;

// What the face passes on to the controller and the page each frame.
Swim :: struct {
  medium: int;
  feet: f32;            // where your feet are, m: the bed, or afloat in the water
  surface: f32;         // the water's height over you, or -1000 where there is none
  pace: f32;            // your speed's share, 1 on land
  flow_x: f32; flow_z: f32;   // the current that carries a swimmer, m/s
  breath: f32;          // its share left, 0 to 1
  levels: int;          // Exhaustion from suffocating
  defeated: bool;       // the sixth level: you come to on the bank
  bank_x: f32; bank_z: f32;
}

// ---- the bed

// The ground's height at (x, z), as verse/terrain.coax's verse_terrain_height
// reads it (the same two triangles a cell the ground draws).
river_bed :: (r: [] River, heights: [] f32, x: f32, z: f32) -> f32 {
  n := r[0].n;
  if n < 1 || heights.count < (n + 1) * (n + 1) { return 0; }
  gx := clamp_f((x - r[0].west) / r[0].cell, 0, f32(n) - 0.0001);
  gz := clamp_f((z - r[0].south) / r[0].cell, 0, f32(n) - 0.0001);
  if !(gx == gx) { gx = 0; }
  if !(gz == gz) { gz = 0; }
  i := cast(int) floor(gx); j := cast(int) floor(gz);
  fx := gx - f32(i); fz := gz - f32(j);
  w := n + 1;
  h00 := heights[j * w + i]; h10 := heights[j * w + i + 1]; h01 := heights[(j + 1) * w + i]; h11 := heights[(j + 1) * w + i + 1];
  if fx >= fz { return h00 + (h10 - h00) * fx + (h11 - h10) * fz; }
  return h00 + (h11 - h01) * fx + (h01 - h00) * fz;
}

clamp_f :: (a: f32, low: f32, high: f32) -> f32 { return lo_f(high, hi_f(low, a)); }

// ---- the body

// The river's level at z from the plan's level per ground row (levels[j] at
// z = south + j cell), linear between rows.
level_from :: (r: [] River, levels: [] f32, z: f64) -> f64 {
  g := (z - f64(r[0].south)) / f64(r[0].cell);
  if g <= 0.0 { return f64(levels[0]); }
  last := levels.count - 1;
  if g >= f64(last) { return f64(levels[last]); }
  j := int(floor(g));
  f := g - f64(j);
  return f64(levels[j]) + (f64(levels[j + 1]) - f64(levels[j])) * f;
}

// Builds the river: its course and level profile, its waves, its current,
// its set, the baked nodes the shader reads, the floats.
// levels: the river's level over each of the n + 1 ground rows, then the ponds' rows (x, z, rim, level).
everglade_river_start :: (r: [] River, heights: [] f32, all: [] f32, n: int, cell: f32, west: f32, south: f32) #export_c {
  levels := all[0..<(ifx n + 1 < all.count then n + 1 else all.count)];
  r[0].n = n; r[0].cell = cell; r[0].west = west; r[0].south = south;
  span := RIVER_NORTH - RIVER_SOUTH;
  for i: 0..<RIVER_POINTS {
    z := RIVER_NORTH - span * f64(i) / f64(RIVER_POINTS - 1);
    r[0].points[i] = d2(RIVER_X, z);
    r[0].widths[i] = RIVER_WIDTH;
  }
  course := water_course(r[0].points[..], r[0].widths[..], r[0].lengths[..]);
  // the course runs straight south, so a point's way along it is how far it is south of the north end
  for i: 0..<RIVER_PROFILE {
    along := (RIVER_NORTH - RIVER_SOUTH) * f64(i) / f64(RIVER_PROFILE - 1);
    r[0].profile[i] = d2(along, level_from(r, levels, RIVER_NORTH - along));
  }
  r[0].profile_n = RIVER_PROFILE;
  for p: 0..<RIVER_PILES {
    r[0].piles[p] = Obstacle.{center = d2(RIVER_PILE[p * 3], RIVER_PILE[p * 3 + 1]), radius = RIVER_PILE[p * 3 + 2]};
  }
  grid := water_flow_river(course, r[0].piles[..], RIVER_FLOW_CELL, RIVER_SPEED, r[0].flow[..]);
  body := water_with_flow(water_river(1, course, r[0].profile[0..<r[0].profile_n]), grid);
  // A light chop drifting downstream: the old river preset's water under a breeze.
  sea := water_wind_sea(3.0, 2.6, 0.55, 4);
  // gentler than the open sea's: a river's chop seldom breaks
  if sea.error == WaveError.none { calm := sea.set; calm.steepness = 0.35; body = water_with_waves(body, calm); }
  r[0].bodies[0] = body;
  // the ponds: still water inside their rims, 0.3 m past it so the shallows are whole
  bodies := 1;
  for p: 0..<PONDS {
    k := n + 1 + p * 4;
    if all.count < k + 4 { break; }
    for i: 0..<4 { r[0].ponds[p * 4 + i] = all[k + i]; }
    rim := f64(all[k + 2]) + 0.3;
    for i: 0..<POND_POINTS {
      a := TAU_D * f64(i) / f64(POND_POINTS);
      r[0].pond_points[p * POND_POINTS + i] = d2(f64(all[k]) + rim * cos(a), f64(all[k + 1]) + rim * sin(a));
    }
    r[0].bodies[bodies] = water_pond(2 + p, r[0].pond_points[p * POND_POINTS..<(p + 1) * POND_POINTS], f64(all[k + 3]));
    bodies += 1;
  }
  r[0].set = water_set(r[0].bodies[0..<bodies], 8.0, r[0].starts[..], r[0].entries[..]);
  r[0].preset = water_preset(WATER_PAINTED);   // the painted look (art-styles.md 12, eg-paint-river)
  river_bake(r, heights);
  boat_rooms(r, heights);
  r[0].breath = hold_seconds(CON);
  r[0].medium = MEDIUM_GROUND;
  floats_start(r);
  r[0].aboard = -1;
  r[0].fx_seed = 0x2545f491;
  // the weir's sheet: across the water's width at the sill, from the level above to the level below
  wet_w := f64(RIVER_X); wet_e := f64(RIVER_X);
  for c: 0..<RIVER_COLS {
    cx := f64(RIVER_X) + (f64(c) - f64(RIVER_COLS - 1) * 0.5) * RIVER_ACROSS;
    if f64(river_bed(r, heights, cast(f32) cx, cast(f32) (WEIR_Z + 0.3))) < level_at(body.level, body.height, body.profile, RIVER_NORTH - WEIR_Z - 0.3).height {
      wet_w = fmin(wet_w, cx); wet_e = fmax(wet_e, cx);
    }
  }
  r[0].weir[0] = cast(f32) (wet_w - 0.1); r[0].weir[1] = cast(f32) (wet_e + 0.1);
  r[0].weir[2] = cast(f32) level_at(body.level, body.height, body.profile, RIVER_NORTH - WEIR_Z - 0.6).height;
  r[0].weir[3] = cast(f32) level_at(body.level, body.height, body.profile, RIVER_NORTH - WEIR_Z + 1.0).height;
  r[0].ready = true;
}

// The nodes: a row every metre along the course, 13 across it, each with
// its rest position at the level, the depth to the bed under it, its
// distance to the shore and the current there.
river_bake :: (r: [] River, heights: [] f32) {
  b := r[0].bodies[0];
  wet: [RIVER_COLS * RIVER_ROWS] bool;
  shore: [RIVER_COLS * RIVER_ROWS] f32;
  for j: 0..<RIVER_ROWS {
    along := f64(j) * RIVER_ALONG;
    middle := water_point_at(b.course, along);
    s := water_locate(b.course, middle);
    normal := d2(-s.tangent.y, s.tangent.x);
    level := level_at(b.level, b.height, b.profile, along).height;
    for c: 0..<RIVER_COLS {
      offset := (f64(c) - f64(RIVER_COLS - 1) * 0.5) * RIVER_ACROSS;
      p := d2_add(middle, d2_scale(normal, offset));
      k := (j * RIVER_COLS + c) * WATER_NODE;
      depth := level - f64(river_bed(r, heights, cast(f32) p.x, cast(f32) p.y));
      f := water_flow_sample(b.flow, p);
      r[0].nodes[k] = cast(f32) p.x; r[0].nodes[k + 1] = cast(f32) level; r[0].nodes[k + 2] = cast(f32) p.y;
      r[0].nodes[k + 3] = cast(f32) depth;
      r[0].nodes[k + 5] = cast(f32) f.x; r[0].nodes[k + 6] = cast(f32) f.y;
      // white water where the current wraps a pile
      foam := 0.0;
      for q: 0..<RIVER_PILES { foam = fmax(foam, 1.0 - d2_dist(p, r[0].piles[q].center) / 1.2); }
      // and down the weir's drop, and where it plunges into its pool
      if p.y <= WEIR_Z + 0.5 && p.y >= WEIR_FOOT - 0.5 { foam = fmax(foam, 1.0 - abs(p.y - (WEIR_Z + WEIR_FOOT) * 0.5) / 1.5); }
      foam = fmax(foam, 0.85 * (1.0 - d2_dist(p, d2(POOL_X, POOL_Z)) / (POOL_R + 0.5)));
      r[0].nodes[k + 7] = cast(f32) foam;
      wet[j * RIVER_COLS + c] = depth > 0.0;
    }
  }
  water_shore_distance(RIVER_COLS, RIVER_ROWS, wet[..], RIVER_ACROSS, RIVER_ALONG, shore[..]);
  for k: 0..<RIVER_COLS * RIVER_ROWS { r[0].nodes[k * WATER_NODE + 4] = shore[k]; }
}

everglade_river_node_bytes :: () -> int #export_c { return RIVER_NODES * 4; }

// The river's uniform block (everglade.wgsl WaterU) for this frame at
// `time` s: the waves on the water clock, the look, the tier, the mesh.
everglade_river_frame :: (r: [] River, u: [] f32, time: f64, phone: bool, ex: f32, ey: f32, ez: f32, pixel_angle: f32) #export_c {
  if !r[0].ready || u.count < WATER_FLOATS { return; }
  b := r[0].bodies[0];
  inside := false;
  s := water_sample(r[0].set, f64(ex), f64(ez), river_tick(time));
  if s.found && f64(ey) < s.height + f64(r[0].rise) { inside = true; }
  water_look_body(u, 0, b.waves, time, r[0].preset, 1, inside);
  water_look_detail(u, 0, 3.0, 0.12, 2.4, 0.016);
  water_look_control(u, 0, phone);
  // the eye's height over the water (m; 100 when not over it): everglade.wgsl splits the view
  // at the near plane with it and draws what lies under in the underwater look (W7)
  u[W_CONTROL + 3] = ifx s.found then ey - f32(s.height) - r[0].rise else 100.0f32;
  water_look_ripples(u, 0, r[0].ripples[..], cast(f32) u[W_PARAMS]);
  u[W_REST + 1] = pixel_angle;
  u[W_GRID] = f32(RIVER_COLS); u[W_GRID + 1] = f32(RIVER_ROWS);
  u[W_GRID + 2] = ifx phone then 6.0f32 else 12.0f32;
  u[W_GRID + 3] = ifx phone then 4.0f32 else 8.0f32;
  u[W_GRID2] = f32(RIVER_PATCH_ROWS); u[W_GRID2 + 1] = f32(RIVER_PATCHES);
  // the nodes' frame: the first at the course's start, a row a metre on along it
  start := water_point_at(b.course, 0.0);
  first := water_locate(b.course, start);
  normal := d2(-first.tangent.y, first.tangent.x);
  corner := d2_add(start, d2_scale(normal, -f64(RIVER_COLS - 1) * 0.5 * RIVER_ACROSS));
  u[W_FRAME] = cast(f32) corner.x; u[W_FRAME + 1] = cast(f32) corner.y;
  u[W_FRAME + 2] = cast(f32) atan_d2(first.tangent.x, first.tangent.y);
  u[W_FRAME + 3] = f32(RIVER_ACROSS); u[W_REST + 3] = f32(RIVER_ALONG);
}

// The rain's rise on the river (m, held to 0.15) and the current's gain for it (1 to 1.6), from
// Everglade's weather each frame (verse/water-weather.coax weather_rise and weather_flow_gain).
everglade_river_weather :: (r: [] River, rise: f32, gain: f32) #export_c {
  r[0].rise = ifx rise == rise then clamp_f(rise, 0, 0.15) else 0.0f32;
  r[0].flow_boost = ifx gain == gain then clamp_f(gain - 1, 0, 0.6) else 0.0f32;
}

// The water clock's tick at `time` s.
river_tick :: (time: f64) -> u64 { return cast(u64) floor(fmax(time, 0.0) * 120.0); }

// The draw: vertices a patch, and patches.
everglade_river_vertices :: (phone: bool) -> int #export_c { return ifx phone then 6 * 4 * 6 else 12 * 8 * 6; }
everglade_river_patches :: () -> int #export_c { return RIVER_PATCHES; }

// The gameplay surface over (x, z) at `time`, or none.
everglade_river_surface :: (r: [] River, x: f32, z: f32, time: f64) -> f32 #export_c {
  if !r[0].ready { return -1000; }
  s := water_sample(r[0].set, f64(x), f64(z), river_tick(time));
  if !s.found { return -1000; }
  return cast(f32) s.height + r[0].rise;
}

// ---- the swimmer (medium.rs)

// The medium is verse/water-wade.coax's medium_of, the people's rule too.

// A swimmer's feet after dt: at the float line it settles onto it, an idle
// diver rises at RISE_SPEED, a stroke moves it at the asked speed, never
// below the bed nor above the float line.
swim_height :: (feet: f32, surface: f32, bed: f32, vertical: f32, dt: f32) -> f32 {
  float := surface - f32(FLOAT_DEPTH);
  floor_ := lo_f(bed, float);
  top := hi_f(float, floor_);
  if !(dt > 0) || !(feet == feet) { return clamp_f(feet, floor_, top); }
  next := 0.0f32;
  if vertical != 0 { next = feet + vertical * dt; }
  else if feet < float - 0.05 { next = lo_f(feet + f32(RISE_SPEED) * dt, float); }
  else { next = float + (feet - float) * exp(-f32(SETTLE_RATE) * dt); }
  return clamp_f(next, floor_, top);
}

// The pace is verse/water-wade.coax's pace_of.

// ---- breath (water.rs Breath)

hold_seconds :: (con: int) -> f64 {
  c := con; if c < -10 { c = -10; } if c > 20 { c = 20; }
  return fmax(60.0 * f64(1 + c), MIN_HOLD);
}

BREATH_OUT :: 1; BREATH_LEVEL :: 2; BREATH_DEFEAT :: 4; BREATH_BACK :: 8;

// Advances breath by dt with the eye `under` the surface; returns what
// happened as BREATH_* bits.
breath_tick :: (r: [] River, dt: f64, under: bool) -> int {
  if !(dt > 0.0) { return 0; }
  events := 0;
  limit := hold_seconds(CON);
  if !under {
    if r[0].levels > 0 { events = events | BREATH_BACK; r[0].levels = 0; }
    r[0].out = 0.0;
    r[0].breath = fmin(r[0].breath + limit / REFILL * dt, limit);
    return events;
  }
  spare := dt;
  if r[0].breath > 0.0 {
    spent := fmin(spare, r[0].breath);
    r[0].breath -= spent;
    spare -= spent;
    if r[0].breath <= 0.000000001 { r[0].breath = 0.0; events = events | BREATH_OUT; }
  }
  if r[0].breath > 0.0 { return events; }
  r[0].out += spare;
  while r[0].out + 0.000000001 >= ROUND * f64(r[0].levels + 1) {
    r[0].levels += 1;
    if r[0].levels >= DEFEAT_LEVEL {
      events = events | BREATH_DEFEAT;
      r[0].levels = 0; r[0].out = 0.0; r[0].breath = limit;
      break;
    }
    events = events | BREATH_LEVEL;
  }
  return events;
}

// One frame of you in the river: your feet at (x, z) over the carved
// ground, `dive` held, `dt` s, at `time` on the water clock.
everglade_river_swim :: (r: [] River, heights: [] f32, x: f32, z: f32, dive: bool, dt: f32, time: f64) -> Swim #export_c {
  out: Swim;
  out.surface = -1000; out.pace = 1; out.breath = 1; out.medium = MEDIUM_GROUND;
  bed := river_bed(r, heights, x, z);
  out.feet = bed;
  if !r[0].ready { return out; }
  // in a rowboat you are out of the water: you sit, and breathe
  if r[0].aboard >= 0 {
    seat := everglade_river_seat(r);
    _ := breath_tick(r, f64(ifx dt == dt && dt > 0 then lo_f(dt, 0.25) else 0.0f32), false);
    out.medium = MEDIUM_BOAT; out.feet = seat.y;
    sb := water_sample(r[0].set, f64(seat.x), f64(seat.z), river_tick(time));
    out.surface = ifx sb.found then cast(f32) sb.height + r[0].rise else -1000.0f32;
    return out;
  }
  t := ifx dt == dt && dt > 0 then lo_f(dt, 0.25) else 0.0f32;
  s := water_sample(r[0].set, f64(x), f64(z), river_tick(time));
  surface := ifx s.found then cast(f32) s.height + r[0].rise else -1000.0f32;
  // Afloat, you keep your height in the water; on the bed, your feet are on it.
  feet := ifx r[0].afloat then r[0].feet else bed;
  if surface > -999 && surface - bed > f32(SWIM_DEPTH) && !r[0].afloat { feet = hi_f(bed, surface - f32(FLOAT_DEPTH)); }
  medium := medium_of(surface, bed, feet);
  afloat := medium == MEDIUM_SWIMMING || medium == MEDIUM_DIVING;
  if afloat {
    feet = swim_height(feet, surface, bed, ifx dive then -f32(DIVE_SPEED) else 0.0f32, t);
    medium = medium_of(surface, bed, feet);
    afloat = medium == MEDIUM_SWIMMING || medium == MEDIUM_DIVING;
    // you stand again where the bed comes up under a float line
    if afloat && feet <= bed + f32(STANDING) && surface - bed <= f32(SWIM_DEPTH) { afloat = false; medium = MEDIUM_WADING; }
  }
  if !afloat { feet = bed; }
  events := breath_tick(r, f64(t), medium == MEDIUM_DIVING);
  r[0].medium = medium; r[0].feet = feet; r[0].afloat = afloat;
  out.medium = medium; out.feet = feet; out.surface = surface;
  out.pace = pace_of(medium, r[0].levels);
  if afloat && s.found { out.flow_x = cast(f32) s.flow.x * (1 + r[0].flow_boost); out.flow_z = cast(f32) s.flow.z * (1 + r[0].flow_boost); }
  out.breath = cast(f32) (r[0].breath / hold_seconds(CON));
  out.levels = r[0].levels;
  if events & BREATH_DEFEAT != 0 {
    out.defeated = true;
    // the nearer bank, past the water's edge (a pond's, out from its middle past its rim)
    side := ifx x >= f32(RIVER_X) then 1.0f32 else -1.0f32;
    out.bank_x = f32(RIVER_X) + side * 4.4; out.bank_z = z;
    for p: 0..<PONDS {
      px := r[0].ponds[p * 4]; pz := r[0].ponds[p * 4 + 1]; rim := r[0].ponds[p * 4 + 2];
      dx := x - px; dz := z - pz; d := sqrt(dx * dx + dz * dz);
      if rim <= 0 || d > rim + 0.5 { continue; }
      ux := ifx d > 0.01 then dx / d else 1.0f32; uz := ifx d > 0.01 then dz / d else 0.0f32;
      out.bank_x = px + ux * (rim + 1.5); out.bank_z = pz + uz * (rim + 1.5);
    }
    r[0].afloat = false; r[0].medium = MEDIUM_GROUND;
  }
  river_wake(r, x, z, medium, surface, time);
  return out;
}

// ---- ripples, your wake and splash (phase W6's ripple field)

WAKE_EVERY :: 0.35;       // s between the rings you leave moving through water
WAKE_STEP :: 0.25;        // m you must have moved for one

// Rings where you wade or swim and move, and a splash where you come into
// the water from the air or the bank.
river_wake :: (r: [] River, x: f32, z: f32, medium: int, surface: f32, time: f64) {
  t := cast(f32) (time - 3600.0 * floor(time / 3600.0));
  wet := medium != MEDIUM_GROUND && surface > -999;
  if !wet { r[0].splashed = false; return; }
  if !r[0].splashed {
    water_add_ripple(r[0].ripples[..], x, z, t, 0.03);
    fx_spray(r, x, surface, z, 10, 3.2, 0.1);
    r[0].splashed = true; r[0].wake_x = x; r[0].wake_z = z; r[0].wake_time = t;
    return;
  }
  dx := x - r[0].wake_x; dz := z - r[0].wake_z;
  age := t - r[0].wake_time;
  if age < 0 { r[0].wake_time = t; return; }
  if age >= f32(WAKE_EVERY) && dx * dx + dz * dz >= f32(WAKE_STEP) * f32(WAKE_STEP) {
    strength := ifx medium == MEDIUM_WADING then 0.012f32 else 0.018f32;
    if medium == MEDIUM_DIVING { strength = 0.006; }
    water_add_ripple(r[0].ripples[..], x, z, t, strength);
    // a stroke throws a little spray
    if medium == MEDIUM_SWIMMING { fx_spray(r, x, surface, z, 2, 1.4, 0.06); }
    r[0].wake_x = x; r[0].wake_z = z; r[0].wake_time = t;
  }
}

// ---- the floats

// A duck: a ball of 0.16 m radius at 1.1 kg (half under); a lily pad: a disc
// as a 0.5 x 0.03 x 0.5 m slab of 2.6 kg (a third under).
floats_start :: (r: [] River) {
  for i: 0..<RIVER_FLOATS {
    r[0].homes[i * 3] = FLOAT_HOME[i * 2]; r[0].homes[i * 3 + 1] = FLOAT_HOME[i * 2 + 1]; r[0].homes[i * 3 + 2] = 0.0;
    r[0].kinds[i] = ifx i < DUCKS then FLOAT_DUCK else FLOAT_PAD;
  }
  n := RIVER_FLOATS;
  // a pond's duck at its middle, its pads round it at 0.6 of the rim
  for p: 0..<PONDS {
    rim := f64(r[0].ponds[p * 4 + 2]);
    if rim < 2.0 { continue; }
    cx := f64(r[0].ponds[p * 4]); cz := f64(r[0].ponds[p * 4 + 1]);
    for q: 0..<POND_FLOATS {
      a := golden(p * 7 + q) * TAU_D;
      d := ifx q == 0 then 0.0 else rim * 0.6;
      r[0].homes[n * 3] = cx + d * cos(a); r[0].homes[n * 3 + 1] = cz + d * sin(a); r[0].homes[n * 3 + 2] = 0.0;
      r[0].kinds[n] = ifx q == 0 then FLOAT_DUCK else FLOAT_PAD;
      n += 1;
    }
  }
  // the rowboats: 1.9 m in from the rim, along the shore, between the pads
  for p: 0..<PONDS {
    rim := f64(r[0].ponds[p * 4 + 2]);
    if rim < 4.0 || !BOAT_PONDS[p] || n >= FLOATS { continue; }
    cx := f64(r[0].ponds[p * 4]); cz := f64(r[0].ponds[p * 4 + 1]);
    a := (golden(p * 7 + 1) + golden(p * 7 + 2)) * PI_D;
    d := rim - 1.9;
    r[0].homes[n * 3] = cx + d * cos(a); r[0].homes[n * 3 + 1] = cz + d * sin(a);
    r[0].homes[n * 3 + 2] = atan_d2(-sin(a), cos(a));
    r[0].kinds[n] = FLOAT_BOAT;
    n += 1;
  }
  r[0].float_n = n;
  for i: 0..<n {
    x := r[0].homes[i * 3]; z := r[0].homes[i * 3 + 1];
    s := water_sample(r[0].set, x, z, 0);
    y := ifx s.found then s.height else 0.0;
    shape: ColliderShape;
    mass := 0.0;
    inertia := d3(0.0, 0.0, 0.0);
    yaw := golden(i + 5) * TAU_D;
    if r[0].kinds[i] == FLOAT_DUCK {
      shape = shape_sphere(0.16); mass = 1.1;
      m := 0.4 * mass * 0.16 * 0.16; inertia = d3(m, m, m);
    } else if r[0].kinds[i] == FLOAT_BOAT {
      shape = shape_cuboid(BOAT_HALF); mass = BOAT_MASS;
      inertia = rigid_box_inertia(mass, d3(BOAT_HALF.x * 2, BOAT_HALF.y * 2, BOAT_HALF.z * 2));
      yaw = r[0].homes[i * 3 + 2];
    } else {
      shape = shape_cuboid(d3(0.25, 0.015, 0.25)); mass = 2.6;
      inertia = rigid_box_inertia(mass, d3(0.5, 0.03, 0.5));
    }
    r[0].floats[i] = rigid_body(mass, inertia, d3(x, y + 0.02, z), dq_y(yaw));
    r[0].colliders[i] = Collider.{body = i, shape = shape};
  }
  r[0].float_tick = 0; r[0].float_carry = 0.0;
}


// Steps the floats by dt in fixed steps: buoyancy and drag from the water,
// a duck's paddling home and a lily pad's stem; writes each one's x, y, z,
// its yaw, its tip and the way it tips, 0, and its kind (0 a duck, 1 a pad)
// into `out`.
everglade_river_floats :: (r: [] River, dt: f32, out: [] f32) -> int #export_c {
  if !r[0].ready { return 0; }
  if dt == dt && dt > 0 { r[0].float_carry += fmin(f64(dt), 0.25); }
  steps := 0;
  every: [1] bool;
  gravity := d3(0.0, -9.81, 0.0);
  while r[0].float_carry >= FLOAT_STEP && steps < 8 {
    w := rigid_world(FLOAT_STEP, r[0].floats[0..<r[0].float_n]);
    w.tick = r[0].float_tick;
    n := water_apply(w, r[0].colliders[0..<r[0].float_n], r[0].set, w.tick, FLOAT_STEP, water_settings(), every[0..<0], r[0].pushes[..]);
    for i: 0..<r[0].float_n {
      if i == r[0].aboard { r[0].floats[i] = boat_row(r, r[0].floats[i], FLOAT_STEP); continue; }
      r[0].floats[i] = float_steer(r[0].floats[i], i, r[0].kinds[i], r[0].homes[i * 3], r[0].homes[i * 3 + 1], r[0].homes[i * 3 + 2], r[0].float_tick);
      if r[0].field_n > 0 { r[0].floats[i] = float_field(r, r[0].floats[i], i, FLOAT_STEP); }
    }
    w = rigid_step(w, gravity);
    boat_shore(r, r[0].aboard);
    r[0].float_tick = w.tick;
    r[0].float_carry -= FLOAT_STEP;
    steps += 1;
  }
  if r[0].float_carry >= FLOAT_STEP { r[0].float_carry = 0.0; }
  count := 0;
  for i: 0..<r[0].float_n {
    if (count + 1) * 8 > out.count { break; }
    b := r[0].floats[i];
    k := count * 8;
    out[k] = cast(f32) b.pos.x; out[k + 1] = cast(f32) b.pos.y; out[k + 2] = cast(f32) b.pos.z;
    out[k + 3] = cast(f32) yaw_of_q(b.orientation);
    // how far it tips (its up's lean), and which way, about the vertical
    up := dq_rotate(b.orientation, D3_Y);
    out[k + 4] = cast(f32) acos_d(fclamp(up.y, -1.0, 1.0)); out[k + 5] = cast(f32) atan_d2(up.x, up.z); out[k + 6] = 0;
    // a rowboat's oars: the stroke's share while you row it (everglade.coax rowboat), -1 shipped
    if r[0].kinds[i] == FLOAT_BOAT { out[k + 6] = ifx i == r[0].aboard then oar_phase(r[0].oar_t) else -1.0f32; }
    out[k + 7] = f32(r[0].kinds[i]);
    count += 1;
  }
  return count;
}

// A duck paddles toward a point that wanders slowly round its home, up to
// 4 N; a lily pad's stem pulls it back to its anchor like a spring with
// some give, and keeps it from spinning away.
float_steer :: (b: RigidBody, i: int, kind: int, hx: f64, hz: f64, hyaw: f64, tick: u64) -> RigidBody {
  next := b;
  if kind == FLOAT_BOAT {
    // a rowboat on its mooring: a slack line back to where it is tied, and its bow kept along the shore
    m := b.mass;
    fx := ((hx - b.pos.x) * 0.6 - b.vel.x * 1.2) * m;
    fz := ((hz - b.pos.z) * 0.6 - b.vel.z * 1.2) * m;
    ty := (turn_d(hyaw, yaw_of_q(b.orientation)) * 0.5 - b.omega.y * 1.5) * b.inertia.y;
    next.force = d3_add(next.force, d3(fx, 0.0, fz));
    next.torque = d3_add(next.torque, d3(0.0, ty, 0.0));
    return next;
  }
  if kind == FLOAT_DUCK {
    t := f64(tick % 1000000) / 120.0;
    a := t * 0.11 + f64(i) * 2.1;
    // along the river's stretch, or round a pond
    wx := ifx i < DUCKS then 0.8 else 1.8; wz := ifx i < DUCKS then 2.5 else 1.8;
    tx := hx + wx * sin(a); tz := hz + wz * sin(a * 0.7 + 1.0);
    fx := (tx - b.pos.x) * 3.0 - b.vel.x * 2.0;
    fz := (tz - b.pos.z) * 3.0 - b.vel.z * 2.0;
    size := sqrt(fx * fx + fz * fz);
    if size > 4.0 { fx = fx * 4.0 / size; fz = fz * 4.0 / size; }
    next.force = d3_add(next.force, d3(fx, 0.0, fz));
    // and turns to face the way it paddles
    if size > 0.05 { next.torque = d3_add(next.torque, d3(0.0, 0.004 * turn_d(atan_d2(fx, fz), yaw_of_q(b.orientation)), 0.0)); }
    return next;
  }
  fx := (hx - b.pos.x) * 9.0 - b.vel.x * 1.5;
  fz := (hz - b.pos.z) * 9.0 - b.vel.z * 1.5;
  next.force = d3_add(next.force, d3(fx, 0.0, fz));
  return next;
}

// atan2 for the duck's heading, from rigid.coax's atan_d.
atan_d2 :: (x: f64, z: f64) -> f64 {
  if z > 0.0 { return atan_d(x / z); }
  if z < 0.0 { return atan_d(x / z) + ifx x >= 0.0 then PI_D else -PI_D; }
  return ifx x >= 0.0 then PI_D * 0.5 else -PI_D * 0.5;
}
turn_d :: (a: f64, b: f64) -> f64 { d := a - b + PI_D; d = d - TAU_D * floor(d / TAU_D); return d - PI_D; }
// The yaw of an attitude: where it turns +z, about +Y.
yaw_of_q :: (q: DQ) -> f64 {
  f := dq_rotate(q, D3_Z);
  return atan_d2(f.x, f.z);
}


// ---- rowing (the old W6 rowboat: verse/everglade/previous/water.md, "Rowboats")

BOAT_REACH :: 1.2;          // m from the hull's side you may board from (the bank or the water)
BOAT_STROKE :: 1.25;        // s a stroke: 0.8 a second
BOAT_POWER :: 0.45;         // the share of a stroke the blades are in the water
BOAT_THRUST :: 420.0;       // N at the height of a stroke, both oars: a mean of 120 N, about 1.5 m/s
BOAT_DRAG :: 53.0;          // N per (m/s)^2 along the keel
BOAT_SIDE_DRAG :: 600.0;    // N per m/s across it: the keel holds the line
BOAT_TURN :: 480.0;         // N m at the height of a stroke rowing one oar
BOAT_RIDER :: 80.0;         // kg: you, on the middle thwart
BOAT_SEAT :: -0.55;         // your feet under the hull's middle, so you sit at the thwart
BOAT_OARLOCK :: 0.6;        // m out from the keel to each oarlock
BOAT_OAR :: 1.5;            // m from the oarlock to the blade
BOAT_SWEEP :: 0.6;          // rad either side of square a blade sweeps

// Where you sit (Swim's feet for the page) and which way the boat points.
Seat :: struct { on: bool; boat: int; x: f32; y: f32; z: f32; yaw: f32; speed: f32; }

// How far (x, z) lies outside a hull's footprint (0 inside it).
boat_gap :: (b: RigidBody, x: f64, z: f64) -> f64 {
  yaw := yaw_of_q(b.orientation);
  ax := sin(yaw); az := cos(yaw);
  dx := x - b.pos.x; dz := z - b.pos.z;
  along := dx * ax + dz * az; across := dx * az - dz * ax;
  ea := fmax(abs(along) - BOAT_HALF.z, 0.0); ec := fmax(abs(across) - BOAT_HALF.x, 0.0);
  return sqrt(ea * ea + ec * ec);
}

// The rowboat you may board from (x, z): within BOAT_REACH of its hull; -1 none, or you are in one.
everglade_river_boat_near :: (r: [] River, x: f32, z: f32) -> int #export_c {
  if !r[0].ready || r[0].aboard >= 0 { return -1; }
  best := -1; near := BOAT_REACH;
  for i: 0..<r[0].float_n {
    if r[0].kinds[i] != FLOAT_BOAT { continue; }
    d := boat_gap(r[0].floats[i], f64(x), f64(z));
    if d < near { near = d; best = i; }
  }
  return best;
}

// The first rowboat (the Lantern Pond's), -1 none.
everglade_river_first_boat :: (r: [] River) -> int #export_c {
  for i: 0..<r[0].float_n { if r[0].kinds[i] == FLOAT_BOAT { return i; } }
  return -1;
}
// Into rowboat i: you sit at its middle thwart, out of the water.
everglade_river_board :: (r: [] River, i: int) -> bool #export_c {
  if !r[0].ready || i < 0 || i >= r[0].float_n || r[0].kinds[i] != FLOAT_BOAT { return false; }
  r[0].aboard = i; r[0].oar_t = 0; r[0].row_ahead = 0; r[0].row_turn = 0; r[0].oar_wet = false;
  r[0].afloat = false; r[0].medium = MEDIUM_BOAT; r[0].splashed = true; r[0].levels = 0; r[0].out = 0.0;
  return true;
}

// Your seat in the boat you are in (on false: none).
everglade_river_seat :: (r: [] River) -> Seat #export_c {
  out: Seat; out.boat = -1;
  i := r[0].aboard;
  if !r[0].ready || i < 0 { return out; }
  b := r[0].floats[i];
  yaw := yaw_of_q(b.orientation);
  out.on = true; out.boat = i;
  out.x = cast(f32) b.pos.x; out.z = cast(f32) b.pos.z;
  out.y = cast(f32) (b.pos.y + BOAT_SEAT);
  out.yaw = cast(f32) yaw;
  out.speed = cast(f32) sqrt(b.vel.x * b.vel.x + b.vel.z * b.vel.z);
  return out;
}

// What you ask of the oars this frame: ahead (1 forward, -1 back) and turn (1 to starboard).
everglade_river_row :: (r: [] River, ahead: f32, turn: f32) #export_c {
  r[0].row_ahead = ifx ahead == ahead then clamp_f(ahead, -1, 1) else 0.0f32;
  r[0].row_turn = ifx turn == turn then clamp_f(turn, -1, 1) else 0.0f32;
}

// Out of the boat: onto the bank or the shallows within 2.5 m of its hull, else into the water beside
// it (swimming). The boat is tied up where it is. Returns where your feet go.
everglade_river_leave :: (r: [] River, heights: [] f32, time: f64) -> Seat #export_c {
  out: Seat; out.boat = -1;
  i := r[0].aboard;
  if !r[0].ready || i < 0 { return out; }
  b := r[0].floats[i];
  yaw := yaw_of_q(b.orientation);
  ax := sin(yaw); az := cos(yaw);
  best := 1000.0;
  // beside the hull to starboard, if nothing better
  bx := b.pos.x + az * (BOAT_HALF.x + 0.7); bz := b.pos.z - ax * (BOAT_HALF.x + 0.7);
  for k: 0..<32 {
    a := TAU_D * f64(k % 16) / 16.0;
    reach := ifx k < 16 then 1.4 else 2.5;
    // round the hull: its half-size stretched along its length
    px := b.pos.x + ax * cos(a) * (BOAT_HALF.z + reach) + az * sin(a) * (BOAT_HALF.x + reach);
    pz := b.pos.z + az * cos(a) * (BOAT_HALF.z + reach) - ax * sin(a) * (BOAT_HALF.x + reach);
    bed := river_bed(r, heights, cast(f32) px, cast(f32) pz);
    s := water_sample(r[0].set, px, pz, river_tick(time));
    deep := ifx s.found then cast(f32) s.height + r[0].rise - bed else 0.0f32;
    if deep > f32(WADE_DEPTH) { continue; }
    d := (px - b.pos.x) * (px - b.pos.x) + (pz - b.pos.z) * (pz - b.pos.z);
    if d < best { best = d; bx = px; bz = pz; }
  }
  r[0].homes[i * 3] = b.pos.x; r[0].homes[i * 3 + 1] = b.pos.z; r[0].homes[i * 3 + 2] = yaw;
  r[0].aboard = -1; r[0].row_ahead = 0; r[0].row_turn = 0;
  r[0].medium = MEDIUM_GROUND; r[0].afloat = false; r[0].splashed = false;
  out.on = true; out.boat = i;
  out.x = cast(f32) bx; out.z = cast(f32) bz; out.y = river_bed(r, heights, cast(f32) bx, cast(f32) bz);
  out.yaw = cast(f32) yaw;
  return out;
}

// ---- the shore: a rowed boat runs aground at the water's edge, its bow never on the grass

BOAT_DRAFT :: 0.3;          // m of water a hull needs under it (it rides 0.4 m deep, 6 cm of it out)

// Out from each pond's middle along each of its outline's directions, the last place with BOAT_DRAFT of
// water over the bed: past it a hull would be on the bank.
boat_rooms :: (r: [] River, heights: [] f32) {
  for p: 0..<PONDS {
    cx := r[0].ponds[p * 4]; cz := r[0].ponds[p * 4 + 1]; rim := r[0].ponds[p * 4 + 2]; level := r[0].ponds[p * 4 + 3];
    for k: 0..<POND_POINTS {
      a := f32(TAU_D) * f32(k) / f32(POND_POINTS);
      room := 0.0f32;
      d := 0.0f32;
      while d < rim + 1 {
        if level - river_bed(r, heights, cx + d * cos(a), cz + d * sin(a)) < f32(BOAT_DRAFT) { break; }
        room = d;
        d += 0.1;
      }
      r[0].boat_room[p * POND_POINTS + k] = ifx rim > 0 then room else 0.0f32;
    }
  }
}

// How far out a hull may reach from pond p's middle toward (dx, dz), between its outline's directions.
boat_room_at :: (r: [] River, p: int, dx: f32, dz: f32) -> f32 {
  a := cast(f32) atan_d2(f64(dz), f64(dx));
  if a < 0 { a += f32(TAU_D); }
  f := a / f32(TAU_D) * f32(POND_POINTS);
  k := cast(int) floor(f);
  t := f - f32(k);
  k0 := k % POND_POINTS; k1 := (k + 1) % POND_POINTS;
  if k0 < 0 { k0 = 0; }
  return r[0].boat_room[p * POND_POINTS + k0] * (1 - t) + r[0].boat_room[p * POND_POINTS + k1] * t;
}

// Keeps boat i's hull in its pond: its four corners and its bow and stern no further out than the water
// holds it, moving it back and stopping what carries it on toward the bank (it glides along the shore).
boat_shore :: (r: [] River, i: int) {
  if i < 0 || i >= r[0].float_n || r[0].kinds[i] != FLOAT_BOAT { return; }
  b := r[0].floats[i];
  pond := -1;
  for p: 0..<PONDS {
    rim := f64(r[0].ponds[p * 4 + 2]);
    dx := b.pos.x - f64(r[0].ponds[p * 4]); dz := b.pos.z - f64(r[0].ponds[p * 4 + 1]);
    if rim > 0.0 && dx * dx + dz * dz < (rim + 3.0) * (rim + 3.0) { pond = p; }
  }
  if pond < 0 { return; }
  cx := f64(r[0].ponds[pond * 4]); cz := f64(r[0].ponds[pond * 4 + 1]);
  yaw := yaw_of_q(b.orientation);
  ax := sin(yaw); az := cos(yaw);
  worst := 0.0; nx := 0.0; nz := 0.0;
  for c: 0..<6 {
    along := ifx c < 4 then (ifx c % 2 == 0 then BOAT_HALF.z else -BOAT_HALF.z) else (ifx c == 4 then BOAT_HALF.z + 0.1 else -BOAT_HALF.z - 0.1);
    across := ifx c < 4 then (ifx c < 2 then BOAT_HALF.x else -BOAT_HALF.x) else 0.0;
    px := b.pos.x + ax * along + az * across - cx;
    pz := b.pos.z + az * along - ax * across - cz;
    d := sqrt(px * px + pz * pz);
    if d < 0.001 { continue; }
    over := d - f64(boat_room_at(r, pond, cast(f32) px, cast(f32) pz));
    if over > worst { worst = over; nx = px / d; nz = pz / d; }
  }
  if worst <= 0.0 { return; }
  next := b;
  next.pos = d3(b.pos.x - nx * worst, b.pos.y, b.pos.z - nz * worst);
  out := b.vel.x * nx + b.vel.z * nz;
  if out > 0.0 { next.vel = d3(b.vel.x - nx * out, b.vel.y, b.vel.z - nz * out); }
  r[0].floats[i] = next;
}

// The stroke's share now (0 to 1, the power stroke the first BOAT_POWER of it).
oar_phase :: (t: f32) -> f32 { p := t / f32(BOAT_STROKE); return p - floor(p); }

// One fixed step of the boat you row: the oars' thrust and turn through the power stroke, the keel's
// drag along and across, your weight on the thwart.
boat_row :: (r: [] River, b: RigidBody, h: f64) -> RigidBody {
  next := rigid_wake(b);
  asked := r[0].row_ahead != 0 || r[0].row_turn != 0;
  was := oar_phase(r[0].oar_t);
  // the stroke runs while you row, and finishes the one it is in when you stop
  if asked || was > 0.001 { r[0].oar_t += cast(f32) h; }
  phase := oar_phase(r[0].oar_t);
  if !asked && phase < was { r[0].oar_t = 0; phase = 0; }
  power := 0.0;
  if (asked || was > 0.001) && phase < f32(BOAT_POWER) { power = sin(PI_D * f64(phase) / BOAT_POWER); }
  yaw := yaw_of_q(b.orientation);
  ax := sin(yaw); az := cos(yaw);
  along := b.vel.x * ax + b.vel.z * az;
  across := b.vel.x * az - b.vel.z * ax;
  push := BOAT_THRUST * power * f64(r[0].row_ahead) - BOAT_DRAG * along * abs(along);
  side := -BOAT_SIDE_DRAG * across;
  next.force = d3_add(next.force, d3(ax * push + az * side, -BOAT_RIDER * 9.81, az * push - ax * side));
  turn := BOAT_TURN * power * f64(r[0].row_turn) - b.omega.y * b.inertia.y * 1.2;
  next.torque = d3_add(next.torque, d3(0.0, turn, 0.0));
  return next;
}

// The blades' ends now, for spray and drips: side -1 port, 1 starboard; x, z on the water.
oar_blade :: (b: RigidBody, side: f64, phase: f32) -> D2 {
  yaw := yaw_of_q(b.orientation);
  ax := sin(yaw); az := cos(yaw);
  a := oar_sweep(phase);
  out := BOAT_OARLOCK + BOAT_OAR * cos(a);
  ahead := BOAT_OAR * sin(a);
  return d2(b.pos.x + az * side * out + ax * ahead, b.pos.z - ax * side * out + az * ahead);
}
// A blade's sweep (rad from square, toward the bow +): forward to back through the power stroke,
// back to forward over the recovery. everglade.coax rowboat draws the oars from the same numbers.
oar_sweep :: (phase: f32) -> f64 {
  p := f64(phase);
  if p < BOAT_POWER { return BOAT_SWEEP - 2.0 * BOAT_SWEEP * p / BOAT_POWER; }
  return -BOAT_SWEEP + 2.0 * BOAT_SWEEP * (p - BOAT_POWER) / (1.0 - BOAT_POWER);
}

// ---- the particles (W6: spray, mist, drips; W8's steam)

fx_rand :: (r: [] River) -> f32 {
  x := r[0].fx_seed;
  x = x ^ (x << 13); x = x ^ (x >> 17); x = x ^ (x << 5);
  r[0].fx_seed = x;
  return f32(x % 1000000) / 1000000.0;
}
// One particle, in the oldest's place when every one is in use.
fx_add :: (r: [] River, x: f32, y: f32, z: f32, vx: f32, vy: f32, vz: f32, life: f32, size: f32, kind: int) {
  pick := -1; oldest := -1.0f32;
  for i: 0..<FX {
    k := i * FX_FLOATS;
    if r[0].fx[k + 7] <= 0 || r[0].fx[k + 6] >= r[0].fx[k + 7] { pick = i; break; }
    share := r[0].fx[k + 6] / r[0].fx[k + 7];
    if share > oldest { oldest = share; pick = i; }
  }
  k := pick * FX_FLOATS;
  r[0].fx[k] = x; r[0].fx[k + 1] = y; r[0].fx[k + 2] = z;
  r[0].fx[k + 3] = vx; r[0].fx[k + 4] = vy; r[0].fx[k + 5] = vz;
  r[0].fx[k + 6] = 0; r[0].fx[k + 7] = life; r[0].fx[k + 8] = size; r[0].fx[k + 9] = f32(kind);
}
// A burst of n droplets thrown up from (x, y, z), up to `speed` m/s up and half that out.
fx_spray :: (r: [] River, x: f32, y: f32, z: f32, n: int, speed: f32, size: f32) {
  for q: 0..<n {
    a := fx_rand(r) * f32(TAU_D);
    out := speed * (0.25 + 0.35 * fx_rand(r));
    up := speed * (0.55 + 0.45 * fx_rand(r));
    fx_add(r, x, y, z, cos(a) * out, up, sin(a) * out, 0.45 + 0.5 * fx_rand(r), size * (0.6 + 0.8 * fx_rand(r)), FX_SPRAY);
  }
}
fx_live :: (r: [] River) -> int {
  n := 0;
  for i: 0..<FX { k := i * FX_FLOATS; if r[0].fx[k + 7] > 0 && r[0].fx[k + 6] < r[0].fx[k + 7] { n += 1; } }
  return n;
}

// A spell's water where it strikes (W8: everglade-spells.coax): kind 0 a meteor's crown splash and its
// steam, 1 a bolt's flash of steam and spray, 2 a water orb bursting, 3 debris falling in. Rings run
// out from it and floats within reach are thrown back.
SPLASH_CROWN :: 0; SPLASH_BOLT :: 1; SPLASH_ORB :: 2; SPLASH_DEBRIS :: 3;
everglade_river_splash :: (r: [] River, x: f32, z: f32, kind: int, size: f32, time: f64) -> bool #export_c {
  if !r[0].ready { return false; }
  s := water_sample(r[0].set, f64(x), f64(z), river_tick(time));
  if !s.found { return false; }
  y := cast(f32) s.height + r[0].rise;
  t := river_clock(time);
  k := clamp_f(size, 0.2, 6);
  if kind == SPLASH_CROWN {
    fx_spray(r, x, y, z, 22, 7.0, 0.16);
    for q: 0..<6 { fx_add(r, x + (fx_rand(r) - 0.5) * k, y + 0.2, z + (fx_rand(r) - 0.5) * k, (fx_rand(r) - 0.5) * 0.6, 1.4 + fx_rand(r), (fx_rand(r) - 0.5) * 0.6, 3.5, 1.2 + fx_rand(r), FX_STEAM); }
    water_add_ripple(r[0].ripples[..], x, z, t, 0.06);
    water_add_ripple(r[0].ripples[..], x, z, t - 0.35, 0.04);
  } else if kind == SPLASH_BOLT {
    fx_spray(r, x, y, z, 10, 4.0, 0.1);
    for q: 0..<4 { fx_add(r, x + (fx_rand(r) - 0.5), y + 0.1, z + (fx_rand(r) - 0.5), 0, 1.0 + fx_rand(r), 0, 2.2, 0.8 + 0.5 * fx_rand(r), FX_STEAM); }
    water_add_ripple(r[0].ripples[..], x, z, t, 0.04);
  } else if kind == SPLASH_ORB {
    fx_spray(r, x, y, z, 20, 5.0, 0.14);
    water_add_ripple(r[0].ripples[..], x, z, t, 0.06);
    water_add_ripple(r[0].ripples[..], x, z, t - 0.3, 0.035);
  } else {
    fx_spray(r, x, y, z, 6, 2.5, 0.09);
    water_add_ripple(r[0].ripples[..], x, z, t, 0.02);
  }
  // floats within reach are thrown back from it (the orb's splash reaches 2 m and 2.2 its radius); the
  // Water Orb's own water shoves them by its impulse instead (everglade_river_shove)
  if kind == SPLASH_ORB { return true; }
  reach := ifx kind == SPLASH_DEBRIS then 1.0 else 2.0 + 0.6 * f64(k);
  for i: 0..<r[0].float_n {
    b := r[0].floats[i];
    dx := b.pos.x - f64(x); dz := b.pos.z - f64(z);
    d := sqrt(dx * dx + dz * dz);
    if d >= reach { continue; }
    shove := (1.0 - d / reach) * (ifx kind == SPLASH_DEBRIS then 0.5 else 3.0);
    ux := ifx d > 0.01 then dx / d else 1.0; uz := ifx d > 0.01 then dz / d else 0.0;
    r[0].floats[i] = rigid_wake(b);
    r[0].floats[i].vel = d3_add(b.vel, d3(ux * shove, shove * 0.5, uz * shove));
  }
  return true;
}

// The Water Orb's water running out over the floats from where it burst, on the water or the bank
// beside it (everglade-spells.coax sp_orb_hit's physics, for what floats): its `impulse` (N s) is shared
// over its splash, π·reach², each float taking its share by how near it is (none at the edge) and how
// much of its water it meets (its face to the splash: a duck's ball, a pad's rim and the sheet over
// it, a rowboat's side); nothing holds a float but the water, so it rides off at that over its mass,
// never faster than the sheet itself (`sheet` m/s at the middle). Returns how many it moved.
everglade_river_shove :: (r: [] River, x: f32, z: f32, reach: f32, impulse: f32, sheet: f32) -> int #export_c {
  if !r[0].ready || !(reach > 0.0) { return 0; }
  n := 0;
  wide := f64(reach);
  splash := PI_D * wide * wide;
  for i: 0..<r[0].float_n {
    b := r[0].floats[i];
    dx := b.pos.x - f64(x); dz := b.pos.z - f64(z);
    d := sqrt(dx * dx + dz * dz);
    if d >= wide { continue; }
    share := 1.0 - d / wide;
    face := ifx r[0].kinds[i] == FLOAT_DUCK then PI_D * 0.16 * 0.16
            else ifx r[0].kinds[i] == FLOAT_BOAT then BOAT_HALF.y * 2.0 * (BOAT_HALF.x + BOAT_HALF.z)
            else 0.5 * 0.1;
    got := f64(impulse) * share * fmin(face / splash, 1.0);
    dv := fmin(got / b.mass, f64(sheet) * share);
    ux := ifx d > 0.01 then dx / d else 1.0; uz := ifx d > 0.01 then dz / d else 0.0;
    r[0].floats[i] = rigid_wake(b);
    r[0].floats[i].vel = d3_add(b.vel, d3(ux * dv, dv * 0.2, uz * dv));
    n += 1;
  }
  return n;
}

// The spells' fields over the floats (the page's everglade_spell_fields, laid out as verse/
// demolish.coax DemoField: kind, ax, az, bx, bz, base, top, r, wide, force), till the next call.
everglade_river_fields :: (r: [] River, fields: [] f32, n: int) #export_c {
  r[0].field_n = n; if n < 0 { r[0].field_n = 0; } if n > RIVER_FIELDS { r[0].field_n = RIVER_FIELDS; }
  if fields.count < r[0].field_n * RIVER_FIELD_FLOATS { r[0].field_n = fields.count / RIVER_FIELD_FLOATS; }
  for k: 0..<r[0].field_n * RIVER_FIELD_FLOATS { r[0].fields[k] = fields[k]; }
}
// What the fields do to float i over h, besides gravity (as verse/demolish.coax demo_field_accel
// moves the debris): in Reverse Gravity's cylinder it falls upward and hovers under the top; in a
// Wind Wall a duck or a pad (2 kg at most) flies up its updraft held to its middle, a rowboat is
// lightened by 3 m/s². The rowboat you sit in stays on the water.
float_field :: (r: [] River, b: RigidBody, i: int, h: f64) -> RigidBody {
  out := b;
  for k: 0..<r[0].field_n {
    f := r[0].fields[k * RIVER_FIELD_FLOATS..<(k + 1) * RIVER_FIELD_FLOATS];
    kind := cast(int) f[0];
    base := f64(f[5]); top := f64(f[6]);
    if b.pos.y < base - 0.5 || b.pos.y > top + 1.5 { continue; }
    if kind == 1 {
      dx := b.pos.x - f64(f[1]); dz := b.pos.z - f64(f[2]);
      if dx * dx + dz * dz > f64(f[7] * f[7]) { continue; }
      below := top - b.pos.y;
      ay := ifx below > 1.5 then 9.81 else 400.0 * below - 40.0 * b.vel.y;
      out = rigid_wake(out);
      out.vel = d3_add(out.vel, d3(-0.3 * b.vel.x * h, (ay + 9.81) * h, -0.3 * b.vel.z * h));
      return out;
    }
    if kind == 2 {
      if b.pos.y > top { continue; }
      ex := f64(f[3] - f[1]); ez := f64(f[4] - f[2]);
      l2 := fmax(ex * ex + ez * ez, 0.0001);
      u := fclamp(((b.pos.x - f64(f[1])) * ex + (b.pos.z - f64(f[2])) * ez) / l2, 0.0, 1.0);
      l := sqrt(l2); tx := ex / l; tz := ez / l;
      off := (b.pos.x - f64(f[1]) - ex * u) * -tz + (b.pos.z - f64(f[2]) - ez * u) * tx;
      if abs(off) > f64(f[7]) * 0.5 + 0.3 || u <= 0.0 || u >= 1.0 { continue; }
      out = rigid_wake(out);
      if b.mass > 2.0 { out.vel = d3_add(out.vel, d3(0.0, 3.0 * h, 0.0)); continue; }
      om := 6.2831853 * 2.0;
      ang := 6.2831853 * 1.4 * f64(r[0].clock) + f64(i) * 2.4;
      cross := -(om * om * off + 2.0 * om * (b.vel.x * -tz + b.vel.z * tx));
      out.vel = d3_add(out.vel, d3((tx * cos(ang) * 6.0 - tz * (sin(ang) * 6.0 + cross)) * h, 25.0 * h, (tz * cos(ang) * 6.0 + tx * (sin(ang) * 6.0 + cross)) * h));
    }
  }
  return out;
}

// The water's clock folded on the hour, as the ripples keep it.
river_clock :: (time: f64) -> f32 { return cast(f32) (time - 3600.0 * floor(time / 3600.0)); }

// ---- the wakes (W6: Kelvin's wedge and a foam trail behind what moves through the water)

// Mover m is at (x, z) at t (on the folded clock), in the water or not: its head follows it, and
// every WAKE_LAY s it has moved a point is laid behind it. A jump of more than 4 m starts it over.
wake_follow :: (r: [] River, m: int, x: f32, z: f32, t: f32, wet: bool) {
  k := m * WAKE_POINTS * 4;
  tr := r[0].trail[k..<k + WAKE_POINTS * 4];
  dx := x - tr[4]; dz := z - tr[5];
  since := t - r[0].trail_t[m];
  if since < 0 || dx * dx + dz * dz > 16 || tr[6] > t {
    for q: 0..<WAKE_POINTS * 4 { tr[q] = 0; }
    r[0].trail_t[m] = t; since = 0;
    tr[4] = x; tr[5] = z; tr[6] = t;
  }
  // the head: where it is now, how fast since the last point
  gap := sqrt(dx * dx + dz * dz);
  speed := ifx since > 0.02 then gap / since else tr[3];
  tr[0] = x; tr[1] = z; tr[2] = t; tr[3] = ifx wet then lo_f(speed, 4) else 0.0f32;
  if since >= f32(WAKE_LAY) && gap > 0.05 {
    q := WAKE_POINTS - 1;
    while q > 1 { for c: 0..<4 { tr[q * 4 + c] = tr[(q - 1) * 4 + c]; } q -= 1; }
    tr[4] = x; tr[5] = z; tr[6] = t; tr[7] = tr[3];
    r[0].trail_t[m] = t;
  } else if since >= f32(WAKE_LAY) {
    r[0].trail_t[m] = t;
  }
}

// ---- each frame: the wakes and particles move on and are written for the shader

// Steps the wakes and the particles by dt and writes FX_ROWS rows into out: you at (you_x, you_z) in
// `medium` (or the boat you sit in), the eye at (ex, ey, ez).
everglade_river_fx :: (r: [] River, out: [] f32, dt: f32, time: f64, you_x: f32, you_z: f32, medium: int, ex: f32, ey: f32, ez: f32) #export_c {
  if !r[0].ready || out.count < FX_ROWS * 4 { return; }
  h := ifx dt == dt && dt > 0 then lo_f(dt, 0.1) else 0.0f32;
  t := river_clock(time);
  r[0].clock = t;
  // the movers: you (your boat), and the duck nearest the eye
  wet := medium != MEDIUM_GROUND && medium != MEDIUM_DIVING;
  wx := you_x; wz := you_z;
  if r[0].aboard >= 0 { b := r[0].floats[r[0].aboard]; wx = cast(f32) b.pos.x; wz = cast(f32) b.pos.z; wet = true; }
  wake_follow(r, 0, wx, wz, t, wet);
  duck := -1; near := 1000000.0;
  for i: 0..<r[0].float_n {
    if r[0].kinds[i] != FLOAT_DUCK { continue; }
    d := (r[0].floats[i].pos.x - f64(ex)) * (r[0].floats[i].pos.x - f64(ex)) + (r[0].floats[i].pos.z - f64(ez)) * (r[0].floats[i].pos.z - f64(ez));
    if d < near { near = d; duck = i; }
  }
  if duck >= 0 { wake_follow(r, 1, cast(f32) r[0].floats[duck].pos.x, cast(f32) r[0].floats[duck].pos.z, t, true); }
  // the weir: mist over it and its pool, spray where the sheet strikes (only near enough to see)
  wd := (ex - f32(RIVER_X)) * (ex - f32(RIVER_X)) + (ez - f32(WEIR_Z)) * (ez - f32(WEIR_Z));
  if wd < 80 * 80 && h > 0 {
    r[0].mist_carry += h * 3.0;
    while r[0].mist_carry >= 1 {
      r[0].mist_carry -= 1;
      inpool := fx_rand(r) < 0.45;
      mx := ifx inpool then f32(POOL_X) + (fx_rand(r) - 0.5) * 3.0 else r[0].weir[0] + fx_rand(r) * (r[0].weir[1] - r[0].weir[0]);
      mz := ifx inpool then f32(POOL_Z) + (fx_rand(r) - 0.5) * 2.5 else f32(WEIR_Z) - 0.4 - fx_rand(r) * 0.6;
      fx_add(r, mx, r[0].weir[3] + 0.15, mz, (fx_rand(r) - 0.5) * 0.15, 0.12 + 0.12 * fx_rand(r), -0.18 - 0.1 * fx_rand(r), 3.0 + fx_rand(r), 0.9 + 0.7 * fx_rand(r), FX_MIST);
    }
    r[0].foot_carry += h * 7.0;
    while r[0].foot_carry >= 1 {
      r[0].foot_carry -= 1;
      fx_add(r, r[0].weir[0] + 0.3 + fx_rand(r) * (r[0].weir[1] - r[0].weir[0] - 0.6), r[0].weir[3] + 0.02, f32(WEIR_Z) - 0.25 - 0.15 * fx_rand(r),
             (fx_rand(r) - 0.5) * 0.4, 0.9 + 0.9 * fx_rand(r), -0.3 - 0.4 * fx_rand(r), 0.4 + 0.3 * fx_rand(r), 0.05 + 0.05 * fx_rand(r), FX_SPRAY);
    }
  }
  // the oars: a splash at the catch, drips off the blades as they lift
  if r[0].aboard >= 0 && h > 0 {
    b := r[0].floats[r[0].aboard];
    phase := oar_phase(r[0].oar_t);
    wet_now := r[0].oar_t > 0 && phase < f32(BOAT_POWER);
    level := cast(f32) b.pos.y - 0.14;
    if wet_now != r[0].oar_wet {
      for side: 0..<2 {
        p := oar_blade(b, ifx side == 0 then -1.0 else 1.0, phase);
        if wet_now { fx_spray(r, cast(f32) p.x, level, cast(f32) p.y, 3, 1.6, 0.07); water_add_ripple(r[0].ripples[..], cast(f32) p.x, cast(f32) p.y, t, 0.012); }
        else { for q: 0..<3 { fx_add(r, cast(f32) p.x + (fx_rand(r) - 0.5) * 0.2, level + 0.25, cast(f32) p.y + (fx_rand(r) - 0.5) * 0.2, 0, -0.2, 0, 0.5 + 0.3 * fx_rand(r), 0.04, FX_DRIP); } }
      }
      r[0].oar_wet = wet_now;
    }
  }
  // each particle on
  for i: 0..<FX {
    k := i * FX_FLOATS;
    if r[0].fx[k + 7] <= 0 { continue; }
    r[0].fx[k + 6] += h;
    if r[0].fx[k + 6] >= r[0].fx[k + 7] { r[0].fx[k + 7] = 0; continue; }
    kind := cast(int) r[0].fx[k + 9];
    if kind == FX_SPRAY || kind == FX_DRIP { r[0].fx[k + 4] -= 9.81 * h; }
    else if kind == FX_STEAM { r[0].fx[k + 4] *= 1.0 - 0.6 * h; r[0].fx[k + 8] += 0.5 * h; }
    else { r[0].fx[k + 8] += 0.25 * h; }
    for c: 0..<3 { r[0].fx[k + c] += r[0].fx[k + 3 + c] * h; }
  }
  // the rows: the weir, the hulls, the trails, the particles
  out[0] = r[0].weir[0]; out[1] = r[0].weir[1]; out[2] = f32(WEIR_Z); out[3] = 1;
  out[4] = r[0].weir[2] + r[0].rise; out[5] = r[0].weir[3] + r[0].rise; out[6] = f32(RIVER_SPEED) * (1 + r[0].flow_boost) * 1.8; out[7] = 0;
  n := 0;
  for i: 0..<r[0].float_n {
    if r[0].kinds[i] != FLOAT_BOAT || n >= 3 { continue; }
    b := r[0].floats[i];
    k := (2 + n) * 4;
    out[k] = cast(f32) b.pos.x; out[k + 1] = cast(f32) b.pos.z; out[k + 2] = cast(f32) yaw_of_q(b.orientation); out[k + 3] = 1;
    n += 1;
  }
  while n < 3 { k := (2 + n) * 4; for c: 0..<4 { out[k + c] = 0; } n += 1; }
  for q: 0..<WAKE_MOVERS * WAKE_POINTS * 4 { out[20 + q] = r[0].trail[q]; }
  at := 20 + WAKE_MOVERS * WAKE_POINTS * 4;
  for i: 0..<FX {
    k := i * FX_FLOATS;
    o := at + i * 8;
    life := r[0].fx[k + 7];
    if life <= 0 { for c: 0..<8 { out[o + c] = 0; } continue; }
    f := r[0].fx[k + 6] / life;
    kind := cast(int) r[0].fx[k + 9];
    alpha := 0.0f32;
    if kind == FX_SPRAY { alpha = 0.85 * (1 - f * f); }
    else if kind == FX_DRIP { alpha = 0.8; }
    else if kind == FX_MIST { alpha = 0.16 * clamp_f(f * 4, 0, 1) * (1 - f); }
    else { alpha = 0.4 * clamp_f(f * 5, 0, 1) * (1 - f) * (1 - f); }
    out[o] = r[0].fx[k]; out[o + 1] = r[0].fx[k + 1]; out[o + 2] = r[0].fx[k + 2]; out[o + 3] = r[0].fx[k + 8];
    out[o + 4] = f32(kind); out[o + 5] = alpha; out[o + 6] = f; out[o + 7] = 0;
  }
}

// ---- checks

// A test river: the plan's levels as a gentle fall, the bed its carve (a
// V 2.45 m deep at the middle), on the plan's ground grid.
TEST_N :: 104;
test_ground :: (heights: [] f32, levels: [] f32) {
  for j: 0..<TEST_N + 1 {
    z := -104.0f32 + f32(j) * 2;
    levels[j] = -0.6 - (100 - z) * 0.002;
    for i: 0..<TEST_N + 1 {
      x := -104.0f32 + f32(i) * 2;
      d := abs(x - 88);
      h := 1.0f32;
      if d <= 2 { h = levels[j] - 0.25 - 1.95 * (1 - d / 2); }
      else if d < 8 { h = lo_f(1.0, levels[j] - 0.25 + (d - 2)); }
      heights[j * (TEST_N + 1) + i] = h;
    }
  }
}

#test "the medium follows the depth (medium.rs depth_sets_the_medium)" {
  #assert medium_of(-1000, 0, 0) == MEDIUM_GROUND;
  #assert medium_of(0, -0.3, -0.3) == MEDIUM_GROUND;
  #assert medium_of(0, -0.8, -0.8) == MEDIUM_WADING;
  #assert medium_of(0, -2, -f32(FLOAT_DEPTH)) == MEDIUM_SWIMMING;
  #assert medium_of(0, -1, -0.8) == MEDIUM_SWIMMING;
  #assert medium_of(0, -3, -2.5) == MEDIUM_DIVING;
  #assert pace_of(MEDIUM_GROUND, 0) == 1 && pace_of(MEDIUM_WADING, 0) == 0.5 && pace_of(MEDIUM_SWIMMING, 0) == 0.5;
  #assert abs(pace_of(MEDIUM_SWIMMING, 3) - 0.25) < 0.0001 && pace_of(MEDIUM_GROUND, 6) == 0;
}

#test "a swimmer settles, dives to the bed and rises back (medium.rs a_swimmer_settles_dives_and_rises_back)" {
  feet := -0.5f32;
  for k: 0..<240 { feet = swim_height(feet, 0, -3, 0, 1.0 / 120.0); }
  #assert abs(feet + f32(FLOAT_DEPTH)) < 0.01;
  for k: 0..<600 { feet = swim_height(feet, 0, -3, -1.5, 1.0 / 120.0); }
  #assert feet == -3;
  start := feet;
  feet = swim_height(feet, 0, -3, 0, 1);
  #assert abs(feet - start - f32(RISE_SPEED)) < 0.00001;
}

#test "breath: a minute held, a level every 6 s out of it, the sixth defeats (water.rs, SRD 5.2.1)" {
  #assert hold_seconds(-1) == 30 && hold_seconds(0) == 60 && hold_seconds(2) == 180 && hold_seconds(-5) == 30;
  r: [1] River;
  r[0].breath = hold_seconds(CON);
  // 59.5 s under: still breathing
  events := 0;
  for k: 0..<119 { events = events | breath_tick(r[..], 0.5, true); }
  #assert events == 0 && r[0].levels == 0 && abs(r[0].breath - 0.5) < 0.000001;
  #assert breath_tick(r[..], 0.5, true) == BREATH_OUT;
  // a level at the end of each 6 s round
  for k: 0..<11 { events = breath_tick(r[..], 0.5, true); }
  #assert r[0].levels == 0;
  #assert breath_tick(r[..], 0.5, true) == BREATH_LEVEL && r[0].levels == 1;
  // breathing again removes them, and breath refills over 6 s
  #assert breath_tick(r[..], 3.0, false) == BREATH_BACK && r[0].levels == 0 && abs(r[0].breath - 30) < 0.000001;
  #assert breath_tick(r[..], 3.0, false) == 0 && r[0].breath == 60;
  // the sixth level, 36 s out of breath, defeats and leaves you breathing
  for k: 0..<120 { events = breath_tick(r[..], 0.5, true); }
  #assert r[0].breath == 0;
  defeated := false;
  for k: 0..<72 { if breath_tick(r[..], 0.5, true) & BREATH_DEFEAT != 0 { defeated = true; #assert k == 71; } }
  #assert defeated && r[0].levels == 0 && r[0].breath == 60;
}

#test "the river: a body along the carve, its current downstream and round the piles, its nodes over the bed" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  levels: [TEST_N + 1] f32;
  test_ground(heights[..], levels[..]);
  r: [1] River;
  everglade_river_start(r[..], heights[..], levels[..], TEST_N, 2, -104, -104);
  #assert r[0].ready && r[0].bodies[0].flow.nx * r[0].bodies[0].flow.nz <= RIVER_FLOW;
  // the level falls downstream (south), as the plan's levels do
  s0 := water_sample(r[0].set, 88, 40, 0); s1 := water_sample(r[0].set, 88, -40, 0);
  #assert s0.found && s1.found && s0.height > s1.height;
  #assert abs(s1.height - (-0.6 - 140.0 * 0.002)) < 0.08;
  // the current runs south at about the mean speed mid-stream, and parts round a pile
  #assert s1.flow.z < -0.3 && abs(s1.flow.x) < 0.05;
  // beside a pile the stream bends round it
  open := water_sample(r[0].set, 87, -30, 0);
  turned := 0.0;
  for q: 0..<4 {
    at := water_sample(r[0].set, 87 + ifx q == 0 then -1.0 else 0.0, -11 + ifx q == 1 then 1.0 else ifx q == 2 then -1.0 else 0.0, 0);
    if q == 3 { at = water_sample(r[0].set, 88, -11, 0); }
    turned = fmax(turned, abs(at.flow.x - open.flow.x) + abs(at.flow.z - open.flow.z));
  }
  #assert open.found && turned > 0.03;
  // not in the woods' ground beyond the banks
  #assert !water_sample(r[0].set, 92.5, -40, 0).found;
  // nodes: the middle is 2.45 m deep at rest, the bank's dry nodes have no shore distance
  mid := (100 * RIVER_COLS + 6) * WATER_NODE;
  #assert abs(r[0].nodes[mid] - 88) < 0.001 && abs(r[0].nodes[mid + 2] - 4) < 0.001;
  #assert abs(r[0].nodes[mid + 3] - 2.2) < 0.06;
  edge := (100 * RIVER_COLS + 0) * WATER_NODE;
  #assert r[0].nodes[edge + 3] < 0 && r[0].nodes[edge + 4] == 0;
  #assert r[0].nodes[mid + 4] > 1.0 && r[0].nodes[mid + 6] < -0.3;
  // white water down the weir and in its pool, none in the open stream
  pool := 0.0f32; open_foam := 0.0f32;
  for k: 0..<RIVER_COLS * RIVER_ROWS {
    x := r[0].nodes[k * WATER_NODE]; z := r[0].nodes[k * WATER_NODE + 2]; f := r[0].nodes[k * WATER_NODE + 7];
    if abs(x - 88) < 0.6 && abs(z + 33) < 0.6 { pool = hi_f(pool, f); }
    if abs(z + 50) < 0.6 { open_foam = hi_f(open_foam, f); }
  }
  #assert pool > 0.6 && open_foam == 0;
  // the frame the shader finds a node from (everglade.wgsl water_uv) gives each node its column and row
  u: [WATER_FLOATS] f32;
  everglade_river_frame(r[..], u[..], 0, false, 88, 5, -40, 0.001);
  for q: 0..<3 {
    j := q * 100; c := q * 6;
    k := (j * RIVER_COLS + c) * WATER_NODE;
    a := u[W_FRAME + 2];
    tx := sin(a); tz := cos(a);
    dx := r[0].nodes[k] - u[W_FRAME]; dz := r[0].nodes[k + 2] - u[W_FRAME + 1];
    #assert abs((dx * -tz + dz * tx) / u[W_FRAME + 3] - f32(c)) < 0.01 && abs((dx * tx + dz * tz) / u[W_REST + 3] - f32(j)) < 0.01;
  }
}

#test "you wade into the river at half speed, swim in the middle, dive, and come to on the bank" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  levels: [TEST_N + 1] f32;
  test_ground(heights[..], levels[..]);
  r: [1] River;
  everglade_river_start(r[..], heights[..], levels[..], TEST_N, 2, -104, -104);
  // on the bank: ground, full pace
  a := everglade_river_swim(r[..], heights[..], 83.0, -30, false, 1.0 / 60.0, 1.0);
  #assert a.medium == MEDIUM_GROUND && a.pace == 1;
  // a metre and a half from the middle: wading on the bed at half pace
  b := everglade_river_swim(r[..], heights[..], 86.5, -30, false, 1.0 / 60.0, 1.1);
  #assert b.medium == MEDIUM_WADING && b.pace == 0.5 && abs(b.feet - river_bed(r[..], heights[..], 86.5, -30)) < 0.0001;
  // the middle: afloat at the float line, carried south
  c := Swim.{};
  for k: 0..<120 { c = everglade_river_swim(r[..], heights[..], 88.0, -30, false, 1.0 / 60.0, 1.2 + f64(k) / 60.0); }
  #assert c.medium == MEDIUM_SWIMMING && abs(c.feet - (c.surface - f32(FLOAT_DEPTH))) < 0.05 && c.flow_z < -0.2 && c.breath == 1;
  // hold dive: under in about half a second; breath runs down
  for k: 0..<120 { c = everglade_river_swim(r[..], heights[..], 88.0, -30, true, 1.0 / 60.0, 3.2 + f64(k) / 60.0); }
  #assert c.medium == MEDIUM_DIVING && c.breath < 1 && c.feet >= river_bed(r[..], heights[..], 88.0, -30) - 0.0001;
  // stay down past your breath and six rounds: you come to on the nearer bank
  defeated := false; bank := 0.0f32;
  for k: 0..<6000 {
    c = everglade_river_swim(r[..], heights[..], 87.6, -30, true, 0.05, 5.2 + f64(k) * 0.05);
    if c.defeated { defeated = true; bank = c.bank_x; break; }
  }
  #assert defeated && abs(bank - 83.6) < 0.001;
  // let go: you rise and breathe again
  for k: 0..<300 { c = everglade_river_swim(r[..], heights[..], 88.0, -30, false, 1.0 / 30.0, 400.0 + f64(k) / 30.0); }
  #assert c.medium == MEDIUM_SWIMMING && c.levels == 0;
  // the rings: a splash where you came in, then a wake as you move
  live := 0;
  for i: 0..<RIVER_RIPPLES { if r[0].ripples[i * 4 + 3] > 0 { live += 1; } }
  #assert live >= 1;
}

#test "ducks and lily pads float on the river by buoyancy and keep to the glade" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  levels: [TEST_N + 1] f32;
  test_ground(heights[..], levels[..]);
  r: [1] River;
  everglade_river_start(r[..], heights[..], levels[..], TEST_N, 2, -104, -104);
  out: [FLOATS * 8] f32;
  n := 0;
  for k: 0..<150 { n = everglade_river_floats(r[..], 1.0 / 60.0, out[..]); }
  #assert n == RIVER_FLOATS;
  for i: 0..<RIVER_FLOATS {
    x := out[i * 8]; y := out[i * 8 + 1]; z := out[i * 8 + 2];
    s := water_sample(r[0].set, f64(x), f64(z), r[0].float_tick);
    #assert s.found;
    // afloat at the surface, not sunk, not flown
    #assert abs(f64(y) - s.height) < 0.12;
    // and within a few metres of home against a 0.45 m/s current
    hx := cast(f32) FLOAT_HOME[i * 2]; hz := cast(f32) FLOAT_HOME[i * 2 + 1];
    #assert sqrt((x - hx) * (x - hx) + (z - hz) * (z - hz)) < 4;
    #assert out[i * 8 + 7] == ifx i < DUCKS then 0.0f32 else 1.0f32;
  }
}

#test "a pond: still water over its bowl, waded at its shallows, swum in its middle, a bank to come to past its rim" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  all: [TEST_N + 1 + PONDS * 4] f32;
  test_ground(heights[..], all[..]);
  // a bowl 3 m deep under a level of 0.75 at (-40, 20), rim 6 m (plan.coax everglade_pond_bed)
  for j: 0..<TEST_N + 1 {
    for i: 0..<TEST_N + 1 {
      x := -104.0f32 + f32(i) * 2; z := -104.0f32 + f32(j) * 2;
      d := sqrt((x + 40) * (x + 40) + (z - 20) * (z - 20));
      t := d / 6;
      bed := ifx d < 6 then 0.75 + 0.25 - 3.25 * (1 - t * t) else 1.0 + (d - 6) * 0.7;
      heights[j * (TEST_N + 1) + i] = lo_f(heights[j * (TEST_N + 1) + i], bed);
    }
  }
  k := TEST_N + 1;
  all[k] = -40; all[k + 1] = 20; all[k + 2] = 6; all[k + 3] = 0.75;
  r: [1] River;
  everglade_river_start(r[..], heights[..], all[..], TEST_N, 2, -104, -104);
  s := water_sample(r[0].set, -40, 20, 0);
  #assert s.found && abs(s.height - 0.75) < 0.0001 && water_still(s);
  #assert !water_sample(r[0].set, -40, 28, 0).found;
  // the middle swims, the shallows wade
  w := everglade_river_swim(r[..], heights[..], -40, 20, false, 0.1, 0);
  #assert w.medium == MEDIUM_SWIMMING && w.pace == 0.5 && w.flow_x == 0 && w.flow_z == 0;
  r[0].afloat = false;
  shallow := everglade_river_swim(r[..], heights[..], -35, 20, false, 0.1, 0);
  #assert shallow.medium == MEDIUM_WADING || shallow.medium == MEDIUM_GROUND;
  // out of breath at the bottom, you come to on its bank
  r[0].afloat = false;
  for n: 0..<400 { w = everglade_river_swim(r[..], heights[..], -40, 20, true, 0.25, 0); if w.defeated { break; } }
  #assert w.defeated;
  #assert abs(sqrt((w.bank_x + 40) * (w.bank_x + 40) + (w.bank_z - 20) * (w.bank_z - 20)) - 7.5) < 0.01;
  // its duck, three lily pads and moored rowboat float on it and stay inside its rim
  out: [FLOATS * 8] f32;
  n := 0;
  for q: 0..<150 { n = everglade_river_floats(r[..], 1.0 / 60.0, out[..]); }
  #assert n == RIVER_FLOATS + POND_FLOATS + 1;
  for i: RIVER_FLOATS..<n {
    x := out[i * 8]; y := out[i * 8 + 1]; z := out[i * 8 + 2]; kind := out[i * 8 + 7];
    #assert sqrt((x + 40) * (x + 40) + (z - 20) * (z - 20)) < 5.5;
    #assert kind == ifx i == RIVER_FLOATS then 0.0f32 else ifx i == n - 1 then 2.0f32 else 1.0f32;
    // a boat rides with its 0.4 m hull 6 cm under (220 kg over 3.5 square metres), level, its bow along the shore
    if kind == 2 {
      #assert abs(y - (0.75 + 0.2 - 0.0625)) < 0.05 && out[i * 8 + 4] < 0.05;
      #assert abs(turn_d(f64(out[i * 8 + 3]), r[0].homes[i * 3 + 2])) < 0.1;
      #assert sqrt((x - f32(r[0].homes[i * 3])) * (x - f32(r[0].homes[i * 3])) + (z - f32(r[0].homes[i * 3 + 1])) * (z - f32(r[0].homes[i * 3 + 1]))) < 0.3;
    } else {
      #assert abs(y - 0.75) < 0.12;
    }
  }
}

// The pond test's bowl: 3 m deep under a level of 0.75 at (-40, 20), rim 6 m.
test_pond :: (heights: [] f32, all: [] f32) {
  test_ground(heights, all);
  for j: 0..<TEST_N + 1 {
    for i: 0..<TEST_N + 1 {
      x := -104.0f32 + f32(i) * 2; z := -104.0f32 + f32(j) * 2;
      d := sqrt((x + 40) * (x + 40) + (z - 20) * (z - 20));
      t := d / 6;
      bed := ifx d < 6 then 0.75 + 0.25 - 3.25 * (1 - t * t) else 1.0 + (d - 6) * 0.7;
      heights[j * (TEST_N + 1) + i] = lo_f(heights[j * (TEST_N + 1) + i], bed);
    }
  }
  k := TEST_N + 1;
  all[k] = -40; all[k + 1] = 20; all[k + 2] = 6; all[k + 3] = 0.75;
}

#test "you board the pond's rowboat, row it ahead and round, and step ashore on its bank" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  all: [TEST_N + 1 + PONDS * 4] f32;
  test_pond(heights[..], all[..]);
  r: [1] River;
  everglade_river_start(r[..], heights[..], all[..], TEST_N, 2, -104, -104);
  out: [FLOATS * 8] f32;
  for q: 0..<30 { fl := everglade_river_floats(r[..], 1.0 / 60.0, out[..]); }
  boat := everglade_river_first_boat(r[..]);
  #assert boat >= 0;
  b0 := r[0].floats[boat];
  // near its hull you may board it; far off not
  #assert everglade_river_boat_near(r[..], cast(f32) b0.pos.x + 1.4, cast(f32) b0.pos.z) == boat || everglade_river_boat_near(r[..], cast(f32) b0.pos.x, cast(f32) b0.pos.z + 1.4) == boat;
  #assert everglade_river_boat_near(r[..], cast(f32) b0.pos.x + 9, cast(f32) b0.pos.z + 9) == -1;
  #assert everglade_river_board(r[..], boat) && r[0].aboard == boat;
  #assert everglade_river_boat_near(r[..], cast(f32) b0.pos.x, cast(f32) b0.pos.z) == -1;
  // seated: the boat's medium, your feet at its thwart, breath full
  sw := everglade_river_swim(r[..], heights[..], cast(f32) b0.pos.x, cast(f32) b0.pos.z, true, 1.0 / 60.0, 1);
  #assert sw.medium == MEDIUM_BOAT && sw.breath == 1;
  seat := everglade_river_seat(r[..]);
  #assert seat.on && seat.boat == boat && abs(seat.y - cast(f32) (b0.pos.y + BOAT_SEAT)) < 0.01;
  // two seconds rowing ahead: it moves along its bow at a walking pace, the oars swing
  yaw0 := yaw_of_q(b0.orientation);
  everglade_river_row(r[..], 1, 0);
  oars := false;
  for q: 0..<120 { fl := everglade_river_floats(r[..], 1.0 / 60.0, out[..]); if out[boat * 8 + 6] > 0.1 { oars = true; } }
  b1 := r[0].floats[boat];
  ahead := (b1.pos.x - b0.pos.x) * sin(yaw0) + (b1.pos.z - b0.pos.z) * cos(yaw0);
  speed := everglade_river_seat(r[..]).speed;
  #assert oars && ahead > 0.4 && speed > 0.2 && speed < 2.5;
  // rowing round turns it, and it stays afloat in the pond
  everglade_river_row(r[..], 0, 1);
  for q: 0..<90 { fl := everglade_river_floats(r[..], 1.0 / 60.0, out[..]); }
  b2 := r[0].floats[boat];
  #assert abs(turn_d(yaw_of_q(b2.orientation), yaw_of_q(b1.orientation))) > 0.2;
  #assert sqrt((b2.pos.x + 40) * (b2.pos.x + 40) + (b2.pos.z - 20) * (b2.pos.z - 20)) < 6;
  // ashore: within reach of the hull, no deeper than a wade; the boat stays tied up there
  off := everglade_river_leave(r[..], heights[..], 10);
  #assert off.on && r[0].aboard == -1;
  gx := f64(off.x) - b2.pos.x; gz := f64(off.z) - b2.pos.z;
  #assert sqrt(gx * gx + gz * gz) < 5;
  #assert abs(r[0].homes[boat * 3] - b2.pos.x) < 0.001 && everglade_river_boat_near(r[..], cast(f32) b2.pos.x + 9, cast(f32) b2.pos.z + 9) == -1;
}

#test "rowed into the bank, the boat stops at the water's edge: no corner of its hull over the grass" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  all: [TEST_N + 1 + PONDS * 4] f32;
  test_pond(heights[..], all[..]);
  r: [1] River;
  everglade_river_start(r[..], heights[..], all[..], TEST_N, 2, -104, -104);
  // the water holds a hull out to about 5.6 m of the 6 m rim, the same all round
  for k: 0..<POND_POINTS { #assert r[0].boat_room[k] > 4.5 && r[0].boat_room[k] < 6.0; }
  out: [FLOATS * 8] f32;
  boat := everglade_river_first_boat(r[..]);
  #assert everglade_river_board(r[..], boat);
  // rowing hard straight ahead along the shore it is tied to: it reaches the bank and stops there
  start := r[0].floats[boat].pos;
  everglade_river_row(r[..], 1, 0);
  for q: 0..<200 { fl := everglade_river_floats(r[..], 1.0 / 60.0, out[..]); }
  b := r[0].floats[boat];
  yaw := yaw_of_q(b.orientation);
  ax := sin(yaw); az := cos(yaw);
  touching := -10.0;
  for c: 0..<4 {
    along := ifx c % 2 == 0 then BOAT_HALF.z else -BOAT_HALF.z;
    across := ifx c < 2 then BOAT_HALF.x else -BOAT_HALF.x;
    px := b.pos.x + ax * along + az * across; pz := b.pos.z + az * along - ax * across;
    bed := river_bed(r[..], heights[..], cast(f32) px, cast(f32) pz);
    #assert 0.75 - bed > f32(BOAT_DRAFT) - 0.06;
    touching = fmax(touching, sqrt((px + 40) * (px + 40) + (pz - 20) * (pz - 20)) - f64(boat_room_at(r[..], 0, cast(f32) (px + 40), cast(f32) (pz - 20))));
  }
  // and it is at the bank: a corner at the water's edge
  #assert touching > -0.1;
  // it went somewhere first, and at the bank it is not carried on into it
  #assert sqrt((b.pos.x - start.x) * (b.pos.x - start.x) + (b.pos.z - start.z) * (b.pos.z - start.z)) > 0.4;
  #assert abs(b.vel.x * (b.pos.x + 40) + b.vel.z * (b.pos.z - 20)) / sqrt((b.pos.x + 40) * (b.pos.x + 40) + (b.pos.z - 20) * (b.pos.z - 20)) < 0.2;
}

#test "a wake trail lays behind what moves on the water, and the spray stays bounded" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  levels: [TEST_N + 1] f32;
  test_ground(heights[..], levels[..]);
  r: [1] River;
  everglade_river_start(r[..], heights[..], levels[..], TEST_N, 2, -104, -104);
  u: [FX_ROWS * 4] f32;
  // a swimmer heading south at 1 m/s for 3 s
  for q: 0..<180 { everglade_river_fx(r[..], u[..], 1.0 / 60.0, 10 + f64(q) / 60.0, 88, -30 - f32(q) / 60.0, MEDIUM_SWIMMING, 88, 5, -40); }
  laid := 0;
  for p: 1..<WAKE_POINTS { if u[20 + p * 4 + 2] > 0 { laid += 1; } }
  #assert laid >= 5 && abs(u[20 + 3] - 1) < 0.2;
  // the trail's points run back up the swimmer's path, oldest farthest
  #assert u[20 + 4 * 4 + 1] > u[20 + 1 * 4 + 1];
  // out of the water: no wake
  everglade_river_fx(r[..], u[..], 1.0 / 60.0, 13.1, 84, -33, MEDIUM_GROUND, 88, 5, -40);
  #assert u[20 + 3] == 0;
  // a hundred splashes and a minute by the weir: never more than FX particles, all of them finite
  for q: 0..<100 { hit := everglade_river_splash(r[..], 88, -40, q % 4, 3, 14); }
  for q: 0..<600 { everglade_river_fx(r[..], u[..], 0.1, 14 + f64(q) * 0.1, 84, -33, MEDIUM_GROUND, 88, 2, -36); }
  live := 0;
  at := 20 + WAKE_MOVERS * WAKE_POINTS * 4;
  for i: 0..<FX {
    o := at + i * 8;
    if u[o + 5] > 0 { live += 1; #assert u[o] == u[o] && u[o + 1] > -10 && u[o + 1] < 20 && u[o + 6] <= 1; }
  }
  #assert live > 0 && live <= FX && r[0].weir[1] > r[0].weir[0] && r[0].weir[2] > r[0].weir[3];
  // a splash off the water does nothing
  #assert !everglade_river_splash(r[..], 0, 0, SPLASH_ORB, 3, 20);
}

#test "the Water Orb's water shoves a pond's duck, pads and rowboat by its impulse: the light ones far, the boat a little" {
  heights: [(TEST_N + 1) * (TEST_N + 1)] f32;
  all: [TEST_N + 1 + PONDS * 4] f32;
  test_pond(heights[..], all[..]);
  r: [1] River;
  everglade_river_start(r[..], heights[..], all[..], TEST_N, 2, -104, -104);
  out: [FLOATS * 8] f32;
  for q: 0..<30 { fl := everglade_river_floats(r[..], 1.0 / 60.0, out[..]); }
  boat := everglade_river_first_boat(r[..]);
  #assert boat >= 0;
  // the orb's blow (everglade-spells.coax everglade_orb_impulse: 1000 kg/m³ · ⁴⁄₃π·0.8³ · 12 m/s)
  impulse := 1000.0f32 * 4.0 / 3.0 * 3.14159265 * 0.512 * 12.0;
  for i: 0..<r[0].float_n { r[0].floats[i].vel = d3(0.0, 0.0, 0.0); }
  // bursting 1.5 m from the boat and from the pond's duck in turn (beside each, so the push is outward)
  b := r[0].floats[boat];
  #assert everglade_river_shove(r[..], cast(f32) b.pos.x - 1.5, cast(f32) b.pos.z, 3, impulse, 6) >= 1;
  boat_v := r[0].floats[boat].vel.x;
  // a 220 kg hull meets a tonne of water side on: it moves off, away from the burst, slower than the sheet
  #assert boat_v > 0.3 && boat_v < 3.0;
  duck := -1;
  for i: 0..<r[0].float_n { if r[0].kinds[i] == FLOAT_DUCK && i >= RIVER_FLOATS { duck = i; break; } }
  #assert duck >= 0;
  for i: 0..<r[0].float_n { r[0].floats[i].vel = d3(0.0, 0.0, 0.0); }
  d := r[0].floats[duck];
  #assert everglade_river_shove(r[..], cast(f32) d.pos.x, cast(f32) d.pos.z - 1.5, 3, impulse, 6) >= 1;
  // a 1.1 kg duck rides off with the sheet itself, half of it at half the reach
  #assert abs(r[0].floats[duck].vel.z - 3.0) < 0.01 && abs(r[0].floats[duck].vel.x) < 0.01;
  // beyond its reach nothing moves; off the water there is nothing to move
  for i: 0..<r[0].float_n { r[0].floats[i].vel = d3(0.0, 0.0, 0.0); }
  #assert everglade_river_shove(r[..], cast(f32) d.pos.x + 40, cast(f32) d.pos.z + 40, 3, impulse, 6) == 0;
}
