// Everglade's town watch and what the town does about a crime (eg-watch).
//
// The watch: the two gate guards of routines.coax (Bram and Tilda) and six
// more, each on a beat of their own, there and back on the town's shared
// clock as the gate guards walk theirs: Inn Street, the commons, the
// market, Guild Row out to the West Gate, the East Gate, and the North Gate.
// They are Quaternius people (folk.coax) in the Ranger's leathers with its
// pauldrons and bracers, dyed the watch's crimson, with the Fantasy Props
// kit's bronze sword and wooden shield: SRD 5.2.1 Guards (verse/rules/
// srd5-combat.coax).
//
// A crime (watch_crime): a spell that breaks or strikes a building piece,
// or that hits a person. A guard who sees it (within WATCH_SIGHT and no
// building, wall or the palisade between, at the blast or at you) or hears
// it (a blast carries: WATCH_HEAR by spell) turns on you, shouts and comes
// running; with one on you, you are WANTED. Townsfolk who see it run from
// you and cower; the brave few (the smith, the fighters' master, the
// rangers' warden) come at you with their fists. Out of every hunting
// guard's sight for WANTED_LOSE seconds, or dead, you are wanted no more,
// and the watch walk back to their beats.
//
// The fight (the combat model, `0b401561a0^:docs/verse/combat-model.md`:
// real time, dice behind the scenes): a guard in reach swings every
// SWING_EVERY seconds, its blow landing STRIKE_AT into the swing as an SRD
// attack roll against your AC (15, a 5th-level Ranger's), 1d6 + 1 on a hit.
// You have 44 HP; at 0 the view fades, YOU DIED, and you stand at the Road
// In again whole. A spell's blast hits everyone in it (its damage rolled once,
// a Dexterity save for half, as srd5.coax's objects take it): one who
// lives is knocked down (the SRD's Prone, PRONE_SECONDS, then they get up),
// one at 0 HP falls dead. A dead guard is back on their beat GUARD_BACK
// seconds later (more of the watch come); the townsfolk lie where they fell
// until R (the spell bar's Rebuild) or the next dawn.
//
// Fit: the watch's beats are a pure function of the shared clock, so every
// visitor sees the same town at peace; a crime and what follows are this
// page's alone, as what a player breaks is (everglade-spells.coax), so one
// visitor's fight never troubles another's town. A still page (a golden)
// has no crime and holds everyone at their posts. Everything here is fixed
// pools; the dice are seeded (srd5.coax), so a fight replays exactly.
//   coax/bin/coax test --library verse/everglade/watch.coax --steps 2000000000

#load "plan.coax";
#load "routines.coax";
#load "people-rig.coax";
#load "../rules/srd5-combat.coax";

WATCH_NEW :: 6;                        // the watch past the two gate guards
WATCH_REIN :: 10;                      // the heat's reinforcements at most at once (WANTED levels 2 to 5)
WATCH_FIRST_REIN :: EG_SPOTS + WATCH_NEW;
WATCH_ACTORS :: EG_SPOTS + WATCH_NEW + WATCH_REIN;  // everyone who can be hurt: the spots' people, the new watch, the reinforcements
WATCH_SIGHT :: 34.0;      // m a guard sees a crime or you
WATCH_EYE :: 1.6;         // m up their eyes are
WATCH_HEAR :: [4] f32.[85.0, 60.0, 85.0, 22.0];   // m a blast carries: the meteors, the bolt, the mega bolt, the orb's splash
FOLK_SEE :: 26.0;         // m townsfolk see a crime from
GUARD_RUN :: 5.0;         // m/s a guard runs (you run 7.5: you can get away)
BRAVE_RUN :: 4.2;
FLEE_RUN :: 3.8;
BACK_WALK :: 1.4;         // m/s walking back to their day
REACH :: 1.5;             // m from you a blow reaches
SWING :: 1.5333333;       // s the sword's swing (people-rig PEOPLE_SLASH) and its rest after
SWING_EVERY :: 1.9;
STRIKE_AT :: 0.62;        // s into the swing its blow lands
PUNCH :: 1.5333333;       // s a bare-handed swing (the sword's clip, PEOPLE_SLASH)
PUNCH_EVERY :: 2.2;
PUNCH_AT :: 0.62;
PRONE_SECONDS_W :: 1.5;   // the combat model's knocked-down debuff (srd5.coax PRONE_SECONDS)
KNOCK :: 0.8333333;       // s the fall (PEOPLE_KNOCK)
RISE :: 0.8;              // s getting up (a blend back to PEOPLE_IDLE)
DIE :: 2.4;               // s the fall dead (PEOPLE_DIE)
FLEE_FOR :: 5.0;          // s they run before they cower
CALM_AFTER :: 9.0;        // s with you no longer wanted before the frightened walk back
COWER_NEAR :: 5.0;        // m: nearer than this to a cowering one, they run again
WANTED_LOSE :: 18.0;      // s out of every hunter's sight and you are wanted no more
GUARD_BACK :: 40.0;       // s after a guard falls another takes their beat
SHOUT_FOR :: 2.6;         // s a shout shows
DEATH_FADE :: 1.2;        // s the view takes to go dark
DEATH_HOLD :: 2.2;        // s YOU DIED shows before you stand again
RISE_FADE :: 0.8;         // s the view takes to come back
SAVE_DC_W :: 15;          // a spell's DC (everglade-spells.coax SP_DC)
BLAST_PAD :: 0.4;         // m: a body's half width, what a blast reaches past its edge
// Reach is in three dimensions: a blow lands only on a body whose span (feet to head, BODY_TALL) comes
// within REACH of the swinger's; one out of it above them (Levitate, a roof, a Wind Wall's throw, Reverse
// Gravity) is out of reach of a sword. A guard below throws a spear at you instead (SRD 5.2.1 Guard:
// Spear, ranged 20/60 ft, +3 to hit, 1d6 + 1 piercing, with disadvantage past 20 ft) and shouts at you.
BODY_TALL :: 1.8;
SPEAR_NEAR :: 6.096;      // m: 20 ft, the spear's normal range
SPEAR_FAR :: 18.288;      // m: 60 ft, its long range
SPEAR_EVERY :: 3.2;       // s between throws (each guard carries a few)
SPEAR_AT :: 0.55;         // s into the throw it leaves the hand
SPEAR_SPEED :: 16.0;      // m/s it flies
SPEARS :: 8;
UP_SHOUT :: 101;          // the line a guard shouts up at you (WATCH_UP_SHOUT)
WATCH_UP_SHOUT :: "COME DOWN AND FACE ME!";
// A body a blast throws (Tumble): the whole body as one rigid thing about its pelvis, tumbling end over
// end under gravity, bouncing on the ground (the walkable height: the bridge's deck too) and off walls,
// sliding to rest and rolling onto its back, as verse/demolish.coax throws the debris. Then the clip's
// lying pose (PEOPLE_KNOCK or PEOPLE_DIE end on their backs, the pelvis TUMBLE_LIE_BACK m behind the feet)
// blends in over TUMBLE_SETTLE as the rigid turn blends out.
TUMBLE_PELVIS :: 0.95;    // m the pelvis stands over the feet
TUMBLE_LIE :: 0.15;       // m it lies over the ground
TUMBLE_LIE_BACK :: 0.3;
TUMBLE_SETTLE :: 0.3;
TUMBLE_STEP :: 0.008333333;
TUMBLE_LONGEST :: 6.0;    // s at most in the air and sliding
TUMBLE_G :: 9.81;
// How hard each spell's blast throws a body at its heart (m/s), as SP_THROW throws debris, a person
// heavier than a chunk: the meteors, the bolt, the mega bolt, the orb's water.
WATCH_THROW :: [4] f32.[13.0, 9.0, 15.0, 7.5];
Tumble :: struct {
  on: bool;                       // in the air or sliding
  x: f32; y: f32; z: f32;         // the pelvis, in the world
  vx: f32; vy: f32; vz: f32;
  yaw: f32; pitch: f32; spin: f32;   // facing, the tumble about the body's side (negative falls back), its rate
  age: f32; still_t: f32;
  settle: f32;                    // s since it came to rest (the lying pose blends in), -1 never thrown
}
Spear :: struct { live: bool; ax: f32; ay: f32; az: f32; bx: f32; by: f32; bz: f32; t: f32; flight: f32; hit: bool; damage: int; }

// ---- the heat: WANTED levels 1 to 5 (SRD 5.2.1 stat blocks, verse/rules/srd5-combat.coax)
//   1  the town watch
//   2  more guards and Warrior Veterans
//   3  Mages, who cast at you from range: Fire Bolt, Ray of Frost, Hold Person, Fireball
//   4  Knights and a Priest, who heals the watch and casts Guiding Bolt and Spiritual Weapon
//   5  an elite company: an Archmage (Lightning Bolt, Cone of Cold) and Gladiators
// Heat comes from crimes (HEAT_CRIME each), and from hunters you knock down (HEAT_DOWN) or kill
// (HEAT_KILL); a level reached sends its wave in from the gate nearest you, never past HUNTERS_MAX
// hunting at once. Out of every hunter's sight for longer the higher it is (WANTED_LOSE, then half
// again a level), or dead, and it clears: the reinforcements walk back out of their gate.
RANK_GUARD :: 0; RANK_VETERAN :: 1; RANK_MAGE :: 2; RANK_KNIGHT :: 3; RANK_PRIEST :: 4; RANK_ARCHMAGE :: 5; RANK_GLADIATOR :: 6;
RANKS :: 7;
RANK_NAME :: [7] string.["GUARD", "VETERAN", "MAGE", "KNIGHT", "PRIEST", "ARCHMAGE", "GLADIATOR"];
RANK_ATTACKS :: [7] int.[1, 2, 1, 2, 1, 1, 3];     // Multiattack: the attack rolls in a swing
RANK_CASTER :: [7] bool.[false, false, true, false, true, true, false];
RANK_DC :: [7] int.[0, 0, 14, 0, 13, 17, 0];
HEAT_CRIME :: 1; HEAT_DOWN :: 2; HEAT_KILL :: 4;
HEAT_AT :: [6] int.[0, 0, 8, 18, 32, 50];          // the heat a level needs (by level)
HUNTERS_MAX :: 12;
WANTED_LEVELS :: 5;
// Each level's wave: up to four ranks (-1 none).
WAVE :: [24] int.[
  -1, -1, -1, -1,   -1, -1, -1, -1,
  RANK_GUARD, RANK_GUARD, RANK_VETERAN, RANK_VETERAN,
  RANK_VETERAN, RANK_MAGE, RANK_MAGE, -1,
  RANK_KNIGHT, RANK_KNIGHT, RANK_PRIEST, -1,
  RANK_ARCHMAGE, RANK_GLADIATOR, RANK_GLADIATOR, RANK_GLADIATOR
];
// The gates a wave comes in by, just inside each: the South, West, East and North Gates.
WATCH_GATE :: [8] f32.[0.0, -51.0,   -59.0, 0.0,   59.0, 0.0,   44.0, 55.0];
// The casters' spells (SRD 5.2.1) as missiles in the air.
MS_SPEAR :: 0; MS_FIRE_BOLT :: 1; MS_FROST :: 2; MS_HOLD :: 3; MS_FIREBALL :: 4; MS_GUIDING :: 5; MS_WEAPON :: 6;
MS_LIGHTNING :: 7; MS_COLD :: 8; MS_HEAL :: 9;
MISSILES :: 12;
MS_SPEED :: 22.0;          // m/s a bolt flies (you can step out of its way)
MS_DODGE :: 1.4;           // m from where it was aimed that it still finds you
CAST_WIND :: 0.8;          // s a caster's hands glow before the spell leaves them
CAST_EVERY :: [7] f32.[0, 0, 3.6, 0, 4.4, 3.2, 0];
CAST_RANGE :: 34.0;        // m (their sight; the SRD's 120 ft)
CAST_NEAR :: 8.0; CAST_FAR :: 15.0;   // m a caster keeps from you
FIREBALL_R :: 6.096;       // 20 ft
LIGHTNING_LONG :: 30.48; LIGHTNING_WIDE :: 1.524;   // 100 by 5 ft
CONE_LONG :: 18.288;       // 60 ft
HOLD_FOR :: 3.0;           // s held before your next save (at most HOLD_SAVES of them)
HOLD_SAVES :: 2;
FROST_FOR :: 6.0; FROST_PACE :: 0.67;   // Ray of Frost: 10 ft off your 30 for a round
WEAPON_FOR :: 15.0; WEAPON_EVERY :: 2.0;
// Their looks: which kit clothes them (folk.coax PART_*), dyed by rank.
RANK_DYE :: [28] f32.[
  0.32, 0.03, 0.025, 1,   0.07, 0.075, 0.085, 1,   0.05, 0.07, 0.42, 1,   0.62, 0.62, 0.64, 1,
  0.86, 0.76, 0.42, 1,    0.2, 0.03, 0.32, 1,      0.46, 0.25, 0.07, 1
];
RANK_HOOD :: [7] bool.[false, false, true, false, true, true, false];
RANK_BARE :: [7] bool.[false, false, false, false, false, false, true];
Missile :: struct {
  live: bool; kind: int; caster: int;
  ax: f32; ay: f32; az: f32; bx: f32; by: f32; bz: f32;   // from and to
  t: f32; flight: f32; life: f32;
  hit: bool; damage: int; dc: int;
  shown: bool;               // the realm has drawn its burst
  next: f32;                 // a Spiritual Weapon's next blow
}

// The modes.
WM_CALM :: 0;    // on their day (routines.coax) or beat
WM_CHASE :: 1;   // a guard after you
WM_FLEE :: 2;
WM_COWER :: 3;
WM_FIGHT :: 4;   // a brave townsperson after you
WM_DOWN :: 5;    // knocked down, then up
WM_DEAD :: 6;
WM_BACK :: 7;    // walking back to where their day has them

// The brave: the smith, the fighters' master, the rangers' warden.
WATCH_BRAVE :: [3] int.[11, 13, 14];

// The new watch's beats: their points (x, z), there and back.
WATCH_BEAT_N :: [6] int.[2, 5, 2, 2, 2, 2];
WATCH_BEAT :: [60] f32.[
  // Inn Street, from inside the South Gate up to the commons
  1.6, -50.0,   1.6, -18.0,   0, 0,   0, 0,   0, 0,
  // round the commons
  13.0, 0.5,   0.5, 13.0,   -13.0, 0.5,   0.5, -13.0,   13.0, 0.5,
  // the market, along its street
  21.0, -1.6,   47.0, -1.6,   0, 0,   0, 0,   0, 0,
  // Guild Row out to the West Gate
  -22.0, -1.2,  -62.0, -0.5,  0, 0,   0, 0,   0, 0,
  // out to the East Gate
  50.0, 1.2,    65.0, 0.6,    0, 0,   0, 0,   0, 0,
  // the North Gate's lane
  44.6, 47.0,   44.6, 66.0,   0, 0,   0, 0,   0, 0
];
WATCH_PAUSE :: [6] f32.[12.0, 4.0, 10.0, 11.0, 13.0, 9.0];
WATCH_NAME :: [6] string.["WATCH", "WATCH", "WATCH", "WATCH", "WATCH", "WATCH"];
// Their looks, as folk.coax's tables: a woman or a man, hair, beard, skin, hair colour, colourway.
WATCH_FEMALE :: [6] bool.[false, true, false, false, true, false];
WATCH_HAIR :: [6] int.[9, 12, 8, 9, 13, 9];      // folk.coax PART_HAIR_*
WATCH_BEARD :: [6] bool.[true, false, false, true, false, false];
WATCH_SKIN :: [6] int.[1, 2, 3, 0, 4, 2];
WATCH_HAIR_RGB :: [18] f32.[0.05, 0.035, 0.03,  0.32, 0.12, 0.04,  0.08, 0.05, 0.035,  0.55, 0.55, 0.57,  0.03, 0.025, 0.025,  0.2, 0.1, 0.04];
WATCH_VARIANT :: [6] int.[0, 1, 0, 1, 0, 1];
WATCH_DYE :: [4] f32.[0.32, 0.03, 0.025, 1];    // the gate guards' crimson (folk.coax FOLK_DYE)

// What a guard shouts when they turn on you, and townsfolk as they run.
WATCH_SHOUTS :: 5;
WATCH_SHOUT :: [5] string.["HALT!", "STOP RIGHT THERE!", "GUARDS! TO ME!", "SEIZE THEM!", "YOU'LL HANG FOR THIS!"];
FOLK_SHOUTS :: 3;
FOLK_SHOUT :: [3] string.["HELP!", "RUN!", "GUARDS!"];
BRAVE_SHOUT :: "NOT IN MY TOWN!";

// One of the town: how they stand toward you.
Actor :: struct {
  mode: int; t: f32;              // the mode and the seconds in it
  after: int;                     // the mode they get up into, knocked down
  hp: int; max: int;
  x: f32; z: f32; yaw: f32;       // where they are off their day
  home_x: f32; home_z: f32; home_yaw: f32; home_in: bool;   // where their day has them now
  speed: f32;                     // m/s they move this frame
  clip: int; hold: bool;          // the clip, and whether it holds at its end (a fall)
  swing: f32; struck: bool; cool: f32;   // into a blow (-1 none), its roll made, and till the next
  shout: int; shout_t: f32;       // a line over them (-1 none) and how long it has shown
  sees: bool;                     // a guard: they see you now
  seen_x: f32; seen_z: f32;       // where they last saw you (or heard the crime): where they run
  ready: bool;
  homed: bool;                    // the realm has said where their day has them (one an admin took away never is)
  body: Tumble;                   // thrown by a blast
  spear_cool: f32; throwing: bool; up_shouted: bool;
  rank: int;                      // a reinforcement's (RANK_*)
  casting: f32; cast_kind: int; cast_cool: f32;   // a caster: into the spell (-1 none), which, till the next
  fireball_cool: f32; hold_cool: f32; weapon_cool: f32;
  heal_to: int;                   // a priest's: who the healing is for
}

Watch :: struct {
  on: bool;                       // the ruleset is the SRD's and the page is not still
  actors: [WATCH_ACTORS] Actor;
  wanted: bool; unseen: f32;      // seconds no hunter has seen you
  hp: int; max: int; ac: int;     // you
  dead: bool; dead_t: f32;        // you fell, and the seconds since
  respawn: bool;                  // the realm puts you at the Road In (taken once)
  hurt_t: f32;                    // seconds since a blow landed on you
  hits: int; misses: int;         // blows at you, for the checks
  spear_hits: int; spear_misses: int;   // and spears
  spell_hits: int; spell_misses: int; heals: int;   // and the casters' spells
  crimes: int;
  dice: [1] SrdDice;
  day: f32;                       // the town's clock as last read, for the dawn
  beats: [WATCH_NEW] Route; beats_ok: bool;
  solids: [EG_SOLIDS * EG_BOX] f32; solid_n: int;
  // walls a spell stands up (everglade-abilities.coax Wall of Stone), set each frame: each a
  // segment (ax, az, bx, bz) and its half thickness; no one stands in one, and a way that runs into
  // one goes round its nearer end (watch_way)
  fences: [WATCH_FENCES * 5] f32; fence_n: int;
  deck: f32;                      // the bridge's deck (plan.coax everglade_deck): where its walkers' feet are
  spears: [SPEARS] Spear;
  you_body: Tumble;               // your body, thrown by what killed you
  you_fall: f32;                  // s since you fell (your topple)
  // the heat
  level: int; heat: int;          // the WANTED level (0 none) and what has raised it
  enemy_fire: bool;               // a hunter's spell is hurting people now: no heat for it
  waves: int; spawned: int;       // for the checks
  missiles: [MISSILES] Missile;
  held_t: f32; held_saves: int;   // Hold Person: how long more, the saves made
  slow_t: f32;                    // Ray of Frost
  marked: bool;                   // Guiding Bolt: the next attack at you has advantage
  knock: Point; knocked: bool;    // a hunter's spell's throw for your living body (the realm takes it)
  face: f32;                      // your facing, for a body thrown
}
WATCH_FENCES :: 8;
WATCH_FENCE_CLEAR :: 0.45;   // m past a fence's end a way round it keeps

watch_is_guard :: (i: int) -> bool { return i >= EG_SPOTS || (i >= 0 && i < EG_SPOTS && FOLK_PATROL[i] >= 0); }
watch_is_brave :: (i: int) -> bool { for k: 0..<3 { if WATCH_BRAVE[k] == i { return true; } } return false; }
watch_hurtable :: (i: int) -> bool { return i >= EG_SPOTS || (i >= 0 && !EG_SPOT_CAT[i]); }
watch_here :: (w: [] Watch, i: int) -> bool { return watch_hurtable(i) && w[0].actors[i].homed; }
watch_block :: (i: int) -> SrdCreature { return ifx watch_is_guard(i) || i == 13 then SRD_GUARD else SRD_COMMONER; }
watch_is_rein :: (i: int) -> bool { return i >= WATCH_FIRST_REIN && i < WATCH_ACTORS; }
rank_block :: (r: int) -> SrdCreature {
  if r == RANK_VETERAN { return SRD_VETERAN; } if r == RANK_MAGE { return SRD_MAGE; } if r == RANK_KNIGHT { return SRD_KNIGHT; }
  if r == RANK_PRIEST { return SRD_PRIEST; } if r == RANK_ARCHMAGE { return SRD_ARCHMAGE; } if r == RANK_GLADIATOR { return SRD_GLADIATOR; }
  return SRD_GUARD;
}
watch_rank :: (w: [] Watch, i: int) -> int { return ifx watch_is_rein(i) then clamp_w(w[0].actors[i].rank, 0, RANKS - 1) else RANK_GUARD; }
// i's stat block: a reinforcement's rank's, else the watch's guard or a commoner.
watch_stats :: (w: [] Watch, i: int) -> SrdCreature { if watch_is_rein(i) { return rank_block(watch_rank(w, i)); } return watch_block(i); }
watch_caster :: (w: [] Watch, i: int) -> bool { return watch_is_rein(i) && RANK_CASTER[watch_rank(w, i)]; }

watch_start :: (w: [] Watch, heights: [] f32) {
  w[0].wanted = false; w[0].unseen = 0;
  w[0].max = SRD_RANGER_5.hp; w[0].hp = w[0].max; w[0].ac = SRD_RANGER_5.ac;
  w[0].dead = false; w[0].dead_t = 0; w[0].respawn = false; w[0].hurt_t = 100;
  w[0].dice[0] = srd_dice(20261030);
  w[0].day = -1;
  w[0].solid_n = everglade_solids(w[0].solids[..]);
  w[0].fence_n = 0;
  w[0].deck = everglade_deck(heights);
  for k: 0..<SPEARS { w[0].spears[k].live = false; }
  w[0].you_body.on = false; w[0].you_body.settle = -1; w[0].you_fall = 0;
  w[0].level = 0; w[0].heat = 0; w[0].enemy_fire = false; w[0].waves = 0; w[0].spawned = 0;
  for k: 0..<MISSILES { w[0].missiles[k].live = false; }
  w[0].held_t = 0; w[0].held_saves = 0; w[0].slow_t = 0; w[0].marked = false; w[0].knocked = false;
  for i: 0..<WATCH_ACTORS { w[0].actors[i].homed = false; w[0].actors[i].rank = RANK_GUARD; watch_revive(w, i); }
  for k: 0..<WATCH_NEW { watch_beat_route(w[0].beats[k..<k + 1], w[0].solids[..], w[0].solid_n, k, heights); }
  w[0].beats_ok = heights.count >= EG_GROUND_POINTS;
}
watch_revive :: (w: [] Watch, i: int) {
  a := w[0].actors[i..<i + 1];
  a[0].mode = WM_CALM; a[0].t = 0; a[0].after = WM_CALM;
  a[0].max = watch_stats(w, i).hp; a[0].hp = a[0].max;
  a[0].swing = -1; a[0].struck = false; a[0].cool = 0; a[0].shout = -1; a[0].shout_t = 0;
  a[0].hold = false; a[0].clip = PEOPLE_IDLE; a[0].speed = 0; a[0].sees = false;
  a[0].x = a[0].home_x; a[0].z = a[0].home_z; a[0].yaw = a[0].home_yaw;
  a[0].body.on = false; a[0].body.settle = -1;
  a[0].spear_cool = 0; a[0].throwing = false; a[0].up_shouted = false;
  a[0].casting = -1; a[0].cast_cool = 1.0; a[0].fireball_cool = 0; a[0].hold_cool = 2.0; a[0].weapon_cool = 0; a[0].heal_to = -1;
  a[0].ready = true;
}

// ---- the new watch's beats (as routines.coax walks the gate guards')

watch_beat_route :: (r: [] Route, solids: [] f32, ns: int, k: int, heights: [] f32) {
  r[0].n = 0; r[0].row = -3; r[0].who = EG_SPOTS + k;
  x := WATCH_BEAT[k * 10]; z := WATCH_BEAT[k * 10 + 1];
  route_put(r, x, z);
  for p: 1..<WATCH_BEAT_N[k] {
    bx := WATCH_BEAT[k * 10 + p * 2]; bz := WATCH_BEAT[k * 10 + p * 2 + 1];
    route_leg(r, solids, ns, x, z, bx, bz);
    x = bx; z = bz;
  }
  route_time(r, heights);
}
// Where the new guard k's beat has them at `beat` s on the shared clock (still: at its start).
watch_beat_at :: (w: [] Watch, k: int, beat: f64, still: bool) -> Placed {
  r := w[0].beats[k..<k + 1];
  if still || r[0].n < 2 {
    p: Placed;
    p.x = WATCH_BEAT[k * 10]; p.z = WATCH_BEAT[k * 10 + 1];
    p.face = atan2(WATCH_BEAT[k * 10 + 2] - p.x, WATCH_BEAT[k * 10 + 3] - p.z);
    return p;
  }
  walk := r[0].seconds; pause := WATCH_PAUSE[k];
  period := 2 * (walk + pause);
  ph := cast(f32) (beat - f64(period) * floor(beat / f64(period)));
  if ph < pause { p := route_at(r, 0); return p; }
  ph -= pause;
  if ph < walk { p := route_at(r, ph); p.walking = true; return p; }
  ph -= walk;
  if ph < pause { p := route_at(r, walk); p.face = folk_wrap_r(p.face + f32(PI)); return p; }
  ph -= pause;
  p := route_at(r, walk - ph);
  p.face = folk_wrap_r(p.face + f32(PI));
  p.walking = true;
  return p;
}

// ---- sight and the way

// Whether the segment a to b passes through a camera box (x0, y0, z0, x1, y1, z1: the buildings,
// the palisade and the tall props), short of b's last metre.
watch_hidden :: (boxes: [] f32, n: int, a: Point, b: Point) -> bool {
  span := length(sub(b, a));
  if span < 0.5 { return false; }
  stop := clamp01(1 - 1.0 / span);
  for q: 0..<n {
    k := q * 6;
    lo_t := 0.0f32; hi_t := stop; out := false;
    for ax: 0..<3 {
      o := ifx ax == 0 then a.x else ifx ax == 1 then a.y else a.z;
      d := (ifx ax == 0 then b.x else ifx ax == 1 then b.y else b.z) - o;
      mn := boxes[k + ax]; mx := boxes[k + 3 + ax];
      if abs(d) < 0.00001 { if o < mn || o > mx { out = true; } continue; }
      t0 := (mn - o) / d; t1 := (mx - o) / d;
      if t0 > t1 { tt := t0; t0 = t1; t1 = tt; }
      lo_t = hi(lo_t, t0); hi_t = lo(hi_t, t1);
      if lo_t > hi_t { out = true; }
    }
    if !out { return true; }
  }
  return false;
}
// Whether one at (x, z) sees p: near enough and nothing in the way.
watch_sees :: (boxes: [] f32, n: int, x: f32, z: f32, eye_y: f32, p: Point, reach: f32) -> bool {
  if flat_gap(v3(x, 0, z), p) > reach { return false; }
  return !watch_hidden(boxes, n, v3(x, eye_y, z), p);
}
// Whether (x, z) is open to a runner: no solid within a body's width, inside the world, not on the
// bridge's rails (its deck is reached from its ends, never climbed onto from the water under it), and
// clear of the fences a spell stands up (a Wall of Stone).
watch_open :: (w: [] Watch, x: f32, z: f32) -> bool {
  if abs(x) > f32(EG_BOUND) - 0.5 || abs(z) > f32(EG_BOUND) - 0.5 { return false; }
  for k: 0..<w[0].solid_n { if box_gap(w[0].solids[..], k, x, z) < f32(EG_RADIUS) { return false; } }
  for k: 0..<w[0].fence_n { if watch_fence_gap(w, k, x, z) < f32(EG_RADIUS) { return false; } }
  if watch_on_rail(x, z, f32(EG_RADIUS)) { return false; }
  return true;
}
// Whether (x, z) is within `pad` of the bridge's rails (everglade.coax walls: 0.12 m either side of a
// line 0.18 m in from each long side of EG_BRIDGE).
watch_on_rail :: (x: f32, z: f32, pad: f32) -> bool {
  br := EG_BRIDGE;
  if x < br[0] - pad || x > br[2] + pad { return false; }
  return abs(z - (br[1] + 0.18)) < 0.12 + pad || abs(z - (br[3] - 0.18)) < 0.12 + pad;
}
// Where a walker's feet are at (x, z): the ground, or on the bridge the deck (as the player's: everglade.coax walk_at).
watch_feet_y :: (w: [] Watch, heights: [] f32, x: f32, z: f32) -> f32 {
  if heights.count < EG_GROUND_POINTS { return 0; }
  return everglade_walk_height(heights, w[0].deck, x, z);
}
// Which side of the river (x) is on: -1 west of the bridge's span, 1 east, 0 in it.
watch_bank :: (x: f32) -> int { if x < EG_BRIDGE[0] { return -1; } if x > EG_BRIDGE[2] { return 1; } return 0; }
WATCH_DETOUR :: 120.0;    // m out of the way a runner goes to cross by the bridge rather than wade
// Where one at (x, z) heads for (gx, gz): straight there, unless the river is between and the bridge
// is not too far out of the way, then by the bridge: its near end, along its deck, off its far end.
watch_bridge_way :: (x: f32, z: f32, gx: f32, gz: f32) -> Point {
  br := EG_BRIDGE;
  from := watch_bank(x); to := watch_bank(gx);
  inner_lo := br[1] + 0.9; inner_hi := br[3] - 0.9;
  if from == 0 {
    // on the deck: along it to the end the goal is past, then off it
    if z >= br[1] && z <= br[3] && to != 0 {
      ex := ifx to < 0 then br[0] - 1.2 else br[2] + 1.2;
      return v3(ex, 0, clamp(z, inner_lo, inner_hi));
    }
    return v3(gx, 0, gz);
  }
  if to == 0 || to == from { return v3(gx, 0, gz); }
  zc := clamp((z + gz) / 2, inner_lo, inner_hi);
  detour := abs(zc - z) + abs(zc - gz) - abs(gz - z);
  if detour > f32(WATCH_DETOUR) { return v3(gx, 0, gz); }
  near_x := ifx from < 0 then br[0] - 1.2 else br[2] + 1.2;
  far_x := ifx from < 0 then br[2] + 1.2 else br[0] - 1.2;
  // at the near end, step on: the deck's far end
  // (between the near end and the deck: on toward the far one)
  past := ifx from < 0 then x - near_x else near_x - x;
  if past > -0.9 && abs(z - zc) < 0.9 { return v3(far_x, 0, zc); }
  return v3(near_x, 0, zc);
}
// The fences standing now: n of them from `f`, five numbers each.
watch_fences :: (w: [] Watch, f: [] f32, n: int) {
  m := ifx n < f.count / 5 then n else f.count / 5;
  w[0].fence_n = ifx m < 0 then 0 else ifx m > WATCH_FENCES then WATCH_FENCES else m;
  for k: 0..<w[0].fence_n * 5 { w[0].fences[k] = f[k]; }
}
// How far (x, z) is from fence k's face (0 inside it).
watch_fence_gap :: (w: [] Watch, k: int, x: f32, z: f32) -> f32 {
  f := w[0].fences[k * 5..<k * 5 + 5];
  ex := f[2] - f[0]; ez := f[3] - f[1];
  l2 := hi(ex * ex + ez * ez, 0.0001);
  u := clamp(((x - f[0]) * ex + (z - f[1]) * ez) / l2, 0, 1);
  dx := x - (f[0] + ex * u); dz := z - (f[1] + ez * u);
  return hi(sqrt(dx * dx + dz * dz) - f[4], 0);
}
// Whether the straight way from (x, z) to (gx, gz) comes within a body's width of fence k.
watch_fence_cuts :: (w: [] Watch, k: int, x: f32, z: f32, gx: f32, gz: f32) -> bool {
  d := flat_gap(v3(x, 0, z), v3(gx, 0, gz));
  steps := cast(int) (d / 0.2) + 1;
  if steps > 400 { steps = 400; }
  for q: 1..<steps + 1 {
    u := f32(q) / f32(steps);
    if watch_fence_gap(w, k, x + (gx - x) * u, z + (gz - z) * u) < f32(EG_RADIUS) { return true; }
  }
  return false;
}
// The heading from (x, z) toward (gx, gz): straight while nothing stands between; else round the
// nearer end of the first fence across the way (the end whose way, there and on to the goal, is
// shorter), worked out afresh each step, so a fence that rises or falls changes the way at once.
watch_way :: (w: [] Watch, x: f32, z: f32, gx: f32, gz: f32) -> f32 {
  tx := gx; tz := gz;
  best := -1.0f32;
  for k: 0..<w[0].fence_n {
    if !watch_fence_cuts(w, k, x, z, gx, gz) { continue; }
    f := w[0].fences[k * 5..<k * 5 + 5];
    ex := f[2] - f[0]; ez := f[3] - f[1];
    l := hi(sqrt(ex * ex + ez * ez), 0.0001);
    ux := ex / l; uz := ez / l;
    out := f[4] + f32(EG_RADIUS) + f32(WATCH_FENCE_CLEAR);
    for end: 0..<2 {
      px := ifx end == 0 then f[0] - ux * out else f[2] + ux * out;
      pz := ifx end == 0 then f[1] - uz * out else f[3] + uz * out;
      if !watch_open(w, px, pz) { continue; }
      way := flat_gap(v3(x, 0, z), v3(px, 0, pz)) + flat_gap(v3(px, 0, pz), v3(gx, 0, gz));
      if best < 0 || way < best { best = way; tx = px; tz = pz; }
    }
  }
  return atan2(tx - x, tz - z);
}
// One step of `step` m from (x, z) toward the heading `to` (radians): straight on, else the nearest
// way round that is open (a quarter, then half way round each side), else none.
WATCH_TRIES :: [7] f32.[0.0, 0.5, -0.5, 1.0, -1.0, 1.6, -1.6];
watch_stride :: (w: [] Watch, a: [] Actor, to: f32, step: f32) -> bool {
  for k: 0..<7 {
    h := to + WATCH_TRIES[k];
    nx := a[0].x + sin(h) * step; nz := a[0].z + cos(h) * step;
    if watch_open(w, nx, nz) || !watch_open(w, a[0].x, a[0].z) {
      a[0].x = nx; a[0].z = nz; a[0].yaw = watch_turn(a[0].yaw, h, step * 2);
      return true;
    }
  }
  return false;
}
// An attack at you, +`bonus` to hit with c's damage: Guiding Bolt's mark gives it advantage (the higher
// of two d20s) and is spent.
watch_roll_at_you :: (w: [] Watch, bonus: int, c: SrdCreature) -> SrdAttack {
  b := c; b.attack = bonus;
  roll := srd_attack(w[0].dice[..], b, w[0].ac);
  if w[0].marked {
    w[0].marked = false;
    other := srd_attack(w[0].dice[..], b, w[0].ac);
    if other.roll > roll.roll { roll = other; }
  }
  return roll;
}

// ---- the casters (Mages, the Priest, the Archmage)

// A caster after you for dt: they keep CAST_NEAR to CAST_FAR from you and, seeing you in range, cast:
// their hands glow CAST_WIND (PEOPLE_SPELL), then the spell leaves them.
watch_cast_step :: (w: [] Watch, i: int, dt: f32, you: Point, feet: f32, gap: f32, dist: f32, toward: f32, heights: [] f32) {
  a := w[0].actors[i..<i + 1];
  r := watch_rank(w, i);
  a[0].cast_cool -= dt; a[0].fireball_cool -= dt; a[0].hold_cool -= dt; a[0].weapon_cool -= dt;
  if a[0].casting >= 0 {
    a[0].casting += dt;
    a[0].yaw = watch_turn(a[0].yaw, toward, 6 * dt);
    a[0].clip = PEOPLE_SPELL; a[0].hold = true;
    if a[0].casting >= f32(CAST_WIND) {
      watch_cast(w, i, a[0].cast_kind, feet, you, heights);
      a[0].casting = -1; a[0].cast_cool = CAST_EVERY[r];
    }
    return;
  }
  if a[0].sees && dist <= f32(CAST_RANGE) && a[0].cast_cool <= 0 {
    k := watch_choose(w, i, gap);
    if k >= 0 { a[0].casting = 0; a[0].cast_kind = k; a[0].clip = PEOPLE_SPELL; a[0].hold = true; return; }
  }
  // keep their distance: in, out, or stand and face you
  goal := ifx a[0].sees then you else v3(a[0].seen_x, 0, a[0].seen_z);
  far := flat_gap(v3(a[0].x, 0, a[0].z), goal);
  step := f32(BRAVE_RUN) * dt;
  a[0].clip = PEOPLE_IDLE;
  if far > f32(CAST_FAR) || !a[0].sees {
    by := watch_bridge_way(a[0].x, a[0].z, goal.x, goal.z);
    if watch_stride(w, a, watch_way(w, a[0].x, a[0].z, by.x, by.z), lo(step, hi(far - 0.3, 0))) { a[0].speed = f32(BRAVE_RUN); a[0].clip = PEOPLE_RUN; }
  } else if far < f32(CAST_NEAR) {
    if watch_stride(w, a, atan2(a[0].x - goal.x, a[0].z - goal.z), step) { a[0].speed = f32(BRAVE_RUN); a[0].clip = PEOPLE_RUN; }
    a[0].yaw = watch_turn(a[0].yaw, toward, 6 * dt);
  } else { a[0].yaw = watch_turn(a[0].yaw, toward, 6 * dt); }
}
// Which spell caster i casts now (MS_*), or -1: by rank, what is ready, and a roll.
watch_choose :: (w: [] Watch, i: int, gap: f32) -> int {
  a := w[0].actors[i..<i + 1];
  r := watch_rank(w, i);
  if r == RANK_MAGE {
    if a[0].fireball_cool <= 0 && gap > f32(FIREBALL_R) + 1 { a[0].fireball_cool = 14; return MS_FIREBALL; }
    if a[0].hold_cool <= 0 && w[0].held_t <= 0 { a[0].hold_cool = 18; return MS_HOLD; }
    return ifx srd_roll(w[0].dice[..], 2) == 1 then MS_FIRE_BOLT else MS_FROST;
  }
  if r == RANK_PRIEST {
    // the most hurt of the hunters within 60 ft, under 60% of their HP
    best := -1; worst := 0.6f32;
    for j: 0..<WATCH_ACTORS {
      if !watch_here(w, j) || !watch_is_guard(j) || w[0].actors[j].mode == WM_DEAD { continue; }
      b := w[0].actors[j];
      if flat_gap(v3(b.x, 0, b.z), v3(a[0].x, 0, a[0].z)) > 18.3 { continue; }
      share := f32(b.hp) / f32(hi_w(b.max, 1));
      if share < worst { worst = share; best = j; }
    }
    if best >= 0 { a[0].heal_to = best; return MS_HEAL; }
    if a[0].weapon_cool <= 0 { a[0].weapon_cool = 25; return MS_WEAPON; }
    return MS_GUIDING;
  }
  if r == RANK_ARCHMAGE {
    if gap <= f32(CONE_LONG) - 1 && srd_roll(w[0].dice[..], 2) == 1 { return MS_COLD; }
    if gap <= f32(LIGHTNING_LONG) - 1 { return MS_LIGHTNING; }
    return MS_FIRE_BOLT;
  }
  return -1;
}
// A free missile slot (the oldest if none).
watch_missile_slot :: (w: [] Watch) -> int {
  k := 0;
  for q: 0..<MISSILES { if !w[0].missiles[q].live { return q; } if w[0].missiles[q].t > w[0].missiles[k].t { k = q; } }
  return k;
}
// Caster i's spell `kind` leaves their hands at `you` (where you are as they cast: a bolt or a fireball
// flies there, and you can step out of its way).
watch_cast :: (w: [] Watch, i: int, kind: int, feet: f32, you: Point, heights: [] f32) {
  a := w[0].actors[i];
  c := watch_stats(w, i);
  r := watch_rank(w, i);
  hand := v3(a.x + sin(a.yaw) * 0.35, feet + 1.45, a.z + cos(a.yaw) * 0.35);
  aim := add(you, v3(0, 1.0, 0));
  k := watch_missile_slot(w);
  m := Missile.{live = true, kind = kind, caster = i, ax = hand.x, ay = hand.y, az = hand.z, bx = aim.x, by = aim.y, bz = aim.z,
                t = 0, flight = 0.2, life = 0.6, hit = false, damage = 0, dc = RANK_DC[r], shown = false, next = 0};
  far := length(sub(aim, hand));
  if kind == MS_FIRE_BOLT || kind == MS_GUIDING || kind == MS_FIREBALL {
    m.flight = hi(far / f32(MS_SPEED), 0.1);
    if kind == MS_FIREBALL { m.by = you.y + 0.2; m.flight = hi(far / (f32(MS_SPEED) * 0.8), 0.1); }
    else {
      roll := watch_roll_at_you(w, c.attack, c);
      m.hit = roll.hit;
      if roll.hit {
        n := ifx kind == MS_FIRE_BOLT then 2 else 4; sides := ifx kind == MS_FIRE_BOLT then 10 else 6;
        if roll.crit { n *= 2; }
        m.damage = srd_sum(w[0].dice[..], n, sides);
      }
    }
  }
  if kind == MS_FROST {
    roll := watch_roll_at_you(w, c.attack, c);
    m.hit = roll.hit; m.flight = 0.15; m.life = 0.35;
    if roll.hit { m.damage = srd_sum(w[0].dice[..], ifx roll.crit then 4 else 2, 8); }
  }
  if kind == MS_HOLD { m.flight = 0.25; m.life = 0.5; }
  if kind == MS_LIGHTNING {
    // a line 100 ft long from their hand through where you are
    d := unit_or(sub(aim, hand), v3(0, 0, 1));
    m.bx = hand.x + d.x * f32(LIGHTNING_LONG); m.by = hand.y + d.y * f32(LIGHTNING_LONG); m.bz = hand.z + d.z * f32(LIGHTNING_LONG);
    m.flight = 0.05; m.life = 0.45;
  }
  if kind == MS_COLD { m.flight = 0.1; m.life = 0.8; }
  if kind == MS_WEAPON { m.flight = 0.4; m.life = f32(WEAPON_FOR); m.next = 0.5; }
  if kind == MS_HEAL {
    to := a.heal_to;
    if to < 0 || to >= WATCH_ACTORS { return; }
    b := w[0].actors[to];
    m.bx = b.x; m.by = watch_feet_y(w, heights, b.x, b.z) + 1.2; m.bz = b.z; m.flight = 0.3; m.life = 0.9;
    m.damage = srd_sum(w[0].dice[..], 2, 8) + 3;
  }
  w[0].missiles[k] = m;
}
// Whether your body (feet at `you`) is within `pad` of the point p.
watch_near_you :: (you: Point, p: Point, pad: f32) -> bool {
  flat := flat_gap(you, p);
  up := hi(hi(p.y - (you.y + f32(BODY_TALL)), you.y - p.y), 0);
  return sqrt(flat * flat + up * up) <= pad;
}
// The spells in the air for dt, you at `you`: each does what it does as it gets there.
watch_missiles_step :: (w: [] Watch, dt: f32, you: Point, heights: [] f32) {
  for k: 0..<MISSILES {
    m := w[0].missiles[k];
    if !m.live { continue; }
    was := m.t;
    m.t += dt;
    if m.t >= m.flight + m.life { m.live = false; w[0].missiles[k] = m; continue; }
    w[0].missiles[k] = m;
    if was < m.flight && m.t >= m.flight { watch_arrive(w, k, you, heights); }
    if m.kind == MS_WEAPON && m.t >= m.flight { watch_weapon_step(w, k, dt, you); }
  }
}
// Missile k gets there.
watch_arrive :: (w: [] Watch, k: int, you: Point, heights: [] f32) {
  m := w[0].missiles[k];
  if w[0].dead { return; }
  at := v3(m.bx, m.by, m.bz);
  from := v3(m.ax, m.ay, m.az);
  if m.kind == MS_FIRE_BOLT || m.kind == MS_GUIDING || m.kind == MS_FROST {
    if m.hit && watch_near_you(you, at, f32(MS_DODGE)) {
      w[0].spell_hits += 1;
      push := times(unit_or(v3(at.x - from.x, 0, at.z - from.z), v3(0, 0, 1)), 2.5);
      watch_hit_you(w, m.damage, you, add(push, v3(0, 1.5, 0)));
      if m.kind == MS_FROST { w[0].slow_t = f32(FROST_FOR); }
      if m.kind == MS_GUIDING { w[0].marked = true; }
    } else { w[0].spell_misses += 1; }
    return;
  }
  if m.kind == MS_HOLD {
    // Hold Person: a Wisdom save (the Ranger's +1) against their DC, or held
    if !srd_save(w[0].dice[..], 1, m.dc).success { w[0].held_t = f32(HOLD_FOR); w[0].held_saves = 0; w[0].spell_hits += 1; } else { w[0].spell_misses += 1; }
    return;
  }
  if m.kind == MS_FIREBALL {
    // 8d6 fire in 20 feet, a Dexterity save for half, and it throws whoever is in it, you and the town
    dmg := SrdDamage.{amount = srd_sum(w[0].dice[..], 8, 6), kind = DMG_FIRE, amount2 = 0, kind2 = DMG_FIRE};
    w[0].enemy_fire = true;
    _ := watch_blast(w, at, f32(FIREBALL_R), dmg, you, 12, heights);
    w[0].enemy_fire = false;
    if watch_near_you(you, at, f32(FIREBALL_R) + f32(BLAST_PAD)) {
      s := srd_save(w[0].dice[..], SRD_RANGER_5.dex, m.dc);
      took := ifx s.success then dmg.amount / 2 else dmg.amount;
      d := flat_gap(you, at);
      kk := clamp01(1 - d / (f32(FIREBALL_R) + f32(BLAST_PAD)));
      w[0].spell_hits += 1;
      watch_hit_you(w, took, you, watch_kick(at, add(you, v3(0, f32(TUMBLE_PELVIS), 0)), 12 * (0.45 + 0.55 * kk)));
    } else { w[0].spell_misses += 1; }
    return;
  }
  if m.kind == MS_LIGHTNING {
    // 8d6 lightning down the line, a Dexterity save for half; it throws you along it
    d := unit_or(sub(at, from), v3(0, 0, 1));
    rel := sub(add(you, v3(0, 1.0, 0)), from);
    along := dot(rel, d);
    off := length(sub(rel, times(d, along)));
    if along >= 0 && along <= f32(LIGHTNING_LONG) && off <= f32(LIGHTNING_WIDE) * 0.5 + 0.9 {
      dmg := srd_sum(w[0].dice[..], 8, 6);
      s := srd_save(w[0].dice[..], SRD_RANGER_5.dex, m.dc);
      w[0].spell_hits += 1;
      watch_hit_you(w, ifx s.success then dmg / 2 else dmg, you, add(times(v3(d.x, 0, d.z), 9), v3(0, 3, 0)));
    } else { w[0].spell_misses += 1; }
    return;
  }
  if m.kind == MS_COLD {
    // 8d8 cold in a 60-foot cone, a Constitution save (+2) for half; it blows you back
    d := unit_or(v3(at.x - from.x, 0, at.z - from.z), v3(0, 0, 1));
    rel := v3(you.x - from.x, 0, you.z - from.z);
    along := dot(rel, d);
    off := length(sub(rel, times(d, along)));
    if along > 0 && along <= f32(CONE_LONG) && off <= along * 0.5 + 0.4 {
      dmg := srd_sum(w[0].dice[..], 8, 8);
      s := srd_save(w[0].dice[..], 2, m.dc);
      w[0].spell_hits += 1;
      watch_hit_you(w, ifx s.success then dmg / 2 else dmg, you, add(times(d, 7), v3(0, 2.5, 0)));
    } else { w[0].spell_misses += 1; }
    return;
  }
  if m.kind == MS_HEAL {
    c := m.caster;
    if c < 0 || c >= WATCH_ACTORS { return; }
    to := w[0].actors[c].heal_to;
    if to < 0 || to >= WATCH_ACTORS || w[0].actors[to].mode == WM_DEAD { return; }
    w[0].actors[to].hp = clamp_w(w[0].actors[to].hp + m.damage, 0, w[0].actors[to].max);
    w[0].heals += 1;
  }
}
// The Spiritual Weapon: it hangs by you and strikes every WEAPON_EVERY (+5, 1d8 + 3 force).
watch_weapon_step :: (w: [] Watch, k: int, dt: f32, you: Point) {
  m := w[0].missiles[k..<k + 1];
  m[0].bx = you.x + 0.9; m[0].by = you.y + 1.7; m[0].bz = you.z + 0.4;
  m[0].next -= dt;
  if m[0].next > 0 || w[0].dead { return; }
  m[0].next = f32(WEAPON_EVERY);
  roll := watch_roll_at_you(w, 5, SRD_PRIEST);
  if roll.hit { w[0].spell_hits += 1; watch_hurt_you(w, srd_sum(w[0].dice[..], ifx roll.crit then 2 else 1, 8) + 3); } else { w[0].spell_misses += 1; }
}
// A hunter's spell hits you for `amount`, throwing you at v: alive, the realm adds it to your
// velocity (watch_take_knock); dead, your body flies.
watch_hit_you :: (w: [] Watch, amount: int, you: Point, v: Point) {
  watch_hurt_you_thrown(w, amount, you, w[0].face, v);
  if !w[0].dead { w[0].knock = add(w[0].knock, times(v, 0.6)); w[0].knocked = true; }
}
// Whether you are held (Hold Person: you can't move or act).
watch_held :: (w: [] Watch) -> bool { return w[0].held_t > 0 && !w[0].dead; }
// Your pace's share (Ray of Frost slows you).
watch_pace :: (w: [] Watch) -> f32 { return ifx w[0].slow_t > 0 then f32(FROST_PACE) else 1.0f32; }

// How far apart two bodies are up and down: one's span from `feet` to BODY_TALL over them, yours from `you_y`.
watch_span_gap :: (feet: f32, you_y: f32) -> f32 {
  return hi(hi(you_y - (feet + f32(BODY_TALL)), feet - (you_y + f32(BODY_TALL))), 0);
}
// Guard i throws a spear from their hand at `to`, `dist` m off: the attack is rolled as it leaves the
// hand (disadvantage past 20 ft: the lower of two d20s), and it lands, or flies past, when it gets there.
watch_spear :: (w: [] Watch, i: int, feet: f32, to: Point, dist: f32) {
  k := -1;
  for q: 0..<SPEARS { if k < 0 && !w[0].spears[q].live { k = q; } }
  if k < 0 { return; }
  a := w[0].actors[i];
  roll := srd_attack(w[0].dice[..], watch_stats(w, i), w[0].ac);
  if dist > f32(SPEAR_NEAR) {
    other := srd_attack(w[0].dice[..], watch_stats(w, i), w[0].ac);
    if other.roll < roll.roll { roll = other; }
  }
  from := v3(a.x + sin(a.yaw) * 0.3, feet + 1.7, a.z + cos(a.yaw) * 0.3);
  aim := to;
  if !roll.hit { aim = add(to, v3(sin(a.yaw + 1.3) * 1.4, 0.9, cos(a.yaw + 1.3) * 1.4)); }   // wide and high
  far := length(sub(aim, from));
  w[0].spears[k] = Spear.{live = true, ax = from.x, ay = from.y, az = from.z, bx = aim.x, by = aim.y, bz = aim.z, t = 0,
                          flight = hi(far / f32(SPEAR_SPEED), 0.05), hit = roll.hit, damage = roll.damage};
}
// The spears in the air for dt: one that gets there hurts you if it hit.
watch_spears_step :: (w: [] Watch, dt: f32) {
  for k: 0..<SPEARS {
    if !w[0].spears[k].live { continue; }
    w[0].spears[k].t += dt;
    if w[0].spears[k].t < w[0].spears[k].flight + 0.6 { continue; }
    w[0].spears[k].live = false;
  }
  for k: 0..<SPEARS {
    sp := w[0].spears[k];
    if !sp.live || sp.t < sp.flight || sp.t - dt >= sp.flight { continue; }
    if sp.hit { w[0].spear_hits += 1; watch_hurt_you(w, sp.damage); } else { w[0].spear_misses += 1; }
  }
}
// Where spear k is now (its flight's arc, a little up in the middle) and the way it points; past its
// flight it lies where it ended for a moment.
SpearAt :: struct { at: Point; dir: Point; }
watch_spear_at :: (sp: Spear) -> SpearAt {
  u := clamp01(sp.t / hi(sp.flight, 0.01));
  a := v3(sp.ax, sp.ay, sp.az); b := v3(sp.bx, sp.by, sp.bz);
  lift := sp.flight * sp.flight * 2.4;
  o: SpearAt;
  o.at = add(mix(a, b, u), v3(0, lift * 4 * u * (1 - u), 0));
  o.dir = unit_or(add(sub(b, a), v3(0, lift * 4 * (1 - 2 * u), 0)), v3(0, 0, 1));
  return o;
}
watch_turn :: (from: f32, to: f32, most: f32) -> f32 {
  d := folk_wrap_r(to - from);
  return folk_wrap_r(from + clamp(d, -hi(most, 0.08), hi(most, 0.08)));
}

// ---- crime and harm

// The modes a shout and a turn put one in.
watch_alarm :: (w: [] Watch, i: int, you: Point, known: Point) {
  a := w[0].actors[i..<i + 1];
  if a[0].mode != WM_CHASE && a[0].mode != WM_FIGHT { a[0].seen_x = known.x; a[0].seen_z = known.z; }
  if a[0].mode == WM_DEAD || a[0].mode == WM_DOWN { if a[0].mode == WM_DOWN { a[0].after = watch_scared_mode(i, a[0], you); } return; }
  m := watch_scared_mode(i, a[0], you);
  if m == a[0].mode && m != WM_COWER { return; }
  if a[0].mode == WM_CALM || a[0].mode == WM_BACK {
    // one on their day stands where their day has them; one walking back stays where they are
    if a[0].mode == WM_CALM { a[0].x = a[0].home_x; a[0].z = a[0].home_z; a[0].yaw = a[0].home_yaw; }
    a[0].shout_t = 0;
    seed := cast(int) srd_roll(w[0].dice[..], 64);
    a[0].shout = ifx watch_is_guard(i) then seed % WATCH_SHOUTS else ifx m == WM_FIGHT then 100 else ifx seed % 3 == 0 then seed % FOLK_SHOUTS else -1;
  }
  a[0].mode = m; a[0].t = 0;
}
watch_scared_mode :: (i: int, a: Actor, you: Point) -> int {
  if watch_is_guard(i) { return WM_CHASE; }
  if watch_is_brave(i) && flat_gap(v3(a.x, 0, a.z), you) < 18 { return WM_FIGHT; }
  return WM_FLEE;
}

// A crime at `at` (a blast that struck the town or a person), heard out to `heard` m, you at `you`
// (your feet, on the ground): every guard who sees it or you, or hears it, turns on you and runs
// at where they saw you (or at the blast, heard), and the townsfolk who see it run. How many guards
// turned.
watch_crime :: (w: [] Watch, at: Point, heard: f32, you: Point, boxes: [] f32, nb: int, heights: [] f32) -> int {
  if !w[0].on || w[0].dead { return 0; }
  w[0].crimes += 1;
  w[0].heat += HEAT_CRIME;
  turned := 0;
  chest := add(you, v3(0, 1.2, 0));
  mark := add(at, v3(0, 0.3, 0));
  for i: 0..<WATCH_ACTORS {
    if !watch_here(w, i) { continue; }
    a := w[0].actors[i];
    if a.mode == WM_DEAD { continue; }
    if a.mode == WM_CALM && a.home_in { continue; }   // indoors: they neither see nor come
    eye := watch_feet_y(w, heights, a.x, a.z) + f32(WATCH_EYE);
    d := flat_gap(v3(a.x, 0, a.z), at);
    if watch_is_guard(i) {
      saw_you := watch_sees(boxes, nb, a.x, a.z, eye, chest, f32(WATCH_SIGHT));
      saw := saw_you || watch_sees(boxes, nb, a.x, a.z, eye, mark, f32(WATCH_SIGHT));
      if saw || d < heard {
        if a.mode != WM_CHASE { turned += 1; }
        watch_alarm(w, i, you, ifx saw_you then you else at);
      }
    } else {
      if d < f32(FOLK_SEE) && !watch_hidden(boxes, nb, v3(a.x, eye, a.z), mark) { watch_alarm(w, i, you, you); }
      else if d < heard * 0.35 { watch_alarm(w, i, you, you); }
    }
  }
  for i: 0..<WATCH_ACTORS {
    a := w[0].actors[i];
    if a.mode == WM_CHASE || (a.mode == WM_DOWN && a.after == WM_CHASE) { w[0].wanted = true; w[0].unseen = 0; }
  }
  return turned;
}
watch_ground_y :: (heights: [] f32, x: f32, z: f32) -> f32 {
  if heights.count < EG_GROUND_POINTS { return 0; }
  return verse_terrain_height(everglade_ground(), heights, x, z);
}

// A spell's blast of `radius` m at `at`: everyone in it takes its damage (rolled once, a Dexterity save
// for half); one who lives is knocked down, one at 0 HP dies; and each is thrown, out from it and up at
// up to `power` m/s (WATCH_THROW), the nearer the harder (as verse/demolish.coax demo_kick throws the
// debris), to land and lie where they come down. How many it hit.
watch_blast :: (w: [] Watch, at: Point, radius: f32, dmg: SrdDamage, you: Point, power: f32, heights: [] f32) -> int {
  if !w[0].on { return 0; }
  hit := 0;
  for i: 0..<WATCH_ACTORS {
    if !watch_here(w, i) { continue; }
    a := w[0].actors[i..<i + 1];
    if a[0].mode == WM_DEAD || (a[0].mode == WM_CALM && a[0].home_in) { continue; }
    d := flat_gap(v3(a[0].x, 0, a[0].z), at);
    if d >= radius + f32(BLAST_PAD) { continue; }
    hit += 1;
    took := srd_creature_takes(w[0].dice[..], watch_stats(w, i), dmg, SAVE_DEX, ON_SAVE_HALF, SAVE_DC_W);
    watch_harm(w, i, took, you);
    if power > 0 {
      k := clamp01(1 - d / (radius + f32(BLAST_PAD)));
      feet := watch_feet_y(w, heights, a[0].x, a[0].z);
      watch_throw(w, i, watch_kick(at, v3(a[0].x, feet + f32(TUMBLE_PELVIS), a[0].z), power * (0.45 + 0.55 * k)), heights);
    }
  }
  return hit;
}
// The way and speed a blast at `at` throws a body whose pelvis is at p: out from it and up (at least a
// third up, so a blast at their feet lifts them), `speed` m/s.
watch_kick :: (at: Point, p: Point, speed: f32) -> Point {
  out := v3(p.x - at.x, 0, p.z - at.z);
  l := sqrt(out.x * out.x + out.z * out.z);
  if l < 0.05 { out = v3(0, 0, 1); l = 1; }
  up := clamp(0.55 + (p.y - at.y) * 0.15, 0.35, 0.9);
  side := sqrt(1 - up * up);
  return v3(out.x / l * side * speed, up * speed, out.z / l * side * speed);
}
// i thrown at velocity v (a blast, a wave, a gust): their body leaves their feet and tumbles.
watch_throw :: (w: [] Watch, i: int, v: Point, heights: [] f32) {
  a := w[0].actors[i..<i + 1];
  if !a[0].ready { return; }
  feet := watch_feet_y(w, heights, a[0].x, a[0].z);
  if !a[0].body.on { a[0].body.pitch = 0; a[0].body.x = a[0].x; a[0].body.z = a[0].z; a[0].body.y = feet + f32(TUMBLE_PELVIS); }
  a[0].body = tumble_kicked(a[0].body, v);
  a[0].swing = -1; a[0].throwing = false; a[0].shout = -1;
}

// ---- a thrown body

// b kicked at velocity v: in the air, facing back the way it is thrown (so it goes over backwards), spinning.
tumble_kicked :: (b: Tumble, v: Point) -> Tumble {
  n := b;
  n.on = true; n.age = 0; n.still_t = 0; n.settle = -1;
  n.vx = v.x; n.vy = hi(v.y, 0.5); n.vz = v.z;
  flat := sqrt(v.x * v.x + v.z * v.z);
  if flat > 0.1 { n.yaw = atan2(-v.x, -v.z); }
  n.spin = -(1.5 + 0.55 * flat + 0.2 * abs(v.y));
  return n;
}
// The pelvis's height over the ground with the body turned `pitch` from standing (lying: TUMBLE_LIE).
tumble_rest_y :: (pitch: f32) -> f32 { return lerp(f32(TUMBLE_LIE), f32(TUMBLE_PELVIS), abs(cos(pitch))); }
// Whether a body's pelvis at (x, y, z) is in a wall: a solid within its half width, under the solid's top.
tumble_blocked :: (w: [] Watch, heights: [] f32, x: f32, y: f32, z: f32) -> bool {
  if abs(x) > f32(EG_BOUND) - 0.4 || abs(z) > f32(EG_BOUND) - 0.4 { return true; }
  g := watch_feet_y(w, heights, x, z);
  for k: 0..<w[0].solid_n {
    if box_gap(w[0].solids[..], k, x, z) < 0.25 && y - 0.3 < g + w[0].solids[k * EG_BOX + 4] { return true; }
  }
  if y - 0.3 < w[0].deck + 1.05 && watch_on_rail(x, z, 0.2) { return true; }
  for k: 0..<w[0].fence_n { if watch_fence_gap(w, k, x, z) < 0.25 && y - 0.3 < g + 3.1 { return true; } }
  return false;
}
// b for dt seconds: gravity, the walls (it bounces back off them), the ground (a bounce, then it slides,
// rolling onto its back, and rests); at rest the lying pose blends in.
tumble_stepped :: (w: [] Watch, b: Tumble, dt: f32, heights: [] f32) -> Tumble {
  n := b;
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  if !n.on {
    if n.settle >= 0 && n.settle < f32(TUMBLE_SETTLE) { n.settle = lo(n.settle + t, f32(TUMBLE_SETTLE)); }
    return n;
  }
  steps := clamp_w(cast(int) (t / f32(TUMBLE_STEP)) + 1, 1, 40);
  h := t / f32(steps);
  back := -f32(PI) * 0.5;
  for q: 0..<steps {
    n.age += h;
    n.vy -= f32(TUMBLE_G) * h;
    nx := n.x + n.vx * h; nz := n.z + n.vz * h; ny := n.y + n.vy * h;
    if tumble_blocked(w, heights, nx, ny, n.z) { n.vx = -n.vx * 0.35; nx = n.x; n.spin *= 0.7; }
    if tumble_blocked(w, heights, n.x, ny, nz) { n.vz = -n.vz * 0.35; nz = n.z; n.spin *= 0.7; }
    if tumble_blocked(w, heights, nx, ny, nz) { nx = n.x; nz = n.z; n.vx = 0; n.vz = 0; }
    n.x = nx; n.z = nz; n.y = ny;
    n.pitch += n.spin * h;
    g := watch_feet_y(w, heights, n.x, n.z);
    rest := g + tumble_rest_y(n.pitch);
    if n.y <= rest + 0.12 {
      if n.y <= rest { n.y = rest; if n.vy < 0 { n.vy = ifx n.vy < -2.5 then -n.vy * 0.25 else 0.0f32; } }
      // the ground drags it (friction, about 0.6 g, and a scrape) and turns it onto its back
      sp := sqrt(n.vx * n.vx + n.vz * n.vz);
      if sp > 0.0001 {
        slow := lo(sp, (6 + 4 * sp) * h);
        n.vx -= n.vx / sp * slow; n.vz -= n.vz / sp * slow;
      }
      to := back + f32(TAU) * floor((n.pitch - back) / f32(TAU) + 0.5);
      n.spin = n.spin * (1 - clamp01(12 * h)) + (to - n.pitch) * 40 * h;
      if n.vx * n.vx + n.vz * n.vz + n.vy * n.vy < 0.16 && abs(to - n.pitch) < 0.15 && n.y <= rest + 0.02 { n.still_t += h; } else { n.still_t = 0; }
    } else { n.still_t = 0; }
    if n.still_t >= 0.2 || n.age >= f32(TUMBLE_LONGEST) {
      n.on = false; n.settle = 0;
      n.pitch = back; n.spin = 0; n.vx = 0; n.vy = 0; n.vz = 0;
      n.y = watch_feet_y(w, heights, n.x, n.z) + f32(TUMBLE_LIE);
      return n;
    }
  }
  return n;
}
clamp_w :: (a: int, low: int, high: int) -> int { if a < low { return low; } if a > high { return high; } return a; }
// How much of the rigid turn still shows (1 in the air, falling to 0 as the lying pose comes in).
tumble_turn :: (b: Tumble) -> f32 {
  if b.on { return 1; }
  if b.settle < 0 { return 0; }
  u := clamp01(b.settle / f32(TUMBLE_SETTLE));
  return 1 - u * u * (3 - 2 * u);
}
// Where the clip's lying pose puts its feet so its pelvis lies where the thrown pelvis came down.
tumble_feet :: (b: Tumble) -> Point {
  return v3(b.x + sin(b.yaw) * f32(TUMBLE_LIE_BACK), 0, b.z + cos(b.yaw) * f32(TUMBLE_LIE_BACK));
}
// The body's rows (3 of 4) drawn thrown: its pelvis at the body's, turned `yaw` then `pitch` about its
// side, blended toward standing at `feet` (the clip's lying pose) by 1 - tumble_turn.
TumbleRows :: struct { r: [12] f32; }
tumble_rows :: (b: Tumble, feet: Point) -> TumbleRows {
  k := tumble_turn(b);
  p := b.pitch * k;
  c := cos(b.yaw); sn := sin(b.yaw); cp := cos(p); sp := sin(p);
  piv := f32(TUMBLE_PELVIS) * k;
  // the pelvis's place blends from the thrown body's to the lying clip's
  px := lerp(feet.x, b.x, k); pz := lerp(feet.z, b.z, k); py := lerp(feet.y + piv, b.y, k);
  o: TumbleRows;
  o.r = [12] f32.[c, sn * sp, sn * cp, px - sn * sp * piv,   0, cp, -sp, py - cp * piv,   -sn, c * sp, c * cp, pz - c * sp * piv];
  return o;
}
// i takes `amount`: dead at 0, else knocked down and then up to what fright makes them.
watch_harm :: (w: [] Watch, i: int, amount: int, you: Point) {
  a := w[0].actors[i..<i + 1];
  if a[0].mode == WM_DEAD { return; }
  if a[0].mode == WM_CALM { a[0].x = a[0].home_x; a[0].z = a[0].home_z; a[0].yaw = a[0].home_yaw; }
  a[0].hp -= amount;
  a[0].swing = -1; a[0].casting = -1; a[0].throwing = false;
  hunter := watch_is_guard(i) && !w[0].enemy_fire && amount > 0;
  if a[0].hp <= 0 {
    a[0].hp = 0; a[0].mode = WM_DEAD; a[0].t = 0; a[0].shout = -1;
    if hunter { w[0].heat += HEAT_KILL; }
    return;
  }
  if hunter { w[0].heat += HEAT_DOWN; }
  a[0].after = watch_scared_mode(i, a[0], you);
  a[0].mode = WM_DOWN; a[0].t = 0;
}

// You take a blow: at 0 you fall (you topple: watch_you_fall), and the town stands down.
watch_hurt_you :: (w: [] Watch, amount: int) {
  if w[0].dead { return; }
  w[0].hp -= amount; w[0].hurt_t = 0;
  if w[0].hp <= 0 { w[0].hp = 0; w[0].dead = true; w[0].dead_t = 0; w[0].you_fall = 0; w[0].you_body.on = false; w[0].you_body.settle = -1; }
}
// You take a blast's `amount`, your feet at `feet`, thrown at v if it kills you: your body tumbles as the
// town's do and lies where it comes down.
watch_hurt_you_thrown :: (w: [] Watch, amount: int, feet: Point, face: f32, v: Point) {
  if w[0].dead { return; }
  watch_hurt_you(w, amount);
  if !w[0].dead { return; }
  b := w[0].you_body;
  b.x = feet.x; b.y = feet.y + f32(TUMBLE_PELVIS); b.z = feet.z; b.pitch = 0; b.yaw = face;
  w[0].you_body = tumble_kicked(b, v);
}
// Your fall, not thrown: you topple over backwards from your feet as a stick falls (no clip of the
// Ranger's is a death), and lie there through YOU DIED. How far over you are (0 standing, -pi/2 lying).
WATCH_TOPPLE :: 0.75;     // s to the ground
watch_you_fall :: (w: [] Watch) -> f32 {
  if !w[0].dead { return 0; }
  u := clamp01(w[0].you_fall / f32(WATCH_TOPPLE));
  // falling faster as it goes, and a small bounce as it lands
  over := u * u;
  bounce := ifx u >= 1 then 0.0f32 else 0.0f32;
  late := w[0].you_fall - f32(WATCH_TOPPLE);
  if late > 0 && late < 0.25 { bounce = 0.12 * sin(late / 0.25 * f32(PI)); }
  return -f32(PI) * 0.5 * (over - bounce);
}

// Everyone the R of the spell bar or the dawn stands up again: alive, whole and on their day.
watch_restore :: (w: [] Watch) -> int {
  n := 0;
  for i: 0..<WATCH_ACTORS {
    if !watch_hurtable(i) { continue; }
    a := w[0].actors[i];
    if watch_is_rein(i) {
      // the fallen reinforcements are carried off
      if a.homed && (a.mode == WM_DEAD || a.mode == WM_DOWN) { n += 1; w[0].actors[i].homed = false; }
      continue;
    }
    if a.mode == WM_DEAD || a.hp < a.max { n += 1; }
    if a.mode != WM_CHASE && a.mode != WM_FIGHT { watch_revive(w, i); }
  }
  return n;
}

// ---- each frame

// Where i's day has them now (the routine or the beat), set before watch_step.
watch_home :: (w: [] Watch, i: int, x: f32, z: f32, yaw: f32, indoors: bool) {
  a := w[0].actors[i..<i + 1];
  if !a[0].ready { watch_revive(w, i); }
  a[0].home_x = x; a[0].home_z = z; a[0].home_yaw = yaw; a[0].home_in = indoors;
  if !a[0].homed { a[0].homed = true; a[0].x = x; a[0].z = z; a[0].yaw = yaw; }
  if a[0].mode == WM_CALM { a[0].x = x; a[0].z = z; a[0].yaw = yaw; }
}
// Whether i is off their day (the realm draws them where they are and as they are).
watch_off :: (w: [] Watch, i: int) -> bool { return w[0].actors[i].ready && w[0].actors[i].mode != WM_CALM; }

// The whole town for dt seconds, you at you; the town's clock's time of day, for the dawn.
watch_tick :: (w: [] Watch, dt: f32, you: Point, day: f32, boxes: [] f32, nb: int, heights: [] f32) {
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  w[0].hurt_t += t;
  // the dawn stands the dead up again
  if w[0].day >= 0 && w[0].day < 0.25 && day >= 0.25 && day < 0.5 { _ := watch_restore(w); }
  w[0].day = day;
  watch_spears_step(w, t);
  watch_missiles_step(w, t, you, heights);
  if w[0].held_t > 0 {
    w[0].held_t -= t;
    // the end of a round held: another Wisdom save, or held again
    if w[0].held_t <= 0 {
      w[0].held_t = 0;
      if w[0].held_saves < HOLD_SAVES && !srd_save(w[0].dice[..], 1, 14).success { w[0].held_t = f32(HOLD_FOR); }
      w[0].held_saves += 1;
    }
  }
  if w[0].slow_t > 0 { w[0].slow_t = hi(w[0].slow_t - t, 0); }
  if w[0].dead { w[0].held_t = 0; w[0].slow_t = 0; }
  if w[0].dead { w[0].you_fall += t; w[0].you_body = tumble_stepped(w, w[0].you_body, t, heights); }
  if w[0].dead {
    w[0].dead_t += t;
    if w[0].dead_t >= f32(DEATH_FADE) + f32(DEATH_HOLD) && !w[0].respawn {
      w[0].respawn = true;
      w[0].hp = w[0].max; w[0].dead = false; w[0].dead_t = 0; w[0].hurt_t = 100;
      watch_stand_down(w);
      w[0].dead_t = -f32(RISE_FADE);   // the view comes back
    }
  } else if w[0].dead_t < 0 { w[0].dead_t = lo(w[0].dead_t + t, 0); }
  seen := false;
  for i: 0..<WATCH_ACTORS {
    if !watch_here(w, i) { continue; }
    watch_step(w, i, t, you, boxes, nb, heights);
    if w[0].actors[i].mode == WM_CHASE && w[0].actors[i].sees { seen = true; }
  }
  if w[0].wanted {
    w[0].unseen = ifx seen then 0.0f32 else w[0].unseen + t;
    if w[0].unseen >= watch_lose_after(w) { watch_stand_down(w); }
  }
  // the heat rises: each level reached sends its wave
  if w[0].wanted && !w[0].dead {
    to := watch_level_for(w[0].heat);
    while w[0].level < to { w[0].level += 1; _ := watch_wave(w, w[0].level, you); }
  }
}
// The level `heat` reaches (at least 1: you are wanted).
watch_level_for :: (heat: int) -> int {
  l := 1;
  for k: 2..<WANTED_LEVELS + 1 { if heat >= HEAT_AT[k] { l = k; } }
  return l;
}
// How long out of every hunter's sight clears it: WANTED_LOSE, and half again for each level past 1.
watch_lose_after :: (w: [] Watch) -> f32 { return f32(WANTED_LOSE) * (1 + 0.5 * f32(hi_w(w[0].level - 1, 0))); }
hi_w :: (a: int, b: int) -> int { return ifx a > b then a else b; }
// How many hunt you now (alive and after you).
watch_hunters :: (w: [] Watch) -> int {
  n := 0;
  for i: 0..<WATCH_ACTORS {
    if !watch_here(w, i) || !watch_is_guard(i) { continue; }
    a := w[0].actors[i];
    if a.mode == WM_CHASE || (a.mode == WM_DOWN && a.after == WM_CHASE) { n += 1; }
  }
  return n;
}
// Level l's wave in at the gate nearest you, as many as the cap leaves room for. How many came.
watch_wave :: (w: [] Watch, l: int, you: Point) -> int {
  if l < 2 || l > WANTED_LEVELS { return 0; }
  gate := 0; best := 100000.0f32;
  for g: 0..<4 {
    d := flat_gap(v3(WATCH_GATE[g * 2], 0, WATCH_GATE[g * 2 + 1]), you);
    if d < best { best = d; gate = g; }
  }
  gx := WATCH_GATE[gate * 2]; gz := WATCH_GATE[gate * 2 + 1];
  came := 0;
  for q: 0..<4 {
    r := WAVE[l * 4 + q];
    if r < 0 { continue; }
    // at the cap, the lowest-ranked reinforcement below this one is sent back out to make room
    if watch_hunters(w) >= HUNTERS_MAX {
      low := -1;
      for i: WATCH_FIRST_REIN..<WATCH_ACTORS {
        b := w[0].actors[i];
        if !b.homed || b.mode != WM_CHASE || b.rank >= r { continue; }
        if low < 0 || b.rank < w[0].actors[low].rank { low = i; }
      }
      if low < 0 { continue; }
      w[0].actors[low].mode = WM_BACK; w[0].actors[low].casting = -1;
    }
    k := -1;
    for i: WATCH_FIRST_REIN..<WATCH_ACTORS { if k < 0 && !w[0].actors[i].homed { k = i; } }
    // no slot free: one walking back out takes the place
    for i: WATCH_FIRST_REIN..<WATCH_ACTORS { if k < 0 && w[0].actors[i].mode == WM_BACK { k = i; } }
    if k < 0 { break; }
    a := w[0].actors[k..<k + 1];
    // side by side across the gateway, facing in
    side := (f32(q) - 1.5) * 1.3;
    inx := ifx gate == 1 then 1.0f32 else ifx gate == 2 then -1.0f32 else 0.0f32;
    inz := ifx gate == 0 then 1.0f32 else ifx gate == 3 then -1.0f32 else 0.0f32;
    a[0].rank = r;
    a[0].home_x = gx + inz * side; a[0].home_z = gz + inx * side; a[0].home_yaw = atan2(inx, inz); a[0].home_in = false;
    watch_revive(w, k);
    a[0].homed = true;
    a[0].mode = WM_CHASE; a[0].t = 0;
    a[0].seen_x = you.x; a[0].seen_z = you.z;
    a[0].shout = ifx q == 0 then 2 else -1; a[0].shout_t = 0;
    came += 1; w[0].spawned += 1;
  }
  w[0].waves += 1;
  return came;
}
// You are wanted no more: the hunters walk back to their beats, the brave stand down.
watch_stand_down :: (w: [] Watch) {
  w[0].wanted = false; w[0].unseen = 0;
  // the heat clears: the reinforcements go back out of their gate, the fallen are carried off
  w[0].level = 0; w[0].heat = 0; w[0].marked = false;
  for k: 0..<MISSILES { if w[0].missiles[k].kind == MS_WEAPON { w[0].missiles[k].live = false; } }
  for i: WATCH_FIRST_REIN..<WATCH_ACTORS {
    if w[0].actors[i].mode == WM_DEAD || w[0].actors[i].mode == WM_DOWN { w[0].actors[i].homed = false; }
  }
  for i: 0..<WATCH_ACTORS {
    a := w[0].actors[i..<i + 1];
    if a[0].mode == WM_CHASE || a[0].mode == WM_FIGHT { a[0].mode = WM_BACK; a[0].t = 0; a[0].swing = -1; }
    if a[0].mode == WM_DOWN && (a[0].after == WM_CHASE || a[0].after == WM_FIGHT) { a[0].after = WM_BACK; }
  }
}

// One of the town for dt seconds.
watch_step :: (w: [] Watch, i: int, dt: f32, you: Point, boxes: [] f32, nb: int, heights: [] f32) {
  a := w[0].actors[i..<i + 1];
  if !a[0].ready { watch_revive(w, i); }
  a[0].t += dt;
  a[0].speed = 0; a[0].hold = false;
  if a[0].shout >= 0 { a[0].shout_t += dt; if a[0].shout_t > f32(SHOUT_FOR) { a[0].shout = -1; } }
  a[0].sees = false;
  // thrown: the body flies and comes to rest, and only then do they lie (their fall's clock waits)
  if a[0].body.on || (a[0].body.settle >= 0 && a[0].body.settle < f32(TUMBLE_SETTLE)) {
    was := a[0].body.on;
    a[0].body = tumble_stepped(w, a[0].body, dt, heights);
    if a[0].body.on {
      a[0].x = a[0].body.x; a[0].z = a[0].body.z; a[0].yaw = a[0].body.yaw;
      a[0].t = 0; a[0].clip = PEOPLE_KNOCK; a[0].hold = true; a[0].swing = -1;
      return;
    }
    if was { ft := tumble_feet(a[0].body); a[0].x = ft.x; a[0].z = ft.z; a[0].yaw = a[0].body.yaw; a[0].t = 0; }
  }
  gap := flat_gap(v3(a[0].x, 0, a[0].z), you);
  toward := atan2(you.x - a[0].x, you.z - a[0].z);
  m := a[0].mode;
  if m == WM_CALM {
    a[0].clip = -1;   // their day's own clip
    return;
  }
  if m == WM_DEAD {
    a[0].clip = PEOPLE_DIE; a[0].hold = true;
    if watch_is_guard(i) && !watch_is_rein(i) && a[0].t >= f32(GUARD_BACK) {
      watch_revive(w, i);
      if w[0].wanted && !w[0].dead { a[0].mode = WM_CHASE; a[0].shout = 2; a[0].shout_t = 0; }
    }
    return;
  }
  if m == WM_DOWN {
    if a[0].t < f32(PRONE_SECONDS_W) { a[0].clip = PEOPLE_KNOCK; a[0].hold = true; return; }
    if a[0].t < f32(PRONE_SECONDS_W) + f32(RISE) { a[0].clip = PEOPLE_IDLE; a[0].hold = false; return; }
    next := a[0].after;
    if (next == WM_CHASE || next == WM_FIGHT) && (!w[0].wanted || w[0].dead) { next = WM_BACK; }
    if next == WM_CALM { next = WM_BACK; }
    a[0].mode = next; a[0].t = 0;
    return;
  }
  if m == WM_CHASE || m == WM_FIGHT {
    guard := m == WM_CHASE;
    feet := watch_feet_y(w, heights, a[0].x, a[0].z);
    eye := feet + f32(WATCH_EYE);
    // how far your body is from theirs, up and down (their spans, feet to head), and in all
    up := watch_span_gap(feet, you.y);
    reach3 := sqrt(gap * gap + up * up);
    a[0].sees = watch_sees(boxes, nb, a[0].x, a[0].z, eye, add(you, v3(0, 1.2, 0)), f32(WATCH_SIGHT));
    if a[0].sees { a[0].seen_x = you.x; a[0].seen_z = you.z; }
    if w[0].dead { a[0].mode = WM_BACK; a[0].t = 0; a[0].swing = -1; a[0].casting = -1; return; }
    if watch_caster(w, i) { watch_cast_step(w, i, dt, you, feet, gap, reach3, toward, heights); return; }
    every := ifx guard then f32(SWING_EVERY) else f32(PUNCH_EVERY);
    strike := ifx guard then f32(STRIKE_AT) else f32(PUNCH_AT);
    length_ := ifx guard then f32(SWING) else f32(PUNCH);
    a[0].cool -= dt;
    if a[0].swing >= 0 {
      a[0].swing += dt;
      a[0].yaw = watch_turn(a[0].yaw, toward, 6 * dt);
      a[0].clip = PEOPLE_SLASH; a[0].hold = true;
      if a[0].throwing {
        if !a[0].struck && a[0].swing >= f32(SPEAR_AT) {
          a[0].struck = true;
          watch_spear(w, i, feet, add(you, v3(0, 1.1, 0)), reach3);
        }
        if a[0].swing >= length_ { a[0].swing = -1; a[0].throwing = false; a[0].spear_cool = f32(SPEAR_EVERY); a[0].cool = every - length_; }
        return;
      }
      if !a[0].struck && a[0].swing >= strike {
        a[0].struck = true;
        if reach3 <= f32(REACH) + 0.5 {
          // Multiattack: a Veteran's or a Knight's two blows, a Gladiator's three
          for q: 0..<RANK_ATTACKS[watch_rank(w, i)] {
            roll := watch_roll_at_you(w, watch_stats(w, i).attack, watch_stats(w, i));
            if roll.hit { w[0].hits += 1; watch_hurt_you(w, roll.damage); } else { w[0].misses += 1; }
          }
        }
      }
      if a[0].swing >= length_ { a[0].swing = -1; a[0].cool = every - length_; }
      return;
    }
    a[0].spear_cool -= dt;
    // you are up out of a sword's reach: a guard below shouts up at you and throws a spear; the brave wait
    if up > 0.3 && a[0].sees && gap <= f32(REACH) + 6 {
      a[0].yaw = watch_turn(a[0].yaw, toward, 6 * dt);
      if !a[0].up_shouted { a[0].up_shouted = true; a[0].shout = UP_SHOUT; a[0].shout_t = 0; }
      if guard && a[0].spear_cool <= 0 && reach3 <= f32(SPEAR_FAR) {
        a[0].swing = 0; a[0].struck = false; a[0].throwing = true;
        a[0].clip = PEOPLE_SLASH; a[0].hold = true;
        return;
      }
      if gap <= f32(REACH) * 0.8 { a[0].clip = PEOPLE_IDLE; return; }
    }
    if up <= 0.3 { a[0].up_shouted = false; }
    if reach3 <= f32(REACH) && a[0].sees {
      a[0].yaw = watch_turn(a[0].yaw, toward, 6 * dt);
      a[0].clip = ifx guard then PEOPLE_IDLE else PEOPLE_IDLE;
      if a[0].cool <= 0 { a[0].swing = 0; a[0].struck = false; }
      return;
    }
    run := ifx guard then f32(GUARD_RUN) else f32(BRAVE_RUN);
    // to you while they see you, else to where they last did, and there they look about
    goal := ifx a[0].sees then you else v3(a[0].seen_x, 0, a[0].seen_z);
    left := flat_gap(v3(a[0].x, 0, a[0].z), goal) - (ifx a[0].sees then f32(REACH) * 0.8 else 0.3f32);
    // over the river by the bridge, round a fence
    by := watch_bridge_way(a[0].x, a[0].z, goal.x, goal.z);
    step := lo(run * dt, hi(left, 0));
    if step > 0 && watch_stride(w, a, watch_way(w, a[0].x, a[0].z, by.x, by.z), step) { a[0].speed = step / hi(dt, 0.0001); }
    a[0].clip = ifx a[0].speed > 0.1 then PEOPLE_RUN else (ifx guard then PEOPLE_IDLE else PEOPLE_IDLE);
    return;
  }
  if m == WM_FLEE {
    if a[0].t < f32(FLEE_FOR) {
      away := atan2(a[0].x - you.x, a[0].z - you.z);
      step := f32(FLEE_RUN) * dt;
      if watch_stride(w, a, away, step) { a[0].speed = f32(FLEE_RUN); }
      a[0].clip = ifx a[0].speed > 0.1 then PEOPLE_RUN else PEOPLE_COWER;
      return;
    }
    a[0].mode = WM_COWER; a[0].t = 0;
    m = WM_COWER;
  }
  if m == WM_COWER {
    a[0].clip = PEOPLE_COWER;
    if gap < f32(COWER_NEAR) && !w[0].dead { a[0].mode = WM_FLEE; a[0].t = 0; return; }
    if (!w[0].wanted || w[0].dead) && a[0].t >= f32(CALM_AFTER) { a[0].mode = WM_BACK; a[0].t = 0; }
    return;
  }
  // WM_BACK: walk to where their day has them now, then go on with it
  d := flat_gap(v3(a[0].x, 0, a[0].z), v3(a[0].home_x, 0, a[0].home_z));
  // home, or long enough on the way (unless a fence stands where their day has them)
  if d < 0.35 || (a[0].t > 120 && watch_open(w, a[0].home_x, a[0].home_z)) {
    if watch_is_rein(i) { a[0].homed = false; }   // out of their gate
    a[0].mode = WM_CALM; a[0].t = 0;
    a[0].x = a[0].home_x; a[0].z = a[0].home_z; a[0].yaw = a[0].home_yaw; a[0].clip = -1;
    return;
  }
  hw := watch_bridge_way(a[0].x, a[0].z, a[0].home_x, a[0].home_z);
  home := watch_way(w, a[0].x, a[0].z, hw.x, hw.z);
  step := lo(f32(BACK_WALK) * dt, d);
  if watch_stride(w, a, home, step) { a[0].speed = f32(BACK_WALK); }
  else if w[0].fence_n == 0 { a[0].x = a[0].home_x; a[0].z = a[0].home_z; }   // shut in: put back on their day (never through a fence)
  a[0].clip = ifx a[0].speed > 0.1 then PEOPLE_WALK else PEOPLE_IDLE;
}

// How dark the view is for your fall, 0 to 1 (0.92 at most, held while YOU DIED shows).
watch_dark :: (w: [] Watch) -> f32 {
  if w[0].dead { return 0.92 * clamp01(w[0].dead_t / f32(DEATH_FADE)); }
  if w[0].dead_t < 0 { return 0.92 * clamp01(-w[0].dead_t / f32(RISE_FADE)); }
  return 0;
}
// Whether YOU DIED shows.
watch_died_shown :: (w: [] Watch) -> bool { return w[0].dead && w[0].dead_t >= f32(DEATH_FADE) * 0.6; }

// ---- checks

watch_ground :: (heights: [] f32) { #assert everglade_build_ground(heights); }

// A watch whose everyone stands where their day starts (the spots, the beats' first points).
watch_test_town :: (w: [] Watch, heights: [] f32) {
  watch_start(w, heights);
  w[0].on = true;
  for i: 0..<EG_SPOTS { watch_home(w, i, EG_SPOT[i * 3], EG_SPOT[i * 3 + 1], EG_SPOT[i * 3 + 2], false); }
  for k: 0..<WATCH_NEW {
    p := watch_beat_at(w, k, 0, true);
    watch_home(w, EG_SPOTS + k, p.x, p.z, p.face, false);
  }
}

#test "the watch: eight guards, each beat on open ground, there and back on the shared clock" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_start(w[..], heights[..]);
  guards := 0;
  for i: 0..<WATCH_FIRST_REIN { if watch_is_guard(i) { guards += 1; } }
  #assert guards == 8 && WATCH_NEW == 6;
  for k: 0..<WATCH_NEW {
    r := w[0].beats[k..<k + 1];
    #assert r[0].n >= 2 && r[0].n < ROUTE_MAX && r[0].seconds > 8;
    for q: 1..<r[0].n {
      ax := r[0].pts[(q - 1) * ROUTE_FLOATS]; az := r[0].pts[(q - 1) * ROUTE_FLOATS + 1];
      bx := r[0].pts[q * ROUTE_FLOATS]; bz := r[0].pts[q * ROUTE_FLOATS + 1];
      d := sqrt((bx - ax) * (bx - ax) + (bz - az) * (bz - az));
      steps := cast(int) (d / 0.25) + 1;
      for s: 0..<steps + 1 {
        t := f32(s) / f32(steps);
        x := lerp(ax, bx, t); z := lerp(az, bz, t);
        #assert !everglade_in_woods(x, z);
        for b: 0..<w[0].solid_n { #assert box_gap(w[0].solids[..], b, x, z) >= f32(EG_RADIUS); }
      }
    }
    // the same clock puts them in the same place; they walk, and stand at either end
    walked := false; far := 0.0f32;
    for s: 0..<400 {
      p := watch_beat_at(w[..], k, f64(s) * 0.5 + 1000, false);
      q := watch_beat_at(w[..], k, f64(s) * 0.5 + 1000, false);
      #assert p.x == q.x && p.z == q.z;
      if p.walking { walked = true; }
      far = hi(far, flat_gap(v3(p.x, 0, p.z), v3(WATCH_BEAT[k * 10], 0, WATCH_BEAT[k * 10 + 1])));
    }
    #assert walked && far > 10;
    // still (a golden): at the beat's start
    st := watch_beat_at(w[..], k, 12345, true);
    #assert st.x == WATCH_BEAT[k * 10] && st.z == WATCH_BEAT[k * 10 + 1] && !st.walking;
  }
}

#test "a crime makes a guard who sees it hostile and you wanted; one who can't see or hear it stays calm" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  bram := 0;
  // a bolt (heard to 60 m) 20 m north of Bram's post, in the open on the road
  you := v3(EG_SPOT[0] + 6, 0, EG_SPOT[1] - 6);
  at := v3(EG_SPOT[0], 0, EG_SPOT[1] - 20);
  #assert w[0].actors[bram].mode == WM_CALM && !w[0].wanted;
  turned := watch_crime(w[..], at, WATCH_HEAR[1], you, nob[..], 0, heights[..]);
  #assert turned >= 1 && w[0].actors[bram].mode == WM_CHASE && w[0].wanted && w[0].actors[bram].shout >= 0;
  // the guard on the North Gate's lane is 130 m off: they neither see nor hear it
  #assert w[0].actors[EG_SPOTS + 5].mode == WM_CALM;
  // with a building between, a guard too far to hear sees nothing
  w2: [1] Watch;
  watch_test_town(w2[..], heights[..]);
  wall := [6] f32.[EG_SPOT[0] - 5, -10, EG_SPOT[1] - 12, EG_SPOT[0] + 5, 20, EG_SPOT[1] - 11];
  quiet := watch_crime(w2[..], at, 1.0, v3(at.x, 0, at.z - 2), wall[..], 1, heights[..]);
  #assert w2[0].actors[bram].mode == WM_CALM && quiet == 0 && !w2[0].wanted;
  // and the townsfolk who see it run (the stable hand by the road)
  #assert w[0].actors[2].mode == WM_FLEE;
  // a still page has no crime
  w3: [1] Watch;
  watch_test_town(w3[..], heights[..]);
  w3[0].on = false;
  #assert watch_crime(w3[..], at, 100, you, nob[..], 0, heights[..]) == 0 && !w3[0].wanted;
}

#test "a hostile guard runs to you and its blows resolve under the SRD: d20 + 3 against your AC 15, 1d6 + 1" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  // Tilda at the gate; you 10 m up the road from her
  g := 1;
  you := v3(EG_SPOT[g * 3], 0, EG_SPOT[g * 3 + 1] - 10);
  _ := watch_crime(w[..], v3(you.x, 0, you.z - 3), WATCH_HEAR[0], you, nob[..], 0, heights[..]);
  #assert w[0].actors[g].mode == WM_CHASE;
  start := flat_gap(v3(w[0].actors[g].x, 0, w[0].actors[g].z), you);
  for f: 0..<60 { watch_tick(w[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]); }
  moved := start - flat_gap(v3(w[0].actors[g].x, 0, w[0].actors[g].z), you);
  #assert moved > 3.5 && moved < 5.5 && w[0].actors[g].clip == PEOPLE_RUN;
  // in reach, they swing: every blow is an attack roll; the hits take 2 to 7 (13 on a crit) off you
  w[0].hp = 100000; w[0].max = 100000;
  for f: 0..<60 * 120 {
    before := w[0].hp;
    watch_tick(w[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]);
    took := before - w[0].hp;
    #assert took == 0 || (took >= 2 && took <= 26);
  }
  #assert flat_gap(v3(w[0].actors[g].x, 0, w[0].actors[g].z), you) <= f32(REACH) + 0.01;
  blows := w[0].hits + w[0].misses;
  // the guards swing every 1.9 s; with Bram and the stable hand's fright about, at least Tilda's 60
  #assert blows >= 55;
  // 12 or better on the d20 (45%)
  #assert w[0].hits * 100 / blows > 30 && w[0].hits * 100 / blows < 62;
}

#test "you die at 0 HP: the view fades, YOU DIED, then you stand at the Road In whole and wanted no more" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  you := v3(EG_SPOT[3], 0, EG_SPOT[4] - 8);
  _ := watch_crime(w[..], v3(EG_SPOT[3] + 20, 0, EG_SPOT[4]), WATCH_HEAR[0], you, nob[..], 0, heights[..]);
  #assert w[0].wanted && w[0].hp == 44;
  watch_hurt_you(w[..], 40);
  #assert !w[0].dead && w[0].hp == 4;
  watch_hurt_you(w[..], 7);
  #assert w[0].dead && w[0].hp == 0;
  #assert watch_dark(w[..]) == 0;
  for f: 0..<6 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert watch_dark(w[..]) > 0.3 && watch_dark(w[..]) < 0.6;
  for f: 0..<14 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].dead && watch_died_shown(w[..]) && !w[0].respawn;
  // the hunters stand down while you lie there
  for i: 0..<WATCH_ACTORS { #assert w[0].actors[i].mode != WM_CHASE; }
  for f: 0..<16 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].respawn && !w[0].dead && w[0].hp == w[0].max && !w[0].wanted;
  #assert watch_dark(w[..]) > 0.5;
  for f: 0..<10 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert watch_dark(w[..]) == 0;
}

#test "a blast hurts or kills the townsfolk and the watch; R or the dawn stands them up; a fallen guard is replaced" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  you := v3(0, 0, -30);
  // 20d6 + 20d6 on the market's stalls: everyone there falls dead (40 to 240, half at least 20 > 11)
  big := SrdDamage.{amount = 70, kind = DMG_FIRE, amount2 = 70, kind2 = DMG_BLUDGEONING};
  n := watch_blast(w[..], v3(EG_SPOT[8 * 3], 0, EG_SPOT[8 * 3 + 1]), 4, big, you, 0, heights[..]);
  #assert n >= 2 && w[0].actors[8].mode == WM_DEAD && w[0].actors[7].mode == WM_DEAD;
  // a light blow knocks one down, and they get up and run
  watch_harm(w[..], 9, 1, you);
  #assert w[0].actors[9].mode == WM_DOWN && w[0].actors[9].hp == 3;
  for f: 0..<20 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert (w[0].actors[9].mode == WM_DOWN && w[0].actors[9].clip == PEOPLE_IDLE) || w[0].actors[9].mode == WM_FLEE;
  for f: 0..<20 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].actors[9].mode == WM_FLEE || w[0].actors[9].mode == WM_COWER;
  // the dead lie where they fell
  for f: 0..<100 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].actors[8].mode == WM_DEAD && w[0].actors[8].clip == PEOPLE_DIE && w[0].actors[8].hold;
  // R: everyone stands again, whole
  #assert watch_restore(w[..]) >= 2;
  #assert w[0].actors[8].mode == WM_CALM && w[0].actors[8].hp == w[0].actors[8].max && w[0].actors[7].mode == WM_CALM;
  // the dawn does it too
  watch_harm(w[..], 10, 100, you);
  #assert w[0].actors[10].mode == WM_DEAD;
  watch_tick(w[..], 0.1, you, 0.2, nob[..], 0, heights[..]);
  #assert w[0].actors[10].mode == WM_DEAD;
  watch_tick(w[..], 0.1, you, 0.26, nob[..], 0, heights[..]);
  #assert w[0].actors[10].mode == WM_CALM;
  // a guard who falls is back on their beat GUARD_BACK s on, hunting you while you are wanted
  g := EG_SPOTS + 2;
  w[0].wanted = true;
  watch_harm(w[..], g, 100, you);
  #assert w[0].actors[g].mode == WM_DEAD;
  for f: 0..<cast(int) (f32(GUARD_BACK) * 10) + 2 { w[0].unseen = 0; watch_tick(w[..], 0.1, v3(EG_SPOT[3], 0, EG_SPOT[4]), 0.5, nob[..], 0, heights[..]); }
  #assert w[0].actors[g].mode == WM_CHASE && w[0].actors[g].hp == SRD_GUARD.hp;
}

#test "out of every hunter's sight for a while, you are wanted no more and the watch walk back" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  you := v3(EG_SPOT[0], 0, EG_SPOT[1] - 8);
  _ := watch_crime(w[..], you, WATCH_HEAR[1], you, nob[..], 0, heights[..]);
  #assert w[0].wanted;
  // a wall between you and everyone
  wall := [6] f32.[-200, -10, EG_SPOT[1] - 3, 200, 50, EG_SPOT[1] - 2.5];
  far := v3(EG_SPOT[0], 0, EG_SPOT[1] - 60);
  for f: 0..<cast(int) (f32(WANTED_LOSE) * 10) + 5 { watch_tick(w[..], 0.1, far, 0.5, wall[..], 1, heights[..]); }
  #assert !w[0].wanted;
  for i: 0..<WATCH_ACTORS { #assert w[0].actors[i].mode != WM_CHASE; }
  #assert w[0].actors[0].mode == WM_BACK || w[0].actors[0].mode == WM_CALM;
  for f: 0..<1200 { watch_tick(w[..], 0.1, far, 0.5, wall[..], 1, heights[..]); }
  #assert w[0].actors[0].mode == WM_CALM;
}

#test "a guard chasing you over the river runs on the bridge's deck, at its height, the whole way" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  br := EG_BRIDGE;
  g := EG_SPOTS + 4;   // the East Gate's guard
  for trip: 0..<2 {
    // from the west bank, south of the bridge, to you on the east bank north of it (and back)
    sx := ifx trip == 0 then br[0] - 8 else br[2] + 5;
    yx := ifx trip == 0 then br[2] + 5 else br[0] - 10;
    w[0].actors[g].mode = WM_CHASE; w[0].actors[g].x = sx; w[0].actors[g].z = br[1] - 6; w[0].actors[g].cool = 100;
    you := v3(yx, 0, br[3] + 5);
    you.y = watch_feet_y(w[..], heights[..], you.x, you.z);
    w[0].actors[g].seen_x = you.x; w[0].actors[g].seen_z = you.z;
    w[0].wanted = true;
    crossed := false; on_deck := 0;
    for f: 0..<60 * 30 {
      w[0].unseen = 0;
      watch_tick(w[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]);
      a := w[0].actors[g];
      if a.x >= br[0] && a.x <= br[2] {
        // in the river's span only on the deck, and there at the deck's height
        #assert a.z >= br[1] + 0.3 && a.z <= br[3] - 0.3;
        #assert watch_feet_y(w[..], heights[..], a.x, a.z) == w[0].deck;
        on_deck += 1;
      }
      if (trip == 0 && a.x > br[2] + 1) || (trip == 1 && a.x < br[0] - 1) { crossed = true; }
    }
    #assert crossed;
    #assert on_deck > 60;
  }
  // the bridge's rails stand in a runner's way; its deck between them does not
  #assert !watch_open(w[..], 88, br[1] + 0.18) && !watch_open(w[..], 88, br[3] - 0.18) && watch_open(w[..], 88, -11.5);
  #assert watch_feet_y(w[..], heights[..], 88, -11.5) == w[0].deck && w[0].deck > watch_feet_y(w[..], heights[..], 88, br[1] - 3) + 0.5;
}

#test "out of a sword's reach above them (levitating 6 m up), no blow lands; a guard below throws spears; on the ground they cut" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  g := 1;
  x := EG_SPOT[g * 3]; z := EG_SPOT[g * 3 + 1] - 3;
  ground := watch_feet_y(w[..], heights[..], x, z);
  you := v3(x, ground + 6, z);
  _ := watch_crime(w[..], v3(x, ground, z - 3), WATCH_HEAR[0], you, nob[..], 0, heights[..]);
  w[0].hp = 100000; w[0].max = 100000;
  shouted := false;
  for f: 0..<60 * 40 {
    watch_tick(w[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]);
    if w[0].actors[g].shout == UP_SHOUT { shouted = true; }
  }
  #assert w[0].hits == 0 && w[0].misses == 0;
  #assert w[0].spear_hits + w[0].spear_misses >= 8 && shouted;
  // Tilda stands under you
  #assert flat_gap(v3(w[0].actors[g].x, 0, w[0].actors[g].z), you) < f32(REACH) + 0.5;
  // you come down: the sword lands
  you.y = ground;
  for f: 0..<60 * 30 { watch_tick(w[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].hits > 0;
  #assert watch_span_gap(0, 6) > 4 && watch_span_gap(0, 1.0) == 0 && watch_span_gap(5, 0) > 3;
}

#test "a blast throws a guard out from it and up: they tumble, land, lie on their backs, and get up where they came down" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  you := v3(0, 0, -30);
  g := EG_SPOTS + 1;   // round the commons: open ground
  gx := w[0].actors[g].x; gz := w[0].actors[g].z;
  at := v3(gx - 1.5, watch_feet_y(w[..], heights[..], gx, gz), gz);
  // a light blast (it knocks them down, it doesn't kill)
  light := SrdDamage.{amount = 1, kind = DMG_FIRE, amount2 = 0, kind2 = DMG_FIRE};
  #assert watch_blast(w[..], at, 3.4, light, you, WATCH_THROW[1], heights[..]) == 1;
  a := w[0].actors[g];
  #assert a.mode == WM_DOWN && a.body.on && a.body.vx > 2 && a.body.vy > 2;
  top := 0.0f32; landed_at := -1;
  land := v3(0, 0, 0); rose := v3(0, 0, 0); risen := false; lay := false;
  for f: 0..<60 * 8 {
    watch_tick(w[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]);
    b := w[0].actors[g].body;
    feet := watch_feet_y(w[..], heights[..], b.x, b.z);
    top = hi(top, b.y - feet);
    // never under the ground
    #assert b.y >= feet + f32(TUMBLE_LIE) - 0.01;
    if b.on { #assert w[0].actors[g].mode == WM_DOWN && w[0].actors[g].t == 0 && w[0].actors[g].clip == PEOPLE_KNOCK; }
    if !b.on && landed_at < 0 { landed_at = f; land = v3(w[0].actors[g].x, 0, w[0].actors[g].z); lay = b.pitch == -f32(PI) * 0.5; }
    if landed_at >= 0 && !risen && w[0].actors[g].mode == WM_DOWN && tumble_turn(b) == 0 { #assert w[0].actors[g].clip == PEOPLE_KNOCK || w[0].actors[g].clip == PEOPLE_IDLE; }
    if landed_at >= 0 && !risen && w[0].actors[g].mode != WM_DOWN { risen = true; rose = v3(w[0].actors[g].x, 0, w[0].actors[g].z); }
  }
  // thrown away from the blast (east), up into the air, came down and lay on its back
  #assert landed_at > 20 && landed_at < 60 * 6 && top > 1.5;
  #assert land.x > gx + 2.5 && lay;
  // and up again where they landed, not back where they stood
  #assert risen && flat_gap(rose, land) < 0.5 && flat_gap(rose, v3(gx, 0, gz)) > 2;
  // a killing blast throws them too, and they lie dead where they land; R stands them up
  w2: [1] Watch;
  watch_test_town(w2[..], heights[..]);
  big := SrdDamage.{amount = 70, kind = DMG_FIRE, amount2 = 70, kind2 = DMG_BLUDGEONING};
  _ := watch_blast(w2[..], at, 4, big, you, WATCH_THROW[0], heights[..]);
  #assert w2[0].actors[g].mode == WM_DEAD && w2[0].actors[g].body.on;
  for f: 0..<60 * 8 { watch_tick(w2[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]); }
  #assert w2[0].actors[g].mode == WM_DEAD && !w2[0].actors[g].body.on && w2[0].actors[g].clip == PEOPLE_DIE && w2[0].actors[g].x > gx + 2.5;
  #assert watch_restore(w2[..]) >= 1 && w2[0].actors[g].mode == WM_CALM && !w2[0].actors[g].body.on && w2[0].actors[g].body.settle < 0;
  // the dawn does it too
  _ = watch_blast(w2[..], at, 4, big, you, WATCH_THROW[0], heights[..]);
  for f: 0..<60 * 8 { watch_tick(w2[..], 1.0 / 60.0, you, 0.2, nob[..], 0, heights[..]); }
  watch_tick(w2[..], 0.1, you, 0.26, nob[..], 0, heights[..]);
  #assert w2[0].actors[g].mode == WM_CALM;
  // a wall stops a thrown body: it comes back off it
  w3: [1] Watch;
  watch_test_town(w3[..], heights[..]);
  w3[0].actors[g].body.on = false;
  wall := [5] f32.[gx + 1.5, gz - 5, gx + 1.5, gz + 5, 0.1];
  watch_fences(w3[..], wall[..], 1);
  watch_harm(w3[..], g, 0, you);
  watch_throw(w3[..], g, v3(9, 3, 0), heights[..]);
  for f: 0..<60 * 8 { watch_tick(w3[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]); #assert w3[0].actors[g].body.x < gx + 1.5; }
}

#test "you die: you topple and lie there through YOU DIED; a blast that kills you throws your body" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  you := v3(0, watch_feet_y(w[..], heights[..], 0, -30), -30);
  #assert watch_you_fall(w[..]) == 0;
  watch_hurt_you(w[..], 100);
  #assert w[0].dead && watch_you_fall(w[..]) == 0;
  for f: 0..<6 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert watch_you_fall(w[..]) < -0.3 && watch_you_fall(w[..]) > -1.5;
  for f: 0..<14 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert abs(watch_you_fall(w[..]) + f32(PI) * 0.5) < 0.001 && watch_died_shown(w[..]);
  w2: [1] Watch;
  watch_test_town(w2[..], heights[..]);
  watch_hurt_you_thrown(w2[..], 10, you, 0, v3(0, 5, 6));
  #assert !w2[0].dead && !w2[0].you_body.on;
  watch_hurt_you_thrown(w2[..], 100, you, 0, v3(0, 5, 6));
  #assert w2[0].dead && w2[0].you_body.on;
  for f: 0..<60 * 3 { watch_tick(w2[..], 1.0 / 60.0, you, 0.5, nob[..], 0, heights[..]); }
  #assert !w2[0].you_body.on;
  #assert w2[0].you_body.z > you.z + 2;
  #assert w2[0].you_body.pitch == -f32(PI) * 0.5;
}

#test "the heat: crimes and fallen hunters raise WANTED 1 to 5; each level's wave comes in at the gate nearest you; never over 12 hunting" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  you := v3(EG_SPOT[0] + 6, 0, EG_SPOT[1] - 6);
  #assert watch_level_for(0) == 1 && watch_level_for(7) == 1 && watch_level_for(8) == 2 && watch_level_for(18) == 3 && watch_level_for(32) == 4 && watch_level_for(50) == 5 && watch_level_for(999) == 5;
  _ := watch_crime(w[..], v3(EG_SPOT[0], 0, EG_SPOT[1] - 20), WATCH_HEAR[1], you, nob[..], 0, heights[..]);
  watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]);
  #assert w[0].wanted && w[0].level == 1 && w[0].heat == HEAT_CRIME && w[0].waves == 0;
  // you cut down a hunter: the heat rises by a kill; one a hunter's own spell fells adds nothing
  g := 0;
  watch_harm(w[..], g, 100, you);
  #assert w[0].heat == HEAT_CRIME + HEAT_KILL;
  w[0].enemy_fire = true; watch_harm(w[..], 1, 1, you); w[0].enemy_fire = false;
  #assert w[0].heat == HEAT_CRIME + HEAT_KILL;
  watch_harm(w[..], 1, 1, you);
  #assert w[0].heat == HEAT_CRIME + HEAT_KILL + HEAT_DOWN;
  // 8: level 2, two guards and two Veterans in by the South Gate (nearest you)
  w[0].heat = 8;
  watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]);
  #assert w[0].level == 2 && w[0].waves == 1 && w[0].spawned == 4;
  vets := 0;
  for i: WATCH_FIRST_REIN..<WATCH_ACTORS {
    a := w[0].actors[i];
    if !a.homed { continue; }
    #assert a.mode == WM_CHASE && flat_gap(v3(a.x, 0, a.z), v3(WATCH_GATE[0], 0, WATCH_GATE[1])) < 3;
    if a.rank == RANK_VETERAN { vets += 1; #assert a.hp == SRD_VETERAN.hp && watch_stats(w[..], i).ac == 17; }
  }
  #assert vets == 2;
  // all the way to 5: the Mages', Knights' and Priest's, and the Archmage's company, as far as the cap allows
  w[0].heat = 60;
  watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]);
  #assert w[0].level == 5 && w[0].waves == 4 && watch_hunters(w[..]) <= HUNTERS_MAX && watch_hunters(w[..]) >= 10;
  mages := 0; archmage := 0;
  for i: WATCH_FIRST_REIN..<WATCH_ACTORS {
    b := w[0].actors[i];
    if b.homed && b.mode == WM_CHASE && b.rank == RANK_MAGE { mages += 1; }
    if b.homed && b.mode == WM_CHASE && b.rank == RANK_ARCHMAGE { archmage += 1; }
  }
  #assert mages == 2 && archmage == 1;
  // with every guard of the watch already after you, the higher ranks still come: the lowest go back out
  w3: [1] Watch;
  watch_test_town(w3[..], heights[..]);
  _ = watch_crime(w3[..], you, 100, you, nob[..], 0, heights[..]);
  for i: EG_SPOTS..<WATCH_FIRST_REIN { w3[0].actors[i].mode = WM_CHASE; }
  for i: 0..<EG_SPOTS { if watch_is_guard(i) { w3[0].actors[i].mode = WM_CHASE; } }
  w3[0].heat = 60;
  watch_tick(w3[..], 0.1, you, 0.5, nob[..], 0, heights[..]);
  top := 0;
  for i: WATCH_FIRST_REIN..<WATCH_ACTORS { b := w3[0].actors[i]; if b.homed && b.mode == WM_CHASE && b.rank >= RANK_KNIGHT { top += 1; } }
  #assert w3[0].level == 5 && watch_hunters(w3[..]) <= HUNTERS_MAX && top >= 3;
  // and nearer the East Gate, a wave comes in there
  w2: [1] Watch;
  watch_test_town(w2[..], heights[..]);
  east := v3(55, 0, 2);
  _ = watch_crime(w2[..], east, 100, east, nob[..], 0, heights[..]);
  w2[0].heat = 8;
  watch_tick(w2[..], 0.1, east, 0.5, nob[..], 0, heights[..]);
  #assert w2[0].level == 2 && flat_gap(v3(w2[0].actors[WATCH_FIRST_REIN].x, 0, w2[0].actors[WATCH_FIRST_REIN].z), v3(59, 0, 0)) < 3;
}

#test "the heat clears out of sight (longer the higher it is) or when you die; the reinforcements walk back out of their gate" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  watch_test_town(w[..], heights[..]);
  you := v3(EG_SPOT[0], 0, EG_SPOT[1] - 8);
  _ := watch_crime(w[..], you, WATCH_HEAR[1], you, nob[..], 0, heights[..]);
  w[0].heat = 18;
  watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]);
  #assert w[0].level == 3 && watch_lose_after(w[..]) == f32(WANTED_LOSE) * 2;
  wall := [6] f32.[-200, -10, EG_SPOT[1] - 3, 200, 50, EG_SPOT[1] - 2.5];
  far := v3(EG_SPOT[0], 0, EG_SPOT[1] - 60);
  // past level 1's 18 s it holds; past level 3's 36 s it clears
  for f: 0..<cast(int) (f32(WANTED_LOSE) * 10) + 20 { watch_tick(w[..], 0.1, far, 0.5, wall[..], 1, heights[..]); }
  #assert w[0].wanted && w[0].level == 3;
  for f: 0..<cast(int) (f32(WANTED_LOSE) * 10) { watch_tick(w[..], 0.1, far, 0.5, wall[..], 1, heights[..]); }
  #assert !w[0].wanted && w[0].level == 0 && w[0].heat == 0;
  for i: WATCH_FIRST_REIN..<WATCH_ACTORS { if w[0].actors[i].homed { #assert w[0].actors[i].mode == WM_BACK; } }
  for f: 0..<600 { watch_tick(w[..], 0.1, far, 0.5, wall[..], 1, heights[..]); }
  for i: WATCH_FIRST_REIN..<WATCH_ACTORS { #assert !w[0].actors[i].homed; }
  // you die: it clears
  w2: [1] Watch;
  watch_test_town(w2[..], heights[..]);
  _ = watch_crime(w2[..], you, WATCH_HEAR[1], you, nob[..], 0, heights[..]);
  w2[0].heat = 32;
  watch_tick(w2[..], 0.1, you, 0.5, nob[..], 0, heights[..]);
  #assert w2[0].level == 4;
  watch_hurt_you(w2[..], 999);
  for f: 0..<40 { watch_tick(w2[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert !w2[0].dead && w2[0].level == 0 && !w2[0].wanted;
}

// A town with caster rank r put 12 m from you on open ground (the commons), hunting you.
watch_test_caster :: (w: [] Watch, heights: [] f32, r: int, you: Point) -> int {
  watch_test_town(w, heights);
  w[0].wanted = true; w[0].level = 5; w[0].heat = 999;
  i := WATCH_FIRST_REIN;
  a := w[0].actors[i..<i + 1];
  a[0].rank = r; a[0].home_x = you.x + 12; a[0].home_z = you.z; a[0].home_yaw = 0;
  watch_revive(w, i);
  a[0].homed = true; a[0].mode = WM_CHASE; a[0].seen_x = you.x; a[0].seen_z = you.z;
  a[0].yaw = atan2(you.x - a[0].x, you.z - a[0].z);
  return i;
}

#test "the casters: a Mage's Fire Bolt and Ray of Frost, Hold Person, and a Fireball that throws you; dodged bolts miss" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  you := v3(0, 0, 9);
  you.y = watch_feet_y(w[..], heights[..], you.x, you.z);
  i := watch_test_caster(w[..], heights[..], RANK_MAGE, you);
  w[0].hp = 100000; w[0].max = 100000;
  #assert watch_caster(w[..], i) && w[0].actors[i].hp == SRD_MAGE.hp;
  // they stand off and cast at you
  for f: 0..<300 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].spell_hits + w[0].spell_misses >= 5 && w[0].hp < w[0].max;
  g := flat_gap(v3(w[0].actors[i].x, 0, w[0].actors[i].z), you);
  #assert g >= f32(CAST_NEAR) - 0.6 && g <= f32(CAST_FAR) + 0.6;
  // a Fireball on you: 8d6 fire (a save for half) and it throws you back and up
  w[0].knocked = false; w[0].knock = v3(0, 0, 0);
  before := w[0].hp;
  watch_cast(w[..], i, MS_FIREBALL, watch_feet_y(w[..], heights[..], w[0].actors[i].x, w[0].actors[i].z), you, heights[..]);
  for f: 0..<20 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].hp < before && before - w[0].hp <= 48 && w[0].knocked && w[0].knock.y > 0;
  // a Fire Bolt you step away from misses you
  hits := w[0].spell_hits;
  w[0].actors[i].cast_cool = 1000; w[0].actors[i].casting = -1;
  for q: 0..<MISSILES { w[0].missiles[q].live = false; }
  watch_cast(w[..], i, MS_FIRE_BOLT, watch_feet_y(w[..], heights[..], w[0].actors[i].x, w[0].actors[i].z), you, heights[..]);
  away := v3(you.x, you.y, you.z + 4);
  for f: 0..<20 { watch_tick(w[..], 0.1, away, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].spell_hits == hits;
  // Ray of Frost slows you; Hold Person holds you (you can't move) and you break free within its saves
  w[0].slow_t = 0;
  for q: 0..<12 { if w[0].slow_t <= 0 { watch_cast(w[..], i, MS_FROST, 0, you, heights[..]); for f: 0..<3 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); } } }
  #assert w[0].slow_t > 0 && watch_pace(w[..]) < 1;
  held := false;
  for q: 0..<20 {
    if watch_held(w[..]) { held = true; break; }
    watch_cast(w[..], i, MS_HOLD, 0, you, heights[..]);
    for f: 0..<4 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  }
  #assert held;
  w[0].actors[i].hold_cool = 1000;
  for f: 0..<cast(int) (f32(HOLD_FOR) * f32(HOLD_SAVES + 1) * 10) + 5 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert !watch_held(w[..]);
}

#test "the casters: a Priest heals the watch and marks you with Guiding Bolt; an Archmage's Lightning Bolt and Cone of Cold" {
  heights: [EG_GROUND_POINTS] f32;
  watch_ground(heights[..]);
  w: [1] Watch;
  nob: [6] f32;
  you := v3(0, 0, 9);
  you.y = watch_feet_y(w[..], heights[..], you.x, you.z);
  i := watch_test_caster(w[..], heights[..], RANK_PRIEST, you);
  w[0].hp = 100000; w[0].max = 100000;
  // a hurt guard near the priest: healed 2d8 + 3
  g := EG_SPOTS + 1;
  w[0].actors[g].x = w[0].actors[i].x + 3; w[0].actors[g].z = w[0].actors[i].z;
  w[0].actors[g].mode = WM_CHASE; w[0].actors[g].hp = 2;
  w[0].actors[i].cast_cool = 0;
  for f: 0..<20 { watch_tick(w[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w[0].heals >= 1 && w[0].actors[g].hp >= 2 + 5;
  // Guiding Bolt: the next attack at you has advantage, then the mark is spent
  w[0].marked = true;
  _ := watch_roll_at_you(w[..], 3, SRD_GUARD);
  #assert !w[0].marked;
  // the Archmage: a Lightning Bolt down a line through you, a Cone of Cold on you; both throw you
  w2: [1] Watch;
  j := watch_test_caster(w2[..], heights[..], RANK_ARCHMAGE, you);
  w2[0].hp = 100000; w2[0].max = 100000;
  feet := watch_feet_y(w2[..], heights[..], w2[0].actors[j].x, w2[0].actors[j].z);
  before := w2[0].hp;
  watch_cast(w2[..], j, MS_LIGHTNING, feet, you, heights[..]);
  for f: 0..<3 { watch_tick(w2[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w2[0].hp < before && before - w2[0].hp <= 48 && w2[0].knocked;
  before = w2[0].hp; w2[0].knocked = false;
  watch_cast(w2[..], j, MS_COLD, feet, you, heights[..]);
  for f: 0..<3 { watch_tick(w2[..], 0.1, you, 0.5, nob[..], 0, heights[..]); }
  #assert w2[0].hp < before && before - w2[0].hp <= 64 && w2[0].knocked;
  // out of the line, the bolt misses
  before = w2[0].hp;
  watch_cast(w2[..], j, MS_LIGHTNING, feet, you, heights[..]);
  for f: 0..<3 { watch_tick(w2[..], 0.1, v3(you.x, you.y, you.z + 8), 0.5, nob[..], 0, heights[..]); }
  #assert w2[0].hp == before;
}
