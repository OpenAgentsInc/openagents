// Experimental village hostiles: Everglade watch-style pursuit and SRD melee.
#module "verse.experimentalhostiles";
#load "experimental-village.coax" as village;
#load "experimental-terrain.coax" as terrain;
#load "experimental-dungeon.coax" as dungeon;
#load "rules/srd5-combat.coax";
#load "hostile-contact.coax";

// dead: felled (apps/openagents-web/experimental-combat.coax, #13025), at `died` on the creator's clock; held: restrained, it strikes but can't move;
// inactive: cannot begin or continue an attack, independently of movement
// stopped: a scoped hit stop holds this one for the frame (its owner's react_held, aethyr/action/react.coax); the rest of the world goes on
// kind: experimental-dungeon.coax's DG_KIND_*, scale its size; a sleeper waits where it stands until it sees you near
// (every monster is one since #13066: the village's six wait at home too, so none hunts you from your spawn)
Enemy :: struct {walk_scale:f32=1;x:f32;z:f32;home_x:f32;home_z:f32;face_x:f32;face_z:f32;cool:f32;swing:f32;struck:bool;moving:bool;awake:bool;dead:bool;died:f32;held:bool;inactive:bool;stopped:bool;kind:int;scale:f32 = 1;sleeper:bool;shot:bool;}   // shot: its swing is a ranged attack
// the village's six (two of them, 2 and 5, in the dungeon's entrance hall) and the dungeon's own
HS_N :: HC_MAX;
DamagePop :: struct {amount:int;x:f32;y:f32;z:f32;born:f32;}
// A ranged attack in flight (#13066): loosed by enemy `foe` at `t0` (Hostiles.time) from (fx, fy, fz)
// toward where you stood, (tx, ty, tz) (world metres), arriving `fly` seconds later. state:
// HS_FLYING, then HS_LANDING (offered to the shared battle on arrival), then HS_LANDED with `hit`
// known: a hit strikes you, a miss flies on past. `shown` and `ended`: the presenter
// (experimental-combat.coax xc_shots_step) has drawn its flight and its end.
HS_FREE :: 0; HS_FLYING :: 1; HS_LANDING :: 2; HS_LANDED :: 3;
HsShot :: struct {state:int;foe:int;kind:int;fx:f32;fy:f32;fz:f32;tx:f32;ty:f32;tz:f32;t0:f32;fly:f32;hit:bool;shown:bool;ended:bool;}
HS_SHOTS :: 16;
// How fast a kind's missile flies, m/s: a shortbow's arrow, or a thrown javelin or rock.
hostile_shot_speed :: (kind:int)->f32 {return ifx kind==dungeon.DG_KIND_GREMLIN then 30.0f32 else 15.0f32;}
// A shot's tell: the draw or wind-up (the body's attack clip) before it leaves the hand, seconds;
// its swing ends HS_SHOT_END after it began.
HS_DRAW :: 0.6; HS_SHOT_END :: 1.0;
// A safe spawn (#13066): nothing wakes, starts an attack or lands one while you are within
// `safe_r` metres of the spawn (0, 0), nor before `calm_until` (Hostiles.time) after you appear.
HS_SAFE_R :: 12.0; HS_CALM :: 3.0;
Hostiles :: struct {ready:bool;enemies:[HS_N]Enemy;hp:int;max_hp:int=44;temp:int;player_dead:bool;shared:bool;contacts:[1]HcContacts;hits:int;time:f32;died_at:f32;pops:[8]DamagePop;pop_next:int;dice:[1]SrdDice;last:int= -1;shots:[HS_SHOTS]HsShot;safe_r:f32=HS_SAFE_R;calm_until:f32=HS_CALM;}   // last: the enemy whose blow landed last
// Whether you stand safe from every monster at (x, z): in the spawn's safe radius, or still calm.
hostile_safe :: (s:[]Hostiles,x:f32,z:f32)->bool {return s[0].time<s[0].calm_until || x*x+z*z<s[0].safe_r*s[0].safe_r;}
// Starts calm again (a respawn): HS_CALM seconds from now nothing engages you, and no shot flies.
hostile_calm :: (s:[]Hostiles) {s[0].calm_until=s[0].time+HS_CALM;for i:0..<HS_SHOTS {s[0].shots[i]=HsShot.{};}}
#test "six enemies pursue and inflict real melee damage" #steps 200000000 {
 s:[1]Hostiles;hostile_test_start(s[..]);#assert s[0].ready && s[0].hp==44;
 before:=abs(s[0].enemies[0].x)+abs(s[0].enemies[0].z);
 for i:0..<600 {hostile_tick(s[..],0,0,0,0.016);}
 #assert abs(s[0].enemies[0].x)+abs(s[0].enemies[0].z)<before && s[0].hits>0 && s[0].hp<44;
}
#test "a felled enemy stands still and strikes no one; a held one stays put" #steps 200000000 {
 s:[1]Hostiles;hostile_test_start(s[..]);for i:0..<6 {s[0].enemies[i].dead=true;}s[0].enemies[0].x=0.5;s[0].enemies[0].z=0;
 for i:0..<600 {hostile_tick(s[..],0,0,0,0.016);}
 #assert s[0].hits==0 && s[0].hp==44 && s[0].enemies[0].x==0.5 && !s[0].enemies[0].moving;
 s[0].enemies[1].dead=false;s[0].enemies[1].held=true;s[0].enemies[1].x= -10;s[0].enemies[1].z= -15;
 for i:0..<300 {hostile_tick(s[..],0,0,0,0.016);}
 #assert s[0].enemies[1].x== -10 && s[0].enemies[1].z== -15;
}
#test "enemies cannot pass through village walls" #steps 200000000 {
 s:[1]Hostiles;hostile_test_start(s[..]);s[0].enemies[0].x=49;s[0].enemies[0].z=46;
 for i:0..<120 {hostile_tick(s[..],49,0,43,0.016);}
 #assert s[0].enemies[0].z>45;
}
#test "a stopped enemy holds its place and its swing while the others go on" #steps 200000000 {
 s:[1]Hostiles;hostile_test_start(s[..]);s[0].enemies[0].x=0;s[0].enemies[0].z=-1;s[0].enemies[0].swing=0.1;s[0].enemies[1].x=4;s[0].enemies[1].z=0;
 s[0].enemies[0].stopped=true;a:=s[0].enemies[0];b:=s[0].enemies[1];hostile_tick(s[..],0,0,0,0.05);
 #assert s[0].enemies[0].x==a.x && s[0].enemies[0].z==a.z && s[0].enemies[0].swing==a.swing && s[0].enemies[1].x!=b.x;
 s[0].enemies[0].stopped=false;hostile_tick(s[..],0,0,0,0.05);#assert s[0].enemies[0].swing>a.swing;
}
#test "damage is recorded over the player and death sends attackers home" #steps 200000000 {
 s:[1]Hostiles;hostile_test_start(s[..]);hostile_damage(s[..],5,3,1,-2);#assert s[0].hp==39 && s[0].pops[0].amount==5 && s[0].pops[0].x==3;
 e:=s[0].enemies[0];s[0].enemies[0].x=0;s[0].enemies[0].z=0;s[0].enemies[0].swing=0.4;
 hostile_damage(s[..],100,3,1,-2);#assert s[0].hp==0 && s[0].pops[1].amount==39;
 for i:0..<100 {hostile_tick(s[..],0,0,0,0.016);}
 #assert s[0].enemies[0].swing<0 && s[0].enemies[0].moving && s[0].enemies[0].x<0 && s[0].hits==2 && e.home_x<0;
}
#test "dungeon monsters remain inside until the player approaches" #steps 200000000 {
 s:[1]Hostiles;hostile_test_start(s[..]);a:=s[0].enemies[2];b:=s[0].enemies[5];#assert a.x== -42 && b.x== -36 && a.z== -54 && b.z== -61;
 for i:0..<30 {hostile_tick(s[..],0,0,0,0.016);}#assert s[0].enemies[2].x==a.x && !s[0].enemies[2].awake;
 hostile_tick(s[..],-42,0,-53,0.016);#assert s[0].enemies[2].awake && !s[0].enemies[5].awake;
 hostile_tick(s[..],-36,0,-60,0.016);#assert s[0].enemies[5].awake;
}
#test "the dungeon holds 41 monsters in groups, tougher further in, and a sturdy boss" {
 s:[1]Hostiles;hostile_test_start(s[..]);inside:=0;boss:=-1;
 for i:0..<HS_N {e:=s[0].enemies[i];if dungeon.dg_inside(e.x,e.z,0) {inside+=1;#assert e.sleeper;}if e.kind==dungeon.DG_KIND_BOSS {boss=i;}}
 #assert inside==41 && boss>=0 && s[0].enemies[boss].scale>2 && hostile_blow(dungeon.DG_KIND_BOSS).hp>=100;
 // the entrance hall's are imps and gremlins; the boss's hall has no imp
 for i:0..<HS_N {e:=s[0].enemies[i];r:=dungeon.dg_at(dungeon.dg_col(e.x),dungeon.dg_row(e.z));if r=='A' {#assert e.kind<=1;}if r=='N' {#assert e.kind==2 || e.kind==4;}}
}
#test "a dungeon monster neither wakes nor walks through a wall" #steps 200000000 {
 s:[1]Hostiles;hostile_test_start(s[..]);for k:0..<6 {s[0].enemies[k].dead=true;}
 // F's gremlin at (-44, -88): you behind the wall in E's rock, 4 m away, do not wake it
 i:=6+8;#assert s[0].enemies[i].x== -44 && s[0].enemies[i].z== -88;
 for k:0..<10 {hostile_tick(s[..],-44,0,-83.5,0.016);}#assert !s[0].enemies[i].awake;
 // woken, it presses toward you and stops at the barracks' north wall
 s[0].enemies[i].awake=true;for k:0..<300 {hostile_tick(s[..],-44,0,-80,0.016);}
 #assert s[0].enemies[i].z< -84.55-0.29 && s[0].enemies[i].z> -86.5;
}
#test "living enemies supply moving body colliders" {
 s:[1]Hostiles;hostile_test_start(s[..]);for i:0..<6 {s[0].enemies[i].dead=true;}s[0].enemies[0].dead=false;s[0].enemies[0].x=2;s[0].enemies[0].z=3;b:[42]f32;
 n:=hostile_bodies(s[..],2,3,b[..]);#assert n==1 && b[0]==2 && b[2]==3 && b[6]>0;
 s[0].enemies[0].x=4;n=hostile_bodies(s[..],4,3,b[..]);#assert n==1 && b[0]==4;
}
#test "a surrounded player pushes living enemies aside" {
 s:[1]Hostiles;hostile_test_start(s[..]);for i:0..<6 {s[0].enemies[i].x=0;s[0].enemies[i].z=0;}
 hostile_push(s[..],0,0,0,0,-0.1);for i:0..<6 {e:=s[0].enemies[i];#assert e.x*e.x+e.z*e.z>0.01;}
}
// Hostiles are yieldable: the player's accepted movement displaces them when
// there is room, but the player is never caged by a ring of immovable bodies.
hostile_push :: (s:[]Hostiles,x:f32,y:f32,z:f32,old_x:f32,old_z:f32) {
 if !s[0].ready {return;}for i:0..<HS_N {e:=s[0].enemies[i..<i+1];if e[0].dead {continue;}
  if abs(terrain.exp_height(x,z)+y-terrain.exp_height(e[0].x,e[0].z))>1.5 {continue;}
  dx:=e[0].x-x;dz:=e[0].z-z;distance:=sqrt(dx*dx+dz*dz);room:=0.5+0.35*e[0].scale;if distance>=room {continue;}
  gap:=distance;if distance<0.001 {dx=x-old_x;dz=z-old_z;distance=sqrt(dx*dx+dz*dz);if distance<0.001 {dx=ifx i%2==0 then 1.0f32 else -1.0f32;dz=0;distance=1;}}
  ux:=dx/distance;uz:=dz/distance;push:=room-gap;if push<=0 {continue;}if push>0.15 {push=0.15;}
  nx:=e[0].x+ux*push;nz:=e[0].z+uz*push;pad:=0.3*e[0].scale;if !hostile_blocked_pad(nx,e[0].z,pad) {e[0].x=nx;}if !hostile_blocked_pad(e[0].x,nz,pad) {e[0].z=nz;}
 }
}
hostile_bodies :: (s:[]Hostiles,x:f32,z:f32,out:[]f32)->int {
 if !s[0].ready {return 0;}n:=0;ground:=terrain.exp_height(x,z);for i:0..<HS_N {e:=s[0].enemies[i];if e.dead || abs(e.x-x)>8 || abs(e.z-z)>8 {continue;}if n*7+7>out.count {break;}o:=n*7;y:=terrain.exp_height(e.x,e.z)-ground;out[o]=e.x;out[o+1]=y+0.25*e.scale;out[o+2]=e.z;out[o+3]=e.x;out[o+4]=y+1.25*e.scale;out[o+5]=e.z;out[o+6]=0.35*e.scale;n+=1;}return n;
}
// Monster i's kind: the village's three imps and three gremlins, then the dungeon's (DG_SPAWN).
// Each kind is an SRD 5.2.1 stat block (aethyr/rules/srd/monsters.coax): the imp an Imp, the
// gremlin a Goblin Warrior, the brute an Ogre, the fiend a Quasit and the boss a Hill Giant.
hostile_kind :: (i:int)->int {if i<6 {return ifx i<3 then dungeon.DG_KIND_IMP else dungeon.DG_KIND_GREMLIN;}return cast(int)dungeon.DG_SPAWN[i-6][2];}
// What a kind's blow is when no shared battle runs (the body's own fixtures): its block's first
// melee attack, the shared battle's (experimental-combat.coax) being the full Action.
HS_IMP :: SrdCreature.{name = "Imp", ac = 13, hp = 21, dex = 3, attack = 5, dice = 1, sides = 6, bonus = 3, kind = DMG_PIERCING};
HS_GOBLIN :: SrdCreature.{name = "Goblin Warrior", ac = 15, hp = 10, dex = 2, attack = 4, dice = 1, sides = 6, bonus = 2, kind = DMG_SLASHING};
HS_FIEND :: SrdCreature.{name = "Quasit", ac = 13, hp = 25, dex = 3, attack = 5, dice = 1, sides = 4, bonus = 3, kind = DMG_SLASHING};
HS_BRUTE :: SrdCreature.{name = "Ogre", ac = 11, hp = 68, dex = -1, attack = 6, dice = 2, sides = 8, bonus = 4, kind = DMG_BLUDGEONING};
HS_BOSS :: SrdCreature.{name = "Hill Giant", ac = 13, hp = 105, dex = -1, attack = 8, dice = 3, sides = 8, bonus = 5, kind = DMG_BLUDGEONING};
hostile_blow :: (kind:int)->SrdCreature {return ifx kind==dungeon.DG_KIND_FIEND then HS_FIEND else ifx kind==dungeon.DG_KIND_BRUTE then HS_BRUTE else ifx kind==dungeon.DG_KIND_BOSS then HS_BOSS else ifx kind==dungeon.DG_KIND_IMP then HS_IMP else HS_GOBLIN;}
// How far a kind shoots, metres: its block's ranged attack's normal range (the Goblin's Shortbow 80
// feet, the Ogre's Javelin 30, the Hill Giant's Trash Lob 60); 0 none.
hostile_shot :: (kind:int)->f32 {return ifx kind==dungeon.DG_KIND_GREMLIN then 24.38f32 else ifx kind==dungeon.DG_KIND_BRUTE then 9.14f32 else ifx kind==dungeon.DG_KIND_BOSS then 18.29f32 else 0;}
hostile_start :: (s:[]Hostiles) {
 if s[0].ready {return;}s[0].ready=true;s[0].hp=44;s[0].dice[0]=srd_dice(27);
 for i:0..<HS_N {x:f32;z:f32;
  if i<6 {x=ifx i==2 then -42.0f32 else ifx i==5 then -36.0f32 else ifx i%2==0 then -10.0f32 else 10.0f32;z=ifx i==2 then -54.0f32 else ifx i==5 then -61.0f32 else -15+f32(i/2)*12;}
  else {x=dungeon.DG_SPAWN[i-6][0];z=dungeon.DG_SPAWN[i-6][1];}
  k:=hostile_kind(i);s[0].enemies[i]=Enemy.{x=x,z=z,home_x=x,home_z=z,swing= -1,cool=f32(i%6)*0.15,kind=k,scale=dungeon.dg_kind_scale(k),sleeper=true};}
}
// The checks' start: no safe spawn (they place you and the monsters themselves), and the village's
// four outside the dungeon awake, as they were before every monster slept (#13066).
hostile_test_start :: (s:[]Hostiles) {hostile_start(s);s[0].safe_r=0;s[0].calm_until= -1;for i:0..<6 {if i!=2 && i!=5 {s[0].enemies[i].awake=true;}}}
hostile_blocked :: (x:f32,z:f32)->bool {return hostile_blocked_pad(x,z,0.3);}
// Whether a body `pad` round at (x, z) would stand in a wall; the village's walls take 0.3.
hostile_blocked_pad :: (x:f32,z:f32,pad:f32)->bool {
 // in and round the dungeon its own boxes are all there is, and quick to gather
 if dungeon.dg_inside(x,z,1.5) {return dungeon.dg_blocked(x,z,pad);}
 near:[1]village.EvNear;village.ev_hostile_near(near[..],x,z);
 for i:0..<near[0].wall_n {o:=i*6;if near[0].walls[o+1]>1.5 || near[0].walls[o+4]<0.2 {continue;}if x>near[0].walls[o]-0.3 && x<near[0].walls[o+3]+0.3 && z>near[0].walls[o+2]-0.3 && z<near[0].walls[o+5]+0.3 {return true;}}
 return false;
}
// Whether monster e sees the player at (x, z): no wall between (experimental-dungeon.coax dg_sight).
hostile_sees :: (e:Enemy,x:f32,z:f32)->bool {return dungeon.dg_sight(e.x,e.z,x,z);}
hostile_damage :: (s:[]Hostiles,amount:int,x:f32,y:f32,z:f32) {
 if s[0].shared || amount<=0 || s[0].hp<=0 {return;}lost:=ifx amount>s[0].hp then s[0].hp else amount;s[0].hp-=lost;s[0].hits+=1;
 s[0].pops[s[0].pop_next]=DamagePop.{amount=lost,x=x,y=y,z=z,born=s[0].time};s[0].pop_next=(s[0].pop_next+1)%8;if s[0].hp==0 {s[0].died_at=s[0].time;}
}
// Enemy i looses its shot at you, standing at (px, py, pz): from its hand toward your chest.
hostile_loose :: (s:[]Hostiles,i:int,px:f32,py:f32,pz:f32) {
 e:=s[0].enemies[i];slot:=-1;for k:0..<HS_SHOTS {if s[0].shots[k].state==HS_FREE {slot=k;break;}}if slot<0 {return;}
 dx:=px-e.x;dz:=pz-e.z;gap:=sqrt(dx*dx+dz*dz);if gap<0.01 {return;}
 hand:=0.35*e.scale;fx:=e.x+dx/gap*hand;fz:=e.z+dz/gap*hand;fy:=terrain.exp_height(e.x,e.z)+1.2*e.scale;
 ty:=terrain.exp_height(px,pz)+py+1.2;sx:=px-fx;sy:=ty-fy;sz:=pz-fz;
 s[0].shots[slot]=HsShot.{state=HS_FLYING,foe=i,kind=e.kind,fx=fx,fy=fy,fz=fz,tx=px,ty=ty,tz=pz,t0=s[0].time,fly=sqrt(sx*sx+sy*sy+sz*sz)/hostile_shot_speed(e.kind)};
}
// Shots in the air: one that arrives where you still stand (within a metre of where it was aimed,
// you not safe) is offered to the shared battle (or rolled here without one); one you stepped out
// of misses and flies on. A shot the presenter has finished with, or one left long after, is freed.
hostile_fly :: (s:[]Hostiles,px:f32,py:f32,pz:f32,safe:bool) {
 for k:0..<HS_SHOTS {q:=s[0].shots[k..<k+1];if q[0].state==HS_FREE {continue;}
  if (q[0].state==HS_LANDED && q[0].ended) || s[0].time-q[0].t0>q[0].fly+3 {q[0]=HsShot.{};continue;}
  if q[0].state!=HS_FLYING || s[0].time-q[0].t0<q[0].fly {continue;}
  dx:=px-q[0].tx;dz:=pz-q[0].tz;there:=dx*dx+dz*dz<=1.0 && abs(py)<2 && !safe && s[0].hp>0 && !s[0].enemies[q[0].foe].dead;
  if !there {q[0].state=HS_LANDED;q[0].hit=false;continue;}
  if s[0].shared {q[0].state=HS_LANDING;if !hc_offer(s[0].contacts[..],q[0].foe) {q[0].state=HS_LANDED;}continue;}
  hit:=srd_attack(s[0].dice[..],hostile_blow(q[0].kind),15);q[0].state=HS_LANDED;q[0].hit=hit.hit;
  if hit.hit {s[0].last=q[0].foe;hostile_damage(s,hit.damage,px,terrain.exp_height(px,pz)+py+2.1,pz);}
 }
}
// The shared battle's answer for foe's shot that was landing: whether it hit you.
hostile_shot_result :: (s:[]Hostiles,foe:int,hit:bool) {
 for k:0..<HS_SHOTS {if s[0].shots[k].state==HS_LANDING && s[0].shots[k].foe==foe {s[0].shots[k].state=HS_LANDED;s[0].shots[k].hit=hit;}}
}
hostile_tick :: (s:[]Hostiles,px:f32,py:f32,pz:f32,dt:f32) {
 hostile_start(s);if dt<=0 || dt>0.25 {return;}s[0].time+=dt;
 if s[0].hp<=0 {for i:0..<HS_N {e:=s[0].enemies[i..<i+1];e[0].swing= -1;e[0].moving=false;if e[0].dead || e[0].held || e[0].stopped {continue;}dx:=e[0].home_x-e[0].x;dz:=e[0].home_z-e[0].z;gap:=sqrt(dx*dx+dz*dz);if gap<0.1 {continue;}e[0].face_x=dx/gap;e[0].face_z=dz/gap;step:=ifx gap<dt*1.5*e[0].walk_scale then gap else dt*1.5*e[0].walk_scale;nx:=e[0].x+dx/gap*step;nz:=e[0].z+dz/gap*step;pad:=0.3*e[0].scale;if !hostile_blocked_pad(nx,e[0].z,pad) {e[0].x=nx;e[0].moving=true;}if !hostile_blocked_pad(e[0].x,nz,pad) {e[0].z=nz;e[0].moving=true;}}return;}
 ox:=[6]f32.[0,1.1,1.1,0,-1.1,-1.1];oz:=[6]f32.[-1.2,-0.6,0.6,1.2,0.6,-0.6];
 safe:=hostile_safe(s,px,pz);hostile_fly(s,px,py,pz,safe);
 for i:0..<HS_N {if s[0].hp<=0 {break;}e:=s[0].enemies[i..<i+1];if e[0].dead {e[0].moving=false;e[0].swing= -1;continue;}dx:=px-e[0].x;dz:=pz-e[0].z;gap:=sqrt(dx*dx+dz*dz);e[0].moving=false;
  if e[0].inactive {e[0].swing= -1;e[0].struck=false;}
  if e[0].stopped {continue;}
  if e[0].sleeper && !e[0].awake {if safe || gap>dungeon.dg_kind_wake(e[0].kind) || !hostile_sees(e[0],px,pz) {continue;}e[0].awake=true;}e[0].cool-=dt;
  if gap>0.001 {e[0].face_x=dx/gap;e[0].face_z=dz/gap;}
  // a bigger body reaches further: it stops and swings from further off
  reach:=1.45+0.45*(e[0].scale-1);
  if e[0].swing>=0 {e[0].swing+=dt;
    // a shot leaves the hand after its draw and flies (hostile_fly); a blow lands at once
    if !e[0].struck && e[0].shot && e[0].swing>=HS_DRAW {e[0].struck=true;
      if !safe && gap<=hostile_shot(e[0].kind) && abs(py)<2 && hostile_sees(e[0],px,pz) {hostile_loose(s,i,px,py,pz);}}
    if !e[0].struck && !e[0].shot && e[0].swing>=0.35 {e[0].struck=true;
      lands:=!safe && gap<reach+0.35 && !hostile_blocked((e[0].x+px)*0.5,(e[0].z+pz)*0.5);
      if lands && abs(py)<2 {if s[0].shared {accepted:=hc_offer(s[0].contacts[..],i);} else {hit:=srd_attack(s[0].dice[..],hostile_blow(e[0].kind),15);if hit.hit {s[0].last=i;hostile_damage(s,hit.damage,px,terrain.exp_height(px,pz)+py+2.1,pz);}}}}
    if e[0].swing>=(ifx e[0].shot then f32(HS_SHOT_END) else 0.8f32) {e[0].swing= -1;e[0].cool=1.1;}continue;}
  if safe {continue;}
  if gap<reach {if !e[0].inactive && e[0].cool<=0 {e[0].swing=0;e[0].struck=false;e[0].shot=false;}continue;}
  // with the shared battle, a kind with a ranged attack shoots while you stand well past its reach
  // and within its range, then closes while it readies the next
  if s[0].shared && !e[0].inactive && e[0].cool<=0 && gap>reach+3 && gap<=hostile_shot(e[0].kind) && abs(py)<2 && hostile_sees(e[0],px,pz) {e[0].swing=0;e[0].struck=false;e[0].shot=true;continue;}
  if e[0].held {continue;}
  gx:=px+ox[i%6]*e[0].scale-e[0].x;gz:=pz+oz[i%6]*e[0].scale-e[0].z;distance:=sqrt(gx*gx+gz*gz);if distance<0.01 {continue;}
  step:=ifx distance<dt*2.4*e[0].walk_scale then distance else dt*2.4*e[0].walk_scale;nx:=e[0].x+gx/distance*step;nz:=e[0].z+gz/distance*step;
  pad:=0.3*e[0].scale;if !hostile_blocked_pad(nx,e[0].z,pad) {e[0].x=nx;e[0].moving=true;}if !hostile_blocked_pad(e[0].x,nz,pad) {e[0].z=nz;e[0].moving=true;}
 }
}

#test "an inactive enemy can pursue but cancels an unlanded swing and cannot start another" {
 s:[1]Hostiles;hostile_test_start(s[..]);for i:0..<HS_N {s[0].enemies[i].dead=true;}
 e:=s[0].enemies[0..<1];e[0].dead=false;e[0].inactive=true;e[0].x=4;e[0].z=0;
 hostile_tick(s[..],0,0,0,0.05);#assert e[0].moving && e[0].x<4;
 e[0].x=0;e[0].z=-1;e[0].swing=0.34;e[0].struck=false;e[0].stopped=true;
 hostile_tick(s[..],0,0,0,0.05);#assert e[0].swing<0 && !e[0].struck && s[0].hp==44;
 e[0].stopped=false;
 for i:0..<100 {hostile_tick(s[..],0,0,0,0.05);}
 #assert s[0].hits==0 && s[0].hp==44 && e[0].swing<0;
 e[0].inactive=false;e[0].cool=0;
 hostile_tick(s[..],0,0,0,0.05);#assert e[0].swing==0 && !e[0].struck;
}

#test "a held but active enemy can strike while held and stopped bodies cannot return home through a movement block" {
 s:[1]Hostiles;hostile_test_start(s[..]);for i:0..<HS_N {s[0].enemies[i].dead=true;}
 e:=s[0].enemies[0..<1];e[0].dead=false;e[0].held=true;e[0].x=0;e[0].z=-1;e[0].cool=0;
 hostile_tick(s[..],0,0,0,0.05);#assert e[0].swing==0;
 for i:0..<100 {hostile_tick(s[..],0,0,0,0.05);}
 #assert s[0].hits>0 && e[0].x==0 && e[0].z==-1;
 s[0].hp=0;e[0].x=0;e[0].z=0;
 hostile_tick(s[..],0,0,0,0.05);#assert e[0].x==0 && e[0].z==0 && !e[0].moving;
 e[0].held=false;e[0].stopped=true;
 hostile_tick(s[..],0,0,0,0.05);#assert e[0].x==0 && e[0].z==0;
 e[0].stopped=false;e[0].dead=true;
 hostile_tick(s[..],0,0,0,0.05);#assert e[0].x==0 && e[0].z==0;
}

#test "shared contacts emit intent without rolling an attack or changing observer HP" {
  s: [1] Hostiles; hostile_test_start(s[..]); s[0].shared=true;
  for i: 0..<HS_N { s[0].enemies[i].dead=true; }
  s[0].enemies[0].dead=false; s[0].enemies[0].x=0; s[0].enemies[0].z=1; s[0].enemies[0].swing=0.34;
  before := s[0].dice[0]; hostile_tick(s[..],0,0,0,0.05);
  #assert s[0].hp==44 && s[0].hits==0 && s[0].contacts[0].count==1 && s[0].dice[0].state==before.state;
  #assert hc_take(s[0].contacts[..])==0 && hc_take(s[0].contacts[..]) == -1;
  hostile_damage(s[..],5,0,0,0); #assert s[0].hp==44 && s[0].hits==0;
}

#test "a safe spawn: nothing wakes or strikes you by the spawn or in your first seconds, and you see it coming" #steps 400000000 {
  s: [1] Hostiles; hostile_start(s[..]);
  #assert s[0].safe_r==HS_SAFE_R && s[0].calm_until==HS_CALM;
  for i: 0..<HS_N { #assert s[0].enemies[i].sleeper && !s[0].enemies[i].awake; }
  // fifteen seconds at the spawn: no one wakes, moves or swings, and you are untouched
  for k: 0..<300 { hostile_tick(s[..],0,0,0,0.05); }
  #assert s[0].hp==44 && s[0].hits==0;
  for i: 0..<HS_N { #assert !s[0].enemies[i].awake && s[0].enemies[i].swing<0; }
  // the gremlin by the spawn, you a step beside it but still inside the safe radius: it sleeps on
  g := s[0].enemies[3]; hostile_tick(s[..],g.x-2,0,g.z+0.5,0.05);
  #assert g.x*g.x+g.z*g.z<HS_SAFE_R*HS_SAFE_R && !s[0].enemies[3].awake && s[0].enemies[3].swing<0;
  // out past the safe radius and near it, it wakes; after a respawn it is calm again for HS_CALM s
  hostile_tick(s[..],g.x+4,0,g.z,0.05); #assert s[0].enemies[3].awake;
  s[0].enemies[3].awake=false; hostile_calm(s[..]); hostile_tick(s[..],g.x+4,0,g.z,0.05); #assert !s[0].enemies[3].awake;
  for k: 0..<70 { hostile_tick(s[..],g.x+4,0,g.z,0.05); }
  #assert s[0].enemies[3].awake;
}
#test "a shot flies before it lands: you can step out of its way, and one in the air lands where you stand" #steps 400000000 {
  s: [1] Hostiles; hostile_test_start(s[..]);
  for i: 0..<HS_N { s[0].enemies[i].dead=true; }
  e := s[0].enemies[3..<4]; e[0].dead=false; e[0].awake=true; e[0].x=0; e[0].z=15; e[0].cool=0;
  s[0].shared=true; hostile_tick(s[..],0,0,0,0.05);
  #assert e[0].shot && e[0].swing==0;
  // drawn for HS_DRAW, then loosed: in the air for 15 m at 30 m/s, and no contact until it arrives
  for k: 0..<13 { hostile_tick(s[..],0,0,0,0.05); }
  #assert s[0].shots[0].state==HS_FLYING && s[0].contacts[0].count==0;
  #assert s[0].shots[0].fly>0.4 && s[0].shots[0].fly<0.6;
  // you step two metres aside: it arrives where you were and misses, offering nothing
  for k: 0..<12 { hostile_tick(s[..],2,0,0,0.05); }
  #assert s[0].shots[0].state==HS_LANDED && !s[0].shots[0].hit && s[0].contacts[0].count==0;
  s[0].shots[0].ended=true; hostile_tick(s[..],2,0,0,0.05); #assert s[0].shots[0].state==HS_FREE;
  // the next, stood still for: offered to the shared battle on arrival, its answer recorded
  for k: 0..<60 { hostile_tick(s[..],2,0,0,0.05); if s[0].contacts[0].count>0 { break; } }
  #assert s[0].contacts[0].count==1 && hc_take(s[0].contacts[..])==3;
  hostile_shot_result(s[..],3,true);
  landed := false; for k: 0..<HS_SHOTS { if s[0].shots[k].state==HS_LANDED && s[0].shots[k].hit { landed=true; } }
  #assert landed;
  // an Ogre's rock flies slower; the imp has no shot
  #assert hostile_shot_speed(dungeon.DG_KIND_BRUTE)<hostile_shot_speed(dungeon.DG_KIND_GREMLIN) && hostile_shot(dungeon.DG_KIND_IMP)==0;
}
