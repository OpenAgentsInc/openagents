// Experimental meadow's building sites. Ground and placed geometry share this
// height function, leaving the original Character Create glade untouched.
#module "verse.experimentalterrain";
#load "character-glade.coax" as glade;
#load "experimental-dungeon.coax" as dungeon;
#load "../aethyr/world/building.coax" as building;
#load "../everglade/world/housewright.coax" as hw;
#load "../everglade/world/town.coax" as town;
#load "../aethyr/world/plots.coax" as plots;
#load "../aethyr/world/build-site.coax" as bs;

ExpSite :: struct {x:f32;z:f32;left:f32;right:f32;back:f32;front:f32;}
EXP_SITES :: 32;
#test "experimental building sites are distinct, walkable and inside the meadow" {
 // the dungeon (site 18) alone runs on south past the meadow, walled and roofed (experimental-dungeon.coax)
 for i:0..<EXP_SITES {a:=exp_site(i);#assert a.x-a.left> -82 && a.x+a.right<82 && (i==18 || a.z-a.back> -82) && a.z+a.front<82;
  #assert exp_clear(a.x,a.z);if i!=1 && i<19 {#assert exp_height(a.x,a.z)==glade.cg_height(a.x,a.z);}
  for j:0..<i {b:=exp_site(j);#assert a.x+a.right+4<b.x-b.left || b.x+b.right+4<a.x-a.left || a.z+a.front+4<b.z-b.back || b.z+b.front+4<a.z-a.back;}}
 #assert !exp_clear(0,0);
}
#test "village has nearby groups of buildings as well as open spawn" {
 #assert exp_site_group(4)==3 && exp_site_group(5)==0 && exp_site_group(6)==1 && exp_site_group(7)==3;
 #assert abs(exp_site(4).x-exp_site(2).x)<32 && abs(exp_site(5).z-exp_site(2).z)<22;
 #assert abs(exp_site(7).x-exp_site(0).x)<16 && !exp_clear(0,0);
 #assert exp_site_group(8)==3 && exp_site(8).x==15 && exp_site(8).z== -5;
 #assert exp_site_group(9)== -1 && exp_site(9).x==48 && exp_site(17).z==63;
 #assert exp_site_group(EXP_SHOWCASE_SITE)== -4 && exp_site(EXP_SHOWCASE_SITE).x>0 && exp_site(EXP_SHOWCASE_SITE).z>0;
 h:=exp_site(EXP_HOME_SITE);#assert exp_site_group(EXP_HOME_SITE)== -3 && h.x==exp_home().x && h.x*h.x+h.z*h.z>16*16 && h.x*h.x+h.z*h.z<24*24;
}
#test "experimental foundations are level and fade continuously into the glade" {
 for i:0..<EXP_SITES {a:=exp_site(i);y:=exp_height(a.x,a.z);
  #assert abs(exp_height(a.x-a.left,a.z-a.back)-y)<0.001;
  #assert abs(exp_height(a.x+a.right,a.z+a.front)-y)<0.001;
  x:=a.x+a.right+4;unaffected:=true;for j:0..<EXP_SITES {if exp_distance(exp_site(j),x,a.z)<4 {unaffected=false;}}
  if unaffected && exp_castle_distance(x,a.z)>=4 {#assert abs(exp_height(x,a.z)-glade.cg_height(x,a.z))<0.001;}}
}
// Each site's centre and how far its level ground runs each way. A constant table, not a chain of
// tests: exp_height reads every site for every height (23,000 reads in one Lab frame), and the
// chain cost about 70 steps a read (#13115).
EXP_SITE_AT :: [EXP_SITES]ExpSite.[
 ExpSite.{x= -18,z= -23,left=10,right=4,back=10.8,front=4.1},
 ExpSite.{x=18,z= -20,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x= -50,z=25,left=2.9,right=22,back=7,front=6.2},
 ExpSite.{x=35,z=30,left=2.9,right=6.2,back=7,front=5.2},
 ExpSite.{x= -20,z=25,left=2.9,right=6.2,back=7,front=5.2},
 ExpSite.{x= -45,z=44,left=10,right=4,back=7.5,front=4.2},
 ExpSite.{x= -19,z=45,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x= -5,z= -23,left=2.9,right=6.2,back=7,front=5.2},
 ExpSite.{x=15,z= -5,left=2.9,right=6.2,back=7,front=5.2},
 ExpSite.{x=48,z=43,left=2.5,right=2.5,back=2.5,front=2.5},   // 9 to 17: the cottages east of the meadow, a 4-wide grid 10 m apart
 ExpSite.{x=58,z=43,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x=68,z=43,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x=78,z=43,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x=48,z=53,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x=58,z=53,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x=68,z=53,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x=78,z=53,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x=48,z=63,left=2.5,right=2.5,back=2.5,front=2.5},
 ExpSite.{x= -38,z= -54,left=0,right=0,back=0,front=0},   // computed in exp_site, from the dungeon's plan
 ExpSite.{x=50,z= -20,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=18,z= -52,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=50,z= -52,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=74,z= -20,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=74,z= -52,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=18,z= -74,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=50,z= -74,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=74,z= -74,left=4.2,right=3.8,back=4.1,front=3.9},
 ExpSite.{x=36,z= -34,left=10,right=4,back=10.8,front=4.1},
 ExpSite.{x= -20,z= -5,left=2.5,right=2.5,back=2.5,front=2.5},   // EXP_HOME_SITE: exp_home(), 2.5 m each way
 // EXP_SHOWCASE_SITE to +2: the housewright showcase's three level yards (exp_showcase): the lean-to
 // and the hut, east of the food rows; the cottage, the timber house and two stone cottages, north of
 // them; and the last three stone cottages, east of those
 ExpSite.{x=26.27,z=46.0,left=15.17,right=15.17,back=6.6,front=6.6},
 ExpSite.{x=10.79,z=72.15,left=30.69,right=30.69,back=9.6,front=9.6},
 ExpSite.{x=59.95,z=78.5,left=14.3,right=14.3,back=3.7,front=3.25}
];
exp_site :: (i:int)->ExpSite {
 // the dungeon's block and its outer walls' thickness, levelled at the old dungeon's height (-38, -54)
 if i==18 {h:=f32(dungeon.DG_HALF);return ExpSite.{x= -38,z= -54,left= -38-f32(dungeon.DG_X0)+h,right=dungeon.dg_east()+38+h,back= -54-dungeon.dg_south()+h,front=f32(dungeon.DG_Z0)+54+h};}
 return EXP_SITE_AT[i];
}
#test "the site table keeps the home on exp_home and the cottages on their grid" {
 h:=exp_home();a:=EXP_SITE_AT[EXP_HOME_SITE];#assert a.x==h.x && a.z==h.z;
 for j:0..<9 {b:=EXP_SITE_AT[9+j];#assert b.x==48+f32(j%4)*10 && b.z==43+f32(j/4)*10 && b.left==2.5 && b.front==2.5;}
}
// The player's home (game: everglade/world/home.coax, the engine's 4 m room) stands here, about
// 20 m west of spawn, turned a quarter so its doorway faces spawn; its levelled site is EXP_HOME_SITE.
EXP_HOME_SITE :: 28;
exp_home :: ()->building.BuildingFrame {return building.BuildingFrame.{x= -20,z= -5,turn=1};}
// The housewright showcase (game: everglade/world/housewright.coax): one row a tier, each house
// frozen at one of its stages, from the bare site at the row's west end to the finished house at
// its east end. Two rows face each other across each 6.8 m walk: the hut (facing north, +z) and the
// lean-to (facing south) on the first yard; the cottage (north) and the timber house and stone
// cottage (south) on the second and third. Houses stand at least 3 m apart along a row, and each
// house's sign stands 0.45 m into the walk.
EXP_SHOWCASE_SITE :: 29;      // the first of its three yards
EXP_SHOWCASE_SITES :: 3;
EXP_SHOWCASE_WALK :: 6.8;     // from one row's house fronts to the other's
// Each tier's row: the houses' middles along z, which way they face (BuildingFrame turn) and each
// house's x, stage 1 first.
EXP_SHOWCASE_Z :: [5]f32.[51.3,41.45,65.85,78.25,78.5];
EXP_SHOWCASE_TURN :: [5]int.[2,0,0,2,2];
EXP_SHOWCASE_X :: [24]f32.[18.25,27.35,36.45, 13.8,22.1,30.4,38.7, -8.4,-0.5,7.4,15.3,23.2,31.1,39.0,
 -16.8,-8.2,0.4,9.0,17.6, 27.2,37.7,49.45,59.95,70.45];
exp_showcase :: (tier:int,stage:int)->building.BuildingFrame {
 return building.BuildingFrame.{x=EXP_SHOWCASE_X[hw.hw_stage_base(tier)+stage-1],z=EXP_SHOWCASE_Z[tier],turn=EXP_SHOWCASE_TURN[tier]};
}
// The town's stand-in meadow (game: everglade/world/town.coax), until Everglade II's city clearing
// draws build sites: the north-west corner of the meadow, west of the path, on flat ground. The
// meadow has no 46 m square free, so the stand-in's plots are 7.6 m on an 8.6 m pitch (the spec's are
// 10 on 12). To move the town into Everglade II, its zone calls town.town_grid(E2_CITY_X,
// E2_CITY_Z), the clearing's centre (34, -114), and passes that grid to the town stages instead.
exp_town :: ()->plots.PlotGrid {return town.town_grid_sized(-70,69.2,7.6,8.6);}
#test "the town's stand-in plots lie on flat open meadow, clear of every site, the path and the ground's edge" {
 g:=exp_town();o:[16]f32;
 for i:0..<plots.pl_count(g) {c:=plots.pl_centre(g,i);h:=g.size*0.5;
  for k:0..<9 {x:=c[0]+f32(k%3-1)*h;z:=c[1]+f32(k/3-1)*h;
   #assert abs(exp_height(x,z)-exp_height(c[0],c[1]))<0.05 && abs(x)<88 && abs(z)<88 && abs(x-glade.cg_path_x(z))>4;
   for j:0..<EXP_SITES {#assert exp_distance(exp_site(j),x,z)>4;}}}
}
#test "the showcase's yards keep 6 m clear round the red dragon mount at (17, 18)" {
 for i:0..<EXP_SHOWCASE_SITES {#assert exp_distance(exp_site(EXP_SHOWCASE_SITE+i),17,18)>6;}
}
// The yard a house stands on.
exp_showcase_site :: (tier:int,stage:int)->int {
 if tier<=hw.HW_HUT {return EXP_SHOWCASE_SITE;}
 if tier==hw.HW_STONE && stage>=3 {return EXP_SHOWCASE_SITE+2;}
 return EXP_SHOWCASE_SITE+1;
}
// Every house has a sign in front of it, right of its doorway and reaching 0.4 m past its side: a squared post and a board that the
// showcase sets the house's label on (apps/openagents-web/fivelab.coax lab_showcase_labels).
// exp_sign is the board's middle in the house's frame (x, height, z); exp_sign_part is the post
// (k 0) and the board (k 1), engine build-site parts that every stage shows.
EXP_SIGN_W :: 2.0;     // the board's width
EXP_SIGN_Y0 :: 0.75;   // its bottom and top edges
EXP_SIGN_Y1 :: 1.5;
EXP_SIGN_PARTS :: 2;
exp_sign :: (tier:int)->[3]f32 {r:=hw.HW_REACH[tier];return [3]f32.[r[0]-0.6,(EXP_SIGN_Y0+EXP_SIGN_Y1)*0.5,r[1]+0.45];}
exp_sign_part :: (tier:int,k:int)->bs.BuildPart {
 c:=exp_sign(tier);
 if k==0 {return bs.BuildPart.{stage=1,form=bs.BS_BEAM,mat=bs.BS_TIMBER,x0=c[0],y0=0,z0=c[2]-0.09,x1=c[0],y1=EXP_SIGN_Y1+0.08,z1=c[2]-0.09,t=0.05};}
 return bs.BuildPart.{stage=1,form=bs.BS_SLAB,mat=bs.BS_TIMBER,x0=c[0]-EXP_SIGN_W*0.5,y0=EXP_SIGN_Y0,z0=c[2]-0.03,x1=c[0]+EXP_SIGN_W*0.5,y1=EXP_SIGN_Y1,z1=c[2]+0.03};
}
// A house's colliders at its stage, with its sign's.
exp_showcase_boxes :: (tier:int,stage:int,out:[]f32,n:int)->int {
 f:=exp_showcase(tier,stage);c:=hw.hw_boxes(tier,stage,f,out,n);for k:0..<EXP_SIGN_PARTS {c=bs.bs_world_boxes(f,exp_sign_part(tier,k),out,c);}return c;
}
#test "each sign stands in front of its house, clear of the doorway and of the next house" {
 for t:0..<hw.HW_TIERS {c:=exp_sign(t);r:=hw.HW_REACH[t];o:=hw.hw_door_out(t);
  #assert c[0]+EXP_SIGN_W*0.5<=r[0]+0.401 && c[2]>r[1] && c[2]<r[1]+0.6 && c[0]-EXP_SIGN_W*0.5>o[0]+0.4;
  p:=exp_sign_part(t,0);b:=exp_sign_part(t,1);#assert p.form==bs.BS_BEAM && b.form==bs.BS_SLAB && p.y1>b.y1 && abs(p.x0-c[0])<0.001;}
 b:[1200]f32;#assert exp_showcase_boxes(hw.HW_LEANTO,1,b[..],0)>hw.hw_boxes(hw.HW_LEANTO,1,exp_showcase(hw.HW_LEANTO,1),b[..],0);
}
#test "the showcase's houses stand apart on their level yards, rows facing across 6.8 m walks" {
 for t:0..<hw.HW_TIERS {r:=hw.HW_REACH[t];for s:1..<hw.hw_stages(t)+1 {f:=exp_showcase(t,s);y:=exp_site(exp_showcase_site(t,s));
   // the house's reach, turned to face north or south: its sides along x
   front:=ifx f.turn==0 then f.z+r[1] else f.z-r[1];back:=ifx f.turn==0 then f.z-r[2] else f.z+r[2];
   #assert f.x-r[0]>=y.x-y.left-0.01 && f.x+r[0]<=y.x+y.right+0.01 && exp_max(-front,-back)<= -(y.z-y.back-0.01) && exp_max(front,back)<=y.z+y.front+0.01;
   if s>1 {g:=exp_showcase(t,s-1);#assert g.x+r[0]+3<=f.x-r[0]+0.01;}}}
 // the walks: the hut's and the lean-to's fronts, the cottage's and the timber house's and stone cottage's
 for p:[3][2]int.[[2]int.[hw.HW_HUT,hw.HW_LEANTO],[2]int.[hw.HW_COTTAGE,hw.HW_TIMBER],[2]int.[hw.HW_COTTAGE,hw.HW_STONE]] {
  a:=exp_showcase(p[0],1);b:=exp_showcase(p[1],1);#assert abs((b.z-hw.HW_REACH[p[1]][1])-(a.z+hw.HW_REACH[p[0]][1])-EXP_SHOWCASE_WALK)<0.01;}
 // the timber house's last house and the stone cottage's first stand 3 m apart, and nothing crosses
 // the gap between the second and third yards
 #assert exp_showcase(hw.HW_TIMBER,5).x+2.8+3<=exp_showcase(hw.HW_STONE,1).x-3.75+0.01;
 // 6 m of open ground behind the lean-to before the cottage's backs
 #assert exp_showcase(hw.HW_COTTAGE,1).z-hw.HW_REACH[hw.HW_COTTAGE][2]-(exp_showcase(hw.HW_LEANTO,1).z+hw.HW_REACH[hw.HW_LEANTO][2])>=6;
}
exp_site_group :: (i:int)->int {if i>=EXP_SHOWCASE_SITE && i<EXP_SHOWCASE_SITE+EXP_SHOWCASE_SITES {return -4;}if i==EXP_HOME_SITE {return -3;}if i==18 {return -2;}if i==27 {return 0;}if i>=19 {return 1;}if i>=9 {return -1;}if i<4 {return i;}if i==4 || i==7 || i==8 {return 3;}if i==5 {return 0;}return 1;}
exp_max :: (a:f32,b:f32)->f32 {return ifx a>b then a else b;}
exp_distance :: (s:ExpSite,x:f32,z:f32)->f32 {
 dx:=exp_max(s.x-s.left-x,x-s.x-s.right);dz:=exp_max(s.z-s.back-z,z-s.z-s.front);return exp_max(dx,dz);
}
exp_castle_distance :: (x:f32,z:f32)->f32 {return exp_distance(ExpSite.{x=46,z= -47,left=32.5,right=32.5,back=31.5,front=31},x,z);}
exp_clear :: (x:f32,z:f32)->bool {for i:0..<EXP_SITES {if exp_distance(exp_site(i),x,z)<1.0 {return true;}}return false;}
exp_height :: (x:f32,z:f32)->f32 {
 h:=glade.cg_height(x,z);
 for i:0..<EXP_SITES {s:=exp_site(i);d:=exp_distance(s,x,z);if d<4 {t:=ifx d<=0 then 0.0f32 else d/4;t=t*t*(3-2*t);h=glade.cg_height(s.x,s.z)*(1-t)+h*t;}}
 d:=exp_castle_distance(x,z);if d<4 {t:=ifx d<=0 then 0.0f32 else d/4;t=t*t*(3-2*t);h=glade.cg_height(18,-20)*(1-t)+h*t;}
 return h;
}
#test "castle grounds and walls share one level foundation" {
 base:=exp_height(18,-20);for p:[6][2]f32.[[2]f32.[21,-20],[2]f32.[47,-20],[2]f32.[18,-35],[2]f32.[50,-35],[2]f32.[74,-52],[2]f32.[34,-74]] {#assert abs(exp_height(p[0],p[1])-base)<0.001;}
}
