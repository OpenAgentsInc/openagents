  10, -215,   16, -160,   20, -122,   -92, -96,   46, -50,   25, -25,   -15, -88,   -8, -74,
  -8, -50,   -5, -25,   0, 26,   -40, 10,   -30, 48,   -25, 78,   -47, 125,   -5, 172,
