// G5's existing spec, resolved to a bounded Metal SDK effect plan in Coax.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/json/json.coax";
#load "metal-plan.coax";

MtResource :: struct {name:string;path:[4096]u8;file:string;kind:int;format:int;w:int;h:int;layers:int=1;levels:int=1;bytes:int;linear:bool;repeat:bool;mip:bool;compare:bool;atlas:bool;bits:[64]u32;nf:int;}
MtBinding :: struct {name:string;kind:int;slot:int;shape:int;stride:int;stages:int;}
MtAttribute :: struct {location:int;scalar:int;lanes:int;offset:int;stride:int;}
MtModule :: struct {name:[256]u8;name_n:int;path:[4096]u8;source:string;text:[65536]u8;vertex:string;fragment:string;binds:[192]MtBinding;nb:int;attrs:[32]MtAttribute;na:int;}
MtOp :: struct {kind:int;line:string;end:int;depth:int=-1;module_index:int=-1;colors:[8]int;nc:int;}
MtState :: struct {ok:bool=true;w:int;h:int;resources:[128]MtResource;nr:int;modules:[16]MtModule;nm:int;ops:[256]MtOp;no:int;lets:[32]string;values:[32]int;nl:int;index:string;indices:int;draws:[1048576]u8;draw_bytes:int;ndraws:int;}
#test "Metal spec tokens retain aliases, empty fields and whitespace" {
  #assert mt_word("  a\tb  c\r",1)=="b"&&mt_word("a",1)=="";
  #assert mt_part("draws:2:$all",2,':')=="$all"&&mt_part("a,,b",1,',')=="";
  #assert mt_line("a\nb\n",1)=="b"&&mt_lines("a\nb\n")==2&&mt_lines("a")==1;
}
mt_word :: (s:string,k:int)->string {at:=0;n:=0;while at<s.count{while at<s.count&&(s[at]==' '||s[at]=='\t'||s[at]=='\r'){at+=1;}e:=at;while e<s.count&&s[e]!=' '&&s[e]!='\t'&&s[e]!='\r'{e+=1;}if e>at{if n==k{return s[at..<e];}n+=1;}at=e;}return "";}
mt_part :: (s:string,k:int,sep:u8)->string {at:=0;n:=0;while at<=s.count{e:=at;while e<s.count&&s[e]!=sep{e+=1;}if n==k{return s[at..<e];}n+=1;at=e+1;}return "";}
mt_lines :: (s:string)->int {n:=0;for c:s{if c=='\n'{n+=1;}}return n+(ifx s.count>0&&s[s.count-1]!='\n' then 1 else 0);}
mt_line :: (s:string,k:int)->string {return mt_part(s,k,'\n');}
mt_number :: (n:int,b:[]u8)->string {o:[1]Jo;jo_start(o[..],b);jo_int(o[..],n);return jo_text(o[..]);}
mt_fail :: (m:[]MtState,message:string)->bool {tool_errln(message);m[0].ok=false;return false;}
mt_find :: (m:[]MtState,name:string)->int {for i:0..<m[0].nr{if m[0].resources[i].name==name{return i;}}return -1;}
mt_resource :: (m:[]MtState,name:string,kind:int)->int {
  if name==""||m[0].nr==128||mt_find(m,name)>=0 {bad:=mt_fail(m,"duplicate/empty resource or capacity exceeded");return -1;}
  i:=m[0].nr;m[0].nr+=1;m[0].resources[i].name=name;m[0].resources[i].kind=kind;return i;
}
mt_count :: (m:[]MtState,text:string,each:int)->int {
  if text=="each" {return each;}if text.count>1&&text[0]=='$'{for i:0..<m[0].nl{if m[0].lets[i]==text[1..<text.count]{return m[0].values[i];}}return -1;}
  return args_whole(text);
}
mt_append :: (a:string,b:string,out:[]u8)->string {if a.count+b.count>out.count{return "";}for c,i:a{out[i]=c;}for c,i:b{out[a.count+i]=c;}return cast(string)out[0..<a.count+b.count];}
mt_module :: (m:[]MtState,shader_dir:string,spv:string)->int {
  for i:0..<m[0].nm{if cast(string)m[0].modules[i].name[0..<m[0].modules[i].name_n]==spv{return i;}}
  if m[0].nm==16||spv.count<5||spv.count>256{return -1;}i:=m[0].nm;m[0].nm+=1;
  for c,k:spv{m[0].modules[i].name[k]=c;}m[0].modules[i].name_n=spv.count;
  temp:[4096]u8;filename:=mt_append(spv[0..<spv.count-4],".metal",temp[..]);mod:=m[0].modules[i..<i+1];mod[0].source=fs_join(shader_dir,filename,mod[0].path[..]);
  meta_path:[4096]u8;meta:=mt_append(mod[0].source,".bindings",meta_path[..]);n:=fs_read(meta,mod[0].text[..]);if n<0{return -1;}text:=cast(string)mod[0].text[0..<n];
  if mt_line(text,0)!="metal-reflection 1"||mt_line(text,1)!="lengths-buffer 29"||mt_line(text,2)!="vertex-buffer 30"{return -1;}
  for k:3..<mt_lines(text){line:=mt_line(text,k);cmd:=mt_word(line,0);
    if cmd=="entry"{if mt_word(line,1)=="vertex"{mod[0].vertex=mt_word(line,2);}else if mt_word(line,1)=="fragment"{mod[0].fragment=mt_word(line,2);}else{return -1;}}
    else if cmd=="resource"{
      if mod[0].nb==192{return -1;}b:=mod[0].binds[mod[0].nb..<mod[0].nb+1];mod[0].nb+=1;
      b[0].kind=ifx mt_word(line,1)=="buffer" then 1 else ifx mt_word(line,1)=="texture" then 2 else ifx mt_word(line,1)=="sampler" then 3 else 0;
      b[0].slot=args_whole(mt_word(line,2));b[0].shape=args_whole(mt_word(line,3));b[0].stride=args_whole(mt_word(line,4));b[0].stages=args_whole(mt_word(line,5));b[0].name=mt_word(line,6);
      if !mp_slot(b[0].kind,b[0].slot)||b[0].name==""{return -1;}
    }else if cmd=="attribute"{
      if mod[0].na==32{return -1;}a:=mod[0].attrs[mod[0].na..<mod[0].na+1];mod[0].na+=1;
      a[0]=MtAttribute.{location=args_whole(mt_word(line,2)),scalar=args_whole(mt_word(line,3)),lanes=args_whole(mt_word(line,4)),offset=args_whole(mt_word(line,5)),stride=args_whole(mt_word(line,6))};
      if a[0].location<0||a[0].location>=31||a[0].scalar<2||a[0].scalar>4||a[0].lanes<1||a[0].lanes>4||a[0].offset<0||a[0].stride<a[0].offset+a[0].lanes*4{return -1;}
    }else if cmd!=""{return -1;}
  }
  return ifx mod[0].vertex!=""&&mod[0].fragment!="" then i else -1;
}
mt_parse :: (m:[]MtState,text:string,root:string,shaders:string)->bool {
  open_each:=-1;outputs:=[8]string.["_out0","_out1","_out2","_out3","_out4","_out5","_out6","_out7"];
  for line_at:0..<mt_lines(text){line:=mt_line(text,line_at);cmd:=mt_word(line,0);name:=mt_word(line,1);a:=mt_word(line,2);b:=mt_word(line,3);
    if cmd==""||cmd=="wgsl"||cmd[0]=='#'{continue;}
    if cmd=="size"{m[0].w=args_whole(name);m[0].h=args_whole(a);if !mp_size(m[0].w,m[0].h){return false;}continue;}
    if cmd=="let"{if m[0].nl==32{return false;}i:=m[0].nl;m[0].nl+=1;m[0].lets[i]=name;m[0].values[i]=args_whole(a);continue;}
    if cmd=="draws"{path:[4096]u8;n:=fs_read(fs_join(root,name,path[..]),m[0].draws[..]);if n<0{return false;}m[0].draw_bytes=n;m[0].ndraws=mt_count(m,a,0);if m[0].ndraws<0||m[0].ndraws>n/16{return false;}continue;}
    if cmd=="index"{path:[4096]u8;bytes:=fs_size(fs_join(root,name,path[..]));if bytes<0||bytes%4!=0||bytes>67108864{return false;}
      // The caller's root and source text remain live through serialization.
      m[0].index=name;m[0].indices=bytes/4;continue;}
    if cmd=="buffer"||cmd=="floats"||cmd=="layers"||cmd=="atlas"||cmd=="sampler"||cmd=="target"||cmd=="depth"{
      kind:=ifx cmd=="sampler" then 3 else ifx cmd=="buffer"||cmd=="floats" then 1 else 2;i:=mt_resource(m,name,kind);if i<0{return false;}r:=m[0].resources[i..<i+1];
      if cmd=="buffer"||cmd=="layers"||cmd=="atlas"{r[0].file=fs_join(root,a,r[0].path[..]);r[0].bytes=fs_size(r[0].file);if r[0].bytes<0||r[0].bytes>67108864{return false;}}
      if cmd=="buffer"{if !mp_buffer(r[0].bytes,4){return false;}}
      if cmd=="floats"{for k:2..<66{t:=mt_word(line,k);if t==""{break;}n:=args_number(t);if !n.ok{return false;}r[0].bits[r[0].nf]=f32_bits(cast(f32)n.value);r[0].nf+=1;}r[0].bytes=r[0].nf*4;}
      if cmd=="sampler"{
        r[0].linear=a=="linear";r[0].repeat=b=="repeat";r[0].mip=mt_word(line,4)=="mip";r[0].compare=mt_word(line,5)=="less";
        if (a!="linear"&&a!="nearest")||(b!="repeat"&&b!="clamp")||(mt_word(line,4)!="mip"&&mt_word(line,4)!="flat")||(mt_word(line,5)!="none"&&mt_word(line,5)!="less"){return false;}
      }
      if cmd=="layers"||cmd=="atlas"{
        r[0].w=args_whole(b);r[0].h=args_whole(mt_word(line,4));r[0].atlas=cmd=="atlas";
        r[0].layers=ifx r[0].atlas then 1 else args_whole(mt_word(line,5));r[0].levels=args_whole(mt_word(line,ifx r[0].atlas then 5 else 6));
        r[0].format=ifx r[0].atlas then 4 else 3;texels:=mp_texels(r[0].w,r[0].h,r[0].layers,r[0].levels);
        if texels<0||r[0].bytes!=texels*(ifx r[0].atlas then 1 else 4){return false;}
      }
      if cmd=="target"||cmd=="depth"{
        r[0].format=ifx cmd=="target" then 1 else 2;r[0].w=m[0].w;r[0].h=m[0].h;
        if a.count>1&&a[0]=='/'{divisor:=args_whole(a[1..<a.count]);if divisor<1{return false;}r[0].w=(r[0].w+divisor-1)/divisor;r[0].h=(r[0].h+divisor-1)/divisor;}
        else if a!=""&&a!="frame"{r[0].w=args_whole(a);r[0].h=args_whole(b);}if !mp_size(r[0].w,r[0].h){return false;}
      }continue;
    }
    if m[0].no==256{return false;}op:=m[0].ops[m[0].no..<m[0].no+1];op[0].line=line;
    if cmd=="copy"{x:=mt_find(m,name);y:=mt_find(m,a);if x<0||y<0{return false;}ra:=m[0].resources[x];rb:=m[0].resources[y];if !mp_copy(ra.w,ra.h,ra.format,rb.w,rb.h,rb.format){return false;}op[0].kind=2;}
    else if cmd=="each"{if open_each>=0||mt_part(name,0,':')!="draws"{return false;}open_each=m[0].no;op[0].kind=3;}
    else if cmd=="end"{if open_each<0{return false;}op[0].kind=4;op[0].end=open_each;m[0].ops[open_each].end=m[0].no;open_each=-1;}
    else if cmd=="pass"{
      op[0].kind=1;op[0].module_index=mt_module(m,shaders,name);if op[0].module_index<0{return false;}
      targets:=mt_word(line,4);count:=args_whole(targets);
      if count>=0 {if count>8{return false;}for k:0..<count{idx:=mt_find(m,outputs[k]);if idx<0{idx=mt_resource(m,outputs[k],2);if idx<0{return false;}r:=m[0].resources[idx..<idx+1];r[0].w=m[0].w;r[0].h=m[0].h;r[0].format=1;}op[0].colors[k]=idx;}op[0].nc=count;}
      else{for k:0..<8{t:=mt_part(targets,k,',');if t==""{break;}idx:=mt_find(m,t);if idx<0||m[0].resources[idx].format!=1{return false;}op[0].colors[k]=idx;op[0].nc+=1;}}
      depth:=mt_word(line,5);if depth=="own"{idx:=mt_resource(m,line,2);if idx<0{return false;}r:=m[0].resources[idx..<idx+1];r[0].w=m[0].w;r[0].h=m[0].h;r[0].format=2;op[0].depth=idx;}
      else if depth!="-"{op[0].depth=mt_find(m,depth);if op[0].depth<0||m[0].resources[op[0].depth].format!=2{return false;}}
      if op[0].nc==0&&op[0].depth<0{return false;}
      first:=ifx op[0].nc>0 then op[0].colors[0] else op[0].depth;r:=m[0].resources[first];
      for k:0..<op[0].nc{t:=m[0].resources[op[0].colors[k]];if t.w!=r.w||t.h!=r.h{return false;}}
      if op[0].depth>=0{t:=m[0].resources[op[0].depth];if t.w!=r.w||t.h!=r.h{return false;}}
    }else{return false;}m[0].no+=1;
  }return open_each<0&&mp_size(m[0].w,m[0].h)&&m[0].no>0;
}
mt_i :: (o:[]Jo,key:string,n:int){jo_key(o,key);jo_int(o,n);}
mt_s :: (o:[]Jo,key:string,s:string){jo_key(o,key);jo_str(o,s);}
mt_b :: (o:[]Jo,key:string,b:bool){jo_key(o,key);jo_bool(o,b);}
mt_alias :: (line:string,name:string)->string {
  for i:9..<64{t:=mt_word(line,i);if t==""{break;}if t.count>5&&t[0..<5]=="bind="&&mt_part(t[5..<t.count],0,':')==name{return mt_part(t[5..<t.count],1,':');}}return name;
}
mt_write_resources :: (m:[]MtState,o:[]Jo){
  jo_key(o,"resources");jo_arr(o);for i:0..<m[0].nr{r:=m[0].resources[i];jo_obj(o);mt_i(o,"id",i);mt_s(o,"name",r.name);mt_i(o,"kind",r.kind);mt_s(o,"file",r.file);mt_i(o,"bytes",r.bytes);
    mt_i(o,"format",r.format);mt_i(o,"width",r.w);mt_i(o,"height",r.h);mt_i(o,"layers",r.layers);mt_i(o,"levels",r.levels);
    mt_b(o,"linear",r.linear);mt_b(o,"repeat",r.repeat);mt_b(o,"mip",r.mip);mt_b(o,"compare",r.compare);mt_b(o,"atlas",r.atlas);
    jo_key(o,"bits");jo_arr(o);for k:0..<r.nf{jo_int(o,cast(int)r.bits[k]);}jo_end(o);jo_end(o);
  }jo_end(o);
}
mt_write_modules :: (m:[]MtState,o:[]Jo){
  jo_key(o,"modules");jo_arr(o);for i:0..<m[0].nm{mod:=m[0].modules[i];jo_obj(o);mt_s(o,"file",mod.source);mt_s(o,"vertex",mod.vertex);mt_s(o,"fragment",mod.fragment);
    jo_key(o,"attributes");jo_arr(o);for k:0..<mod.na{a:=mod.attrs[k];jo_arr(o);for n:[5]int.[a.location,a.scalar,a.lanes,a.offset,a.stride]{jo_int(o,n);}jo_end(o);}jo_end(o);jo_end(o);
  }jo_end(o);
}
mt_write_draw :: (o:[]Jo,d:MpDraw){jo_arr(o);jo_bool(o,d.indexed);jo_int(o,d.first);jo_int(o,d.count);jo_int(o,d.base);jo_int(o,d.instances);jo_end(o);}
mt_write_pass :: (m:[]MtState,o:[]Jo,op:MtOp,each:int)->bool {
  line:=op.line;mod:=m[0].modules[op.module_index];blend:=0;alpha:=-1;masked:=0;keep:=false;write_depth:=op.depth>=0;always:=false;vertex:=-1;
  for i:9..<64{t:=mt_word(line,i);if t==""{break;}
    if t=="keep"{keep=true;}else if t=="nowrite"{write_depth=false;}else if t=="always"{always=true;}
    else if t.count>6&&t[0..<6]=="blend="{blend=mp_mode(t[6..<t.count]);if blend<0{return false;}}
    else if t.count>6&&t[0..<6]=="alpha="{alpha=mp_mode(t[6..<t.count]);if alpha<0{return false;}}
    else if t.count>5&&t[0..<5]=="mask="{n:=args_whole(t[5..<t.count]);if n<0||n>=8{return false;}masked|=1<<n;}
    else if t.count>5&&t[0..<5]=="bind="{continue;}
    else if t.count>9&&t[0..<9]=="vertices="{spec:=t[9..<t.count];vertex=mt_find(m,mt_part(spec,0,':'));floats:=args_whole(mt_part(spec,1,':'));if vertex<0||m[0].resources[vertex].kind!=1||floats<1||floats>32{return false;}
      for k:0..<mod.na{if mod.attrs[k].stride!=floats*4{return false;}}
    }else{return false;}
  }
  if mod.na>0&&vertex<0{return false;}if alpha<0{alpha=ifx blend==2 then 4 else 1;}
  bias:=args_number(mt_word(line,6));slope:=args_number(mt_word(line,7));if !bias.ok||!slope.ok{return false;}
  jo_obj(o);mt_s(o,"op","pass");mt_i(o,"module",op.module_index);mt_i(o,"depth",op.depth);mt_i(o,"vertexBuffer",vertex);
  mt_i(o,"biasBits",cast(int)f32_bits(cast(f32)bias.value));mt_i(o,"slopeBits",cast(int)f32_bits(cast(f32)slope.value));
  mt_b(o,"keep",keep);mt_b(o,"depthWrite",write_depth);mt_b(o,"depthAlways",always);
  jo_key(o,"colors");jo_arr(o);for i:0..<op.nc{jo_int(o,op.colors[i]);}jo_end(o);
  jo_key(o,"blend");jo_arr(o);for n:[7]int.[blend,mp_blend_factor(blend,false),mp_blend_factor(blend,true),alpha,mp_blend_factor(alpha,false),mp_blend_factor(alpha,true),masked]{jo_int(o,n);}jo_end(o);
  jo_key(o,"bindings");jo_arr(o);lengths:[29]int;
  for i:0..<mod.nb{b:=mod.binds[i];idx:=mt_find(m,mt_alias(line,b.name));if idx<0{return mt_fail(m,"shader binding has no resource in the G5 spec");}r:=m[0].resources[idx];
    if b.kind!=r.kind{return false;}
    if b.kind==1{if !mp_buffer(r.bytes,b.stride){return false;}capacity:=ifx r.bytes<16 then 16 else r.bytes;lengths[b.slot]=capacity/b.stride;}
    if b.kind==2&&((b.shape==2&&r.format!=2)||(b.shape==1&&r.format!=3)||(b.shape==0&&r.format!=1&&r.format!=4)){return false;}
    if b.kind==3&&r.compare!=(b.shape==1){return false;}
    jo_arr(o);jo_int(o,b.kind);jo_int(o,b.slot);jo_int(o,idx);jo_end(o);
  }jo_end(o);jo_key(o,"lengths");jo_arr(o);for n:lengths{jo_int(o,n);}jo_end(o);
  calls:=mt_word(line,8);jo_key(o,"draws");jo_arr(o);
  if calls.count>=5&&calls[0..<5]=="draws"{
    from:=0;to:=m[0].ndraws;
    if calls=="draws:each"{from=each;to=each+1;}
    else if calls!="draws"{from=mt_count(m,mt_part(calls,1,':'),each);to=mt_count(m,mt_part(calls,2,':'),each);}
    if from<0||to<from||to>m[0].ndraws{return false;}
    for i:from..<to{d:=mp_draw(m[0].draws[0..<m[0].draw_bytes],i,m[0].indices);if !d.ok{return false;}if d.count>0&&d.instances>0{mt_write_draw(o,d);}}
  }else{count:=mt_count(m,mt_part(calls,0,':'),each);inst:=mt_part(calls,1,':');instances:=ifx inst=="" then 1 else mt_count(m,inst,each);
    if count<0||count>1048576||instances<0||instances>262144{return false;}if count>0&&instances>0{mt_write_draw(o,MpDraw.{ok=true,count=count,instances=instances});}
  }jo_end(o);jo_end(o);return !o[0].bad;
}
mt_write_op :: (m:[]MtState,o:[]Jo,idx:int,each:int)->bool {
  op:=m[0].ops[idx];if op.kind==1{return mt_write_pass(m,o,op,each);}if op.kind!=2{return false;}
  jo_obj(o);mt_s(o,"op","copy");mt_i(o,"from",mt_find(m,mt_word(op.line,1)));mt_i(o,"to",mt_find(m,mt_word(op.line,2)));jo_end(o);return !o[0].bad;
}
mt_json :: (m:[]MtState,root:string,out:[]u8)->int {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);mt_s(o[..],"schema","coax.metal-g5.v1");mt_i(o[..],"width",m[0].w);mt_i(o[..],"height",m[0].h);
  p:[4096]u8;mt_s(o[..],"index",ifx m[0].index=="" then "" else fs_join(root,m[0].index,p[..]));mt_write_resources(m,o[..]);mt_write_modules(m,o[..]);
  jo_key(o[..],"commands");jo_arr(o[..]);i:=0;count:=0;last:=-1;
  while i<m[0].no {op:=m[0].ops[i];
    if op.kind==3{range:=mt_word(op.line,1);from:=mt_count(m,mt_part(range,1,':'),0);to:=mt_count(m,mt_part(range,2,':'),0);
      if from<0||to<from||to>m[0].ndraws{return -1;}
      for row:from..<to{for k:i+1..<op.end{if !mt_write_op(m,o[..],k,row){return -1;}count+=1;if m[0].ops[k].kind==1{last=k;}}}i=op.end+1;
    }else{if !mt_write_op(m,o[..],i,0){return -1;}count+=1;if op.kind==1{last=i;}i+=1;}
    if count>8192{return -1;}
  }jo_end(o[..]);if last<0||m[0].ops[last].nc<1{return -1;}
  jo_key(o[..],"outputs");jo_arr(o[..]);for k:0..<m[0].ops[last].nc{jo_int(o[..],m[0].ops[last].colors[k]);}jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
tool_main :: ()->int #export_c {
  args:[1]Args;if !args_load(args[..])||args_count(args[..])!=4{tool_errln("usage: metal-pass.coax ABS_SPEC_DIR SPEC_NAME ABS_SHADER_DIR OUTPUT.json");return 2;}
  root:=args_at(args[..],0);shaders:=args_at(args[..],2);source:[65536]u8;p:[4096]u8;n:=fs_read(fs_join(root,args_at(args[..],1),p[..]),source[..]);if n<0{return 1;}
  state:[1]MtState;if !mt_parse(state[..],cast(string)source[0..<n],root,shaders){tool_errln("Metal plan refused the spec, files or reflection.");return 1;}
  output:[8388608]u8;k:=mt_json(state[..],root,output[..]);if k<0||!fs_write(args_at(args[..],3),cast(string)output[0..<k]){tool_errln("Metal plan refused pass bindings/draws or exceeded its output capacity.");return 1;}
  print("Metal SDK plan: % commands, % resources, % modules\n",state[0].no,state[0].nr,state[0].nm);return 0;
}
