// One shader pass, ported to Coax, against the browser (docs/verse/native-gpu.md,
// G5): the WGSL pass drawn by headless Chrome's WebGPU (verse/gpu/golden,
// served by coax/web/serve.sh for a secure origin) and the Coax pass, lowered
// by `coax spirv`, drawn on HOST's GPU by verse/gpu/vk-pass.c, from the same
// uniform bytes, into rgba16float targets. It prints how far apart they are
// and fails past the tolerance: an f16's rounding (|a-b| <= 2e-3 * max(1,|a|)).
//   coax/web/tool.sh verse/gpu/pass-check.coax HOST WGSL VS FS PASS.spv UNIFORMS.bin
//       [--size WxH] [--targets N] [--vertices K] [--keep DIR] [--against FILE] [--allow N]
// --allow N passes with up to N values past the tolerance (pixels on an edge
// whose test lands within the two sides' float rounding).
// --against compares the browser with FILE (float32 RGBA rows, as --keep
// writes them, e.g. the pass run on the CPU) instead of drawing on HOST.
// --keep writes golden.f32 and native.f32 (float32 RGBA rows, target after target).
#import "Basic";
#load "../../coax/lib/net/cdp.coax";

PC_PORT :: "18731";
PC_FILE :: 4194304;
PC_FLOATS :: 33554432;
PC_TOL :: 0.002;

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 6 {
    tool_errln("usage: pass-check HOST WGSL VS FS PASS.spv UNIFORMS.bin [--size WxH] [--targets N] [--vertices K] [--keep DIR] [--against FILE] [--allow N]");
    return 2;
  }
  host := args_at(a[..], 0); wgsl_path := args_at(a[..], 1); vs := args_at(a[..], 2); fs_ := args_at(a[..], 3);
  spv := args_at(a[..], 4); upath := args_at(a[..], 5);
  wh := args_size(args_value(a[..], "--size", "320x180"));
  nt := args_whole(args_value(a[..], "--targets", "1"));
  nv := args_whole(args_value(a[..], "--vertices", "3"));
  keep := args_value(a[..], "--keep", "");
  allow := args_whole(args_value(a[..], "--allow", "0"));
  if !wh.ok || nt < 1 || nt > 8 || nv < 1 { tool_errln("pass-check: --size WxH, --targets 1 to 8, --vertices at least 1"); return 2; }
  floats := wh.w * wh.h * 4 * nt;

  // the golden: the WGSL in the browser
  golden: [PC_FLOATS] f32;
  if !browser(a[..], wgsl_path, vs, fs_, upath, wh, nt, nv, golden[0..<floats]) { return 1; }
  // the port: the Coax pass on the GPU host
  native: [PC_FLOATS] f32;
  against := args_value(a[..], "--against", "");
  if against.count > 0 {
    if !read_f32(against, native[0..<floats]) { return 1; }
  } else if !gpu(host, spv, upath, wh, nt, nv, native[0..<floats]) { return 1; }
  if keep.count > 0 {
    b: [1024] u8; bytes: [PC_FLOATS * 4] u8;
    ok := fs_write(fs_join(keep, "golden.f32", b[..]), f32_bytes(golden[0..<floats], bytes[..]));
    ok = ok && fs_write(fs_join(keep, "native.f32", b[..]), f32_bytes(native[0..<floats], bytes[..]));
    if !ok { tool_errln("pass-check: could not write to --keep"); }
  }
  return compare(golden[0..<floats], native[0..<floats], wh.w, wh.h, nt, allow);
}

// Floats as little-endian bytes, in out.
f32_bytes :: (f: [] f32, out: [] u8) -> string {
  for i: 0..<f.count {
    b := f32_bits(f[i]);
    for k: 0..<4 { out[i * 4 + k] = cast,trunc(u8) (b >> cast(u32) (k * 8)); }
  }
  return cast(string) out[0..<f.count * 4];
}
put_int :: (o: [] Jo, v: int) {
  d: [24] u8; n := 0; x := v;
  if x == 0 { jo_put(o, "0"); return; }
  while x > 0 { d[n] = cast,trunc(u8) (48 + x % 10); x /= 10; n += 1; }
  for i: 0..<n { jo_byte(o, d[n - 1 - i]); }
}

// Within an f16's rounding of the golden.
pc_close :: (g: f32, n: f32) -> bool {
  m := abs(g); if m < 1 { m = 1; }
  d := abs(g - n);
  return d <= PC_TOL * m;
}
#test "an f16's rounding is close, more is not" {
  #assert pc_close(1, 1.0019) && !pc_close(1, 1.0021) && pc_close(100, 100.19) && !pc_close(100, 100.3) && pc_close(0, 0.0019) && !pc_close(0, 0.003);
}
compare :: (g: [] f32, n: [] f32, w: int, h: int, nt: int, allow: int) -> int {
  bad := 0; worst: f32 = 0; at := -1; nan := 0;
  for i: 0..<g.count {
    if g[i] != g[i] || n[i] != n[i] { if !(g[i] != g[i] && n[i] != n[i]) { nan += 1; } continue; }
    d := abs(g[i] - n[i]);
    if d > worst { worst = d; at = i; }
    if !pc_close(g[i], n[i]) { bad += 1; }
  }
  print("pass-check: % values (% targets of %x%), % past the tolerance, % NaN on one side only; largest difference %", g.count, nt, w, h, bad, nan, worst);
  if at >= 0 {
    px := at / 4;
    print(" at target %, (%, %) channel %: golden % native %", px / (w * h), px % (w * h) % w, px % (w * h) / w, at % 4, g[at], n[at]);
  }
  print("\n");
  if bad > allow { print("pass-check: more than the % allowed\n", allow); }
  return ifx bad <= allow && nan == 0 then 0 else 1;
}

// ---- the browser
browser :: (a: [] Args, wgsl_path: string, vs: string, fs_: string, upath: string, wh: ArgsSize, nt: int, nv: int, out: [] f32) -> bool {
  wgsl: [PC_FILE] u8; ub: [PC_FILE] u8;
  wn := fs_read(wgsl_path, wgsl[..]); un := fs_read(upath, ub[..]);
  if wn < 0 || un < 0 { tool_errln("pass-check: cannot read the WGSL or the uniforms"); return false; }
  b64: [PC_FILE] u8;
  bn := b64_encode(cast(string) ub[0..<un], b64[..]);
  // the page, on a local origin (WebGPU needs a secure context)
  server := proc_new();
  ok := proc_arg(server, "coax/web/serve.sh") && proc_arg(server, "verse/gpu/golden") && proc_arg(server, "--listen") && proc_arg(server, "127.0.0.1:18731") && proc_quiet(server);
  if !ok || proc_start(server) != 0 { tool_errln("pass-check: could not start coax/web/serve.sh (run from the repo root)"); return false; }
  defer { k := proc_kill(server, PROC_SIGKILL); r := proc_wait(server, 2000); d := proc_release(server); }
  proc_sleep(1500);
  c: [1] Cdp;
  if !cdp_launch(c[..], 800, 600, "coax-pass-") { tool_err("pass-check: "); tool_errln(cdp_error(c[..])); return false; }
  defer cdp_close(c[..]);
  if cdp_call(c[..], "Page.navigate", "{\"url\":\"http://127.0.0.1:18731/\"}", CDP_CALL_MS) < 0 { tool_errln(cdp_error(c[..])); return false; }
  proc_sleep(1500);
  // runPass({...}) with the WGSL as a JSON string
  expr: [CDP_REQ] u8; o: [1] Jo; jo_start(o[..], expr[..]);
  jo_put(o[..], "runPass(");
  jo_obj(o[..]);
  jo_key(o[..], "wgsl"); jo_str(o[..], cast(string) wgsl[0..<wn]);
  jo_key(o[..], "vs"); jo_str(o[..], vs); jo_key(o[..], "fs"); jo_str(o[..], fs_);
  jo_key(o[..], "uniforms"); jo_str(o[..], cast(string) b64[0..<bn]);
  jo_key(o[..], "width"); jo_int(o[..], wh.w); jo_key(o[..], "height"); jo_int(o[..], wh.h); jo_key(o[..], "vertices"); jo_int(o[..], nv);
  jo_key(o[..], "targets"); jo_arr(o[..]); for i: 0..<nt { jo_str(o[..], "rgba16float"); } jo_end(o[..]);
  jo_end(o[..]);
  jo_put(o[..], ")");
  if o[0].bad { tool_errln("pass-check: the WGSL is too long for one command"); return false; }
  v := cdp_evaluate(c[..], jo_text(o[..]));
  if v < 0 { tool_errln(cdp_error(c[..])); return false; }
  d := cdp_doc(c[..]);
  if !jv_bool(d, jv_get(d, v, "ok")) {
    msg: [65536] u8; m := jv_str(d, jv_get(d, v, "error"), msg[..]);
    tool_err("pass-check: the browser's pass failed: "); tool_errln(ifx m >= 0 then cast(string) msg[0..<m] else "?");
    return false;
  }
  ts := jv_get(d, v, "targets");
  per := wh.w * wh.h * 4;
  raw: [PC_FILE * 2] u8;
  for i: 0..<nt {
    n := b64_decode(jv_raw(d, jv_at(d, ts, i)), raw[..]);
    if n != per * 4 { tool_errln("pass-check: the browser returned a target of the wrong size"); return false; }
    for k: 0..<per { out[i * per + k] = f32_from_bits(le32(raw[..], k * 4)); }
  }
  print("pass-check: the browser drew %x%\n", wh.w, wh.h);
  return true;
}
read_f32 :: (path: string, out: [] f32) -> bool {
  raw: [PC_FLOATS * 4] u8;
  n := fs_read(path, raw[..]);
  if n != out.count * 4 { tool_err("pass-check: not the pass's size: "); tool_errln(path); return false; }
  for i: 0..<out.count { out[i] = f32_from_bits(le32(raw[..], i * 4)); }
  return true;
}
le32 :: (b: [] u8, at: int) -> u32 {
  return cast(u32) b[at] | (cast(u32) b[at + 1] << 8) | (cast(u32) b[at + 2] << 16) | (cast(u32) b[at + 3] << 24);
}

// ---- the GPU host
gpu :: (host: string, spv: string, upath: string, wh: ArgsSize, nt: int, nv: int, out: [] f32) -> bool {
  tmp: [1024] u8;
  work := fs_temp("pass-check-", tmp[..]);
  if work.count == 0 { tool_errln("pass-check: no temporary directory"); return false; }
  defer { r := fs_remove(work); }
  buf: [PC_FILE] u8; p: [1024] u8;
  files := [7] string.["verse/gpu/vk-pass.c", "verse/gpu/vks.c", "verse/gpu/vks.h", "verse/gpu/vkc.c", "verse/gpu/vkc.h", "", ""];
  for f: files {
    if f.count == 0 { continue; }
    n := fs_read(f, buf[..]);
    if n < 0 || !fs_write(fs_join(work, fs_base(f), p[..]), cast(string) buf[0..<n]) { tool_err("pass-check: cannot copy "); tool_errln(f); return false; }
  }
  n := fs_read(spv, buf[..]);
  if n < 0 || !fs_write(fs_join(work, "pass.spv", p[..]), cast(string) buf[0..<n]) { tool_errln("pass-check: cannot copy the SPIR-V"); return false; }
  n = fs_read(upath, buf[..]);
  if n < 0 || !fs_write(fs_join(work, "u.bin", p[..]), cast(string) buf[0..<n]) { tool_errln("pass-check: cannot copy the uniforms"); return false; }
  // built and run there, under the validation layers; the floats come back on stdout
  script: [8192] u8; s: [1] Jo; jo_start(s[..], script[..]);
  jo_put(s[..], "cd '"); jo_put(s[..], work); jo_put(s[..], "' && COPYFILE_DISABLE=1 tar --no-xattrs -cf - . | ssh -o BatchMode=yes ");
  jo_put(s[..], host);
  jo_put(s[..], " 'set -e; d=$(mktemp -d); trap \"rm -rf $d\" EXIT; tar -x -C $d 2>/dev/null; cd $d; export VK_DRIVER_FILES=${VK_DRIVER_FILES:-/run/opengl-driver/share/vulkan/icd.d/nvidia_icd.json}; ");
  jo_put(s[..], "nix-shell -p gcc vulkan-headers vulkan-loader vulkan-validation-layers --run \"set -e; gcc -std=c11 -O2 -I. vk-pass.c vks.c vkc.c -lvulkan -lm -o vk-pass; ");
  jo_put(s[..], "export VK_ADD_LAYER_PATH=\\$(dirname \\$(find /nix/store -maxdepth 6 -name VkLayer_khronos_validation.json -path \\\"*validation-layers*\\\" | head -1)); export VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation; ");
  jo_put(s[..], "./vk-pass pass.spv ");
  put_int(s[..], wh.w); jo_put(s[..], " "); put_int(s[..], wh.h); jo_put(s[..], " "); put_int(s[..], nt); jo_put(s[..], " u.bin out.f32 "); put_int(s[..], nv);
  jo_put(s[..], " >&2\"; cat out.f32' > native.f32");
  argv := [3] string.["bash", "-c", jo_text(s[..])];
  o: [65536] u8; e: [65536] u8;
  r := proc_run(argv[..], 600000, o[..], e[..]);
  tool_err(cast(string) e[0..<r.err_n]);
  if r.started != 0 || r.status != 0 { tool_errln("pass-check: the GPU host's pass failed"); return false; }
  raw: [PC_FILE * 2] u8;
  m := fs_read(fs_join(work, "native.f32", p[..]), raw[..]);
  if m != out.count * 4 { tool_errln("pass-check: the GPU host returned the wrong size"); return false; }
  for i: 0..<out.count { out[i] = f32_from_bits(le32(raw[..], i * 4)); }
  return true;
}
