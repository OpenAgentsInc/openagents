// Passes of a shader ported to Coax against the browser (docs/verse/native-gpu.md,
// G5). DIR holds a spec (verse/gpu/vk-passes.c documents its directives) and
// every file it names: the WGSL, the Coax passes' SPIR-V from `coax spirv`
// with their bindings, buffers, the index buffer and the draw list. Headless
// Chrome draws the WGSL (verse/gpu/golden/pass.js, served from DIR by
// coax/web/serve.sh for a secure origin) and HOST's GPU draws the SPIR-V
// (vk-passes, built there under the validation layers). A layers file the
// spec names that DIR lacks is made first: FILE.list names the images, which
// the browser decodes and mipmaps as host.js does, so both sides sample the
// same texels. The last pass's rgba16float targets are compared, failing
// past an f16's rounding (|a-b| <= 2e-3 * max(1,|a|)) on more than N values.
//   coax/web/tool.sh verse/gpu/pass-check.coax HOST DIR SPEC [--allow N] [--keep DIR2]
//       [--against FILE]
// --allow N passes with up to N values past the tolerance (pixels on an edge
// whose test lands within the two sides' float rounding). --keep writes
// golden.f32 and native.f32 (float32 RGBA rows, target after target) to DIR2.
// --against compares the browser with FILE (as --keep writes them, e.g. the
// pass run on the CPU) instead of drawing on HOST.
#import "Basic";
#load "../../coax/lib/net/cdp.coax";

PC_FILE :: 4194304;
PC_BIG :: 67108864;          // the largest file it reads whole (a layers file)
PC_FLOATS :: 33554432;
PC_TOL :: 0.002;
PC_PORT :: "18731";

// What the spec says the comparison needs: the size, and the last pass's targets.
PcSpec :: struct { ok: bool; w: int; h: int; nt: int; }

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 3 {
    tool_errln("usage: pass-check HOST DIR SPEC [--allow N] [--keep DIR2] [--against FILE]");
    return 2;
  }
  host := args_at(a[..], 0); dir := args_at(a[..], 1); spec_name := args_at(a[..], 2);
  keep := args_value(a[..], "--keep", "");
  allow := args_whole(args_value(a[..], "--allow", "0"));
  against := args_value(a[..], "--against", "");
  b: [1024] u8;
  text: [PC_FILE] u8;
  n := fs_read(fs_join(dir, spec_name, b[..]), text[..]);
  if n < 0 { tool_errln("pass-check: cannot read the spec"); return 1; }
  spec := pc_spec(cast(string) text[0..<n]);
  if !spec.ok || allow < 0 { tool_errln("pass-check: the spec needs a size and a last pass with colour targets; --allow a whole number"); return 2; }
  floats := spec.w * spec.h * 4 * spec.nt;
  if floats > PC_FLOATS { tool_errln("pass-check: the targets are too large"); return 2; }
  golden: [PC_FLOATS] f32;
  if !browser(dir, spec_name, cast(string) text[0..<n], floats / spec.nt, golden[0..<floats]) { return 1; }
  native: [PC_FLOATS] f32;
  if against.count > 0 {
    if !read_f32(against, native[0..<floats]) { return 1; }
  } else if !gpu(host, dir, spec_name, native[0..<floats]) { return 1; }
  if keep.count > 0 {
    k: [1024] u8; bytes: [PC_FLOATS * 4] u8;
    ok := fs_write(fs_join(keep, "golden.f32", k[..]), f32_bytes(golden[0..<floats], bytes[..]));
    ok = ok && fs_write(fs_join(keep, "native.f32", k[..]), f32_bytes(native[0..<floats], bytes[..]));
    if !ok { tool_errln("pass-check: could not write to --keep"); }
  }
  return compare(golden[0..<floats], native[0..<floats], spec.w, spec.h, spec.nt, allow);
}

// ---- the spec (pure)
// Word k (from 0) of a line, split on spaces and tabs, or "".
pc_word :: (line: string, k: int) -> string {
  i := 0; n := 0;
  while i < line.count {
    while i < line.count && (line[i] == ' ' || line[i] == '\t' || line[i] == '\r') { i += 1; }
    if i >= line.count { break; }
    j := i;
    while j < line.count && line[j] != ' ' && line[j] != '\t' && line[j] != '\r' { j += 1; }
    if n == k { return line[i..<j]; }
    n += 1; i = j;
  }
  return "";
}
// Line k (from 0) of text, or "" past its end; pc_lines counts them.
pc_lines :: (text: string) -> int {
  n := 0;
  for i: 0..<text.count { if text[i] == '\n' { n += 1; } }
  return ifx text.count > 0 && text[text.count - 1] != '\n' then n + 1 else n;
}
pc_line :: (text: string, k: int) -> string {
  i := 0; n := 0;
  while i <= text.count {
    j := i;
    while j < text.count && text[j] != '\n' { j += 1; }
    if n == k { return text[i..<j]; }
    n += 1; i = j + 1;
  }
  return "";
}
pc_spec :: (text: string) -> PcSpec {
  s: PcSpec;
  for k: 0..<pc_lines(text) {
    l := pc_line(text, k);
    d := pc_word(l, 0);
    if d == "size" { s.w = args_whole(pc_word(l, 1)); s.h = args_whole(pc_word(l, 2)); }
    if d == "pass" { s.nt = pc_targets(pc_word(l, 4)); }
  }
  s.ok = s.w > 0 && s.h > 0 && s.nt > 0 && s.nt <= 8;
  return s;
}
// A pass's TARGETS: a number of its own, or names joined by commas.
pc_targets :: (t: string) -> int {
  if t.count == 0 || (t[0] >= '0' && t[0] <= '9') { return args_whole(t); }
  n := 1;
  for i: 0..<t.count { if t[i] == ',' { n += 1; } }
  return n;
}
#test "the spec's size and its last pass's targets" {
  #assert pc_word("  pass a.spv vs  fs 2", 4) == "2" && pc_word("pass", 1) == "" && pc_word("", 0) == "" && pc_word("a\tb\r", 1) == "b";
  #assert pc_lines("a\nb\n") == 2 && pc_lines("a\nb") == 2 && pc_lines("") == 0 && pc_line("a\nbc\n", 1) == "bc" && pc_line("a", 3) == "";
  s := pc_spec("size 320 180\npass s.spv a b 0 sm 2 2 draws\npass t.spv c d 2 own 0 0 draws\n");
  #assert s.ok && s.w == 320 && s.h == 180 && s.nt == 2;
  #assert pc_targets("light,aux") == 2 && pc_targets("light") == 1 && pc_targets("3") == 3 && pc_targets("") < 0;
  #assert pc_spec("size 4 4\npass t c d light,aux - 0 0 3 keep\n").nt == 2;
  #assert !pc_spec("size 320 180\npass s.spv a b 0 sm 2 2 draws\n").ok && !pc_spec("pass t.spv c d 2 own 0 0 3\n").ok && !pc_spec("size 4 4\npass t c d 9 - 0 0 3").ok;
}

// ---- the comparison (pure)
// Within an f16's rounding of the golden.
pc_close :: (g: f32, n: f32) -> bool {
  m := abs(g); if m < 1 { m = 1; }
  d := abs(g - n);
  return d <= PC_TOL * m;
}
#test "an f16's rounding is close, more is not" {
  #assert pc_close(1, 1.0019) && !pc_close(1, 1.0021) && pc_close(100, 100.19) && !pc_close(100, 100.3) && pc_close(0, 0.0019) && !pc_close(0, 0.003);
}
compare :: (g: [] f32, n: [] f32, w: int, h: int, nt: int, allow: int) -> int {
  bad := 0; worst: f32 = 0; at := -1; nan := 0;
  for i: 0..<g.count {
    if g[i] != g[i] || n[i] != n[i] { if !(g[i] != g[i] && n[i] != n[i]) { nan += 1; } continue; }
    d := abs(g[i] - n[i]);
    if d > worst { worst = d; at = i; }
    if !pc_close(g[i], n[i]) { bad += 1; }
  }
  print("pass-check: % values (% targets of %x%), % past the tolerance, % NaN on one side only; largest difference %", g.count, nt, w, h, bad, nan, worst);
  if at >= 0 {
    px := at / 4;
    print(" at target %, (%, %) channel %: golden % native %", px / (w * h), px % (w * h) % w, px % (w * h) / w, at % 4, g[at], n[at]);
  }
  print("\n");
  if bad > allow { print("pass-check: more than the % allowed\n", allow); }
  return ifx bad <= allow && nan == 0 then 0 else 1;
}
// Floats as little-endian bytes, in out.
f32_bytes :: (f: [] f32, out: [] u8) -> string {
  for i: 0..<f.count {
    b := f32_bits(f[i]);
    for k: 0..<4 { out[i * 4 + k] = cast,trunc(u8) (b >> cast(u32) (k * 8)); }
  }
  return cast(string) out[0..<f.count * 4];
}
le32 :: (b: [] u8, at: int) -> u32 {
  return cast(u32) b[at] | (cast(u32) b[at + 1] << 8) | (cast(u32) b[at + 2] << 16) | (cast(u32) b[at + 3] << 24);
}
#test "floats to bytes and back" {
  f := [2] f32.[1.5, -0.25]; o: [8] u8;
  bytes := f32_bytes(f[..], o[..]);
  #assert bytes.count == 8 && f32_from_bits(le32(o[..], 0)) == 1.5 && f32_from_bits(le32(o[..], 4)) == -0.25 && o[3] == 0x3f;
}
read_f32 :: (path: string, out: [] f32) -> bool {
  raw: [PC_FLOATS * 4] u8;
  n := fs_read(path, raw[..]);
  if n != out.count * 4 { tool_err("pass-check: not the targets' size: "); tool_errln(path); return false; }
  for i: 0..<out.count { out[i] = f32_from_bits(le32(raw[..], i * 4)); }
  return true;
}
// a then b in out, or "".
cat :: (x: string, y: string, out: [] u8) -> string {
  if x.count + y.count > out.count { return ""; }
  for i: 0..<x.count { out[i] = x[i]; }
  for i: 0..<y.count { out[x.count + i] = y[i]; }
  return cast(string) out[0..<x.count + y.count];
}

// ---- the browser
browser :: (dir: string, spec_name: string, spec: string, per: int, out: [] f32) -> bool {
  b: [4] [1024] u8; page: [PC_FILE] u8;
  // the page beside the spec's files
  for f: [2] string.["verse/gpu/golden/index.html", "verse/gpu/golden/pass.js"] {
    n := fs_read(f, page[..]);
    if n < 0 || !fs_write(fs_join(dir, fs_base(f), b[0][..]), cast(string) page[0..<n]) { tool_errln("pass-check: cannot copy the page (run from the repo root)"); return false; }
  }
  server := proc_new();
  ok := proc_arg(server, "coax/web/serve.sh") && proc_arg(server, dir) && proc_arg(server, "--listen") && proc_arg(server, cat("127.0.0.1:", PC_PORT, b[0][..])) && proc_quiet(server);
  if !ok || proc_start(server) != 0 { tool_errln("pass-check: could not start coax/web/serve.sh"); return false; }
  proc_sleep(1500);
  c: [1] Cdp;
  done := false;
  if cdp_launch(c[..], 800, 600, "coax-pass-") {
    done = drive(c[..], dir, spec_name, spec, per, out);
    cdp_close(c[..]);
  } else { tool_err("pass-check: "); tool_errln(cdp_error(c[..])); }
  k := proc_kill(server, PROC_SIGKILL); r := proc_wait(server, 2000); rel := proc_release(server);
  return done;
}
drive :: (c: [] Cdp, dir: string, spec_name: string, spec: string, per: int, out: [] f32) -> bool {
  b: [4] [1024] u8;
  url := cat(cat("http://127.0.0.1:", PC_PORT, b[0][..]), "/", b[1][..]);
  nav: [2048] u8; o: [1] Jo; jo_start(o[..], nav[..]);
  jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  if cdp_call(c, "Page.navigate", jo_text(o[..]), CDP_CALL_MS) < 0 { tool_errln(cdp_error(c)); return false; }
  proc_sleep(1500);
  // layers files the directory lacks, decoded by the browser
  for k: 0..<pc_lines(spec) {
    l := pc_line(spec, k);
    if pc_word(l, 0) != "layers" { continue; }
    file := pc_word(l, 2);
    if fs_exists(fs_join(dir, file, b[0][..])) { continue; }
    if !layers(c, dir, file, args_whole(pc_word(l, 3)), args_whole(pc_word(l, 4)), args_whole(pc_word(l, 5)), args_whole(pc_word(l, 6))) { return false; }
  }
  e: [4096] u8; x: [1] Jo; jo_start(x[..], e[..]);
  jo_put(x[..], "runSpec("); jo_str(x[..], spec_name); jo_put(x[..], ")");
  v := cdp_evaluate(c, jo_text(x[..]));
  if !answer_ok(c, v) { return false; }
  d := cdp_doc(c);
  ts := jv_get(d, v, "targets");
  raw: [PC_FILE * 4] u8;
  for i: 0..<jv_len(d, ts) {
    if (i + 1) * per > out.count { break; }
    n := b64_decode(jv_raw(d, jv_at(d, ts, i)), raw[..]);
    if n != per * 4 { tool_errln("pass-check: the browser returned a target of the wrong size"); return false; }
    for k: 0..<per { out[i * per + k] = f32_from_bits(le32(raw[..], k * 4)); }
  }
  if jv_len(d, ts) * per != out.count { tool_errln("pass-check: the browser returned the wrong number of targets"); return false; }
  print("pass-check: the browser drew the spec\n");
  return true;
}
answer_ok :: (c: [] Cdp, v: int) -> bool {
  if v < 0 { tool_errln(cdp_error(c)); return false; }
  d := cdp_doc(c);
  if jv_bool(d, jv_get(d, v, "ok")) { return true; }
  msg: [65536] u8; m := jv_str(d, jv_get(d, v, "error"), msg[..]);
  tool_err("pass-check: the browser failed: "); tool_errln(ifx m >= 0 then cast(string) msg[0..<m] else "?");
  return false;
}
// FILE from FILE.list: each layer's levels from the browser, laid out level after level.
layers :: (c: [] Cdp, dir: string, file: string, w: int, h: int, n: int, levels: int) -> bool {
  b: [2] [1024] u8; e: [4096] u8; x: [1] Jo;
  jo_start(x[..], e[..]);
  jo_put(x[..], "decodeLayers("); jo_str(x[..], cat(file, ".list", b[0][..])); jo_put(x[..], ","); jo_int(x[..], w); jo_put(x[..], ","); jo_int(x[..], h); jo_put(x[..], ")");
  v := cdp_evaluate(c, jo_text(x[..]));
  if !answer_ok(c, v) { return false; }
  d := cdp_doc(c);
  if jv_int(d, jv_get(d, v, "levels"), -1) != levels || jv_int(d, jv_get(d, v, "n"), -1) != n { tool_errln("pass-check: the layers are not the spec's"); return false; }
  all: [PC_BIG] u8; one: [PC_FILE * 2] u8;
  size := 0;
  for l: 0..<levels { lw := ifx w >> l > 0 then w >> l else 1; lh := ifx h >> l > 0 then h >> l else 1; size += lw * lh * 4 * n; }
  if size > all.count { tool_errln("pass-check: the layers are too large"); return false; }
  for layer: 0..<n {
    jo_start(x[..], e[..]); jo_put(x[..], "layerBytes("); jo_int(x[..], layer); jo_put(x[..], ")");
    r := cdp_evaluate(c, jo_text(x[..]));
    if r < 0 { tool_errln(cdp_error(c)); return false; }
    got := b64_decode(jv_raw(cdp_doc(c), r), one[..]);
    // level l of this layer goes after all of the lower levels' layers and this level's earlier layers
    src := 0; at := 0;
    for l: 0..<levels {
      lw := ifx w >> l > 0 then w >> l else 1; lh := ifx h >> l > 0 then h >> l else 1;
      bytes := lw * lh * 4;
      if src + bytes > got { tool_errln("pass-check: a short layer from the browser"); return false; }
      dst := at + layer * bytes;
      for i: 0..<bytes { all[dst + i] = one[src + i]; }
      src += bytes; at += bytes * n;
    }
  }
  if !fs_write(fs_join(dir, file, b[1][..]), cast(string) all[0..<size]) { tool_errln("pass-check: cannot write the layers"); return false; }
  print("pass-check: the browser decoded % layers of %x%, % levels\n", n, w, h, levels);
  return true;
}

// ---- the GPU host
gpu :: (host: string, dir: string, spec_name: string, out: [] f32) -> bool {
  b: [4] [1024] u8; buf: [PC_FILE] u8;
  for f: [7] string.["verse/gpu/vk-passes.c", "verse/gpu/vk-spec.c", "verse/gpu/vk-spec.h", "verse/gpu/vks.c", "verse/gpu/vks.h", "verse/gpu/vkc.c", "verse/gpu/vkc.h"] {
    n := fs_read(f, buf[..]);
    if n < 0 || !fs_write(fs_join(dir, fs_base(f), b[0][..]), cast(string) buf[0..<n]) { tool_err("pass-check: cannot copy "); tool_errln(f); return false; }
  }
  // built and run there under the validation layers; the floats come back
  script: [8192] u8; s: [1] Jo; jo_start(s[..], script[..]);
  jo_put(s[..], "cd '"); jo_put(s[..], dir); jo_put(s[..], "' && COPYFILE_DISABLE=1 tar --no-xattrs --exclude native.f32 -cf - . | ssh -o BatchMode=yes ");
  jo_put(s[..], host);
  jo_put(s[..], " 'set -e; d=$(mktemp -d); trap \"rm -rf $d\" EXIT; tar -x -C $d 2>/dev/null; cd $d; export VK_DRIVER_FILES=${VK_DRIVER_FILES:-/run/opengl-driver/share/vulkan/icd.d/nvidia_icd.json}; ");
  jo_put(s[..], "nix-shell -p gcc vulkan-headers vulkan-loader vulkan-validation-layers --run \"set -e; gcc -std=c11 -O2 -I. vk-passes.c vk-spec.c vks.c vkc.c -lvulkan -lm -o vk-passes; ");
  jo_put(s[..], "export VK_ADD_LAYER_PATH=\\$(dirname \\$(find /nix/store -maxdepth 6 -name VkLayer_khronos_validation.json -path \\\"*validation-layers*\\\" | head -1)); export VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation; ");
  jo_put(s[..], "./vk-passes "); jo_put(s[..], spec_name); jo_put(s[..], " out.f32 >&2\"; cat out.f32' > native.f32");
  argv := [3] string.["bash", "-c", jo_text(s[..])];
  o: [65536] u8; e: [65536] u8;
  r := proc_run(argv[..], 900000, o[..], e[..]);
  if r.started != 0 || r.status != 0 { tool_err(cast(string) e[0..<r.err_n]); tool_errln("pass-check: the GPU host's passes failed"); return false; }
  // vk-passes's own line (the GPU, the passes, validation) on stdout; the build's warnings stay out
  for k: 0..<pc_lines(cast(string) e[0..<r.err_n]) {
    l := pc_line(cast(string) e[0..<r.err_n], k);
    if l.count > 10 && l[0..<10] == "vk-passes:" { print("%\n", l); }
  }
  return read_f32(fs_join(dir, "native.f32", b[1][..]), out);
}
