// A scene realm's frame against the browser (docs/verse/native-gpu.md, realms-native): a realm
// whose module draws a scene (coaxial_draws: Dead Gears, Ice Cream Man, Hecate's Cemetery), drawn
// as host.js draws one. Its frame comes from the browser's wasm (verse/native/wasm-run.ts: golden,
// clock 0, the 90th frame at 320x180), built with the libraries the site's build links it with
// (verse/native/build.sh --libraries); its entries from apps/openagents-web/gpu/REALM.coax as
// `coax spirv` lowers them, and the browser draws REALM.wgsl, the module `coax wgsl` writes from
// the same Coax. verse/gpu/pass-check.coax draws the spec in headless Chrome and on HOST's GPU and
// compares, both from the Coax with its sin hashes one integer hash (verse/gpu/int-hash.coax
// --page, the particles' module too); with --live, from the live Coax, reported only.
//   coax/web/tool.sh verse/gpu/scene-pass.coax HOST REALM [--allow N] [--keep DIR] [--live] [--emit DIR] [--upto ENTRY]
// --upto ENTRY (bg, scene, particle, bloom, post) compares the frame as it stands after ENTRY's
// first pass (its targets: light and aux with a post pass), to find where a difference starts.
// --emit DIR writes the spec, its modules and the frame to DIR instead, for a host that draws
// every frame (verse/gpu/vk-realm.c, verse/gpu/realm.sh), from the live Coax.
// host.js's frame for a scene (its frame()): the WGSL's entries say which passes there are.
//   bg      bg_fs over the frame, depth always, not written
//   scene   the draw list's records through scene_vs and scene_fs (group 1: the realm's storage
//           assets, then its stores, by the WGSL's names), depth tested less and written
//   sparks  with a particles asset (host.js particlePipeline): $sparks quads of 6 vertices from its
//           own module, added, depth tested, not written, aux kept
//   post    with post_fs: bg, the scene and the sparks into light and aux, then the bloom (five
//           steps through a quarter and an eighth of the size) and post_fs to the screen
//   hud     the frame's own vertices through fx_vs and fx_fs, the larger of each channel kept
// Shadows, grass and water (Everglade's, verse/gpu/everglade-pass.coax) are not drawn here.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";

SC_SIZE :: "320 180";
// host.js's bloom: each step its target, its source and its vec4f (x, y the direction, z the
// source's scale, w the pass), as verse/gpu/everglade-pass.coax's EP_BLOOM
SC_BLOOM :: [5] string.["q0 light 0 0 0 4", "q1 q0 1 0 1 1", "q0 q1 0 1 1 1", "e1 q0 1 0 1 2", "e0 e1 0 1 1 1"];

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 2 { tool_errln("usage: scene-pass HOST REALM [--allow N] [--keep DIR] [--live] [--emit DIR]"); return 2; }
  tb: [1024] u8;
  work := fs_temp("scene-pass-", tb[..]);
  if work.count == 0 { tool_errln("scene-pass: no temporary directory"); return 1; }
  emit := args_value(a[..], "--emit", "");
  status := sc_run(args_at(a[..], 0), args_at(a[..], 1), work, args_value(a[..], "--allow", "40"), args_value(a[..], "--keep", ""), emit, emit.count == 0 && !args_has(a[..], "--live"), args_value(a[..], "--upto", ""));
  r := fs_remove(work);
  return status;
}

sc_run :: (host: string, realm: string, work: string, allow: string, keep: string, emit: string, int_hash: bool, upto: string) -> int {
  b: [12] [1024] u8; o: [65536] u8;
  dir := fs_join(work, "spec", b[0][..]);
  if !fs_mkdir(dir) { tool_errln("scene-pass: cannot make a directory"); return 1; }
  // the realm's assets, as realms.json gives them for its module
  rj: [1048576] u8;
  rn := fs_read("apps/openagents-web/realms.json", rj[..]);
  if rn <= 0 { tool_errln("scene-pass: run it from the repository's root (no apps/openagents-web/realms.json)"); return 2; }
  assets := sc_assets(cast(string) rj[0..<rn], realm);
  index := sc_asset(assets, "index");
  particles := sc_asset(assets, "particles");
  if sc_asset(assets, "pack").count > 0 || sc_asset(assets, "storage").count > 0 || sc_asset(assets, "layers").count > 0 {
    tool_err("scene-pass: "); tool_err(realm); tool_errln("'s assets are a pack or storage (its own pass tool, as Everglade's)"); return 2;
  }
  // the browser's wasm with the site's libraries, and its frame
  lo: [8192] u8;
  la := [3] string.["verse/native/build.sh", "--libraries", realm];
  ln := fp_step_into("the libraries", la[..], lo[..]);
  if ln < 0 { return 1; }
  wasm := fs_join(work, cat(realm, ".wasm", b[1][..]), b[2][..]);
  build: [24] string; bn := 0;
  build[0] = "coax/web/wasm.sh"; build[1] = cat(cat("apps/openagents-web/", realm, b[3][..]), ".coax", b[4][..]);
  build[2] = cat(cat("apps/openagents-web/", realm, b[5][..]), "-face.c", b[6][..]); build[3] = wasm; bn = 4;
  libs := cast(string) lo[0..<ln];
  for k: 0..<sc_lines(libs) { l := sc_line(libs, k); if l.count > 0 && bn < 24 { build[bn] = l; bn += 1; } }
  if fp_step_into("the wasm", build[0..<bn], o[..]) < 0 { return 1; }
  frame := [14] string.["env", "VERSE_NATIVE_CLOCK_MS=0", "bun", "verse/native/wasm-run.ts", wasm, "--size", "320x180", "--frames", "90", "--every", "90", "--golden", "--dump", dir];
  if fp_step_into("the frame", frame[..], o[..]) < 0 { return 1; }
  // the modules the browser draws, the entries lowered
  gb: [1024] u8; wb: [1024] u8; pg: [1024] u8; pw: [1024] u8;
  gpu := cat(cat("apps/openagents-web/gpu/", realm, b[3][..]), ".coax", gb[..]);
  wgsl := cat(cat("apps/openagents-web/", realm, b[4][..]), ".wgsl", wb[..]);
  pgpu := "apps/openagents-web/gpu/particles.coax"; pwgsl := "apps/openagents-web/particles.wgsl";
  if int_hash {
    ih := fs_join(work, "int", b[5][..]);
    cmd := [5] string.["coax/web/tool.sh", "verse/gpu/int-hash.coax", ih, "--page", realm];
    if fp_step_into("the integer hash", cmd[..], o[..]) < 0 { return 1; }
    gpu = fs_join(ih, cat(realm, ".coax", b[6][..]), gb[..]);
    wgsl = fs_join(ih, cat(realm, ".wgsl", b[7][..]), wb[..]);
    if particles.count > 0 {
      ip := fs_join(work, "int-particles", b[8][..]);
      pc := [5] string.["coax/web/tool.sh", "verse/gpu/int-hash.coax", ip, "--page", "particles"];
      if fp_step_into("the particles' integer hash", pc[..], o[..]) < 0 { return 1; }
      pgpu = fs_join(ip, "particles.coax", pg[..]); pwgsl = fs_join(ip, "particles.wgsl", pw[..]);
    }
    print("scene-pass: %, one integer hash on both sides\n", realm);
  }
  if !sc_copy(wgsl, fs_join(dir, "page.wgsl", b[9][..])) { return 1; }
  page: [4194304] u8;
  pn := fs_read(wgsl, page[..]);
  code := cast(string) page[0..<ifx pn > 0 then pn else 0];
  post := sc_has(code, "fn post_fs(");
  if !sc_has(code, "fn scene_vs(") { tool_err("scene-pass: "); tool_err(realm); tool_errln(" has no scene_vs"); return 2; }
  if sc_has(code, "fn shadow_vs(") || sc_has(code, "fn grass_vs(") || sc_has(code, "fn water_vs(") || sc_has(code, "fn caster_vs(") {
    tool_err("scene-pass: "); tool_err(realm); tool_errln(" has shadows, grass or water (not drawn here yet)"); return 2;
  }
  if !sc_lower(dir, gpu, realm, "bg_vs", "bg_fs") || !sc_lower(dir, gpu, realm, "scene_vs", "scene_fs") || !sc_lower(dir, gpu, realm, "fx_vs", "fx_fs") { return 1; }
  if post && (!sc_lower(dir, gpu, realm, "bg_vs", "bloom_fs") || !sc_lower(dir, gpu, realm, "bg_vs", "post_fs")) { return 1; }
  // the frame's counts
  dt: [256] u8;
  dn := fs_read(fs_join(dir, "draws.txt", b[9][..]), dt[..]);
  words := cast(string) dt[0..<ifx dn > 0 then dn else 0];
  all := args_whole(sc_word(words, 0)); sparks := args_whole(sc_word(words, 3));
  hud := args_whole(sc_word(words, 4)); floats := args_whole(sc_word(words, 5));
  if floats < 1 || floats > 32 { tool_errln("scene-pass: the frame does not say its vertices' floats"); return 1; }
  if all <= 0 { tool_errln("scene-pass: the frame has no draws"); return 1; }
  if index.count > 0 && !sc_copy(cat("apps/openagents-web", index, b[10][..]), fs_join(dir, "index.bin", b[9][..])) { return 1; }
  if index.count == 0 && !fs_write(fs_join(dir, "index.bin", b[9][..]), "\0\0\0\0") { return 1; }
  fx := particles.count > 0 && sparks > 0;
  if fx {
    if !sc_copy(pwgsl, fs_join(dir, "particles.wgsl", b[9][..])) || !sc_lower(dir, pgpu, "particles", "particle_vs", "particle_fs") { return 1; }
  }
  // group 1's storage: the WGSL's names in their bindings' order, the stores in theirs
  names: [8] string; nn := sc_scene_storage(code, names[..]);
  sp: [8192] u8; sa: [1] Sp; sa[0] = Sp.{buf = sp[..]}; s := sa[..];
  sc_spec(s, all, sparks, hud, floats, names[0..<nn], post, fx, sc_has(code, "var post_depth"));
  text := cast(string) sp[0..<s[0].n];
  if upto.count > 0 {
    ua: [256] u8; ub: [256] u8; text = sc_upto(text, cat(cat("pass ", upto, ua[..]), "_fs.spv ", ub[..]));
    if text.count == 0 { tool_err("scene-pass: the frame has no pass "); tool_errln(upto); return 2; }
  }
  if s[0].bad || !fs_write(fs_join(dir, "spec.txt", b[9][..]), text) { tool_errln("scene-pass: cannot write the spec"); return 1; }
  if emit.count > 0 {
    if !fs_mkdir(emit) && fs_kind(emit) <= 0 { tool_errln("scene-pass: cannot make the --emit directory"); return 1; }
    ed: [1024] u8;
    cp := [4] string.["cp", "-R", cat(dir, "/.", ed[..]), emit];
    if fp_step_into("the spec directory", cp[..], o[..]) < 0 { return 1; }
    print("scene-pass: %'s spec, modules and frame in %\n", realm, emit);
    return 0;
  }
  pc := [9] string.["coax/web/tool.sh", "verse/gpu/pass-check.coax", host, dir, "spec.txt", "--allow", allow, "--keep", keep];
  n := fp_step_into("the comparison", pc[0..<ifx keep.count > 0 then 9 else 7], o[..]);
  if n >= 0 { print("%\n", cast(string) o[0..<n]); }
  return ifx n >= 0 then 0 else 1;
}

// host.js's frame for a scene with these counts (see the header). NAMES are group 1's storage
// buffers in their bindings' order, the frame's stores s0, s1 ... in theirs.
sc_spec :: (s: [] Sp, all: int, sparks: int, hud: int, floats: int, names: [] string, post: bool, fx: bool, post_depth: bool) {
  put(s, "wgsl page.wgsl\nsize "); put(s, SC_SIZE);
  put(s, "\nlet all "); put_int(s, all); put(s, "\nlet sparks "); put_int(s, sparks); put(s, "\nlet hud "); put_int(s, hud);
  put(s, "\nbuffer u u.bin\n");
  for k: 0..<names.count { put(s, "buffer "); put(s, names[k]); put(s, " s"); put_int(s, k); put(s, ".bin\n"); }
  put(s, "index index.bin\ndraws draws.bin $all\ndepth scene_depth frame frame\n");
  into := "1";
  if post { put(s, "target light\ntarget aux\n"); into = "light,aux"; }
  put(s, "pass bg_fs.spv bg_vs bg_fs "); put(s, into); put(s, " scene_depth 0 0 3 always nowrite\n");
  put(s, "pass scene_fs.spv scene_vs scene_fs "); put(s, into); put(s, " scene_depth 0 0 draws keep\n");
  if fx {
    put(s, "wgsl particles.wgsl\nbuffer emitters puffs.bin\n");
    put(s, "pass particle_fs.spv particle_vs particle_fs "); put(s, into); put(s, " scene_depth 0 0 6:$sparks keep nowrite blend=add alpha=add");
    if post { put(s, " mask=1"); }
    put(s, "\nwgsl page.wgsl\n");
  }
  if post {
    put(s, "target q0 /4\ntarget q1 /4\ntarget e0 /8\ntarget e1 /8");
    put(s, "\nsampler bloom_lin linear clamp flat none\nsampler post_lin linear clamp flat none\n");
    for k: 0..<SC_BLOOM.count {
      st := SC_BLOOM[k];
      put(s, "floats step"); put_int(s, k);
      for i: 2..<6 { put(s, " "); put(s, sc_word(st, i)); }
      put(s, "\npass bloom_fs.spv bg_vs bloom_fs "); put(s, sc_word(st, 0)); put(s, " - 0 0 3 bind=bloom_src:"); put(s, sc_word(st, 1));
      put(s, " bind=bloom_step:step"); put_int(s, k); put(s, "\n");
    }
    put(s, "pass post_fs.spv bg_vs post_fs 1 - 0 0 3 bind=post_light:light bind=post_quarter:q0 bind=post_eighth:e0 bind=post_aux:aux");
    if post_depth { put(s, " bind=post_depth:scene_depth"); }
    put(s, "\nbuffer hud hud.bin\npass fx_fs.spv fx_vs fx_fs 1 - 0 0 $hud keep blend=max alpha=max vertices=hud:"); put_int(s, floats); put(s, "\n");
  } else {
    // without post the strokes draw in the scene's pass: its depth there, always passing, not written
    put(s, "buffer hud hud.bin\npass fx_fs.spv fx_vs fx_fs 1 scene_depth 0 0 $hud keep always nowrite blend=max alpha=max vertices=hud:"); put_int(s, floats); put(s, "\n");
  }
}
#test "a scene's spec" {
  o: [8192] u8; sa: [1] Sp; sa[0] = Sp.{buf = o[..]}; s := sa[..];
  one := [1] string.["objects"];
  sc_spec(s, 2, 0, 30, 16, one[..], false, false, false);
  #assert !s[0].bad && cast(string) o[0..<s[0].n] == "wgsl page.wgsl\nsize 320 180\nlet all 2\nlet sparks 0\nlet hud 30\nbuffer u u.bin\nbuffer objects s0.bin\nindex index.bin\ndraws draws.bin $all\ndepth scene_depth frame frame\npass bg_fs.spv bg_vs bg_fs 1 scene_depth 0 0 3 always nowrite\npass scene_fs.spv scene_vs scene_fs 1 scene_depth 0 0 draws keep\nbuffer hud hud.bin\npass fx_fs.spv fx_vs fx_fs 1 scene_depth 0 0 $hud keep always nowrite blend=max alpha=max vertices=hud:16\n";
  p: [8192] u8; sp: [1] Sp; sp[0] = Sp.{buf = p[..]};
  two := [2] string.["heights", "objects"];
  sc_spec(sp[..], 6, 384, 30, 16, two[..], true, true, false);
  t := cast(string) p[0..<sp[0].n];
  #assert !sp[0].bad && sc_line(t, 7) == "buffer objects s1.bin" && sc_line(t, 11) == "target light";
  #assert sc_line(t, 13) == "pass bg_fs.spv bg_vs bg_fs light,aux scene_depth 0 0 3 always nowrite";
  #assert sc_line(t, 17) == "pass particle_fs.spv particle_vs particle_fs light,aux scene_depth 0 0 6:$sparks keep nowrite blend=add alpha=add mask=1";
  #assert sc_line(t, 18) == "wgsl page.wgsl" && sc_line(t, sc_lines(t) - 1) == "pass fx_fs.spv fx_vs fx_fs 1 - 0 0 $hud keep blend=max alpha=max vertices=hud:16";
  #assert sc_line(t, sc_lines(t) - 3) == "pass post_fs.spv bg_vs post_fs 1 - 0 0 3 bind=post_light:light bind=post_quarter:q0 bind=post_eighth:e0 bind=post_aux:aux";
}

// The spec up to and with its first line that starts `start`, "" if none does.
sc_upto :: (spec: string, start: string) -> string {
  i := 0;
  while i < spec.count {
    j := i;
    while j < spec.count && spec[j] != '\n' { j += 1; }
    if j - i >= start.count && spec[i..<i + start.count] == start { return spec[0..<ifx j < spec.count then j + 1 else j]; }
    i = j + 1;
  }
  return "";
}
#test "a spec cut short" {
  t := "size 1 1\npass bg_fs.spv a\npass scene_fs.spv b\npass fx_fs.spv c\n";
  #assert sc_upto(t, "pass scene_fs.spv ") == "size 1 1\npass bg_fs.spv a\npass scene_fs.spv b\n" && sc_upto(t, "pass x_fs.spv ") == "";
}

// The read-only storage buffers the WGSL binds in group 1 before its bloom and post groups (the
// scene's: host.js's sceneLayout), in their bindings' order: their count, their names in out.
sc_scene_storage :: (code: string, out: [] string) -> int {
  pre := "@group(1) @binding(";
  mid := ") var<storage, read> ";
  at: [8] string; seen := 0;
  i := 0;
  while i + pre.count < code.count {
    if code[i..<i + pre.count] == pre {
      j := i + pre.count; k := 0;
      while j < code.count && code[j] >= '0' && code[j] <= '9' { k = k * 10 + cast(int) code[j] - 48; j += 1; }
      if j + mid.count <= code.count && code[j..<j + mid.count] == mid && k < at.count {
        e := j + mid.count; f := e;
        while f < code.count && (code[f] == '_' || (code[f] >= 'a' && code[f] <= 'z') || (code[f] >= '0' && code[f] <= '9')) { f += 1; }
        if at[k].count == 0 { at[k] = code[e..<f]; if k + 1 > seen { seen = k + 1; } }
      }
    }
    i += 1;
  }
  n := 0;
  for k: 0..<seen { if at[k].count == 0 { break; } if n < out.count { out[n] = at[k]; n += 1; } }
  return n;
}
#test "group 1's storage" {
  c := "@group(1) @binding(1) var<storage, read> objects: array<f32>;\n@group(1) @binding(0) var<storage, read> heights: array<f32>;\n@group(1) @binding(0) var bloom_src: texture_2d<f32>;\n@group(1) @binding(2) var<uniform> bloom_step: vec4f;\n";
  o: [8] string;
  #assert sc_scene_storage(c, o[..]) == 2 && o[0] == "heights" && o[1] == "objects";
  #assert sc_scene_storage("", o[..]) == 0;
}

// The assets realms.json lists for the realm whose module is `module` (the text inside its
// "assets": [...], "" for none).
sc_assets :: (json: string, module: string) -> string {
  key: [256] u8; kn := 0;
  for c: "\"module\": \"" { key[kn] = c; kn += 1; }
  for c: module { if kn < 250 { key[kn] = c; kn += 1; } }
  key[kn] = '"'; kn += 1;
  k := cast(string) key[0..<kn];
  i := 0;
  while i + k.count <= json.count {
    if json[i..<i + k.count] == k {
      a := "\"assets\": [";
      j := i + k.count;
      // up to the next realm's module (a realm's "golden": {...} closes before its assets)
      while j + a.count <= json.count && !(j + 10 <= json.count && json[j..<j + 10] == "\"module\": ") {
        if json[j..<j + a.count] == a {
          e := j + a.count; f := e;
          while f < json.count && json[f] != ']' { f += 1; }
          return json[e..<f];
        }
        j += 1;
      }
      return "";
    }
    i += 1;
  }
  return "";
}
// The URL of the first asset of `kind` in an assets list ("index:/realms/x/X.indices" gives
// "/realms/x/X.indices"), "" for none.
sc_asset :: (list: string, kind: string) -> string {
  i := 0;
  while i < list.count {
    if list[i] == '"' {
      j := i + 1;
      while j < list.count && list[j] != '"' { j += 1; }
      entry := list[i + 1..<j];
      if entry.count > kind.count && entry[0..<kind.count] == kind && entry[kind.count] == ':' { return entry[kind.count + 1..<entry.count]; }
      i = j + 1;
    } else { i += 1; }
  }
  return "";
}
#test "the realm's assets" {
  j := "{ \"module\": \"villa\", \"golden\": { \"lit\": 1 }, \"assets\": [\"index:/realms/h/Villa.indices\", \"particles:/particles.wgsl\"] } { \"module\": \"belt\", \"assets\": [] }";
  v := sc_assets(j, "villa");
  #assert sc_asset(v, "index") == "/realms/h/Villa.indices" && sc_asset(v, "particles") == "/particles.wgsl" && sc_asset(v, "pack") == "";
  #assert sc_assets(j, "belt") == "" && sc_assets(j, "none") == "";
}

sc_has :: (text: string, what: string) -> bool {
  if text.count < what.count { return false; }
  for i: 0..<text.count - what.count + 1 { if text[i..<i + what.count] == what { return true; } }
  return false;
}

// REALM_VS and REALM_FS of gpu lowered to DIR/FS.spv, the bindings coax spirv reports beside it.
sc_lower :: (dir: string, gpu: string, realm: string, vs: string, fs_: string) -> bool {
  b: [4] [1024] u8; o: [65536] u8; v: [256] u8; f: [256] u8; nb: [256] u8; p: [256] u8;
  spv := fs_join(dir, cat(fs_, ".spv", nb[..]), b[0][..]);
  pre := cat(realm, "_", p[..]);
  argv := [9] string.["coax/bin/coax", "spirv", gpu, "--vertex", cat(pre, vs, v[..]), "--fragment", cat(pre, fs_, f[..]), "-o", spv];
  err: [65536] u8;
  r := proc_run(argv[..], 900000, o[..], err[..]);
  if r.started != 0 || r.status != 0 || r.timed_out { tool_err(cast(string) err[0..<r.err_n]); tool_errln("scene-pass: the lowering failed"); return false; }
  return fs_write(cat(spv, ".bindings", b[1][..]), cast(string) err[0..<r.err_n]);
}

sc_copy :: (from: string, to: string) -> bool {
  buf: [8388608] u8;
  n := fs_read(from, buf[..]);
  if n < 0 || !fs_write(to, cast(string) buf[0..<n]) { tool_err("scene-pass: cannot copy "); tool_errln(from); return false; }
  return true;
}

// Runs argv: the length of its stdout in out, or -1 (printed with its stderr) when it fails.
fp_step_into :: (what: string, argv: [] string, out: [] u8) -> int {
  err: [65536] u8;
  r := proc_run(argv, 900000, out, err[..]);
  if r.started != 0 || r.status != 0 || r.timed_out {
    if r.out_n > 0 { print("%\n", cast(string) out[0..<r.out_n]); }
    tool_err(cast(string) err[0..<r.err_n]);
    tool_err("scene-pass: "); tool_err(what); tool_errln(" failed");
    return -1;
  }
  return r.out_n;
}

// ---- text (pure)
Sp :: struct { buf: [] u8; n: int; bad: bool; }
put :: (s: [] Sp, t: string) {
  if s[0].n + t.count > s[0].buf.count { s[0].bad = true; return; }
  for i: 0..<t.count { s[0].buf[s[0].n + i] = t[i]; }
  s[0].n += t.count;
}
put_int :: (s: [] Sp, v: int) {
  d: [24] u8; n := 0; x := ifx v < 0 then -v else v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast,trunc(u8) (48 + x % 10); x /= 10; n += 1; }
  if v < 0 { put(s, "-"); }
  for i: 0..<n { e := [1] u8.[d[n - 1 - i]]; put(s, cast(string) e[..]); }
}
cat :: (x: string, y: string, out: [] u8) -> string {
  if x.count + y.count > out.count { return ""; }
  for i: 0..<x.count { out[i] = x[i]; }
  for i: 0..<y.count { out[x.count + i] = y[i]; }
  return cast(string) out[0..<x.count + y.count];
}
// The k-th space-separated word of a line, "" past the last.
sc_word :: (line: string, k: int) -> string {
  i := 0; w := 0;
  while i < line.count {
    while i < line.count && (line[i] == ' ' || line[i] == '\n') { i += 1; }
    j := i;
    while j < line.count && line[j] != ' ' && line[j] != '\n' { j += 1; }
    if j > i { if w == k { return line[i..<j]; } w += 1; }
    i = j;
  }
  return "";
}
sc_lines :: (text: string) -> int {
  n := 0;
  for i: 0..<text.count { if text[i] == '\n' { n += 1; } }
  return ifx text.count > 0 && text[text.count - 1] != '\n' then n + 1 else n;
}
sc_line :: (text: string, k: int) -> string {
  i := 0; n := 0;
  while i <= text.count {
    j := i;
    while j < text.count && text[j] != '\n' { j += 1; }
    if n == k { return text[i..<j]; }
    n += 1; i = j + 1;
  }
  return "";
}
#test "words and lines" {
  #assert sc_word("2 0 0 384 30 16 0", 3) == "384" && sc_word("a", 1) == "" && sc_lines("a\nb\n") == 2 && sc_line("a\nb\n", 1) == "b";
}
