// A scene realm's frame against the browser (docs/verse/native-gpu.md, realms-native): a realm
// whose module draws a scene (coaxial_draws: Dead Gears, Ice Cream Man, Hecate's Cemetery), drawn
// as host.js draws one. Its frame comes from the browser's wasm (verse/native/wasm-run.ts: golden,
// clock 0, the 90th frame at 320x180), built with the libraries the site's build links it with
// (verse/native/build.sh --libraries); its entries from apps/openagents-web/gpu/REALM.coax as
// `coax spirv` lowers them, and the browser draws REALM.wgsl, the module `coax wgsl` writes from
// the same Coax. verse/gpu/pass-check.coax draws the spec in headless Chrome and on HOST's GPU and
// compares, both from the Coax with its sin hashes one integer hash (verse/gpu/int-hash.coax
// --page, the particles' module too); with --live, from the live Coax, reported only.
//   coax/web/tool.sh verse/gpu/scene-pass.coax HOST REALM [--allow N] [--keep DIR] [--live] [--emit DIR] [--upto ENTRY]
// --upto ENTRY (bg, scene, particle, bloom, post) compares the frame as it stands after ENTRY's
// first pass (its targets: light and aux with a post pass), to find where a difference starts.
// --emit DIR writes the spec, its modules and the frame to DIR instead, for a host that draws
// every frame (verse/gpu/vk-realm.c, verse/gpu/realm.sh), from the live Coax.
// host.js's frame for a scene (its frame()): the WGSL's entries say which passes there are.
//   bg      bg_fs over the frame, depth always, not written
//   scene   the draw list's records through scene_vs and scene_fs (group 1: the realm's storage
//           assets, then its stores, by the WGSL's names), depth tested less and written
//   water   with water_vs: the list's last $all - $scene records (coaxial_water_draws) after the scene,
//           each in its two halves, transmit (the light times it) then emit (added), depth tested,
//           not written, alpha kept; with water_scene declared, the light and depth copied first
//   sparks  with a particles asset (host.js particlePipeline): $sparks quads of 6 vertices from its
//           own module, added, depth tested, not written, aux kept
//   post    with post_fs: bg, the scene and the sparks into light and aux, then the bloom (five
//           steps through a quarter and an eighth of the size) and post_fs to the screen
//   hud     the frame's own vertices through fx_vs and fx_fs, the larger of each channel kept
//   shadow  with shadow_vs: the scene's records first into a 2048-square depth map from the key
//           light (bias 2, slope 2), which scene_fs samples
//   traced  with caster_vs (the fixture's): the casters into the same map, vertex only; a bg_fs that
//           writes @builtin(frag_depth) writes the scene's depth; grass_vs's blades after bg
// REALM is a module (deadgears) or a realm's slug (haunted-house: the realm module). A realm whose
// assets are a pack runs with it (wasm-run --pack); one whose data, storage, index and layers are
// separate files (the haunted house, the sandbox) with them made one (verse/tools/pack-files.coax);
// the pack's vertices are group 1's first storage buffer, and its layers, decoded and mipmapped in
// Coax (verse/gpu/layers.coax), the sheets texture.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";

SC_SIZE :: "320 180";
// The values past the tolerance a realm is allowed (pass-check --allow; 40 else), each for a reason
// of the GPUs', not the port's (both from the same Coax):
//   icecream       17 pixels one 8-bit step apart on one face
//   haunted-house  post_fs outlines where neighbouring depths differ by 0.00001 (depth's
//                  interpolation is each GPU's own), and the bloom spreads a flipped pixel
//   sandbox        its lights' brightest pixels 0.006 apart in the scene (their falloff's exp and
//                  pow: each GPU's precision), which the bloom spreads over 368 pixels, all within 0.010
sc_allow :: (name: string) -> string {
  if name == "icecream" { return "60"; }
  if name == "haunted-house" { return "200"; }
  if name == "sandbox" { return "800"; }
  return "40";
}
// host.js's bloom: each step its target, its source and its vec4f (x, y the direction, z the
// source's scale, w the pass), as verse/gpu/everglade-pass.coax's EP_BLOOM
SC_BLOOM :: [5] string.["q0 light 0 0 0 4", "q1 q0 1 0 1 1", "q0 q1 0 1 1 1", "e1 q0 1 0 1 2", "e0 e1 0 1 1 1"];

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 2 { tool_errln("usage: scene-pass HOST REALM [--allow N] [--keep DIR] [--live] [--emit DIR]"); return 2; }
  tb: [1024] u8;
  work := fs_temp("scene-pass-", tb[..]);
  if work.count == 0 { tool_errln("scene-pass: no temporary directory"); return 1; }
  emit := args_value(a[..], "--emit", "");
  status := sc_run(args_at(a[..], 0), args_at(a[..], 1), work, args_value(a[..], "--allow", sc_allow(args_at(a[..], 1))), args_value(a[..], "--keep", ""), emit, emit.count == 0 && !args_has(a[..], "--live"), args_value(a[..], "--upto", ""));
  r := fs_remove(work);
  return status;
}

sc_run :: (host: string, name: string, work: string, allow: string, keep: string, emit: string, int_hash: bool, upto: string) -> int {
  b: [12] [1024] u8; o: [65536] u8;
  dir := fs_join(work, "spec", b[0][..]);
  if !fs_mkdir(dir) { tool_errln("scene-pass: cannot make a directory"); return 1; }
  // the realm's module and assets, as realms.json gives them for its slug (else for the module)
  rj: [1048576] u8;
  rn := fs_read("apps/openagents-web/realms.json", rj[..]);
  if rn <= 0 { tool_errln("scene-pass: run it from the repository's root (no apps/openagents-web/realms.json)"); return 2; }
  json := cast(string) rj[0..<rn];
  realm := sc_field(json, "slug", name, "module");
  assets := ifx realm.count > 0 then sc_field(json, "slug", name, "assets") else sc_field(json, "module", name, "assets");
  if realm.count == 0 { realm = name; }
  index := sc_asset(assets, "index");
  particles := sc_asset(assets, "particles");
  pb: [1024] u8; pk: [1024] u8;
  pack := sc_asset(assets, "pack");
  if pack.count > 0 { pack = cat("apps/openagents-web", pack, pb[..]); }
  else if sc_asset(assets, "data").count > 0 {
    // separate files, made one pack
    pack = fs_join(work, "assets.pack", pb[..]);
    pf := [4] string.["coax/web/tool.sh", "verse/tools/pack-files.coax", name, pack];
    if fp_step_into("the pack", pf[..], o[..]) < 0 { return 1; }
  }
  // the browser's wasm with the site's libraries, and its frame
  lo: [8192] u8;
  la := [3] string.["verse/native/build.sh", "--libraries", realm];
  ln := fp_step_into("the libraries", la[..], lo[..]);
  if ln < 0 { return 1; }
  wasm := fs_join(work, cat(realm, ".wasm", b[1][..]), b[2][..]);
  build: [24] string; bn := 0;
  build[0] = "coax/web/wasm.sh"; build[1] = cat(cat("apps/openagents-web/", realm, b[3][..]), ".coax", b[4][..]);
  build[2] = cat(cat("apps/openagents-web/", realm, b[5][..]), "-face.c", b[6][..]); build[3] = wasm; bn = 4;
  libs := cast(string) lo[0..<ln];
  for k: 0..<sc_lines(libs) { l := sc_line(libs, k); if l.count > 0 && bn < 24 { build[bn] = l; bn += 1; } }
  if fp_step_into("the wasm", build[0..<bn], o[..]) < 0 { return 1; }
  frame := [16] string.["env", "VERSE_NATIVE_CLOCK_MS=0", "bun", "verse/native/wasm-run.ts", wasm, "--size", "320x180", "--frames", "90", "--every", "90", "--golden", "--dump", dir, "--pack", pack];
  if fp_step_into("the frame", frame[0..<ifx pack.count > 0 then 16 else 14], o[..]) < 0 { return 1; }
  // the modules the browser draws, the entries lowered
  gb: [1024] u8; wb: [1024] u8; pg: [1024] u8; pw: [1024] u8;
  gpu := cat(cat("apps/openagents-web/gpu/", realm, b[3][..]), ".coax", gb[..]);
  wgsl := cat(cat("apps/openagents-web/", realm, b[4][..]), ".wgsl", wb[..]);
  pgpu := "apps/openagents-web/gpu/particles.coax"; pwgsl := "apps/openagents-web/particles.wgsl";
  if int_hash {
    ih := fs_join(work, "int", b[5][..]);
    cmd := [5] string.["coax/web/tool.sh", "verse/gpu/int-hash.coax", ih, "--page", realm];
    if fp_step_into("the integer hash", cmd[..], o[..]) < 0 { return 1; }
    gpu = fs_join(ih, cat(realm, ".coax", b[6][..]), gb[..]);
    wgsl = fs_join(ih, cat(realm, ".wgsl", b[7][..]), wb[..]);
    if particles.count > 0 {
      ip := fs_join(work, "int-particles", b[8][..]);
      pc := [5] string.["coax/web/tool.sh", "verse/gpu/int-hash.coax", ip, "--page", "particles"];
      if fp_step_into("the particles' integer hash", pc[..], o[..]) < 0 { return 1; }
      pgpu = fs_join(ip, "particles.coax", pg[..]); pwgsl = fs_join(ip, "particles.wgsl", pw[..]);
    }
    print("scene-pass: %, one integer hash on both sides\n", realm);
  }
  if !sc_copy(wgsl, fs_join(dir, "page.wgsl", b[9][..])) { return 1; }
  page: [4194304] u8;
  pn := fs_read(wgsl, page[..]);
  code := cast(string) page[0..<ifx pn > 0 then pn else 0];
  post := sc_has(code, "fn post_fs(");
  if !sc_has(code, "fn scene_vs(") { tool_err("scene-pass: "); tool_err(realm); tool_errln(" has no scene_vs"); return 2; }
  shadows := sc_has(code, "fn shadow_vs(");
  if shadows && !sc_lower(dir, gpu, realm, "shadow_vs", "shadow_fs") { return 1; }
  // a traced scene's casters (vertex only: fx_fs, which reads group 0 alone, stands in for the
  // fragment entry a SPIR-V module carries) and grass
  casters := sc_has(code, "fn caster_vs(");
  if casters && !sc_lower_as(dir, gpu, realm, "caster_vs", "fx_fs", "caster") { return 1; }
  grassy := sc_has(code, "fn grass_vs(");
  if grassy && !sc_lower(dir, gpu, realm, "grass_vs", "grass_fs") { return 1; }
  traced := sc_has(code, "@builtin(frag_depth)");
  water := sc_has(code, "fn water_vs(");
  if water && (!sc_lower(dir, gpu, realm, "water_vs", "water_transmit_fs") || !sc_lower(dir, gpu, realm, "water_vs", "water_emit_fs")) { return 1; }
  if !sc_lower(dir, gpu, realm, "bg_vs", "bg_fs") || !sc_lower(dir, gpu, realm, "scene_vs", "scene_fs") || !sc_lower(dir, gpu, realm, "fx_vs", "fx_fs") { return 1; }
  if post && (!sc_lower(dir, gpu, realm, "bg_vs", "bloom_fs") || !sc_lower(dir, gpu, realm, "bg_vs", "post_fs")) { return 1; }
  // the frame's counts
  dt: [256] u8;
  dn := fs_read(fs_join(dir, "draws.txt", b[9][..]), dt[..]);
  words := cast(string) dt[0..<ifx dn > 0 then dn else 0];
  all := args_whole(sc_word(words, 0)); wet := args_whole(sc_word(words, 1)); sparks := args_whole(sc_word(words, 3));
  if !water { wet = 0; }
  hud := args_whole(sc_word(words, 4)); floats := args_whole(sc_word(words, 5));
  blades := ifx grassy then args_whole(sc_word(words, 2)) else 0;
  cv := ifx casters then args_whole(sc_word(words, 7)) else 0; ci := ifx casters then args_whole(sc_word(words, 8)) else 0;
  if blades < 0 || cv < 0 || ci < 0 { tool_errln("scene-pass: the frame does not say its blades and casters"); return 1; }
  if floats < 1 || floats > 32 { tool_errln("scene-pass: the frame does not say its vertices' floats"); return 1; }
  // no draws (/realms/built before a built realm arrives): bg and the HUD, as host.js draws them
  // the index: the pack's (wasm-run wrote it), the index asset, else none
  if pack.count == 0 && index.count > 0 && !sc_copy(cat("apps/openagents-web", index, b[10][..]), fs_join(dir, "index.bin", b[9][..])) { return 1; }
  if fs_kind(fs_join(dir, "index.bin", b[9][..])) <= 0 && !fs_write(fs_join(dir, "index.bin", b[9][..]), "\0\0\0\0") { return 1; }
  // the layers, decoded and mipmapped in Coax, at the first one's side
  lt: [8192] u8;
  ltn := fs_read(fs_join(dir, "layers.bin.list", b[9][..]), lt[..]);
  nlayers := 0;
  for k: 0..<sc_lines(cast(string) lt[0..<ifx ltn > 0 then ltn else 0]) { if sc_line(cast(string) lt[0..<ltn], k).count > 0 { nlayers += 1; } }
  side := ifx nlayers > 0 then sc_image_side(dir) else 0;
  if nlayers > 0 {
    if side <= 0 { tool_errln("scene-pass: the first layer's size is not readable"); return 1; }
    sw: [32] u8; sv: [1] Sp; sv[0] = Sp.{buf = sw[..]}; put_int(sv[..], side);
    ly := [5] string.["coax/web/tool.sh", "verse/gpu/layers.coax", fs_join(dir, "layers.bin.list", b[9][..]), fs_join(dir, "layers.bin", b[10][..]), cast(string) sw[0..<sv[0].n]];
    if fp_step_into("the layers", ly[..], o[..]) < 0 { return 1; }
  }
  fx := particles.count > 0 && sparks > 0;
  if fx {
    if !sc_copy(pwgsl, fs_join(dir, "particles.wgsl", b[9][..])) || !sc_lower(dir, pgpu, "particles", "particle_vs", "particle_fs") { return 1; }
  }
  // group 1's storage: the WGSL's names in their bindings' order, the stores in theirs
  names: [8] string; nn := sc_scene_storage(code, names[..]);
  sp: [8192] u8; sa: [1] Sp; sa[0] = Sp.{buf = sp[..]}; s := sa[..];
  sc_spec(s, all, wet, sparks, hud, floats, names[0..<nn], pack.count > 0, post, fx, sc_has(code, "var post_depth"), water && sc_has(code, "var water_scene"), shadows, side, nlayers, Traced.{casters = casters, cv = cv, ci = ci, grass = grassy, blades = blades, depth = traced});
  text := cast(string) sp[0..<s[0].n];
  if upto.count > 0 {
    ua: [256] u8; ub: [256] u8; text = sc_upto(text, cat(cat("pass ", upto, ua[..]), "_fs.spv ", ub[..]));
    if text.count == 0 { tool_err("scene-pass: the frame has no pass "); tool_errln(upto); return 2; }
  }
  if s[0].bad || !fs_write(fs_join(dir, "spec.txt", b[9][..]), text) { tool_errln("scene-pass: cannot write the spec"); return 1; }
  if emit.count > 0 {
    if !fs_mkdir(emit) && fs_kind(emit) <= 0 { tool_errln("scene-pass: cannot make the --emit directory"); return 1; }
    ed: [1024] u8;
    cp := [4] string.["cp", "-R", cat(dir, "/.", ed[..]), emit];
    if fp_step_into("the spec directory", cp[..], o[..]) < 0 { return 1; }
    print("scene-pass: %'s spec, modules and frame in %\n", realm, emit);
    return 0;
  }
  pc := [9] string.["coax/web/tool.sh", "verse/gpu/pass-check.coax", host, dir, "spec.txt", "--allow", allow, "--keep", keep];
  n := fp_step_into("the comparison", pc[0..<ifx keep.count > 0 then 9 else 7], o[..]);
  if n >= 0 { print("%\n", cast(string) o[0..<n]); }
  return ifx n >= 0 then 0 else 1;
}

// host.js's frame for a scene with these counts (see the header). NAMES are group 1's storage
// buffers in their bindings' order, the frame's stores s0, s1 ... in theirs.
// A traced scene's (the fixture's): its casters' vertices and instances, grass blades, and whether bg_fs writes the depth
Traced :: struct { casters: bool; cv: int; ci: int; grass: bool; blades: int; depth: bool; }
sc_spec :: (s: [] Sp, all: int, wet: int, sparks: int, hud: int, floats: int, names: [] string, vertices: bool, post: bool, fx: bool, post_depth: bool, copy: bool, shadows: bool, side: int, nlayers: int, tr: Traced) {
  put(s, "wgsl page.wgsl\nsize "); put(s, SC_SIZE);
  put(s, "\nlet all "); put_int(s, all); put(s, "\nlet scene "); put_int(s, all - wet); put(s, "\nlet sparks "); put_int(s, sparks); put(s, "\nlet hud "); put_int(s, hud);
  put(s, "\nbuffer u u.bin\n");
  // a pack's vertices first (host.js's storage asset), then the stores
  for k: 0..<names.count {
    put(s, "buffer "); put(s, names[k]);
    if vertices && k == 0 { put(s, " vertices.bin\n"); } else { put(s, " s"); put_int(s, ifx vertices then k - 1 else k); put(s, ".bin\n"); }
  }
  if all > 0 { put(s, "index index.bin\ndraws draws.bin $all\n"); }
  if nlayers > 0 {
    put(s, "layers sheets layers.bin "); put_int(s, side); put(s, " "); put_int(s, side); put(s, " "); put_int(s, nlayers);
    put(s, " "); put_int(s, sc_levels(side)); put(s, "\nsampler sheet linear repeat mip none\n");
  }
  // the shadow map: the scene's records, then the casters (host.js clears it, then draws both)
  scene_shadow := shadows && all > 0; casting := tr.casters;   // the map cleared even with none to cast, as host.js does
  if scene_shadow || casting { put(s, "depth shadow_map 2048 2048\nsampler shadow_cmp linear clamp flat less\n"); }
  if scene_shadow { put(s, "pass shadow_fs.spv shadow_vs shadow_fs 0 shadow_map 2 2 draws:0:$scene\n"); }
  if casting {
    put(s, "let cv "); put_int(s, tr.cv); put(s, "\nlet ci "); put_int(s, tr.ci);
    put(s, "\npass caster.spv caster_vs - 0 shadow_map 2 2 $cv:$ci"); if scene_shadow { put(s, " keep"); } put(s, "\n");
  }
  put(s, "depth scene_depth frame frame\n");
  into := "1";
  if post { put(s, "target light\ntarget aux\n"); into = "light,aux"; }
  // a traced bg_fs writes its depth (always passing), else bg draws under everything
  put(s, "pass bg_fs.spv bg_vs bg_fs "); put(s, into); put(s, ifx tr.depth then " scene_depth 0 0 3 always\n" else " scene_depth 0 0 3 always nowrite\n");
  if tr.grass {   // drawn live whenever there are blades (vk-realm sets $blades each frame)
    put(s, "let blades "); put_int(s, tr.blades); put(s, "\npass grass_fs.spv grass_vs grass_fs "); put(s, into); put(s, " scene_depth 0 0 3:$blades keep\n");
  }
  if all > 0 { put(s, "pass scene_fs.spv scene_vs scene_fs "); put(s, into); put(s, " scene_depth 0 0 draws:0:$scene keep\n"); }
  if wet > 0 {
    if copy { put(s, "target water_scene\ndepth water_scene_depth frame\ncopy light water_scene\ncopy scene_depth water_scene_depth\n"); }
    put(s, "each draws:$scene:$all\n");
    half := [2] string.["water_transmit_fs blend=mul", "water_emit_fs blend=add"];
    for h: half {
      put(s, "pass "); put(s, sc_word(h, 0)); put(s, ".spv water_vs "); put(s, sc_word(h, 0)); put(s, " "); put(s, into);
      put(s, " scene_depth 0 0 draws:each keep nowrite "); put(s, sc_word(h, 1)); put(s, " alpha=keep");
      if post { put(s, " mask=1"); }
      put(s, "\n");
    }
    put(s, "end\n");
  }
  if fx {
    put(s, "wgsl particles.wgsl\nbuffer emitters puffs.bin\n");
    put(s, "pass particle_fs.spv particle_vs particle_fs "); put(s, into); put(s, " scene_depth 0 0 6:$sparks keep nowrite blend=add alpha=add");
    if post { put(s, " mask=1"); }
    put(s, "\nwgsl page.wgsl\n");
  }
  if post {
    put(s, "target q0 /4\ntarget q1 /4\ntarget e0 /8\ntarget e1 /8");
    put(s, "\nsampler bloom_lin linear clamp flat none\nsampler post_lin linear clamp flat none\n");
    for k: 0..<SC_BLOOM.count {
      st := SC_BLOOM[k];
      put(s, "floats step"); put_int(s, k);
      for i: 2..<6 { put(s, " "); put(s, sc_word(st, i)); }
      put(s, "\npass bloom_fs.spv bg_vs bloom_fs "); put(s, sc_word(st, 0)); put(s, " - 0 0 3 bind=bloom_src:"); put(s, sc_word(st, 1));
      put(s, " bind=bloom_step:step"); put_int(s, k); put(s, "\n");
    }
    put(s, "pass post_fs.spv bg_vs post_fs 1 - 0 0 3 bind=post_light:light bind=post_quarter:q0 bind=post_eighth:e0 bind=post_aux:aux");
    if post_depth { put(s, " bind=post_depth:scene_depth"); }
    put(s, "\nbuffer hud hud.bin\npass fx_fs.spv fx_vs fx_fs 1 - 0 0 $hud keep blend=max alpha=max vertices=hud:"); put_int(s, floats); put(s, "\n");
  } else {
    // without post the strokes draw in the scene's pass: its depth there, always passing, not written
    put(s, "buffer hud hud.bin\npass fx_fs.spv fx_vs fx_fs 1 scene_depth 0 0 $hud keep always nowrite blend=max alpha=max vertices=hud:"); put_int(s, floats); put(s, "\n");
  }
}
#test "a scene's spec" {
  o: [8192] u8; sa: [1] Sp; sa[0] = Sp.{buf = o[..]}; s := sa[..];
  one := [1] string.["objects"];
  sc_spec(s, 2, 0, 0, 30, 16, one[..], false, false, false, false, false, false, 0, 0, Traced.{});
  #assert !s[0].bad && cast(string) o[0..<s[0].n] == "wgsl page.wgsl\nsize 320 180\nlet all 2\nlet scene 2\nlet sparks 0\nlet hud 30\nbuffer u u.bin\nbuffer objects s0.bin\nindex index.bin\ndraws draws.bin $all\ndepth scene_depth frame frame\npass bg_fs.spv bg_vs bg_fs 1 scene_depth 0 0 3 always nowrite\npass scene_fs.spv scene_vs scene_fs 1 scene_depth 0 0 draws:0:$scene keep\nbuffer hud hud.bin\npass fx_fs.spv fx_vs fx_fs 1 scene_depth 0 0 $hud keep always nowrite blend=max alpha=max vertices=hud:16\n";
  p: [8192] u8; sp: [1] Sp; sp[0] = Sp.{buf = p[..]};
  two := [2] string.["heights", "objects"];
  sc_spec(sp[..], 6, 0, 384, 30, 16, two[..], false, true, true, false, false, false, 0, 0, Traced.{});
  t := cast(string) p[0..<sp[0].n];
  #assert !sp[0].bad && sc_line(t, 8) == "buffer objects s1.bin" && sc_line(t, 12) == "target light";
  #assert sc_line(t, 14) == "pass bg_fs.spv bg_vs bg_fs light,aux scene_depth 0 0 3 always nowrite";
  #assert sc_line(t, 18) == "pass particle_fs.spv particle_vs particle_fs light,aux scene_depth 0 0 6:$sparks keep nowrite blend=add alpha=add mask=1";
  #assert sc_line(t, 19) == "wgsl page.wgsl" && sc_line(t, sc_lines(t) - 1) == "pass fx_fs.spv fx_vs fx_fs 1 - 0 0 $hud keep blend=max alpha=max vertices=hud:16";
  w: [8192] u8; sw: [1] Sp; sw[0] = Sp.{buf = w[..]};
  three := [3] string.["heights", "objects", "water_nodes"];
  sc_spec(sw[..], 6, 1, 0, 30, 16, three[..], false, true, false, false, false, false, 0, 0, Traced.{});
  x := cast(string) w[0..<sw[0].n];
  #assert !sw[0].bad && sc_line(x, 1) == "size 320 180" && sc_line(x, 3) == "let scene 5" && sc_line(x, 17) == "each draws:$scene:$all";
  #assert sc_line(x, 18) == "pass water_transmit_fs.spv water_vs water_transmit_fs light,aux scene_depth 0 0 draws:each keep nowrite blend=mul alpha=keep mask=1";
  #assert sc_line(x, 19) == "pass water_emit_fs.spv water_vs water_emit_fs light,aux scene_depth 0 0 draws:each keep nowrite blend=add alpha=keep mask=1" && sc_line(x, 20) == "end";
  h: [8192] u8; sh: [1] Sp; sh[0] = Sp.{buf = h[..]};
  four := [3] string.["vertices", "objects", "lights"];
  sc_spec(sh[..], 63, 0, 0, 30, 16, four[..], true, true, false, true, false, true, 512, 12, Traced.{});
  y := cast(string) h[0..<sh[0].n];
  #assert !sh[0].bad && sc_line(y, 7) == "buffer vertices vertices.bin" && sc_line(y, 8) == "buffer objects s0.bin" && sc_line(y, 9) == "buffer lights s1.bin";
  #assert sc_line(y, 12) == "layers sheets layers.bin 512 512 12 10" && sc_line(y, 13) == "sampler sheet linear repeat mip none";
  #assert sc_line(y, 16) == "pass shadow_fs.spv shadow_vs shadow_fs 0 shadow_map 2 2 draws:0:$scene" && sc_line(y, 17) == "depth scene_depth frame frame";
  #assert sc_has(y, " bind=post_depth:scene_depth\n");
  f: [8192] u8; sf: [1] Sp; sf[0] = Sp.{buf = f[..]};
  two2 := [2] string.["vertices", "objects"];
  sc_spec(sf[..], 10, 0, 0, 30, 16, two2[..], true, true, false, false, false, false, 512, 4, Traced.{casters = true, cv = 36, ci = 5, grass = true, blades = 900, depth = true});
  z := cast(string) f[0..<sf[0].n];
  #assert !sf[0].bad && sc_has(z, "\nlet cv 36\nlet ci 5\npass caster.spv caster_vs - 0 shadow_map 2 2 $cv:$ci\n");
  #assert sc_has(z, "pass bg_fs.spv bg_vs bg_fs light,aux scene_depth 0 0 3 always\nlet blades 900\npass grass_fs.spv grass_vs grass_fs light,aux scene_depth 0 0 3:$blades keep\n");
  #assert sc_line(t, sc_lines(t) - 3) == "pass post_fs.spv bg_vs post_fs 1 - 0 0 3 bind=post_light:light bind=post_quarter:q0 bind=post_eighth:e0 bind=post_aux:aux";
}

// The spec up to and with its first line that starts `start`, "" if none does.
sc_upto :: (spec: string, start: string) -> string {
  i := 0;
  while i < spec.count {
    j := i;
    while j < spec.count && spec[j] != '\n' { j += 1; }
    if j - i >= start.count && spec[i..<i + start.count] == start { return spec[0..<ifx j < spec.count then j + 1 else j]; }
    i = j + 1;
  }
  return "";
}
#test "a spec cut short" {
  t := "size 1 1\npass bg_fs.spv a\npass scene_fs.spv b\npass fx_fs.spv c\n";
  #assert sc_upto(t, "pass scene_fs.spv ") == "size 1 1\npass bg_fs.spv a\npass scene_fs.spv b\n" && sc_upto(t, "pass x_fs.spv ") == "";
}

// The read-only storage buffers the WGSL binds in group 1 before its bloom and post groups (the
// scene's: host.js's sceneLayout), in their bindings' order: their count, their names in out.
sc_scene_storage :: (code: string, out: [] string) -> int {
  pre := "@group(1) @binding(";
  mid := ") var<storage, read> ";
  at: [8] string; seen := 0;
  i := 0;
  while i + pre.count < code.count {
    if code[i..<i + pre.count] == pre {
      j := i + pre.count; k := 0;
      while j < code.count && code[j] >= '0' && code[j] <= '9' { k = k * 10 + cast(int) code[j] - 48; j += 1; }
      if j + mid.count <= code.count && code[j..<j + mid.count] == mid && k < at.count {
        e := j + mid.count; f := e;
        while f < code.count && (code[f] == '_' || (code[f] >= 'a' && code[f] <= 'z') || (code[f] >= '0' && code[f] <= '9')) { f += 1; }
        if at[k].count == 0 { at[k] = code[e..<f]; if k + 1 > seen { seen = k + 1; } }
      }
    }
    i += 1;
  }
  n := 0;
  for k: 0..<seen { if at[k].count == 0 { break; } if n < out.count { out[n] = at[k]; n += 1; } }
  return n;
}
#test "group 1's storage" {
  c := "@group(1) @binding(1) var<storage, read> objects: array<f32>;\n@group(1) @binding(0) var<storage, read> heights: array<f32>;\n@group(1) @binding(0) var bloom_src: texture_2d<f32>;\n@group(1) @binding(2) var<uniform> bloom_step: vec4f;\n";
  o: [8] string;
  #assert sc_scene_storage(c, o[..]) == 2 && o[0] == "heights" && o[1] == "objects";
  #assert sc_scene_storage("", o[..]) == 0;
}

// In realms.json, the realm whose `key` is `value` (a slug, a module): its `field`'s text, a string's
// inside its quotes, a list's inside its brackets ("" when there is none). A realm's fields run to
// the next realm's slug.
sc_field :: (json: string, key: string, value: string, field: string) -> string {
  kb: [256] u8; kn := 0;
  for c: "\"" { kb[kn] = c; kn += 1; }
  for c: key { if kn < 60 { kb[kn] = c; kn += 1; } }
  for c: "\": \"" { kb[kn] = c; kn += 1; }
  for c: value { if kn < 250 { kb[kn] = c; kn += 1; } }
  kb[kn] = '"'; kn += 1;
  k := cast(string) kb[0..<kn];
  fb: [128] u8; fn := 0;
  for c: "\"" { fb[fn] = c; fn += 1; }
  for c: field { if fn < 120 { fb[fn] = c; fn += 1; } }
  for c: "\": " { fb[fn] = c; fn += 1; }
  f := cast(string) fb[0..<fn];
  i := 0;
  while i + k.count <= json.count {
    if json[i..<i + k.count] == k {
      // back to this realm's slug, then forward to the next one's
      start := i;
      while start > 0 && !(start + 8 <= json.count && json[start..<start + 8] == "\"slug\": ") { start -= 1; }
      j := start + 1;
      while j + f.count <= json.count && !(j + 8 <= json.count && json[j..<j + 8] == "\"slug\": ") {
        if json[j..<j + f.count] == f {
          e := j + f.count;
          close: u8 = ifx json[e] == '[' then ']' else '"';
          e += 1; g := e;
          while g < json.count && json[g] != close { g += 1; }
          return json[e..<g];
        }
        j += 1;
      }
      return "";
    }
    i += 1;
  }
  return "";
}
// The URL of the first asset of `kind` in an assets list ("index:/realms/x/X.indices" gives
// "/realms/x/X.indices"), "" for none.
sc_asset :: (list: string, kind: string) -> string {
  i := 0;
  while i < list.count {
    if list[i] == '"' {
      j := i + 1;
      while j < list.count && list[j] != '"' { j += 1; }
      entry := list[i + 1..<j];
      if entry.count > kind.count && entry[0..<kind.count] == kind && entry[kind.count] == ':' { return entry[kind.count + 1..<entry.count]; }
      i = j + 1;
    } else { i += 1; }
  }
  return "";
}
#test "the realm's fields" {
  j := "{ \"slug\": \"hecates-cemetery\", \"module\": \"villa\", \"golden\": { \"lit\": 1 }, \"assets\": [\"index:/realms/h/Villa.indices\", \"particles:/particles.wgsl\"] } { \"slug\": \"belt-2200\", \"module\": \"belt\", \"assets\": [] }";
  v := sc_field(j, "module", "villa", "assets");
  #assert sc_asset(v, "index") == "/realms/h/Villa.indices" && sc_asset(v, "particles") == "/particles.wgsl" && sc_asset(v, "pack") == "";
  #assert sc_field(j, "module", "belt", "assets") == "" && sc_field(j, "module", "none", "assets") == "";
  #assert sc_field(j, "slug", "hecates-cemetery", "module") == "villa" && sc_field(j, "slug", "belt-2200", "module") == "belt" && sc_field(j, "slug", "villa", "module") == "";
}

// The first layer image's width (host.js sizes every layer to it), from its header: PNG's IHDR or
// JPEG's SOF (verse/gpu/everglade-pass.coax's ep_image_side).
sc_image_side :: (dir: string) -> int {
  b: [1024] u8; img: [16777216] u8;
  m := fs_read(fs_join(dir, "layer-0.img", b[..]), img[..]);
  if m < 0 { return -1; }
  return sc_width(cast(string) img[0..<m]);
}
sc_width :: (img: string) -> int {
  if img.count >= 24 && img[0] == 0x89 && img[1] == 'P' && img[2] == 'N' && img[3] == 'G' {
    return (cast(int) img[16] << 24) | (cast(int) img[17] << 16) | (cast(int) img[18] << 8) | cast(int) img[19];
  }
  if img.count < 4 || img[0] != 0xff || img[1] != 0xd8 { return -1; }
  i := 2;
  while i + 9 <= img.count && img[i] == 0xff {
    marker := img[i + 1];
    if marker == 0xc0 || marker == 0xc1 || marker == 0xc2 { return (cast(int) img[i + 7] << 8) | cast(int) img[i + 8]; }
    i += 2 + ((cast(int) img[i + 2] << 8) | cast(int) img[i + 3]);
  }
  return -1;
}
sc_levels :: (side: int) -> int { n := 1; v := side; while v > 1 { v /= 2; n += 1; } return n; }
#test "an image's width and its levels" {
  jpg := [17] u8.[0xff, 0xd8, 0xff, 0xe0, 0, 4, 'a', 'b', 0xff, 0xc0, 0, 17, 8, 1, 0, 1, 0];
  #assert sc_width(cast(string) jpg[..]) == 256 && sc_width("") == -1 && sc_levels(512) == 10 && sc_levels(1) == 1;
}

sc_has :: (text: string, what: string) -> bool {
  if text.count < what.count { return false; }
  for i: 0..<text.count - what.count + 1 { if text[i..<i + what.count] == what { return true; } }
  return false;
}

// REALM_VS and REALM_FS of gpu lowered to DIR/FS.spv, the bindings coax spirv reports beside it.
sc_lower :: (dir: string, gpu: string, realm: string, vs: string, fs_: string) -> bool { return sc_lower_as(dir, gpu, realm, vs, fs_, fs_); }
// The same into NAME.spv: a vertex-only pass's module (its fragment entry is never a stage)
sc_lower_as :: (dir: string, gpu: string, realm: string, vs: string, fs_: string, name: string) -> bool {
  b: [4] [1024] u8; o: [65536] u8; v: [256] u8; f: [256] u8; nb: [256] u8; p: [256] u8;
  spv := fs_join(dir, cat(name, ".spv", nb[..]), b[0][..]);
  pre := cat(realm, "_", p[..]);
  argv := [9] string.["coax/bin/coax", "spirv", gpu, "--vertex", cat(pre, vs, v[..]), "--fragment", cat(pre, fs_, f[..]), "-o", spv];
  err: [65536] u8;
  r := proc_run(argv[..], 900000, o[..], err[..]);
  if r.started != 0 || r.status != 0 || r.timed_out { tool_err(cast(string) err[0..<r.err_n]); tool_errln("scene-pass: the lowering failed"); return false; }
  return fs_write(cat(spv, ".bindings", b[1][..]), cast(string) err[0..<r.err_n]);
}

// A file copied whole, whatever its size.
sc_copy :: (from: string, to: string) -> bool {
  o: [256] u8; e: [4096] u8;
  argv := [3] string.["cp", from, to];
  r := proc_run(argv[..], 60000, o[..], e[..]);
  if r.started != 0 || r.status != 0 || r.timed_out { tool_err(cast(string) e[0..<r.err_n]); tool_err("scene-pass: cannot copy "); tool_errln(from); return false; }
  return true;
}

// Runs argv: the length of its stdout in out, or -1 (printed with its stderr) when it fails.
fp_step_into :: (what: string, argv: [] string, out: [] u8) -> int {
  err: [65536] u8;
  r := proc_run(argv, 900000, out, err[..]);
  if r.started != 0 || r.status != 0 || r.timed_out {
    if r.out_n > 0 { print("%\n", cast(string) out[0..<r.out_n]); }
    tool_err(cast(string) err[0..<r.err_n]);
    tool_err("scene-pass: "); tool_err(what); tool_errln(" failed");
    return -1;
  }
  return r.out_n;
}

// ---- text (pure)
Sp :: struct { buf: [] u8; n: int; bad: bool; }
put :: (s: [] Sp, t: string) {
  if s[0].n + t.count > s[0].buf.count { s[0].bad = true; return; }
  for i: 0..<t.count { s[0].buf[s[0].n + i] = t[i]; }
  s[0].n += t.count;
}
put_int :: (s: [] Sp, v: int) {
  d: [24] u8; n := 0; x := ifx v < 0 then -v else v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast,trunc(u8) (48 + x % 10); x /= 10; n += 1; }
  if v < 0 { put(s, "-"); }
  for i: 0..<n { e := [1] u8.[d[n - 1 - i]]; put(s, cast(string) e[..]); }
}
cat :: (x: string, y: string, out: [] u8) -> string {
  if x.count + y.count > out.count { return ""; }
  for i: 0..<x.count { out[i] = x[i]; }
  for i: 0..<y.count { out[x.count + i] = y[i]; }
  return cast(string) out[0..<x.count + y.count];
}
// The k-th space-separated word of a line, "" past the last.
sc_word :: (line: string, k: int) -> string {
  i := 0; w := 0;
  while i < line.count {
    while i < line.count && (line[i] == ' ' || line[i] == '\n') { i += 1; }
    j := i;
    while j < line.count && line[j] != ' ' && line[j] != '\n' { j += 1; }
    if j > i { if w == k { return line[i..<j]; } w += 1; }
    i = j;
  }
  return "";
}
sc_lines :: (text: string) -> int {
  n := 0;
  for i: 0..<text.count { if text[i] == '\n' { n += 1; } }
  return ifx text.count > 0 && text[text.count - 1] != '\n' then n + 1 else n;
}
sc_line :: (text: string, k: int) -> string {
  i := 0; n := 0;
  while i <= text.count {
    j := i;
    while j < text.count && text[j] != '\n' { j += 1; }
    if n == k { return text[i..<j]; }
    n += 1; i = j + 1;
  }
  return "";
}
#test "words and lines" {
  #assert sc_word("2 0 0 384 30 16 0", 3) == "384" && sc_word("a", 1) == "" && sc_lines("a\nb\n") == 2 && sc_line("a\nb\n", 1) == "b";
}
