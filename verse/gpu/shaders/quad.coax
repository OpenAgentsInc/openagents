// A first shader through `coax spirv --vertex quad_vs --fragment quad_fs`:
// a full-screen triangle whose fragments read a storage buffer of colors,
// a texture and the uniforms. verse/gpu/shader-check.sh draws it.
#load "../shader.coax";

QuadOut :: struct {position:V4; uv:V2; band:u32;}

quad_vs :: (vid:u32,iid:u32,uniforms:[]f32)->QuadOut {
  x:=cast(f32)((vid<<1)&2);y:=cast(f32)(vid&2);
  return QuadOut.{position=v4(x*2-1,y*2-1,0,1),uv=v2(x,y),band=vid};
}
// The band of the screen a fragment is in: 0 to 3 across, by a loop that breaks.
band_of :: (u:f32)->s32 {
  b:s32=0;
  for i:0..<4 {
    if u<cast(f32)(i+1)*0.25f32 {break;}
    b+=1;
  }
  return b;
}
quad_fs :: (in:QuadOut,front:bool,colors:[]V4,uniforms:[]f32,image:Tex2D,smooth:Sampler)->V4 #export_c {
  b:=band_of(in.uv.x);
  c:=colors[cast(int)b];
  t:=gpu_sample(image,smooth,in.uv);
  k:=uniforms[0];
  if in.uv.y>0.9f32 && !front {gpu_discard();}
  return v4(mix(c.x,t.x,k),mix(c.y,t.y,k),mix(c.z,t.z,k),1);
}

#test "the band is the quarter across" {
  #assert band_of(0.1f32)==0 && band_of(0.3f32)==1 && band_of(0.99f32)==3;
}
