// Reusable engine HUD slots: content supplies action IDs and platform glyphs;
// the engine owns the safe-area-aware hotbar geometry and hit areas.
// The logical module verse.hud owns this file and the two it loads. Its
// public API is the list below: the two packet types and the native HUD
// functions. The HUD_* constants stay private (the functions return them).
#module "verse.hud";
#export HudRect, HudPoint, verse_hud_slot;
#export verse_hud_frame_point, verse_hud_frame_arm, verse_hud_tone, verse_hud_cut, verse_hud_outline, verse_hud_arm_down;
#load "hud/types.coax";
#load "hud/frame.coax";
#test "hotbar fits a narrow phone and stays above the home indicator" {
 b:=verse_hud_slot(320,700,34,0,6);z:=verse_hud_slot(320,700,34,5,6);
 #assert b.x>=8 && z.x+z.width<=312 && b.y+b.height<=654;
}
#test "slots stay separate in landscape" {
 a:=verse_hud_slot(900,420,21,0,6);b:=verse_hud_slot(900,420,21,1,6);
 #assert a.x+a.width<b.x && a.width>=44;
}
verse_hud_slot :: (width:f32,height:f32,bottom:f32,index:int,count:int)->HudRect #export_c {
 out:HudRect;if count<1 || count>12 || index<0 || index>=count || width<100{return out;}
 size:=44.0f32;gap:=6.0f32;total:=cast(f32)count*(size+gap)-gap;
 if total>width-16 {size=(width-16-gap*cast(f32)(count-1))/cast(f32)count;total=width-16;}
 out.x=(width-total)*0.5+cast(f32)index*(size+gap);out.y=height-bottom-size-12;out.width=size;out.height=size;return out;
}
