// Ice Cream Man's third-person view, from ~/work/aethyr-demo/src/icecream/
// camera.cpp (the Rust build's camera.rs): a boom from the kid's head that
// tilts down to stay under the ceiling, pulled in short of every wall,
// piece of furniture, doorway lintel, the floor and the ceiling by a sphere
// swept along it. With the drag (orbit), the wheel, Shift Lock over the right
// shoulder, V between first and third person, and the boom's easing.
//   coax/bin/coax test verse/icecream/camera.coax --library
#load "mesh.coax";

CAM_MIN_ZOOM :: 0.5f32;
CAM_MAX_ZOOM :: 8.0f32;
CAM_FIRST_PERSON :: 0.9f32;
CAM_HEAD :: 1.2f32;            // kEyeHeight: third person pivots here
CAM_HEADROOM :: 0.3f32;
CAM_FLOOR :: 0.35f32;
CAM_RADIUS :: 0.2f32;
CAM_MARGIN :: 0.08f32;
CAM_THIRD_PERSON :: 4.5f32;    // the zoom a run starts with
MAX_BOXES :: MAX_BLOCKS + 2 * MAX_ROOMS;

Box3 :: struct { min: V3; max: V3; }
axis_of :: (v: V3, i: int) -> f32 { return ifx i == 0 then v.x else ifx i == 1 then v.y else v.z; }
// Where along a to b (0 to 1) the segment enters the box grown by r; < 0 if
// it misses or starts inside.
sweep :: (box: Box3, a: V3, b: V3, r: f32) -> f32 {
  lo := v3(box.min.x - r, box.min.y - r, box.min.z - r);
  hi := v3(box.max.x + r, box.max.y + r, box.max.z + r);
  if a.x >= lo.x && a.y >= lo.y && a.z >= lo.z && a.x <= hi.x && a.y <= hi.y && a.z <= hi.z { return -1; }
  d := v3sub(b, a);
  low: f32 = 0;
  high: f32 = 1;
  for i: 0..<3 {
    ai := axis_of(a, i); di := axis_of(d, i); mn := axis_of(lo, i); mx := axis_of(hi, i);
    if abs(di) < 0.000000001 {
      if ai < mn || ai > mx { return -1; }
    } else {
      t0 := (mn - ai) / di;
      t1 := (mx - ai) / di;
      if t0 > t1 { swap := t0; t0 = t1; t1 = swap; }
      low = cmax(low, t0);
      high = cmin(high, t1);
      if low > high { return -1; }
    }
  }
  return low;
}

// What the camera can bump: every wall, piece of furniture and doorway
// lintel as a box, and the floor and ceiling.
Space :: struct { boxes: [MAX_BOXES] Box3; n: int; ceiling: f32 = WALL_HEIGHT; }
space_of :: (g: [] Game, s: [] Space) {
  h := g[0].house;
  s[0].n = 0;
  for i: 0..<h.block_n {
    b := h.blocks[i];
    s[0].boxes[s[0].n] = Box3.{min = v3(b.min.x, 0, b.min.z), max = v3(b.max.x, b.height, b.max.z)};
    s[0].n += 1;
  }
  two: f32 = 2.0;
  for i: 0..<h.room_n {
    room := h.rooms[i];
    for k: 0..<2 {
      side := ifx k == 0 then Side.south else Side.east;
      if !room.doors[cast(int) side] { continue; }
      nb := neighbour(g, room.at, side);
      if cell_eq(nb, NO_CELL) { continue; }
      mid := doorway(room.at, nb);
      along_x := side == Side.south;
      hx := ifx along_x then DOOR / two else WALL / two;
      hz := ifx along_x then WALL / two else DOOR / two;
      s[0].boxes[s[0].n] = Box3.{min = v3(mid.x - hx, DOOR_HEIGHT, mid.z - hz), max = v3(mid.x + hx, WALL_HEIGHT, mid.z + hz)};
      s[0].n += 1;
    }
  }
  s[0].ceiling = WALL_HEIGHT;
}
space_cast :: (s: [] Space, a: V3, b: V3, r: f32) -> f32 {
  t: f32 = 1;
  d := v3sub(b, a);
  top := s[0].ceiling - r;
  if b.y > top && a.y < top && abs(d.y) > 0.000000001 { t = cmin(t, (top - a.y) / d.y); }
  if b.y < r && a.y > r && abs(d.y) > 0.000000001 { t = cmin(t, (r - a.y) / d.y); }
  for i: 0..<s[0].n {
    hit := sweep(s[0].boxes[i], a, b, r);
    if hit >= 0 { t = cmin(t, hit); }
  }
  return cmax(t, 0.0);
}

View :: struct { eye: V3; target: V3; first_person: bool; }
Rig :: struct { pivot: V3; back: V3; look: V3; rise: f32; want: f32; safe: f32; first_person: bool; }
rig_dir :: (s: [] Space, r: Rig, length0: f32) -> V3 {
  length := cmax(length0, 0.001);
  top := cmax(s[0].ceiling - CAM_HEADROOM, CAM_FLOOR);
  y := cmin(length * r.rise, top - r.pivot.y);
  y = cmax(y, CAM_FLOOR - r.pivot.y);
  y = clampf(y, -length * 0.95, length * 0.95);
  flat := sqrt(length * length - y * y);
  one: f32 = 1.0;
  return v3mul(v3add(v3mul(r.back, flat), v3mul(TN_Y, y)), one / length);
}
rig_reach :: (s: [] Space, r: Rig, length: f32) -> f32 {
  end := v3add(r.pivot, v3mul(rig_dir(s, r, length), length));
  return space_cast(s, r.pivot, end, CAM_RADIUS) * length;
}
rig_clear :: (s: [] Space, r: Rig, length: f32) -> f32 {
  reach := rig_reach(s, r, length);
  return ifx reach >= length - 0.0001 then length else cmax(reach - CAM_MARGIN, 0.0);
}
rig_view :: (s: [] Space, r: Rig, boom: f32) -> View {
  if r.first_person { return View.{eye = r.pivot, target = v3add(r.pivot, r.look), first_person = true}; }
  length := rig_clear(s, r, clampf(boom, 0, r.safe));
  d := rig_dir(s, r, length);
  eye := v3add(r.pivot, v3mul(d, length));
  return View.{eye = eye, target = v3sub(eye, d)};
}

// Boom smooths the boom's length: it snaps in at once (never through a
// wall) and eases back out slowly.
CAM_CLOSE :: 0.6f32;           // under this boom the kid isn't drawn
CAM_EASE_OUT :: 3.0f32;
CAM_MIN_PITCH :: -0.6f32;
CAM_MAX_PITCH :: 1.2f32;
CAM_SHOULDER :: 0.7f32;
Boom :: struct { has: bool; length: f32; }
boom_follow :: (b: Boom, r: Rig, step: f32) -> Boom {
  next: f32 = 0;
  if r.first_person { next = 0; }
  else if !b.has || r.safe <= b.length { next = r.safe; }
  else { next = b.length + (r.safe - b.length) * (1 - exp(-CAM_EASE_OUT * step)); }
  return Boom.{has = true, length = next};
}
boom_close :: (b: Boom) -> bool { return b.has && b.length < CAM_CLOSE; }

// The camera: its yaw (0 looks toward +z), its pitch below the horizon, its
// zoom (first person under CAM_FIRST_PERSON), Shift Lock and the zoom to go
// back to from first person.
Camera :: struct { yaw: f32 = 3.14159265; pitch: f32 = 0.35; zoom: f32 = CAM_THIRD_PERSON; shift_lock: bool; third: f32 = CAM_THIRD_PERSON; }
// atan on [0, 1], within 2e-5 rad (verse/space.coax's).
atan_unit :: (t: f32) -> f32 {
  q := t * t;
  return t * (0.99997726 + q * (-0.33262347 + q * (0.19354346 + q * (-0.11643287 + q * (0.05265332 + q * -0.01172120)))));
}
// The angle of (x, y) from +X, in [-PI, PI]; 0 for the origin.
arctan2 :: (y: f32, x: f32) -> f32 {
  ax := abs(x); ay := abs(y);
  if ax == 0 && ay == 0 { return 0; }
  half: f32 = 2;
  a := ifx ay > ax then PI_F / half - atan_unit(ax / ay) else atan_unit(ay / ax);
  if x < 0 { a = PI_F - a; }
  if y < 0 { a = -a; }
  return a;
}
yaw_of :: (d: V2) -> f32 { return arctan2(d.x, d.z); }
camera_facing :: (f: V2) -> Camera { c: Camera; if len2(f) > 0 { c.yaw = yaw_of(f); } return c; }
cam_forward :: (c: Camera) -> V2 { return v2(sin(c.yaw), cos(c.yaw)); }
cam_right :: (c: Camera) -> V2 { f := cam_forward(c); return v2(-f.z, f.x); }
cam_walk :: (c: Camera, ahead: f32, side: f32) -> V2 { return clamp2(vadd(vmul(cam_forward(c), ahead), vmul(cam_right(c), side)), 1); }
cam_orbit :: (c: Camera, dx: f32, dy: f32) -> Camera {
  o := c;
  o.yaw -= dx * 0.006;
  o.pitch = clampf(c.pitch + dy * 0.005, CAM_MIN_PITCH, CAM_MAX_PITCH);
  return o;
}
cam_wheel :: (c: Camera, delta: f32) -> Camera {
  o := c;
  hundred: f32 = 100;
  o.zoom = clampf(c.zoom * pow(1.1, delta / hundred), CAM_MIN_ZOOM, CAM_MAX_ZOOM);
  return o;
}
cam_first_person :: (c: Camera) -> bool { return c.zoom < CAM_FIRST_PERSON; }
// V: first person to third and back; the new camera.
cam_toggle_view :: (c: Camera) -> Camera {
  o := c;
  if cam_first_person(c) {
    o.zoom = cmax(c.third, CAM_FIRST_PERSON + 1);
    if o.pitch < 0.1 { o.pitch = 0.3; }
  } else {
    o.third = c.zoom;
    o.zoom = CAM_MIN_ZOOM;
    o.pitch = cmin(c.pitch, 0.15);
  }
  return o;
}
cam_aims :: (c: Camera) -> bool { return c.shift_lock || cam_first_person(c); }
cam_look :: (c: Camera) -> V3 { return v3(cos(c.pitch) * sin(c.yaw), -sin(c.pitch), cos(c.pitch) * cos(c.yaw)); }
cam_rig :: (c: Camera, at: V2, feet: f32, s: [] Space) -> Rig {
  head := v3(at.x, feet + CAM_HEAD, at.z);
  b := cam_forward(c);
  r := Rig.{pivot = head, back = v3(-b.x, 0, -b.z), rise = sin(c.pitch), look = cam_look(c), first_person = cam_first_person(c)};
  if r.first_person { return r; }
  if c.shift_lock {
    rt := cam_right(c);
    shoulder := v3add(v3mul(v3(rt.x, 0, rt.z), CAM_SHOULDER * 0.6), v3mul(TN_Y, 0.1));
    length := sqrt(v3dot(shoulder, shoulder));
    t := space_cast(s, head, v3add(head, shoulder), CAM_RADIUS);
    r.pivot = v3add(r.pivot, v3mul(shoulder, cmax(t * length - CAM_MARGIN, 0.0) / length));
  }
  r.want = clampf(c.zoom, CAM_FIRST_PERSON, CAM_MAX_ZOOM);
  // Pull in until the boom's own (steeper, shorter) line is clear.
  length := r.want;
  for i: 0..<6 {
    cl := rig_clear(s, r, length);
    if cl >= length { break; }
    length = cl;
  }
  r.safe = rig_clear(s, r, length);
  return r;
}
cam_view :: (c: Camera, at: V2, feet: f32, s: [] Space) -> View {
  r := cam_rig(c, at, feet, s);
  return rig_view(s, r, r.safe);
}
// The vertical field of view: wider on a tall screen.
cam_fov :: (aspect: f32) -> f32 { d: f32 = 180.0; return (ifx aspect < 1 then 70.0f32 else 60.0f32) * 3.14159265 / d; }

// Where a ray from eye along dir meets the plane y = height, if it goes that way.
Hit2 :: struct { ok: bool; at: V2; }
ray_to_height :: (eye: V3, dir: V3, height: f32) -> Hit2 {
  no: Hit2;
  if abs(dir.y) < 0.00001 { return no; }
  t := (height - eye.y) / dir.y;
  if t <= 0 { return no; }
  return Hit2.{ok = true, at = v2(eye.x + dir.x * t, eye.z + dir.z * t)};
}

// ---- checks ----

#test "a sweep enters a box, misses it, or starts inside" {
  b := Box3.{min = v3(0, 0, 0), max = v3(2, 2, 2)};
  #assert sweep(b, v3(-1, 1, 1), v3(3, 1, 1), 0) == 0.25;
  #assert sweep(b, v3(-1, 5, 1), v3(3, 5, 1), 0) < 0;
  #assert sweep(b, v3(1, 1, 1), v3(3, 1, 1), 0) < 0;
  #assert sweep(b, v3(-2, 1, 1), v3(2, 1, 1), 0.5) == 0.375;
}

#test "orbit, the wheel and V keep their bounds" {
  c: Camera;
  c = cam_orbit(c, 0, 100000);
  #assert c.pitch == CAM_MAX_PITCH;
  c = cam_wheel(c, 3000);
  #assert c.zoom == CAM_MAX_ZOOM;
  c = cam_toggle_view(c);
  #assert cam_first_person(c) && cam_aims(c) && c.third == CAM_MAX_ZOOM;
  c = cam_toggle_view(c);
  #assert !cam_first_person(c) && c.zoom == CAM_MAX_ZOOM;
  w := cam_walk(c, 1, 1);
  #assert abs(len2(w) - 1) < 0.001;
  b: Boom;
  r: Rig;
  r.safe = 3;
  b = boom_follow(b, r, 0.016);
  #assert b.length == 3;
  r.safe = 5;
  b = boom_follow(b, r, 0.016);
  #assert b.length > 3 && b.length < 3.2;
  r.safe = 1;
  b = boom_follow(b, r, 0.016);
  #assert b.length == 1 && !boom_close(b);
}

#test "the start view: behind the kid's head, under the ceiling, inside the house" {
  games: [1] Game;
  g := games[..];
  game_new(g, 3, false, tuning_for(Difficulty.normal));
  spaces: [1] Space;
  s := spaces[..];
  space_of(g, s);
  #assert s[0].n > g[0].house.block_n;
  c := camera_facing(g[0].player.facing);
  at := g[0].player.pos;
  v := cam_view(c, at, g[0].player.height, s);
  #assert !v.first_person && v.eye.y <= WALL_HEIGHT - CAM_HEADROOM + 0.001 && v.eye.y >= CAM_HEAD;
  back := v2(v.eye.x - at.x, v.eye.z - at.z);
  #assert dot2(back, g[0].player.facing) < 0 && len2(back) <= CAM_THIRD_PERSON;
  #assert room_of(g, v2(v.eye.x, v.eye.z)) == room_of(g, at);
  d := v3sub(v.target, v.eye);
  #assert abs(v3dot(d, d) - 1) < 0.001;
}
