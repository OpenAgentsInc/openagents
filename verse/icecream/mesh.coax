// Ice Cream Man's low-poly models, made in code: a one-for-one port of
// ~/work/aethyr-demo/src/icecream/mesh.cpp (itself a port of OpenAgents'
// toon-mesh crate and the web build's scene.rs). Each room of the seeded
// house (pastel walls, waffle-cone trim, melting drips, sprinkle carpet,
// furniture), its ceiling lights, the kid, the Ice Cream Man, the tools and
// the little things (keys, fudge, sprinkles, the puzzle).
//
// A mesh is a plain triangle list written into a view of Vtx: its position,
// its face's normal, an outward "hull" direction shared by every face at
// that corner (the toon outline pushes along it), a colour (0xRRGGBB, sRGB)
// and an outline weight (0 for things that never get a line). Every builder
// takes the view and the count so far and returns the new count; a full
// view keeps counting without writing, so a caller can size its buffer.
// Nothing here draws. Models face +z in their own space; the floor is y = 0.
//
// Float arithmetic is plain f32 in the C++'s order, so the same seed gives
// the same vertices as the demo: verse/icecream/test-mesh.sh compares them
// one by one against the C++ built natively, and the checks below hold the
// counts and bounds it recorded (fixtures/mesh-oracle.coax).
//   coax/bin/coax test verse/icecream/mesh.coax --library
#load "rules.coax";
#load "fixtures/mesh-oracle.coax";

HALF_PI_F :: 1.57079632679489661923f32;
KMAN_HEIGHT :: 2.35f32;

V3 :: struct { x: f32; y: f32; z: f32; }
v3 :: (x: f32, y: f32, z: f32) -> V3 { return V3.{x = x, y = y, z = z}; }
v3add :: (a: V3, b: V3) -> V3 { return V3.{x = a.x + b.x, y = a.y + b.y, z = a.z + b.z}; }
v3sub :: (a: V3, b: V3) -> V3 { return V3.{x = a.x - b.x, y = a.y - b.y, z = a.z - b.z}; }
v3mul :: (a: V3, s: f32) -> V3 { return V3.{x = a.x * s, y = a.y * s, z = a.z * s}; }
v3neg :: (a: V3) -> V3 { return V3.{x = -a.x, y = -a.y, z = -a.z}; }
v3dot :: (a: V3, b: V3) -> f32 { return a.x * b.x + a.y * b.y + a.z * b.z; }
v3cross :: (a: V3, b: V3) -> V3 { return v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x); }
// vec3.h's normalize divides each part by the length.
v3norm :: (a: V3) -> V3 { l := sqrt(v3dot(a, a)); return v3(a.x / l, a.y / l, a.z / l); }
v3norm_or_zero :: (a: V3) -> V3 {
  l := sqrt(v3dot(a, a));
  if l > 0.00000000000000000001 { one: f32 = 1.0; return v3mul(a, one / l); }
  return v3(0, 0, 0);
}
v3splat :: (s: f32) -> V3 { return v3(s, s, s); }
// std::min and std::max: (b < a) ? b : a and (a < b) ? b : a.
cmin :: (a: f32, b: f32) -> f32 { return ifx b < a then b else a; }
cmax :: (a: f32, b: f32) -> f32 { return ifx a < b then b else a; }
v3min :: (a: V3, b: V3) -> V3 { return v3(cmin(a.x, b.x), cmin(a.y, b.y), cmin(a.z, b.z)); }
v3max :: (a: V3, b: V3) -> V3 { return v3(cmax(a.x, b.x), cmax(a.y, b.y), cmax(a.z, b.z)); }
// copysign(1, x): -1 for -0 too.
sgn :: (x: f32) -> f32 { return ifx (f32_bits(x) & 0x80000000) != 0 then -1.0f32 else 1.0f32; }
on_floor :: (p: V2, y: f32) -> V3 { return v3(p.x, y, p.z); }
TN_Y :: V3.{x = 0, y = 1, z = 0};

// ---- transforms: p' = m * p + t (m row-major) ----

Xf :: struct { m: [9] f32 = [9] f32.[1, 0, 0, 0, 1, 0, 0, 0, 1]; t: V3; }
apply3 :: (m: [9] f32, p: V3) -> V3 {
  return v3(m[0] * p.x + m[1] * p.y + m[2] * p.z, m[3] * p.x + m[4] * p.y + m[5] * p.z, m[6] * p.x + m[7] * p.y + m[8] * p.z);
}
xf_apply :: (x: Xf, p: V3) -> V3 { return v3add(apply3(x.m, p), x.t); }
xf_linear :: (x: Xf, d: V3) -> V3 { return apply3(x.m, d); }
xf_mul :: (a: Xf, b: Xf) -> Xf {
  r: Xf;
  for i: 0..<3 {
    for j: 0..<3 { r.m[i * 3 + j] = a.m[i * 3] * b.m[j] + a.m[i * 3 + 1] * b.m[3 + j] + a.m[i * 3 + 2] * b.m[6 + j]; }
  }
  r.t = xf_apply(a, b.t);
  return r;
}
xf_id :: () -> Xf { r: Xf; return r; }
translate :: (t: V3) -> Xf { r: Xf; r.t = t; return r; }
xf_scale :: (s: V3) -> Xf { r: Xf; r.m[0] = s.x; r.m[4] = s.y; r.m[8] = s.z; return r; }
rot_x :: (a: f32) -> Xf { r: Xf; c := cos(a); s := sin(a); r.m[4] = c; r.m[5] = -s; r.m[7] = s; r.m[8] = c; return r; }
rot_y :: (a: f32) -> Xf { r: Xf; c := cos(a); s := sin(a); r.m[0] = c; r.m[2] = s; r.m[6] = -s; r.m[8] = c; return r; }
rot_z :: (a: f32) -> Xf { r: Xf; c := cos(a); s := sin(a); r.m[0] = c; r.m[1] = -s; r.m[3] = s; r.m[4] = c; return r; }
// The rotation taking unit `from` to unit `to`.
arc :: (from: V3, to: V3) -> Xf {
  v := v3cross(from, to);
  c := v3dot(from, to);
  r: Xf;
  if c < -0.99999 { return rot_x(PI_F); }
  one: f32 = 1.0;
  k := one / (1 + c);
  r.m[0] = c + v.x * v.x * k; r.m[1] = v.x * v.y * k - v.z; r.m[2] = v.x * v.z * k + v.y;
  r.m[3] = v.y * v.x * k + v.z; r.m[4] = c + v.y * v.y * k; r.m[5] = v.y * v.z * k - v.x;
  r.m[6] = v.z * v.x * k - v.y; r.m[7] = v.z * v.y * k + v.x; r.m[8] = c + v.z * v.z * k;
  return r;
}
// glam's from_scale_rotation_translation: translate * rotate * scale.
srt :: (s: V3, r: Xf, t: V3) -> Xf { return xf_mul(xf_mul(translate(t), r), xf_scale(s)); }
srt1 :: (s: f32, r: Xf, t: V3) -> Xf { return srt(v3splat(s), r, t); }

// The inverse transpose of a 3x3 (row-major), for normals: the cofactors over the determinant.
inverse_transpose :: (m: [9] f32) -> [9] f32 {
  a := m[0]; b := m[1]; c := m[2]; d := m[3]; e := m[4]; f := m[5]; g := m[6]; h := m[7]; i := m[8];
  A := e * i - f * h; B := -(d * i - f * g); C := d * h - e * g;
  D := -(b * i - c * h); E := a * i - c * g; F := -(a * h - b * g);
  G := b * f - c * e; H := -(a * f - c * d); I := a * e - b * d;
  det := a * A + b * B + c * C;
  one: f32 = 1.0;
  k := ifx abs(det) > 0.000000000000000000000000000001 then one / det else 0.0f32;
  return [9] f32.[A * k, B * k, C * k, D * k, E * k, F * k, G * k, H * k, I * k];
}

// ---- shapes in their own unit space, centred on the origin ----

ShapeKind :: enum u8 { cube; frustum; sphere; torus; disc; square; }
// a, b: frustum and disc sides; sphere rings, segments; torus segments, sides.
// p, q: frustum bottom, top radius; torus radius, tube.
Form :: struct { kind: ShapeKind; a: u32; b: u32; p: f32; q: f32; }
cube :: () -> Form { return Form.{kind = ShapeKind.cube}; }
frustum :: (sides: u32, bottom: f32, top: f32) -> Form { return Form.{kind = ShapeKind.frustum, a = sides, p = bottom, q = top}; }
sphere :: (rings: u32, segments: u32) -> Form { return Form.{kind = ShapeKind.sphere, a = rings, b = segments}; }
torus :: (segments: u32, sides: u32, radius: f32, tube: f32) -> Form {
  return Form.{kind = ShapeKind.torus, a = segments, b = sides, p = radius, q = tube};
}
disc :: (sides: u32) -> Form { return Form.{kind = ShapeKind.disc, a = sides}; }
square :: () -> Form { return Form.{kind = ShapeKind.square}; }

Vtx :: struct { p: V3; n: V3; hull: V3; colour: u32; weight: f32; }
Corner :: struct { p: V3; h: V3; }
corner :: (p: V3, h: V3) -> Corner { return Corner.{p = p, h = h}; }
// How a shape is placed: its transform, that transform's normal matrix, its colour and outline weight.
Pen :: struct { xf: Xf; normals: [9] f32; colour: u32; weight: f32; }

// One of the shape's triangles, placed and turned to face out (Mesh::add).
tri :: (v: [] Vtx, n: int, pen: Pen, a: Corner, b: Corner, c: Corner) -> int {
  k0 := corner(xf_apply(pen.xf, a.p), v3norm_or_zero(xf_linear(pen.xf, a.h)));
  k1 := corner(xf_apply(pen.xf, b.p), v3norm_or_zero(xf_linear(pen.xf, b.h)));
  k2 := corner(xf_apply(pen.xf, c.p), v3norm_or_zero(xf_linear(pen.xf, c.h)));
  f := v3cross(v3sub(k1.p, k0.p), v3sub(k2.p, k0.p));
  if v3dot(f, f) < 0.000000000001 { return n; }
  out := v3add(v3add(apply3(pen.normals, a.h), apply3(pen.normals, b.h)), apply3(pen.normals, c.h));
  if v3dot(f, out) < 0 {
    swap := k1; k1 = k2; k2 = swap;
    f = v3neg(f);
  }
  f = v3norm(f);
  if n + 3 <= v.count {
    v[n] = Vtx.{p = k0.p, n = f, hull = k0.h, colour = pen.colour, weight = pen.weight};
    v[n + 1] = Vtx.{p = k1.p, n = f, hull = k1.h, colour = pen.colour, weight = pen.weight};
    v[n + 2] = Vtx.{p = k2.p, n = f, hull = k2.h, colour = pen.colour, weight = pen.weight};
  }
  return n + 3;
}
quad :: (v: [] Vtx, n: int, pen: Pen, a: Corner, b: Corner, c: Corner, d: Corner) -> int {
  m := tri(v, n, pen, a, b, c);
  return tri(v, m, pen, a, c, d);
}

cube_corner :: (x: f32, y: f32, z: f32) -> Corner {
  p := v3mul(v3(x, y, z), 0.5);
  return corner(p, v3norm(p));
}
cube_face :: (axis: int, sign: f32, u: f32, w: f32) -> Corner {
  c: [3] f32;
  c[axis] = sign;
  c[(axis + 1) % 3] = u;
  c[(axis + 2) % 3] = w;
  return cube_corner(c[0], c[1], c[2]);
}
frustum_ring :: (sides: u32, r: f32, y: f32, i: u32) -> Corner {
  a := f32(i) / f32(sides) * TAU_F;
  return corner(v3(r * cos(a), y, r * sin(a)), v3norm(v3(cos(a), y * 1.2, sin(a))));
}
sphere_point :: (rings: u32, segments: u32, ring: u32, seg: u32) -> Corner {
  lat := f32(ring) / f32(rings) * PI_F;
  lon := f32(seg) / f32(segments) * TAU_F;
  n := v3(sin(lat) * cos(lon), cos(lat), sin(lat) * sin(lon));
  return corner(v3mul(n, 0.5), n);
}
torus_point :: (s: Form, i: u32, j: u32) -> Corner {
  u := f32(i) / f32(s.a) * TAU_F;
  w := f32(j) / f32(s.b) * TAU_F;
  ring_at := v3mul(v3(cos(u), sin(u), 0), s.p);
  n := v3(cos(u) * cos(w), sin(u) * cos(w), sin(w));
  return corner(v3add(ring_at, v3mul(n, s.q)), n);
}
flat_corner :: (p: V3) -> Corner { return corner(p, v3norm(v3add(v3norm(p), TN_Y))); }
disc_at :: (sides: u32, i: u32) -> Corner {
  a := f32(i) / f32(sides) * TAU_F;
  half: f32 = 0.5;
  return flat_corner(v3(half * cos(a), 0, half * sin(a)));
}

// Adds `shape` placed by `xf`, in `colour`, with an outline weight (1 the
// normal line, 0 none).
add :: (v: [] Vtx, n0: int, s: Form, xf: Xf, colour: u32, weight: f32) -> int {
  pen := Pen.{xf = xf, normals = inverse_transpose(xf.m), colour = colour, weight = weight};
  n := n0;
  if s.kind == ShapeKind.cube {
    for axis: 0..<3 {
      for k: 0..<2 {
        sign := ifx k == 0 then -1.0f32 else 1.0f32;
        n = quad(v, n, pen, cube_face(axis, sign, -1, -1), cube_face(axis, sign, 1, -1), cube_face(axis, sign, 1, 1), cube_face(axis, sign, -1, 1));
      }
    }
  } else if s.kind == ShapeKind.frustum {
    up := corner(v3(0, 0.5, 0), TN_Y);
    down := corner(v3(0, -0.5, 0), v3(0, -1, 0));
    for i: 0..<cast(int) s.a {
      ui := cast(u32) i;
      b0 := frustum_ring(s.a, s.p, -0.5, ui);
      b1 := frustum_ring(s.a, s.p, -0.5, ui + 1);
      if s.q > 0 {
        t0 := frustum_ring(s.a, s.q, 0.5, ui);
        t1 := frustum_ring(s.a, s.q, 0.5, ui + 1);
        n = quad(v, n, pen, b0, b1, t1, t0);
        n = tri(v, n, pen, up, t0, t1);
      } else {
        n = tri(v, n, pen, b0, b1, up);
      }
      n = tri(v, n, pen, down, b1, b0);
    }
  } else if s.kind == ShapeKind.sphere {
    for ri: 0..<cast(int) s.a {
      r := cast(u32) ri;
      for gi: 0..<cast(int) s.b {
        g := cast(u32) gi;
        a := sphere_point(s.a, s.b, r, g);
        b := sphere_point(s.a, s.b, r, g + 1);
        c := sphere_point(s.a, s.b, r + 1, g + 1);
        d := sphere_point(s.a, s.b, r + 1, g);
        if r == 0 { n = tri(v, n, pen, a, c, d); }
        else if r == s.a - 1 { n = tri(v, n, pen, a, b, c); }
        else { n = quad(v, n, pen, a, b, c, d); }
      }
    }
  } else if s.kind == ShapeKind.torus {
    for ii: 0..<cast(int) s.a {
      i := cast(u32) ii;
      for jj: 0..<cast(int) s.b {
        j := cast(u32) jj;
        n = quad(v, n, pen, torus_point(s, i, j), torus_point(s, i + 1, j), torus_point(s, i + 1, j + 1), torus_point(s, i, j + 1));
      }
    }
  } else if s.kind == ShapeKind.square {
    half: f32 = 0.5;
    n = quad(v, n, pen, flat_corner(v3(-half, 0, -half)), flat_corner(v3(-half, 0, half)), flat_corner(v3(half, 0, half)), flat_corner(v3(half, 0, -half)));
  } else {
    hub := corner(v3(0, 0, 0), TN_Y);
    for ii: 0..<cast(int) s.a {
      i := cast(u32) ii;
      n = tri(v, n, pen, hub, disc_at(s.a, i), disc_at(s.a, i + 1));
    }
  }
  return n;
}
// A box from lo to hi.
block :: (v: [] Vtx, n: int, lo: V3, hi: V3, colour: u32, weight: f32) -> int {
  half: f32 = 0.5;
  return add(v, n, cube(), srt(v3sub(hi, lo), xf_id(), v3mul(v3add(lo, hi), half)), colour, weight);
}

// ---- the palette (scene.rs) ----

WAFFLE :: 0xD9A05B; WAFFLE_DARK :: 0xB57B3A; FUDGE :: 0x5A2E12; VANILLA :: 0xFFF3D9;
FOREHEAD :: 0xFFE4D0; CEILING :: 0xF6EFE4; GOLD :: 0xF7C52B; WHITE :: 0xF7F7F4;
INK :: 0x2B1D16; CLOUD :: 0xBFD86A; SKIN :: 0xF2C9A0; SHIRT :: 0x4F9DDE; PANTS :: 0x334E7A;
SPRINKLES :: [5] u32.[0xFF6FA8, 0x5EC8F2, 0xFFE15C, 0x7EDB7A, 0xFFFFFF];
BACK_WALL :: 0xD6C77C; BACK_STRIPE :: 0xC9B866; BACK_CARPET :: 0x9A8A4E; BACK_DAMP :: 0x7A6C3A;
BACK_TRIM :: 0xB8A35A; BACK_CEILING :: 0xE4DCB8; CANDY_RED :: 0xE8384F;
BUTTON_COLOURS :: [3] u32.[0xFF6FA8, 0x5EC8F2, 0xFFE15C];   // pink, blue, yellow

mix_colour :: (a: u32, b: u32, t0: f32) -> u32 {
  t := clampf(t0, 0, 1);
  out: u32 = 0;
  for k: 0..<3 {
    shift := cast(u32) (16 - 8 * k);
    x := f32((a >> shift) & 0xFF);
    y := f32((b >> shift) & 0xFF);
    out = out | (cast(u32) roundf(x + (y - x) * t) << shift);
  }
  return out;
}
wall_colour :: (f: Flavor) -> u32 {
  if f == Flavor.strawberry { return 0xF6B3C8; }
  if f == Flavor.mint { return 0xBDEBD4; }
  if f == Flavor.vanilla { return 0xFFF1CF; }
  return 0xB98466;
}
carpet_colour :: (f: Flavor) -> u32 {
  if f == Flavor.strawberry { return 0xE88AA6; }
  if f == Flavor.mint { return 0x8FD3B4; }
  if f == Flavor.vanilla { return 0xE9D3A4; }
  return 0x8A5A40;
}
flavor_at :: (i: u32) -> Flavor { return cast(Flavor) cast(u8) (i % 4); }
// Lit freezer blue rather than warm.
cold :: (m: Module) -> bool { return m == Module.hallway || m == Module.stairwell || m == Module.freezer_room || m == Module.laundry; }

hash_u :: (a: u32, b: u32) -> u32 {
  x := wmul32(a, 0x9E3779B9) ^ wmul32(b, 0x85EBCA6B);
  x = x ^ (x >> 15);
  x = wmul32(x, 0x2C1B3C6D);
  x = x ^ (x >> 12);
  return x;
}
speckle :: (a: u32, b: u32) -> f32 { d: f32 = 10000.0; return f32(hash_u(a, b) % 10000) / d; }

// ---- furniture ----

// The face of a box that looks toward `toward`, as a unit axis.
front_of :: (b: Block, toward: V2) -> V3 {
  half: f32 = 0.5;
  c := vmul(vadd(b.min, b.max), half);
  d := vsub(toward, c);
  if abs(d.x) > abs(d.z) { return v3(sgn(d.x), 0, 0); }
  return v3(0, 0, sgn(d.z));
}

// A prop's frame: its box, its middle, its size, the face toward the room and the axis along that face.
Frame :: struct { lo: V3; hi: V3; mid: V3; size: V3; f: V3; along: V3; }
pface :: (fr: Frame, y: f32) -> V3 {
  two: f32 = 2.0;
  return v3(fr.mid.x + fr.f.x * fr.size.x / two, y, fr.mid.z + fr.f.z * fr.size.z / two);
}
// A back slab on the side away from the room (sofa, toilet tank).
back_lo :: (fr: Frame, y: f32) -> V3 {
  x := ifx fr.f.x > 0 then fr.lo.x else ifx fr.f.x < 0 then fr.hi.x - 0.25 else fr.lo.x;
  z := ifx fr.f.z > 0 then fr.lo.z else ifx fr.f.z < 0 then fr.hi.z - 0.25 else fr.lo.z;
  return v3(x, y, z);
}
back_hi :: (fr: Frame) -> V3 {
  return v3(ifx fr.f.x > 0 then fr.lo.x + 0.25 else fr.hi.x, fr.hi.y, ifx fr.f.z > 0 then fr.lo.z + 0.25 else fr.hi.z);
}

bed :: (v: [] Vtx, n0: int, fr: Frame, room: V2) -> int {
  lo := fr.lo; hi := fr.hi; mid := fr.mid; size := fr.size;
  w: f32 = 1;
  n := block(v, n0, lo, v3(hi.x, 0.35, hi.z), 0x8A5A40, w);
  n = block(v, n, v3add(lo, v3(0.08, 0.35, 0.08)), v3(hi.x - 0.08, 0.55, hi.z - 0.08), WHITE, w);
  bl: V3; bh: V3; pl: V3; ph: V3;
  if size.x > size.z {
    toward := ifx room.x > mid.x then 1.0f32 else -1.0f32;
    split := mid.x - toward * size.x * 0.1;
    a := ifx toward > 0 then split else lo.x;
    e := ifx toward > 0 then hi.x else split;
    wall_end := ifx toward > 0 then lo.x else hi.x;
    bl = v3(a, 0.55, lo.z + 0.05); bh = v3(e, 0.62, hi.z - 0.05);
    pl = v3(cmin(wall_end, wall_end + toward * 0.7), 0.55, mid.z - size.z * 0.3);
    ph = v3(cmax(wall_end, wall_end + toward * 0.7), 0.72, mid.z + size.z * 0.3);
  } else {
    toward := ifx room.z > mid.z then 1.0f32 else -1.0f32;
    split := mid.z - toward * size.z * 0.1;
    a := ifx toward > 0 then split else lo.z;
    e := ifx toward > 0 then hi.z else split;
    wall_end := ifx toward > 0 then lo.z else hi.z;
    bl = v3(lo.x + 0.05, 0.55, a); bh = v3(hi.x - 0.05, 0.62, e);
    pl = v3(mid.x - size.x * 0.3, 0.55, cmin(wall_end, wall_end + toward * 0.7));
    ph = v3(mid.x + size.x * 0.3, 0.72, cmax(wall_end, wall_end + toward * 0.7));
  }
  n = block(v, n, bl, bh, wall_colour(Flavor.strawberry), w);
  return block(v, n, pl, ph, 0xFFDCE8, w);
}

furnish :: (v: [] Vtx, n0: int, kind: PropKind, b: Block, room: V2, wall_c: u32, carpet_c: u32, trim: u32) -> int {
  half: f32 = 0.5;
  two: f32 = 2.0;
  lo := on_floor(b.min, 0);
  hi := on_floor(b.max, b.height);
  mid := v3mul(v3add(lo, hi), half);
  size := v3sub(hi, lo);
  f := front_of(b, room);
  along := v3(abs(f.z), 0, abs(f.x));
  fr := Frame.{lo = lo, hi = hi, mid = mid, size = size, f = f, along = along};
  w: f32 = 1;
  n := n0;
  if kind == PropKind.bed { return bed(v, n, fr, room); }
  if kind == PropKind.closet {
    n = block(v, n, lo, hi, 0xE8C99B, w);
    seam := pface(fr, hi.y / two);
    n = block(v, n, v3sub(seam, v3(0.03, hi.y / two - 0.1, 0.03)), v3add(v3add(seam, v3(0.03, hi.y / two - 0.1, 0.03)), v3mul(f, 0.02)), 0x9C7650, 0);
    for k: 0..<2 {
      s := ifx k == 0 then -1.0f32 else 1.0f32;
      knob := v3add(v3add(pface(fr, 1.2), v3mul(along, 0.18 * s)), v3mul(f, 0.05));
      n = block(v, n, v3sub(knob, v3splat(0.05)), v3add(knob, v3splat(0.05)), GOLD, 0);
    }
    return n;
  }
  if kind == PropKind.dresser {
    n = block(v, n, lo, hi, 0xC98B5E, w);
    for i: 0..<3 {
      line := pface(fr, 0.2 + f32(i) * 0.3);
      r := cmax(size.x, size.z) * 0.4;
      n = block(v, n, v3sub(v3sub(line, v3mul(along, r)), v3mul(TN_Y, 0.02)), v3add(v3add(v3add(line, v3mul(along, r)), v3mul(TN_Y, 0.02)), v3mul(f, 0.02)), 0x8A5A40, 0);
    }
    return n;
  }
  if kind == PropKind.counter {
    n = block(v, n, lo, v3(hi.x, hi.y - 0.1, hi.z), 0x9ED9C0, w);
    return block(v, n, v3(lo.x - 0.03, hi.y - 0.1, lo.z - 0.03), v3add(hi, v3(0.03, 0, 0.03)), WHITE, w);
  }
  if kind == PropKind.fridge {
    n = block(v, n, lo, hi, 0xF2F5F8, w);
    handle := v3add(v3add(pface(fr, hi.y * 0.55), v3mul(along, cmin(size.x, size.z) * 0.3)), v3mul(f, 0.04));
    n = block(v, n, v3sub(handle, v3(0.04, 0.35, 0.04)), v3add(handle, v3(0.04, 0.35, 0.04)), 0x9AA4AE, 0);
    magnet := v3add(v3sub(pface(fr, hi.y * 0.75), v3mul(along, 0.2)), v3mul(f, 0.03));
    n = block(v, n, v3sub(magnet, v3splat(0.07)), v3add(magnet, v3splat(0.07)), 0xFF6FA8, 0);
    seam := v3add(pface(fr, hi.y * 0.7), v3mul(f, 0.01));
    r := cmin(size.x, size.z) * 0.48;
    return block(v, n, v3sub(v3sub(seam, v3mul(along, r)), v3mul(TN_Y, 0.015)), v3add(v3add(seam, v3mul(along, r)), v3mul(TN_Y, 0.015)), 0xB8C2CC, 0);
  }
  if kind == PropKind.table {
    top := hi.y;
    n = block(v, n, v3(lo.x, top - 0.08, lo.z), hi, 0xC98B5E, w);
    legs := [8] f32.[lo.x + 0.1, lo.z + 0.1, hi.x - 0.1, lo.z + 0.1, lo.x + 0.1, hi.z - 0.1, hi.x - 0.1, hi.z - 0.1];
    for l: 0..<4 {
      n = block(v, n, v3(legs[l * 2] - 0.05, 0, legs[l * 2 + 1] - 0.05), v3(legs[l * 2] + 0.05, top - 0.08, legs[l * 2 + 1] + 0.05), 0x8A5A40, w);
    }
    bowl := v3(mid.x, top + 0.08, mid.z);
    n = add(v, n, frustum(8, 0.3, 0.5), srt(v3(0.4, 0.16, 0.4), xf_id(), bowl), WHITE, w);
    return add(v, n, sphere(4, 8), srt1(0.26, xf_id(), v3add(bowl, v3mul(TN_Y, 0.12))), wall_colour(Flavor.strawberry), w);
  }
  if kind == PropKind.sofa {
    n = block(v, n, lo, v3(hi.x, 0.45, hi.z), 0xE77FA0, w);
    n = block(v, n, back_lo(fr, 0.45), back_hi(fr), wall_colour(Flavor.strawberry), w);
    return block(v, n, v3add(lo, v3(0.1, 0.45, 0.1)), v3(hi.x - 0.1, 0.55, hi.z - 0.1), 0xFFDCE8, w);
  }
  if kind == PropKind.tv {
    n = block(v, n, lo, v3(hi.x, 0.6, hi.z), 0x8A5A40, w);
    sl := v3(mid.x - along.x * size.x * 0.45 - abs(f.x) * 0.05, 0.6, mid.z - along.z * size.z * 0.45 - abs(f.z) * 0.05);
    sh := v3(mid.x + along.x * size.x * 0.45 + abs(f.x) * 0.05, hi.y, mid.z + along.z * size.z * 0.45 + abs(f.z) * 0.05);
    n = block(v, n, sl, sh, 0x22242A, w);
    glow := v3add(v3(mid.x, (0.6 + hi.y) / two, mid.z), v3mul(f, 0.06));
    r := cmax(size.x, size.z) * 0.4;
    return block(v, n, v3sub(v3sub(glow, v3mul(along, r)), v3mul(TN_Y, 0.3)), v3add(v3add(glow, v3mul(along, r)), v3mul(TN_Y, 0.3)), 0x7FC8E8, 0);
  }
  if kind == PropKind.tub {
    n = block(v, n, lo, hi, WHITE, w);
    return block(v, n, v3add(lo, v3(0.15, 0, 0.15)), v3(hi.x - 0.15, hi.y + 0.01, hi.z - 0.15), 0x9FD8F0, 0);
  }
  if kind == PropKind.toilet {
    n = block(v, n, v3add(lo, v3(0.1, 0, 0.1)), v3(hi.x - 0.1, 0.45, hi.z - 0.1), WHITE, w);
    return block(v, n, back_lo(fr, 0.45), back_hi(fr), WHITE, w);
  }
  if kind == PropKind.sink {
    n = block(v, n, lo, hi, WHITE, w);
    return block(v, n, v3(mid.x - 0.25, hi.y, mid.z - 0.25), v3(mid.x + 0.25, hi.y + 0.02, mid.z + 0.25), 0x9FD8F0, 0);
  }
  if kind == PropKind.washer {
    n = block(v, n, lo, hi, WHITE, w);
    door := v3add(pface(fr, hi.y * 0.5), v3mul(f, 0.02));
    turn := ifx abs(f.x) > 0 then rot_z(HALF_PI_F * sgn(f.x) * -1.0) else rot_x(HALF_PI_F * sgn(f.z));
    return add(v, n, disc(12), srt1(0.7, turn, door), 0x3C4A5A, 0);
  }
  if kind == PropKind.shelf {
    n = block(v, n, lo, hi, 0x8A5A40, w);
    four: f32 = 4.0;
    for i: 0..<5 {
      x := lo.x + 0.3 + f32(i) * cmax(size.x - 0.6, 0.1) / four;
      n = add(v, n, frustum(8, 0.4, 0.5), srt(v3(0.35, 0.25, 0.35), xf_id(), v3(x, hi.y + 0.12, mid.z)), wall_colour(flavor_at(cast(u32) i)), w);
    }
    return n;
  }
  if kind == PropKind.stairs {
    steps: f32 = 8.0;
    long_x := size.x > size.z;
    for i: 0..<8 {
      t0 := f32(i) / steps;
      t1 := f32(i + 1) / steps;
      y := hi.y * t1;
      a: V3; e: V3;
      if long_x { a = v3(lo.x + size.x * t0, 0, lo.z); e = v3(lo.x + size.x * t1, y, hi.z); }
      else { a = v3(lo.x, 0, lo.z + size.z * t0); e = v3(hi.x, y, lo.z + size.z * t1); }
      n = block(v, n, a, e, ifx i % 2 == 0 then carpet_c else wall_c, w);
    }
    return n;
  }
  if kind == PropKind.freezer {
    n = block(v, n, lo, v3(hi.x, hi.y - 0.08, hi.z), 0xDDEFFF, w);
    return block(v, n, v3(lo.x - 0.03, hi.y - 0.08, lo.z - 0.03), v3add(hi, v3(0.03, 0, 0.03)), 0xBFE3FF, w);
  }
  if kind == PropKind.pillar || kind == PropKind.partition {
    n = block(v, n, lo, hi, wall_c, 0);
    n = block(v, n, v3sub(lo, v3(0.05, 0, 0.05)), v3(hi.x + 0.05, 0.28, hi.z + 0.05), trim, 0);
    return block(v, n, v3(lo.x - 0.05, hi.y - 0.22, lo.z - 0.05), v3add(hi, v3(0.05, 0, 0.05)), trim, 0);
  }
  // the plant
  n = add(v, n, frustum(8, 0.3, 0.5), srt(v3(0.8, 0.7, 0.8), xf_id(), v3(mid.x, 0.35, mid.z)), WAFFLE, w);
  return add(v, n, sphere(5, 8), srt1(0.7, xf_id(), v3(mid.x, 0.85, mid.z)), wall_colour(Flavor.mint), w);
}

front_door :: (v: [] Vtx, n0: int, f: FrontDoor) -> int {
  o := outward(f.side);
  out := v3(o.x, 0, o.z);
  along := v3(abs(out.z), 0, abs(out.x));
  face := v3sub(v3(f.at.x, 0, f.at.z), v3mul(out, 0.17));
  lo := v3sub(v3sub(face, v3mul(along, 0.75)), v3mul(out, 0.06));
  hi := v3add(v3add(face, v3mul(along, 0.75)), v3mul(TN_Y, DOOR_HEIGHT));
  n := block(v, n0, v3min(lo, hi), v3max(lo, hi), 0x6B3A1E, 1);
  for i: 0..<3 {
    hole := v3sub(v3add(v3add(face, v3mul(TN_Y, 0.9 + f32(i) * 0.22)), v3mul(along, 0.5)), v3mul(out, 0.08));
    n = block(v, n, v3sub(hole, v3splat(0.07)), v3add(hole, v3splat(0.07)), GOLD, 0);
  }
  knob := v3sub(v3add(v3add(face, v3mul(TN_Y, 1.1)), v3mul(along, 0.55)), v3mul(out, 0.12));
  n = add(v, n, sphere(4, 8), srt1(0.14, xf_id(), knob), GOLD, 1);
  sign := v3sub(v3add(face, v3mul(TN_Y, DOOR_HEIGHT + 0.15)), v3mul(out, 0.06));
  half := v3add(v3add(v3mul(along, 0.5), v3mul(TN_Y, 0.1)), v3mul(out, 0.04));
  return block(v, n, v3sub(sign, half), v3add(sign, half), 0x3BB273, 1);
}

// ---- rooms ----

// One side's wall piece between s0 and s1 along it, y0 to y1 up, grown
// toward the room's outside by `grow` (Mesh room()'s piece).
Wall :: struct { horizontal: bool; inner: f32; outer: f32; }
piece :: (v: [] Vtx, n: int, w: Wall, s0: f32, s1: f32, y0: f32, y1: f32, colour: u32, grow: f32) -> int {
  lo := cmin(w.inner, w.outer);
  hi := cmax(w.inner, w.outer);
  if w.inner < w.outer { lo -= grow; } else { hi += grow; }
  if w.horizontal { return block(v, n, v3(s0, y0, lo), v3(s1, y1, hi), colour, 0); }
  return block(v, n, v3(lo, y0, s0), v3(hi, y1, s1), colour, 0);
}

// One room: floor, ceiling, its side of each wall with doorways, trim,
// drips, the carpet's sprinkles and its furniture; the front door in its
// room. `yellow` (0 to 1) turns it into the Backrooms.
tn_room :: (g: [] Game, index: int, yellow: f32, v: [] Vtx, n0: int) -> int {
  h := g[0].house.rooms[index];
  ix := cast(u32) index;
  c := centre(h.at);
  two: f32 = 2.0;
  x0 := c.x - CELL / two;
  z0 := c.z - CELL / two;
  backrooms := yellow >= 0.5;
  colour := mix_colour(wall_colour(h.flavor), BACK_WALL, yellow);
  floor_c := mix_colour(carpet_colour(h.flavor), BACK_CARPET, yellow);
  trim := mix_colour(WAFFLE, BACK_TRIM, yellow);
  frame := mix_colour(WAFFLE_DARK, BACK_TRIM, yellow);
  half: f32 = 0.15;
  n := block(v, n0, v3(x0, -0.1, z0), v3(x0 + CELL, 0, z0 + CELL), floor_c, 0);
  n = block(v, n, v3(x0, WALL_HEIGHT, z0), v3(x0 + CELL, WALL_HEIGHT + 0.1, z0 + CELL), mix_colour(CEILING, BACK_CEILING, yellow), 0);
  if backrooms {
    for ii: 0..<7 {
      i := cast(u32) ii;
      x := x0 + 1 + speckle(ix + 31, i * 2) * (CELL - 2);
      z := z0 + 1 + speckle(ix + 31, i * 2 + 1) * (CELL - 2);
      size := 0.6 + speckle(ix + 77, i) * 1.4;
      n = add(v, n, disc(10), srt(v3(size, 1, size * (0.6 + speckle(ix, 90 + i) * 0.6)), rot_y(speckle(ix + 5, i) * PI_F), v3(x, 0.008, z)), BACK_DAMP, 0);
    }
    five: f32 = 5.0;
    for i: 1..<5 {
      a := f32(i) * CELL / five;
      n = block(v, n, v3(x0 + a - 0.02, WALL_HEIGHT - 0.02, z0), v3(x0 + a + 0.02, WALL_HEIGHT, z0 + CELL), BACK_TRIM, 0);
      n = block(v, n, v3(x0, WALL_HEIGHT - 0.02, z0 + a - 0.02), v3(x0 + CELL, WALL_HEIGHT, z0 + a + 0.02), BACK_TRIM, 0);
    }
  }
  sprinkles := ifx backrooms then 0 else 36;
  for ii: 0..<sprinkles {
    i := cast(u32) ii;
    x := x0 + 0.4 + speckle(ix, i * 2) * (CELL - 0.8);
    z := z0 + 0.4 + speckle(ix, i * 2 + 1) * (CELL - 0.8);
    n = add(v, n, cube(), srt(v3(0.05, 0.02, 0.2), rot_y(speckle(ix + 99, i) * PI_F), v3(x, 0.01, z)), SPRINKLES[ii % 5], 0);
  }
  for si: 0..<4 {
    side := side_at(si);
    open := h.doors[si];
    out := outward(side);
    horizontal := side == Side.north || side == Side.south;
    line := ifx horizontal then c.z + out.z * CELL / two else c.x + out.x * CELL / two;
    inner := ifx horizontal then line - out.z * half else line - out.x * half;
    w := Wall.{horizontal = horizontal, inner = inner, outer = line};
    a0 := ifx horizontal then x0 else z0;
    a1 := a0 + CELL;
    mid := (a0 + a1) / two;
    gap := DOOR / two;
    spans := ifx open then 2 else 1;
    for k: 0..<spans {
      s0 := ifx open && k == 1 then mid + gap else a0;
      s1 := ifx open && k == 0 then mid - gap else a1;
      n = piece(v, n, w, s0, s1, 0, WALL_HEIGHT, colour, 0);
      n = piece(v, n, w, s0, s1, 0, 0.28, trim, 0.05);
      n = piece(v, n, w, s0, s1, WALL_HEIGHT - 0.22, WALL_HEIGHT, trim, 0.05);
      if backrooms {
        at := s0 + 0.25;
        while at < s1 - 0.1 {
          n = piece(v, n, w, at, cmin(at + 0.07, s1), 0.28, WALL_HEIGHT - 0.22, BACK_STRIPE, 0.01);
          at += 0.5;
        }
      }
    }
    if open {
      n = piece(v, n, w, mid - gap, mid + gap, DOOR_HEIGHT, WALL_HEIGHT, colour, 0);
      n = piece(v, n, w, mid - gap - 0.12, mid - gap, 0, DOOR_HEIGHT, frame, 0.06);
      n = piece(v, n, w, mid + gap, mid + gap + 0.12, 0, DOOR_HEIGHT, frame, 0.06);
      n = piece(v, n, w, mid - gap - 0.12, mid + gap + 0.12, DOOR_HEIGHT - 0.12, DOOR_HEIGHT, frame, 0.06);
    }
    drips := ifx backrooms then 0 else 6;
    for ii: 0..<drips {
      i := cast(u32) ii;
      a := a0 + 0.6 + speckle(ix * 7 + cast(u32) si, i) * (CELL - 1.2);
      if open && abs(a - mid) < gap + 0.3 { continue; }
      length := 0.15 + speckle(ix, 50 + i) * 0.45;
      at := ifx horizontal then v3(a, WALL_HEIGHT - 0.22 - length / two, inner - out.z * 0.04) else v3(inner - out.x * 0.04, WALL_HEIGHT - 0.22 - length / two, a);
      n = add(v, n, frustum(6, 0.5, 0.15), srt(v3(0.16, length, 0.16), rot_x(PI_F), at), colour, 0);
      n = add(v, n, sphere(4, 6), srt1(0.11, xf_id(), v3sub(at, v3mul(TN_Y, length / two))), colour, 0);
    }
  }
  drops := ifx backrooms then 0 else 5;
  for ii: 0..<drops {
    i := cast(u32) ii;
    x := c.x - 3.5 + speckle(ix + 7, i) * 7;
    z := c.z - 3.5 + speckle(ix + 9, i) * 7;
    length := 0.2 + speckle(ix + 3, i) * 0.35;
    n = add(v, n, frustum(6, 0.5, 0.1), srt(v3(0.18, length, 0.18), rot_x(PI_F), v3(x, WALL_HEIGHT - length / two, z)), wall_colour(flavor_at(hash_u(ix, i))), 0);
  }
  def := module_def(h.kind);
  for k: 0..<def.prop_n {
    p := def.props[k];
    n = furnish(v, n, p.kind, Block.{min = vadd(c, p.min), max = vadd(c, p.max), height = p.height}, c, colour, floor_c, trim);
  }
  for k: 0..<g[0].house.extra_n {
    e := g[0].house.extras[k];
    if e.room != index { continue; }
    n = furnish(v, n, e.prop.kind, Block.{min = vadd(c, e.prop.min), max = vadd(c, e.prop.max), height = e.prop.height}, c, colour, floor_c, trim);
  }
  if g[0].house.front.room == index { n = front_door(v, n, g[0].house.front); }
  return n;
}

// A room's ceiling light panels, drawn in their own light.
tn_lights :: (g: [] Game, index: int, yellow: f32, v: [] Vtx, n0: int) -> int {
  c := centre(g[0].house.rooms[index].at);
  n := n0;
  if yellow >= 0.5 {
    at := [10] f32.[-3, -2, 3, -2, -3, 2, 3, 2, 0, 0];
    for k: 0..<5 {
      p := v3(c.x + at[k * 2], WALL_HEIGHT - 0.03, c.z + at[k * 2 + 1]);
      n = block(v, n, v3sub(p, v3(0.3, 0.03, 0.95)), v3add(p, v3(0.3, 0.03, 0.95)), WHITE, 0);
    }
    return n;
  }
  for k: 0..<2 {
    offset := ifx k == 0 then -2.5f32 else 2.5f32;
    p := v3(c.x + offset, WALL_HEIGHT - 0.03, c.z);
    n = block(v, n, v3sub(p, v3(0.35, 0.03, 0.9)), v3add(p, v3(0.35, 0.03, 0.9)), WHITE, 0);
  }
  return n;
}

// Every room and its lights, room by room, with where each starts:
// first[i] the room's first vertex, first[room_n + i] its lights' first.
tn_house :: (g: [] Game, yellow: f32, v: [] Vtx, first: [] int) -> int {
  n := 0;
  rooms := g[0].house.room_n;
  for i: 0..<rooms {
    if i < first.count { first[i] = n; }
    n = tn_room(g, i, yellow, v, n);
  }
  for i: 0..<rooms {
    if rooms + i < first.count { first[rooms + i] = n; }
    n = tn_lights(g, i, yellow, v, n);
  }
  if 2 * rooms < first.count { first[2 * rooms] = n; }
  return n;
}

// ---- the kid (the player) ----

// The blocky avatar's height (to the top of its hair) and the scale that
// draws it the kid's PLAYER_HEIGHT; its eye line before scaling.
AVATAR_MODEL_HEIGHT :: 2.12f32;
AVATAR_MODEL_EYES :: 1.89f32;
avatar_scale :: () -> f32 { return PLAYER_HEIGHT / AVATAR_MODEL_HEIGHT; }
Part :: enum u8 {
  torso; head; arm; leg;
  man_body; man_leg; man_arm; man_head; man_forehead;
  key; fudge; cloud; sparkle; star; splat; drip; cone; treat; cone_shot; sugar; cabinet; puddle;
}
PARTS :: 22;

avatar_torso :: (v: [] Vtx, n0: int) -> int {
  n := block(v, n0, v3(-0.4, 0.8, -0.2), v3(0.4, 1.55, 0.2), SHIRT, 1);
  // a cone on the shirt
  n = block(v, n, v3(-0.08, 1.05, 0.2), v3(0.08, 1.3, 0.22), WAFFLE, 0);
  return block(v, n, v3(-0.12, 1.3, 0.2), v3(0.12, 1.42, 0.22), wall_colour(Flavor.strawberry), 0);
}
avatar_head :: (v: [] Vtx, n0: int) -> int {
  n := block(v, n0, v3(-0.28, 1.57, -0.26), v3(0.28, 2.07, 0.26), SKIN, 1);
  for k: 0..<2 {
    x := ifx k == 0 then -0.11f32 else 0.11f32;
    n = block(v, n, v3(x - 0.04, 1.84, 0.26), v3(x + 0.04, 1.94, 0.28), INK, 0);
  }
  // a smile
  n = block(v, n, v3(-0.12, 1.7, 0.26), v3(0.12, 1.73, 0.28), INK, 0);
  n = block(v, n, v3(-0.15, 1.73, 0.26), v3(-0.11, 1.77, 0.28), INK, 0);
  n = block(v, n, v3(0.11, 1.73, 0.26), v3(0.15, 1.77, 0.28), INK, 0);
  // hair
  return block(v, n, v3(-0.3, 1.98, -0.28), v3(0.3, 2.12, 0.28), 0x6B3A1E, 1);
}
// The arm and leg hang from their joint at the origin.
avatar_arm :: (v: [] Vtx, n0: int) -> int {
  n := block(v, n0, v3(-0.13, -0.38, -0.13), v3(0.13, 0.0, 0.13), SHIRT, 1);
  return block(v, n, v3(-0.13, -0.72, -0.13), v3(0.13, -0.38, 0.13), SKIN, 1);
}
avatar_leg :: (v: [] Vtx, n0: int) -> int {
  n := block(v, n0, v3(-0.18, -0.8, -0.18), v3(0.18, 0.0, 0.18), PANTS, 1);
  return block(v, n, v3(-0.19, -0.8, -0.2), v3(0.19, -0.68, 0.24), 0x3A3A3A, 1);
}

// ---- the Ice Cream Man ----

MAN_MODEL_HEIGHT :: 3.345f32;
MAN_MODEL_HIP :: 0.85f32;
MAN_DUCK :: 0.72f32;   // radians he bends at a doorway
man_scale :: () -> f32 { return KMAN_HEIGHT / MAN_MODEL_HEIGHT; }
minion_scale :: () -> f32 { e: f32 = 0.8; return e / MAN_MODEL_HEIGHT; }
// His top, metres, bent `d` (0-1).
man_top :: (d: f32) -> f32 {
  hip := MAN_MODEL_HIP * man_scale();
  return hip + (KMAN_HEIGHT - hip) * cos(MAN_DUCK * clampf(d, 0, 1));
}
// How much he ducks at `at`: House::doorways (each room's south, then east,
// door to a neighbour), smoothstepped by how near the wall he is.
duck :: (g: [] Game, at: V2) -> f32 {
  best: f32 = 0;
  for i: 0..<g[0].house.room_n {
    room := g[0].house.rooms[i];
    for k: 0..<2 {
      side := ifx k == 0 then Side.south else Side.east;
      if !room.doors[cast(int) side] { continue; }
      nb := neighbour(g, room.at, side);
      if cell_eq(nb, NO_CELL) { continue; }
      mid := doorway(room.at, nb);
      along_x := side == Side.south;
      across := ifx along_x then abs(at.z - mid.z) else abs(at.x - mid.x);
      along := ifx along_x then abs(at.x - mid.x) else abs(at.z - mid.z);
      d: f32 = 0;
      two: f32 = 2.0;
      if along <= DOOR / two + 0.6 {
        one: f32 = 1.0;
        t := clampf((2.3 - across) / one, 0, 1);
        d = t * t * (3 - 2 * t);
      }
      best = cmax(best, d);
    }
  }
  return best;
}

man_body :: (v: [] Vtx, n0: int) -> int {
  n := add(v, n0, frustum(12, 0.2, 0.6), srt(v3(1, 1.25, 1), xf_id(), v3(0, 1.38, 0)), WAFFLE, 1);
  for i: 0..<4 {
    t := (f32(i) + 0.6) / 4.6;
    y := 0.76 + t * 1.25;
    r := 0.2 + t * 0.4 + 0.01;
    n = add(v, n, torus(14, 3, r, 0.025), xf_mul(translate(v3(0, y, 0)), rot_x(HALF_PI_F)), WAFFLE_DARK, 0);
  }
  six: f32 = 6.0;
  for i: 0..<6 {
    a := f32(i) / six * TAU_F;
    dir := v3(cos(a), 0, sin(a));
    lo := v3add(v3(0, 0.8, 0), v3mul(dir, 0.24));
    hi := v3add(v3(0, 1.98, 0), v3mul(dir, 0.6));
    half: f32 = 0.5;
    mid := v3mul(v3add(lo, hi), half);
    up := v3norm(v3sub(hi, lo));
    d := v3sub(hi, lo);
    n = add(v, n, cube(), srt(v3(0.035, sqrt(v3dot(d, d)), 0.035), arc(TN_Y, up), v3add(mid, v3mul(dir, 0.012))), WAFFLE_DARK, 0);
  }
  return add(v, n, torus(14, 4, 0.6, 0.07), xf_mul(translate(v3(0, 2, 0)), rot_x(HALF_PI_F)), 0xE8B878, 1);
}
man_leg :: (v: [] Vtx, n0: int) -> int {
  n := add(v, n0, frustum(8, 0.5, 0.5), srt(v3(0.2, 0.8, 0.2), xf_id(), v3(0, -0.4, 0)), WAFFLE, 1);
  return block(v, n, v3(-0.13, -0.85, -0.12), v3(0.13, -0.72, 0.22), 0x6B3A1E, 1);
}
man_arm :: (v: [] Vtx, n0: int) -> int {
  n := add(v, n0, frustum(8, 0.4, 0.6), srt(v3(0.16, 0.7, 0.16), xf_id(), v3(0, -0.35, 0)), WAFFLE, 1);
  return add(v, n, sphere(5, 8), srt1(0.24, xf_id(), v3(0, -0.75, 0)), WHITE, 1);
}
// The point on his face's ellipse at (x, y), forward.
face_z :: (x: f32, y: f32) -> f32 {
  rx: f32 = 0.65;
  ry: f32 = 0.45;
  u := x / rx;
  w := (y - 2.3) / ry;
  return rx * sqrt(cmax(1 - u * u - w * w, 0.0));
}
man_head :: (v: [] Vtx, n0: int) -> int {
  n := add(v, n0, sphere(8, 14), srt(v3(1.3, 0.9, 1.3), xf_id(), v3(0, 2.3, 0)), VANILLA, 1);
  ten: f32 = 10.0;
  for i: 0..<10 {
    a := f32(i) / ten * TAU_F;
    r: f32 = 0.6;
    drop := 0.12 + f32((i * 7) % 4) * 0.05;
    two: f32 = 2.0;
    n = add(v, n, sphere(4, 6), srt(v3(0.2, 0.2 + drop, 0.2), xf_id(), v3(cos(a) * r, 2.0 - drop / two, sin(a) * r)), VANILLA, 0);
  }
  for k: 0..<2 {
    x := ifx k == 0 then -0.12f32 else 0.12f32;
    n = add(v, n, sphere(4, 6), srt1(0.1, xf_id(), v3(x, 2.5, face_z(x, 2.5) + 0.01)), INK, 0);
  }
  for i: 0..<11 {
    t := f32(i) / ten;
    a := PI_F * (1.15 + 0.7 * t);
    p := v3(cos(a) * 0.34, 2.44 + sin(a) * 0.24, 0);
    z := face_z(p.x, p.y);
    n = block(v, n, v3(p.x - 0.045, p.y - 0.04, z - 0.03), v3(p.x + 0.045, p.y + 0.04, z + 0.03), 0x8A1E2E, 0);
    if i >= 2 && i < 9 {
      n = block(v, n, v3(p.x - 0.03, p.y + 0.03, z - 0.02), v3(p.x + 0.03, p.y + 0.07, z + 0.035), WHITE, 0);
    }
  }
  for k: 0..<2 {
    side := ifx k == 0 then -1.0f32 else 1.0f32;
    cheek := v3(side * 0.38, 2.32, face_z(side * 0.38, 2.32) - 0.01);
    n = add(v, n, sphere(4, 8), srt(v3(0.2, 0.14, 0.08), xf_id(), cheek), 0xFF9DB8, 0);
    for i: 0..<4 {
      o := v3(side * (0.05 * f32(i % 2) - 0.03), 0.06 * (f32(i) - 1.5), 0.05);
      n = add(v, n, cube(), srt(v3(0.025, 0.08, 0.025), rot_z(0.6 * f32(i) + side), v3add(cheek, o)), SPRINKLES[i % 5], 0);
    }
  }
  return n;
}
man_forehead :: (v: [] Vtx, n0: int) -> int {
  n := add(v, n0, sphere(10, 16), srt(v3(1.2, 1.25, 1.15), xf_id(), v3(0, 2.72, -0.04)), FOREHEAD, 1);
  return add(v, n, sphere(4, 8), srt(v3(0.2, 0.12, 0.06), rot_x(-0.6), v3(0.18, 3.06, 0.4)), 0xFFFFFF, 0);
}

// ---- tools, in the hand, pointing along +z from the grip ----

tn_tool :: (t: Tool, v: [] Vtx, n0: int) -> int {
  n := n0;
  if t == Tool.fudge {
    n = block(v, n, v3(-0.1, -0.12, -0.15), v3(0.1, 0.1, 0.45), 0x6B3A1E, 1);
    n = add(v, n, frustum(8, 0.5, 0.3), srt(v3(0.16, 0.3, 0.16), rot_x(HALF_PI_F), v3(0, 0, 0.6)), 0xC9A27E, 1);
    return add(v, n, sphere(4, 8), srt1(0.26, xf_id(), v3(0, 0.2, 0.05)), FUDGE, 1);
  }
  if t == Tool.fart {
    n = add(v, n, frustum(8, 0.3, 0.3), srt(v3(0.24, 0.6, 0.24), rot_x(HALF_PI_F), v3(0, 0, 0.2)), 0x8DC63F, 1);
    return add(v, n, frustum(8, 0.25, 0.5), srt(v3(0.4, 0.2, 0.4), rot_x(HALF_PI_F), v3(0, 0, 0.58)), 0xB6E06A, 1);
  }
  if t == Tool.sword {
    for i: 0..<8 {
      z0 := -0.1 + f32(i) * 0.13;
      n = block(v, n, v3(-0.045, -0.045, z0), v3(0.045, 0.045, z0 + 0.13), ifx i % 2 == 0 then CANDY_RED else WHITE, 1);
    }
    hook := [8] f32.[0.06, 1.0, 0.16, 1.04, 0.24, 0.98, 0.24, 0.88];
    for i: 0..<4 {
      y := hook[i * 2];
      z := hook[i * 2 + 1];
      n = block(v, n, v3(-0.045, y - 0.05, z - 0.05), v3(0.045, y + 0.05, z + 0.05), ifx i % 2 == 0 then WHITE else CANDY_RED, 1);
    }
    return n;
  }
  if t == Tool.spear {
    n = block(v, n, v3(-0.05, -0.05, -0.35), v3(0.05, 0.05, 0.25), WAFFLE_DARK, 1);
    n = add(v, n, frustum(10, 0.5, 0.02), srt(v3(0.3, 2.4, 0.3), rot_x(HALF_PI_F), v3(0, 0, 1.45)), WAFFLE, 1);
    for i: 0..<5 {
      z := 0.45 + f32(i) * 0.42;
      r := 0.15 * (1 - (z - 0.25) / 2.4) + 0.012;
      n = add(v, n, torus(10, 3, r, 0.012), translate(v3(0, 0, z)), WAFFLE_DARK, 0);
    }
    return add(v, n, sphere(4, 8), srt1(0.3, xf_id(), v3(0, 0, 0.28)), wall_colour(Flavor.strawberry), 1);
  }
  if t == Tool.pistol {
    n = block(v, n, v3(-0.06, -0.3, -0.12), v3(0.06, 0, 0.05), 0x8A5A40, 1);
    n = block(v, n, v3(-0.08, -0.02, -0.15), v3(0.08, 0.12, 0.25), 0xFF9DB8, 1);
    return add(v, n, frustum(8, 0.15, 0.5), srt(v3(0.24, 0.35, 0.24), rot_x(HALF_PI_F), v3(0, 0.05, 0.42)), WAFFLE, 1);
  }
  if t == Tool.sugar {
    n = add(v, n, frustum(10, 0.5, 0.5), srt(v3(0.26, 0.9, 0.26), rot_x(HALF_PI_F), v3(0, 0, 0.25)), 0x7FC8E8, 1);
    n = block(v, n, v3(-0.12, 0.1, -0.05), v3(0.12, 0.35, 0.25), WHITE, 1);
    return add(v, n, frustum(10, 0.5, 0.7), srt(v3(0.3, 0.15, 0.3), rot_x(HALF_PI_F), v3(0, 0, 0.75)), 0xFF6FA8, 1);
  }
  if t == Tool.staff {
    n = block(v, n, v3(-0.05, -0.05, -0.5), v3(0.05, 0.05, 1.7), SPRINKLES[0], 1);
    for k: 0..<2 {
      z := ifx k == 0 then -0.5f32 else 1.7f32;
      n = add(v, n, sphere(4, 8), srt1(0.1, xf_id(), v3(0, 0, z)), SPRINKLES[0], 1);
    }
    return add(v, n, sphere(5, 8), srt1(0.22, xf_id(), v3(0, 0, 1.75)), GOLD, 1);
  }
  // the keys
  n = add(v, n, torus(12, 4, 0.14, 0.025), translate(v3(0, 0, 0.1)), GOLD, 1);
  for i: 0..<3 {
    a := f32(i) * 0.5 - 0.5;
    n = block(v, n, v3(a * 0.2 - 0.025, -0.3, 0.08), v3(a * 0.2 + 0.025, -0.1, 0.12), GOLD, 1);
  }
  return n;
}

// ---- the little things ----

tn_key :: (v: [] Vtx, n0: int) -> int {
  n := add(v, n0, torus(12, 4, 0.16, 0.05), translate(v3(0, 0.25, 0)), GOLD, 1);
  n = block(v, n, v3(-0.04, -0.3, -0.04), v3(0.04, 0.1, 0.04), GOLD, 1);
  n = block(v, n, v3(0.04, -0.3, -0.03), v3(0.14, -0.22, 0.03), GOLD, 1);
  return block(v, n, v3(0.04, -0.16, -0.03), v3(0.12, -0.09, 0.03), GOLD, 1);
}
// Radius 0.5.
tn_ball :: (colour: u32, v: [] Vtx, n: int) -> int { return add(v, n, sphere(5, 8), xf_id(), colour, 1); }
// Long along +z.
tn_sprinkle :: (colour: u32, v: [] Vtx, n: int) -> int { return block(v, n, v3(-0.04, -0.04, -0.13), v3(0.04, 0.04, 0.13), colour, 0.6); }
// Flat on the floor, radius 0.5.
tn_splat :: (colour: u32, v: [] Vtx, n: int) -> int { return add(v, n, disc(10), xf_id(), colour, 0); }
// An edible cone on the floor.
tn_treat :: (v: [] Vtx, n0: int) -> int {
  n := add(v, n0, frustum(10, 0.03, 0.5), srt(v3(0.32, 0.45, 0.32), xf_id(), v3(0, 0.22, 0)), WAFFLE, 1);
  n = add(v, n, sphere(5, 10), srt1(0.36, xf_id(), v3(0, 0.5, 0)), wall_colour(Flavor.strawberry), 1);
  for i: 0..<5 {
    a := f32(i) * 1.25;
    n = block(v, n, v3(cos(a) * 0.12 - 0.015, 0.62, sin(a) * 0.12 - 0.015), v3(cos(a) * 0.12 + 0.015, 0.66, sin(a) * 0.12 + 0.05), SPRINKLES[i % 5], 0);
  }
  return n;
}
// A cone in flight, point first along +z.
tn_cone_shot :: (v: [] Vtx, n: int) -> int {
  return add(v, n, frustum(8, 0.02, 0.5), srt(v3(0.24, 0.35, 0.24), rot_x(-HALF_PI_F), v3(0, 0, 0)), WAFFLE, 1);
}
tn_button :: (colour: u32, v: [] Vtx, n0: int) -> int {
  n := block(v, n0, v3(-0.22, 0, -0.22), v3(0.22, 0.9, 0.22), WAFFLE_DARK, 1);
  return add(v, n, sphere(4, 10), srt(v3(0.38, 0.18, 0.38), xf_id(), v3(0, 0.92, 0)), colour, 1);
}
tn_cabinet :: (v: [] Vtx, n0: int) -> int {
  n := block(v, n0, v3(-0.5, 0, -0.5), v3(0.5, 0.15, 0.5), WAFFLE_DARK, 1);
  n = block(v, n, v3(-0.5, 2.05, -0.5), v3(0.5, 2.2, 0.5), WAFFLE_DARK, 1);
  posts := [8] f32.[-0.5, -0.5, 0.4, -0.5, -0.5, 0.4, 0.4, 0.4];
  for k: 0..<4 { n = block(v, n, v3(posts[k * 2], 0.15, posts[k * 2 + 1]), v3(posts[k * 2] + 0.1, 2.05, posts[k * 2 + 1] + 0.1), WAFFLE, 1); }
  return n;
}
// The cone you end up in, scooped.
tn_big_cone :: (v: [] Vtx, n: int) -> int { return add(v, n, frustum(12, 0.05, 0.6), srt(v3(1, 1.6, 1), xf_id(), v3(0, 0.8, 0)), WAFFLE, 1); }

// Every model world.cpp uploads (buildModels), in Part order.
tn_part :: (p: Part, v: [] Vtx, n: int) -> int {
  if p == Part.torso { return avatar_torso(v, n); }
  if p == Part.head { return avatar_head(v, n); }
  if p == Part.arm { return avatar_arm(v, n); }
  if p == Part.leg { return avatar_leg(v, n); }
  if p == Part.man_body { return man_body(v, n); }
  if p == Part.man_leg { return man_leg(v, n); }
  if p == Part.man_arm { return man_arm(v, n); }
  if p == Part.man_head { return man_head(v, n); }
  if p == Part.man_forehead { return man_forehead(v, n); }
  if p == Part.key { return tn_key(v, n); }
  if p == Part.fudge { return tn_ball(FUDGE, v, n); }
  if p == Part.cloud { return tn_ball(CLOUD, v, n); }
  if p == Part.sparkle { return tn_ball(0xFFFFFF, v, n); }
  if p == Part.star { return tn_sprinkle(GOLD, v, n); }
  if p == Part.splat { return tn_splat(FUDGE, v, n); }
  if p == Part.drip { return tn_splat(VANILLA, v, n); }
  if p == Part.cone { return tn_big_cone(v, n); }
  if p == Part.treat { return tn_treat(v, n); }
  if p == Part.cone_shot { return tn_cone_shot(v, n); }
  if p == Part.sugar { return tn_ball(0xFFFFFF, v, n); }
  if p == Part.cabinet { return tn_cabinet(v, n); }
  return tn_splat(VANILLA, v, n);
}

// ---- the C face for native checks (test-mesh.sh) ----

icecream_mesh_house :: (g: [] Game, seed: u64, difficulty: s32, yellow: f32, v: [] Vtx, first: [] int) -> int #export_c {
  t := icecream_tuning(difficulty);
  house_of(g, seed, t);
  return tn_house(g, yellow, v, first);
}
icecream_mesh_part :: (part: s32, v: [] Vtx) -> int #export_c { return tn_part(cast(Part) cast(u8) part, v, 0); }
icecream_mesh_tool :: (tool: s32, v: [] Vtx) -> int #export_c { return tn_tool(cast(Tool) cast(u8) tool, v, 0); }
icecream_mesh_button :: (i: s32, v: [] Vtx) -> int #export_c { return tn_button(BUTTON_COLOURS[i], v, 0); }
icecream_mesh_sprinkle :: (i: s32, v: [] Vtx) -> int #export_c { return tn_sprinkle(SPRINKLES[i], v, 0); }
icecream_mesh_duck :: (g: [] Game, x: f32, z: f32) -> f32 #export_c { return duck(g, v2(x, z)); }
icecream_mesh_man_top :: (d: f32) -> f32 #export_c { return man_top(d); }

// ---- checks ----

// FNV-1a over a vertex, as mesh-check.c hashes the C++'s: its position,
// normal and hull on a 1/1024 grid (the evaluator's sine can be an ulp from
// libm's; test-mesh.sh compares every bit natively), its colour and weight.
grid :: (x: f32) -> u64 { return cast,trunc(u64) cast(s64) floor(x * 1024 + 0.5); }
vertex_hash :: (h0: u64, x: Vtx) -> u64 {
  w := [11] u64.[grid(x.p.x), grid(x.p.y), grid(x.p.z), grid(x.n.x), grid(x.n.y), grid(x.n.z),
                 grid(x.hull.x), grid(x.hull.y), grid(x.hull.z), cast(u64) x.colour, cast(u64) f32_bits(x.weight)];
  h := h0;
  for k: 0..<11 { h = wmul64(h ^ w[k], 0x100000001b3); }
  return h;
}
Sums :: struct { hash: u64 = 0xcbf29ce484222325; count: int; lo: V3 = V3.{x = 1000000, y = 1000000, z = 1000000}; hi: V3 = V3.{x = -1000000, y = -1000000, z = -1000000}; }
fold :: (s0: Sums, v: [] Vtx, n: int) -> Sums {
  s := s0;
  for i: 0..<n {
    s.hash = vertex_hash(s.hash, v[i]);
    s.lo = v3min(s.lo, v[i].p);
    s.hi = v3max(s.hi, v[i].p);
  }
  s.count += n;
  return s;
}
near3 :: (a: V3, b: V3) -> bool { return abs(a.x - b.x) < 0.0001 && abs(a.y - b.y) < 0.0001 && abs(a.z - b.z) < 0.0001; }
part_of :: (kind: s32, index: s32, v: [] Vtx) -> int {
  if kind == 0 { return icecream_mesh_part(index, v); }
  if kind == 1 { return icecream_mesh_tool(index, v); }
  if kind == 2 { return icecream_mesh_button(index, v); }
  return icecream_mesh_sprinkle(index, v);
}

#test "models: the demo's counts, bounds and vertices" {
  v: [4096] Vtx;
  for k: 0..<ORACLE_PARTS.count {
    o := ORACLE_PARTS[k];
    n := part_of(o.kind, o.index, v[..]);
    s: Sums;
    s = fold(s, v[..], n);
    #assert n == o.count;
    #assert near3(s.lo, o.lo) && near3(s.hi, o.hi);
    #assert s.hash == o.hash;
  }
}

// The oracle's houses, two to a check: the compile-time traversal budget is per check.
house_matches_oracle :: (k: int) {
  games: [1] Game;
  g := games[..];
  v: [9000] Vtx;
  o := ORACLE_HOUSES[k];
  house_of(g, o.seed, icecream_tuning(o.difficulty));
  #assert g[0].house.room_n == o.rooms;
  s: Sums;
  for i: 0..<o.rooms {
    n := tn_room(g, i, o.yellow, v[..], 0);
    #assert n <= v.count;
    if i == 0 { #assert n == o.first_room; }
    s = fold(s, v[..], n);
  }
  for i: 0..<o.rooms { s = fold(s, v[..], tn_lights(g, i, o.yellow, v[..], 0)); }
  #assert s.count == o.count && s.hash == o.hash && near3(s.lo, o.lo) && near3(s.hi, o.hi);
}
#test "house: the demo's rooms and lights for a set of seeds" { #assert ORACLE_HOUSES.count == 10; house_matches_oracle(0); house_matches_oracle(1); }
#test "house: the demo's rooms and lights, seeds 3 and 4 of the set" { house_matches_oracle(2); house_matches_oracle(3); }
#test "house: the demo's rooms and lights, seeds 5 and 6 of the set" { house_matches_oracle(4); house_matches_oracle(5); }
#test "house: the demo's rooms and lights, seeds 7 and 8 of the set" { house_matches_oracle(6); house_matches_oracle(7); }
#test "house: the demo's rooms and lights, seeds 9 and 10 of the set" { house_matches_oracle(8); house_matches_oracle(9); }

#test "house: the same seed builds the same geometry, another seed another" {
  games: [3] Game;
  a := games[0..<1];
  b := games[1..<2];
  c := games[2..<3];
  t := tuning_for(Difficulty.easy);
  house_of(a, 9, t);
  house_of(b, 9, t);
  house_of(c, 10, t);
  // one buffer (the compile-time storage cap holds one of 9000): each room is folded as it is built
  v: [9000] Vtx;
  same := true;
  differ := false;
  for i: 0..<6 {
    na := tn_room(a, i, 0, v[..], 0);
    sa: Sums;
    ha := fold(sa, v[..], na).hash;
    nb := tn_room(b, i, 0, v[..], 0);
    #assert na == nb;
    sb: Sums;
    if fold(sb, v[..], nb).hash != ha { same = false; }
    nc := tn_room(c, i, 0, v[..], 0);
    sc: Sums;
    if nc != na || fold(sc, v[..], nc).hash != ha { differ = true; }
  }
  #assert same && differ;
}

#test "a full view keeps counting, and writes nothing past its end" {
  games: [1] Game;
  g := games[..];
  house_of(g, 4, tuning_for(Difficulty.easy));
  big: [9000] Vtx;
  small: [12] Vtx;
  n := tn_room(g, 2, 1, big[..], 0);
  #assert tn_room(g, 2, 1, small[..], 0) == n && n > small.count;
  first: [3] int;
  total := tn_house(g, 1, small[..], first[..]);
  #assert first[0] == 0 && first[1] > 0 && first[2] > first[1] && total > first[2];
}

#test "he ducks under a doorway's lintel, and stands up in the room" {
  games: [1] Game;
  g := games[..];
  house_of(g, 5, tuning_for(Difficulty.normal));
  h := g[0].house;
  found := false;
  for i: 0..<h.room_n {
    if found { break; }
    r := h.rooms[i];
    if !r.doors[cast(int) Side.south] { continue; }
    nb := neighbour(g, r.at, Side.south);
    if cell_eq(nb, NO_CELL) { continue; }
    mid := doorway(r.at, nb);
    #assert duck(g, mid) == 1 && duck(g, v2(mid.x, mid.z - 5)) == 0;
    found = true;
  }
  #assert found;
  #assert man_top(0) == KMAN_HEIGHT && man_top(1) < 2 && man_top(-3) == man_top(0) && man_top(4) == man_top(1);
}
