// Ice Cream Man's play loop for the realm: world.cpp's App around the
// rules, ported. The keys, the mouse, two thumbs and the HUD's buttons
// become the rules' Input once a step (30 a second, as the demo's two
// engine steps a rules step); the camera follows (camera.coax: drag to
// orbit, the wheel, Shift Lock on Control, V for first person); each step's
// events become words for the HUD, hurt flashes and bits flying; the kid,
// the Ice Cream Man and his minions animate as world.cpp's animate does.
// scene.coax draws it.
//
// Every step's input is kept as a trace line in the format of the Rust
// build's recorder (trace-text.coax), with the state fingerprint and events
// after it, so a round played in the browser replays in the rules tests
// (verse/icecream/replay.c, browser-trace.sh) step for step.
//   coax/bin/coax test verse/icecream/play.coax --library --steps 4000000000
#load "camera.coax";
#load "trace-text.coax";

// The keys the host sends (coax/web/host.js KEYS): a code point, or a named key.
PK_ESCAPE :: -1; PK_ENTER :: -2; PK_LEFT :: -4; PK_RIGHT :: -5; PK_UP :: -6; PK_DOWN :: -7; PK_SHIFT :: -13; PK_CONTROL :: -14;
// What is held, a bit each.
H_W :: 1; H_A :: 2; H_S :: 4; H_D :: 8; H_UP :: 16; H_DOWN :: 32; H_LEFT :: 64; H_RIGHT :: 128;
H_SPACE :: 256; H_SHIFT :: 512; H_E :: 1024;
LETTERS :: H_W | H_A | H_S | H_D | H_E;

STICK_REACH :: 28.0f32;     // CSS pixels
ENDING :: 1.8f32;
SCARE :: 1.2f32;
SCARE_HIT :: 0.42f32;
MAX_PARTICLES :: 120;
TRACE_CAP :: 3000000;
STEP :: 0.0333333333f32;

Phase :: enum u8 { title; playing; menu; ending; over; }
// The HUD's buttons and the page's acts (world.cpp act).
A_MENU :: 1; A_RESUME :: 2; A_NEW_HOUSE :: 3; A_KEEP :: 4; A_CYCLE :: 5; A_SELECT :: 6; A_VIEW :: 7;
A_HELD :: 8; A_TIMER :: 9; A_JUMPSCARES :: 10; A_DIFFICULTY :: 11; A_SPRINT_MODE :: 12; A_TOUR :: 13;
A_TOUR_NEXT :: 14; A_TOUR_BACK :: 15; A_TOUR_END :: 16; A_PLAY :: 17;
HOLD_JUMP :: 0; HOLD_FIRE :: 1; HOLD_USE :: 2; HOLD_SPRINT :: 3;

// The words the HUD shows for a moment (world.cpp toast), by kind; n is a count or a Tool.
Toast :: enum u8 {
  none; note; weapons; free_roam; frozen; fart_hit; jingle; empty; pulled_out; spotted; lost; found_all; keys;
  cloud; fudge; hid; locked; guarded; melted; friends; minion_came; minion_bite; earned; cone_dropped;
  cone_eaten; boost_over; button; puzzle_wrong; puzzle_solved; cabinet_locked; shift_on; shift_off;
  first_person; third_person;
}

PartKind :: enum u8 { splat; drip; blob; beam; puff; }
Particle :: struct { pos: V3; vel: V3; age: f32; life: f32; size: f32; kind: PartKind; }

Options :: struct {
  seed: u64; has_seed: bool;
  bot: bool; calm: bool; arm: bool; free_roam: bool; first_person: bool; cone: bool; no_farts: bool;
  // the realm's board (docs/verse/realm-edit.md), from the next house: no minions, no weapons to earn
  // or spear puzzle, no backrooms
  no_minions: bool; no_weapons: bool; no_backrooms: bool;
  trace: bool; trace_at: u64;
  difficulty: Difficulty = Difficulty.normal;
}

SAVE_CAP :: 320;
Play :: struct {
  started: bool;
  options: Options;
  seed: u64;
  difficulty: Difficulty = Difficulty.normal;
  next_difficulty: Difficulty = Difficulty.normal;
  phase: Phase = Phase.playing;
  tour: int = -1;
  end_t: f32;
  suspended: bool;
  touch: bool;
  camera: Camera;
  space: [1] Space;
  boom: Boom;
  held: u32; taps: u32; click: bool; fire: bool;
  select: s8 = -1;
  sprint_toggle: bool; sprint_held: bool; touch_jump: bool; touch_fire: bool; touch_use: bool;
  timer_on: bool = true; jumpscares: bool = true; sprint_tap: bool;
  // the mouse: where it is, and a drag that orbits
  mouse_on: bool; mouse_x: f32; mouse_y: f32;
  press_on: bool; press_x: f32; press_y: f32; dragged: bool;
  stick_on: bool; stick_id: int; stick_cx: f32; stick_cy: f32; stick_dx: f32; stick_dy: f32;
  look_on: bool; look_id: int; look_x: f32; look_y: f32;
  width: f32 = 1; height: f32 = 1; dpr: f32 = 1;
  view: View; aspect: f32 = 1; have_view: bool;
  time: f32; hurt: f32; daylight: f32; yaw: f32; man_yaw: f32; stride: f32; man_stride: f32; man_duck: f32;
  frame_dt: f32; drip_wait: f32; man_hit: f32; swing: f32; minion_stride: f32;
  spotted: u32;
  best: [3] f32; new_best: bool;
  toast: Toast; toast_n: u32; toast_count: u32;
  particles: [MAX_PARTICLES] Particle; particle_n: int;
  acc: f32;
  stepped: u64;
  bots: [1] Bot;
  trace: [TRACE_CAP] u8; trace_n: int; trace_full: bool; trace_sent: bool; trace_want: bool;
  seen_tour: bool; save_want: bool; save: [SAVE_CAP] u8; save_n: int;
  // the house's own tuning, before the board; the board's minions and weapons it was played with;
  // whether the board eased this run at any point (then it doesn't count for the best time)
  house_tuning: Tuning; board_minions_off: bool; board_weapons_off: bool; board_eased: bool;
}

// ---- small things

wrap_angle :: (a: f32) -> f32 { return a - TAU_F * roundf(a / TAU_F); }
approach_angle :: (v: f32, target: f32, rate: f32, step: f32) -> f32 { return v + wrap_angle(target - v) * (1 - exp(-rate * step)); }
say :: (p: [] Play, t: Toast, n: u32) { p[0].toast = t; p[0].toast_n = n; p[0].toast_count += 1; }
add_particle :: (p: [] Play, q: Particle) {
  if p[0].particle_n >= MAX_PARTICLES {
    for i: 1..<MAX_PARTICLES { p[0].particles[i - 1] = p[0].particles[i]; }
    p[0].particle_n = MAX_PARTICLES - 1;
  }
  p[0].particles[p[0].particle_n] = q;
  p[0].particle_n += 1;
}
particle_of :: (pos: V3, vel: V3, life: f32, size: f32, kind: PartKind) -> Particle {
  return Particle.{pos = pos, vel = vel, age = 0, life = life, size = size, kind = kind};
}
lower_key :: (key: int) -> int { return ifx key >= 'A' && key <= 'Z' then key + 32 else key; }
key_bit :: (key: int) -> u32 {
  k := lower_key(key);
  if k == 'w' { return H_W; } if k == 'a' { return H_A; } if k == 's' { return H_S; } if k == 'd' { return H_D; }
  if k == 'e' { return H_E; } if k == ' ' { return H_SPACE; } if k == PK_SHIFT { return H_SHIFT; }
  if k == PK_UP { return H_UP; } if k == PK_DOWN { return H_DOWN; } if k == PK_LEFT { return H_LEFT; } if k == PK_RIGHT { return H_RIGHT; }
  return 0;
}
holding :: (p: [] Play, bits: u32) -> bool { return ((p[0].held | p[0].taps) & bits) != 0; }

// ---- the trace

put_hex :: (out: [] u8, at: int, v: u64) -> int {
  if v == 0 { out[at] = '0'; return at + 1; }
  digits: [16] u8;
  n := 0;
  x := v;
  while x != 0 {
    d := cast(u8) (x & 15);
    digits[n] = ifx d < 10 then '0' + d else 'a' + d - 10;
    n += 1;
    x = x >> 4;
  }
  for i: 0..<n { out[at + i] = digits[n - 1 - i]; }
  return at + n;
}
put_u64 :: (out: [] u8, at: int, v: u64) -> int {
  digits: [20] u8;
  n := 0;
  x := v;
  while true {
    digits[n] = '0' + cast(u8) (x % 10);
    n += 1;
    x /= 10;
    if x == 0 { break; }
  }
  for i: 0..<n { out[at + i] = digits[n - 1 - i]; }
  return at + n;
}
trace_put :: (p: [] Play, s: string) {
  if p[0].trace_n + s.count + 1 > TRACE_CAP { p[0].trace_full = true; return; }
  p[0].trace_n = put_text(p[0].trace[..], p[0].trace_n, s);
}
DIFFICULTY_IDS :: [3] string.["easy", "normal", "hard"];
trace_begin :: (p: [] Play, g: [] Game) {
  p[0].trace_n = 0; p[0].trace_full = false; p[0].trace_sent = false; p[0].trace_want = false;
  trace_put(p, "icecream-trace 1\nname browser\nseed ");
  buf: [32] u8;
  n := put_u64(buf[..], 0, p[0].seed);
  trace_put(p, cast(string) buf[0..<n]);
  trace_put(p, "\ndifficulty ");
  trace_put(p, DIFFICULTY_IDS[cast(int) p[0].difficulty]);
  trace_put(p, ifx g[0].man_on then "\nman 1\n" else "\nman 0\n");
  if p[0].options.arm { trace_put(p, "arm\n"); }
  trace_put(p, ifx p[0].options.bot then "driver bot\n" else "driver browser\n");
}
trace_step :: (p: [] Play, g: [] Game, in: Input) {
  if p[0].trace_full { return; }
  line: [4096] u8;
  n := put_hex(line[..], 0, cast(u64) f32_bits(in.walk.x));
  n = put_text(line[..], n, " "); n = put_hex(line[..], n, cast(u64) f32_bits(in.walk.z));
  n = put_text(line[..], n, " ");
  flags := n;
  if in.sprint { n = put_text(line[..], n, "s"); }
  if in.jump { n = put_text(line[..], n, "j"); }
  if in.fire { n = put_text(line[..], n, "f"); }
  if in.interact { n = put_text(line[..], n, "i"); }
  if n == flags { n = put_text(line[..], n, "-"); }
  n = put_text(line[..], n, " "); n = put_hex(line[..], n, cast(u64) f32_bits(in.aim.x));
  n = put_text(line[..], n, " "); n = put_hex(line[..], n, cast(u64) f32_bits(in.aim.z));
  n = put_text(line[..], n, " ");
  if in.select < 0 { n = put_text(line[..], n, "-"); } else { n = put_u64(line[..], n, cast(u64) in.select); }
  n = put_text(line[..], n, " "); n = put_hex(line[..], n, fingerprint(g));
  words: [256] u8;
  for i: 0..<g[0].event_n {
    k := event_text(g[0].events[i], words[..]);
    if n + k + 2 >= line.count { break; }
    n = put_text(line[..], n, " ");
    n = put_text(line[..], n, cast(string) words[0..<k]);
  }
  n = put_text(line[..], n, "\n");
  trace_put(p, cast(string) line[0..<n]);
}
// The trace so far, for the page (action 30): once at a round's end, or at
// the step #trace=N names.
ice_trace_ready :: (p: [] Play) -> bool #export_c { return p[0].trace_want && !p[0].trace_sent; }
ice_trace_sent :: (p: [] Play) #export_c { p[0].trace_sent = true; }

// ---- the address's options (world.cpp Options): seed=N, bot, calm, arm,
// freeroam, fp, cone, nofarts, trace[=STEPS], easy, hard

word_is :: (text: string, at: int, end: int, w: string) -> bool { return end - at == w.count && text[at..<end] == w; }
number_of :: (text: string, at: int, end: int) -> u64 {
  v: u64 = 0;
  i := at;
  while i < end && i - at < 18 && text[i] >= '0' && text[i] <= '9' { v = v * 10 + cast(u64) (text[i] - '0'); i += 1; }
  return v;
}
options_of :: (text: string) -> Options {
  o: Options;
  at := 0;
  while at <= text.count {
    end := at;
    while end < text.count && text[end] != '&' { end += 1; }
    eq := at;
    while eq < end && text[eq] != '=' { eq += 1; }
    valued := eq < end;
    if word_is(text, at, eq, "seed") && valued && eq + 1 < end && text[eq + 1] >= '0' && text[eq + 1] <= '9' { o.seed = number_of(text, eq + 1, end); o.has_seed = true; }
    if word_is(text, at, eq, "bot") { o.bot = true; }
    if word_is(text, at, eq, "calm") { o.calm = true; }
    if word_is(text, at, eq, "arm") { o.arm = true; }
    if word_is(text, at, eq, "freeroam") { o.free_roam = true; }
    if word_is(text, at, eq, "fp") { o.first_person = true; }
    if word_is(text, at, eq, "cone") { o.cone = true; }
    if word_is(text, at, eq, "nofarts") { o.no_farts = true; }
    if word_is(text, at, eq, "easy") { o.difficulty = Difficulty.easy; }
    if word_is(text, at, eq, "hard") { o.difficulty = Difficulty.hard; }
    if word_is(text, at, eq, "trace") { o.trace = true; if valued { o.trace_at = number_of(text, eq + 1, end); } }
    at = end + 1;
  }
  return o;
}

// ---- the run's life (world.cpp newRun, startPlaying)

// The realm's board (docs/verse/realm-edit.md) over a house's tuning.
board_tuning :: (o: Options, t: Tuning) -> Tuning {
  tuned := t;
  if o.no_minions { tuned = change(tuned, "minion_count", 0); tuned = change(tuned, "minion_growth", 0); }
  if o.no_weapons { tuned = change(tuned, "earned_weapons", 0); tuned = change(tuned, "puzzle_key", 0); }
  if o.no_backrooms { tuned = change(tuned, "backrooms", 0); }
  return tuned;
}

// The board switched while a house is played (the realm's EDIT): its minions and weapons change at
// once (minions off melts the enemy ones there are; on, they come as the house's tuning says); its
// backrooms are the house's shape, so they change from the next house.
board_now :: (p: [] Play, g: [] Game) {
  o := p[0].options;
  if o.no_minions || o.no_weapons || o.no_backrooms { p[0].board_eased = true; }
  if !p[0].started || o.calm { return; }
  if o.no_minions == p[0].board_minions_off && o.no_weapons == p[0].board_weapons_off { return; }
  if o.no_minions && !p[0].board_minions_off { g[0].minion_n = board_melt(g[0].minions[..], g[0].minion_n); }
  p[0].board_minions_off = o.no_minions; p[0].board_weapons_off = o.no_weapons;
  g[0].tuning = board_live(o, p[0].house_tuning, g[0].tuning);
}
// The house's tuning as played, with the board's minions and weapons.
board_live :: (o: Options, house: Tuning, live: Tuning) -> Tuning {
  t := board_tuning(o, house);
  out := live;
  out.minion_count = t.minion_count; out.minion_growth = t.minion_growth; out.earned_weapons = t.earned_weapons;
  return out;
}
// Minions off: the enemy ones melt, the friendly ones stay; the count left.
board_melt :: (m: [] Minion, n: int) -> int {
  kept := 0;
  for i: 0..<n { if m[i].friendly { m[kept] = m[i]; kept += 1; } }
  return kept;
}

DEFAULT_SEED :: 3;
new_run :: (p: [] Play, g: [] Game) {
  o := p[0].options;
  p[0].seed = ifx o.has_seed then o.seed else ifx p[0].stepped == 0 && p[0].seed == 0 then DEFAULT_SEED else p[0].seed + 1;
  if p[0].seed == 0 && !o.has_seed { p[0].seed = DEFAULT_SEED; }
  p[0].difficulty = p[0].next_difficulty;
  p[0].house_tuning = tuning_for(p[0].difficulty);
  p[0].board_minions_off = o.no_minions; p[0].board_weapons_off = o.no_weapons;
  p[0].board_eased = o.no_minions || o.no_weapons || o.no_backrooms;
  game_new(g, p[0].seed, !o.calm, board_tuning(o, p[0].house_tuning));
  if o.no_farts { g[0].player.farts = 0; }
  if o.arm { game_arm(g); }
  if o.free_roam {
    g[0].status = Status.escaped; g[0].won = Status.escaped;
    kept := game_keep_playing(g);
    if kept { g[0].event_n = 0; }
  }
  if o.cone { add_drop(g, Drop.{at = vadd(g[0].player.pos, vmul(g[0].player.facing, 2)), kind = DropKind.cone, tool = Tool.sword, age = 0}); }
  space_of(g, p[0].space[..]);
  fresh: Bot;
  p[0].bots[0] = fresh;
  c: Camera;
  p[0].yaw = yaw_of(g[0].player.facing);
  c.yaw = p[0].yaw;
  p[0].camera = c;
  if o.first_person || g[0].tuning.first_person == 1 { p[0].camera = cam_toggle_view(p[0].camera); }
  nb: Boom;
  p[0].boom = nb;
  p[0].man_yaw = 0; p[0].particle_n = 0; p[0].spotted = 0; p[0].hurt = 0; p[0].daylight = 0; p[0].select = -1;
  p[0].acc = 0; p[0].end_t = 0; p[0].new_best = false;
  trace_begin(p, g);
}
start_playing :: (p: [] Play, g: [] Game) {
  p[0].phase = Phase.playing;
  say(p, ifx g[0].free_roam then Toast.free_roam else ifx weapons_on(g) then Toast.weapons else Toast.note, 0);
}
let_go :: (p: [] Play) {
  p[0].held = 0; p[0].taps = 0; p[0].fire = false; p[0].click = false; p[0].press_on = false;
  p[0].touch_fire = false; p[0].touch_jump = false; p[0].touch_use = false; p[0].sprint_held = false;
  p[0].stick_on = false; p[0].look_on = false;
}
play_reset :: (p: [] Play, g: [] Game) {
  if !p[0].started {
    p[0].tour = ifx p[0].options.bot || p[0].options.trace || p[0].seen_tour then -1 else 0;
    p[0].timer_on = true; p[0].jumpscares = true;
  }
  p[0].started = true;
  p[0].next_difficulty = p[0].options.difficulty;
  new_run(p, g);
  start_playing(p, g);
}
// The address's options; a changed seed (or anything else) starts a new run.
ice_play_hash :: (p: [] Play, g: [] Game, text: string) #export_c {
  o := options_of(text);
  p[0].options = o;
  p[0].seed = 0;
  p[0].stepped = 0;
  play_reset(p, g);
  if o.bot || o.trace { p[0].tour = -1; }
}
ice_play_seed :: (p: [] Play, g: [] Game) -> u64 #export_c { if !p[0].started { play_reset(p, g); } return p[0].seed; }

cycle_tool :: (g: [] Game, current: Tool, back: bool) -> s8 {
  owned: [TOOLS] int;
  n := 0;
  at := 0;
  for t: 0..<TOOLS { if g[0].player.owned[t] { if t == cast(int) current { at = n; } owned[n] = t; n += 1; } }
  if n < 2 { return -1; }
  return cast(s8) owned[ifx back then (at + n - 1) % n else (at + 1) % n];
}
nth_tool :: (g: [] Game, i: int) -> s8 {
  n := 0;
  for t: 0..<TOOLS { if g[0].player.owned[t] { if n == i { return cast(s8) t; } n += 1; } }
  return -1;
}
toggle_view :: (p: [] Play) {
  p[0].camera = cam_toggle_view(p[0].camera);
  say(p, ifx cam_first_person(p[0].camera) then Toast.first_person else Toast.third_person, 0);
}
set_shift_lock :: (p: [] Play, on: bool) { p[0].camera.shift_lock = on; say(p, ifx on then Toast.shift_on else Toast.shift_off, 0); }

// The HUD's buttons and the page's acts (world.cpp act).
ice_play_act :: (p: [] Play, g: [] Game, a: int, arg: int) #export_c {
  if !p[0].started { play_reset(p, g); }
  if a == A_PLAY { start_playing(p, g); }
  else if a == A_RESUME { if p[0].phase == Phase.menu { p[0].phase = Phase.playing; } }
  else if a == A_MENU {
    if p[0].phase == Phase.playing { p[0].phase = Phase.menu; let_go(p); }
    else if p[0].phase == Phase.menu { p[0].phase = Phase.playing; }
  }
  else if a == A_NEW_HOUSE { p[0].options.has_seed = false; new_run(p, g); start_playing(p, g); }
  else if a == A_TOUR { p[0].tour = 0; let_go(p); }
  else if a == A_TOUR_NEXT { p[0].tour = ifx p[0].tour >= 0 && p[0].tour + 1 < 4 then p[0].tour + 1 else -1; if p[0].tour < 0 { seen_tour(p); } }
  else if a == A_TOUR_BACK { if p[0].tour > 0 { p[0].tour -= 1; } }
  else if a == A_TOUR_END { p[0].tour = -1; seen_tour(p); }
  else if a == A_SELECT { if arg >= 0 && arg < TOOLS && g[0].player.owned[arg] { p[0].select = cast(s8) arg; } }
  else if a == A_KEEP {
    if game_keep_playing(g) {
      p[0].daylight = 0; p[0].phase = Phase.playing; say(p, Toast.free_roam, 0);
      trace_put(p, "keep\n");
    }
  }
  else if a == A_CYCLE {
    if p[0].phase == Phase.playing {
      cur := ifx p[0].select >= 0 then cast(Tool) cast(u8) p[0].select else g[0].player.tool;
      t := cycle_tool(g, cur, arg != 0);
      if t >= 0 { p[0].select = t; }
    }
  }
  else if a == A_TIMER { p[0].timer_on = !p[0].timer_on; p[0].save_want = true; }
  else if a == A_JUMPSCARES { p[0].jumpscares = !p[0].jumpscares; p[0].save_want = true; }
  else if a == A_DIFFICULTY { d := cast(int) p[0].next_difficulty; p[0].next_difficulty = cast(Difficulty) cast(u8) ((d + 1) % 3); p[0].save_want = true; }
  else if a == A_SPRINT_MODE { p[0].sprint_tap = !p[0].sprint_tap; p[0].sprint_toggle = false; p[0].sprint_held = false; p[0].save_want = true; }
  else if a == A_VIEW { toggle_view(p); }
  else if a == A_HELD {
    hold := arg / 2;
    down := arg % 2 == 1;
    if hold == HOLD_JUMP { p[0].touch_jump = down; }
    else if hold == HOLD_FIRE { p[0].touch_fire = down; }
    else if hold == HOLD_USE { p[0].touch_use = down; }
    else if hold == HOLD_SPRINT {
      if p[0].sprint_tap { if down { p[0].sprint_toggle = !p[0].sprint_toggle; } }
      else { p[0].sprint_held = down; }
    }
  }
}

// ---- keys (world.cpp keyDown, keyUp)

ice_play_key :: (p: [] Play, g: [] Game, key: int, down: bool, mods: int) -> bool #export_c {
  if !p[0].started { play_reset(p, g); }
  k := lower_key(key);
  if !down {
    p[0].held &= 0xFFFFFFFF ^ key_bit(k);
    if k == PK_SHIFT { p[0].held &= 0xFFFFFFFF ^ LETTERS; }
    return key_bit(k) != 0;
  }
  if p[0].tour >= 0 {
    if k == PK_ESCAPE { ice_play_act(p, g, A_TOUR_END, 0); }
    else if k == PK_RIGHT || k == PK_ENTER { ice_play_act(p, g, A_TOUR_NEXT, 0); }
    else if k == PK_LEFT { ice_play_act(p, g, A_TOUR_BACK, 0); }
    return true;
  }
  if k == '?' { ice_play_act(p, g, A_TOUR, 0); return true; }
  if k == PK_ESCAPE { if p[0].phase == Phase.playing || p[0].phase == Phase.menu { ice_play_act(p, g, A_MENU, 0); return true; } return false; }
  if p[0].phase != Phase.playing { return false; }
  if k == PK_CONTROL { set_shift_lock(p, !p[0].camera.shift_lock); return true; }
  if k >= '1' && k <= '8' { p[0].select = nth_tool(g, k - '1'); return true; }
  if k == 'v' { toggle_view(p); return true; }
  if k == 'q' { ice_play_act(p, g, A_CYCLE, ifx (mods & 1) != 0 then 1 else 0); return true; }
  b := key_bit(k);
  if b != 0 { p[0].held |= b; p[0].taps |= b; return true; }
  return false;
}
ice_play_blur :: (p: [] Play) #export_c { let_go(p); }
ice_play_wheel :: (p: [] Play, dy: f32) #export_c { p[0].camera = cam_wheel(p[0].camera, dy); }
ice_play_suspend :: (p: [] Play, on: bool) #export_c {
  p[0].suspended = on;
  if on { if p[0].phase == Phase.playing { p[0].phase = Phase.menu; } let_go(p); }
}

// ---- pointers (world.cpp pointer). The mouse: a press fires; a drag
// orbits the camera (and lets the fire go). A finger: in the stick it walks
// (the HUD says where its centre is), anywhere else it looks.
ZONE_LOOK :: 0; ZONE_STICK :: 1;
ice_play_pointer :: (p: [] Play, g: [] Game, x: f32, y: f32, phase: int, kind: int, id: int, zone: int, cx: f32, cy: f32) #export_c {
  if !p[0].started { play_reset(p, g); }
  k := p[0].dpr;
  reach := STICK_REACH * k;
  if kind != 0 {
    p[0].touch = true;
    if phase == 0 {
      if p[0].phase != Phase.playing { return; }
      if zone == ZONE_STICK && !p[0].stick_on {
        dx := x - cx; dy := y - cy;
        s := cmin(reach / cmax(sqrt(dx * dx + dy * dy), 1), 1);
        p[0].stick_on = true; p[0].stick_id = id; p[0].stick_cx = cx; p[0].stick_cy = cy; p[0].stick_dx = dx * s; p[0].stick_dy = dy * s;
      } else if !p[0].look_on { p[0].look_on = true; p[0].look_id = id; p[0].look_x = x; p[0].look_y = y; }
    } else if phase == 1 {
      if p[0].stick_on && p[0].stick_id == id {
        dx := x - p[0].stick_cx; dy := y - p[0].stick_cy;
        s := cmin(reach / cmax(sqrt(dx * dx + dy * dy), 1), 1);
        p[0].stick_dx = dx * s; p[0].stick_dy = dy * s;
      } else if p[0].look_on && p[0].look_id == id {
        p[0].camera = cam_orbit(p[0].camera, (x - p[0].look_x) * 1.3 / k, (y - p[0].look_y) * 1.3 / k);
        p[0].look_x = x; p[0].look_y = y;
      }
    } else {
      if p[0].stick_on && p[0].stick_id == id { p[0].stick_on = false; }
      if p[0].look_on && p[0].look_id == id {
        if phase == 2 { p[0].camera = cam_orbit(p[0].camera, (x - p[0].look_x) * 1.3 / k, (y - p[0].look_y) * 1.3 / k); }
        p[0].look_on = false;
      }
    }
    return;
  }
  p[0].touch = false;
  p[0].mouse_on = true; p[0].mouse_x = x; p[0].mouse_y = y;
  if phase == 0 {
    if p[0].phase != Phase.playing { return; }
    p[0].fire = true; p[0].click = true;
    p[0].press_on = true; p[0].press_x = x; p[0].press_y = y; p[0].dragged = false;
  } else if phase == 1 {
    if p[0].press_on {
      if !p[0].dragged && abs(x - p[0].press_x) + abs(y - p[0].press_y) > 5 * k { p[0].dragged = true; p[0].fire = false; }
      if p[0].dragged { p[0].camera = cam_orbit(p[0].camera, (x - p[0].press_x) / k, (y - p[0].press_y) / k); }
      p[0].press_x = x; p[0].press_y = y;
    }
  } else {
    p[0].fire = false; p[0].press_on = false;
  }
}

// ---- this step's input (world.cpp input)

axis_of_keys :: (plus: bool, minus: bool) -> f32 { return (ifx plus then 1.0f32 else 0.0f32) - (ifx minus then 1.0f32 else 0.0f32); }
play_input :: (p: [] Play, g: [] Game) -> Input {
  if p[0].options.bot { return bot_input(g, p[0].bots[..]); }
  ahead := axis_of_keys(holding(p, H_W | H_UP), holding(p, H_S | H_DOWN));
  side := axis_of_keys(holding(p, H_D | H_RIGHT), holding(p, H_A | H_LEFT));
  if p[0].stick_on {
    reach := STICK_REACH * p[0].dpr;
    ahead -= p[0].stick_dy / reach;
    side += p[0].stick_dx / reach;
  }
  c := p[0].camera;
  walk := cam_walk(c, clampf(ahead, -1, 1), clampf(side, -1, 1));
  player := g[0].player;
  aim := player.facing;
  if cam_aims(c) {
    aim = cam_forward(c);
  } else if p[0].mouse_on && p[0].have_view && !p[0].touch {
    v := p[0].view;
    f := v3norm(v3sub(v.target, v.eye));
    rt := v3norm(v3cross(f, TN_Y));
    up := v3cross(rt, f);
    half := tan(cam_fov(p[0].aspect) * 0.5);
    nx := 2 * p[0].mouse_x / p[0].width - 1;
    ny := 1 - 2 * p[0].mouse_y / p[0].height;
    d := v3add(f, v3add(v3mul(rt, nx * half * p[0].aspect), v3mul(up, ny * half)));
    hit := ray_to_height(v.eye, d, 1.1);
    aim = ifx hit.ok then norm2(vsub(hit.at, player.pos)) else cam_forward(c);
  }
  // A little help: snap to him, or a minion of his, when nearly in line.
  cone: f32 = ifx cam_aims(c) then 0.97f32 else 0.85f32;
  best_dot: f32 = -2;
  has_best := false;
  best := aim;
  for i: 0..<g[0].minion_n + 1 {
    at: V2;
    if i < g[0].minion_n {
      if g[0].minions[i].friendly { continue; }
      at = g[0].minions[i].pos;
    } else {
      if !man_here(g) { continue; }
      at = g[0].man.pos;
    }
    if dist2(at, player.pos) >= 18 { continue; }
    d := norm2(vsub(at, player.pos));
    k := dot2(aim, d);
    if k > cone && k >= best_dot { best_dot = k; best = d; has_best = true; }
  }
  if has_best { aim = best; }
  in: Input;
  in.walk = walk;
  in.sprint = holding(p, H_SHIFT) || p[0].sprint_toggle || p[0].sprint_held;
  in.jump = holding(p, H_SPACE) || p[0].touch_jump;
  in.fire = p[0].fire || p[0].touch_fire || p[0].click;
  in.aim = aim;
  in.interact = holding(p, H_E) || p[0].touch_use;
  in.select = p[0].select;
  return in;
}

// ---- a step's events (world.cpp effect)

effect :: (p: [] Play, g: [] Game, e: Event) {
  k := e.kind;
  if k == EventKind.fudge_hit {
    p[0].man_hit = 0.25;
    at := g[0].man.pos;
    for i: 0..<5 {
      a := f32(i) * 1.3;
      add_particle(p, particle_of(v3(at.x, 1.6, at.z), v3(cos(a) * 1.5, 2, sin(a) * 1.5), 0.6, 0.14, PartKind.blob));
    }
  }
  else if k == EventKind.fudge_splat { add_particle(p, particle_of(v3(e.a.x, 0.02, e.a.z), v3splat(0), 4, 0.5, PartKind.splat)); }
  else if k == EventKind.frozen { say(p, Toast.frozen, 0); }
  else if k == EventKind.fart_hit { say(p, Toast.fart_hit, 0); }
  else if k == EventKind.jingle { say(p, Toast.jingle, 0); }
  else if k == EventKind.empty {
    t := cast(Tool) cast(u8) e.n;
    if t == Tool.fudge || t == Tool.fart || t == Tool.pistol || t == Tool.sugar { say(p, Toast.empty, 0); }
  }
  else if k == EventKind.sprinkle_hit { p[0].hurt = cmax(p[0].hurt, 0.5); }
  else if k == EventKind.grabbed || k == EventKind.pulled_out {
    p[0].hurt = 1;
    if k == EventKind.pulled_out { say(p, Toast.pulled_out, 0); }
  }
  else if k == EventKind.spotted { p[0].spotted += 1; say(p, Toast.spotted, 0); }
  else if k == EventKind.lost { say(p, Toast.lost, 0); }
  else if k == EventKind.key { say(p, ifx e.n >= 3 then Toast.found_all else Toast.keys, e.n); }
  else if k == EventKind.picked_up { say(p, ifx e.n == cast(u32) Pickup.fart then Toast.cloud else Toast.fudge, 0); }
  else if k == EventKind.hid { say(p, Toast.hid, 0); }
  else if k == EventKind.door_locked { say(p, Toast.locked, 0); }
  else if k == EventKind.door_guarded { say(p, Toast.guarded, 0); }
  else if k == EventKind.melted { if g[0].free_roam { say(p, Toast.melted, 0); } }
  else if k == EventKind.swing { p[0].swing = 0.25; }
  else if k == EventKind.sugar_burst { add_particle(p, particle_of(v3(e.a.x, 1, e.a.z), v3splat(0), 0.8, g[0].tuning.sugar_radius, PartKind.puff)); }
  else if k == EventKind.staff { add_particle(p, particle_of(v3(e.a.x, 1.2, e.a.z), v3(e.b.x - e.a.x, 0, e.b.z - e.a.z), 0.7, 1, PartKind.beam)); }
  else if k == EventKind.friends_came { say(p, Toast.friends, 0); }
  else if k == EventKind.man_hit { p[0].man_hit = 0.25; }
  else if k == EventKind.minion_came { say(p, Toast.minion_came, 0); }
  else if k == EventKind.minion_melted { add_particle(p, particle_of(v3(e.a.x, 0.016, e.a.z), v3splat(0), 6, 0.6, PartKind.drip)); }
  else if k == EventKind.minion_bite { p[0].hurt = cmax(p[0].hurt, 0.6); say(p, Toast.minion_bite, 0); }
  else if k == EventKind.earned {
    t := cast(Tool) cast(u8) e.n;
    if t == Tool.sword || t == Tool.spear || t == Tool.pistol || t == Tool.sugar || t == Tool.staff { say(p, Toast.earned, e.n); }
  }
  else if k == EventKind.weapon_dropped { say(p, Toast.earned, e.n); }
  else if k == EventKind.cone_dropped { say(p, Toast.cone_dropped, 0); }
  else if k == EventKind.cone_eaten { say(p, Toast.cone_eaten, 0); }
  else if k == EventKind.boost_over { say(p, Toast.boost_over, 0); }
  else if k == EventKind.button { say(p, Toast.button, e.n); }
  else if k == EventKind.puzzle_wrong { say(p, Toast.puzzle_wrong, 0); }
  else if k == EventKind.puzzle_solved { say(p, Toast.puzzle_solved, 0); }
  else if k == EventKind.cabinet_locked { say(p, Toast.cabinet_locked, 0); }
}

// Whether a run counts for the best time: played by hand, as the game comes.
counts_for_best :: (p: [] Play, g: [] Game) -> bool {
  o := p[0].options;
  return !o.bot && !o.calm && !o.arm && !o.free_roam && !o.no_farts && !o.cone && !g[0].free_roam && !o.no_minions && !o.no_weapons && !o.no_backrooms
         && !p[0].board_eased;
}
finished :: (p: [] Play, g: [] Game) {
  p[0].new_best = false;
  if g[0].status == Status.escaped && counts_for_best(p, g) {
    s := seconds(g);
    d := cast(int) p[0].difficulty;
    if s > 0 && (p[0].best[d] <= 0 || s < p[0].best[d]) { p[0].best[d] = s; p[0].new_best = true; p[0].save_want = true; }
  }
}
// ---- the save (the realm's slot, docs/verse/realm-host.md section 3): world.cpp's
// settings line, whether the tour was seen, and the best escape a difficulty, as
// f32 bits. A text without the first line isn't ours and is ignored.
SAVE_TAG :: "icecream-save 1";
seen_tour :: (p: [] Play) { if !p[0].seen_tour { p[0].seen_tour = true; p[0].save_want = true; } }
save_put :: (p: [] Play, at: int, s: string) -> int {
  n := at;
  for i: 0..<s.count { if n < SAVE_CAP { p[0].save[n] = cast(u8) byte_at(s, i); n += 1; } }
  return n;
}
ice_play_save :: (p: [] Play) -> int #export_c {
  n := save_put(p, 0, SAVE_TAG);
  n = save_put(p, n, ifx p[0].timer_on then "\ntimer=1" else "\ntimer=0");
  n = save_put(p, n, ifx p[0].jumpscares then ";jumpscares=1" else ";jumpscares=0");
  n = save_put(p, n, ifx p[0].sprint_tap then ";sprint=tap" else ";sprint=hold");
  n = save_put(p, n, ";difficulty="); n = save_put(p, n, DIFFICULTY_IDS[cast(int) p[0].next_difficulty]);
  n = save_put(p, n, ifx p[0].seen_tour then "\ntour=seen" else "\ntour=new");
  for d: 0..<3 {
    n = save_put(p, n, "\nbest."); n = save_put(p, n, DIFFICULTY_IDS[d]); n = save_put(p, n, "=");
    word: [16] u8;
    m := put_hex(word[..], 0, cast(u64) f32_bits(cmax(p[0].best[d], 0)));
    n = save_put(p, n, cast(string) word[0..<m]);
  }
  n = save_put(p, n, "\n");
  p[0].save_n = n;
  p[0].save_want = false;
  return n;
}
ice_play_save_ready :: (p: [] Play) -> bool #export_c { return p[0].save_want && !p[0].options.bot && !p[0].options.trace; }
value_after :: (line: string, key: string) -> string {
  if line.count <= key.count || line[0..<key.count] != key { return ""; }
  return line[key.count..<line.count];
}
ice_play_load :: (p: [] Play, g: [] Game, text: string) #export_c {
  if !p[0].started { play_reset(p, g); }
  first := 0;
  while first < text.count && byte_at(text, first) != '\n' { first += 1; }
  if text[0..<first] != SAVE_TAG { return; }
  difficulty := -1;
  at := first + 1;
  while at < text.count {
    end := at;
    while end < text.count && byte_at(text, end) != '\n' { end += 1; }
    line := text[at..<end];
    if line == "tour=seen" { p[0].seen_tour = true; if p[0].tour == 0 && p[0].stepped == 0 { p[0].tour = -1; } }
    for d: 0..<3 {
      v := value_after(line, ifx d == 0 then "best.easy=" else ifx d == 1 then "best.normal=" else "best.hard=");
      if v.count > 0 && v.count <= 8 { b := float_of(v); if b > 0 && b < 100000 { p[0].best[d] = b; } }
    }
    // the settings line: key=value pairs split by ';'
    from := 0;
    while from < line.count {
      cut := from;
      while cut < line.count && byte_at(line, cut) != ';' { cut += 1; }
      pair := line[from..<cut];
      if pair == "timer=1" { p[0].timer_on = true; } if pair == "timer=0" { p[0].timer_on = false; }
      if pair == "jumpscares=1" { p[0].jumpscares = true; } if pair == "jumpscares=0" { p[0].jumpscares = false; }
      if pair == "sprint=tap" { p[0].sprint_tap = true; } if pair == "sprint=hold" { p[0].sprint_tap = false; }
      for d: 0..<3 { if value_after(pair, "difficulty=") == DIFFICULTY_IDS[d] { difficulty = d; } }
      from = cut + 1;
    }
    at = end + 1;
  }
  // The kept difficulty is the next run's, and this one's when nothing has stepped
  // yet (unless the address named one).
  if difficulty >= 0 && p[0].options.difficulty == Difficulty.normal {
    p[0].next_difficulty = cast(Difficulty) cast(u8) difficulty;
    if p[0].stepped == 0 && p[0].difficulty != p[0].next_difficulty && !p[0].options.bot && !p[0].options.trace {
      o := p[0].options;
      p[0].options.has_seed = true; p[0].options.seed = p[0].seed;
      new_run(p, g);
      p[0].options = o;
    }
  }
}

running :: (p: [] Play) -> bool { return p[0].phase == Phase.playing && p[0].tour < 0 && !p[0].suspended; }

// One rules step: its input, the step, the trace line, its events.
step_once :: (p: [] Play, g: [] Game) {
  in := play_input(p, g);
  game_step(g, in);
  p[0].stepped += 1;
  trace_step(p, g, in);
  if in.fire && !cam_aims(p[0].camera) && !vzero(in.aim) { p[0].yaw = yaw_of(in.aim); }
  p[0].taps = 0; p[0].click = false; p[0].select = -1;
  for i: 0..<g[0].event_n { effect(p, g, g[0].events[i]); }
  o := p[0].options;
  if o.trace && o.trace_at > 0 && g[0].tick == o.trace_at { p[0].trace_want = true; }
  if g[0].status != Status.playing {
    p[0].phase = Phase.ending;
    p[0].end_t = 0;
    let_go(p);
    p[0].sprint_toggle = false;
    finished(p, g);
    if o.trace { p[0].trace_want = true; }
  }
}

scaring :: (p: [] Play, g: [] Game) -> bool { return g[0].status == Status.scooped && p[0].jumpscares; }
scare_time :: (p: [] Play, g: [] Game) -> f32 { return ifx p[0].phase == Phase.ending && scaring(p, g) then p[0].end_t else -1.0f32; }
ending_length :: (p: [] Play, g: [] Game) -> f32 { return ifx scaring(p, g) then SCARE else ENDING; }

// ---- animation (world.cpp animate)

animate :: (p: [] Play, g: [] Game, step: f32) {
  player := g[0].player;
  c := p[0].camera;
  target := ifx cam_aims(c) then yaw_of(cam_forward(c)) else ifx player.moving then yaw_of(player.facing) else p[0].yaw;
  if p[0].phase == Phase.playing { p[0].yaw = approach_angle(p[0].yaw, target, 14, step); }
  if cam_aims(c) { p[0].yaw = target; }
  if p[0].options.bot && p[0].phase == Phase.playing { p[0].camera.yaw = approach_angle(c.yaw, p[0].yaw, 2.5, step); }
  if player.moving { p[0].stride += step * (ifx player.sprinting then 13.0f32 else 9.0f32); } else { p[0].stride *= 0.8; }
  man := g[0].man;
  if man.moving { p[0].man_stride += step * 7; }
  d := duck(g, man.pos);
  p[0].man_duck += (d - p[0].man_duck) * (1 - exp(-12 * step));
  p[0].man_yaw = approach_angle(p[0].man_yaw, yaw_of(man.facing), 10, step);
  p[0].hurt = cmax(p[0].hurt - step * 1.5, 0);
  p[0].man_hit = cmax(p[0].man_hit - step, 0);
  p[0].swing = cmax(p[0].swing - step, 0);
  p[0].minion_stride += step * 11;
  if man_here(g) && man.moving && p[0].phase == Phase.playing {
    p[0].drip_wait -= step;
    if p[0].drip_wait <= 0 {
      p[0].drip_wait = 0.7;
      add_particle(p, particle_of(v3(man.pos.x, 0.015, man.pos.z), v3splat(0), 8, 0.35, PartKind.drip));
    }
  }
  keep := 0;
  for i: 0..<p[0].particle_n {
    q := p[0].particles[i];
    q.age += step;
    if q.kind == PartKind.blob { q.vel.y -= 9 * step; q.pos = v3add(q.pos, v3mul(q.vel, step)); }
    if q.age < q.life { p[0].particles[keep] = q; keep += 1; }
  }
  p[0].particle_n = keep;
}

// ---- the view this frame (world.cpp viewNow)

scare_eye :: (p: [] Play, g: [] Game) -> View {
  pl := g[0].player;
  eye := v3(pl.pos.x, pl.height + CAM_HEAD, pl.pos.z);
  to := vsub(g[0].man.pos, pl.pos);
  flat := ifx len2(to) > 0.2 then norm2(to) else cam_forward(p[0].camera);
  d := v3(flat.x, 0, flat.z);
  l := sqrt(d.x * d.x + d.z * d.z);
  dir := ifx l > 0 then v3mul(d, 1 / l) else v3(0, 0, 1);
  return View.{eye = eye, target = v3add(eye, dir), first_person = true};
}
view_now :: (p: [] Play, g: [] Game) -> View {
  pl := g[0].player;
  camera := p[0].camera;
  st := scare_time(p, g);
  if p[0].phase == Phase.ending && st < 0 {
    camera.yaw += p[0].end_t * 0.6;
    camera.zoom = cmax(camera.zoom, 4);
    camera.shift_lock = false;
  }
  if p[0].phase == Phase.title { camera.yaw = p[0].time * 0.15; camera.zoom = 6; }
  r := cam_rig(camera, pl.pos, pl.height, p[0].space[..]);
  p[0].boom = boom_follow(p[0].boom, r, p[0].frame_dt);
  view := rig_view(p[0].space[..], r, p[0].boom.length);
  if pl.hidden >= 0 && st < 0 {
    // In the closet: looking out through the slats at eye height, from its door.
    closet := g[0].house.closets[pl.hidden];
    door := blk_closest(closet.block, closet.at);
    out := norm2(vsub(closet.at, door));
    eye := vadd(door, vmul(out, 0.15));
    view = View.{eye = v3(eye.x, CAM_HEAD, eye.z), target = v3(closet.at.x, CAM_HEAD, closet.at.z), first_person = true};
  }
  if st >= 0 {
    // Through your own eyes, at him, shaking once he hits.
    e := scare_eye(p, g);
    shake: f32 = ifx st > SCARE_HIT then 0.012 + 0.07 * (1 - cmin((st - SCARE_HIT) / 0.6, 1)) else 0.004f32;
    jitter := v3(sin(st * 97) * shake, cos(st * 83) * shake, sin(st * 71) * shake);
    view = View.{eye = v3add(e.eye, jitter), target = v3add(e.target, v3mul(jitter, 0.4)), first_person = true};
  }
  return view;
}

// One frame of play: the steps due, the ending's clock, the animation and the view.
ice_play_frame :: (p: [] Play, g: [] Game, width: f32, height: f32, dpr: f32, frame_dt: f32) #export_c {
  if !p[0].started { play_reset(p, g); }
  p[0].width = cmax(width, 1); p[0].height = cmax(height, 1); p[0].dpr = cmax(dpr, 0.5);
  step := ifx p[0].suspended then 0.0f32 else clampf(frame_dt, 0, 0.1);
  p[0].time += step;
  p[0].frame_dt = step;
  if running(p) {
    p[0].acc += step;
    n := 0;
    while p[0].acc >= STEP && n < 4 && p[0].phase == Phase.playing {
      p[0].acc -= STEP;
      step_once(p, g);
      n += 1;
    }
    if n == 4 { p[0].acc = 0; }
  }
  if p[0].phase == Phase.ending {
    p[0].end_t += step;
    if g[0].status == Status.escaped { p[0].daylight = cmin(p[0].end_t / ENDING * 1.4, 1); }
    if p[0].end_t >= ending_length(p, g) { p[0].phase = Phase.over; }
  }
  animate(p, g, step);
  p[0].aspect = p[0].width / p[0].height;
  p[0].view = view_now(p, g);
  p[0].have_view = true;
}

// A room's light now: warm or freezer blue, with a flicker (world.cpp roomLight).
FLUORESCENT :: V3.{x = 1.0, y = 0.97, z = 0.80};
WARM :: V3.{x = 1.0, y = 0.94, z = 0.86};
COLD :: V3.{x = 0.74, y = 0.84, z = 1.0};
room_light :: (g: [] Game, index: int, time: f32) -> V3 {
  t := g[0].tuning;
  backrooms := t.yellow >= 0.5;
  m := g[0].house.rooms[index].kind;
  base := ifx backrooms then FLUORESCENT else ifx cold(m) then COLD else WARM;
  i := cast(u32) index;
  tick := cast(u32) (time * 14);
  fast := cast(u32) (cmin(t.flicker, 0.05) * 10000);
  slow := cast(u32) (cmax(t.flicker - 0.05, 0.0) * 10000);
  f: f32 = 1;
  if hash_u(i, tick) % 10000 < fast { f = ifx backrooms then 0.45f32 else 0.55f32; }
  else if !backrooms && cold(m) && hash_u(i + 50, tick / 3) % 100 < 6 { f = 0.8; }
  else if slow > 0 && hash_u(i + 70, cast(u32) (time * 2)) % 10000 < slow { f = 0.62; }
  return v3mul(base, f * 0.95);
}
light_at :: (g: [] Game, at: V2, time: f32) -> V3 { return room_light(g, room_of(g, at), time); }


// ---- what the HUD draws (world.cpp publish's HUD part), as numbers: the
// HUD (apps/openagents-web/icecream.coax) holds the same F_* places and
// every word.
F_PHASE :: 0; F_STATUS :: 1; F_TOUR :: 2; F_KEYS :: 3; F_KEY_N :: 4; F_HEALTH :: 5; F_BOOSTED :: 6; F_TOOL :: 7;
F_OWNED :: 8; F_COUNT :: 9; F_BOSS :: 17; F_CROSSHAIR :: 18; F_PROMPT :: 19; F_UNLOCK :: 20; F_TIMER :: 21;
F_HURT :: 22; F_CLOSET :: 23; F_DAYLIGHT :: 24; F_TOAST :: 25; F_TOAST_N :: 26; F_TOAST_COUNT :: 27;
F_KNOB_X :: 28; F_KNOB_Y :: 29; F_SPRINT :: 30; F_SCARE :: 31; F_SCARY :: 32; F_TOUCH :: 34; F_SECONDS :: 35;
F_BEST :: 36; F_NEW_BEST :: 37; F_RUN_KEYS :: 38; F_HITS :: 39; F_ACCURACY :: 40; F_MELTED_MINIONS :: 41;
F_DIFFICULTY :: 42; F_NEXT_DIFFICULTY :: 43; F_TIMER_ON :: 44; F_JUMPSCARES :: 45; F_SPRINT_TAP :: 46;
F_KEEP :: 47; F_FIRST_PERSON :: 48; F_STICK :: 49; F_WON :: 50; F_SHIFT_LOCK :: 51; F_TICK :: 52;
FACTS :: 64;
yes :: (b: bool) -> f32 { return ifx b then 1.0f32 else 0.0f32; }
ice_play_facts :: (p: [] Play, g: [] Game, out: [] f32) #export_c {
  if out.count < FACTS { return; }
  if !p[0].started { play_reset(p, g); }
  for i: 0..<FACTS { out[i] = 0; }
  pl := g[0].player;
  t := g[0].tuning;
  out[F_PHASE] = f32(cast(int) p[0].phase);
  out[F_STATUS] = f32(cast(int) g[0].status);
  out[F_TOUR] = f32(p[0].tour);
  out[F_KEYS] = f32(pl.keys);
  out[F_KEY_N] = f32(g[0].house.key_n);
  out[F_HEALTH] = pl.health * 100 / cmax(t.max_health, 1);
  out[F_BOOSTED] = yes(pl.boost > 0);
  out[F_TOOL] = f32(cast(int) pl.tool);
  owned := 0;
  for i: 0..<TOOLS {
    if pl.owned[i] { owned |= 1 << i; }
    out[F_COUNT + i] = -1;
  }
  out[F_OWNED] = f32(owned);
  out[F_COUNT + cast(int) Tool.fudge] = f32(pl.fudge);
  out[F_COUNT + cast(int) Tool.fart] = f32(pl.farts);
  out[F_COUNT + cast(int) Tool.keys] = f32(pl.keys);
  out[F_COUNT + cast(int) Tool.pistol] = f32(pl.cones);
  out[F_COUNT + cast(int) Tool.sugar] = f32(pl.sugar);
  boss := weapons_on(g) && man_here(g) && g[0].man.health < t.man_health;
  out[F_BOSS] = ifx boss then g[0].man.health / cmax(t.man_health, 1) else -1.0f32;
  out[F_CROSSHAIR] = yes(p[0].phase == Phase.playing && cam_aims(p[0].camera));
  target := game_target(g);
  prompt := p[0].phase == Phase.playing && target.has;
  out[F_PROMPT] = ifx prompt then f32(cast(int) target.prompt) else -1.0f32;
  out[F_UNLOCK] = ifx prompt && target.prompt == Prompt.unlock && pl.unlock > 0 then pl.unlock / cmax(t.unlock, 0.001) else -1.0f32;
  out[F_TIMER] = ifx p[0].timer_on && !g[0].free_roam then seconds(g) else -1.0f32;
  out[F_HURT] = p[0].hurt;
  out[F_CLOSET] = yes(pl.hidden >= 0 && p[0].phase == Phase.playing);
  out[F_DAYLIGHT] = p[0].daylight;
  out[F_TOAST] = f32(cast(int) p[0].toast);
  out[F_TOAST_N] = f32(p[0].toast_n);
  out[F_TOAST_COUNT] = f32(p[0].toast_count);
  out[F_STICK] = yes(p[0].stick_on);
  out[F_KNOB_X] = ifx p[0].stick_on then p[0].stick_dx / p[0].dpr else 0.0f32;
  out[F_KNOB_Y] = ifx p[0].stick_on then p[0].stick_dy / p[0].dpr else 0.0f32;
  out[F_SPRINT] = yes(p[0].sprint_toggle || p[0].sprint_held);
  out[F_SCARE] = ifx p[0].phase == Phase.ending && g[0].status == Status.scooped then p[0].end_t else -1.0f32;
  out[F_SCARY] = yes(p[0].jumpscares);
  out[F_TOUCH] = yes(p[0].touch);
  out[F_SECONDS] = seconds(g);
  out[F_BEST] = p[0].best[cast(int) p[0].difficulty];
  out[F_NEW_BEST] = yes(p[0].new_best);
  out[F_RUN_KEYS] = f32(pl.keys);
  out[F_HITS] = f32(g[0].stats.hits_taken);
  out[F_ACCURACY] = ifx g[0].stats.fudge_shots > 0 then f32(g[0].stats.fudge_hits * 100 / g[0].stats.fudge_shots) else -1.0f32;
  out[F_MELTED_MINIONS] = f32(g[0].stats.minions_melted);
  out[F_DIFFICULTY] = f32(cast(int) p[0].difficulty);
  out[F_NEXT_DIFFICULTY] = f32(cast(int) p[0].next_difficulty);
  out[F_TIMER_ON] = yes(p[0].timer_on);
  out[F_JUMPSCARES] = yes(p[0].jumpscares);
  out[F_SPRINT_TAP] = yes(p[0].sprint_tap);
  won := ifx g[0].has_won then g[0].won else g[0].status;
  out[F_WON] = yes(won == Status.escaped || g[0].status == Status.melted);
  out[F_KEEP] = yes((won == Status.escaped || g[0].status == Status.melted) && t.free_roam == 1);
  out[F_FIRST_PERSON] = yes(cam_first_person(p[0].camera));
  out[F_SHIFT_LOCK] = yes(p[0].camera.shift_lock);
  out[F_TICK] = f32(g[0].tick);
}

// ---- checks

#test "options: seed, bot, trace and difficulty from the address" {
  o := options_of("seed=12&bot&trace=600&hard");
  #assert o.has_seed && o.seed == 12 && o.bot && o.trace && o.trace_at == 600 && o.difficulty == Difficulty.hard;
  o = options_of("seed=x&calm");
  #assert !o.has_seed && o.calm && !o.bot;
  o = options_of("");
  #assert !o.has_seed && !o.trace;
}

#test "keys walk the kid; a step's input is recorded as a trace line" {
  plays: [1] Play;
  games: [1] Game;
  p := plays[..]; g := games[..];
  ice_play_hash(p, g, "seed=3"); ice_play_act(p, g, A_TOUR_END, 0);
  #assert p[0].seed == 3 && p[0].phase == Phase.playing && p[0].toast != Toast.none;
  start := g[0].player.pos;
  #assert ice_play_key(p, g, 'w', true, 0);
  for i: 0..<30 { ice_play_frame(p, g, 1440, 900, 1, 0.0333334); }
  #assert g[0].tick == 30 && p[0].stepped == 30;
  #assert dist2(g[0].player.pos, start) > 1;
  #assert ice_play_key(p, g, 'W', false, 0);
  #assert p[0].held == 0;
  text := cast(string) p[0].trace[0..<p[0].trace_n];
  #assert text[0..<23] == "icecream-trace 1\nname b";
  lines := 0;
  for i: 0..<text.count { if text[i] == '\n' { lines += 1; } }
  #assert lines == 6 + 30;
}

#test "the browser's trace replays to the same state" {
  plays: [1] Play;
  games: [1] Game;
  p := plays[..]; g := games[..];
  ice_play_hash(p, g, "seed=5&trace=40");
  #assert ice_play_key(p, g, 'd', true, 0);
  #assert ice_play_key(p, g, ' ', true, 0);
  for i: 0..<20 { ice_play_frame(p, g, 800, 600, 1, 0.0333334); }
  ice_play_pointer(p, g, 400, 300, 0, 0, 1, 0, 0, 0);
  for i: 0..<20 { ice_play_frame(p, g, 800, 600, 1, 0.0333334); }
  #assert g[0].tick == 40 && ice_trace_ready(p);
  want := fingerprint(g);
  again: [1] Game;
  bots: [1] Bot;
  r := replay_text(again[..], bots[..], cast(string) p[0].trace[0..<p[0].trace_n]);
  #assert r.diverged == -1 && r.steps == 40 && fingerprint(again[..]) == want;
}

#test "the camera: a drag orbits, V and Control switch the view, Escape pauses" {
  plays: [1] Play;
  games: [1] Game;
  p := plays[..]; g := games[..];
  ice_play_hash(p, g, "seed=3&calm"); ice_play_act(p, g, A_TOUR_END, 0);
  ice_play_frame(p, g, 1440, 900, 1, 0.016);
  yaw := p[0].camera.yaw;
  ice_play_pointer(p, g, 700, 400, 0, 0, 1, 0, 0, 0);
  ice_play_pointer(p, g, 800, 400, 1, 0, 1, 0, 0, 0);
  ice_play_pointer(p, g, 800, 400, 2, 0, 1, 0, 0, 0);
  #assert p[0].camera.yaw < yaw && !p[0].fire;
  #assert ice_play_key(p, g, 'v', true, 0);
  #assert cam_first_person(p[0].camera) && p[0].toast == Toast.first_person;
  #assert ice_play_key(p, g, PK_CONTROL, true, 0);
  #assert p[0].camera.shift_lock;
  #assert ice_play_key(p, g, PK_ESCAPE, true, 0);
  #assert p[0].phase == Phase.menu;
  t := g[0].tick;
  ice_play_frame(p, g, 1440, 900, 1, 0.1);
  #assert g[0].tick == t;
  #assert ice_play_key(p, g, PK_ESCAPE, true, 0);
  #assert p[0].phase == Phase.playing;
}

#test "a thumb on the stick walks; elsewhere it looks" {
  plays: [1] Play;
  games: [1] Game;
  p := plays[..]; g := games[..];
  ice_play_hash(p, g, "seed=3&calm"); ice_play_act(p, g, A_TOUR_END, 0);
  ice_play_frame(p, g, 1170, 2532, 3, 0.016);
  ice_play_pointer(p, g, 300, 1900, 0, 1, 7, ZONE_STICK, 300, 2000);
  #assert p[0].stick_on && p[0].stick_dy < 0;
  start := g[0].player.pos;
  for i: 0..<20 { ice_play_frame(p, g, 1170, 2532, 3, 0.0333334); }
  #assert dist2(g[0].player.pos, start) > 0.5;
  yaw := p[0].camera.yaw;
  ice_play_pointer(p, g, 900, 1000, 0, 1, 8, ZONE_LOOK, 0, 0);
  ice_play_pointer(p, g, 960, 1000, 1, 1, 8, ZONE_LOOK, 0, 0);
  #assert p[0].camera.yaw < yaw;
  ice_play_pointer(p, g, 300, 1900, 2, 1, 7, ZONE_STICK, 0, 0);
  #assert !p[0].stick_on && p[0].look_on;
}

#test "the bot plays; a round's end runs the ending to the end card" {
  plays: [1] Play;
  games: [1] Game;
  p := plays[..]; g := games[..];
  ice_play_hash(p, g, "seed=1&bot&calm&trace");
  start := g[0].player.pos;
  for i: 0..<20 { ice_play_frame(p, g, 800, 600, 1, 0.0333334); }
  #assert g[0].tick == 20 && dist2(g[0].player.pos, start) > 0.5 && !ice_trace_ready(p);
  g[0].status = Status.escaped;
  ice_play_frame(p, g, 800, 600, 1, 0.0333334);
  #assert p[0].phase == Phase.ending && ice_trace_ready(p);
  for i: 0..<70 { ice_play_frame(p, g, 800, 600, 1, 0.0333334); }
  #assert p[0].phase == Phase.over && p[0].daylight == 1;
  ice_play_act(p, g, A_NEW_HOUSE, 0);
  #assert p[0].phase == Phase.playing && p[0].seed == 2 && g[0].tick == 0;
}

#test "the save keeps the settings, the tour and the best times, and refuses a stranger's" {
  pp: [1] Play; gg: [1] Game; p := pp[..]; g := gg[..];
  ice_play_hash(p, g, "seed=3");
  #assert p[0].tour == 0 && p[0].timer_on && p[0].jumpscares;
  ice_play_act(p, g, A_TOUR_END, 0);
  ice_play_act(p, g, A_TIMER, 0);
  ice_play_act(p, g, A_DIFFICULTY, 0);
  #assert ice_play_save_ready(p);
  p[0].best[1] = 187.25;
  n := ice_play_save(p);
  #assert n > 0 && !ice_play_save_ready(p);
  text := cast(string) p[0].save[0..<n];
  qq: [1] Play; hh: [1] Game; q := qq[..]; h := hh[..];
  ice_play_hash(q, h, "seed=3");
  ice_play_load(q, h, "someone else's\ntimer=0");
  #assert q[0].timer_on && q[0].tour == 0;
  ice_play_load(q, h, text);
  #assert !q[0].timer_on && q[0].jumpscares && q[0].seen_tour && q[0].tour == -1;
  #assert q[0].best[1] == 187.25 && q[0].best[0] == 0;
  #assert q[0].next_difficulty == Difficulty.hard && q[0].difficulty == Difficulty.hard && q[0].seed == 3;
}

#test "the realm's board: a house with no minions, weapons to earn or backrooms" {
  o: Options;
  hard := tuning_for(Difficulty.hard);
  #assert hard.minion_count == 4 && board_tuning(o, hard).minion_count == 4;
  o.no_minions = true; o.no_weapons = true; o.no_backrooms = true;
  t := board_tuning(o, hard);
  #assert t.minion_count == 0 && t.minion_growth == 0 && t.earned_weapons == 0 && t.backrooms == 0 && t.puzzle_key == 0;
  #assert t.house_size == hard.house_size && t.man_chase == hard.man_chase;
}

#test "the board switched mid-house: minions melt and weapons stop at once, and come back as the house had them" {
  o: Options;
  hard := tuning_for(Difficulty.hard);
  live := hard; live.minion_count = 6;   // played on: what the board doesn't touch stays as it is
  live.man_chase = 9;
  o.no_minions = true; o.no_weapons = true;
  off := board_live(o, hard, live);
  #assert off.minion_count == 0 && off.minion_growth == 0 && off.earned_weapons == 0 && off.man_chase == 9 && off.backrooms == hard.backrooms;
  o.no_minions = false; o.no_weapons = false;
  on := board_live(o, hard, off);
  #assert on.minion_count == hard.minion_count && on.minion_growth == hard.minion_growth && on.earned_weapons == hard.earned_weapons && on.man_chase == 9;
  m: [3] Minion;
  m[0].friendly = false; m[1].friendly = true; m[1].health = 7; m[2].friendly = false;
  #assert board_melt(m[..], 3) == 1 && m[0].friendly && m[0].health == 7;
}
