// Sets the tunable at `index` (in TUNABLE_BOUNDS) to a value already checked.
tuning_put :: (t: Tuning, index: int, value: f64) -> Tuning {
  o := t;
  if index == 0 { o.walk = f32(value); }
  else if index == 1 { o.sprint = f32(value); }
  else if index == 2 { o.jump_speed = f32(value); }
  else if index == 3 { o.gravity = f32(value); }
  else if index == 4 { o.max_health = f32(value); }
  else if index == 5 { o.regen_after = f32(value); }
  else if index == 6 { o.regen_rate = f32(value); }
  else if index == 7 { o.man_wander = f32(value); }
  else if index == 8 { o.man_investigate = f32(value); }
  else if index == 9 { o.man_search = f32(value); }
  else if index == 10 { o.man_chase = f32(value); }
  else if index == 11 { o.sight = f32(value); }
  else if index == 12 { o.sight_angle = f32(value); }
  else if index == 13 { o.notice = f32(value); }
  else if index == 14 { o.search_time = f32(value); }
  else if index == 15 { o.sniff_every = f32(value); }
  else if index == 16 { o.patrol_keys = cast(u32) value; }
  else if index == 17 { o.corners = cast(u32) value; }
  else if index == 18 { o.sprinkle_damage = f32(value); }
  else if index == 19 { o.grab_damage = f32(value); }
  else if index == 20 { o.grab_shove = f32(value); }
  else if index == 21 { o.grab_reach = f32(value); }
  else if index == 22 { o.grab_wait = f32(value); }
  else if index == 23 { o.gloat = f32(value); }
  else if index == 24 { o.volley_min = f32(value); }
  else if index == 25 { o.volley_max = f32(value); }
  else if index == 26 { o.volley_spread = f32(value); }
  else if index == 27 { o.pellet_speed = f32(value); }
  else if index == 28 { o.volley_wait = f32(value); }
  else if index == 29 { o.pellet_dodge = f32(value); }
  else if index == 30 { o.fudge_start = cast(u32) value; }
  else if index == 31 { o.fudge_max = cast(u32) value; }
  else if index == 32 { o.fudge_pickup = cast(u32) value; }
  else if index == 33 { o.fudge_rate = f32(value); }
  else if index == 34 { o.fudge_speed = f32(value); }
  else if index == 35 { o.fudge_range = f32(value); }
  else if index == 36 { o.fudge_slow = f32(value); }
  else if index == 37 { o.slowed = f32(value); }
  else if index == 38 { o.freeze_hits = cast(u32) value; }
  else if index == 39 { o.fudge_memory = f32(value); }
  else if index == 40 { o.frozen = f32(value); }
  else if index == 41 { o.farts_start = cast(u32) value; }
  else if index == 42 { o.farts_max = cast(u32) value; }
  else if index == 43 { o.fart_range = f32(value); }
