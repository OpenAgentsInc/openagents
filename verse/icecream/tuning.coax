    a.staff_wait == b.staff_wait &&
    a.staff_minions == b.staff_minions &&
    a.staff_minion_life == b.staff_minion_life &&
    a.free_roam == b.free_roam &&
    a.yellow == b.yellow &&
    a.fog_near == b.fog_near &&
    a.fog_far == b.fog_far &&
    a.flicker == b.flicker &&
