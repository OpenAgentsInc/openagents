  else if index == 107 { o.staff_wait = f32(value); }
  else if index == 108 { o.staff_minions = cast(u32) value; }
  else if index == 109 { o.staff_minion_life = f32(value); }
  else if index == 110 { o.free_roam = cast(u32) value; }
  else if index == 111 { o.yellow = f32(value); }
  else if index == 112 { o.fog_near = f32(value); }
  else if index == 113 { o.fog_far = f32(value); }
  else if index == 114 { o.flicker = f32(value); }
  else if index == 115 { o.buzz = f32(value); }
  else if index == 116 { o.first_person = cast(u32) value; }
  return o;
}

tuning_same :: (a: Tuning, b: Tuning) -> bool {
  return a.walk == b.walk &&
    a.sprint == b.sprint &&
    a.jump_speed == b.jump_speed &&
    a.gravity == b.gravity &&
    a.max_health == b.max_health &&
    a.regen_after == b.regen_after &&
    a.regen_rate == b.regen_rate &&
