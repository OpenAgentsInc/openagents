    a.backrooms == b.backrooms &&
    a.loops == b.loops &&
    a.house_size == b.house_size &&
    a.key_spread == b.key_spread &&
    a.earned_weapons == b.earned_weapons &&
    a.man_health == b.man_health &&
    a.sword_damage == b.sword_damage &&
    a.sword_reach == b.sword_reach &&
    a.sword_wait == b.sword_wait &&
    a.sword_task == b.sword_task &&
    a.spear_damage == b.spear_damage &&
