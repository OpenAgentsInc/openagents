// Star Catcher's light for the native host (verse/kms): the same sky, hill
// and strokes as verse/realm-template/starcatch.wgsl, as scalar Coax the
// host calls per pixel. kms.c rasterizes and adds; it decides no colour.
// Until Coax emits WGSL itself, the page keeps its WGSL and this file
// follows it by hand.
//   coax/bin/coax test verse/kms/starcatch-light.coax

sl_lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
sl_hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
sl_mix :: (a: f32, b: f32, t: f32) -> f32 { return a + (b - a) * t; }
sl_smooth :: (a: f32, b: f32, x: f32) -> f32 {
  t := sl_lo(1, sl_hi(0, (x - a) / (b - a)));
  return t * t * (3 - 2 * t);
}
// A cell's hash in [0, 1): the mod-289 permutation (34x + 1)x over whole
// numbers. Every value stays a whole number below 2^24, so each step is
// exact in f32 and the CPU and the GPU agree to the bit, fused or not; a
// sin-based hash scales sin's last-bit error by tens of thousands and puts
// the stars in different cells on different hardware.
sl_mod289 :: (x: f32) -> f32 {
  r := x - floor(x * 0.0034602077) * 289;
  if r < 0 { r = r + 289; }
  if r >= 289 { r = r - 289; }
  return r;
}
sl_permute :: (x: f32) -> f32 { return sl_mod289((34 * x + 1) * x); }
sl_hash :: (gx: f32, gy: f32, salt: f32) -> f32 { return sl_permute(sl_permute(sl_mod289(gx) + salt) + sl_mod289(gy)) * 0.0034602077; }

// The background at device pixel (px, py), one channel at a time (0 red,
// 1 green, 2 blue; the GPU path takes f32 and bool, not structs): the
// night gradient, a twinkling far star, the moon, the hill, and the red
// flush when a star lands. The uniforms: the size, the time, the ground's
// top and the flash.
sl_pick :: (ch: f32, r: f32, g: f32, b: f32) -> f32 {
  if ch < 0.5 { return r; }
  if ch < 1.5 { return g; }
  return b;
}
starcatch_sky :: (px: f32, py: f32, w: f32, h: f32, time: f32, ground_top: f32, flash: f32, ch: f32) -> f32 {
  c := sl_mix(sl_pick(ch, 0.02, 0.03, 0.09), sl_pick(ch, 0.10, 0.12, 0.28), py / h);
  cell := 34 * sl_hi(w / 1440, 0.6);
  gx := floor(px / cell); gy := floor(py / cell);
  hh := sl_hash(gx, gy, 0);
  if hh > 0.82 {
    ax := (gx + sl_hash(gx, gy, 1)) * cell;
    ay := (gy + sl_hash(gx, gy, 2)) * cell;
    d2 := (px - ax) * (px - ax) + (py - ay) * (py - ay);
    if d2 < 80 {
      tw := 0.6 + 0.4 * sin(time * (1 + 3 * hh) + hh * 40);
      c = c + sl_pick(ch, 0.8, 0.85, 1.0) * exp(-d2 / 3) * tw;
    }
  }
  mx := w * 0.3; my := h * 0.2;
  mr := sl_lo(w, h) * 0.06;
  md := sqrt((px - mx) * (px - mx) + (py - my) * (py - my));
  c = sl_mix(c, sl_pick(ch, 0.92, 0.92, 0.85), 1 - sl_smooth(mr - 1, mr + 1, md));
  c = c + sl_pick(ch, 0.25, 0.25, 0.3) * exp(-sl_hi(md - mr, 0) / (mr * 1.5)) * 0.4;
  ground := ground_top + sin(px / w * 6) * h * 0.012;
  if py > ground {
    c = sl_mix(sl_pick(ch, 0.06, 0.13, 0.08), sl_pick(ch, 0.02, 0.05, 0.03), (py - ground) / sl_hi(h - ground, 1));
  }
  if flash > 0 {
    qx := (px / w - 0.5) * 2; qy := (py / h - 0.5) * 2;
    c = sl_mix(c, sl_pick(ch, 0.55, 0.05, 0.04), sl_smooth(0.6, 1.4, sqrt(qx * qx + qy * qy)) * flash * 0.6);
  }
  return c;
}
starcatch_sky_r :: (px: f32, py: f32, w: f32, h: f32, time: f32, ground_top: f32, flash: f32) -> f32 #export_c { return starcatch_sky(px, py, w, h, time, ground_top, flash, 0); }
starcatch_sky_g :: (px: f32, py: f32, w: f32, h: f32, time: f32, ground_top: f32, flash: f32) -> f32 #export_c { return starcatch_sky(px, py, w, h, time, ground_top, flash, 1); }
starcatch_sky_b :: (px: f32, py: f32, w: f32, h: f32, time: f32, ground_top: f32, flash: f32) -> f32 #export_c { return starcatch_sky(px, py, w, h, time, ground_top, flash, 2); }

// A stroke's light at (x, y) in its own frame: a capsule from 0 to length
// along x, a core of half width `core`, `light` bright, with a glow that
// reaches `glow`. The host multiplies it by the stroke's tint and adds it.
starcatch_fx :: (x: f32, y: f32, length: f32, core: f32, light: f32, glow: f32, fade: f32) -> f32 #export_c {
  along := sl_hi(sl_hi(-x, x - length), 0);
  d := sqrt(along * along + y * y);
  body := 1 - sl_smooth(core - 0.5, core + 0.6, d);
  g := d / sl_hi(glow, 1);
  halo := exp(-5 * g * g) * 0.28;
  return (body + halo) * light * fade;
}

#test "the star hash is whole-number arithmetic" {
  #assert sl_mod289(-1) == 288 && sl_mod289(289) == 0 && sl_mod289(41685) == 69 && sl_permute(1) == 35;
  #assert sl_hash(0, 0, 0) == 0 && abs(sl_hash(1, 0, 0) - 69.0 / 289.0) < 0.000001 && sl_hash(5, 9, 2) < 1;
}
#test "a stroke is bright on its line, dim in its glow and dark beyond it" {
  on := starcatch_fx(5, 0, 10, 2, 1, 4, 1);
  near := starcatch_fx(5, 4, 10, 2, 1, 4, 1);
  far := starcatch_fx(5, 40, 10, 2, 1, 4, 1);
  #assert on > 1 && near > far && near < 0.1 && far < 0.0001;
  #assert starcatch_fx(-3, 0, 10, 2, 1, 4, 1) < on && starcatch_fx(13, 0, 10, 2, 1, 4, 1) < on;
  #assert starcatch_fx(5, 0, 10, 2, 1, 4, 0) == 0;
}

#test "the sky is dark blue above the hill, the hill is green, and the moon is pale" {
  w: f32 = 2560; h: f32 = 1440; top := 0.9 * h;
  #assert starcatch_sky_b(2000, 300, w, h, 0, top, 0) > starcatch_sky_r(2000, 300, w, h, 0, top, 0) && starcatch_sky_b(2000, 300, w, h, 0, top, 0) < 0.3;
  #assert starcatch_sky_g(1000, 1430, w, h, 0, top, 0) > starcatch_sky_b(1000, 1430, w, h, 0, top, 0);
  #assert starcatch_sky_r(w * 0.3, h * 0.2, w, h, 0, top, 0) > 0.9;
}

#test "a landed star flushes the edges red and leaves the middle alone" {
  w: f32 = 1440; h: f32 = 900; top := 0.9 * h;
  #assert starcatch_sky_r(10, 10, w, h, 0, top, 1) > starcatch_sky_r(10, 10, w, h, 0, top, 0) + 0.1;
  #assert abs(starcatch_sky_r(w / 2, h * 0.6, w, h, 0, top, 1) - starcatch_sky_r(w / 2, h * 0.6, w, h, 0, top, 0)) < 0.001;
}
