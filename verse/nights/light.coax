// Nights authors its own spring noon; the shared profile and resolver stay unchanged.
#module "verse.nights.light";
#load "../../aethyr/world/environment.coax" as world;
#load "../../aethyr/render/environment-frame.coax" as frame;
#test "Nights spring noon is admitted brighter softer and clearer without changing the shared glade" {
 p:=profile();g:=world.env_glade_profile();k:=p.track.knots[0];b:=g.track.knots[0];
 #assert world.env_profile_check(p).refusal==world.EnvRefusal.none && p.id==7001;
 #assert k.channels.ambient.upper.g>b.channels.ambient.upper.g && k.intensity<b.intensity;
 #assert k.channels.fog.density<b.channels.fog.density && k.channels.cloud.shade>b.channels.cloud.shade;
 #assert k.channels.presentation.saturation<=b.channels.presentation.saturation;
 words:=noon_words();#assert words[2]==7001 && g.id==world.ENV_GLADE_ID;
}
profile :: ()->world.EnvironmentProfile {
 p:=world.env_glade_profile();p.id=7001;k:=p.track.knots[0];k.kelvin=5600;k.intensity=1.65;k.dir.y=0.78;
 c:=k.channels;c.ambient.upper=world.env_rgb(0.544,0.608,0.688);c.ambient.horizon=world.env_rgb(0.48,0.544,0.472);c.ambient.lower=world.env_rgb(0.368,0.40,0.256);
 c.sky.zenith=world.env_rgb(0.38,0.72,0.99);c.sky.horizon=world.env_rgb(0.80,0.92,0.99);c.sky.cloud_shade=world.env_rgb(0.83,0.89,0.96);c.sky.cloud_cover=0.55;c.sky.wisp_strength=0.38;
 c.fog.density=0.0018;c.fog.start=12;c.fog.near=45;c.fog.far=120;c.fog.far_gain=0.12;c.fog.phase_g=0.35;c.fog.sun_strength=0.12;c.fog.air=world.env_rgb(0.64,0.79,0.94);c.fog.sun_tint=world.env_rgb(0.96,0.84,0.60);
 c.cloud.shade=0.82;c.presentation.exposure=1.03;c.presentation.saturation=1.04;k.channels=c;p.track.knots[0]=k;return p;
}
noon_words :: ()->[108]f32 {
 next:[1]world.EnvironmentSet;next[0]=frame.env_frame_glade_set();next[0].profiles[0]=profile();next[0].default_profile=7001;
 f:[1]frame.EnvFrame;check:=frame.env_frame_admit(f[..],next[..]);out:[108]f32;ok:=frame.env_frame_write_eye(f[..],0,0,1,0,out[..],0);return out;
}
