ocl_pointer :: (s:[]OcarinaLab,x:f32,y:f32,phase:int,kind:int,id:int)->bool #export_c #effects(all) {if phase==0 && y/s[0].d<54 {cx:=x/s[0].d;w:=s[0].width/s[0].d;if cx<w*0.30 {return ocl_key(s,67);}if cx<w*0.55 {return ocl_key(s,72);}if cx<w*0.82 {return ocl_key(s,86);}if cx>=w*0.82 {_:=ocl_hold(s,32,true);_=ocl_hold(s,32,false);return true;}}
 if s[0].inspect==0 && kind!=0 {slot:= -1;for k:0..<4 {if s[0].active[k] && s[0].ids[k]==id {slot=k;}}if phase==0 {for k:0..<4 {if !s[0].active[k] {slot=k;break;}}if slot<0 {return false;}s[0].active[slot]=true;s[0].ids[slot]=id;}if slot<0 {return false;}s[0].thumbs=sticks_touch(s[0].thumbs,slot,phase,x,y,s[0].width,s[0].height,s[0].d,s[0].now,false);if phase>=2 {s[0].active[slot]=false;}return true;}
 if phase==0 {s[0].drag=true;s[0].drag_id=id;s[0].x=x;s[0].y=y;return true;}if !s[0].drag || s[0].drag_id!=id {return false;}if phase==1 {dx:=(x-s[0].x)/s[0].d*STICKS_LOOK;dy:=(y-s[0].y)/s[0].d*STICKS_LOOK;if s[0].inspect==0 {s[0].look_x-=dx;s[0].look_y-=dy;}else {s[0].orbit-=dx;s[0].tilt=clamp(s[0].tilt+dy,-1,1);}s[0].x=x;s[0].y=y;}if phase>=2 {s[0].drag=false;}return true;
}
ocl_wheel :: (s:[]OcarinaLab,delta:f32) #export_c #effects(all) {if s[0].inspect==0 {s[0].you=pc.walk_zoom(s[0].you,delta*0.01);}else {s[0].distance=clamp(s[0].distance+delta*0.005,0.5,8);}}
ocl_uniform :: (u:[]f32,at:int,p:Point) {u[at]=p.x;u[at+1]=p.y;u[at+2]=p.z;}
ocl_frame :: (s:[]OcarinaLab,out:[]f32,u:[]f32,width:f32,height:f32,d:f32)->int #export_c #effects(all) {
 ocl_start(s);s[0].width=width;s[0].height=height;s[0].d=d;shot:=pc.walk_shot(s[0].you);eye:=v3(shot.eye.x,shot.eye.y-0.3,shot.eye.z);target:=v3(shot.at.x,shot.at.y-0.3,shot.at.z);feet:=pc.walk_feet(s[0].you);pos:=v3(feet.x,feet.y,feet.z);
 if s[0].inspect>0 {target=add(pos,v3(0,ifx s[0].inspect==2 then 0.96f32 else 0.7f32,0));distance:=ifx s[0].inspect==2 then s[0].distance*0.3 else s[0].distance;distance*=hi(1.0f32,0.75*height/width);eye=add(target,times(v3(sin(s[0].orbit)*cos(s[0].tilt),sin(s[0].tilt),cos(s[0].orbit)*cos(s[0].tilt)),distance));}
 forward:=unit_or(sub(target,eye),v3(0,0,-1));right:=unit_or(cross(forward,v3(0,1,0)),v3(1,0,0));up:=cross(right,forward);sun:=unit_or(v3(-0.45,0.82,0.35),v3(0,1,0));lr:=unit_or(cross(v3(0,1,0),sun),v3(1,0,0));lu:=cross(sun,lr);
 for k:0..<64 {u[k]=0;}u[0]=width;u[1]=height;u[2]=d;u[3]=1;u[4]=cast(f32)s[0].view;ocl_uniform(u,8,eye);ocl_uniform(u,12,right);u[15]=1.73*height/width;ocl_uniform(u,16,up);u[19]=1.73;ocl_uniform(u,20,forward);ocl_uniform(u,24,pos);u[27]=ifx s[0].inspect>0 then 0.0f32 else pc.walk_face(s[0].you);ocl_uniform(u,28,sun);ocl_uniform(u,32,lr);ocl_uniform(u,36,lu);ocl_uniform(u,40,sun);u[47]=ifx s[0].inspect>0 then 2.5f32 else 28.0f32;ocl_uniform(u,44,ocl_shadow_origin(add(pos,v3(0,1,0)),lr,lu,u[47]));u[48]=cast(f32)s[0].now;u[49]=ifx s[0].inspect==0 then 1.0f32 else 0.0f32;
 ocl_scene_draws(s);pen:=HdPen.{d=d,top=0,bottom=height/d,cyan=false,sans=false};w:=width/d;h:=height/d;n:=hd_text(out,0,"OCARINA LAB",20,30,18,pen,0);small:=w<600;label:=ifx small then 8.0f32 else 10.0f32;n=hd_text(out,n,"C CHARACTER",20,52,label,pen,0);n=hd_text(out,n,"H FACE",w*0.30+8,52,label,pen,0);n=hd_text(out,n,ifx small then "V MAP" else "V MATERIAL",w*0.55+8,52,label,pen,0);n=hd_text(out,n,"JUMP",w*0.82+8,52,label,pen,0);
 n=hd_text_fit(out,n,ifx s[0].ready then [8]string.["WAIT","WALK","RUN","DASH","JUMP","LAND","BACKFLIP","FACIAL CHECK"][s[0].clip] else ifx s[0].failed then "PRIVATE SOURCE PACK REFUSED" else "LOADING PRIVATE LINK SOURCE",20,h-74,12,w-40,pen,1);
 n=hd_text_fit(out,n,ifx s[0].inspect>0 then (ifx small then "DRAG / [] CLIP / P PAUSE / R FOREST" else "DRAG ORBIT / [] CLIP / P PLAY / , . FRAME / R FOREST") else (ifx small then "LEFT MOVE / RIGHT LOOK / TAP JUMP" else "WASD MOVE / SHIFT WALK / SPACE JUMP / DRAG OR ARROWS LOOK / B BACKFLIP"),20,h-27,label,w-40,pen,0);
 s[0].meter[0]=budget_meter(OCL_BUDGET);budget_measure(s[0].meter[..],n+(ifx ocl_ready(s) then s[0].expected_indices*2 else 0),8,ocl_measured_bytes(s,width,height));
 _:=budget_take(s[0].meter[..],BUDGET_STEPS,s[0].frame_steps);s[0].frame_steps=0;#assert n<OCL_HUD && budget_ok(s[0].meter[0]);return n;
}
ocl_probe :: (s:[]OcarinaLab,k:int)->int #export_c #effects(all) {if k==0 {return ifx ocl_ready(s) then 1 else 0;}if k==1 {return s[0].clip;}if k==2 {return s[0].inspect;}if k==3 {return s[0].view;}if k==4 {return OCL_JOINTS;}if k==5 {return s[0].revision;}if k==6 {return cast(int)(s[0].you.pos.x*1000);}if k==7 {return cast(int)(s[0].you.pos.z*1000);}if k==8 {return ifx s[0].failed then 1 else 0;}if k==10 {return s[0].meter[0].used[BUDGET_BYTES];}if k==11 {return s[0].meter[0].used[BUDGET_VERTICES];}if k==12 {return s[0].meter[0].used[BUDGET_DRAWS];}if k==13 {return ifx budget_ok(s[0].meter[0]) then 1 else 0;}if k==14 {return s[0].pack_checks;}if k==15 {return ifx s[0].pack_verified then 1 else 0;}if k==16 {return ifx s[0].catalog_ready then s[0].catalog_bytes else s[0].bytes;}if k>=17 && k<=20 {return s[0].loaded[k-17];}if k==21 {return s[0].meter[0].used[BUDGET_STEPS];}if k==22 {return OCL_BUDGET.bytes;}if k==23 {return cast(int)(s[0].pose[0].t.x*1000000);}if k==24 {return cast(int)(s[0].pose[0].t.z*1000000);}if k==25 {return cast(int)(s[0].source_speeds[1]*1000000);}if k==26 {return cast(int)(s[0].source_speeds[2]*1000000);}if k==27 {return cast(int)(s[0].world[3*12+11]*1000000);}if k==28 {return cast(int)(ocl_duration(s)*1000000);}if k==29 {feet:=pc.walk_feet(s[0].you);yaw:=pc.walk_face(s[0].you);return cast(int)((feet.z-sin(yaw)*s[0].world[3*12+3]+cos(yaw)*s[0].world[3*12+11])*1000000);}if k==30 {return s[0].collision_tests;}if k==31 {return s[0].collision_contacts;}if k==32 {return cast(int)(s[0].you.pos.y*1000);}if k==33 {return ifx s[0].catalog_ready then 1 else 0;}if k==34 {return s[0].world_source.count;}return cast(int)(s[0].time*30000);}
ocl_ready :: (s:[]OcarinaLab)->bool #export_c #effects(all) {return s[0].ready && s[0].catalog_ready && s[0].world_source.count>0 && s[0].pack_verified && !s[0].failed && s[0].loaded[0]==s[0].catalog_bytes && s[0].loaded[1]==s[0].expected_vertex_bytes && s[0].loaded[2]==s[0].expected_indices*4 && s[0].loaded[3]==s[0].expected_layers;}
ocl_asset :: (s:[]OcarinaLab,index:int,n:int) #export_c #effects(all) {if index<0 || index>=4 {s[0].failed=true;return;}s[0].loaded[index]=n;expected:=[4]int.[(ifx s[0].catalog_ready then s[0].catalog_bytes else s[0].bytes),s[0].expected_vertex_bytes,s[0].expected_indices*4,s[0].expected_layers];if n<=0 || n!=expected[index] {s[0].failed=true;}}
ocl_pack_gate :: (s:[]OcarinaLab,n:int)->bool #export_c #effects(all) {s[0].pack_checks+=1;s[0].pack_verified=ocarina_pack_accept(s[0].pack_digest[..],n);if !s[0].pack_verified {s[0].failed=true;}return s[0].pack_verified;}
