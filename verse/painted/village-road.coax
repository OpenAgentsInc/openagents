// Painted Village: one village, built shot by shot.
//   Scene 1, the village road: a broad dirt road climbs between a timber-frame cottage on the left
//   and a stone house on the right, past stone walls and under bunting.
//   Scene 2, the plaza: the road ends in a cobbled plaza. Across it a flight of steps climbs
//   between great piers to a terrace with a fountain and the church; stalls, lamps, banners,
//   benches and bunting stand round it, trees behind, pale mountains beyond.
// You walk from one into the other.
//
// Nothing is modelled here. Every part comes from the Metaverse Engine's architecture kit as a generator with
// parameters (aethyr/arch/village.coax: houses, the church, walls, street furniture;
// aethyr/arch/plaza.coax: steps, the terrace, piers, the fountain, benches, stalls;
// aethyr/arch/flora.coax: trees, bushes, hills, the ground); this file says which, with what
// parameters, and where they stand. The Metaverse Engine's stylized shading (aethyr/render/stylized.coax) draws
// them, and every part brings its own solids (aethyr/arch/solids.coax), so what you see you can
// walk to and nothing you see can be walked through.
//
// The world: metres, +y up; the road runs along -z from the camera of shot 1 near the origin.
//   coax/bin/coax test --library verse/painted/village-road.coax
#module "verse.painted.village_road";
#load "../../aethyr/arch/village.coax";
#load "../../aethyr/arch/plaza.coax";
#load "../../aethyr/arch/flora.coax";
#load "../../aethyr/arch/place.coax";
#load "../../aethyr/arch/solids.coax";
#load "../../aethyr/render/stylized-frame.coax";
#load "wilds.coax";

VR_VERTICES :: 860000;
VR_RECORDS :: 1280;
VR_DRAWS :: 448;
VR_LOCAL_SOLIDS :: 960;            // solids in the parts' own space
VR_PLACED :: 3072;                 // solids stood in the world
VR_GROUND_N :: 176;                // cells a side of the ground table
VR_GROUND_CELL :: 2.0;
VR_GROUND_X0 :: -176.0;
VR_GROUND_Z0 :: -150.0;
VR_NODES :: (VR_GROUND_N + 1) * (VR_GROUND_N + 1);
VR_VILLAGE :: 1.15;                // the village stands this far above the road's start
VR_ROAD_X :: -1.9;                 // the road's middle where it starts
VR_ROAD_HALF :: 5.2;               // half its width there: it narrows as it climbs
VR_AXIS :: 2.0;                    // the plaza's and the church's middle (x)
VR_PLAZA_NEAR :: -30.0;            // where the road meets the plaza (z)
VR_PLAZA_FAR :: -78.0;             // the terrace's front, at the foot of the steps
VR_PLAZA_HALF :: 26.0;
VR_TERRACE :: 1.6;                 // the terrace above the plaza
VR_STEPS_RUN :: 5.0;               // the steps are cut this far into it,
VR_STEPS_HALF :: 4.5;              // and are this wide each side of the axis
VR_CHURCH_FRONT :: -91.5;

VillageRoad :: struct {
  mesh: [VR_VERTICES * ARCH_VERTEX_FLOATS] f32; vertices: int;
  records: [VR_RECORDS * ARCH_RECORD_FLOATS] f32; record_n: int;
  draws: [VR_DRAWS * 4] u32; draw_n: int;
  table: [VR_NODES * ARCH_GROUND_FLOATS] f32;
  heights: [VR_NODES] f32;           // the table's heights, for the Metaverse Engine's height field
  local: [VR_LOCAL_SOLIDS * ARCH_SOLID_FLOATS] f32;
  placed: [VR_PLACED * ARCH_PLACED_FLOATS] f32; placed_n: int;
  solid_draw: int;                   // the draw that shows the solids themselves (the last one)
  wet_first: int; wet_n: int;        // the draws that are water: a host draws them last, in the water pass
  built: bool;
}

vr_smooth :: (a: f32, b: f32, x: f32) -> f32 { t := (x - a) / (b - a); if t < 0 { t = 0; } if t > 1 { t = 1; } return t * t * (3 - 2 * t); }
// The land: the road climbs to the village's level, which lies flat under the village, the plaza
// and the church; the meadow rolls a little, and far out the ground rises toward the hills. South
// of the road's start it gives way to the country beyond (verse/painted/wilds.coax).
vr_height :: (x: f32, z: f32) -> f32 {
  south := vr_smooth(VW_START, VW_START + VW_BLEND, z);
  if south >= 1 { return vw_height(x, z); }
  climb := vr_smooth(-2, -9, z) * VR_VILLAGE;
  off_road := vr_smooth(5.4, 10, abs(x - VR_ROAD_X));
  in_village := vr_smooth(-9.5, -12, z) * (1 - vr_smooth(-124, -136, z)) * (1 - vr_smooth(52, 62, abs(x - VR_AXIS)));
  roll := 0.14 * sin(x * 0.21 + 1.3) * sin(z * 0.17 + 0.4) * off_road * (1 - in_village);
  dx := x; dz := z + 62; out := sqrt(dx * dx + dz * dz);
  far := vr_smooth(74, 132, out) * (3 + 3 * sin(x * 0.045 + 0.7) * cos(z * 0.038));
  north := climb + roll + far;
  if south <= 0 { return north; }
  return north + (vw_height(x, z) - north) * south;
}
// The plaza's flagstones: 1 on them, 0 off them.
vr_paved :: (x: f32, z: f32) -> f32 {
  return (1 - vr_smooth(VR_PLAZA_HALF - 1.5, VR_PLAZA_HALF + 1.5, abs(x - VR_AXIS))) * vr_smooth(VR_PLAZA_NEAR + 1.2, VR_PLAZA_NEAR - 1.2, z) * (1 - vr_smooth(VR_PLAZA_FAR - 1, VR_PLAZA_FAR - 3, z));
}

vr_ground :: () -> ArchGround { return ArchGround.{n = VR_GROUND_N, cell = VR_GROUND_CELL, x0 = VR_GROUND_X0, z0 = VR_GROUND_Z0}; }
vr_at :: (v: [] VillageRoad, x: f32, z: f32) -> f32 { return arch_ground_at(vr_ground(), v[0].table[..], x, z, 0); }
// Bare ground under a building: no grass grows within a box (x0, z0)-(x1, z1).
vr_bare :: (v: [] VillageRoad, x0: f32, z0: f32, x1: f32, z1: f32) {
  g := vr_ground();
  for j: 0..<g.n + 1 {
    for i: 0..<g.n + 1 {
      x := g.x0 + cast(f32) i * g.cell; z := g.z0 + cast(f32) j * g.cell;
      if x >= x0 && x <= x1 && z >= z0 && z <= z1 { v[0].table[(j * (g.n + 1) + i) * ARCH_GROUND_FLOATS + 1] = 0; }
    }
  }
}

// One part stood once on the ground at (x, z), `lift` above it, turned and scaled; its record.
vr_raise :: (v: [] VillageRoad, s: [] ArchScene, part: ArchPart, x: f32, z: f32, lift: f32, yaw: f32, scale: f32) -> int {
  r := arch_stand(s, x, vr_at(v, x, z) + lift, z, yaw, scale);
  arch_draw(s, part, r, 1);
  return r;
}
vr_put :: (v: [] VillageRoad, s: [] ArchScene, part: ArchPart, x: f32, z: f32, yaw: f32, scale: f32) -> int { return vr_raise(v, s, part, x, z, 0, yaw, scale); }
// One part stood at each of a list of places (x, z, yaw), `lift` above the ground.
vr_each :: (v: [] VillageRoad, s: [] ArchScene, part: ArchPart, places: [] f32, lift: f32) {
  first := s[0].rn; n := 0;
  for i: 0..<places.count / 3 {
    x := places[i * 3]; z := places[i * 3 + 1];
    if arch_stand(s, x, vr_at(v, x, z) + lift, z, places[i * 3 + 2], 1) < 0 { break; }
    n += 1;
  }
  arch_draw(s, part, first, n);
}
// A record's wash: a colour its part is multiplied by.
vr_wash :: (s: [] ArchScene, record: int, r: f32, g: f32, b: f32) {
  if record < 0 || record >= s[0].rn { return; }
  o := record * ARCH_RECORD_FLOATS; s[0].records[o + 8] = r; s[0].records[o + 9] = g; s[0].records[o + 10] = b;
}
// One tree part stood at each of a list of places (x, z, yaw, scale), each washed a little its own green.
vr_wood :: (v: [] VillageRoad, s: [] ArchScene, part: ArchPart, places: [] f32, seed: int) {
  first := s[0].rn; n := 0;
  for i: 0..<places.count / 4 {
    x := places[i * 4]; z := places[i * 4 + 1];
    r := arch_stand(s, x, vr_at(v, x, z) - 0.05, z, places[i * 4 + 2], places[i * 4 + 3]);
    if r < 0 { break; }
    k := arch_vary(seed, i, 0.9, 1.08);
    vr_wash(s, r, k * arch_vary(seed, i + 100, 0.94, 1.06), k, k * arch_vary(seed, i + 200, 0.92, 1.05));
    n += 1;
  }
  arch_draw(s, part, first, n);
}

// Shot 1: the road in, seen from head height.
vr_shot_camera :: () -> StyCamera {
  c: StyCamera;
  c.x = 0.3; c.z = 3.3; c.y = vr_height(c.x, c.z) + 1.68; c.yaw = 0.0; c.pitch = -0.03; c.fov = 1.0472;
  return c;
}
// Shot 2: the plaza, looking across it to the steps and the church.
vr_plaza_camera :: () -> StyCamera {
  c: StyCamera;
  c.x = VR_AXIS + 2.7; c.z = -52.0; c.y = VR_VILLAGE + 1.68; c.yaw = 0.0; c.pitch = 0.015; c.fov = 1.0472;
  return c;
}
// Shot 3: the foot of the church steps, looking up them at the fountain, the statue and the church.
vr_steps_camera :: () -> StyCamera {
  c: StyCamera;
  c.x = VR_AXIS - 0.4; c.z = VR_PLAZA_FAR + 6.4; c.y = VR_VILLAGE + 0.5; c.yaw = 0.0; c.pitch = 0.14; c.fov = 1.0472;
  return c;
}
// Where a shot was taken, by its reference frame's number: 1 the road, 2 the plaza, 3 the church
// steps, 5 to 12 the country south of the village (verse/painted/wilds.coax).
vr_camera :: (shot: int) -> StyCamera {
  if shot == 2 { return vr_plaza_camera(); }
  if shot == 3 { return vr_steps_camera(); }
  if shot >= 5 && shot <= 12 { return vw_camera(shot); }
  return vr_shot_camera();
}
// The look: the Metaverse Engine's stylized default (warm daylight from behind the village, soft blue shade),
// light haze, and a clear sky with one great heap of cloud and two small ones.
vr_look :: () -> StyLook {
  l: StyLook;
  // The sun stands to the left of the road, a little behind the village; its shadows are soft:
  // most of the light is the sky's.
  l.sun_x = -0.62; l.sun_y = 0.8; l.sun_z = -0.3;
  l.sun_r = 0.46; l.sun_g = 0.41; l.sun_b = 0.3;
  l.sky_r = 0.5; l.sky_g = 0.53; l.sky_b = 0.57; l.ground_r = 0.38; l.ground_g = 0.37; l.ground_b = 0.34;
  l.haze = 0.0038; l.haze_start = 16; l.haze_most = 0.46; l.haze_r = 0.76; l.haze_g = 0.86; l.haze_b = 0.95;
  l.cloud = 0.0; l.cloud_scale = 1.6; l.cloud_turn = 1.2;
  l.zenith_r = 0.36; l.zenith_g = 0.6; l.zenith_b = 0.88; l.horizon_r = 0.7; l.horizon_g = 0.84; l.horizon_b = 0.95;
  // Three more stand over the country to the south: one over the great hill, one east over the cliff, one west.
  l.cumulus = [24] f32.[-0.5, 0.3, 0.52, 0.4,   0.5, 0.265, 0.2, 0.065,   0.2, 0.2, 0.1, 0.05,
                        3.4, 0.34, 0.5, 0.36,   1.75, 0.3, 0.42, 0.3,   -2.0, 0.24, 0.5, 0.3];
  l.meadow_dry = 0.56; l.meadow_shift = 9;
  return l;
}
VR_GRASS_COLS :: 480;
VR_GRASS_ROWS :: 480;
// A frame's numbers for the scene, after sty_frame: the sun's box and the grass field, both laid
// ahead of the eye, the ground table and the road. Returns how many blades to draw.
vr_frame :: (u: [] f32, look: StyLook, eye: StyCamera) -> int {
  // The sun's box stands ahead of the eye, moved in whole steps so shadows hold still as you turn.
  ahead_x := eye.x + sin(eye.yaw) * 24; ahead_z := eye.z - cos(eye.yaw) * 24;
  ok := sty_shadow_box(u, floor(ahead_x / 6 + 0.5) * 6, 3, floor(ahead_z / 6 + 0.5) * 6, 50, 90);
  sty_ground_table(u, VR_GROUND_X0, VR_GROUND_Z0, VR_GROUND_CELL, VR_GROUND_N);
  sty_path_clear(u);
  // The road: a broad apron where it starts, narrowing as it climbs to the village and the plaza.
  road := sty_path_add(u, VR_ROAD_X, 40, VR_ROAD_X, -2, VR_ROAD_HALF);
  road = sty_path_add(u, VR_ROAD_X, -2, -0.5, -10, 3.7);
  road = sty_path_add(u, -0.5, -10, 0.2, VR_PLAZA_NEAR - 1, 3.3);
  // A worn track to the cottage's porch and one to the stone house's door.
  road = sty_path_add(u, -3.0, -11.0, -6.6, -11.4, 0.55);
  road = sty_path_add(u, 2.6, -11.8, 5.2, -12.4, 0.5);
  // The paths of the country to the south.
  paths := vw_paths();
  for i: 0..<VW_PATHS { road = sty_path_add(u, paths[i * 5], paths[i * 5 + 1], paths[i * 5 + 2], paths[i * 5 + 3], paths[i * 5 + 4]); }
  if !ok { return 0; }
  half := cast(f32) VR_GRASS_COLS * look.grass_cell * 0.5;
  return sty_grass_field(u, look, eye.x + sin(eye.yaw) * 22 - half, eye.z - cos(eye.yaw) * 22 - half, VR_GRASS_COLS, VR_GRASS_ROWS);
}
// One move of a walker whose feet are at `feet`: slid along the village's solids, stood on its
// ground, its steps and its terrace (the Metaverse Engine's walking capsule, aethyr/arch/solids.coax).
vr_walk :: (v: [] VillageRoad, feet: WorldPoint, dx: f32, dz: f32) -> WorldPoint {
  field: [1] QueryHeightfield; field[0] = arch_field(vr_ground(), v[0].heights[..]);
  return arch_walk_among(v[0].placed[..], v[0].placed_n, field[..], feet, dx, dz);
}

vr_build :: (v: [] VillageRoad) -> bool {
  p: [1] ArchPen; arch_pen(p[..], v[0].mesh[..]); arch_pen_solids(p[..], v[0].local[..]);
  s: [1] ArchScene; arch_scene(s[..], v[0].records[..], v[0].draws[..]); arch_scene_solids(s[..], v[0].local[..], v[0].placed[..]);
  g := vr_ground(); G: f32 = VR_VILLAGE; A: f32 = VR_AXIS; T: f32 = VR_TERRACE;
  quarter := f32(ARCH_TAU) * 0.25;

  // ---- the land
  for j: 0..<g.n + 1 {
    for i: 0..<g.n + 1 {
      x := g.x0 + cast(f32) i * g.cell; z := g.z0 + cast(f32) j * g.cell; o := (j * (g.n + 1) + i) * ARCH_GROUND_FLOATS;
      paved := vr_paved(x, z); south := z > VW_START + VW_BLEND * 0.5;
      v[0].table[o] = vr_height(x, z); v[0].table[o + 1] = ifx south then vw_cover(x, z) else 1 - paved; v[0].table[o + 2] = paved;
      v[0].table[o + 3] = ifx south then vw_churn(x, z) else 0.0f32;
    }
  }
  vr_bare(v, -10.6, -18.0, -3.8, -12.0);     // the cottage
  vr_bare(v, 3.0, -20.2, 15.8, -13.2);       // the stone house
  vr_bare(v, -17.5, -18.1, -15.7, -16.3);    // the tower
  vr_bare(v, A - VR_PLAZA_HALF - 1, -118.0, A + VR_PLAZA_HALF + 1, VR_PLAZA_FAR + 1);   // the terrace and the church
  vr_bare(v, VW_CLIFF_X - 4, VW_CLIFF_Z - VW_CLIFF_RUN * 0.5 - 2, VW_CLIFF_X + 44, VW_CLIFF_Z + VW_CLIFF_RUN * 0.5 + 4);   // the cliff
  ok := arch_heights(v[0].heights[..], g, v[0].table[..]);
  arch_once(s[..], arch_ground(p[..], g, v[0].table[..]));
  // The land beyond the table, out to the hills.
  from := p[0].n; p[0].material = ARCH_M_GROUND; p[0].tint = [3] f32.[0, 0, 0];
  far: f32 = 1600;
  arch_quad(p[..], arch_at(-far, -2.6, far, 0, 1, 0, 1, 0), arch_at(far, -2.6, far, 0, 1, 0, 1, 0), arch_at(far, -2.6, -far, 0, 1, 0, 1, 0), arch_at(-far, -2.6, -far, 0, 1, 0, 1, 0));
  arch_once(s[..], arch_part(p[..], from));

  // ---- scene 1: the two houses on the road
  cottage: ArchCottage;
  cottage.w = 6.2; cottage.d = 5.8; cottage.wall = 2.75; cottage.rise = 3.5; cottage.chimney = 1; cottage.stack = 0.72;
  cottage.stack_at = 1.0; cottage.dormers = 1; cottage.dormer_w = 0.78; cottage.porch = 1.9; cottage.porch_from = 0.24; cottage.porch_to = 1.0; cottage.door = 0.7;
  cottage.bay = 3.1; cottage.braces = false; cottage.rails = false; cottage.roof_r = 0.52; cottage.roof_g = 0.22; cottage.roof_b = 0.13;
  r := vr_put(v, s[..], arch_cottage(p[..], cottage), -7.4, -15.1, -0.22, 1);
  house: ArchStoneHouse;
  house.w = 11.0; house.d = 6.8; house.wall = 2.85; house.rise = 2.5; house.door = 0.47; house.windows = 2; house.annex = 1.5; house.annex_plaster = true;
  house.roof_r = 0.57; house.roof_g = 0.24; house.roof_b = 0.13; house.stone_r = 0.62; house.stone_g = 0.66; house.stone_b = 0.69;
  house.board_r = 0.86; house.board_g = 0.66; house.board_b = 0.3;
  r = vr_put(v, s[..], arch_stone_house(p[..], house), 10.2, -16.6, 0, 1);

  // ---- the walls
  // Left: a coped wall of blue-grey stone from a gate pier out across the meadow, in three runs that
  // step down the slope, and a second pier.
  coped := arch_coped_wall(p[..], 6.0, 1.05, 0.42, 0.42, 0.47, 0.53);
  first := s[0].rn;
  for k: 0..<3 {
    x := -4.6 - cast(f32) k * 4.55; z := -9.9 + cast(f32) k * 3.8;
    r = arch_stand(s[..], x, vr_at(v, x - 2.3, z + 1.9) - 0.08, z, -2.449, 1);
  }
  arch_draw(s[..], coped, first, 3);
  pier := arch_pier(p[..], 0.62, 1.34, true);
  piers := [9] f32.[-4.3, -10.1, 0,   -3.9, -12.3, 0,   4.6, -12.3, 0];
  vr_each(v, s[..], pier, piers[..], 0);
  // Right: a dry-stone wall of big tumbled stones from the stone house's gate down toward the
  // road's start, in runs that step down the slope; only its two ends fall away.
  for k: 0..<5 {
    x := 4.75 + cast(f32) k * 0.95; z := -11.8 + cast(f32) k * 3.12;
    dry := ArchDryWall.{run = 3.4, h = 1.05, thick = 0.5, stone = 0.5, tilt = 0.07, seed = 40 + k};
    dry.tumble = ifx k == 4 then 2 else 0;
    r = arch_stand(s[..], x, vr_at(v, x + 0.45, z + 1.5) - 0.06, z, -1.277, 1);
    arch_draw(s[..], arch_drystone(p[..], dry), r, 1);
  }

  // ---- along the road: a signpost, crates, and pennants and bunting where it meets the plaza
  r = vr_put(v, s[..], arch_signpost(p[..], 2.5, 3), 3.0, -14.3, 0.5, 1);
  crate := arch_crate(p[..], 0.8);
  crates := [18] f32.[4.05, -12.9, 0.3,   A - 13.5, -40.2, 0.8,   A + 12.4, -74.9, 0.2,   A + 13.2, -75.2, 1.1,   A + 7.4, -50.6, 0.5,   A + 12.9, -74.4, 0.6];
  vr_each(v, s[..], crate, crates[..], 0);
  r = arch_stand(s[..], A + 12.8, G + 0.8, -74.9, 0.4, 0.7); arch_draw(s[..], crate, r, 1);
  pole := arch_banner_pole(p[..], 5.2, 0.74, 0.17, 0.14);
  poles := [18] f32.[-4.4, -29.0, 3.1416,   4.6, -29.0, 0,   A - 21.0, -72.0, 0,   A + 12.0, -71.0, 0,   A + 16.5, -58.0, 0,   A - 22.0, -44.0, 3.1416];
  vr_each(v, s[..], pole, poles[..], 0);
  arch_once(s[..], arch_bunting(p[..], arch_v(-4.4, G + 4.3, -29.0), arch_v(4.6, G + 4.3, -29.0), 0.9, 15, true));
  arch_once(s[..], arch_bunting(p[..], arch_v(-4.4, G + 4.1, -29.0), arch_v(A - 22.0, G + 4.3, -44.0), 1.3, 30, true));
  arch_once(s[..], arch_bunting(p[..], arch_v(A - 22.0, G + 4.3, -44.0), arch_v(A - 21.0, G + 4.3, -72.0), 1.4, 36, false));
  arch_once(s[..], arch_bunting(p[..], arch_v(A + 12.0, G + 4.3, -71.0), arch_v(A + 16.5, G + 4.3, -58.0), 0.9, 18, false));
  arch_once(s[..], arch_bunting(p[..], arch_v(4.6, G + 4.1, -29.0), arch_v(A + 16.5, G + 4.3, -58.0), 1.6, 40, true));

  // ---- scene 2: the plaza
  // The terrace: two wings beside the steps and the ground the church stands on behind them.
  wing: f32 = VR_PLAZA_HALF - VR_STEPS_HALF;
  wings := arch_terrace(p[..], wing, VR_STEPS_RUN, T);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_STEPS_HALF - wing * 0.5, G, VR_PLAZA_FAR, 0, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + wing * 0.5, G, VR_PLAZA_FAR, 0, 1);
  arch_draw(s[..], wings, first, 2);
  r = arch_stand(s[..], A, G, VR_PLAZA_FAR - VR_STEPS_RUN, 0, 1); arch_draw(s[..], arch_terrace(p[..], VR_PLAZA_HALF * 2, 34, T), r, 1);
  r = arch_stand(s[..], A, G, VR_PLAZA_FAR, 0, 1); arch_draw(s[..], arch_steps(p[..], VR_STEPS_HALF * 2, VR_STEPS_RUN, T, 10), r, 1);
  // A parapet along each wing's front, one down each side of the steps, and one along each end.
  parapet := arch_coped_wall(p[..], wing - 1.3, 0.9, 0.5, 0.7, 0.69, 0.64);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_PLAZA_HALF, G + T, VR_PLAZA_FAR - 0.3, 0, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + 1.3, G + T, VR_PLAZA_FAR - 0.3, 0, 1);
  arch_draw(s[..], parapet, first, 2);
  cheek := arch_coped_wall(p[..], VR_STEPS_RUN - 1.3, 0.9, 0.5, 0.7, 0.69, 0.64);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_STEPS_HALF - 0.3, G + T, VR_PLAZA_FAR - 1.3, quarter, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + 0.3, G + T, VR_PLAZA_FAR - 1.3, quarter, 1);
  arch_draw(s[..], cheek, first, 2);
  side := arch_coped_wall(p[..], 38, 0.9, 0.5, 0.7, 0.69, 0.64);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_PLAZA_HALF + 0.3, G + T, VR_PLAZA_FAR - 0.6, quarter, 1); r = arch_stand(s[..], A + VR_PLAZA_HALF - 0.3, G + T, VR_PLAZA_FAR - 0.6, quarter, 1);
  arch_draw(s[..], side, first, 2);
  // Great piers at the foot and the head of the steps, a lantern on each.
  // The two at the foot stand on the plaza before the wall's corners; the two at the head on the terrace.
  foot := arch_pedestal(p[..], 1.5, 2.7);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_STEPS_HALF - 0.85, G, VR_PLAZA_FAR + 0.86, 0, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + 0.85, G, VR_PLAZA_FAR + 0.86, 0, 1);
  arch_draw(s[..], foot, first, 2);
  head := arch_pedestal(p[..], 1.2, 1.4);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_STEPS_HALF - 0.6, G + T, VR_PLAZA_FAR - VR_STEPS_RUN - 0.6, 0, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + 0.6, G + T, VR_PLAZA_FAR - VR_STEPS_RUN - 0.6, 0, 1);
  arch_draw(s[..], head, first, 2);
  from = p[0].n; arch_lantern(p[..], 0, 0, 0, 0.58); arch_solid_box(p[..], -0.29, 0, -0.29, 0.29, 0.76, 0.29); lantern := arch_part(p[..], from);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_STEPS_HALF - 0.85, G + 2.7, VR_PLAZA_FAR + 0.86, 0, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + 0.85, G + 2.7, VR_PLAZA_FAR + 0.86, 0, 1);
  r = arch_stand(s[..], A - VR_STEPS_HALF - 0.6, G + T + 1.4, VR_PLAZA_FAR - VR_STEPS_RUN - 0.6, 0, 0.8); r = arch_stand(s[..], A + VR_STEPS_HALF + 0.6, G + T + 1.4, VR_PLAZA_FAR - VR_STEPS_RUN - 0.6, 0, 0.8);
  arch_draw(s[..], lantern, first, 4);
  // Banners on frames behind the piers at the foot of the steps, and a clipped bush in an urn beyond each.
  frame := arch_banner_frame(p[..], 1.5, 4.3, 2.7, 0, 0, 0);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_STEPS_HALF - 2.4, G + T, VR_PLAZA_FAR - 1.1, 0, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + 2.4, G + T, VR_PLAZA_FAR - 1.1, 0, 1);
  arch_draw(s[..], frame, first, 2);
  planter := arch_planter(p[..], 0.55, 1.7, 5);
  first = s[0].rn;
  r = arch_stand(s[..], A - VR_STEPS_HALF - 4.6, G + T, VR_PLAZA_FAR - 1.2, 0, 1); r = arch_stand(s[..], A + VR_STEPS_HALF + 4.6, G + T, VR_PLAZA_FAR - 1.2, 1.3, 1);
  r = arch_stand(s[..], A - 3.2, G + T, VR_CHURCH_FRONT + 1.4, 2.0, 0.9); r = arch_stand(s[..], A + 3.2, G + T, VR_CHURCH_FRONT + 1.4, 0.4, 0.9);
  arch_draw(s[..], planter, first, 4);
  // On the terrace: the fountain at the head of the steps, and the church behind it.
  r = arch_stand(s[..], A, G + T, VR_PLAZA_FAR - VR_STEPS_RUN - 3.4, 0, 1); arch_draw(s[..], arch_fountain(p[..], 2.3, 5.4), r, 1);
  church: ArchChurch; church.stone_r = 0.72; church.stone_g = 0.7; church.stone_b = 0.63; church.wall = 8.6; church.rise = 6.2; church.tower_h = 15.5; church.spire = 7.1;
  r = arch_stand(s[..], A, G + T, VR_CHURCH_FRONT - church.d * 0.5, 0, 1); arch_draw(s[..], arch_church(p[..], church), r, 1);

  // Stalls before the terrace: a parasol over flowers on the left, produce under a red awning on
  // the right, and pots under a blue one beyond it; barrels and jars about them.
  r = vr_put(v, s[..], arch_parasol(p[..], 1.9, 2.6, 0.78, 0.2, 0.15, 3), A - 11.5, -74.6, 0.2, 1);
  produce := ArchStall.{w = 3.4, d = 1.9, goods = ARCH_GOODS_PRODUCE, seed = 5};
  r = vr_put(v, s[..], arch_stall(p[..], produce), A + 9.6, -75.2, 0, 1);
  pots := ArchStall.{w = 3.6, d = 1.9, r = 0.2, g = 0.36, b = 0.7, r2 = 0.93, g2 = 0.74, b2 = 0.26, goods = ARCH_GOODS_POTTERY, seed = 8};
  r = vr_put(v, s[..], arch_stall(p[..], pots), A + 15.6, -63.6, -1.15, 1);
  flowers := ArchStall.{w = 2.6, d = 1.7, r = 0.25, g = 0.5, b = 0.3, goods = ARCH_GOODS_FLOWERS, seed = 2};
  r = vr_put(v, s[..], arch_stall(p[..], flowers), A - 19.5, -62.0, 1.1, 1);
  cloth := ArchStall.{w = 2.6, d = 1.7, r = 0.85, g = 0.62, b = 0.2};
  r = vr_put(v, s[..], arch_stall(p[..], cloth), A + 20.5, -43.0, -1.35, 1);
  barrel := arch_barrel(p[..], 0.42, 0.98);
  barrels := [15] f32.[A + 6.9, -74.6, 0,   A + 11.9, -76.4, 1,   A + 8.6, -58.0, 2,   A - 8.6, -76.4, 0.5,   A + 16.6, -67.4, 0.2];
  vr_each(v, s[..], barrel, barrels[..], 0);
  jar := arch_urn(p[..], 0.3, 0.72, 0.74, 0.36, 0.2);
  jars := [18] f32.[A + 12.6, -62.4, 0,   A + 13.2, -63.2, 1,   A + 13.4, -65.6, 2,   A + 14.3, -66.6, 0.5,   A + 12.4, -64.4, 0.2,   A + 15.4, -67.2, 0.2];
  vr_each(v, s[..], jar, jars[..], 0);
  r = vr_put(v, s[..], arch_urn(p[..], 0.36, 0.6, 0.9, 0.84, 0.7), A + 13.5, -64.3, 0, 1);
  // Lamps round the plaza and at the foot of the terrace.
  lamp := arch_lamp_post(p[..], 3.3);
  lamps := [36] f32.[A - 13.4, -76.4, 0,   A - 7.6, -76.2, 0,   A + 14.6, -76.4, 0,   A - 24.0, -36.0, 0,   A + 24.0, -36.0, 0,   A - 24.0, -56.0, 0,
                     A + 24.0, -52.0, 0,   -6.5, -31.5, 0,   6.9, -31.5, 0,   A - 12.0, -45.0, 0,   A + 13.0, -44.0, 0,   A + 16.4, -71.6, 0];
  vr_each(v, s[..], lamp, lamps[..], 0);
  // The camera's corner of the plaza: setts laid in great arcs inside a kerb, a stepped stone
  // base with two tall lamps on it, a bench.
  r = vr_put(v, s[..], arch_paved_ring(p[..], 1.5, 13.5, 0.34, 0.03), A - 10.3, -53.0, 0, 1);
  r = vr_put(v, s[..], arch_podium(p[..], 5.2, 9.0, 1.2, 3), A - 3.7, -58.4, 0, 1);
  tall := arch_lamp(p[..], 1.75, 0.4);
  first = s[0].rn;
  r = arch_stand(s[..], A - 2.5, G + 1.2, -57.4, 0, 1); r = arch_stand(s[..], A - 4.4, G + 1.2, -58.9, 0, 1);
  arch_draw(s[..], tall, first, 2);
  bench := arch_bench(p[..], 2.8);
  benches := [12] f32.[A + 4.75, -55.7, 1.31,   A - 16.0, -66.0, 0.2,   A + 15.0, -40.0, -0.6,   A - 14.0, -36.0, 2.6];
  vr_each(v, s[..], bench, benches[..], 0);
  // A well on the plaza's near side: a drum of stone, a cap, two posts and a roof of tiles.
  from = p[0].n;
  arch_material(p[..], ARCH_M_ASHLAR, 0, 0, 0); arch_drum(p[..], 1.1, 0, 0.85, 14);
  arch_material(p[..], ARCH_M_SMOOTH, 0, 0, 0); arch_ring(p[..], 0.85, 1.2, 0.85, 0.97, 0, ARCH_TAU, 14);
  arch_material(p[..], ARCH_M_TIMBER, 0, 0, 0);
  arch_beam(p[..], arch_v(-1.0, 0.9, 0), arch_v(-1.0, 2.6, 0), 0.07); arch_beam(p[..], arch_v(1.0, 0.9, 0), arch_v(1.0, 2.6, 0), 0.07);
  arch_material(p[..], ARCH_M_ROOF, 0.52, 0.2, 0.12);
  arch_roof_plane(p[..], arch_v(-1.4, 2.45, 0.9), arch_v(1.4, 2.45, 0.9), arch_v(1.4, 3.1, 0), arch_v(-1.4, 3.1, 0), 0.07);
  arch_roof_plane(p[..], arch_v(1.4, 2.45, -0.9), arch_v(-1.4, 2.45, -0.9), arch_v(-1.4, 3.1, 0), arch_v(1.4, 3.1, 0), 0.07);
  arch_solid_round(p[..], 0, 0, 1.2, 0, 0.97);
  arch_solid_box(p[..], -1.07, 0.97, -0.07, -0.93, 2.6, 0.07); arch_solid_box(p[..], 0.93, 0.97, -0.07, 1.07, 2.6, 0.07);
  r = vr_put(v, s[..], arch_part(p[..], from), A - 15.0, -42.5, 0.4, 1);

  // ---- the village round them
  tower: ArchTower; tower.r = 1.1; tower.h = 5.7; tower.roof = 2.1;
  r = vr_put(v, s[..], arch_round_tower(p[..], tower), -16.6, -17.2, 0, 1);
  hall: ArchCottage;     // the two-storey house behind the tower
  hall.w = 11; hall.d = 7; hall.wall = 5.0; hall.rise = 3.4; hall.storeys = 2; hall.dormers = 2; hall.chimney = -1; hall.door = 0.3; hall.bay = 2.75; hall.braces = false;
  hall.roof_r = 0.5; hall.roof_g = 0.2; hall.roof_b = 0.13;
  r = vr_put(v, s[..], arch_cottage(p[..], hall), -17.5, -25.5, 0.12, 1);
  inn: ArchCottage;      // the tall house on the plaza's right, under orange tiles
  inn.w = 12; inn.d = 7.5; inn.wall = 5.2; inn.rise = 3.8; inn.storeys = 2; inn.dormers = 2; inn.dormer_w = 0.8; inn.chimney = 1; inn.door = 0.5; inn.bay = 2.4; inn.braces = false;
  inn.porch = 1.6; inn.porch_from = 0.1; inn.porch_to = 0.9;
  inn.roof_r = 0.8; inn.roof_g = 0.36; inn.roof_b = 0.13;
  inn_part := arch_cottage(p[..], inn);
  first = s[0].rn;
  r = arch_stand(s[..], A + 24.0, G, -66.0, -quarter, 1); r = arch_stand(s[..], A - 33.0, G, -50.0, quarter, 1);
  arch_draw(s[..], inn_part, first, 2);
  small: ArchCottage;    // small cottages round the plaza
  small.w = 7; small.d = 5.4; small.wall = 2.6; small.rise = 3.0; small.dormers = 0; small.chimney = -1; small.bay = 2.33; small.braces = false; small.rails = false;
  small.roof_r = 0.58; small.roof_g = 0.24; small.roof_b = 0.12;
  smalls := [15] f32.[A - 32.0, -36.0, 1.5708,   A - 31.5, -66.0, 1.5708,   A + 32.0, -40.0, -1.5708,   -27.0, -14.5, 0.3,   A + 33.0, -52.0, -1.5708];
  vr_each(v, s[..], arch_cottage(p[..], small), smalls[..], 0);
  barn: ArchStoneHouse; barn.w = 9; barn.d = 6; barn.hip = false; barn.door = 0.5; barn.windows = 2; barn.rise = 2.8;
  barn.roof_r = 0.48; barn.roof_g = 0.2; barn.roof_b = 0.14;
  r = vr_put(v, s[..], arch_stone_house(p[..], barn), A + 31.0, -27.0, -0.4, 1);

  // ---- the trees
  autumn := arch_tree(p[..], arch_tree_spec(ARCH_MAPLE, ARCH_AUTUMN, 11));
  autumn_at := [12] f32.[-6.6, -27.6, 0.0, 1.25,   A - 36.0, -24.0, 2.1, 0.95,   A + 40.0, -52.0, 1.0, 1.05];
  vr_wood(v, s[..], autumn, autumn_at[..], 5);
  gold := arch_tree(p[..], arch_tree_spec(ARCH_OAK, ARCH_GOLD, 23));
  gold_at := [8] f32.[A - 42.0, -60.0, 0.5, 1.0,   32.0, -12.0, 1.7, 0.9];
  vr_wood(v, s[..], gold, gold_at[..], 6);
  oak := arch_tree(p[..], arch_tree_spec(ARCH_OAK, ARCH_SUMMER, 3));
  oak_at := [72] f32.[-18.0, -7.0, 0.4, 1.25,   14.5, 1.5, 2.0, 1.15,     19.5, -24.0, 1.1, 1.2,    25.0, -11.0, 3.0, 1.15,
                      -34.0, -20.0, 0.2, 1.2,   -21.0, 6.0, 2.8, 1.1,     22.0, 8.0, 0.6, 1.2,      A - 29.0, -84.0, 0.9, 1.35,
                      A - 17.5, -97.0, 1.6, 1.3,  A + 16.5, -99.0, 2.2, 1.25,  A + 30.0, -86.0, 0.3, 1.4,  A - 40.0, -76.0, 1.9, 1.3,
                      A + 41.0, -70.0, 1.2, 1.3,  A - 12.0, -122.0, 0.4, 1.4,  A + 14.0, -124.0, 2.7, 1.35,  A + 39.0, -34.0, 2.0, 1.2,
                      A - 40.0, -40.0, 0.7, 1.25,  A + 34.0, -78.0, 1.4, 1.1];
  vr_wood(v, s[..], oak, oak_at[..], 7);
  maple := arch_tree(p[..], arch_tree_spec(ARCH_MAPLE, ARCH_SUMMER, 8));
  maple_at := [56] f32.[-26.0, -31.0, 1.0, 1.0,    29.0, -8.0, 2.2, 1.1,     A - 24.0, -95.0, 0.4, 1.2,   A + 24.0, -96.0, 1.4, 1.15,
                        -40.0, -8.0, 2.6, 1.2,     42.0, -20.0, 0.8, 1.2,    A - 36.0, -104.0, 1.8, 1.3,  A + 36.0, -106.0, 0.1, 1.3,
                        A - 48.0, -62.0, 2.9, 1.3,  A + 49.0, -58.0, 1.5, 1.3,  -34.0, 12.0, 0.7, 1.2,    36.0, 14.0, 2.3, 1.25,
                        A - 31.0, -58.0, 0.2, 0.9,  A + 4.0, -128.0, 1.1, 1.3];
  vr_wood(v, s[..], maple, maple_at[..], 8);
  poplar := arch_tree(p[..], arch_tree_spec(ARCH_POPLAR, ARCH_SUMMER, 4));
  poplar_at := [16] f32.[A - 38.0, -30.0, 0.0, 1.0,   A + 38.0, -46.0, 1.0, 1.05,   A - 39.0, -90.0, 2.0, 1.1,   A + 40.0, -84.0, 0.5, 0.95];
  vr_wood(v, s[..], poplar, poplar_at[..], 9);
  // Firs on the terrace beside the church, bushes at their feet and along the terrace's wall.
  pine := arch_tree(p[..], arch_tree_spec(ARCH_PINE, ARCH_SUMMER, 6));
  first = s[0].rn;
  firs := [16] f32.[A - 9.2, VR_CHURCH_FRONT + 2.2, 0.3, 0.74,   A + 10.4, VR_CHURCH_FRONT + 2.6, 1.7, 0.78,   A - 14.5, VR_CHURCH_FRONT - 3.0, 2.4, 0.9,   A + 15.5, VR_CHURCH_FRONT - 4.0, 0.9, 0.86];
  for i: 0..<4 { r = arch_stand(s[..], firs[i * 4], G + T, firs[i * 4 + 1], firs[i * 4 + 2], firs[i * 4 + 3]); }
  arch_draw(s[..], pine, first, 4);
  bush := arch_bush(p[..], 0.95, 1.15, 0.2, 0.42, 0.17, 4);
  first = s[0].rn;
  bushes := [24] f32.[A - 6.4, VR_CHURCH_FRONT + 1.2, T, 1.0,   A + 6.6, VR_CHURCH_FRONT + 1.2, T, 1.05,   A - 16.5, -76.6, 0, 1.1,   A - 18.6, -76.5, 0, 0.9,
                      A + 22.5, -76.6, 0, 1.1,   3.4, -19.6, 0, 0.8];
  for i: 0..<6 { r = arch_stand(s[..], bushes[i * 4], G + bushes[i * 4 + 2], bushes[i * 4 + 1], cast(f32) i * 1.3, bushes[i * 4 + 3]); }
  arch_draw(s[..], bush, first, 6);
  // Pines on the rising ground, and far ones tall on the hills.
  first = s[0].rn; n := 0;
  for i: 0..<64 {
    a := arch_hash(77, i) * f32(ARCH_TAU); d := arch_vary(78, i, 86, 140);
    x := cos(a) * d; z := -62 + sin(a) * d;
    if z > 20 && abs(x) < 30 { continue; }
    if x < -94 || x > 94 || z < VR_GROUND_Z0 + 2 || z > 38 { continue; }
    r = arch_stand(s[..], x, vr_at(v, x, z) - 0.2, z, a * 3, arch_vary(79, i, 1.0, 1.8));
    if r < 0 { break; }
    k := arch_vary(80, i, 0.85, 1.1); vr_wash(s[..], r, k, k, k); n += 1;
  }
  arch_draw(s[..], pine, first, n);

  // ---- the mountains: a broad dome on the left with pines on it, a peak right of the church, ridges between and round
  dome := arch_peak(p[..], 190, 195, 0.5, 0.05, 3);
  r = arch_stand(s[..], -370, -14, -440, 0.3, 1); arch_draw(s[..], dome, r, 1);
  r = arch_stand(s[..], 560, -14, -300, 1.7, 0.9); arch_draw(s[..], dome, r, 1);
  r = arch_stand(s[..], -120, -14, 620, 2.6, 1.1); arch_draw(s[..], dome, r, 1);
  peak := arch_peak(p[..], 150, 215, 1.2, 0.12, 9);
  r = arch_stand(s[..], 135, -14, -640, 0, 1); arch_draw(s[..], peak, r, 1);
  r = arch_stand(s[..], -640, -14, -150, 2.0, 1.2); arch_draw(s[..], peak, r, 1);
  r = arch_stand(s[..], 420, -14, 520, 4.0, 1.15); arch_draw(s[..], peak, r, 1);
  ridge := arch_peak(p[..], 260, 100, 0.8, 0.14, 15);
  ridges := [7] [3] f32.[[3] f32.[-110, -600, 0.5], [3] f32.[420, -620, 2.2], [3] f32.[-560, -520, 1.1], [3] f32.[700, 60, 3.0], [3] f32.[-650, 300, 0.2], [3] f32.[60, 760, 1.4], [3] f32.[250, -480, 4.1]];
  first = s[0].rn;
  for i: 0..<7 { r = arch_stand(s[..], ridges[i][0], -14, ridges[i][1], ridges[i][2], ifx i == 6 then 0.75f32 else 1.0f32); }
  arch_draw(s[..], ridge, first, 7);
  // Pines standing on the dome. They are scenery a walker never reaches: no solids.
  far_pine := ArchPart.{first = pine.first, count = pine.count};
  first = s[0].rn; n = 0;
  for i: 0..<12 {
    a := arch_hash(91, i) * f32(ARCH_TAU); d := arch_vary(92, i, 0, 70);
    r = arch_stand(s[..], -370 + cos(a) * d, 195 * (1 - pow(d / 190, 1.25)) - 16, -440 + sin(a) * d, a, arch_vary(93, i, 3.2, 4.8));
    if r < 0 { break; }
    n += 1;
  }
  arch_draw(s[..], far_pine, first, n);

  // ---- the country south of the village, and last its water
  vw_build(v, p[..], s[..]);
  v[0].wet_first = s[0].dn;
  vw_build_wet(v, p[..], s[..]);
  v[0].wet_n = s[0].dn - v[0].wet_first;

  // ---- what blocks a walker, and a mesh of it to look at
  v[0].placed_n = s[0].pn;
  arch_material(p[..], ARCH_M_GLOW, 1.0, 0.1, 0.8);
  shown := arch_solid_mesh(p[..], v[0].placed[..], v[0].placed_n, 0.03);
  v[0].solid_draw = s[0].dn;
  arch_once(s[..], ArchPart.{first = shown.first, count = shown.count});

  v[0].vertices = p[0].n; v[0].record_n = s[0].rn; v[0].draw_n = s[0].dn;
  v[0].built = ok && !p[0].full && !s[0].full;
  return v[0].built;
}

#test "the land climbs to the village, lies flat under it, and the plaza is paved from the road's end to the terrace" {
  #assert abs(vr_height(VR_ROAD_X, 0)) < 0.001 && abs(vr_height(VR_ROAD_X, -5.5) - VR_VILLAGE * 0.5) < 0.01 && abs(vr_height(VR_ROAD_X, -20) - VR_VILLAGE) < 0.001;
  #assert abs(vr_height(-7.4, -15.1) - VR_VILLAGE) < 0.001 && abs(vr_height(10.2, -16.6) - VR_VILLAGE) < 0.001 && abs(vr_height(VR_AXIS, -104) - VR_VILLAGE) < 0.001 && abs(vr_height(VR_AXIS + 30, -60) - VR_VILLAGE) < 0.001;
  #assert vr_paved(VR_AXIS, -50) == 1 && vr_paved(0, -15) == 0 && vr_paved(VR_AXIS + 30, -50) == 0 && vr_paved(VR_AXIS, -90) == 0 && vr_paved(VR_AXIS, -76) == 1;
  c := vr_shot_camera(); #assert abs(c.y - 1.68) < 0.001 && c.z == 3.3 && c.yaw == 0;
  c2 := vr_plaza_camera(); #assert vr_paved(c2.x, c2.z) == 1 && abs(c2.y - VR_VILLAGE - 1.68) < 0.001;
}
#test "the village builds whole: every part fits, every draw names records and vertices that exist, and so do its solids" #steps 2000000000 {
  scene: [1] VillageRoad; v := scene[..];
  #assert vr_build(v);
  #assert v[0].vertices > 200000 && v[0].vertices <= VR_VERTICES && v[0].vertices % 3 == 0 && v[0].record_n > 120 && v[0].draw_n >= 60;
  drawn := 0;
  for d: 0..<v[0].draw_n {
    o := d * 4;
    #assert cast(int) (v[0].draws[o] + v[0].draws[o + 1]) <= v[0].vertices && v[0].draws[o + 1] % 3 == 0 && cast(int) (v[0].draws[o + 2] + v[0].draws[o + 3]) <= v[0].record_n && v[0].draws[o + 3] > 0;
    drawn += cast(int) v[0].draws[o + 3];
  }
  // Every record is drawn exactly once, and the solids' own mesh is the last draw.
  #assert drawn == v[0].record_n && v[0].solid_draw == v[0].draw_n - 1;
  for i: 0..<v[0].record_n { o := i * ARCH_RECORD_FLOATS; #assert v[0].records[o + 4] > 0 && v[0].records[o + 8] > 0.5; }
  // What stands on the road stands on the ground: the cottage and the stone house are the third and
  // fourth records (after the land and the far land). No grass grows under them, and the plaza is paved.
  #assert abs(v[0].records[2 * ARCH_RECORD_FLOATS] + 7.4) < 0.001 && abs(v[0].records[2 * ARCH_RECORD_FLOATS + 1] - VR_VILLAGE) < 0.01;
  #assert abs(v[0].records[3 * ARCH_RECORD_FLOATS] - 10.2) < 0.001 && abs(v[0].records[3 * ARCH_RECORD_FLOATS + 1] - VR_VILLAGE) < 0.01;
  g := vr_ground();
  #assert arch_ground_at(g, v[0].table[..], -9.0, -15.0, 1) == 0 && arch_ground_at(g, v[0].table[..], 9.0, -16.5, 1) == 0 && arch_ground_at(g, v[0].table[..], -9.0, -4.0, 1) == 1;
  #assert arch_ground_at(g, v[0].table[..], VR_AXIS, -50, 2) == 1 && arch_ground_at(g, v[0].table[..], VR_AXIS, -50, 1) == 0;
  // The solids: hundreds, each of a kind, with a size and a top over its foot.
  #assert v[0].placed_n > 150 && v[0].placed_n <= VR_PLACED;
  for i: 0..<v[0].placed_n { o := i * ARCH_PLACED_FLOATS; #assert (v[0].placed[o] == ARCH_SOLID_BOX || v[0].placed[o] == ARCH_SOLID_ROUND) && v[0].placed[o + 3] > 0 && v[0].placed[o + 4] > 0 && v[0].placed[o + 7] > v[0].placed[o + 6]; }
  // You walk the road from shot 1 into the plaza, across it, up the steps onto the terrace and to
  // the church's door: what you see you can reach.
  at := world_point(0.3, vr_height(0.3, 3.3), 3.3);
  for i: 0..<400 { at = vr_walk(v, at, 0, -0.14); }
  #assert abs(at.x - 0.3) < 0.01 && at.z < -52 && abs(at.y - VR_VILLAGE) < 0.01;
  at.x = VR_AXIS + 3.4;
  for i: 0..<250 { at = vr_walk(v, at, 0, -0.14); }
  #assert abs(at.y - (VR_VILLAGE + VR_TERRACE)) < 0.001 && at.z < VR_PLAZA_FAR - VR_STEPS_RUN - 2;
  // On to the church: you stop at the foot of its tower, and before its door.
  for i: 0..<40 { at = vr_walk(v, at, 0, -0.14); }
  #assert at.z < VR_CHURCH_FRONT + 1.1 && at.z > VR_CHURCH_FRONT + 0.8 && abs(at.y - (VR_VILLAGE + VR_TERRACE)) < 0.001;
  at = world_point(VR_AXIS, VR_VILLAGE + VR_TERRACE, VR_CHURCH_FRONT + 1.9);
  for i: 0..<40 { at = vr_walk(v, at, 0, -0.1); }
  #assert at.z < VR_CHURCH_FRONT + 0.6 && at.z > VR_CHURCH_FRONT + 0.25 && abs(at.x - VR_AXIS) < 0.01;
  // Nothing lets you through: into the cottage's front, the stone house's, the dry-stone wall, a
  // tree and a lamp post, you stop outside each.
  at = world_point(-8.6, VR_VILLAGE, -8.0);
  for i: 0..<80 { at = vr_walk(v, at, 0, -0.1); } #assert at.z > -12.7 && at.z < -11.0;
  at = world_point(12.0, VR_VILLAGE, -9.0);
  for i: 0..<80 { at = vr_walk(v, at, 0, -0.1); } #assert at.z > -13.2 + 0.2 && at.z < -12.6;
  at = world_point(2.0, vr_at(v, 2.0, -3.0), -3.0);
  for i: 0..<120 { at = vr_walk(v, at, 0.1, 0); } #assert at.x < 8.4;
  at = world_point(-18.0, vr_at(v, -18.0, -3.0), -3.0);
  for i: 0..<80 { at = vr_walk(v, at, 0, -0.1); d := sqrt((at.x + 18.0) * (at.x + 18.0) + (at.z + 7.0) * (at.z + 7.0)); #assert d > 0.6; }
  at = world_point(VR_AXIS - 24.0, VR_VILLAGE, -32.0);
  for i: 0..<80 { at = vr_walk(v, at, 0, -0.1); d := sqrt((at.x - VR_AXIS + 24.0) * (at.x - VR_AXIS + 24.0) + (at.z + 36.0) * (at.z + 36.0)); #assert d > 0.36; }
  // The terrace's front is a wall from the plaza: only the steps take you up.
  at = world_point(VR_AXIS + 12.0, VR_VILLAGE, -70.0);
  for i: 0..<150 { at = vr_walk(v, at, 0.02, -0.1); } #assert at.z > VR_PLAZA_FAR && abs(at.y - VR_VILLAGE) < 0.001;
}
#test "a frame gives the shaders the road, the ground table, the sun's box and the grass field ahead of the eye" {
  u: [STY_UNIFORM_FLOATS] f32; look := vr_look(); eye := vr_shot_camera();
  #assert sty_frame(u[..], 1920, 1080, 0, eye, look);
  blades := vr_frame(u[..], look, eye);
  #assert blades == VR_GRASS_COLS * VR_GRASS_ROWS && u[STY_U_PATH_INFO] == 5 + VW_PATHS && u[STY_U_PATH + 4] == VR_ROAD_HALF && u[STY_U_GROUND + 3] == VR_GROUND_N;
  // The road's far end is ahead and near the middle of the picture; the cottage is left of it and the stone house right.
  end := sty_project(u[..], 0.2, VR_VILLAGE, -30); left := sty_project(u[..], -7.4, 3, -15.1); right := sty_project(u[..], 10.2, 3, -16.6);
  #assert end.ahead && abs(end.x - 960) < 80 && end.y > 480 && end.y < 600 && left.x < 600 && left.x > 0 && right.x > 1300 && right.x < 1920;
  // Both houses are inside the sun's box, and the big heap of cloud is in the sky's numbers.
  a := sty_rows(u[..], STY_U_LIGHT, -7.4, 3, -15.1); b := sty_rows(u[..], STY_U_LIGHT, 10.2, 3, -16.6);
  #assert abs(a[0]) < 0.9 && abs(a[1]) < 0.9 && a[2] > 0.05 && a[2] < 0.95 && abs(b[0]) < 0.9 && abs(b[1]) < 0.9 && u[STY_U_CUMULUS + 3] == look.cumulus[3] && look.cumulus[3] > 0.2;
  // From the plaza's shot the church, the fountain and the steps are in the picture and in the sun's box.
  eye = vr_plaza_camera(); #assert sty_frame(u[..], 1920, 1080, 0, eye, look) && vr_frame(u[..], look, eye) > 0;
  door := sty_project(u[..], VR_AXIS, VR_VILLAGE + VR_TERRACE + 1, VR_CHURCH_FRONT); foot := sty_project(u[..], VR_AXIS, VR_VILLAGE, VR_PLAZA_FAR);
  spire := sty_project(u[..], VR_AXIS + 5.3, VR_VILLAGE + VR_TERRACE + 22.6, VR_CHURCH_FRONT - 1.65);
  #assert door.ahead && foot.ahead && door.x > 700 && door.x < 960 && foot.y > 560 && foot.y < 640 && spire.y > 0 && spire.y < 120 && spire.x > 960 && spire.x < 1150;
  c := sty_rows(u[..], STY_U_LIGHT, VR_AXIS, 12, VR_CHURCH_FRONT); #assert abs(c[0]) < 0.95 && abs(c[1]) < 0.95 && c[2] > 0.02 && c[2] < 0.98;
}
