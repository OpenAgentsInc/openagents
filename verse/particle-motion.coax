// Where a particle is and how bright, from its emitter, its number and the
// clock alone: nothing is kept between frames, so the GPU draws every
// particle of every emitter in one instanced pass (particles.wgsl, generated
// from here by coax wgsl) and the checks below see the same numbers.
// Kinds: 0 embers rising off a flame, 1 dust drifting in a room's air,
// 2 fireflies wandering over grass and blinking.
pm_lo :: (a:f32,b:f32)->f32 { if a<b { return a; } return b; }
pm_hi :: (a:f32,b:f32)->f32 { if a>b { return a; } return b; }
pm_fract :: (x:f32)->f32 { return x-floor(x); }
// A number in [0, 1) for particle i of an emitter with this seed; k picks one of several.
verse_particle_hash :: (seed:f32,i:f32,k:f32)->f32 #export_c {
  return pm_fract(sin(pm_fract(seed*0.1031f32+i*0.1137f32+k*0.0731f32)*311.7f32+i*1.37f32)*437.585f32);
}
// How long a particle lives, seconds.
verse_particle_life :: (kind:f32)->f32 #export_c {
  if kind<0.5f32 { return 1.6f32; }
  if kind<1.5f32 { return 14.0f32; }
  return 7.0f32;
}
// How far through its life particle i is at time t, in [0, 1).
verse_particle_age :: (kind:f32,seed:f32,i:f32,t:f32,speed:f32)->f32 #export_c {
  return pm_fract(t*speed/verse_particle_life(kind)+verse_particle_hash(seed,i,0.0f32));
}
// Its offset from the emitter along axis (0 x, 1 y, 2 z), metres; radius is the emitter's size.
verse_particle_offset :: (kind:f32,seed:f32,i:f32,t:f32,speed:f32,radius:f32,axis:f32)->f32 #export_c {
  a:=verse_particle_age(kind,seed,i,t,speed);
  h:=verse_particle_hash(seed,i,axis+1.0f32);
  w:=t*speed;
  if kind<0.5f32 {
    if axis>0.5f32 && axis<1.5f32 { return a*radius*(0.55f32+0.45f32*h); }
    spread:=(h-0.5f32)*0.05f32+sin(w*(2.1f32+h*1.7f32)+i*2.3f32+axis*1.9f32)*0.035f32*a;
    return spread*(0.4f32+a);
  }
  if kind<1.5f32 {
    drift:=sin(w*(0.11f32+h*0.09f32)+i*1.7f32+axis*2.2f32)*0.45f32;
    if axis>0.5f32 && axis<1.5f32 { return 0.15f32+h*1.9f32+drift*0.5f32-a*0.35f32; }
    return (h*2.0f32-1.0f32)*radius+drift;
  }
  wander:=sin(w*(0.31f32+h*0.23f32)+i*3.1f32)*0.9f32+sin(w*(0.73f32+h*0.41f32)+axis*4.0f32)*0.35f32;
  if axis>0.5f32 && axis<1.5f32 { return 0.35f32+h*1.1f32+sin(w*0.53f32+i)*0.25f32; }
  return (h*2.0f32-1.0f32)*radius+wander;
}
// Its light, 0 to about 1, before the emitter's colour; flicker is the emitter's.
verse_particle_glow :: (kind:f32,seed:f32,i:f32,t:f32,speed:f32,flicker:f32)->f32 #export_c {
  a:=verse_particle_age(kind,seed,i,t,speed);
  h:=verse_particle_hash(seed,i,5.0f32);
  if kind<0.5f32 {
    fade:=(1.0f32-a)*pm_lo(1.0f32,a*12.0f32);
    return fade*(1.0f32-flicker*0.5f32+flicker*0.5f32*sin(t*(17.0f32+h*9.0f32)+i));
  }
  if kind<1.5f32 {
    edge:=pm_lo(a,1.0f32-a)*5.0f32;
    return pm_lo(1.0f32,edge)*(0.35f32+0.65f32*h);
  }
  p:=pm_hi(0.0f32,sin(t*speed*(0.9f32+h*0.8f32)+i*5.3f32));
  p2:=p*p;
  return p2*p2*p*pm_lo(1.0f32,pm_lo(a,1.0f32-a)*8.0f32);
}
// Its size, metres across.
verse_particle_size :: (kind:f32,seed:f32,i:f32,t:f32,speed:f32,size:f32)->f32 #export_c {
  a:=verse_particle_age(kind,seed,i,t,speed);
  if kind<0.5f32 { return size*(1.0f32-a*0.6f32); }
  return size*(0.7f32+0.6f32*verse_particle_hash(seed,i,6.0f32));
}
#test "every particle's hash is in [0, 1)" {
  for i:0..<512 { h:=verse_particle_hash(3.0f32,cast(f32)i,1.0f32);#assert h>=0.0f32 && h<1.0f32; }
}
#test "embers rise and fade as they age" {
  #assert verse_particle_offset(0.0f32,1.0f32,0.0f32,0.0f32,1.0f32,0.4f32,1.0f32)>=0.0f32;
  #assert verse_particle_offset(0.0f32,1.0f32,0.0f32,0.0f32,1.0f32,0.4f32,1.0f32)<=0.4f32;
  #assert verse_particle_glow(0.0f32,1.0f32,0.0f32,0.0f32,1.0f32,0.0f32)<=1.0f32;
}
#test "dust stays inside its room's box and above the floor" {
  for i:0..<256 { t:=cast(f32)i*0.37f32;
    x:=verse_particle_offset(1.0f32,2.0f32,cast(f32)i,t,1.0f32,3.0f32,0.0f32);
    y:=verse_particle_offset(1.0f32,2.0f32,cast(f32)i,t,1.0f32,3.0f32,1.0f32);
    #assert x>=-3.5f32 && x<=3.5f32;
    #assert y>=-0.3f32 && y<=2.4f32;
  }
}
#test "fireflies blink: dark between flashes" {
  dark:=0;for i:0..<64 { if verse_particle_glow(2.0f32,4.0f32,cast(f32)i,10.0f32,1.0f32,0.0f32)<0.01f32 {dark+=1;} }
  #assert dark>16;
}
