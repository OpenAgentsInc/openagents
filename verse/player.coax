// The player controller every walkable Verse realm uses, starting with the
// Grid: a port of aethyr-cpp's src/player_core.cpp, itself a port of
// three-player-controller (github.com/hh-hang/three-player-controller, MIT).
// It covers walking, running, gravity, jumping and the third-person camera.
// First person, top down, the front view, animation clips, sounds and dust
// come later.
//
// Units are metres and seconds; +Y is up, and yaw 0 faces +Z, as in
// openagents.engine.v1. The host keeps a Player value and passes it back on
// every call. Controls arrive in the shape of engine.v1 InputIntent.
//
// The world answers three questions: the floor under your feet, how far you
// may move before something is in the way, and how far the camera may sit
// before something is in the way. World is a flat floor at `ground`, `room`
// metres of camera room, and the robots' bodies: capsules that move with
// them (verse/cast.coax places them each frame). You are a capsule too,
// RADIUS wide and HEIGHT tall, as aethyr's characters (src/physics): a body
// pushes you out sideways and stops the part of your speed that goes into
// it, and pulls the camera in front of it. Walls are boxes (min and max
// corners; verse/grid.coax's terminal): their tops are floors you stand
// on, up to STEP_UP above your feet as aethyr's kStepUp, and higher ones
// stop you as bodies do. Floors are a realm's other surfaces
// (verse/stand.coax: a roof's slopes, a tower's cone, rubble's tops): you
// land on the highest one under you and walk on it up to STEP_UP above your
// feet, one too steep (past STAND_STEEP) slides you off its low edge, and
// one whose surface would cut through you stops you walking into it.
//
// Changes from aethyr: the fixed step is 1/64 s instead of 1/60 s, so step
// counts are exact; a stick inside the dead zone is no input (aethyr walked
// at full speed on any stick drift).

#module "verse.player";   // a page may #load it as an alias (Dead Gears does)
#load "stand.coax";

PI :: 3.14159265;
TAU :: 6.2831853;

WALK :: 3.5;            // m/s
RUN :: 7.5;
// The one setting for how you move (the owner's, 2026-10-29; meant to become
// a player's setting): true, moving runs (RUN) and holding Shift walks
// (WALK); false, moving walks and Shift runs. On a phone the stick decides
// either way: a full push runs, a light one walks (verse/grid.coax RUN_PAST).
RUN_BY_DEFAULT :: true;
GRAVITY :: 24.0;        // m/s^2
JUMP :: 7.5;            // m/s up: a 1.17 m peak
ACCEL :: 60.0;          // m/s^2, speeding up and slowing down alike
TURN_RATE :: 10.0;      // how fast the character turns to face its way
RIDE_HEIGHT :: 0.4;     // higher than this above the floor is falling
STEP_SMOOTH :: 10.0;
LOOK_AT_HEIGHT :: 1.52; // the camera's target above the feet
CAM_MAX :: 4.4;
CAM_WALL_MIN :: 0.35;   // closest a wall pushes the camera in
CAM_LERP :: 0.18;       // per 1/60 s, as the library tuned it
SPRING_TIME :: 0.1;
PHI_MIN :: 0.1;         // the camera's angle down from straight up
PHI_MAX :: 3.04159265;  // PI - PHI_MIN
BEHIND_PHI :: 1.10714872; // atan2(400, 200): behind you and above
DEAD_ZONE :: 0.2;       // stick travel that counts as no input
STEP :: 0.015625;       // the fixed gameplay step, 1/64 s
MAX_STEPS :: 8;         // steps one frame may run; the rest is dropped
MAX_FRAME :: 0.25;      // the longest frame time that counts
RADIUS :: 0.3;          // your capsule, as aethyr's kRadius
HEIGHT :: 1.8;
BODY :: 7;              // numbers per body: one end, the other, the radius
PASSES :: 3;            // push-outs per step, for bodies that touch
CAM_CLEAR :: 0.2;       // how far the camera keeps from a body
WALL :: 6;              // numbers per wall: min x, y, z, max x, y, z
STEP_UP :: 0.55;        // the highest top you walk onto
FLOOR_PAD :: 0.15;      // how far past a floor's edge your middle may be and it still holds you
SLIDE_GRIP :: 0.1;      // the share of your feet's push you keep on a slope too steep to stand on

Vec3 :: struct { x: f32; y: f32; z: f32; }

// A flat floor, the camera's room, and the bodies (BODY numbers each).
World :: struct {
  ground: f32 = 0;
  room: f32 = 1000;
  bodies: [] f32;
  walls: [] f32;
  floors: [] f32;       // STAND_FLOATS numbers each (verse/stand.coax), on the same floor as the walls
}

// What the character is doing, for the animation that comes later. The
// host reads it as verse_player_act's number.
Act :: enum u8 { idle; walking; running; airborne; }

Player :: struct {
  pos: Vec3;            // feet, after the last step
  vel: Vec3;
  face: f32;            // yaw the character faces
  on_ground: bool = true;
  act: Act = Act.idle;
  // The orbit camera: theta around +Y from +Z, phi down from +Y, and its
  // distance from the spring-followed target.
  theta: f32 = PI;
  phi: f32 = BEHIND_PHI;
  dist: f32 = CAM_MAX;
  max_dist: f32 = CAM_MAX;
  zoom_push: f32;       // zoom past a view's end, gathering to cross it
  target: Vec3 = Vec3.{x = 0, y = LOOK_AT_HEIGHT, z = 0};
  spring_vel: Vec3;
  // The controls held now.
  key_x: f32;
  key_y: f32;
  pad_x: f32;
  pad_y: f32;
  run: bool;
  jump_held: bool;
  // Fixed steps: time not yet stepped, and where the last step began, so the
  // frame shows a point between the last two steps.
  carry: f32;
  prev_pos: Vec3;
  prev_target: Vec3 = Vec3.{x = 0, y = LOOK_AT_HEIGHT, z = 0};
  prev_face: f32;
  prev_dist: f32 = CAM_MAX;
  // Your speed's share, set by the realm: 1 on land, 0.5 wading or swimming
  // (verse/everglade/river.coax pace_of). WALK and RUN themselves never change.
  pace: f32 = 1;
  grip: f32 = 1;       // the share of your feet's grip on the ground (a realm's ice: everglade-frost.coax); less slides you
  sliding: bool;       // on a floor too steep to stand on, sliding down it
}

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
mix :: (a: f32, b: f32, t: f32) -> f32 { return a + (b - a) * t; }
mix3 :: (a: Vec3, b: Vec3, t: f32) -> Vec3 {
  return Vec3.{x = mix(a.x, b.x, t), y = mix(a.y, b.y, t), z = mix(a.z, b.z, t)};
}
finite :: (a: f32) -> bool { return a == a && a < 1000000.0 && a > -1000000.0; }

// An angle in [-PI, PI).
wrap_angle :: (a: f32) -> f32 { return a - f32(TAU) * floor((a + f32(PI)) / f32(TAU)); }

// atan on [0, 1], within 2e-5 rad.
atan_unit :: (t: f32) -> f32 {
  s := t * t;
  return t * (0.99997726 + s * (-0.33262347 + s * (0.19354346 + s * (-0.11643287 + s * (0.05265332 + s * -0.01172120)))));
}

// The angle of (x, y) from +X, in [-PI, PI]; 0 for the origin.
atan2 :: (y: f32, x: f32) -> f32 {
  ax := abs(x); ay := abs(y);
  if ax == 0 && ay == 0 { return 0; }
  a := ifx ay > ax then f32(PI / 2) - atan_unit(ax / ay) else atan_unit(ay / ax);
  if x < 0 { a = f32(PI) - a; }
  if y < 0 { a = -a; }
  return a;
}

// ---- The world ----

// Wall i, if it is whole, finite and not inside out.
Box :: struct { lo: Vec3; hi: Vec3; ok: bool; }
wall :: (w: World, i: int) -> Box {
  out: Box;
  k := i * WALL;
  for j: 0..<WALL { if !finite(w.walls[k + j]) { return out; } }
  out.lo = Vec3.{x = w.walls[k], y = w.walls[k + 1], z = w.walls[k + 2]};
  out.hi = Vec3.{x = w.walls[k + 3], y = w.walls[k + 4], z = w.walls[k + 5]};
  out.ok = out.lo.x <= out.hi.x && out.lo.y <= out.hi.y && out.lo.z <= out.hi.z;
  return out;
}
// How far (x, z) is outside the box's footprint, and the nearest point on it.
Edge :: struct { x: f32; z: f32; d: f32; }
edge :: (b: Box, x: f32, z: f32) -> Edge {
  e: Edge;
  e.x = clamp(x, b.lo.x, b.hi.x); e.z = clamp(z, b.lo.z, b.hi.z);
  e.d = sqrt((x - e.x) * (x - e.x) + (z - e.z) * (z - e.z));
  return e;
}

// The floor under feet at (x, z): the ground, or the highest wall top your
// capsule is over or floor you are over that is no more than STEP_UP above
// your feet.
floor_at :: (w: World, x: f32, z: f32, feet: f32) -> f32 { return floor_under(w, x, z, feet).y; }
// The same with its slope (a wall's top and the ground are level).
floor_under :: (w: World, x: f32, z: f32, feet: f32) -> StandHit {
  out := StandHit.{y = w.ground};
  for i: 0..<w.walls.count / WALL {
    b := wall(w, i);
    if !b.ok || b.hi.y > feet + f32(STEP_UP) || b.hi.y <= out.y { continue; }
    if edge(b, x, z).d < f32(RADIUS) { out.y = b.hi.y; }
  }
  n := w.floors.count / STAND_FLOATS;
  if n > 0 {
    h := stand_top(w.floors, n, x, z, feet + f32(STEP_UP), f32(FLOOR_PAD));
    if h.y > out.y && finite(h.y) { out = h; }
  }
  return out;
}
// Whether a floor's surface at (x, z) would cut through you with your feet at `feet`: over a step
// and under your head.
floor_cuts :: (w: World, x: f32, z: f32, feet: f32) -> bool {
  n := w.floors.count / STAND_FLOATS;
  if n == 0 { return false; }
  return stand_cuts(w.floors, n, x, z, feet + f32(STEP_UP), feet + f32(HEIGHT) - 0.1);
}
// p moved from `from`: if it walked into a floor's side (a roof's slope cutting through it where it
// was clear before), back along whichever way stays clear, its speed that way stopped.
off_floors :: (w: World, from: Player, p: Player) -> Player {
  if w.floors.count < STAND_FLOATS || !floor_cuts(w, p.pos.x, p.pos.z, p.pos.y) || floor_cuts(w, from.pos.x, from.pos.z, from.pos.y) { return p; }
  next := p;
  if !floor_cuts(w, p.pos.x, from.pos.z, p.pos.y) { next.pos.z = from.pos.z; next.vel.z = 0; return next; }
  if !floor_cuts(w, from.pos.x, p.pos.z, p.pos.y) { next.pos.x = from.pos.x; next.vel.x = 0; return next; }
  next.pos.x = from.pos.x; next.pos.z = from.pos.z; next.vel.x = 0; next.vel.z = 0;
  return next;
}

// Pushes p sideways out of every wall too high to stand on, zeroing the
// speed that went into it; from inside a footprint, out the nearest side.
out_of_walls :: (w: World, p: Player) -> Player {
  next := p;
  for i: 0..<w.walls.count / WALL {
    b := wall(w, i);
    if !b.ok || b.hi.y <= next.pos.y + f32(STEP_UP) || b.lo.y >= next.pos.y + f32(HEIGHT) { continue; }
    e := edge(b, next.pos.x, next.pos.z);
    if e.d >= f32(RADIUS) { continue; }
    ux := 0.0f32; uz := 0.0f32; push := 0.0f32;
    if e.d > 0.0001 {
      ux = (next.pos.x - e.x) / e.d; uz = (next.pos.z - e.z) / e.d; push = f32(RADIUS) - e.d;
    } else {
      // Inside: the side you are nearest.
      west := next.pos.x - b.lo.x; east := b.hi.x - next.pos.x;
      south := next.pos.z - b.lo.z; north := b.hi.z - next.pos.z;
      least := lo(lo(west, east), lo(south, north));
      if least == west { ux = -1; } else if least == east { ux = 1; } else if least == south { uz = -1; } else { uz = 1; }
      push = least + f32(RADIUS);
    }
    next.pos.x += ux * push; next.pos.z += uz * push;
    into := next.vel.x * ux + next.vel.z * uz;
    if into < 0 { next.vel.x -= ux * into; next.vel.z -= uz * into; }
  }
  return next;
}

v3 :: (x: f32, y: f32, z: f32) -> Vec3 { return Vec3.{x = x, y = y, z = z}; }
add :: (a: Vec3, b: Vec3) -> Vec3 { return v3(a.x + b.x, a.y + b.y, a.z + b.z); }
sub :: (a: Vec3, b: Vec3) -> Vec3 { return v3(a.x - b.x, a.y - b.y, a.z - b.z); }
times :: (a: Vec3, k: f32) -> Vec3 { return v3(a.x * k, a.y * k, a.z * k); }
dot :: (a: Vec3, b: Vec3) -> f32 { return a.x * b.x + a.y * b.y + a.z * b.z; }

// Body i, if it is whole and finite.
Body :: struct { a: Vec3; b: Vec3; r: f32; ok: bool; }
body :: (w: World, i: int) -> Body {
  out: Body;
  k := i * BODY;
  for j: 0..<BODY { if !finite(w.bodies[k + j]) { return out; } }
  out.a = v3(w.bodies[k], w.bodies[k + 1], w.bodies[k + 2]);
  out.b = v3(w.bodies[k + 3], w.bodies[k + 4], w.bodies[k + 5]);
  out.r = w.bodies[k + 6];
  out.ok = out.r > 0;
  return out;
}

// The closest points of segments p0-p1 and q0-p1 (either may be a point):
// how far along each (0 to 1), and the points (Ericson, Real-Time Collision
// Detection, 5.1.9).
Closest :: struct { s: f32; t: f32; p: Vec3; q: Vec3; }
closest :: (p0: Vec3, p1: Vec3, q0: Vec3, q1: Vec3) -> Closest {
  d1 := sub(p1, p0); d2 := sub(q1, q0); r := sub(p0, q0);
  a := dot(d1, d1); e := dot(d2, d2); f := dot(d2, r);
  out: Closest;
  tiny := 0.000001f32;
  if a <= tiny && e <= tiny {
  } else if a <= tiny {
    out.t = clamp(f / e, 0, 1);
  } else {
    c := dot(d1, r);
    if e <= tiny {
      out.s = clamp(-c / a, 0, 1);
    } else {
      b := dot(d1, d2);
      denom := a * e - b * b;
      if denom > tiny * a * e { out.s = clamp((b * f - c * e) / denom, 0, 1); }
      out.t = (b * out.s + f) / e;
      if out.t < 0 { out.t = 0; out.s = clamp(-c / a, 0, 1); }
      else if out.t > 1 { out.t = 1; out.s = clamp((b - c) / a, 0, 1); }
    }
  }
  out.p = add(p0, times(d1, out.s));
  out.q = add(q0, times(d2, out.t));
  return out;
}

// Your capsule's axis, feet at `feet`.
shin :: (feet: Vec3) -> Vec3 { return v3(feet.x, feet.y + f32(RADIUS), feet.z); }
crown :: (feet: Vec3) -> Vec3 { return v3(feet.x, feet.y + f32(HEIGHT - RADIUS), feet.z); }

// Moves p horizontally by (dx, dz), then out of every body it overlaps,
// sideways, and zeroes the part of its velocity going into one. Standing
// right under or on a body's axis, you go back the way you came (or to -Z).
move_across :: (w: World, p: Player, dx: f32, dz: f32) -> Player {
  next := p;
  next.pos.x += dx;
  next.pos.z += dz;
  n := w.bodies.count / BODY;
  for pass: 0..<PASSES {
    pushed := false;
    for i: 0..<n {
      bd := body(w, i);
      if !bd.ok { continue; }
      c := closest(shin(next.pos), crown(next.pos), bd.a, bd.b);
      need := bd.r + f32(RADIUS);
      dy := c.p.y - c.q.y;
      if abs(dy) >= need { continue; }
      hx := c.p.x - c.q.x; hz := c.p.z - c.q.z;
      h := sqrt(hx * hx + hz * hz);
      reach := sqrt(need * need - dy * dy);
      if h >= reach { continue; }
      if h < 0.0001 {
        hx = -dx; hz = -dz;
        h = sqrt(hx * hx + hz * hz);
        if h < 0.0001 { hx = 0; hz = -1; h = 1; }
        hx = hx / h * 0.0001; hz = hz / h * 0.0001; h = 0.0001;
      }
      ux := hx / h; uz := hz / h;
      next.pos.x += ux * (reach - h);
      next.pos.z += uz * (reach - h);
      into := next.vel.x * ux + next.vel.z * uz;
      if into < 0 { next.vel.x -= ux * into; next.vel.z -= uz * into; }
      pushed = true;
    }
    next = out_of_walls(w, next);
    if !pushed { break; }
  }
  return next;
}

// How far the camera may sit from target along offset (a unit direction)
// before something is in the way, up to max: the room, and CAM_CLEAR short
// of the nearest body the line crosses.
camera_room :: (w: World, target: Vec3, offset: Vec3, max: f32) -> f32 {
  room := lo(w.room, max);
  // Walls: where the line enters each, widened by CAM_CLEAR (slabs).
  for i: 0..<w.walls.count / WALL {
    b := wall(w, i);
    if !b.ok { continue; }
    enter := 0.0f32; leave := max; hit := true;
    o: [3] f32; d: [3] f32; l: [3] f32; h: [3] f32;
    o[0] = target.x; o[1] = target.y; o[2] = target.z;
    d[0] = offset.x; d[1] = offset.y; d[2] = offset.z;
    l[0] = b.lo.x; l[1] = b.lo.y; l[2] = b.lo.z;
    h[0] = b.hi.x; h[1] = b.hi.y; h[2] = b.hi.z;
    for k: 0..<3 {
      a := l[k] - f32(CAM_CLEAR); z := h[k] + f32(CAM_CLEAR);
      if abs(d[k]) < 0.000001 {
        if o[k] < a || o[k] > z { hit = false; }
      } else {
        t0 := (a - o[k]) / d[k]; t1 := (z - o[k]) / d[k];
        enter = hi(enter, lo(t0, t1)); leave = lo(leave, hi(t0, t1));
      }
    }
    if hit && enter <= leave { room = lo(room, enter); }
  }
  far := add(target, times(offset, max));
  for i: 0..<w.bodies.count / BODY {
    bd := body(w, i);
    if !bd.ok { continue; }
    c := closest(target, far, bd.a, bd.b);
    gap := sub(c.p, c.q);
    d2 := dot(gap, gap);
    r := bd.r + f32(CAM_CLEAR);
    if d2 >= r * r { continue; }
    // The line enters the widened body about this far before the closest
    // point: further when it crosses the axis at a slant.
    axis := sub(bd.b, bd.a);
    size := dot(axis, axis);
    slant := 1.0f32;
    if size > 0.000001 {
      along := dot(axis, offset);
      slant = sqrt(hi(1 - along * along / size, 0.04));
    }
    room = lo(room, hi(c.s * max - sqrt(r * r - d2) / slant, 0));
  }
  return room;
}

// ---- The controller ----

look_at :: (p: Player) -> Vec3 { return Vec3.{x = p.pos.x, y = p.pos.y + f32(LOOK_AT_HEIGHT), z = p.pos.z}; }

orbit_offset :: (p: Player) -> Vec3 {
  return Vec3.{x = sin(p.phi) * sin(p.theta), y = cos(p.phi), z = sin(p.phi) * cos(p.theta)};
}

place_in :: (w: World, x: f32, y: f32, z: f32, yaw: f32) -> Player {
  p: Player;
  p.pos = Vec3.{x = x, y = y, z = z};
  p.face = wrap_angle(yaw);
  p.theta = wrap_angle(yaw + f32(PI));
  p.on_ground = y - floor_at(w, x, z, y) <= f32(RIDE_HEIGHT);
  p.target = look_at(p);
  p.prev_pos = p.pos;
  p.prev_target = p.target;
  p.prev_face = p.face;
  return p;
}

// Stands at feet facing yaw, with the camera behind.
verse_player_place :: (x: f32, y: f32, z: f32, yaw: f32) -> Player #export_c {
  w: World;
  return place_in(w, x, y, z, yaw);
}

// This frame's controls, as InputIntent carries them: keyboard axes (-1, 0,
// 1), stick axes in [-1, 1] (x right, y forward), run and jump held, and look
// deltas in radians (positive turns left and looks up). Jump acts when it is
// first pressed; the look turns the camera at once.
verse_player_input :: (p: Player, key_x: f32, key_y: f32, pad_x: f32, pad_y: f32,
                          run: bool, jump: bool, dyaw: f32, dpitch: f32) -> Player #export_c {
  next := p;
  next.key_x = clamp(key_x, -1, 1);
  next.key_y = clamp(key_y, -1, 1);
  next.pad_x = clamp(pad_x, -1, 1);
  next.pad_y = clamp(pad_y, -1, 1);
  if !finite(key_x) { next.key_x = 0; }
  if !finite(key_y) { next.key_y = 0; }
  if !finite(pad_x) || !finite(pad_y) { next.pad_x = 0; next.pad_y = 0; }
  next.run = run;
  pressed := jump && !p.jump_held;
  next.jump_held = jump;
  if pressed && next.on_ground {
    next.vel.y = JUMP;
    next.on_ground = false;
  }
  if finite(dyaw) { next.theta = wrap_angle(next.theta + dyaw); }
  if finite(dpitch) { next.phi = clamp(next.phi + dpitch, PHI_MIN, PHI_MAX); }
  return next;
}

// Whether you run this frame, for every realm's face: shift is Shift held
// (the key the realms call HOLD_RUN), stick_run the stick's full push
// (verse/grid.coax), pad its travel. A stick past the dead zone decides; the
// keys go by RUN_BY_DEFAULT, Shift turning it the other way.
verse_runs :: (shift: bool, stick_run: bool, pad_x: f32, pad_y: f32) -> bool #export_c {
  if finite(pad_x) && finite(pad_y) && sqrt(pad_x * pad_x + pad_y * pad_y) > f32(DEAD_ZONE) { return stick_run; }
  return shift != RUN_BY_DEFAULT;
}

// The way the controls push in the world, unit length when `on`.
Wish :: struct { x: f32; z: f32; on: bool; }

// Stick when it is past the dead zone, else keys, turned from the camera's
// frame into the world's.
wish :: (p: Player) -> Wish {
  ax := p.key_x; ay := p.key_y;
  if sqrt(p.pad_x * p.pad_x + p.pad_y * p.pad_y) > f32(DEAD_ZONE) { ax = p.pad_x; ay = p.pad_y; }
  size := sqrt(ax * ax + ay * ay);
  w: Wish;
  if size == 0 { return w; }
  mx := ax / size; mz := -ay / size;
  // Turn local -Z onto the camera's flat forward. The camera sits at theta
  // around the target, so its flat forward is -(sin theta, cos theta).
  c := cos(p.theta); s := sin(p.theta);
  w.x = mx * c + mz * s;
  w.z = -mx * s + mz * c;
  w.on = true;
  return w;
}

// The library's spring: a critically damped follow of dest, per axis. It
// returns the new position in x and the new velocity in y.
spring_axis :: (cur: f32, vel: f32, dest: f32, dt: f32) -> Vec3 {
  omega := f32(2.0 / SPRING_TIME);
  x := omega * dt;
  e := 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
  change := cur - dest;
  temp := (vel + omega * change) * dt;
  v := (vel - omega * temp) * e;
  o := dest + (change + temp) * e;
  if (dest - cur > 0) == (o > dest) { o = dest; v = 0; }
  return Vec3.{x = o, y = v, z = 0};
}

spring :: (p: Player, dest: Vec3, dt: f32) -> Player {
  next := p;
  a := spring_axis(p.target.x, p.spring_vel.x, dest.x, dt);
  b := spring_axis(p.target.y, p.spring_vel.y, dest.y, dt);
  c := spring_axis(p.target.z, p.spring_vel.z, dest.z, dt);
  next.target = Vec3.{x = a.x, y = b.x, z = c.x};
  next.spring_vel = Vec3.{x = a.y, y = b.y, z = c.y};
  return next;
}

// One fixed step.
step :: (w: World, p: Player, dt: f32) -> Player {
  next := p;
  dir := wish(p);
  speed := (ifx p.run then f32(RUN) else f32(WALK)) * clamp(ifx finite(p.pace) then p.pace else 1.0f32, 0, 1);

  // Horizontal velocity steps toward the wish at a fixed rate.
  dx := dir.x * speed - next.vel.x;
  dz := dir.z * speed - next.vel.z;
  diff := sqrt(dx * dx + dz * dz);
  if diff > 0 {
    grip := ifx finite(p.grip) && p.grip > 0 && p.grip < 1 && p.on_ground then p.grip else 1.0f32;
    if p.sliding { grip = f32(SLIDE_GRIP); }
    applied := lo(diff, f32(ACCEL) * grip * dt);
    next.vel.x += dx / diff * applied;
    next.vel.z += dz / diff * applied;
  }
  before := next;
  next = move_across(w, next, next.vel.x * dt, next.vel.z * dt);
  next = off_floors(w, before, next);

  // Gravity and the floor.
  under := floor_under(w, next.pos.x, next.pos.z, next.pos.y);
  ground := under.y;
  above := next.pos.y - ground;
  falls := true;
  next.sliding = false;
  if above <= f32(RIDE_HEIGHT) && next.vel.y <= 0 && stand_steep(under) {
    // Too steep to stand on: it holds you as you slide down it, gravity's pull along it speeding
    // you toward its low edge, and over that you fall.
    gl := sqrt(under.gx * under.gx + under.gz * under.gz);
    pull := f32(GRAVITY) * gl / (1 + gl * gl) * dt;
    next.vel.x -= under.gx / gl * pull; next.vel.z -= under.gz / gl * pull;
    next.vel.y = 0;
    next.pos.y = ground;
    next.on_ground = false;
    next.sliding = true;
    falls = false;
  } else if above <= f32(RIDE_HEIGHT) && next.vel.y <= 0 {
    if next.on_ground {
      // Standing: ease onto the floor.
      next.vel.y = 0;
      next.pos.y += (ground - next.pos.y) * lo(1, f32(STEP_SMOOTH) * dt);
      falls = false;
    } else if above + next.vel.y * dt <= 0 {
      // Lands this step.
      next.vel.y = 0;
      next.pos.y = ground;
      next.on_ground = true;
      falls = false;
    }
  }
  if falls {
    next.vel.y -= f32(GRAVITY) * dt;
    next.on_ground = false;
  }
  next.pos.y = hi(next.pos.y + next.vel.y * dt, ground - 0.05);

  // Turn toward where you are going.
  if dir.on {
    want := atan2(dir.x, dir.z);
    next.face = wrap_angle(next.face + wrap_angle(want - next.face) * lo(1, f32(TURN_RATE) * dt));
  }

  // Follow on the spring, and pull in at once where something is in the
  // way; back out gently.
  next = spring(next, look_at(next), dt);
  room := hi(f32(CAM_WALL_MIN), camera_room(w, next.target, orbit_offset(next), next.max_dist));
  if room < next.dist { next.dist = room; }
  else { next.dist += (room - next.dist) * (1 - pow(f32(1 - CAM_LERP), dt * 60)); }

  if !next.on_ground { next.act = Act.airborne; }
  else if !dir.on { next.act = Act.idle; }
  else if speed > f32(WALK) + 0.25 { next.act = Act.running; }   // shown running only at a run's speed
  else { next.act = Act.walking; }
  return next;
}

// Advances by a frame's time in fixed steps. At most MAX_STEPS run, and a
// longer backlog is dropped, so a stall never makes a frame slower.
advance_in :: (w: World, p: Player, frame: f32) -> Player {
  next := p;
  if finite(frame) { next.carry += clamp(frame, 0, MAX_FRAME); }
  n := 0;
  while next.carry >= f32(STEP) && n < MAX_STEPS {
    next.prev_pos = next.pos;
    next.prev_target = next.target;
    next.prev_face = next.face;
    next.prev_dist = next.dist;
    next = step(w, next, STEP);
    next.carry -= STEP;
    n += 1;
  }
  if next.carry >= f32(STEP) { next.carry = 0; }
  return next;
}

verse_player_advance :: (p: Player, frame: f32) -> Player #export_c {
  w: World;
  return advance_in(w, p, frame);
}

// The same among bodies (BODY numbers each, as verse_cast_bodies writes
// them) and walls (WALL numbers each, as verse_grid_walls writes them); a
// partial last one is ignored.
verse_player_advance_among :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32) -> Player #export_c {
  w: World;
  w.bodies = bodies;
  w.walls = walls;
  return advance_in(w, p, frame);
}
// And on floors (STAND_FLOATS numbers each, verse/stand.coax), on the same floor as the walls.
verse_player_advance_on :: (p: Player, frame: f32, bodies: [] f32, walls: [] f32, floors: [] f32) -> Player #export_c {
  w: World;
  w.bodies = bodies;
  w.walls = walls;
  w.floors = floors;
  return advance_in(w, p, frame);
}

// How far this frame is between the last two steps, in [0, 1].
alpha :: (p: Player) -> f32 { return clamp(p.carry / f32(STEP), 0, 1); }

// The feet and facing to draw this frame.
verse_player_feet :: (p: Player) -> Vec3 #export_c { return mix3(p.prev_pos, p.pos, alpha(p)); }
verse_player_face :: (p: Player) -> f32 #export_c {
  return wrap_angle(p.prev_face + wrap_angle(p.face - p.prev_face) * alpha(p));
}
// The camera this frame: what it looks at, and where it is. A wall pulls the
// camera in at once, so it is never shown further out than the last step.
verse_player_at :: (p: Player) -> Vec3 #export_c { return mix3(p.prev_target, p.target, alpha(p)); }
verse_player_eye :: (p: Player) -> Vec3 #export_c {
  at := verse_player_at(p);
  o := orbit_offset(p);
  d := lo(mix(p.prev_dist, p.dist, alpha(p)), p.dist);
  return Vec3.{x = at.x + o.x * d, y = at.y + o.y * d, z = at.z + o.z * d};
}
verse_player_act :: (p: Player) -> int #export_c { return cast(int) cast(u8) p.act; }

// ---- Checks ----

near :: (a: f32, b: f32, tolerance: f32) -> bool { return abs(a - b) <= tolerance; }
flat_speed :: (p: Player) -> f32 { return sqrt(p.vel.x * p.vel.x + p.vel.z * p.vel.z); }
held :: (p: Player, key_x: f32, key_y: f32, run: bool) -> Player {
  return verse_player_input(p, key_x, key_y, 0, 0, run, false, 0, 0);
}

#forall "atan2 points the right way" ix: -4..<5, iy: -4..<5 {
  x := f32(ix) * 0.5; y := f32(iy) * 0.5;
  a := atan2(y, x);
  #assert a >= -f32(PI) && a <= f32(PI);
  r := sqrt(x * x + y * y);
  if r == 0 { #assert a == 0; }
  else {
    #assert near(cos(a) * r, x, 0.0001 * r);
    #assert near(sin(a) * r, y, 0.0001 * r);
  }
}

#test "moving runs by default; Shift walks; a stick goes by its push" {
  #assert RUN_BY_DEFAULT;
  #assert verse_runs(false, false, 0, 0) && !verse_runs(true, false, 0, 0);
  #assert verse_runs(false, true, 0, 1) && !verse_runs(false, false, 0, 0.5);
  #assert !verse_runs(true, false, 0, 0.5) && verse_runs(true, true, 0, 1);
  #assert verse_runs(false, false, 0.1, 0.1);   // inside the dead zone the keys decide
  // the speed follows: a run reaches RUN, a walk WALK, and you're shown running only when you are
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  p = held(p, 0, 1, verse_runs(false, false, 0, 0));
  for i: 0..<60 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(RUN), 0.001) && p.act == Act.running;
  p = held(p, 0, 1, verse_runs(true, false, 0, 0));
  for i: 0..<60 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(WALK), 0.001) && p.act == Act.walking;
}

#test "atan2 behind is +PI, not -PI" {
  #assert atan2(0, -1) == f32(PI);
  #assert atan2(-0.5, -1) < 0;
}

#forall "atan_unit is close everywhere" i: 0..<101 {
  t := f32(i) / 100;
  #assert near(tan(atan_unit(t)), t, 0.00004);
}

#forall "wrap_angle keeps the direction" k: -30..<31 {
  a := f32(k) * 0.7;
  w := wrap_angle(a);
  #assert w >= -f32(PI) && w < f32(PI);
  #assert near(sin(w), sin(a), 0.0005) && near(cos(w), cos(a), 0.0005);
}

#test "placing sets every part of you" {
  w: World;
  w.ground = 2;
  p := place_in(w, 1, 2.25, -3, 0.5);
  #assert p.pos.x == 1 && p.pos.y == 2.25 && p.pos.z == -3;
  #assert p.face == 0.5 && near(p.theta, 0.5 - f32(PI), 0.000001);
  #assert p.on_ground;
  #assert p.target.x == 1 && near(p.target.y, 3.77, 0.000001) && p.target.z == -3;
  #assert p.prev_pos.x == 1 && p.prev_pos.y == 2.25 && p.prev_target.y == p.target.y && p.prev_face == 0.5;
  // Higher than RIDE_HEIGHT over this floor is in the air.
  #assert !place_in(w, 0, 2.41, 0, 0).on_ground;
  #assert place_in(w, 0, 0.3, 0, 0).on_ground;
  q := verse_player_place(0, 0.4, 0, 0);
  #assert q.on_ground && !verse_player_place(0, 0.41, 0, 0).on_ground;
}

#forall "speed never passes the top, and changes no faster than ACCEL" ix: -3..<4, iy: -3..<4, run: bool {
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  p = verse_player_input(p, 0, 0, f32(ix) * 0.5, f32(iy) * 0.5, run, false, 0, 0);
  top := ifx run then f32(RUN) else f32(WALK);
  for i: 0..<90 {
    before := p.vel;
    p = step(w, p, STEP);
    #assert flat_speed(p) <= top + 0.001;
    dvx := p.vel.x - before.x; dvz := p.vel.z - before.z;
    #assert sqrt(dvx * dvx + dvz * dvz) <= f32(ACCEL * STEP) + 0.001;
    #assert p.on_ground && p.pos.y == 0;
  }
  // A held stick past the dead zone reaches the top speed.
  if ix * ix + iy * iy > 0 { #assert near(flat_speed(p), top, 0.001); }
  else { #assert flat_speed(p) == 0; }
}

#test "on ice (a grip under one) the same wish takes you up to speed slower, and you slide on" {
  p := verse_player_place(0, 0, 0, 0);
  p = verse_player_input(p, 0, 1, 0, 0, true, false, 0, 0);
  dry := verse_player_advance(p, 0.0625);
  p.grip = 0.1;
  icy := verse_player_advance(p, 0.0625);
  #assert flat_speed(icy) < flat_speed(dry) * 0.2 && flat_speed(icy) > 0;
}

#test "a pace under one slows you by its share, and the land speeds stay as they are" {
  w: World;
  p := held(verse_player_place(0, 0, 0, 0), 0, 1, false);
  p.pace = 0.5;
  for i: 0..<128 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(WALK) * 0.5, 0.001);
  p.pace = 1;
  for i: 0..<128 { p = step(w, p, STEP); }
  #assert near(flat_speed(p), f32(WALK), 0.001);
  #assert verse_player_place(0, 0, 0, 0).pace == 1;
}

#forall "a stick inside the dead zone doesn't move you" ix: -3..<4, iy: -3..<4 {
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  p = verse_player_input(p, 0, 0, f32(ix) * 0.04, f32(iy) * 0.04, false, false, 0, 0);
  for i: 0..<30 { p = step(w, p, STEP); }
  #assert p.pos.x == 0 && p.pos.z == 0 && p.act == Act.idle;
}

#test "the dead zone ends at DEAD_ZONE" {
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  #assert step(w, verse_player_input(p, 0, 0, 0, 0.2, false, false, 0, 0), STEP).vel.z == 0;
  #assert step(w, verse_player_input(p, 0, 0, 0, 0.21, false, false, 0, 0), STEP).vel.z > 0;
  // Past it, the stick wins over the keys.
  q := step(w, verse_player_input(p, 0, -1, 0, 0.5, false, false, 0, 0), STEP);
  #assert q.vel.z > 0;
}

#forall "forward is the way you face" k: -4..<5 {
  w: World;
  yaw := f32(k) * 0.75;
  p := held(verse_player_place(0, 0, 0, yaw), 0, 1, false);
  for i: 0..<64 { p = step(w, p, STEP); }
  // One second at walking speed, less the time to get up to it.
  d := sqrt(p.pos.x * p.pos.x + p.pos.z * p.pos.z);
  #assert d > 3.3 && d <= f32(WALK);
  #assert near(p.pos.x / d, sin(yaw), 0.001) && near(p.pos.z / d, cos(yaw), 0.001);
  #assert near(wrap_angle(p.face - yaw), 0, 0.001);
  #assert p.act == Act.walking;
}

#test "the character turns to where it moves, at TURN_RATE" {
  w: World;
  // Right with the camera behind: walk toward -X.
  p := held(verse_player_place(0, 0, 0, 0), 1, 0, false);
  q := step(w, p, STEP);
  want := -f32(PI) / 2;
  #assert near(q.face, want * f32(TURN_RATE * STEP), 0.0001);
  for i: 0..<120 { q = step(w, q, STEP); }
  #assert near(q.face, want, 0.001);
  #assert q.vel.x < 0 && near(q.vel.z, 0, 0.0001);
  // Letting go keeps the facing.
  r := step(w, held(q, 0, 0, false), STEP);
  #assert r.face == q.face;
}

#forall "a jump goes up 1.17 m and lands back on the floor" run: bool, ix: -1..<2 {
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  p = verse_player_input(p, f32(ix), 0, 0, 0, run, true, 0, 0);
  #assert !p.on_ground && p.vel.y == f32(JUMP);
  peak := 0.0f32;
  steps := 0;
  while !p.on_ground && steps < 120 {
    p = step(w, p, STEP);
    if !p.on_ground { #assert p.act == Act.airborne; }
    // Holding jump in the air never jumps again.
    p = verse_player_input(p, f32(ix), 0, 0, 0, run, true, 0, 0);
    peak = hi(peak, p.pos.y);
    #assert p.pos.y >= -0.05;
    steps += 1;
  }
  #assert p.on_ground && p.pos.y == 0 && p.vel.y == 0;
  #assert near(peak, f32(JUMP * JUMP / (2 * GRAVITY)), 0.07);
  // About 2 JUMP / GRAVITY, 0.63 s.
  #assert steps >= 38 && steps <= 42;
  #assert p.act != Act.airborne;
}

#test "jump acts on the press, not the hold, and only from the ground" {
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  p = verse_player_input(p, 0, 0, 0, 0, false, true, 0, 0);
  for i: 0..<5 { p = step(w, p, STEP); }
  vy := p.vel.y;
  // Released and pressed again in the air: nothing.
  p = verse_player_input(p, 0, 0, 0, 0, false, false, 0, 0);
  p = verse_player_input(p, 0, 0, 0, 0, false, true, 0, 0);
  #assert p.vel.y == vy;
  while !p.on_ground { p = step(w, p, STEP); }
  // Still held after landing: no jump until it is pressed again.
  p = verse_player_input(p, 0, 0, 0, 0, false, true, 0, 0);
  #assert p.on_ground;
  p = verse_player_input(p, 0, 0, 0, 0, false, false, 0, 0);
  p = verse_player_input(p, 0, 0, 0, 0, false, true, 0, 0);
  #assert !p.on_ground && p.vel.y == f32(JUMP);
}

#test "placed in the air, you fall to the floor" {
  w: World;
  p := verse_player_place(0, 3, 0, 0);
  #assert !p.on_ground;
  p = step(w, p, STEP);
  #assert p.vel.y == -f32(GRAVITY * STEP) && p.act == Act.airborne;
  for i: 0..<64 { p = step(w, p, STEP); }
  #assert p.on_ground && p.pos.y == 0;
}

#test "standing eases onto a floor within RIDE_HEIGHT" {
  w: World;
  w.ground = 0.04;
  p := verse_player_place(0, 0, 0, 0);
  p.vel.y = -3;
  q := step(w, p, STEP);
  #assert q.on_ground && q.vel.y == 0;
  #assert near(q.pos.y, 0.04 * f32(STEP_SMOOTH * STEP), 0.000001);
  // Exactly RIDE_HEIGHT above still stands, and eases down.
  w.ground = 0;
  r := step(w, verse_player_place(0, 0.4, 0, 0), STEP);
  #assert r.on_ground && r.vel.y == 0 && near(r.pos.y, 0.4 * (1 - f32(STEP_SMOOTH * STEP)), 0.000001);
}

#test "walking off a ledge falls" {
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  w.ground = -2;
  q := step(w, p, STEP);
  #assert !q.on_ground && q.vel.y == -f32(GRAVITY * STEP) && q.act == Act.airborne;
}

#test "a fall that reaches the floor exactly lands" {
  w: World;
  p := verse_player_place(0, 0.25, 0, 0);
  p.on_ground = false;
  p.vel.y = -1;
  q := step(w, p, 0.25);
  #assert q.on_ground && q.pos.y == 0 && q.vel.y == 0;
}

#forall "the camera stays in its orbit" iy: -5..<6, ip: -5..<6 {
  p := verse_player_place(0, 0, 0, 0);
  p = verse_player_input(p, 0, 1, 0, 0, true, false, f32(iy) * 0.9, f32(ip) * 0.9);
  #assert p.phi >= f32(PHI_MIN) && p.phi <= f32(PHI_MAX);
  #assert p.theta >= -f32(PI) && p.theta < f32(PI);
  for i: 0..<20 {
    p = verse_player_advance(p, 0.02);
    eye := verse_player_eye(p); at := verse_player_at(p);
    #assert finite(eye.x) && finite(eye.y) && finite(eye.z);
    ex := eye.x - at.x; ey := eye.y - at.y; ez := eye.z - at.z;
    d := sqrt(ex * ex + ey * ey + ez * ez);
    #assert d >= f32(CAM_WALL_MIN) - 0.001 && d <= p.max_dist + 0.001;
  }
}

#test "looking turns the camera by the deltas" {
  p := verse_player_place(0, 0, 0, 0);
  q := verse_player_input(p, 0, 0, 0, 0, false, false, 0.3, 0.2);
  #assert near(q.theta, wrap_angle(f32(PI) + 0.3), 0.000001);
  #assert near(q.phi, f32(BEHIND_PHI) + 0.2, 0.000001);
}

#test "the eye sits dist along the orbit from the target" {
  p := verse_player_place(2, 0, 1, 1);
  at := verse_player_at(p);
  eye := verse_player_eye(p);
  o := orbit_offset(p);
  #assert near(eye.x - at.x, o.x * p.dist, 0.00001);
  #assert near(eye.y - at.y, o.y * p.dist, 0.00001);
  #assert near(eye.z - at.z, o.z * p.dist, 0.00001);
  // Behind you and above.
  #assert (eye.x - at.x) * sin(1.0f32) + (eye.z - at.z) * cos(1.0f32) < -1 && eye.y > at.y + 1;
}

#test "the camera pulls in at once and backs out gently" {
  w: World;
  w.room = 2;
  p := verse_player_place(0, 0, 0, 0);
  q := step(w, p, STEP);
  #assert q.dist == 2;
  // A wall closer than CAM_WALL_MIN still leaves that much.
  w.room = 0.1;
  #assert step(w, p, STEP).dist == f32(CAM_WALL_MIN);
  // Room again: out by CAM_LERP of the gap per 1/60 s.
  w.room = 1000;
  r := step(w, q, STEP);
  gap := f32(CAM_MAX) - 2;
  #assert near(r.dist, 2 + gap * (1 - pow(f32(1 - CAM_LERP), f32(STEP * 60))), 0.00001);
  #assert r.dist > 2 && r.dist < f32(CAM_MAX);
  // Exactly the room it has: it stays.
  w.room = 2;
  #assert step(w, q, STEP).dist == 2;
}

#test "the camera's target follows you on the spring" {
  w: World;
  p := held(verse_player_place(0, 0, 0, 0), 0, 1, false);
  for i: 0..<64 { p = step(w, p, STEP); }
  // It trails while you walk, never runs ahead, and settles once you stop.
  #assert p.target.z < p.pos.z && p.target.z > p.pos.z - 1;
  p = held(p, 0, 0, false);
  for i: 0..<128 { p = step(w, p, STEP); }
  t := look_at(p);
  #assert near(p.target.x, t.x, 0.001) && near(p.target.y, t.y, 0.001) && near(p.target.z, t.z, 0.001);
}

// The spring from rest, one step, against the exact critically damped
// follow: 1 - (1 + x) e^-x of the way, at speed omega x e^-x.
#forall "the spring is critically damped" k: 1..<8 {
  dt := f32(k) * 0.005;
  x := f32(2.0 / SPRING_TIME) * dt;
  a := spring_axis(0, 0, 1, dt);
  #assert near(a.x, 1 - (1 + x) * exp(-x), 0.002);
  #assert near(a.y, f32(2.0 / SPRING_TIME) * x * exp(-x), 0.05);
}

#test "the spring never overshoots" {
  // Coming from above or below fast enough to pass: it stops at the target.
  b := spring_axis(0.999, 50, 1, STEP);
  #assert b.x == 1 && b.y == 0;
  c := spring_axis(1.001, -50, 1, STEP);
  #assert c.x == 1 && c.y == 0;
  // Short of it from below a negative target: it keeps going.
  d := spring_axis(-2, 0, -1, STEP);
  #assert d.x > -2 && d.x < -1 && d.y > 0;
  // At the target but moving: it moves on.
  e := spring_axis(1, 5, 1, STEP);
  #assert e.x > 1 && e.y != 0;
}

#forall "bad numbers never get in" which: 0..<4 {
  bad := ifx which == 0 then 1.0f32 / 0.0f32 else ifx which == 1 then -1.0f32 / 0.0f32 else 0.0f32 / 0.0f32;
  if which == 3 { bad = 2000000.0; }
  p := verse_player_place(0, 0, 0, 0);
  q := verse_player_input(p, bad, bad, bad, 0.5, false, false, bad, bad);
  #assert q.key_x == 0 && q.key_y == 0 && q.pad_x == 0 && q.pad_y == 0;
  #assert q.theta == p.theta && q.phi == p.phi;
  q = verse_player_input(p, 0, 0, 0.5, bad, false, false, 0, 0);
  #assert q.pad_x == 0 && q.pad_y == 0;
  q = verse_player_advance(q, bad);
  #assert q.carry == 0;
  q = verse_player_advance(q, 0.1);
  #assert finite(q.pos.x) && finite(q.pos.z) && finite(q.carry);
}

#test "frames run whole steps and show the point between" {
  p := held(verse_player_place(0, 0, 0, 0), 0, 1, false);
  // A frame of exactly one step runs it.
  one := verse_player_advance(p, STEP);
  #assert one.carry == 0 && one.pos.z > 0;
  // A negative frame counts as none.
  #assert verse_player_advance(p, -1).carry == 0;
  p = verse_player_advance(p, f32(STEP) * 1.5);
  #assert alpha(p) == 0.5;
  f := verse_player_feet(p);
  #assert f.z > p.prev_pos.z && f.z < p.pos.z;
  #assert near(f.z, (p.prev_pos.z + p.pos.z) / 2, 0.0001);
  // A long stall runs at most MAX_STEPS and keeps no backlog, even one step.
  w: World;
  s := p;
  for i: 0..<MAX_STEPS { s = step(w, s, STEP); }
  q := verse_player_advance(p, 10);
  #assert q.carry == 0 && q.pos.z == s.pos.z;
  r := verse_player_place(0, 0, 0, 0);
  r.carry = 0;
  #assert verse_player_advance(r, f32(STEP) * (MAX_STEPS + 1)).carry == 0;
}

#test "each step remembers where it began" {
  w: World;
  w.room = 3;
  p := held(verse_player_place(0, 0, 0, 0), 1, 1, false);
  p = advance_in(w, p, STEP);
  q := advance_in(w, p, STEP);
  #assert q.prev_pos.x == p.pos.x && q.prev_pos.z == p.pos.z;
  #assert q.prev_target.z == p.target.z && q.prev_face == p.face && q.prev_dist == p.dist;
  #assert q.prev_face != q.face && q.prev_pos.z != q.pos.z;
}

#test "the facing shown turns the short way" {
  p := verse_player_place(0, 0, 0, 3.1);
  p.prev_face = 3.1;
  p.face = -3.1;
  p.carry = f32(STEP) / 2;
  #assert abs(verse_player_face(p)) > 3.1;
}

#test "the act names what you are doing" {
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  #assert p.act == Act.idle && verse_player_act(p) == 0;
  #assert verse_player_act(step(w, held(p, 0, 1, false), STEP)) == 1;
  #assert verse_player_act(step(w, held(p, 0, 1, true), STEP)) == 2;
}

#test "the stand-in world" {
  w: World;
  w.ground = 1.5;
  #assert floor_at(w, 5, -7, 2) == 1.5;
  p := verse_player_place(0, 0, 0, 0);
  p.vel = Vec3.{x = 1, y = 0, z = 2};
  q := move_across(w, p, 1.5, -2);
  #assert q.pos.x == 1.5 && q.pos.z == -2 && q.vel.x == 1 && q.vel.z == 2;
  w.room = 2;
  #assert camera_room(w, p.pos, orbit_offset(p), 3) == 2 && camera_room(w, p.pos, orbit_offset(p), 1) == 1;
}

#test "the helpers" {
  #assert clamp(5, -1, 1) == 1 && clamp(-5, -1, 1) == -1 && clamp(0.5, -1, 1) == 0.5;
  #assert mix(2, 4, 0.25) == 2.5;
  m := mix3(Vec3.{x = 0, y = 0, z = 0}, Vec3.{x = 2, y = 4, z = 8}, 0.5);
  #assert m.x == 1 && m.y == 2 && m.z == 4;
  #assert finite(999999) && !finite(1000000) && !finite(-1000000);
  #assert near(1, 1.5, 0.5) && !near(1, 1.6, 0.5);
}

// ---- Bodies ----

// A body standing 2 m ahead (+Z): a post 0.2 m wide from the floor to 3 m.
POST :: 7;
post :: (out: [] f32, x: f32, z: f32, r: f32) {
  out[0] = x; out[1] = 0; out[2] = z; out[3] = x; out[4] = 3; out[5] = z; out[6] = r;
}

#forall "closest points are no further apart than any other pair" i: 0..<6, j: 0..<6 {
  p0 := v3(0, 0, 0); p1 := v3(1, f32(i) * 0.4 - 1, 0.5);
  q0 := v3(f32(j) * 0.3 - 0.5, 1, -0.2); q1 := v3(0.4, f32(j) * -0.2, f32(i) * 0.1 + 0.7);
  if i == 5 { p1 = p0; }          // a point
  if j == 5 { q1 = q0; }
  c := closest(p0, p1, q0, q1);
  #assert c.s >= 0 && c.s <= 1 && c.t >= 0 && c.t <= 1;
  g := sub(c.p, c.q); best := dot(g, g);
  for a: 0..<21 {
    for b: 0..<21 {
      u := add(p0, times(sub(p1, p0), f32(a) / 20));
      v := add(q0, times(sub(q1, q0), f32(b) / 20));
      h := sub(u, v);
      #assert best <= dot(h, h) + 0.00001;
    }
  }
}

#test "parallel segments meet where they overlap" {
  c := closest(v3(0, 0, 0), v3(0, 2, 0), v3(1, 1, 0), v3(1, 3, 0));
  #assert near(c.p.x, 0, 0.00001) && near(c.q.x, 1, 0.00001) && near(c.p.y, c.q.y, 0.00001) && c.p.y >= 1 && c.p.y <= 2;
  d := closest(v3(0, 0, 0), v3(0, 0, 0), v3(1, 1, 0), v3(1, 1, 0));
  #assert d.s == 0 && d.t == 0 && d.q.x == 1;
}

#test "you walk up to a body and stop at its edge" {
  bodies: [POST] f32;
  post(bodies[..], 0, 2, 0.2);
  w: World;
  w.bodies = bodies[..];
  p := held(verse_player_place(0, 0, 0, 0), 0, 1, false);
  for i: 0..<48 { p = step(w, p, STEP); }
  #assert near(p.pos.z, 2 - 0.2 - f32(RADIUS), 0.0001) && near(p.pos.x, 0, 0.0001);
  // What went into it stopped; you still face it, pressing. (Held long
  // enough, the smallest drift slides you round it, as round bodies do.)
  #assert near(p.vel.z, 0, 0.0001) && p.act == Act.walking;
  // Sideways along it still goes.
  p = held(p, 1, 0, false);
  for i: 0..<64 { p = step(w, p, STEP); }
  #assert p.pos.x < -0.5 && near(p.pos.z, 1.5, 0.01);
}

#test "a body moving into you pushes you" {
  bodies: [POST] f32;
  w: World;
  w.bodies = bodies[..];
  p := verse_player_place(0, 0, 0, 0);
  for i: 0..<20 {
    post(bodies[..], 0, 1 - f32(i) * 0.05, 0.4);
    p = step(w, p, STEP);
  }
  // The post's at z = 0.05 now: you are a radius and its width behind it.
  #assert near(p.pos.z, 0.05 - 0.4 - f32(RADIUS), 0.0001);
}

#test "a body passes over your head and under your feet" {
  bodies: [14] f32;
  // A bar across at 2.3 m and a ball at 0.2 m, 1 m ahead.
  bodies[0] = -2; bodies[1] = 2.3; bodies[2] = 1; bodies[3] = 2; bodies[4] = 2.3; bodies[5] = 1; bodies[6] = 0.2;
  bodies[7] = 0; bodies[8] = 0.2; bodies[9] = 1; bodies[10] = 0; bodies[11] = 0.2; bodies[12] = 1; bodies[13] = 0.2;
  w: World;
  w.bodies = bodies[0..<7];
  p := verse_player_place(0, 0, 1, 0);
  #assert move_across(w, p, 0, 0).pos.z == 1;   // under the bar
  w.bodies = bodies[..];
  q := move_across(w, p, 0, 0);                 // on the ball: back off it
  #assert near(q.pos.z, 1 - sqrt(0.5f32 * 0.5 - 0.1 * 0.1), 0.0001);   // clear of it at your shin, 0.1 m above its centre
  // Jumping clear over it (its own: the bar would hit your head).
  w.bodies = bodies[7..<14];
  p.pos.y = 0.45;
  #assert move_across(w, p, 0, 0).pos.z == 1;
  p.pos.y = 0.39;
  #assert move_across(w, p, 0, 0).pos.z < 1;
}

#test "standing on a body's axis, you go back the way you came" {
  bodies: [POST] f32;
  post(bodies[..], 1, 1, 0.2);
  w: World;
  w.bodies = bodies[..];
  p := verse_player_place(1, 0, 0.5, 0);
  q := move_across(w, p, 0, 0.5);
  #assert near(q.pos.x, 1, 0.0001) && near(q.pos.z, 0.5, 0.0001);
  q = move_across(w, verse_player_place(1, 0, 1, 0), 0, 0);
  #assert near(q.pos.z, 0.5, 0.0001);
}

#test "the camera stops short of a body behind you" {
  bodies: [POST] f32;
  post(bodies[..], 0, -2, 0.3);
  w: World;
  w.bodies = bodies[..];
  p := verse_player_place(0, 0, 0, 0);
  // Straight back, level: CAM_CLEAR and its width before it.
  room := camera_room(w, v3(0, 1, 0), v3(0, 0, -1), 4);
  #assert near(room, 2 - 0.3 - f32(CAM_CLEAR), 0.0001);
  // A slanted line crossing the upright post stops sooner along itself.
  slant := camera_room(w, v3(0, 1, 0), v3(0, 0.6, -0.8), 4);
  #assert slant < 2 / 0.8 && slant > 0;
  // Off to the side, or behind the camera, it is not in the way.
  #assert camera_room(w, v3(0, 1, 0), v3(1, 0, 0), 4) == 4;
  #assert camera_room(w, v3(0, 1, 0), v3(0, 0, 1), 4) == 4;
  // Too close for any room: none, and the step keeps CAM_WALL_MIN.
  #assert camera_room(w, v3(0, 1, -1.6), v3(0, 0, -1), 4) == 0;
  q := step(w, p, STEP);
  #assert q.dist < f32(CAM_MAX);
}

#test "bodies with bad numbers, and a partial one, are skipped" {
  bodies: [10] f32;
  post(bodies[..], 0, 0, 0.5);
  w: World;
  p := verse_player_place(0, 0, 0, 0);
  w.bodies = bodies[..];
  #assert move_across(w, p, 0, 0).pos.z != 0;
  bodies[6] = 0;
  #assert move_across(w, p, 0, 0).pos.z == 0;    // no width
  for k: 0..<7 {
    post(bodies[..], 0, 0, 0.5);
    bodies[k] = 2000000;
    #assert move_across(w, p, 0, 0).pos.z == 0 && camera_room(w, v3(0, 1, 2), v3(0, 0, -1), 4) == 4;
  }
  post(bodies[..], 0, 0, 0.5);
  w.bodies = bodies[0..<6];
  #assert move_across(w, p, 0, 0).pos.z == 0;
  // The exported call reads them.
  stand := verse_player_advance_among(verse_player_place(0, 0, 0.2, 0), STEP, bodies[0..<7], bodies[0..<0]);
  #assert near(stand.pos.z, 0.8, 0.0001);
}

// ---- Walls ----

// The terminal: a desk 2.8 x 1 x 1 m at (0, 0, 4) and a screen on it.
desk :: (out: [] f32) {
  out[0] = -1.4; out[1] = 0; out[2] = 3.5; out[3] = 1.4; out[4] = 1; out[5] = 4.5;
  out[6] = -1.2; out[7] = 1; out[8] = 3.9; out[9] = 1.2; out[10] = 2.4; out[11] = 4.1;
}

#test "you walk up to the desk and stop" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  p := held(verse_player_place(0, 0, 0, 0), 0, 1, false);
  for i: 0..<64 { p = step(w, p, STEP); }
  #assert near(p.pos.z, 3.5 - f32(RADIUS), 0.0001) && near(p.pos.x, 0, 0.0001) && p.vel.z == 0 && p.on_ground;
  // Along it you still walk; past its end you go on.
  p = held(p, 1, 1, false);
  for i: 0..<128 { p = step(w, p, STEP); }
  #assert p.pos.x < -1.4 && p.pos.z > 3.5;
}

#test "a desk's corner rounds you off it, and inside one you go out the nearest side" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  q := move_across(w, verse_player_place(1.5, 0, 3.4, 0), 0, 0);
  d := sqrt((q.pos.x - 1.4) * (q.pos.x - 1.4) + (q.pos.z - 3.5) * (q.pos.z - 3.5));
  #assert near(d, f32(RADIUS), 0.0001) && q.pos.x > 1.4 && q.pos.z < 3.5;
  r := move_across(w, verse_player_place(1.3, 0, 4, 0), 0, 0);
  #assert near(r.pos.x, 1.4 + f32(RADIUS), 0.0001) && r.pos.z == 4;
  s := move_across(w, verse_player_place(0, 0, 3.6, 0), 0, 0);
  #assert near(s.pos.z, 3.5 - f32(RADIUS), 0.0001);
}

#test "you jump onto the desk and stand on it; the screen is still a wall" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  // Standing at the desk's front, jump while walking into it.
  p := held(verse_player_place(0, 0, 3.2, 0), 0, 1, false);
  p.jump_held = false;
  p = verse_player_input(p, 0, 1, 0, 0, false, true, 0, 0);
  for i: 0..<96 { p = step(w, p, STEP); }
  #assert near(p.pos.y, 1, 0.01) && p.on_ground;
  // On it, the screen stops you.
  #assert p.pos.z <= 3.9 - f32(RADIUS) + 0.0001 && p.pos.z > 3.5;
  #assert floor_at(w, p.pos.x, p.pos.z, p.pos.y) == 1;
  // A floor too high to step onto is not a floor.
  #assert floor_at(w, 0, 3.4, 0) == 0 && floor_at(w, 0, 3.4, 0.45) == 1;
  // Off its far side you fall back to the ground.
  #assert floor_at(w, 0, 4.8, 1) == 0;
}

#test "the camera stops short of the desk" {
  walls: [12] f32;
  desk(walls[..]);
  w: World;
  w.walls = walls[..];
  // From in front, looking back through it.
  room := camera_room(w, v3(0, 0.5, 2), v3(0, 0, 1), 4);
  #assert near(room, 1.5 - f32(CAM_CLEAR), 0.0001);
  // Above it, clear.
  #assert camera_room(w, v3(0, 3, 2), v3(0, 0, 1), 4) == 4;
  // Pointing away, clear; from inside, none.
  #assert camera_room(w, v3(0, 0.5, 2), v3(0, 0, -1), 4) == 4;
  #assert camera_room(w, v3(0, 0.5, 4), v3(0, 0, 1), 4) == 0;
}

#test "walls with bad numbers, inside out or partial are skipped" {
  walls: [12] f32;
  w: World;
  p := verse_player_place(0, 0, 4, 0);
  for k: 0..<6 {
    desk(walls[..]);
    walls[k] = 2000000;
    w.walls = walls[0..<6];
    #assert move_across(w, p, 0, 0).pos.z == 4 && floor_at(w, 0, 4, 0.9) == 0;
  }
  desk(walls[..]);
  walls[0] = 2;                        // min x past max x
  w.walls = walls[0..<6];
  #assert move_across(w, p, 0, 0).pos.z == 4;
  desk(walls[..]);
  w.walls = walls[0..<5];
  #assert move_across(w, p, 0, 0).pos.z == 4;
  w.walls = walls[..];
  #assert move_across(w, p, 0, 0).pos.z != 4;
  #assert verse_player_advance_among(verse_player_place(0, 0, 3.4, 0), STEP, walls[0..<0], walls[..]).pos.z < 3.21;
}

// Camera modes are shared engine behaviour, so worlds do not reimplement
// orientation in their native adapters. Mode 0 first, 1 third, 2 top down.
#test "first-person eye is in your head and looks along the orbit heading" {
 p:=verse_player_place(7,0,2,0);p.phi=f32(PI/2);
 e:=verse_player_view_eye(p,0);a:=verse_player_view_at(p,0);
 #assert near(e.x,7,0.001) && near(e.y,1.6,0.001) && near(e.z,2,0.001);
 #assert a.z>e.z && near(a.x,e.x,0.001);
}
verse_player_view_eye :: (p:Player,mode:int)->Vec3 #export_c {
 feet:=verse_player_feet(p);
 if mode==0 {return Vec3.{x=feet.x,y=feet.y+1.6,z=feet.z};}
 if mode==2 {return Vec3.{x=feet.x,y=feet.y+22,z=feet.z-0.01};}
 return verse_player_eye(p);
}
verse_player_view_at :: (p:Player,mode:int)->Vec3 #export_c {
 if mode==0 {eye:=verse_player_view_eye(p,0);o:=orbit_offset(p);return Vec3.{x=eye.x-o.x,y=eye.y-o.y,z=eye.z-o.z};}
 if mode==2{return verse_player_feet(p);}return verse_player_at(p);
}
verse_player_zoom :: (p:Player,delta:f32)->Player #export_c {next:=p;if finite(delta){next.max_dist=clamp(p.max_dist+delta,1,20);}return next;}
// Zooming crosses between first and third person. Out from first person
// past ZOOM_OUT starts third person at its closest; in past the closest
// third-person distance by ZOOM_IN goes to first person. The push gathers
// across frames and clears when the zoom turns, so a jitter at the
// boundary does not flap. Top down only zooms.
ZOOM_OUT :: 0.3;
ZOOM_IN :: 0.6;
PlayerZoom :: struct { player: Player; mode: int; }
verse_player_zoom_view :: (p:Player,mode:int,delta:f32)->PlayerZoom #export_c {
 z:PlayerZoom;z.player=p;z.mode=mode;if !finite(delta) || delta==0 {return z;}
 if mode==2 {z.player=verse_player_zoom(p,delta);return z;}
 if mode==0 {
  if delta<0 {z.player.zoom_push=0;return z;}
  z.player.zoom_push=p.zoom_push+delta;
  if z.player.zoom_push>=f32(ZOOM_OUT) {z.mode=1;z.player.max_dist=1;z.player.dist=1;z.player.prev_dist=1;z.player.phi=f32(BEHIND_PHI);z.player.zoom_push=0;}
  return z;
 }
 if delta>0 {z.player=verse_player_zoom(p,delta);z.player.zoom_push=0;return z;}
 z.player=verse_player_zoom(p,delta);
 if p.max_dist+delta>=1 {z.player.zoom_push=0;return z;}
 z.player.zoom_push=p.zoom_push+(1-(p.max_dist+delta));
 if z.player.zoom_push>=f32(ZOOM_IN) {z.mode=0;z.player.phi=f32(PI/2);z.player.zoom_push=0;}
 return z;
}
#test "zoom crosses first and third person without flapping" {
 p:=verse_player_place(7,0,2,0);
 z:=verse_player_zoom_view(p,0,0.1);#assert z.mode==0;
 z=verse_player_zoom_view(z.player,0,0.25);#assert z.mode==1 && z.player.max_dist==1 && z.player.phi==f32(BEHIND_PHI);
 z=verse_player_zoom_view(z.player,1,-0.3);#assert z.mode==1;
 z=verse_player_zoom_view(z.player,1,0.2);#assert z.mode==1 && near(z.player.max_dist,1.2,0.0001);
 z=verse_player_zoom_view(z.player,1,-0.2);z=verse_player_zoom_view(z.player,1,-0.2);#assert z.mode==1 && z.player.max_dist==1;
 z=verse_player_zoom_view(z.player,1,0.05);z=verse_player_zoom_view(z.player,1,-0.3);#assert z.mode==1;
 z=verse_player_zoom_view(z.player,1,-0.5);#assert z.mode==0 && near(z.player.phi,f32(PI/2),0.0001);
 z=verse_player_zoom_view(z.player,0,0.2);z=verse_player_zoom_view(z.player,0,-0.1);z=verse_player_zoom_view(z.player,0,0.2);#assert z.mode==0;
 z=verse_player_zoom_view(z.player,0,0.4);#assert z.mode==1;
 t:=verse_player_zoom_view(p,2,-3);#assert t.mode==2 && near(t.player.max_dist,1.4,0.0001);
}
verse_player_constrain :: (p:Player,x:f32,z:f32)->Player #export_c {
 next:=p;dx:=x-p.pos.x;dz:=z-p.pos.z;
 if dx!=0 {next.pos.x=x;next.prev_pos.x=x;next.target.x+=dx;next.prev_target.x+=dx;next.vel.x=0;}
 if dz!=0 {next.pos.z=z;next.prev_pos.z=z;next.target.z+=dz;next.prev_target.z+=dz;next.vel.z=0;}
 return next;
}

// ---- floors (verse/stand.coax): a roof's slopes, a tower's cone

// A gable roof 8 m across x and 10 m along z, its ridge along z at x 0: eaves `eave` up, the ridge 3 m over them.
gable :: (f: [] f32, eave: f32) {
  stand_put_quad(f, 0, -4, -5, 4, 0, 0, 10, eave, 3, 0);
  stand_put_quad(f, 1, 4, -5, -4, 0, 0, 10, eave, 3, 0);
}

#test "coming down onto a roof you land on its slope and stand there, at the eave and at the ridge" {
  f: [2 * STAND_FLOATS] f32;
  gable(f[..], 4);
  w: World;
  w.floors = f[..];
  p := verse_player_place(-3.5, 12, 0, 0);
  for i: 0..<120 { p = step(w, p, STEP); }
  #assert p.on_ground && near(p.pos.y, 4 + 3 * 0.5 / 4, 0.01) && !p.sliding;
  q := verse_player_place(0, 12, 1, 0);
  for i: 0..<120 { q = step(w, q, STEP); }
  #assert q.on_ground && near(q.pos.y, 7, 0.01);
  // and you jump off it as off the ground
  q = verse_player_input(q, 0, 0, 0, 0, false, true, 0, 0);
  #assert !q.on_ground && q.vel.y == f32(JUMP);
  // under it (inside, on the ground) it is no floor
  r := verse_player_place(-1, 0, 0, 0);
  for i: 0..<20 { r = step(w, r, STEP); }
  #assert r.on_ground && r.pos.y == 0;
}

#test "walking along a roof follows its slope, and off its end you fall to the ground" {
  f: [2 * STAND_FLOATS] f32;
  gable(f[..], 4);
  w: World;
  w.floors = f[..];
  p := verse_player_place(-2, 5.5, -4, 0);   // facing +z, along the ridge
  for i: 0..<20 { p = step(w, p, STEP); }
  #assert p.on_ground && near(p.pos.y, 5.5, 0.01);
  p = held(p, 0, 1, false);
  fell := false; low := 100.0f32;
  for i: 0..<400 {
    p = step(w, p, STEP);
    if p.pos.z < 4.9 { #assert near(p.pos.y, 5.5, 0.05) && p.on_ground; }
    if p.pos.z > 5.3 && !p.on_ground { fell = true; }
    low = lo(low, p.pos.y);
  }
  #assert fell && p.pos.y == 0 && low == 0;
  // across it: up its slope to the ridge, down the other side, off the far eave
  q := verse_player_place(-3.8, 4.2, 0, f32(PI) / 2);
  for i: 0..<20 { q = step(w, q, STEP); }
  q = held(q, 0, 1, false);
  top := 0.0f32;
  for i: 0..<300 { q = step(w, q, STEP); top = hi(top, q.pos.y); }
  #assert top > 6.8 && q.pos.x > 4.5 && q.pos.y == 0;
}

#test "a slope too steep to stand on slides you off its low edge" {
  f: [STAND_FLOATS] f32;
  stand_put_cone(f[..], 0, 0, 0, 2, 3, 4);
  w: World;
  w.floors = f[..];
  p := verse_player_place(0.5, 9, 0, 0);
  slid := false;
  for i: 0..<400 {
    p = step(w, p, STEP);
    if p.sliding { slid = true; #assert !p.on_ground && p.pos.y > 2.9; }
  }
  #assert slid && p.pos.x > 2 && p.pos.y == 0 && p.on_ground;
  // and while sliding you can't jump
  q := verse_player_place(0.5, 9, 0, 0);
  for i: 0..<60 { q = step(w, q, STEP); if q.sliding { break; } }
  #assert q.sliding;
  q = verse_player_input(q, 0, 0, 0, 0, false, true, 0, 0);
  #assert q.vel.y <= 0;
}

#test "walking into a low roof's edge from the side stops you; one under a step you walk onto" {
  f: [2 * STAND_FLOATS] f32;
  gable(f[..], 1);
  w: World;
  w.floors = f[..];
  p := held(verse_player_place(-6, 0, 0, f32(PI) / 2), 0, 1, false);
  for i: 0..<200 { p = step(w, p, STEP); }
  #assert p.pos.x < -3.9 && p.pos.x > -4.5 && p.pos.y == 0;
  gable(f[..], 0.3);
  q := held(verse_player_place(-6, 0, 0, f32(PI) / 2), 0, 1, false);
  for i: 0..<120 { q = step(w, q, STEP); }
  #assert q.pos.x > -3 && q.pos.y > 0.5;
}
