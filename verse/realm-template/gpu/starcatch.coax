// Star Catcher's shaders (the realm template, verse/SKILL.md): copied to
// apps/openagents-web/gpu/<module>.coax, build.sh writes apps/openagents-web/<module>.wgsl from it
// with coax/web/wgsl-module.coax (<module>.module and <module>.bindings beside it). Shaders are
// Coax (verse/gpu/shader.coax, wgsl.coax); no WGSL is written by hand.
#load "../../../verse/gpu/wgsl.coax";

// Star Catcher (starcatch.coax): bg_fs draws a night sky (a gradient, a few
// twinkling far stars, a moon) over a dark hill; a red flush when a star
// lands. fx_vs/fx_fs draw the strokes catch_frame writes (capsules).
// StarcatchU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0
//   time 2
//   fade 3
//   info 4
// the ground's top (device px), the flash, 0, 0
starcatch_hash :: (p:V2)->f32 {
  return fract(sin(wg_dot2(p,v2(127.1f32,311.7f32)))*43758.5453f32);
}
starcatch_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}
starcatch_bg_fs :: (pos:V4,u:[]f32)->V4 {
  p:V2=v2(pos.x,pos.y);
  t:f32=p.y/u[1];
  c:V3=wg_mix_f3f3f(v3(0.02f32,0.03f32,0.09f32),v3(0.10f32,0.12f32,0.28f32),t);
  // far stars on a grid of cells, each twinkling
  cell:f32=34.0f32*fmax(u[0]/1440.0f32,0.6f32);
  g:V2=wg_floor_f2(wg_div_f2f(p,cell));
  h:f32=starcatch_hash(g);
  if (h>0.82f32) {
    at:V2=wg_mul_f2f(wg_add_f2f2(g,v2(starcatch_hash(wg_add_f2f(g,3.1f32)),starcatch_hash(wg_add_f2f(g,7.7f32)))),cell);
    d:f32=wg_length2(wg_sub_f2f2(p,at));
    tw:f32=0.6f32+(0.4f32*sin((u[2]*(1.0f32+(3.0f32*h)))+(h*40.0f32)));
    c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(0.8f32,0.85f32,1.0f32),exp(((-d)*d)/3.0f32)),tw));
  }
  // the moon, upper left of centre
  m:V2=v2(u[0]*0.3f32,u[1]*0.2f32);
  mr:f32=fmin(u[0],u[1])*0.06f32;
  md:f32=wg_length2(wg_sub_f2f2(p,m));
  c=wg_mix_f3f3f(c,v3(0.92f32,0.92f32,0.85f32),1.0f32-smoothstep(mr-1.0f32,mr+1.0f32,md));
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(v3(0.25f32,0.25f32,0.3f32),exp((-fmax(md-mr,0.0f32))/(mr*1.5f32))),0.4f32));
  // the hill
  ground:f32=u[4]+((sin((p.x/u[0])*6.0f32)*u[1])*0.012f32);
  if (p.y>ground) {
    e:f32=(p.y-ground)/fmax(u[1]-ground,1.0f32);
    c=wg_mix_f3f3f(v3(0.06f32,0.13f32,0.08f32),v3(0.02f32,0.05f32,0.03f32),e);
  }
  // a star landed: the edges flush red
  if (u[5]>0.0f32) {
    q:V2=wg_mul_f2f(wg_sub_f2f(wg_div_f2f2(p,wg_at2(u,0)),0.5f32),2.0f32);
    c=wg_mix_f3f3f(c,v3(0.55f32,0.05f32,0.04f32),(smoothstep(0.6f32,1.4f32,wg_length2(q))*u[5])*0.6f32);
  }
  return v4(c.x,c.y,c.z,1.0f32);
}
StarcatchV :: struct {pos:V4; place:V2; shape:V4; tint:V4; bar:V4; }
starcatch_fx_vs_in :: struct {a:V4; b:V4; c:V4; d:V4; }
starcatch_fx_vs :: (_vid2:u32,_iid3:u32,in_:starcatch_fx_vs_in,u:[]f32)->StarcatchV {
  a:V4=in_.a;
  b:V4=in_.b;
  c:V4=in_.c;
  d:V4=in_.d;
  o:StarcatchV;
  o.pos=v4(((a.x/u[0])*2.0f32)-1.0f32,1.0f32-((a.y/u[1])*2.0f32),0.0f32,1.0f32);
  o.place=v2(a.z,a.w);
  o.shape=b;
  o.tint=c;
  o.bar=d;
  return o;
}
// A capsule: shape.x its length, y its core's half width, z its light, w its glow's reach.
starcatch_fx_fs :: (v:StarcatchV,u:[]f32)->V4 {
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=wg_length2(v2(along,v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
  g:f32=d/fmax(v.shape.w,1.0f32);
  halo:f32=exp(((-5.0f32)*g)*g)*0.28f32;
  return wg_make_f4_f3f(wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(v.tint.x,v.tint.y,v.tint.z),(core+halo)),v.shape.z),u[3]),1.0f32);
}

// ---- generated by wgsl-coax: the vector helpers this file calls
wg_mix_f3f3f :: (p0:V3,p1:V3,p2:f32)->V3 {return v3(mix(p0.x,p1.x,p2),mix(p0.y,p1.y,p2),mix(p0.z,p1.z,p2));}
wg_div_f2f :: (a:V2,b:f32)->V2 {return v2(a.x/b,a.y/b);}
wg_floor_f2 :: (p0:V2)->V2 {return v2(floor(p0.x),floor(p0.y));}
wg_add_f2f :: (a:V2,b:f32)->V2 {return v2(a.x+b,a.y+b);}
wg_add_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x+b.x,a.y+b.y);}
wg_mul_f2f :: (a:V2,b:f32)->V2 {return v2(a.x*b,a.y*b);}
wg_sub_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x-b.x,a.y-b.y);}
wg_mul_f3f :: (a:V3,b:f32)->V3 {return v3(a.x*b,a.y*b,a.z*b);}
wg_add_f3f3 :: (a:V3,b:V3)->V3 {return v3(a.x+b.x,a.y+b.y,a.z+b.z);}
wg_div_f2f2 :: (a:V2,b:V2)->V2 {return v2(a.x/b.x,a.y/b.y);}
wg_sub_f2f :: (a:V2,b:f32)->V2 {return v2(a.x-b,a.y-b);}
wg_make_f4_f3f :: (p0:V3,p1:f32)->V4 {return v4(p0.x,p0.y,p0.z,p1);}
