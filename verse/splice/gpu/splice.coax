// Splice's shaders (splice.coax, docs/verse/art-styles.md, Anime): the same anime scene, ink and
// post pass as Anime Lab, so this file loads Anime Lab's. build.sh writes apps/openagents-web/splice.wgsl
// from it with coax/web/wgsl-module.coax (splice.module, and animelab.bindings, which the two share).
// No WGSL is written by hand.
//
// One pass is Splice's own: the overlay (fx_fs). Anime Lab's overlay is light on dark (its blend
// keeps the brighter colour). Splice's interface is ink on cream paper, so its overlay writes
// straight alpha and the page asks the host for source-over blending (coaxial_fx_alpha_v1):
// a stroke is a solid shape with no glow, and text takes its ink's colour in one of two faces.
#load "../../../apps/openagents-web/gpu/animelab.coax";
#load "../../../aethyr/render/graybox.coax";

// Graybox (the G key; splice.coax sets a speed below zero): grays, with orange, yellow and cyan kept.
// The meshes are already gray (Pen.graybox); this takes the sky, the tinted light and the interface.
sp_gray_on :: (u:[]f32)->bool {return u[AL_FX+2]<(-0.5f32);}
sp_gray :: (c:V3,warm:f32,cyan:f32)->V3 {
  k:f32=graybox_keep(c.x,c.y,c.z,warm,cyan);
  g:f32=graybox_gray(c.x,c.y,c.z);
  return v3(mix(g,c.x,k),mix(g,c.y,k),mix(g,c.z,k));
}
post_fs :: (pos:V4,u:[]f32,post_light:Tex2D,post_quarter:Tex2D,post_eighth:Tex2D,post_aux:Tex2D,post_depth:TexDepth,post_lin:Sampler)->V4 {
  c:V4=animelab_post_fs(pos,u,post_light,post_quarter,post_eighth,post_aux,post_depth,post_lin);
  if (sp_gray_on(u)) {
    g:V3=sp_gray(v3(c.x,c.y,c.z),0.62f32,0.38f32);
    return v4(g.x,g.y,g.z,1.0f32);
  }
  return c;
}

fx_fs :: (v:AnimelabV,u:[]f32,sans_atlas:Tex2D,sans_sampler:Sampler)->V4 {
  tint:V3=v3(v.tint.x,v.tint.y,v.tint.z);
  if (sp_gray_on(u)) {tint=sp_gray(tint,0.62f32,0.38f32);}
  // text: mode 4 is the reading face (IBM Plex Mono, the atlas's red), mode 5 the title face
  // (Michroma, its green); the page declares both (realms.json ui_font_src, ui_title_font_src)
  if ((v.tint.w>3.5f32)&&(v.tint.w<5.5f32)) {
    lod:f32=st_sat(wg_log2(64.0f32/fmax(v.shape.x,1.0f32))/4.0f32)*4.0f32;
    g:V4=gpu_sample_level(sans_atlas,sans_sampler,v.place,lod);
    face:f32=ifx v.tint.w>4.5f32 then g.y else g.x;
    return v4(tint.x,tint.y,tint.z,pow(face,0.85f32)*fmin(v.shape.z*1.15f32,1.0f32));
  }
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=sqrt((along*along)+(v.place.y*v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
  return v4(tint.x,tint.y,tint.z,core*fmin(v.shape.z,1.0f32));
}
