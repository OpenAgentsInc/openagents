// Splice's fixture layer (GitHub #13404): a piece beside every kept-clear zone that has open
// ground beside it, as the typed edits that place them. The checks play the whole run and walk the
// whole way with it in (walk-checks.coax), and a developer's page loads it to see placed pieces in
// the world: http://127.0.0.1:8800/worlds/splice?layer=fixture (splice.coax; the dev server only).
//
// One row a piece: the kept-clear zone it stands beside (its content ID), the piece (its content
// ID), where it stands in centimetres, and its turn in degrees. The boss chamber has no row: rock
// and the boss wall are all that is beside it.
SL_FIXTURE_N :: 28;
SL_FIXTURE :: [SL_FIXTURE_N * 5] int.[
  1, 113, 17700, -7800, 0,        // the village start: a palm
  2, 113, 17720, -7060, 0,        // the scanner gate
  3, 113, 16490, 10000, 0,        // the rail track
  4, 110, 19000, 9650, 30,        // the Battery: a turbine on the dune past the rail marker
  5, 113, 210, 960, 0,            // the mine start
  6, 117, 280, 150, 0,            // the rover's door: a small crate
  7, 113, 320, 760, 0,            // the checkpoint post
  8, 113, -820, -1620, 0,         // the drill arm
  9, 113, 820, -1520, 0,          // the treads
  10, 117, 800, -2150, 20,        // the MOVE card
  11, 113, -260, -1850, 0,        // the DRILL card
  12, 113, -230, -600, 0,         // the mine mouth's lane
  13, 113, -220, -2200, 0,        // the scrap room's lane
  14, 113, 360, -4090, 0,         // the rubble and the tunnel
  15, 113, -1380, -4520, 0,       // the bar's door
  16, 112, -2620, -4350, 120,     // battery cell 1: a raider at the bar
  17, 113, -2330, -4900, 0,       // the workshop's door
  18, 117, -2160, -5820, 45,      // battery cell 2
  19, 113, -2980, -5530, 0,       // the vault's door
  20, 118, -3800, -5780, -140,    // the DRILL+ part: a banned bot standing guard
  21, 117, -950, -5900, 0,        // the stash crate's side
  22, 113, 730, -5620, 0,         // the south ramp
  23, 113, 1030, -5100, 0,        // the catwalk
  24, 113, 730, -4580, 0,         // the north ramp
  25, 113, 1770, -4890, 0,        // the lounge's door
  26, 103, 2330, -4900, -60,      // battery cell 3: a crab-bot in the lounge
  27, 113, 230, -5700, 0,         // the drill line
  28, 117, 300, -6020, 0];        // the boss wall
// Places the fixture's pieces, each through the check: how many stand, or minus the row the check
// refused, less one.
sl_fixture :: (g: [] SpGame) -> int {
  for i: 0..<SL_FIXTURE_N {
    o := i * 5;
    if !sl_place(g, SL_FIXTURE[o + 1], SL_FIXTURE[o + 2], SL_FIXTURE[o + 3], SL_FIXTURE[o + 4]).ok { return -i - 1; }
  }
  return SL_FIXTURE_N;
}
