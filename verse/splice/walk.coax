// Splice's walk replay (GitHub #13404; docs/audits/2026-11-12-chat-and-world-building.md, slice 0):
// the second check of an edit layer, made when it is saved. A walker goes the run's whole way on
// foot, from the dome village to the banned bot, against the proposed layer: every place the run
// needs is stood in, every door is gone through, and the machines' own ways (the rover's rail, the
// Digger's lane to the rubble and the boss wall) are clear. A layer the walk stops in is refused,
// with the place it could not reach.
//
// Nothing here is a second walker. The way round things is the engine's steering service
// (metaverse-engine/ai/steer.coax: a window of cells filled by where a body may stand, searched and pulled
// taut), the step is the game's own (g_walk: the smuggler's speed, turned by its yaw, pushed out
// by the World's colliders), and "may a body stand here" is the game's own collision. The room's
// protocol bots speak a room's wire, and Splice has no room; the agent driver's walk-to
// (metaverse-engine/agent/drive.coax) goes straight at its target, so it would refuse a layer for a crate
// a player walks round.
//   coax/bin/coax test verse/splice/splice-game.coax
#load "../../metaverse-engine/ai/steer.coax";

SW_OK :: 0;
SW_START :: 1;     // a place the run starts you in is taken
SW_WAY :: 2;       // the walker could not reach a place the run needs
SW_LANE :: 3;      // the rover's rail or the Digger's lane has something standing in it
SW_GATE :: 4;      // something stands in the rubble or the boss wall
// mark: the landmark the walk was after (its content ID), or 0 for a lane or a gate.
SwVerdict :: struct { why: int; mark: int; leg: int; }

SW_DT :: 0.02f32;         // s: the walk's step, as the game's checks step it
SW_ARRIVE :: 0.8f32;      // m: standing here is standing at the place
SW_STUCK :: 6.0f32;       // s: a walker no nearer its place in this long is stuck
SW_LANE_R :: 0.9f32;      // m: half the Digger's width
// The route's legs.
SWL_STAGE :: 0;    // the run's next part begins: a = the game's stage (g_stage)
SWL_START :: 1;    // you are put at landmark a, which must be free
SWL_WALK :: 2;     // walk to landmark a, to within b centimetres
SWL_RAIL :: 3;     // the rover rides the rail's whole length
SWL_LANE :: 4;     // the Digger drives its lane: a = 0 to the rubble, 1 to the boss wall
SWL_GATE :: 5;     // nothing stands in it, and it opens: a = 0 the rubble, 1 the boss wall
SWL_WEAK :: 6;     // walk to the banned bot's weak point a, to within b centimetres
SW_LEGS :: 46;
SW_ROUTE :: [SW_LEGS * 3] int.[
  SWL_STAGE, 1, 0,   SWL_START, 15, 0,  SWL_WALK, 13, 50,  SWL_RAIL, 0, 0,
  SWL_STAGE, 4, 0,   SWL_START, 18, 0,  SWL_WALK, 23, 80,  SWL_WALK, 18, 80,
  SWL_STAGE, 5, 0,   SWL_START, 4, 0,   SWL_WALK, 21, 80,  SWL_WALK, 22, 80,  SWL_WALK, 24, 80,  SWL_WALK, 25, 80,  SWL_WALK, 61, 80,  SWL_WALK, 2, 80,
  SWL_LANE, 0, 0,    SWL_GATE, 0, 0,
  SWL_WALK, 62, 80,  SWL_WALK, 63, 80,  SWL_WALK, 64, 60,  SWL_WALK, 27, 80,  SWL_WALK, 65, 60,  SWL_WALK, 28, 80,  SWL_WALK, 66, 60,  SWL_WALK, 26, 80,
  SWL_WALK, 66, 60,  SWL_WALK, 65, 60,  SWL_WALK, 64, 60,  SWL_WALK, 67, 80,  SWL_WALK, 68, 80,  SWL_WALK, 69, 80,  SWL_WALK, 71, 60,  SWL_WALK, 29, 80,
  SWL_WALK, 71, 60,  SWL_WALK, 69, 80,  SWL_WALK, 70, 80,  SWL_WALK, 63, 80,
  SWL_LANE, 1, 0,    SWL_GATE, 1, 0,
  SWL_WALK, 6, 80,   SWL_WALK, 72, 80,  SWL_WEAK, 0, 150,  SWL_WEAK, 1, 150,  SWL_WEAK, 2, 150,  SWL_WALK, 72, 80];

// Whether a body may stand at (x, z): the game's own collision leaves it there.
sw_free :: (g: [] SpGame, x: f32, z: f32) -> bool {
  px := g[0].px; pz := g[0].pz;
  g[0].px = x; g[0].pz = z; g_collide(g);
  moved := dist2(g[0].px, g[0].pz, x, z);
  g[0].px = px; g[0].pz = pz;
  return moved < 0.02;
}
SwWalker :: struct { a: [1] NavAgent; w: [1] NavWindow; }
// Walk from where the smuggler stands to within `arrive` of (tx, tz): false when it is stuck, or
// not there in the time the straight way takes three times over, and eight seconds.
sw_walk :: (g: [] SpGame, k: [] SwWalker, tx: f32, tz: f32, arrive: f32) -> bool {
  t := NavTune.{speed = T_WALK, home_speed = T_WALK, body = T_RADIUS, reach = 0.25, lead = 0, leash = 1000000, replan = 0.4, span = 14, cell = 0.5};
  k[0].a[0] = nav_agent(g[0].px, g[0].pz, 1);
  steps := cast(int) ((8 + 3 * dist2(g[0].px, g[0].pz, tx, tz) / T_WALK) / SW_DT);
  none: [3] f32;
  best := dist2(g[0].px, g[0].pz, tx, tz); best_i := 0;
  for i: 0..<steps {
    d := dist2(g[0].px, g[0].pz, tx, tz);
    if d <= arrive { g[0].fwd = false; return true; }
    // stuck: no nearer by 0.3 m in SW_STUCK seconds (the agent driver's rule, with room to go round a wall)
    if d < best - 0.3 { best = d; best_i = i; }
    if cast(f32) (i - best_i) * SW_DT > SW_STUCK { break; }
    if nav_think(k[0].a[..], t, tx, tz, SW_DT) {
      if nav_wants_window(k[0].a[0]) {
        nav_window_place(k[0].w[..], t, k[0].a[0]);
        for c: 0..<nav_window_cells(k[0].w[..]) { p := nav_window_spot(k[0].w[..], c); k[0].w[0].walk[c] = sw_free(g, p[0], p[1]); }
        nav_plan(k[0].a[..], t, k[0].w[..]);
      } else {
        // the look ahead: a metre toward the goal
        if d > 0.01 && !sw_free(g, g[0].px + (tx - g[0].px) / d * lo(d, 1), g[0].pz + (tz - g[0].pz) / d * lo(d, 1)) { k[0].a[0].pressed = true; }
        else { nav_direct(k[0].a[..], t); }
      }
    }
    s := nav_move(k[0].a[..], t, false, SW_DT, none[0..<0], -1);
    dx := s.x - g[0].px; dz := s.z - g[0].pz;
    g[0].fwd = dx * dx + dz * dz > 0.000001;
    if g[0].fwd { g[0].yaw = atan2(dx, dz); }
    g_walk(g, SW_DT);
    nav_moved(k[0].a[..], s, g[0].px, g[0].pz);
  }
  g[0].fwd = false;
  return false;
}
// Whether a placed piece stands in the box round (cx, cz).
sw_in_box :: (g: [] SpGame, cx: f32, cz: f32, ex: f32, ez: f32) -> bool {
  for i: 0..<g[0].layer[0].st[0].n {
    item := g[0].layer[0].items[i];
    row := sc_piece(g[0].c[..], item.mesh);
    if row < 0 { continue; }
    e := sl_foot(g, row, item.x, item.z, item.yaw);
    if sl_seg_box(e, cx, cz, ex, ez) < e.r { return true; }
  }
  return false;
}
// The walk, on the game as it stands with its layer: the game is staged and stepped, so play one
// kept for this. `from`, `upto`: the legs to walk (0 and SW_LEGS: the whole way; a part of it is
// for a check that knows where to look, and starts at a SWL_STAGE leg).
sw_replay_legs :: (g: [] SpGame, k: [] SwWalker, from: int, upto: int) -> SwVerdict {
  c := g[0].c[..];
  for leg: from..<upto {
    what := SW_ROUTE[leg * 3]; a := SW_ROUTE[leg * 3 + 1]; b := cast(f32) SW_ROUTE[leg * 3 + 2] / 100;
    if what == SWL_STAGE {
      g_stage(g, a);
      if a == 5 { g[0].rubble_gone = false; g[0].wall_gone = false; }
    }
    if what == SWL_START {
      m := sc_mark(c, a);
      if !sw_free(g, m.x, m.z) { return SwVerdict.{why = SW_START, mark = a, leg = leg}; }
      g[0].px = m.x; g[0].pz = m.z;
    }
    if what == SWL_WALK {
      m := sc_mark(c, a);
      if m.id != a || !sw_walk(g, k, m.x, m.z, b) { return SwVerdict.{why = SW_WAY, mark = a, leg = leg}; }
    }
    if what == SWL_WEAK {
      p := weak_at(g, a);
      if !sw_walk(g, k, p.x, p.z, b) { return SwVerdict.{why = SW_WAY, mark = LM_BOSS, leg = leg}; }
    }
    if what == SWL_RAIL {
      for i: 0..<cast(int) T_RAIL + 1 {
        s := cast(f32) i; at := rail_at(g, s);
        if sl_touch(g, sl_seg_of(at.x, at.z, rail_yaw(g, s), SH_ALONG_Z, 1.5, 0.9), SK_PIECE, false, false, -1) >= 0 { return SwVerdict.{why = SW_LANE, leg = leg}; }
      }
    }
    if what == SWL_LANE {
      face := ifx a == 1 then g[0].at.wall_z + 1 else g[0].at.rubble_z + 1;
      z1 := ifx a == 1 then face + T_MOVE_SHORT + T_MOVE_MAX else 7.0f32; z0 := face + T_MOVE_SHORT;
      n := cast(int) ((z1 - z0) / 0.5) + 1;
      for i: 0..<n + 1 {
        z := lo(z1, z0 + cast(f32) i * 0.5);
        if sl_touch(g, SlSeg.{ax = 0, az = z, bx = 0, bz = z, r = SW_LANE_R}, SK_PIECE, false, false, -1) >= 0 { return SwVerdict.{why = SW_LANE, leg = leg}; }
      }
    }
    if what == SWL_GATE {
      if a == 0 {
        if sw_in_box(g, 0, g[0].at.rubble_z, 3, 1) { return SwVerdict.{why = SW_GATE, mark = LM_RUBBLE, leg = leg}; }
        g[0].rubble_gone = true;
      } else {
        if sw_in_box(g, 0, g[0].at.wall_z, 4, 1) { return SwVerdict.{why = SW_GATE, mark = LM_WALL, leg = leg}; }
        g[0].wall_gone = true;
      }
    }
  }
  return SwVerdict.{};
}
sw_replay :: (g: [] SpGame, k: [] SwWalker) -> SwVerdict { return sw_replay_legs(g, k, 0, SW_LEGS); }
// A refusal in words, into out.
sw_why :: (g: [] SpGame, v: SwVerdict, out: [] u8) -> string {
  n := 0; c := g[0].c[..];
  name := sc_mark_name(c, sc_mark_row(c, v.mark));
  if v.why == SW_OK { n = ct_put(out, n, "ok"); }
  if v.why == SW_START { n = ct_put(out, n, "the run starts you at '"); n = ct_put(out, n, name); n = ct_put(out, n, "', and something stands there"); }
  if v.why == SW_WAY { n = ct_put(out, n, "the run can't be walked: the way to '"); n = ct_put(out, n, name); n = ct_put(out, n, "' is blocked"); }
  if v.why == SW_LANE { n = ct_put(out, n, ifx SW_ROUTE[v.leg * 3] == SWL_RAIL then "something stands on the rail line" else "something stands in the Digger's lane"); }
  if v.why == SW_GATE { n = ct_put(out, n, "something stands in '"); n = ct_put(out, n, name); n = ct_put(out, n, "', which the Digger opens"); }
  return ifx n > out.count then "" else cast(string) out[0..<n];
}
