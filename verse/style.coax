}
#test "value noise stays in 0..1, is smooth, and repeats exactly at a lattice point" {
 for i:0..<200 {x:=cast(f32)i*0.173f32-11.0f32; y:=cast(f32)i*0.311f32+4.0f32;
  n:=verse_style_noise(x,y);
  #assert n>=0.0f32 && n<=1.0f32;
  #assert abs(verse_style_noise(x+0.001f32,y)-n)<0.02f32;
  h:=verse_style_hash(x,y); #assert h>=0.0f32 && h<1.0f32;}
 #assert verse_style_noise(3.0f32,5.0f32)==verse_style_hash(3.0f32,5.0f32);
}
#test "clouds: two octaves (one on a phone), cut at 0.48 to 0.62, none at cover 0" {
 #assert verse_style_cloud_field(100.0f32,40.0f32,1.0f32/2000.0f32,1.0f32/700.0f32,1.0f32)==verse_style_noise(0.05f32,0.02f32);
 two:=verse_style_cloud_field(100.0f32,40.0f32,1.0f32/2000.0f32,1.0f32/700.0f32,2.0f32);
 #assert abs(two-(verse_style_noise(0.05f32,0.02f32)*0.65f32+verse_style_noise(100.0f32/700.0f32+3.1f32,40.0f32/700.0f32+7.7f32)*0.35f32))<0.00001f32;
 #assert verse_style_cloud_cover(0.48f32,0.35f32,0.48f32,0.62f32)==0.0f32;
 #assert verse_style_cloud_cover(0.62f32,0.35f32,0.48f32,0.62f32)==1.0f32;
 #assert abs(verse_style_cloud_cover(0.55f32,0.35f32,0.48f32,0.62f32)-0.5f32)<0.0001f32;
 #assert verse_style_cloud_cover(0.9f32,0.0f32,0.48f32,0.62f32)==0.0f32;
 #assert verse_style_cloud_cover(0.5f32,0.6f32,0.48f32,0.62f32)>verse_style_cloud_cover(0.5f32,0.35f32,0.48f32,0.62f32);
 #assert verse_style_cloud_lit(0.6f32,0.6f32)==0.55f32 && verse_style_cloud_lit(0.4f32,0.6f32)==0.0f32 && verse_style_cloud_lit(0.8f32,0.6f32)==1.0f32;
 #assert verse_style_cloud_fade(0.005f32)==0.0f32 && verse_style_cloud_fade(0.2f32)==0.92f32;
}
#test "bloom starts 0.25 under 0.85 with a soft knee and takes all of the excess past it" {
 #assert verse_style_bloom_share(0.5f32,0.85f32,0.25f32)==0.0f32;
 #assert verse_style_bloom_share(0.60f32,0.85f32,0.25f32)==0.0f32;
 #assert verse_style_bloom_share(0.0f32,0.85f32,0.25f32)==0.0f32;
 // at the threshold the knee gives k/4 of light: 0.0625 of 0.85
 #assert abs(verse_style_bloom_share(0.85f32,0.85f32,0.25f32)-0.0625f32/0.85f32)<0.0001f32;
 // past threshold + knee, just the excess
 #assert abs(verse_style_bloom_share(2.0f32,0.85f32,0.25f32)-1.15f32/2.0f32)<0.0001f32;
 // continuous and never stepping back across the knee
 for i:0..<200 {a:=0.55f32+cast(f32)i*0.004f32;
  #assert verse_style_bloom_share(a+0.004f32,0.85f32,0.25f32)*(a+0.004f32)>=verse_style_bloom_share(a,0.85f32,0.25f32)*a;
  #assert abs(verse_style_bloom_share(a+0.004f32,0.85f32,0.25f32)*(a+0.004f32)-verse_style_bloom_share(a,0.85f32,0.25f32)*a)<0.01f32;}
 #assert abs(verse_style_bloom_mix(0.5f32,1.0f32,0.30f32)-0.80f32)<0.0001f32;
 #assert abs(verse_style_bloom_mix(0.5f32,1.0f32,0.22f32)-0.72f32)<0.0001f32;
}
#test "the tone keeps black, approaches white, and lifts blacks 0.035" {
 #assert verse_style_tone(0.0f32,1.6f32)==0.0f32;
 #assert verse_style_tone(20.0f32,1.6f32)>0.999f32;
 #assert verse_style_tone(0.3f32,2.4f32)>verse_style_tone(0.3f32,1.6f32);
 #assert abs(verse_style_lift(0.0f32,0.035f32)-0.035f32)<0.00001f32;
 #assert abs(verse_style_lift(1.0f32,0.035f32)-1.0f32)<0.00001f32;
 #assert abs(verse_style_saturation(0.6f32,0.5f32,1.10f32)-0.61f32)<0.0001f32;
 #assert verse_style_saturation(0.0f32,0.5f32,3.0f32)==0.0f32;
 #assert abs(verse_style_luma(1.0f32,1.0f32,1.0f32)-1.0f32)<0.0001f32;
}

#test "light shafts: the sky's glow toward the light, 24 taps decaying 0.94, at most the preset's weight" {
 #assert verse_style_shaft_source(1.0f32)==1.0f32;
 #assert abs(verse_style_shaft_source(cos(13.8f32*0.0174533f32))-0.5f32)<0.01f32;
 #assert verse_style_shaft_source(cos(25.5f32*0.0174533f32))<0.1f32 && verse_style_shaft_source(-1.0f32)<0.0001f32;
 #assert verse_style_shaft_tap(0.0f32,0.94f32)==1.0f32 && abs(verse_style_shaft_tap(23.0f32,0.94f32)-0.2405f32)<0.001f32;
 // the 24 desktop taps' weights, and a phone's 12, summed
 s:=0.0f32; for i:0..<24 {s=s+verse_style_shaft_tap(cast(f32)i,0.94f32);}
 #assert abs(verse_style_shaft_total(24.0f32,0.94f32)-s)<0.001f32;
 s=0.0f32; for i:0..<12 {s=s+verse_style_shaft_tap(cast(f32)i,0.94f32);}
 #assert abs(verse_style_shaft_total(12.0f32,0.94f32)-s)<0.001f32;
 #assert verse_style_shaft_total(5.0f32,1.0f32)==5.0f32;
 // every tap in the light's full glow: the preset's weight, 0.44 by day and 0.20 at night; none in shadow
 t:=verse_style_shaft_total(24.0f32,0.94f32);
 #assert abs(verse_style_shaft(t,t,0.44f32,1.0f32)-0.44f32)<0.0001f32 && abs(verse_style_shaft(t,t,0.20f32,1.0f32)-0.20f32)<0.0001f32;
 #assert verse_style_shaft(0.0f32,t,0.22f32,1.0f32)==0.0f32;
}
#test "shafts show while the light is in the frame and fade out over 0.35 of it past the edge" {
 #assert verse_style_shaft_fade(0.5f32,0.5f32,0.35f32)==1.0f32 && verse_style_shaft_fade(0.0f32,1.0f32,0.35f32)==1.0f32;
 #assert abs(verse_style_shaft_fade(1.175f32,0.5f32,0.35f32)-0.5f32)<0.0001f32;
 #assert verse_style_shaft_fade(0.5f32,-0.35f32,0.35f32)==0.0f32 && verse_style_shaft_fade(-3.0f32,0.5f32,0.35f32)==0.0f32;
 for i:0..<50 {o:=cast(f32)i*0.01f32; #assert verse_style_shaft_fade(1.0f32+o+0.01f32,0.5f32,0.35f32)<=verse_style_shaft_fade(1.0f32+o,0.5f32,0.35f32);}
}
#test "wind: 0.30 rad, a 12 m wave at 3 m/s with a gust, the base still and the tip bent with height squared" {
 // the wave alone (no gust): its crest 3 m along at t 0, there again 4 s later 12 m on
 #assert abs(verse_style_wind(3.0f32,0.0f32,0.0f32,0.30f32,12.0f32,3.0f32)-0.18f32)<0.0001f32;
 #assert abs(verse_style_wind(15.0f32,0.0f32,4.0f32,0.30f32,12.0f32,3.0f32)-0.18f32)<0.001f32;
 #assert abs(verse_style_wind(3.0f32,0.0f32,1.0f32,0.30f32,12.0f32,3.0f32)-0.0f32)<0.001f32;
 // never past A
 for i:0..<100 {g:=cast(f32)i*0.02f32-1.0f32; #assert abs(verse_style_wind(cast(f32)i*0.37f32,g,1.3f32,0.30f32,12.0f32,3.0f32))<=0.30001f32;}
 // the gust stays in -1..1 and moves with the wave
 for i:0..<100 {x:=cast(f32)i*0.9f32; g:=verse_style_gust(x,2.0f32,0.5f32,0.8f32,0.6f32,3.0f32,0.04f32); #assert g>=-1.0f32 && g<=1.0f32;}
 #assert abs(verse_style_gust(10.0f32,5.0f32,0.0f32,0.8f32,0.6f32,3.0f32,0.04f32)-verse_style_gust(10.0f32+2.4f32,5.0f32+1.8f32,1.0f32,0.8f32,0.6f32,3.0f32,0.04f32))<0.0001f32;
 #assert verse_style_bend(0.3f32,0.5f32,0.0f32)==0.0f32;
 #assert abs(verse_style_bend(0.3f32,0.5f32,1.0f32)-sin(0.3f32)*0.5f32)<0.00001f32;
 #assert abs(verse_style_bend(0.3f32,0.5f32,0.5f32)-sin(0.3f32)*0.5f32*0.25f32)<0.00001f32;
 // the normal tilts toward the light by up to 20 degrees at the full bend, away when bent back
 #assert abs(verse_style_grass_tilt(0.30f32,0.30f32,0.349066f32)-0.349066f32)<0.0001f32;
 #assert abs(verse_style_grass_tilt(-0.15f32,0.30f32,0.349066f32)+0.174533f32)<0.0001f32;
 #assert verse_style_grass_tilt(0.9f32,0.30f32,0.349066f32)==0.349066f32;
}
#test "blades: 0.35 to 0.60 m, 24 a square metre to 32 m (8 to 18 on a phone), shrinking over the last 6 m" {
 #assert verse_style_blade_height(0.0f32,0.35f32,0.60f32)==0.35f32 && verse_style_blade_height(1.0f32,0.35f32,0.60f32)==0.60f32;
 #assert verse_style_grass_fade(10.0f32,32.0f32,6.0f32)==1.0f32 && verse_style_grass_fade(26.0f32,32.0f32,6.0f32)==1.0f32;
 #assert abs(verse_style_grass_fade(29.0f32,32.0f32,6.0f32)-0.5f32)<0.0001f32 && verse_style_grass_fade(32.0f32,32.0f32,6.0f32)==0.0f32;
 #assert verse_style_grass_fade(12.0f32,18.0f32,6.0f32)==1.0f32 && verse_style_grass_fade(18.0f32,18.0f32,6.0f32)==0.0f32;
 #assert verse_style_grass_blades(32.0f32,24.0f32)==49152.0f32 && verse_style_grass_blades(18.0f32,8.0f32)==5184.0f32;
}
#test "no blade on a masked path; all of them 0.25 m clear; movers part them within 0.7 m" {
 #assert verse_style_grass_clear(-0.5f32)==0.0f32 && verse_style_grass_clear(0.0f32)==0.0f32 && verse_style_grass_clear(0.25f32)==1.0f32;
 #assert abs(verse_style_segment(0.0f32,3.0f32,-2.0f32,0.0f32,2.0f32,0.0f32)-3.0f32)<0.0001f32;
 #assert abs(verse_style_segment(5.0f32,0.0f32,-2.0f32,0.0f32,2.0f32,0.0f32)-3.0f32)<0.0001f32;
 #assert verse_style_part(0.0f32,0.7f32)==1.0f32 && verse_style_part(0.7f32,0.7f32)==0.0f32 && abs(verse_style_part(0.35f32,0.7f32)-0.5f32)<0.0001f32;
}
#test "a blade's tip is 15% lighter and warmer, and its hue jitters 4% at most" {
 #assert abs(verse_style_tip(0.4f32,1.0f32,0.15f32)-0.46f32)<0.0001f32 && verse_style_tip(0.1f32,2.0f32,0.15f32)==0.1f32;
 #assert verse_style_tip(0.3f32,0.0f32,0.15f32)/0.3f32>verse_style_tip(0.4f32,1.0f32,0.15f32)/0.4f32;
 #assert abs(verse_style_jitter(0.5f32,0.0f32,1.0f32,0.04f32)-0.52f32)<0.0001f32 && abs(verse_style_jitter(0.5f32,2.0f32,1.0f32,0.04f32)-0.48f32)<0.0001f32;
 #assert verse_style_jitter(0.5f32,1.0f32,0.3f32,0.04f32)==0.5f32 && verse_style_jitter(0.5f32,0.0f32,0.5f32,0.04f32)==0.5f32;
}
#test "canopies: normals 0.85 to the blob, an ellipsoid for a pine, 0.05 m of sway at the top, 0.36 open" {
 // a sphere's blob direction is p - c over the radius squared; an ellipsoid's leans to its short axes
 #assert abs(verse_style_canopy_axis(3.0f32,1.0f32,2.0f32)-0.5f32)<0.00001f32;
 #assert verse_style_canopy_axis(1.0f32,0.0f32,1.0f32)>verse_style_canopy_axis(1.0f32,0.0f32,3.0f32);
 #assert abs(verse_style_canopy_normal(0.0f32,1.0f32,0.85f32)-0.85f32)<0.00001f32 && verse_style_canopy_normal(0.4f32,0.4f32,0.85f32)==0.4f32;
 #assert verse_style_canopy_sway(0.3f32,0.3f32,0.05f32,0.0f32)==0.0f32;
 #assert abs(verse_style_canopy_sway(0.3f32,0.3f32,0.05f32,1.0f32)-0.05f32)<0.00001f32;
 #assert abs(verse_style_canopy_sway(-0.15f32,0.3f32,0.05f32,0.5f32)+0.0125f32)<0.00001f32;
 #assert verse_style_canopy_sway(0.9f32,0.3f32,0.05f32,2.0f32)==0.05f32;
 #assert verse_style_canopy_open(0.1f32,0.3f32)==1.0f32 && verse_style_canopy_open(0.3f32,0.3f32)==0.0f32 && verse_style_canopy_open(0.5f32,0.0f32)==0.0f32;
}
