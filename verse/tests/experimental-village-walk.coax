// Integration checks for the same Metaverse Engine walker used by Everglade Experimental.
#load "../../aethyr/move/walk.coax" as walk;
#load "../experimental-village.coax" as village;
#load "../experimental-dungeon.coax" as dungeon;

village_walk :: (p0:walk.Player,forward:f32)->walk.Player {
 p:=walk.walk_input(p0,0,forward,0,0,false,false,0,0);p.cam.theta=0;
 near:[1]village.EvNear;_:=village.ev_player_near(near[..],p.body.pos.x,p.body.pos.y,p.body.pos.z);
 none:[1]f32;return walk.walk_advance_in_realm(p,1.0f32/60,none[0..<0],near[0].walls[0..<near[0].wall_n*6],near[0].floors[0..<near[0].floor_n*10],"everglade");
}
#test "village walker is stopped by an interior obstruction" #steps 200000000 {
 p:=walk.walk_place(-18,0,-21,0);for i:0..<90 {p=village_walk(p,1);}
 #assert p.body.pos.z> -23 && p.body.pos.z< -20.8;
}
#test "village walker climbs the authored interior stairs" #steps 200000000 {
 p:=walk.walk_place(-50,0,21.4,0);for i:0..<100 {p=village_walk(p,-1);}
 #assert p.body.pos.z>24 && p.body.pos.y>1;
}
#test "village walker can pass through a ground-floor doorway" #steps 200000000 {
 p:=walk.walk_place(-48,0,30.0,0);for i:0..<75 {p=village_walk(p,1);}
 #assert p.body.pos.z<27.5;
}
#test "village walker lands on an upper floor" #steps 200000000 {
 p:=walk.walk_place(-46,4.5,25,0);p.body.on_ground=false;
 for i:0..<120 {p=village_walk(p,0);}
 #assert p.body.on_ground && p.body.pos.y>2.8 && p.body.pos.y<3.3;
}
#test "watchmaker workshop doorway and stairs are walkable" #steps 200000000 {
 p:=walk.walk_place(17,0,0,0);for i:0..<75 {p=village_walk(p,1);}#assert p.body.pos.z< -2.5;
 p=walk.walk_place(15,0, -8.6,0);for i:0..<100 {p=village_walk(p,-1);}#assert p.body.pos.z> -6 && p.body.pos.y>1;
}
#test "new village house doorway and walls work with the walker" #steps 200000000 {
 p:=walk.walk_place(47,0,46.5,0);for i:0..<60 {p=village_walk(p,1);}#assert p.body.pos.z<44.3 && p.body.pos.z>41;
 p=walk.walk_place(49,0,46.5,0);for i:0..<60 {p=village_walk(p,1);}#assert p.body.pos.z>45;
}
#test "dungeon entrance admits the walker and its walls stop them" #steps 200000000 {
 p:=walk.walk_place(-30.5,0,-42,0);for i:0..<60 {p=village_walk(p,1);}#assert p.body.pos.z< -44.6 && p.body.pos.z> -51.5;
 p=walk.walk_place(-35,0,-42,0);for i:0..<60 {p=village_walk(p,1);}#assert p.body.pos.z> -44;
 p=walk.walk_place(-36,0,-60,0);for i:0..<60 {p=village_walk(p,1);}#assert p.body.pos.z> -63.45 && p.body.pos.z< -62;
}
// Steps toward (tx, tz) at a run.
dungeon_walk :: (p0:walk.Player,tx:f32,tz:f32)->walk.Player {
 dx:=tx-p0.body.pos.x;dz:=tz-p0.body.pos.z;d:=sqrt(dx*dx+dz*dz);if d<0.001 {d=1;}
 p:=walk.walk_input(p0,dx/d,-dz/d,0,0,false,false,0,0);p.cam.theta=0;
 near:[1]village.EvNear;_:=village.ev_player_near(near[..],p.body.pos.x,p.body.pos.y,p.body.pos.z);
 none:[1]f32;return walk.walk_advance_in_realm(p,1.0f32/60,none[0..<0],near[0].walls[0..<near[0].wall_n*6],near[0].floors[0..<near[0].floor_n*10],"everglade");
}
#test "the walker crosses the dungeon from its entrance to the boss's hall" #steps 4000000000 {
 // in at the entrance, through the hall, the west passage, the barracks, the passage south and the
 // antechamber, to the boss's hall at the far end (experimental-dungeon.coax DG_MAP)
 route:=[13][2]f32.[[2]f32.[-30.5,-46],[2]f32.[-40.5,-60],[2]f32.[-40.5,-66],[2]f32.[-40.5,-86],[2]f32.[-32.5,-90],[2]f32.[-32.5,-101],
  [2]f32.[-30.5,-104],[2]f32.[-30.5,-124],[2]f32.[-27,-126],[2]f32.[-17,-126.5],[2]f32.[-15.5,-131],[2]f32.[-15.5,-136],[2]f32.[-20.5,-141]];
 p:=walk.walk_place(-30.5,0,-38,0);k:=0;stuck:=0;
 for i:0..<3600 {if k>=route.count {break;}t:=route[k];x:=p.body.pos.x;z:=p.body.pos.z;p=dungeon_walk(p,t[0],t[1]);
  dx:=t[0]-p.body.pos.x;dz:=t[1]-p.body.pos.z;if dx*dx+dz*dz<0.36 {k+=1;}
  moved:=abs(p.body.pos.x-x)+abs(p.body.pos.z-z);if moved<0.002 {stuck+=1;}}
 #assert k==route.count && stuck<20;
 #assert dungeon.dg_at(dungeon.dg_col(p.body.pos.x),dungeon.dg_row(p.body.pos.z))=='N' && abs(p.body.pos.y)<0.2;
}
#test "the dungeon's walls stop the walker where they stand" #steps 400000000 {
 // the barracks' north wall (z -84, its face at -84.55) between the west passage's door and the corner
 p:=walk.walk_place(-46,0,-88,0);for i:0..<90 {p=dungeon_walk(p,-46,-80);}#assert p.body.pos.z< -84.55 && p.body.pos.z> -85.2;
 // a doorway's arch post narrows it: you pass its middle, not its post
 p=walk.walk_place(-40.5+1.9,0,-62,0);for i:0..<90 {p=dungeon_walk(p,-40.5+1.9,-68);}#assert p.body.pos.z> -63.4;
 p=walk.walk_place(-40.5,0,-62,0);for i:0..<90 {p=dungeon_walk(p,-40.5,-68);}#assert p.body.pos.z< -66;
}

#test "village walker cannot walk through dining furniture" #steps 200000000 {
 p:=walk.walk_place(-18.2,0,27.0,0);for i:0..<80 {p=village_walk(p,1);}
 #assert p.body.pos.z>25.8;
}
#test "display-row anvil stops the player" #steps 200000000 {
 p:=walk.walk_place(-77,0,-73,0);for i:0..<80 {p=village_walk(p,1);}
 #assert p.body.pos.z> -74.8 && p.body.pos.z< -73.2;
}
#test "castle courtyard gateway admits the player and stone walls stop them" #steps 200000000 {
 p:=walk.walk_place(34,0,-16,0);for i:0..<100 {p=village_walk(p,1);}#assert p.body.pos.z< -20.5;
 p=walk.walk_place(28,0,-16,0);for i:0..<100 {p=village_walk(p,1);}#assert p.body.pos.z> -20;
 p=walk.walk_place(28,0,-48,0);for i:0..<100 {p=village_walk(p,1);}#assert p.body.pos.z> -52;
}
#test "castle internal arch connects the southern courtyard" #steps 200000000 {
 p:=walk.walk_place(34,0,-48,0);for i:0..<100 {p=village_walk(p,1);}#assert p.body.pos.z< -52.5 && p.body.pos.z> -74;
}
#test "walking through a real bush slows without stopping" #steps 200000000 {
 normal:=walk.walk_place(-74,0,58,0);slow:=normal;touched:=false;
 for i:0..<80 {normal.body.pace=1;normal=village_walk(normal,1);slow.body.pace=village.ev_bush_pace(slow.body.pos.x,slow.body.pos.y,slow.body.pos.z);if slow.body.pace<1 {touched=true;}slow=village_walk(slow,1);}
 #assert touched;#assert slow.body.pos.z<55;#assert normal.body.pos.z+0.05<slow.body.pos.z;
 #assert village.ev_bush_pace(slow.body.pos.x,slow.body.pos.y,slow.body.pos.z)==1;
}
#test "walker escapes the crowded display objects at the reported position" #steps 200000000 {
 p:=walk.walk_place(5,0,32.7,0);for i:0..<45 {p=village_walk(p,-1);}before:=p.body.pos.z;
 for i:0..<90 {p=village_walk(p,1);}#assert p.body.pos.z<before-0.8;
}
#test "walker escapes between large opposing objects while a wall remains solid" #steps 200000000 {
 near:[1]village.EvNear;near[0].wall_n=3;near[0].scene_begin=0;near[0].scene_end=2;
 b:=[18]f32.[-10,0,-2,-0.2,2,2,0.2,0,-2,10,2,2,-20,0,-5,20,3,-4];for i:0..<18 {near[0].walls[i]=b[i];}
 r:=village.ev_release_trap(near[..],0,0,0);#assert r==1 && near[0].wall_n==1;
 p:=walk.walk_place(0,0,0,0);none:[1]f32;for i:0..<100 {p=walk.walk_input(p,0,1,0,0,false,false,0,0);p.cam.theta=0;p=walk.walk_advance_in_realm(p,1.0f32/60,none[0..<0],near[0].walls[0..<near[0].wall_n*6],none[0..<0],"everglade");}
 #assert p.body.pos.z< -2 && p.body.pos.z> -4;
}
