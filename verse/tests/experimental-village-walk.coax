// Integration checks for the same Aethyr walker used by Everglade Experimental.
#load "../../aethyr/walk.coax" as walk;
#load "../experimental-village.coax" as village;

village_walk :: (p0:walk.Player,forward:f32)->walk.Player {
 p:=walk.walk_input(p0,0,forward,0,0,false,false,0,0);p.theta=0;
 near:[1]village.EvNear;village.ev_near(near[..],p.pos.x,p.pos.z);
 none:[1]f32;return walk.walk_advance_in_realm(p,1.0f32/60,none[0..<0],near[0].walls[0..<near[0].wall_n*6],near[0].floors[0..<near[0].floor_n*10],"everglade");
}
#test "village walker is stopped by an interior obstruction" #steps 200000000 {
 p:=walk.walk_place(-18,0,-21,0);for i:0..<90 {p=village_walk(p,1);}
 #assert p.pos.z> -23 && p.pos.z< -20.8;
}
#test "village walker climbs the authored interior stairs" #steps 200000000 {
 p:=walk.walk_place(-50,0,21.4,0);for i:0..<100 {p=village_walk(p,-1);}
 #assert p.pos.z>24 && p.pos.y>1;
}
#test "village walker can pass through a ground-floor doorway" #steps 200000000 {
 p:=walk.walk_place(-48,0,30.0,0);for i:0..<75 {p=village_walk(p,1);}
 #assert p.pos.z<27.5;
}
#test "village walker lands on an upper floor" #steps 200000000 {
 p:=walk.walk_place(-46,4.5,25,0);p.on_ground=false;
 for i:0..<120 {p=village_walk(p,0);}
 #assert p.on_ground && p.pos.y>2.8 && p.pos.y<3.3;
}
#test "watchmaker workshop doorway and stairs are walkable" #steps 200000000 {
 p:=walk.walk_place(17,0,0,0);for i:0..<75 {p=village_walk(p,1);}#assert p.pos.z< -2.5;
 p=walk.walk_place(15,0, -8.6,0);for i:0..<100 {p=village_walk(p,-1);}#assert p.pos.z> -6 && p.pos.y>1;
}
#test "new village house doorway and walls work with the walker" #steps 200000000 {
 p:=walk.walk_place(47,0,46.5,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z<44.3 && p.pos.z>41;
 p=walk.walk_place(49,0,46.5,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z>45;
}
#test "dungeon entrance admits the walker and its walls stop them" #steps 200000000 {
 p:=walk.walk_place(-32,0,-42,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z< -44.2 && p.pos.z> -51.5;
 p=walk.walk_place(-32,0,-47,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z< -50.2 && p.pos.z> -58;
 p=walk.walk_place(-36,0,-55,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z< -58.2 && p.pos.z> -64;
 p=walk.walk_place(-35,0,-42,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z> -44;
 p=walk.walk_place(-35,0,-47,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z> -50;
 p=walk.walk_place(-39,0,-55,0);for i:0..<60 {p=village_walk(p,1);}#assert p.pos.z> -58;
}

#test "village walker cannot walk through dining furniture" #steps 200000000 {
 p:=walk.walk_place(-18.2,0,27.0,0);for i:0..<80 {p=village_walk(p,1);}
 #assert p.pos.z>25.8;
}
#test "display-row anvil stops the player" #steps 200000000 {
 p:=walk.walk_place(-77,0,-73,0);for i:0..<80 {p=village_walk(p,1);}
 #assert p.pos.z> -74.8 && p.pos.z< -73.2;
}
#test "castle courtyard gateway admits the player and stone walls stop them" #steps 200000000 {
 p:=walk.walk_place(34,0,-16,0);for i:0..<100 {p=village_walk(p,1);}#assert p.pos.z< -20.5;
 p=walk.walk_place(28,0,-16,0);for i:0..<100 {p=village_walk(p,1);}#assert p.pos.z> -20;
 p=walk.walk_place(28,0,-48,0);for i:0..<100 {p=village_walk(p,1);}#assert p.pos.z> -52;
}
#test "castle internal arch connects the southern courtyard" #steps 200000000 {
 p:=walk.walk_place(34,0,-48,0);for i:0..<100 {p=village_walk(p,1);}#assert p.pos.z< -52.5 && p.pos.z> -74;
}
#test "walking through a real bush slows without stopping" #steps 200000000 {
 normal:=walk.walk_place(-74,0,58,0);slow:=normal;touched:=false;
 for i:0..<80 {normal.pace=1;normal=village_walk(normal,1);slow.pace=village.ev_bush_pace(slow.pos.x,slow.pos.y,slow.pos.z);if slow.pace<1 {touched=true;}slow=village_walk(slow,1);}
 #assert touched;#assert slow.pos.z<55;#assert normal.pos.z+0.05<slow.pos.z;
 #assert village.ev_bush_pace(slow.pos.x,slow.pos.y,slow.pos.z)==1;
}
