// Compile the registered Nature meshes and Coax glade composition into the existing
// Character Create people pack. Product scene arithmetic is verse/character-glade.coax.
// tool.sh: release
// tool.sh: stack-gib 8
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../humans/ph_pack.coax";
#load "../humans/ph_face.coax";
#load "../humans/ph_outfits.coax";

#load "../../character-glade.coax";

#test "glade static vertices retain positions beyond the people quantization box" {
 b:[32]u8;gp_vertex(b[..],0,[3]f32.[-18,6,-24],[3]f32.[0,1,0],[2]f32.[0,1],[3]f32.[1,0.5,0.1],3,4);
 #assert gl_u32(b[..],0)==int(f32_bits(-18)) && gl_u32(b[..],8)==int(f32_bits(-24));
 #assert gl_u32(b[..],24)==3 && (gl_u32(b[..],12)>>24)==4;
}
GP_VERTS :: 360000;
Gp :: struct {v:[GP_VERTS*32]u8;i:[GP_VERTS*12]u8;nv:int;ni:int;layers:int;nt:int;tex:[64]string;encoded:[64]string;txt:[1]Txt;old:[33554432]u8;oldn:int;out:[67108864]u8;}
gp_word :: (b:[]u8,at:int,v:u32) {for k:0..<4 {b[at+k]=cast,trunc(u8)(v>>cast(u32)(k*8));}}
gp_clamp :: (x:f32,a:f32,b:f32)->f32 {return ifx x<a then a else ifx x>b then b else x;}
gp_byte :: (v:f32)->u32 {return cast(u32)int(gp_clamp(v*255+0.5,0,255));}
gp_vertex :: (b:[]u8,at:int,p:[3]f32,n:[3]f32,uv:[2]f32,c:[3]f32,layer:int,kind:int) {
 for k:0..<3 {gp_word(b,at+k*4,f32_bits(p[k]));}
 normal:u32=cast(u32)kind<<24;for k:0..<3 {q:=int(gp_clamp(n[k]*127,-127,127));normal=normal|((cast,trunc(u32)q&255)<<cast(u32)(k*8));}gp_word(b,at+12,normal);
 gp_word(b,at+16,cast(u32)int(gp_clamp(uv[0]*65535,0,65535))|(cast(u32)int(gp_clamp(uv[1]*65535,0,65535))<<16));
 gp_word(b,at+20,gp_byte(c[0])|(gp_byte(c[1])<<8)|(gp_byte(c[2])<<16)|0xff000000);
 gp_word(b,at+24,cast(u32)layer);gp_word(b,at+28,0);
}
gp_v :: (w:[]Gp,p:[3]f32,n:[3]f32,uv:[2]f32,c:[3]f32,layer:int,kind:int)->int {
 if w[0].nv>=GP_VERTS {ph_die("glade vertices exceed bounded store");}id:=w[0].nv;gp_vertex(w[0].v[..],id*32,p,n,uv,c,layer,kind);w[0].nv+=1;return id;
}
gp_tri :: (w:[]Gp,a:int,b:int,c:int) {if (w[0].ni+3)*4>w[0].i.count {ph_die("glade indices overflow");}for q:[3]int.[a,b,c] {put_u32(w[0].i[..],w[0].ni*4,q);w[0].ni+=1;}}
gp_texture :: (w:[]Gp,path:string,iw:[]ImgWork)->int {
 for i:0..<w[0].nt {if w[0].tex[i]==path {return w[0].layers+i;}}
 i:=w[0].nt;if i>=64 {ph_die("glade texture limit");}w[0].tex[i]=txt_keep(w[0].txt[..],path);bytes:=layer_bytes(path,512,false,iw);w[0].encoded[i]=txt_keep(w[0].txt[..],cast(string)bytes);w[0].nt+=1;return w[0].layers+i;
}
gp_mesh :: (w:[]Gp,g:[]Gltf,iw:[]ImgWork,root:string,name:string,x:f32,z:f32,scale:f32,yaw:f32,tint:[3]f32) {
 path:=txt_cat3(w[0].txt[..],root,"/glTF/",txt_cat(w[0].txt[..],name,".gltf"));gl_load(g,path);
 cs:=cos(yaw);sn:=sin(yaw);y:=cg_height(x,z);
 for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {
  pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;uv:[131072]f64;idx:[262144]f64;
  nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;r:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);r=gl_acc(g,gl_int(g,attr,"TEXCOORD_0",0),uv[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;
  mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));mn:=gl_str(g,mat,"name");kind:=ifx starts(mn,"Bark") then 6 else ifx has(mn,"Leaves") then 1 else ifx has(mn,"Flower") then 3 else ifx has(mn,"Rocks") then 4 else ifx has(mn,"Mushroom") then 7 else 0;
  tex:=gl_get(g,gl_get(g,mat,"pbrMetallicRoughness"),"baseColorTexture");im:=gl_at(g,GA_IMG,gl_int(g,gl_at(g,GA_TEX,gl_int(g,tex,"index",0)),"source",0));image:=txt_cat3(w[0].txt[..],root,"/glTF/",gl_str(g,im,"uri"));layer:=gp_texture(w,image,iw);
  first:=w[0].nv;
  for v:0..<nv {a:=f32(pos[v*3])*scale;b:=f32(pos[v*3+1])*scale;c:=f32(pos[v*3+2])*scale;nx:=f32(nor[v*3]);ny:=f32(nor[v*3+1]);nz:=f32(nor[v*3+2]);
   colour:=ifx kind==1 then tint else ifx kind==4 then [3]f32.[0.70,0.75,0.55] else ifx kind==3 then [3]f32.[1,0.36,0.40] else ifx kind==7 then (ifx f32(pos[v*3+1])>0.23 then [3]f32.[1,0.62,0.12] else [3]f32.[0.90,0.86,0.70]) else [3]f32.[1,1,1];
   id:=gp_v(w,[3]f32.[x+a*cs+c*sn,y+b,z-a*sn+c*cs],[3]f32.[nx*cs+nz*sn,ny,-nx*sn+nz*cs],[2]f32.[f32(uv[v*2]),f32(uv[v*2+1])],colour,layer,kind);
  }
  for t:0..<ni/3 {gp_tri(w,first+int(idx[t*3]),first+int(idx[t*3+1]),first+int(idx[t*3+2]));}
 }}
}
gp_ground :: (w:[]Gp,white:int) {
 // A continuous hillside with a bare, winding ochre path and a level foreground clearing.
 side:=101;for iz:0..<side {z:=5-f32(iz)*0.65;for ix:0..<side {x:=(f32(ix)-50)*0.65;y:=cg_height(x,z)-0.035;
  dx:=(cg_height(x+0.1,z)-cg_height(x-0.1,z))/0.2;dz:=(cg_height(x,z+0.1)-cg_height(x,z-0.1))/0.2;normal_length:=sqrt(dx*dx+1+dz*dz);
  path:=cg_path(x,z);noise:=cg_hash(x,z);autumn:=gp_clamp((x+z*0.1-1)/18,0,1);c:=[3]f32.[0.33+autumn*0.20,0.59-autumn*0.05,0.05];
  dirt:=[3]f32.[0.61+noise*0.07,0.52+noise*0.06,0.21];for k:0..<3 {c[k]=c[k]*(1-path)+dirt[k]*path;}
  id:=gp_v(w,[3]f32.[x,y,z],[3]f32.[-dx/normal_length,1/normal_length,-dz/normal_length],[2]f32.[0.5,0.5],c,white,5);
 }}for iz:0..<side-1 {for ix:0..<side-1 {a:=iz*side+ix;gp_tri(w,a,a+1,a+side);gp_tri(w,a+1,a+side+1,a+side);}}
 // Thousands of actual blades leave the path open. Stable hashes make captures reproducible.
 for i:0..<17500 {fi:=f32(i);x:=(cg_hash(fi,2)-0.5)*(ifx i<13000 then 20.0f32 else 54.0f32);z:=3-cg_hash(fi,5)*(ifx i<13000 then 22.0f32 else 55.0f32);
  if cg_path(x,z)>0.40 || (x*x+z*z)<1.25 {continue;}y:=cg_height(x,z);h:=0.12+0.30*cg_hash(fi,8);wide:=0.025+0.035*cg_hash(fi,7);angle:=cg_hash(fi,9)*6.283;dx:=cos(angle)*wide;dz:=sin(angle)*wide;autumn:=gp_clamp((x+z*0.1-1)/16,0,1);top:=[3]f32.[0.40+0.40*autumn,0.78-0.20*autumn,0.02];base:=[3]f32.[0.16+0.24*autumn,0.35,0.01];
  a:=gp_v(w,[3]f32.[x-dx,y,z-dz],[3]f32.[0,1,0],[2]f32.[0,0],base,white,2);b:=gp_v(w,[3]f32.[x+dx,y,z+dz],[3]f32.[0,1,0],[2]f32.[1,0],base,white,2);c:=gp_v(w,[3]f32.[x+dx*2,y+h,z+dz*2],[3]f32.[0,1,0],[2]f32.[0.5,1],top,white,2);gp_tri(w,a,b,c);
 }
}
gp_entry :: (out:[]u8,row:int,kind:int,license:int,name:string,offset:int,size:int) {
 out[row]=cast(u8)kind;out[row+1]=cast(u8)license;put_u32(out,row+4,offset);put_u32(out,row+8,size);for i:0..<name.count {if i<31 {out[row+16+i]=name[i];}}
}
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])!=3 {tool_errln("glade pack: SOURCE_ROOT BASE.pack OUTPUT.pack");return 2;}
 w:[1]Gp;g:[1]Gltf;iw:[1]ImgWork;root:=args_at(args[..],0);w[0].oldn=fs_read(args_at(args[..],1),w[0].old[..]);if w[0].oldn<32 {return 1;}
 old:=w[0].old[..];ne:=gl_u32(old,4);table:=gl_u32(old,16);vo:=0;vn:=0;io:=0;in:=0;cat:="";
 for i:0..<ne {r:=table+i*48;kind:=int(old[r]);off:=gl_u32(old,r+4);size:=gl_u32(old,r+8);if kind==1 {cat=cast(string)old[off..<off+size];}if kind==2 {vo=off;vn=size;}if kind==3 {io=off;in=size;}if kind==4 {w[0].layers+=1;}}
 // A plain existing white texel layer is added once and shared by terrain/blades.
 whitebuf:=[1]u8.[255];img:=pi_img(whitebuf[..],1,1,1);encoded:[65536]u8;work:[65536]u8;zwork:[1]PiZ;n:=pi_png(img,zwork[..],work[..],encoded[..]);if n<0 {return 1;}w[0].tex[0]="glade-white";w[0].encoded[0]=txt_keep(w[0].txt[..],cast(string)encoded[0..<n]);w[0].nt=1;
 gp_ground(w[..],w[0].layers);
 for i:0..<CG_ITEMS {item:=cg_item(i);stem:=ifx item.kind==0 then "CommonTree_" else ifx item.kind==1 then "Birch_" else "Rock_Big_";nb:[64]u8;s:[1]Sb;s[0]=sb(nb[..]);sb_put(s[..],stem);sb_int(s[..],ifx item.kind==2 then item.variant+1 else item.variant+1);gp_mesh(w[..],g[..],iw[..],root,sb_text(s[..]),item.x,item.z,item.scale,item.yaw,item.tint);}
 for i:0..<70 {fi:=f32(i);x:=(cg_hash(fi,24)-0.5)*24;z:=-1-cg_hash(fi,25)*24;if cg_path(x,z)>0.55 {continue;}stem:=ifx i%4==0 then "Bush_Common_Flowers" else ifx i%4==1 then "Fern_1" else ifx i%4==2 then "Mushroom_Common" else "Flower_1_Group";gp_mesh(w[..],g[..],iw[..],root,stem,x,z,0.35+cg_hash(fi,30)*0.45,fi,[3]f32.[0.35,0.78,0.055]);}
 for i:0..<8 {pos:=[8][2]f32.[[2]f32.[-2.6,-3],[2]f32.[-2.4,-5],[2]f32.[1.4,-2],[2]f32.[1.65,-2.2],[2]f32.[1.9,-2],[2]f32.[2.1,-3],[2]f32.[-1.5,-1],[2]f32.[-2.0,-1.5]];stem:=ifx i==0 then "Fern_1" else ifx i==1 then "Bush_Common_Flowers" else ifx i<6 then "Mushroom_Common" else "Flower_1_Group";size:f32=ifx i==0 then 0.22 else ifx i==1 then 0.70 else ifx i<6 then 0.75 else 0.45;gp_mesh(w[..],g[..],iw[..],root,stem,pos[i][0],pos[i][1],size,f32(i),[3]f32.[0.36,0.80,0.08]);}
 cb:[262144]u8;c:[1]Sb;c[0]=sb(cb[..]);lines_at:=0;while lines_at<cat.count {e:=lines_at;while e<cat.count && cat[e]!='\n' {e+=1;}line:=cat[lines_at..<e];lines_at=e+1;if starts(line,"bytes ") {sb_put(c[..],"bytes 0000000000\n");}else {sb_put(c[..],line);sb_byte(c[..],'\n');}}sb_put(c[..],"\nL 250 Quaternius Stylized Nature MegaKit Source|CC0 1.0 Universal|https://quaternius.com/\nC glade/environment ");sb_int(c[..],in/4);sb_byte(c[..],' ');sb_int(c[..],w[0].ni);sb_put(c[..]," 250 ");sb_int(c[..],vn/4);sb_byte(c[..],' ');sb_int(c[..],w[0].nv);sb_put(c[..]," 0\n");
 for i:0..<w[0].nt {sb_put(c[..],"T ");sb_int(c[..],w[0].layers+i);sb_put(c[..]," glade/");sb_int(c[..],i);sb_put(c[..]," 250\n");}
 count:=ne+w[0].nt;at:=32+count*48;gp_word(w[0].out[..],0,0x314b5056);put_u32(w[0].out[..],4,count);put_u32(w[0].out[..],12,33554432);put_u32(w[0].out[..],16,32);put_u32(w[0].out[..],20,at);
 for i:0..<ne {r:=table+i*48;kind:=int(old[r]);off:=gl_u32(old,r+4);size:=gl_u32(old,r+8);start:=at;
  if kind==1 {body:=sb_text(c[..]);for ch:body {w[0].out[at]=ch;at+=1;}}
  else {for k:0..<size {w[0].out[at]=old[off+k];at+=1;}if kind==2 {for k:0..<w[0].nv*32 {w[0].out[at]=w[0].v[k];at+=1;}}if kind==3 {for k:0..<w[0].ni*4 {w[0].out[at]=w[0].i[k];at+=1;}}}
  for k:0..<48 {w[0].out[32+i*48+k]=old[r+k];}put_u32(w[0].out[..],32+i*48+4,start);put_u32(w[0].out[..],32+i*48+8,at-start);at=((at+3)/4)*4;
 }
 for i:0..<w[0].nt {start:=at;for ch:w[0].encoded[i] {w[0].out[at]=ch;at+=1;}nameb:[64]u8;s:[1]Sb;s[0]=sb(nameb[..]);sb_put(s[..],"layer");sb_int(s[..],w[0].layers+i);gp_entry(w[0].out[..],32+(ne+i)*48,4,250,sb_text(s[..]),start,at-start);at=((at+3)/4)*4;}
 // Patch the fixed-width catalog size without changing any payload offsets.
 cat_start:=gl_u32(w[0].out[..],36);cat_size:=gl_u32(w[0].out[..],40);for k:cat_start..<cat_start+cat_size-16 {if cast(string)w[0].out[k..<k+6]=="bytes " {value:=at;for j:0..<10 {w[0].out[k+15-j]=cast(u8)(48+value%10);value/=10;}break;}}
 put_u32(w[0].out[..],8,at);if at>33554432 {ph_die("glade pack exceeds 32 MiB");}if !fs_write(args_at(args[..],2),cast(string)w[0].out[0..<at]) {return 1;}print("Glade: % vertices, % triangles, % textures, % bytes\n",w[0].nv,w[0].ni/3,w[0].nt,at);return 0;
}
