// Compile the registered Nature meshes and Coax glade composition into the existing
// Character Create people pack. Product scene arithmetic is verse/character-glade.coax.
// With a fourth argument, zone, it compiles the glade as Everglade's own region south of the South
// Gate (#13018, verse/everglade/glade-zone.coax) into Everglade's pack: a wider ground that rises
// into hills past the composed glade, no sky of its own (Everglade's) and no stand-in town (the
// real one is up the road), in the VPK2 table its entries need (docs/protocol/asset-pack-v2.md).
//   SRC=$(coax/web/tool.sh verse/tools/assets/registry.coax source nature "$HOME/.openagents/assets" | tail -1)
//   coax/web/tool.sh verse/tools/assets/character_glade_pack.coax "$SRC" \
//     apps/openagents-web/realms/everglade/assets/everglade-avatar.pack apps/openagents-web/realms/everglade/assets/everglade-zone.pack zone
// tool.sh: release
// tool.sh: stack-gib 8
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../humans/ph_pack.coax";
#load "../humans/ph_face.coax";
#load "../humans/ph_outfits.coax";
#load "familiar_pack.coax";

#load "../../character-glade.coax";
#load "../../experimental-terrain.coax" as meadow;
#load "../../experimental-castle.coax" as castle;
#load "../../experimental-dungeon.coax" as dungeon;
#load "../../experimental-props.coax" as props;
#load "../../everglade/glade-zone.coax";

#test "glade static vertices retain positions beyond the people quantization box" {
 b:[32]u8;gp_vertex(b[..],0,[3]f32.[-18,6,-24],[3]f32.[0,1,0],[2]f32.[0,1],[3]f32.[1,0.5,0.1],3,4);
 #assert gl_u32(b[..],0)==int(f32_bits(-18)) && gl_u32(b[..],8)==int(f32_bits(-24));
 #assert gl_u32(b[..],24)==3 && (gl_u32(b[..],12)>>24)==4;
}
#test "glade bark preserves negative repeating source UV coordinates" {
 b:[32]u8;gp_vertex(b[..],0,[3]f32.[0,0,0],[3]f32.[0,1,0],[2]f32.[0.5,-24.3],[3]f32.[1,1,1],0,6);
 uv:=gl_u32(b[..],16);u:=f32(uv&65535)/65535*64-32;v:=f32((uv>>16)&65535)/65535*64-32;
 #assert abs(u-0.5)<0.001 && abs(v+24.3)<0.001;
}
#test "experimental glade expands ground on every side and clears foreground rocks" {
 #assert gp_exp_ground(0,0) && gp_exp_ground(80,80) && gp_exp_ground(-80,-80);
 #assert !gp_exp_ground(91,0) && !gp_exp_ground(0,-91);
 for i:0..<CG_ITEMS {item:=cg_item(i);if item.kind>=2 {#assert !gp_exp_keep(i,item);}}
 #assert gp_exp_keep(7,cg_item(7)) && !gp_exp_keep(4,cg_item(4));
}
#test "experimental grass is deterministic, bounded and extends beyond the old glade" {
 far:=0;near:=0;for group:0..<3 {for i:0..<1000 {a:=gp_exp_grass(i,group);b:=gp_exp_grass(i,group);
  #assert a[0]==b[0] && a[1]==b[1] && gp_exp_ground(a[0],a[1]);
  if abs(a[0])>50 || abs(a[1])>50 {far+=1;}else {near+=1;}
 }}#assert far>400 && near>2000;
}
// The experimental world extends the same meadow to a 180 m square.
gp_exp_ground :: (x:f32,z:f32)->bool {return abs(x)<=90 && abs(z)<=90;}
gp_exp_keep :: (i:int,item:CgItem)->bool {return item.kind<2 && i!=4 && i!=12 && i!=13 && i!=14;}
gp_exp_grass :: (i:int,group:int)->[2]f32 {v:=f32(i+group*100000+400000);span:=ifx i%4==0 then 178.0f32 else 90.0f32;return [2]f32.[(cg_hash(v,2)-0.5)*span,(cg_hash(v,5)-0.5)*span];}
#test "village normals use inverse transpose for scaled source pieces" {
 m:=[12]f32.[2,0,0,0,1,0,0,0,1,0,0,0];n:=gp_village_normal(m,[3]f32.[1,1,0]);
 #assert abs(n[0]-0.4472136)<0.0001 && abs(n[1]-0.8944272)<0.0001 && n[2]==0;
}
#test "village materials map to bounded atlas tiles without inventing source textures" {
 #assert gp_village_tile("MI_Brick")==0 && gp_village_tile("MI_FlatTiles")==1;
 #assert gp_village_tile("MI_WoodTrim_Wear")==9 && gp_village_tile("MI_WindowGlass")==10;
 #assert gp_village_tile("not-a-village-material")== -1;
}
#test "village vine preserves the source linear green factor in display colour" {
 c:=gp_village_tint(8,[4]f64.[0.1023601443,0.348608315,0,1]);
 #assert abs(c[0]-0.353)<0.002 && abs(c[1]-0.625)<0.002 && c[2]==0;
 white:=gp_village_tint(0,[4]f64.[0.1,0.3,0,1]);#assert white[0]==1 && white[1]==1 && white[2]==1;
}
gp_village_tint :: (tile:int,factor:[4]f64)->[3]f32 {
 if tile!=8 {return [3]f32.[1,1,1];}out:[3]f32;for i:0..<3 {x:=f32(factor[i]);out[i]=ifx x<=0.0031308f32 then x*12.92f32 else 1.055f32*pow(x,1.0f32/2.4f32)-0.055f32;}return out;
}
VILLAGE_IMAGES :: [10]string.["T_Brick_BaseColor.png","T_FlatTiles_BaseColor.png","T_MetalOrnaments_BaseColor.png","T_Plaster_BaseColor.png","T_RockTrim_BaseColor.png","T_RoundRocks_BaseColor.png","T_RoundTiles_BaseColor.png","T_UnevenBrick_BaseColor.png","T_VineLeaf_png.png","T_WoodTrim_BaseColor.png"];
gp_village_tile :: (material:string)->int {
 if material=="MI_Brick" {return 0;}if material=="MI_FlatTiles" {return 1;}if material=="MI_MetalOrnaments" {return 2;}
 if material=="MI_Plaster" {return 3;}if material=="MI_RockTrim" {return 4;}if material=="MI_RoundRocks" {return 5;}
 if material=="MI_RoundTiles" {return 6;}if material=="MI_UnevenBrick" {return 7;}if material=="MI_Vine" {return 8;}
 if material=="MI_WoodTrim" || material=="MI_WoodTrim_Wear" {return 9;}if material=="MI_WindowGlass" {return 10;}return -1;
}
#test "scene collider capture encloses placed vertices" {
 b:[64]u8;gp_vertex(b[..],0,[3]f32.[2,1,-3],[3]f32.[0,1,0],[2]f32.[0,0],[3]f32.[1,1,1],0,4);gp_vertex(b[..],32,[3]f32.[3,2,-2],[3]f32.[0,1,0],[2]f32.[0,0],[3]f32.[1,1,1],0,4);
 box:=gp_vertex_bounds(b[..],0,2,false);#assert box[0]<=2000 && box[3]>=3000 && box[2]<= -3000 && box[5]>= -2000;
}
GP_VERTS :: 8000000;
Gp :: struct {colliders:[1024][6]int;collider_n:int;bushes:[128][6]int;bush_n:int;v:[GP_VERTS*32]u8;i:[GP_VERTS*12]u8;nv:int;ni:int;envni:int;zero_first:int;zero_count:int;zero_tex_first:int;zero_tex_end:int;extra_props:bool;showcase_keep:[269]bool;animalfirst:[10]int;animalcount:[10]int;weaponfirst:[4]int;weaponcount:[4]int;dungeonfirst:[8]int;dungeoncount:[8]int;monsterfirst:[48]int;monstercount:[48]int;monsterpartfirst:[48][2]int;monsterpartcount:[48][2]int;monster_anchor:[2][3]f32;animal_anchor:[12][3]f32;grassfirst:[3]int;grasscount:[3]int;seedfirst:[3]int;seedn:[3]int;layers:int;nt:int;tex:[128]string;encoded:[128]string;txt:[1]Txt;old:[33554432]u8;oldn:int;out:[536870912]u8;atlas:[4194304]u8;village_layer:int = -1;bestiary_layer:int = -1;}
// Capture exactly the world-space vertices emitted for one placed asset.
// Tree trunks use their bark geometry so a broad canopy does not become a wall.
gp_vertex_bounds :: (vertices:[]u8,first:int,last:int,bark:bool)->[6]int {
 lo:=[3]f32.[100000,100000,100000];hi:=[3]f32.[-100000,-100000,-100000];n:=0;
 for v:first..<last {if bark && (gl_u32(vertices,v*32+12)>>24)!=6 {continue;}n+=1;for k:0..<3 {x:=f32_from_bits(cast(u32)gl_u32(vertices,v*32+k*4));if x<lo[k] {lo[k]=x;}if x>hi[k] {hi[k]=x;}}}
 if n==0 && bark {return gp_vertex_bounds(vertices,first,last,false);}if n==0 {return [6]int.[0,0,0,0,0,0];}
 box:[6]int;for k:0..<3 {box[k]=int(lo[k]*1000)-1;box[k+3]=int(hi[k]*1000)+1;}return box;
}
#test "display collision closes gaps too narrow for the player" {
 a:=[6]int.[3283,-1,32819,4716,943,33580];b:=[6]int.[5229,-1,32819,6770,1100,33580];
 #assert gp_crowded(a,b);b[0]=5500;#assert !gp_crowded(a,b);b[0]=5229;b[1]=3000;#assert !gp_crowded(a,b);
}
// Join impassable gaps into a single solid footprint: the capsule must never
// be squeezed between two opposing display colliders and refuse every step.
gp_crowded :: (a:[6]int,b:[6]int)->bool {
 if a[4]-a[1]<=550 || b[4]-b[1]<=550 || a[4]<=b[1] || b[4]<=a[1] {return false;}
 minx:=ifx a[0]<b[0] then a[0] else b[0];maxx:=ifx a[3]>b[3] then a[3] else b[3];minz:=ifx a[2]<b[2] then a[2] else b[2];maxz:=ifx a[5]>b[5] then a[5] else b[5];
 if maxx-minx>6000 || maxz-minz>6000 {return false;}
 dx:=ifx a[0]>b[3] then a[0]-b[3] else ifx b[0]>a[3] then b[0]-a[3] else 0;
 dz:=ifx a[2]>b[5] then a[2]-b[5] else ifx b[2]>a[5] then b[2]-a[5] else 0;
 return dx*dx+dz*dz<650*650;
}
gp_merge_display :: (w:[]Gp,start:int) {
 changed:=true;while changed {changed=false;i:=start;while i<w[0].collider_n {j:=i+1;while j<w[0].collider_n {
  a:=w[0].colliders[i];b:=w[0].colliders[j];if !gp_crowded(a,b) {j+=1;continue;}
  for k:0..<3 {if b[k]<a[k] {a[k]=b[k];}if b[k+3]>a[k+3] {a[k+3]=b[k+3];}}w[0].colliders[i]=a;
  for k:j..<w[0].collider_n-1 {w[0].colliders[k]=w[0].colliders[k+1];}w[0].collider_n-=1;changed=true;
 }i+=1;}}
}
gp_capture :: (w:[]Gp,first:int,bark:bool) {
 if first==w[0].nv {return;}if w[0].collider_n>=1024 {ph_die("scene collider capture overflow");}
 w[0].colliders[w[0].collider_n]=gp_vertex_bounds(w[0].v[..],first,w[0].nv,bark);w[0].collider_n+=1;
}
gp_capture_bush :: (w:[]Gp,first:int) {
 if first==w[0].nv {return;}if w[0].bush_n>=128 {ph_die("scene bush capture overflow");}
 w[0].bushes[w[0].bush_n]=gp_vertex_bounds(w[0].v[..],first,w[0].nv,false);w[0].bush_n+=1;
}
gp_write_colliders :: (w:[]Gp,path:string)->bool {
 b:[262144]u8;s:[1]Sb;s[0]=sb(b[..]);sb_put(s[..],"// Generated from the scene pack's placed vertices; millimetres in world space.\nEXPERIMENTAL_SCENE_BOXES :: [");sb_int(s[..],w[0].collider_n);sb_put(s[..],"][6]int.[\n");
 for i:0..<w[0].collider_n {sb_put(s[..]," [6]int.[");for k:0..<6 {if k>0 {sb_byte(s[..],',');}sb_int(s[..],w[0].colliders[i][k]);}sb_put(s[..],"],\n");}sb_put(s[..],"];\nEXPERIMENTAL_BUSH_BOXES :: [");sb_int(s[..],w[0].bush_n);sb_put(s[..],"][6]int.[\n");for i:0..<w[0].bush_n {sb_put(s[..]," [6]int.[");for k:0..<6 {if k>0 {sb_byte(s[..],',');}sb_int(s[..],w[0].bushes[i][k]);}sb_put(s[..],"],\n");}sb_put(s[..],"];\n");return fs_write(path,sb_text(s[..]));
}
gp_word :: (b:[]u8,at:int,v:u32) {for k:0..<4 {b[at+k]=cast,trunc(u8)(v>>cast(u32)(k*8));}}
gp_clamp :: (x:f32,a:f32,b:f32)->f32 {return ifx x<a then a else ifx x>b then b else x;}
gp_byte :: (v:f32)->u32 {return cast(u32)int(gp_clamp(v*255+0.5,0,255));}
gp_vertex :: (b:[]u8,at:int,p:[3]f32,n:[3]f32,uv:[2]f32,c:[3]f32,layer:int,kind:int) {
 for k:0..<3 {gp_word(b,at+k*4,f32_bits(p[k]));}
 normal:u32=cast(u32)kind<<24;for k:0..<3 {q:=int(gp_clamp(n[k]*127,-127,127));normal=normal|((cast,trunc(u32)q&255)<<cast(u32)(k*8));}gp_word(b,at+12,normal);
 u:=ifx kind==6 then (uv[0]+32)/64 else uv[0];v:=ifx kind==6 then (uv[1]+32)/64 else uv[1];
 gp_word(b,at+16,cast(u32)int(gp_clamp(u*65535,0,65535))|(cast(u32)int(gp_clamp(v*65535,0,65535))<<16));
 gp_word(b,at+20,gp_byte(c[0])|(gp_byte(c[1])<<8)|(gp_byte(c[2])<<16)|0xff000000);
 gp_word(b,at+24,cast(u32)layer);gp_word(b,at+28,0);
}
gp_v :: (w:[]Gp,p:[3]f32,n:[3]f32,uv:[2]f32,c:[3]f32,layer:int,kind:int)->int {
 if w[0].nv>=GP_VERTS {ph_die("glade vertices exceed bounded store");}id:=w[0].nv;gp_vertex(w[0].v[..],id*32,p,n,uv,c,layer,kind);w[0].nv+=1;return id;
}
gp_tri :: (w:[]Gp,a:int,b:int,c:int) {if (w[0].ni+3)*4>w[0].i.count {ph_die("glade indices overflow");}for q:[3]int.[a,b,c] {put_u32(w[0].i[..],w[0].ni*4,q);w[0].ni+=1;}}
gp_texture :: (w:[]Gp,path:string,iw:[]ImgWork)->int {
 for i:0..<w[0].nt {if w[0].tex[i]==path {return w[0].layers+i;}}
 i:=w[0].nt;if i>=128 || w[0].layers+i>=128 {ph_die("glade texture limit");}w[0].tex[i]=txt_keep(w[0].txt[..],path);side:=ifx ends(path,"character-glade-sky.png") || ends(path,"/Leaves.png") then 1024 else 512;bytes:=layer_bytes(path,side,false,iw);w[0].encoded[i]=txt_keep(w[0].txt[..],cast(string)bytes);w[0].nt+=1;return w[0].layers+i;
}
// A small 0 A.D. hamlet west of the village, with scenery nearby.
gp_0ad_position :: (i:int)->[2]f32 {
 if i==0 {return [2]f32.[-65,-5];} if i==1 {return [2]f32.[-53,-7];}
 if i==2 {return [2]f32.[-56,-20];} if i==3 {return [2]f32.[-68,15];}
 if i==4 {return [2]f32.[-53,9];} if i==5 {return [2]f32.[-59,3];}
 if i==6 {return [2]f32.[-58,6];} if i==7 {return [2]f32.[-61,2];}
 return [2]f32.[-60,3];
}
gp_0ad_name :: (i:int)->string {
 names:=[9]string.["structures-gauls-house","structures-gauls-market","structures-gauls-scout-tower","structures-britons-fortress","structures-britons-house","geology-highland1-moss","geology-highland2","fungi-medium-agaric","fungi-tall-agaric"];return names[i];
}
// Each glTF was exported from the immutable, uncompressed GLB through Blender's
// SDK with object transforms baked; its images remain separate source textures.
gp_0ad_kind :: ()->int {return 6;}
gp_0ad :: (w:[]Gp,g:[]Gltf,iw:[]ImgWork,root:string) {
 for item:0..<9 {
  name:=gp_0ad_name(item);dir:=txt_cat3(w[0].txt[..],root,"/",name);path:=txt_cat(w[0].txt[..],dir,"/model.gltf");gl_load(g,path);
  p:=gp_0ad_position(item); miny:=100000.0f32;
  for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;for v:0..<nv {y:=f32(pos[v*3+1]);if y<miny {miny=y;}}}}
  first_asset:=w[0].nv;base:=meadow.exp_height(p[0],p[1]);scale:=ifx item>=7 then 3.0f32 else 1.0f32;
  for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {
    pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;uv:[131072]f64;idx:[262144]f64;
    nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;r:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);r=gl_acc(g,gl_int(g,attr,"TEXCOORD_0",0),uv[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;
    mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));tex:=gl_get(g,gl_get(g,mat,"pbrMetallicRoughness"),"baseColorTexture");im:=gl_at(g,GA_IMG,gl_int(g,gl_at(g,GA_TEX,gl_int(g,tex,"index",0)),"source",0));image:=txt_cat3(w[0].txt[..],dir,"/",gl_str(g,im,"uri"));layer:=gp_texture(w,image,iw);first:=w[0].nv;
    for v:0..<nv {id:=gp_v(w,[3]f32.[p[0]+f32(pos[v*3])*scale,base+(f32(pos[v*3+1])-miny)*scale,p[1]+f32(pos[v*3+2])*scale],[3]f32.[f32(nor[v*3]),f32(nor[v*3+1]),f32(nor[v*3+2])],[2]f32.[f32(uv[v*2]),f32(uv[v*2+1])],[3]f32.[1,1,1],layer,gp_0ad_kind());}
    for t:0..<ni/3 {gp_tri(w,first+int(idx[t*3]),first+int(idx[t*3+1]),first+int(idx[t*3+2]));}
  }}
  gp_capture(w,first_asset,false);
 }
}
gp_mesh :: (w:[]Gp,g:[]Gltf,iw:[]ImgWork,root:string,name:string,x:f32,z:f32,scale:f32,yaw:f32,tint:[3]f32) {gp_mesh_lift(w,g,iw,root,name,x,z,scale,yaw,tint,0);}
gp_mesh_lift :: (w:[]Gp,g:[]Gltf,iw:[]ImgWork,root:string,name:string,x:f32,z:f32,scale:f32,yaw:f32,tint:[3]f32,lift:f32) {gp_mesh_scaled(w,g,iw,root,name,x,z,scale,scale,yaw,tint,lift);}
gp_mesh_scaled :: (w:[]Gp,g:[]Gltf,iw:[]ImgWork,root:string,name:string,x:f32,z:f32,scale:f32,vertical:f32,yaw:f32,tint:[3]f32,lift:f32) {
 capture_first:=w[0].nv;path:=txt_cat3(w[0].txt[..],root,"/glTF/",txt_cat(w[0].txt[..],name,".gltf"));gl_load(g,path);
 cs:=cos(yaw);sn:=sin(yaw);y:=cg_height(x,z)+lift;
 for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {
  pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;uv:[131072]f64;idx:[262144]f64;
  nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;r:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);r=gl_acc(g,gl_int(g,attr,"TEXCOORD_0",0),uv[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;
  mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));mn:=gl_str(g,mat,"name");kind:=ifx starts(mn,"Bark") then 6 else ifx has(mn,"Leaves") then 1 else ifx has(mn,"Flower") then 3 else ifx mn=="Grass" then 2 else ifx has(mn,"Rocks") then 4 else ifx has(mn,"Mushroom") then 7 else 0;
  tex:=gl_get(g,gl_get(g,mat,"pbrMetallicRoughness"),"baseColorTexture");im:=gl_at(g,GA_IMG,gl_int(g,gl_at(g,GA_TEX,gl_int(g,tex,"index",0)),"source",0));image:=txt_cat3(w[0].txt[..],root,"/glTF/",gl_str(g,im,"uri"));layer:=gp_texture(w,image,iw);
  // Canopy normals follow its volume instead of each small polygon.
  lo:=[3]f32.[10000,10000,10000];hi:=[3]f32.[-10000,-10000,-10000];
  if kind==1 {for v:0..<nv {for k:0..<3 {q:=f32(pos[v*3+k]);if q<lo[k] {lo[k]=q;}if q>hi[k] {hi[k]=q;}}}}
  lobes:[8][3]f32;tree:=kind==1 && (starts(name,"Birch_") || starts(name,"CommonTree_"));if tree {if nv%4!=0 {ph_die("tree leaf source is not complete four-corner cards");}lobes=cg_crown_centres(pos[..],nv);}
  first:=w[0].nv;
  for v:0..<nv {a:=f32(pos[v*3])*scale;b:=f32(pos[v*3+1])*vertical;c:=f32(pos[v*3+2])*scale;nx:=f32(nor[v*3]);ny:=f32(nor[v*3+1]);nz:=f32(nor[v*3+2]);
   if name=="Rock_Medium_4" && x< -10 && z<50 {
    source_y:=f32(pos[v*3+1]);b=cg_cliff_cap_y(source_y)*vertical;factor:=ifx source_y<=1.2 then 1.5f32 else 0.05f32;remixed:=cg_canopy_normal(nx,ny/factor,nz);nx=remixed[0];ny=remixed[1];nz=remixed[2];
   }
   ambient:f32=1;
   if kind==1 {
    cx:=(lo[0]+hi[0])*0.5;cy:=(lo[1]+hi[1])*0.5;cz:=(lo[2]+hi[2])*0.5;
    rx:=(f32(pos[v*3])-cx)/gp_clamp((hi[0]-lo[0])*0.5,0.1,100);
    ry:=(f32(pos[v*3+1])-cy)/gp_clamp((hi[1]-lo[1])*0.5,0.1,100);
    rz:=(f32(pos[v*3+2])-cz)/gp_clamp((hi[2]-lo[2])*0.5,0.1,100);
    radius:=sqrt(rx*rx+ry*ry+rz*rz);ambient=gp_clamp(0.70+radius*0.25,0.7,1);
    rounded:=cg_canopy_normal(rx,ry,rz);
    if tree {anchor:[3]f32;base:=(v/4)*4;for q:0..<4 {for k:0..<3 {anchor[k]+=f32(pos[(base+q)*3+k])*0.25;}}which:=cg_crown_near(anchor[0],anchor[1],anchor[2],lobes);rounded=cg_canopy_normal(f32(pos[v*3])-lobes[which][0],f32(pos[v*3+1])-lobes[which][1],f32(pos[v*3+2])-lobes[which][2]);}blended:=cg_canopy_normal(rounded[0]*0.90+nx*0.10,rounded[1]*0.90+ny*0.10,rounded[2]*0.90+nz*0.10);nx=blended[0];ny=blended[1];nz=blended[2];
   }
   if vertical!=scale {adjusted:=cg_canopy_normal(nx,ny*scale/vertical,nz);nx=adjusted[0];ny=adjusted[1];nz=adjusted[2];}
   colour:=ifx kind==1 then (ifx starts(name,"Fern") then [3]f32.[0.23,0.53,0.035] else tint) else ifx kind==4 then tint else ifx kind==3 then (ifx starts(name,"Bush") then [3]f32.[1,0.55,0.55] else [3]f32.[1,1,1]) else ifx kind==7 then [3]f32.[1,1,1] else [3]f32.[1,1,1];
   id:=gp_v(w,[3]f32.[x+a*cs+c*sn,y+b,z-a*sn+c*cs],[3]f32.[nx*cs+nz*sn,ny,-nx*sn+nz*cs],[2]f32.[f32(uv[v*2]),f32(uv[v*2+1])],colour,layer,kind);gp_word(w[0].v[..],id*32+28,f32_bits(ambient));
  }
  for t:0..<ni/3 {gp_tri(w,first+int(idx[t*3]),first+int(idx[t*3+1]),first+int(idx[t*3+2]));}
 }}
 if starts(name,"Bush_") {gp_capture_bush(w,capture_first);}else if !(starts(name,"Grass_") && x==0 && z==0 && scale==1) {gp_capture(w,capture_first,starts(name,"Birch_") || starts(name,"CommonTree_"));}
}
// One shared atlas preserves the source colour maps while staying under the
// renderer's 64-layer ceiling. Two-pixel edge padding keeps samples in tile.
gp_village_atlas :: (w:[]Gp,iw:[]ImgWork,root:string,props_root:string)->int {
 images:=[4]string.["T_Trim_Furniture_BaseColor.png","T_Trim_Metal_BaseColor.png","T_Trim_Props_BaseColor.png","T_Trim_Cloth_BaseColor.png"];
 for tile:0..<(ifx props_root=="" then 11 else 16) {if tile<10 || (tile>10 && tile<15) {
   path:=ifx tile<10 then txt_cat3(w[0].txt[..],root,"/glTF/",VILLAGE_IMAGES[tile]) else txt_cat3(w[0].txt[..],props_root,"/Exports/glTF/",images[tile-11]);im:=img_resize(img_load(path,iw),252,252,PI_LANCZOS,iw);
   for y:0..<256 {sy:=ifx y<2 then 0 else ifx y>253 then 251 else y-2;
    for x:0..<256 {sx:=ifx x<2 then 0 else ifx x>253 then 251 else x-2;dst:=((tile/4*256+y)*1024+(tile%4*256+x))*4;src:=(sy*252+sx)*im.c;
     for c:0..<4 {value:u8=255;if c<3 {value=im.px[src+ifx im.c<3 then 0 else c];}else if im.c==2 {value=im.px[src+1];}else if im.c==4 {value=im.px[src+3];}w[0].atlas[dst+c]=value;}}}
  }else {for y:0..<256 {for x:0..<256 {dst:=((tile/4*256+y)*1024+(tile%4*256+x))*4;for c:0..<4 {w[0].atlas[dst+c]=255;}}}}
 }
 im:=pi_img(w[0].atlas[..],1024,1024,4);n:=pi_png(im,iw[0].z[..],iw[0].work[..],iw[0].out[..]);if n<0 || w[0].layers+w[0].nt>=128 {ph_die("village atlas exceeds texture budget");}
 slot:=w[0].nt;w[0].tex[slot]=txt_keep(w[0].txt[..],"quaternius/village/sample-scene-atlas");w[0].encoded[slot]=txt_keep(w[0].txt[..],cast(string)iw[0].out[0..<n]);w[0].nt+=1;w[0].village_layer=w[0].layers+slot;return w[0].village_layer;
}
VillagePart :: struct {ok:bool;group:int;name:string;m:[12]f32;}
gp_village_part :: (row:string)->VillagePart {
 r:VillagePart;a:=0;while a<row.count && row[a]!='|' {a+=1;}if a!=1 || row[0]<'0' || row[0]>'3' {return r;}r.group=int(row[0]-'0');b:=a+1;while b<row.count && row[b]!='|' {b+=1;}if b==a+1 || b>=row.count {return r;}r.name=row[a+1..<b];
 for c:r.name {if !((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='_') {return r;}}
 at:=b+1;n:=0;for i:at..<row.count+1 {if i==row.count || row[i]==',' {if n>=12 {return r;}start:=at;end:=i;while start<end && row[start]==' ' {start+=1;}while end>start && row[end-1]==' ' {end-=1;}v:=pn_parse(row[start..<end]);if !v.ok || v.v!=v.v || abs(v.v)>10000 {return r;}r.m[n]=f32(v.v);n+=1;at=i+1;}}
 // Godot serializes Basis by rows; the mesh packer uses column vectors.
 if n==12 {v:=r.m[1];r.m[1]=r.m[3];r.m[3]=v;v=r.m[2];r.m[2]=r.m[6];r.m[6]=v;v=r.m[5];r.m[5]=r.m[7];r.m[7]=v;}
 r.ok=n==12;return r;
}
#test "village part records bind a safe source mesh and complete finite transform" {
 a:=gp_village_part("0|Wall_Plaster_Straight|1,0,0,0,1,0,0,0,1,2,-3,4");#assert a.ok && a.group==0 && a.name=="Wall_Plaster_Straight" && a.m[9]==2 && a.m[10]== -3;
 #assert !gp_village_part("0|../evil|1,0,0,0,1,0,0,0,1,2,-3,4").ok;
 #assert !gp_village_part("4|Wall|1,0,0,0,1,0,0,0,1,2,-3,4").ok && !gp_village_part("0|Wall|1,0").ok;
 // A saved quarter turn maps local +X to world +Z, not -Z.
 turn:=gp_village_part("0|Stair|0,0,-1,0,1,0,1,0,0,0,0,0");#assert turn.ok && turn.m[0]==0 && turn.m[1]==0 && turn.m[2]==1 && turn.m[6]== -1;
}
// Normals use the inverse transpose: several original sample pieces have
// nonuniform scale. A reflected or singular source transform is refused.
gp_village_normal :: (t:[12]f32,n:[3]f32)->[3]f32 {
 a:=[3]f32.[t[4]*t[8]-t[5]*t[7],t[5]*t[6]-t[3]*t[8],t[3]*t[7]-t[4]*t[6]];
 b:=[3]f32.[t[7]*t[2]-t[8]*t[1],t[8]*t[0]-t[6]*t[2],t[6]*t[1]-t[7]*t[0]];
 c:=[3]f32.[t[1]*t[5]-t[2]*t[4],t[2]*t[3]-t[0]*t[5],t[0]*t[4]-t[1]*t[3]];
 det:=t[0]*a[0]+t[1]*a[1]+t[2]*a[2];if det<=0.000001 {ph_die("village source transform is singular or reflected");}
 out:=[3]f32.[a[0]*n[0]+b[0]*n[1]+c[0]*n[2],a[1]*n[0]+b[1]*n[1]+c[1]*n[2],a[2]*n[0]+b[2]*n[1]+c[2]*n[2]];
 magnitude:=sqrt(out[0]*out[0]+out[1]*out[1]+out[2]*out[2]);if magnitude<0.000001 {ph_die("village source normal is empty");}for i:0..<3 {out[i]/=magnitude;}return out;
}
// Display one specimen from each pinned source model in the experimental meadow.
#test "showcase coordinates stay inside the meadow" {
 p:=gp_showcase_position(0);q:=gp_showcase_position(256);
 #assert p[0]>= -82 && p[1]>= -82 && q[0]<=82 && q[1]<=82;
 for i:209..<257 {r:=gp_showcase_position(i);#assert r[0]>=56 && r[0]<=76 && r[1]>= -5 && r[1]<=23;}
 mask:[269]bool;mask[0]=true;#assert gp_showcase_clear(mask[..],p[0],p[1]) && !gp_showcase_clear(mask[..],0,0);
 a:=gp_showcase_position(257);mask[257]=true;#assert a[0]< -10 && a[1]>0 && gp_showcase_clear(mask[..],a[0],a[1]);
 mask[0]=false;#assert !gp_showcase_clear(mask[..],p[0],p[1]);
}
#test "fantasy showcase excludes modern packaged foods" {
 #assert !gp_fantasy_showcase("ultimate-food","KetchupBottle") && !gp_fantasy_showcase("ultimate-food","Fries") && !gp_fantasy_showcase("ultimate-food","Hotdog");
 #assert !gp_fantasy_showcase("ultimate-food","BurgerLarge") && !gp_fantasy_showcase("ultimate-food","Soda") && !gp_fantasy_showcase("ultimate-food","Popsicle_Strawberry");
 #assert gp_fantasy_showcase("ultimate-food","Apple") && gp_fantasy_showcase("ultimate-food","CookingPot_Soup") && gp_fantasy_showcase("ultimate-rpg","Sword");
}
gp_fantasy_showcase :: (pack:string,name:string)->bool {
 if pack!="ultimate-food" {return true;}
 for prefix:[22]string.["Burger","Cheeseburger","DoubleCheeseburger","Cheese_Singles","ChocolateBar","Chopsticks","Corndog","Cupcake","Donut","Fries","Hotdog","IceCream","Ketchup","MayoBottle","MustardBottle","PeanutButter","Pizza","Popsicle","Sashimi","Soda","SoySauce","Sushi"] {if starts(name,prefix) {return false;}}
 return true;
}
gp_showcase_position :: (i:int)->[2]f32 {if i>=257 {j:=i-257;return [2]f32.[-26.0+f32(j%6)*3.0,8.0+f32(j/6)*4.0];}if i<209 {return [2]f32.[-10.0+f32(i%11)*2.0,8.0+f32(i/11)*2.8];}j:=i-209;return [2]f32.[56.0+f32(j%6)*4.0,-5.0+f32(j/6)*4.0];}
gp_showcase_clear :: (mask:[]bool,x:f32,z:f32)->bool {for i:0..<269 {if !mask[i] {continue;}p:=gp_showcase_position(i);r:=ifx i<209 then 0.8f32 else ifx i<257 then 1.8f32 else 1.6f32;dx:=x-p[0];dz:=z-p[1];if dx*dx+dz*dz<r*r {return true;}}return false;}
gp_showcase_colour :: (root:string,name:string,material:string,t:[]Txt)->[3]f32 {
 path:=txt_cat3(t,root,"/OBJ/",txt_cat(t,name,".mtl"));b:[262144]u8;n:=fs_read(path,b[..]);if n<0 {ph_die2("missing source material: ",path);}lines:[1]Lines;lines[0].text=cast(string)b[0..<n];selected:=false;
 while !lines_done(lines[0]) {line:=lines_next(lines[..]);if starts(line,"newmtl ") {selected=line[7..<line.count]==material;}else if selected && starts(line,"Kd ") {words0:[1]Words;words0[0]=words(line);ignore:=word(words0[..]);v:=[3]f32.[f32(pf(word(words0[..]))),f32(pf(word(words0[..]))),f32(pf(word(words0[..])))];for i:0..<3 {x:=v[i];v[i]=ifx x<=0.0031308 then x*12.92 else 1.055*pow(x,1.0/2.4)-0.055;}return v;}}
 ph_die2("missing source material name: ",material);return [3]f32.[1,1,1];
}
gp_showcase_rotate :: (p:[3]f32,q:[4]f32)->[3]f32 {
 t:=[3]f32.[2*(q[1]*p[2]-q[2]*p[1]),2*(q[2]*p[0]-q[0]*p[2]),2*(q[0]*p[1]-q[1]*p[0])];
 return [3]f32.[p[0]+q[3]*t[0]+q[1]*t[2]-q[2]*t[1],p[1]+q[3]*t[1]+q[2]*t[0]-q[0]*t[2],p[2]+q[3]*t[2]+q[0]*t[1]-q[1]*t[0]];
}
gp_showcase_bounds :: (g:[]Gltf)->[3]f32 {
 lo:=[3]f32.[100000,100000,100000];hi:=[3]f32.[-100000,-100000,-100000];
 for i:0..<g[0].nx[GA_NODE] {node:=gl_at(g,GA_NODE,i);mi:=gl_int(g,node,"mesh",-1);if mi<0 {continue;}translation:[3]f64;rotation:=[4]f64.[0,0,0,1];scale:=[3]f64.[1,1,1];unused:=gl_nums(g,node,"translation",translation[..]);unused=gl_nums(g,node,"rotation",rotation[..]);unused=gl_nums(g,node,"scale",scale[..]);q:=[4]f32.[f32(rotation[0]),f32(rotation[1]),f32(rotation[2]),f32(rotation[3])];mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");
  for pi:0..<jv_len(g[0].d[0],prims) {pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;for v:0..<nv {p:=gp_showcase_rotate([3]f32.[f32(pos[v*3]*scale[0]),f32(pos[v*3+1]*scale[1]),f32(pos[v*3+2]*scale[2])],q);for k:0..<3 {x:=p[k]+f32(translation[k]);if x<lo[k] {lo[k]=x;}if x>hi[k] {hi[k]=x;}}}}
 }
 return [3]f32.[(lo[0]+hi[0])*0.5,lo[1],(lo[2]+hi[2])*0.5];
}
gp_showcase_mesh :: (w:[]Gp,g:[]Gltf,object_path:string,source:string,name:string,slot:int,atlas:int) {
 first:=w[0].nv;gp_showcase_at(w,g,object_path,source,name,gp_showcase_position(slot),atlas,ifx slot>=257 then 0.4f32 else 1.0f32,0,0,115.25);gp_capture(w,first,false);
}
gp_showcase_at :: (w:[]Gp,g:[]Gltf,object_path:string,source:string,name:string,place:[2]f32,atlas:int,model_scale:f32,yaw:f32,lift:f32,marker:f32) {
 gl_load(g,object_path);anchor:=gp_showcase_bounds(g);base:=meadow.exp_height(place[0],place[1])+lift;cs:=cos(yaw);sn:=sin(yaw);
 for node_i:0..<g[0].nx[GA_NODE] {node:=gl_at(g,GA_NODE,node_i);mesh_i:=gl_int(g,node,"mesh",-1);if mesh_i<0 {continue;}translation:[3]f64;rotation:=[4]f64.[0,0,0,1];scale:=[3]f64.[1,1,1];unused:=gl_nums(g,node,"translation",translation[..]);unused=gl_nums(g,node,"rotation",rotation[..]);unused=gl_nums(g,node,"scale",scale[..]);q:=[4]f32.[f32(rotation[0]),f32(rotation[1]),f32(rotation[2]),f32(rotation[3])];
  mesh:=gl_at(g,GA_MESH,mesh_i);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;idx:[262144]f64;nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;unused_acc:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));colour:=gp_showcase_colour(source,name,gl_str(g,mat,"name"),w[0].txt[..]);first:=w[0].nv;
   for v:0..<nv {p:=gp_showcase_rotate([3]f32.[f32(pos[v*3]*scale[0]),f32(pos[v*3+1]*scale[1]),f32(pos[v*3+2]*scale[2])],q);n:=gp_showcase_rotate([3]f32.[f32(nor[v*3]/scale[0]),f32(nor[v*3+1]/scale[1]),f32(nor[v*3+2]/scale[2])],q);length:=sqrt(n[0]*n[0]+n[1]*n[1]+n[2]*n[2]);if length>0 {for k:0..<3 {n[k]/=length;}}lx:=p[0]+f32(translation[0])-anchor[0];lz:=p[2]+f32(translation[2])-anchor[2];normal:=[3]f32.[n[0]*cs+n[2]*sn,n[1],-n[0]*sn+n[2]*cs];id:=gp_v(w,[3]f32.[place[0]+model_scale*(lx*cs+lz*sn),base+model_scale*(p[1]+f32(translation[1])-anchor[1]),place[1]+model_scale*(-lx*sn+lz*cs)],normal,[2]f32.[0.5,0.5],colour,atlas,4);gp_word(w[0].v[..],id*32+28,f32_bits(marker));}
   for k:0..<ni/3 {gp_tri(w,first+int(idx[k*3]),first+int(idx[k*3+1]),first+int(idx[k*3+2]));}
  }
 }
}
// The weapons the Experimental hero holds (#13025): Axe_Double (a Barbarian's greataxe), Sword (a
// Ranger's or Rogue's shortsword), Sword_Golden (a Paladin's longsword) and Sword_big (a Fighter's greatsword),
// from the showcase's Ultimate RPG rows. Each is meshed in its own space, the blade up +Y and centred
// on X and Z, at its source size, marked 115.4375: the runtime sets its grip, scale and the hand's pose (flag 19).
GP_WEAPONS :: [4]string.["Axe_Double","Sword","Sword_Golden","Sword_big"];
gp_weapons :: (w:[]Gp,g:[]Gltf,layout:string,objects:string,rpg:string) {
 b:[65536]u8;n:=fs_read(layout,b[..]);if n<0 {ph_die("missing showcase layout");}
 for k:0..<4 {lines:[1]Lines;lines[0].text=cast(string)b[0..<n];found:=false;
  while !lines_done(lines[0]) {row:=lines_next(lines[..]);a:=0;while a<row.count && row[a]!='|' {a+=1;}c:=a+1;while c<row.count && row[c]!='|' {c+=1;}if c>=row.count || row[0..<a]!="ultimate-rpg" || row[a+1..<c]!=GP_WEAPONS[k] {continue;}
   path:=txt_cat3(w[0].txt[..],objects,"/",row[c+1..<row.count]);gl_load(g,path);anchor:=gp_showcase_bounds(g);
   w[0].weaponfirst[k]=w[0].ni;gp_showcase_at(w,g,path,rpg,GP_WEAPONS[k],[2]f32.[0,0],w[0].village_layer,1,0,-meadow.exp_height(0,0)+anchor[1],115.4375);w[0].weaponcount[k]=w[0].ni-w[0].weaponfirst[k];found=true;break;}
  if !found {ph_die("missing weapon in the showcase layout");}
 }
}
gp_showcase :: (w:[]Gp,g:[]Gltf,layout:string,objects:string,food:string,rpg:string,dungeon:string,animals:string) {
 first_collider:=w[0].collider_n;b:[65536]u8;n:=fs_read(layout,b[..]);if n<0 {ph_die("missing showcase layout");}lines:[1]Lines;lines[0].text=cast(string)b[0..<n];slot:=0;
 while !lines_done(lines[0]) {row:=lines_next(lines[..]);if row.count==0 {continue;}a:=0;while a<row.count && row[a]!='|' {a+=1;}c:=a+1;while c<row.count && row[c]!='|' {c+=1;}if a==0 || c>=row.count || row.count-c-1!=64 {ph_die("invalid showcase layout");}pack:=row[0..<a];name:=row[a+1..<c];sha:=row[c+1..<row.count];source:=ifx pack=="ultimate-food" then food else ifx pack=="ultimate-rpg" then rpg else ifx pack=="dungeon" then dungeon else ifx pack=="ultimate-animals-static" then animals else "";if source=="" {ph_die("unknown showcase package");}if slot>=269 {ph_die("too many showcase items");}w[0].showcase_keep[slot]=gp_fantasy_showcase(pack,name);if slot<257 && w[0].showcase_keep[slot] {path:=txt_cat3(w[0].txt[..],objects,"/",sha);gp_showcase_mesh(w,g,path,source,name,slot,w[0].village_layer);}slot+=1;
 }
 if slot!=269 {ph_die("incomplete showcase layout");}gp_merge_display(w,first_collider);
}
// A piece placed as gp_showcase_at places one, scaled `sc` along its own x, y and z before it turns.
gp_piece_at :: (w:[]Gp,g:[]Gltf,object_path:string,source:string,name:string,place:[2]f32,atlas:int,sc:[3]f32,yaw:f32,lift:f32,marker:f32) {
 gl_load(g,object_path);anchor:=gp_showcase_bounds(g);base:=meadow.exp_height(place[0],place[1])+lift;cs:=cos(yaw);sn:=sin(yaw);
 for node_i:0..<g[0].nx[GA_NODE] {node:=gl_at(g,GA_NODE,node_i);mesh_i:=gl_int(g,node,"mesh",-1);if mesh_i<0 {continue;}translation:[3]f64;rotation:=[4]f64.[0,0,0,1];scale:=[3]f64.[1,1,1];unused:=gl_nums(g,node,"translation",translation[..]);unused=gl_nums(g,node,"rotation",rotation[..]);unused=gl_nums(g,node,"scale",scale[..]);q:=[4]f32.[f32(rotation[0]),f32(rotation[1]),f32(rotation[2]),f32(rotation[3])];
  mesh:=gl_at(g,GA_MESH,mesh_i);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;idx:[262144]f64;nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;unused_acc:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));colour:=gp_showcase_colour(source,name,gl_str(g,mat,"name"),w[0].txt[..]);first:=w[0].nv;
   for v:0..<nv {p:=gp_showcase_rotate([3]f32.[f32(pos[v*3]*scale[0]),f32(pos[v*3+1]*scale[1]),f32(pos[v*3+2]*scale[2])],q);n:=gp_showcase_rotate([3]f32.[f32(nor[v*3]/scale[0]),f32(nor[v*3+1]/scale[1]),f32(nor[v*3+2]/scale[2])],q);for k:0..<3 {n[k]/=sc[k];}length:=sqrt(n[0]*n[0]+n[1]*n[1]+n[2]*n[2]);if length>0 {for k:0..<3 {n[k]/=length;}}lx:=(p[0]+f32(translation[0])-anchor[0])*sc[0];lz:=(p[2]+f32(translation[2])-anchor[2])*sc[2];normal:=[3]f32.[n[0]*cs+n[2]*sn,n[1],-n[0]*sn+n[2]*cs];id:=gp_v(w,[3]f32.[place[0]+lx*cs+lz*sn,base+sc[1]*(p[1]+f32(translation[1])-anchor[1]),place[1]-lx*sn+lz*cs],normal,[2]f32.[0.5,0.5],colour,atlas,4);gp_word(w[0].v[..],id*32+28,f32_bits(marker));}
   for k:0..<ni/3 {gp_tri(w,first+int(idx[k*3]),first+int(idx[k*3+1]),first+int(idx[k*3+2]));}
  }
 }
}
// The dungeon (verse/experimental-dungeon.coax places every piece): Floor_Modular and
// Wall_Modular at 2.5 times make its 5 m cells and walls, the roof is Floor_Modular in ten-metre
// slabs, and every doorway is an Arch. `part` -1 is the shell, drawn with the village (the outer
// walls, the walls between rooms, the roof and the entrance); 0 to 7 the inside, by rooms
// (dungeon.dg_room_chunk), each its own draw.
gp_dungeon_piece :: (w:[]Gp,g:[]Gltf,objects:string,root:string,piece:int,x:f32,z:f32,sc:[3]f32,yaw:f32,lift:f32) {
 path:=txt_cat3(w[0].txt[..],objects,"/",dungeon.DG_HASHES[piece]);gp_piece_at(w,g,path,root,dungeon.DG_NAMES[piece],[2]f32.[x,z],w[0].village_layer,sc,yaw,lift,115.0625);
}
gp_dungeon :: (w:[]Gp,g:[]Gltf,objects:string,root:string,part:int) {
 // the walls stand 0.3 m into the floor, so no seam opens at their foot, their tops under the roof
 sink:=0.3f32;tall:=(f32(dungeon.DG_HEIGHT)+sink)/2;thick:=f32(dungeon.DG_HALF)/0.22;quarter:=1.5707963f32;
 for r:0..<dungeon.DG_ROWS+1 {for c:0..<dungeon.DG_COLS+1 {
  if c<dungeon.DG_COLS && dungeon.dg_wall_h(c,r) && part==dungeon.dg_part_h(c,r) {
   s:=dungeon.dg_span_h(c,r);gp_dungeon_piece(w,g,objects,root,dungeon.DG_P_WALL,(s[0]+s[1])*0.5,dungeon.dg_z(r),[3]f32.[(s[1]-s[0])*0.5,tall,thick],0,-sink);}
  if r<dungeon.DG_ROWS && dungeon.dg_wall_v(c,r) && part==dungeon.dg_part_v(c,r) {
   s:=dungeon.dg_span_v(c,r);gp_dungeon_piece(w,g,objects,root,dungeon.DG_P_WALL,dungeon.dg_x(c),(s[0]+s[1])*0.5,[3]f32.[(s[1]-s[0])*0.5,tall,thick],quarter,-sink);}
  if part>=0 && c<dungeon.DG_COLS && r<dungeon.DG_ROWS && dungeon.dg_floor(c,r) && part==dungeon.dg_cell_chunk(c,r) {
   cell:=f32(dungeon.DG_CELL);gp_dungeon_piece(w,g,objects,root,dungeon.DG_P_FLOOR,dungeon.dg_x(c)+cell*0.5,dungeon.dg_z(r)-cell*0.5,[3]f32.[cell/2,1,cell/2],0,-0.24);}
 }}
 for i:0..<dungeon.DG_ARCHES {a:=dungeon.dg_arch(i);if part==dungeon.dg_arch_part(i) {k:=f32(dungeon.DG_ARCH_SCALE);gp_dungeon_piece(w,g,objects,root,dungeon.DG_P_ARCH,a[0],a[1],[3]f32.[k,k,k],a[2]*quarter,0);}}
 if part<0 {
  // the roof: six by eleven slabs from the outer walls' outer faces, its underside on the walls
  x0:=f32(dungeon.DG_X0)-f32(dungeon.DG_HALF);x1:=dungeon.dg_east()+f32(dungeon.DG_HALF);z0:=dungeon.dg_south()-f32(dungeon.DG_HALF);z1:=f32(dungeon.DG_Z0)+f32(dungeon.DG_HALF);
  for a:0..<6 {for b:0..<11 {sx:=(x1-x0)/6;sz:=(z1-z0)/11;gp_dungeon_piece(w,g,objects,root,dungeon.DG_P_FLOOR,x0+sx*(f32(a)+0.5),z0+sz*(f32(b)+0.5),[3]f32.[sx/2,1,sz/2],0,f32(dungeon.DG_HEIGHT));}}
  // and the same slabs under the floor, so a seam at a wall's foot shows stone, not sky (the block
  // runs past the meadow's ground)
  for a:0..<6 {for b:0..<11 {sx:=(x1-x0)/6;sz:=(z1-z0)/11;gp_dungeon_piece(w,g,objects,root,dungeon.DG_P_FLOOR,x0+sx*(f32(a)+0.5),z0+sz*(f32(b)+0.5),[3]f32.[sx/2,1,sz/2],0,-0.7);}}
  return;
 }
 t:[dungeon.DG_TORCHES_MAX]dungeon.DgTorch;n:=dungeon.dg_torches(t[..]);ts:=f32(dungeon.DG_TORCH_SCALE);
 for i:0..<n {if dungeon.dg_cell_chunk(t[i].col,t[i].row)!=part {continue;}gp_dungeon_piece(w,g,objects,root,dungeon.DG_P_TORCH,t[i].x,t[i].z,[3]f32.[ts,ts,ts],f32(t[i].turn)*quarter,f32(dungeon.DG_TORCH_LIFT));}
 for i:0..<dungeon.DG_PROPS {p:=dungeon.dg_prop(i);if dungeon.dg_prop_part(p)!=part {continue;}gp_dungeon_piece(w,g,objects,root,p.piece,p.x,p.z,[3]f32.[p.scale,p.scale,p.scale],f32(p.turn)*quarter,p.lift);}
}
GP_ANIMALS :: [12]string.["Alpaca","Bull","Cow","Deer","Donkey","Fox","Horse","Horse_White","Husky","ShibaInu","Stag","Wolf"];
gp_animal_frames :: (w:[]Gp,root:string) {
 first_collider:=w[0].collider_n;for frame:0..<10 {w[0].animalfirst[frame]=w[0].ni;
  for animal:0..<12 {pb:[4096]u8;s:[1]Sb;s[0]=sb(pb[..]);sb_put(s[..],root);sb_byte(s[..],'/');sb_put(s[..],GP_ANIMALS[animal]);sb_byte(s[..],'-');sb_int(s[..],frame);sb_put(s[..],".bin");b:[524288]u8;n:=fs_read(sb_text(s[..]),b[..]);if n<8 {ph_die("missing baked animal frame");}count:=gl_u32(b[..],0);if count<=0 || count%3!=0 || n!=8+count*28 {ph_die("invalid baked animal frame");}
   if frame==0 {lo:=[3]f32.[100000,100000,100000];hi:=[3]f32.[-100000,-100000,-100000];for v:0..<count {for k:0..<3 {x:=f32_from_bits(cast(u32)gl_u32(b[..],8+v*28+k*4));if x<lo[k] {lo[k]=x;}if x>hi[k] {hi[k]=x;}}}w[0].animal_anchor[animal]=[3]f32.[(lo[0]+hi[0])*0.5,lo[1],(lo[2]+hi[2])*0.5];}
   capture_first:=w[0].nv;place:=gp_showcase_position(257+animal);anchor:=w[0].animal_anchor[animal];base:=meadow.exp_height(place[0],place[1]);seen:[32768]int;mapped:[16384]int;if count>mapped.count {ph_die("animal frame has too many corners");}
   for v:0..<count {at:=8+v*28;hash:=0;for k:0..<28 {hash=(hash*33+int(b[at+k]))%32768;}while seen[hash]!=0 {other:=8+(seen[hash]-1)*28;same:=true;for k:0..<28 {if b[at+k]!=b[other+k] {same=false;break;}}if same {break;}hash=(hash+1)%32768;}
    if seen[hash]!=0 {mapped[v]=mapped[seen[hash]-1];}else {seen[hash]=v+1;p:[3]f32;normal:[3]f32;colour:[3]f32;for k:0..<3 {p[k]=f32_from_bits(cast(u32)gl_u32(b[..],at+k*4));normal[k]=f32_from_bits(cast(u32)gl_u32(b[..],at+12+k*4));colour[k]=f32(b[at+24+k])/255;}id:=gp_v(w,[3]f32.[place[0]+0.4*(p[0]-anchor[0]),base+0.4*(p[1]-anchor[1]),place[1]+0.4*(p[2]-anchor[2])],normal,[2]f32.[0.5,0.5],colour,w[0].village_layer,4);gp_word(w[0].v[..],id*32+28,f32_bits(115.375));mapped[v]=id;}
    if v%3==2 {gp_tri(w,mapped[v-2],mapped[v-1],mapped[v]);}}
   if frame==0 {gp_capture(w,capture_first,false);}
  }if frame==0 {gp_merge_display(w,first_collider);}w[0].animalcount[frame]=w[0].ni-w[0].animalfirst[frame];
 }
}
#test "bestiary placements are separate and in the open meadow" {
 a:=gp_bestiary_position(0);b:=gp_bestiary_position(1);#assert a[0]!=b[0] && a[1]==b[1] && abs(a[0])<82 && abs(b[0])<82;
}
gp_bestiary_position :: (i:int)->[2]f32 {return [2]f32.[6.0+f32(i)*3.0,-7.0];}
gp_bestiary_atlas :: (w:[]Gp,iw:[]ImgWork,root:string)->int {
 images:=[2]string.["T_Imp_BaseColor_1.png","T_Puglin_BaseColor_1.png"];
 for tile:0..<16 {if tile<2 {path:=txt_cat3(w[0].txt[..],root,"/Textures/",images[tile]);im:=img_resize(img_load(path,iw),252,252,PI_LANCZOS,iw);
   for y:0..<256 {sy:=ifx y<2 then 0 else ifx y>253 then 251 else y-2;for x:0..<256 {sx:=ifx x<2 then 0 else ifx x>253 then 251 else x-2;dst:=((tile/4*256+y)*1024+(tile%4*256+x))*4;src:=(sy*252+sx)*im.c;for c:0..<4 {value:u8=255;if c<3 {value=im.px[src+ifx im.c<3 then 0 else c];}else if im.c==2 {value=im.px[src+1];}else if im.c==4 {value=im.px[src+3];}w[0].atlas[dst+c]=value;}}}
  }else {for y:0..<256 {for x:0..<256 {dst:=((tile/4*256+y)*1024+(tile%4*256+x))*4;for c:0..<4 {w[0].atlas[dst+c]=255;}}}}
 }
 im:=pi_img(w[0].atlas[..],1024,1024,4);n:=pi_png(im,iw[0].z[..],iw[0].work[..],iw[0].out[..]);if n<0 || w[0].layers+w[0].nt>=128 {ph_die("bestiary atlas exceeds texture budget");}slot:=w[0].nt;w[0].tex[slot]=txt_keep(w[0].txt[..],"quaternius/bestiary-dungeon/atlas");w[0].encoded[slot]=txt_keep(w[0].txt[..],cast(string)iw[0].out[0..<n]);w[0].nt+=1;w[0].bestiary_layer=w[0].layers+slot;return w[0].bestiary_layer;
}
gp_bestiary_frames :: (w:[]Gp,frames:string) {
 atlas:=w[0].bestiary_layer;names:=[2]string.["Imp","Puglin"];
 for frame:0..<48 {w[0].monsterfirst[frame]=w[0].ni;for i:0..<2 {w[0].monsterpartfirst[frame][i]=w[0].ni;pb:[4096]u8;builder:[1]Sb;builder[0]=sb(pb[..]);sb_put(builder[..],frames);sb_byte(builder[..],'/');sb_put(builder[..],names[i]);sb_byte(builder[..],'-');sb_int(builder[..],frame);sb_put(builder[..],".bin");path:=sb_text(builder[..]);b:[2097152]u8;n:=fs_read(path,b[..]);if n<8 {ph_die("missing baked bestiary model");}nv:=gl_u32(b[..],0);ni:=gl_u32(b[..],4);if nv<=0 || ni<=0 || ni%3!=0 || n!=8+nv*32+ni*4 {ph_die("invalid baked bestiary model");}lo:=[3]f32.[100000,100000,100000];hi:=[3]f32.[-100000,-100000,-100000];for v:0..<nv {for k:0..<3 {x:=f32_from_bits(cast(u32)gl_u32(b[..],8+v*32+k*4));if x<lo[k] {lo[k]=x;}if x>hi[k] {hi[k]=x;}}}place:=gp_bestiary_position(i);base:=meadow.exp_height(place[0],place[1]);if frame==0 {w[0].monster_anchor[i]=[3]f32.[(lo[0]+hi[0])*0.5,lo[1],(lo[2]+hi[2])*0.5];}anchor:=w[0].monster_anchor[i];first:=w[0].nv;
  for v:0..<nv {at:=8+v*32;p:[3]f32;normal:[3]f32;for k:0..<3 {p[k]=f32_from_bits(cast(u32)gl_u32(b[..],at+k*4));normal[k]=f32_from_bits(cast(u32)gl_u32(b[..],at+12+k*4));}u:=f32_from_bits(cast(u32)gl_u32(b[..],at+24));v0:=f32_from_bits(cast(u32)gl_u32(b[..],at+28));id:=gp_v(w,[3]f32.[place[0]+p[0]-anchor[0],base+p[1]-anchor[1],place[1]+p[2]-anchor[2]],normal,[2]f32.[(u+4)/8,(v0+4)/8],[3]f32.[1,1,1],atlas,4);gp_word(w[0].v[..],id*32+28,f32_bits(100.125+f32(i)));}
  for k:0..<ni/3 {a:=gl_u32(b[..],8+nv*32+k*12);c:=gl_u32(b[..],8+nv*32+k*12+4);d:=gl_u32(b[..],8+nv*32+k*12+8);if a>=nv || c>=nv || d>=nv {ph_die("invalid bestiary triangle");}gp_tri(w,first+a,first+c,first+d);}
 if frame==0 {gp_capture(w,first,false);}w[0].monsterpartcount[frame][i]=w[0].ni-w[0].monsterpartfirst[frame][i];}w[0].monstercount[frame]=w[0].ni-w[0].monsterfirst[frame];}
}
gp_village_mesh :: (w:[]Gp,g:[]Gltf,root:string,part:VillagePart,atlas:int,site_id:int,mark:f32) {
 path:=txt_cat3(w[0].txt[..],root,"/glTF/",txt_cat(w[0].txt[..],part.name,".gltf"));gl_load(g,path);site:=meadow.exp_site(site_id);base:=meadow.exp_height(site.x,site.z);t:=part.m;
 for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {
  pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;uv:[131072]f64;idx:[262144]f64;
  nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;r:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);r=gl_acc(g,gl_int(g,attr,"TEXCOORD_0",0),uv[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;
  mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));tile:=gp_village_tile(gl_str(g,mat,"name"));if tile<0 {ph_die2("unknown village material: ",gl_str(g,mat,"name"));}
  factor:[4]f64=[4]f64.[1,1,1,1];if tile==8 && gl_nums(g,gl_get(g,mat,"pbrMetallicRoughness"),"baseColorFactor",factor[..])!=4 {ph_die("village vine missing source colour");}tint:=gp_village_tint(tile,factor);
  first:=w[0].nv;for v:0..<nv {x:=f32(pos[v*3]);y:=f32(pos[v*3+1]);z:=f32(pos[v*3+2]);nx:=f32(nor[v*3]);ny:=f32(nor[v*3+1]);nz:=f32(nor[v*3+2]);uu:=f32(uv[v*2]);vv:=f32(uv[v*2+1]);
   if abs(uu)>4 || abs(vv)>4 {ph_die("village source UV exceeds admitted range");}
   p:=[3]f32.[site.x+t[9]+t[0]*x+t[3]*y+t[6]*z,base+t[10]+t[1]*x+t[4]*y+t[7]*z,site.z+t[11]+t[2]*x+t[5]*y+t[8]*z];
   normal:=gp_village_normal(t,[3]f32.[nx,ny,nz]);
   id:=gp_v(w,p,normal,[2]f32.[(uu+4)/8,(vv+4)/8],tint,atlas,4);gp_word(w[0].v[..],id*32+28,f32_bits(100.0+f32(tile)+mark));
  }
  for k:0..<ni/3 {gp_tri(w,first+int(idx[k*3]),first+int(idx[k*3+1]),first+int(idx[k*3+2]));}
 }}
}
gp_village :: (w:[]Gp,g:[]Gltf,iw:[]ImgWork,root:string,layout:string,props_root:string) {
 buf:[262144]u8;n:=fs_read(layout,buf[..]);if n<0 {ph_die("missing village layout");}atlas:=gp_village_atlas(w,iw,root,props_root);at:=0;counts:[4]int;
 while at<n {e:=at;while e<n && buf[e]!='\n' {e+=1;}if e>at {part:=gp_village_part(cast(string)buf[at..<e]);if !part.ok {ph_die("invalid village layout");}counts[part.group]+=1;for site:0..<meadow.EXP_SITES {if meadow.exp_site_group(site)==part.group {gp_village_mesh(w,g,root,part,atlas,site,0);}}}at=e+1;}
 if counts[0]!=167 || counts[1]!=77 || counts[2]!=308 || counts[3]!=151 {ph_die("incomplete village layout");}
}
// Each neighborhood house has the same accessible footprint but a different kit combination.
gp_house_part :: (w:[]Gp,g:[]Gltf,root:string,atlas:int,site:int,name:string,x:f32,y:f32,z:f32,turn:bool) {
 p:VillagePart;p.ok=true;p.name=name;
 p.m=ifx turn then [12]f32.[0,0,-1,0,1,0,1,0,0,x,y,z] else [12]f32.[1,0,0,0,1,0,0,0,1,x,y,z];
 gp_village_mesh(w,g,root,p,atlas,site,0.25);
}
gp_house_back :: (w:[]Gp,g:[]Gltf,root:string,atlas:int,site:int,name:string,z:f32) {
 p:VillagePart;p.ok=true;p.name=name;p.m=[12]f32.[-1,0,0,0,1,0,0,0,-1,0,3.1,z];
 gp_village_mesh(w,g,root,p,atlas,site,0.25);
}
#test "new houses use finished gables and varied exterior walls" {
 #assert gp_house_gable(0)=="Roof_Front_Wood4" && gp_house_gable(1)=="Roof_Front_Brick4";
 #assert gp_house_gable(6)=="" && gp_house_gable(7)=="";
}
gp_house_gable :: (i:int)->string {if i==6 || i==7 {return "";}return ifx i%2==0 then "Roof_Front_Wood4" else "Roof_Front_Brick4";}
gp_new_houses :: (w:[]Gp,g:[]Gltf,root:string) {
 doors:=[4]string.["Wall_Plaster_Door_Flat","Wall_UnevenBrick_Door_Flat","Wall_WoodBrick_Door_Flat","Wall_WoodWear_Door_Flat"];
 windows:=[4]string.["Wall_Plaster_Window_Wide_Flat","Wall_UnevenBrick_Window_Wide_Flat","Wall_WoodBrick_Window_Wide_Flat","Wall_WoodWear_Window_Wide_Flat"];
 walls:=[4]string.["Wall_Plaster_Straight","Wall_UnevenBrick_Straight","Wall_WoodBrick_Straight","Wall_WoodWear_Straight"];
 floors:=[6]string.["Floor_Brick","Floor_Brick","Floor_RoundRocks","Floor_UnevenBrick","Floor_WoodDark","Floor_WoodLight"];
 roofs:=[12]string.["Roof_FlatTiles_4x4","Roof_RoundTiles_4x4","Roof_FlatTiles_4x6","Roof_RoundTiles_4x6","Roof_FlatTiles_4x6","Roof_RoundTiles_4x6","Roof_Tower_FlatTiles","Roof_Tower_RoundTiles","Roof_FlatTiles_4x4","Roof_RoundTiles_4x4","Roof_FlatTiles_4x6","Roof_RoundTiles_4x6"];
 frames:=[3]string.["DoorFrame_Flat_Brick","DoorFrame_Flat_WoodDark","DoorFrame_Flat_WoodLight"];
 panes:=[4]string.["Window_Wide_Flat1","Window_Wide_Flat2","Window_Wide_Flat3","Window_Wide_Flat_Rocks"];
 leaves:=[8]string.["Door_1_Flat","Door_2_Flat","Door_3_Flat","Door_4_Flat","Door_5_Flat","Door_6_Flat","Door_7_Flat","Door_8_Flat"];
 for i:0..<9 {site:=i+9;family:=i%4;
  for a:0..<2 {for b:0..<2 {gp_house_part(w,g,root,w[0].village_layer,site,floors[i%6],f32(a*2-1),0.02,f32(b*2-1),false);}}
  gp_house_part(w,g,root,w[0].village_layer,site,doors[family],-1,0,2,false);
  gp_house_part(w,g,root,w[0].village_layer,site,frames[i%3],-1,0,2,false);
  gp_house_part(w,g,root,w[0].village_layer,site,leaves[i%8],-1.78,0,2,true);
  gp_house_part(w,g,root,w[0].village_layer,site,windows[family],1,0,2,false);
  gp_house_part(w,g,root,w[0].village_layer,site,panes[i%4],1,0,2,false);
  for side:0..<2 {x:=f32(side*2-1);
   gp_house_part(w,g,root,w[0].village_layer,site,windows[(family+1)%4],x,0,-2,false);
   gp_house_part(w,g,root,w[0].village_layer,site,panes[(i+side+1)%4],x,0,-2,false);
   left:=ifx side==0 then walls[family] else windows[family];right:=ifx side==0 then windows[(family+1)%4] else walls[(family+1)%4];
   gp_house_part(w,g,root,w[0].village_layer,site,left,-2,0,x,true);gp_house_part(w,g,root,w[0].village_layer,site,right,2,0,x,true);
   if side==1 {gp_house_part(w,g,root,w[0].village_layer,site,panes[(i+2)%4],-2,0,x,true);}
   if side==0 {gp_house_part(w,g,root,w[0].village_layer,site,panes[(i+3)%4],2,0,x,true);}
  }
  gp_house_part(w,g,root,w[0].village_layer,site,roofs[i],0,3.1,0,false);
  gable:=gp_house_gable(i);if gable!="" {gp_house_part(w,g,root,w[0].village_layer,site,gable,0,3.1,2,false);gp_house_back(w,g,root,w[0].village_layer,site,gable,-2);}
  if i%4==0 {gp_house_part(w,g,root,w[0].village_layer,site,"Roof_Spike",0,6.5,0,false);}
 }
}
// A broad stone curtain joins the original tower to its three matching copies.
// Each two-metre segment follows the meadow and shares the village brick atlas.
gp_castle :: (w:[]Gp,g:[]Gltf,root:string,objects:string,dungeon:string) {
 site:=meadow.exp_site(1);base:=meadow.exp_height(site.x,site.z);
 for i:0..<castle.CASTLE_SEGMENTS {v:=castle.castle_segment(i);p:VillagePart;p.ok=true;p.name="Wall_UnevenBrick_Straight";
  x:=v[0]-site.x;z:=v[1]-site.z;y:=meadow.exp_height(v[0],v[1])-base;
  for level:0..<2 {p.m=ifx v[2]==0 then [12]f32.[1,0,0,0,1,0,0,0,1,x,y+f32(level)*3,z] else [12]f32.[0,0,-1,0,1,0,1,0,0,x,y+f32(level)*3,z];gp_village_mesh(w,g,root,p,w[0].village_layer,1,0.375);}
 }
 arch:="10a211e5847be978c8bbcfa633e93f7edbdee203531f373660e27525f059453f";path:=txt_cat3(w[0].txt[..],objects,"/",arch);for gate:castle.CASTLE_GATES {gp_showcase_at(w,g,path,dungeon,"Arch",[2]f32.[gate[0],gate[1]],w[0].village_layer,1,ifx gate[2]==1 then 1.5707963f32 else 0.0f32,0,115.3125);}
}
gp_prop_tile :: (name:string)->int {
 if name=="MI_Trim_Furniture" {return 11;}if name=="MI_Trim_Metal" || name=="MI_Trim_Metal_Vertex" {return 12;}
 if name=="MI_Trim_Props" || name=="MI_Trim_Props_Vertex" {return 13;}if name=="MI_Trim_Cloth" || name=="MI_Banner" {return 14;}return -1;
}
#test "fantasy props retain their source material tiles" {
 #assert gp_prop_tile("MI_Trim_Furniture")==11 && gp_prop_tile("MI_Trim_Metal_Vertex")==12 && gp_prop_tile("MI_Trim_Props_Vertex")==13 && gp_prop_tile("MI_Banner")==14 && gp_prop_tile("bad")== -1;
}
#test "extra prop display stays inside the meadow" {
 a:=gp_extra_prop_position(0);b:=gp_extra_prop_position(73);#assert a[0]> -82 && a[1]> -82 && b[0]< -40 && b[1]< -20;
}
gp_extra_prop_position :: (i:int)->[2]f32 {return [2]f32.[-77.0+f32(i%8)*3.5,-75.0+f32(i/8)*5.5];}
gp_extra_clear :: (x:f32,z:f32)->bool {for i:0..<74 {p:=gp_extra_prop_position(i);dx:=x-p[0];dz:=z-p[1];if dx*dx+dz*dz<1.0 {return true;}}return false;}
gp_extra_props :: (w:[]Gp,g:[]Gltf,root:string,layout:string) {
 first_collider:=w[0].collider_n;w[0].extra_props=true;
 data:[32768]u8;n:=fs_read(layout,data[..]);if n<0 {ph_die("missing extra prop layout");}lines:[1]Lines;lines[0].text=cast(string)data[0..<n];slot:=0;
 while !lines_done(lines[0]) {row:=lines_next(lines[..]);if row.count==0 {continue;}a:=0;while a<row.count && row[a]!='|' {a+=1;}if a==0 || row.count-a-1!=64 || slot>=74 {ph_die("invalid extra prop layout");}name:=row[0..<a];capture_first:=w[0].nv;path:=txt_cat3(w[0].txt[..],root,"/Exports/glTF/",txt_cat(w[0].txt[..],name,".gltf"));gl_load(g,path);anchor:=gp_showcase_bounds(g);place:=gp_extra_prop_position(slot);base:=meadow.exp_height(place[0],place[1]);sc:=[3]f64.[1,1,1];r:=gl_nums(g,gl_at(g,GA_NODE,0),"scale",sc[..]);sx:=f32(sc[0]);sy:=f32(sc[1]);sz:=f32(sc[2]);rot:=[4]f64.[0,0,0,1];r=gl_nums(g,gl_at(g,GA_NODE,0),"rotation",rot[..]);q:=[4]f32.[f32(rot[0]),f32(rot[1]),f32(rot[2]),f32(rot[3])];
  for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;uv:[131072]f64;colors:[262144]f64;idx:[262144]f64;nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;acc:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);acc=gl_acc(g,gl_int(g,attr,"TEXCOORD_0",0),uv[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;ci:=gl_int(g,attr,"COLOR_0",-1);channels:=0;if ci>=0 {col:=gl_acc(g,ci,colors[..]);channels=col.comps;if col.count!=nv || (channels!=3 && channels!=4) {ph_die("invalid prop vertex colors");}}
   mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));material:=gl_str(g,mat,"name");tile:=ifx material=="MI_Page_Empty" then 15 else gp_prop_tile(material);if tile<0 {ph_die2("unknown prop material: ",material);}first:=w[0].nv;
   for v:0..<nv {x:=f32(pos[v*3])*sx;y:=f32(pos[v*3+1])*sy;z:=f32(pos[v*3+2])*sz;local:=gp_showcase_rotate([3]f32.[x,y,z],q);normal:=gp_showcase_rotate(cg_canopy_normal(f32(nor[v*3])/sx,f32(nor[v*3+1])/sy,f32(nor[v*3+2])/sz),q);uu:=f32(uv[v*2]);vv:=f32(uv[v*2+1]);if abs(uu)>4 || abs(vv)>4 {ph_die("prop UV exceeds admitted range");}colour:=ifx tile==15 then [3]f32.[0.87,0.79,0.59] else [3]f32.[1,1,1];if channels>0 && tile!=15 {for j:0..<3 {colour[j]=f32(colors[v*channels+j]);}}id:=gp_v(w,[3]f32.[place[0]+local[0]-anchor[0],base+local[1]-anchor[1],place[1]+local[2]-anchor[2]],normal,[2]f32.[(uu+4)/8,(vv+4)/8],colour,w[0].village_layer,4);gp_word(w[0].v[..],id*32+28,f32_bits(100.125+f32(tile)));}
   for k:0..<ni/3 {gp_tri(w,first+int(idx[k*3]),first+int(idx[k*3+1]),first+int(idx[k*3+2]));}
  }}gp_capture(w,capture_first,false);slot+=1;
 }if slot!=74 {ph_die("incomplete extra prop layout");}gp_merge_display(w,first_collider);
}
#test "nature display stays within the meadow and clear of village sites" {
 for i:36..<96 {p:=gp_extra_nature_position(i);#assert p[0]>= -79 && p[0]<= -24 && p[1]>=56 && p[1]<=80 && !meadow.exp_clear(p[0],p[1]);}
}
gp_extra_nature_position :: (slot:int)->[2]f32 {
 if slot<36 {return [2]f32.[22+f32(slot%10)*3,4+f32(slot/10)*5];}
 return [2]f32.[-79+f32((slot-36)%12)*5,56+f32((slot-36)/12)*6];
}
gp_extra_nature :: (w:[]Gp,g:[]Gltf,iw:[]ImgWork,root:string,layout:string) {
 first_collider:=w[0].collider_n;data:[8192]u8;n:=fs_read(layout,data[..]);if n<0 {ph_die("missing extra nature layout");}lines:[1]Lines;lines[0].text=cast(string)data[0..<n];slot:=0;
 while !lines_done(lines[0]) {row:=lines_next(lines[..]);if row.count==0 {continue;}a:=0;while a<row.count && row[a]!='|' {a+=1;}if a==0 || row.count-a-1!=64 || slot>=96 {ph_die("invalid extra nature layout");}name:=row[0..<a];place:=gp_extra_nature_position(slot);x:=place[0];z:=place[1];sc:=ifx slot<36 then 0.6f32 else 0.35f32;gp_mesh_scaled(w,g,iw,root,name,x,z,sc,sc,f32(slot)*0.7,[3]f32.[0.36,0.80,0.08],0);slot+=1;
 }if slot!=96 {ph_die("incomplete extra nature layout");}gp_merge_display(w,first_collider);
}
// A fixed clock on the workshop's front gable. White atlas tile 15 lets the
// ink, brass and ivory use the same bounded texture array as the village.
gp_clock_vertex :: (w:[]Gp,x:f32,y:f32,z:f32,color:[3]f32)->int {
 id:=gp_v(w,[3]f32.[x,y,z],[3]f32.[0,0,1],[2]f32.[0.5,0.5],color,w[0].village_layer,4);gp_word(w[0].v[..],id*32+28,f32_bits(115));return id;
}
gp_clock_bar :: (w:[]Gp,x:f32,y:f32,z:f32,dx:f32,dy:f32,width:f32,color:[3]f32) {
 length:=sqrt(dx*dx+dy*dy);if length<0.0001 {return;}px:= -dy/length*width;py:=dx/length*width;
 a:=gp_clock_vertex(w,x+px,y+py,z,color);b:=gp_clock_vertex(w,x-px,y-py,z,color);c:=gp_clock_vertex(w,x+dx+px,y+dy+py,z,color);d:=gp_clock_vertex(w,x+dx-px,y+dy-py,z,color);gp_tri(w,a,b,c);gp_tri(w,b,d,c);
}
gp_workshop_clock :: (w:[]Gp) {
 site:=meadow.exp_site(8);x:=site.x+2;y:=meadow.exp_height(site.x,site.z)+10.15;z:=site.z+4.45;
 brass:=[3]f32.[0.72,0.43,0.12];ivory:=[3]f32.[0.91,0.84,0.64];ink:=[3]f32.[0.12,0.10,0.08];
 for i:0..<32 {a:=f32(i)*6.2831853/32;b:=f32(i+1)*6.2831853/32;
  center:=gp_clock_vertex(w,x,y,z,ivory);p:=gp_clock_vertex(w,x+cos(a),y+sin(a),z,ivory);q:=gp_clock_vertex(w,x+cos(b),y+sin(b),z,ivory);gp_tri(w,center,p,q);
  r:=gp_clock_vertex(w,x+cos(a)*1.14,y+sin(a)*1.14,z+0.01,brass);s:=gp_clock_vertex(w,x+cos(b)*1.14,y+sin(b)*1.14,z+0.01,brass);u:=gp_clock_vertex(w,x+cos(a),y+sin(a),z+0.01,brass);v:=gp_clock_vertex(w,x+cos(b),y+sin(b),z+0.01,brass);gp_tri(w,u,r,v);gp_tri(w,r,s,v);
 }
 for i:0..<12 {angle:=f32(i)*6.2831853/12;dx:=cos(angle);dy:=sin(angle);gp_clock_bar(w,x+dx*0.76,y+dy*0.76,z+0.02,dx*0.12,dy*0.12,0.025,ink);}
 gp_clock_bar(w,x,y,z+0.03,0.0,0.58,0.035,ink);gp_clock_bar(w,x,y,z+0.035,0.38,0.22,0.045,ink);
}
gp_props :: (w:[]Gp,g:[]Gltf,root:string) {
 for site_id:0..<9 {site:=meadow.exp_site(site_id);group:=meadow.exp_site_group(site_id);
  for i:0..<props.exp_prop_count(site_id) {p:=props.exp_prop_at(site_id,i);capture_first:=w[0].nv;path:=txt_cat3(w[0].txt[..],root,"/Exports/glTF/",txt_cat(w[0].txt[..],p.name,".gltf"));gl_load(g,path);sc:[16]f64;has_scale:=gl_nums(g,gl_at(g,GA_NODE,0),"scale",sc[..]);sx:=ifx has_scale==3 then f32(sc[0]) else 1.0f32;sy:=ifx has_scale==3 then f32(sc[1]) else 1.0f32;sz:=ifx has_scale==3 then f32(sc[2]) else 1.0f32;
   x:=site.x+p.x;z:=site.z+p.z;y:=meadow.exp_height(x,z)+p.y;cs:=cos(p.yaw);sn:=sin(p.yaw);
   for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;uv:[131072]f64;colors:[262144]f64;idx:[262144]f64;
    nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;r:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);r=gl_acc(g,gl_int(g,attr,"TEXCOORD_0",0),uv[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;ci:=gl_int(g,attr,"COLOR_0",-1);channels:=0;if ci>=0 {col:=gl_acc(g,ci,colors[..]);channels=col.comps;if col.count!=nv || (channels!=3 && channels!=4) {ph_die("invalid prop vertex colors");}}
    mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));tile:=gp_prop_tile(gl_str(g,mat,"name"));if tile<0 {ph_die2("unknown prop material: ",gl_str(g,mat,"name"));}first:=w[0].nv;
    for v:0..<nv {a:=f32(pos[v*3])*sx;b:=f32(pos[v*3+1])*sy;c:=f32(pos[v*3+2])*sz;nx:=f32(nor[v*3])/sx;ny:=f32(nor[v*3+1])/sy;nz:=f32(nor[v*3+2])/sz;normal:=cg_canopy_normal(nx*cs+nz*sn,ny,-nx*sn+nz*cs);uu:=f32(uv[v*2]);vv:=f32(uv[v*2+1]);if abs(uu)>4 || abs(vv)>4 {ph_die("prop UV exceeds admitted range");}colour:=[3]f32.[1,1,1];if channels>0 {for j:0..<3 {colour[j]=f32(colors[v*channels+j]);}}
     id:=gp_v(w,[3]f32.[x+a*cs+c*sn,y+b,z-a*sn+c*cs],normal,[2]f32.[(uu+4)/8,(vv+4)/8],colour,w[0].village_layer,4);gp_word(w[0].v[..],id*32+28,f32_bits(100.0+f32(tile)));}
    for k:0..<ni/3 {gp_tri(w,first+int(idx[k*3]),first+int(idx[k*3+1]),first+int(idx[k*3+2]));}
   }}gp_capture(w,capture_first,false);
  }
 }
}
gp_height :: (x:f32,z:f32,zone:bool)->f32 {return ifx zone then ez_local_height(x,z) else cg_height(x,z);}
gp_ground :: (w:[]Gp,white:int,zone:bool) {
 // A continuous hillside with a bare, winding ochre path and a level foreground clearing. In the zone
 // it runs on past the composed glade, rising into hills, and under the town's ground at the seam.
 // (the zone's cells are 0.85 m, so the wider ground keeps the pack inside its 32 MiB)
 cell:=ifx zone then 0.85f32 else 0.65f32;first:=w[0].nv;cols:=ifx zone then 142 else 101;rows:=ifx zone then 93 else 101;
 z0:=ifx zone then f32(EZ_LOCAL_SOUTH) else 5.0f32;x0:=ifx zone then -f32(EZ_WIDE) else -32.5f32;
 for iz:0..<rows {z:=z0-f32(iz)*cell;for ix:0..<cols {x:=x0+f32(ix)*cell;y:=gp_height(x,z,zone)-0.035;
  dx:=(gp_height(x+0.1,z,zone)-gp_height(x-0.1,z,zone))/0.2;dz:=(gp_height(x,z+0.1,zone)-gp_height(x,z-0.1,zone))/0.2;normal_length:=sqrt(dx*dx+1+dz*dz);
  path:=cg_path(x,z);noise:=cg_hash(x,z);autumn:=cg_autumn(x,z);c:=[3]f32.[0.32+autumn*0.24,0.53-autumn*0.03,0.055];
  dirt:=[3]f32.[0.67+noise*0.015,0.60+noise*0.015,0.35];for k:0..<3 {c[k]=c[k]*(1-path)+dirt[k]*path;}
  id:=gp_v(w,[3]f32.[x,y,z],[3]f32.[-dx/normal_length,1/normal_length,-dz/normal_length],[2]f32.[0.5,0.5],c,white,5);
 }}for iz:0..<rows-1 {for ix:0..<cols-1 {a:=first+iz*cols+ix;gp_tri(w,a,a+1,a+cols);gp_tri(w,a+1,a+cols+1,a+cols);}}

}
// The experimental profile keeps the glade's height, colours and lighting but
// extends the ground in both directions. The original path fades into meadow.
gp_ground_experimental :: (w:[]Gp,white:int) {
 side:=151;first:=w[0].nv;
 for iz:0..<side {z:=90-f32(iz)*1.2;for ix:0..<side {x:= -90+f32(ix)*1.2;y:=meadow.exp_height(x,z)-0.035;
  dx:=(meadow.exp_height(x+0.1,z)-meadow.exp_height(x-0.1,z))/0.2;dz:=(meadow.exp_height(x,z+0.1)-meadow.exp_height(x,z-0.1))/0.2;l:=sqrt(dx*dx+1+dz*dz);
  path:=cg_path(x,z)*gp_clamp((z+45)/10,0,1)*gp_clamp((12-z)/7,0,1);noise:=cg_hash(x,z);autumn:=cg_autumn(x,z);
  c:=[3]f32.[0.32+autumn*0.24,0.53-autumn*0.03,0.055];dirt:=[3]f32.[0.67+noise*0.015,0.60+noise*0.015,0.35];
  for k:0..<3 {c[k]=c[k]*(1-path)+dirt[k]*path;}
  id:=gp_v(w,[3]f32.[x,y,z],[3]f32.[-dx/l,1/l,-dz/l],[2]f32.[0.5,0.5],c,white,5);
 }}
 for iz:0..<side-1 {for ix:0..<side-1 {a:=first+iz*side+ix;gp_tri(w,a,a+1,a+side);gp_tri(w,a+1,a+side+1,a+side);}}
}
// ---- The road to Everglade: coarse ground past the glade grid and the town at the end of the road
// (verse/character-glade.coax places both). Flat stone, plaster and tile faces use the Nature rock
// layer, whose material colours by vertex tint; positions stay inside the pack's 100 m bound.
#test "glade town faces wind outward and boxes close every side but the buried bottom" #steps 60000000 {
 w:[1]GpTown;gp_box(w[..],0,0,1,2,0,3,0.4,[3]f32.[1,1,1],0);#assert w[0].nv==20 && w[0].ni==30;
 for t:0..<10 {a:=gp_pos(w[..],gl_u32(w[0].i[..],t*12));b:=gp_pos(w[..],gl_u32(w[0].i[..],t*12+4));c:=gp_pos(w[..],gl_u32(w[0].i[..],t*12+8));
  n:=gp_cross(gp_sub(b,a),gp_sub(c,a));mid:=[3]f32.[(a[0]+b[0]+c[0])/3,(a[1]+b[1]+c[1])/3-1.5,(a[2]+b[2]+c[2])/3];#assert n[0]*mid[0]+n[1]*mid[1]+n[2]*mid[2]>0;}
 before:=w[0].nv;gp_prism(w[..],5,5,1,0,4,8,[3]f32.[1,1,1],0);gp_cone(w[..],5,5,1.2,4,6,8,[3]f32.[1,1,1],0);#assert w[0].nv-before==8*4+8*3;
}
gp_sub :: (a:[3]f32,b:[3]f32)->[3]f32 {return [3]f32.[a[0]-b[0],a[1]-b[1],a[2]-b[2]];}
gp_cross :: (a:[3]f32,b:[3]f32)->[3]f32 {return [3]f32.[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];}
gp_pos :: (w:[]GpTown,id:int)->[3]f32 {return [3]f32.[f32_from_bits(cast(u32)gl_u32(w[0].v[..],id*32)),f32_from_bits(cast(u32)gl_u32(w[0].v[..],id*32+4)),f32_from_bits(cast(u32)gl_u32(w[0].v[..],id*32+8))];}
// One flat face (three or four corners) facing away from `inside`; its own normal, UVs across it.
gp_face :: (w:[]GpTown,p:[4][3]f32,corners:int,inside:[3]f32,tint:[3]f32,layer:int) {
 n:=gp_cross(gp_sub(p[1],p[0]),gp_sub(p[2],p[0]));l:=sqrt(n[0]*n[0]+n[1]*n[1]+n[2]*n[2]);if l<0.000001 {return;}
 for k:0..<3 {n[k]/=l;}c:=gp_sub(p[0],inside);flip:=n[0]*c[0]+n[1]*c[1]+n[2]*c[2]<0;if flip {for k:0..<3 {n[k]= -n[k];}}
 uvs:=[4][2]f32.[[2]f32.[0,1],[2]f32.[1,1],[2]f32.[1,0],[2]f32.[0,0]];ids:[4]int;
 for k:0..<corners {ids[k]=gp_tv(w,p[k],n,uvs[k],tint,layer,4);gp_word(w[0].v[..],ids[k]*32+28,f32_bits(1));}
 if flip {gp_tt(w,ids[0],ids[2],ids[1]);if corners==4 {gp_tt(w,ids[0],ids[3],ids[2]);}}
 else {gp_tt(w,ids[0],ids[1],ids[2]);if corners==4 {gp_tt(w,ids[0],ids[2],ids[3]);}}
}
gp_corner :: (cx:f32,cz:f32,hx:f32,hz:f32,yaw:f32,y:f32)->[3]f32 {c:=cos(yaw);s:=sin(yaw);return [3]f32.[cx+hx*c+hz*s,y,cz-hx*s+hz*c];}
// A box from y0 to y1 on a turned footprint; its bottom is underground and left out.
gp_box :: (w:[]GpTown,cx:f32,cz:f32,hx:f32,hz:f32,y0:f32,y1:f32,yaw:f32,tint:[3]f32,layer:int) {
 sx:=[4]f32.[-1,1,1,-1];sz:=[4]f32.[-1,-1,1,1];inside:=[3]f32.[cx,(y0+y1)*0.5,cz];
 for k:0..<4 {j:=(k+1)%4;q:[4][3]f32;q[0]=gp_corner(cx,cz,hx*sx[k],hz*sz[k],yaw,y0);q[1]=gp_corner(cx,cz,hx*sx[j],hz*sz[j],yaw,y0);q[2]=gp_corner(cx,cz,hx*sx[j],hz*sz[j],yaw,y1);q[3]=gp_corner(cx,cz,hx*sx[k],hz*sz[k],yaw,y1);gp_face(w,q,4,inside,tint,layer);}
 top:[4][3]f32;for k:0..<4 {top[k]=gp_corner(cx,cz,hx*sx[k],hz*sz[k],yaw,y1);}gp_face(w,top,4,inside,tint,layer);
}
// A gable roof whose ridge runs along the footprint's local x.
gp_gable :: (w:[]GpTown,cx:f32,cz:f32,hx:f32,hz:f32,y0:f32,ridge:f32,yaw:f32,tint:[3]f32,layer:int) {
 inside:=[3]f32.[cx,y0+(ridge-y0)*0.3,cz];
 for side:0..<2 {sz:=ifx side==0 then -1.0f32 else 1.0f32;q:[4][3]f32;q[0]=gp_corner(cx,cz,-hx,hz*sz,yaw,y0);q[1]=gp_corner(cx,cz,hx,hz*sz,yaw,y0);q[2]=gp_corner(cx,cz,hx,0,yaw,ridge);q[3]=gp_corner(cx,cz,-hx,0,yaw,ridge);gp_face(w,q,4,inside,tint,layer);}
 for side:0..<2 {sx:=ifx side==0 then -1.0f32 else 1.0f32;q:[4][3]f32;q[0]=gp_corner(cx,cz,hx*sx,-hz,yaw,y0);q[1]=gp_corner(cx,cz,hx*sx,hz,yaw,y0);q[2]=gp_corner(cx,cz,hx*sx,0,yaw,ridge);gp_face(w,q,3,inside,tint,layer);}
}
gp_pyramid :: (w:[]GpTown,cx:f32,cz:f32,hx:f32,hz:f32,y0:f32,apex:f32,yaw:f32,tint:[3]f32,layer:int) {
 sx:=[4]f32.[-1,1,1,-1];sz:=[4]f32.[-1,-1,1,1];inside:=[3]f32.[cx,y0+(apex-y0)*0.25,cz];
 for k:0..<4 {j:=(k+1)%4;q:[4][3]f32;q[0]=gp_corner(cx,cz,hx*sx[k],hz*sz[k],yaw,y0);q[1]=gp_corner(cx,cz,hx*sx[j],hz*sz[j],yaw,y0);q[2]=[3]f32.[cx,apex,cz];gp_face(w,q,3,inside,tint,layer);}
}
gp_prism :: (w:[]GpTown,cx:f32,cz:f32,r:f32,y0:f32,y1:f32,sides:int,tint:[3]f32,layer:int) {
 inside:=[3]f32.[cx,(y0+y1)*0.5,cz];
 for k:0..<sides {a:=f32(k)*6.2831853/f32(sides);b:=f32(k+1)*6.2831853/f32(sides);q:[4][3]f32;
  q[0]=[3]f32.[cx+r*cos(a),y0,cz+r*sin(a)];q[1]=[3]f32.[cx+r*cos(b),y0,cz+r*sin(b)];q[2]=[3]f32.[cx+r*cos(b),y1,cz+r*sin(b)];q[3]=[3]f32.[cx+r*cos(a),y1,cz+r*sin(a)];gp_face(w,q,4,inside,tint,layer);}
}
gp_cone :: (w:[]GpTown,cx:f32,cz:f32,r:f32,y0:f32,apex:f32,sides:int,tint:[3]f32,layer:int) {
 inside:=[3]f32.[cx,y0+(apex-y0)*0.25,cz];
 for k:0..<sides {a:=f32(k)*6.2831853/f32(sides);b:=f32(k+1)*6.2831853/f32(sides);q:[4][3]f32;
  q[0]=[3]f32.[cx+r*cos(a),y0,cz+r*sin(a)];q[1]=[3]f32.[cx+r*cos(b),y0,cz+r*sin(b)];q[2]=[3]f32.[cx,apex,cz];gp_face(w,q,3,inside,tint,layer);}
}
// The lowest and highest ground under a footprint (its corners, edges' middles and centre).
gp_ground_span :: (cx:f32,cz:f32,hx:f32,hz:f32,yaw:f32)->[2]f32 {
 lo:f32=1000;hi:f32= -1000;
 for i:0..<3 {for j:0..<3 {p:=gp_corner(cx,cz,hx*f32(i-1),hz*f32(j-1),yaw,0);y:=cg_height(p[0],p[2]);if y<lo {lo=y;}if y>hi {hi=y;}}}
 return [2]f32.[lo,hi];
}
gp_town_block :: (w:[]GpTown,b:CgBlock,layer:int) {
 stone:=[3]f32.[0.60,0.58,0.50];tower:=[3]f32.[0.55,0.53,0.47];timber:=[3]f32.[0.36,0.25,0.15];plaster:=[3]f32.[0.88,0.82,0.68];tile:=[3]f32.[0.68,0.28,0.16];slate:=[3]f32.[0.32,0.35,0.40];
 hx:=b.w*0.5;hz:=b.d*0.5;
 if b.shape==0 {
  // Walls follow the ground in segments of at most four metres, merlons along each top.
  pieces:=int(ceil(f64(b.w)/4));piece:=b.w/f32(pieces);c:=cos(b.yaw);s:=sin(b.yaw);
  for k:0..<pieces {along:= -hx+piece*(f32(k)+0.5);px:=b.x+along*c;pz:=b.z-along*s;span:=gp_ground_span(px,pz,piece*0.5,hz,b.yaw);top:=span[0]+b.h;if top<span[1]+0.8 {top=span[1]+0.8;}
   gp_box(w,px,pz,piece*0.5,hz,span[0]-0.6,top,b.yaw,stone,layer);
   merlons:=int(floor(f64(piece)/1.6));for m:0..<merlons {ma:=along-piece*0.5+(f32(m)+0.5)*piece/f32(merlons);gp_box(w,b.x+ma*c,b.z-ma*s,0.38,hz,top,top+0.7,b.yaw,stone,layer);}
  }
  return;
 }
 span:=gp_ground_span(b.x,b.z,hx,hz,b.yaw);base:=span[0]-0.6;top:=span[1]+b.h;
 if b.shape==1 {gp_box(w,b.x,b.z,hx,hz,base,top,b.yaw,plaster,layer);gp_box(w,b.x,b.z,hx+0.06,hz+0.06,top-0.35,top,b.yaw,timber,layer);gp_gable(w,b.x,b.z,hx+0.35,hz+0.4,top,top+b.roof,b.yaw,tile,layer);}
 if b.shape==2 {gp_box(w,b.x,b.z,hx,hz,base,top,b.yaw,tower,layer);gp_box(w,b.x,b.z,hx+0.2,hz+0.2,top-0.5,top,b.yaw,stone,layer);gp_pyramid(w,b.x,b.z,hx+0.35,hz+0.35,top,top+b.roof,b.yaw,ifx b.h>10 then slate else tile,layer);}
 if b.shape==3 {gp_prism(w,b.x,b.z,hx,base,top,8,tower,layer);gp_cone(w,b.x,b.z,hx+0.35,top,top+b.roof,8,tile,layer);}
 if b.shape==4 {y:=cg_height(b.x,b.z)+b.lift;gp_box(w,b.x,b.z,hx,hz,y,y+b.h,b.yaw,timber,layer);gp_box(w,b.x,b.z,hx,hz*0.9,y+b.h,y+b.h+0.7,b.yaw,stone,layer);}
}
gp_road_to_everglade :: (w:[]GpTown,layer:int) {
 // Ground past the glade grid's last row (z -60), a little lower so its coarse edge never shows.
 cols:=31;rows:=11;first:=w[0].nv;
 for iz:0..<rows {z:= -60-f32(iz)*3.8;for ix:0..<cols {x:= -60+f32(ix)*4;y:=cg_height(x,z)-0.06;
  dx:=(cg_height(x+0.5,z)-cg_height(x-0.5,z));dz:=(cg_height(x,z+0.5)-cg_height(x,z-0.5));l:=sqrt(dx*dx+1+dz*dz);
  path:=cg_path(x,z);autumn:=cg_autumn(x,z);noise:=cg_hash(x,z);c:=[3]f32.[0.32+autumn*0.24,0.53-autumn*0.03,0.055];dirt:=[3]f32.[0.67+noise*0.015,0.60+noise*0.015,0.35];
  for k:0..<3 {c[k]=c[k]*(1-path)+dirt[k]*path;}
  id:=gp_tv(w,[3]f32.[x,y,z],[3]f32.[-dx/l,1/l,-dz/l],[2]f32.[0.5,0.5],c,0,5);
 }}
 for iz:0..<rows-1 {for ix:0..<cols-1 {a:=first+iz*cols+ix;gp_tt(w,a,a+1,a+cols);gp_tt(w,a+1,a+cols+1,a+cols);}}
 for i:0..<CG_CITY {gp_town_block(w,cg_city(i),layer);}
}
// The town's own bounded store, appended to the environment after the glade's meshes.
GP_TOWN_VERTS :: 6000;
GpTown :: struct {v:[GP_TOWN_VERTS*32]u8;i:[GP_TOWN_VERTS*8]u8;nv:int;ni:int;}
gp_tv :: (w:[]GpTown,p:[3]f32,n:[3]f32,uv:[2]f32,c:[3]f32,layer:int,kind:int)->int {
 if w[0].nv>=GP_TOWN_VERTS {ph_die("town vertices exceed bounded store");}id:=w[0].nv;gp_vertex(w[0].v[..],id*32,p,n,uv,c,layer,kind);w[0].nv+=1;return id;
}
gp_tt :: (w:[]GpTown,a:int,b:int,c:int) {if (w[0].ni+3)*4>w[0].i.count {ph_die("town indices overflow");}for q:[3]int.[a,b,c] {put_u32(w[0].i[..],w[0].ni*4,q);w[0].ni+=1;}}
gp_append_town :: (w:[]Gp,t:[]GpTown) {
 base:=w[0].nv;if base+t[0].nv>GP_VERTS {ph_die("glade vertices exceed bounded store");}
 for k:0..<t[0].nv*32 {w[0].v[base*32+k]=t[0].v[k];}w[0].nv+=t[0].nv;
 for k:0..<t[0].ni/3 {gp_tri(w,base+gl_u32(t[0].i[..],k*12),base+gl_u32(t[0].i[..],k*12+4),base+gl_u32(t[0].i[..],k*12+8));}
}
gp_grass_seeds :: (w:[]Gp,white:int,group:int,proposals:int,source_height:f32,experimental:bool,decorated:bool,showcase:bool) {
 w[0].seedfirst[group]=w[0].nv;hero:=cg_item(7);
 for i:0..<proposals {fi:=f32(i+group*100000);x:=(cg_hash(fi,2)-0.5)*(ifx i<proposals*4/5 then 26.0f32 else 54.0f32);z:=3-cg_hash(fi,5)*(ifx i<proposals*4/5 then 30.0f32 else 55.0f32);
  if cg_path(x,z)>0.40 || (x*x+z*z)<0.6 || (experimental && meadow.exp_clear(x,z)) || (decorated && props.exp_prop_clear(x,z)) || (showcase && gp_showcase_clear(w[0].showcase_keep[..],x,z)) || (w[0].extra_props && gp_extra_clear(x,z)) {continue;}
  patch:=0.65+0.35*sin(x*1.1)*sin(z*1.3);height:=(0.17+cg_hash(fi,8)*0.22)*patch;near:=sqrt((x-hero.x)*(x-hero.x)+(z-hero.z)*(z-hero.z));height*=0.2+0.8*gp_clamp((near-0.5)/0.7,0,1);
  autumn:=cg_autumn(x,z);base:=[3]f32.[0.30+0.26*autumn,0.48,0.055];
  id:=gp_v(w,[3]f32.[x,ifx experimental then meadow.exp_height(x,z) else cg_height(x,z),z],[3]f32.[0,1,0],[2]f32.[height/source_height,0.18+cg_hash(fi,7)*0.10],base,white,0);
  gp_word(w[0].v[..],id*32+28,f32_bits(cg_hash(fi,9)*6.283));w[0].seedn[group]+=1;
 }
 if experimental {extra:=ifx group==0 then 6500 else ifx group==1 then 2500 else 50000;
  for i:0..<extra {if w[0].seedn[group]>=65535 {break;}p:=gp_exp_grass(i,group);x:=p[0];z:=p[1];
   if (abs(x)<27 && z<3 && z> -52) || meadow.exp_clear(x,z) || (decorated && props.exp_prop_clear(x,z)) || (showcase && gp_showcase_clear(w[0].showcase_keep[..],x,z)) || (w[0].extra_props && gp_extra_clear(x,z)) {continue;}fi:=f32(i+group*100000+400000);
   height:=(0.17+cg_hash(fi,8)*0.22)*(0.65+0.35*sin(x*1.1)*sin(z*1.3));autumn:=cg_autumn(x,z);
   id:=gp_v(w,[3]f32.[x,meadow.exp_height(x,z),z],[3]f32.[0,1,0],[2]f32.[height/source_height,0.18+cg_hash(fi,7)*0.10],[3]f32.[0.30+0.26*autumn,0.48,0.055],white,0);
   gp_word(w[0].v[..],id*32+28,f32_bits(cg_hash(fi,9)*6.283));w[0].seedn[group]+=1;
  }
 }
}
gp_entry :: (out:[]u8,row:int,kind:int,license:int,name:string,offset:int,size:int) {
 out[row]=cast(u8)kind;out[row+1]=cast(u8)license;put_u32(out,row+4,offset);put_u32(out,row+8,size);for i:0..<name.count {if i<31 {out[row+16+i]=name[i];}}
}
// Append the shared meshes to an existing world pack without rebuilding its
// other assets. The appended model indices start at their own vertex base.
gp_append_familiars :: (input:string,output:string)->int {
  w:[1]Gp; src:=w[0].out[..];
  size:=fs_read(input,src);
  if size<32 || cast(string)src[0..<4]!="VPK1" || gl_u32(src,8)!=size { return 1; }
  table:=gl_u32(src,16); entries:=gl_u32(src,4);
  if table!=32 || entries<3 || entries>(size-table)/48 { return 1; }
  start:=table+entries*48;
  vc:=table+48; ic:=table+96;
  if src[table]!=1 || src[vc]!=2 || src[ic]!=3 { return 1; }
  vertex_bytes:=gl_u32(src,vc+8); index_bytes:=gl_u32(src,ic+8);
  if vertex_bytes%32!=0 || index_bytes%4!=0 { return 1; }
  for q:0..<entries {
    row:=table+q*48; off:=gl_u32(src,row+4); n:=gl_u32(src,row+8);
    if off<start || off>size || n>size-off { return 1; }
  }
  cat_at:=gl_u32(src,table+4); cat_n:=gl_u32(src,table+8);
  cat:=cast(string)src[cat_at..<cat_at+cat_n];
  size_at:=-1;
  at:=0;
  while at<cat.count {
    end:=at;
    while end<cat.count && cat[end]!='\n' { end+=1; }
    line:=cat[at..<end];
    if starts(line,"C glade/familiar") || starts(line,"L 248 ") { tool_errln("pack already contains familiar models or uses source 248"); return 1; }
    if starts(line,"bytes ") && line.count==16 { size_at=at+6; }
    at=end+1;
  }
  if size_at<0 { return 1; }

  first:[FAM_FORMS]int; count:[FAM_FORMS]int;
  gp_familiar_meshes(w[..],first[..],count[..]);
  extra:[2048]u8; c:[1]Sb; c[0]=sb(extra[..]);
  sb_byte(c[..],'\n');
  gp_familiar_catalog(c[..],first[..],count[..],index_bytes/4,vertex_bytes/4);
  appendix:=sb_text(c[..]);
  out:[536870912]u8;
  new_size:=size+appendix.count+w[0].nv*32+w[0].ni*4+4;
  if new_size>out.count || new_size>gl_u32(src,12) { tool_errln("familiar models exceed the pack budget"); return 1; }
  for i:0..<start { out[i]=src[i]; }
  pos:=start;
  for q:0..<entries {
    row:=table+q*48; off:=gl_u32(src,row+4); n:=gl_u32(src,row+8);
    here:=pos;
    for i:0..<n { out[pos]=src[off+i]; pos+=1; }
    if q==0 { for ch:appendix { out[pos]=ch; pos+=1; } }
    if q==1 { for i:0..<w[0].nv*32 { out[pos]=w[0].v[i]; pos+=1; } }
    if q==2 { for i:0..<w[0].ni*4 { out[pos]=w[0].i[i]; pos+=1; } }
    put_u32(out[..],row+4,here);
    put_u32(out[..],row+8,pos-here);
    pos=((pos+3)/4)*4;
  }
  put_u32(out[..],8,pos);
  value:=pos;
  for i:0..<10 { out[start+size_at+9-i]=cast(u8)(48+value%10); value/=10; }
  if !fs_write(output,cast(string)out[0..<pos]) { return 1; }
  print("Appended % familiar meshes to % (% bytes)\n",FAM_FORMS,output,pos);
  return 0;
}

tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) {return 2;}
 if args_count(args[..])==3 && args_at(args[..],0)=="--append-familiars" {return gp_append_familiars(args_at(args[..],1),args_at(args[..],2));}
 if (args_count(args[..])!=3 && args_count(args[..])!=4 && args_count(args[..])!=6 && args_count(args[..])!=7 && args_count(args[..])!=14 && args_count(args[..])!=16 && args_count(args[..])!=17 && args_count(args[..])!=18 && args_count(args[..])!=19 && args_count(args[..])!=20) {tool_errln("glade pack: SOURCE_ROOT BASE.pack OUTPUT.pack [--experimental|zone]");return 2;}
 experimental:=args_count(args[..])>=4 && args_at(args[..],3)=="--experimental";zone:=args_count(args[..])==4 && args_at(args[..],3)=="zone";if args_count(args[..])>=4 && !experimental && !zone {return 2;}buildings:=args_count(args[..])>=6;
 w:[1]Gp;g:[1]Gltf;iw:[1]ImgWork;root:=args_at(args[..],0);w[0].oldn=fs_read(args_at(args[..],1),w[0].old[..]);if w[0].oldn<32 {return 1;}
 old:=w[0].old[..];ne:=gl_u32(old,4);table:=gl_u32(old,16);vo:=0;vn:=0;io:=0;in:=0;cat:="";
 for i:0..<ne {r:=table+i*48;kind:=int(old[r]);off:=gl_u32(old,r+4);size:=gl_u32(old,r+8);if kind==1 {cat=cast(string)old[off..<off+size];}if kind==2 {vo=off;vn=size;}if kind==3 {io=off;in=size;}if kind==4 {w[0].layers+=1;}}
 // Original wardrobe layer zero is opaque RGB; terrain ignores its colour.
 // Reuse it so the derived sky fits the same 64-layer runtime limit.
 if experimental {gp_ground_experimental(w[..],0);}else {gp_ground(w[..],0,zone);}
 if !zone {
 sky:=gp_texture(w[..],"assets/registry/scenes/character-glade-sky.png",iw[..]);
 sky_a:=gp_v(w[..],[3]f32.[-1,-1,0],[3]f32.[0,0,1],[2]f32.[0,1],[3]f32.[1,1,1],sky,0);
 sky_b:=gp_v(w[..],[3]f32.[1,-1,0],[3]f32.[0,0,1],[2]f32.[1,1],[3]f32.[1,1,1],sky,0);
 sky_c:=gp_v(w[..],[3]f32.[-1,1,0],[3]f32.[0,0,1],[2]f32.[0,0],[3]f32.[1,1,1],sky,0);
 sky_d:=gp_v(w[..],[3]f32.[1,1,0],[3]f32.[0,0,1],[2]f32.[1,0],[3]f32.[1,1,1],sky,0);gp_tri(w[..],sky_a,sky_b,sky_c);gp_tri(w[..],sky_b,sky_d,sky_c);
 }
 for i:0..<CG_ITEMS {item:=cg_item(i);if !cg_visible(item) || (experimental && (!gp_exp_keep(i,item) || meadow.exp_clear(item.x,item.z))) {continue;}stem:=ifx item.kind==0 then "CommonTree_" else ifx item.kind==1 then "Birch_" else ifx item.kind==3 then "Rock_Medium_" else "Rock_Big_";nb:[64]u8;s:[1]Sb;s[0]=sb(nb[..]);sb_put(s[..],stem);sb_int(s[..],ifx item.kind==2 then item.variant+1 else item.variant+1);gp_mesh_scaled(w[..],g[..],iw[..],root,sb_text(s[..]),item.x,item.z,item.scale,item.scale*item.vertical,item.yaw,item.tint,item.lift);}
 for i:0..<32 {fi:=f32(i);x:=(cg_hash(fi,24)-0.5)*24;z:=-1-cg_hash(fi,25)*24;if cg_path(x,z)>0.55 {continue;}stem:=ifx i%4==0 then "Bush_Common_Flowers" else ifx i%4==1 then "Fern_1" else ifx i%4==2 then "Mushroom_Common" else "Flower_3_Group";gp_mesh(w[..],g[..],iw[..],root,stem,x,z,(0.25+cg_hash(fi,30)*0.35)*(ifx i%4==3 then 0.55f32 else 1.0f32),fi,[3]f32.[0.35,0.78,0.055]);}
 for i:0..<8 {if experimental && i==5 {continue;}pos:=[8][2]f32.[[2]f32.[-2.6,-3],[2]f32.[-2.0,-3.5],[2]f32.[1.05,-0.6],[2]f32.[-0.65,0.4],[2]f32.[1.3,-0.8],[2]f32.[0.5,-1.8],[2]f32.[-1.1,1],[2]f32.[-1.7,0.5]];stem:=ifx i==0 then "Fern_1" else ifx i==1 then "Bush_Common_Flowers" else ifx i<5 then "Mushroom_Common" else ifx i==5 then "Pebble_Round_1" else "Flower_3_Group";size:f32=ifx i==0 then 0.22 else ifx i==1 then 0.60 else ifx i==2 then 0.80 else ifx i==3 then 0.65 else ifx i==4 then 0.40 else ifx i==5 then 0.25 else 0.20;gp_mesh_scaled(w[..],g[..],iw[..],root,stem,pos[i][0],pos[i][1],size,size*(ifx i>=2 && i<=4 then 0.75f32 else 1.0f32),f32(i),[3]f32.[0.36,0.80,0.08],0);}
 gp_mesh(w[..],g[..],iw[..],root,"Flower_3_Group",-0.55,1.6,0.14,0.5,[3]f32.[1,1,1]);
 if !experimental {gp_mesh_lift(w[..],g[..],iw[..],root,"Rock_Medium_3",-14,-24,2.0,0.3,[3]f32.[0.7,0.7,0.5],0.0);}
 gp_mesh(w[..],g[..],iw[..],root,"Fern_1",-5,-5.5,1.1,1.1,[3]f32.[0.32,0.65,0.045]);
 if !experimental {gp_mesh_scaled(w[..],g[..],iw[..],root,"Rock_Medium_4",-0.18,-2.4,0.16,0.05,1.1,[3]f32.[0.55,0.60,0.40],0);}
 gp_mesh(w[..],g[..],iw[..],root,"Plant_3",1.05,1.0,0.35,0.8,[3]f32.[1,0.56,0.06]);
 // The reference's right foreground (November 7 pass): orange and red-orange leafy plants at the
 // bottom right and small stones on the near path, off the walk line. Plant_1 costs about 5 KB an
 // instance, Plant_3 about 29 KB and a bush 135 KB, so this fits the pack's 32 MiB.
 for i:0..<7 {fi:=f32(i);pos:=[7][2]f32.[[2]f32.[1.45,1.55],[2]f32.[0.85,1.9],[2]f32.[1.7,0.35],[2]f32.[2.2,1.2],[2]f32.[1.25,-0.6],[2]f32.[2.4,-1.6],[2]f32.[3.0,-2.8]];
  gp_mesh(w[..],g[..],iw[..],root,ifx i==0 then "Plant_3" else "Plant_1",pos[i][0],pos[i][1],(ifx i<2 then 0.24f32 else 0.40f32)+cg_hash(fi,71)*0.12,fi*1.3,ifx i%3==0 then [3]f32.[1,0.30,0.03] else ifx i%3==1 then [3]f32.[1,0.17,0.02] else [3]f32.[1,0.44,0.05]);}
 for i:0..<6 {if experimental {continue;}fi:=f32(i);z:= -1.5-fi*1.0;x:=cg_path_x(z)+(cg_hash(fi,73)-0.5)*1.8;if abs(x-cg_walk_x(z))<0.45 {x=x+ifx x>cg_walk_x(z) then 0.5f32 else -0.5f32;}
  gp_mesh(w[..],g[..],iw[..],root,ifx i%3==0 then "Pebble_Square_2" else "Pebble_Round_2",x,z,0.34+cg_hash(fi,74)*0.2,fi*0.9,[3]f32.[0.62,0.62,0.55]);}
 // The reference's loose stones and lower left woodland break up the path edges.
 for i:0..<12 {if experimental {continue;}fi:=f32(i);z:=-2-fi*1.7;x:=cg_road_x(z)+(ifx i%2==0 then -1.0f32 else 1.2f32);gp_mesh(w[..],g[..],iw[..],root,"Pebble_Round_1",x,z,0.3+cg_hash(fi,42)*0.2,fi,[3]f32.[0.7,0.7,0.5]);}
 for i:0..<12 {x:=-5.2+f32(i%4)*0.45;z:=-9.0-f32(i/4)*0.5;gp_mesh(w[..],g[..],iw[..],root,"Flower_2_Group",x,z,0.16+cg_hash(f32(i),61)*0.05,f32(i),[3]f32.[0.4,0.75,0.05]);}
