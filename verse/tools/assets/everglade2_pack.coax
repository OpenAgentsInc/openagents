 gp_mesh(w[..],g[..],iw[..],root,"Plant_3",1.05,1.0,0.35,0.8,[3]f32.[1,0.56,0.06]);
 // The reference's right foreground (November 7 pass): orange and red-orange leafy plants at the
 // bottom right and small stones on the near path, off the walk line. Plant_1 costs about 5 KB an
 // instance, Plant_3 about 29 KB and a bush 135 KB, so this fits the pack's 32 MiB.
 for i:0..<7 {fi:=f32(i);pos:=[7][2]f32.[[2]f32.[1.45,1.55],[2]f32.[0.85,1.9],[2]f32.[1.7,0.35],[2]f32.[2.2,1.2],[2]f32.[1.25,-0.6],[2]f32.[2.4,-1.6],[2]f32.[3.0,-2.8]];
  gp_mesh(w[..],g[..],iw[..],root,ifx i==0 then "Plant_3" else "Plant_1",pos[i][0],pos[i][1],(ifx i<2 then 0.24f32 else 0.40f32)+cg_hash(fi,71)*0.12,fi*1.3,ifx i%3==0 then [3]f32.[1,0.30,0.03] else ifx i%3==1 then [3]f32.[1,0.17,0.02] else [3]f32.[1,0.44,0.05]);}
 for i:0..<6 {fi:=f32(i);z:= -1.5-fi*1.0;x:=cg_path_x(z)+(cg_hash(fi,73)-0.5)*1.8;if abs(x-cg_walk_x(z))<0.45 {x=x+ifx x>cg_walk_x(z) then 0.5f32 else -0.5f32;}
  gp_mesh(w[..],g[..],iw[..],root,ifx i%3==0 then "Pebble_Square_2" else "Pebble_Round_2",x,z,0.34+cg_hash(fi,74)*0.2,fi*0.9,[3]f32.[0.62,0.62,0.55]);}
 // The reference's loose stones and lower left woodland break up the path edges.
 for i:0..<12 {fi:=f32(i);z:=-2-fi*1.7;x:=cg_road_x(z)+(ifx i%2==0 then -1.0f32 else 1.2f32);gp_mesh(w[..],g[..],iw[..],root,"Pebble_Round_1",x,z,0.3+cg_hash(fi,42)*0.2,fi,[3]f32.[0.7,0.7,0.5]);}
 for i:0..<12 {x:=-5.2+f32(i%4)*0.45;z:=-9.0-f32(i/4)*0.5;gp_mesh(w[..],g[..],iw[..],root,"Flower_2_Group",x,z,0.16+cg_hash(f32(i),61)*0.05,f32(i),[3]f32.[0.4,0.75,0.05]);}
 for i:0..<12 {fi:=f32(i);x:=-3.0+cg_hash(fi,62)*6.0;z:=-9.0-cg_hash(fi,63)*8.0;gp_mesh(w[..],g[..],iw[..],root,"Flower_3_Group",x,z,0.10+cg_hash(fi,64)*0.08,fi,[3]f32.[0.4,0.75,0.05]);}
 w[0].envni=w[0].ni;
 for group:0..<3 {
  w[0].grassfirst[group]=w[0].ni;name:=ifx group==0 then "Grass_Common_Short" else ifx group==1 then "Grass_Wide_Short" else "Grass_Wispy_Short";
  gp_mesh(w[..],g[..],iw[..],root,name,0,0,1,0,[3]f32.[1,1,1]);w[0].grasscount[group]=w[0].ni-w[0].grassfirst[group];
  gp_grass_seeds(w[..],0,group,ifx group==0 then 5000 else ifx group==1 then 1500 else 24000,ifx group==0 then 1.31172f32 else ifx group==1 then 1.20004f32 else 0.98610f32);
 }
 for k:0..<E2_KITS {gp_kit(w[..],g[..],iw[..],root,k);}
 cb:[4194304]u8;c:[1]Sb;c[0]=sb(cb[..]);lines_at:=0;while lines_at<cat.count {e:=lines_at;while e<cat.count && cat[e]!='\n' {e+=1;}line:=cat[lines_at..<e];lines_at=e+1;if starts(line,"bytes ") {sb_put(c[..],"bytes 0000000000\n");}else {sb_put(c[..],line);sb_byte(c[..],'\n');}}sb_put(c[..],"\nL 250 Quaternius Stylized Nature MegaKit Source|CC0 1.0 Universal|https://quaternius.com/\nC glade/environment ");sb_int(c[..],in/4);sb_byte(c[..],' ');sb_int(c[..],w[0].envni);sb_put(c[..]," 250 ");sb_int(c[..],vn/4);sb_byte(c[..],' ');sb_int(c[..],w[0].nv);sb_put(c[..]," 0\n");
 for group:0..<3 {sb_put(c[..],"C glade/grass");sb_int(c[..],group);sb_byte(c[..],' ');sb_int(c[..],in/4+w[0].grassfirst[group]);sb_byte(c[..],' ');sb_int(c[..],w[0].grasscount[group]);sb_put(c[..]," 250 ");sb_int(c[..],vn/4+w[0].seedfirst[group]*8);sb_byte(c[..],' ');sb_int(c[..],w[0].seedn[group]);sb_put(c[..]," 0\n");}
 for k:0..<E2_KITS*E2_LODS {if w[0].kcount[k]==0 {continue;}sb_put(c[..],"C e2/k");sb_int(c[..],k/E2_LODS);sb_byte(c[..],'/');sb_int(c[..],k%E2_LODS);sb_byte(c[..],' ');sb_int(c[..],in/4+w[0].kfirst[k]);sb_byte(c[..],' ');sb_int(c[..],w[0].kcount[k]);sb_put(c[..]," 250 ");sb_int(c[..],vn/4);sb_byte(c[..],' ');sb_int(c[..],w[0].nv);sb_put(c[..]," 0\n");}
 for i:0..<w[0].nt {sb_put(c[..],"T ");sb_int(c[..],w[0].layers+i);sb_put(c[..]," glade/");sb_int(c[..],i);sb_put(c[..]," 250\n");}
 lb:[1500000]u8;ln:=e2g_record_lines(rec[0..<rn],lb[..]);if ln<0 {ph_die("everglade2 ground record lines overflow");}sb_put(c[..],cast(string)lb[0..<ln]);
 count:=ne+w[0].nt;at:=32+count*48;gp_word(w[0].out[..],0,0x314b5056);put_u32(w[0].out[..],4,count);put_u32(w[0].out[..],12,E2_PACK_BUDGET);put_u32(w[0].out[..],16,32);put_u32(w[0].out[..],20,at);
 for i:0..<ne {r:=table+i*48;kind:=int(old[r]);off:=gl_u32(old,r+4);size:=gl_u32(old,r+8);start:=at;
  if kind==1 {body:=sb_text(c[..]);for ch:body {w[0].out[at]=ch;at+=1;}}
  else {for k:0..<size {w[0].out[at]=old[off+k];at+=1;}if kind==2 {for k:0..<w[0].nv*32 {w[0].out[at]=w[0].v[k];at+=1;}}if kind==3 {for k:0..<w[0].ni*4 {w[0].out[at]=w[0].i[k];at+=1;}}}
  for k:0..<48 {w[0].out[32+i*48+k]=old[r+k];}put_u32(w[0].out[..],32+i*48+4,start);put_u32(w[0].out[..],32+i*48+8,at-start);at=((at+3)/4)*4;
 }
 for i:0..<w[0].nt {start:=at;for ch:w[0].encoded[i] {w[0].out[at]=ch;at+=1;}nameb:[64]u8;s:[1]Sb;s[0]=sb(nameb[..]);sb_put(s[..],"layer");sb_int(s[..],w[0].layers+i);gp_entry(w[0].out[..],32+(ne+i)*48,4,250,sb_text(s[..]),start,at-start);at=((at+3)/4)*4;}
 // Patch the fixed-width catalog size without changing any payload offsets.
 cat_start:=gl_u32(w[0].out[..],36);cat_size:=gl_u32(w[0].out[..],40);for k:cat_start..<cat_start+cat_size-16 {if cast(string)w[0].out[k..<k+6]=="bytes " {value:=at;for j:0..<10 {w[0].out[k+15-j]=cast(u8)(48+value%10);value/=10;}break;}}
 put_u32(w[0].out[..],8,at);if at>E2_PACK_BUDGET {print("Everglade2 requires % bytes (% vertices, % triangles)\n",at,w[0].nv,w[0].ni/3);ph_die("everglade2 pack exceeds 64 MiB");}if !fs_write(args_at(args[..],2),cast(string)w[0].out[0..<at]) {return 1;}print("Everglade2: % vertices, % triangles, % textures, % bytes; ground: % tiles, % live samples, a % byte record\n",w[0].nv,w[0].ni/3,w[0].nt,at,e2g_live_set(eg[..])[0].n,e2g_live_set(eg[..])[0].live,rn);return 0;
}
