// Independent GPU readback: standard sRGB grey, preserved HDR and separated light terms.
//   coax/web/tool.sh verse/tools/assets/glade_light_check.coax [BASE]   (BASE default http://127.0.0.1:8854,
//   a static server of apps/openagents-web: coax/web/serve.sh apps/openagents-web --static --listen ...)
// Since #13066 the glade's light functions read the frame's resolved environment from the module's
// uniform block (aethyr/render/painterly.coax PAINT_ENV_U), so the probe binds a block holding the
// glade's noon record (aethyr/render/environment-frame.coax env_frame_glade_words) at its words
// (#13067): the same values a Character Create frame writes.
#import "Basic";
#load "../../../coax/lib/net/cdp.coax";
#load "../../../aethyr/render/environment-frame.coax" as envf;
#load "../../../aethyr/render/environment-debug.coax" as envd;
GLC_U_FLOATS :: 316;   // the binding's 79 vec4s (everglade/scene/gpu/charactercreator.bindings)
GLC_U_ENV :: 208;      // PAINT_ENV_U
// "[0,0,...,w208,...]": the block as a JavaScript array, the glade's record in place
glc_put :: (o: [] u8, n: int, t: string) -> int { k := n; for c: t { if k < o.count { o[k] = c; k += 1; } } return k; }
glc_block :: (o: [] u8) -> int #effects(all) {
 g := envf.env_frame_glade_words(); n := 0;
 n = glc_put(o, n, "[");
 for i: 0..<GLC_U_FLOATS {
  if i > 0 { n = glc_put(o, n, ","); }
  v: f64 = ifx i >= GLC_U_ENV && i < GLC_U_ENV + envf.ENV_FRAME_FLOATS then f64(g[i - GLC_U_ENV]) else 0;
  b: [64] u8; m := glc_number(v, b[..]); n = glc_put(o, n, cast(string) b[0..<m]);
 }
 return glc_put(o, n, "]");
}
// the glade's 18% grey through its grade, as the frame's own record gives it on the CPU
// (aethyr/render/environment-debug.coax env_debug_grade): the GPU's cg_output must agree
glc_grey :: () -> f32 #effects(all) {
 f: [1] envf.EnvFrame; u: [envf.ENV_FRAME_FLOATS] f32;
 if !envf.env_frame_write_eye(f[..], 0, 0, 1, 0, u[..], 0) { return -1; }
 return envd.env_debug_grade(f[0].held, 0.18, 0.18, 0.18).g;
}
// v with 9 decimals, rounded (f32's words survive the round trip)
glc_number :: (v: f64, o: [] u8) -> int {
 n := 0; x := v; if x < 0 { o[n] = '-'; n += 1; x = -x; }
 q := cast(s64) floor(x * 1000000000.0 + 0.5); w := q / 1000000000; f := q % 1000000000; d: [24] u8; k := 0;
 while true { d[k] = cast(u8) (48 + w % 10); k += 1; w = w / 10; if w == 0 { break; } }
 while k > 0 { k -= 1; o[n] = d[k]; n += 1; }
 o[n] = '.'; n += 1; div: s64 = 100000000;
 for i: 0..<9 { o[n] = cast(u8) (48 + (f / div) % 10); n += 1; div = div / 10; }
 return n;
}
#test "the probe's block holds the glade's record at its words and zeros elsewhere" {
 b: [16384] u8; n := glc_block(b[..]); t := cast(string) b[0..<n];
 #assert n > 316 * 2 && t[0] == '[' && t[n - 1] == ']';
 commas := 0; for c: t { if c == ',' { commas += 1; } } #assert commas == 315;
 o: [64] u8; m := glc_number(2.15, o[..]); #assert cast(string) o[0..<m] == "2.150000000";
 m = glc_number(-0.5, o[..]); #assert cast(string) o[0..<m] == "-0.500000000";
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;base:="http://127.0.0.1:8854";if args_load(a[..]) && args_count(a[..])>0 {base=args_at(a[..],0);}
 c:[1]Cdp;if !cdp_launch(c[..],640,480,"glade-light-probe-") {return 1;}defer {cdp_close(c[..]);}
 nav:[4096]u8;nn:=0;for ch:"{\"url\":\"" {nav[nn]=ch;nn+=1;}for ch:base {nav[nn]=ch;nn+=1;}for ch:"/worlds/character-creator?scene=1\"}" {nav[nn]=ch;nn+=1;}
 r:=cdp_call(c[..],"Page.enable","",30000);r=cdp_call(c[..],"Page.navigate",cast(string)nav[0..<nn],30000);
 ready:=false;for i:0..<300 {v:=cdp_evaluate(c[..],"!!globalThis.coaxial?.sceneReady");if v>=0 && jv_raw(cdp_doc(c[..]),v)=="true" {ready=true;break;}proc_sleep(100);}
 if !ready {print("FAIL light probe readiness\n");return 1;}
 blk:[16384]u8;bn:=glc_block(blk[..]);pre:[16512]u8;pn:=0;for ch:"globalThis.GLC_BLOCK=" {pre[pn]=ch;pn+=1;}for i:0..<bn {pre[pn]=blk[i];pn+=1;}pre[pn]=59;pn+=1;
 gy:=glc_grey();pn=glc_put(pre[..],pn,"globalThis.GLC_GREY=");gb:[64]u8;gm:=glc_number(f64(gy),gb[..]);pn=glc_put(pre[..],pn,cast(string)gb[0..<gm]);pre[pn]=59;pn+=1;
 bv:=cdp_evaluate(c[..],cast(string)pre[0..<pn]);if bv<0 {print("FAIL light probe block\n");return 1;}
 expression:="(async()=>{const a=await navigator.gpu.requestAdapter();const d=await a.requestDevice();const errors=[];d.addEventListener('uncapturederror',e=>errors.push(e.error.message));const code=await(await fetch('/charactercreator.wgsl')).text();const m=d.createShaderModule({code:code+\"\\n@group(3) @binding(0) var<storage,read_write> ore_probe: array<f32>;\\n@compute @workgroup_size(1) fn ore_light_probe() {\\n ore_probe[0]=coax_p_transfer_linear(0.5); ore_probe[1]=coax_p_transfer_srgb(0.21404114);\\n ore_probe[2]=coax_p_cg_output(vec3f(0.18)).x;ore_probe[3]=coax_p_cg_output(vec3f(1.0)).x;ore_probe[4]=coax_p_cg_output(vec3f(4.0)).x;\\n ore_probe[5]=coax_p_cg_air_depth(vec3f(0,1,3),vec3f(0,1,-30));\\n ore_probe[6]=coax_p_cg_air_depth(vec3f(0,20,3),vec3f(0,20,-30));\\n ore_probe[7]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,1.0,1.0).x;\\n ore_probe[8]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,0.5,1.0).x;\\n ore_probe[9]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,1.0,0.0).x;\\n ore_probe[10]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,0.5,0.0).x;\\n}\\n\"});const info=await m.getCompilationInfo();errors.push(...info.messages.filter(x=>x.type==='error').map(x=>x.message));if(errors.length)return {ok:false,errors};const p=await d.createComputePipelineAsync({layout:'auto',compute:{module:m,entryPoint:'ore_light_probe'}});const output=d.createBuffer({size:256,usage:GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_SRC});const read=d.createBuffer({size:256,usage:GPUBufferUsage.MAP_READ|GPUBufferUsage.COPY_DST});const e=d.createCommandEncoder();const c=e.beginComputePass();c.setPipeline(p);const ub=d.createBuffer({size:GLC_BLOCK.length*4,usage:GPUBufferUsage.UNIFORM|GPUBufferUsage.COPY_DST});d.queue.writeBuffer(ub,0,new Float32Array(GLC_BLOCK));c.setBindGroup(0,d.createBindGroup({layout:p.getBindGroupLayout(0),entries:[{binding:0,resource:{buffer:ub}}]}));for(let i=1;i<3;i++)c.setBindGroup(i,d.createBindGroup({layout:p.getBindGroupLayout(i),entries:[]}));c.setBindGroup(3,d.createBindGroup({layout:p.getBindGroupLayout(3),entries:[{binding:0,resource:{buffer:output}}]}));c.dispatchWorkgroups(1);c.end();e.copyBufferToBuffer(output,0,read,0,256);d.queue.submit([e.finish()]);await read.mapAsync(GPUMapMode.READ);const v=Array.from(new Float32Array(read.getMappedRange())).slice(0,11);const near=(a,b)=>Math.abs(a-b)<2e-5;const checks={srgbGrey:near(v[0],0.2140411405)&&near(v[1],0.5),gradeGrey:Math.abs(v[2]-GLC_GREY)<5e-4,hdrShoulder:v[3]<v[4]&&v[4]<=1,rawHdr:v[7]>1,heightFog:v[5]>v[6]&&v[6]>0,independentAoAndSun:near(v[7]-v[8],v[9]-v[10])&&v[7]>v[9]};read.unmap();d.destroy();return {ok:errors.length===0&&Object.values(checks).every(Boolean),checks,values:v,errors,adapter:a.info?.architecture??'unknown'}})()";
 v:=cdp_evaluate(c[..],expression);if v<0 {print("FAIL light readback\n");return 1;}
 print("%\n",jv_raw(cdp_doc(c[..]),v));ok:=jv_get(cdp_doc(c[..]),v,"ok");return ifx ok>=0 && jv_raw(cdp_doc(c[..]),ok)=="true" then 0 else 1;
}
#test "the probe's expected grey is the glade's 18% grey through its grade, about 0.511 encoded" {
 g := glc_grey(); #assert g > 0.505 && g < 0.517;
}
