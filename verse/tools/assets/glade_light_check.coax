// Independent GPU readback: standard sRGB grey, preserved HDR and separated light terms.
#import "Basic";
#load "../../../coax/lib/net/cdp.coax";
tool_main :: ()->int #export_c #effects(all) {
 c:[1]Cdp;if !cdp_launch(c[..],640,480,"glade-light-probe-") {return 1;}defer {cdp_close(c[..]);}
 r:=cdp_call(c[..],"Page.enable","",30000);r=cdp_call(c[..],"Page.navigate","{\"url\":\"http://127.0.0.1:8854/worlds/character-creator?scene=1\"}",30000);
 ready:=false;for i:0..<300 {v:=cdp_evaluate(c[..],"!!globalThis.coaxial?.sceneReady");if v>=0 && jv_raw(cdp_doc(c[..]),v)=="true" {ready=true;break;}proc_sleep(100);}
 if !ready {print("FAIL light probe readiness\n");return 1;}
 expression:="(async()=>{const a=await navigator.gpu.requestAdapter();const d=await a.requestDevice();const errors=[];d.addEventListener('uncapturederror',e=>errors.push(e.error.message));const code=await(await fetch('/charactercreator.wgsl')).text();const m=d.createShaderModule({code:code+\"\\n@group(3) @binding(0) var<storage,read_write> ore_probe: array<f32>;\\n@compute @workgroup_size(1) fn ore_light_probe() {\\n ore_probe[0]=coax_p_cg_linear(0.5); ore_probe[1]=coax_p_cg_srgb(0.21404114);\\n ore_probe[2]=coax_p_cg_shoulder(0.18);ore_probe[3]=coax_p_cg_shoulder(1.0);ore_probe[4]=coax_p_cg_shoulder(4.0);\\n ore_probe[5]=coax_p_cg_air_depth(vec3f(0,1,3),vec3f(0,1,-30));\\n ore_probe[6]=coax_p_cg_air_depth(vec3f(0,20,3),vec3f(0,20,-30));\\n ore_probe[7]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,1.0,1.0).x;\\n ore_probe[8]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,0.5,1.0).x;\\n ore_probe[9]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,1.0,0.0).x;\\n ore_probe[10]=coax_p_cg_irradiance(vec3f(0,1,0),1.0,0.5,0.0).x;\\n}\\n\"});const info=await m.getCompilationInfo();errors.push(...info.messages.filter(x=>x.type==='error').map(x=>x.message));if(errors.length)return {ok:false,errors};const p=await d.createComputePipelineAsync({layout:'auto',compute:{module:m,entryPoint:'ore_light_probe'}});const output=d.createBuffer({size:256,usage:GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_SRC});const read=d.createBuffer({size:256,usage:GPUBufferUsage.MAP_READ|GPUBufferUsage.COPY_DST});const e=d.createCommandEncoder();const c=e.beginComputePass();c.setPipeline(p);for(let i=0;i<3;i++)c.setBindGroup(i,d.createBindGroup({layout:p.getBindGroupLayout(i),entries:[]}));c.setBindGroup(3,d.createBindGroup({layout:p.getBindGroupLayout(3),entries:[{binding:0,resource:{buffer:output}}]}));c.dispatchWorkgroups(1);c.end();e.copyBufferToBuffer(output,0,read,0,256);d.queue.submit([e.finish()]);await read.mapAsync(GPUMapMode.READ);const v=Array.from(new Float32Array(read.getMappedRange())).slice(0,11);const near=(a,b)=>Math.abs(a-b)<2e-5;const checks={srgbGrey:near(v[0],0.2140411405)&&near(v[1],0.5),midtones:near(v[2],0.18),hdrShoulder:v[3]<v[4]&&v[4]<=1,rawHdr:v[7]>1,heightFog:v[5]>v[6]&&v[6]>0,independentAoAndSun:near(v[7]-v[8],v[9]-v[10])&&v[7]>v[9]};read.unmap();d.destroy();return {ok:errors.length===0&&Object.values(checks).every(Boolean),checks,values:v,errors,adapter:a.info?.architecture??'unknown'}})()";
 v:=cdp_evaluate(c[..],expression);if v<0 {print("FAIL light readback\n");return 1;}
 print("%\n",jv_raw(cdp_doc(c[..]),v));ok:=jv_get(cdp_doc(c[..]),v,"ok");return ifx ok>=0 && jv_raw(cdp_doc(c[..]),ok)=="true" then 0 else 1;
}
