// The druid's field at /druid: Everglade II's open meadow (verse/everglade2/meadow.coax) for
// Experimental's glade pack, appended the way the dragon is (dragon_pack.coax), so nothing else in
// the pack is rebuilt. The pack holds each meadow mesh once; the GPU scatters their instances over the
// field from a seeded hash, so the pack's size doesn't depend on the field's.
//
//   coax/web/tool.sh verse/tools/assets/character_glade_pack.coax --append-meadow IN.pack OUT.pack NATURE_ROOT
//
// It adds:
//
//   C glade/meadow FIRST COUNT 250 WORD NV 0
//     the ground, out to GP_MEADOW_REACH metres from the spawn along x and z on a grid whose lines are a
//     metre apart near the spawn and GP_MEADOW_FAR_STEP far out (gp_meadow_line), at the height
//     Experimental walks on (experimental-terrain.coax exp_height) less GP_MEADOW_DROP, in Everglade II's
//     meadow ground (ground.coax's meadow and autumn meadow) with its gold patches (gp_meadow_gold).
//     Kind 5 vertices on layer 0, as glade/environment's ground. Indices start at its own WORD.
//   C glade/meadowkitK FIRST COUNT 250 WORD 0 0
//     one Stylized Nature mesh, K plant.coax's E2_KIT_NAME index (GP_MEADOW_KITS), at unit scale with its
//     base at y = 0 and its footprint's middle at x = z = 0. Its vertices are glade/grass's mesh format
//     (cg_instanced_vs reads 8 words a vertex): words 0-2 the position, 3 the snorm8 normal with the
//     kind in its top byte (1 leaves, 3 flowers, 4 rocks, 7 mushrooms, 2 grass), 4 the uv, 5 the colour
//     (rgba8: white, so a leaf or a rock takes its instance's tint and a flower or a mushroom its
//     texture's own colours), 6 the texture layer, 7 the ambient (f32, the canopy's roundness on
//     leaves, else 1). Its indices start at its own WORD.
//
// The ground is baked from exp_height, so it goes stale when a site moves (#13129: the housewright
// showcase's yards moved and the grass, placed by the GPU from today's exp_height, floated over the old
// ground). Bake it again in place, check it, and write the samples the terrain's own check reads:
//
//   coax/web/tool.sh verse/tools/assets/character_glade_pack.coax --replace-meadow IN.pack OUT.pack
//     the ground's vertices written again from exp_height, where they are (the grid doesn't change, so
//     nothing else in the pack moves); it refuses a pack with no meadow.
//   coax/web/tool.sh verse/tools/assets/character_glade_pack.coax --check-meadow IN.pack [SAMPLES.coax]
//     every packed ground vertex against exp_height; it fails when one is more than GP_MEADOW_DRIFT
//     off. With SAMPLES.coax (verse/experimental-meadow-baked.coax), it writes the packed heights at
//     sampled points (gp_meadow_samples), which experimental-terrain.coax's check holds exp_height to.
//
// It reuses the pack's L 250 (Quaternius Stylized Nature MegaKit Source, CC0) and its texture
// layers: each mesh's texture is found among the pack's layers by its encoded bytes.
#load "../../everglade2/plant.coax";
#load "../../experimental-terrain.coax" as xterrain;

GP_MEADOW_KITS :: [11]int.[20,21,22,25,26,27,28,29,30,31,33];
GP_MEADOW_REACH :: 608;         // m: the ground runs this far from the spawn along x and z
GP_MEADOW_FAR_STEP :: 16;       // m: its grid's step far out
GP_MEADOW_DROP :: 0.01;         // m: the ground sits this far under exp_height (the old ground: 0.035)
GP_MEADOW_LINES :: 301;         // grid lines along each axis (gp_meadow_line)
GP_MK_V :: 1400; GP_MK_I :: 5100;

// The grid's i-th line from the west (or the north), metres from the spawn: a metre apart out to 64 m,
// then 2 m to 128, 4 m to 256, and GP_MEADOW_FAR_STEP to GP_MEADOW_REACH.
gp_meadow_line :: (i:int)->f32 {
 k:=i-150;a:=ifx k<0 then -k else k;s:=ifx k<0 then -1.0f32 else 1.0f32;
 d:=ifx a<=64 then a else ifx a<=96 then 64+(a-64)*2 else ifx a<=128 then 128+(a-96)*4 else 256+(a-128)*GP_MEADOW_FAR_STEP;
 return s*f32(d);
}
#test "the meadow ground's grid runs from the spawn to the horizon, finer near the spawn" {
 #assert gp_meadow_line(150)==0 && gp_meadow_line(0)== -f32(GP_MEADOW_REACH) && gp_meadow_line(GP_MEADOW_LINES-1)==f32(GP_MEADOW_REACH);
 for i:1..<GP_MEADOW_LINES {d:=gp_meadow_line(i)-gp_meadow_line(i-1);#assert d>=1 && d<=f32(GP_MEADOW_FAR_STEP);#assert gp_meadow_line(i)== -gp_meadow_line(GP_MEADOW_LINES-1-i);}
 #assert gp_meadow_line(151)-gp_meadow_line(150)==1 && gp_meadow_line(300)-gp_meadow_line(299)==16;
}

// Autumn on the field as Everglade II has it outside the glade (forest.coax e2_gold): patches of gold
// in green, from its noise. (The glade's own cg_autumn would split the field in two.)
gp_meadow_gold :: (x:f32,z:f32)->f32 {return e2_smooth(0.40,0.62,e2_noise(x/60+3.1,z/60-1.7))*0.3;}
// The ground's colour: ground.coax's meadow (0.32, 0.53, 0.055) turning to autumn meadow (0.56, 0.50,
// 0.055) by the gold (meadow.coax e2_meadow_weights).
gp_meadow_colour :: (x:f32,z:f32)->[3]f32 {a:=gp_meadow_gold(x,z);return [3]f32.[0.32*(1-a)+0.56*a,0.53*(1-a)+0.50*a,0.055];}
#test "the meadow's ground is green with gentle gold patches" {
 lo:f32=1;hi:f32=0;for i:0..<400 {c:=gp_meadow_colour(f32(i%20)*30-300,f32(i/20)*30-300);if c[0]<lo {lo=c[0];}if c[0]>hi {hi=c[0];}#assert c[1]>0.5 && c[1]<=0.53;}
 #assert lo>=0.3199 && hi<=0.3921 && hi>lo;
}

gp_meadow_ground :: (w:[]Gp) {
 first:=w[0].nv;n:=GP_MEADOW_LINES;
 for iz:0..<n {z:= -gp_meadow_line(iz);for ix:0..<n {x:=gp_meadow_line(ix);y:=xterrain.exp_height(x,z)-GP_MEADOW_DROP;
  dx:=(xterrain.exp_height(x+0.1,z)-xterrain.exp_height(x-0.1,z))/0.2;dz:=(xterrain.exp_height(x,z+0.1)-xterrain.exp_height(x,z-0.1))/0.2;l:=sqrt(dx*dx+1+dz*dz);
  id:=gp_v(w,[3]f32.[x,y,z],[3]f32.[-dx/l,1/l,-dz/l],[2]f32.[0.5,0.5],gp_meadow_colour(x,z),0,5);
 }}
 for iz:0..<n-1 {for ix:0..<n-1 {a:=first+iz*n+ix;gp_tri(w,a,a+1,a+n);gp_tri(w,a+1,a+n+1,a+n);}}
}

// The pack layer whose bytes are this texture's (layer_bytes as gp_texture makes it), or -1.
gp_meadow_layer :: (w:[]Gp,cache:[]int,src:[]u8,entries:int,path:string,iw:[]ImgWork)->int {
 for i:0..<w[0].nt {if w[0].tex[i]==path {return cache[i];}}
 side:=ifx ends(path,"/Leaves.png") then 1024 else 512;bytes:=layer_bytes(path,side,false,iw);
 table:=gl_u32(src,16);ordinal:=0;found:=-1;
 for q:0..<entries {row:=table+q*48;if src[row]!=4 {continue;}off:=gl_u32(src,row+4);n:=gl_u32(src,row+8);
  if found<0 && n==bytes.count {same:=true;for b:0..<n {if src[off+b]!=bytes[b] {same=false;break;}}if same {found=ordinal;}}
  ordinal+=1;}
 if found<0 {return -1;}
 i:=w[0].nt;w[0].tex[i]=txt_keep(w[0].txt[..],path);cache[i]=found;w[0].nt+=1;return found;
}
// One kit mesh, read as gp_mesh_scaled reads it at the origin (kinds, layers, the canopy's normals
// and ambient), then moved so its base is at y = 0 and its footprint's middle at x = z = 0. Its
// vertices go to w from w[0].nv; its indices count from its own first vertex. The vertex count, or -1.
gp_meadow_kit :: (w:[]Gp,kit:int,g:[]Gltf,iw:[]ImgWork,root:string,cache:[]int,src:[]u8,entries:int,shift:[]f32)->int {
 name:=E2_KIT_NAME[kit];path:=txt_cat3(w[0].txt[..],root,"/glTF/",txt_cat(w[0].txt[..],name,".gltf"));gl_load(g,path);
 p:[GP_MK_V*3]f32;nn:[GP_MK_V*3]f32;uvs:[GP_MK_V*2]f32;kinds:[GP_MK_V]int;layers:[GP_MK_V]int;amb:[GP_MK_V]f32;ix:[GP_MK_I]int;nv_all:=0;ni_all:=0;
 for mi:0..<g[0].nx[GA_MESH] {mesh:=gl_at(g,GA_MESH,mi);prims:=gl_get(g,mesh,"primitives");for pi:0..<jv_len(g[0].d[0],prims) {
  pr:=jv_at(g[0].d[0],prims,pi);attr:=gl_get(g,pr,"attributes");pos:[196608]f64;nor:[196608]f64;uv:[131072]f64;idx:[262144]f64;
  nv:=gl_acc(g,gl_int(g,attr,"POSITION",0),pos[..]).count;r:=gl_acc(g,gl_int(g,attr,"NORMAL",0),nor[..]);r=gl_acc(g,gl_int(g,attr,"TEXCOORD_0",0),uv[..]);ni:=gl_acc(g,gl_int(g,pr,"indices",0),idx[..]).count;
  mat:=gl_at(g,GA_MAT,gl_int(g,pr,"material",0));mn:=gl_str(g,mat,"name");kind:=ifx starts(mn,"Bark") then 6 else ifx has(mn,"Leaves") then 1 else ifx has(mn,"Flower") then 3 else ifx mn=="Grass" then 2 else ifx has(mn,"Rocks") then 4 else ifx has(mn,"Mushroom") then 7 else 0;
  tex:=gl_get(g,gl_get(g,mat,"pbrMetallicRoughness"),"baseColorTexture");im:=gl_at(g,GA_IMG,gl_int(g,gl_at(g,GA_TEX,gl_int(g,tex,"index",0)),"source",0));image:=txt_cat3(w[0].txt[..],root,"/glTF/",gl_str(g,im,"uri"));
  layer:=gp_meadow_layer(w,cache,src,entries,image,iw);if layer<0 {tool_errln(txt_cat(w[0].txt[..],"meadow texture is not among the pack's layers: ",image));return -1;}
  lo:=[3]f32.[10000,10000,10000];hi:=[3]f32.[-10000,-10000,-10000];
  if kind==1 {for v:0..<nv {for c:0..<3 {q:=f32(pos[v*3+c]);if q<lo[c] {lo[c]=q;}if q>hi[c] {hi[c]=q;}}}}
  if nv_all+nv>GP_MK_V || ni_all+ni>GP_MK_I {ph_die("meadow kit mesh overflows its template");}
  for v:0..<nv {nx:=f32(nor[v*3]);ny:=f32(nor[v*3+1]);nz:=f32(nor[v*3+2]);ambient:f32=1;
   if kind==1 {
    cx:=(lo[0]+hi[0])*0.5;cy:=(lo[1]+hi[1])*0.5;cz:=(lo[2]+hi[2])*0.5;
    rx:=(f32(pos[v*3])-cx)/gp_clamp((hi[0]-lo[0])*0.5,0.1,100);ry:=(f32(pos[v*3+1])-cy)/gp_clamp((hi[1]-lo[1])*0.5,0.1,100);rz:=(f32(pos[v*3+2])-cz)/gp_clamp((hi[2]-lo[2])*0.5,0.1,100);
    radius:=sqrt(rx*rx+ry*ry+rz*rz);ambient=gp_clamp(0.70+radius*0.25,0.7,1);rounded:=cg_canopy_normal(rx,ry,rz);
    blended:=cg_canopy_normal(rounded[0]*0.90+nx*0.10,rounded[1]*0.90+ny*0.10,rounded[2]*0.90+nz*0.10);nx=blended[0];ny=blended[1];nz=blended[2];
   }
   at:=nv_all+v;for c:0..<3 {p[at*3+c]=f32(pos[v*3+c]);}nn[at*3]=nx;nn[at*3+1]=ny;nn[at*3+2]=nz;
   uvs[at*2]=f32(uv[v*2]);uvs[at*2+1]=f32(uv[v*2+1]);kinds[at]=kind;layers[at]=layer;amb[at]=ambient;
  }
  for t:0..<ni {ix[ni_all+t]=nv_all+int(idx[t]);}
  nv_all+=nv;ni_all+=ni;
 }}
 if nv_all==0 || ni_all%3!=0 {return -1;}
 // the base and the footprint's middle
 lo:=[3]f32.[10000,10000,10000];hi:=[3]f32.[-10000,-10000,-10000];
 for v:0..<nv_all {for c:0..<3 {q:=p[v*3+c];if q<lo[c] {lo[c]=q;}if q>hi[c] {hi[c]=q;}}}
 shift[0]=(lo[0]+hi[0])*0.5;shift[1]=lo[1];shift[2]=(lo[2]+hi[2])*0.5;
 first:=w[0].nv;
 for v:0..<nv_all {id:=gp_v(w,[3]f32.[p[v*3]-shift[0],p[v*3+1]-shift[1],p[v*3+2]-shift[2]],[3]f32.[nn[v*3],nn[v*3+1],nn[v*3+2]],[2]f32.[uvs[v*2],uvs[v*2+1]],[3]f32.[1,1,1],layers[v],kinds[v]);gp_word(w[0].v[..],id*32+28,f32_bits(amb[v]));}
 for t:0..<ni_all/3 {gp_tri(w,ix[t*3],ix[t*3+1],ix[t*3+2]);}
 return w[0].nv-first;
}

// ---- baking the ground again, and checking it (#13129)
GP_MEADOW_DRIFT :: 0.002;       // m: a packed ground vertex may be this far off exp_height less the drop
GP_MEADOW_SAMPLE_STEP :: 15;    // every so many grid lines each way is a sample, with each site's middle and corners
// Field k (from 0, split by spaces) of a catalog line as a number, or -1.
gp_meadow_field :: (line:string,k:int)->int {
 at:=0;f:=0;
 while at<line.count {
  while at<line.count && line[at]==' ' {at+=1;}
  from:=at;while at<line.count && line[at]!=' ' {at+=1;}
  if f==k {if at==from {return -1;}v:=0;for i:from..<at {c:=line[i];if c<'0' || c>'9' {return -1;}v=v*10+cast(int)(c-'0');}return v;}
  f+=1;
 }
 return -1;
}
#test "a catalog line's fields" {
 l:="C glade/meadow 1200 540000 250 96000 90601 0";
 #assert gp_meadow_field(l,2)==1200 && gp_meadow_field(l,5)==96000 && gp_meadow_field(l,6)==90601 && gp_meadow_field(l,7)==0;
 #assert gp_meadow_field(l,1)== -1 && gp_meadow_field(l,8)== -1 && gp_meadow_field("",0)== -1;
}
// Where a pack keeps the meadow's ground: the byte its first vertex starts at, and how many vertices.
GpMeadowAt :: struct {ok:bool;at:int;nv:int;}
gp_meadow_at :: (src:[]u8,size:int)->GpMeadowAt {
 if size<32 || cast(string)src[0..<4]!="VPK1" || gl_u32(src,8)!=size {return GpMeadowAt.{};}
 table:=gl_u32(src,16);entries:=gl_u32(src,4);
 if table!=32 || entries<3 || entries>(size-table)/48 || src[table]!=1 || src[table+48]!=2 {return GpMeadowAt.{};}
 cat_at:=gl_u32(src,table+4);cat_n:=gl_u32(src,table+8);v_at:=gl_u32(src,table+52);v_n:=gl_u32(src,table+56);
 if cat_at>size || cat_n>size-cat_at || v_at>size || v_n>size-v_at {return GpMeadowAt.{};}
 cat:=cast(string)src[cat_at..<cat_at+cat_n];at:=0;
 while at<cat.count {
  end:=at;while end<cat.count && cat[end]!='\n' {end+=1;}
  line:=cat[at..<end];
  if starts(line,"C glade/meadow ") {
   word:=gp_meadow_field(line,5);nv:=gp_meadow_field(line,6);
   if word<0 || nv!=GP_MEADOW_LINES*GP_MEADOW_LINES || word*4+nv*32>v_n {return GpMeadowAt.{};}
   return GpMeadowAt.{ok=true,at=v_at+word*4,nv=nv};
  }
  at=end+1;
 }
 return GpMeadowAt.{};
}
gp_meadow_f32 :: (b:[]u8,at:int)->f32 {return f32_from_bits(cast(u32)gl_u32(b,at));}
// The ground baked again where it is: every vertex of glade/meadow written from today's exp_height.
gp_replace_meadow :: (input:string,output:string)->int {
 w:[1]Gp;src:=w[0].out[..];
 size:=fs_read(input,src);
 m:=gp_meadow_at(src,size);
 if !m.ok {tool_errln("the pack holds no meadow ground to replace (--append-meadow adds one)");return 1;}
 gp_meadow_ground(w[..]);
 if w[0].nv!=m.nv {tool_errln("meadow ground count mismatch");return 1;}
 moved:=0;most:f32=0;
 for v:0..<m.nv {
  d:=abs(gp_meadow_f32(w[0].v[..],v*32+4)-gp_meadow_f32(src,m.at+v*32+4));
  if d>f32(GP_MEADOW_DRIFT) {moved+=1;}if d>most {most=d;}
  for b:0..<32 {src[m.at+v*32+b]=w[0].v[v*32+b];}
 }
 if !fs_write(output,cast(string)src[0..<size]) {return 1;}
 print("Meadow ground baked again: % of % vertices moved, the most by % m\n",moved,m.nv,most);
 print("% (% bytes)\n",output,size);
 return 0;
}
// The grid line nearest v metres from the spawn.
gp_meadow_near :: (v:f32)->int {best:=0;for i:1..<GP_MEADOW_LINES {if abs(gp_meadow_line(i)-v)<abs(gp_meadow_line(best)-v) {best=i;}}return best;}
// The sampled grid points, as (line along x, line along z) pairs into out: every GP_MEADOW_SAMPLE_STEP-th
// line each way, then the grid point nearest each site's middle and its four corners. How many.
gp_meadow_samples :: (out:[][2]int)->int {
 n:=0;
 iz:=0;while iz<GP_MEADOW_LINES {ix:=0;while ix<GP_MEADOW_LINES {if n<out.count {out[n]=[2]int.[ix,iz];n+=1;}ix+=GP_MEADOW_SAMPLE_STEP;}iz+=GP_MEADOW_SAMPLE_STEP;}
 for i:0..<xterrain.EXP_SITES {s:=xterrain.exp_site(i);
  for c:[5][2]f32.[[2]f32.[s.x,s.z],[2]f32.[s.x-s.left,s.z-s.back],[2]f32.[s.x+s.right,s.z-s.back],[2]f32.[s.x-s.left,s.z+s.front],[2]f32.[s.x+s.right,s.z+s.front]] {
   // the ground's rows run north to south: row iz is at z = -gp_meadow_line(iz) (gp_meadow_ground)
   if n<out.count {out[n]=[2]int.[gp_meadow_near(c[0]),gp_meadow_near(-c[1])];n+=1;}
  }
 }
 return n;
}
#test "the meadow's samples cover the grid and every site" {
 #assert gp_meadow_near(0)==150 && gp_meadow_near(0.4)==150 && gp_meadow_near(-1.6)==148 && gp_meadow_near(900)==GP_MEADOW_LINES-1;
 p:[1024][2]int;n:=gp_meadow_samples(p[..]);
 #assert n==21*21+xterrain.EXP_SITES*5;
 for i:0..<n {#assert p[i][0]>=0 && p[i][0]<GP_MEADOW_LINES && p[i][1]>=0 && p[i][1]<GP_MEADOW_LINES;}
}
gp_meadow_mm :: (v:f32)->int {t:=v*1000;return ifx t<0 then -cast(int)(-t+0.5) else cast(int)(t+0.5);}
// Every packed ground vertex against exp_height; with `samples`, the packed heights at the sampled
// points written as Coax for verse/experimental-terrain.coax's check.
gp_check_meadow :: (input:string,samples:string)->int {
 w:[1]Gp;src:=w[0].out[..];
 size:=fs_read(input,src);
 m:=gp_meadow_at(src,size);
 if !m.ok {tool_errln("the pack holds no meadow ground");return 1;}
 n:=GP_MEADOW_LINES;drift:=0;most:f32=0;mx:f32=0;mz:f32=0;
 for v:0..<m.nv {
  o:=m.at+v*32;x:=gp_meadow_f32(src,o);y:=gp_meadow_f32(src,o+4);z:=gp_meadow_f32(src,o+8);
  d:=abs(xterrain.exp_height(x,z)-GP_MEADOW_DROP-y);
  if d>f32(GP_MEADOW_DRIFT) {drift+=1;}if d>most {most=d;mx=x;mz=z;}
 }
 print("Meadow ground: % of % vertices are more than % m off exp_height; the most is % m, at (%, %)\n",drift,m.nv,GP_MEADOW_DRIFT,most,mx,mz);
 if drift>0 {tool_errln("the packed meadow ground has drifted from exp_height: bake it again with --replace-meadow (verse/tools/assets/meadow_pack.coax)");return 1;}
 if samples.count==0 {return 0;}
 pts:[1024][2]int;np:=gp_meadow_samples(pts[..]);
 text:[65536]u8;c:[1]Sb;c[0]=sb(text[..]);
 sb_put(c[..],"// The packed meadow ground's heights at sampled points (GitHub #13129): written from\n");
 sb_put(c[..],"// apps/openagents-web/realms/everglade-experimental/assets/glade.pack.gz by\n");
 sb_put(c[..],"//   coax/web/tool.sh verse/tools/assets/character_glade_pack.coax --check-meadow glade.pack verse/experimental-meadow-baked.coax\n");
 sb_put(c[..],"// (verse/tools/assets/meadow_pack.coax). Don't edit it: bake the ground again and write it again.\n");
 sb_put(c[..],"// Each row is x, z and the packed y, in millimetres. experimental-terrain.coax holds exp_height to them.\n");
 sb_put(c[..],"#module \"verse.experimentalmeadowbaked\";\n");
 sb_put(c[..],"EXP_MEADOW_BAKED_DROP_MM :: ");sb_int(c[..],gp_meadow_mm(GP_MEADOW_DROP));sb_put(c[..],";   // the ground sits this far under exp_height\n");
 sb_put(c[..],"EXP_MEADOW_BAKED_N :: ");sb_int(c[..],np);sb_put(c[..],";\n");
 sb_put(c[..],"EXP_MEADOW_BAKED :: [");sb_int(c[..],np*3);sb_put(c[..],"] int.[\n");
 for i:0..<np {
  o:=m.at+(pts[i][1]*n+pts[i][0])*32;
  sb_byte(c[..],' ');sb_int(c[..],gp_meadow_mm(gp_meadow_f32(src,o)));sb_byte(c[..],',');sb_int(c[..],gp_meadow_mm(gp_meadow_f32(src,o+8)));sb_byte(c[..],',');sb_int(c[..],gp_meadow_mm(gp_meadow_f32(src,o+4)));
  sb_put(c[..],ifx i==np-1 then "\n" else ifx i%6==5 then ",\n" else ",");
 }
 sb_put(c[..],"];\n");
 if c[0].n>=text.count || !fs_write(samples,sb_text(c[..])) {tool_errln("the samples weren't written");return 1;}
 print("% (% samples)\n",samples,np);
 return 0;
}

gp_append_meadow :: (input:string,output:string,root:string)->int {
  w:[1]Gp; src:=w[0].out[..];
  size:=fs_read(input,src);
  if size<32 || cast(string)src[0..<4]!="VPK1" || gl_u32(src,8)!=size { return 1; }
  table:=gl_u32(src,16); entries:=gl_u32(src,4);
  if table!=32 || entries<3 || entries>(size-table)/48 { return 1; }
  start:=table+entries*48;
  vc:=table+48; ic:=table+96;
  if src[table]!=1 || src[vc]!=2 || src[ic]!=3 { return 1; }
  vertex_bytes:=gl_u32(src,vc+8); index_bytes:=gl_u32(src,ic+8);
  if vertex_bytes%32!=0 || index_bytes%4!=0 { return 1; }
  for q:0..<entries {
    row:=table+q*48; off:=gl_u32(src,row+4); n:=gl_u32(src,row+8);
    if off<start || off>size || n>size-off { return 1; }
  }
  cat_at:=gl_u32(src,table+4); cat_n:=gl_u32(src,table+8);
  cat:=cast(string)src[cat_at..<cat_at+cat_n];
  size_at:=-1; at:=0; licensed:=false;
  while at<cat.count {
    end:=at;
    while end<cat.count && cat[end]!='\n' { end+=1; }
    line:=cat[at..<end];
    if starts(line,"C glade/meadow") { tool_errln("pack already contains the meadow (--replace-meadow bakes its ground again)"); return 1; }
    if starts(line,"L 250 ") { licensed=true; }
    if starts(line,"bytes ") && line.count==16 { size_at=at+6; }
    at=end+1;
  }
  if size_at<0 || !licensed { tool_errln("pack lacks its size line or L 250"); return 1; }
  // the ground
  gp_meadow_ground(w[..]); ground_nv:=w[0].nv; ground_ni:=w[0].ni;
  if ground_nv!=GP_MEADOW_LINES*GP_MEADOW_LINES || ground_ni!=(GP_MEADOW_LINES-1)*(GP_MEADOW_LINES-1)*6 { tool_errln("meadow ground count mismatch"); return 1; }
  // the kits, each with its own first vertex and first index
  g:[1]Gltf; iw:[1]ImgWork; cache:[128]int;
  vfirst:[11]int; vcount:[11]int; ifirst:[11]int; icount:[11]int; shifts:[11][3]f32;
  for k:0..<11 {
    vfirst[k]=w[0].nv; ifirst[k]=w[0].ni;
    vcount[k]=gp_meadow_kit(w[..],GP_MEADOW_KITS[k],g[..],iw[..],root,cache[..],src,entries,shifts[k][..]);
    if vcount[k]<1 { tool_errln("a meadow kit mesh is missing or malformed"); return 1; }
    icount[k]=w[0].ni-ifirst[k];
    // the check: unit scale, base at 0, footprint centred, every index inside its own mesh
    lo:=[3]f32.[10000,10000,10000];hi:=[3]f32.[-10000,-10000,-10000];
    for v:vfirst[k]..<w[0].nv {for c:0..<3 {q:=f32_from_bits(cast(u32)gl_u32(w[0].v[..],v*32+c*4));if q<lo[c] {lo[c]=q;}if q>hi[c] {hi[c]=q;}}}
    if abs(lo[1])>0.0001 || abs(lo[0]+hi[0])>0.0002 || abs(lo[2]+hi[2])>0.0002 { tool_errln("a meadow kit mesh is not on its pivot"); return 1; }
    for q:ifirst[k]..<w[0].ni { if gl_u32(w[0].i[..],q*4)>=vcount[k] { tool_errln("a meadow kit index leaves its mesh"); return 1; } }
  }
  extra:[4096]u8; c:[1]Sb; c[0]=sb(extra[..]);
  sb_put(c[..],"\nC glade/meadow "); sb_int(c[..],index_bytes/4); sb_byte(c[..],' '); sb_int(c[..],ground_ni); sb_put(c[..]," 250 "); sb_int(c[..],vertex_bytes/4); sb_byte(c[..],' '); sb_int(c[..],ground_nv); sb_put(c[..]," 0\n");
  for k:0..<11 {
    sb_put(c[..],"C glade/meadowkit"); sb_int(c[..],GP_MEADOW_KITS[k]); sb_byte(c[..],' '); sb_int(c[..],index_bytes/4+ifirst[k]); sb_byte(c[..],' '); sb_int(c[..],icount[k]);
    sb_put(c[..]," 250 "); sb_int(c[..],vertex_bytes/4+vfirst[k]*8); sb_put(c[..]," 0 0\n");
  }
  appendix:=sb_text(c[..]);
  out:[536870912]u8;
  new_size:=size+appendix.count+w[0].nv*32+w[0].ni*4+4;
  if new_size>out.count || new_size>gl_u32(src,12) { tool_errln("the meadow exceeds the pack budget"); return 1; }
  for i:0..<start { out[i]=src[i]; }
  pos:=start;
  for q:0..<entries {
    row:=table+q*48; off:=gl_u32(src,row+4); nb:=gl_u32(src,row+8);
    here:=pos;
    for i:0..<nb { out[pos]=src[off+i]; pos+=1; }
    if q==0 { for ch:appendix { out[pos]=ch; pos+=1; } }
    if q==1 { for i:0..<w[0].nv*32 { out[pos]=w[0].v[i]; pos+=1; } }
    if q==2 { for i:0..<w[0].ni*4 { out[pos]=w[0].i[i]; pos+=1; } }
    put_u32(out[..],row+4,here);
    put_u32(out[..],row+8,pos-here);
    pos=((pos+3)/4)*4;
  }
  put_u32(out[..],8,pos);
  value:=pos;
  for i:0..<10 { out[start+size_at+9-i]=cast(u8)(48+value%10); value/=10; }
  if !fs_write(output,cast(string)out[0..<pos]) { return 1; }
  print("Meadow ground: % vertices, % triangles\n",ground_nv,ground_ni/3);
  for k:0..<11 { print("meadowkit% %: % vertices, % triangles, pivot moved by (%, %, %)\n",GP_MEADOW_KITS[k],E2_KIT_NAME[GP_MEADOW_KITS[k]],vcount[k],icount[k]/3,shifts[k][0],shifts[k][1],shifts[k][2]); }
  print("% (% bytes, % before)\n",output,pos,size);
  return 0;
}
