// An object becomes visible only after its complete bytes hash correctly. Never
// repair an existing corrupted object silently or replace a live identical one.
ar_object_copy :: (source:string,target:string,expected:string)->bool {
 if expected.count!=64 {return false;}
 if fs_exists(target) {hb:[64]u8;return ar_sha(target,hb[..])==expected;}
 db:[4096]u8;dir:=fs_temp("oa-asset-object-",db[..]);if dir=="" {return false;}pb:[4096]u8;temp:=fs_join(dir,"blob",pb[..]);cp:=[3]string.["/bin/cp",source,temp];if !ar_run(cp[..]) {return false;}
 hb:[64]u8;if ar_sha(temp,hb[..])!=expected {removed:=fs_remove(dir);return false;}
 mode:=[3]string.["/bin/chmod","a-w",temp];if !ar_run(mode[..]) || !fs_rename(temp,target) {removed:=fs_remove(dir);return false;}
 return fs_remove(dir);
}
ar_object_text :: (target:string,body:string)->bool {
 hb:[64]u8;expected:=ar_digest(body,hb[..]);if expected=="" {return false;}
 if fs_exists(target) {got:[64]u8;return ar_sha(target,got[..])==expected;}
 db:[4096]u8;dir:=fs_temp("oa-asset-definition-",db[..]);if dir=="" {return false;}pb:[4096]u8;temp:=fs_join(dir,"definition",pb[..]);if !fs_write(temp,body) {return false;}
 ok:=ar_object_copy(temp,target,expected);removed:=fs_remove(dir);return ok && removed;
}
