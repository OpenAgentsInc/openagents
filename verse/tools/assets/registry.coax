// Shared authoring catalog. SDK observations come from blender_bridge.py; identity,
// snapshots, registration, collections and generated Coax references live here.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/proc.coax";
#load "../../../coax/lib/json/json.coax";
#load "../../../coax/lib/crypto/sha256-kernel.coax";

#test "registry IDs are stable names, not paths or runtime content IDs" {
  b:[256]u8;
  #assert ar_slug("Female_Ranger_Body",b[..])=="female-ranger-body";
  #assert ar_slug("Tree.001",b[..])=="tree-001";
  #assert ar_relative("Blends/All models.blend") && !ar_relative("../x") && !ar_relative("/x") && !ar_relative("a/../x");
  #assert !ar_relative("a\\b") && !ar_relative("a\nb");
}
#test "registry hashing and malformed observations" {
  b:[64]u8;#assert ar_digest("abc",b[..])=="ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
  #assert ar_id("quaternius/nature/tree-01") && !ar_id("../tree") && !ar_id("Tree") && !ar_id("a//b");
}
ar_relative :: (s:string)->bool {
  if s.count==0 || s[0]=='/' {return false;}
  at:=0;
  for i:0..<s.count+1 {if i==s.count || s[i]=='/' {if i==at || s[at..<i]==".." || s[at..<i]=="." {return false;}at=i+1;}else if s[i]<32 || s[i]=='\\' {return false;}}
  return true;
}
ar_id :: (s:string)->bool {
  if !ar_relative(s) {return false;}
  for c:s {if !((c>='a' && c<='z') || (c>='0' && c<='9') || c=='-' || c=='/') {return false;}}
  return true;
}
ar_slug :: (s:string,b:[]u8)->string {
  n:=0;for c0:s {c:=c0;if c>='A' && c<='Z' {c+=32;}if !((c>='a' && c<='z') || (c>='0' && c<='9')) {c='-';}if c=='-' && (n==0 || b[n-1]=='-') {continue;}if n>=b.count {return "";}b[n]=c;n+=1;}
  if n>0 && b[n-1]=='-' {n-=1;}return cast(string)b[0..<n];
}
ar_cat :: (a:string,b:string,out:[]u8)->string {if a.count+b.count>out.count {return "";}for i:0..<a.count {out[i]=a[i];}for i:0..<b.count {out[a.count+i]=b[i];}return cast(string)out[0..<a.count+b.count];}
ar_digest :: (s:string,b:[]u8)->string {d:=S_hash(s);if !S_hex(d,b) {return "";}return cast(string)b[0..<64];}
ar_run :: (a:[]string)->bool {o:[65536]u8;e:[65536]u8;r:=proc_run(a,840000,o[..],e[..]);if r.status!=0 || r.started!=0 || r.timed_out {tool_err(cast(string)o[0..<r.out_n]);tool_err(cast(string)e[0..<r.err_n]);return false;}return true;}
ar_sha :: (path:string,b:[]u8)->string {
  a:=[4]string.["/usr/bin/shasum","-a","256",path];o:[8192]u8;e:[8192]u8;r:=proc_run(a[..],60000,o[..],e[..]);
  if r.started!=0 || r.status!=0 || r.timed_out || r.cut || r.out_n<64 {return "";}
  for i:0..<64 {b[i]=o[i];}return cast(string)b[0..<64];
}
ar_string :: (d:Jv,node:int,key:string,b:[]u8)->string {n:=jv_str(d,jv_get(d,node,key),b);if n<0 {return "";}return cast(string)b[0..<n];}
ar_kstr :: (o:[]Jo,key:string,value:string) {jo_key(o,key);jo_str(o,value);}
ar_file :: (path:string,body:string)->bool {b:[4096]u8;tmp:=ar_cat(path,".tmp",b[..]);return fs_write(tmp,body) && fs_rename(tmp,path);}

// Exact sorted file inventory. Reject links/special files rather than follow outside the package.
ar_inventory :: (root:string,rel:string,o:[]Jo,depth:int)->bool {
  if depth>24 {return false;}
  p:[4096]u8;dir:=ifx rel=="" then root else fs_join(root,rel,p[..]);
  list:[1]FsList;n:=fs_list(dir,list[..]);if n<0 || list[0].full {return false;}
  for i:0..<n {name:=fs_entry(list[..],i);if name==".DS_Store" {continue;}
    rb:[4096]u8;r:=ifx rel=="" then name else fs_join(rel,name,rb[..]);if !ar_relative(r) {return false;}
    pb:[4096]u8;path:=fs_join(root,r,pb[..]);kind:=fs_kind(path);
    // realpath must equal its lexical absolute path: symlinks are not imported.
    real:[4096]u8;if fs_realpath(path,real[..])!=path {return false;}
    if kind==FS_DIR {if !ar_inventory(root,r,o,depth+1) {return false;}}
    else if kind==FS_FILE {h:[64]u8;sha:=ar_sha(path,h[..]);if sha=="" {return false;}
      jo_obj(o);ar_kstr(o,"path",r);ar_kstr(o,"sha256",sha);jo_key(o,"bytes");jo_int(o,fs_size(path));jo_end(o);
    }else {return false;}
  }
  return !o[0].bad;
}
ar_import :: (source:string,pkg:string,store:string)->bool {
  if !ar_id(pkg) {return false;}
  rb:[4096]u8;root:=fs_realpath(source,rb[..]);if root=="" {return false;}
  licensep:[4096]u8;licensepath:=fs_join(root,"License_Source.txt",licensep[..]);licenseb:[16384]u8;licensen:=fs_read(licensepath,licenseb[..]);if licensen<0 || !ar_contains(cast(string)licenseb[0..<licensen],"CC0 1.0") {return false;}
  sb:[4096]u8;originals:=fs_join(store,"originals",sb[..]);if !fs_mkdir(originals) {return false;}
  lb:[4096]u8;lock:=fs_join(store,"import.lock",lb[..]);if !fs_try_lock(lock) {return false;}
  tb:[4096]u8;stage:=fs_join(originals,".staging",tb[..]);if fs_exists(stage) {tool_errln("Interrupted import: inspect originals/.staging before retrying");return false;}
  if !fs_mkdir(stage) {return false;}
  db:[4096]u8;dest:=fs_join(stage,"source",db[..]);cp:=[4]string.["/bin/cp","-R",root,dest];if !ar_run(cp[..]) {return false;}
  bytes:[8388608]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_obj(o[..]);ar_kstr(o[..],"schema","oa-source-package-v1");ar_kstr(o[..],"package",pkg);ar_kstr(o[..],"license","CC0-1.0");ar_kstr(o[..],"license_evidence","License_Source.txt");jo_key(o[..],"files");jo_arr(o[..]);
  if !ar_inventory(dest,"",o[..],0) {return false;}jo_end(o[..]);jo_end(o[..]);if o[0].bad {return false;}
  h:[64]u8;revision:=ar_digest(jo_text(o[..]),h[..]);ip:[4096]u8;inventory:=fs_join(stage,"inventory.json",ip[..]);if !fs_write(inventory,jo_text(o[..])) {return false;}
  fb:[4096]u8;final:=fs_join(originals,revision,fb[..]);
  if fs_exists(final) {if !ar_verify(final) {return false;}ok:=fs_remove(stage);if !ok {return false;}}
  else {if !fs_rename(stage,final) {return false;}a:=[4]string.["/bin/chmod","-R","a-w",final];if !ar_run(a[..]) {return false;}}
  // A portable lock pins the snapshot; no Desktop paths are committed.
  ob:[8192]u8;oo:[1]Jo;jo_start(oo[..],ob[..]);jo_obj(oo[..]);ar_kstr(oo[..],"schema","oa-package-lock-v1");ar_kstr(oo[..],"package",pkg);ar_kstr(oo[..],"revision",revision);jo_end(oo[..]);
  nameb:[256]u8;name:=ar_cat(pkg,".json",nameb[..]);pb:[4096]u8;path:=fs_join("assets/registry/packages",name,pb[..]);
  ok:=ar_file(path,jo_text(oo[..]));invnameb:[256]u8;invname:=ar_cat(pkg,".files.json",invnameb[..]);invpb:[4096]u8;invpath:=fs_join("assets/registry/packages",invname,invpb[..]);ok=ok && ar_file(invpath,jo_text(o[..]));unlocked:=fs_unlock();print("Imported % @ %\n",pkg,revision);return ok && unlocked;
}
ar_verify :: (snapshot:string)->bool {
  pb:[4096]u8;path:=fs_join(snapshot,"inventory.json",pb[..]);b:[8388608]u8;n:=fs_read(path,b[..]);if n<0 {return false;}
  hh:[64]u8;if ar_digest(cast(string)b[0..<n],hh[..])!=fs_base(snapshot) {return false;}
  nodes:[65536]JvNode;d:[1]Jv;if !jv_parse(d[..],cast(string)b[0..<n],nodes[..]) {return false;}
  fs:=jv_get(d[0],0,"files");for i:0..<jv_len(d[0],fs) {node:=jv_at(d[0],fs,i);rb:[4096]u8;rel:=ar_string(d[0],node,"path",rb[..]);if !ar_relative(rel) {return false;}
    sb:[4096]u8;source:=fs_join(snapshot,"source",sb[..]);fb:[4096]u8;file:=fs_join(source,rel,fb[..]);hb:[64]u8;eb:[64]u8;
    if fs_size(file)!=jv_int(d[0],jv_get(d[0],node,"bytes"),-1) || ar_sha(file,hb[..])!=ar_string(d[0],node,"sha256",eb[..]) {return false;}
  }return true;
}

// Convert Blender observations into portable immutable revision definitions.
ar_catalog :: (pkg:string,namespace:string,build:string,store:string)->bool {
  if !ar_id(namespace) || !ar_id(pkg) {return false;}
  nb:[256]u8;pn:=ar_cat(pkg,".json",nb[..]);lp:[4096]u8;lock:=fs_join("assets/registry/packages",pn,lp[..]);lb:[8192]u8;ln:=fs_read(lock,lb[..]);if ln<0 {return false;}
  ld:[1]Jv;ls:[64]JvNode;if !jv_parse(ld[..],cast(string)lb[0..<ln],ls[..]) {return false;}rh:[64]u8;package_revision:=ar_string(ld[0],0,"revision",rh[..]);if package_revision.count!=64 {return false;}
  op:[4096]u8;obs_path:=fs_join(build,"observations.jsonl",op[..]);obs:[8388608]u8;on:=fs_read(obs_path,obs[..]);if on<0 {return false;}
  fb:[4096]u8;filename:=ar_cat(pkg,".jsonl",fb[..]);dp:[4096]u8;dest:=fs_join("assets/registry/assets",filename,dp[..]);tp:[4096]u8;temp:=ar_cat(dest,".tmp",tp[..]);if !fs_write(temp,"") {return false;}
  ob:[4096]u8;objects:=fs_join(store,"objects",ob[..]);if !fs_mkdir(objects) {return false;}
  recipeh:[64]u8;bridgeb:[4096]u8;bridge_path:=fs_join(build,"bridge.py",bridgeb[..]);recipe:=ar_sha(bridge_path,recipeh[..]);if recipe=="" {return false;}
  ids:[1048576]u8;idn:=0;at:=0;count:=0;
  while at<on {end:=at;while end<on && obs[end]!='\n' {end+=1;}line:=cast(string)obs[at..<end];at=end+1;if line=="" {continue;}
    d:[1]Jv;nodes:[32768]JvNode;if !jv_parse(d[..],line,nodes[..]) {return false;}
    nameb:[1024]u8;name:=ar_string(d[0],0,"name",nameb[..]);slugb:[1024]u8;slug:=ar_slug(name,slugb[..]);idb:[2048]u8;id:=fs_join(namespace,slug,idb[..]);if !ar_id(id) {return false;}
    start:=0;for k:0..<idn {if ids[k]=='\n' {if cast(string)ids[start..<k]==id {tool_errln("Duplicate asset ID");return false;}start=k+1;}}
    if idn+id.count+1>ids.count {return false;}for c:id {ids[idn]=c;idn+=1;}ids[idn]='\n';idn+=1;
    eb:[2048]u8;export_name:=ar_string(d[0],0,"export",eb[..]);if !ar_relative(export_name) {return false;}ep:[4096]u8;export_path:=fs_join(build,export_name,ep[..]);gh:[64]u8;glb_sha:=ar_sha(export_path,gh[..]);if glb_sha=="" {return false;}
    gp:[4096]u8;glb_object:=fs_join(objects,glb_sha,gp[..]);if !ar_object_copy(export_path,glb_object,glb_sha) {return false;}
    defbuf:[1048576]u8;o:[1]Jo;jo_start(o[..],defbuf[..]);jo_obj(o[..]);ar_kstr(o[..],"schema","oa-asset-definition-v1");ar_kstr(o[..],"id",id);ar_kstr(o[..],"name",name);
    collision:=name.count>4 && name[0..<4]=="UCX_";ar_kstr(o[..],"kind",ifx collision then "collision" else ifx jv_len(d[0],jv_get(d[0],0,"rigs"))>0 then "skinned-mesh" else "static-mesh");
    if collision {ownerb:[1024]u8;owner:=ar_collision_owner(name,ownerb[..]);oidb:[2048]u8;ar_kstr(o[..],"collision_owner",fs_join(namespace,owner,oidb[..]));}
    ar_kstr(o[..],"package",pkg);ar_kstr(o[..],"package_revision",package_revision);ar_kstr(o[..],"license","CC0-1.0");ar_kstr(o[..],"recipe_sha256",recipe);jo_key(o[..],"parents");
    origb:[4096]u8;orig:=fs_join(store,"originals",origb[..]);snapb:[4096]u8;snap:=fs_join(orig,package_revision,snapb[..]);fmp:[4096]u8;forkpath:=fs_join(snap,"source/fork.json",fmp[..]);fmb:[65536]u8;fmn:=fs_read(forkpath,fmb[..]);fd:[1]Jv;fn:[256]JvNode;
    if fmn>=0 {if !jv_parse(fd[..],cast(string)fmb[0..<fmn],fn[..]) {return false;}jv_write(fd[0],jv_get(fd[0],0,"parents"),o[..]);}else {jo_arr(o[..]);jo_end(o[..]);}
    jo_key(o[..],"source");jo_raw(o[..],line);jo_key(o[..],"artifacts");jo_arr(o[..]);jo_obj(o[..]);ar_kstr(o[..],"format","glb");ar_kstr(o[..],"sha256",glb_sha);jo_key(o[..],"bytes");jo_int(o[..],fs_size(export_path));ar_kstr(o[..],"role","interchange");jo_end(o[..]);jo_end(o[..]);ar_kstr(o[..],"runtime_profile","unqualified");jo_end(o[..]);if o[0].bad {return false;}
    ah:[64]u8;revision:=ar_digest(jo_text(o[..]),ah[..]);ap:[4096]u8;asset_object:=fs_join(objects,revision,ap[..]);if !ar_object_text(asset_object,jo_text(o[..])) {return false;}
    rowbuf:[1048576]u8;row:[1]Jo;jo_start(row[..],rowbuf[..]);jo_obj(row[..]);ar_kstr(row[..],"id",id);ar_kstr(row[..],"revision",revision);jo_key(row[..],"definition");jo_raw(row[..],jo_text(o[..]));jo_end(row[..]);
    if row[0].bad || !fs_append(temp,jo_text(row[..])) || !fs_append(temp,"\n") {return false;}count+=1;
  }
  if count==0 || !fs_rename(temp,dest) {return false;}
  print("Registered % assets in %\n",count,pkg);return true;
}

ar_observe_as :: (pkg:string,namespace:string,store:string,recipe_path:string)->bool {
  nb:[256]u8;name:=ar_cat(pkg,".json",nb[..]);lp:[4096]u8;lock:=fs_join("assets/registry/packages",name,lp[..]);lb:[8192]u8;ln:=fs_read(lock,lb[..]);if ln<0 {return false;}
  ld:[1]Jv;ls:[64]JvNode;if !jv_parse(ld[..],cast(string)lb[0..<ln],ls[..]) {return false;}rh:[64]u8;revision:=ar_string(ld[0],0,"revision",rh[..]);if revision.count!=64 {return false;}
  rb:[65536]u8;rn:=fs_read(recipe_path,rb[..]);if rn<0 {return false;}rd:[1]Jv;rs:[2048]JvNode;if !jv_parse(rd[..],cast(string)rb[0..<rn],rs[..]) {return false;}
  origb:[4096]u8;orig:=fs_join(store,"originals",origb[..]);snapb:[4096]u8;snap:=fs_join(orig,revision,snapb[..]);rootb:[4096]u8;root:=fs_join(snap,"source",rootb[..]);
  cacheb:[4096]u8;cache:=fs_join(store,"cache",cacheb[..]);outb:[4096]u8;output:=fs_join(cache,pkg,outb[..]);if !fs_mkdir(output) {return false;}
  jb:[131072]u8;o:[1]Jo;jo_start(o[..],jb[..]);jo_obj(o[..]);ar_kstr(o[..],"root",root);ar_kstr(o[..],"output",output);
  for key:[5]string.["mode","garments","blends","preview_exclude_prefix","origin_mode"] {jo_key(o[..],key);jv_write(rd[0],jv_get(rd[0],0,key),o[..]);}jo_end(o[..]);
  jp:[4096]u8;job_path:=fs_join(output,"job.json",jp[..]);if o[0].bad || !ar_file(job_path,jo_text(o[..])) {return false;}
  bridgeb:[4096]u8;bridge_path:=fs_join(output,"bridge.py",bridgeb[..]);cp:=[3]string.["/bin/cp","verse/tools/assets/blender_bridge.py",bridge_path];if !ar_run(cp[..]) {return false;}
  a:=[10]string.["/Applications/Blender.app/Contents/MacOS/Blender","--background","--factory-startup","--disable-autoexec","--python-exit-code","1","--python",bridge_path,"--",job_path];
  if !ar_run(a[..]) {return false;}return ar_catalog(pkg,namespace,output,store);
}

ArText :: struct {b:[131072]u8;n:int;bad:bool;}
ar_add :: (t:[]ArText,s:string) {if t[0].n+s.count>t[0].b.count {t[0].bad=true;return;}for c:s {t[0].b[t[0].n]=c;t[0].n+=1;}}
ar_num :: (t:[]ArText,n:int) {b:[64]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_int(o[..],n);ar_add(t,jo_text(o[..]));}
ar_quote :: (t:[]ArText,s:string) {b:[4096]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_str(o[..],s);if o[0].bad {t[0].bad=true;}ar_add(t,jo_text(o[..]));}
ar_lookup :: (id:string,out:[]u8)->string {
  list:[1]FsList;n:=fs_list("assets/registry/assets",list[..]);if n<0 || list[0].full {return "";}
  for i:0..<n {pb:[4096]u8;p:=fs_join("assets/registry/assets",fs_entry(list[..],i),pb[..]);sz:=fs_read(p,out);if sz<0 {return "";}at:=0;
    while at<sz {e:=at;while e<sz && out[e]!='\n' {e+=1;}line:=cast(string)out[at..<e];at=e+1;if line=="" {continue;}d:[1]Jv;nodes:[32768]JvNode;if !jv_parse(d[..],line,nodes[..]) {return "";}b:[2048]u8;if ar_string(d[0],0,"id",b[..])==id {return line;}}
  }return "";
}
ar_wardrobe :: (check:bool)->bool {
  b:[131072]u8;n:=fs_read("assets/registry/collections/character-create.json",b[..]);if n<0 {return false;}d:[1]Jv;nodes:[8192]JvNode;if !jv_parse(d[..],cast(string)b[0..<n],nodes[..]) {return false;}
  slots:=jv_get(d[0],0,"slots");if jv_len(d[0],slots)!=40 {return false;}
  t:[1]ArText;ar_add(t[..],"// Generated by registry.coax wardrobe. Edit assets/registry/collections/character-create.json.\n// CC2 slots are frozen compatibility keys; source and asset array order is irrelevant.\nPART_NAMES :: [80]string.[");
  pins:[1]ArText;ar_add(pins[..],"{\"schema\":\"oa-collection-lock-v1\",\"id\":\"character-create\",\"assets\":[");first:=true;
  for body:[2]string.["female","male"] {for i:0..<40 {s:=jv_at(d[0],slots,i);if jv_int(d[0],jv_get(d[0],s,"legacy_slot"),-1)!=i {return false;}
    ib:[2048]u8;id:=ar_string(d[0],s,body,ib[..]);if id=="" {ar_quote(t[..],"");}else {
      records:[8388608]u8;line:=ar_lookup(id,records[..]);if line=="" {tool_errln(id);return false;}rd:[1]Jv;rn:[32768]JvNode;if !jv_parse(rd[..],line,rn[..]) {return false;}
      ab:[2048]u8;name:=ar_string(rd[0],jv_path(rd[0],0,"definition.source"),"name",ab[..]);pb:[4096]u8;packed:=fs_join("fantasy",name,pb[..]);ar_quote(t[..],packed);
      if !first {ar_add(pins[..],",");}first=false;ar_add(pins[..],"{\"id\":");ar_quote(pins[..],id);ar_add(pins[..],",\"revision\":");hb:[64]u8;ar_quote(pins[..],ar_string(rd[0],0,"revision",hb[..]));ar_add(pins[..],"}");
    }if body!="male" || i!=39 {ar_add(t[..],",");}ar_add(t[..],"\n");}}
  ar_add(t[..],"];\nPART_LABELS :: [40]string.[");for i:0..<40 {s:=jv_at(d[0],slots,i);bb:[2048]u8;ar_quote(t[..],ar_string(d[0],s,"label",bb[..]));if i!=39 {ar_add(t[..],",");}}ar_add(t[..],"];\nPART_IDS :: [80]string.[");
  for body:[2]string.["female","male"] {for i:0..<40 {s:=jv_at(d[0],slots,i);bb:[2048]u8;ar_quote(t[..],ar_string(d[0],s,body,bb[..]));if body!="male" || i!=39 {ar_add(t[..],",");}}}ar_add(t[..],"];\nPART_SELECTABLE :: [40]bool.[");
  for i:0..<40 {s:=jv_at(d[0],slots,i);ar_add(t[..],ifx jv_bool(d[0],jv_get(d[0],s,"selectable")) then "true" else "false");if i!=39 {ar_add(t[..],",");}}ar_add(t[..],"];\nPART_PRESETS :: [4][8]int.[");
  presets:=jv_get(d[0],0,"presets");if jv_len(d[0],presets)!=4 {return false;}for f:0..<4 {ar_add(t[..],"[8]int.[");ps:=jv_at(d[0],presets,f);if jv_len(d[0],ps)>8 {return false;}
    for k:0..<8 {ix:=-1;if k<jv_len(d[0],ps) {keyb:[1024]u8;kn:=jv_str(d[0],jv_at(d[0],ps,k),keyb[..]);if kn<1 {return false;}key:=cast(string)keyb[0..<kn];for i:0..<40 {kb:[1024]u8;if ar_string(d[0],jv_at(d[0],slots,i),"key",kb[..])==key {ix=i;}}if ix<0 {return false;}}ar_num(t[..],ix);if k!=7 {ar_add(t[..],",");}}ar_add(t[..],"]");if f!=3 {ar_add(t[..],",");}}
  ar_add(t[..],"];\n");ar_add(pins[..],"]}");if t[0].bad || pins[0].bad {return false;}
  output:=cast(string)t[0].b[0..<t[0].n];lock:=cast(string)pins[0].b[0..<pins[0].n];
  if check {old:[131072]u8;sz:=fs_read("apps/openagents-web/charactercreator-parts.coax",old[..]);if sz<0 || cast(string)old[0..<sz]!=output {return false;}sz=fs_read("assets/registry/collections/character-create.lock.json",old[..]);return sz>=0 && cast(string)old[0..<sz]==lock;}
  return ar_file("apps/openagents-web/charactercreator-parts.coax",output) && ar_file("assets/registry/collections/character-create.lock.json",lock);
}

#test "registry verifies exact definition bytes and stable ID joins" {
  #assert ar_record("{}") == false;
  #assert ar_record("{\"id\":\"a/b\",\"revision\":\"bad\",\"definition\":{}}") == false;
  #assert ar_record("{\"id\":\"a/b\",\"revision\":\"44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a\",\"definition\":{}}") == false;
}
ar_record :: (line:string)->bool {
 d:[1]Jv;nodes:[32768]JvNode;if !jv_parse(d[..],line,nodes[..]) {return false;}
 ib:[2048]u8;id:=ar_string(d[0],0,"id",ib[..]);if !ar_id(id) {return false;}
