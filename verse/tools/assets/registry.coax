  while at<sz {end:=at;while end<sz && bytes[end]!='\n' {end+=1;}line:=cast(string)bytes[at..<end];at=end+1;if line=="" {continue;}if !ar_record(line) {tool_errln("Invalid asset revision");return false;}
   d:[1]Jv;nodes:[32768]JvNode;parsed:=jv_parse(d[..],line,nodes[..]);ib:[2048]u8;id:=ar_string(d[0],0,"id",ib[..]);start:=0;for i:0..<idn {if ids[i]=='\n' {if cast(string)ids[start..<i]==id {return false;}start=i+1;}}if idn+id.count+1>ids.count {return false;}for c:id {ids[idn]=c;idn+=1;}ids[idn]='\n';idn+=1;
   arts:=jv_path(d[0],0,"definition.artifacts");if jv_len(d[0],arts)<1 {return false;}
   for k:0..<jv_len(d[0],arts) {art:=jv_at(d[0],arts,k);hb:[64]u8;sha:=ar_string(d[0],art,"sha256",hb[..]);ob:[4096]u8;objects:=fs_join(store,"objects",ob[..]);fb:[4096]u8;file:=fs_join(objects,sha,fb[..]);got:[64]u8;if sha.count!=64 || ar_sha(file,got[..])!=sha || fs_size(file)!=jv_int(d[0],jv_get(d[0],art,"bytes"),-1) {tool_errln(id);return false;}}
   count+=1;
  }
 }
