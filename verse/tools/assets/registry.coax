 gp:[4096]u8;generated:=fs_join(authoring,"apps/openagents-web",gp[..]);if !fs_mkdir(generated) {return false;}
 homeb:[4096]u8;home:=proc_getenv("HOME",homeb[..]);binb:[4096]u8;bin:=fs_join(home,".openagents/bin",binb[..]);if !fs_mkdir(bin) {return false;}ep:[4096]u8;dest:=fs_join(bin,"asset-registry",ep[..]);a:=[3]string.["/bin/cp",executable,dest];if !ar_run(a[..]) {return false;}
 print("Installed %; shared catalog %\n",dest,catalog);return true;
}
// Outside a checkout, the installed command uses the durable shared catalog and SDK bridge.
ar_local :: (a:[]Args)->int {
 homeb:[4096]u8;home:=proc_getenv("HOME",homeb[..]);ab:[4096]u8;authoring:=fs_join(home,".openagents/assets/authoring",ab[..]);ep:[4096]u8;exe:=fs_join(home,".openagents/bin/asset-registry",ep[..]);if !fs_exists(exe) || !fs_exists(authoring) {return 2;}
 h:=proc_new();if h<0 {return 2;}ok:=proc_arg(h,exe) && proc_cwd(h,authoring);for i:0..<args_count(a) {ok=ok && proc_arg(h,args_at(a,i));}if !ok || proc_start(h)!=0 {done:=proc_release(h);return 2;}
 line:[65536]u8;while true {n:=proc_line(h,840000,line[..]);if n==PROC_EOF {break;}if n<0 {done:=proc_kill(h,PROC_SIGKILL);done=proc_release(h);return 1;}print("%\n",cast(string)line[0..<n]);}
 status:=proc_wait(h,1000);err:[65536]u8;e:=proc_stderr(h,err[..]);tool_err(e);done:=proc_release(h);return status;
}

tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) {return 2;}n:=args_count(a[..]);cmd:=args_at(a[..],0);
 if !fs_exists("assets/registry") && cmd!="selfcheck" {return ar_local(a[..]);}
 if cmd=="import" && n==4 {return ifx ar_import(args_at(a[..],1),args_at(a[..],2),args_at(a[..],3)) then 0 else 1;}
 if cmd=="catalog" && n==5 {return ifx ar_catalog(args_at(a[..],1),args_at(a[..],2),args_at(a[..],3),args_at(a[..],4)) then 0 else 1;}
 if cmd=="observe" && n==3 {return ifx ar_observe(args_at(a[..],1),args_at(a[..],2)) then 0 else 1;}
 if cmd=="wardrobe" && (n==1 || (n==2 && args_at(a[..],1)=="--check")) {return ifx ar_wardrobe(n==2) then 0 else 1;}
 if cmd=="check" && n==2 {return ifx ar_check(args_at(a[..],1)) then 0 else 1;}
 if cmd=="fork" && n==4 {return ifx ar_fork(args_at(a[..],1),args_at(a[..],2),args_at(a[..],3)) then 0 else 1;}
 if cmd=="publish" && n==3 {return ifx ar_publish(args_at(a[..],1),args_at(a[..],2)) then 0 else 1;}
 if cmd=="index" && n==3 {return ifx ar_index(args_at(a[..],1),args_at(a[..],2)) then 0 else 1;}
 if cmd=="representations" && n==2 {return ifx ar_representations(args_at(a[..],1)) then 0 else 1;}
 if cmd=="sync" && n==2 {return ifx ar_sync(args_at(a[..],1)) then 0 else 1;}
 if cmd=="source" && n==3 {return ifx ar_source(args_at(a[..],1),args_at(a[..],2)) then 0 else 1;}
 if cmd=="show" && n==2 {b:[8388608]u8;row:=ar_lookup(args_at(a[..],1),b[..]);if row=="" {return 1;}print("%\n",row);return 0;}
 if cmd=="selfcheck" && n==1 {return ifx ar_selfcheck() then 0 else 1;}
 if cmd=="install" && n==3 {return ifx ar_install(args_at(a[..],1),args_at(a[..],2)) then 0 else 1;}
 if cmd=="verify" && n==2 {return ifx ar_verify(args_at(a[..],1)) then 0 else 1;}
 tool_errln("registry: import SOURCE PACKAGE STORE | observe PACKAGE STORE | index PACKAGE STORE | check STORE | verify SNAPSHOT | wardrobe [--check] | fork ID NEW_ID STORE | publish ID STORE");return 2;
}
