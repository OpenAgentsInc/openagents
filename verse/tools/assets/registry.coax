 #assert ar_record(cast(string)t[0].b[0..<t[0].n]);
 t[0].b[t[0].n-4]='c';#assert !ar_record(cast(string)t[0].b[0..<t[0].n]);
}

ar_selfcheck :: ()->bool {
 db:[4096]u8;dir:=fs_temp("oa-registry-check-",db[..]);if dir=="" {return false;}
 sb:[4096]u8;source:=fs_join(dir,"source",sb[..]);tb:[4096]u8;target:=fs_join(dir,"object",tb[..]);hb:[64]u8;sha:=ar_digest("abc",hb[..]);
 if !fs_write(source,"abc") || !ar_object_copy(source,target,sha) {return false;}stamp:=fs_mtime_ns(target);
