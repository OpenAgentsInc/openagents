// Read Quaternius's pinned Godot sample scene as data and emit the four unique
// authored building layouts. No project code or scripts are executed.
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/text/ph_num.coax";

#test "village scene quoted fields and transforms reject malformed input" {
 #assert vl_field("[node name=\"A\" parent=\"House C\"]","parent=\"")=="House C";
 #assert vl_field("[node name=\"A\"]","parent=\"")=="";
 #assert vl_field("[ext_resource uid=\"wrong\" path=\"a.gltf\" id=\"correct\"]"," id=\"")=="correct";
 #assert vl_group("House C")==0 && vl_group("Tower")==1 && vl_group("Houses A")==2 && vl_group("Houses D")==3 && vl_group("House C2")== -1;
 #assert vl_transform("1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, -2, 3e-05");
 #assert !vl_transform("1, 0, bad") && !vl_transform("1,2,3");
}
vl_find :: (s:string,key:string)->int {if key.count==0 || key.count>s.count {return -1;}for i:0..<s.count-key.count+1 {if s[i..<i+key.count]==key {return i;}}return -1;}
vl_field :: (s:string,key:string)->string {i:=vl_find(s,key);if i<0 {return "";}a:=i+key.count;b:=a;while b<s.count && s[b]!='"' {b+=1;}if b>=s.count {return "";}return s[a..<b];}
vl_group :: (s:string)->int {if s=="House C" {return 0;}if s=="Tower" {return 1;}if s=="Houses A" {return 2;}if s=="Houses D" {return 3;}return -1;}
vl_trim :: (s:string)->string {a:=0;b:=s.count;while a<b && (s[a]==' ' || s[a]=='\t' || s[a]=='\r') {a+=1;}while b>a && (s[b-1]==' ' || s[b-1]=='\t' || s[b-1]=='\r') {b-=1;}return s[a..<b];}
vl_transform :: (s:string)->bool {n:=0;a:=0;for i:0..<s.count+1 {if i==s.count || s[i]==',' {part:=vl_trim(s[a..<i]);v:=pn_parse(part);if !v.ok || v.v!=v.v || abs(v.v)>10000 {return false;}n+=1;a=i+1;}}return n==12;}
vl_name :: (path:string)->string {a:=0;for i:0..<path.count {if path[i]=='/' {a=i+1;}}if path.count<a+6 || path[path.count-5..<path.count]!=".gltf" {return "";}return path[a..<path.count-5];}
vl_safe :: (s:string)->bool {if s.count==0 || s.count>100 {return false;}for c:s {if !((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='_') {return false;}}return true;}
vl_emit :: (group:int,name:string,transform:string) {if group>=0 && name!="" {print("%|%|%\n",group,name,transform);}}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {tool_errln("usage: village_layout SCENE.tscn");return 2;}
 data:[1048576]u8;n:=fs_read(args_at(a[..],0),data[..]);if n<0 {return 1;}s:=cast(string)data[0..<n];ids:[512]string;names:[512]string;nr:=0;g:= -1;mesh:="";tr:="1,0,0,0,1,0,0,0,1,0,0,0";counts:[4]int;at:=0;
 while at<s.count {e:=at;while e<s.count && s[e]!='\n' {e+=1;}line:=vl_trim(s[at..<e]);at=e+1;
  if vl_find(line,"[ext_resource ")==0 {id:=vl_field(line," id=\"");path:=vl_field(line,"path=\"");name:=vl_name(path);if id!="" && name!="" {if nr>=512 || !vl_safe(name) {return 1;}ids[nr]=id;names[nr]=name;nr+=1;}}
  else if vl_find(line,"[node ")==0 {if g>=0 {if mesh=="" || !vl_transform(tr) {return 1;}vl_emit(g,mesh,tr);counts[g]+=1;}
   g=vl_group(vl_field(line,"parent=\""));mesh="";tr="1,0,0,0,1,0,0,0,1,0,0,0";
   if g>=0 {id:=vl_field(line,"instance=ExtResource(\"");for i:0..<nr {if ids[i]==id {mesh=names[i];break;}}}
  } else if g>=0 && vl_find(line,"transform = Transform3D(")==0 {start:=vl_find(line,"(")+1;end:=vl_find(line,")");if end<start {return 1;}tr=line[start..<end];}
 }
 if g>=0 {if mesh=="" || !vl_transform(tr) {return 1;}vl_emit(g,mesh,tr);counts[g]+=1;}
 if counts[0]!=167 || counts[1]!=77 || counts[2]!=308 || counts[3]!=151 {tool_errln("village scene layout count mismatch");return 1;}return 0;
}
