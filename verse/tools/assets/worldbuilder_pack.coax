// WorldBuilder's pack (openagents.com/create-world): every placeable Quaternius model in the asset
// registry (assets/registry/README.md) as one VPK1 pack the page streams, plus the one-line-a-model
// catalogue the page's model reads. The models are the `quaternius/` static meshes of the village,
// ultimate-food, dungeon, nature, ultimate-rpg and fantasy-props kits, and the skinned animals of
// ultimate-animals-static and bestiary-dungeon in their rest pose (positions as stored with the node
// transforms applied, the skin ignored). Fantasy outfits, animations, collision parts and the 0ad and
// openagents-* assets are not placeable and stay out.
//
// Each model is its glTF scene's primitives merged into one mesh, node transforms applied, in metres
// with Y up, then recentred: its footprint's middle at x = z = 0 and its lowest point at y = 0. A vertex
// is 16 bytes, four little-endian u32 words (the page's shader reads them so):
//   w0  qx | qy << 16        q = round((p - lo) / (hi - lo) * 65535), lo/hi the model's own box
//   w1  qz | ox << 16 | oy << 24   (ox, oy) the octahedral normal in [-1,1]^2 as bytes
//   w2  u | v << 16           TEXCOORD_0 as IEEE half floats
//   w3  r | g << 8 | b << 16 | layer << 24   the sRGB colour (baseColorFactor times COLOR_0, both
//       linear in glTF, encoded to sRGB) and the base-colour texture's layer, 255 for none
// Indices are u32 vertex numbers in the whole vertices entry. Layers are base-colour images only,
// deduplicated by the SHA-256 of their bytes, each 256x256: JPEG, or PNG when it has cutout alpha.
// The catalog (kind 1) names each model `M NAME FIRST COUNT K X0 Y0 Z0 X1 Y1 Z1` in name order.
//
// Outputs (from the repository's root):
//   apps/openagents-web/realms/create-world/assets/worldbuilder.pack.gz   the pack, gzipped
//   coax/web/api/worldbuilder-assets.txt   NAME|w,h,d|tags, one line a model, for the model prompt
//   coax/web/api/worldbuilder-assets.h     the same text as one C string, for the API image
// Run: coax/web/tool.sh verse/tools/assets/worldbuilder_pack.coax OBJECTS SCRATCH
//   OBJECTS  the shared store's objects (~/.openagents/assets/objects); SCRATCH  a directory it
//   may write the props' glTF files and embedded images into.
// Checks: coax/bin/coax test verse/tools/assets/worldbuilder_pack.coax
// tool.sh: release
// tool.sh: stack-gib 8
#import "Basic";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/args.coax";
#load "../humans/ph_pack.coax";
#load "../humans/ph_face.coax";
#load "../humans/ph_outfits.coax";
#load "../../../coax/lib/image/deflate.coax";
#load "../../../coax/lib/crypto/sha256.coax";

WB_BUDGET :: 50331648;                 // 48 MiB: the pack's bytes at most
WB_VMAX :: 2500000; WB_IMAX :: 6000000; // vertices and indices in the whole pack
WB_SV :: 400000; WB_SI :: 1200000;      // one model's vertices and indices
WB_MESHES :: 1024; WB_LAYERS :: 255; WB_SIDE :: 256;
WB_NAME :: 47;
WB_COLLECTIONS :: [8] string.["village", "ultimate-food", "dungeon", "nature", "ultimate-rpg", "fantasy-props", "ultimate-animals-static", "bestiary-dungeon"];

// ---- the vertex encoding
wb_put :: (b: []u8, at: int, v: int) { for k: 0..<4 { b[at + k] = cast(u8) ((v >> (k * 8)) & 255); } }
wb_get :: (b: []u8, at: int) -> int { return cast(int) b[at] | (cast(int) b[at + 1] << 8) | (cast(int) b[at + 2] << 16) | (cast(int) b[at + 3] << 24); }
wb_round :: (x: f64) -> int { return cast(int) floor(x + 0.5); }
wb_clampi :: (v: int, a: int, b: int) -> int { return ifx v < a then a else ifx v > b then b else v; }
// p inside [lo, hi] as a unorm16
wb_q16 :: (p: f64, lo: f64, hi: f64) -> int { return wb_clampi(wb_round((p - lo) / (hi - lo) * 65535.0), 0, 65535); }
wb_dq16 :: (q: int, lo: f64, hi: f64) -> f64 { return lo + cast(f64) q / 65535.0 * (hi - lo); }
// a unit normal as two bytes (octahedral): ox | oy << 8
wb_octa :: (n_in: [3] f64) -> int {
  l := sqrt(n_in[0] * n_in[0] + n_in[1] * n_in[1] + n_in[2] * n_in[2]);
  n := ifx l > 0.000000000001 then [3] f64.[n_in[0] / l, n_in[1] / l, n_in[2] / l] else [3] f64.[0.0, 1.0, 0.0];
  s := abs(n[0]) + abs(n[1]) + abs(n[2]);
  x := n[0] / s; y := n[1] / s;
  if n[2] < 0.0 {
    ox := (1.0 - abs(y)) * (ifx x >= 0.0 then 1.0 else -1.0);
    oy := (1.0 - abs(x)) * (ifx y >= 0.0 then 1.0 else -1.0);
    x = ox; y = oy;
  }
  return wb_clampi(wb_round((x * 0.5 + 0.5) * 255.0), 0, 255) | (wb_clampi(wb_round((y * 0.5 + 0.5) * 255.0), 0, 255) << 8);
}
wb_unocta :: (o: int) -> [3] f64 {
  x := cast(f64) (o & 255) / 255.0 * 2.0 - 1.0; y := cast(f64) ((o >> 8) & 255) / 255.0 * 2.0 - 1.0;
  z := 1.0 - abs(x) - abs(y);
  if z < 0.0 {
    ox := (1.0 - abs(y)) * (ifx x >= 0.0 then 1.0 else -1.0);
    oy := (1.0 - abs(x)) * (ifx y >= 0.0 then 1.0 else -1.0);
    x = ox; y = oy;
  }
  l := sqrt(x * x + y * y + z * z);
  return [3] f64.[x / l, y / l, z / l];
}
// an f64 as an IEEE half float (round to nearest even; past the range to infinity)
wb_half :: (v: f64) -> int {
  b := cast(int) f32_bits(cast(f32) v);
  sign := (b >> 16) & 32768; e := (b >> 23) & 255; m := b & 8388607;
  if e == 255 { return sign | 31744 | (ifx m != 0 then 512 else 0); }
  he := e - 127 + 15;
  if he >= 31 { return sign | 31744; }
  if he <= 0 {
    if he < -10 { return sign; }
    m = m | 8388608;
    shift := 14 - he;
    h := m >> shift; rest := m & ((1 << shift) - 1); half := 1 << (shift - 1);
    if rest > half || (rest == half && (h & 1) != 0) { h += 1; }
    return sign | h;
  }
  h := (he << 10) | (m >> 13); rest := m & 8191;
  if rest > 4096 || (rest == 4096 && (h & 1) != 0) { h += 1; }
  return sign | h;
}
wb_unhalf :: (h: int) -> f64 {
  s := ifx (h & 32768) != 0 then -1.0 else 1.0; e := (h >> 10) & 31; m := h & 1023;
  if e == 0 { return s * cast(f64) m / 16777216.0; }
  r := 1.0 + cast(f64) m / 1024.0;
  k := e - 15; while k > 0 { r *= 2.0; k -= 1; } while k < 0 { r /= 2.0; k += 1; }
  return s * r;
}
// a linear colour channel as an sRGB byte
wb_srgb :: (c_in: f64) -> int {
  c := ifx c_in < 0.0 then 0.0 else ifx c_in > 1.0 then 1.0 else c_in;
  s := ifx c <= 0.0031308 then c * 12.92 else 1.055 * exp(log(c) / 2.4) - 0.055;
  return wb_clampi(wb_round(s * 255.0), 0, 255);
}
wb_w3 :: (r: int, g: int, b: int, layer: int) -> int { return (r & 255) | ((g & 255) << 8) | ((b & 255) << 16) | ((layer & 255) << 24); }
// one vertex at b[at..at+16]
wb_vertex :: (b: []u8, at: int, p: [3] f64, lo: [6] f64, n: [3] f64, uv: [2] f64, rgb: [3] int, layer: int) {
  qx := wb_q16(p[0], lo[0], lo[3]); qy := wb_q16(p[1], lo[1], lo[4]); qz := wb_q16(p[2], lo[2], lo[5]);
  wb_put(b, at, qx | (qy << 16));
  wb_put(b, at + 4, qz | (wb_octa(n) << 16));
  wb_put(b, at + 8, wb_half(uv[0]) | (wb_half(uv[1]) << 16));
  wb_put(b, at + 12, wb_w3(rgb[0], rgb[1], rgb[2], layer));
}
// A model's box after recentring: the footprint's middle at x = z = 0, the lowest point at y = 0,
// a flat axis padded to 1 mm. The shift it takes is (dx, dy, dz) = (-mid x, -low y, -mid z).
wb_recentre :: (box: [6] f64) -> [6] f64 {
  mx := (box[0] + box[3]) * 0.5; mz := (box[2] + box[5]) * 0.5;
  r := [6] f64.[box[0] - mx, 0.0, box[2] - mz, box[3] - mx, box[4] - box[1], box[5] - mz];
  for k: 0..<3 { if r[k + 3] - r[k] < 0.001 { r[k + 3] = r[k] + 0.001; } }
  return r;
}

#test "unorm16 quantization spans the model's own box" {
  #assert wb_q16(-2.0, -2.0, 6.0) == 0 && wb_q16(6.0, -2.0, 6.0) == 65535 && wb_q16(2.0, -2.0, 6.0) == 32768;
  #assert wb_q16(-9.0, -2.0, 6.0) == 0 && wb_q16(9.0, -2.0, 6.0) == 65535;
  #assert abs(wb_dq16(wb_q16(1.2345, -2.0, 6.0), -2.0, 6.0) - 1.2345) < 8.0 / 65535.0;
}
#test "octahedral normals survive the byte round trip" {
  ns := [8][3] f64.[[3] f64.[0.0, 1.0, 0.0], [3] f64.[0.0, -1.0, 0.0], [3] f64.[1.0, 0.0, 0.0], [3] f64.[0.0, 0.0, -1.0],
                    [3] f64.[0.3, 0.4, -0.866], [3] f64.[-0.6, 0.0, 0.8], [3] f64.[-0.5, -0.5, -0.7071], [3] f64.[0.0, 0.0, 1.0]];
  for n: ns {
    l := sqrt(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
    d := wb_unocta(wb_octa(n));
    #assert (d[0] * n[0] + d[1] * n[1] + d[2] * n[2]) / l > 0.999;
  }
  #assert wb_octa([3] f64.[0.0, 0.0, 1.0]) == (128 | (128 << 8));
  #assert wb_octa([3] f64.[0.0, 0.0, 0.0]) == wb_octa([3] f64.[0.0, 1.0, 0.0]);
}
#test "uvs are IEEE half floats" {
  #assert wb_half(0.0) == 0 && wb_half(1.0) == 15360 && wb_half(-2.0) == 49152 && wb_half(0.5) == 14336;
  #assert wb_half(65504.0) == 31743 && wb_half(100000.0) == 31744 && wb_half(0.000000059604645) == 1;
  for u: [5] f64.[0.25, 0.7, -24.3, 0.001, 3.999] { #assert abs(wb_unhalf(wb_half(u)) - u) <= abs(u) / 1024.0; }
}
#test "the colour word packs sRGB bytes and the layer" {
  #assert wb_w3(255, 128, 1, 255) == 255 | (128 << 8) | (1 << 16) | (255 << 24);
  #assert wb_srgb(1.0) == 255 && wb_srgb(0.0) == 0 && wb_srgb(0.2158605) == 128 && wb_srgb(0.5) == 188 && wb_srgb(2.0) == 255;
  b: [16] u8;
  wb_vertex(b[..], 0, [3] f64.[1.0, 0.0, -1.0], [6] f64.[-1.0, 0.0, -1.0, 1.0, 2.0, 1.0], [3] f64.[0.0, 1.0, 0.0], [2] f64.[1.0, 0.5], [3] int.[10, 20, 30], 7);
  #assert wb_get(b[..], 0) == 65535 && (wb_get(b[..], 4) & 65535) == 0 && ((wb_get(b[..], 4) >> 16) & 65535) == wb_octa([3] f64.[0.0, 1.0, 0.0]);
  #assert wb_get(b[..], 8) == 15360 | (14336 << 16) && wb_get(b[..], 12) == 10 | (20 << 8) | (30 << 16) | (7 << 24);
}
#test "recentring stands the box on y = 0 over the middle of its footprint" {
  r := wb_recentre([6] f64.[2.0, 1.0, -4.0, 6.0, 3.5, 0.0]);
  #assert r[0] == -2.0 && r[3] == 2.0 && r[1] == 0.0 && r[4] == 2.5 && r[2] == -2.0 && r[5] == 2.0;
  f := wb_recentre([6] f64.[0.0, 5.0, 0.0, 1.0, 5.0, 1.0]);
  #assert f[1] == 0.0 && abs(f[4] - 0.001) < 0.0000001;
}

// ---- the work
Wb :: struct {
  v: [WB_VMAX * 16] u8; nv: int;
  i: [WB_IMAX * 4] u8; ni: int;
  // one model, staged
  sp: [WB_SV * 3] f64; sn: [WB_SV * 3] f64; suv: [WB_SV * 2] f64; sc: [WB_SV * 3] int; sl: [WB_SV] int; ns: int;
  si: [WB_SI] int; nsi: int;
  // accessor reads
  ap: [WB_SV * 4] f64; an: [WB_SV * 4] f64; au: [WB_SV * 4] f64; ac: [WB_SV * 4] f64; ai: [WB_SI] f64;
  // the models, by name
  nm: int; name: [WB_MESHES] string; line: [WB_MESHES] string; lic: [WB_MESHES] int;
  mfirst: [WB_MESHES] int; mcount: [WB_MESHES] int; mbox: [WB_MESHES] [6] f64; mverts: [WB_MESHES] int;
  // the layers, in order of first use
  nl: int; lkey: [WB_LAYERS] string; lsrc: [WB_LAYERS] string; llic: [WB_LAYERS] int; lenc: [WB_LAYERS] string;
  imgl: [GL_ARR] int;   // this glTF's images' layers, -2 not yet looked up
  txt: [1] Txt; enc: [1] Txt;
  jtext: [4194304] u8; jd: [1] Jv; jn: [262144] JvNode;
  // the static animals' material colours, from their animated glTF exports (by animal, then by name)
  anim_name: [64] string; anim_gltf: [64] string; nanim: int;
  ctext: [8388608] u8; cd: [1] Jv; cn: [262144] JvNode;
  col: [1] Cols;
  skipped: int;
}
wb_less :: (a: string, b: string) -> bool {
  n := ifx a.count < b.count then a.count else b.count;
  for k: 0..<n { if a[k] != b[k] { return a[k] < b[k]; } }
  return a.count < b.count;
}
wb_hex :: (b: []u8, out: []u8) -> string {
  digits := "0123456789abcdef";
  for k: 0..<b.count { out[k * 2] = digits[cast(int) b[k] >> 4]; out[k * 2 + 1] = digits[cast(int) b[k] & 15]; }
  return cast(string) out[0..<b.count * 2];
}
wb_path :: (w: []Wb, dir: string, name: string) -> string { return txt_cat3(w[0].txt[..], dir, "/", name); }
// a registry line's artifact named so, its sha256 ("" when none)
wb_artifact :: (w: []Wb, name: string) -> string {
  d := w[0].jd[0]; arts := jv_path(d, 0, "definition.artifacts");
  for k: 0..<jv_len(d, arts) { a := jv_at(d, arts, k); if jv_raw(d, jv_get(d, a, "source_name")) == name { return jv_raw(d, jv_get(d, a, "sha256")); } }
  return "";
}

// The registry's placeable Quaternius models, sorted by name.
wb_registry :: (w: []Wb) {
  // The static animals' GLBs (the ultimate-animals-static recipe) carry the materials' names but
  // not their colours; the same animals' glTF exports (ultimate-animals) carry both.
  an := fs_read("assets/registry/assets/ultimate-animals.jsonl", w[0].jtext[..]);
  if an < 0 || an >= w[0].jtext.count { ph_die("worldbuilder pack: can't read the ultimate-animals registry"); }
  aat := 0;
  while aat < an {
    e := aat; while e < an && w[0].jtext[e] != '\n' { e += 1; }
    line := cast(string) w[0].jtext[aat..<e]; aat = e + 1;
    if line.count == 0 || !jv_parse(w[0].jd[..], line, w[0].jn[..]) { continue; }
    d := w[0].jd[0]; id := jv_raw(d, jv_get(d, 0, "id")); arts := jv_path(d, 0, "definition.artifacts");
    for k: 0..<jv_len(d, arts) {
      a := jv_at(d, arts, k);
      if jv_raw(d, jv_get(d, a, "format")) == "gltf" && w[0].nanim < 64 && starts(id, "quaternius/ultimate-animals/") {
        w[0].anim_name[w[0].nanim] = txt_keep(w[0].txt[..], id["quaternius/ultimate-animals/".count..<id.count]);
        w[0].anim_gltf[w[0].nanim] = txt_keep(w[0].txt[..], jv_raw(d, jv_get(d, a, "sha256"))); w[0].nanim += 1;
      }
    }
  }
  for c: WB_COLLECTIONS {
    pb: [512] u8; s: [1] Sb; s[0] = sb(pb[..]); sb_put(s[..], "assets/registry/assets/"); sb_put(s[..], c); sb_put(s[..], ".jsonl");
    n := fs_read(sb_text(s[..]), w[0].jtext[..]);
    if n < 0 || n >= w[0].jtext.count { ph_die2("worldbuilder pack: can't read ", sb_text(s[..])); }
    skinned := c == "ultimate-animals-static" || c == "bestiary-dungeon";
    at := 0;
    while at < n {
      e := at; while e < n && w[0].jtext[e] != '\n' { e += 1; }
      line := cast(string) w[0].jtext[at..<e]; at = e + 1;
      if line.count == 0 { continue; }
      if !jv_parse(w[0].jd[..], line, w[0].jn[..]) { ph_die2("worldbuilder pack: bad JSON in ", sb_text(s[..])); }
      d := w[0].jd[0];
      id := jv_raw(d, jv_get(d, 0, "id")); kind := jv_raw(d, jv_path(d, 0, "definition.kind"));
      if !starts(id, "quaternius/") { continue; }
      if !(kind == "static-mesh" || (skinned && kind == "skinned-mesh")) { continue; }
      name := id[11..<id.count];
      if name.count > WB_NAME { ph_die2("worldbuilder pack: a name past 47 bytes: ", name); }
      if w[0].nm >= WB_MESHES { ph_die("worldbuilder pack: more models than the tool holds"); }
      m := w[0].nm; w[0].nm += 1;
      w[0].name[m] = txt_keep(w[0].txt[..], name); w[0].line[m] = txt_keep(w[0].txt[..], line);
      w[0].lic[m] = ifx c == "bestiary-dungeon" then 1 else 0;
    }
  }
  for i: 1..<w[0].nm {
    nm := w[0].name[i]; ln := w[0].line[i]; lc := w[0].lic[i]; j := i - 1;
    while j >= 0 && wb_less(nm, w[0].name[j]) { w[0].name[j + 1] = w[0].name[j]; w[0].line[j + 1] = w[0].line[j]; w[0].lic[j + 1] = w[0].lic[j]; j -= 1; }
    w[0].name[j + 1] = nm; w[0].line[j + 1] = ln; w[0].lic[j + 1] = lc;
  }
}

// SHA-256 of any length, a MiB an update at a time (an update takes at most CB_MAX_BYTES)
wb_sha256 :: (b: []u8, out: []u8) {
  state: [112] u8; ok := sha256_init(state[..]) == SHA_OK;
  at := 0;
  while ok && at < b.count { e := ifx b.count - at > CB_MAX_BYTES then at + CB_MAX_BYTES else b.count; ok = sha256_update_checked(state[..], b[at..<e], false) == SHA_OK; at = e; }
  if !ok || sha256_final_checked(state[..], out, false) != SHA_OK { ph_die("worldbuilder pack: SHA-256 refused an image"); }
}
#test "SHA-256 of an image's bytes is the published one" {
  b := [3] u8.['a', 'b', 'c']; h: [32] u8; wb_sha256(b[..], h[..]); hb: [64] u8;
  #assert wb_hex(h[..], hb[..]) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
}
// A glTF image's layer: by the SHA-256 of its bytes, the first model to use it naming it.
wb_layer :: (w: []Wb, g: []Gltf, iw: []ImgWork, objects: string, scratch: string, img: int, m: int) -> int {
  if w[0].imgl[img] != -2 { return w[0].imgl[img]; }
  node := gl_at(g, GA_IMG, img);
  key := ""; path := ""; hb: [64] u8;
  label := gl_str(g, node, "name");
  if gl_has(g, node, "bufferView") {
    v := gl_at(g, GA_VIEW, gl_int(g, node, "bufferView", 0));
    off := gl_int(g, v, "byteOffset", 0); size := gl_int(g, v, "byteLength", 0);
    bytes := g[0].bin[off..<off + size];
    h: [32] u8; wb_sha256(bytes, h[..]);
    key = txt_keep(w[0].txt[..], wb_hex(h[..], hb[..]));
    path = wb_path(w, scratch, txt_cat(w[0].txt[..], key, ".png"));
    if !fs_exists(path) && !fs_write(path, cast(string) bytes) { ph_die2("worldbuilder pack: can't write ", path); }
  } else {
    uri := gl_str(g, node, "uri");
    key = wb_artifact(w, uri);
    if key.count == 0 { ph_die2("worldbuilder pack: no registry artifact for the image ", uri); }
    path = wb_path(w, objects, key);
    if label.count == 0 { label = stem(uri); }
  }
  for k: 0..<w[0].nl { if w[0].lkey[k] == key { w[0].imgl[img] = k; return k; } }
  if w[0].nl >= WB_LAYERS { ph_die("worldbuilder pack: more than 255 texture layers"); }
  k := w[0].nl; w[0].nl += 1;
  w[0].lkey[k] = key; w[0].llic[k] = w[0].lic[m];
  lb: [128] u8; n := 0;
  if label.count == 0 { label = key[0..<12]; }
  for c: label { if n < 64 { ok := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.'; lb[n] = ifx ok then c else '_'; n += 1; } }
  w[0].lsrc[k] = txt_keep(w[0].txt[..], cast(string) lb[0..<n]);
  w[0].lenc[k] = txt_keep(w[0].enc[..], cast(string) layer_bytes(path, WB_SIDE, false, iw));
  w[0].imgl[img] = k;
  return k;
}

// a node's local matrix (rows), from its matrix or its TRS
wb_local :: (g: []Gltf, node: int) -> [4][4] f64 {
  v: [16] f64; m: [4][4] f64;
  if gl_nums(g, node, "matrix", v[..]) == 16 {
    for r: 0..<4 { for c: 0..<4 { m[r][c] = v[c * 4 + r]; } }
    return m;
  }
  t := [3] f64.[0.0, 0.0, 0.0]; q := [4] f64.[0.0, 0.0, 0.0, 1.0]; s := [3] f64.[1.0, 1.0, 1.0];
  if gl_nums(g, node, "translation", v[..]) == 3 { t = [3] f64.[v[0], v[1], v[2]]; }
  if gl_nums(g, node, "rotation", v[..]) == 4 { q = qunit([4] f64.[v[0], v[1], v[2], v[3]]); }
  if gl_nums(g, node, "scale", v[..]) == 3 { s = [3] f64.[v[0], v[1], v[2]]; }
  m = mat_tr(t, q);
  for r: 0..<3 { for c: 0..<3 { m[r][c] *= s[c]; } }
  return m;
}
// a primitive of a mesh node, moved by the node's world matrix, onto the staged model
wb_primitive :: (w: []Wb, g: []Gltf, iw: []ImgWork, objects: string, scratch: string, m: int, pr: int, mat4: [4][4] f64) {
  mode := gl_int(g, pr, "mode", 4);
  if mode != 4 { tool_err("worldbuilder pack: a primitive that isn't triangles skipped in "); tool_errln(w[0].name[m]); w[0].skipped += 1; return; }
  a := gl_get(g, pr, "attributes");
  pi := gl_int(g, a, "POSITION", -1); if pi < 0 { return; }
  np := gl_acc_info(g, pi).count;
  if np * 4 > w[0].ap.count || w[0].ns + np > WB_SV { ph_die2("worldbuilder pack: a model past the tool's vertices: ", w[0].name[m]); }
  _ = gl_acc(g, pi, w[0].ap[..]);
  ni := gl_int(g, a, "NORMAL", -1); if ni >= 0 { _ = gl_acc(g, ni, w[0].an[..]); }
  ti := gl_int(g, a, "TEXCOORD_0", -1); if ti >= 0 { _ = gl_acc(g, ti, w[0].au[..]); }
  ci := gl_int(g, a, "COLOR_0", -1); cc := 0; if ci >= 0 { cc = gl_acc(g, ci, w[0].ac[..]).comps; }
  // the material: its factor and its base-colour texture's layer
  factor := [4] f64.[1.0, 1.0, 1.0, 1.0]; layer := 255;
  mi := gl_int(g, pr, "material", -1);
  if mi >= 0 {
    mat := gl_at(g, GA_MAT, mi); pbr := gl_get(g, mat, "pbrMetallicRoughness");
    v: [16] f64; if gl_nums(g, pbr, "baseColorFactor", v[..]) == 4 { factor = [4] f64.[v[0], v[1], v[2], v[3]]; }
    else { c: [1] [4] f64; if wb_colour_of(w[0].col[..], gl_str(g, mat, "name"), c[..]) { factor = c[0]; } }
    tex := gl_get(g, pbr, "baseColorTexture");
    if tex >= 0 {
      t := gl_int(g, tex, "index", -1);
      if t >= 0 { src := gl_int(g, gl_at(g, GA_TEX, t), "source", -1); if src >= 0 { layer = wb_layer(w, g, iw, objects, scratch, src, m); } }
    }
  }
  // normals by the cofactor matrix (the inverse transpose up to scale), signed by the determinant
  M := mat4;
  det := M[0][0] * (M[1][1] * M[2][2] - M[1][2] * M[2][1]) - M[0][1] * (M[1][0] * M[2][2] - M[1][2] * M[2][0]) + M[0][2] * (M[1][0] * M[2][1] - M[1][1] * M[2][0]);
  cof: [3][3] f64;
  for r: 0..<3 { for c: 0..<3 {
    r1 := (r + 1) % 3; r2 := (r + 2) % 3; c1 := (c + 1) % 3; c2 := (c + 2) % 3;
    cof[r][c] = (M[r1][c1] * M[r2][c2] - M[r1][c2] * M[r2][c1]) * (ifx det < 0.0 then -1.0 else 1.0);
  } }
  base := w[0].ns;
  for k: 0..<np {
    p := apply4(M, [3] f64.[w[0].ap[k * 3], w[0].ap[k * 3 + 1], w[0].ap[k * 3 + 2]], 1.0);
    n := [3] f64.[0.0, 1.0, 0.0];
    if ni >= 0 { x := w[0].an[k * 3]; y := w[0].an[k * 3 + 1]; z := w[0].an[k * 3 + 2]; for r: 0..<3 { n[r] = cof[r][0] * x + cof[r][1] * y + cof[r][2] * z; } }
    s := base + k;
    for c: 0..<3 { w[0].sp[s * 3 + c] = p[c]; w[0].sn[s * 3 + c] = n[c]; }
    w[0].suv[s * 2] = ifx ti >= 0 then w[0].au[k * 2] else 0.0; w[0].suv[s * 2 + 1] = ifx ti >= 0 then w[0].au[k * 2 + 1] else 0.0;
    for c: 0..<3 { col := factor[c] * (ifx cc >= 3 then w[0].ac[k * cc + c] else 1.0); w[0].sc[s * 3 + c] = wb_srgb(col); }
    w[0].sl[s] = layer;
  }
  w[0].ns = base + np;
  // the triangles, wound the other way under a mirroring matrix
  ii := gl_int(g, pr, "indices", -1);
  count := np;
  if ii >= 0 { count = gl_acc_info(g, ii).count; if count > w[0].ai.count { ph_die2("worldbuilder pack: a model past the tool's indices: ", w[0].name[m]); } _ = gl_acc(g, ii, w[0].ai[..]); }
  if w[0].nsi + count > WB_SI { ph_die2("worldbuilder pack: a model past the tool's indices: ", w[0].name[m]); }
  t := 0;
  while t + 2 < count {
    a0 := ifx ii >= 0 then cast(int) w[0].ai[t] else t; a1 := ifx ii >= 0 then cast(int) w[0].ai[t + 1] else t + 1; a2 := ifx ii >= 0 then cast(int) w[0].ai[t + 2] else t + 2;
    if det < 0.0 { x := a1; a1 = a2; a2 = x; }
    w[0].si[w[0].nsi] = base + a0; w[0].si[w[0].nsi + 1] = base + a1; w[0].si[w[0].nsi + 2] = base + a2; w[0].nsi += 3;
    t += 3;
  }
}
// The node tree under the default scene, parents first, each mesh's primitives staged.
WB_STACK :: 4096;
wb_scene :: (w: []Wb, g: []Gltf, iw: []ImgWork, objects: string, scratch: string, m: int) {
  stack: [WB_STACK] int; mats: [WB_STACK] [4][4] f64; top := 0;
  ident: [4][4] f64; for r: 0..<4 { for c: 0..<4 { ident[r][c] = ifx r == c then 1.0 else 0.0; } }
  scenes := gl_get(g, 0, "scenes");
  if gl_len(g, scenes) > 0 {
    sc := gl_item(g, scenes, gl_int(g, 0, "scene", 0));
    roots := gl_get(g, sc, "nodes");
    for k: 0..<gl_len(g, roots) { stack[top] = pint(gl_raw(g, gl_item(g, roots, k))); mats[top] = ident; top += 1; }
  } else {
    child: [GL_ARR] bool;
    for i: 0..<g[0].nx[GA_NODE] { ch := gl_get(g, g[0].ix[GA_NODE][i], "children"); for c: 0..<gl_len(g, ch) { child[pint(gl_raw(g, gl_item(g, ch, c)))] = true; } }
    for i: 0..<g[0].nx[GA_NODE] { if !child[i] { stack[top] = i; mats[top] = ident; top += 1; } }
  }
  while top > 0 {
    top -= 1; ni := stack[top]; parent := mats[top];
    node := gl_at(g, GA_NODE, ni);
    world := mmul4(parent, wb_local(g, node));
    mesh := gl_int(g, node, "mesh", -1);
    if mesh >= 0 {
      prs := gl_get(g, gl_at(g, GA_MESH, mesh), "primitives");
      for p: 0..<gl_len(g, prs) { wb_primitive(w, g, iw, objects, scratch, m, gl_item(g, prs, p), world); }
    }
    ch := gl_get(g, node, "children");
    for c: 0..<gl_len(g, ch) { if top >= WB_STACK { ph_die("worldbuilder pack: a node tree past the tool's stack"); } stack[top] = pint(gl_raw(g, gl_item(g, ch, c))); mats[top] = world; top += 1; }
  }
}
// The size a kit is packed at: the Ultimate Animals are made about three times life size (a horse
// 4.8 m tall), so they shrink to 0.35 (a horse 1.7 m, a cow 2.8 m long); Stylized Nature is made
// about twice the village's scale (grass 1.3 m, flowers 1.5 m), so it shrinks to 0.6; everything
// else as made. Uniform, so normals keep their direction; applied before the bounds, so the pack
// and both catalogues agree.
WB_ANIMAL_SCALE :: 0.35; WB_NATURE_SCALE :: 0.6;
wb_scale :: (name: string) -> f64 {
  if starts(name, "ultimate-animals-static/") { return WB_ANIMAL_SCALE; }
  if starts(name, "nature/") { return WB_NATURE_SCALE; }
  return 1.0;
}
#test "the animals and the nature kit shrink to the village scale; nothing else is scaled" {
  #assert wb_scale("ultimate-animals-static/horse") == 0.35 && wb_scale("bestiary-dungeon/imp") == 1.0 && wb_scale("nature/birch-1") == 0.6;
  #assert wb_scale("village/door-1-flat") == 1.0 && wb_scale("ultimate-food/apple") == 1.0 && wb_scale("naturex/a") == 1.0;
  r := wb_recentre([6] f64.[-0.705 * wb_scale("ultimate-animals-static/horse"), 0.0, -2.84 * 0.35, 0.705 * 0.35, 4.82 * 0.35, 2.84 * 0.35]);
  #assert abs(r[4] - 1.687) < 0.001 && abs(r[5] - r[2] - 1.988) < 0.001;
}
// A model's material colours by name, when its own glTF has none
Cols :: struct { n: int; name: [64] string; factor: [64] [4] f64; b: [8192] u8; nb: int; }
cols_add :: (c: []Cols, name: string, f: [4] f64) {
  if c[0].n >= 64 || c[0].nb + name.count > c[0].b.count { return; }
  for k: 0..<name.count { c[0].b[c[0].nb + k] = name[k]; }
  c[0].name[c[0].n] = cast(string) c[0].b[c[0].nb..<c[0].nb + name.count]; c[0].nb += name.count;
  c[0].factor[c[0].n] = f; c[0].n += 1;
}
// For a static animal, its animated export's material colours (name and baseColorFactor); none else.
wb_animal_colours :: (w: []Wb, objects: string, name: string) {
  if !starts(name, "ultimate-animals-static/") { return; }
  animal := name["ultimate-animals-static/".count..<name.count]; sha := "";
  for k: 0..<w[0].nanim { if w[0].anim_name[k] == animal { sha = w[0].anim_gltf[k]; } }
  if sha.count == 0 { ph_die2("worldbuilder pack: no ultimate-animals glTF for ", name); }
  n := fs_read(wb_path(w, objects, sha), w[0].ctext[..]);
  if n < 0 || n >= w[0].ctext.count { ph_die2("worldbuilder pack: can't read the glTF export of ", name); }
  if !jv_parse(w[0].cd[..], cast(string) w[0].ctext[0..<n], w[0].cn[..]) { ph_die2("worldbuilder pack: bad JSON in the glTF export of ", name); }
  wb_colours_from(w[0].col[..], w[0].cd[0]);
}
wb_colours_from :: (cl: []Cols, d: Jv) {
  mats := jv_get(d, 0, "materials");
  for k: 0..<jv_len(d, mats) {
    mt := jv_at(d, mats, k); f := jv_get(d, jv_get(d, mt, "pbrMetallicRoughness"), "baseColorFactor");
    if f < 0 || jv_len(d, f) != 4 { continue; }
    c: [4] f64; for q: 0..<4 { c[q] = pf(jv_raw(d, jv_at(d, f, q))); }
    cols_add(cl, jv_raw(d, jv_get(d, mt, "name")), c);
  }
}
// The Modular Dungeon, Ultimate Food and Ultimate RPG GLBs (observed from their Blender files) lose
// their materials' colours too; the kits' own OBJ exports keep them in an .mtl beside the model,
// in the package's original snapshot: `newmtl NAME` then `Kd R G B`, linear as glTF's factors.
// Nothing when there is no such file, or when the table is already filled.
wb_mtl_colours :: (w: []Wb, objects: string, revision: string, model: string) {
  if w[0].col[0].n > 0 || revision.count == 0 || model.count == 0 { return; }
  pb: [2048] u8; o: [1] Sb; o[0] = sb(pb[..]);
  sb_put(o[..], dir_name(objects)); sb_put(o[..], "/originals/"); sb_put(o[..], revision); sb_put(o[..], "/source/OBJ/"); sb_put(o[..], model); sb_put(o[..], ".mtl");
  if !fs_exists(sb_text(o[..])) { return; }
  n := fs_read(sb_text(o[..]), w[0].ctext[..]);
  if n < 0 || n >= w[0].ctext.count { ph_die2("worldbuilder pack: can't read ", sb_text(o[..])); }
  wb_mtl_parse(w[0].col[..], cast(string) w[0].ctext[0..<n]);
}
wb_mtl_parse :: (cl: []Cols, text: string) {
  at := 0; current := "";
  while at < text.count {
    e := at; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[at..<e]; at = e + 1;
    if line.count > 0 && line[line.count - 1] == '\r' { line = line[0..<line.count - 1]; }
    if starts(line, "newmtl ") { current = line[7..<line.count]; continue; }
    if starts(line, "Kd ") && current.count > 0 {
      c := [4] f64.[1.0, 1.0, 1.0, 1.0]; k := 0; i := 3;
      while i < line.count && k < 3 {
        while i < line.count && line[i] == ' ' { i += 1; }
        j := i; while j < line.count && line[j] != ' ' { j += 1; }
        if j > i { c[k] = pf(line[i..<j]); k += 1; }
        i = j;
      }
      if k == 3 { cols_add(cl, current, c); }
      current = "";
    }
  }
}
#test "an OBJ export's .mtl gives each material its Kd" {
  w: [1] Cols;
  wb_mtl_parse(w[..], "# Blender MTL\nnewmtl DarkRed\nNs 96.0\nKd 0.106287 0.022293 0.015061\nd 1.0\n\nnewmtl Leaf\r\nKd 0.25 0.5 0.125\r\n");
  c: [1] [4] f64;
  #assert w[0].n == 2 && wb_colour_of(w[..], "DarkRed", c[..]) && abs(c[0][0] - 0.106287) < 0.0000001 && abs(c[0][2] - 0.015061) < 0.0000001;
  #assert wb_colour_of(w[..], "Leaf", c[..]) && c[0][1] == 0.5 && !wb_colour_of(w[..], "Ns", c[..]);
}
// a material's colour from that table, by name (false when it names none)
wb_colour_of :: (cl: []Cols, name: string, out: [][4] f64) -> bool {
  for k: 0..<cl[0].n { if cl[0].name[k] == name { out[0] = cl[0].factor[k]; return true; } }
  return false;
}
#test "a static animal's materials take their colours from its export, by name" {
  w: [1] Cols; d: [1] Jv; nodes: [64] JvNode;
  text := "{\"materials\":[{\"name\":\"Main\",\"pbrMetallicRoughness\":{\"baseColorFactor\":[0.25,0.5,0.125,1]}},{\"name\":\"Eyes\"}]}";
  #assert jv_parse(d[..], text, nodes[..]);
  wb_colours_from(w[..], d[0]);
  c: [1] [4] f64;
  #assert w[0].n == 1 && wb_colour_of(w[..], "Main", c[..]) && c[0][0] == 0.25 && c[0][1] == 0.5 && c[0][2] == 0.125;
  #assert !wb_colour_of(w[..], "Eyes", c[..]) && !wb_colour_of(w[..], "Hooves", c[..]);
}
// Model m: loaded, staged, recentred and written to the pack's vertices and indices.
wb_model :: (w: []Wb, g: []Gltf, iw: []ImgWork, objects: string, scratch: string, m: int) {
  if !jv_parse(w[0].jd[..], w[0].line[m], w[0].jn[..]) { ph_die("worldbuilder pack: a registry line no longer parses"); }
  d := w[0].jd[0]; arts := jv_path(d, 0, "definition.artifacts");
  path := "";
  for k: 0..<jv_len(d, arts) {
    a := jv_at(d, arts, k); f := jv_raw(d, jv_get(d, a, "format")); sha := jv_raw(d, jv_get(d, a, "sha256"));
    if f == "glb" { path = wb_path(w, objects, sha); }
  }
  if path.count == 0 {
    // a .gltf: it and its buffers under their own names in the scratch directory
    for k: 0..<jv_len(d, arts) {
      a := jv_at(d, arts, k); f := jv_raw(d, jv_get(d, a, "format"));
      if f == "image" { continue; }
      nm := jv_raw(d, jv_get(d, a, "source_name")); to := wb_path(w, scratch, nm);
      n := fs_read(wb_path(w, objects, jv_raw(d, jv_get(d, a, "sha256"))), iw[0].file[..]);
      if n < 0 { ph_die2("worldbuilder pack: a missing object for ", nm); }
      if !fs_write(to, cast(string) iw[0].file[0..<n]) { ph_die2("worldbuilder pack: can't write ", to); }
      if f == "gltf" { path = to; }
    }
  }
  if path.count == 0 { ph_die2("worldbuilder pack: no glTF for ", w[0].name[m]); }
  w[0].col[0].n = 0; w[0].col[0].nb = 0;
  wb_animal_colours(w, objects, w[0].name[m]);
  wb_mtl_colours(w, objects, jv_raw(d, jv_path(d, 0, "definition.package_revision")), jv_raw(d, jv_path(d, 0, "definition.name")));
  gl_load(g, path);
  for k: 0..<g[0].nx[GA_IMG] { w[0].imgl[k] = -2; }
  w[0].ns = 0; w[0].nsi = 0;
  wb_scene(w, g, iw, objects, scratch, m);
  if w[0].ns == 0 || w[0].nsi == 0 { ph_die2("worldbuilder pack: no triangles in ", w[0].name[m]); }
  scale := wb_scale(w[0].name[m]);
  for q: 0..<w[0].ns * 3 { w[0].sp[q] *= scale; }
  box := [6] f64.[1e30, 1e30, 1e30, -1e30, -1e30, -1e30];
  for s: 0..<w[0].ns { for c: 0..<3 { p := w[0].sp[s * 3 + c]; if p < box[c] { box[c] = p; } if p > box[c + 3] { box[c + 3] = p; } } }
  r := wb_recentre(box);
  dx := r[0] - box[0]; dy := 0.0 - box[1]; dz := r[2] - box[2];
  if w[0].nv + w[0].ns > WB_VMAX || w[0].ni + w[0].nsi > WB_IMAX { ph_die("worldbuilder pack: the pack past the tool's store"); }
  v0 := w[0].nv;
  for s: 0..<w[0].ns {
    p := [3] f64.[w[0].sp[s * 3] + dx, w[0].sp[s * 3 + 1] + dy, w[0].sp[s * 3 + 2] + dz];
    n := [3] f64.[w[0].sn[s * 3], w[0].sn[s * 3 + 1], w[0].sn[s * 3 + 2]];
    rgb := [3] int.[w[0].sc[s * 3], w[0].sc[s * 3 + 1], w[0].sc[s * 3 + 2]];
    wb_vertex(w[0].v[..], (v0 + s) * 16, p, r, n, [2] f64.[w[0].suv[s * 2], w[0].suv[s * 2 + 1]], rgb, w[0].sl[s]);
  }
  w[0].nv = v0 + w[0].ns;
  w[0].mfirst[m] = w[0].ni; w[0].mcount[m] = w[0].nsi; w[0].mbox[m] = r; w[0].mverts[m] = w[0].ns;
  for k: 0..<w[0].nsi { wb_put(w[0].i[..], (w[0].ni + k) * 4, v0 + w[0].si[k]); }
  w[0].ni += w[0].nsi;
}

// ---- text
// a number with up to 3 decimals, trailing zeros dropped
wb_num :: (o: []Sb, x: f64, n: int) {
  t: [256] u8; s := pn_fixed_text(x, n, t[..]);
  if has(s, ".") { e := s.count; while s[e - 1] == '0' { e -= 1; } if s[e - 1] == '.' { e -= 1; } s = s[0..<e]; }
  if s == "-0" { s = "0"; }
  sb_put(o, s);
}
// The catalogue's tags, only words the name doesn't already say (the whole file goes into every
// model prompt): "tree" for the nature kit's trees, then the kit's kind of thing.
WB_TREES :: [8] string.["birch", "pine", "giantpine", "commontree", "deadtree", "twistedtree", "cherryblossom", "tallthick"];
wb_tags :: (o: []Sb, name: string) {
  slash := 0; while name[slash] != '/' { slash += 1; }
  kit := name[0..<slash];
  tree := false;
  i := slash + 1;
  while i <= name.count {
    e := i; while e < name.count && name[e] != '-' { e += 1; }
    for t: WB_TREES { if name[i..<e] == t { tree = true; } }
    i = e + 1;
  }
  cat := ifx kit == "village" then "building" else ifx kit == "ultimate-food" then "food" else ifx kit == "ultimate-rpg" then "item"
    else ifx kit == "fantasy-props" then "prop" else ifx kit == "ultimate-animals-static" then "animal" else ifx kit == "bestiary-dungeon" then "monster" else "";
  if tree { sb_put(o, "tree"); if cat.count > 0 { sb_byte(o, ' '); } }
  sb_put(o, cat);
}
#test "catalogue tags add only what the name doesn't say" {
  b: [256] u8; o: [1] Sb; o[0] = sb(b[..]);
  wb_tags(o[..], "nature/birch-1"); #assert sb_text(o[..]) == "tree";
  o[0].n = 0; wb_tags(o[..], "ultimate-food/donut1"); #assert sb_text(o[..]) == "food";
  o[0].n = 0; wb_tags(o[..], "village/door-1-flat"); #assert sb_text(o[..]) == "building";
  o[0].n = 0; wb_tags(o[..], "nature/rock-big-1"); #assert sb_text(o[..]) == "";
}

// gzip: a 10-byte header, the raw DEFLATE stream, CRC-32 and the size mod 2^32
wb_gzip :: (src: []u8, out: []u8, dw: []DeflateWork) -> int {
  head := [10] u8.[31, 139, 8, 0, 0, 0, 0, 0, 0, 255];
  for k: 0..<10 { out[k] = head[k]; }
  n := deflate_raw(cast(string) src, out[10..<out.count - 8], dw);
  if n < 0 { return -1; }
  wb_put(out, 10 + n, png_crc(src)); wb_put(out, 14 + n, src.count & 4294967295);
  return n + 18;
}
#test "gzip framing round-trips through inflate" {
  src := "worldbuilder worldbuilder worldbuilder pack";
  dw: [1] DeflateWork; z: [256] u8; back: [256] u8; sb_: [64] u8;
  for k: 0..<src.count { sb_[k] = src[k]; }
  bytes := sb_[0..<src.count];
  n := wb_gzip(bytes, z[..], dw[..]);
  #assert n > 18 && z[0] == 31 && z[1] == 139 && z[2] == 8;
  m := inflate(z[10..<n - 8], back[..]);
  #assert m == src.count && cast(string) back[0..<m] == src;
  #assert wb_get(z[..], n - 8) == png_crc(bytes) && wb_get(z[..], n - 4) == src.count;
}

WbOut :: struct { pack: [WB_BUDGET] u8; gz: [WB_BUDGET] u8; cat: [1048576] u8; list: [262144] u8; hdr: [524288] u8; dw: [1] DeflateWork; }
wb_entry :: (b: []u8, k: int, kind: int, lic: int, name: string, off: int, n: int) {
  r := 32 + k * 48;
  for q: 0..<48 { b[r + q] = 0; }
  b[r] = cast(u8) kind; b[r + 1] = cast(u8) lic; wb_put(b, r + 4, off); wb_put(b, r + 8, n);
  for q: 0..<name.count { if q < 31 { b[r + 16 + q] = name[q]; } }
}
// the catalog text with the file's size it names
wb_catalog :: (w: []Wb, o: []Sb, total: int) {
  o[0].n = 0;
  sb_put(o, "pack worldbuilder\nbudget "); sb_int(o, WB_BUDGET); sb_put(o, "\nbytes "); sb_int(o, total); sb_byte(o, '\n');
  sb_put(o, "L 0 Quaternius Medieval Village, Ultimate Food, Modular Dungeon, Stylized Nature, Ultimate RPG, Fantasy Props and Ultimate Animals|CC0 1.0 Universal|https://quaternius.com/\n");
  sb_put(o, "L 1 Quaternius Bestiary Dungeon Monsters|Quaternius Asset License v1.0|https://quaternius.com/license.html\n");
  for m: 0..<w[0].nm {
    sb_put(o, "M "); sb_put(o, w[0].name[m]); sb_byte(o, ' '); sb_int(o, w[0].mfirst[m]); sb_byte(o, ' '); sb_int(o, w[0].mcount[m]); sb_byte(o, ' '); sb_int(o, w[0].lic[m]);
    for c: 0..<6 { sb_byte(o, ' '); wb_num(o, w[0].mbox[m][c], 3); }
    sb_byte(o, '\n');
  }
  for k: 0..<w[0].nl { sb_put(o, "T "); sb_int(o, k); sb_byte(o, ' '); sb_put(o, w[0].lsrc[k]); sb_byte(o, ' '); sb_int(o, w[0].llic[k]); sb_byte(o, '\n'); }
}
wb_align :: (x: int) -> int { return (x + 3) / 4 * 4; }

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) || args_count(args[..]) != 2 { tool_errln("worldbuilder pack: OBJECTS SCRATCH (from the repository's root)"); return 2; }
  objects := args_at(args[..], 0); scratch := args_at(args[..], 1);
  if !fs_exists(scratch) && !fs_mkdir(scratch) { ph_die2("worldbuilder pack: can't make ", scratch); }
  w: [1] Wb; g: [1] Gltf; iw: [1] ImgWork; o: [1] WbOut;
  wb_registry(w[..]);
  for m: 0..<w[0].nm { wb_model(w[..], g[..], iw[..], objects, scratch, m); }
  // the pack: catalog, vertices, indices, layers
  count := 3 + w[0].nl;
  cs: [1] Sb; cs[0] = sb(o[0].cat[..]);
  total := 0; guess := 0;
  for round: 0..<4 {
    wb_catalog(w[..], cs[..], guess);
    at := 32 + count * 48;
    at = wb_align(at + cs[0].n); at = wb_align(at + w[0].nv * 16); at = wb_align(at + w[0].ni * 4);
    for k: 0..<w[0].nl { at = wb_align(at + w[0].lenc[k].count); }
    total = at; if total == guess { break; } guess = total;
  }
  if total != guess { ph_die("worldbuilder pack: the catalog's size didn't settle"); }
  if total > WB_BUDGET { print("worldbuilder pack: % bytes, past the % budget\n", total, WB_BUDGET); ph_die("worldbuilder pack: over budget"); }
  b := o[0].pack[..];
  for k: 0..<total { b[k] = 0; }
  b[0] = 'V'; b[1] = 'P'; b[2] = 'K'; b[3] = '1';
  wb_put(b, 4, count); wb_put(b, 8, total); wb_put(b, 12, WB_BUDGET); wb_put(b, 16, 32);
  at := 32 + count * 48; wb_put(b, 20, at);
  body := sb_text(cs[..]);
  wb_entry(b, 0, 1, 0, "catalog", at, body.count); for k: 0..<body.count { b[at + k] = body[k]; } at = wb_align(at + body.count);
  wb_entry(b, 1, 2, 0, "vertices", at, w[0].nv * 16); for k: 0..<w[0].nv * 16 { b[at + k] = w[0].v[k]; } at = wb_align(at + w[0].nv * 16);
  wb_entry(b, 2, 3, 0, "indices", at, w[0].ni * 4); for k: 0..<w[0].ni * 4 { b[at + k] = w[0].i[k]; } at = wb_align(at + w[0].ni * 4);
  for l: 0..<w[0].nl {
    nb: [32] u8; s: [1] Sb; s[0] = sb(nb[..]); sb_put(s[..], "layer"); sb_int(s[..], l);
    e := w[0].lenc[l];
    wb_entry(b, 3 + l, 4, w[0].llic[l], sb_text(s[..]), at, e.count); for k: 0..<e.count { b[at + k] = e[k]; } at = wb_align(at + e.count);
  }
  if at != total { ph_die("worldbuilder pack: the layout moved"); }
  gn := wb_gzip(b[0..<total], o[0].gz[..], o[0].dw[..]);
  if gn < 0 { ph_die("worldbuilder pack: the gzip didn't fit"); }
  out := "apps/openagents-web/realms/create-world/assets";
  _ = fs_mkdir("apps/openagents-web/realms/create-world");
  _ = fs_mkdir(out);
  if !fs_write("apps/openagents-web/realms/create-world/assets/worldbuilder.pack.gz", cast(string) o[0].gz[0..<gn]) { ph_die("worldbuilder pack: can't write the pack"); }
  // the catalogue, and the same as a C string
  ls: [1] Sb; ls[0] = sb(o[0].list[..]);
  hs: [1] Sb; hs[0] = sb(o[0].hdr[..]);
  sb_put(hs[..], "// Written by verse/tools/assets/worldbuilder_pack.coax: the WorldBuilder models, NAME|w,h,d|tags a line.\n");
  sb_put(hs[..], "#define WB_ASSET_COUNT "); sb_int(hs[..], w[0].nm); sb_put(hs[..], "\nstatic const char WB_ASSETS[] =\n");
  for m: 0..<w[0].nm {
    start := ls[0].n;
    sb_put(ls[..], w[0].name[m]); sb_byte(ls[..], '|');
    for c: 0..<3 { if c > 0 { sb_byte(ls[..], ','); } sb_fixed(ls[..], w[0].mbox[m][c + 3] - w[0].mbox[m][c], 2); }
    sb_byte(ls[..], '|'); wb_tags(ls[..], w[0].name[m]);
    line := cast(string) o[0].list[start..<ls[0].n];
    sb_put(ls[..], "\n");
    sb_put(hs[..], "  \""); for c: line { if c == '"' || c == '\\' { sb_byte(hs[..], '\\'); } sb_byte(hs[..], c); } sb_put(hs[..], "\\n\"\n");
  }
  sb_put(hs[..], "  ;\n");
  if ls[0].n >= o[0].list.count || hs[0].n >= o[0].hdr.count { ph_die("worldbuilder pack: the catalogue past its buffer"); }
  if !fs_write("coax/web/api/worldbuilder-assets.txt", sb_text(ls[..])) { ph_die("worldbuilder pack: can't write the catalogue"); }
  if !fs_write("coax/web/api/worldbuilder-assets.h", sb_text(hs[..])) { ph_die("worldbuilder pack: can't write the catalogue header"); }
  big := 0; bigm := 0; for m: 0..<w[0].nm { if w[0].mverts[m] > big { big = w[0].mverts[m]; bigm = m; } }
  layer_bytes_total := 0; for l: 0..<w[0].nl { layer_bytes_total += w[0].lenc[l].count; }
  print("worldbuilder: % models, % vertices (% bytes), % indices (% bytes), % layers (% bytes), catalog % bytes\n", w[0].nm, w[0].nv, w[0].nv * 16, w[0].ni, w[0].ni * 4, w[0].nl, layer_bytes_total, body.count);
  print("worldbuilder: pack % bytes, gzipped % bytes; catalogue % bytes; largest model % (% vertices); % primitives skipped\n", total, gn, ls[0].n, w[0].name[bigm], big, w[0].skipped);
  // per kit
  for c: WB_COLLECTIONS {
    nv := 0; ni := 0; nm := 0;
    for m: 0..<w[0].nm { if starts(w[0].name[m], c) && w[0].name[m][c.count] == '/' { nv += w[0].mverts[m]; ni += w[0].mcount[m]; nm += 1; } }
    print("  %: % models, % vertex bytes, % index bytes\n", c, nm, nv * 16, ni * 4);
  }
  return 0;
}
