// The human pack tool's shared pieces (pack_human.coax): errors, text, the containers the Python
// tools leaned on, made so their iteration orders are Python's, and small vector maths in the
// Python's order of operations. A weight dictionary keeps its keys in insertion order (a dict's);
// a neighbour set iterates in CPython's hash table order for small ints (setobject.c: hash i,
// linear probes of 9, perturbed steps, resized to 4x its use at three fifths full), so sums over
// them add in the same order and the packs come out the same, byte for byte.
#load "ph_num.coax";

exit :: (code: s32) #foreign #effects(all);
atan2 :: (y: f64, x: f64) -> f64 #foreign #effects(all);
acos :: (x: f64) -> f64 #foreign #effects(all);
ceil :: (x: f64) -> f64 #foreign #effects(all);
PH_PI :: 3.141592653589793;

// ---- fatal errors (Python's SystemExit): the message on stderr, exit status 1
ph_die :: (msg: string) { tool_errln(msg); exit(1); }
ph_die2 :: (a: string, b: string) { tool_err(a); tool_errln(b); exit(1); }

// ---- text into a caller's buffer (Sb), and an arena keeping names and paths for the run
Sb :: struct { buf: []u8; n: int; }
sb :: (buf: []u8) -> Sb { r: Sb; r.buf = buf; return r; }
sb_put :: (o: []Sb, s: string) { for c: s { if o[0].n < o[0].buf.count { o[0].buf[o[0].n] = c; o[0].n += 1; } } }
sb_byte :: (o: []Sb, c: u8) { if o[0].n < o[0].buf.count { o[0].buf[o[0].n] = c; o[0].n += 1; } }
sb_text :: (o: []Sb) -> string { return cast(string) o[0].buf[0..<o[0].n]; }
sb_int :: (o: []Sb, v: int) {
  if v < 0 { sb_byte(o, '-'); sb_int(o, 0 - v); return; }
  t: [24] u8; k := 0; x := v;
  while true { t[k] = cast(u8) (48 + x % 10); k += 1; x = x / 10; if x == 0 { break; } }
  while k > 0 { k -= 1; sb_byte(o, t[k]); }
}
// "%.nf" % x
sb_fixed :: (o: []Sb, x: f64, n: int) { t: [2048] u8; sb_put(o, pn_fixed_text(x, n, t[..])); }
// f"{x:.n%}": x times 100, "%.nf", and a percent sign
sb_pct :: (o: []Sb, x: f64, n: int) { sb_fixed(o, x * 100.0, n); sb_byte(o, '%'); }
sb_line :: (o: []Sb) { print("%\n", sb_text(o)); o[0].n = 0; }

TXT_MAX :: 8388608;
Txt :: struct { n: int; b: [TXT_MAX] u8; }
txt_keep :: (t: []Txt, s: string) -> string {
  if t[0].n + s.count > TXT_MAX { ph_die("pack_human: the text arena is full"); }
  a := t[0].n;
  for i: 0..<s.count { t[0].b[a + i] = s[i]; }
  t[0].n = a + s.count;
  return cast(string) t[0].b[a..<a + s.count];
}
txt_cat :: (t: []Txt, a: string, b: string) -> string {
  x := txt_keep(t, a); y := txt_keep(t, b);
  return cast(string) t[0].b[t[0].n - a.count - b.count..<t[0].n];
}
txt_cat3 :: (t: []Txt, a: string, b: string, c: string) -> string {
  x := txt_keep(t, a); y := txt_keep(t, b); z := txt_keep(t, c);
  n := a.count + b.count + c.count;
  return cast(string) t[0].b[t[0].n - n..<t[0].n];
}

// ---- strings
starts :: (s: string, p: string) -> bool { return s.count >= p.count && s[0..<p.count] == p; }
ends :: (s: string, p: string) -> bool { return s.count >= p.count && s[s.count - p.count..<s.count] == p; }
has :: (s: string, p: string) -> bool {
  if p.count == 0 { return true; }
  i := 0; while i + p.count <= s.count { if s[i..<i + p.count] == p { return true; } i += 1; }
  return false;
}
lower_into :: (s: string, out: []u8) -> string {
  for i: 0..<s.count { c := s[i]; out[i] = ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
  return cast(string) out[0..<s.count];
}
// s.split("_")[k], "" when there is none
part :: (s: string, k: int) -> string {
  n := 0; a := 0;
  for i: 0..<s.count + 1 {
    if i == s.count || s[i] == '_' { if n == k { return s[a..<i]; } n += 1; a = i + 1; }
  }
  return "";
}
// the file name of a path, and its stem (the name without its last suffix)
base_name :: (p: string) -> string { i := p.count; while i > 0 && p[i - 1] != '/' { i -= 1; } return p[i..<p.count]; }
dir_name :: (p: string) -> string { i := p.count; while i > 0 && p[i - 1] != '/' { i -= 1; } return ifx i > 1 then p[0..<i - 1] else p[0..<i]; }
stem :: (p: string) -> string {
  b := base_name(p); i := b.count;
  while i > 0 && b[i - 1] != '.' { i -= 1; }
  return ifx i > 1 then b[0..<i - 1] else b;
}
// Python's str < str (bytes compared, then length)
str_less :: (a: string, b: string) -> bool {
  n := ifx a.count < b.count then a.count else b.count;
  for i: 0..<n { if a[i] != b[i] { return a[i] < b[i]; } }
  return a.count < b.count;
}

// ---- reading numbers from text: Python's float() (correctly rounded; a fast exact path first)
PF_TEN :: [23] f64.[1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0, 1000000000000000000000.0, 10000000000000000000000.0];
pf :: (s: string) -> f64 {
  // Clinger's fast path: at most 15 significant digits and a power of ten under 10^23, both exact
  i := 0; neg := false;
  if i < s.count && (s[i] == '-' || s[i] == '+') { neg = s[i] == '-'; i += 1; }
  m := 0; nd := 0; e := 0; dot := false; ok := i < s.count;
  while i < s.count {
    c := s[i];
    if c >= '0' && c <= '9' {
      if m > 0 || c != '0' { nd += 1; }
      if nd > 15 { ok = false; break; }
      m = m * 10 + cast(int) c - 48;
      if dot { e -= 1; }
      i += 1;
    } else if c == '.' && !dot { dot = true; i += 1; }
    else { break; }
  }
  if ok && i < s.count && (s[i] == 'e' || s[i] == 'E') {
    i += 1; en := false; ev := 0; any := false;
    if i < s.count && (s[i] == '-' || s[i] == '+') { en = s[i] == '-'; i += 1; }
    while i < s.count && s[i] >= '0' && s[i] <= '9' && ev < 1000 { ev = ev * 10 + cast(int) s[i] - 48; any = true; i += 1; }
    if !any { ok = false; }
    e += ifx en then -ev else ev;
  }
  if ok && i == s.count && e >= -22 && e <= 22 {
    v := cast(f64) m;
    v = ifx e >= 0 then v * PF_TEN[e] else v / PF_TEN[0 - e];
    return ifx neg then -v else v;
  }
  r := pn_parse(s);
  if !r.ok { ph_die2("pack_human: not a number: ", s); }
  return r.v;
}
pint :: (s: string) -> int {
  if s.count == 0 { ph_die("pack_human: an empty number"); }
  return pn_int(s);
}

// lines and words
Lines :: struct { text: string; at: int; }
lines_next :: (l: []Lines) -> string {
  if l[0].at >= l[0].text.count { return ""; }
  i := l[0].at; j := i;
  while j < l[0].text.count && l[0].text[j] != '\n' { j += 1; }
  l[0].at = j + 1;
  e := j; if e > i && l[0].text[e - 1] == '\r' { e -= 1; }
  return l[0].text[i..<e];
}
lines_done :: (l: Lines) -> bool { return l.at >= l.text.count; }
// whitespace-separated words of a line, one at a time
Words :: struct { s: string; at: int; }
words :: (s: string) -> Words { r: Words; r.s = s; return r; }
word :: (w: []Words) -> string {
  s := w[0].s; k := w[0].at;
  while k < s.count && (s[k] == ' ' || s[k] == '\t' || s[k] == '\r') { k += 1; }
  a := k; while k < s.count && s[k] != ' ' && s[k] != '\t' && s[k] != '\r' { k += 1; }
  w[0].at = k;
  return s[a..<k];
}

// ---- a dict of joint weights {joint: weight}: keys in insertion order
WDK :: 72;
Wd :: struct { n: int; k: [WDK] u8; v: [WDK] f64; }
wd_find :: (w: Wd, k: int) -> int { for i: 0..<w.n { if cast(int) w.k[i] == k { return i; } } return -1; }
wd_get :: (w: Wd, k: int) -> f64 { i := wd_find(w, k); return ifx i >= 0 then w.v[i] else 0.0; }
// d[k] = d.get(k, 0.0) + v
wd_add :: (w: []Wd, k: int, v: f64) {
  i := wd_find(w[0], k);
  if i >= 0 { w[0].v[i] = w[0].v[i] + v; return; }
  if w[0].n >= WDK || k < 0 || k > 255 { ph_die("pack_human: a weight dict past the port's size"); }
  w[0].k[w[0].n] = cast(u8) k; w[0].v[w[0].n] = 0.0 + v; w[0].n += 1;
}
// d[k] = v (an existing key keeps its place)
wd_set :: (w: []Wd, k: int, v: f64) {
  i := wd_find(w[0], k);
  if i >= 0 { w[0].v[i] = v; return; }
  if w[0].n >= WDK || k < 0 || k > 255 { ph_die("pack_human: a weight dict past the port's size"); }
  w[0].k[w[0].n] = cast(u8) k; w[0].v[w[0].n] = v; w[0].n += 1;
}
wd_one :: (k: int, v: f64) -> Wd { w: [1] Wd; wd_set(w[..], k, v); return w[0]; }
// sum(d.values())
wd_total :: (w: Wd) -> f64 { s: [1] PnSum; for i: 0..<w.n { pn_add(s[..], w.v[i]); } return pn_total(s[0]); }
// {k: v / t for k, v in d.items()}
wd_div :: (w: Wd, t: f64) -> Wd { r := w; for i: 0..<w.n { r.v[i] = w.v[i] / t; } return r; }
// sorted(d.items(), key=lambda kv: -kv[1]) (stable): the item positions, heaviest first
wd_order :: (w: Wd, order: []int) {
  n := w.n;
  for i: 0..<n { order[i] = i; }
  for i: 1..<n {
    x := order[i]; j := i - 1;
    while j >= 0 && 0.0 - w.v[order[j]] > 0.0 - w.v[x] { order[j + 1] = order[j]; j -= 1; }
    order[j + 1] = x;
  }
}

// A short list of (joint, weight) pairs: a vertex's "ws" (at most 4 in every source here).
WL :: 8;
Wl :: struct { n: int; j: [WL] int; w: [WL] f64; }
wl_add :: (l: []Wl, j: int, w: f64) {
  if l[0].n >= WL { ph_die("pack_human: more weights on a point than the port holds"); }
  l[0].j[l[0].n] = j; l[0].w[l[0].n] = w; l[0].n += 1;
}
// top = sorted(d.items(), key=-v)[:4]; t = sum(w for _, w in top) or 1.0; [(j, w / t) for j, w in top]
wl_top4 :: (d: Wd) -> Wl {
  o: [WDK] int; wd_order(d, o[..]);
  n := ifx d.n < 4 then d.n else 4;
  s: [1] PnSum; for i: 0..<n { pn_add(s[..], d.v[o[i]]); }
  t := ifx n == 0 then 0.0 else pn_total(s[0]);
  if t == 0.0 { t = 1.0; }
  r: Wl; for i: 0..<n { r.j[i] = cast(int) d.k[o[i]]; r.w[i] = d.v[o[i]] / t; } r.n = n;
  return r;
}
// dict(ws)
wl_dict :: (l: Wl) -> Wd { w: [1] Wd; for i: 0..<l.n { wd_set(w[..], l.j[i], l.w[i]); } return w[0]; }

// ---- CPython's set of small non-negative ints, for its iteration order
PSET_MAX :: 1024;
PySet :: struct { mask: int; fill: int; t: [PSET_MAX] int; }   // -1 empty
pset_clear :: (s: []PySet) { s[0].mask = 7; s[0].fill = 0; for i: 0..<8 { s[0].t[i] = -1; } }
pset_slot :: (s: []PySet, key: int) -> int {
  mask := s[0].mask; i := key & mask; perturb := key;
  while true {
    probes := ifx i + 9 <= mask then 9 else 0;
    j := i;
    while true {
      if s[0].t[j] == -1 || s[0].t[j] == key { return j; }
      if probes == 0 { break; }
      probes -= 1; j += 1;
    }
    perturb = perturb >> 5;
    i = (i * 5 + 1 + perturb) & mask;
  }
  return -1;
}
pset_add :: (s: []PySet, key: int) {
  j := pset_slot(s, key);
  if s[0].t[j] == key { return; }
  s[0].t[j] = key; s[0].fill += 1;
  if s[0].fill * 5 < s[0].mask * 3 { return; }
  used := s[0].fill;
  minused := ifx used > 50000 then used * 2 else used * 4;
  size := 8; while size <= minused { size = size << 1; }
  if size > PSET_MAX { ph_die("pack_human: a set past the port's table"); }
  old: [PSET_MAX] int; om := s[0].mask;
  for i: 0..<om + 1 { old[i] = s[0].t[i]; }
  s[0].mask = size - 1; for i: 0..<size { s[0].t[i] = -1; }
  for i: 0..<om + 1 { if old[i] >= 0 { s[0].t[pset_slot(s, old[i])] = old[i]; } }
}
// its members in iteration order, into out from at; the new end
pset_list :: (s: PySet, out: []int, at: int) -> int { n := at; for i: 0..<s.mask + 1 { if s.t[i] >= 0 { out[n] = s.t[i]; n += 1; } } return n; }

// ---- neighbour sets: per node, the set its insertions made, kept as its iteration order (CSR).
// Build: nb_start, then nb_ins(a, b) in the Python's order (set.update((b, c)) is two inserts),
// then nb_finish turns each node's insertions into its set's iteration order.
NB_NODES :: 200000; NB_INS :: 1200000;
Nbr :: struct {
  n: int; m: int;
  from: [NB_INS] int; to: [NB_INS] int;     // the insertions, in order
  start: [NB_NODES + 1] int; list: [NB_INS] int;
}
nb_start :: (g: []Nbr, n: int) { if n > NB_NODES { ph_die("pack_human: more nodes than the port's neighbour table"); } g[0].n = n; g[0].m = 0; }
nb_ins :: (g: []Nbr, a: int, b: int) {
  if g[0].m >= NB_INS { ph_die("pack_human: more neighbours than the port's table"); }
  g[0].from[g[0].m] = a; g[0].to[g[0].m] = b; g[0].m += 1;
}
nb_finish :: (g: []Nbr) {
  n := g[0].n; m := g[0].m;
  // counting sort of the insertions by node, keeping their order: per node its insertions
  for i: 0..<n + 1 { g[0].start[i] = 0; }
  for e: 0..<m { g[0].start[g[0].from[e] + 1] += 1; }
  for i: 0..<n { g[0].start[i + 1] += g[0].start[i]; }
  // place into list (stable), using to as the source and list as the destination
  at: [1] int;
  fill := g[0].start;   // a copy of the starts as the next place per node
  for e: 0..<m { a := g[0].from[e]; g[0].list[fill[a]] = g[0].to[e]; fill[a] += 1; }
  // each node's set: its insertions through a PySet, its members back in iteration order
  s: [1] PySet; out: [PSET_MAX] int;
  w := 0;
  for i: 0..<n {
    a := g[0].start[i]; b := g[0].start[i + 1];
    pset_clear(s[..]);
    for e: a..<b { pset_add(s[..], g[0].list[e]); }
    k := pset_list(s[0], out[..], 0);
    g[0].start[i] = w;
    for q: 0..<k { g[0].list[w + q] = out[q]; }
    w += k;
  }
  g[0].start[n] = w;
}
nb_count :: (g: []Nbr, i: int) -> int { return g[0].start[i + 1] - g[0].start[i]; }

// ---- an int-tuple (up to 4) to index map, indices in insertion order (a dict's keys)
HM_SIZE :: 524288;
Hmap :: struct { gen: int; n: int; stamp: [HM_SIZE] int; key: [HM_SIZE][4] int; val: [HM_SIZE] int; }
hm_clear :: (h: []Hmap) { h[0].gen += 1; h[0].n = 0; }
hm_hash :: (k: [4] int) -> int {
  x: u64 = 1469598103934665603;
  for i: 0..<4 { x = mul_wrap(x ^ cast,trunc(u64) k[i], 1099511628211); x = x ^ (x >> 29); }
  return cast(int) (x & cast(u64) (HM_SIZE - 1));
}
// the key's index, adding it (index n) when new
hm_put :: (h: []Hmap, k: [4] int) -> int {
  i := hm_hash(k);
  while h[0].stamp[i] == h[0].gen {
    if h[0].key[i][0] == k[0] && h[0].key[i][1] == k[1] && h[0].key[i][2] == k[2] && h[0].key[i][3] == k[3] { return h[0].val[i]; }
    i = (i + 1) & (HM_SIZE - 1);
  }
  if h[0].n >= HM_SIZE / 2 { ph_die("pack_human: a map past the port's table"); }
  h[0].stamp[i] = h[0].gen; h[0].key[i] = k; h[0].val[i] = h[0].n; h[0].n += 1;
  return h[0].val[i];
}
hm_get :: (h: []Hmap, k: [4] int) -> int {
  i := hm_hash(k);
  while h[0].stamp[i] == h[0].gen {
    if h[0].key[i][0] == k[0] && h[0].key[i][1] == k[1] && h[0].key[i][2] == k[2] && h[0].key[i][3] == k[3] { return h[0].val[i]; }
    i = (i + 1) & (HM_SIZE - 1);
  }
  return -1;
}
hm4 :: (a: int, b: int, c: int, d: int) -> [4] int { return [4] int.[a, b, c, d]; }

// ---- small vector maths, in the Python's order (sum() for dot products)
v3 :: (a: f64, b: f64, c: f64) -> [3] f64 { return [3] f64.[a, b, c]; }
vsub :: (a: [3] f64, b: [3] f64) -> [3] f64 { return [3] f64.[a[0] - b[0], a[1] - b[1], a[2] - b[2]]; }
vadd :: (a: [3] f64, b: [3] f64) -> [3] f64 { return [3] f64.[a[0] + b[0], a[1] + b[1], a[2] + b[2]]; }
vscale :: (a: [3] f64, k: f64) -> [3] f64 { return [3] f64.[a[0] * k, a[1] * k, a[2] * k]; }
vdiv :: (a: [3] f64, k: f64) -> [3] f64 { return [3] f64.[a[0] / k, a[1] / k, a[2] / k]; }
vdot :: (a: [3] f64, b: [3] f64) -> f64 { return pn_sum3(a[0] * b[0], a[1] * b[1], a[2] * b[2]); }
vcross :: (a: [3] f64, b: [3] f64) -> [3] f64 { return [3] f64.[a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]; }
// unit(), with the module's fallback for a short vector
vunit :: (a: [3] f64, fb: [3] f64) -> [3] f64 { l := sqrt(vdot(a, a)); if l > 0.000000000001 { return [3] f64.[a[0] / l, a[1] / l, a[2] / l]; } return fb; }
vdist :: (a: [3] f64, b: [3] f64) -> f64 { return pn_dist3(a, b); }
vzero :: () -> [3] f64 { return [3] f64.[0.0, 0.0, 0.0]; }
m3_id :: () -> [3][3] f64 { m: [3][3] f64; m[0][0] = 1.0; m[1][1] = 1.0; m[2][2] = 1.0; return m; }
// sum(a[i][k] * b[k][j] for k in range(3))
mmul3 :: (a: [3][3] f64, b: [3][3] f64) -> [3][3] f64 { r: [3][3] f64; for i: 0..<3 { for j: 0..<3 { r[i][j] = pn_sum3(a[i][0] * b[0][j], a[i][1] * b[1][j], a[i][2] * b[2][j]); } } return r; }
mv3 :: (a: [3][3] f64, v: [3] f64) -> [3] f64 { return [3] f64.[pn_sum3(a[0][0] * v[0], a[0][1] * v[1], a[0][2] * v[2]), pn_sum3(a[1][0] * v[0], a[1][1] * v[1], a[1][2] * v[2]), pn_sum3(a[2][0] * v[0], a[2][1] * v[1], a[2][2] * v[2])]; }
mtr3 :: (a: [3][3] f64) -> [3][3] f64 { r: [3][3] f64; for i: 0..<3 { for j: 0..<3 { r[i][j] = a[j][i]; } } return r; }
vmin :: (a: f64, b: f64) -> f64 { return ifx b < a then b else a; }      // Python min(a, b): the first of equals
vmax :: (a: f64, b: f64) -> f64 { return ifx b > a then b else a; }
imin :: (a: int, b: int) -> int { return ifx b < a then b else a; }
imax :: (a: int, b: int) -> int { return ifx b > a then b else a; }
clamp01 :: (x: f64) -> f64 { return vmin(1.0, vmax(0.0, x)); }

// ---- points in cells, for radius searches (outfits.Near, metahuman.Near)
NEAR_MAX :: 400000;
Near :: struct {
  cell: f64; n: int;
  xs: [NEAR_MAX] [3] f64;
  order: [NEAR_MAX] int;        // point indices by cell, each cell's in index order
  ck: [NEAR_MAX] int;           // per point its cell's key
  uk: [NEAR_MAX] int; us: [NEAR_MAX + 1] int; nu: int;   // the cells: key, first in order
  tmp: [NEAR_MAX] int;
}
near_key :: (cx: int, cy: int, cz: int) -> int { return ((cx + 1048576) << 42) | ((cy + 1048576) << 21) | (cz + 1048576); }
near_cell :: (v: f64, cell: f64) -> int { return pn_floor(v / cell); }
near_build :: (g: []Near, xs: [][3] f64, cell: f64) {
  n := xs.count;
  if n > NEAR_MAX { ph_die("pack_human: more points than a grid holds"); }
  g[0].cell = cell; g[0].n = n;
  for i: 0..<n {
    g[0].xs[i] = xs[i];
    g[0].ck[i] = near_key(near_cell(xs[i][0], cell), near_cell(xs[i][1], cell), near_cell(xs[i][2], cell));
    g[0].order[i] = i;
  }
  ph_sort_ints(g[0].order[0..<n], g[0].ck[0..<n], g[0].tmp[0..<n]);
  g[0].nu = 0;
  for q: 0..<n {
    i := g[0].order[q];
    if g[0].nu == 0 || g[0].uk[g[0].nu - 1] != g[0].ck[i] { g[0].uk[g[0].nu] = g[0].ck[i]; g[0].us[g[0].nu] = q; g[0].nu += 1; }
  }
  g[0].us[g[0].nu] = n;
}
// stable sort of idx by integer keys key[idx]
ph_sort_ints :: (idx: []int, key: []int, tmp: []int) {
  n := idx.count; w := 1;
  while w < n {
    lo := 0;
    while lo < n {
      mid := ifx lo + w < n then lo + w else n; hi := ifx lo + 2 * w < n then lo + 2 * w else n;
      a := lo; b := mid; k := lo;
      while a < mid && b < hi { if key[idx[b]] < key[idx[a]] { tmp[k] = idx[b]; b += 1; } else { tmp[k] = idx[a]; a += 1; } k += 1; }
      while a < mid { tmp[k] = idx[a]; a += 1; k += 1; }
      while b < hi { tmp[k] = idx[b]; b += 1; k += 1; }
      lo += 2 * w;
    }
    for i: 0..<n { idx[i] = tmp[i]; }
    w = w * 2;
  }
}
near_find :: (g: []Near, key: int) -> int {
  lo := 0; hi := g[0].nu - 1;
  while lo <= hi { m := (lo + hi) / 2; if g[0].uk[m] == key { return m; } if g[0].uk[m] < key { lo = m + 1; } else { hi = m - 1; } }
  return -1;
}
// A search's results: (d, i) in the Python's order (cells dx, dy, dz, each in index order), or sorted.
NQ_MAX :: 100000;
Nq :: struct { n: int; d: [NQ_MAX] f64; i: [NQ_MAX] int; td: [NQ_MAX] f64; ti: [NQ_MAX] int; }
near_within :: (g: []Near, x: [3] f64, r: f64, q: []Nq) {
  c0 := near_cell(x[0], g[0].cell); c1 := near_cell(x[1], g[0].cell); c2 := near_cell(x[2], g[0].cell);
  k := cast(int) ceil(r / g[0].cell);
  q[0].n = 0;
  for dx: 0 - k..<k + 1 { for dy: 0 - k..<k + 1 { for dz: 0 - k..<k + 1 {
    u := near_find(g, near_key(c0 + dx, c1 + dy, c2 + dz));
    if u < 0 { continue; }
    for o: g[0].us[u]..<g[0].us[u + 1] {
      i := g[0].order[o];
      d := pn_dist3(g[0].xs[i], x);
      if d <= r { if q[0].n >= NQ_MAX { ph_die("pack_human: a search past the port's results"); } q[0].d[q[0].n] = d; q[0].i[q[0].n] = i; q[0].n += 1; }
    }
  } } }
}
nq_sort :: (q: []Nq) { pn_sort_pairs(q[0].d[0..<q[0].n], q[0].i[0..<q[0].n], q[0].n, q[0].td[..], q[0].ti[..]); }
near_within_sorted :: (g: []Near, x: [3] f64, r: f64, q: []Nq) { near_within(g, x, r, q); nq_sort(q); }
// outfits.Near.nearest: within r, doubling r up to most, the first that finds any (sorted)
near_nearest :: (g: []Near, x: [3] f64, r_in: f64, most: f64, q: []Nq) {
  r := r_in;
  while r <= most { near_within_sorted(g, x, r, q); if q[0].n > 0 { return; } r *= 2.0; }
  q[0].n = 0;
}
