// The human pack's model and writer (pack_human.coax): what a source hands the writer (pieces in
// the rig's rest pose, binds, material tints, layer images) and VPK1 out of it, with the lower
// levels of detail (reduce), tangents, the vertex format, the eyes' blended layers (eye_layers,
// lid_coords) and the layers' images (resized LANCZOS, JPEG at quality 92 or PNG with alpha), as
// the Python tool wrote them. The catalog's lines and the docs are pack_human.coax's header.
#load "ph_gltf.coax";
#load "../../../coax/lib/image/pillow.coax";
#load "../../../coax/lib/image/jpeg_enc.coax";

SPAN :: 2.5; LOW :: -0.25;
JOINTS :: 65;
NONE :: 255;
MAT_SKIN :: 1; MAT_EYE :: 2; MAT_HAIR :: 3; MAT_BROW :: 4; MAT_CLOTH :: 5; MAT_TEETH :: 6; MAT_WET :: 7; MAT_OCCLUSION :: 25;
// MATERIALS: a material's name to its number (clothN: 8 + N)
mat_of :: (name: string) -> int {
  if name == "skin" { return 1; } if name == "eye" { return 2; } if name == "hair" { return 3; } if name == "brow" { return 4; }
  if name == "cloth" { return 5; } if name == "teeth" { return 6; } if name == "wet" { return 7; } if name == "occlusion" { return 25; }
  if starts(name, "cloth") && name.count > 5 { k := pint(name[5..<name.count]); if k >= 0 && k < 17 { return 8 + k; } }
  ph_die2("pack_human: no material ", name);
  return 0;
}
blended :: (m: int) -> bool { return m == MAT_WET || m == MAT_OCCLUSION; }
LODS :: [2] f64.[0.008, 0.025];
PHONE_SIZE :: 1024;
FACE_VERTICES_MAX :: 65536;

// ---- the pack a source fills
PIECES :: 192; IMAGES :: 64; TINTS :: 40;
Piece :: struct { name: string; vf: int; vn: int; tf: int; tn: int; material: int; layers: [3] int; face: string; }
PackImg :: struct { role: string; source: string; path: string; flip: bool; }
Pack :: struct {
  name: string; body: string; licence: string; outfit: string; outfit_base: string;
  np: int; pieces: [PIECES] Piece;
  nb: int; bw: int; binds: [JOINTS][7] f64;
  nt: int; tint_name: [TINTS] string; tint: [TINTS][4] f64;
  ni: int; images: [IMAGES] PackImg;
  face: bool;             // a face rig (ph_face.coax) packs its block from the face pieces
}
// pack.tints[name] = rgba
pack_tint :: (pk: []Pack, name: string, rgba: [4] f64) {
  for i: 0..<pk[0].nt { if pk[0].tint_name[i] == name { pk[0].tint[i] = rgba; return; } }
  if pk[0].nt >= TINTS { ph_die("pack_human: more tints than the port holds"); }
  pk[0].tint_name[pk[0].nt] = name; pk[0].tint[pk[0].nt] = rgba; pk[0].nt += 1;
}
pack_has_tint :: (pk: []Pack, name: string) -> bool { for i: 0..<pk[0].nt { if pk[0].tint_name[i] == name { return true; } } return false; }
// Pack.layer: an image's layer, added once per (role, path); NONE for no image or an empty one
pack_layer :: (pk: []Pack, role: string, path: string, flip: bool, iw: []ImgWork) -> int {
  if path.count == 0 || img_empty(path, iw) { return NONE; }
  for i: 0..<pk[0].ni { if pk[0].images[i].role == role && pk[0].images[i].path == path { return i; } }
  if pk[0].ni >= IMAGES { ph_die("pack_human: more layers than the port holds"); }
  im: PackImg; im.role = role; im.source = base_name(path); im.path = path; im.flip = flip;
  pk[0].images[pk[0].ni] = im; pk[0].ni += 1;
  return pk[0].ni - 1;
}
// Pack.piece: every normal layer is stored green down its image (+v), as scene_fs reads it
pack_piece :: (pk: []Pack, name: string, vf: int, vn: int, tf: int, tn: int, material: string, base: string, normal: string, rough: string, iw: []ImgWork) {
  flip := normal.count > 0 && green_up(normal, iw);
  if pk[0].np >= PIECES { ph_die("pack_human: more pieces than the port holds"); }
  p: Piece; p.name = name; p.vf = vf; p.vn = vn; p.tf = tf; p.tn = tn; p.material = mat_of(material);
  p.layers[0] = pack_layer(pk, "base", base, false, iw);
  p.layers[1] = pack_layer(pk, "normal", normal, flip, iw);
  p.layers[2] = pack_layer(pk, "rough", rough, false, iw);
  pk[0].pieces[pk[0].np] = p; pk[0].np += 1;
}

// ---- images
IW_FILE :: 67108864; IW_WORK :: 134217728; IW_PX :: 67108864; IW_MID :: 33554432; IW_RES :: 16777216; IW_OUT :: 67108864;
ImgWork :: struct {
  file: [IW_FILE] u8; work: [IW_WORK] u8; px: [IW_PX] u8; mid: [IW_MID] u8; res: [IW_RES] u8; out: [IW_OUT] u8;
  r: [1] PiResample; z: [1] PiZ;
  // the last image's emptiness and green, by path
  emptyp: [64] string; emptyv: [64] bool; ne: int;
}
// An image file decoded into iw.px, in its own mode's channels (Image.open: L, RGB, RGBA); a TGA too.
img_load :: (path: string, iw: []ImgWork) -> PiImg {
  n := fs_read(path, iw[0].file[..]);
  if n < 0 || n >= IW_FILE { ph_die2("pack_human: can't read the image ", path); }
  if ends(path, ".tga") || ends(path, ".TGA") {
    t := pi_tga(iw[0].file[0..<n], iw[0].px[..]);
    if !t.ok { ph_die2("pack_human: a TGA the port doesn't read: ", path); }
    return pi_img(iw[0].px[..], t.w, t.h, t.c);
  }
  info := png_info(iw[0].file[0..<n]);
  if info.status != PNG_OK { ph_die2("pack_human: a PNG the port doesn't read: ", path); }
  st := png_decode(iw[0].file[0..<n], iw[0].work[..], iw[0].px[..]);
  if st != PNG_OK { ph_die2("pack_human: a PNG the port couldn't decode: ", path); }
  c := info.channels;
  // RGBA8 down to the file's own channels, in place
  if c != 4 {
    for i: 0..<info.w * info.h {
      if c == 3 { iw[0].px[i * 3] = iw[0].px[i * 4]; iw[0].px[i * 3 + 1] = iw[0].px[i * 4 + 1]; iw[0].px[i * 3 + 2] = iw[0].px[i * 4 + 2]; }
      else if c == 1 { iw[0].px[i] = iw[0].px[i * 4]; }
      else { iw[0].px[i * 2] = iw[0].px[i * 4]; iw[0].px[i * 2 + 1] = iw[0].px[i * 4 + 3]; }
    }
  }
  return pi_img(iw[0].px[..], info.w, info.h, c);
}
// in place: an image's channels to c (convert("RGB"), convert("RGBA"), convert("L"))
img_to :: (im: PiImg, c: int) -> PiImg {
  if im.c == c { return im; }
  n := im.w * im.h;
  if c < im.c {
    for i: 0..<n {
      if c == 1 {
        v := 0;
        if im.c >= 3 { v = (cast(int) im.px[i * im.c] * 19595 + cast(int) im.px[i * im.c + 1] * 38470 + cast(int) im.px[i * im.c + 2] * 7471 + 32768) >> 16; }
        else { v = cast(int) im.px[i * im.c]; }
        im.px[i] = cast(u8) v;
      } else { for k: 0..<c { im.px[i * c + k] = im.px[i * im.c + k]; } }
    }
  } else {
    i := n - 1;
    while i >= 0 {
      for k: 0..<c {
        v: u8 = 255;
        if k < 3 { v = ifx im.c >= 3 then im.px[i * im.c + k] else im.px[i * im.c]; }
        else if im.c == 2 { v = im.px[i * 2 + 1]; }
        im.px[i * c + k] = v;
      }
      i -= 1;
    }
  }
  return pi_img(im.px, im.w, im.h, c);
}
// Image.resize((w, h), filter) of an L, RGB or RGBA image into iw.res
img_resize :: (im: PiImg, w: int, h: int, f: int, iw: []ImgWork) -> PiImg {
  dst := pi_img(iw[0].res[..], w, h, im.c);
  if im.c == 4 {
    if im.w == w && im.h == h { for i: 0..<im.px.count { dst.px[i] = im.px[i]; } return dst; }
    pi_premul(im);
    if !pi_resize(im, dst, f, iw[0].r[..], iw[0].mid[..]) { ph_die("pack_human: an image the port can't resize"); }
    pi_unpremul(dst);
    return dst;
  }
  if !pi_resize(im, dst, f, iw[0].r[..], iw[0].mid[..]) { ph_die("pack_human: an image the port can't resize"); }
  return dst;
}
// empty(): every channel's maximum zero (the export's SRMF maps): no layer
img_empty :: (path: string, iw: []ImgWork) -> bool {
  for i: 0..<iw[0].ne { if iw[0].emptyp[i] == path { return iw[0].emptyv[i]; } }
  im := img_load(path, iw);
  e := true;
  for i: 0..<im.px.count { if im.px[i] != 0 { e = false; break; } }
  if iw[0].ne < 64 { iw[0].emptyp[iw[0].ne] = path; iw[0].emptyv[iw[0].ne] = e; iw[0].ne += 1; }
  return e;
}
// green_up(): whether a tangent-space normal map's green points up its image; of the two readings
// the one whose slopes are a surface's (curl free) is the map's
GN :: 256;
green_up :: (path: string, iw: []ImgWork) -> bool {
  im := img_resize(img_to(img_load(path, iw), 3), GN, GN, PI_BICUBIC, iw);
  nx: [GN * GN] f64; ny: [GN * GN] f64; nz: [GN * GN] f64;
  for i: 0..<GN * GN {
    nx[i] = cast(f64) im.px[i * 3] / 127.5 - 1.0;
    ny[i] = cast(f64) im.px[i * 3 + 1] / 127.5 - 1.0;
    nz[i] = vmax(cast(f64) im.px[i * 3 + 2] / 127.5 - 1.0, 0.2);
  }
  c0 := 0.0; c1 := 0.0;
  for y: 1..<GN - 1 {
    for x: 1..<GN - 1 {
      dgx_dy := ((0.0 - nx[(y + 1) * GN + x]) / nz[(y + 1) * GN + x] + nx[(y - 1) * GN + x] / nz[(y - 1) * GN + x]) * 0.5;
      dny_dx := (ny[y * GN + x + 1] / nz[y * GN + x + 1] - ny[y * GN + x - 1] / nz[y * GN + x - 1]) * 0.5;
      c0 += abs(dny_dx - dgx_dy);
      c1 += abs((0.0 - dny_dx) - dgx_dy);
    }
  }
  return c0 <= c1;
}
// layer_bytes(): the layer's image at size x size: PNG when it has alpha (some under 250), else JPEG 92
layer_bytes :: (path: string, size: int, flip: bool, iw: []ImgWork) -> []u8 {
  im := img_load(path, iw);
  alpha := false;
  if im.c == 4 || im.c == 2 {
    lo := 255;
    for i: 0..<im.w * im.h { a := cast(int) im.px[i * im.c + im.c - 1]; if a < lo { lo = a; } }
    alpha = lo < 250;
  }
  im = img_to(im, ifx alpha then 4 else 3);
  if flip { for i: 0..<im.w * im.h { im.px[i * im.c + 1] = cast(u8) (255 - cast(int) im.px[i * im.c + 1]); } }
  if im.w != size || im.h != size { im = img_resize(im, size, size, PI_LANCZOS, iw); }
  n := 0;
  if alpha {
    n = pi_png(im, iw[0].z[..], iw[0].work[..], iw[0].out[..]);
  } else {
    n = jpe_encode(im.px, im.w, im.h, 3, 92, true, true, iw[0].out[..]);
  }
  if n < 0 { ph_die2("pack_human: couldn't encode the layer ", path); }
  return iw[0].out[0..<n];
}

// ---- the vertex
// a unit vector as two unorm16s (octahedral)
octa :: (n_in: [3] f64) -> int {
  n := vunit(n_in, [3] f64.[0.0, 1.0, 0.0]);
  x := n[0]; y := n[1]; z := n[2];
  s := abs(x) + abs(y) + abs(z);
  x = x / s; y = y / s;
  if z < 0.0 {
    nx := (1.0 - abs(y)) * (ifx x >= 0.0 then 1.0 else -1.0);
    ny := (1.0 - abs(x)) * (ifx y >= 0.0 then 1.0 else -1.0);
    x = nx; y = ny;
  }
  return octa_q(x) | (octa_q(y) << 16);
}
octa_q :: (v: f64) -> int { return imax(0, imin(65535, pn_round((v * 0.5 + 0.5) * 65535.0))); }
// Per vertex a tangent along +u and the bitangent's sign, from the triangles' uvs.
TangentOut :: struct { t: [3] f64; sign: int; }
tangents :: (st: []Store, vf: int, vn: int, tf: int, tn: int, acc_t: [][3] f64, acc_b: [][3] f64, out: []TangentOut) {
  for i: 0..<vn { acc_t[i] = vzero(); acc_b[i] = vzero(); }
  for q: tf..<tf + tn {
    a := st[0].t[q][0]; b := st[0].t[q][1]; c := st[0].t[q][2];
    p0 := st[0].v[vf + a].p; p1 := st[0].v[vf + b].p; p2 := st[0].v[vf + c].p;
    u0 := st[0].v[vf + a].uv; u1 := st[0].v[vf + b].uv; u2 := st[0].v[vf + c].uv;
    e1 := vsub(p1, p0); e2 := vsub(p2, p0);
    du1 := u1[0] - u0[0]; dv1 := u1[1] - u0[1]; du2 := u2[0] - u0[0]; dv2 := u2[1] - u0[1];
    d := du1 * dv2 - du2 * dv1;
    if abs(d) < 0.00000000000001 { continue; }
    r := 1.0 / d;
    t: [3] f64; bt: [3] f64;
    for k: 0..<3 { t[k] = (e1[k] * dv2 - e2[k] * dv1) * r; bt[k] = (e2[k] * du1 - e1[k] * du2) * r; }
    for v: [3] int.[a, b, c] { for k: 0..<3 { acc_t[v][k] += t[k]; acc_b[v][k] += bt[k]; } }
  }
  for i: 0..<vn {
    n := st[0].v[vf + i].n;
    t := acc_t[i];
    t = vsub(t, vscale(n, vdot(n, t)));
    if vdot(t, t) < 0.0000000000000001 {
      t = ifx abs(n[2]) < 0.9 then vcross(n, [3] f64.[0.0, 0.0, 1.0]) else vcross(n, [3] f64.[1.0, 0.0, 0.0]);
    }
    t = vunit(t, [3] f64.[0.0, 1.0, 0.0]);
    out[i].t = t;
    out[i].sign = ifx vdot(vcross(n, t), acc_b[i]) >= 0.0 then 1 else -1;
  }
}
put_u32 :: (b: []u8, at: int, v: int) { b[at] = cast(u8) (v & 255); b[at + 1] = cast(u8) ((v >> 8) & 255); b[at + 2] = cast(u8) ((v >> 16) & 255); b[at + 3] = cast(u8) ((v >> 24) & 255); }
// vertex(): 32 bytes at b[at]
vertex :: (v: PV, tg: TangentOut, material: int, layers: [3] int, b: []u8, at: int) {
  q: [3] int; lo := [3] f64.[0.0 - SPAN / 2.0, LOW, 0.0 - SPAN / 2.0];
  for c: 0..<3 {
    k := (v.p[c] - lo[c]) / SPAN;
    if !(0.0 <= k && k <= 1.0) { ph_die("pack_human: a vertex past the figure's box"); }
    q[c] = pn_round(k * 65535.0);
  }
  u := vmin(vmax(v.uv[0], 0.0), 1.0); w := vmin(vmax(v.uv[1], 0.0), 1.0);
  put_u32(b, at, q[0] | (q[1] << 16));
  put_u32(b, at + 4, q[2] | (material << 16) | ((ifx tg.sign < 0 then 1 else 0) << 31));
  put_u32(b, at + 8, octa(v.n));
  put_u32(b, at + 12, octa(tg.t));
  put_u32(b, at + 16, pn_round(u * 65535.0) | (pn_round(w * 65535.0) << 16));
  for k: 0..<4 { b[at + 20 + k] = v.j[k]; b[at + 24 + k] = v.w[k]; }
  b[at + 28] = cast(u8) layers[0]; b[at + 29] = cast(u8) layers[1]; b[at + 30] = cast(u8) layers[2]; b[at + 31] = cast(u8) material;
}

// ---- levels of detail: vertex clustering (reduce())
// a normal's dominant axis and sign (0..5): clustering keeps a cloth's two sides apart
octant :: (n: [3] f64) -> int {
  k := 0;
  for i: 1..<3 { if abs(n[i]) > abs(n[k]) { k = i; } }
  return 2 * k + (ifx n[k] < 0.0 then 1 else 0);
}
RD_MAX :: 400000; RD_PARTS :: 4096;  // a cell's parts (octant by uv eighth; a card cell has many)
Reduce :: struct {
  cell_of: [RD_MAX] int; cnt: [RD_MAX + 1] int; list: [RD_MAX] int; fill: [RD_MAX] int;
  keep: [RD_MAX] int; out: [RD_MAX] int;           // per input vertex its output; per output its source vertex
  anchor_of: [RD_MAX] int;
  tri: [RD_MAX * 2][3] int; used: [RD_MAX] int;
  pk: [RD_PARTS][3] int; pmembers: [RD_MAX] int; pn: [RD_PARTS] int;
}
// The piece's reduction at cell: new vertices and triangles appended to the store; returns (vf, vn, tf, tn).
reduce :: (st: []Store, vf: int, vn: int, tf: int, tn: int, cell: f64, rd: []Reduce, h1: []Hmap, h2: []Hmap) -> [4] int {
  if vn > RD_MAX || tn > RD_MAX * 2 { ph_die("pack_human: a piece past the port's reduction"); }
  hm_clear(h1);
  for i: 0..<vn {
    p := st[0].v[vf + i].p;
    rd[0].cell_of[i] = hm_put(h1, hm4(pn_floor(p[0] / cell), pn_floor(p[1] / cell), pn_floor(p[2] / cell), 0));
  }
  nc := h1[0].n;
  for c: 0..<nc + 1 { rd[0].cnt[c] = 0; }
  for i: 0..<vn { rd[0].cnt[rd[0].cell_of[i] + 1] += 1; }
  for c: 0..<nc { rd[0].cnt[c + 1] += rd[0].cnt[c]; }
  for c: 0..<nc { rd[0].fill[c] = rd[0].cnt[c]; }
  for i: 0..<vn { c := rd[0].cell_of[i]; rd[0].list[rd[0].fill[c]] = i; rd[0].fill[c] += 1; }
  no := 0;
  for c: 0..<nc {
    a := rd[0].cnt[c]; b := rd[0].cnt[c + 1]; m := b - a;
    mid: [3] f64;
    for k: 0..<3 { s: [1] PnSum; for q: a..<b { pn_add(s[..], st[0].v[vf + rd[0].list[q]].p[k]); } mid[k] = pn_total(s[0]) / cast(f64) m; }
    anchor := rd[0].list[a]; best_d := pn_dist3(st[0].v[vf + anchor].p, mid);
    for q: a + 1..<b { i := rd[0].list[q]; d := pn_dist3(st[0].v[vf + i].p, mid); if d < best_d { best_d = d; anchor = i; } }
    // the parts: by octant and an eighth of uv, in the order they first appear
    np := 0;
    for q: a..<b {
      i := rd[0].list[q]; v := st[0].v[vf + i];
      key := [3] int.[octant(v.n), pn_floor(v.uv[0] * 8.0), pn_floor(v.uv[1] * 8.0)];
      k := -1;
      for e: 0..<np { if rd[0].pk[e][0] == key[0] && rd[0].pk[e][1] == key[1] && rd[0].pk[e][2] == key[2] { k = e; break; } }
      if k < 0 { if np >= RD_PARTS { ph_die("pack_human: a cell past the port's parts"); } k = np; rd[0].pk[k] = key; rd[0].pn[k] = 0; np += 1; }
      rd[0].pmembers[q] = k;
    }
    for e: 0..<np {
      best := -1; bd := 0.0;
      for q: a..<b {
        if rd[0].pmembers[q] != e { continue; }
        i := rd[0].list[q]; d := pn_dist3(st[0].v[vf + i].p, mid);
        if best < 0 || d < bd { best = i; bd = d; }
        rd[0].keep[i] = no;
      }
      rd[0].out[no] = best; rd[0].anchor_of[no] = anchor; no += 1;
    }
  }
  hm_clear(h2);
  nt := 0;
  for q: tf..<tf + tn {
    a := rd[0].keep[st[0].t[q][0]]; b := rd[0].keep[st[0].t[q][1]]; c := rd[0].keep[st[0].t[q][2]];
    if a == b || b == c || a == c { continue; }
    pa := st[0].v[vf + rd[0].anchor_of[a]].p; pb := st[0].v[vf + rd[0].anchor_of[b]].p; pc := st[0].v[vf + rd[0].anchor_of[c]].p;
    if same3(pa, pb) || same3(pb, pc) || same3(pa, pc) { continue; }
    x := imin(a, imin(b, c)); z := imax(a, imax(b, c)); y := a + b + c - x - z;
    before := h2[0].n;
    _ := hm_put(h2, hm4(x, y, z, 0));
    if h2[0].n == before { continue; }
    rd[0].tri[nt] = [3] int.[a, b, c]; nt += 1;
  }
  for i: 0..<no { rd[0].used[i] = -1; }
  for t: 0..<nt { for k: 0..<3 { rd[0].used[rd[0].tri[t][k]] = 0; } }
  nv0 := st[0].nv; k := 0;
  for i: 0..<no {
    if rd[0].used[i] < 0 { continue; }
    rd[0].used[i] = k; k += 1;
    v := st[0].v[vf + rd[0].out[i]];
    an := st[0].v[vf + rd[0].anchor_of[i]];
    v.p = an.p; v.j = an.j; v.w = an.w;
    st[0].v[st_vert(st)] = v;
  }
  t0 := st[0].nt;
  for t: 0..<nt { x := st_tri(st, rd[0].used[rd[0].tri[t][0]], rd[0].used[rd[0].tri[t][1]], rd[0].used[rd[0].tri[t][2]]); }
  return [4] int.[nv0, k, t0, nt];
}
same3 :: (a: [3] f64, b: [3] f64) -> bool { return a[0] == b[0] && a[1] == b[1] && a[2] == b[2]; }

// ---- the eyes' blended layers
// lid_coords(): a blended layer's uv rewritten to lid coordinates: u from its outer border (0)
// to its middle or inner border (1) along the surface, v up the opening; each part on its own
LC_MAX :: 40000;
LidWork :: struct {
  k: [LC_MAX] int; at: [LC_MAX][3] f64; na: int;
  ekey: [LC_MAX * 3][2] int; ecnt: [LC_MAX * 3] int; ne: int;
  nb: [1] Nbr; rim: [1] Nbr;
  rimdeg: [LC_MAX] int;
  part: [LC_MAX] int; inpart: [LC_MAX] bool; done: [LC_MAX] bool; loop: [LC_MAX] int; nloop: int;
  stack: [LC_MAX] int; seen: [LC_MAX] int; gen: int;
  dout: [LC_MAX] f64; din: [LC_MAX] f64; hd: [LC_MAX * 8] f64; hi: [LC_MAX * 8] int;
  u: [LC_MAX] f64; v: [LC_MAX] f64; has: [LC_MAX] bool;
}
lid_coords :: (st: []Store, vf: int, vn: int, tf: int, tn: int, lw: []LidWork, h: []Hmap) {
  hm_clear(h);
  lw[0].na = 0;
  for i: 0..<vn {
    p := st[0].v[vf + i].p;
    id := hm_put(h, hm4(pn_round_key(p[0], 6), pn_round_key(p[1], 6), pn_round_key(p[2], 6), 0));
    if id == lw[0].na { lw[0].at[id] = p; lw[0].na += 1; }
    lw[0].k[i] = id;
  }
  na := lw[0].na;
  // the edges (how many triangles use each) and the neighbours
  hm_clear(h);
  lw[0].ne = 0;
  nb_start(lw[0].nb[..], na);
  for q: tf..<tf + tn {
    t := st[0].t[q];
    qq := [3] int.[lw[0].k[t[0]], lw[0].k[t[1]], lw[0].k[t[2]]];
    for e: 0..<3 {
      a := qq[e]; b := qq[(e + 1) % 3];
      x := imin(a, b); y := imax(a, b);
      before := h[0].n; id := hm_put(h, hm4(x, y, 0, 0));
      if h[0].n != before { lw[0].ekey[id] = [2] int.[x, y]; lw[0].ecnt[id] = 0; lw[0].ne += 1; }
      lw[0].ecnt[id] += 1;
      nb_ins(lw[0].nb[..], a, b); nb_ins(lw[0].nb[..], b, a);
    }
  }
  nb_finish(lw[0].nb[..]);
  nb_start(lw[0].rim[..], na);
  for e: 0..<lw[0].ne { if lw[0].ecnt[e] == 1 { a := lw[0].ekey[e][0]; b := lw[0].ekey[e][1]; nb_ins(lw[0].rim[..], a, b); nb_ins(lw[0].rim[..], b, a); } }
  nb_finish(lw[0].rim[..]);
  for i: 0..<na { lw[0].done[i] = false; lw[0].has[i] = false; lw[0].seen[i] = 0; }
  for start: 0..<na {
    if lw[0].done[start] { continue; }
    np := lid_walk(lw, start, false, 0);
    for q: 0..<np { lw[0].part[q] = lw[0].loop[q]; lw[0].done[lw[0].part[q]] = true; }
    // the border loops, the one reaching lowest and highest first
    for q: 0..<np { i := lw[0].part[q]; lw[0].inpart[i] = nb_count(lw[0].rim[..], i) > 0; }
    nl := 0; lstart: [64] int; lh: [64] f64; lfirst: [64] int; lcount: [64] int;
    members: [LC_MAX] int; nm := 0;
    for q: 0..<np {
      i := lw[0].part[q];
      if !lw[0].inpart[i] { continue; }
      n := lid_walk(lw, i, true, 0);
      lo := 1000000000.0; hi := -1000000000.0;
      for e: 0..<n { j := lw[0].loop[e]; lw[0].inpart[j] = false; members[nm + e] = j; lo = vmin(lo, lw[0].at[j][1]); hi = vmax(hi, lw[0].at[j][1]); }
      if nl >= 64 { ph_die("pack_human: a blended layer past the port's loops"); }
      lfirst[nl] = nm; lcount[nl] = n; lh[nl] = 0.0 - (hi - lo); nm += n; nl += 1;
    }
    if nl == 0 { continue; }
    // stable sort by -(height)
    lo_: [64] int; for e: 0..<nl { lo_[e] = e; }
    for e: 1..<nl { x := lo_[e]; j := e - 1; while j >= 0 && lh[lo_[j]] > lh[x] { lo_[j + 1] = lo_[j]; j -= 1; } lo_[j + 1] = x; }
    lid_dist(lw, members[lfirst[lo_[0]]..<lfirst[lo_[0]] + lcount[lo_[0]]], lw[0].dout[..]);
    inner := nl > 1;
    if inner {
      seeds: [LC_MAX] int; ns := 0;
      for e: 1..<nl { l := lo_[e]; for q: 0..<lcount[l] { seeds[ns] = members[lfirst[l] + q]; ns += 1; } }
      lid_dist(lw, seeds[0..<ns], lw[0].din[..]);
    }
    far := 0.0; y0 := 1000000000.0; y1 := -1000000000.0; first := true;
    for q: 0..<np {
      i := lw[0].part[q];
      a := ifx lw[0].dout[i] >= 0.0 then lw[0].dout[i] else 0.0;
      if first || a > far { far = a; }
      if first || lw[0].at[i][1] < y0 { y0 = lw[0].at[i][1]; }
      if first || lw[0].at[i][1] > y1 { y1 = lw[0].at[i][1]; }
      first = false;
    }
    if far == 0.0 { far = 1.0; }
    for q: 0..<np {
      i := lw[0].part[q];
      a := ifx lw[0].dout[i] >= 0.0 then lw[0].dout[i] else 0.0;
      inn := ifx inner && lw[0].din[i] >= 0.0 then lw[0].din[i] else 0.0;
      u := 0.0;
      if inner && a + inn > 0.0 { u = a / (a + lw[0].din[i]); } else { u = a / far; }
      lw[0].u[i] = vmin(vmax(u, 0.0), 1.0);
      lw[0].v[i] = (lw[0].at[i][1] - y0) / vmax(y1 - y0, 0.000001);
      lw[0].has[i] = true;
    }
  }
  for i: 0..<vn {
    k := lw[0].k[i];
    st[0].v[vf + i].uv = ifx lw[0].has[k] then [2] f64.[lw[0].u[k], lw[0].v[k]] else [2] f64.[0.0, 0.0];
  }
}
// the nodes reachable from seed (over the neighbours, or the rim), into lw.loop; their count
lid_walk :: (lw: []LidWork, seed: int, rim: bool, unused: int) -> int {
  lw[0].gen += 1; g := lw[0].gen;
  n := 0; sp := 0;
  lw[0].seen[seed] = g; lw[0].loop[n] = seed; n += 1; lw[0].stack[sp] = seed; sp += 1;
  while sp > 0 {
    sp -= 1; x := lw[0].stack[sp];
    a := ifx rim then lw[0].rim[0].start[x] else lw[0].nb[0].start[x];
    b := ifx rim then lw[0].rim[0].start[x + 1] else lw[0].nb[0].start[x + 1];
    for e: a..<b {
      y := ifx rim then lw[0].rim[0].list[e] else lw[0].nb[0].list[e];
      if lw[0].seen[y] != g { lw[0].seen[y] = g; lw[0].loop[n] = y; n += 1; lw[0].stack[sp] = y; sp += 1; }
    }
  }
  return n;
}
// Dijkstra from the seeds over the neighbours (math.dist steps); -1 where unreached
lid_dist :: (lw: []LidWork, seeds: []int, d: []f64) {
  for i: 0..<lw[0].na { d[i] = -1.0; }
  n := 0;
  for s: seeds { d[s] = 0.0; heap_push(lw[0].hd[..], lw[0].hi[..], n, 0.0, s); n += 1; }
  while n > 0 {
    dd := lw[0].hd[0]; i := lw[0].hi[0];
    n = heap_pop(lw[0].hd[..], lw[0].hi[..], n);
    if dd > d[i] { continue; }
    for e: lw[0].nb[0].start[i]..<lw[0].nb[0].start[i + 1] {
      j := lw[0].nb[0].list[e];
      nd := dd + pn_dist3(lw[0].at[i], lw[0].at[j]);
      if d[j] < 0.0 || nd < d[j] {
        if n >= lw[0].hd.count { ph_die("pack_human: a search past the port's heap"); }
        d[j] = nd; heap_push(lw[0].hd[..], lw[0].hi[..], n, nd, j); n += 1;
      }
    }
  }
}
// a binary min-heap of (d, i), as heapq orders tuples
heap_less :: (d1: f64, i1: int, d2: f64, i2: int) -> bool { return d1 < d2 || (d1 == d2 && i1 < i2); }
heap_push :: (hd: []f64, hi: []int, n: int, d: f64, i: int) {
  k := n; hd[k] = d; hi[k] = i;
  while k > 0 {
    p := (k - 1) / 2;
    if !heap_less(hd[k], hi[k], hd[p], hi[p]) { break; }
    td := hd[k]; ti := hi[k]; hd[k] = hd[p]; hi[k] = hi[p]; hd[p] = td; hi[p] = ti; k = p;
  }
}
// removes the top; the new size
heap_pop :: (hd: []f64, hi: []int, n_in: int) -> int {
  n := n_in - 1;
  hd[0] = hd[n]; hi[0] = hi[n];
  k := 0;
  while true {
    l := 2 * k + 1; r := l + 1; m := k;
    if l < n && heap_less(hd[l], hi[l], hd[m], hi[m]) { m = l; }
    if r < n && heap_less(hd[r], hi[r], hd[m], hi[m]) { m = r; }
    if m == k { break; }
    td := hd[k]; ti := hi[k]; hd[k] = hd[m]; hi[k] = hi[m]; hd[m] = td; hi[m] = ti; k = m;
  }
  return n;
}

// eye_layers(): per eye a cap on its ball (the occlusion) and a ring round the cap's edge (the
// wet layer), skinned as the nearest eye vertex, for a figure whose eyes are bare balls
SEG :: 32; RINGS :: 6;
eye_layers :: (pk: []Pack, st: []Store, eye: Piece, lw: []LidWork, h: []Hmap, iw: []ImgWork) {
  // sides: p[0] > 0, in the order they first appear
  side_val: [2] bool; nside := 0;
  for i: eye.vf..<eye.vf + eye.vn {
    s := st[0].v[i].p[0] > 0.0;
    if nside == 0 || (nside == 1 && side_val[0] != s) { if nside < 2 { side_val[nside] = s; nside += 1; } }
  }
  cap_v0 := st[0].nv;
  // the store keeps each layer's vertices together: the cap's both eyes first, then the ring's
  cap_t: [4096][3] int; ncap_t := 0; ring_t: [4096][3] int; nring_t := 0;
  capv: [2048] PV; ncapv := 0; ringv: [2048] PV; nringv := 0;
  for sd: 0..<nside {
    want := side_val[sd];
    c: [3] f64; cnt := 0;
    for k: 0..<3 { s: [1] PnSum; cnt = 0; for i: eye.vf..<eye.vf + eye.vn { if (st[0].v[i].p[0] > 0.0) == want { pn_add(s[..], st[0].v[i].p[k]); cnt += 1; } } c[k] = pn_total(s[0]) / cast(f64) cnt; }
    rad := 0.0; firstr := true;
    for i: eye.vf..<eye.vf + eye.vn { if (st[0].v[i].p[0] > 0.0) == want { d := pn_dist3(st[0].v[i].p, c); if firstr || d > rad { rad = d; } firstr = false; } }
    r_open := 0.75 * rad;
    for layer: 0..<2 {
      radii: [8] f64; nr := 0;
      if layer == 0 { for i: 0..<RINGS + 1 { radii[i] = r_open * (1.0 - cast(f64) i / cast(f64) RINGS) + 0.00001; } nr = RINGS + 1; }
      else { radii[0] = r_open * 0.98; radii[1] = r_open * 0.8; nr = 2; }
      base := ifx layer == 0 then ncapv else nringv;
      for ri: 0..<nr {
        r := radii[ri];
        for k: 0..<SEG {
          a := 2.0 * PH_PI * cast(f64) k / cast(f64) SEG;
          x := r * cos(a); y := 0.62 * r * sin(a);
          z := c[2] + sqrt(vmax(rad * rad - x * x - y * y, 0.0)) + 0.0004;
          p := [3] f64.[c[0] + x, c[1] + y, z];
          v: PV; v.p = p;
          for q: 0..<3 { v.n[q] = (p[q] - c[q]) / rad; }
          v.uv = [2] f64.[0.0, 0.0];
          best := -1; bd := 0.0;
          for i: eye.vf..<eye.vf + eye.vn { if (st[0].v[i].p[0] > 0.0) == want { d := pn_dist3(st[0].v[i].p, p); if best < 0 || d < bd { best = i; bd = d; } } }
          v.j = st[0].v[best].j; v.w = st[0].v[best].w; v.pt = 0;
          if layer == 0 { capv[ncapv] = v; ncapv += 1; } else { ringv[nringv] = v; nringv += 1; }
        }
      }
      for i: 0..<nr - 1 {
        for k: 0..<SEG {
          a := base + i * SEG + k; b := base + i * SEG + (k + 1) % SEG;
          t1 := [3] int.[a, b + SEG, b]; t2 := [3] int.[a, a + SEG, b + SEG];
          if layer == 0 { cap_t[ncap_t] = t1; cap_t[ncap_t + 1] = t2; ncap_t += 2; }
          else { ring_t[nring_t] = t1; ring_t[nring_t + 1] = t2; nring_t += 2; }
        }
      }
    }
  }
  for layer: 0..<2 {
    vf := st[0].nv; tf := st[0].nt;
    nv := ifx layer == 0 then ncapv else nringv; nt := ifx layer == 0 then ncap_t else nring_t;
    for i: 0..<nv { st[0].v[st_vert(st)] = ifx layer == 0 then capv[i] else ringv[i]; }
    for i: 0..<nt { t := ifx layer == 0 then cap_t[i] else ring_t[i]; x := st_tri(st, t[0], t[1], t[2]); }
    lid_coords(st, vf, nv, tf, nt, lw, h);
    pack_piece(pk, ifx layer == 0 then "eyes/occlusion" else "eyes/wet", vf, nv, tf, nt, ifx layer == 0 then "occlusion" else "wet", "", "", "", iw);
  }
}

// ---- the writer: VPK1 (verse/tools/pack_realm.py's container)
WR_VB :: 25165824; WR_IB :: 4194304; WR_FB :: 16777216; WR_OUT :: 67108864; WR_TEXT :: 1048576;
Writer :: struct {
  vb: [WR_VB] u8; ib: [WR_IB] u32; fb: [WR_FB] u8; out: [WR_OUT] u8; text: [WR_TEXT] u8;
  acc_t: [RD_MAX][3] f64; acc_b: [RD_MAX][3] f64; tg: [RD_MAX] TangentOut;
  top: [PIECES][4] int;
  d1: [PIECES][4] int; nd1: int;
  ntext: int;      // the phone's D 1 lines: piece, first, count, material
}
// a piece's place in the draw order: opaque, then the face rig's (together), then cut-out, then blended
rank :: (p: Piece) -> int {
  cut := p.material == MAT_HAIR || p.material == MAT_BROW;
  bl := blended(p.material); face := p.face.count > 0;
  return (ifx bl then 4 else 0) + (ifx face != bl then 2 else 0) + (ifx cut then 1 else 0);
}
phone_keeps :: (p: Piece) -> bool { return p.face.count > 0 || p.material == MAT_HAIR || p.material == MAT_BROW || blended(p.material); }
wr_line :: (o: []Sb) { sb_byte(o, '\n'); }
// pack_human.write: the pack at size x size layers (phone: the phone's, write()'s docs); its total
pack_write :: (pk: []Pack, st: []Store, out: string, size: int, phone: bool, wr: []Writer, rd: []Reduce, h1: []Hmap, h2: []Hmap, iw: []ImgWork, fr: []FaceRig) -> int {
  o: [1] Sb; o[0] = sb(wr[0].text[..]);
  sb_put(o[..], "human "); sb_put(o[..], pk[0].name); wr_line(o[..]);
  sb_put(o[..], "body "); sb_put(o[..], pk[0].body); wr_line(o[..]);
  sb_put(o[..], "licence "); sb_put(o[..], pk[0].licence); wr_line(o[..]);
  if pk[0].outfit.count > 0 { sb_put(o[..], "outfit "); sb_put(o[..], pk[0].outfit); sb_byte(o[..], ' '); sb_put(o[..], pk[0].outfit_base); wr_line(o[..]); }
  for j: 0..<pk[0].nb {
    sb_put(o[..], "B "); sb_int(o[..], j);
    for c: 0..<pk[0].bw { sb_byte(o[..], ' '); sb_fixed(o[..], pk[0].binds[j][c], 6); }
    wr_line(o[..]);
  }
  // the tints by name (sorted(pack.tints.items()))
  ti: [TINTS] int; for i: 0..<pk[0].nt { ti[i] = i; }
  for i: 1..<pk[0].nt { x := ti[i]; j := i - 1; while j >= 0 && str_less(pk[0].tint_name[x], pk[0].tint_name[ti[j]]) { ti[j + 1] = ti[j]; j -= 1; } ti[j + 1] = x; }
  for q: 0..<pk[0].nt {
    i := ti[q]; t := pk[0].tint[i];
    sb_put(o[..], "M "); sb_int(o[..], mat_of(pk[0].tint_name[i]));
    for c: 0..<4 { sb_byte(o[..], ' '); sb_int(o[..], pn_round(t[c] * 1000.0)); }
    wr_line(o[..]);
  }
  lo := [3] f64.[1000000000.0, 1000000000.0, 1000000000.0]; hi := [3] f64.[-1000000000.0, -1000000000.0, -1000000000.0];
  count := 0; nib := 0; nvb := 0;
  order: [PIECES] int; for i: 0..<pk[0].np { order[i] = i; }
  for i: 1..<pk[0].np { x := order[i]; j := i - 1; while j >= 0 && rank(pk[0].pieces[order[j]]) > rank(pk[0].pieces[x]) { order[j + 1] = order[j]; j -= 1; } order[j + 1] = x; }
  face_first := -1;
  for q: 0..<pk[0].np {
    p := pk[0].pieces[order[q]];
    wr[0].top[q] = [4] int.[p.vf, p.vn, p.tf, p.tn];
    if phone && !phone_keeps(p) { wr[0].top[q] = reduce(st, p.vf, p.vn, p.tf, p.tn, LODS[0], rd, h1, h2); }
  }
  for q: 0..<pk[0].np {
    p := pk[0].pieces[order[q]]; t := wr[0].top[q];
    nvb = wr_verts(st, t, p, wr, nvb, lo[..], hi[..], true);
    if p.face.count > 0 && face_first < 0 { face_first = count; }
    first := nib;
    nib = wr_indices(st, t, count, wr, nib);
    sb_put(o[..], "P "); sb_put(o[..], p.name); sb_byte(o[..], ' '); sb_int(o[..], first); sb_byte(o[..], ' '); sb_int(o[..], nib - first); sb_byte(o[..], ' '); sb_int(o[..], p.material); wr_line(o[..]);
    count += t[1];
  }
  wr[0].nd1 = 0;
  for level: 1..<3 {
    if phone && level == 2 {
      for e: 0..<wr[0].nd1 {
        d := wr[0].d1[e];
        sb_put(o[..], "D 2 "); sb_put(o[..], pk[0].pieces[d[0]].name); sb_byte(o[..], ' '); sb_int(o[..], d[1]); sb_byte(o[..], ' '); sb_int(o[..], d[2]); sb_byte(o[..], ' '); sb_int(o[..], d[3]); wr_line(o[..]);
      }
      break;
    }
    for q: 0..<pk[0].np {
      p := pk[0].pieces[order[q]];
      if blended(p.material) { continue; }
      t := reduce(st, p.vf, p.vn, p.tf, p.tn, ifx phone then LODS[1] else LODS[level - 1], rd, h1, h2);
      if t[3] == 0 { continue; }
      nvb = wr_verts(st, t, p, wr, nvb, lo[..], hi[..], false);
      first := nib;
      nib = wr_indices(st, t, count, wr, nib);
      sb_put(o[..], "D "); sb_int(o[..], level); sb_byte(o[..], ' '); sb_put(o[..], p.name); sb_byte(o[..], ' '); sb_int(o[..], first); sb_byte(o[..], ' '); sb_int(o[..], nib - first); sb_byte(o[..], ' '); sb_int(o[..], p.material); wr_line(o[..]);
      if level == 1 && wr[0].nd1 < PIECES { wr[0].d1[wr[0].nd1] = [4] int.[order[q], first, nib - first, p.material]; wr[0].nd1 += 1; }
      count += t[1];
    }
  }
  for k: 0..<pk[0].ni {
    sb_put(o[..], "L "); sb_int(o[..], k); sb_byte(o[..], ' '); sb_put(o[..], pk[0].images[k].role); sb_byte(o[..], ' '); sb_put(o[..], pk[0].images[k].source); wr_line(o[..]);
  }
  sb_put(o[..], "box");
  for c: 0..<3 { sb_byte(o[..], ' '); sb_fixed(o[..], lo[c], 4); }
  for c: 0..<3 { sb_byte(o[..], ' '); sb_fixed(o[..], hi[c], 4); }
  wr_line(o[..]);
  sb_put(o[..], "vertices "); sb_int(o[..], count); sb_put(o[..], " triangles "); sb_int(o[..], nib / 3);
  sb_put(o[..], " layers "); sb_int(o[..], pk[0].ni); sb_put(o[..], " size "); sb_int(o[..], size); wr_line(o[..]);
  nfb := 0;
  if pk[0].face && face_first >= 0 {
    n := 0;
    for q: 0..<pk[0].np { p := pk[0].pieces[order[q]]; if p.face.count > 0 { n += p.vn; } }
    if n > FACE_VERTICES_MAX { ph_die("pack_human: face rig vertices past the lab's 65536 (metahumanlab.coax FACE_VERTICES)"); }
    nfb = face_block(fr, pk, st, order[0..<pk[0].np], phone, wr[0].fb[..]);
    sb_put(o[..], "F "); sb_int(o[..], face_first); sb_byte(o[..], ' '); sb_int(o[..], n); sb_byte(o[..], ' '); sb_int(o[..], nfb); wr_line(o[..]);
  }
  if o[0].n >= WR_TEXT { ph_die("pack_human: a catalog past the port's buffer"); }
  // the file: header, entry table, then each entry 4-aligned
  ne := 3 + pk[0].ni;
  b := wr[0].out[..];
  data_at := 32 + 48 * ne;
  at := data_at;
  for i: 0..<data_at { b[i] = 0; }
  text := sb_text(o[..]); wr[0].ntext = text.count;
  cat_n := text.count + (ifx nfb > 0 then 1 + nfb else 0);
  at = wr_entry(b, 0, 1, "catalog", at, cat_n);
  for i: 0..<text.count { b[at + i] = text[i]; }
  if nfb > 0 { b[at + text.count] = 0; for i: 0..<nfb { b[at + text.count + 1 + i] = wr[0].fb[i]; } }
  at += cat_n;
  at = wr_entry(b, 1, 2, "vertices", at, nvb);
  for i: 0..<nvb { b[at + i] = wr[0].vb[i]; }
  at += nvb;
  at = wr_entry(b, 2, 3, "indices", at, nib * 4);
  for i: 0..<nib { put_u32(b, at + 4 * i, cast(int) wr[0].ib[i]); }
  at += nib * 4;
  for k: 0..<pk[0].ni {
    img := pk[0].images[k];
    lb := layer_bytes(img.path, size, img.flip, iw);
    nm: [16] u8; no: [1] Sb; no[0] = sb(nm[..]); sb_put(no[..], "layer"); sb_int(no[..], k);
    at = wr_entry(b, 3 + k, 4, sb_text(no[..]), at, lb.count);
    if at + lb.count > WR_OUT { ph_die("pack_human: a pack past the port's buffer"); }
    for i: 0..<lb.count { b[at + i] = lb[i]; }
    at += lb.count;
  }
  total := at;
  b[0] = 'V'; b[1] = 'P'; b[2] = 'K'; b[3] = '1';
  put_u32(b, 4, ne); put_u32(b, 8, total); put_u32(b, 12, total); put_u32(b, 16, 32); put_u32(b, 20, data_at); put_u32(b, 24, 0); put_u32(b, 28, 0);
  if !fs_mkdir(dir_name(out)) {}
  if !fs_write(out, cast(string) b[0..<total]) { ph_die2("pack_human: can't write ", out); }
  // the catalog's last line, for the caller's report
  return total;
}
// an entry's table row (its data padded to 4 bytes first); where its data starts
wr_entry :: (b: []u8, k: int, kind: int, name: string, at_in: int, n: int) -> int {
  at := at_in;
  while at % 4 != 0 { b[at] = 0; at += 1; }
  r := 32 + 48 * k;
  b[r] = cast(u8) kind; b[r + 1] = 0; b[r + 2] = 0; b[r + 3] = 0;
  put_u32(b, r + 4, at); put_u32(b, r + 8, n); put_u32(b, r + 12, 0);
  for i: 0..<32 { b[r + 16 + i] = ifx i < name.count && i < 31 then name[i] else 0; }
  return at;
}
wr_verts :: (st: []Store, t: [4] int, p: Piece, wr: []Writer, nvb_in: int, lo: []f64, hi: []f64, check: bool) -> int {
  nvb := nvb_in;
  if t[1] > RD_MAX { ph_die("pack_human: a piece past the port's tangent buffer"); }
  tangents(st, t[0], t[1], t[2], t[3], wr[0].acc_t[..], wr[0].acc_b[..], wr[0].tg[..]);
  for i: 0..<t[1] {
    v := st[0].v[t[0] + i];
    if check {
      if cast(int) v.w[0] + cast(int) v.w[1] + cast(int) v.w[2] + cast(int) v.w[3] != 255 { ph_die2(p.name, ": weights that don't sum to 255"); }
      for k: 0..<4 { if cast(int) v.j[k] >= JOINTS { ph_die2(p.name, ": a joint past the rig's 65"); } }
    }
    if nvb + 32 > WR_VB { ph_die("pack_human: vertices past the port's buffer"); }
    vertex(v, wr[0].tg[i], p.material, p.layers, wr[0].vb[..], nvb);
    nvb += 32;
    if check { for c: 0..<3 { lo[c] = vmin(lo[c], v.p[c]); hi[c] = vmax(hi[c], v.p[c]); } }
  }
  return nvb;
}
wr_indices :: (st: []Store, t: [4] int, count: int, wr: []Writer, nib_in: int) -> int {
  nib := nib_in;
  if nib + 3 * t[3] > WR_IB { ph_die("pack_human: indices past the port's buffer"); }
  for q: t[2]..<t[2] + t[3] { for k: 0..<3 { wr[0].ib[nib] = cast(u32) (count + st[0].t[q][k]); nib += 1; } }
  return nib;
}
