// Packed meshlet geometry, recovered from the original Model BFsha slot8 native shader.
// Evidence: private-build/kokiri/meshlet-shaders/actual-mesh.glsl (SPIR-V validated).
#load "ocarina-bfres.coax";
KmlCluster :: struct {descriptor:int;vertices:int;triangles:int;stride:int;vertexBit:int;indexBit:int;indexWidth:int;px:int;py:int;pz:int;normalBits:int;}
#test "Kokiri meshlet bit windows preserve cross-word values and zero-width axes" {
 b:[16]u8;scan_put(b[..],0,0xfedcba98);scan_put(b[..],4,0x76543210);
 #assert kml_bits(b[..],28,12)==0x10f && kml_bits(b[..],32,32)==0x76543210 && kml_bits(b[..],128,0)==0;
}
#test "Kokiri original meshlet descriptors bind vertex and index bitstreams after the header" {
 b:[160]u8;scan_write_point(b[..],0,v3(10,20,30));scan_put(b[..],12,f32_bits(0.5));scan_put(b[..],16,0x1061);scan_put(b[..],20,1);
 scan_put(b[..],100,0x03010000);scan_put(b[..],104,(40<<4)|2);scan_put(b[..],108,22|(2<<16)|(2<<21)|(2<<26));
 kml_test_bits(b[..],124*8+22,2,2);kml_test_bits(b[..],124*8+44+2,2,2);kml_test_bits(b[..],124*8+66+2,2,1);kml_test_bits(b[..],124*8+66+4,2,2);
 c:=kml_cluster(b[..],0);#assert c.vertices==3 && c.triangles==1 && c.vertexBit==992 && c.indexBit==1058 && c.indexWidth==2;
 p:=kml_position(b[..],c,1);q:=kml_position(b[..],c,2);#assert p.x==11 && p.y==20 && p.z==30 && q.x==10 && q.y==21 && q.z==30;
 #assert kml_bits(b[..],c.indexBit,2)==0 && kml_bits(b[..],c.indexBit+2,2)==1 && kml_bits(b[..],c.indexBit+4,2)==2;
}
kml_test_bits :: (b:[]u8,start:int,width:int,value:u32) {for j:0..<width {at:=start+j;if ((value>>cast(u32)j)&1)!=0 {b[at/8]|=cast(u8)(1<<cast(u32)(at%8));}}}
kml_bits :: (b:[]u8,start:int,width:int)->u32 {#assert start>=0 && width>=0 && width<=32 && start<=b.count*8 && width<=b.count*8-start;if width==0 {return 0;}at:=(start/32)*4;shift:=start%32;lo:=ob_word(b,at)>>cast(u32)shift;hi:u32=0;if shift+width>32 {hi=ob_word(b,at+4)<<cast(u32)(32-shift);}mask:=ifx width==32 then cast(u32)0xffffffff else (cast(u32)1<<cast(u32)width)-1;return (lo|hi)&mask;}
kml_pop :: (v:u32)->int {x:=v;n:=0;while x!=0 {n+=cast(int)(x&1);x>>=1;}return n;}
kml_stride :: (b:[]u8)->int {layout:=ob_word(b,16);return 8*(4+kml_pop(layout&0xc00)+kml_pop(layout&0x1f000));}
kml_cluster :: (b:[]u8,index:int)->KmlCluster {#assert b.count>=84 && index>=0 && index<ob_int(b,20);d:=84+index*kml_stride(b);#assert ob_span(b.count,d,kml_stride(b));a:=ob_word(b,d+16);offset:=ob_word(b,d+20);v:=ob_word(b,d+24);count:=cast(int)(a>>24);triangles:=cast(int)((a>>16)&255);#assert count>=1 && count<=256 && triangles>0;bits:=0;while (1<<cast(u32)bits)<count {bits+=1;}stride:=cast(int)(v&1023);start:=84*8+cast(int)(offset>>4)*8;px:=cast(int)((v>>16)&31);py:=cast(int)((v>>21)&31);pz:=cast(int)((v>>26)&31);#assert stride>=px+py+pz && start<=b.count*8 && count*stride+triangles*3*bits<=b.count*8-start;return KmlCluster.{descriptor=d,vertices=count,triangles=triangles,stride=stride,vertexBit=start,indexBit=start+count*stride,indexWidth=bits,px=px,py=py,pz=pz,normalBits=6+cast(int)(offset&15)};}
kml_position :: (b:[]u8,c:KmlCluster,index:int)->Point {#assert index>=0 && index<c.vertices;start:=c.vertexBit+index*c.stride;d:=c.descriptor*8;quantum:=ob_float(b,12);#assert quantum>0;minimum:=scan_point(b,0);x:=kml_bits(b,d,21)+kml_bits(b,start,c.px);y:=kml_bits(b,d+21,21)+kml_bits(b,start+c.px,c.py);z:=kml_bits(b,d+42,21)+kml_bits(b,start+c.px+c.py,c.pz);return add(minimum,times(v3(cast(f32)x,cast(f32)y,cast(f32)z),quantum));}
#test "Kokiri meshlet UV metadata uses signed minima and independent power of two quanta" {b:[160]u8;scan_put(b[..],16,0x1001);scan_put(b[..],116,0x0003fffe);scan_put(b[..],120,16|(15<<12)|(1<<24));c:=KmlCluster.{descriptor=84,vertices=1,stride=3,vertexBit=1024};kml_test_bits(b[..],1024,2,3);kml_test_bits(b[..],1026,1,1);uv:=kml_uv(b[..],c,0,0);#assert uv.x==1 && uv.y==2;}
kml_oct :: (b:[]u8,start:int,bits:int)->Point {#assert bits>=6 && bits<=21;factor:=1.0322580337524414/cast(f32)(cast(u32)1<<cast(u32)bits);x:=cast(f32)kml_bits(b,start,bits)*factor*2-1;y:=cast(f32)kml_bits(b,start+bits,bits)*factor*2-1;z:=1-abs(x)-abs(y);if z<0 {old:=x;x=(1-abs(y))*(ifx old<0 then -1.0f32 else 1.0f32);y=(1-abs(old))*(ifx y<0 then -1.0f32 else 1.0f32);}return unit_or(v3(x,y,z),v3(0,1,0));}
kml_normal :: (b:[]u8,c:KmlCluster,index:int)->Point {return kml_oct(b,c.vertexBit+index*c.stride+c.px+c.py+c.pz,c.normalBits);}
kml_tangent_bits :: (b:[]u8,c:KmlCluster)->int {return 6+cast(int)(ob_word(b,c.descriptor+28)&15);}
kml_color_meta :: (b:[]u8,c:KmlCluster,color:int)->int {layout:=ob_word(b,16);#assert color>=0 && color<2 && (layout&(cast(u32)1<<cast(u32)(10+color)))!=0;before:=ifx color==0 then 0 else kml_pop(layout&0x400);return c.descriptor+32+8*kml_pop(layout&0x1f000)+8*before;}
#test "Kokiri meshlet floating vertex colors retain all four original scalar channels" {b:[160]u8;scan_put(b[..],16,0x401);scan_put(b[..],116,0x80);values:=[4]f32.[0.25,0.5,0.75,1];for k:0..<4 {scan_put(b[..],124+k*4,f32_bits(values[k]));}c:=KmlCluster.{descriptor=84,vertices=1,stride=128,vertexBit=992};#assert kml_color_bits(b[..],c,0)==128;color:=kml_color(b[..],c,0,0);for k:0..<4 {#assert color[k]==values[k];}}
kml_color_bits :: (b:[]u8,c:KmlCluster,color:int)->int {layout:=ob_word(b,16);if (layout&(cast(u32)1<<cast(u32)(10+color)))==0 {return 0;}control:=ob_word(b,kml_color_meta(b,c,color));return (4-kml_pop(control&15))*(ifx (control&0xf0)==0xf0 then 8 else 32);}
kml_uv_start :: (b:[]u8,c:KmlCluster)->int {layout:=ob_word(b,16);cursor:=c.px+c.py+c.pz;if (layout&0x20)!=0 {cursor+=c.normalBits*2;}if (layout&0x40)!=0 {cursor+=kml_tangent_bits(b,c)*2+1;}for color:0..<2 {cursor+=kml_color_bits(b,c,color);}return cursor;}
kml_uv_meta :: (b:[]u8,c:KmlCluster,uv:int)->int {layout:=ob_word(b,16);#assert uv>=0 && uv<5 && (layout&(cast(u32)1<<cast(u32)(12+uv)))!=0;before:=(layout>>12)&((cast(u32)1<<cast(u32)uv)-1);return c.descriptor+32+kml_pop(before)*8;}
kml_uv_bits :: (b:[]u8,c:KmlCluster,uv:int)->int {layout:=ob_word(b,16);if (layout&(cast(u32)1<<cast(u32)(12+uv)))==0 {return 0;}value:=ob_word(b,kml_uv_meta(b,c,uv)+4);return cast(int)((value>>24)&15)+cast(int)(value>>28)+2;}
kml_uv :: (b:[]u8,c:KmlCluster,index:int,uv:int)->Point {meta:=kml_uv_meta(b,c,uv);value:=ob_word(b,meta+4);uBits:=cast(int)((value>>24)&15)+1;vBits:=cast(int)(value>>28)+1;uExp:=cast(int)(value&4095)-16;vExp:=cast(int)((value>>12)&4095)-16;#assert uExp>= -126 && uExp<=127 && vExp>= -126 && vExp<=127;start:=c.vertexBit+index*c.stride+kml_uv_start(b,c);for k:0..<uv {start+=kml_uv_bits(b,c,k);}u:=(cast(f32)ob_s16(b,meta)+cast(f32)kml_bits(b,start,uBits))*f32_from_bits(cast(u32)(uExp+127)<<23);v:=(cast(f32)ob_s16(b,meta+2)+cast(f32)kml_bits(b,start+uBits,vBits))*f32_from_bits(cast(u32)(vExp+127)<<23);return v3(u,v,0);}
kml_color :: (b:[]u8,c:KmlCluster,index:int,color:int)->[4]f32 {layout:=ob_word(b,16);rgba:=[4]f32.[1,1,1,1];if (layout&(cast(u32)1<<cast(u32)(10+color)))==0 {return rgba;}meta:=kml_color_meta(b,c,color);control:=ob_word(b,meta);width:=ifx (control&0xf0)==0xf0 then 8 else 32;start:=c.vertexBit+index*c.stride+c.px+c.py+c.pz;if (layout&0x20)!=0 {start+=c.normalBits*2;}if (layout&0x40)!=0 {start+=kml_tangent_bits(b,c)*2+1;}for k:0..<color {start+=kml_color_bits(b,c,k);}for channel:0..<4 {if (control&(cast(u32)1<<cast(u32)channel))!=0 {rgba[channel]=cast(f32)b[meta+4+channel]/255;}else {raw:=kml_bits(b,start,width);rgba[channel]=ifx width==8 then cast(f32)raw/255 else f32_from_bits(raw);#assert finite(rgba[channel]);start+=width;}}return rgba;}
kml_vertex_bits :: (b:[]u8,c:KmlCluster)->int {count:=kml_uv_start(b,c);for uv:0..<5 {count+=kml_uv_bits(b,c,uv);}return count;}
