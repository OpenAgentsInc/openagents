// Read already unwrapped original .hght/.mate images; output row-major samples.
// CLI INPUT OUTPUT. Height output=f32 metres; material output=RGBA IDs then RGBA weights.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../aethyr/render/geometry/scan.coax";
KT_LAYER :: 417792;
#test "Tegra terrain GOB addresses retain row block and shared edge boundaries" {
 #assert kt_offset(0,0)==0 && kt_offset(4,0)==4 && kt_offset(0,1)==16 && kt_offset(0,2)==64;
 #assert kt_offset(64,0)==8192 && kt_offset(0,128)==139264 && kt_offset(1024,256)+4<=KT_LAYER;
}
#test "Terrain image spans reject wrong formats truncated layers and bad offsets" {
 b:[52]u8;#assert !kt_image(b[..]);scan_put(b[..],0,0x01020401);scan_put(b[..],4,11);scan_put(b[..],44,8);scan_put(b[..],48,KT_LAYER);#assert !kt_image(b[..]);
}
#test "Original image descriptors admit both complete height and material layer spans" {
 b:[835636]u8;scan_put(b[..],0,0x02020401);scan_put(b[..],4,0x06060606);scan_put(b[..],12,256);scan_put(b[..],44,8);scan_put(b[..],48,KT_LAYER*2);#assert kt_image(b[..]);#assert !kt_image(b[0..<b.count-1]);
 scan_put(b[..],0,0x01020401);scan_put(b[..],4,11);scan_put(b[..],12,257);scan_put(b[..],48,KT_LAYER);#assert kt_image(b[..]);scan_put(b[..],44,0xffffffff);#assert !kt_image(b[..]);
}
kt_offset :: (x:int,y:int)->int {return (y/128)*17*8192+(x/64)*8192+(y%128/8)*512+(x%64/32)*256+(y%8/2)*64+(x%32/16)*32+(y%2)*16+x%16;}
kt_image :: (b:[]u8)->bool {
 if b.count<52 || b[0]!=1 || b[1]!=4 || b[2]!=2 {return false;}layers:=cast(int)b[3];format:=scan_u32(b,4);if !((layers==1 && format==11 && scan_u32(b,12)==257) || (layers==2 && format==0x06060606 && scan_u32(b,12)==256)) {return false;}
 at:=cast(int)scan_u32(b,44)+44;size:=cast(int)scan_u32(b,48);return at>=52 && at<=b.count && size==KT_LAYER*layers && size<=b.count-at;
}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}data:[1048576]u8;out:[528392]u8;n:=fs_read(args_at(a[..],0),data[..]);if n<0 || !kt_image(data[0..<n]) {return 3;}b:=data[0..<n];layers:=cast(int)b[3];base:=cast(int)scan_u32(b,44)+44;low:f32=100000;high:f32= -100000;nonzero:=0;
 for y:0..<257 {for x:0..<257 {src:=base+kt_offset(x*4,y);dst:=(y*257+x)*4;if layers==1 {h:=scan_float(b,src)*800;if (f32_bits(h)&0x7f800000)==0x7f800000 {return 4;}scan_put(out[..],dst,f32_bits(h));if h!=0 {nonzero+=1;low=ifx h<low then h else low;high=ifx h>high then h else high;}}else {for c:0..<4 {out[dst+c]=b[src+c];out[257*257*4+dst+c]=b[src+KT_LAYER+c];}}}}
 #assert fs_write(args_at(a[..],1),cast(string)out[0..<257*257*4*layers]);print("TERRAIN_SAMPLES_PASS layers=% samples=66049 nonzero=% min_metres=% max_metres=%\n",layers,nonzero,low,high);return 0;
}
