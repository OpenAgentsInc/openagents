// A realm's separate assets as one asset pack (docs/verse/native-gpu.md, realms-native): the
// Haunted House and the sandbox name their data, storage, index and layers as separate files
// (realms.json), which a page loads as the four assets a pack stands for (docs/verse/realm-host.md,
// "Asset packs": 0 the data, 1 the storage, 2 the indices, 3 the layers). A native host and
// verse/native/wasm-run.coax read packs (--pack), so this writes those files as one, in their
// order: the catalog entry the data's bytes, then the vertices, the indices and each layer.
// Offline tooling for the native checks; never shipped or run by a page.
//   coax/web/tool.sh verse/tools/pack-files.coax SLUG OUT     (from the repository's root)
// The format is verse/tools/pack_realm.py's: a 32-byte header ("VPK1", the entry count, the
// file's bytes, its budget (the same), the table at 32, the data's offset, 0, 0), 48-byte entries
// (kind, licence 0, 0, offset, bytes, 0, a 32-byte name), each entry's bytes from a 4-byte
// boundary. Kinds: 1 the catalog (the data), 2 vertices, 3 indices, 4 a texture layer.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";

PF_MAX :: 48;          // entries
PF_FILE :: 33554432;   // the pack's bytes at most (32 MB)

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 2 { tool_errln("usage: pack-files SLUG OUT"); return 2; }
  rj: [1048576] u8;
  rn := fs_read("apps/openagents-web/realms.json", rj[..]);
  if rn <= 0 { tool_errln("pack-files: run it from the repository's root (no apps/openagents-web/realms.json)"); return 2; }
  list := pf_assets(cast(string) rj[0..<rn], args_at(a[..], 0));
  if list.count == 0 { tool_err("pack-files: realms.json lists no assets for "); tool_errln(args_at(a[..], 0)); return 2; }
  // the files, in the pack's order
  names: [PF_MAX] string; kinds: [PF_MAX] int; n := 0;
  order := [4] string.["data", "storage", "index", "layers"];
  kind_of := [4] int.[1, 2, 3, 4];
  for k: 0..<4 {
    url := pf_asset(list, order[k]);
    if url.count == 0 { tool_err("pack-files: no "); tool_err(order[k]); tool_errln(" asset"); return 2; }
    // layers: URLs joined by |
    i := 0;
    while i < url.count && n < PF_MAX {
      j := i;
      while j < url.count && url[j] != '|' { j += 1; }
      names[n] = url[i..<j]; kinds[n] = kind_of[k]; n += 1;
      i = j + 1;
      if k < 3 { break; }
    }
  }
  out: [PF_FILE] u8;
  size := pf_pack(names[0..<n], kinds[0..<n], out[..]);
  if size < 0 { return 1; }
  if !fs_write(args_at(a[..], 1), cast(string) out[0..<size]) { tool_err("pack-files: cannot write "); tool_errln(args_at(a[..], 1)); return 1; }
  print("pack-files: % entries, % bytes in %\n", n, size, args_at(a[..], 1));
  return 0;
}

// The pack of these files (URLs under apps/openagents-web) in out: its bytes, or -1.
pf_pack :: (urls: [] string, kinds: [] int, out: [] u8) -> int {
  table := 32; data := table + 48 * urls.count;
  at := data;
  for e: 0..<urls.count {
    pb: [1024] u8;
    path := pf_cat("apps/openagents-web", urls[e], pb[..]);
    at = (at + 3) / 4 * 4;
    got := ifx at < out.count then fs_read(path, out[at..<out.count]) else -1;
    if got < 0 { tool_err("pack-files: cannot read "); tool_errln(path); return -1; }
    if at + got >= out.count { tool_errln("pack-files: the pack is over its 32 MB"); return -1; }
    // the entry: kind, licence, 0, offset, bytes, 0, the name (its file's)
    t := table + 48 * e;
    for i: 0..<48 { out[t + i] = 0; }
    out[t] = cast,trunc(u8) kinds[e];
    pf_u32(out, t + 4, at); pf_u32(out, t + 8, got);
    name := fs_base(urls[e]);
    for i: 0..<ifx name.count < 31 then name.count else 31 { out[t + 16 + i] = name[i]; }
    at += got;
  }
  for i: 0..<32 { out[i] = 0; }
  magic := "VPK1";
  for i: 0..<4 { out[i] = magic[i]; }
  pf_u32(out, 4, urls.count); pf_u32(out, 8, at); pf_u32(out, 12, at); pf_u32(out, 16, table); pf_u32(out, 20, data);
  return at;
}
pf_u32 :: (out: [] u8, at: int, v: int) {
  for i: 0..<4 { out[at + i] = cast,trunc(u8) ((v >> (8 * i)) & 255); }
}
#test "a little-endian word" {
  b: [8] u8;
  pf_u32(b[..], 2, 0x01020304);
  #assert b[2] == 4 && b[3] == 3 && b[4] == 2 && b[5] == 1 && b[0] == 0;
}

// The text inside the "assets": [...] of the realm whose slug is `slug`, "" for none.
pf_assets :: (json: string, slug: string) -> string {
  key: [256] u8; kn := 0;
  for c: "\"slug\": \"" { key[kn] = c; kn += 1; }
  for c: slug { if kn < 250 { key[kn] = c; kn += 1; } }
  key[kn] = '"'; kn += 1;
  k := cast(string) key[0..<kn];
  i := 0;
  while i + k.count <= json.count {
    if json[i..<i + k.count] == k {
      a := "\"assets\": [";
      j := i + k.count;
      // up to the next realm's slug
      while j + a.count <= json.count && !(j + 8 <= json.count && json[j..<j + 8] == "\"slug\": ") {
        if json[j..<j + a.count] == a {
          e := j + a.count; f := e;
          while f < json.count && json[f] != ']' { f += 1; }
          return json[e..<f];
        }
        j += 1;
      }
      return "";
    }
    i += 1;
  }
  return "";
}
// The URL of the first asset of `kind` in an assets list, "" for none.
pf_asset :: (list: string, kind: string) -> string {
  i := 0;
  while i < list.count {
    if list[i] == '"' {
      j := i + 1;
      while j < list.count && list[j] != '"' { j += 1; }
      entry := list[i + 1..<j];
      if entry.count > kind.count && entry[0..<kind.count] == kind && entry[kind.count] == ':' { return entry[kind.count + 1..<entry.count]; }
      i = j + 1;
    } else { i += 1; }
  }
  return "";
}
#test "the slug's assets" {
  j := "{ \"slug\": \"haunted-house\", \"golden\": { \"lit\": 1 }, \"assets\": [ \"data:/a/H.pb\", \"layers:/a/0.jpg|/a/1.jpg\" ] } { \"slug\": \"sandbox\", \"assets\": [] }";
  l := pf_assets(j, "haunted-house");
  #assert pf_asset(l, "data") == "/a/H.pb" && pf_asset(l, "layers") == "/a/0.jpg|/a/1.jpg" && pf_asset(l, "index") == "";
  #assert pf_assets(j, "sandbox") == "" && pf_assets(j, "none") == "";
}

pf_cat :: (x: string, y: string, out: [] u8) -> string {
  if x.count + y.count > out.count { return ""; }
  for i: 0..<x.count { out[i] = x[i]; }
  for i: 0..<y.count { out[x.count + i] = y[i]; }
  return cast(string) out[0..<x.count + y.count];
}
