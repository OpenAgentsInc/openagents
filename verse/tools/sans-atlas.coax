// The sans atlas a native host draws text with (docs/verse/native-gpu.md, realms-native): the
// atlas coax/web/host.js draws in the browser for a page whose shader declares sans_atlas
// (sansAtlas: the printable ASCII and SANS_EXTRA, 16 to a row in cells of 96 pixels, white in
// SANS_FONT, five levels each half the last), drawn the same way by headless Chrome and kept as
// its coverage: each level's alpha, row after row, level after level (read from one screenshot of
// the levels as grey, checked against the script's checksum of them). A host builds the
// premultiplied white texture from it (each texel a, a, a, a, as copyExternalImageToTexture
// premultiplies white), verse/gpu/vk-spec.c's and pass.js's `atlas` directive. Offline tooling;
// never run by a page.
//   coax/web/tool.sh verse/tools/sans-atlas.coax OUT [--report] [--script]   (--script prints the script)
// Its profile and raster commands come from aethyr/render/sans-profile.coax,
// the same source the page's Font layout and renderer effects consume.
// The font is the system's (Helvetica on a Mac), as the browser on this machine draws it.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/image/png.coax";
#load "../../aethyr/render/sans-profile.coax";

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 1 { tool_errln("usage: sans-atlas OUT [--report]"); return 2; }
  return sa_run(args_at(a[..], 0), args_has(a[..], "--report"), args_has(a[..], "--script"));
}

sa_run :: (out_path: string, report: bool, script_only: bool) -> int {
  profile := render_sans_profile(); total := int(profile.coverage_bytes);
  atlas: [4194304] u8;
  if total > atlas.count { tool_errln("sans-atlas: too large"); return 1; }
  // one screenshot: the levels stacked down a canvas at one pixel a texel, each texel's alpha as an
  // opaque grey; the script's checksum of the alpha must be the screenshot's
  w := profile.width; h := 0;
  for l: 0..<profile.levels { h += render_sans_level(l).height; }
  js: [32768] u8; jn := sa_script(js[..]);
  if jn < 0 { tool_errln("sans-atlas: the script does not fit"); return 1; }
  if script_only { print("%\n", cast(string) js[0..<jn]); return 0; }
  pb: [1024] u8; tb: [1024] u8; sb: [64] u8;
  tmp := fs_temp("sans-atlas-", tb[..]);
  png_path := fs_join(tmp, "atlas.png", pb[..]);
  sn := sa_put(sb[..], 0, ""); sn = sa_int(sb[..], sn, w); sn = sa_put(sb[..], sn, "x"); sn = sa_int(sb[..], sn, h);
  shot := [8] string.["coax/web/tool.sh", "shot", "about:blank", png_path, cast(string) sb[0..<sn], "300", "--eval", cast(string) js[0..<jn]];
  o: [65536] u8; e: [65536] u8;
  r := proc_run(shot[..], 300000, o[..], e[..]);
  if r.started != 0 || r.status != 0 || r.timed_out { tool_err(cast(string) e[0..<r.err_n]); tool_errln("sans-atlas: headless Chrome failed"); rm := fs_remove(tmp); return 1; }
  png: [16777216] u8;
  pn := fs_read(png_path, png[..]);
  rm := fs_remove(tmp);
  info := png_info(png[0..<ifx pn > 0 then pn else 0]);
  if pn <= 0 || info.status != PNG_OK || info.w != w || info.h != h { tool_errln("sans-atlas: the screenshot is not the canvas's size"); return 1; }
  work: [40000000] u8; px: [16777216] u8;
  if info.work > work.count || w * h * 4 > px.count || png_decode(png[0..<pn], work[..], px[..]) != PNG_OK { tool_errln("sans-atlas: the screenshot does not decode"); return 1; }
  at := 0; y0 := 0;
  for l: 0..<profile.levels {
    mip := render_sans_level(l); lw := mip.width; lh := mip.height;
    for y: 0..<lh { for x: 0..<lw { atlas[at] = px[((y0 + y) * w + x) * 4]; at += 1; } }
    y0 += lh;
  }
  want := sa_whole(cast(string) o[0..<r.out_n]);
  sum := sa_sum(atlas[0..<total]);
  if want < 0 || want != sum { tool_errln("sans-atlas: the screenshot's texels are not the canvas's (its colour or scale changed them)"); return 1; }
  if !fs_write(out_path, cast(string) atlas[0..<total]) { tool_err("sans-atlas: cannot write "); tool_errln(out_path); return 1; }
  if report {
    lit := 0;
    for i: 0..<int(render_sans_level(0).coverage_bytes) { if atlas[i] > 0 { lit += 1; } }
    print("sans-atlas: % glyphs, % rows, % levels, % bytes; level 0 %x%, % texels lit\n", profile.glyphs, profile.rows, profile.levels, total, profile.width, profile.height, lit);
  }
  return 0;
}

// JavaScript executes explicit Coax raster commands; it derives no glyph
// ordering, cell dimensions, mip dimensions, font size or pen coordinates.
sa_script :: (out: [] u8) -> int {
  profile := render_sans_profile(); height := 0;
  for l: 0..<profile.levels { height += render_sans_level(l).height; }
  n := sa_put(out, 0, "(()=>{const font='"); n = sa_put(out, n, profile.family);
  n = sa_put(out, n, "',levels=[");
  for l: 0..<profile.levels {
    mip := render_sans_level(l);
    if l > 0 { n = sa_put(out, n, ","); }
    n = sa_put(out, n, "{w:"); n = sa_int(out, n, mip.width);
    n = sa_put(out, n, ",h:"); n = sa_int(out, n, mip.height);
    n = sa_put(out, n, ",font:"); n = sa_int(out, n, mip.font_px);
    n = sa_put(out, n, ",draw:[");
    for glyph_index: 0..<profile.glyphs {
      command := render_sans_glyph(l, glyph_index);
      if glyph_index > 0 { n = sa_put(out, n, ","); }
      n = sa_put(out, n, "["); n = sa_int(out, n, int(command.code));
      n = sa_put(out, n, ","); n = sa_half(out, n, command.x_half);
      n = sa_put(out, n, ","); n = sa_half(out, n, command.y_half);
      n = sa_put(out, n, "]");
    }
    n = sa_put(out, n, "]}");
  }
  n = sa_put(out, n, "];const out=document.createElement('canvas');out.width="); n = sa_int(out, n, profile.width);
  n = sa_put(out, n, ";out.height="); n = sa_int(out, n, height);
  n = sa_put(out, n, ";out.style.cssText='position:fixed;left:0;top:0;width:'+out.width+'px;height:'+out.height+'px;image-rendering:pixelated';document.body.style.margin='0';document.body.appendChild(out);const G=out.getContext('2d');let y0=0,sum=0,at=0;for(const level of levels){const w=level.w,h=level.h;const cv=new OffscreenCanvas(w,h),g=cv.getContext('2d');g.fillStyle='");
  n = sa_put(out, n, profile.fill); n = sa_put(out, n, "';g.textBaseline='");
  n = sa_put(out, n, profile.text_baseline);
  n = sa_put(out, n, "';g.font=`${level.font}px ${font}`;for(const [code,x,y] of level.draw)g.fillText(String.fromCodePoint(code),x,y);const d=g.getImageData(0,0,w,h).data;const im=G.createImageData(w,h);for(let k=0;k<d.length;k+=4){const a=d[k+3];im.data[k]=a;im.data[k+1]=a;im.data[k+2]=a;im.data[k+3]=255;sum=(sum+a*((at%251)+1))%2147483647;at++;}G.putImageData(im,0,y0);y0+=h;}return String(sum);})()");
  return n;
}
// The script's checksum: each byte times its place mod 251, plus one, summed mod 2^31 - 1.
sa_sum :: (b: [] u8) -> int {
  sum := 0;
  for i: 0..<b.count { sum = (sum + cast(int) b[i] * ((i % 251) + 1)) % 2147483647; }
  return sum;
}
// A whole number (the first line of text), -1 if it is not one.
sa_whole :: (text: string) -> int {
  v := 0; n := 0;
  for i: 0..<text.count {
    c := text[i];
    if c == '\n' { break; }
    if c < '0' || c > '9' { return -1; }
    v = v * 10 + cast(int) c - 48; n += 1;
  }
  return ifx n > 0 then v else -1;
}
#test "the checksum and its number" {
  b := [3] u8.[1, 2, 255];
  #assert sa_sum(b[..]) == 1 + 4 + 765 && sa_whole("770\n/x.png") == 770 && sa_whole("x") == -1 && sa_whole("") == -1;
}
sa_put :: (out: [] u8, n: int, s: string) -> int {
  if n < 0 || n > out.count || s.count > out.count - n { return -1; }
  for i: 0..<s.count { out[n + i] = s[i]; } return n + s.count;
}
sa_int :: (out: [] u8, n: int, v: int) -> int {
  if n < 0 || n > out.count || v < 0 { return -1; }
  d: [24] u8; k := 0; x := v;
  if x == 0 { d[0] = '0'; k = 1; }
  while x > 0 { d[k] = cast,trunc(u8) (48 + x % 10); x /= 10; k += 1; }
  if k > out.count - n { return -1; }
  for i: 0..<k { out[n + i] = d[k - 1 - i]; }
  return n + k;
}
sa_half :: (out: [] u8, n: int, halves: int) -> int {
  if halves < 0 { return -1; }
  at := sa_int(out, n, halves / 2);
  if halves % 2 != 0 { at = sa_put(out, at, ".5"); }
  return at;
}
#test "the script" {
  b: [32768] u8; n := sa_script(b[..]);
  #assert n > 23 && cast(string) b[n - 23..<n] == "return String(sum);})()" && cast(string) b[0..<7] == "(()=>{c";
  #assert sa_contains(cast(string) b[0..<n], "Helvetica, Arial, \"Liberation Sans\", \"Nimbus Sans\", sans-serif");
  #assert sa_contains(cast(string) b[0..<n], "width=1536;out.height=1302;");
  #assert sa_contains(cast(string) b[0..<n], "draw:[[32,16,72],[33,112,72]");
  #assert sa_contains(cast(string) b[0..<n], "draw:[[32,1,4.5],[33,7,4.5]");
  #assert sa_contains(cast(string) b[0..<n], "[8800,85,40.5]");
  tiny: [31] u8;
  #assert sa_script(tiny[..]) == -1;
}

sa_contains :: (text: string, needle: string) -> bool {
  for i: 0..<text.count - needle.count + 1 { if text[i..<i + needle.count] == needle { return true; } }
  return false;
}

