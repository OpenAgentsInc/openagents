// Version 1 optional pack digest gate. Browser hashes received bytes; Coax owns admission.
#load "../../aethyr/assets.coax";
#authority;
CANYON_PACK_BYTES :: 789955936;
CANYON_PACK_SHA256 :: "9cdf33ffdee413a76bed96b2e041940da684cba7ef81fcd0551f35d041dd9d37";
CANYON_PACK_DIGEST :: [32]u8.[0x9c,0xdf,0x33,0xff,0xde,0xe4,0x13,0xa7,0x6b,0xed,0x96,0xb2,0xe0,0x41,0x94,0x0d,0xa6,0x84,0xcb,0xa7,0xef,0x81,0xfc,0xd0,0x55,0x1f,0x35,0xd0,0x41,0xdd,0x9d,0x37];
#test "Canyon pack gate pins every digest byte and exact length before GPU upload" {
  digest:[33]u8;hex:="9cdf33ffdee413a76bed96b2e041940da684cba7ef81fcd0551f35d041dd9d37";
  for k:0..<32 {digest[k]=cast(u8)(asset_digit(hex[k*2])*16+asset_digit(hex[k*2+1]));}
  #assert canyon_pack_accept(digest[0..<32],789955936);
  #assert !canyon_pack_accept(digest[0..<31],789955936) && !canyon_pack_accept(digest[..],789955936);
  #assert !canyon_pack_accept(digest[0..<32],789955935) && !canyon_pack_accept(digest[0..<32],789955937);
  for k:0..<32 {digest[k]^=1;#assert !canyon_pack_accept(digest[0..<32],789955936);digest[k]^=1;}
}
canyon_pack_accept :: (digest:[]u8,bytes:int)->bool {
  if digest.count!=32 || bytes!=CANYON_PACK_BYTES {return false;}
  for k:0..<32 {if digest[k]!=CANYON_PACK_DIGEST[k] {return false;}}return true;
}
