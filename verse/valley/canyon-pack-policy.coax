// Version 1 optional pack digest gate. Browser hashes received bytes; Coax owns admission.
#load "../../aethyr/assets.coax";
#authority;
CANYON_PACK_BYTES :: 668024432;
CANYON_PACK_SHA256 :: "104416a0a810d17523d099eeeaf2670e53ffd15f03c028ac4967b7f2b4cc0793";
CANYON_PACK_DIGEST :: [32]u8.[0x10,0x44,0x16,0xa0,0xa8,0x10,0xd1,0x75,0x23,0xd0,0x99,0xee,0xea,0xf2,0x67,0x0e,0x53,0xff,0xd1,0x5f,0x03,0xc0,0x28,0xac,0x49,0x67,0xb7,0xf2,0xb4,0xcc,0x07,0x93];
#test "Canyon pack gate pins every digest byte and exact length before GPU upload" {
  digest:[33]u8;hex:="104416a0a810d17523d099eeeaf2670e53ffd15f03c028ac4967b7f2b4cc0793";
  for k:0..<32 {digest[k]=cast(u8)(asset_digit(hex[k*2])*16+asset_digit(hex[k*2+1]));}
  #assert canyon_pack_accept(digest[0..<32],668024432);
  #assert !canyon_pack_accept(digest[0..<31],668024432) && !canyon_pack_accept(digest[..],668024432);
  #assert !canyon_pack_accept(digest[0..<32],668024431) && !canyon_pack_accept(digest[0..<32],668024433);
  for k:0..<32 {digest[k]^=1;#assert !canyon_pack_accept(digest[0..<32],668024432);digest[k]^=1;}
}
canyon_pack_accept :: (digest:[]u8,bytes:int)->bool {
  if digest.count!=32 || bytes!=CANYON_PACK_BYTES {return false;}
  for k:0..<32 {if digest[k]!=CANYON_PACK_DIGEST[k] {return false;}}return true;
}
