// Echo as an Aethyr character (aethyr/character/): her catalog admission, her orb-hand capsules and
// her idle face segments. The runtime is shared; only Echo's declarations live here. Raw data stays private.
#load "echo-rig-policy.coax";
#load "../../aethyr/character/character.coax";
#load "../../aethyr/render/slay-lights.coax";
// Platform upload scratch is outside the persistent simulation state.
EchoCatalogScratch :: struct {bytes:[ECHO_CATALOG_CAP]u8;}
// Admit an Echo catalog (ECH1, ECP2 or ECP3) into packs[pack]: the rig, then the face projected
// for the CPU. ECP3's shot is admitted by the caller.
echo_catalog_admit :: (packs:[]CharacterPack,pack:int,b:[]u8)->bool {
 if !echo_catalog_valid(b) {packs[pack].ready=false;return false;}
 start:=ifx scan_u32(b,0)==0x31484345 then 0 else echo_catalog_header(b);n:=ifx start>0 then cast(int)scan_u32(b,4) else b.count;
 for k:0..<n {packs[pack].data[k]=b[start+k];}if !character_pack_rig(packs,pack,n) {return false;}
 if start>0 {face_n:=cast(int)scan_u32(b,8);if !character_pack_face(packs,pack,b[start+n..<start+n+face_n],true) {return false;}}
 return true;
}
// Spawn Echo from packs[pack] with her capsules and idle face segments.
echo_spawn :: (c:[]Character,packs:[]CharacterPack,pack:int)->bool {
 c[0].capsules=ECHO_CAPSULES;c[0].capsule=ECHO_CAPSULE;c[0].cycle=ECHO_IDLE_FACE;
 return character_spawn(c,packs,pack);
}
// Capsules for the orb hand (left), after the palette and morph weights, so the shader can shadow
// the orb's light with the hand. Joint ids are Echo's source skin order.
ECHO_CAPSULES :: SLAY_HAND_CAPSULES;
ECHO_CAPSULE :: [20]CharacterCapsule.[CharacterCapsule.{joint=9,end=10,radius=0.032},CharacterCapsule.{joint=10,end=12,radius=0.018},CharacterCapsule.{joint=10,end=16,radius=0.018},CharacterCapsule.{joint=10,end=24,radius=0.017},CharacterCapsule.{joint=10,end=20,radius=0.015},
 CharacterCapsule.{joint=12,end=13,radius=0.0095},CharacterCapsule.{joint=13,end=14,radius=0.0085},CharacterCapsule.{joint=14,end= -1,radius=0.008},CharacterCapsule.{joint=16,end=17,radius=0.0095},CharacterCapsule.{joint=17,end=18,radius=0.0085},
 CharacterCapsule.{joint=18,end= -1,radius=0.008},CharacterCapsule.{joint=24,end=25,radius=0.009},CharacterCapsule.{joint=25,end=26,radius=0.008},CharacterCapsule.{joint=26,end= -1,radius=0.0075},CharacterCapsule.{joint=20,end=21,radius=0.008},
 CharacterCapsule.{joint=21,end=22,radius=0.0075},CharacterCapsule.{joint=22,end= -1,radius=0.007},CharacterCapsule.{joint=27,end=28,radius=0.012},CharacterCapsule.{joint=28,end=29,radius=0.0105},CharacterCapsule.{joint=29,end= -1,radius=0.0095}];
// Short source blinks and glances: TF0130 4..22, TF0145 3..21, TF0250 19..40, all at source 24 fps.
ECHO_IDLE_FACE :: CharacterFaceCycle.{period=8,count=3,clip=[4]int.[6,9,14,0],first=[4]int.[4,3,19,0],last=[4]int.[22,21,40,0]};
#test "Echo's palette layout is the one the Valley shader reads" {
 #assert CHARACTER_PALETTE_CAPSULES==SLAY_HAND_CAPSULE_WORD && CHARACTER_CAPSULES==ECHO_CAPSULES && CHARACTER_JOINTS==ECHO_JOINTS;
}
#test "Orb-hand capsules follow the posed joints, extend fingertips and stay empty without the source rig" #steps 1000000000 {
 packs:[1]CharacterPack;n:=echo_rig_fixture(packs[0].data[..],30);#assert character_pack_rig(packs[..],0,n);c:[1]Character;#assert echo_spawn(c[..],packs[..],0);
 for k:0..<30 {c[0].parent[k]=k-1;c[0].gt[k]=v3(cast(f32)k,0,0);}
 character_capsules(c[..]);at:=CHARACTER_PALETTE_CAPSULES;
 #assert c[0].palette[at]==9 && c[0].palette[at+4]==10 && c[0].palette[at+3]==0.032f32;
 tip:=CHARACTER_PALETTE_CAPSULES+7*8;#assert c[0].palette[tip]==14 && abs(c[0].palette[tip+4]-14.8)<0.00001 && c[0].palette[tip+3]==0.008f32;
 c[0].joints=1;character_capsules(c[..]);for k:0..<ECHO_CAPSULES*8 {#assert c[0].palette[CHARACTER_PALETTE_CAPSULES+k]==0;}
}
