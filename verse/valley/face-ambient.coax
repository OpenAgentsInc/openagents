// Short source blinks/glances over walking; body and collision remain independent.
#load "echo.coax";
EchoAmbient :: struct {clock:f32;segment:int;}
#test "Ambient performance starts once after eight seconds and cycles three source segments" {
 s:[1]EchoAmbient;for k:0..<511 {#assert !echo_ambient_due(s[..],1.0/64.0);}#assert echo_ambient_due(s[..],1.0/64.0) && s[0].segment==1 && s[0].clock==0;
 #assert !echo_ambient_due(s[..],0) && !echo_ambient_due(s[..],-1) && !echo_ambient_due(s[..],1);
 for round:0..<2 {for k:0..<64 {due:=echo_ambient_due(s[..],0.125);#assert due==(k==63);}}#assert s[0].segment==0;
}
echo_ambient_due :: (s:[]EchoAmbient,dt:f32)->bool {
 if !(dt>=0 && dt<=0.125) {return false;}s[0].clock+=dt;if s[0].clock<8 {return false;}s[0].clock-=8;s[0].segment=(s[0].segment+1)%3;return true;
}
echo_ambient :: (s:[]EchoAmbient,e:[]Echo,dt:f32) {
 if !e[0].ready || e[0].face_bytes==0 {return;}if echo_ambient_due(s,dt) {index:=(s[0].segment+2)%3;
  // TF0130 4..22, TF0145 3..21, TF0250 19..40, all at source 24 fps.
  clips:=[3]int.[6,9,14];first:=[3]int.[4,3,19];last:=[3]int.[22,21,40];_:=echo_face_start(e,clips[index],first[index],last[index],false);
 }
 if e[0].face[0].enabled && !e[0].face[0].looping && e[0].face[0].time>=e[0].face[0].end {e[0].face[0].enabled=false;echo_present(e);}
}
