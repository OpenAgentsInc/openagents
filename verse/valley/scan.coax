// Private scan payload v1: VSM1, vertex/index counts, version=1; p,n,RGB f32 then u32 indices.
// The caller pins SHA-256 before any decode. Failed decode never alters the live mesh.
#load "../../aethyr/render/geometry/indexed.coax";
#load "../../aethyr/core/assets.coax";
#load "../../aethyr/core/binary-words.coax";
#authority;
SCAN_VERTICES :: 8192;
SCAN_INDICES :: 32766;
SCAN_BYTES :: 16+SCAN_VERTICES*36+SCAN_INDICES*4;
Scan :: struct {p:[SCAN_VERTICES]Point;n:[SCAN_VERTICES]Point;c:[SCAN_VERTICES]Point;i:[SCAN_INDICES]u32;vertices:int;indices:int;measured:IndexedRead;}
// Used only after the shared hash/shape/value/index admission gate succeeds.
scan_decode :: (s:[]Scan,b:[]u8) #effects(all) {
  s[0].vertices=cast(int)scan_u32(b,4);s[0].indices=cast(int)scan_u32(b,8);
  for k:0..<s[0].vertices {s[0].p[k]=scan_point(b,16+k*36);s[0].n[k]=scan_point(b,28+k*36);s[0].c[k]=scan_point(b,40+k*36);}
  for k:0..<s[0].indices {s[0].i[k]=scan_u32(b,16+s[0].vertices*36+k*4);}
  s[0].measured=indexed_read(s[0].p[0..<s[0].vertices],s[0].n[0..<s[0].vertices],s[0].i[0..<s[0].indices],b.count,"Fab exact Quixel ID","Fab Standard / private cache");
}
#test "scan parser rejects malformed layout colors indices and preserves an empty candidate" {
  b:[136]u8;s:[1]Scan;#assert !scan_read(s[..],b[..]);
  scan_put(b[..],0,0x314d5356);scan_put(b[..],4,3);scan_put(b[..],8,3);scan_put(b[..],12,1);
  for k:0..<3 {scan_write_point(b[..],16+k*36,[3]Point.[v3(0,0,0),v3(1,0,0),v3(0,1,0)][k]);scan_write_point(b[..],28+k*36,v3(0,0,1));scan_write_point(b[..],40+k*36,v3(0.25,0.5,1));scan_put(b[..],124+k*4,cast(u32)k);}
  #assert scan_read(s[..],b[..]) && s[0].vertices==3 && s[0].indices==3 && s[0].measured.high.y==1;
  #assert !scan_read(s[..],b[0..<135]);scan_put(b[..],12,2);#assert !scan_read(s[..],b[..]);scan_put(b[..],12,1);
  scan_put(b[..],4,8193);#assert !scan_read(s[..],b[..]);scan_put(b[..],4,3);
  scan_put(b[..],8,32767);#assert !scan_read(s[..],b[..]);scan_put(b[..],8,2);#assert !scan_read(s[..],b[..]);scan_put(b[..],8,3);
  scan_put(b[..],132,3);#assert !scan_read(s[..],b[..]);scan_put(b[..],132,2);
  scan_put(b[..],40,f32_bits(-0.01));#assert !scan_read(s[..],b[..]);scan_put(b[..],40,f32_bits(1.01));#assert !scan_read(s[..],b[..]);scan_put(b[..],40,0x7fc00000);#assert !scan_read(s[..],b[..]);scan_put(b[..],40,0);
  scan_put(b[..],28,f32_bits(2));#assert !scan_read(s[..],b[..]);scan_put(b[..],28,0);
  scan_put(b[..],132,1);#assert !scan_read(s[..],b[..]);
}
// Structural parsing is separate from content identity/admission (aethyr/core/assets.coax).
// The caller supplies scratch, never the retained live mesh.
scan_read :: (candidate:[]Scan,b:[]u8)->bool #effects(all) {
  if !scan_header(b) {return false;}
  nv:=cast(int)scan_u32(b,4);ni:=cast(int)scan_u32(b,8);
  if !scan_counts(nv,ni) || b.count!=16+nv*36+ni*4 {return false;}
  if !scan_floats(b[16..<16+nv*36]) {return false;}
  for k:0..<nv {if !scan_rgb(scan_point(b,40+k*36)) {return false;}}
  scan_decode(candidate,b);return candidate[0].measured.status==IndexedStatus.ok;
}
scan_header :: (b:[]u8)->bool #effects(all) {return b.count>=16 && scan_u32(b,0)==0x314d5356 && scan_u32(b,12)==1;}
scan_counts :: (nv:int,ni:int)->bool #effects(all) {return nv>=3 && nv<=SCAN_VERTICES && ni>=3 && ni%3==0 && ni/3<=SCAN_INDICES/3;}
scan_floats :: (b:[]u8)->bool #effects(all) {if b.count%4!=0 {return false;}for k:0..<b.count/4 {if (scan_u32(b,k*4)&0x7f800000)==0x7f800000 {return false;}}return true;}
scan_rgb :: (c:Point)->bool #effects(all) {return c.x>=0 && c.x<=1 && c.y>=0 && c.y<=1 && c.z>=0 && c.z<=1;}
#test "scan helpers pin exact header counts float lanes and color endpoints" {
  h:[16]u8;scan_put(h[..],0,0x314d5356);scan_put(h[..],12,1);#assert scan_header(h[..]) && !scan_header(h[0..<15]);
  scan_put(h[..],0,1);#assert !scan_header(h[..]);scan_put(h[..],0,0x314d5356);scan_put(h[..],12,0);#assert !scan_header(h[..]);
  #assert scan_counts(3,3) && scan_counts(8192,32766) && scan_counts(4,6);
  #assert !scan_counts(2,3) && !scan_counts(8193,3) && !scan_counts(3,2) && !scan_counts(3,4) && !scan_counts(3,32769);
  b:[36]u8;for k:0..<9 {scan_put(b[..],k*4,0x3f800001);}
  #assert scan_floats(b[..]) && !scan_floats(b[0..<35]);for k:0..<9 {for bits:[3]u32.[0x7f800000,0x7f800001,0xff800000] {scan_put(b[..],k*4,bits);#assert !scan_floats(b[..]);}scan_put(b[..],k*4,0x3f800001);}
  #assert scan_rgb(v3(0,0,0)) && scan_rgb(v3(1,1,1));
  for axis:0..<3 {for value:[2]f32.[-0.01,1.01] {c:=v3(0.5,0.5,0.5);if axis==0 {c.x=value;}if axis==1 {c.y=value;}if axis==2 {c.z=value;}#assert !scan_rgb(c);}}
  raw:=[12]u8.[0,0,128,63,0,0,0,64,0,0,64,64];p:=scan_point(raw[..],0);#assert p.x==1 && p.y==2 && p.z==3;
}
#test "scan decode retains all vertex colors and the first nonzero index" {
  b:[136]u8;s:[1]Scan;scan_put(b[..],0,0x314d5356);scan_put(b[..],4,3);scan_put(b[..],8,3);scan_put(b[..],12,1);
  for k:0..<3 {scan_write_point(b[..],16+k*36,[3]Point.[v3(1,2,3),v3(4,2,3),v3(1,6,3)][k]);scan_write_point(b[..],28+k*36,v3(0,0,1));scan_write_point(b[..],40+k*36,v3(cast(f32)k/4,0.5,0.75));scan_put(b[..],124+k*4,cast(u32)((k+1)%3));}
  #assert scan_read(s[..],b[..]);for vertex:0..<3 {for lane:0..<3 {offset:=40+vertex*36+lane*4;old:=scan_u32(b[..],offset);scan_put(b[..],offset,f32_bits(1.5));#assert !scan_read(s[..],b[..]);scan_put(b[..],offset,old);}}
  #assert scan_read(s[..],b[..]);for k:0..<3 {#assert s[0].c[k].x==cast(f32)k/4 && s[0].c[k].y==0.5 && s[0].c[k].z==0.75 && s[0].i[k]==cast(u32)((k+1)%3);}
}
