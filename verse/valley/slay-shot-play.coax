// Play admitted Slay body/camera samples; the source actor transform track is disabled.
#load "echo.coax";
#test "Shot playback clamps and interpolates source locals without changing other joints" #steps 1000000000 {
 s:[1]SlayShot;names:[64]u8;shot_fixture(s[0].data[0..<620],names[..]);s[0].bytes=620;s[0].ready=true;s[0].frame=0.5;
 face_put(s[0].data[..],132+244,f32_bits(2.0f32));e:[1]Echo;e[0].ready=true;e[0].joints=2;e[0].body[1].t.x=9;
 slay_shot_present(s[..],e[..]);#assert e[0].body[0].t.x==1 && e[0].body[1].t.x==9;
 s[0].frame=99;#assert slay_shot_frame(s[..])==1;s[0].frame= -1;#assert slay_shot_frame(s[..])==0;
}
slay_shot_frame :: (s:[]SlayShot)->f32 {f:=shot_info(s[0].data[0..<s[0].bytes]);return lo(hi(s[0].frame,0),cast(f32)(f.frames-1));}
slay_shot_meta :: (s:[]SlayShot,k:int)->f32 {
 b:=s[0].data[0..<s[0].bytes];f:=shot_info(b);frame:=slay_shot_frame(s);a:=cast(int)floor(frame);c:=ifx a+1<f.frames then a+1 else a;
 return curve_linear(face_float(b,f.data+a*f.stride+f.bones*28+k*4),face_float(b,f.data+c*f.stride+f.bones*28+k*4),frame-cast(f32)a);
}
// The source face clip covers only part of the shot. Its first and last expressions ease in and out
// over SLAY_FACE_EASE source frames beyond that range instead of switching on and off in one frame.
SLAY_FACE_EASE :: 12.0f32;
slay_face_ease :: (source:f32,start:int,end:int)->f32 {outside:=hi(cast(f32)start-source,source-cast(f32)end);return lo(hi(1-outside/SLAY_FACE_EASE,0),1);}
#test "The shot face eases in before its source range and out after it" {
 #assert slay_face_ease(1121,1121,1159)==1 && slay_face_ease(1140,1121,1159)==1 && slay_face_ease(1115,1121,1159)==0.5 && slay_face_ease(1165,1121,1159)==0.5;
 #assert slay_face_ease(1109,1121,1159)==0 && slay_face_ease(1001,1121,1159)==0 && slay_face_ease(1180,1121,1159)==0;
}
slay_shot_present :: (s:[]SlayShot,e:[]Echo) {
 if !s[0].ready || !e[0].ready {return;}b:=s[0].data[0..<s[0].bytes];f:=shot_info(b);frame:=slay_shot_frame(s);a:=cast(int)floor(frame);c:=ifx a+1<f.frames then a+1 else a;
 for k:0..<f.bones {joint:=cast(int)face_word(b,f.names+k*68+64);e[0].body[joint]=pose_blend(face_local(b,f.data+a*f.stride+k*28),face_local(b,f.data+c*f.stride+k*28),frame-cast(f32)a);}
 e[0].face[0].enabled=false;source:=frame+cast(f32)f.source_first;
 ease:=slay_face_ease(source,f.face_start,f.face_end);
 if e[0].face_bytes>0 && ease>0 {
  face:=echo_face_bytes(e);info:=face_info(face);frames:=cast(int)face_word(face,info.clip_table+f.face_clip*80+64);held:=lo(hi(source,cast(f32)f.face_start),cast(f32)f.face_end);
  _:=echo_face_start(e,f.face_clip,0,frames-1,true);e[0].face[0].playing=false;e[0].face[0].blend=FACE_BLEND;e[0].face[0].time=(held-cast(f32)f.face_start)/f.rate;e[0].face[0].age=0.15*ease;face_tick(e[0].face[..],face,0);
 }echo_present(e);
}
