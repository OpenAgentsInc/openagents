// M_3DAsset's source SCurve and primary roughness branch. No Unreal runtime dependency.
WORLD_MATERIAL_WORDS :: 64;
#test "Butte colour controls and splat branches retain their source endpoints" {#assert abs(world_butte_channel(0.2,0.5,1,2,0.5,1)-0.2)<0.000001;#assert world_butte_channel(0.2,0.5,0,1,1,2)==0.25;#assert world_butte_mix(1,2,3,0,0)==1 && world_butte_mix(1,2,3,1,0)==2 && world_butte_mix(1,2,3,0,1)==3;}
world_butte_channel :: (value:f32,grey:f32,saturation:f32,gain:f32,tint:f32,contrast:f32)->f32 {return pow((grey+(value-grey)*saturation)*gain*tint,contrast);}
world_butte_mix :: (flat:f32,cliff:f32,rocks:f32,r:f32,g:f32)->f32 {first:=flat+(cliff-flat)*r;return first+(rocks-first)*g;}
#test "Source S curve keeps endpoints middle and the original two power branches" {#assert world_s_curve(0,2)==0 && world_s_curve(1,2)==1 && world_s_curve(0.5,2)==0.5;#assert abs(world_s_curve(0.25,2)-0.125)<0.000001 && abs(world_s_curve(0.75,2)-0.875)<0.000001;#assert abs(world_s_curve(0.5001,1)-0.50001)<0.000002;#assert world_derived_roughness(0,0.15,2.2)==0 && world_derived_roughness(1,0.15,2.2)==1;}
#forall "Source roughness is finite bounded and monotone across a texture ramp" k:0..<256 {a:=world_derived_roughness(cast(f32)k/256,0.15,2.2);b:=world_derived_roughness(cast(f32)(k+1)/256,0.15,2.2);#assert a>=0 && a<=b && b<=1;}
world_material_sat :: (x:f32)->f32 {return ifx x<0 then 0.0f32 else ifx x>1 then 1.0f32 else x;}
world_s_curve :: (x:f32,power:f32)->f32 {low:=0.5f32*pow(world_material_sat(x*2),power);transition:=1-pow(1-world_material_sat((x-0.5)*2),power);high:=0.5f32+transition*0.5;blend:=world_material_sat(transition*500);return low+(high-low)*blend;}
world_derived_roughness :: (red:f32,power:f32,intensity:f32)->f32 {return world_material_sat(world_s_curve(red,power)*intensity);}
