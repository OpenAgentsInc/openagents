// Private source identity, replaced only by an explicitly rebuilt complete bundle.
#load "../../aethyr/core/assets.coax";
#authority;
WORLD_PACK_BYTES :: 1565719372;
WORLD_PACK_DIGEST :: [32]u8.[0x20,0x66,0x38,0x6e,0x41,0x3e,0x39,0x0e,0xad,0xc0,0x6a,0xa9,0xae,0x1b,0x22,0xfe,0x11,0x5d,0x64,0x5f,0xe4,0x00,0xfb,0xf1,0x39,0x37,0x90,0xc0,0x93,0x0d,0x69,0x9a];
#test "World source pack requires every digest byte and exact length" {fixed:=[32]u8.[0x20,0x66,0x38,0x6e,0x41,0x3e,0x39,0x0e,0xad,0xc0,0x6a,0xa9,0xae,0x1b,0x22,0xfe,0x11,0x5d,0x64,0x5f,0xe4,0x00,0xfb,0xf1,0x39,0x37,0x90,0xc0,0x93,0x0d,0x69,0x9a];d:[33]u8;for k:0..<32 {d[k]=fixed[k];}#assert WORLD_PACK_BYTES==1565719372;#assert world_pack_accept(d[0..<32],WORLD_PACK_BYTES);#assert !world_pack_accept(d[0..<31],WORLD_PACK_BYTES) && !world_pack_accept(d[..],WORLD_PACK_BYTES) && !world_pack_accept(d[0..<32],WORLD_PACK_BYTES-1) && !world_pack_accept(d[0..<32],WORLD_PACK_BYTES+1);for k:0..<32 {d[k]^=1;#assert !world_pack_accept(d[0..<32],WORLD_PACK_BYTES);d[k]^=1;}}
world_pack_accept :: (digest:[]u8,bytes:int)->bool #effects(all) {if digest.count!=32 || bytes!=WORLD_PACK_BYTES {return false;}for k:0..<32 {if digest[k]!=WORLD_PACK_DIGEST[k] {return false;}}return true;}
