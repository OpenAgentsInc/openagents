// Private source identity, replaced only by an explicitly rebuilt complete bundle.
#load "../../aethyr/assets.coax";
#authority;
WORLD_PACK_BYTES :: 1561899992;
WORLD_PACK_DIGEST :: [32]u8.[0x90,0x57,0xc5,0x5b,0x78,0xb2,0x95,0xf0,0x4f,0x50,0xa0,0x7e,0x19,0x13,0x3f,0x52,0x8e,0x88,0xe5,0x76,0xc0,0xf7,0x37,0xfb,0x3f,0x25,0x01,0xe5,0xaa,0x1a,0x80,0x7e];
#test "World source pack requires every digest byte and exact length" {fixed:=[32]u8.[0x90,0x57,0xc5,0x5b,0x78,0xb2,0x95,0xf0,0x4f,0x50,0xa0,0x7e,0x19,0x13,0x3f,0x52,0x8e,0x88,0xe5,0x76,0xc0,0xf7,0x37,0xfb,0x3f,0x25,0x01,0xe5,0xaa,0x1a,0x80,0x7e];d:[33]u8;for k:0..<32 {d[k]=fixed[k];}#assert WORLD_PACK_BYTES==1561899992;#assert world_pack_accept(d[0..<32],WORLD_PACK_BYTES);#assert !world_pack_accept(d[0..<31],WORLD_PACK_BYTES) && !world_pack_accept(d[..],WORLD_PACK_BYTES) && !world_pack_accept(d[0..<32],WORLD_PACK_BYTES-1) && !world_pack_accept(d[0..<32],WORLD_PACK_BYTES+1);for k:0..<32 {d[k]^=1;#assert !world_pack_accept(d[0..<32],WORLD_PACK_BYTES);d[k]^=1;}}
world_pack_accept :: (digest:[]u8,bytes:int)->bool #effects(all) {if digest.count!=32 || bytes!=WORLD_PACK_BYTES {return false;}for k:0..<32 {if digest[k]!=WORLD_PACK_DIGEST[k] {return false;}}return true;}
