// What speech costs an account (docs/voice/coax-native-voice.md, "Cost").
// The voice host reports plain numbers here: milliseconds of audio sent to
// recognition and characters sent to synthesis. Each account gets a free
// tier per day (10 minutes recognized, 5,000 characters synthesized); beyond
// it every millisecond and character is priced in millisatoshis, and a turn
// may run only while the worst case still fits the free tier plus the budget
// the host sets from the account's balance. Saturating arithmetic: nothing
// here can overflow or trap.
//   coax/bin/coax test verse/voice-meter.coax
//   coax/bin/coax mutate verse/voice-meter.coax
#authority;

FREE_MS :: 600000;
FREE_CHARS :: 5000;
MSAT_PER_MS :: 1;
MSAT_PER_CHAR :: 30;
TOP :: cast(u64) 18446744073709551615;

Meter :: struct {
  day: u32;
  budget: u64;   // msat allowed beyond the free tier
  ms: u64;       // recognized today
  chars: u64;    // synthesized today
}

MeterReport :: struct {
  recognized_ms: u64;
  synthesized_chars: u64;
  free_ms_left: u64;
  free_chars_left: u64;
  owed_msat: u64;
}

// Each comparison is placed where its boundary changes the answer, so the
// boundary is something a check can see (a saturated sum at exactly TOP - 1
// is not saturated; usage of exactly the free amount owes nothing).
add_sat :: (a: u64, b: u64) -> u64 {
  if b == TOP { return TOP; }
  if a > TOP - 1 - b { return TOP; }
  return a + b;
}
// Units of `used` beyond `free` (free < TOP).
over :: (used: u64, free: u64) -> u64 {
  if used < free + 1 { return 0; }
  return used - free;
}
// What is left of `free` (free >= 1) after `used`.
left :: (free: u64, used: u64) -> u64 {
  if used > free - 1 { return 0; }
  return free - used;
}
mul_sat :: (a: u64, b: u64) -> u64 {
  if b != 0 && a > TOP / b { return TOP; }
  return a * b;
}

// Millisatoshis owed for a day's usage.
owed :: (ms: u64, chars: u64) -> u64 {
  return add_sat(mul_sat(over(ms, FREE_MS), MSAT_PER_MS), mul_sat(over(chars, FREE_CHARS), MSAT_PER_CHAR));
}

verse_voice_meter_free_ms :: () -> u64 #export_c { return FREE_MS; }
verse_voice_meter_free_chars :: () -> u64 #export_c { return FREE_CHARS; }
verse_voice_meter_msat_per_ms :: () -> u64 #export_c { return MSAT_PER_MS; }
verse_voice_meter_msat_per_char :: () -> u64 #export_c { return MSAT_PER_CHAR; }

verse_voice_meter_init :: (m: [] Meter, day: u32, budget: u64) #export_c {
  m[0] = Meter.{day = day, budget = budget};
}

// A later day starts over; an earlier one is ignored.
verse_voice_meter_day :: (m: [] Meter, day: u32) #export_c {
  if day <= m[0].day { return; }
  m[0].day = day;
  m[0].ms = 0;
  m[0].chars = 0;
}

verse_voice_meter_budget :: (m: [] Meter, budget: u64) #export_c { m[0].budget = budget; }

// May a turn of at most max_ms recognized and max_chars synthesized run?
verse_voice_meter_may_run :: (m: [] Meter, max_ms: u64, max_chars: u64) -> bool #export_c {
  return owed(add_sat(m[0].ms, max_ms), add_sat(m[0].chars, max_chars)) <= m[0].budget;
}

// Record what was used (it happened, so it always counts). False when the
// account is now past its free tier plus budget: refuse further turns.
verse_voice_meter_charge :: (m: [] Meter, ms: u64, chars: u64) -> bool #export_c {
  m[0].ms = add_sat(m[0].ms, ms);
  m[0].chars = add_sat(m[0].chars, chars);
  return owed(m[0].ms, m[0].chars) <= m[0].budget;
}

verse_voice_meter_report :: (m: [] Meter) -> MeterReport #export_c {
  return MeterReport.{recognized_ms = m[0].ms, synthesized_chars = m[0].chars,
    free_ms_left = left(FREE_MS, m[0].ms), free_chars_left = left(FREE_CHARS, m[0].chars),
    owed_msat = owed(m[0].ms, m[0].chars)};
}

// ---------------------------------------------------------------- checks

#forall "saturating arithmetic" a: 0..<70, b: 0..<70 {
  x := cast(u64) a;
  y := cast(u64) b;
  #assert add_sat(x, y) == x + y;
  #assert over(x, y) == (ifx a > b then x - y else cast(u64) 0);
  if b > 0 { #assert left(y, x) == (ifx b > a then y - x else cast(u64) 0); }
  #assert mul_sat(x, y) == x * y;
}

#test "saturating arithmetic at the top" {
  #assert add_sat(TOP, 1) == TOP && add_sat(TOP - 1, 1) == TOP && add_sat(TOP - 2, 1) == TOP - 1;
  #assert add_sat(TOP - 3, 2) == TOP - 1 && add_sat(TOP - 2, 2) == TOP && add_sat(TOP, 0) == TOP && add_sat(TOP - 1, 0) == TOP - 1;
  #assert add_sat(1, TOP) == TOP && add_sat(0, TOP) == TOP;
  #assert mul_sat(TOP, 2) == TOP && mul_sat(TOP / 2, 2) == TOP - 1 && mul_sat(TOP / 2 + 1, 2) == TOP;
  #assert mul_sat(TOP, 0) == 0 && mul_sat(0, TOP) == 0 && mul_sat(TOP, 1) == TOP;
  #assert over(0, TOP - 1) == 0 && over(TOP, 0) == TOP && left(TOP, TOP) == 0 && left(TOP, 0) == TOP && left(1, TOP) == 0;
}

#forall "what is owed" dm: -3..<4, dc: -3..<4 {
  ms := cast(u64) (600000 + dm);
  chars := cast(u64) (5000 + dc);
  want := (ifx dm > 0 then dm else 0) * 1 + (ifx dc > 0 then dc else 0) * 30;
  #assert owed(ms, chars) == cast(u64) want;
}

#test "the free tier and prices" {
  #assert verse_voice_meter_free_ms() == 600000 && verse_voice_meter_free_chars() == 5000;
  #assert verse_voice_meter_msat_per_ms() == 1 && verse_voice_meter_msat_per_char() == 30;
  #assert owed(0, 0) == 0 && owed(TOP, 0) == TOP - 600000 && owed(TOP, TOP) == TOP;
  #assert owed(0, 5001) == 30 && owed(600001, 0) == 1;
}

// Every small day of usage against every small budget: a turn runs exactly
// when its worst case fits, and charging reports exactly when it no longer does.
#forall "may this turn run" used: 0..<6, turn: 0..<6, budget: 0..<8 {
  m: [1] Meter;
  verse_voice_meter_init(m[..], 3, cast(u64) budget);
  // Start just under both free limits so small numbers cross them.
  #assert verse_voice_meter_charge(m[..], 599998, 4999);
  ok := verse_voice_meter_charge(m[..], cast(u64) used, cast(u64) used);
  over_ms := 599998 + used - 600000;
  over_chars := 4999 + used - 5000;
  spent := (ifx over_ms > 0 then over_ms else 0) + 30 * (ifx over_chars > 0 then over_chars else 0);
  #assert ok == (spent <= budget);
  run := verse_voice_meter_may_run(m[..], cast(u64) turn, cast(u64) turn);
  t_ms := 599998 + used + turn - 600000;
  t_chars := 4999 + used + turn - 5000;
  worst := (ifx t_ms > 0 then t_ms else 0) + 30 * (ifx t_chars > 0 then t_chars else 0);
  #assert run == (worst <= budget);
  r := verse_voice_meter_report(m[..]);
  #assert r.recognized_ms == cast(u64) (599998 + used) && r.synthesized_chars == cast(u64) (4999 + used);
  #assert r.owed_msat == cast(u64) spent;
  #assert r.free_ms_left == cast(u64) (ifx used < 2 then 2 - used else 0);
  #assert r.free_chars_left == cast(u64) (ifx used < 1 then 1 - used else 0);
}

#test "days, budgets and the top" {
  m: [1] Meter;
  verse_voice_meter_init(m[..], 10, 0);
  #assert verse_voice_meter_may_run(m[..], 600000, 5000);
  #assert !verse_voice_meter_may_run(m[..], 600001, 5000);
  #assert !verse_voice_meter_may_run(m[..], 600000, 5001);
  #assert verse_voice_meter_charge(m[..], 600000, 5000);
  #assert !verse_voice_meter_charge(m[..], 1, 0);
  // Usage that happened still counts after a refusal.
  #assert verse_voice_meter_report(m[..]).recognized_ms == 600001;
  verse_voice_meter_budget(m[..], 1);
  #assert m[0].budget == 1 && !verse_voice_meter_may_run(m[..], 1, 0) && verse_voice_meter_may_run(m[..], 0, 0);
  verse_voice_meter_day(m[..], 10);
  #assert m[0].ms == 600001 && m[0].day == 10;
  verse_voice_meter_day(m[..], 9);
  #assert m[0].ms == 600001 && m[0].day == 10;
  verse_voice_meter_day(m[..], 11);
  #assert m[0].ms == 0 && m[0].chars == 0 && m[0].day == 11 && m[0].budget == 1;
  #assert verse_voice_meter_charge(m[..], 0, 3);
  verse_voice_meter_day(m[..], 12);
  #assert m[0].chars == 0;
  #assert !verse_voice_meter_charge(m[..], TOP, TOP) && m[0].ms == TOP && m[0].chars == TOP;
  #assert !verse_voice_meter_charge(m[..], TOP, TOP) && m[0].ms == TOP;
  #assert !verse_voice_meter_may_run(m[..], 0, 0);
  verse_voice_meter_budget(m[..], TOP);
  #assert verse_voice_meter_may_run(m[..], TOP, TOP);
  r := verse_voice_meter_report(m[..]);
  #assert r.free_ms_left == 0 && r.free_chars_left == 0 && r.owed_msat == TOP;
  verse_voice_meter_init(m[..], 4, 9);
  #assert m[0].day == 4 && m[0].budget == 9 && m[0].ms == 0 && m[0].chars == 0;
  r = verse_voice_meter_report(m[..]);
  #assert r.free_ms_left == 600000 && r.free_chars_left == 5000 && r.owed_msat == 0;
}
