// The wallet's payment rules (docs/lightning/coax-integration.md). Swift
// talks to Breez's Spark SDK and hands this file plain numbers: amounts,
// fees, times and what the SDK reported. This file decides whether a quote
// may be paid, how a payment's state moves, what the keypad holds and when
// a warning shows. Words and keys never come here.
//   coax/bin/coax test verse/wallet.coax
//   coax/bin/coax mutate verse/wallet.coax
#import "Basic";
#authority;

// All the bitcoin there will ever be, in satoshis.
MAX_SAT :: 2_100_000_000_000_000;

// ---- Amounts ----

// The SDK counts satoshis; payment.v1 counts millisatoshis.
verse_wallet_sat_to_msat :: (sat: int) -> int #export_c {
  if sat < 0 || sat > MAX_SAT { return -1; }
  return sat * 1000;
}

#forall "sats to msat" sat: -3..<40 {
  m := verse_wallet_sat_to_msat(sat);
  if sat < 0 { #assert m == -1; } else { #assert m == sat * 1000; }
}

#test "sats to msat at the top" {
  #assert verse_wallet_sat_to_msat(MAX_SAT) == MAX_SAT * 1000;
  #assert verse_wallet_sat_to_msat(MAX_SAT + 1) == -1;
  #assert verse_wallet_sat_to_msat(0) == 0;
}

// The fewest whole sats at or above a millisatoshi bound (an LNURL's
// minSendable), and the most at or below one (its maxSendable); -1 for a
// bound that is negative or past all the bitcoin there is.
verse_wallet_msat_up :: (msat: int) -> int #export_c {
  if msat < 0 || msat > MAX_SAT * 1000 { return -1; }
  return (msat + 999) / 1000;
}
verse_wallet_msat_down :: (msat: int) -> int #export_c {
  if msat < 0 || msat > MAX_SAT * 1000 { return -1; }
  return msat / 1000;
}

#forall "msat bounds" msat: -3..<4010 {
  up := verse_wallet_msat_up(msat);
  down := verse_wallet_msat_down(msat);
  if msat < 0 { #assert up == -1 && down == -1; }
  else {
    #assert up * 1000 >= msat && (up - 1) * 1000 < msat;
    #assert down * 1000 <= msat && (down + 1) * 1000 > msat;
  }
}

#test "msat bounds at the top" {
  #assert verse_wallet_msat_up(MAX_SAT * 1000) == MAX_SAT;
  #assert verse_wallet_msat_up(MAX_SAT * 1000 + 1) == -1;
  #assert verse_wallet_msat_down(MAX_SAT * 1000 + 1) == -1;
  #assert verse_wallet_msat_down(MAX_SAT * 1000) == MAX_SAT;
}

// Whether an amount is one the recipient takes: at least one sat, within
// what it says it accepts (0 for no bound), and within what is spendable.
verse_wallet_amount_ok :: (amount: int, low: int, high: int, spendable: int) -> bool #export_c {
  if amount <= 0 || amount > MAX_SAT { return false; }
  if amount < low { return false; }
  if high > 0 && amount > high { return false; }
  return amount <= spendable;
}

#forall "amounts" amount: -1..<7, low: 0..<4, high: 0..<6, spendable: 0..<7 {
  ok := verse_wallet_amount_ok(amount, low, high, spendable);
  #assert ok == (amount >= 1 && amount >= low && (high == 0 || amount <= high) && amount <= spendable);
}

#test "amounts at the top" {
  #assert verse_wallet_amount_ok(MAX_SAT, 0, 0, MAX_SAT);
  #assert !verse_wallet_amount_ok(MAX_SAT + 1, 0, 0, MAX_SAT + 1);
}

// ---- The keypad ----

// A digit typed after `sats`; -1 if it would pass all the bitcoin there is
// or isn't a digit. A leading zero stays zero.
verse_wallet_digit :: (sats: int, digit: int) -> int #export_c {
  if digit < 0 || digit > 9 || sats < 0 { return -1; }
  if sats > (MAX_SAT - digit) / 10 { return -1; }
  return sats * 10 + digit;
}
verse_wallet_backspace :: (sats: int) -> int #export_c {
  if sats < 0 { return -1; }
  return sats / 10;
}

#forall "the keypad" sats: -1..<40, digit: -1..<11 {
  next := verse_wallet_digit(sats, digit);
  if digit < 0 || digit > 9 || sats < 0 { #assert next == -1; }
  else { #assert next == sats * 10 + digit && verse_wallet_backspace(next) == sats; }
  #assert verse_wallet_backspace(sats) == (ifx sats < 0 then -1 else sats / 10);
}

#test "the keypad at the top" {
  top := MAX_SAT / 10;
  #assert verse_wallet_digit(top, 0) == MAX_SAT;
  #assert verse_wallet_digit(top, 1) == -1;
  #assert verse_wallet_digit(top + 1, 0) == -1;
  #assert verse_wallet_digit(top - 1, 9) == MAX_SAT - 1;
}

// ---- Warnings ----

// A fee above a tenth of the amount is shown as high on the review screen.
// (fee > amount / 10 is fee * 10 > amount in whole sats, without overflow.)
verse_wallet_fee_high :: (amount: int, fee: int) -> bool #export_c {
  return fee > amount / 10;
}

#forall "high fees" amount: 0..<60, fee: 0..<12 {
  #assert verse_wallet_fee_high(amount, fee) == (fee * 10 > amount);
}

#test "high fees past all the bitcoin" {
  #assert verse_wallet_fee_high(MAX_SAT, MAX_SAT + 1);
  #assert verse_wallet_fee_high(MAX_SAT, MAX_SAT / 10 + 1);
  #assert !verse_wallet_fee_high(MAX_SAT, MAX_SAT / 10);
}

// An invoice about to lapse: less than a minute left, or already gone.
verse_wallet_expiring :: (now: int, expires: int) -> bool #export_c {
  return expires - now < 60;
}

#forall "expiring" now: 0..<5, left: -2..<70 {
  #assert verse_wallet_expiring(now, now + left) == (left < 60);
}

// ---- Sending ----

Pay :: enum u8 { idle; quoted; sending; succeeded; not_sent; unknown; }
Verdict :: enum u8 { send; over_cap; over_limit; expired; bad_amount; busy; }

// Whether a confirmed quote may be paid. Every input comes from the host:
// the fee may not pass `cap` (what the review screen showed), and the
// amount and fee together may not pass `left` (what is spendable).
verse_wallet_may_send :: (state: Pay, amount: int, fee: int, cap: int, left: int,
                             now: int, expires: int) -> Verdict #export_c {
  if state != Pay.quoted { return Verdict.busy; }
  if amount <= 0 || fee < 0 || amount > MAX_SAT { return Verdict.bad_amount; }
  if now >= expires { return Verdict.expired; }
  if fee > cap { return Verdict.over_cap; }
  if amount > left - fee { return Verdict.over_limit; }
  return Verdict.send;
}

#forall "may_send" state: Pay, amount: -1..<6, fee: -1..<4, cap: 0..<3, left: 0..<8, late: bool {
  v := verse_wallet_may_send(state, amount, fee, cap, left, ifx late then 10 else 9, 10);
  if state != Pay.quoted { #assert v == Verdict.busy; }
  else if amount <= 0 || fee < 0 { #assert v == Verdict.bad_amount; }
  else if late { #assert v == Verdict.expired; }
  else if fee > cap { #assert v == Verdict.over_cap; }
  else if amount + fee > left { #assert v == Verdict.over_limit; }
  else { #assert v == Verdict.send; }
}

#test "may_send near all the bitcoin" {
  #assert verse_wallet_may_send(Pay.quoted, MAX_SAT, 0, 0, MAX_SAT, 0, 1) == Verdict.send;
  #assert verse_wallet_may_send(Pay.quoted, MAX_SAT, 1, 1, MAX_SAT, 0, 1) == Verdict.over_limit;
  #assert verse_wallet_may_send(Pay.quoted, MAX_SAT + 1, 0, 0, MAX_SAT + 1, 0, 1) == Verdict.bad_amount;
}

// What happened. The host steps the flow with each event in turn.
Event :: enum u8 {
  quote;      // prepareSendPayment returned a quote
  confirm;    // the person confirmed and may_send said send
  cancel;     // the person backed out
  expire;     // the quote lapsed on screen
  sent;       // the SDK (or a later event) reported the payment complete
  failed;     // the SDK reported it failed before any money moved
  timed_out;  // no answer, an error after the call, or still pending
  done;       // the person closed the result
}

// One payment: its state, which quote it is on, and how many times
// sendPayment was called for that quote.
Flow :: struct { state: Pay; quote: int; sends: int; }

verse_wallet_start :: () -> Flow #export_c { return Flow.{state = Pay.idle, quote = 0, sends = 0}; }

// How the payment moves. One send per quote; an unknown outcome waits for
// the SDK, never becoming a failure or a second send; a finished payment
// stays finished until the person closes it.
verse_wallet_step :: (f: Flow, e: Event) -> Flow #export_c {
  next := f;
  if e == Event.quote {
    if f.state == Pay.idle || f.state == Pay.quoted || f.state == Pay.not_sent {
      next.state = Pay.quoted; next.quote = f.quote + 1; next.sends = 0;
    }
  } else if e == Event.confirm {
    if f.state == Pay.quoted && f.sends == 0 { next.state = Pay.sending; next.sends = 1; }
  } else if e == Event.cancel || e == Event.expire {
    if f.state == Pay.quoted { next.state = Pay.idle; }
  } else if e == Event.sent {
    if f.state == Pay.sending || f.state == Pay.unknown { next.state = Pay.succeeded; }
  } else if e == Event.failed {
    if f.state == Pay.sending || f.state == Pay.unknown { next.state = Pay.not_sent; }
  } else if e == Event.timed_out {
    if f.state == Pay.sending { next.state = Pay.unknown; }
  } else if e == Event.done {
    if f.state == Pay.succeeded || f.state == Pay.not_sent { next.state = Pay.idle; }
  }
  return next;
}

#test "a fresh payment" {
  f := verse_wallet_start();
  #assert f.state == Pay.idle && f.quote == 0 && f.sends == 0;
}

#forall "each step" state: Pay, e: Event, sends: 0..<2 {
  f := Flow.{state = state, quote = 3, sends = sends};
  n := verse_wallet_step(f, e);
  if e == Event.quote {
    if state == Pay.idle || state == Pay.quoted || state == Pay.not_sent { #assert n.state == Pay.quoted && n.quote == 4 && n.sends == 0; }
    else { #assert n.state == state && n.quote == 3 && n.sends == sends; }
  } else {
    #assert n.quote == 3;
    if e == Event.confirm && state == Pay.quoted && sends == 0 { #assert n.state == Pay.sending && n.sends == 1; }
    else { #assert n.sends == sends; }
    if e == Event.confirm && !(state == Pay.quoted && sends == 0) { #assert n.state == state; }
    if e == Event.cancel || e == Event.expire { #assert n.state == (ifx state == Pay.quoted then Pay.idle else state); }
    if e == Event.sent { #assert n.state == (ifx state == Pay.sending || state == Pay.unknown then Pay.succeeded else state); }
    if e == Event.failed { #assert n.state == (ifx state == Pay.sending || state == Pay.unknown then Pay.not_sent else state); }
    if e == Event.timed_out { #assert n.state == (ifx state == Pay.sending then Pay.unknown else state); }
    if e == Event.done { #assert n.state == (ifx state == Pay.succeeded || state == Pay.not_sent then Pay.idle else state); }
  }
}

// Every sequence of four events from the start: at most one send per
// quote; an unknown outcome is never shown as a failure without the SDK
// saying so; a success is never undone except by closing it.
#forall "every four events" a: Event, b: Event, c: Event, d: Event {
  events := [4] Event.[a, b, c, d];
  f := verse_wallet_start();
  for e: events {
    before := f;
    f = verse_wallet_step(f, e);
    #assert f.sends <= 1;
    if f.state == Pay.sending || f.state == Pay.unknown { #assert f.sends == 1; }
    if before.state == Pay.unknown && f.state == Pay.not_sent { #assert e == Event.failed; }
    if before.state == Pay.succeeded { #assert f.state == Pay.succeeded || e == Event.done; }
    if f.quote == before.quote && before.sends == 1 { #assert f.sends == 1; }
  }
}

// ---- Buying ----
// Buying bitcoin with dollars through the two providers Breez's SDK builds
// pages for (buyBitcoin). MoonPay sends bitcoin on-chain to the wallet's own
// deposit address; Cash App pays a Lightning invoice the wallet made. Bitcoin
// only: a MoonPay page for any other currency is refused.

BUY_MOONPAY :: 0;
BUY_CASHAPP :: 1;

// The SDK's deposit claim transaction is 99 vbytes, and SparkHost lets it pay
// up to the fastest recommended rate plus 1 sat/vB (maxDepositClaimFee).
CLAIM_VBYTES :: 99;
CLAIM_LEEWAY :: 1;
// A fee rate past this is not a real answer.
RATE_TOP :: 100_000;

// The most adding an on-chain deposit to the balance costs at the SDK's
// fastest recommended rate; -1 for a rate that isn't one.
verse_wallet_claim_fee_max :: (fastest: int) -> int #export_c {
  if fastest < 0 || fastest > RATE_TOP { return -1; }
  return (fastest + CLAIM_LEEWAY) * CLAIM_VBYTES;
}

#forall "claim fee ceiling" rate: -2..<300 {
  m := verse_wallet_claim_fee_max(rate);
  if rate < 0 { #assert m == -1; } else { #assert m == (rate + 1) * 99; }
}

#test "claim fee ceiling at the top" {
  #assert verse_wallet_claim_fee_max(RATE_TOP) == (RATE_TOP + 1) * 99;
  #assert verse_wallet_claim_fee_max(RATE_TOP + 1) == -1;
  #assert verse_wallet_claim_fee_max(0) == 99;
}

BuyCheck :: enum u8 { ok; no_provider; no_amount; too_small; too_large; no_fee; }

// Whether `amount` sats may be bought from `provider`. A MoonPay purchase
// arrives on-chain and pays the claim from itself, so it must be more than
// `claim_max`. When the SDK couldn't say (`claim_max` -1), a MoonPay
// purchase is refused, since nothing shows it covers its claim.
verse_wallet_buy_amount :: (provider: int, amount: int, claim_max: int) -> BuyCheck #export_c {
  if provider != BUY_MOONPAY && provider != BUY_CASHAPP { return BuyCheck.no_provider; }
  if amount <= 0 { return BuyCheck.no_amount; }
  if amount > MAX_SAT { return BuyCheck.too_large; }
  if provider == BUY_MOONPAY && claim_max < 0 { return BuyCheck.no_fee; }
  if provider == BUY_MOONPAY && amount <= claim_max { return BuyCheck.too_small; }
  return BuyCheck.ok;
}

#forall "buy amounts" provider: -1..<3, amount: -1..<6, claim: -3..<5 {
  v := verse_wallet_buy_amount(provider, amount, claim);
  if provider < 0 || provider > 1 { #assert v == BuyCheck.no_provider; }
  else if amount <= 0 { #assert v == BuyCheck.no_amount; }
  else if provider == 0 && claim < 0 { #assert v == BuyCheck.no_fee; }
  else if provider == 0 && amount <= claim { #assert v == BuyCheck.too_small; }
  else { #assert v == BuyCheck.ok; }
  // A MoonPay purchase that passes is more than a ceiling the SDK gave.
  if provider == 0 && v == BuyCheck.ok { #assert claim >= 0 && amount > claim; }
}

#test "buy amounts at the top" {
  #assert verse_wallet_buy_amount(BUY_CASHAPP, MAX_SAT, -1) == BuyCheck.ok;
  #assert verse_wallet_buy_amount(BUY_CASHAPP, MAX_SAT + 1, -1) == BuyCheck.too_large;
  #assert verse_wallet_buy_amount(BUY_MOONPAY, MAX_SAT + 1, -1) == BuyCheck.too_large;
  #assert verse_wallet_buy_amount(BUY_MOONPAY, MAX_SAT, -1) == BuyCheck.no_fee;
  #assert verse_wallet_buy_amount(BUY_MOONPAY, MAX_SAT, MAX_SAT - 1) == BuyCheck.ok;
  #assert verse_wallet_buy_amount(BUY_MOONPAY, 100, 99) == BuyCheck.ok;
  #assert verse_wallet_buy_amount(BUY_MOONPAY, 99, 99) == BuyCheck.too_small;
}

bw_alnum :: (c: u8) -> bool { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
// A byte a page URL may hold: printable ASCII, no space, quote, angle bracket or backslash.
bw_urlchar :: (c: u8) -> bool { return c > 32 && c < 127 && c != '"' && c != '\\' && c != '<' && c != '>'; }

bw_starts :: (text: string, at: int, word: string) -> bool {
  if at < 0 || at + word.count > text.count { return false; }
  return text[at..<at + word.count] == word;
}

// Whether every query parameter name (after ? or &, up to =) is letters and
// digits, so no name is percent-encoded and none hides behind a fragment or
// a ';'. Breez's form-encoded query never has a raw '#' or ';'.
bw_names_plain :: (url: string) -> bool {
  for c: url { if c == '#' || c == ';' { return false; } }
  for k: 1..<url.count {
    if url[k - 1] == '?' || url[k - 1] == '&' {
      e := k;
      while e < url.count && url[e] != '=' && url[e] != '&' { if !bw_alnum(url[e]) { return false; } e += 1; }
      if e == k { return false; }
    }
  }
  return true;
}

// Whether the URL has exactly one query parameter `name` (after ? or &),
// and it is exactly `value`.
bw_param_is :: (url: string, name: string, value: string) -> bool {
  n := 0; at: int;
  for k: 1..<url.count {
    if (url[k - 1] == '?' || url[k - 1] == '&') && bw_starts(url, k, name) && bw_starts(url, k + name.count, "=") {
      n += 1; at = k + name.count + 1;
    }
  }
  e := at + value.count;
  return n == 1 && bw_starts(url, at, value) && (e == url.count || url[e] == '&');
}

MOONPAY_PAGE :: "https://buy.moonpay.io";
CASHAPP_PAGE :: "https://cash.app/launch/lightning/";

// Whether a MoonPay page the SDK returned may open: Breez's page for
// bitcoin (currencyCode btc) to `address`, the deposit address the wallet
// itself reports, and nothing else.
verse_wallet_moonpay_page :: (raw: [] u8, address: [] u8) -> bool #export_c {
  url := cast(string) raw;
  to := cast(string) address;
  for c: url { if !bw_urlchar(c) { return false; } }
  if to.count < 14 || to.count > 90 { return false; }
  for c: to { if !bw_alnum(c) { return false; } }
  p := MOONPAY_PAGE.count;
  if !bw_starts(url, 0, MOONPAY_PAGE) { return false; }
  if bw_starts(url, p, "/?") { p += 1; }
  if !bw_starts(url, p, "?") { return false; }
  if !bw_names_plain(url) { return false; }
  return bw_param_is(url, "currencyCode", "btc") && bw_param_is(url, "walletAddress", to);
}

BTC_MSAT :: 100_000_000_000;

// Where `c` last appears in `text`; -1 when it doesn't.
bw_last :: (text: string, c: u8) -> int {
  at := -1;
  for k: 0..<text.count { if text[k] == c { at = k; } }
  return at;
}

// Whether a mainnet invoice states exactly `msat` in its human-readable
// part: "lnbc", then the amount's digits (no leading zero) and multiplier,
// up to the separator, the invoice's last "1" (BOLT 11). Another network
// (lntb, lntbs, lnbcrt), no amount, or any other amount is refused.
bw_invoice_is :: (inv: string, msat: int) -> bool {
  if !bw_starts(inv, 0, "lnbc") { return false; }
  sep := bw_last(inv, '1');
  if sep < 5 || sep + 1 >= inv.count { return false; }
  e := sep; unit := BTC_MSAT; pico := false;
  m := inv[sep - 1];
  if m == 'm' { unit = 100_000_000; e -= 1; }
  else if m == 'u' { unit = 100_000; e -= 1; }
  else if m == 'n' { unit = 100; e -= 1; }
  else if m == 'p' { pico = true; e -= 1; }
  if e == 4 || inv[4] == '0' { return false; }
  v := 0;
  for k: 4..<e {
    if inv[k] < '0' || inv[k] > '9' || v > MAX_SAT * 100 { return false; }
    v = v * 10 + cast(int) (inv[k] - '0');
  }
  if pico { return v % 10 == 0 && v / 10 == msat; }
  return msat % unit == 0 && v == msat / unit;
}

// Whether a Cash App page may open: a mainnet Lightning invoice the wallet
// made, for exactly the amount asked. Both the invoice's own stated amount
// and `invoice_sats` (what the SDK read from it) must be that amount.
verse_wallet_cashapp_page :: (raw: [] u8, amount: int, invoice_sats: int) -> bool #export_c {
  url := cast(string) raw;
  if !bw_starts(url, 0, CASHAPP_PAGE) { return false; }
  for k: CASHAPP_PAGE.count..<url.count { if !bw_alnum(url[k]) { return false; } }
  if amount < 1 || amount > MAX_SAT || invoice_sats != amount { return false; }
  return bw_invoice_is(url[CASHAPP_PAGE.count..<url.count], amount * 1000);
}

// Test text: up to three pieces joined.
BwText :: struct { b: [600] u8; n: int; }
bw_text :: (a: string, b: string, c: string) -> BwText {
  r: BwText;
  for x: a { r.b[r.n] = x; r.n += 1; }
  for x: b { r.b[r.n] = x; r.n += 1; }
  for x: c { r.b[r.n] = x; r.n += 1; }
  return r;
}
ADDR :: "bc1pqqqsyqcyq5rqwzqfpg9scrgwpugpzysnzs23v9ccrydpk8qarc0sjr0ud9";
moonpay_ok :: (url: string, address: string) -> bool {
  u := bw_text(url, "", ""); a := bw_text(address, "", "");
  return verse_wallet_moonpay_page(u.b[0..<u.n], a.b[0..<a.n]);
}
cashapp_ok :: (url: string, amount: int, invoice: int) -> bool {
  u := bw_text(url, "", "");
  return verse_wallet_cashapp_page(u.b[0..<u.n], amount, invoice);
}

#test "MoonPay pages" {
  good := bw_text("https://buy.moonpay.io/?apiKey=pk&currencyCode=btc&walletAddress=", ADDR, "&quoteCurrencyAmount=0.00010000&signature=a%2Bb");
  #assert moonpay_ok(cast(string) good.b[0..<good.n], ADDR);
  bare := bw_text("https://buy.moonpay.io?currencyCode=btc&walletAddress=", ADDR, "");
  #assert moonpay_ok(cast(string) bare.b[0..<bare.n], ADDR);
  // another currency, another address, another host, not https
  usdc := bw_text("https://buy.moonpay.io/?currencyCode=usdc_sol&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) usdc.b[0..<usdc.n], ADDR);
  two := bw_text("https://buy.moonpay.io/?currencyCode=btc&currencyCode=usdc_sol&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) two.b[0..<two.n], ADDR);
  other := bw_text("https://buy.moonpay.io/?currencyCode=btc&walletAddress=", ADDR, "x");
  #assert !moonpay_ok(cast(string) other.b[0..<other.n], ADDR);
  twice := bw_text("https://buy.moonpay.io/?currencyCode=btc&walletAddress=", ADDR, "&walletAddress=bc1qother");
  #assert !moonpay_ok(cast(string) twice.b[0..<twice.n], ADDR);
  #assert !moonpay_ok("https://buy.moonpay.io/?currencyCode=btc", ADDR);
  host := bw_text("https://buy.moonpay.io.evil.com/?currencyCode=btc&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) host.b[0..<host.n], ADDR);
  path := bw_text("https://buy.moonpay.io/x?currencyCode=btc&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) path.b[0..<path.n], ADDR);
  http := bw_text("http://buy.moonpay.io/?currencyCode=btc&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) http.b[0..<http.n], ADDR);
  space := bw_text("https://buy.moonpay.io/?currencyCode=btc&walletAddress=", ADDR, "& x");
  #assert !moonpay_ok(cast(string) space.b[0..<space.n], ADDR);
  fake := bw_text("https://buy.moonpay.io/?xcurrencyCode=btc&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) fake.b[0..<fake.n], ADDR);
  // a second currency hidden by percent-encoding, a fragment or a ';'
  coded := bw_text("https://buy.moonpay.io/?currencyCode=btc&walletAddress=", ADDR, "&currencyCod%65=usdc_sol");
  #assert !moonpay_ok(cast(string) coded.b[0..<coded.n], ADDR);
  frag := bw_text("https://buy.moonpay.io/?theme=light#&currencyCode=btc&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) frag.b[0..<frag.n], ADDR);
  semi := bw_text("https://buy.moonpay.io/?currencyCode=btc&walletAddress=", ADDR, "&theme=a;currencyCode=usdc_sol");
  #assert !moonpay_ok(cast(string) semi.b[0..<semi.n], ADDR);
  empty := bw_text("https://buy.moonpay.io/?currencyCode=btc&=x&walletAddress=", ADDR, "");
  #assert !moonpay_ok(cast(string) empty.b[0..<empty.n], ADDR);
  // Breez's own page: encoded values, every name plain
  breez := bw_text("https://buy.moonpay.io/?apiKey=pk_live_x&currencyCode=btc&walletAddress=", ADDR, "&colorCode=%23055DEB&theme=light&quoteCurrencyAmount=0.00100000&lockAmount=true&redirectURL=https%3A%2F%2Fbuy.moonpay.io%2Ftransaction_receipt%3FaddFunds%3Dtrue&signature=a%2Bb%3D");
  #assert moonpay_ok(cast(string) breez.b[0..<breez.n], ADDR);
  // the address itself must look like one
  short := bw_text("https://buy.moonpay.io/?currencyCode=btc&walletAddress=", "bc1q", "");
  #assert !moonpay_ok(cast(string) short.b[0..<short.n], "bc1q");
  #assert moonpay_ok("https://buy.moonpay.io/?currencyCode=btc&walletAddress=bc1q0123456789a", "bc1q0123456789a");
  #assert !moonpay_ok("https://buy.moonpay.io/?currencyCode=btc&walletAddress=bc1q0123456789", "bc1q0123456789-");
  // 14 to 90 letters and digits
  #assert moonpay_ok("https://buy.moonpay.io?currencyCode=btc&walletAddress=bc1q0123456789", "bc1q0123456789");
  #assert !moonpay_ok("https://buy.moonpay.io?currencyCode=btc&walletAddress=bc1q012345678", "bc1q012345678");
  long := bw_text("bc1q0123456789012345678901234567890123456789", "0123456789012345678901234567890123456789", "012345");
  #assert long.n == 90;
  wide := bw_text("https://buy.moonpay.io?currencyCode=btc&walletAddress=", cast(string) long.b[0..<90], "");
  #assert moonpay_ok(cast(string) wide.b[0..<wide.n], cast(string) long.b[0..<90]);
  over := bw_text("bc1q0123456789012345678901234567890123456789", "0123456789012345678901234567890123456789", "0123456");
  far := bw_text("https://buy.moonpay.io?currencyCode=btc&walletAddress=", cast(string) over.b[0..<91], "");
  #assert !moonpay_ok(cast(string) far.b[0..<far.n], cast(string) over.b[0..<91]);
}

#test "Cash App pages" {
  #assert cashapp_ok("https://cash.app/launch/lightning/lnbc10u1pabc", 1000, 1000);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc10u1pabc", 1000, 999);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc10u1pabc", 0, 0);
  #assert cashapp_ok("https://cash.app/launch/lightning/lnbc10n1pabc", 1, 1);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lntb10u1pabc", 1000, 1000);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc", 1000, 1000);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc10u1p?x=1", 1000, 1000);
  #assert !cashapp_ok("http://cash.app/launch/lightning/lnbc10u1pabc", 1000, 1000);
  #assert !cashapp_ok("cashapp://launch/lightning/lnbc10u1pabc", 1000, 1000);
  // mainnet only: regtest and signet start like it
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbcrt10u1pabc", 1000, 1000);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lntbs10u1pabc", 1000, 1000);
  // the invoice itself states exactly the amount: no rounding to whole sats
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc10001n1pabc", 1000, 1000);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc20u1pabc", 1000, 1000);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc1pabc", 1000, 1000);
  #assert cashapp_ok("https://cash.app/launch/lightning/lnbc1m1pabc", 100000, 100000);
  #assert cashapp_ok("https://cash.app/launch/lightning/lnbc21000000000000000n1pabc", MAX_SAT, MAX_SAT);
  #assert !cashapp_ok("https://cash.app/launch/lightning/lnbc21000000000000010n1pabc", MAX_SAT + 1, MAX_SAT + 1);
  #assert !cashapp_ok("https://cash.app/launch/lightning/", 1000, 1000);
}

#test "invoice amounts" {
  #assert bw_invoice_is("lnbc10u1pabc", 1_000_000) && !bw_invoice_is("lnbc10u1pabc", 1_000_001);
  #assert bw_invoice_is("lnbc10u1p", 1_000_000) && !bw_invoice_is("lnbc10u1", 1_000_000);
  #assert bw_invoice_is("lnbc2500m1pabc", 250_000_000_000);
  #assert bw_invoice_is("lnbc21pabc", 2 * BTC_MSAT);
  #assert bw_invoice_is("lnbc7n1pabc", 700) && bw_invoice_is("lnbc9u1pabc", 900_000);
  #assert bw_invoice_is("lnbc10p1pabc", 1) && !bw_invoice_is("lnbc15p1pabc", 1);
  // a whole number of the multiplier, never a fraction of a millisatoshi
  #assert !bw_invoice_is("lnbc1u1pabc", 100_001) && !bw_invoice_is("lnbc1m1pabc", 100_001_000);
  #assert !bw_invoice_is("lnbc1n1pabc", 100_001) && !bw_invoice_is("lnbc11pabc", BTC_MSAT + 1000);
  #assert !bw_invoice_is("lnbc010u1pabc", 1_000_000) && !bw_invoice_is("lnbcu1pabc", 0);
  #assert !bw_invoice_is("lnbc1pabc", 0) && !bw_invoice_is("lnbc1pabc", BTC_MSAT);
  #assert !bw_invoice_is("lnbc1:u1pabc", 2_000_000) && !bw_invoice_is("lnbc10x1pabc", 1_000_000);
  #assert !bw_invoice_is("lntb10u1pabc", 1_000_000) && !bw_invoice_is("lnbcrt10u1pabc", 1_000_000);
  // all the bitcoin there is, and in pico up to a tenth of it
  #assert bw_invoice_is("lnbc210000001pabc", MAX_SAT * 1000);
  #assert bw_invoice_is("lnbc21000000000000000n1pabc", MAX_SAT * 1000);
  #assert bw_invoice_is("lnbc2100000000000000000p1pabc", 210000000000000000);
  #assert !bw_invoice_is("lnbc2100000000000000010p1pabc", 210000000000000001);
  #assert !bw_invoice_is("lnbc99999999999999999999u1pabc", 0);
  #assert bw_last("1ab1", '1') == 3 && bw_last("1ab", '1') == 0 && bw_last("ab", '1') == -1;
}

#test "parameter names" {
  #assert bw_names_plain("x?ab=1&cd=2") && bw_names_plain("x?ab") && bw_names_plain("x?ab&cd=1");
  #assert !bw_names_plain("?%61=1") && !bw_names_plain("x?a%62=1") && !bw_names_plain("x?=1");
  #assert !bw_names_plain("x?a=1#b") && !bw_names_plain("x?a=1;b=2") && !bw_names_plain("x?a=1&&b=2");
}

#forall "page bytes" c: 0..<256 {
  ok := c > 32 && c < 127 && c != 34 && c != 92 && c != 60 && c != 62;
  #assert bw_urlchar(cast(u8) c) == ok;
  #assert bw_alnum(cast(u8) c) == ((c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90));
}

#test "parameters" {
  #assert bw_param_is("?a=1", "a", "1") && !bw_param_is("a=1", "a", "1");
  #assert !bw_param_is("https://x/?a=1&b=2&a=1", "a", "1");
  #assert !bw_param_is("https://x/?ab=1&b=2", "a", "1");
  #assert bw_param_is("https://x/?a=1&b=2", "a", "1");
  #assert bw_param_is("https://x/?b=2&a=1", "a", "1");
  #assert !bw_param_is("https://x/?a=12", "a", "1");
  #assert !bw_param_is("https://x/?a=1&a=1", "a", "1");
  #assert !bw_param_is("https://x/?b=1", "a", "1");
  #assert bw_starts("abc", 1, "bc") && !bw_starts("abc", 2, "bc") && !bw_starts("abc", -1, "a");
}

// A purchase on the Buy screen: asking the SDK for the page, the page open
// (it opens on exactly one step), the bitcoin seen arriving, then received.
Buy :: enum u8 { idle; asking; open; arriving; received; failed; }
BuyEvent :: enum u8 {
  ask;      // the person chose a provider and verse_wallet_buy_amount said ok
  page;     // the SDK returned a page and verse_wallet_moonpay_page or _cashapp_page passed it
  refused;  // the SDK failed, or the page didn't pass
  seen;     // a new on-chain deposit appeared (MoonPay)
  paid;     // the SDK reported the incoming payment complete
  done;     // the person closed the purchase
}

// How a purchase moves. The host opens the provider's page only on the step
// from asking to open, so one answer from the SDK opens one page.
verse_wallet_buy_step :: (b: Buy, e: BuyEvent) -> Buy #export_c {
  if e == BuyEvent.ask { return ifx b == Buy.asking then b else Buy.asking; }
  if e == BuyEvent.page { return ifx b == Buy.asking then Buy.open else b; }
  if e == BuyEvent.refused { return ifx b == Buy.asking then Buy.failed else b; }
  if e == BuyEvent.seen { return ifx b == Buy.open then Buy.arriving else b; }
  if e == BuyEvent.paid { return ifx b == Buy.open || b == Buy.arriving then Buy.received else b; }
  if e == BuyEvent.done { return ifx b == Buy.asking then b else Buy.idle; }
  return b;
}

// What the host does on an event, from the state before it: ask the SDK for
// a page only when a purchase isn't already asking (a second tap, on either
// provider, starts nothing), and open a page only on the step from asking to
// open. A second answer, or one that comes after the page opened, opens none.
verse_wallet_buy_starts :: (b: Buy, e: BuyEvent) -> bool #export_c { return e == BuyEvent.ask && b != Buy.asking; }
verse_wallet_buy_opens :: (b: Buy, e: BuyEvent) -> bool #export_c { return e == BuyEvent.page && b == Buy.asking; }

#forall "what each step does" b: Buy, e: BuyEvent {
  n := verse_wallet_buy_step(b, e);
  #assert verse_wallet_buy_starts(b, e) == (e == BuyEvent.ask && b != Buy.asking);
  #assert verse_wallet_buy_opens(b, e) == (n == Buy.open && b != Buy.open);
  if verse_wallet_buy_starts(b, e) { #assert n == Buy.asking; }
}

#forall "each purchase step" b: Buy, e: BuyEvent {
  n := verse_wallet_buy_step(b, e);
  if e == BuyEvent.ask { #assert n == Buy.asking; }
  if e == BuyEvent.page { #assert n == (ifx b == Buy.asking then Buy.open else b); }
  if e == BuyEvent.refused { #assert n == (ifx b == Buy.asking then Buy.failed else b); }
  if e == BuyEvent.seen { #assert n == (ifx b == Buy.open then Buy.arriving else b); }
  if e == BuyEvent.paid { #assert n == (ifx b == Buy.open || b == Buy.arriving then Buy.received else b); }
  if e == BuyEvent.done { #assert n == (ifx b == Buy.asking then Buy.asking else Buy.idle); }
}

// Every sequence of five events from idle: a page opens only straight after
// an ask, at most once per ask, and nothing is received without a page. The
// host's own counts agree: it opens at most one page per SDK call it starts.
#forall "every five purchase events" a: BuyEvent, b: BuyEvent, c: BuyEvent, d: BuyEvent, e: BuyEvent {
  events := [5] BuyEvent.[a, b, c, d, e];
  s := Buy.idle;
  pages := 0;
  calls := 0; opened := 0;
  for x: events {
    before := s;
    if verse_wallet_buy_starts(before, x) { calls += 1; opened = 0; }
    if verse_wallet_buy_opens(before, x) { opened += 1; #assert calls >= 1; }
    #assert opened <= 1;
    s = verse_wallet_buy_step(s, x);
    if x == BuyEvent.ask { pages = 0; }
    if s == Buy.open && before != Buy.open {
      #assert before == Buy.asking && x == BuyEvent.page;
      pages += 1;
    }
    #assert pages <= 1;
    if s == Buy.received && before != Buy.received { #assert before == Buy.open || before == Buy.arriving; }
  }
}
